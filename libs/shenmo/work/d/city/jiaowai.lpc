#include <ansi.h>
#include <room.h>
inherit ROOM;

void climbing1(object);
void climbing2(object);
void climbing3(object);
void climbing4(object);

string *climbMsg = ({
  "$N吐了一口杂草，继续向上攀爬。。。\n",
  "$N艰难的爬行着，头上占满了鸟粪。。。\n",
  "$N停下来，挠了挠发痒的屁股，又继续朝上爬着。。。\n",
  "$N不经意朝下一看。。。。“呃～～～”$P的脸色剧变。。。\n",
  "$N哼着不成调的小曲愉快的爬着。。。\n",
  "$N咿咿呀呀的嘟囔了几句，又继续爬行。。。\n",
  "一路太平，什么事也没有。。。\n",
  "一对正在偷情的小鸟给$N惊得飞起。。。\n",
  "$N顺手从鸟窝里掏了个鸟蛋，结果沾了一手的鸟粪。。。\n",
});

void create() {
  set("short", "小树林");
  set("long", @LONG

    这是长安郊外的一片小树林，落英缤纷，蜂歌蝶舞，朝露夕光，沁人
心脾。呼朋唤友开怀欢乐正其时。周围小树(tree)颗颗健美，上有无数的
小鸟小雀在树梢上欢歌，一点也不怕人。这正是个打鸟（da）的好机会。
LONG);
  set("exits", ([
    "east": "/d/kaifeng/east1",
    "west": __DIR__ "dongmen",
  ]));
  set("item_desc", ([
    "tree": "树干上留下了不少攀爬的痕迹。\n",
  ]));
  set("no_clean_up", 0);
  set_temp("wayao1", 1);
  set("outdoors", "yangzhou");
  setup();
}

void init() {
  add_action("do_da", "da");
  //        add_action("do_climb", "climb");   暂时封闭升级
}


int do_da() {
  object me;
  int i, kar, cps, bb, mm;
  me = this_player();

  if (me->is_busy())
    return notify_fail("你还是等弓装好了箭再打鸟吧！\n");
  if (me->query("kee") < 1000)
    return notify_fail("你还是先去南城客栈要过了新人礼物再来吧。\n");
  if (me->query("potential") + me->query("c_potential") + me->query("qn_balance") > 50000)
    return notify_fail("对你来说，光靠打鸟看来是得不到任何锻炼了。\n");
  if (me->query("kee") < 10)
    return notify_fail(HIR "你还是先休息一下吧，射箭也要用力气哟。。\n" NOR);

  me->start_busy(1);
  message_vision("$N拿起儿时玩耍用的小弓小箭，瞄准树上的小雀射去......\n", me);

  message_vision("$N只听树上一阵鸟儿急鸣…\n", me);
  kar = me->query("kar");

  if (random(kar) > 15) {
    message_vision("$N打到一只" HIW "百灵鸟。\n" NOR, me);
    if ((me->query("combat_exp") >= 50000) || (me->query("potential") >= 100000))
      tell_object(me, "你已经不能用打鸟来锻炼了。\n");
    else {
      bb = (int)me->query("combat_exp");
      me->set("combat_exp", 100 + bb);
      tell_object(me, "你得到了100点经验\n");
    }
    me->receive_damage("kee", 10);
    bb = (int)me->query("potential");
    if ((me->query("combat_exp") >= 50000) || (me->query("potential") >= 100000))
      tell_object(me, "你已经不能用打鸟来锻炼了。\n");
    else {
      me->set("potential", 40 + bb);
      tell_object(me, "你得到了40点潜能\n");
    }

    return 1;
  }

  if (random(kar) > 10) {
    message_vision("$N打到一只" HIY "金丝雀。\n" NOR, me);
    if ((me->query("combat_exp") >= 50000) || (me->query("potential") >= 100000))
      tell_object(me, "你已经不能用打鸟来锻炼了。\n");
    else {
      bb = (int)me->query("combat_exp");
      me->set("combat_exp", 80 + bb);
      tell_object(me, "你得到了80点经验\n");
    }
    me->receive_damage("kee", 10);
    bb = (int)me->query("potential");
    if ((me->query("combat_exp") >= 50000) || (me->query("potential") >= 100000))
      tell_object(me, "你已经不能用打鸟来锻炼了。\n");
    else {
      me->set("potential", bb + 30);
      tell_object(me, "你得到了30点潜能\n");
    }

    return 1;
  }

  if (random(kar) > 8) {
    message_vision("$N打到一只" HIG "鹦鹉。\n" NOR, me);
    bb = (int)me->query("combat_exp");
    if ((me->query("combat_exp") >= 50000) || (me->query("potential") >= 100000))
      tell_object(me, "你已经不能用打鸟来锻炼了。\n");
    else {
      tell_object(me, "你得到了50点经验\n");
      me->set("combat_exp", 50 + bb);
    }
    me->receive_damage("kee", 10);

    bb = (int)me->query("potential");
    if ((me->query("combat_exp") >= 50000) || (me->query("potential") >= 100000))
      tell_object(me, "你已经不能用打鸟来锻炼了。\n");
    else {
      me->set("potential", bb + 20);
      tell_object(me, "你得到了20点潜能\n");
    }

    return 1;
  }

  if (random(kar) > 5) {
    message_vision("$N打到一只" YEL "麻雀。\n" NOR, me);
    bb = (int)me->query("combat_exp");
    if ((me->query("combat_exp") >= 50000) || (me->query("potential") >= 100000))
      tell_object(me, "你已经不能用打鸟来锻炼了。\n");
    else {
      tell_object(me, "你得到了10点经验\n");
      me->set("combat_exp", 20 + bb);
    }
    me->receive_damage("kee", 10);

    bb = (int)me->query("potential");
    if ((me->query("combat_exp") >= 50000) || (me->query("potential") >= 100000))
      tell_object(me, "你已经不能用打鸟来锻炼了。\n");
    else {
      me->set("potential", bb + 10);
      tell_object(me, "你得到了20点潜能\n");
    }

    return 1;
  } else {
    me->receive_damage("kee", 10);
    message_vision("$N什么也没打到。\n", me);
  }

  return 1;
}

int do_climb(string arg) {
  int pot;
  object me = this_player();

  if (!arg || arg != "tree")
    return 0;

  pot = me->query("combat_exp");
  pot += me->query("daoxing");
  pot /= 100000;

  if (pot < 5)
    return 0;

  pot = me->query_skill("dodge", 1);
  if (pot < 250)
    return 0;
  message_vision("$N纵身跳起，攀住枝叶，身若猿猴，“唰唰唰”几下就爬到枝叶丛中去了。\n", me);
  me->set_temp("block_msg/all", 1);
  me->move("/obj/empty");
  call_out("climbing" + sprintf("%d", 1 + random(3)), 1 + random(3), me);
  return 1;
}

void climbing1(object me) {
  remove_call_out("climbing1");
  if (!me)
    return;
  me->set_temp("block_msg/all", 0);
  message_vision(climbMsg[random(sizeof(climbMsg))], me);
  me->set_temp("block_msg/all", 1);
  call_out("climbing" + sprintf("%d", 1 + random(3)), 1 + random(3), me);
}

void climbing2(object me) {
  remove_call_out("climbing2");
  if (!me)
    return;
  me->set_temp("block_msg/all", 0);
  message_vision(climbMsg[random(sizeof(climbMsg))], me);
  me->set_temp("block_msg/all", 1);
  call_out("climbing" + sprintf("%d", 1 + random(3)), 1 + random(3), me);
}

void climbing4(object me) {
  remove_call_out("climbing4");
  if (!me)
    return;
  me->set_temp("block_msg/all", 0);
  message_vision(climbMsg[random(sizeof(climbMsg))], me);
  me->set_temp("block_msg/all", 1);
  call_out("climbing" + sprintf("%d", 1 + random(3)), 1 + random(3), me);
}

void climbing3(object me) {
  int pot;
  string msg;
  remove_call_out("climbing3");
  if (!me)
    return;
  me->set_temp("block_msg/all", 0);
  pot = me->query_kar() / 2;
  pot += me->query_str() / 2;
  pot += random(20);
  if (me->query_temp("炼妖壶/treeClimbed") || !me->query_temp("炼妖壶/zhangAsked")) {
    tell_object(me, "你爬进树叶丛中，却没有什么发现，不由索然而返。\n");
    me->move(this_object());
    message_vision("\n“哗啦”一声，$N从树上下来，败兴的道：什么也没有。\n\n", me);
    return;
  }
  if (random(pot) < 30) {
    tell_object(me, "糟糕！你一不留神，一脚踩空，从树上摔了下来！\n");
    me->move(this_object());
    message("vision", "\n“哗啦”一声，" + me->name() + "脚下踩空，身子一栽，从枝叶中跌了下来！\n\n", this_object(), me);
    if (me->query("kee") < 500)
      me->unconcious();
    else {
      pot = 250 + random(250);
      msg = "“砰”的一声，$N四脚朝天的摔将下来，$P奋力护住要害，结果$l狠狠的撞到了地面上！\n";
      msg += COMBAT_D->damage_msg(pot, "淤伤");
      msg = replace_string(msg, "$n", "$N");
      msg = replace_string(msg, "$l", me->query("limbs")[random(sizeof(me->query("limbs")))]);
      message_vision(msg, me);
      me->receive_damage("kee", pot);
      COMBAT_D->report_status(me);
    }
  } else {
    me->move("/d/炼妖壶/road");
    message_vision("树叶哗啦一响，$N从里面跳将出来。\n", me);
    message_vision("$N见到眼前情景，不由道了声“好造化！”\n", me);
    me->set_temp("炼妖壶/treeClimbed", 1);
    me->start_busy(1);
  }
}
