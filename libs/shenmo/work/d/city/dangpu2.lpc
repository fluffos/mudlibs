// 破解"长生诀"关键突破地点 dangpu2.c 
#include <room.h>
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "绣楼");
  set("long", @LONG
这里是董家小姐的闺房．室内装饰典雅，摆设颇为考究。
来到了这里，朱雀大街上的熙熙攘攘一瞬间变得销声匿迹。
阳台摆满了远道运来的洛阳牡丹，清香馥郁。墙角摆着一张
黝黑的楠木桌子，十分碍眼。董小姐正托腮蹙眉立于窗前，
听说她可是见过大世面的人，绝非一个普通的当铺老板的千
金小姐。
LONG
  );
  set("item_desc", ([ /* sizeof() == 2 */
    "楠木桌子": "你走近一看，桌子上竟然供着一个牌位。
",
    "牌位": "牌位上写着：舅父王世充之位。
",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/shuni": 1,
  ]));
  set("exits", ([ /* sizeof() == 1 */
    "down": __DIR__ "dangpu",
  ]));
  create_door("down", "天窗暗门", "up", DOOR_CLOSED);
  set("no_clean_up", 0);
  set("no_magic", 1);
  set("no_quit", 1);
  setup();
}
void init() {
  add_action("do_push", "push");
}
int do_push(string arg) {
  object me = this_player();
  if ((arg != "牌位") || !arg)
    return notify_fail("你要推什么？\n");
  if (me->is_busy()) return notify_fail("你忙着呢！\n");
  if (me->query_temp("no_move")) return notify_fail("你被定住了，什么也干不了。\n");
  if (me->query("chshjue_ask") != 1) return notify_fail("董淑妮冷冷地看着你，你想干什么？\n");
  if (me->query("twolong") == 1 && random(me->query("kar")) < 15) {
    message_vision(RED "突然从牌位后面射出一支毒箭，疾若闪电，$N躲闪不及，毒箭正中咽喉！\n" NOR, me);
    me->delete_temp("last_damage_from");
    me->set_temp("death_msg", "被暗箭射杀了。\n");
    me->die();
    me->save();
    return 1;
  }
  me->move("/d/eastway/twolong");
  me->set("twolong", 1);
  return 1;
}
