#include <ansi.h>
inherit ROOM;

void create ()
{
set ("short", "赌场大门");
set ("long", @LONG

这是长安城里最大的一家赌场了。素来以入金五斗着称。门口挂了一
块牌子 (paizi)。老板是个很精明的生意人，见你走了进来，很客气
地和你寒暄，但眼睛里却没有什么笑意，很审慎地打量着你。
LONG);
set("exits", ([ 
	"east"		: __DIR__"clubup",
	"enter"	: __DIR__"duchang",
]));

set("item_desc", ([ 
	"paizi" : "
本赌场财力雄厚，童叟无欺，欢迎惠顾，绝对保密。
客官可以在这里：

	购买筹码(buy chip)

	兑换筹码(sell chip)

各种货物，铜钱、银两、黄金、银票一概通用。

"]));

set("no_clean_up", 1);
set("no_magic",1);
set("no_fight",1);
setup();
}

int clean_up()
{
return 0;
}

void init()
{
add_action("do_none","bian");
add_action("do_none","bid");
add_action("do_gets","buy");
add_action("do_backs","sell");
}

int do_none()
{
return 1;
}

int do_gets(string arg)
{
int afford,value;
object ob;
object me = this_player();
value = 10000;

if ( !arg || arg!="chip" )
	return notify_fail("你只可以在此购买筹码(buy chip),一次购买价值1两黄金的筹码(10)个。\n");
if( afford = me->can_afford(value) ) 
	{
	if( afford==2 ) 
		return notify_fail("你没有足够的零钱，而银票又没人找得开。\n");
	message_vision(CYN"$N"CYN"向赌场购买了10个筹码。\n"NOR,me);	
	me->pay_money(value);
	ob = new(__DIR__"obj/chouma");
	ob->set_amount(10);
	ob->set("owner",me);
	ob->save();
	ob->move(me);
	return 1;
	}
return notify_fail("你没有足够的钱。\n");
}

int do_backs(string arg)
{
int amount,num;
object ob;
object me = this_player();

if ( !arg )
	return notify_fail("你想兑换什么？\n");

if ( sscanf(arg,"chip %d",amount)!=1 )
	return notify_fail("命令格式 sell chip <数量>\n");

ob = present("chou ma",me);
if ( !ob || userp(ob) )
	return notify_fail("你身上已没筹码了。\n");
if ( ob->query("owner")!=me )
	return notify_fail("筹码不是你的？！\n");
if ( ob->amount()<amount )
	return notify_fail("你身上的筹码不够这个数。\n");
ob->add_amount(-amount);
if ( ob->amount()<= 0 )
	destruct(ob);
num = 100;
num*= amount;
message_vision(CYN"$N"CYN"拿出"+amount+"个筹码换了"+MONEY_D->price_str(num)+CYN"。\n"NOR,me);
me->add("balance",num);
tell_object(me,CYN+MONEY_D->price_str(num)+CYN"已存入你的钱庄帐户，请注意查收。\n"NOR);
me->save();
return 1;
}
