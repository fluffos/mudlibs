inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "温柔乡");
  set("long", @LONG

顾名思义，此处是长安城中狂蜂浪蝶聚集之地。来来往往的全是
官宦子弟，也不乏京城中有脸面的达官贵人。
姑娘们打扮的花枝招展，对着众人眉目传情。
再往里去便是赌场。

LONG);

  set("objects", ([
    "/u/run/npc/girl": 1,
  ]));
  set("exits", ([ /* sizeof() == 1 */
    "east": __DIR__ "club",
    //        "west" : __DIR__"duchang",
  ]));
  set("light_up", 1);
  set("no_fight", 1);
  set("no_magic", 1);
  set("no_clean_up", 1);
  setup();
}

void init() {
  add_action("do_none", "get");
  add_action("do_none", "perform");
  add_action("do_none", "bian");
  add_action("do_none", "cast");
  add_action("do_none", "apply");
  add_action("do_none", "put");
  add_action("do_none", "move");
}

int do_none() {
  message_vision("及时行乐吧。\n", this_player());
  return 1;
}
