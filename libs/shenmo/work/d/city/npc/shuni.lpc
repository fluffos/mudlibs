#include <ansi.h>

inherit NPC;
#define MAX_PAWN 50

inherit F_VENDOR;

void create()

{
set_name("董淑妮", ({"dong shuni", "dong", "shuni"}));
set("title", HIM"闭月羞花"NOR);
set("gender", "女性");
set("age", 29);
set("kee", 8000);
set("max_kee", 8000);
set("sen", 8000);
set("max_sen", 8000);
set("combat_exp", 9000000);
set("attitude", "friendly");
set("rank_info/respect", "富家小姐");
set("per",30);
set("max_force", 1000);
set("force", 20000);
set("force_factor", 1000);
set_skill("unarmed",1000);
set_skill("force",1000);
set_skill("ningxie-force",200);
set_skill("dodge",1000);
set_skill("parry", 1000);
set_skill("blade", 1000);
set("long",
"董朴升的侄女，王世充的外甥女。玄武门之变后投奔到叔叔家。\n");
set("inquiry", ([
"寇仲"     : "我也不知道他去哪了，别再提那个负心人吧！\n",
"name"     : "小女子淑妮，请多指教！\n",
"here"     : "这个地方很隐蔽的，你是怎么知道的？\n",
"父亲"     : "我父亲是前朝户部尚书，他老人家早已仙逝多年了。\n",
"舅舅"     : "舅舅最疼我了，可惜他始终放不下他的皇帝梦。\n",
"叔叔"     : "叔叔是个财迷，不过待我还好。\n",
"长生诀"     : "不该问的不要问！想学这门奇功，还是去找那个负心人吧！\n", 
]));
setup();
carry_object("/d/qujing/tianzhu/obj/hongqun")->wear();
carry_object("/d/xuyi/obj/shield")->wear();
carry_object("/d/qujing/tianzhu/obj/baojie")->wear();
carry_object("/d/obj/weapon/blade/handudao-redblue")->wield();
}
void init()
{
add_action("do_pawn", "pawn");
add_action("do_redeem", "redeem");
}
