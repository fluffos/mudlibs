#include <ansi.h>

inherit NPC;
int renwu();
int renwu_dajiu();
int renwu_cike();
string modify_cloth();
string give_lianhua();
string give_gift();

mapping a_types = ([
        "heads"          : ({"顶","装备在头上遮风挡雨。",8,1000}),
        "necks"          : ({"串","戴在脖子上驱恶辟邪。",3,500}),
        "cloths"         : ({"朵","穿在身上挡风御寒。",20,3000}),
        "armors"         : ({"抹","穿在身上抵挡刀箭。",40,5000}),
        "surcoats"       : ({"朵","披在身后遮风挡雨。",25,2000}),
        "waists"         : ({"串","佩在腰间驱恶辟邪。",5,1000}),
        "wristss"        : ({"串","戴在指间驱恶辟邪。",3,500}),
        "shields"        : ({"朵","拿中手中抵挡刀箭。",20,2500}),
        "fingers"        : ({"朵","捏在指尖驱恶辟邪。",3,500}),
        "bootss"         : ({"对","踩在脚下驱恶辟邪。",15,800}),

]);

mapping t_msg = ([
          "kee"         :  HIG"增加气血"NOR,
          "eff_kee"     :  HIR"治疗气血"NOR,
          "sen"         :  HIM"增加精神"NOR,
          "eff_sen"     :  HIW"治疗精神"NOR,
          "force"       :  HIY"内力补充"NOR,
          "mana"        :  HIB"法力补充"NOR,
]);
string *tps = ({"kee","eff_kee","sen","eff_sen","force","mana"});
void create()
{
            set_name(""HIC"☆TOM☆"NOR"", ({"npc tom", "npc","tom"}));
        set("long", "他是发送装备的TOM,你可以(list)查看想要的东西。\n");
        set("gender", "男性");
        set("age", 20);
        set("per", 40);
       set("title",""HIG"☆天王☆");
        set_skill("literate", 141);
        set("chat_chance",20);
    set("chat_msg", ({
        "☆TOM☆轻声告诉你：你可以用list指令列出想要的东西！\n",
        "☆TOM☆轻声告诉你：你可以用yao指令向魔术师我索取装备。\n",
        "☆TOM☆轻声告诉你：你可以用yao指令向魔术师我索取装备。\n",
        }));
set("inquiry",([
        "圣衣修正" : (: modify_cloth :),
//        "任务"  :   (: renwu :),
        "dajiu"  :   (: renwu_dajiu :),
//        "莲花"  :   (: give_lianhua :),
//        "开站奖励"  :   (: give_gift :),
        "cike"  :   (: renwu_cike :),
         ]));
        setup();
        carry_object("/d/obj/cloth/magua")->wear();
}

void init()
{
        ::init();
  add_action("do_fight", "fight");
  add_action("do_kill", "kill");
  add_action("do_steal", "steal");
  add_action("do_cast", "cast");
  add_action("do_ji","ji");
  add_action("do_throw","throw");
  add_action("do_list","list");
  add_action("do_yao","yao");
}
string modify_cloth()
{
  object cloth,me;
 me = this_player();
if (!cloth = present("sheng yi",me))
   return "你没有圣衣，怎么修正?\n";
if ( (cloth->query("equipped")!="worn") )
  {
  cloth->set("shield_time",20000);
  cloth->save();
    return "圣衣修正完毕！\n";
  }
return "圣衣必须摘下才能修正！\n";
}

int renwu_dajiu()
{
   object who;
   who=this_player();

   who->set("baohu/job_start",time()+60);
   who->set("baohu/start_time",time()+60);
   command("say 2分钟后可以做dajiu任务了");
   return 1;
}


int renwu_cike()
{
   object who;
   who=this_player();

   who->set("cike_start",time()+60);
   command("say 30分钟后可以做追杀任务了");
   return 1;
}
string give_lianhua()
{
        object armor,me;
        int i,p,we;
        string *a_t,type,llg,unit;
        me = this_player();

    a_t = keys(a_types);
    if( me->query_temp("give_lianhua") )  return "你已经要过莲花了，还要！小心我K你屁股！！！！\n";
    if( me->query("combat_exp") >= 10000000 && !wizardp(me))  return "你功夫已经这么高了，自己动手去打莲花吧！\n";
    for( i =0;i<sizeof(tps);i++)
    {
                armor = new("/d/nanhai/obj/lianhua/lianhua.lpc");
                armor->setup();
                type = a_t[i];
                unit = a_types[type][0];
                llg = a_types[type][1];
                p = a_types[type][2];
                we = a_types[type][3];
                armor->set("armor_type", type);
                armor->set("no_give", 1);
                armor->set("unit",unit);
                armor->set("莲花",([
                                "lvl"           : 4,
                                "addType"       : tps[i],       ]));

                armor->set("long",HIC"一"+unit+"莲花，可以"+llg+"\n"NOR);
                armor->set_weight(we);
                armor->set("armor_prop/base", p);
                p+= random(p/2);
                armor->set("armor_prop/armor", p);
                armor->move(me);
                me->set_temp("give_lianhua",1);
                }
        return "ok！有了莲花要好好努力呀\n";
}

int renwu()
{
   object who;
   who=this_player();

   who->delete("secmieyao_mudage");
   who->add("daoxing",-10000);
   command("say 现在可以做师门任务了");
   return 1;
}

string give_gift()
{
   object me;
   string ip;
   me=this_player();
   ip = query_ip_number(me);
   if ( !stringp(ip) ) { tell_object(me,"ip出错.\n");return "你的IP我不认识\n";} 
   if( query(ip,1) ) return "一个IP只能要一次奖励\n";
   if( me->query("kz_gift") ) return "你已经要过开站奖励了\n";
   set(ip,1);
   me->set("kz_gift",1);
   me->add("balance",10000000);
   me->add("c_balance",100000000);
   return "好了去，找宝物大使申请card吧\n";
}

int do_cast(string arg)
{
  object who = this_player();
  object me = this_object();

    message_vision("$N对着☆TOM☆结结巴巴的念了几句咒语，自己都感觉难听死了。\n",who,me);

  return 1;
}


int do_steal(string arg)
{
  object who = this_player();
  object me = this_object();

  message_vision("$N想偷东西，但总是有贼心没贼胆。\n",who,me);

  return 1;
}

int do_ji(string arg)
{
  object who = this_player();
  object me = this_object();

  message_vision("$N想对魔术师祭法宝，前思后想，还是没敢。\n",who,me);

  return 1;
}

int do_throw(string arg)
{
  object who = this_player();
  object me = this_object();

  message_vision("$N掏出暗器，看了看☆TOM☆，信心不足，又把暗器收了起来。\n",who,me);

  return 1;
}

int do_list(string arg)
{
        object who = this_player();
        object me = this_object();
  message("vision",""HIG"\n─────────────────────────────────────
          \n"HIY"盔甲："HIC"
          1.金甲(armor)     2. 披风(pifeng)   3.盾牌(shield)
          4.铁盔(kui)       5. 战袍(cloth)    6.踏云靴(shoes)
          \n"HIY"兵器："HIC"
          1.降魔棒(stick)   2. 青虹剑(sword)  3.软龙筋(whip)
          4.金刀(blade)     5. 短铁爪(zhua)   6.黄铜禅杖(staff)
          7.宣花斧(axe)     8. 月牙铲(fork)   9.梅花锤(hammer)
          10.点金枪(spear)  11.凤凰琴(qin)    12.虎尾鞭(mace)
          13.银针 (zhen)    14.五齿钉耙(rake)
"HIG"\n─────────────────────────────────────\n"NOR"",who,me);

  return 1;
}

