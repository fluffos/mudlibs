#include <ansi.h>
inherit NPC;
int ask_leave();
void jieguo(object me,object ob);

string *names = ({
                "张三","zhang san",
                "李四","li si",
                "王二","wang er",
                "赵六","zhao liu",
                "钱一","qian yi",
                "孙五","sun wu",
                "马八","ma ba",
                });

void create()
{
int i;
string name,id;
i = random(sizeof(names)/2)*2;
name = names[i];
id = names[i+1];
set_name(name, ({"lao yi",id }));
set("title", "牢役");
set("long","看守监牢的衙役。\n");
set("gender", "男性");
set("age", 29);
set("attitude", "peaceful");
set("rank_info/self", "老子");
set("rank_info/respect", "官差");
set("per",20+random(20));
set("int",20+random(20));
set("max_kee", 1000);
set("max_gin", 1000);
set("max_sen", 1000);
set("force", 2000);
set("max_force",1000);
set("max_mana", 1000);
set("mana", 2000);
set("combat_exp", 1000000);
set("daoxing", 1000000);

set_skill("literate", 100);
set_skill("spells", 100);
set_skill("moonshentong", 100);
set_skill("force", 100);
set_skill("moonforce", 100);

map_skill("spells", "moonshentong");
map_skill("force", "moonforce");

set("inquiry", ([ 
        "释放"  :       (:ask_leave:), 
]));

setup();
carry_object("/d/obj/cloth/skirt")->wear(); 
carry_object("/d/ourhome/obj/shoes")->wear(); 
}

int ask_leave()
{
int pot;
object me = this_player();
object ob = this_object();

pot = me->query("赌场/钱");

if ( !pot || pot<10000 )
        {
        me->delete("赌场");
        me->set("start-room","/d/city/kezhan");
        command("say 恭喜，你已经刑满了，快些走(out)吧......\n");
        return 1;
        }

if ( !me->query_temp("out_paid") )
        {       
        command("say 帮你说情也好，但是得再搞个"+chinese_number(pot/10000)+"两黄金过去活动活动，你自己掂量着办吧。\n");
        return 1;
        }
me->delete_temp("out_paid");
me->save();
command("say 好，我帮你出去打点打点，你等会再看看情况吧。\n");
call_out("jieguo",3+random(5),me,ob);
return 1;
}

void jieguo(object me,object ob)
{
int pot;
pot = me->query("赌场/钱");

remove_call_out("jieguo");

if ( !pot || pot<10000 )
        {
        message_vision("$n面带喜色，走了进来。\n",me,ob);
        command("tell "+me->query("id")+" 恭喜恭喜，经过我多方打点，此事已成，你可以回去(out)了。\n");
        return;
        }
message_vision("$n面带难色，走了进来。\n",me,ob);
command("tell "+me->query("id")+" 不成，此事还得再加些银两打点一切。\n");
return;
}

int accept_object( object me,object ob)
{
int pot,max;

if ( !userp(me) ) 
        return notify_fail("小猫小狗的也来捣乱？！\n"); 

pot=ob->value();
max = me->query("赌场/钱");

if ( ob->query("money_id") && pot>=max )  
        { 
        message_vision("$N鬼鬼祟祟的掏出一包东西递给衙役。\n",me);
        command("grin "+me->query("id"));
        command("whisper "+me->query("id")+" 明白，你就等好消息吧，待会问我就行了...\n");
        me->set_temp("out_paid",1);
         me->add("赌场/钱",-pot); 
         me->save();    
        return 1; 
        } 
command("say 这么点钱也想贿赂本大爷？！！\n");
return 1;
} 

