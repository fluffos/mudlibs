#include <ansi.h>
inherit NPC;

#define NAMES_D "/u/run/hs/city/npc/named.lpc" 

string *banned_name = ({
	"你", "我", "他", "她", "它", "它", "江泽民", "邓小平", "李鹏", "朱榕基",
	"自己", "某人", "尸体", "我们","你们", "他们", "大家","李靖对你", "李靖","喜鹊",
	"云阳真人", "西王母", " 酒剑仙", "惠岸行者", "地藏王菩萨", "敖广", "秦琼", "玉鼠", 
        "白象尊者", "镇元大仙", "青霞仙子", "老者", "黄飞虎", "妲己", "管家", "风无影",
	"他妈的", "去你的", "毛泽东", "巫师", "他奶奶的","圣恩","巫师","眠兔",
});

string check_me()
{
object me = this_player();
if ( me->query_temp("rename_gived") )
	{
	tell_object(me,name()+"对你拱手一笑："+RANK_D->query_respect(me)+"请自便，改名
只需 rename <新名> 即可。(可加颜色)\n示例：\n\t\t\t rename HIR红剑\n则更名为"HIR"红剑\n"NOR);
	tell_object(me,name()+"对你拱手一笑："+RANK_D->query_respect(me)+"请自便，改ID
只需 reid <新id> 即可。\n示例：\n\t\t\t reid sword\n则ID更名为 sword\n"NOR);
	}
else	tell_object(me,name()+"对你拱手一笑："+RANK_D->query_respect(me)+"若想将自己武
器的名份修改，需要给我黄金一百两。\n");
return RANK_D->query_respect(me)+"请自便。\n\n";
}

void create()
{
mapping name = NAMES_D->random_name(0,1,0,"名",0); 
if( !name ) 
	name = ([ "name": "柳新名",  "id": ({ "liu xinming", "liu", "ming"}) ]); 
set_name(name["name"], name["id"]); 
set("title","工部侍郎"NOR);
set("age",20);
set("per",25);
set("str",40);
set("con",40);
set("max_kee",10000);
set("max_gin",10000);
set("max_sen",10000);
set("inquiry",([
	"姓名" : "我便是工部侍郎"+query("name")+"。\n",
	"地方" : "这里便是大唐国都长安---天子脚下哦。\n",
	"武器" : (: check_me :),
]));
setup();
carry_object("/d/obj/cloth/jinpao")->wear();
carry_object("/d/obj/cloth/guanxue")->wear();
}

void init()
{
add_action("do_change","rename");
add_action("do_changeid","reid");
}

int accept_object(object me,object ob)
{
if ( !(string)me->query("weapon/name") )
	{
	say(name()+"摇了摇头："+RANK_D->query_respect(me)+"尚无称手的奇刃，还是算了吧。\n");
	return 0;
	}
if ( me->query_temp("rename_gived") )
	{
	say(name()+"呵呵一笑："+RANK_D->query_respect(me)+"方才不是已经给过了吗？\n");
	return 0;
	}
if ( ob->query("money_id") && ob->value()>= 1000000 )  
	{
	say(name()+"呵呵一笑：既然如此，下官也不推辞了....\n");
	me->set_temp("rename_gived",1);
	me->save();
	return 1;
	}
tell_object(me,name()+"摇了摇头，面露为难之色：这个这个，如今圣上严明，你给我
这些，万一给皇上知道，责令吏部查下来，恐怕....\n");
return 0;
}

int do_change(string arg)
{
object me = this_player();
if ( !me->query_temp("rename_gived") || !(string)me->query("weapon/name") )
	return 1;
if ( !arg )
	return notify_fail("你想改什么名？\n");
if( member_array(arg,banned_name)!=-1 ) 
	{
	write("对不起，这种名字会造成其他人的困扰。\n");
	return 0;
	}
arg = replace_string(arg, "BLK", BLK"");
arg = replace_string(arg, "RED", RED"");
arg = replace_string(arg, "GRN", GRN"");
arg = replace_string(arg, "YEL", YEL"");
arg = replace_string(arg, "BLU", BLU"");
arg = replace_string(arg, "MAG", MAG"");
arg = replace_string(arg, "CYN", CYN"");
arg = replace_string(arg, "WHT", WHT"");
arg = replace_string(arg, "HIR", HIR"");
arg = replace_string(arg, "HIG", HIG"");
arg = replace_string(arg, "HIY", HIY"");
arg = replace_string(arg, "HIB", HIB"");
arg = replace_string(arg, "HIM", HIM"");
arg = replace_string(arg, "HIC", HIC"");
arg = replace_string(arg, "HIW", HIW"");
arg = replace_string(arg, "NOR", NOR"");
	
arg = replace_string(arg, "HBRED",HBRED"");
arg = replace_string(arg, "HBGRN",HBGRN"");
arg = replace_string(arg, "HBYEL",HBYEL"");
arg = replace_string(arg, "HBBLU",HBBLU"");
arg = replace_string(arg, "HBMAG",HBMAG"");
arg = replace_string(arg, "HBCYN",HBCYN"");
arg = replace_string(arg, "HBWHT",HBWHT"");
arg = replace_string(arg, "BRED",BRED"");
arg = replace_string(arg, "BGRN",BGRN"");
arg = replace_string(arg, "BYEL",BYEL"");
arg = replace_string(arg, "BBLU",BBLU"");
arg = replace_string(arg, "BMAG",BMAG"");
arg = replace_string(arg, "BCYN",BCYN"");

arg+= ""NOR;
me->set("weapon/name",arg);
me->delete_temp("rename_gived");
me->save();
tell_object(me,"你的武器已经变更为"+arg+"\n");
say("更名完毕，需要你手动更新一下。\n");
return 1;
}

int do_changeid(string arg)
{
object me = this_player();
if ( !me->query_temp("rename_gived") || !(string)me->query("weapon/name") )
	return 1;
if ( !arg )
	return notify_fail("你想改什么名？\n");
me->set("weapon/id",arg);
me->delete_temp("rename_gived");
me->save();
tell_object(me,"你的武器ID已经变更为"+arg+"\n");
say("更名完毕，需要你手动更新一下。\n");
return 1;
}
