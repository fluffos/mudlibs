inherit NPC;
#include <ansi.h>

string *banned_name = ({ 
		"你", "我", "他", "她", "它", "它", "江泽民", "邓小平", "李鹏", "朱榕基", 
		"自己", "某人", "尸体", "我们","你们", "他们", "大家", 
		"他妈的", "去你的", "毛泽东", "巫师", "他奶奶的",
}); 

int check_legal_name(string);
 
void create()
{
set_name("长孙无忌", ({"zhangsun wuji","wuji"}));
set("gender", "男性");
set("title","户部尚书");
set("age", 55);
set("str", 25);
set("int",30);
set("attitude", "friendly");
set("combat_exp", 30000);
set("daoxing", 50000);
set("attitude", "friendly");
set("class", "human");
set_skill("unarmed", 50);
set_skill("dodge",50);
set_skill("literate", 100);
set_skill("parry", 50);
set("force", 500);
setup();
carry_object("/d/obj/cloth/choupao")->wear();
add_money("silver", 1);
}

void init()
{
object ob;
::init();
add_action("do_apply", "apply");
add_action("do_newname", "newname");
//add_action("do_rename", "rename"); 
add_action("do_confirm","confirm");
this_player()->delete_temp("new_rank");
}

int do_apply(string arg) 
{ 
string type,rank;    
object me=this_player(); 
string msg="你准备将"; 
int afford,dx; 

if (!arg) 
	return notify_fail(@LONG 
	格式： apply <类别> to <称谓> 
	类别／价格／道行要求： 
	self        对自己的称呼      五十两黄金   一百年 
	self_rude   对自己的粗鲁称呼  五十两黄金   一百年 
        respect     别人对自己的尊称  五十两黄金   一百年 

	又：请勿使用不恰当的称谓。不然称呼被取消，五十两 
	金子就白白扔了。至于恰当与否，则由天上神仙决定。 

LONG); 

if (sscanf(arg,"%s to %s",type,rank)!=2)   
	return notify_fail(@LONG 
	格式： apply <类别> to <称谓> 
	类别／价格： 
	self          对自己的称呼         五十两黄金 
	self_rude     对自己的粗鲁称呼     五十两黄金 
	respect       别人对自己的尊称     五十两黄金 

	又：请勿使用不恰当的称谓。不然称呼被取消，五十两 
	金子就白白扔了。至于恰当与否，则由天上神仙决定。 

LONG); 

switch ( type )
	{
	case "respect":
                dx=100000;
		msg+="别人对自己的尊称从现在的“"+RANK_D->query_respect(me);
		break;
	case "self" :
		dx=100000;
		msg+="对自己的称呼从现在的“"+RANK_D->query_self(me);
		break;
	case "self_rude":
		dx=100000;
		msg+="对自己的粗鲁称呼从现在的“"+RANK_D->query_self_rude(me);
		break;
	default:
		return notify_fail("你要申请那种称呼?\n");
	}

if ( me->query("daoxing")<dx )
	return notify_fail("你道行那么低，本来就没人听说过你，不改也罢。\n"); 

if( !(afford=me->can_afford(500000)) )  
	return notify_fail("你带的钱不够。\n"); 
else if( afford == 2 )  
	return notify_fail("现金交易，不收银票。你带的现金不够。\n"); 

msg+="”改成“"+rank+"”，是这样吗？(confirm)\n"; 
write(msg); 
me->set_temp("new_rank/type",type); 
me->set_temp("new_rank/ready",1); 
me->set_temp("new_rank/rank",rank); 
return 1; 
} 

int do_confirm() 
{ 
object me=this_player(); 
int afford; 

if (!me->query_temp("new_rank/ready")) 
	return 0; 

if( !(afford=me->can_afford(500000)) )  
	return notify_fail("你带的钱不够。\n"); 
else if( afford == 2 )
	return notify_fail("现金交易，不收银票。你带的现金不够。\n"); 

message_vision("$N拿出五十两金子，交给了$n。\n",me,this_object()); 
message_vision("$N点了点头，拿出一份卷宗写了几笔。\n",this_object()); 
me->pay_money(500000); 
if (me->query_temp("new_rank/rank")=="cancel") 
	me->delete("rank_info/"+me->query_temp("new_rank/type")); 
else	me->set("rank_info/"+me->query_temp("new_rank/type"),me->query_temp("new_rank/rank")); 
write("改动完毕。\n"); 
log_file("change_rank",me->query("id")+" changes "+me->query_temp("new_rank/type")+" to " 
	+me->query_temp("new_rank/rank")+" on "+ctime(time())+".\n"); 

me->delete_temp("new_rank"); 
return 1; 
} 

int do_newname(string arg) 
{ 
string msg;	
object me=this_player(); 
int pot = 100+random(400);
if (me->query("gender")=="无性")
  return notify_fail("你已然入宫，名字已非你能左右。\n");
if (!arg) 
	{
	msg = @LONG 
	格式： newname <新名字>  
	要求： 潜能$N点

	
LONG;
	msg = replace_string(msg,"$N",chinese_number(pot));
	msg = replace_string(msg,"$M",chinese_number(pot*5));
	return notify_fail(msg);
	}     

arg = CONVERT_D->input(arg,me); 

if( !check_legal_name(arg) ) 
	return notify_fail("你输入的名字不合法!请重新输入!\n"); 

if( me->query("potential")<pot )  
	return notify_fail("你的潜能不够。\n"); 

if ( me->query("age")<16 )
	return notify_fail("你尚未成年。\n");

message_vision("$N朝$n使了个脸色。\n",me,this_object()); 
message_vision("$N点了点头，拿出一份卷宗写了几笔。\n",this_object()); 
me->set("name",arg);
me->add("potential",-pot);
me->save();
write("你的名字更改完毕。\n"); 
return 1; 
} 

int do_rename(string arg) 
{ 
string *clo,msg;	
object me=this_player(); 
int i,pot = 500+random(500);

if (!arg) 
	{
	msg = @LONG 
	格式： newname <新名字>  
	要求： 潜能$N点

	格式： rename <颜色>
	要求： 潜能$M点
	示例： rename HIW
	
LONG;
        msg = replace_string(msg,"$N",chinese_number(pot/5));
        msg = replace_string(msg,"$M",chinese_number(pot));
	return notify_fail(msg);
	}     

clo = ({
	"BLK","BBLK","RED","HIR","HBRED","BRED",
	"GRN","HIG","HBGRN","BGRN",
	"YEL","HIY","HBYEL","BYEL",
	"HIB","BLU","HBBLU","BBLU",
	"MAG","HBMAG","BMAG",
	"CYN","HIC","HIM","HBCYN",
	"BCYN","WHT","HIW","HBWHT",
});	
		
if( member_array(arg,clo)==-1 ) 
	return notify_fail("对不起，没有这种颜色。\n"); 

arg = replace_string(arg,"HBGRN",HBGRN"");
arg = replace_string(arg,"HBRED",HBRED"");
arg = replace_string(arg,"HBYEL",HBYEL"");
arg = replace_string(arg,"HBBLU",HBBLU"");
arg = replace_string(arg,"HBMAG",HBMAG"");
arg = replace_string(arg,"HBCYN",HBCYN"");
arg = replace_string(arg,"HBWHT",HBWHT"");

arg = replace_string(arg,"BBLK",BBLK"");
arg = replace_string(arg,"BRED",BRED"");
arg = replace_string(arg,"BGRN",BGRN"");
arg = replace_string(arg,"BYEL",BYEL"");
arg = replace_string(arg,"BBLU",BBLU"");
arg = replace_string(arg,"BMAG",BMAG"");
arg = replace_string(arg,"BCYN",BCYN"");

arg = replace_string(arg,"BLK",BLK"");
arg = replace_string(arg,"RED",RED"");
arg = replace_string(arg,"HIR",HIR"");
arg = replace_string(arg,"GRN",GRN"");
arg = replace_string(arg,"HIG",HIG"");
arg = replace_string(arg,"YEL",YEL"");
arg = replace_string(arg,"HIY",HIY"");
arg = replace_string(arg,"HIB",HIB"");
arg = replace_string(arg,"BLU",BLU"");
arg = replace_string(arg,"MAG",MAG"");
arg = replace_string(arg,"CYN",CYN"");
arg = replace_string(arg,"HIC",HIC"");
arg = replace_string(arg,"HIM",HIM"");
arg = replace_string(arg,"WHT",WHT"");
arg = replace_string(arg,"HIW",HIW"");

if( me->query("potential")<pot )  
	return notify_fail("你的潜能不够。\n"); 

if ( me->query("age")<20 )
	return notify_fail("你尚未成年。\n");
	
message_vision("$N朝$n使了个脸色。\n",me,this_object()); 
message_vision("$N点了点头，拿出一份卷宗写了几笔。\n",this_object()); 
me->set("name",arg+me->query("name")+NOR);
me->add("potential",-pot);
me->save();
write("你的名字更改完毕。\n"); 
return 1; 
} 

int check_legal_name(string name) 
{ 
int i = strlen(name); 

if( (strlen(name) < 2) || (strlen(name) > 12 ) ) 
        {
	write("对不起，你的中文名字必须是一到六个中文字。\n"); 
	return 0; 
	} 
while(i--) 
	{ 
	if( name[i]<=' ' ) 
		{ 
		write("对不起，你的中文名字不能用控制字符。\n"); 
		return 0; 
		} 
	if( i%2==0 && !is_chinese(name[i..<0]) ) 
		{ 
		write("对不起，请您用「中文」取名字。\n"); 
		return 0; 
		} 
	} 
if( member_array(name, banned_name)!=-1 ) 
	{ 
	write("对不起，这种名字会造成其他人的困扰。\n"); 
	return 0; 
	} 
return 1; 
} 
