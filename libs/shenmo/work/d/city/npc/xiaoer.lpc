//xiaoer.c
#include <ansi.h>
inherit F_VENDOR_SALE;

void clear_room();

void create()
{
string str;
reload("xiaoer");
set_name("佟湘玉", ({"tong xiangyu","xiao er","xiao er","xiao","waiter","er","xiangyu","tong"}));
//set("long","对天上人间作出巨大贡献的玩家，被天神提升为客栈总管，负责日常用品的销售。\n");
set("shop_id",({"waiter","xiaoer","xiao","er"}));
set("nickname",HIR"南城客栈·栈主"NOR);
set("gender", "女性");
set("combat_exp", 1000);
set("age", 26);
set("per", 24);
set("str", 100);
set("attitude", "friendly");
set("shen_type", 1);
set_skill("unarmed", 1000);
set("max_price",20);
set("vendor_goods", ([
//                "tu": "/d/quest/task/tu",
                "shi": "/clone/misc/findbook",
                "jiudai": "/d/moon/obj/jiudai",
                "gourou": "/d/ourhome/obj/gourou",
                "stamp": "/d/maze/qinling/obj/stamp",
                "pillow": "/d/obj/misc/pillow",
                "wan": "/d/city/obj/newwan.lpc",
                 "mao": "/d/lingtai/obj/shengmao",
                "jitui": "/d/ourhome/obj/jitui",
                "ball":"/d/obj/misc/crystalball",
                "jinpai" : "/d/city/obj/jinpai" ,
                "yunqi": "/u/shulele/smstore/npc/obj/yunqi",
                "huasheng": "/d/ourhome/obj/huasheng",
                "box": "/d/city/obj/xiazi",
                "head": "/d/city/obj/head.lpc",  
                "enchou": "/d/snowtu/obj/remove_kill.lpc",
                "tie" : "/u/snowtu/obj/miaoshu.lpc",
              "shenmo": "/u/shulele/shenmo2",
               "shd" : "/u/shulele/sc/sf/shihun-1.lpc",
              "sfq" : "/u/shulele/sc/sf/shenfa-2.lpc",
			  "feijian" : "/u/shulele/obj/feijian",
]) ); 
setup();
carry_object("/obj/loginload/skirt")->wear();
carry_object("/obj/loginload/shoes")->wear();
add_money("silver", 1);
}

void init()
{
object me,ob;
me=this_object();
ob=this_player();
if( interactive(ob) && !is_fighting() ) 
        {
        remove_call_out("greeting");
        call_out("greeting", 1, ob);
        }
add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
if( !ob || !visible(ob) || environment(ob) != environment() ) return;
switch( random(3) )
        {  // 1/3 chance to greet.
        case 0:
                say( name()+"笑咪咪地说道：这位" +RANK_D->query_respect(ob)+ "，进来歇歇脚，喝两盅吧。\n");
                break;
        }
}

int pay_player(object who, int amount)
{
int v;
object ob;

if ( !who )
        return 0;
if (amount < 1)
    return 0;
if (v = amount / 10000) 
        {
        ob = new("/obj/money/gold");
        ob->set_amount(amount/10000);
        if ( ob->query_encumbrance()+who->query_encumbrance()>=who->query_max_encumbrance() )
                {
                write("你身上装不了这么重的东西。\n");
                return 0;
                }               
        if ( !ob->move(who) )
                return amount;
        amount %= 10000;
        }
if ( amount/100 ) 
        {
        ob = new("/obj/money/silver");
        ob->set_amount(amount / 100);
        if ( ob->query_encumbrance()+who->query_encumbrance()>=who->query_max_encumbrance() )
                {
                write("你身上装不了这么重的东西。\n");
                return 0;
                }               
        if ( !ob->move(who) )
                return amount;
        amount %= 100;
        }
if (amount) 
        {
        ob = new("/obj/money/coin");
        ob->set_amount(amount);
        if ( ob->query_encumbrance()+who->query_encumbrance()>=who->query_max_encumbrance() )
                {
                write("你身上装不了这么重的东西。\n");
                return 0;
                }               
        if ( !ob->move(who) )
                return amount;
        }
return 1;
}
int accept_object(object who, object ob)
{
int value;

if ( ob->query("money_id") && (value=ob->value()) >= 300 ) 
        {
        tell_object(who, name()+"一哈腰，说道：多谢您老，客官请上房歇息。\n");
        who->set_temp("rent_paid",1);
        take_money(value, 300);
        return 1;
        }
if ( ob->query("no_drop") || ob->query("no_give") || ob->query("no_put") || ob->query("no_sell") )   return 0;
//负重判定
if ( who->query_encumbrance()+ob->weight()>who->query_max_encumbrance() )
       return 1;
value = ob->query("value")/3;
if ( !pay_player(who,value) )
       return 0;
tell_object(who,name()+"递给你"+MONEY_D->money_str(value)+"。\n");       
return 1;
}

int heal_up()
{
object *inv,env;
int i;
string *place1 = 
        ({"/d/city/zhuque-s1","/d/city/center","/d/city/xuanwu-n1",
        "/d/city/baihu-w1","/d/city/qinglong-e1",});
string room;

env = environment();
if ( env )
        {
        inv = all_inventory(env);
        for(i=0;i<sizeof(inv);i++)
                {
                if(inv[i]->query("race")=="野兽") 
                        {
                        room = place1[random(5)];
                        say(inv[i]->query("name")+"被"+name()+"用扫帚赶了出去。\n");
                        inv[i]->move(room);
                        tell_room(environment(inv[i]), inv[i]->query("name")+"被"+name()+"从客栈赶了出来。\n");
                        }
                else if(!inv[i]->is_character()&&!inv[i]->query("board_id"))
                        {       
                        message_vision("$N捡起一"+inv[i]->query("unit")+"$n。\n",this_object(),inv[i]);
                        destruct(inv[i]);
                        }       
                }
        }
return ::heal_up()+300;
}
