#include <weapon.h>
#include "obj.h"
inherit RAKE;

void create() {
  set_name("五齿钉耙", ({ "wuchi dingpa", "pa", "rake" }));
  set_weight(10000);
  set("long", "一把仿制品。\n");
  set("unit", "把");
  set("weapon_prop/courage", 10);
  init_rake(70);
  setup();
  set("skill_type", "rake");
  set("weapon_prop", ([
    "damage": 70,
    "courage": 10,
  ]));
  set("flag", 1);
  if (!query("actions")) {
    set("actions", (: call_other, WEAPON_D, "query_action" :));
    set("verbs", ({ "rake", "strike", "bash" }));
  }
}
