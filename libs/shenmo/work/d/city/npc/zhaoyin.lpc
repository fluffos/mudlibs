void create()
{
string name,id,n1,n2,i1,i2;
int i;
i = random(sizeof(name1)/2)*2;
n1= name1[i];
i1= name1[i+1];

i = random(sizeof(name2)/2)*2;
n2= name2[i];
i2= name2[i+1];

name = n1+n2;
id = i1+" "+i2;

set_name(name, ({i1,id,}));

