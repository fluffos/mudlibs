//by djx

#include <ansi.h> 
inherit F_VENDOR_SALE;
string ask_card(); 
string check_weapon()
{
object me = this_player();
if ( !me )  return 0;
if ( !me->query("weapon/type/hand") )
       return "你目前不需要。";
me->set("weapon/type/unarmed",me->query("weapon/type/hand"));
me->delete("weapon/type/hand");
me->save();
return "你的自制武器已经修正完毕。";
}

void create()
{
        
        set_name("宝物大使", ({"baowu dashi", "dashi"}));
        set("gender", "女性" );
        set("age", 16);
        set("title", "宝物贩卖大使");
        set("long", "他专门贩卖宝物，看来有不少的好东西。\n");
        set("class", "yaomo");
        set("combat_exp", 5000);
        set("attitude", "peaceful");
        set_skill("unarmed", 20);
        set_skill("dodge", 20);
        set_skill("parry", 10);

        set("per", 11);
        set("max_kee", 150);

        set("vendor_goods", ([
         
       "yundan": "/d/9sky/guzhanchang/obj/yundan1",
       "cloth": "/d/12gong/obj/cloth",
       "armor": "/d/12gong/obj/armor",
       "pifeng": "/d/12gong/obj/pifeng",
       "shoes": "/d/12gong/obj/shoes",
       "dun": "/d/12gong/obj/shield",
       "tao": "/d/city/obj/mihoutao",
       "yao": "/d/city/obj/xieyao",
       "he": "/d/city/obj/he1",
       "wan":"/d/obj/drug/lengxiangwan",
       "chan":"/d/obj/drug/jiedu",
       "zhu": "/d/obj/baowu/leizhu",
       "deng":"/d/sanxian/obj/deng",  
       "hand":"/d/obj/weapon/hand/hand",      
      "houtao" : "/d/city/obj/bnmihoutao",
        "wuzhou":"/d/city/obj/wuzhou",
        "zhou":"/d/city/obj/zhou",
        "ping":"/u/snowtu/obj/force",
        "henew":"/d/city/obj/he2",
]) );

         set("inquiry", ([
            "card" : (:ask_card:),
            "货殖卡" : (:ask_card:),
            "自制武器修正" : (:check_weapon:),
            ]));

setup();
       
}
string ask_card()   //索要民生卡
{ 
object card; 
object ob = this_object(); 
object me = this_player(); 

if( me->query("balance") < 10000 )//要求：钱庄存款1gold
   return YEL"你还不够资格！"NOR; 

  if ( present("master card",me)||present("card",me) ) 
          return CYN"你自己“"HIC"inventory"NOR+CYN"“一下吧？我这可不是岔的！"NOR; 
      
       command("ok "+me->query("id") );
       card=new("/d/obj/fabao/card.lpc");
       card->move(me);
       message_vision("$N给$n一张"+card->name()+"。\n",ob,me);
                 
return WHT"可要妥善保管哟。"NOR; 
}

void init()
{
   add_action("do_vendor_list", "list");
}




