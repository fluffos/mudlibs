inherit NPC;
void create()
{
	set_name("疯子", ({"jin bubai", "bubai", "jin"}));
	set("title", HIG"魔界统领"NOR);
	set("gender", "男性" );
	set("age", 350);
	set("per", 104);
	set("str", 300);
	set("long", "他的身世是个迷，据说他是五百年前从五庄观逃出来后，投奔了魔界。\n");
	set("class", "xian");
        set("name_type","刺杀者");
	set("daoxing", 480000000);
	set("attitude", "peaceful");
	set("family/family_name","五庄观");
	set_skill("unarmed", 2400);
	set_skill("wuxing-quan", 2400);
	set_skill("dodge", 2400);
	set_skill("baguazhen", 2400);
	set_skill("parry", 2400);
	set_skill("hammer", 2400);
	set_skill("kaishan-chui", 2400);
	set_skill("force", 2040);   
	set_skill("zhenyuan-force", 2040);
	set_skill("literate", 1050);
	set_skill("spells", 2040);
	set_skill("zui-gun", 2400);
	map_skill("spells", "zui-gun");
	map_skill("force", "zhenyuan-force");
	map_skill("unarmed", "wuxing-quan");
	map_skill("dodge", "baguazhen");
	map_skill("hammer", "kaishan-chui");

	set("max_kee", 135000);
	set("max_sen", 135000);
	set("force", 50000);
	set("max_force", 25000);
	set("mana", 60000);
	set("max_mana", 30000);	
	set("force_factor", 1000);
	set("mana_factor", 1500);
      //  set("spell_qiankun_on", 1); //to use cast qiankun, must set this.
	set("chat_chance_combat", 600);
	set("chat_msg_combat", 
	({
		(: cast_spell, "zhenhuo" :),
	}) );

	
	setup();
	carry_object("/d/obj/weapon/stick/xiangmo")->wield();  
	  
	carry_object("/d/obj/drug/jinchuang");
        carry_object("/d/obj/drug/jinchuang");  
        carry_object("/d/obj/drug/jinchuang");
        carry_object("/d/obj/drug/jinchuang");
        carry_object("/d/obj/drug/jinchuang");
        carry_object("/d/obj/drug/jinchuang");
        carry_object("/d/obj/drug/jinchuang");
        carry_object("/d/obj/drug/jinchuang");
        carry_object("/d/obj/drug/jinchuang");
        carry_object("/d/obj/drug/jinchuang");
}

void init()
{
	object ob;

	if ( interactive(ob=this_player()) ) {
			remove_call_out("killing");
			call_out("killing", 0, ob);
		}
	remove_call_out("dest");
	call_out("dest",300);
}
int accept_kill()
{ 
  object me = this_player();
  object ob = this_object();
if (me->query_temp("killing_yao")&&(string)me->query_temp("killed_id")!=(string)ob->query("id")){
 write(WHT"注意：慢慢来，贪多嚼不烂的！:P\n\n"NOR);
return 0;
}
  ob->kill_ob(me);
  if (!ob->query("fighting",1)) copy_status(ob,me);
return 1;
}
void dest()
{
	object ob=this_object();
	if ( !living(ob) || ob->is_busy() || ob->is_fighting() )
	{
		remove_call_out("dest");
		call_out("dest",10);
		return;
	}
	shout(HIY"【大唐威望】金不败(Jin bubai)：“试问天下人谁敢跟我争风！哈哈！！！”\n"NOR);
	message_vision("$N口中念念有词，腾云驾舞而去。\n",this_object());
	destruct(ob);
}

