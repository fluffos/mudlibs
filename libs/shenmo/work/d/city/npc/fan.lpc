inherit NPC;

int ask_test();

void create()
{
    set_name("范青屏", ({"fan qingping", "fan"}));
    set("age", 72);
    set("gender", "男性");
    set("long",
        "范老拳师壮年时也是响当当的英雄，现在虽老了，手脚利落却不输当年．\n");
    set("title", "拳盖三省");
    set("attitude", "friendly");
    set("max_kee", 800);
    set("max_sen", 700);
    set("combat_exp", 100000);
    set("daoxing", 50000);

    set("shen_type", 1);
    set("max_force", 300);
    set("force", 300);
    set("force_factor", 15);
    set_skill("unarmed", 100);
    set_skill("changquan", 100);
    set_skill("dodge", 100);
    set_skill("parry", 100);
    map_skill("unarmed", "changquan");

    set("chat_chance",1);
    set("chat_msg", ({
        "范青屏叹道：腿脚不利落了，也没人去给我提笼小二的包子来。\n",
    }));

 	set("inquiry", ([
        "试招": (: ask_test :),
	]));

    setup();

    carry_object("/d/obj/cloth/choupao")->wear();
    carry_object("/d/obj/book/quanjing");
}

int random_place(object who, int value)
{
    object room;
    int i, j;
	object *inv ;

    for ( i = 0; i < 30; i++ )
    {
        room = call_other("/d/maze/combat/migong", "random_room");

        if ( !room )
        {
            continue;
        }

    	inv = all_inventory(room);
    	for ( j = 0; j < sizeof(inv); j++ )
    	{
    		if ( userp(inv[j]) )
    		{
    		    break;
    		}
    	}

    	if ( j >= sizeof(inv) )
    	{
    	    break;
    	}
    }

    if ( i >= 30 )
    {
        write("寻找空闲房间失败。\n");
        return 0;
    }

    if ( 100 == value )
    {
    }
    else if ( 0 == value )
    {
        who->set_temp("combat_time", time() + 3600 * 24);
    }
    else
    {
        //500 gold=15分钟，以后每100 gold多5分钟
        who->set_temp("combat_time", time() + 60 * 15 + ((value - 5000000) / 1000000) * 60 * 5);
    }

    who->move(room);
    return 1;
}

int accept_object(object who, object ob)
{
    if ( ob->query("id") == "zhurou bao" )
    {
        command("say 嘿嘿，老二这包子是越做越小了。\n");
        command("say 不过还是要谢谢你呀！\n");
        command("give jing to " + who->query("id"));
        return 1;
    }

    if ( ob->value() >= 5000000 )
    {
        command("say 嘿嘿，你倒是识相。\n");
        return random_place(who, ob->value());
    }

    return 0;
}

int ask_test()
{
    object who = this_player();
    object room;

    if ( wizardp(who) )
    {
        return random_place(who, 0);
    }

    if ( time() < who->query_temp("combat_time") )
    {
        command("say 搞什么搞，下不为例啊。\n");
        return random_place(who, 100);
    }

    command("say 最近经济不景气，我这武馆收入也越来越少了。\n");
    return 1;
}

