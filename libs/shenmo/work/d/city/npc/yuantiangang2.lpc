inherit NPC;

int work_me2();

void create()
{
        set_name("袁天罡", ({"yuan tiangang", "yuan"}));
        set("gender", "男性" );
        set("age", 33);
        set("long","袁天罡是天监台总管，听说他法术高深。
他为人正直仗义，脸上总是一股忧国忧民的神情。\n");
        set("int", 30);
        set("per", 25);
        set("combat_exp", 50000);
        set("daoxing", 800000);
        
        // discourage NK yuan.
        set("eff_dx",1000);
        set("nkgain",1);
        set("env/wimpy",100);

        set("attitude", "friendly");
        set("title", "天监台正先生");
        set_skill("unarmed", 60);
        set_skill("dodge", 50);
        set_skill("parry", 50);
        set_skill("spells", 100);
        set_skill("baguazhou", 100);
        set_skill("literate", 50);
        set_skill("sword", 60);  
        set_skill("changquan", 50);  

        map_skill("spells", "baguazhou");
        map_skill("unarmed", "changquan");

        set("per", 30);
        set("max_kee", 400);
        set("max_gin", 400);
        set("max_sen", 400);
        set("force", 450);
        set("max_force", 300);
        set("force_factor", 10);
        set("mana", 6000);
        set("max_mana", 3000);
        set("mana_factor", 100);

        set("chat_chance",5);
        set("chat_msg", ({
                    name()+"叹道：生逢乱世，妖魔横行啊！\n",
                    name()+"问道：可有谁愿去为大唐灭妖吗？\n",
                    }));

        seteuid(getuid());

        set("inquiry", ([
                "送信": (: work_me2 :),
        ]));
        setup();
        add_money("silver", 5);
        carry_object("/d/obj/cloth/baguapao")->wear();
        carry_object("/d/obj/weapon/sword/taomujian")->wield();
}

int accept_fight(object me)
{
        write("袁天罡凛然道：学武乃是为了强身，不是打打杀杀！\n");
        return 0;
}

int recognize_apprentice(object me)
{
        if((int)me->query("yuan-learn"))
        return 1;
        return notify_fail("袁天罡说道：您太客气了，这怎么敢当？\n");
}

int accept_object(object who,object ob)
{
        if (ob->query("id")=="fan he"){
                if (((string)who->query("family/family_name")=="将军府")){
                        who->set("yuan-learn", 1);
                        write("袁天罡笑道：将军看起来一表人才，以后定是人前出头之辈！
袁天罡略为沉思，又道：若将军有何问题，可随时和我商讨，天罡若是知晓，定会答复．\n");
                        call_out("destroy", 1, ob);
                        return 1;
                }
                if (((string)who->query("family/family_name")!="将军府")){
                        command("say 多谢多谢，我正饿着哪！");
                        command("give 1 silver to " + who->query("id"));                        
                        call_out("destroy", 1, ob);
                        return 1;
                }
        }
        else return 0;
}

void destroy(object ob)
{
        destruct(ob);
        return;
}

string ran_msg()
{
        int i;
        string arg,*str = ({
                "若有睡梦见莲华","及以梦见于繖盖",
                "或复梦里见月轮","应当获得大利益",
                "若有梦见佛形像","诸相具足庄严身",
                "众生见者应欢喜","念当必作调御人",
                "若此佛刹诸众生","令住信心及持戒",
                "若此佛刹诸众生","令住信心于法行",
                "若诸佛刹恒河沙","皆悉造寺求福故",
                "若有佛刹如恒沙","皆悉遍施诸七宝",
                "如铁围山高广大","造塔无量为诸佛",
                "若诸众生具满劫","若头若髆常担戴",
                "如是人等得胜法","若求菩提利众生",
                "彼等众生最胜者","此无比类况有上",
                "是故得闻此诸法","智者常生乐法心",
                "当得无边大福聚","速得证于无上道",
        });
        arg = str[random(sizeof(str))];
        return arg;
}
        

int work_me2()
{
        string str;
        object xin,npc,me = this_player();
        
        if( me->query("combat_exp")<10000 )
        {
                tell_object(me,query("name")+"对你摇了摇头：你办事，我不放心。\n");
                return 1;
        }
        if( me->query("combat_exp")>1000000 )
        {
                tell_object(me,query("name")+"对你摇了摇头：怎敢劳您大驾。\n");
                return 1;
        }
        if( time()<me->query("giftmark/letter_cancel")+300 )
        {
                tell_object(me,query("name")+"说道：你刚刚放弃过任务，还是等等再来。\n");
                return 1;
        }
        if( me->query("giftmark/letter") )
        {
                if( me->query_temp("letter_cancel") )
                {
                        tell_object(me,"你向"+query("name")+"哀求放弃上次的送信任务。\n");
                        tell_object(me,query("name")+"摇了摇头：既然你这么耸，那这次就算了吧。\n");
                        me->delete("giftmark/letter");
                        me->delete_temp("letter_cancel");
                        me->set("giftmark/letter_cancel",time());
                }
                else
                {
                        tell_object(me,query("name")+"疑惑的看了看你：你不是要过了任务吗？\n");
                        tell_object(me,query("name")+"对你说：如果你确实觉得此事心有余而力不足，那再问老夫一次，老夫自当取消你的任务。\n");
                        me->set_temp("letter_cancel",1);
                }
                return 1;               
        }
        xin = present("baixian book",me);
        if( xin && xin->is_letter() )
        {
                tell_object(me,query("name")+"说道：你必须将你身上的"+xin->query("name")+"先丢弃了。\n");
                return 1;
        }

        str = ran_msg();
        if( !str )
        {
                tell_object(me,query("name")+"说道：还是稍候再来。\n");
                return 1;
        }
        
        npc = new("/d/npc/xianshi");
        if( !npc )
        {
                tell_object(me,query("name")+"说道：还是稍候再来。\n");
                return 1;
        }
        if( !npc->random_place() )
        {
                destruct(npc);
                tell_object(me,query("name")+"说道：还是稍候再来。\n");
                return 1;
        }
        npc->set("owner",me);
                                
        xin = new("/d/npc/obj/xin.lpc");
        if( !xin )
        {
                tell_object(me,query("name")+"说道：还是等等再来。\n");
                if( npc ) destruct(npc);
                return 1;
        }
        
        xin->set("owner",me);
        xin->set("ask",str);
        xin->set("target",npc);
        
        if( xin->move(me) )
        {
                tell_object(me,query("name")+"递给你一封"+xin->query("name")+"。\n");
                tell_object(me,query("name")+"说道：带着这封"+xin->query("name")+"前去寻访"+MISC_D->find_place(environment(npc))+"的"+npc->query("name")+"("+capitalize(npc->query("id"))+")，向之打听「"+str+"」一事。\n");
                me->set("giftmark/letter",1);
                return 1;
        }
        else
        {
                tell_object(me,query("name")+"说道：你的行囊已满，看来是无法替我完成此任务。\n");
                if( npc ) destruct(npc);
                if( xin ) destruct(xin);
                return 1;
        }
}
