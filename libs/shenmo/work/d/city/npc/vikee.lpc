varargs int receive_damage(string type, int damage, object who) {
  add("数据/" + type + "/damage", damage);
  add("数据/" + type + "/time1", 1);
  return 0;
}

varargs int receive_wound(string type, int damage, object who) {
  add("数据/" + type + "/eff_damage", damage);
  add("数据/" + type + "/time2", 1);
  return 0;
}

void unconcious() {
  ::unconcious();
  this_object()->revive();
  this_object()->powerup();
}

void die() {
  unconcious();
}

void heart_beat() {
  mapping temp;
  string *str;
  int d, t, i;
  ::heart_beat();
  if (this_object()->is_busy()) {
    add_temp("aaa", 1);
    if (query_temp("aaa") % 10 == 0)
      command("chat 啊啊啊,我给眠兔busy住了.\n");
  }
  if (this_object()->is_fighting())
    return;
  if (mapp(temp = query("数据"))) {
    str = keys(temp);
    i = sizeof(str);
    while (i--) {
      if (!str[i] || !stringp(str[i]))
        continue;
      d = temp[str[i]]["damage"];
      t = temp[str[i]]["time1"];
      if (d / t)
        say(sprintf("\n共被攻击 %d 次，表面伤害 %d 平均每次 %d 伤害。\n",
          t, d, d / t));
      d = temp[str[i]]["eff_damage"];
      t = temp[str[i]]["time2"];
      if (d / t)
        say(sprintf("共被攻击 %d 次，内伤伤害 %d 平均每次 %d 伤害。\n",
          t, d, d / t));
    }
  }
  this_object()->delete("数据");
}
