//观看台watch1.c--7.c

#include <ansi.h>
inherit ROOM;
void create()
{
   set ("short",HIW"观礼台"NOR);
   set ("long",
@LONG
    
观礼台由平坦宽适的红木一级级搭成，地下铺着花纹虎皮和金钱豹
皮。台上放着一排排猩红绒面太师椅，可以让贵宾们比较舒适地观
看比赛。

LONG);
set("no_flee",1);
set("no_get",1);
set("no_drop",1);
set("no_fight",1);
set("no_magic",1);
set("exits",([
     "south":"/d/city/wuguan",
   ]));
set("water",1);
setup();
}

int init()
{
add_action("do_go","ru");
}

int do_go(string arg)
{
string myop,tempstr;
int j;
object ob,me; 
me=this_player();
if ( !wizardp(me) )
	return notify_fail("还是等巫师来选人吧！\n");

if (!arg) 
	return notify_fail("你选谁进入场地？\n");    

ob = LOGIN_D->find_body(arg);
if (!ob) 
	return notify_fail("咦．．． 有这个人吗？\n");

if (me->query("id")==arg) 
	return notify_fail("你?没必要吧。\n");

if ( !present(ob,environment(me)) ) 
	return notify_fail("这儿没这个人哦。\n");

if ( ob->is_busy() ) 
	return notify_fail("对方正忙着呢！\n"); 

if ( ob->query_temp("fight/fail")>2 )
	return notify_fail("他已经丧失了比赛资格了。\n");

if ( sizeof(all_inventory(load_object(__DIR__"ground1"))) >0 ) 
	{
	j=sizeof(all_inventory(load_object(__DIR__"ground1")));
	while (j>0)
		{
		j=j-1;
		if ( userp( all_inventory(load_object(__DIR__"ground1"))[j] ) )
		         return notify_fail("已经有人在比赛了。\n");
		}
	}  
if ( sizeof(all_inventory(load_object(__DIR__"ground2"))) >0 ) 
	{
	j=sizeof(all_inventory(load_object(__DIR__"ground2")));
	while (j>0)
		{
		j=j-1;
		if ( userp( all_inventory(load_object(__DIR__"ground2"))[j] ) )
		         return notify_fail("已经有人在比赛了。\n");
		}
	}  
if ( sizeof(all_inventory(load_object(__DIR__"ground3"))) >0 ) 
	{
	j=sizeof(all_inventory(load_object(__DIR__"ground3")));
	while (j>0)
		{
		j=j-1;
		if ( userp( all_inventory(load_object(__DIR__"ground3"))[j] ) )
		         return notify_fail("已经有人在比赛了。\n");
		}
	}  

message_vision("$N让$n进入赛场。\n",me,ob); 
ob->move(__DIR__"under1");  //进入徒手擂台
ob->set_temp("statusbef/kee",(int)ob->query("kee"));
ob->set_temp("statusbef/sen",(int)ob->query("sen"));
ob->set_temp("statusbef/eff_kee",(int)ob->query("eff_kee"));
ob->set_temp("statusbef/eff_sen",(int)ob->query("eff_sen"));
ob->set_temp("statusbef/force",(int)ob->query("force"));
ob->set_temp("statusbef/mana",(int)ob->query("mana"));
return 1;
}

