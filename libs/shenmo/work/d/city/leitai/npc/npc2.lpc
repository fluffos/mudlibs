//girl.c  
// 1.ask 2 kill 3 find ou 4.give 
#include <ansi.h>  
               
inherit NPC;  
string ask_for_key();  

void create()  
{  
set_name("入场员", ({"man"}));  
set("long", HIC+@LONG

      刀    剑    无    眼

LONG+HIC);  
set("gender", "女性");  
set("age", 56);  
set("attitude", "friendly");  
set("shen_type", 1);  
set("per", 40);  
set("int", 40);  
set("str", 40);  
set("cps", 40);  
set("spi", 40);  
set("max_kee", 3000);  
set("max_gin", 3000);  
set("max_sen", 3000);  
set("max_force", 3000);  
set("force_factor", 200);  
set("max_mana", 5000);  
set("mana", 10000);  
set("mana_factor", 150);  
set("combat_exp", 5000000);  
set("inquiry", ([  
             "cloth" : (: ask_for_key :),  
]) );  
setup();  
}  
       
void init()
{
::init();
add_action("do_yao","yao");
add_action("do_list","list");

}

int do_list(string arg)
{
	object who = this_player();
	object me = this_object();
  message("vision",""HIG"\n─────────────────────────────────────
          \n"HIY"兵器："HIC" 
          1.降魔棒(stick)   2. 青虹剑(sword)  3.软龙筋(whip)
          4.金刀(blade)     5. 短铁爪(zhua)   6.黄铜禅杖(staff)
          7.宣花斧(axe)     8. 月牙铲(fork)   9.梅花锤(hammer)
          10.点金枪(spear)  11.凤凰琴(qin)    12.虎尾鞭(mace)
          13.银针 (zhen)
"HIG"\n─────────────────────────────────────\n"NOR"",who,me);

  return 1;
}

int do_yao(string arg)
{
string type;
object ob;
object who=this_player();
object me=this_object();
if (who->query_temp("wea_give"))
	return notify_fail("要过了就算了吧! :P\n");
if (!arg)
	return notify_fail("你想要什么？兵器？(比如:yao sword)\n");
else 
	{
	sscanf(arg,"%s",type);
	switch(type)
		{
		//兵器
		case "sword":
		ob=new("/d/city/npc/obj/sword.lpc");
		ob->set("no_sell", 1);
		ob->set("no_drop", 1);
        	ob->set("no_give", 1);
		ob->move(who);
		who->set_temp("wea_give");
              tell_object(who,ob->query("name")+"已经在你身上了！\n");
		break;
			
		case "whip":
		ob=new("/d/city/npc/obj/whip.lpc");
		ob->set("no_sell", 1);
		ob->set("no_drop", 1);
		ob->set("no_give", 1);
		ob->move(who);
		who->set_temp("wea_give");
              tell_object(who,ob->query("name")+"已经在你身上了！\n");
		break;

		case "blade":
		ob=new("/d/city/npc/obj/blade.lpc");
		ob->set("no_sell", 1);
		ob->set("no_drop", 1);
		ob->set("no_give", 1);
		ob->move(who);
		who->set_temp("wea_give");
              tell_object(who,ob->query("name")+"已经在你身上了！\n");
		break;

		case "stick":
		ob=new("/d/city/npc/obj/stick.lpc");
		ob->set("no_sell", 1);
		ob->set("no_drop", 1);
		ob->set("no_give", 1);
		ob->move(who);
		who->set_temp("wea_give");
              tell_object(who,ob->query("name")+"已经在你身上了！\n");
		break;

		case "spear":
		ob=new("/d/city/npc/obj/spear.lpc");
		ob->set("no_sell", 1);
		ob->set("no_drop", 1);
        	ob->set("no_give", 1);
		ob->move(who);
		who->set_temp("wea_give");
              tell_object(who,ob->query("name")+"已经在你身上了！\n");
		break;
			
		case "fork":
		ob=new("/d/city/npc/obj/fork.lpc");
		ob->set("no_sell", 1);
		ob->set("no_drop", 1);
        	ob->set("no_give", 1);
		ob->move(who);
		who->set_temp("wea_give");
              tell_object(who,ob->query("name")+"已经在你身上了！\n");
		break;

		case "hammer":
		ob=new("/d/city/npc/obj/hammer.lpc");
		ob->set("no_sell", 1);
		ob->set("no_drop", 1);
		ob->set("no_give", 1);
		ob->move(who);
		who->set_temp("wea_give");
              tell_object(who,ob->query("name")+"已经在你身上了！\n");
		break;

		case "qin":
		ob=new("/d/city/npc/obj/qin.lpc");
		ob->set("no_sell", 1);
		ob->set("no_drop", 1);
		ob->set("no_give", 1);
		ob->move(who);
		who->set_temp("wea_give");
              tell_object(who,ob->query("name")+"已经在你身上了！\n");
		break;

		case "axe":
		ob=new("/d/city/npc/obj/axe.lpc");
		ob->set("no_sell", 1);
	       ob->set("no_drop", 1);
       	ob->set("no_give", 1);
		ob->move(who);
		who->set_temp("wea_give");
              tell_object(who,ob->query("name")+"已经在你身上了！\n");
		break;

		case "staff":
		ob=new("/d/city/npc/obj/staff.lpc");
		ob->set("no_sell", 1);
	       ob->set("no_drop", 1);
       	ob->set("no_give", 1);
		ob->move(who);
		who->set_temp("wea_give");
              tell_object(who,ob->query("name")+"已经在你身上了！\n");
		break;

		case "zhua":
		ob=new("/d/city/npc/obj/zhua.lpc");
		ob->set("no_sell", 1);
		ob->set("no_drop", 1);
        	ob->set("no_give", 1);
		ob->move(who);
		who->set_temp("wea_give");
              tell_object(who,ob->query("name")+"已经在你身上了！\n");
		break;

		case "mace":
		ob=new("/d/obj/weapon/mace/malemace.lpc");
