//girl.c  
// 1.ask 2 kill 3 find ou 4.give 
#include <ansi.h>

inherit NPC;
string ask_for_key();

void create() {
  set_name("入场员", ({ "man" }));
  set("long", HIC + @LONG

      刀    剑    无    眼

LONG + HIC);
  set("gender", "女性");
  set("age", 56);
  set("attitude", "friendly");
  set("shen_type", 1);
  set("per", 40);
  set("int", 40);
  set("str", 40);
  set("cps", 40);
  set("spi", 40);
  set("max_kee", 3000);
  set("max_gin", 3000);
  set("max_sen", 3000);
  set("max_force", 3000);
  set("force_factor", 200);
  set("max_mana", 5000);
  set("mana", 10000);
  set("mana_factor", 150);
  set("combat_exp", 5000000);
  set("inquiry", ([
    "cloth": (: ask_for_key :),
  ]));
  setup();
}

string ask_for_key() {
  object ob;
  object who = this_player();
  if (!who->query_temp("give_cloth")) {
    ob = new("/d/city/npc/obj/armor.lpc");
    ob->set("no_sell", 1);
    ob->set("no_drop", 1);
    ob->set("no_give", 1);
    ob->move(who);
    who->set_temp("give_cloth");

    ob = new("/d/city/npc/obj/pifeng.lpc");
    ob->set("no_sell", 1);
    ob->set("no_drop", 1);
    ob->set("no_give", 1);
    ob->move(who);
    who->set_temp("give_cloth");

    ob = new("/d/city/npc/obj/cloth.lpc");
    ob->set("no_sell", 1);
    ob->set("no_drop", 1);
    ob->set("no_give", 1);
    ob->move(who);
    who->set_temp("give_cloth");

    ob = new("/d/city/npc/obj/kui.lpc");
    ob->set("no_sell", 1);
    ob->set("no_drop", 1);
    ob->set("no_give", 1);
    ob->move(who);
    ob = new("/d/city/npc/obj/shoes.lpc");
    ob->set("no_sell", 1);
    ob->set("no_drop", 1);
    ob->set("no_give", 1);
    ob->move(who);
    who->set_temp("give_cloth");

    ob = new("/d/city/npc/obj/shield.lpc");
    ob->set("no_sell", 1);
    ob->set("no_drop", 1);
    ob->set("no_give", 1);
    ob->move(who);
    who->set_temp("give_cloth");
    message_vision(HIW "$N领取了护具。\n" NOR, who);
  }
}
