//徒手擂台 ground1.c
//相关连接: 徒手擂台下 under1.c
//	       观礼台 watch1.c---watch7.c	
//                 武器擂台下 under2.c

#include <ansi.h>
inherit ROOM;
#include "/d/kaifeng/ground.h"


void create() {
  set("short", HIG "[" HIR "徒手擂台" HIG "]" NOR);
  set("long", @LONG
  
           搏  击  格  斗       各  显  神  通

LONG);
  set("no_quit", 1);
  set("broadcast", 1);
  set("busy", 5);
  set("alternative_die", 1);
  setup();
}

void alternative_die(object me) {
  object ob = me->query_temp("last_damage_from");
  if (me->query("kee") < 0) me->set("kee", 10);
  if (me->query("eff_kee") < 0) me->set("eff_kee", 10);
  me->remove_killer(ob);
  ob->remove_killer(me);
  message_vision(HIG "$n把$N打翻在地，飞起一脚，将$N踢下了擂台。\n" NOR, me, ob);
  message_vision(HIG "$n在观众的欢呼声中，高高兴兴地下场休息了。\n" NOR, me, ob);
  message(
    "chat",
    HIM + "【" + HIR "徒手擂台" + HIM "】" + HIW + ob->query("name") + HIC "徒手打败" NOR + HIW + me->query("name") + HIC "夺得了本次比赛的胜利。\n" NOR,
    users()
  );
  tell_room(__DIR__ "watch1", "\n>\n");  //age 14-15
  tell_room(__DIR__ "watch2", "\n>\n");  //wx 100w d
  tell_room(__DIR__ "watch3", "\n>\n");  //wx 100-300w
  tell_room(__DIR__ "watch4", "\n>\n");  //wx 300-500w
  tell_room(__DIR__ "watch5", "\n>\n");  //500-800w
  tell_room(__DIR__ "watch6", "\n>\n");  //800-1000w
  tell_room(__DIR__ "watch7", "\n>\n");  //1000上

  me->add_temp("fight/fail", 1);  //>3即不能再参加
  ob->move(__DIR__ "under2");  //移动到下一擂台台下
  me->move(__DIR__ "under2");

  /*
if ( me->query("age")<16 )
	{
	ob->move(__DIR__"watch1");
	me->move(__DIR__"watch1");
	}     //16岁以下
else if ( me->query("combat_exp")<1000000 )
	{
	me->move(__DIR__"watch2");
	ob->move(__DIR__"watch2");
	}
else if ( me->query("combat_exp")<3000000 && me->query("combat_exp")>1000000 )
	{
	me->move(__DIR__"watch3");
	ob->move(__DIR__"watch3");
  	}
else if ( me->query("combat_exp")<5000000 && me->query("combat_exp")>3000000 )
	{
	me->move(__DIR__"watch4");
	ob->move(__DIR__"watch4");
  	}
else if ( me->query("combat_exp")<8000000 && me->query("combat_exp")>5000000 )
	{
	me->move(__DIR__"watch5");
	ob->move(__DIR__"watch5");
  	}
else if ( me->query("combat_exp")<10000000 && me->query("combat_exp")>8000000 )
	{
	me->move(__DIR__"watch6");
	ob->move(__DIR__"watch6");
  	}
else 	{
	me->move(__DIR__"watch7");
	ob->move(__DIR__"watch7");
  	}
*/
  me->set("kee", (int)me->query_temp("statusbef/kee"));
  me->set("eff_kee", (int)me->query_temp("statusbef/eff_kee"));
  me->set("sen", (int)me->query_temp("statusbef/sen"));
  me->set("eff_sen", (int)me->query_temp("statusbef/eff_sen"));
  me->set("force", (int)me->query_temp("statusbef/force"));
  me->set("mana", (int)me->query_temp("statusbef/mana"));
  ob->set("kee", (int)ob->query_temp("statusbef/kee"));
  ob->set("eff_kee", (int)ob->query_temp("statusbef/eff_kee"));
  ob->set("eff_sen", (int)ob->query_temp("statusbef/eff_sen"));
  ob->set("sen", (int)ob->query_temp("statusbef/sen"));
  ob->set("force", (int)ob->query_temp("statusbef/force"));
  ob->set("mana", (int)ob->query_temp("statusbef/mana"));
}

void broadcast(string str) {
  string prefix = HIY "〖徒手擂台〗" NOR;
  string s1 = str, s2 = "";
  while (strsrch(s1, "\n\n") != -1)
    s1 = replace_string(s1, "\n\n", "\n");

  if (s1[strlen(s1) - 1] == '\n') {
    s1 = s1[0..strlen(s1) - 2];
    s2 = "\n";
  }
  if (strlen(s1) == 0)
    return;
  s1 = replace_string(s1, "\n", "\n" + prefix) + "";
  reset_eval_cost();
  tell_room(__DIR__ "watch1", "\n" + prefix + s1);
  tell_room(__DIR__ "watch2", "\n" + prefix + s1);
  tell_room(__DIR__ "watch3", "\n" + prefix + s1);
  tell_room(__DIR__ "watch4", "\n" + prefix + s1);
  tell_room(__DIR__ "watch5", "\n" + prefix + s1);
  tell_room(__DIR__ "watch6", "\n" + prefix + s1);
  tell_room(__DIR__ "watch7", "\n" + prefix + s1);
}
