
inherit ITEM;
#include <ansi.h>
int do_fu(string arg);
void create()
{
   set_name(HIR"春节丹"NOR, ({ "chunjie"}));
   set_weight(100);
   set("unit", "颗");
   set("long","这是一颗春节丹,吃了他(eat head)效果等同莲花2倍效果，时效1小时.\n");
   set("value", 50000);
   
}

void init()
{
	add_action("do_fu","eat");
}
int do_fu(string arg)
{
	object me,ob;int i;
	ob=this_object();me=this_player();
	if(!arg||(arg!="chunjie"&&arg!="春节丹"))
		return notify_fail("你要吃什么?\n");
	me->add("bellicosity",100);
	message_vision("$N抓起一颗[春节丹]狂啃起来，头顶佛光乍现。\n",me);
	destruct(ob);
	return 1;
}