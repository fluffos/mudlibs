#include <ansi.h>
inherit ITEM;

void create() {
  set_name("新手锦囊", ({ "xinshou jinnang", "jinnang", "nang" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  set("long", "这是一个为方便新手杀怪用的锦囊，你可以拆(chai)开来看看。\n");
  set("unit", "包");
  set("value", 10000);
  setup();
}

void init() {
  if (this_player() == environment())
    add_action("do_chai", "chai");
}

int do_chai(string arg) {
  int i;
  string *file;
  object ob, me = this_player();

  if (!arg || !id(arg))
    return 0;
  i = me->query("combat_exp") / 2;
  i += me->query("daoxing") / 2;
  if (i > 50000000 && !wizardp(me)) {
    tell_object(me, "你已经不算是新手了，用这个没用。\n");
    return 1;
  }
  message_vision(HIG "$N" HIG "将$n" HIG "小心翼翼的拆开。\n" NOR, me, this_object());
  file = ({
    "/d/obj/misc/xueshan-map",
    "/d/penglai/npc/obj/ditu",
    "/d/obj/magic/bishuizhou",
    "/d/qujing/pansi/obj/money",
  });
  for (i = 0; i < sizeof(file); i++) {
    ob = new(file[i]);
    if (ob->move(me))
      tell_object(me, "你从里面取出一" + ob->query("unit") + ob->name() + "。\n");
  }
  if (me->query_temp("obstacle/jinping_give_hulu"))
    tell_object(me, "你已交给过青龙山守门牛精一个油葫芦。\n");
  else {
    me->set_temp("obstacle/jinping_give_hulu", 1);
    tell_object(me, "你自动交给青龙山守门牛精一个油葫芦。\n");
  }
  destruct(this_object());
  return 1;
}
