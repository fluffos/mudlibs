#include <ansi.h>

inherit ITEM;

int do_eat(string);
void create() {
  set_name(HIW "无望咒" NOR, ({ "wuwang zhou", "zhou" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "片");
    set("long", "轻飘飘的一张小纸片。\n");
    set("value", 30000000);
    set("no_give", "这么珍贵的药，哪能随便给人？\n");
    set("no_drop", "这么宝贵的丹药，扔了多可惜呀！\n");
    set("no_sell", "凡人哪里知道" + this_object()->query("name") + "的价值？还是自己留着吧。\n");
    set("no_get", "你手里一松" + this_object()->query("name") + "丹从指间滑落！\n");
  }

  setup();
}

void init() {
  add_action("do_eat", "eat");
}

int err_msg(string arg) {
  write(arg);
  return 1;
}
int do_eat(string arg) {
  object me = this_player();

  if (!arg || !id(arg)) return 0;

  if (!mapp(me->query_temp("no_move"))) return err_msg("你没给定住，吃这个干什么？！\n");
  if (me->is_fighting()) return err_msg("战斗中吃这个，找死呀！\n");
  tell_object(me, HIW "你含下一片无望咒，定身给取消了。\n" NOR);

  me->delete_temp("no_move");
  destruct(this_object());
  return 1;
}
