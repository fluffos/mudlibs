#include <ansi.h>
inherit MONEY; 

void create()
{
set_name(WHT"筹码"NOR, ({ "chou ma","chip" }) );
if( clonep() )
	set_default_object(__FILE__);
else	{
        set("unit", "些");
        set("money_id", "chip"); 
        set("base_unit", "个");
        set("base_weight", 10);
	set("long", "长安赌场专用筹码。\n");
//        set("value", 0);
	set("no_give",1);
	}
set_amount(1); 
}

void check_owner()
{
object ob = this_object();
object me = environment(ob);
if ( ob->query("owner")!=me )
	call_out("goaway",1,me,ob);
return;
}

void init() 
{ 
check_owner(); 
} 

void goaway(object me,object ob)
{
message_vision("一阵喧哗，从外冲出一帮人等，原来是赌场打手，夺过$N身上的"+ob->name()+"：不是你的，居然想带走？！\n",me);
destruct(ob);
return;
}
