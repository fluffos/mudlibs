#include <ansi.h>
#include <dbase.h>
#include <armor.h>
inherit F_AUTOLOAD;  
inherit ITEM;

void create()
{
set_name(HIG"月"HIY"光"HIW"宝"HIM"盒"NOR, ({"yueguang baohe","he", "ling" }) );
set_weight(100);
set("long","这就是传说中的山洞老人留下的月光宝盒，据说有瞬间移动(move)的作用。\n");
set("value", 100000);
set("material", "steel");
set("no_sell", "这么难得的宝物还是留着吧。\n");
set("no_drop", "这么难得的宝物还是留着吧。\n");
set("no_get","开玩笑,这种难得的宝物是你一个常人能拿得了的?\n");
set("unit", "只");
set("no_steal",1);
}

void dest_ob()
{
     if( environment() )  {
      tell_room(environment(),"\n天上忽然传来一声断喝：还我月光宝盒来！\n只见月光宝盒凌空而去，霎时间不见了踪影。\n\n");
     }
        destruct(this_object());
}

void init()
{
        if( environment() && !environment()->is_character() )
        {
                remove_call_out("dest_ob");
                call_out("dest_ob",1);
                return;
        }
        add_action("do_move", "move");
}


int do_move()
{
object ridee,me=this_player(); 

if( !present(this_object(),me) )
        return 0;

if ((time()-me->query("last_move"))<100) 
        return notify_fail("月光宝盒的法力已经用完,过一阵才能发挥作用。 \n"); 

if ( !wizardp(me) && environment(me)->query("hs_world") )
        return notify_fail("在魔幻世界，你的灵力还难以驾御风云。\n");

if ( me->is_fighting() )
        return notify_fail("打架中你还有哪只手有空去拿月光宝盒呢？\n");
if ( me->is_busy() && (int)me->query("spsk")!=12 )
        return notify_fail("你现在正忙着呢！\n");

ridee = me->ride();
if ( ridee )
        {
        if ( ridee->is_busy() )
                return notify_fail("你的坐骑现在动弹不得。\n");
        }

if ( ridee )
        {
        if ( !ridee->move("/d/changan/nbridge") )       
                return notify_fail("你的坐骑现在动弹不得。\n");
        }
                
//tell_room(environment(me),HIY+me->query("name")+HIY"双眼微闭，嘴中念起时空穿梭咒："
//                        "「波若波罗密乾坤大法，走！」\n"
//                        "一时狂沙漫天..... "
//                        "等你张开眼时,"+me->query("name")+"的身影已经消失在漫天风沙之中.\n"NOR,me);
 
tell_object(me,HIY"你双眼微闭，嘴中念起时空穿梭咒："
                        "「波若波罗密乾坤大法，走！」\n"
                        "你的身影已经消失在漫天风沙之中.\n"NOR);
if ( me->move("/d/changan/nbridge") )
        message_vision(HIY"$N的身影突然出现在一阵狂风之中。\n"NOR, me);
else    message_vision(HIY"$N的身影突然从狂风之中摔了下来。\n"NOR, me);
return 1;
}

int query_autoload() { return 1; } 

