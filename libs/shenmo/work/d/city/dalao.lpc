#include <ansi.h>
inherit ROOM;

void work_end(object me);
int do_work();

int ttt=0;
int i=0;

void create()
{
set ("short", "京城监牢");
set ("long", @LONG

这里是关押犯人的地方，鱼龙混杂，污秽不堪。四下里是冰冷的墙壁。
进来了就难以逃脱。你想早点出去就安心在此做苦力(work)吧。
LONG);

set("objects",([
        __DIR__"npc/laoyi" : 1,
]));

set("no_clean_up",1);
set("alternative_die",1);
setup();
}

void init ()
{
object me=this_player();
if(!wizardp(me))
        {
        add_action("block_cmd","",1);      
        me->set("startroom","/d/city/dalao.lpc");
        me->save();
        }
add_action("do_out","out");
add_action("do_tell","tell");
add_action("do_work","work");
if ( me->query("赌场/钱") )
        {
        i = me->query_int();
        i+= me->query_per();    
        i+= me->query_kar();
        i+= me->query("赌场/钱")/100;
        i = i/2+random(i)+10000;
        if ( me->query("赌场/钱")>30000000 )  i*= 3;
        else  i*= 10;
      if ( wizardp(me) )   tell_object(me,MONEY_D->money_str(i)+"\n");
        }
}

int block_cmd()
{
string verb = query_verb();
if (verb=="say") return 0; //allow say
if (verb=="inventory") return 0; 
if (verb=="tiqu") return 0; 
if (verb=="help") return 0;
if (verb=="out") return 0;
if (verb=="look") return 0;
if (verb=="ask") return 0;
if (verb=="give") return 0;
if (verb=="exercise") return 0;
if (verb=="dazuo") return 0;
if (verb=="exert heal") return 0;
if (verb=="exert") return 0;
if (verb=="tell") return 0;
if (verb=="work") return 0;
return 1;
}

int do_work()
{
string msg;
object me = this_player();
if ( me->query("kee")<100 || me->query("sen")<100 || me->is_busy() )
        return notify_fail("你太累了。\n");
msg = "$N弯下腰开始";
switch(random(7))
        {
        case 1 : 
                msg+= "打扫屋顶。\n";
                break;
        case 2 :
                msg+= "洗衣服。\n";
                break;
        case 3 :
                msg+= "洗尿片。\n";
                break;
        case 4 :
                msg+= "帮囚犯们理发。\n";
                break;
        case 5 :
                msg+= "帮囚犯们抓虱子。\n";
                break;
        default :
                msg+= "打扫厕所。\n";
        }
msg+= "牢役过来检查...";
message_vision(msg,me);
me->start_busy(5);
me->add("kee",-200);
me->add("sen",-200);
me->start_call_out( (: call_other, __FILE__, "work_end", me:),2+random(3));
return 1;
}

void work_end(object me)
{
string msg,name;
object npc = present("lao yi",this_object());
name = npc->query("name");
if( !me || !living(me) )  return;
msg=name+"低头看看......\n";

if ( random(10)==1 )
        {
        msg+=name+"摇摇头：不行，搞的不够，重来！\n";
        message_vision(msg,me);
        me->command("shit");
        return;
        }
msg+=name+"拍拍$N的肩膀：恩，搞得不错，以后还要多多搞！\n";
message_vision(msg,me);
me->command("mapi");
me->add("赌场/钱",-i);
me->save();
if ( me->query("赌场/钱")<=1000000 )
        {
        tell_object(me,"“哐镗”一声，一个衙役对你大声道：好了，监期已满，快些滚蛋吧(out)！");
        me->delete("赌场");
        me->save();
        return;
        }
me->update_age();
return;
}

int do_out()
{
object me=this_player();
if ( !me )
        return 1;
if ( !me->query("赌场/钱") )
      { 
        message_vision("$N刑满释放！$N被转移到客栈。\n"NOR,me);
        me->delete("赌场");
        me->move("/d/city/kezhan");
        me->set("startroom","/d/city/kezhan");
        me->save();
        }
else message_vision("$N试图离开这里，可惜刑期没满，$N对天大呼：冤枉啊。\n"NOR,me);
return 1;
}

int do_tell(string arg)
{
string dir,str,msg;
object ob;
object me = this_player();


if( !arg || sscanf(arg, "%s %s", dir,msg)!=2 )
        return notify_fail("你想谈什么?\n");
ob = find_player(dir);
if( !ob || !me->visible(ob) )  return notify_fail("没有这个人。\n");
ttt++;
if ( ttt%10==0 )
message("channel:chat",HIM"【谣言四起】某人：监牢里的"+me->query("name")+HIM"正在与"+ob->name()+HIM"进行密谋。\n"NOR,users());
return 0;
}

void alternative_die (object me)
{
if ( !userp(me) )
        return;

me->set("kee",10);
me->set("eff_kee",me->query("max_kee"));
me->set("sen",10);
me->set("eff_sen",me->query("max_sen"));
me->set("force",100);
me->set("mana",100);
me->add("max_force",-random(10));
me->add("max_mana",-random(10));
}

void valid_move(object me) 
{
if( !me )  return;
if ( me->query("赌场/钱")<= 1000000 ) return;
if ( present(me,this_object()) )  return;
message_vision("众衙役蜂拥而至，一把拉住$N：终于逮到你了！\n",me);
message_vision("众衙役道：终于逮到个可以交差的了。\n",me);
message_vision("众人将$N锁住，欢天喜地的去了。\n",me);
me->move(this_object());
}

