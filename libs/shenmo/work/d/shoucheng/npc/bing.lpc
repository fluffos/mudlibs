inherit NPC;


void create()
{
  set_name("唐兵", ({ "tang bing", "bing"}));
  set("age", 18+random(10));
  set("gender", "男性");
  set("long", "这是一位年轻的唐军士兵，满面征尘。\n"); 
  set("attitude", "peaceful");
  set("str", 20);
  set("combat_exp", 20000);
  set("max_kee", 400);
  set("max_sen", 400);
  set("max_force", 200);
  set("force", 200);
  set("force_factor", 10);
  set_skill("unarmed", 40);
  set_skill("dodge", 40);
  set_skill("parry", 40);
  set_skill("spear", 40);
  set_skill("sword", 40);
  set_skill("force", 40);

  setup();
  if (random(2))
  carry_object("/d/obj/weapon/spear/changqiang")->wield();
  else
  carry_object("/d/obj/weapon/sword/changjian")->wield();
  carry_object("/d/obj/armor/tiejia")->wear();
}

