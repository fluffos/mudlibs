// lightarmor.c
#include <armor.h>

inherit ARMOR;

void create()
{
        set_name("牛皮坎肩", ({"niupi kanjian","piyi","kanjian","armor"}));
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
            set("long", "一件牛皮坎肩，看起来相当结实。\n");
                set("value", 0);
                set("warcity", 1);
                set("material", "wood");
                set("armor_prop/armor", 100);
             }
			 setup();
}
