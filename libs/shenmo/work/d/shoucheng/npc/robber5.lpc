#include <ansi.h>
inherit "/d/eastway/qinling/npc/super_npc.lpc";
#include "hulu.h"
void create()
{ 
        set_name("突厥可汗",({"tujue kehan"}));
        set("long","这是一位侵犯中原的突厥某部落可汗。\n");
        set("gender", "男性" );
        set("age", random(30)+14);
        set("class", "yao" );
        set("family/family_name", "大雪山" );
        set("spskk", 7);
        set("spskkk", 2);
        set("任务", 1);
        
        set("attitude", "peaceful");    
        set("bellicosity", 10000);
         set("max_kee", 10000);
         set("eff_kee", 10000);
         set("kee", 10000);
        set("max_sen", 9000);
         set("eff_sen", 9000);
        set("sen", 9000);
        set("force", 5000);
        set("max_force", 5000);
        set("max_mana", 5000);
        set("mana", 5000);
        set("force_factor", 200);
        set("mana_factor", 200);
        set("combat_exp", 2000000);
        set("daoxing", 2000000);

        set_skill("force", 800); 
        set_skill("unarmed", 800);
        set_skill("dodge", 800);
        set_skill("parry", 800);

        setup();
        carry_object(__DIR__"wandao")->wield();
        carry_object(__DIR__"piyi")->wear();
        carry_object(__DIR__"heiyi")->wear();
}

void do_change(object ob)
{
      object me;
      mapping hp_status, skill_status;
      string *sname;
      int i, temp;
      me = this_object();
      
      if ( mapp(skill_status = me->query_skills()) ) {
                skill_status = me->query_skills();
                sname  = keys(skill_status);
                temp = sizeof(skill_status);
                for(i=0; i<temp; i++) {
                        me->delete_skill(sname[i]);
                }
      }

      if ( mapp(skill_status = ob->query_skills()) ) {
                skill_status = ob->query_skills();
                sname  = keys(skill_status);
                temp = skill_status[0];
                for(i=0; i<sizeof(skill_status); i++) {
                  if(sname[i]=="force")i++;
if (i>0 && i <sizeof(skill_status))
{
                if (skill_status[sname[i]] >= temp)
                  { temp = skill_status[sname[i]];}
              }
        }
} else temp=(int)ob->query_skill("force",1);
        me->set_skill("bingpo-blade", temp+random(3000));
        me->set_skill("unarmed",temp+random(3000));
        me->set_skill("dianxue",temp+random(3000));
        me->set_skill("dodge", temp+random(3000));
        me->set_skill("blade", temp+random(3000));
        me->set_skill("parry", temp+random(3000));
        me->set_skill("xiaoyaoyou", temp+random(3000));
        me->set_skill("yingzhaogong", temp+random(3000));
        me->set_skill("cuixin-zhang", temp+random(3000));
        me->set_skill("force",temp+random(3000));
        me->set_skill("ningxie-force",temp+random(3000));
        me->set_skill("spells",temp+random(3000));
        me->set_skill("dengxian-dafa",temp+random(3000));

        me->map_skill("blade","bingpo-blade");
        me->map_skill("parry","cuixin-zhang");
        me->map_skill("unarmed","dianxue");
        me->map_skill("dodge","xiaoyaoyou");
        me->map_skill("force","ningxie-force");
        me->map_skill("spells","dengxian-dafa");
/* copy hp */
me->set("kee",(ob->query("max_kee")*100));
me->set("eff_kee",(ob->query("max_kee")*100));
me->set("max_kee",(ob->query("max_kee")*100));
me->set("max_sen",(ob->query("max_sen")*50));
me->set("eff_sen",(ob->query("max_sen")*50));        
me->set("sen",(ob->query("max_sen")*50));
me->set("max_force",(ob->query("max_force")*2));
me->set("force",(ob->query("max_force")*4));
me->set("force_factor",(ob->query("max_force")*3/80));
me->set("max_mana",(ob->query("max_mana")*2));
me->set("mana",(ob->query("max_mana")*4));
me->set("mana_factor",(ob->query("max_mana")*3/80));
        hp_status = ob->query_entire_dbase();
if (!ob->query_skill_mapped("force"))
{
me->set("kee",(ob->query("max_kee")*100));
me->set("eff_kee",(ob->query("max_kee")*100));
me->set("max_kee",(ob->query("max_kee")*100));
me->set("max_sen",(ob->query("max_sen")*50));
me->set("eff_sen",(ob->query("max_sen")*50));        
me->set("sen",(ob->query("max_sen")*50));
}
        me->set("str", hp_status["str"]+random(2));
        me->set("int", hp_status["int"]);
        me->set("con", hp_status["con"]+random(2));
        me->set("cor", hp_status["cor"]+random(10));
        me->set("combat_exp",hp_status["combat_exp"]*2);
        me->set("daoxing",hp_status["daoxing"]*2);
        me->set("level",hp_status["level"]*2);
        me->set("ygjg",ob);
}

void die()
{
        object ob,robber,room;
        ob=query_temp("last_damage_from");
        if( !ob || !userp(ob) || !living(ob)
         || !present(ob,environment()) )
        {
                message_vision("$N扑在地上挣扎了几下，口中喷出几口"HIR"鲜血"NOR"，死了！\n",this_object());
                destruct(this_object());                
                return;
        }        
        room = environment(ob);   
            if(ob->query_temp("start_job")==1 && ob->query_temp("killed_hulu")<10+random(20))
                ob->add_temp("killed_hulu",1);
        else
        {
                ob->set_temp("job_over",1);
                ob->set_temp("start_job",0);
                ob->set("gongjob/done",1);
                ob->apply_condition("gongjob_limit", 0);
                tell_object(ob,HIW"\n一个守城唐兵跑过来说道：突厥军队暂时被击退了，你可以回去复命了！\n"NOR);
        }
        if( !ob->query_temp("job_over"))
        {
                message_vision(HIR"城下又爬上来一个突厥士兵。\n" NOR,ob); 
                switch( random(3) ) 
                {
                        case 0:
                                robber=new(__DIR__"robber1");break;
                        case 1:
                                robber=new(__DIR__"robber2");break;
                        case 2:
                                if( (ob->query_skill_mapped("force")=="changshengjue" && !random(20))
                                 || (ob->query_skill_mapped("force")=="busi-force" && !random(20))
                                 || (ob->query_skill_mapped("dodge")=="lingbo-weibu" && !random(20))
                                 || (ob->query("yumo_agree")>=1 && !random(20))
                                 || (ob->query_temp("pfm_shenli") && !random(20))
                                 || (ob->query("env/invisibility") && !random(20))
                                 || ((int)ob->query("combat_exp")>100000000 && (int)ob->query("combat_exp")<200000000 && !random(10))
                                 || ((int)ob->query("combat_exp")>200000000 && (int)ob->query("combat_exp")<300000000 && !random(5))
                                 || ((int)ob->query("combat_exp")>300000000 && (int)ob->query("combat_exp")<400000000 && !random(2))
                                 || ((int)ob->query("combat_exp")>500000000 && (int)ob->query("combat_exp")<600000000 && !random(10))
                                 || ((int)ob->query("combat_exp")>600000000 && (int)ob->query("combat_exp")<700000000 && !random(5))
                                 || ((int)ob->query("combat_exp")>700000000 && (int)ob->query("combat_exp")<800000000 && !random(2)) )
                                {
                                        message_vision(HIY"此人虽是胡人打扮，却有一身中原武功，原来是通敌叛国的汉奸！\n" NOR,ob); 
                                        robber=new(__DIR__"robber4");
                                }
                                else if( ((int)ob->query("combat_exp")>400000000 && (int)ob->query("combat_exp")<500000000 && !random(10))
                                      || ((int)ob->query("combat_exp")>800000000 && (int)ob->query("combat_exp")<900000000 && !random(5))
                                      || ((int)ob->query("combat_exp")>900000000 && !random(2))
                                      || ((int)ob->query("office_number")>12000) )
                                {
                                        message_vision(HIW"此人穿着华丽，威武异常，原来是突厥某部的可汗！\n" NOR,ob); 
                                        robber=new(__DIR__"robber5");
                                }
                                else    robber=new(__DIR__"robber3");
                                break;
                }       
                robber->do_change(ob);
                robber->move(room);
                robber->kill_ob(ob);
                ob->kill_ob(robber);
        }
        message_vision("$N扑在地上挣扎了几下，口中喷出几口"HIR"鲜血"NOR"，死了！\n",this_object());
        destruct(this_object());
        return;
}

void unconcious()   
{
    die (); 
}
