// shoupi.c

#include <armor.h>

inherit CLOTH;

void create()
{
        set_name("紧身黑衣", ({"jinshen heiyi", "heiyi", "cloth"}));
	set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("material", "cloth");
                set("unit", "件");
                set("value", 0);
                set("warcity", 1);
                set("armor_prop/armor", 125);

        }
        setup();
}

