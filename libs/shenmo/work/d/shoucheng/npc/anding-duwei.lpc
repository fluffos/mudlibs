// duwei.c 安定守城都尉
#include <ansi.h>
inherit NPC;

void create()
{
        set_name("大唐都尉", ({ "du wei", "du", "wei" }));
        set("gender", "男性");
        set("age", random(10) + 30);
        set("str", 25);
        set("long", "这是一位年轻的唐军将领，满面征尘。\n");
        set("combat_exp", 4500000);
        set("attitude", "peaceful");

        set_skill("unarmed", 600);
        set_skill("force", 600);
        set_skill("sword", 600);
        set_skill("spear", 600);
        set_skill("blade", 600);
        set_skill("dodge", 600);
        set_skill("parry", 600);
        set_temp("apply/attack", 50);
        set_temp("apply/defense", 50);
        set_temp("apply/armor", 50);
        set_temp("apply/damage", 30);

        set("force", 4000); 
        set("max_force", 2000);
        set("force_factor", 10);

        setup();
        if (random(2))
                carry_object("/d/obj/weapon/spear/tiespear")->wield();
        else    carry_object("/d/obj/weapon/sword/tiejian")->wield();
        carry_object("/d/obj/armor/tongjia")->wear();
}

void die()
{
        set("eff_kee", 2200);
        set("eff_sen", 2200);
        set("kee", 2200);
        set("sen", 2200); 
}

void unconcious()
{
        die ();
}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        if(ob->query_temp("start_job")==1)
        {
              say( CYN"都尉皱了皱眉：这位" + RANK_D->query_respect(ob)
                                + "，叫你守城，你却到处闲逛，我去禀告尉迟将军！\n"NOR);
              ob->set_temp("job_over", 1); 
        }       
        else if(ob->query_temp("mark/gong_city")==1)                        
        {
                say( CYN"都尉拱手说道：这位" + RANK_D->query_respect(ob)
                                + "，你来得正是时候，突厥军队已经快攻上城了。\n"NOR);
               ob->apply_condition("gongjob_limit", 5+random(20));
                ob->set_temp("start_job",1);     
               ob->set_temp("where",environment(ob));
                call_out("to_rob",10,ob);
        }
        if(ob->query_temp("job_over")==1)
        {
              say( CYN"都尉拱手说道：这位" + RANK_D->query_respect(ob)
                                + "，你已经可以回去复命了。\n"NOR);
              return;
        }                                
}

int do_task()
{
        object me = this_player();
        if( !userp(me) )
                return 0;
        greeting(me);
        return 1;
}       

void to_rob(object ob)
{
        object *target,robber,room;
        mapping my_fam;                  
        int i;
        if(!ob || !present(ob,environment()) ) 
                return;
        my_fam  = ob->query("family/family_name");                  
        target=users();  
        room = environment(ob);
        if(ob->query_temp("start_job")==0)
                return;
        if( environment(ob)->query("short")=="安定")
        {
                robber=new(__DIR__"robber1");
                        robber->do_change(ob);
                robber->move(room);
                message_vision(HIR"突然城下爬上来一个突厥士兵。\n" NOR,ob); 
                robber->kill_ob(ob);
                ob->kill_ob(robber);
        }
}



