inherit ROOM;

void create ()
{
  set ("short", "马邑");
  set ("long", @LONG

一座雄伟的城池坐落在群山之中，马邑是大唐北部军事重镇，
镇守大唐国的北部大门，城外向北便是突厥地界，突厥以游牧
生活为主，常常觊觎中原地大物博，所以虽然大唐国力昌盛，
却时有小股突厥军队前来扰掠。

LONG);

  set("exits", ([
        "southwest"   : __DIR__"broadway3",
      ]));
  set("objects", ([
                __DIR__"npc/mayi-duwei": 1,
                __DIR__"npc/bing": 2 ]) );
  set("outdoors", __DIR__);
  set("warcity", 1);
  setup();
}

void init()
{
        add_action("do_bianhua", "bianhua"); 
        add_action("do_unwield", "unwield"); 
        add_action("do_bianhua", "huhuan"); 
        add_action("do_wield", "wield"); 
}
int do_bianhua()
{
   object me; 
   me=this_player(); 
         tell_object(me,"到了这步田地，已经来不及了！\n");  
   return 1;
}

int do_unwield()
{
   object me; 
   me=this_player(); 
         tell_object(me,"难道你想缴械投降？小心军令！\n"); 
   return 1; 
}

int do_wield()
{
   object me; 
   me=this_player(); 
         tell_object(me,"到了这步田地才想到掏家伙，来不及了！\n"); 
   return 1; 
}
