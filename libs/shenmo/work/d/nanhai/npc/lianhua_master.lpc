#include <ansi.h>
#include <localtime.h>

mapping data = ([]);
// modify by fang 
// nosave int max = 20+random(80)/2;
nosave int max = 40+random(80);

string check_week(int time)
{
string e_time, c_week,week, month, year;
int day, hour, minute, second;
string *week_name = ({"Mon","Tue","Wed","Thu","Fri","Sat","Sun"});


if ( time )
        e_time = ctime(time);
else    e_time = ctime(time());

sscanf(e_time,"%s %s %d %d:%d:%d %s", week, month, day, hour, minute, second, year);
c_week  = chinese_number(member_array(week, week_name) + 1);
if(week=="Mon") c_week="金曜日"; 
else if(week=="Tue") c_week="木曜日";  
else if(week=="Wed") c_week="水曜日";      
else if(week=="Thu") c_week="火曜日";        
else if(week=="Fri") c_week="土曜日";      
else if(week=="Sat") c_week="日曜日";      
else if(week=="Sun") c_week="月曜日";
return c_week;
}

void add_yaoguai_num()
{
data[check_week(time())]+= 1;
}

int check_yaoguai_num()
{
string t = check_week(time());
if ( !data[t] )  data[t] = 1;
message("shout",sprintf(HIC"【"HIG"般若界"HIC"】湿婆(Shi po)：今日%s朵八部莲花业已有%s朵皈依所属,时间为%s\n"NOR,chinese_number(max),chinese_number((data[t])-1),t),
        users());

if ( data[t]>max )
        return 0;
return 1;
}               

