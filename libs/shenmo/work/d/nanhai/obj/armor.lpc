#include <ansi.h>
#include <dbase.h>
#include <armor.h>

inherit F_UNIQUE;
inherit ARMOR; 

int do_wear(string arg);
int do_remove(string arg);
object offensive_target(object me);
string *sword1=({ HIW"绝"NOR,
		HIR"禁"NOR,
		HIC"宵"NOR,
		HIB"冥"NOR,
		HIG"长"NOR,
		HIY"轩"NOR,
                    });
string *sword2=({ HIW"命"NOR,
		HIR"灭"NOR,
		HIC"霞"NOR,
		HIB"泉"NOR,
		HIG"青"NOR,
		HIY"辕"NOR,
                    });
string *sword3=({ HIW"剑"NOR,
		HIR"剑"NOR,
		HIC"剑"NOR,
		HIB"剑"NOR,
		HIG"剑"NOR,
		HIY"剑"NOR,
                    });
       

void create() 
{ 
set_name( BMAG+HIR"萬韌蓮花"NOR, ({"wanren lianhua", "lianhua", "jia", "armor" })); 
set_weight(9000); 
if (clonep())   set_default_object(__FILE__); 
else { 
	set("unit", "件"); 
	set("long",  BMAG+HIR"金光闪闪的聖甲,上面绣着龙飞凤舞的封印。\n"NOR); 
	set("material", "steel"); 
	set("no_drop",  RED"\n寶物易求難得。\n\n"NOR);  
	set("no_give",  RED"\n寶物易求難得。\n\n"NOR);  
	set("no_get",  RED"\n寶物易求難得。\n\n"NOR);  
	set("no_give",  RED"\n寶物易求難得。\n\n"NOR);  
	set("armor_prop/armor", 150);
	set("armor_prop/dodge", 20);
	} 
setup(); 
} 

int init()
{
        add_action("do_wear","wear");
        add_action("do_remove", "remove");
        return 1;
}

// This function selects a random target for offensive spells/functions.
object offensive_target(object me)
{
        int sz;
        object *enemy;

        enemy = me->query_enemy();
        if( !enemy || !arrayp(enemy) ) return 0;

        sz = sizeof(enemy);
        if( sz > 4 ) sz = 4;

        if( sz > 0 ) return enemy[random(sz)];
        else return 0;
}

int do_wear (string arg)
{
object me = this_player();
object jia = this_object();
string name = jia->query("name");
string msg;
msg=BMAG+HIW"一阵庄严的婆娑梵音中，$N穿上一件"+name+ BMAG+HIW"身后泛起千朵莲花幻迹。\n"NOR;
jia->set("wear_msg",msg);
remove_call_out("conditions_jia");
call_out("conditions_jia",1,me,jia);
return 0;
}

int do_remove (string arg)
{
object me = this_player();
object jia = this_object();
string name = jia->query("name");
string msg;
msg=BMAG+HIW"$N恭敬的将"+name+ BMAG+HIW"脱将下来,低声诵了声我佛。\n"NOR;
jia->set("remove_msg",msg);
remove_call_out("conditions_jia");
return 0;
}


void conditions_jia(object me,object ob)
{
int i;
object target = offensive_target(me);
string name=ob->query("name");
message("sound", name+HIR"上的封印里突然冲出一道血影,重重剑影从中冲了出来!\n"NOR,environment(me));
for (i=1;i<=random(10);i++)
	{
	message_vision(HIW+sword1[random(4)]+sword2[random(4)]+sword3[random(4)]+HIW"击中$N!\n"NOR,target);
	target->add("eff_kee",-target->query("kee")/20);
	}
call_out("conditions_jia",7,me,ob);
}