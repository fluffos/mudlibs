#include <ansi.h>
#include <armor.h>
inherit EQUIP; 
inherit F_SAVE;

string *names=({ 
        HIY"静心莲花"NOR,"jingxin",
        HIW"如意莲花"NOR,"ruyi",
        HIY"金身莲花"NOR,"jinshen",
        WHT"孤禅莲花"NOR,"guchan",
        RED"涅磐莲花"NOR,"niepan",
});

mapping a_types = ([
        "head"          : ({"顶","装备在头上遮风挡雨。",15,1000}),
        "neck"          : ({"串","戴在脖子上驱恶辟邪。",6,500}),
        "cloth"         : ({"朵","穿在身上挡风御寒。",40,3000}),
        "armor"         : ({"抹","穿在身上抵挡刀箭。",80,5000}),
        "surcoat"       : ({"朵","披在身后遮风挡雨。",45,2000}),
        "waist"         : ({"串","佩在腰间驱恶辟邪。",10,1000}),
        "wrists"        : ({"串","戴在指间驱恶辟邪。",5,500}),
        "shield"        : ({"朵","拿中手中抵挡刀箭。",40,2500}),
        "finger"        : ({"朵","捏在指尖驱恶辟邪。",4,500}),
        "boots"         : ({"对","踩在脚下驱恶辟邪。",30,800}),  
]);     

void randomName()
{
string name,id,*ids;
int i = random(sizeof(names)/2)*2;
name = names[i];
id = names[i+1];
ids = ({id,id+" lianhua","lianhua","hua"});
this_object()->set_name(name,ids);
setup();
}

void leave()
{
string str;     
remove_call_out("leave");
if ( environment() && environment()->query("id")==query("owner_id") )   return;
write("\n"+this_object()->name()+HIY"化作一道金光冲天而去。\n\n"NOR);
if ( stringp(str=this_object()->query("save_file")) )
        {
        if ( stringp(read_file("/c/莲花/"+str+".o")) )
                {
                write("此莲花存在存档文件。\n");        
                if ( ("/cmds/wiz/rm.c")->main(this_object(),("/c/莲花/"+str+".o")) )
                        write("莲花存档文件删除成功。\n");      
                else    write("莲花存档文件删除失败。\n");              
                }
        else    write("此莲花不存在存档文件。\n");
        }            
destruct(this_object());
}


void _leave()
{
call_out("leave",2+random(5));
}               

void check_owner()
{
object ob = this_object();
object env = environment();
if ( !userp(env) || (stringp(query("owner_id"))&&env->query("id")!=query("owner_id")) )
        _leave();
return;
}

string query_save_file() 
{
object env;
string str;
env = environment();
if ( !env || !userp(env) )
        return 0;
if ( !stringp(str=this_object()->query("save_file")) )
        return 0;
return "/c/莲花/"+str;
}

int query_autoload()
{
return 1;
}

int save()
{
object env;
string str;
env = environment();
if ( !env || !userp(env) )
        return 0;
if ( !stringp(query("owner_id")) )  return 0;
if ( this_object()->query("equipped") )
        {
        tell_object(env,"你得将莲花脱下方可保存。\n");  
        return 0;       
        }
if ( !stringp(str=this_object()->query("save_file")) )
        return 0;
return ::save();
}
        
int restore() 
{
object env;
string str;
env = environment();
if ( !env || !userp(env) )
        return 0;
if ( this_object()->query("equipped") )
        {
        tell_object(env,"你得将莲花脱下方可读取。\n");  
        return 0;       
        }
if ( !stringp(str=this_object()->query("save_file")) )
        return 0;       
return ::restore();     
}

void init()
{
if ( !stringp(query("owner_id")) )
        this_object()->set("owner_id",this_player()->query("id"));
if ( !query_temp("reloaded") )
        {
        if ( !this_object()->restore() )
               {
               write(HIR"你从哪里偷来的莲花？！\n"NOR);
               _leave();
               return;
               }
        this_object()->set_temp("reloaded",1);
        }       
check_owner();
if ( !query_temp("saved") )
        {
        this_object()->save();
        this_object()->set_temp("saved",1);
        }
add_action("do_wear","wear");
add_action("do_remove", "remove");
}


int do_wear (string arg)
{
object me = this_player();
object jia = this_object();
string name = jia->query("name");
string msg;

if ( !present(jia,me) )                         //不在身上 
        return 0;
if ( arg!="all" && !id(arg) )                   //不是穿此
        return 0;
if ( query("equipped") || query("use")==1 )     //已穿此
        return 0;
if ( me->query_temp("armor/"+jia->query("armor_type")) )        //同类型已穿
        return 0;

msg = "$N背后现出一朵$n护住了$P的妙严肉身。\n";
jia->set("wear_msg",msg);
jia->set("use",1);
remove_call_out("jia_condition");
call_out("jia_condition",1,me,jia);
return 0;
}

int do_remove (string arg)
{
object me = this_player();
object jia = this_object();
string msg;

if ( !present(jia,me) )
        return 0;

if ( arg!= "all" && !id(arg) )
        return 0;

if ( !query("equipped") || query("use")==0 )
        return 0;

msg = "$N低诵我佛，$n随风碎成片片花瓣。\n"NOR;
jia->set("unequip_msg",msg);
jia->set("use",0);
remove_call_out("jia_condition");
return 0;
}

void jia_condition(object me,object ob)
{
string msg;
int i = ob->query("莲花/lvl"); 
i*= 400;
i = i/2+random(i); 

if ( query("use")!=1 )
        return;

if ( me->query_temp("armor/"+ob->query("armor_type"))!=ob )
        {
        ob->set("use",0);
        return;
        }

switch( query("莲花/addType") )
        {
        case "kee" :
                if ( me->query("kee")<me->query("eff_kee") )
                        {
                        if ( i>me->query("eff_kee")/10 )        
                                msg=CYN"$n"CYN"在$N"CYN"身后隐隐约约摆动，$P立刻觉得气血充沛起来！\n"NOR;
                        else    msg="$n在$N身后隐隐约约摆动，$P立刻觉得气血充沛起来！\n";       
                        message_vision(msg,me,ob);
                        me->add("kee",i);
                        if ( me->query("kee")>me->query("eff_kee") )   me->set("kee",(int)me->query("eff_kee") );
                        }
                break;
        case "eff_kee" :                                
                if ( me->query("eff_kee")<me->query("max_kee") )
                        {
                        if ( i>me->query("max_kee")/10 )                
                                msg=HIC"$n"HIC"在$N"HIC"身后隐隐约约摆动，$P立刻觉得气血充沛起来！\n"NOR;
                        else    msg="$n在$N身后隐隐约约摆动，$P立刻觉得气血充沛起来！\n";       
                        message_vision(msg,me,ob);
                        me->add("eff_kee",i/2);
                        if ( me->query("eff_kee")>me->query("max_kee") )   me->set("eff_kee",(int)me->query("max_kee") );
                        }
                break;
        case "sen" :
                        if ( me->query("sen")<me->query("eff_sen") )
                        {
                        if ( i>me->query("eff_sen")/10 )
                                msg=WHT"$n"WHT"在$N"WHT"身后隐隐约约摆动，$P精神一振！\n"NOR;
                        else    msg="$n在$N身后隐隐约约摆动，$P精神一振！\n";   
                        message_vision(msg,me,ob);
                        me->add("sen",i);
                        if ( me->query("sen")>me->query("eff_sen") )   me->set("sen",(int)me->query("eff_sen") );
                        }
                        break;
        case "eff_sen" :                        
                        if ( me->query("eff_sen")<me->query("max_sen") )
                        {
                        if ( i>me->query("max_sen")/10 )        
                                msg=HIW"$n"HIW"在$N"HIW"身后隐隐约约摆动，$P精神一振！\n"NOR;
                        else    msg="$n在$N身后隐隐约约摆动，$P精神一振！\n";   
                        message_vision(msg,me,ob);
                        me->add("eff_sen",i/2);
                        if ( me->query("eff_sen")>me->query("max_sen") )   me->set("eff_sen",(int)me->query("max_sen") );
                        }
                break;

        case "force" :
                        if ( (int)me->query("force")/2<(int)me->query("max_force") )
                        {
                        if ( i>me->query("max_force")/10 )      
                                msg=HIY"$n"HIY"在$N"HIY"身后隐隐约约摆动，$P顿时觉得内力充沛起来！\n"NOR;
                        else    msg="$n在$N身后隐隐约约摆动，$P顿时觉得内力充沛起来！\n";
                        message_vision(msg,me,ob);
                        me->add("force",i);
                        if ( (int)me->query("force")/2 > (int)me->query("max_force") )
                                me->set("force",(int)me->query("max_force")*2 );
                        }
                break;

        case "mana" :
                        if ( (int)me->query("mana")/2<(int)me->query("max_mana") )
                        {
                        if ( i>me->query("max_mana")/10 )
                                msg=HIG"$n"HIG"在$N"HIG"身后隐隐约约摆动，$P顿时觉得法力充沛起来！\n"NOR;
                        else    msg="$n在$N身后隐隐约约摆动，$P顿时觉得法力充沛起来！\n";
                        message_vision(msg,me,ob);
                        me->add("mana",i);
                        if ( (int)me->query("mana")/2>(int)me->query("max_mana") )
                                me->set("mana",(int)me->query("max_mana")*2 );
                        }
                break;
        }

remove_call_out("jia_condition");
call_out("jia_condition",2+random(4),me,ob);
}


void setup() 
{
string *a_t,type,long,unit;
int p,we,i;     

//      "boots"         ：({"对","踩在脚下驱恶辟邪。",30,800}),  
a_t = keys(a_types);
type = a_t[random(sizeof(a_t))];
unit = a_types[type][0];
long = a_types[type][1];
p = a_types[type][2];
we = a_types[type][3];
set("armor_type", type);
set("unit",unit);
set("long",HIC"一"+unit+"莲花，可以"+long+"\n"NOR);
set("莲花",([
        "lvl"           : 1+random(5),
        "addType"       : ({"kee","eff_kee","sen","eff_sen","force","mana"})[random(6)],
]));    
set_weight(we);
set("armor_prop/base", p);
p+= random(p/2);
set("armor_prop/armor", p);
i = query("莲花/lvl");
if ( random(5)==1 )
        set("armor_prop/dodge",1+random(i));
if ( random(5)==1 )
        set("armor_prop/parry",1+random(i));
if ( random(5)==1 )
        set("armor_prop/force",1+random(i));
if ( random(5)==1 )
        set("armor_prop/mana",1+random(i));
if ( random(5)==1 )
        set("armor_prop/literate",1+random(i));
}       

void create()
{
randomName();
set("material", "steel");
set("no_sell",1);
set("value",1);
}

string short()
{
int i = query("莲花/lvl");
string str;
if ( i<=5 )  str = YEL"平凡"NOR;
else if ( i<=10 )  str = CYN"俗世"NOR;
else if ( i<=20 )  str = HIW"长老"NOR;
else if ( i<=50 )  str = HIY"脱俗"NOR;
else str = HIW"圣佛"NOR;
return str+"的"+query("name");
}


