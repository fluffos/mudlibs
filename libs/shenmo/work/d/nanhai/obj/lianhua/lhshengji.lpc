#include <ansi.h>
inherit ITEM;
int do_shengji(string arg);
void create() {
  set_name("莲花升级魄石", ({ "hebing poshi", "po", "shi" }));
  set("unit", "颗");
  set("long", "一颗形状古朴的魄石，用它可以升级(shengji)莲花。\n");
  set_weight(5000);
  set("value", 0);
  set("no_give", 1);
  set("no_put", 1);
  setup();
}

void destruct_me() {
  write(HIW + name() + "化作一朵莲花冲天而去！\n\n" NOR);
  this_object()->move("/obj/empty");
  destruct(this_object());
}

void init() {
  add_action("do_shengji", "shengji");
}

int err_msg(string arg) {
  write(arg);
  if ((__DIR__ "master.lpc")->query_hebing() == this_object())
    (__DIR__ "master.lpc")->set_is_hebing(0);
  return 0;
}

int do_shengji(string arg) {
  object h1, h2, hua, me;
  string id1, id2, str, t1, t2, *tt;
  int i, k, j;
  string msg;

  me = this_player();
  if (!present(this_object(), me))
    return 0;
  if (this_object()->query("owner")) {
    if (this_object()->query("owner") != me->query("id"))
      return err_msg("这是你的东西吗？ \n");
  }

  if (!arg || sscanf(arg, "%s", id1) != 1)
    return err_msg("升级格式为  shengji <莲花>\n");
  h1 = present(id1, me);
  if (!h1 || !h1->is_lianhua()
    || !me->query("莲花/" + h1->query("armor_type")))
    return err_msg("你身上没有这朵莲花或是此莲花无存储文件。\n");

  if (me->query("id") != h1->query("owner_id"))
    return err_msg(h1->name() + "不是你的莲花。\n");
  if (h1->query("equipped") == "worn")
    return err_msg("你先将这朵莲花脱下来吧。\n");
  if (h1->query("莲花/lvl") > 5)
    return err_msg("这朵莲花已经是最高级了。\n");
  i = h1->query("莲花/lvl");
  h1->set("莲花/lvl", i + 1);

  msg = "【顺风耳】某人：听说" + me->name() + "使用了" + name() + "将" + h1->name() + "等级提升。\n";
  msg = SDS_D->no_color_msg(msg);
  msg = HIM + msg + NOR;
  msg = SDS_D->color_msg(msg);
  message("channel:rumor", msg, users());
  destruct(this_object());

}

string short() {
  return ::short() + "(小)";
}
