//snowtu加入sds衣 2004

#include <ansi.h>
#include "/cmds/std/valid_move.h"

int help(object me);
int do_bian(object me);
int abs(int count);
int necklace_change(object me, int level);
int main(object me, string arg) {
  string id, msg;
  object obj, newob, *inv;
  int mana, spells, dmana, level, i;
  string str;

  seteuid(getuid());

  if (!valid_move(me))
    return notify_fail("你正忙着呢，没工夫变身。\n");
  if (!arg && arg != "changedown" && arg != "changeup" && arg != "shengyi" && arg != "lianhua")
    return help(me);

  spells = me->query_skill("spells");
  mana = me->query("mana");
  level = me->query("level");

  if (arg == "changeup") {
    me->delete_temp("zhenshendown");
    if (me->query_temp("getdd/zhenshens"))
      return notify_fail("你已经是金刚护体不坏之身了。\n");
    if (spells < 25)
      return notify_fail("你的法术不够。\n");
    if (mana < 150)
      return notify_fail("你目前法力不够充盈。\n");
    if (level < 50)
      return notify_fail("你的等级不够。\n");
    newob = new("/obj/zhenshencloth");
    if (newob) {
      newob->set("owner_id", me->query("id"));
      newob->set("armor_prop/armor", level + 180);
      newob->set("level", level + 10);
      newob->set("armor_prop/spells", level / 2);
    }
    newob->move(this_player());
    newob->wear(me);
    necklace_change(me, level);
    message_vision(HIY "$N心神宁静，席地而坐，口念咄咄咒语，头顶一缕浊气飘然而出．．．\n"
      + "\n只见$N全身发出阵阵声响，顿时天空云消雾散忽降五彩神光笼罩$N全身．．．．．．\n"
      + "\n$N此时精神为之一振，霎时间过往云烟似乎看的淡而无形．．．．．．\n\n" NOR, me);
    message(
      "channel:rumor",
      HIG + "【" HIW "西游记--神魔传说" HIG "】" HIC "弥勒佛" HIW "：据说" + me->query("name") + "破红尘，去杂念，超度真灵，修成不坏之体，并得到元素项链。\n" + NOR,
      users()
    );
    str = HIY "生界奇人" NOR + me->query("title");
    if (me->query("gender") == "女性") str += "女";
    me->set_temp("zhenshens_time", time());
    me->set_temp("getdd/zhenshens", 1);
  }

  if (arg == "changedown") {
    if (!me->query_temp("getdd/zhenshens"))
      return notify_fail("你没得到不坏之身，怎么能恢复原状？！\n");
    if (me->query_temp("zhenshendown"))
      return notify_fail("你没得到不坏之身，无法恢复原状。\n");
    necklace_change(me, -level);
    me->delete_temp("title", str);
    me->delete_temp("getdd/zhenshens");
    me->set_temp("zhenshendown", 1);
    inv = all_inventory(me);
    for (i = 0; i < sizeof(inv); i++) {
      if (inv[i]->query("id") == "shengling necklace") {
        inv[i]->unequip();
        message_vision(HIW "\n汝等小儿竟敢心怀杂念，乱我佛宗，收尔等法衣，示惩戒。\n" NOR, me, inv[i]);
        destruct(inv[i]);
      }
    }
    message_vision(HIY "\n$N受到如此惊吓，心神大乱．．．半天才恢复原状。\n" NOR, me);
    return 1;
  }

  if (arg == "shengyi") {
    if (!me->query("sds3/all"))
      return notify_fail("你还没有自己的圣衣。\n");
    if (!stringp(me->query("cloth_name")))
      return notify_fail("你还没有自己命名的星座。\n");
    if (me->query_temp("zhenshen_gold_cloth_get"))
      return notify_fail("你已经取得自己的黄金圣衣了。\n");
    newob = new("/obj/gold_cloth");
    if (!newob)
      return notify_fail("坏了，圣衣不见了！\n");
    newob->set("owner_id", me->query("id"));
    if (!newob->restore())
      return notify_fail("圣衣初始>>>>>>>>>>>失败。请联系wiz.\n");
    if (!newob->move(me))
      return notify_fail("圣衣移动失败，请与巫师联系。\n");
    if (wizardp(me))
      write("id=" + newob->query("id") + "\n");
    message_vision(
      HIY "\n$N" HIY "对着天边" + me->query("cloth_name") + HIY "座振臂一呼，一道金光笼罩住$N" HIY "！\n\n" NOR,
      me
    );
    message(
      "shout",
      WHT "\n只见遥远天际的" + me->query("cloth_name") + WHT "座忽然掠过一道光芒径直射向了" + environment(me)->query("short") + WHT "。\n\n" NOR,
      users()
    );
    me->set_temp("zhenshen_gold_cloth_get", 1);
    return 1;
  }

  if (arg == "lianhua") {
    mapping lh;
    int l;
    string *ars, arr;
    object armor;
    if (!mapp(lh = me->query("莲花")))
      return notify_fail("你没有可用的莲花。\n");
    ars = keys(lh);
    l = sizeof(ars);
    while (l--) {
      if (stringp(ars[l])) {
        if (me->query_temp("召唤莲花/" + ars[l])) {
          write("你已经召唤过同类型的莲花了。\n");
          continue;
        }
        armor = new("/d/nanhai/obj/lianhua/lianhua");
        armor->set("owner_id", me->query("id"));
        arr = me->query("id");
        arr += "/";
        arr += ars[l];
        armor->set("save_file", arr);
        if (!armor->restore()) {
          write("出问题了，请联系巫师。\n");
          destruct(armor);
          continue;
        }
        if (!armor->move(me)) {
          write("你身上东西太多了。\n");
          destruct(armor);
          continue;
        }
        me->set_temp("召唤莲花/" + ars[l], 1);
      }
    }
    message_vision(HIW "\n$N" HIW "对着西方念动真言，一道祥光笼罩住$N" HIW "！\n\n" NOR, me);
    message(
      "shout",
      HIW "\n只见从西方雷音方向忽然掠过一道祥光径直射向了" + environment(me)->query("short") + HIW "。\n\n" NOR,
      users()
    );
    return 1;
  }

  return 1;
}

int necklace_change(object me, int level) {
  me->add_temp("armor_prop/armor_vs_force", level);
  me->add_temp("apply/attack", level / 2);
  me->add_temp("apply/damage", level / 2);
  me->add_temp("armor_prop/dodge", level / 2);
  if (abs(level) > 250) {
    me->add_temp("armor_prop/armor_vs_force", level / 3);
    me->add_temp("apply/attack", level / 3);
    me->add_temp("apply/damage", level / 3);
    me->add_temp("armor_prop/dodge", level / 3);
  } else if (abs(level) > 150) {
    me->add_temp("armor_prop/armor_vs_force", level / 4);
    me->add_temp("apply/attack", level / 4);
    me->add_temp("apply/damage", level / 4);
    me->add_temp("armor_prop/dodge", level / 4);
  }
}
int abs(int count) {
  if (count < 0)
    count = -count;
  return count;
}

int help(object me) {
  write(@HELP

指令格式 ： zhenshens changeup (炼真身，做世间完人)
            zhenshens changedown (破己真身，复常态)
            zhenshens shengyi    (取得自己的黄金圣衣)
            zhenshens lianhua   (取得自己的莲花)
相关指令:     Quit
破红尘，去杂念，超度真身，还要取决于自身的法力修为和自身平时积累的德行修行。

注解：变身之后恢复原状，需要Quit之后才能再次变身！


HELP
  );
  return 1;
}
