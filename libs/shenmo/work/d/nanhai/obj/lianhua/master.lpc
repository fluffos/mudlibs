
inherit NPC; 
inherit F_MASTER;  
#include <ansi.h> 
string ask_gift(); 
mapping festival = ([
         "1.1"   : "元旦节",
         "5.1"   : "国际劳动节",
         "10.1"  : "建军节",
         "12.25" : "圣诞节",
         ]);
 void create() 
 { 
         set_name(HIY"节日大使"NOR, ({ "master", "gift dashi", "dashi" })); 
  
         set("long","节日大使，这是方舟专门为了发放节日礼物而设计的大使。\n"); 
         set("attitude", "peaceful"); 
         set("per", 30); 
         set("str", 25); 
         set("int", 25); 
         set("age", 30); 
         set("title", HIW"礼物大使"NOR); 
         set("nickname", HIG"大师"NOR); 
         set("combat_exp", 850000); 
                 set("daoxing", 600000); 
  
         set("max_gin", 1400); 
         set("max_kee", 1400); 
         set("max_sen", 1400); 
         set("class", "xian"); 
         set("force", 2500); 
         set("max_force", 1500); 
         set("force_factor", 100); 
         set("max_mana", 1500); 
         set("mana", 2500); 
         set("mana_factor", 100); 
  
         set_skill("literate", 100); 
         set_skill("ghost-steps", 120); 
         set_skill("dodge", 120); 
         set_skill("unarmed", 120); 
         set_skill("parry", 120); 
         set_skill("spells", 120); 
         set_skill("gouhunshu", 80); 
         set_skill("jinghun-zhang", 120); 
         set_skill("force", 120); 
         set_skill("tonsillit", 80); 
         set_skill("stick", 120); 
         set_skill("kusang-bang", 120); 
  
         map_skill("stick","kusang-bang"); 
         map_skill("parry", "kusang-bang"); 
         map_skill("spells", "gouhunshu"); 
         map_skill("dodge", "ghost-steps"); 
         map_skill("force", "tonsillit"); 
         map_skill("unarmed", "jinghun-zhang"); 
         set("chat_chance_combat", 40); 
         set("chat_msg_combat", ({ 
                 (: exert_function, "sheqi" :), 
                 (: cast_spell, "gouhun" :), 
         }) ); 
  
  
         set("nkgain", 400); 
         set("inquiry", ([   
             "礼物"    :(:ask_gift():),   
                         "gift"    :(:ask_gift():),
         ])); 
  
         set_temp("apply/dodge", 50); 
         set_temp("apply/armor", 50); 
  
  
         setup(); 
         carry_object("/d/obj/weapon/stick/wuchangbang")->wield(); 
         carry_object("/d/obj/cloth/taijicloth")->wear(); 
 } 
  
  
 string ask_gift()
 {
         object me,ob;
         mixed *local;
         string str,*keys;
         me = this_player();
     
         /*暂时屏蔽，等系统时间正常了再开始
     keys = keys(festival);
     
         local = localtime(TIME_TICK1);
     str = sprintf("%d.%d",local[LT_MON]+1,local[LT_MDAY]);
         if( member_array(str,keys) == -1 )
                 return HIM"节日没到，我不敢发放礼物\n"NOR;
         */

         if( me->query("2007_51_gift") )
         {
                 me->set("sen",-1);
                 me->set("kee",-1);
                 return HIC"节日礼物只有一份\n"NOR;
         }
         if( objectp(present("qing jian",me)) )
         {
                 me->set("sen",-1);
                 me->set("kee",-1);
                 return HIB"你已经有了礼物好要什么？\n"NOR;
         }
         ob = new("/u/fang/obj/invitation");
         ob->move(me);
         me->command("look qing jian");
         return HIY"好吧，看在你英明神武的份上，我给你礼物\n"NOR;
 }

