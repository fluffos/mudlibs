#include <ansi.h>
inherit "/d/snowtu/obj/pian.lpc";

void create() {
  set_name("防御魄石", ({ "fangyu poshi", "shi", "po" }));
  set_weight(1000);
  set("base_weight", 1000);
  set_add_pot(1 + random(5));
  set("long", clr + "这传说是远古封神时诸位散仙散落在各地的魔法魄石。\n" NOR);
  set("unit", "些");
  set("base_unit", "块");
  set("no_sell", clr + "这些并非凡间之物。\n" NOR);
  set("pian_type", "kee");
  set("value", 0);
  set("持久", 10);
  set_amount(1);
  set_armor(1);
  //set("armor_prop/armor",this_object()->query_amror());
  setup();
}
