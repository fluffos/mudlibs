#include <ansi.h>
inherit ITEM;

string random_skill() {
  string *str = ({
    "axe", "blade", "dagger", "dodge", "force", "fork", "hammer",
    "literate", "mace", "magic", "parry", "rake", "spear",
    "spells", "staff", "stick", "sword", "stealing", "throwing",
    "unarmed", "whip",
  });
  return str[random(sizeof(str))];
}

void create() {
  set_name(HIG "莲花" HIW "魄石" NOR, ({ "po shi", "shi" }));
  set_weight(3000);
  set("unit", "颗");
  set("no_put", 1);
  set("no_give", 1);
  setup();
  set("type", random_skill());
  set("pot", random(5) - random(5) + random(5) - random(4) + random(5));
}

void dismiss() {
  if (!environment())
    return;
  destruct(this_object());
}

void init() {
  if (!environment())
    return;
  if (!environment()->is_character())
    return;
  if (environment()
    && userp(environment())
    && !query("owner_id"))
    set("owner_id", environment()->query("id"));
  if (environment()->query("id") != query("owner_id")) {
    write("\n半空伸出一把大手，将" + name() + "抓了过去！\n\n");
    this_object()->move("/obj/empty");
    remove_call_out("dismiss");
    call_out("dismiss", 2 + random(3));
    return;
  }
  add_action("do_combine", "combine");
}

int err_msg(string arg) {
  write(arg);
  return 1;
}

int do_combine(string arg) {
  string h_id, s_id, type;
  int t;
  object hua, shi, me = this_player();
  if (!arg || me != environment())
    return 0;
  if (sscanf(arg, "%s with %s", h_id, s_id) != 2)
    return err_msg("命令格式：combine <莲花id> with <魄石id>\n");
  hua = present(h_id, me);
  if (!hua || !hua->is_lianhua())
    return err_msg(name() + "必须镶嵌在莲花上。\n");
  shi = present(s_id, me);
  if (!shi || shi != this_object())
    return 0;
  if (hua->query("equipped"))
    return err_msg("你先得把" + hua->name() + "脱下。\n");

  t = query("pot");
  if (t == 0)
    return err_msg(name() + "什么反应也没有，看来是个假货。\n");
  type = query("type");
  if (!type || !is_chinese(to_chinese(type)))
    return err_msg(name() + "什么反应也没有，看来是个假货。\n");

  message_vision("$N念动真言，运起灵力，将$n镶入" + hua->name() + "中去了。\n", me, this_object());
  hua->add("armor_prop/ad_" + type, t);
  hua->save();
  CHANNEL_D->do_channel(
    this_object(),
    "rumor",
    "听说" + me->name(1) + "用" + name() + HIM "将自己的" + hua->name() + HIM "注入了灵气。" NOR
  );
  destruct(this_object());
  return 1;
}
