#include <ansi.h>
inherit ITEM;
int do_convert(string arg);

mapping t_msg = ([
          "kee"         :  HIG"增加气血"NOR,
          "eff_kee"     :  HIR"治疗气血"NOR,
          "sen"         :  HIM"增加精神"NOR,
          "eff_sen"     :  HIW"治疗精神"NOR,
          "force"       :  HIY"内力补充"NOR,
          "mana"        :  HIB"法力补充"NOR,
]);

void create()
{
set_name("莲花转换魄石",({"convert poshi","po","shi"}));
set("unit","颗");
set("long","一颗形状古朴的魄石，用它可以转换(convert)莲花。\n");
set_weight(5000);
set("value",0);
set("no_give",1);
set("no_put",1);
setup();
}

void destruct_me()
{
write(HIW+name()+"化作一朵莲花冲天而去！\n\n"NOR);
this_object()->move("/obj/empty");
destruct(this_object());
}

void init()
{
add_action("do_convert","convert");
}

int err_msg(string arg)
{
write(arg);
if ( (__DIR__"master.lpc")->query_hebing()==this_object() )
        (__DIR__"master.lpc")->set_is_hebing(0);
return 1;
}

int do_convert(string arg)
{
object h1,h2,hua,me;
string id1,id2,str,t1,t2,*tt;
int i,k,j;
string msg;
string *tmsg;
me = this_player();
if ( !present(this_object(),me) )
        return 0;
if (this_object()->query("owner"))
	 { if (this_object()->query("owner")!= me->query("id"))
	 	 return err_msg("这是你的东西吗？ \n");
	 	 }
tmsg = keys(t_msg);

if ( !arg || sscanf(arg,"%s to %s",id1,id2)!=2 )
        return err_msg("升级格式为 convert <莲花> to <类型>\n");

if( member_array(id2,tmsg) == -1 )
{
       write("转换类型如下：\n");
	for( i=0;i<sizeof(tmsg);i++)
	{
                write(tmsg[i]+"\t"+t_msg[tmsg[i]]+"\n");
     }
        return err_msg("不要忘记了！\n");
}

h1 = present(id1,me);
if ( !h1 || !h1->is_lianhua()
  || !me->query("莲花/"+h1->query("armor_type")) )
        return err_msg("你身上没有这朵莲花或是此莲花无存储文件。\n");
if( h1->query("莲花/addType") == id2 )
         return err_msg("莲花已经是这个类型，别浪费了。\n");
if ( me->query("id")!=h1->query("owner_id") )
        return err_msg(h1->name()+"不是你的莲花。\n");
if (h1->query("equipped")=="worn")
        return err_msg("你先将这朵莲花脱下来吧。\n");
if ( h1->query("hebing") || h1->query("hebing2") )
        return err_msg("转换莲花类型，只对小莲花有效。\n");
h1->set("莲花/addType",id2);
h1->save();

msg = "【顺风耳】某人：听说"+me->name()+"使用了"+name()+"将"+h1->name()+"类型更改为"+t_msg[id2]+"。\n";
msg = SDS_D->no_color_msg(msg);
msg = HIM+msg+NOR;
msg = SDS_D->color_msg(msg);
message("channel:rumor",msg,users());
write("莲花更改成功,恭喜你了\n");
destruct(this_object());

}

string short()
{
return ::short()+"(小)";
}
