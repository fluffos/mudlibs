#include <ansi.h>
inherit NPC;
inherit F_MASTER;


string ask_leidao();
void create()
{
       set_name(HIW"范 增"NOR, ({"fan zeng", "zeng"}));
       set("long",
            "亚父--范增。千万年的守侯凝成的鬼气!\n");
       set("title", "亚 父");
       set("gender", "男性");
       set("age", 160);
       set("class", "xian");
       set("attitude", "friendly");
       set("rank_info/respect", "智者");
       set("per", 40);
	set("int", 30);
       set("max_kee", 9000);
       set("max_gin", 6000);
       set("max_sen", 8000);
       set("force", 8000);
       set("max_force", 8000);
       set("force_factor", 500);
       set("max_mana", 6000);
       set("mana", 6000);
       set("mana_factor", 400);
       set("combat_exp", 4000000);
       set("daoxing", 8000000);


        set("eff_dx", 200000);
        set("nkgain", 350);

       set_skill("literate", 480);
       set_skill("unarmed", 480);
       set_skill("dodge", 480);
       set_skill("force", 480);
       set_skill("parry", 480);
       set_skill("sword", 480);
       set_skill("spells", 480);
        set_skill("power", 480);
        set_skill("rukong-zhao", 480);
        set_skill("spirit-power", 480);
        set_skill("yuanwu-kungfu", 480);
        set_skill("wushen-steps", 400);
        map_skill("spells", "spirit-power");
        map_skill("unarmed", "rukong-zhao");
        map_skill("force", "power");
        map_skill("parry", "rukong-zhao");
        map_skill("dodge", "wushen-steps");

        create_family("格斗家", 2, "智囊");

        set("inquiry", ([
                ]) );

        set("inquiry", ([
                "雷刀" : (: ask_leidao :),
                
                ]) );

        setup();

        carry_object("/d/obj/armor/jinjia")->wear();
}


string ask_leidao()
{
  object me=this_player();
  object ob=this_object();
  if (me->query("bieji1/yi")!="done") return "你的能力恐怕没有办法控制雷刀！"; 
    command("addoil");
   message_vision("$N点点头，说道：好吧，我这就送你到藏刀处去。\n",ob,me);
   tell_object(me,"眼前金光一闪，你来到了藏刀池。。。\n");
   me->move("/d/bwbj/end3");
  return "唉！时也命也，谋事在人，成事在天！\n";
}

