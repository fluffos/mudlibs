#include <ansi.h>;
inherit NPC;
#include "star.h"


void create()
{
        set_name("吕 雉", ({ "lv hou", "lvhou", "hou" }) );
        set("gender", "女性" );
	set("long",
		HIC"汉王后----吕雉\n"NOR
	);
  set("str", 20);
  set("per", 130);
 set("age", 86);
  set("family/family_name","大雪山");
 set("class", "yao");
 set("level", 300);
  set("cor", 30);
  set("cps", 75);
  set("kar", 100);
  set("int", 40);
  set("con", 40);
  set("spi", 40);
  set("title", HIC "汉 王 后" NOR);
  set("combat_exp", 36000000);
  set("daoxing", 3600000);
  set("max_sen", 6000);
  set("max_kee", 6000);
  set("force", 6000); 
  set("max_force", 6000);
  set("force_factor", 300);
  set("max_mana", 6000);
  set("mana", 6000);
  set("mana_factor", 300);
	set("class","yao");
                set_skill("literate", 350);
       set_skill("unarmed", 400);
       set_skill("dodge", 400);
       set_skill("force", 400);
       set_skill("parry", 400);
       set_skill("sword", 400);
       set_skill("throwing", 400);
       set_skill("spells", 400);
       set_skill("dengxian-dafa", 400);
       set_skill("cuixin-zhang", 400);
       set_skill("ningxie-force", 400);
       set_skill("bainiao-jian", 400);
       set_skill("xiaoyaoyou", 400);
       map_skill("spells", "dengxian-dafa");
       map_skill("unarmed", "cuixin-zhang");
       map_skill("force", "ningxie-force");
       map_skill("sword", "bainiao-jian");
       map_skill("parry", "bainiao-jian");
       map_skill("dodge", "xiaoyaoyou");
       set("chat_chance_combat", 70);
       set("chat_msg_combat", ({
                
                (: cast_spell, "niepan" :),
                (: perform_action, "sword", "chaofeng" :),

                }) );

	setup();
        carry_object("/d/obj/weapon/sword/qinghong")->wield();
   carry_object("/d/obj/armor/jinjia")->wear();
}


void init()
{
        add_action("do_none","perform");
        add_action("do_none","cast");
        add_action("do_none","ji");
}
int do_none()
{
        object me = this_object();
        message_vision("禁咒的世界，一切都是徒劳!\n",me);
        return 1;
} 

void die()
{

        object ob = query_temp("my_killer");

        if((ob&&ob->query("bieji1/san")=="done") && (ob&&ob->query("bieji1/si")!="done"))
        {
        ob->start_busy(3);
        message("chat",HIG+"【楚 河】项 羽(Xiang yu):"+ob->name()+
        "楚河之上，大败吕雉，天佑霸王，虞，你究竟在何方？\n"NOR,users());
        ob->set("bieji1/si","done");
        ob->add("bieji1/number",1);
         ob->add("daoxing", 10000);
           ob->save();
         tell_object(ob,"你赢得了十年道行");

        }

message_vision(HIW"$N的尸体上露出诡异的笑容.... \n"NOR,this_object() );
       ::die();
}

                                                                                                                                                                                                                                                                                                 
