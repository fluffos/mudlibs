#include <ansi.h>;
inherit NPC;
#include "star.h"


void create()
{
        set_name("樊 哙", ({ "fan kuai", "fankuai", "fan" }) );
        set("gender", "男性" );
	set("long",
		"屠夫----汉王座下樊哙\n"
	);
  set("str", 20);
  set("per", 130);
 set("age", 86);
  set("cor", 30);
  set("family/family_name","将军府");
set("class","human");
set("level",250);
  set("cps", 75);
  set("kar", 100);
  set("int", 40);
  set("con", 40);
  set("spi", 40);
  set("title", HIR"屠 夫"NOR);
  set("combat_exp", 32000000);
  set("daoxing", 32000000);
  set("max_sen", 6000);
  set("max_kee", 6000);
  set("force", 6000); 
  set("max_force", 6000);
  set("force_factor", 240);
  set("max_mana", 6000);
  set("mana", 6000);
  set("mana_factor", 250);
	
       set_skill("spear", 350);
  set_skill("unarmed", 350);
  set_skill("force", 350);
  set_skill("lengquan-force", 300);
  set_skill("spear", 300);
  set_skill("axe", 350);
  set_skill("dodge", 300);
  set_skill("parry", 300);
  set_skill("jinglei-mace", 300);
  set_skill("spells", 350);
  set_skill("baguazhou", 350);
  set_skill("bawang-qiang", 350);
  set_skill("wusi-mace", 350);
  set_skill("yanxing-steps", 350);
  set_skill("archery", 350);
  set_skill("xuanyuan-archery", 350);
  map_skill("force", "lengquan-force");
  map_skill("spells", "baguazhou");
  map_skill("spear", "jinglei-mace");
  map_skill("parry", "jinglei-mace");
  map_skill("dodge", "yanxing-steps");
  map_skill("spear", "bawang-qiang");
   map_skill("archery", "xuanyuan-archery");
              set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action, "spear","juanlian" :),
                (: perform_action, "spear","bugong" :),
                (: perform_action, "spear","meihua" :),

                             
        }) );
	setup();
        carry_object("/d/obj/weapon/spear/tieqiang")->wield();
   carry_object("/d/obj/armor/jinjia")->wear();
}


void init()
{
        add_action("do_none","perform");
        add_action("do_none","cast");
        add_action("do_none","ji");
}
int do_none()
{
        object me = this_object();
        message_vision("禁咒的世界，一切都是徒劳!\n",me);
        return 1;
} 

void die()
{

        object ob = query_temp("my_killer");

        if((ob&&ob->query("bieji1/yi")=="done") && (ob&&ob->query("bieji1/er")!="done"))
        {
        ob->start_busy(3);
        message("chat",HIG+"【渭水河】项 羽(Xiang Yu):"+ob->name()+
        "血我之耻，战败樊哙，天见可怜，虞，你究竟在何方\n"NOR,users());
        ob->set("bieji1/er","done");
        ob->add("bieji1/number",1);
         ob->add("daoxing", 1000);
           ob->save();
         tell_object(ob,"你赢得了十年道行");

        }

message_vision(HIW"只见尸体的脸上露出了诡异的笑容！ \n"NOR,this_object() );
       ::die();
}

