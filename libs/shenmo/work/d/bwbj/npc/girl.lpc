

inherit NPC;

void create()
{
  set_name("浣衣少女", ({"girl"}));
  set("gender", "女性");
  set("age", 22);
  set("combat_exp", 1500);
  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  set_skill("parry", 50);
  set("force", 50);
  set("max_force", 50);

  setup();
 carry_object("/d/obj/cloth/skirt")->wear();carry_object("/obj/money/gold")->set_amount(1);

}

void init()
{
  add_action ("do_look","look");
  call_out ("wash",random(2)+2);
  ::init();
}

int wash ()
{
  object where = environment(this_object());

  remove_call_out ("wash");

  if(sizeof(filter_array(all_inventory(environment(this_object())), (:userp:))))
  call_out ("wash",random(10)+30);
  if (where->query("short") != "汉水河边")
  {
    //command ("rascal");
    return 1;
  }
  if (is_fighting())
    return 1;
  switch (random(8))
  {
    case 0:
      command ("sing4");
      break;
    case 1:
      command ("smile");
      break;
    case 2:
    case 3:
    case 4:
      command ("cure");
      set("gin",query("max_gin"));
      set("kee",query("max_kee"));
      set("sen",query("max_sen"));
      break;
    case 5:
    case 6:
    case 7:
      command ("bath");
      set("gin",query("max_gin"));
      set("kee",query("max_kee"));
      set("sen",query("max_sen"));
      break;
  }
  return 1;
}

int do_look (string arg)
{
  object me = this_object();
  object who = this_player();
  object where = environment(me);

  if (
      arg &&
      me == present(arg,environment(me)) 
       &&
      where && 
      where->query("short") == "汉水河边")
  {
    message_vision ("$N对着$n笑了笑:有什么事情吗？是不是找人？\n",me,who);
    return 1;
  }
  return 0; // to invoke normal look
}

