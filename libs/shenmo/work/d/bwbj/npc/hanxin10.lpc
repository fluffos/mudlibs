// by seawind

#include <ansi.h>;
inherit NPC;
#include "star.h"


void create() {
  set_name("韩 信", ({ "han xin", "hanxin", "han" }));
  set("gender", "男性");
  set("long",
    "淮阴侯----韩信\n"
  );
  set("str", 25);
  set("per", 40);
  set("age", 40);
  set("cor", 30);
  set("cps", 75);
  set("kar", 100);
  set("int", 40);
  set("family/family_name", "三界散仙");
  set("level", 450);
  set("class", "xian");
  set("con", 40);
  set("spi", 40);
  set("title", HIY "淮阴侯" NOR);
  set("combat_exp", 58000000);
  set("daoxing", 48000000);
  set("max_sen", 30000);
  set("max_kee", 30000);
  set("force", 400000);
  set("max_force", 20000);
  set("force_factor", 240);
  set("max_mana", 20000);
  set("mana", 100000);
  set("mana_factor", 250);
  set_skill("unarmed", 450);
  set_skill("ice_fire_zhang", 460);
  set_skill("dodge", 450);
  set_skill("binfen-steps", 460);
  set_skill("parry", 450);
  set_skill("sword", 450);
  set_skill("spysword", 480);
  set_skill("force", 450);
  set_skill("butian-force", 450);
  set_skill("literate", 450);
  set_skill("spells", 450);
  set_skill("mysticism", 450);
  map_skill("spells", "mysticism");
  map_skill("force", "butian-force");
  map_skill("unarmed", "ice_fire_zhang");
  map_skill("sword", "spysword");
  map_skill("dodge", "binfen-steps");
  map_skill("parry", "ice_fire_zhang");
  set("chat_chance_combat", 75);
  set("chat_msg_combat", ({
    (: cast_spell, "shengsi" :),
    (: perform_action, "sword", "dao" :),
    (: perform_action, "sword", "name" :),
    (: perform_action, "sword", "bishou" :),
    (: perform_action, "unarmed", "lr" :),

  }));


  setup();
  carry_object("/d/obj/weapon/sword/qingfeng")->wield();
  carry_object("/d/obj/armor/jinjia")->wear();
}


void init() {
  add_action("do_none", "perform");
  add_action("do_none", "cast");
  add_action("do_none", "ji");
}
int do_none() {
  object me = this_object();
  message_vision("禁咒的世界，一切都是徒劳!\n", me);
  return 1;
}


void die() {

  object ob = query_temp("my_killer");

  if ((ob && ob->query("bieji1/jiu") == "done") && (ob && ob->query("bieji1/shi") != "done")) {
    ob->start_busy(3);
    message("chat", HIG + "【十面埋伏--中军】刘 邦(Liu bang):" + ob->name() +
      "如此张狂，帐下执金吾，取我护甲，孤御驾亲征.\n" NOR, users());
    ob->set("bieji1/shi", "done");
    ob->add("bieji1/number", 1);
    ob->add("daoxing", 10000);
    ob->save();
    tell_object(ob, "你赢得了十年道行");

  }
  message_vision(HIW "只见尸体的脸上露出了诡异的笑容！  \n" NOR, this_object());
  ::die();
}
