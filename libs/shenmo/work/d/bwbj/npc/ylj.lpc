#include <ansi.h>

inherit NPC;

void create()
{
  set_name("御林军", ({"yulin jun","bing"}));
  set("gender", "男性");
  set("age", 40);
  set("long","着装整齐的御林军，目露寒芒，眼藏杀机!\n");
  set("attitude", "aggressive");
  set("combat_exp", 5000000);
  set("daoxing", 5000000);
  
  set("no_nk_reward",1);

  set("per", 25);
  set_skill("parry", 280);
  set_skill("unarmed", 280);
  set_skill("dodge", 280);
  set_skill("blade", 280);
  set_skill("fork", 280);
  set_skill("gouhunshu", 300);
  set_skill("tonsillit", 300);
  set_skill("sword", 180);
  set_skill("stick", 180);
  set_skill("ghost-steps", 180);
  set_skill("hammer", 180);
  set_skill("rake", 180);
  set_skill("stick", 180);
  set_skill("staff", 180);
  set_skill("kusang-bang", 300);
map_skill("stick","kusang-bang");
map_skill("parry","jinghun-zhang");
map_skill("dodge","ghost-steps");
map_skill("force","tonsillit");
map_skill("spells","gouhunshu");
  set("max_sen",2400);
  set("max_gee",2400);
  set("max_gin",2400);
  set("force",2400);
  set("max_force",2400);
  set("max_mana",2400);
  set("force_factor",200);
  setup();
  carry_object("/d/koker/obj/baojia")->wear();
carry_object("/d/obj/weapon/stick/bintiegun")->wield();

}

void die ()
{
        object bing,me = this_object();
        object where = environment ();
        message_vision ("\n$N倒了下去，只剩下一堆骨架。\n",me);  
        
        if( where->query("short")==HIR "十面埋伏" NOR )
        {
                destruct(me);
                return;
        }
        bing = present("yulin jun 5",where);
        if( !bing )
        {
                message_vision ("\n御林军对天，振臂，高呼：我们是不死的！\n",me);   
                SDS_D->powerup(me);
                return;
        }
        else 
        {
                destruct(me);
                return;
        }
}

void unconcious ()
{
  die();
}

void kill_ob(object who)
{
        int i;
        object* inv;

        inv = all_inventory(who);

        for(i=0; i<sizeof(inv); i++) 
        {
                if( inv[i]->query_unique() ) {
        
                        message_vision("突然间，$n化一道白光飞去，无影无踪！\n",who,inv[i]);
                        destruct(inv[i]);
                }
        }
        ::kill_ob(who);
}

