// created by seawind
#include <ansi.h>

inherit NPC;

void create() {
  set_name("女 水 鬼", ({ "nv bing", "nvbing" }));
  set("gender", "女性");
  set("age", 20);
  set("long", "一只。。。。母老虎。。。女水鬼，穿着撩人的贴身水靠。\n");
  set("attitude", "aggressive");
  set("combat_exp", 3500000);
  set("daoxing", 3500000);

  set("no_nk_reward", 1);

  set("per", 25);
  set_skill("parry", 180);
  set_skill("unarmed", 180);
  set_skill("dodge", 180);
  set_skill("sword", 180);
  set_skill("fork", 180);
  set_skill("gouhunshu", 180);
  set_skill("tonsillit", 180);
  set_skill("sword", 180);
  set_skill("zhuihun-sword", 180);
  set_skill("ghost-steps", 180);
  set_skill("hammer", 180);
  set_skill("sword", 180);
  set_skill("stick", 180);
  set_skill("staff", 180);
  set_skill("jinghun-zhang", 180);
  map_skill("sword", "zhuihun-sword");
  map_skill("parry", "zhuihun-sword");
  map_skill("dodge", "ghost-steps");
  map_skill("force", "tonsillit");
  map_skill("spells", "gouhunshu");
  set("max_sen", 1400);
  set("max_gee", 1400);
  set("max_gin", 1400);
  set("force", 1400);
  set("max_force", 1400);
  set("max_mana", 1400);
  set("force_factor", 200);
  setup();
  carry_object("/d/bwbj/obj/shuikao")->wear();
  carry_object("/d/obj/weapon/sword/qingfeng")->wield();


}

void die() {
  object bing, me = this_object();
  object where = environment();
  message_vision("\n$N倒了下去，只剩下一堆骨架。\n", me);

  if (where->query("short") == HIW "汉水中央" NOR) {
    destruct(me);
    return;
  }
  bing = present("nv bing 5", where);
  if (!bing) {
    message_vision("\n水底下，又窜出一个黑衣美女！\n", me);
    SDS_D->powerup(me);
    return;
  } else {
    destruct(me);
    return;
  }
}

void unconcious() {
  die();
}

void kill_ob(object who) {
  int i;
  object *inv;

  inv = all_inventory(who);

  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->query_unique()) {

      message_vision("突然间，$n化一道白光飞去，无影无踪！\n", who, inv[i]);
      destruct(inv[i]);
    }
  }

  ::kill_ob(who);
}

void init() {
  int i;
  object me = this_object();
  object *ob = all_inventory(environment(me));
  for (i = 0; i < sizeof(ob); i++) {
    if (!living(ob[i]) || ob[i] == me || !userp(ob[i])) continue;
    kill_ob(ob[i]);
  }
  ::init();
}
