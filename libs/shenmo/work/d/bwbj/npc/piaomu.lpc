#include <ansi.h>
inherit NPC;
inherit F_MASTER; 
string ask_hanxin(object me);
 
void create()
{
          set_name("老妇人", ({ "old woman" }) );
        set("gender", "女性" );
        set("long","一个孤苦的老妇人，独自在河边浣洗衣裳。\n"NOR);
        set("age",50);
        set("attitude", "heroism");
        set("str",40);
        set("int",50);
        set("per",10);
        set("max_kee",4100);
        set("kee",4100);
        set("max_sen",3100);
        set("sen",3100);
        set("combat_exp",100000);
        set("daoxing",10000);
        set("force",400);
        set("max_force",400);
        set("mana",400);
        set("max_mana",400);
        set("force_factor", 0);
        set("mana_factor",0);
        set_skill("unarmed",100);
        set_skill("parry",100);
        set_skill("literate",200);
        set_skill("dodge",100);
        set_skill("force",100);
        set_skill("spells", 500);
        set("inquiry", ([
                "name" : "老身姓名，不足为道也！！",
                        ]) );
        set("inquiry", ([
                "韩信" : (: ask_hanxin :),
                "赠饭" : (: ask_hanxin :),
                ]) );
              setup();
        carry_object("/d/obj/cloth/skirt")->wear();
}

  string ask_hanxin(object me)
{
     return "哦，你是指当年我救的那个小伙子吧？听说他现在当元帅了！";
}

int accept_object(object me, object ob)
{  

   if (ob->query("money_id") && ob->value() >= 10000000) 
   {
      command("ah");
      tell_object(me,"这真是一笔意外之财，既然如此......\n");
      
    me->move("/d/bwbj/fight2");
      return 1;
    }
   command("smile");
   tell_object(me,"“如此，多谢你拉。”。\n");
   return 1;
}


