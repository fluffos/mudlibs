inherit NPC;

string say_position();
void create() {
  set_name("黄石公", ({ "huangshi gong", "huang", "gong" }));

  set("long", "一位寂寞，无依的老人。。\n");
  set("gender", "男性");
  set("age", 120);
  set("int", 25 + random(5));
  set("attitude", "peaceful");
  set("combat_exp", 280000);
  set("daoxing", 300000);


  set("rank_info/respect", "老人家");
  set("per", 30);
  set("max_kee", 1800);
  set("max_sen", 1500);
  set("force", 1800);
  set("max_force", 1600);
  set("force_factor", 120);
  set("max_mana", 1500);
  set("mana", 1400);
  set("mana_factor", 110);
  set_skill("literate", 570);
  set_skill("stealing", 570);
  set_skill("unarmed", 570);
  set_skill("dodge", 560);
  set_skill("force", 570);
  set_skill("parry", 570);
  set_skill("spells", 570);
  set_skill("huxiaoquan", 570);
  set_skill("huntianforce", 570);
  set_skill("zhaoyangbu", 570);
  map_skill("unarmed", "huxiaoquan");
  map_skill("force", "huntianforce");
  map_skill("dodge", "zhaoyangbu");
  set("inquiry", ([
    "鞋子": "老了，鞋子都穿不住了！\n",

    "效劳": (: say_position :),
  ]));

  setup();
  carry_object("/d/obj/cloth/baguapao")->wear();
}





string say_position() {
  object me = this_object();
  object who = this_player();

  if (me->is_fighting() || who->is_fighting())
    return ("我正在打架，打完再说。\n");

  if (me->query("got"))
    return ("已经有人去拣鞋子了！\n");
  me->set("got", 1);
  call_out("tell_position", 1, who);
  return "hmm";
}
void tell_position(object who) {
  if (!who || environment(who) != environment()) return;
  switch (random(8)) {
    case 0:
      command("say 恩，乖，快去帮爷爷拣鞋子！。");

      who->set_temp("heard_position", "桥1");
      break;
    case 1:

      command("say 恩，乖，快去帮爷爷拣鞋子！。");

      who->set_temp("heard_position", "桥2");
      break;
    case 2:

      command("say 恩，乖，快去帮爷爷拣鞋子！。");

      who->set_temp("heard_position", "桥3");
      break;
    case 3:
      command("say 恩，乖，快去帮爷爷拣鞋子！。");


      who->set_temp("heard_position", "桥4");
      break;
    case 4:

      command("say 恩，乖，快去帮爷爷拣鞋子！。");

      who->set_temp("heard_position", "桥5");
      break;
    case 5:
      command("say 恩，乖，快去帮爷爷拣鞋子！。");

      who->set_temp("heard_position", "桥6");
      break;
    case 6:
      command("say 恩，乖，快去帮爷爷拣鞋子！。");


      who->set_temp("heard_position", "桥7");
      break;
    case 7:
      command("say 恩，乖，快去帮爷爷拣鞋子！。");

      who->set_temp("heard_position", "桥8");
      break;
  }
}
