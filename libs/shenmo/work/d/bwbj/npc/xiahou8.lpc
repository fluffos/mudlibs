#include <ansi.h>;
inherit NPC;
#include "star.h"


void create()
{
        set_name("夏侯婴", ({ "xia hou", "xia" }) );
        set("gender", "男性" );
	set("long",
		"汉王帐下---夏侯婴\n"
	);
  set("str", 20);
  set("per", 130);
 set("age", 86);
  set("cor", 30);
  set("family/family_name","阎罗地府");
set("class","xian");
set("level",400);
  set("cps", 75);
  set("kar", 100);
  set("int", 40);
  set("con", 40);
  set("spi", 40);
  set("title", HIW"汉王帐下"NOR);
  set("combat_exp", 46000000);
  set("daoxing", 46000000);
  set("max_sen", 26000);
  set("max_kee", 26000);
  set("force", 6000); 
  set("max_force", 6000);
  set("force_factor", 40);
  set("max_mana", 6000);
  set("mana", 6000);
  set("mana_factor", 50);
	
     set_skill("unarmed", 350);
    set_skill("whip", 350);
    set_skill("hellfire-whip", 350);
    set_skill("dodge", 350);
     set_skill("parry", 350);
   set_skill("literate", 350);
   set_skill("spells", 200);
  set_skill("force", 350);
  set_skill("tonsillit", 350);
  set_skill("ghost-steps", 350);
     set_skill("gouhunshu", 350);
   set_skill("jinghun-zhang", 350);
  set_skill("kusang-bang", 350);
   set_skill("zhuihun-sword", 350);
   set_skill("sword", 350);
   set_skill("stick", 350);

  map_skill("force", "tonsillit");
  map_skill("unarmed", "jinghun-zhang");
  map_skill("dodge", "ghost-steps");
  map_skill("spells", "gouhunshu");
  map_skill("parry", "hellfire-whip");
  map_skill("whip", "hellfire-whip");
   map_skill("sword", "zhuihun-sword");
        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: perform_action, "whip","five" :),
                (: perform_action, "whip","biluo" :),
                (: exert_function, "recover" :),
                (: cast_spell, "curse" :),
                (: cast_spell, "inferno" :),
                (: perform_action, "unarmed","zhua" :),
        }) );

	setup();
   carry_object("/d/obj/weapon/whip/longsuo")->wield();
   carry_object("/d/obj/armor/jinjia")->wear();
}


void init()
{
        add_action("do_none","perform");
        add_action("do_none","cast");
        add_action("do_none","ji");
}
int do_none()
{
        object me = this_object();
        message_vision("禁咒的世界，一切都是徒劳!\n",me);
        return 1;
} 

void die()
{

        object ob = query_temp("my_killer");

        if((ob&&ob->query("bieji1/qi")=="done") && (ob&&ob->query("bieji1/ba")!="done"))
        {
        ob->start_busy(3);
        message("chat",HIY+"【十面埋伏】刘 邦(liu bang):"+ob->name()+
        "擒我大将，众军听令，烧狼烟，起烽火，韩信，速速拿下此贼！\n"NOR,users());
        ob->set("bieji1/ba","done");
        ob->add("bieji1/number",1);
         ob->add("daoxing", 10000);
           ob->save();
         tell_object(ob,"你赢得了十年道行");

        }
   message_vision(HIW"只见尸体的脸上露出了诡异的笑容！ \n"NOR,this_object() );
       ::die();
}

