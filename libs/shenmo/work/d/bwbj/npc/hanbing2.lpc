// created by seawind
#include <ansi.h>

inherit NPC;

void create() {
  set_name("汉 兵", ({ "han bing", "bing" }));
  set("gender", "男性");
  set("age", 40);
  set("long", "一个威风凛凛的汉兵。巡逻在楚河汉界之间!\n");
  set("attitude", "aggressive");
  set("combat_exp", 4000000);
  set("daoxing", 4000000);

  set("no_nk_reward", 1);

  set("per", 25);
  set_skill("parry", 280);
  set_skill("unarmed", 280);
  set_skill("dodge", 280);
  set_skill("blade", 280);
  set_skill("fork", 280);
  set_skill("gouhunshu", 280);
  set_skill("tonsillit", 280);
  set_skill("sword", 280);
  set_skill("whip", 280);
  set_skill("ghost-steps", 280);
  set_skill("hammer", 280);
  set_skill("rake", 280);
  set_skill("stick", 280);
  set_skill("staff", 280);
  set_skill("jinghun-zhang", 280);
  map_skill("unarmed", "jinghun-zhang");
  map_skill("parry", "jinghun-zhang");
  map_skill("dodge", "ghost-steps");
  map_skill("force", "tonsillit");
  map_skill("spells", "gouhunshu");
  set("max_sen", 2400);
  set("max_gee", 2400);
  set("max_gin", 2400);
  set("force", 2400);
  set("max_force", 2400);
  set("max_mana", 2400);
  set("force_factor", 300);
  setup();
  carry_object("/d/koker/obj/baojia")->wear();
}

void die() {
  object bing, me = this_object();
  object where = environment();
  message_vision("\n$N倒了下去，只剩下一堆骨架。\n", me);

  if (where->query("short") == HIR "十面埋伏" NOR) {
    destruct(me);
    return;
  }
  bing = present("han bing 2", where);
  if (!bing) {
    message_vision("\n突然，白骨重新站立了起来！汉兵又复活了！\n", me);
    SDS_D->powerup(me);
    return;
  } else {
    destruct(me);
    return;
  }
}
