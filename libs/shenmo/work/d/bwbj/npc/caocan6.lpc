// by seawind

#include <ansi.h>;
inherit NPC;
#include "star.h"


void create() {
  set_name("曹参", ({ "cao can", "cao", "shen" }));
  set("gender", "男性");
  set("long",
    "监 狱 官---曹参\n"
  );
  set("str", 20);
  set("per", 130);
  set("age", 86);
  set("cor", 30);
  set("cps", 75);
  set("kar", 100);
  set("int", 40);
  set("con", 40);
  set("spi", 40);
  set("title", HIM "监 狱 官" NOR);
  set("combat_exp", 40000000);
  set("daoxing", 40000000);
  set("max_sen", 26000);
  set("max_kee", 26000);
  set("force", 16000);
  set("max_force", 6000);
  set("force_factor", 140);
  set("family/family_name", "格斗家");
  set("class", "saint");
  set("level", 350);
  set("max_mana", 6000);
  set("mana", 6000);
  set("mana_factor", 150);

  set_skill("unarmed", 350);
  set_skill("dodge", 350);
  set_skill("parry", 350);
  set_skill("spells", 350);
  set_skill("dodge", 350);
  set_skill("force", 350);
  set_skill("literate", 350);
  set_skill("power", 350);
  set_skill("spirit-power", 350);
  set_skill("rukong-zhao", 350);
  set_skill("wushen-steps", 350);
  set_skill("yuanwu-kungfu", 350);

  map_skill("spells", "spirit-power");
  map_skill("unarmed", "rukong-zhao");
  map_skill("force", "power");
  map_skill("parry", "qixi-sword");
  map_skill("dodge", "wushen-steps");
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: cast_spell, "feixian" :),
    (: perform_action, "unarmed", "pu" :),
    (: perform_action, "unarmed", "gun" :),

  }));


  setup();

  carry_object("/d/obj/armor/jinjia")->wear();
}


void init() {
  add_action("do_none", "perform");
  add_action("do_none", "cast");
  add_action("do_none", "ji");
}
int do_none() {
  object me = this_object();
  message_vision("禁咒的世界，一切都是徒劳!\n", me);
  return 1;
}


void die() {

  object ob = query_temp("my_killer");

  if ((ob && ob->query("bieji1/wu") == "done") && (ob && ob->query("bieji1/liu") != "done")) {
    ob->start_busy(3);
    message("chat", HIG + "【十面埋伏】刘 邦(Liu bang):" + ob->name() +
      "败我曹参，有斩其首级者，赏黄金万两，官封万户！\n" NOR, users());
    ob->set("bieji1/liu", "done");
    ob->add("bieji1/number", 1);
    ob->add("daoxing", 10000);
    ob->save();
    tell_object(ob, "你赢得了十年道行");

  }
  message_vision(HIY "$N的尸体上露出诡异的笑容....\n" NOR, this_object());
  ::die();
}
