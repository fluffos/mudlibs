// created by seawind
#include <ansi.h>

inherit NPC;

void create()
{
  set_name("执金吾", ({"zhijin wu","guard"}));
  set("gender", "男性");
  set("age", 40);
  set("long","身披重甲的执金吾,忠心耿耿的护卫在汉王的四周!\n");
  set("attitude", "aggressive");
  set("combat_exp", 6000000);
  set("daoxing", 6000000);
  
  set("no_nk_reward",1);

  set("per", 25);
  set_skill("parry", 380);
  set_skill("unarmed", 380);
  set_skill("dodge", 380);
  set_skill("blade", 380);
  set_skill("fork", 380);
  set_skill("gouhunshu", 380);
  set_skill("tonsillit", 380);
  set_skill("sword", 380);
  set_skill("whip", 380);
  set_skill("ghost-steps", 380);
  set_skill("hammer", 380);
  set_skill("rake", 380);
  set_skill("stick", 380);
  set_skill("staff", 380);
  set_skill("jinghun-zhang", 380);
map_skill("unarmed","jinghun-zhang");
map_skill("parry","jinghun-zhang");
map_skill("dodge","ghost-steps");
map_skill("force","tonsillit");
map_skill("spells","gouhunshu");
  set("max_sen",3400);
  set("max_gee",3400);
  set("max_gin",3400);
  set("force",3400);
  set("max_force",3400);
  set("max_mana",3400);
  set("force_factor",200);
  setup();
  carry_object("/d/koker/obj/baojia")->wear();
}

void die ()
{
  object me = this_object();
  object where = environment (me);
  object bone = present ("bone 4",where);

  if (! bone)
  {
    bone = new ("/d/bwbj/obj/bone");
    bone->move(where);
  }

  message_vision ("\n$N倒了下去，只剩下一堆骨架。\n",me);  
  if (! present("zhijin wu 8",where) &&
      where->query("short")==HIR "十面埋伏-中军" NOR)
  {
    object ob = new ("/u/seawind/npc/zjw");
    ob->move(where);
    message_vision ("\n执金吾吐出一腔碧血，摇摇晃晃的站了起来！\n",me);   
  }
  destruct (me);  
}

void unconcious ()
{
  die();
}
void kill_ob(object who)
{
  int i;
  object* inv;

	inv = all_inventory(who);

	for(i=0; i<sizeof(inv); i++) 
	{
		if( inv[i]->query_unique() ) {
	
			message_vision("突然间，$n化一道白光飞去，无影无踪！\n",who,inv[i]);
			destruct(inv[i]);
		}
	}

	::kill_ob(who);
}

void init()
{
int i;
object me = this_object();
object *ob = all_inventory(environment(me));
for(i=0; i<sizeof(ob); i++) 
	{
	if( !living(ob[i]) || ob[i]==me || !userp(ob[i]) ) continue;
	kill_ob(ob[i]);
        }
::init();
}


