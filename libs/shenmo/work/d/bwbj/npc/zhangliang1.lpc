// by seawind

#include <ansi.h>;
inherit NPC;
#include "star.h"

void create() {
  set_name("张 良", ({ "zhang liang", "zhangliang", "zhang" }));
  set("gender", "男性");
  set("long",
    "相传张良辅助汉王刘邦夺得大汉天下后，为镇住乌江项羽所遗地狱雷刀，
不牺放弃荣华富贵，舍弃前世修行，以一股精神气，携雷刀入血池佛海，以炼狱巨锁困刀！\n"
  );
  set("str", 20);
  set("per", 130);
  set("age", 150);
  set("cor", 30);
  set("cps", 75);
  set("kar", 100);
  set("int", 40);
  set("con", 40);
  set("spi", 40);
  set("title", WHT "幽冥鬼气" NOR);
  set("class", "xian");
  set("family/family_name", "五庄观");
  set("level", 250);
  set("combat_exp", 15000000);
  set("daoxing", 12000000);
  set("max_sen", 6000);
  set("max_kee", 6000);
  set("force", 6000);
  set("max_force", 6000);
  set("force_factor", 100);
  set("max_mana", 12000);
  set("mana", 6000);
  set("mana_factor", 400);

  set_skill("unarmed", 350);
  set_skill("wuxing-quan", 350);
  set_skill("dodge", 350);
  set_skill("baguazhen", 360);
  set_skill("parry", 350);
  set_skill("sword", 350);
  set_skill("sanqing-jian", 350);
  set_skill("staff", 350);
  set_skill("fumo-zhang", 350);
  set_skill("hammer", 350);
  set_skill("kaishan-chui", 350);
  set_skill("blade", 350);
  set_skill("yange-blade", 350);
  set_skill("force", 350);
  set_skill("zhenyuan-force", 350);
  set_skill("literate", 350);
  set_skill("spells", 350);
  set_skill("taiyi", 450);
  map_skill("spells", "taiyi");
  map_skill("force", "zhenyuan-force");
  map_skill("unarmed", "wuxing-quan");
  map_skill("sword", "sanqing-jian");
  map_skill("dodge", "baguazhen");
  map_skill("staff", "fumo-zhang");
  map_skill("blade", "yange-blade");
  map_skill("hammer", "kaishan-chui");
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: cast_spell, "zhenhuo" :),
    (: perform_action, "sword", "sanqing" :),
    (: perform_action, "sword", "jianmang" :),
    (: exert_function, "recover" :),
    (: exert_function, "heal" :),
  }));
  setup();
  carry_object("/d/lingtai/obj/sword")->wield();
  carry_object("/d/obj/armor/jinjia")->wear();
}


void init() {
  add_action("do_none", "perform");
  add_action("do_none", "cast");
  add_action("do_none", "ji");
  add_action("do_none", "fight");
}
int do_none() {
  object me = this_object();
  message_vision("禁咒的世界，一切都是徒劳!\n", me);
  return 1;
}


void die() {

  object ob = query_temp("my_killer");

  if (ob && ob->query("bieji1/yi") != "done")

  {
    ob->start_busy(3);
    message("chat", HIR + "【血池佛海】项羽(Xiang yu):" + ob->name() +
      "血吾之耻，九幽取刀，大楚天下，指日可待。虞，你却在何方？\n" NOR, users());
    ob->set("bieji1/yi", "done");
    ob->add("bieji1/number", 1);
    ob->add("daoxing", 10000);
    ob->save();
    tell_object(ob, "你赢得了十年道行");

  }
  message_vision(HIW "只见尸体的脸上露出了诡异的笑容！ \n" NOR, this_object());
  ::die();
}
