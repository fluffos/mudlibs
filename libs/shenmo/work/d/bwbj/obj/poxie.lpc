// by seawind


#include <armor.h>
inherit BOOTS;

void create()
{
  set_name("怪老头的鞋子", ({ "po xie", "old man shoes" }) );
  set_weight(2700);
  if( clonep() )
    set_default_object(__FILE__);
  else {
    set("long", "一只脏兮兮的鞋子．\n");
    set("unit", "只");
    set("value", 1000);
    set("material", "cloth");
    set("armor_prop/armor", 15);
    set("armor_prop/dodge", 30);
  }
  setup();
}

