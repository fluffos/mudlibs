#include <armor.h>
#include <ansi.h>

inherit HEAD;
//#include "chk_owner.lpc"

void create() {
  set_name(HIW "百花巾" NOR, ({ "baihua jin" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("no_sell", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_get", 1);
    set("value", 10);
    set("material", "diamon");
    set("armor_prop/armor", 20);
  }
  setup();
}
int query_autoload() { return 1; }
