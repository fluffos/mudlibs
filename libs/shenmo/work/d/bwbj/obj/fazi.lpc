// fazi.c


#include <ansi.h>


inherit ITEM;


int do_make(string);


void create() {
  set_name("竹筏子", ({ "zhufa" }));
  set("long", "看起来不是很安全但是比较适用的竹筏。你可以试着坐（zuo)上去！\n");
  set("unit", "条");
  set("no_sell", 1); set_weight(400000);

}



void init() {
  add_action("do_zuo", "zuo");
}


int do_zuo(string arg) {
  object me = this_player();

  if (!id(arg)) return notify_fail("你要坐什么？\n");

  message_vision("兴奋的打了个呼哨，跳上了竹筏！\n", me); me->move("/d/bwbj/fight4");


  destruct(this_object());
  return 1;

}
