#include <ansi.h>
#include <room.h>

inherit ROOM;

void create ()
{
  set ("short", HIW "汉水中央" NOR);   
  set ("long", @LONG   
你费力的摇着竹筏子，嘴里不停的诅咒着，半死不活的撑到了江心。突然。。。。
LONG);

    set("exits", ([ 
              "north" : __DIR__"xpq1",
             //  "south" : __DIR__"fight3",
                 ]));
    set("objects",([
                    __DIR__"npc/nb" : 4,
                    __DIR__"npc/lvhou4" : 1,
                 ]));
    setup();
}
void init()
{ object ob;
 if( interactive( ob = this_player()))
 call_out("blowing", random(30) + 1, ob);
}
int blowing(object ob)
{
 int i;
 int damage;
        if(  ob && environment(ob) == this_object())
{
 tell_object(this_object(), HIC "\n\n一阵大浪卷来，河面上仿佛多了些什么。\n\n" NOR);
 ob->start_busy(3);
 if( environment(ob) == this_object())
 call_out("blowing",random(30)+1, ob);
}
 else
 return 1;
}
void reset()
{
 ::reset();
        remove_call_out("blowing");
}
int valid_leave(object me,string dir) 
{ 
        object man; 
        if (dir=="home" || !man=present("lv hou",environment(me)) ) 
          return ::valid_leave(me,dir); 
        if (!living(man)) return ::valid_leave(me,dir); 
        if (!me->query_temp("passed")) return notify_fail("吕后几声娇笑：既然到了这里，又何必急着要走???\n"); 
        return ::valid_leave(me,dir); 
        
      } 
