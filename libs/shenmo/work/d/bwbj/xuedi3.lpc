inherit ROOM;

void create() {
  set("short", "十面埋伏--雪阵");
  set("long", @LONG
时值冬至，垓下郊外一片萧瑟，茫茫的大雪，悄悄的飘落大地，厚厚的
积雪踩起来发出咯吱的响声，大地上留下一串串孤独的脚印。寒冷的北风呼
啸而过，吹得脸生痛。暗淡的太阳低悬在天边，显得那么苍白。
LONG);
  set("exits", ([
    "east": __DIR__ "fight6",
    "south": __DIR__ "xuedi2",
  ]));
  set("no_clean_up", 0);
  setup();
  //	replace_program(ROOM);
}
int valid_leave(object me, string dir) {
  me->receive_damage("kee", 700);
  me->receive_wound("kee", 700);
  tell_object(me, "一股刺骨的寒风吹过，你只觉得浑身的血液都快被冻住了！\n");
  return 1;
}
