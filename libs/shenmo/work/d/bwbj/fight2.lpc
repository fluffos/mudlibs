#include <ansi.h>
#include <room.h>

inherit ROOM;

void create() {
  set("short", HIW "鸿门宴" NOR);
  set("long", @LONG   
  恍惚之间，你突然发现自己置身于一个豪华的宴席之中，无数的目光望着你，一个黑袍将军
正目中无人的吃肉，吃下大块大块的生牛肉！
LONG);

  set("exits", ([
    "east": __DIR__ "hmy",
    //"south" : __DIR__"fight0",
  ]));
  set("objects", ([ __DIR__ "npc/huwei": 4,
    __DIR__ "npc/fankuai": 1 ]));
  setup();
}
void init() {
  object ob;
  if (interactive(ob = this_player()))
    call_out("blowing", random(10) + 1, ob);
}
int blowing(object ob) {
  int i;
  int damage;
  if (ob && environment(ob) == this_object()) {
    tell_object(this_object(), HIC "\n\n黑袍将军大吼一声，你觉得耳鼓都要震破了！\n\n" NOR);
    ob->receive_damage("kee", random(100) + 100);
    ob->receive_damage("sen", random(100) + 100);
    COMBAT_D->report_sen_status(ob);
    if (environment(ob) == this_object())
      call_out("blowing", random(20) + 1, ob);
  } else
    return 1;
}
void reset() {
  ::reset();
  remove_call_out("blowing");
}
int valid_leave(object me, string dir) {
  object man;
  if (dir == "south" || !man = present("fan kuai", environment(me)))
    return ::valid_leave(me, dir);
  if (!living(man)) return ::valid_leave(me, dir);
  if (!me->query_temp("passed")) return notify_fail("樊哙大喝一声：来将通名!!!\n");
  return ::valid_leave(me, dir);

}
