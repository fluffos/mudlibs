// by seawind

inherit ROOM;

void create ()
{
  set ("short", "锁刀血池");
  set ("long", @LONG

七条巨锁缠住了一把颇具灵性的紫刀。快震断(break)巨锁吧！

LONG);

  set("exits", ([
      ]));
  set("outdoors",__DIR__"");
  setup();
}

void init ()
{
  add_action ("do_break","break");
}

int do_break (string arg)
{
object fanzeng;
  object who = this_player();

  if (! arg || (arg!= "suo" && arg!= "suolian"))
    return notify_fail ("你要砸什么？\n");

  message_vision ("$N憋红了脸大喝一声向锁链砸去！\n",who);
  message_vision ("\n锁链一阵抖动，$N内力不继，晕了过去！\n",who);
  who->unconcious();    
  if (who->query("combat_exp") < 1000000 ||
      random(5))
  {
    return 1;
  }
  if (present("fanzeng",this_object()))
    return 1;
fanzeng = new (__DIR__"npc/fanzeng");
// this_object()->move("/d/bwbj/end3"); 
  fanzeng->move(this_object());
  fanzeng->command_function("sigh3");
  return 1;
}
