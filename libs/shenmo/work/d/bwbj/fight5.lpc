#include <ansi.h>
#include <room.h>

inherit ROOM;

void create ()
{
  set ("short", HIR "十面埋伏" NOR);   
set ("long", @LONG   四面八方的士兵如潮水样涌来，你已经退无可退了。。。
。
LONG);

    set("exits", ([ 
              "north" : __DIR__"xuedi1",
//"south" : __DIR__"fight4",
                 ]));
    set("objects",([
                    __DIR__"npc/tz" : 5,
                   // __DIR__"npc/ma" : 5,
                    __DIR__"npc/chenping5" : 1,
                 ]));
    setup();
}
void init()
{ object ob;
 if( interactive( ob = this_player()))
 call_out("blowing", random(30) + 1, ob);
}
int blowing(object ob)
{
 int i;
 int damage;
        if(  ob && environment(ob) == this_object())
{
 tell_object(this_object(), HIR "\n\n十面埋伏果真是处处杀机！\n\n" NOR);
 ob->start_busy(2);
 if( environment(ob) == this_object())
 call_out("blowing",random(30)+1, ob);
}
 else
 return 1;
}
void reset()
{
 ::reset();
        remove_call_out("blowing");
}


int valid_leave(object me,string dir) 
{ 
        object man; 
        if (dir=="home" || !man=present("chen ping",environment(me)) ) 
          return ::valid_leave(me,dir); 
        if (!living(man)) return ::valid_leave(me,dir); 
        if (!me->query_temp("passed")) return notify_fail("陈平笑到：竖子无知，何以至此!!!\n"); 
        return ::valid_leave(me,dir); 
        
      } 
