//by seawind
inherit ROOM;

void create ()
{
  set ("short", "楚军大营");
  set ("long", @LONG

偌大的楚军大营现在似乎空无一人，远远的飘来一阵阵若有若无的楚歌声，
乌骓蓦地扎住四蹄，你一纵身，飘下马来，纵声长啸：夫人，你在哪??

LONG);
  set("item_desc", ([ /* sizeof() == 1 */
  "hole" : "一个刀孔。\n",
]));



  set("exits", ([ /* sizeof() == 1 */
"south" : __DIR__"fight11",
]));
//  
  setup();
}
void init()
{
	add_action("do_bury", "bury");
}
int do_bury(string arg)
{
        object mishi, ob, me;
	me=this_player();

	if( !arg)
		return notify_fail("你想干什么？\n");

        if( !arg || arg!="diyu leidao" || !(ob=present(arg, me))) 
		return notify_fail("你到底想干什么?\n");


        if( !(mishi = find_object(__DIR__"fightend")) )
                mishi = load_object(__DIR__"fightend");

        if( mishi = find_object(__DIR__"fightend") ) 
        {
                set("exits/enter", __DIR__"fightend");
                message_vision("雷刀忽然脱鞘飞出，发出一声长鸣，与此同时，你听到一个小小营帐里头传来一声嘤咛。\n", me, ob);
                message("vision", "有人从外头走了进来。。\n", mishi );
		mishi->set("exits/out", __DIR__"fight11");
		destruct(ob);
        call_out("close_down", 5);
	}
	return 1;
}

void close_down()
{
        object mishi;

        message("vision", "营门被轻轻的掩上了。\n", this_object() );
        if( mishi= find_object(__DIR__"")) {
        message("vision", "少女轻轻的掩上了营门。\n", mishi);
        mishi->delete("exits/out");
        }

        delete("exits/enter");

}




