//by seawind

inherit ROOM;

void create() {
  set("short", "松树林");
  set("long", @LONG
苍苍的林木，无边无涯，你渐渐的迷失了方向。
LONG);
  set("exits", ([
    "east": __DIR__ "shulin8",
    "south": __DIR__ "shulin" + (random(10) + 2),
    "west": __DIR__ "shulin" + (random(10) + 2),
    "north": __DIR__ "shulin6",
  ]));
  set("no_clean_up", 0);
  set("objects", ([
    __DIR__ "npc/hanbing2": 3
  ]));
  setup();
  replace_program(ROOM);
}
