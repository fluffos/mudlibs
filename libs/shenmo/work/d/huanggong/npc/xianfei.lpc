//Snowtu@tsrj 2006
#include <ansi.h>
inherit NPC;

void create() {
  set_name("徐贤妃", ({ "xu xianfei", "xu", "fei" }));
  set("long", "贤妃名徐惠，是太宗最为宠爱的一位妃子。生五月能言，\n四岁通《论语》、《诗经》，八岁自晓属文。此刻她正独\n自在御花园散步。\n");
  set("gender", "女性");
  set("rank_info/respect", "娘娘千岁");
  set("rank_info/self", "哀家");
  set("age", 20);
  set("attitude", "peaceful");
  set("per", 40);
  set("int", 40);
  setup();
  carry_object("/d/obj/cloth/mangpao")->wear();
}

void kill_ob(object who) {
  say(name() + "把眼一瞪，道：大胆！\n");
  all_inventory(environment())->remove_killer(this_object());
  remove_all_killer();
  return;
}

void init() {
  object who = this_player();
  if (!who || !userp(who))
    return;
  remove_call_out("test_player");
  call_out("test_player", 1, this_player());
  if (who->query("quest/colors"))
    who->start_busy(2);
}

string *strs = ({
  "$N对$n惊叹道：", "$N对$n赞赏道：",
  "$N微笑着对$n说道：", "$N赞许地对$n说道：",
});

void test_player(object who) {
  object me = this_object();
  object where = environment(me);
  object item;
  string str, arg;
  int count, times, color;
  int i, j, k;
  mapping colors;

  remove_call_out("test_player");

  if (!who || !userp(who))
    return;
  colors = who->query("quest/colors");
  color = sizeof(colors);
  if (who->query("quest/colors"))
    message_vision(
      "\n一到御花园，$N身上涌起淡淡的" + (color > 2 ? chinese_number(color) + "彩" : "") + "祥云。\n",
      who
    );
  if (color == 7 || wizardp(who)) {
    message_vision(
      strs[random(sizeof(strs))] + RANK_D->query_respect(who) + "七彩祥云缭绕，面生瑞气，哀家自然有赏御赐与你！\n",
      me,
      who
    );
    message_vision("\n$N走上前，赶紧在$n的殿前俯身跪下。\n", who, me);
    who->start_busy(3);
    who->delete("quest/colors");
    if (random(10)) item = new("/d/obj/liwu/renshen-guo");
    else if (!random(3)) item = new("/d/obj/drug/huozao");
    else if (random(2)) item = new("/d/obj/drug/biou");
    else item = new("/d/obj/drug/jiaoli");
    if (item && item->move(who))
      arg = HIC "【" HIG "众生界" HIC "】" NOR;
    arg += sprintf(HIC "%s" HIC "：%s(%s)" HIC "坚持不懈解迷，七彩祥云缭绕，哀家有旨赐：%s" HIC "一枚！\n" NOR,
      query("name"),
      who->query("name"), capitalize(who->query("id")),
      HIC + SDS_D->no_color_msg(item->name()) + NOR,);
  }
  message("channel:rumor", arg, users());
  remove_call_out("reward_player");
  call_out("reward_player", 2, me, who);
}

void reward_player(object me, object who) {
  if (!who || !userp(who))
    return;
  message_vision("\n$N连忙俯身一拜，小心翼翼地站起来。\n", who, me);
}
