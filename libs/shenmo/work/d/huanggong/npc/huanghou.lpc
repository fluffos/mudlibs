#include <ansi.h>
#include "auth.lpc"
inherit NPC;

void create() {
  set_name("长孙皇后", ({ "huang hou", "hou", "zhang sun" }));
  set("long", "长孙无忌之妹，虽贵为皇后，然生性节俭，所用的一切物品，都以够用为限，从不铺张。\n");
  set("gender", "女性");
  set("rank_info/respect", "皇后殿下");
  set("rank_info/self", "哀家");
  set("age", 40);
  set("attitude", "peaceful");
  set("per", 40);
  set("int", 40);
  setup();
  carry_object("/d/obj/cloth/mangpao")->wear();
}

void kill_ob(object who) {
  say(name() + "把眼一瞪，道：大胆！\n");
  all_inventory(environment())->remove_killer(this_object());
  remove_all_killer();
  return;
}

void init() {
  object who = this_player();
  if (!who || !userp(who))
    return;
  add_action("do_huifu", "vf");
  add_action("do_huifu", "VF");
  add_action("do_huifu", "Vf");
  add_action("do_huifu", "vF");
  remove_call_out("test_player");
  call_out("test_player", 1, this_player());
  if (who->query("quest/colors"))
    who->start_busy(2);
}

string *strs = ({
  "$N对$n惊叹道：", "$N对$n赞赏道：",
  "$N微笑着对$n说道：", "$N赞许地对$n说道：",
});

void test_player(object who) {
  object me = this_object();
  object where = environment(me);
  object item;
  string str, arg;
  int count, times, color;
  int i, j, k;
  mapping colors;

  remove_call_out("test_player");

  if (!who || !userp(who))
    return;
  colors = who->query("quest/colors");
  color = sizeof(colors);
  if (who->query("quest/colors"))
    message_vision(
      "\n一进鸾凤殿，$N身上涌起淡淡的" + (color > 2 ? chinese_number(color) + "彩" : "") + "祥云。\n",
      who
    );
  if (color == 7 || wizardp(who)) {
    /*                       if (!who->query_temp("quest/vf/valid")) 
        	  	{
                       confirm_again(who);
                       return 0;
}
else
	{
               who->delete_temp("quest/vf/valid"); */
    message_vision(
      strs[random(sizeof(strs))] + RANK_D->query_respect(who) + "七彩祥云缭绕，面生瑞气，哀家自然有赏御赐与你！\n",
      me,
      who
    );
    message_vision("\n$N走上前，赶紧在$n的殿前俯身跪下。\n", who, me);
    who->start_busy(3);
    times = who->query("quest/number");
    if (times > 10000) times = 10000;
    count = times % 30;
    i = 10000 + times * 3 + 250 * (count + 1);
    //        i = i/2;
    j = i + random(2000) - random(2000);
    k = i / 5;
    who->add("daoxing", j);
    who->add("combat_exp", i);
    who->add("potential", k);
    who->add("balance", 100 * i + 100 * j);
    who->add("weiwang", 10);
    who->add("shen", 30);
    who->delete("quest/colors");
    arg = HIC "【" HIG "众生界" HIC "】" NOR;
    arg += sprintf(HIC "%s" HIC "：%s(%s)" HIC "坚持不懈解迷，七彩祥云缭绕，哀家有旨赐：%s道行\n,%s点武学,%s点潜能及%s" HIC "！\n" NOR,
      query("name"),
      who->query("name"), capitalize(who->query("id")),
      COMBAT_D->chinese_daoxing(j),
      chinese_number(i),
      chinese_number(k),
      HIC + SDS_D->no_color_msg(MONEY_D->money_str(100 * i + 100 * j)) + NOR,
    );
    if (random(6) > 2 || wizardp(who)) {
      if (random(1000)) {
        if (random(1800)) {
          if (random(300) && !wizardp(who)) item = new("/d/nanhai/obj/lianhua/hebing");
          else {
            switch (random(600)) {
              case 0: item = new("/d/nanhai/obj/lianhua/lhshenji"); break;
              case 1: item = new("/d/nanhai/obj/lianhua/lhshenjim"); break;
              case 2: item = new("/d/nanhai/obj/lianhua/lhshenjil"); break;
              case 3: item = new("/d/nanhai/obj/lianhua/lhconvert"); break;
              case 4: item = new("/d/quest/zudui/obj/key"); break;

              default: item = new("/obj/money/jinbi"); break;
            }
          }
        } else item = new("/d/nanhai/obj/lianhua/hebingl");
      } else item = new("/d/nanhai/obj/lianhua/shengji");
      //                item->set("owner",who->query("id"));
      str = item->short();
      if (item && item->move(who))
        arg += HIC "【" HIG "众生界" HIC "】" NOR;
      arg += sprintf(HIC "%s" HIC "：%s(%s)" HIC "坚持不懈解迷，七彩祥云缭绕，哀家有旨赐：%s" HIC "一块！\n" NOR,
        query("name"),
        who->query("name"), capitalize(who->query("id")),
        HIC + SDS_D->no_color_msg(str) + NOR,);
    }
    message("channel:rumor", arg, users());
    remove_call_out("reward_player");
    call_out("reward_player", 2, me, who);
  }
  //      }
}

void reward_player(object me, object who) {
  if (!who || !userp(who))
    return;
  message_vision("\n$N连忙俯身一拜，小心翼翼地站起来。\n", who, me);
}

