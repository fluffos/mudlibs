void setname()
{
object ob = this_player();  
        int i;
        string name;
        i=random(sizeof(names));
        name=names[i]+(random(2)?"女":"妃");
        
set_name(name, ({ob->query("id") + " hua xian"})); 
}

void create()
{        
setname();
set("age", 100+random(80));
set("gender", "女性");
set("class", "xian");
set("family/family_name", "月宫");
set("attitude", "friendly");
set("per", 40);
set("str", 100);
set("cor", 40);
set("con", 40);
set("int", 40);
set("spi", 40);
set("cps", 40);
set("kar", 40);
set("max_gin", 1000);
set("food", 10000);
set("water", 10000);
set_weight(30000);
set("no_steal",1);
set("taskguai",11);
set("chat_chance", 5);
set("chat_msg", ({
        (: random_move :)
}) );
setup();
carry_object("/d/city/npc/obj/sword")->wield();
carry_object("/d/city/npc/obj/armor")->wear();
carry_object("/d/city/npc/obj/cloth")->wear();
carry_object("/d/city/npc/obj/pifeng")->wear();
carry_object("/d/city/npc/obj/shoes")->wear();
carry_object("/d/city/npc/obj/kui")->wear();
}

void copy_status(object me, int level)
{
mapping me_skill;
int *skill_value, max_value, i;
        
me_skill = me->query_skills();
i=sizeof(me_skill);
if(i>0) 
        {
        skill_value=values(me_skill);
        max_value=skill_value[0];
        while(i--) { // 找出玩家skill最大值
                if(skill_value[i]>max_value)
                        max_value=skill_value[i];
                }
        } 
else    max_value=1;
set("stay_time",time()+900+random(600));            
set_skills(max_value, level);
set_hp_status(me,level);
}         
          
void set_skills(int max_value, int level)
{
object guai=this_object();       
int guai_value;
        
if (level==1) guai_value = max_value+max_value/8;
else if (level==2) guai_value = max_value+max_value/6;
else guai_value = max_value+max_value/4;
        
set_skill("unarmed", guai_value+random(16));
set_skill("dodge", guai_value+random(16));
set_skill("parry", guai_value+random(16));
set_skill("force", guai_value+random(16));
set_skill("spells", guai_value+20+random(16));
set_skill("literate", guai_value+20+random(16));
       
set_skill("moonshentong", guai_value+20+random(16));
set_skill("baihua-zhang", guai_value+20+random(16));
set_skill("moonforce", guai_value+20+random(16));
set_skill("snowsword", guai_value+20+random(16));
set_skill("moondance", guai_value+20+random(16));

map_skill("spells", "moonshentong");
map_skill("unarmed", "baihua-zhang");
map_skill("force", "moonforce");
map_skill("sword", "snowsword");
map_skill("parry", "snowsword");
map_skill("dodge", "moondance");

set("chat_chance_combat", 100);
set("chat_msg_combat", ({
                (: cast_spell, "mihun" :),
}) );
}       

void set_hp_status(object me, int level)
{       
int max_kee,max_sen,skill_force,maximum_mana,exp,daoxing;
max_kee = me->query("max_kee");
max_sen = me->query("max_sen");
skill_force = query_skill("force");
maximum_mana = me->query("maximum_mana");
exp = me->query("combat_exp");
daoxing = me->query("daoxing");
        
set("max_force", skill_force*10);
set("force", skill_force*20);
set("force_factor", skill_force/10);
set("mana_factor", query_skill("spells",1)/10);
        
if (exp < 8000000)
        {
        set("max_kee", max_kee*10);
        set("eff_kee", max_kee*10);
        set("max_sen", max_sen*10);
        set("eff_sen", max_sen*10);
        set("kee", max_kee*10);
        set("sen", max_sen*10);
        set("max_mana", maximum_mana);
        set("mana",maximum_mana*2);
        set("combat_exp", exp+exp*1/4+random(exp*1/8));
        set("daoxing", daoxing+daoxing*1/4+random(daoxing*1/8));
        set_temp("apply/armor", 400);
        set_temp("apply/damage", 100);
        }
else    {
        set("max_sen", max_kee*10);
        set("eff_kee", max_kee*10);
        set("max_sen", max_sen*10);
        set("eff_sen", max_sen*10);
        set("kee", max_kee*10);
        set("sen", max_sen*10);
        set("max_mana", maximum_mana);
        set("mana",maximum_mana*2);
        set("combat_exp", exp+exp*1/4+random(exp*1/8));
        set("daoxing", daoxing+daoxing*1/4+random(daoxing*1/8));
        set_temp("apply/armor",300);
        set_temp("apply/damage", 150);
        }   
}

int random_place(object me, string* dirs)
{
int  i, j, k;
object  newob;
mixed*  file, exit;

if( !sizeof(dirs) )  return 0;

i = random(sizeof(dirs));    // pick up one directory

file = get_dir( dirs[i]+"/*.lpc", -1 );
if ( !sizeof(file) )             
        return 0;
for(k=0;k<30;k++) { // try 30 times
        j = random(sizeof(file));
        if( file[j][1] > 0 ) {
                newob=load_object(dirs[i]+"/"+file[j][0]);
                if (newob) {  
                        if( newob->query("no_fight") ||
                            newob->query("no_magic") ||
                            newob->query("no_mieyao") ||
                            !(exit=newob->query("exits")) ||
                            sizeof(exit)<1 ||
                           !newob->query("outdoors") )
                                continue;
                        if(me->move(newob)) {
                                message_vision("$N走了过来。\n",me);
                                return 1;
                                }
                        }
                }
        }
return 0;
}

string invocation(object me, int level)
{
object guai,env;        
string *dirs, where;
        
dirs=dirs1;
guai=this_object();
copy_status(me, level);
guai->set("title",me->query("name")+"搭救的");
set("owner", me);
set("level",level);
if(!random_place(guai, dirs))  return "没人在。";
env=environment(guai);
where=guai->query("name");
if(env)
        where += "在"+MISC_D->find_place(env);
remove_call_out("leave");       
call_out("leave",300);  
return where;
}

void init()
{
object me=this_object();
object who=this_player();
int type;
int t=query("stay_time");

::init();
add_action("do_no","surrender");    
add_action("do_no","ji");    
add_action("do_qk","cast");
add_action("do_block","",1);   
add_action("do_baohu", "baohu");
add_action("do_baohu", "dajiu");
add_action("do_healup", "heal");
   
if(t && time()>(t+300)) 
        {
        remove_call_out("leave");
        call_out("leave",1);
        return;
        }
if(t && time()>t) 
        {
        remove_call_out("_leave");
        call_out("_leave",300);
        }
if(!living(this_object())) return;
if(!living(who)) return;
}

int do_qk(string arg)
{
string cast_id,cast_name;
object who = this_player();

if ( !userp(who) || !arg )
        return 0;        
if (sscanf(arg, "%s on %s", cast_id,cast_name) == 2)
        {     
        if(cast_id=="qiankun" || arg=="qiankun")
                {
                tell_object(who,"你隐隐的听到镇元大仙的声音：你这逆徒！休要烂用我观中法术！\n");
                return 1;
                }
        }
return 0; 
}

int do_healup()
{
object who = this_player();

object ob = this_object();
if (ob->query("kee")>(ob->query("max_kee")-20))
        {
        message_vision("$N说了声谢谢!\n$N气色不错。\n",ob);
        return 1;
        }
if (who->query("kee") < 300 || who->query("force")<1000)
        {      
        tell_object(who,"你气色更差！\n");
        return 1;
        }
who->add("force", -200);
who->add("mana", -200);
ob->add("kee", 150);
ob->add("sen", 150);
message_vision("$N受到了$n的真气灌入!\n$N的气色看起来好多了。\n",ob,who);
return 1;
}
 
int do_no(string arg)
{
object who = this_player();
object me = this_object();
if ( !userp(who) || who!=owner() )
        return 0;
message_vision("$N鬼鬼遂遂不知想干什么，$n警惕的盯着$N。\n",who,me);
return 1;
}

int do_baohu()
{
object me =this_player();
object ob2 = this_object();
object ob,killer1,killer2,killer3;
string where,where1,where2;
int level;

if ( !owner() || me != owner())
   return 0; //add by snowtu for 花仙多的话导致太多返回，不是自己的直接返回0，这样只有自己的，baohu才生效
/*
        {
        return 0;
        message_vision(CYN"$N说道：你不是我等的那个人。哎。。。。\n"NOR,ob2);
        return 1;
        }
*/
if (me->is_busy())  return notify_fail("你正忙着呢。\n");
me->command("say 我来也，救人一命，胜及七级浮屠。");
level = random(10);
if (level<5) level=1;
else if (level<8) level=2;
else level=3;

if( me->query("class")== "human" )  level = 3;
if( me->query("class")== "yao" )  level += 1;
   
if (!me->query("baohu/kk"))
        { 
        killer1 = new("/d/wizz/stey/kill0/"+list[random(sizeof(list))]); 
        if ( killer1 )
                where=killer1->invocation(me, level); 
        killer2 = new("/d/wizz/stey/kill0/"+list[random(sizeof(list))]); 
        if ( killer2 )
                where1=killer2->invocation(me, level); 
        killer3 = new("/d/wizz/stey/kill0/"+list[random(sizeof(list))]); 
        if ( killer3 )
                where2=killer3->invocation(me, level);
        if ( killer1 )  
                me->set_temp("baohu/killer1",killer1);
        if ( killer2 )  
                me->set_temp("baohu/killer2",killer2);
        if ( killer3 )  
                me->set_temp("baohu/killer3",killer3);

        if ( killer1 && killer1->move(environment()) )
                {
                message_vision ("\n"+killer1->query("name")+"突然跳了出来......\n",me);
                killer1->command("follow "+me->query("id"));
                killer1->kill_ob(ob2);
                killer1->kill_ob(me);
                }
        if ( killer2 && killer2->move(environment()) )
                {
                message_vision ("\n"+killer2->query("name")+"突然跳了出来......\n",me);
                killer1->command("follow "+me->query("id"));
                killer2->kill_ob(ob2);
                killer2->kill_ob(me);
                }
        if ( killer3 && killer3->move(environment()) )
                {
                message_vision ("\n"+killer3->query("name")+"突然跳了出来......\n",me);
                killer1->command("follow "+me->query("id"));
                killer3->kill_ob(ob2);
                killer3->kill_ob(me);
                }
        me->set("baohu/kk", 1);
        me->delete("bauhu_killer");
        return 1;
        }
write("暂时风平浪静。\n");      
return 1;
}

int accept_object(object who, object ob)
{
int i, j, k;
string str;
object guai = this_object();
object me = this_player();

if ( ob->name() != "水晶鞋" || ob->query("id") != "shuijing xie" ) 
        {
        message_vision(CYN"$N说道：这是什么玩意儿，快带我回家。\n"NOR,guai);
        return 0;
        }
else if (me != owner()) 
        {
        message_vision(CYN"$N说道：你不是我等的那个人。\n"NOR, guai);
        return 1;
        }
else if (! me->query("baohu/done")) 
        { 
        message_vision(CYN"$N说道：我还没脱险，别磨磨蹭蹭，动作快点。\n"NOR,guai);
        return 1;
        }
else if ( me->query_temp("baohu/get")) 
        {
        message_vision(CYN"$N道了万福说道：谢谢。\n"NOR,guai);
        return 1;
        }
else    { 
        me->add("baohuhuaxian",1);
        i = (int)me->query("baohuhuaxian");
        i = 1200 + random(1000);
        if (i > 2000)  i = 2000;
        i = i*9/(9+me->query("zhuanshi"));
        j = i*2/3 + random(i/2);
        k = j / 5;
        me->add("daoxing", i);
        me->add("combat_exp", j);
        me->add("potential", k);
          me->add("shen", 1);
        str = " do dajiu got " + i + " daoxing " + j +" exp "+ k + " pot";
        tell_object(me, "得到了" +COMBAT_D->chinese_daoxing(i)+"的道行！" +chinese_number(j)+"点武学！"+chinese_number(k)+"点潜能的奖励！\n");
        i = 4000 + random(k);
        MONEY_D->pay_player(me, i);
        tell_object (me,"\n除了战斗所得，你还赢得了"+MONEY_D->money_str(i)+"的奖励！\n");
        str = str + " and " + i + " money.";
        guai->command("kiss6 "+me->query("id"));
        guai->command("job "+me->query("name")+"成功搭救了"+guai->query("name")+"。");
        message_vision(CYN"$N道了万福说道：谢谢你搭救了我！。\n"NOR, guai);
        me->set_temp("baohu/get",1);
        me->set("baohu/done", "done");
        MONITOR_D->mudring_log("dajiu", me, str);
        remove_call_out("destruct_ob");
        call_out("destruct_ob",2+random(3));
        return 1;
        }
}

void destruct_ob()
{
message_vision(CYN"$N说完，穿上水晶鞋蹭了蹭，消失了！。\n"NOR, this_object());
destruct (this_object());
return;
}

void die ()
{
object me,where,ob,target;
target  = query_temp("last_damage_from");
if ( !target )
        {
        ::die();
        return;
        }       
me = this_object();
where = environment();
ob = owner(); 
if ( !ob )
        {
        ::die();
        return;
        }       
if ( ob==target )
        CHANNEL_D->do_channel(this_object(),"chat","想不到"+ob->name(1)+"监守自盗，真是害死我了。。。\n");
else if ( present(ob,where) )
        message_vision(CYN"$N说道："+ob->name()+CYN"武功太烂了，害死我，你。。。。这个。。天。杀的。。，\n"NOR,me);
else    message_vision(CYN"$N说道：你武功太烂了，害死我，你。。。。这个。。天。杀的。。，$N气绝身亡了。\n"NOR,me);
if ( ob )
        {         
        ob->set("baohu/fail",1);        
        ob->delete("baohu/get");
        ob->delete("baohu/kk");
        }
::die();
}

void unconcious()
{
die();
}

void _leave()
{
object me=this_object();
if(me->is_fighting() || me->is_busy())
return;
leave();
}

void leave()
{
if(this_object()) 
        {
        if(environment())
                {
                message("vision",HIB + name() + HIB"化为地上的一朵鲜花。\n" NOR,environment());
                }
        destruct(this_object());
        }
return;
}

varargs int receive_damage(string type, int damage, object who)
{
object me=this_object();
damage = ::receive_damage(type,damage,who);
if ( damage>0 )
        exertheal(me);
return damage;  
}

varargs int receive_wound(string type, int damage, object who)
{
object me=this_object();
damage = ::receive_wound(type,damage,who);
if ( damage>0 )
        exertheal(me);
return damage;  
}

void exertheal(object me) 
{
SDS_D->addEffKee(me);
SDS_D->addKee(me);
SDS_D->addSen(me);
SDS_D->addEffSen(me);
}

int do_block(string arg)
{
object me=this_object();
object who=this_player();
string verb=query_verb();
int t;
    
if ( !userp(who) ) return 0;
if ( who->query_temp("baohu_kill")==0 ) 
        return 0;
if ( verb!="go" && verb!="fly" && !(environment() && environment()->query("exits/" + verb)))
        return 0;
t= random(3);
if (t==1) 
        {
        message_vision("$n不管$N死活，撒手跑了。\n",me,who);
        return 0;
        }
message_vision("$N一伸手拦在$n面前，高声叫道：\n"+" 死妖怪，还不来救偶，偶要死了。\n\n",me,who);
tell_object(who,me->name()+"一把拦住了你！\n");
return 1;
}
