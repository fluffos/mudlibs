//change.c
#include <ansi.h>
#include "/u/fang/saint/super_npc.lpc"
//inherit NPC;
string ask_fazhou();
void create() {
  set_name(HIY "大司马" NOR, ({ "si ma", "sima" }));
  set("long", "方舟制作专门用于十二追杀的NPC\n");
  set("gender", "男性");
  set("age", 200);
  set("class", "xian");
  set("attitude", "friendly");
  set("rank_info/respect", "圣人");
  set("per", 30);
  set("int", 30);
  set("max_kee", 6000);
  set("max_sen", 6000);
  set("sen", 6000);
  set("kee", 6000);
  set("max_gin", 6000);
  set("max_force", 6000);
  set("max_mana", 6000);
  set("mana", 6000);
  set("force", 6000);
  set("force_factor", 300);
  set("mana_factor", 300);
  set("combat_exp", 8000000);
  set("daoxing", 5800000);
  set("eff_dx", 200000);
  set("nkgain", 350);
  set_skill("unarmed", 350);
  set_skill("literate", 350);
  set_skill("dodge", 350);
  set_skill("force", 350);
  set_skill("parry", 350);
  set_skill("wugou-jian", 350);
  set_skill("sword", 350);
  set_skill("whip", 350);
  set_skill("spells", 350);
  set_skill("xuanzong-force", 350);
  set_skill("huntian-jian", 350);
  set_skill("lingyunbu", 350);
  set_skill("yuxu-spells", 350);
  set_skill("kaitian-zhang", 350);
  set_skill("dashen-bian", 350);
  map_skill("sword", "huntian-jian");
  map_skill("mace", "dashen-bian");
  map_skill("parry", "wugou-jian");
  map_skill("unarmed", "kaitian-zhang");
  map_skill("dodge", "lingyunbu");
  map_skill("force", "xuanzong-force");
  map_skill("spells", "yuxu-spells");
  map_skill("unarmed", "jinding-zhang");
  set("inquiry", ([
    "千里追杀": (: ask_fazhou :),
    "追杀": (: ask_fazhou :),
  ]));


  setup();
  carry_object("/obj/cloth")->wear();
  carry_object("/d/obj/weapon/sword/changjian")->wield();


}


string ask_fazhou() {
  object me, cike;
  string where;
  me = this_player();
  if ((me->query("cike_start") + 1800) > time())
    return HIG "方舟大人，说了你现在还不能要刺客追杀任务\n" NOR;
  me->set("cike_start", time());

  cike = new(__DIR__ "cike");
  where = cike->invocation(me, 0);


  return HIW + "刺客" + cike->name() + "在" + where + "为非作歹速去追杀\n";
}
