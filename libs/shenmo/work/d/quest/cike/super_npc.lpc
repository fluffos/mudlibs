int random_place(object me, string *dirs) {
  int i, j, k;
  object newob;
  mixed *file, exit;

  if (!sizeof(dirs)) return 0;

  i = random(sizeof(dirs));    // pick up one directory

  file = get_dir(dirs[i] + "/*.lpc", -1);
  if (!sizeof(file)) return 0;

  for (k = 0; k < 30; k++) {  // try 30 times
    j = random(sizeof(file));
    if (file[j][1] > 0) {
      newob = load_object(dirs[i] + "/" + file[j][0]);
      if (newob) {
        if (newob->query("no_fight") ||
          newob->query("no_magic") ||
          newob->query("no_mieyao") ||
          !(exit = newob->query("exits")) ||
          sizeof(exit) < 1 ||
          !newob->query("outdoors"))
          continue;

        if (me->move(newob)) {
          message_vision("$N走了过来。\n", me);
          return 1;
        }
      }
    }
  }

  return 0;
}

void destruct_ob(object ob) {
  object guai = this_object();
  if (ob == guai) {
    message_vision(CYN "$N化作一阵清烟，消失的无影无踪！。\n" NOR, guai);
    destruct(ob);
    return;
  }
  destruct(ob);
  load_object("/obj/empty");
  guai->move("/obj/empty");
  destruct(guai);
}

string invocation(object me, int level)

{
  object guai, env;
  string *dirs, where;

  dirs = dirs1;
  guai = this_object();

  guai->set("title", HIR + me->query("name") + "千里追杀的" + NOR);
  set("owner_id", me->query("id"));
  set("npc_level", level);

  if (!random_place(guai, dirs)) return "没人在。";

  env = environment(guai);
  //where=guai->query("name");

  if (env)
    where = MISC_D->find_place(env);
  remove_call_out("destruct_ob");
  call_out("destruct_ob", 900, this_object());
  return where;


}
void setname() {
  object ob = this_player();
  int i;
  string name, *knames;
  knames = keys(names);
  i = random(sizeof(knames));
  name = knames[i];

  set_name(name, names[name]);

}
void die() {
  string where;
  int cnt;
  object ob = this_object();
  object me = query_temp("last_damage_from");

  cnt = query("die_time");

  if (!objectp(me) || me != query_temp("kill_ob") || random(cnt + 1) || (query("death_time") + 10) > time()) {
    SDS_D->powerup(ob);
    return;
  }
  SDS_D->powerup(ob);

  me->remove_killer(ob);
  ob->remove_killer(me);

  if (cnt == 12) {
    remove_call_out("destruct_ob");
    me->set("kill_enter_time", time());
    me->set("cike_start", time() + 1800);
    //		if( random(500)== 1) {me->add("level",1);tell_object(me,HIW"你的等级提升了\n"NOR);}
    //////////////////////////////////////////////////////////////////////////
    message(
      "chat",
      HIY + "\n【千里追杀】:" + NOR + HIW + me->query("name") + "千里追杀成功,做杀手楼任务,不用走迷宫了！\n" + NOR,
      users()
    );
    //////////////////////////////////////////////////////////////////////////
    call_out("destruct_ob", 1, this_object());
    return;
  }

  if (query("owner_id") == me->query("id")) {
    cnt += 1;
    set("die_time", cnt);
    set("death_time", time());
    me->add("combat_exp", random(2000) * cnt);
    me->add("daoxing", random(2000) * cnt);
    me->add("potential", random(200) * cnt);
    tell_object(me, HIG "你的战斗经验提高了\n" NOR);
    setname();
    where = invocation(me, cnt * 20);
    delete_temp("kill_family");
    delete_temp("kill_ob");
    if (cnt % 4 == 0) {
      set_temp("kill_family", yc1[random(sizeof(yc1))]);
    }
    message(
      "chat",
      HIY + "\n【千里追杀】:" + NOR + HIW + me->query("name") + "开始追杀" + chinese_number(cnt) + "级刺客！\n" + NOR,
      me
    );
    message_vision(HIY "\n$N化作一阵轻烟向" + HIG + where + NOR + HIY + "方向飞去,$n快去追杀吧。\n" NOR, ob, me);

  }


}




int do_qk(string arg) {

  string cast_id, cast_name;
  object who = this_player();

  if (sscanf(arg, "%s on %s", cast_id, cast_name) == 2)

    if (cast_id == "qiankun" || arg == "qiankun")
      tell_object(who, "你隐隐的听到镇元大仙的声音：你这逆徒！休要烂用我观中法术！\n");
  return 1;


}

int do_no(string arg) {
  object who = this_player();
  object me = this_object();
  message_vision("$N鬼鬼遂遂不知想干什么，$n警惕的盯着$N。\n", who, me);
  return 1;
}

void init() {
  ::init();
  add_action("do_no", "ji");
  add_action("do_qk", "cast");

}

string ask_message() {
  object me = this_player();

  return HIG "据说是一个ID是" + query("owner_id") + "的大虾来追杀我！\n" NOR;
}
