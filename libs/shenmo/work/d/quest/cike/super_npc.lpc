void copy_status(object me, int level) {
  mapping me_skill;
  string *skills;
  string fm_str;
  int *skill_value, max_value, i, j;
  string *enable_skill;

  me_skill = me->query_skills();
  i = sizeof(me_skill);
  if (i > 0) {
    skill_value = values(me_skill);
    max_value = skill_value[0];
    while (i--) {  // 找出玩家skill最大值
      if (skill_value[i] > max_value)
        max_value = skill_value[i];
    }
  } else max_value = 300;


  fm_str = query_temp("kill_family");
  //////////////////////////////////////////////////////////////////////////
  skills = keys(mpsk);
  if (!stringp(fm_str) || member_array(fm_str, skills) == -1) {

    fm_str = skills[random(sizeof(skills))];
  }
  //////////////////////////////////////////////////////////////////////////

  create_family(fm_str, 2, "超级NPC");

  switch (family[fm_str]) {
    case 1:
      set("class", "human");
      break;
    case 0:
      set("class", "xian");
      break;
    case -1:
      set("class", "yao");
      break;
    default:
      set("class", "saint");
      break;
  }
  //
  set("max_kee", me->query("max_kee") * 3);
  set("max_sen", me->query("max_sen") * 3);
  set("max_force", me->query("max_force") * 3);
  set("max_mana", me->query("max_mana") * 3);
  set("combat_exp", me->query("combat_exp"));
  set("daoxing", me->query("daoxing"));
  set_temp("apply/armor", me->query_temp("apply/armor"));
  set_temp("apply/damage", me->query_temp("apply/damage"));
  set("kar", random(30) + 10);
  set("int", random(30) + 10);
  set("cps", random(30) + 10);
  set("str", random(30) + 10);
  set("per", random(30) + 10);
  set("con", random(30) + 10);
  set("cor", random(30) + 10);
  set("spi", random(30) + 10);
  set("shilian", 1);
  set("level", me->query("level") + random(level));
  "/cmds/std/zhenshens"->necklace_change(this_object(), query("level"));

  skills = mpsk[fm_str];
  for (j = 0; j < sizeof(skills); j++) {
    set_skill(skills[j], max_value + random(level));
  }

  enable_skill = ({});
  //write(sprintf("enable_skill:%d\n",sizeof(enable_skill)));
  for (i = 0; i < sizeof(baseskill); i++) {
    for (j = 0; j < sizeof(skills); j++) {
      if (SKILL_D(skills[j])->valid_enable(baseskill[i])) {
        set_skill(baseskill[i], max_value + random(level));  //设定基本的功夫
        map_skill(baseskill[i], skills[j]);
        if (baseskill[i] != "dodge" &&
          baseskill[i] != "literate" &&
          baseskill[i] != "spells" &&
          baseskill[i] != "parry" &&
          baseskill[i] != "force" &&
          baseskill[i] != "needle")
          enable_skill += ({ baseskill[i] });
        reset_action();
      }
    }
  }
  set("force_factor", query_skill("force") / 2);
  set("mana_factor", query_skill("spells") / 2);
  set_temp("enable_skill", enable_skill);
}

void unconcious() {
  die();
}


void heart_beat() {
  string str, skill, *wpty;
  object ob, weapon;
  int i, j;
  object me = this_object();
  ob = this_player();
  ::heart_beat();


  if (query("eff_kee") < query("max_kee") && random(10) == 1)
    SDS_D->addEffKee(me);
  if (query("kee") < query("eff_kee"))
    SDS_D->addKee(me);
  if (query("sen") < query("eff_sen"))
    SDS_D->addSen(me);
  if (query("eff_sen") < query("max_sen") && random(10) == 1)
    SDS_D->addEffSen(me);
  if (!is_fighting() || !objectp(ob))
    return;
  SDS_D->check_player(ob, me);

  if (random(10) == 1)
    SDS_D->powerup(me, 1);
  weapon = query_temp("weapon");
  if (!objectp(weapon)) {
    weapon = new("/d/obj/weapon/sword/xy_sword");
    weapon->wield();
  }

  if (objectp(weapon)) {
    wpty = query_temp("enable_skill");
    if (sizeof(wpty)) {
      str = wpty[random(sizeof(wpty))];
      weapon->set("apply/skill_type", str);
      weapon->set("zizhi", 1);
      weapon->set("skill_type", str);
    }

    skill = weapon->query("skill_type");

  } else skill = "unarmed";
  str = query("family/family_name");

  if (!stringp(str)) {
    wpty = keys(mpsk);
    str = wpty[random(sizeof(wpty))];
    create_family(str, 2, "超级NPC");
  }

  wpty = mpsk[str];
  for (i = 0; i < sizeof(baseskill); i++)
    for (j = 0; j < sizeof(wpty); j++)
      if (SKILL_D(wpty[j])->valid_enable(baseskill[i]) && query_skill_mapped(baseskill[i]) != wpty[j]) {
        map_skill(baseskill[i], wpty[j]); reset_action();
      }

  str = SDS_D->checkSkill(me, skill);
  if (query("no_pfm") != 1) {
    if (query("pfm_busy") == 1 && random(4) == 1) command("perform " + str);
    if (query("pfm_busy") != 1 && random(2) == 1) SDS_D->randomPfm(me, skill);
  }

  //	if( random(4) == 1 )
  //		SDS_D->randomPfm(me,skill);
  //	if( random(4) == 1 )
  //		SDS_D->randomCast(me);
  if (random(4) == 1)
    SDS_D->randomExit(me);

}

void kill_ob(object ob) {
  object me = this_object();
  string owner;
  object k_ob;
  owner = query("owner_id");

  k_ob = query_temp("kill_ob");
  if (!objectp(k_ob)) {
    set_temp("kill_ob", ob);
    k_ob = ob;
    copy_status(ob, query("npc_level"));
  }

  if (ob != k_ob && userp(ob)) {
    message_vision("你们以多取胜，我不奉陪了.\n", me);
    destruct(this_object());
    return;
  }
  SDS_D->powerup(me, 1);
  ::kill_ob(ob);
}
int accept_kill() {
  object me = this_object();
  string owner;
  owner = query("owner_id");

  if (owner != me->query("id")) {
    message_vision("你是谁？不是要追杀我的人，还是不要动杀机了吧\n", me);
    return 0;
  }
  return 1;
}
int accept_fight() {
  write(CYN "去，去，去。你不是我的对手！\n" NOR);
  return 0;
}

