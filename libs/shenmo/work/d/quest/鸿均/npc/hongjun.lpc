#include <ansi.h>
inherit NPC;
#include "/d/quest/鸿均/npc/xian.h"

void create() {
  set_name("鸿均老祖", ({ "hong jun", "hong", "lao zu", "laozu", "zu" }));
  set("age", 1000);
  set("class", "xian");
  set("per", 100);
  set("gender", "男性");
  set("no_check", "
顺风耳告诉你：鸿均老祖的道行已达" HIW "天下无一" NOR "的境界。
顺风耳告诉你：鸿均老祖的武功已达" HIW "无法预知" NOR "的境界。
顺风耳告诉你：鸿均老祖的法力修为已达" HIW "纵横古今" NOR "的境界。
顺风耳告诉你：鸿均老祖的内力修为已有" HIW "随心所欲" NOR "的火候。\n");
  setup();
}
