// By windy 2006.03.22

#include <ansi.h>
inherit NPC;
void create() {
  set_name("柴  绍", ({ "chai shao", "chai", "shao", "chaishao" }));
  set("long", @LONG 
富甲天下的柴绍，贾柳楼四十六友之中排行倒数第二，仅比
罗成稍大点。李渊当初太原起兵多亏了他的资助，并把自己
的三女儿平阳公主嫁给了他。大唐建国后，柴绍跟随秦王李
世民南征北战，立下了汗马功劳，被封为右骁卫大将军。李
世民称帝之后，封他做大唐霍国公，名列凌烟阁二十四功臣
之一，位于第十四位。这不，他现在又拿出自己的钱为大唐
的将士们免费发送黄金装备。（你可以向他 yao 很多东西，
例如 sword,pifeng 等等。中间可不要加空格哦！）
LONG);

  set("title", HIW "驸马大唐霍国公" NOR);
  set("gender", "男性");
  set("class", "human");
  set("age", 30);
  set("str", 45);
  set("per", 28);
  set("inquiry", ([
    "平阳公主": "公主乃是我的爱妻，可惜她已经香消玉陨！\n",
    "李元霸": "元霸虽然脾气暴躁，但是他就听我的话！\n",
    "黄金装备": "凡我大唐子民，只要达到我的要求，都可以来我这里领取，分文不收！\n",
    "贾柳楼": "那都是很久以前的事了，一想起来我就伤感，秦二哥，程四哥，单五哥... ...\n",
  ]));
  set("int", 30);
  set("cor", 50);
  set("combat_exp", 1800000);
  set_skill("sword", 200);
  set_skill("force", 200);
  set_skill("lengquan-force", 200);
  set_skill("literate", 200);
  set_skill("xiaofeng-sword", 200);
  set_skill("dodge", 200);
  set_skill("yanxing-steps", 200);
  set_skill("parry", 200);
  set_skill("unarmed", 200);
  set_skill("changquan", 200);
  map_skill("force", "lengquan-force");
  map_skill("sword", "xiaofeng-sword");
  map_skill("parry", "xiaofeng-sword");
  map_skill("unarmed", "changquan");
  map_skill("dodge", "yanxing-steps");
  set("max_sen", 6000);
  set("max_kee", 8000);
  set("force", 10000);
  set("max_force", 3000);
  set("force_factor", 3000);
  create_family("将军府", 2, "蓝");
  setup();
  carry_object("/d/youxia/obj/xiakesword")->wield();
  carry_object("/d/youxia/obj/bai")->wear();
}
void init() {
  add_action("do_yaosword", "yaosword");
  add_action("do_yaoblade", "yaoblade");
  add_action("do_yaowhip", "yaowhip");
  add_action("do_yaoaxe", "yaoaxe");
  add_action("do_yaostaff", "yaostaff");
  add_action("do_yaostick", "yaostick");
  add_action("do_yaospear", "yaospear");
  add_action("do_yaofork", "yaofork");
  add_action("do_yaoboots", "yaoboots");
  add_action("do_yaoring", "yaoring");
  add_action("do_yaowaist", "yaowaist");
  add_action("do_yaowrists", "yaowrists");
  add_action("do_yaopifeng", "yaopifeng");
}
int do_yaosword(object ob) {
  object me;
  int b1, b2;
  me = this_player();
  b1 = this_player()->query("work/zhujian");
  b2 = this_player()->query("level");
  if (b1 < 50000 && me->query("spskk") != 15)
    return notify_fail("柴绍笑道：你现在铸造技能太低，给了你恐怕也用不了。\n");
  if (b2 < 100 && me->query("spskk") != 15)
    return notify_fail("柴绍笑道：你现在等级太低，给了你恐怕也用不了。\n");
  ob = new("/d/quest/zhuangbei/weapon/yweapon/ysword");
  ob->set("value", 0);
  ob->set("no_get", 1);
  ob->set("no_put", 1);
  ob->set("no_steal", 1);
  ob->set("no_give", 1);
  ob->set("weapon_prop/damage", b2 / 2);
  ob->move(me);
  tell_object(me, "柴绍小心翼翼地把" + ob->query("name") + "递给你,嘱咐你：以后要多建功业，报效国家啊！\n");
  return 1;
}
