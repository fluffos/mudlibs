//迷宫入口
#include <ansi.h>
inherit ROOM;

int num;

int query_room_num() {
  return num;
}

void set_room_num(int v) {
  num = v;
}

void create() {
  set("short", "迷宫入口");
  set("long", "这里是随机迷宫的入口。\n");
  set("exits", ([
    "enter": __FILE__,
  ]));
  set("item_desc", ([
    "enter": "里面乌漆抹黑，什么也看不清。\n",
  ]));
  setup();
}

void reset() {
  int i, k = 0;
  object *rooms = query("migong_room");
  if (rooms && arrayp(rooms)) {
    for (i = 0; i < sizeof(rooms); i++) {
      if (rooms[i]) {
        destruct(rooms[i]);
        k++;
      }
    }
    message(
      "channel:wiz",
      HIC "【任务】随机迷宫：随机迷宫更新完毕，本次更新共删除 " + chinese_number(k) + " 个残留地图。\n" NOR,
      users()
    );
  }
  delete("migong_room");
  ::reset();
}

int migong_start() {
  object tmp, *rooms = ({});
  int i, n, k;

  set_room_num(100);
  n = query_room_num();
  k = 0;
  for (i = 0; i < n; i++) {
    tmp = clone_object(__DIR__ "migong");
    if (!tmp) return 0;
    k++;
    tmp->set("short", chinese_number(k) + "号房间");
    rooms += ({ tmp });
  }
  set("migong_room", rooms);
  message(
    "channel:wiz",
    HIC "【任务】随机迷宫：随机迷宫生成完毕，本次更新共生成 " + chinese_number(k) + " 个随机地图。\n" NOR,
    users()
  );
  return 1;
}

object random_room() {
  object r, *rooms = query("migong_room");
  if (!rooms || !arrayp(rooms))
    return 0;
  return rooms[random(sizeof(rooms))];
}

int valid_leave(object who, string dir) {
  object *rooms, room;
  if (dir == "enter") {
    rooms = query("migong_room");
    if (!rooms || !arrayp(rooms)) {
      if (!migong_start())
        return notify_fail("里面乌漆抹黑的，危险的很。\n");
    }
    rooms = query("migong_room");
    if (!rooms || !arrayp(rooms))
      return notify_fail("里面乌漆抹黑的，危险的很。\n");
    room = random_room();
    if (!room || !who->move(room))
      return notify_fail("里面乌漆抹黑的，危险的很。\n");
    return notify_fail("\n");
  }
  return ::valid_leave(who, dir);
}
