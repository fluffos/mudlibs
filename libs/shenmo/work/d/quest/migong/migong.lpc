#include <ansi.h>
inherit ROOM;

void create()
{
set("short","迷宫");
set("long","这是一个随机迷宫的范例。\n");
set("exits",([
        "west" : __DIR__"enter",
        "east" : __DIR__"enter",
        "south" : __DIR__"enter",               
        "north" : __DIR__"enter",       
]));
set("item_desc",([
        "west" : "里面乌漆抹黑，什么也看不清。\n",
        "east" : "里面乌漆抹黑，什么也看不清。\n",
        "north" : "里面乌漆抹黑，什么也看不清。\n",
        "south" : "里面乌漆抹黑，什么也看不清。\n",                     
]));            

setup();
}

int valid_leave(object who,string dir)
{
object enter,room;      
if ( dir=="west" || dir=="east" || dir=="south"
  || dir=="north" )
        {
        enter = find_object(__DIR__"enter.lpc");
        if ( !enter )
                return notify_fail("里面乌漆抹黑的，危险的很。\n");
        room = enter->random_room();
        if ( !room || !who->move(room) )
                return notify_fail("里面乌漆抹黑的，危险的很。\n");
        return notify_fail("\n");
        }
return ::valid_leave(who,dir);
}       
