#include <ansi.h>
inherit ITEM;
void create()
{
    set_name("竹鸽", ({ "zhu ge" }) );
    set_weight(1);
    if( clonep() )
            set_default_object(__FILE__);
    else {
            set("unit", "只");
            set("material", "bamboo");
            set("long", "一只竹鸽\n");
          }

    setup();
}
