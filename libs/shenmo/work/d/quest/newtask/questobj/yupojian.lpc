#include <weapon.h>
#include <ansi.h>
inherit SWORD;
void create() {
  set_name(HIY "金精玉魄剑" NOR, ({ "jinjing sword" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("material", "iron");
    set("long", "一柄亘古神剑。\n");
  }
  init_sword(15);
  setup();
}
