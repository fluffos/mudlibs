#include <ansi.h>
inherit __DIR__ "makai.lpc";

void create() {
  set_name("马铠碎片", ({ "makai suipian", "suipian", "pian" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("value", 190);
    set("level", 10);
    set("long", "用来打造坐骑盔甲的道具。\n");
  }
  setup();
}

string query_combine_type() {
  return "九等马铠";
}
