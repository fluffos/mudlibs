#include <ansi.h>
inherit ITEM;
inherit F_UNIQUE;

void check_me(object me,object ob,object box,int num,int pp,string arg);

int is_container() { return 1; }
int query_autoload() { return 1; }

nosave string name = 0;

void create()
{
set_name("机括盒",({"jikuo he","he","box"}));
set_weight(1000);
set_max_items(10);
set_max_encumbrance(10);
if ( clonep() )
        set_default_object(__FILE__);
else    {
        set("unit","只");
        set("long","用来合成机关盒子，你可以先将合成材料放(put)进去再合成(combine)。\n");
        set("no_drop",1);
        set("no_give",1);
        set("no_get",1);
        set("no_put",1);
        set("no_sell",1);
        set("value",100000);
        }
setup();
}

void init()
{
::init();       
add_action("do_combine","combine");
}

int do_combine()
{
int i,num=0,pp; 
string type;    
object newob,ob,*inv,me = this_player();

if ( !present(this_object(),me) )
        return 0;
inv = all_inventory();
if ( !sizeof(inv) )
        return notify_fail(name()+"里现在并无任何材料。\n");
ob = inv[0];
name = ob->name();
type = ob->query_combine_type();
set_temp("combine_name",name);

for(i=0;i<sizeof(inv);i++)
        {
        ob = inv[i];
        if ( !ob )
                continue;
        if ( ob->query_combine_type()!=type 
          || !ob->is_combine_item() )
                return notify_fail(name()+"中的材料类型不相同，不能合成。\n");
        num++;
        }
if ( num<=1 )
        return notify_fail("材料数量不够，不能合成。\n");

newob = new(ob->query("combine_file"));
if ( !newob )
        return notify_fail(name()+"里面的东西不能合成。\n");

if ( num==10 )
        pp = 90;
else if ( num==9 )
        pp = 85;
else    pp = num*10;    

tell_object(me,"你决定将 "HIG+chinese_number(num)+" 个"+name+"进行合并，成功率为 "HIR+pp+" %。\n"NOR);
tell_object(me,"你确定进行合并吗？(Y/N)");
input_to( (: call_other, __FILE__, "check_me", me,newob,this_object(),num,pp:));
return 1;
}

void check_me(object me,object ob,object box,int num,int pp,string arg)
{
int i;
object *inv;
        
if ( !me || !box || !ob )
        return;
name = box->query_temp("combine_name"); 
if ( num>sizeof(all_inventory(box)) )
        {
        printf("%d/%d\n",num,sizeof(all_inventory(box)));               
        write(box->name()+"里面没有"+chinese_number(num)+"个"+name+"。\n");
        return;
        }
if (  !arg
   || ( arg[0]!='y' &&  arg[0]!='Y' 
     && arg[0]!='n' &&  arg[0]!='N' ) )
        {
        tell_object(me,"你决定将 "HIG+chinese_number(num)+" 个"+name+"进行合并，成功率为 "HIR+pp+" %。\n"NOR);
        tell_object(me,"你确定进行合并吗？(Y/N)");
        input_to( (: call_other, __FILE__, "check_me", me,num,pp:));
        return;
        }
if ( arg[0]=='n' || arg[0]=='N' )
        {
        write("OK.\n");
        return;
        }

inv = all_inventory(box);
for(i=0;i<sizeof(inv);i++)
        {
        if ( inv[i] )
                destruct(inv[i]);
        }               
        
if ( random(100)<pp || !ob->move(box) )
        write("合并失败！\n");
else    write("合并成功，你得到了"+ob->name()+"。\n");
return;
}

