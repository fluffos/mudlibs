#include <ansi.h>
inherit ITEM;

int query_aotuload() { return 1; }
int is_combine_item() { return 1; }

varargs string name(int raw) {
  string str, cls, *clrs;
  int lv;
  if (stringp(str = query("name"))) {
    clrs = ({
      CYN "", YEL "", BLU "", MAG "", WHT "", RED "",
      HIC "", HIY "", HIB "", HIM "", HIW "", HIR "",
    });
    lv = query("level");
    if (lv <= 1) lv = 1;
    if (lv >= 10) lv = 10;
    cls = clrs[lv - 1];
    str = cls + str + NOR;
    str += "(" + chinese_number(lv) + "等)";
    return str;
  } else return file_name(this_object());
}
