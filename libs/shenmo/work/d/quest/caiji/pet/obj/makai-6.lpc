#include <ansi.h>
inherit __DIR__"makai.lpc";

void create()
{
set_name("马铠碎片",({"makai suipian","suipian","pian"}));
set_weight(1);
if ( clonep() )
        set_default_object(__FILE__);
else    {
        set("combine_file",__DIR__"makai-7");
        set("unit","块");
        set("value",150);
        set("level",6);
        set("long","用来打造坐骑盔甲的道具(可使用机括盒进行合并。\n");
        }
setup();        
}

string query_combine_type()
{
return "六等马铠";
}
