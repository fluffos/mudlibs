#include <ansi.h>
inherit NPC;
inherit F_SAVE;
#include "pet.h"

private string SAVE_NAME = "pet_save";
private nosave int can_save = 1;

int is_pet() { return 1; }

void create() {
  set_name("宠物", ({ "pet" }));
  set("level", 1);
  set("gender", "女性");
  set("race", "野兽");
  set("age", 1);
  set("base_name", "兔");
  set("attitude", "friendly");
  set("long", "小家伙。\n");
  set("combat_exp", 100);
  set("daoxing", 100);
  set("str", 3);  //力量
  set("cor", 3);  //凶性
  set("per", 3);  //体态
  set("spi", 3);  //灵性
  set("cps", 3);  //冷静
  set("con", 3);  //体质
  set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));
  set("ride/msg", "骑");
  set("ride/dodge", 35);
  set_skill("unarmed", 10);
  set_temp("apply/dodge", 1);
  set("is_pet", 1);
  setup();
}

void leave() {
  destruct(this_object());
}

void _leave() {
  if (this_object()->move("/obj/empty")) {
    set_heart_beat(0);
    remove_call_out("leave");
    call_out("leave", 15);
  }
  leave();
}

object owner() {
  string str;
  object who;
  str = query("owner_id");
  if (!str || !stringp(str)) {
    _leave();
    return 0;
  }
  who = find_player(str);
  if (!who || !userp(who)) {
    _leave();
    return 0;
  }
  set("owner", who);
  return who;
}

void heart_beat() {
  object where;
  if (!environment()) {
    die();
    return;
  }
  ::heart_beat();
  where = environment(owner());
  if (!where || !objectp(where))
    die();
  else if (!present(this_object(), where)) {
    if (!this_object()->move(where))
      die();
  }
}

void unconcious() {
  return die();
}

string query_save_file() {
  string id;
  id = query("owner_id");
  if (!id)
    return 0;
  return sprintf("/c/pet/%c/%s", id[0], id);
}

int save() {
  string file;

  if (stringp(file = this_object()->query_save_file())) {
    assure_file(file + __SAVE_EXTENSION__);
    return save_object(file);
  }
  return 0;
}

int restore() {
  string file;

  if (stringp(file = this_object()->query_save_file()))
    return restore_object(file);
  return 0;
}

void die() {
  SDS_D->powerup(this_object());
  if (!owner() || !this_object()->move(owner()))
    _leave();
  return;
}

void init() {
  add_action("do_mount", "mount");
}

int do_mount(string arg) {
  object env, me = this_player();

  if (!arg)
    return 0;
  env = environment(me);

  if (present(arg, env) != me)
    return 0;
  if (owner() && me == owner()) {
    me->set_temp("pet", 1);
    return 0;
  }
  message_vision("$n左躲右闪，$N累得满头大汗也没骑上去。\n", me, this_object());
  return 1;
}

int do_drop(string arg) {
  object me = this_player();
  if (!arg || !id(arg))
    return 0;
  if (!owner() || me != owner())
    return 0;
  if (!present(this_object(), me))
    return 0;
  if (me->is_busy())
    return notify_fail("你正忙着呢．．．\n");
  if (this_object()->move(environment(me))) {
    message_vision("$N使用了自己的坐骑$n。\n", me, this_object());
    set_heart_beat(1);
    return 1;
  }
  return 0;
}

void check_data() {
  string *ids, pname, tname;
  mixed temp;
  int i, t, k, max_level, level;
  max_level = query("max_level");  //种类等级1-17
  level = query("level");          //目前等级1-5
  if (max_level < 1) max_level = 1;
  if (level < 1) level = 1;
  if (max_level > 17) max_level = 17;
  if (level > 5) level = 5;
  tname = query("base_name");
  if (!tname || !stringp(tname))
    error("\n【坐骑系统】警告: 坐骑类别获取错误!\n\n");
  temp = level_name[tname];
  temp = temp[level - 1];
  pname = temp[random(sizeof(temp))];
  if (!pname || !stringp(pname))
    error("\n【坐骑系统】警告: 坐骑名获取错误!\n\n");
  ids = ({  //size=17
  "horse", "horse", "niu", "huli", "lang", "bao", "hu", "shi",
    "zhu", "yang", "she", "peng", "qilin", "xuanwu", "zhuque", "baihu", "qinglong",
  });
  set_name(pname, ({ ids[max_level - 1] }));

  temp = pet_adds[max_level - 1];
  k = level;
  for (i = 0; i < sizeof(temp); i++) {
    k += max_level + random(max_level * 5 + 1);
    set("ride/" + temp[i], k);
    k = level;
  }
}

int level_up() {
  string name;
  if (!owner())
    return 0;
  if (query_temp("rider"))
    return 0;
  this_object()->add("level", 1);
  name = this_object()->name();
  check_data();
  if (!this_object()->save()) {
    write(name + "升级出错，请联系当值巫师。\n");
    return 0;
  }
  write(name + "升级为" + name() + "。\n");
  return 1;
}

string long() {
  string str, *tmp;
  int i;
  mapping pet_ad = ([
    "force": "有效内功",
    "dodge": "有效轻功",
    "parry": "有效招架",
    "spells": "有效法术",
    "intelligence": "读书识字",
    "constitution": "后天根骨",
    "spirituality": "后天灵性",
    "interate": "后天悟性",
    "personality": "后天魅力",
    "courage": "后天胆识",
    "composure": "后天定力",
    "strength": "后天力量",
    "karma": "后天福缘",
  ]);

  if (!owner())
    return "一只坐骑，也不知是哪位高人的。";

  str = sprintf("\t" CYN "坐骑名称" YEL ":" NOR " %s\n", this_object()->name());
  str += sprintf("\t" CYN "坐骑种类" YEL ":" NOR " %s\n", this_object()->query("base_name"));
  str += sprintf(
    "\t" CYN "坐骑所属" YEL ":" NOR " %s(%s)\n",
    owner()->query("name"),
    capitalize(owner()->query("id"))
  );
  str += sprintf("\t" CYN "坐骑属性" YEL ":" NOR "\n");
  tmp = keys(pet_ad);
  for (i = 0; i < sizeof(tmp); i++) {
    if (query("ride/" + tmp[i]))
      str += sprintf(
        "\t\t" HIC "增加 " HIG "%s" NOR HIR " %2-d " NOR HIC "点\n" NOR,
        pet_ad[tmp[i]],
        query("ride/" + tmp[i])
      );
  }
  return str;
}
