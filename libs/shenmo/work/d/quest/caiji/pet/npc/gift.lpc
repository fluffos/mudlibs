#include <ansi.h>
inherit ITEM;

void create() {
  set_name("坐骑领养券", ({ "pet quan", "quan" }));
  set_weight(1000);
  set("long", "领养坐骑的礼物券，用它，你可以领养(lingyang)一只坐骑。\n");
  set("unit", "张");
  set("no_give", "这可是你自己的哦。\n");
  set("value", 0);
  set("no_put", 1);
  set("no_get", 1);
  setup();
}

void init() {
  if (environment() && !query("owner")
    && userp(environment()))
    set("owner", environment());
  add_action("do_lingyang", "lingyang");
}

int do_lingyang() {
  string arg;
  int max_level;
  object pet, me = this_player();
  if (me != query("owner")) {
    write("这张" + name() + "可不是你的。\n");
    return 0;
  }
  pet = new(__DIR__ "pet.lpc");
  if (!pet)
    error("no pet's file.\n");

  switch (random(10)) {
    case 9: arg = "初级战狐"; max_level = 4; break;
    case 5: arg = "初级青牛"; max_level = 3; break;
    default: arg = "初级战马"; max_level = 2;
  }
  pet->set("max_level", max_level);
  pet->set("base_name", arg);
  pet->set("level", 1);
  pet->set("owner_id", me->query("id"));
  pet->set("owner", me);
  pet->check_data();
  if (pet->move(environment(me)))
    message_vision("$N领养了一只$n。\n", me, pet);
  else {
    message_vision("$N领养$n失败。\n", me, pet);
    destruct(pet);
  }
  destruct(this_object());
  return 1;
}
