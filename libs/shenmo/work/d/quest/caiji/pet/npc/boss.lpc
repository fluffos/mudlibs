#include <ansi.h>
inherit NPC;
#include "pet.h"

mapping pets = ([
  1: ({ "初级马匹", 150000, 100000 }),
  2: ({ "初级战马", 500000, 1000000 }),
  3: ({ "初级青牛", 1000000, 2000000 }),
  4: ({ "初级战狐", 5000000, 5000000 }),
  5: ({ "初级鬼狼", 10000000, 10000000 }),
  6: ({ "初级豹骑", 50000000, 15000000 }),
  7: ({ "初级虎骑", 80000000, 20000000 }),
  8: ({ "初级狮骑", 100000000, 25000000 }),
  9: ({ "初级金猪", 200000000, 28000000 }),
  10: ({ "初级泰羊", 300000000, 30000000 }),
  11: ({ "初级巴蛇", 400000000, 32000000 }),
  12: ({ "初级鹏鸟", 500000000, 35000000 }),
  13: ({ "初级麒麟", 600000000, 40000000 }),
  14: ({ "初级玄武", 700000000, 50000000 }),
  15: ({ "初级朱雀", 800000000, 60000000 }),
  16: ({ "初级白虎", 900000000, 70000000 }),
  17: ({ "初级青龙", 1000000000, 80000000 }),
]);

void create() {
  set_name("胥伯乐", ({ "xu bole", "xu" }));
  set("gender", "男性");
  set("title", "洛阳马商");
  set("long", "塞外落日马场的二管家，遵大当家指明随唐入关后在洛阳开了
这家买马的铺子，生意很是红火。\n");
  set("age", 40);
  set("per", 25);
  set("str", 38);
  set("kar", 30);
  set("int", 13);
  set("max_kee", 1200);
  set("max_sen", 1200);
  set("max_force", 1600);
  set("max_mana", 800);
  set("force", 3200);
  set("mana", 1600);
  set("force_factor", 200);
  set("attitude", "peaceful");
  setup();
  carry_object("/d/obj/cloth/choupao")->wear();
  add_money("gold", 1);
}

void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");
}

int do_list() {
  int i, *tmp;
  string clr, *msg, str = @STR        

你可以购买下列这些坐骑：

STR;
  tmp = keys(pets);
  tmp = sort_array(tmp, 1);
  for (i = 0; i < sizeof(tmp); i++) {
    if (this_player()->query("combat_exp") < pets[tmp[i]][1])
      str += CYN "";
    else str += HIC "";
    str += sprintf("%3d  %s  (需要 %11-d 武学经验)  : %s  \n" NOR,
      i + 1,
      pets[tmp[i]][0],
      pets[tmp[i]][1],
      SDS_D->no_color_msg(MONEY_D->money_str(pets[tmp[i]][2])),
    );
  }
  tell_object(this_player(), str);
  return 1;
}

int do_buy(string arg) {
  int i, max_level, level;
  object pet, me = this_player();
  string *temp, tmp;
  if (!arg || member_array(arg, keys(level_name)) == -1) {
    tmp = "";
    temp = keys(level_name);
    for (i = 0; i < sizeof(temp); i++) {
      tmp += "\t" + temp[i];
      if ((i + 1) % 5 == 0)
        tmp += "\n";
    }
    tmp += " ";
    write("本店目前只出售下列坐骑：\n" + tmp + "\n");
    write("指令格式：buy <某物> \n");
    return 1;
  }
  if (!wizardp(me)) return notify_fail("坐骑系统尚在测试阶段，暂不开放。\n");
  pet = new(__DIR__ "pet");
  switch (arg) {
    case "初级马匹":
      max_level = 1; break;
    case "初级战马":
      max_level = 2; break;
    case "初级青牛":
      max_level = 3; break;
    case "初级战狐":
      max_level = 4; break;
    case "初级鬼狼":
      max_level = 5; break;
    case "初级豹骑":
      max_level = 6; break;
    case "初级虎骑":
      max_level = 7; break;
    case "初级狮骑":
      max_level = 8; break;
    case "初级金猪":
      max_level = 9; break;
    case "初级泰羊":
      max_level = 10; break;
    case "初级巴蛇":
      max_level = 11; break;
    case "初级鹏鸟":
      max_level = 12; break;
    case "初级麒麟":
      max_level = 13; break;
    case "初级玄武":
      max_level = 14; break;
    case "初级朱雀":
      max_level = 15; break;
    case "初级白虎":
      max_level = 16; break;
    case "初级青龙":
      max_level = 17; break;
    default:
      error("坐骑类型出错!\n");
  }
  pet->set("max_level", max_level);
  pet->set("base_name", arg);
  pet->set("level", 1);
  pet->set("owner_id", me->query("id"));
  pet->set("owner", me);
  pet->check_data();

  if (!pet->save() || !pet->move(environment())
    || !pet->level_up(me)) {
    write("Sth. is Wrong.\n");
    return 1;
  }
  message_vision("$N领养了$n。\n", me, pet);
  return 1;
}
