#include <ansi.h>
inherit COMBINED_ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name("潜能丹", ({ "qianneng dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("base_unit", "粒");
    set("num", 10);
    set("unit", "些");
    set("long", "每秒增加500点潜能的灵药，持续时间 10 秒，叠加无效。\n");
    set("value", 0);
    set("drug_type", "良药");
  }
  set_amount(1);
  setup();
}

void check_me(object who) {
  if (!who || !present(this_object(), who))
    return;
  if (!who->query_temp("奇珍异宝/" + name()))
    return;
  if (query("num") <= 0) {
    who->delete_temp("奇珍异宝/" + name());
    set("num", 10);
    add_amount(-1);
    return;
  }
  who->add("potential", 500);
  this_object()->add("num", -1);
  remove_call_out("check_me");
  call_out("check_me", 1, who);
}

int do_eat(string arg) {
  object me = this_player();

  if (!arg || !id(arg) || !present(this_object(), me))
    return 0;
  if (me->query_temp("奇珍异宝/" + name()))
    return notify_fail("你已经在使用" + name() + "中。\n");
  message_vision("$N喝下一粒" + name() + "。\n", this_player());
  me->set_temp("奇珍异宝/" + name(), 1);
  remove_call_out("check_me");
  call_out("check_me", 1, me);
  return 1;
}
