#include <ansi.h>
inherit COMBINED_ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name("技能丹", ({ "jineng dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("base_unit", "粒");
    set("num", 10);
    set("unit", "些");
    set("long", "每秒增加1000点随机技能点数的灵药，持续时间 10 秒，叠加无效。\n");
    set("value", 0);
    set("drug_type", "良药");
  }
  set_amount(1);
  setup();
}

void check_me(object who) {
  string *skill, sk;
  mapping skills;

  if (!who || !who->query_temp("奇珍异宝/" + name()))
    return;
  skills = who->query_skills();
  if (present(this_object(), who) && query("num") > 0
    && skills && mapp(skills)) {
    skill = keys(skills);
    sk = skill[random(sizeof(skill))];
    tell_object(who, "你的" + to_chinese(sk) + "熟练度增加了 1000 点。\n");
    who->improve_skill(sk, 1000, 1);
    this_object()->add("num", -1);
    remove_call_out("check_me");
    call_out("check_me", 1, who);
  } else {
    who->delete_temp("奇珍异宝/" + name());
    set("num", 10);
    add_amount(-1);
    return;
  }
}

int do_eat(string arg) {
  object me = this_player();

  if (!arg || !id(arg) || !present(this_object(), me))
    return 0;
  if (me->query_temp("奇珍异宝/" + name()))
    return notify_fail("你已经在使用" + name() + "中。\n");
  message_vision("$N喝下一粒" + name() + "。\n", this_player());
  me->set_temp("奇珍异宝/" + name(), 1);
  remove_call_out("check_me");
  call_out("check_me", 1, me);
  return 1;
}
