#include <ansi.h>
inherit COMBINED_ITEM;

void setup() {}

int query_autoload() { return 1; }

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name("行军丹", ({ "xingjun dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("base_unit", "粒");
    set("unit", "些");
    set("long", "瞬间加满人物气血精神以及食物饮水的灵药，冷却时间 10 秒。\n");
    set("value", 0);
    set("drug_type", "良药");
  }
  set_amount(1);
  setup();
}

int do_eat(string arg) {
  int t;
  object me = this_player();

  if (!arg || !id(arg) || !present(this_object(), me))
    return 0;
  t = me->query_temp("奇珍异宝/" + name());
  if (time() < t + 10)
    return notify_fail("该药物的尚未冷却" + sprintf("(%d/10)\n", time() - t));
  message_vision("$N喝下一粒" + name() + "，顿时整个人活力充沛起来。\n", this_player());
  me->set_temp("奇珍异宝/" + name(), time());
  me->set("eff_kee", me->query("max_kee"));
  me->set("eff_sen", me->query("max_sen"));
  me->set("kee", me->query("max_kee"));
  me->set("sen", me->query("max_sen"));
  me->set("food", (int)me->max_food_capacity());
  me->set("water", (int)me->max_water_capacity());
  add_amount(-1);
  return 1;
}
