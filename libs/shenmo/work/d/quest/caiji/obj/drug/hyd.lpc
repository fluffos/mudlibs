// huanyang.c 还阳丹
#include <ansi.h>
inherit ITEM;

int do_eat(string);

void init();

void init() {
  add_action("do_eat", "eat");
  if (environment() && userp(environment())) {
    set("owner_id", environment()->query("id"));
    set("owner_time", time());
  }
}

void create() {
  set_name(HIG "还阳丹" NOR, ({ "huanyang dan", "dan" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "粒");
    set("long", "有起死回生之效的灵药，冷却时间 60 分钟。\n");
    set("value", 0);
    set("no_put", 1);
  }
  setup();
}

int do_eat(string arg) {
  object me = this_player();

  if (!arg || !id(arg) || !present(this_object(), me)
    || query("owner_id") != me->query("id"))
    return 0;
  if (time() > query("owner_time") + 18000) {
    message_vision(HIG "\n$N吃下一粒还阳丹，结果药时间搁长了，已经失效了。\n\n" NOR, me);
    destruct(this_object());
    return 1;
  }
  log_file(
    "RECOVER",
    sprintf("%s(%s) Got recovered on %s.\n", me->name(1), geteuid(me), ctime(time()))
  );
  message_vision(HIG "\n$N吃下一粒还阳丹，硬是从白无常那里逃脱，捡回了一条小命。\n\n" NOR, me);
  if (me->query("death/combat_exp_loss")) {
    tell_object(me, "你突然发现你的武学全部恢复了！\n");
    me->add("combat_exp", me->query("death/combat_exp_loss"));
    me->delete("death/combat_exp_loss");
  }
  if (me->query("death/dx_loss")) {
    tell_object(me, "你突然发现你的道行基本上全部恢复了！\n");
    me->add("daoxing", me->query("death/dx_loss"));
    me->delete("death/dx_loss");
  }
  me->skill_death_recover();
  me->save();
  destruct(this_object());
  return 1;
}
