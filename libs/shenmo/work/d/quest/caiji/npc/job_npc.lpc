#include <ansi.h>
inherit NPC;

void create() {
  set_name("采集任务NPC", ({ "caiji npc", "npc" }));
  setup();
}

int infomation(object npc) {
  object where;
  mapping my, his;
  string *temp;
  int i;
  if (!npc || userp(npc))
    return 0;
  where = environment(npc);
  if (!where)
    return 0;
  my = this_object()->query_entire_dbase();
  his = npc->query_entire_dbase();
  temp = keys(his);
  for (i = 0; i < sizeof(temp); i++)
    my[temp[i]] = his[temp[i]];
  set_name(npc->name(1), npc->parse_command_id_list());
  seteuid(getuid());
  if (!this_object()->move(where))
    return 0;
  destruct(npc);
  return 1;
}

void leave() {
  message_vision("$N急急忙忙的离开了。\n", this_object());
  destruct(this_object());
}

void _leave() {
  remove_call_out("leave");
  call_out("leave", 1 + random(5));
}

void reward_ob(object who) {
  object item, npc, npc2;
  if (!who || !userp(who))
    return;
  npc = SDS_D->random_npc();
  npc2 = new("/d/quest/caiji/npc/gift_npc");
  item = new("/d/quest/caiji/obj/pian");
  if (!item)
    error("采集任务文件不全！\n");
  if (!item->move(who)) {
    command("say 你身上东西太多了。。。。\n");
    return;
  }
  set("job_over", 1);
  message_vision("$N拿出一些" + item->name(1) + "递给$n。\n", this_object(), who);
  if (npc && npc2->infomation(npc)) {
    npc2->set("owner", who);
    command("say 你顺便去向" + MISC_D->find_place(environment(npc2)) + "的" + npc2->short() + "打听下奖励的消息，会有意想不到的奖励。\n");
  }
  _leave();
}

int accept_object(object who, object obj) {
  int num;
  if (!who || !userp(who))
    return 0;
  if (obj->is_character())
    return 0;
  if (query("job_over"))
    return 0;
  if (obj->query("unit") == who->query("采集/unit")
    && obj->short(1) == who->query("采集/short")) {
    num = obj->query_amount();
    if (num < 1) num = 1;
    if (num >= who->query("采集/num") - who->query("采集/finished_num")) {
      command("thank " + who->parse_command_id_list()[0]);
      command("say 多谢，我需要的材料已经全了。\n");
      reward_ob(who);
    } else {
      who->add("采集/finished_num", num);
      command("say 我还需要" + chinese_number(who->query("采集/num") - who->query("采集/finished_num")) + obj->query("unit") + obj->short(1) + "\n");
    }
    return 1;
  }
  return 0;
}
