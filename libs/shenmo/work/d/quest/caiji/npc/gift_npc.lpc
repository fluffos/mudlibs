#include <ansi.h>
inherit NPC;

void create()
{
set_name("采集任务NPC",({"caiji npc","npc"}));
setup();
}

void leave()
{
message_vision("$N急急忙忙的离开了。\n",this_object());
destruct(this_object());
}       
        
void _leave()
{
delete("inquiry");
remove_call_out("leave");
call_out("leave",1+random(5));
}       

string do_gift()
{
int t;  
object item,me = this_player();
if ( !me || !userp(me) )
        return 0;
if ( me!=query("owner") )
        return 0;
item = new("/d/quest/caiji/obj/pian");
if ( !item )
        error("采集任务文件不全！\n");
t = time()-me->query_temp("采集/start_ask");
t/= 60;
if ( t<3 )
        t = 3;
if ( t>10 )
        t = 10;
item->set_amount(t);
if ( !item->move(me) )
        return "你身上东西太多了。。。。";
_leave();
return "这些东西算是给你的谢礼。";
}                                                       

int infomation(object npc)
{
object where;
mapping my,his; 
string *temp;
int i;
if ( !npc || userp(npc) )
        return 0;
where = environment(npc);
if ( !where )
        return 0;
my = this_object()->query_entire_dbase();
his = npc->query_entire_dbase();
temp = keys(his);
for(i=0;i<sizeof(temp);i++)
        my[temp[i]] = his[temp[i]];
set_name(npc->name(1),npc->parse_command_id_list());
seteuid(getuid());
set("inquiry",([
        "奖励" : (: do_gift :),
]));    
if ( !this_object()->move(where) )
        return 0;
destruct(npc);
return 1;
}


