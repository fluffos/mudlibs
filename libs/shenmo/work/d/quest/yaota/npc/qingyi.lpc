inherit NPC;
#include <ansi.h>
string give_betray1();
int give_betray();
int answer_me();
void check_user();
string ask_huan(); 
void create()
{
                  set_name(HIG"青衣大神"NOR, ({"qing yi"}));
       set("long",
"三万年前与麻衣决战于不周山底。\n");
       set("gender", "男性");
        set("age", 100000);
        set("per", 40);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("inquiry", ([
            "shilian"    :(:give_betray:),
             "再战试练"    : (:give_betray1:),   
             "试练塔"    :(:give_betray:),    
             "again"    : (:give_betray1:),   
             "鼻环" : (:ask_huan:),   
             "huan" : (:ask_huan:),   
           
]));
        setup();
        carry_object("/d/lingtai/obj/faguan")->wear();
}

string give_betray1()
{
        object who=this_player();
        object ob=this_object();    
     
        if( who->query("shilian")==0 )
        return "奇经不通，何以重战？\n";
        check_user();
who->move("/d/quest/yaota/gate");
message_vision("$N对着$n神秘的笑了笑，我送你一程。\n",this_object(),this_player());
        destruct(ob);
        return "试炼试炼，得宝最难！\n";
}


int answer_me()
{
        command("say 小心我扁你！嘿嘿 。\n");
        return 1;
}

int give_betray()
{
        object who=this_player();
        object ob=this_object();    
     
        check_user();
if( who->query("shilian")<1 )
who->move("/d/quest/yaota/gate1");
else { who->move("/d/quest/yaota/kkk");who->set_temp("yaota_enter",1);}
message_vision("$N对着$n神秘的笑了笑，我送你一程。\n",this_object(),this_player());
        destruct(ob);
        return 1;
}
string ask_huan()   //索要环
{ 
object huan; 
object ob = this_object(); 
object me = this_player(); 

if( me->query("shilian") < 1 )//要求：过了塔
   return MAG"你过了试练塔？"NOR; 

  if ( present("qi huan",me)||present("bi huan",me) ) 
          return HIY"你自己“"HIC"inventory"NOR+CYN"“一下吧？我这可不是岔的！"NOR; 
      
       command("ok "+me->query("id") );
 if ( (string)me->query("gender")=="男性")
     { 
 huan=new("/d/quest/yaota/obj/bihuan.lpc");
}
else
{
huan=new("/d/quest/yaota/obj/bihuan.lpc");
}
       huan->move(me);
       message_vision("$N给$n一个"+huan->name()+"。\n",ob,me);
                 
return HIY"好好保管。"NOR; 
}


//加入检查函数，发现有user在，即将其移动到客栈
//fang@tsrj 2011.10.2

void check_user()
{
	string dir,f,*file;
	object luzi;
    object *inv;
    string *nupd = ({"renjie","xianjie","yaojie","shoushutai","shoushutai1","road1","dong",});
	int i,ii;
	dir = "/d/quest/yaota/";
	file = get_dir(dir);
	if ( !file || !arrayp(file) ) return;
	i = sizeof(file);
	while(i--)
	{
		f = file[i];
		if ( sscanf(f,"%s.lpc",f)!=1 ) continue;
		if ( member_array(f,nupd) != -1 ) continue;
		luzi = load_object(dir+f);
		if( !luzi ) continue;
                luzi->setup();
                luzi->setup2();

		inv = all_inventory(luzi);
		ii = sizeof(inv);
		while(ii--) {
			if( userp(inv[ii]) ) inv[ii]->move("/d/city/kezhan");
		}
	}
}
