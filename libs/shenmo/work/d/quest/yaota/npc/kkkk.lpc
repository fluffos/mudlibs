#include <ansi.h>

inherit NPC;
inherit F_MASTER;

string kick_back();
string go_bydt();
string go_back();

void create() {
  set_name("手术师", ({ "shoushu shi", "shi" }));

  set("gender", "男性");
  set("age", 100);

  set("str", 20);
  set("per", 130);
  set("cor", 30);
  set("cps", 75);
  set("kar", 100);
  set("int", 40);
  set("con", 40);
  set("spi", 40);

  set("long", "
这是三界不周山外的一个小小的医生

");
  set("title", "兽医");
  set("combat_exp", 2000000);
  set("daoxing", 2000000);


  set_skill("literate", 150);
  set_skill("unarmed", 100);
  set_skill("force", 100);
  set_skill("lengquan-force", 100);
  set_skill("axe", 150);
  set_skill("sword", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("sanban-axe", 180);
  set_skill("xiaofeng-sword", 100);
  set_skill("spells", 160);
  set_skill("baguazhou", 160);
  set_skill("yanxing-steps", 100);
  map_skill("force", "lengquan-force");
  map_skill("spells", "baguazhou");
  map_skill("axe", "sanban-axe");
  map_skill("parry", "sanban-axe");
  map_skill("dodge", "yanxing-steps");
  map_skill("sword", "xiaofeng-sword");

  set("max_sen", 4500);
  set("max_kee", 3500);
  set("force", 1500);
  set("max_force", 1500);
  set("force_factor", 40);
  set("max_mana", 3000);
  set("mana", 3000);
  set("mana_factor", 50);
  set("chat_chance", 20);
  set("chat_msg", ({
    "手术师看到你进来，急忙迎上前去说到，!\n" +
    "我不周山底千年来不见一人。今日不想却来了位\n" +
    "奇人,老夫看你全身闪光，将来一定是大富大贵之相.\n" +
    "我想当今三界之内恐怕没几个人能有你这样的修为了.\n" +
    "但是话说回来，你印台中隐隐有一股不祥之气，可能\n" +
    "你在练功之余伤到了些许经脉，要我帮你做通吗？\n"

  }));
  set("inquiry", ([
    "别有洞天": (: go_bydt :),
    "经脉": (: kick_back :),
    "回去": (: go_back :),
  ]));


  setup();
  carry_object("/d/obj/weapon/axe/huafu")->wield();
  carry_object("/d/obj/armor/jinjia")->wear();
}

string kick_back() {

  object me = this_player();

  if ((string)me->query("gender") == "男性") {
    me->move("/d/quest/yaota/shoushutai");
  } else {
    me->move("/d/quest/yaota/shoushutai1");
  }
  message_vision(CYN "过去吧．\n" NOR, me);
  message_vision("$N安安静静的躺在了手术台上 ..\n", me);
  return "";
}
int accept_fight(object me) {
  command("say 这不周山已不属于三界之列，你还想乱来吗？！");
  return 0;
}

void init() {
  add_action("do_none", "perform");
  add_action("do_none", "cast");
  add_action("do_none", "bian");
  add_action("do_none", "burn");
  add_action("do_none", "move");
  add_action("do_none", "fly");
  add_action("do_none", "ji");
}
int do_none() {
  object me = this_object();
  message_vision("这不周山已不属于三界之列，你还想乱来吗？\n", me);
  return 1;
}


string go_back() {
  command("ok");
  message_vision("$N在$n面前一抚，$n化作一道清烟径直投向红尘去也。\n", this_object(), this_player());
  this_player()->move("/d/city/kezhan");
  this_player()->delete_temp("last_fainted_from");
  this_player()->set("yaota_enter_time", time());
  this_player()->delete_temp("yaota_enter");
  return "...";
}

string go_bydt() {
  object me = this_player();
  if (!me->query("shilian"))
    return "你没有打通奇经八脉，那个地方恐怕是去不了！";
  message_vision("$N在$n面前一抚，$n化作一道清烟径直投向别有洞天去也。\n", this_object(), me);
  me->move("/d/quest/yaota/dong");
  return "祝你好运！";
}
