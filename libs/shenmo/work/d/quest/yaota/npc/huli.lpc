inherit NPC;
#include <ansi.h>
void create()
{
 set_name("狐狸怪", ({"huli guai", "huli", "guai"})); 
 set("gender", "雄性");
 set("age", 1500);
 set("long",
"这是一只小小的狐狸怪 ！\n");
  set("per", random(20)+1); 
        set("str", 100); 
        set("cor", 40); 
        set("con", 40); 
        set("int", 40); 
        set("spi", 40); 
        set("cps", 40); 
        set("kar", 40); 
        set("max_gin", 1000);
        set("kee", 20000); 
        set("max_kee", 20000); 
              set("eff_kee", 20000);  
        set("sen", 20000); 
        set("max_sen", 20000); 
        set("eff_sen", 20000); 
        set("force", 30000); 
        set("max_force", 30000); 
        set("mana", 30000); 
        set("max_mana", 30000); 
        set("level",500);
        set("combat_exp",50000000); 
        set("daoxing",50000000); 
        set("food", 10000); 
        set("water", 10000); 
        set_weight(30000); 
        
        set_skill("unarmed", 600); 
        set_skill("dodge", 600); 
        set_skill("force", 600); 
        set_skill("spells", 600); 
        set_skill("parry", 600); 
        set_skill("sougu", 600);
        set_skill("qingfu-shenfa", 600);
        set_skill("blade", 600);
        set_skill("sword", 600);
        set_skill("qiankun-danuoyi", 600);
        set_skill("jiuyang-shengong", 600);
        set_skill("literate", 180);
        set_skill("shenghuo-ling", 600);
        map_skill("spells", "qiankun-danuoyi");
        map_skill("force", "jiuyang-shengong");
        map_skill("unarmed", "sougu");
       // map_skill("blade", "bingpo-blade");
        map_skill("parry", "qishang-quan");
        map_skill("dodge", "qingfu-shenfa");
       set("force_factor", 200);
       set("mana_factor", 200);
        
        set_temp("apply/armor", 800); 
