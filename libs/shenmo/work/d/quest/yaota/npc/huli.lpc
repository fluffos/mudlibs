        set("chat_msg_combat", ({
                (: cast_spell, "sheng" :),
                (: perform_action, "unarmed","mu" :),
        
    }) );
        setup(); 
        carry_object("/d/9ct/zb/tianjia")->wear();
        if ( new("/d/snowtu/obj/weapon/hand.lpc")->move(this_object()) )
                command("wield all");
} 
void init () 
{      
        object me=this_object(); 
        object who=this_player(); 
        if(userp(who)) 
        kill_ob(who); 
        ::init(); 
} 