inherit NPC;
#include <ansi.h>
void create()
{
 set_name("狍尾熊", ({"paowei xiong", "paowei", "xiong"})); 
 set("gender", "雄性");
 set("age", 1500);
 set("long",
"这是一只小小的狍尾熊 ！\n");
  set("per", random(20)+1); 
        set("str", 100); 
        set("cor", 40); 
        set("con", 40); 
        set("int", 40); 
        set("spi", 40); 
        set("cps", 40); 
        set("kar", 40); 
        set("max_gin", 1000);
        set("kee", 20000); 
        set("max_kee", 20000); 
              set("eff_kee", 20000);  
        set("sen", 20000); 
        set("max_sen", 20000); 
        set("eff_sen", 20000); 
        set("force", 30000); 
        set("max_force", 30000); 
        set("mana", 30000); 
        set("max_mana", 30000); 
        set("level",500);
        set("combat_exp",50000000); 
        set("daoxing",50000000); 
        set("food", 10000); 
        set("water", 10000); 
        set_weight(30000); 
        
        set_skill("unarmed", 600); 
        set_skill("dodge", 600); 
        set_skill("force", 600); 
        set_skill("spells", 600); 
        set_skill("parry", 600); 
        set_skill("fumobashi", 600);
        set_skill("mizongbu", 600);
        set_skill("sword", 600);
        set_skill("feisheng", 600);
        set_skill("xiantian", 600);
        set_skill("literate", 180);
        set_skill("wuying", 600);
        map_skill("spells", "feisheng");
  map_skill("sword", "wuying");
        map_skill("force", "xiantian");
        map_skill("unarmed", "fumobashi");
       // map_skill("blade", "bingpo-blade");
        map_skill("parry", "wuying");
        map_skill("dodge", "mizongbu");
       set("force_factor", 200);
       set("mana_factor", 200);
        
        set_temp("apply/armor", 800); 
        set_temp("apply/damage", 200); 
        set_temp("apply/attack", 200); 
        set_temp("apply/dodge", 300); 
        set_temp("apply/spells", 300); 
        set_temp("apply/armor_vs_force",30); 
        set_temp("apply/armor_vs_spells",300); 
        create_family("武圣门",2 , "弟子");
     set("title",HIG"妙手神偷"NOR);
        set("no_steal",1); 
        set("taskguai",1); 
        set("chat_chance", 5);
        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
                (: cast_spell, "feixian" :),
                (: perform_action, "sword","fenge" :),
 (: perform_action, "sword","juechen" :),
 (: perform_action, "sword","wuying" :),
 (: perform_action, "unarmed","wanfo" :),
 (: perform_action, "unarmed","duo" :),


        
    }) );
        setup(); 
        carry_object("/d/9ct/zb/tianjia")->wear();
        if ( new("/d/snowtu/obj/weapon/sword.lpc")->move(this_object()) )
                command("wield all");
} 
void init () 
{      
        object me=this_object(); 
        object who=this_player(); 
        if(userp(who)) 
        kill_ob(who); 
        ::init(); 
}
