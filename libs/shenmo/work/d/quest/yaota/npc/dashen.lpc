inherit NPC;
#include <ansi.h>
int give_betray();
int give_class();
int answer_me();

void create() {
  set_name(HIY "共工大神" NOR, ({ "gong gong", "gong" }));
  set("long",
    "三万年前误入不周山底的千年大神。\n");
  set("title", HIC "不周山守护神" NOR);
  set("gender", "男性");
  set("age", 100000);
  set("per", 40);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("inquiry", ([
    "出师": (: give_betray :),
    "隐藏门派": (: give_class :),


  ]));
  setup();
  carry_object("/d/lingtai/obj/faguan")->wear();
}


int answer_me() {
  command("say 小心我扁你！嘿嘿 。\n");
  return 1;
}

int give_betray() {
  object who = this_player();

  if (who->query("class") == "saint") {
    command("say 你是圣族，出师对你没有用!\n");
    return 1;
  }
  if (who->query("family/family_name") == "少林寺") {
    command("say 大神说了，少林寺不能出师!\n");
    return 1;
  }
  if (who->query("shilian") < 1) {
    command("say 你通过了试练塔了吗？");
    return 1;
  }


  who->add("combat_exp", -2000000);
  who->add("daoxing", -2000000);
  who->set("title", HIG "逸士" NOR);
  who->delete("family");
  who->save();
  who->move("/d/city/kezhan");
  message_vision("$N对着$n神秘的笑了笑，$n觉得身体发生剧烈的变化。\n", this_object(), this_player());
  command("chat 恭喜恭喜，" + who->query("name") + "由共工大神做了门派改动！\n");
  return 1;
}

int give_class() {
  object who = this_player();

  if (who->query("shilian") < 1) {
    command("say 你通过了试练塔了吗？");
    return 1;
  }
  if (who->query("class") == "xian") {
    command("say 好的，我送你一程。");
    who->move("/d/quest/yaota/xianjie");
    return 1;
  }
  if (who->query("class") == "yao") {
    command("say 好的，我送你一程。");
    who->move("/d/quest/yaota/yaojie");
    return 1;
  } else {
    who->move("/d/quest/yaota/renjie");
  }
  return 1;
}
