                
#include <ansi.h>   
inherit NPC;   
               
void create()   
{   
set_name(HIB"手术师"NOR, ({"shoushushi"}));   
set("long",BLINK+HIW+@LONG  
他没什么长处，一身白马褂，一把手术刀
LONG+NOR);  
set("gender","男性");  
set("age", random(10000));   
set("per", random(10));   
setup();  
  carry_object("/u/angell/obj/dao")->wield(); 
 
}   
              
void init()  
{  
add_action("do_none","kill");  
add_action("do_none","fight");  
add_action("do_none","ji");  
add_action("do_none","move");  
add_action("do_none","perform");  
add_action("do_none","cast");  
add_action("do_none","steal");  
add_action("do_none","quit");  
add_action("do_none","burn");  
}  
              
int do_none( )  
{  
object who = this_player();  
object ob = this_object();  
message_vision(HIW"\n$N"+HIW"对$n"+HIW"摇了摇头“打通经脉，方始大成，安心立命。\n"NOR,ob,who);  
return 1;  
} 
