inherit ROOM;
#include <ansi.h>
#include "banned1.h" 

void create()
{
set("short", HIB"试练塔入口"NOR);
set("long", @LONG

※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※
※※※  这就是入口了，没有一定的修为，最好还是不要乱闯哦。※※※
※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※

LONG);
set("exits", ([ 
        "up" : __DIR__"tower1",
      "down" : "/d/swordman/gate",
]));
set("no_fight",1);
set("no_magic",1);
setup();
}

void init() 
{  
object me = this_player();
add_action("do_quit",banned_action);  
add_action("do_none","cast");
add_action("do_none","exert");
        
}  

int do_quit(string arg) 
{  
write("你不能在这里用这条命令。\n");  
if ( wizardp(this_player()) ) 
        write("巫师请参阅同一路径内的banned.h文档。\n");  
return 1;  
}  

int do_none(string arg) 
{ 
object me = this_player();
string verb = query_verb();
if ( verb=="cast transfer"
  || verb=="exert recover" 
  || verb== "exert heal" 
  || verb== "exert refresh" ) 
        return 0;
write("这里不能使用此命令。\n");
return 1;
}

int valid_leave(object me, string dir)
{
int i;
object here,*inv;
here = this_object();
inv = all_inventory(me);

if ( dir=="up" )
        {
        if ( !userp(me) )
                return 0;
        else if ( time() < me->query("yaota_enter_time")+1800 )
                return notify_fail("你刚刚从里面出来，还是休息休息吧。\n");    
        else if( objectp(me->query_temp("ridee")) )
                return notify_fail(WHT"你还是先从坐骑上下来吧。\n"NOR);
       else if( me->query("combat_exp")<50000000 || me->query("level") < 250 )
                    return notify_fail(WHT"你还是先练好了再来吧。\n"NOR); 
        for(i=0; i<sizeof(inv); i++) 
                {
                if ( userp(inv[i]) ) 
                        return notify_fail("还是先把身上的玩家放下来再去吧！\n");            
                if ( inv[i]->query("id")=="yueguang baohe" )
                        return notify_fail("还是先把身上的宝盒放下来再去吧！\n");
                if ( inv[i]->query("id")=="pidu zhu" )
                        return notify_fail("还是先把身上的宝珠放下来再去吧！\n");
                }                       
         if( me->query("shilian")==0 )
                    return notify_fail(WHT"你是怎么进来的？\n"NOR); 
        me->set("yaota_enter_time",time());//时间限制，参见/std/magicroom
        me->set_temp("yaota_enter",1);          //标识，无此标识的进塔自动出来，
                                                //失败时，此标识注意要cut
        message("channel:rumor",HIM"【千里眼】某人：听说"HIY+me->query("name")+HIM"再次进入了试练塔中！\n"NOR,users());
        }
else 
        me->delete_temp("yaota_enter"); 
return ::valid_leave(me, dir);
}

