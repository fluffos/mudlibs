#include <ansi.h>
#include <armor.h>
inherit BOOTS;
inherit "/d/quest/newequip/calculate";

void create() {
  string msg = "";
  set_name(HIB "魔王靴" NOR, ({ "mowang xue", "boots" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "leather");
    set("unit", "双");
    set("need_class", -1);
    set("lvl", 3);
    set("Is_Diablo_Obj", 1);
    set("inset_hole", 1);
    set("value", 1000);
    set("armor_prop/armor", 60);
  }
  msg += "一双轻便的靴子。\n" + "基本防御: " + query("armor_prop/armor") + "\n";
  set("old_long", msg);
  if (query("lvl") > 2) {
    if (!query("identification"))
      msg = query("old_long") + RED "这样东西还没有鉴定。\n" NOR;
    set("long", msg);
  }
  setup();
}
