#include <ansi.h>
#include <armor.h>
inherit SHIELD;
inherit "/d/quest/newequip/calculate";

void create() {
  string msg = "";
  set_name(HIB "骷髅盾" NOR, ({ "kulou dun", "shield" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "skin");
    set("unit", "件");
    set("need_class", -1);
    set("lvl", 1);
    set("Is_Diablo_Obj", 1);
    set("value", 1000);
    set("armor_prop/armor", 25);
  }
  msg += "一件坚实的盾牌，看上去象是刀枪不入的样子。\n" + "基本防御: " + query("armor_prop/armor") + "\n";
  msg += query_desc();
  set("long", msg);
  setup();
}
