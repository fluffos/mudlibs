#include <ansi.h>
#include <armor.h>
inherit BOOTS;
inherit "/d/quest/newequip/calculate";

void create() {
  string msg = "";
  set_name(HIB "骷髅靴" NOR, ({ "kulou xue", "boots" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "leather");
    set("unit", "双");
    set("need_class", -1);
    set("lvl", 1);
    set("Is_Diablo_Obj", 1);
    set("value", 1000);
    set("armor_prop/armor", 25);
  }
  msg += "一双轻便的靴子。\n" + "基本防御: " + query("armor_prop/armor") + "\n";
  msg += query_desc();
  set("long", msg);
  setup();
}
