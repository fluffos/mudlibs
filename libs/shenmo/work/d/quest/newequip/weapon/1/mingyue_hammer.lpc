#include <weapon.h>
inherit HAMMER;
#include <ansi.h>
inherit "/d/quest/newequip/calculate";

void create() {
  string msg = "";
  set_name(HIM "明月锤" NOR, ({ "mingyue chui", "hammer" }));
  set_weight(19000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 5000);
    set("material", "steel");
    set("lvl", 1);
    set("Is_Diablo_Obj", 1);
    set("need_class", 1);
    set("wield_msg", "$N拿出一把$n，试了试重量，然后握在手中。\n");
    set("unwield_msg", "$N放下手中的$n。\n");
  }
  init_hammer(25);
  msg += "这是一把沉重的铁锤，打造的相当坚实。\n" + "基本攻击: " + query("weapon_prop/damage") + "\n";
  msg += query_desc();
  set("long", msg);
  setup();
}
