                                        me->add("weapon_prop/fork",ski_num);       
                                        me->set("add_skill",ski_num);                                           
                                        if(me->query("add_skill"))                                                              
                                                msg += HIG + "追加技能：" + me->query("add_skill") +"\n"NOR; 
                                }
                                break;
                        case "hammer":
                                if(me->query("lvl")==1){
                                        ski_num=1+random(2);
                                        me->add("weapon_prop/hammer",ski_num);      
                                        me->set("add_skill",ski_num);                                           
                                        if(me->query("add_skill"))                                                              
                                                msg += HIG + "追加技能：" + me->query("add_skill") +"\n"NOR; 
                                }
                                else if(me->query("lvl")==2){   
                                        ski_num=1+random(3);
                                        me->add("weapon_prop/hammer",ski_num);      
                                        me->set("add_skill",ski_num);                                           
                                        if(me->query("add_skill"))                                                              
                                                msg += HIG + "追加技能：" + me->query("add_skill") +"\n"NOR; 
                                }
                                else if(me->query("lvl")==3){   
                                        ski_num=1+random(4);
                                        me->add("weapon_prop/hammer",ski_num);      
                                        me->set("add_skill",ski_num);                                           
                                        if(me->query("add_skill"))                                                              
                                                msg += HIG + "追加技能：" + me->query("add_skill") +"\n"NOR; 
                                }
                                else if(me->query("lvl")==4){   
                                        ski_num=1+random(6);
                                        me->add("weapon_prop/hammer",ski_num);      
                                        me->set("add_skill",ski_num);                                           
                                        if(me->query("add_skill"))                                                              
                                                msg += HIG + "追加技能：" + me->query("add_skill") +"\n"NOR; 
                                }
                                else if(me->query("lvl")==5){   
                                        ski_num=1+random(7);
                                        me->add("weapon_prop/hammer",ski_num);      
                                        me->set("add_skill",ski_num);                                           
                                        if(me->query("add_skill"))                                                              
                                                msg += HIG + "追加技能：" + me->query("add_skill") +"\n"NOR; 
                                }
                                else if(me->query("lvl")==6){   
                                        ski_num=1+random(8);
                                        me->add("weapon_prop/hammer",ski_num);      
                                        me->set("add_skill",ski_num);                                           
                                        if(me->query("add_skill"))                                                              
                                                msg += HIG + "追加技能：" + me->query("add_skill") +"\n"NOR; 
                                }
                                break;
                         case "staff":
                                if(me->query("lvl")==1){
                                        ski_num=1+random(2);
                                        me->add("weapon_prop/staff",ski_num);      
                                        me->set("add_skill",ski_num);                                           
                                        if(me->query("add_skill"))                                                              
                                                msg += HIG + "追加技能：" + me->query("add_skill") +"\n"NOR; 
                                }
                                else if(me->query("lvl")==2){   
                                        ski_num=1+random(3);
                                        me->add("weapon_prop/staff",ski_num);      
                                        me->set("add_skill",ski_num);                                           
                                        if(me->query("add_skill"))                                                              
                                                msg += HIG + "追加技能：" + me->query("add_skill") +"\n"NOR; 
                                }
                                else if(me->query("lvl")==3){   
                                        ski_num=1+random(4);
                                        me->add("weapon_prop/staff",ski_num);      
                                        me->set("add_skill",ski_num);                                           
                                        if(me->query("add_skill"))                                                              
                                                msg += HIG + "追加技能：" + me->query("add_skill") +"\n"NOR; 
                                }
                                else if(me->query("lvl")==4){   
                                        ski_num=1+random(6);
                                        me->add("weapon_prop/staff",ski_num);      
                                        me->set("add_skill",ski_num);                                           
                                        if(me->query("add_skill"))                                                              
                                                msg += HIG + "追加技能：" + me->query("add_skill") +"\n"NOR; 
                                }
                                else if(me->query("lvl")==5){   
                                        ski_num=1+random(7);
                                        me->add("weapon_prop/staff",ski_num);      
                                        me->set("add_skill",ski_num);                                           
                                        if(me->query("add_skill"))                                                              
                                                msg += HIG + "追加技能：" + me->query("add_skill") +"\n"NOR; 
                                }
                                else if(me->query("lvl")==6){   
                                        ski_num=1+random(8);
                                        me->add("weapon_prop/staff",ski_num);      
                                        me->set("add_skill",ski_num);                                           
                                        if(me->query("add_skill"))                
                                                msg += HIG + "追加技能：" + me->query("add_skill") +"\n"NOR; 
                                }
                        default: break;
                }
        }
        if(armor_type=me->query("armor_type") ){
                if(armor_type=="boots" || armor_type=="neck" ){
                if(lvl=me->query("lvl")){
                        switch(lvl){
                                case 1:
                                ski_num=1+random(2);
                                me->add("armor_prop/dodge",ski_num);      
                                me->set("add_dodge",ski_num);                                           
                                if(me->query("add_dodge"))                                                              
                                        msg += HIG + "追加躲避：" + me->query("add_dodge") +"\n"NOR; 
                                break;
                                case 2:
                                ski_num=1+random(3);
                                me->add("armor_prop/dodge",ski_num);      
                                me->set("add_dodge",ski_num);                                           
                                if(me->query("add_dodge"))                                                              
                                        msg += HIG + "追加躲避：" + me->query("add_dodge") +"\n"NOR;
                                break; 
                                case 3:
                                ski_num=1+random(4);
                                me->add("armor_prop/dodge",ski_num);      
                                me->set("add_dodge",ski_num);                                           
                                if(me->query("add_dodge"))                                                              
                                        msg += HIG + "追加躲避：" + me->query("add_dodge") +"\n"NOR;
                                break;
                                case 4:
                                ski_num=1+random(6);
                                me->add("armor_prop/dodge",ski_num);      
                                me->set("add_dodge",ski_num);                                           
                                if(me->query("add_dodge"))                                                              
                                        msg += HIG + "追加躲避：" + me->query("add_dodge") +"\n"NOR;
                                break;  
                                case 5:
                                ski_num=1+random(7);
                                me->add("armor_prop/dodge",ski_num);      
                                me->set("add_dodge",ski_num);                                           
                                if(me->query("add_dodge"))                                                              
                                        msg += HIG + "追加躲避：" + me->query("add_dodge") +"\n"NOR;
                                break; 
                                case 6:
                                ski_num=1+random(8);
                                me->add("armor_prop/dodge",ski_num);      
                                me->set("add_dodge",ski_num);                                           
                                if(me->query("add_dodge"))                                                              
                                        msg += HIG + "追加躲避：" + me->query("add_dodge") +"\n"NOR;
                                default: break;
                        }
                }
                }
        } 
        if(skill_type)
        me->set("need_str",calculate_strength(me,ob));                          
        if(me->query("inset_hole"))
                msg += HIG + "镶嵌孔：" + me->query("inset_hole") +"个 \n"NOR;
        if(me->query("need_str"))
                msg += HIG + "需要力量：" + me->query("need_str") +"\n"NOR;             
        if(me->query("need_class")!=0){
                if(me->query("need_class")==1)
                        msg += HIR "仙族" NOR WHT "专用\n"; 
                else if(me->query("need_class")==-1)
                        msg += HIR "魔族" NOR WHT "专用\n"; 
        }
        msg += HIC "≡" HIY "──────────────────────" HIC "≡\n" NOR;
        return msg;
}

int finish_identify()
{
        //通过鉴定,扩展装备的性能
        string msg; 
        object me = this_object();
        
        me->set("identification",1);
        msg=me->query("old_long");  
        msg += query_desc(); 
        me->set("long",msg);
//        me->setup();
        return 1;
}