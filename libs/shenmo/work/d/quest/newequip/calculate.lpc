#include <ansi.h>

int calculate_strength(object me,object ob)
{
        int attack,skill,addattack,total;
        me=this_object();
        ob=environment(me);
        
        skill=me->query("add_skill");
        attack=me->query("weapon_prop/damage");
        addattack=me->query("add_attack");
        
        if(addattack && skill)
                total=attack+skill*10;
        else if(addattack)
                total=attack;
        else if(skill)
                total=skill*10+attack;
        else
                total=attack;
        return total;
}

