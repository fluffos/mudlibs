// 灵兽

#include <ansi.h>
#include <armor.h>

inherit WAIST;

void create() {
  set_name(HIB "巨灵兽" NOR, ({ "juling shou", "beast" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一只小小的灵兽，带上它可以帮你很大的忙。\n");
    set("unit", "只");
    set("value", 2000);
    set("material", "metal");
    set("Is_Diablo_Obj", 1);
    set("armor_prop/armor", 1);
    set("life_points", 150);
  }
  setup();
}

void init() {
  object me = this_object();
  call_out("checking", 10, me);
}

void checking(object me) {
  if (me->query("life_points") <= 0)
    destruct(me);
  remove_call_out("checking");
  call_out("checking", 5, me);
}
