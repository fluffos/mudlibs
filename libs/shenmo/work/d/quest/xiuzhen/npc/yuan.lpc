inherit NPC;
#include <ansi.h>
string give_betray1();
int give_betray();
int answer_me();
string ask_huan(); 
void create()
{
            set_name(HIW"本命元婴"NOR, ({"benming yuanying","yuanying",}));
       set("long",
"传说中修真界的迎宾接引使者。\n");
       set("gender", "男性");
        set("age", 100000);
   set("title",HIG "修真界" HIM "接引使者" NOR ); 
        set("per", 40);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("inquiry", ([
            "shilian"    :(:give_betray:),
             "再战试练"    : (:give_betray1:),   
             "试练塔"    :(:give_betray:),    
             "huan" : (:ask_huan:),   
           
]));
        setup();
        carry_object("/d/lingtai/obj/faguan")->wear();
}

string give_betray1()
{
        object who=this_player();
        object ob=this_object();    
     
        if( !who->query("shilian") )
        return "奇经不通，何以重战?\n";
who->move("/d/quest/yaota/gate");
message_vision("$N对着$n神秘的笑了笑，我送你一程。\n",this_object(),this_player());
        destruct(ob);
        return "试练试练，得宝最难\n";
}


int answer_me()
{
        command("say 小心我扁你！嘿嘿 。\n");
        return 1;
}

int give_betray()
{
        object who=this_player();
        object ob=this_object();    
     
who->move("/d/quest/yaota/gate1");
message_vision("$N对着$n神秘的笑了笑，我送你一程。\n",this_object(),this_player());
        destruct(ob);
        return 1;
}
string ask_huan()   //索要环
{ 
object huan; 
object ob = this_object(); 
object me = this_player(); 

if( me->query("shilian") < 1 )//要求：过了塔
   return MAG"你过了试练塔？"NOR; 

  if ( present("qi huan",me)||present("bi huan",me) ) 
          return HIY"你自己“"HIC"inventory"NOR+CYN"“一下吧？我这可不是岔的！"NOR; 
      
       command("ok "+me->query("id") );
 if ( (string)me->query("gender")=="男性")
     { 
 huan=new("/d/quest/yaota/obj/bihuan.lpc");
}
else
{
huan=new("/d/quest/yaota/obj/bihuan.lpc");
}
       huan->move(me);
       message_vision("$N给$n一个"+huan->name()+"。\n",ob,me);
                 
return HIY"好好保管。"NOR; 
}



