// yg-kunlun   by piao

#include <ansi.h>
inherit __DIR__"yaoguai.lpc";

void set_skills(int j, int level)
{
        object me=this_object();
        object weapon;

        set("title",RED"夺命剑客"NOR);
        me->set("level", j);
        me->set("class", "human");
	set("gender", "男性");
        me->set_skill("unarmed", j);
        me->set_skill("dodge", j);
        me->set_skill("parry", j);
        me->set_skill("force", j);
        me->set_skill("spells", j);
 
        me->set_skill("blade", j);
        me->set_skill("shenji-blade", j);
        me->set_skill("sword",j);
        me->set_skill("duo-sword",j);
        me->set_skill("shadowsteps", j);
        me->set_skill("xueying-xianfa", j);
        me->set_skill("dianxue", j);
        me->set_skill("cloudforce", j);

        me->map_skill("force", "cloudforce");
        me->map_skill("sword", "duo-sword");
        me->map_skill("blade",  "shenji-blade");
        me->map_skill("parry", "duo-sword");
        me->map_skill("spells", "xueying-xianfa");
        me->map_skill("dodge", "shadowsteps");
        me->map_skill("unarmed", "dianxue");

	set("chat_chance_combat", cast_chance(level));
        set("chat_msg_combat", ({
        (: perform_action,"sword", "shisan" :),
        (: perform_action,"blade", "jichulianhuan" :),
        (: perform_action,"unarmed", "dianxue" :),
        (: cast_spell, "sword" :),
        }) );

        create_family("神剑山庄", 2, "蓝");  
        if (random(2))
           weapon=new("/d/city/npc/obj/blade"); 
        else
           weapon=new("/d/city/npc/obj/sword"); 
        if (random(2))
        weapon->set("no_break", 1);
        weapon->move(me);
        carry_object("/d/obj/stey/xianyi")->wear();
        command("wield all");
}
