string *death_msg = ({
  "$N喝道：大胆狂徒，竟敢藐视天条，还不速与我去地府领罪！\n$n无可奈何，一道亡魂径往阴曹地府而去。\n",
  "$n一看不是$N的对手，只得长叹一声，魂飞魄散，随着黑白无常直奔地府而去。\n",
  "$n大叫一声“也罢，我服了！可怜我上有老母，下有妻儿。。。。。。”\n$N把眼一瞪，$n垂头丧气，任由黑白无常锁住了脖子。\n",
  "$N喝道：大胆妖人，就你这三脚猫的功夫也想逃脱轮回之苦！\n$n知道大势已去，只得伏法，大叫一声，撒手人寰！\n",
});
