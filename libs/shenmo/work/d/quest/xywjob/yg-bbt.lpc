// yg-kunlun   by piao

#include <ansi.h>
inherit __DIR__"yaoguai.lpc";

void set_skills(int j, int level)
{
        object me=this_object();
        object weapon;

        set("title",RED"寒潭血影"NOR);
        me->set("level", j);
        me->set("class", "yao");
	set("gender", "男性");
        me->set_skill("unarmed", j);
        me->set_skill("dodge", j);
        me->set_skill("parry", j);
        me->set_skill("force", j);
        me->set_skill("spells", j);
 
        me->set_skill("fork", j);
        me->set_skill("yueya-fork", j);
        me->set_skill("blade",j);
        me->set_skill("huaxue-blade",j);
        me->set_skill("yulong-steps", j);
        me->set_skill("bihai-spells", j);
        me->set_skill("chuanyun-tui", j);
        me->set_skill("zhuanlong-force", j);

        me->map_skill("force", "zhuanlong-force");
        me->map_skill("blade", "huaxue-blade");
        me->map_skill("fork",  "yueya-fork");
        me->map_skill("parry", "huaxue-blade");
        me->map_skill("spells", "bihai-spells");
        me->map_skill("dodge", "yulong-steps");
        me->map_skill("unarmed", "chuanyun-tui");

        set("chat_chance_combat", cast_chance(level));
        set("chat_msg_combat", ({
        (: perform_action,"blade", "piaoxiang" :),
        (: perform_action,"blade", "feihua" :),
        (: perform_action,"fork", "juesha" :),
        (: perform_action,"unarmed", "yunyu" :),
        (: exert_function, "zhuanlong" :), 
        (: cast_spell, "daohai" :),
        }) );
        create_family("乱石山碧波潭", 2, "蓝");  

        if (random(2))
           weapon=new("/d/city/npc/obj/blade");
        else
           weapon=new("/d/city/npc/obj/fork");
        if (random(2))
        weapon->set("no_break", 1);
        weapon->move(me);
        carry_object("/d/obj/stey/xianyi")->wear();
        command("wield all");
}
