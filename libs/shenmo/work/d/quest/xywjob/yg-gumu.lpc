// yg-kunlun   by piao

#include <ansi.h>
inherit __DIR__"yaoguai.lpc";

void set_skills(int j, int level)
{
        object me=this_object();
        object weapon;

        set("title",HIM"古墓丽影"NOR);
        me->set("level", j);
        me->set("class", "yao");
        set("gender", "女性");
        me->set_skill("unarmed", j);
        me->set_skill("dodge", j);
        me->set_skill("parry", j);
        me->set_skill("force", j);
        me->set_skill("spells", j);
 
        me->set_skill("blade", j);
        me->set_skill("zizhi-blade", j);
        me->set_skill("sword",j);
        me->set_skill("qinghu-jian",j);
        me->set_skill("kongming-steps", j);
        me->set_skill("youming-spells", j);
        me->set_skill("jiuyin-zhua", j);
        me->set_skill("jiuyin-force", j);

        me->map_skill("force", "jiuyin-force");
        me->map_skill("sword", "qinghu-jian");
        me->map_skill("blade",  "zizhi-blade");
        me->map_skill("parry", "qinghu-jian");
        me->map_skill("spells", "youming-spells");
        me->map_skill("dodge", "kongming-steps");
        me->map_skill("unarmed", "jiuyin-zhua");

	set("chat_chance_combat", cast_chance(level));
        set("chat_msg_combat", ({
        (: perform_action,"sword", "po" :),
        (: perform_action,"sword", "hebi" :),
        (: perform_action,"blade", "firebird" :),
        (: perform_action,"blade", "daoying" :),
        (: perform_action,"blade", "lianhuan" :),
        (: perform_action,"unarmed", "tougu" :),
        (: cast_spell, "mei" :),
        }) );

        create_family("轩辕古墓", 2, "蓝");  
        if (random(2))
           weapon=new("/d/city/npc/obj/blade"); 
        else
           weapon=new("/d/city/npc/obj/sword"); 
        if (random(2))
        weapon->set("no_break", 1);
        weapon->move(me);
        carry_object("/d/obj/stey/xianyi")->wear();
        command("wield all");
}
