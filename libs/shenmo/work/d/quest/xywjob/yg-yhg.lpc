// yg-kunlun   by piao

#include <ansi.h>
inherit __DIR__"yaoguai.lpc";

void set_skills(int j, int level)
{
        object me=this_object();
        object weapon;

        set("title",HIM"百花追魂"NOR);
        me->set("level", j);
        me->set("class", "human");
        set("gender", "女性");
        me->set_skill("unarmed", j);
        me->set_skill("dodge", j);
        me->set_skill("parry", j);
        me->set_skill("force", j);
        me->set_skill("spells", j);
 
        me->set_skill("whip", j);
        me->set_skill("baihua-whip", j);
        me->set_skill("sword",j);
        me->set_skill("feihua-sword",j);
        me->set_skill("feihua-steps", j);
        me->set_skill("mingyu-jue", j);
        me->set_skill("yihua-jiemu", j);
        me->set_skill("yihua-force", j);

        me->map_skill("force", "yihua-force");
        me->map_skill("sword", "feihua-sword");
        me->map_skill("whip",  "baihua-whip");
        me->map_skill("parry", "baihua-whip");
        me->map_skill("spells", "mingyu-jue");
        me->map_skill("dodge", "feihua-steps");
        me->map_skill("unarmed", "yihua-jiemu");

	set("chat_chance_combat", cast_chance(level));
        set("chat_msg_combat", ({
        (: perform_action,"whip", "zhuihun" :),
        (: perform_action,"whip", "zheng" :),
        (: perform_action,"sword", "feixue" :),
        (: perform_action,"sword", "feitian" :),
        (: perform_action,"sword", "luo" :),
        (: perform_action,"unarmed", "jie" :),
        (: perform_action,"unarmed", "zhan" :),
        (: perform_action,"unarmed", "hun" :),
        (: exert_function, "shield" :),
        }) );

        create_family("移花宫", 2, "蓝");  
        if (random(2))
           weapon=new("/d/city/npc/obj/whip"); 
        else
           weapon=new("/d/city/npc/obj/sword"); 
        if (random(2))
        weapon->set("no_break", 1);
        weapon->move(me);
        carry_object("/d/obj/stey/xianyi")->wear();
        command("wield all");
}
