#include <ansi.h> 
inherit __DIR__"yaoguai.lpc";


void set_skills(int j, int level)
{
        object me=this_object();
        object weapon;

        me->set("title",HIC"万剑俱发"NOR);
        me->set("class", "human");
        me->set("level", j);
        me->set_skill("unarmed", j);
        me->set_skill("dodge", j);
        me->set_skill("parry", j);
        me->set_skill("force", j);
        me->set_skill("spells", j);
        me->set_skill("sword",j); 
        
        me->set_skill("yujianshu", j+random(15));
        me->set_skill("spells",j+random(15));
        me->set_skill("sevensteps",j+random(15));
        me->set_skill("taoism", j+random(15));
        me->set_skill("unarmed", j+random(15));        
        me->set_skill("hunyuan-zhang", j+random(15));
        me->set_skill("zixia-shengong", j+random(15)); 

        me->map_skill("force", "zixia-shengong");
        me->map_skill("sword", "yujianshu");        
        me->map_skill("parry", "yujianshu");
        me->map_skill("spells", "taoism");
        me->map_skill("dodge", "sevensteps");
        me->map_skill("unarmed", "hunyuan-zhang");

	set("chat_chance_combat", cast_chance(level));
        set("chat_msg_combat", ({
        (: perform_action,"sword", "wanjian" :),
        (: perform_action,"sword", "jingtian" :),
        (: perform_action,"unarmed", "feilong" :),
        (: cast_spell, "shou" :),
        }) );        
        create_family("蜀山剑派", 2, "蓝");  
           weapon=new("/d/city/npc/obj/sword"); 
        if (random(2))
        weapon->set("no_break", 1);
        weapon->move(me);
        carry_object("/d/obj/stey/xianyi")->wear();
        command("wield all");
}
