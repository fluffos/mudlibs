#include <ansi.h> 
inherit __DIR__"yaoguai.lpc";

// here should be this NPC specific skills.

void set_skills(int j, int level)
{
        object me=this_object();
        object weapon;

        set("title","妖极天世");
        set("title",HIB"妖极天世"NOR);
        me->set("class", "yao");
        me->set("level", j);
        me->set_skill("unarmed", j);
        me->set_skill("dodge", j);
        me->set_skill("parry", j);
        me->set_skill("force", j);
        me->set_skill("spells", j);

        me->set_skill("zhaoyangbu",j+random(15));
        me->set_skill("sword",j+random(15));
        me->set_skill("huxiaojian",j+random(15));
        me->set_skill("unarmed",j+random(15));
        me->set_skill("huxiaoquan",j+random(15));
        me->set_skill("liushenjue",j+random(15));
        me->set_skill("tianyaofa",j+random(15));
        me->set_skill("huntianforce",j+random(15));
        me->set_skill("tianmogong",j+random(15));
        me->set_skill("blade",j+random(15));
        me->set_skill("zileidao",j+random(15));
        me->set_skill("stick",j+random(15));
            
        me->map_skill("force", "huntianforce");
        me->map_skill("sword", "huxiaojian");
        me->map_skill("blade","zileidao");
        me->map_skill("parry", "zileidao");
        me->map_skill("spells", "tianmogong");
        me->map_skill("stick", "tianyaofa");
        me->map_skill("dodge", "zhaoyangbu");
        me->map_skill("unarmed", "huxiaoquan");

        set("chat_chance_combat", cast_chance(level));
        set("chat_msg_combat", ({
        (: perform_action,"blade", "tulong" :),	
        (: perform_action,"blade", "huanying" :),
        (: perform_action,"sword", "chan" :),
        (: perform_action,"sword", "hou" :),
        (: perform_action,"sword", "sixiao" :),
        (: perform_action,"unarmed", "sixiao" :),
        (: cast_spell, "shihun" :),
        (: cast_spell, "sishi" :),        
        }) );

        create_family("三界山", 2, "蓝");  
        if (random(2))
           weapon=new("/d/city/npc/obj/blade"); 
        else
           weapon=new("/d/city/npc/obj/sword"); 
        if (random(2))
        weapon->set("no_break", 1);
        weapon->move(me);
        carry_object("/d/obj/stey/xianyi")->wear();
        command("wield all");
}
