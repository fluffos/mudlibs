// bula and mon@xyj

#include <ansi.h> 
inherit __DIR__"yaoguai.lpc";

// here should be this NPC specific skills.
void set_skills(int j, int level)
{
        object me=this_object();
	object weapon;

        set("title",HIW"天地逍遥"NOR);
        me->set("level", j);
        me->set("class", "human");
        me->set("chshjue_agree", 1);
        me->set("yumo_agree", 1);
        me->set("dzxy_agree", 1);
        me->set("lbwb_agree", 1);
	me->set_skill("unarmed", j);
	me->set_skill("dodge", j);
	me->set_skill("parry", j);
	me->set_skill("force", j);
	me->set_skill("spells", j);
 
        me->set_skill("sword", j+random(15));
        me->set_skill("jadesword", j+random(15));
        me->set_skill("lingbo-weibu", j+random(15));
        me->set_skill("douzhuan-xingyi", j+random(15));
        me->set_skill("fumozhou", j+random(15));
        me->set_skill("dianxue", j+random(15));
        me->set_skill("changshengjue", j+random(15));

        me->map_skill("force", "changshengjue");
        me->map_skill("sword", "jadesword");
        me->map_skill("parry", "douzhuan-xingyi");
        me->map_skill("spells", "fumozhou");
        me->map_skill("dodge", "lingbo-weibu");
        me->map_skill("unarmed", "dianxue");

	set("chat_chance_combat", cast_chance(level));
	set("chat_msg_combat", ({
        (: cast_spell, "freeze" :),
        (: perform_action,"sword", "qishen" :), 
        (: perform_action,"sword", "jianyi" :), 
        (: perform_action,"unarmed", "dianxue" :), 
        (: exert_function, "rebirth" :),
        (: perform_action,"parry", "dzxy" :), 
	}) );

           weapon=new("/d/city/npc/obj/sword"); 
        if (random(2))
        weapon->set("no_break", 1);
	weapon->move(me);
        carry_object("/d/obj/stey/xianyi")->wear();
	command("wield all");
}
