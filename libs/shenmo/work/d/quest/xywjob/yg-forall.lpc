// bula and mon@xyj

#include <ansi.h> 
inherit __DIR__"yaoguai.lpc";

// here should be this NPC specific skills.
void set_skills(int j, int level)
{
        object me=this_object();
	object weapon;

        set("title",HIY"九指神丐"NOR);
        me->set("level", j);
        me->set("class", "human");
        me->set("xlzhang_agree", 1);
        me->set("dgbang_agree", 1);
	me->set_skill("unarmed", j);
	me->set_skill("dodge", j);
	me->set_skill("parry", j);
	me->set_skill("force", j);
	me->set_skill("spells", j);
 
        me->set_skill("stick", j+random(15));
        me->set_skill("dagou-bang", j+random(15));
        me->set_skill("xiaoyaoyou", j+random(15));
        me->set_skill("fumozhou", j+random(15));
        me->set_skill("xianglong-zhang", j+random(15));
        me->set_skill("jiayi-force", j+random(15));

        me->map_skill("force", "jiayi-force");
        me->map_skill("stick", "dagou-bang");
        me->map_skill("parry", "dagou-bang");
        me->map_skill("spells", "fumozhou");
        me->map_skill("dodge", "xiaoyaoyou");
        me->map_skill("unarmed", "xianglong-zhang");

	set("chat_chance_combat", cast_chance(level));
	set("chat_msg_combat", ({
        (: cast_spell, "freeze" :),
        (: perform_action,"stick", "feng" :), 
        (: perform_action,"stick", "tianxia" :), 
        (: perform_action,"unarmed", "xianglong" :), 
        (: perform_action,"unarmed", "kuang" :), 
	}) );

           weapon=new("/d/city/npc/obj/stick"); 
        if (random(2))
        weapon->set("no_break", 1);
	weapon->move(me);
        carry_object("/d/obj/stey/xianyi")->wear();
	command("wield all");
}
