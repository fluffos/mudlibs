// yg-kunlun   by piao

#include <ansi.h>
inherit __DIR__"yaoguai.lpc";

void set_skills(int j, int level)
{
        object me=this_object();
        object weapon;

        set("title",HIC"云游四海"NOR);
        me->set("level", j);
        me->set("class", "xian");
	set("gender", "男性");
        me->set_skill("unarmed", j);
        me->set_skill("dodge", j);
        me->set_skill("parry", j);
        me->set_skill("force", j);
        me->set_skill("spells", j);
 
        me->set_skill("sword", j);
        me->set_skill("spysword", j);
        me->set_skill("blade", j);
        me->set_skill("baihe-blade", j);
        me->set_skill("binfen-steps", j);
        me->set_skill("mysticism", j);
        me->set_skill("ice_fire_zhang", j);
        me->set_skill("butian-force", j);

        me->map_skill("force", "butian-force");
        me->map_skill("sword", "spysword");
        me->map_skill("blade", "baihe-blade");
        me->map_skill("parry", "spysword");
        me->map_skill("spells", "mysticism");
        me->map_skill("dodge", "binfen-steps");
        me->map_skill("unarmed", "ice_fire_zhang");

	set("chat_chance_combat", cast_chance(level));
        set("chat_msg_combat", ({
        (: perform_action,"sword", "dao" :),
        (: perform_action,"sword", "bishou" :),
        (: perform_action,"sword", "name" :),
        (: perform_action,"blade", "zongheng" :),
        (: perform_action,"blade", "qiyin" :),
        (: perform_action,"unarmed", "lr" :),
        (: cast_spell, "gold" :),
        (: cast_spell, "shengsi" :),
        }) );

        create_family("三界散仙", 2, "蓝");  
        if (random(2))
           weapon=new("/d/city/npc/obj/sword"); 
        else
           weapon=new("/d/city/npc/obj/blade"); 
        if (random(2))
        weapon->set("no_break", 1);
        weapon->move(me);
        carry_object("/d/obj/stey/xianyi")->wear();
        command("wield all");
}
