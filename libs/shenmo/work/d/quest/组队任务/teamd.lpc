#include <ansi.h>
inherit F_VENDOR_SALE;

void mission_start();
int random_exits();

nosave object *tm = ({});
mapping walks = ([
        "east" : "west",
        "west" : "east",
        "north": "south",
        "south": "north",
        "up"   : "down",
        "down" : "up",
        "enter": "out",
        "out"  : "enter",
        "northup" : "southdown",
        "southdown" : "northup",
        "northdown" : "southup",
        "southup" : "northdown",
        "northwest" : "southeast",
        "southeast" : "northwest",
        "northeast" : "southwest",
        "southwest" : "northeast",
        "westup"  : "eastdown",
        "eastdown": "westup",
]);

void create()
{
reload("team_mission"); 
set_name("组队任务",({"teamjob"}));
set("env/invisibility",1); 
setup();
}

object random_place()
{
int  m,n,i, j, k;
object temp,newob;
mapping ex;

mixed*  file, exit;
string *dirs = ({
        "/d/city",
        "/d/jjf",
        "/d/westway",
        "/d/kaifeng",
        "/d/lingtai",
        "/d/moon",
        "/d/gao",
        "/d/sea", 
        "/d/nanhai", 
        "/d/eastway",
        "/d/xueshan",
        "/d/dntg/hgs",
        
        "/d/qujing/wuzhuang", 
        "/d/qujing/baotou", 
        "/d/qujing/baoxiang", 
        "/d/qujing/bibotan",
        "/d/qujing/biqiu",
        "/d/qujing/chechi",
        "/d/qujing/dudi",
        "/d/qujing/fengxian",
        "/d/qujing/firemount",
        "/d/qujing/jilei",
        "/d/qujing/jindou",
        "/d/qujing/jingjiling",
        "/d/qujing/jinping",
        "/d/qujing/jisaiguo",
        "/d/qujing/maoying",
        "/d/qujing/nuerguo",
        "/d/qujing/pingding",
        "/d/qujing/pansi",
        "/d/qujing/tongtian",
        "/d/qujing/qilin",
        "/d/qujing/qinfa",
        "/d/qujing/qinglong",
        "/d/qujing/tianzhu",
        "/d/qujing/wudidong",
        "/d/qujing/wuji",
        "/d/qujing/xiaoxitian",
        "/d/qujing/yinwu",
        "/d/qujing/yuhua",
        "/d/qujing/zhujie",
        "/d/qujing/zhuzi",
        "/d/penglai",
        "/d/pantao",
        "/d/death",  
        "/d/meishan",
        "/d/qujing/lingshan",
});

n = 0;
i = random(sizeof(dirs));    // pick up one directory
file = get_dir( dirs[i]+"/*.lpc", -1 );
if( !sizeof(file) )
        return 0;
for(k=0;k<30;k++)
        {
        j = random(sizeof(file));
        if( file[j][1] > 0 )
                {
                newob=load_object(dirs[i]+"/"+file[j][0]);
                if ( !newob )
                        continue;
                if ( newob->query("no_fight") 
                  || newob->query("no_magic") 
                  || newob->query("no_mieyao") 
                  || !(exit=newob->query("exits")) 
                  || sizeof(keys(exit))<1 
                  || newob->query("alternative_die") )
                        continue;
                if ( !mapp(ex=newob->query("exits")) )
                        continue;
                m = sizeof(keys(ex));
                while(m--)
                        {
                        temp = load_object(ex[keys(ex)[m]]);
                        if ( temp )
                                {
                                if ( temp->query("exits/"+walks[keys(ex)[m]])!=base_name(newob) )
                                        n++;
                                }                                       
                        else    continue;
                        }
                if ( n )
                        continue;       
                if ( newob )    
                        return newob;
                }
        }
return 0;
}

varargs object random_npc(object obj)
{
object *inv,npc,where = random_place();
int i;
while( !where || sizeof(all_inventory(where))<1 )
        where = random_place();
inv = all_inventory(where);
i = sizeof(inv);
while(i--)
        {
        if ( !inv[i] || !inv[i]->is_character() 
          || inv[i]->is_fighting() 
          || !living(inv[i]) 
          || !inv[i]->query("startroom")
          || inv[i]->is_busy() )
                continue;
        if ( inv[i] )
                return inv[i];
        }
return random_npc(obj); 
}

void mission_start()
{
string str,msg;     
object key,where;

msg = "组队任务控制文件开始更新>>>>>>>>>>>>";
if ( time()<query("last_system_reset")+600 )  return;
set("last_system_reset",time());
delete("team_job_place");
if ( environment() )
        {
        environment()->delete("team_job");
        environment()->delete("exits/door");
        }

if ( !environment() )
        msg+= "组队控制文件无所在地，本次更新强制终止.\n";
        
else if ( time()<query("mission_start")+1800 )
        msg+= "距离上次任务开始不超过半小时，本次更新强制终止.\n";
else    {
        str = "最新组队任务开始于"+ctime(time())+":\n";        
        where = random_place();
        if ( !where || !this_object()->move(where) )
                msg+= "生成随机入口失败,本次更新强制终止.\n";
        else    {
                key = new(__DIR__"obj/key");
                if ( !key )
                        msg+= "生成入口钥匙失败,本次更新强制终止.\n";
                else if ( !key->find_owner() )
                        {
                        destruct(key);
                        msg+= "入口钥匙随机掉落失败,本次更新强制终止.\n";
                        }               
                else    {
                        if ( !random_exits() )
                                msg+= "杀怪地图随机生成失败，本次更新强制终止.\n";
                        else    {
                                message("channel:rumor",HIM"【千里眼】某人：听说在"HIW+MISC_D->find_place(environment())+HIM"的"HIW+environment()->query("short")+HIM"出现了一个奇怪的入口！\n"NOR,users()); 
                                environment()->set("team_job/place",1);
                                set("team_job_place",environment());
                                str+= sprintf("\t\t任务随机入口设在 %O .\n",where);
                                str+= sprintf("\t\t任务入口之匙落在随机NPC %O 的 %O 身上。\n",environment(environment(key)),environment(key));
                                set("mission_start",time());
                                save();
                                write_file("/c/任务/组队任务.log",str,1);
                                msg+= "完成!";
                      tm = ({ });
                                }
                        }
                }
        }
CHANNEL_D->do_channel( this_object(), "sys", msg);
}
        
void reset()
{
mission_start();
}

int resets()
{
object *t;
int i;  
delete("mission_start");
delete("team_job_place");
delete("last_system_reset");
tm = ({});
if ( !this_object()->save() )
     return 0;
if ( arrayp(t=query("random_place")) )
        {
        i = sizeof(t);
        while(i--)
                {
                if ( t[i] )  destruct(t[i]);
                }
        }
if ( arrayp(t=query("random_guai")) )
        {
        i = sizeof(t);
        while(i--)
                {
                if ( t[i] )  destruct(t[i]);
                }
        }
return 1;
}

void init()
{
object me = this_player();      
add_action("do_open","open");
add_action("do_go","",1);
if ( environment() && environment()->query("team_job/place") && userp(me) )
        {
        say("\n\n地面渐渐升起团团赤红的雾气，在雾气之中隐约有道神奇的铁门(door)。。。。\n\n"NOR);
          me->set_leader(0);
        }
}

int do_open(string arg)
{
object *team,*temp,who,env,key,me = this_player();
int i;
if ( wizardp(me) )  tell_object(me,"OK\n");
if ( !arg || (arg!="door"&&arg!="门") )
        return 0;
key = present("key",me);
if ( !key || !key->is_tempjob_obj() )
        return 0;
env = environment();
team = me->query_team();
if ( !team || !arrayp(team) || sizeof(team)<2 )
       return notify_fail("还是多找些人再进去吧。\n");
if ( env->query("exits/door") )
        return notify_fail("门已经开了。\n");;
if ( !env->query("team_job/place") )
        return notify_fail("这里没有门。\n");
message_vision("\n$N将钥匙插在门中，奋力一钮，“喀吧”一声，门开了！\n\n"NOR,me);
env->set("team_job/ip/"+query_ip_number(me),1);
delete("team_job_place");
message("channel:rumor",HIM"【千里眼】某人：听说"+me->query("name")+HIM"打开了"HIR"血池"HIM"的入口！\n"NOR,users()); 
me->delete_temp("teamjob/key_get");
env->set("exits/door",(query("random_place")[random(sizeof(query("random_place")))]));
temp = env->query("team_job/player");
temp = SDS_D->add_arr_obj(temp,me);
i = sizeof(team);
while(i--)
        {
        who = team[i];
        if ( who && who!=me && userp(who) && living(who)
          && !env->query("team_job/ip/"+query_ip_number(who)) )
                {
                temp = SDS_D->add_arr_obj(temp,who);
                message("team",sprintf(HIW"【组队】%s：%s(%s) 获准进入血池，入口在 %s 的 %s。\n",
                              me->query("name"),who->query("name"),
                              capitalize(who->query("id")),
                              MISC_D->find_place(env),
                              env->query("short")),team);
                env->set("team_job/player",temp);
                env->set("team_job/ip/"+query_ip_number(who),1);
                }                             
        }
tm = temp;
env->set("team_job/player",tm);
destruct(key);
return 1;
}


int err_msg(string msg)
{
write(msg);
return 1;
}       

int random_exits()
{
int i,ff=0,ss=0;
int kk;
object *ob,*where;
object w0,w1,w2,w3,w4,w5,w6,w7,w8,w9,w10,w11,w12,w13,w14,w15,w16,w17,w18,w19,w20;
object r1,r2,guai;
string di,*dis;
string name="";

w0 = clone_object(__DIR__"road");
if ( !w0 )
        return 0;
w1 = clone_object(__DIR__"road");
w2 = clone_object(__DIR__"road");
w3 = clone_object(__DIR__"road");
w4 = clone_object(__DIR__"road");
w5 = clone_object(__DIR__"road");
w6 = clone_object(__DIR__"road");
w7 = clone_object(__DIR__"road");
w8 = clone_object(__DIR__"road");
w9 = clone_object(__DIR__"road");
w10 = clone_object(__DIR__"road");
w11 = clone_object(__DIR__"road");
w12 = clone_object(__DIR__"road");
w13 = clone_object(__DIR__"road");
w14 = clone_object(__DIR__"road");
w15 = clone_object(__DIR__"road");
w16 = clone_object(__DIR__"road");
w17 = clone_object(__DIR__"road");
w18 = clone_object(__DIR__"road");
w19 = clone_object(__DIR__"road");
w20 = clone_object(__DIR__"road");

where = ({w0,w1,w2,w3,w4,w5,w6,w7,w8,w9,w10,w11,w12,w13,w14,w15,w16,w17,w18,w19,w20});
set("random_place",where);
while(ff<20)
        {
        r1 = where[ff];
        dis = keys(walks);
        di = dis[random(sizeof(dis))];
        if ( !r1->query("exits/"+di) ) 
                {
                r2 = where[ff+1];
                if ( !r2->query("exits/"+walks[di]) ) 
                        {
                        ff++;   
                        r1->set("exits/"+di,r2);
                        r2->set("exits/"+walks[di],r1);
                        }
                }
        }
CHANNEL_D->do_channel( this_object(), "rumor","开始生成随机地图>>>>>>>>>>>>>>>完成 \n");
ob = ({});
for(kk=0;kk<30;kk++)  
        {
        if ( random(2) )  
                {  
                guai = new(__DIR__"npc/evl1");
                if ( !guai )  return 0;
                SDS_D->add_arr_obj(ob,guai);
                if ( guai->move(where[random(sizeof(where))]) )
                        name+= guai->name()+"、 ";
                }
        }
guai = new(__DIR__"npc/evl2");
if ( !guai ) 
        return 0;
SDS_D->add_arr_obj(ob,guai);    
if ( guai->move(where[random(sizeof(where))]) )
        name+= guai->name();
CHANNEL_D->do_channel( this_object(), "rumor","开始生成随机怪物 : "+name+"  完成 \n");    
set("random_guai",ob);
return 1;
}

int do_go()
{
object *obs,env,me = this_player();
string arg = query_verb();

if ( arg && (arg=="door" || arg=="go door") )
        {
        env = environment();
        if ( !env->query("exits/door") 
          || !env->query("team_job/place") )
                return err_msg("什么?\n");
        obs = env->query("team_job/player");
        if ( !obs || !arrayp(obs) )
                return err_msg("这里门还没开呢，你进不去。\n");
        if ( member_array(me,obs)==-1 )
                return err_msg("你没有进入此门的资格。\n");
        me->command("team talk 我已进入血池！\n");
        return 0;
        }
else if ( arg=="gen" || arg=="follow" )  return 1;
return 0;
}

int heal_up()
{
if ( objectp(query("team_job_place")) )
      {
      if ( environment()!=query("team_job_place") )
           this_object()->move(query("team_job_place"));
      }
return ::heal_up()+1;
}

void kill_ob(object who)
{
remove_all_killer();
if ( who )  who->remove_killer(this_object());
all_inventory(environment())->remove_killer(this_object());
}

void die()
{
powerup();
}

void unconcious()
{
die();
}
