#include <ansi.h>
inherit ITEM;
#include "/cmds/std/valid_move.h"

string lvl = "";
string skill = "";

string *skills = ({
        "shaolin-sword","liangyi-sword","xiaofeng-sword",
        "shaolin-sword","liangyi-sword","xiaofeng-sword",
        "wuhu-blade","yange-blade","snowwhip",
        "wuhu-blade","yange-blade","snowwhip",
        "dagou-bang","xianglong-zhang","lixin-sword",
        "dagou-bang","xianglong-zhang","lixin-sword",
        "dugu-jiujian","feidao",                        
});

void create()
{
int k;

switch(random(10))
        {
        case 0 : k = random(500);lvl="初级入门";break;
        case 1 : k = 500+random(500);lvl="指导入门";break;
        case 2 : k = 1000+random(1000);lvl="进级入门";break;
        case 3 : k = 1500+random(1500);lvl="中级入门";break;
        case 5 : k = 2000+random(2000);lvl="高级入门";break;
        case 7 : k = 2500+random(2500);lvl="进阶入门";break;
        case 8 : k = 3000+random(3000);lvl="大成入门";break;
        case 9 : k = 5000+random(5000);lvl="终极入门";break;
        default : k = 10000+random(10000);lvl="宗师入门";break;
        }
k*= 100;
skill = skills[random(sizeof(skills))];
set_name(HIC"【"NOR YEL+to_chinese(skill)+NOR HIC"】"NOR,({"book",skill+" book"}));
set("long","一本上古遗下的技能书，读读看。。。。\n");
set("value",0);
set("unit","本");
set("pot",k);
set("skills",skill);
set("no_put",1);
set("no_give",1);
}

string short()
{
return query("name")+"("+query("id")+")"+YEL"  <"NOR+lvl+YEL">"NOR;
}
void init()
{
if ( !query("geted") ) {
     if ( userp(environment()) )  { 
              message("channel:rumor",HIM"【"HIG"千里眼"HIM"】某人："+environment()->query("name")+"("+capitalize(environment()->query("id"))+")"+"得到了上古秘籍 "HIW+to_chinese(skill)+HIM"的"+HIY+lvl+HIM"！\n"NOR,users());
              set("geted",1);
              }
      }
add_action("do_study","study");
add_action("do_study","du");
add_action("do_study","read");
}

int do_study(string arg)
{
object me = this_player();
if ( me!=environment() )
        return 0;
if ( !arg || !id(arg) )
        return 0;
if ( !valid_move(me) )
        {
        write("你现在正忙着呢。\n");
        return 1;
        }
if ( !me->query_skill("literate", 1) )
        {
        write("你是个文盲，先学学读书识字(literate)吧。\n");
        return 1;
        }
message_vision("$N撕开$n,开始研读里面关于"HIC+to_chinese(skill)+NOR"的技巧，似乎有点心得。\n",me,this_object());
me->improve_skill(skill,query("pot"));
me->start_busy(1);
destruct(this_object());
return 1;
}

