#include <ansi.h>
inherit ITEM;

#define TEAM_D "/d/quest/组队任务/teamd.lpc"

void create() {
  set_name("钥匙", ({ "key", "yaoshi", "yao shi", "shi" }));
  set_weight(4000);
  set("unit", "串");
  set("base_unit", "把");
  set("long", "一把锈迹斑斑的青铜古匙。\n");
  set("value", 0);
  set("no_put", 1);
  setup();
}

int find_owner() {
  object npc;
  npc = TEAM_D->random_npc();
  if (!npc)
    return 0;
  if (!living(npc) || !environment(npc)) {
    destruct(npc);
    return 0;
  }
  if (!this_object()->move(npc))
    return 0;
  return 1;
}

void init() {
  int i, k;
  string arg, str, arg1, str1;
  object me = this_player();
  arg = me->name();
  i = strlen(arg);
  k = random(i * 2) / 2;
  while (k % 2 != 0) k = random(i * 2) / 2;
  str = sprintf("%c%c", arg[k], arg[k + 1]);
  arg = replace_string(arg, str, "□");
  arg1 = MISC_D->find_place(environment(me));
  arg1 = SDS_D->no_color_msg(arg1);
  i = strlen(arg1);
  k = random(i * 2) / 2;
  while (k % 2 != 0) k = random(i * 2) / 2;
  str1 = sprintf("%c%c", arg1[k], arg1[k + 1]);
  arg1 = replace_string(arg1, str1, "□");
  if (environment() == me) {
    if (!me->query_temp("teamjob/key_get")) {
      me->set_temp("teamjob/key_get", 1);
      message(
        "channel:rumor",
        HIM "【千里眼】某人：听说血池的开门钥匙出现在了" HIW + arg1 + HIM "的" + WHT + arg + HIM "身上！\n" NOR,
        users()
      );
    }
  }
}

int is_tempjob_obj() {
  return 1;
}
