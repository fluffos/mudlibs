/*
======--- 四灵兽任务 Vision4.16 ---======
怪物难度以下列排名(由高到低):      
        shaolin yhg wdd moon
        youxia xs kunlun
        swordman shenjian lg
        fangcun shushan hell
        wzg emei jjf gumu
        bbt pansi dong hyd sanxian
======---  evl1.c 第一级(低)怪  ---======       
*/
#include <ansi.h>
inherit __DIR__"evl.lpc";

void create()
{
mapping names = NAME_D->random_name("yaoguai");
set_name(names["name"],names["id"]);
set("title",HIB+(names["title"]!="NONE"?names["title"]:"幽冥守卫")+NOR);

set("max_kee",1000);
set("max_sen",1000);
set("eff_kee",1000);
set("eff_sen",1000);
set("kee",1000);
set("sen",1000);
set("combat_exp",1000000);
set("env/no_msg",1);
set("daoxing",1000000);
if ( random(2) ) set("attitude", "aggressive"); 
switch(random(5))  {
       case 0 : set("die_obj","/d/quest/组队任务/obj/book2");break;
       case 4 : set("die_obj","/d/nanhai/obj/lianhua/shengji");break;
       case 1 : set("die_obj","/d/nanhai/obj/lianhua/hebing");break;
       default : set("die_obj","/d/quest/组队任务/obj/book1");break;
       }
setup();
}

int is_boss()
{
return 1;
}
