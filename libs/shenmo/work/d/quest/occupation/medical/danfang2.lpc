#include <ansi.h>
inherit ROOM;

mapping Yao = ([
//      炼成品          炼成文件                数量        材料1   材料1数量 材料2   材料2数量 经验
        "金创药"        : ({ __DIR__"yao/jinchuangyao",100,__DIR__"obj/hugu",3,__DIR__"obj/sanqi",10,1,}),
        "混元丹"        : ({ __DIR__"yao/hunyuandan",100,__DIR__"obj/hugu",3,__DIR__"obj/jinyinhua",10,1,}),
        "云南白药"      : ({ __DIR__"yao/yunnan-baiyao",100,__DIR__"obj/shexiang",3,__DIR__"obj/caowu",10,1,}),
        "碧灵丹"        : ({ __DIR__"yao/bilingdan",100,__DIR__"obj/shexiang",3,__DIR__"obj/longdancao",10,1,}),
        "金元散"        : ({ __DIR__"yao/jinyuansan",1,__DIR__"obj/xiongdan",10,__DIR__"obj/yaotonghua",10,1,}),
        "九花玉露丸"    : ({ __DIR__"yao/jiuhua",1,__DIR__"obj/shedan",10,__DIR__"obj/wangyoucao",10,2,}),
]);                              

string msg()
{
        string str;
        str = NOR"\n";
        str+= HIY"┌----------┬------------------┬----------┬----------------------┬----------┐\n"NOR;
        str+= HIY"│  "HIG"成 品   "HIY"│     "HIG"所需材料     "HIY"│ "HIG"炼得数目 "HIY"│        "HIG"功  效        "HIY"│ "HIG"炼丹等级 "HIY"│\n"NOR;
        str+= YEL"├----------┼------------------┼----------┼----------------------┼----------┤\n"NOR;
        str+= YEL"│  "NOR"金创药  "YEL"│"NOR"虎骨X3 三七X10    "YEL"│   "NOR"100    "YEL"│"NOR"治疗气血120点         "YEL"│    "NOR"10    "YEL"│\n"NOR;
        str+= YEL"├----------┼------------------┼----------┼----------------------┼----------┤\n"NOR;
        str+= YEL"│"NOR"  混元丹  "YEL"│"NOR"虎骨X3 金银花X10  "YEL"│   "NOR"100    "YEL"│"NOR"治疗精神120点         "YEL"│    "NOR"10    "YEL"│\n"NOR;
        str+= YEL"├----------┼------------------┼----------┼----------------------┼----------┤\n"NOR;
        str+= YEL"│ "NOR"云南白药 "YEL"│"NOR"麝香X3 草乌X10    "YEL"│   "NOR"100    "YEL"│"NOR"治疗气血气血各100点   "YEL"│    "NOR"10    "YEL"│\n"NOR;
        str+= YEL"├----------┼------------------┼----------┼----------------------┼----------┤\n"NOR;
        str+= YEL"│  "NOR"碧灵丹  "YEL"│"NOR"麝香X3 龙胆草X10  "YEL"│   "NOR"100    "YEL"│"NOR"治疗气血气血各500点   "YEL"│    "NOR"20    "YEL"│\n"NOR;
        str+= YEL"├----------┼------------------┼----------┼----------------------┼----------┤\n"NOR;
        str+= YEL"│  "NOR"金元散  "YEL"│"NOR"熊胆X10 妖瞳花X10 "YEL"│   "NOR"100    "YEL"│"NOR"增加攻击50，不叠加    "YEL"│    "NOR"20    "YEL"│\n"NOR;
        str+= YEL"├----------┼------------------┼----------┼----------------------┼----------┤\n"NOR;
        str+= YEL"│"NOR"九花玉露丸"YEL"│"NOR"蛇胆X10 忘忧草X10 "YEL"│   "NOR"100    "YEL"│"NOR"治疗气血气血各1000点  "YEL"│    "NOR"30    "YEL"│\n"NOR;
        str+= HIY"└----------┴------------------┴----------┴----------------------┴----------┘\n"NOR;
        return str;
}       

void create()
{
        set("short","丹房");
        set("long",@LONG
云雾氤氲的修丹所在，只见四壁上绘些分分明明的金碧影，地面上是些
香香馥馥的瑞莲花；半空中锁着那氤氤氲氲的雾霭，其中又笼着烂烂缦缦的
烟霞。对对彩鸾鸣，浑似那咿咿哑哑的律吕；双双丹凤啸，恍疑是嘹嘹的笙
笳。
    碧水跳珠点点滴滴，从两边玉女盘中泄出；虹霓流彩，闪闪灼灼自顶上
苍龙柱上飞斜。
LONG);
        set("exits",([
                "south" : __DIR__"danfang",
                "north" : __DIR__"danfang3",
        ]));
        set("item_desc",([
                "pai" : msg(),
        ]));        
        set("no_clean_up",1);
        setup();
}

void init()
{
        add_action("do_make","makeyao");
}

object check_inv(object who,string file)
{
        object *inv;
        int i;
        if( !who || !file )
                return 0;
        inv = all_inventory(who);
        for(i=0;i<sizeof(inv);i++)
        {
                if( inv[i] && base_name(inv[i])==file )
                {
                        if( inv[i]->query("type") )
                        {
                                if( inv[i]->query("type")=="成品" )
                                        return inv[i];
                        }
                        else    return inv[i];
                }               
        }
        return 0;
}               

int do_make(string arg)
{
        mixed *temp;
        string name,file,file1,file2;
        int level,num1,num2,num,pot,t1,t2;
        object ob1,ob2,yao,me = this_player();
        
        if( !arg )
        {
                write(msg());
                write("\n你想炼制那种药？\n
        1 金创药\n
        2 混元丹\n
        3 云南白药\n
        4 碧灵丹\n
        5 金元散\n
        6 九花玉露丸\n");
                return 1;
        }
        switch(arg)
        {
                case "1" : name = "金创药";level = 10;break;
                case "2" : name = "混元丹";level = 10;break;
                case "3" : name = "云南白药";level = 10;break;
                case "4" : name = "碧灵丹";level = 20;break;
                case "5" : name = "金元散";level = 20;break;
                case "6" : name = "九花玉露丸";level = 30;break;
                default :
                        write("\n你想炼制那种药？\n
        1 金创药\n
        2 混元丹\n
        3 云南白药\n
        4 碧灵丹\n
        5 金元散\n
        6 九花玉露丸\n");
                        return 1;
        }               
        if( me->is_busy() )
        {
                write("你正忙着呢。\n");
                return 1;
        }
        if( me->query_skill("liandan",1)<level )
        {
                write("你的"+to_chinese("liandan")+"等级不够，无法炼制"+name+"。\n");
                return 1;
        }       
        temp = Yao[name];
        file = temp[0];
        num = temp[1];
        file1 = temp[2];
        num1 = temp[3];
        file2 = temp[4];
        num2 = temp[5];
        pot = temp[6];
        //材料
        ob1 = check_inv(me,file1);
        if( !ob1 )
        {
                write("你身上材料不够。\n");
                return 1;
        }
        else
        {
                t1 = ob1->query_amount();
                if( t1<num1 )
                {
                        write("你身上的"+ob1->query("name")+"数量不够。\n");
                        return 1;
                }
        }
        //药材
        ob2 = check_inv(me,file2);
        if( !ob2 )
        {
                write("你身上草药不够。\n");
                return 1;
        }
        else if( ob2->query("type")!="成品" )
        {
                write(ob2->query("name")+"不是成品。\n");
                return 1;
        }
        else
        {
                t2 = ob2->query("zhong/num");
                if( t2<num2 )
                {
                        write("你身上的"+ob2->query("name")+"数量不够。\n");
                        return 1;
                }
        }
        me->start_busy(2);
        write("你将"+ob1->query("name")+"与"+ob2->query("name")+"投入丹鼎之中，只见一阵氤氤氲氲的雾霭腾起。\n");
        
        if( ob1->query_amount()>num1 )
                ob1->add_amount(-num1);
        else    destruct(ob1);
        
        if( ob2->query("zhong/num")>num2 )
                ob2->add("zhong/num",-num2);
        else    destruct(ob2);
        
        yao = new(file);
        yao->set_amount(num);
        if( !yao->move(me) )
                yao->move(this_object());
        write(HIY"你得到了"+chinese_number(num)+"颗"+yao->query("name")+"。\n"NOR);
        me->improve_skill("liandan",pot,1);
        write(HIC"你的「"+to_chinese("liandan")+"」经验提高了!\n"NOR);
        return 1;
}                                       

