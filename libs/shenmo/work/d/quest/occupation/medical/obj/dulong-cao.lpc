#include <ansi.h>
inherit __DIR__ "yc.lpc";

void create_cao() {
  set_name(HIB "毒龙草" NOR, ({ "dulong cao", "cao" }));
  set("level", 100);
  set("num", 1);
  set("Ztime", 120);
}

void setup() {
  ::setup();
  set("unit", "株");
}

void init() {
  ::init();
  add_action("do_eat", "eat");
}

int do_eat(string arg) {
  int succ = 0;
  object me = this_player();
  if (!arg || !id(arg))
    return 0;
  if (me->is_busy())
    return err_msg("你现在正忙着。\n");
  if (!wizardp(me) && query("type") != "成品")
    return err_msg("这个还没长成熟呢。\n");
  //已经吃过13株了        
  if (me->query("huanbochi/dulongcao_eat") >= 13)
    succ = -1;
  else if (random(5) == 3)
    succ = 1;

  message_vision("$N狼吞虎咽般地将一株$n吃下肚中。\n", me, this_object());
  me->start_busy(1);
  me->add("huanbochi/dulongcao_eat", 1);
  switch (succ) {
    case -1:
      message_vision("顿时$N脸色苍白，腹如刀绞，吐出一口鲜血！\n", me);
      me->delete_temp("last_damage_from");
      me->set_temp("death_msg", "食毒龙草过多，毒性发作而亡！");
      me->receive_wound("kee", 3500);
      COMBAT_D->report_status(me, 1);
      break;
    case 1:
      message_vision("$N脸上泛起阵红晕，觉得一阵热气直通七窍，浑身上下好象有使不完的力气。\n", me);
      me->add("daoxing", 150000);
      write("你得到了一百五十年的道行。\n");
      me->add("shen", 2);
      write("你得到了两点神数。\n");
      if (random(10) == 7) {
        me->add("per", 1);
        write("你得到了一点容貌天赋。\n");
      } else if (random(20) == 11) {
        me->add("spi", 1);
        write("你得到了一点灵性天赋。\n");
      }
      break;
    default:
      message_vision("$N脸上泛起阵红晕，觉得一阵热气直通七窍，觉得自己好似变强了。\n", me);
      me->add_temp("apply/armor", 5);
      break;
  }
  destruct(this_object());
  return 1;
}

string short() {
  if (query("type") != "成品")
    return sprintf("%s<%s>(%s)", query("name"), query("type"), capitalize(query("id")));
  else return sprintf("%s(%s)", query("name"), capitalize(query("id")));
}
