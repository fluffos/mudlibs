#include <ansi.h>
inherit COMBINED_ITEM;

void setup() {}

void create() {
  set_name(HIB "毒龙丸" NOR, ({ "dulong wan", "wan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "些");
    set("base_unit", "颗");
    set("long", "神女遗留的毒龙丸，乃古今最毒烈的圣药，专能降妖除怪。\n");
    set("value", 0);
    set("drug_type", "毒药");
  }
  set_amount(1);
  setup();
}

void init() {
  object me = this_player();
  if (userp(me))
    log_file(
      "dulongwan",
      ctime(time()) + " " + me->query("id") + " 在" + base_name(environment(me)) + " 得到了毒龙丸 " + query_amount() + " 个.\n"
    );
  add_action("do_guai", "apply");
}

int do_guai(string arg) {
  string id;
  object guai, me = this_player();

  if (!arg || sscanf(arg, "%s on %s", arg, id) != 2
    || !present(this_object(), me))
    return 0;
  if (!id(arg))
    return 0;
  if (time() < me->query("huanbochi/dulongwan") + 3600) {
    write(query("name") + "已经失效了。\n");
    return 1;
  }
  guai = present(id, environment(me));
  if (!guai || !guai->is_zhongkui()) {
    write(query("name") + "只能对钟馗怪使用。\n");
    return 1;
  }
  if (guai != me->query_temp("抓鬼/ob")) {
    write("这可不是你的怪。\n");
    return 1;
  }
  if (!me->is_fighting(guai)) {
    write("你没有和它战斗啊。\n");
    return 1;
  }
  message_vision(
    HIY "$N" HIY "将手一指，对着$n" HIY "祭起" + query("name") + HIY "，只见一道金光直射向$n" HIY "！\n" NOR,
    me,
    guai
  );
  if (random(10)) {
    message_vision(HIY "$N" HIY "躲闪不及，被打了个正着！\n" NOR, guai);
    guai->set("force", 10);
    guai->receive_wound("kee", guai->query("max_kee") * 2, me);
    COMBAT_D->report_status(guai, 1);
    if (random(3) == 0 || wizardp(me))
      CHANNEL_D->do_channel(
        this_object(),
        "rumor",
        me->query("name") + "使用了毒龙丸，降服了" + guai->query("name") + HIM "。" NOR
      );
  } else message_vision(HIY "结果被他躲开了。\n" NOR, me);
  if (query_amount() > 1)
    add_amount(-1);
  else destruct(this_object());
  return 1;
}
