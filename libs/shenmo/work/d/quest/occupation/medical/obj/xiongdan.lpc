inherit COMBINED_ITEM;

void setup() {}

void init() {
  add_action("do_pao", "pao");
}

int is_liandan() { return 1; }

void create() {
  set_name("熊胆", ({ "xiong dan", "dan", }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("base_unit", "个");
    set("unit", "些");
    set("long", "熊胆，是拿来泡酒的好东西。\n");
    set("base_value", 500);
  }
  set_amount(1);
  setup();
}

int do_pao(string arg) {
  string name;
  object ob, me = this_player();
  if (!arg)
    return 0;
  ob = present(arg, me);
  if (!ob || ob->is_character()) {
    write("你要将熊胆泡到哪里？\n");
    return 1;
  }
  if (!ob->query("liquid/remaining")) {
    write(ob->query("name") + "已经给喝空了。\n");
    return 1;
  }
  message_vision("$N拿出一块熊胆，运劲捏碎了，撒入$n中。\n", me, ob);
  message_vision("$N将$n拿在手中摇了两下，一股浓郁的血腥气从$n里散发出来。\n", me, ob);

  ob->set("liquid/type", "spring");
  ob->set("liquid/remaining", ob->query("max_liquid"));
  name = ob->query("liquid/name");
  if (!ob->query("old_liquid_name"))
    ob->set("old_liquid_name", name);
  else name = ob->query("old_liquid_name");
  if (strsrch(name, "熊胆") == -1)
    name = "泡过熊胆的" + name;
  ob->set("liquid/name", name);

  if (query_amount() > 1)
    add_amount(-1);
  else destruct(this_object());
  return 1;
}
