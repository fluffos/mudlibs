#include <ansi.h>
inherit COMBINED_ITEM;

void setup()
{}

void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name(NOR YEL"洗髓丹"NOR, ({"xisui dan", "dan"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "些");
                set("base_unit", "颗");
                set("long", "神女遗留的仙丹，食用一定数量后具有洗髓涤骨的功效。\n");
                set("value", 0);
                set("drug_type", "良药");
        }
        set_amount(1);
        setup();
}

int err_msg(string arg)
{
        write(arg);
        return 1;
}

int do_eat(string arg)
{
        object me = this_player();
        if( !arg || !id(arg) || !present(this_object(),me) )
                return 0;
        if( me->is_busy() || me->is_fighting() )
                return err_msg("你现在正忙着呢。\n");
        if( me->query("level")<50 || me->query("level")>200 )
                return err_msg("你吃这个简直是暴殄天物!\n");
        if( !environment(me)->is_huanbo() )
                return err_msg("此药离了幻波池便不再起效。\n");

        message_vision("$N吃下一颗洗髓丹，浑身骨骼发出一阵异响。\n",me);
        me->start_busy(1);
        me->add("huanbochi/xisuidan",1);
        if( me->query("huanbochi/xisuidan")>= 36 )
        {
                me->delete("huanbochi/xisuidan");
                me->add("level",1);
                write("你身子一挺，一股清脆的噼里啪啦之声，便是从体内传出，整个人看上去仿佛更加的健壮。\n");
                write("你的等级提升了一级。\n");
        }
        else    write("你身子一挺，一股清脆的噼里啪啦之声，便是从体内传出。\n");        

        if( query_amount()>1 )
                add_amount(-1);
        else    destruct(this_object());
        return 1;
}

string long()
{
        int i;
        if( !environment() 
         || !objectp(environment())
         || !living(environment()) )
                return ::long();
        i = environment()->query("huanbochi/xisuidan");
        i = 36-i;
        if( i>0 )
                return ::long()+"你还需要吃"+chinese_number(i)+"颗洗髓丹方起功效。\n";
}                                       
