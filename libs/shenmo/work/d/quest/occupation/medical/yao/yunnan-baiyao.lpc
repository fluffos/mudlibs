inherit COMBINED_ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name("云南白药", ({ "yunnan baiyao", "yao", "baiyao" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("base_unit", "包");
    set("unit", "些");
    set("long", "这是一包云南白药。\n");
    set("value", 100);
    set("drug_type", "良药");
  }
  set_amount(1);
  setup();
}

int do_eat(string arg) {
  if (!arg || !id(arg))
    return 0;
  if (this_player()->query("eff_sen") == this_player()->query("max_sen")
    && this_player()->query("eff_kee") == this_player()->query("max_kee")
    {
      write("你现在不需要用云南白药。\n");
      return 1;
    }
    this_player()->receive_curing("sen", 100);
    this_player()->receive_curing("kee", 100);
    message_vision("$N吃下一颗云南白药，脸色看起来好多了。\n", this_player());
    if (query_amount() > 1)
      add_amount(-1);
      else destruct(this_object());
      return 1;
  }
