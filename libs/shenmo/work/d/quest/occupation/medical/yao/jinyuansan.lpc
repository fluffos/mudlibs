inherit COMBINED_ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name("金元散", ({ "jinyuan san", "san", "jinyuan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("base_unit", "包");
    set("unit", "些");
    set("long", "这是一包金元散，服用之后可以加大你的攻击力。\n");
    set("value", 100);
    set("drug_type", "良药");
  }
  set_amount(1);
  setup();
}

int do_eat(string arg) {
  if (!arg || !id(arg))
    return 0;
  if (this_player()->query_temp("drug/jinyuan")) {
    write("你已服用过金元散了。\n");
    return 1;
  }
  this_player()->add_temp("apply/damage", 50);
  this_player()->set_temp("drug/jinyuan", 1);
  message_vision("$N吃下一颗金元散，浑身骨骼发出一阵异响。\n", this_player());
  if (query_amount() > 1)
    add_amount(-1);
  else destruct(this_object());
  return 1;
}
