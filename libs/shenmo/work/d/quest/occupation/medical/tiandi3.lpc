#include <ansi.h>
inherit ROOM;

void create()
{
        set("short","田地");
        set("long",@LONG
药田里药民们正在耕种着．一片一片的药田连结成网，小沟
小渠密布其中．
    一片药香中，有的人在种植(zhong)，有的人在收成(caiji)，
好不热闹。
LONG);
        set("exits",([
                "east" : __DIR__"tiandi2",
                "south" : __DIR__"tiandi4",
        ]));
        setup();
}

int is_zhongzhi(){ return 1; }

void reset()
{
        int i;
        object *inv;
        inv = all_inventory();
        for(i=sizeof(inv)-1; i>=0; i--)
        {
                if(inv[i]->is_character()) continue;
                if(inv[i]->is_yaocao()) continue;
                destruct(inv[i]);
        }
}       
        

void init()
{
        add_action("do_caiji","caiji");
}

int err_msg(string arg)
{
        write(arg);
        return 1;
}

string age_string(int time)
{
        int month, day, hour, min, sec;

        sec = time % 60;
        time /= 60;
        min = time % 60;
        time /= 60;
        hour = time % 24;
        time /= 24;
        day = time % 30;
        month = time / 30;
        return (month?chinese_number(month) + "月":"") + (day?chinese_number(day) + "天":"") + 
        (hour?chinese_number(hour) + "小时":"") + (min?chinese_number(min) + "分钟":"")+chinese_number(sec)+"秒";
}

int do_caiji(string arg)
{
        object ob,me = this_player();
        
        if( !arg )
                return err_msg("你要采集什么？\n");
        if( me->is_busy() )
                return err_msg("你正忙着呢。\n");
        ob = present(arg,this_object());
        if( !ob )
                return err_msg("这里没有"+arg+"。\n");
        if( ob->query("type")!="幼苗" )
                return err_msg(ob->query("name")+"还是个种子，没有这个必要。\n");          
        if( me->query_skill("liandan",1)<ob->query("level") )
                return err_msg("你的"+to_chinese("liandan")+"小于"+ob->query("level")+"级。\n");
        if( time()<ob->query("zhong/time")+ob->query("Ztime") )
                return err_msg("还需要"+age_string(ob->query("zhong/time")+ob->query("Ztime")-time())+"。\n");
        if( me->query("id")!=ob->query("zhong/owner") )
        {
                if( time()<ob->query("zhong/time")+ob->query("Ztime")+300 )
                        return err_msg("还需要"+age_string(600+ob->query("zhong/time")+ob->query("Ztime")-time())+"才过保护期。\n");   
                if( ob->query("zhong/num")<=ob->query("num")/2 )
                        return err_msg("还是给人家留条活路吧。\n");                    
                if( ob->query_temp("cai_target/"+me->query("id")) )
                        return err_msg("这个你已经采集过了。\n");
        }
        return ob->do_caiji(me);
}    
