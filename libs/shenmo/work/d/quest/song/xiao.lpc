int do_job();
int do_give();
int do_cancel();
void create() {
  set_name("萧升", ({ "xiao sheng", "xiao" }));
  set("title", HIY "金刀无敌" NOR);
  set("gender", "男性");
  set("age", 30);
  set("long", "老英雄萧振远的次子，据说其刀法上的造诣超过了乃父。
自从萧老英雄金盆洗手之后，振远镖局的大小事务都由他打理。\n");
  set("combat_exp", 900000);
  set_skill("fonxansword", 70);
  set_skill("sword", 70);
  set_skill("unarmed", 70);
  set_skill("dodge", 70);
  set_skill("blade", 120);
  set_skill("yange-blade", 120);
  set_skill("parry", 70);
  set_skill("moondance", 70);
  map_skill("dodge", "moondance");
  map_skill("sword", "fonxansword");
  map_skill("blade", "yange-blade");
  map_skill("parry", "yange-blade");
  set("force", 800);
  set("max_force", 800);
  set("force_factor", 30);
  set_weight(10000000);
  set("inquiry", ([
    "运货": (: do_job :),
    "货": (: do_job :),
    "工作": (: do_job :),
    "job": (: do_job :),
    "领赏": (: do_give :),
    "over": (: do_give :),
    "放弃": (: do_cancel :),
    "cancel": (: do_cancel :),
  ]));
  set_temp("apply/attack", 50);
  set_temp("apply/defense", 50);
  set_temp("apply/damage", 15);
  setup();
  carry_object("/d/obj/weapon/blade/jindao")->wield();
  carry_object("/d/obj/cloth/choupao")->wear();
}

void die() {
  set("eff_kee", 2200);
  set("eff_sen", 2200);
  set("kee", 2200);
  set("sen", 2200);
  set("force", 1200);
  set("mana", 2500);
}
void unconcious() {
  die();
}
string chinese_time(int t) {
  int d, h, m, s;
  string time;
  s = t % 60;
  t /= 60;
  m = t % 60;
  t /= 60;
  h = t % 24;
  t /= 24;
  d = t;
  if (d) time = chinese_number(d) + "天";
  else time = "";
  if (h) time += chinese_number(h) + "小时";
  if (m) time += chinese_number(m) + "分";
  time += chinese_number(s) + "秒";
  return time;
}
int do_job() {
  int n;
  object ob, cart;
  ob = this_player();
  n = random(sizeof(dart_area));
  if (ob->query("env/invisibility") && !wizardp(ob)) {
    command("say 是谁在和我说话？我怎么看不见！一定是神仙。");
    return 1;
  }
  if (ob->query("combat_exp") / 550000 > ob->query("level")) {
    tell_object(ob, CYN "萧升说道：您真客气，我们这小小镖局怎敢劳您大驾！\n" NOR);
    return 1;
  }
  if (ob->query_temp("in_dart")) {
    tell_object(ob, CYN "萧升说道：你不是才要了任务吗？\n" NOR);
    return 1;
  }
  /*
if ( (int)ob->query_condition("dart_limit" ) > 0 )    
        {
        tell_object(ob,CYN"萧升说道：你好象没完成任务吧。\n"NOR);
        return 1;
        }
*/
  if (ob->is_busy()) {
    tell_object(ob, CYN "你现在正忙着呢。\n" NOR);
    return 1;
  }
  if ((int)ob->query("combat_exp") < 100000) {
    message_vision(
      "$N说" + "：运我的货是件危险工作，我看" + RANK_D->query_respect(ob) + "似乎没有这能力！\n",
      this_object(),
      ob
    );
    return 1;
  }
  if ((int)ob->query_skill("force") < 60) {
    message_vision(
      "$N说" + "：运货是件危险工作，我看" + RANK_D->query_respect(ob) + "的基本内力不足！\n",
      this_object(),
      ob
    );
    return 1;
  }
  ob->set_temp("in_dart", 1);
  ob->set_temp("dart_area", dart_area[n]);
  ob->set_temp("dart_id", dart_id[n]);
  ob->set_temp("dart_name", dart_name[n]);
  //ob->apply_condition("dart_limit", 600);
  cart = new(__DIR__ "cart");
  cart->set("master", ob->query("name"));
  cart->set("masterid", ob->query("id"));
  cart->move("/d/city/zongju");
  command("nod");
  message_vision(CYN "几个伙计将货车推了出来挂上了马匹。\n" NOR, ob);
  tell_object(ob, CYN "萧升说道：你把这批武器的货送到" + dart_short[n] + "的" + dart_name[n] + "手中。\n" NOR);
  return 1;
}
int do_give() {
  int dengji;
  string msg;
  object ob;
  ob = this_player();
  dengji = (int)ob->query("level");
  dengji = dengji * 100;
  dengji = dengji * 2 / (1 + (int)ob->query("zhuanshi"));
  //加上转世相关
  if (ob->query("env/invisibility")) {
    command("say 是谁在和我说话？我怎么看不见！一定是神仙。");
    return 1;
  }
  if (!ob->query_temp("in_dart")) {
    tell_object(ob, CYN "萧升说道：我没让你运货啊？\n" NOR);
    return 1;
  }
  if (!ob->query_temp("over_dart")) {
    tell_object(ob, CYN "萧升怒道：货车没有送到地头，莫非是你吞了！？\n" NOR);
    return 1;
  }
  /*
if ( (int)ob->query_condition("dart_limit")==0 )  
        {
        tell_object(ob,CYN"萧升怒道：就你这慢吞吞的动作，还有脸来我这里要奖励！？\n"NOR);
        return 1;
        }
*/
  ob->delete_temp("in_dart");
  ob->delete_temp("over_dart");
  ob->delete_temp("dart_name");
  ob->delete_temp("dart_id");
  ob->delete_temp("dart_area");
  if (ob->query("weiwang") < 100) {
    ob->add("combat_exp", random(4000) + 8000);
    ob->add("potential", random(800) + 1200);
    ob->add("balance", random(90000) + 50000);
    ob->add("daoxing", random(4000) + 8000);
    ob->add("weiwang", 5);
    msg = ob->name() + "完成了一次运货任务得到了奖励";
    MONITOR_D->report_system_msg(msg);
    message_vision("$N说道" + "：" + RANK_D->query_respect(ob) + "果然是把好手，好样的。\n", this_object(), ob);
    tell_object(ob, HIC "但是你的" HIR "门派威望" HIC "太少，我不能给你全额的佣金了，你先拿这点用吧！\n" NOR);
  } else {
    ob->add("combat_exp", random(dengji) + 50000);
    ob->add("potential", random(20000) + 5000);
    ob->add("balance", random(200000) + 100000);
    ob->add("daoxing", random(dengji) + 50000);
    ob->add("weiwang", -100);
    msg = ob->name() + "在兵器铺得到了萧萧的全额奖励";
    MONITOR_D->report_system_msg(msg);
    command("pat " + ob->query("id"));
    message_vision(
      "$N说道" + "：" + RANK_D->query_respect(ob) + "真的十分感谢你能帮助我运货到那边，太麻烦您了。\n",
      this_object(),
      ob
    );
    tell_object(ob, HIC "这是您的" HIY "全额佣金" HIC "，希望您下次再来帮我送货，我们很需要你这样的人才！\n" NOR);
  }
  //ob->apply_condition("dart_limit", 0);
  return 1;
}
// passion add
int do_cancel() {
  object ob;
  ob = this_player();
  if (ob->query("env/invisibility")) {
    command("say 是谁在和我说话？我怎么看不见！一定是神仙。");
    return 1;
  }
  if (!ob->query_temp("in_dart")) {
    tell_object(ob, CYN "萧升说道：搞什么搞，你有没有领过任务？\n" NOR);
    return 1;
  }
  ob->delete_temp("in_dart");
  ob->delete_temp("dart_area");
  ob->delete_temp("dart_id");
  ob->delete_temp("dart_name");
  ob->add("weiwang", -5);
  if (ob->query("weiwang") < 0)
    ob->set("weiwang", 0);
  //ob->clear_condition("dart_limit");
  command("sigh");
  message_vision(CYN "算了算了，再给你一次机会吧。\n" NOR, ob);
  tell_object(ob, CYN "萧升说道：下次好好做，别在丢东西了。\n" NOR);

  return 1;
}
