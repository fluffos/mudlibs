#include <ansi.h>

inherit NPC;

#include "robber.h"

void create()

{ 

        set_name("劫匪",({"robbers"}));

        set("long","这是一位月宫弃徒。\n");

        set("title","拦路抢劫");

        set("gender", "女性" );

        set("color", HIW );
        set("class","xian"); 
set("str",40);
set("per",40);
set("int",40);

        set("age", random(10)+18);
  create_family("月宫",2 , "弟子"); 

        

        set("vendetta/authority", 1);

set("bellicosity", 1000);

        set("max_kee", 2000);

        set("eff_kee", 2000);

        set("kee", 900);

        set("max_sen", 900);

        set("sen", 500);

        set("force", 500);

        set("max_force", 500);

        set("jiali", 20);

        set("combat_exp", 500000);



        set_skill("force", 100); 

        set_skill("unarmed", 100);

        set_skill("dodge", 100);

        set_skill("parry", 100);

     

        setup();

       carry_object("/d/moon/obj/snow_sword")->wield();

       carry_object("/d/obj/cloth/luoyi")->wear();

}



void do_change(object ob)

{

      object me;

      mapping hp_status, skill_status;

      string *sname;

      int i, temp;

      me = this_object();

//      ob = this_player();       

      if ( mapp(skill_status = me->query_skills()) ) {

                skill_status = me->query_skills();

                sname  = keys(skill_status);

                temp = sizeof(skill_status);

                for(i=0; i<temp; i++) {

                        me->delete_skill(sname[i]);

                }

      }



      if ( mapp(skill_status = ob->query_skills()) ) {

                skill_status = ob->query_skills();

                sname  = keys(skill_status);

                temp = skill_status[0];

                for(i=0; i<sizeof(skill_status); i++) {

                if(sname[i]=="force")i++;

        if (i>0 && i <sizeof(skill_status))
        {
                  if (skill_status[sname[i]] >= temp)

                  { temp = skill_status[sname[i]];}
        }

              }

        }



        set_skill("literate", temp);

        set_skill("unarmed", temp);

        set_skill("dodge", temp);

        set_skill("force", temp);

        set_skill("parry", temp);

        set_skill("sword", temp);

        set_skill("spells", temp);

        set_skill("moonshentong", temp);

        set_skill("baihua-zhang", temp);

        set_skill("moonforce", temp);

        set_skill("snowsword", temp);

        set_skill("moondance", temp);

        set_skill("whip", temp);

        map_skill("spells", "moonshentong");

        map_skill("unarmed", "baihua-zhang");

        map_skill("force", "moonforce");

        map_skill("sword", "snowsword");

        map_skill("parry", "snowsword");

        map_skill("dodge", "moondance");

set("chat_chance_combat", 90);

   set("chat_msg_combat", 

   ({

     (: cast_spell, "shiyue" :),
     (: cast_spell, "arrow" :),
     (: cast_spell, "qingwang" :),
     (: cast_spell, "invocation" :),
     (: cast_spell, "mihun" :),

(: perform_action, "sword","tian" :), 
(: perform_action, "sword","one" :), 
(: perform_action, "unarmed","flower" :), 

   }) );





/*

 if( random(ob->query("zhuanshi")) ) {    
		ob->set_temp("no_move/start",time());
		ob->set_temp("no_move/time",random((temp -100))/3+1);
		message_vision(HIC"$N低头轻声念了句咒文，又抬起头来朝$n妩媚地一笑！\n"NOR+HIR "$n神不守舍地看着$N，怜香惜玉之心由然而起，竟然忘了自己在战斗之中。\n" NOR,me, ob);
	}
*/

/* copy hp */



        hp_status = ob->query_entire_dbase();

        me->set("str", hp_status["str"]+random(2));

        me->set("int", hp_status["int"]);

        me->set("con", hp_status["con"]+random(2));

        me->set("daoxing", hp_status["daoxing"]+random(2000000));

        me->set("combat_exp",hp_status["combat_exp"]+random(2000000));

        me->set("max_force", hp_status["max_force"]+random(5000));

        me->set("force", hp_status["force"]+random(10000));
        me->set("level", hp_status["level"]+random(100));

        me->set("max_mana", hp_status["max_mana"]+random(5000));

        me->set("mana", hp_status["mana"]+random(10000));

        me->set("mana_factor", hp_status["max_mana"]/60+random(100));
        me->set("max_kee", hp_status["max_kee"]*5+random(10000));

        me->set("eff_kee", hp_status["max_kee"]*5+random(10000));

        me->set("kee", hp_status["max_kee"]*5+random(10000));

        me->set("max_sen", hp_status["max_sen"]*5+random(10000));

        me->set("eff_sen", hp_status["max_sen"]*5+random(10000));

        me->set("sen", hp_status["max_sen"]*5+random(10000));

}

// passion add

void die()

{
object me = this_object();


if (random(2)|| random(query("zhuanshi_cnt")) )    full_me(me);
else if( environment() ) {

        message("sound", 

"\n\n只听一声惨叫，劫匪化成一滩血水......\n\n", environment());
     destruct(this_object()); 
        }
else     destruct(this_object()); 



}




