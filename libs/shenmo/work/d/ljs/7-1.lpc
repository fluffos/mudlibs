void hgs_start()
{
object ss;
   message("channel:chat",YEL"【花果山】"+CYN+"花果山上空乌云密布，杀气冲天！！\n"NOR,users());
ss = new("/u/xdao/hgs/npc/hgsshanshen.lpc");
if(ss)
    {
     ss->move("/u/xdao/hgs/hgs");
     ss->set_temp("hgs_start",1);
     CHANNEL_D->do_channel(this_object(),"sys", "开启花果山战役。");
     }
else CHANNEL_D->do_channel(this_object(),"sys", "开启花果山战役失败！");
}

