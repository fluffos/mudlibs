#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", "两界山山顶");
         set ("long", @LONG
走到此处眼前豁然开朗，居然是一处开阔的平地，对面的墙壁上。
赫然挂着一副如来亲手写下的镇妖帖(seal)，原来这才是此山封印。
的核心所在！你不禁想到：如能揭开(jie)此符是否就能让妖猴脱困？
你不由得跃跃欲试。 
LONG);
                     
set("exits", ([
     "down": __DIR__"6-8",           
        ]));

	set("item_desc", ([
		"seal"   : "一张如来亲手所书的佛帖，上面写着“唵嘛呢叭咪吽”六个大字！金光闪耀！\n",
	]));
  set("outdoors",__DIR__"");
  set("fengyin",10000);
        setup();
}

void init()
{
add_action("do_jie","jie");
}

int do_jie(string arg)
{
      string msg;
	object me,ob;
      int mana;
      ob=this_object();
	me=this_player();
	if(!arg || arg!="seal") return notify_fail("你要干嘛？\n");
      if (me->is_busy()) return notify_fail("你太忙了！\n");
//    if(ob->query("fengyin") < 10) return notify_fail("封印已经消失了！\n");
      if (!me->query_temp("ljs_begin")) return notify_fail("你是怎么进来的！\n");
      mana = me->query("mana_factor");
      ob->add("fengyin",-mana);
       if(ob->query("fengyin") > 0)
        {
	message_vision(HIC"$N运起法力挥手向佛帖一抹，一阵佛光荡漾，封印之力似乎减弱了！\n",me);
 ob->add("fengyin",-1100);
  me->start_busy(3);
        }
      else
        {
	message_vision(HIY"$N运起法力挥手向佛帖一抹，只听西方极乐传来一声叹息，眼前金光乱闪，佛帖消失的无影无踪！\n",me);
	tell_object(me,"你不禁想到：难道闯祸了？！。\n");
       call_out("out1",1,me,ob);
 me->start_busy(20);
        }
	return 1; 
}

void out1(object me,object ob)
{
remove_call_out("out1");
message("channel:chat",YEL"【两界山上】"+CYN+"孙悟空：哈哈哈哈！如来！佛帖已失，你是困不住我的。俺老孙要出来啦！！\n"NOR,users());
message("channel:chat",YEL"【两界山上】"+CYN+"孙悟空用力挣扎，整个两界山隆隆作响，声音直传三界!\n"NOR,users());
       call_out("out2",3,me,ob);
 }

void out2(object me,object ob)
{
string msg;
object sun, tudi,newtudi;
object *player;
int m,i;
player = users();
m=sizeof(player);
remove_call_out("out2");
message("channel:chat",YEL"【两界山上】"+CYN+"两界山摇晃的越来越厉害，突然[呯]的一声，一团金光从中间蹦了出来！\n"NOR,users());
message("channel:chat",YEL"【两界山上】"+CYN+"孙悟空仰天长啸：哈哈！俺老孙出来啦！俺老孙出来啦!\n"NOR,users());
sun = new("/u/xdao/ljs/npc/sunwukong.lpc");
if(sun) sun->move(ob);
       write(HIY"金光落在了平地上，仔细一瞧，是一只相貌俊美的猴子，猴子不停的抓耳搔头，显的兴奋至极！\n"NOR);
	//message_vision(HIY"金光落在了平地上，仔细一瞧，是一只相貌俊美的猴子，猴子不停的抓耳搔头，显的兴奋至极！\n",users());
if(me&&environment(me)==ob)
    {
     msg = HIY"猴子冲着$N咧嘴一笑说道：俺就是齐天大圣孙悟空，多谢你救我脱困。\n"NOR;
   if(me->query("family/family_name")=="方寸山三星洞"&&!me->query("fangcun/qiankun_accept")&&me->query("combat_exp",1) > 5000000)
                   {
     msg += HIY"孙悟空突然眼睛一亮：原来你也是菩提老师的弟子！不知恩师一切可好?\n"NOR;
     msg += HIY"孙悟空面现悲切之态：恩师原本不让俺说是他的弟子！俺惹下滔天大祸，不知恩师是否受牵连?\n"NOR;
     msg += HIY"孙悟空一把抓住$N的手：既然你是恩师的弟子，咱们也不算外人！传你一套"+HIR+"霹雳三打"+HIY+"，带回山门算是俺老孙报答师门。\n"NOR;
     msg += HIY"孙悟空一指点向$N的额头：凝神静气！仔细参悟！\n"NOR;
     message_vision(msg,me);
     me->set("fangcun/qiankun_accept","done");
     tell_object(me, HIM"恭喜你得到了霹雳三打真传！\n"NOR);
                    }
   else if(me->query("family/family_name")=="东海龙宫"&&!me->query("longgong/bailong_accept")&&me->query("combat_exp",1) > 5000000)
                   {
     msg += HIY"孙悟空突然眼睛一亮：原来你是东海龙宫的弟子！\n"NOR;
     msg += HIY"孙悟空面现怀念之态：当年在龙宫借了千钧棒，这棒子对我帮助不小。\n"NOR;
     msg += HIY"孙悟空一把抓住$N的手：既然你是龙宫弟子，咱们也不算外人！传你"+HIR+"庐山百龙霸"+HIY+"神功，算是俺对龙王的报答。\n"NOR;
     msg += HIY"孙悟空一指点向$N的额头：凝神静气！仔细参悟！\n"NOR;
     message_vision(msg,me);
     me->set("longgong/bailong_accept","done");
     tell_object(me, HIM"恭喜你领悟了庐山百龙霸！\n"NOR);
                    }
else if(me->query("family/family_name")=="五庄观"&&!me->query("wzg/wanxiang_accept")&&me->query("combat_exp",1) > 5000000)
  {
 msg += HIY"孙悟空突然眼睛一亮：原来你是大仙的弟子！不知兄长一切可好?\n"NOR;
 msg += HIY"孙悟空一把抓住$N的手：既然你是五庄观弟子，咱们也不算外人！传你"+HIR+"包罗万象"+HIY+"神功，算是俺对兄长的报答。\n"NOR;
 message_vision(msg,me);
 me->set("wzg/wanxiang_accept","done");
tell_object(me, HIM"恭喜你领悟了包罗万象！\n"NOR);
   }
else if(me->query("family/family_name")=="盘丝洞"&&!me->query("pansi/xunta_accept")&&me->query("combat_exp",1) > 5000000)
  {
 msg += HIY"孙悟空突然眼睛一亮：原来你是盘丝洞的弟子！\n"NOR;
msg += HIY"孙悟空面现怀念之态：她还好吗？\n"NOR;
 msg += HIY"孙悟空一把抓住$N的手：既然你是盘丝洞弟子，咱们也不算外人！传你"+HIR+"梦里寻他"+HIY+"神功，给你师傅看看。\n"NOR;
 msg += HIY"孙悟空一指点向$N的额头：凝神静气！仔细参悟！\n"NOR;
  message_vision(msg,me);
 me->set("pansi/xunta_accept","done");
 tell_object(me, HIM"恭喜你领悟了梦里寻他！\n"NOR);
 }
     else 
                {
         msg += HIY"孙悟空想了一想，从脑后拔下一根猴毛递给$N。\n"NOR;
         msg += HIY"孙悟空对$N说道：送你一根毫毛，危险之时能救你性命。\n"NOR;
         message_vision(msg,me);
         me->add("obstacle/rebirth", -1);
     tell_object(me, HIM"恭喜你得到了一根救命毫毛！\n"NOR);
                }
       }
     write(HIY"孙悟空喝到：此事已了，俺回花果山看孩儿们去了！说罢一个筋斗，不见了踪影！\n"NOR);
	//message_vision(HIY"孙悟空喝到：此事已了，俺回花果山看孩儿们去了！说罢一个筋斗，不见了踪影！\n",users());
    if(sun) destruct(sun);
      for(i=0;i<m;i++){
          if(player[i]->query_temp("ljs_begin"))
               {
                player[i]->delete_temp("ljs_begin");
                player[i]->move("/d/city/kezhan");
                }
                       }
        ob->set("fengyin",10000);
        // dammy 2010-12-29
      // tudi=find_object("ljs tudi");
      tudi = find_living("ljs tudi");
     //  if(tudi) destruct(tudi);
     if(tudi) tudi->reset();
       else{
       		CHANNEL_D->do_channel(this_object(),"sys", "错误！找不到两界山土地。");
       newtudi = new("/u/xdao/ljs/npc/ljstudi.lpc");
       if(newtudi) newtudi->move("/u/xdao/ljs/ljs");
       else CHANNEL_D->do_channel(this_object(),"sys", "两界山土地读取错误。");
      }
       CHANNEL_D->do_channel(this_object(),"sys", "重置两界山战役。");
       call_out("hgs_fc",10);
}

void hgs_fc()
{
message("channel:chat",MAG"【斜月三星洞内】"+CYN+"菩提祖师团膝而座，闭目养神。\n"NOR,users());
call_out("hgs_fc1",3);
}

void hgs_fc1()
{
message("channel:chat",MAG"【斜月三星洞内】"+CYN+"晨月慌慌张张跑了进来：师祖！师祖！孙师兄从五行山下脱困出来了！\n"NOR,users());
call_out("hgs_fc2",3);
}

void hgs_fc2()
{
message("channel:chat",MAG"【斜月三星洞内】"+CYN+"菩提祖师睁开眼睛微微叹了口气：哎！这孽障刑期未满就脱困而出，未必是好事！\n"NOR,users());
call_out("hgs_fc3",3);
}

void hgs_fc3()
{
message("channel:chat",MAG"【斜月三星洞内】"+CYN+"云阳真人走了进来：菩提师兄有礼！依老道看这未必不是悟空的机缘所至。\n"NOR,users());
call_out("hgs_fc4",3);
}

void hgs_fc4()
{
message("channel:chat",MAG"【斜月三星洞内】"+CYN+"云阳真人顿了顿又说道：不过悟空昔日无法无天，仇家甚多。如今脱困恐他人心升歹意。\n"NOR,users());
call_out("hgs_fc5",3);
}

void hgs_fc5()
{
message("channel:chat",MAG"【斜月三星洞内】"+CYN+"菩提祖师点了点头：这点我已料到，也罢！传我法旨，方寸山众弟子前往花果山保护悟空。\n"NOR,users());
call_out("hgs_fc6",3);
}

void hgs_fc6()
{
  message("system",HIW"〖"+HIR+"方寸山三星洞"+HIW+"〗"+HIY+"云阳真人"+CYN"：祖师有令，方寸弟子即刻前往花果山保护孙悟空。\n"NOR,users());
call_out("hgs_pt",10);
}

void hgs_pt()
{
message("channel:chat",MAG"【潮音洞内】"+CYN+"观音菩萨跌坐莲花之上讲经念法。\n"NOR,users());
call_out("hgs_pt1",3);
}

void hgs_pt1()
{
message("channel:chat",MAG"【潮音洞内】"+CYN+"黑熊怪摇摇摆摆的走了进来对观音菩萨行了个佛礼：菩萨，两界山已毁孙悟空脱困而出。\n"NOR,users());
call_out("hgs_pt2",3);
}

void hgs_pt2()
{
message("channel:chat",MAG"【潮音洞内】"+CYN+"观音菩萨：此事佛祖业已知晓，此乃天命，悟空命中注定为我佛门护法。\n"NOR,users());
call_out("hgs_pt3",3);
}

void hgs_pt3()
{
message("channel:chat",MAG"【潮音洞内】"+CYN+"观音菩萨：如今三界纷乱，我佛门正好借此事一洗尘世罪孽。\n"NOR,users());
call_out("hgs_pt4",3);
}

void hgs_pt4()
{
message("channel:chat",MAG"【潮音洞内】"+CYN+"观音菩萨起身：佛门弟子也该入世度劫了，传令下去吧。\n"NOR,users());
call_out("hgs_pt5",3);
}

void hgs_pt5()
{
  message("system",HIW"〖"+HIR+"南海普陀山"+HIW+"〗"+HIY+"黑熊怪"+CYN"：菩萨有旨，凡佛门弟子速速前往花果山救回孙悟空。\n"NOR,users());
call_out("hgs_wzg",10);
}

void hgs_wzg()
{
message("channel:chat",MAG"【人参果树下】"+CYN+"镇元大仙正在参禅打坐，忽然念头一动，掐指一算，随即传音：清风、明月进来。\n"NOR,users());
call_out("hgs_wzg1",3);
}

void hgs_wzg1()
{
message("channel:chat",MAG"【人参果树下】"+CYN+"清风、明月二童子走了进来，对着大仙行了个礼：祖师唤我等有何事。\n"NOR,users());
call_out("hgs_wzg2",3);
}

void hgs_wzg2()
{
message("channel:chat",MAG"【人参果树下】"+CYN+"镇元大仙拂尘一挥：我那结拜义弟孙悟空如今正有一劫，我为兄长不能不救。\n"NOR,users());
call_out("hgs_wzg3",3);
}

void hgs_wzg3()
{
message("channel:chat",MAG"【人参果树下】"+CYN+"镇元大仙：传令下去，五庄观门徒立即前往花果山，我随后就到。\n"NOR,users());
call_out("hgs_wzg4",3);
}

void hgs_wzg4()
{
  message("system",HIW"〖"+HIR+"万寿山五庄观"+HIW+"〗"+HIY+"清风"+CYN"：众位师兄师姐孙师叔有难，祖师唤我等前往花果山救助。\n"NOR,users());
call_out("hgs_lg",10);
}

void hgs_lg()
{
message("channel:chat",RED"【东海水晶宫】"+GRN+"东海龙王正在与众家眷嬉笑取乐，忽然龟丞相连滚带爬的跑了过来。\n"NOR,users());
call_out("hgs_lg1",3);
}

void hgs_lg1()
{
message("channel:chat",RED"【东海水晶宫】"+GRN+"龟丞相：报...报告陛下，大事不好了！孙猴子从五行山下脱困出来了！现正在花果山作乐！\n"NOR,users());
call_out("hgs_lg2",3);
}

void hgs_lg2()
{
message("channel:chat",RED"【东海水晶宫】"+GRN+"敖广一听吓的连忙拉起龟丞相：你说什么？！孙猴子出来了！这可如何是好。。。\n"NOR,users());
call_out("hgs_lg3",3);
}

void hgs_lg3()
{
message("channel:chat",RED"【东海水晶宫】"+GRN+"敖广急的原地团团转，旁边敖广之妻却神色自如。\n"NOR,users());
call_out("hgs_lg4",3);
}

void hgs_lg4()
{
message("channel:chat",RED"【东海水晶宫】"+GRN+"敖广之妻：陛下何必着急，之前乃是因为我龙宫人才凋零，才被那只猴子欺上门来。\n"NOR,users());
call_out("hgs_lg5",3);
}

void hgs_lg5()
{
message("channel:chat",RED"【东海水晶宫】"+GRN+"敖广之妻：现如今我龙宫实力强大，猴子出来也好，正要报五百年前夺我龙宫镇海神铁之仇。\n"NOR,users());
call_out("hgs_lg6",3);
}

void hgs_lg6()
{
message("channel:chat",RED"【东海水晶宫】"+GRN+"敖广一听脸上大放光彩：哈哈！还是爱妻想的周到，来人哪！传令下去大军发往花果山。\n"NOR,users());
call_out("hgs_lg7",3);
}

void hgs_lg7()
{
message("channel:chat",RED"【东海水晶宫】"+GRN+"敖广一边传令一边伏着妻子进了内室。。。\n"NOR,users());
call_out("hgs_lg8",3);
}

void hgs_lg8()
{
  message("system",HIW"〖"+HIR+"东海龙宫"+HIW+"〗"+HIY+"鲸无敌"+CYN"：龙宫弟子听令,随我出军。誓要铲平花果山。\n"NOR,users());
call_out("hgs_hell",10);
}

void hgs_hell()
{
message("channel:chat",RED"【九幽地府】"+GRN+"阎罗王正伏在案头上批着生死簿。。。少顷 阎罗王问旁边的判官\n"NOR,users());
call_out("hgs_hell1",3);
}

void hgs_hell1()
{
message("channel:chat",RED"【九幽地府】"+GRN+"阎罗王：判官,近日阳间有何动静？\n"NOR,users());
call_out("hgs_hell2",3);
}

void hgs_hell2()
{
message("channel:chat",RED"【九幽地府】"+GRN+"判官：启禀王上，听小鬼们说，五百年前大闹地府的孙悟空脱困出来了。\n"NOR,users());
call_out("hgs_hell3",3);
}

void hgs_hell3()
{
message("channel:chat",RED"【九幽地府】"+GRN+"阎罗王啪的一声居然不小心把手中的判官笔折断了：混蛋！这么重要的事为什么不早报上来。\n"NOR,users());
call_out("hgs_hell4",3);
}

void hgs_hell4()
{
message("channel:chat",RED"【九幽地府】"+GRN+"判官面色疾苦：这。。地藏王菩萨说此事因果已了，随那只猴子去。\n"NOR,users());
call_out("hgs_hell5",3);
}

void hgs_hell5()
{
message("channel:chat",RED"【九幽地府】"+GRN+"阎罗王啪的一下把生死簿仍在了判官的脸上。\n"NOR,users());
call_out("hgs_hell6",3);
}

void hgs_hell6()
{
message("channel:chat",RED"【九幽地府】"+GRN+"阎罗王：气煞我也！当初猴子闹来之时也不见这老鬼出面！佛门中人俱不可信。\n"NOR,users());
call_out("hgs_hell7",3);
}

void hgs_hell7()
{
message("channel:chat",RED"【九幽地府】"+GRN+"阎罗王：不行！这猴子当初欺我太甚，此仇不能不报！速与我去找冥王商量计策。\n"NOR,users());
call_out("hgs_hell8",3);
}

void hgs_hell8()
{
message("channel:chat",RED"【九幽地府】"+GRN+"阴间十王与冥王低头商议。。。如此这般。。这般。。\n"NOR,users());
call_out("hgs_hell9",3);
}

void hgs_hell9()
{
  message("system",HIW"〖"+HIR+"阎罗地府"+HIW+"〗"+HIY+"阎罗王"+CYN"：地府弟子听令！随我前去花果山剿灭妖猴。\n"NOR,users());
call_out("hgs_xs",10);
}

void hgs_xs()
{
message("channel:chat",RED"【雪山之巅】"+GRN+"孔雀公主正在练剑，练到兴头，忽听旁边有人鼓掌：女儿的百鸟剑法越来越精妙了。\n"NOR,users());
call_out("hgs_xs1",3);
}

void hgs_xs1()
{
message("channel:chat",RED"【雪山之巅】"+GRN+"孔雀公主一看原来是大鹏明王，公主把剑一收扑在明王的怀里撒娇：义父出关也不告知孩儿。\n"NOR,users());
call_out("hgs_xs2",3);
}

void hgs_xs2()
{
message("channel:chat",RED"【雪山之巅】"+GRN+"大鹏明王呵呵直笑：莫闹，莫闹，义父闭关期间我大雪山一切可好？\n"NOR,users());
call_out("hgs_xs3",3);
}

void hgs_xs3()
{
message("channel:chat",RED"【雪山之巅】"+GRN+"孔雀公主狡黠一笑：咱们大雪山不惹别人就算了，谁还敢来咱们？\n"NOR,users());
call_out("hgs_xs4",3);
}

