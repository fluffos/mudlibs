#include <ansi.h>;
inherit ROOM;
void create() {
  set("short", "第一层妖王府");
  set("long", @LONG
这里是守护第一层的驱神大圣禺狨王的洞府，更是通往第二层的必经之路。
洞府四周刻有七大圣结拜时的石刻， 禺狨王端坐在石塌之上，周围小妖纷纷
端茶送果，献媚不已。
LONG);

  set("exits", ([
    "up": __DIR__ "2-1",
    "east": __DIR__ "1-7",
  ]));

  set("objects", ([
    "/u/xdao/ljs/npc/yao-1.lpc": 2,
    "/u/xdao/ljs/npc/boss-1.lpc": 1,
  ]));

  setup();
}

int valid_leave(object who, string dir) {
  object wang = present("yu rong wang", this_object());

  if (dir == "east")
    return ::valid_leave(who, dir);

  if (wang)
    return notify_fail(HIB "禺狨王身子一晃拦在了你的面前！\n" NOR);
  return ::valid_leave(who, dir);
}
