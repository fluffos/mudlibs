  ]));
  set("outdoors", __DIR__ "");
  set("no_time", 1);
  set("no_fight", 1);
  set("no_get", 1);
  set("no_bian", 1);
  set("no_clean_up", 1);
  set("no_magic", 1);
  set("freeze", 1);
  setup();
}
