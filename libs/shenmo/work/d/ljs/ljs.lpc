inherit ROOM;
#include <ansi.h>;
void create() {
  set("short", "两界山");
  set("long", @LONG
此处便是两界山，相传500年前天降巨石，状如手掌，故为五行山。
又因此山位临大唐与西域各国的交界处，又称两界山。
山下镇压了一只妖猴，妖猴神通广大，虽被镇压但与其结拜的妖族7大圣。
在此守护，等待其脱困。久而久之此处便妖魔横行，乌烟瘴气。 
LONG);

  set("exits", ([
    "westup": "/d/qujing/shuangcha/shanlu1",
    "eastdown": "/d/westway/jiayu",
  ]));

  set("objects", ([
