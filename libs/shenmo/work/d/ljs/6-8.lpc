#include <ansi.h>;
inherit ROOM;
void create() {
  set("short", "第六层妖王府");
  set("long", @LONG
这里是守护第四层的平天大圣牛魔王的洞府，更是通往第七层的必经之路。
洞府四周刻有七大圣结拜时的石刻， 牛魔王端坐在石塌之上，周围小妖纷纷
端茶送果，献媚不已。
LONG);

  set("exits", ([
    "up": __DIR__ "7-1",
    "west": __DIR__ "6-7",
  ]));

  set("objects", ([
    "/u/xdao/ljs/npc/yao-6.lpc": 2,
    "/u/xdao/ljs/npc/boss-6.lpc": 1,
  ]));

  setup();
}

int valid_leave(object who, string dir) {
  object wang = present("niu mo wang", this_object());

  if (dir == "west")
    return ::valid_leave(who, dir);

  if (wang)
    return notify_fail(HIB "牛魔王身子一晃拦在了你的面前！\n" NOR);
  return ::valid_leave(who, dir);
}
