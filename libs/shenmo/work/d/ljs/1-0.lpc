inherit ROOM;
#include <ansi.h>;
void create() {
  set("short", "两界山山脚");
  set("long", @LONG
此处便是两界山，相传500年前天降巨石，状如手掌，故为五行山。
又因此山位临大唐与西域各国的交界处，又称两界山。
山下镇压了一只妖猴，妖猴神通广大，虽被镇压但与其结拜的妖族7大圣。
在此守护，等待其脱困。久而久之此处便妖魔横行，乌烟瘴气。 
LONG);

  set("exits", ([
    "west": __DIR__ "1-1",
  ]));

  set("objects", ([
    "/u/xdao/ljs/npc/tudi.lpc": 1,
  ]));
  setup();
}

int valid_leave(object who, string dir) {
  if (time() - who->query_temp("ljs_die") < 30)
    return notify_fail(HIW "休息一下再去吧！\n" NOR);
  return ::valid_leave(who, dir);
}
