inherit NPC;
#include <ansi.h>

void create()
{
int i,j;
i=120;
j=50;
	set_name(HIB"小妖"NOR, ({ "xiao yao", "yao"}));
	set("long", @LONG
一只七大圣座下的小妖
LONG);
  set("gender", random(2)?"男性":"女性");
      set("title",HIG"覆海大圣座下"NOR);
	set("age", 30);
	set("max_kee", 3000);
	set("max_sen", 3000);
	set("force", 3000);
	set("max_force", 3000);
	set("force_factor", 120);
	set("max_mana", 3000);
	set("mana", 2000);
	set("mana_factor", 120);
       add_temp("apply/damage", 100+random(50));
       add_temp("apply/armor", 150+random(150));
       add_temp("apply/armor_vs_force",150+random(150));
       add_temp("apply/armor_vs_spells",150+random(150));
	set("combat_exp", 3000000);
	set("daoxing", 3000000);
       set("baolv", 9);
       set("haveexp",200);
   set("family/family_name", "东海龙宫");
        set_skill("unarmed", i+random(j));
        set_skill("dodge", i+random(j));
        set_skill("parry", i+random(j));
        set_skill("force", i+random(j));
        set_skill("spells", i+random(j));
 
        set_skill("fork", i+random(j));
        set_skill("fengbo-cha", i+random(j));
        set_skill("dragonstep", i+random(j));
        set_skill("dragonfight", i+random(j));
        set_skill("dragonforce", i+random(j));
        set_skill("seashentong", i+random(j));

        map_skill("force", "dragonforce");
        map_skill("fork", "fengbo-cha");
        map_skill("parry", "fengbo-cha");
        map_skill("spells", "seashentong");
        map_skill("dodge", "dragonstep");
        map_skill("unarmed", "dragonfight");
	setup();
        carry_object("/d/obj/weapon/18weapon.lpc")->wield();
}
void kill_ob(object ob)
{
 object me = this_object();
  set_temp("my_killer",ob);
  ::kill_ob(ob);
}

void heart_beat()
{  
object ob = this_object();
int k;
   ::heart_beat();
if (is_fighting()  &&  query("force") < query("max_force")/2 )       
     command("cast transfer");
   if (query("kee") < query("eff_kee")-10 )
         command("exert recover");
   if (query("sen") < query("eff_sen")-10 ) 
     command("exert refresh");
 if(is_fighting())
  {
        k = random(5);                                                 
      if(!ob->query_temp("powerup")) command("exert shield");
        if (k>4) k=4;
        switch(k)
      	{
          case 0:                     
                command("cast water");break;
          case 1: 
		command("perform sheshen");break;
          case 2:    
		command("perform fengbo");break;
	  case 3:
                command("perform leidong");break;
          case 4:      
                command("perform shenglong");break;
          default: return 0;
	}
   }
}

void die ()
{
  object me = this_object();
  object ps;
  object killer = query_temp("last_damage_from");
  int exp,baolv,pot,d;
 if(objectp(killer) && killer->query("is_guard") == 1)
         killer = killer->query("possessed");
 if (objectp(killer)) 
  {
exp = query("haveexp");
exp = exp/2 + random(exp/2);
pot = exp/3;
killer->add("combat_exp",exp);
 killer->add("daoxing",exp);
 killer->add("potential",pot);
baolv = query("baolv");
 if (random(baolv) == 0)
   {
     d=random(19);
              if (d>19) d=19;   
              switch(d)
        	{
        		case  0: ps = new ("/d/npc/vr_room/obj/bs_zf.lpc");break;
        		case  1: ps = new ("/d/npc/vr_room/obj/bs_lh.lpc");break;
        		case  2: ps = new ("/d/npc/vr_room/obj/bs_fsl.lpc");break;
        		case  3: ps = new ("/d/npc/vr_room/obj/bs_tq.lpc");break;
        		case  4: ps = new ("/u/xdao/ljs/obj/stone.lpc");break;
        		case  5: ps = new ("/u/xdao/ljs/obj/stone.lpc");break;
        		case  6: ps = new ("/u/xdao/ljs/obj/stone.lpc");break;
        		case  7: ps = new ("/d/npc/vr_room/obj/baoshi.lpc");break;
        		case  8: ps = new ("/d/npc/vr_room/obj/baoshi.lpc");break;
        		case  9: ps = new ("/d/npc/vr_room/obj/baoshi.lpc");break;
        		case  10: ps = new ("/d/npc/vr_room/obj/baoshi.lpc");break;
        		case  11: ps = new ("/d/npc/vr_room/obj/baoshi.lpc");break;
        		case  12: ps = new ("/d/npc/vr_room/obj/baoshi.lpc");break;
        		case  13: ps = new ("/d/npc/vr_room/obj/baoshi.lpc");break;
        		case  14: ps = new ("/d/npc/vr_room/obj/baoshi.lpc");break;
        		case  15: ps = new ("/d/npc/vr_room/obj/baoshi.lpc");break;
        		case  16: ps = new ("/d/npc/vr_room/obj/baoshi.lpc");break;
        		case  17: ps = new ("/d/npc/vr_room/obj/baoshi.lpc");break;
        		case  18: ps = new ("/d/npc/vr_room/obj/baoshi.lpc");break;
        		case  19: ps = new ("/d/npc/vr_room/obj/bs_tj.lpc");break;
                    default: ps = new ("/d/npc/vr_room/obj/baoshi.lpc");
        		}
 if (objectp(ps)) ps->move(me);
   }
  else
   {
     ps = new ("/obj/money/silver.lpc");
  if(objectp(ps)) 
        {
          ps->set_amount(random(50));
          ps->move(me);
         }
    }
tell_object(killer, HIM"你得到了"+chinese_number(exp)
			    +"点武学经验"+chinese_number(pot)+
			    "点潜能、"+COMBAT_D->chinese_daoxing(exp)+"天道行的奖励!\n"NOR);
TEAMK_D->teamk(killer,exp);
  if (random(2) == 1)
   {
  ps = new ("/u/xdao/ljs/npc/yao-2");
  if (objectp(ps)) ps->move(environment(me));
  message_vision ("\n"HIW"       山石中又蹦出一只小妖冲你叫道：大王有令！来人止步！\n"NOR,me,ps);
   }

}
::die();
}

