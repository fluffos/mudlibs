inherit NPC;
#include <ansi.h>

void create()
{
int i,j;
i=550;
j=50;
	set_name(HIW"孙悟空"NOR, ({ "sun wu kong", "sun"}));
	set("long", @LONG
天生地养一石猴！五百年前大闹天宫的齐天大圣孙悟空！
LONG);
  set("gender", "男性");
      set("title",HIW"齐天大圣"NOR);
	set("age", 30);
  set("attitude", "aggressive");
  set("class", "yaomo");
	set("max_kee", 1000000);
	set("max_sen", 1000000);
	set("force", 50000);
	set("max_force", 50000);
	set("force_factor", 350);
	set("max_mana", 20000);
	set("mana", 20000);
	set("mana_factor", 250);
       add_temp("apply/damage", 300+random(300));
       add_temp("apply/armor", 400+random(400));
       add_temp("apply/armor_vs_force",400+random(400));
       add_temp("apply/armor_vs_spells",400+random(400));
	set("combat_exp", 50000000);
	set("daoxing", 50000000);
       set("baolv", 1);
       set("haveexp",70000);
       set("fangcun/panlong_accept", "done");
       set("fangcun/jldl", "done");
   set("family/family_name", "方寸山三星洞");
       set_skill("unarmed", i+random(i));
       set_skill("dodge", i+random(i));
        set_skill("parry", i+random(i));
        set_skill("force", i+random(i));
        set_skill("spells", i+random(i));
 
        set_skill("stick", i+random(i));
        set_skill("qianjun-bang", i+random(i));
        set_skill("sword",i+random(i));
        set_skill("liangyi-sword",i+random(i));
        set_skill("jindouyun", i+random(i));
        set_skill("wuxiangforce", i+random(i));
        set_skill("puti-zhi", i+random(i));
        set_skill("dao", i+random(i));

        map_skill("force", "wuxiangforce");
        map_skill("stick","qianjun-bang");
        map_skill("parry", "qianjun-bang");
        map_skill("spells", "dao");
        map_skill("dodge", "jindouyun");
        map_skill("unarmed", "puti-zhi");
        map_skill("sword", "liangyi-sword");
	setup();
        carry_object("/d/obj/weapon/stick/fake-jingubang.lpc")->wield();
}

void heart_beat()
{  
object ob = this_object();
int k;
   ::heart_beat();

if (query("eff_kee") <  query("max_kee") ) 
  {
 for (int i=3;i>0;i--)
               {carry_object("/d/npc/vr_room/obj/jinchuangyao.lpc");command("eat jinchuang yao");command("exert recover");}
  }

if (query("eff_sen") <  query("max_sen") )
 {
  for (int i=3;i>0;i--)
               {carry_object("/d/npc/vr_room/obj/hunyuandan.lpc");command("eat hunyuan dan");command("exert refresh");}
  }
if (is_fighting()  &&  query("force") < query("max_force")/2 )       
     command("cast transfer");
   if (query("kee") < query("eff_kee")-10 )
         command("exert recover");
   if (query("sen") < query("eff_sen")-10 ) 
     command("exert refresh");
   if (!is_fighting()  &&  query("force") < query("max_force") )
     set("force",(int)query("max_force"));
   if (!is_fighting()  &&  query("mana") < query("max_mana") )
     set("mana",(int)query("max_mana"));
 if(is_fighting())
  {
      if(!ob->query_temp("jldl")) command("exert jldl");
       k = random(4);                     
        if (k>3) k=3;
        switch(k)
      	{
	  case 0:
		command("cast light");break;
          case 1:  
		command("perform pili");break;
	  case 2:
                command("perform qiankun");break;
          case 3:
		command("perform panlong");break;
          default: return 0;
	}
   }
}

void die ()
{
  object me = this_object();
  object ps;
  object killer = query_temp("last_damage_from");
  int exp,baolv,pot,d;
 if(objectp(killer) && killer->query("is_guard") == 1)
         killer = killer->query("possessed");
 if (objectp(killer)) 
  {
exp = query("haveexp");
exp = exp/2 + random(exp/2);
pot = exp/3;
killer->add("combat_exp",exp);
 killer->add("daoxing",exp);
 killer->add("potential",pot);
baolv = query("baolv");
 if (random(baolv) == 0)
   {
     d=random(5);
              if (d>4) d=4;   
              switch(d)
        	{
        		case  0: ps = new ("/d/npc/vr_room/obj/bs_zf.lpc");break;
        		case  1: ps = new ("/d/npc/vr_room/obj/bs_lh.lpc");break;
        		case  2: ps = new ("/d/npc/vr_room/obj/bs_fsl.lpc");break;
        		case  3: ps = new ("/d/npc/vr_room/obj/bs_tq.lpc");break;
        		case  4: ps = new ("/d/npc/vr_room/obj/bs_tj.lpc");break;
                    default: ps = new ("/d/npc/vr_room/obj/baoshi.lpc");
        		}
 if (objectp(ps)) ps->move(me);
   }
  else
   {
     ps = new ("/obj/money/silver.lpc");
  if(objectp(ps)) 
        {
          ps->set_amount(random(50));
          ps->move(me);
         }
    }
tell_object(killer, HIM"你得到了"+chinese_number(exp)
			    +"点武学经验"+chinese_number(pot)+
			    "点潜能、"+COMBAT_D->chinese_daoxing(exp)+"道行的奖励!\n"NOR);
}
::die();
}

