#include <ansi.h>;
inherit ROOM;
void create()
{
        set("short", "第四层妖王府");
         set ("long", @LONG
这里是守护第四层的移山大圣狮驼王的洞府，更是通往第五层的必经之路。
洞府四周刻有七大圣结拜时的石刻， 狮驼王端坐在石塌之上，周围小妖纷纷
端茶送果，献媚不已。
LONG);
                     
set("exits", ([
      "up": __DIR__"5-1",
      "west": __DIR__"4-7",          
        ]));

  set("objects", ([ 
      "/u/xdao/ljs/npc/yao-4.lpc" : 2,
      "/u/xdao/ljs/npc/boss-4.lpc" : 1,
        ]));

        setup();
}

int valid_leave (object who, string dir)
{
  object wang = present("shi tuo wang", this_object());

  if (dir == "west")
    return ::valid_leave(who,dir);

  if (wang)
    return notify_fail(HIB"狮驼王身子一晃拦在了你的面前！\n"NOR);
  return ::valid_leave(who,dir);
}
