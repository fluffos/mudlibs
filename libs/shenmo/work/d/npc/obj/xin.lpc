inherit ITEM;
#include <ansi.h>

void create() {
  set_name("拜贤卷", ({ "baixian book", "juan", "seal" }));
  set_weight(250);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", @LONG
一张礼贤下士的拜帖，上面龙飞凤舞的写着几行蝇头小楷。
LONG);
    set("unit", "张");
    set("value", 0);
  }
  setup();
}

int is_letter() { return 1; }

void init() {
  add_action("do_ask", "ask");
}

int do_ask(string arg) {
  string id, sth;
  object gold, npc, me = this_player();

  if (!userp(me) || me != query("owner"))
    return 0;

  if (!arg || !query("ask"))
    return 0;

  if (sscanf(arg, "%s about %s", id, sth) != 2)
    return 0;

  npc = present(id, environment(me));
  if (!npc || userp(npc) || !living(npc))
    return 0;

  if (npc != query("target"))
    return 0;

  if (sth != query("ask"))
    return 0;

  if (me->is_busy()) {
    write("你现在正忙着呢。\n");
    return 1;
  }

  me->start_busy(1);
  message_vision(
    CYN "$N向$n问道：敢问这位" + RANK_D->query_respect(npc) + "可知『" + sth + "』之事？\n" NOR,
    me,
    npc
  );
  message_vision(CYN "$n点头笑了笑：在下家学正是参悟了" + sth + "经年，如此甚佳。\n" NOR, me, npc);
  npc->command("give gold to " + me->query("id"));
  gold = new("/obj/money/gold");
  gold->set_amount(1 + random(2));
  if (!gold->move(me))
    destruct(gold);
  else write(HIY "你成功拜访了" + npc->query("name") + "，获得了" + gold->short() + HIY "的奖励。\n" NOR);
  me->delete("giftmark/letter");
  message_vision("$N急急忙忙的离开了。\n", npc);
  npc->remove_all_killer();
  all_inventory(environment(me))->remove_killer(npc);
  destruct(npc);
  destruct(this_object());
  return 1;
}
