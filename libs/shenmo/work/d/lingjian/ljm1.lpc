//niang.c/2001 by lestat
inherit NPC;
inherit F_MASTER;
#include <ansi.h>
string ask_jinru();
string ask_for_join();

void create() {
  set_name("剑神", ({ "jian shen", "jian shen", "jian" }));
  set("long", "剑神谷收人弟子。\n");
  set("title", "剑神谷第二代弟子");
  set("gender", "男性");
  set("age", 20);
  set("class", "sword");
  set("attitude", "friendly");
  set("per", 30);
  set("int", 30);
  set("max_kee", 29000);
  set("max_sen", 10000);
  set("force", 8000);
  set("max_force", 8000);
  set("force_factor", 200);
  set("max_mana", 8000);
  set("mana", 8000);
  set("mana_factor", 40);
  set("combat_exp", 80000000);
  set("daoxing", 80000000);
  set("eff_dx", 80000000);
  set("nkgain", 350);

  set("inquiry", ([
    "灵剑门": (: ask_for_join :),
    "进入": (: ask_jinru :),

  ]));

  set("chat_chance", 5);
  set("chat_msg", ({
    HIM "天干物燥，小心火烛！\n" NOR,
  }));

  create_family("灵剑门", 2, "弟子");
  setup();

  carry_object("/d/moon/obj/luoyi")->wear();
  carry_object("/d/obj/weapon/sword/qinghong")->wield();
}

void init() {
  add_action("do_cut", "yes");
}

string ask_for_join() {
  object me;
  object ob;

  ob = this_object();
  me = this_player();


  if ((string)me->query("gender") == "无性") {
    command("shake");
    return ("本门不收无性之人，这位" +
      RANK_D->query_respect(me) + "还是歇着吧。\n");
  }
  if ((int)me->query("tianlongzhan/zhengqi_point") < 499) {
    command("say 你的正气少于500次！");
  }

  if ((me->query("family")) && (me->query("family/family_name") == ob->query("family/family_name"))) {
    command("shake");
    return ("已经做了太监，这位" +
      RANK_D->query_respect(me) + "还是歇着吧。\n");
  }

  me->set_temp("pending/join_ljm", 1);

  return "好！" + RANK_D->query_respect(ob) + "真心愿意拜入灵剑门，终身以剑为伍！并且需要500点正气点为手续费，如果愿意请输入(yes)确认。\n";
}

int do_cut() {
  string name, new_name;
  mapping myskills;
  string *m_skills;
  int i;

  if (!this_player()->query_temp("pending/join_ljm")) {
    return 0;
  }
  message_vision(HIC "$N平心静气，盘腿坐下。\n\n" +
    "$n拿起身上一个剑灵，一把拍在$N的头上，对着$N化去$N全身功力，并将$N的真气转化为剑气。\n\n" NOR,
    this_player(), this_object());

  name = this_player()->query("name");
  new_name = "剑" + name[0..1] + "子";

  command("say 从今以後你的名字叫做" + new_name + "。");

  myskills = this_player()->query_skills();
  if (myskills) {
    m_skills = keys(myskills);
    i = sizeof(m_skills);
    while (i--) {
      if (m_skills[i] && stringp(m_skills[i])) {
        this_player()->delete_skill(m_skills[i]);
      }
    }
    command("grin " + this_player()->query("id"));
  }

  command("rumor 据说" + this_player()->query("name") + "化去全身功力拜入灵剑门。!");

  this_player()->delete_temp("pending/join_ljm");
  this_player()->set("name", new_name);
  this_player()->set("ljm/old_name", name);
  this_player()->save();
  this_player()->set("tianlongzhan/zhengqi_point", -500);
  this_player()->set("class", "sword");
  this_player()->set("classxt", "sword");


  return 1;
}

string ask_jinru()

{
  object me = this_player();
  if (!me->query("pending/join_ljm")) {
    command("say 坐好了！");
  }

  message_vision("剑神用真元把你包围起来。\n", me);
  message_vision("你飞啊飞,飞了很长时间终于飞到了灵剑门......\n", me);
  me->move("d/lingjian/zhengyuan");

}
