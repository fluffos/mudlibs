inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void create() {
  set_name("宋玉青", ({ "song yuqing", "song", "master" }));
  set("long", "灵剑门第三代弟子，排行第二，师兄妹三人中剑法最好。\n");
  set("title", HIY "飞剑" NOR);
  set("gender", "男性");
  set("age", 25);
  set("class", "sword");
  set("attitude", "friendly");
  set("shen_type", 1);
  set("rank_info/respect", "大侠");
  set("per", 20);
  set("str", 20);
  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);
  set("force", 3000);
  set("max_force", 1500);
  set("force_factor", 50);
  set("max_mana", 1500);
  set("mana", 3000);
  set("mana_factor", 50);
  set("combat_exp", 350000);
  set_skill("literate", 70);
  set_skill("unarmed", 90);
  set_skill("dodge", 70);
  set_skill("parry", 80);
  set_skill("sword", 130);
  set_skill("spells", 70);
  set_skill("lingjianjue", 70);
  set_skill("lingjianzhi", 70);
  set_skill("lingjian-force", 80);
  set_skill("force", 80);
  set_skill("lingjian-shi", 130);
  set_skill("lingjian-step", 70);
  map_skill("unarmed", "lingjianzhi");
  map_skill("unarmed", "qijian-zhi");
  map_skill("force", "lingjian-force");
  map_skill("sword", "lingjian-shi");
  map_skill("parry", "lingjian-shi");
  map_skill("dodge", "lingjian-step");
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: cast_spell, "sword" :),
    (: cast_spell, "jianshen" :),
  }));

  create_family("灵剑门", 3, "蓝");
  setup();

  carry_object("/d/lingjian/obj/cloth")->wear();
  carry_object("/d/obj/weapon/sword/qingfeng")->wield();
}

void attempt_apprentice(object ob) {
  ob = this_player();

  if (ob->query("family/class")) {
    command("say 这位" + RANK_D->query_respect(ob) + "非我派系中的弟子，恐怕收了你却也误导了你！\n");
    command("shake");
    return;
  }
  if ((int)ob->query_int() < 20) {
    command("say 这位" + RANK_D->query_respect(ob) + "悟性太低，恐怕收了你也难以领悟剑道！\n");
    command("shake");
    return;
  }
  if ((int)ob->query_str() < 20) {
    command("say 这位" + RANK_D->query_respect(ob) + "膂力太低，不适合修炼本门功夫！\n");
    command("shake");
    return;
  }
  command("xixi");
  command("say 好吧，我就收下你了！");
  command("recruit " + ob->query("id"));
  return;
}
int recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "sword");
  ob->set("family/class", "jian");
  ob->set("title", "灵剑门飞剑派弟子");
}
