#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  set_name("莫云山", ({ "mo yunshan", "mo", "master" }));
  set("long", "灵剑门二代首徒，继其先师登仙之后，
他也在四处修行，希望也能得道成仙。\n");
  set("title", HIY "灵剑门首席大弟子" NOR);
  set("gender", "男性");
  set("age", 100);
  set("class", "sword");
  set("attitude", "friendly");
  set("shen_type", 1);
  set("rank_info/respect", "大剑师");
  set("per", 30);
  set("int", 30);
  set("max_kee", 5000);
  set("max_gin", 1000);
  set("max_sen", 5000);
  set("force", 9000);
  set("max_force", 4500);
  set("force_factor", 150);
  set("max_mana", 4500);
  set("mana", 9000);
  set("mana_factor", 150);
  set("combat_exp", 5000000);
  set_skill("literate", 150);
  set_skill("unarmed", 180);
  set_skill("dodge", 150);
  set_skill("parry", 150);
  set_skill("sword", 200);
  set_skill("spells", 200);
  set_skill("lingjianjue", 200);
  set_skill("lingjianzhi", 150);
  set_skill("lingjian-force", 200);
  set_skill("force", 180);
  set_skill("lingjian-shi", 190);
  set_skill("lingjian-step", 150);
  map_skill("spells", "lingjianjue");
  map_skill("unarmed", "qijian-zhi");
  map_skill("force", "lingjian-force");
  map_skill("sword", "lingjian-shi");
  map_skill("parry", "lingjian-shi");
  map_skill("dodge", "lingjian-step");
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: cast_spell, "jianshen" :),
    (: cast_spell, "sword" :)
  }));



  create_family("灵剑门", 2, "蓝");
  setup();

  carry_object("/d/obj/cloth/xianyi")->wear();
  carry_object("/d/obj/weapon/sword/qingfeng")->wield();
}

void attempt_apprentice(object ob) {
  ob = this_player();
  if ((string)ob->query("family/family_name") == "灵剑门") {
    if ((int)ob->query("combat_exp") < 300000) {
      command("say 道行不够，" + RANK_D->query_respect(ob) + "还需多加努力才能学更深的剑法。\n");
      return;
    }
    if ((int)ob->query_int() < 27) {
      command("say 这位" + RANK_D->query_respect(ob) + "悟性太低，恐怕无法领悟剑意！\n");
      command("sigh");
      return;
    }
    if ((int)ob->query_skill("lingjian-force", 1) < 90) {
      command("say 这位" + RANK_D->query_respect(ob) + "还是先把内功练好再说吧！\n");
      command("sigh");
      return;
    }
    command("smile");
    command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，领悟剑意之时就是即位剑神之时。");
    command("recruit " + ob->query("id"));
    return;
  }
  command("shake");
  command("say 老夫不收外门弟子，" + RANK_D->query_respect(ob) + "还是另寻他人吧！\n");
  return;
}
int recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "sword");
  ob->set("title", HIR "灵剑门莫云山亲传弟子" NOR);
}

int accept_fight(object me, object ob) {
  ob = this_player();
  command("say 老夫久不与人交手，今日也不想破例！\n");
  return 0;
}
void die() {

  if (environment()) {
    message("sound", "\n\n莫云山怒道：你且与我同去见先师吧！\n\n", environment());
    message("sound", "\n莫云山化为一道剑气带着$n向远处飞去。。。\n\n", environment());
  }
  destruct(this_object());
}
