#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
set("short", "神兽秘洞");
set("long", @LONG

这里是一个四周封闭的山洞，但是却温暖明亮。山洞顶部
布满了石钟乳，不停的嘀嗒嘀嗒地落着水滴。在山洞的正
中央，有一只周身散发着奇特光芒的神兽正胆怯地看着你！
你忐忑不安地向它走去。

LONG );

set("objects",
([
    "/d/eastway/qinling/npc/qinglong" : 1,
]));
setup();
}
void init()
{
add_action("do_perform", "perform");
add_action("do_cast", "cast");
}
int do_cast (string arg)
{
object who = this_player();
if ((arg=="escape" || arg=="shuidun" || arg=="tudun" || arg=="chuqiao" || arg=="qiankun"))
{
tell_object(who,"你结结巴巴念了几句咒语！\n");
return 1;
}
else   return 0;
}
int do_perform (string arg)
{
object who = this_player();
if ((arg=="hunpofeiyang" || arg=="piyi" || arg=="shixie" || arg=="duan"))
{
tell_object(who,"你想干什么！\n");
return 1;
}
else   return 0;
}
