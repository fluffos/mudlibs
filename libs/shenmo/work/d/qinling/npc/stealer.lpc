void create()
{
string str;
set_name("盗墓者", ({"daomu zhe", "zhe"}));
set("gender", "男性");
set("wuhu_agree", 1);
set("age", 30);
set("combat_exp", 6000000+random(6000000));
set("daoxing", 6000000+random(6000000));
set("level", 100);
set("attitude", "friendly");
set("long", "一个缩头缩脑的墓贼,非常警惕的看着你。\n");
set("max_kee", 40000+random(30000));
set("kee", 80000+random(30000));
set("max_sen", 40000+random(30000));
set("sen", 80000+random(30000));
set("max_force", 4000+random(500));
set("force", 6000+random(500));
set("max_mana", 4000+random(500));
set("mana", 6000+random(500));
set("force_factor", 300+random(100));
set("chat_chance",3);
set("chat_msg", ({
CYN"他奶奶的，今天什么也没挖着！又没钱逛窑子了！\n"NOR,
(: random_move :),
}) ); 
set_skill("sword", 300+random(200));
set_skill("liangyi-sword", 300+random(200));
set_skill("blade", 300+random(200));
set_skill("wuhu-blade", 300+random(200));
set_skill("fork", 300+random(200));
set_skill("fengbo-cha", 300+random(200));
set("任务",1);
set("莲花",1);
set_skill("whip", 300+random(200));
set_skill("hellfire-whip", 300+random(200));
set_skill("axe", 300+random(200));
set_skill("sanban-axe", 300+random(200));
set_skill("hammer", 300+random(200));
set_skill("kaishan-chui", 300+random(200));
set_skill("rake", 300+random(200));
set_skill("skyriver-rake", 300+random(200));
set_skill("force", 300+random(200));
set_skill("spells", 300+random(200));
set_skill("yaofa", 300+random(200));
set_skill("yijinjing", 300+random(200));
set_skill("parry", 300+random(200));
set_skill("dodge", 300+random(200));
set_skill("shaolin-shenfa", 300+random(200));
set_skill("unarmed", 300+random(200));
set_skill("yinfeng-zhua", 300+random(200));
map_skill("force", "yijinjing");
map_skill("spells", "yaofa");
map_skill("sword", "liangyi-sword");
map_skill("blade", "wuhu-blade");
map_skill("fork", "fengbo-cha");
map_skill("whip", "hellfire-whip");
map_skill("hammer", "kaishan-chui");
map_skill("axe", "sanban-axe");
map_skill("rake", "skyriver-rake");
map_skill("parry", "skyriver-rake");
map_skill("dodge", "shaolin-shenfa");
map_skill("unarmed", "yinfeng-zhua");
/*
set("chat_chance_combat", 100); 
set("chat_msg_combat", ({  
        (: perform_action, "blade", "mie" :),  
}) ); 
*/
SDS_D->powerup(this_object());
setup();
carry_object("/d/eastway/qinling/obj/tiebox")->set_amount(random(1));
carry_object("/d/obj/cloth/zhanpao")->wear();
str = "/d/qujing/pingding/obj/weapon0";
str[strlen(str)-1] = '0'+random(7);
carry_object(str)->wield();
}
void die()
{
object ob,*inv;
int i;
object me = query_temp("last_damage_from");
ob = this_object();
if ( !me
|| !present(me,environment())
|| !userp(me)
|| !living(me) )
{
::die();
return;
}
inv = all_inventory(ob);

for( i = 0;i < sizeof(inv);i++ )
{
   if( inv[i]->query("equipped") != "worn" && 
           inv[i]->query("equipped") != "wielded" && 
           sizeof(all_inventory(me))< me->query_max_items())
   {   tell_object(me,HIW"你得到了"NOR+inv[i]->name()+"\n");
           inv[i]->move(me);
   }
}

if ((int)me->query("combat_exp")/10000<0)
{
me->add("combat_exp",500+random(200));
me->add("daoxing",500+random(200));
me->add("potential",100+random(50));
tell_object(me,YEL"你的武功修为提高了。\n"NOR);
}
if( random(15) == 1 )
me->add("shen",2+random(2));
::die();
}
