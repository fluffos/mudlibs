#include <ansi.h> //如果要用颜色，就要套用此头文件
inherit __DIR__ "super_npc.lpc";
//inherit "/d/snowtu/npc/super_npc";


void create() {
  set_name(HIC "青  龙" NOR, ({ "qing long" }));
  set("race", "野兽");
  set("long", "这就是传说中的灵兽青龙。\n");
  set("title", HIM "镇陵神兽" NOR);
  set("limbs", ({ "头部", "身体", "尾巴" }));
  set("verbs", ({ "bite" }));
  set("age", 1000);
  set("attitude", "aggressive");
  set("class", "xian");
  set("combat_exp", 200000000 + random(100000000));
  set("max_kee", 1000000 + random(1000000));
  set("daoxing", 200000000 + random(100000000));
  set("max_sen", 1000000 + random(1000000));

  set("max_force", 12000);
  set("force", query("max_force") * 2);
  set("force_factor", 200 + random(100));
  set("max_mana", 20000);
  set("mana_factor", 800);
  set_skill("parry", 1000);
  set_skill("unarmed", 1000);
  set_skill("dodge", 1000);
  set_skill("force", 1000);
  set_skill("jiayi-force", 1000);
  set_skill("spells", 1000);
  set_skill("xianglong-zhang", 1000);
  set_skill("seashentong", 1000);
  set_skill("yulong-steps", 1000);
  set_skill("banruo-zhang", 1000);
  map_skill("spells", "seashentong");
  map_skill("unarmed", "xianglong-zhang");
  map_skill("parry", "banruo-zhang");
  map_skill("dodge", "yulong-steps");
  map_skill("force", "jiayi-force");
  set("level", 900);
  set("任务", 1);
  set("莲花", 1);
  /*
set("chat_chance_combat", 100); 
set("chat_msg_combat", ({  
        (: perform_action, "unarmed", "kuang" :),  
        (: exert_function, "recover" :),  
        (: cast_spell, "hufa" :), 
        (: cast_spell, "dragonfire" :), 
        (: cast_spell, "water" :), 
        (: cast_spell, "freez" :), 
}) ); 
*/
  SDS_D->powerup(this_object());
  create_family("东海龙宫", 1, "蓝");
  setup();
}

void kill_ob(object ob) {
  set_temp("no_return", 1);
  set_temp("my_killer", ob);
  ::kill_ob(ob);
}

void die() {
  object ob = query_temp("my_killer");
  object armor = new("/d/eastway/qinling/obj/armor/qinglong");
  if (!present(
    "xuanwu shenjia",
    ob
  ) && !present(
    "qilin feixue",
    ob
  ) && !present(
    "baihu zhanpao",
    ob
  ) && !present("qinglong baodai", ob) && !present("zhuque yuyi", ob)) {
    message_vision(HIC "只见$N化作一道青芒，冉冉升向天际... ... \n" NOR, this_object());
    message_vision(HIC "你感觉一件青色的物事落在了你的身上。\n" NOR, this_object());
    message(
      "channel:rumor",
      YEL + "\n【" + HIW " 神兽降世 " NOR + YEL "】某人：" + ob->query("name") + "拿到" + HIC "青龙宝带" NOR + YEL "了！\n\n" + NOR,
      users()
    );
    armor->move(ob);
  }
  destruct(this_object());
}
