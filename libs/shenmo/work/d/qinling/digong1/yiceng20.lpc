// Creat by windy 2/24/06 
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", HIW "地陵棺室" NOR);
  set("long", @LONG 

走到这里忽然开阔了许多，你举火定睛观看，原来这里是一 
个地陵棺室。你大喜之下急忙走到棺椁旁边，却发现已经被 
人打开了，大概是盗墓者所为。
LONG);
  set("exits", ([ /* sizeof() == 5 */
    "north": __DIR__ "yiceng0",
    "south": __DIR__ "yiceng26",
  ]));
  set("item_desc", ([ /* sizeof() == 1 */
    "south": "黑咕隆咚的，什么也看不清楚。\n",
    "north": "黑咕隆咚的，什么也看不清楚。\n",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    "/d/eastway/obj/bingma": random(2),
    "/d/eastway/qinling/npc/beast": random(6),
    "/d/eastway/qinling/npc/stealer": random(2),
  ]));
  setup();
}
void init() {
  add_action("do_drop", "drop");
  add_action("do_cast", "cast");
}
int do_drop() {
  object me;
  me = this_player();
  tell_object(me, "这里这么黑，东西扔了就找不回来了!\n");
  return 1;
}
int do_cast() {
  object me;
  me = this_player();
  tell_object(me, "你念了几句咒语，竟然发觉自己的法力失灵了!\n");
  return 1;
}
int is_digong() { return 1; }
