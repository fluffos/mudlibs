#include <ansi.h>
#include <armor.h>
#include <dbase.h>
inherit SURCOAT;
inherit F_AUTOLOAD;
inherit F_SAVE;
inherit F_BACKUP;
void create() {
  seteuid(0);
  set_name(HIR "朱雀羽衣" NOR, ({ "zhuque yuyi", "yuyi" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIR "灵兽朱雀幻化成的一件圣物。\n" NOR);
    set("material", "leather");
    set("unit", "件");
    set("value", 0);
    set("wear_msg", HIR "从南方的天际传来一声凤鸣，$N身后一片红芒闪烁。\n" NOR);
    set("unequip_msg", HIR "$N身后红芒渐淡，$n" HIR "踪迹皆无。\n" NOR);
    set("no_get", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("no_break", 1);
    set("armor_prop/force", 200);
    set("armor_prop/armor", 250);
  }
  setup();
}
int save() {
  return ::save();
}
void setup() {
  ::setup();
}
int query_unique() { return 1; }
int query_autoload() { return 1; }
