// added by windy 2/20/06
#include <ansi.h>
inherit ITEM;
void create() {
  object me = this_object();
  object ob;
  int i;

  set_name(WHT "白银盒" NOR, ({ "box" }));
  set_weight(0);
  set_max_encumbrance(40000);
  seteuid(getuid());
  i = random(100);
  if (i >= 99)
    ob = new("/d/eastway/qinling/obj/dengji");
  else if (i >= 98)
    ob = new("/d/eastway/qinling/obj/haomao");
  else if (i >= 97)
    ob = new("/d/eastway/qinling/obj/xingtian");
  else if (i >= 96)
    ob = new("/d/eastway/qinling/obj/minjie");
  else if (i >= 92)
    ob = new("/d/eastway/qinling/obj/shengji2");
  else if (i >= 88)
    ob = new("/d/eastway/qinling/obj/shengji");
  else if (i >= 75)
    ob = new("/d/eastway/qinling/obj/book1");
  else if (i >= 65) {
    ob = new("d/9sky/guzhanchang/obj/yundan");
    ob->set_amount(1 + random(2));
  } else if (i >= 55) {
    ob = new("/obj/money/gold");
    ob->set_amount(1);
  } else if (i >= 45) {
    ob = new("/obj/money/thousand-cash");
    ob->set_amount(5 + random(4));
  } else if (i >= 35) {
    ob = new("/obj/money/gold");
    ob->set_amount(random(300));
  } else if (i >= 25) {
    ob = new("/obj/money/silver");
    ob->set_amount(200 + random(800));
  } else if (i >= 24)
    ob = new("/d/obj/story/shenliwan");
  else if (i >= 23)
    ob = new("/d/obj/story/xiandan");
  else if (i >= 22)
    ob = new("/d/obj/story/xisuidan");
  else if (i >= 21)
    ob = new("/d/eastway/qinling/obj/lingzhi2");
  else if (i >= 20)
    ob = new("/d/eastway/qinling/obj/sanqing2");
  else if (i >= 19)
    ob = new("/d/eastway/qinling/obj/neili2");
  else if (i >= 18)
    ob = new("/d/eastway/qinling/obj/fali2");
  else if (i >= 17)
    ob = new("/d/eastway/qinling/obj/lingzhi");
  else if (i >= 16)
    ob = new("/d/eastway/qinling/obj/sanqing");
  else if (i >= 15)
    ob = new("/d/eastway/qinling/obj/fali");
  else if (i >= 14)
    ob = new("/d/eastway/qinling/obj/neili");
  else {
    ob = new("/obj/money/coin");
    ob->set_amount(20000 + random(10000));
  }
  if (ob)
    ob->move(this_object());
  else {
    ob = new("/obj/money/coin");
    ob->set_amount(1500 + random(8000));
    if (ob)
      ob->move(this_object());
  }
  set("unit", "个");
  set("no_sell", 1);
  set("no_put", 1);
  set("no_give", 1);
  set("long", "一个布满点点灰渍的烂银盒子。\n");
  set("value", 0);
}
int is_container() {
  return 1;
}
