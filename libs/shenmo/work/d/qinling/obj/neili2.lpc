// lingzhi.c 千年灵芝
//星星(lywin)2000/4/22

#include <ansi.h>
inherit ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIW "熊胆" NOR, ({ "xiong dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "一颗浑圆的熊胆，对内功大有裨益。\n");
    set("value", 0);
  }
  setup();
}

int do_eat(string arg) {
  object me;
  int str;
  me = this_player();
  str = me->query("max_force");
  if (!id(arg))
    return notify_fail("你要吃什么？\n");

  if (str < 200000) {
    me->set("max_force", str + 50);
    me->set("maximum_force", str + 50);
  }
  message_vision(HIW "$N吃下一颗浑圆之物，顿感自丹田升起一股暖流 !\n" NOR, this_player());
  destruct(this_object());
  return 1;
}
