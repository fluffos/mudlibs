#include <ansi.h>
inherit ITEM;
void create()
{
object me = this_object();
object ob;
int i;

set_name(HIG"绿玉盒"NOR, ({ "box" }) );
set_weight(0);
set_max_encumbrance(40000);
seteuid(getuid());
i=random(100);
if(i >=99)
ob=new("/d/eastway/qinling/obj/dengji2");
if(i >=98)
ob=new("/d/eastway/qinling/obj/shengji3");
else if(i >=97)
ob=new("/d/eastway/qinling/obj/haomao");
else if(i >=96)
ob=new("/d/eastway/qinling/obj/book/medicalbook");
else if(i >=95)
ob=new("/d/eastway/qinling/obj/book/literatebook");
else if(i >=94)
ob=new("/d/eastway/qinling/obj/book/makeupbook");
else if(i >=93)
ob=new("/d/eastway/qinling/obj/shengji3");
else if(i >=92)
ob=new("/d/eastway/qinling/obj/shengji3");

else if(i>=81)
ob=new("/d/eastway/qinling/obj/shengji2");
else if(i>=70)
ob=new("/d/eastway/qinling/obj/book1");
else if(i>=60)
{
ob=new("d/9sky/guzhanchang/obj/yundan");
ob->set_amount(2+random(3));
}
/*
else if(i>=55)
{
ob=new("/obj/money/box");
ob->set_amount(2+random(2));
}
*/
else if(i>=52)
ob=new("/d/eastway/qinling/obj/neili2");
else if(i>=45)
{
ob=new("/obj/money/thousand-cash");
ob->set_amount(10+random(5));
}
else if(i>=42)
ob=new("/d/eastway/qinling/obj/fali2");
else if(i>=35)
{
ob=new("/obj/money/gold");
ob->set_amount(500+random(200));
}
else if(i>=32)
ob=new("/d/eastway/qinling/obj/xingtian");
else if(i>=25)
{
ob=new("/obj/money/silver");
ob->set_amount(500+random(500));
}
else if(i>=24)
ob=new("/d/eastway/qinling/obj/drug/perdan");
else if(i>=23)
ob=new("/d/eastway/qinling/obj/drug/cpsdan");
else if(i>=20)
ob=new("/d/eastway/qinling/obj/minjie");


else if(i>=18)
ob=new("/d/eastway/qinling/obj/lingzhi2");
else if(i>=16)
ob=new("/d/eastway/qinling/obj/sanqing2");
else if(i>=10)
ob=new("/d/eastway/qinling/obj/drug/jiedudan");
else if(i>=9)
ob=new("/d/eastway/qinling/obj/drug/yuanpinzhu");
else if(i>=8)
ob=new("/d/eastway/qinling/obj/drug/huimeng");
else
{
ob=new("/obj/money/coin");
ob->set_amount(50000+random(10000));
}
if ( ob )       
        ob->move(this_object());
else    {
        ob=new("/obj/money/coin");
        ob->set_amount(1500+random(8000));
        if ( ob )       
                ob->move(this_object());
        }               
set("unit", "个");
set("no_sell", 1);
set("no_put", 1);
set("no_give", 1);
set("long", "一个触手十分温暖的玉石盒子。\n");
set("value",0);
}
int is_container()
{
return 1;
}
