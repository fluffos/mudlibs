// lingzhi.c 千年灵芝
//星星(lywin)2000/4/22

#include <ansi.h>
inherit ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIG "狗鞭" NOR, ({ "gou bian", "bian" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("long", "一根黑不溜秋的狗鞭，听说可是大补哦！\n");
    set("value", 0);
  }
  setup();
}

int do_eat(string arg) {
  object me;
  int str;
  me = this_player();
  str = me->query("max_mana");
  if (!id(arg))
    return notify_fail("你要吃什么？\n");

  if (str < 200000) {
    me->set("max_mana", str + 20);
    me->set("maximum_mana", str + 20);
  }
  message_vision(HIG "$N吃下一颗长圆之物，顿觉蠢蠢欲动 !\n" NOR, this_player());
  destruct(this_object());
  return 1;
}
