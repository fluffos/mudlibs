// forcebook2, level 100-140
#include <ansi.h>

inherit ITEM;
void init();

void create() {
  set_name(HIG "〖长生诀宝典下卷〗" NOR, ({ "changshengjue book", "changshengjue", "book", "shu" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "一张薄薄的玉板，上面密密麻麻地刻满了字。\n");
    set("material", "cloth");
    set("value", 0);
  }
}

void init() {
  if (!wizardp(this_player())) {
    set("no_get", 1);
    set("no_drop", 1);
    set("no_sell", 1);
    set("no_steal", 1);
    set("no_give", 1);
  }
  add_action("do_read", "read");
}

int do_read(string arg) {
  object me = this_player(), book = this_object();
  int sen_cost, gain, forcelev, exp;

  if (!book->id(arg)) return notify_fail("你要读什么？\n");
  if (environment(book) != me) return notify_fail("书要拿起来读。\n");
  if (me->is_busy()) return notify_fail("你现在忙着呢，还是等静下心来再读书吧！\n");
  if (me->is_fighting()) return notify_fail("临阵磨枪可来不及啦！\n");
  if ((int)me->query_skill("changshengjue", 1) < 60)
    return notify_fail("你认真揣摩了半天，对上面的东西似乎懂点，又似乎不懂，难以把握其中的法门。\n");
  if ((int)me->query_skill("changshengjue", 1) > 100)
    return notify_fail("长生诀神功光靠读书时没有用的，看来以后需要自己修炼了。\n");
  exp = (int)me->query("combat_exp");
  forcelev = (int)me->query_skill("changshengjue", 1);
  if (exp / 100 < forcelev / 10 * forcelev / 10 * forcelev / 10)
    return notify_fail("你的武学经验不够，再怎么读也没用。\n");
  if (me->query_skill("busi-force", 1) > 0)
    return notify_fail("正邪不两立，长生诀恐怕难以与不死印法一起修炼。\n");
  sen_cost = 20 + (40 - (int)me->query_int()) + (35 - (int)me->query_kar());
  if (sen_cost <= 50) sen_cost = 50;
  if ((int)me->query("sen") < sen_cost)
    return notify_fail("你现在头晕脑胀，该休息休息了。\n");
  me->receive_damage("sen", sen_cost);

  gain = (int)me->query_skill("literate", 1) / 50;
  gain -= random((int)me->query_int());
  gain += random(me->query_kar());
  if (gain <= 0) gain = 1;
  me->improve_skill("changshengjue", gain);

  message_vision("$N正专心地研读" + book->query("name") + "。\n", me);
  tell_object(me, "你研读有关长生诀的技巧，似乎有点心得。\n");

  return 1;
}
