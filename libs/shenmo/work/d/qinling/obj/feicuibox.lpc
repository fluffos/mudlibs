#include <ansi.h>
inherit ITEM;
void create()
{
object me = this_object();
object ob;
int i;

set_name(HIC"珍珠翡翠盒"NOR, ({ "box" }) );
set_weight(0);
set_max_encumbrance(40000);
seteuid(getuid());
i=random(100);
if(i >=99)
ob=new("/d/eastway/qinling/obj/dengji2");
if(i >=98)
ob=new("/d/eastway/qinling/obj/book/basicbook0");
else if(i >=97)
ob=new("/d/eastway/qinling/obj/book/basicbook1");
else if(i >=96)
ob=new("/d/eastway/qinling/obj/book/basicbook2");
else if(i >=95)
ob=new("/d/eastway/qinling/obj/book/basicbook3");
else if(i >=94)
ob=new("/d/eastway/qinling/obj/book/basicbook4");
else if(i >=93)
ob=new("/d/eastway/qinling/obj/book/basicbook5");
else if(i >=91)
ob=new("/d/eastway/qinling/obj/sanqing3");
else if(i >=89)
ob=new("/d/eastway/qinling/obj/lingzhi3");
else if(i >=88)
ob=new("/d/eastway/qinling/obj/haomao");
else if(i>=87)
ob=new("/d/eastway/qinling/obj/book/basicbook6");
else if(i>=86)
ob=new("/d/eastway/qinling/obj/book/basicbook7");
else if(i>=85)
ob=new("/d/eastway/qinling/obj/book/basicbook8");
else if(i>=84)
ob=new("/d/eastway/qinling/obj/book/basicbook9");
else if(i>=74)
ob=new("/d/eastway/qinling/obj/shengji3");
else if(i>=72)
ob=new("/d/eastway/qinling/obj/drug/yuanpinzhu");
else if(i>=71)
ob=new("/d/eastway/qinling/obj/drug/perdan");
else if(i>=70)
ob=new("/d/eastway/qinling/obj/drug/cpsdan");
else if(i>=60)
ob=new("/d/eastway/qinling/obj/book1");
else if(i>=50)
{
ob=new("d/9sky/guzhanchang/obj/yundan");
ob->set_amount(3+random(2));
}
else if(i>=45)
{
ob=new("/obj/money/jinbi");
ob->set_amount(3+random(2));
}
else if(i>=42)
ob=new("/d/eastway/qinling/obj/fali3");
else if(i>=35)
{
ob=new("/obj/money/thousand-cash");
ob->set_amount(10+random(5));
}
else if(i>=32)
ob=new("/d/eastway/qinling/obj/drug/jiedudan");
else if(i>=25)
{
ob=new("/obj/money/gold");
ob->set_amount(400+random(500));
}
else if(i>=23)
ob=new("/d/eastway/qinling/obj/drug/jiedudan");
else if(i>=15)
{
ob=new("/obj/money/silver");
ob->set_amount(500+random(500));
}
else if(i>=14)
ob=new("/d/eastway/qinling/obj/drug/cordan");
else if(i>=13)
ob=new("/d/eastway/qinling/obj/drug/kardan");
else if(i>=10)
ob=new("/d/eastway/qinling/obj/xingtian");
else if(i>=8)
ob=new("/d/eastway/qinling/obj/minjie");
else if(i>=6)
ob=new("/d/eastway/qinling/obj/neili3");
else
{
ob=new("/obj/money/coin");
ob->set_amount(50000+random(10000));
}
if ( ob )       
        ob->move(this_object());
else    {
        ob=new("/obj/money/coin");
        ob->set_amount(1500+random(8000));
        if ( ob )       
                ob->move(this_object());
        }               
set("unit", "个");
set("no_sell", 1);
set("no_put", 1);
set("no_give", 1);
set("long", "一个翡翠制成的盒子，盒盖上镶满了珍珠。\n");
set("value",0);
}
int is_container()
{
return 1;
}
