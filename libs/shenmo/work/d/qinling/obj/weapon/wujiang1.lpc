#include <ansi.h>
#include <weapon.h>

inherit SPEAR;

void create() {
  set_name(HIC "八宝驮龙枪" NOR, ({ "babao spear", "qiang", "spear" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一杆碗口粗的长枪，上有一条神龙缠绕。\n");
    set("unit", "杆");
    set("value", 500);
    set("no_break", 1);
  }
  init_spear(180);
  setup();
}
