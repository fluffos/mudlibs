#include <ansi.h>
#include <weapon.h>

inherit HAMMER;

void create()
{
        set_name(HIY"擂鼓瓮金椎"NOR, ({"wengjin chui", "chui", "hammer"}));
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long","一对水桶大小的金锤，刚猛无比！\n");
                set("unit", "对");
                set("value", 500);
                set("no_break", 1);
        }
        init_hammer(180);
        setup();
}

