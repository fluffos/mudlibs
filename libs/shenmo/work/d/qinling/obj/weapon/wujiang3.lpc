#include <ansi.h>
#include <weapon.h>

inherit QIN;

void create()
{
        set_name(MAG"焦尾琴"NOR, ({"jiaowei qin", "qin"}));
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long","一架古色古香的焦尾琴，相传为三国蔡邕之物。\n");
                set("unit", "架");
                set("value", 500);
                set("no_break", 1);
        }
        init_qin(180);
        setup();
}

