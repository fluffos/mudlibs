#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create()
{
        set_name(HIW"鱼肠剑"NOR, ({"yuchang jian", "jian", "sword"}));
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long","一把锋利的短剑，非常方便藏匿．\n");
                set("unit", "把");
                set("value", 500);
                set("no_break", 1);
        }
        init_sword(125);
        setup();
}

