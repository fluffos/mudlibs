#include <ansi.h>
#include <weapon.h>

inherit STICK;

void create() {
  set_name(HIW "摄魂棍" NOR, ({ "shehun gun", "gun", "stick" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一根铁棍，黑中透着亮光．\n");
    set("unit", "根");
    set("value", 500);
    set("no_break", 1);
  }
  init_stick(125);
  setup();
}
