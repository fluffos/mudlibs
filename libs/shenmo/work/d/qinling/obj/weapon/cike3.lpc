#include <ansi.h>
#include <weapon.h>

inherit FORK;

void create()
{
        set_name(HIW"夺魄叉"NOR, ({"duopo cha", "cha", "fork"}));
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long","一把精钢打造的三齿叉，锃明刷亮．\n");
                set("unit", "把");
                set("value", 500);
                set("no_break", 1);
        }
        init_fork(125);
        setup();
}

