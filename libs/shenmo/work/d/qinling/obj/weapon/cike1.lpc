#include <ansi.h>
#include <weapon.h>

inherit STAFF;

void create()
{
        set_name(HIY"九龙杖"NOR, ({"jiulong zhang", "zhang", "staff"}));
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long","一根金灿灿的禅杖，上面有九条龙缠绕着．\n");
                set("unit", "根");
                set("value", 500);
                set("no_break", 1);
        }
        init_staff(125);
        setup();
}

