#include <ansi.h>
inherit ITEM;
void create()
{
object me = this_player();
object ob;
int i;

set_name(HIW"玛瑙象牙盒"NOR, ({ "box" }) );
set_weight(0);
set_max_encumbrance(40000);
seteuid(getuid());
i=random(100);
if(i >=99)
ob=new("/d/eastway/qinling/obj/dengji3");
else if(i >=98)
ob=new("/d/eastway/qinling/obj/drug/spidan");
else if(i >=97)
ob=new("/d/eastway/qinling/obj/drug/kardan");
else if(i >=96)
ob=new("/d/eastway/qinling/obj/book/forcebook2");
else if(i >=95)
ob=new("/d/eastway/qinling/obj/book/unarmedbook2");
else if(i >=94)
ob=new("/d/eastway/qinling/obj/book/dodgebook2");
else if(i >=93)
ob=new("/d/eastway/qinling/obj/book/parrybook2");
else if(i >=92)
ob=new("/d/eastway/qinling/obj/book/spellsbook2");
else if(i >=90)
ob=new("/d/eastway/qinling/obj/haomao");
else if(i>=89)
ob=new("/d/eastway/qinling/obj/book/literatebook2");
else if(i>=88)
ob=new("/d/eastway/qinling/obj/book/medicalbook2");
else if(i>=80)
ob=new("/d/eastway/qinling/obj/shengji3");
else if(i>=77)
ob=new("/d/eastway/qinling/obj/neili3");
else if(i>=74)
ob=new("/d/eastway/qinling/obj/fali3");
else if(i>=71)
ob=new("/d/eastway/qinling/obj/sanqing3");
else if(i>=60)
ob=new("/d/eastway/qinling/obj/book1");
else if(i>=50)
{
ob=new("d/9sky/guzhanchang/obj/yundan");
ob->set_amount(5);
}
else if(i>=45)
{
ob=new("/obj/money/jinbi");
ob->set_amount(5);
}
else if(i>=42)
ob=new("/d/eastway/qinling/obj/lingzhi3");
else if(i>=35)
{
ob=new("/obj/money/thousand-cash");
ob->set_amount(10+random(5));
}
else if(i>=25)
{
ob=new("/obj/money/gold");
ob->set_amount(800+random(200));
}
else if(i>=15)
{
ob=new("/obj/money/silver");
ob->set_amount(800+random(200));
}
else if(i>=14)
ob=new("/d/eastway/qinling/obj/drug/cordan");
else if(i>=10)
ob=new("/d/eastway/qinling/obj/xingtian");
else if(i>=9)
ob=new("/d/eastway/qinling/obj/drug/cpsdan");
else if(i>=6)
ob=new("/d/eastway/qinling/obj/minjie");
else if(i>=5)
ob=new("/d/eastway/qinling/obj/drug/perdan");
else if(i>=3)
ob=new("/d/eastway/qinling/obj/drug/huimeng");
else
{
ob=new("/obj/money/coin");
ob->set_amount(70000+random(30000));
}
if ( ob )       
        ob->move(this_object());
else    {
        ob=new("/obj/money/coin");
        ob->set_amount(1500+random(8000));
        if ( ob )       
                ob->move(this_object());
        }               
          log_file("static/record",sprintf("%s(%s)时间 %s %s\n",me->name(1), geteuid(me),this_object()->name(1),ctime(time()) ) );
set("unit", "个");
set("no_sell", 1);
set("no_put", 1);
set("no_give", 1);
set("long", "一个象牙制成的盒子，盒盖上镶满了玛瑙。\n");
set("value",0);
}
int is_container()
{
return 1;
}
