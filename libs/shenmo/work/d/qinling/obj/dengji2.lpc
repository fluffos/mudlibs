#include <ansi.h>
inherit ITEM;
void create()
{
set_name(HIR"等级魄石"NOR,({"dengji poshi","poshi"}));
set("unit","颗");
set("long","一颗流光四射的魔力魄石，用它可以提高(levelup)自己的等级。\n");
set_weight(3000); 
set("value",0);
set("no_give",1);
set("no_put",1);
setup();
}
void init()
{
//by snowtu 2014.04.20
//add_action("do_levelupp","levelup");
}
int err_msg(string arg)
{
write(arg);
return 0;
}
int do_levelupp(string arg)
{
object me;
int my_level;
me = this_player();
if ( !present(this_object(),me) )  return 0;  //这个必须有，不然不get就可以用了
if ( me->is_busy() )  return notify_fail("你正忙着呢。\n");  //不加的话就是第二个凤凰琴了
my_level=me->query("level");
me = this_player();
//if ( my_level>=1400 )
{
write(name()+"轰的一声炸得四开五裂，看来是太小了。。。。\n");  
destruct(this_object()); 
return 1; 
}
if ( random(me->query("mana"))<me->query("max_mana")/4*3 ) 
{
          write(name()+"轰的一声炸得四开五裂，看来你的法力有些无法驾御了。。。。\n"); 
          destruct(this_object()); 
          return 1;   
}
message("channel:rumor",HIM"【顺风耳】某人：听说"+me->name()+HIM"使用了中等的"+name()+HIM"提升了自己的等级。\n"NOR,users());
write(NOR"ok\n");
me->set("level",my_level+1);
me->start_busy(1+random(3));
me->save();
destruct(this_object());
return 1;
}
string short()
{
return ::short()+"(中)";
}
