#include <ansi.h>
inherit NPC;
void create() {
  set_name("织女", ({ "zhi nu", "zhinu", "xian" }));
  set("long",
    "西王母的外甥女。因为私自下凡与牛郎相爱，而被罚银河永隔，\n只有每年的七月初七才能鹊桥相会。\n");
  set("gender", "女性");
  set("age", 20);
  set("class", "xian");
  set("title", HIM "望夫心切" NOR);
  set("attitude", "friendly");
  set("rank_info/respect", "仙姑");
  set("per", 30);
  set("int", 30);
  set("max_kee", 1500);
  set("max_gin", 1500);
  set("max_sen", 1500);
  set("force", 1200);
  set("max_force", 1200);
  set("force_factor", 50);
  set("max_mana", 1200);
  set("mana", 1200);
  set("mana_factor", 80);
  set("combat_exp", 800000);
  //   carry_object("/d/moon/obj/luoyi")->wear();
  //    carry_object("/d/obj/flower/rose")->wear();
  setup();
}

void announce_success(object who) {
  int i;

  if (who->query("combat_exp") < 3000000)
    return;
  if (who->query("obstacle/niulang") == "done")
    return;
  if (!who->query_temp("daqiao") || !who->query_temp("ask_niulang"))
    return;
  i = random(10000);
  who->set("obstacle/niulang", "done");
  message_vision(CYN "织女对$N深深一拜，说道：这位恩人助我与夫君团圆，我与夫君不胜感激，此有小礼，无以为报，请恩人收下！\n" NOR, who);
  message_vision(CYN "织女伸出手在$N的头上轻轻的摸了一下，$N突然发现自己身体起了一些奇异的变化！\n" NOR, who);
  who->add("per", 1 + random(5));
  who->add("combat_exp", i + 30000);
  who->add("daoxing", i + 30000);
  who->add("potential", i / 2 + 10000);
  who->add("legends/number", 1);
  command("chat " + who->query("name") + "大智大勇，助我与夫君团圆！");
  tell_object(who, "你赢得了" + chinese_number(30) + "年" +
    chinese_number(i / 400) + "天" +
    chinese_number(((i - (i / 4) * 4) * 3) / 100) + "时辰的道行！\n");
  tell_object(who, "你赢得了" + (i / 2 + 10000) + "点潜能！\n");
  tell_object(who, "你赢得了" + (i + 30000) + "点武学！\n");
  who->save();
}
