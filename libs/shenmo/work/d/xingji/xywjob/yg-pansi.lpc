#include <ansi.h> 
inherit __DIR__"yaoguai.lpc";


void set_skills(int j, int level)
{
        object me=this_object();
        object weapon;

        me->set("title",HIM"红颜白发"NOR);
        me->set("class", "yao");
        me->set_skill("unarmed", j);
        me->set("level", j);
        me->set_skill("dodge", j);
        me->set_skill("parry", j);
        me->set_skill("force", j);
        me->set_skill("spells", j);
        me->set_skill("whip",j); 
		me->set_skill("sword",j); 
        
        me->set_skill("yinsuo-jinling", j+random(15));
	me->set_skill("chixin-jian", j+random(15));        
        me->set_skill("spells",j+random(15));
        me->set_skill("yueying-wubu",j+random(15));
        me->set_skill("pansi-dafa", j+random(15));
        me->set_skill("unarmed", j+random(15));        
        me->set_skill("lanhua-shou", j+random(15));
        me->set_skill("jiuyin-xinjing", j+random(15)); 

        me->set_skill("qin", j+random(15)); 
        me->map_skill("force", "jiuyin-xinjing");
        me->map_skill("whip", "yinsuo-jinling");  
		me->map_skill("sword", "chixin-jian");
        me->map_skill("parry", "chixin-jian");
        me->map_skill("spells", "pansi-dafa");
        me->map_skill("dodge", "yueying-wubu");
        me->map_skill("unarmed", "lahua-shou");

	set("chat_chance_combat", cast_chance(level));
        set("chat_msg_combat", ({
        (: perform_action,"sword", "hongyan" :),
        (: perform_action,"sword", "haotan" :),
        (: perform_action,"whip", "tian" :),
        (: perform_action,"whip", "wanling" :),
        (: perform_action,"whip", "wang" :),
        (: perform_action,"whip", "sanshou" :),
        (: perform_action,"unarmed", "juehu" :),
        (: cast_spell, "wuzhishan" :),
        }) );        
        create_family("盘丝洞", 2, "蓝");  
        if (random(2))
           weapon=new("/d/city/npc/obj/whip"); 
        else
           weapon=new("/d/city/npc/obj/sword"); 
        if (random(2))
        weapon->set("no_break", 1);
        weapon->move(me);
        carry_object("/d/obj/stey/xianyi")->wear();
        command("wield all");
}
