//yg-emei by piao

#include <ansi.h>

inherit __DIR__ "yaoguai.lpc";


void set_skills(int j, int level) {
  object me = this_object();
  object weapon;

  me->set("title", HIM "天玑雷炎" NOR);
  me->set("class", "human");
  me->set_skill("unarmed", j);
  me->set("level", j);
  me->set_skill("dodge", j);
  me->set_skill("parry", j);
  me->set_skill("force", j);
  me->set_skill("spells", j);
  me->set_skill("sword", j);

  me->set_skill("jinding-zhang", j);
  me->set_skill("tianlei-sword", j);
  me->set_skill("zhutian-bu", j);
  me->set_skill("emeiforce", j);
  me->set_skill("mahayana", j);

  me->map_skill("unarmed", "jinding-zhang");
  me->map_skill("dodge", "zhutian-bu");
  me->map_skill("sword", "tianlei-sword");
  me->map_skill("parry", "tianlei-sword");
  me->map_skill("force", "emeiforce");
  me->map_skill("spells", "mahayana");

  set("chat_chance_combat", cast_chance(level));
  set("chat_msg_combat", ({
    (: perform_action, "sword", "tianlei" :),
    (: perform_action, "sword", "huan" :),
    (: perform_action, "sword", "mie" :),
    (: perform_action, "sword", "riluo" :),
    (: perform_action, "unarmed", "bashi" :),
    (: cast_spell, "haotian" :),
    (: exert_function, "heal" :),
  }));

  create_family("峨嵋派", 2, "蓝");
  weapon = new("/d/city/npc/obj/sword");
  if (random(2))
    weapon->set("no_break", 1);
  weapon->move(me);
  carry_object("/d/obj/stey/xianyi")->wear();
  command("wield all");
}
