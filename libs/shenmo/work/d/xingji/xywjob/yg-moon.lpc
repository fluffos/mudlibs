
// bula and mon@xyj

#include <ansi.h> 
inherit __DIR__"yaoguai.lpc";

// here should be this NPC specific skills.

void set_skills(int j, int level)
{
        object me=this_object();
        object weapon;

        set("title",HIW"风回雪舞"NOR);
        me->set("level", j);
        me->set("class", "xian");
	set("gender", "女性");
        me->set_skill("unarmed", j);
        me->set_skill("dodge", j);
        me->set_skill("parry", j);
        me->set_skill("force", j);
        me->set_skill("spells", j);
 
        me->set_skill("whip", j+random(15));
        me->set_skill("jueqingbian", j+random(15));
        me->set_skill("sword",j+random(15));
        me->set_skill("snowsword",j+random(15));
        me->set_skill("moondance", j+random(15));
        me->set_skill("moonshentong", j+random(15));
        me->set_skill("baihua-zhang", j+random(15));
        me->set_skill("moonforce", j+random(15));

        me->map_skill("force", "moonforce");
        me->map_skill("sword", "snowsword");
        me->map_skill("whip","jueqingbian");
        me->map_skill("parry", "jueqingbian");
        me->map_skill("spells", "moonshentong");
        me->map_skill("dodge", "moondance");
        me->map_skill("unarmed", "baihua-zhang");

	set("chat_chance_combat", cast_chance(level));
        set("chat_msg_combat", ({
        (: cast_spell, "arrow" :),
        (: cast_spell, "mihun" :),
        (: perform_action,"sword", "wuxue" :), 
        (: perform_action,"sword", "tian" :), 
        (: perform_action,"sword", "one" :), 
        (: perform_action,"whip", "sanshou" :), 
        (: perform_action,"whip", "wenqing" :), 
        (: perform_action,"unarmed", "flower" :), 
        (: cast_spell, "qingwang" :), 
        }) );

        create_family("月宫", 2, "蓝");  
        if (random(2))
//modify by yudian 2000-11-14
           weapon=new("/d/city/npc/obj/whip"); 
        else
           weapon=new("/d/city/npc/obj/sword"); 
        if (random(2))
        weapon->set("no_break", 1);
        weapon->move(me);
        carry_object("/d/obj/stey/xianyi")->wear();
        command("wield all");
}
