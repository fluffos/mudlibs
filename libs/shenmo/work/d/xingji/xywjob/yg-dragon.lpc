
// bula and mon@xyj

#include <ansi.h> 
inherit __DIR__"yaoguai.lpc";

// here should be this NPC specific skills.

void set_skills(int j, int level)
{
        object me=this_object();
        object weapon;

        me->set("title",HIG"无尽风波"NOR);
        me->set("class", "xian");
        me->set("level", j);
        me->set_skill("unarmed", j);
        me->set_skill("dodge", j);
        me->set_skill("parry", j);
        me->set_skill("force", j);
        me->set_skill("spells", j);
 
        me->set_skill("fork", j+random(15));
        me->set_skill("fengbo-cha", j+random(15));
        me->set_skill("hammer",j+random(15));
        me->set_skill("huntian-hammer",j+random(15));
        me->set_skill("dragonstep", j+random(15));
        me->set_skill("dragonfight", j+random(15));
        me->set_skill("dragonforce", j+random(15));
        me->set_skill("seashentong", j+random(15));

        me->map_skill("force", "dragonforce");
        me->map_skill("fork", "fengbo-cha");
        me->map_skill("hammer","huntian-hammer");
        me->map_skill("parry", "huntian-hammer");
        me->map_skill("spells", "seashentong");
        me->map_skill("dodge", "dragonstep");
        me->map_skill("unarmed", "dragonfight");

        set("chat_chance_combat", cast_chance(level));
        set("chat_msg_combat", ({
        (: cast_spell, "freez" :),
        (: perform_action,"fork", "fengbo" :), 
        (: perform_action,"fork", "jiutian" :), 
        (: perform_action,"hammer", "break" :), 
        (: perform_action,"unarmed", "leidong" :), 
        (: perform_action,"unarmed", "sheshen" :), 
        (: cast_spell, "hufa" :), 
        (: cast_spell, "dragonfire" :), 
        (: exert_function, "zhenshen" :),
        }) );

        create_family("东海龙宫", 2, "蓝");  
        if (random(2))
           weapon=new("/d/city/npc/obj/fork"); 
        else
           weapon=new("/d/city/npc/obj/hammer"); 
        if (random(2))
        weapon->set("no_break", 1);
        weapon->move(me);
        carry_object("/d/obj/stey/xianyi")->wear();
        command("wield all");
}
