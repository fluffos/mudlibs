// yg-kunlun   by piao

#include <ansi.h>
inherit __DIR__"yaoguai.lpc";

void set_skills(int j, int level)
{
        object me=this_object();
        object weapon;

        set("title",BLU"修罗煞星"NOR);
        me->set("level", j);
        me->set("class", "yao");
	set("gender", "男性");
        me->set_skill("unarmed", j);
        me->set_skill("dodge", j);
        me->set_skill("parry", j);
        me->set_skill("force", j);
        me->set_skill("spells", j);
 
        me->set_skill("whip", j);
        me->set_skill("ruanhong-zhusuo", j);
        me->set_skill("sword",j);
        me->set_skill("jinwu-goufa",j);
        me->set_skill("jinshe-steps", j);
        me->set_skill("xiuluo-yinshagong", j);
        me->set_skill("wudu-shenzhang", j);
        me->set_skill("wudu-xinfa", j);

        me->map_skill("force", "wudu-xinfa");
        me->map_skill("sword", "jinwu-goufa");
        me->map_skill("whip",  "ruanhong-zhusuo");
        me->map_skill("parry", "ruanhong-zhusuo");
        me->map_skill("spells", "xiuluo-yinshagong");
        me->map_skill("dodge", "jinshe-steps");
        me->map_skill("unarmed", "wudu-shenzhang");

	set("chat_chance_combat", cast_chance(level));
        set("chat_msg_combat", ({
        (: perform_action,"sword", "duo" :),
        (: perform_action,"whip", "teng" :),
        (: perform_action,"whip", "suo" :),
        (: perform_action,"whip", "pan" :),
        (: perform_action,"whip", "bohu" :),
        (: perform_action,"unarmed", "huan" :),
        (: perform_action,"unarmed", "shi" :),
        (: exert_function, "huti" :),
        }) );

        create_family("黄花观五毒门", 2, "蓝");  
        if (random(2))
           weapon=new("/d/city/npc/obj/sword"); 
        else
           weapon=new("/d/city/npc/obj/whip"); 
        if (random(2))
        weapon->set("no_break", 1);
        weapon->move(me);
        carry_object("/d/obj/stey/xianyi")->wear();
        command("wield all");
}
