// yg-kunlun   by piao

#include <ansi.h>
inherit __DIR__ "yaoguai.lpc";

void set_skills(int j, int level) {
  object me = this_object();
  object weapon;

  set("title", HIW "无影剑圣" NOR);
  me->set("level", j);
  me->set("class", "xian");
  set("gender", "男性");
  me->set_skill("unarmed", j);
  me->set_skill("dodge", j);
  me->set_skill("parry", j);
  me->set_skill("force", j);
  me->set_skill("spells", j);

  me->set_skill("sword", j);
  me->set_skill("wuying", j);
  me->set_skill("mizongbu", j);
  me->set_skill("feisheng", j);
  me->set_skill("fumobashi", j);
  me->set_skill("xiantian", j);

  me->map_skill("force", "xiantian");
  me->map_skill("sword", "wuying");
  me->map_skill("parry", "wuying");
  me->map_skill("spells", "feisheng");
  me->map_skill("dodge", "mizongbu");
  me->map_skill("unarmed", "fumobashi");

  set("chat_chance_combat", cast_chance(level));
  set("chat_msg_combat", ({
    (: perform_action, "sword", "juechen" :),
    (: perform_action, "sword", "fenge" :),
    (: perform_action, "sword", "wuji" :),
    (: perform_action, "sword", "piyi" :),
    (: perform_action, "unarmed", "zhen" :),
    (: perform_action, "unarmed", "duo" :),
    (: cast_spell, "feixian" :),
    (: exert_function, "huti" :),
  }));

  create_family("武圣门", 2, "蓝");
  if (random(2))
    weapon = new("/d/city/npc/obj/sword");
  else
    weapon = new("/d/city/npc/obj/sword");
  if (random(2))
    weapon->set("no_break", 1);
  weapon->move(me);
  carry_object("/d/obj/stey/xianyi")->wear();
  command("wield all");
}
