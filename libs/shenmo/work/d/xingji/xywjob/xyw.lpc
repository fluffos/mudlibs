#include <ansi.h>
inherit NPC;
#include <obstacle.h> 
string *list=({"yg-sanjie","yg-putuo","yg-moon","yg-wzg","yg-shushan","yg-hyd",
    "yg-fangcun","yg-hell","yg-jjf","yg-pansi","yg-jjf1","yg-wusheng","yg-mojie",
    "yg-dragon","yg-xueshan","yg-mingjiao","yg-shenjian","yg-yhg","yg-forall","yg-sanxian",
        "yg-wudidong","yg-youxia","yg-emei","yg-shaolin","yg-kunlun","yg-bbt","yg-gumu",
        "yg-wudu", "yg-japan", "yg-xiaoyao",
		});

int work_me();
int cancel_me();
int delete_ask(object me);
 
void create()
{
 
        set_name(HIW"王方平"NOR, ({ "wang fangping", "wang" }) );
	set("gender", "男性" );
        set("long", "曾三次经过沧海桑田的变换，阅人无数。现为阎罗地府轮回司之主。\n");
        set("age",40);
        set("title", HIB"地狱轮回司主"NOR);
	set("str", 40);
	set("int", 30);
	set("con", 30);
	set("spi", 30);
	set("per", 30);
	set("class", "xian");
	set("attitude", "heroism");
	set("combat_exp", 1500000);
	set("daoxing", 2000000);
	set("max_kee", 2000);
	set("max_sen", 2000);
	set("force",5000);
	set("max_force",3000);
	set("force_factor", 150);
	set("mana", 5000);
	set("max_mana", 3000);
	set("mana_factor", 150);

	set("eff_dx", 600000);
	set("nkgain", 600);

	set_skill("unarmed",170);
	set_skill("dodge",170);
	set_skill("parry",170);
	set_skill("sword", 180);
	set_skill("force", 170);
	set_skill("spells", 170);
 	set_skill("changquan", 170);
	set_skill("liangyi-sword", 180);
	set_skill("baguazhou", 170);
	set_skill("moshenbu", 170);
	set_skill("lengquan-force", 170);
	map_skill("unarmed", "changquan");
	map_skill("force", "lengquan-force");
	map_skill("spells", "baguazhou");
	map_skill("sword", "liangyi-sword");
	map_skill("parry", "liangyi-sword");
	map_skill("dodge", "moshenbu");
	
	set("chat_chance",1);
	set("chat_msg", ({
                    name()+"说道：哪位仙长愿协助本司去人间界勾魂索魄？\n",
		    }));

        seteuid(getuid());

	set("inquiry", ([
        "suoming": (: work_me :),
	"kill": (: work_me :),
        "索命": (: work_me :),
	"放弃": (: cancel_me :),
	"fangqi": (: cancel_me :),
	"cancel": (: cancel_me :),
	]));

	setup();
	carry_object("/d/obj/armor/jinjia")->wear();
	carry_object("/d/sky/obj/zhanyaojian")->wield();
}
//this funtion is modified by vikee 2000-11-20 1:32
int cancel_me()
{	object ghost,me=this_player();
//this modi by cnd delete here if for bug
	if(!me->query("mieyao/time_start")||
           me->query("mieyao/time_start")+900<time() ||
	   me->query("mieyao/time_start")>time() ||
	   me->query("mieyao/done")||
	   !me->query_temp("mieyao/ob"))
	   
	{
	   command("bite");
       tell_object(me,CYN"王方平说道：你现在没有任务，来凑什么热闹！\n"NOR); 
	   return 1;
       }
	ghost=me->query_temp("mieyao/ob");
	if (!living(ghost))
	{
        tell_object(me,CYN"王方平说道："+ghost->query("name")+"这个孽障已经跑了!\n"NOR);  
	   return 1;
        }
	me->delete_temp("mieyao/ob");
// 删除灭妖资料
	me->delete_temp("mieyao/name");
	me->delete_temp("mieyao/time_start");
	//如果放弃这个怪物,当前的level从第一个开始.
	me->set_temp("mieyao/level",1);
	command("xbao");
        tell_object(me,CYN"王方平说道：你既然无力收服"+ghost->query("name")+", 只好任它去了。\n"NOR);  
          me->set("mieyao/done",1);
	destruct(ghost);
	return 1;
}
 
int work_me()
{
	object ghost, me;
              int t, lvl, i;
       int size1 = sizeof(obstacles); 
	me=this_player();
    if (me->query("shilian") !=1 ){ 
            message_vision("$N说"+"：这位"+RANK_D->query_respect(me) +"你还是过了试炼再来吧。\n",this_object(), me);  
           return 1; 
       } 
if (me->query("combat_exp")/600000 > me->query("level")){ 
         message_vision("$N说"+"：这位"+RANK_D->query_respect(me) 
      +"你的能力不足以后再来吧。\n",this_object(), me);  
         return 1; 
     } 
          //for first time.
	if(!me->query("mieyao")) {
		call_out("start_job", 1, me);
		return 1;
	}
	if( (t=(int)me->query("mieyao/time_start")) &&
		!me->query("mieyao/done")) {

	    if(t<=time() &&
           time()<t+200) {
		command("heng");
        tell_object(me,CYN"王方平说道：本司不是派你去除掉"+me->query("mieyao/name") +"吗？\n"NOR);  
		return 1;
	    }
	    // here is modified by vikee for the #9 ask li about kill 's bug
	    // or the #8 {u;ask li about kill;d}'s bug,
	    // set a flag "mieyao/level_change" to judge the monster level.
	    
	    if(!me->query_temp("mieyao/level_changed")) {
		lvl=me->query_temp("mieyao/level");
		if(lvl>0) lvl--;
		me->set_temp("mieyao/level",lvl);
		me->set_temp("mieyao/level_changed",1);
	    }
	    // allow ask again.
	} else { // job done
                        if((i=(int)me->query("zhuanshi")) 
                                     && t<=time() && time()<t+18+i
                                         || (int)SDS_D->ptime(me)>14500 ) {
                message_vision("$N对手中《轮回生死簿》一看，说"+
			"：这位"+RANK_D->query_respect(me)
                        +",目前并无不法之徒,不妨先去歇息。\n",
			this_object(), me);
		return 1;
	    }
	    // succeed, increase lvl.
	    if(!me->query_temp("mieyao/level_changed")) {
		lvl=me->query_temp("mieyao/level");
		if(lvl<9) lvl++; // total 10 levels: 0, ..., 9
		else
		    lvl=1; // reach the top level, reduce difficulty.
		me->set_temp("mieyao/level",lvl);
		me->set_temp("mieyao/level_changed",1);
	    }
	}
	me->delete("mieyao/time_start");
	call_out("start_job", 1, me);
	return 1;
}
int start_job(object me)
{	string where;
	object ghost;
	int lvl;

	if(!me || environment(me)!=environment()) return 1;
	if(me->query("mieyao/time_start")) return 1;
	me->delete("mieyao/done");
	me->set_temp("mieyao/level_changed",0);

	// determine levels.
	// use temp mark, if quit, then start over.
	lvl=me->query_temp("mieyao/level");
	
          ghost = new(__DIR__+list[random(sizeof(list))]);
          if ( !ghost )  {say(name()+"摇了摇头：目前暂无安排。。。。\n");
                    return 0;
                    }
//add by snowtu
        where=ghost->invocation(me, lvl);
        tell_object(me,"任务等级："+lvl+"\n"NOR,);
        message_vision("$N捋了捋自己的三绺长髯！\n",this_object());
       message_vision("$N对$n说道：近有"+where+"狂妄之极，不受轮回，"
        +"请速去降伏这厮！\n"
		,this_object(),me);
        me->set("mieyao/where",where);
        me->add("mieyao/number",1);
        me->set("mieyao/id",ghost->query("id"));

	me->set("mieyao/time_start", time());
	me->set("mieyao/name",ghost->query("name"));
	me->set_temp("mieyao/ob",ghost);
	return 1;
}

int delete_ask(object me)
{
        me->delete_temp("asked/yanwang");
        return 1;
}