// yg-kunlun   by piao

#include <ansi.h>
inherit __DIR__ "yaoguai.lpc";

void set_skills(int j, int level) {
  object me = this_object();
  object weapon;

  set("title", RED "嗜血成性" NOR);
  me->set("level", j);
  me->set("class", "yao");
  set("gender", "男性");
  me->set_skill("unarmed", j);
  me->set_skill("dodge", j);
  me->set_skill("parry", j);
  me->set_skill("force", j);
  me->set_skill("spells", j);

  me->set_skill("whip", j);
  me->set_skill("liudu-whip", j);
  me->set_skill("sword", j);
  me->set_skill("xueling-jian", j);
  me->set_skill("moshenbu", j);
  me->set_skill("molian-spells", j);
  me->set_skill("dianxue", j);
  me->set_skill("heilian-force", j);

  me->map_skill("force", "heilian-force");
  me->map_skill("sword", "xueling-jian");
  me->map_skill("whip", "liudu-whip");
  me->map_skill("parry", "xueling-jian");
  me->map_skill("spells", "molian-spells");
  me->map_skill("dodge", "moshenbu");
  me->map_skill("unarmed", "dianxue");

  set("chat_chance_combat", cast_chance(level));
  set("chat_msg_combat", ({
    (: perform_action, "whip", "duanyun" :),
    (: perform_action, "whip", "kuang" :),
    (: perform_action, "whip", "shi" :),
    (: perform_action, "sword", "duan" :),
    (: perform_action, "unarmed", "dianxue" :),
    (: cast_spell, "shouxin" :),
    (: exert_function, "powerup" :),
  }));

  create_family("魔界", 2, "蓝");
  if (random(2))
    weapon = new("/d/city/npc/obj/sword");
  else
    weapon = new("/d/city/npc/obj/whip");
  if (random(2))
    weapon->set("no_break", 1);
  weapon->move(me);
  carry_object("/d/obj/stey/xianyi")->wear();
  command("wield all");
}
