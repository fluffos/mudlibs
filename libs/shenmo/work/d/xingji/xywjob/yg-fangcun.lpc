
// bula and mon@xyj

#include <ansi.h> 
inherit __DIR__"yaoguai.lpc";

// here should be this NPC specific skills.

void set_skills(int j, int level)
{
        object me=this_object();
        object weapon;

        set("title",HIC"雷霆霹雳"NOR);
        me->set("class", "xian");
        me->set_temp("jldl", 1);
        me->set_skill("unarmed", j);
        me->set("level", j);
        me->set_skill("dodge", j);
        me->set_skill("parry", j);
        me->set_skill("force", j);
        me->set_skill("spells", j);
 
        me->set_skill("stick", j+random(15));
        me->set_skill("qianjun-bang", j+random(15));
//        me->set_skill("sword",j+random(15));
  //      me->set_skill("sanqing-jian",j+random(15));
        me->set_skill("jindouyun", j+random(15));
        me->set_skill("wuxiangforce", j+random(15));
        me->set_skill("puti-zhi", j+random(15));
        me->set_skill("dao", j+random(15));

        me->map_skill("force", "wuxiangforce");
//        me->map_skill("sword", "sanqing-jian");
        me->map_skill("stick","qianjun-bang");
        me->map_skill("parry", "qianjun-bang");
        me->map_skill("spells", "dao");
        me->map_skill("dodge", "jindouyun");
        me->map_skill("unarmed", "puti-zhi");

	set("chat_chance_combat", cast_chance(level));
        set("chat_msg_combat", ({
        (: perform_action,"stick", "pili" :),
        (: perform_action,"stick","qiankun" :),
        (: perform_action,"stick","leiting" :),
        (: perform_action,"stick","panlong" :),
        (: perform_action,"unarmed","jingmo" :),
        (: perform_action,"unarmed","puti" :),
        (: cast_spell, "fenshen" :),
        (: cast_spell, "light" :),
        (: cast_spell, "dingshen" :),
        (: exert_function, "jldl" :),
        }) );

        create_family("方寸山三星洞", 2, "蓝");  
        weapon=new("/d/city/npc/obj/stick"); 
        if (random(2))
        weapon->set("no_break", 1);
        weapon->move(me);
        carry_object("/d/obj/stey/xianyi")->wear();
        command("wield all");
}
