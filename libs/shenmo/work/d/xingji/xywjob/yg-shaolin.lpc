// yg-shaolin   by piao

#include <ansi.h>
inherit __DIR__"yaoguai.lpc";

void set_skills(int j, int level)
{
        object me=this_object();
        object weapon;

        set("title",HIY"醉酒罗汉"NOR);
        me->set("class", "human");
        me->set_temp("zui_powerup", 1);
        me->set("level", j);
	set("gender", "男性");
        me->set_skill("unarmed", j);
        me->set_skill("dodge", j);
        me->set_skill("parry", j);
        me->set_skill("force", j);
        me->set_skill("spells", j);
 
        me->set_skill("stick", j);
        me->set_skill("zui-gun", j);
        me->set_skill("sword",j);
        me->set_skill("damo-jian",j);
        me->set_skill("shaolin-shenfa", j);
        me->set_skill("chanzong", j);
        me->set_skill("bore-zhang", j);
        me->set_skill("yijinjing", j);

        me->map_skill("force", "yijinjing");
        me->map_skill("sword", "damo-jian");
        me->map_skill("stick",  "zui-gun");
        me->map_skill("parry", "bore-zhang");
        me->map_skill("spells", "chanzong");
        me->map_skill("dodge", "shaolin-shenfa");
        me->map_skill("unarmed", "bore-zhang");

	set("chat_chance_combat", cast_chance(level));
        set("chat_msg_combat", ({
        (: perform_action,"stick", "luan" :),
        (: perform_action,"sword", "chanyi" :),
        (: perform_action,"unarmed", "wusewuxiang" :),
        (: exert_function, "zui" :),
        }) );

        create_family("少林寺", 2, "蓝");  
        if (random(2))
           weapon=new("/d/city/npc/obj/stick"); 
        else
           weapon=new("/d/city/npc/obj/sword"); 
        if (random(2))
        weapon->set("no_break", 1);
        weapon->move(me);
        carry_object("/d/obj/stey/xianyi")->wear();
        command("wield all");
}
