// yg-kunlun   by piao

#include <ansi.h>
inherit __DIR__"yaoguai.lpc";

void set_skills(int j, int level)
{
        object me=this_object();
        object weapon;

        set("title",WHT"浪客剑心"NOR);
        me->set("level", j);
        me->set("class", "human");
	set("gender", "男性");
        me->set_skill("unarmed", j);
        me->set_skill("dodge", j);
        me->set_skill("parry", j);
        me->set_skill("force", j);
        me->set_skill("spells", j);
 
        me->set_skill("sword", j);
        me->set_skill("huoxin-sword", j);
        me->set_skill("fengyu-piaoxiang", j);
        me->set_skill("renshu", j);
        me->set_skill("kongshoudao", j);
        me->set_skill("guixi-force", j);

        me->map_skill("force", "guixi-force");
        me->map_skill("sword", "huoxin-sword");
        me->map_skill("parry", "huoxin-sword");
        me->map_skill("spells", "renshu");
        me->map_skill("dodge", "fengyu-piaoxiang");
        me->map_skill("unarmed", "kongshoudao");

	set("chat_chance_combat", cast_chance(level));
        set("chat_msg_combat", ({
        (: perform_action,"sword", "shenqi" :),
        (: perform_action,"sword", "qiehe" :),
        (: perform_action,"unarmed", "shuang" :),
        (: perform_action,"unarmed", "erchongjin" :),
        (: cast_spell, "fenshen" :),
        (: cast_spell, "nuhuoyanling" :),
        (: exert_function, "jingxin" :),
        }) );
        create_family("剑客联盟", 2, "蓝");  

        if (random(2))
           weapon=new("/d/city/npc/obj/sword"); 
        else
           weapon=new("/d/city/npc/obj/sword"); 
        if (random(2))
        weapon->set("no_break", 1);
        weapon->move(me);
        carry_object("/d/obj/stey/xianyi")->wear();
        command("wield all");
}
