#include <ansi.h>
// bula and mon@xyj

#include <ansi.h> 
inherit __DIR__"yaoguai.lpc";

// here should be this NPC specific skills.

void set_skills(int j, int level)
{
        object me=this_object();
        object weapon;

        me->set("title",HIW"仗剑江湖"NOR);
        me->set("class", "human");
        me->set("level", j);
        me->set_skill("unarmed", j);
        me->set_skill("dodge", j);
        me->set_skill("parry", j);
        me->set_skill("force", j);
        me->set_skill("spells", j);
 
        me->set_skill("sword", j);
        me->set_skill("baiyun-sword", j);
        me->set_skill("piaoxiang", j);
        me->set_skill("lingxiyizhi", j);
        me->set_skill("tianjijue", j);
        me->set_skill("tanzhishentong", j);
        me->set_skill("spear", j);
        me->set_skill("mozi-sword", j);
        me->set_skill("wuji-force", j);

        me->map_skill("force", "wuji-force");
        me->map_skill("sword", "baiyun-sword");
        me->map_skill("spear", "mozi-sword");
        me->map_skill("parry", "baiyun-sword");
        me->map_skill("spells", "tianjijue");
        me->map_skill("dodge", "piaoxiang");
        me->map_skill("unarmed", "tanzhishentong");

	set("chat_chance_combat", cast_chance(level));
        set("chat_msg_combat", ({
        (: perform_action,"sword", "feixian" :),
        (: perform_action,"sword", "piao" :),
        (: perform_action,"sword", "east" :),
        (: perform_action,"unarmed", "huayu" :),
        (: perform_action,"unarmed", "jinglei" :),
        (: perform_action,"spear", "gong" :),
        (: exert_function, "xue" :),
        (: cast_spell, "freeze" :),
        (: cast_spell, "bagua" :),
        }) );

        create_family("江湖浪子", 2, "蓝");  
        if (random(2))
           weapon=new("/d/city/npc/obj/spear"); 
        else
           weapon=new("/d/city/npc/obj/sword"); 
        if (random(2))
        weapon->set("no_break", 1);
        weapon->move(me);
        carry_object("/d/obj/stey/xianyi")->wear();
        command("wield all");
}
