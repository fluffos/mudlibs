//修改了部分data没有，不能cancel的bug
//修改了假如鞋子不move的bug
inherit NPC;
#include <ansi.h>

void create() {
  set_name("姜子牙", ({ "jiang ziya", "jiang", "ziya" }));
  set("gender", "男性");
  set("long", "姜子牙乃是封神榜天神，左手手持一个通天镜。\n");
  set("age", 40);
  set("title", "传说中的神仙");
  set("str", 40);
  set("int", 30);
  set("con", 30);
  set("spi", 30);
  set("per", 30);
  set("class", "xian");
  set("attitude", "heroism");
  set("combat_exp", 150000000);
  set("daoxing", 200000000);
  set("max_kee", 20000);
  set("max_sen", 20000);
  set("force", 50000);
  set("max_force", 300000);
  set("force_factor", 1500);
  set("mana", 50000);
  set("max_mana", 300000);
  set("mana_factor", 1500);

  set("eff_dx", 600000);
  set("nkgain", 600);

  set_skill("unarmed", 1700);
  set_skill("dodge", 4000);
  set_skill("parry", 1700);
  set_skill("sword", 1800);
  set_skill("force", 1700);
  set_skill("spells", 1700);
  set_skill("changquan", 1700);
  set_skill("liangyi-sword", 1800);
  set_skill("baguazhou", 1700);
  set_skill("moshenbu", 1700);
  set_skill("lengquan-force", 1700);

  map_skill("unarmed", "changquan");
  map_skill("force", "lengquan-force");
  map_skill("spells", "baguazhou");
  map_skill("sword", "liangyi-sword");
  map_skill("parry", "liangyi-sword");
  map_skill("dodge", "moshenbu");

  set("chat_chance", 1);
  set("chat_msg", ({
    name() + "说道：哎。。近期下界妖怪淫乱，哪位大仙可愿去搭救花仙？\n",
  }));

  seteuid(getuid());
  setup();
  carry_object("/d/obj/armor/jinjia")->wear();
  carry_object("/d/sky/obj/zhanyaojian")->wield();
}

void init() {
  add_action("do_task", "baohu");
  add_action("do_task", "dajiu");
  add_action("do_cancel", "cancel");
}

int do_task() {
  object me = this_player();
  object guai, xie;
  int level, i;
  int tt;
  string where, msg;
  if (me->query("combat_exp") < 180) {
    tell_object(me, "你的武学修为不够，练好了再来！\n");
    return 1;
  }
  if ((tt = (int)me->query("baohu/job_start"))
    && me->query("baohu/done") == "done") {
    // job done
    if (tt <= time() && time() < tt + 9) {
      message_vision("$N拿起通天镜一看，花仙已搭救,你还是等等再来。\n", this_object(), me);
      return 1;
    }
  }

  me->command("say 最近可有妖怪为害花仙？");
  if (me->query("baohu/fail")) {
    if (tt <= time() && time() < tt + 160) {
      message_vision(CYN "\n姜子牙说道：你任务失败了，等等再来把。\n" NOR, me);
      return 1;
    }
    me->delete("baohu/fail");
  }

  if (me->query("baohu/get")) {
    message_vision(CYN "\n姜子牙说道：花仙等着搭救呢，快快起程。\n" NOR, me);
    return 1;
  }

  //确定任务等级
  level = random(10);
  if (level < 5)
    level = 1;
  else if (level < 8)
    level = 2;
  else level = 3;

  xie = new(__DIR__ "shoes.lpc");
  if (xie->move(me)) {
    guai = new(__DIR__ "baohunpc");
    guai->set("baohu/npcstart", time());
    where = guai->invocation(me, level);
    if (!where && !stringp(where)) {
      message_vision("$N拿起通天镜一看，花仙已搭救,你还是等等再来。\n", this_object(), me);
      return 1;
    }
    me->set("baohu/get", 1);
    me->set("baohu/level", level);
    me->delete("baohu/done");
    message_vision(CYN "\n姜子牙说道：现在有" + where + "附近被妖怪掳去，已经快不行了，你去搭救她吧。\n" NOR, me);
    this_object()->command("job " + me->name() + "接到一个搭救" + guai->name() + "的任务。");
    me->set("baohu/guai", guai);
    me->delete("baohu/job_start");
    me->delete("baohu/kk");
    me->set("baohu/where", where);
    me->set("baohu/start_time", time());
    me->set("baohu/job_start", time());
    me->set("baohu/id", guai->query("id"));
    me->set("baohu/name", guai->query("name"));
    me->set_temp("baohu/ob", guai);
    me->delete_temp("baohu/get");
    message_vision("$N变出一双水晶鞋。\n $N给$n一双水晶鞋。\n", this_object(), this_player());
    return 1;
  } else {
    message_vision("$N拿起通天镜一看，花仙已搭救,你还是等等再来。\n", this_object(), me);
    return 1;
  }
}

int do_cancel() {
  object me = this_player();
  object guai;
  int tt;

  if (time() < me->query_temp("baohu_err") + 30) {
    message_vision("$N说道：$n，你看起来气色不佳，还是去歇歇吧。\n", this_object(), me);
    return 1;
  }

  if (!me->query("baohu/get")) {
    tell_object(me, "你没有任务在身。\n");
    return 1;
  }
  if ((tt = (int)me->query("baohu/job_start"))) {
    if (tt <= time() && time() < tt + 60) {
      me->command("say 这个任务弟子恐怕无能为力搭救。");
      message_vision("$N说道：粉肠交代，时辰未到，不可放弃，小样你就等等吧。\n", this_object(), me);
      return 1;
    } else {
      me->delete_temp("baohu");
      me->command("say 这个任务弟子恐怕无能为力搭救。");
      message_vision(CYN "\n姜子牙说道：好吧，那我另派神仙搭救吧。\n" NOR, me);
      me->delete("baohu/fail", 1);
      me->delete("baohu/get");
      me->delete("baohu/job_start");
      guai = me->query_temp("baohu/ob");
      me->delete("baohu");
      if (living(guai))
        destruct(guai);
      me->delete("baohu/name");
      me->delete_temp("baohu");
      return 1;
    }
  } else {
    me->delete("baohu");
    me->delete_temp("baohu");
    message_vision(CYN "\n姜子牙轻轻拍拍$N" CYN "小头颅：这位小孩子蛮可爱的嘛。\n" NOR, me);
    me->set_temp("baohu_err", time());
    return 1;
  }
}
