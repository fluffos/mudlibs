inherit NPC;

int heart_beat() {
  object me = this_object();
  string str;
  if (!me || !environment(me)) return 0;
  ::heart_beat();

  //if ( me->query("kee")>800 && ( me->is_busy() || random(4) ) )
  //      return 0;
  if (query("eff_kee") < query("max_kee") && random(5) == 1)
    SDS_D->addEffKee(me);
  if (query("kee") < query("eff_kee"))
    SDS_D->addKee(me);
  if (query("sen") < query("eff_sen"))
    SDS_D->addSen(me);
  if (query("eff_sen") < query("max_sen") && random(5) == 1)
    SDS_D->addEffSen(me);

}
