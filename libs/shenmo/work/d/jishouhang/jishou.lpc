// liaotian.c#include <ansi.h>inherit ROOM;int is_chat_room() { return 1; }void create(){        set("short", "神魔寄售行");        set("long", @LONG这里是长安城的寄售行，听说这里是黑白两道交易奇珍异宝之所在，许多无所事事的人在这里聊天，店小二穿梭在众多客人中间，忙个不停。旁边有一个小门，隐隐有一些花香传进来，沁人心肺。门口挂有一块硕大的牌子(paizi)。LONG );        set("item_desc", ([                "paizi": @TEXT           这里是神魔寄售行，价格公道童叟无欺，你可以在这里寄售物品，           也可以求购，但是物品种类有所限制。物品寄售时间为48小时，           如果超过寄售时间未取回，我们有权对该物品进行处理。你也可           以进行购买,黄金会直接从你的卡上划扣或转账或者兑换成信用点。TEXT   HIG"常用指令："+HIY"buyy <数字编号> <物品ID>"NOR+HIG"    购买物品\n"NOR       "           "+HIY"chakan <数字编号> <物品ID>"NOR+HIG"  查看剩余时间\n"NOR     "           "+HIY"list             "NOR+HIG"           查看列表\n"NOR   HIR"注：取回金钱时，请注意自己卡上的黄金余额，用credit money credit    兑换回信用点,以防不必要的损失。\n"NOR           ]) );        set("no_fight", 1);                    set("no_clean_up",1);        set("no_sleep_room", 1);        set("exits", ([              "east" : "/d/wiz/entrance3",              //  "out"   : __DIR__"xiaohuayuan",        ]));	    	set("objects", ([//                        "/u/shulele/npc/aiur": 1,	    	]));        setup();}int clean_up(){      return 0;}
