inherit ITEM;
#include <ansi.h>

void create() {
  set_name(HIW "清风旗" NOR, ({ "qingfeng qi", "qi" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("value", 1000000);
    set("value_c", 376);
    set("unit", "张");
    set("long", "这是一张清风旗卡，你可以找客栈二楼托儿领取清风八卦旗!\n");
    set("no_sell", 1);
    set("only_do_effect", 1);
  }
}

void init() {
  if (environment() == this_player())
    add_action("do_eat", "open");
}

int do_eat(string arg) {

  object me = this_player();
  int qf_time = 30 * 24 * 3600;
  if (arg != "qingfeng qi") return 0;
  write(YEL "你可以找托儿领取清风旗了，死亡或者下线可以重新领取！" NOR "\n");
  me->add("qingfeng", qf_time);
  me->save();
  destruct(this_object());
  return 1;
}

int query_autoload() { return 1; }
