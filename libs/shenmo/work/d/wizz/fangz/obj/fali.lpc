#include <ansi.h>
inherit ITEM;

void setup()
{}

void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name(HIG"龙筋"NOR, ({"long jin", "jin"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
                set("unit", "段");
                set("long", "一段黑不溜秋的龙筋，听说可是大补哦！\n");
		set("value", 0);
	}
	setup();
}

int do_eat(string arg)
{
object me;
int str;
me = this_player();
str=me->query("max_mana");
	if (!id(arg))
	return notify_fail("你要吃什么？\n");

if (str<200000)    {
me->set("max_mana",str+100);
//me->set("maximum_mana",str+100);
}
        message_vision(HIG"$N吃下一颗长圆之物，顿觉蠢蠢欲动 !\n"NOR, this_player());
	destruct(this_object());
	return 1;
}

