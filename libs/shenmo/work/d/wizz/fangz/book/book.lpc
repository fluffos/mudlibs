
#include <ansi.h>
inherit ITEM;
#include "/cmds/std/valid_move.h"

string lvl = "";

string *skills = ({
        "baihua-zhang","jueqingbian","snowsword","moondance",
        "jienan-zhi","lunhui-zhang","lotusmove",
        "dragonfight","fengbo-cha","huntian-hammer","dragonstep",
        "dashen-bian","huntian-jian","kaitian-zhang","wugou-jian","lingyunbu",
