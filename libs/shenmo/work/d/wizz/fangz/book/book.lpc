        "hellfire-whip","jinghun-zhang","kusang-bang","ghost-steps",
        "fumo-zhang","sanqing-jian","wuxing-quan","baguazhen",
        "ice_fire_zhang","spysword","binfen-steps",
        "force","spells","unarmed","dodge","literate","parry",
        "axe","blade","fork","hammer","mace","needle","qin",
        "spear","staff","stick","sword","throwing","whip",
        "kugu-blade","qixiu-jian","yinfeng-zhua","lingfu-steps",
        "ruanhong-zhusuo","jinwu-goufa","wudu-shenzhang","jinshe-steps",
        "bainiao-jian","bingpo-blade","xiaoyaoyou","cuixin-zhang","yingzhaogong",
        "dali-bang","moyun-shou","wuyue-spear","huoyun-qiang","moshenbu",
        "chuanyun-tui","huaxue-blade","yueya-fork","yulong-steps",
        "jiuyin-zhua","qinghu-jian ","yinlei-mace","zizhi-blade","kongming-steps","buddhism",
        "huxiaojian","liushenjue","zileidao","zhaoyangbu","huxiaoquan","tianyaofa",
        "chixin-jian","lanhua-shou","yinsuo-jinling","yueying-wubu",
        "bawang-qiang","changquan","jinglei-mace","sanban-axe","wusi-mace","yanxing-steps",
        "jinding-zhang","tianlei-sword","leiyan-sword","tianji-sword","huifeng-sword","zhutian-bu",
        "bore-zhang","suixing-tui","jingang-zhi","longzhua-gong","zui-gun","damo-jian","shaolin-shenfa",
        "baiyun-sword","lingxiyizhi","mozi-sword","tanzhishentong","piaoxiang","xiaohunqin",
        "canxin-jian","yirubian","hunyuan-zhang","yujianshu","sevensteps",
        "shenji-blade","qingfeng-jian","duo-sword","shadowsteps",
        "baihua-whip","feihua-sword","yihua-jiemu","feihua-steps",
        "doom-sword","feitian-sword","huoxin-sword","kongshoudao","fengyu-piaoxiang",
});

void create()
{
string skill;
int k;

switch(random(10))
        {
        case 0 : k = random(500);lvl="初级入门";break;
        case 1 : k = 500+random(500);lvl="指导入门";break;
        case 2 : k = 1000+random(1000);lvl="进级入门";break;
        case 3 : k = 1500+random(1500);lvl="中级入门";break;
        case 5 : k = 2000+random(2000);lvl="高级入门";break;
        case 7 : k = 2500+random(2500);lvl="进阶入门";break;
        case 8 : k = 3000+random(3000);lvl="大成入门";break;
        case 9 : k = 5000+random(5000);lvl="终极入门";break;
        default : k = 10000+random(10000);lvl="宗师入门";break;
        }
k*= 100;
skill = skills[random(sizeof(skills))];
if ( !is_chinese(to_chinese(skill)) )
       skill = "literate";
set_name(HIC"【"NOR YEL+to_chinese(skill)+NOR HIC"】"NOR,({"book",skill+" book"}));
set("long","一本上古遗下的技能书，读读看。。。。\n");
set("value",0);
set("unit","本");
set("pot",k);
set("skills",skill);
set("no_put",1);
set("no_give",1);
  set("no_get",1);
  set("no_steal",1);
}

string short()
{
return query("name")+"("+query("id")+")"+YEL"  <"NOR+lvl+YEL">"NOR;
}

void init()
{
string skill;
skill=query("skills");
if( !stringp(skill) ) skill = "literate"; 
if ( !query("geted") ) {
     if ( userp(environment()) )  { 
              message("channel:sldh",HIM"【千里眼】某人："HIM+environment()->query("name")+"("+capitalize(environment()->query("id"))+")"+"得到了上古秘籍《"+to_chinese(skill)+HIM"》的"+HIM+lvl+HIM"！\n"NOR,users());
              set("geted",1);
              }
      }
add_action("do_study","study");
add_action("do_study","du");
add_action("do_study","read");
add_action("do_reng","reng");
}

int do_study(string arg)
{
string skill;
object me = this_player();
if ( me!=environment() )
        return 0;
if ( !arg || !id(arg) )
        return 0;
if ( !valid_move(me) )
        {
        write("你现在正忙着呢。\n");
        return 1;
        }
if ( !me->query_skill("literate", 1) )
        {
        write("你是个文盲，先学学读书识字(literate)吧。\n");
        return 1;
        }
skill = query("skills");
if( !stringp(skill) ) skill="literate";
message_vision("$N撕开$n,开始研读里面关于"HIC+to_chinese(skill)+NOR"的技巧，似乎有点心得。\n",me,this_object());
me->improve_skill(skill,query("pot"));
me->start_busy(1);
destruct(this_object());
return 1;
}

int do_reng(string arg){ 
object ob,me;
me=this_player();
if( !this_object()->id(arg) ) return 0;
message_vision("$N对此书中的武功不太感兴趣,随手将书扔了出去。\n", me);
message_vision("但见无数纸片在风中起舞。\n", me);
destruct(this_object());
return 1;
}
