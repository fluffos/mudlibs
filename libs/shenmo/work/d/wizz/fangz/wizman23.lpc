string ask_book()
{
        object ob=this_player();
        string *cs;
        string str;
        int i;
        if( ob->query("c_balance_credit") < 120 )
                return help(ob);
           str = "";
	   for(i=0;i<sizeof(skills);i++)
	{
           write(to_chinese(skills[i])+"("+skills[i]+")\t");
           if( i%7==6 ) write("\n");
	}
        write("\n请选择你需要购买的书类型（比如要选择"HIY+"筋斗云,输入"+HIW+"jindouyun"+NOR+")退去(exit)：\n");
	input_to("get_book",ob);
	return "恭喜你获得梦寐以求的书!\n";
}

private void get_book(string arg, object ob)
{
        mapping cs_status;
        object obj;
        int cnt;

        if( arg=="" ) {
                write("请选择你需要购买的书类型：\n");
                input_to("get_book", ob);
                return;
        }
        if( arg=="exit" ) {
                write("欢迎你下次再来购买。\n");
                return;
        }
        if( member_array(arg,skills) == -1 ) {
                write("请选择你正确的书类型：\n");
                input_to("get_book", ob);
                return;
        }else{
                obj = new("/d/wizz/fangz/book/book");
                obj->set_name(HIC"【"NOR YEL+to_chinese(arg)+NOR HIC"】"NOR,({"book",arg+" book"})); 
                obj->set("skills",arg);
                if( !obj->move(ob) ) {
                        destruct(obj);
                         write("你身上的物品太多了!\n");
                         return;
                }
                message("channel:rumor",HIY+"【黑市交易】"+HIC+msg2[random(sizeof(msg2))]+": "+NOR+HIC+ob->query("name")+"购买了"+obj->query("name")+"!\n"NOR,users());
                ob->add("c_balance_credit",-120);
		ob->save();
                log_file("blackmarket",sprintf("[%s] 名字:%s(%s)购买得%s书。\n",ctime(time()),ob->query("name"),ob->query("id"),obj->query("name")));  
                write("恭喜你获得"+obj->query("name")+"!\n");
                return ;

        }

}
void init() 
{

            add_action("do_sell_list", "list");
            add_action("do_mai", "mai");
}

int do_sell_list(string arg)
{
	mapping goods;
	string list, *name;
	int i;
	string tlist;

	if( !mapp(goods = query("vendor_goods")) ) return 0;
	if( arg && !this_object()->id(arg) ) return 0;
	name = keys(goods);
          list = HIR"㊣"NOR"本店现货销售下列商品: \n"NOR; 
          for(i=0; i<sizeof(name); i++)  {
                tlist = sprintf("%s(%s)", filter_color(goods[name[i]]->query("name")), name[i]);
          list += sprintf("%-30s：%d信用点\n", tlist,goods[name[i]]->query("value_c")); 
             } 
          list += "使用 mai <某物> from <某人> 命令进行购买\n"; 
             write(list);
             return 1;    
}

int do_mai(string arg)
{
        string item, targ;
        object ob, owner;
        int price, afford;
        object me=this_player();
        string* slist;

        if( !arg || sscanf(arg, "%s from %s", item, targ)!=2 )
                return notify_fail("指令格式：mai <某物> from <某人>\n");

        if( !objectp(owner = present(targ, environment(me))) )
                return notify_fail("你要跟谁买东西？\n");
         if(owner!=this_object()) return notify_fail("你要跟谁买东西？\n");
        
         if(owner->complete_trade(me, item)) {
                    return 1;
                } else {
                    return 0;
                }
}



int complete_trade(object me, string what)
{
	string ob_file;
	object ob;
	int price;

	if( stringp(ob_file = query("vendor_goods/" + what)) ) { 
		ob = new(ob_file);
		if(!ob->move(me)) return 0;
		if( ob->query("value_c") > me->query("c_balance_credit") ) {
			destruct(ob);
                        write("你身上的信用点不够买。\n");return 1;}
		me->add("c_balance_credit",-ob->query("value_c"));
		me->save();
		message_vision("$N向$n买下一" + 
			ob->query("unit") + ob->query("name") + "。\n",
			me, this_object() );
                message("channel:rumor",HIY+"【黑市交易】"+HIC+msg2[random(sizeof(msg2))]+": "+NOR+HIC+me->query("name")+"购买了"+ob->query("name")+"!\n"NOR,users());
        log_file("blackmarket",sprintf("[%s] 名字:%s(%s)购买得%s 超级书。\n",ctime(time()),me->query("name"),me->query("id"),ob->query("name")));  

		return 1;
	}
	return notify_fail("没有这样东西卖。\n");
}
string ask_dugu()
{
        object ob=this_player();
        if(ob->query_skill("dugu-jiujian")&&!ob->query("dugu")) {
        ob->set("dugu",1);
        ob->save();
        return "ok!我已经记住你了，转世后继续来向我要！\n";
        }
        if(ob->query_skill("dugu-jiujian")&&ob->query("dugu"))
        return "你已经学会独孤九剑了，还问？!\n";
        if( ob->query("dugu")==1 ) {
        ob->set_skill("dugu-jiujian",100);
        ob->save();
        return "恭喜你获得独孤九剑100级!\n";
        }
        else
        return "你没有资格!\n";
}
string ask_kongwu()
{
        object ob=this_player();
        if(ob->query_skill("kongwujian")&&!ob->query("kongwu")) {
        ob->set("kongwu",1);
        ob->save();
        return "ok!我已经记住你了，转世后继续来向我要！\n";
        }
        if(ob->query_skill("kongwujian")&&ob->query("kongwu"))
        return "你已经学会独孤九剑了，还问？!\n";
        if( ob->query("kongwu")==1 ) {
        ob->set_skill("kongwujian",100);
        ob->save();
        return "恭喜你获得空无剑100级!\n";
        }
        else
        return "你没有资格!\n";
}


