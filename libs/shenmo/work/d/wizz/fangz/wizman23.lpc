	}

}

string help(object ob)
{
	if( ob->query("shen")<1000 )
		tell_object(ob,"你的神数太少，我不能卖给你!\n");
	if( ob->query("c_balance") < 80*JB )
		tell_object(ob,"你的存款太少，我不敢卖给你!\n");
	return "穷光蛋一个，用什么来购买？\n";
}

string ask_skills()
{
        object ob=this_player();
        int i;
        string* dns;
        string* gft;
        mapping gt,sk;
        gt=ob->query_learned();
        sk=ob->query_skills();
        if( !mapp(gt) || !mapp(sk)  ) return "你好像没学过任何技能\n";
        gft = keys(gt);
        dns = keys(sk);
        if( sizeof(gft)<= sizeof(dns) ) return "你的学习技能与学习点不需要修正\n";
        for( i = 0;i < sizeof(gft);i++ )
        {
            if( member_array(gft[i],dns) == -1 )
            {     ob->delete_skill(gft[i]);
             }
           
         }
        ob->save();
        tell_object(ob,"只见大神口念念有词，在你的头顶拍了一下，一股暖流，流过你的全身，你觉得无比的舒服\n");
        return "你的学习技能与学习点相匹配\n";

}

string ask_books()
{
        object ob=this_player();
        object book;
        if( ob->query("shen")<500 || ob->query("c_balance") < 20*JB )
                return help(ob);
        book = new("/d/wizz/fangz/book/book");
        if( !book->move(ob) ) {
             destruct(book);
             return "你身上的物品太多了!\n";
        }
        message("channel:rumor",HIY+"【黑市交易】"+HIC+msg2[random(sizeof(msg2))]+": "+NOR+HIC+ob->query("name")+"购买了"+book->query("name")+"!\n"NOR,users());
        ob->add("shen",-500);
        ob->add("c_balance",-20*JB);
        ob->save();
        log_file("blackmarket",sprintf("[%s] 名字:%s(%s)购买得%s书。\n",ctime(time()),ob->query("name"),ob->query("id"),book->query("name")));  
        return "恭喜你获得"+book->query("name")+"!\n";
}
