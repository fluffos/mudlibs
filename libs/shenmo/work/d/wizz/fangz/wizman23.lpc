string ask_shen()
{
        object ob=this_player();
        if( ob->query("c_balance") < 30*JB ) 
           return "你的钱太少了，等你有钱了再来买吧！\n";
        ob->add("c_balance",-50*JB);
        ob->add("shen",160);
        tell_object(ob,"扣除20%手续费你的神增加160点\n");
        log_file("sell_shen",sprintf("[%s] 名字:%s(%s)购买得200点神。\n",ctime(time()),ob->query("name"),ob->query("id")));  
        message("channel:rumor",HIY+"【黑市交易】"+HIC+"大神(Da shen): "+NOR+HIC+ob->query("name")+"购买了200点神!\n"NOR,users());
        return "你可要继续努力呀\n";
}
string ask_dans()
{
	object ob=this_player();
	int i;
	string* dns;
	string* gft;
	mapping gt;
	gt=ob->query("gift");
        if( !mapp(gt) ) return "你好像没吃过属性丹\n";
	if( ob->query_temp("ask_dans") ) return "问过了,还问?\n";
	gft = keys(gt);
	dns = keys(dans);
	for( i = 0;i < sizeof(gft);i++ )
	{
		if( member_array(gft[i],dns) != -1 )
                    tell_object(ob,"你已经吃过"+HIW+chinese_number(gt[gft[i]])+NOR+"个"+dans[gft[i]][0]+"\n");
		else
                    continue;
		}
	ob->set_temp("ask_dans",2);
	return "你还要继续努力呀\n";

}

int level(mixed ob1, mixed ob2)
{
        if (wiz_level(ob1) != wiz_level(ob2))
                return wiz_level(ob2) - wiz_level(ob1);
        return ob1 < ob2?-1:1;
}

private void get_zhongzu(string arg, object ob)
{
	mapping cs_status;
	object obj;
	int cnt;
	string *cs;
	cs = keys(attribute);
	if( arg=="" ) {
		write("请选择你需要购买的属性丹类型：\n");
		input_to("get_zhongzu", ob);
		return;
	}
	if( arg=="exit" ) {
		write("欢迎你下次再来购买。\n");
		return;
	}
	if( member_array(arg,cs) == -1 ) {
		write("请选择你正确的属性丹类型：\n");
		input_to("get_zhongzu", ob);
		return;
	}else{
		obj = new(DRUGPATH+attribute[arg][0]);
		if( !obj->move(ob) ) {
			destruct(obj);
			 write("你身上的物品太多了!\n");
			 return;
	 	}

                message("channel:rumor",HIY+"【黑市交易】"+HIC+msg2[random(sizeof(msg2))]+": "+NOR+HIC+ob->query("name")+"购买了"+attribute[arg][1]+"属性丹!\n"NOR,users());
	 	ob->add("shen",-1000);
                ob->add("c_balance",-10*JB);
	 	ob->save();
                log_file("blackmarket",sprintf("[%s] 名字:%s(%s)购买得%s丹(%s)。\n",ctime(time()),ob->query("name"),ob->query("id"),attribute[arg][1],arg));  
	 	//message("vision",
	}

}

string ask_lianhua()
{
	object ob=this_player();
	string *cs;
	string str;
int i;
	if( ob->query("shen")<2000 || ob->query("c_balance") < 50*JB )
	return help(ob);
   cs = keys(lianhua);
   str = "";
 for(i=0;i<sizeof(cs);i++)
   {
	   write(lianhua[cs[i]][1]+":"+cs[i]+"\t");
	   if( i%3==2 ) write("\n");
	   str = str + cs[i];
	   str = str + ",";
   }
   str =str + ")退去(exit";

   write("请选择你需要购买的莲花类型（"+str+"）：\n");
   input_to("get_lianhua",ob);
   return "恭喜你获得梦寐以求的莲花丹!\n";

}

