inherit __DIR__ "guai.lpc";
#include "guai.h"

void set_skills(int max_value, int level) {
  int guai_value;
  ::set_skills(max_value, level);

  if (level == 1) guai_value = max_value + max_value / 8;
  else if (level == 2) guai_value = max_value + max_value / 6;
  else guai_value = max_value + max_value / 4;


  set_skill("jiuyin-zhua", guai_value + random(16));
  set_skill("kongming-steps", guai_value + random(16));
  set_skill("sword", guai_value + random(16));
  set_skill("blade", guai_value + random(16));
  set_skill("qinghu-jian", guai_value + random(16));
  set_skill("zizhi-blade", guai_value + random(16));
  set_skill("jiuyin-force", guai_value + random(16));
  set_skill("literate", 180);
  set_skill("youming-spells", guai_value + 20 + random(16));
  map_skill("spells", "youming-spells");
  set("class", "yao");
  map_skill("force", "jiuyin-force");
  map_skill("unarmed", "jiuyin-zhua");
  map_skill("sword", "qinghu-jian");
  map_skill("blade", "zizhi-blade");
  map_skill("parry", "zizhi-blade");
  map_skill("dodge", "kongming-steps");
  set("force_factor", query_skill("force", 1));
  set("mana_factor", 100);
  set("family/family_name", "轩辕古墓");
  /*
       set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
                (: perform_action, "blade","lianhuan" :)

               }) );                       
*/
  carry_object("/d/obj/armor/jinjia.lpc")->wear();
  carry_object("/d/obj/weapon/blade/fengdao.lpc")->wield();
}

void init() {
  add_action("do_none", "touxiang");
  add_action("do_none", "surrender");
}
int do_none() {
  object me = this_object();
  message_vision("想耍赖皮？\n", me);
  return 1;
}
