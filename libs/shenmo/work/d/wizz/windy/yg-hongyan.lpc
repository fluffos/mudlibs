inherit __DIR__ "guai.lpc";
#include "guai.h"

void set_skills(int max_value, int level) {
  int guai_value;
  ::set_skills(max_value, level);

  if (level == 1) guai_value = max_value + max_value / 8;
  else if (level == 2) guai_value = max_value + max_value / 6;
  else guai_value = max_value + max_value / 4;


  set_skill("lanhua-shou", guai_value + random(16));
  set_skill("yueying-wubu", guai_value + random(16));
  set_skill("sword", guai_value + random(16));
  set_skill("chixin-jian", guai_value + random(16));
  set_skill("jiuyin-xinjing", guai_value + random(16));
  set_skill("literate", 180);
  set_skill("pansi-dafa", guai_value + 20 + random(16));
  map_skill("spells", "pansi-dafa");
  set("class", "yao");
  map_skill("force", "jiuyin-xinjing");
  map_skill("unarmed", "lanhua-shou");
  map_skill("sword", "chixin-jian");
  map_skill("parry", "chixin-jian");
  map_skill("dodge", "yueying-wubu");
  set("family/family_name", "盘丝洞");
  set("force_factor", query_skill("force", 1));
  set("mana_factor", 100);
  /*
     set("chat_chance_combat", 70);
        set("chat_msg_combat", ({
                (: perform_action, "sword","hongyan" :)

               }) );                    
*/
  carry_object("/d/obj/armor/jinjia.lpc")->wear();
  carry_object("/d/obj/weapon/sword/qinghong")->wield();
}
void init() {
  add_action("do_none", "touxiang");
  add_action("do_none", "surrender");
}
int do_none() {
  object me = this_object();
  message_vision("想耍赖皮？\n", me);
  return 1;
}
