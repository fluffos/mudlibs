#include <ansi.h>
inherit NPC;
#include "npc.h"

void copy_status(object me, int level);
void set_skills(int max_value, int level);
void set_hp_status(object me, int level);
string ask_xiaoxi();
string ask_shimen();
object owner() { return query("owner"); }

int random_place(object me, string *dirs);

void setname() {
  int i;
  string name, id;
  i = (random(sizeof(names) / 2)) * 2;
  name = names[i];
  id = names[i + 1];
  set_name(name, ({ id, "mi tan", "danei mitan", "mitan" }));
}

void create() {
  setname();
  set("age", 34 + random(30));
  set("gender", "男性");
  set("attitude", "heroism");
  set("title", HBBLU "大内密探" NOR);
  set("per", 40);
  set("str", 100);
  set("cor", 40);
  set("con", 30);
  set("int", 40);
  set("spi", 100);
  set("cps", 40);
  set("kar", 40);
  set("max_gin", 1000);
  set("food", 10000);
  set("water", 10000);
  set("no_steal", 1);
  set("taskguai", 1);
  set("no_get", 1);
  /*
set("chat_chance", 5);
set("chat_msg", ({
        (: random_move :)
        }) );
*/
  set("inquiry", ([
    "消息": (: ask_xiaoxi :),
    "师门": (: ask_shimen :),
  ]));
  setup();
}

string ask_xiaoxi() {
  object obj;
  if (objectp(obj = query("owner")))
    return ("听说一个叫" + obj->query("name") + "(" + obj->query("id") + ")要来找我的麻烦,就是你么?\n");
  else return ("我不知道");
}

string ask_shimen() {
  return ("我" + query("family/family_name") + "最强！\n");
}

int random_place(object me, string *dirs) {
  int i, j, k;
  object newob;
  mixed *file, exit;

  if (!sizeof(dirs)) return 0;
  i = random(sizeof(dirs));    // pick up one directory
  file = get_dir(dirs[i] + "/*.lpc", -1);
  if (!sizeof(file)) return 0;
  for (k = 0; k < 30; k++) {
    j = random(sizeof(file));
    if (file[j][1] > 0) {
      newob = load_object(dirs[i] + "/" + file[j][0]);
      if (newob) {
        if (newob->query("no_fight")
          || newob->query("no_magic")
          || newob->query("no_mieyao")
          || !(exit = newob->query("exits"))
          || sizeof(exit) < 1
          || !newob->query("outdoors"))
          continue;
        if (me->move(newob)) {
          message_vision("$N走了过来。\n", me);
          return 1;
        }
      }
    }
  }
  return 0;
}

string invocation(object me, int level) {
  object guai, env;
  string *dirs, where;

  dirs = dirs1;
  guai = this_object();
  copy_status(me, level);

  set("owner", me);
  set("kind", me->query("rulaitask/kind"));

  if (!random_place(guai, dirs)) return "没妖怪。";

  env = environment(guai);
  where = guai->query("name");
  if (env)
    where += "在" + "/d/wizz/windy/miscd"->find_place(env);
  return where;
}

void copy_status(object me, int level) {
  mapping me_skill;
  int *skill_value, max_value, i;

  me_skill = me->query_skills();
  i = sizeof(me_skill);
  if (i > 0) {
    skill_value = values(me_skill);
    max_value = skill_value[0];
    while (i--) {  // 找出玩家skill最大值
      if (skill_value[i] > max_value)
        max_value = skill_value[i];
    }
  } else max_value = 1;

  set_skills(max_value, level);
  set_hp_status(me, level);
  add_temp("apply/armor", me->query("apply/armor") / 2);
  add_temp("apply/damage", me->query("apply/damage") / 2);
}

void set_skills(int max_value, int level) {
  object guai = this_object();
  int guai_value;

  if (level == 1) guai_value = max_value + max_value / 4;
  else if (level == 2) guai_value = max_value + max_value / 2;
  else guai_value = max_value + max_value / 1;

  set_skill("unarmed", guai_value + random(200));
  set_skill("dodge", guai_value + random(200));
  set_skill("parry", guai_value + random(200));
  set_skill("force", guai_value + random(200));
  set_skill("spells", guai_value + 20 + random(200));
}


void set_hp_status(object me, int level) {
  int max_kee, max_sen, deng_ji, zhuan, maximum_force, skill_force, maximum_mana, exp, daoxing;

  max_kee = me->query("max_kee");
  if (me->query_temp("yi") > 0)
    max_sen = me->query_temp("max_sen");
  else
    max_sen = me->query("max_sen");
  deng_ji = me->query("level");
  zhuan = me->query("zhuanshi");
  skill_force = query_skill("force", 1);
  maximum_mana = me->query("max_mana");
  maximum_force = me->query("max_force");
  exp = me->query("combat_exp");
  daoxing = me->query("daoxing");

  set("max_force", skill_force * 20);
  set("任务", 1);
  set("max_mana", skill_force * 20);
  set("force", maximum_force);
  set("force_factor", skill_force * 3 / 4);
  set("mana_factor", 0);

  if (level == 1) {
    set("max_kee", max_kee * 10);
    set("eff_kee", max_kee * 10);
    set("level", deng_ji - 50 + random(100));
    set("zhuanshi", 0);
    set("max_sen", max_sen * 10);
    set("eff_sen", max_sen * 10);
    set("kee", max_kee * 4);
    set("sen", max_sen * 4);
    set("max_mana", maximum_mana * 3 / 2);
    set("mana", maximum_mana * 3);
    set("max_force", maximum_force * 3 / 2);
    set("force", maximum_force * 3);
    set("combat_exp", exp + exp / 4 + random(exp / 3));
    set("daoxing", daoxing + daoxing * 1 + random(daoxing * 1));
    set_temp("apply/armor", 350);
    set_temp("apply/damage", 120);
  } else if (level == 2) {
    set("max_kee", max_kee * 15);
    set("eff_kee", max_kee * 15);
    set("level", deng_ji - 50 + random(150));
    set("zhuanshi", random(1 + zhuan));
    set("max_sen", max_sen * 15);
    set("eff_sen", max_sen * 15);
    set("kee", max_kee * 5);
    set("sen", max_sen * 5);
    set("max_mana", maximum_mana * 2);
    set("mana", maximum_mana * 4);
    set("max_force", maximum_force * 2);
    set("force", maximum_force * 4);
    set("combat_exp", exp + exp / 3 + random(exp / 2));
    set("daoxing", daoxing + daoxing / 2 + random(daoxing / 2));
    set_temp("apply/armor", 500);
    set_temp("apply/damage", 240);
  } else {
    set("max_kee", max_kee * 20);
    set("eff_kee", max_kee * 20);
    set("level", deng_ji - 50 + random(200));
    set("zhuanshi", zhuan);
    set("max_sen", max_sen * 20);
    set("eff_sen", max_sen * 20);
    set("kee", max_kee * 6);
    set("sen", max_sen * 6);
    set("max_mana", maximum_mana * 5 / 2);
    set("mana", maximum_mana * 5);
    set("max_force", maximum_force * 5 / 2);
    set("force", maximum_force * 5);
    set("combat_exp", exp + exp / 2 + random(exp));
    set("daoxing", daoxing + daoxing * 1 + random(daoxing * 1));
    set_temp("apply/armor", 650);
    set_temp("apply/damage", 360);
  }
}

int accept_fight(object ob) {
  object me = this_object();
  if (ob != owner()) {
    message_vision(CYN "$N说道：快走开，要不我吃了你。\n" NOR, me);
    return 0;
  } else if (query("kind") != "降") {
    command("say 我不找你，你倒送上门来了，我就成全了你。");
    me->kill_ob(ob);
    return 1;
  } else {
    if (query("eff_kee") < query("max_kee")
      || query("eff_sen") < query("max_sen")) {
      message_vision(CYN "$N说道：我受伤了，这样打不公平吧。\n" NOR, me);
      return 0;
    }
    command("say 废话少说，尽管放马过来，看谁怕谁。");
    remove_call_out("check_result");
    call_out("check_result", 1, me, ob);
    return 1;
  }
}

void init() {
  ::init();
  add_action("do_persuade", "persuade");
}

void heart_beat() {
  string skill, exert;
  object weapon;
  object guai = this_object();
  object me = guai->query("owner");
  if (!environment())
    return;

  ::heart_beat();

  if (!me || me->query("rulaitask/fail")
    || me->query("rulaitask/guai") != this_object()) {
    //        if ( me )       
    //                CHANNEL_D->do_channel(this_object(),"chat",me->name(1)+"真是菜鸟，老子这就去也。");  
    destruct(guai);
    return;
  }
  if (!is_fighting() && random(20) != 0) {
    if (query("eff_kee") < query("max_kee") && random(5) == 1)
      SDS_D->addEffKee(guai);
    if (query("eff_sen") < query("max_sen") && random(5) == 1)
      SDS_D->addEffSen(guai);
  }
  if (query("kee") < query("eff_kee") - 10)
    SDS_D->addKee(guai);
  if (query("sen") < query("eff_sen") - 10)
    SDS_D->addSen(guai);

  if (query_temp("block_msg/all")) return;
  weapon = query_temp("weapon");
  if (objectp(weapon))
    skill = weapon->query("skill_type");
  else skill = "unarmed";
  switch (random(4)) {
    case 1: SDS_D->randomPfm(this_object(), skill); break;
    case 2: SDS_D->randomExert(this_object()); break;
    //方便新手,初级难度killer不增加cast攻击
    //windy
    default: break;
  }
}

int check_result(object me, object ob) {
  int guai_max_kee, ob_max_kee;

  guai_max_kee = me->query("max_kee");
  ob_max_kee = ob->query("max_kee");

  if (me->is_fighting()) {
    remove_call_out("check_result");
    call_out("check_result", 1, me, ob);
    return 1;
  }
  if (!living(me)
    || me->query("kee") < 1
    || me->query("sen") < 1)
    return 1;
  if ((me->query("kee") * 100 / guai_max_kee) <= 50) {
    if (!living(me)
      || me->query("kee") < 1
      || me->query("sen") < 1)
      return 1;
    if (random(3) < 1)
      command("say 我还没准备好，你就开打了，不算数。");
    else {
      if (ob->query_temp("rulaitask/fight_time")) {
        command("say 我现在方知天外有天，人外有人，我还要回山多多修炼，告辞了。");
        ob->set("rulaitask/accomplish", 1);
        ob->set("rulaitask/end_time", time());
        ob->delete_temp("rulaitask/fight_time");
        ob->delete("rulaitask/get");
        ob->set("rulaitask/done", 1);
        destruct(me);
        return 1;
      } else {
        command("say 我一时大意，也没尽全力，我不服，再比一次。");
        ob->set_temp("rulaitask/fight_time", 1);
        return 1;
      }
    }
  } else {
    command("say 哈哈，你输了，我天下无敌。");
    return 1;
  }
}

int do_persuade(string arg) {
  object ob, me = this_player();
  int guai_max_kee, guai_eff_kee;

  if (!arg)
    return 0;
  ob = present(arg, environment(me));
  if (!ob)
    return notify_fail("你要劝谁？\n");
  if (me->query("rulaitask/kind") != "劝"
    || ob->query("kind") != "劝")
    return 0;
  if (me->is_busy())
    return notify_fail("你正忙着呢。\n");
  me->command("say 放下屠刀，立地成佛。");
  if (!living(ob))
    return notify_fail("很显然，" + ob->name() + "听不见你说的话。\n");
  if (me != ob->query("owner") || !ob->is_fighting(me)) {
    message_vision(CYN "$N说道：你罗嗦些什么，快滚开。\n" NOR, ob);
    return 1;
  }
  guai_max_kee = ob->query("max_kee");
  guai_eff_kee = ob->query("eff_kee");

  if (guai_eff_kee * 100 / guai_max_kee < 15) {
    command("say 你说的有道理，我这就回山去。");
    me->set("rulaitask/accomplish", 1);
    me->set("rulaitask/end_time", time());
    me->delete("rulaitask/get");
    me->set("rulaitask/done", 1);
    destruct(ob);
    return 1;
  } else if (guai_eff_kee * 100 / guai_max_kee < 20) {
    command("say 你看我现在，不比做佛快乐吗。");
    me->start_busy(1 + random(3));
    return 1;
  } else {
    me->start_busy(3);
    return notify_fail(ob->name() + "正专心致志战斗，懒得理你。\n");
  }
}


void die() {
  object ob = this_object();
  object me = ob->query("owner");
  if (me->query("rulaitask/guai") == ob
    && me->query("rulaitask/kind") == "杀"
    && query("kind") == "杀"
    && (ob->query_temp("last_opponent") == me || ob->query_temp("my_killer") == me)) {
    me->set("rulaitask/accomplish", 1);
    me->set("rulaitask/end_time", time());
    me->delete("rulaitask/get");
    me->set("rulaitask/done", 1);
    me->add_temp("killer_number", 1);
    tell_object(me, "耶！你真棒。\n");
  } else {
    me->delete("rulaitask/get");
    me->set("rulaitask/fail", 1);
    tell_object(me, "哼！你耍赖皮！\n");
  }
  tell_object(me, "\n" + query("name") + "死了。\n");
  remove_all_killer();
  remove_all_enemy();
  move(VOID_OB);
  destruct(this_object());
}

int accept_object(object who, object ob) {
  object guai;
  guai = this_object();

  if (ob->name() != "金创药" || ob->query("id") != "jinchuang yao") {
    message_vision(CYN "$N说道：这是什么玩意儿，想毒死我啊。\n" NOR, guai);
    return 0;
  } else {
    guai->receive_curing("kee", 100);
    guai->receive_curing("sen", 100);
    command("exert recover");
    if (query("eff_kee") == query("max_kee"))
      message_vision(CYN "$N说道：我好了，来来来，咱们再大战三百回合。\n" NOR, guai);
    return 1;
  }
}

void kill_ob(object ob) {
  object me = this_object();
  if (me->query("level") > 1)
    me->set_leader(ob);
  ::kill_ob(ob);
}

string short() {
  object me;
  string str = ::short();
  me = owner();
  if (!me)
    return str;
  str += sprintf(" (%c%c)", me->name(1)[0], me->name(1)[1]);
  return str;
}
