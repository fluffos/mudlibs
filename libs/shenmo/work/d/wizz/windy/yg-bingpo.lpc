inherit __DIR__"guai.lpc";
#include "guai.h"

void set_skills(int max_value, int level)
{
        int guai_value;
        ::set_skills(max_value, level);
        
        if (level==1) guai_value = max_value+max_value/8;
        else if (level==2) guai_value = max_value+max_value/6;
        else guai_value = max_value+max_value/4;

        
        set_skill("cuixin-zhang", guai_value+random(16));
        set_skill("yingzhaogong", guai_value+random(16));
        set_skill("xiaoyaoyou", guai_value+random(16));
        set_skill("blade", guai_value+random(16));
        set_skill("bingpo-blade", guai_value+random(16));
        set_skill("ningxie-force", guai_value+random(16));
        set_skill("literate", 180);
        set_skill("throwing", guai_value+random(16));
        set_skill("dengxian-dafa", guai_value+20+random(16));
          set("class","yao");
        map_skill("spells", "dengxian-dafa");
        map_skill("force", "ningxie-force");
        map_skill("unarmed", "cuixin-zhang");
        map_skill("blade", "bingpo-blade");
        map_skill("parry", "yingzhaogong");
        map_skill("dodge", "xiaoyaoyou");
        set("force_factor", query_skill("force", 1));
        set("mana_factor", 100);
set("family/family_name","大雪山");
/*
     set("chat_chance_combat", 70);
        set("chat_msg_combat", ({
                (: perform_action, "blade","qianshechudong" :)

               }) );                    
*/
        carry_object("/d/obj/armor/jinjia.lpc")->wear();
        carry_object("/d/obj/weapon/blade/iceblade")->wield();
}
void init()
{
        add_action("do_none","touxiang");
        add_action("do_none","surrender");
       }
int do_none()
{
        object me = this_object();
        message_vision("想耍赖皮？\n",me);
        return 1;
} 

