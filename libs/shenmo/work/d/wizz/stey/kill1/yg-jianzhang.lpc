inherit __DIR__ "killer1.lpc";


void set_skills(int max_value, int level) {
  int guai_value;
  ::set_skills(max_value, level);

  if (level == 1) guai_value = max_value + max_value / 8;
  else if (level == 2) guai_value = max_value + max_value / 6;
  else guai_value = max_value + max_value / 4;

  set_skill("chuanyun-tui", guai_value + random(16));
  set_skill("yulong-steps", guai_value + random(16));
  set_skill("fork", guai_value + random(16));
  set_skill("yueya-fork", guai_value + random(16));
  set_skill("zhuanlong-force", guai_value + random(16));
  set_skill("literate", 180);
  set_skill("bihai-spells", guai_value + 20 + random(16));
  map_skill("spells", "bihai-spells");
  map_skill("force", "zhuanlong-force");
  map_skill("unarmed", "chuanyun-tui");
  map_skill("parry", "yueya-fork");
  map_skill("fork", "yueya-fork");
  map_skill("dodge", "yulong-steps");
  set("family/family_name", "乱石山碧波潭");
  set("class", "yao");
  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    (: perform_action, "fork", "feicha" :),
    (: perform_action, "unarmed", "yunyu" :)
  }));

  carry_object("/d/obj/armor/jinjia.lpc")->wear();
  carry_object("/d/obj/stey/shenfork.lpc")->wield();
}
