inherit __DIR__"killer1";


void set_skills(int max_value, int level)
{
        int guai_value;
        ::set_skills(max_value, level);
        
        if (level==1) guai_value = max_value+max_value/8;
        else if (level==2) guai_value = max_value+max_value/6;
        else guai_value = max_value+max_value/4;
        
        set_skill("yinfeng-zhua", guai_value+random(16));
        set_skill("lingfu-steps", guai_value+random(16));
        set_skill("sword", guai_value+random(16));
        set_skill("qixiu-jian", guai_value+random(16));
        set_skill("huntian-qigong", guai_value+random(16));
        set_skill("literate", 180);
        set_skill("blade", guai_value+20+random(16));
        set_skill("kugu-blade", guai_value+20+random(16));
        map_skill("blade", "kugu-blade");
        map_skill("parry", "kugu-blade");
        set_skill("yaofa", guai_value+20+random(16));
        map_skill("spells", "yaofa");
        map_skill("force", "huntian-qigong");
       set_temp("zxzx",1);
        map_skill("unarmed", "yinfeng-zhua");
        map_skill("sword", "qixiu-jian");
        map_skill("dodge", "lingfu-steps");
        set("family/family_name","陷空山无底洞"); 
        set("class","yao"); 
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
//                (: perform_action, "blade","pozhan" :),
                (: perform_action, "blade","shendao" :),
                (: perform_action, "unarmed","duzun" :),
                (: perform_action, "unarmed","duo" :)
               }) );
                        
        carry_object("/d/obj/armor/jinjia.lpc")->wear();
        carry_object("/d/obj/stey/guiblade.lpc")->wield();
}

