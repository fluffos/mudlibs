inherit __DIR__ "guai.lpc";

void set_skills(int max_value, int level) {
  int guai_value;
  ::set_skills(max_value, level);

  if (level == 1) guai_value = max_value + max_value / 8;
  else if (level == 2) guai_value = max_value + max_value / 6;
  else guai_value = max_value + max_value / 4;


  set_skill("kaitian-zhang", guai_value + random(16));
  set_skill("lingyunbu", guai_value + random(16));
  set_skill("whip", guai_value + random(16));
  set_skill("dashen-bian", guai_value + random(16));
  set_skill("xuanzong-force", guai_value + random(16));
  set_skill("literate", 180);
  set_skill("yuxu-spells", guai_value + 20 + random(16));
  map_skill("spells", "yuxu-spells");
  map_skill("force", "xuanzong-force");
  map_skill("unarmed", "kaitian-zhang");
  map_skill("whip", "dashen-bian");
  map_skill("parry", "dashen-bian");
  map_skill("dodge", "lingyunbu");
  set("force_factor", query_skill("force") / 2);
  set("mana_factor", query_skill("spells", 1));
  set("family/family_name", "昆仑山玉虚洞");
  set("chat_chance_combat", 70);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed", "po" :)

  }));
  carry_object("/d/obj/armor/jinjia.lpc")->wear();
  //  carry_object("d/obj/weapon/hand/hand2.lpc")->wield();
}

void init() {
  add_action("do_none", "touxiang");
  add_action("do_none", "surrender");
}
int do_none() {
  object me = this_object();
  message_vision("想耍赖皮？\n", me);
  return 1;
}
