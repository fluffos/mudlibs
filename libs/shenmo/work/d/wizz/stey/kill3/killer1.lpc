string invocation(object me, int level) {
  object guai, env;
  guai = this_object();
  copy_status(me, level);
  set_name(query("name"), ({ me->query("id") + " lao guai", "laoguai", "guai" }));
  set("owner", me);
  set("target", me->query("baohu/guai"));
  //        set("kind",me->query("baohu/kind"));
  //      call_out("follow",10);


}

void copy_status(object me, int level) {
  mapping me_skill;
  int *skill_value, max_value, i;

  me_skill = me->query_skills();
  i = sizeof(me_skill);
  if (i > 0) {
    skill_value = values(me_skill);
    max_value = skill_value[0];
    while (i--) {  // 找出玩家skill最大值
      if (skill_value[i] > max_value)
        max_value = skill_value[i];
    }
  } else max_value = 1;
  set("npcstart", time() + 900 + random(900));
  set_skills(max_value, level);
  add_temp("apply/damage", me->query_temp("apply/damage") + 20);
  add_temp("apply/armor", me->query_temp("apply/armor") + 50);
  set_hp_status(me, level);
  set("level", me->query("level") - 80 + random(200));
  set("zhuanshi", random(me->query("zhuanshi") + 1));
  setup();

}

void set_skills(int max_value, int level) {
  object guai = this_object();
  int guai_value;

  if (level == 1) guai_value = max_value + max_value / 8;
  else if (level == 2) guai_value = max_value + max_value / 6;
  else guai_value = max_value + max_value / 4;

  set_skill("unarmed", guai_value + random(16));
  set_skill("dodge", guai_value + random(16));
  set_skill("parry", guai_value + random(16));
  set_skill("force", guai_value + random(16));
  set_skill("spells", guai_value + 20 + random(16));
}


void set_hp_status(object me, int level) {
  int max_kee, max_sen, skill_force, maximum_mana, exp, daoxing;
  skill_force = query_skill("force");
  max_kee = me->query("max_kee");
  if (me->query("max_kee") < skill_force * 10 / 2)
    max_kee = skill_force * 10 / 2;
  max_sen = me->query("max_sen");
  if (max_sen * 5 < max_kee * 4)
    max_sen = max_kee + 100 - random(100);
  maximum_mana = me->query("maximum_mana");
  exp = me->query("combat_exp");
  daoxing = me->query("daoxing");

  set("max_force", skill_force * 10);
  set("force", skill_force * 15);
  set("force_factor", skill_force / 2);
  set("mana_factor", query_skill("spells", 1));

  if (exp < 600000000) {
    set("max_kee", max_kee * 10 / 3);
    set("eff_kee", max_kee * 10 / 3);
    set("max_sen", max_sen * 10 / 3);
    set("eff_sen", max_sen * 10 / 3);
    set("kee", max_kee * 10 / 3);
    set("sen", max_sen * 10 / 3);
    set("max_mana", maximum_mana * 3 / 2);
    set("mana", maximum_mana * 3 / 2);
    set("combat_exp", exp);
    set("daoxing", daoxing);
    add_temp("apply/armor", 600);
    add_temp("apply/damage", 200);
  }

  else if (exp < 700000000) {
    set("max_kee", max_kee * 4);
    set("eff_kee", max_kee * 4);
    set("max_sen", max_sen * 4);
    set("eff_sen", max_sen * 4);
    set("kee", max_kee * 4);
    set("sen", max_sen * 4);
    set("max_mana", maximum_mana * 3 / 2);
    set("mana", maximum_mana * 2);
    set("combat_exp", exp);
    set("daoxing", daoxing);
    add_temp("apply/armor", 700);
    add_temp("apply/damage", 250);
  }

  else if (exp < 800000000) {
    set("max_kee", max_kee * 9 / 2);
    set("eff_kee", max_kee * 9 / 2);
    set("max_sen", max_sen * 9 / 2);
    set("eff_sen", max_sen * 9 / 2);
    set("kee", max_kee * 9 / 2);
    set("sen", max_sen * 9 / 2);
    set("max_mana", maximum_mana * 3 / 2);
    set("mana", maximum_mana * 5 / 2);
    set("combat_exp", exp);
    set("daoxing", daoxing);
    add_temp("apply/armor", 800);
    add_temp("apply/damage", 300);
  } else {
    set("max_kee", max_kee * 5);
    set("eff_kee", max_kee * 5);
    set("max_sen", max_sen * 5);
    set("eff_sen", max_sen * 5);
    set("kee", max_kee * 5);
    set("sen", max_sen * 5);
    set("max_mana", maximum_mana * 3 / 2);
    set("mana", maximum_mana * 3);
    set("combat_exp", exp);
    set("daoxing", daoxing);
    add_temp("apply/armor", 1000);
    add_temp("apply/damage", 400);
  }
}
void init() {
  object me = this_object();
  object who = this_player();
  int type;
  int t = query("npcstart");
  ::init();
  //  add_action("do_no", "fight");
  //  add_action("do_no", "kill");
  add_action("do_no", "steal");
  add_action("do_no", "cast");
  add_action("do_no", "ji");
  add_action("do_no", "throw");
  if (t && time() > (t + 300)) {
    remove_call_out("leave");
    call_out("leave", 1);
    return;
  }

  /*
    if(t && time()>t) {
        remove_call_out("_leave");
        call_out("_leave",300);
    }
*/
  if (!living(this_object())) return;
  if (!living(who)) return;
  //  call_out("follow",150);   
}
int do_no(string arg) {
  object who = this_player();
  object me = this_object();
  if (!userp(who)) return 1;
  if (who != owner()) {
    message_vision(CYN "$N说道：你不想死就滚！。\n" NOR, me);
    random_move();  //走开
    return 1;
  }


  me->kill_ob(who);
  return 0;
}


int heart_beat() {
  object guai = this_object();
  object who = owner();

  ::heart_beat();
  if (!guai || !environment(guai)) return 0;
  /*
if ( !objectp(query("target")) )
       {
       _leave();
       return;
       }
*/
  if (!owner() || owner()->query("baohu/fail")) {
    destruct(guai);
    return 0;
  }
  if (who->query("level") > 280 && random(5) == 1) {
    if (query("kee") < query("eff_kee") - 10)
      SDS_D->addKee(guai);
    if (query("eff_kee") < query("max_kee") - 10)
      SDS_D->addEffKee(guai);
    if (query("sen") < query("eff_sen") - 10)
      SDS_D->addSen(guai);
    if (query("eff_sen") < query("max_sen") - 10)
      SDS_D->addEffSen(guai);
  }
  if (living(who) && is_fighting(who)) {
    if (who->query("env/invisibility")) {
      who->delete_temp("yinshentime");
      who->set("env/invisibility", 0);
      who->delete_temp("no_heal_up/yinshen");
      message_vision(HIW "\n$N吹了口气,$n又现出了身形。\n" NOR, guai, who);
    }
  }
}

void unconcious() {
  die();
}

void die() {
  object me = owner();
  if (me) {
    me->add("baohu_killer", 1);
    if ((int)me->query("baohu_killer") >= 3) {
      me->set("baohu/done", 1);
      me->delete("baohu/get");
      me->delete("baohu_killer");
    }
    if (!me) message_vision(CYN "\n$N喊:  兄弟，我门完了......\n" NOR, this_object());
    else tell_object(me, CYN "\n" + query("name") + "喊:  兄弟，我门完了......\n" NOR);
  }
  load_object("/obj/empty");
  this_object()->move("/obj/empty");
  destruct(this_object());
}



void destruct_ob(object ob) {
  destruct(ob);
}

void kill_ob(object ob) {
  object me = this_object();
  if (userp(ob) && ob != owner()) {
    message_vision(CYN "$N说道：你不想死就滚！。\n" NOR, me);
    random_move();  //走开
    return;
  }
  if (me->query("level") > 1)
    me->set_leader(ob);
  ::kill_ob(ob);
}
