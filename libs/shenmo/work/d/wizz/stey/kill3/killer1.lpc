//add by snowtu 
object carry_object(string file) {
  object ob = ::carry_object(file);
  if (ob) { ob->set("no_drop", 0); ob->set("value", 0); return ob; }
  return 0;
}


void setname() {
  object ob = this_player();
  int i;
  string name;
  i = random(sizeof(names));
  name = names[i] + (random(2) ? "老精" : "老怪");

  set_name(name, ({ "lao guai", "laoguai", "guai" }));

}

void setup() {
  float fwx, flvl;
  int wx, lvl;
  ::setup();
  wx = this_object()->query("combat_exp");
  fwx = to_float(wx);
  if (wx > 10000000)
    flvl = sqrt(fwx / 400) + 10;
  else flvl = sqrt(fwx / 1000) + 10;
  lvl = to_int(flvl);
  if (this_object()->query("level") < lvl)
    this_object()->set("level", lvl);
}
