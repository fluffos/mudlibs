inherit __DIR__"guai.lpc";


void set_skills(int max_value, int level)
{
        int guai_value;
        ::set_skills(max_value, level);
        
        if (level==1) guai_value = max_value+max_value/8;
        else if (level==2) guai_value = max_value+max_value/6;
        else guai_value = max_value+max_value/4;
        
        set_skill("jinghun-zhang", guai_value+random(16));
        set_skill("ghost-steps", guai_value+random(16));
        set_skill("whip", guai_value+random(16));
        set_skill("hellfire-whip", guai_value+random(16));
        set_skill("tonsillit", guai_value+random(16));
        set_skill("literate", 180);
        set_skill("gouhunshu", guai_value+20+random(16));
        map_skill("spells", "gouhunshu");
        map_skill("force", "tonsillit");
        map_skill("unarmed", "jinghun-zhang");
        map_skill("whip", "hellfire-whip");
        map_skill("parry", "hellfire-whip");
        map_skill("dodge", "ghost-steps");
        set("force_factor", query_skill("force")/2);
        set("mana_factor", query_skill("spells",1));
    set("family/family_name","阎罗地府");
       set("chat_chance_combat", 70);
        set("chat_msg_combat", ({
               (: perform_action, "unarmed","duo" :)

               }) );                       
        carry_object("/d/obj/armor/jinjia.lpc")->wear();
      //  carry_object("/d/obj/weapon/whip/longsuo.lpc")->wield();
}

