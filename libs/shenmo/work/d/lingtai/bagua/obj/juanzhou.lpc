// forcebook2, level 100-140
#include <ansi.h>

inherit ITEM;
void init();

void create() {
  set_name(HIG "〖丝帛卷轴〗" NOR, ({ "sibo juanzhou", "juanzhou", "juan", "zhou" }));
  set_weight(1000);
  set("no_sell", 1);
  set("no_put", 1);
  set("no_give", 1);
  set("no_steal", 1);
  set("no_get", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "卷");
    set("long", HIM "一卷用丝帛织就的卷轴，你展开一看，上面竟然绘着许多赤身露体的美貌女子。\n" NOR);
    set("material", "cloth");
    set("value", 0);
  }
}

void init() {
  add_action("do_read", "read");
  if ((int)this_object()->query("created") != 1) {
    this_object()->set("created", 1);
    remove_call_out("destroy_book");
    call_out("destroy_book", 15000);  //5 hours
  }
}

void destroy_book() {
  message_vision(
    HIC "天上突然伸出一只大手，一下子就把" + (string)this_object()->query("name") + HIC "给拿跑了！\n" NOR,
    environment(this_object())
  );
  destruct(this_object());
}
int do_read(string arg) {
  object me = this_player(), book = this_object();
  int sen_cost, gain, forcelev, exp;

  if (!book->id(arg)) return notify_fail("你要读什么？\n");
  if (environment(book) != me) return notify_fail("书要拿起来读。\n");
  if (me->is_busy()) return notify_fail("你现在忙着呢，还是等静下心来再读书吧！\n");
  if (me->is_fighting()) return notify_fail("临阵磨枪可来不及啦！\n");
  if (me->query("lbwb_agree") != 1) {
    if (me->query("gender") == "女性")
      return notify_fail(HIM "你一看到卷轴上的赤裸女子，不禁满脸飞红，那还有心思去认真思索！\n" NOR);
    else
      return notify_fail(HIR "你一看到卷轴上的赤裸女子，不禁小腹燥热难当，开始想入非非，那还有心思去认真思索！\n" NOR);
  }
  if ((int)me->query_skill("lingbo-weibu", 1) > 99)
    return notify_fail("你在这方面已经很有造诣，这本书不会让你长进多少。\n");
  exp = (int)me->query("combat_exp");
  forcelev = (int)me->query_skill("lingbo-weibu", 1);
  if (exp / 10000 < forcelev * forcelev * forcelev / 100000)
    return notify_fail("你的武学经验不够，再怎么读也没用。\n");
  sen_cost = 20 + (40 - (int)me->query_int()) + (35 - (int)me->query_kar());
  if (sen_cost <= 50) sen_cost = 50;
  if ((int)me->query("sen") < sen_cost)
    return notify_fail("你现在头晕脑胀，该休息休息了。\n");
  me->receive_damage("sen", sen_cost);

  gain = (int)me->query_skill("literate", 1) / 10;
  gain -= random((int)me->query_int());
  gain += random(me->query_kar());
  if (gain <= 0) gain = 1;
  me->improve_skill("lingbo-weibu", gain);

  message_vision("$N正专心地研读" + book->query("name") + "。\n", me);
  tell_object(me, "你仔细观察着卷轴上那些女子的动作姿势，竟然与八卦方位暗合。你忍不住模仿着图案来回走动！\n");

  return 1;
}
