//box.c

#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIW "长条石盒" NOR, ({ "stone box", "box" }));
  set_weight(1000);
  set_max_encumbrance(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", HIY "一个长条形状的石盒子，上面落了厚厚的一层灰尘。\n" NOR);
    set("no_get", 1);
    set("value", 1000);
    set("opened", 0);
  }
}

int is_container() { return 1; }

void init() {
  add_action("do_open", "open");
}

int do_open(string arg) {
  object me = this_player();
  object ob = this_object();
  object book = new("/d/lingtai/bagua/obj/juanzhou");
  object *inv;
  inv = all_inventory(me);

  if (!arg || !id(arg))
    return notify_fail("What?\n");

  if ((int)me->query_temp("lbwb_open"))
    return notify_fail("盒子已经打开了......\n");

  if (me->query("lbwb_try") > 2)
    return notify_fail("你费了半天劲就是打不开。\n");

  if (me->query("level") < 300)
    return notify_fail("你等级太低，打不开石盒。\n");
  if (sizeof(inv) >= 25)
    return notify_fail("你身上的东西太多了！\n");

  me->set_temp("lbwb_open", 1);
  message_vision(HIW "$N小心翼翼的打开了$n" HIW "。\n" NOR, me, ob);
  me->add("lbwb_try", 1);
  if (random(99) < 9) {
    me->set("lbwb_agree", 1);
    book->move(me);
    message_vision(HIW "$N竟然从从盒子里发现了一个卷轴!\n" NOR, me, ob);
    message(
      "channel:rumor",
      HIM + "\n【" + HIW " 空穴来风 " NOR + HIM "】某人：听说" + me->query("name") + "从逍遥密洞发现了一个" + HIG "丝帛卷轴" NOR + HIM "！\n\n" + NOR,
      users()
    );
  }
  return 1;
}
