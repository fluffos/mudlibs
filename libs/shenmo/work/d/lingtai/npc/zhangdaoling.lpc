//puti.c
#include <ansi.h>
inherit NPC;
//inherit F_MASTER;
//int recognize_apprentice(object ob);
void consider();

void reset()                                         
{                                               
if ( query("asked") )                           
	delete("asked");              
return;   
}

string askZhang()                                    
{
object me = this_player();                           
say(CYN+name()+CYN"说道:他是我的徒弟，现在隐居了...\n"NOR);
if ( me->query("combat_exp")<10000000 )               
return "以你这点修为，找到他很难。";            
else if ( me->query("daoxing")<5000000 )             
	return "以你这点道行是很难找到他的";            
else if ( query("asked") )                           
return "不过已经有人去找他了。";                
else	{                                             
	me->set_temp("炼妖壶/zhangAsked",1);            
	set("asked",1);                                 
	remove_call_out("reset");              
	call_out("reset",600);                 
	return "据说好似在长安外的小树林里。";   
	}                                      
}
                                           
void create()
{
       set_name("张道陵", ({"zhang daoling", "zhang", "daoling"}));
       set("long", "张道陵乃是天上的天师，此刻偷闲在山边观观景色。\n");
       set("title", "天师");
       set("gender", "男性");
        set("class", "xian");
       set("level", 1000);
       set("yumo_agree", 1);
       set("age", 60);
       set("attitude", "peaceful");
       set("shen_type", 1);
       set("rank_info/respect", "老神仙");
       set("per", 30);
	set("int", 30);
	set("str", 25);
       set("max_kee", 10000);
       set("max_gin", 10000);
       set("max_sen", 10000);
       set("force", 40000);
       set("max_force", 12000);
       set("force_factor", 500);
       set("max_mana", 10000);
       set("mana",20000);
       set("mana_factor", 500);
       set("combat_exp", 800000000);
  set("daoxing", 100000000);


        set("eff_dx", 250000);
        set("nkgain", 400);



       set_skill("literate", 200);
       set_skill("unarmed", 500);
       set_skill("dodge", 500);
       set_skill("parry", 500);
        set_skill("sword", 600);
        set_skill("spells", 500);
        set_skill("dao", 500);
        set_skill("dianxue", 500);
        set_skill("changshengjue", 500);
        set_skill("force", 500);
        set_skill("jadesword", 600);
        set_skill("douzhuan-xingyi", 500);
        set_skill("lingbo-weibu", 500);
	map_skill("spells", "dao");
        map_skill("unarmed", "dianxue");
        map_skill("force", "changshengjue");
        map_skill("sword", "jadesword");
        map_skill("parry", "douzhuan-xingyi");
        map_skill("dodge", "lingbo-weibu");
        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: perform_action, "sword", "jianyi" :), 
                (: perform_action, "sword", "qishen" :), 
                (: perform_action, "unarmed", "dianxue" :), 
                (: exert_function, "rebirth" :),
        }) );

set("inquiry",([                                
	"张申"  :       (: askZhang :),   
        "九宫"     : "九宫之义，法以灵龟。二四为肩，六八为足；左三右七，戴九履一；五居中间。\n", 
        "八卦"     : "乾三连，坤六段；离中虚，坎中满；震仰盂，艮覆碗；兑上缺，巽下断。\n", 
        "五行"     : "金生水，水生木，木生火，火生土，土生金。金克木，木克土，土克水，水克火，火克金。\n", 
        "奇门"     : "天干十干中的乙丙丁为三奇，称奇门。\n", 
        "仪门"     : "天干十干中的戊己庚辛壬癸为六仪，称仪门。\n", 
        "遁甲"     : "三奇六仪分置九宫，以甲统之，视其加临吉凶以为趋避，称遁甲。\n", 
        "阵诀"     : "既济小过损益无，妄大过未济闲困。中途走错从坤始，要达阵心逢震晕。\n", 
        "太极"     : "太极万物之始。\n", 
        "两仪"     : "太极生两仪，即阴阳也。\n", 
        "四象"     : "两仪生四象，即东南西北四方也。\n", 
        "易经"     : "那是一本讲解伏羲六十四卦的奇书，一般人难得看懂。\n", 
        "凌波微步"     : "那是本派最得意的武功之一，怎么，你感兴趣么？由此向北... ...\n", 
]));
	
//create_family("逍遥派", 1, "蓝");
setup();

        carry_object("/d/lingtai/obj/heao")->wear();
	carry_object("/d/lingtai/obj/faguan")->wear();
        carry_object("/d/obj/weapon/sword/qingfeng");
}

void init() 
{
        add_action("do_none","perform"); 
        add_action("do_none","cast"); 
        add_action("do_none","ji"); 
        add_action("do_none","shield"); 
}
int do_none() 
{
        object me = this_object(); 
        message_vision("张道陵说道：大家公平比武，莫施杀招！\n",me); 
        return 1; 
}

void attempt_apprentice(object ob)
{
	if ( (string)ob->query("family/family_name")=="方寸山三星洞") {
	command("say RANK_D->query_respect(ob) + 已是身处名门，还需多加努力才是，怎可又投我门下？\n");
	return;
	}
	command("shake");
	command("say 老夫不收外门弟子，却可指点你一条明路，这山上有个老神仙，法力无边，你投奔他去吧！\n");
        return;
}

void die()
{

        if( environment() ) {
        message("sound", "\n\n张道陵脸色突变，道：天上点卯，恕不奉陪！\n\n", environment());
	command("drop all");
	message("sound", "\n张道陵化成一股紫烟冲上天去。。。\n\n", environment());
        }

        destruct(this_object());
}

int accept_fight(object me)
{	me= this_object();
	if( (int)me->query("kee")*100/(int)me->query("max_kee") >= 50 ) {
		if( (int)me->query("kee")*100/(int)me->query("max_kee") >= 90 ) {
		
			command("say 好吧，不过老夫马上就要走了，只斗片刻！\n");
                        command("wield sword");
                        command("exert rebirth");
                        command("enable unarmed dianxue");
			return 1;
			}
		command("say 好吧，不过老夫马上就要走了，只斗片刻！\n");
               	command("wield sword");
                command("exert rebirth");
               	return 1;
	}
        command("say 良景如斯，无心斗而。\n");
        return 0;
}

void consider()
{

        int i, flag = 0;
        object *enemy;

        enemy = query_enemy() - ({ 0 });
        for(i=0; i<sizeof(enemy); i++) {
                if( !living(enemy[i]) ) continue;
                        flag++;
                if(     !query_temp("weapon") ) {
                command("say 阁下功夫超群，老道只好动粗了！\n");
                        command("wield sword");
			command("enable unarmed changquan");
                        break;
                }
        }
}
int recognize_apprentice(object ob) 
{
        return 1; 
}

int prevent_learn(object me, string skill) 
{
  if( skill != "lingbo-weibu" ) {  command("say 老夫不能教你!"); return 1; }
else
  return 0;
}
