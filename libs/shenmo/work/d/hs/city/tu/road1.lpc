#define ROAD "/d/hs/room.lpc"
#define MG_D __DIR__"mgd.lpc"
#define MAX_NUM 6
inherit ROAD;
#include <ansi.h>
#include <room.h>

string *dir = ({
	"north","south","west","east","up","down",
	"south","north","east","west","down","up",
});
void r_map();

void create ()
{
string msg;
set("short",YEL"地の迷宫"NOR);
msg = BLINK YEL"\n土  土  土  土  土  土  土  土  土\n"NOR;
msg+= "这里除了一望无垠的土砂石砾外，一无所有。\n\n";
set("long",msg);
set("exits", ([ 
        "south" : "/d/hs/city/gate-n",
        "north" : __DIR__"road2",
]));
set("hs_world",1);
setup();
}

void init()
{
if ( query("migong") )  //迷宫已经给触发
	{
	call_out("resets",600); 
	return ;
	}
call_out("r_map",1);
return;
}

void resets()
{
if ( query("migong") )
	delete("migong"); //重新准备触发
return;
}

void r_map()
{
int i;
string exit;
object room1,room2,env = this_object();

remove_call_out("r_map");

if ( query("migong") )
	return;

for ( i=2;i<MAX_NUM;i++ )
	{
	room1 = load_object(__DIR__"road"+sprintf("%d",i));
	room2 = load_object(__DIR__"road"+sprintf("%d",(i+1)));
	if ( objectp(room1) && objectp(room2) )
		{
		exit = dir[random(sizeof(dir))];
		MG_D->r_exit(room1,room2,exit);
		}
	}
env->set("migong",1); //迷宫开启
env->save();
return;
}
