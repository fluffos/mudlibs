#include <ansi.h>
inherit ITEM;

void create() {
  set_name(WHT "石头" NOR, ({ "shi tou", "shi", "stone" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", "一块大石头，挡住了去路，搬开看看(open door)\n");
    set("base_weight", 4000);
    set("no_get", "这么重，很难拿哦，还是搬搬看吧。\n" NOR);
    set("no_put", "这么重，很难拿哦，还是搬搬看吧。\n" NOR);
  }
  setup();
}

void init() {
  add_action("do_open", "open");
}

void do_open(string arg) {
  if (arg == "door")
    message_vision("$n摇晃了几下。\n", this_player(), this_object());
}
