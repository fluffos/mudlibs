#include <ansi.h>
#include <room.h>

mapping exit_s = ([
	"north" : 1,
	"south" : 2,
	"west"	 : 1,
	"east"	 : 2,
	"up"	 : 1,
	"down"	 : 2,
]);

void r_exit(object here,object there,string exit)
{
object stone;
string out,*str;
int num,i,flag;
str = keys(exit_s);
for ( i=0;i<sizeof(str);i++ )
	{
	if ( str[i]==exit )
		{
		num = exit_s[str[i]];
		flag = i;
		break;
		}
	}
if ( !num || num>6 || num<1 )
	error("/d/hs/migongd.c出错了...\n");
if ( num==1 )
	out = str[flag+1];
else	out = str[flag-1];

here->set("exits/"+exit,file_name(there));
there->set("exits/"+out,file_name(here));
if ( random(100)>50 )
	{
	stone = new(__DIR__"shi");
	stone->move(here);
	stone = new(__DIR__"shi");
	stone->move(there);
	here->create_door(exit,stone->name(),out,DOOR_CLOSED); 
	there->create_door(out,stone->name(),exit,DOOR_CLOSED); 
	}
here->save();
there->save();
message("channel:sys",HIR"【"NOR WHT"系统"NOR HIR"】"NOR WHT"四象迷宫·土 开始运转。\n"NOR,users());
return;
}
