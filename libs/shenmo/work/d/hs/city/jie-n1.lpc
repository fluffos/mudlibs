//地水火风
#include <ansi.h>
inherit ROOM;

void create ()
{
set("short",YEL"地の大街"NOR);
set("hs_world",1);
set("long", @LONG

你走在一条宽阔的石板大街上，南面就快到城中心了，可以看到钟楼
耸立于前；北面通往郊外。

LONG);
set("exits",([
        "north" : __DIR__"gate-n", //城门
	"south": __DIR__"center",//中心
	"west" : __DIR__"guwan" , //古玩店
]));
setup();
}

