#include <ansi.h>
inherit ROOM;

void create ()
{
string msg;
set ("short","十字街头");
set("hs_world",1);
msg = @LONG
这里便是四象之都的城中心，四条大街交汇于此。一座巍峨高大的钟
楼耸立于前，很是有些气势。这里车水马龙，来往人潮不断。
来自世界各地的魔幻士们在这里流连忘返，寻找自己中意的魔幻具。
LONG;
msg+= HIY+@LONG
		      __
		     .;_.'\
		    / ' \ /,
		   Y  |  Y |
		   |- Q -| |
		   |   \ | |
		  .^\_,_/^./~|
		 |~~~~~~~~~| |
		 ||~~~;~~~|| |
		 ||   ;)c:|| |
		 || '(;   || |
		 ||   ;)' || |
		 ||  {;}  || |
		 ||   ;)' || |
		 ||:a(;   || |
		 ||   ;)' || |
		 |'~~~~~~~'|/^\
		.^~~~~~~~~~^\./
		~~~~~~~~~~~~~'       

LONG+NOR;
set("long",msg);
set("exits",([
	"north" : __DIR__"jie-n1",
	"west" : __DIR__"jie-w1",
	"east" : __DIR__"jie-e1",
        "south" : __DIR__"jie-s1",
	"down" : __DIR__"droproom",
]));

set("objects",([
//		__DIR__"npc/jumin2" : random(2),
]));
setup();
}

