inherit NPC;
#include <ansi.h>
#include "guard.h"

#define NAMES_D "/u/run/hs/city/npc/named.lpc"

void create()
{
mapping name = NAMES_D->random_name(0,1,0,"火",0);
if( !name )
	name = ([ "name": "火君",  "id": ({ "huo jun", "jun", "guard"}) ]);
set_name(name["name"], name["id"]);
set("title","火系守卫");
set("gender","男性");
set("combat_exp",80000000);
set("age",16+random(40));
set("per",10+random(10));
set("属性","火");
set("attitude", "friendly");
set("back","west");
setup();
carry_object("/obj/cloth")->wear();
}

