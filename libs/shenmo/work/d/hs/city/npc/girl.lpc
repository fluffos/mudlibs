inherit NPC;
#include <ansi.h>

#define NAMES_D "/u/run/hs/city/npc/named.lpc"

void create()
{
int j, i = 1 + random(4);
mapping name = NAMES_D->random_name(1,2,0, 0,0);
if( !name )
	name = ([ "name": "如花",  "id": ({ "ru hua", "hua", "girl"}) ]);
set_name(name["name"], name["id"]);
set("title","女魔导师");
set("gender","女性");
set("combat_exp",80000000);
set("age",16+random(10));
set("per",20+random(20));
set("chat_chance",80); 
set("chat_msg", ({ 
	(: random_move :),
}));
setup();
carry_object("/d/obj/cloth/skirt")->wear();
}

