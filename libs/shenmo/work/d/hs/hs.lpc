#include <ansi.h>
#include <login.h>
#include "/d/hs/lvl.h"

inherit NPC;
inherit F_SAVE;

private string SAVE_NAME = "hs_save";
private nosave int can_save = 1;
string *att_lost = ({ "rkee", "ratk", "rdef", "rspd", });

string query_save_file() {
  string id;
  id = query("owner");
  if (!id) return 0;
  return sprintf("/data/hs/hs/%c/%s", id[0], id + (string)query("num"));
}


void create() {
  seteuid(getuid());
  set_name("幻兽", ({ "hs" }));
  set("race", "幻兽");
  set("gender", "雄性");
  set("combat_exp", 1500);
  set("force", 10);
  set("max_force", 10);
  setup();
}

void unconcious() {
  if (query("kee") < 0 || query("sen") < 0)
    die();
  else ::unconcious();
}

void die() {
  object me = query_temp("last_opponent");
  object ob = this_object();
  object owner = ob->query("owner_object");
  mapping att = ob->query("att");
  int lvl = att["lvl"];
  int exp;

  ob->remove_killer(me);
  me->remove_killer(ob);

  att[att_lost[random(sizeof(att_lost))]] -= 1;
  exp = (lvl_to_exp(lvl + 1) - lvl_to_exp(lvl)) / 20;
  att["exp"] -= exp;
  att["faith"] -= 5 + random(10);
  ob->set("att", att);
  ob->save();

  if (environment(owner) != environment(ob))
    tell_object(
      owner,
      HIR "你心头突然莫名的一阵剧痛，脑中隐隐有种感觉：" NOR + ob->query("name") + HIR "已被" + HIW + me->query("name") + HIR "杀死了！！\n" NOR
    );

  message_vision(HIR "$N惨叫一声，轰然倒地。\n" NOR, this_object());
  message_vision(HIY "$N的尸体突然被一阵奇异的光芒笼罩。当光芒散去之时，尸体亦消失不见了。\n" NOR, this_object());

  destruct(this_object());
  ::die();
}
