#include <ansi.h>
#include <login.h>

inherit ITEM;

#include "/d/hs/hs.h"


int check_legal_id(string id);
int check_legal_name(string name, int max_len);
int build_hs(object ob);
void get_id(string arg, object ob);
void get_name(string arg, object ob);
void get_desc(string arg, object ob);
void get_unit(string arg, object ob);

void create()

{
     set_name(HIY"幻兽之卵"NOR, ({"egg" }) );
     set_weight(100);
     set("long","幻兽的卵，可以孵化出各种幻兽做为自己的宠物。\n");
     set("value", 1);
     set("material", "steel");
     set("no_sell", "这么难得的宝物还是留着吧。\n");
     set("unit", "颗");
     set("hs/store",1);
	setup();

}

void init()
{ 
 add_action("do_hatch","hatch");
}

int do_hatch(string arg)
{
        object egg;
        object me;
        mapping att,hs;
        object hsbaby;
        int i,ok,num,j;

        me = this_player();

	if(me->is_busy()) {write("你正忙着呢。\n");return 1;}

        if(!arg || arg=="")
        {
                write("你要孵化什么？\n");
                return 1;
        }

        if( arg == "egg" || arg == "幻兽之卵" )
        {


           if (!egg=present("egg",me)) return notify_fail("你身上没这个东西。\n"); 

           if( !environment(me)->query("no_fight") ) return notify_fail("这里不是安全区，万一孵化出来的幻兽宝宝被人偷袭就白忙了。\n");

           for (num=1,j=0;num<=me->query("can_have_hs");num++){
               if ( me->query("hs_att"+(string)num) ) j++;                       
              }        
        
           if (j>=me->query("hs_have")) return notify_fail("你所能携带的幻兽数已满，无法再进行孵化。\n");

           att=egg->query("att");

           if ( me->query("force") < att["能量"]*10 ) return notify_fail("你的内力不足，怕是难以孵化幻兽卵。\n");

           if (att["owner"]!=me->query("id")) {
               att["owner"]=me->query("id");
               att["born"]=(int) att["能量"]/2;
               }


           message_vision(HIW"$N浑身发出白光，越来越强烈，全身的光芒集中于双掌之间及$N的眉间。\n"NOR,me);

           if (att["能量"]<1) {
              message_vision(HIB"$N将能量传入掌中的幻兽卵，但卵中却没有任何生命迹象，看来是个死蛋，唉！\n"NOR,me);
              me->start_busy(5);
              return 1;
              }

           att["born"]--;
           if (att["born"]<1) {
              message_vision(HIC"$N手中的幻兽卵传来一阵异样，合在掌中的幻兽卵温度异常的升高，升到几乎烫手的高温，而且里面隐隐有东西活动的感觉。\n"NOR,me);
              message_vision(HIY"在$N满心期待中，原本光华的外壳先是出现裂痕，然后裂痕加大，一股奇特，说不上香或臭的味道开始散出，充斥整间屋子，有\n点像铁的锈味，只是很淡。\n"NOR,me);
              message_vision(HIY"接着，一颗龙眼大小的头伸了出来，没多久，整个身子全露了出来，看来只有巴掌不到的大小。\n"NOR,me);            
              message_vision(HIM"一头"HIC+att["name"]+HIG"("HIW+att["id"]+HIG")"+HIM"系的幻兽诞生了，现在处于幼生期阶段。\n"NOR,me);
              hsbaby=new("/d/hs/hs.lpc");
              hsbaby->set("att",att);
              egg->set("att",att);
              ok=call_out("hs_name",0,hsbaby);
              hsbaby->set_leader(me);
              hsbaby->set("hs_stage",1);
              for (num=1;num<=me->query("can_have_hs");num++){
                   if ( !me->query("hs_att"+(string)num) ){
                       me->set("hs_att"+(string)num,hsbaby->query("att"));                   
                       hsbaby->set("num",num);
                       }
              }
              hsbaby->save();                    
              }
           else
              message_vision(HIC"$N合在掌中的幻兽卵微微颤动了一下，卵中幻兽的生命迹象越来越明显。\n"NOR,me);

           i=att["能量"]-10;
           if (i<1) i=1;
           me->start_busy(i);
           me->add("force",-att["能量"]*10);
           egg->save();
           if (ok&&present(hsbaby,environment(me))) destruct(egg);
           return 1;
        }
        else
         write("你孵化什么？\n");
                return 1;
}

void hs_name(object ob)
{
        write("\n");
        write("请设定英文 id ：");
        input_to( (: get_id :), ob );
}



void get_id(string arg, object ob)
{
        arg = lower_case(arg);
        if( !check_legal_id(arg) )   {
                write("请设定英文 id ：");
                input_to( (: get_id :), ob ); 
                return;
        }

        ob->set_temp("hs_id",arg);
        
        write("\n");
        write("请设定中文名：(可加颜色)");
        input_to( (: get_name :), ob);
}

void get_name(string arg, object ob)
{
        string  arg_old;
        
        arg_old = arg;
        arg = replace_string(arg, "$BLK$", "");
        arg = replace_string(arg, "$RED$", "");
        arg = replace_string(arg, "$GRN$", "");
        arg = replace_string(arg, "$YEL$", "");
        arg = replace_string(arg, "$BLU$", "");
        arg = replace_string(arg, "$MAG$", "");
        arg = replace_string(arg, "$CYN$", "");
        arg = replace_string(arg, "$WHT$", "");
        arg = replace_string(arg, "$HIR$", "");
        arg = replace_string(arg, "$HIG$", "");
        arg = replace_string(arg, "$HIY$", "");
        arg = replace_string(arg, "$HIB$", "");
        arg = replace_string(arg, "$HIM$", "");
        arg = replace_string(arg, "$HIC$", "");
        arg = replace_string(arg, "$HIW$", "");
        arg = replace_string(arg, "$NOR$", "");

        if( !check_legal_name(arg, 12) )  {
            write("请设定中文名：(可加颜色)");
                input_to( (: get_name :), ob);
                return;
        }

        arg = arg_old;

        arg = replace_string(arg, "$BLK$", BLK);
        arg = replace_string(arg, "$RED$", RED);
        arg = replace_string(arg, "$GRN$", GRN);
        arg = replace_string(arg, "$YEL$", YEL);
        arg = replace_string(arg, "$BLU$", BLU);
        arg = replace_string(arg, "$MAG$", MAG);
        arg = replace_string(arg, "$CYN$", CYN);
        arg = replace_string(arg, "$WHT$", WHT);
        arg = replace_string(arg, "$HIR$", HIR);
        arg = replace_string(arg, "$HIG$", HIG);
        arg = replace_string(arg, "$HIY$", HIY);
        arg = replace_string(arg, "$HIB$", HIB);
        arg = replace_string(arg, "$HIM$", HIM);
        arg = replace_string(arg, "$HIC$", HIC);
        arg = replace_string(arg, "$HIW$", HIW);
        arg = replace_string(arg, "$NOR$", NOR);
        
        ob->set_temp("hs_name", arg );
        
        write("\n");
        write("请描述坐骑：");
        input_to( (: get_desc :), ob);
}

void get_desc(string arg, object ob)
{
        if( !check_legal_name(arg, 60) )  {
                write("请描述坐骑：");
                input_to( (: get_desc :), ob);
                return;
        }

        ob->set_temp("hs_desc",  arg);
        
        write("\n");
        write("幻兽用量词:");
        input_to( (: get_unit :), ob);
}


void get_unit(string arg, object ob)
{
        string hs_unit, hs_type;

    if( !check_legal_name(arg, 2) )  {
           write("幻兽用量词：");
           input_to( (: get_unit :), ob);
           return;
    }
    ob->set_temp("hs_unit", arg);
    build_hs(ob);  
}

int check_legal_id(string id)
{
        int i;
        string  *legalid;
        object ppl;     
        i = strlen(id);
    if( (strlen(id) < 3) || (strlen(id) > 20 ) ) {
                write("对不起，英文 id 必须是 3 到 20 个英文字母。\n");
                return 0;
    }
    while(i--)
        if( id[i] != ' ' && (id[i]<'a' || id[i]>'z') )  {
                write("对不起，英文 id 只能用英文字母。\n");
                return 0;
        }

        ppl = LOGIN_D->find_body(id);
        if(ppl || id=="guest" || id=="new") {
            write("这个名字与别的玩家ID相同了．．．");
            return 0;
        }

        if( file_size(sprintf("/data/user/%c/%s",id[0],id)
                    + __SAVE_EXTENSION__) >= 0 ) {
            write("这个名字已经被别的玩家使用了．．．");
            return 0;
        } 
    legalid = explode(read_file(BANNED_ID), "\n");
    for(i=0; i<sizeof(legalid); i++)   {
        if( id == legalid[i] )   {
                write("对不起，这种 id 会造成其他人的困扰。\n");
                return 0;
        }
    }
    
    return 1;
}

int check_legal_name(string name, int max_len)
{
        int i;
        string  *legalname;             //not implemented..may add later
        
        i = strlen(name);
    if( (strlen(name) < 2) || (strlen(name) > max_len ) ) {
        write( sprintf("对不起，幻兽中文字必须是 1 到 %d 个中文字。\n",
         max_len/2) );
                return 0;
    }
    while(i--)   {
        if( name[i]<=' ' )   {
                write("对不起，幻兽中文字不能用控制字元。\n");
                return 0;
        }
        if( i%2==0 && !is_chinese(name[i..<0]) )  {
                write("对不起，请您用「中文」给幻兽取名字。\n");
                return 0;
        }
    }
   
    return 1; 
}

int build_hs(object ob)
{
        mapping att,att_old;
        string long;
        if(!ob)  return 0;
        att_old=ob->query("att");
        att=att_old;        
        long=ob->query_temp("hs_desc")+"\n"+"它是"+this_player()->query("name")+"的幻兽。\n";
        att["long"]=long;
        att["unit"]=ob->query_temp("hs_unit");
        att["hs_id"]=ob->query_temp("hs_id");
        att["hs_name"]=ob->query_temp("hs_name");
        att["owner"]=this_player()->query("id");
        att["lvl"]=0;
        att["exp"]=0;
        att["faith"]=100;        
        ob->set("att",att);
        check_hs(ob);
        ob->delete_temp("hs_desc");
        ob->delete_temp("hs_unit");
        ob->delete_temp("hs_id");
        ob->delete_temp("hs_name");

        ob->move(environment(this_player()));
        return 1;
}
