string ask_mieyao() {
  object who = this_player();

  if ((string)who->query("family/family_name") == "月宫") {
    command("smile " + who->query("id"));
    return "/d/obj/mieyao"->query_yao(who);
  }
  return ("非我门人,何故来此?\n");
}
int do_kneel() {
  object who = this_player();
  if ((string)who->query("family/family_name") != "月宫")
    return notify_fail(this_object()->query("name") + "说：你又不是仙家弟子，拜我干什么？\n");
  if ("/d/obj/mieyao"->delete_mieyao(who)) {
    command("say 既然如此，就算了吧，不过你没有完成任务，得受些惩罚！\n");
    who->add("faith", -5);
    message_vision("$N的忠诚度下降了！\n", who);
  }
}
string ask_tian() {
  object who = this_player();
  if ((string)who->query("family/family_name") != "月宫")
    return ("你不是本派弟子，怎么来晓得漫天飞雪?");
  if (who->query("faith") < 1000)
    return ("你在本门名望还不够，还需多加努力才行。");
  who->set_temp("moon_tian", 1);
  return ("你可以perform tian,也可以尝试perform mantian。");
}

string ask_cancel() {
  object me = this_player();
  if ((int)me->query_temp("m_mieyao")) {
    me->add("daoxing", -2000);
    me->delete_temp("m_mieyao");
    me->delete("secmieyao");
    me->delete("secmieyao/type");
    me->delete("secmieyao/location");
    me->delete("secmieyao/place");
    me->delete("secmieyao/name");
    me->delete("secmieyao/id");
    return ("没用的东西！");
  } else {
    return ("你有任务吗？！");
  }
}


string ask_yudi() {
  object me = this_player();
  object ob = this_object();

  if (!me->query_temp("yudi_asked")) return "玉皇大帝不正在灵宵宝殿办公吗？\n";

  command("ah");
  message_vision("$n脸上闪过一丝慌乱，赶紧凑到$N身边。\n", me, ob);
  tell_object(me, "西王母对你小声说道：这事你也知道了？玉帝那死鬼这两年来亲近的人一个都不见，似乎有什么古怪。\n");
  tell_object(me, "西王母顿了顿，似有所悟，缓缓说道：这样吧，你先去把那假玉帝干掉，再来告诉我情况，看我猜得对是不对。\n");

  me->set_temp("xwm_asked", 1);

  return "小心行事，切记！";
}

string ask_done() {
  object me = this_player();
  object ob = this_object();
  int i = random(600);

  if (!me->query_temp("wei_killed")) return "没事done什么done,你无聊啊？\n";

  message_vision("$N跟$n说明了当时的情况:情况是这样的。\n", me, ob);
  message_vision("$n皱了皱眉：原来情况是这样的。果然跟我猜想的一样。\n", me, ob);
  command("consider");
  message_vision("$n对$N说道：现在你看到的是我的化影，速到昆仑仙境来找我一趟吧。\n那里是无法用法力到达的地方，你可以借助腾蛇飞上来。\n", me, ob);

  command("chat " + me->query("name") + "智识假帝，击杀危莪，于我天庭有功！");

  tell_object(me, "你赢得了二十年道行！\n");

  me->set("tghj/number", 1);
  me->set("tghj/one", "done");
  me->add("daoxing", 20000);
  me->delete_temp("wei_killed");
  me->delete_temp("xwm_asked");

  return "天宫又要大乱了，唉！";
}
