#include <ansi.h>
inherit NPC;
inherit F_MASTER;

string ask_father();

void create()
{
       set_name(HIM"太 真"NOR, ({"tai zhen", "zhen"}));
       set("long",
            "西王母幺女,开朗活泼，为天宫众人所疼爱。\n可是现在她蛾眉微颦，似乎有什么心事。\n");
       set("title", "西王母幺女");
       set("gender", "女性");
       set("age", 16);
       set("class", "xian");
       set("attitude", "friendly");
       set("rank_info/respect", "仙姑");
       set("per", 40);
	set("int", 30);
       set("max_kee", 900);
       set("max_gin", 600);
       set("max_sen", 800);
       set("force", 800);
       set("max_force", 800);
       set("force_factor", 50);
       set("max_mana", 600);
       set("mana", 600);
       set("mana_factor", 40);
       set("combat_exp", 400000);
       set("daoxing", 800000);


        set("eff_dx", 200000);
        set("nkgain", 350);

       set_skill("literate", 80);
       set_skill("unarmed", 80);
       set_skill("dodge", 180);
       set_skill("force", 80);
       set_skill("parry", 80);
       set_skill("sword", 80);
       set_skill("spells", 80);
        set_skill("moonshentong", 80);
        set_skill("baihua-zhang", 80);
        set_skill("moonforce", 80);
        set_skill("snowsword", 80);
        set_skill("moondance", 200);
        map_skill("spells", "moonshentong");
        map_skill("unarmed", "baihua-zhang");
        map_skill("force", "moonforce");
        map_skill("sword", "snowsword");
        map_skill("parry", "snowsword");
        map_skill("dodge", "moondance");

        create_family("月宫", 2, "弟子");

        set("inquiry", ([
                ]) );

        set("inquiry", ([
                "父王" : (: ask_father :),
                "father" : (: ask_father :),
                "玉皇大帝" : (: ask_father :),
                "玉帝" : (: ask_father :),
                ]) );

        setup();

        carry_object("/d/moon/obj/luoyi")->wear();
}

string ask_father()
{
  object me=this_player();
  object ob=this_object();
  if (me->query("dntg/bagualu")!="done") return "你有什么事吗？"; 
  if (me->query("tghj/one")=="done") return "快去昆仑仙境找我母亲吧！";
  command("hmm");
  message_vision("$N低头默默想了会，咬咬牙，说道：好吧，我告诉你一个秘密，希望你能帮忙解决这个浩劫。\n",ob);
  message_vision("$N附耳对$n说了几句话。\n",ob,me);
  tell_object(me,"我怀疑现在的父王是假的，他跟以前相比实在是变化太大了，希望你能够帮我调查一下。\n");
  me->set_temp("taizhen_asked",1);
  return "唉！似乎又是一个大浩劫的开始，天宫有难了。\n";
}
