#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string ask_lang();

void create(object me) {
  set_name(HIB "危莪" NOR, ({ "wei e", "wei", "e" }));
  set("gender", "男性");
  set("long", "上古魔神，九黎三苗氏。。\n" NOR);
  set("age", 100);
  set("attitude", "heroism");
  set("str", 40);
  set("int", 50);
  set("max_kee", 5000);
  set("kee", 5000);
  set("per", 12);
  set("max_sen", 5000);
  set("sen", 2000);
  set("combat_exp", 2000000);
  set("daoxing", 1000000);
  set("force", 6000);
  set("max_force", 3000);
  set("mana", 6000);
  set("max_mana", 3000);
  set("force_factor", 150);
  set("mana_factor", 150);
  set_skill("unarmed", 200);
  set_skill("huoyun-qiang", 200);
  set_skill("moyun-shou", 200);
  set_skill("parry", 200);
  set_skill("dodge", 200);
  set_skill("force", 200);
  set_skill("huomoforce", 200);
  set_skill("moshenbu", 200);
  set_skill("spells", 200);
  set_skill("huoyun-qiang", 200);
  set_skill("pingtian-dafa", 200);
  map_skill("force", "huomoforce");
  map_skill("spells", "pingtian-dafa");
  map_skill("unarmed", "moyun-shou");
  map_skill("parry", "huoyun-qiang");
  map_skill("dodge", "moshenbu");
  map_skill("spear", "huoyun-qiang");
  set("family/family_name", "火云洞");

  set("inquiry", ([
  ]));

  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    (: perform_action, "spear", "lihuo" :),
  }));

  setup();

  carry_object("/d/obj/armor/jinjia")->wear();
  carry_object("/d/obj/weapon/spear/jinqiang")->wield();
}

void unconcious() {
  object me, obj;
  if (!me = query_temp("last_damage_from"))
    me = this_player(1);
  message("sound", "\n\n危莪惨叫一声，轰隆倒地。：n\n", environment());
  message("sound", "\n危莪口喷鲜血仍不住邪笑：嘿嘿，我主统治这世界的时候快到了，哈..哈..\n\n", environment());
  me->set_temp("wei_killed", 1);
  ::die();
}

void die() {
  object me, obj;
  if (!me = query_temp("last_damage_from"))
    me = this_player(1);
  message("sound", "\n\n危莪惨叫一声，轰隆倒地。：n\n", environment());
  message("sound", "\n危莪口喷鲜血仍不住邪笑：嘿嘿，我主统治这世界的时候快到了，哈..哈..\n\n", environment());
  me->set_temp("wei_killed", 1);
  ::die();
}
