inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIR "小兵" + HIG + "之" + HIY + "家" NOR);
  set("long", HIW "\n
我就是那个" + HIC "自小就有野心，想当一个统领天下兵马的元帅。\n" +
    HIY "认为要当元帅就要先当将军，而要当将军就要从小兵干起。\n" +
    HIR "所以我就是小兵唐龙" + HIW "tanglong" + HIC "!\n
" NOR);
  set("exits", ([
    "wizroom": "/d/wiz/wizroom",
    "kz": "/d/city/kezhan",
    "+": "/d/city/center",
    "tom": "/u/tom/workroom",
    "star": "/u/star/workroom",
    "fang": "/u/fang/workroom",
    "qcy": "/d/penglai/yashang",
    "rubi": "/u/rubi/workroom",
  ]));
  set("objects", ([
    "/u/tom/npc/lianhua": 1,
  ]));
  set("no_time", 1);
  set("valid_startroom", 1);

  setup();
}
