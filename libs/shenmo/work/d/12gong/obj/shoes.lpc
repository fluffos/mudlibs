// shoes.c

#include <armor.h>
#include <ansi.h>

inherit BOOTS;


void create() {
  set_name(HIW "泰山神靴" NOR, ({ "shoes" }));
  set_weight(900);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一双泰山神鞋。  \n");
    set("material", "cloth");
    set("unit", "双");
    set("value", 200000);
    set("armor_prop/armor", 8);
    set("armor_prop/dodge", 20);
  }
  setup();
}
//int query_autoload() { return 1; }
