inherit ITEM;
inherit F_SAVE;
inherit F_BACKUP;
#include <ansi.h>
void create() {
  set_name("灰烬", ({ "huijin", "ash" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("value", 0);
    set("no_drop", "这么珍贵的纪念还是留着吧。\n");
    set("material", "paper");
    set("long", "一堆无法辨认的焦黑的灰烬，象是一场浩劫后留下的残余。\n");
  }
  setup();
}

void reset() {
  if (!environment() ||
    query("owner_id") != getuid(environment())) {
    destruct(this_object());
    return;
  }
}

// This is used by F_SAVE to determine the filename to save our data.
string query_save_file() {
  string id, series;

  id = query("owner_id");
  if (!id) return 0;

  return sprintf(DATA_DIR "photo/%c/%s", id[0], id);
}

int save() {
  return ::save();
}

void setup() {
  ::setup();
}

int query_unique() { return 1; }
