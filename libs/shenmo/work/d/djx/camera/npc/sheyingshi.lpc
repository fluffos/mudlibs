#include <ansi.h> 
inherit F_VENDOR_SALE;

void create()
{
        reload("sheyingshi");
     set_name("笑笑",({"sheying shi","sheyingshi","shi","xiaoxiao"}));
     set("title","摄影师");
     set("gender","男性");
     set("age",22);
     set("per",30);
     set("long","这位摄影师的来历非常神秘,但是看起来充满了艺术家的气质。\n");
     set("combat",10000);
     set_skill("unarmed",150);
     set("no_accept",0);
     set("attitude","friendly");
     set("vendor_goods", ([ 
     "camera": "/d/djx/camera/obj/camera", 
]) );

     setup();
     carry_object("/d/obj/cloth/choupao")->wear();
     add_money("gold",1);
}

void init()
{
     object ob,me;
     me=this_object();
     ::init();
     if( interactive(ob = this_player()) && !is_fighting() ) {
            remove_call_out("greeting");
            call_out("greeting", 1, ob);
     }
       add_action("do_vendor_list", "list");
}

void greeting(object ob)
{

     switch( random(3) ) {
     case 0:
            say("笑笑走过来，微笑着说道：这位" +
     RANK_D->query_respect(ob)
             + "，来照张相,留个纪念吧。\n",this_object());
            break;
     case 1:
            say("笑笑不知道在看什么,有人进来了也没有反应。\n",this_object());
            break;
     case 2:
            say("笑笑见到有人进来，立刻放下手中的相机，热情地打招呼。\n",this_object());
            break;
     }
}



