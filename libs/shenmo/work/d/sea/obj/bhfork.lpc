// gangcha.c

#include <weapon.h>

#include <ansi.h>
inherit FORK;
inherit F_UNIQUE;

void create() {
  set_name(HIG "碧海叉" NOR, ({ "sea fork", "cha", "fork" }));
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 5000);
    set("no_break", 1);
    set("material", "iron");
    set("long", "大禹治水时留下的三件法宝之一。\n");
    set("wield_msg", "$N抄起一柄$n缓缓的握在手里，似乎凝聚了无穷的力量。\n");
    set("replace_file", "/d/sea/obj/yincha");
    set("unwield_msg", "$N放下手中的$n，周围的人又平静了下来。\n");
  }
  init_fork(250);
  setup();
}
