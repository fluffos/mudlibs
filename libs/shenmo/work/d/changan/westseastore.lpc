#include <ansi.h>
inherit ROOM;

int reset();

void create() {
  set("short", HIW "西海边" NOR);
  set("long", @LONG

这里是西海的海岸。西面茫茫大海望不到边际。海面上波涛
汹涌，几丈高的浪头此起彼伏，象是要吞灭一切敢于到海上的
东西。也许这里便是路的尽头，面前的大海对一个凡人来说是
不可逾越的。
LONG);

  set("exits", ([ /* sizeof() == 1 */
    "east": __DIR__ "office",
  ]));
  set("no_fight", 1);

  setup();
}

void init() {
  add_action("do_swim", "swim");
}

int do_swim() {
  int i;
  object *inv;
  object me = this_player();
  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    if (userp(inv[i]))
      return notify_fail("还是先把身上的玩家放下来再去吧！\n");
    if (inv[i]->query("id") == "yueguang baohe")
      return notify_fail("还是先把身上的宝盒放下来再去吧！\n");
  }
  if (!present("renma shengyi's head", me))
    return notify_fail("你的圣衣头部呢？\n");

  if (query("no_swim") == 0) {
    message_vision(HIY "$N纵身一跃，跳入海中。只见$N使足了全身力气，手足并用，不一会儿就游到了海中小岛上。\n" NOR, me);
    if (me->query_temp("ridee"))
      me->query_temp("ridee")->set_temp("rider", 0);
    me->set_temp("ridee", 0);
    me->add_temp("apply/dodge", -me->query_temp("ride/dodge"));
    me->set_temp("ride/dodge", 0);
    me->move("/d/sds2/d_island1");
    message_vision(HIY "只见$N浑身湿漉漉地从海里爬了上来。\n" NOR, me);
    me->receive_damage("kee", 100);
    me->receive_damage("sen", 100);
    set("no_swim", 1);
    call_out("reset", 240);
    return 1;
  } else return notify_fail(HIW "刚 刚 有 人 去 岛 上 了 ，你 还 是 等 等 吧 。。。\n" NOR);

}

int reset() {
  set("no_swim", 0);
  return 1;
}
