// wujiang.c 武将
#include <login.h> 
#include <ansi.h>
inherit NPC;
//#include <greeting.h>
int ask_khbd();
int ask_pxjf();

void create()
{
        set_name("海公公", ({ "hai gonggong", "hai" }));
        set("gender", "无性");
        set("inquiry",([
            "葵花宝典"     : (: ask_khbd :),
            "辟邪剑法"     : (: ask_pxjf :),
            ]));
        set("age", random(10) + 30);
        set("str", 25);
        set("long", "他是东厂大太监海大富\n\n
                     乔装改扮成商人模样出京寻欢作乐\n\n
                     长得既像老头又像老太太。\n");
        set("combat_exp", 2000000);
        set("attitude", "peaceful");
        set_skill("unarmed", 550);
        set_skill("force", 550);
        set_skill("stick", 550);
        set_skill("dodge", 550);
        set_skill("parry", 550);
        set_skill("kuihua-shengong",550);
        set_skill("pixie-sword",550);
        map_skill("force","kuihua-shengong");
        map_skill("unarmed","kuihua-shengong");
        map_skill("dodge","pixie-sword");  
        map_skill("sword","pixie-sword"); 
        set("max_kee", 8000);
	      set("max_sen", 4000);
        set("force", 14000); 
        set("max_force", 14000);
        set("force_factor", 1500);
	      set("max_mana", 14000);
	      set("mana", 14000);
	      set("mana_factor", 1150);
        setup();
        carry_object("/d/city/obj/zhen")->wield();
        carry_object("/d/city/obj/cloth")->wear();
}

void init()
{
        object ob;
        ::init();
        if (interactive(ob = this_player()) && (int)ob->query_condition("killer")) 
        	{
        }
        //greeting2(this_player());
}
int accept_fight(object me)
{
        message_vision("海公公对$N把眼一瞪，喝道：去死！\n\n", me);
        return 0;
}

int ask_khbd()
{
        object me;
        object item;
        me=this_player();
        if (me->query("gender") == "男性"||me->query("gender") == "无性")
        //if( me->query("gender") != "无性")
               {
               command("hehe");
               command("say 你不是同道中人，何必强求？！"); 
               return 1; 
               }
				else
        {
           if ( random(100) > 90 )
           {
               command("sigh");
               command("say 你我天缘不符，是在无法与你结识。");
           }
        else
            {
               command("haha");
               command("say 你我天运相合！\n");
               command("say 碰上我算是你走了狗屎运了，我就将这本《葵花宝典》传于你！\n");
               item=new("/d/city/obj/kuhua");
               item->move(me);
               command("chat 本公公的葵花神功终于后继有人了！\n");
               message("channel:rumor",YEL+"\n【"+HIM" 葵花太监 "NOR+YEL"】某人："+me->query("name")+"从海公公那里得到了"+HIR"《葵花宝典》"NOR+YEL"！\n\n"+NOR,users() );
             }
        return 1;
        }
        return 0;
}

int recognize_apprentice(object ob) 
{
        return 1; 
}

