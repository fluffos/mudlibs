// by HAPP@YSZZ
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "山路");
  set("long", @LONG

这是走向白羊宫的路上，只见前面可以看到美丽的白羊宫耸立在奥林
匹亚峰上！

LONG);

  set("exits", ([
    "southup": __DIR__ "toby2",
  ]));
  set("outdoors", "12gong");
  set("water", 1);
  setup();
}

int valid_leave(object me, string dir) {
  int i;
  object *inv;
  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    if (userp(inv[i]))
      return notify_fail("还是先把身上的玩家放下来再去吧！\n");
    if (inv[i]->query("id") == "yueguang baohe")
      return notify_fail("还是先把身上的宝盒放下来再去吧！\n");
  }
  if (!userp(me))
    return notify_fail("小猫小狗的别想进圣域！\n");
  if (me->query("sds3/baiyang") == "done") {
    if (query("no_walk") == 0) {
      message(
        "chat",
        HIY "【黄道十二宫】沙织(Sha zhi):" + HIW + ob->name() + HIY "再次踏上了前往圣域的路程!\n" NOR,
        users()
      );
      if (me->query_temp("ridee"))
        me->query_temp("ridee")->set_temp("rider", 0);
      me->set_temp("ridee", 0);
      me->add_temp("apply/dodge", -me->query_temp("ride/dodge"));
      me->set_temp("ride/dodge", 0);
      set("no_walk", 1);
      call_out("reset", 360);
      return 1;
    } else return notify_fail(HIY "刚 刚 有 人 去 圣 域 了 ，你 还 是 等 等 吧 。。。\n" NOR);
  } else {
    if (!present("renma shengyi", me))
      return notify_fail("圣域不是要你带圣衣过来相见吗？！\n");

    if (query("no_walk") == 0) {
      message(
        "chat",
        HIY "【黄道十二宫】沙织(Sha zhi):" + HIW + ob->name() + HIY "踏上了前往圣域的路程!\n" NOR,
        users()
      );
      if (me->query_temp("ridee"))
        me->query_temp("ridee")->set_temp("rider", 0);
      me->set_temp("ridee", 0);
      me->add_temp("apply/dodge", -me->query_temp("ride/dodge"));
      me->set_temp("ride/dodge", 0);
      set("no_walk", 1);
      call_out("reset", 360);
      return 1;
    } else return notify_fail(HIY "刚 刚 有 人 去 圣 域 了 ，你 还 是 等 等 吧 。。。\n" NOR);
  }
}

int reset() {
  set("no_swim", 0);
  return 1;
}
