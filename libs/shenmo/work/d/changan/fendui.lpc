// Room: /d/changan/fendui.c
inherit ROOM;
int dig_gumu(string arg);

void create() {
  set("short", "荒坟堆");
  set("long", @LONG

这里是长安城南的一片荒地，周围密密麻麻地堆了好几十个坟头。
有些坟前还有些祭祀，烧纸的痕迹。四处荒凉，很少有人走动，偶
而有几只寻食的野狗跑过。
LONG);
  set("mai_corpse_able", 1);
  set("outdoors", __DIR__ "");
  set("exits", ([ /* sizeof() == 1 */
    "west": __DIR__ "broadway1",
    "down": "/d/mingjie/city",
  ]));
  setup();
}


void init() {
  add_action("dig_gumu", "dig");
}

int dig_gumu(string arg) {
  object me = this_player();
  if (!arg || arg != "gumu") return 0;
  write("你运力挖了下去\n");
  message_vision("$N一闪身钻入荒坟之中。\n", me);
  me->move("/d/gumu/gumu.lpc");
  return 1;
}
