#include <ansi.h>
inherit ROOM;

void create ()
{
        set ("short", "南海之滨");
        set ("long", @LONG

南海之滨。往北是一条宽阔笔直的官道，足可容得下十马并驰。
往南则是一片汪洋大海，不知通向何方。西南海面上隐隐可见
一小岛。浅海近岸处还有几个游泳的人。
LONG);

        set("exits", ([
                "north" : __DIR__"broadway5",
                "west" : "/d/jz/egate",
                "east" : __DIR__"seashore1",
                "erengu" : "/d/ermigong/erg0.lpc",
        ]));
        set("outdoors", 1);
        setup();
        remove_call_out("resets");
        call_out("resets",10);
        
}


int valid_leave (object me, string dir)
{
        if( dir == "erengu" )
        {
                if( !me->query("get_jiayi_book") )
                        return notify_fail("恶人谷，太过神秘，你还是算了吧！\n");
        }
        return ::valid_leave(me, dir);
}


void init()
{
        add_action("do_swim", "swim");
}

int do_swim()
{
        object me = this_player();
        
        message_vision(HIY "$N"HIY"纵身一跃，跳入海中。只见$P使足了全身力气，手足并用，不一会儿就游到了海中小岛上。\n" NOR, me);
        if( me->query_temp("ridee") )
                me->query_temp("ridee")->set_temp("rider",0);
        me->set_temp("ridee",0);
        me->add_temp("apply/dodge",-me->query_temp("ride/dodge"));
        me->set_temp("ride/dodge",0);

        me->move("/d/nanhai/island");
        message_vision(HIY "只见$N浑身湿漉漉地从海里爬了上来。\n" NOR, me);
        me->receive_damage("kee", 20);
        me->receive_damage("sen", 20);
        return 1;
}

void resets()
{
        object old,obj;
        
        remove_call_out("resets");
        old = query("last_lianhua");
        if( old && objectp(old) )
        {
                if( environment(old) )
                {
                        old->powerup();
                        old->remove_all_killer(); 
                        all_inventory(environment(old))->remove_killer(old);
                        message_vision(HIW"$N"HIW"说道：「不打了，不打了，我投降。」\n"NOR,old);
                        message_vision("$N急急忙忙的离开了。\n",old);
                }       
                destruct(old);
        }
                
        obj = clone_object ("/d/nanhai/npc/babu");
        if( obj->create_place() )
        {
                set("last_lianhua",obj);
                call_out("resets",600);
        }
        else
        {
                destruct(obj);
                call_out("resets",120);
        }
        
}

