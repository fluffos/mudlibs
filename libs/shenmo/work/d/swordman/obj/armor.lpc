#include <ansi.h>
#include <armor.h>
inherit ARMOR;

void create() {
  set_name("武士铠", ({ "knight armor", "wushi jia", "jia", "armor" }));
  set_weight(40000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "一件黑漆发亮的铠甲，发着闪耀的亮光。\n");
    set("material", "steel");
    set("value", 7000);
    set("armor_prop/armor", 55);
  }
  setup();
}
