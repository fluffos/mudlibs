#include <ansi.h>
#include <armor.h>
inherit CLOTH;

void create()
{
set_name("和服",({"he fu","skirt"}));
set_weight(3000);
if( clonep() )
	set_default_object(__FILE__);
else	{
	set("unit", "件");
	set("long", "一件艳丽的"+({"咤","粉"})[random(2)]+"色和服。\n");
	set("material", "cloth");
	set("value", 550);
	set("armor_prop/armor",22);
	set("armor_prop/dodge",2);
	set("armor_prop/personality",2);
	set("female_only",1);
        }
setup();
}

