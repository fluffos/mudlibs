#include <ansi.h>
#include <armor.h>
inherit CLOTH;

void create()
{
set_name("和服",({"he fu","cloth"}));
set_weight(3000);
if( clonep() )
	set_default_object(__FILE__);
else	{
	set("unit", "件");
	set("long", "一件朴素的"+({"玄","素"})[random(2)]+"色和服。\n");
	set("material", "cloth");
	set("value", 550);
	set("armor_prop/armor",23);
	set("armor_prop/dodge",1);
	set("armor_prop/personality",1);
        }
setup();
}

