#include <ansi.h>
#include <armor.h>
inherit BOOTS;

mapping *names = ({
  ([ "name": "软木履",
    "id": ({ "ruanmu lu", "lu", "shoes" }),
    "long": "一对轻巧的木履，很是精巧。\n",
  ]),
  ([ "name": "木屐",
    "id": ({ "mu ji", "ji", "shoes", }),
    "long": "一对轻巧的木履，很是精巧。\n",
  ]),
  ([ "name": "草履",
    "id": ({ "cao lu", "lu", "shoes" }),
    "long": "一对轻巧的草履，很是精巧。\n",
  ]),
});


void create() {
  mapping name = names[random(sizeof(names))];
  set_name(name["name"], name["id"]);
  set_weight(1500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "对");
    set("long", name["long"]);
    set("material", "cloth");
    set("value", 550);
    set("armor_prop/armor", 2);
    set("armor_prop/dodge", 10);
    set("armor_prop/personality", -1);
  }
  setup();
}
