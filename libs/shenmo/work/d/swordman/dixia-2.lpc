#include <ansi.h>
inherit ROOM;

void create ()
{
set ("short", "地下暗道");
set ("long", @LONG

依稀有了些光亮，但是黑暗还是占据着大半个甬道，
黑暗中不知有什么在等待着你。

LONG);

set("exits", ([
	"down"	: __DIR__"dixia-3",
	"up"    : __DIR__"dixia-1",
]));
setup();
}

void init()
{
add_action("do_answer","answer");
}

int do_answer(string arg)
{
object npc,me = this_player();
npc = present("ren zhe");
if ( !npc || userp(npc) || npc->query("time") )
	{
	npc = new(__DIR__"npc/renzhe");
	npc->move(this_object());
	message_vision("黑暗中忽然跳出一个浑身漆黑的武者。\n",me);
	return 0;
	}	
if ( !me->query_temp("swordman/be_asked") )
	return 0;
message_vision("$N答道：",me);	
if ( arg=="1" || arg=="拜师" )
	{
	message_vision("来学艺的。\n",me);
	npc->command("nod");
	message_vision("$N一弯身又闪进黑暗中去。\n",npc);
	destruct(npc);
	me->delete_temp("swordman/be_asked");
	me->set_temp("renzhe/enter",1);
	return 1;
	}
else	{
	message_vision("来.....的。\n",me);	
	npc->command("pei");
	npc->copy_status(npc,me);
	npc->set_name("忍者",({"ren zhe"}));
	npc->delete("time");
	npc->set("title","伊贺忍者·下忍");
	npc->set("family/family_name","剑客联盟");
	npc->set("nickname",WHT"踏"HIW"雪"WHT"无痕"NOR);
	npc->set("master","auto_exert");
	SDS_D->powerup(npc);
	npc->save();
	npc->kill_ob(me);
	return 1;
	}
}

int valid_leave(object me,string dir)
{
object npc;
	
if ( dir=="down" )
	{
	if ( !me->query_temp("renzhe/enter") )
		{
		npc = present("ren zhe");
		if ( !npc || userp(npc) || npc->query("time") )
			{
			npc = new(__DIR__"npc/renzhe");
			npc->move(this_object());
			message_vision("黑暗中忽然跳出一个浑身漆黑的武者。\n",me);
			}		
		me->set_temp("swordman/be_asked",1);
		return notify_fail(CYN+npc->name()+"问道：做什么的？answer ( 1. 拜师 2. 路过 3. 迷路) \n"NOR);
		}
	return 1;
	}				
return ::valid_leave(me,dir);
}
	
	