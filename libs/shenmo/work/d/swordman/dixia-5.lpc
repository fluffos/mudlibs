#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "密室");
  set("long", @LONG

面前是一间简陋的石室，四周一片漆黑，勉强可以看到周身寸许
的情景。

LONG);
  setup();
}

void init() {
  add_action("do_none", "", 1);
}

int do_none() {
  object me = this_player();
  string verb = query_verb();
  if (verb == "look" || verb == "hp")
    return 0;
  write(HIY "专心接受考验吧！\n" NOR);
  return 1;
}
