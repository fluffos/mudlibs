#include <ansi.h>
inherit NPC;
inherit F_MASTER;

string ask_baishi();
string ask_fenshen();
string ask_escape();
int want_test(object);

mapping actions = ([
	"火"	:	([
			"action"	:
"$n尚在疑惑之际，只见一团熊熊烈火从上而降，仿佛千万火鸦般窜向$p$l",
			"damage_type"	:	"刺伤",
			"weapon"	:	"火焰",			
			"damage"	:	100,
			]),
						
	"木"	:	([
			"action"	:
"$n尚在疑惑之际，只见一根硕大横木从天而降，带着风雷之声砸向$p$l",
			"damage_type"	:	"砸伤",
			"weapon"	:	"横木",			
			"damage"	:	80,
			]),
		
	"水"	:	([
			"action"	:
"$n尚在疑惑之际，只见一道水柱从墙壁内射出，仿佛水龙般刺向$p$l",
			"damage_type"	:	"刺伤",
			"weapon"	:	"水柱",			
			"damage"	:	70,
			]),
	
	"金"	:	([
			"action"	:
"$n尚在疑惑之际，只见一排短矢仿佛毒蚊般朝着$p$l飞去",
			"damage_type"	:	"刺伤",
			"weapon"	:	"短矢",			
			"damage"	:	90,
			]),
	"土"	:	([
			"action"	:
"$n尚在疑惑之际，只见脚下泥土翻扬，仿若土龙翻身一般，甚是吓人",
			"damage_type"	:	"内伤",
			"weapon"	:	"土龙",						
			"damage"	:	60,
			]),
]);
	
void create()
{
object obj;	
set_name("服部半藏",({"master banzang","fubu banzang","banzang","master"}));
set("long","伊贺忍者首领，将伊贺忍术发扬光大，据说是入扶桑的秦人后裔。\n");
set("gender","男性");
set("age",50+random(150));
set("str",40);
set("per",40);
set("combat_exp",5000000);
set("attitude", "friendly");

set_skill("literate",300);
set_skill("dodge",350);
set_skill("fengyu-piaoxiang",345);
map_skill("dodge","fengyu-piaoxiang");

set("class","human");
create_family("伊贺忍者",2,"上忍");
set("family/family_name","剑客联盟");
set("master","auto_cast");

set_skill("force",300);
set_skill("guixi-force",300);
map_skill("force","guixi-force");

set_skill("unarmed",200);
set_skill("kongshoudao",200);
map_skill("unarmed","kongshoudao");

set_skill("spells",320);
set_skill("renshu",360);
map_skill("spells","renshu");

set_skill("sword",350);
set_skill("renzhe-jian",350);
set_skill("parry",345);
map_skill("parry","renzhe-jian");
map_skill("sword","renzhe-jian");

set("chat_chance",2);
set("chat_msg", ({
	CYN"半藏说道：忍者就是影子，家主就是光，失去了家主的忍者就等于失去了光。\n"NOR,
	CYN"半藏说道：忍者考验的是他的心。\n"NOR,	
	CYN"半藏说道：没有意志的人不配做忍者。\n"NOR,	
}));
set("inquiry", ([
	"拜师"	:	(: ask_baishi :),
	"分身术":	(: ask_fenshen :),
	"逃遁术":	(: ask_escape :),
]) );
setup();
obj = new("/d/city/npc/obj/sword");
obj->set_name("忍者剑",({"renzhe jian","jian","sword"}));
obj->move(this_object());
obj->wield();
obj = new("/d/city/npc/obj/armor");
obj->set_weight(1000);
obj->set_name("忍者服",({"renzhe cloth","cloth","armor"}));
obj->move(this_object());
obj->wear();
}

void attempt_apprentice(object ob)
{
if ( ob->query("swordman/out_renzhe") )
	{
	command("say "+	RANK_D->query_respect(ob) +"与我等无缘，还是算了。\n");	
	return;
	}
if ( ob->query("combat_exp")<500000 
  || ob->query_skill("dodge",1)<100 )
	{
	command("say " + RANK_D->query_respect(ob) +"还是先打好基础再来。\n");
	return;
	}
if ( !ob->query_temp("renzhe_kaoyan") )
	{
	command("say " + RANK_D->query_respect(ob) +"还是先通过了忍者考验再来吧。\n");
	return;
	}
		
command("say 好，希望" + RANK_D->query_respect(ob) +"将我伊贺流发扬光大。\n");
command("recruit " + ob->query("id") );
ob->create_family(HIC"伊贺忍者"NOR,3,"下忍");
ob->set("family",([
	"family_name"	:	"剑客联盟",
	"master_name"	:	name(),
	"master_id"	:	query("id"),
	"title"		:	"下忍",
	"generation" 	:	3,
	"enter_time"	:	time(),
])); 
ob->set("class", "human");
return;
}

string ask_baishi()
{
object me = this_player();
if ( me->query("family/family_name")!="剑客联盟" )
	return "伊贺忍术一向是不外传的。";

if ( me->query("swordman/out_renzhe") )
	return RANK_D->query_respect(me) +"与我等无缘，还是算了。";	

if ( me->query("family/master_name")==name() )
	return "你不是已拜入我门下了吗？";

me->delete_temp("renshu");	
me->set_temp("renshu/asked_baishi",1);
return "忍术需要的是坚强的毅力，你可愿意接受忍者考验？( yes / no )";
}

string ask_fenshen()
{
object me = this_player();
if ( me->query("family/master_name")!=name() )
	return "伊贺忍术一向是不外传的。";
if ( me->query("swordman/out_renzhe") )
	return RANK_D->query_respect(me) +"与我等无缘，还是算了。";	
if ( me->query("swordman/renshu_ask_fenshen") )
	return "你不是已经学会了吗？";
	
me->delete_temp("renshu");	
me->set_temp("renshu/asked_fenshen",1);
return "忍术需要的是坚强的毅力，你可愿意接受忍者考验？( yes / no )";
}			

string ask_escape()
{
object me = this_player();
if ( me->query("family/master_name")!=name() )
	return "伊贺忍术一向是不外传的。";
if ( me->query("swordman/out_renzhe") )
	return RANK_D->query_respect(me) +"与我等无缘，还是算了。";	
if ( me->query("swordman/learn_renshu") )
	return "你不是已经学会了吗？";
	
me->delete_temp("renshu");	
me->set_temp("renshu/asked_escape",1);
return "忍术需要的是坚强的毅力，你可愿意接受忍者考验？( yes / no )";
}			

void init()
{
add_action("do_yes","yes");
add_action("do_no","no");
}

int do_yes()
{
object me = this_player();
if ( !me->query_temp("renshu/asked_escape")
  && !me->query_temp("renshu/asked_fenshen")		
  && !me->query_temp("renshu/asked_baishi") )
	return 0;
message_vision(CYN"$N"CYN"道：我愿意接受考验。\n"NOR,me);
return want_test(me);
}

int do_no()
{
string dodge_skill;
object me = this_player();
if ( !me->query_temp("renshu/asked_escape")
  && !me->query_temp("renshu/asked_fenshen")		
  && !me->query_temp("renshu/asked_baishi") )
	return 0;
message_vision(CYN"$N"CYN"道：我考虑考虑....\n"NOR,me);	
command("sigh");
command("say 看来阁下与我辈无缘，你且去吧。。。\n");
message_vision("$n摆一摆手，过来几个蒙面黑衣人将$N带出洞去。\n"NOR,me,this_object());
me->delete_temp("renshu");
dodge_skill = me->query_skill_mapped("dodge");
if ( dodge_skill )
	{
	me->command("enable dodge none");
	me->set_temp("enable_dodge",dodge_skill);
	}
me->set("swordman/out_renzhe",1);
me->move("/d/swordman/dalu10");
message_vision("几个蒙面模样的武者将$N带到洞口，径自去了。\n",me);
me->start_busy(1+random(3));
return 1;
}

int want_test(object me)
{
int kee,time=0;	
object room;	
string type,*room_type = ({"金","木","水","火","土",});

if ( !me )
	return 0;
room = clone_object("/d/swordman/dixia-5");
if ( !room )
	return 0;
type = room_type[random(sizeof(room_type))];
if ( !(string)type )
	return 0;	
tell_object(me,CYN"半藏说道：且让你去那"+type+"室内忍耐一番。\n"NOR);
tell_object(me,"说罢过来几个下忍将你带到一间房间。\n");	
room->set("short",type+"室");
kee = me->query("kee");
me->move(room);
call_out("testing",0,me,room,kee,time,type);
return 1;
}

void testing(object me,object room,int kee,int time,string type)
{
int my_kee;	
mapping action;
object act;
remove_call_out("testing");	
if ( !me || !room || !this_object() )
	return;
if ( !present(me,room) )
	return;
act = new(__FILE__);
action = actions[type];
act->set_name(action["weapon"],({"Snowtu"}));
act->set("actions",action);
COMBAT_D->do_attack(act,me);
destruct(act);
time++;
if ( time>=10 || !living(me) )
	{
	me->move(environment());	
	destruct(room);
	my_kee = me->query("kee");
	if ( random(my_kee)<kee/3 || !living(me) )
		{
		command("sigh");
		command("say 看来你意志不够，你且去吧。\n");
		me->delete_temp("renshu");
		me->move("/d/swordman/dalu10");
		message_vision("几个蒙面模样的武者将$N带到洞口，径自去了。\n",me);
		return;
		}
	else	{
		command("smile");
		if ( me->query_temp("renshu/asked_fenshen") )
			{
			me->set("swordman/renshu_ask_fenshen",1);
			command("say 所谓分身，其实不过是利用自身的真元幻化出的残影。\n");
			}
		if ( me->query_temp("renshu/asked_escape") )
			{
			me->set("swordman/learn_renshu",1);
			command("say 所谓逃遁术其实乃是从五行遁法演化而来。\n");
			}
		if ( me->query_temp("renshu/asked_baishi") )
			{
			me->set_temp("renzhe_kaoyan",1);
			command("say 不错不错，看来你适合学伊贺忍术。\n");
			}
		return;
		}
	}
else	call_out("testing",3+random(5),me,room,kee,time,type);
}					
