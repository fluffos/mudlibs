#include <ansi.h>
 
inherit ROOM;

string do_look();
string look_statue();

void create ()
{
set ("short", "青石街道");
set ("long", @LONG

拥挤的东瀛街道，道路由青色小石铺成。人声鼎沸，街景秀丽，令人
目不暇己。两边有不少行人来回匆匆走过。
路旁是一座破旧的土地庙(shrine)。

LONG);

set("item_desc",([
	"shrine"	:	(:do_look:),
	"temple"	:	(:do_look:),
	"庙"		:	(:do_look:),
	"statue"	:	(:look_statue:),
	"神像"	:	(:look_statue:),
]));
set("exits", ([
	"south"    : __DIR__"xiaolu1",
	"west"    : __DIR__"dalu9",
//	"east":__DIR__"jingshiting",
]));
set("outdoors",__DIR__"");
set("objects", ([
	__DIR__"npc/people"    : 2,
]));
setup();
}

string do_look()
{
object me = this_player();	
string msg = "一座乡间常见的小庙，年久失修，破落不堪。\n";
if ( me->query("family/family_name")=="剑客联盟"
  && (me->query("family/master_name")==HIY"明神弥彦"NOR || me->query("family/master_name")=="服部半藏" )  )
  	{
  	msg+= "但见庙中那破旧的神像(statue)似乎有些古怪。\n";
  	me->set_temp("swordman/look_temple_ok",1);
	} 	
return msg;
}

string look_statue()
{
string msg;
object me = this_player();	
if ( !me->query_temp("swordman/look_temple_ok") )	
	msg = "你要看什么？\n";
else	{
	msg = "一尊古老破旧的土地神像，看似有些古怪，不如推(push)推看看....\n";
	me->set_temp("swordman/look_statue_ok",1);	
	me->delete_temp("swordman/look_temple_ok");
	}
return msg;
}

void init()
{
add_action("do_push","push");
}

int do_push(string arg)
{
object me = this_player();
if ( !me->query_temp("swordman/look_statue_ok") )
	return 0;
if ( !arg || arg!="statue" )
	return 0;
message_vision("$N将神像左搬右搬，但听“喀哒”一声，神像下落出一阶阶梯，直通地下。\n",me);
set("exits/down",__DIR__"dixia-1");
me->delete_temp("swordman/look_statue_ok");
me->set_temp("swordman/open_down_door",1);
return 1;
}
	
int valid_leave(object me,string dir)
{
if ( dir=="down" )
	{
	call_out("dele_exit",3+random(5));	
	if ( !me->query_temp("swordman/open_down_door") )
		return notify_fail("里面太黑，还是算了吧。\n");
	me->delete_temp("swordman/open_down_door");
	return 1;
	}
return ::valid_leave(me,dir);
}	

void dele_exit()
{
if ( query("exits/down") )
	delete("exits/down");		
}	
