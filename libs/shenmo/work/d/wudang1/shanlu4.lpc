#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "山路");
  set("long", @LONG
你走在登山的路径上，路的左右各有一条大铁链，象两条长蛇向山上山
下蜿蜒爬去。满眼是乔木夹道，如行于绿幕中。
LONG);
  set("exits", ([ /* sizeof() == 1 */
    "northdown": __DIR__ "shijie1",
    "southup": __DIR__ "taiziyan",
  ]));
  set("objects", ([
    __DIR__ "npc/xi": 1,
  ]));

  set("outdoors", "wudang");
  set("no_clean_up", 0);
  setup();
}

int valid_leave(object me, string dir) {
  if (me->query("family/family_name") != "武当派"
    && dir == "southup"
    && objectp(present("zhang songxi", environment(me))))
    return notify_fail(CYN "张松溪拦住你说：你非武当弟子"
      "，还是请止步吧。\n" NOR);
  return ::valid_leave(me, dir);
}
