inherit NPC;
inherit F_MASTER;
#include <ansi.h>
void create()
{
       set_name("张三丰", ({"zhang sanfeng","zhang", "master"}));
       set("long", "他就是武当派开山鼻祖、当今武林的泰山北斗张
三丰真人。只见他身着一身污秽的灰色道袍，不
修边幅。身材高大，年满百岁，满脸红光，须眉
皆白。\n");
       set("title", HIW"太极真人"NOR);
       set("gender", "男性");
       set("age", 100);
        set("class", "saint");
       set("attitude", "friendly");
       set("rank_info/respect", "邋遢道人");
       set("shen_type", 1);
       set("per", 30);
        set("int", 39);
       set("max_kee", 100000);
       set("max_gin", 10000);
       set("max_sen", 100000);
       set("force", 16000);
       set("max_force", 10000);
       set("force_factor", 350);
       set("max_mana", 10000);
       set("mana", 15000);
       set("mana_factor", 250);
       set("combat_exp", 400000000);
        set("daoxing", 400000000);

       set_skill("literate", 500);
       set_skill("unarmed", 500);
       set_skill("dodge", 500);
       set_skill("parry", 500);
        set_skill("sword", 500);
        set_skill("spells", 500);
        set_skill("taixu-spells", 500);
        set_skill("taiji-quan", 500);
        set_skill("taiji-shengong", 500);
        set_skill("force", 500);
        set_skill("shenmen-jian", 500);
        set_skill("taiji-jian", 500);
        set_skill("liangyi-jian", 500);
        set_skill("tiyunzong", 500);
        map_skill("spells", "taixu-spells");
        map_skill("unarmed", "taiji-quan");
        map_skill("force", "taiji-shengong");
        map_skill("sword", "taiji-jian");
        map_skill("parry", "taiji-jian");
        map_skill("dodge", "tiyunzong");
        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: perform_action, "sword", "chan" :),
                (: perform_action, "sword", "lian" :),
                (: perform_action, "sword", "sui" :),
                (: perform_action, "sword", "zhenwu" :),
                (: perform_action, "unarmed", "nian" :),
                (: perform_action, "unarmed", "ji" :),
                (: perform_action, "unarmed", "zhen" :),
                (: perform_action, "unarmed", "yin" :),
        }) );

create_family("武当派", 1, "蓝");
setup();

        carry_object("/d/wudang/obj/greyrobe")->wear();
        carry_object("/d/wudang/obj/zhenwu")->wield();
}

void attempt_apprentice(object ob)
{
 if (ob->query("family/family_name")!="武当派" || ob->query("class")!="saint") 
        {
        command("say 你是何人？"); 
        return; 
        }
if (((int)ob->query("combat_exp") < 10000000 )) {
command("say " + RANK_D->query_respect(ob) +
"的经验不够，有些绝学秘法恐怕难以领悟。\n");
   return;
   }
if (((int)ob->query("daoxing") < 10000000 )) {
command("say " + RANK_D->query_respect(ob) +
"的道行不够高深，有些绝学秘法恐怕难以领悟。\n");
   return;
   }
if( (int)ob->query_skill("taiji-shengong",1) < 300)
{
command("say 你还须在太极神功上面多下功夫啊！");
return;
}
  command("say 好！好！好！我收下你了。以后要好好努力，光大我武当一派！\n");
  command("recruit " + ob->query("id") );
return ;
}

int recruit_apprentice(object ob)
{
if( ::recruit_apprentice(ob) ) {
ob->set("title", HIW"太极传人"NOR);
}
}

int accept_fight(object me, object ob)
{	ob=this_player();
	command("say " + RANK_D->query_rude(ob) + "杀心太重，恐祸不久已！\n");
	return 0;
}
