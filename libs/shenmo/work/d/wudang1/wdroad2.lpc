inherit ROOM;

void create() {
  set("short", "青石大道");
  set("long", @LONG
你走在一条青石大道上，北边隐约可见到开封城的南城墙。
此处往东南望去，隐约看到一大片树林。
LONG);
  set("outdoors", "wudang");
  set("exits", ([
    "south": __DIR__ "wdroad3",
    "north": __DIR__ "wdroad1",
  ]));
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
