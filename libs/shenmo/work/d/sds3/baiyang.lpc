//白羊座·穆先生

#include <ansi.h>

inherit ROOM;
int block_cmd(string);
void create ()
{
set ("short", HIY"第一宫"NOR+"："+HIW"白羊宫"NOR);
set ("long", HIW+@LONG

    特寒里亚国王阿塔玛斯和王妃涅佩拉结婚，两人生了一对双胞胎，但国王却和特
贝的公主伊诺娃有段婚外情，将涅佩拉王妃赶出宫，而迎立诺娃为新妃。当伊诺娃王
妃有了自己的孩子后，乃决定要杀死前涅佩拉王妃所留下的唯一双胞胎，(哥哥是普里
克思，妹妹是赫雷)。她收买占卜师向国王告状：若不将前王妃所生的孩子送给宙斯当
祭品，众神将大怒，则今年将闹饥荒。涅佩拉知道后就向宙斯求救，于是宙斯就派天
上的黄金牡羊去载这两兄妹至天空彼方。因速度太快，妹妹跌落大海，牡羊就一边回
头看妹妹，一边守护着哥哥，而形成现今的牡羊座。

LONG+NOR);


set("exits", ([
	"northup"  : __DIR__"by2jn1",
	"eastdown" : __DIR__"toby2",
]));

set("objects", ([ 
	__DIR__"npc/baiyang" : 1,
]));

setup();
message("channel:chat",WHT"\n【"HIG" 圣域 "NOR WHT"】"NOR HIC"穆(Mu)：不祥的阴影笼罩着圣域......\n"NOR,users());
}

void init()
{
add_action("do_none","move");
add_action("do_none","mark");
add_action("do_none","cast");
add_action("do_none","ji");
add_action("do_none","steal");
add_action("do_none","recall");
}

int do_none()
{
object me = this_player();
message_vision("穆先生对$N摇了摇头。\n",me);
return 1;
}

int valid_leave(object me, string dir)
{
if ( me->query("sds2/cloth") != "done" && dir == "northup" )  //即未过死亡岛
		return notify_fail("先去死亡岛夺回圣衣吧！\n");
		  
if (me->query("sds3/baiyang") != "done")
	{
	if ( me->query_temp("sds3/rm_give") != "done" && dir == "northup" )  //未交还人马圣衣
		return notify_fail("穆先生微微一笑说道: 先交还人马座圣衣吧。\n");
	}
return ::valid_leave(me, dir);
}
