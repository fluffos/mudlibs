#include <ansi.h>

inherit ROOM;
int block_cmd(string);

void create ()
{
        set ("short", HIY"教皇厅"NOR);
        set ("long", @LONG

    圣域最高统治者：教 皇 的议会大厅，四周粗壮的大理石柱子高不见顶，
大厅里帷幕重重，正中上方高大的座椅上坐着的真是现任教皇。
    整个大厅常年不见天日，四角的高脚落地蜡烛映衬的整个大厅越加的
庄严，教皇坐在上方冷冷的看着你。

LONG);

        set("exits", ([
            "up"    :       __DIR__"palace",
            "down"  :       __DIR__"topalace2",
        ]));

        set("objects", 
        ([ //sizeof() == 1
                __DIR__"npc/king" : 1,
        ]));

        setup();
}


int valid_leave(object me, string dir)
{
        if ( (present("alith")||me->query("sds3/king")!="done") && dir == "up" )
        return notify_fail("亚历士教皇冷冷的看着你！\n");
        return ::valid_leave(me, dir);
}


void init()
{
    add_action("block_cmd", "", 1);
}

int block_cmd(string args)
{
string verb;
verb = query_verb();
    if (verb=="recall"||verb=="fly"||verb=="cast") return 1;
    return 0;
}
