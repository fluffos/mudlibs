#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
set("short", HIR"血池地狱"NOR);
set("long", @LONG
阴风指背，摄人鬼嚎，映入眼中的是遍地的血红和骨骸，在
正中有一个巨大的池子，里面存放的，霍然是鲜红的血液！！
在这里，你不由得从心底冒出压制不住的恐惧。
LONG
);
set("no_clean_up",1);
setup();
}

void init()
{ 
object ob = this_player();
call_out("blowing",5+random(5),ob);
call_out("check",5+random(5),ob);
}

void blowing(object ob)
{
if(  !ob || environment(ob)!=this_object() )
        return;

if ( ob->query_temp("xcdy") ) return;
if ( random(2)==1 )
        {
        tell_object(ob,HIB"\n\n突然从地下冒出数双只剩骨头的手，紧紧的抓住你的双腿！！你好不容易才挣脱开来。\n\n" NOR);
        message("vision",HIB"\n\n突然从地下冒出数双只剩骨头的手，紧紧的抓住"+ob->name()+HIB"的双腿！！\n\n"NOR,this_object(),ob);
        ob->start_busy(1);
        } 
else    {
        tell_object(ob,HIR"\n\n你忽然觉得伤口处血流不止，淌下的鲜血都自动被那巨大的血池吸纳过去。\n\n"NOR);
        message("vision",HIR"\n\n"+ob->name()+"伤口处血流不止，淌下的鲜血都被那巨大的血池自动吸纳过去。\n\n"NOR,this_object(),ob);
        ob->receive_damage("kee",250+random(250));
        }
remove_call_out("blowing");
call_out("blowing",random(10)+1,ob);
}


int valid_leave(object me, string dir)
{
remove_call_out("blowing");
return 1;
}

void check(object ob)
{
int i,flag = 0;
object where,env,*inv;
if( !ob )  return;
env = this_object();
inv = all_inventory(ob);

if ( !ob || !present(ob,env) )
        return;

for ( i=0;i<sizeof(inv);i++ )
        {
        if ( inv[i]!=ob && living(inv[i]) )
                flag++;
        }
if ( flag>0 )
        {
        remove_call_out("check");
        call_out("check",1,ob);
        }
else    {
        where = ob->query_temp("xcdy_room");
        if ( !where )
                where=new("/d/sds3/shinu");
        tell_object(ob,HIY"轰的一声巨响，你眼前的幻象消失怠尽。\n"NOR);
        if ( ob->query_temp("xcdy_room") )
                ob->delete_temp("xcdy_room");
        if ( ob->query_temp("xcdy") )
                ob->delete_temp("xcdy");
        ob->move(where);
        }
return;
}

