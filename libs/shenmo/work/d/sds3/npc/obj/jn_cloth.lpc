#include <armor.h>
#include <ansi.h> 
inherit ARMOR;
#include "chk_player.h"

void create()
{
   set_name(HIY"金牛座黄金圣衣"NOR, ({ "jinniu shengyi" }) );
   set_weight(3000);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("unit", "件");
     set("material", "gold");
     set("armor_prop/armor",170);
   }
   setup();
}
