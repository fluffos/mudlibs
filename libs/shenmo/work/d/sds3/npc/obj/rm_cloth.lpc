// by happ@YSZZ
#include <ansi.h>
#include <armor.h>

inherit ARMOR;

void create()
{
set_name(HIC"人马座"HIY"黄金圣衣"NOR, ({ "renma shengyi" }) );
set_weight(3000);
if( clonep() )
	set_default_object(__FILE__);
else {
	set("unit", "件");
	set("material", "steel");
	set("armor_prop/armor",360);
	set("no_get","这件黄金圣衣不属于你!\n");
	}
setup();
}

void init()
{
object me = this_player();
//::init();
if(userp(me))
	{
	message_vision(HIY"眼前这你刚刚脱下的"NOR+HIC"人马座"HIY"黄金圣衣竟然自动拉紧了弦上的黄金箭，只见阳光突然变强，照得人睁不开眼！\n"NOR,me);
	call_out("greeting",5, me);
	}
}

int greeting(object me)
{
if ( me->query("sds3/number")<8 )
	{
	message_vision(HIY"\n黄金箭缓缓指向了你,突然离弦射出!!!\n",me);
	message_vision(HIY"你反应不及,被黄金箭穿胸而过.对面的射手座黄金圣衣也随即消失了!\n"NOR,me);
	me->die();
	}
if ( me->query("sds3/renma")!="done" )
	{
	if ( random( me->query_kar() )<20 )
		{
		message_vision(HIY"\n黄金箭缓缓指向了你,突然离弦射出!!!\n",me);
		message_vision(HIY"你反应不及,被黄金箭穿胸而过.对面的人马座黄金圣衣也随即消失了!\n"NOR,me);
		me->receive_wound("kee",me->query("max_kee")/2+random(me->query("max_kee")/2)-me->query("max_kee")/10);
		COMBAT_D->report_status(me);
		me->set("sds3/renma","done");
		me->add("sds3/number",1);
		destruct(this_object());   
		}
	else
		{
              message_vision(HIY"\n\n黄金箭缓缓转向了通往山羊宫的路口.\n"NOR,me);
              message_vision(HIY"突然,黄金箭就像有人控制一样离弦而出,带着一股强大的小宇宙穿过了封锁通向山羊宫的屏障\n"NOR,me);
		me->set("sds3/renma","done");
		me->add("sds3/number",1);
		destruct(this_object());   
		}
	}
else      {
	message_vision(HIY"黄金箭就像有人控制一样离弦而出,对面的人马座黄金圣衣也随即消失了!\n"NOR,me);
	destruct(this_object());   
	}
me->start_busy(3);
message("chat",HIY+"\n【黄道十二宫】艾俄罗斯(Aiolos):人马座将永远守护女神-雅典娜!\n"NOR,users());
}
