#include <ansi.h>
#include <armor.h>
#include "chk_player.h"

inherit ARMOR;

void create()
{
   set_name(HIC"水瓶座"HIY"黄金圣衣"NOR, ({ "shuiping shengyi" }) );
   set_weight(3000);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("unit", "件");
     set("material", "steel");
     set("armor_prop/armor",180);
   }
   setup();
}
