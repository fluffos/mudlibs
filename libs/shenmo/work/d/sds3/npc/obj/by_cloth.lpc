#include <armor.h>
#include <ansi.h>
#include "chk_player.h"
inherit ARMOR;

void create() {
  set_name(HIW "白羊座" NOR + HIY "黄金圣衣" NOR, ({ "baiyang shengyi" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "steel");
    set("armor_prop/armor", 190);
  }
  setup();
}
