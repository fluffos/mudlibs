//知道教皇的真正身份，但是却相信『力量就是正义』的信念，因而对教皇十分忠心。
//他是个杀人王，很多人曾死於他的手上，所以巨蟹宫内满布死人的颜面。 

inherit NPC;
#include <ansi.h>
#include "star.h"

void create() {
  set_name("迪斯马斯克", ({ "death mask", "mask", "ju xie" }));
  set("long", HIB "巨蟹座黄金圣斗士。最卑鄙无耻的黄金圣斗士，杀人无数。曾刺杀
童虎不成，并和紫龙结怨，最后在自己制造的集尸气冥界波中被紫龙打败。但在冥界之战
中仍为雅典娜献身。\n" NOR);
  set("gender", "男性");
  set("title", HIB "巨蟹宫" NOR + HIY "黄金圣斗士" NOR);
  set("age", 37);
  set("con", 30);
  set("spi", 40);
  set("per", 30);
  set("str", 25);
  set("int", 35);
  set("combat_exp", 8000000);
  set("daoxing", 8000000);
  set("chat_chance", 2);
  set("chat_msg", ({
    "迪斯马斯克说道：好久没杀逆民了！\n"
  }));

  set_skill("dodge", 330);
  set_skill("force", 330);
  set_skill("parry", 330);
  set_skill("unarmed", 330);
  set_skill("shengdou", 330);
  set_skill("stars-steps", 330);
  set_skill("moonforce", 330);
  set_skill("moonshentong", 330);
  map_skill("parry", "shengdou");
  map_skill("dodge", "stars-steps");
  map_skill("unarmed", "shengdou");
  map_skill("spells", "moonshentong");
  map_skill("force", "moonforce");

  set("max_force", 5000);
  set("force", 10000);
  set("max_mana", 5000);
  set("mana", 10000);
  set("mana_factor", 110);
  set("force_factor", 110);
  set("max_kee", 10000);
  set("max_gin", 10000);
  set("max_sen", 10000);

  setup();
  carry_object(__DIR__ "obj/jx_cloth")->wear();
}

void kill_ob(object me) {
  object ob = this_object();

  if (!present(me, environment())) {
    me->remove_killer(ob);
    ob->remove_killer(me);
    powerup();
    return;
  }

  if (me->is_ghost() || !userp(me)) {
    me->remove_killer(ob);
    ob->remove_killer(me);
    powerup();
    return;
  }

  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed", "jsqmjb" :),
    (: powerup() :),
  }));
  ::kill_ob(me);
}

void init() {
  string str;
  object me = this_player();
  object ob = this_object();
  if (me->query("gender") == "女性")
    str = "老娘";
  else
    str = "老子";

  ::init();

  command("say 妈的，谁这么大胆，敢进我的巨蟹宫？！！\n");
  message_vision(CYN "$N" CYN "把眼一瞪，叫道：" + str + CYN "就闯，咋地？\n" NOR, me, ob);

  if (me->query("sds3/juxie") == "done") {
    command("inn");
    message_vision(CYN "$n" CYN "朝$N" CYN "作了个揖，尴尬的走开了。\n" NOR, me, ob);
    destruct(ob);
  } else {
    command("pai " + me->query("id"));
    kill_ob(me);
  }
}

void die() {
  object me = this_object();
  object ob = me->query_temp("last_damage_from");
  powerup();
  if (!ob || !present(ob, environment())) return;
  me->remove_killer(ob);
  ob->remove_killer(me);

  if (ob->query("sds3/shuangzi") == "done" && ob->query("sds3/juxie") != "done") {
    ob->start_busy(3);
    message(
      "chat",
      HIY + "【黄道十二宫】雅典娜(Athena):" + HIW + ob->name() + HIY "闯过了第四宫巨蟹座，继续向圣域前进。\n" NOR,
      users()
    );
    ob->set("sds3/juxie", "done");
    ob->add("sds3/number", 1);
    ob->add("daoxing", 40000);
    tell_object(ob, "你赢得了四十年道行");
  }
  message("chat", HIM "\n\n随着迪斯马斯克的死亡, 那些无数被他杀害的亡魂渐渐离开了巨蟹宫.\n" NOR, users());
  destruct(this_object());
}
