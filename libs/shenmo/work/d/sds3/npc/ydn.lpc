
inherit NPC;

#include <ansi.h>
int check_legal_name(string name, int max_len);
void get_name(string arg, object ob);

void create()
{
set_name(HIM"雅典娜"NOR, ({ "athena", "na" }));
set("title", HIY"女 神"NOR);
set("long", @LONG
圣域的守护神，转世为城户沙织。
LONG);
set("gender", "女性");
set("age", 16);
set("attitude", "peaceful");
set("per",39);
set("max_kee", 12000);
set("max_gin", 14000);
set("max_sen", 12000);
set("force", 12000);
set("max_force", 24000);
set("force_factor", 500);
set("max_mana", 14000);
set("mana", 28000);
set("mana_factor", 600);
set("combat_exp", 20000000);
set("daoxing", 20000000);
set_skill("spells", 900);
set_skill("buddhism", 900);
set_skill("unarmed", 900);
set_skill("jienan-zhi", 900);
set_skill("dodge", 900);
set_skill("lotusmove", 900);
set_skill("parry", 900);
set_skill("force", 900);
set_skill("lotusforce", 900);
set_skill("staff", 900);
set_skill("lunhui-zhang", 900);
map_skill("spells", "buddhism");
map_skill("unarmed", "jienan-zhi");
map_skill("dodge", "lotusmove");
map_skill("force", "lotusforce");
map_skill("parry", "lunhui-zhang");
map_skill("staff", "lunhui-zhang");
set("no_get","在雅典娜的神殿里,你怎敢对女神不敬?\n");
set("chat_chance_combat", 9);
setup();
carry_object("/d/12gong/obj/armor")->wear();
carry_object("/d/12gong/obj/cloth")->wear();
carry_object("/d/12gong/obj/pifeng")->wear();
carry_object("/d/12gong/obj/shield")->wear();
carry_object("/d/12gong/obj/staff")->wield();
}

void init()
{
object ob = this_object();
object me = this_player();
object cloth;
if( me->query("sds3/number") >= 12 
&& !me->query("sds3/all") 
&&  me->query("sds3/king")=="done" )
	{
        tell_object(me,HIY"恭喜！终于进金黄金宝殿了，接受女神的赏赐吧！\n"NOR);
	write("为了奖励你，特给你一个守护星，请输入你的守护星的名字：(可以加颜色)\n");
	input_to( (: get_name :), me );
	}
if ( (int)me->query("sds3/all") )
	{
        message("chat",HIY+"【黄道十二宫】雅典娜(Athena):欢迎"+me->query("cloth_name")+HIW"座"NOR+HIY"黄金圣斗士"NOR+HIW+me->query("name")+HIY"再次来到圣域！\n"NOR,users()); 
	me->set("title",me->query("cloth_name")+HIW"座"NOR+HIY"黄金圣斗士"NOR);
	}
}


int check_legal_name(string name, int max_len)
{
int i;
string   *legalname;     //not implemented..may add later
i = strlen(name);
if( (strlen(name) < 2) || (strlen(name) > max_len ) ) 
	{
	write( sprintf("对不起，守护星名必须是 1 到 %d 个中文字。\n",max_len/2) );
	return 0;
	}
while(i--)   
	{
	if( name[i]<=' ' )   
		{
		write("对不起，守护星名不能用控制字元。\n");
		return 0;
		}
	if( i%2==0 && !is_chinese(name[i..<0]) )  
		{
		write("对不起，请您用「中文」给您的守护星取名字。\n");
		return 0;
		}
	}
return 1; 
}

void get_name(string arg, object ob)
{
int wx,dx,pot;
string  arg_old;
object cloth;
arg += "$NOR$";
arg_old = arg;
arg = replace_string(arg, "$BLK$", "");
arg = replace_string(arg, "$RED$", "");
arg = replace_string(arg, "$GRN$", "");
arg = replace_string(arg, "$YEL$", "");
arg = replace_string(arg, "$BLU$", "");
arg = replace_string(arg, "$MAG$", "");
arg = replace_string(arg, "$CYN$", "");
arg = replace_string(arg, "$WHT$", "");
arg = replace_string(arg, "$HIR$", "");
arg = replace_string(arg, "$HIG$", "");
arg = replace_string(arg, "$HIY$", "");
arg = replace_string(arg, "$HIB$", "");
arg = replace_string(arg, "$HIM$", "");
arg = replace_string(arg, "$HIC$", "");
arg = replace_string(arg, "$HIW$", "");
arg = replace_string(arg, "$NOR$", "");

if( !check_legal_name(arg, 12) )  
	{
	write("请输入你的守护星的名字：(可以加颜色)\n");
	input_to( (: get_name :), ob);
	return;
	}

arg = arg_old;
arg = replace_string(arg, "$BLK$", BLK);
arg = replace_string(arg, "$RED$", RED);
arg = replace_string(arg, "$GRN$", GRN);
arg = replace_string(arg, "$YEL$", YEL);
arg = replace_string(arg, "$BLU$", BLU);
arg = replace_string(arg, "$MAG$", MAG);
arg = replace_string(arg, "$CYN$", CYN);
arg = replace_string(arg, "$WHT$", WHT);
arg = replace_string(arg, "$HIR$", HIR);
arg = replace_string(arg, "$HIG$", HIG);
arg = replace_string(arg, "$HIY$", HIY);
arg = replace_string(arg, "$HIB$", HIB);
arg = replace_string(arg, "$HIM$", HIM);
arg = replace_string(arg, "$HIC$", HIC);
arg = replace_string(arg, "$HIW$", HIW);
arg = replace_string(arg, "$NOR$", NOR);

ob->set("sds3/all",1);
cloth= new("/obj/gold_cloth");                 
cloth->set("owner_id",ob->query("id")); 
        {
        cloth->set("name",arg+HIW"座"NOR+HIY"黄金圣衣"NOR);
        cloth->set_weight(8000);
        cloth->set("armor_prop",([
                "strength"      : 1,
                "courage"       : 1,
                "intelligence"  : 1,
                "spirituality"  : 1,
                "composure"     : 1,
                "personality"   : 1,
                "constitution"  : 1,
                "karma"         : 1,
        
                "armor"         : 60,
                "spells"        : 1,
                "dodge"         : 1,
                "parry"         : 1,
                "force"         : 1,
        ]));
cloth->set("shield_time",60*60*24);
        cloth->set("level",1); 
              cloth->save();  
              cloth->move( ob );
      } 
wx = 18000+random(15000);
pot= 8000+random(15000);
dx = 18000+random(15000);
ob->add("daoxing",dx);
ob->add("potential",pot);
ob->add("combat_exp",wx);
tell_object(ob,HIY"\n你得到了"+COMBAT_D->chinese_number(dx)+"道行，"+pot+"点潜能，"+wx+"点武学，"NOR+cloth->query("name")+HIY"一件！\n"NOR);
message("chat",HIY+"【黄道十二宫】雅典娜(Athena):"+HIW+ob->name()+HIC"历尽磨难，特命名其为："NOR+arg+HIW"座"NOR+HIY"黄金圣斗士"NOR+HIC"！\n"NOR,users()); 
ob->set("title",arg+HIW"座"NOR+HIY"黄金圣斗士"NOR);
ob->set("cloth_name",arg);
ob->save();
}

