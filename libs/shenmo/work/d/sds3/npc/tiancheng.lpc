#include <ansi.h>
inherit NPC;
#include "star.h"

string check_me();

void create() {
  set_name("童虎", ({ "dohko", "tian chen", "tonghu", "tong hu", "tong", "hu" }));
  set("long", "传说中在庐山五老峰静坐243年的中国神秘老人,天平座。上一代的
黄金圣斗士，负责看管被雅典娜封印的一百零八名冥斗士，并被雅典娜赐予返老还童术。 \n");
  set("gender", "男性");
  set("title", HIW "天秤座" HIY "黄金圣斗士" NOR);
  set("age", 300);
  set("con", 30);
  set("per", 30);
  set("str", 25);
  set("int", 35);
  set("combat_exp", 4000000);
  set_skill("dodge", 330);
  set_skill("force", 330);
  set_skill("parry", 330);
  set_skill("unarmed", 330);
  set_skill("lushan-quan", 330);
  set_skill("stars-steps", 330);
  set_skill("moonforce", 330);
  set_skill("moonshentong", 330);
  map_skill("parry", "lushan-quan");
  map_skill("dodge", "stars-steps");
  map_skill("unarmed", "lushan-quan");
  map_skill("spells", "moonshentong");
  map_skill("force", "moonforce");

  set("max_force", 5000);
  set("force", 10000);
  set("max_mana", 5000);
  set("mana", 10000);
  set("mana_factor", 110);
  set("force_factor", 110);
  set("max_kee", 6000);
  set("max_gin", 6000);
  set("max_sen", 6000);

  set("inquiry", ([
    "妖星": (: check_me :),
  ]));

  setup();
  carry_object(__DIR__ "obj/tc_cloth")->wear();
}

void destruct_me() {
  remove_call_out("detruct_me");
  if (objectp(this_object()))
    destruct(this_object());
}

string check_me() {
  object me = this_player();
  if (!userp(me)) {
    kill_ob(me);
    return "阿猫阿狗的也瞎问东问西！";
  }
  if (me->query("sds4/number") < 8
    || me->query("sds4/box") != "done")
    return "唉，你知道了也是白搭，我还是自己靠自己吧。";

  if (me->query_temp("sds5/lushan_ask")) {
    say(CYN + name() + CYN "「嗯」的一声，一副欲言又止的样子。\n" NOR);
    return "你不是刚刚问过了吗？难道你胆怯了？！";
  }

  if (me->query("sds5/lushan") == "done") {
    if (me->query("sds5/all") != "done") {
      say(name() + "点了点头。\n");
      //(*)
      return "好，我这就带你过去。";
    } else return "呵呵，你不是已经保护了雅典娜了吗？";
  }
  me->set_temp("sds5/lushan_ask", 1);
  say(CYN + name() + CYN "点了点头，说道：恩，既然你想知道就随我来吧。\n" NOR);
  message_vision(HIY "\n$N" HIY "催动小宇宙，金光一闪，和$n" HIY "俩人已消失不见！\n\n" NOR, this_object(), me);
  me->move("/d/sds5/shanlu1");
  this_object()->move("/obj/empty");
  call_out("destruct_me", 3 + random(5));
  message_vision(HIY "\n金光闪过，$N" HIY "眼前一亮，竟已来到了五老峰。\n\n" NOR, me);
  tell_object(me, HIG "童虎(Dohko)告诉你：我先回去准备一下，我在五老峰等你。\n" NOR);
  return "你慢慢走，我先行一步";
}

void init() {
  object me = this_player();
  if (me->query("sds3/tiancheng") == "done") {
    command("say 要是西游记--神魔传说的孩子们个个似你，何怕祖国不能统一。\n");
    message_vision(CYN "童虎拍拍$N的头，欣慰的闭上眼睛，又进入了漫长的休眠。\n" NOR, me);
    destruct(this_object());
  } else {
    command("say 年轻人自当多受磨练！\n");
    kill_ob(me);
  }
}

void kill_ob(object me) {
  object ob = this_object();
  if (!me) return;

  if (!present(me, environment())) {
    me->remove_killer(ob);
    ob->remove_killer(me);
    powerup();
    return;
  }

  if (me->is_ghost() || !userp(me)) {
    me->remove_killer(ob);
    ob->remove_killer(me);
    powerup();
    return;
  }

  switch (random(5)) {
    case 0:
      {
        message_vision(HIC "$N大喊一声『庐山升龙霸』一条居龙自九天而起，直飞$n！\n", ob, me);
        if (random(2) == 0) {
          message_vision(HIC "$N被巨龙在空中顶得翻了几十个跟头！\n" NOR, me);
          me->add("eff_kee", -2 * query("max_kee") / 10);
          me->add("eff_sen", -2 * query("max_sen") / 10);
        } else message_vision(HIG "$N身型急转，不知道绕了多少圈才夺过巨龙的攻击！\n" NOR, me);
      }
      break;
    case 1:
      {
        message_vision(YEL "$N高喊一声：『庐山亢龙霸』，一条恶龙自溅底而出，尾巴向$n扫去！\n", ob, me);
        if (random(2) == 0) {
          message_vision(GRN "$N被恶龙的尾巴甩了个正着，$N顿时眼冒金星！\n" NOR, me);
          me->add("eff_kee", -2 * query("max_kee") / 10);
          me->add("eff_sen", -2 * query("max_sen") / 10);
        } else
          message_vision(HIY "$N用尽全身力气，飞升而气，恶龙的尾巴正从$N的脚底板扫过！\n" NOR, me);
      }
      break;
    case 2:
      {
        message_vision(HIR "$N高喊一声：『庐山百龙霸』，无数只巨龙向$n冲过来！\n", ob, me);
        if (random(2) == 0) {
          message_vision(HIR "$N如一个球一样，被无数只巨龙在空中戏弄着！\n" NOR, me);
          me->add("eff_kee", -3 * query("max_kee") / 10);
          me->add("eff_sen", -3 * query("max_sen") / 10);
        } else
          message_vision(HIR "$N看准了巨龙之间的空隙，左转右转，才勉强离难！\n" NOR, me, ob);
      }
      break;
    default: powerup();
    break;
  }
  ::kill_ob(me);
}

void die() {
  object me = this_object();
  object ob = me->query_temp("last_damage_from");
  powerup();
  if (!ob || !present(ob, environment())) return;
  me->remove_killer(ob);
  ob->remove_killer(me);

  if (ob->query("sds3/tiancheng") != "done" && ob->query("sds3/shinu") == "done") {
    message(
      "chat",
      HIY + "【黄道十二宫】雅典娜(Athena):" + HIW + ob->name() + HIY "闯过了第七宫：天秤宫!\n" NOR,
      users()
    );
    message(
      "say",
      HIW "\n童虎对你说道:你能打败我证明你的力量强大,山羊宫的修罗是个难缠的家伙,我传你一个绝招(tianlong),不到最危险的时候切忌乱用！\n" NOR,
      ob
    );
    ob->set(
      "sds3/tianlong",
      "done"
    ); /************/ message_vision(HIY "\n\n童虎说完就消失了,你身上渐渐泛起了一条巨龙的身影,又渐渐隐去了.\n" NOR, ob);
    ob->start_busy(3);
    ob->set("sds3/tiancheng", "done");
    ob->add("sds3/number", 1);
    ob->add("daoxing", 100000);
    tell_object(ob, HIW "你赢得了一百年道行\n" NOR);
  }
  message("chat", HIY + "【黄道十二宫】童虎(Dohko):" + HIW + ob->name() + HIY "已经闯过我天秤宫!\n" NOR, users());
  destruct(this_object());
}
