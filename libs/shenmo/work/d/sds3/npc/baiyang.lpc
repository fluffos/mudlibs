//白羊座穆先生  修复圣衣，水晶墙，星光灭绝，星屑旋转功，电波术
//一开始便对现任教皇产生怀疑，故居住於帕尔米高原上，拒绝接受教皇的指示。
//穆的念力强大，亦是世上唯一拥有修补圣衣能力的人。

#include <ansi.h>
inherit NPC;

void greeting(object me);
string ask_cloth(object me);

void create() {
  set_name("穆先生", ({ "mu" }));
  set("long", HIW "传说中的白羊宫黄金战士，守护着白羊座,极富正义与智慧的黄金圣斗士，并擅长修理圣衣。
在十二宫之战中，帮助星矢他们领悟第七感。冥界之战中，击败最强的冥斗士之一，地妖星的巴比隆。 \n" NOR);
  set("gender", "男性");
  set("title", HIW "白羊宫" NOR + HIY "黄金圣斗士" NOR);
  set("age", 30);
  set("attitude", "friendly");
  set("con", 30);
  set("per", 30);
  set("str", 25);
  set("int", 40);
  set("combat_exp", 7800000);
  set("daoxing", 7800000);
  set("chat_chance", 5);
  set("chat_msg", ({
    "穆先生说道：不知何时能再见到雅典娜！\n"
  }));
  set_skill("dodge", 250);
  set_skill("force", 250);
  set_skill("parry", 250);
  set_skill("unarmed", 250);
  set_skill("shengdou", 250);
  set_skill("stars-steps", 250);
  set_skill("moonforce", 250);
  set_skill("moonshentong", 350);
  map_skill("parry", "shengdou");
  map_skill("dodge", "stars-steps");
  map_skill("unarmed", "shengdou");
  map_skill("spells", "moonshentong");
  map_skill("force", "moonforce");

  set("max_force", 2000);
  set("force", 4000);
  set("max_mana", 3000);
  set("mana", 6000);
  set("mana_factor", 50);
  set("force_factor", 50);
  set("max_kee", 2000);
  set("max_gin", 2000);
  set("max_sen", 2000);
  set("inquiry", ([
    "黄金圣衣": (: ask_cloth :),
    "cloth": (: ask_cloth :),
  ]));
  setup();
  carry_object(__DIR__ "obj/by_cloth")->wear();
}

void init() {
  object me = this_player();
  ::init();
  if (me->query("sds2/cloth") == "done") {
    if (me->query_temp("sds3/rm_give") == "done") {
      remove_call_out("greeting");
      call_out("greeting", 3, me);
    } else command("say 将人马座圣衣交换给圣域吧！\n");
  } else {
    command("say 好大的胆子,竟敢来圣域捣乱,先过我这一关！\n");
    kill_ob(me);
  }

}

string ask_cloth(object me) {
  object newob;
  string name;

  me = this_player();

  name = me->query("cloth_name");
  if (!name || !stringp(name))
    return "你还没有自己的守护星座呢。";

  if (!me->query("sds3/all"))
    return "你似乎还未有属于自己的圣衣。";

  if (me->query_temp("zhenshen_gold_cloth_get"))
    return "你不是已经召唤过自己的圣衣了吗？";

  newob = new("/obj/gold_cloth");
  if (!newob)
    return "坏了，圣衣不见了！";
  newob->set("owner_id", me->query("id"));
  if (!newob->restore()) {
    newob->set("name", CYN + name + CYN "座" NOR HIY "黄金圣衣" NOR);
    newob->set_weight(8000);
    newob->set("armor_prop", ([
      "strength": 1,
      "courage": 1,
      "intelligence": 1,
      "spirituality": 1,
      "composure": 1,
      "personality": 1,
      "constitution": 1,
      "karma": 1,

      "armor": 60,
      "spells": 1,
      "dodge": 1,
      "parry": 1,
      "force": 1,
    ]));
    newob->set("level", 1);

    if (newob->save()) {
      if (newob->move(me)) {
        message_vision(HIG "穆先生垂眉瞑目，运起念力。只见" HIW + name + HIG "星座一道金光笔直罩住了$N" HIG "！\n" NOR, me);
        tell_object(me, HIG "你定睛观瞧，却发现一件崭新的" HIY "黄金圣衣" NOR HIG "已经在手中。\n" NOR);
        message(
          "channel:rumor",
          WHT "\n遥远的天际，" YEL + name + YEL "星座" WHT "忽然闪出了几道眩目的光华。\n" NOR,
          users()
        );
        me->set_temp("zhenshen_gold_cloth_get", 1);
        return "这就是你的新圣衣了。";
      } else return "我现在正忙，你等会再来试试。";
    } else return "我现在很忙，你等会再来试试。";
  } else {
    write(YEL "圣衣读取" WHT ">>>>>>>>>>" YEL "成功。\n" NOR);
    if (!newob->move(me))
      return "圣衣传送失败>>>>>>>>>>>失败.请稍后再试";
    message_vision(
      HIY "\n$N" HIY "对着天边" HIG + name + HIG "座" HIY "振臂一呼，一道金光笼罩住$N" HIY "！\n\n" NOR,
      me
    );
    message(
      "shout",
      WHT "\n只见遥远天际的 " YEL + name + NOR YEL "星座" WHT "忽然掠过一道光芒径直射向了" + environment(me)->query("short") + WHT "。\n\n" NOR,
      users()
    );
    me->set_temp("zhenshen_gold_cloth_get", 1);
    return "圣衣修复成功，请妥善保管。";
  }
}

void kill_ob(object me) {
  int damage, lvl, r_lvl, skill, i;
  object ob = this_object();

  if (!me)
    return;

  if (!present(me, environment())) {
    ob->delete_temp("my_killer");
    return;
  }

  if (me->is_ghost()) {
    ob->delete_temp("my_killer");
    return;
  }

  switch (random(6)) {
    case 0:
      message_vision(HIC "「星光灭绝」$N双手一挥，一团银芒直冲$n而去！\n", ob, me);
      if (random(2)) {
        message_vision(HIC "$N被$n的银芒刺得遍体鳞伤！\n" NOR, me, ob);
        me->add("eff_kee", -query("max_kee") / 10);
        me->add("eff_sen", -query("max_sen") / 10);
      } else message_vision(HIR "$N轻而易举的躲过了$n的攻击！\n" NOR, me, ob);
      break;

    case 1:
      skill = (int)ob->query_skill("dark-quan", 1);
      lvl = skill / 20;
      r_lvl = 3 + random(lvl);
      if (r_lvl > 9) lvl = 9;
      if (r_lvl < 1) r_lvl = 1;
      message_vision(HIW "$N大喝一声“水晶墙！”在自己面前布出一面透明的气墙，$n的攻击立刻被反弹回去！\n" NOR, ob, me);
      for (i = 0; i < r_lvl; i++)
        COMBAT_D->do_attack(me, me, me->query_temp("weapon"));
      break;

    case 2:
      message_vision(HIR "$N运起[星屑旋转功],黄金斗气冲向$n \n", ob, me);
      if (random(2)) {
        message_vision(HIR "$N被[星屑旋转功]击中,顿时血流如注，顷刻染红了全身！\n" NOR, me);
        me->add("eff_kee", -3 * query("max_kee") / 10);
        me->add("eff_sen", -3 * query("max_sen") / 10);
      } else message_vision(HIR "$N看准黄金斗气的方向，纵身跃起，躲过这致命一击！\n" NOR, me);
      break;
    default:
      fight_ob(me);
  }

  if (random(8) == 5)
    powerup();
  remove_call_out("kill_ob");
  call_out("kill_ob", 5 + random(10), me);
}

void die() {
  object ob = this_object();
  object me = ob->query_temp("last_opponent");
  message_vision(HIW "$N瞑目运用念力，立刻恢复了战斗力！\n" NOR, ob);
  powerup(1, 1);
  if (me)
    kill_ob(me);
}

void greeting(object me) {
  if (!me || !visible(me) || environment(me) != environment())
    return;
  if (me->query("sds3/baiyang") != "done") {
    command("say 恩，沙织小姐果然是雅典娜转生,圣域发生了巨变！这里的黄金圣斗士不同于\n" +
      "你见过的那些东方妖怪,他们利用自身的小宇宙爆发能瞬间提升战斗力,你们要小心.我看我\n" +
      "只能帮你提高你的盔甲防御力了,要了解圣域的阴暗面,靠自己的能力去战斗吧!\n");
    me->add_temp("apply/armor", 100);
    message(
      "chat",
      HIY + "\n【黄道十二宫】雅典娜(Athena):" + HIW + me->name() + HIY "通过白羊宫奖励道行十年!\n" NOR,
      users()
    );
    me->set("sds3/baiyang", "done");
    me->add("sds3/number", 1);
    me->add("daoxing", 10000);
    tell_object(me, HIY "你的盔甲防御力增强了\n" NOR);
    tell_object(me, HIW "你赢得了十年道行\n" NOR);
  }
  me->start_busy(10);
  me->move("/d/sds3/by2jn1");
  tell_object(me, "你被穆先生用意念送出了白羊宫!\n");
}

void unconcious() {
  die();
}

int accept_object(object who, object ob) {
  if (ob->query("id") == "renma shengyi") {
    command("hmm");
    command("say 圣域发生了巨变!下面的路你自己要小心了！\n");
    who->set_temp("sds3/rm_give", "done");
    call_out("destroy", 1, ob);
    return 1;
  } else return 0;
}

void destroy(object ob) {
  if (ob) destruct(ob);
  greeting(this_player());
  return;
}
