//血池地狱，法伦常转，六道轮回，天魔降伏，天舞宝伦

#include <ansi.h>
inherit NPC;

#include "star.h"

void create() {
  set_name("沙加", ({ "shaka", "chu nu" }));
  set("long", HIC "最接近神的男人，黄金圣斗士中最强者。并在冥界之战中杀死多名
冥斗士。最后，和三名黄金圣斗士同归于尽，其实他未死，而是领悟了八感，来到冥界。守护处女座。\n" NOR);
  set("gender", "男性");
  set("title", HIM "处女座" + HIY "黄金圣斗士" NOR);
  set("age", 37);
  set("con", 30);
  set("per", 30);
  set("str", 25);
  set("int", 35);
  set("combat_exp", 15000000);
  set("daoxing", 15000000);
  set("chat_chance", 1);
  set("chat_msg", ({
    "沙加闭着双眼,静静的盘腿坐在莎罗双树下,默默的对着你.\n"
  }));
  set("attitude", "friendly");
  set_skill("dodge", 330);
  set_skill("force", 330);
  set_skill("parry", 330);
  set_skill("unarmed", 330);
  set_skill("shengdou", 330);
  set_skill("stars-steps", 330);
  set_skill("moonforce", 330);
  set_skill("moonshentong", 330);
  map_skill("parry", "shengdou");
  map_skill("dodge", "stars-steps");
  map_skill("unarmed", "shengdou");
  map_skill("spells", "moonshentong");
  map_skill("force", "moonforce");

  set("max_force", 5000);
  set("force", 10000);
  set("max_mana", 5000);
  set("mana", 10000);
  set("mana_factor", 110);
  set("force_factor", 110);
  set("max_kee", 6000);
  set("max_gin", 6000);
  set("max_sen", 6000);
  setup();
  carry_object(__DIR__ "obj/su_cloth")->wear();
}

void init() {
  object me = this_player();
  ::init();
  message_vision(HIY "\n沙加睁开了双眼,黄金小宇宙爆发出来.\n\n" NOR, me);

  if (me->query("sds3/shinu") == "done") {
    command("say 原来是你......\n");
    message_vision(CYN "$n又渐渐的消失在莎罗树中......\n" NOR, me, this_object());
    destruct(this_object());
  } else {
    random(2) ? command("say " + me->name() + "竟敢闯我处女宫,就让你见识一下神的力量!\n") : message(
      "chat",
      HIC + "【黄金十二宫】沙加(Shaka):处女座最大奥秘[" + HIY + "天舞宝轮" + NOR "" + HIC + "]\n" NOR,
      users()
    );
    add_action("do_none", "perform");
    add_action("do_none", "cast");
    add_action("do_none", "ji");
    add_action("do_none", "recall");
    kill_ob(me);
  }
}

void kill_ob(object me) {
  object ob = this_object();

  if (!present(me, environment())) {
    me->remove_killer(ob);
    ob->remove_killer(me);
    powerup();
    return;
  }

  if (me->is_ghost() || !userp(me)) {
    me->remove_killer(ob);
    ob->remove_killer(me);
    powerup();
    return;
  }

  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed", "xcdy" :),
    (: perform_action, "unarmed", "flcz" :),
    (: perform_action, "unarmed", "ldlh" :),
    (: powerup() :),
  }));
  ::kill_ob(me);
}

void die() {
  object me = this_object();
  object ob = me->query_temp("last_damage_from");

  powerup();
  if (!ob || !present(ob, environment())) return;
  me->remove_killer(ob);
  ob->remove_killer(me);

  if (ob->query("sds3/shinu") != "done" && ob->query("sds3/shizi") == "done") {
    ob->start_busy(3);
    message(
      "chat",
      HIY + "【黄金十二宫】沙加(Shaka):" + HIW + ob->name() + HIY "毁我莎罗双树,强闯过了处女宫。\n" NOR,
      users()
    );
    ob->set("sds3/shinu", "done");
    ob->add("sds3/number", 1);
    ob->add("daoxing", 50000);
    tell_object(ob, "你赢得了五十年道行");
  }
  message_vision(HIY "\n\n沙加长叹一声,缓缓盘腿坐下,远处莎罗树也缓缓倒了下去.....\n" NOR, ob);
  message_vision(HIY "\n\n随着莎罗树的湮灭,沙加的也消失了!\n" NOR, ob);
  destruct(this_object());
}

int do_none() {
  object me = this_object();
  message_vision("$N冷笑一声：你[天舞宝轮]阵里，还想有什么花样？\n", me);
  return 1;
}
