#include <ansi.h>

inherit NPC;
#include "star.h"

void create() {
  set_name("卡妙", ({ "kamus", "shui ping" }));
  set("long", "冰河的师祖。十二宫之战中为让冰河领悟第七感，被冰河杀死。富有牺牲精神的黄金圣斗士,守护着水瓶座.\n");
  set("gender", "男性");
  set("title", HIC "水瓶座" HIY "黄金圣斗士" NOR);
  set("age", 37);
  set("con", 55);
  set("per", 30);
  set("str", 73);
  set("int", 64);
  set("combat_exp", 10000000);
  set("daoxing", 10000000);
  set("chat_chance", 2);
  set("chat_msg", ({
    "卡妙说道：不知何时能再见到雅典娜！\n"
  }));
  set_skill("dodge", 250);
  set_skill("force", 250);
  set_skill("parry", 250);
  set_skill("unarmed", 250);
  set_skill("shengdou", 250);
  set_skill("stars-steps", 250);
  set_skill("moonforce", 250);
  set_skill("moonshentong", 250);
  map_skill("parry", "shengdou");
  map_skill("dodge", "stars-steps");
  map_skill("unarmed", "shengdou");
  map_skill("spells", "moonshentong");
  map_skill("force", "moonforce");

  set("max_force", 8000);
  set("force", 16000);
  set("max_mana", 8000);
  set("mana", 16000);
  set("mana_factor", 150);
  set("force_factor", 150);
  set("max_kee", 10000);
  set("max_gin", 10000);
  set("max_sen", 10000);

  setup();
  carry_object(__DIR__ "obj/bp_cloth")->wear();
}

void init() {
  object me = this_player();
  ::init();
  if (me->query("sds3/shuiping") == "done") {
    message(
      "chat",
      HIC + "【黄道十二宫】卡妙(Camus): 欢迎" + HIW + me->name() + HIY "来到了我水瓶宫!\n" NOR,
      users()
    );
    command("say 随便参观。。。。\n");
    destruct(this_object());
  } else {
    message("chat", HIC + "【黄道十二宫】卡妙(Camus):" + HIW + me->name() + HIY "来到了我水瓶宫!\n" NOR, users());
    add_action("do_none", "perform");
    add_action("do_none", "cast");
    add_action("do_none", "ji");
    add_action("do_none", "recall");
    kill_ob(me);
  }
}

int do_none() {
  object me = this_object();
  message_vision("$N冷冷的看着$n。\n", me, this_player());
  return 1;
}

void kill_ob(object me) {
  object ob = this_object();

  if (!present(me, environment())) {
    me->remove_killer(ob);
    ob->remove_killer(me);
    powerup();
    return;
  }

  if (me->is_ghost() || !userp(me)) {
    me->remove_killer(ob);
    ob->remove_killer(me);
    powerup();
    return;
  }

  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed", "zsxc" :),
    (: perform_action, "unarmed", "sgnszks" :),
    (: powerup() :),
  }));
  ::kill_ob(me);
}

void die() {
  object me = this_object();
  object ob = me->query_temp("last_opponent");
  powerup();
  me->remove_killer(ob);
  ob->remove_killer(me);
  if (ob->query("sds3/shanyang") == "done" && ob->query("sds3/shuiping") != "done") {
    ob->start_busy(3);
    message(
      "chat",
      HIY + "【黄道十二宫】雅典娜(Athena):" + HIW + ob->name() + HIY "闯过了卡妙的水瓶宫，继续向圣域前进！\n" NOR,
      users()
    );
    ob->set("sds3/shuiping", "done");
    ob->add("sds3/number", 1);
    ob->add("daoxing", 100000);
    tell_object(ob, "你赢得了一百年道行\n");
  }
  message("chat", HIW "天上的水瓶座数星变得黯淡无光！\n" NOR, users());
  destruct(this_object());
}
