#include <ansi.h>
inherit NPC;
#include "star.h"
 
void create()
{
set_name("亚鲁迪巴", ({"aldebaran", "jin niu"}));
set("long", HIY"金牛座。最勇猛凶悍的黄金圣斗士，但经常被招式诡异的对手打败，冥界之战中，与地暗星尼奥比同归于尽。\n"NOR);
set("gender","男性");
set("title", HIY"金牛座黄金圣斗士"NOR);
set("age",37);
set("con",30);
set("per",20);
set("str",30);
set("int",35);
set("combat_exp",5000000);
set("daoxing",2800000);
set("chat_chance",2);
set("chat_msg", ({
        "亚鲁迪巴说道：不知何时能再见到雅典娜！\n"   
}));
set("attitude", "friendly");
set_skill("dodge", 320);
set_skill("force", 320);
set_skill("parry", 320);
set_skill("unarmed", 320);
set_skill("shengdou",320);
set_skill("stars-steps",320);
set_skill("moonforce",320);
set_skill("moonshentong", 320);
map_skill("parry","shengdou");
map_skill("dodge","stars-steps");
map_skill("unarmed","shengdou");
map_skill("spells","moonshentong");
map_skill("force","moonforce");

set("max_force", 14000);
set("force", 28000);
set("max_mana",18000);
set("mana",8000);
set("mana_factor",100);
set("force_factor",100);
set("max_kee", 10000);
set("max_gin", 10000);
set("max_sen", 10000);
setup();
carry_object(__DIR__"obj/jn_cloth")->wear();
}
 
void kill_ob(object me)
{
object ob=this_object();

if(! present(me,environment()) )
        {
        me->remove_killer(ob);
        ob->remove_killer(me);
        powerup();
        return;
        }
     
if( me->is_ghost() || !userp(me) )
        {
        me->remove_killer(ob);
        ob->remove_killer(me);
        powerup();
        return;
        }

set("chat_chance_combat", 20);
set("chat_msg_combat", ({
        (: perform_action, "unarmed", "hjynq" :),
        (: perform_action, "unarmed", "hjynq" :),
        (: perform_action, "unarmed", "jxhj" :),
}) );
::kill_ob(me);
}

void init()
{
object me=this_player();
::init();
        
if ( me->query("sds3/jinniu")!= "done" || me->query("sds3/number")<2 )
        {
        command("say 废话少说,拿命来！\n");
        kill_ob(me);
        }
else  {
        command("say 哈哈，老朋友又回来了，我去搞些野味，待会我们......嘿嘿\n");
        message_vision(CYN"亚鲁迪巴手舞足蹈的向西离去。\n"NOR,me);
        destruct(this_object());
        }
}

void die()
{
object me = this_object();
object ob = me->query_temp("last_damage_from");
powerup();
if( !ob || !present(ob,environment()) )  return;
me->remove_killer(ob);
ob->remove_killer(me);

if( ob->query("sds3/baiyang")=="done" && ob->query("sds3/jinniu")!="done" )
        {
        ob->start_busy(3);
       message("chat",HIY+"【黄道十二宫】雅典娜(Athena):"+HIW+ob->name()+HIY"闯过了第二宫：金牛宫!奖励道行二十年!\n"NOR,users());
       ob->set("sds3/jinniu","done");
       ob->add("sds3/number",1);
       ob->add("daoxing", 20000);
       tell_object(ob,"你赢得了二十年道行");
        }
message("chat",HIY+"一股强大的小宇宙从金牛宫直冲苍穹，消失在遥远的天际！\n"NOR,users()); 
destruct(this_object());
}


