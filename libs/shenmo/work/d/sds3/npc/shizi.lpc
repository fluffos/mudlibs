// by happ@YSZZ
 
inherit NPC;
#include <ansi.h>

#include "star.h"
 
void create()
{
set_name("艾欧里亚", ({"aiolia", "shi zi"}));
set("long", HIW"狮子座。像一头黄金狮子般，极富正义与勇气。在冥界之战中，曾一拳杀死五名冥斗士，在与地伏星莱米的激战中，最终取得胜利。誓死守护着狮子座。\n"NOR);
set("gender","男性");
set("title", HIY"狮子座黄金圣斗士"NOR);
set("age",30);
set("con",40);
set("spi",50);
set("per",30);
set("str",35);
set("int",45);
set("combat_exp",10000000);
set("daoxing",10000000);
set("chat_chance",2);
set("chat_msg", ({
	"艾欧里亚说道：不知何时能再见到雅典娜！\n"   
}));
set("attitude", "friendly");
set_skill("dodge", 330);
set_skill("force", 330);
set_skill("parry", 330);
set_skill("unarmed", 330);
set_skill("shengdou",330);
set_skill("stars-steps",330);
set_skill("moonforce",330);
set_skill("moonshentong", 330);
map_skill("parry","shengdou");
map_skill("dodge","stars-steps");
map_skill("unarmed","shengdou");
map_skill("spells","moonshentong");
map_skill("force","moonforce");

set("max_force", 5000);
set("force", 10000);
set("max_mana",5000);
set("mana",10000);
set("mana_factor",110);
set("force_factor",110);
set("max_kee", 6000);
set("max_gin", 6000);
set("max_sen", 6000);

setup();
carry_object(__DIR__"obj/shz_cloth")->wear();
}
 
void init()
{
object me=this_player();
object ob=this_object();
::init();
add_action("do_nod", "nod");
if ( me->query("sds3/shizi")=="done" )
	{
	command("jump "+me->query("id") );
	command("say 英雄，有见到你了，真是好啊。。。。\n");
	message_vision(CYN"话音未落，$n已是涕泪纵横......\n
$N见势不妙，连忙道，我刚才见到魔铃小姐在山下给流氓围攻呢。\n"NOR,me,ob);
	command("say 哦，对了，我想起我还得去给我老哥上香呢！\n");
	message_vision(CYN"$n急急忙忙的离开了。\n"NOR,me,ob);
	destruct(ob);
	}
else if (me->query("sds3/juxie") == "done"  && me->query("sds3/shizi")!= "done" )
	command("say 来得好,我等你很久了,能够来到狮子宫的人一定是女神挑选出来的勇士,战胜我
才能证明你的力量和勇气!你准备好了吗?(nod)\n\n");
}


void kill_ob(object me)
{
object ob=this_object();
if(! present(me,environment()) )
	{
	me->remove_killer(ob);
	ob->remove_killer(me);
	powerup();
	return;
	}
     
if( me->is_ghost() || !userp(me) )
	{
	me->remove_killer(ob);
	ob->remove_killer(me);
	powerup();
	return;
	}
     
set("chat_chance_combat", 40);
set("chat_msg_combat", ({
	(: perform_action, "unarmed", "syq" :),
	(: perform_action, "unarmed", "sdb" :),
       (: powerup() :),
}) );
::kill_ob(me);
}

void die()
{
object ob = query_temp("last_damage_from");

powerup();
if( !ob || !present(ob,environment()) )  return;
ob->remove_killer(this_object());
this_object()->remove_killer(ob);
if( ob->query("sds3/juxie")=="done" && ob->query("sds3/shizi")!="done" )
	{
	message("chat",HIY+"【黄道十二宫】雅典娜(Athena):"+HIW+ob->name()+HIY"闯过了第五宫狮子座，继续向处女宫前进。\n"NOR,users());
	ob->start_busy(3);
	ob->set("sds3/shizi","done");
	ob->add("sds3/number",1);
	ob->add("daoxing", 60000);
        tell_object(ob,"你赢得了六十年道行。\n");
	}
message("chat",HIY+"一股强大的小宇宙从狮子宫冲天而出，消失在遥远的天际。\n"NOR,users());
destruct(this_object());
}

int do_nod(string arg)
{
object me=this_player();
command("say 小心了!!!\n");
kill_ob(me);
message_vision(HIY"\n艾欧里亚全身黄金斗气大盛,就像一头凶猛的黄金狮子!\n"NOR,me);	
return 0;
}

