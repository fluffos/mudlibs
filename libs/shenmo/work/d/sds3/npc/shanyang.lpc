#include <ansi.h>
inherit NPC;
#include "star.h"
 
void create()
{
set_name("修罗", ({"shura", "shan yang"}));
set("long", "号称对雅典娜最忠诚的圣斗士，十二宫之战中，为救紫龙而献身。
拥有雅典娜赐予的艾斯卡利巴圣剑。 守护着山羊座.\n");
set("gender","男性");
set("title", HIW"山羊座"HIY"黄金圣斗士"NOR);
set("age",37);
set("con",45);
set("per",30);
set("str",63);
set("int",64);
set("combat_exp",15000000);
set("daoxing",15000000);
set("chat_chance",2);
set("chat_msg", ({
	"修罗说道：不知何时能再见到雅典娜！\n"   
}));
set_skill("dodge", 320);
set_skill("force", 320);
set_skill("parry", 320);
set_skill("unarmed", 350);
set_skill("shengdou",350);
set_skill("stars-steps",350);
set_skill("moonforce",320);
set_skill("moonshentong", 320);
map_skill("parry","shengdou");
map_skill("dodge","stars-steps");
map_skill("unarmed","shengdou");
map_skill("spells","moonshentong");
map_skill("force","moonforce");

set("max_force", 8000);
set("force", 16000);
set("max_mana",8000);
set("mana",16000);
set("mana_factor",150);
set("force_factor",150);
set("max_kee", 18000);
set("max_gin", 18000);
set("max_sen", 18000);

setup();
carry_object(__DIR__"obj/mj_cloth")->wear();
}

void init()
{
object me=this_player();
object ob=this_object();
::init();
if (me->query("sds3/shanyang") == "done")
	{
	message_vision(CYN"$n正蹲在地上冥思苦想，见$N过来不由喜形于色，拉住$N的手。\n"NOR,me,ob);
	command("whisper "+me->query("id")+" 我刚刚想到一招破紫龙的那招升龙霸，你看着...\n");
	message_vision(YEL"$n拿出把铁锹边挖边狂笑：这次看他怎么升我...\n$n越挖越深，渐渐不见踪影。\n\n"NOR,me,ob);
	destruct(ob);	
	}
else	{
	message("chat",HIC+"【黄道十二宫】修罗(Shura):"+me->name()+"竟敢闯我山羊宫,就让你见识一下神的力量!\n"NOR,users());
	add_action("do_none","perform");
       add_action("do_none","cast");
       add_action("do_none","ji");
	add_action("do_none","recall");
	add_action("do_pfm","perform");
       kill_ob(me);
	}
}

int do_pfm()
{
int i = random(10);
object ob = this_object();
object me = this_player();
	 
if ( ob->is_fighting(me) )
	{
	if ( random(i)>5 )
		return 0;
	ob->powerup();
	return 1;
	}
return 1;
}

int do_none()
{
        object me = this_object();
        message_vision("$N冷笑一声：在我$N面前，你想耍什么花样？\n",me);
        return 1;
} 

void kill_ob(object me)
{
object ob=this_object();

if(! present(me,environment()) )
	{
	me->remove_killer(ob);
	ob->remove_killer(me);
	powerup();
	return;
	}
     
if( me->is_ghost() || !userp(me) )
	{
	me->remove_killer(ob);
	ob->remove_killer(me);
	powerup();
	return;
	}

set("chat_chance_combat", 100);
set("chat_msg_combat", ({
	(: perform_action, "unarmed", "sj" :),
       (: powerup() :),
       (: powerup() :),
       (: powerup() :),
       (: powerup() :),
}) );
::kill_ob(me);
}

void die()
{
object me = this_object();
object ob = me->query_temp("last_damage_from");

powerup();
if( !ob || !present(ob,environment()) )  return;
me->remove_killer(ob);
ob->remove_killer(me);

if(ob->query("sds3/renma")=="done" && ob->query("sds3/shanyang")!="done")
	{
	ob->start_busy(3);
        message("chat",HIY+"【黄道十二宫】雅典娜(Athena):"+HIW+ob->name()+HIY"闯过了第十宫山羊宫，继续向黄金十二宫前进！\n"NOR,users());
	ob->set("sds3/shanyang","done");
	ob->add("sds3/number",1);
	ob->add("daoxing", 80000);
	tell_object(ob,"你赢得了八十年道行\n");
	}
message("chat",HIW"山羊宫那强大的小宇宙忽然消失了！\n"NOR,users());
destruct(this_object());
}

