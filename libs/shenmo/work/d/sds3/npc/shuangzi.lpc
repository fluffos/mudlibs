//神秘的双子座黄金圣斗士，自十叁年前便一直失踪。他拥有双重性格，一面是善良而又得人心，另一面却是充满罪恶。
//当星矢去到教庭时，才揭发他就是现任教皇亚历士。撒加 SAGA 

#include <ansi.h>
inherit NPC;
#include "star.h"

void create() {
  set_name("撒加", ({ "saga", "sa ga" }));
  set("long", HBBLU + HIR "神秘的双子座黄金圣斗士，自十叁年前便一直失踪。他拥有双重性格，一面是善良而又得人心，另一面却是充满罪恶。
他的身份一直是一个谜。\n" NOR);
  set("gender", "男性");
  set("title", HBBLU + HIR "双子宫" NOR + HIY "黄金圣斗士" NOR);
  set("age", 25);
  set("con", 30);
  set("per", 30);
  set("str", 35);
  set("int", 40);
  set("combat_exp", 8800000);
  set("daoxing", 8800000);
  set("chat_chance", 5);
  set("chat_msg", ({
    "撒加说道：不知何时能再见到雅典娜！\n"
  }));
  set_skill("dodge", 330);
  set_skill("force", 330);
  set_skill("parry", 330);
  set_skill("unarmed", 330);
  set_skill("shengdou", 330);
  set_skill("stars-steps", 330);
  set_skill("moonforce", 330);
  set_skill("moonshentong", 330);
  map_skill("parry", "shengdou");
  map_skill("dodge", "stars-steps");
  map_skill("unarmed", "shengdou");
  map_skill("spells", "moonshentong");
  map_skill("force", "moonforce");

  set("max_force", 5000);
  set("force", 10000);
  set("max_mana", 5000);
  set("mana", 10000);
  set("mana_factor", 110);
  set("force_factor", 110);
  set("max_kee", 6000);
  set("max_gin", 6000);
  set("max_sen", 6000);

  setup();
  carry_object(__DIR__ "obj/sz_cloth")->wear();
}

void init() {
  object me = this_player();
  ::init();
  if (!me || !visible(me) || environment(me) != environment()) return;

  message_vision(HIY "\n你只觉得来到了一个神秘的空间,空气中都充满了诡异的力量!\n\n" NOR, me);
  add_action("do_none", "perform");
  add_action("do_none", "cast");
  add_action("do_none", "ji");
  add_action("do_none", "move");
  kill_ob(me);
}

int do_none() {
  object ob = this_object();
  message_vision(HIB "$N发出一阵令人毛骨悚然的冷笑!\n" NOR, ob);
  return 1;
}

void kill_ob(object me) {
  object ob = this_object();

  if (!present(me, environment())) {
    me->remove_killer(ob);
    ob->remove_killer(me);
    powerup();
    return;
  }

  if (me->is_ghost() || !userp(me)) {
    me->remove_killer(ob);
    ob->remove_killer(me);
    powerup();
    return;
  }

  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed", "hlmhq" :),
    (: perform_action, "unarmed", "mhfxq" :),
    (: perform_action, "unarmed", "mhblq" :),
  }));


  ::kill_ob(me);
}

void die() {
  object me = this_object();
  object ob = query_temp("last_damage_from");

  powerup();
  if (!ob || !present(ob, environment())) return;
  me->remove_killer(ob);
  ob->remove_killer(me);

  if (ob->query("sds3/jinniu") == "done" && ob->query("sds3/shuangzi") != "done") {
    ob->start_busy(3);
    message("chat", HIY + "【黄道十二宫】撒加(Sa ga):竟然有人能强闯过我的双子迷宫。。。。。。\n" NOR, users());
    ob->set("sds3/shuangzi", "done");
    ob->add("sds3/number", 1);
    ob->add("daoxing", 30000);
    tell_object(ob, "你赢得了三十年道行!\n");
    ob->move("/d/sds3/sz2jx1");
    message_vision("\n\n打倒双子座黄金圣斗士后,神秘的力量随即消失,扭曲的时空也恢复了原状!\n\n" NOR, ob);
    message_vision("\n随着一声巨响,双子宫倒塌了下去.\n\n" NOR, ob);
  }
  destruct(this_object());
}
