
#include <ansi.h>

inherit NPC;

void powerup();
void gift(object me,object npc);
void end(object me,object npc);
 
void create()
{
set_name("亚历士", ({"alith","king"}));
set("long", HIW"圣域的统治者，自从上一任教皇神秘死亡后继任，上任后运用暴力的手段排除异己，宣扬圣域的“纯血统”理论。 \n"NOR);
set("gender","男性");
set("title", HIY" 教  皇"NOR);
set("age",30);
set("con",30);
set("per",0);
set("str",50);
set("int",40);
set("combat_exp",28000000);
set("daoxing",48000000);
set("chat_chance",1);
set("chat_msg", ({
	"教皇说道：圣域再不能让异乡人掌握权利！\n"   
}));
set_skill("dodge", 400);
set_skill("force", 400);
set_skill("parry", 400);
set_skill("unarmed",400);
set_skill("shengdou",400);
set_skill("stars-steps",400);
set_skill("moonforce",400);
set_skill("moonshentong",400);
map_skill("parry","shengdou");
map_skill("dodge","stars-steps");
map_skill("unarmed","shengdou");
map_skill("spells","moonshentong");
map_skill("force","moonforce");

set("max_force", 2000);
set("force", 4000);
set("max_mana",3000);
set("mana",6000);
set("mana_factor",50);
set("force_factor", 50);
set("max_kee", 12000);
set("max_gin", 12000);
set("max_sen", 12000);

setup();
carry_object(__DIR__"obj/king_cloth")->wear();
}

void init()
{
object me=this_player();
::init();
if ( me->query("sds3/shuangyu") == "done"
   && me->query("sds3/king")!="done" )
	{
	add_action("do_none","cast");
	add_action("do_none","perform");
	add_action("do_none","ji");
	add_action("do_none","apply");
	add_action("do_none","burn");
	add_action("do_none","surrender");
	add_action("do_none","move");
	add_action("do_none","get");
	add_action("do_none","put");
	add_action("do_none","drop");
	add_action("do_none","whisper");
	kill_ob(me);
	}
else  command("say 圣域再不能让异乡人掌握权利！\n");
}
 
void kill_ob(object me)
{
object ob=this_object();
if(! present(me,environment()) )
	{
	ob->delete_temp("my_killer");
	return;
	}
     
if( me->is_ghost() || !userp(me) )
	{
	ob->delete_temp("my_killer");
	return;
	}
     
set("chat_chance_combat", 60);
set("chat_msg_combat", ({
      (: perform_action, "unarmed", "jhhmq" :),
       (: powerup() :),
}) );
::kill_ob(me);
}

void die()
{
object me = this_object();
object ob = me->query_temp("last_damage_from");
powerup();
if( !ob || !present(ob,environment()) )  return;
me->remove_killer(ob);
ob->remove_killer(me);

if( ob->query("sds3/shuangyu")=="done" && ob->query("sds3/king")!="done")
	{
	message("rumor",HIW"\n\n从人马宫方向忽然射出一道强烈的光芒，径直冲向教皇大厅！\n"NOR,users());
	me->set_temp("block_msg/all", 1);
	call_out("end",2+random(3),ob,me);
	return;
	}
message_vision(HIY"\n$n身上的黄金圣衣发出耀眼的光芒，等$P睁开眼睛，$n已踪迹全无！\n"NOR,ob,this_object());
destruct(this_object());
}

void unconcious()
{
  die();
}

void powerup()
{
object me = this_object();
random(2)?
me->command_function("chat 燃烧吧，小宇宙！\n"):
me->command_function("chat 力量！就是正义！\n");
me->set("kee",query("max_kee"));
me->set("eff_kee",query("max_kee"));
me->set("sen",query("max_sen"));
me->set("eff_sen",query("max_sen"));
me->set("force",query("max_force"));
me->set("mana",query("max_mana"));
me->clean_condition();
return;
}

void end(object me,object npc)
{
object cloth;
message("rumor",HIW"\n\n从人马宫方向忽然射出一道强烈的光芒，径直冲向教皇大厅！\n"NOR,users());
message_vision( HIY"\n
$N已经精疲力尽了，但是恐怖的教皇依然屹立不倒！正在苦战之中时，忽然下方的"NOR+HIW"人马宫"NOR+HIY"发生巨变！
\n\n一道光辉洒在$N的身上，$N觉得小宇宙异常强大起来，原来是"NOR+HIC"人马座"NOR+HIY"圣衣！
$N穿上圣衣，将黄金之箭射向了教皇!\n"NOR,me);

message_vision(RED"亚历士应声而倒，教皇圣衣碎成粉末！\n\n"NOR,me);
if ( !cloth=present("king shengyi",npc) )
	cloth=new("/d/sds3/npc/obj/king_cloth");
cloth->move(environment(npc));
cloth->set_name(YEL"破碎的"NOR+cloth->query("name"),({cloth->query("id")}));
cloth->set("no_get",1);
npc->set_name("撒加",({"saga"}));
npc->set("title",HIB"双子宫"NOR HIY"黄金圣斗士"NOR);
message_vision(CYN"咦？！这不是双子黄金斗士？？！！\n"NOR,me);
npc->command("hmm");
message_vision(CYN"撒加忽然面露异相，仔细观瞧，居然是半面极恶半面极善！！\n"NOR,me);
npc->command("say 作为双子的我，身具两种人格！可气的是恶的一面渐渐控制了我身，以致
到今天这个局面！\n");
npc->command("sigh");
message_vision(CYN"陷于了深深的沉思，一时间大家都无语。\n"NOR,me);
remove_call_out("end");
call_out("gift",2+random(3),me,npc);
return;
}

void gift(object me,object npc)
{
object ydn;

ydn=new("/d/sds3/npc/ydn");
ydn->move(environment(npc));
tell_room(environment(npc),CYN"雅典娜面带喜色走了过来。\n"NOR);
ydn->command("say 感谢"+me->query("name")+NOR"拯救了圣域。\n");
message_vision(HIW"\n雅典娜祥和的看着撒加。强大的小宇宙笼罩着俩人。\n"NOR,me);
npc->command("smile");
npc->command("say 或许你是真的女神降临。准备着吧，海王的阴谋......\n");
message_vision("撒加安详的死去。\n",me);
ydn->command("thank");
message_vision(CYN"雅典娜说到：来吧，我的斗士，我在黄金圣殿等你。说完向上离去。\n"NOR,me);
destruct(ydn);
me->set_temp("block_msg/all",0);
me->set("sds3/king","done");
me->add("sds3/number",1);
me->add("daoxing", 200000);
tell_object(me,HIC"你赢得了二百年道行。\n");
message("chat",HIY+"【黄道十二宫】雅典娜(Athena):"+HIW+me->query("name")+HIY"终于驱散了圣域的黑暗，努力吧！\n"NOR,users());
destruct(npc);
return;
}
