#include <ansi.h>
inherit NPC;
#include "star.h"
 
void create()
{
set_name("阿布罗狄", ({"aphrodite", "shuang yu"}));
set("long", "号称最美丽的圣斗士，并以玫瑰为武器。也是比较邪恶的黄金圣斗士，但在冥界之战中仍为雅典娜献身。 守护着双鱼座.\n");
set("gender","男性");
set("title", HIC"双鱼座"HIY"黄金圣斗士"NOR);
set("age",37);
set("con",60);
set("per",32);
set("str",80);
set("int",80);
set("combat_exp",10000000);
set("daoxing",10000000);
set("chat_chance",2);
set("chat_msg", ({
	"阿布罗狄说道：究竟谁能闯过黄金十二宫拿到黄金圣衣呢?\n"   
}));
set_skill("dodge", 330);
set_skill("force", 330);
set_skill("parry", 330);
set_skill("unarmed", 330);
set_skill("shengdou",330);
set_skill("stars-steps",330);
set_skill("moonforce",330);
set_skill("moonshentong", 330);
map_skill("parry","shengdou");
map_skill("dodge","stars-steps");
map_skill("unarmed","shengdou");
map_skill("spells","moonshentong");
map_skill("force","moonforce");

set("max_force", 5000);
set("force", 10000);
set("max_mana",5000);
set("mana",10000);
set("mana_factor",110);
set("force_factor",110);
set("max_kee", 10000);
set("max_gin", 10000);
set("max_sen", 10000);
setup();
carry_object(__DIR__"obj/sy_cloth")->wear();
}

void init()
{
object me=this_player();
::init();
if (me->query("sds3/shuangyu") == "done")
	{
	command("say 欢迎回来圣域...\n");
	destruct(this_object());
	}
else  {
	message_vision(HIM"\n$N冷笑一声：在守护雅典娜女神最后的黄金宫殿里,接受我的死亡之花吧！\n"NOR,this_object());
	add_action("do_none","perform");
       add_action("do_none","cast");
       add_action("do_none","ji");
	add_action("do_none","recall");
       kill_ob(me);
	}
}

int do_none()
{
object me = this_object();
message_vision("$N冷笑一声：在守护雅典娜女神最后的黄金宫殿里,你想耍什么花样？\n",me);
return 1;
} 

void kill_ob(object me)
{
object ob=this_object();

if(! present(me,environment()) )
	{
	me->remove_killer(ob);
	ob->remove_killer(me);
	powerup();
	return;
	}
     
if( me->is_ghost() || !userp(me) )
	{
	me->remove_killer(ob);
	ob->remove_killer(me);
	powerup();
	return;
	}
     
set("chat_chance_combat", 80);
set("chat_msg_combat", ({
        (: perform_action, "unarmed", "mgmg" :),
        (: perform_action, "unarmed", "bmg" :),
        (: perform_action, "unarmed", "hmg" :),
        (: perform_action, "unarmed", "bmg" :),
}) );
::kill_ob(me);
}

void die()
{
object me = this_object();
object ob = query_temp("last_damage_from");
powerup();
if( !ob || !present(ob,environment()) )  return;
me->remove_killer(ob);
ob->remove_killer(me);
if ( ob->query("sds3/shuangyu") != "done" && ob->query("sds3/number")>=11 )
	{
	ob->start_busy(3);
	message("chat",HIY+"【黄道十二宫】阿布罗狄(Aphrodite):"+HIW+ob->name()+HIY"闯过了我双鱼宫，冲入了圣域，教皇不会放过他的！\n"NOR,users());
       ob->set("sds3/shuangyu","done");
       ob->add("sds3/number",1);
       ob->add("daoxing", 100000);
	tell_object(ob,"你赢得了一百年道行");
	}
message_vision(HIM"\n阿布罗狄在一片飞扬的玫瑰花瓣中闭上了眼睛.....\n"NOR,ob);
call_out("wait_time",30);
message("chat",HIM"\n周围忽然飘来玫瑰的香味，你抬头看去，却见双鱼宫方向飞花片片，衬出万般的凄凉！\n"NOR,users());
destruct(this_object());
}

