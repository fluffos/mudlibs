#include <ansi.h>
inherit ROOM;

int block_cmd(string);

void create() {
  set("short", "山路");
  set("long", @LONG
这是走向白羊宫的路上，只见前面可以看到美丽的白羊宫耸立在奥林
匹亚峰上！
LONG);
  set("exits", ([
    "southup": __DIR__ "toby2",
  ]));
  set("outdoors", "12gong");
  setup();
}

void init() {
  add_action("block_cmd", "", 1);
}

int block_cmd(string args) {
  string verb;
  verb = query_verb();
  if (verb == "cast") return 1;
  return 0;
}

int valid_leave(object me, string dir) {
  int i;
  object here, *inv;
  here = this_object();
  inv = all_inventory(me);

  if (!userp(me))
    return notify_fail("小猫小狗的别想进圣域！\n");

  for (i = 0; i < sizeof(inv); i++) {
    if (userp(inv[i]))
      return notify_fail("还是先把身上的玩家放下来再去吧！\n");
    if (inv[i]->query("id") == "yueguang baohe")
      return notify_fail("还是先把身上的宝盒放下来再去吧！\n");
    if (inv[i]->query("id") == "xiuluo zhua")
      return notify_fail("还是先把身上的修罗爪放下来再去吧！\n");
  }

  if (me->query("sds3/baiyang") != "done" && !present("renma shengyi", me))
    return notify_fail("圣域不是要你带圣衣过来相见吗？！\n");

  if (me->query("sds3/baiyang") == "done")
    message(
      "channel:chat",
      HIY "【黄道十二宫】沙织(Sha zhi):" + HIW + me->name() + HIY "再次踏上了前往圣域的路程!\n" NOR,
      users()
    );
  else message(
    "channel:chat",
    HIY "【黄道十二宫】沙织(Sha zhi):" + HIW + me->name() + HIY "踏上了前往圣域的路程!\n" NOR,
    users()
  );
  if (me->query_temp("ridee")) {
    me->query_temp("ridee")->set_temp("rider", 0);
    me->set_temp("ridee", 0);
    me->add_temp("apply/dodge", -me->query_temp("ride/dodge"));
    me->set_temp("ride/dodge", 0);
  }
  return 1;
}
