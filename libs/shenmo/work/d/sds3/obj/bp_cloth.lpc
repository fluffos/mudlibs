// tm_cloth.c
//天马青铜圣衣

#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create() {
  set_name("宝瓶圣衣", ({ "baoping shengyi" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "steel");
    set("armor_prop/armor", 55);
  }
  setup();
}
