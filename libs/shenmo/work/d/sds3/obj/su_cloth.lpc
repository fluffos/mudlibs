#include <armor.h>
#include <ansi.h>

inherit ARMOR;

void create()
{
   set_name(HIM"室女座"HIY"黄金圣衣"NOR, ({ "shinu shengyi" }) );
   set_weight(3000);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("unit", "件");
     set("material", "steel");
     set("armor_prop/armor",260);
   }
   setup();
}
