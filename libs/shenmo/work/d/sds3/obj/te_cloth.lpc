//tl_cloth.c 
//天鹅青铜圣衣 

#include <ansi.h>
#include <armor.h>

inherit ARMOR;

void create() {
  set_name(HIW "天鵝" + HIC "青铜圣衣" NOR, ({ "tiane shengyi" }));
  set_weight(6000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "steel");
    set("armor_prop/armor", 150);
  }
  setup();
}
