//by seawind
#include <ansi.h>;
inherit ROOM;
string look_gaoshi();
void create() {
  set("short", "仙境小径");
  set("long", @LONG
这里是三面环山，只有北面有条出口的一坪山间平地。山坡山阵阵松涛哗
哗作响，山脚下的平地绿草如茵，中间就是传说中的仙境，四周一溜过去
搭着凉棚，棚中桌椅杯盆俱全，看来比武大会快开始了。
    场中立有一面告示牌(gaoshi)。
LONG);
  set("outdoors", "city");
  set("item_desc", ([
    "gaoshi": (: look_gaoshi :),
  ]));
  set("exits", ([
    "leitai": __DIR__ "leitai",
    "northeast": __DIR__ "under1",
    "northwest": __DIR__ "under2"
  ]));
  set("no_exert", 0);
  set("no_fight", "1");
  set("no_steal", "1");
  set("no_kill", "1");
  setup();
}

void init() {
  add_action("do_quit", "quit");
  add_action("do_quit", "lian");
  add_action("do_quit", "mark");
  add_action("do_quit", "fly");
  add_action("do_quit", "chuqiao");
  add_action("do_quit", "qiankun");
  add_action("do_quit", "heijie");
  add_action("do_quit", "jieti");
  add_action("do_quit", "escape");
  add_action("do_quit", "tudun");
  add_action("do_quit", "shuidun");
  add_action("do_quit", "bian");
  add_action("do_quit", "surrender");
  add_action("do_quit", "accept");
}

int do_quit(string arg) {
  write(this_player()->query("name") + "，折腾个啥劲儿呀，专心看比武吧！\n");
  return 1;
}
