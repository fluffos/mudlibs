// 轩辕剑.c
#include <ansi.h>

#include <weapon.h>

inherit FORK;

void create() {
  set_name(HIB "铁叉" NOR, ({ "tie cha", "fork" }));
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 150000);
    set("material", "steel");
    set("long", "这是一把铁叉。\n");
    set("wield_msg", "一道紫光闪过，$N手中已多了把$n。\n");
    set("unequip_msg", "$N放下手中的$n。\n");
  }
  init_fork(10);
  setup();
}
