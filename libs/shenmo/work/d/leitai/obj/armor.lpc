#include <ansi.h>
#include <armor.h>

//inherit F_UNIQUE;
inherit ARMOR;

void create()
{
        set_name(HIC"精魂甲"NOR, ({"jinghun armor","jia", "armor", "armor"}));
        set_weight(3000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
		set("long", "一件融入了筑甲人心情和血水的护甲。\n");
		set("no_sell", 1);
                set("no_drop", 1);
		set("no_put", 1);		
                set("material", "crimsonsteel");
                set("value", 1000);
                set("armor_prop/armor", 130);
		set("armor_prop/dodge", -5);
        }
        setup();
}


