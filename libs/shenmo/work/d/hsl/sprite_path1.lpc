// ROOM: /d/hsl/sprite_path1

inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "小路");
  set("long", @LONG

这是条通往亚雷比斯的小路，路面由鹅卵石铺成，虽然不甚
宽广，却相当的朴素干净，再加上山间独有的新鲜空气，让
人有种心旷神怡的感觉。
LONG);

  set("exits",
    ([
      "east": __DIR__ "sprite_road3",
      "southwest": __DIR__ "sprite_path2",
    ]));


  set("outdoors", "hsl");
  set("no_clean_up", 0);

  setup();
  replace_program(ROOM);

}
