inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "中心路口");
  set("long", @LONG

这是克莱恩城的十字路口，人流和马车来来往往非常之多，
由于道路比较宽广，所以基本上也不会发生堵塞。原来路
两旁都是小贩的摊子，现在城市保卫处下了命令，严禁设
摊，以保证车人流的畅通无阻。
LONG);

  set("exits",
    ([
      "north": __DIR__ "city_street5",
      "west": __DIR__ "city_street3",
      "east": __DIR__ "city_street4",
      "south": __DIR__ "city_street2",
    ]));


  /*  set("objects", 
  ([ 
   "/d/hsl/npc/luren" : 1,
  ]));
*/

  set("outdoors", "hsl");
  set("no_clean_up", 0);

  setup();

}
