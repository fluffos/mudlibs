void init() {
  add_action("block_cmd", "", 1);
}

int block_cmd(string args) {
  string verb;
  verb = query_verb();

  if (verb == "bian") return 1;
  if (verb == "xiudao") return 1;
  if (verb == "exert") return 1;
  if (verb == "drop") return 1;
  if (verb == "cut") return 1;
  if (verb == "ti") return 1;
  return 0;
}

int valid_leave(object me, string dir) {
  if (dir == "west")
    tell_object(me, HIW "阿阿" + HIG "微微笑着对你说：“祝你旅途顺风！”\n" NOR);
  return 1;
}
