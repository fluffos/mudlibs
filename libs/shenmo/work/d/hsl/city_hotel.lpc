// 作者：tonii@飘渺水云间，2003-5-4于浙大，修改请保留此行。
// ROOM: /d/hsl/city_hotel

inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "旅舍");
  set("long", @LONG

一家环境幽雅的旅舍，服务台前的小姐正热情的招待着客人，
温馨的气氛让你有种回到了家的感觉。你可以在这儿订(book）
个房间（room）稍作休息，也可以到公共休息室休息。
LONG);

  set("exits",
    ([
      "east": __DIR__ "city_street2",
      "enter": __DIR__ "city_hotelroom1",
    ]));


  set("objects",
    ([
      "/d/hsl/npc/hotelwaitress": 1,
    ]));


  set("no_clean_up", 0);

  setup();

}

void init() {
  add_action("do_book", "book");
}

int do_book(string arg) {
  object me;
  me = this_player();
  if (!arg || arg != "room")
    return notify_fail("你要订什么？\n");
  message_vision("服务员小姐微笑着对你说：\n“非常抱歉，我们的贵宾室都已经被人预定了，真是对不起！”\n", me);
  return 1;
}
