inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "山路");
  set("long", @LONG

一条翻越小山丘的道路，路面由石子铺成，道路也较为宽广，
如果是驾车好手的话，还是可以轻松的让马车翻越这个山坡的。
LONG);

  set("exits",
    ([
      "northup": __DIR__ "duskyin",
      "south": __DIR__ "yuese_road",
    ]));


  set("outdoors", "hsl");
  set("no_clean_up", 0);

  setup();

}
