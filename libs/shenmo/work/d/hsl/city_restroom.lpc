inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "休息室");
  set("long", @LONG

这儿是一间小小的休息室，供皇家骑士团的勇士们做非正式
交流用，可以在这儿喝喝茶聊聊天。
LONG);

  set("exits",
    ([
      "west": __DIR__ "city_meetingroom",
    ]));

  set("objects",
    ([
      "/d/hsl/npc/master/hu": 1,
    ]));


  set("no_clean_up", 0);

  setup();

}
