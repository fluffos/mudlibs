// ROOM: /d/hsl/sprite_road1

inherit ROOM;
#include <ansi.h>

void create ()
{
  set ("short","草原大道");
  set ("long", @LONG

一条笔直而干净的大道，经常有人类或是妖精的马车驶过。
路的两旁是一望无际的大草原，沿着这条大道往西可以到达
妖精族的聚居地亚雷比斯。
LONG);

  set("exits", 
  ([  
         "southeast"  :  __DIR__"valleypath2",
         "west":  __DIR__"sprite_road2",
  ]));

       
 set("outdoors", "hsl");
 set("no_clean_up", 0);
    
 setup();
 replace_program(ROOM);

}



