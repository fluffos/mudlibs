// ROOM: /d/hsl/jiluo_tomb2

inherit ROOM;
#include <ansi.h>

void create ()
{
  set ("short","墓中大厅");
  set ("long", @LONG

墓中居然还有这样一个大厅，厅中遍布尸骨和头颅，不知道是死在
这儿的先人，还是后人来到这儿后丧命与此。这儿充满了强烈的怨
念和诅咒，令人简直想立刻逃跑。
LONG);

  set("exits", 
  ([  
         "south": __DIR__"jiluo_tomb1",
         "northwest":__DIR__"jiluo_tomb3",
         "northeast":__DIR__"jiluo_tomb4",
  ]));
      
  set("objects", 
  ([ 
   "/d/hsl/npc/yuannian_body" : 1,
  ]));

set("no_clean_up", 0);
    
 setup();
 
}


int valid_leave(object me, string dir)
{
        me = this_player();
        if (dir == "northwest" || dir == "northeast" ) 
        if (objectp(present("yuannian body", environment(me)))) 
                return notify_fail("怨念集合体挡在那儿，你无法过去！\n");
        return 1;
 }




