inherit ROOM;

#include <ansi.h>

void create ()
{
  set ("short","山路");
        set ("long", @LONG

一条崎岖不平的山间小路，并非人为修筑，大约是以前翻山的人们踩
出来的，两旁是千年古木，遮云蔽日，所以比较阴暗。
LONG);

        set("exits", 
        ([ 
		"westdown" : __DIR__"wshanlu",
              "eastup" : __DIR__"wshanyao",
         ]));
       set("outdoors", "hsl");
	set("no_clean_up", 0);
       setup();
	replace_program(ROOM);
}



