inherit ROOM;
#include <ansi.h>

void create ()
{
  set ("short","自由都市米兰多市中心");
  set ("long", @LONG

作为法鲁西翁大陆中最靠近东方的自由都市，米兰多虽然小却吸引
了许多商人和游客。由于街道狭小而人流众多，米兰多常常处于拥
塞状态。市中心北面是一家生意兴隆的酒馆，南面则是一家著名的
武器店。
LONG);

  set("exits", 
  ([  
  	"east" : __DIR__"milanduo_esub",
  	"west" : __DIR__"milanduo_wsub",
       "south": __DIR__"milanduo_bingqipu",
       "north": __DIR__"milanduo_tavern",
  ]));
       
/*  set("objects", 
  ([ 
   "/d/hsl/npc/shangren" : 1,
   "/d/hsl/npc/youke": 1,
  ]));
*/
  set("outdoors", "hsl");
  set("no_clean_up", 0);
 setup();
 replace_program(ROOM);

}



