inherit ROOM;
#include <ansi.h>

void create ()
{
  set ("short","幻世小筑");
  set ("long", @LONG

这是草地北面的一间小小茅草屋，尽管没有任何富丽堂皇
的家具和装饰，但里面的清新雅洁让人们不由得产生神清
气爽、心态安宁的感觉。你可以在这儿休息一下，继续你
的漫漫征程。
LONG);

  set("exits", 
  ([  
         "south":__DIR__"hsl_start",
  ]));

  

 set("sleep_room",1);
 set("if_bed",1);
 set("no_fight",1);
 set("no_magic",1);     
 set("no_clean_up", 0);

 setup();
 
}

