inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "薛维斯港");
  set("long", @LONG

这里是法鲁西翁大陆著名的出海口之一：薛维斯港，这个港口
原来是属于拉尔斯帝国的，如今沃斯菲塔共和国已经将其占为
己有。不远处海水有规律地拍打着岸堤，一艘大船（ship）在
海浪的冲击下微微晃动。
LONG);

  set("item_desc",
    ([
      "ship": "一艘可以穿洋越海的大船，你想乘坐的话得先和船长打个招呼。\n",
    ]));

  set("exits",
    ([
      "northwest": __DIR__ "desolatecity",
    ]));

  set("objects",
    ([
      "/d/hsl/npc/captain": 1,
    ]));


  set("outdoors", "hsl");
  set("no_clean_up", 0);

  setup();
  replace_program(ROOM);

}
