#include <armor.h>

inherit HEAD;

void create()
{
        set_name("誓言头巾", ({ "shiyan toujin","toujin" }) );
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "条");
                set("material", "cloth");
		  set("value", 0);               
                set("armor_prop/armor",10);
        }
        setup();
}


