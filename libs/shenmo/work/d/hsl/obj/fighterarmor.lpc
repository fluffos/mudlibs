#include <armor.h>

inherit ARMOR;

void create() {
  set_name("战士铠甲", ({ "fighter armor", "armor", "jia" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "steel");
    set("value", 4000);
    set("armor_prop/armor", 35);
  }
  setup();
}
