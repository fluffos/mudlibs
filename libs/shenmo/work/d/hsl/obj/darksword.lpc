//darksword.c

#include <weapon.h>
#include <ansi.h>
inherit SWORD;
inherit F_UNIQUE;

void create()
{
   set_name(RED"暗黑剑  忌魂"NOR, ({"darksword", "jian", "sword"}));
   set_weight(13000);
   if (clonep())
     set_default_object(__FILE__);
   else {
     set("unit", "柄");
     set("unique", 1);
     set("no_drop",1);
     set("no_zm",1);
     set("no_sell",1);
     set("no_give",1);
     set("long", "来自魔界的黑暗兵器：暗黑剑  忌魂。\n");
     set("value", 10000000);
     set("material", "iron");
     set("wield_msg", RED"$N拔出暗黑剑，一种来自魔界的黑暗力量充斥四周！\n"NOR);
     set("unwield_msg", RED"$N将暗黑剑插回腰间，黑暗力量逐渐消退。\n"NOR);
     set("weapon_prop/spells", 15);
     set("is_monitored",1);
   }
   init_sword(100);
   setup();  
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        int damage;

	 pro = (int) victim->query("mana");
        dam = (int) me->query("mana");

        damage = 100;
        if( me->query_skill("darksword"))
                damage += (int)me->query_skill("darksword",1);
        if(dam*2/3 > random(pro) && me->query("mana") > me->query("max_mana") )
        {
        victim->receive_damage("sen",damage);
        victim->receive_wound("sen",damage/2);
        return RED "暗黑剑  忌魂突然发出神秘的魔光，直击$n心灵深处。\n" NOR;
        }
}

