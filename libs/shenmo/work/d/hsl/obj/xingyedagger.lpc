//xingyedagger.c

#include <weapon.h>
#include <ansi.h>
inherit DAGGER;

void create() {
  set_name("灵刃星夜", ({ "xingye dagger", "dagger", "xingye" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "一柄发着幽幽蓝光的匕首。\n");
    set("value", 10000);
    set("material", "steel");
    set("wield_msg", "$N从袖中抽出一把灵刃星夜。\n");
    set("unwield_msg", "$N将灵刃星夜藏回袖中。\n");
  }
  init_dagger(25);
  setup();

}
