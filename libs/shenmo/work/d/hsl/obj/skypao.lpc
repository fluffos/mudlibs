#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create()
{
        set_name(HIW"天空之袍"NOR, ({ "sky pao","sky","pao","cloth" }) );
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "cloth");
                set("no_sell",1);
		  set("value", 100000);               
                set("armor_prop/dodge", 10);
                set("armor_prop/spells",20);
                set("armor_prop/armor",30);
        }
        setup();
}


