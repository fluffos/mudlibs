//darkblade.c

#include <weapon.h>
#include <ansi.h>
inherit BLADE;
inherit F_UNIQUE;

void create()
{
   set_name(RED"暗黑刀  血祭"NOR, ({"darkblade", "blade", "dao"}));
   set_weight(13000);
   if (clonep())
     set_default_object(__FILE__);
   else {
     set("unit", "柄");
     set("unique", 1);
     set("no_drop",1);
     set("no_zm",1);
     set("no_sell",1);
     set("no_give",1);
     set("long", "来自魔界的黑暗兵器：暗黑刀  血祭。
然而你总觉得里面有一股神秘的力量在召唤着你：砸碎（break）它～～解救我～～\n");
     set("value", 10000000);
     set("material", "iron");
     set("wield_msg", RED"$N拔出暗黑刀，一种来自魔界的黑暗力量充斥四周！\n"NOR);
     set("unwield_msg", RED"$N将暗黑剑刀插回腰间，黑暗力量逐渐消退。\n"NOR);
     set("weapon_prop/spells", 15);
     set("is_monitored",1);
   }
   init_blade(100);
   setup();  
}

void init()
{
        add_action("do_break", "break");
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        int damage;

	 pro = (int) victim->query("mana");
        dam = (int) me->query("mana");

        damage = 150;
        if(2*dam/3 > random(pro) && me->query("mana") > me->query("max_mana") )
        {
        victim->receive_damage("sen",damage);
        victim->receive_wound("sen",damage/2);
        return RED "暗黑刀  血祭突然发出神秘的魔光，直击$n心灵深处。\n" NOR;
        }
}

int do_break(string arg){
	object ob,me;
       object* fuyinshu;
       object shu;
       ob = this_object();
	me = this_player();
	if( !ob->id(arg) ) return 0;
       if( ob->query("broken"))
               return notify_fail("这把刀已经被你砸碎了！\n");
       message_vision(HIC"$N大喝一声，运足内力将手中"NOR+ob->query("name")+HIC"向地面砸落！\n"NOR, me);
       if( me->query_skill("unarmed",1)<100 || me->query("force")<2000)
               return notify_fail(YEL"但是你的力道不够，剑体依然完好无损！\n"NOR);
       message_vision(HIR"在巨大的内力冲击和迅猛的撞击下"NOR+ob->query("name")+HIR"裂成了碎片！\n"NOR, me);
       ob->set("broken",1);
       ob->unequip();
       ob->set("value",0);
       ob->set("no_get",1);
       ob->set("name","碎裂的"+ob->query("name"));
       call_out("remove_broken_weapon",random(100)+60,ob);
       ob->move(environment(me));

       fuyinshu = children("/d/hsl/obj/fuyinshu");
       if( sizeof(fuyinshu) >1 ){
               tell_object(me,YEL"但是令你失望的是，里面什么都没有！\n"NOR);
               return 1;
       }
	shu=new("/d/hsl/obj/fuyinshu");
	shu->move(me);
       message_vision(HIY"$N从碎裂的剑体中发现了一本薄薄的旧书，散发着神秘的金色光辉！\n"NOR, me);
	return 1;		
}

void remove_broken_weapon(object weapon)
{
  if(weapon && environment(weapon)) {
    tell_object(environment(weapon),
      "一阵微风吹过，"+weapon->name()+"化为片片尘土，消失不见了。\n");
    destruct(weapon);
  }
}
