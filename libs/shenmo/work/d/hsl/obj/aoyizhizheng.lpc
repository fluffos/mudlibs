#include <armor.h>

inherit NECK;

void create()
{
        set_name("奥义之证", ({ "aoyi zhizheng" }) );
        set_weight(800);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "块");
                set("material", "gold");
		  set("value", 0);               
                set("armor_prop/dodge", 5);
                set("armor_prop/armor",5);
        }
        setup();
}


