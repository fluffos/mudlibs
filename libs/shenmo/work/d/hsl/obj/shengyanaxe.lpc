//shengyanaxe.c

#include <weapon.h>
#include <ansi.h>
inherit AXE;

void create() {
  set_name("圣炎之斧", ({ "shengyan axe", "axe", "fu", "shengyan" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "一柄焕发着火红光芒的斧子。\n");
    set("value", 10000);
    set("material", "steel");
    set("wield_msg", "$N大喝一声，从腰间猛地抽出一把圣炎之斧。\n");
    set("unwield_msg", "$N将圣炎之斧插回腰间。\n");
  }
  init_axe(70);
  setup();

}
