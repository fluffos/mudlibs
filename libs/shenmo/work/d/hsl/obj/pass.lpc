#include <ansi.h>
inherit ITEM;

void create() {
  set_name("通行证", ({ "pass" }));
  set_weight(30);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("unique", 1);
    set("long", "由那可那鲁王国颁发的出入边境特别通行证。\n");
    set("value", 0);
  }
  setup();
}
