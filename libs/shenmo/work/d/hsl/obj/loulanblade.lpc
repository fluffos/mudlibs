//loulanblade.c 

#include <weapon.h>
inherit BLADE;

void create() {
  set_name("楼兰宝刀", ({ "loulan blade", "dao", "blade" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是一柄产自大唐西域地带楼兰国出品的锋利弯刀。\n");
    set("value", 3500);
    set("material", "steel");
    set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插回刀鞘。\n");
  }
  init_blade(45);
  setup();

}
