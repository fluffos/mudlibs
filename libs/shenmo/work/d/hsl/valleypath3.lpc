inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "瀑布前小径");
  set("long", @LONG

一条草丛间的小径，通往著名的尼布鲁瀑布。虽然瀑布被茂密的
树丛遮挡，在这儿看不到分毫，但其飞流而下的声响却能听得
清清楚楚。
LONG);

  set("exits",
    ([
      "north": __DIR__ "echovalley",
      "south": __DIR__ "waterfall",
    ]));


  set("outdoors", "hsl");
  set("no_clean_up", 0);

  setup();

}
