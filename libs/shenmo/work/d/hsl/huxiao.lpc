inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "呼啸平原");
  set("long", @LONG

这儿是经常有巨大的黄蜂和类似豺狼的凶牙鬼出没的呼啸平原，
到处都是高大的乔木群和大片大片的原始草地。往北是通往翼人
国度的那可那鲁边境，往东北则是更加阴暗和恐怖的宁静之森。
LONG);

  set("exits",
    ([
      "north": __DIR__ "aiwatai1",
      "northeast": __DIR__ "stillforest_start",
      "southeast": __DIR__ "milanduo_wsub",
    ]));

  set("outdoors", "hsl");
  set("no_clean_up", 0);

  setup();

}
