inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "回音之谷");
  set("long", @LONG

这儿就是利鲁玛山地的最北端回音之谷。这是个清幽而美丽的
山谷，谷中四面高山由如一道道绿色屏风，将山谷与外界隔离
了开来，而这些屏风又有类似镜子的作用，反射你的声音，疾
呼一声便能听到万声齐应，山谷从而得其名。
LONG);

  set("exits",
    ([
      "east": __DIR__ "valleypath1",
      "west": __DIR__ "valleypath2",
      "south": __DIR__ "valleypath3",
    ]));

  set("objects",
    ([
      "/d/hsl/npc/master/magiczhangmen": 1,
    ]));

  set("outdoors", "hsl");
  //set("no_clean_up",0);

  setup();

}
