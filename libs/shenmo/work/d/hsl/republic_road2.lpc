inherit ROOM;
#include <ansi.h>

void create ()
{
  set ("short","大道");
  set ("long", @LONG

这是通往克莱恩城的大道，路面十分平坦而且宽广，足足可以
并行十几辆马车，来往的行人络绎不绝。
LONG);

  set("exits", 
  ([  
         "north": __DIR__"republic_bridge",
         "south": __DIR__"republic_road1",
  ]));

       
 set("outdoors", "hsl");
 set("no_clean_up", 0);
    
 setup();
 replace_program(ROOM);

}



