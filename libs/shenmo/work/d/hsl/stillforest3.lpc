inherit ROOM;
#include <ansi.h>

void create ()
{
  set ("short","宁静之森");
  set ("long", @LONG

这是个异常宁静的森林，你听不到一丝人或者野兽的声响，连
鸟儿和昆虫都没有了叫声，一切都是静悄悄的，只有树叶落地
的唰唰声，让人不由得毛骨悚然。
LONG);

  set("exits", 
  ([  
  	"northeast" : __DIR__"stillforest4",
       "southwest" : __DIR__"stillforest2",
       "northwest" : __DIR__"stillforest11",
       "southeast" : __DIR__"stillforest7",
  ]));

//  set("outdoors", "hsl");
  set("no_clean_up", 0);
    
 setup();
 replace_program(ROOM);

}



