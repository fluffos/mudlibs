inherit ROOM;

#include <ansi.h>

void create() {
  set("short", "盘山路");
  set("long", @LONG

一条弯弯曲曲的盘山小径，从这儿走能够环绕着山腰到达山的另一
面，而免去从山顶翻越之劳累。
LONG);

  set("exits",
    ([
      "northeast": __DIR__ "ewpath4",
      "southwest": __DIR__ "wshanyao",
    ]));
  set("outdoors", "hsl");
  set("no_clean_up", 0);
  setup();
}
