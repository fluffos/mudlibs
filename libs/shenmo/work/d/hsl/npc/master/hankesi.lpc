inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void re_rank( object );

void create()
{
       set_name("汉克斯", ({"hankesi"}));
       set("long", "巴格拉姆山区盗贼团首领，\n他原先是拉尔斯帝国暗杀总队队长，帝国的金牌杀手。\n");
       set("title", RED"暗 杀 者 "NOR);
       set("rank_info/respect", "英雄");
       set("gender", "男性");
       set("age", 30);
	set("class", "hsl_might");
       set("attitude", "heroism");
       set("per", 30);
	set("looking", "身材不高，看上去身手相当敏捷，两眼偶尔会闪过一击必杀的电光。");
       set("max_kee", 2000);
       set("max_sen", 2000);
       set("force", 2100);
       set("max_force", 2100);
       set("force_factor", 105);
       set("max_mana", 1800);
       set("mana", 1800);
       set("mana_factor", 91);
       set("combat_exp", 2000000);
       set("daoxing", 500000);
		set_skill("literate", 150);
		set_skill("unarmed",150);
		set_skill("dodge", 200);
		set_skill("parry", 160);
		set_skill("dagger", 200);
		set_skill("spells", 120);
		set_skill("windspells", 120);
		set_skill("starforce", 140);
		set_skill("force", 140);
		set_skill("xukong-steps", 160);
	map_skill("spells", "windspells");
	map_skill("force", "starforce");
	map_skill("dodge", "xukong-steps");
       set("inquiry", ([
	"name": "你是谁？为什么要问我的名字？",
	"here": "哼，自己看！",
	"缇娜": "我永远是缇娜公主的忠实仆人。",
      	]));


create_family("幻世勇者", 1, "弟子");
setup();

        carry_object("/d/hsl/obj/yingshaxue")->wear();
        carry_object("/d/hsl/obj/xingyedagger")->wield();
}

void attempt_apprentice(object ob)
{	
             command("say 我目前不收徒，这位" + RANK_D->query_respect(ob) +"还是去另拜高明吧！\n");
             return;
 }
	





