// bulaite.c

inherit NPC;
inherit F_MASTER;
#include <ansi.h>
string skill_lvl();
int improve(string arg);
void re_rank(object);

void create() {
  set_name(HIW "布莱特" NOR, ({ "bulaite" }));
  set("long", "他就是魔神战争时期的众英雄领袖，大剑皇布莱特。\n");
  set("title", HIY "幻世英雄 " NOR);
  set("rank_info/respect", "英雄");
  set("gender", "男性");
  set("age", 25);
  set("class", "hsl_might");
  set("attitude", "heroism");
  set("per", 30);
  set("looking", "是个充满豪情与正义感的真理战士，他的双目永远燃烧着热情的火焰。");
  set("max_kee", 4500);
  set("max_sen", 4000);
  set("force", 8000);
  set("max_force", 8000);
  set("force_factor", 300);
  set("max_mana", 8000);
  set("mana", 8000);
  set("mana_factor", 300);
  set("combat_exp", 10000000);
  set("daoxing", 8000000);
  set("skill_level/sword", "master");
  set("skill_level/axe", "master");

  set_skill("literate", 250);
  set_skill("unarmed", 300);
  //           set_skill("shenfa-quan",300);
  set_skill("dodge", 300);
  set_skill("parry", 300);
  set_skill("sword", 300);
  set_skill("tianlei-sword", 300);
  set_skill("spells", 300);
  set_skill("windspells", 300);
  set_skill("shenfa-quan", 300);
  map_skill("unarmed", "shenfa-quan");
  set_skill("starforce", 300);
  set_skill("force", 300);
  set_skill("xukong-steps", 300);
  set_skill("axe", 300);
  map_skill("spells", "windspells");
  //      map_skill("unarmed","shenfa-quan");
  map_skill("force", "starforce");
  map_skill("parry", "tianlei-sword");
  map_skill("dodge", "xukong-steps");
  map_skill("sword", "tianlei-sword");
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: command("perform qizhan") :),
    (: command("perform shan") :),
    (: command("perform moon") :)
  }));
  set("inquiry", ([
    "name": "我就是布莱特，找我有什么事？",

  ]));


  create_family("幻世勇者", 1, "弟子");
  setup();

  carry_object("/d/hsl/obj/heroshoes")->wear();
  carry_object("/d/hsl/obj/holysword")->wield();
}

void attempt_apprentice(object ob) {

  ob = this_player();

  if (!((string)ob->query("gender") == "男性")) {
    command("shake");
    command("say 幻世勇者不收女弟子，这位" +
      RANK_D->query_respect(ob) + "还是另请高就吧。\n");
    return;
  }
  if (ob->query("obstacle/number") < 34) {
    command("say 这位" + RANK_D->query_respect(ob) + "我等你取经归来的好消息！\n");
    command("addoil");
    return;
  }
  if ((int)ob->query("combat_exp") < 1200000) {
    command("shake");
    command("say 这位" + RANK_D->query_respect(ob) + "，你的武学还不够。\n");
    return;
  }

  command("pat " + ob->query("id"));
  command("say 很好，" + RANK_D->query_respect(ob) + "，我收下你了。\n");
  command("recruit " + ob->query("id"));
  re_rank(ob);
  ob->save();
  return;
}

int recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "hsl");
}

void re_rank(object ob) {
  int exp;
  exp = (int)ob->query("combat_exp");
  if (exp < 1600000) {
    ob->set("title", HIW "终 焉 剑 使 " NOR);
    return;
  } else {
    ob->set("title", HIY "大 剑 皇 " NOR);
    return;
  }
}
