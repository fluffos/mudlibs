// xuela.c
// 一个有趣的mm

inherit NPC;
inherit F_MASTER;
#include <ansi.h>
#include <combat.h>

void re_rank(object);
int showy();

void create() {
  set_name("雪拉", ({ "xuela" }));
  set("long", "常常在森林中玩耍的妖精族女孩，\n不过你可千万别小看她，她可是拥有强大法力的哦！\n");
  set("title", HIM "可爱的妖精" NOR);
  set("rank_info/respect", "天使");
  set("gender", "女性");
  set("age", 18);
  set("class", "hsl_magic");
  set("attitude", "peaceful");
  set("per", 40);
  set("max_kee", 1500);
  set("max_sen", 3000);
  set("force", 1800);
  set("max_force", 1800);
  set("force_factor", 90);
  set("max_mana", 3300);
  set("mana", 3300);
  set("mana_factor", 166);
  set("combat_exp", 800000);
  set("daoxing", 2500000);
  set_skill("literate", 150);
  set_skill("unarmed", 100);
  set_skill("dodge", 180);
  set_skill("parry", 120);
  set_skill("staff", 150);
  set_skill("sanchen-staff", 180);
  set_skill("spells", 220);
  set_skill("wanxi-spells", 220);
  set_skill("wanxi-force", 120);
  set_skill("force", 120);
  set_skill("charmingdance", 200);
  set_skill("blade", 20);
  set_skill("loveblade", 300);
  set_skill("eyesword", 300);
  set_skill("couplezhang", 300);
  map_skill("spells", "wanxi-spells");
  map_skill("force", "wanxi-force");
  map_skill("parry", "sanchen-staff");
  map_skill("dodge", "charmingdance");
  map_skill("staff", "sanchen-staff");
  map_skill("blade", "loveblade");
  map_skill("sword", "eyesword");
  map_skill("unarmed", "couplezhang");
  set("chat_chance", 1);
  set("chat_msg", ({
    (: showy() :),
  }));
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: command("perform fengmo") :),
    (: command("cast hufa") :),
    (: command("cast fire") :),
    (: command("cast water") :),
  }));
  set("inquiry", ([
    "name": "我决不会把我的芳名雪拉告诉你听的，哼哼～～。",
    "here": "不是清清楚楚写着“寂静之森”吗？笨笨:P",
    "雷欧纳德": "他是个帅哥哦，缇娜好像有点喜欢上他了，别告诉别人哦！",
    "雷特": "别急别急，等tonii把其他要紧咚咚搞定后，他会做我和他之间的秘密的。嘻嘻！",
  ]));


  create_family("幻世魔导", 1, "弟子");
  setup();

  carry_object("/d/hsl/obj/dadipao")->wear();
  carry_object("/d/hsl/obj/guarderstaff")->wield();
}

void die() {
  set("eff_kee", 100);
  set("eff_sen", 100);
  set("kee", 100);
  set("sen", 100);
  command("say 一点都不好玩，你赖皮！");
  command("say 讨厌，不跟你玩了！");
  this_object()->remove_all_killer();
  all_inventory(environment())->remove_killer(this_object());
  return;
}

void unconcious() {
  die();
}

void attempt_apprentice(object ob) {
  ob = this_player();
  if (ob->query("gender") == "男性") {
    command("say 这位帅哥，幻世魔导不收男生，你还是去拜雷欧纳德他们吧！\n");
    return;
  }
  if (ob->query("family/family_name") != "幻世魔导") {
    command("say 这位美女，你还是先去问问克罗蒂JJ吧，她眼力好，不会收到傻孩子的说！\n");
    return;
  }
  command("jump");
  command("say 太好了，今天开始就让我宇宙超级无敌美少女雪拉来指点你吧。");
  command("recruit " + ob->query("id"));
  re_rank(ob);
  ob->save();
  return;
}

int recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "hsl");
}

void re_rank(object ob) {
  int exp;
  exp = (int)ob->query("daoxing");
  if (exp < 300000) {
    ob->set("title", "妖 精 ");
    return;
  } else if (exp < 1000000) {
    ob->set("title", "妖 精 使 ");
    return;
  } else {
    ob->set("title", HIM "妖 精 女 王 " NOR);
    return;
  }
}

int prevent_learn(object me, string skill) {

  if (skill == "eyesword" || skill == "loveblade" || skill == "couplezhang") {
    command("heng");
    command("say 教了你，我打不过你了怎么办，我要留着防身。");
    return 1;
  }
  return 0;
}

int showy() {
  command("unwield staff");
  command("wield staff");
  command("say 怎么样？这是长老送给我的法杖，是最最好的，嘻嘻~~");
  return 1;
}
