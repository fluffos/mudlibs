// tina.c

inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void re_rank( object );
string ask_mieyao();
string ask_cancel();
string avenge();
string ask_for_leave();

void create()
{
       set_name("缇娜", ({"princess tina","princess","tina"}));
       set("long", "拉尔斯帝国的公主缇娜。她出身于皇家，故而有一种高贵的气质，
感受性强，常会随情绪而改变自己的态度，并且对于某些事物有异
样的执著。从小就接受王家的英才教育，再加上拥有传说中的英雄
血统，所以在武术和魔法上都有相当程度的造诣及资质。虽然对于
父王的野心并不赞同，但却无可奈何，且对父王仍然抱持尊重与敬
爱，所以在亡国之后一心想为父王报仇图复国。\n");
       set("title", HIY"复国公主"NOR);
       set("rank_info/respect", "公主");
       set("gender", "女性");
       set("age", 20);
	set("class", "hsl_magic");
       set("attitude", "peaceful");
       set("per", 40);
       set("max_kee", 2500);
       set("max_sen", 3000);
       set("force", 3000);
       set("max_force", 3000);
       set("force_factor", 150);
       set("max_mana", 3300);
       set("mana", 3300);
       set("mana_factor", 166);
       set("combat_exp", 2000000);
       set("daoxing", 3000000);
		set_skill("literate", 200);
		set_skill("unarmed",150);
		set_skill("dodge", 200);
		set_skill("parry", 150);
		set_skill("staff", 200);
		set_skill("sanchen-staff", 190);
		set_skill("spells", 220);
		set_skill("wanxi-spells", 220);
		set_skill("wanxi-force", 200);
		set_skill("force", 200);
		set_skill("charmingdance", 200);
      set_skill("shenfa-quan", 150);
    map_skill("unarmed", "shenfa-quan");
	map_skill("spells", "wanxi-spells");
	map_skill("force", "wanxi-force");
	map_skill("parry", "sanchen-staff");
	map_skill("dodge", "charmingdance");
	map_skill("staff", "sanchen-staff");
	set("chat_chance_combat", 60);
       set("chat_msg_combat", ({
		(: command("perform fengmo") :),
		(: command("cast hufa") :),
              (: command("cast fire") :),
              (: command("cast water") :),
        }) );
       set("inquiry", ([
	"name": "你好，我的名字叫缇娜。",
	"here": "他们把我囚禁在这里，不过我今晚就会逃出去的。",
	"雷欧纳德": "雷……雷……",
       "final": "能麻烦你把福音之书找来吗？我好根据其中的记载给你正确的指点。",
       "福音之书":"传说福音之书在冀罗王国的某个秘密地方。",
 //      "神谕": (: ask_mieyao :),
 //      "leave" : (: ask_for_leave :),
	]));


create_family("幻世魔导", 1, "弟子");
setup();

        carry_object("/d/hsl/obj/xiwupao")->wear();
        carry_object("/d/hsl/obj/shenglingzhang")->wield();
}

void init()
{
add_action("do_kneel","kneel");
add_action("do_agree", "agree");
}

void attempt_apprentice(object ob)
{	ob=this_player();
       if( ob->query("gender") == "男性"){
             command("say 这位" + RANK_D->query_respect(ob) +"，幻世魔导不收男弟子，你还是去拜雷欧纳德他们吧！\n");
             return;
       }
	if( (string)ob->query("family/family_name")=="幻世魔导") {
	if ((int)ob->query("daoxing") < 200000 ) {
  	command("say 这位" + RANK_D->query_respect(ob) + "道行不足，恐怕跟我学习会有难度。\n");
	return;
	}
       command("smile");
       command("say 太好了，今天开始" + RANK_D->query_respect(ob) + "你就跟着我学习吧。");
       command("recruit " + ob->query("id") );
       re_rank(ob);
       ob->save();
	return;
	}
       command("shake");
       command("say 你还是先跟着雪拉和克罗蒂学吧！\n");
       return;
}
int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "hsl");
}

string ask_mieyao()
{
    object who=this_player();

    if((string)who->query("family/family_name")=="幻世魔导") {
      command("smile "+who->query("id"));
      return "/d/obj/mieyao"->query_yao(who);
    }
    return ("非我门人,何故来此?\n");
}

void re_rank(object ob)
{
      int exp; 
      exp = (int)ob->query("daoxing"); 
      if( exp < 300000 ) { 
           ob->set("title","神 官 "); 
           return ; 
      }
      else if ( exp < 1000000 ) {
           ob->set("title","大 祭 司 ");
           return;
      }
      else {
           ob->set("title",HIY"制 裁 者 "NOR);
           return;
      }
}

int do_kneel()
{
    object who = this_player();
    if((string)who->query("family/family_name")!="幻世魔导")
     return notify_fail(this_object()->query("name")+"说：你又不是我门弟子，拜我干什么？\n");
   if("/d/obj/mieyao"->delete_mieyao(who)){
        command("say 既然如此，就算了吧，不过你没有完成任务，得受些惩罚！\n");
	who->add("faith",-5);
        message_vision("$N的忠诚度下降了！\n",who);
     }
}

string ask_for_leave()
{
	object me=this_player();

	if (me->query("family/family_name") == "幻世魔导" ) {
		command("say 要走的终归要走，我不会留你，但是有点要说明：");
		me->set_temp("betray", 1);
		return ("脱离师门要需要有一定惩罚，你可愿意(agree)？");
	}

	return ("你问我干嘛？\n");
}

int do_agree(string arg)
{
	if(this_player()->query_temp("betray")) {
		message_vision("$N答道：弟子愿意。\n\n", this_player());
		command("say 你走吧，自己保重！");
		this_player()->add("betray/count", 1);
		this_player()->add("betray/hsl_magic", 1);
		this_player()->set("daoxing", this_player()->query("combat_exp")*80/100);
		if( this_player()->query_skill("sanchen-staff") )
		{
		    this_player()->delete_skill("sanchen-staff");
			this_player()->map_skill("staff");
		}

		if( this_player()->query_skill("wanxi-spells") )
		{
	            this_player()->delete_skill("wanxi-spells");
				this_player()->map_skill("spells");
		}
		
		this_player()->delete("family");
		this_player()->delete("class");
		this_player()->delete("faith");
		this_player()->set("title", "普通百姓");
		this_player()->set_temp("betray", 0);
		this_player()->save();
		command("say 江湖风波，善恶无形，好自为之。。。\n");
		return 1;
	}
}




