#include <ansi.h>

inherit NPC;

void create() {
  set_name("服务员小姐", ({ "waitress" }));
  set("gender", "女性");
  set("long", "一位笑眯眯的服务员小姐。\n");
  set("age", 20);
  set("per", 22);
  set("combat_exp", 1000);
  set("attitude", "peaceful");
  set("max_kee", 200);
  set("max_sen", 200);

  setup();

  carry_object("/d/obj/cloth/skirt")->wear();

}
