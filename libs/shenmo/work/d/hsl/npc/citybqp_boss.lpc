//citybqp_boss.c

inherit F_VENDOR_SALE;

void create() {
  reload("citybqp_boss");
  set_name("肯修特", ({ "boss kenxiute", "boss", "kenxiute" }));
  set("title", "武器店老板");
  set("gender", "男性");
  set("age", 40);
  set("long", "克莱恩城武器店的老板。");
  set("combat_exp", 10000);
  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  set_skill("parry", 50);

  set("vendor_goods", ([
    "westsword": "/d/hsl/obj/westsword.lpc",
    "magicstaff": "/d/hsl/obj/magicstaff.lpc",
  ]));

  setup();
  carry_object("/d/obj/cloth/choupao")->wear();

}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || !visible(ob) || environment(ob) != environment()) return;
  switch (random(3)) {
    case 0:
      say(name() + "抱歉地说：“小店的货几乎被抢购一空，没几样了！\n真不好意思，我们很快会进新货的！”\n");
      break;
  }
}
