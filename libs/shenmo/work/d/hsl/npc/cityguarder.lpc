// cityguarder.c

inherit NPC;

void create() {
  set_name("守城卫士", ({ "city guarder", "guarder" }));
  set("gender", "男性");
  set("age", random(20) + 20);
  set("str", 25);
  set("long", "守城门的卫士，是军队中一流的战士。\n");
  set("combat_exp", 30000);
  set("attitude", "peaceful");

  set_skill("unarmed", 80);
  set_skill("force", 80);
  set_skill("sword", 80);
  set_skill("dodge", 80);
  set_skill("parry", 80);
  set("max_kee", 700);
  set("max_sen", 600);
  set("force", 400);
  set("max_force", 400);
  set("force_factor", 15);
  set("max_mana", 100);
  set("mana", 100);
  set("mana_factor", 5);
  setup();
  carry_object("/d/obj/weapon/sword/changjian")->wield();
  carry_object("/d/obj/armor/tiejia")->wear();
}

int accept_fight(object me) {
  message_vision("守城卫士对$N把眼一瞪，喝道：呔，大胆，还不退下！\n\n", me);
  return 0;
}
