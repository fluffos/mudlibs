// ROOM: /d/hsl/city_tavern

inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "酒馆");
  set("long", @LONG

一家装璜豪华的酒馆，酒馆内有十几张大圆桌和几十张小方
桌，酒馆的服务生穿花般地跑前跑后十分忙碌，在这儿顾客
们喝酒聊天，如果注意打听的话，还能获得不少有用的消息
呢。
LONG);

  set("exits",
    ([
      "west": __DIR__ "city_street1",
    ]));


  set("objects",
    ([
      "/d/hsl/npc/chiefwaitress": 1,
      "/d/hsl/npc/jiuke": 2,
    ]));


  set("no_clean_up", 0);

  setup();

}
