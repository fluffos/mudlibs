inherit ROOM;

string check_exit()
{
string exit;    
object me = this_player();
if ( me->query("family/family_name")!="少林寺"
  && me->query("bellicosity")>=500 )
        exit = "/d/southern/wutai/guandao3";
else    exit = "/d/shaolin/shanjiao";
return exit;
}

void create()
{
set("short", "官道");
set("long", @LONG
    

　　一条宽阔的大道，贯穿南北，直同边关，东北有条
大官道通向远方。

LONG );


set("exits", ([
        "north"   : __DIR__"guandao2",
        "west"   : "/d/kaifeng/tieta",
        "northeast"   : "/d/shoucheng/broadway4",
        "east"   : (: check_exit: ),
 
]));
set("outdoors", 1);
setup();
}

