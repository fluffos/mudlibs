void init() {
  //wuxia预留的bug,不知道什么时候开了
  //fang 2011.11.12
  //add_action("do_dig","dig");
}

int do_dig(string arg) {
  object obj;
  object me = this_player();
  if (!arg || !me)
    return notify_fail("你想挖什么？\n");
  if (arg == "stone") {
    //       obj=new("/clone/money/jinbi");
    obj = new("/d/eastway/qinling/obj/xiangyabox1");
    obj->move(me);
  }
  if (arg == "happy") {
    obj = new("/d/eastway/qinling/obj/lingzhi31");
    obj->move(me);
  }
  if (arg == "jinbi") {
    obj = new("/d/emei/st4");
    obj->move(me);
  }
  if (arg == "dan") {
    obj = new("/d/emei/st3");
    obj->move(me);
  }
  return 1;
}
