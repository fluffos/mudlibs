#include <ansi.h>

inherit ROOM;
void create ()
{
  set ("short", "休息室");
  set ("long", @LONG

这里是神策军的祭台，你可以试着祭拜一下。
LONG);

  set("item_desc", ([ /* sizeof() == 1 */
  "祭台" : "
祭台上有挂了一幅画，你可以试着祭拜(jibai)一下。
",
 
]));
  set("resource", ([
        "water": 1
        ]) );
  set("if_bed", 1);
  set("no_fight", 1);
  set("no_magic", 1);
  set("objects", ([ /* sizeof() == 1 */
//    __DIR__"npc/xiaotong" : 2,
]));
  set("exits", ([ /* sizeof() == 2 */
                 "east" : __DIR__"front_yard2.lpc",
                 ]));
  
  set("no_get", 1);

  setup();
}

void init()
{
  add_action("do_jibai", "jibai");
   
}




int do_jibai(string arg)
{
  object me=this_player();
 
  if(me->query("family/family_name") != "神策军" )
        return notify_fail(CYN"你是神策军的人吗？\n"NOR);
  message_vision( "$N拈香向祖师一拜。\n", me);
  me->set("water", me->max_water_capacity());
  me->set("food", me->max_food_capacity());
        me->set("kee", me->query("eff_kee"));
        me->set("sen", me->query("eff_sen"));
        me->set("force", me->query("max_force"));
        me->set("mana", me->query("max_mana"));

  
}

