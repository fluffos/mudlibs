
inherit NPC;
inherit F_MASTER;
string ask_mieyao();
string ask_cancel();
void create()
{
  set_name("小春子", ({ "xiao chunzi", "chun", "xiao", "gong", "gong gong" }));
  set("gender", "无性");
  set("age", 43);
  set("str", 30);
  set("per", 26);
  set("int", 30);
  set("cor", 50);
  set("cps", 50);
  set("long", "高力士旁边的小太监。\n");
  set("combat_exp", 1200000);
    set("max_sen", 2800);
 set_skill("kuihua-shengong", 10);
 set_skill("kuihua-baodian", 10);
 set_skill("kuihua-xinfa", 10);
  set("max_kee", 4400);
  set("force", 2000);
  set("max_force", 1800);
  set("force_factor", 80);
  set("inquiry", ([
 "cancel": (: ask_cancel :),
                   "name": "在下小春子。",
                   

                  "灭佛": (: ask_mieyao :),
                   ]) );

  create_family("神策军", 3, "紫");
  set("chat_chance_combat", 60);
  
  set("class", "needle");

  setup();
  
  carry_object("/d/obj/armor/tiejia")->wear();
 
}

string ask_mieyao()
{
  object me=this_player();
  if(me->query("family/family_name")!="神策军")
     return ("你不是本门中人！");
  command("smile "+me->query("id"));
  return "/d/obj/mieyao"->query_yao(me);
}


int attempt_apprentice(object me)
{
  string myname=RANK_D->query_respect(me);
  if ((int)me->query("combat_exp")< 100000)
    {
      command("say 这位"+myname+"还是先去跟打打基础吧！");
      return 0;
    }
  command("haha");
  command("say 很好，时下正是用人之际，"+myname+"多加努力，他日必定有成。\n");
  command("recruit " + me->query("id") );
  return 1;
}
int recruit_apprentice(object ob)
{
  if( ::recruit_apprentice(ob) )
    ob->set("class", "needle");
}

string ask_cancel()
{
    object me=this_player();
if((int)me->query_temp("mpmieyao"))
{
      me->add("daoxing",-2000);
      me->delete_temp("mpmieyao");
      me->delete("mpmieyao");
      me->delete("mpmieyao/type");
      me->delete("mpmieyao/location");
      me->delete("mpmieyao/place");
      me->delete("mpmieyao/name");
      me->delete("mpmieyao/id");
      me->set("mpmieyaook/done");
     return ("没用的东西！");
}
else
{
     return ("你有任务吗？！");
}
}

