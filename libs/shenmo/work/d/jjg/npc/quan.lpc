
//gunseng.c
#include <ansi.h>

int ask_name(); 

inherit NPC;
inherit F_MASTER;
void create()
{

set_name("拳掌师傅", ({ "quanzhang","taijian", }));
        set("gender", "无性" );
        create_family("神策军", 2, "太监之王");
        set("title",HIR"神策军拳掌师傅"NOR );
        set("age", 605);
        set("long",
                "他是王帝陛下教头，专门教习拳掌功夫。\n"
                "他身材矮胖，满面红光，一脸的阴险。\n"
        );
        set("class", "needle");
        set("attitude", "friendly");

        set("max_force", 30000);
        set("force_factor", 500);
        set("mana", 20000);
        set("max_mana", 30000);
        set("mana_factor", 200);
        set("combat_exp", 18000000);
        set("daoxing", 25000000);
        set_skill("kuihua-xinfa", 700);
        set_skill("suiyu-zhang", 300);
        set_skill("spells", 300);
        set_skill("force", 300);
        set_skill("dodge", 280);
        set_skill("zhaixing-shou", 300);
        set_skill("blade", 300);
        set_skill("whip", 300);
        set_skill("guimei", 400);
        set_skill("needle", 400);
        set_skill("parry", 280);
        set_skill("throwing", 280);
        set_skill("unarmed", 280);
        set_skill("libieyu", 650);
        set_skill("xiuhua-zhen", 650);
        set_skill("pixie-mijian", 850);
        set_skill("lingfan", 200);
        set_skill("literate", 250);
        set_skill("xixingdafa", 250);
        map_skill("blade", "qiushen-blade");
        map_skill("unarmed", "suiyu-zhang");
        map_skill("dodge", "guimei");
        map_skill("parry", "suiyu-zhang");
        map_skill("force", "kuihua-dafa");
        map_skill("sword", "siqi-sword");

        set("max_kee", 3300);
        set("max_sen", 3300);
        setup();
        carry_object("/d/moon/obj/luoyi")->wear();
        carry_object("/d/obj/weapon/sword/qinghong")->wield();


}
void attempt_apprentice(object ob)
{
        object me; 
        mapping ob_fam, my_fam;
        string name, new_name;

        me = this_object();
        my_fam  = me->query("family");
        name = ob->query("name");

if (!ob->query("zhuanshi")  )   
         {   
         command("say 只有转世之人可以拜我！");  
         return;  
         }  
        command("say 既然你这么有诚意那就收下你把！");
        command("recruit " + ob->query("id"));
        ob->set("title", HIR"神策军拳师"NOR);
}
