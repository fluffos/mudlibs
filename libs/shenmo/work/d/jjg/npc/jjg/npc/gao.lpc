inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void create() {
  set_name("高力士", ({ "gao lishi", "li shi" }));
  set("long",
    "唐王座下神策军大内侍卫。\n");
  set("title", "神策军第二代弟子");
  set("gender", "无性");
  set("age", 20);
  set("class", "needle");
  set("attitude", "friendly");
  set("per", 30);
  set("int", 30);
  set("max_kee", 29000);
  //       set("max_gin", 2600);
  set("max_sen", 10000);
  set("force", 8000);
  set("max_force", 8000);
  set("force_factor", 200);
  set("max_mana", 8000);
  set("mana", 8000);
  set("mana_factor", 40);
  set("combat_exp", 80000000);
  set("daoxing", 80000000);
  set("eff_dx", 80000000);
  set("nkgain", 350);
  set_skill("kuihua-baodian", 280);
  set_skill("literate", 280);
  set_skill("force", 280);
  set_skill("unarmed", 280);
  set_skill("dodge", 280);
  set_skill("kuihua-dianxue", 280);
  set_skill("parry", 280);
  set_skill("sword", 280);
  set_skill("spells", 280);
  set_skill("kuihua-xinfa", 500);
  set_skill("pixie-canjian", 500);
  set_skill("duanyun-bian", 150);
  set_skill("qiushen-blade", 50);
  set_skill("guimei", 280);
  set_skill("blade", 50);
  set_skill("whip", 180);

  map_skill("force", "kuihua-xinfa");
  map_skill("spells", "kuihua-baodian");
  map_skill("sword", "pixie-jian");
  map_skill("unarmed", "kuihua-dianxue");
  map_skill("parry", "pixie-jian");
  map_skill("dodge", "guimei");



  set("chat_chance", 5);
  set("chat_msg", ({
    HIM "天干物燥，小心火烛！\n" NOR,
  }));


  create_family("神策军", 2, "弟子");
  setup();

  carry_object("/d/moon/obj/luoyi")->wear();
  carry_object("/d/obj/weapon/sword/qinghong")->wield();
}

void attempt_apprentice(object ob) {
  ob = this_player();

  /*if (ob->query("zhuanshi") >= 1)
    {
        command("say 这位" + RANK_D->query_respect(ob) + "你已经转世过了，再也不可能学全我门的功夫！\n");
        command("sigh");
        return;
    }*/

  if ((int)ob->query("pending/kick_out")) {
    command("say 这位" + RANK_D->query_respect(ob) + "老夫平生最恨不忠不义之人！\n");
    command("heng");
    return;
  }

  command("haha");
  command("recruit " + ob->query("id"));
  ob->set("gender", "无性");
  ob->set("class", "needle");
  ob->save();

  return 0;
}
