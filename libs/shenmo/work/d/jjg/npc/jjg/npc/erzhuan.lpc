
//gunseng.c
#include <ansi.h>

int ask_name(); 

inherit NPC;
inherit F_MASTER;
void create()
{

set_name("2转师傅", ({ "shifu","taijian", }));
        set("gender", "无性" );
        create_family("神策军", 2, "太监之王");
        set("title",HIR"一人之下万人之上"NOR );
        set("age", 605);
        set("long",
                "他是王帝陛下太监大总管，统领整个东厂西厂。\n"
                "他身材矮胖，满面红光，一脸的阴险。\n"
        );
        set("class", "needle");
        set("attitude", "friendly");

        set("max_force", 30000);
        set("force_factor", 500);
        set("mana", 20000);
        set("max_mana", 30000);
        set("mana_factor", 200);
        set("combat_exp", 18000000);
        set("daoxing", 25000000);
        set_skill("kuihua-xinfa", 700);
        set_skill("qiushen-blade", 500);
        set_skill("spells", 300);
        set_skill("force", 300);
        set_skill("dodge", 280);
        set_skill("guimei", 280);
        set_skill("blade", 300);
        set_skill("pixie-mijian", 300);
        set_skill("pixie-canjian", 350);
        set_skill("rouqingjian", 500);
        set_skill("xuantian-sword", 580);
        set_skill("parry", 280);
        set_skill("unarmed", 280);
        set_skill("literate", 250);
        set_skill("siqi-sword", 280);
        map_skill("blade", "qiushen-blade");
        map_skill("unarmed", "suiyu-zhang");
        map_skill("dodge", "guimei");
        map_skill("parry", "suiyu-zhang");
        map_skill("force", "kuihua-dafa");
        map_skill("sword", "siqi-sword");

        set("max_kee", 3300);
        set("max_sen", 3300);
        setup();
        carry_object("/d/shaolin/obj/xuan-cloth")->wear();


}
void attempt_apprentice(object ob)
{
        object me; 
        mapping ob_fam, my_fam;
        string name, new_name;

        me = this_object();
        my_fam  = me->query("family");
        name = ob->query("name");

   

          if( (int)ob->query_skill("kuihua-xinfa",1) < 750)
        {
        command("say " + RANK_D->query_respect(ob) + "，你你的葵花心法修为不够750，不能拜师。");
          if( (int)ob->query_skill("pixie-canjian",1) < 750)
        {
        command("say " + RANK_D->query_respect(ob) + "，你你的辟邪残剑修为不够750，不能拜师。");
          if( (int)ob->query_skill("pixie-mijian",1) < 750)
        {
        command("say " + RANK_D->query_respect(ob) + "，你你的辟邪密剑修为不够750，不能拜师。");
                return;
        }


        command("say 既然你这么有诚意那就收下你把！");
        command("recruit " + ob->query("id"));
        ob->set("title", HIR"大内掌印太监"NOR);
}