//gunseng.c
#include <ansi.h>

int ask_name();

inherit NPC;
inherit F_MASTER;

string ask_for_prom();
private void jjg_choose_name(string arg, object who);

void create() {

  set_name("九千岁", ({ "jiuqiansui", "taijian", }));
  set("gender", "无性");
  create_family("神策军", 2, "太监之王");
  set("title", HIR "一人之下万人之上" NOR);
  set("age", 605);
  set("long",
    "他是王帝陛下太监大总管，统领整个东厂西厂。\n"
    "他身材矮胖，满面红光，一脸的阴险。\n"
  );
  set("class", "needle");
  set("attitude", "friendly");

  set("max_force", 30000);
  set("force_factor", 500);
  set("mana", 20000);
  set("max_mana", 30000);
  set("mana_factor", 200);
  set("combat_exp", 18000000);
  set("daoxing", 25000000);
  set_skill("kuihua-xinfa", 700);
  set_skill("qiushen-blade", 500);
  set_skill("spells", 300);
  set_skill("force", 300);
  set_skill("dodge", 280);
  set_skill("guimei", 280);
  set_skill("blade", 300);
  set_skill("pixie-mijian", 300);
  set_skill("pixie-canjian", 350);
  set_skill("rouqingjian", 500);
  set_skill("xuantian-sword", 580);
  set_skill("duanzijuesun-tui", 580);
  set_skill("parry", 280);
  set_skill("unarmed", 280);
  set_skill("literate", 250);
  set_skill("siqi-sword", 280);
  map_skill("blade", "qiushen-blade");
  map_skill("unarmed", "suiyu-zhang");
  map_skill("dodge", "guimei");
  map_skill("parry", "suiyu-zhang");
  map_skill("force", "kuihua-dafa");
  map_skill("sword", "siqi-sword");

  set("max_kee", 3300);
  set("max_sen", 3300);
  set("inquiry", ([
    "升职": (: ask_for_prom :),
    "升官": (: ask_for_prom :),
  ]));
  setup();
  carry_object("/d/shaolin/obj/xuan-cloth")->wear();


}
void attempt_apprentice(object ob) {
  object me;
  mapping ob_fam, my_fam;
  string name, new_name;

  me = this_object();
  my_fam = me->query("family");
  name = ob->query("name");



  if ((int)ob->query_skill("kuihua-xinfa", 1) < 450) {
    command("say " + RANK_D->query_respect(ob) + "，你你的葵花心法修为不够，不能越级拜师。");
    return;
  }


  command("say 既然你这么有诚意那就收下你把！");
  command("recruit " + ob->query("id"));
  ob->set("title", HIR "神策军八千岁" NOR);
}

string ask_for_prom() {
  object me, ob;
  ob = this_player();
  me = this_object();

  if (ob->query("family/family_name") != me->query("family/family_name")) {
    command("shake");
    return ("到宫里开这种玩笑，这位" +
      RANK_D->query_respect(ob) + "，这可是掉脑袋的事情。\n");
  }
  if (ob->query("age") < 15 || ob->query("combat_exp") < 30000000) {
    return ("你尚未成年,还需要多多锻炼才是。\n");
  }

  if (!ob->query_temp("jjg_ask_rename")) {
    message_vision(HIG "$n屈身上前，半跪在$N身前，一脸谄媚的假笑着：“九千岁大人，奴才我跟您也这么多年了，求您提拔提拔奴才吧！”\n" NOR, me, ob);
    message_vision("说完$n磕头如捣蒜般的对$N跪拜起来，痛哭流涕！”\n", me, ob);
    ob->set_temp("jjg_ask_rename", 1);
    return 0;
  } else {
    message_vision("$N慢慢睁开双眼，看了$n一眼，左掌微微从衣袖中伸出，朝$n使了一个眼色！”\n", me, ob);
    message_vision("$n仿佛明白了点什么，用膝盖向前挪了挪，再次向$N磕起头来，“求九千岁大人成全，求九千岁大人成全！”\n", me, ob);
    return 0;
  }
}

int accept_object(object who, object ob) {
  object me = this_object();
  int value = ob->value();
  int required = ((50 - who->query("kar")) / 2) * 10000000;

  if (required < 100000000)
    required = 100000000;

  if (!who->query_temp("jjg_ask_rename")) {
    message_vision("$N摇了一下头，说道：放肆！你这是干什么，宫里自有宫里的规矩，你这样成何体统？\n", me);
    message_vision("$N满脸不悦的瞪着$n！\n", me, who);
    return 0;
  }

  if (value == 0) {
    message_vision("$N扯着尖嗓子：这宫里上上下下这么多人，哪里不需要用钱，皇上可是正等着用人呢！\n", me);
    call_out("return_ob", 1, ob, who);
    return 1;
  }

  if (value < required) {
    message_vision("$N哼了一声，拉长了褶子脸：哟，这位大公公是打发叫花子呢？\n", me);
    return 0;
  }
  message_vision("$n狠了狠心，往裤裆处一阵掏，寻了半天，偷偷将一物递给了$N！\n", me, who);
  message_vision("$N说道：这位小公公也为宫里办了不少的大事了，立了不少的功劳！\n", me);
  message_vision("$N微微探起身，向$n点了点头：咱家定当上奏，请皇上赏赐予你！\n", me, who);
  who->set_temp("jjg_gave_jinbi", 1);
  call_out("destruct_me", 1, ob);
  message_vision("$N沉思半响，哀怨地看了$n一眼：我们都是净了身的苦命之人，不知道小公公净身前，本家姓氏是...？\n", me, who);
  write("请输入你的姓氏：\n");
  write("(为了mud的整洁，请自行选择文明字眼，否则wiz组有权对你做出处理)\n");
  write(HIR "(没想好可以输入q退出，但是九千岁不会退给你钱的喔！)\n" NOR);
  input_to((: jjg_choose_name :), who);
  return 1;
}

void return_ob(object ob, object who) {
  if (ob)
    command("give " + ob->query("id") + " to " + who->query("id"));
}

void destruct_me(object ob) {
  if (ob)
    destruct(ob);
}

private void jjg_choose_name(string arg, object who) {
  int i;
  object me = this_object();
  if (arg == "") {
    write(HIG "请输入你的姓氏：\n" NOR);
    write("(为了mud的整洁，请自行选择文明字眼，否则wiz组有权对你做出处理)\n");
    input_to("jjg_choose_name", who);
    return;
  }
  i = strlen(arg);
  if (arg == "q") {
    who->delete_temp("jjg_gave_jinbi");
    this_object()->command("say 开什么玩笑，没想好不要来这里瞎捣乱，什么钱？哪有什么钱？小心要了你的脑袋！\n");
    //this_object()->command("give jinbi to "+who->query("id"));
    return 0;
  }
  if (strlen(arg) > 2 || !is_chinese(arg)) {
    write("输入不正确，请重新输入你的姓氏：\n");
    input_to("jjg_choose_name", who);
  }

  else {
    message_vision("$N朝$n使了个脸色。\n", this_object(), who);
    message_vision("$N点了点头，拿出一份卷宗写了几笔。\n", this_object());
    who->set("name", arg + "公公");
    who->set("title", "从御六品 敬事房");
    who->set("jjg_level", 6);
    who->add("potential", -1000);
    who->delete_temp("jjg_gave_jinbi", 1);
    who->delete_temp("jjg_ask_rename", 1);
    who->save();
    write("你的名字更改完毕。\n");
    command("chat 奉皇上圣谕，今有" + who->query("name") + "恪尽职守，特赐" + who->query("title") + "一职，钦此！");
  }
}
