string ask_cancel() {
  object me = this_player();
  if ((int)me->query_temp("mpmieyao")) {
    me->add("daoxing", -2000);
    me->delete_temp("mpmieyao");
    me->delete("mpmieyao");
    me->delete("mpmieyao/type");
    me->delete("mpmieyao/location");
    me->delete("mpmieyao/place");
    me->delete("mpmieyao/name");
    me->delete("mpmieyao/id");
    me->set("mpmieyaook/done");
    return ("没用的东西！");
  } else {
    return ("你有任务吗？！");
  }
}
