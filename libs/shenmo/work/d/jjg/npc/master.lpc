inherit NPC;
inherit F_MASTER;
string expell_me(object me);
string ask_mieyao();
string ask_cancel();
void create() {
  set_name("金灵圣母", ({ "jinling shengmu", "master", "sheng mu", "shifu" }));
  set("title", "通天弟子");
  set("gender", "无性");
  set("age", 43);
  set("class", "needle");
  set("attitude", "friendly");
  set("str", 30);
  set("per", 26);
  set("int", 30);
  set("cor", 50);
  set("cps", 50);
  set("long", "金灵圣母是截教通天教主坐下弟子。\n");
  set("combat_exp", 1200000);
  set_skill("kuihua-baodian", 700);
  set_skill("literate", 700);
  set_skill("force", 700);
  set_skill("unarmed", 700);
  set_skill("dodge", 700);
  set_skill("guimei", 100);
  set_skill("kuihua-dianxue", 700);
  set_skill("xuantian-sword", 280);
  set_skill("parry", 700);
  set_skill("sword", 700);
  set_skill("spells", 700);
  set_skill("throwing", 700);
  set_skill("kuihua-baodian", 100);
  set_skill("huanyue-jianfa", 50);
  set_skill("duanyun-bian", 150);

  set_skill("makeup", 700);
  set_skill("pixie-mijian", 700);
  set_skill("kuihua-nuoyi", 700);
  map_skill("force", "kuihua-shengong");
  map_skill("spells", "kuihua-baodian");
  map_skill("throwing", "pixie-mijian");
  map_skill("unarmed", "kuihuadianxue");
  map_skill("parry", "pixie-mijian");
  map_skill("dodge", "kuihua-nuoyi");
  set("force_factor", 80);
  set("inquiry", ([
    "name": "为师金灵圣母。",

    "cancel": (: ask_cancel :),
    // "leave": (: expell_me :),
    "灭佛": (: ask_mieyao :),
  ]));

  create_family("神策军", 1, "黄");
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: perform_action, "sword", "cimu" :),
  }));

  setup();
  carry_object("/d/obj/weapon/sword/qinghong")->wield();
  carry_object("/d/obj/armor/tiejia")->wear();

}

string ask_mieyao() {
  object me = this_player();
  if (me->query("family/family_name") != "神策军")
    return ("你不是本门中人！");
  command("smile " + me->query("id"));
  return "/d/obj/mieyao"->query_yao(me);
}
int accept_fight(object me) {
  command("say 我已经很久没有和人动手过招了，今日也不想破例。\n");
  return 0;
}
void attempt_apprentice(object ob) {
  if (ob->query_skill("pixie-mijian", 1) < 400) {
    command("say 我门最注重剑术的修行，依我看" + RANK_D->query_respect(ob) + "是不是该多下下苦功呢？");
    return;
    if (ob->query_skill("sword", 1) < 400) {
      command("say 我门最注重剑术的修行，依我看" + RANK_D->query_respect(ob) + "是不是该多下下苦功呢？");
      if (ob->query_skill("kuihua-xinfa", 1) < 400) {
        command("say 你的葵花心法不够高深，依我看" + RANK_D->query_respect(ob) + "是不是该多下下苦功呢？");
        return;
      }
      return;
    }
  }
  if ((int)ob->query_int() < 45) {
    command("say 依我看" + RANK_D->query_respect(ob) + "的资质似乎不适合学我的武功？");
    return;
  }

  command("say 好吧，我就收下你了。");
  command("recruit " + ob->query("id"));
  ob->set("class", "needle");
  ob->set("title", "圣母传人");
}



