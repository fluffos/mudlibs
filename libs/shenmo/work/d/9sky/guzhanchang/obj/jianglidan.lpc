
#include <ansi.h>
inherit ITEM;

void setup()
{}

void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name(HIR"奖励丹"NOR, ({"jiangli dan", "dan"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "棵");
                set("long", "一粒奖励丹，吃了能功力倍增,是难得的灵丹妙药,可以加10万点经验。\n");
                set("value", 10000);
        }
        setup();
}

int do_eat(string arg)
{
        object me = this_player();

        if (!id(arg))
        return notify_fail("你要吃什么？\n");
if (this_player()->query("gift/jiangli") >= 2)
             {
                message_vision("$N突然放了一个奇臭无比的响屁。\n", me);
                tell_object(me, "你觉得大概是吃坏了肚子。\n");
                me->add("combat_exp",-100000);
                             } 
        this_player()->add("combat_exp",100000);
        message_vision(HIG "\n$N吃下一粒奖励丹,渐渐地一股内息流遍全身,顿时精神大震,倍感舒适!\n\n" NOR, this_player());
        me->add("gift/jiangli",1);
        destruct(this_object());
        return 1;
}


