#include <ansi.h>
inherit F_AUTOLOAD;
inherit ITEM;
int do_make();

void create() {
  set_name(HIB "次元袋" NOR, ({ "bag" }));
  set_weight(0);
  set_max_encumbrance(8000000);
  set_max_items(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "口");
    set(
      "long",
      HIW + "一个天界才有的次元袋，透射着某种让人无法说出的神秘... ...\n" + NOR + BLINK + HIY + "西游记--神魔传说巫师组给大家的礼物。\n" + NOR
    );
    set("no_give", "这种稀世之宝怎么能轻易送人呢?\n");
    set("no_sell", "卖?这种稀世之宝谁买得起啊!\n");
    set("no_drop", "如此宝贵的宝物再世难求啊。\n");
    set("no_steal", 1);
    set("value", 50000);
  }
}

int is_container() { return 1; }

int query_autoload() { return 1; }

int init() {
  add_action("do_out", "out");
  add_action("do_make", "zhizao");
  return 1;
}
int do_out() {
  object me = this_object();
  object who = this_player();
  object where = environment(who);
  object room = environment(me);

  if (where != me)
    return 0;

  if (who->query_temp("no_move") ||
    who->is_busy()) {
    tell_object(who, "你现在还出不去。\n");
    return 1;
  }
  if (room->is_character())
    room = environment(room);
  who->move("/obj/void");
  message_vision("$N仿佛从异度空间出现在你的面前。\n", who);
  return 1;
}

int do_make() {
  object zhu, mao;
  object who = this_player();
  object crown;

  if (who->is_fighting())
    return notify_fail("你正打仗呢！想死啊！\n");
  if (who->is_busy())
    return notify_fail("你正忙着呢!\n");
  if (who->is_busy())
    return notify_fail("你正忙着呢!\n");
  if (who->query("9sky/number") < 9)
    return notify_fail("你没经历九天的磨难还是算了吧!\n");

  if (!mao = present("sheng mao", who))
    return notify_fail("你还缺少" + HIG "三界神帽" NOR + "呢!怎么制造呢?\n");
  if (!zhu = present("yeming zhu", who))
    return notify_fail("你还缺少" + HIC "夜明珠" NOR + "呢!怎么制造呢?\n");
  if ((zhu->query("equipped") != "worn") && (mao->query("equipped") != "worn")) {
    message_vision("$N巧手将夜明珠，三界神帽，次元袋组织了起来!\n", who);
    message("channel:rumor", HIY + "【谣言】某人：" + who->query("name") + "拿到小王冠了！\n" + NOR, users());

    crown = new("/d/crown/obj/smallcrown");
    crown->move(who);
    destruct(zhu);
    destruct(mao);
    destruct(this_object());
    return 1;
  }
  return notify_fail("宝物必须摘下才能制造！\n");
}
