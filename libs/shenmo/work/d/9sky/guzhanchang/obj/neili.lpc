// lingzhi.c 千年雪莲
//星星(lywin)2000/4/22

#include <ansi.h>
inherit ITEM;

void setup()
{}

void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name(HIR"万年雪莲"NOR, ({"xue lian", "lian"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "棵");
                set("long", "这是一棵武林人士梦寐以求的万年雪莲，据说吃一棵可得100内力上限。\n");
                set("value", 10000);
        }
        setup();
}

int do_eat(string arg)
{
        object me = this_player();

        if (!id(arg))
        return notify_fail("你要吃什么？\n");
if (this_player()->query("gift/neili") >= 2)
             {
                message_vision("$N突然放了一个奇臭无比的响屁。\n", me);
                tell_object(me, "你觉得大概是吃坏了肚子。\n");
                me->add("maximum_force",-100);
                me->add("max_force",-100);
              } 
        this_player()->add("maximum_force", 100);
        this_player()->add("max_force",100);
        message_vision("$N吃下一棵万年雪莲，只觉得自己的内力变利害了一些 !\n", this_player());
         me->add("gift/neili",1);
        destruct(this_object());
        return 1;
}


