inherit NPC;
#include <ansi.h>

void heart_beat() {
  object env, *inv;
  int i, k = 0;

  ::heart_beat();

  if (!this_object()->is_fighting() && query("force") < query("max_force"))
    SDS_D->powerup(this_object());
  if (living(this_object())) {
    env = environment();
    if (!env) return;
    inv = all_inventory(env);
    for (i = 0; i < sizeof(inv); i++) {
      if (inv[i]->is_corpse() && !inv[i]->is_zombie() && k % 2 == 0) {
        inv[i]->set("victim_name", "鬼卒");
        message_vision(
          YEL "$N" YEL "对著地上的$n" YEL "喃喃地念了几句咒语，$n" YEL "抽搐了几下竟站了起来！\n",
          this_object(),
          inv[i]
        );
        inv[i]->animate(this_object());
        k++;
      }
    }
  }
}
