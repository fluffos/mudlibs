inherit NPC;
#include <ansi.h>

void create()
{
set_name("鬼王", ({ "gui wang", "gui" }) );
set("gender", "男性");
set("age", 1500);
set("long",
"这是古战场最老，也是最凶狠的一个鬼，被称为鬼王 ！\n");
set("str", 48);
set("cor", 52);
set("cps", 22);
set("max_kee",5000);
set("max_sen",5000);
set("force",8000);
set("max_force",4000);
set("mana",9000);
set("max_mana",4500);
set("force_factor",150);

set_skill("unarmed",500);
set_skill("jinghun-zhang",500);
map_skill("unarmed","jinghun-zhang");

set_skill("force",500);
set_skill("tonsillit",500);
map_skill("force","tonsillit");

set_skill("spells",500);
set_skill("gouhunshu",500);
map_skill("spells","gouhunshu");

set_skill("stick",500);
set_skill("kusang-bang",500);
map_skill("stick","kusang-bang");
set_skill("parry",500);
map_skill("parry","kusang-bang");

set_skill("dodge",500);
set_skill("ghost-steps",500);
map_skill("dodge","ghost-steps");

set_skill("whip",500);
set_skill("hellfire-whip",500);
map_skill("whip","hellfire-whip");

set("combat_exp", 10000000+random(80000000));
set("daoxing", 10000000+random(60000000));
create_family("阎罗地府",2,HIB"路巡王"NOR);
setup();
carry_object("/obj/money/gold")->set_amount(50+random(50));
carry_object("/d/9sky/guzhanchang/obj/piduzhu");
}

void remove_all_enemy()
{
::remove_all_enemy();
if ( query("force")<query("max_force")*2 )
        SDS_D->powerup(this_object());
}

void remove_eff()
{
remove_call_out("remove_eff");
if ( !query("image") )
    return 0;
message_vision(HIB"\n蓝光一闪，石像"HIB"渐渐的变成一尊$N"HIB"。\n\n"NOR,this_object());
remove_all_enemy();
set_heart_beat(1);
delete("image");
}

void bianshen()
{
object *e;
int i;
if ( query("image") )
        return;
clean_up_enemy();
e = query_enemy();
for(i=0;i<sizeof(e);i++)
   {
   if ( objectp(e[i]) )  {e[i]->remove_killer(this_object());this_object()->remove_killer(e[i]);}
   }
message_vision(HIB"\n蓝光一闪，$N"HIB"渐渐的变成一尊石像。\n\n"NOR,this_object());
remove_all_enemy();
set("image",1);
call_out("remove_eff",15+random(46));
set_heart_beat(0);
}

string short()
{
string str = ::short(); 
if ( is_character() )
        str+= "";
else    str+= YEL" <石像状态>"NOR;
return str;
}       

void die()
{
int i;
object me,*inv;
me=query_temp("last_damage_from");

if ( random(2) )
        {
        bianshen();
        return;
        }       

if ( me && living(me) && present(me,environment()) )
        {
        inv = all_inventory(this_object());
        for(i=0; i<sizeof(inv); i++)
                {
                if (inv[i]->query("id")=="piduzhu" || inv[i]->query("id")=="pidu zhu")
                        {
                        if ( inv[i]->move(me) )
                                {
                                message_vision("$N张开大嘴吐出一个绿色的宝珠，$n赶忙一把抓到怀里。\n",this_object(),me);
                                message("channel:rumor",RED+"【谣言】某人："+me->query("name")+"拿到辟毒珠了！\n"+NOR,users());
                                }
                        }
                }
        }
::die();
}

int is_character() 
{
return query("image")?0:1;
}

void heart_beat()
{
object weapon,target,ob = this_object();

::heart_beat();

weapon = query_temp("weapon");
if ( !weapon || !objectp(weapon) ) 
        { 
        weapon = new("/d/city/npc/obj/stick"); 
        weapon->set_name(HIG"辟毒珠"NOR,({"pi du zhu","stick"})); 
        weapon->set("unit",HIG"颗"NOR); 
        weapon->move(this_object()); 
        command("wield all"); 
        } 
if ( !this_object()->is_fighting() )
        {
        if ( query("force")<query("max_force") )
                SDS_D->powerup(this_object());
        }
else    {
        if ( query("kee")<query("eff_kee") )
                SDS_D->addKee(ob);
        if ( query("eff_kee")<query("max_kee") )
                SDS_D->addEffKee(ob);
        if ( query("eff_sen")<query("max_sen") )
                SDS_D->addEffSen(ob);
        if ( query("sen")<query("eff_sen") )
                SDS_D->addSen(ob);
        target = SSERVER->offensive_target(ob);
        if ( !target ) {delete_temp("last_damage_from");remove_all_enemy();return;}
        switch(random(10))
                {
                case 0 : SDS_D->randomPfm(this_object(),"stick");break;
                case 9 : SDS_D->super_attack(ob,target,500);break;
                case 1 : SDS_D->randomCast(this_object());break;         
                case 2 : SDS_D->randomCast(this_object());break;         
                case 8 : SDS_D->randomCast(this_object());break;         
                case 7 : SDS_D->randomCast(this_object());break;         
                }
        }
}


