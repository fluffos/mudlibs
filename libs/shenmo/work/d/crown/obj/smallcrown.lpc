#include <ansi.h>
#include <armor.h>

inherit F_UNIQUE;
inherit F_AUTOLOAD;
inherit HEAD;
int do_make();

void create() {
  set_name(HIY "小王冠" NOR, ({ "small crown" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("material", "crystal");
    set("value", 10000);
    set("no_steal", 1);
    set("no_drop", "如此宝贵的宝物再世难求啊。\n");
    set("no_get", "送人？亏你想的出来！\n");
    //            set("no_give", "这种稀世之宝怎么能轻易送人呢?\n");
    set("no_sell", "卖?这种稀世之宝谁买得起啊!\n");
    set("long", "三界宝物之一，据说他是知道王冠的一部分。\n");
    set("armor_prop/armor", 50);
    set("armor_prop/dodge", -5);
    set("armor_prop/parry", -5);
  }
  setup();
}
int query_autoload() { return 1; }

int init() {
  add_action("do_make", "xiangqian");
  return 1;
}
int do_make() {
  object zhu, mao;
  object who = this_player();
  object crown;

  if (who->is_fighting())
    return notify_fail("你正打仗呢！想死啊！\n");
  if (who->is_busy())
    return notify_fail("你正忙着呢!\n");
  if (who->is_busy())
    return notify_fail("你正忙着呢!\n");
  if (who->query("bieji1/number") < 11)
    return notify_fail("你没见过虞姬还是算了吧!\n");

  if (!mao = present("cat eyes", who))
    return notify_fail("你还缺少" + HIG "猫眼戒指" NOR + "呢!镶嵌什么呢?\n");
  if (!zhu = present("sheng lingzhu", who))
    return notify_fail("你还缺少" + HIC "圣灵珠" NOR + "呢!镶嵌什么呢?\n");
  if ((zhu->query("equipped") != "worn") && (mao->query("equipped") != "worn")) {
    message_vision("$N巧手将" HIG "猫眼戒指" NOR + HIC "圣灵珠" NOR + "镶嵌到小王冠上!\n", who);
    message("channel:rumor", HIY + "【谣言】某人：" + who->query("name") + "拿到王冠了！\n" + NOR, users());

    crown = new("/d/crown/obj/crown");
    crown->move(who);
    destruct(zhu);
    destruct(mao);
    destruct(this_object());
  }
  return notify_fail("宝物必须摘下才能制造！\n");
}
