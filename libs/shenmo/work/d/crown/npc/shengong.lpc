//create by fang@tsrj
#include <ansi.h>
inherit NPC;

int do_weapon();
object creat_weapon();

void create()
{
        set_name("神工", ({ "shen gong", "gong" }) );
        set("nickname", HIB "百兵之祖" NOR );
        set("title", "大师" );
        set("gender", "男性" );
        set("age", 60);
        set("long",     
            "他头上包着头巾，三缕长髯飘洒胸前，面目清瘦但红晕有光，\n"
            "二目炯炯有神，烁烁闪着竟似是凛凛的剑光，浑身似乎都包围\n"
            "在一股剑气之中。\n");
        set("str", 25);
        set("kar", 17);
        set("int", 30);
        set("daoxing", 3000000);
        set("combat_exp", 5000000);

        set_skill("unarmed", 340);
        set_skill("dodge", 340);
        set_skill("parry", 340);
        set_skill("spells", 340);  
        set_skill("dao", 340);
        set_skill("literate", 340);
        set_skill("stick", 340);  
        set_skill("qianjun-bang", 340);
        set_skill("puti-zhi", 340);  
        set_skill("jindouyun", 340);
        set_skill("dodge", 340);  
        set_skill("force", 340);   
        set_skill("wuxiangforce", 340);

        map_skill("spells", "dao");
        map_skill("unarmed", "puti-zhi");
        map_skill("force", "wuxiangforce");
        map_skill("stick", "qianjun-bang");
        map_skill("parry", "qianjun-bang");
        map_skill("dodge", "jindouyun");


        set("per", 30);
        set("max_kee", 2000);
        set("max_gin", 2000);
        set("max_sen", 2000);
        set("force", 4500);
        set("max_force", 4500);
        set("force_factor", 100);
        set("mana", 4500);
        set("max_mana", 4500);
        set("mana_factor", 100);
        
        set("inquiry", ([
            "王者之冠"  : "传说中的王者之冠？唯三界之尊方能获得，你有决心和毅力获得吗？\n",
            "原料"  : "炼制王者之冠需要王冠等许多稀有原料。\n",
       ]) );
            set("no_get",1);
        setup();
        set("chat_chance", 3);
        set("chat_msg", ({
             "神工抚剑而歌：王者之冠兮，人铸就。盖世奇宝兮，配至尊！\n",
             "神工低头沉吟，似乎在思考什么。\n"
             "神工叹了一口气：三界至尊，吾见之少亦。。。。。。\n"
       }) );
        carry_object("/d/obj/cloth/choupao")->wear();
        carry_object("/d/obj/weapon/stick/bintiegun")->wield();
}

void init()
{
        ::init();
}


int accept_object(object who, object ob)
{       object crown;
        if(!who->query("shilian") ){
                say("神工一声叹道：你奇经没有打通，恐怕无法铸造王者之冠！\n");
                call_out("destrory",0,ob);
                return 2;
        }
        if( who->query("king_of_crown")=="done" ) {
                say("神工一声叹道：你不是已经有王者之冠了吗?\n");
                call_out("destrory",0,ob);
                return 2;
        }
   
        if ((string)ob->query("id") == "bi huan") 
        {
            who->set_temp("give_bihuan",1);
                     call_out("destrory",0,ob);
        }else if((string)ob->query("id") == "normal crown" ) 
        {     
            who->set_temp("give_crown",1);   
            call_out("destrory",0,ob);
         }else
               {
                       message("vision","这是什么！这不能用来制造王者之冠！",who);
                call_out("destrory",0,ob);
                return 2;
               }
               if( !who->query_temp("give_bihuan")  )
                {
                         message_vision("\n$N还缺少制造王者之冠的原料之一鼻环！",who);
              return 2;
                }
               if( !who->query_temp("give_crown")  )
                {
                         message_vision("\n$N还缺少制造王者之冠的原料之一王冠！",who);
              return 2;
                }

        message("vision","神工低头检视了一下手中的原料点了点头说：好让我们开始吧\n",who);
        who->set("king_of_crown","done");
              who->add_maximum_mana(-4000);
        who->add_maximum_force(-4000);
              crown = new("/d/crown/obj/kingcrown");
              crown->set("owner",who->query("id") );
              crown->move( who );
          who->delete_temp("give_bihuan");
          who->delete_temp("give_crown");
          who->save();
              message("channel:rumor",HIM"【顺风耳】某人：听说"+who->query("name")+HIM"得到了传说中的王者之冠！\n"+NOR,users() );
              message_vision("$N给$n一柄王者之冠\n",this_object(),who);
        return 2;

}

void destrory(object ob)
{     if( ob )
      destruct(ob);
     return;
}

