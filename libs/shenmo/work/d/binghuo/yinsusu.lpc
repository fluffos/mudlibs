inherit NPC;
#include <ansi.h>
string ask_xiexun();
void create()
{
    set_name("殷素素", ({ "yin susu", "yin", "susu", }));
	set("long",
        "她身穿一件白布长袍。\n"
        "她是白眉鹰王殷天正的女儿。武当张五侠的妻子，明教教主张无忌的生母。\n"
    );

        set("title", HIG "明教" CYN "紫薇堂" NOR "堂主" );
        set("gender", "女性");
	set("attitude", "friendly");
       set("age", 38);
	set("shen_type", 1);
	set("str", 25);
	set("int", 25);
	set("con", 25);
	set("dex", 25);
	set("max_kee", 5000);
	set("max_sen", 5000);
	set("force", 6000);
	set("max_force", 6000);
	set("force_factor", 200);
	set("combat_exp", 5000000);
	set("max_mana",6000);
        set("mana",6000);
        set("daoxing",5000000);

	set_skill("force", 300);
	set_skill("jiuyang-shengong", 300);
	set_skill("dodge", 300);
	set_skill("qingfu-shenfa", 300);
	set_skill("unarmed", 300);
	set_skill("sougu", 300);
	set_skill("parry", 300);
	set_skill("literate", 300);
        set_skill("spells",300);
        set_skill("qiankun-danuoyi",300);

	map_skill("force", "jiuyang-shengong");
	map_skill("dodge", "qingfu-shenfa");
	map_skill("unarmed", "sougu");
	map_skill("parry", "sougu");
        map_skill("spells","qiankun-danuoyi");

//        create_family("明教", 3, "紫薇堂堂主");
 set("inquiry", ([
                
//                "义兄" : (: ask_xiexun :),
//                "谢逊" : (: ask_xiexun :),
                   ]) );
	setup();

    carry_object("/d/mingjiao/obj/baipao")->wear();
}

string ask_xiexun()
{
  object me=this_player();
  object ob=this_object();
  object yixin = present ("yi xin",ob);
if ( ! yixin) {
message_vision("$N说道：既有教主遗信，我自当送你去岛上！\n",ob);
 me->move("/d/binghuo/haitan");
}
  if (me->query("mingjiao/tang")<1 ) return "少侠武功练的如何？"; 
    command("sigh");
  message_vision("$N顿时泪流满面，义兄在岛上对我们一家照顾有加！\n",ob);
  message_vision("$N如今我们要回来，他还是不肯和我们一起回来！\n",ob,me);
  tell_object(me,"既然提起金毛狮王的名号，我就告诉你他在什么地方吧。\n");
   me->move("/d/binghuo/haitan");
  return "希望你能劝他回到中原来！\n";
}
