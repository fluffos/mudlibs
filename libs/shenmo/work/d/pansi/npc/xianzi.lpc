int accept_fight(object me)
{
        write(CYN "痴情仙子歪着头想了想，说道：好吧。\n" NOR);
        return 1;
}
int recognize_apprentice(object me)
{
        if( me->query("9sky/number") < 9  )
             {
             this_object()->kill_ob(me);
             return 0;
             }

             return 1;
}

