void create ()
{
  set ("short", "休息室");
set ("long", @LONG

这里空荡荡的，只在靠近墙壁的地方整整齐齐地放着一些蒲团。
房里光线很暗，墙壁不知道是什么材料做的，会发出淡淡的黄
光。这里是休息[1;36m([0;33mxiuxi[1;36m)[2;37;0m的好地方。你要是实在定不下心
也可以出去走走再回来[1;36m([0;33mhalt[1;36m)[2;37;0m。

LONG);

  set("exits", ([
   "east" : "/d/shashou/shashou",
            ]));
  
  set("no_fight", 1);
  set("no_magic", 1);
  set("no_magic", 1);
  setup();
}

void init()
{
    add_action("do_xiuxi", "xiuxi");
//    add_action("do_halt", "halt");
add_action("do_none",banned_action);
if ( wizardp(this_player()) )
  add_action("change","change");
}
int do_none( )
{
  object me;
  me = this_player(); 

tell_object(me,"你不能在这里用这条命令。\n");
return 1;
}


void change()
{
int i;
string arg,arg1,*dir;
object ob = this_object();
dir=({
	"east","north","up",
	"down","northwest","southwest","northeast","southeast",
	"westup","westdown","eastup","eastdown",
	"northup","northdown","southup","southdown",
	"northeastup","northeastdown","northwestup","northwestdown",
	"southeastup","southeastdown","southwestup","southwestdown",
	"enter","out","right","left",
});
i=random(sizeof(dir));
if ( i<=0 ) i=1+random(20);
if ( i>=28 ) i=1+random(20);
arg=dir[i];
arg1=dir[i-1];
ob->set("exits",([ ]));
ob->set("exits",([
       arg : "/d/shashou/shashou",
        arg1 : "/d/shashou/migong/migong1" , 
]));
message("channel:wiz",WHT"杀手楼："HIR"〖"HIY"休息室"HIR"〗"NOR+WHT"去杀手楼的出口随机性地更改为"HIG+arg+NOR+WHT",进迷宫则为"HIG+arg1+NOR+WHT"。\n"NOR,users());   
}
int do_xiuxi()
{       int xiuxi_time;

        object me = this_player();
if (!me->query("group"))  
{ 
   tell_object(me,"此处只给一品堂职业杀手们休息。\n对不起，你还是先加入我们吧！\n");  
   return 1; 
} 
        if (me->query("rulaitask/get"))
             {tell_object(me,"你有任务在身，定不下神来。\n"); 
              return 1;
             }

        if (me->query_temp("xiuxi"))
             {tell_object(me,"你正在休息中呢。\n");
              return 1;
             }
        message_vision(msg_xiuxi1[random(sizeof(msg_xiuxi1))]
			+msg_xiuxi2[random(sizeof(msg_xiuxi2))]
			+msg_xiuxi3[random(sizeof(msg_xiuxi3))],me);
        me->set_temp("no_move/start", time()); 
        me->set_temp("no_move/time", 10000); 
        me->set_temp("xiuxi", 1);
        if ( !me->query("rulaitask") )  finish(me);
        else {
                  if (me->query("rulaitask/fail") || (int)SDS_D->ptime(me)>5500 )
                xiuxi_time = 60+random(16);
                else xiuxi_time = 40+random(16);
             //随着转世的增加，增加转世的后的休息时间，以前是1/10，感觉有些短
             //改为1/8,再次改为1/5
             //fang@tsrj 2011
                xiuxi_time = xiuxi_time*(5+me->query("zhuanshi"))/5;
                me->set_temp("xiuxi_time",xiuxi_time);
                    call_out("check_xiuxi",1,me);
              }
                     
        return 1;
}


void check_xiuxi(object me)
{       
        int xiuxi_time = me->query_temp("xiuxi_time");

        if ( xiuxi_time == 0 ) finish(me);
        
        else {
                if ( xiuxi_time%6 == 0 )
                      //tell_object(me,str[random(sizeof(str))]);
		        tell_object(me,msg_xiuxi3[random(sizeof(msg_xiuxi3))]);

                me->add_temp("xiuxi_time", -1);
                call_out("check_xiuxi",1,me);
              }
}

void finish(object me)
{
//        tell_object(me,"你只觉精神一振，已经元神全部恢复。\n");
//      message_vision("$N深深地吸了口气，站了起来。\n",me);
	 message_vision(msg_finish1[random(sizeof(msg_finish1))]
			+ msg_finish2[random(sizeof(msg_finish2))]
			+ msg_finish3[random(sizeof(msg_finish3))]
			+ msg_finish4[random(sizeof(msg_finish4))],me);

        me->delete_temp("no_move");
        me->delete_temp("xiuxi");
        if (me->query("rulaitask/accomplish")) reward(me);
        me->delete("rulaitask");
        me->set("rulaitaskjob/done",1);
}

void reward(object me)
{
        int wuxue,level,kind_bonus,level_bonus,timep;
        int extra_bonus,potential_bonus,combat_exp_bonus,daoxing_bonus;
        string str,kind,time,msg;
        string *msg_give1,*msg_give2,*msg_give3,*msg_give4;

        wuxue = me->query("combat_exp");
        level = me->query("rulaitask/level");
        kind  = me->query("rulaitask/kind");     
        timep = me->query("rulaitask/end_time")-me->query("rulaitask/start_time");
        time  = chinese_time(timep);
        remove_call_out("change"); 
       call_out("change",2); 
	
        if ( level == 1 ) level_bonus=0;
        else if ( level == 2 ) level_bonus=1000;
        else level_bonus=2000;
        
        if ( kind == "杀" ) kind_bonus=300;
        else if ( kind == "擒" ) kind_bonus=-3000;
        else if ( kind == "劝" ) kind_bonus=-3000;
        else kind_bonus=-4000;
        
        extra_bonus = (me->query("combat_exp")/4000)+kind_bonus;
         if( extra_bonus < 0) extra_bonus =0;
        
        potential_bonus = extra_bonus*13 / 20;
        
        combat_exp_bonus = (extra_bonus*6 + (random(level_bonus) + random(kind_bonus))*3)/4;
    if( potential_bonus < 0) extra_bonus =0;
      daoxing_bonus = (extra_bonus*6 + (random(level_bonus) + random(kind_bonus))*3)/5;
        if ( daoxing_bonus < 1 ) daoxing_bonus =1;

	//上限 pot 10w ,wx/dx 20w  AddBySnowtu@Xmxyj2000
	if ( potential_bonus > 2000 )
		potential_bonus = 2000;
	if ( combat_exp_bonus > 6000 )
                combat_exp_bonus = 6000 + level_bonus*2;
	if ( daoxing_bonus > 6000 )
                daoxing_bonus = 6000 + level_bonus*2;

// 防止player wx dx qn溢出，限制在20y
// add by bowl 11.29 2003
if (me->query("potential")>2000000000)
             potential_bonus=0;
if (me->query("combat_exp")>2000000000)
             combat_exp_bonus=0;
if (me->query("daoxing")>2000000000)
             daoxing_bonus=0;
        me->add("potential", potential_bonus);
        me->add("combat_exp", combat_exp_bonus);
        me->add("daoxing", daoxing_bonus);
            me->add("c_balance",50000);
              me->add("shen",5);

msg_give1=({
//		"你得到了5两黄金和"+potential_bonus+"点潜能，"+combat_exp_bonus+"武学经验，"+COMBAT_D->chinese_daoxing(daoxing_bonus)+"道行。\n",
		"你得到了5两黄金和",
		"特赏赐黄金5两与",
                "奖励你黄金5两和",
                "赐予你五两GOLD和",
                "封赏你5 gold和",
		"赏赐你五两黄金及",
		"你得到黄金五两和",
		});
msg_give2=({
		potential_bonus+"点潜能，",
		chinese_number(potential_bonus)+"点潜能，",
		"潜能"+potential_bonus+"点，",
		"潜能"+chinese_number(potential_bonus)+"点，",
		});
msg_give3=({
		combat_exp_bonus+"武学经验，",
		combat_exp_bonus+"点武学经验，",
		"武学经验"+combat_exp_bonus+"，",
		"武学经验"+combat_exp_bonus+"点，",
		combat_exp_bonus+"武学，",
		combat_exp_bonus+"点武学，",
		"武学"+combat_exp_bonus+"，",
		"武学"+combat_exp_bonus+"点，",
		combat_exp_bonus+"武学经验值，",
		combat_exp_bonus+"点武学经验值，",
		"武学经验值"+combat_exp_bonus+"，",
		"武学经验值"+combat_exp_bonus+"点，",
		});
msg_give4=({
		COMBAT_D->chinese_daoxing(daoxing_bonus)+"道行。\n",
		"道行"+COMBAT_D->chinese_daoxing(daoxing_bonus)+"。\n",
		COMBAT_D->chinese_daoxing(daoxing_bonus)+"道行！\n",
		"道行"+COMBAT_D->chinese_daoxing(daoxing_bonus)+"！\n",
		COMBAT_D->chinese_daoxing(daoxing_bonus)+"道行......\n",
		"道行"+COMBAT_D->chinese_daoxing(daoxing_bonus)+"......\n",
		});

        str = "得到了"+potential_bonus+"点潜能，";
        str +=combat_exp_bonus+"武学经验，";
        str += COMBAT_D->chinese_daoxing(daoxing_bonus)+"道行。";

//        tell_object(me,"你得到了5两黄金和"+potential_bonus+"点潜能，"+combat_exp_bonus+"武学经验，"+COMBAT_D->chinese_daoxing(daoxing_bonus)+"道行。\n");
	 tell_object(me,msg_give1[random(sizeof(msg_give1))]
			+ msg_give2[random(sizeof(msg_give2))]
			+ msg_give3[random(sizeof(msg_give3))]
			+ msg_give4[random(sizeof(msg_give4))]);

        tell_object(me,"你额外得到了5点神的奖励。\n");
        str = me->name()+"完成了一个杀手楼任务，" + str;
        if ( level > 3) CHANNEL_D->do_channel(me, "job",str);
        
        str = str + "用时"+time+"。";
// fang 2007.9.18 防止文件过大
//        MONITOR_D->report_system_msg (str);
// log_file("taskreward",sprintf("[%s]%s\n",ctime(time()),str));//by djx 2003/12/16 由于做的人太多会导致此记录文件超大，因此将其取消
        
        switch (kind)
          {case "杀": {
                        me->add("rulaitask_log/kill_potential",potential_bonus);
                        me->add("rulaitask_log/kill_combat",combat_exp_bonus);
                        me->add("rulaitask_log/kill_daoxing",daoxing_bonus);
                
                        switch (level)
                            {case 1:{me->add("rulaitask_log/kill1",1);
                                     break;
                                     }
                              case 2:{me->add("rulaitask_log/kill2",1);
                                      break;
                                     }
                              case 3: me->add("rulaitask_log/kill3",1);
                             }
                         break;
                      }
          case "擒": {
                        me->add("rulaitask_log/arrest_potential",potential_bonus);
                        me->add("rulaitask_log/arrest_combat",combat_exp_bonus);
                        me->add("rulaitask_log/arrest_daoxing",daoxing_bonus);
                
                        switch (level)
                            {case 1:{me->add("rulaitask_log/arrest1",1);
                                     break;
                                     }
                              case 2:{me->add("rulaitask_log/arrest2",1);
                                      break;
                                     }
                              case 3: me->add("rulaitask_log/arrest3",1);
                             }
                         break;
                      }
          case "劝": {
                        me->add("rulaitask_log/persuade_potential",potential_bonus);
                        me->add("rulaitask_log/persuade_combat",combat_exp_bonus);
                        me->add("rulaitask_log/persuade_daoxing",daoxing_bonus);
                
                        switch (level)
                            {case 1:{me->add("rulaitask_log/persuade1",1);
                                     break;
                                     }
                              case 2:{me->add("rulaitask_log/persuade2",1);
                                      break;
                                     }
                              case 3: me->add("rulaitask_log/persuade3",1);
                             }
                         break;
                      }
          case "降": {
                        me->add("rulaitask_log/fight_potential",potential_bonus);
                        me->add("rulaitask_log/fight_combat",combat_exp_bonus);
                        me->add("rulaitask_log/fight_daoxing",daoxing_bonus);
                
                        switch (level)
                            {case 1:{me->add("rulaitask_log/fight1",1);
                                     break;
                                     }
                              case 2:{me->add("rulaitask_log/fight2",1);
                                      break;
                                     }
                              case 3: me->add("rulaitask_log/fight3",1);
                             }
                     }                        
          }
}                               

int do_halt()
{
      object me = this_player();

       if (me->query_temp("xiuxi"))
           {remove_call_out("check_xiuxi");
            me->delete_temp("xiuxi_time");
            message_vision(msg_finish4[random(sizeof(msg_finish4))],me);
            me->delete_temp("no_move");
            me->delete_temp("xiuxi");
            return 1;
           }
         else return 0;
}       
        


string chinese_time(int timep)
{
        int t, d, h, m, s;
        string time;
        t = timep;
        s = t % 60;             t /= 60;
        m = t % 60;             t /= 60;
        h = t % 24;             t /= 24;
        d = t;

        if(d) time = chinese_number(d) + "天";
        else time = "";

        if(h) time += chinese_number(h) + "小时";
        if(m) time += chinese_number(m) + "分";
        time += chinese_number(s) + "秒";
        
        return time;
}
