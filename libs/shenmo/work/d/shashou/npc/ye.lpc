#include <ansi.h>
inherit NPC;
#include "reporting.h"


#include <obstacle.h>
int ask_for_officer();
int ask_for_leave();
string try_me();
string expell_me(object me);


void create() {
  set_name("叶二娘", ({ "ye erniang", "ye", "erniang" }));
  set("title", HIR "西夏一品堂杀手" NOR);
  set("gender", "女性");
  set("age", 60);
  set("per", 30);
  set("combat_exp", 300000);
  set_skill("force", 80);
  set_skill("spells", 80);
  set_skill("unarmed", 80);
  set_skill("dodge", 80);
  set_skill("parry", 80);
  set("gin", 3000);
  set("max_gin", 3000);
  set("kee", 3000);
  set("max_kee", 3000);
  set("sen", 3000);
  set("max_sen", 3000);
  set("force", 1000);
  set("max_force", 1000);
  set("mana", 1000);
  set("max_mana", 1000);
  set("force_factor", 80);
  set("inquiry", ([
    "一品堂": (: ask_for_officer :),
    "加入": (: ask_for_officer :),
    "杀手楼": (: ask_for_officer :),
    "离开": (: expell_me :),

  ]));
  setup();
  carry_object("/d/obj/cloth/jinpao")->wear();
}

int ask_for_officer() {

  int lv, size1;
  object ob = this_player();
  lv = ob->query("office_number") / 30;
  size1 = sizeof(obstacles);


  if (ob->query("combat_exp") < 50000000) {
    command("say " + ob->query("name") + "你还是先去多学点东西再来吧。\n");
    return 1;
  }
  if (ob->query("group") == "杀手楼") {
    command("say 你已经是俺们的人啦。。。\n");
    return 1;
  }
  if (ob->query("join") > 0) {
    command("say 你都已经是有组织的人了.\n");
    return 1;
  }
  if (ob->query("obstacle/number") < size1) {
    command("say " + ob->query("name") + "，你还是先去取完经再来为我们出力吧。\n");
    return 1;
  }

  ob->set("group", "杀手楼");
  command("nod");
  ob->set("job_title", HBMAG "西夏一品堂职业杀手" NOR);
  ob->set("join", 1);
  command("smile");
  message(
    "channel:chat",
    HBMAG + "【杀手楼】叶二娘(ye erniang)：旷世奇才" + ob->query("name") + "加入我杀手楼,壮我杀手楼声威！\n" + NOR,
    users()
  );
  return 1;
}

string expell_me(object me) {
  me = this_player();
  if ((string)me->query("group") == "杀手楼") {
    message_vision("你想干嘛。\n", me);
    me->set_temp("tuichu", 1);
    message_vision("$N确定要退出一品堂(true)？\n", me);
    return ("好吧，你可不要后悔哦！\n");
  }
  return ("问什么问！自己想去！\n");
}
void init() {
  add_action("do_true", "true");
  ::init();
}

int do_true(string arg) {
  object ob = this_player();
  if (this_player()->query_temp("tuichu")) {
    message_vision("$N答道：我说的真心话！\n\n", this_player());
    this_player()->delete("group");
    this_player()->delete("join");
    this_player()->delete("job_title");
    this_player()->add("combat_exp", -20000000);
    this_player()->save();
    message_vision("叶二娘说道,来去自由，$N走吧。。。\n", this_player());
    message(
      "channel:chat",
      HBMAG + "【杀手楼】叶二娘(ye erniang)：" + ob->query("name") + "退出我杀手楼组织,从此和我杀手楼毫无关系！\n" + NOR,
      users()
    );
    return 1;
  }
  return 0;
}
