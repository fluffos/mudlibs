inherit NPC;
#include <obstacle.h>
#include <ansi.h>
#include "/d/dntg/yunlou/npc/yaoguai_reward.lpc";

string *list=({"yg-jianmang","yg-jianzhang","yg-putuo","yg-qiankun","yg-longgong","yg-kunlun",
               "yg-huntian","yg-moon","yg-hell","yg-kusang","yg-shaolin","yg-shushan",
               "yg-swordman","yg-youxia","yg-ba","yg-bawang","yg-sanban","yg-shenjian","yg-shenji",
               "yg-yihua","yg-wudidong","yg-huoyun","yg-dali","yg-xueshan","yg-bingpo","yg-gumu",
        "yg-xuanyuan","yg-sanjie","yg-yaoji","yg-zilei","yg-pansi","yg-hongyan","yg-bibo","yg-juesha",
        });

void create()
{
  set_name("赫连铁树", ({ "helian tieshu", "helian", "tieshu" }));
  set("title", HBMAG"西夏国征东大将军"NOR);
  set("long", "西夏国王殿前侍卫，一品大将军赫连铁树。\n");
  set("gender", "男性");
  set("age", 10000);
  set("attitude", "peaceful");
  set("rank_info/self", "本将军");
  set("rank_info/respect", "大将军");
  set("str",100);
  set("per",100);
  set("max_kee", 10000);
  set("max_gin", 10000);
  set("max_sen", 10000);
  set("force", 10000);
  set("max_force", 10000);
  set("force_factor", 500);
  set("max_mana", 3000);
  set("mana", 3000);
  set("mana_factor", 500);
  set("combat_exp", 4000000);
  set("daoxing", 10000000);

  set_skill("literate", 300);
  set_skill("spells", 300);
  set_skill("buddhism", 300);
  set_skill("unarmed", 300);
  set_skill("jienan-zhi", 300);
  set_skill("dodge", 300);
  set_skill("lotusmove", 300);
  set_skill("parry", 300);
  set_skill("force", 300);
  set_skill("lotusforce", 300);
  set_skill("staff", 300);
  set_skill("lunhui-zhang", 300);
  map_skill("spells", "buddhism");
  map_skill("unarmed", "jienan-zhi");
  map_skill("dodge", "lotusmove");
  map_skill("force", "lotusforce");
  map_skill("parry", "lunhui-zhang");
  map_skill("staff", "lunhui-zhang");
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
   (: cast_spell, "bighammer" :),
  }) );
  set("inquiry", ([

  ]) );

  setup();
  carry_object("/d/obj/cloth/jinpao")->wear();
}

void init ()
{
  add_action("do_quest", "quest");
  add_action("do_cancel", "cancel");
}

int do_quest()
{
        object me = this_player();
        object guai;
        int level,i;
        int tt;
        int size1 = sizeof(obstacles);
        string kind,where,msg;
        string skill, skillmsg;

        if( (tt=(int)me->query("rulaitaskjob/job_start")) &&
		me->query("rulaitaskjob/done")) {
 // job done
	   if(tt<=time() &&
                  time()<tt+600) {
		message_vision("$N掐指一算，目前威胁我西夏的高手已经伤亡惨重，暂时不需要派出杀手了。\n",
			this_object(), me);
		return 1;
	    }
	   
	}
	me->delete("rulaitaskjob/job_start");
        me->command("say 敢问将军，最近可有高手威胁我西夏？");

        if((string)me->query("group") != "杀手楼" && !wizardp(me) ) 
	{message_vision(HIR"赫连铁树说道：你是何人！\n"NOR,me); 
              return 1;
             }
 
 if( me->query("combat_exp")<50000000 || me->query("level") < 250 ) 
{ 
command("say "+me->query("name")+"你还是先去多学点东西再来吧。\n");
 return 1;
 } 
        if(me->query_temp("shoucheng") ) 
        {message_vision(HIR"赫连铁树说道：你是何人！我不认识你\n"NOR,me); 
              return 1;
             }
// if( me->query("combat_exp")/200000 > me->query("level")) 
// 这里开放1000级之后可以继续做
if( (me->query("combat_exp")/300000 > me->query("level")) && me->query("level") < 1000) 
{
  command("say "+me->query("name")+"你的能力不足以后再来吧。\n");
  return 1;
}

if ( me->query_temp("killer_number")==9 )
        {
        command("say "+me->query("name")+"办事得力，本帅甚是高兴，这里有一份额外奖励，请笑纳。\n");
        skill=give_reward(me); 
        if(skill != "none")
                {
                skillmsg="听说"+ me->query("name")+ "的"+ to_chinese(skill)+ "又有所进境了！\n"; 
                CHANNEL_D->do_channel(me,"job",skillmsg); 
                }
        me->delete_temp("killer_number");
        return 1;
        }

        if( me->query("rulaitask/get") )
             {message_vision(CYN"\n赫连铁树说道：我不是已经给了任务你吗，快快起程。\n"NOR,me);
              return 1;
             }
        
        if( me->query("rulaitask/fail") )
             {message_vision(CYN"\n赫连铁树说道：你先下去休息，以提高自身的修行，再来拿任务吧。\n"NOR,me);
            me->start_busy(5);
              return 1;
             }
        
        if( me->query("rulaitask/accomplish") )
             {message_vision(CYN"\n赫连铁树说道：你有这份为我西夏国铲除异己的心地是好的，但是也要注意自己身体。\n"NOR,me);
           me->start_busy(5);
              return 1;
             }
             
        //确定任务等级
        level = random(10);
        if (level<4) level=1;
        else if (level<7) level=2;
        else level=3;
        
        //确定任务种类
        i = random(4);
        if (i==0) kind="杀";
        else if (i==1) kind="杀";
        else if (i==2) kind="杀";
        else kind="杀";
        
        me->set("rulaitask/get",1);
        me->set("rulaitask/level",level);
        me->set("rulaitask/kind",kind);
        me->delete("rulaitaskjob/done");
        if ( me->query("level") < 1000 )
        guai = new("/d/wizz/windy/"+list[random(sizeof(list))]);
        else    guai = new("/d/wizz/yhq/"+list[random(sizeof(list))]);
        where=guai->invocation(me, level);
        guai->set("host",me->query("id"));
        guai->set("live_time",time()+1800);
        switch (kind)
          {
                case "杀": {message_vision(HBBLU"\n赫连铁树说道："+where+"附近杀我西夏国高手，你去帮我除了他，千万小心吧。\n"NOR,me); break;}
                case "擒": {message_vision(CYN"\n如来佛说道：现在有一个"+where+"附近出没，此怪尚未恶贯满盈，但极难点化，你这就去把它生擒回来，让我亲自点化它。\n"NOR,me); break;}
                case "降": {message_vision(CYN"\n如来佛说道：现在有一个"+where+"附近出没，此怪刚刚道满出山尚未为恶，但非常好勇斗狠，你只需狠狠教训它一回，它就不敢为恶了。\n"NOR,me); break;}
                case "劝": message_vision(CYN"\n如来佛说道：现在有一个"+where+"附近出没，此怪本性不坏，只是未能冲破迷津，你这就去点化它吧。\n"NOR,me);
          }
        me->set("rulaitask/guai",guai);
        me->set("rulaitask/where",where);
        me->set("rulaitask/start_time",time());
        me->set("rulaitaskjob/job_start",time());
        msg = me->name()+"接到一个难度"+chinese_number(level)+"的"+kind+"妖任务。";
//        MONITOR_D->report_system_msg (msg);
        return 1;
}        

int do_cancel()
{
        object guai;
        object me = this_player();
        int tt;
          if (!me->query("rulaitask/get"))
             {tell_object(me,"你没有任务在身。\n"); return 1;}
        if ( (tt=(int)me->query("rulaitaskjob/job_start"))){
        if(tt<=time() &&
                    time()<tt+600) {
		message_vision("$N说道：你不会是在糊弄我吧。\n",
			this_object(), me);
		return 1;
	    }
            }
            
        me->command("say 这个任务弟子恐怕无能为力。");
        message_vision(HBBLU"\n赫连铁树说道：好吧，那我再派其他人去吧！你先下去休息一下吧。\n"NOR,me);
        me->start_busy(60);
        me->set("rulaitask/fail",1);
        me->delete("rulaitask/get");
        me->delete("rulaitaskjob/job_start");
        me->delete_temp("killer_number");
        
        return 1;              
}       

void die()
{
  if (environment())
    message("sound", "\n\n赫连铁树缓缓一点头：我们是不死的！\n\n", environment());

  set("eff_kee", 10000);
  set("eff_gin", 10000);
  set("eff_sen", 10000);
  set("kee", 10000);
  set("gin", 10000);
  set("sen", 10000);
  set("force", 10000);
  set("mana", 10000);
}

void unconcious()
{
  die ();
}
