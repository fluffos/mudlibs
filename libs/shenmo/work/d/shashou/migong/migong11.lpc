#include <ansi.h>
inherit ROOM;
void create()
{
   set ("short",HBRED"天地绝杀迷宫"NOR);
   set ("long",HIR+@LONG
                                                                    
                                MMMM                                
              MMMMMM          MMMMMM                                
                  MMMMMM    MMMM                                    
                      MMMMMMMM                                      
                      MMMMMMMMMM                                    
                  MMMMMM      MMMMMM                                
              MMMMMM              MMMMMM                            
            MMMMMM      MMMM        MM                              
                        MMMM                                        
      MM                MMMM              MM                        
      MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM                        
                        MMMM                                        
                MM      MMMM    MM                                  
                MMMM    MMMM  MMMMMMMM                              
              MMMM      MMMM      MMMMMM                            
            MMMM        MMMM        MMMMMM                          
          MMMM          MMMM          MM                            
                    MMMMMMMM                                        
                    MMMMMM                    
LONG+NOR);

setup();
}

void init()
{
add_action("do_none","move");
add_action("do_none","cast");
add_action("do_none","perform");
add_action("do_none","kill");
add_action("do_none","bian");
add_action("do_none","quit");
add_action("do_none","fight");
add_action("do_none","put");
add_action("do_none","drop");
add_action("do_none","get");
add_action("do_none","drop");
}

int do_none()
{
object me = this_player();
tell_object(me,BYEL+HIW"\n四周一片萧杀之气，你胆战心惊，失去了方向！\n"NOR);
return 1;
}
