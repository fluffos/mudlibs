#include <ansi.h>
inherit ROOM;

nosave int flag = 0;

mapping dir = ([
  "west": "east",
  "east": "west",
  "south": "north",
  "north": "south",
  "up": "down",
]);

void create() {
  set("short", "灵州大街");
  set("long", @LONG
灵州大街上人山人海，据说西夏公主准备选亲，
作为一品堂第一高手的四大恶人，也在这里忙个
不停维护秩序。
LONG);
  set("no_fight", 1);
  set("no_magic", 1);
  setup();
}

int random_map() {
  mapping data;
  object room, r1, r2, enter, out, *rr;
  int i, k, j, a;
  string e1, e2, *ex, str;

  if (flag)
    return 0;
  for (i = 0; i < 4; i++) {
    room = clone_object(__DIR__ "migong");
    if (!room)
      error("迷宫文件有遗缺.\n");
    set("room/" + (i + 1), room);
  }

  data = query("room");
  rr = values(data);
  ex = keys(dir);

  for (i = 0; i < sizeof(rr) / 2; i++) {
    a = 3;
    r1 = rr[i];
    if (!r1) continue;
    if (i == sizeof(rr))
      r2 = rr[0];
    else r2 = rr[i + 1];
    if (!r2 || r2 == r1) continue;
    while (a--) {
      k = sizeof(ex);
      k = random(k);
      e1 = ex[k];
      e2 = dir[e1];
      while (!r1->query("exits/" + e1)
        && !r2->query("exits/" + e2)) {
        k = sizeof(ex);
        k = random(k);
        e1 = ex[k];
        e2 = dir[e1];
      }
      r1->set("exits/" + e1, r2);
      r2->set("exits/" + e2, r1);
    }
  }

  rr = values(data);
  out = rr[random(sizeof(rr))];
  enter = rr[random(sizeof(rr))];
  while (out == enter)
    enter = rr[random(sizeof(rr))];

  set("exits/" + ex[random(sizeof(ex))], enter);
  e1 = ex[random(sizeof(ex))];
  out->set("exits/" + e1, __DIR__ "shashou");

  str = sprintf(HIR "【" NOR WHT "系统报告" NOR HIR "】" BLK "监控精灵(Monitord)：杀手楼地图已随机生成完毕，本次共计生成 %d 个地图。\n入口为 %O ,出口为 %O \n" NOR,
    sizeof(rr),
    enter,
    out);
  message("channel:wiz", str, users());
  flag++;
  return 1;
}

void reset() {
  mapping data;
  object room, *rr;
  int i;

  data = query("room");
  if (data && mapp(data)) {
    rr = values(data);
    for (i = 0; i < sizeof(rr); i++) {
      object *inv;
      int k;
      room = rr[i];
      if (!room || !objectp(room))
        continue;
      inv = all_inventory(room);
      for (k = 0; k < sizeof(inv); k++) {
        if (inv[k] && userp(inv[k])) {
          tell_object(inv[k], HIY " 
                        
                        星光一闪，
                        
                        你觉得天旋地转...
                        
" NOR);
          if (inv[k]->move(this_object()))
            inv[k]->move("/obj/void");
        }
      }
      destruct(room);
    }
  }
  flag = 0;
  ::reset();
}
