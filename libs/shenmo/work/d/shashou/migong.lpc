#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HBRED "天地绝杀迷宫" NOR);
  set("long", @LONG

四周一片萧杀之气，你胆战心惊，失去了方向。

LONG);
  set("no_magic", 1);
  set("no_cast", 1);
  setup();
}

void init() {
  add_action("do_none", "", 1);
}

int do_none(string arg) {
  string *cmds;
  object me = this_player();
  arg = query_verb();
  cmds = ({
    "get", "drop", "move", "ji", "put", "quit",
  });
  if (member_array(arg, cmds) == -1)
    return 0;
  write(BYEL + HIW "\n四周一片萧杀之气，你胆战心惊，失去了方向！\n" NOR);
  return 1;
}

void reset() {
  if (clonep(this_object()))
    destruct(this_object());
}
