void init()
{
if ( query("migong")==1 )  //迷宫已经给触发
	{
        call_out("reset", 3600); 
	return ;
	}

else     {
	this_object()->set("migong",1); //迷宫开启
       home=("/d/shashou/migong/");
       exit=("/d/shashou/damen.c");
       entry=("/d/shashou/dajie.c");
       call_out("r_map",1);
       return;
  	}
}

int reset()
{
set("migong", 0); //重新准备触发
return 1;
}
