#include <weapon.h>
#include <ansi.h>
inherit FORK;
#include "huan2.h"

void create() {
  set_name(HIC "水磨钢叉" NOR, ({ "gang cha", "cha", "fork" }));
  set_weight(7000);
  if (clonep()) set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "细钢精致打磨而成的三股叉。\n" NOR);
    set("material", "steel");
    set("wield_msg", "哗楞楞一声，$N从背后抽出$n，顺手用衣襟擦了擦叉头。\n" NOR);
    set("unwield_msg", "$N将$n反手背到身后。\n" NOR);
    set("value", 20000);
  }
  init_fork(70 + random(30));
  setup();
}
