#include <weapon.h>  
#include <ansi.h>  
#include "huan.h"  
inherit STAFF; 
inherit F_UNIQUE;
void create()  
{ 
set_name(BCYN+HIW"苦行"NOR, ({"kuxing staff", "staff","zhang"}));  
set_weight(15000);  
if (clonep())   set_default_object(__FILE__);  
else { 
	set("unit", "把");  
	set("long", BCYN+HIW"南    無    阿   彌    陀    佛\n"NOR);  
	set("material", "iron"); 
	set("wield_msg",HIW"$N将$n"+HIW"提将在手，过去种种艰辛历历在目，宛如昨日。\n"NOR);    
       set("unwield_msg",HIY"$N低誦佛號“南無佛”將手中的$n"+HIY"放下。\n"NOR);    
	set("no_drop",  RED"\n寶物易求難得。\n\n"NOR);   
	set("no_get",  RED"\n寶物易求難得。\n\n"NOR);   
	set("no_give",  RED"\n寶物易求難得。\n\n"NOR);   
	set("no_sell",  RED"\n寶物易求難得。\n\n"NOR);   
	} 
init_staff(110+random(40));  
setup();  
} 
       
int init()
{
add_action("do_huanyuan","huanyuan");   
return 1; 
}  

