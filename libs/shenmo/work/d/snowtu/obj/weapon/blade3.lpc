#include <weapon.h>
#include <ansi.h>
inherit BLADE;
#include "huan2.h"

void create() {
  set_name("水磨钢刀", ({ "gang dao", "dao", "blade" }));
  set_weight(8000);
  if (clonep()) set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "钢质的长刀，在日光下映出美丽的明暗刀纹。\n" NOR);
    set("material", "steel");
    set("wield_msg", "$N反手将$n執在手中，摆了夜战八方式。\n" NOR);
    set("unwield_msg", "$N將$n在手里抖了几抖，收招还鞘。\n");
    set("value", 20000);
  }
  init_blade(70 + random(30));
  setup();
  set("weapon_prop/ad_bingpo-blade", 5);
  set("weapon_prop/ad_kugu-blade", 5);
}
