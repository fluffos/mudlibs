#include <weapon.h>
#include <ansi.h>
inherit HAMMER;
#include "huan2.h"

void create() {
  set_name("钢制大锤", ({ "gang chui", "chui", "hammer" }));
  set_weight(15000);
  if (clonep()) set_default_object(__FILE__);
  else {
    set("unit", "杆");
    set("long", "钢制的大锤，净重一百一十八斤。\n" NOR);
    set("material", "iron");
    set("wield_msg", "$N把$n提将在手，摆了双阳开泰式。\n" NOR);
    set("unwield_msg", "$N把$n放将下来。\n" NOR);
    set("value", 20000);
  }
  init_hammer(70 + random(30));
  setup();
}
