#include "/u/yhq/weapon.h"
#include <ansi.h>
inherit SHOUTAO;
#include "huan2.h"

void create() {
  set_name("钢制拳套", ({ "quan tao", "tao", "hand" }));
  set_weight(5000);
  if (clonep()) set_default_object(__FILE__);
  else {
    set("unit", "双");
    set("long", "精钢打制的格斗手套。\n" NOR);
    set("material", "steel");
    set("wield_msg", "$N套上一对$n，挥了挥双拳。\n");
    set("unwield_msg", "$N將$n脱将下来。\n" NOR);
    set("value", 20000);
  }
  init_shoutao(70 + random(30));
  setup();
}
