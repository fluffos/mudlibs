#include <weapon.h>  
#include <ansi.h>  
#include "huan.h"  
inherit MACE;  
inherit F_UNIQUE;
void create()  
{ 
set_name( HIG"千节竹"NOR, ({"zhu mace", "mace", "bian", "jian" }));  
set_weight(8000); 
if (clonep())   set_default_object(__FILE__);  
else  {  
	set("unit", "柄");  
	set("long",  HIG"翠 绿 欲 滴 ，仿 佛 积 蓄 了 世 界 上 所 有 的 活 力 。\n"NOR);  
	set("material", "steel");  
	set("wield_msg",HIG"$N细声低吟“尽寒食雨草萋萋  著麦苗风柳映堤”吟罢将$n"+ HIG"高高扬起。\n"NOR);    
	set("unwield_msg",HIG"$N细声低吟“尽寒食雨草萋萋  著麦苗风柳映堤”吟罢将$n"+ HIG"放在腰间。\n"NOR);    
	set("no_drop",  RED"\n寶物易求難得。\n\n"NOR);   
	set("no_get",  RED"\n寶物易求難得。\n\n"NOR);   
	set("no_give",  RED"\n寶物易求難得。\n\n"NOR);   
	set("no_sell",  RED"\n寶物易求難得。\n\n"NOR);   
	} 
init_mace(random(40)+110);  
setup( ); 
} 
       
int init()
{
add_action("do_huanyuan","huanyuan");   
return 1; 
}  

       
