#include "/u/snowtu/weapon.h"  
#include <ansi.h>  
inherit SHOUTAO;  
inherit F_UNIQUE;
int k=random(50);

void create() { 
set_name( HBWHT+MAG"狼牙"NOR, ({"lang ya", "hand" }));  
set_weight(5000);  
if (clonep())   set_default_object(__FILE__);  
else {  
      set("unit", "双");  
      set("long",  HBWHT+MAG"用一百○八个；狼牙串接起来的格斗手套。\n"NOR);  
      set("material", "steel"); 
      set("wield_msg",HBWHT+MAG"$N大喝一声,双拳之上凝聚起百般力量,化作了$n。\n");    
      set("unwield_msg",HBWHT+MAG"$N將$n"+ HIC"抖了几抖，立刻化作了点点露珠散落在空中。\n"NOR);    
      set("no_drop",  RED"\n寶物易求難得。\n\n"NOR);   
      set("no_get",  RED"\n寶物易求難得。\n\n"NOR);   
      set("no_give",  RED"\n寶物易求難得。\n\n"NOR);   
      set("no_sell",  RED"\n寶物易求難得。\n\n"NOR);   
            }  
init_shoutao(70+k);  
setup( ); 
 } 

