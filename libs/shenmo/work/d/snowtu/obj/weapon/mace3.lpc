#include <weapon.h>  
#include <ansi.h>  
inherit MACE;  
#include "huan2.h"  

void create()  
{ 
set_name("水磨钢鞭"NOR, ({"gang bian", "mace", "bian", "jian" }));  
set_weight(8000); 
if (clonep())   set_default_object(__FILE__);  
else  {  
	set("unit", "柄");  
	set("long","钢制的双鞭，水磨的锃光锃亮。\n"NOR);  
	set("material", "steel");  
	set("wield_msg","$N将$n从背后抽出，擎在手中。\n"NOR);    
	set("unwield_msg","$N反手将$n插在背后。\n"NOR);    
	set("value",20000);   
	} 
init_mace(random(30)+70);  
setup( ); 
} 
