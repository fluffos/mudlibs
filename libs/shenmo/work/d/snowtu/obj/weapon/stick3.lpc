#include <weapon.h>  
#include <ansi.h>  
inherit STICK; 
#include "huan2.h"  

void create()  
{ 
set_name("水磨钢棍"NOR, ({"gang gun", "stick","gun"}));  
set_weight(15000);  
if (clonep())   set_default_object(__FILE__);  
else { 
	set("unit", "把");  
	set("long","精钢打制的长八长棍 。\n"NOR);  
	set("material", "iron"); 
	set("wield_msg","$N拿起$n，顺手抖了个棍花。\n"NOR);    
	set("unwield_msg","$N將手里$n舞动几下，放将下来。\n"NOR);    
	set("value",20000);   
	} 
init_stick(70+random(30));  
setup();  
} 
