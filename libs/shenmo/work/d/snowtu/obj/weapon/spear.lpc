#include <weapon.h>
#include <ansi.h>
#include "huan.h"
inherit SPEAR;
inherit F_UNIQUE;

void create() {
  set_name(HIC "禁灭枪" NOR, ({ "jinmie spear", "spear", "qiang", "jinmie" }));
  set_weight(7000);
  if (clonep()) set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", HIC "丈八长矛，气势如鸿，烈烈熊日也給映得再無英雄氣概。\n" NOR);
    set("material", "steel");
    set("wield_msg", HIC "$N长声一笑，从背后抽出$n" + HIC "握在手中，转眼间跳起了那半山的气势。\n" NOR);
    set("unwield_msg", HIC "$N反手将$n" + HIC "插在背后，在场众人方觉得心头落下一块大石。\n" NOR);
    set("no_drop", RED "\n寶物易求難得。\n\n" NOR);
    set("no_get", RED "\n寶物易求難得。\n\n" NOR);
    set("no_give", RED "\n寶物易求難得。\n\n" NOR);
    set("no_sell", RED "\n寶物易求難得。\n\n" NOR);
  }
  init_spear(110 + random(40));
  setup();
}

int init() {
  add_action("do_huanyuan", "huanyuan");
  return 1;
}
