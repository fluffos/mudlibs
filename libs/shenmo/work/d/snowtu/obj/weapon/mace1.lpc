#include <weapon.h>
#include <ansi.h>
inherit MACE;
inherit F_UNIQUE;
void create() {
  set_name(HIG "十层塔" NOR, ({ "shiceng ta", "mace", "bian", "jian" }));
  set_weight(8000);
  if (clonep()) set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", HIG "节节相连，力蓄其中 。\n" NOR);
    set("material", "steel");
    set("wield_msg", RED "$N细声低吟“予我千万人性 杀敌万千裹尸”吟罢将$n" + RED "高高扬起。\n" NOR);
    set("unwield_msg", RED "$N细声低吟“杀敌万千裹尸  予我千万人性”吟罢将$n" + RED "放在腰间。\n" NOR);
    set("no_drop", RED "\n寶物易求難得。\n\n" NOR);
    set("no_get", RED "\n寶物易求難得。\n\n" NOR);
    set("no_give", RED "\n寶物易求難得。\n\n" NOR);
    set("no_sell", RED "\n寶物易求難得。\n\n" NOR);
  }
  init_mace(random(50) + 70);
  setup();
}
