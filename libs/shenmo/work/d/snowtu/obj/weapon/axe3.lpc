#include <weapon.h>  
#include <ansi.h>  
inherit AXE; 
#include "huan2.h"  

void create()  
{ 
set_name("水磨钢斧", ({"gang fu","fu","axe"}));  
set_weight(10000);  
if (clonep())   set_default_object(__FILE__);  
else { 
set("unit", "把");  
set("long", "長達丈許的一把鋒利無比水磨钢斧。\n");  
set("material", "iron"); 
set("wield_msg","$N將手里$n反手背于背后。\n");    
set("unwield_msg","$N放下手中的$n。\n");    
set("value",20000);   
	} 
init_axe(70+random(30));  
setup();  
 } 
