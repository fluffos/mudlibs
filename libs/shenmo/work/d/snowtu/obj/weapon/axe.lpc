#include <weapon.h>  
#include <ansi.h>  
#include "huan.h"  

inherit F_UNIQUE;
inherit AXE; 

void create()  
{ 
set_name( HIY"咒默"NOR, ({"zhou mo", "axe"}));  
set_weight(15000);  
if (clonep())   set_default_object(__FILE__);  
else { 
set("unit", "把");  
set("long",  HIY"長達丈許的一把鋒利無比水磨獅頭巨斧。\n"NOR);  
set("material", "iron"); 
set("wield_msg",HIY"$N眼中冷意愈濃，帶著一絲冷笑將手里$n"+HIY"輕輕一擺，萬屻般的氣勢隨之而起。\n"NOR);    
set("unwield_msg",HIY"$N冷笑着将手里$n"+HIY"背到背后。\n"NOR);    
set("no_drop",  RED"\n寶物易求難得。\n\n"NOR);   
set("no_get",  RED"\n寶物易求難得。\n\n"NOR);   
set("no_give",  RED"\n寶物易求難得。\n\n"NOR);   
set("no_sell",  RED"\n寶物易求難得。\n\n"NOR);   
set("no_put",  RED"\n寶物易求難得。\n\n"NOR);   
      } 
init_axe(110+random(40));  
setup();  
 } 
       
int init() 
{    
add_action("do_huanyuan","huanyuan");    
return 1;    
} 
       
