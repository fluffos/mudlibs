#include <weapon.h>
#include <ansi.h>
#include "huan.h"
inherit HAMMER;

inherit F_UNIQUE;
void create() {
  set_name(HIY "泰山" NOR, ({ "tai shan", "big hammer", "hammer" }));
  set_weight(15000);
  if (clonep()) set_default_object(__FILE__);
  else {
    set("unit", "杆");
    set("long", HIY "金 光 闪 闪 的 铜 锤 ，问 你 想 挨 它 一 下 吗 ？\n" NOR);
    set("material", "iron");
    set("wield_msg", HIM "$N把$n提将在手，憨憨一笑。\n" NOR);
    set("unwield_msg", HIM "$N把$n背到背后，憨憨一笑。\n" NOR);
    set("no_drop", RED "\n寶物易求難得。\n\n" NOR);
    set("no_get", RED "\n寶物易求難得。\n\n" NOR);
    set("no_give", RED "\n寶物易求難得。\n\n" NOR);
    set("no_sell", RED "\n寶物易求難得。\n\n" NOR);
  }
  init_hammer(110 + random(40));
  setup();
}

int init() {
  add_action("do_huanyuan", "huanyuan");
  return 1;
}
