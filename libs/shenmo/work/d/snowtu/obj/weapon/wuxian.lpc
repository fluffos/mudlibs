//无限示加强版:)
//Snowtu@Xmxyj2000/2003/10

#include <ansi.h>
#include <combat.h>
inherit ITEM;

void init();
void create() {
  set_name(HIM "无限示" NOR, ({ "wuxian shi", "shi", "wuxian" }));
  if (clonep()) set_default_object(__FILE__);
  else {
    set_weight(5000);
    set("long", HIM "
神匠欧冶子当年参透百家武器奥妙所打造的神兵，用十七块奇形怪状
的玄金属连缀而成。你仔细看看它，发现里面另有玄机：你可以将它
驳(huan)成\n
刀(blade)剑(sword)锤(hammer)斧(axe)鞭(whip)锏(mace)
枪(spear)叉(fork)棍(stick)杖(staff)拳套(hand)钉耙(rake)。\n
也可以变换回无限示(huanyuan)。\n" NOR);
    set("unit", "塊");
    set("value", 500000);
    set("material", "steel");
  }
  setup();
}

void init() {
  set("no_give", HIW "此事还是作罢，不要再想了吧...... \n" NOR);
  set("no_drop", HIW "丢不得！丢不得！丢不得！丢不得！丢不得！\n" NOR);
  set("no_get", HIW "好东西你看看就得了，还想拿？小心我打你PP哦...... \n" NOR);
  set("no_sell", HIW "此事还是作罢，不要再想了吧...... \n" NOR);
  add_action("do_huan", "huan");
}

int do_huan(string arg) {
  object me = this_player();
  object ob = this_object();
  object wuqi;
  if (!present(ob, me) || !(arg)) return notify_fail("什么？\n");
  switch (arg) {
    case "sword": wuqi = new(__DIR__ "sword");
    break;

    case "hammer": wuqi = new(__DIR__ "hammer");
    break;

    case "stick": wuqi = new(__DIR__ "stick");
    break;

    case "staff": wuqi = new(__DIR__ "staff");
    break;

    case "mace": wuqi = new(__DIR__ "mace");
    break;

    case "axe": wuqi = new(__DIR__ "axe");
    break;

    case "spear": wuqi = new(__DIR__ "spear");
    break;

    case "shi": wuqi = new(__DIR__ "wuxian");
    break;

    case "whip": wuqi = new(__DIR__ "whip");
    break;

    case "blade": wuqi = new(__DIR__ "blade");
    break;

    case "fork": wuqi = new(__DIR__ "fork");
    break;

    case "hand": wuqi = new(__DIR__ "hand");
    break;

    case "rake": wuqi = new(__DIR__ "rake");
    break;

    default: return notify_fail("你想要的超出我的想象。。。\n");
    break;
  }
  wuqi->move(me);
  message_vision("
$N口中念念有词，$n一阵光华过后变作了一" + wuqi->query("unit") + wuqi->name() + "！\n" NOR, me, ob);
  destruct(ob);
  return 1;
}
