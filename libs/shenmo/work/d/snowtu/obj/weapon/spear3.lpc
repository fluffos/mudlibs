#include <weapon.h>  
#include <ansi.h>  
inherit SPEAR; 
#include "huan2.h"  
        
void create()  
{ 
set_name("水磨钢枪", ({"gang qiang", "spear", "qiang"}));  
set_weight(7000);  
if (clonep())   set_default_object(__FILE__);  
else {  
	set("unit", "把");  
	set("long","丈八长矛，纯钢打造。\n"NOR);  
	set("material", "steel");  
	set("wield_msg","$N长声一笑，抽出$n握在手中。\n"NOR);    
	set("unwield_msg","$N将手里的$n放了下来。\n"NOR);    
	set("value",20000);   
	} 
init_spear(70+random(30));  
setup(); 
} 
