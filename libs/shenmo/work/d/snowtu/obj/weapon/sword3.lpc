#include <weapon.h>
#include <ansi.h>
inherit SWORD;
#include "huan2.h"

void create() {
  set_name("水磨钢剑" NOR, ({ "gang jian", "jian", "sword" }));
  set_weight(5000);
  if (clonep()) set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "纯钢打造的长剑，挥动间隐隐作声。\n" NOR);
    set("material", "steel");
    set("wield_msg", "$N抽出一柄$n握在手中，嘴角帶著一股冷冷的笑意。\n" NOR);
    set("unwield_msg", "$N将$n还入鞘中。\n" NOR);
    set("value", 20000);
  }
  init_sword(random(30) + 70);
  setup();
}
