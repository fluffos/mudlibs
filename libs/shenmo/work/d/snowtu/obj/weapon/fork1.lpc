#include <weapon.h>  
#include <ansi.h>  
inherit FORK;  

inherit F_UNIQUE;      
void create()  
{ 
       set_name( HIC"风波"NOR, ({"feng bo", "fork" }));  
       set_weight(7000);  
      if (clonep())   set_default_object(__FILE__);  
      else {  
      set("unit", "把");  
      set("long",  HIC"彎月如勾，柔情似水，烈烈熊日也給映得再無英雄氣概。\n"NOR);  
      set("material", "steel");  
          set("wield_msg",WHT"$N吃吃一笑，从背后抽出$n"+ WHT"握在手中，銀玲般的響聲在風中傳出老遠。\n"NOR);    
          set("unwield_msg",WHT"銀玲般的響聲中,$N已将$n"+ WHT"反手背到身后。\n"NOR);    
      set("no_drop",  RED"\n寶物易求難得。\n\n"NOR);   
      set("no_get",  RED"\n寶物易求難得。\n\n"NOR);   
      set("no_give",  RED"\n寶物易求難得。\n\n"NOR);   
      set("no_sell",  RED"\n寶物易求難得。\n\n"NOR);   
         } 
      init_fork(70+random(50));  
      setup(); 
 } 
       
