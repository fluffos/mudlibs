#include <weapon.h>
#include <ansi.h>
inherit WHIP;
#include "huan2.h"

void create() {
  set_name("钢索", ({ "gang suo", "suo", "whip" }));
  set_weight(8000);
  if (clonep()) set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("long", "七七四十九条钢条接驳成的长索。\n" NOR);
    set("material", "iron");
    set("value", 20000);
    set("wield_msg", "$N将$n从腰间抽出，迎风抖了两抖。\n");
    set("unwield_msg", "$N将$n放下，缠回在腰际。\n");
  }
  init_whip(70 + random(30));
  setup();
}
