#include <weapon.h>
#include <ansi.h>
#include "huan.h"
inherit SWORD;
inherit F_UNIQUE;

void create() {
  set_name(BMAG + HIR "紅蓮韌" NOR, ({ "red sword", "honglian ren", "jian", "sword" }));
  set_weight(5000);
  if (clonep()) set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", BMAG + HIR "劍上發出紅悠悠的光，揮舞中仿佛發出蕭殺的百里龍吟。\n" NOR);
    set("material", "steel");
    set("wield_msg", BMAG + HIR "悅耳的龍吟聲中，$N抽出一柄$n" + BMAG + HIR "握在手中，嘴角帶著一股擁懶的寫意。\n" NOR);
    set("unwield_msg", BMAG + HIR "$N随手将$n" + BMAG + HIR "背在背后，浑身自然的散发出一股擁懶的寫意。\n" NOR);
    set("no_drop", RED "\n寶物易求難得。\n\n" NOR);
    set("no_give", RED "\n寶物易求難得。\n\n" NOR);
    set("no_get", RED "\n寶物易求難得。\n\n" NOR);
    set("no_give", RED "\n寶物易求難得。\n\n" NOR);
  }
  init_sword(random(40) + 110);
  setup();
}

int init() {
  add_action("do_huanyuan", "huanyuan");
  return 1;
}
