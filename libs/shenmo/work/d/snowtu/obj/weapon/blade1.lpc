#include <weapon.h>
#include <ansi.h>
inherit F_UNIQUE;
inherit BLADE;
int k = random(50);


void create() {
  set_name(HIC "虎魄" NOR, ({ "hu po", "blade" }));
  set_weight(8000);
  if (clonep()) set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", HIW "大马士革钢质的长刀，在日光下映出美丽的明暗刀纹。\n" NOR);
    set("material", "steel");
    set("wield_msg", HIC "$N將$n" + HIC "斜執朝天，霎時閒仿佛挑起天地的氣勢。\n" NOR);
    set("unwield_msg", HIC "$N將$n" + HIC "在手里抖了几抖，臃懒的放回刀鞘中。\n" NOR);
    set("no_drop", RED "\n寶物易求難得。\n\n" NOR);
    set("no_get", RED "\n寶物易求難得。\n\n" NOR);
    set("no_give", RED "\n寶物易求難得。\n\n" NOR);
    set("no_sell", RED "\n寶物易求難得。\n\n" NOR);
  }
  init_blade(70 + k);
  setup();
}
