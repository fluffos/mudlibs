#include <ansi.h>
inherit ITEM;

mapping types = ([
  YEL "破碎" NOR: "cracked",
  YEL "裂开" NOR: "chapped",
  WHT "普通" NOR: "plain",
  HIM "完整" NOR: "whole",
  HIW "无暇" NOR: "flawless",
  HIY "珍贵" NOR: "costful",
  HIM "完美" NOR: "immaculate",
]);

mapping clrs = ([
  HIR "红": "red",
  HIY "黄": "yellow",
  HIW "白": "white",
  HIM "蓝": "blue",
  HIG "绿": "green",
  CYN "灰": "gray",
  YEL "橙": "orange",
  MAG "紫": "purple",
]);

mapping names = ([
  "宝石": "stone",
  "钻石": "diamond",
  "翡翠": "emerald",
]);

void random_name() {
  int i, k;
  string name, id, id2, color, n;

  i = random(2);
  name = keys(types)[i];
  id = types[name];
  set("baoshi/type", name);

  k = random(sizeof(keys(clrs)));
  color = keys(clrs)[k];
  set("baoshi/color", color);
  name = name + "的" + color;
  id = id + "'s " + clrs[color];

  i = random(sizeof(keys(names)));
  n = keys(names)[i];
  set("baoshi/name", n);
  name += n + NOR;
  id = id + " " + names[n];
  id2 = names[n];

  set_name(name, ({ id2, id }));
}

void create() {
  random_name();
  set("unit", "颗");
  setup();
}
