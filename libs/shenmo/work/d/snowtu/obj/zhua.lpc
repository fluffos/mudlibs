#include <weapon.h>
#include <ansi.h>
inherit F_UNIQUE;
inherit DAGGER;

int check_damage();

mapping names = ([
        "垂珠璎珞"      : ({"chuizhu yingluo","yingluo"}),
        "三宝如意"      : ({"sanbao ruyi","ruyi"}),
        "长青杨柳"      : ({"changqing yangliu","yangliu","liu"}),
        "寸金毫铃"      : ({"cunjin haoling","ling"}),
        "真火魔杵"      : ({"zhenhuo mochu","chu",}),
        "八宝慈航"      : ({"babao cihang","cihang"}),
        "须弥五指"      : ({"xumi wuzhi","wuzhi"}),
]);

void create()
{
string *id,name,*str,msg;
str = keys(names);
name = str[random(sizeof(str))];
id = names[name];
set_name( ({HIC,HIR,HIM,HIY,HIW,HIG,MAG})[random(7)]+name+NOR,id );
set("unit", "把");
msg = HIG"这是一把灵气逼人的宝器。";
msg+= "上面纵横交错的";
msg+= query("insert")?"镶嵌了"+chinese_number(query("insert"))+"颗魔石":"满是深痕";
msg+= "，
看来还可以镶嵌(insert)一些东西在上面。\n"NOR;
set("long",msg);
set_weight(300);
if( clonep() )
        set_default_object(__FILE__);
else    {
        set("value",0);
        set("material", "iron");
        set("no_give","对方不接受你的东西。");
        set("no_put","对方不接受你的东西。");
        set("no_get","你附近没有这样东西。");
        }
set("wield_msg",WHT"$N"WHT"念动咒语，左手中忽然变出一把$n"WHT"。\n"NOR);
set("unwield_msg",WHT"$N"WHT"左手一斗，毫光一闪，$n"WHT"已然消失不见！\n"NOR);
//init_dagger( (:check_damage:),1 );
init_dagger(50);
setup();
}

