#include <ansi.h>
inherit COMBINED_ITEM;

void setup() {}

void init() {
  add_action("do_burn", "burn");
}

void create() {
  set_name("仙符·秋叶", ({ "qiu ye", "fu", "seal" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("base_unit", "张");
    set("unit", "些");
    set("long", "一张奇怪的符纸，可以烧(burn)了看看。\n");
    set("value", 10000);
  }
  set_amount(1);
  setup();
}

int do_burn(string arg) {
  int t, success = 0;
  object me = this_player();
  if (!arg || !id(arg))
    return 0;
  if (!wizardp(me)) {
    if (time() < me->query("invisibility_seal") + 10) {
      write("你不能频繁使用它。\n");
      return 1;
    }
    if (me->query("combat_exp") / 10000 + me->query("daoxing") / 10000 > 2500) {
      write("你不算新手了，还是算了吧。\n");
      return 1;
    }
    if (me->is_busy()) {
      write("你正忙着呢。\n");
      return 1;
    }
    if (me->query("env/invisibility") > 0 || me->query("env/invisibility") == "YES") {
      write("有这个必要吗？\n");
      return 1;
    }
    if (query("burned")) {
      write("这张符已经祭过了。。。\n");
      return 1;
    }
  }

  t = me->query_skill("spells", 1);
  t /= 100;
  if (t <= 0) {
    write("你法术不够，用不了仙符。\n");
    return 1;
  }
  t *= 3;
  if (t > 60) t = 60;
  if (t < 10) t = 10;

  if (me->query("mana") < 200) {
    write("你法力不够，用不了仙符。\n");
    return 1;
  }
  if (me->query("mana") < me->query("max_mana")) {
    write("你法力不满，用不了仙符。\n");
    return 1;
  }

  me->add("mana", -50);
  message_vision(YEL "$N" YEL "掏出一张$n" YEL "对空一摆，" NOR, me, this_object());
  switch (me->query("class")) {
    case "xian": success += 10; me->add("mana", -100); break;
    case "xian": success += 15; me->add("mana", -150); break;
    default: success += 5; me->add("mana", -50); break;
  }
  if (random(success) == 1) {
    message_vision(YEL "结果$n" YEL "“呼”的烧了起来，什么反应也没有。。。\n" NOR, me, this_object());
    add_amount(-1);
    return 1;
  }
  message_vision(YEL "结果$n" YEL "“呼”的烧了起来，一阵浓雾升起，$N" YEL "的身影变得若隐若现。。。\n" NOR, me, this_object());
  set("burned", 1);
  me->set("invisibility_seal", time() + t);
  me->set("env/invisibility", 1);
  if (me->is_fighting())
    me->start_busy(random(3));
  me->apply_condition("invisibility_seal", 1);
  add_amount(-1);
  return 1;
}
