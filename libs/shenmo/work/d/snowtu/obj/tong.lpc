#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIR "传声筒" NOR, ({ "chuansheng tong", "tong" }));
  set_weight(10000);
  set("long", "一个神奇的小喇叭，用它你可以进行 千里传音 (shout) .\n");
  set("unit", "个");
  set("value", 300000);
  setup();
}

void init() {
  if (environment() == this_player())
    add_action("do_shout", "shout");
}

int do_shout(string arg) {
  object me = this_player(), ob = this_object();
  if (!arg) {
    if (wizardp(me)) return 0;
    return notify_fail("你要传什么音？\n");
  }
  if (time() < me->query("千里传音") + 300) {
    if (wizardp(me)) return 0;
    return notify_fail("你刚传过音，还是休息休息吧。\n");
  }
  if (strlen(arg) > 60) {
    if (wizardp(me)) return 0;
    return notify_fail("你目前只能传音30字以内的信息。\n");
  }
  if (me->query("sen") < 50) {
    if (wizardp(me)) return 0;
    return notify_fail("你的精神不足了。\n");
  }
  message("shout", HIW + me->query("name") + HIW "仰天长啸：" + arg + "\n" NOR, users());
  me->set("千里传音", time());
  me->receive_damage("sen", 50);
  write(HIG "你使用了" + ob->name() + HIG "。\n" NOR);
  destruct(this_object());
  return 1;
}
