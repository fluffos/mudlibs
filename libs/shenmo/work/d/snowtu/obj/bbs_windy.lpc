#include <ansi.h>
inherit BULLETIN_BOARD;

void create() {
  set_name("眠兔留言板", ({ "snowtu's board", "board" }));
  set("location", "/u/windy/workroom");
  set("board_id", "bbs_snowtu");
  set("long", "这是一个眠兔的留言板。\n");
  setup();
  set("capacity", 500);
  replace_program(BULLETIN_BOARD);
}

void init() {
  this_object()->restore();
  ::init();
}
