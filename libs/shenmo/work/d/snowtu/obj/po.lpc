#include <ansi.h>
inherit "/d/snowtu/obj/pian.lpc";

void create()
{
string name,*n,*ids,*colors;
mapping names = ([
        "朱雀"  : "zhu que",
        "玄武"  : "xuan wu",
        "青龙"  : "qing long",
        "白虎"  : "bai hu",
        "凤凰"  : "feng huang",
        "大鹏"  : "da peng",
        "白猿"  : "bai yuan",
        "金猴"  : "jin hou",
        "狻猊"  : "suan ni",
        "猛犸"  : "meng ma",
        "夜狼"  : "ye lang",
        "鸱鸠"  : "chi jiu",
        "椒图"  : "shu tu",
        "金猊"  : "jin ni",
        "蚣蝮"  : "gong fu",
        "饕餮"  : "tao tie",
        "螭吻"  : "chi wen",
        "睚眦"  : "ya zi",
        "狴犴"  : "bi an",
        "蒲牢"  : "pu lao",
        "霸下"  : "ba xia",
]);
colors = ({
        RED"",YEL"",BLU"",MAG"",CYN"",WHT"",
        HIR"",HIY"",HIB"",HIM"",HIC"",HIW"",
        HBRED"",HBGRN"",HBYEL"",HBBLU"",HBMAG"",HBCYN"",HBWHT"",
        BRED"",BGRN"",BYEL"",BBLU"",BMAG"",BCYN"",
});
n = keys(names);
name = n[random(sizeof(n))];
ids = ({names[name]+" shi","shi"});
clr = colors[random(sizeof(colors))];
name= clr+name+"石"NOR;
set_name(name,ids);
set_weight(5000);
set_add_pot(1+random(5));
if ( clonep(this_object()) )
        set_default_object(__FILE__);
set("long",clr+"这传说是远古封神时诸位散仙散落在各地的魔法魄石。\n"NOR);
set("unit","些");
set("base_unit","块");
set("no_sell",clr+"这些并非凡间之物。\n"NOR);
set("pian_type","kee");
set("value",0);
set("持久",10);
set_amount(1);
setup();
}

                        
