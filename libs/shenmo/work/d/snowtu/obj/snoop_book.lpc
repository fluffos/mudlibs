#include <ansi.h>
inherit ITEM;

void create()
{
        set_name("傀儡虫初级操作指南",({"kuilei book","book"}));
        set("unit","本");
        set("no_put",1);
        set("long","远古秘籍，可以用它来操纵傀儡虫来探查(tancha)敌人的信息。\n");
        setup();
}

int query_autoload()
{
        return 1;
}

void init()
{
        if( environment() && userp(environment()) 
         && !query("owner") )
                set("owner",environment());
        add_action("do_tan","tancha");
        add_action("do_shou","shouhui");
}

int do_tan(string arg)
{
        object chong,who,me = this_player();
        if( !arg || me!=query("owner") )
                return 0;
        if( !present(this_object(),me) )
                return 0;       
        if( time()<query("check")+300 )
        {
                write("傀儡之术不能频繁使用。\n");
                return 1;
        }               
        who = present(arg,environment(me));
        if( !who )
                who = find_living(arg);
        if( !who )
                who = find_player(arg);
        if( !who || !me->visible(who) || wizardp(who) )
        {
                write("探察对象不存在。\n");
                return 1;
        }
        if( !living(who) )
        {
                write("看来是没什么必要。\n");
                return 1;
        }
        
        chong = me->query_temp("snooper");
        if( !chong )
                chong = new(__DIR__"chong");
        if( !chong )
        {
                write("你召唤不了傀儡虫。\n");
                return 1;
        }
        chong->set("target",who);
        chong->set("owner",me);
        chong->set("check",time());
        set("check",time());
        chong->move(environment(who));
        me->set_temp("snooper",chong);
        tell_room(environment(who),"一只傀儡虫“嗡嗡嗡”的飞了过来。\n");        
        chong->set_leader(who);
        message("vision",me->name()+"放出了一只傀儡虫。\n",environment(me),me);
        write("你放出了"+chong->name()+"开始探察"+who->name(1)+"的一举一动。\n");
        write(HIY"你可以使用 shouhui 命令来收回傀儡虫。\n"NOR);
        return 1;
} 

int do_shou(string arg)
{
        object chong,me = this_player();
        if( me!=query("owner") )
                return 0;
        if( !present(this_object(),me) )
                return 0;       
        chong = me->query_temp("snooper");
        if( !chong )
        {
                write("没这个必要。\n");
                return 1;
        }       
        chong->delete("target");
        chong->delete("check"); 
        destruct(chong);
        message_vision("$N收回了傀儡虫。\n",me);
        return 1;
}
