#include <ansi.h>
inherit NPC;

void create() {
  set_name("傀儡虫", ({ "kuilei chong", "chong" }));
  set("long", "上古昆虫，据说用它可以探查别人的一举一动。\n");
  set("gender", "女性");
  setup();
}

void init() {
  if (environment() && (environment()->is_tiaozhan() || environment()->is_job())) {
    delete("check");
    message_vision("$N急急忙忙的离开了。\n", this_object());
    destruct(this_object());
  }
}

int heal_up() {
  object target, me = query("owner");
  if (!me) {
    this_object()->move("/obj/empty");
    destruct(this_object());
    return 1;
  }
  if (query("check") > 0) {
    if (time() > query("check") + 30) {
      delete("check");
      message_vision("$N急急忙忙的离开了。\n", this_object());
      tell_object(me, name() + "飞回到你的身上。\n");
      destruct(this_object());
      return 0;
    }
    target = query("target");
    if (target && !present(this_object(), environment(target))) {
      this_object()->move(environment(target));
      set_leader(target);
    }
  }
  return ::heal_up() + 1;
}

void relay_message(string msgclass, string msg) {
  string *str;
  int i;
  object target, who;
  who = query("owner");
  target = query("target");
  if (who && environment(who) && living(who) && target && query("check")) {
    msg = replace_string(msg, "$N", target->name());
    msg = replace_string(msg, "你", target->name());
    str = explode(msg, "\n");
    msg = "";
    for (i = 0; i < sizeof(str); i++) {
      if (!str[i] || !stringp(str[i]) || strlen(str[i]) < 2)
        continue;
      msg += NOR "傀儡虫告诉你：" + str[i] + "\n" NOR;
    }
    who->receive_message(msgclass, msg);
  }
}


void kill_ob(object who) {
  remove_all_killer();
  who->remove_killer(this_object());
  return;
}

varargs int receive_damage(string type, int damage, object who) {
  return ::receive_damage(type, 0, who);
}

varargs int receive_wound(string type, int damage, object who) {
  return receive_damage(type, 0, who);
}
