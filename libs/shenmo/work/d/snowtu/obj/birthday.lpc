#include <ansi.h>
inherit ITEM;
#include "/cmds/std/valid_move.h"

void create() {
  set_name(HIG "礼品盒" NOR, ({ "gift box", "lipin he", "he", "lipin", "box", "gift" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  set("unit", "件");
  set("no_sell", "这可是眠兔送给你的礼品盒。\n");
  set("no_give", "这可是眠兔送给你的礼品盒。\n");
  set("no_put", "这可是眠兔送给你的礼品盒。\n");
  set("no_get", "这可是眠兔送给人的礼品盒。\n");
  set("no_drop", "这可是眠兔送给你的礼品盒。\n");
  set("long", HIG "这是眠兔在生日那天送玩家的礼品盒，可以拆(chai)开来。上面镶嵌着：\n" NOR BLINK
    HIR "   十二 月 六 日\n" NOR);
  setup();
}

void init() {
  add_action("do_wish", "wish");
  add_action("do_chai", "chai");
}

int do_chai(string arg) {
  string gift;
  int num;
  object gold, me = this_player();

  if (!arg || !id(arg) || me != environment())
    return 0;
  if (!valid_move(me)) {
    write("你正忙着呢。\n");
    me->start_busy(1);
    return 1;
  }
  if (!me->query_temp("snowtu_birthday")) {
    write("你还是先发个祝愿吧。命令格式： wish <祝福内容>\n");
    return 1;
  }
  message_vision(YEL "$N" YEL "将$n" YEL "小心翼翼的拆开。\n" NOR, me, this_object());
  me->start_busy(1);
  if (me->query("snowtu_birthday_2004")) {
    write(YEL "这个礼品盒空空如也，里面什么也没有。\n" NOR);
    destruct(this_object());
    return 1;
  }

  if (me->query_temp("snowtu_birthday") < 5)
    gift = "silver";
  else if (me->query_temp("snowtu_birthday") < 10)
    gift = "gold";
  else if (me->query_temp("snowtu_birthday") < 15)
    gift = "dx";
  else if (me->query_temp("snowtu_birthday") < 20)
    gift = "wx";
  else gift = "pot";

  switch (gift) {
    case "silver":
      gold = new("/obj/money/silver");
      gold->set_amount(1 + random(1000));
      if (gold->move(me))
        write(YEL "你得到了" + MONEY_D->money_str(gold->value()) + YEL "。\n" NOR);
      else
        write(YEL "可惜你什么也没得到。\n" NOR);
      break;
    case "gold":
      gold = new("/obj/money/gold");
      gold->set_amount(1 + random(1000));
      if (gold->move(me))
        write(YEL "你得到了" + MONEY_D->money_str(gold->value()) + YEL "。\n" NOR);
      else
        write(YEL "可惜你什么也没得到。\n" NOR);
      break;
    case "dx":
      num = 1000 + random(50000);
      me->add("daoxing", num);
      me->save();
      write(YEL "你得到了" + COMBAT_D->chinese_daoxing(num) + YEL "道行。\n" NOR);
      break;
    case "wx":
      num = 500 + random(150000);
      me->add("combat_exp", num);
      me->save();
      write(YEL "你得到了" + chinese_number(num) + YEL "点武学经验。\n" NOR);
      break;
    case "pot":
      num = 1000 + random(14000);
      me->add("potential", num);
      me->save();
      write(YEL "你得到了" + chinese_number(num) + YEL "点潜能。\n" NOR);
      break;
    default:
      write(YEL "你什么也没得到，再试试吧。\n" NOR);
      return 1;
  }
  me->set("snowtu_birthday_2004", 1);
  me->delete_temp("snowtu_birthday");
  destruct(this_object());
  return 1;
}

int do_wish(string arg) {
  int num = random(5) + 1;
  string msg, *wish, *no_wish;
  object me = this_player();
  wish = ({
    "如意", "健康", "顺风", "顺利", "开心",
  });
  no_wish = ({
    "不", "死", "屎", "便", "挂", "滚", "蛋",
  });
  if (me != environment())
    return 0;
  if (!arg)
    return notify_fail("命令格式：wish <祝福内容>\n");
  if (me->query_temp("snowtu_birthday"))
    return notify_fail("你已经祝福过了。:)\n");
  if (member_array(arg, no_wish) != -1) {
    write(HIR "臭贼！想搞破坏！\n" NOR);
    me->unconcious();
    return 1;
  }
  if (member_array(arg, wish) != -1)
    num += random(5) + 1;
  num *= 3;
  num = num / 2 + random(num / 2);
  if (num < 1)
    num = 1;
  me->set_temp("snowtu_birthday", num);
  msg = BLINK HIR "\n
        iiiiiiiiiiiiiiiiiii\n" NOR;
  msg += WHT "      |||||||H|A|P|P|Y|||||||\n" NOR;
  msg += WHT "    __|_____________________|__\n";
  msg += "   |\/\/\/\/\/\/\/\/\\/\/\/\/\/|\n";
  msg += "   |||||||B|I|R|T|H|D|A|Y||||||| \n";
  msg += "   |,,,,,,,,,,,,,,,,,,,,,,,,,,,|\n";
  msg += NOR YEL "   @@@@@@@@@@@@@@@@@@@@@@@@@@@@@　\n" NOR;
  msg += sprintf(HIM "%s(%s)：祝 " NOR HIG "眠兔(Snowtu)" NOR HIM "%s\n" NOR,
    me->query("name"), capitalize(me->query("id")),
    arg);
  message("shout", msg, users());
  return 1;
}
