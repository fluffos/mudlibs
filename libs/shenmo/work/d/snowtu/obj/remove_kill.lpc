inherit COMBINED_ITEM;
#include <ansi.h>

void setup()
{}

void create()
{
        set_name("一笑泯恩仇", ({ "seal","fu" }) );
        set("channel_id","一笑泯恩仇");
        set_weight(1000);
        if( clonep() ) 
                set_default_object(__FILE__);
        else 
        {
                set("unit", "些");
                set("base_unit","张");
                set("long", "这是一张消除仇恨的卷轴，如果你和其他玩家有了冲突，可以用这个来求和谐(hexie)。\n");
                set("value", 100000);
        }
        set_amount(1);
        setup();
}

int is_container() { return 1; }

void init()
{
        add_action("do_hexie","hexie");
}

int err_msg(string arg)
{
        write(arg);
        return 1;
}

int do_hexie(string arg)
{
        object who,me = this_player();
        
        if( !arg )
                return err_msg("你要和谁一笑泯恩仇？\n");
        if( time()<me->query("giftmark/hexie")+3600 )
                return err_msg("为防止恶意破坏，此道具每小时只能使用1次。\n");
        who = find_player(arg);
        if( !who || !objectp(who) )
                return err_msg(arg+"现在不在线。\n");
        
        message_vision("$N拿出一张$n，郑重其事的说道：河蟹社会，一切都是浮云！\n",me,this_object());
        me->remove_killer(who);
        who->remove_killer(me);
        me->set("giftmark/hexie",time());
        tell_object(who,HBMAG+me->query("name")+"("+capitalize(me->query("id"))+")使用了"+query("name")+"，清除了对你的仇恨。\n"NOR);
        CHANNEL_D->do_channel(this_object(),"chat",me->query("name")+"使用了"+query("name")+"，与"+who->query("name")+"再无瓜葛。");
        if( query_amount()>1 )
                add_amount(-1);
        else    destruct(this_object());
        return 1;
}                               
