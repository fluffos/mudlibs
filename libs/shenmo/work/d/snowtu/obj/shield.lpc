#include <ansi.h>
#include <armor.h> 
inherit SHIELD;

void create()
{
set_name("小木盾",({"mu dun","dun","shield"}));
set_weight(5000);
if ( clonep() )
        set_default_object(__FILE__); 
set("value",0);
set("no_give",1);
set("no_get",1);
set("no_put",1);
set("long","一面小木盾。\n");
set("unit","面");
set("material", "wood"); 
set("armor_prop/armor", 30); 
set("armor_prop/dodge", 1); 
set("unenduring",100);
}

int wear()
{
if ( ::wear() )
        {
        this_player()->set_temp("apply/super_shield",([
                        "type"   : "kee",
                        "persent": 50,
                        "unenduring": 1,
                        "fabao"  : this_object(),
                        ]));
        }                       
}       

int unequip()
{
if ( ::unequip() )
        this_player()->delete_temp("apply/super_shield");
}                               
