inherit ITEM;
void init() {
  add_action("do_give", "give");
}

int do_give(string arg) {
  object who, obj, me;
  string id;

  if (!arg) return 0;
  me = this_player();
  if (!present(this_object(), me)) return 0;
  if (sscanf(arg, "%s to %s", arg, id) == 2
    || sscanf(arg, "%s %s", id, id) == 2) {
    if (!id(arg))
      return 0;
    who = present(id, environment(me));
    if (!who) return 0;
    if (!userp(who)) return 0;
    tell_object(me, "这么宝贵的东西，你还是自己留着吧。\n");
    return 1;
  }
  write("ok\n");
  return 0;
}
