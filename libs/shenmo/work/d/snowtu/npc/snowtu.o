dbase (["spi":14,"can_speak":1,"long":"[1;35m眠兔的老婆，性情刁蛮，离开家行来行走江湖。她长得极美，尤其是那双眼睛，媚得直可以勾人魂魄。其容色晶莹如玉，映照于红红烛光之下，娇美不可方物。回眸嫣然一笑，雅如仙子下凡。眼波流转之间，便把一个少年的心灵，推向梦中极美的境界。[2;37;0m","actions":,"per":40,"age":18,"gin":156,"unit":"位","name":"阿浓","race":"人类","id":"a nong","startroom":"/u/snowtu/workroom","eff_kee":364,"attitude":"peaceful","max_kee":364,"master":"snowtu","eff_sen":378,"sen":378,"kee":364,"limbs":({"头部","颈部","胸口","后心","左肩","右肩","左臂","右臂","左手","右手","腰间","小腹","左腿","右腿","左脚","右脚",}),"max_sen":378,"kar":14,"str":29,"eff_gin":156,"cps":27,"int":40,"gender":"女性","cor":30,"con":23,"default_actions":,"max_gin":156,])
