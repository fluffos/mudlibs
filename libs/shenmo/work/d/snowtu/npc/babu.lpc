#include <ansi.h>
#include <combat.h>
inherit NPC;
#include "place.h"
void kill_ob(object ob);
void auto_full(object who);

void create() {
  int i, k, m, n;
  string name, *id;
  i = (random(sizeof(name1) / 2)) * 2;
  k = (random(sizeof(name2) / 2)) * 2;
  m = (random(sizeof(title1)));
  n = (random(sizeof(title2)));
  name = name1[i] + name2[k];
  id = ({ name1[i + 1] + " " + name2[k + 1], name2[k + 1] });
  set_name(name, id);
  set("title", HIC + title1[m] + title2[n] + NOR);
  set("long", HIC "大乘经传道者，为湿婆麾下八部众之一。\n" NOR);
  set("gender", ((random(2) == 1) ? "男性" : "女性"));
  set("max_sen", 6000);
  set("eff_sen", 6000);
  set("sen", 6000);
  set("max_kee", 6000);
  set("eff_kee", 6000);
  set("kee", 4000);
  set("combat_exp", random(300000));
  set("bellicosity", 200 + random(300));
  set("daoxing", random(3000000));
  set("chat_chance", 5);
  set("chat_msg", ({
    (: random_move :),
    (: perform_action, "staff", "diyu" :),
    (: perform_action, "staff", "fire" :),
    (: perform_action, "unarmed", "storm" :),
    (: cast_spell, "bighammer" :),
  }));
  setup();
  create_family("南海普陀山", 2, "密宗");
  set("莲花", 1);
  set("class", "xian");
  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  set_skill("staff", 200);
  set_skill("parry", 200);
  set_skill("force", 200);
  set_skill("lotusforce", 200);
  set_skill("jienan-zhi", 200);
  set_skill("lotusmove", 200);
  set_skill("lunhui-zhang", 200);
  set_skill("buddhism", 200);
  map_skill("unarmed", "jienan-zhi");
  map_skill("dodge", "lotusmove");
  map_skill("staff", "lunhui-zhang");
  map_skill("parry", "lunhui-zhang");
  map_skill("force", "lotusforce");
  map_skill("spells", "buddhism");
  setup();
  carry_object("/d/snowtu/obj/armor")->wear();
  carry_object("/d/snowtu/obj/shoes")->wear();
  carry_object("/d/snowtu/obj/cloth")->wear();
  carry_object("/d/snowtu/obj/pifeng")->wear();
  carry_object("/d/npc/obj/staff")->wield();
}

void init() {
  add_action("do_none", "", 1);
  add_action("do_kill", "kill");
}

int do_none() {
  object me = this_player();
  string verb = query_verb();
  string *no_cmds = ({
    "ji", "apply", "wear", "remove", "cast", "steal", "fight",
  });
  if (member_array(verb, no_cmds) != -1) {
    say(CYN + name() + CYN "说道：" + me->name() + CYN "不要搞破坏！\n" NOR);
    return 1;
  }
  return 0;
}

void copy_skill(object who) {
  string *skill;
  int i, max_kee, max_sen, max_force, max_mana, wx, dx, max_skill, force_factor, mana_factor, armor, damage;
  mapping skills = query_skills();

  max_kee = max_sen = 5000;
  max_force = max_mana = 5000;
  wx = dx = 5000000;
  max_skill = 200;
  force_factor = mana_factor = 100;
  armor = 200, damage = 100;

  max_kee = max_kee > who->query("max_kee") ? max_kee : who->query("max_kee");
  max_sen = max_sen > who->query("max_sen") ? max_kee : who->query("max_sen");
  wx = wx > who->query("combat_exp") ? wx : who->query("combat_exp");
  dx = dx > who->query("daoxing") ? dx : who->query("daoxing");
  max_skill = max_skill > SDS_D->maxSkill(who) ? max_skill : SDS_D->maxSkill(who);
  max_force = max_force > who->query("max_force") ? max_force : who->query("max_force");
  max_mana = max_mana > who->query("max_mana") ? max_mana : who->query("max_mana");
  force_factor = force_factor > who->query("force_factor") ? force_factor : who->query("force_factor");
  mana_factor = mana_factor > who->query("mana_factor") ? mana_factor : who->query("mana_factor");
  armor = armor > who->query_temp("apply/armor") ? armor : who->query_temp("apply/armor");
  damage = damage > who->query_temp("apply/damage") ? damage : who->query_temp("apply/damage");

  set("combat_exp", wx);
  set("daoxing", dx);
  skill = keys(skills);
  for (i = 0; i < sizeof(skill); i++)
    set_skill(skill[i], max_skill);
  set("max_kee", max_kee);
  set("max_sen", max_sen);
  set("max_force", max_force);
  set("max_mana", max_mana);
  set("force_factor", force_factor);
  set("mana_factor", mana_factor);
  /*
add_temp("apply/armor",armor);
add_temp("apply/damage",damage);
*/
  set("killing", who);
  SDS_D->powerup(this_object(), 1);
}

int accept_kill(object who) {

  if (!userp(who)) {
    say(CYN + name() + CYN "说道：小猫小狗的也来凑什么热闹？！\n" NOR);
    return 1;
  }
  if (this_object()->is_fighting()) {
    say(CYN + name() + CYN "说道：本尊正忙，没空理你！\n" NOR);
    return 1;
  }
  say(CYN + name() + CYN "说道：待本尊略稍休息，再来与你较量！\n" NOR);
  copy_skill(who);
  return 0;
}

void die() {
  string name, ob_name, id, wh;
  object armor = new(gift[random(sizeof(gift))]);
  object me = query("killing");
  object ob = this_object();
  object where = environment();
  object obj = new("/d/nanhai/npc/babu");

  SDS_D->powerup(ob);

  if (!me || !present(me, where))
    return ::die();

  if (armor->move(me))
    message(
      "channel:chat",
      HIC "【" + HIG + "八部众" + HIC + "】湿婆(Shi po)：" + me->query("name") + "(" + capitalize(me->query("id")) + ")" + HIC "夺到了密宗宝物：" + armor->query("name") + HIC "！\n" NOR,
      users()
    );

  wh = random_place();
  if (stringp(wh))
    message("channel:chat", wh, users());

  destruct(this_object());
}

void heart_beat() {
  if (query("eff_kee") < query("max_kee") && random(10) == 1)
    SDS_D->addEffKee(this_object());
  if (query("kee") < query("eff_kee"))
    SDS_D->addKee(this_object());
  if (query("sen") < query("eff_sen"))
    SDS_D->addSen(this_object());
  if (query("eff_sen") < query("max_sen") && random(10) == 1)
    SDS_D->addEffSen(this_object());
  ::heart_beat();
}

void random_move() {
  if (this_object()->is_fighting() || random(100) < 80)
    return;
  else ::random_move();
}

int do_kill(string arg) {
  if (arg && id(arg))
    set_temp("be_killed", time());
  return 0;
}

varargs int receive_damage(string type, int damage, object who) {
  if (time() < query_temp("be_killed") + 10)
    damage = random(50);
  return ::receive_damage(type, damage, who);
}

varargs int receive_wound(string type, int damage, object who) {
  if (time() < query_temp("be_killed") + 10)
    damage = random(50);
  return ::receive_wound(type, damage, who);
}
