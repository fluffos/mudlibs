#include <ansi.h>
inherit ROOM;
inherit "/d/snowtu/sanjiezhan/r.lpc";

void create() {
  string str, msg;
  set("short", HIY "三界战" HIM "%s" HIG "观礼台" NOR);
  msg = NOR + "\t\t"
    +BLINK BRED "█" NOR + BLINK BGRN + RED "█" NOR + BLINK BRED "█" NOR + BLINK BGRN + RED "█" NOR
    +BLINK BRED "█" NOR + BLINK BGRN + RED "█" NOR + BLINK BRED "█" NOR + BLINK BGRN + RED "█" NOR
    +BLINK BRED "█" NOR + BLINK BGRN + RED "█" NOR + BLINK BRED "█" NOR + BLINK BGRN + RED "█" NOR
    +BLINK BRED "█" NOR + BLINK BGRN + RED "█" NOR + BLINK BRED "█" NOR + BLINK BGRN + RED "█" NOR
    +BLINK BRED "█\n" NOR;
  msg += NOR + "\t\t"
    +BLINK BGRN + RED "█" NOR + BLINK BRED "█" NOR + BLINK BGRN + RED "█" NOR + BLINK BRED "█" NOR
    + "%s"
    +BLINK BRED "█" NOR + BLINK BGRN + RED "█" NOR + BLINK BRED "█" NOR + BLINK BGRN + RED "█\n" NOR;
  msg += NOR + "\t\t"
    +BLINK BRED "█" NOR + BLINK BGRN + RED "█" NOR + BLINK BRED "█" NOR + BLINK BGRN + RED "█" NOR
    +BLINK BRED "█" NOR + BLINK BGRN + RED "█" NOR + BLINK BRED "█" NOR + BLINK BGRN + RED "█" NOR
    +BLINK BRED "█" NOR + BLINK BGRN + RED "█" NOR + BLINK BRED "█" NOR + BLINK BGRN + RED "█" NOR
    +BLINK BRED "█" NOR + BLINK BGRN + RED "█" NOR + BLINK BRED "█" NOR + BLINK BGRN + RED "█" NOR
    +BLINK BRED "█\n" NOR;
  str = HBMAG HIY "  三 界 争 霸 战  " NOR;
  msg = sprintf(msg, str);

  set("exits", ([
    "south": "/d/city/under",
  ]));
  set("objects", ([
    __DIR__ "npc/anong": 1,
  ]));
  set("long", "\n" + msg);
  set("no_fight", 1);
  set("no_magic", 1);
  setup();
}

void init() {
  object me = this_player();
  ::init();
  if (!userp(me))
    return;
  SDS_D->check_player(me);
  me->remove_all_killer();
  all_inventory()->remove_killer(me);
}
