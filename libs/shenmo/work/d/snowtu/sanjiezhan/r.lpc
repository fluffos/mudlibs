#include "/cmds/std/valid_move.h"

void init()
{
if ( userp(this_player()) )
        {
        add_action("do_wield","wield");
        add_action("do_wear","wear");
        add_action("do_get","get");
        }
}

int do_wield(string arg)
{
object obj,me=this_player();
if ( !obj=present(arg,me) )
        {
        tell_object(me,"请使用 wield <id> 的命令来装备。\n");
        return 1;
        }       
if ( !valid_move(me) )
        {
        tell_object(me,"你现在正忙着呢。\n");
        return 1;
        }
if ( !obj->query("sanjiezhan") )
        {
        tell_object(me,obj->name()+"在这里不适合使用。\n");
        return 1;
        }
return 0;
}
                        
int do_wear(string arg)
{
int i;
object obj,*inv,me=this_player();

if ( arg=="all" || obj=present(arg,me) )
        {
        if ( !valid_move(me) )
                {
                tell_object(me,"你现在正忙着呢。\n");
                return 1;
                }
        if ( arg=="all" )
                {
                inv = all_inventory(me);
                for(i=0;i<sizeof(inv);i++)
                        {
                        obj = inv[i];
                        if ( !obj->query("sanjiezhan") )
                                continue;
                        "/cmds/std/wear.lpc"->main(me,obj->query("id"));
                        }
                }
        else    {
                if ( !obj->query("sanjiezhan") )
                        tell_object(me,obj->name()+"在这里不适合使用。\n");
                }
        return 1;
        }
return 0;
}
                        
