#include <ansi.h>
inherit NPC;

#define MAX_NUMBER this_object()->query("max_number")

string to_juban();
string to_juban2();
string to_start();
void remove_juban(object ob);
void remove_game(object npc, object ob);

void create() {
  set_name(HIC "神秘女子" NOR, ({ "nu zi", "girl" }));
  set("long", "她是发送装备的三界战主持，你可以(list)查看想要(yao)的东西。\n");
  set("gender", "女性");
  set("age", 20);
  set("per", 30);
  set("title", "武器发放员");
  set("nickname", HIG "回眸一笑 倾国倾城" NOR);
  set("combat_exp", -1);
  set("daoxing", -1);
  set("max_mana", -1);
  set("max_force", -1);
  set("max_number", 5);
  set("inquiry", ([
    "门派战": (: to_juban :),
    "开始": (: to_start :),
    "界内战": (: to_juban2 :),
  ]));
  setup();
  carry_object("/d/obj/cloth/skirt")->wear();
}

void init() {
  add_action("do_list", "list");
  add_action("do_yao", "yao");
  this_player()->delete_temp("sanjiezhan");
  this_player()->delete_temp("sanjiezhan_win");
}

int do_list(string arg) {
  object who = this_player();
  object me = this_object();
  message("vision", "" HIG "\n─────────────────────────────────────
          \n" HIY "盔甲：" HIC "
          1.金甲(armor)     2. 披风(pifeng)   3.盾牌(shield)
          4.铁盔(kui)       5. 战袍(cloth)    6.踏云靴(shoes)
          \n" HIY "兵器：" HIC "
          1.降魔棒(stick)   2. 青虹剑(sword)  3.软龙筋(whip)
          4.金刀(blade)     5. 短铁爪(zhua)   6.黄铜禅杖(staff)
          7.宣花斧(axe)     8. 月牙铲(fork)   9.梅花锤(hammer)
          10.点金枪(spear)  11.凤凰琴(qin)    12.虎尾鞭(mace)
          13.银针 (zhen)
" HIG "\n─────────────────────────────────────\n" NOR "", who, me);

  return 1;
}

int do_yao(string arg) {
  object ob;
  object me = this_player();

  if (!arg)
    return notify_fail("你想要什么？兵器？还是盔甲？(比如:yao sword)\n");

  switch (arg) {
    case "armor":
      ob = new("/d/city/npc/obj/armor.lpc");
      break;
    case "pifeng":
      ob = new("/d/city/npc/obj/pifeng.lpc");
      break;
    case "shield":
      ob = new("/d/city/npc/obj/shield.lpc");
      break;
    case "shoes":
      ob = new("/d/city/npc/obj/shoes.lpc");
      break;
    case "cloth":
      ob = new("/d/obj/stey/xianyi.lpc");
      break;
    case "kui":
      ob = new("/d/city/npc/obj/kui.lpc");
      break;

    case "sword":
      ob = new("/d/city/npc/obj/sword.lpc");
      break;
    case "whip":
      ob = new("/d/city/npc/obj/whip.lpc");
      break;
    case "blade":
      ob = new("/d/city/npc/obj/blade.lpc");
      break;
    case "stick":
      ob = new("/d/city/npc/obj/stick.lpc");
      break;
    case "spear":
      ob = new("/d/city/npc/obj/spear.lpc");
      break;
    case "fork":
      ob = new("/d/city/npc/obj/fork.lpc");
      break;
    case "hammer":
      ob = new("/d/city/npc/obj/hammer.lpc");
      break;
    case "qin":
      ob = new("/d/city/npc/obj/qin.lpc");
      break;
    case "axe":
      ob = new("/d/city/npc/obj/axe.lpc");
      break;
    case "staff":
      ob = new("/d/city/npc/obj/staff.lpc");
      break;
    case "zhua":
      ob = new("/d/city/npc/obj/zhua.lpc");
      break;
    case "mace":
      ob = new("/d/obj/weapon/mace/malemace.lpc");
      break;
    case "zhen":
      ob = new("/d/city/npc/obj/yinzhen.lpc");
      break;
    default:
      return notify_fail("你想要什么？\n");
  }
  ob->set("value", 0);
  ob->delete("no_give");
  ob->delete("no_get");
  ob->delete("no_drop");
  ob->set("sanjiezhan", 1);
  if (!ob->move(me))
    return notify_fail(name() + "说道:你身上已经装不下了。\n");
  message_vision("$N递给$n一" + ob->query("unit") + ob->name() + "。\n", this_object(), me);
  return 1;
}

string to_juban() {
  string fam;
  object who, me = this_player();

  if (!(__DIR__ "npc.lpc")->find_family(me))
    return "你无门无派，是怎么混进来的？";
  if (objectp(who = query("juban/owner"))) {
    if (present(who, environment()))
      return "现在在为" + who->name() + "大侠准备赛事呢。";
  }
  if (time() < me->query("sanjiezhan_die") + 14400)  //10小时一轮
    return "你已经失败了，还是等下次机会吧。";
  if (time() < me->query("sanjiezhan_lost") + 14400)  //10小时一轮
  {
    if (me->query("sanjiezhan_win") > 3)  //已win3次
      return "你已赢了三场了，还是把机会留给其他人吧。";
  }
  fam = me->query("family/family_name");
  message_vision("$N拿出文房四宝，在纸上写下 " + fam + " 的字样，朝$n点了点头。\n", this_object(), me);
  this_object()->set("juban", ([
    "owner": me,
    "type": fam,
  ]));
  this_object()->start_call_out((: call_other, __FILE__, "remove_juban", this_object() :), 300);  //5分钟
  message("channel:chat", sprintf(WHT "【" NOR HIG "%s" NOR WHT "】" NOR HIC "今" HIY " %s " HIC " 特发起本门派弟子擂台战，请" HIY " %s " HIC "派弟子准时参加，时间五分。\n" NOR,
    fam, me->name(), fam), users());
  return "好吧，我这就去准备。";
}

string to_juban2() {
  string cls, fam;
  object who, me = this_player();

  if (!(__DIR__ "npc.lpc")->find_family(me))
    return "你无门无派，是怎么混进来的？";
  if (objectp(who = query("juban/owner"))) {
    if (present(who, environment()))
      return "现在在为" + who->name() + "大侠准备赛事呢。";
  }
  if (time() < me->query("sanjiezhan_die") + 14400)  //10小时一轮
    return "你已经失败了，还是等下次机会吧。";
  if (time() < me->query("sanjiezhan_lost") + 14400)  //10小时一轮
  {
    if (me->query("sanjiezhan_win") > 3)  //已win3次
      return "你已赢了三场了，还是把机会留给其他人吧。";
    me->delete("sanjiezhan_win");
  }
  cls = me->query("class");
  fam = to_chinese(cls) + "界";
  message_vision("$N拿出文房四宝，在纸上写下 " + fam + " 的字样，朝$n点了点头。\n", this_object(), me);
  this_object()->set("juban", ([
    "owner": me,
    "type": cls,
  ]));
  this_object()->start_call_out((: call_other, __FILE__, "remove_juban", this_object() :), 300);  //5分钟
  message("channel:chat", sprintf(WHT "【" NOR HIG "%s" NOR WHT "】" NOR HIC "今" HIY " %s " HIC " 特发起本门派弟子擂台战，请" HIY " %s " HIC "派弟子准时参加，时间五分。\n" NOR,
    fam, me->name(), fam), users());
  return "好吧，我这就去准备。";
}

void remove_juban(object ob) {
  string fam;
  object who;
  if (!ob)
    return;
  if (!objectp(who = ob->query("juban/owner")))
    return;
  this_object()->delete("juban");
  fam = who->query("family/family_name");
  message("channel:chat", sprintf(WHT "【" NOR HIG "%s" NOR WHT "】" NOR HIY " %s " HIC " 发起的" HIY " %s " HIC "派擂台战时间已到，因无人参加，现已取消。\n" NOR,
    fam, who->name(), fam), users());
}

string to_start() {
  int i, num = 0;
  object npc, who;
  object me = this_player();
  object env = environment();
  object *inv = all_inventory(env);

  say(name() + "说道：我这就去找擂台主持。\n");
  this_object()->move("/d/city/under");
  say(name() + "从里面走了出来。\n");
  npc = present("sanjie laoren", environment());
  if (!npc || userp(npc))
    say(name() + "惊讶道：啊？擂台主持不在，如何是好？\n");
  else say(name() + "在" + npc->name() + "耳边低语了几句。\n");
  say(name() + "往里走去。\n");
  this_object()->move(env);
  say("\n" + name() + "从外面走了进来。\n\n");

  if (!npc || userp(npc))
    return "擂台主持不在，稍等片刻。";
  if (npc->query("start"))
    return "现在已经有赛事了，你还是等一下。";
  if (!objectp(who = query("juban/owner")))
    return "今日没有赛事。";
  if (me != who)
    return "我只听" + who->name() + "的。";

  message_vision("$N点了点头，开始查点人数。\n", this_object());
  for (i = 0; i < sizeof(inv); i++) {
    if (!userp(inv[i])) continue;
    if (time() < inv[i]->query("sanjiezhan_lost") + 3000)
      continue;
    if (inv[i]->query("family/family_name") != query("juban/type")
      && inv[i]->query("class") != query("juban/type"))
      continue;
    message_vision("$N对着$n点了点头。\n", this_object(), inv[i]);
    set("users/" + inv[i]->query("id"), inv[i]);
    num++;
  }
  if (num < MAX_NUMBER) {
    delete("users");
    return "你还需要再找" + chinese_number(MAX_NUMBER - num) + "人才行。";
  }
  inv = values(query("users"));
  for (i = 0; i < sizeof(inv); i++) {
    if (!objectp(inv[i])) {
      message("channel:chat", sprintf(WHT "【" NOR HIG "%s" NOR WHT "】" NOR HIY " %s " HIC " 因故退出了比赛，比赛现已取消。\n" NOR,
        me->query("family/family_name"), query("users")[i]), users());
      delete("users");
      delete("juban");
      return "有人退出了比赛，比赛取消了。";
    }
    message_vision("\n$N进入了比赛场地。\n\n", inv[i]);
    inv[i]->set_temp("sanjie_place", environment());
    inv[i]->move("/d/snowtu/sanjiezhan/ground" + sprintf("%d", 1 + random(5)));
    inv[i]->start_busy(3);
    tell_object(inv[i], "\n你进入了比赛场地，小心了！\n\n");
  }
  message_vision("$N将手一招：比赛开始，一干人等开始比赛，其余的可以去观礼台观礼。\n", this_object());
  npc->set("start", 1);
  delete("juban");
  this_object()->start_call_out((: call_other, __FILE__, "remove_game", npc, this_object() :), 300);  //5分钟
  message("channel:chat", sprintf(WHT "【" NOR HIG "%s" NOR WHT "】" NOR HIC "比赛现已开始，为时五分，请大家去观礼台观礼。\n" NOR,
    me->query("family/family_name")), users());
  return "大家各自为战吧。";
}

void remove_game(object npc, object ob) {
  int i;
  object *players;

  if (!ob)
    return;
  if (!npc)
    npc = new(__DIR__ "npc");
  players = values(query("users"));
  if (!players || !arrayp(players)) {
    message("channel:sys", WHT "\n三界战 ：" + __FILE__ + "发生错误: 查找不到 users 阵列！\n\n" NOR, users());
    return;
  }
  for (i = 0; i < sizeof(players); i++) {
    if (!environment(players[i])->query("sanjie_zhan_place"))
      continue;
    players[i]->delete_temp("last_damage_from");
    tell_object(players[i], "\n比赛时间已到。\n\n一道金光一闪！");
    players[i]->die();
  }
  message(
    "channel:chat",
    WHT "【" NOR HIG "三界战" NOR WHT "】" NOR HIC "比赛时间已到，现在选手退场。\n" NOR,
    users()
  );
  npc->delete("start");
  if (!environment(npc)
    || !objectp(environment(npc))
    || base_name(environment(npc)) != "/d/city/under")
    npc->move("/d/city/under");
  delete("users");
}
