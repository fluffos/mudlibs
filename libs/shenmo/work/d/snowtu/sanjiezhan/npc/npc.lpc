#include <ansi.h>
inherit NPC;
#include "/cmds/std/valid_move.h"

string check_me();

mapping type = ([
        "xian"  : ({"五庄观","南海普陀山","方寸山三星洞",
                   "东海龙宫","月宫","阎罗地府","昆仑山玉虚洞",
                   "三界散仙","武圣门"
                }),
        "human" : ({"少林寺","神剑山庄","蜀山剑派","峨嵋派",
                    "剑客联盟","江湖浪子","将军府","明教"
                }),
        "yao"   : ({"陷空山无底洞","火云洞","大雪山","轩辕古墓",
                    "三界山","盘丝洞","魔界",
                }),
]);

int find_family(object who)
{
string fam,cls,*str;
if ( !who )
        return 0;
fam = who->query("family/family_name");
if ( !fam )
        return 0;
str = keys(type);
cls = who->query("class");
if ( !cls )
        return 0;
if ( member_array(cls,str)==-1 )
        return 0;
if ( member_array(fam,type[cls])==-1 )
        return 0;
return 1;
}

int can_enter(object who)
{
int i,pot;
object *inv;
if ( !who )
        return 0;
inv = all_inventory(who);
for(i=0;i<sizeof(inv);i++)
        {
        if ( inv[i]->query("id")=="yueguang baohe" )
                {
                tell_object(who,CYN+name()+CYN"对你说道：还是先把月光宝盒丢了再说。\n"NOR);
                return 0;
                }
        if ( inv[i]->query("id")=="yun dan" )
                {
                tell_object(who,CYN+name()+CYN"对你说道：还是先把云丹丢了再说。\n"NOR);
                return 0;
                }

        if ( userp(inv[i]) )
                {
                tell_object(who,CYN+name()+CYN"对你说道：还是先把玩家放下再说。\n"NOR);
                return 0;
                }
        if ( strsrch( inv[i]->query("id"),"zhu" )!=-1 )
                {
                tell_object(who,CYN+name()+CYN"对你说道：还是先把宝珠丢了再说。\n"NOR);
                return 0;
                }
        if ( inv[i]->query("equipped") )
                {
                tell_object(who,CYN+name()+CYN"对你说道：还是先把装备脱了再说。\n"NOR);
                return 0;
                }
        }
MISC_D->checkPot(who);
pot = who->query("potential")-who->query("learned_points");
if ( pot<100 )
	{
	tell_object(who,CYN+name()+CYN"对你说道：你的潜能不足 100 。\n"NOR);
	return 0;
        }
return 1;
}

void create()
{
object staff;
set_name("三界老人",({"sanjie laoren","laoren","ren",}));
set("age",100+random(100));
set("long","一位鹤发童颜，年愈百岁的老人家。\n");
set("int",40);
set("gender","男性");
set("title","擂台主持");
set("nickname",HIG"大梦不知年 一憩天下变"NOR);
set("inquiry",([
        "三界战" : (: check_me :),
]));
set("combat_exp",-1);
set("daoxing",-1);
set("max_mana",-1);
set("max_force",-1);

set_living_name("sanjie laoren");

setup();
carry_object("/d/obj/cloth/baipao")->wear();
staff = new("/d/obj/weapon/staff/tieguai");
staff->set("name",HIY"龙头铁拐"NOR);
staff->move(this_object());
command("wield all");
}

string check_me()
{
object where;
string fam,cls;
object me = this_player();

if ( !userp(me) )
        return "小猫小狗的，还是算了。";
if ( !valid_move(me) )
        {
        tell_object(me,"你现在正忙着呢。\n");
        return 0;
        }
if ( !can_enter(me) )
        return 0;
if ( query_temp("busy") )
        {
        tell_object(me,"对方现在正忙着呢。\n");
        return 0;
        }
if ( me->query("combat_exp")<200000 )
        return "你这个样子进去，不是自取其辱吗？";
if ( !find_family(me) )
        return "你一个普通百姓，哪有资格进去？";

if ( time()<me->query("sanjiezhan_die")+14400 )		//10小时一轮
	return "你已经失败了，还是等下次机会吧。";
if ( time()<me->query("sanjiezhan_lost")+14400 )	//10小时一轮
	{
	if ( me->query("sanjiezhan_win")>3 )		//已win3次
		return "你已赢了三场了，还是把机会留给其他人吧。";
	}

cls = me->query("class");
fam = to_chinese(cls)+"界";
if ( !objectp(where=query(cls)) )
        {
        where = clone_object("/d/snowtu/sanjiezhan/watch1");
        if ( !where )
                return "观礼台现在准备中，梢候再试。";
        where->set("type",cls);
        set(cls,where);
        where->set("short",sprintf(where->query("short"),fam) );
        message("channel:wiz",sprintf(WHT"三界战：自动生成"NOR HIY" %s "NOR WHT"观礼台"NOR HIY" %O "NOR WHT"。\n"NOR,fam,where),users());
        }
me->start_busy(2);
message_vision(CYN"$N"CYN"朝$n"CYN"点点头，躬身将之引进"+fam+"的观礼台。\n"NOR,this_object(),me);
set_temp("busy",1);
set("env/invisibility",10);
this_object()->start_call_out( (: call_other, __FILE__, "remove_effect",this_object() :), 1+random(4));
me->move(where);
message_vision("$N进入了观礼台。\n\n",me);
me->add("learned_points",100);
tell_object(me,"你的潜能减少了100点。\n");
message("channel:chat",sprintf(WHT"【"NOR HIG"%s"NOR WHT"】"NOR HIY" %s "HIC"进入了擂台下。\n"NOR,fam,me->query("name")),users());
return "好的，请随我来。";
}

void init()
{
if ( userp(this_player()) )
        SDS_D->check_player(this_player());
}

void remove_effect(object who)
{
if ( !who )
        return;
who->delete_temp("busy");
who->delete("env/invisibility");
message_vision("\n$N从观礼台内走了出来。\n\n",who);
}

