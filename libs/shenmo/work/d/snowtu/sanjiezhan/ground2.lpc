#include <ansi.h>
inherit ROOM;
inherit "/d/snowtu/sanjiezhan/r.lpc";

#include "/d/snowtu/sanjiezhan/g.h"

void create()
{
string str,msg;
set("short",HIY"三界战赛场"NOR);
msg = NOR+"\t\t"
     +BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR+BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR
     +BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR+BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR
     +BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR+BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR
     +BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR+BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR
     +BLINK BRED"█\n"NOR;
msg+= NOR+"\t\t"
     +BLINK BGRN+RED"█"NOR+BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR+BLINK BRED"█"NOR
     +"%s"
     +BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR+BLINK BRED"█"NOR+BLINK BGRN+RED"█\n"NOR;
msg+= NOR+"\t\t"
     +BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR+BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR
     +BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR+BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR
     +BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR+BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR
     +BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR+BLINK BRED"█"NOR+BLINK BGRN+RED"█"NOR
     +BLINK BRED"█\n"NOR;
str = HBMAG HIY"  三 界 争 霸 战  "NOR;
msg = sprintf(msg,str);

set("long","\n"+msg);
set("alternative_die",1);
set("broadcast",1);

set("exits",([
	"west" : __DIR__"ground1",
	"east" : __DIR__"ground3",
]));
setup();
}

