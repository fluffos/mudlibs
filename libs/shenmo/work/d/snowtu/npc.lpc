#include <ansi.h>
inherit F_VENDOR_SALE;

int join();
void resets(object ob, int lvl);

void create() {
  reload("PKnpc");

  set_name("神秘老人", ({ "shenmi laoren", "laoren", "ren" }));
  set("long", WHT + @LONG

修罗场是为了玩家发泄或是切磋的地方，一切恩怨只限于场内。
注意事项：
	1. 入场费为黄金十两(肉鸡级为铜板十文)
	2. 比赛结束后,退还80%的入场费
	3. 如果为比赛中输出,则入场费归你的对手所有
	4. 比赛中不可以move,quit,cast chuqiao等
	5. 比赛中可以使用pfm,可能会失败,但是不等于不可以用
	6. 比赛中请寻找适合你的对手,不可以多欺寡,不可以强凌弱
	7. 本比赛由玩家自行决定加入,wiz不插手其间事务
	8. 比赛中可以退出( halt )，最后玩家halt将有随机奖励
此场地最终解释权归『西游记--神魔传说·巫师组』所有,玩家若发现ＢＵＧ，请
与在线巫师联系或是post留言，一经发现有人利用ＢＵＧ牟利，视根据
情节严重给以相应的处分。
			此致
敬礼
					『西游记--神魔传说·巫师组』
						2003.10
LONG + NOR);
  set("shop_id", ({ "laoren", "ren" }));
  set("shop_title", RED "ＰＫ场老人" NOR);

  set("gender", random(2) ? "女性" : "男性");
  set("age", 50 + random(50));
  set("attitude", "friendly");
  set("per", 10 + random(30));
  set("int", 10 + random(30));
  set("str", 10 + random(30));
  set("cps", 10 + random(30));
  set("spi", 10 + random(30));
  set("max_kee", 3000);
  set("max_gin", 3000);
  set("max_sen", 3000);
  set("max_force", 3000);
  set("force_factor", 200);
  set("max_mana", 5000);
  set("mana", 10000);
  set("mana_factor", 150);
  set("combat_exp", 5000000);
  set("inquiry", ([
    "join": (: join :),
    "比赛": (: join :),
    "pk": (: join :),
    "fight": (: join :),
  ]));
  setup();
}

int get_score(object ob) {
  int tlvl, i, score;
  string *ski;
  mapping skills;

  reset_eval_cost();
  skills = ob->query_skills();
  if (!sizeof(skills)) return 1;
  ski = keys(skills);
  for (i = 0; i < sizeof(ski); i++) {
    tlvl += skills[ski[i]];
  }
  score = tlvl / 10;
  score += ob->query("max_force") / 10;
  score += ob->query("max_mana") / 10;
  score += (int)ob->query("combat_exp") / 5000;
  score += (int)ob->query("daoxing") / 5000;
  return score;
}

int join() {
  int pot, lvl, max_value;
  string msg, lvl_msg;
  object ob = this_object();
  object me = this_player();
  pot = get_score(me);

  if (pot < 1000)
    max_value = 10;
  else max_value = 100000;

  if (pot < 1000) {
    lvl = 0;
    lvl_msg = "肉鸡";
  } else if (pot < 10000) {
    lvl = 1;
    lvl_msg = "初级";
  } else if (pot < 20000) {
    lvl = 2;
    lvl_msg = "中级";
  } else if (pot < 50000) {
    lvl = 3;
    lvl_msg = "高级";
  } else if (pot < 100000) {
    lvl = 4;
    lvl_msg = "特级";
  } else {
    lvl = 5;
    lvl_msg = "终级";
  }

  if (me->query_temp("PKfight/lost") > 3) {
    tell_object(me, "你已经失去了比赛资格，暂时不能参加了。\n");
    return 0;
  }

  if (ob->query("lvl" + sprintf("%d", lvl) + "/num") >= 6) {
    if (!ob->query("load" + sprintf("%d", lvl))) {
      call_out("resets", 600, ob, lvl);
      tell_object(me, CYN "神秘老人笑道：" HIR + chinese_number(lvl) + NOR CYN "号修罗场,名额已满，请十分钟后再来。\n" NOR);
      ob->set("load" + sprintf("%d", lvl), 1);
    }
    tell_object(me, CYN "神秘老人笑道：一场只能6人比赛，名额已满，下场请早。\n" NOR);
    return 1;
  }

  if (me->query_temp("PKfight/join")) {
    tell_object(me, CYN "神秘老人怒道：你已经参加了比赛，快交代是怎么逃出来的。\n" NOR);
    return 1;
  }
  if (me->query_tmp("PKfight/win") >= 3) {
    tell_object(me, CYN "神秘老人笑道：你已经连赢三场了，还是把机会让给别人吧。\n" NOR);
    return 1;
  }
  if (!me->query_temp("PKfight/paid")) {
    tell_object(me, CYN "神秘老人笑道：先交入场费" + MONEY_D->money_str(max_value) + CYN "。\n" NOR);
    return 1;
  }

  me->delete_temp("PKfight/look");
  message_vision(CYN "$n用奇怪的眼神对着$N" CYN "瞅了几眼，叹了口气道：进去是对的，但是注意
不要做出×尸之类不雅的事来...\n" NOR, me, ob);
  message_vision(CYN "$n把手一挥，跑过来几个衙役打扮的大汉，把$N" CYN "像小鸡一架，扛起就走。\n" NOR, me, ob);
  me->move("/d/snowtu/ground" + sprintf("%d", lvl));
  message_vision(CYN "\n\n到了。大汉们将$N" CYN "丢将在地，$N" CYN "爬将起身，仔细打量四周。\n" NOR, me);
  message(
    "chat",
    HIG "【" NOR WHT "民间传说" NOR HIG "】" NOR HIY + me->query("name") + CYN "：我已进入" NOR RED "修罗场·" + lvl_msg + "赛场" NOR CYN "，大家有德报德，有冤的报冤，想和我斗一斗的，" + RANK_D->query_self(me) + CYN "自当奉陪！\n" NOR,
    users()
  );
  message(
    "chat",
    HIG "【" NOR WHT "民间传说" NOR HIG "】" NOR CYN + me->query("name") + CYN "自豪地宣布：“我就是‘ 以 德 服 人’ ！”\n" NOR,
    users()
  );
  ob->add("lvl" + sprintf("%d", lvl) + "/num", 1);
  ob->save();
  call_out("resets", 1200, ob, lvl);
  return 1;
}

void init() {
  int lvl, pot;
  object me = this_player();
  object ob = this_object();
  pot = get_score(me);
  if (pot < 1000)
    lvl = 0;
  else if (pot < 10000)
    lvl = 1;
  else if (pot < 20000)
    lvl = 2;
  else if (pot < 50000)
    lvl = 3;
  else if (pot < 100000)
    lvl = 4;
  else lvl = 5;

  if (me->query_temp("PKfight/look"))
    return;
  me->set_temp("PKfight/look", 1);
  me->command("look " + ob->query("id"));
  return;
}

void resets(object ob, int lvl) {
  remove_call_out("resets");
  if (ob->query("lvl" + sprintf("%d", lvl) + "/num") >= 6)
    ob->set("lvl" + sprintf("%d", lvl) + "/num", 0);
  else
    ob->add("lvl" + sprintf("%d", lvl) + "/num", -1);
  ob->save();
  message("chat", HIG "【" NOR WHT "民间传说" NOR HIG "】" NOR CYN "修罗场现在开放，欢迎大家踊跃报名参加。\n" NOR, users());
  return;
}

int accept_object(object who, object ob) {
  int value, max_value;
  int pot = get_score(who);

  if (pot < 1000)
    max_value = 10;
  else max_value = 100000;

  if (!ob->query("money_id") || (value = ob->value()) != max_value) {
    message_vision(CYN "神秘老人手捻长须道：手续费就" + MONEY_D->money_str(max_value) + CYN "。\n" NOR, who);
    return 0;
  }
  tell_object(who, "神秘老人一哈腰，说道：多谢您老，准备好了就进场吧。\n");
  who->set_temp("PKfight/paid", 1);
  take_money(value, max_value);
  return 1;
}
