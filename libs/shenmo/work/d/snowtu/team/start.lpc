#include <ansi.h>
inherit ROOM;

int r_flag = 0;
int s_flag = 0;
int same_ip = 0;

mapping wks = ([
  "north": "south",
  "south": "north",
  "west": "east",
  "east": "west",
  "out": "enter",
  "enter": "out",
  "up": "down",
  "down": "up",
]);

varargs void set_same_ip(int num);

void clear_data() {
  r_flag = 0;
  s_flag = 0;
}

void create() {
  set("short", "未知世界入口");
  set("long", YEL + @LONG
这里是未知世界的入口。进入未知世界，必须知道
        1.      在此世界死亡，只会减少等级经验，如果等级经验小于0，
                则会自动降一级；
        2.      在此世界，必须组队进入(help team)
        3.      在此世界内的怪物，杀死后，随机有武学经验或道行或潜
                能或等级经验奖励。
        4.      杀此怪物后，在场的组员全部有相应的奖励。
        5.      如果想中途退出未知世界，输入 quit|halt 即可
        
LONG + NOR);
  set("exits", ([
    "west": __DIR__ "road",
  ]));
  setup();
}

void delete_room(object *ob) {
  int i, k;
  object *inv;
  if (!pointerp(ob))
    return;
  i = sizeof(ob);
  while (i--) {
    if (objectp(ob[i])) {
      inv = all_inventory(ob[i]);
      k = sizeof(inv);
      while (k--) {
        if (objectp(inv[k])) {
          if (!userp(inv[k]))
            destruct(inv[k]);
          else inv[k]->command("halt");
        }
      }
      destruct(ob[i]);
    }
  }
}

int valid_leave(object who, string dir) {
  int i, ff = 0, ss = 0;
  int kk;
  object *ob, *where;
  object w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, w16, w17, w18, w19, w20;
  object r1, r2, guai;
  string di, *dis;
  string name;

  if (s_flag)
    return notify_fail("这个入口已经有人进入了。\n");

  if (!userp(who))
    return 0;
  if (dir == "west") {
    ob = who->query_team();
    if (!ob || !pointerp(ob))
      return notify_fail("你尚未组队，不能进入！\n");
    if (!who->is_team_leader())
      return notify_fail("你不是所在小组的组织者，不能进入。\n");
    i = sizeof(ob);
    name = who->query("name") + "带领";
    while (i--) {
      if (!ob[i] || ob[i] == who)
        continue;
      name += ob[i]->query("name") + " ";
    }
    s_flag = 1;
    message("channel:rumor", HIB "\n听说 " + name + "闯进了" HIR "未知空间" HIB "！为时五分钟\n\n" NOR, users());
    w0 = new(__DIR__ "road0");
    if (!w0)
      error("__DIR__'room.c' 缺少!\n");
    w1 = new(__DIR__ "road1.lpc");
    w2 = new(__DIR__ "road2.lpc");
    w3 = new(__DIR__ "road3.lpc");
    w4 = new(__DIR__ "road4.lpc");
    w5 = new(__DIR__ "road5.lpc");
    w6 = new(__DIR__ "road6.lpc");
    w7 = new(__DIR__ "road7.lpc");
    w8 = new(__DIR__ "road8.lpc");
    w9 = new(__DIR__ "road9.lpc");
    w10 = new(__DIR__ "road10.lpc");
    w11 = new(__DIR__ "road11.lpc");
    w12 = new(__DIR__ "road12.lpc");
    w13 = new(__DIR__ "road13.lpc");
    w14 = new(__DIR__ "road14.lpc");
    w15 = new(__DIR__ "road15.lpc");
    w16 = new(__DIR__ "road16.lpc");
    w17 = new(__DIR__ "road17.lpc");
    w18 = new(__DIR__ "road18.lpc");
    w19 = new(__DIR__ "road19.lpc");
    w20 = new(__DIR__ "road20.lpc");
    where = ({ w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10,
      w11, w12, w13, w14, w15, w16, w17, w18, w19, w20 });
    remove_call_out("delete_room");
    call_out("delete_room", 300, where);
    while (ff < 20) {
      r1 = where[ff];
      dis = keys(wks);
      di = dis[random(sizeof(dis))];
      if (!r1->query("exits/" + di)) {
        r2 = where[ff + 1];
        if (!r2->query("exits/" + wks[di])) {
          ff++;
          r1->set("exits/" + di, r2);
          r2->set("exits/" + wks[di], r1);
          message("team", YEL "『" WHT "系统" YEL "』" CYN "随机通道" + ff + "连接完成\n" NOR, ob);
        }
      }
    }

    for (kk = 0; kk < 30; kk++) {
      if (random(2)) {
        guai = new(__DIR__ "npc/evl1");
        if (guai && guai->move(where[random(sizeof(where))]))
          message("team", YEL "『" WHT "系统" YEL "』" CYN "怪物" + guai->name() + "随机刷新完成。\n" NOR, ob);
      }
    }
    if (ss < 1) {
      guai = new(__DIR__ "npc/evl2");
      if (guai && guai->move(where[random(sizeof(where))])) {
        ss++;
        message("team", YEL "『" WHT "系统" YEL "』" CYN "唯一高级怪" + guai->name() + "随机刷新完成。\n" NOR, ob);
      }
    }
    i = sizeof(ob);
    while (i--) {
      if (!ob[i])
        continue;
      ob[i]->start_busy(1);
      if (ob[i]->move(w0))
        message("team", HIW "【组队】" + ob[i]->query("name") + HIW "：我已进入地图。\n" NOR, ob);
    }
    return notify_fail("你决定带领队员进入未知空间。\n");
  }
  return 0;
}

void init() {
  if (!userp(this_player())) {
    destruct(this_player());
    return;
  }
}

varargs void set_same_ip(int num) {
  if (!num) num = 0;
  else num = 1;
  same_ip = num;
}

int is_same_ip() {
  return same_ip;
}
