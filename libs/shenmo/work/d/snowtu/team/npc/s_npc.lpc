#include <ansi.h>
inherit NPC;

string check_me();

void create() {
  set_name("迷宫入口", ({ "migong rukou" }));
  set("inquiry", ([
    "未知世界": (: check_me :),
  ]));
  setup();
}

void leave() {
  remove_call_out("leave");
  destruct(this_object());
}

string check_me() {
  object me = this_player();
  object *team = me->query_team();
  object room;

  call_out("leave", 5 + random(6));

  if (query("asked"))
    return "你不是有缘人，恕我不能回答。。。。";
  set("asked", 1);
  if (!pointerp(team))
    return "你还没组队呢，去恐怕有点危险。。。";

  if (time() < me->query_temp("team_job_start") + 1200)
    return "你刚刚完成过，还是休息休息吧。。。。";

  if (!me->is_team_leader())
    return "你不是你们小组的领导人，恕我不能回答。。。。";

  room = find_object("/d/snowtu/team/start");
  if (!room) room = new("/d/snowtu/team/start");
  if (!room)
    return "目前一切正常。";
  room->clear_data();
  if (me->move(room)) {
    me->set_temp("team_job_start", time());
    me->start_busy(5);
    message(
      "channel:rumor",
      sprintf(HIG "【" HIM "千里眼" HIG "】" HIM "某人：听说%s找到了未知世界的入口。\n" NOR, me->query("id")),
      users()
    );
    return "赶紧去找入口吧。";
  }
  return "目前一切正常。";
}
