#include <ansi.h>
inherit __DIR__ "evl.lpc";

void create() {
  set_name("妖怪", ({ "yao guai" }));
  set("max_kee", 1000);
  set("max_sen", 1000);
  set("eff_kee", 1000);
  set("eff_sen", 1000);
  set("kee", 1000);
  set("sen", 1000);
  set("combat_exp", 1000000);
  set("daoxing", 1000000);
  set_skill("unarmed", 400);
  set_skill("dodge", 400);
  set_skill("parry", 400);
  set_skill("force", 400);
  setup();
}

void reply_perform(object who) {
  if (who && this_object()->is_fighting(who)) {
    command("say 妈妈的，又用外功？看我的！！\n");
    COMBAT_D->do_attack(this_object(), who, query_temp("weapon"));
    COMBAT_D->do_attack(this_object(), who, query_temp("weapon"));
    COMBAT_D->do_attack(this_object(), who, query_temp("weapon"));
    COMBAT_D->do_attack(this_object(), who, query_temp("weapon"));
    COMBAT_D->do_attack(this_object(), who, query_temp("weapon"));
    COMBAT_D->do_attack(this_object(), who, query_temp("weapon"));
  }
}
