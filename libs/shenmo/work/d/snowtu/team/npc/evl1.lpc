/*
======--- 四灵兽任务 Vision4.16 ---======
怪物难度以下列排名(由高到低):      
        shaolin yhg wdd moon
        youxia xs kunlun
        swordman shenjian lg
        fangcun shushan hell
        wzg emei jjf gumu
        bbt pansi dong hyd sanxian
======---  evl1.c 第一级(低)怪  ---======       
*/
#include <ansi.h>
inherit __DIR__ "evl.lpc";

void create() {
  mapping names = NAME_D->random_name("yaoguai");
  set_name(names["name"], names["id"]);
  set("title", HIB + (names["title"] != "NONE" ? names["title"] : "幽冥守卫") + NOR);

  set("max_kee", 1000);
  set("max_sen", 1000);
  set("eff_kee", 1000);
  set("eff_sen", 1000);
  set("kee", 1000);
  set("sen", 1000);
  set("combat_exp", 1000000);
  set("daoxing", 1000000);
  set_skill("unarmed", 400);
  set_skill("dodge", 400);
  set_skill("parry", 400);
  set_skill("force", 400);
  if (!random(3)) set("attitude", "aggressive");
  if (random(100) < 30) set("die_obj", "/d/snowtu/team/obj/book");
  else if (random(10) < 3) set("die_obj", "/d/snowtu/obj/armor");
  else if (random(10) < 3) set("die_obj", "/d/snowtu/obj/cloth");
  else if (random(10) < 3) set("die_obj", "/d/snowtu/obj/shoes");
  else if (random(10) < 3) set("die_obj", "/d/snowtu/obj/pifeng");
  setup();
  ("/cmds/std/zhenshens")->main(this_object(), "changeup");
}

void reply_perform(object who) {
  if (who && this_object()->is_fighting(who)) {
    command("say 妈妈的，又用外功？看我的！！\n");
    COMBAT_D->do_attack(this_object(), who, query_temp("weapon"));
    COMBAT_D->do_attack(this_object(), who, query_temp("weapon"));
    COMBAT_D->do_attack(this_object(), who, query_temp("weapon"));
    COMBAT_D->do_attack(this_object(), who, query_temp("weapon"));
    COMBAT_D->do_attack(this_object(), who, query_temp("weapon"));
    COMBAT_D->do_attack(this_object(), who, query_temp("weapon"));
  }
}
