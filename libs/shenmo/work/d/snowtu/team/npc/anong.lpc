#include <ansi.h>
inherit NPC;

string check_me()
{
object npc,npc1,where;
object room,*team,me = this_player();
int i;
mapping ip;
team = me->query_team();
if ( !pointerp(team) )
        return "你还没组队呢，去恐怕有点危险。。。\n";
if ( time()<query("times")+600 )
        return "还是等等吧。";
if ( time()<me->query_temp("team_job_start")+1200 )
      return "你刚刚完成过，还是休息休息吧。。。。";
room = find_object("/d/snowtu/team/start");
if ( !room )  room = new("/d/snowtu/team/start");
if ( !room )
        return "目前一切正常。";
npc = new(__DIR__"s_npc");
npc1 = SDS_D->random_npc(me);
where = SDS_D->random_place();
if ( npc1 && where && npc->move(where) )
        {
        set("times",time());    
        npc->set_temp("spellslevel",10000);
        npc->set_temp("apply/name",({npc1->name()}));
        npc->set_temp("apply/id",npc1->parse_command_id_list());
        npc->set_temp("apply/short", ({npc1->short()}));
        npc->set_temp("apply/long", ({npc1->long()}));
        npc->set_temp("unit",npc1->query("unit"));
        npc->set_temp("gender",npc1->query("gender"));
        npc->set_temp("age",npc1->query("age"));
        npc->set_temp("race",npc1->query("race"));
        npc->set_temp("family",npc1->query("family"));
        return "你去"+MISC_D->find_place(where)+"向"+npc->short()+"打听进一步的消息吧。";
        }
return "目前一切正常。";        
}                               

void create()
{
set_name("阿浓",({"Anong","anong","a nong"}));
set("gender", "女性");
set("age", 20);
set("title", WHT"西游记--神魔传说·总监"NOR);
set("long", "很厉害的一个MM,千万别得罪她。\n");
set("attitude", "friendly");
set("inquiry", ([
        "未知世界" : (:check_me:),
]) );
setup();
carry_object("/d/obj/cloth/choupao")->wear();
add_money("gold",5); 
}

void die()
{
destruct(this_object());
}

void unconcious()
{
die();
}               

void init()
{
this_player()->apply_contion("check_level",1);
add_action("do_none","qiangpo");
add_action("do_none","qiangjian");
add_action("do_none","shit");
}

int do_none()
{
return 1;
}       

