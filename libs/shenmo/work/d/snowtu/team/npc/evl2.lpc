#include <ansi.h>
inherit __DIR__"evl.lpc";

int item = 0;
int atk = 0;

string *armors = ({
        "/d/quest/zhuangbei/armor/wrists",
        "/d/quest/zhuangbei/armor/waist",
        "/d/12gong/obj/cloth",
        "/d/12gong/obj/armor",
        "/d/12gong/obj/pifeng",
        "/d/12gong/obj/shoes",
        "/d/12gong/obj/shield",
        "/u/angell/obj/toukui",
});
        
void create()
{
mapping names = NAME_D->random_name("yaoguai");
set_name(names["name"],names["id"]);
set("title",HIB+(names["title"]!="NONE"?names["title"]:"幽冥护卫")+NOR);
set("max_kee",50000);
set("max_sen",50000);
set("eff_kee",50000);
set("eff_sen",50000);
set("kee",50000);
set("sen",50000);
set("combat_exp",80000000);
set("daoxing",80000000);
set("level",255);
set("swordman/dead_perform",1);
set("attitude", "aggressive"); 

set_skill("unarmed",700);
set_skill("lushan-quan",700);
map_skill("unarmed","lushan-quan");

set_skill("dodge",700);
set_skill("zhutian-bu",700);
map_skill("dodge","zhutian-bu");

set_skill("parry",700);
set_skill("huoxin-sword",700);
set_skill("sword",700);
map_skill("sword","huoxin-sword");
map_skill("parry","huoxin-sword");

set_skill("force",700);
set_skill("guixi-force",700);
map_skill("force","guixi-force");

set_skill("spells",700);
set_skill("buddhism",700);
map_skill("spells","buddhism");

set("max_force",10000);
set("max_mana",10000);
set("force",20000);
set("mana",20000);

set_temp("apply",([
        "attack"        : 100,
        "damage"        : 300,
        "armor"         : 800,
]));    
setup();
}

int accept_kill(object who)
{
return 1;
}
int heal_up()
{
int i,k,j;      
object ob,*inv;

if ( environment() && !item )
        {
        item++;
        i = sizeof(armors);
        while(i--)
                {
                ob = new(armors[i]);
                if ( ob && ob->move(this_object()) )
                        ("/cmds/std/wear")->main(this_object(),ob->query("id"));
                }
        ("/cmds/std/zhenshens")->main(this_object(),"changeup");
        }
j = 0;  
if ( !query_temp("weapon") )
        {       
        inv = all_inventory();
        k = sizeof(inv);
        while(k--)
                {
                if ( inv[k]->query("weapon_prop/damage") )
                        {
                        ("/cmds/std/remove")->main(this_object(),"all");
                        ("/cmds/std/wield")->main(this_object(),inv[k]->query("id"));
                        ("/cmds/std/wear")->main(this_object(),"all");
                        j = 1;
                        }
                }
        if ( !j && random(3)==0 )
                {
                ob = new("/d/shenjian/obj/jewelsword.lpc");
                if ( ob && ob->move(this_object()) )
                        {
                        ("/cmds/std/remove")->main(this_object(),"all");        
                        ("/cmds/std/wield")->main(this_object(),ob->query("id"));
                        ("/cmds/std/wear")->main(this_object(),"all");
                        j = 1;
                        }
                }                                       
        }
return ::heal_up()+1;
}       


void heart_beat()
{
object me = this_object();
::heart_beat();

if ( me->is_busy() )
      return;
if ( (query("kee")+500) < query("eff_kee") )
        SDS_D->addKee(me);
if ( (query("sen")+500) < query("eff_sen") )
        SDS_D->addSen(me);
if ( random(10)>7 )
        {        
        if ( query("eff_kee") < query("max_kee") )
                SDS_D->addEffKee(me);
        if ( query("eff_sen") < query("max_sen") )
                SDS_D->addEffSen(me);
        }
if ( !me->is_fighting() )
        return;
switch(random(10))
        {
        case 9 :
        case 8 :        
        case 1 :
        case 0 : 
                if ( !query("no_pfm") ) 
                        SDS_D->randomPfm(this_object());
                break;
        case 2 :
        case 7 :
        case 8 :
        case 3 : 
                if ( !query("no_cast") ) 
                        SDS_D->randomCast(this_object());
                break;
        default: 
                if ( !query("no_exert") )         
                        SDS_D->randomExert(this_object());
        }       
}

void team_reward(object who,int reward,string data)
{
int i,k,rewards;        
string d_msg;   
if ( !who || !objectp(who) || !reward )
        error("给谁所在的组奖励？\n");
if ( data!="potential" && data!="combat_exp" 
  && data!="daoxing" && data!="level_exp" )
        error("奖励什么？\n");
switch(data)
        {
        case "combat_exp" : d_msg = "武学";break;
        case "daoxing"  : d_msg = "道行";break;
        case "level_exp": d_msg = "等级经验";break;
        default         : d_msg = "潜能";break;
        }       
if ( reward<5000 )      reward = 5000;  
who->add(data,reward);
tell_object(who,HIY"\n『"HIR"系统"HIY"』"NOR YEL"你得到了 "WHT+(data=="daoxing"?SDS_D->no_color_msg(COMBAT_D->chinese_daoxing(reward)):reward)+NOR YEL" 的 "WHT+d_msg+YEL" 奖励。\n\n"NOR);
who->save();
i = sizeof(team);
while(i--)
        {
        if ( !team[i] ) continue;
        if ( !objectp(team[i]) ) continue;
        if ( !living(team[i]) ) continue;
        if ( team[i]==who )     continue;
        if ( !present(team[i],environment(who)) )
                continue;
        k = who->query("level")-team[i]->query("level");
        if ( k<0 ) 
                k = -k;
        rewards = reward/(1+k);
        rewards = rewards/2+random(rewards/2);
        team[i]->add(data,rewards);
        tell_object(team[i],HIY"\n『"HIR"系统"HIY"』"NOR YEL"你得到了 "WHT+(data=="daoxing"?SDS_D->no_color_msg(COMBAT_D->chinese_daoxing(rewards)):rewards)+NOR YEL" 的 "WHT+d_msg+YEL" 奖励。\n\n"NOR);
        team[i]->save();
        }
}                       

void attack1(object who)
{
int i;          
object *inv,guard;
if ( !who || !this_object()->is_fighting(who) )
        return;
inv = all_inventory(environment());
i = sizeof(inv);
while(i--)
        {
        if ( inv[i]->is_corpse() )
                {
                message_vision(HIB
                "\n$N"HIB"对著地上的$n"HIB"喃喃地念了几句咒语，$n"HIB"抽搐了几下竟站了起来！\n\n"NOR,this_object(),inv[i]);
                inv[i]->animate(this_object());
                who->remove_all_killer();
                inv[i]->kill_ob(who);
                who->kill_ob(inv[i]);
                }
        if ( inv[i]->query("is_skeleton") )
                {
                message_vision(HIB"\n$N"HIB"对着地下的$n"HIB"念了几句咒语。\n\n"NOR,this_object(),inv[i]);
                guard = new("/obj/npc/skeleton");
                guard->move(environment());
                guard->invocation(this_object());
                message_vision(HIB"\n$N"HIB"竟摇摇晃晃地站了起来。\n\n"NOR,inv[i]);
                set_temp("necromancy", guard);
                destruct(inv[i]);
                who->remove_all_killer();
                guard->kill_ob(who);
                who->kill_ob(guard);
                }
        }
}

void attack2(object who)
{
object *team;
int i,damage;   
if ( !who || !this_object()->is_fighting(who) )
        return;
team = who->query_team();
if ( !pointerp(team) )
        return;
message_vision(HIR "\n$N"HIR"退后两步，深深地吸一口气，猛然发出股如山崩海啸般的龙吟！\n\n"NOR,this_object());
i = sizeof(team);
while(i--)
        {
        if ( !living(team[i]) ) continue;
        if ( present(team[i],environment()) )
                continue;
        damage = team[i]->query("kee")/10;      
        team[i]->receive_damage("sen", damage,this_object());
        team[i]->receive_wound("sen", damage/2, this_object());
        tell_object(team[i], RED"你觉得眼前一阵金星乱冒，耳朵痛得像是要裂开一样！\n"NOR);
        COMBAT_D->report_sen_status(team[i]);           
        }
}       

void attack3(object who)
{
mapping sn;     
if ( !who || !this_object()->is_fighting(who) )
        return;

message_vision(HIW"\n$N"HIW"口念咒语，对着$n"HIW"结印一指，大喝一声“封魔”！！\n\n"NOR,this_object(),who);
if ( mapp(sn=who->query_temp("no_perform")) )
        {
        message_vision(HIG"$n"HIG"四周妖气翻涌，将$p周身真气冻结了开来！\n\n"NOR,this_object(),who);   
        if ( random(2) )
                {
                tell_object(who,YEL"你被暂时封住了外功。\n"NOR);
                sn["start"]=time();
                sn["time"] = sn["time"]+random(3);
                }
        else    message_vision(HIY"$n"HIY"将"HIG+(stringp(who->query_skill_mapped("force"))?to_chinese(who->query_skill_mapped("force")):"内功")+HIY"将四周的妖气震散开去！\n"NOR,this_object(),who);
        }
else if ( mapp(sn=who->query_temp("no_cast")) )
        {
        message_vision(HIG"$n"HIG"四周妖气翻涌，将$p周身灵气冻结了开来！\n\n"NOR,this_object(),who);   
        if ( random(2) )
                {
                tell_object(who,YEL"你被暂时封住了法术。\n"NOR);
                sn["start"]=time();
                sn["time"] = sn["time"]+random(3);
                }
        else    message_vision(HIY"$n"HIY"将"HIG+(stringp(who->query_skill_mapped("spells"))?to_chinese(who->query_skill_mapped("spells")):"法术")+HIY"将四周的妖气震散开去！\n"NOR,this_object(),who);
        }
else    {
        message_vision(HIG"$n"HIG"四周妖气翻涌，将$p周身真气冻结了开来！\n\n"NOR,this_object(),who);   
        if ( random(2) )
                {
                tell_object(who,YEL"你被暂时封住了外功。\n"NOR);
                who->set_temp("no_perform",([
                        "start" : time(),
                        "time"  : random(3)+1,
                        ]));    
                }
        else    message_vision(HIY"$n"HIY"将"HIG+(stringp(who->query_skill_mapped("force"))?to_chinese(who->query_skill_mapped("force")):"内功")+HIY"将四周的妖气震散开去！\n"NOR,this_object(),who);
        }
}       
        
int attack()
{
object who = select_opponent();

if ( who && this_object()->is_fighting(who) )
        {
        atk++;
        if ( atk%5==0 )
                {
                switch(random(10))
                        {
                        case 0 :
                        case 9 :
                                attack1(who);
                                break;
                        case 1 :
                        case 8 :
                                attack2(who);
                                break;
                        default :
                                attack3(who);
                        }
                }
        }
return ::attack();
}

void die()
{
object room,*r;
if ( query("force")>500 )   {  
     SDS_D->addEffKee(this_object());
     SDS_D->addEffKee(this_object());
     ("/cmds/std/say")->main(this_object(),"我。。觉。。得。。我。。还。可以再抢。。救一下。。。\n");
     return;
     }
room = find_object("/d/snowtu/team/start");
if ( room )
        {
        if ( pointerp(r=room->query("random_room")) )
                {
                message_vision(HIR"\n\n四周空间忽变，仿佛随时都会坍塌！\n\n"NOR,this_object());        
		start_call_out( (: call_other, room, "remove_room",r :),0); 
                }
        }
::die();
}                                       
