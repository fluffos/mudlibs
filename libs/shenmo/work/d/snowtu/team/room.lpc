#include <ansi.h>
inherit ROOM;

string *names = ({
  "原野小路", "眼前是广袤的原野，脚下松软的草地，走在上面，让人觉\n得一阵的写意。\n",
  "山路", "四周是陡峭的山崖，走在路中耳边不停传来野兽的吼声，\n叫人不由的暗生警觉。\n",
  "泥泞小路", "连日的细雨让脚下的道路此刻更是难行，走在小路上，耳\n边不时传来鞋子击打泥水的踏哒之声。\n",
  "树林", "四周是高耸的树木，仰目看不到天穹，树林深处不时传出\n虫鸣天籁之音。\n",
  "林中小道", "四周是高耸的树木，仰目看不到天穹，树林深处不时传出\n虫鸣天籁之音。\n",
  "山间小径", "四周是陡峭的山崖，走在路中耳边不停传来野兽的吼声，\n叫人不由的暗生警觉。\n",
  "悬崖壁", "四周是陡峭的山崖，走在路中耳边不停传来野兽的吼声，\n叫人不由的暗生警觉。\n",
});

void setup() {
  int i;
  string str1, str2;
  ::setup();
  i = random(sizeof(names) / 2) * 2;
  str1 = names[i];
  str2 = names[i + 1];
  set("short", str1);
  set("long", str2);
  set("alternative_die", 1);
  set("hs_world", 1);
}

void create() {
  seteuid(geteuid());
  set("objects", ([
    //      "/d/snowtu/4ling/npc/evl1.lpc" : random(3),
  ]));
  setup();
}

void valid_move(object who) {
  object *inv = all_inventory();
  if (sizeof(inv))
    return;
  else destruct(this_object());
}

int valid_leave(object who, string dir) {
  if (userp(who)) {
    if (who->is_fighting())
      return notify_fail("你在战斗中一时手忙脚乱，看不清方向。。。\n");
  }
  return ::valid_leave(who, dir);
}

void alternative_die(object who) {
  object kl, *team;
  if (!userp(who)) {
    delete("alternative_die");
    who->die();
    set("alternative_die", 1);
    return;
  } else {
    kl = who->query_temp("last_damage_from");
    if (kl && present(kl, this_object())) {
      who->powerup();

      team = who->query_team();
      if (team && pointerp(team))
        message("team", HIW "【组队】" + who->query("name") + "：被打死了，失去了部分的等级经验。\n" NOR, team);
      else tell_object(who, YEL "『系统』你被打死了，失去了部分的等级经验。\n" NOR);
      who->add("level_exp", -who->query("level_exp") / 100);
      who->dismiss_team();
      who->save();
      who->move("/d/city/kezhan");
      message_vision(HIB "$N在未知世界中被" + kl->query("name") + HIB "杀死了！\n\n" NOR, who);
      return;
    } else {
      who->powerup();
      who->save();
      who->move("/d/city/kezhan");
      team = who->query_team();
      if (team && pointerp(team))
        message("team", HIW "【组队】" + who->query("name") + "：从未知世界中返回了。\n" NOR, team);
      else message_vision(HIB "$N从未知世界中返回了。\n\n" NOR, who);
      return;
    }
  }
}

void init() {
  add_action("do_quit", "halt");
  add_action("do_quit", "quit");
  add_action("do_fight", "fight");
}

int do_quit() {
  object me = this_player();
  if (!me->is_busy() && !me->is_fighting()) {
    me->remove_all_killer();
    all_inventory()->remove_killer(me);
  }
  me->die();
  return 1;
}

int do_fight(string arg) {
  write(HIR "安心作战吧。\n" NOR);
  this_player()->add("force", -this_player()->query("force") / 5);
  this_player()->add("mana", -this_player()->query("mana") / 5);
  this_player()->add("kee", -this_player()->query("kee") / 5);
  this_player()->add("sen", -this_player()->query("sen") / 5);
  return 1;
}
