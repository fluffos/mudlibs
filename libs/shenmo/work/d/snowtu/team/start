void delete_room(object *ob)
{
int i,k;
object *inv;    
if ( !pointerp(ob) )
        return;
i = sizeof(ob);
while(i--)
        {
        if ( objectp(ob[i]) )
                {
                inv = all_inventory(ob[i]);
                k = sizeof(inv);
                while(k--)
                        {
                        if ( objectp(inv[k]) )
                                {
                                if ( !userp(inv[k]) )
                                        destruct(inv[k]);
                                else    inv[k]->command("halt");
                                }
                        }
                destruct(ob[i]);
                }
        }                                                               
}               

int valid_leave(object who,string dir)
{
int i,ff=0;
object *ob,*where;
object w0,w1,w2,w3,w4,w5,w6,w7,w8,w9,w10,w11,w12,w13,w14,w15,w16,w17,w18,w19,w20;
object r1,r2;
string di,*dis;
string name;

if ( s_flag )
        return notify_fail("这个入口已经有人进入了。\n");
                
if ( !userp(who) )
        return 0;
if ( dir=="west" )
        {
        ob = who->query_team(); 
        if ( !ob || !pointerp(ob) )
                return notify_fail("你尚未组队，不能进入！\n");
        if ( !who->is_team_leader() )
                return notify_fail("你不是所在小组的组织者，不能进入。\n");
        i = sizeof(ob);
        name = who->query("name")+"带领";
        while(i--)                                                                     
                {
                if ( ob[i]==who )
                        continue;
                name+= ob[i]->query("name")+" ";
                }
        s_flag = 1;     
        message("channel:rumor",HIB"\n听说 "+name+"闯进了"HIR"未知空间"HIB"！为时五分钟\n\n"NOR,users());
        w0 = clone_object(__DIR__"room.c");
        if ( !w0 )
                error("__DIR__'room.c' 缺少!\n");
        w1 = clone_object(__DIR__"room.c");
        w2 = clone_object(__DIR__"room.c");
        w3 = clone_object(__DIR__"room.c");
        w4 = clone_object(__DIR__"room.c");
        w5 = clone_object(__DIR__"room.c");
        w6 = clone_object(__DIR__"room.c");
        w7 = clone_object(__DIR__"room.c");
        w8 = clone_object(__DIR__"room.c");
        w9 = clone_object(__DIR__"room.c");
        w10 = clone_object(__DIR__"room.c");
        w11 = clone_object(__DIR__"room.c");
        w12 = clone_object(__DIR__"room.c");
        w13 = clone_object(__DIR__"room.c");
        w14 = clone_object(__DIR__"room.c");
        w15 = clone_object(__DIR__"room.c");
        w16 = clone_object(__DIR__"room.c");
        w17 = clone_object(__DIR__"room.c");
        w18 = clone_object(__DIR__"room.c");
        w19 = clone_object(__DIR__"room.c");
        w20 = clone_object(__DIR__"room.c");
        where = ({w0,w1,w2,w3,w4,w5,w6,w7,w8,w9,w10,
                  w11,w12,w13,w14,w15,w16,w17,w18,w19,w20});
        remove_call_out("delete_room");
        call_out("delete_room",300,where);
        while(ff<21)
                {
                r1 = where[random(sizeof(where))];
                dis = keys(wks);
                di = dis[random(sizeof(dis))];
                if ( !r1->query("exits/"+di) ) 
                        {
                        r2 = where[random(sizeof(where))];
                        if ( !r2->query("exits/"+wks[di]) ) 
                                {
                                ff++;   
                                r1->set("exits/"+di,r2);
                                r2->set("exits/"+wks[di],r1);
                                message("team",YEL"『"WHT"系统"YEL"』"CYN"通道随机连机"+ff+"完成\n"NOR,ob);
                                }
                        }
                }
        i = sizeof(ob);
        while(i--)
                {
                ob[i]->start_busy(1);
                if ( ob[i]->move(w0) )
                        message("team",HIW"【组队】"+ob[i]->query("name")+HIW"：我已进入地图。\n"NOR,ob);
                }       
        return notify_fail("你决定带领队员进入未知空间。\n");
        }
return 0;
}       
