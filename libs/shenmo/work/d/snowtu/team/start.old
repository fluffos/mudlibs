#include <ansi.h>
inherit ROOM;

int r_flag = 0;
int s_flag = 0;
int same_ip = 0;
mapping wks = ([
        "north" : "south",
        "south" : "north",
        "west"  : "east",
        "east"  : "west",
        "out"   : "enter",
        "enter" : "out",
        "up"    : "down",
        "down"  : "up",
]);

:varargs void set_same_ip(int num);
string *dirs = ({
        "/d/youxia/",           //wanmei
        "/d/qujing/fengxian/",  //fengxian
        "/d/qujing/huangfeng/", //huangfeng
        "/d/qujing/baoxiang/",  //baoxiang
        "/d/qujing/pingding/",  //pingding yalong
        "/d/qujing/wuji/",      //wuji
        "/d/qujing/jindou/",    //jindou
        "/d/qujing/nuerguo/",   //nrg
        "/d/qujing/dudi/",      //dudi
        "/d/qujing/firemount/", //firemount
        "/d/qujing/jilei",      //jilei
        "/d/qujing/jisaiguo/",  //jisaiguo
        "/d/qujing/jingjiling/",//jjl
        "/d/qujing/xiaoxitian/",//xxt
        "/d/qujing/zhuzi/",     //zhuzi
        "/d/qujing/qilin/",     //qilin
        "/d/qujing/pansi/",     //pansi
        "/d/qujing/biqiu/",     //biqiu
        "/d/qujing/qinfa/",     //qinfa qinghua
        "/d/qujing/yuhua/",     //yuhua
        "/d/qujing/baotou/",    //baotou
        "/d/qujing/zhujie/",    //zhujie
        "/d/qujing/qinglong/",  //qinglong
        "/d/qujing/jinping/",   //jinping
        "/d/qujing/tianzhu/",   //tianzhu
        "/d/qujing/maoying/",   //my
        "/d/qujing/sanjie/",    //sanjie
        "/d/qujing/wuzhuang/",  //wzg
        "/d/dntg/hgs/", //hgs
});     

void clear_data()
{
r_flag = 0;
s_flag = 0;
}

object random_room()
{
int  i, j,k;
object newob;
mixed*  file, exit;
if( !sizeof(dirs) )  return 0;
if( !sizeof(dirs) )  return 0;

i = random(sizeof(dirs));    
file = get_dir( dirs[i]+"/*.c", -1 );
if( !sizeof(file) )
        {
        write("size of file <0\n");     
        return 0;
        }
for(k=0;k<30;k++) 
        { 
        j = random(sizeof(file));
        if( file[j][1] > 0 ) 
                {
                newob = load_object(dirs[i]+file[j][0]);
                if (newob) 
                        {  
                        if( newob->query("no_fight") || newob->query("no_magic") 
                         || !(exit=newob->query("exits")) || sizeof(exit)<1 
                        || sizeof(all_inventory(newob))<1 )
                                continue;
                        else    return newob;
                        }
                }
        else    {
                write("no file.\n");
                return 0;
                }       
        }
return 0;
}

void remove_room(object where)
{
if ( !where )
        return;
where->set("exits",where->query("old_exit"));
where->delete("old_exit");
set_same_ip(0);
message("channel:rumor",HIB"\n大变过后，"HIR+MISC_D->find_place(where)+HIB" 逐渐又恢复了往日的平静。。。。\n\n"NOR,users());        
}

void setup()
{
object where;   
::setup();
if ( r_flag!=1 )
        {
        where = random_room();
        if ( !where || !objectp(where) || stringp(where->query("exits/enter")) )
                message("channel:rumor",HIB"\n风云恒远，波澜不惊，此刻什么变化也没有。。。。\n\n"NOR,users());
        else    {
                r_flag = 1;
                where->set("old_exit",where->query("exits"));
                where->set("exits/未知世界",__FILE__);
                remove_call_out("remove_room");
              set("random_room",where);
              call_out("remove_room",300,where);
                message("channel:rumor",HIB"\n风云忽变，波澜狂涌，据说在 "HIR+MISC_D->find_place(where)+HIB" 出现了一道奇怪的入口。。。。\n\n"NOR,users());
                }               
        }
}
        
void create()
{
set("short","未知世界入口");
set("long",YEL+@LONG
这里是未知世界的入口。进入未知世界，必须知道
        1.      在此世界死亡，只会减少等级经验，如果等级经验小于0，
                则会自动降一级；
        2.      在此世界，必须组队进入(help team)，等级相差30级以
                外的，不能组队；
        3.      在此世界内的怪物，杀死后，随机有武学经验或道行或潜
                能或等级经验奖励。
        4.      杀此怪物后，在场的组员全部有相应的奖励。
        5.      如果想中途退出未知世界，输入 quit|halt 即可
        
LONG+NOR);
set("exits",([
        "west" : __DIR__"road",
]));
setup();
}

void delete_room(object *ob)
{
int i,k;
object *inv;    
if ( !pointerp(ob) )
        return;
i = sizeof(ob);
while(i--)
        {
        if ( objectp(ob[i]) )
                {
                inv = all_inventory(ob[i]);
                k = sizeof(inv);
                while(k--)
                        {
                        if ( objectp(inv[k]) )
                                {
                                if ( !userp(inv[k]) )
                                        destruct(inv[k]);
                                else    inv[k]->command("halt");
                                }
                        }
                destruct(ob[i]);
                }
        }                                                               
}               

int valid_leave(object who,string dir)
{
int i,ff=0,ss=0;
int kk;
object *ob,*where;
object w0,w1,w2,w3,w4,w5,w6,w7,w8,w9,w10,w11,w12,w13,w14,w15,w16,w17,w18,w19,w20;
object r1,r2,guai;
string di,*dis;
string name;

if ( s_flag )
        return notify_fail("这个入口已经有人进入了。\n");
                
if ( !userp(who) )
        return 0;
if ( dir=="west" )
        {
        ob = who->query_team(); 
        if ( !ob || !pointerp(ob) )
                return notify_fail("你尚未组队，不能进入！\n");
        if ( !who->is_team_leader() )
                return notify_fail("你不是所在小组的组织者，不能进入。\n");
        i = sizeof(ob);
        name = who->query("name")+"带领";
        while(i--)                                                                     
                {
                if ( !ob[i] || ob[i]==who )
                        continue;
                name+= ob[i]->query("name")+" ";
                }
        s_flag = 1;     
        message("channel:rumor",HIB"\n听说 "+name+"闯进了"HIR"未知空间"HIB"！为时五分钟\n\n"NOR,users());
        w0 = new(__DIR__"road0");
        if ( !w0 )
                error("__DIR__'room.c' 缺少!\n");
        w1 = new(__DIR__"road1.c");
        w2 = new(__DIR__"road2.c");
        w3 = new(__DIR__"road3.c");
        w4 = new(__DIR__"road4.c");
        w5 = new(__DIR__"road5.c");
        w6 = new(__DIR__"road6.c");
        w7 = new(__DIR__"road7.c");
        w8 = new(__DIR__"road8.c");
        w9 = new(__DIR__"road9.c");
        w10 = new(__DIR__"road10.c");
        w11 = new(__DIR__"road11.c");
        w12 = new(__DIR__"road12.c");
        w13 = new(__DIR__"road13.c");
        w14 = new(__DIR__"road14.c");
        w15 = new(__DIR__"road15.c");
        w16 = new(__DIR__"road16.c");
        w17 = new(__DIR__"road17.c");
        w18 = new(__DIR__"road18.c");
        w19 = new(__DIR__"road19.c");
        w20 = new(__DIR__"road20.c");
        where = ({w0,w1,w2,w3,w4,w5,w6,w7,w8,w9,w10,
                  w11,w12,w13,w14,w15,w16,w17,w18,w19,w20});
        remove_call_out("delete_room");
        call_out("delete_room",300,where);
        while(ff<20)
                {
                r1 = where[ff];
                dis = keys(wks);
                di = dis[random(sizeof(dis))];
                if ( !r1->query("exits/"+di) ) 
                        {
                        r2 = where[ff+1];
                        if ( !r2->query("exits/"+wks[di]) ) 
                                {
                                ff++;   
                                r1->set("exits/"+di,r2);
                                r2->set("exits/"+wks[di],r1);
                                message("team",YEL"『"WHT"系统"YEL"』"CYN"随机通道"+ff+"连接完成\n"NOR,ob);
                                }
                        }
                }
        for(kk=0;kk<30;kk++)  
                {
                if ( random(2) )  
                        {  
                        guai = new(__DIR__"npc/evl1");
                        if ( guai && guai->move(where[random(sizeof(where))]) )
                                message("team",YEL"『"WHT"系统"YEL"』"CYN"怪物"+guai->name()+"随机刷新完成。\n"NOR,ob);
                        }
                }
        if ( ss<1 )
                {
                guai = new(__DIR__"npc/evl2");
                if ( guai && guai->move(where[random(sizeof(where))]) )
                        {
                        ss++;
                        message("team",YEL"『"WHT"系统"YEL"』"CYN"唯一高级怪"+guai->name()+"随机刷新完成。\n"NOR,ob);
                        }               
                }
        i = sizeof(ob);
        while(i--)
                {
                if ( !ob[i] )
                       continue;
                ob[i]->start_busy(1);
                if ( ob[i]->move(w0) )
                        message("team",HIW"【组队】"+ob[i]->query("name")+HIW"：我已进入地图。\n"NOR,ob);
                }       
        return notify_fail("你决定带领队员进入未知空间。\n");
        }
return 0;
}       

void init()
{
if ( !userp(this_player()) )   {destruct(this_player());return;}

}

varargs void set_same_ip(int num)
{
if ( !num )  num = 0;
else num = 1;
same_ip = num;
}

int is_same_ip()
{
return same_ip;
}
