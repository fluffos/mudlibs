#include <ansi.h>
inherit PERFORM;
inherit F_SAVE;

void create()
{
seteuid(geteuid());
set("channel_id", "Pfm自制物件");
set("id", "player_pfm");
}

int check_id(string id)
{
int i;
string *legalid;

if ( !id ) 
        return 0;
        
i = strlen(id);
  
if ( (strlen(id)<3) || (strlen(id)>8) ) 
        return 0;
while(i--)
        {
        if( id[i]<'a' || id[i]>'z' ) 
                return 0;
        }
legalid = ({
        "fuck","sex","shit","tmd","tnnd","ri","gan",
});
if ( member_array(id,legalid)!=-1 )
        return 0;
for(i=0; i<sizeof(legalid); i++)   
        {
        if ( strsrch(id,legalid[i])!=-1 )
                return 0;
        }       
return 1;
}

string query_save_file()
{
string name,owner;
owner = query("owner_id");      
if ( !stringp(owner) )
        return 0;
name = query("pfm_id"); 
if ( !check_id(name) )
        return 0;
return "/d/snowtu/c/"+query("owner_id")+"/"+query("pfm_id");
}

int save()
{
string dir;
object who;
        
if ( !stringp(dir=query("owner_id")) )
        return 0;
who = find_player(dir);
if ( !who || !objectp(who) || !living(who) )
        return 0;       
if ( !stringp(query("pfm_id")) )
        return 0;
dir = "/d/snowtu/c/"+dir;       
if ( file_size(dir)!=-2 )       //无此目录
        {
        if ( !mkdir(dir) )
                {
                write(YEL"\n新增外功目录失败！无法储存。\n"NOR);
                return 0;
                }
        }
if ( file_size(dir+"/"+query("pfm_id"))>0 )
        {
        write(YEL"目前该目录下已存在同名的文件！无法写入。\n"NOR);
        return 0;
        }
if ( !::save() )
        {
        write(YEL"写入失败！\n"NOR);
        return 0;
        }
message("channel:rumor",sprintf(HIM"【"NOR HIW"顺风耳"NOR HIM"】某人：听说 "HIR"%s(%s)"HIM" 洞破天机，自创了 "HIR"%s"HIM" 一招绝招 "HIR"%s"HIM" ！\n"NOR,
                                        who->name(),
                                        capitalize(who->query("id")),
                                        stringp(query("belong"))?to_chinese(query("belong")):"",
                                        query("name"),
                                        ),
        users());
write_file( "/d/snowtu/pfm/data",sprintf("\n%s 于 %s 自创了 %s . \n",who->query("id"),ctime(time()),query("pfm_id")) );
}
                                
                
