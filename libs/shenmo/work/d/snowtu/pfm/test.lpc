#include <ansi.h>
inherit NPC;

int improved(object me);

int is_character() {
  if (strsrch(query("name"), "像") != -1)
    return 0;
  return 1;
}

string *parse_command_id_list() {
  string *applied_id;

  if (is_character()) {
    if (pointerp(applied_id = query_temp("apply/id"))
      && sizeof(applied_id))
      return applied_id;
    else return ({ "fu xi", "fu", "xi", "master" });
  }
  return ({ "diao xiang", "xiang", "image" });
}

string short() {
  string str;
  if (is_character())
    str = HIR " <" HIY "虚像" HIR ">" NOR;
  else str = "";
  return ::short() + str;
}

string long() {
  string str;
  if (is_character())
    str = HIY "虚无飘渺的一个幻像，若隐若现。背后万莲绽放，流光涌动。\n" NOR;
  else str = YEL "一尊伏曦神的神像，看来得诚心叩拜(koubai)才行。\n" NOR;
  return str;
}

string check_me() {
  object me = this_player();

  if (!wizardp(me))
    return "目前自创pfm还在测试中。";
  if (me->query_temp("snowtu_pfm"))
    return "如果你决定了，就开始领悟吧。(lingwu)";
  if (me->query("combat_exp") / 10000 < 5000)
    return "你的经验不够，还是练练吧。";
  if (me->query("daoxing") / 1000 < 10000)
    return "你的道行不够，还是练练吧。";
  if (me->query("level") < 150)
    return "你的等级不够，还是歇歇吧。";
  me->set_temp("snowtu_pfm", 1);
  say(CYN + name() + CYN "点了点头，道：好，看来你是有心之人。\n" NOR);
  message_vision(HIG "\n$n" HIG "对着$N" HIG "一阵咏唱，$P顿时觉得心头好似灵光一闪。\n\n" NOR, me, this_object());
  return "你就在此处领悟(lingwu)一番吧。";
}

void create() {
  set_name("雕像", ({ "diao xiang", "xiang" }));
  set_weight(1000000);
  set("combat_exp", -1);
  set("daoxing", -1);
  set("max_force", -1);
  set("max_mana", -1);
  set("max_kee", 100000);
  set("max_sen", 100000);
  set("kee", 100000);
  set("sen", 100000);
  set("gender", "男性");
  set("inquiry", ([
    "自创武功": (: check_me :),
  ]));
  set("per", 40);
  setup();
}

void init() {
  add_action("do_push", "koubai");
  add_action("do_lingwu", "lingwu");
}

int do_push(string arg) {
  int success = 0;
  object me = this_player();

  if (!arg || !id(arg))
    return notify_fail("你要对谁叩拜？\n");
  if (is_character())
    return notify_fail(name() + "呵呵一笑：你太客气了。\n"); ;
  if (me->query("kee") < 100)
    return notify_fail("你太累了，还是休息休息。\n");
  tell_object(me, "你虔诚的趴在地上，对着" + name() + "一个劲的叩拜。\n");
  me->receive_damage("kee", 100);
  if (random(me->query_str()) > 20)
    success = 1;
  if (success != 1) {
    tell_object(me, "你累了一脖子的汗，可是" + name() + "还是丝毫没有反应。\n");
    return 1;
  }
  message_vision(HIY "但见金光一闪，石像一下子变成了一道隐约的虚像。\n" NOR, me);
  set_name("伏曦", ({ "fu xi", "fuxi", "fu", "master" }));
  call_out("die", 120);
  return 1;
}

void die() {
  SDS_D->powerup(this_object());
  tell_room(environment(), YEL "虚像渐渐还原为石像。。。\n" NOR);
  this_object()->create();
  return;
}

void unconcious() {
  die();
}

int do_lingwu() {
  string base, skill;
  object weapon, me = this_player();

  if (!me->query_temp("snowtu_pfm"))
    return 0;
  weapon = me->query_temp("weapon");
  if (!weapon)
    return notify_fail("你手里没有神兵，如何领悟？\n");
  base = weapon->query("skill_type");
  if (me->query_skill(base, 1) < 350)
    return notify_fail("你此项功夫基础不够。\n");
  skill = me->query_skill_mapped(base);
  if (me->query_skill(skill, 1) < 350)
    return notify_fail("你此项功夫修为不够。\n");
  tell_object(me, "你开始深深领悟" HIY + to_chinese(skill) + NOR "的精髓。\n");
  me->set_temp("snowtuPfm/belong", skill);
  me->set_temp("snowtuPfm/base_type", base);
  if (!improved(me)) {
    me->delete_temp("snowtuPfm");
    return notify_fail("你没能抓住那瞬间的灵光。\n");
  }
  return 1;
}

int improved(object me) {
  object tt;

  if (!me || !living(me))
    return 0;
  tt = new(__DIR__ "master");
  if (!tt) {
    tell_object(me, "自创文件不存在！\n");
    return 0;
  }
  tt->set("belong", me->query_temp("snowtuPfm/belong"));
  tt->set("base_type", me->query_temp("snowtuPfm/base_type"));
  tt->set("betray_lvl", 350);
  tt->set("force", me->query("force") > 300 ? 250 : me->query("force"));
  tt->set("owner_id", me->query("id"));
  me->delete_temp("snowtuPfm");
  tell_object(me, HIW "你的心中升起一种异样的感觉，仿佛抓住了一丝重要的东西。\n" NOR);
  tell_object(me, "请为这招取一个名字：");
  input_to((: call_other, __FILE__, "name_skill", me, tt :));
  return 1;
}

void name_skill(object me, object tt, string arg) {
  int i;
  string *banned_name = ({
    "你", "你", "我", "他", "她", "它", "爸", "妈",
    "爷", "奶", "巫师", "天神", "神仙", "兔",
  });
  if (!me)
    return;
  if (!arg || arg == "") {
    tell_object(me, "请为你的新招式取一个英文名字：");
    input_to((: call_other, __FILE__, "id_skill", me, tt :));
    return;
  }
  i = strlen(arg);
  while (i--) {
    if (arg[i] <= ' ') {
      tell_object(me, "招式名字不能使用控制字元，请重新设定一个名字：");
      input_to((: call_other, __FILE__, "name_skill", me, tt :));
      return;
    }
    if (strsrch(arg, "　") >= 0) {
      tell_object(me, "招式名字不能有空格，请重新设定一个名字：");
      input_to((: call_other, __FILE__, "name_skill", me, tt :));
      return;
    }
    if (i % 2 == 0 && !is_chinese(arg[i..<0])) {
      tell_object(me, "请您用「中文」为你的新招式取名字：");
      input_to((: call_other, __FILE__, "name_skill", me, tt :));
      return;
    }
  }
  i = sizeof(banned_name);
  while (i--) {
    if (strsrch(arg, banned_name[i]) != -1) {
      tell_object(me, "对不起，这种名字会造成其他人的困扰。请重新设定一个名字：");
      input_to((: call_other, __FILE__, "name_skill", me, tt :));
      return;
    }
  }
  if ((strlen(arg) < 2) || (strlen(arg) > 8)) {
    tell_object(me, "对不起，招式名字必须是 1 到 4 个中文字：");
    input_to((: call_other, __FILE__, "name_skill", me, tt :));
    return;
  }
  tt->set("name", arg);
  tell_object(me, "请为这招取一个英文名字：");
  input_to((: call_other, __FILE__, "id_skill", me, tt :));
  return;
}

void id_skill(object me, object tt, string arg) {
  int i;
  string *banned_id;
  if (!me)
    return;
  banned_id = ({ "fuck", "wiz", "shit", "snowtu", "tom", "run", "yhq", "tmd", "tmmd",
  });
  if (!arg || arg == "") {
    tell_object(me, "请为你的新招式取一个英文名字：");
    input_to((: call_other, __FILE__, "id_skill", me, tt :));
    return;
  }
  i = strlen(arg);
  while (i--) {
    if (arg[i] <= ' ') {
      tell_object(me, "招式名字不能使用控制字元，请重新设定一个名字：");
      input_to((: call_other, __FILE__, "id_skill", me, tt :));
      return;
    }
    if (strsrch(arg, "　") >= 0) {
      tell_object(me, "招式名字不能有空格，请重新设定一个名字：");
      input_to((: call_other, __FILE__, "id_skill", me, tt :));
      return;
    }
    if (is_chinese(arg[i..<0])) {
      tell_object(me, "请您用「英文」为你的新招式取名字：");
      input_to((: call_other, __FILE__, "id_skill", me, tt :));
      return;
    }
  }
  i = sizeof(banned_id);
  while (i--) {
    if (strsrch(arg, banned_id[i]) != -1) {
      tell_object(me, "对不起，这种名字会造成其他人的困扰。请重新设定一个名字：");
      input_to((: call_other, __FILE__, "id_skill", me, tt :));
      return;
    }
  }
  if ((strlen(arg) < 2) || (strlen(arg) > 6)) {
    tell_object(me, "对不起，招式名字必须是 2 到 6 个字母：");
    input_to((: call_other, __FILE__, "id_skill", me, tt :));
    return;
  }
  tt->set("pfm_id", arg);
  if (tt->save())
    write("存储结束。\n");
  else write("存储失败。\n");
  return;
}
