inherit ROOM;
#include <ansi.h>
#include "/cmds/std/valid_move.h"


int random_look()
{
string msg;
object me = this_player();
switch( random(5) )
	{
	case 1 :
		msg = HBBLU HIW+@LONG

	∴°★．☆° ．★·°∴°★．° ．·。∴°		
	☆ ．·°∴° ☆．．·°∴°．☆°★°∴°		
	°∴ 那怕星际无垠 ☆° ．·★°∴°．°°		
	∴°．°★ ．·°∴°．°∴°．★☆° ．·		
