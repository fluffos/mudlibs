void create() {
  set("short", HIG "万木春的炼丹房" NOR);
  set("long", @LONG   
   这是万木春炼丹的地方,可以说是恶人谷中特有的世外桃园,到处放着各种瓶瓶罐罐,房间里充斥着各种药味
LONG);
  set("no_magic", 1);

  setup();
}
void init() {
  object ob;
  if (interactive(ob = this_player()))
    call_out("blowing", random(10) + 1, ob);
  add_action("block_cmd", "", 1);
}
int blowing(object ob) {
  int ilvl;
  int damage;
  string name, ids, gender, des;
  string zy, xd;
  object *inv;
  string *mob;
  int i;
  i = random(sizeof(names) / 5) * 5;
  name = names[i];
  ids = names[i + 1];
  gender = names[i + 2];

  if (ob && environment(ob) == this_object()) {
    i = random(sizeof(zhongyao));

    message_vision("万木春拿起" + HIY + zhongyao[i] + NOR + "给$N喂了下去\n", ob);
    if (ob->query("jiayi_second") < 1) {
      ob->die();
      return 1;
    }

    if (i % 20) {

      message_vision("药性好像不对,$N受的伤加重了\n", ob);
      ob->receive_wound("kee", random(300) + 300);
      COMBAT_D->report_sen_status(ob);
      ob->receive_wound("sen", random(300) + 300);
      COMBAT_D->report_sen_status(ob);
      if (ob->query("maximum_mana") > 10)
        ob->add_maximum_mana(-10);
      if (ob->query("maximum_force") > 10)
        ob->add_maximum_force(-10);
      tell_object(ob, HIW "辛苦修炼的内力法力，被乱窜的嫁衣神功所吞噬\n\n" NOR);

    } else {
      i = ob->query_temp("jiayi_begin_1");
      i %= 108;
      message_vision("药好像起了作用,万木春赶紧拿起银针向$N的" + HIW + xuedao[i] + NOR + "受的伤变轻了\n", ob);
      ob->add_temp("jiayi_begin_1", 1);
      if (ob->query_skill("jiayi-force", 1) > 500 &&
        ob->query_temp("jiayi_begin_1") > 108 && random(10) == 1 &&
        ((int)ob->query("eff_kee") < (int)ob->query("max_kee") / 4 ||
          (int)ob->query("eff_sen") < (int)ob->query("max_sen") / 4) ||
        wizardp(ob)) {
        ob->add("jiayi_second", 1);
        ob->set_skill("jiayi-force", 1);
        ob->delete_temp("jiayi_begin_1");
        ob->command("enable force none");
        ob->command("enable spells none");
        tell_object(ob, HIW "你的嫁衣神功修炼成功\n" + NOR);
        tell_object(ob, HIW "可以使用exert jiayi了\n" + NOR);
        message(
          "chat",
          HIW "【" NOR + BLU "恶人谷" NOR + HIW "】" NOR + HIY + "据传:" + ob->query("name") + "(" + ob->query("id") + HIY ")修炼嫁衣神功成功！，大家恭喜吧\n" NOR,
          users()
        );
        message(
          "rumor",
          HIW "【" NOR + BLU "恶人谷" NOR + HIW "】" NOR + HIY + "据传:" + ob->query("name") + "(" + ob->query("id") + HIY ")修炼嫁衣神功成功！，大家恭喜吧\n" NOR,
          users()
        );
        return 1;
      }

    }
    if (environment(ob) == this_object())
      call_out("blowing", random(10) + 1, ob);


    inv = all_inventory(ob);
    for (i = 0; i < sizeof(inv); i++) {
      mob = inv[i]->parse_command_id_list();
      if (inv[i]->query_unique() || member_array("lianhua", mob) != -1) {
        message_vision("突然间，$n化一道白光飞去，无影无踪！\n", ob, inv[i]);
        destruct(inv[i]);
      }
    }


  } else
    return 1;
}


int block_cmd(string args) {
  string verb;
  verb = query_verb();

  // if (verb == "bian") return 1; // by mon 7/15 
  if (verb == "xiudao") return 1;
  if (verb == "eat") return 1;
  if (verb == "zhenshens") return 1;
  if (verb == "cure") return 1;
  if (verb == "qisihuisheng") return 1;
  return 0;
}


void reset() {
  ::reset();
}
