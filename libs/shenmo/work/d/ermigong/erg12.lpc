inherit ROOM;

void create ()
{
        set ("short", "恶人谷迷宫");
        set ("long", @LONG
这是吕仑山上自然形成的一道屏障，不熟悉的人容易在这里面迷路。
"恶人谷"，为了方便人们近谷，专门作了一盏引路的空明灯。
LONG);
        set("item_desc", ([
         "空明灯" : "入谷如登天,来人走这边->西\n",
         "deng" : "入谷如登天,来人走这边->西\n",]));

        set("exits", 
        ([ //sizeof() == 4
                "south"  : __DIR__"erg12",
                "west"  : __DIR__"erg10",
                "north" : __DIR__"erg"+sprintf("%d", 6+random(7)),
                "east"  : __DIR__"erg"+sprintf("%d", 6+random(7)),
              ]));

        setup();
}

void init()
{
           object me=this_player();
        me->set_temp("erg12",1);
        if( me->query_temp("erg0")
         && me->query_temp("erg1")
         && me->query_temp("erg2")
         && me->query_temp("erg3")
         && me->query_temp("erg4")
         && me->query_temp("erg5")
         && me->query_temp("erg6")
         && me->query_temp("erg7")
         && me->query_temp("erg8")
         && me->query_temp("erg9") 
         && me->query_temp("erg10")
         && me->query_temp("erg11")
         && me->query_temp("erg12"))
        me->set_temp("erg_ready_out",1);

}


