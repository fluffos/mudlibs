// create by fang@tsrj
// room: out.c
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "恶人谷入口");
  set("long", @LONG
江湖人心目中所想象的"恶人谷"入口，向谷中望去自然是说不出的阴森、黑暗。
出人意料的是，"恶人谷"中竟是一片辉煌的灯火。旁边的石头(stone)上刻着几个大字。
         “入谷入谷，永不为奴！”
LONG);
  set("exits",
    ([  //sizeof() == 4
    "west": __DIR__ "erg" + sprintf("%d", random(7)),
      "enter": __DIR__ "enter",
      "north": __DIR__ "erg" + sprintf("%d", 6 + random(7)),
      "east": __DIR__ "erg" + sprintf("%d", random(7)),
    ]));

  set("no_fight", 1);
  set("no_magic", 1);
  setup();
}

int valid_leave(object me, string dir) {
  int i;
  object *inv;
  mixed ob;
  if (me->query_temp("erg0")) me->delete_temp("erg0");
  if (me->query_temp("erg1")) me->delete_temp("erg1");
  if (me->query_temp("erg2")) me->delete_temp("erg2");
  if (me->query_temp("erg3")) me->delete_temp("erg3");
  if (me->query_temp("erg4")) me->delete_temp("erg4");
  if (me->query_temp("erg5")) me->delete_temp("erg5");
  if (me->query_temp("erg6")) me->delete_temp("erg6");
  if (me->query_temp("erg7")) me->delete_temp("erg8");
  if (me->query_temp("erg8")) me->delete_temp("erg8");
  if (me->query_temp("erg9")) me->delete_temp("erg9");
  if (me->query_temp("erg10")) me->delete_temp("erg10");
  if (me->query_temp("erg11")) me->delete_temp("erg11");
  if (me->query_temp("erg12")) me->delete_temp("erg12");
  if (me->query_temp("erg_ready_out")) me->delete_temp("erg_ready_out");
  if (dir == "enter") {
    if (!me->query("get_jiayi_book"))
      return notify_fail("恶人谷，太过神秘，你还是算了吧\n");
    else {
      inv = all_inventory(me);
      for (i = 0; i < sizeof(inv); i++) {
        ob = inv[i]->parse_command_id_list();
        if (inv[i]->query_unique() || member_array("lianhua", ob) != -1) {
          message_vision("突然间，$n化一道白光飞去，无影无踪！\n", me, inv[i]);
          destruct(inv[i]);
        }
      }

    }
  }
  return ::valid_leave(me, dir);
}



void init() {
  add_action("do_push", "push");
}
int do_push(string arg) {
  int i;
  object *inv;
  mixed ob;
  object me = this_player();

  if ((arg != "stone" && arg != "石头") || !arg)
    return notify_fail("你要推什么？\n");
  if (me->is_busy()) return notify_fail("你忙着呢！\n");
  if (me->query_temp("no_move")) return notify_fail("你被定住了，什么也干不了。\n");


  if (me->query("jiayi_second") > 0 && (me->query_skill("jiayi-force", 1) > 500)) {
    message_vision("$N用力推动石碑，石碑转动露出一个洞。\n", me);
    inv = all_inventory(me);
    for (i = 0; i < sizeof(inv); i++) {
      ob = inv[i]->parse_command_id_list();
      if (inv[i]->query_unique() || member_array("lianhua", ob) != -1) {

        message_vision("突然间，$n化一道白光飞去，无影无踪！\n", me, inv[i]);
        destruct(inv[i]);
      }
    }

    message_vision("万木春看了$N一眼,叹息一声，说道:跟我来吧\n", me);
    message_vision("$N随万木春离开\n", me);

    me->move(__DIR__ "hell");
    //防止刷屏
    //           message("chat",HIW+"【"NOR+BLU"恶人谷"NOR+HIW"】"NOR+HIY+"据传:"+me->query("name")+"("+me->query("id")+HIY")给万木春带走了！\n"NOR,users());
    //           message("rumor",HIW+"【"NOR+BLU"恶人谷"NOR+HIW"】"NOR+HIY+"据传:"+me->query("name")+"("+me->query("id")+HIY")给万木春带走了！\n"NOR,users());
    return 1;
  } else {
    message_vision("只听“哗啦”一声，石头正砸在$N头顶！\n", me);
    message_vision("$N伤得颇重，而且神志也有点不清了。\n", me);
    me->receive_wound("kee", 1000);
    me->receive_wound("sen", 1000);
  }
  return 1;
}
