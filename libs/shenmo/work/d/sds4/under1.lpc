//under1.c

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "海底");
  set("long", @LONG

到了一个水中世界。海面上波浪汹涌，这里却静得出奇。一群群银
色的小鱼在蓝色的海水中游来游去，脚下是色彩斑斓的珊湖礁，其
中白色的珊瑚连成一线，如一条白云铺成的道路。
LONG);

  set("water", 1);
  set("exits", ([ /* sizeof() == 2 */
    "east": __DIR__ "under2",
  ]));
  set("objects", ([
    "/d/sds4/npc/mry": 1,
  ]));
  setup();
  message(
    "channel:chat",
    WHT "\n【" HIG " 海王殿 " NOR WHT "】" NOR HIC "狄蒂丝(Didisi)：我主索罗，已被权欲迷住了双眼......\n" NOR,
    users()
  );
}

void init() {
  if (wizardp(this_player())) return;
  add_action("do_none", "perform");
  add_action("do_none", "bian");
  add_action("do_none", "cast");
  add_action("do_none", "ji");
  add_action("do_none", "apply");
  add_action("do_none", "shoot");
}

int do_none() {
  object me = this_player();
  tell_object(me, HIG "还是问问狄蒂丝关于海王的事再说......\n" NOR);
  return 1;
}

int valid_leave(object me, string dir) {
  object where = this_object();
  if ((userp(me) && me->query("sds4/mry") != "done")
    && dir == "east")
    return notify_fail("你要往哪里去？\n");
  return ::valid_leave(me, dir);
}
