
#include <ansi.h>
#include <armor.h>
#include "/d/sds4/obj/cloth.h"

inherit ARMOR;

void create()
{
   set_name(HIM"海马座"HIY"海圣衣"NOR, ({ "haima shengyi" }) );
   set_weight(3000);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("unit", "件");
     set("material", "steel");
     set("armor_prop/armor",550);
   }
   setup();
}
