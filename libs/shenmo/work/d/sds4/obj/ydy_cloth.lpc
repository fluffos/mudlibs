#include <ansi.h>
#include <armor.h>
#include "/d/sds4/obj/cloth.h"

inherit ARMOR;

void create() {
  set_name(HIB "海皇之子" HIY "海圣衣" NOR, ({ "chrysaro shengyi" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "steel");
    set("armor_prop/armor", 550);
  }
  setup();
}
