//美人鱼海圣衣

#include <ansi.h>
#include <armor.h>
#include "cloth.h" 
inherit ARMOR;

void create()
{
   set_name(HBGRN+HIW"北大西洋"HIY"海圣衣"NOR, ({ "beidaxiyang shengyi" }) );
   set_weight(5000);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("unit", "件");
     set("material", "steel");
     set("armor_prop/armor",550);
   }
   setup();
}
