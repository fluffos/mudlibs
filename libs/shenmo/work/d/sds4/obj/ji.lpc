#include <weapon.h>
#include <ansi.h>
#include <combat.h>
inherit SPEAR;

void create()
{
set_name(BLINK+HBBLU+HIY"三叉戟"NOR,({"sancha ji","spear","ji" }));
set_weight(15000);
if( clonep() )
	set_default_object(__FILE__);
else {
	set("unit", "杆");
	set("material", "gold");
        set("wield_msg", HIY"$N单手一摆，$n"NOR+HIY"由虚变实，渐渐显出形状。\n金光一闪，$N已将"+"$n"+HIY"握在手中!\n"NOR);
	set("unwield_msg",HIY"$N手中的$n"+HIY"化作一道金光，冲上蓝天，消失在远方！\n"NOR);
	}
init_spear(200);
setup();
}

int hit_ob(object me,object target)
{
int i,k;
string msg;
object ob = this_object();
string name = ob->query("name");
if ( userp(environment()) )  return 0;
i = me->query_skill("force")+me->query("combat_exp")+me->query_skill("dodge");
k = target->query_skill("parry")+target->query("combat_exp")+me->query_skill("force");
msg = "\n"+name+BLINK+HBBLU+HIY"忽然发出一道强光，一阵巨涛骇浪仿佛从四面八方扑来！\n"NOR;
if ( random(i) > random( k/2) )
	{
	msg += HIG"\n$n一个不防，被浪花打了个正着！\n"NOR;
	target->add("sen",-100);
	target->add("kee",-100);
	target->add("force",-200);
	target->add("mana",-200);
	if ( target->query("force")<=0 )     target->set("force",0);
 	if ( target->query("mana")<=0 )    target->set("mana",0);
	}
else      msg += HIW"\n$n连忙纵身跃起！躲过了这一击！\n"NOR;
message_vision(msg,me,target);
return 1;
}
