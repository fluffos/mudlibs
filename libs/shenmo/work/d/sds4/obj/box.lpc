//box.c
#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIY "海皇の盒" NOR, ({ "sea box", "box" }));
  set_weight(1000);
  set_max_encumbrance(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", HIY "海底之宝。\n" NOR);
    set("no_get", 1);
    set("value", 1000);
  }
}

int is_container() { return 1; }

void init() {
  add_action("do_open", "open");
}

int err_msg(string arg) {
  write(arg);
  return 1;
}

int do_open(string arg) {
  int i;
  string room;
  object me = this_player();
  object ob = this_object();
  object dun = new("/d/sds4/obj/shield");
  object *inv;
  inv = all_inventory(me);
  i = 1 + random(9);

  if (!arg || !id(arg))
    return 0;
  if (me->is_busy())
    return err_msg("你现在正忙呢。\n");
  if (me->query("sds4/king") != "done")
    return notify_fail("你必须得到海皇的同意。\n");
  if (sizeof(inv) >= 25)
    return notify_fail("你身上的东西太多了,准备好了再来吧...\n");

  if (me->query("sds4/box") != "done") {
    me->set("sds4/box", "done");
    message_vision(HIY "$N小心翼翼的打开$n" HIY "。\n" NOR, me, ob);
    switch (random(4)) {
      case 0:
        message_vision(HIC "一团雾气从$n" NOR + HIC "中冲突,笼罩住$N!\n" NOR, me, ob);
        me->add("per", i);
        tell_object(me, HIC "你的容貌增加了" + i + HIC "点。\n" NOR);
        break;
      case 1:
        message_vision(HIB "一团雾气从$n" NOR + HIB "中冲突,笼罩住$N!\n" NOR, me, ob);
        me->add("per", -i);
        tell_object(me, HIB "你的容貌减少了" + i + HIB "点。\n" NOR);
        break;
      case 2:
        message_vision(HIW "一团雾气从$n" NOR + HIW "中冲突,笼罩住$N!\n" NOR, me, ob);
        me->add("kar", i);
        tell_object(me, HIW "你的福缘增加了" + i + HIW "点。\n" NOR);
        break;
      default:
        message_vision(HIR "一团雾气从$n" NOR + HIR "中冲突,笼罩住$N!\n" NOR, me, ob);
        me->add("kar", -i);
        tell_object(me, HIR "你的福缘减少了" + i + HIR "点。\n" NOR);
        break;
    }
    dun->move(me);
    message_vision(HIY "一个金光闪闪的大盾牌忽然出现在$N身上!\n" NOR, me, ob);
    message(
      "chat",
      HIY "【" NOR HIG "圣战·海王篇" NOR HIY "】雅典娜(Athena):" + me->name() + "得到了海皇の盾!\n" NOR,
      users()
    );
  } else if (!present("sea dun", me)) {
    dun->move(me);
    message_vision(HIY "一个金光闪闪的大盾牌忽然出现在$N身上!\n" NOR, me, ob);
  } else tell_object(me, HIG "你不是已经拿了吗?,仔细看看吧 :) \n" NOR);
  room = me->query("startroom");
  if (!room)
    room = "/d/sea/under1";
  message_vision("一股暗流涌来，$N随之翻滚而去。。。。\n\n", me);
  me->move(room);
  message_vision("\n\n一股暗流涌来，$N从中翻滚出来。\n", me);
  destruct(this_object());
  return 1;
}
