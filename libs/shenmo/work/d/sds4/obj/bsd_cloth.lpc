//美人鱼海圣衣

#include <ansi.h>
#include <armor.h>
#include "cloth.h"
inherit ARMOR;

void create() {
  set_name(HBGRN + HIR "波塞冬" HIY "黄金圣衣" NOR, ({ "bosaidong's shengyi" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "gold");
    set("armor_prop/armor", 800);
  }
  setup();
}
