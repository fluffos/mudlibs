//海馬 — 巴爾安
//baeran.c

#include <ansi.h>
inherit ROOM;
void resets();
void change();

void create() {
  set("short", HIW "北太平洋支柱" NOR);
  set("long", HIG + @LONG
     .	
 　 / \
 　 | |　 
 　 |.|　　
 　 |.|
 　 |:|　　　 __
  ,_|:|_,　 /　 \
 　 (Oo　　/ _I_ \
 　　+\ \　||^|^||
 　　　 \ \||_0_|| 北太平洋支柱
 　　　　 \ /.:.\-\
 　　　　　|.:. /-----\
 　　　　　|___|::oOo::|
 　　　　　/　 |:<_T_>:|
               ""....""

LONG + NOR);

  set("exits", ([
    "south": __DIR__ "road2",
  ]));
  set("objects", ([
    "/d/sds4/npc/baeran": 1,
  ]));
  setup();
}

int valid_leave(object who, string dir) {
  string name = who->query("name");

  if (who->query("sds4/yi") != "done" && dir == "eastdown")
    return notify_fail("还是战斗吧！\n");
  return ::valid_leave(who, dir);
}

void init() {
  add_action("do_none", "perform");
  add_action("do_none", "ji");
  add_action("do_none", "fight");
  add_action("do_none", "steal");
  add_action("do_none", "touxiang");
  add_action("do_none", "shoot");
  add_action("do_none", "mount");
  add_action("do_none", "recall");
  add_action("do_none", "whisper");
  add_action("do_none", "surrender");
  add_action("do_none", "cast");
  add_action("do_break", "break");
}

int do_none() {
  object me = this_player();
  message_vision(HIG "\n战斗吧，$N，为了女神......\n" NOR, me);
  return 1;
}

int do_break(string arg) {
  int i, lost;
  string msg;
  object npc;
  object env = this_object();
  object me = this_player();
  lost = 500 + random(1500);
  if (!arg || !me) return notify_fail(HIG "你想击碎什么?\n" NOR);

  if (me->query("sds4/yi") != "done")
    return notify_fail(HIG "先打败海将军吧！\n" NOR);

  if (this_object()->query("change") == 1)
    return notify_fail(HIR "没有柱子可砸了！\n" NOR);

  if (arg != "zhu" && arg != "支柱")
    return notify_fail(HIR "你要砸什么?\n" NOR);

  if (!npc = present("baeran", env)) {
    i = (int)me->query_skill("unarmed");
    i = i / 10;
    i += (int)me->query("str");
    i = i / 2 + random(i / 2);
    i = random(i);
    if (wizardp(me)) tell_object(me, HIW "i=" + chinese_number(i) + ".\n" NOR);
    msg = YEL "\n$N" YEL "使足全身的力气，奋力向石柱砸去！\n" NOR;
    if (i < 40) {
      me->receive_damage("kee", lost);
      me->receive_wound("kee", lost);
      msg += YEL "结果$N的双手砸得是鲜血淋漓，石柱依旧是屹然挺立！\n" NOR;
    } else {
      msg += YEL "只听“轰隆”一声巨响，北太平洋支柱在一阵地动山摇中崩塌碎裂！\n" NOR;
      message_vision(msg, me);
      call_out("change", 1 + random(5));
    }
    message_vision(msg, me);
    COMBAT_D->report_status(me, lost);
  } else {
    msg = YEL "\n$N" CYN "使足全身的力气，奋力向石柱砸去！\n" NOR;
    msg += YEL "只听“轰隆”一声巨响，北太平洋支柱在一阵地动山摇中崩塌碎裂！\n" NOR;
    npc->command("shit");
    msg += CYN + npc->query("name") + CYN "放声大骂：谁在乱敲？哎呦。。。\n" NOR;
    msg += CYN + npc->query("name") + CYN "被一堆瓦砾压在了下面......\n" NOR;
    message_vision(msg, me);
    destruct(npc);
    call_out("change", 1 + random(5));
  }
  return 1;
}

void change() {
  object ob = this_object();
  if (ob->query("change") == 0) {
    message_vision(YEL "一阵地动山摇，整个海底一阵颠簸，道路变成了沟渠，凹地变作了平道！\n" NOR);
    ob->set("exits", ([
      "eastdown": __DIR__ "road3",
    ]));
    message("chat", YEL "风云突变，北太平洋方向传出轰隆巨响！沿海的百姓又要遭殃了......\n" NOR, users());
    ob->set("change", 1);
    call_out("resets", 10 + random(20));
  }
  return;
}

void resets() {
  object ob = this_object();
  if (ob->query("change")) {
    message("chat", HIC "雨过天晴，北太平洋渐渐恢复了平静......\n" NOR, users());
    ob->set("exits", ([]));
    set("exits", ([
      "south": __DIR__ "road2",
    ]));
    set("objects", ([
      "/d/sds4/npc/baeran": 1,
    ]));
    delete("change");
    return;
  }
  return;
}
