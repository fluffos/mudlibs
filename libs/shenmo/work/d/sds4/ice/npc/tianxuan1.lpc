//天璇星 哈根 tianxuan.c

inherit NPC;
#include <ansi.h>
 
void create()
{
set_name("哈根", ({"hawkin","tianxuan"}));
set("long", HIC"自幼已是親衛隊的成員﹐對弗莉亞抱有一份微妙的感情。 。\n"NOR);
set("gender","男性");
set("title", HIC"天璇星"NOR+HIY"神斗士"NOR);
set("age",30);
set("con",30);
set("spi",40);
set("per",30);
set("str",35);
set("int",35);
set("combat_exp",22000000);
set("daoxing",18000000);
set("chat_chance",2);
set("chat_msg", ({
	"哈根说道：......弗莉亞......\n"   
}));
       
set_skill("dodge", 420);
set_skill("force", 420);
set_skill("parry", 420);
set_skill("unarmed", 420);
set_skill("fengxue-quan",420);
set_skill("stars-steps",420);
set_skill("moonforce",420);
set_skill("moonshentong", 420);
map_skill("parry","fengxue-quan");
map_skill("dodge","stars-steps");
map_skill("unarmed","fengxue-quan");
map_skill("spells","moonshentong");
map_skill("force","moonforce");

set("max_force", 10000);
set("force", 20000);
set("max_mana",10000);
set("mana",20000);
set("mana_factor",200);
set("force_factor",200);
set("max_kee", 15000);
set("max_gin", 15000);
set("max_sen", 15000);

setup();
carry_object("/d/sds4/ice/obj/tx_cloth")->wear();
}
