//天玑星 德尔鲁 夺命飞斧
//身躯魁悟，动作敏捷之神斗士，由於曾被希露达所救，所以对她可说是至死忠诚。

inherit NPC;
#include <ansi.h>
 
void create()
{
set_name("德尔鲁", ({"thor","tianji"}));
set("long", HIW"天玑星神斗士,身躯魁悟，动作敏捷，由於曾被希露达所救，所以对她可说是至死忠诚。\n"NOR);
set("gender","男性");
set("title", HIC"天玑星"NOR+HIY"神斗士"NOR);
set("age",37);
set("con",30);
set("spi",40);
set("per",30);
set("str",25);
set("int",35);
set("combat_exp",15000000);
set("daoxing",10000000);
set("chat_chance",2);
set("chat_msg", ({
	"德尔鲁说道：天玑星永远守卫希露达！\n"   
}));
       
set_skill("dodge", 400);
set_skill("force", 400);
set_skill("parry", 400);
set_skill("unarmed", 400);
set_skill("fengxue-quan",400);
set_skill("stars-steps",400);
set_skill("moonforce",400);
set_skill("moonshentong", 400);
map_skill("parry","fengxue-quan");
map_skill("dodge","stars-steps");
map_skill("unarmed","fengxue-quan");
map_skill("spells","moonshentong");
map_skill("force","moonforce");

set("max_force", 8000);
set("force", 16000);
set("max_mana",8000);
set("mana",16000);
set("mana_factor",200);
set("force_factor",200);
set("max_kee", 10000);
set("max_gin", 10000);
set("max_sen", 10000);

setup();
carry_object("/d/sds4/ice/obj/tj_cloth")->wear();
}

