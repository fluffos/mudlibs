inherit NPC; 
#include <ansi.h> 

string ask_ice(); 
        
void create() 
{ 
set_name(HIW"弗莱雅"NOR, ({ "freya"})); 
set("long", @LONG 

女神诺德的女儿，自己本人也是掌管爱和繁殖的女神，是神界最美，最聪颖的
女神。她喜欢鲜花，泉水和音乐，对精灵们和小仙子爱护有加。一次，她遇到
了一个神秘的神奥德Od（可能是奥丁的化身）。两人相爱并结了婚，可不久奥
德飘然离去，使她黯然不已，伤心的泪水滴下，化成了金子。她的神像是带着
矮人精灵给她的魔力项链，身披能让她变成鹰隼的鸟羽斗篷，坐骑是拉着战车
的两只猫，身边还带有一只战熊（其实是她人间的崇拜者欧塔的伪装）。她住
在美丽的永远奏着爱的音乐的民众神殿中。当然，作为神界最有影响力的女神，
她和奥丁一起在仙宫迎接战死英灵的回来，只不过奥丁在万寒宫迎接一部份男
的烈士，弗莱雅在她自己的宫中接见另一部份男战士和所有的女英雄。 英语
星期五 Friday是纪念她和孪生兄弟弗雷的。

LONG); 
set("title",HIC"民众神殿"NOR+HIY"公主"NOR);
set("gender", "女性"); 
set("age", 16); 
set("attitude", "peaceful"); 
set("per",30);//means no rong-mao description. 
set("chat_chance_combat", 90); 
set("inquiry",([ 
	 "奥丁": (: ask_ice:), 
])); 
setup(); 
carry_object("/d/12gong/obj/armor")->wear(); 
carry_object("/d/12gong/obj/cloth")->wear(); 
carry_object("/d/12gong/obj/pifeng")->wear(); 
carry_object("/d/12gong/obj/shield")->wear(); 
} 

       
string ask_ice() 
{ 
object cloth; 
object ob = this_object(); 
object me = this_player(); 
object where = environment(me);

if ( where!=environment() )
	return " ";

/*************************************************
**		观礼台的NPC			**
*************************************************/
if ( where->query("short")==HIC"观礼台"NOR )
	{
	if ( !(int)me->query("sds3/all") )    //12gong没过
		return "他创造了北欧的人类，掌管死亡，战斗，诗歌，魔法
及智慧等等，是众神之父。威严的奥丁，手持长矛--从来不会射偏
目标，配带着德劳毗尼尔饰环，胯下是八足神马，左右跟着弗莱基
和戈里两匹狼，在北方的世界巡视。奥丁只有一只眼睛，但是可以
发出如太阳般的光辉。另一只眼是在为了获得究极智慧时，为了喝
到世界之树下的智慧之井里的水而自残了。由于没有如希腊极乐净
土似的气候，使得北欧世界充满了艰辛和忍耐。在凛冽寒风中向奥
丁默默祈祷的北欧民众而毫无怨言，就象他们尊敬的神一样。
奥丁用自己的长矛将其钉在世界之树上，苦苦煎熬了九天，最终学
到了九首诗歌和十八种法术。他住在仙宫的	英灵宫中--他的宝座
就在那，那儿他可以看到九个世界的芸芸众生；他也常去万寒宫，
英勇战死的烈士们将在那光荣地接受奥丁的褒奖，等待着为最终圣
战的到来而战。";
	me->set_temp("ice/go",1);
       if ( (string)me->query("cloth_name") )
          return "北欧仙宫被邪恶的力量控制了，"+me->query("cloth_name")+"斗士,你能帮我吗？（yes）";
    else   return "北欧仙宫被邪恶的力量控制了，青铜圣斗士"+me->query("name")+",你能帮我吗？（yes）";
	}
/*************************************************
**		民众殿				**
*************************************************/
else if ( where->query("short")==HIY"民众神殿"NOR )
	{
	if ( me->query("ice/cloth")=="done" )  //已经要过,掉了的再次要
		{
		if ( present("odin cloth",me) )
                	return "傻瓜,你不是已经有了吗??!!\n";
		ob->set_temp("cloth_man",me);
                return "哦，重新召唤奥丁战袍需要消耗20年的道行和20000点武学,你可愿意?（agree）";
		}
	if ( me->query("ice/tianshu")!="done" )    //天枢没过
		return "他创造了北欧的人类，掌管死亡，战斗，诗歌，魔法
及智慧等等，是众神之父。威严的奥丁，手持长矛--从来不会射偏
目标，配带着德劳毗尼尔饰环，胯下是八足神马，左右跟着弗莱基
和戈里两匹狼，在北方的世界巡视。奥丁只有一只眼睛，但是可以
发出如太阳般的光辉。另一只眼是在为了获得究极智慧时，为了喝
到世界之树下的智慧之井里的水而自残了。由于没有如希腊极乐净
土似的气候，使得北欧世界充满了艰辛和忍耐。在凛冽寒风中向奥
丁默默祈祷的北欧民众而毫无怨言，就象他们尊敬的神一样。
奥丁用自己的长矛将其钉在世界之树上，苦苦煎熬了九天，最终学
到了九首诗歌和十八种法术。他住在仙宫的	英灵宫中--他的宝座
就在那，那儿他可以看到九个世界的芸芸众生；他也常去万寒宫，
英勇战死的烈士们将在那光荣地接受奥丁的褒奖，等待着为最终圣
战的到来而战。";
	me->set_temp("ice/give",1);
	ob->set_temp("ice/gived",me);
       if ( (string)me->query("cloth_name") )
                return "哦，"+me->query("cloth_name")+"座圣斗士,你能将七颗奥丁宝石给我吗？（yes）";
      else     return "哦，青铜圣斗士"+me->query("name")+",你能将七颗奥丁宝石给我吗？（yes）";
	}
else	return "这里是什么地方？";
}	

void init()
{
add_action("do_yes","yes");
add_action("do_agree","agree");
}

int do_yes(string arg)
{
object me=this_player();
object ob=this_object();
object where = environment();
if ( where->query("short")==HIC"观礼台"NOR )
	{
	if (!me->query_temp("ice/go")) return 0;
        command("say 此番去路上风雪重重，你自己小心了!只要集齐七块奥丁宝石,到时我自然会帮助你......\n");
        command("say 我这就和你去吧。\n");
	tell_object(me,HIY"\n弗莱雅催动风雪笼罩住你们两人。\n"NOR);	
	me->delete_temp("ice/go");
	me->move("/d/sds4/ice/road1");
	ob->move("/d/sds4/ice/road1");
        command("say 我在民众神殿等待你的好消息。\n");
	destruct(ob);
	return 1;
	}
if ( where->query("short")==HIY"民众神殿"NOR )
	{
	if (!me->query_temp("ice/give")) return 0;
	if ( me->query("ice/cloth")=="done" ) return 0;
       command("say 将七颗奥丁宝石给我,我会帮你召唤远古战衣--奥丁之袍......\n");
        command("say 将七颗奥丁宝石给我吧。\n");
	return 1;
	}
return 0;			
}

int do_agree(string arg)
{
object me=this_player();
object ob=this_object();
object cloth=new("/d/sds4/ice/obj/cloth");

if ( me->query("ice/cloth")!="done" 
  || ob->query_temp("cloth_man")!=me 
  || environment(me)!=environment(ob) 
  || present("odin cloth",me) )
	return notify_fail("你还是去集齐七颗奥丁宝石再来吧!\n");

me->add("daoxing",-20000);
me->add("combat_exp",-20000);
ob->delete_temp("cloth_man");
cloth->move(me);
command("say 好好保存哦~~ ");
return 1;
}

int accept_object(object me,object obj)
{
int i;
string name;
object ob,cloth,*inv,*m_inv;
ob = this_object();
cloth = new("/d/sds4/ice/obj/cloth");
name=cloth->query("name");
i=(int)me->query_temp("ice/baoshi_give");

if ( !me 
   || me->query("ice/tianshu")!="done"
   || environment(me)!=environment(ob) 
   || me!=ob->query_temp("ice/gived") 
   || !present(obj,me)
   || obj->query("id")!="aoding baoshi" 
   || environment()->query("short")!=HIY"民众神殿"NOR )   
	return 0;

m_inv = all_inventory(me);
if ( sizeof(m_inv)>=25 )
	{
	message_vision(CYN"弗莱雅说道：我也想给你衣服，可惜你身上好似放不下了。\n"NOR,me);
        return 0;
	}
me->add_temp("ice/baoshi_give",1);
if ( me->query_temp("ice/baoshi_give")<7 ) 
	{
       command("say 还差"+chinese_number(7-i)+"颗就够了!\n");
       return 1;
       }

inv = all_inventory(this_object());
for(i=0; i<sizeof(inv); i++) 
	{
	if (inv[i]->query("id")=="aoding baishi" ) 
                destruct(inv[i]);
	}
me->set("ice/cloth","done");
cloth->move(me);
message_vision(HIW"\n$N"HIW"念动咒语,只见七颗宝石扶摇直上，消失在天际!\n\n$N"HIW"慢慢睁开双眼,双手之上已多出一件长袍!\n"NOR,ob);
message("chat",WHT"〖"NOR HIG"北欧仙宫"NOR WHT"〗"NOR HIG"弗莱雅(Freya)"NOR HIW+me->query("name")+HIG"得到了"NOR+name+HIG"!\n"NOR,users());
command("say 小心保管吧!");
me->save();
me->delete_temp("ice/baoshi_give");
ob->delete_temp("ice");
return 1;
}
