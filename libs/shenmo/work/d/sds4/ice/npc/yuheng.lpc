//玉衡星 法利鲁  神威狼牙拳，落山群狼拳 

inherit NPC;
#include <ansi.h>
#include "star.h"
 
void create()
{
set_name("法利鲁", ({"fenrir","yuheng"}));
set("long", HIB"名行动彷如野狼的战士，能自由地躯使狼群攻击敌人，双手均有锐利的狼爪作武器。\n"NOR);
set("gender","男性");
set("title", HIC"玉衡星"NOR+HIY"神斗士"NOR);
set("age",30);
set("con",30);
set("spi",40);
set("per",30);
set("str",30);
set("int",35);
set("combat_exp",18000000);
set("daoxing",12000000);
set("chat_chance",2);
set("chat_msg", ({
	"法利鲁说道：狼是我唯一的亲人！\n"   
}));
       
set_skill("dodge", 400);
set_skill("force", 400);
set_skill("parry", 400);
set_skill("unarmed", 400);
set_skill("fengxue-quan",400);
set_skill("stars-steps",400);
set_skill("moonforce",400);
set_skill("moonshentong", 400);
map_skill("parry","fengxue-quan");
map_skill("dodge","stars-steps");
map_skill("unarmed","fengxue-quan");
map_skill("spells","moonshentong");
map_skill("force","moonforce");

set("max_force", 8000);
set("force", 16000);
set("max_mana",8000);
set("mana",16000);
set("mana_factor",100);
set("force_factor",100);
set("max_kee", 10000);
set("max_gin", 10000);
set("max_sen", 10000);

setup();
carry_object("/d/sds4/ice/obj/yh_cloth")->wear();
}

void init()
{
object ob=this_object();
object me=this_player();

message_vision(CYN"$N"CYN"刚走到此地，忽然从四周冲出一群野狼将$N"CYN"围住！\n"NOR,me);

if ( me->query("ice/yuheng")=="done" )
	{
	message_vision(CYN"法利鲁从山头跳将下来，挥手一摆，群狼散去。\n"NOR,me);
	command("say "+me->query("cloth_name")+"座圣斗士，不用担心，我实话告诉你，我的这些狼兄弟
其实不吃人，真的，你看...\n");
	message_vision(CYN"法利鲁说罢把手伸进狼群里，片刻。。。\n\n"NOR,me);
	command("shit");
	command("say 嘿。。嘿，果然不吃人，我先走开一下......\n");
	message_vision(CYN"法利鲁捂着血淋淋的手踉跄地向南离开。\n\n"NOR,me);
	destruct(ob);
	}
else  {
	message_vision(CYN"法利鲁从狼群里探出头来，恶狠狠的说：谁打搅老子我喝奶？！\n"NOR,me);
	command("kao");
	}
 }
 
void kill_ob(object me)
{
object ob=this_object();

if(! present(me,environment()) )
        {
        me->remove_killer(ob);
        ob->remove_killer(me);
        powerup();
        return;
        }
     
if( me->is_ghost() || !userp(me) )
        {
        me->remove_killer(ob);
        ob->remove_killer(me);
        powerup();
        return;
        }
     
set("chat_chance_combat", 20);
set("chat_msg_combat", ({
	(: perform_action, "unarmed", "wolf" :),
        (: perform_action, "unarmed", "wolfs" :),
}) );


::kill_ob(me);
}

void die()
{
string name;
object baoshi;
object me = this_object();
object ob = query_temp("last_damage_from");

        powerup();
        this_object()->remove_all_killer();
        all_inventory(environment())->remove_killer(this_object());
        
        if( !ob || !present(ob,environment()) )
               return;
if( ob->query("ice/tianji")=="done" && ob->query("ice/yuheng")!="done")
	{
	ob->start_busy(3);
	message("chat",HIY"【"NOR+HIW"北极仙宫"NOR+HIY"】雅典娜(Athena):"+HIW+ob->name()+HIY"闯过了玉衡星宫，继续向万寒宫前进。\n"NOR,users());
	ob->set("ice/yuheng","done");
	ob->add("ice/number",1);
	ob->add("daoxing", 150000);
	tell_object(ob,HIW"你赢得了一百五十年道行!\n"NOR);
        }
message("chat",HIB"\n\n遥远的天边传来群狼凄厉的哀号。\n"NOR,users());
destruct(this_object());
}

