//摇光星 米伊美 催命安灵曲，魔弦送葬曲 
 

inherit NPC;
#include <ansi.h>
#include "star.h"
 
void create()
{
set_name("米伊美", ({"myemy","yaoguang"}));
set("long", HIW"喜欢弹奏并使用竖琴作为武器的悲剧战士。\n
自已的养父竟就是杀父仇人，最後他虽然替父报仇杀了养父，但却从此陷入矛盾的感情之中。\n"NOR);
set("gender","男性");
set("title", BLINK+HIW"摇光星"NOR+HIY"神斗士"NOR);
set("age",20);
set("con",30);
set("spi",40);
set("per",30);
set("str",35);
set("int",35);
set("combat_exp",25000000);
set("daoxing",22000000);
set("chat_chance",2);
set("chat_msg", ({
        "米伊美说道：......父亲......\n"   
}));
       
set_skill("dodge", 420);
set_skill("force", 420);
set_skill("parry", 420);
set_skill("unarmed", 420);
set_skill("fengxue-quan",420);
set_skill("stars-steps",420);
set_skill("moonforce",420);
set_skill("moonshentong", 420);
map_skill("parry","fengxue-quan");
map_skill("dodge","stars-steps");
map_skill("unarmed","fengxue-quan");
map_skill("spells","moonshentong");
map_skill("force","moonforce");

set("max_force", 10000);
set("force", 20000);
set("max_mana",10000);
set("mana",20000);
set("mana_factor",200);
set("force_factor",200);
set("max_kee", 15000);
set("max_gin", 15000);
set("max_sen", 15000);

setup();
carry_object("/d/sds4/ice/obj/yg_cloth")->wear();
}
 
void init()
{
object ob=this_object();
object me=this_player();

message_vision(CYN"一阵悠扬的琴声传来，原来是米伊美。\n"NOR,me);
message_vision(CYN"$N"CYN"听着这美妙的琴声，不由情不自禁，走向米伊美，眼里露出麦克狼的光芒。\n"NOR,me);

if ( me->query("ice/yaoguang")=="done" )
	{
	command("shy");
	message_vision(CYN"米伊美一扭腰，向着西边跑去。\n"NOR,me);
	destruct(ob);
	}
else  {
	command("pei");
	}
 }

void kill_ob(object me)
{
object ob=this_object();

if(! present(me,environment()) )
        {
        me->remove_killer(ob);
        ob->remove_killer(me);
        powerup();
        return;
        }
     
if( me->is_ghost() || !userp(me) )
        {
        me->remove_killer(ob);
        ob->remove_killer(me);
        powerup();
        return;
        }
     
set("chat_chance_combat", 60);
set("chat_msg_combat", ({
	(: perform_action, "unarmed", "anling" :),
	(: perform_action, "unarmed", "music" :),
}) );

::kill_ob(me);
}

void die()
{
string name;
object baoshi;
object me = this_object();
object ob = query_temp("last_damage_from");

        powerup();
        this_object()->remove_all_killer();
        all_inventory(environment())->remove_killer(this_object());
        
        if( !ob || !present(ob,environment()) )
               return;
if( ob->query("ice/tianxuan")=="done" && ob->query("ice/yaoguang")!="done")
	{
	ob->start_busy(3);
	message("chat",HIY"【"NOR+HIW"北极仙宫"NOR+HIY"】雅典娜(Athena):"+HIW+ob->name()+HIY"闯过了摇光星宫，继续向万寒宫前进。\n"NOR,users());
	ob->set("ice/yaoguang","done");
	ob->add("ice/number",1);
	ob->add("daoxing", 150000);
	tell_object(ob,HIW"你赢得了一百五十年道行!\n"NOR);

        }
	if ( ob->query_temp("icd_baoshi/number")<7 )
		{
		baoshi=new("/d/sds4/ice/obj/baoshi");
		name=baoshi->query("name");
		baoshi->move(ob);
		message_vision(HIM"\n$N从米伊美的神圣衣上小心翼翼的挖下一颗"NOR+name+HIM"!\n"NOR,ob);
                if ( !present(baoshi,ob) )
			{
                        tell_object(ob,YEL"你一不小心失手掉落在地！\n"NOR);
			return;
			}
		ob->add_temp("ice_baoshi/number",1); //此数字必须<=7
		message("rumor",HIY"【"NOR+HIW"北极仙宫"NOR+HIY"】雅典娜(Athena):"+HIW+ob->name()+HIY"得到了"NOR+name+HIY"。\n"NOR,users());
		}
message("chat",HIW"\n挣不开自己的宿名啊,那悲伤的少年,死对于他也是一种解脱。\n"NOR,users());
destruct(this_object());
}

