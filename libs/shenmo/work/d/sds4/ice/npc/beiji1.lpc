//北极星 希露达  尼培尔根戒指 
//以北欧之神奥汀地上代行者身份，统治亚斯格特的少女。
//为人和蔼温柔，深得众人敬慕。但被海皇波士顿戴上黄金戒指，
//性格大变，更一心打倒圣域。
 
inherit NPC;
#include <ansi.h>
#include "star.h"
 
void create()
{
set_name(HIY"希露达"NOR, ({"sheluda","beiji"}));
set("long", HIY"北欧奥丁神的人间代言人，但被海皇波赛冬带上复仇指环，向雅典娜宣战。"NOR);
set("gender","女性");
set("title", HIY"奥丁神的人间代言人"NOR);
set("age",16);
set("con",40);
set("spi",40);
set("per",40);
set("str",40);
set("int",40);
set("combat_exp",45000000);
set("daoxing",45000000);
       
set_skill("dodge", 450);
set_skill("force", 450);
set_skill("parry", 450);
set_skill("unarmed", 450);
set_skill("fengxue-quan",450);
set_skill("stars-steps",450);
set_skill("moonforce",450);
set_skill("moonshentong", 450);
map_skill("parry","fengxue-quan");
map_skill("dodge","stars-steps");
map_skill("unarmed","fengxue-quan");
map_skill("spells","moonshentong");
map_skill("force","moonforce");

set("max_force", 15000);
set("force", 30000);
set("max_mana",15000);
set("mana",30000);
set("mana_factor",500);
set("force_factor",100);
set("max_kee", 25000);
set("max_gin", 25000);
set("max_sen", 25000);

setup();
carry_object("/d/sds4/ice/obj/ring")->wear();
carry_object("/d/sds4/ice/obj/bj_cloth")->wear();
}
 
void kill_ob(object me)
{
object ob=this_object();
powerup();

if(! present(me,environment()) )
        {
        me->remove_killer(ob);
        ob->remove_killer(me);
        return;
        }
     
if( me->is_ghost() || !userp(me) )
        {
        me->remove_killer(ob);
        ob->remove_killer(me);
        return;
        }
set("chat_chance_combat", 80);
set("chat_msg_combat", ({
	(: perform_action, "unarmed", "ring" :),
}) );
}

void die()
{
string name;
object ring;
object ob = query_temp("last_opponent");
object me = this_object();

powerup();
me->remove_killer(ob);
ob->remove_killer(me);

if( ob->query("ice/tianshu")=="done" && ob->query("ice/beiji")!="done")
	{
	message_vision(HIY"$N"HIY"见$n"HIY"不备,疾步上前,运起全身的力量,将其手上的尼培尔根戒指击得粉碎!\n",ob,me);
	if ( !ring=present("evl ring",me) )
		ring = new("/d/sds4/ice/obj/ring");
	ring->move(environment(me));
	ring->set_name(WHT"破碎的"NOR+ring->query("name"),({"breaken ring"}));
	ring->set("no_get",1);
	call_out("goaway",3+random(4),ring,ob,environment(me));
        }
command("gongxi "+ob->query("id") );
command("say 北欧大陆之门永远向你打开!\n");
return;
}

void goaway(object ring,object me,object where)
{
object star1,star2,star3,star4,star5,star6,star7,star8;
object npc = new("/d/sds4/npc/mry");
star1=new(__DIR__"tianji1");
star2=new(__DIR__"yuheng1");
star3=new(__DIR__"yaoguang1");
star4=new(__DIR__"tianquan1");
star5=new(__DIR__"kaiyang1");
star6=new(__DIR__"tianxuan1");
star7=new(__DIR__"tianshu1");
star8=new(__DIR__"freya1");

if( environment(me)!=where 
  || me->query("ice/tianshu")!="done" 
  || me->query("ice/beiji")=="done" )
	return;

star1->move(where);
star2->move(where);
star3->move(where);
star4->move(where);
star5->move(where);
star6->move(where);
star7->move(where);
star8->move(where);
npc->move(where);

call_out("mry",3,npc,where,ring);
call_out("star",5+random(5),star1,where);
call_out("star",5+random(5),star2,where);
call_out("star",5+random(5),star3,where);
call_out("star",5+random(5),star4,where);
call_out("star",5+random(5),star5,where);
call_out("star",5+random(5),star6,where);
call_out("star",5+random(5),star7,where);
call_out("star",5+random(5),star8,where);
call_out("over",10+random(5),me,npc,star1,star2,star3,star4,star5,star6,star7,star8);
}

void mry(object npc,object where,object ring)
{
tell_room(where,CYN"狄蒂丝捡起地上破碎的戒指。\n"NOR);
destruct(ring);
}

void star(object npc,object where)
{
message_vision(CYN"\n$N"CYN"走了过来。\n"NOR,npc);
switch( random(8) )
	{
	case 1 :
		npc->command("say 原来是你们在搞鬼！\n");
	break;
	case 2 :
		npc->command("say 我就知道女王不会无故变成这样。\n");
	break;
	case 3 :
		npc->command("say 果然是有人在搞鬼！\n");
	break;
	case 4 :
		npc->command("say 真是该死，居然敢惹我们仙宫。\n");
	break;
	case 5 :
		npc->command("say 绝不可放过他们。\n");
	break;
	case 6 :
		npc->command("say 这其中果然大有文章！\n");
	break;
	default :
		npc->command("say 幸好发现及时。\n");
	break;
	}
}

void thankmsg(object npc,object me) 
{
switch( random(8) )
	{
	case 1 :
		npc->command("say 多谢"+me->query("name")+"！\n");
	break;
	case 2 :
		npc->command("say 还是"+me->query("name")+"有火眼金睛。\n");
	break;
	case 3 :
		npc->command("thank "+me->query("id"));
	break;
	case 4 :
		npc->command("say 我们仙宫会记住您的。\n");
	break;
	case 5 :
		npc->command("touch "+me->query("id"));
	break;
	case 6 :
		npc->command("good "+me->query("id"));
	break;
	default :
		npc->command("pat "+me->query("id"));
	break;
	}
}

void over(object me,object npc,object npc1,object npc2,object npc3,object npc4,object npc5,object npc6,object npc7,object npc8 )
{
int wx,pot,dh;
npc->command("say 做的不错，好戏还在后面呢！\n");
message_vision(CYN"狄蒂丝转身离去。\n"NOR,me);
destruct(npc);
message_vision(CYN"\n\n希露达渐渐清醒过来，众神斗士围上前去将事情始末告之。"NOR,me);
message_vision(CYN"大家都向$N"CYN"衷心感谢。\n"NOR,me);

call_out("thankmsg",1,npc1,me);
call_out("thankmsg",1,npc2,me);
call_out("thankmsg",1,npc3,me);
call_out("thankmsg",1,npc4,me);
call_out("thankmsg",1,npc5,me);
call_out("thankmsg",1,npc6,me);
call_out("thankmsg",1,npc7,me);
call_out("thankmsg",1,npc8,me);

message_vision(CYN"一行人欢天喜地的下山去传达喜讯去了。\n\n"NOR,me);

destruct(npc1);
destruct(npc2);
destruct(npc3);
destruct(npc4);
destruct(npc5);
destruct(npc6);
destruct(npc7);
destruct(npc8);

me->set("force",0);
me->set("mana",0);
me->set("ice/beiji","done");
me->add("ice/number",1);
wx=100000+random(900000);  //<=100w
pot=500000+random(500000); //<=100w
dh=100000+random(250000);
me->add("combat_exp",wx);
me->add("daoxing",dh);
me->add("potential", pot);
message("chat",HIY"【"NOR+HIW"北极仙宫"NOR+HIY"】希露达(Sheluda):"+HIW+me->name()+HIY"助我摆脱尼培尔根戒指的诅咒。
特奖励"+wx+HIY"点武学,"+pot+HIY"点潜能和"+COMBAT_D->chinese_daoxing(dh)+HIY"道行!\n"NOR,users());
return;
}
