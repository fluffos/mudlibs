set("max_force", 10000);
set("force", 20000);
set("max_mana",10000);
set("mana",20000);
set("mana_factor",200);
set("force_factor",200);
set("max_kee", 15000);
set("max_gin", 15000);
set("max_sen", 15000);

setup();
