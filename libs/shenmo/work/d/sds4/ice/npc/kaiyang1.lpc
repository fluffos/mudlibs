set("long", HIC"神斗士中的第二强者。"NOR);
set("gender","男性");
set("title", HIC"开阳星"NOR+HIY"神斗士"NOR);
set("age",30);
set("con",30);
set("spi",40);
set("per",30);
set("str",35);
set("int",35);
set("combat_exp",30000000);
set("daoxing",30000000);
       
set_skill("dodge", 430);
set_skill("force", 430);
set_skill("parry", 430);
set_skill("unarmed", 430);
set_skill("fengxue-quan",430);
set_skill("stars-steps",430);
set_skill("moonforce",430);
set_skill("moonshentong", 430);
map_skill("parry","fengxue-quan");
map_skill("dodge","stars-steps");
map_skill("unarmed","fengxue-quan");
map_skill("spells","moonshentong");
