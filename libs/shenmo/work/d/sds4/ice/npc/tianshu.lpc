//天枢星 基弗里特  九天游龙拳，奥汀仙风拳
inherit NPC;
#include <ansi.h>
#include "star.h"

void create() {
  set_name("基弗里特", ({ "jack fafnir", "tianshu" }));
  set("long", HIY "神斗士中最强的勇者，自小接受近卫队式的教育，对希露达绝对忠心，甚至为她而牺牲。" NOR);
  set("gender", "男性");
  set("title", HIY "天枢星神斗士" NOR);
  set("age", 20);
  set("con", 30);
  set("spi", 40);
  set("per", 30);
  set("str", 35);
  set("int", 35);
  set("combat_exp", 35000000);
  set("daoxing", 35000000);

  set_skill("dodge", 450);
  set_skill("force", 450);
  set_skill("parry", 450);
  set_skill("unarmed", 450);
  set_skill("fengxue-quan", 450);
  set_skill("stars-steps", 450);
  set_skill("moonforce", 450);
  set_skill("moonshentong", 450);
  map_skill("parry", "fengxue-quan");
  map_skill("dodge", "stars-steps");
  map_skill("unarmed", "fengxue-quan");
  map_skill("spells", "moonshentong");
  map_skill("force", "moonforce");

  set("max_force", 15000);
  set("force", 30000);
  set("max_mana", 15000);
  set("mana", 30000);
  set("mana_factor", 250);
  set("force_factor", 250);
  set("max_kee", 25000);
  set("max_gin", 25000);
  set("max_sen", 25000);

  setup();
  carry_object("/d/sds4/ice/obj/ts_cloth")->wear();
}

void init() {
  object ob = this_object();
  object me = this_player();

  message_vision(CYN "基弗里特笔直的战立在风雪之中，警惕的看着四周一切。\n" NOR, me);

  if (me->query("ice/tianshu") == "done") {
    command("wow " + me->query("id"));
    message_vision(CYN "基弗里特说道：欢迎$N" CYN "再次来到奥丁的故乡，我去通报女王。\n" NOR, me);
    message_vision(CYN "基弗里特向上离去。\n" NOR, me);
    destruct(ob);
  } else {
    message_vision(CYN "基弗里特警惕的看着$N" CYN ",注视着$N" CYN "的一举一动。\n" NOR, me);
    me->command("shy");
  }
}

void kill_ob(object me) {
  object ob = this_object();

  if (!present(me, environment())) {
    me->remove_killer(ob);
    ob->remove_killer(me);
    powerup();
    return;
  }

  if (me->is_ghost() || !userp(me)) {
    me->remove_killer(ob);
    ob->remove_killer(me);
    powerup();
    return;
  }

  powerup();
  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed", "long" :),
    (: perform_action, "unarmed", "aoding" :),
  }));
}

void die() {
  string name;
  object baoshi;
  object ob = query_temp("last_damage_from");
  powerup();
  this_object()->remove_all_killer();
  all_inventory(environment())->remove_killer(this_object());

  if (!ob || !present(ob, environment()))
    return;

  if (ob && ob->query("ice/kaiyang") == "done" && ob->query("ice/tianshu") != "done") {
    ob->start_busy(3);
    message(
      "chat",
      HIY "【" NOR + HIW "北极仙宫" NOR + HIY "】雅典娜(Athena):" + HIW + ob->name() + HIY "打败了神斗士第一人基弗里特，继续向万寒宫前进。\n" NOR,
      users()
    );
    ob->set("ice/tianshu", "done");
    ob->add("ice/number", 1);
    ob->add("daoxing", 200000);
    tell_object(ob, HIW "你赢得了二百年道行!\n" NOR);
  }
  if (ob && ob->query_temp("icd_baoshi/number") < 7) {
    baoshi = new("/d/sds4/ice/obj/baoshi");
    name = baoshi->query("name");
    baoshi->move(ob);
    message_vision(HIM "\n$N从基弗里特的神圣衣上小心翼翼的挖下一颗" NOR + name + HIM "!\n" NOR, ob);
    if (!present(baoshi, ob)) {
      tell_object(ob, HIM "你一不小心将宝石失手掉落在地！\n" NOR);
      return;
    }
    ob->add_temp("ice_baoshi/number", 1);  //此数字必须<=7
    message(
      "rumor",
      HIY "【" NOR + HIW "北极仙宫" NOR + HIY "】雅典娜(Athena):" + HIW + ob->name() + HIY "得到了" NOR + name + HIY "。\n" NOR,
      users()
    );
  }
  if (ob)
    message(
      "rumor",
      HIY "\n【" NOR + HIW "北极仙宫" NOR + HIY "】基弗里特(Jack fafnir):" + HIW + ob->name() + HIY "或许你能解除尼培尔根戒指的诅咒!\n" NOR,
      users()
    );
  destruct(this_object());
}
