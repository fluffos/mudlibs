//开阳星 斯到  白金虎口拳
//影子神斗士 巴多  反白金虎口拳 

inherit NPC;
#include <ansi.h>
#include "star.h"

void create() {
  set_name("斯到", ({ "stop", "kaiyang" }));
  set("long", HIC "神斗士中的第二强者。" NOR);
  set("gender", "男性");
  set("title", HIC "开阳星" NOR + HIY "神斗士" NOR);
  set("age", 30);
  set("con", 30);
  set("spi", 40);
  set("per", 30);
  set("str", 35);
  set("int", 35);
  set("combat_exp", 30000000);
  set("daoxing", 30000000);

  set_skill("dodge", 430);
  set_skill("force", 430);
  set_skill("parry", 430);
  set_skill("unarmed", 430);
  set_skill("fengxue-quan", 430);
  set_skill("stars-steps", 430);
  set_skill("moonforce", 430);
  set_skill("moonshentong", 430);
  map_skill("parry", "fengxue-quan");
  map_skill("dodge", "stars-steps");
  map_skill("unarmed", "fengxue-quan");
  map_skill("spells", "moonshentong");
  map_skill("force", "moonforce");

  set("max_force", 10000);
  set("force", 20000);
  set("max_mana", 10000);
  set("mana", 20000);
  set("mana_factor", 200);
  set("force_factor", 200);
  set("max_kee", 15000);
  set("max_gin", 15000);
  set("max_sen", 15000);

  setup();
  carry_object("/d/sds4/ice/obj/ky_cloth")->wear();
}

void init() {
  string msg;
  object ob = this_object();
  object me = this_player();

  if (ob->query("id") == "badou")
    msg = CYN "巴多忧郁的看着$N" CYN ",叹气道：世人身在福中不知福。\n" NOR;
  else msg = CYN "斯到趾高气扬的站立在$N" CYN "面前。\n" NOR;

  message_vision(msg, me);

  if (me->query("ice/kaiyang") == "done") {
    if (ob->query("id") == "badou")
      msg = CYN "巴多边叹气，边摇头向上离去。\n" NOR;
    else {
      me->command("say 嘿嘿，你还不如你哥哥厉害。。。\n");
      msg = CYN "斯到面露惭色，尴尬的向上离去。\n" NOR;
    }
    message_vision(msg, me);
    destruct(ob);
  } else {
    if (ob->query("id") == "badou") {
      command("say 世人不知福，不如吾来超度之！\n");
      kill_ob(me);
    } else
      message_vision(CYN "斯到不屑的看着$N" CYN "。\n" NOR, me);
  }
}

void kill_ob(object me) {
  object ob = this_object();

  if (!present(me, environment())) {
    me->remove_killer(ob);
    ob->remove_killer(me);
    powerup();
    return;
  }

  if (me->is_ghost() || !userp(me)) {
    me->remove_killer(ob);
    ob->remove_killer(me);
    powerup();
    return;
  }
  powerup();
  if (ob->query("id") == "stop") {
    set("chat_chance_combat", 60);
    set("chat_msg_combat", ({
      (: perform_action, "unarmed", "hu" :),
    }));
  } else {
    set("chat_chance_combat", 80);
    set("chat_msg_combat", ({
      (: perform_action, "unarmed", "fanhu" :),
    }));
  }
}

void die() {
  string name;
  object baoshi;
  object me = this_object();
  object ob = query_temp("last_damage_from");

  powerup();
  this_object()->remove_all_killer();
  all_inventory(environment())->remove_killer(this_object());

  if (!ob || !present(ob, environment()))
    return;

  if (ob->query("ice/tianquan") == "done" && ob->query("ice/kaiyang") != "done") {
    if (me->query("id") == "stop") {
      me->set_name("巴多", ({ "badou", "kaiyang" }));
      me->set("long", HIB "阿鲁科鲁星的巴多，是斯多的孪生哥哥。\n
		巴多是作为“影子战士”存在，如果他的弟弟不死，他就不能成为真正的神斗士。\n
		他的圣衣没有奥丁蓝宝石，因为阿鲁科鲁星和米扎鲁星是双星开阳星史特的兄长，\n
		因传统规定而遭遗弃的命运，实力乃在弟弟之上。\n" NOR);
      me->set("title", HIB "影子神斗士" NOR);
      message_vision(HIB "\n\n$N刚要上前取斯多的奥丁宝石,不想$n从旁冲了出来:“先战胜我再说！”\n\n" NOR, ob, this_object());
      return;
    } else {
      ob->start_busy(3);
      message(
        "chat",
        HIY "【" NOR + HIW "北极仙宫" NOR + HIY "】雅典娜(Athena):" + HIW + ob->name() + HIY "杀死了开阳星的斯多兄弟，继续向万寒宫前进。\n" NOR,
        users()
      );
      ob->set("ice/kaiyang", "done");
      ob->add("ice/number", 1);
      ob->add("daoxing", 150000);
      tell_object(ob, HIW "你赢得了一百五十年道行!\n" NOR);
    }
  }
  if (ob->query_temp("icd_baoshi/number") < 7) {
    baoshi = new("/d/sds4/ice/obj/baoshi");
    name = baoshi->query("name");
    baoshi->move(ob);
    message_vision(HIM "\n$N从斯多的神圣衣上小心翼翼的挖下一颗" NOR + name + HIM "!\n" NOR, ob);
    if (!present(baoshi, ob)) {
      tell_object(ob, HIM "你一不小心失手掉落在地！\n" NOR);
      return;
    }
    ob->add_temp("ice_baoshi/number", 1);  //此数字必须<=7
    message(
      "rumor",
      HIY "【" NOR + HIW "北极仙宫" NOR + HIY "】雅典娜(Athena):" + HIW + ob->name() + HIY "得到了" NOR + name + HIY "。\n" NOR,
      users()
    );
  }
  message("chat", HIC "\n开阳星兄弟被" + ob->name() + "打败了......\n" NOR, users());
  destruct(this_object());
}
