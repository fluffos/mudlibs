//天玑星 德尔鲁 夺命飞斧
//身躯魁悟，动作敏捷之神斗士，由於曾被希露达所救，所以对她可说是至死忠诚。

inherit NPC;
#include <ansi.h>
#include "star.h"
 
void create()
{
set_name("德尔鲁", ({"thor","tianji"}));
set("long", HIW"天玑星神斗士,身躯魁悟，动作敏捷，由於曾被希露达所救，所以对她可说是至死忠诚。\n"NOR);
set("gender","男性");
set("title", HIC"天玑星"NOR+HIY"神斗士"NOR);
set("age",37);
set("con",30);
set("spi",40);
set("per",30);
set("str",25);
set("int",35);
set("combat_exp",15000000);
set("daoxing",10000000);
set("chat_chance",2);
set("chat_msg", ({
	"德尔鲁说道：天玑星永远守卫希露达！\n"   
}));
       
set_skill("dodge", 400);
set_skill("force", 400);
set_skill("parry", 400);
set_skill("unarmed", 400);
set_skill("fengxue-quan",400);
set_skill("stars-steps",400);
set_skill("moonforce",400);
set_skill("moonshentong", 400);
map_skill("parry","fengxue-quan");
map_skill("dodge","stars-steps");
map_skill("unarmed","fengxue-quan");
map_skill("spells","moonshentong");
map_skill("force","moonforce");

set("max_force", 8000);
set("force", 16000);
set("max_mana",8000);
set("mana",16000);
set("mana_factor",200);
set("force_factor",200);
set("max_kee", 10000);
set("max_gin", 10000);
set("max_sen", 10000);

setup();
carry_object("/d/sds4/ice/obj/tj_cloth")->wear();
}

void init()
{
object ob=this_object();
object me=this_player();

message_vision(CYN"德尔鲁从冰屋里冲了出来！\n"NOR,me);

if ( me->query("ice/tianji")=="done" )
	{
	message_vision(CYN"德尔鲁一把抱住$N"CYN"，激动的热泪盈眶。\n"NOR,me);
	command("say 同志，总算盼到你了，你慢慢走，我去告诉女王。\n");
	message_vision(CYN"德尔鲁向北离开。\n"NOR,me);
	destruct(ob);
	}
else  {
	message_vision(CYN"德尔鲁一把拉住$N"CYN"恶狠狠的说：哪儿走？！是不是你偷了我的底裤？！\n"NOR,me);
	command("hate");
	}
 }

void kill_ob(object me)
{
object ob=this_object();

if(! present(me,environment()) )
        {
        me->remove_killer(ob);
        ob->remove_killer(me);
        powerup();
        return;
        }
     
if( me->is_ghost() || !userp(me) )
        {
        me->remove_killer(ob);
        ob->remove_killer(me);
        powerup();
        return;
        }
     
set("chat_chance_combat", 60);
set("chat_msg_combat", ({
	(: perform_action, "unarmed", "heroaxe" :),
       (: powerup() :),
}) );
::kill_ob(me);
}

void die()
{
string name;
object baoshi;
object me = this_object();
object ob = query_temp("last_damage_from");

        powerup();
        this_object()->remove_all_killer();
        all_inventory(environment())->remove_killer(this_object());
        
        if( !ob || !present(ob,environment()) )
               return;

if( (int)ob->query("sds3/all") && ob->query("ice/tianji")!="done")
	{
	ob->start_busy(3);
	message("chat",HIY"【"NOR+HIW"北极仙宫"NOR+HIY"】雅典娜(Athena):"+HIW+ob->name()+HIY"闯过了天玑星宫，继续向万寒宫前进。\n"NOR,users());
	ob->set("ice/tianji","done");
	ob->add("ice/number",1);
	ob->add("daoxing", 150000);
	tell_object(ob,HIW"你赢得了一百五十年道行!\n"NOR);
       }
if ( ob->query_temp("icd_baoshi/number")<7 )
	{
	baoshi=new("/d/sds4/ice/obj/baoshi");
	name=baoshi->query("name");
       baoshi->move(ob);
        if ( !present(baoshi,ob) )
		{
                tell_object(ob,HIM"你小心的从德尔鲁圣衣上挖下一颗"+name+HIM"，可惜一不小心失手掉落在地！\n"NOR);
		return;
		}
       message_vision(HIM"\n$N从德尔鲁圣衣上小心翼翼的挖下一颗"NOR+name+HIM"!\n"NOR,ob);
       ob->add_temp("ice_baoshi/number",1); //此数字必须<=7
	message("rumor",HIY"【"NOR+HIW"北极仙宫"NOR+HIY"】雅典娜(Athena):"+HIW+ob->name()+HIY"得到了"NOR+name+HIY"。\n"NOR,users());
	}
message("chat",HIW"\n\n天上发出一阵耀眼的光芒,北极星旁边的天玑星随着最后的光辉黯淡了.\n"NOR,users());
destruct(this_object());
}

