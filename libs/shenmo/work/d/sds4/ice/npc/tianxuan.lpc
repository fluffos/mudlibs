//天璇星 哈根 tianxuan.c

inherit NPC;
#include <ansi.h>
#include "star.h"
 
void create()
{
set_name("哈根", ({"hawkin","tianxuan"}));
set("long", HIC"自幼已是親衛隊的成員﹐對弗莉亞抱有一份微妙的感情。 。\n"NOR);
set("gender","男性");
set("title", HIC"天璇星"NOR+HIY"神斗士"NOR);
set("age",30);
set("con",30);
set("spi",40);
set("per",30);
set("str",35);
set("int",35);
set("combat_exp",22000000);
set("daoxing",18000000);
set("chat_chance",2);
set("chat_msg", ({
	"哈根说道：......弗莉亞......\n"   
}));
       
set_skill("dodge", 420);
set_skill("force", 420);
set_skill("parry", 420);
set_skill("unarmed", 420);
set_skill("fengxue-quan",420);
set_skill("stars-steps",420);
set_skill("moonforce",420);
set_skill("moonshentong", 420);
map_skill("parry","fengxue-quan");
map_skill("dodge","stars-steps");
map_skill("unarmed","fengxue-quan");
map_skill("spells","moonshentong");
map_skill("force","moonforce");

set("max_force", 10000);
set("force", 20000);
set("max_mana",10000);
set("mana",20000);
set("mana_factor",200);
set("force_factor",200);
set("max_kee", 15000);
set("max_gin", 15000);
set("max_sen", 15000);

setup();
carry_object("/d/sds4/ice/obj/tx_cloth")->wear();
}
 
void init()
{
object ob=this_object();
object me=this_player();

message_vision(CYN"哈根走了过来。\n"NOR,me);

if ( me->query("ice/tianxuan")=="done" && userp(me) )
	{
	message_vision(CYN"哈根对$N"CYN"点了点头。\n"NOR,me);
	message_vision(CYN"哈根向西离开。\n"NOR,me);
	destruct(ob);
	}
else  {
	message_vision(CYN"哈根拉住$N"CYN",说道：奥丁圣地，外人是不能随便乱逛的，请回吧。\n"NOR,me);
        command("love");
	}
 }

void kill_ob(object me)
{
object ob=this_object();

if(! present(me,environment()) )
        {
        me->remove_killer(ob);
        ob->remove_killer(me);
        powerup();
        return;
        }
     
if( me->is_ghost() || !userp(me) )
        {
        me->remove_killer(ob);
        ob->remove_killer(me);
        powerup();
        return;
        }
     
set("chat_chance_combat", 80);
set("chat_msg_combat", ({
	(: perform_action, "unarmed", "double" :),
}) );

::kill_ob(me);
}

void die()
{
string name;
object baoshi;

object me = this_object();
object ob = query_temp("last_damage_from");

        powerup();
        this_object()->remove_all_killer();
        all_inventory(environment())->remove_killer(this_object());
        
        if( !ob || !present(ob,environment()) )
               return;

if( ob->query("ice/yuheng")=="done" && ob->query("ice/tianxuan")!="done")
	{
	ob->start_busy(3);
	message("chat",HIY"【"NOR+HIW"北极仙宫"NOR+HIY"】雅典娜(Athena):"+HIW+ob->name()+HIY"闯过了天璇星宫，继续向万寒宫前进。\n"NOR,users());
	ob->set("ice/tianxuan","done");
	ob->add("ice/number",1);
	ob->add("daoxing", 150000);
	tell_object(ob,HIW"你赢得了一百五十年道行!\n"NOR);
        }
	if ( ob->query_temp("icd_baoshi/number")<7 )
		{
		baoshi=new("/d/sds4/ice/obj/baoshi");
		name=baoshi->query("name");
		baoshi->move(ob);
                if ( !present(baoshi,ob) )
			{
                        tell_object(ob,HIM"你小心的从哈根圣衣上挖下一颗"+name+HIM"，可惜一不小心失手掉落在地！\n"NOR);
			return;
			}
		message_vision(HIM"\n$N从哈根圣衣上小心翼翼的挖下一颗"NOR+name+HIM"!\n"NOR,ob);
		ob->add_temp("ice_baoshi/number",1); //此数字必须<=7
		message("rumor",HIY"【"NOR+HIW"北极仙宫"NOR+HIY"】雅典娜(Athena):"+HIW+ob->name()+HIY"得到了"NOR+name+HIY"。\n"NOR,users());
		}
message("chat",HIC"\n星宿移，北斗转，天璇落。\n"NOR,users());
destruct(this_object());
}

