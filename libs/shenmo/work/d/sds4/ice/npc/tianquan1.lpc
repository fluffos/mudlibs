//天权星 阿鲁贝利西 紫晶冥晶拳，天人合一拳

inherit NPC;
#include <ansi.h>
 
void create()
{
set_name("阿鲁贝利西", ({"alublinx","tianquan"}));
set("long", HIR"最有头脑的神斗士，可惜为人卑鄙，为求成功不择手段。\n
手持巴路莫古之剑，能把敌人封进紫水晶当中。野心背叛希露达自我称王。"NOR);
set("gender","男性");
set("title", HIR"天权星"NOR+HIY"神斗士"NOR);
set("age",20);
set("con",30);
set("spi",40);
set("per",30);
set("str",35);
set("int",35);
set("combat_exp",28000000);
set("daoxing",25000000);
       
set_skill("dodge", 420);
set_skill("force", 420);
set_skill("parry", 420);
set_skill("unarmed", 420);
set_skill("fengxue-quan",420);
set_skill("stars-steps",420);
set_skill("moonforce",420);
set_skill("moonshentong", 420);
map_skill("parry","fengxue-quan");
map_skill("dodge","stars-steps");
map_skill("unarmed","fengxue-quan");
map_skill("spells","moonshentong");
map_skill("force","moonforce");

set("max_force", 10000);
set("force", 20000);
set("max_mana",10000);
set("mana",20000);
set("mana_factor",200);
set("force_factor",200);
set("max_kee", 15000);
set("max_gin", 15000);
set("max_sen", 15000);

setup();
carry_object("/d/sds4/ice/obj/tq_cloth")->wear();
}

