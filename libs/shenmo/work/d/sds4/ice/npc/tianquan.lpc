//天权星 阿鲁贝利西 紫晶冥晶拳，天人合一拳

inherit NPC;
#include <ansi.h>
#include "star.h"
 
void create()
{
set_name("阿鲁贝利西", ({"alublinx","tianquan"}));
set("long", HIR"最有头脑的神斗士，可惜为人卑鄙，为求成功不择手段。\n
手持巴路莫古之剑，能把敌人封进紫水晶当中。野心背叛希露达自我称王。"NOR);
set("gender","男性");
set("title", HIR"天权星"NOR+HIY"神斗士"NOR);
set("age",20);
set("con",30);
set("spi",40);
set("per",30);
set("str",35);
set("int",35);
set("combat_exp",28000000);
set("daoxing",25000000);
set("chat_chance",2);
set("chat_msg", ({
	"阿鲁贝利西说道：王者应该有能者居之!\n"   
}));
       
set_skill("dodge", 420);
set_skill("force", 420);
set_skill("parry", 420);
set_skill("unarmed", 420);
set_skill("fengxue-quan",420);
set_skill("stars-steps",420);
set_skill("moonforce",420);
set_skill("moonshentong", 420);
map_skill("parry","fengxue-quan");
map_skill("dodge","stars-steps");
map_skill("unarmed","fengxue-quan");
map_skill("spells","moonshentong");
map_skill("force","moonforce");

set("max_force", 10000);
set("force", 20000);
set("max_mana",10000);
set("mana",20000);
set("mana_factor",200);
set("force_factor",200);
set("max_kee", 15000);
set("max_gin", 15000);
set("max_sen", 15000);

setup();
carry_object("/d/sds4/ice/obj/tq_cloth")->wear();
}

void init()
{
object ob=this_object();
object me=this_player();

message_vision(CYN"一道寒光一闪，阿鲁贝利西一摆手中"NOR RED"巴路莫古之剑"NOR CYN"恶狠狠说：谁敢闯我天权宫！\n"NOR,me);

if ( me->query("ice/tianquan")=="done" )
	{
	message_vision(CYN"$N"CYN"恶狠狠的说：妈的，手下败将也敢放肆！！\n"NOR,me);
	command("say 靠，你别走，老子上次忘记买药，你等着，老子去拿法宝。\n");
	message_vision(CYN"阿鲁贝利西急急忙忙的向上离开。\n"NOR,me);
	destruct(ob);
	}
else  	command("hate");
}
 
void kill_ob(object me)
{
object ob=this_object();

if(! present(me,environment()) )
        {
        me->remove_killer(ob);
        ob->remove_killer(me);
        powerup();
        return;
        }
     
if( me->is_ghost() || !userp(me) )
        {
        me->remove_killer(ob);
        ob->remove_killer(me);
        powerup();
        return;
        }

set("chat_chance_combat", 60);
set("chat_msg_combat", ({
	(: perform_action, "unarmed", "zi" :),
}) );
::kill_ob(me);
}

void die()
{
string name;
object baoshi;
object ob = query_temp("last_damage_from");
        powerup();
        this_object()->remove_all_killer();
        all_inventory(environment())->remove_killer(this_object());
        
        if( !ob || !present(ob,environment()) )
               return;

if( ob->query("ice/yaoguang")=="done" && ob->query("ice/tianquan")!="done")
	{
	ob->start_busy(3);
	message("chat",HIY"【"NOR+HIW"北极仙宫"NOR+HIY"】雅典娜(Athena):"+HIW+ob->name()+HIY"杀死了诡计多端的阿鲁贝利西，继续向万寒宫前进。\n"NOR,users());
	ob->set("ice/tianquan","done");
	ob->add("ice/number",1);
	ob->add("daoxing", 150000);
	tell_object(ob,HIW"你赢得了一百五十年道行!\n"NOR);
	}
if ( ob->query_temp("icd_baoshi/number")<7 )
	{
	baoshi=new("/d/sds4/ice/obj/baoshi");
	name=baoshi->query("name");
	baoshi->move(ob);
	message_vision(HIM"\n$N从阿鲁贝利西的神圣衣上小心翼翼的挖下一颗"NOR+name+HIM"!\n"NOR,ob);
        if ( !present(baoshi,ob) )
		{
                tell_object(ob,HIM"你一不小心失手掉落在地！\n"NOR);
		return;
		}
	ob->add_temp("ice_baoshi/number",1); //此数字必须<=7
	message("rumor",HIY"【"NOR+HIW"北极仙宫"NOR+HIY"】雅典娜(Athena):"+HIW+ob->name()+HIY"得到了"NOR+name+HIY"。\n"NOR,users());
	}
        
message("chat",HBMAG+HIC"\n200年前阿卢贝里西13世败于童虎之手,想不到今天却输在"+ob->name()+"的手上......\n"NOR,users());
destruct(this_object());
}

