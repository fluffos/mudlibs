//玉衡星 法利鲁  神威狼牙拳，落山群狼拳 

inherit NPC;
#include <ansi.h>
 
void create()
{
set_name("法利鲁", ({"fenrir","yuheng"}));
set("long", HIB"名行动彷如野狼的战士，能自由地躯使狼群攻击敌人，双手均有锐利的狼爪作武器。\n"NOR);
set("gender","男性");
set("title", HIC"玉衡星"NOR+HIY"神斗士"NOR);
set("age",30);
set("con",30);
set("spi",40);
set("per",30);
set("str",30);
set("int",35);
set("combat_exp",18000000);
set("daoxing",12000000);
       
set_skill("dodge", 400);
set_skill("force", 400);
set_skill("parry", 400);
set_skill("unarmed", 400);
set_skill("fengxue-quan",400);
set_skill("stars-steps",400);
set_skill("moonforce",400);
set_skill("moonshentong", 400);
map_skill("parry","fengxue-quan");
map_skill("dodge","stars-steps");
map_skill("unarmed","fengxue-quan");
map_skill("spells","moonshentong");
map_skill("force","moonforce");

set("max_force", 8000);
set("force", 16000);
set("max_mana",8000);
set("mana",16000);
set("mana_factor",100);
set("force_factor",100);
set("max_kee", 10000);
set("max_gin", 10000);
set("max_sen", 10000);

setup();
carry_object("/d/sds4/ice/obj/yh_cloth")->wear();
}

