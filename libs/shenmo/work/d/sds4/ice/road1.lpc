// 北欧入口 road1.c
#include <ansi.h>
#include "/d/sds4/ice/road.h"
inherit ROOM;
void create ()
{
set ("short", HIW"雪路"NOR);
set ("long", @LONG

这是走向万寒宫的路上,这里是雪的世界,四周是望不见边的皑皑白雪.
风雪在耳边咆哮!人在自然面前显得无比的渺小.

LONG);


set("exits", ([
	"eastup" :  __DIR__"road2",
]));
set("outdoors",1);
setup();
}
  int valid_leave(object me, string dir) 
{ 
int i; 
 object here,*inv; 
   here = this_object(); 
 inv = all_inventory(me); 
 if ( !userp(me) )  
  return notify_fail("小猫小狗的别想进圣域！\n");     
 for(i=0; i<sizeof(inv); i++)  
 { 
  if ( userp(inv[i]) )  
   return notify_fail("还是先把身上的玩家放下来再去吧！\n");    
  if ( inv[i]->query("id")=="yueguang baohe") 
    return notify_fail("还是先把身上的宝盒放下来再去吧！\n");   
 if ( inv[i]->query("id")=="longzhua" ) 
    return notify_fail("还是先把身上的修罗爪放下来再去吧！\n");   
 } 

 return 1; 
 } 
