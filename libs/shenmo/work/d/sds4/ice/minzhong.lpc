#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIY "民众神殿" NOR);
  set("long", @LONG

女神诺德的女儿，自己本人也是掌管爱和繁殖的女神，是神界最美，最聪颖的
女神。她喜欢鲜花，泉水和音乐，对精灵们和小仙子爱护有加。一次，她遇到
了一个神秘的神奥德Od（可能是奥丁的化身）。两人相爱并结了婚，可不久奥
德飘然离去，使她黯然不已，伤心的泪水滴下，化成了金子。她的神像是带着
矮人精灵给她的魔力项链，身披能让她变成鹰隼的鸟羽斗篷，坐骑是拉着战车
的两只猫，身边还带有一只战熊（其实是她人间的崇拜者欧塔的伪装）。她住
在美丽的永远奏着爱的音乐的民众神殿中。当然，作为神界最有影响力的女神，
她和奥丁一起在仙宫迎接战死英灵的回来，只不过奥丁在万寒宫迎接一部份男
的烈士，弗莱雅在她自己的宫中接见另一部份男战士和所有的女英雄。 英语
星期五 Friday是纪念她和孪生兄弟弗雷的。
LONG);


  set("exits", ([
    "down": __DIR__ "tianshu",
    "up": __DIR__ "beiji",
  ]));
  set("outdoors", 1);
  set("no_magic", 1);
  set("no_fight", 1);
  set("objects", ([
    "/d/sds4/ice/npc/freya": 1,
  ]));
  setup();
  message(
    "channel:chat",
    WHT "\n【" HIG " 北欧宫 " NOR WHT "】" NOR HIC "弗莱雅(Freya)：伟大的奥丁神啊，快来拯救您的子民啊......\n" NOR,
    users()
  );
}

void init() {
  add_action("do_none", "perform");
  add_action("do_none", "surrender");
  add_action("do_none", "touxiang");
  add_action("do_none", "get");
  add_action("do_none", "put");
  add_action("do_none", "tou");
  add_action("do_none", "ji");
  add_action("do_none", "recall");
  add_action("do_none", "shoot");
  add_action("do_none", "mount");
  add_action("do_none", "whisper");
  add_action("do_none", "kill");
  add_action("do_none", "fight");
}

int do_none() {
  object me = this_player();
  message_vision("......\n", me);
  return 1;
}
