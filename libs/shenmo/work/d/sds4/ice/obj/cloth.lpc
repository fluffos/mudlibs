// cloth.c 
#include <armor.h>
#include <ansi.h>
#include <combat.h>

inherit CLOTH;
inherit F_UNIQUE;
void jia_condition(object);
void check_owner();
void destroy(object ob);
object offensive_target(object me);
int do_watch(string arg);

void create() {
  set_name(HIW "奥丁战袍" NOR, ({ "odin cloth", "pao", "cloth" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", HIW "太古时代传说中的奥丁战袍,据说与所罗门剑并称奥丁双宝。”\n");
    set("material", "steel");
    set("armor_prop/armor", 50 + random(10));
    set("no_get", 1);
    set("no_put", 1);
    set("no_drop", 1);
    set("no_give", 1);
    set("no_zm", 1);
    set("wear_msg", HIW "$n" HIW "呼的出现在$N" HIW "的身上。\n" NOR);
    set("unequip_msg", HIW "$n" HIW "呼的从$N" HIW "身上消失了。\n" NOR);
  }
  setup();
}

int init() {
  add_action("do_watch", "watch");
  check_owner();
}

void check_owner() {
  object me = environment();
  if (me && me->query("ice/cloth") != "done" && !wizardp(me))
    destroy(this_object());
}

void destroy(object ob) {
  write(ob->query("name") + "呼的消失在风雪中了！ \n");
  destruct(ob);
  return;
}

int query_autoload() {
  object me = environment();
  if (me && me->query("ice/cloth") != "done" && !wizardp(me))
    return 0;
  return 1;
}

int wear() {
  object me = environment();
  if (::wear()) {
    remove_call_out("jia_condition");
    call_out("jia_condition", 1, me);
    return 1;
  }
  return 0;
}

void jia_condition(object me) {
  object target;
  string msg;
  string name = query("name");
  int ap, dp, i, damage;

  if (me && living(me) && present(this_object(), me) && query("equipped")) {
    damage = (int)me->query_skill("spells", 1);
    i = damage / 100;
    if (i < 5) i = 5;
    if (i > 10) i = 10;
    i = 11 - i;
    remove_call_out("jia_condition");
    call_out("jia_condition", 1 + random(i), me);
    target = offensive_target(me);
    if (target && me->is_fighting(target)) {
      ap = me->query_skill("spells");
      dp = target->query_skill("spells");
      if (random(ap + dp) > dp / 2) {
        msg = HIW "\n" + name + HIW "上忽然冲出一道光影,如同一把巨剑般刺向$n" HIW "！\n" NOR;
        target->receive_wound("kee", damage / 2 + random(damage / 2), me);
        target->receive_damage("kee", damage / 2 + random(damage * 3 / 2), me);
        msg += HIW "$n躲闪不急,被剑气刺了个正着!\n" NOR;
        msg += HIR + COMBAT_D->damage_msg(damage, "内伤") + NOR;
        if (!me->query("env/no_msg") && !target->query("env/no_msg"))
          message_vision(msg, me, target);
        else message_vision("$N对$n使用了" + name() + "。\n", me, target);
        COMBAT_D->report_status(target, damage);
      }
    }
  }
}

object offensive_target(object me) {
  int sz;
  object *enemy;
  enemy = me->query_enemy();
  if (!enemy || !arrayp(enemy)) return 0;
  sz = sizeof(enemy);
  if (sz > 4) sz = 4;
  if (sz > 0) return enemy[random(sz)];
  else return 0;
}
int do_watch(string arg) {
  string msg, name, id, fam, sex;
  int kee, eff_kee, max_kee, sen, eff_sen, max_sen, mana, max_mana, force, max_force, wx, dx;
  object who;
  object jia = this_object();
  object me = environment();

  if (!arg)
    return notify_fail("你要观察谁?\n");
  if (!jia->query("equipped"))
    return notify_fail("你没有装备奥丁袍。\n");
  if (time() < me->query_temp("watched"))
    return notify_fail("你得等奥丁袍的法力恢复了再说。\n");
  if (me->query("mana") < 500)
    return notify_fail("你的法力不够。\n");
  who = present(arg, environment(me));
  if (!who)
    return notify_fail("找不到这个人。\n");
  if (who->query("combat_exp") / 10 > me->query("combat_exp"))
    return notify_fail("想死吗？对方比你厉害太多了，还是放弃吧。\n");

  message_vision(WHT "\n奥丁神袍上升起一道强光，笼罩住$N和" WHT + who->name() + "。\n" NOR, me);
  tell_object(who, WHT + me->name() + WHT "正使用奥丁袍的神力偷偷观察你的状态。\n" NOR);
  me->add("mana", 150);
  name = who->query("name");
  if (!name)
    name = "不详";
  id = who->query("id");
  if (!id)
    id = "不详";

  kee = who->query("kee");
  eff_kee = who->query("eff_kee");
  max_kee = who->query("max_kee");

  sen = who->query("sen");
  eff_sen = who->query("eff_sen");
  max_sen = who->query("max_sen");

  force = who->query("force");
  max_force = who->query("max_force");
  mana = who->query("mana");
  max_mana = who->query("max_mana");
  wx = who->query("combat_exp");
  dx = who->query("daoxing");

  msg = WHT "\n
------------------------------------------------------------------\n" NOR;
  switch (random(10)) {
    case 3: msg += HIC "
        气血：\t" NOR HIM + kee + "/" + eff_kee + "(" + eff_kee * 100 / max_kee + "%)    \n" NOR;
    break;
    case 4: msg += HIC "
        精神：\t" NOR HIM + sen + "/" + eff_sen + "(" + eff_sen * 100 / max_sen + "%)    \n" NOR;
    break;
    case 5: msg += HIC "
        内力：\t" NOR HIM + force + "(" + max_force + ") \n" NOR;
    break;
    case 6: msg += HIC "
        法力：\t" NOR HIM + mana + "(" + max_mana + ")   \n" NOR;
    break;
    case 7: msg += HIC "
        武学：\t" NOR HIM + wx + "   \n" NOR;
    break;
    default: msg += HIC "
       道行：\t" NOR HIM + COMBAT_D->chinese_daoxing(dx) + "  \n" NOR;
    break;
  }
  msg += WHT "\n
------------------------------------------------------------------\n" NOR;
  tell_object(me, WHT "奥丁神袍的神力告诉你：" NOR + HIW + name + HIW "(" + id + ") 的状态如下：" NOR + msg);
  me->set_temp("watched", time() + 5 + random(5));
  return 1;
}
