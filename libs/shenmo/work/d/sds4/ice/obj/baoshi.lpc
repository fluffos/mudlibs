// baoshi.c
//奥丁宝石

#include <ansi.h>
inherit ITEM;
string *clo=({
		HIR"宝石"NOR,
		HIY"宝石"NOR,		
		HIW"宝石"NOR,		
		HIG"宝石"NOR,		
		HIC"宝石"NOR,		
		HBRED"宝石"NOR,		
		HBBLU"宝石"NOR,		
		HBMAG"宝石"NOR,		
		HBWHT"宝石"NOR,		
});
		
void create()
{
   set_name(HIM"奥丁"NOR+clo[random(sizeof(clo))], ({ "aoding baoshi" }) );
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set_weight(1000);
     set("unit", "颗");
     set("material", "stone");
    }
   setup();
}
