// cloth.c 
#include <armor.h>
#include <ansi.h>
#include <combat.h>

inherit CLOTH;
inherit F_UNIQUE;
void jia_condition(object me,object ob);
void check_owner();
void destroy(object ob);
object offensive_target(object me);
void eff_msg(object me,object cloth);
int do_watch(string arg);

void create()
{
set_name(HIW"奥丁战袍"NOR,({"odin cloth","pao","cloth"}));
set_weight(2000);
if( clonep() )
	set_default_object(__FILE__);
else {
       set("unit", "件");
	set("long", HIW"太古时代传说中的奥丁战袍,据说与所罗门剑并称奥丁双宝。”\n");
	set("material", "steel");
        set("armor_prop/armor", 50+random(10));
	set("no_get", 1);
	set("no_put", 1);
	set("no_drop", 1);
        set("no_give", 1);
	set("no_zm", 1);
	}
setup();
}

int init()
{
object ob = this_object();
object me = environment(ob);
check_owner();
if ( me && living(me) )
	{
	add_action("do_wear","wear");
	add_action("do_remove", "remove");
	add_action("do_watch","watch");
	}
}

void check_owner()
{
object ob =this_object();
object me =environment(ob);
if ( me->query("ice/cloth")!="done" && !wizardp(me))
	destroy(ob);
}

void destroy(object ob)
{
write(ob->query("name")+"呼的消失在风雪中了！ \n");
destruct(ob);
return;
}

int query_autoload()
{
object ob =this_object();
object me =environment(ob);
if ( me->query("ice/cloth")!="done" && !wizardp(me))
	return 0;
else 
	return 1;
}

int do_wear (string arg)
{
object jia = this_object();
object me = environment(jia);
string name = jia->query("name");
string id = jia->query("id");
string msg;

if (arg != "all" && arg != id  )
    return notify_fail("你要穿什么？\n");

msg = HIW"$n"HIW"呼的出现在$N"HIW"的身上。\n"NOR;
jia->set("wear_msg",msg);
remove_call_out("jia_condition");
call_out("jia_condition",1,me,jia);
return 0;
}

int do_remove (string arg)
{
object jia = this_object();
object me = environment(jia);
string name = jia->query("name");
string id = jia->query("id");
string msg;

if (arg != "all" && arg != id  )
    return notify_fail("你要脱什么？\n");

msg = HIW"$n"HIW"呼的从$N"HIW"身上消失了。\n"NOR;
jia->set("unequip_msg",msg);
remove_call_out("jia_condition");
return 0;
}

void jia_condition(object me,object ob)
{
object target;
string msg;
string name=ob->query("name");
int i,damage; 
string id =ob->query("id");
target = offensive_target(me);
damage=(int)me->query_skill("spells",1);
i = damage/100;
if (i<5) i=5;
if (i>10) i=10;
i=11-i;

if ( !target || environment(me)!=environment(target) )
	return;

msg=HIW"\n"+name+HIW"上忽然冲出一道光影,如同一把巨剑般刺向$n！\n"NOR;
if ( random((int)me->query("combat_exp"))> random(target->query("combat_exp")/3) )
	{
        target->receive_damage("kee",damage/2+random(damage*3/2));
        target->receive_wound("kee", damage/2+random(damage/2));
        msg += HIW"\n$n躲闪不急,被剑气刺了个正着!\n"NOR;
        msg+=HIR"\n"+COMBAT_D->damage_msg(damage, "内伤")+NOR;
	}
else msg +=HIW"\n$n"HIW"闪身躲开!\n"NOR;
if ( !me->query("env/no_msg") && !target->query("env/no_msg")  )
           message_vision(msg,me,target);
else   message_vision("$N对$n使用了"+name()+"。\n",me,target);
COMBAT_D->report_status(target,damage);

remove_call_out("jia_condition");
call_out("jia_condition",1+random(i),me,ob);
}

object offensive_target(object me)
{
int sz;
object *enemy;
enemy = me->query_enemy();
if( !enemy || !arrayp(enemy) ) return 0;
sz = sizeof(enemy);
if( sz > 4 ) sz = 4;
if( sz > 0 ) return enemy[random(sz)];
else return 0;
}

int do_watch(string arg)
{
string msg,name,id,fam,sex;
int kee,eff_kee,max_kee,sen,eff_sen,max_sen,mana,max_mana,force,max_force,wx,dx;
object who;
object jia = this_object();
object me = environment(jia);

if ( !arg )
	return notify_fail("你要观察谁?\n");

if ( !jia->query("equipped") )
	return notify_fail("你没有装备奥丁袍。\n");

if ( me->query_temp("watched") )
	return notify_fail("你得等奥丁袍的法力恢复了再说。\n");

if ( me->query("mana")<500 )
	return notify_fail("你的法力不够。\n");

who=present(arg,environment(me));

if( !who ) 
	return notify_fail("找不到这个人。\n");

if ( who->query("combat_exp")/10 > me->query("combat_exp") )
	return notify_fail("想死吗？对方比你厉害太多了，还是放弃吧。\n");

message_vision(WHT"\n奥丁神袍上升起一道强光，笼罩住$N和"WHT+who->name()+"。\n"NOR,me);
tell_object(who,WHT+me->name()+WHT"正使用奥丁袍的神力偷偷观察你的状态。\n"NOR);

me->add("mana",150);
name=who->query("name");
if ( !name )
	name="不详";
id=who->query("id");
if ( !id )
	id="不详";
kee=who->query("kee");
eff_kee=who->query("eff_kee");
max_kee=who->query("max_kee");

sen=who->query("sen");
eff_sen=who->query("eff_sen");
max_sen=who->query("max_sen");

force = who->query("force");
max_force = who->query("max_force");
mana = who->query("mana");
max_mana = who->query("max_mana");
wx = who->query("combat_exp");
dx = who->query("daoxing");

msg = WHT"\n
------------------------------------------------------------------\n"NOR;
switch ( random(10) )
	{
	case 3 : msg+= HIC"
	气血：\t"NOR HIM+kee+"/"+eff_kee+"("+eff_kee*100/max_kee+"%)	\n"NOR;
	break;
	case 4 : msg+= HIC"
	精神：\t"NOR HIM+sen+"/"+eff_sen+"("+eff_sen*100/max_sen+"%)	\n"NOR;
	break;
	case 5 : msg+=HIC"
	内力：\t"NOR HIM+force+"("+max_force+")	\n"NOR;
	break;
	case 6 : msg+=HIC"
	法力：\t"NOR HIM+mana+"("+max_mana+")	\n"NOR;
	break;
	case 7 : msg+=HIC"
	武学：\t"NOR HIM+wx+"	\n"NOR;
	break;
	default: msg+= HIC"
       道行：\t"NOR HIM+COMBAT_D->chinese_daoxing(dx)+"  \n"NOR;
	break;
	}
msg += WHT"\n
------------------------------------------------------------------\n"NOR;

tell_object(me,WHT"奥丁神袍的神力告诉你："NOR+HIW+name+HIW"("+id+") 的状态如下："NOR+msg);
me->set_temp("watched",1);
call_out("eff_msg",5+random(5),me,jia);
return 1;
}
	
void eff_msg(object me,object cloth)
{
me->delete_temp("watched");
message_vision(WHT"奥丁袍上的法力好似渐渐恢复了。\n"NOR,me);
return;
}
