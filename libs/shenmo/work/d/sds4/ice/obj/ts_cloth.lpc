#include <ansi.h>
#include <armor.h>

inherit ARMOR;
#include "cloth.h"

void create() {
  set_name(HIY "天璇星圣衣" NOR, ({ "tianshu shengyi" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "steel");
    set("armor_prop/armor", 555);
  }
  setup();
}
