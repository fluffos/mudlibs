#include <ansi.h>
#include <armor.h>

inherit FINGER;

void check_owner(); 
void destroy(object ob);

void create()
{
        set_name(HIB"尼培尔根"NOR HIY"戒指"NOR, ({ "evl ring","ring" }) );
        set_weight(800);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("material", "gold");
		  set("value", 100);
                set("armor_prop/armor", 50);
		  set("no_give",1);
		  set("no_get",1);
		  set("no_put",1);
		  set("no_steal",1);
		  set("no_sell",1);
        }
        setup();
}

void init()
{
check_owner();
}

void check_owner()
{
object ob =this_object();
object me =environment(ob);
if ( me->query("id")=="sheluda" && !userp(me))
       return;
call_out("destroy",5+random(5),ob);
}

void destroy(object ob)
{
write(HIY"\n天空忽然乌云密布,呼的一声,伸出一只大手,将"+ob->query("name")+HIY"凭空抓去！ \n");
destruct(ob);
return;
}
