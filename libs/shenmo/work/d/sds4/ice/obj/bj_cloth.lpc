// tj_cloth.c
//天玑星圣衣

#include <ansi.h>
#include <armor.h>

inherit ARMOR;

#include "cloth.h"
void create() {
  set_name(HIY "北极星神圣衣" NOR, ({ "beiji shengyi" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "steel");
    set("armor_prop/armor", 105);
  }
  setup();
}
