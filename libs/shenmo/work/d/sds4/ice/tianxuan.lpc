//玉衡星 法利鲁  神威狼牙拳，落山群狼拳
//yuheng.c 
 
#include <ansi.h>
inherit ROOM;

void create ()
{
set ("short", HIC"天璇星宫"NOR);
set ("long", @LONG

美拉克星的哈根的神圣衣是根据神话中奥丁神的八腿战马、
邪神洛基的儿子 Sleipnir 的样子设计的。哈根和弗莱雅
在希路达被魔力所惑之前就相爱了。后来他成了希路达的
神斗士之一，他认为对希路达的绝对忠诚比他对弗莱雅的
爱

LONG);


set("exits", ([
	"down" :  __DIR__"road6",
	"westup" : __DIR__"road7",
]));
set("outdoors",1);
set("objects",([
 "/d/sds4/ice/npc/tianxuan" : 1,
]));
setup();
}

int valid_leave (object who, string dir)  
{ 
string name=who->query("name"); 

if ( (present("hawkin",this_object()) || who->query("ice/tianxuan")!="done") && dir=="westup" ) 
	return notify_fail("你还没夺取到哈根的奥丁宝石！\n"); 
return ::valid_leave(who, dir); 
}

void init()
{
add_action("do_none","perform");
add_action("do_none","surrender");
add_action("do_none","cast");
add_action("do_none","touxiang");
add_action("do_none","get");
add_action("do_none","put");
add_action("do_none","tou");
add_action("do_none","ji");
add_action("do_none","give");
add_action("do_none","recall");
add_action("do_none","shoot");
add_action("do_none","mount");
add_action("do_none","whisper");
add_action("do_none","wear");
}

int do_none()
{
object me = this_player();
message_vision("哈根说道：$N,还是靠真才实学来赢我吧......\n",me);
return 1;
}
