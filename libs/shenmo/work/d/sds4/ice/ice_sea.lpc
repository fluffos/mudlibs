
#include <ansi.h>
inherit ROOM;

int reset2();

void create ()
{
set ("short", HIW"玄冰湖"NOR);
set ("long", @LONG

这里是北海的终点。茫茫大海望不到边际。海面上波涛汹涌，
几丈高的浪头此起彼伏，象是要吞灭一切敢于到海上的东西。
也许这里便是路的尽头，面前的大海对一个凡人来说是不可
逾越的。
据说这儿是海神波塞冬与外界唯一的出入点.(jump down)

LONG);

set("no_fight", 1);
setup();
}

void init()
{
add_action("do_dive", "jump");
}

int do_dive(string arg)
{
int i;
object me, zhou,where,*obs;
object ridee,ob;
obs = all_inventory(this_player());
i = sizeof(obs);
me=this_player();
ridee=me->ride();
where = this_object();

if ( !arg || !me || arg!="down" )  return notify_fail(HIG"\n你往哪儿跳?\n"NOR); 
if ( me->query("ice/beiji")!="done" )
	return notify_fail("你一个猛子扎到水里......\n"+"\n可是却不知道下一步该做些什么，只好又爬上岸来。\n");

if ( where->query("no_dive")==1 )
	return notify_fail(HIG"\n一阵波浪将你打上岸来 。。。\n"NOR);

me->start_busy(1);
message_vision(HIG"\n$N"HIG"一个猛子扎到水中，翻腾的波浪立即将$P吞没了．\n\n" NOR, me);
me->move("/d/sds4/under1");
message_vision(HIG"\n$N"HIG"从浪花中冲了出来。\n\n",me);
me->add("kee",-200);
me->add("sen",-200);
me->add("eff_kee",-100);
me->add("eff_sen",-100);
where->set("no_dive",1);

for(i=0; i<sizeof(obs); i++) //防止get player
	{
        if ( userp(obs[i]) ) 
		return notify_fail("还是先把身上的玩家放下来再去吧！\n");            
	}

while (i--)       //防止带moonbox & zhu
	{
	ob = obs[i];
	if ( ob->query("id")=="yueguang baohe" || ob->query("id")=="lei lingzhu"
	  || ob->query("id")=="shui lingzhu" || ob->query("id")=="tu lingzhu"
	  || ob->query("id")=="huo lingzhu" || ob->query("id")=="sheng lingzhu" )
		{
		message_vision(HIG"\n一阵水流涌过,$N"HIG"一个不提防,身上的$n"HIG"已经被冲走!\n"NOR,me,ob);	
		if (! interactive(ob))
			destruct (ob);
		else
			ob->move(environment(me));
		}
	}	

call_out("reset2", 200);
return 1;
}


int reset2()
{
set("no_dive", 0);
return 1;
}
