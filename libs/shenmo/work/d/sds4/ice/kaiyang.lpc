//kaiyang.c 

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIC "开阳" NOR + HIW "星宫" NOR);
  set("long", @LONG

从前，在仙宫一家数一数二的名门里，一对夫妇生下了期待
已久的男婴，可是……如果是一个男婴便没有任何问题，在
仙宫，双生兄弟是一项禁忌，传说那会导致减门的灾难，父
母只可从中选择一个来抚养，就是因为那种荒谬的理由……
当被选中的男婴给抱紧在母亲温暧的怀里时，别一个男孩儿
却给遗弃在亚斯格特的风雪中。

LONG);

  set("exits", ([
    "up": __DIR__ "road13",
    "down": __DIR__ "road12",
  ]));
  set("outdoors", 1);
  set("objects", ([
    "/d/sds4/ice/npc/kaiyang": 1,
  ]));
  setup();
}

int valid_leave(object who, string dir) {
  string name = who->query("name");

  if ((present("kaiyang", this_object()) || who->query("ice/tianquan") != "done") && dir == "up")
    return notify_fail("你还没夺取到斯多的奥丁宝石！\n");
  return ::valid_leave(who, dir);
}

void init() {
  add_action("do_none", "perform");
  add_action("do_none", "get");
  add_action("do_none", "put");
  add_action("do_none", "cast");
  add_action("do_none", "tou");
  add_action("do_none", "ji");
  add_action("do_none", "give");
  add_action("do_none", "recall");
  add_action("do_none", "shoot");
  add_action("do_none", "mount");
  add_action("do_none", "whisper");
  add_action("do_none", "wear");
}

int do_none() {
  object me = this_player();
  message_vision("斯多说“休想逃，$N。你们以为，这么容易就可以到希路达小姐那里去吗？”\n", me);
  return 1;
}
