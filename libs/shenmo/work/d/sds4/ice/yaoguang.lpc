//yaoguang.c 
 
#include <ansi.h>
inherit ROOM;

void create ()
{
set ("short", BLINK+HIW"摇光"NOR+HIW"星宫"NOR);
set ("long", @LONG

第七星贝尼特那协星的米伊美的神圣衣像一架竖琴。他可以
制造自己的幻影，他的竖琴在他的控制下就像“触角”一样；
即使没有的竖琴这个武器，米伊美也是个相当厉害的对手。
北欧神话中，米伊美是捷克弗里德的养父（是个侏儒），
不过他后来被养子杀死

LONG);

set("exits", ([
	"south" :  __DIR__"road8",
	"westup" : __DIR__"road9",
]));
set("outdoors",1);
set("objects",([
 "/d/sds4/ice/npc/yaoguang" : 1,
]));
setup();
}

int valid_leave (object who, string dir)  
{ 
string name=who->query("name"); 

if ( (present("myemy",this_object()) || who->query("ice/yaoguang")!="done") && dir=="westup" ) 
	return notify_fail("你还没夺取到米伊美的奥丁宝石！\n"); 
return ::valid_leave(who, dir); 
}

void init()
{
add_action("do_none","perform");
add_action("do_none","surrender");
add_action("do_none","touxiang");
add_action("do_none","get");
add_action("do_none","cast");
add_action("do_none","put");
add_action("do_none","tou");
add_action("do_none","ji");
add_action("do_none","give");
add_action("do_none","recall");
add_action("do_none","shoot");
add_action("do_none","mount");
add_action("do_none","whisper");
add_action("do_none","wear");
}

int do_none()
{
object me = this_player();
message_vision("米伊美静静的看着$N......\n",me);
return 1;
}
