//北欧天玑星 德尔鲁 夺命飞斧，巨人无敌拳 
//tianji.c

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIW "天玑星宫" NOR);
  set("long", @LONG

雷神多鲁是奥丁的儿子，是个红胡子，眼睛放电的巨神。虽说形象有
点令人生畏，可由于正直勇敢而倍受人和神的爱戴。在人间，他的威
望甚至超过了奥丁：因为他不象奥丁，需要用人类的牺牲来唤醒。
他的神像在奥丁神像的左边，手持雷神之锤。此锤能产生惊雷闪电，
威力极大，几可摧世间一切邪恶。在最终圣战中，他与另一世界的敌
人-巨蛇 杰尔蒙德 对战。虽然最终将巨蛇击毙，可蛇毒仍将他杀死。
死后，他的儿子将接过他的雷锤，继承遗志。
英语中星期四 Thursday 就是为了纪念他。

LONG);


  set("exits", ([
    "down": __DIR__ "road2",
    "northup": __DIR__ "road3",
  ]));
  set("outdoors", 1);
  set("objects", ([
    "/d/sds4/ice/npc/tianji": 1,
  ]));
  setup();
}

int valid_leave(object who, string dir) {
  string name = who->query("name");

  if ((present("thor", this_object()) || who->query("ice/tianji") != "done") && dir == "northup")
    return notify_fail("得尔卢一把拦住了你的去路！\n");
  return ::valid_leave(who, dir);
}

void init() {
  add_action("do_none", "perform");
  add_action("do_none", "ji");
  add_action("do_none", "fight");
  add_action("do_none", "steal");
  add_action("do_none", "touxiang");
  add_action("do_none", "shoot");
  add_action("do_none", "mount");
  add_action("do_none", "recall");
  add_action("do_none", "whisper");
  add_action("do_none", "surrender");
  add_action("do_cast", "cast");
}

int do_none() {
  object me = this_player();
  message_vision(HIW "\n德尔鲁不屑的看着$N......\n" NOR, me);
  return 1;
}

int do_cast(string arg) {
  object me = this_player();
  if (!arg || !me) return notify_fail(HIB "\n你想使用什么法术?\n" NOR);

  if (arg == "chuqiao") return notify_fail(HIB "\n你刚把元神凝于头顶，给风雪一吹，不由打起了退堂鼓......\n" NOR);

}
