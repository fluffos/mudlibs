//shuijing.c 
 
#include <ansi.h>
inherit ROOM;

void create ()
{
set ("short", HBMAG+HIR"紫水晶中"NOR);
set ("long", @LONG

阿鲁贝利西以巴路莫古之剑的力量造出来的异次元空间,被
关在这里就什么都做不了......

LONG);
set("no_fight",1);
set("no_magic",1);
setup();
}

void init()
{
string arg;
add_action("do_none","perform");
add_action("do_none","cast");
add_action("do_none","burn");
add_action("do_none","move");
add_action("do_none","ji");
add_action("do_none","recall");
add_action("do_none","whisper");
add_action("do_none","say");
add_action("do_none","chat");
add_action("do_none","chat*");
add_action("do_none","rumor");
add_action("do_none","rumor*");
add_action("do_none","new");
add_action("do_none","new*");
add_action("do_none","tell");
add_action("do_none","reply");
add_action("do_none","say");
add_action("do_none","shit");
add_action("do_none","cool");
add_action("do_none","kao");
add_action("do_none","give");
add_action("do_none","bian");
add_action("do_none","put");
add_action("do_none","get");
}

int do_none(string arg)
{
object me = this_player();
if( !wizardp(me) )
	{
	tell_object(me,HBMAG+HIR"在水晶里你什么也做不了......\n"NOR);
	return 1;
	}
}
