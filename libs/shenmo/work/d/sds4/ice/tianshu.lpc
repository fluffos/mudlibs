//天枢星
//tianshu.c 

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIC "天枢星宫" NOR);
  set("long", @LONG

第一星杜比星的捷克弗里德的神圣衣像一头双头龙，它的
典故来自神话中的巨龙 Fafnir。（此龙是第一个戴上了
尼培尔根戒指的邪恶侏儒变化成的，后被捷杀死）捷是希
路达的发号司令的助手，而且看来好像在希路达变邪恶前
就很爱她。尽管他有些怀疑希路达当前的动机，但依旧对
她忠心耿耿。实力最强大的神斗士。

LONG);


  set("exits", ([
    "up": __DIR__ "minzhong",
    "south": __DIR__ "road14",
  ]));
  set("outdoors", 1);
  set("objects", ([
    "/d/sds4/ice/npc/tianshu": 1,
  ]));
  setup();
}

int valid_leave(object who, string dir) {
  string name = who->query("name");

  if ((present("tianshu", this_object()) || who->query("ice/kaiyang") != "done") && dir == "up")
    return notify_fail("你还没夺取到奥丁宝石呢！\n");
  return ::valid_leave(who, dir);
}

void init() {
  add_action("do_none", "perform");
  add_action("do_none", "cast");
  add_action("do_none", "surrender");
  add_action("do_none", "touxiang");
  add_action("do_none", "get");
  add_action("do_none", "put");
  add_action("do_none", "tou");
  add_action("do_none", "ji");
  add_action("do_none", "give");
  add_action("do_none", "recall");
  add_action("do_none", "shoot");
  add_action("do_none", "mount");
  add_action("do_none", "whisper");
  add_action("do_none", "wear");
}

int do_none() {
  object me = this_player();
  message_vision("..................\n", me);
  return 1;
}
