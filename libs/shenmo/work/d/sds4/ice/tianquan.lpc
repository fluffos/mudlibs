//yaoguang.c 

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIR "天权" NOR + HIW "星宫" NOR);
  set("long", @LONG

第四星美古拉兹星的阿鲁贝利西的神圣衣象是从骷髅头中长
出的一丛水晶。他可以将敌人困在水晶之中。他的目标是收
集所有的奥丁蓝宝石、杀死希路达及最终统治仙宫。并号称
仙宫第一智者.

LONG);

  set("exits", ([
    "up": __DIR__ "road11",
    "down": __DIR__ "road10",
  ]));
  set("outdoors", 1);
  set("objects", ([
    "/d/sds4/ice/npc/tianquan": 1,
  ]));
  setup();
}

int valid_leave(object who, string dir) {
  string name = who->query("name");

  if ((present("alublinx", this_object()) || who->query("ice/tianquan") != "done") && dir == "up")
    return notify_fail("你还没夺取到阿鲁贝利西的奥丁宝石！\n");
  return ::valid_leave(who, dir);
}

void init() {
  add_action("do_none", "perform");
  add_action("do_none", "surrender");
  add_action("do_none", "touxiang");
  add_action("do_none", "get");
  add_action("do_none", "put");
  add_action("do_none", "cast");
  add_action("do_none", "tou");
  add_action("do_none", "ji");
  add_action("do_none", "give");
  add_action("do_none", "recall");
  add_action("do_none", "shoot");
  add_action("do_none", "mount");
  add_action("do_none", "whisper");
  add_action("do_none", "wear");
}

int do_none() {
  object me = this_player();
  message_vision("阿鲁贝利西狡猾的对着$N说“我们点到为止...”\n", me);
  return 1;
}
