//玉衡宫后山瀑布，第二颗奥丁宝石拿于此pubu.c
#include <ansi.h>
inherit ROOM;
void reset( );

void create ()
{
set ("short", HIG"瀑布"NOR);
set ("long", @LONG

这是玉衡星宫后山的瀑布,这里是雪的世界,四周
是望不见边的皑皑白雪.风雪在耳边咆哮!人在自
然面前显得无比的渺小.
由于常年积雪，瀑布已被封在了厚厚的冰(ice)层
之后。

LONG);


set("exits", ([
	"out" :  __DIR__"yuheng",
]));
set("item_desc", ([
  "ice" : HIW"厚厚的冰层，里面好似有光芒微微闪动，打破冰层(break)试试。\n"NOR,
]));
set("no_magic",1);
set("no_fight",1);
setup();
}

void init()
{
add_action("do_none","recall");
add_action("do_none","mount");
add_action("do_none","cast");
add_action("do_none","move");
add_action("do_break","break");
}

int do_none()
{
object me = this_player();
message_vision(HIW"\n$N，心无旁骛，还是专心点好......\n"NOR,me);
return 1;
}

int do_break(string arg)
{
int i;
object baoshi;
string name;
object me = this_player();
object where = this_object();

if ( !arg || environment (me)!=where )
	return notify_fail("你想破什么?\n");

if ( me->query("ice/yuheng")!="done" )
	return notify_fail("法利鲁在你耳边叫嚣“打败我再说！”\n");
/*
if ( me->query_temp("pubu_get")=="done" )
        return notify_fail("你已经得到它了！\n");	
*/
if ( where->query("baoshi")==0 )
	return notify_fail("宝石已经给拿走了！\n");	

if ( me->query("kee")<500 )
	return notify_fail("你气血不够充沛！\n");	
	
if ( arg=="ice" || arg=="冰层" || arg=="冰" )
	{
        i=(int)me->query_kar();
        i=(int)me->query_str();
	i=i/2+random(i/2);
        if( wizardp(me) ) tell_object(me,"\n"HIW"i="HIR+chinese_number(i)+NOR+HIW".\n");
        if ( i>60 )
		{
		baoshi=new("/d/sds4/ice/obj/baoshi");
		name=baoshi->query("name");
		baoshi->move(me);
		message_vision(HIW"\n$N奋力一击,将冰层碎开，小心翼翼的从瀑布中捡起一枚宝石！\n"NOR,me);
                if ( !present(baoshi,me) ) {
                  message_vision(YEL"$N"YEL"一不小心将宝石跌落在地。\n"NOR,me);
                  return notify_fail("\n");
                  }
		me->set_temp("pubu_get","done");
		me->add("kee",-200-random(300));
		where->set("baoshi",0);
                message("rumor",HIY"【"NOR+HIW"北极仙宫"NOR+HIY"】雅典娜(Athena):"+HIW+me->name()+HIY"得到了"NOR+name+HIY"。\n"NOR,users()); 
		call_out("reset",1800+random(1800));
		}
	else	{
		message_vision(HIW"\n$N奋力一击,冰层纹丝不动！\n"NOR,me);	
		me->add("kee",-500);
		me->star_busy(1+random(2));
		return 1;
		}
	return 1;
	}
return 1;
}

void reset()
{
set("baoshi",1);
return;
}
