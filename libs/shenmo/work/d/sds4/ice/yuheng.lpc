//玉衡星 法利鲁  神威狼牙拳，落山群狼拳
//yuheng.c 

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIB "玉衡星宫" NOR);
  set("long", @LONG

法利鲁是一个可怕的，凶残的巨大狼形怪物，是洛基的最小的儿子。
神们听说了这样一个预言: 狼，最终要成为毁灭世界的元凶之一。于
是神将狼族抓了起来，关在笼子里。但随着法利鲁从幼兽到巨型怪物
的长大，那些笼子简直没法约束他。神只好让矮人族做了根丝带。丝
带用 : 猫玩球时发出的声音，大山的根，女人的胡子，鱼儿的呼吸，
熊的韧带和鸟儿的唾液六样东西制成。神和法利鲁打赌能不能挣开这
个丝带，法利鲁答应一试，但要求必须有一个神的手放在他的口中
（狡猾）。战神铁尔接受了。最终，法利鲁挣开不了那魔力丝带，
可作为报复，他将铁尔的一只手咬了下来。神将恶狼绑在离地面几百
米深的巨石上，用剑撑着他的上下颚，让他再不能伤人。到了最终圣
战，他解放了出来，复仇之心使他要吞掉所有的神。不过最终还是死
在了奥丁的儿子维达手上。

LONG);


  set("exits", ([
    "southdown": __DIR__ "road5",
    "east": __DIR__ "road4",
    "enter": __DIR__ "pubu",
  ]));
  set("outdoors", 1);
  set("objects", ([
    "/d/sds4/ice/npc/yuheng": 1,
  ]));
  setup();
}

int valid_leave(object who, string dir) {
  string name = who->query("name");

  if ((present(
    "fenrir",
    this_object()
  ) || who->query("ice/yuheng") != "done") && (dir == "southdown" || dir == "enter"))
    return notify_fail("你还没夺取到法利鲁的奥丁宝石！\n");
  return ::valid_leave(who, dir);
}

void init() {
  add_action("do_none", "perform");
  add_action("do_none", "surrender");
  add_action("do_none", "touxiang");
  add_action("do_none", "cast");
  add_action("do_none", "get");
  add_action("do_none", "put");
  add_action("do_none", "tou");
  add_action("do_none", "ji");
  add_action("do_none", "give");
  add_action("do_none", "recall");
  add_action("do_none", "shoot");
  add_action("do_none", "mount");
  add_action("do_none", "whisper");
  add_action("do_none", "wear");
}

int do_none() {
  object me = this_player();
  message_vision("法利鲁朝着$N嘿嘿笑了几声......\n", me);
  return 1;
}
