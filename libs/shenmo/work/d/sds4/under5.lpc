//under1.c

#include <ansi.h>
inherit ROOM;
void go();
int do_none();

void create() {
  set("short", "海底");
  set("long", @LONG

到了一个水中世界。海面上波浪汹涌，这里却静得出奇。一群群银
色的小鱼在蓝色的海水中游来游去，脚下是色彩斑斓的珊湖礁，其
中白色的珊瑚连成一线，如一条白云铺成的道路。
LONG);

  set("exits", ([
    "west": __DIR__ "under5",
    "south": __DIR__ "under4",
    "north": __DIR__ "under5",
    "east": __DIR__ "under6",
  ]));
  set("water", 1);
  setup();
}

void init() {
  object me = this_player();
  if (me->query("id") == "didisi" && !userp(me))
    call_out("go", 1 + random(4));
  add_action("do_none", "cast");
  add_action("do_none", "drop");
}

void go() {
  object me = this_player();
  if (me->query("id") == "didisi" && !userp(me))
    me->command_function("east");
  return;
}

int do_none() {
  object me = this_player();
  tell_object(me, HIG "\n还是专心找海王殿入口吧！\n" NOR);
  return 1;
}
