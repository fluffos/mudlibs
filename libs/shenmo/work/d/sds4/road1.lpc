#include <ansi.h>
inherit ROOM;

void go(object me);

void create() {
  set("short", HIG "海底小径" NOR);
  set("long", @LONG

         .               `         /
                          .    ,../...       .
          .                .  /       `\  /  .
     \    .        o         < '  )     =<
     /\  .                    \ \      /  \   .  __
   >=)'>                       `'\'"'"'         /o \/
     \/ .    /         o              /,        \__/\    .:/
     /   .  /--\ /         /         <')=<
           <o)  =<      . / \         \`
            \__/ \       <')_=<
             \            \_/
海面上波浪汹涌，这里却静得出奇。一群群银色的小鱼在蓝色的海水中游来游去，
脚下是色彩斑斓的珊湖礁，其中白色的珊瑚连成一线，如一条白云铺成的道路。

LONG);

  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "under8",
    "east": __DIR__ "road2",
  ]));
  set("no_fight", 1);
  set("water", 1);
  set("no_magic", 1);
  setup();
}

void init() {
  object me = this_player();
  if (me->query("id") == "didisi" && !userp(me))
    call_out("go", 1 + random(4), me);
  return;
}

void go(object me) {
  message_vision(HIY "$N" HIY "拱手说道，好了，我就带你到这儿了，后面的路就看你的造化了！\n" NOR, me);
  me->command_function("wave");
  message_vision(CYN "$N" CYN "向北离开。\n" NOR, me);
  destruct(me);
  return;
}
