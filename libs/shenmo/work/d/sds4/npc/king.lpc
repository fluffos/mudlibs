//海皇波士顿转世朱利安·索罗
//朱里安·索罗是希腊船商之後，有“海商王”之美誉。
//但当他醒觉，发现自已是海王後，便决定要进行把整个大地以水淹没，再创做一个神之国。
//但他不知道自已所做的一切是因加隆的摆布
#include <ansi.h>
inherit NPC;
#include "star.h"

void create() {
  set_name("朱里安·索罗", ({ "julian solo", "solo" }));
  set("long", HIY "希腊船商之後，有“海商王”之美誉。\n
但当他醒觉，发现自已是海王後，便决定要进行把整个大地以水淹没，\n
再创做一个神之国。但他不知道自已所做的一切是某人的摆布。\n" NOR);
  set("gender", "男性");
  set("title", HIY "海皇波士顿转世 " NOR);
  set("age", 18);
  set("attitude", "friendly");
  set("con", 40);
  set("per", 40);
  set("str", 40);
  set("int", 40);
  set("combat_exp", 50000000);
  set("daoxing", 50000000);
  set_skill("dodge", 450);
  set_skill("force", 450);
  set_skill("parry", 450);
  set_skill("unarmed", 450);
  set_skill("haishen-quan", 450);
  set_skill("spear", 450);
  set_skill("haihuang-qiang", 450);
  set_skill("dragonstep", 450);
  set_skill("dragonforce", 450);
  set_skill("seashentong", 450);
  map_skill("parry", "haihuang-qiang");
  map_skill("spear", "haihuang-qiang");
  map_skill("dodge", "dragonstep");
  map_skill("unarmed", "haishen-quan");
  map_skill("spells", "seashentong");
  map_skill("force", "dragonforce");

  set("max_force", 25000);
  set("force", 50000);
  set("max_mana", 25000);
  set("mana", 50000);
  set("mana_factor", 100);
  set("force_factor", 100);
  set("max_kee", 20000);
  set("max_gin", 20000);
  set("max_sen", 20000);

  setup();
  carry_object("/d/sds4/obj/bsd_cloth")->wear();
  carry_object("/d/sds4/obj/ji")->wield();
}

int accept_fight(object me) {
  object ob = this_object();
  message_vision("$N朝$n摇了摇头，“这位" + RANK_D->query_respect(me) + "，还是不比了吧......”\n", ob, me);
  return 0;
}

int accept_kill(object me) {
  object ji;
  object ob = this_object();

  if (!present("sancha ji", ob)) {
    ji = new("/d/sds4/obj/ji");
    ji->move(ob);
    ji->wield();
  }
  if (!userp(me)) {
    message_vision(
      HIR "\n$N" HIR "眉头一皱，朝$n" HIR "叫道：“" + RANK_D->query_rude(me) + HIR "，想耍什么花样......”\n说罢，念动海神灭地咒......\n" NOR,
      ob,
      me
    );
    me->die();
    return 0;
  }
  if (me->query("sds4/qi") != "done") {
    ob->command_function("say 凡夫俗子竟然也想向神挑战！\n");
    ob->kill_ob(me);
    me->die();
    return 0;
  }
  if (ob->query("from_kill") == me)
    ob->set("dead/number", 0);

  ob->set_temp("my_killer", me);
  command("wear all");
  command("wield all");
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: perform_action, "spear", "scj" :),
  }));
  return 1;
}

void over2(object me, object king, object mry, object here) {
  int wx, dh, qn;
  if (!me || !king || !mry || environment(me) != here)
    return;
  message_vision(CYN "过了许久，波士顿终于渐渐恢复了本性。。。\n" NOR, me);
  king->command("wake");
  king->set_name("朱里安·索罗", ({ "julian solo", "solo" }));
  king->set("title", HIY "船王之子" NOR);
  king->command("say 狄蒂丝小姐？怎么回事？？\n");
  mry->command("whisper " + king->query("id") + " $$$%%$###$%%\n");
  king->command("ah");
  king->command("sorry");
  king->command("say 我这就和狄蒂丝送回纱织小姐，另外为了感谢你，请到里面随便挑选礼物吧...\n");
  message_vision(CYN "索罗和狄蒂丝向下离去。\n" NOR, me);
  me->set("sds4/king", "done");
  me->add("sds4/number", 1);
  wx = 25000 + random(15000);
  qn = 15000 + random(15000);
  dh = 25000 + random(15000);
  me->add("daoxing", dh);
  me->add("combat_exp", dh);
  me->add("potential", qn);
  me->save();
  message("channel:chat", HIY + "【" NOR HIG "圣战·海王篇" NOR HIY "】雅典娜(Athena):" + me->name() + HIY "成功遏止了海王之战!!\n特赏赐" NOR +
    HIW + wx + HIY "点武学以及" NOR + HIW + qn + HIY "点潜能和" NOR + HIW + COMBAT_D->chinese_daoxing(dh) + HIY "道行!\n" NOR, users());
  destruct(mry);
  destruct(king);
  return;
}


void over1(object me, object king) {
  object here, where, mry;
  if (!me || !king)
    return;
  here = environment(king);
  me->delete_temp("block_msg/all");
  me->save();
  if (environment(me) != here)
    return;

  if (!mry = present("didisi", here)) {
    mry = find_living("didisi");
    if (mry) {
      where = environment(mry);
      tell_room(where, CYN "狄蒂丝喜上眉头：" + me->query("name") + CYN "好似有新进展？我看看去..\n" NOR);
    } else mry = new("/d/sds4/npc/mry");
    mry->move(here);
    tell_room(here, CYN "狄蒂丝走了过来。\n");
  }
  mry->set("goin", 1);
  message_vision(CYN "狄蒂丝好一会才转过神来，不由上前阻止住海皇...\n" NOR, me);
  mry->command("say 陛下！！别打了，你觉醒吧，这一切全是加隆的阴谋！！\n");
  king->command("think " + king->query("id"));
  call_out("over2", 3 + random(5), me, king, mry, here);
}

void die() {
  int wx, dh, qn;
  object ji;
  object ob = this_object();
  object me = ob->query_temp("last_damage_from");
  powerup();

  if (!me || !userp(me)) {
    ob->remove_all_killer();
    all_inventory(environment())->remove_killer(ob);
    return;
  }
  me->remove_killer(ob);
  ob->remove_killer(me);

  if (me->query("sds4/king") != "done") {
    if (ob->query("dead/number") < 1) {
      ob->add("dead/number", 1);
      message_vision(HIY "$N" HIY "显了真怒!大吼一声“觉悟吧！”小宇宙异常强大起来!\n" NOR, ob);
      ob->set_name(HIG "波士顿" NOR, ({ "bosedon", "king" }));
      ob->set("title", HIY "海皇" NOR);
      set("combat_exp", 80000000);
      set("daoxing", 80000000);
      set_skill("dodge", 500);
      set_skill("force", 500);
      set_skill("parry", 500);
      set_skill("unarmed", 500);
      set_skill("haishen-quan", 500);
      set_skill("spear", 500);
      set_skill("haihuang-qiang", 500);
      set_skill("dragonstep", 500);
      set_skill("dragonforce", 500);
      set_skill("seashentong", 500);
      map_skill("parry", "haihuang-qiang");
      map_skill("spear", "haihuang-qiang");
      map_skill("dodge", "dragonstep");
      map_skill("unarmed", "haishen-quan");
      map_skill("spells", "seashentong");
      map_skill("force", "dragonforce");

      set("max_force", 35000);
      set("force", 70000);
      set("max_mana", 35000);
      set("mana", 70000);
      set("mana_factor", 200);
      set("force_factor", 200);
      set("max_kee", 30000);
      set("max_gin", 30000);
      set("max_sen", 30000);

      if (!present("sancha ji", ob)) {
        ji = new("/d/sds4/obj/ji");
        ji->move(ob);
        command("wield all");
      }
      ob->kill_ob(me);
      me->kill_ob(ob);
      return;
    } else {            //死了n次后
      me->start_busy(3);
      me->set_temp("block_msg/all", 0);
      message_vision(CYN "\n\n$N" CYN "和$n" CYN "打了个平手，两者皆伤痕累累，均不敢懈怠，警惕的注视着对手。
一时间双方陷入了僵局......\n\n" NOR, me, ob);
      call_out("over1", 3 + random(3), me, ob);
      return;
    }
  }
  message_vision(HIG "$n沉入水中消失不见。\n" NOR, me, ob);
  destruct(ob);
}
