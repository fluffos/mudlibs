#include <ansi.h>;
inherit NPC;
#include "star.h"
 
void create()
{
set_name("巴尔安", ({"baeran", "ba"}));
set("long","北 太 平 洋 之 守 護 將 軍 ﹐ 是 個 精 悍 的 男 子 ﹐
擁 有 強 大 的 小 宇 宙 。 除 了 攻 擊 外 ﹐ 防 衛 力也 很 高 強 。\n");
set("gender","男性");
set("title", HBBLU"北太平洋"NOR HIG"海将军"NOR);
set("age",18);
set("attitude", "friendly");
set("con",30);
set("per",30);
set("str",25);
set("int",35);
set("combat_exp", 30000000);
  set("daoxing", 30000000);
  set("max_sen", 10000);
  set("max_kee", 10000);
  set("force", 12000); 
  set("max_force", 6000);
  set("force_factor", 300);
  set("max_mana", 6000);
  set("mana", 12000);
  set("mana_factor", 100);
        set("chat_chance",2);
        set("chat_msg", ({
                "巴尔安说道：“要过去吗？先打倒我--海马巴尔安吧。”！\n"   
        }));
  set_skill("unarmed", 400);
  set_skill("force", 400);
  set_skill("dragonforce", 400);
  set_skill("dodge", 400);
  set_skill("parry", 400);
  set_skill("spells", 400);
  set_skill("seashentong", 400);
  set_skill("dragonstep", 400);
  set_skill("haishen-quan",400);
  map_skill("force", "dragonforce");
  map_skill("spells", "seashentong");
  map_skill("unarmed", "haishen-quan");
  map_skill("parry", "haishen-quan");
  map_skill("dodge", "dragonstep");
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
                (: perform_action, "unarmed", "xfzkq" :),
                (: perform_action, "unarmed", "jffpq" :),
                (: perform_action, "unarmed", "bowen" :),
                (: perform_action, "unarmed", "wind" :),
                (: perform_action, "unarmed", "full" :),
                (: perform_action, "unarmed", "xfzkq" :),
		   (: powerup :),	
        }) );
	setup();
carry_object("/d/sds4/obj/btpy_cloth")->wear();
}

void die()
{
object me = this_object();
object ob = me->query_temp("last_opponent");
powerup();
me->remove_killer(ob);
ob->remove_killer(me);
       
if( ob && 
   ( ob->query("sds4/yi")!="done" && ob->query("sds4/mry")=="done" ) )
        {
        ob->start_busy(3);
        message("chat",HIY+"【"NOR HIG"圣战·海王篇"NOR HIY"】加隆(jia long):"+ob->name()+
        "如此大胆，居然敢杀我海马王!!\n"NOR,users());
        ob->set("sds4/yi","done");
        ob->add("sds4/number",1);
        ob->add("daoxing", 150000);
        ob->save();
        tell_object(ob,"你赢得了一百五十年道行");
        }
message_vision(HIG"$n沉入水中消失不见。\n"NOR,ob,me); 
destruct(this_object());
}
