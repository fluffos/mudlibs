#include <ansi.h>
inherit NPC;
#include <obstacle.h>
int kill_ob(object who);

void create()
{
set_name(HIG"海斗士"NOR, ({"hai doushi","hufa"}));
set("long", HIG"\n\n大  海  无  量\n\n"NOR);
set("gender","男性");
set("title", HIY"波士顿麾下 "NOR);
set("age",18+random(82));
set("attitude", "friendly");
set("con",40);
set("per",40);
set("str",40);
set("int",40);
set("combat_exp",30000000);
set("daoxing",30000000);
set_skill("dodge", 400);
set_skill("force", 400);
set_skill("parry", 400);
set_skill("unarmed", 400);
set_skill("haishen-quan",400);
set_skill("dragonstep",400);
set_skill("dragonforce",400);
set_skill("seashentong", 400);
map_skill("parry","haishen-quan");
map_skill("dodge","dragonstep");
map_skill("unarmed","haishen-quan");
map_skill("spells","seashentong");
map_skill("force","dragonforce");

set("max_force", 15000);
set("force", 30000);
set("max_mana",15000);
set("mana",30000);
set("mana_factor",50+random(150));
set("force_factor",50+random(150));
set("max_kee", 5000+random(15000));
set("max_gin", 5000+random(15000));
set("max_sen", 5000+random(15000));

setup();
set("chat_chance_combat", 50);
set("chat_msg_combat", ({
        (: perform_action, "unarmed", "animal" :),
        (: perform_action, "unarmed", "bowen" :),
        (: perform_action, "unarmed", "hjq" :),
        (: perform_action, "unarmed", "jffpq" :),
        (: perform_action, "unarmed", "wind" :),
        (: perform_action, "unarmed", "xfzkq" :),
        (: perform_action, "unarmed", "yhcjfb" :),
        (: perform_action, "unarmed", "zap" :),
		}) );
carry_object("/d/12gong/obj/armor")->wear();
}

int accept_fight(object me)
{
object ob = this_object();
message_vision("$N朝$n摇了摇头，“这位"+RANK_D->query_respect(me)+"，还是不比了吧......”\n",ob,me);
return 0;
}
   
int heal_up()
{
if( environment() && !is_fighting() ) {
 call_out("leave", 1);	return 1;}	

return ::heal_up() + 1;
}
void leave()
{
command("say 就此告别");
command("wave");
message("vision",HIG+name()+HIG"说道：某受海皇之命，特来救助，现机缘已尽，就此告辞！\n"
	+ name()+HIG"脚下升起一潭春水,整个人隐没不见。\n"NOR, environment(),this_object() );
destruct(this_object());
}

void invocation(object who)
{
int i;
object *enemy;

message("chat",HIC+"【"NOR HIG"海王波赛冬"NOR HIC"】海斗士(Sea fighter):受海皇之命,特来相助"+who->name()+
        "!\n"NOR,users());

command("wear all");
message("vision",HIG "毫光一闪,一神情严肃之海斗士出现在众人面前。\n"
		+ name() + "说道：受海皇之命，特来相助！\n" NOR,environment(), this_object() );
enemy = who->query_enemy();
i = sizeof(enemy);
while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			kill_ob(enemy[i]);
			if( userp(enemy[i]) ) enemy[i]->fight_ob(this_object());
			else enemy[i]->kill_ob(this_object());
		}
	}
set_leader(who);
}
