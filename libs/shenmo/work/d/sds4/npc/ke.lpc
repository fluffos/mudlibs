// 克修拉

inherit NPC;
#include <ansi.h>;
#include "star.h"

void create() {
  set_name("古隆沙奧·克修拉", ({ "kashura" }));
  set("long", "印 度 洋 的 守 護 海 將 軍 。 精 神 力 極 為 強 大 ﹐ 
而 他 更 懂 得 利 用 自 已身 體 內 的 七 個 星 命 點 來 發 揮 出 
驚 人 的 攻擊 力 。  \n");
  set("gender", "男性");
  set("title", HBBLU "☆印度洋守护神☆" NOR);
  set("age", 17);
  set("attitude", "friendly");
  set("con", 30);
  set("per", 30);
  set("str", 25);
  set("int", 35);
  set("combat_exp", 35000000);
  set("daoxing", 35000000);
  set("max_sen", 15000);
  set("max_kee", 15000);
  set("force", 12000);
  set("max_force", 6000);
  set("force_factor", 300);
  set("max_mana", 6000);
  set("mana", 12000);
  set("mana_factor", 100);

  set_skill("unarmed", 450);
  set_skill("force", 450);
  set_skill("dragonforce", 450);
  set_skill("dodge", 450);
  set_skill("parry", 450);
  set_skill("spells", 450);
  set_skill("seashentong", 450);
  set_skill("dragonstep", 450);
  set_skill("haishen-quan", 450);
  map_skill("force", "dragonforce");
  map_skill("spells", "seashentong");
  map_skill("unarmed", "haishen-quan");
  map_skill("parry", "haishen-quan");
  map_skill("dodge", "dragonstep");
  set("chat_chance_combat", 70);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed", "hjq" :),
    (: perform_action, "unarmed", "jffpq" :),
    (: perform_action, "unarmed", "full" :),
    (: perform_action, "unarmed", "full" :),
    (: perform_action, "unarmed", "full" :),
  }));
  setup();
  carry_object("/d/sds4/obj/ydy_cloth")->wear();
}

void init() {
  add_action("do_none", "perform");
  add_action("do_none", "cast");
  add_action("do_none", "ji");
  add_action("do_none", "throw");
  add_action("do_none", "burn");
  add_action("do_none", "move");
  add_action("do_none", "fight");
}

int do_none() {
  object me = this_object();
  message_vision("你想怎样！！！\n", me);
  return 1;
}

void die() {
  object me = this_object();
  object ob = me->query_temp("last_opponent");
  powerup();
  me->remove_killer(ob);
  ob->remove_killer(me);

  if (ob && (ob->query("sds4/er") == "done" && ob->query("sds4/san") != "done")) {
    ob->start_busy(3);
    message("chat", HIY + "【圣域传说】加隆(jia long):" + ob->name() + "杀入了印度洋!!\n" NOR, users());
    ob->set("sds4/san", "done");
    ob->add("sds4/number", 1);
    ob->add("daoxing", 200000);
    ob->save();
    tell_object(ob, "你赢得了二百年道行\n");
  }
  message_vision(HIG "$n沉入水中消失不见。\n" NOR, ob, me);
  destruct(this_object());
}
