//加隆 海　龙 绝　招 黄金三角异次元、银河超级风暴 
//北大西洋巨柱之守护将军，黄金圣斗士双子座撒加的孪生弟弟，是这次事件的引发人。
//和兄长一样，他也想打倒女神而统治整个世界，於是便利用尚未完全醒觉的海皇来进行自已的计划。

#include <ansi.h>
inherit NPC;
#include "star.h"

void create() {
  set_name("加隆", ({ "kanon" }));
  set("long", HIY "北大西洋巨柱之守护将军，黄金圣斗士双子座撒加的孪生弟弟。\n" NOR);
  set("gender", "男性");
  set("title", HIY "海龙座" NOR);
  set("age", 28);
  set("attitude", "friendly");
  set("con", 40);
  set("per", 40);
  set("str", 40);
  set("int", 40);
  set("combat_exp", 50000000);
  set("daoxing", 50000000);
  set_skill("dodge", 450);
  set_skill("force", 450);
  set_skill("parry", 450);
  set_skill("unarmed", 450);
  set_skill("haishen-quan", 450);
  set_skill("dragonstep", 450);
  set_skill("dragonforce", 450);
  set_skill("seashentong", 450);
  map_skill("parry", "haishen-quan");
  map_skill("dodge", "dragonstep");
  map_skill("unarmed", "haishen-quan");
  map_skill("spells", "seashentong");
  map_skill("force", "dragonforce");

  set("max_force", 25000);
  set("force", 50000);
  set("max_mana", 25000);
  set("mana", 50000);
  set("mana_factor", 250);
  set("force_factor", 250);
  set("max_kee", 20000);
  set("max_gin", 20000);
  set("max_sen", 20000);

  setup();
  carry_object("/d/sds4/obj/bdxy_cloth")->wear();
}

int accept_fight(object me) {
  object ob = this_object();
  message_vision("$N朝$n摇了摇头，“这位" + RANK_D->query_respect(me) + "，还是不比了吧......”\n", ob, me);
  return 0;
}

int accept_kill(object me) {
  object ob = this_object();

  if (!userp(me)) {
    message_vision(
      HIR "\n$N" HIR "眉头一皱，朝$n" HIR "叫道：“" + RANK_D->query_rude(me) + HIR "，想耍什么花样......”\n说罢，念动海神灭地咒......\n" NOR,
      ob,
      me
    );
    me->die();
    return 1;
  }

  if (me->query("sds4/liu") != "done") {
    message_vision(
      HIM "\n$N" HIM "眉头一皱，朝$n" HIM "怒喝道：“" + RANK_D->query_rude(me) + HIM "，你不是黄金圣斗士，来这儿捣什么蛋？”\n说罢，念动海神搬运咒......\n" NOR,
      ob,
      me
    );
    me->move("/d/city/kezhan");
    message_vision(HIR "\n$n" HIR "眼前一黑，等再看清周围景象时，业已回到了长安城！\n" NOR, ob, me);
    me->unconcious();
    return 1;
  }


  if (ob->query("from_kill") == me)
    ob->set("dead/number", 0);

  ob->set_temp("my_killer", me);
  command("wear all");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed", "hjsjycy" :),
    (: perform_action, "unarmed", "yhcjfb" :),
  }));
  return 1;
}

void mry(object me, object mry, object npc, object here) {
  mry->command("say 原来是你搞的鬼。。。\n");
  message_vision(CYN "狄蒂丝说道：不行，我得去看看陛下去!\n" NOR, me);
  tell_room(here, CYN "狄蒂丝急匆匆的离去。\n" NOR);
  destruct(mry);
  message_vision(CYN "加隆贪了一口气，缓缓的闭上了双眼，消失在浪花中......\n" NOR, me);
  message(
    "chat",
    HIY + "【" NOR HIG "圣战·海王篇" NOR HIY "】雅典娜(Athena):" + me->name() + "解开了海王之迷!!\n" NOR,
    users()
  );
  me->set("sds4/qi", "done");
  me->add("sds4/number", 1);
  me->add("daoxing", 350000);
  me->save();
  tell_object(me, "你赢得了三百五十年道行!\n");
  return;
}

void end(object me, object npc) {
  object mry, where, here;
  string msg;
  here = environment(npc);

  if (environment(me) != here)
    return;

  msg = CYN "$N" CYN "惊讶地“啊”了一声。\n" NOR;
  msg += CYN "这张脸似乎在哪里见过......\n" NOR;
  msg += CYN "$n" CYN "沧然一笑，“你终于发现了吗？不错，我就是双子座撒加的孪生弟弟。”\n" NOR;
  msg += CYN "$n" CYN "叹了口气，“命运真是作弄人啊......我唤醒了海王的记忆，想通过他
来统治常世，唉，现在一切都已改观了，" + me->query("name") + CYN "觉悟吧，海王已经觉醒了！”\n" NOR;
  message_vision(msg, me, npc);
  mry = find_player("didisi");
  if (!mry || userp(mry))
    mry = find_living("didisi");
  if (mry) {
    where = environment(mry);
    tell_room(where, CYN "狄蒂丝喜上眉头：" + me->query("name") + CYN "好似有新发现？我去看看去..\n" NOR);
  } else mry = new("/d/sds4/npc/mry");
  mry->move(here);
  tell_room(here, CYN "狄蒂丝走了过来。\n");
  call_out("mry", 3 + random(3), me, mry, npc, here);
}

void die() {
  object ob = this_object();
  object me = ob->query_temp("last_opponent");
  powerup();
  me->remove_killer(ob);
  ob->remove_killer(me);

  if (me->query("sds4/liu") == "done" && me->query("sds4/qi") != "done") {
    me->start_busy(3);
    message_vision(CYN "$N" CYN "上前一步，摘下了$n" CYN "的头盔。\n" NOR, me, ob);
    call_out("end", 3 + random(5), me, ob);
    return;
  }
  message_vision(HIG "$n沉入水中消失不见。\n" NOR, me, ob);
  destruct(ob);
  ::die();
}
