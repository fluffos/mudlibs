//美人鱼 狄蒂丝  死亡珊瑚礁 
//海斗士的唯一女性，她的责任是近身侍卫。最後亦是她救回恢复本性的朱利安。

#include <ansi.h>
inherit NPC;
#include "star.h"

int do_yes();
void go();

void create() {
  set_name("狄蒂丝", ({ "didisi" }));
  set("long", HIW "海斗士的唯一女性，她的责任是近身侍卫。\n" NOR);
  set("gender", "女性");
  set("title", HIC "美人鱼" NOR);
  set("age", 20);
  set("attitude", "friendly");
  set("con", 30);
  set("per", 30);
  set("str", 25);
  set("int", 40);
  set("combat_exp", 20000000);
  set("daoxing", 20000000);
  set_skill("dodge", 400);
  set_skill("force", 400);
  set_skill("parry", 400);
  set_skill("unarmed", 400);
  set_skill("haishen-quan", 400);
  set_skill("dragonstep", 400);
  set_skill("dragonforce", 400);
  set_skill("seashentong", 400);
  map_skill("parry", "haishen-quan");
  map_skill("dodge", "dragonstep");
  map_skill("unarmed", "haishen-quan");
  map_skill("spells", "seashentong");
  map_skill("force", "dragonforce");

  set("max_force", 15000);
  set("force", 30000);
  set("max_mana", 15000);
  set("mana", 30000);
  set("mana_factor", 250);
  set("force_factor", 250);
  set("max_kee", 15000);
  set("max_gin", 15000);
  set("max_sen", 15000);

  set("inquiry", ([
    "海王": "朱利安好似给什么困惑住了，我想我能协助你，不过在此之前，你得证明
下你的实力，你愿意吗？(yes)",
  ]));
  setup();
  carry_object("/d/sds4/obj/mry_cloth")->wear();
}

void init() {
  string str;
  object ob = this_object();
  object me = this_player();
  if (me->query("gender") == "男性")
    str = "英俊";
  else str = "标致";
  if (me->query("sds4/mry") != "done")
    add_action("do_yes", "yes");
  else if (!ob->query("goin")) {
    command("say 几日不见，" + RANK_D->query_respect(me) + "长得更" + str + "了。\n");
    command("say 随我来吧。跟紧哦，别跟丢咯。。。\n");
    call_out("go", 2 + random(5));
  } else {
    switch (random(5)) {
      case 1:
        command("say 最近过得如何？\n");
        break;
      case 2:
        command("say 自上次万寒宫一别，君之风采依然。\n");
        break;
      case 3:
        command("say 走的好累哦......\n");
        break;
      case 4:
        command("say 跟紧哦，别拉下了\n");
        break;
      case 5:
        command("say 你为什么要叫" + me->query("cloth_name") + "座呢？\n");
        break;
      default:
        command("say 嗯," + me->query("name") + "，这个名字还过得去。\n");
        break;
    }
  }
  ::init();
}

int do_yes() {
  object me = this_player();
  object ob = this_object();
  if (me->query("ice/beiji") != "done" || !userp(me))
    return notify_fail("你可没资格和我说话！\n");
  command("say 你能连续打倒我三次，我自然会带你一起走的，准备好了吗？下kill吧！\n");
  return 1;
}

int accept_fight(object me) {
  object ob = this_object();
  message_vision("$N朝$n摇了摇头，“这位" + RANK_D->query_respect(me) + "，还是不比了吧......”\n", ob, me);
  return 0;
}

int accept_kill(object me) {
  object ob = this_object();

  if (!userp(me)) {
    message_vision(
      HIR "\n$N" HIR "黛眉一皱，朝$n" HIR "娇嗔道：“" + RANK_D->query_rude(me) + HIR "，想耍什么花样......”\n说罢，念动海神灭地咒......\n" NOR,
      ob,
      me
    );
    me->die();
    return 1;
  }


  if (me->query("ice/beiji") != "done") {
    message_vision(
      HIM "\n$N" HIM "黛眉一皱，朝$n" HIM "娇嗔道：“" + RANK_D->query_rude(me) + HIM "，你不是黄金圣斗士，来这儿捣什么蛋？”\n说罢，念动海神搬运咒......\n" NOR,
      ob,
      me
    );
    me->move("/d/city/kezhan");
    message_vision(HIR "\n$n" HIR "眼前一黑，等再看清周围景象时，业已回到了长安城！\n" NOR, ob, me);
    me->unconcious();
    return 1;
  }

  if (!present("meirenyu shengyi", ob)) {
    message_vision(
      HIR "\n$N" HIR "黛眉一皱，朝$n" HIR "娇嗔道：“" + RANK_D->query_rude(me) + HIR "，欺负人啊......”\n" NOR,
      ob,
      me
    );
    ob->remove_killer(me);
    me->remove_killer(ob);
    return 1;
  }

  if (me->query("sds4/mry") == "done") {
    powerup();
    message_vision(HIW "\n$N" HIC "对着$n" HIW "叹了口气，“好吧，请随我来！\n" NOR, ob, me);
    me->remove_killer(ob);
    ob->remove_killer(me);
    me->set("sds4/mry", "done");
    call_out("go", 2 + random(4));
  }


  if (ob->query("from_kill") == me)
    ob->set("dead/number", 0);

  ob->set_temp("my_killer", me);
  command("wear all");
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed", "shanhu" :),
  }));
  return 1;
}

void die() {
  object ob = this_object();
  object me = ob->query_temp("last_opponent");
  powerup();
  me->remove_killer(ob);
  ob->remove_killer(me);

  if (ob->query("dead/number") < 2) {
    ob->add("dead/number", 1);
    message_vision(HIC "\n$N" HIC "停下手来，委屈的看着$n！\n" NOR, ob, me);
    return;
  } else {            //死了三次后
    message_vision(HIC "\n$N" HIC "对着$n" HIC "叹了口气，“好吧，随我来！\n" NOR, ob, me);  //暂时
    me->set("sds4/mry", "done");
    call_out("go", 2 + random(4));
  }
}

void go() {
  object ob = this_object();
  if (!ob->query("goin")) {
    ob->command_function("east");
    ob->set("goin", 1);
  }
  return;
}
