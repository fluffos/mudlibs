// 依奥
#include <ansi.h>;
inherit NPC;
#include "star.h"
 
void create()
{
set_name("史基拉·依奥", ({"elon", "yiao ao","ao"}));
set("long", "負 責 守 衛 南 太 平 洋 的 海 將 軍 。 
必 殺 拳 之 聖 獸 拳 是 由 鷲 、 狼 、 蜂 、 大 蛇 、 吸 血 
蝙 蝠 、 熊 所 組 成 。 後 為 了 保 護 海 柱 而 犧 牲 \n");
set("gender","男性");
set("title", HBBLU"☆南太平洋守护神☆"NOR);
set("age",17);
set("attitude", "friendly");
set("con",30);
set("per",30);
set("str",25);
set("int",35);
set("combat_exp", 30000000);
  set("daoxing", 30000000);
  set("max_sen", 12000);
  set("max_kee", 12000);
  set("force", 12000); 
  set("max_force", 12000);
  set("force_factor", 300);
  set("max_mana", 6000);
  set("mana", 6000);
  set("mana_factor", 100);
        set("chat_chance",2);
        set("chat_msg", ({
                "依奥说道：“来战胜我吧。”！\n"   
        }));
          set_skill("unarmed", 450);
  set_skill("force", 450);
  set_skill("dragonforce", 450);
  set_skill("dodge", 450);
  set_skill("parry", 450);
  set_skill("spells", 450);
  set_skill("seashentong", 450);
  set_skill("dragonstep", 450);
  set_skill("haishen-quan",450);
  map_skill("force", "dragonforce");
  map_skill("spells", "seashentong");
  map_skill("unarmed", "haishen-quan");
  map_skill("parry", "haishen-quan");
  map_skill("dodge", "dragonstep");
  set("chat_chance_combat", 80);
       set("chat_msg_combat", ({
                (: perform_action, "unarmed", "animal" :),
                (: perform_action, "unarmed", "full" :),
        }) );
	setup();
carry_object("/d/sds4/obj/ntpy_cloth")->wear();
}

void die()
{
object me = this_object();
object ob = me->query_temp("last_opponent");
powerup();
me->remove_killer(ob);
ob->remove_killer(me);

if( ob && (ob->query("sds4/yi")=="done" && ob->query("sds4/er")!="done") )
        {
	ob->start_busy(3);
	message("chat",HIY+"【圣域传说】加隆(jia long):"+ob->name()+
"杀了我依奥!!\n"NOR,users());
        ob->set("sds4/er","done");
        ob->add("sds4/number",1);
        ob->add("daoxing", 200000);
        ob->save();
        tell_object(ob,"你赢得了二百年道行\n");
        }
message_vision(HIG"$n沉入水中消失不见。\n"NOR,ob,me); 
destruct(me);
      }
