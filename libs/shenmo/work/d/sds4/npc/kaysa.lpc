//隆耐狄斯 水怪座 南冰洋之柱 雷电神爪 
//南冰洋的海将军。特技是能透视别人内心中最爱的人，更之能化身成该形象去攻击敌人。

#include <ansi.h>
inherit NPC;
#include "star.h"

void create()
{
set_name("隆耐狄斯", ({"lymnades kaysa","kaysa"}));
set("long", HIB"南冰洋的海将军。特技是能透视别人内心中最爱的人，更之能化身成该形象去攻击敌人。\n"NOR);
set("gender","男性");
set("title", HIB"水怪座"NOR);
set("age",20);
set("attitude", "friendly");
set("con",30);
set("per",30);
set("str",35);
set("int",40);
set("combat_exp",40000000);
set("daoxing",40000000);
set_skill("dodge", 430);
set_skill("force", 430);
set_skill("parry", 430);
set_skill("unarmed", 430);
set_skill("haishen-quan",430);
set_skill("dragonstep",430);
set_skill("dragonforce",430);
set_skill("seashentong", 430);
map_skill("parry","haishen-quan");
map_skill("dodge","dragonstep");
map_skill("unarmed","haishen-quan");
map_skill("spells","seashentong");
map_skill("force","dragonforce");

set("max_force", 15000);
set("force", 30000);
set("max_mana",15000);
set("mana",30000);
set("mana_factor",250);
set("force_factor",250);
set("max_kee", 15000);
set("max_gin", 15000);
set("max_sen", 15000);

setup();
carry_object("/d/sds4/obj/nby_cloth")->wear();
}

void init()
{
object ob = this_object();
object me = this_player();
 
if ( !userp(me) ) 
	return;

if ( ob->query("bianed")==0 && me->query("sds4/si")!="done" )
	{
	message_vision(HIY "$N手捻口诀，念动真言，摇身一变，变得和$n"HIY"一模一样！\n" NOR,ob,me);
	ob->set_temp("apply/name",({me->name()}));
	ob->set_temp("apply/id",({me->query("id")}));
	ob->set_temp("apply/short", ({me->short()}));
	ob->set_temp("apply/long", ({me->long()}));
	ob->set_temp("is_living",living(me));
	ob->set_temp("unit",me->query("unit"));
	ob->set_temp("is_character",me->is_character());
	ob->set_temp("gender",me->query("gender"));
	ob->set_temp("age",me->query("age"));
	ob->set_temp("race",me->query("race"));
	ob->set_temp("title",me->query("title"));
	ob->set_temp("family",me->query("family"));
	ob->set("bianed",1);
      }
return ;
}

int accept_fight(object me)
{
object ob = this_object();
message_vision("$N朝$n摇了摇头，“这位"+RANK_D->query_respect(me)+"，还是不比了吧......”\n",ob,me);
return 0;
}

int accept_kill(object me)
{
object ob=this_object();

if ( !userp(me) )
	{
	message_vision(HIR"\n$N"HIR"眉头一皱，朝$n"HIR"叫道：“"+RANK_D->query_rude(me)+HIR"，想耍什么花样......”\n说罢，念动海神灭地咒......\n"NOR,ob,me);
	me->die();
	return 1;
	}
	    
if ( me->query("sds4/san")!="done" )
       {
	message_vision(HIM"\n$N"HIM"眉头一皱，朝$n"HIM"怒喝道：“"+RANK_D->query_rude(me)+HIM"，你不是黄金圣斗士，来这儿捣什么蛋？”\n说罢，念动海神搬运咒......\n"NOR,ob,me);
	me->move("/d/city/kezhan");
	message_vision(HIR"\n$n"HIR"眼前一黑，等再看清周围景象时，业已回到了长安城！\n"NOR,ob,me);
	me->unconcious();
	return 1;
	}

if ( ob->query("bianed")==1 )
	{
	if ( random(5)>3 )
		{
		message_vision(HIY"$n"HIY"看着$N"HIY"忽地觉得与自己有莫大关系,一时间下不去手!\n"NOR,ob,me);
		message_vision(HIY"$N"HIY"看看$n"HIY"“扑哧”一笑，道“你这就去吧！”说罢摆手一挥。\n"NOR,ob,me);
                me->move("d/sds4/road8");
		message_vision(HIY"$n眼前一花，已经身在"+environment(me)->query("short")+HIY"！\n"NOR,ob,me);
		return 1;
		}
	else  {
		message_vision(HIY"$n"HIY"朝着$N"HIY"一声大喝“恶贼！还不现身！”\n"NOR,ob,me);
	       ob->command_function("great "+me->query("id"));
		ob->command_function("bian "+ob->query("id")); 
		ob->delete_temp("apply/name");
		ob->delete_temp("apply/id");
		ob->delete_temp("apply/short");
		ob->delete_temp("apply/long");
		ob->delete_temp("family");
		ob->delete_temp("is_living");
		ob->delete_temp("unit");
		ob->delete_temp("is_character");
		ob->delete_temp("gender");
		ob->delete_temp("age");
		ob->delete_temp("race");
		ob->delete_temp("title");
		ob->delete_temp("family");
		message_vision(HIY "$N口念咒语，身形一晃，现了真身。\n"NOR,ob);
		ob->set("bianed",0);
		}
	}
		
if ( ob->query("from_kill")==me)
	ob->set("dead/number",0);
	
ob->set_temp("my_killer",me);
command("wear all");
set("chat_chance_combat", 5);
set("chat_msg_combat", ({
        (: perform_action, "unarmed", "zap" :),
		}) );
return 1;
}
    
void die()
{
object ob = this_object();
object me = ob->query_temp("last_opponent");
powerup();
me->remove_killer(ob);
ob->remove_killer(me);

if ( me->query("sds4/si")!="done" )
	{
	if ( ob->query("dead/number") <2 )
		{
		ob->add("dead/number",1);
		ob->command_function("great");
		ob->command_function("say 果然厉害，既然让你看出来了！\n");
		return ;
		}
	else   {            //死了三次后
	       me->start_busy(3);
       	message("chat",HIY+"【"NOR HIG"圣战·海王篇"NOR HIY"】雅典娜(Athena):"+me->name()+"识破了隆耐狄斯的诡计!!\n"NOR,users());
	       me->set("sds4/si","done");
       	me->add("sds4/number",1);
	       me->add("daoxing", 150000);
       	me->save();
	       tell_object(me,"你赢得了一百五十年道行\n");
		}
	}
message_vision(HIG"$n沉入水中消失不见。\n"NOR,me,ob); 
destruct(this_object());
}

