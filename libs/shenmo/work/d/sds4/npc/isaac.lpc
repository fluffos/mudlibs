//艾尔扎克 年龄 15 星座 水怪古拉基 俄罗斯的冰神拳、寒冷的极光
//北冰洋的海将军。本是和冰河同住於西伯利亚，同是水晶圣斗士门下，但在一次意外中为救冰河而弄伤左目，因此决定放弃正义。

#include <ansi.h>
inherit NPC;
#include "star.h"

void create() {
  set_name("艾尔扎克", ({ "kraken isaac", "isaac" }));
  set("long", HIB "北冰洋的海将军。\n
本是和冰河同住於西伯利亚，同是水晶圣斗士门下，但在一次意外中为救冰河而弄伤左目，因此决定放弃正义。\n" NOR);
  set("gender", "男性");
  set("title", HIW "古拉基座" NOR);
  set("age", 16);
  set("attitude", "friendly");
  set("con", 30);
  set("per", 30);
  set("str", 35);
  set("int", 40);
  set("combat_exp", 40000000);
  set("daoxing", 40000000);
  set_skill("dodge", 430);
  set_skill("force", 430);
  set_skill("parry", 430);
  set_skill("unarmed", 430);
  set_skill("haishen-quan", 430);
  set_skill("dragonstep", 430);
  set_skill("dragonforce", 430);
  set_skill("seashentong", 430);
  map_skill("parry", "haishen-quan");
  map_skill("dodge", "dragonstep");
  map_skill("unarmed", "haishen-quan");
  map_skill("spells", "seashentong");
  map_skill("force", "dragonforce");

  set("max_force", 15000);
  set("force", 30000);
  set("max_mana", 15000);
  set("mana", 30000);
  set("mana_factor", 250);
  set("force_factor", 250);
  set("max_kee", 15000);
  set("max_gin", 15000);
  set("max_sen", 15000);

  setup();
  carry_object("/d/sds4/obj/bby_cloth")->wear();
}

int accept_fight(object me) {
  object ob = this_object();
  message_vision("$N朝$n摇了摇头，“这位" + RANK_D->query_respect(me) + "，还是不比了吧......”\n", ob, me);
  return 0;
}

int accept_kill(object me) {
  object ob = this_object();

  if (!userp(me)) {
    message_vision(
      HIR "\n$N" HIR "眉头一皱，朝$n" HIR "叫道：“" + RANK_D->query_rude(me) + HIR "，想耍什么花样......”\n说罢，念动海神灭地咒......\n" NOR,
      ob,
      me
    );
    me->die();
    return 1;
  }

  if (me->query("sds4/si") != "done") {
    message_vision(
      HIM "\n$N" HIM "眉头一皱，朝$n" HIM "怒喝道：“" + RANK_D->query_rude(me) + HIM "，你不是黄金圣斗士，来这儿捣什么蛋？”\n说罢，念动海神搬运咒......\n" NOR,
      ob,
      me
    );
    me->move("/d/city/kezhan");
    message_vision(HIR "\n$n" HIR "眼前一黑，等再看清周围景象时，业已回到了长安城！\n" NOR, ob, me);
    me->unconcious();
    return 1;
  }


  if (ob->query("from_kill") == me)
    ob->set("dead/number", 0);

  ob->set_temp("my_killer", me);
  command("wear all");
  set("chat_chance_combat", 10);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed", "icelight" :),
  }));
  return 1;
}

void die() {
  object ob = this_object();
  object me = ob->query_temp("last_opponent");
  powerup();
  me->remove_killer(ob);
  ob->remove_killer(me);

  if (me->query("sds4/wu") != "done") {
    if (ob->query("dead/number") < 2 + random(2)) {
      ob->add("dead/number", 1);
      ob->command_function("say 果然厉害，再来再来！\n");
      ob->kill_ob(me);
      me->kill_ob(ob);
      return;
    } else {
      me->start_busy(3);
      message(
        "chat",
        HIY + "【" NOR HIG "圣战·海王篇" NOR HIY "】雅典娜(Athena):" + me->name() + "打败了艾尔扎克!!\n" NOR,
        users()
      );
      me->set("sds4/wu", "done");
      me->add("sds4/number", 1);
      me->add("daoxing", 250000);
      me->save();
      tell_object(me, "你赢得了二百五十年道行\n");
    }
  }
  message_vision(HIG "$n沉入水中消失不见。\n" NOR, me, ob);
  destruct(ob);
}
