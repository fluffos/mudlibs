void init() {
  object me = this_player();
  if (!userp(me)) me->die();
  if (me->query("sds4/mry") == "done") {
    if (me->query("sds4/er") != "done") {
      message("channel:rumor", HIY "〖" NOR HIG "圣战·海王篇" NOR HIY "〗雅典娜(Athena)：" NOR + HIW +
        me->query("name") + "(" + me->query("id") + ")" + HIY "踏上通往海王殿的道路。\n" NOR, users());
      return;
    } else {
      message("channel:rumor", HIY "〖" NOR HIG "圣战·海王篇" NOR HIY "〗雅典娜(Athena)：" NOR + HIW +
        me->query("name") + "(" + me->query("id") + ")" + HIY "再次踏上通往海王殿的道路。\n" NOR, users());
      return;
    }
  } else {
    message_vision(HIG "\n一阵巨浪将$N卷起，$N迷迷糊糊，只觉耳边生风，不知身在何处！\n" NOR, me);
    me->move("/d/sds4/ice/ice_sea");
    tell_object(me, HIG "到了！\n" NOR);
    return;
  }
  return;
}
