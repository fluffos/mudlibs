#include <ansi.h>
#include <weapon.h>

inherit STICK;

void create() {
  set_name(HIY "韦陀杵" NOR, ({ "weituo chu", "chu", "stick" }));
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("value", 5000);
    set("material", "steel");
    set("long", "一根金光灿灿的大棒。\n");
    set("wield_msg", "$N擎起一根$n，顺手舞了个棒花。\n");
    set("unwield_msg", "$N微微一笑，将$n背在背后。\n");
  }
  init_stick(130);
  setup();
}
