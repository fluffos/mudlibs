inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void create()
{
        set_name("大慈法王", ({ "daci fawang", "daci", "fawang" }));
        set("title", "宗喀巴座下");
	set("long", @LONG
即释迦智，在宗喀巴弟子中称为慈悲第一，受封为中国国师。
LONG);
        set("gender", "男性");
        set("age", 43);
	set("attitude", "peaceful");
	set("rank_info/self", "贫僧");
        set("rank_info/respect", "法王");
        set("class", "saint");
                set("str",50);
        set("per",30);
        set("max_kee", 20000);
        set("max_gin", 20000);
        set("max_sen", 20000);
        set("force", 6000);
        set("max_force", 3000);
        set("force_factor", 150);
        set("max_mana", 6000);
        set("mana", 3000);
        set("mana_factor", 200);
        set("combat_exp", 100000000);
        set("daoxing", 100000000);

        set_skill("literate", 200);
        set_skill("spells", 200);
        set_skill("lamaism", 200);
        set_skill("unarmed", 200);
        set_skill("yujiamu-quan", 200);
        set_skill("dodge", 200);
        set_skill("shenkong-xing", 200);
        set_skill("parry", 200);
        set_skill("force", 200);
        set_skill("longxiang", 200);
        set_skill("stick", 200);
        set_skill("dali-chu", 200);
        map_skill("spells", "lamaism");
        map_skill("unarmed", "yujiamu-quan");
        map_skill("dodge", "shenkong-xing");
        map_skill("force", "longxiang");
        map_skill("parry", "dali-chu");
        map_skill("stick", "dali-chu");
	set("chat_chance_combat", 80);
	set("chat_msg_combat", ({
                (: cast_spell, "budong" :),
                (: cast_spell, "wulei" :),
                (: cast_spell, "fanzhou" :),
                (: perform_action, "sword", "za" :),
	}) );
        create_family("大昭寺", 2, "法王");

	setup();
        carry_object("/d/dazhaosi/obj/sengmao")->wear();
        carry_object("/d/dazhaosi/obj/r-jiasha")->wear();
        carry_object("/d/dazhaosi/obj/gangchu")->wield();
}

void attempt_apprentice(object ob)
{
        if ( (string)ob->query("bonze/class") !="bonze" ) {
                command("say 我佛门神通广大，" + RANK_D->query_respect(ob) + "欲成正果，先行受戒。\n");
		return;
	}	
        if (((int)ob->query_skill("lamaism", 1) < 120 )) {
		command("say " + RANK_D->query_respect(ob) + "不在佛法上苦修，恐怕难成正果。\n");
		return;
	}
        command("smile " + ob->query("id") );
        command("say 好！这才是我佛门的好弟子。今后要多加努力，广大我密宗佛学。\n");

	command("recruit " + ob->query("id") );
	return;	
}
