inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void create()
{
        set_name("葛伦布", ({ "ge lunbu", "ge", "master" }));
        set("title", "大昭寺僧兵统领");
	set("long", @LONG
大昭寺僧兵统领。
LONG);
        set("gender", "男性");
        set("age", 33);
	set("attitude", "peaceful");
	set("rank_info/self", "贫僧");
        set("rank_info/respect", "活佛");
        set("class", "saint");
                set("str",50);
        set("per",30);
        set("max_kee", 10000);
        set("max_gin", 10000);
        set("max_sen", 10000);
        set("force", 4000);
        set("max_force", 2000);
        set("force_factor", 100);
        set("max_mana", 2000);
        set("mana", 4000);
        set("mana_factor", 100);
        set("combat_exp", 5000000);
        set("daoxing", 5000000);

        set_skill("literate", 80);
        set_skill("spells", 80);
        set_skill("lamaism", 80);
        set_skill("unarmed", 80);
        set_skill("sword", 80);
        set_skill("mingwang-jian", 80);
        set_skill("dodge", 80);
        set_skill("shenkong-xing", 80);
        set_skill("parry", 80);
        set_skill("force", 80);
        set_skill("longxiang", 80);
        map_skill("spells", "lamaism");
        map_skill("sword", "mingwang-jian");
        map_skill("parry", "mingwang-jian");
        map_skill("dodge", "shenkong-xing");
        map_skill("force", "longxiang");
	set("chat_chance_combat", 80);
	set("chat_msg_combat", ({
                (: cast_spell, "budong" :),
	}) );
        create_family("大昭寺", 3, "活佛");

	setup();
        carry_object("/d/dazhaosi/obj/sengmao")->wear();
        carry_object("/d/dazhaosi/obj/b-jiasha")->wear();
        carry_object("/d/obj/weapon/sword/changjian")->wield();
}

void attempt_apprentice(object ob)
{
        if ( (string)ob->query("bonze/class") !="bonze" ) {
                command("say 我佛门神通广大，" + RANK_D->query_respect(ob) + "欲成正果，先行受戒。\n");
		return;
	}	
        command("smile " + ob->query("id") );
        command("say 好！这才是我佛门的好弟子。今后要多加努力，广大我密宗佛学。\n");

	command("recruit " + ob->query("id") );
	return;	
}
