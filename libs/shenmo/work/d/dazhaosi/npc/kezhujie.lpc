inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void create() {
  set_name("克珠杰", ({ "kezhu jie", "jie", "master" }));
  set("title", HIC "第一世班禅" NOR);
  set("long", @LONG
宗喀巴弟子，名叫格雷倍桑，即第一世班禅。
LONG);
  set("gender", "男性");
  set("age", 53);
  set("attitude", "peaceful");
  set("rank_info/self", "贫僧");
  set("rank_info/respect", "班禅");
  set("class", "saint");
  set("str", 50);
  set("per", 30);
  set("max_kee", 30000);
  set("max_gin", 30000);
  set("max_sen", 30000);
  set("force", 8000);
  set("max_force", 4000);
  set("force_factor", 200);
  set("max_mana", 8000);
  set("mana", 4000);
  set("mana_factor", 200);
  set("combat_exp", 200000000);
  set("daoxing", 200000000);

  set_skill("literate", 300);
  set_skill("spells", 300);
  set_skill("lamaism", 300);
  set_skill("unarmed", 300);
  set_skill("dashouyin", 300);
  set_skill("dodge", 300);
  set_skill("shenkong-xing", 300);
  set_skill("parry", 300);
  set_skill("force", 300);
  set_skill("longxiang", 300);
  set_skill("stick", 300);
  set_skill("dali-chu", 300);
  map_skill("spells", "lamaism");
  map_skill("unarmed", "dashouyin");
  map_skill("dodge", "shenkong-xing");
  map_skill("force", "longxiang");
  map_skill("parry", "dali-chu");
  map_skill("stick", "dali-chu");
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: cast_spell, "budong" :),
    (: cast_spell, "wulei" :),
    (: cast_spell, "fanzhou" :),
    (: perform_action, "stick", "za" :),
    (: perform_action, "stick", "lianhuan" :),
  }));
  create_family("大昭寺", 2, "班禅");

  setup();
  carry_object("/d/dazhaosi/obj/sengmao")->wear();
  carry_object("/d/dazhaosi/obj/p-jiasha")->wear();
  carry_object("/d/dazhaosi/obj/weituochu")->wield();
}

void attempt_apprentice(object ob) {
  if ((string)ob->query("bonze/class") != "bonze") {
    command("say 我佛门神通广大，" + RANK_D->query_respect(ob) + "欲成正果，先行受戒。\n");
    return;
  }
  if (((int)ob->query_skill("lamaism", 1) < 200)) {
    command("say " + RANK_D->query_respect(ob) + "不在佛法上苦修，恐怕难成正果。\n");
    return;
  }
  command("smile " + ob->query("id"));
  command("say 好！这才是我佛门的好弟子。今后要多加努力，广大我密宗佛学。\n");

  command("recruit " + ob->query("id"));
  return;
}
