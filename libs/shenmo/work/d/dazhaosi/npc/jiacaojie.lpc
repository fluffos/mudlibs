inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void create()
{
        set_name("嘉曹杰", ({ "jiacao jie", "jie", "master" }));
        set("title", HIC"宗喀巴首徒"NOR);
	set("long", @LONG
宗喀巴首徒，名叫达玛仁钦，宗喀巴圆寂以后，他继承法
位，为大昭寺第一代坐床者。
LONG);
        set("gender", "男性");
        set("age", 55);
	set("attitude", "peaceful");
	set("rank_info/self", "贫僧");
        set("rank_info/respect", "教主");
        set("class", "saint");
                set("str",50);
        set("per",30);
        set("max_kee", 40000);
        set("max_gin", 40000);
        set("max_sen", 40000);
        set("force", 10000);
        set("max_force", 5000);
        set("force_factor", 250);
        set("max_mana", 10000);
        set("mana", 5000);
        set("mana_factor", 300);
        set("combat_exp", 300000000);
        set("daoxing", 300000000);

        set_skill("literate", 400);
        set_skill("spells", 400);
        set_skill("lamaism", 400);
        set_skill("unarmed", 400);
        set_skill("dashouyin", 400);
        set_skill("yujiamu-quan", 400);
        set_skill("dodge", 400);
        set_skill("shenkong-xing", 400);
        set_skill("parry", 400);
        set_skill("force", 400);
        set_skill("longxiang", 400);
        set_skill("sword", 400);
        set_skill("mingwang-jian", 400);
        map_skill("spells", "lamaism");
        map_skill("unarmed", "dashouyin");
        map_skill("dodge", "shenkong-xing");
        map_skill("force", "longxiang");
        map_skill("parry", "mingwang-jian");
        map_skill("sword", "mingwang-jian");
	set("chat_chance_combat", 80);
	set("chat_msg_combat", ({
                (: cast_spell, "budong" :),
                (: cast_spell, "wulei" :),
                (: cast_spell, "fanzhou" :),
                (: perform_action, "unarmed", "yin" :),
                (: perform_action, "unarmed", "foyin" :),
	}) );
        create_family("大昭寺", 2, "教主");

	setup();
        carry_object("/d/dazhaosi/obj/sengmao")->wear();
        carry_object("/d/dazhaosi/obj/p-jiasha")->wear();
}

void attempt_apprentice(object ob)
{
        if ( (string)ob->query("bonze/class") !="bonze" ) {
                command("say 我佛门神通广大，" + RANK_D->query_respect(ob) + "欲成正果，先行受戒。\n");
		return;
	}	
        if (((int)ob->query_skill("lamaism", 1) < 300 )) {
		command("say " + RANK_D->query_respect(ob) + "不在佛法上苦修，恐怕难成正果。\n");
		return;
	}
        command("smile " + ob->query("id") );
        command("say 好！这才是我佛门的好弟子。今后要多加努力，广大我密宗佛学。\n");

	command("recruit " + ob->query("id") );
	return;	
}
