
#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("萨木活佛", ({ "samu huofo", "huofo", "samu" }));
        set("long", @LONG
萨木活佛是大昭寺有道的高僧，对佛法有精深
的研究。他身穿一件黄色袈裟，头带僧帽。目
光如电，似乎身怀绝技。
LONG); 
        set("title", "大昭寺活佛"); 
        set("gender", "男性");
        set("class", "saint");
        set("age", 38);
        set("attitude", "peaceful");
        set("str", 35);
        set("int", 20);
        set("con", 25);

        set("max_kee", 3500);
        set("max_sen", 2500);
        set("force", 4000);
        set("max_force", 4000);
        set("max_mana", 4000);
        set("mana", 4000);
        set("force_factor", 150);
        set("mana_factor", 150);
        set("combat_exp", 8000000);
        set("daoxing", 8000000);
        set_skill("force", 180);
        set_skill("longxiang", 180);
        set_skill("spells", 180);
        set_skill("lamaism", 180);
        set_skill("dodge", 160);
        set_skill("shenkong-xing", 160);
        set_skill("stick", 160);
        set_skill("dali-chu", 160);
        set_skill("xiangmo-chu", 160);
        set_skill("unarmed", 180);
        set_skill("dashouyin", 180);
        set_skill("yujiamu-quan", 180);
        set_skill("parry", 180);
        set_skill("literate", 200);

        map_skill("force", "longxiang");
        map_skill("dodge", "shenkong-xing");
        map_skill("parry", "xiangmo-chu");
        map_skill("stick", "xiangmo-chu");
        map_skill("unarmed", "dashouyin");

        create_family("大昭寺", 3, "活佛");

        setup(); 
 
        carry_object("/d/dazhaosi/obj/y-jiasha")->wear(); 
        carry_object("/d/dazhaosi/obj/sengmao")->wear(); 
        carry_object("/d/dazhaosi/obj/gangchu")->wield(); 
} 

void attempt_apprentice(object ob) 
{
        command("say 贫僧只研佛法，并不收徒。");
}

