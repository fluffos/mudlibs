inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void create()
{
        set_name("宗喀巴", ({ "zong kaba", "zong", "master" }));
        set("title", MAG"至尊三界法王"NOR);
	set("long", @LONG
他就是西藏密宗的集大成者，格鲁派黄教的创始人，密宗
各流派的教主，至尊三界法王宗喀巴。
LONG);
        set("gender", "男性");
        set("age", 65);
	set("attitude", "peaceful");
	set("rank_info/self", "贫僧");
        set("rank_info/respect", "教主");
        set("class", "saint");
                set("str",50);
        set("per",30);
        set("max_kee", 50000);
        set("max_gin", 50000);
        set("max_sen", 50000);
        set("force", 12000);
        set("max_force", 6000);
        set("force_factor", 300);
        set("max_mana", 12000);
        set("mana", 6000);
        set("mana_factor", 300);
        set("combat_exp", 400000000);
        set("daoxing", 400000000);

        set_skill("literate", 500);
        set_skill("spells", 500);
        set_skill("lamaism", 500);
        set_skill("unarmed", 500);
        set_skill("dashouyin", 500);
        set_skill("yujiamu-quan", 500);
        set_skill("dodge", 500);
        set_skill("shenkong-xing", 500);
        set_skill("parry", 500);
        set_skill("force", 500);
        set_skill("longxiang", 500);
        set_skill("sword", 500);
        set_skill("stick", 500);
        set_skill("dali-chu", 500);
        set_skill("mingwang-jian", 500);
        set_skill("xiangmo-chu", 500);
        map_skill("spells", "lamaism");
        map_skill("unarmed", "yujiamu-quan");
        map_skill("dodge", "shenkong-xing");
        map_skill("force", "longxiang");
        map_skill("parry", "xiangmo-chu");
        map_skill("sword", "mingwang-jian");
        map_skill("stick", "xiangmo-chu");
	set("chat_chance_combat", 80);
	set("chat_msg_combat", ({
                (: cast_spell, "budong" :),
                (: cast_spell, "wulei" :),
                (: cast_spell, "fanzhou" :),
                (: perform_action, "unarmed", "jiang" :),
                (: perform_action, "unarmed", "xiangmo" :),
                (: perform_action, "unarmed", "zhuang" :),
	}) );
        create_family("大昭寺", 1, "至尊");

	setup();
        carry_object("/d/dazhaosi/obj/sengmao")->wear();
        carry_object("/d/dazhaosi/obj/p-jiasha")->wear();
}

void attempt_apprentice(object ob)
{
        if ( (string)ob->query("bonze/class") !="bonze" ) {
                command("say 我佛门神通广大，" + RANK_D->query_respect(ob) + "欲成正果，先行受戒。\n");
		return;
	}	
        if (((int)ob->query_skill("lamaism", 1) < 400 )) {
		command("say " + RANK_D->query_respect(ob) + "不在佛法上苦修，恐怕难成正果。\n");
		return;
	}
        command("smile " + ob->query("id") );
        command("say 好！这才是我佛门的好弟子。今后要多加努力，广大我密宗佛学。\n");

	command("recruit " + ob->query("id") );
	return;	
}

int recruit_apprentice(object ob)
{
if( ::recruit_apprentice(ob) ) {
ob->set("title", HIR"宗喀巴座下"NOR);
}
}
