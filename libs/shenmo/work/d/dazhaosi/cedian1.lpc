#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "侧殿");
  set("long", @LONG
这里是大昭寺的东侧殿。殿内有神态各异的十八尊者塑像，
金旒玉镶，很是庄严。
LONG);
  set("exits", ([
    "northup": __DIR__ "zoulang1",
    "west": __DIR__ "dadian",
  ]));
  set("objects", ([
    __DIR__ "npc/jiamu": 1,
    __DIR__ "npc/xiangke": 2,
  ]));
  setup();

}
int valid_leave(object me, string dir) {
  if (me->query("family/family_name") != "大昭寺"
    && dir == "northup"
    && objectp(present("jiamu huofo", environment(me))))
    return notify_fail(CYN "嘉木活佛说道：尔非大昭寺弟"
      "子，不能入内。\n" NOR);

  return ::valid_leave(me, dir);
}
