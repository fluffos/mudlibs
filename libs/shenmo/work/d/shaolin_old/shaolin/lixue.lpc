inherit ROOM;
#include <ansi.h>
#include <room.h>

string look_zi();

void create() {
  set("short", "立雪亭");
  set("long", @LONG
立雪亭原名达摩亭，深阔各三间，是一座小巧玲珑的单檐庑殿
式建筑。殿内神龛中供初祖达摩、二祖慧可、三祖僧璨、四祖道信、
五祖弘忍像。额悬清"雪印心珠"横匾一块；东南角悬挂清代铸造的
铜钟一口；东北壁角放置紧那罗铁像一具。墙上还挂着一副画(zi).
LONG);
  set("item_desc", ([ "zi": (: look_zi :), ]));
  set("objects", ([   //NPC，空着，我以后加
  ]));
  set("exits", ([
    "southeast": __DIR__ "qingshi6",
  ]));
  setup();

}

