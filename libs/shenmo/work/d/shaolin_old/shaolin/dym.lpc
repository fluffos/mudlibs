inherit ROOM;
#include <ansi.h>
#include <room.h>

void create() {
  set("short", "东院门");
  set("long", @LONG
这里是少林寺东院门。黄墙碧瓦，飞檐翘檩，正中一道
二丈来宽，三丈来高的朱红杉木包铜大门。这里人迹罕至，
惟闻足底叩击路面，有僧敲木鱼声；微风吹拂竹叶，又如
簌簌禅唱。令人尘心为之一涤，真是绝佳的禅修所在。
LONG);
  set("objects", ([   //NPC，空着，我以后加
  ]));
  set("outdoors", "shaolin");
  set("exits", ([
    "north": __DIR__ "qingshi2",
    "south": __DIR__ "shiban18",
    "west": __DIR__ "ywall2",
    "east": __DIR__ "ywall3",
  ]));
  create_door("north", "东院门", "south", DOOR_CLOSED);
  setup();
}
