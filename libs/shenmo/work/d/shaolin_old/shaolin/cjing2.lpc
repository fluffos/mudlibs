inherit ROOM;
#include <ansi.h>
#include <room.h>

void create() {
  set("short", "藏经阁一楼");
  set("long", @LONG
千余年来少林寺执中原武林之牛耳，自达摩老祖以下，历代
人材辈出。其中有不少高僧遗著留存，汇集至今，终成名震天下
的少林七十二绝艺。少林精华，尽集于此。二楼四面开窗，确保
通风。中间排列着五排大书架。四周则陈列矮几，以供阅读。几
位老僧手执经卷，正在闭目凝思。
LONG);
  set("objects", ([   //NPC，空着，我以后加
  ]));
  set("exits", ([
    "down": __DIR__ "cjing1",
  ]));
  setup();
}
