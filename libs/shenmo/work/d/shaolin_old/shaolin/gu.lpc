inherit ROOM;
#include <ansi.h>
#include <room.h>

void create ()
{
set ("short", "鼓楼");
set ("long", @LONG
这是一座砖木结构的鼓楼，楼高七层，塔身作八角形，飞檐
翘翎，檐角上挂满了一串串小铜铃，随风叮叮作响。塔身墙上镂
空雕绘着无数佛陀们的坐像。一个个形态维肖，看来出自名匠之
手。楼顶一面大鼓，楼底入口处开了一扇拱形的小木门，门扇两
侧用彩漆涂绘，画的是释祖在灵山对诸天众佛讲经时的情形。
LONG);
set("objects", ([   //NPC，空着，我以后加
]));
set("exits", ([ 
        "east"  : __DIR__"shiban13",
        "enter"  : __DIR__"guup",
]));
setup();
}

int valid_leave(object me, string dir)
{
if ( me->parse_command_id_list()[0]!="gu seng" && dir=="east" )
        return notify_fail("一旁闪出几个鼓僧喝道：什么人？！乱闯鼓楼禁地！！\n");
return ::valid_leave(me, dir);
}

void valid_move(object me)
{
if ( me->parse_command_id_list()[0]!="gu seng" && random(10)>8 )
me->move(__DIR__"gate");
}
