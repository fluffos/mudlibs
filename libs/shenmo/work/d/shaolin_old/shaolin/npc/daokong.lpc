/*
武宗入门师傅 无拳脚功夫
*/

inherit __DIR__ "npc.lpc";
inherit F_MASTER;

void create() {
  set_name("道空", ({ "dao kong", "daokong" }));
  set("long", "少林寺武宗的入门授业师傅。\n");
  set("gender", "男性");
  set("age", 40);
  set("attitude", "heroism");
  set("class", "human");
  set("per", 25);
  set("str", 30);
  set("force", 10000);
  set("max_force", 5000);
  set("max_mana", 5000);
  set("mana", 10000);
  set("daoxing", 1000000);
  set("combat_exp", 30000000);

  set_skill("spells", 350);
  set_skill("chanzong", 350);
  set_skill("dodge", 410);
  set_skill("shaolin-shenfa", 450);
  set_skill("parry", 450);
  set_skill("force", 350);
  set_skill("yijinjing", 400);
  set_skill("stick", 450);
  set_skill("zui-gun", 450);

  map_skill("spells", "chanzong");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("force", "yijinjing");
  map_skill("parry", "zui-gun");
  map_skill("stick", "zui-gun");

  create_family("少林寺", 2, "武宗师傅");
  set("title", "武宗入门授业师傅");
  set("门派/shaolin/宗派", "武");
  setup();
  carry_object("/d/shaolin/obj/sengpao")->wear();
  carry_object("/d/shaolin/obj/stick")->wield();
}

void attempt_apprentice(object ob) {
  int k;
  string *no_skills;
  if (ob->query("family/family_name") != "少林寺") {
    command("shake");
    command("say 贫僧不收外门弟子，" + RANK_D->query_respect(ob) + "还是另寻他人吧！\n");
    return;
  }
  if (ob->query("combat_exp") < query("combat_exp") / 2) {
    command("say 凭你这么点修为，" + RANK_D->query_respect(ob) + "还需多加努力才能早入征途。\n");
    return;
  }
  if (ob->query_skill("stick", 1) < 150) {
    command("say 这位" + RANK_D->query_respect(ob) + "身入我门，就要有一定的武学基础。你的基本棍法太低，不能传我衣钵。\n");
    command("sigh");
    return;
  }
  if (ob->query("门派/shaolin/宗派")
    && ob->query("门派/shaolin/宗派") != "武") {
    command("say 这位" + RANK_D->query_respect(ob) + "已入我少林" + ob->query("门派/shaolin/宗派") + "宗门下，就一定要持之以恒。\n");
    command("addoil");
    return;
  }
  no_skills = ({
    "jingang-leg", "banruo-zhang",
    "saoye-leg", "luohan-quan",
    "yuanyang-leg", "nianhua-zhi",
    "saoye-leg", "wuxiang-zhi",
    "saoye-leg", "duoluo-zhi",
    "saoye-leg", "jingang-zhi",
    "saoye-leg", "qianye-shou"
  });
  for (k = 0; k < sizeof(no_skills); k++) {
    if (ob->query_skill(no_skills[k])) {
      command("say 如果你想加入我武宗，必需放弃" + to_chinese(no_skills[k]) + "。");
      return;
    }
  }
  command("smile");
  command("say 很好，这位" + RANK_D->query_respect(ob) + "入我门下，从此天下又多了一个正义侠士。");
  command("recruit " + ob->query("id"));
  ob->set("门派/shaolin/宗派", "武");
  return;
}
