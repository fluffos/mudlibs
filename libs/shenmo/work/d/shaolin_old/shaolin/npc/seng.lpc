inherit NPC;
inherit F_MASTER;

void setname() {
  mapping name;
  string *t1 = ({
    "小沙弥", "知客僧", "扫地僧", "武僧", "小和尚", "火头僧",
    "布施僧", "和尚", "僧人",
  });
  string *t2 = ({
    "小尼姑", "尼姑", "比丘尼", "小师太",
  });
  create_family("少林寺", 3 + random(5), "弟子");
  set("level", 50 + random(300));
  if (random(2)) {
    name = NAME_D->random_name("male");
    set("gender", "男性");
    set("title", t1[random(sizeof(t1))]);
  } else {
    name = NAME_D->random_name("female");
    set("gender", "女性");
    set("title", t2[random(sizeof(t2))]);
  }
  set_name(name["name"], query("gender") == "男性" ? ({ "seng ren" }) : ({ "ni gu" }));
}

void create() {
  setname();
  set("age", 14 + random(20));
  set("per", random(41));
  set("class", "human");
  set("str", 30);
  set("max_force", 300 + random(1000));
  set("max_mana", 300 + random(1000));
  set("daoxing", 100000 + random(1000000));
  set("combat_exp", 50000 + random(1000000));

  set_skill("spells", 60 + random(120));
  set_skill("chanzong", 60 + random(120));
  set_skill("unarmed", 60 + random(120));
  set_skill("banruo-zhang", 60 + random(120));
  set_skill("dodge", 60 + random(120));
  set_skill("shaolin-shenfa", 60 + random(120));
  set_skill("parry", 60 + random(120));
  set_skill("force", 60 + random(120));
  set_skill("yijinjing", 300);
  set_skill("stick", 60 + random(120));
  set_skill("zui-gun", 60 + random(120));

  map_skill("spells", "chanzong");
  map_skill("unarmed", "banruo-zhang");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("force", "yijinjing");
  map_skill("parry", "zui-gun");
  map_skill("stick", "zui-gun");

  setup();
  carry_object("/d/shaolin/obj/sengpao")->wear();
  (__DIR__ "daocheng.lpc")->check_name(this_object());
}

void attempt_apprentice(object ob) {
  if (ob->query("level") < query("level"))
    command("say 你修为看来还是不够哈。");
  else command("say 阿弥陀佛，小僧修为浅薄，教不了徒弟。");
}
