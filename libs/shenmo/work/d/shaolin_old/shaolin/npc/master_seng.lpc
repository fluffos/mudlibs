inherit NPC;
inherit F_MASTER;

string ask_leave();
mapping name1 = ([
                "普" : "pu",
                "广" : "guang",
                "宗" : "zong",
]);
mapping name2 = ([
                "心" : "xin",
                "意" : "yi",
                "能" : "neng",
                "惠" : "hui",
                "明" : "ming",
                "智" : "zhi",
                "贤" : "xian",
                "信" : "xin",
                "仁" : "ren",
                "义" : "yi",
                "礼" : "li",
                "孝" : "xiao",
                "悌" : "ti",
]);

void create()
{
string name,*ids,*n,id1,id2;
int i;
n = keys(name1);
i = random(sizeof(n));
name = n[i];    
id1 = name1[name];
n = keys(name2);
i = random(sizeof(n));
name+= n[i];    
id2 = name2[n[i]];
id1+= " "+id2;
ids = ({id1,id2});
set_name(name,ids);
seteuid(geteuid());
setup();
set("age", 14+random(20));
set("gender", "男性");
set("per",random(41));
set("class","human");
set("str", 30);
set("max_force", 300+random(1000));
set("max_mana", 300+random(1000));
set("daoxing", 100000+random(1000000));
set("combat_exp", 50000+random(1000000));

set_skill("spells", 120);
set_skill("chanzong", 120); 
set_skill("unarmed", 220);
set_skill("dodge", 120);
set_skill("shaolin-shenfa", 120);
set_skill("parry", 220); 
set_skill("force", 120);
set_skill("yijinjing", 300); 
set_skill("stick", 220);

map_skill("spells", "chanzong"); 
map_skill("dodge", "shaolin-shenfa");
map_skill("force", "yijinjing");
  set("inquiry",([
  "leave" : (: ask_leave :),
   ]));

create_family("少林寺",4,"授业师傅");
carry_object("/d/shaolin/obj/sengpao")->wear();
}

void attempt_apprentice(object ob)
{
if ( !ob )  return;
if ( ob->query("family/family_name")
  && ob->query("family/family_name")!="少林寺" )
        {
        command("say 这位施主，开玩笑了。。。。 \n");
        return;
        }  
if ( ob->query("family/generation")<=query("family/generation") )
        {
        command("say 阿弥陀佛，阿弥陀佛。。。。\n");
        return;
        }
command("nod "+ob->parse_command_id_list()[0]);
command("recruit "+ob->parse_command_id_list()[0]);
}


string ask_leave()
{
   object me= this_player();
   if( me->query("family/family_name")!="少林寺" )
   return "你不是少林的子弟,不要瞎胡闹\n";
   me->delete("family");
   me->set("title","闲人");
   command("say 少林装修,暂时只能请施主离开,等装修好了再来!\n");
  return "此次离开,不算判师\n";
}
