/*
少林入门师傅 拳武双修
只收出家弟子
*/
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

string ask_for_join()
{
object me = this_player();
if ( me->query("family/family_name")!="少林寺" )
        return "阿弥陀佛！贫僧只替本寺俗家弟子剃度。";
if ( me->query("married") )
        return "阿弥陀佛！施主有了家庭拖累，想必难以潜心向佛。";
if ( me->query("bonze/class")=="bonze" )
        return "阿弥陀佛！你我同是出家人，何故跟老衲开这等玩笑？";
if ( me->query("bonze/justonetime") )
        return "施主既已还俗，又何苦再次出家？\n";
me->set_temp("pending/join_bonze", 1);
return "阿弥陀佛！善哉！善哉！施主若真心皈依我佛，请跪下(kneel)受戒。";
}

string ask_for_huansu()
{
object me = this_player();
if ( me->query("bonze/class")!="bonze" )
        return "阿弥陀佛！你既已身系尘世，何必凑这个热闹？";
me->set_temp("pending/leave_bonze", 1);
command("say 阿弥陀佛！一入俗世，万劫不复，"+RANK_D->query_respect(me)+"一身大乘佛法也将随之付诸东流。还望"+RANK_D->query_respect(me)+"三思。");
return RANK_D->query_respect(me)+"若已决定，便请脱袍还俗(huansu)。";
}

void create()
{
set_name("志深", ({ "zhi shen", "zhishen" }));
set("long", @LONG
    少林寺武僧志深，此人心胸开阔，智谋过人功夫十分了得。
LONG);
set("per", 25);
set("gender", "男性");
set("age", 30);
set("attitude", "heroism");
set("class","human");
set("per", 25);
set("str", 30);
set("force", 4000);
set("max_force", 2000);
set("max_mana", 2000); 
set("mana", 4000); 
set("daoxing", 100000);
set("combat_exp", 3000000);

set_skill("spells", 250);
set_skill("chanzong", 250); 
set_skill("unarmed", 250);
set_skill("banruo-zhang", 280);
set_skill("dodge", 210);
set_skill("shaolin-shenfa", 250);
set_skill("parry", 250); 
set_skill("force", 250);
set_skill("yijinjing", 300); 
set_skill("stick", 200);
set_skill("zui-gun", 250);
set_skill("jingang-leg", 280);

map_skill("spells", "chanzong"); 
map_skill("unarmed", "banruo-zhang");
map_skill("dodge", "shaolin-shenfa");
map_skill("force", "yijinjing");
map_skill("parry", "zui-gun");
map_skill("stick", "zui-gun");

create_family("少林寺",3,"授业师傅");
set("inquiry", ([
        "剃度" : (: ask_for_join :),
        "出家" : (: ask_for_join :),
        "还俗" : (: ask_for_huansu :),
]) );
setup();
carry_object("/d/shaolin/obj/sengpao")->wear();
}

void init()
{
add_action("do_kneel", "kneel");
add_action("do_huansu", "huansu");
}

void attempt_apprentice(object ob)
{   
if ( !ob )
        return;
if ( ob->query("bonze/class")!="bonze" )
        {
        command("say 贫僧只传授寺内弟子。");
        return;
        }       
if ( ob->query("门派/shaolin/宗派") )
        {
        command("say 你已是"+ob->query("门派/shaolin/宗派")+"宗传人，贫僧哪有资格教你。。。");
        return; 
        }
command("smile");
command("say 很好，这位" + RANK_D->query_respect(ob) + "入我门下，从此天下又多了一个正义侠士。");
command("recruit " + ob->query("id") );
return;
}

int do_kneel()
{
object me = this_player();      
if ( !me->query_temp("pending/join_bonze") ) return 0;

message_vision(HIC"$N"HIC"双手合十，恭恭敬敬地跪了下来。\n\n$n"HIC"拿出剃刀，将$N"HIC"的头发尽数剃去。\n\n" NOR,me,this_object());
me->set("bonze/old_name",me->name(1));
(__DIR__"daocheng.lpc")->check_name(me);
command("say 从今以後你的法名叫做" + me->name(1) + "。");
command("smile");
me->delete_temp("pending/join_bonze");
me->set("bonze/class", "bonze");
me->set("bonze/justonetime", 1);
me->save();
return 1;
}

int do_huansu()
{
object me = this_player();      
if ( !me->query_temp("pending/leave_bonze") ) 
        return 0;
message_vision( HIC "$N"HIC"脱下身上的袈裟，恭恭敬敬地跪下来磕了几个响头，从此恢复了自由身。\n\n"NOR,me, this_object() );
me->delete("bonze/class");
me->delete_skill("chanzong");
command("say 从今以後你恢复出家前的俗名" +me->query("bonze/old_name")+"。");
me->set("name", me->query("bonze/old_name") );
command("sigh");
me->delete_temp("pending/leave_bonze");
me->save();
return 1;
}

