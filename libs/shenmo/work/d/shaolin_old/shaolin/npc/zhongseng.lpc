inherit NPC;

mapping name1 = ([
  "普": "pu",
  "广": "guang",
  "宗": "zong",
]);
mapping name2 = ([
  "心": "xin",
  "意": "yi",
  "能": "neng",
  "惠": "hui",
  "明": "ming",
  "智": "zhi",
  "贤": "xian",
  "信": "xin",
  "仁": "ren",
  "义": "yi",
  "礼": "li",
  "孝": "xiao",
  "悌": "ti",
]);

void do_knock() {
  remove_call_out("do_knock");
  if (environment()->query("short") != "钟楼顶层")
    return;
  if (!living(this_object()))
    return;
  if (time() % 1200 == 0)
    message("channel:rumor", "\n远处传来一阵嘹亮的钟声，看来是少林寺的坐禅时间到了。。。。\n\n", users());
  say(name() + "专心的敲起钟来。。。。\n");
  call_out("do_knock", 300);
}

void create() {
  string name, *ids, *n, id1, id2;
  int i;
  n = keys(name1);
  i = random(sizeof(n));
  name = n[i];
  id1 = name1[name];
  n = keys(name2);
  i = random(sizeof(n));
  name += n[i];
  id2 = name2[n[i]];
  id1 += " " + id2;
  ids = ({ id1, id2 });
  set_name(name, ids);
  seteuid(geteuid());
  setup();
  set("age", 24 + random(20));
  set("gender", "男性");
  set("per", random(41));
  set("class", "human");
  set("str", 40);
  set("max_force", 3000 + random(1000));
  set("max_mana", 2000 + random(1000));
  set("force_factor", 300);
  set("daoxing", 100000 + random(1000000));
  set("combat_exp", 15000000);

  set_skill("spells", 120);
  set_skill("chanzong", 120);
  set_skill("unarmed", 420);
  set_skill("dodge", 120);
  set_skill("shaolin-shenfa", 120);
  set_skill("parry", 220);
  set_skill("force", 120);
  set_skill("yijinjing", 400);
  set_skill("stick", 220);

  map_skill("spells", "chanzong");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("force", "yijinjing");
  create_family("少林寺", 3, "弟子");
  set("title", "钟僧");
  carry_object("/d/shaolin/obj/sengpao")->wear();
  remove_call_out("do_knock");
  call_out("do_knock", 5);
}
