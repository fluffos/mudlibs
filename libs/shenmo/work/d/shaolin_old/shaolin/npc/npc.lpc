#include <ansi.h>
inherit "/d/snowtu/npc/super_npc.lpc";
inherit F_SAVE;

string query_save_file() {
  string name;
  name = query("name");
  if (!name || !stringp(name))
    return 0;
  return sprintf("/c/data/npc/少林寺/%s", name);
}

void setup() {
  ::setup();
  restore();
  if (!query("初始化")) {
    set("初始化", 1);
    save();
  }
  powerup();
  set("force_factor", query_skill("force") / 20 * 15);
  set("mana_factor", query_skill("spells") / 20 * 15);
  command("zhenshens changeup");
}

string hit_ob(object me, object target, int damage) {
  if (!damage || !me || !target || !me->is_fighting(target))
    return 0;
  if (!query_temp("weapon")) {
    me->improve_skill("unarmed", 100, 1);
    me->improve_skill("banruo-zhang", 100, 1);
    me->improve_skill("dodge", 10, 1);
    me->improve_skill("shaolin-shenfa", 10, 1);
    me->improve_skill("force", 10, 1);
    me->improve_skill("spells", 10, 1);
    me->improve_skill("yijinjing", 10, 1);
    me->improve_skill("chanzong", 10, 1);
  } else {
    me->improve_skill("stick", 100, 1);
    me->improve_skill("zui-gun", 100, 1);
    me->improve_skill("dodge", 10, 1);
    me->improve_skill("shaolin-shenfa", 10, 1);
    me->improve_skill("force", 10, 1);
    me->improve_skill("spells", 10, 1);
    me->improve_skill("yijinjing", 10, 1);
    me->improve_skill("chanzong", 10, 1);
  }
  me->save();
  return me->name() + "一击得手，感觉自身的修为提高了。\n";
}

int receive_damage(string type, int damage, object who) {
  if (damage) {
    switch (type) {
      case "kee":
        add("气血", 1);
        if (query("气血") > 100) {
          add("max_kee", 10);
          set("气血", 0);
        }
        break;
      case "eff_kee":
        add("气血", 2);
        if (query("气血") > 100) {
          add("max_kee", 15);
          set("气血", 0);
        }
        break;
      case "sen":
        add("精神", 1);
        if (query("精神") > 100) {
          add("max_sen", 10);
          set("精神", 0);
        }
        break;
      case "eff_sen":
        add("精神", 2);
        if (query("精神") > 100) {
          add("max_sen", 15);
          set("精神", 0);
        }
        break;
    }
  }
  save();
  return ::receive_damage(type, damage, who);
}

int receive_wound(string type, int damage, object who) {
  if (damage) {
    switch (type) {
      case "kee":
        add("气血", 3);
        if (query("气血") > 100) {
          add("max_kee", 15);
          set("气血", 0);
        }
        break;
      case "eff_kee":
        add("气血", 5);
        if (query("气血") > 100) {
          add("max_kee", 20);
          set("气血", 0);
        }
        break;
      case "sen":
        add("精神", 3);
        if (query("精神") > 100) {
          add("max_sen", 15);
          set("精神", 0);
        }
        break;
      case "eff_sen":
        add("精神", 5);
        if (query("精神") > 100) {
          add("max_sen", 20);
          set("精神", 0);
        }
        break;
    }
  }
  save();
  return ::receive_wound(type, damage, who);
}

void die() {
  add("combat_exp", 500 + random(500));
  add("daoxing", 500 + random(500));
  add("max_mana", 1);
  add("max_force", 1);
  add("max_kee", random(3));
  add("max_sen", random(3));

  if (save())
    CHANNEL_D->do_channel(this_object(), "rumor", "听说" + name() + "的修为得到了提升。\n");
  ::die();
}

void unconcious() {
  add("combat_exp", 100 + random(500));
  add("daoxing", 100 + random(500));
  add("max_mana", 1);
  add("max_force", 1);
  add("max_kee", random(3));
  add("max_sen", random(3));
  ::unconcious();
}
