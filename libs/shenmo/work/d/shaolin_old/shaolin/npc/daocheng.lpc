/* 道诚
法名更新NPC
少林寺便按七十字诗法裔辈分，顺序高低，以命法名。这七十字诗是：
福慧智子觉，了本圆可悟。周洪普广宗，道庆同玄祖。
清净真如海，湛寂淳贞素。德行永延恒，妙本常坚固。
心朗照幽深，性明鉴崇祚。衷正善禧禅，谨悫原济度。
雪庭为导师，引汝归铉路。
*/
#include <ansi.h>
inherit NPC;

void check_name(object me);

string do_name() {
  object me = this_player();
  if (me->query("bonze/class") != "bonze")
    return "施主好似不是方外之人。";
  check_name(me);
  return "阿弥陀佛，善哉善哉。";
}

void create() {
  set_name("道诚", ({ "dao cheng", "daocheng" }));
  set("long", "少林寺戒律僧，如果你想进阶自己的法名，可以向他打听 法名 的消息。\n");
  set("gender", "男性");
  set("age", 40);
  set("attitude", "heroism");
  set("class", "human");
  set("per", 25);
  set("str", 30);
  set("force", 10000);
  set("max_force", 5000);
  set("max_mana", 5000);
  set("mana", 10000);
  set("daoxing", 1000000);
  set("combat_exp", 30000000);

  set_skill("spells", 350);
  set_skill("chanzong", 350);
  set_skill("dodge", 410);
  set_skill("shaolin-shenfa", 450);
  set_skill("parry", 450);
  set_skill("force", 350);
  set_skill("yijinjing", 400);
  set_skill("stick", 450);
  set_skill("zui-gun", 450);

  map_skill("spells", "chanzong");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("force", "yijinjing");
  map_skill("parry", "zui-gun");
  map_skill("stick", "zui-gun");

  create_family("少林寺", 2, "武宗师傅");
  set("title", "戒律僧");
  set("inquiry", ([
    "法名": (: do_name :),
  ]));
  setup();
  carry_object("/d/shaolin/obj/sengpao")->wear();
}

void check_name(object me) {
  string old_name, oldname, newname, name1, name2, *names;
  int i, k;
  name1 = "福#慧#智#子#觉#周#洪#普#广#宗#道#庆#同#玄#祖#德#行#永#延#恒#性#明#鉴#崇#祚#衷#正#善#禧#禅#引#汝#归#铉#路#";  //35辈
  name2 = "了#本#圆#可#悟#清#净#真#如#海#湛#寂#淳#贞#素#心#朗#照#幽#深#妙#本#常#坚#固#谨#悫#原#济#度#雪#庭#为#导#师#";
  if (!me)
    return;
  k = me->query("level");
  if (k > 5000) i = 1; else if (k > 1000) i = 2;
  else if (k > 950) i = 3; else if (k > 940) i = 4;
  else if (k > 930) i = 5; else if (k > 920) i = 6;
  else if (k > 910) i = 7; else if (k > 900) i = 8;
  else if (k > 890) i = 9; else if (k > 880) i = 10;
  else if (k > 870) i = 11; else if (k > 860) i = 12;
  else if (k > 850) i = 13; else if (k > 840) i = 14;
  else if (k > 830) i = 15; else if (k > 820) i = 16;
  else if (k > 810) i = 17; else if (k > 800) i = 18;
  else if (k > 790) i = 19; else if (k > 780) i = 20;
  else if (k > 770) i = 21; else if (k > 760) i = 22;
  else if (k > 750) i = 23; else if (k > 740) i = 24;
  else if (k > 730) i = 25; else if (k > 720) i = 26;
  else if (k > 710) i = 27; else if (k > 700) i = 28;
  else if (k > 600) i = 29; else if (k > 500) i = 20;
  else if (k > 400) i = 31; else if (k > 300) i = 32;
  else if (k > 200) i = 33; else if (k > 100) i = 34;
  else i = 35;

  if (me->query("gender") == "女性")
    names = explode(name2, "#");
  else names = explode(name1, "#");
  set_temp("xxx", names);
  old_name = me->name(1);
  if (me->query("bonze/old_name"))
    oldname = me->query("bonze/old_name");
  else oldname = old_name;
  newname = sprintf("%c%c", oldname[0], oldname[1]);
  newname = names[i - 1] + newname;
  set_temp("old_name", old_name);
  set_temp("new_name", newname);
  if (old_name == newname)
    return;
  me->set("name", newname);
  me->save();
  if (userp(me)) CHANNEL_D->do_channel(
    this_object(),
    "chat",
    "本派弟子" + old_name + "修为有成，今依方丈之意，渡法名为" + newname + "，望之再接再厉。"
  );
  return;
}
