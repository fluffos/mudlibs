inherit ROOM;
#include <ansi.h>
#include <room.h>

void create() {
  set("short", "藏经阁");
  set("long", @LONG
这里是少林寺的藏经阁。是武林人士梦寐以求的地方。
这里也是中原佛法的源头，藏经之丰富，天下少有，门上
一副大匾上书『藏经阁』。门楼紧闭，好生神秘。
LONG);
  set("objects", ([   //NPC，空着，我以后加
  ]));
  set("exits", ([
    "west": __DIR__ "shiban17",
    "enter": __DIR__ "cjing1",
  ]));
  set("no_clean_enter", 0);
  setup();
}

int valid_leave(object me, string dir) {
  mapping myfam;
  me = this_player();
  myfam = me->query("family");
  if ((!myfam || (myfam["family_name"] != "少林寺"))
    && dir == "enter")
    return notify_fail("非少林弟子，到此止步吧。\n");
  return 1;
}
