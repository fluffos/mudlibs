inherit ROOM;
#include <ansi.h>
#include <room.h>

void create() {
  set("short", "慈云堂");
  set("long", @LONG
这是少林寺慈云堂，中间供奉着主神恩主『關聖帝君』，设
堂迄今已有百余年的历史，因年久失修，更显示出百年古寺的庄
重。四方善男信女，齐集堂前，企求国泰民安，风调雨顺，目前
成为村民企求安家的圣地。
LONG);
  set("objects", ([   //NPC，空着，我以后加
  __DIR__ "npc/seng": random(3),
  ]));
  set("exits", ([
    "west": __DIR__ "shiban4",
  ]));
  setup();
}
