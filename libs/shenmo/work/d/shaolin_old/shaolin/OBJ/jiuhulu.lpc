#include <ansi.h>
inherit ITEM;
inherit F_LIQUID;

mapping jiu = ([
	"name"	: ({"水酒","米酒","稻花香","烧刀子","入口倒",}),
	"remaining": ({5,6,7,8,9,10,}),
	"drunk_apply": ({10,30,60,100,300}),
	"value"	: ({1000,800,500,300,100}),
]);		

void create()
{
set_name("酒葫芦",({"jiu hulu", "hulu"}));
set_weight(7000);
if (clonep())
	set_default_object(__FILE__);
else	{
	set("long", "一个用来装米酒的葫芦瓢，是寺内用来照顾外来香客的。\n");
	set("unit", "个");
	set("value", 100);
        set("max_liquid", 500);
	}
set("liquid", ([
	"type": "alcohol",
	"name": jiu["name"][random(5)],
	"remaining": jiu["remaining"][random(5)],
	"drunk_apply": jiu["drunk_apply"][random(5)],
	]));
}
