#include <armor.h>
inherit CLOTH;

string *names = ({
  "灰布", "麻布", "粗棉", "灰白", "深灰", "蓝灰",
  "蓝布", "深色", "粗布"
});

void create() {
  set_name(names[random(sizeof(names))] + "僧袍", ({ "cloth" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
  }
  setup();
  set("armor_prop", ([
    "armor": 5 + random(30),
    "force": 50 + random(30) + random(30) + random(30) + random(30) + random(30) + random(30) + random(30) + random(30) + random(30),
  ]));
}

void dest_self() {
  write(name() + "掉落在地上，变得破烂不堪。\n");
  write("\n一阵微风吹过，破烂不堪的" + name() + "化为片片尘土，消失不见了。\n");
  destruct(this_object());
}

void init() {
  ::init();
  if (environment()) {
    if (!userp(environment())
      && environment()->query("current_player"))
      dest_self();
    else if (environment()->query("age") > 25 && environment()->query("family/family_name") != "少林寺")
      dest_self();
  }
}
