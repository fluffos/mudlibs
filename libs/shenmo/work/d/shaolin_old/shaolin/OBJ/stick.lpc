#include <weapon.h>
inherit STICK;

string *names = ({
  "白蜡", "木", "粗木", "长木", "长",
  "铁", "镔铁", "乌铜", "黑铁",
});

void create() {
  set_name(names[random(sizeof(names))] + "棍", ({ "gun", "bang", "stick" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("value", 5);
    set("material", "wood");
    set("wield_msg", "$N拿起一根$n，顺手舞了个棍花。\n");
    set("unwield_msg", "$N哼了一声，将$n插回后腰。\n");
  }
  setup();
  init_stick(1);
  set("weapon_prop/damage", 35 + random(20) + random(20) + random(20));
  set("long", "一根非常结实的" + query("name") + "。\n");
}

int hit_ob(object me, object target) {
  object weapon;
  string str;
  int v;
  if (!me || !target || !me->is_fighting(target) || target->is_busy())
    return 0;
  if (me->query("门派/shaolin/宗派") != "拳")
    v = 30;
  else v = 10;
  if (random(v) > 5)
    return 0;
  weapon = target->query_temp("weapon");
  if (!weapon)
    str = "双臂";
  else str = weapon->name();
  str = "\n" + this_object()->name() + "与$n的" + str + "相交，震得$n双臂一阵发麻。\n";
  message_vision(str, me, target);
  target->start_busy(1 + random(3));
  return random(me->query_temp("apply/damage"));
}

void dest_self() {
  write(name() + "掉落在地上，断成了两截。\n");
  write("\n\n一阵微风吹过，断成两截的" + name() + "化为片片尘土，消失不见了。\n");
  destruct(this_object());
}

void init() {
  if (environment()) {
    if (!userp(environment())
      && environment()->query("current_player"))
      dest_self();
    else if (environment()->query("family/family_name") != "少林寺")
      dest_self();
  }
}
