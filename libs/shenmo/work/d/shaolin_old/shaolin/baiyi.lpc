#include <room.h>

void create ()
{
set ("short", "白衣殿");
set ("long", @LONG
白衣殿又名锤谱殿，面阔三间,内祀白衣大士（观世音菩萨）。
殿内两山和后壁上的彩色壁画为清代绘制。分别为：少林拳谱，
十三和尚救秦王，紧那罗王和红巾军，文殊，谱贤二菩萨和降
龙，伏虎罗汉等。少林拳套路对练壁画位于白衣殿南墙,六合拳
谱壁画位于白衣殿北山墙。不少和尚在面壁而站，参悟武学。
LONG);
