inherit ROOM;
#include <ansi.h>
#include <room.h>

void create() {
  set("short", "武器库");
  set("long", @LONG
少林寺的武器库可称天下第一，十八般兵器，这里可谓应有
尽有。四面一望，令你顿感眼花缭乱。墙上砌了一个个小格子，
每个都插满了各种各样的兵器。墙角一个健壮的僧人正乒乒乓
乓地在打造一根禅杖。另一位灰衣僧人正在墙角拂拭一把戒刀。
看到你进来，他缓缓起身，向你迎了过来。
LONG);
  set("objects", ([   //NPC，空着，我以后加
  ]));
  set("exits", ([
    "south": __DIR__ "shiban12",
    "west": __DIR__ "yaopin",
    "east": __DIR__ "fangju",
  ]));

  create_door("south", "木门", "north", DOOR_CLOSED);
  set("objects", ([
    __DIR__ "npc/daokong": 1,
  ]));
  setup();
}
