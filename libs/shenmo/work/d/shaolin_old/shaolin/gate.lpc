inherit ROOM;
#include <ansi.h>
#include <room.h>

void create() {
  set("short", "山门");
  set("long", @LONG
这里是少林寺。正前方黄墙碧瓦，飞檐翘檩，正中一道二丈来
宽，三丈来高的朱红杉木包铜大门。上方一块大匾，龙飞凤舞地书
着『少林寺』三个大字。寺前三三两两的站着几个僧人。
LONG);
  set("objects", ([   //NPC，空着，我以后加
  __DIR__ "npc/seng": random(3),
    __DIR__ "npc/master_seng": 1,
  ]));
  set("outdoors", "shaolin");  //是空地就加，是房间就不写这行
  set("exits", ([
    "north": __DIR__ "guangchang1",
    "west": __DIR__ "wall1",
    "east": __DIR__ "wall2",
    "southdown": __DIR__ "shijie2",
  ]));
  create_door("north", "寺门", "south", DOOR_CLOSED);
  set("valid_startroom", 1);
  setup();
  call_other("/obj/board/shaolin_b", "???");  //暂时不要这个
}

//temp
int valid_leave(object who, string dir) {
  return notify_fail("少林寺内部装修之中，过几天再来。。。。\n");
}
