inherit ROOM;
#include <ansi.h>
#include <room.h>

void create ()
{
set ("short", "藏经阁一楼");
set ("long", @LONG
不愧为中原佛法的总源，少林寺此处藏经之富，天下罕有其
匹。这里都是密密麻麻，高及顶棚的书架，书架间仅有容身一人
通行的空隙。几排大书架中间，间隔地放着数丈长的书桌。目光
及处，你看到桌上放了几本佛经。
LONG);
set("objects", ([   //NPC，空着，我以后加
]));
set("exits", ([ 
        "up"  : __DIR__"cjing2",
        "out"  : __DIR__"cjing",
]));
setup();
