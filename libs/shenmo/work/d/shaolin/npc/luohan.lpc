#include <ansi.h>
inherit NPC;

int leave_time = 0;
void create() {
  object ob1, ob2;
  set_name("罗汉", ({ "luo han" }));
  set("long", "这是一位来自少林寺的十八罗汉，专门担任护法之责。\n");
  set("attitude", "friendly");
  set("max_gin", 1000);
  set("max_kee", 1000);
  set("max_sen", 1000);

  set("max_mana", 1000);
  set("mana", 1000);
  set("max_force", 1000);
  set("force", 1000);

  set("str", 40);
  set("cor", 40);
  set("cps", 40);

  set("combat_exp", 800000);

  set_skill("zui-gun", 100);
  set_skill("parry", 100);
  set_skill("dodge", 100);
  set_skill("stick", 100);
  set_skill("shaolin-shenfa", 100);
  set_skill("force", 100);
  set_skill("yijinjing", 100);
  set_skill("spells", 100);
  set_skill("chanzong", 100);
  set_skill("unarmed", 100);

  if (random(2)) {
    set_skill("banruo-zhang", 100),
      map_skill("unarmed", "banruo-zhang");
  } else {
    set_skill("jingang-leg", 100);
    map_skill("unarmed", "jingang-leg");
  }
  map_skill("dodge", "shaolin-shenfa");
  map_skill("stick", "zui-gun");
  map_skill("parry", "zui-gun");
  map_skill("force", "yijinjing");
  map_skill("spells", "chanzong");

  set("num", 1);
  setup();

  ob1 = carry_object("/d/shaolin/obj/xuan-cloth");
  ob1->wear();
  ob1->set("no_sell", "掌柜的瞟了一眼道：这东西一看就是劣等品，不要！不要！\n");
  ob2 = carry_object("/d/shaolin/obj/qimeigun");
  ob2->wield();
  ob2->set("no_sell", "掌柜的瞟了一眼道：这东西一看就是劣等品，不要！不要！\n");
}

int heal_up() {
  leave_time++;
  if (environment() && !is_fighting() && leave_time > 10) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  message("vision", HIY + name() + HIY "说道：末罗汉奉法主召唤，现在已经完成护法任务，就此告辞！\n\n"
    +name() + HIY "化成一片金光，消失不见了。\n" NOR, environment(), this_object());
  destruct(this_object());
}

void invocation(object who) {
  int i, k;
  object *enemy, *inv, ob;
  string *skill;
  mapping skills;

  k = who->query_skill("spells", 1);
  k /= 80;
  set_name(chinese_number(k) + "尊罗汉", ({ "luo han" }));
  set("long", chinese_number(k) + "位来自少林寺的罗汉，专门担任护法之责。\n");
  set("num", k);
  set("owner_id", who->query("id"));
  skills = who->query_skills();
  skill = keys(skills);
  i = sizeof(skill);
  while (i--)
    set_skill(skill[i], (who->query_skill(skill[i], 1) + k * 5 - random(50)));
  set("max_force", who->query("max_force"));
  set("max_mana", who->query("max_mana"));
  set("max_kee", who->query("max_kee"));
  set("max_sen", who->query("max_sen"));
  set("comat_exp", who->query("combat_exp"));
  set("daoxing", who->query("daoxing"));

  SDS_D->powerup(this_object(), 0);
  inv = all_inventory(who);
  i = sizeof(inv);
  while (i--) {
    ob = new(base_name(inv[i]));
    ob->set("no_get", 1);
    ob->set("no_sell", 1);
    ob->move(this_object());
  }
  command("wield all");
  command("wear all");
  message("vision", HIY "只听轰！的一声，一团金光一闪，现出" + chinese_number(query("num")) + "个身穿护法袈裟手执棍棒的罗汉。\n\n"
    +name() + "说道：末罗汉奉法主召唤，特来护法！\n" NOR, environment(), this_object());

  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      kill_ob(enemy[i]);
      if (userp(enemy[i])) enemy[i]->fight_ob(this_object());
      else enemy[i]->kill_ob(this_object());
    }
  }
  set_leader(who);
}

void die() {
  int num, i;
  mapping skills;
  string *skill;

  add("num", -1);
  num = query("num");
  if (num <= 0) {
    message_vision("$N化作一道金光，冲天而去！\n" NOR, this_object());
    destruct(this_object());
    return;
  } else {
    message_vision("忽听一声惨叫，一尊罗汉踉跄而退，闪了几闪，化作金光消失不见！\n" NOR, this_object());
    set_name(chinese_number(num) + "尊罗汉", ({ "luo han" }));
    set("long", chinese_number(num) + "位来自少林寺的罗汉，专门担任护法之责。\n");
    skills = query_skills();
    skill = keys(skills);
    i = sizeof(skill);
    while (i--)
      set_skill(skill[i], query_skill(skill[i], 1) - 30);
    add("combat_exp", -5000);
    if (query("combat_exp") < 30000)
      set("combat_exp", 30000);
    if (query("daoxing") < 30000)
      set("daoxing", 30000);
    SDS_D->powerup(this_object(), 0);
  }
}

void unconcious() {
  die();
}

void init() {
  add_action("do_kill", "kill");
}

int do_kill(string arg) {
  object who, me, ob;
  me = this_player();
  ob = this_object();

  if (arg == query("owner_id") && present(arg, environment())
    && !environment()->query("no_fight")
    && !environment()->query("no_magic")) {
    who = present(arg, environment());
    if (who->query("id") == arg) {
      command("say 休伤洒家门人。\n");
      if (!(ob->kill_ob(me)))
        command("kill " + me->query("id"));
      tell_object(who, HIC + name() + "开始保护你。" NOR);
    }
  }
}
