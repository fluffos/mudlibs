//gunseng.c
#include <ansi.h>

int ask_name();

inherit NPC;
inherit F_MASTER;
void create() {

  set_name("慧能", ({
    "hui neng",
    "huineng",
    "hui",
    "neng",
  }));
  set("gender", "男性");
  create_family("少林寺", 3, "弟子");
  set("title", HIR "禅宗南宗之祖" NOR);
  set("age", 65);
  set("long",
    "他是弘忍的得意弟子，神秀的师弟。禅宗南宗之祖。\n"
    "他身材矮胖，满面红光，一脸的慈祥。\n"
  );
  set("class", "human");
  set("attitude", "heroism");

  set("max_force", 3000);
  set("force_factor", 50);
  set("mana", 2000);
  set("max_mana", 3000);
  set("mana_factor", 20);
  set("combat_exp", 1800000);
  set("daoxing", 2500000);

  set_skill("yijinjing", 300);
  set_skill("chanzong", 300);
  set_skill("spells", 300);
  set_skill("force", 300);
  set_skill("dodge", 280);
  set_skill("shaolin-shenfa", 280);
  set_skill("blade", 300);
  set_skill("cibei-dao", 300);
  set_skill("meihua-dao", 500);
  set_skill("parry", 280);
  set_skill("unarmed", 280);
  set_skill("literate", 250);
  set_skill("bore-zhang", 280);
  map_skill("blade", "cibei-dao");
  map_skill("unarmed", "bore-zhang");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("parry", "bore-zhang");
  map_skill("force", "yijinjing");
  map_skill("spells", "chanzong");
  map_skill("blade", "meihua-dao");

  set("max_kee", 3300);
  set("max_sen", 3300);
  setup();
  carry_object("/d/shaolin/obj/xuan-cloth")->wear();


}
void attempt_apprentice(object ob) {
  object me;
  mapping ob_fam, my_fam;
  string name, new_name;

  me = this_object();
  my_fam = me->query("family");
  name = ob->query("name");

  if ((string)ob->query("gender") != "男性") {
    command("say 阿弥陀佛！女施主呀，贫僧可不敢开这等玩笑啊。");
    return;
  }

  if ((int)ob->query_skill("chanzong", 1) < 180) {
    command("say " + RANK_D->query_respect(ob) + "，你禅宗佛法修为不够，不能越级拜师。");
    return;
  }

  if (!(ob_fam = ob->query("family")) || ob_fam["family_name"] != "少林寺") {
    command("say " + RANK_D->query_respect(ob) + "与本派素无来往，不知此话从何谈起？");
    return;
  }

  if ((string)ob->query("human/class") != "human") {
    command("say 阿弥陀佛！贫僧不收『俗家弟子』。。。");
    return;
  }

  if ((int)ob->query("huineng-chance") > 2) {
    command("say " + RANK_D->query_respect(ob) + "，你我无缘，以后不要再来找我了。");
    return;
  }

  if (ob->query_temp("huineng_try")) {
    command("say " + RANK_D->query_respect(ob) + "，我不是说过嘛，我是来少林寺作客的，不是来收徒的。");
    return;
  }

  if (random((int)ob->query_kar()) < 20) {
    command("say " + RANK_D->query_respect(ob) + "，我是来少林寺作客的，不是来收徒的。");
    ob->add("huineng_chance", 1);
    ob->set_temp("huineng_try", 1);
    return;
  }

  command("say 阿弥陀佛，善哉！善哉！");
  command("recruit " + ob->query("id"));
  ob->set("title", HIR "禅宗南宗嫡传弟子" NOR);
}
