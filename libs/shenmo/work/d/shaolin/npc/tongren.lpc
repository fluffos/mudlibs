#include <ansi.h>
inherit F_SAVE;
inherit NPC;

void create()
{
object weapon;
set_name("铜人",({"tong ren","ren"}));
set("long","纯铜打造的铜人。\n");
set("gender","男性");
set("age",20+random(20));
set("per",30);
set("class","human");
set("nickname",HIY"铜墙铁壁"NOR);
create_family("少林寺",2,"护法");
set("str",40);
set("int",40);
set("con",40);
set("car",40);

set_skill("dodge",500);
set_skill("shaolin-shenfa",500);
map_skill("dodge","shaolin-shenfa");

set_skill("force",500);
set_skill("yijinjing",500);
map_skill("force","yijinjing");

set_skill("parry",500);
set_skill("stick",600);
set_skill("zui-gun",600);
map_skill("parry","zui-gun");
map_skill("stick","zui-gun");

set_skill("spells",500);
set_skill("chanzong",500);
map_skill("spells","chanzong");

set("combat_exp",80000000);
set("daoxing",80000000);

set("max_kee",8000);
set("max_sen",8000);
set("max_gin",5000);

set("max_force",9000);
set("force",18000);
set("force_factor",250);
set("max_mana",10000);
set("mana",20000);
set("mana_factor",350);

set("num",1);
apply_condition("drunk",10000);
setup();
carry_object("/d/city/npc/obj/stick")->wield();
weapon = new("/d/city/npc/obj/armor");
weapon->set("env/invisibility",1); 
weapon->move(this_object());
command("wear all");
add_temp("apply/damage",200);
add_temp("apply/armor",500);
}

string query_save_file()
{
return DATA_DIR"npc/tongren";
}

void owner_ob(object who,int num)
{
int pot,i;
mapping skills;
string *skill;
pot = who->query_skill("force",1);
if ( pot>500 )
	{
	skills = query_skills();
	skill = keys(skills);
	i = sizeof(skill);
	while(i--)
		set_skill(skill[i],pot);
	}	
set("num",num);
set_name("十八尊"+name(),({"tong ren"}) );
set("long","十八尊"+query("long"));
set("max_kee",query("max_kee")+num*100);
set("max_sen",query("max_sen")+num*100);
set("max_force",query("max_force")+num*200);
set("max_mana",query("max_mana")+num*200);
set("combat_exp",query("combat_exp")+num*10000);
set("daoxing",query("daoxing")+num*10000);
if ( !query_temp("weapon") )
        carry_object("/d/city/npc/obj/stick")->wield();
set_temp("apply/damage",200+50*num);
set_temp("apply/armor",500+50*num);
SDS_D->powerup(this_object(),0);
set("actions",(: call_other,"/daemon/class/shaolin/zui-gun/zuijiu", "change_act" :) ); 
this_object()->save();
this_object()->restore();	
}

void die()
{
int num;	
string name;
object who,npc,ob = this_object(),env = environment();
who = query_temp("last_opponent");

message("sound",HIY"\n\n“哗啦”一声，一尊铜人倒在地上，化作一堆垃圾。\n\n"NOR,env);

if ( who && userp(who) && env && present(who,env) )
	{
	ob->add("num",-1);
	num = query("num");
	if ( num<=0 )
		{
		if ( who->query("family/family_name")=="少林寺" )
			{
                        npc = new("/d/shaolin/npc/hongren");
			if ( !npc )
                                error(__FILE__" can't find the NPC : hongren \n");
			CHANNEL_D->do_channel(npc,"chat","本派弟子"+who->query("name")+"闯过了铜人阵，至此再与吾少林无瓜葛！");
			who->delete("family");
			who->set("title","普通百姓");
			this_object()->owner_ob(who,20);
			}
		destruct(ob);
		return;	
		}
	else	this_object()->owner_ob(who,num);		
	}	
return;
}

void unconcious()
{
die();
}

void heart_beat()
{
int i;
string arg,*magic;
object seal,target;
object me = this_player();
::heart_beat();

if ( query("eff_kee") < query("max_kee") )
	SDS_D->addEffKee(me);
if ( query("kee") < query("eff_kee") )
	SDS_D->addKee(me);
if ( query("sen") < query("eff_sen") )
	SDS_D->addSen(me);
if ( query("eff_sen") < query("max_sen") )
	SDS_D->addEffSen(me);
if ( !me->is_fighting() )
	return;

if ( !query_temp("weapon") )
	{
        carry_object("/d/city/npc/obj/stick")->wield();
	set("actions",(: call_other,"/daemon/class/shaolin/zui-gun/zuijiu", "change_act" :) ); 		
	}
SDS_D->randomPfm(me,"stick");
SDS_D->randomExert(me);
SDS_D->randomCast(me);
}

