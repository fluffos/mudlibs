
//gunseng.c
#include <ansi.h>

int ask_name(); 

inherit NPC;
inherit F_MASTER;
void create()
{

       set_name("普寂", ({"pu ji","puji","ji",}));
        set("gender", "男性" );
        create_family("少林寺", 4, "弟子");
        set("title",HIG"大照禅师"NOR );
        set("age", 30);
set("long",
                "他是一位慈眉善目的中年僧人，双目炯炯，气度不凡。\n"
                "他身穿一袭灰布镶边袈裟，正在入定打坐。\n"
        );
        set("class", "human");
        set("attitude", "heroism");

        set("force", 1700);
        set("max_force", 1700);
        set("force_factor", 70);
        set("mana", 1700);
        set("max_mana", 1700);
        set("mana_factor", 20);
        set("combat_exp", 1000000);
        set("daoxing", 1000000);

        set_skill("bore-zhang", 100);
        set_skill("yijinjing", 80);
        set_skill("chanzong", 150);
        set_skill("spells", 150);
        set_skill("unarmed", 100);
        set_skill("dodge", 80);
        set_skill("parry", 80);
        set_skill("force", 80);
        set_skill("blade", 80);
        set_skill("meihua-dao", 80);
        set_skill("babao-gun", 80);

        set_skill("shaolin-shenfa", 80);

        map_skill("unarmed", "bore-zhang");
        map_skill("parry", "bore-zhang");
        map_skill("force", "yijinjing");
        map_skill("dodge", "shaolin-shenfa");
        map_skill("spells", "chanzong");
        map_skill("blade", "meihua-dao");

        set("max_kee", 1300);
        set("max_sen", 1300);
        setup();
        carry_object("/d/shaolin/obj/dao-cloth")->wear();


}
void attempt_apprentice(object ob)
{
        if( (string)ob->query("gender") != "男性" )
        {
                command ("say 阿弥陀佛！女施主呀，贫僧可不敢开这等玩笑啊。");
                return;
        }

        if( (string)ob->query("human/class")!="human" )
        {
                command ("say 阿弥陀佛！贫僧不收『俗家弟子』。。。");
                return;
        }
        command("say 阿弥陀佛，善哉！善哉！");
        command("recruit " + ob->query("id"));
        ob->set("title", HIG"嵩山少林寺入门弟子"NOR);
}

