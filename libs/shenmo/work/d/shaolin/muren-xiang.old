#include <ansi.h>
inherit ROOM;
void pass_muren(object who);

void create()
{
set("short", "木人巷");
set("long", @LONG
一个黑漆漆的山洞，里面摆放着一些木制的假人，不知是做什
么用的。
LONG );
set("exits", ([
        "south" : __DIR__"muren-xiang",
        "north"  : __DIR__"muren-xiang",
        "west" : __DIR__"muren-xiang",
        "east"  : __DIR__"muren-xiang",
        ]));
set("objects",([
        __DIR__"npc/muren" : 1+random(3),
]));
set("no_clean_up", 0);
set("alternative_die",1);
setup();
}

void alternative_die(object who)
{
object npc;     
if ( !who )
        return; 

all_inventory(this_object())->remove_killer(who); 
who->remove_all_enemy();
        
if ( userp(who) && who->query("family/family_name")=="少林寺" )
        {
        SDS_D->powerup(who);            
        who->set("combat_exp",who->query("combat_exp")/1000*995);
        who->add("daoxing",-1000-random(5000));
        who->delete_temp("last_damage_from"); 
        who->delete_temp("last_opponent");
        who->dismiss_team(); 
        who->delete_temp("shaolin_mu_ren");
        who->set("kee",10);
        who->set("sen",10);
        who->move(__DIR__"gate");
        npc = new(__DIR__"npc/xuanze");
        npc->move(environment(who));
        message_vision("$n从戒律堂内走了过来。\n",who,npc);
        npc->command("chat 本门弟子"+who->query("name_color")+who->query("name")+HIC"欲闯木人巷，无奈修为太浅，无功而返。\n"NOR);
        npc->command("say 看来你还是静心修炼的好。\n");
        message_vision("说罢，$n转身离去。\n",who,npc);
        destruct(npc);
        }
}

int valid_leave(object who,string dir)
{
object npc,room;
if ( userp(who) && who->query("family/family_name")=="少林寺" 
  &&  ( dir=="west" || dir=="east" || dir=="north" || dir=="south" ) )
        {
        npc = present("mu ren");
        if ( npc && !userp(npc) )
                {
                if ( !npc->is_fighting(who) )
                        npc->kill_ob(who);
                return notify_fail("你只得停住脚步，专心战斗。\n");                    
                }
        else if ( who->query_temp("shaolin_mu_ren")<18 )
                {
                room = clone_object(__DIR__"muren-xiang");
                who->move(room);
                return notify_fail("你走了过来。\n");
                }
        else    {
/*
                npc = new(__DIR__"npc/hongren");
                npc->move(this_object());
                message_vision("$n满心欣悦的向$N祝贺。\n",who,npc);
                message_vision(CYN"$n"CYN"拍了拍$n"CYN"的头，欣慰的说道：恩，既然你已闯过木人巷，照
惯例，老衲便准你带师下山，从此江湖险恶，一切要小心了。。。。\n"NOR,who,npc);
                message_vision(CYN"$N"CYN"痛哭流涕，对众位师兄弟一一话别。。。。\n"NOR,who);

                who->delete("family");
                who->set("title","少林寺俗家弟子");
                if ( stringp(who->query("human/old_name")) )
                        who->set("name",who->query("human/old_name") );
                who->delete("human/old_name");
                who->delete("human/class");
                who->set("human/justonetime",1);
                
                npc->command("chat 本门弟子"+who->query("name_color")+who->query("name")+HIC"闯过木人巷，今特满师下山，从此与少林寺再无瓜葛。\n"NOR);
                message_vision(CYN"$n"CYN"与众僧将$N"CYN"送至山门，各自散去。。。\n"NOR,who,npc);
                destruct(npc);
              this_object()->set("exits/south",__DIR__"gate");
                tell_object(who,CYN"\n\n你满腹心事的看着四周景色，感慨万千。\n"NOR);
                who->command("south");
*/
//there are some bug,so i change it,fang 2011.8
                remove_call_out("pass_muren");
                call_out("pass_muren",1,who);
                return 1;
                }
        }
return ::valid_leave(who,dir);
}       
                        
void pass_muren(object who)
{
           object npc;
                npc = new(__DIR__"npc/hongren");
                npc->move(this_object());
                message_vision("$n满心欣悦的向$N祝贺。\n",who,npc);
                message_vision(CYN"$n"CYN"拍了拍$n"CYN"的头，欣慰的说道：恩，既然你已闯过木人巷，照
惯例，老衲便准你带师下山，从此江湖险恶，一切要小心了。。。。\n"NOR,who,npc);
                message_vision(CYN"$N"CYN"痛哭流涕，对众位师兄弟一一话别。。。。\n"NOR,who);

                who->delete("family");
                who->set("title","少林寺俗家弟子");
                if ( stringp(who->query("human/old_name")) )
                        who->set("name",who->query("human/old_name") );
                who->delete("human/old_name");
                who->delete("human/class");
                who->set("human/justonetime",1);
                
                npc->command("chat 本门弟子"+who->query("name_color")+who->query("name")+HIC"闯过木人巷，今特满师下山，从此与少林寺再无瓜葛。\n"NOR);
                message_vision(CYN"$n"CYN"与众僧将$N"CYN"送至山门，各自散去。。。\n"NOR,who,npc);
                destruct(npc);
              who->move(__DIR__"gate");
}
