inherit NPC; 
inherit F_MASTER;  
#include <ansi.h> 
#include "zhuanshi.lpc" 
  
 void create() 
 { 
         set_name("王方平", ({ "wang fangping", "wang", "fangping" })); 
  
 set("long","王方平本是山中道士，后在丰都山同阴长生同修炼成仙，御封(「鬼王」。\n"); 
         set("attitude", "peaceful"); 
         set("per", 30); 
         set("str", 25); 
         set("int", 25); 
         set("age", 30); 
         set("title", "轮回司主"); 
         set("nickname", "鬼王"); 
         set("combat_exp", 850000); 
   set("daoxing", 600000); 
  
         set("max_gin", 1400); 
         set("max_kee", 1400); 
         set("max_sen", 1400); 
         set("class", "xian"); 
         set("force", 2500); 
         set("max_force", 1500); 
         set("force_factor", 100); 
         set("max_mana", 1500); 
         set("mana", 2500); 
         set("mana_factor", 100); 
  
         set_skill("literate", 100); 
         set_skill("ghost-steps", 120); 
         set_skill("dodge", 120); 
         set_skill("unarmed", 120); 
         set_skill("parry", 120); 
         set_skill("spells", 120); 
         set_skill("gouhunshu", 80); 
         set_skill("jinghun-zhang", 120); 
         set_skill("force", 120); 
         set_skill("tonsillit", 80); 
         set_skill("stick", 120); 
         set_skill("kusang-bang", 120); 
  
         map_skill("stick","kusang-bang"); 
         map_skill("parry", "kusang-bang"); 
         map_skill("spells", "gouhunshu"); 
         map_skill("dodge", "ghost-steps"); 
         map_skill("force", "tonsillit"); 
         map_skill("unarmed", "jinghun-zhang"); 
         set("chat_chance_combat", 40); 
         set("chat_msg_combat", ({ 
 //                (: exert_function, "powerup" :), 
                 (: exert_function, "sheqi" :), 
                 (: cast_spell, "gouhun" :), 
         }) ); 
  
  
         set("nkgain", 400); 
         set("inquiry", ([   
             "转世"    :(:ask_zhuanshi():),   
         ])); 
  
         set_temp("apply/dodge", 50); 
         set_temp("apply/armor", 50); 
  
  
 create_family("阎罗地府", 2, "你好"); 
  
         setup(); 
         carry_object("/d/obj/weapon/stick/wuchangbang")->wield(); 
         carry_object("/d/obj/cloth/taijicloth")->wear(); 
 } 
  
  
 void attempt_apprentice() 
 { 
         object me; 
         me = this_player(); 
         command("grin"); 
  
         command("say 很好，" + RANK_D->query_respect(me) + 
 "多加努力，他日必定有成。\n"); 
        command("recruit " + me->query("id") ); 
         me->set("class", "xian"); 
         return; 
 } 
  
 int samsara_num()
 {
          object who=this_player();  
         if ((int)who->query("zhuanshi") == 1 ) 
                         { 
                         command("say 若想第二次投胎转世，就去找轮转王吧！");   
                         return 1; 
                         } 
         if ((int)who->query("zhuanshi") == 2 ) 
                         { 
                         command("say 若想第三次投胎转世，就去找地藏王菩萨吧！");   
                         return 1; 
                         } 
         if ((int)who->query("zhuanshi") == 3 ) 
                         { 
                         command("say 失敬！失敬！你永远不会再受那轮回之苦了！");   
                         return 1; 
                         } 
         if ((int)who->query("level") < 500 ) 
                         { 
                         command("say 你的等级不足，还是过些时间再来吧！");   
                         return 1; 
                         } 
         if ((int)who->query("combat_exp") < 200000000 ) 
                         { 
                         command("say 你的武学不足，还是过些时间再来吧！");   
                         return 1; 
                         } 
         if ((int)who->query("daoxing") < 200000000 ) 
                         { 
                         command("say 你的道行不足，还是过些时间再来吧！");   
                         return 1; 
                         } 
/*             if ((int)who->query("shen") < 100 ) 
                         { 
                         command("say 你现在元神太低，进了油锅恐怕就难出来了！");   
                         return 1; 
                           }                        */
         if ((int)who->query("rsg_eaten") < 12 ) 
                         { 
                         command("say 你去多吃些人参果吧，在油锅煎熬的时候能少受些罪！");   
                         return 1; 
                         } 
         if ((int)who->query_skill("force", 1) < 500 ) 
                         { 
                         command("say 你的内功心法修为不够，还是过些时间再来吧！");   
                         return 1; 
                         } 
         if ((int)who->query_skill("spells", 1) < 500 ) 
                         { 
                         command("say 你的基本法术修为不够，还是过些时间再来吧！");   
                         return 1; 
                         } 
         if ((int)who->query_skill("dodge", 1) < 500 ) 
                         { 
                         command("say 你的基本轻功修为不够，还是过些时间再来吧！");   
                         return 1; 
                         } 
         if ((int)who->query_skill("unarmed", 1) < 500 ) 
                         { 
                         command("say 你的扑击格斗之技修为不够，还是过些时间再来吧！");   
                         return 1; 
                         } 
         if ((int)who->query_skill("parry", 1) < 500 ) 
                         { 
                         command("say 你的拆招卸力之法修为不够，还是过些时间再来吧！");   
                         return 1; 
                         } 
         if ((int)who->query_skill("literate", 1) < 500 ) 
                         { 
                         command("say 你的读书识字水平太差，还是过些时间再来吧！");   
                         return 1; 
                         } 
         if (!who->query("obstacle/reward"))  
                         { 
                         command("say 你先去西域求取真经吧！");   
                         return 1; 
                         } 
         if (who->query("dntg/laojunlu")!="done")  
                         { 
                         command("say 无名鼠辈，休得烦我！");   
                         return 1; 
                         }
     if ( !random(5) )  
        {  
        command("over "+who->query("id"));  
        message("channel:rumor",HIB+"\n【"+HIR" 六道轮回 "NOR+HIB"】某人："+who->query

("name")+"一转失败了！\n"+NOR,users() ); 
          who->move("obj/void"); 
          who->start_busy(60); 
        return 1; 
        }  

         return 0;
 }
