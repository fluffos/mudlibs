//puti.c
//inherit NPC;
#include <ansi.h>
inherit "/d/dntg/hell/wang.lpc";
inherit F_MASTER;
int give_zhuanshi();

void create() {
  set_name("都市王", ({ "dushi wang", "wang", "dushi" }));
  set("title", "阴间十王之");
  set("gender", "男性");
  set("class", "xian");
  set("age", 100);
  set("attitude", "friendly");
  set("shen_type", 1);
  set("per", 30);
  set("int", 30 + random(5));
  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);
  set("force", 1150);
  set("max_force", 1000);
  set("force_factor", 35);
  set("max_mana", 1000);
  set("mana", 1000);
  set("mana_factor", 40);
  set("combat_exp", 690000);
  set("daoxing", 500000);

  set_skill("unarmed", 140);
  set_skill("dodge", 140);
  set_skill("parry", 140);
  set_skill("spells", 140);
  set_skill("force", 140);
  set_skill("gouhunshu", 100);
  set_skill("tonsillit", 100);
  map_skill("force", "tonsillit");
  map_skill("spells", "gouhunshu");
  set("inquiry", ([
    //    "转世为人"    :(:give_zhuanshi:),
  ]));

  create_family("阎罗地府", 1, "你好");
  setup();
  carry_object("/d/obj/cloth/mangpao")->wear();
}
int give_zhuanshi() {
  object who = this_player();
  if ((int)who->query("zhuanshi") == 0) {
    command("say 若是初次投胎转世，还是去找王方平吧！");
    return 1;
  }
  if ((int)who->query("zhuanshi") == 2) {
    command("say 若想第三次投胎转世，就去找地藏王菩萨吧！");
    return 1;
  }
  if ((int)who->query("zhuanshi") == 3) {
    command("say 失敬！失敬！你永远不会再受那轮回之苦了！");
    return 1;
  }
  if (who->query_temp("erzhuan") == "xian") {
    command("say 你不是想飞天成仙么？岂能出尔反尔！");
    return 1;
  }
  if (who->query_temp("erzhuan") == "human") {
    command("say 别啰嗦，赶紧去找轮转王吧！");
    return 1;
  }
  if (who->query_temp("erzhuan") == "yao") {
    command("say 你不是想堕入魔道么？岂能出尔反尔！");
    return 1;
  }
  who->set_temp("erzhuan", "human");
  message_vision(HIW "$N伸出右手，罩在$n头顶，刹那间一道白芒没入$n的身体。\n" NOR,
    this_object(), this_player());
  command("say 你这就去找轮转王吧！");
  return 1;
}
