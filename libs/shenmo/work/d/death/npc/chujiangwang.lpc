//puti.c
//inherit NPC;
#include <ansi.h>
inherit "/d/dntg/hell/wang.lpc";
inherit F_MASTER;
int ask_spsk();

void create() {
  set_name("楚江王", ({ "chujiang wang", "wang", "chujiang" }));
  set("title", "阴间十王之");
  set("gender", "男性");
  set("age", 80);
  set("class", "xian");
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("per", 30);
  set("int", 30 + random(5));
  set("max_kee", 900);
  set("max_gin", 900);
  set("max_sen", 900);
  set("force", 1150);
  set("max_force", 1000);
  set("force_factor", 50);
  set("max_mana", 1000);
  set("mana", 1000);
  set("mana_factor", 40);
  set("combat_exp", 720000);
  set("daoxing", 600000);

  set_skill("unarmed", 150);
  set_skill("dodge", 150);
  set_skill("parry", 150);
  set_skill("spells", 150);
  set_skill("force", 150);
  set_skill("gouhunshu", 100);
  set_skill("tonsillit", 100);
  set_skill("ghost-steps", 100);
  set_skill("jinghun-zhang", 120);
  map_skill("unarmed", "jinghun-zhang");
  map_skill("dodge", "ghost-steps");
  map_skill("force", "tonsillit");
  map_skill("spells", "gouhunshu");

  set("inquiry", ([
    "转世特技": (: ask_spsk :),
  ]));
  create_family("阎罗地府", 1, "你好");
  setup();
  carry_object("/d/obj/cloth/mangpao")->wear();

}

int ask_spsk() {
  int i, j, k;
  object who = this_player();

  i = (int)who->query("spsk");
  j = (int)who->query("spskk");
  k = (int)who->query("spskkk");

  if ((int)who->query("zhuanshi") == 0) {
    command("say 你还从未经过转世轮回，何来转世特技？");
    return 1;
  }
  if (i == 1) command("say 你的一转特技是----祥云。");
  if (i == 2) command("say 你的一转特技是----精明。");
  if (i == 3) command("say 你的一转特技是----天赐。");
  if (i == 4) command("say 你的一转特技是----伪善。");
  if (i == 5) command("say 你的一转特技是----回天。");
  if (i == 6) command("say 你的一转特技是----金刚。");
  if (i == 7) command("say 你的一转特技是----无眠。");
  if (i == 8) command("say 你的一转特技是----遁走。");
  if (i == 9) command("say 你的一转特技是----破阵。");
  if (i == 10) command("say 你的一转特技是----乱舞。");
  if (i == 11) command("say 你的一转特技是----飞舞。");
  if (i == 12) command("say 你的一转特技是----逍遥。");
  if (i == 13) command("say 你的一转特技是----神偷。");
  if (i == 14) command("say 你的一转特技是----疾袭。");
  if (i == 15) command("say 你的一转特技是----剑神。");
  if (i == 16) command("say 你的一转特技是----刀皇。");
  if (i == 17) command("say 你的一转特技是----鞭王。");
  if (i == 18) command("say 你的一转特技是----棍霸。");
  if (i == 19) command("say 你的一转特技是----杖仙。");
  if (i == 20) command("say 你的一转特技是----拳圣。");
  if (j == 1) command("say 你的二转特技是----鸿儒。");
  if (j == 2) command("say 你的二转特技是----妙法。");
  if (j == 3) command("say 你的二转特技是----灵动。");
  if (j == 4) command("say 你的二转特技是----驱逐。");
  if (j == 5) command("say 你的二转特技是----禁咒。");
  if (j == 6) command("say 你的二转特技是----奇袭。");
  if (j == 7) command("say 你的二转特技是----连环。");
  if (j == 8) command("say 你的二转特技是----怒发。");
  if (j == 9) command("say 你的二转特技是----养精。");
  if (j == 10) command("say 你的二转特技是----养气。");
  if (j == 11) command("say 你的二转特技是----养神。");
  if (j == 12) command("say 你的二转特技是----慧根。");
  if (j == 13) command("say 你的二转特技是----慧缘。");
  if (j == 14) command("say 你的二转特技是----长生。");
  if (j == 15) command("say 你的二转特技是----皇亲。");
  if (k == 1) command("say 你的三转特技是----神机。");
  if (k == 2) command("say 你的三转特技是----强袭。");
  if (k == 3) command("say 你的三转特技是----无双。");
  if (k == 4) command("say 你的三转特技是----霸道。");
  if (k == 5) command("say 你的三转特技是----勇猛。");
  if (k == 6) command("say 你的三转特技是----封杀。");
  if (k == 7) command("say 你的三转特技是----神气。");
  if (k == 8) command("say 你的三转特技是----威风。");
  if (k == 9) command("say 你的三转特技是----王者。");
  if (k == 10) command("say 你的三转特技是----回春。");

  return 1;
}
