#include <room.h>
inherit ROOM;

void create() {
  set("short", "东厢走廊");
  set("long", @LONG
你走在一条走廊上，东边有几间雅室，人来人往很热闹。西边是大殿。
LONG);
  set("exits", ([
    "east": __DIR__ "donglang2",
    "west": __DIR__ "dadian",
  ]));
  set("objects", ([
    __DIR__ "npc/wuque": 1,
    __DIR__ "npc/tie": 1,
    __DIR__ "npc/shinu": 2,
  ]));
  //        set("no_clean_up", 0);
  setup();
}

int valid_leave(object me, string dir) {
  mapping myfam;
  myfam = (mapping)me->query("family");
  if (!myfam || !mapp(myfam)) return ::valid_leave(me, dir);
  if (myfam["family_name"] && myfam["family_name"] != "移花宫" && dir == "east" &&
    objectp(present("hua wuque", environment(me))))
    return notify_fail("花无缺喝道：你不是移花宫弟子，不得入内。\n");

  return ::valid_leave(me, dir);
}
