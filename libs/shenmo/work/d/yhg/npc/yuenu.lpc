#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create()
{
       set_name("花月奴", ({"hua yuenu", "hua", "yuenu","master"}));
       set("long",
"十八年前和玉面江丰逃跑不幸被移花宫追杀。\n");
       set("gender", "女性");
       set("age", 40);
       set("class", "human");
       set("attitude", "friendly");
       set("per", 30);
       set("int", 30);
       set("max_kee", 6000);
       set("max_gin", 6000);
       set("max_sen", 8000);
       set("force", 4000);
       set("max_force", 4000);
       set("force_factor", 150);
       set("max_mana", 4000);
       set("mana", 4000);
       set("mana_factor", 140);
       set("combat_exp", 4000000);
       set("daoxing", 8000000);
       set("eff_dx", 2000000);
       set("nkgain", 350);
        set_skill("literate", 150);
        set_skill("unarmed", 150);
        set_skill("dodge", 150);
        set_skill("force", 150);
        set_skill("parry", 150);
        set_skill("sword", 150);
        set_skill("spells", 150);
        set_skill("mingyu-jue", 150); 
        set_skill("yihua-jiemu", 150);
        set_skill("yihua-force", 150);
        set_skill("feihua-sword", 150);
        set_skill("feihua-steps", 150);
        map_skill("spells", "yihua-xianfa");
              map_skill("spells", "mingyu-jue"); 
        map_skill("unarmed", "yihua-jiemu");
        map_skill("force", "yihua-force");
        map_skill("sword", "feihua-sword");
        map_skill("parry", "feihua-sword");
        map_skill("dodge", "feihua-steps");
 map_skill("whip", "baihua-whip");
create_family("移花宫", 2, "弟子");
setup();
       carry_object("/d/yhg/obj/cloth")->wear();
   //     carry_object("/d/moon/obj/feijian")->wield();
}
void attempt_apprentice(object ob)
{
       if ( !((string)ob->query("gender")=="女性")){
           command("shake");
           command("say 我们移花宫只收女徒，这位" +
RANK_D->query_respect(ob) + "还是另请高就吧。\n");
           return;}
        if ( (int)ob->query("per") <22){
	  command("shake");
	command("say 以我看这位" +
RANK_D->query_respect(ob) + "的资质并不适于学习，还是另请高就吧。\n");
 	return;
}
       command("pat "+ob->query("id"));
        command("say 好，希望" + RANK_D->query_respect(ob) +
"多加努力，把我们移花宫发扬光大。\n");
        command("recruit " + ob->query("id") );
        message("system", HIY"移花宫又多了一个弟子  "+this_player()->name()+HIW"
                     移花宫的势力加强了。\n"NOR,users());
        return;
}
int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "human");
}
