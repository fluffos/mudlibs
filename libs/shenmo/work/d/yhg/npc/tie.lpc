inherit NPC;
inherit F_MASTER;
int rank_me();
string ask_mieyao();
string ask_cancel();
#include <ansi.h>
#include "/d/panshi/panshi2.h"
void create() {
  set_name(HIG "铁瓶姑" NOR, ({ "tie pinggu", "tie", "pinggu" }));
  set("gender", "女性");
  set("age", 21);
  set("agi", 30);
  set("str", 60);
  set("per", 21);
  set("int", 30);
  set("class", "human");
  set("attitude", "friendly");
  set("max_force", 3000);
  set("force", 3000);
  set("force_factor", 200);
  set("max_mana", 3000);
  set("mana", 3000);
  set("max_atman", 3000);
  set("max_kee", 2000);
  set("max_gin", 2000);
  set("max_sen", 2000);
  set("chat_chance", 30);
  set("long",
    "她在移花宫中专门伺候花无缺少爷的。\n"
  );
  create_family("移花宫", 3, "弟子");
  set("chat_chance_combat", 20);
  set("chat_msg_combat", ({
    (: perform_action, "sword", "feitian" :),
  }));
  set("inquiry", ([
    "杀魔": (: ask_mieyao :),
    //           "cancel": (: ask_cancel :),
    "leave": (: askLeave :),
  ]));
  set("combat_exp", 2300000);
  set("daoxing", 2300000);
  set_skill("literate", 120);
  set_skill("unarmed", 120);
  set_skill("dodge", 120);
  set_skill("force", 140);
  set_skill("parry", 165);
  set_skill("sword", 185);
  set_skill("spells", 145);
  set_skill("blade", 125);
  set_skill("yihua-jiemu", 155);
  set_skill("feihua-sword", 155);
  set_skill("yihua-force", 135);
  set_skill("feihua-steps", 145);
  set_skill("mingyu-jue", 130);
  map_skill("spells", "mingyu-jue");
  map_skill("unarmed", "yihua-jiemu");
  map_skill("force", "yihua-force");
  map_skill("sword", "feihua-sword");
  map_skill("parry", "feihua-sword");
  map_skill("dodge", "feihua-steps");
  //  map_skill("blade", "shenji-blade");
  setup();
  // carry_object(__DIR__"obj/deitysword")->wield();
  //  carry_object(__DIR__"obj/sjcloth")->wear();
}

void init() {
  add_action("doAgree", "agree");
}


string ask_mieyao() {
  object who = this_player();

  if ((string)who->query("family/family_name") == "移花宫") {
    command("smile " + who->query("id"));
    return "/d/obj/mieyao"->query_yao(who);
  }
  return ("非我门人,何故来此?\n");
}
string ask_cancel() {
  object me = this_player();
  if ((int)me->query_temp("m_mieyao")) {
    me->add("daoxing", -2000);
    me->delete_temp("m_mieyao");
    me->delete("secmieyao");
    me->delete("secmieyao/type");
    me->delete("secmieyao/location");
    me->delete("secmieyao/place");
    me->delete("secmieyao/name");
    me->delete("secmieyao/id");
    return ("没用的东西！");
  } else {
    me->delete_temp("m_mieyao");
    return ("你有任务吗？！");
  }
}
