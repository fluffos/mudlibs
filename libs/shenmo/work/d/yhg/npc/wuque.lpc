#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create() {
  set_name("花无缺", ({ "hua wuque", "hua", "wuque", "master" }));
  set("long",
    "十八年前被玉面江丰和其妻花月奴所生双胞胎之一\n被移花宫抱来硬要其杀胞兄小鱼儿。\n");
  set("title", HIW "移花宫少主" NOR);
  set("gender", "男性");
  set("age", 20);
  set("class", "human");
  set("attitude", "friendly");
  set("rank_info/respect", "少爷");
  set("per", 30);
  set("int", 30);
  set("max_kee", 6000);
  set("max_gin", 6000);
  set("max_sen", 8000);
  set("force", 4000);
  set("max_force", 4000);
  set("force_factor", 150);
  set("max_mana", 4000);
  set("mana", 4000);
  set("mana_factor", 140);
  set("combat_exp", 4000000);
  set("daoxing", 8000000);
  set("eff_dx", 2000000);
  set("nkgain", 350);
  set_skill("literate", 250);
  set_skill("unarmed", 250);
  set_skill("dodge", 250);
  set_skill("force", 250);
  set_skill("parry", 250);
  set_skill("sword", 250);
  set_skill("spells", 250);
  set_skill("whip", 250);
  set_skill("baihua-whip", 250);
  set_skill("mingyu-jue", 250);
  set_skill("yihua-jiemu", 250);
  set_skill("yihua-force", 250);
  set_skill("feihua-sword", 250);
  set_skill("feihua-steps", 250);
  map_skill("spells", "yihua-xianfa");
  map_skill("spells", "mingyu-jue");
  map_skill("unarmed", "yihua-jiemu");
  map_skill("force", "yihua-force");
  map_skill("sword", "feihua-sword");
  map_skill("parry", "feihua-sword");
  map_skill("dodge", "feihua-steps");
  map_skill("whip", "baihua-whip");
  create_family("移花宫", 2, "弟子");
  setup();
  carry_object("/d/yhg/obj/cloth")->wear();
  //     carry_object("/d/moon/obj/feijian")->wield();
}
void attempt_apprentice(object ob) {
  if (!((string)ob->query("gender") == "女性")) {
    command("shake");
    command("say 我们移花宫只收女徒，这位" +
      RANK_D->query_respect(ob) + "还是另请高就吧。\n");
    return;
  }
  if ((int)ob->query("per") < 22) {
    command("shake");
    command("say 以我看这位" +
      RANK_D->query_respect(ob) + "的资质并不适于学习，还是另请高就吧。\n");
    return;
  }
  if ((int)ob->query_skill("mingyu-jue", 1) < 149) {
    command("shake");
    command("say 以我看这位" +
      RANK_D->query_respect(ob) + "还是先找其他师傅学吧。\n");
    return;
  }
  command("pat " + ob->query("id"));
  command("say 好，希望" + RANK_D->query_respect(ob) +
    "多加努力，把我们移花宫发扬光大。\n");
  command("recruit " + ob->query("id"));
  message("system", HIY "移花宫又多了一个弟子  " + this_player()->name() + HIW "
                     移花宫的势力加强了。\n" NOR, users());
  return;
}
int recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "human");
}
