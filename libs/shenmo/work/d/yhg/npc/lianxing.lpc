#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string ask_dan(); 
void create()
{
object sword;
       set_name("怜星宫主", ({"lianxing gongzhu", "lianxing", "gongzhu","master"}));
       set("long",
"移花宫执掌人。\n");
       set("title",HIY "移花宫二宫主"NOR);
       set("gender", "女性");
       set("age", 35);
       set("class", "human");
       set("attitude", "friendly");
       set("rank_info/respect", "仙姑");
       set("per", 30);
	set("int", 30);
       set("max_kee", 6000);
       set("max_gin", 6000);
       set("max_sen", 8000);
       set("force", 10000);
       set("max_force", 10000);
       set("force_factor", 250);
       set("max_mana", 10000);
       set("mana", 10000);
       set("mana_factor", 240);
       set("combat_exp", 40000000);
       set("daoxing", 80000000);
       set("eff_dx", 2000000);
       set("nkgain", 350);
        set_skill("literate", 300);
        set_skill("unarmed", 300);
        set_skill("dodge", 300);
        set_skill("force", 300);
        set_skill("parry", 300);
        set_skill("whip", 350);
        set_skill("spells", 300);
              set_skill("mingyu-jue", 300); 
        set_skill("yihua-jiemu", 300);
        set_skill("yihua-force", 300);
        set_skill("baihua-whip", 350);
        set_skill("feihua-steps", 300);
        map_skill("spells", "mingyu-jue");
        map_skill("unarmed", "yihua-jiemu");
        map_skill("force", "yihua-force");
        map_skill("whip", "baihua-whip");
        map_skill("parry", "baihua-whip");
        map_skill("dodge", "feihua-steps");
 create_family("移花宫", 1, "弟子");
set("chat_chance_combat", 50);
       set("chat_msg_combat", ({
                (: perform_action, "whip", "zhuihun" :),
                (: exert_function, "recover" :),
                (: exert_function, "heal" :),
                }) );
 set("inquiry", ([
            "解毒丹" : (:ask_dan:),   
           
]));
setup();

       carry_object("/d/yhg/obj/tianchan")->wear();
            sword = new("/d/yhg/obj/whip"); 
      if ( sword->move(this_object()) ) 
       command("wield all"); 

}
void attempt_apprentice(object ob)
{
       if ( !((string)ob->query("gender")=="女性")){
           command("shake");
           command("say 我们移花宫只收女徒，这位" +
RANK_D->query_respect(ob) + "还是另请高就吧。\n");
           return;}
        if ( (int)ob->query("per") <22){
	  command("shake");
	command("say 以我看这位" +
RANK_D->query_respect(ob) + "的资质并不适于学习，还是另请高就吧。\n");
 	return;
}
 if ( (int)ob->query_skill("mingyu-jue",1) <230){
	  command("shake");
	command("say 以我看这位" +
      RANK_D->query_respect(ob) + "还是过段时间再来吧。\n"); 
 	return;
}
       command("pat "+ob->query("id"));
        command("say 好，希望" + RANK_D->query_respect(ob) +
"多加努力，把我们移花宫发扬光大。\n");
        command("recruit " + ob->query("id") );
        message("system", HIY"移花宫又多了一个弟子  "+this_player()->name()+HIW"
                     移花宫的势力加强了。\n"NOR,users());
        return;
}
int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "human");
}
string ask_dan()   //索要丹
{ 
object dan; 
object ob = this_object(); 
object me = this_player(); 

   if(me->query("family/family_name")!="移花宫") 
   return MAG"你不是我门中人？"NOR; 

  if ( present("jiedu dan",me)||present("dan",me) ) 
          return HIY"你自己有了丹吧！"NOR; 
      
       command("ok "+me->query("id") );
 if ( (string)me->query("gender")=="男性")
     { 
 dan=new("/d/yhg/obj/jiedudan.lpc");
}
else
{
dan=new("/d/yhg/obj/jiedudan.lpc");
}
       dan->move(me);
       message_vision("$N给$n一个"+dan->name()+"。\n",ob,me);
                 
return HIY"上好药材，好好保管。"NOR; 
}



