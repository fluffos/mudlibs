#include <ansi.h>

void die()
{
    object me,victim;
    me=this_object();
    victim = me->query_temp("last_damage_from");
   if( victim )
    {
         victim->add_temp("kill_12_mouse",1);
         if( victim->query_temp("kill_12_mouse",1) >= 12 )
         {
             message_vision(HIY"\n江小鱼在........"NOR,me,victim);
             message_vision(HIY"\n吕...仑...山..."NOR,me,victim);
             message_vision(HIY"\n恶...人...谷..."NOR,me,victim);
             victim->set_temp("can_enter_evil",1);
               }
    }
    ::die();    
}
