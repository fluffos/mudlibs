#include <ansi.h>
#include <weapon.h>
inherit F_UNIQUE;
inherit WHIP;
void create() {
  set_name(HIG "流花鞭" NOR, ({ "liuhua whip", "liuhua", "whip" }));
  set_weight(14000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "一条柔软的鞭子，泛着点点灵光。\n");
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("value", 30000);
    set("material", "crimsonsteel");
    set("wield_msg", "$N冷笑一声，从背后拔出了$n。用灵气一逼，神鞭现身。\n");
    set("unwield_msg", "$N将手中的$n插回腰间，嘴角多了一丝笑意。\n");
  }
  init_whip(200);
  setup();
}
