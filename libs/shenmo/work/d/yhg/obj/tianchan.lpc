inherit EQUIP;
#include <ansi.h>
void create() {
  set_name(HIR "天缠丝" NOR, ({ "tianchan si", "cloth" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 500);
    set("material", "cloth");
    set("armor_type", "cloth");
    set("armor_prop/armor", 120);
    set("armor_prop/spells", 120);
  }
}
