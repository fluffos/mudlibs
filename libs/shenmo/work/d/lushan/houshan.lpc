inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "五老峰后山");
  set("long", @LONG

上顶苍穹，下压鄱湖，削壁千仞，绵延数里，俯视城廓川原，历历在目；
远观则洪湖遥山，相错如绣，仰视五老峰，在绚丽云霞的映照下，铁壁
染翠，丹崖流金，犹如簇簇芙蓉，在云霞之中怒放。如果登临绝顶，朝
下府视，却另有一番景象：那波涛千顷的鄱阳湖，恰似奔来眼底纵横驰
骋的峰壑，顿生五色烟云。

LONG);

  set("exits", ([
    "up": __DIR__ "feiyanbi",
  ]));
  set("outdoors", __DIR__ "");
  set("no_magic", 1);
  setup();
}
