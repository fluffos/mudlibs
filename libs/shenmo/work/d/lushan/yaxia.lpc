inherit ROOM;
#include <ansi.h>

void create ()
{
set ("short", "五老峰下");
set ("long", @LONG

这里是五老峰的龙瀑之下。也就是以前封印冥界一百零八星的所在。
四下里水雾弥漫，只听到四周回荡着瀑布直冲而下的轰鸣之声。

LONG);

set("exits", ([
	"west"		: __DIR__"houshan", //后山
]));
set("objects",([
	__DIR__"npc/chunli" : 1,
]));
set("no_magic",1);
setup();
}

int valid_leave(object me, string dir) 
{
if ( !me->query_temp("chunli/asked") && dir == "west" ) 
	{
	if ( present("zi long",this_object()) )
		return notify_fail("紫龙伸手挡住了你：对不起，后山有客人，不便打扰。\n"); 
	else if ( present("chun li",this_object()) )
		return notify_fail("春丽含笑拦住了你：对不起，后山有客人，不便打扰。\n"); 
	else
		return notify_fail("没得到主人的许可怎可随便乱走？\n"); 
	}
return ::valid_leave(me, dir); 
} 
