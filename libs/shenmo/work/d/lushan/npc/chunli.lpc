#include <ansi.h>
inherit NPC;

void powerup();
int check_player();

string *story_msg = ({
  CYN "$N" CYN "一见眼前这么娇媚的姑娘，也不由心神一荡，一时楞楞的说不出话来。\n" NOR,
  CYN "$n桃花含羞，对着$N" CYN "嘻嘻一笑：这位少侠不知到此何事？\n" NOR,
  CYN "$N" CYN "这才清醒了过来，不禁暗俯：该死。上前拜道：在下$M，奉师命前来拜会女侠。\n" NOR,
  CYN "$n的脸上露出疑惑的表情。\n" NOR,
  CYN "$n说道：我自小在五老峰生长，不曾去过外面，莫非是找错人了？\n" NOR,
  CYN "$N" CYN "道：不会有错的，小的万般打听，方知前辈在此隐居。\n" NOR,
  CYN "$n似乎恍然大悟，捧腹大笑起来。\n" NOR,
  CYN "$n笑道：少侠寻错人了，你找的那个春丽其实并不是小女子。。。\n" NOR,
  CYN "... ... ... ...\n" NOR,
  CYN "$N" CYN "的脸上露出疑惑的表情。\n" NOR,
  CYN "$n笑道：前阵子来了个姑娘也叫春丽，而且受了很重的伤，我和紫龙将她安置在后山了！\n" NOR,
  CYN "$N" CYN "恍然大悟般的“哦”了一声。" NOR,
  CYN "$N" CYN "抱拳道：烦请姑娘带我去见......\n" NOR,
  CYN "$n" CYN "摇头道：那位姑娘特地叮嘱不想见外人，看来也是受了心灵的创伤。\n" NOR,
  CYN "$N" CYN "连忙道：在下正是为此而来，其中原委代我细细道来。。。\n" NOR,
  CYN "... ... ... ...\n" NOR,
  CYN "... ... ... ...\n" NOR,
  CYN "$n恍然大悟般的“哦”了一声。\n" NOR,
  CYN "$n说道：我们在此等待，紫龙一会就来了。\n" NOR,
});

string *story2_msg = ({
  CYN "... ... ... ...\n" NOR,
  CYN "$m走了过来。\n" NOR,
  CYN "$m的脸上露出疑惑的表情。\n" NOR,
  CYN "$n说道：就是这位少侠想找那为春丽姑娘。\n" NOR,
  CYN "$N" CYN "忙上前道：在下乃元武门弟子，奉命前来拜会春丽前辈。\n" NOR,
  CYN "$m恍然大悟般的“哦”了一声。" NOR,
  CYN "$N" CYN "抱拳道：烦请两位了......\n" NOR,
  CYN "$m笑道：我正与那位姑娘谈论此事呢，看来她的心节该由你来解开了。\n" NOR,
  CYN "$N" CYN "连忙道：不敢，在下自当将个中原委仔细道来。\n" NOR,
  CYN "$m点了点头。\n" NOR,
  CYN "$m说道：$n，你去通知下老师，我和这位少侠去后山一趟。\n" NOR,
  CYN "$n点了点，急急忙忙的离开了。\n" NOR,
  CYN "$m回头对$N" CYN "道:少侠随我来。\n" NOR,
  "$N决定开始跟随$m一起行动。\n" NOR,
  CYN "$m向西离开。\n" NOR,
  "\n五老峰后山\n" NOR,
  CYN "$m说道：我就送你到这儿了，那位姑娘就在前面。\n" NOR,
  CYN "$N" CYN "连忙向$m道谢。\n" NOR,
  CYN "$m向东离开。\n" NOR,
});

void create() {
  set_name("春丽", ({ "chun li" }));
  set("long", "由童虎从小抚养长大的中国小姑娘，和紫龙自小青梅竹马，两小无猜。 \n");
  set("gender", "女性");
  set("age", 16);
  set("con", 30);
  set("per", 35);
  set("str", 25);
  set("int", 35);
  set("combat_exp", 10000);

  set_skill("dodge", 60);
  set_skill("parry", 60);
  set_skill("unarmed", 60);

  set("max_force", 300);
  set("force", 600);
  set("max_mana", 300);
  set("mana", 600);
  set("max_kee", 600);
  set("max_gin", 600);
  set("max_sen", 600);

  set("inquiry", ([
    "春丽": (: check_player :),
    "chunli": (: check_player :),
  ]));

  setup();
  carry_object("/d/obj/cloth/skirt")->wear();
}

string story(object me, object ob, string *story) {
  int i;
  string msg, s1, s2, prefix;
  msg = "";

  for (i = 0; i < sizeof(story_msg); i++) {
    msg += story[i];
  }
  //msg=replace_string(msg,"$N",HIY+me->query("name")+NOR);
  //msg=replace_string(msg,"$n",HIY+ob->query("name")+NOR);

  s1 = msg;
  s2 = "";
  prefix = "";
  while (strsrch(s1, "\n\n") != -1)
    s1 = replace_string(s1, "\n\n", "\n");
  if (s1[strlen(s1) - 1] == '\n') {
    s1 = s1[0..strlen(s1) - 2];
    s2 = "\n";
  }
  if (strlen(s1) == 0)
    //        return;
    s1 = replace_string(s1, "\n", "\n" + prefix) + "\n";
  reset_eval_cost();
  return msg;
}

int check_player() {
  int i, num = 0;
  object ob, me, env, *inv;
  string msg, str, *story;
  ob = this_object();
  me = this_player();
  env = environment(ob);
  inv = all_inventory(env);
  story = story_msg;

  if (environment(me) != env)
    msg = "$n摇了摇头。\n";

  else if (!userp(me) || !me->query_temp("lushan/chunli"))
    msg = "$n对着$N摇了摇头。\n";
  else {
    for (i = 0; i < sizeof(inv); i++) {
      if (inv[i] == ob) continue;
      if (inv[i] == me) continue;
      if (!userp(inv[i])) continue;
      num++;
    }
    if (num > 0)
      msg = "$n对着$N摇了摇头：有外人在此，我还是静观其变。\n";
    else
      msg = story(me, ob, story);
  }
  str = me->query("family/master_name");
  str += "弟子";
  msg = replace_string(msg, "$M", str);
  message_vision(msg, me, ob);
  me->set_temp("chunli/asked", 1);
  call_out("story2", 5 + random(5), me, ob, env);
  return 1;
}

void story2(object me, object ob, object env) {
  object npc;
  string msg, *story;
  story = story2_msg;

  npc = find_object("/d/lushan/npc/zilong");
  if (!npc)
    npc = find_living("zi long");
  if (!npc)
    npc = new(__DIR__ "zilong");
  if (environment(me) != env)
    return;
  npc->move(env);
  msg = story(me, ob, story2_msg);
  msg = replace_string(msg, "$m", npc->query("name"));
  message_vision(msg, me, ob);
  me->move("/d/lushan/houshan");
  destruct(npc);
  destruct(ob);
  return;
}

int accept_kill(object who) {
  object ob = this_object();
  message_vision("$n对$N摇了摇头说：" + RANK_D->query_self(ob) + "什么也不会，还是不打了吧。\n", who, ob);
  ob->remove_killer(who);
  who->remove_killer(ob);
  return 1;
}


int accept_fight(object who) {
  object ob = this_object();
  message_vision("$n对$N摇了摇头说：" + RANK_D->query_self(ob) + "什么也不会，还是不打了吧。\n", who, ob);
  ob->remove_killer(who);
  who->remove_killer(ob);
  return 1;
}

void die() {
  string msg;
  object npc;
  object me = this_object();
  object ob = me->query_temp("last_opponent");
  object env = environment(me);
  powerup();
  me->remove_killer(ob);
  ob->remove_killer(me);

  if (environment(me) != env)
    return;
  if (ob->query_temp("chunli/asked"))
    ob->delete_temp("chunli/asked");

  msg = CYN "\n$n委屈的看着$N" CYN "，撅起了小嘴，泪珠开始在眼眶中打转。\n" NOR;
  msg = replace_string(msg, "$N", ob->query("name"));
  msg = replace_string(msg, "$n", me->query("name"));
  tell_room(env, msg);

  npc = find_object("/d/lushan/npc/zilong");
  if (!npc)
    npc = find_living("zi long");
  if (!npc)
    npc = new("zilong");
  message_vision("紫龙从后山跳了出来，大叫：谁敢欺负春丽？！\n", ob, me);
  npc->move(env);
  npc->command("hate");
  npc->kill_ob(ob);
  return;
}

void unconcious() {
  die();
}

void powerup() {
  object me = this_object();
  me->set("kee", query("max_kee"));
  me->set("eff_kee", query("max_kee"));
  me->set("sen", query("max_sen"));
  me->set("eff_sen", query("max_sen"));
  me->set("force", query("max_force"));
  me->set("mana", query("max_mana"));
  me->clean_condition();
  return;
}
