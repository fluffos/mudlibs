//紫龙

#include <ansi.h> 
inherit NPC; 
void powerup();
         
void create() 
{ 
set_name("紫龙", ({"zi long"})); 
set("long", "天龙座的青铜斗士，春丽的男友。\n"); 
set("gender","男性"); 
set("title", HIY"天龙座"CYN"青铜圣斗士"NOR); 
set("age",18); 
set("con",35); 
set("per",34); 
set("str",30); 
set("int",35); 
set("combat_exp",30000000); 
set("daoxing",30000000); 

set_skill("force", 850);
set_skill("parry", 850); 
set_skill("unarmed", 850); 
set_skill("shengdou",850); 
set_skill("stars-steps",850); 

map_skill("parry","shengdou"); 
map_skill("unarmed","shengdou"); 
map_skill("dodge","stars-steps"); 

set("max_force", 30000); 
set("force", 15000); 
set("max_mana",15000); 
set("mana",30000); 
set("mana_factor",660); 
set("force_factor",660); 
set("max_kee", 50000); 
set("max_gin", 50000); 
set("max_sen", 50000); 
setup(); 
carry_object("/d/sds/obj/tl_cloth")->wear(); 
} 
       
int kill_ob(object me)
{  
object ob=this_object();  
int my_max_kee = me->query("max_kee"); 

if( ! me ) return 0;  
if(! present(me,environment()) )  
	return 0;  

switch(random(3)) 
	{         
	case 0: 
		{ 
		message_vision(HIB"\n$N高喊一声：『庐山亢龙霸』，一条恶龙自溅底而出，尾巴向$n扫去！\n",ob,me); 
		if( random(3)==1 ) 
			{ 
			message_vision(HIB"\n$N被恶龙的尾巴甩了个正着，顿时眼冒金星！\n"NOR,me); 
			me->add("kee",-query("max_kee")/10); 
			} 
		else        message_vision(HIB"\n$N身型急转，不知道绕了多少圈才夺过巨龙的攻击！\n"NOR,me);
		} 
	break; 
	case 1: 
		{ 
		message_vision(HIW"$N高喊一声：『庐山百龙霸』，无数只巨龙向$n冲过来！\n"NOR,ob,me); 
		if( random(3)==1 ) 
			{ 
                     message_vision(HIW"$N如一个球一样，被无数只巨龙在空中戏弄着！\n"NOR,me); 
			me->add("eff_kee",-query("max_kee")/20); 
			} 
		else   	message_vision(HIY"$N看准了巨龙之间的空隙，左转右转，才勉强离难！\n"NOR,me); 
		}  
	break; 
	} 
if( random(4)==1 ) 
powerup(); 
remove_call_out("check"); 
call_out("check",2+random(3)); 
} 

void init()  
{  
add_action("do_perform","perform");
add_action("do_none","ji");  
add_action("do_none","burn");  
add_action("do_none","steal");  
add_action("do_none","apply");  
}  

void powerup()
{
object me = this_object();
me->set("kee",query("max_kee"));
me->set("eff_kee",query("max_kee"));
me->set("sen",query("max_sen"));
me->set("eff_sen",query("max_sen"));
me->set("force",query("max_force"));
me->set("mana",query("max_mana"));
me->clean_condition();
return;
}

void die()
{
object me = this_object();
object ob = me->query_temp("last_opponent");
powerup();
me->kill_ob(ob);
return;
}

int do_none()  
{  
message_vision(HIW"$N对$n摇摇头:还是不用诡计的好......\n"NOR,this_object(),this_player() );  
return 1;  
}  

void unconcious()
{
die();
}

int do_perform()
{
if ( random(5)>3 )
	return notify_fail("你刚运起外力，紫龙一声大喝，你吓得忘记了招式！\n");
else return 1;
}

