#include <ansi.h>

inherit NPC;
void powerup();
int check_player();
string *story_msg = ({
  "$N上前作了个揖：这位老先生请了。\n",
  "$n微微睁开双眼，对着$N呵呵一笑：这位小侠所问何事？\n",
  "$N上前一步，道：在下乃是元武门人，乃是奉师上之命，前来拜会春丽女侠。\n",
  "$n惊讶地“啊”了一声。\n",
  "$n说道：春丽乃是老夫自小收养，怎的不知其中居然还有玄机？莫非是找错人了？\n",
  "$N道：不会有错的，小的万般打听，方知春丽前辈在此隐居。\n",
  "$n沉思片刻，道：看来得你们见面方知事情原委。\n",
  "$N闻言大喜：如此甚好，但不知。。。\n",
  "$n拍拍$N$1笑道：不急，先看看你的功夫如何，小徒紫龙这几日正为琐事烦恼，若你修为不够，只怕......\n",
  "$N心中急切，连忙说道：那么在下就得罪了。\n",
  "$N摆好架设，欲与这位传说中的不败老人比上一比！\n",
});

string *msgs = ({
  "山崖", "崖", "悬崖", "峭壁", "龙瀑", "瀑布", "壁",
});

void create() {
  set_name("童虎", ({ "dohko", "tong hu" }));
  set("long", "传说中在庐山五老峰静坐243年的中国神秘老人,天平座。上一代的
黄金圣斗士，负责看管被雅典娜封印的一百零八名冥斗士，并被雅典娜赐予返老还童术。 \n");
  set("gender", "男性");
  set("title", HIW "天秤座" HIY "黄金圣斗士" NOR);
  set("age", 1000);
  set("con", 30);
  set("per", 30);
  set("str", 25);
  set("int", 35);
  set("combat_exp", 40000000);
  set("chat_chance", 2);
  set("chat_msg", ({
    "童虎说道：只有东方才有最好的功夫。\n",
  }));
  set_skill("dodge", 330);
  set_skill("force", 330);
  set_skill("parry", 330);
  set_skill("unarmed", 330);
  set_skill("shengdou", 330);
  set_skill("lushan-quan", 330);
  set_skill("stars-steps", 330);
  set_skill("dragonforce", 330);
  set_skill("seashentong", 330);
  map_skill("parry", "shengdou");
  map_skill("dodge", "stars-steps");
  map_skill("unarmed", "lushan-quan");
  map_skill("spells", "seashentong");
  map_skill("force", "dragonforce");

  set("max_force", 5000);
  set("force", 10000);
  set("max_mana", 5000);
  set("mana", 10000);
  set("mana_factor", 110);
  set("force_factor", 110);
  set("max_kee", 6000);
  set("max_gin", 6000);
  set("max_sen", 6000);

  set("inquiry", ([
    "春丽": (: check_player :),
    "chunli": (: check_player :),
    "name": "老夫便是五老峰的童虎。\n",
    "here": "这里便是老夫修养之地--庐山五老峰。\n",
  ]));

  setup();
  carry_object("/d/obj/cloth/linen")->wear();
}

void next(object me) {
  return;
}

string story(object me, object ob) {
  int i;
  string msg, *limbs, limb, s1, s2, prefix;
  msg = "";
  limbs = me->query("limbs");
  limb = limbs[random(sizeof(limbs))];

  for (i = 0; i < sizeof(story_msg); i++) {
    msg += story_msg[i];
    call_out("next", 2 + random(3), me);
  }
  //msg=replace_string(msg,"$N",HIY+me->query("name")+NOR);
  //msg=replace_string(msg,"$n",HIY+ob->query("name")+NOR);
  msg = replace_string(msg, "$1", limb);

  s1 = msg;
  s2 = "";
  prefix = "";
  while (strsrch(s1, "\n\n") != -1)
    s1 = replace_string(s1, "\n\n", "\n");
  if (s1[strlen(s1) - 1] == '\n') {
    s1 = s1[0..strlen(s1) - 2];
    s2 = "\n";
  }
  if (strlen(s1) == 0)
    //        return;
    s1 = replace_string(s1, "\n", "\n" + prefix) + "\n";
  reset_eval_cost();
  return msg;
}

int check_player() {
  int i, num = 0;
  object ob, me, env, *inv;
  string msg, str;
  ob = this_object();
  me = this_player();
  env = environment(ob);
  inv = all_inventory(env);

  if (environment(me) != env)
    msg = "$n摇了摇头。\n";

  if (!userp(me))
    msg = "$n对着$N摇了摇头。\n";

  if (str = me->query_temp("lushan/jump")) {
    command("nod");
    command("say 你 jump " + str + " 就可了。\n");
    return 1;
  }

  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i] == ob) continue;
    if (inv[i] == me) continue;
    if (!userp(inv[i])) continue;
    num++;
  }
  if (num > 0)
    msg = "$n对着$N摇了摇头：有外人在此，我还是静观其变。\n";
  else
    msg = CYN + story(me, ob) + NOR;
  message_vision(msg, me, ob);
  me->set_temp("lushan/asked", 1);
  return 1;
}

int accept_kill(object who) {
  object ob = this_object();
  message_vision("$n对$N摇了摇头说：老夫静养期间，是不会杀生的。\n", who, ob);
  return 1;
}

void cp_skill(object who) {
  int max_kee, max_sen, max_force, max_mana, wx, skill, armor, damage;
  max_kee = who->query("max_kee");
  max_sen = who->query("max_sen");
  max_force = who->query("max_force");
  max_mana = who->query("max_mana");
  wx = who->query("combat_exp");
  skill = who->query_skill("force");
  skill += who->query_skill("dodge");
  skill /= 2;
  skill = skill * 2 / 3;
  set_skill("dodge", skill);
  set_skill("force", skill);
  set_skill("parry", skill);
  set_skill("unarmed", skill);
  set_skill("shengdou", skill);
  set_skill("lushan-quan", skill);
  set_skill("stars-steps", skill);
  set_skill("dragonforce", skill);
  set_skill("seashentong", skill);

  map_skill("parry", "shengdou");
  map_skill("dodge", "stars-steps");
  map_skill("unarmed", "lushan-quan");
  map_skill("spells", "seashentong");
  map_skill("force", "dragonforce");

  set("combat_exp", wx);
  set("daoxing", wx);
  set("max_kee", max_kee);
  set("kee", max_kee);
  set("eff_kee", max_kee);
  set("max_sen", max_sen);
  set("sen", max_sen);
  set("eff_sen", max_sen);
  set("max_force", max_force);
  set("force", max_force * 2);
  set("max_mana", max_mana);
  set("mana", max_mana * 2);
  armor = who->query_temp("apply/armor");
  if (!armor || armor < 150)
    armor = 150;
  damage = who->query_temp("apply/damage");
  if (!damage || damage < 80)
    damage = 80;
  set_temp("apply/damage", damage);
  set_temp("apply/armor", armor);
  return;
}

int check_result(object me, object ob) {
  string msg;
  int my_max_kee, his_max_kee;

  my_max_kee = me->query("max_kee");
  his_max_kee = ob->query("max_kee");

  if (me->is_fighting()) {
    call_out("check_result", 1, me, ob);
    return 1;
  }

  if (!living(me)
    || (int)me->query("kee") < 10
    || (int)me->query("sen") < 10
    || environment(ob) != environment(me))
    return 1;

  if (((int)me->query("kee") * 100 / (1 + my_max_kee)) <= 50) {
    if (!living(me)
      || (int)me->query("kee") < 1
      || (int)me->query("sen") < 1) return 1;

    message_vision("$N欣慰一笑，连声说道：孺子可造！\n", me);
    if (!ob->query("ghost-spirit")) {
      msg = msgs[random(sizeof(msgs))];
      message_vision("$N捻须笑道：既然如此，我也不阻你了，春丽便在崖下，你 jump " + msg + " 即可见到她了。\n", me);
      ob->set_temp("lushan/jump", msg);
      ob->delete_temp("lushan/asked");
      ob->set_temp("lushan/chunli", 1);
    }
    return 1;
  }
  if (((int)ob->query("kee") * 100 / his_max_kee) <= 50)
    message_vision("$N将$n扶起。\n", me, ob);
  return 1;
}

int accept_fight(object who) {
  object ob = this_object();
  if (who->query("ghost-spirit") || !userp(who) || !who->query_temp("lushan/asked")) {
    message_vision("$n对$N摇了摇头说：老夫静养期间，是不会杀生的。\n", who, ob);
    return 0;
  }
  powerup();
  cp_skill(who);
  ob->save();
  message_vision("$n对$N点了点头：好，我们就比划一下。\n", who, ob);
  remove_call_out("check_result");
  call_out("check_result", 1, ob, who);
  return 1;
}

void die() {
  object me = this_object();
  object ob = me->query_temp("last_opponent");

  powerup();
  me->remove_killer(ob);
  ob->remove_killer(me);
  message_vision("$n哈哈一笑，再次坐在瀑布前。\n", ob, me);
  return;
}

void unconcious() {
  die();
}

void powerup() {
  object me = this_object();
  me->set("kee", query("max_kee"));
  me->set("eff_kee", query("max_kee"));
  me->set("sen", query("max_sen"));
  me->set("eff_sen", query("max_sen"));
  me->set("force", query("max_force"));
  me->set("mana", query("max_mana"));
  me->clean_condition();
  return;
}
