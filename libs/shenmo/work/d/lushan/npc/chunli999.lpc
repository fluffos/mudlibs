#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void resets(object ob);
string story(object me, object ob, string *story);
int rank_me();

string *story_msg = ({
  CYN "$n见有人来，连忙站起身，疑惑的看着$N" CYN "。\n" NOR,
  CYN "$N" CYN "上前拜倒道：家师$M，特命我与前辈学习技法。\n" NOR,
  CYN "$n惊讶道：赤龙...赤龙...他不是去世了吗？\n" NOR,
  CYN "$N" CYN "笑道：那些是传闻而已，师傅只是被困在了紫气山...\n" NOR,
  CYN "$n惊讶地“啊”了一声。\n" NOR,
  CYN "$n连忙追问道：他没事吧？\n" NOR,
  CYN "$N" CYN "笑道：没事，反而机缘巧合，... ... \n" NOR,
  CYN " ... ... ... ... \n" NOR,
  CYN "$n听得心魂未定，手拍胸口道：原来如此，真是好险。\n" NOR,
  CYN "$n想了一下，道：这样吧，你先安心在此修炼，待到我内伤痊愈，便一并去找龙去。\n" NOR,
  CYN "$N" CYN "愉快的答道：好。\n" NOR,
});

void create() {
  set_name("春丽", ({ "chun li" }));
  set("long", "神武门弟子，以飞燕腿著称于世，以为RYU死而隐居于庐山。\n");
  set("title", HIM "神武门·俏燕" NOR);
  set("class", "saint");
  set("gender", "女性");
  set("age", 20);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("per", 40);
  set("max_kee", 5000);
  set("max_gin", 5000);
  set("max_sen", 5000);
  set("force", 1150);
  set("max_force", 6000);
  set("force_factor", 60);
  set("max_mana", 6000);
  set("mana", 12000);
  set("mana_factor", 150);
  set("combat_exp", 50000000);
  set("daoxing", 50000000);


  set_skill("feiyan-cu", 400);
  set_skill("power", 350);
  set_skill("spirit-power", 350);
  set_skill("unarmed", 350);
  set_skill("dodge", 350);
  set_skill("parry", 350);
  set_skill("yuanwu-steps", 300);
  set_skill("spells", 200);
  set_skill("force", 200);

  map_skill("parry", "feiyan-cu");
  map_skill("dodge", "yuanwu-steps");
  map_skill("unarmed", "feiyan-cu");
  map_skill("force", "power");
  map_skill("spells", "spirit-power");

  set("nk_gain", 50000);

  set_temp("apply/armor", 250);
  set_temp("apply/dodge", 550);

  /*
set("chat_chance_combat", 40);
set("chat_msg_combat", ({
//                (: exert_function, "sheqi" :),
//                (: cast_spell, "gouhun" :),
}) );

*/
  set("inquiry", ([
    //"龙": (: ask_ryu :),
    "称号": (: rank_me :),
  ]));
  create_family("格斗家", 2, "女飞侠");
  setup();
  carry_object("/d/obj/cloth/skirt")->wear();
}

int rank_me() {
  string msg;
  object ob = this_object();
  object me = this_player();
  int exp;
  exp = (int)me->query("combat_exp");
  exp /= 10000;

  if (me->query("title") == HIM "神武门" NOR "·" HIY "金飞燕" NOR) {
    command("say 你已经是大弟子了，还来要什么职位?\n"); return 0;
  }

  if ((string)me->query("family/family_name") == "格斗家"
    && me->query("gender") == "女性") {
    if (exp < 10)
      msg = HIW "小飞燕" NOR;
    else if (exp < 100)
      msg = HIM "粉飞燕" NOR;
    else if (exp < 200)
      msg = WHT "俏飞燕" NOR;
    else if (exp < 300)
      msg = HIC "丽飞燕" NOR;
    else if (exp < 800)
      msg = HIW "银飞燕" NOR;
    else
      msg = HIY "金飞燕" NOR;
    me->set("title", HIM "神武门" NOR "·" + msg);
    tell_object(me, "春丽对你说：你可以做" + me->query("title") + "。\n");
    tell_room(
      environment(me),
      "春丽对" + me->query("name") + "说：你可以做" + me->query("title") + "。\n",
      ({ me, me })
    );
    CHANNEL_D->do_channel(
      ob,
      "chat",
      "现授予本门弟子" + me->query("name") + "" + me->query("title") + HIC "一职。恭请各位仙长多加捧场！" NOR
    );
    me->save();
  }
  return 1;
}

void attempt_apprentice(object ob, object me) {
  if (ob->query("family/master_id") == "chun li") {
    command("hmm");
    command("say 好徒儿，加紧练吧。\n");
    return;
  }

  if (ob->query("family/family_name") != "格斗家") {
    command("say 你是什么人，竟然敢愚弄我？！\n");
    kill_ob(ob);
    return;
  }
  if (ob->query("gender") != "女性") {
    command("shy");
    command("say 男女授受不亲，这位" + RANK_D->query_respect(ob) + "还是请回吧。\n");
    return;
  }
  if (ob->query("family/master_id") != "ryu") {
    command("think");
    command("say 你虽然是元武门人，但是不知道你和赤龙大哥熟不熟...\n");
    if (random(3) == 1) {
      ob->command("say 这个...这个...\n");
      return;
    }
  }
  if (ob->query("ghost-spirit")) {
    command("hate");
    command("say 你居然杀三亲，堕入魔道，好！今天我就为龙大哥清理门户！\n");
    kill_ob(ob);
    return;
  }

  if (ob->query("combat_exp") < 10000000) {
    command("say 这位" + RANK_D->query_respect(ob) + "还是再去磨练磨练吧！\n");
    return;
  }
  if (!ob->query_temp("chunli/story")) {
    command("?");
    command("say 你是何人？\n");
    return;
  }
  command("ok");
  message_vision("春丽对$N嘻嘻地笑了几声。\n", ob);
  message_vision("春丽拍拍$N的肩膀说道：以后在这里多用功，迟早有出头的日子！\n", ob);
  command("recruit " + ob->query("id"));
  return;
}

