int accept_fight(object me) {
  command("shake");
  return 0;
}

void init() {
  string msg, *story;
  object me = this_player();
  object ob = this_object();
  object env = environment(ob);

  if (environment(me) != env || env->query("short") != "飞燕洞")
    return;
  if (me->query_temp("chunli/asked")) {
    if (ob->query("story"))
      return;
    story = story_msg;
    msg = story(me, ob, story_msg);
    message_vision(msg, me, ob);
    me->set_temp("chunli/story", 1);
    me->delete_temp("chunli/asked", 1);
    me->save();
    ob->set("story", 1);
    ob->save();
    call_out("resets", 1200, ob);
  }
  return;
}

void resets(object ob) {
  if (ob->query("story"))
    ob->delete("story");
  ob->save();
  remove_call_out("resets");
  return;
}

string story(object me, object ob, string *story) {
  int i;
  string msg, s1, s2, prefix;
  msg = "";

  for (i = 0; i < sizeof(story_msg); i++) {
    msg += story[i];
  }
  //msg=replace_string(msg,"$N",HIY+me->query("name")+NOR);
  //msg=replace_string(msg,"$n",HIY+ob->query("name")+NOR);

  s1 = msg;
  s2 = "";
  prefix = "";
  while (strsrch(s1, "\n\n") != -1)
    s1 = replace_string(s1, "\n\n", "\n");
  if (s1[strlen(s1) - 1] == '\n') {
    s1 = s1[0..strlen(s1) - 2];
    s2 = "\n";
  }
  if (strlen(s1) == 0)
    //        return;
    s1 = replace_string(s1, "\n", "\n" + prefix) + "\n";
  reset_eval_cost();
  return msg;
}
