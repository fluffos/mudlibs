inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "飞燕洞前");
  set("long", @LONG

走到这里，视野一下子变得开阔起来。正前方是一个高耸入云的大石壁
(shi bi)。
四下里云雾弥漫，仿佛人间仙境一般，无数只可爱的飞燕在身旁掠过，
带动云雾荡逸。

LONG);

  set("exits", ([
    "enter": __DIR__ "feiyandong",
    "down": __DIR__ "houshan",
  ]));

  set("item_desc", ([
    "shi bi": @TEXT
高耸入云的一块大石壁，浑然天成。上书三个大字：

			飞
			
			燕
	
			壁
 
TEXT ]));
  set("outdoors", __DIR__ "");
  set("no_magic", 1);
  setup();
}
