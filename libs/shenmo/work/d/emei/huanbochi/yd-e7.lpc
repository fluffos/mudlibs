#include <ansi.h>
inherit __DIR__ "r.lpc";

void create_room() {
  set("short", "甬道");
  set("long", @LONG
一条狭长的甬道，四壁发出微弱的青光。
LONG);
  set("exits", ([
    "south": __DIR__ "liandan-shi",
    "northwest": __DIR__ "yd-e8",
  ]));
}

void reset() {
  ::reset();
  set("num", 1);
}

int valid_leave(object who, string dir) {
  string str, *msg;
  int k;
  object dao, item;
  if (!userp(who))
    return ::valid_leave(who, dir);
  dao = present("yao dao");
  if (dao && !dao->is_huanbo())
    return notify_fail(dao->query("name") + "拦住了你的去路。\n");
  if (dir == "northwest"
    && query("num") > 0) {
    dao = new(__DIR__ "npc/yaodao5");
    if (!dao->copy_data(who)) {
      destruct(dao);
      return ::valid_leave(who, dir);
    }
    dao->move(__DIR__ "yd-e9");
    message_vision("$N晃晃悠悠的走了过来。\n", dao);
    item = present("shi xiang", environment(dao));
    message_vision("$N挠了挠头，急急忙忙的离开了。\n", dao);
    if (!item || base_name(item) != "/d/emei/huanbochi/obj/shixiang-e9") {
      destruct(dao);
      return ::valid_leave(who, dir);
    }
    k = item->query("ture");
    switch (k) {
      case 1: msg = ({ "沉香亭北倚栏杆", "北风卷地白草折", "征人蓟北空回首", }); break;
      case 2: msg = ({ "支离东北风尘际", "汉家烟尘在东北", }); break;
      case 3: msg = ({ "东风吹马耳", "东风无力百花残", "东望都门信马归", "东风不与周郎便", }); break;
      case 4: msg = ({ "孔雀东南飞", "东南断绝无粮道", "对此欲倒东南倾", }); break;
      case 5: msg = ({ "淮南鸡犬", "正是江南好风景", "庐山秀出南斗傍", "南浦清江万里桥", }); break;
      case 6: msg = ({ "千乘万骑西南行", "何处西南任好风", "飘泊西南天地间", }); break;
      case 7: msg = ({ "何当共剪西窗烛", "问君西游何时还", "西出都门百余里", }); break;
      case 8: msg = ({ "西北望，射天狼", "西北有高楼", }); break;
      default:
        {
          destruct(dao);
          return ::valid_leave(who, dir);
        }
    }
    str = msg[random(sizeof(msg))];
    dao->set("code", str);
    dao->move(this_object());
    dao->kill_ob(who);
    this_object()->set("num", 0);
    return 2;
  }
  return ::valid_leave(who, dir);
}
