#include <ansi.h>
#include <room.h>
inherit __DIR__"r.lpc";

protected string fire_msg()
{
        string *msg = ({
                "四壁之上喷出金蛇般的火舌，",
                "四下里火气大涨，",
                "一股热浪扑面而来，",
        });
        string *msg2 = ({
                "$N的头发冒起一股青烟！\n",
                "$N身上滋滋作响！\n",
                "$N的脸上膨起几个大水疱！\n",
                "$N发出一股焦味！\n"
        });
        return msg[random(sizeof(msg))]+msg2[random(sizeof(msg2))];
}                       

protected string random_exit()
{
        return sprintf(__DIR__"huo%d",1+random(3));
}       

protected string random_exit2()
{
        return sprintf(__DIR__"huo%d",1+random(4));
}       

void env_wuxing_hit(object who)
{
        ::env_wuxing_hit(who);
        if( who && objectp(who) && living(who)
         && present(who,this_object()) )
        {
                if( who->query("water")<=0 )
                        return;
                if( random(3) )
                {
                        if( who->query("water")>50 )
                                who->add("water",-50 );
                        else    who->set("water",0);    
                        tell_object(who,"你只觉得一阵阵的口干舌燥。\n");
                }
        }                       
}

