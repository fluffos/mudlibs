#include <ansi.h>
#include <room.h>
inherit __DIR__"r.lpc";

void create_room()
{
        set("short","东洞复壁秘径");
        set("long",@LONG
这里宽窄大小高低均不一律。入口一段，宛如一条极高的夹
壁巷，宽仅七尺，内里雾气浓密，一望沉冥。
    初上路时，只觉出暗影中含有一种奇怪力量，上下前后
都有吸力，将人抵住，无论进退，俱有阻滞，去不多远，渐
觉身后和上下两方吸力加重，越往前越厉害。
    地势也突易升为降，骤然下落数十百丈。
LONG);  
        set("exits",([
                "north" : __DIR__"mijing-e2",
        ]));    
}

        
