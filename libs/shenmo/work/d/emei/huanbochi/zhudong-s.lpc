#include <ansi.h>
inherit __DIR__"r.lpc";

void create_room()
{
        set("short","南洞主洞");
        set("long",@LONG
这里是一个极高大的石洞，正当中有一盏倒挂的大灯，
灯形颇似一人心，由一缕银丝系住，从顶上垂将下来，上面
发出七朵星形的火光，赤焰熊熊，照得合洞通红。
    灯下面是个百亩方圆，形如莲花的水池，深约三尺，清
可见底。内外石色俱是红的，水色俱是青碧. 池中所贮，并
非真水，乃是石髓。
    上面所悬心灯之火，便是吸取此髓而发。发出来的火焰，
又彼此池吸收了去。如此循环不息，亘古常明。
    灯上面洞顶便是万流总汇。
LONG);  
        set("exits",([
                "west" : __DIR__"yd-s3",
                "east" : __DIR__"cemen-s",
                "north": __DIR__"nandong-damen2",
        ]));    
}

void quest2(object who)
{
        string str;
        object npc;
        remove_call_out("quest2");
        if( !who || !present(who) )
                return;
        npc = present("hu xian");
        if( !npc || userp(npc) )        
        {
                npc = find_living("胡贤");
                if( !npc || !environment(npc) )
                        return;
                npc->move(this_object());
                message_vision("阴风一闪，从洞底深处飞出一位丑陋汉子。\n",who);
        }               
        message_vision(CYN"$N"CYN"呵呵地傻笑了几声。\n"NOR,npc);
        if( present("yin si niang") )
                message_vision(CYN"胡贤对阴四娘说道：无甚事要，还不随我去逍遥快活？\n"NOR,who);
        else    message_vision(CYN"胡贤说道：小娘子又跑到哪里风流快活去了？\n"NOR,who); 
        message_vision(CYN"胡贤对着$N"CYN"惊讶地“啊”了一声。\n"NOR,who);
        if( who->query("gender")!="女性" )
        {
                if( who->query("per")<25 )
                        str = "丑汉子";
                else    str = "小白脸"; 
                if( present("yin si niang") )
                        message_vision(CYN"胡贤将指节咔地一捏，伸手在阴四娘的歪脑门上敲了一个双响脆毛栗子。\n"NOR,who);
                message_vision(CYN"胡贤说道：你这"+str+"莫非是那贼婆娘的面首？！留你不得！！\n"NOR,who);
        }
        else
        {
                if( who->query("per")<25 )
                        str = "好一个婆娘，虽面目可憎，不过聊胜于无，";
                else    str = "好一个美人儿，雪白粉嫩，";       
                if( present("yin si niang") )
                        message_vision(CYN"胡贤看着阴四娘，激动得泣不成声：真的，我不是一个多愁善感的人。。。\n"NOR,who);
                message_vision(CYN"胡贤看着$N"CYN"说道："+str+"拿将回去好自风流一番。\n"NOR,who);      
        }
        npc->copy_data(who);
        npc->kill_ob(who);
}

void quest(object who)
{
        string str;
        object npc;
        remove_call_out("quest");
        if( !who || !present(who) )
                return;
        npc = present("yin si niang");
        if( !npc || userp(npc) )        
        {
                npc = find_living("阴四娘");
                if( !npc || !environment(npc) )
                        return;
                npc->move(this_object());
                message_vision("阴风一闪，但见从洞底深处飞出一位寸缕未着、身白如玉的美娇娃。\n",who);
        }               
        message_vision(CYN"$N"CYN"对着$n"CYN"咯咯地笑着。\n"NOR,npc,who);
        if( who->query("gender")!="女性" )
        {
                if( who->query("per")<25 )
                        str = "兀那汉子";
                else    str = "这位英俊小哥";   
                message_vision(CYN"阴四娘说道："+str+"拿回去正好用元津真阳滋养本姑娘的天魔吸髓之法。\n"NOR,who);
        }
        else
        {
                if( who->query("per")<25 )
                        str = "丑婆娘";
                else    str = "美人儿"; 
                message_vision(CYN"阴四娘说道："+str+"拿回去给那老鬼享用享用。\n"NOR,who);      
        }
        npc->copy_data(who);
        npc->kill_ob(who);
        remove_call_out("quest2");
        call_out("quest2",3+random(5),who);
}                       

void init()
{
        object me = this_player();
        ::init();
        if( userp(me) )
        {
                remove_call_out("quest");
                call_out("quest",3+random(5),me);
        }
}

int valid_leave(object who,string dir)
{
        if( userp(who) && !who->query("huanbochi/yinsiniang") )
                return notify_fail("你感觉什么地方不对劲，你有点疑神疑鬼。\n山洞深处隐约传来一阵妇人呻吟之声。\n");
        if( userp(who) && !who->query("huanbochi/huxian") )
                return notify_fail("你感觉什么地方不对劲，你有点疑神疑鬼。\n山洞深处隐约传来一阵男子喘气之声。\n");
        return ::valid_leave(who,dir);
}       
