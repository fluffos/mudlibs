#include <ansi.h>
inherit __DIR__ "r.lpc";

void create_room() {
  set("short", "东洞复壁秘径");
  set("long", @LONG
这里宽窄大小高低均不一律。入口一段，宛如一条极高的夹
壁巷，宽仅七尺，内里雾气浓密，一望沉冥。
    初上路时，只觉出暗影中含有一种奇怪力量，上下前后
都有吸力，将人抵住，无论进退，俱有阻滞，去不多远，渐
觉身后和上下两方吸力加重，越往前越厉害。
    地势也突易升为降，骤然下落数十百丈。
LONG);
  set("exits", ([
    "west": __DIR__ "yd-z1",
    "up": __DIR__ "mijing-e2",
  ]));
}

int valid_leave(object who, string dir) {
  int damage;
  string msg;
  object fb;
  if (userp(who) && dir == "west") {
    if (who->query_temp("huanbo/mj-fire") >= 3)
      return ::valid_leave(who, dir);
    else if (who->query_temp("huanbo/mj-fire") == 2) {
      message_vision("烈火刚刚下去，吃罡风一吹一卷，倏地由分而合，化作碗钵大小
的火球，似雹雨一般，重又夹攻上来。\n", who);
      if (!who->query_temp("huanbo/mj-fire-damage") == 0)
        who->set_temp("huanbo/mj-fire-damage", 100);
      damage = query_temp("huanbo/mj-fire-damage");
      fb = who->query_temp("armor/FABAO");
      if (!fb) {
        msg = COMBAT_D->damage_msg(100, "瘀伤");
        msg = replace_string(msg, "$n", "$N");
        msg = replace_string(msg, "$l", "全身");
        message_vision(msg, who);
        who->receive_wound("kee", 150);
        who->receive_damage("kee", 150);
        return notify_fail("你吃痛不已，慌忙翻身在地，将身上的火熄灭。\n");
      }
      damage = fb->protect_qi(100, "火");
      who->set_temp("huanbo/mj-fire-damage", damage);
      if (random(damage) < 20) {
        who->add_temp("huanbo/mj-fire", 1);
        who->delete_temp("huanbo/mj-fire-damage");
        return notify_fail("这禁制吃法宝一挡，立化作震天价的霹雳，纷纷爆炸。
趁着这空档赶紧快走。\n");
      } else return notify_fail("这禁制吃法宝一挡，威力顿时锐减。\n");
    } else if (who->query_temp("huanbo/mj-fire") == 1) {
      who->add_temp("huanbo/mj-fire", 1);
      return notify_fail("那火阻不住敌人，似极震怒，轰的一声大震过处，火势忽似狂
潮一般卷退下去，随起了极猛烈的罡风。\n");
    } else {
      who->add_temp("huanbo/mj-fire", 1);
      return notify_fail("前途暗雾影中，似有豆大一粒火星闪了一闪，那前后左右的浓
雾，好似一片油海遇火，当时一齐燃烧，化为无边火海，火浪
千层。\n");
    }
  } else return ::valid_leave(who, dir);
}
