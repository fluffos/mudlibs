#include <ansi.h>
inherit __DIR__"r.lpc";

void create_room()
{
        set("short","甬道");
        set("long",@LONG
这一带甬路本是又高又窄，忽然接连两个转折过去，
地势突往上高起了数十丈。
LONG);  
        set("exits",([
                "east" : __DIR__"yd-z2",
                "west" : __DIR__"yd-z4",
        ]));
}

void reset()
{
        ::reset();
        set("num",2+random(2));
}

int valid_leave(object who,string dir)
{
        object moon;
        if( who->is_fighting() )
                return notify_fail("
你战罢多时，感觉力不从心，想要扯呼，奈何对方苦苦相逼，
挡住了道路。\n\n");
        
        if( userp(who) )
        {
                if( query("num")>=1 )
                {
                        moon = new(__DIR__"npc/yaodao3");
                        if( !moon->copy_data(who) )     
                        {
                                destruct(moon);
                                return notify_fail("甬道深处传来一阵脚步声。。。\n");
                        }
                        moon->move(this_object());
                        moon->kill_ob(who);
                        who->fight_ob(moon);
                        return notify_fail("你无奈停住脚步，安心迎战。\n");
                }
                return ::valid_leave(who,dir);
        }
        return ::valid_leave(who,dir);
}       
