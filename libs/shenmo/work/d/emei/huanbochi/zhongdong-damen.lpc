#include <ansi.h>
#include <room.h>
inherit __DIR__ "r.lpc";

void create_room() {
  set("short", "中洞宫门");
  set("long", @LONG
此处乃是一座圆顶形的宫门外面，门作青色，紧闭未开。
门外地势高起，上有钟乳四垂，宛如天花宝盖，缨珞垂珠，
光怪陆离，幻彩流辉。下有数十处大小喷泉，雪洒珠飞，声
若呜玉。通体石色，宛如翠玉，精莹朗润，净如晶冰，景绝
清奇。那门看去本是一片整玉，仅具门形，当中有一圆圈。
LONG);
  set("exits", ([
    "down": __DIR__ "xuedi",
    "north": __DIR__ "yd-s12",
    "south": __DIR__ "zhudong-z",
  ]));
  create_door("south", "宫门", "north", DOOR_CLOSED);
  set("wuxing", "金");
  set("damage", 1200);
  set("damage_msg", HIY "\n只见半空金气大胜，阵法轰鸣，不多时便撒下万千金针，宛如瓢泼！\n" NOR);
  set("no_lianhua", 1);
  set("death_msg", "在幻波池西门「万精金针大阵」中化为齑粉！\n");
  set("hits", 3);
}
