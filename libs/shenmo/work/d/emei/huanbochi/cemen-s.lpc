#include <ansi.h>
#include <room.h>
inherit __DIR__"r.lpc";

void create_room()
{
        set("short","侧门");
        set("long",@LONG
这是南洞主洞的侧门。
LONG);  
        set("exits",([
                "west" : __DIR__"zhudong-s",
                "east" : __DIR__"yd-s4",
        ]));    
        create_door("east", "石壁", "west", DOOR_CLOSED);       
}

void guanmen()
{
        close_door("east");
}

void kaimen(object zhou,object who)
{
        remove_call_out("kaimen");
        if( !zhou || !who || !present(zhou,this_object()) 
         || environment(zhou)!=environment(who) )
                return;
        if( !who->query("huanbochi/yinsiniang")
         || !who->query("huanbochi/huxian") )
                return;                         
        if( open_door("east") )
        {
                message_vision(HIC"\n$N"HIC"念动真言，抬手在石壁上一按，一旁「轰隆」一声，立现一道小门！\n"NOR,zhou);
                call_out("guanmen",5+random(6));
        }       
}                        

void init()
{
        object who,me = this_player();
        ::init();
        if( !userp(me) 
         && me->query("id")=="zhou qing yun" )
        {
                who = me->query("owner");
                if( !who )
                        return;
                if( !present(who,this_object()) )
                        return;
                me->set_leader(who);
                call_out("kaimen",5,me,who);
        }
}
