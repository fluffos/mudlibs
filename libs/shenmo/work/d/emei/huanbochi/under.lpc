#include <ansi.h>
inherit __DIR__ "r.lpc";

int valid_leave(object who, string dir) {
  object npc;
  if (userp(who) && !who->is_fighting()) {
    if (random(who->query_temp("huanbochi/lg_kill")) < 4
      && who->query_temp("huanbochi/lg_kill") < 8) {
      who->start_busy(1 + random(2));
      npc = new(__DIR__ "npc/yaodao6");
      if (npc->copy_data(who)) {
        if (npc->move(this_object())) {
          tell_room(this_object(), "水波翻滚，从水底窜出一条鱼怪！\n\n");
          npc->kill_ob(who);
          return 2;
        } else destruct(npc);
      } else destruct(npc);
      return notify_fail("你走了片刻，感觉有些累了，不由停下脚步歇了歇。\n");
    }
  }
  return ::valid_leave(who, dir);
}
