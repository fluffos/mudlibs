//这里可以改成可以炼丹的地方
#include <ansi.h>
inherit __DIR__"r.lpc";

void create_room()
{
        set("short","炼丹室");
        set("long",@LONG
这里是一个低窄的石室，四壁平滑细腻，宛如美玉，乃一间
设有丹台炉鼎的石室，陈列器皿，极为古雅精良。
LONG);  
        set("exits",([
                "west"  : __DIR__"zhudong-e2",
                "north" : __DIR__"yd-e7",
        ]));    
}

int valid_leave(object who,string dir)
{
        if( userp(who) && dir=="north" )
        {
                if( !who->query("huanbochi/pingfeng-save")  
                 || !who->query_temp("huanbochi/yuanling") 
                 || !who->query_temp("huanbochi/jintouxian") )
                        return notify_fail("忽听一个少女喝道：“来人慎行，免遭不测！”\n");
        }
        return ::valid_leave(who,dir);
}

        
