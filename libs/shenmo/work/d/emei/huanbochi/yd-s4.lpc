#include <ansi.h>
#include <room.h>
inherit __DIR__"r.lpc";

void create_room()
{
        set("short","甬道");
        set("long",@LONG
一条孔道，里面酷寒阴森，黑沉沉的，只是一片浓影。
LONG);  
        set("exits",([
                "west" : __DIR__"cemen-s",
                "east" : __DIR__"yd-s5",
        ]));    
        create_door("west", "石壁", "east", DOOR_CLOSED);       
        set("wuxing","火");
        set("damage",500);
        set("damage_msg",HIR"\n半空忽发长吟之音，顿时弥天极地的红光扑面而来！\n"NOR);
        set("no_lianhua",1);
        set("death_msg","在幻波池「八荒玄火阵」中化作焦炭！\n");        
        set("hits",3);
        set("num",2);
        
}

void guanmen()
{
        close_door("west");
}

void kaimen(object zhou,object who)
{
        remove_call_out("kaimen");
        if( !zhou || !who || !present(zhou,this_object()) 
         || environment(zhou)!=environment(who) )
                return;
        if( open_door("west") )
        {
                message_vision(HIC"\n$N"HIC"念动真言，抬手在石壁上一按，一旁「轰隆」一声，立现一道小门！\n"NOR,zhou);
                call_out("guanmen",5+random(6));
        }       
}

void init()
{
        object who,me = this_player();
        ::init();
        if( !userp(me) 
         && me->query("id")=="zhou qing yun" )
        {
                who = me->query("owner");
                if( !who )
                        return;
                if( !present(who,this_object()) )
                        return;
                me->set_leader(who);
                call_out("kaimen",5,me,who);
        }
}

int valid_leave(object who,string dir)
{
        object dao;
        if( userp(who) && dir=="east" && query("num")>=1 )
        {
                add("num",-1);
                dao = new(__DIR__"npc/yaodao");
                dao->move(this_object());
                dao->copy_data(who);
                message_vision("一道妖风卷来，从中杀出一名魔教弟子。\n",who);
                dao->kill_ob(who);
                return notify_fail("\n");
        }
        return ::valid_leave(who,dir);
}       

void reset()
{
        set("num",2);
        ::reset();
}       
        
