#include <ansi.h>
inherit __DIR__"r.lpc";

void create_room()
{
        set("short","东洞复壁秘径");
        set("long",@LONG
这里宽窄大小高低均不一律。入口一段，宛如一条极高的夹
壁巷，宽仅七尺，内里雾气浓密，一望沉冥。
    初上路时，只觉出暗影中含有一种奇怪力量，上下前后
都有吸力，将人抵住，无论进退，俱有阻滞，去不多远，渐
觉身后和上下两方吸力加重，越往前越厉害。
    地势也突易升为降，骤然下落数十百丈。
LONG);  
        set("exits",([
                "down"  : __DIR__"mijing-e3",
                "west"  : __DIR__"yd-e21", 
                "south" : __DIR__"mijing-e1",
        ]));
}

void reset()
{
        ::reset();
        if( time()>=query("last_break")+30 )
                set("no_look",1);
}

void init()
{
        int k;
        object npc,me = this_player();
        ::init();
        if( userp(me) )
        {
                npc = present("zhou qing yun");
                if( npc==me->query_temp("huanbo/zhouqingyun")
                 && living(npc) )
                        npc->set_leader(me);
                npc = present("yi jing");
                if( npc==me->query_temp("huanbo/yj")
                 && living(npc) )
                        npc->set_leader(me);
                npc = present("li ying qiong");
                if( npc==me->query_temp("huanbo/lyq")
                 && living(npc) )
                        npc->set_leader(me);
        }
        if( userp(me) && me->query_temp("huanbo/jiguan_flag")>=3 )
        {
                set("no_look",0);
                set("last_break",time());
                tell_object(me,HIY"你已成功破去了风雷火三处禁制。\n"NOR);
                me->delete_temp("huanbo/jiguan_flag");
                if( !me->query("huanbochi/flh_jiguan") )
                {
                        k = 1+random(5);
                        tell_object(me,HIY"你得到了"+chinese_number(k)+"点神数的奖励。\n"NOR);
                        me->add("shen",k);
                        me->set("huanbochi/flh_jiguan",1);      
                }
        }       
}

int valid_leave(object who,string dir)
{
        object npc;
        if( dir!="south" && query("no_look") )
        {
                if( !userp(who) )
                        return 0;
                tell_object(who,"一股浓郁厚实的迷雾挡住了你的去路。\n");
                npc = who->query_temp("huanbo/zhouqingyun");
                if( npc && present(npc) && living(npc) 
                 && !userp(npc) )
                        npc->move(__DIR__"miwu1",2);                    
                npc = who->query_temp("huanbo/yj");
                if( npc && present(npc) && living(npc) 
                 && !userp(npc) )
                        npc->move(__DIR__"miwu1",2);                    
                npc = who->query_temp("huanbo/lyq");
                if( npc && present(npc) && living(npc) 
                 && !userp(npc) )
                        npc->move(__DIR__"miwu1",2);                    
                who->move(__DIR__"miwu1",2);                    
                return 2;
        }
        return ::valid_leave(who,dir);
}       


