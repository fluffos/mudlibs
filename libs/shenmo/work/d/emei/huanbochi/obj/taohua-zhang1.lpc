#include <ansi.h>
#include <combat.h>
inherit ITEM;

void create()
{
        set_name(HIR"五云桃花瘴"NOR, ({ "wuyun taohua zhang", "taohua zhang","zhang","fabao" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("level",420);
                set("value", 0);
                set("material", "shuijing");
                set("long", "阴四娘修炼的法宝之一，乃南疆卑湿污秽沼泽中千万年阴毒之气凝结而成，自经苦心收集，炼成以后，威力更大。\n");
                set("series_no",4);
                set("damage",700);
                set("no_steal",1);
                set("class","邪");
                set("wuxing","火"); 
                set("no_busy",1);                              
        }
        setup();
}

void end_ji()
{
        delete("is_ji");
        set("last_ji",time());
        if( environment() )
                message_vision(HIR+query("name")+HIR"在半空盘旋片刻之后，又自动飞了回去。\n"NOR,environment());
}               

void ding_ob(object me,object target,int t)
{
        int xk,damage;
        string wx;
        object fb,zhou;
        remove_call_out("ding_ob");
        if( !me || !target || !present(this_object(),me)
         || !query("is_ji") || !living(me)
         || !me->is_fighting(target) || t<=0 )
        {
                end_ji();
                return;
        }  
        if( t>=3 )
        {
                zhou = present("zhou qing yun",environment(me));
                if( zhou && !userp(zhou) )
                {
                        message_vision(HIC"$N"HIC"独手一扬，一片玄雾夹着数十点酒杯大小晶莹奇亮的青色精光，当先飞起，
迎着血焰只一裹，那数十点青光便纷纷爆裂开来，声甚清脆，不似雷声猛烈。
每有一点爆散，便化为百千青色光芒，雨箭一般四下飞射，光却强烈。那血
焰红雾立即燃烧，化为暗赤色的浓烟，四下飞散。    \n"NOR,zhou);
                        end_ji();
                        return;         
                }
        }
        damage = query("damage");
        damage = damage/2+random(damage);
        message_vision(HIR"\n只见一道带有五色火花的红光朝着$N"HIR"飞射而来，宛如连珠霹雳！\n"NOR,target);
        fb = target->query_temp("armor/FABAO");
        if( fb )
        {
                if( fb->fabao_ke(this_object()) )
                {
                        end_ji();
                        return;
                }
                else    damage = fb->protect_qi(damage);
        }
        if( wx=query("wuxing") )
        {       
                xk = SPELL_D->wuxing_xs(SPELL_D->query_time_wuxing(),wx);
                if( xk==1 )
                        damage = damage/2;
                else if( xk==-1 )
                        damage+= damage/3;
        }                       
        if( damage>0 )
        {                                               
                target->receive_wound("kee",damage,me);
                COMBAT_D->report_status(target,1);
        }
        t = t-1;
        call_out("ding_ob",1+random(3),me,target,t);
}                       

int ji(string id)
{
        int t,ap,dp;
        object target,me;
        me = environment();
        if( !me || !living(me) )
                return 0;
        if( me->query("mana")<query("level")*2 )
                return notify_fail("你的法力不足。\n");
        if( !me->is_fighting() )
                return notify_fail("你要对谁祭法宝？\n");
        if( me->query("level")<query("level") )
                return notify_fail("你等级不够"+query("level")+"，祭不起"+query("name")+"。\n");
        if( time()<query("last_ji")+5 )
                return notify_fail(query("name")+"刚刚祭出过。\n");     
        if( query("is_ji") )
                return notify_fail(query("name")+"已经祭出了。\n");                                    
        if( id )
        {
                target = present(id, environment(me));
                if( !target )
                        return notify_fail("这里没有"+id+"。\n");
        }
        else    target = SSERVER->offensive_target(me);
        if( !target || !me->is_fighting(target) )
                return notify_fail("你要对谁祭"+query("name")+"？\n");
        
        set("last_ji",time());  
        ap = me->query("daoxing")/100000+me->query("level")*1000;
        dp = target->query("daoxing")/100000+target->query("level")*1000;       

        if( me->query("env/no_msg") || target->query("env/no_msg") )
                message_vision(YEL"$N"YEL"对$n"YEL"使用了法宝「"HIY+query("name")+NOR YEL"」。\n"NOR,me,target);
        else    message_vision(HIR"$N"HIR"手一扬，首先飞出两团血焰红雾，脱手展开暴胀，潮涌一般
朝$n"HIR"身前飞来，还未近身，便觉血腥奇秽之气刺鼻难耐。\n"NOR,me,target);
        me->add("mana",-query("level")*2);
        if( random(100)>dp/(ap+dp)*90 )
        {
                set("is_ji",1);
                t = me->query_skill("spells")/5;
                if( t<30 ) t = 30;
                if( t>120 ) t = 120;
                remove_call_out("ding_ob");
                call_out("ding_ob",1,me,target,t);
        }
        else    
        {
                message_vision(HIC"$N"HIC"哼！了一声：米粒之珠，也放光华？说罢，将手一指，结果血光大盛，"+query("name")+HIC"发出一声哀鸣，从半空落了下来。\n"NOR,target);
                set("last_ji",time()+10);
        }
        return 1;
}               
                                

