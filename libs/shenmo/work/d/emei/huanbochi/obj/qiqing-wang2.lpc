#include <ansi.h>
inherit ITEM;

void create() {
  set_name(NOR YEL "七情网" NOR, ({ "qiqing wang", "wang", "fabao" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("level", 50);
    set("value", 0);
    set("material", "shuijing");
    set("long", "五鬼天王尚和阳修炼的法宝之一。\n");
    set("series_no", 4);
    set("damage", 200);
    set("no_steal", 1);
    set("no_put", 1);
    set("fabao", 1);
    set("wuxing", "火");
    set("class", "邪");
    set("no_busy", 1);
  }
  setup();
}
int ji(string arg) {
  object me = this_player();
  if (me->query("level") < query("level"))
    return notify_fail("你等级不够" + query("level") + "，祭不起" + query("name") + "。\n");
  if (time() < query("last_ji") + 5)
    return notify_fail(query("name") + "刚刚收回，还是休息休息再祭不迟。\n");
  if (me->query("mana") < 500)
    return notify_fail("你的法力不够。\n");
  if (me->query("level") < query("level"))
    return notify_fail("你的等级不够。\n");
  set("last_ji", time());
  return notify_fail("你念了念咒语，结果" + query("name") + "没有反应，分明是个假货。\n");
}
