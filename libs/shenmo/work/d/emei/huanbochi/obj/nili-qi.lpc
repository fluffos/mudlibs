#include <ansi.h>
inherit ITEM;
inherit F_UNIQUE; 

void create()
{
        set_name(HIW"泥犁旗"NOR, ({ "nili qi", "qi","flag" }) );
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "面");
                set("level",80);
                set("value", 0);
                set("material", "shuijing");
                set("long", "五鬼天王尚和阳修炼的法宝之一，用之能隐匿行踪。\n");
                set("replace_file", "/d/obj/drug/jinchuang"); 
                set("series_no",4);
                set("damage",800);
                set("no_steal",1);    
                set("no_put",1);       
                set("fabao",1);    
                set("no_busy",1);                
        }
        setup();
}

int ji(string id)
{
        string str,name;
        int i,t;
        object *team,me;
        me = environment();
        if( !me || !living(me) )
                return 0;
        if( me->query("level")<query("level") )
                return notify_fail("你等级不够"+query("level")+"，祭不起"+query("name")+"。\n");
        if( time()<query("last_ji")+5 )
                return notify_fail(query("name")+"刚刚祭出过。\n");                    
        if( me->query("mana")<1000 )
                return notify_fail("你的法力不够了。\n");
        if( me->query("env/invisibility") )
                return notify_fail("多此一举。\n");
                
        str = HIB"$N"HIB"拔起手中大旗，口诵魔咒，往空晃了几下，立刻惨雾弥漫，阴
风四起，红焰闪闪，雷声大作，";
        name = "$N";
        team = me->query_team();
        t = me->query_skill("spells");
        if( t<60 )
                t = 60;
        if( t>800 )
                t = 800;
        if( team && arrayp(team) && sizeof(team)>1 )
        {
                for(i=0;i<sizeof(team);i++)
                {
                        if( !team[i] || !objectp(team[i]) )
                                continue;
                        if( team[i]!=me
                         && !team[i]->query("env/invisibility") 
                         && present(team[i],environment(team[i])) )
                                name+= "、"+team[i]->query("name");
                        if( present(team[i],environment(team[i])) 
                         && !team[i]->query("env/invisibility") )
                        {                        
                                team[i]->set_temp("nili-qi",([
                                        "fabao" : this_object(),
                                        "Fowner": me,
                                        "time"  : t,
                                        "start" : time(),
                                ]));    
                                        
                                team[i]->set("env/invisibility",1); 
                                team[i]->apply_condition("nili-qi",1);                                                                         
                        }       
                }
                name+= "等一干人等俱都";                
        }
        else
        {
                me->set_temp("nili-qi",([
                        "fabao" : this_object(),
                        "Fowner": me,
                        "time"  : t,
                        "start" : time(),
                ]));    
                me->set("env/invisibility",1); 
                me->apply_condition("nili-qi",1);                                                                              
        }       
        str+= name+"立刻\n没了踪影。\n"NOR;             
        message_vision(str,me);
        me->add("mana",-800);
        return 1;
}
