#include <ansi.h>;
inherit ITEM;

void create()
{
        set_name(HIG"温香古榻"NOR, ({"wenxiang guta", "ta","bed"}));
        set_weight(100000000000000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一个修道打坐的古榻，坐(sit)在上面可以恢复元气。\n");
                set("unit", "个");
                set("no_get","你是大力士吧？这个也想拿起来？");
                set("no_put","你是大力士吧？这个也想拿起来？");
        }
        setup();
}

void init()
{
        add_action("do_zuo",({"sit","zuo"}));
}

int err_msg(string arg)
{
        write(arg);
        return 1;
}
        
int do_zuo(string arg)
{
        object me = this_player();
        if( !arg || !id(arg) )
                return 0;
        if( me->is_busy() )
                return err_msg("你现在正忙着呢。\n");
        message_vision("$N一屁股坐在温香古榻上。\n",me);
        me->start_busy(5);
        me->start_call_out( (: call_other,environment(), "fullme", me:), 4);
        return 1;
}       

string short()
{
        string str = ::short();
        return "\t"+str;
}                               
