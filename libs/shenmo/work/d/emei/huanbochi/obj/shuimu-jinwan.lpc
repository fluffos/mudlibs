//任务性物品
#include <ansi.h>
inherit EQUIP;

void create() {
  set_name(HIC "先天水母坎金丸" NOR, ({ "shuimu kanjin wan", "wan", "fabao" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("value", 0);
    set("material", "shuijing");
    set("long", "白眉禅师所炼的法宝之一，莹莹欲流，晶辉朗耀。\n");
    set("no_steal", 1);
    set("no_get", 1);
    set("no_put", 1);
    set("wear_msg", HIC "$N" HIC "手中$n" HIC "化为数十百丈大小一片乌光玄雾，裹住全身。\n" NOR);
    set("unequip_msg", HIY "$N" HIY "撤去了$n" HIY "。\n" NOR);
    set("armor_type", "QUEST");
    set("armor_prop/armor", 8);
    set("armor_prop/spells", 3);
  }
  setup();
}
