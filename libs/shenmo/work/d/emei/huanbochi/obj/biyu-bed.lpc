#include <ansi.h>;
inherit ITEM;

void create()
{
        set_name(HIG"碧玉榻"NOR, ({"biyu bed", "bed","biyu"}));
        set_weight(100000000000000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一个腰圆形的碧玉榻。\n");
                set("unit", "个");
                set("no_get","你是大力士吧？这个也想拿起来？");
                set("no_put","你是大力士吧？这个也想拿起来？");
        }
        setup();
}

void init()
{
        add_action("do_look","look");
}

int err_msg(string arg)
{
        write(arg);
        return 1;
}

string short()
{
        string str = ::short();
        return "\t"+str;
}

void revive_obj(object who)
{
        remove_call_out("revive_obj");  
        if( !who || !present(who,environment()) )
                return;
        who->set_temp("block_msg/all",0);
        message_vision(HIY "\n慢慢地$N"HIY"终于又有了知觉．．．\n\n" NOR,who); 
}       

void quest(object who)
{
        object npc;
        remove_call_out("quest");
        if( !who || !present(who,environment()) )
                return;
        who->set_temp("block_msg/all",0);
        npc = who->query_temp("huanbo/yaoshi1");
        if( !npc )
                return;
        if( !present(npc,environment()) )
        {
                if( !npc->move( environment() ) )
                        return;
        }               
        if( !npc->copy_data(who) )
                        return;                 
        message_vision(HIR"
$N"HIR"正看得痴迷，只见榻上妙人把手一指，那右方垂的半片帘幔，
立化一大片血赤色的火焰，火网一般电驰飞堕，将$N"HIR"罩住。\n"NOR,who);
        who->set_temp("no_move",([
                "start" : time(),
                "time"  : 900,
        ]));
        message_vision(HIB"
        
只见一道元神从榻上玉人顶梁窜出，恶狠狠的扑向$N"HIB"！\n\n"NOR,who);
        npc->kill_ob(who);      
}

void step6(object who)
{
        remove_call_out("step6");
        if( !who || !present(who,environment()) )
                return;
        who->set_temp("block_msg/all",0);
        message_vision("
尤其厉害的是，人还不曾走近榻前，首先鼻孔中闻到一缕温香，其味非兰非麝，
仿佛由榻上人肌肤中隐隐透出，闻之令人魂销魄落，心神欲醉。\n",who);
        who->set_temp("block_msg/all", 1); 
        call_out("quest",random(5),who);
}

void step5(object who)
{
        remove_call_out("step5");
        if( !who || !present(who,environment()) )
                return;
        who->set_temp("block_msg/all",0);
        message_vision("
容光既如此妖艳，神态又那么淫冶，加上服饰华丽，迥绝人间。上面淡雅的衣被
与下面铺陈的锦褥文绣，再互一陪衬，越显得貌比花娇，人如玉琢，光彩照人，
不可逼视。\n",who);
        who->set_temp("block_msg/all", 1); 
        call_out("step6",random(5),who);
}

void step4(object who)
{
        remove_call_out("step4");
        if( !who || !present(who,environment()) )
                return;
        who->set_temp("block_msg/all",0);
        message_vision("
下半身虽被盖住，却在有意无意之中，由被角边半隐半现地露出一段丰盈柔细的
玉腿，以及半截底平指敛，粉光致致，柔若无骨的白足。面上神情是星波莹明，
如蕴妙思，黛眉微颦，隐含幽怨。再加玉颊春生，樱唇红破，瓠犀微露，欲语不
语之状，好似半嗔半喜之中，蕴藏着万种风流，无限情思。端的秾纤合度，体态
妖烧，从头到脚，直无一处不撩拨人的遐想。\n",who);
        who->set_temp("block_msg/all", 1); 
        call_out("step5",random(5),who);
}

void step3(object who)
{
        remove_call_out("step3");
        if( !who || !present(who,environment()) )
                return;
        who->set_temp("block_msg/all",0);
        message_vision("
那没盖着的地方，固是肌肤玉映，琼绡不掩，隐约可以窥见。还有那双手臂，因
为右手支颐默坐，露了半截臂膀和那十指春葱，说不出的粉铸脂合，圆滑朗润。\n",who);
        who->set_temp("block_msg/all", 1); 
        call_out("step4",random(5),who);
}       

void step2(object who)
{
        remove_call_out("step2");
        if( !who || !present(who,environment()) )
                return;
        who->set_temp("block_msg/all",0);
        message_vision("
身上半盖半裹着一床质胜纨绮，色作淡青，看去又轻又软的被单。上半身只双
肩、前胸和手臂露出在外，一手微搭胸前，另一手臂懒洋洋支向右侧玉栏之上。
身穿一件薄如蝉翼，雪也似白的道衣，前胸微敞，露出雪白粉颈和半段酥胸，
下面乳峰隐隐坟起于冰纨锦被之间。\n",who);
        who->set_temp("block_msg/all", 1); 
        call_out("step3",random(5),who);
}       

int do_look(string arg)
{
        string str;
        int damage = 500;
        object fb,ob,me = this_player();
        if( !arg || !userp(me) )
                return 0;
        if( me->query_temp("huanbochi/yaoshi1") 
         || !me->query_temp("huanbochi/moshi") )
                return 0;
        if( !me->query_temp("huanbo/yaoshi1") )
                return 0;
        if( me->is_fighting() )
                return 0;               
        if( me->is_busy() )
                return err_msg("你现在正忙着呢。\n");   
        ob = present(arg,environment());
        if( !ob || ob!=this_object() )
                return 0;               
        if( !me->query_temp("huanbo/biyu_look") )
        {
                message_vision("$N盯着"+query("name")+"看，不知道打些什么主意。\n只见"+query("name")+"蕴有奇光，隐隐似有邪气透出。\n",me);
                str = query("long");
                str+= "你猛闻到一股妖香，";
                fb = me->query_temp("armor/FABAO");
                if( fb )
                        damage = fb->protect_shen(damage);
                damage/= 2;
                if( random(damage)>100 || random(me->query("mana")/100)<10 )
                {
                        str+= "骤未及防，立觉心神微微一荡。\n";
                        write(str);
                        if( me->query("mana")>500 )
                                me->add("mana",-500);
                        else    me->set("mana",0);      
                        me->add_temp("huanbo/mihun",1);
                        if( me->query_temp("huanbo/mihun")>5 )
                        {
                                message_vision("$N只觉魂消魄落，人也软醉如泥，身子一软，顿时伏地不起。\n",me);
                                tell_object(me,HIR"你眼前一黑，接着什么也不知道了．．．\n\n"NOR);
                                me->set_temp("block_msg/all", 1); 
                                call_out("revive_obj",30+random(30),me);
                                return 1;
                        }
                        me->start_busy(1);
                        return 1;
                }
                str+= "你心神一凛，立时生起万分警觉。\n";
                write(str);
                me->set_temp("huanbo/biyu_look",1);
                return 1;
        }
        message_vision("\n
只见一副娇躯正半卧半坐，靠在榻头玉屏风上。这时正做出闺中美眷午梦初回，
睡眼惺松，春情荡漾，所思不至，无可奈何，娇情欲堕之状。\n",me);
        me->set_temp("block_msg/all", 1); 
        call_out("step2",random(5),me);
        return 1;
}
                




