//防御类法宝，护体神光之类
#include <ansi.h>
inherit EQUIP;

void create()
{
        set_name(HIY"兜率宝伞"NOR, ({ "doulu baosan", "san","fabao" }) );
        set_weight(3000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("value", 0);
                set("material", "shuijing");
                set("long", "一真上人所炼的法宝之一。\n");
                set("series_no",2);                       //法宝类型
                set("wuxing","金");                       //法宝五行
                set("level",100);                         //法宝等级
                set("no_steal",1);
                set("no_get",1);
                set("no_put",1);                          //下面是装备卸除描述
                set("armor_type","FABAO");                //armor_type,这样一人只能装备一个防御法宝，且不需要用all_inventory来取得        
                set("armor_prop/armor",28);             
                set("armor_prop/spells",10);
                set("armor_prop/redamage_eff_sen_damage",1);    //新加的扩展功能 伤害反弹比率
                set("armor_prop/redamage_eff_kee_damage",1);  
                set("class","正");                        //法宝正邪
                set("no_busy",1);                       
        }
        setup();
}

//对攻击法宝kee伤害的伤害抵消，根据法宝的阶地自行定义
//法宝五行相克也在这里实现
varargs int protect_qi(int damage,string wx)
{
        int xk;
        if( damage<=0 || !environment() 
         || !living(environment()) )
                return damage;
        if( time()<query_temp("last_protect_qi")+5 )
                return damage;
        if( !wx )
                wx = SPELL_D->query_time_wuxing();              
        if( wx && query("wuxing") )
        {       
                xk = SPELL_D->wuxing_xs(query("wuxing"),wx);
                if( xk==1 )
                        damage = damage*2/3;
        }       
        set("last_protect_qi",time());  
        message_vision(HIY"$N"HIY"身上金光一阵抖动，卸去了不少的伤害。\n"NOR,environment());
        return damage*2/3;
}

//对攻击法宝sen伤害的伤害抵消，根据法宝的阶地自行定义
varargs int protect_shen(int damage,string wx)
{
        int xk;
        if( damage<=0 || !environment() 
         || !living(environment()) )
                return damage;
        if( time()<query_temp("last_protect_shen")+5 )
                return damage;
        if( !wx )
                wx = SPELL_D->query_time_wuxing();              
        if( wx && query("wuxing") )
        {       
                xk = SPELL_D->wuxing_xs(query("wuxing"),wx);
                if( xk==1 )
                        damage = damage/2;
                else    damage = damage-damage*5/100;           
        }       
        set("last_protect_shen",time());        
        message_vision(HIY"$N"HIY"身上金光一阵抖动，卸去了不少的伤害。\n"NOR,environment());
        return damage*2/3;
}       
