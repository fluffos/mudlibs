#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create() {
  set_name(HIY "阿难剑
" NOR, ({ "a nan jian", "sword", "jian" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 0);
    set("material", "iron");
    set("long", "佛门利器，仅长尺许。\n");
    set("wield_msg", HIB "$N口念真言，幻化出一柄$n，擎在手中掂了掂。\n" NOR);
    set("series_no", 1);
    set("no_steal", 1);
    set("no_put", 1);
    set("no_busy", 1);
  }
  init_sword(285);
  setup();
  set("weapon_prop/ad_sword", 15);
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  object fb;
  int damage = 300;
  if (!me || !victim || !me->is_fighting(victim)
    || damage_bonus <= 0)
    return 0;
  add_temp("hit", 1);
  if (victim->is_busy()
    || random(100) > (int)victim->query_skill("spells") / ((int)me->query_skill("spells") + (int)victim->query_skill("spells")) * 90) {
    fb = victim->query_temp("armor/FABAO");
    if (fb)
      damage = fb->protect_shen(damage);
    if (damage <= 0)
      return 0;
    victim->receive_damage("sen", damage, me);
    if (victim->query("class") == "yao"
      && !victim->is_busy()
      && query_temp("hit") % 9 == 0)
      victim->start_busy(1 + random(2));
    set_temp("hit", 1);
    return HIY "只见" + query("name") + HIY "发出一阵梵呗之声，搅得$n" HIY "是六神难安。\n" NOR;
  }
  return 0;
}
