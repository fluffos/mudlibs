#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIR "人皮口袋" NOR, ({ "renpi koudai", "koudai", "dai", "bag", "fabao" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("level", 550);
    set("value", 0);
    set("material", "shuijing");
    set("long", "内藏九幽灵火，为鸠盘婆所炼赤身教镇山之宝之一。\n");
    set("series_no", 4);
    set("damage", 800);
    set("no_steal", 1);
    set("no_put", 1);
    set("fabao", 1);
    set("wuxing", "火");
    set("no_busy", 1);
  }
  setup();
}

int ji(string id) {
  int xk, ap, dp, damage;
  string wx;
  object fb, target, me;
  me = environment();
  if (!me || !living(me))
    return 0;
  if (me->query("mana") < query("level") * 2)
    return notify_fail("你的法力不足。\n");
  if (!me->is_fighting())
    return notify_fail("你要对谁祭法宝？\n");
  if (me->query("level") < query("level"))
    return notify_fail("你等级不够" + query("level") + "，祭不起" + query("name") + "。\n");
  if (time() < query("last_ji") + 5)
    return notify_fail(query("name") + "刚刚祭出过。\n");
  if (id) {
    target = present(id, environment(me));
    if (!target)
      return notify_fail("这里没有" + id + "。\n");
  } else target = SSERVER->offensive_target(me);
  if (!target || !me->is_fighting(target))
    return notify_fail("你要对谁祭" + query("name") + "？\n");

  set("last_ji", time());
  ap = me->query("daoxing") / 100000 + me->query("level") * 1000;
  dp = target->query("daoxing") / 100000 + target->query("level") * 1000;

  if (me->query("env/no_msg") || target->query("env/no_msg"))
    message_vision(
      HIR "$N" HIR "对$n" HIR "使用了法宝「" HIY + query("name") + HIR "」。\n" NOR,
      me,
      target
    );
  else {
    message_vision(HIR "$N" HIR "将人皮口袋一拍，立有好些鬼气森森，形似寒灯残焰所结灯花的幽灵阴火朝向$n" HIR "飞去。\n" NOR, me, target);
    if (random(2))
      message_vision(
        NOR RED "只见三五点鬼火一般的亮光冉冉飞出，光既不强，来势又缓，每朵鬼火下面，各有一团似人非\n人的黑影。甚是阴毒，无孔不入，极为厉害。\n" NOR,
        me
      );
    else message_vision(NOR RED "只见飞出数十团碧烟，飞起空中，互相击撞爆散，化为百十丈烈焰。晃眼之间，血光熊熊，凝\n成一片，将此处罩定。\n" NOR, me);
  }
  me->add("mana", -query("level") * 2);
  if (random(100) > dp / (ap + dp) * 95) {
    damage = me->query("mana_factor");
    damage += query("damage");
    if (wx = query("wuxing")) {
      xk = SPELL_D->wuxing_xs(SPELL_D->query_time_wuxing(), wx);
      if (xk == 1)
        damage = damage / 2;
      else if (xk == -1)
        damage += damage / 3;
    }
    fb = target->query_temp("armor/FABAO");
    if (fb)
      damage = fb->protect_shen(damage, "火");
    if (damage > 0) {
      message_vision(HIB "\n$N" HIB "闪避不及，被沾上数点九幽灵火，顿时心神受创，整个人变得萎靡不振！\n" NOR, target);
      target->receive_wound("sen", damage, me);
      COMBAT_D->report_sen_status(target, 1);
    }
  } else message_vision(
    HIC "$N" HIC "哼！了一声：米粒之珠，也放光华？说罢，将手一指，结果血光大盛，" + query("name") + HIC "发出一声哀鸣，从半空落了下来。\n" NOR,
    target
  );
  return 1;
}
