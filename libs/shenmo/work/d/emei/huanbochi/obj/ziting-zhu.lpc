#include <ansi.h>
#include <weapon.h>
inherit COMBINED_ITEM;
inherit F_UNIQUE; 

void setup(){}

void create()
{
        set_name(HIM"紫霆珠"NOR, ({"ziting zhu","zhu","fabao"}));
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "“女神婴”易静降魔七宝之一，需要搭配灭魔弹月弩使用。\n");
                set("unit", "把");
                set("base_unit", "颗");
                set("base_weight", 3);
                set("damage",150);
                set("value", 0);
                set("series_no",2);
                set("no_get",1);
                set("no_steal",1);
                set("replace_file", "/d/obj/weapon/throwing/kongqueling");
                set("no_put",1);
        }
        setup();
        set_amount(36);        
}

