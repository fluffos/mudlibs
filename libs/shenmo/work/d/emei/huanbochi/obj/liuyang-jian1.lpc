#include <ansi.h>
inherit ITEM;

void create()
{
        set_name(HIC"六阳神火鉴"NOR, ({ "liuyang shenhuo jian", "jian","jing" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("level",580);
                set("value", 0);
                set("material", "shuijing");
                set("long", "，采西方太乙真金炼成，本是一面圆镜，不用时小才寸许，专克邪法异宝。\n");
                set("series_no",4);
                set("no_steal",1);    
                set("no_put",1);       
                set("fabao",1);    
                set("class","正");
                set("wuxing","火");
                set("damage",500);
                set("no_busy",1);                
        }
        setup();
}

int ji(string id)
{
        int xk,ap,dp,i,succ,n,damage;
        string wx,msg;
        object fb,*inv,target,me,*temp;
        me = environment();
        if( !me || !living(me) )
                return 0;
        if( me->query("mana")<query("level")*2 )
                return notify_fail("你的法力不足。\n");         
        if( !me->is_fighting() )
                return notify_fail("你要对谁祭法宝？\n");
        if( me->query("level")<query("level") )
                return notify_fail("你等级不够"+query("level")+"，祭不起"+query("name")+"。\n");
        if( time()<query("last_ji")+8 )
                return notify_fail(query("name")+"刚刚祭出过。\n");                    
        if( id )
        {
                target = present(id, environment(me));
                if( !target )
                        return notify_fail("这里没有"+id+"。\n");
        }
        else    target = SSERVER->offensive_target(me);
        if( !target || !me->is_fighting(target) )
                return notify_fail("你要对谁祭"+query("name")+"？\n");
        
        set("last_ji",time());  
        ap = me->query("daoxing")/100000+me->query("level")*1000;
        dp = target->query("daoxing")/100000+target->query("level")*1000;       

        if( me->query("env/no_msg") || target->query("env/no_msg") )
                message_vision(HIR"$N"HIR"对$n"HIR"使用了法宝「"HIY+query("name")+HIR"」。\n"NOR,me,target);
        else
        {
                message_vision(HIC"六阳神火鉴紧附$N"HIC"身前，发出六道青光，重在一起，化为乾上坤下六象。\n"NOR,me);
                message_vision(HIC"只见六束六寸长短，粗才如指，青荧荧的明光在$N"HIC"身前往外放射，越展越大，将$n"HIC"周身全部照住。\n"NOR,me,target);          
        }
        me->add("mana",-query("level")*2);
        xk = SPELL_D->wuxing_xs(SPELL_D->query_time_wuxing(),wx);
        if( xk==1 )
                ap-= random(ap/3);
        else if( xk==-1 )
                ap+= random(ap/3);
        succ = 0;
        if( random(100)>dp/(ap+dp)*100 )        
                succ++;
        fb = target->query_temp("armor/FABAO");
        if( fb )
        {
                if( random(100)>fb->query("level")/(query("level")+fb->query("level"))*100 )
                        succ++;                 
                if( fb->fabao_ke(this_object()) )
                        succ = 0;
        }

        if( succ<=0 )
        {
                message_vision(HIC"$N"HIC"哼！了一声：米粒之珠，也放光华？说罢，将手一指，结果血光大盛，"+query("name")+HIC"发出一声哀鸣，从半空落了下来。\n"NOR,target);
                add("last_ji",10);
                return 1;
        }       
        
        inv = all_inventory(target);
        temp = ({});
        for(i=0;i<sizeof(inv);i++)
        {
                if( !inv[i] || !inv[i]->query("series_no") 
                 || inv[i]->query("class")!="邪"
                 || inv[i]->query("level")>query("level") )
                        continue;
                temp+= ({inv[i]});
        }
        n = 1;
        if( sizeof(temp)<1 )
                n = 0;
        else
        {
                fb = temp[random(sizeof(temp))];
                if( !fb )
                        n = 0;
        }
        if( n<1 )                       
        {
                damage = query("damage");
                damage = damage/2+random(damage/2);
                msg = COMBAT_D->damage_msg(damage,"刺伤");
                msg = replace_string(msg,"$w","青光");
                msg = replace_string(msg,"$l","全身");
                msg = COLOR_D->clean_color(msg);
                msg = HIC+msg+NOR;
                msg = COLOR_D->replace_color(msg,1);
                message_vision(msg,me,target);
                target->receive_damage("kee",damage,me);
                COMBAT_D->report_status(target);
        }
        else
        {
                msg = HIC"$N"HIC"身上"+fb->query("name")+HIC"吃青光一照，便即化作灰灰！\n"NOR;
                message_vision(msg,target);
                if( fb->query("equipped") )
                        fb->unequip();
                fb->move("/obj/empty");
        }                       
        return 1;
}               
                                
