#include <ansi.h>
#include <armor.h>
inherit WAIST;

void create() {
  set_name("紫绦带", ({ "zitao dai", "dai", }));
  set_weight(800);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("material", "leather");
    set("value", 0);
    set("no_sell", 1);
    set("no_put", 1);
    set("series_no", 2);
    set("armor_prop/armor", 8);

  }
  setup();
}
