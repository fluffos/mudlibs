#include <ansi.h>
#include <room.h>
inherit ITEM;

void create()
{
        set_name(HIY"法华金刚轮"NOR, ({ "jingang lun", "lun","fabao" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("level",100);
                set("value", 0);
                set("material", "shuijing");
                set("long", "芬陀大师修炼的法宝之一，密宗修行法器，转起来可以平复心灵。\n");
                set("series_no",4);
                set("damage",600);
                set("no_steal",1);    
                set("no_put",1);       
                set("fabao",1);    
                set("class","正");
                set("wuxing","金");
                set("no_busy",1); 
        }
        setup();
}

int ji(string id)
{
        int xk,ap,dp,damage;
        string wx;
        object fb,target,me;
        me = environment();
        if( !me || !living(me) )
                return 0;
        if( me->query("mana")<query("level")*2 )
                return notify_fail("你的法力不足。\n");
        if( !me->is_fighting() )
                return notify_fail("你要对谁祭法宝？\n");
        if( me->query("level")<query("level") )
                return notify_fail("你等级不够"+query("level")+"，祭不起"+query("name")+"。\n");
        if( time()<query("last_ji")+5 )
                return notify_fail(query("name")+"刚刚祭出过。\n");                    
        if( id )
        {
                target = present(id, environment(me));
                if( !target )
                        return notify_fail("这里没有"+id+"。\n");
        }
        else    target = SSERVER->offensive_target(me);
        if( !target || !me->is_fighting(target) )
                return notify_fail("你要对谁祭"+query("name")+"？\n");
        
        set("last_ji",time());  
        ap = me->query("daoxing")/100000+me->query("level")*1000;
        dp = target->query("daoxing")/100000+target->query("level")*1000;       

        if( me->query("env/no_msg") || target->query("env/no_msg") )
                message_vision(HIY"$N"HIY"对$n"HIY"使用了法宝「"HIY+query("name")+HIY"」。\n"NOR,me,target);
        else
        {
                message_vision(HIY"$N"HIY"掐指对$n"HIY"一点，大喝一声“看法宝！”，只见"+query("name")+HIY"「呼」地一下飞到半空，\n"NOR,me,target);
                message_vision(HIY"只见"+query("name")+HIY"立时化成万道光芒，如银雨旋空，飙轮电转，称得起是无坚不摧，无攻不克。\n"NOR,me);
        }
        me->add("mana",-query("level")*2);
        if( random(100)>dp/(ap+dp)*90 )
        {
                damage = me->query("mana_factor");
                damage+= query("damage");
                if( wx=query("wuxing") )
                {       
                        xk = SPELL_D->wuxing_xs(SPELL_D->query_time_wuxing(),wx);
                        if( xk==1 )
                                damage = damage/2;
                        else if( xk==-1 )
                                damage+= damage/3;
                }                                               
                fb = target->query_temp("armor/FABAO");
                if( fb )
                        damage = fb->protect_shen(damage);
                if( damage>0 )
                {                                               
                        target->receive_wound("sen",damage,me);
                        COMBAT_D->report_sen_status(target,1);
                }
        }
        else    message_vision(HIW"$N"HIW"哼！了一声：米粒之珠，也放光华？说罢，将手一指，结果血光大盛，"+query("name")+HIW"发出一声哀鸣，从半空落了下来。\n"NOR,target);
        return 1;
}               

void init()
{
        add_action("do_zhuan",({"zhuan","turn"}));
}

int err_msg(string arg)
{
        write(arg);
        return 1;
}

int do_zhuan(string arg)
{
        int succ = 0;
        mapping doors;
        object env,me = this_player();
        
        if( !arg || !id(arg) )
                return 0;
        if( me->is_busy() )
                return err_msg("你现在正忙着。\n");
        
        message_vision("$N将法华金刚轮在手中徐徐转动，一时梵呗声起，天落奇花，
异象迭起。\n",me);
        me->start_busy(1+random(2));
        env = environment(me);
        if( base_name(env)!="/d/emei/huanbochi/zhudong-e2" 
         && base_name(env)!="/d/emei/huanbochi/mijing-e1" )
                return 1;
        doors = env->query_doors();
        if( base_name(env)=="/d/emei/huanbochi/zhudong-e2" )
        {
                if( doors["north"]["status"] != DOOR_CLOSED  )
                        return 1;
                if( env->open_door("north") )
                        succ = 1;
        }               
        if( base_name(env)=="/d/emei/huanbochi/mijing-e1" )
        {
                if( doors["south"]["status"] != DOOR_CLOSED )
                        return 1;
                if( env->open_door("south") )
                        succ = 1;
        }               
        if( succ<1 )
                return 1;
        message_vision("                
宝光照处，那坚逾金玉的右洞壁渐渐消融，也并未见有碎石
和裂纹，自然内消。已现出一个丈许大小，与金轮一样形式
的大洞，不仅地位合适，十分美观，尤妙是四边棱角，圆平
齐整，宛如天成。\n\n",me);
        return 1;
}
