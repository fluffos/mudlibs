#include <ansi.h>
inherit ITEM;

void create()
{
        set_name(HIR"血焰叉"NOR, ({ "huoyan cha", "cha","fork","fabao" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("level",150);
                set("value", 0);
                set("material", "shuijing");
                set("long", "为鸠盘婆所炼赤身教镇山之宝之一。上面的血焰黑烟阴毒无比，得隙即入，敌人稍微沾着一点，便如附骨之疽，任是多高法力，也必昏迷倒地，周身溃烂，化为一摊脓血，万无生理。\n");
                set("series_no",4);
                set("damage",800);
                set("no_steal",1);    
                set("no_put",1);       
                set("fabao",1); 
                set("wuxing","火");  
                set("class","邪"); 
                set("no_busy",1);                
        }
        setup();
}

void end_ji()
{
        delete("is_ji");
        if( environment() && living(environment()) )
                tell_object(environment(),HIR"你收回了"+query("name")+HIR"。\n"NOR);
}               

void feicha(object me,object target,int t)
{
        int xk,damage;
        string wx,msg;
        object fb;
        remove_call_out("feicha");
        if( !me || !target || !me->is_fighting(target) )
        {
                end_ji();
                return;
        }
        damage = me->query("mana_factor");
        damage+= query("damage");
        if( wx=query("wuxing") )
        {       
                xk = SPELL_D->wuxing_xs(SPELL_D->query_time_wuxing(),wx);
                if( xk==1 )
                        damage = damage/2;
                else if( xk==-1 )
                        damage+= damage/3;
        }
        if( damage>0 )
        {
                message_vision(RED"一股血焰朝$N"RED"飞去，角度刁钻之极，让人防不胜防。\n"NOR,target);                  
                fb = target->query_temp("armor/FABAO");
                if( fb )
                        damage = fb->protect_qi(damage,"火");
                if( damage>0 )
                {
                        msg = COMBAT_D->damage_msg(damage,"刺伤");
                        msg = replace_string(msg,"$w",RED"血焰"NOR);
                        msg = replace_string(msg,"$l","身上");
                        message_vision(msg,me,target);
                        target->receive_wound("kee",damage,me);
                        COMBAT_D->report_status(target,1);
                }
        }
        t--;
        if( t<=0 )
        {
                end_ji();
                return;
        }
        call_out("feicha",random(5),me,target,t);
}               

int ji(string id)
{
        int ap,dp;
        object target,me;
        me = environment();
        if( !me || !living(me) )
                return 0;
        if( me->query("mana")<query("level")*2 )
                return notify_fail("你的法力不足。\n");         
        if( !me->is_fighting() )
                return notify_fail("你要对谁祭法宝？\n");
        if( me->query("level")<query("level") )
                return notify_fail("你等级不够"+query("level")+"，祭不起"+query("name")+"。\n");
        if( time()<query("last_ji")+5 )
                return notify_fail(query("name")+"刚刚祭出过。\n");     
        if( query("is_ji") )
                return notify_fail(query("name")+"已经祭出了。\n");
        if( id )
        {
                target = present(id, environment(me));
                if( !target )
                        return notify_fail("这里没有"+id+"。\n");
        }
        else    target = SSERVER->offensive_target(me);
        if( !target || !me->is_fighting(target) )
                return notify_fail("你要对谁祭"+query("name")+"？\n");
        
        set("last_ji",time());  
        ap = me->query("daoxing")/100000+me->query("level")*1000;
        dp = target->query("daoxing")/100000+target->query("level")*1000;       

        if( me->query("env/no_msg") || target->query("env/no_msg") )
                message_vision(HIR"$N"HIR"对$n"HIR"使用了法宝「"HIY+query("name")+HIR"」。\n"NOR,me,target);
        else    message_vision(HIR"$N"HIR"两肩左右摇处，九柄血焰叉化为九股血焰飞起，直投$n"HIR"，飞梭穿掷，倏然若电。\n"NOR,me,target);
        me->add("mana",-query("level")*2);
        if( random(100)>dp/(ap+dp)*95 )
        {
                set("is_ji",1);
                call_out("feicha",random(3),me,target,9);
        }
        else    message_vision(HIC"$N"HIC"哼！了一声：米粒之珠，也放光华？说罢，将手一指，结果血光大盛，"+query("name")+HIC"发出一声哀鸣，从半空落了下来。\n"NOR,target);
        return 1;
}               
                                
