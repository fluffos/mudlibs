#include <ansi.h>
#include <combat.h>
inherit ITEM;

void create()
{
        set_name(HIY"牟尼散光丸"NOR, ({ "mouni sanguang wan", "wan","fabao" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("level",180);
                set("value", 0);
                set("material", "shuijing");
                set("long", "“女神婴”易静降魔七宝之一，专能对手护体法宝。\n");
                set("series_no",4);
                set("damage",300);
                set("no_steal",1);
                set("class","正");
                set("wuxing","火");                
                set("no_busy",1);                
        }
        setup();
}

int ji(string id)
{
        string msg,limb,*limbs,wx;
        int t,xk,ap,dp,damage;
        object fb,target,me;
        me = environment();
        if( !me || !living(me) )
                return 0;
        if( me->query("mana")<query("level")*2 )
                return notify_fail("你的法力不足。\n");         
        if( !me->is_fighting() )
                return notify_fail("你要对谁祭法宝？\n");
        if( me->query("level")<query("level") )
                return notify_fail("你等级不够"+query("level")+"，祭不起"+query("name")+"。\n");
        if( time()<query("last_ji")+5 )
                return notify_fail(query("name")+"刚刚祭出过。\n");                    
        if( id )
        {
                target = present(id, environment(me));
                if( !target )
                        return notify_fail("这里没有"+id+"。\n");
        }
        else    target = SSERVER->offensive_target(me);
        if( !target || !me->is_fighting(target) )
                return notify_fail("你要对谁祭"+query("name")+"？\n");
        set("last_ji",time());  
        return notify_fail("你念了念咒语，结果"+query("name")+"没有反应，分明是个假货。\n");

}
