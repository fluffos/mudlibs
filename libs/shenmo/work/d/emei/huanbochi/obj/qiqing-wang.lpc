#include <ansi.h>
inherit ITEM;
inherit F_UNIQUE; 

void create()
{
        set_name(NOR YEL"七情网"NOR, ({ "qiqing wang", "wang","fabao" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("level",50);
                set("value", 0);
                set("material", "shuijing");
                set("long", "五鬼天王尚和阳修炼的法宝之一。\n");
                set("replace_file", "/d/city/npc/obj/whip"); 
                set("series_no",4);
                set("damage",200);
                set("no_steal",1);    
                set("no_put",1);       
                set("fabao",1);    
                set("wuxing","火");
                set("class","邪");
                set("no_busy",1);               
        }
        setup();
}

void check_target(object who,int i)
{
        int damage,k,xk;
        object fb,*enemy;
        string dd,msg,wx,limb,*limbs,*dus = ({
                "蝎子","蜈蚣","毒蛇","壁虎","七修","蜘蛛","金蚕",
        });     
        remove_call_out("check_target");
        if( !who || !present(this_object(),who) 
         || !living(who) )
        {
                delete("is_ji");
                set("last_ji",time());
                return;
        }
        i = i-1;
        if( i<=0 || who->query("mana")<100 )
        {
                message_vision(RED"\n$N"RED"将手一招，收回了$n"RED"。\n\n"NOR,who,this_object());
                delete("is_ji");
                set("last_ji",time());
                return;
        }
//      message_vision(YEL"\n「"NOR HIR"七绝忘情魔阵"NOR YEL"」内满天毒物飞舞，遮蔽天日。\n"NOR,who);
        who->add("mana",-100);          
        enemy = who->query_enemy();
        if( enemy && sizeof(enemy)>=1 )
        {
                for(k=0;k<sizeof(enemy);k++)
                {
                        if( !enemy[k] )
                                continue;
                        dd = dus[random(sizeof(dus))];  
                        damage = query("damage");
                        damage = damage/2+random(damage/2);
                        if( wx=query("wuxing") )
                        {       
                                xk = SPELL_D->wuxing_xs(SPELL_D->query_time_wuxing(),wx);
                                if( xk==1 )
                                        damage = damage/2;
                                else if( xk==-1 )
                                        damage+= damage/3;
                        }                                               
                        limbs = enemy[k]->query("limbs");
                        limb = limbs[random(sizeof(limbs))];
                        msg = YEL"$n"YEL"昏头转向，一个不察，被"+dd+"咬中了$l！\n"NOR;
                        msg+= COMBAT_D->damage_msg(damage,"刺伤");
                        msg = replace_string(msg,"$l",limb);
                        msg = replace_string(msg,"$w",dd);
                        message_vision(msg,who,enemy[k]);
                        fb = enemy[k]->query_temp("armor/FABAO");
                        if( fb )
                                damage = fb->protect_qi(damage);
                        if( damage>0 )
                        {
                                enemy[k]->receive_wound("kee",damage,who);
                                COMBAT_D->report_status(enemy[k],1);
                        }
                        if( !enemy[k]->query_condition("wudu") )
                                enemy[k]->apply_condition("wudu",damage+10);
                }
        }               
        call_out("check_target",1+random(5),who,i);
}

void buzhen(object who)
{
        int i;
        remove_call_out("buzhen");
        if( !who || !present(this_object(),who) 
         || !living(who) )
                return;
        message_vision(RED"$N"RED"将$n"RED"对空一撒，只见满天都是蝎子、蜈蚣、毒蛇、壁虎、
七修、蜘蛛、金蚕等毒物飞舞，遮蔽天日。\n"NOR,who,this_object());
        i = who->query_skill("spells");
        if( i<60 )
                i = 60;
        if( i>600 )
                i = 600;
        call_out("check_target",1,who,i);
}                                                       

int ji(string arg)
{
        object me = this_player();
        if( me->query("level")<query("level") )
                return notify_fail("你等级不够"+query("level")+"，祭不起"+query("name")+"。\n");
        if( query("is_ji") )
                return notify_fail(query("name")+"已经祭出去了。\n");
        if( time()<query("last_ji")+5 )
                return notify_fail(query("name")+"刚刚收回，还是休息休息再祭不迟。\n");
        if( me->query("mana")<500 )
                return notify_fail("你的法力不够。\n");
        if( me->query("level")<query("level") )
                return notify_fail("你的等级不够。\n");
        message_vision(YEL"$N"YEL"将$n"YEL"迎风一晃，口中念念有词，开始布起「"NOR HIR"七绝忘情魔阵"NOR YEL"」。\n"NOR,me,this_object());                               
        me->add("mana",500);
        me->start_busy(1);
        set("is_ji",1);
        call_out("buzhen",1+random(3),me);
        return 1;
}                       
