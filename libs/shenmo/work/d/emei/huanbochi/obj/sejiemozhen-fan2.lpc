#include <ansi.h>
inherit ITEM;

void create()
{
        set_name(HIR"色界魔阵妖幡"NOR, ({ "sejie zhenfan", "fan","qi" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("level",150);
                set("value", 0);
                set("material", "shuijing");
                set("long", "五滢尊者修炼的法宝之一，能布小诸天五滢色界魔阵。\n");
                set("replace_file", "/obj/money/silver"); 
                set("series_no",4);
                set("damage",100);
                set("no_steal",1);    
                set("no_put",1);       
                set("fabao",1); 
                set("class","邪");   
                set("wuxing","火");
                set("no_busy",1);               
        }
        setup();
}

int ji(string id)
{
        int t;
        object *enemy,fb,me = environment();
        if( me->query("mana")<query("level")*2 )
                return notify_fail("你的法力不足。\n");                 
        if( me->query("level")<query("level") )
                return notify_fail("你等级不够"+query("level")+"，祭不起"+query("name")+"。\n");
        if( time()<query("last_ji")+5 )
                return notify_fail(query("name")+"刚刚祭出过。\n");                    
        if( environment(me)->query("no_magic")
         || environment(me)->query("no_fight") )
                return notify_fail("此处不可使用法宝。\n");
        set("last_ji",time());  
        return notify_fail("你念了念咒语，结果"+query("name")+"没有反应，分明是个假货。\n");
}
        

