#include <ansi.h>;
inherit ITEM;

void create() {
  set_name(HIG "大鼎" NOR, ({ "da ding", "ding" }));
  set_weight(100000000000000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一座九尺高的大鼎，非金非玉，色呈翠绿，光可鉴人，上面都是朱文符箓。\n上面盖着盖子，看不到里面有什么。\n");
    set("unit", "座");
    set("no_get", "你是大力士吧？这个也想拿起来？");
  }
  setup();
}

void init() {
  add_action("do_get", "get");
  add_action("do_open", "open");
}

void quest_hit(object who) {
  string gg, dir;
  object key;
  mapping GF = ([
    "str": ({ "shenliwan", "膂力", }),
    "int": ({ "xiandan", "悟性", }),
    "cor": ({ "cordan", "胆识", }),
    "cps": ({ "cpsdan", "定力", }),
    "kar": ({ "kardan", "福缘", }),
    "per": ({ "perdan", "美容", }),
    "spi": ({ "spidan", "灵性", }),
    "con": ({ "xisuidan", "根骨", }),
  ]);
  int damage, pp;
  remove_call_out("quest_hit");
  if (!who || !present(who, environment()))
    return;
  if (who->query_temp("huanbochi/dading_daogao")) {
    message_vision("
只见鼎盖徐徐升起，顿时一股浓郁的灵气扑面而来。\n", who);
    //福利
    if (!who->query("huanbochi/ding_gift")) {
      who->set("huanbochi/ding_gift", 1);
      gg = keys(GF)[random(sizeof(keys(GF)))];
      if (random(who->query_kar() / 2) > 25 || wizardp(who)) {
        dir = "/d/wizz/fangz/drug/";
        key = new(dir + GF[gg][0]);
        if (key->move(who)) {
          tell_object(who, HIY "你得到了一粒" + key->query("name") + HIY "。\n" NOR);
          CHANNEL_D->do_channel(
            this_object(),
            "rumor",
            "听说" + who->query("name") + HIM "得到了" + key->query("name") + HIM "！" NOR
          );
        } else destruct(key);
      } else {
        pp = who->query("kar");
        pp = random(pp) - 10;
        pp = pp - random(10) + random(10);
        if (pp > 0)
          tell_object(who, "你的后天" + GF[gg][1] + "永久增加" HIR + pp + NOR "点。\n");
        else if (pp < 0)
          tell_object(who, "你的后天" + GF[gg][1] + "永久减少" HIR + pp + NOR "点。\n");
        who->add("gift_modify/" + gg, pp);
      }
    }
    //黄玉钥匙
    if (!present("huangyu yaoshi", who)) {
      key = new(__DIR__ "huangyu-key");
      if (key->move(who)) {
        message_vision(YEL "一点黄光从鼎内射入$N" YEL "身上。\n" NOR, who);
        tell_object(who, "你得到了" + key->query("name") + "。\n");
        CHANNEL_D->do_channel(
          this_object(),
          "rumor",
          "听说" + who->query("name") + HIM "得到了" + key->query("name") + HIM "！" NOR
        );
      } else destruct(key);
    }

    if (!present("shuimu kanjin wan", who)) {
      if (random(who->query_kar() / 2) > 15) {
        key = new(__DIR__ "shuimu-jinwan");
        if (key->move(who)) {
          message_vision(HIW "一点白光从鼎内射入$N" HIW "身上。\n" NOR, who);
          tell_object(who, "你得到了" + key->query("name") + "。\n");
          CHANNEL_D->do_channel(
            this_object(),
            "rumor",
            "听说" + who->query("name") + HIM "得到了" + key->query("name") + HIM "！" NOR
          );
        } else destruct(key);
      }
    }

    if (!present("taiyi xuange", who)) {
      if (random(who->query_kar() / 2) > 15) {
        key = new(__DIR__ "taiyi-xuange");
        if (key->move(who)) {
          message_vision(HIG "一点青光从鼎内射入$N" HIG "身上。\n" NOR, who);
          tell_object(who, "你得到了" + key->query("name") + "。\n");
          CHANNEL_D->do_channel(
            this_object(),
            "rumor",
            "听说" + who->query("name") + HIM "得到了" + key->query("name") + HIM "！" NOR
          );
        } else destruct(key);
      }
    }

    if (!present("jingang lun", who)) {
      key = new(__DIR__ "jingang-lun");
      if (key->move(who)) {
        message_vision(HIY "一点金光从鼎内射入$N" HIY "身上。\n" NOR, who);
        tell_object(who, "你得到了" + key->query("name") + "。\n");
        CHANNEL_D->do_channel(
          this_object(),
          "rumor",
          "听说" + who->query("name") + HIM "得到了" + key->query("name") + HIM "！" NOR
        );
      } else destruct(key);
    }
    return;
  }
  damage = who->query("maximum_force");
  damage += who->query("max_kee") / 3 * 2;
  damage += random(damage / 2);
  damage -= random(who->query("mana")) / 2;
  who->delete_temp("last_damage_from");
  who->set_temp("death_msg", "在幻波池误触" HIR "机关" HIM "而亡！" NOR);
  message_vision(HIG "
鼎盖将起未起之际，全鼎顿放碧光，从鼎盖上原有的千万
小纽珠中猛喷出一束五色光线，万弩齐发般直朝$N" HIG "射去！\n" NOR, who);
  who->receive_wound("kee", damage);
  COMBAT_D->report_status(who, 1);
}

void quest(object who, int num) {
  remove_call_out("quest");
  if (!who || !present(who, environment()))
    return;
  switch (num) {
    case 1: tell_object(who, "\n你忽听身后有人微哂，后颈上吹来一口凉气。\n\n"); break;
    case 2: tell_object(who, "\n你方一迟疑，耳听哧的一声冷笑，接着脑后又是一股冷风吹来。\n\n"); break;
    case 3:
      message_vision("\n壁间遗像忽然转笑为怒，将手朝鼎上一指。\n\n", who);
      who->set_temp("huanbochi/dading_ok", 1);
      remove_call_out("quest_hit");
      call_out("quest_hit", 1 + random(4), who);
      break;
    default: return;
  }
}

int do_get(string arg) {
  int flag;
  string sth;
  object me = this_player();
  if (!arg)
    return 0;
  if (sscanf(arg, "%s from %s", sth, arg) != 2)
    return 0;
  if (!id(arg))
    return 0;
  if (me->is_busy()) {
    write("你现在正忙着呢。\n");
    return 1;
  }
  if (me->query_temp("huanbochi/dading_ok")) {
    write("不可反复。\n");
    return 1;
  }
  flag = me->query_temp("huanbochi/dading");
  if (flag <= 0)
    message_vision("$N抓住鼎盖，用力往上一揭，竟未将它揭动。\n", me);
  else if (flag == 1) {
    message_vision("$N又走向鼎侧，暗使大法力一揭。\n", me);
    if (me->query("mana") < 500) {
      write("你法力不够，结果什么反应没有。\n");
      return 1;
    }
    me->add("mana", -500);
  } else {
    flag = 2;
    message_vision("$N又去揭那鼎盖，用大力神法往上一提。\n", me);
    if (me->query("mana") < 800) {
      write("你法力不够，结果什么反应没有。\n");
      return 1;
    }
    me->add("mana", -800);
  }
  me->add_temp("huanbochi/dading", 1);
  me->start_busy(3);
  remove_call_out("quest");
  call_out("quest", 2, me, (flag + 1));
  return 1;
}

int do_open(string arg) {
  if (!arg || !id(arg))
    return 0;
  return do_get("all from ding");
}
