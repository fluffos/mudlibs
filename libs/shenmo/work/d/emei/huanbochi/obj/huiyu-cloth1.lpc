#include <armor.h>
#include <ansi.h>
inherit EQUIP;

void create()
{
        set_name("灰羽鹤氅", ({ "leather coat","coat","fabao","cloth" }) );
        set_weight(1600);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "cloth");
                set("value", 0);
                set("armor_type","FABAO");
                set("armor_prop/armor",18);
                set("armor_prop/spells",10);
                set("armor_prop/ob_hit",3);
                set("armor_prop/remove_kee_damage",8);
                set("armor_prop/remove_sen_damage",8);
                set("series_no",2);
                set("wear_msg","$N祭起$n，顿时一片华光罩住全身要害。\n");
                set("unequip_msg","$N撤去了护身华光。\n");
                set("no_steal",1);  
                set("wuxing","木");    
                set("fabao",1);   
                set("level",30);  
                set("class","中");  
                set("no_busy",1);                  
        }
        setup();
}

varargs int protect_qi(int damage,string wx)
{
        int xk;
        if( damage<=0 || !environment() 
         || !living(environment()) )
                return damage;
        if( time()<query_temp("last_protect_qi")+5 )
                return damage;
        if( !wx )
                wx = SPELL_D->query_time_wuxing();              
        if( wx && query("wuxing") )
        {       
                xk = SPELL_D->wuxing_xs(query("wuxing"),wx);
                if( xk==1 )
                        damage = damage/2;
                else    damage = damage-damage*5/100;           
        }       
        set("last_protect_qi",time());  
        if( environment()->query("mana")>100 )
        {
                environment()->add("mana",-100);
                message_vision(HIC"$N"HIC"身上护身华光闪了一闪。\n"NOR,environment());
                damage = damage*7/8;
        }       
        return  damage; 
}

