#include <armor.h>
#include <ansi.h>
inherit EQUIP;
inherit F_UNIQUE; 

void create()
{
        set_name(HIY"紫荷包"NOR, ({ "loyal bonnet", "bonnet", "hat" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else 
        {
                set("unit", "件");
                set("long", "一件长约七八寸紫色的小荷包。\n");
                set("material", "steel");
                set("value", 0);
                set("no_sell", 1);
                set("no_put",1);
                set("armor_type","bag");
                set("series_no",2);
                set("replace_file", "/d/city/npc/obj/pifeng"); 
                set("armor_prop/remove_kee_damage",8);
                set("armor_prop/remove_sen_damage",8);
                set("armor_prop/intelligence", 7);              
                set("armor_prop/armor",5);
                set("armor_prop/strength",5);           
                set("no_steal",1);              
        }
        setup();
}

