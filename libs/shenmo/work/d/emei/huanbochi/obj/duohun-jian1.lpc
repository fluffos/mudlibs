#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create() {
  set_name(HIB "夺魂剑
" NOR, ({ "duo hun jian", "sword", "jian" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 0);
    set("material", "iron");
    set("wield_msg", HIR "$N吐出一口鲜血，化成一柄$n，擎在手中掂了掂。\n" NOR);
    set("no_steal", 1);
    set("no_put", 1);
  }
  init_sword(200);
  setup();
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  object fb;
  int damage = 100;
  if (!me || !victim || !me->is_fighting(victim)
    || damage_bonus <= 0 || userp(me))
    return 0;
  add_temp("hit", 1);
  if (query_temp("hit") % 3 == 0) {
    fb = victim->query_temp("armor/FABAO");
    if (fb)
      damage = fb->protect_qi(damage);
    if (damage <= 0)
      return 0;
    victim->receive_damage("kee", damage, me);
    me->receive_curing("kee", damage / 10);
    me->receive_heal("kee", damage / 10);
    set_temp("hit", 1);
    return HIR "$N" HIR "三剑已出，$w" HIR "上血气冲天！\n" NOR;
  }
  return 0;
}
