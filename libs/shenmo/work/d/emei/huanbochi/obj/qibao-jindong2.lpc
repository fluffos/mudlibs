//防御类法宝，护体神光之类
#include <ansi.h>
inherit EQUIP;

void create()
{
        set_name(HIC"七宝金幢"NOR, ({ "qibao jindong", "dong","fabao" }) );
        set_weight(3000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("value", 0);
                set("material", "shuijing");
                set("long", "出自青莲峪的法宝，似幡非幡，略似华盖，共有七层，四边璎珞垂珠，每层上面各现出一种不同形式的宝光。\n");
                set("series_no",2);                       //法宝类型
                set("wuxing","水");                       //法宝五行
                set("level",600);                         //法宝等级
                set("no_steal",1);
                set("no_get",1);
                set("no_put",1);                          //下面是装备卸除描述
                set("wear_msg", HIC"只见七宝金幢发出七色光华，融会成一幢彩霞，$N"HIC"在其内庄严雄丽，气象万千。\n"NOR);
                set("armor_type","FABAO");                //armor_type,这样一人只能装备一个防御法宝，且不需要用all_inventory来取得        
                set("armor_prop/armor",50);             
                set("armor_prop/spells",50);
                set("class","正");                        //法宝正邪
                set("no_busy",1);                       
        }
        setup();
}

//特殊类法宝专门克制某些法宝，比如佛门至宝专克阴邪法宝，攻击性阴邪法宝攻击时调用此函数，
//如果本法宝克制对方，则攻击伤害为0，需要在攻击性法宝里单独调用判断
nosave int fabao_ke(object fb)
{
        return 0;
}       

//对攻击法宝kee伤害的伤害抵消，根据法宝的阶地自行定义
//法宝五行相克也在这里实现
varargs int protect_qi(int damage,string wx)
{
        return  damage; 
}

//对攻击法宝sen伤害的伤害抵消，根据法宝的阶地自行定义
varargs int protect_shen(int damage,string wx)
{
        return  damage; 
}

int ji(string id)
{
        int t,ap,dp;
        object target,me;
        me = environment();
        if( !me || !living(me) )
                return 0;
        if( me->query("mana")<query("level")*2 )
                return notify_fail("你的法力不足。\n");                
        if( !me->is_fighting() )
                return notify_fail("你要对谁祭法宝？\n");
        if( me->query("level")<query("level") )
                return notify_fail("你等级不够"+query("level")+"，祭不起"+query("name")+"。\n");
        if( time()<query("last_ji")+2 )
                return notify_fail(query("name")+"刚刚祭出过。\n");     
        set("last_ji",time());  
        return notify_fail("你念了念咒语，结果"+query("name")+"没有反应，分明是个假货。\n");
}


