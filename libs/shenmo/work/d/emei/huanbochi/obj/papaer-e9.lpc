inherit ITEM;

void create() {
  set_name("纸条", ({ "zhi tiao", "zhi" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一张泛黄的纸条，上面写着「今日东石室入口暗号为：%s」\n");
    set("unit", "张");
    set("value", 1);
  }
  setup();
}

void info_obj(object who) {
  string long;
  if (!who || userp(who))
    long = "******";
  else if (!who->query("code"))
    long = "*******";
  else long = who->query("code");
  long = sprintf("一张泛黄的纸条，上面写着「今日东石室入口暗号为：%s」\n", long);
  set("long", long);
}
