//防御类法宝，护体神光之类
#include <ansi.h>
inherit EQUIP;
inherit F_UNIQUE; 

void create()
{
        set_name(HIC"七宝金幢"NOR, ({ "qibao jindong", "dong","fabao" }) );
        set_weight(3000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("value", 0);
                set("material", "shuijing");
                set("long", "出自青莲峪的法宝，似幡非幡，略似华盖，共有七层，四边璎珞垂珠，每层上面各现出一种不同形式的宝光。\n");
                set("replace_file", "/d/obj/flower/hua"); //替代文件
                set("series_no",2);                       //法宝类型
                set("wuxing","水");                       //法宝五行
                set("level",200);                         //法宝等级
                set("no_steal",1);
                set("no_get",1);
                set("no_put",1);                          //下面是装备卸除描述
                set("wear_msg", HIC"只见七宝金幢发出七色光华，融会成一幢彩霞，$N"HIC"在其内庄严雄丽，气象万千。\n"NOR);
                set("armor_type","FABAO");                //armor_type,这样一人只能装备一个防御法宝，且不需要用all_inventory来取得        
                set("armor_prop/armor",50);             
                set("armor_prop/spells",50);
                set("armor_prop/ob_hit",10);
                set("armor_prop/redamage_kee_damage",20);       //新加的扩展功能 伤害反弹比率
                set("armor_prop/redamage_eff_kee_damage",5);  
                set("class","正");                        //法宝正邪
                set("no_busy",1);                       
        }
        setup();
}

//特殊类法宝专门克制某些法宝，比如佛门至宝专克阴邪法宝，攻击性阴邪法宝攻击时调用此函数，
//如果本法宝克制对方，则攻击伤害为0，需要在攻击性法宝里单独调用判断
nosave int fabao_ke(object fb)
{
        int ap,dp;
        if( !fb )
                return 0;
        ap = query("level");
        dp = fb->query("level");
        if( fb->query("class") && fb->query("class")=="邪" )
                dp-= random(dp/3);
        if( random(100)>dp/(ap+dp)*100 || ap>dp )       
        {
                message_vision(HIC"$N"HIC"发出七色光华，融会成一幢彩霞，庄严雄丽，气象万千，将$n"HIC"架在半空。\n"NOR,this_object(),fb);
                return 1;
        }
        return 0;
}       

//对攻击法宝kee伤害的伤害抵消，根据法宝的阶地自行定义
//法宝五行相克也在这里实现
varargs int protect_qi(int damage,string wx)
{
        int xk;
        if( damage<=0 || !environment() 
         || !living(environment()) )
                return damage;
        if( time()<query_temp("last_protect_qi")+5 )
                return damage;
        if( !wx )
                wx = SPELL_D->query_time_wuxing();              
        if( wx && query("wuxing") )
        {       
                xk = SPELL_D->wuxing_xs(query("wuxing"),wx);
                if( xk==1 )
                        damage = damage/2;
        }       
        set("last_protect_qi",time());  
        if( environment()->query("mana")<100 )
        {
                message_vision(HIC"$N"HIC"身上发出七色光华，融会成一幢庄严雄丽的彩霞。\n"NOR,environment());
                return damage*4/5;
        }
        environment()->add("mana",-100);
        message_vision(HIC"$N"HIC"身上$n"HIC"发出七色光华，融会成一幢庄严雄丽的彩霞。\n"NOR,environment(),this_object());
        return  damage/5;       
}

//对攻击法宝sen伤害的伤害抵消，根据法宝的阶地自行定义
varargs int protect_shen(int damage,string wx)
{
        int xk;
        if( damage<=0 || !environment() 
         || !living(environment()) )
                return damage;
        if( time()<query_temp("last_protect_shen")+5 )
                return damage;
        if( !wx )
                wx = SPELL_D->query_time_wuxing();              
        if( wx && query("wuxing") )
        {       
                xk = SPELL_D->wuxing_xs(query("wuxing"),wx);
                if( xk==1 )
                        damage = damage/2;
                else    damage = damage-damage*5/100;           
        }       
        set("last_protect_shen",time());        
        if( environment()->query("mana")<100 )
        {
                message_vision(HIC"$N"HIC"身上发出七色光华，融会成一幢庄严雄丽的彩霞。\n"NOR,environment());
                return damage*4/5;
        }
        environment()->add("mana",-100);
        message_vision(HIC"$N"HIC"身上$n"HIC"发出七色光华，融会成一幢庄严雄丽的彩霞。\n"NOR,environment(),this_object());
        return  damage/5;       
}

int do_fabao1(object me,object target)
{
        int ap,dp,damage;
        if( !me || !target || !me->is_fighting(target) )
                return notify_fail("你要对谁祭法宝？\n");
        set("is_ji",1); 
        set("last_ji",time());
        ap = me->query("daoxing")/100000+me->query("level")*1000;
        dp = target->query("daoxing")/100000+target->query("level")*1000;       
        if( random(100)>dp/(ap+dp)*100 )
        {       
                if( me->query("env/no_msg") || target->query("env/no_msg") )
                        message_vision(HIC"$N"HIC"对$n"HIC"使用了法宝「"HIY+query("name")+NOR HIC"」。\n"NOR,me,target);
                else    message_vision(HIC"$N"HIC"将"HIC+query("name")+HIC"对空一抛，化出两环连环宝圈，朝向$n"HIC"卷去！\n"NOR,me,target);
                damage = me->query_skill("spells")/100;
                if( damage<1 )  damage = 1;
                if( damage>10 ) damage = 10;
                message_vision(HIR"$N"HIR"果然被这光环套住，当时目瞪口呆，不知所措！\n"NOR,target);
                target->start_busy(damage);
                return 1;
        }
        return notify_fail("你祭法宝失败。\n");
}

int do_fabao2(object me,object target)
{
        int xk,ap,dp,damage;
        string wx;
        object fb;
        if( !me || !target || !me->is_fighting(target) )
                return notify_fail("你要对谁祭法宝？\n");
        set("is_ji",2); 
        set("last_ji",time());  
        ap = me->query("daoxing")/100000+me->query("level")*1000;
        dp = target->query("daoxing")/100000+target->query("level")*1000;       
        if( random(100)>dp/(ap+dp)*98 )
        {
                if( me->query("env/no_msg") || target->query("env/no_msg") )
                        message_vision(HIC"$N"HIC"对$n"HIC"使用了法宝「"HIY+query("name")+NOR HIC"」。\n"NOR,me,target);
                else    message_vision(HIR+query("name")+HIR"中旋出一朱色巨轮，四边烈焰环绕，熊熊欲燃，朝向$N"HIR"卷去！\n"NOR,target);
                message_vision(HIR"结果$N"HIR"困在烈焰中间，顿时精神一振萎靡。\n"NOR,target);                                                  
                damage = query("damage");
                damage+= me->query("mana_factor");
                if( wx=query("wuxing") )
                {       
                        xk = SPELL_D->wuxing_xs(SPELL_D->query_time_wuxing(),wx);
                        if( xk==1 )
                                damage = damage/2;
                        else if( xk==-1 )
                                damage+= damage/3;
                }                                               
                fb = target->query_temp("armor/FABAO");
                if( fb )
                        damage = fb->protect_shen(damage);
                if( target->query("water")>50 )
                        target->add("water",-50);
                if( damage>0 )
                {       
                        target->receive_wound("sen",damage,me);
                        COMBAT_D->report_sen_status(target,1);
                }
                return 1;
        }       
        return notify_fail("你祭法宝失败。\n");
}
                        
int do_fabao3(object me,object target)
{
        int i,ap,dp,damage;
        mapping armor;
        object *aa,obj;
        if( !me || !target || !me->is_fighting(target) )
                return notify_fail("你要对谁祭法宝？\n");
        set("is_ji",3);
        set("last_ji",time());          
        ap = me->query("daoxing")/100000+me->query("level")*1000;
        dp = target->query("daoxing")/100000+target->query("level")*1000;       
        if( random(100)>dp/(ap+dp)*96 )
        {
                if( me->query("env/no_msg") || target->query("env/no_msg") )
                        message_vision(HIC"$N"HIC"对$n"HIC"使用了法宝「"HIY+query("name")+NOR HIC"」。\n"NOR,me,target);
                else    message_vision(HIY+query("name")+HIY"中飞出一佛宝钵盂，朝向$N"HIY"罩去！\n"NOR,target);
                armor = target->query_temp("armor");
                if( armor && mapp(armor) )
                {
                        aa = values(armor);
                        if( aa && arrayp(aa) && sizeof(aa)>0 )
                                obj = aa[random(sizeof(aa))];
                }
                if( obj && obj->query("armor_type")!="FABAO" )
                {
                        message_vision(HIW"只见钵盂发出一道白光，瞬间将$N"HIW"身上"+obj->query("name")+HIW"收将进去！\n"NOR,target);
                        obj->unequip();
                        destruct(obj);
                }
                return 1;
        }               
        return notify_fail("你祭法宝失败。\n");
}               

