int do_fabao7(object me,object target)
{
        int xk,ap,dp,damage;
        string wx,msg;
        object fb;      
        if( !me || !target || !me->is_fighting(target) )
                return notify_fail("你要对谁祭法宝？\n");
        set("is_ji",0); 
        set("last_ji",time()+10);
        ap = me->query("daoxing")/100000+me->query("level")*1000;
        dp = target->query("daoxing")/100000+target->query("level")*1000;       
        if( random(100)>dp/(ap+dp)*85 )
        {       
                if( me->query("env/no_msg") || target->query("env/no_msg") )
                        message_vision(HIC"$N"HIC"对$n"HIC"使用了法宝「"HIY+query("name")+NOR HIC"」。\n"NOR,me,target);
                else    message_vision(HIC"$N"HIC"的"HIC+query("name")+HIC"化出一面宝镜，发出一幕炫目精光朝向$n"HIC"卷去！\n"NOR,me,target);
                damage = query("damage");
                damage+= me->query("mana_factor");
                if( wx=query("wuxing") )
                {       
                        xk = SPELL_D->wuxing_xs(SPELL_D->query_time_wuxing(),wx);
                        if( xk==1 )
                                damage = damage/2;
                        else if( xk==-1 )
                                damage+= damage/3;
                }                                               
                fb = target->query_temp("armor/FABAO");
                if( fb )
                        damage = fb->protect_qi(damage);
                if( damage>0 )
                {       
                        msg = HIC+COMBAT_D->damage_msg(damage,"抽伤")+NOR;
                        msg = replace_string(msg,"$l","身体");
                        msg = replace_string(msg,"$w","光华");
                        message_vision(msg,me,target);
                        target->receive_wound("kee",damage,me);
                        COMBAT_D->report_status(target,1);
                }
                return 1;
        }
        return notify_fail("你祭法宝失败。\n");
}

int ji(string id)
{
        int t,ap,dp;
        object target,me;
        me = environment();
        if( !me || !living(me) )
                return 0;
        if( me->query("mana")<query("level")*2 )
                return notify_fail("你的法力不足。\n");                
        if( !me->is_fighting() )
                return notify_fail("你要对谁祭法宝？\n");
        if( me->query("level")<query("level") )
                return notify_fail("你等级不够"+query("level")+"，祭不起"+query("name")+"。\n");
        if( time()<query("last_ji")+2 )
                return notify_fail(query("name")+"刚刚祭出过。\n");     
        if( id )
        {
                target = present(id, environment(me));
                if( !target )
                        return notify_fail("这里没有"+id+"。\n");
        }
        else    target = SSERVER->offensive_target(me);
        if( !target || !me->is_fighting(target) )
                return notify_fail("你要对谁祭"+query("name")+"？\n");
        me->add("mana",-query("level")*2);                
        switch(query("is_ji"))
        {
                case 0 : return do_fabao1(me,target);
                case 1 : return do_fabao2(me,target);
                case 2 : return do_fabao3(me,target);
                case 3 : return do_fabao4(me,target);
                case 4 : return do_fabao5(me,target);
                case 5 : return do_fabao6(me,target);
                case 6 : return do_fabao7(me,target);
        }
}
