                {       
                        msg = HIC+COMBAT_D->damage_msg(damage,"刺伤")+NOR;
                        msg = replace_string(msg,"$l","全身");
                        msg = replace_string(msg,"$w","慧剑");
                        message_vision(msg,me,target);
                        target->receive_damage("kee",damage,me);
                        COMBAT_D->report_status(target);
                }
                return 1;
        }       
        return notify_fail("你祭法宝失败。\n");
}

