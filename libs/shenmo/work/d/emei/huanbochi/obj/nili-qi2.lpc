#include <ansi.h>
inherit ITEM;

void create()
{
        set_name(HIW"泥犁旗"NOR, ({ "nili qi", "qi","flag" }) );
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "面");
                set("level",180);
                set("value", 0);
                set("material", "shuijing");
                set("long", "五鬼天王尚和阳修炼的法宝之一，用之能隐匿行踪。\n");
                set("series_no",4);
                set("damage",800);
                set("no_steal",1);    
                set("no_put",1);       
                set("fabao",1);    
                set("no_busy",1);                
        }
        setup();
}

int ji(string id)
{
        string str,name;
        int i,t;
        object *team,me;
        me = environment();
        if( !me || !living(me) )
                return 0;
        if( me->query("level")<query("level") )
                return notify_fail("你等级不够"+query("level")+"，祭不起"+query("name")+"。\n");
        if( time()<query("last_ji")+5 )
                return notify_fail(query("name")+"刚刚祭出过。\n");                    
        if( me->query("mana")<1000 )
                return notify_fail("你的法力不够了。\n");
        if( me->query("env/invisibility") )
                return notify_fail("多此一举。\n");
        set("last_ji",time());  
        return notify_fail("你念了念咒语，结果"+query("name")+"没有反应，分明是个假货。\n");
}
