#include <armor.h>
#include <ansi.h>
inherit EQUIP;

void create()
{
        set_name("青色道袍", ({ "dao pao", "cloth" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else 
        {
                set("unit", "件");
                set("long", "一件峨眉弟子的练功服。\n");
                set("material", "steel");
                set("value", 0);
                set("no_sell", 1);
                set("no_put",1);
                set("armor_prop/armor",25);
                set("series_no",2);
                set("armor_type","cloth");
                set("armor_prop/remove_eff_kee_damage",5);
                set("armor_prop/remove_eff_sen_damage",5);
                set("no_steal",1);
        }
        setup();
}

