#include <armor.h>
#include <ansi.h>
inherit EQUIP;

void create()
{
        set_name("灰羽鹤氅", ({ "leather coat","coat","fabao","cloth" }) );
        set_weight(1600);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("material", "cloth");
                set("value", 0);
                set("armor_type","FABAO");
                set("armor_prop/armor",18);
                set("armor_prop/spells",10);
                set("armor_prop/ob_hit",3);
                set("armor_prop/remove_kee_damage",2);
                set("armor_prop/remove_sen_damage",2);
                set("series_no",2);
                set("no_steal",1);  
                set("wuxing","木");    
                set("fabao",1);   
                set("level",30);  
                set("class","中");  
                set("no_busy",1);                  
        }
        setup();
}

varargs int protect_qi(int damage,string wx)
{
        return  damage; 
}

varargs int protect_shen(int damage,string wx)
{
        return  damage; 
}
