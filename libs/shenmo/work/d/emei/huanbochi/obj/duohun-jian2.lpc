#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create()
{
        set_name(HIB"夺魂剑
"NOR, ({ "duo hun jian", "sword","jian" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("value", 0);
                set("material", "iron");
                set("no_steal",1);    
                set("no_put",1);   
        }
        init_sword(210);
        setup();
}

