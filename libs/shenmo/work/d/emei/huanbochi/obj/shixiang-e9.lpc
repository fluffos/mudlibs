#include <ansi.h>
#include <room.h>
inherit ITEM;

void create()
{
        set_name("大石像", ({"shi xiang", "xiang"}));
        set_weight(100000000000000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一座高大的石像。\n");
                set("unit", "座");
                set("no_get","你是大力士吧？这个也想拿起来？");
        }
        setup();
        set("num",1+random(8));
        set("nums",query("num"));
        set("ture",1+random(8));
}

void init()
{
        add_action("do_turn","turn");
}

string long()
{
        string str;
        switch(query("num")) 
        {
                case 1 : str = "北";break;
                case 2 : str = "东北";break;
                case 3 : str = "东";break;
                case 4 : str = "东南";break;
                case 5 : str = "南";break;
                case 6 : str = "西南";break;
                case 7 : str = "西";break;
                case 8 : str = "西北";break;
                default : return ::long();
        }
        str = "一座高大的石像，面朝"+str+"方。\n";
        return str;
}

int err_msg(string arg)
{
        write(arg);
        return 1;
}

void close(object obj)
{
        object env;
        remove_call_out("close");
        if( !obj || !environment(obj) )
                return;
        env = environment(obj);
        if( base_name(env)!="/d/emei/huanbochi/yd-e9" )
                return;
        if( env->close_door("north") )
                tell_room(env,"\n\n轰隆一声，石像转了几转，又恢复了原位。\n");                  
}

int do_turn(string arg)
{
        int i,n,k;
        mapping doors;
        object env;
        string msg;
        
        if( environment()->is_character() )
                return 0;
        
        if( !arg 
         || (arg!="right" && arg!="left") )
                return err_msg("你抱着石像死命的转动，累得满身大汗。\n");
        if( this_player()->is_busy() )
                return err_msg("你正忙着。\n");
        n = query("num");
        if( arg=="left" )
        {
                msg = "西";
                i = -1;
        }
        else            
        {
                msg = "东";
                i = 1;
        }
        k = query("ture")-query("nums");
        if( k<0 )
                k = -k;
                
        message_vision("$N抱住石像，向"+msg+"转了转。\n",this_player());
        this_player()->start_busy(1);
        this_player()->add_temp("huanbochi/e9ture",1);
        if( this_player()->query_temp("huanbochi/e9ture")>k )
        {
                message_vision("$N手里不小心一滑，石像轰的一声又转回了原位。\n",this_player());
                set("num",query("nums"));
                this_player()->delete_temp("huanbochi/e9ture");
                return 1;       
        }
        
        n+= i;
        if( n>8 )
                n = 1;
        if( n<=0 )
                n = 8;
        set("num",n);
        env = environment();
        doors = env->query_doors();
        if( doors["north"]["status"] == DOOR_CLOSED )
        {
                if( query("num")==query("ture") )
                {
                        if( env->open_door("north") )
                        {
                                message_vision("轰隆一声，石像缓缓嵌入石壁之中，露出了一个大门。\n",this_player());
                                call_out("close",10,this_object());
                        }
                                                        
                }
        }
        return 1;
}
        
int is_statue(){return 1;}                                              
                                
                
