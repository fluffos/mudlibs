#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create() {
  set_name(HIR "红短衫" NOR, ({ "hong duanshan", "duanshan", "cloth" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "一件血光冲天的短衫。\n");
    set("material", "steel");
    set("value", 0);
    set("no_sell", 1);
    set("no_put", 1);
    set("armor_prop/armor", 25);
    set("series_no", 2);
    set("no_steal", 1);
    set("armor_prop/ad_spells", 15);
  }
  setup();
}
