#include <armor.h>
#include <ansi.h>
inherit EQUIP;

void create() {
  set_name("黑色道袍", ({ "dao pao", "cloth" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "一件玄色八卦道袍。\n");
    set("material", "steel");
    set("value", 0);
    set("no_sell", 1);
    set("no_put", 1);
    set("armor_prop/armor", 25);
    set("series_no", 2);
    set("armor_type", "cloth");
    set("armor_prop/remove_eff_kee_damage", 5);
    set("armor_prop/remove_eff_sen_damage", 5);
    set("no_steal", 1);
  }
  setup();
}


varargs int protect_qi(int damage, string wx) {
  int xk;
  if (damage <= 0 || !environment()
    || !living(environment()))
    return damage;
  if (time() < query_temp("last_protect_qi") + 5)
    return damage;
  if (!wx)
    wx = SPELL_D->query_time_wuxing();
  if (wx && query("wuxing")) {
    xk = SPELL_D->wuxing_xs(query("wuxing"), wx);
    if (xk == 1)
      damage = damage * 2 / 3;
    else damage = damage - damage / 25;
  }
  set("last_protect_qi", time());
  if (environment()->query("mana") > 100) {
    environment()->add("mana", -100);
    message_vision(HIB "$N" HIB "护身妖光闪了一闪，卸去了不少的伤害。\n" NOR, environment());
    return damage / 3;
  }
  return damage;
}

