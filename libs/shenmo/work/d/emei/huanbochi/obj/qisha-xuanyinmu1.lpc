//防御类法宝，护体神光之类
#include <ansi.h>
inherit EQUIP;

void create() {
  set_name(HIB "七煞玄阴神幕" NOR, ({ "qisha xuanyin mu", "mu", "fabao" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("value", 0);
    set("material", "shuijing");
    set("long", "毒手摩什炼制的法宝之一，近可防身，远可制敌。\n");
    set("series_no", 2);                       //法宝类型
    set("wuxing", "水");                       //法宝五行
    set("level", 600);                         //法宝等级
    set("damage", 1000);
    set("no_steal", 1);
    set("no_get", 1);
    set("no_put", 1);                          //下面是装备卸除描述
    set("wear_msg", HIB "$N" HIB "将手一招，一片乌金色的云霞，涛崩潮涌，展布甚宽。片片妖云，杂着无数魔鬼影子，惨啸如潮，将$P裹将起来。\n" NOR);
    set("armor_type", "FABAO");                //armor_type,这样一人只能装备一个防御法宝，且不需要用all_inventory来取得        
    set("armor_prop/armor", 55);
    set("armor_prop/ad_spells", 20);
    set("armor_prop/ob_hit", 10);
    set("armor_prop/redamage_kee_damage", 15);       //新加的扩展功能 伤害反弹比率
    set("armor_prop/redamage_eff_kee_damage", 10);
    set("class", "邪");                        //法宝正邪
    set("no_busy", 1);
  }
  setup();
}

//特殊类法宝专门克制某些法宝，比如佛门至宝专克阴邪法宝，攻击性阴邪法宝攻击时调用此函数，
//如果本法宝克制对方，则攻击伤害为0，需要在攻击性法宝里单独调用判断
nosave int fabao_ke(object fb) {
  int ap, dp;
  if (!fb)
    return 0;
  ap = query("level");
  dp = fb->query("level");
  if (fb->query("class") && fb->query("class") == "正")
    dp -= random(dp / 3);
  if (random(100) > dp / (ap + dp) * 110 || ap > dp) {
    message_vision(HIB "片片妖云，杂着无数魔鬼影子，惨啸如潮。似天倾一般，向$N" HIB "罩将下来。。\n" NOR, fb);
    return 1;
  }
  return 0;
}

//对攻击法宝kee伤害的伤害抵消，根据法宝的阶地自行定义
//法宝五行相克也在这里实现
varargs int protect_qi(int damage, string wx) {
  int xk;
  if (damage <= 0 || !environment()
    || !living(environment()))
    return damage;
  if (time() < query_temp("last_protect_qi") + 5)
    return damage;
  if (!wx)
    wx = SPELL_D->query_time_wuxing();
  if (wx && query("wuxing")) {
    xk = SPELL_D->wuxing_xs(query("wuxing"), wx);
    if (xk == 1)
      damage = damage / 2;
  }
  set("last_protect_qi", time());
  if (environment()->query("mana") < 100) {
    return damage;
  }
  environment()->add("mana", -100);
  message_vision(HIB "$N" HIB "身上妖云叠荡，一阵翻滚。\n" NOR, environment());
  return damage / 3;
}

//对攻击法宝sen伤害的伤害抵消，根据法宝的阶地自行定义
varargs int protect_shen(int damage, string wx) {
  int xk;
  if (damage <= 0 || !environment()
    || !living(environment()))
    return damage;
  if (time() < query_temp("last_protect_shen") + 5)
    return damage;
  if (!wx)
    wx = SPELL_D->query_time_wuxing();
  if (wx && query("wuxing")) {
    xk = SPELL_D->wuxing_xs(query("wuxing"), wx);
    if (xk == 1)
      damage = damage / 2;
  }
  set("last_protect_shen", time());
  if (environment()->query("mana") < 150) {
    return damage;
  }
  environment()->add("mana", -150);
  message_vision(HIB "$N" HIB "身上妖云叠荡，一阵翻滚。\n" NOR, environment());
  return damage / 4;
}


int ji(string id) {
  string msg, limb, *limbs, wx;
  int xk, ap, dp, damage;
  object fb, target, me;
  me = environment();
  if (!me || !living(me))
    return 0;
  if (!me->is_fighting())
    return notify_fail("你要对谁祭法宝？\n");
  if (me->query("level") < query("level"))
    return notify_fail("你等级不够" + query("level") + "，祭不起" + query("name") + "。\n");
  if (time() < query("last_ji") + 5)
    return notify_fail(query("name") + "刚刚祭出过。\n");
  if (me->query("mana") < 300)
    return notify_fail("你法力不足。\n");
  if (id) {
    target = present(id, environment(me));
    if (!target)
      return notify_fail("这里没有" + id + "。\n");
  } else target = SSERVER->offensive_target(me);
  if (!target || !me->is_fighting(target))
    return notify_fail("你要对谁祭" + query("name") + "？\n");

  set("last_ji", time());
  me->add("mana", -300);
  ap = me->query("daoxing") / 100000 + me->query("level") * 1000;
  dp = target->query("daoxing") / 100000 + target->query("level") * 1000;

  if (me->query("env/no_msg") || target->query("env/no_msg"))
    message_vision(
      MAG "$N" MAG "对$n" MAG "使用了法宝「" HIY + query("name") + NOR MAG "」。\n" NOR,
      me,
      target
    );
  else message_vision(
    MAG "$N" MAG "将手一招，顿时一片乌金色的云霞展布甚宽，涛崩潮涌，片片妖云，杂着无数魔鬼影子，惨啸如潮。\n似天倾一般，朝$n" MAG "罩将下来，立时星月无光。\n" NOR,
    me,
    target
  );

  if (random(100) > dp / (ap + dp) * 90) {
    fb = target->query_temp("armor/FABAO");
    if (fb) {
      if (fb->fabao_ke(this_object()))
        return 1;
      ap = me->query("mana") + query("level") * 100;
      dp = target->query("mana") + fb->query("level") * 100;
      if (random(100) > dp / (ap + dp) * 150 && query("level") > fb->query("level") * 2 / 3) {
        message_vision(
          HIB "只见$N" HIB "身上的" + fb->query("name") + HIB "在妖光中闪了两闪，便自纷纷爆裂，在乌金云光中洒了一蓬星花彩雨，晃眼消灭。\n" NOR,
          target
        );
        fb->unequip();
        destruct(fb);
      }
    }

    damage = me->query("mana_factor");
    damage += query("damage");
    damage += random(me->query("mana"));
    //法宝伤害的五行加成，
    if (wx = query("wuxing")) {
      xk = SPELL_D->wuxing_xs(SPELL_D->query_time_wuxing(), wx);
      if (xk == 1)
        damage = damage / 2;
      else if (xk == -1)
        damage += damage / 3;
    }
    fb = target->query_temp("armor/FABAO");
    if (fb)
      damage = fb->protect_shen(damage, query("wuxing"));
    if (damage > 0) {
      msg = RED "$n" RED "全身只觉一紧，顿时被烈火焚烧，万箭攒射，并还麻痒，苦痛有甚于死。\n" NOR;
      msg = RED + COMBAT_D->damage_msg(damage, "抽伤") + NOR;
      msg = replace_string(msg, "$w", "烈火");
      msg = replace_string(msg, "$l", "全身");
      message_vision(msg, me, target);
      target->receive_wound("sen", damage, me);
      COMBAT_D->report_sen_status(target, 1);
    }
  } else message_vision(
    HIC "$N" HIC "哼！了一声：米粒之珠，也放光华？说罢，将手一指，结果血光大盛，" + query("name") + HIC "发出一声哀鸣，从半空落了下来。\n" NOR,
    target
  );
  return 1;
}
