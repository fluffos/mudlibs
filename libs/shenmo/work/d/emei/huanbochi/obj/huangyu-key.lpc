#include <ansi.h>
inherit ITEM;
inherit F_UNIQUE;

void create() {
  set_name(HIY "黄玉钥匙" NOR, ({ "huanyu yaoshi", "key", }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "枚");
    set("long", "一枚黄色玉雕古匙，上面笼罩着一股浓厚的金石之气。\n");
    set("material", "stone");
    set("value", 0);
    set("no_sell", 1);
    set("no_put", 1);
    set("no_steal", 1);
    set("replace_file", "/d/qujing/wudidong/obj/key-fake");
  }
  setup();
}
