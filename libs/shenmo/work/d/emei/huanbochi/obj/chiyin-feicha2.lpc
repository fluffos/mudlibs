#include <weapon.h>
#include <ansi.h>
inherit FORK;

void create()
{
        set_name("赤阴飞叉", ({ "chiyin cha", "fei cha","fork","cha" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("value", 0);
                set("material", "iron");
                set("long", "妙化真人漆章之师赤霞神君丙融修炼的法宝之一。\n");
                set("series_no",1);
                set("no_steal",1);    
                set("no_put",1);            
        }
        init_fork(205);
        setup();
        set("weapon_prop/ad_fork",5);
}

