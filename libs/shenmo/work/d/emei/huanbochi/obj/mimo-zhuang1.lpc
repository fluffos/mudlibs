#include <armor.h>
#include <ansi.h>
inherit EQUIP;

void create()
{
        set_name(HIG"秘魔神装"NOR, ({ "mimo zhuang","zhuang","fabao","cloth" }) );
        set_weight(1600);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "套");
                set("long","为赤身教镇山之宝之一，上件是翠鸟羽毛和树叶合织而成的云肩，色作深碧，光彩鲜明，后面露着脊背，下件是一条同样面料的短战裙。\n");
                set("material", "cloth");
                set("value", 0);
                set("armor_type","FABAO");
                set("armor_prop/armor",28);
                set("armor_prop/spells",10);
                set("armor_prop/force",10);
                set("armor_prop/ob_hit",5);
                set("armor_prop/remove_kee_damage",8);
                set("armor_prop/remove_sen_damage",8);
                set("armor_prop/remove_eff_kee_damage",8);
                set("armor_prop/remove_eff_sen_damage",8);
                set("series_no",2);
                set("wear_msg", HIC"$N"HIC"装备上$n"HIC"，只见$P柔肌粉腻，掩映生辉，仿佛艳绝，通体黑烟围绕，若沉若浮，凌虚而立。\n"NOR);
                set("female_only", 1);
                set("no_steal",1);  
                set("wuxing","木");  
                set("class","邪");  
                set("level",150);       
                set("no_busy",1);                   
        }
        setup();
}

varargs int protect_qi(int damage,string wx)
{
        int xk;
        if( damage<=0 || !environment() 
         || !living(environment()) )
                return damage;
        if( time()<query_temp("last_protect_qi")+5 )
                return damage;
        if( !wx )
                wx = SPELL_D->query_time_wuxing();              
        if( wx && query("wuxing") )
        {       
                xk = SPELL_D->wuxing_xs(query("wuxing"),wx);
                if( xk==1 )
                        damage = damage/2;
        }       
        set("last_protect_qi",time());  
        if( environment()->query("mana")>100 )
        {
                environment()->add("mana",-100);
                message_vision(HIG"$N"HIG"身上卷起千万绿叶，卸去了不少的伤害。\n"NOR,environment());
                return damage*4/5;
        }
        return damage;
}

varargs int protect_shen(int damage,string wx)
{
        int xk;
        if( damage<=0 || !environment() 
         || !living(environment()) )
                return damage;
        if( time()<query_temp("last_protect_shen")+5 )
                return damage;
        if( !wx )
                wx = SPELL_D->query_time_wuxing();              
        if( wx && query("wuxing") )
        {       
                xk = SPELL_D->wuxing_xs(query("wuxing"),wx);
                if( xk==1 )
                        damage = damage/2;
                else    damage = damage-damage*5/100;           
        }       
        set("last_protect_shen",time());        
        if( environment()->query("mana")>100 )
        {
                environment()->add("mana",-100);
                message_vision(HIG"$N"HIG"身上卷起千万绿叶，卸去了不少的伤害。\n"NOR,environment());
                return damage*4/5;
        }
        return damage;
}       
