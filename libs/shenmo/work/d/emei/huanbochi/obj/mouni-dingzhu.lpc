//防御类法宝，护体神光之类
#include <ansi.h>
inherit EQUIP;
inherit F_UNIQUE; 

void create()
{
        set_name(HIC"牟尼定珠"NOR, ({ "mouni dingzhu", "zhu","fabao" }) );
        set_weight(3000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("value", 0);
                set("material", "shuijing");
                set("long", "白眉禅师所炼的法宝之一，莹莹欲流，晶辉朗耀。\n");
                set("replace_file", "/d/obj/baowu/leizhu"); //替代文件
                set("series_no",2);                       //法宝类型
                set("wuxing","金");                       //法宝五行
                set("level",100);                         //法宝等级
                set("no_steal",1);
                set("no_get",1);
                set("no_put",1);                          //下面是装备卸除描述
                set("wear_msg", NOR HIY"$N"HIY"思感微动，$n"HIY"随即化作一环十八团明光，晶辉朗耀，合成丈许大一团祥霞包没全身，莹莹欲流，宝相庄严。\n"NOR);
                set("unequip_msg",HIY"$N"HIY"撤去了$n"HIY"。\n"NOR);
                set("armor_type","FABAO");                //armor_type,这样一人只能装备一个防御法宝，且不需要用all_inventory来取得        
                set("armor_prop/armor",38);             
                set("armor_prop/spells",60);
                set("armor_prop/ob_hit",10);
                set("armor_prop/redamage_eff_sen_damage",12);   //新加的扩展功能 伤害反弹比率
                set("armor_prop/redamage_eff_kee_damage",12);  
                set("class","正");                        //法宝正邪
                set("no_busy",1);                       
        }
        setup();
}

//特殊类法宝专门克制某些法宝，比如佛门至宝专克阴邪法宝，攻击性阴邪法宝攻击时调用此函数，
//如果本法宝克制对方，则攻击伤害为0，需要在攻击性法宝里单独调用判断
nosave int fabao_ke(object fb)
{
        int ap,dp;
        if( !fb )
                return 0;
        ap = query("level");
        dp = fb->query("level");
        if( fb->query("class") && fb->query("class")=="邪" )
                dp-= random(dp/3);
        if( random(100)>dp/(ap+dp)*100 || ap>dp )       
        {
                message_vision(HIC"$N"HIC"立放毫光，化作层层叠叠的祥霞，将$n"HIC"裹住，停滞不前。\n"NOR,this_object(),fb);
                return 1;
        }
        return 0;
}       

//对攻击法宝kee伤害的伤害抵消，根据法宝的阶地自行定义
//法宝五行相克也在这里实现
varargs int protect_qi(int damage,string wx)
{
        int xk;
        if( damage<=0 || !environment() 
         || !living(environment()) )
                return damage;
        if( time()<query_temp("last_protect_qi")+5 )
                return damage;
        if( !wx )
                wx = SPELL_D->query_time_wuxing();              
        if( wx && query("wuxing") )
        {       
                xk = SPELL_D->wuxing_xs(query("wuxing"),wx);
                if( xk==1 )
                        damage = damage/2;
        }       
        set("last_protect_qi",time());  
        if( environment()->query("mana")<100 )
                return damage;
        environment()->add("mana",-100);
        message_vision(HIC"$N"HIC"身上$n"HIC"腾起层层祥霞，放出道道明光，将来袭的法宝多数逼回。\n"NOR,environment(),this_object());
        return  damage/4;       
}

//对攻击法宝sen伤害的伤害抵消，根据法宝的阶地自行定义
varargs int protect_shen(int damage,string wx)
{
        int xk;
        if( damage<=0 || !environment() 
         || !living(environment()) )
                return damage;
        if( time()<query_temp("last_protect_shen")+5 )
                return damage;
        if( !wx )
                wx = SPELL_D->query_time_wuxing();              
        if( wx && query("wuxing") )
        {       
                xk = SPELL_D->wuxing_xs(query("wuxing"),wx);
                if( xk==1 )
                        damage = damage/2;
                else    damage = damage-damage*5/100;           
        }       
        set("last_protect_shen",time());        
        if( environment()->query("mana")<100 )
                return damage;
        environment()->add("mana",-100);
        message_vision(HIC"$N"HIC"身上$n"HIC"腾起层层祥霞，放出道道明光，将来袭的法宝多数逼回。\n"NOR,environment(),this_object());
        return  damage/4;       
}       
