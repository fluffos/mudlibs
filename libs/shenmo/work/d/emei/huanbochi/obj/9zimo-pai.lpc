#include <ansi.h>
inherit ITEM;
inherit F_UNIQUE;

void create() {
  set_name(HIB "九子母陰魔拘灵牌" NOR, ({ "jiuzimo pai", "mo pai", "pai", "fabao" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("level", 150);
    set("value", 0);
    set("material", "shuijing");
    set("long", "为鸠盘婆所炼赤身教镇山之宝之一。可拘来九子母陰魔协同作战。\n");
    set("replace_file", "/d/obj/misc/tiaozhanpai");
    set("series_no", 4);
    set("damage", 800);
    set("no_steal", 1);
    set("no_put", 1);
    set("fabao", 1);
    set("wuxing", "木");
    set("class", "邪");
  }
  setup();
}

void end_ji() {
  delete("is_ji");
  if (environment() && environment()->is_character()) {
    if (!environment()->query("env/no_msg"))
      message_vision(query("name") + HIB "上便发出一股黑气。众恶鬼立被裹住，身便暴缩，一阵手脚乱挣，
怒声怪叫，横七竖八，跌跌翻翻，化为十八道青烟往镜中投去，迅速异常，转瞬立尽。\n" NOR, environment());
  }
}

void jiuzhen(object me, object target, int t) {
  int cc, n, xk, damage;
  string wx, msg;
  object fb;
  remove_call_out("feicha");
  if (!me || !target || !me->is_fighting(target)) {
    end_ji();
    return;
  }
  if (me->query("mana") < 100) {
    if (!me->query("env/no_msg") && !target->query("env/no_msg")) {
      message_vision(HIR "$N" HIR "法力告罄，手中" + query("name") + HIR "发出一阵哀鸣。\n" NOR, me);
      message_vision(HIB "只见那九子母陰魔一齐暴怒，就地一滚，各现原形。一时雪肤
花貌，玉骨冰肌，全都化为乌有；变成身高丈许，绿发红睛，
血口撩牙，遍体铁骨嶙峋，满身白毛，相貌狰狞的赤身男女魔
鬼，厉声怒叫，齐向$N" HIB "扑去。 \n" NOR, me);
    }
    me->delete_temp("last_damage_from");
    me->set_temp("death_msg", "遭" + query("name") + HIM "反噬而死。" NOR);
    me->receive_wound("kee", 100);
    end_ji();
    return;
  }

  me->add("mana", -100);
  cc = 1;
  switch (random(3)) {
    case 0:
      if (!me->query("env/no_msg") && !target->query("env/no_msg"))
        message_vision(HIC "$N" HIC "突发娇呻，一个眼风朝外抛去。那些赤身美女婴儿，便立即联翩
起舞。$N" HIC "站在女婴当中，舞过一阵，做了不少柔情媚态。\n" NOR, me);
      cc = 1;
      break;
    case 1:
      if (!me->query("env/no_msg") && !target->query("env/no_msg"))
        message_vision(HIM "$N" HIM "暗觑敌人站在旗门下面微笑相看，毫不为动，心中忿极。倏
地格格媚笑，自身也加入了女婴之中，一同起舞。舞到急处，
忽然头下脚上，连身倒转，玉退频伸，柔肌欲活，粉弯雪股，
致致生光，时颠时倒，时合时张。加以娇喘微微，声吟细细。
端的妙相毕呈，备极妖艳。令人见了，荡魄融心，身魂欲化。\n" NOR, me);
      cc = 2;
      break;
    default:
      if (!me->query("env/no_msg") && !target->query("env/no_msg"))
        message_vision(HIW "$N" HIW "和诸赤身美女，舞得又由急而缓，声色越发妖滢，
内中还夹杂着许多意想不到的怪状。\n" NOR);
      cc = 3;
      break;
  }
  damage = me->query("mana_factor");
  damage += query("damage");
  if (wx = query("wuxing")) {
    xk = SPELL_D->wuxing_xs(SPELL_D->query_time_wuxing(), wx);
    if (xk == 1)
      damage = damage / 2;
    else if (xk == -1)
      damage += damage / 3;
  }
  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    message_vision(HIC "$n" HIC "不觉多看了两眼，谁知才一注视，猛觉心旌微荡，泥丸宫
内元神立即微弱。$N" HIC "和赤身女婴跟着容光焕发，声色愈
加曼妙滢浪。\n" NOR, me, target);
  fb = target->query_temp("armor/FABAO");
  if (fb)
    damage = fb->protect_shen(damage, "木");
  if (damage > 0) {
    msg = COMBAT_D->damage_msg(damage, "内伤");
    msg = replace_string(msg, "$l", "身上");
    message_vision(msg, me, target);
    target->receive_wound("sen", damage, me);
    COMBAT_D->report_sen_status(target, 1);
    if (cc == 1) {
      target->receive_damage("sen", damage, me);
      COMBAT_D->report_sen_status(target);
    } else if (cc == 2)
      target->start_busy(2 + (int)target->query_busy());
  }
  n = 1 + random(5);
  t = t - n;
  if (t <= 0) {
    end_ji();
    return;
  }
  call_out("jiuzhen", n, me, target, t);
}

int ji(string id) {
  int ap, dp, t;
  object target, me;
  me = environment();
  if (!me || !living(me))
    return 0;
  if (me->query("mana") < query("level") * 2)
    return notify_fail("你的法力不足。\n");
  if (!me->is_fighting())
    return notify_fail("你要对谁祭法宝？\n");
  if (me->query("level") < query("level"))
    return notify_fail("你等级不够" + query("level") + "，祭不起" + query("name") + "。\n");
  if (time() < query("last_ji") + 5)
    return notify_fail(query("name") + "刚刚祭出过。\n");
  if (query("is_ji"))
    return notify_fail(query("name") + "已经祭出了。\n");
  if (id) {
    target = present(id, environment(me));
    if (!target)
      return notify_fail("这里没有" + id + "。\n");
  } else target = SSERVER->offensive_target(me);
  if (!target || !me->is_fighting(target))
    return notify_fail("你要对谁祭" + query("name") + "？\n");

  set("last_ji", time());
  ap = me->query("daoxing") / 100000 + me->query("level") * 1000;
  dp = target->query("daoxing") / 100000 + target->query("level") * 1000;

  if (me->query("env/no_msg") || target->query("env/no_msg"))
    message_vision(
      HIR "$N" HIR "对$n" HIR "使用了法宝「" HIY + query("name") + HIR "」。\n" NOR,
      me,
      target
    );
  else {
    message_vision(HIB "$N" HIB "拔出腰间令牌，双手各持一面，朝前心所悬三角晶镜上一拍，
口诵魔经，朝外一场。镜上面便箭一般射出两股青焰，落地便自
爆散，现出九个赤身美女和九个赤身婴儿，都是粉滴酥搓，一丝
不挂，各有一片极薄彩烟围身，艳丽绝轮。\n" NOR, me);
    message_vision(HIB "再看$N" HIB "神情，也转怒为喜，秀眉寒颦，星目流波，面如朝霞，\n容光照人。再衬上一身柔肌媚骨，玉态珠辉，越显
得仪态万方，迥不似先前那张死人面孔。\n" NOR, me);
  }
  me->add("mana", -query("level") * 2);
  if (random(100) > dp / (ap + dp) * 95) {
    set("is_ji", 1);
    t = me->query_skill("spells") / 6;
    if (t < 15) t = 15;
    if (t > 150) t = 150;
    call_out("jiuzhen", random(3), me, target, t);
  } else message_vision(
    HIC "$N" HIC "哼！了一声：米粒之珠，也放光华？说罢，将手一指，结果血光大盛，" + query("name") + HIC "发出一声哀鸣，从半空落了下来。\n" NOR,
    target
  );
  return 1;
}
