#include <ansi.h>
inherit ITEM;
inherit F_UNIQUE;

void create() {
  set_name(HIR "迷阳针" NOR, ({ "miyang zhen", "zhen", "fabao" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("level", 50);
    set("value", 0);
    set("material", "shuijing");
    set("long", "五株神女萧宝娘修炼的法宝之一，能迷人心神。\n");
    set("replace_file", "/d/obj/misc/tiaozhanpai");
    set("series_no", 4);
    set("damage", 100);
    set("no_steal", 1);
    set("no_put", 1);
    set("fabao", 1);
    set("class", "邪");
    set("wuxing", "金");
    set("no_busy", 1);
  }
  setup();
}

int ji(string id) {
  int xk, ap, dp, damage, i;
  object fb, target, me;
  string msg, *limbs, limb, wx;
  me = environment();
  if (!me || !living(me))
    return 0;
  if (me->query("mana") < query("level") * 2)
    return notify_fail("你的法力不足。\n");
  if (!me->is_fighting())
    return notify_fail("你要对谁祭法宝？\n");
  if (me->query("level") < query("level"))
    return notify_fail("你等级不够" + query("level") + "，祭不起" + query("name") + "。\n");
  if (time() < query("last_ji") + 5)
    return notify_fail(query("name") + "刚刚祭出过。\n");
  if (id) {
    target = present(id, environment(me));
    if (!target)
      return notify_fail("这里没有" + id + "。\n");
  } else target = SSERVER->offensive_target(me);
  if (!target || !me->is_fighting(target))
    return notify_fail("你要对谁祭" + query("name") + "？\n");

  set("last_ji", time());
  ap = me->query("daoxing") / 100000 + me->query("level") * 1000;
  dp = target->query("daoxing") / 100000 + target->query("level") * 1000;

  if (me->query("env/no_msg") || target->query("env/no_msg"))
    message_vision(
      HIR "$N" HIR "对$n" HIR "使用了法宝「" HIY + query("name") + HIR "」。\n" NOR,
      me,
      target
    );
  else {
    message_vision(
      HIR "$N" HIR "掐指对$n" HIR "一点，大喝一声“看法宝！”，只见" + query("name") + HIR "「呼」地一下飞到半空。\n" NOR,
      me,
      target
    );
    message_vision(HIB "只见三根针形妖光朝$N" HIB "直射而来！\n" NOR, target);
  }
  me->add("mana", -query("level") * 2);
  limbs = target->query("limbs");
  damage = me->query("mana_factor");
  damage += query("damage");
  if (wx = query("wuxing")) {
    xk = SPELL_D->wuxing_xs(SPELL_D->query_time_wuxing(), wx);
    if (xk == 1)
      damage = damage / 2;
    else if (xk == -1)
      damage += damage / 3;
  }
  if (random(100) > dp / (ap + dp) * 85) {
    msg = "";
    for (i = 0; i < 3; i++) {
      damage = damage / 2 + random(damage / 2);
      msg += "\n一根针形妖光正中$n$l！";
      msg += COMBAT_D->damage_msg(damage, "刺伤");
      limb = limbs[random(sizeof(limbs))];
      msg = replace_string(msg, "$l", limb);
      msg = replace_string(msg, "$w", HIB "针形妖光" NOR);
      message_vision(msg, me, target);
      fb = target->query_temp("armor/FABAO");
      if (fb)
        damage = fb->protect_shen(damage);
      if (damage > 0) {
        target->receive_wound("sen", damage, me);
        COMBAT_D->report_sen_status(target, 1);
      } else message_vision(HIC "结果被$N" HIC "身上的法宝尽数挡下。\n" NOR, target);
      msg = "";
    }
  } else message_vision(
    HIC "$N" HIC "哼！了一声：米粒之珠，也放光华？说罢，将手一指，结果血光大盛，" + query("name") + HIC "发出一声哀鸣，从半空落了下来。\n" NOR,
    target
  );
  return 1;
}
