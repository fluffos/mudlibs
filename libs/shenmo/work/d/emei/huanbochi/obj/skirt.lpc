#include <armor.h>
#include <ansi.h>
inherit ARMOR;

void create() {
  set_name(HIM "水染彩裙" NOR, ({ "skirt", "cloth" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("long", "一条西梁女国的裙子。。\n");
    set("material", "steel");
    set("value", 0);
    set("no_sell", 1);
    set("no_put", 1);
    set("armor_prop/armor", 85);
    set("series_no", 2);
    set("armor_prop/remove_kee_damage", 10);
    set("armor_prop/remove_sen_damage", 10);
    set("no_steal", 1);
  }
  setup();
}
