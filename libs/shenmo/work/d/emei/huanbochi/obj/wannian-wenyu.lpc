//任务性物品
#include <ansi.h>
inherit EQUIP;

void create()
{
        set_name(HIC"万年温玉"NOR, ({ "wannian wenyu", "wen yu","yu" }) );
        set_weight(3000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("value", 0);
                set("material", "shuijing");
                set("long", "只有鹅卵大小，微微带扁的一块美玉。\n");
                set("long2","一出现便是紫光艳艳，时泛红霞，满室皆春，照得众人面目眉发时红时紫。\n");
                set("no_steal",1);
                set("no_get",1);
                set("no_put",1);                          
                set("armor_type","QUEST2");               
                set("armor_prop/armor",2);              
                set("armor_prop/spells",1);
        }
        setup();
}

