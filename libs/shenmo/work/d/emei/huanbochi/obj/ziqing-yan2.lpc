//防御类法宝，护体神光之类
#include <ansi.h>
inherit EQUIP;

void create()
{
        set_name(HIY"紫清灵焰"NOR, ({ "ziqing lingyan", "yan","fabao" }) );
        set_weight(3000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("value", 0);
                set("material", "shuijing");
                set("long", "此宝乃紫清玉府太虚宫中乾灵灯上所结灯花，被几位滴降的天仙带临凡世，仗以御邪防身，此为李英琼所得的三朵。\n");
                set("series_no",2);                       //法宝类型
                set("wuxing","金");                       //法宝五行
                set("level",120);                         //法宝等级
                set("no_steal",1);
                set("no_get",1);
                set("no_put",1);                          //下面是装备卸除描述
                set("wear_msg", HIM"$N"HIM"将$n"HIM"晃得一晃，好个威势，只见那豆大紫焰放出亿万道光线，
把整个方圆上下都映了个澄澈，紫光照得天地光晕流转，仿佛处于一紫
水晶之内，美不甚收\n"NOR);
                set("unequip_msg",HIY"$N"HIY"撤去了$n"HIY"。\n"NOR);
                set("armor_type","FABAO");                //armor_type,这样一人只能装备一个防御法宝，且不需要用all_inventory来取得        
                set("armor_prop/armor",50);             
                set("class","正");                        //法宝正邪
                set("no_busy",1);
        }
        setup();
}

//特殊类法宝专门克制某些法宝，比如佛门至宝专克阴邪法宝，攻击性阴邪法宝攻击时调用此函数，
//如果本法宝克制对方，则攻击伤害为0，需要在攻击性法宝里单独调用判断
nosave int fabao_ke(object fb)
{
        return 0;
}       

//对攻击法宝kee伤害的伤害抵消，根据法宝的阶地自行定义
//法宝五行相克也在这里实现
varargs int protect_qi(int damage,string wx)
{
        return damage;
}

//对攻击法宝sen伤害的伤害抵消，根据法宝的阶地自行定义
varargs int protect_shen(int damage,string wx)
{
        return damage;
}       
