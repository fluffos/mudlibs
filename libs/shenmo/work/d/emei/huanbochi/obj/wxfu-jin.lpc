#include <ansi.h>
#include <room.h>
inherit COMBINED_ITEM;

void create() {
  set_name("玄门先天五行符(" HIY "金" NOR ")", ({ "wuxing jinfu", "jinfu", "fu", "seal" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "叠");
    set("base_unit", "张");
    set("material", "paper");
    set("value", 0);
    set("long", "一张道家正宗先天五行遁法符。\n");
  }
  setup();
  set_amount(1);
}

void init() {
  add_action("do_burn", ({ "ji", "burn" }));
}

int err_msg(string arg) {
  write(arg);
  return 1;
}

int do_burn(string arg) {
  string dir;
  mapping doors;
  object env, me = this_player();

  if (!arg || !id(arg) || !present(this_object(), me))
    return 0;
  if (me->is_busy())
    return err_msg("你现在正忙着。\n");
  if (me->query("mana") < 1000)
    return err_msg("你的法力不足。\n");
  env = environment(me);
  if (!env)
    return 0;
  if (base_name(env) != "/d/emei/huanbochi/waidong-s2")
    return err_msg("没有这个必要。\n");
  dir = "east";
  if (!env->query("exits/" + dir))
    return err_msg("没有这个必要。\n");
  doors = env->query_doors();
  if (doors[dir]["status"] != DOOR_CLOSED)
    return err_msg("没有这个必要。\n");
  message_vision("$N将手一指，一道黄光朝前飞去。\n" NOR, me);
  if (random(me->query("mana") / 100) < 10) {
    me->add("mana", -200);
    me->start_busy(1);
    message_vision("\n前面墙壁依然是墙壁，没有什么特别。\n\n", me);
  } else {
    message_vision(HIY "                     
那道黄光飞到墙前便化作一面大幕罩在正面壁上，立时狂风大作，墙壁忽然隐去，
变作千百丈青光，夹着无数根树木影子，如潮水一般涌到。
$N两手一合，再朝前一放，五行符化作一片白光，带起万千把金刀朝前飞去。
两下才一接触，转眼之间化为一股青烟，一股白烟，同时消散。\n" NOR, me);
    me->start_busy(1);
    me->add("mana", -1000);
    if (env->open_door(dir))
      message_vision("\n前面哪有墙壁，乃是一条极大的甬路。\n\n", me);
    else message_vision("\n前面墙壁依然是墙壁，没有什么特别。\n\n", me);
  }
  if (query_amount() <= 1)
    destruct(this_object());
  else add_amount(-1);
  return 1;
}
