#include <ansi.h>
inherit ITEM;

nosave string *list=({
/****** 11 ******/      
        "anan-jian",
        "chiyin-feicha",
        "hongjiao-jian",
        "huiyu-cloth",
        "huoyan-cha",
        "mouni-wan",
        "qiqing-wang",
        "suiren-zuan",
        "tianwen-qiu",
        "zihe-bag",
        "zitao-dai",
/****** 10 ******/
        "ziying-jian",
        "duohun-jian",
        "jingang-lun",
        "liuyang-jian",
        "mimo-zhuang",
        "miyang-zhen",
        "mohuo-jindong",
        "mouni-dingzhu",
        "nili-qi",
        "qibao-jindong",
/******* 10 *****/      
        "qingsuo-jian",
        "qisha-xuanyinmu",
        "renpi-bag",
        "sejiemozhen-fan",
        "doulv-jinsan",
        "suixin-hammer",
        "taohua-zhang",
        "yinling-pai",
        "huaxue-shending",
        "ziqing-yan",
});

void create()
{
        set_name(HIY"大宝箱"NOR, ({"bao xiang", "box"}));
        set_weight(100000000000000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一个金光闪闪的箱子。\n");
                set("unit", "个");
                set("no_get","你是大力士吧？这个也想拿起来？");
        }
        set("no_open",1);
        setup();
}

void init()
{
        add_action("do_open","open");
}                       

int err_msg(string arg)
{
        write(arg);
        return 1;
}

int do_open(string arg)
{
        int i,succ,k,n;
        string file,tmp;
        object fb,me = this_player();
        
        if( !arg )
                return 0;
        if( !present(me,environment()) )
                return 0;
        if( present(arg,environment())!=this_object() )
                return 0;       
        if( query("no_open")!=1 )
                return err_msg("箱子里空空如也，或许已给人翻过了。。。。\n");
        if( !me->query_temp("huanbochi/tiezhu") )
                return err_msg("等等，你现在正忙。\n");
                        
        if( me->is_busy() )
                return err_msg("你现在正忙。\n");
        message_vision("$N按捺住激动的心情，走上前去，打开了宝箱。\n",me);
        me->start_busy(1);
        set("no_open",0);
        i = me->query("level");
        i/= 150;
        if( i<1 ) i = 1;
        if( i>6 ) i = 6;
        reset_eval_cost();
        tmp = "";
        while(i--)
        {
                succ = 3;
                if( random(me->query("kar"))>20 )
                        succ = succ+random(3);
                if( random(me->query("mana")/100)>10 )
                        succ = succ+random(3);
                if( !me->query("huanbochi/boxZ1") )
                        succ = succ+3;
                if( succ<4 )
                        k = 11;
                else if( succ<7 )
                        k = 21;
                else    k = 31; 
                if( k>sizeof(list) )
                        k = sizeof(list);
                file = list[random(k)];
                if( !file )
                        continue;
                if( random(5) )
                        file+= "1";
                else    file+= "2";
                fb = new(__DIR__"box/"+file);
                if( !fb )
                        continue;
                if( fb->move(me) )
                        tmp+= " "+fb->query("name");
                else
                {
                        destruct(fb);
                        continue;
                }
                tmp+= " ";
        }
        if( strlen(tmp)>3 )
                write(HIY"大惊喜！你得到了"+tmp+"。\n"NOR);
        else    write("结果你一无所获！\n");
        if( !me->query("huanbochi/boxZ1") )
                me->set("huanbochi/boxZ1",1);
        return 1;
}               
                
string long()
{
        if( query("no_open")!=1 )
                return "一个空着的大箱子。\n";
        return ::long();
}                                               
