#include <ansi.h>
inherit EQUIP;

void create() {
  set_name(HIY "三清金光神咒" NOR, ({ "jinguang zhou", "zhoufu", "fu", "zhou", "seal" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("material", "paper");
    set("value", 0);
    set("long", "龙虎山镇派法宝之一，乃是三清正宗保命仙符，需要用本命元气温养(yang)，上面写着：
　　    天地玄宗，万炁本根。广修亿劫，证我神通。
        三界内外，惟道独尊。体有金光，覆映吾身。
        视之不见，听之不闻。包罗天地，养育群生。
        受持万遍，身有光明。三界侍卫，五帝司迎。
        万神朝礼，役使雷霆。鬼妖丧胆，精怪忘形。
        内有霹雳，雷神隐名。洞慧交彻，五炁腾腾。
        金光速现，覆护真人。急急如律令。\n");
    set("level", 100);
    set("no_steal", 1);
    set("no_get", 1);
    set("no_put", 1);
    set("wear_msg", NOR HIY "只见$n" HIY "发出万道金光，在$N" HIY "顶门一闪而没。\n\n" NOR);
    set("unequip_msg", HIY "$N" HIY "撤去了$n" HIY "。\n" NOR);
    set("armor_type", "FABAO");
    set("armor_prop/armor", 18);
    set("armor_prop/ad_spells", 1);
    set("armor_prop/redamage_eff_sen_damage", 1);
    set("armor_prop/redamage_eff_kee_damage", 1);
    set("class", "正");
    set("no_busy", 1);
    set("wuxing", "金");
  }
  setup();
}

varargs int protect_qi(int damage, string wx) {
  int pro;
  object who;
  if (damage <= 0)
    return 0;
  if (query("mana") <= 0
    || (wx && wx == "金")          //对金属性无抵挡
    || (wx && wx == "火"))       //火克金
    return damage;
  who = environment();
  if (!who || !living(who))
    return damage;
  pro = query("mana");

  if (pro > damage / 10) {
    add("mana", -damage / 10);
    if (base_name(environment(who)) != "/d/emei/huanbochi/yd-e1"
      && base_name(environment(who)) != "/d/emei/huanbochi/yd-e2"
      && base_name(environment(who)) != "/d/emei/huanbochi/yd-e3") {
      message_vision(HIY "$N" HIY "顶梁隐约闪出三清金光神咒，发出一道金光之后又渐趋黯淡，一闪而没。\n" NOR, who);
      return damage / 5;
    }
    message_vision(HIY "$N" HIY "顶梁忽发万道金光，将各攻击拒于三丈之外！\n" NOR, who);
    return 0;
  }
  message_vision(HIY "$N" HIY "顶梁隐约闪出三清金光神咒，发出一道金光之后又渐趋黯淡，一闪而没。\n" NOR, who);
  set("mana", 0);
  return damage - pro;
}

varargs int protect_shen(int damage, string wx) {
  return protect_qi(damage, wx);
}

void init() {
  object who, me = this_player();
  if (me == environment()) {
    if (query("max_mana") < me->query("max_mana"))
      set("max_mana", (int)me->query("max_mana"));
    if (!userp(me))
      set("mana", (int)me->query("max_mana"));
  }
  add_action("do_touch", ({ "touch", "yang", "mo" }));
}

int err_msg(string arg) {
  write(arg);
  return 1;
}

string tribar_graph(int val, int max) {
  string ret;
  int i, n, max_n = 25;

  if (max == 0) max = 1;
  n = val * 100 / max / 4;
  if (n < 0) n = 0;
  if (n > max_n) n = max_n;
  ret = "灵力存储：" + sprintf("%d", query("mana") * 100 / query("max_mana")) + "% ";
  ret += NOR + REV + BLU;
  for (i = 0; i < max_n; i++) {
    if (i < n) ret += " ";
    else ret += REV + CYN " " NOR;
  }
  ret += NOR "\n";
  return ret;
}

int do_touch(string arg) {
  object me = this_player();
  if (!arg || !id(arg))
    return 0;
  if (!present(this_object(), me))
    return 0;
  if (me->is_busy())
    return err_msg("你正忙着呢。\n");
  if (me->query("mana") < 1000)
    return err_msg("你的法力不足。\n");
  if (me->query("sen") < 500)
    return err_msg("你的精神不够，无法滋养" + query("name") + "。\n");
  if (query("mana") >= query("max_mana"))
    return err_msg(HIY + query("name") + HIY "经过本命元气的滋养，渐渐发出一抹耀眼的金色。\n" NOR);
  message_vision(HIY "
“万物聚灵！地火水风！急急如律令！聚！”$N" HIY "张口吐出了一口本命元气，
包裹住" + query("name") + HIY "。\n" NOR, me);
  me->start_busy(1);
  me->add("mana", -800);
  me->receive_damage("sen", 300);
  message_vision(HIG + query("name") + HIG "在本命元气中慢慢温养。\n" NOR, me);
  add("mana", 400 + random(400));
  if (query("mana") >= query("max_mana")) {
    message_vision(HIY + query("name") + HIY "经过$N" HIY "本命元气的滋养，渐渐发出一抹耀眼的金色。\n" NOR, me);
    set("mana", query("max_mana"));
  } else message_vision(YEL + query("name") + YEL "经过$N" YEL "本命元气的滋养，渐渐发出一抹淡淡的金色。\n" NOR, me);
  write(tribar_graph(query("mana"), query("max_mana")));
  return 1;
}

string long() {
  string str = ::long();
  if (query("max_mana") > 0)
    str += tribar_graph(query("mana"), query("max_mana"));
  return str;
}
