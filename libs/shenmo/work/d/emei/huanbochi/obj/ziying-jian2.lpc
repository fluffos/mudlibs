#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create() {
  set_name(HIM "紫郢剑
" NOR, ({ "ziying jian", "sword", "jian" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 0);
    set("material", "iron");
    set(
      "long",
      HIM "一柄长剑，剑头上刻着“紫郢”两个篆字。一舞动，便有十余丈的紫色光芒，映着日光耀眼争辉。通体紫色，西方太白元精所铸，万邪不侵，与青索剑共为峨嵋派镇山至宝。\n" NOR
    );
    set("series_no", 1);
    set("no_steal", 1);
    set("no_put", 1);
    set("no_busy", 1);
  }
  init_sword(340);
  setup();
}
