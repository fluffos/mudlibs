#include <ansi.h>
#include <armor.h>
inherit WAIST;
inherit F_UNIQUE;

void create() {
  set_name("紫绦带", ({ "zitao dai", "dai", }));
  set_weight(800);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("material", "leather");
    set("value", 0);
    set("no_sell", 1);
    set("no_put", 1);
    set("series_no", 2);
    set("replace_file", "/d/city/npc/obj/armor");
    set("armor_prop/intelligence", 1);
    set("armor_prop/armor", 5);
    set("armor_prop/ad_dodge", 10);
    set("no_steal", 1);

  }
  setup();
}
