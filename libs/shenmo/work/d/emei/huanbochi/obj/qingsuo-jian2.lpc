#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create() {
  set_name(HIC "青索剑
" NOR, ({ "qing suo jian", "sword", "jian" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 0);
    set("material", "iron");
    set("long", HIC "此剑未炼到火候纯熟，非常野性，极难驾驭，所以才将它封锁地肺之内，
受地底水火风雷昼夜淬炼，循环不息。一出地面，便有千百丈精光，照耀
天际。\n" NOR);
    set("series_no", 1);
    set("no_steal", 1);
    set("no_put", 1);
    set("damage", 450);
    set("level", 250);
    set("no_busy", 1);
  }
  init_sword(320);
  setup();
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  object fb;
  int damage = 500;
  string msg;
  if (!me || !victim || !me->is_fighting(victim)
    || damage_bonus <= 0)
    return 0;
  add_temp("hit", 1);
  if (query_temp("hit") % 5 == 0 && me->query("sen") > 100) {
    msg = HIC + query("name") + HIC "在$N" HIC "手中忽蠢蠢欲动，很难驾驭！\n" NOR;
    me->receive_damage("sen", 150);
    set_temp("hit", 1);
    return msg;
  }
  return 0;
}
