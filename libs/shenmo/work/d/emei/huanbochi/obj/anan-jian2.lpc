#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create() {
  set_name(HIY "阿难剑
" NOR, ({ "a nan jian", "sword", "jian" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 0);
    set("material", "iron");
    set("long", "佛门利器，仅长尺许。\n");
    set("no_steal", 1);
    set("no_put", 1);
    set("no_busy", 1);
  }
  init_sword(245);
  setup();
  set("weapon_prop/ad_sword", 5);
}
