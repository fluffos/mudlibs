#include <armor.h>
#include <ansi.h>
inherit EQUIP;
inherit F_UNIQUE; 

void create()
{
        set_name(RED"魔火金幢"NOR, ({ "mohuo jindong","jindong","mohuo","fabao" }) );
        set_weight(1600);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "扇");
                set("material", "cloth");
                set("value", 0);
                set("armor_type","FABAO");
                set("armor_prop/armor",38);
                set("armor_prop/spells",20);
                set("armor_prop/ob_hit",8);
                set("armor_prop/remove_kee_damage",8);
                set("armor_prop/remove_sen_damage",8);
                set("armor_prop/redamage_eff_sen_damage",5);
                set("armor_prop/redamage_eff_kee_damage",5);
                set("series_no",2);
                set("replace_file", "/d/obj/cloth/zhanpao"); 
                set("wear_msg","$N手中$n展动，立刻升起一团红云彩烟。\n");
                set("unequip_msg","$N撤去了护身红云。\n");
                set("no_steal",1);  
                set("wuxing","火");  
                set("level",70);
                set("class","邪"); 
                set("no_busy",1);                          
        }
        setup();
}

varargs int protect_qi(int damage,string wx)
{
        int xk;
        if( damage<=0 || !environment() 
         || !living(environment()) )
                return damage;
        if( time()<query_temp("last_protect_qi")+5 )
                return damage;
        if( !wx )
                wx = SPELL_D->query_time_wuxing();              
        if( wx && query("wuxing") )
        {       
                xk = SPELL_D->wuxing_xs(query("wuxing"),wx);
                if( xk==1 )
                        damage = damage/2;
        }       
        set("last_protect_qi",time());  
        if( environment()->query("mana")>100 )
        {
                environment()->add("mana",-100);
                message_vision(HIY"$N"HIY"身上红云一阵翻腾，卸去了不少的伤害。\n"NOR,environment());
                return damage*2/3;
        }
        return  damage; 
}

varargs int protect_shen(int damage,string wx)
{
        int xk;
        if( damage<=0 || !environment() 
         || !living(environment()) )
                return damage;
        if( time()<query_temp("last_protect_shen")+5 )
                return damage;
        if( !wx )
                wx = SPELL_D->query_time_wuxing();              
        if( wx && query("wuxing") )
        {       
                xk = SPELL_D->wuxing_xs(query("wuxing"),wx);
                if( xk==1 )
                        damage = damage/2;
        }       
                
        set("last_protect_shen",time());        
        if( environment()->query("mana")>100 )
        {
                environment()->add("mana",-100);
                message_vision(HIY"$N"HIY"身上红云一阵翻腾，卸去了不少的伤害。\n"NOR,environment());
                return damage*2/3;
        }
        return  damage; 
}
