#include <armor.h>
#include <ansi.h>
inherit EQUIP;

void create() {
  set_name(RED "魔火金幢" NOR, ({ "mohuo jindong", "jindong", "mohuo", "fabao" }));
  set_weight(1600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "扇");
    set("material", "cloth");
    set("value", 0);
    set("armor_type", "FABAO");
    set("armor_prop/armor", 48);
    set("armor_prop/spells", 10);
    set("series_no", 2);
    set("no_steal", 1);
    set("wuxing", "火");
    set("level", 70);
    set("class", "邪");
    set("no_busy", 1);
  }
  setup();
}

varargs int protect_qi(int damage, string wx) {
  return damage;
}

varargs int protect_shen(int damage, string wx) {
  return damage;
}
