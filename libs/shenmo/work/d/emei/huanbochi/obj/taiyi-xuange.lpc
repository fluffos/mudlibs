#include <weapon.h>
#include <ansi.h>
inherit SPEAR;
inherit F_UNIQUE; 

void create()
{
        set_name(HIW"太乙玄戈
"NOR, ({ "taiyi xuange", "ge","spear" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("value", 0);
                set("level",50);
                set("material", "iron");
                set("long", "一柄五寸来长，银光耀眼的小戈，乃是圣姑炼制的法宝之一。\n");
                set("wield_msg",HIW"白光一闪，$N"HIW"手中多出一柄$n"HIW"。\n"NOR);
                set("replace_file", "/d/city/npc/obj/spear"); 
                set("series_no",1);
                set("no_steal",1);    
                set("no_put",1);   
                set("no_busy",1);                         
        }
        init_spear(280);
        setup();
        set("weapon_prop/ad_spear",15);
        set("flag",SECONDARY);
}

mixed hit_ob(object me,object victim,int damage_bonus)
{
        object fb;
        int damage = 300;
        string msg;
        if( !me || !victim || !me->is_fighting(victim) 
         || damage_bonus<=0 )
                return 0;
        add_temp("hit",1);                      
        if( ( victim->is_busy() 
           || random(100)> (int)victim->query("level")/((int)me->query("level")+(int)victim->query("level"))*85 ) 
         && query_temp("hit")%6==0 )
        {
                fb = victim->query_temp("armor/FABAO");
                if( fb )
                        damage = fb->protect_qi(damage);
                if( damage<=0 )
                        return 0;
                msg = HIW"太乙玄戈戈头上立有一股极强烈的白光，电一般朝$n"HIW"$l射去！\n"NOR;
                victim->receive_wound("kee",damage,me);
                set_temp("hit",1);
                return msg;
        }
        return 0;
}       
                
int ji(string id)
{
        int xk,ap,dp,i,succ,n,damage;
        string wx,msg;
        object fb,*inv,target,me;
        me = environment();
        if( !me || !living(me) )
                return 0;
        if( !me->is_fighting() )
                return notify_fail("你要对谁祭法宝？\n");
        if( me->query("level")<query("level") )
                return notify_fail("你等级不够"+query("level")+"，祭不起"+query("name")+"。\n");
        if( time()<query("last_ji")+8 )
                return notify_fail(query("name")+"刚刚祭出过。\n");                    
        if( id )
        {
                target = present(id, environment(me));
                if( !target )
                        return notify_fail("这里没有"+id+"。\n");
        }
        else    target = SSERVER->offensive_target(me);
        if( !target || !me->is_fighting(target) )
                return notify_fail("你要对谁祭"+query("name")+"？\n");
        
        set("last_ji",time());  
        ap = me->query("daoxing")/100000+me->query("level")*1000;
        dp = target->query("daoxing")/100000+target->query("level")*1000;       

        if( me->query("env/no_msg") || target->query("env/no_msg") )
                message_vision(HIR"$N"HIR"对$n"HIR"使用了法宝「"HIY+query("name")+HIR"」。\n"NOR,me,target);
        else    message_vision(HIW+query("name")+HIW"戈头上立有一股极强烈的白光，电一般朝$N"HIW"射去。\n"NOR,target);

        xk = SPELL_D->wuxing_xs(SPELL_D->query_time_wuxing(),wx);
        if( xk==1 )
                ap-= random(ap/3);
        else if( xk==-1 )
                ap+= random(ap/3);
        succ = 0;
        if( random(100)>dp/(ap+dp)*100 )        
                succ++;
        fb = target->query_temp("armor/FABAO");
        if( fb )
        {
                if( random(100)>fb->query("level")/(query("level")+fb->query("level"))*100 )
                        succ++;                 
                if( fb->fabao_ke(this_object()) )
                        succ = 0;
        }

        if( succ<=0 )
        {
                message_vision(HIC"$N"HIC"哼！了一声：米粒之珠，也放光华？说罢，将手一指，结果血光大盛，"+query("name")+HIC"发出一声哀鸣，从半空落了下来。\n"NOR,target);
                add("last_ji",10);
                return 1;
        }       
        damage = me->query_skill("spells");
        damage+= random(me->query("mana_factor"));
        damage+= random(me->query("mana"));
        damage-= target->query_temp("apply/armor_vs_spells")/5;
        if( damage<300 )
                damage = 300;
        fb = target->query_temp("armor/FABAO");
        if( fb )        
                damage = fb->protect_qi(damage);
        if( damage>0 )
        {       
                msg = HIW+COMBAT_D->damage_msg(damage,"刺伤");
                msg = replace_string(msg,"$l","全身");
                msg = replace_string(msg,"$w","白光");          
                message_vision(msg,me,target);
                target->receive_wound("kee",damage,me);
                COMBAT_D->report_status(target,1);
        }       
        return 1;
}       
