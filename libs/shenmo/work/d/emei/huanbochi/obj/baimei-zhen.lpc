#include <ansi.h>
#include <weapon.h>
inherit COMBINED_ITEM;
inherit F_UNIQUE;

void setup() {}

void create() {
  set_name(HIW "白眉针" NOR, ({ "baimei zhen", "zhen" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "天狐宝相夫人炼制的法宝，伤人于无形。\n");
    set("unit", "把");
    set("base_unit", "根");
    set("base_weight", 3);
    set("value", 0);
    set("series_no", 2);
    set("no_get", 1);
    set("no_steal", 1);
    set("replace_file", "/d/obj/weapon/throwing/kongqueling");
    set("no_put", 1);
  }
  setup();
  set_amount(49);
}
