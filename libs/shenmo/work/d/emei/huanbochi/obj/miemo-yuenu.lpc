#include <ansi.h>
inherit EQUIP;
inherit F_UNIQUE;

string ori_long = "“女神婴”易静降魔七宝之一，采聚三百六十五两西方太乙真金炼成，形如弩筒，内藏五颗金丸，中有机簧，收发由心，专破魔火邪烟毒沙。\n";

void create() {
  set_name(HIY "灭魔弹月弩" NOR, ({ "miemo tanyue nu", "yuenu", "nu", "fabao" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("level", 150);
    set("value", 0);
    set("material", "shuijing");
    set("long", "“女神婴”易静降魔七宝之一，采聚三百六十五两西方太乙真金炼成，形如弩筒，内藏五颗金丸，中有机簧，收发由心，专破魔火邪烟毒沙。\n");
    set("orilong", ori_long);
    set("replace_file", "/d/city/npc/obj/shoes");
    set("armor_prop/armor", 5);
    set("series_no", 2);
    set("armor_type", "GONG");
    set("armor_prop/damage", 10);
    set("armor_prop/attack", 5);
    set("armor_prop/ad_unarmed", 10);
    set("no_steal", 1);
    set("damage", 100);
    set("no_put", 1);
    set("class", "正");
    set("wuxing", "金");
    set("anqi/allow", 1);
    set("anqi/max", 3);
    set("anqi/now", 0);
    set("anqi/damage", 0);
    set("no_busy", 1);
  }
  setup();
}

int ji(string id) {
  string msg, wx;
  int xk, i, ap, dp, damage;
  object *enemy, me;
  me = environment();
  if (!me || !living(me))
    return 0;
  if (me->query("mana") < query("level") * 2)
    return notify_fail("你的法力不足。\n");
  if (!me->is_fighting())
    return notify_fail("你要对谁祭法宝？\n");
  if (me->query("level") < query("level"))
    return notify_fail("你等级不够" + query("level") + "，祭不起" + query("name") + "。\n");
  if (time() < query("last_ji") + 5)
    return notify_fail(query("name") + "刚刚祭出过。\n");
  if (query("anqi/now") == 0)
    return notify_fail(query("name") + "里面空了。\n");

  set("last_ji", time());
  if (me->query("env/no_msg"))
    message_vision(HIY "$N" HIY "对使用了法宝「" HIC + query("name") + HIY "」。\n" NOR, me);
  else message_vision(HIY "$N" HIY "手中" + query("name") + HIY "迎风展开，绽放七彩霞光，夺人眼目！\n" NOR, me);

  enemy = me->query_enemy();
  if (!me->query("env/no_msg"))
    message_vision(HIM "只见一团酒杯大小的六角形紫色奇光突的从灭魔弹月弩中射出，突然爆炸，霹雳连
声，将此处震得天旋地转，那紫色奇光所发迅雷更不停止，随灭随生，纷纷爆炸，
朝前冲去，势绝神速，晃眼便将四周轰得是碎片漫天！\n" NOR, me);
  me->add("mana", -query("level") * 2);
  damage = query("anqi/damage");
  damage = damage / 2 + random(damage);
  if (wx = query("wuxing")) {
    xk = SPELL_D->wuxing_xs(SPELL_D->query_time_wuxing(), wx);
    if (xk == 1)
      damage = damage / 2;
    else if (xk == -1)
      damage += damage / 3;
  }
  if (damage < 10) damage = 10;
  ap = me->query("daoxing") / 100000 + me->query("level") * 1000;
  for (i = 0; i < sizeof(enemy); i++) {
    if (!enemy[i] || !me->is_fighting(enemy[i]))
      continue;
    dp = enemy[i]->query("daoxing") / 100000 + enemy[i]->query("level") * 1000;
    if (random(100) < dp / (ap + dp) * 90)
      continue;
    msg = COMBAT_D->damage_msg(damage, "内伤");
    message_vision(msg, me, enemy[i]);
    enemy[i]->receive_damage("kee", damage, me);
    COMBAT_D->report_status(enemy[i]);
  }
  add("anqi/now", -1);
  return 1;
}

void init() {
  ::init();
  add_action("do_install", "install");
  add_action("do_uninstall", "uninstall");
}


int do_install(string arg) {
  string name;
  object me = this_object();
  object who = this_player();
  object aq;
  int remain;

  if (!arg || !present(me, who))
    return notify_fail("你想装什么？\n");

  aq = present(arg, who);
  if (!present(arg, who))
    return notify_fail("你身上没有这东西。\n");
  if (aq->query("name") == me->query("name"))
    return notify_fail("装自己？\n");
  name = aq->query("name");
  name = COLOR_D->clean_color(name);
  if (name != "紫霆珠")
    return notify_fail("这玩艺太大了，装不进去。\n");
  if (me->query("anqi/now") == me->query("anqi/max"))
    return notify_fail(me->query("name") + "已经装满暗器了。\n");
  if (me->query("anqi/now") > 0
    && me->query("anqi/file") != base_name(aq))
    return notify_fail(me->query("name") + "不能装不同的暗器。\n");

  message_vision(
    "$N打开" + me->query("name") + "的机关，将一" + aq->query("unit") + aq->query("name") + "装了进去。\n",
    who
  );
  if (me->query("anqi/now") == 0) {
    me->set("anqi/type", name);
    me->set("anqi/file", base_name(aq));
    me->set("anqi/damage", aq->query("damage"));
  }
  if (me->query("anqi/now") + aq->query_amount() > me->query("anqi/max")) {
    remain = me->query("anqi/now") + aq->query_amount() - me->query("anqi/max");
    me->set("anqi/now", me->query("anqi/max"));
    me->set(
      "long",
      me->query("orilong") + "里面已经装了" + chinese_number(me->query("anqi/now")) + aq->query("base_unit") + aq->query("name") + "，想拆掉用uninstall。\n"
    );
    aq->set_amount(remain);
  } else {
    me->set("anqi/now", me->query("anqi/now") + aq->query_amount());
    me->set(
      "long",
      me->query("orilong") + "里面已经装了" + chinese_number(me->query("anqi/now")) + aq->query("base_unit") + aq->query("name") + "，想拆掉用uninstall。\n"
    );
    destruct(aq);
  }
  return 1;
}

int do_uninstall(string arg) {
  string file;
  object ob;
  object me = this_object();
  object who = this_player();

  if (!arg || !id(arg) || !present(me, who))
    return notify_fail("你想拆什么？\n");
  if (me->query("anqi/now") == 0)
    return notify_fail(me->query("name") + "里面什么也没有。\n");
  if (!file = query("anqi/file"))
    return notify_fail(me->query("name") + "里面什么也没有。\n");
  ob = new(file);
  ob->set_amount(me->query("anqi/now"));
  if (ob && ob->move(who)) {
    me->set("long", ori_long);
    me->set("anqi/now", 0);
    me->set("anqi/damage", 0);
    me->set("anqi/file", 0);
    message_vision(
      "$N从" + me->query("name") + "里面拆出一" + ob->query("unit") + ob->query("name") + "。\n",
      who
    );
  } else {
    if (ob)
      destruct(ob);
    write("你身上东西太多了。\n");
  }
  return 1;
}
