#include <ansi.h>
#include <combat.h>
inherit ITEM;

void create() {
  set_name(HIY "牟尼散光丸" NOR, ({ "mouni sanguang wan", "wan", "fabao" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("level", 380);
    set("value", 0);
    set("material", "shuijing");
    set("long", "“女神婴”易静降魔七宝之一，专能对手护体法宝。\n");
    set("series_no", 4);
    set("damage", 300);
    set("no_steal", 1);
    set("class", "正");
    set("wuxing", "火");
    set("no_busy", 1);
  }
  setup();
}

int ji(string id) {
  string msg, limb, *limbs, wx;
  int t, xk, ap, dp, damage;
  object fb, target, me;
  me = environment();
  if (!me || !living(me))
    return 0;
  if (me->query("mana") < query("level") * 2)
    return notify_fail("你的法力不足。\n");
  if (!me->is_fighting())
    return notify_fail("你要对谁祭法宝？\n");
  if (me->query("level") < query("level"))
    return notify_fail("你等级不够" + query("level") + "，祭不起" + query("name") + "。\n");
  if (time() < query("last_ji") + 5)
    return notify_fail(query("name") + "刚刚祭出过。\n");
  if (id) {
    target = present(id, environment(me));
    if (!target)
      return notify_fail("这里没有" + id + "。\n");
  } else target = SSERVER->offensive_target(me);
  if (!target || !me->is_fighting(target))
    return notify_fail("你要对谁祭" + query("name") + "？\n");

  set("last_ji", time());
  ap = me->query("daoxing") / 100000 + me->query("level") * 1000;
  dp = target->query("daoxing") / 100000 + target->query("level") * 1000;
  limbs = target->query("limbs");
  limb = limbs[random(sizeof(limbs))];

  if (me->query("env/no_msg") || target->query("env/no_msg"))
    message_vision(
      HIY "$N" HIY "对$n" HIY "使用了法宝「" HIC + query("name") + NOR HIY "」。\n" NOR,
      me,
      target
    );
  else {
    msg = HIY "$N" HIY "将手一指，只见一黄豆大小，其红如火，光明透亮的朱丸，化作一点溜圆火星直扑$n" HIY "$l。\n" NOR;
    msg = replace_string(msg, "$l", limb);
    message_vision(msg, me, target);
  }
  me->add("mana", -query("level") * 2);
  if (random(100) > dp / (ap + dp) * 90) {
    damage = me->query("mana_factor");
    damage += query("damage");
    if (wx = query("wuxing")) {
      xk = SPELL_D->wuxing_xs(SPELL_D->query_time_wuxing(), wx);
      if (xk == 1)
        damage = damage / 2;
      else if (xk == -1)
        damage += damage / 3;
    }
    fb = target->query_temp("armor/FABAO");
    if (fb) {
      if (fb->query("class") && fb->query("class") != "邪")
        damage = fb->protect_qi(damage);
      else if (random(100) > fb->query("level") / (query("level") + fb->query("level")) * 95) {
        message_vision(HIY "转眼火星胀大有千百倍，炸得$N" HIY "的护体妖光激荡不已！\n" NOR, target);
        t = me->query_skill("spells") / 50 + 1;
        fb->set_temp("last_protect_qi", time() + t);
        fb->set_temp("last_protect_shen", time() + t);
      }
    }
    if (damage > 0) {
      msg = COMBAT_D->damage_msg(damage, "刺伤");
      msg = replace_string(msg, "$w", "火星");
      msg = replace_string(msg, "$l", limb);
      message_vision(msg, me, target);
      target->receive_wound("kee", damage, me);
      COMBAT_D->report_status(target, 1);
    }
  } else message_vision(
    HIC "$N" HIC "哼！了一声：米粒之珠，也放光华？说罢，将手一指，结果血光大盛，" + query("name") + HIC "发出一声哀鸣，从半空落了下来。\n" NOR,
    target
  );
  return 1;
}
