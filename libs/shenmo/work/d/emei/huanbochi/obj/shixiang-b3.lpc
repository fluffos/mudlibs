#include <ansi.h>
#include <room.h>
inherit ITEM;

mapping code = ([
        "干" : ({"1","2","3","4","5","6","8",}),
        "工" : ({"1","2","3","5","7","8","9"}),
        "口" : ({"1","2","3","4","6","7","8","9",}),
        "土" : ({"7","2","4","5","6","8","9"}),
]);

void query_code()
{
        string arg,ture,c1,*tmp,*temp,cc,ss,*num = ({"干","工","口","土",});
        int i,k;
        ture = num[random(sizeof(num))];
        
        temp = ({"于","王","士","壬","白","空",});
        c1 = temp[random(sizeof(temp))];
        temp-= ({c1});
        tmp = code[ture];
        arg = "";
        for(i=0;i<3;i++)
        {
                cc = "\n";
                for(k=1;k<4;k++)
                {
                        ss = sprintf("%d",i*3+k);

                        if( member_array(ss,tmp)!=-1 )
                                ss = c1;
                        else    ss = temp[random(sizeof(temp))];
                        cc+= "    "+ss;
                }
                arg+= cc+"\n";          
        }
        set_temp("code",([
                "msg"           : arg,
                "ture"          : ture,
                "ture_msg"      : c1,
        ]));    
}

void create()
{
        set_name("大石柱", ({"shi zhu", "zhu"}));
        set_weight(100000000000000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一座高大的石柱。\n");
                set("unit", "座");
                set("no_get","你是大力士吧？这个也想拿起来？");
        }
        setup();
}

string long()
{
        mapping Co;
        string str = ::long();
        if( !query_temp("code") )
                query_code();
        Co = query_temp("code");
        str+= "最上面有 干、工、口、土 四个形状的按钮(push)。\n";       
        str+= "中间刻着奇怪的图案：\n";
        str+= YEL+Co["msg"]+NOR;
        str+= "\n图案下写着一行小字：今日暗号乃「"+Co["ture_msg"]+"」。\n";

        return str;
}

void init()
{
        add_action("do_push","push");
}                       

int err_msg(string arg)
{
        write(arg);
        return 1;
}

void close(object obj)
{
        object env;
        remove_call_out("close");
        if( !obj || !environment(obj) )
                return;
        env = environment(obj);
        if( base_name(env)!="/d/emei/huanbochi/yd-b3" )
                return;
        if( env->close_door("west") )
                tell_room(env,"\n\n轰隆一声，石柱转了几转，又恢复了原位。\n");                  
}

int do_push(string arg)
{
        int damage;
        mapping doors;
        object env,me = this_player();
        string msg,*num = ({"干","工","口","土",});
        if( !arg )
                return 0;
        env = environment();
        if( !env || base_name(env)!="/d/emei/huanbochi/yd-b3" )
                return 0;       
        if( member_array(arg,num)==-1 )
                return 0;
        if( me->is_busy() )
                return err_msg("你正忙着呢。\n");               
        message_vision("$N按下了"+arg+"。\n",me);
        me->start_busy(1);
        doors = env->query_doors();
        if( doors["west"]["status"] != DOOR_CLOSED )
                return 1;       
        if( arg!=query_temp("code/ture") )
        {
                msg = "只听「喀吧」一声，从一旁射出一溜短箭，直射$N的胸前！\n";
                damage = me->query("max_kee")/2;
                damage+= 300;
                damage = damage/2+random(damage/2);
                msg+= COMBAT_D->damage_msg(damage,"刺伤");
                msg = COLOR_D->clean_color(msg);
                msg = replace_string(msg,"$p","$P");
                msg = replace_string(msg,"$n","$N");            
                msg = replace_string(msg,"$l","前胸");
                msg = replace_string(msg,"$w","飞箭");
                message_vision(msg,me);
                me->start_busy(3);
                me->delete_temp("last_damage_from");
                me->set_temp("death_msg","被乱箭穿心而亡！"NOR);
                me->receive_wound("kee",damage);
                COMBAT_D->report_status(me,1);
        }
        else
        {
                if( env->open_door("west") )
                {
                        message_vision("轰隆一声，石柱转了几转，一旁的石壁上露出了一个小门。\n",me);
                        call_out("close",15,this_object());
                }               
        }
        return 1;
}                       
