#include <ansi.h>
inherit ITEM;

void create()
{
        set_name(HIW"白骨锁心锤"NOR, ({ "baigu suixin chui", "suixin chui","chui","hammer" }) );
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("level",370);
                set("value", 0);
                set("material", "shuijing");
                set("long", "五鬼天王尚和阳修炼的法宝之一，在雪山用数十年苦功，按
五行生克，寻到五个六阳魁首，还糟践了四十九个有根基人
的生魂方才炼成。锤头是五个骷髅攒成的梅花瓣式，白牙森
森，口都向外。\n");
                set("series_no",4);
                set("damage",800);
                set("no_steal",1);    
                set("no_put",1);       
                set("fabao",1);    
                set("class","邪");
                set("wuxing","土");
                set("no_busy",1);               
        }
        setup();
}

int ji(string id)
{
        int xk,ap,dp,damage;
        string wx;
        mapping armor;
        object *ar,a,fb,target,me;
        me = environment();
        if( !me || !living(me) )
                return 0;
        if( me->query("mana")<query("level")*2 )
                return notify_fail("你的法力不足。\n");                         
        if( !me->is_fighting() )
                return notify_fail("你要对谁祭法宝？\n");
        if( me->query("level")<query("level") )
                return notify_fail("你等级不够"+query("level")+"，祭不起"+query("name")+"。\n");
        if( time()<query("last_ji")+5 )
                return notify_fail(query("name")+"刚刚祭出过。\n");                    
        if( id )
        {
                target = present(id, environment(me));
                if( !target )
                        return notify_fail("这里没有"+id+"。\n");
        }
        else    target = SSERVER->offensive_target(me);
        if( !target || !me->is_fighting(target) )
                return notify_fail("你要对谁祭"+query("name")+"？\n");
        
        set("last_ji",time());  
        ap = me->query("daoxing")/100000+me->query("level")*1000;
        dp = target->query("daoxing")/100000+target->query("level")*1000;       

        if( me->query("env/no_msg") || target->query("env/no_msg") )
                message_vision(HIR"$N"HIR"对$n"HIR"使用了法宝「"HIY+query("name")+HIR"」。\n"NOR,me,target);
        else
        {
                message_vision(HIB"$N"HIB"将白骨锁心锤祭起，一团绿火红云中，现出栲栳大五个恶鬼脑
袋，张着血盆大口，电转星驰般直朝$n"HIB"飞去。\n"NOR,me,target);
                message_vision(NOR YEL"$n"YEL"迎风一晃，发出一团愁烟惨雾，鬼哭啾啾，一齐变活，
各伸大口，露出满嘴白牙，往外直喷黑烟。！\n"NOR,me,this_object());
        }
        me->add("mana",-query("level")*2);
        if( random(100)>dp/(ap+dp)*90 )
        {
                damage = me->query("mana_factor");
                damage+= query("damage");
                damage = damage/2+random(damage/2);
                if( wx=query("wuxing") )
                {       
                        xk = SPELL_D->wuxing_xs(SPELL_D->query_time_wuxing(),wx);
                        if( xk==1 )
                                damage = damage/2;
                        else if( xk==-1 )
                                damage+= damage/3;
                }                                               
                fb = target->query_temp("armor/FABAO");
                if( fb )
                        damage = fb->protect_qi(damage);
                if( damage>0 )                  
                {
                        armor = target->query_temp("armor");
                        if( armor && mapp(armor) )
                        {
                                ar = keys(armor);
                                if( ar && arrayp(ar) && sizeof(ar)>0 )
                                {
                                        a = armor[ar[random(sizeof(ar))]];
                                        if( a )
                                        {
                                                message_vision(HIW"\n$N"HIW"身上的$n"HIW"被"+query("name")+HIW"击得粉碎！\n"NOR,target,a);
                                                a->unequip();
                                                target->reset_action();
                                                destruct(a);
                                        }
                                }
                        }               
                        target->receive_damage("kee",damage,me);
                        COMBAT_D->report_status(target);
                }
        }
        else    message_vision(HIC"$N"HIC"哼！了一声：米粒之珠，也放光华？说罢，将手一指，结果血光大盛，"+query("name")+HIC"发出一声哀鸣，从半空落了下来。\n"NOR,target);
        return 1;
}               
                                
