#include <weapon.h>
#include <ansi.h>
inherit SWORD;
inherit F_UNIQUE; 

void create()
{
        set_name(HIM"紫郢剑
"NOR, ({ "ziying jian", "sword","jian" }) );
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("value", 0);
                set("material", "iron");
                set("long", HIM"一柄长剑，剑头上刻着“紫郢”两个篆字。一舞动，便有十余丈的紫色光芒，映着日光耀眼争辉。通体紫色，西方太白元精所铸，万邪不侵，与青索剑共为峨嵋派镇山至宝。\n"NOR);
                set("wield_msg",HIM"一道丈许的紫色光芒一闪，$N手中多出一柄$n"HIM"。\n"NOR);
                set("replace_file", "/d/city/npc/obj/sword"); 
                set("series_no",1);
                set("no_steal",1);    
                set("no_put",1);            
        }
        init_sword(280);
        setup();
        set("weapon_prop/ad_sword",25);
}

mixed hit_ob(object me,object victim,int damage_bonus)
{
        object fb;
        int damage = 500;
        string msg;
        if( !me || !victim || !me->is_fighting(victim) 
         || damage_bonus<=0 )
                return 0;
        add_temp("hit",1);                      
        if( ( victim->is_busy() 
           || random(100)> (int)victim->query_skill("spells")/((int)me->query_skill("spells")+(int)victim->query_skill("spells"))*85 ) 
         && query_temp("hit")%5==0 )
        {
                fb = victim->query_temp("armor/FABAO");
                if( fb )
                        damage = fb->protect_qi(damage);
                if( damage<=0 )
                        return 0;
                msg = HIM+query("name")+HIM"化十来丈长的紫光，连那$n"HIM"只一绕，";
                msg+= HIM+COMBAT_D->damage_msg(damage,"砍伤")+NOR;                    
                victim->receive_wound("kee",damage,me);
                return msg;
        }
        return 0;
}       
                

