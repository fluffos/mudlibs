#include <ansi.h>;
inherit ITEM;

void create()
{
        set_name(HIG"木屏风"NOR, ({"ping feng", "ping"}));
        set_weight(100000000000000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一座二十多丈长短的木屏风。
屏风上不但刻有成千成万丛大树，所有幻波池底，全洞的景物，无不毕具。
每一景必有一些符咒附在上面。不过那些林木俱已折断，生气毫无。余外也
有好些残破的所在，从上面大体能熟知幻波池的地图(map)全貌。\n");          
                set("unit", "座");
                set("no_get","你是大力士吧？这个也想拿起来？\n");
                set("value",0);
        }
        setup();
}

//20line
string maps()
{
        string msg = @LONG
                                           __~~~~~~~~~~~~~__ 
                                          |   ~~   ~~       |  -- 甬道                                                              
                                          |      模  ~~~    |        \                                                    
                                          |  ~~         ~~          大石室                                                   
                                          |   ~  模   ~~              |                                                     
                                          | ~~~~         |           甬道                                          
                                          |      糊 ~~  |             \                                
                                          |    ~~~~~~~  |   东洞主洞--炼丹室                                             
                                          | ~~   糊 ~   |      |                                           
                                           ~~~~~~~~~~~~~~   东洞大门                                        
                                                     |         |                                           
                                                  北洞大门    甬道                                          
                                                     |         |                                           
                      甬道 ==  石 室 -- 西洞大门 -- 穴底 -- 东洞入口                    
                       |                             |
                      甬道 /                      南洞大门
         ~~~~~~~~      |  /  ^^^^^^^^                |            
         ~~~风~~~ -- 石 室 --^^^火^^^                |
         ~~~~~~~~      |   \ ^^^^^^^^                |
                          甬道  == == == 甬道 --  南洞主洞
        
LONG;
        return msg;
}

void init()
{
        add_action("do_map","map");
}

int err_msg(string arg)
{
        write(arg);
        return 1;
}

int do_map(string arg)
{
        int i,sz,k;
        string *temp;
        string str;
        object me = this_player();
        if( time()<me->query_temp("pf_map")+8 )
                return err_msg("你现在心神不宁。\n");
        me->set_temp("pf_map",time());  
        str = maps();
        temp = explode(str,"\n");
        sz = sizeof(temp);
        arg = "";
        i = me->query_skill("spells")/60;
        i+= me->query("max_mana")/1000;
        if( i>sz )
                i = sz;
        i = i/2+random(i/2);                            
        for(k=0;k<i;k++)
                arg+= temp[k]+"\n";
        arg = "你定心凝神，仔细观看屏风上的沟壑林木，勉强分辨出地图的大体走向是：\n"+arg;
        me->start_more(arg);
        return 1;
}                               
                                
