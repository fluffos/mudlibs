#include <ansi.h>
#include <room.h>
inherit __DIR__"r.lpc";

void create_room()
{
        set("short","甬道");
        set("long",@LONG
一条狭长的甬道，地势逐渐向下，头顶开始出现一些大
小不一的石乳。
LONG);  
        set("exits",([
                "west"  : __DIR__"yd-b5",
                "east"  : __DIR__"yd-b3",
        ]));
        create_door("east", "石壁", "west", DOOR_CLOSED);               
}

void closeD()
{
        remove_call_out("closeD");
        close_door("east");
}

void openD(object who)
{
        remove_call_out("openD");
        if( !who || !present(who)
         || !living(who) )
                return;
        if( open_door("east") )
        {       
                tell_room(this_object(),HIC"\n"+who->query("name")+HIC"运足法力在石壁上一抵，轰的一声，出现了一道门户。\n\n"NOR);
                who->delete_temp("yde4_open");
                call_out("closeD",5+random(5));
        }
}

void init()
{
        ::init();
        if( this_player()->query_temp("yde4_open") 
         && this_player()->query("id")=="zhou qing yun" )
        {
                remove_call_out("openD");
                call_out("openD",random(5),this_player());
        }
}        
        
        
