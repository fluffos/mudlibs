#include <ansi.h>
#include <room.h>
inherit __DIR__ "r.lpc";

nosave string *msg1 = ({
  "狂风呼啸，凛冽凄厉，",
  "铺天盖地而来的巨风刮得愈来愈猛，",
  "大风活像个失去了理智的疯子，颠颠扑扑，乱碰乱撞而来，",
});
nosave string *msg2 = ({
  "$N十步之内不辨方向！\n",
  "在$N脚下打着旋！\n",
  "卷起一片风沙朝$N的扑面而来！\n",
});
nosave string *msg3 = ({
  NOR "( $N" YEL "大叫一声,被狂风刮到半空中,又重重的跌在山石上！" NOR " )\n" NOR,
  NOR "( $N" YEL "大叫一声,被风沙埋了半身！" NOR " )\n" NOR,
  NOR "( $N" YEL "狂叫一声，被风沙活埋了！" NOR " )\n" NOR,
});

string random_exit() {
  return sprintf(__DIR__ "feng%d", 1 + random(3));
}

void env_wuxing_hit(object who) {
  int i = random(3);
  string msg;
  object zhu;

  remove_call_out("env_wuxing_hit");

  if (who && objectp(who) && living(who)
    && userp(who) && present(who, this_object())) {
    msg = msg1[random(sizeof(msg))];
    msg += msg2[random(sizeof(msg2))];
    zhu = present("dingfeng zhu", who);
    if (!zhu || base_name(zhu) != "/d/qujing/huangfeng/obj/dingfengzhu")

    {
      if (random(3)) {
        msg += msg3[0];
        message_vision(msg, who);
        who->delete_temp("last_damage_from");
        who->set_temp("death_msg", "在「十万风沙慑心阵」中化为齑粉！");
        who->receive_wound("kee", 300);
      } else if (random(3)) {
        msg += msg3[1];
        message_vision(msg, who);
        who->start_busy(1 + (int)who->query_busy());
      } else {
        msg += msg3[random(sizeof(msg3))];
        message_vision(msg, who);
        who->move(sprintf(__DIR__ "feng%d", 2 + random(3)), 2);
        tell_object(who, "你被狂风不知道卷到了哪里。。。\n");
        return;
      }
    }
    call_out("env_wuxing_hit", 2 + random(3), who);
  }
}
