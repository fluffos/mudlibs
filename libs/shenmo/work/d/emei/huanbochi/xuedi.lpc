#include <ansi.h>
inherit __DIR__ "r.lpc";

void create_room() {
  set("short", "穴底");
  set("long", @LONG
抬头看，发现池水居然悬浮在离地数百丈，仿若上头顶
着一面大玻璃镜子。
    地面，比上方要大出好几倍。有五个高大洞府，齐整整分
排在四围圆壁之上。底中心水落之处，是一个无底深穴，直径
大约数丈，恰好将那根水柱接住，所以四外都是干干净净的，
并无泛滥之迹。
    再看地平如砥，四壁石英云母相映生辉，明如白昼。越显
得宇宙之奇，平生未睹，益发赞妙不置。
LONG);
  set("exits", ([
    "west": __DIR__ "xidong-damen",
    "east": __DIR__ "dongdong-damen",
    "north": __DIR__ "beidong-damen",
    "south": __DIR__ "nandong-damen",
    //              "up"   : __DIR__"zhongdong-damen",                                                       
  ]));
}

void init() {
  ::init();
  add_action("do_cmds", "", 1);
}

int do_cmds(string arg) {
  object who, me = this_player();

  if (!userp(me) || me->is_fighting())
    return 0;
  if (me->query("huanbochi/bingrong"))
    return 0;
  who = present("bing rong", this_object());
  if (!who || userp(who)) {
    who = new(__DIR__ "npc/bingrong");
    who->move(this_object());
    message_vision("
忽然环池一圈泉眼中的泉水激射出来，射到中心，正合成一根水柱下落。
池底水柱也迎将上来，两下里就要迎凑在一起。
猛听下面哗的一声，水花四下飞溅，水柱倏地裂开，飞起一幢暗紫色的光
华，其势甚疾，晃眼便冲破上面水层，飞出池上。
水柱一裂，便看见玄光中裹定一个相貌古怪的道装妖人冲将出来！\n", me);
  }
  tell_object(me, CYN "道人喝道：诺那贼子，敢来打搅本道爷的清修！\n" NOR);
  who->copy_data(me);
  who->kill_ob(me);
  return 1;
}

int valid_leave(object who, string dir) {
  if (userp(who) && !who->query("huanbochi/bingrong"))
    return notify_fail("你刚想迈步，便听一个少女喝道：“来人止步，免遭不测。”\n");
  return ::valid_leave(who, dir);
}
