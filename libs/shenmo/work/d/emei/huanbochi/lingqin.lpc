//木生火，火生土，土生金，金生水，水生木；水克火，火克金，金克木，木克土，土克水。
#include <ansi.h>
inherit __DIR__ "r.lpc";

void zhen_jin(object who);
void zhen_mu(object who);
void zhen_shui(object who);
void zhen_huo(object who);
void zhen_tu(object who);
void info_zhen(object who, string type);

string look_pf() {
  string str;
  str = "
金光灿灿的屏风，上面隐现风、云、雷、电、水、火、刀箭、林
木、黄沙之形，金光灿烂，闪变不停。\n";
  str += sprintf("屏风之上的金形闪了%s次，木形闪了%s次，水形闪了%s次，火
形闪了%s次，土形闪了%s次。\n",
    chinese_number(query("Zhen/jin")),
    chinese_number(query("Zhen/mu")),
    chinese_number(query("Zhen/shui")),
    chinese_number(query("Zhen/huo")),
    chinese_number(query("Zhen/tu")),);
  return str;
}

void create_room() {
  set("short", "五行殿灵寝");
  set("long", @LONG
迎面是高约九丈，宽约两丈，作长圆形，外观已极壮丽的
大门，内里更是祥光瑞彩，静美庄严。
    当地乃是一同极高大的玉室，上下四壁通是整片碧玉，甚
是空旷。只当中地势微微隆起，成一方台，有两级不到半尺高
的台阶。
    台上有一个三丈大小圆形的白玉榻，四边无栏。榻上端端
正正坐着一个妙龄少女。
    那白玉榻后环立着十二扇黄金屏风(pingfeng)，榻前立着
一盏白玉灯檠(deng)，佛火青莹，光焰若定。灯侧地上插着一
柄金戈(ge)，长只尺许；一根树枝(zhi)， 仿佛刚折下来，晨
露未干，青翠欲滴；此外有一个盛水的小金钵盂(bo)和一堆金
黄色的沙土(tu)。为物俱都不大，一样接一样做一圈环起。
LONG);
  set("no_lianhua", 1);
  set("objects", ([
    __DIR__ "obj/body": 1,
  ]));
  set("item_desc", ([
    "pingfeng": (: look_pf :),
    "deng": "一盏白玉灯檠，上面灵气毕现，可以摸摸看(touch)。\n",  //火
    "ge": "一柄寸许长短的金戈，上面灵气毕现，可以摸摸看(touch)。\n",  //金
    "zhi": "一根树枝，仿佛刚折下来，晨露未干，青翠欲滴，上面灵气毕现，可以摸摸看(touch)。\n",  //木
    "tu": "一堆金黄色的沙土，上面灵气毕现，可以摸摸看(touch)。\n",  //土
    "bo": "一个盛水的小金钵盂，里面灵气毕现，可以摸摸看(touch)。\n",  //shui
  ]));
}

void reset() {
  int i, jin, mu, shui, huo, tu;
  object *inv;
  ::reset();
  inv = all_inventory();
  for (i = 0; i < sizeof(inv); i++) {
    if (userp(inv[i]))
      return;
  }
  set("Zhen", ([
    "tu": 5,
    "jin": 5,
    "shui": 5,
    "mu": 5,
    "huo": 5,
  ]));
  i = 5;
  tu = random(2);
  jin = random(2);
  shui = random(2);
  mu = random(2);
  huo = i - tu - jin - shui - mu;
  add("Zhen/tu", tu);
  add("Zhen/jin", jin);
  add("Zhen/shui", shui);
  add("Zhen/mu", mu);
  add("Zhen/huo", huo);
  set("quest", 1);
}

void quest1(object who) {
  remove_call_out("quest1");
  if (!who || !present(who))
    return;
  message_vision("        
猛听得水、火、风、雷、刀兵之声与扬沙、拔木之声，如天鸣地
叱，海啸山崩，四方八面一齐袭来。
眼前也不昏黑，只是青蒙蒙一片氤氲，上不见天，下不见地，无
边无涯。\n\n", who);
  info_zhen(who, "tu");
}

void init() {
  ::init();
  add_action("do_touch", "touch");
  if (userp(this_player()) && query("quest")) {
    remove_call_out("quest1");
    call_out("quest1", 3, this_player());
  }
}

void quest2(object who) {
  object mo, npc;
  remove_call_out("quest2");
  if (!who || !present(who))
    return;
  return;
}

void remove_zhen(object who, string type) {
  string str;
  if (!who || !present(who))
    return;
  switch (type) {
    case "jin": str = "庚金"; remove_call_out("zhen_jin"); break;
    case "mu": str = "乙木"; remove_call_out("zhen_mu"); break;
    case "shui": str = "丙水"; remove_call_out("zhen_shui"); break;
    case "huo": str = "离火"; remove_call_out("zhen_huo"); break;
    case "tu": str = "戊土"; remove_call_out("zhen_tu"); break;
    default: return;
  }
  if (query(type + "_start") && !query(type + "_fail")) {
    message_vision(HIY "\n只听得”轰隆“一声巨响，天地景色大变，「" HIR + str + HIY "禁制」已经停止！\n\n" NOR, who);
    set(type + "_start", 0);
    set(type + "_fail", 1);
  }
  if (query("jin_fail") && query("mu_fail")
    && query("shui_fail") && query("huo_fail")
    && query("tu_fail")) {
    delete("quest");
    remove_call_out("zhen_jin");
    remove_call_out("zhen_mu");
    remove_call_out("zhen_shui");
    remove_call_out("zhen_huo");
    remove_call_out("zhen_tu");
    tell_object(who, HIY "你成功去除了「" + HIM "五行禁制" HIY "」。\n" NOR);
    remove_call_out("quest2");
    call_out("quest2", 2 + random(4), who);
  }
}

void info_zhen(object who, string type) {
  string str;
  if (!who || !present(who))
    return;
  if (query(type + "_fail"))
    return;
  switch (type) {
    case "jin": str = "庚金"; remove_call_out("zhen_jin"); call_out("zhen_jin", 0, who); break;
    case "mu": str = "乙木"; remove_call_out("zhen_mu"); call_out("zhen_mu", 0, who); break;
    case "shui": str = "丙水"; remove_call_out("zhen_shui"); call_out("zhen_shui", 0, who); break;
    case "huo": str = "离火"; remove_call_out("zhen_huo"); call_out("zhen_huo", 0, who); break;
    case "tu": str = "戊土"; remove_call_out("zhen_tu"); call_out("zhen_tu", 0, who); break;
    default: return;
  }
  if (!query(type + "_start")) {
    message_vision(HIY "\n只听得”轰隆“一声巨响，天地景色大变，「" HIR + str + HIY "禁制」已经启动！\n\n" NOR, who);
    set(type + "_start", 1);
  }
}

int do_touch(string arg) {
  string str, tmp1, tmp2, tmp3;
  mapping tc = ([
    "deng": "huo",
    "ge": "jin",
    "zhi": "mu",
    "tu": "tu",
    "bo": "shui",
  ]);
  mapping wx = ([
    "jin": ({ "mu", "shui", }),  //0.克 1.生
    "mu": ({ "tu", "huo", }),
    "shui": ({ "huo", "mu", }),
    "huo": ({ "jin", "tu", }),
    "tu": ({ "shui", "jin", }),
  ]);
  object me = this_player();
  if (me->is_busy())
    return err_msg("你现在正忙着呢。\n");
  if (!arg)
    return err_msg("你要摸什么？\n");
  if (me->query("mana") < 100)
    return err_msg("你法力不够了。\n");
  switch (arg) {
    case "deng": str = HIR "$N" HIR "擦了擦白玉灯檠，空气中顿时火光火星大盛，金戈、刀剑之色变的晦涩。\n" NOR; break;
    case "ge": str = HIY "$N" HIY "摸了摸金戈，空气中顿时金戈、刀剑之色大盛，青绿云光变的晦涩。\n" NOR; break;
    case "zhi": str = HIG "$N" HIG "摇了药树枝，空气中顿时青绿云光大盛，黄色云涛变的晦涩。\n" NOR; break;
    case "tu": str = YEL "$N" YEL "捻了捻沙土，空气中顿时黄色云涛大盛，灰白光华变的晦涩。\n" NOR; break;
    case "bo": str = HIW "$N" HIW "摇了摇钵盂，空气中顿时灰白光华大盛，火光火星变的晦涩。\n" NOR; break;
    default: return err_msg("你要摸什么？\n");
  }
  message_vision(str, me);
  me->add("mana", -100);
  me->start_busy(1);
  if (!query("quest"))
    return 1;
  tmp1 = tc[arg];
  tmp2 = wx[tmp1][0];
  tmp3 = wx[tmp1][1];

  //      if( !query(tmp1+"_fail") )
  //              add("Zhen/"+tmp1,2);
  if (!query(tmp2 + "_fail"))
    add("Zhen/" + tmp2, -1);
  if (!query(tmp3 + "_fail"))
    add("Zhen/" + tmp3, 1);

  if (query("Zhen/" + tmp2) < 3 && !query(tmp2 + "_fail"))
    remove_zhen(me, tmp2);
  //      if( query("Zhen/"+tmp1)>8 && !query(tmp1+"_fail") )
  //              info_zhen(me,tmp1);
  if (query("Zhen/" + tmp3) > 8 && !query(tmp3 + "_fail"))
    info_zhen(me, tmp3);
  return 1;
}

int query_time_damage(int damage, string e_wx) {
  int xk;
  string t_wx;
  if (damage <= 0)
    return 0;
  t_wx = SPELL_D->query_time_wuxing();
  if (!t_wx)
    return damage;
  //时辰五行与场景五行一致，攻击加倍      
  xk = SPELL_D->wuxing_xs(e_wx, t_wx);
  if (xk == -1 || t_wx == e_wx)
    return damage * 2;
  //两者五行相克，攻击减半
  if (xk == 1)
    return damage / 2;
  //其他，照旧            
  return damage;
}

void zhen_jin(object who) {
  string *msg;
  int damage;
  object fb;
  remove_call_out("zhen_jin");
  if (!who || !present(who) || query("jin_fail"))
    return;
  damage = 800;
  damage = query_time_damage(damage, "金");
  msg = ({
    "黄光一闪，那上下四外的无限云涛忽然隐去。紧随着风雷大作，
杂以金戈、刀箭之声，眼前雪亮。\n",
    "金光、银光二色奇光，层层相间，闪幻若电，又似狂涛一般，上
下四外排山倒海齐涌上来。\n",
    "金银光中忽现出千万金戈、刀剑，耀如霜雪，齐向神光飞射而来。\n",
    "金戈、刀剑越紧越密，中杂无量数的大小箭弩弹丸，宛如暴雨飞
瀑，射到面前，彼此互相激击排荡。\n",
    "万顷金银光涛中，闪变起千万点星雷火雨，精芒耀目，难以逼视。\n",
    "一时金铁交响，无限繁响汇成一种极猛烈的炸音，益发声势厉害，
惊心眩目。\n",
  });
  message_vision(HIY + msg[random(sizeof(msg))] + NOR, who);
  fb = who->query_temp("armor/FABAO");
  if (fb) {
    damage = fb->protect_qi(damage);
    if (fb->query("wuxing")
      && SPELL_D->wuxing_xs(fb->query("wuxing"), "金") == 1
      && fb->query("level") > 200)
      damage /= 2;
  }
  if (damage > 0) {
    who->delete_temp("last_damage_from");
    who->set_temp("death_msg", "在「" HIY "五行庚金阵" HIM "」中被万箭穿身而亡！" NOR);
    who->receive_wound("kee", damage);
    COMBAT_D->report_status(who, 1);
  }
  call_out("zhen_jin", 1 + random(3), who);
}

void zhen_mu(object who) {
  string *msg;
  int damage;
  object fb;
  remove_call_out("zhen_mu");
  if (!who || !present(who) || query("mu_fail"))
    return;
  damage = 800;
  damage = query_time_damage(damage, "木");
  msg = ({
    "随听万木摇风之声。始而如小风初起，枝摇叶动，幽籁徐舒，清
飙远引，自协官商。\n",
    "忽然万木萧萧，狂风大作，走石飞沙，涛奔浪舞，万籁交鸣，汇
成一阵紧一阵的洪洪发发的怒吼，中间更杂着一种极尖锐凄厉的
异声，甚是刺耳，令人闻之，自然心悸。渐渐声势越恶，直似海
啸山崩，地轴翻圻，千百万天鼓一齐怒鸣，宇宙若将倾颓。\n",
    "青绿云光在电闪翻飞中，忽又现出千百万根大小青柱，由上下四
外一齐打来。\n",
    "这乙木神雷又与先前土、金、水三遁不同，那青色光柱撞将上来，
并不爆炸散裂。先是狂涛一般，后浪催着前浪涌压突起，夹攻而
来。神光之外，无论何方，全被这类青色光柱布满。\n",
    "青色光柱密压压望不到底，除了神光之内数丈之地，上天下地，全
被青柱塞满。跟着海啸忽止，这些大小高低不等的千百万青柱互
相旋转挤轧，一味争先猛进。\n",
    "吃神光一格，郁怒不宣，旋转摩擦愈疾，发出一种极繁密的轧轧怒
声，比初起时的风中异吼还更尖锐凄厉，悸人心魄，那压力自然
也增加了不知多少倍。\n",
  });
  message_vision(HIG + msg[random(sizeof(msg))] + NOR, who);
  fb = who->query_temp("armor/FABAO");
  if (fb) {
    damage = fb->protect_qi(damage);
    if (fb->query("wuxing")
      && SPELL_D->wuxing_xs(fb->query("wuxing"), "木") == 1
      && fb->query("level") > 200)
      damage /= 2;
  }
  if (damage > 0) {
    who->delete_temp("last_damage_from");
    who->set_temp("death_msg", "在「" HIG "五行乙木阵" HIM "」中被万木挤压而死！" NOR);
    who->receive_wound("kee", damage);
    COMBAT_D->report_status(who, 1);
  }
  call_out("zhen_mu", 1 + random(3), who);
}

void zhen_shui(object who) {
  string *msg;
  int damage;
  object fb;
  remove_call_out("zhen_shui");
  if (!who || !present(who) || query("shui_fail"))
    return;
  damage = 800;
  damage = query_time_damage(damage, "水");
  msg = ({
    "只觉面前一暗，上下四外全被阴云包没，乍见时还未觉怎厉害，
倏地大片玄云起处，隐闻海啸之声自远而近。\n",
    "随见一线白光环绕云外，成一极大圆圈，远远飞来，晃眼之间，
化作万丈银涛，发着轰轰发发的巨响异声，泰山压顶般打来！\n",
    "上方如此，神光下面又突起了几根巨大晶柱，飞泉猛喷，直冲上
来，才一挨近，猛然震天价连声巨震，爆裂分开，却不消散，
化作千万团大小灰白光华。\n",
    "灰白光华有的往光外打到，有的自行击撞冲激，二次散裂，重又
雹雨一般打到。\n",
    "那些由水柱爆散的灰白光华，才一撞裂，只有空隙，不遇击撞，
立即暴长加大，一经撞击，又行分裂，仍是如此，生生不已，
越来越甚。\n",
  });
  message_vision(HIW + msg[random(sizeof(msg))] + NOR, who);
  fb = who->query_temp("armor/FABAO");
  if (fb) {
    damage = fb->protect_qi(damage);
    if (fb->query("wuxing")
      && SPELL_D->wuxing_xs(fb->query("wuxing"), "水") == 1
      && fb->query("level") > 200)
      damage /= 2;
  }
  if (damage > 0) {
    who->delete_temp("last_damage_from");
    who->set_temp("death_msg", "在「" HIW "五行丙水阵" HIM "」中陷入没顶之灾，灌了个半死不活！" NOR);
    who->receive_wound("kee", damage);
    COMBAT_D->report_status(who, 1);
  }
  call_out("zhen_shui", 1 + random(3), who);
}

