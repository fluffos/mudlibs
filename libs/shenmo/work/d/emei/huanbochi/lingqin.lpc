void zhen_tu(object who) {
  string *msg;
  int damage;
  object fb;
  remove_call_out("zhen_tu");
  if (!who || !present(who) || query("tu_fail"))
    return;
  damage = 800;
  damage = query_time_damage(damage, "土");
  msg = ({
    "四下里立时火星四射了。火光火星由青变红，丙火也就此引发，
化成一片火海。\n",
    "上下四外本是一色淡黄色光景，原看不出一点别的景象，倏地黄
影一闪，化为千万层黄色云涛，金光电闪，齐往中心
压来。\n",
    "黄色云涛内中夹着无量数的暗黄金光，其色较深，暴雨一般打到。\n",
    "神光便即爆炸分裂。末后越现越多，不等到达，便自相排荡冲击，
纷纷爆裂。\n",
    "每团黄光看去最大的只酒杯大小，那威力却极惊人。一经爆裂，便
是震天价的霹雳，数又极繁，密如贯珠，渐渐汇成一片
连续不断的轰轰巨震。\n",
    "那爆裂出来的火花星光占地甚广，互相激射飞溅，宛如千万花筒，
交相发射，合为星山火海，声势猛烈雄奇，难以形容。\n",
    "星山火海隔着一层神光，兀自震得人目眩神昏，耳鸣心悸。\n",
  });
  message_vision(YEL + msg[random(sizeof(msg))] + NOR, who);
  fb = who->query_temp("armor/FABAO");
  if (fb) {
    damage = fb->protect_qi(damage);
    if (fb->query("wuxing")
      && SPELL_D->wuxing_xs(fb->query("wuxing"), "土") == 1
      && fb->query("level") > 200)
      damage /= 2;
  }
  if (damage > 0) {
    who->delete_temp("last_damage_from");
    who->set_temp("death_msg", "在「" NOR YEL "五行戊土阵" NOR HIM "」中被压成一堆肉泥！" NOR);
    who->receive_wound("kee", damage);
    COMBAT_D->report_status(who, 1);
  }
  call_out("zhen_tu", 1 + random(3), who);
}
