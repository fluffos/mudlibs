#include <ansi.h>
inherit __DIR__ "r.lpc";

void create_room() {
  set("short", "深山");
  set("long", @LONG
满岭尽是老桧松柏梗捕之类的大木，郁郁森森，参天蔽
日，奇花异卉，遍地皆是。加以涧谷幽奇，岩壑深秀，珍禽
异兽，见人不惊。端的是一座灵山胜域，非同凡境。那岭原
是东西横亘，长约数十里，就只当中隆起如坟，最高最大。
    岭的中心地带生着一大片异草，绿波如潮，随风起伏不
定。
LONG);
  set("exits", ([
    "north": __DIR__ "shenshan4",
    "east": __DIR__ "shenshan6",
  ]));
  set("num", 5);
}

int valid_leave(object who, string dir) {
  object guai;
  if (dir == "east" && random(who->query_kar()) > 30
    && !who->is_fighting() && query("num") > 0) {
    add("num", -1);
    if (random(2)) {
      guai = new(__DIR__ "npc/bear");
      guai->move(this_object());
      guai->kill_ob(who);
      return notify_fail("草丛中忽然蹦出一头黑瞎子！\n");
    } else {
      guai = new(__DIR__ "npc/laohu");
      guai->move(this_object());
      guai->kill_ob(who);
      return notify_fail("草丛中忽然窜出一只白额猛虎！\n");
    }
  }
  return ::valid_leave(who, dir);
}
