#include <ansi.h>
#include <room.h>
inherit __DIR__ "r.lpc";

string random_msg();

void create_room() {
  set("short", "万流交汇");
  set("long", @LONG
此洞为为炼丹炉鼎所在，圣姑飞升之时，毒龙丸刚刚第
二次炼成，尚未开炉，便即化去。那十二种仙草，也在其内。
此洞与其余三洞相通，
    这一层比头层还要高大出约两倍，四壁尽是奇花异草，正
当中设着一座大丹炉。
LONG);
  set("exits", ([
    "out": __DIR__ "shishi-w2",
    "down": __DIR__ "zhudong-s",
  ]));
  create_door("out", "石壁", "enter", DOOR_CLOSED);
}

int valid_leave(object who, string dir) {
  if (dir == "down")
    return notify_fail("太高了，恐怕直接下去会有危险，还是绕道吧。\n");
  return ::valid_leave(who, dir);
}


varargs void do_close(object me) {
  remove_call_out("do_close");
  close_door("out");
  if (me && present(me, this_object())) {
    remove_call_out("do_open");
    call_out("do_open", 10, me);
  }
}

void do_open(object me) {
  remove_call_out("do_open");
  if (!me || !present(me, this_object())) return;
  if (open_door("out")) {
    message_vision("$N念动真言，聚起无上法力，双手缓缓抵住石壁。\n", me);
    message_vision("轰隆一声巨响，洞门已经打开了。\n", me);
  }
  remove_call_out("do_close");
  call_out("do_close", 10, me);
}

void init() {
  object me = this_player();
  if (me->query("id") == "zhou qing yun"
    && !userp(me)) {
    message_vision(CYN "$N" CYN "说道：看来此处乃是死路。\n" NOR, me);
    remove_call_out("do_open");
    call_out("do_open", 30, me);
  }
}
