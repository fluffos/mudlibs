#include <ansi.h>
inherit __DIR__"r.lpc";

void create_room()
{
        set("short","敞堂");
        set("long",@LONG
一大间敞堂，有门无户。对面圆壁上有两个六角小门，
一红一白。外壁色如黄金，内壁色如青玉。堂中无甚陈设，只
当中有一个石鼓形的大墩，上铺极厚皮毡，石质如墨，黑而且
亮。
    敞堂之外，是一条婉蜒如蛇的甬道，堂当中段弯曲之处，
由甬壁上开一圆门。这一来，敞堂便成了新月形式，地系北洞
上层最高之处。
LONG);  
        set("exits",([
                "west" : __DIR__"shishi-n",
                "east" : __DIR__"qinshi-1",
        ]));    
}

int valid_leave(object who,string dir)
{
        if( userp(who) && dir=="east" && !who->query_temp("huanbochi/moshi") )
                return notify_fail(CYN"忽听一个少女喝道：“来人止步，免遭不测。”\n"NOR);
        return ::valid_leave(who,dir);
}       


