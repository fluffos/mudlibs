#include <ansi.h>
inherit __DIR__ "r.lpc";

void create_room() {
  set("short", "甬道");
  set("long", @LONG
一条狭长的甬道，地势逐渐向下，头顶开始出现一些大
小不一的石乳。
LONG);
  set("exits", ([
    "west": __DIR__ "yd-b6",
    "east": __DIR__ "yd-b4",
  ]));
}

int valid_leave(object who, string dir) {
  if (!userp(who) && dir == "east")
    who->set_temp("yde4_open", 1);
  return ::valid_leave(who, dir);
}
