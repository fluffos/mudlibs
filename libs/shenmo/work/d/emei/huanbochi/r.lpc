//东方属木，南方属火，西方属金，北方属水，中央属土
#include <ansi.h>
inherit ROOM;

nosave int hits = 0;

void create_room() { set("short", "幻波池地图"); }

void create() {
  create_room();
  set("channel_id", "幻波池");
  set("lianhua", 10);
  set("no_lianhua", 1);
  set("任务", 1);
  set("alternative_die", 1);
  setup();
}

int is_huanbo() { return 1; }

//当有场景伤害时，算上五行相克，返回最终伤害值
int query_env_damage(int damage) {
  int xk;
  string e_wx, t_wx;
  if (damage <= 0)
    return 0;
  if (!e_wx = query("wuxing"))
    return damage;
  t_wx = SPELL_D->query_time_wuxing();
  if (!t_wx)
    return damage;
  //时辰五行与场景五行一致，攻击加倍      
  xk = SPELL_D->wuxing_xs(e_wx, t_wx);
  if (xk == -1 || t_wx == e_wx)
    return damage * 2;
  //两者五行相克，攻击为0 
  if (xk == 1)
    return 0;
  //其他，照旧            
  return damage;
}

void env_wuxing_hit(object who) {
  object fb;
  int damage;
  string death_msg, msg;

  remove_call_out("env_wuxing_hit");
  if (!who || !environment(who)
    || environment(who) != this_object()
    || !userp(who))
    return;
  //法宝克五行
  fb = who->query_temp("armor/FABAO");
  if (fb && fb->query("wuxing")
    && SPELL_D->wuxing_xs(fb->query("wuxing"), SPELL_D->query_time_wuxing()) == 1
    && fb->query("level") > 200) {
    call_out("env_wuxing_hit", 2 + random(3), who);
    return;
  }
  damage = query("damage");
  if (damage <= 0)
    return;
  damage = query_env_damage(damage);
  if (damage <= 0)
    return;
  hits += 1;
  if (!query("hits") || hits > query("hits"))
    return;
  msg = query("damage_msg");
  if (!msg || !stringp(msg))
    msg = "一声巨响，五行之力源源不断的袭向$N！\n";
  message_vision(msg, who);
  fb = who->query_temp("armor/FABAO");
  if (fb)
    damage = fb->protect_qi(damage);
  if (damage > 0) {
    death_msg = query("death_msg");
    if (!death_msg || !stringp(death_msg))
      death_msg = "在幻波池被五行之轰成亟灰！";
    who->delete_temp("last_damage_from");
    who->set_temp("death_msg", death_msg);
    who->receive_wound("sen", damage);
    if (damage > 100)
      COMBAT_D->report_sen_status(who, 1);
  }
  call_out("env_wuxing_hit", 2 + random(3), who);
}

void init() {
  string room;
  object item, me = this_player();
  if (!userp(me) && base_name(me) == "/obj/npc/zhenshen") {
    me->move("/obj/void");
    return;
  }
  if (me->query("id") == "snowi")
    return;
  room = me->query("startroom");
  if (!room)
    room = ({ "/d/city/center", "/d/emei/huayanding", "/d/kunlun/xiaolu", })[random(3)];
  hits = 0;
  add_action("do_close", ({ "close", "open", "move" }));
  if (userp(me) && !wizardp(me) && time() > me->query("huanbochi/last_in") + 7200) {
    room = me->query("startroom");
    if (!room)
      room = ({ "/d/city/center", "/d/emei/huayanding", "/d/kunlun/xiaolu", })[random(3)];
    tell_object(me, HIY "【" HIG + query("channel_id") + HIY "】系统：你在幻波池地图滞留时间已超过2小时。\n" NOR);
    tell_object(me, HIY "【" HIG + query("channel_id") + HIY "】系统：你被传出了地图。\n" NOR);
    me->delete_temp("breaking");
    me->delete_temp("huanbo");
    me->delete_temp("huanbochi");
    me->set("huanbochi/last_end", time());
    me->move(room, 2);
    return;
  }
  if (userp(me) && time() < me->query("huanbochi/last_end") + 3600) {
    room = me->query("startroom");
    if (!room)
      room = ({ "/d/city/center", "/d/emei/huayanding", "/d/kunlun/xiaolu", })[random(3)];
    tell_object(me, HIY "【" HIG + query("channel_id") + HIY "】系统：你不能频繁进入幻波池。\n" NOR);
    tell_object(me, HIY "【" HIG + query("channel_id") + HIY "】系统：你被传出了地图。\n" NOR);
    me->delete_temp("breaking");
    me->delete_temp("huanbo");
    me->delete_temp("huanbochi");
    me->set("huanbochi/last_end", time());
    me->move(room, 2);
    return;
  }
  if (userp(me) && !me->query_temp("in_huanbo")) {
    tell_object(me, HIY "【" HIG + query("channel_id") + HIY "】系统：你并未得到进入此地的许可。\n" NOR);
    tell_object(me, HIY "【" HIG + query("channel_id") + HIY "】系统：你被传出了地图。\n" NOR);
    me->delete_temp("breaking");
    me->delete_temp("huanbo");
    me->delete_temp("huanbochi");
    me->set("huanbochi/last_end", time());
    me->move(room, 2);
    return;
  }
  if (!query("wuxing")
    || (!query("forall") && !userp(me)))
    return;
  //特殊道具不激发机关
  if (query("key_id")) {
    item = present(query("key_id"), me);
    if (item && query("key_file") && base_name(item) == query("key_file"))
      return;
  }
  call_out("env_wuxing_hit", 1 + random(2), me);

}

int err_msg(string arg) {
  write(arg);
  return 1;
}

int do_close(string arg) {
  return err_msg("什么？\n");
}

string look_door(string dir) { return 0; }


int valid_leave(object me, string dir) {
  string room;
  if (me->query("id") == "snowi")
    return ::valid_leave(me, dir);
  if (userp(me) && time() < me->query("huanbochi/last_end") + 3600) {
    room = me->query("startroom");
    if (!room)
      room = ({ "/d/city/center", "/d/emei/huayanding", "/d/kunlun/xiaolu", })[random(3)];
    tell_object(me, HIY "【" HIG + query("channel_id") + HIY "】系统：你不能频繁进入幻波池。\n" NOR);
    tell_object(me, HIY "【" HIG + query("channel_id") + HIY "】系统：你被传出了地图。\n" NOR);
    me->set("huanbochi/last_end", time());
    me->move(room, 2);
    return notify_fail("\n");
  }
  if (userp(me) && !me->query_temp("in_huanbo")) {
    room = me->query("startroom");
    if (!room)
      room = ({ "/d/city/center", "/d/emei/huayanding", "/d/kunlun/xiaolu", })[random(3)];
    tell_object(me, HIY "【" HIG + query("channel_id") + HIY "】系统：你并未得到进入此地的许可。\n" NOR);
    tell_object(me, HIY "【" HIG + query("channel_id") + HIY "】系统：你被传出了地图。\n" NOR);
    me->set("huanbochi/last_end", time());
    me->move(room, 2);
    return notify_fail("\n");
  }
  return ::valid_leave(me, dir);
}

void alternative_die(object who) {
  int i, wx, fail;
  string room, dd, tname, msg, ma;
  object *temp, *inv, fabao, owner, target;
  if (!who)
    return;

  target = who->query_temp("last_damage_from");
  if (userp(who)) {
    who->powerup();
    who->remove_all_killer();
    all_inventory()->remove_killer(who);
    if (target && !userp(target)) {
      target->remove_all_killer();
      all_inventory()->remove_killer(target);
    }
    message_vision("\n\n$N惨叫一声，翻倒在地，抽搐了几下便没了声息。\n", who);
    if (!who->query_temp("in_huanbo")) {
      who->set_temp("alternative_die", 1);
      who->die();
      who->delete_temp("alternative_die");
      return;
    }
    if (target) {
      msg = "〖" + (target->query("title") ? target->query("title") : "") + "〗";
      msg += target->query("nickname") ? ("「" + target->query("nickname") + "」") : "";
      msg += target->query("name");
      msg = COLOR_D->clean_color(msg);
      msg = HIR + who->query("name") + HIM "被" + msg + HIM "所伤，从幻波池中逃出。" NOR;
      CHANNEL_D->do_channel(this_object(), "rumor", msg);
    } else {
      if (who->query_temp("death_msg"))
        msg = HIW + who->query("name") + HIM + who->query_temp("death_msg");
      else msg = HIW + who->query("name") + HIM "被" HIR "机关" HIM "所伤，从幻波池中逃出。" NOR;
      CHANNEL_D->do_channel(this_object(), "rumor", msg);
    }
    message_vision("冥冥之中传来一阵声音：有缘无缘，乃是天命，纵有过失，不涉生死。\n\n", who);
    message_vision("\n\n半空中忽伸出一只大手，将$N的尸身抓了起来．．．\n\n", who);
    fail = who->query("huanbochi/fail");
    if (who->query("combat_exp") < 5000000)
      wx = 10000;
    else if (who->query("combat_exp") < 50000000)
      wx = 50000;
    else if (who->query("combat_exp") < 500000000)
      wx = 100000;
    else wx = 500000;
    wx += fail * 5000;
    tell_object(who, HIR "你任务失败了！\n");
    who->dismiss_team();
    all_inventory()->delete("owner");
    who->add("huanbochi/fail", 1);
    who->set("huanbochi/last_end", time());
    who->delete_temp("in_huanbo");
    who->delete_temp("huanbochi");
    who->delete_temp("huanbo");
    who->delete_temp("death_msg");
    who->add("combat_exp", -wx);
    if (who->query("daoxing") < wx / 3 * 2)
      who->set("daoxing", 0);
    else who->add("daoxing", -(wx / 3 * 2));
    who->remove_ride();
    who->move("/d/qujing/lingshan/daxiong", 2);
    message_vision(HIY "如来佛一伸左手把$N" HIY "的魂魄从地府里拉了回来，再一伸右手不知道从
哪里把$P的尸体抓了回来，接着两手一合，硬生生地把$N" HIY "魂魄逼回身体。\n" NOR, who);
    who->unconcious();
    who->start_busy(10);
    return;
  }
  /**************************** 完美的分割线 ****************************/
  if (!who->is_huanbo()) {
    who->powerup();
    who->remove_all_killer();
    all_inventory()->remove_killer(who);
    message_vision("\n$N死了。\n", who);
    message_vision("一阵浓雾袭来，裹住$N的尸身，渐渐淡去。\n", who);
    destruct(who);
    return;
  }
  if (who->query("force") > 500) {
#ifdef SDS_D
    SDS_D->addEffKee(who);
    SDS_D->addKee(who);
    SDS_D->addSen(who);
    SDS_D->addEffSen(who);
#endif
    if (present("jinchuang yao", who)) {
      who->command("eat yao");
      who->command("eat yao");
    }
    if (present("hunhuan dan", who)) {
      who->command("eat dan");
      who->command("eat dan");
    }
    if (who->query("force") > 40)
      who->command("exert recover");
    if (who->query("force") > 40)
      command("exert refresh");
    return;
  }
  if (target && !userp(target)) {
    if (owner = target->query("owner")
      && present(owner, environment(who)))
      target = owner;
  }
  if (target) {
    tname = target->query("name");
    tname += "(" + capitalize(target->query("id")) + ")";
  }
  if (owner = who->query("owner")) {
    who->powerup();
    who->remove_all_killer();
    all_inventory()->remove_killer(who);
    if (target) {
      if (owner == target)
        tell_object(who, HIR "你打伤了" + who->query("name") + "，触动了本地禁制。\n" NOR);
      else tell_object(who, HIR + tname + HIR "打伤了" + who->query("name") + "，触动了本地禁制。\n" NOR);
    } else tell_object(who, who->query("name") + "触动了本地禁制。\n" NOR);
    tell_object(owner, HIR "你任务失败了！\n");
    owner->dismiss_team();
    owner->set("huanbochi/last_end", time());
    owner->delete_temp("in_huanbo");
    owner->delete_temp("huanbochi");
    owner->move("/d/emei/huanbochi/xuedi");
    destruct(this_object());
    return;
  }

  if (!target || !present(target, environment(who))) {
    who->powerup();
    who->remove_all_killer();
    all_inventory()->remove_killer(who);
    if (who->query("die_msg"))
      message_vision(who->query("die_msg"), who);
    else message_vision(HIG "$N一咬牙，化作一道青光飞去。\n" NOR, who);
    destruct(who);
    return;
  }
  who->powerup();
  who->remove_all_killer();
  all_inventory()->remove_killer(who);
  //特殊npc战斗失败后不退走
  if (who->reward_ob(target))
    return;

  if (who->query("die_msg"))
    message_vision(who->query("die_msg"), who);
  else message_vision(HIG "$N一咬牙，化作一道青光飞去。\n" NOR, who);

  if (!userp(target) || who->query_temp("my_killer") != target) {
    destruct(who);
    return;
  }
  if (who->query("die_room")) {
    if (!wizardp(target) && base_name(environment(who)) != who->query("die_room")) {
      destruct(who);
      return;
    }
  }
  if (who->query("die_msg2"))
    message_vision(who->query("die_msg2"), who);

  if (dd = who->query("job/data")) {
    if (!target->query("huanbochi/" + dd)) {
      target->set("huanbochi/" + dd, 1);
      target->add("shen", (int)who->query("job/shen"));
      target->add("daoxing", (int)who->query("job/dx"));
      tell_object(
        target,
        HIY "你得到了" + (who->query("job/shen") > 0 ? chinese_number(who->query("job/shen")) + "点神数" : "") + "和" + (who->query("job/dx") > 0 ? COMBAT_D->chinese_daoxing(who->query("job/dx")) + "道行" : "") + "。\n" NOR
      );
    }
  }

  if (!who->query("noboss")) {
    inv = all_inventory(who);
    temp = ({});
    for (i = 0; i < sizeof(inv); i++) {
      if (inv[i] && inv[i]->query("series_no"))
        temp += ({ inv[i] });
    }
    if (sizeof(temp) >= 1) {
      fabao = temp[random(sizeof(temp))];
      fabao->set("no_give", 1);
      fabao->set("no_get", 1);
      if (fabao->move(target))
        CHANNEL_D->do_channel(
          this_object(),
          "rumor",
          "听说" + target->query("name") + "从" + who->query("name") + "手中夺得了法宝" + fabao->query("name") + HIM "！" NOR
        );
    }
  }
  destruct(who);
  return;
}
