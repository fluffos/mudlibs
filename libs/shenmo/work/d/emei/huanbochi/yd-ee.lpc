#include <ansi.h>
#include <room.h>
inherit __DIR__"r.lpc";

void create_room()
{
        set("short","甬道");
        set("long",@LONG
一条狭长的甬道，四壁发出微弱的青光。        
LONG);  
        set("exits",([
                "southwest"     : __DIR__"shishi-w2",
//              "east"          : __DIR__"yd-e10",
                "north"         : __DIR__"yd-u18",
        ]));    
        create_door("southwest", "石壁", "northeast", DOOR_CLOSED);     
}

varargs void do_close(object me)
{
        remove_call_out("do_close");
        close_door("southwest");
        if( me && present(me,this_object()) )
        {
                remove_call_out("do_open");
                call_out("do_open",10,me);
        }               
}

void do_open(object me)
{
        remove_call_out("do_open");
        if( !me || !present(me,this_object()) ) return;
        if( open_door("southwest") )
        {
                message_vision("$N念动真言，聚起无上法力，双手缓缓抵住石壁。\n",me);
                message_vision("轰隆一声巨响，洞门已经打开了。\n",me);
        }
        remove_call_out("do_close");
        call_out("do_close",10,me);
}       

void init()
{
        object me = this_player();
        if( me->query("id")=="zhou qing yun"
         && !userp(me) )
        {
                if( me->query_temp("from_shishi_w2") )
                        message_vision(CYN"$N"CYN"说道：看来此处通往北洞上层。\n"NOR,me);
                remove_call_out("do_open");
                call_out("do_open",30,me);
        }
}

int valid_leave(object who,string dir)
{
        if( !userp(who) )
                who->delete_temp("from_shishi_w2");
        return ::valid_leave(who,dir);
}
