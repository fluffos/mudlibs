#include <ansi.h>
#include <room.h>
inherit __DIR__"r.lpc";

void create_room()
{
        set("short","甬道");
        set("long",@LONG
这是一个与门一般大小的曲折甬道。顶上一颗颗的金星，
往前直排下去，每隔二三丈远，必有一个，行列甚是整齐，
金光四射，耀眼生花。
LONG);  
        set("exits",([
                "east" : __DIR__"yd-w2",
                "down" : __DIR__"shishi-w2",
        ]));
}

void init()
{
        object me = this_player();
        ::init();
        if( me->query_temp("huanbo_w") )
                me->delete_temp("huanbo_w");
}

int valid_leave(object who,string dir)
{
        int i,flg = 0;
        object *inv,room;
        if( dir!="down" || !userp(who) )
                return ::valid_leave(who,dir);
        room = find_object(__DIR__"shishi-w2");
        if( !room )
                room = load_object(__DIR__"shishi-w2");
        if( !room )
                return valid_leave(who,dir);
        inv = all_inventory(room);
        for(i=0;i<sizeof(inv);i++)
        {
                if( inv[i] && userp(inv[i]) )
                {
                        flg = 1;
                        break;
                }
        }
        if( flg )
                return notify_fail("石室内有人，暂时不方便进去哦。\n");
        return ::valid_leave(who,dir);
}
                                
