#include <ansi.h>
inherit __DIR__"r.lpc";

string *kn = ({
        "天","地","人",
});     

void create_room()
{
        set("short","方塘");
        set("long",@LONG
迎面是一座三丈多高、八尺来宽的玉壁。壁上画的是圣姑
仙容：云鬟雾鬓，貌若天仙的少女，仪态万分，雍容华贵。
LONG);  
        set("exits",([
                "east"  : __DIR__"fangtang",
        ]));    
}

void init()
{
        ::init();
        add_action("do_kneel","kneel");
}

int check_env()
{
        string str,*msgs;
        object room;
        if( !str=query("kneel") )
                return 0;
        msgs = ({});
        msgs+= ({str}); 
        room = find_object(__DIR__"fangtang-right");
        if( !room )
                return 0;
        if( !str=room->query("kneel") )
                return 0;
        if( member_array(str,msgs)!=-1 )
                return 0;
        msgs+= ({str}); 
        room = find_object(__DIR__"fangtang-north");
        if( !room )
                return 0;
        if( !str=room->query("kneel") )
                return 0;
        if( member_array(str,msgs)!=-1 )
                return 0;
        msgs+= ({str}); 
        if( sizeof(msgs)!=sizeof(kn) )
                return 0;
        return 1;
}                                       

void open_tang()
{
        object room;
        room = find_object(__DIR__"fangtang");
        if( !room )
                return;
        room->set("can_dive",1);
        tell_room(room,"\n\n这时地底风涛之声依旧猛烈，方塘已变作一泓清波，平明若镜，可鉴毛发。 \n\n");
        return;
}       

int do_kneel()
{
        string arg;
        object me = this_player();

        if( !me->query_temp("huanbochi/zhaoyaner_help") )
                return 0;       
        if( me->is_busy() )
                return err_msg("你现在正忙着。\n");
        message_vision("$N在玉壁前拜倒下去，通诚默祝。\n",me);
        me->start_busy(2);
        arg = kn[random(sizeof(kn))];
        switch(arg)
        {
                case "天" : 
                        message_vision("\n\n只见壁上坐像忽然动了起来，却是左手戟指朝上。\n\n",me);
                        break;
                case "地" : 
                        message_vision("\n\n只见壁上坐像忽然动了起来，却是左手戟指朝下。\n\n",me);
                        break;
                case "人" : 
                        message_vision("\n\n只见壁上坐像忽然动了起来，却是作左手抚心状。\n\n",me);
                        break;
                default : return 1;     
        }
        set("kneel",arg);
        if( check_env() )
        {
                message_vision("\n\n这时地底风涛之声依旧猛烈，方塘已变作一泓清波，平明若镜，可鉴毛发。 \n\n",me);
                open_tang();
        }
        return 1;
}               
