#include <ansi.h>
#include <room.h>
inherit __DIR__"feng.lpc";

void create_room()
{
        set("short",HIY"风之路"NOR);
        set("long",@LONG
这狭长甬道之内遍布三界之风，人行走其中只感到举步
维艰。    
LONG);  
        set("exits",([
                "west"  :  (: random_exit :),
                "east"  :  (: random_exit :),
                "north" :  __DIR__"feng3",
                "south" :  (: random_exit :),
        ]));    
        set("no_lianhua",1);
        set("wuxing","土");
        set("damage",1);
}
