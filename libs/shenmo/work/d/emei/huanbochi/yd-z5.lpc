//解密
#include <ansi.h>
#include <room.h>
inherit __DIR__ "r.lpc";

nosave string *quest = ({});

mapping push = ([
  "lu": "鹿", "fox": "狐", "tu": "兔",
  "hu": "虎", "she": "蛇", "ying": "鹰",
]);

void create_room() {
  set("short", "甬道");
  set("long", @LONG
这一带甬路本是又高又窄，忽然接连两个转折过去，
地势突往上高起了数十丈。        
    一尊石像挡住了向西的路。
LONG);
  set("exits", ([
    "east": __DIR__ "yd-z4",
    "west": __DIR__ "yd-z6",
  ]));
  set("item_desc", ([
    "shixiang": "一尊高大的石像，沉重无比。
在石像上方铭刻着“六个魂魄被封印在轮回之链上，让他们
依序到达那彼岸”。
在石像的下方则分布了六个图案，它们分别是蛇(she)、虎(hu)、
狐(fox)、鹿(lu)、鹰(ying)、兔(tu)。\n",
    "statue": "一尊高大的石像，沉重无比。
在石像上方铭刻着“六个魂魄被封印在轮回之链上，让他们
依序到达那彼岸”。
在石像的下方则分布了六个图案，它们分别是蛇(she)、虎(hu)、
狐(fox)、鹿(lu)、鹰(ying)、兔(tu)。\n",
    "she": "一个蛇的图腾，看起来可以按(push)下。下面刻着“其匿杀所窥，
盖毒尔。纵王者，亦弑”。\n",
    "hu": "一个虎的图腾，看起来可以按(push)下。下面刻着“彼乃王也，
众皆臣服，盖扑杀之”。\n",
    "fox": "一个狐的图腾，看起来可以按(push)下。下面刻着“其诡秘，凡角
者皆为所惑”。\n",
    "lu": "一个鹿的图腾，看起来可以按(push)下。下面刻着“此乃废物，惟
有角尔”。\n",
    "ying": "一个鹰的图腾，看起来可以按(push)下。下面刻着“呼啸于九天，
彼长虫望风丧胆”。\n",
    "tu": "一个兔的图腾，看起来可以按(push)下。下面刻着“其速疾矣，其
性灵矣，纵惑之亦不达”。\n",
  ]));
  create_door("west", "石像", "east", DOOR_CLOSED);
}

void init() {
  ::init();
  add_action("do_push", "push");
}

int do_push(string arg) {
  int k;
  mapping doors = query_doors();
  string str;
  object me = this_player();

  if (doors["west"]["status"] != DOOR_CLOSED)
    return err_msg("没有这个必要。\n");
  if (me->is_busy())
    return err_msg("你现在正忙。\n");
  if (!arg || member_array(arg, keys(push)) == -1)
    return 0;

  me->start_busy(1);
  str = "$N伸手在" + push[arg] + "图腾上按了一下，「咔哒」一声，";
  if (member_array(arg, quest) == -1) {
    str += push[arg] + "图腾陷了下去。\n";
    quest += ({ arg });
  } else {
    str += push[arg] + "图腾弹了出来。\n";
    quest -= ({ arg });
  }
  if (member_array("lu", quest) == 0
    && member_array("fox", quest) == 1
    && member_array("tu", quest) == 2
    && member_array("hu", quest) == 3
    && member_array("she", quest) == 4
    && member_array("ying", quest) == 5) {
    if (open_door("west")) {
      str += "「轰」的一声，石像移到一旁，让出了道路。\n";
      if (!me->query("huanbochi/7door")) {
        me->set("huanbochi/7door", 1);
        k = 2 + random(9);
        write(HIY "你成功破解了机关，得到了" + chinese_number(k) + "点神数奖励。\n" NOR);
        me->add("shen", k);
      }
    }
  }
  message_vision(str, me);
  return 1;
}
