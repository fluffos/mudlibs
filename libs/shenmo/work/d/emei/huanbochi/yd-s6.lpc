#include <ansi.h>
inherit __DIR__ "r.lpc";

void create_room() {
  set("short", "甬道");
  set("long", @LONG
一条孔道，里面酷寒阴森，黑沉沉的，只是一片浓影。
LONG);
  set("exits", ([
    "west": __DIR__ "yd-s5",
    "north": __DIR__ "waidong-s1",
  ]));
  set("wuxing", "火");
  set("damage", 700);
  set("damage_msg", HIR "\n半空忽发长吟之音，顿时弥天极地的红光扑面而来！\n" NOR);
  set("no_lianhua", 1);
  set("death_msg", "在幻波池「八荒玄火阵」中化作焦炭！\n");
  set("hits", 5);
  set("num", 5);
}

int valid_leave(object who, string dir) {
  object dao;
  if (userp(who) && query("num") >= 1) {
    add("num", -1);
    dao = new(__DIR__ "npc/yaodao");
    dao->move(this_object());
    dao->copy_data(who);
    message_vision("一道妖风卷来，从中杀出一名魔教弟子。\n", who);
    dao->kill_ob(who);
    if (query("num") >= 1 && random(who->query_kar()) > 30) {
      add("num", -1);
      dao = new(__DIR__ "npc/yaodao");
      dao->move(this_object());
      dao->copy_data(who);
      message_vision("一道妖风卷来，从中杀出一名魔教弟子。\n", who);
      dao->kill_ob(who);
    }
    return notify_fail("\n");
  }
  return ::valid_leave(who, dir);
}

void reset() {
  set("num", 5);
  ::reset();
}
