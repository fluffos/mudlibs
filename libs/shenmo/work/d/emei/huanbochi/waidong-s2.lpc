#include <ansi.h>
#include <room.h>
inherit __DIR__"r.lpc";

void create_room()
{
        set("short","南洞外层洞府");
        set("long",@LONG
这里比起外洞反而小得多。正面壁上印迹斑驳，
好似画着一些山水。
    四外不见一点门户痕迹。    
LONG);  
        set("exits",([
                "out" : __DIR__"waidong-s1",
                "east": __DIR__"yd-e1",
        ]));
        create_door("east", "墙壁", "west", DOOR_CLOSED);               
}

int valid_leave(object who,string dir)
{
        object zhou;
        mapping doors = query_doors();
        zhou = present("zhou qing yun");
        if( userp(who) && dir=="east"
         && zhou && !userp(zhou) && living(zhou)
         && !zhou->query_temp("jinguangzhou_say")
         && doors[dir]["status"] != DOOR_CLOSED 
         && who->query("huanbochi/yinsiniang")
         && who->query("huanbochi/huxian") )
        {
                message_vision(CYN"$N"CYN"说道：前方乃是「四象庚木阵」，甚是难解。\n"NOR,zhou);
                message_vision(CYN"$N"CYN"说道：幸好师尊曾言，此阵木象，金光咒可破之。\n"NOR,zhou);
                zhou->set_temp("jinguangzhou_say",1);
                return notify_fail(CYN+zhou->query("name")+CYN"说道：金光咒此前好似看那魔门弟子携之。\n"NOR);
        }
        return ::valid_leave(who,dir);
}

void quest()
{
        mapping doors = query_doors();
        remove_call_out("quest");
        if( doors["east"]["status"] != DOOR_CLOSED )
                return; 
        tell_room(this_object(),"       
        
正面壁间，那一排大的树木阴影，一闪即逝，随时
辰五行变化时生时灭。\n\n");
}

void init()
{
        object who = this_player();
        ::init();
        if( userp(who)
         && who->query("huanbochi/yinsiniang")
         && who->query("huanbochi/huxian") )
        {
                remove_call_out("quest");
                call_out("quest",4);
        }
}       
