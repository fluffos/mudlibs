#include <ansi.h>
inherit __DIR__"r.lpc";

void create_room()
{
        set("short","池边");
        set("long",@LONG
前方是一片密林，青青葱葱，不见边际。
    近前坎卦方向则是一个小水池，青烟笼罩，隐隐约约。小
池中水波飞涌，急流旋转，成了一个大漩涡。人一旦卷入池心
漩涡之中，恐怕便没了命。
    在池心水花急转中，隐现水底红光闪闪，似有一朵木莲，
开合不休。
LONG);  
        set("exits",([
                "east"  : __DIR__"dongdong-damen",  
        ]));    
}

void init()
{
        ::init();
        add_action("do_dive","dive");
}

int do_dive()
{
        object fu,me = this_player();
        
        if( ( !(fu=present("bishui zhou", me)) 
            || (string)fu->query("unit")!="张" )
          && (string)me->query("family/family_name")!="龙宫" 
          && (string)me->query("family/family_name")!="东海龙宫" )
                return notify_fail("你一个猛子扎到水里．．．

但没多会儿就被憋得半死，只好赶紧爬上岸来。\n");

        if ( me->is_busy() )
                return notify_fail("你现在正忙着。\n");
        me->start_busy(1);
        message_vision(HIY "$N一个猛子扎到水中，然后不见了．\n" NOR, me);
        me->move(__DIR__"shuichi-e2");
        message_vision("$N潜了过来。\n",me);
        return 1;
}

int valid_leave(object who,string dir)
{
        if( dir=="east"
         && who->query_temp("huanbo/dongdong_go") )
                who->delete_temp("huanbo/dongdong_go");
        return ::valid_leave(who,dir);
}
