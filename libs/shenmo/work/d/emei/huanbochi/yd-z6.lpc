#include <ansi.h>
#include <room.h>
inherit __DIR__ "r.lpc";

void create_room() {
  set("short", "甬道");
  set("long", @LONG
这一带甬路本是又高又窄，忽然接连两个转折过去，
地势突往上高起了数十丈。
    
LONG);
  set("exits", ([
    "east": __DIR__ "yd-z5",
    "west": __DIR__ "zhudong-z",
  ]));
  create_door("east", "石像", "west", DOOR_CLOSED);
}
