#include <ansi.h>
#include <room.h>
inherit __DIR__ "r.lpc";

string *Xyj = ({
  "混沌未分天地乱", "茫茫渺渺无人见", "自从盘古破鸿蒙", "开辟从兹清浊辨",
  "覆载群生仰至仁", "发明万物皆成善", "欲知造化会元功", "须看西游释厄传",
  "大觉金仙没垢姿", "西方妙相祖菩提", "不生不灭三三行", "全气全神万万慈",
  "空寂自然随变化", "真如本性任为之", "与天同寿庄严体", "历劫明心大法师",
});

mapping ran_msg(string arg) {
  int i;
  mapping temp;
  string str;
  if (!arg || !stringp(arg))
    return 0;
  i = random(strlen(arg) / 2) * 2;
  str = sprintf("%s", arg[i..(i + 1)]);
  arg = replace_string(arg, str, "  ");
  temp = ([]);
  temp["msg"] = arg;
  temp["zi"] = str;
  return temp;
}

void create_msg(object me) {
  int i;
  mapping t1, t2;
  string s1, s2, msg, true;
  if (!me || !userp(me) || !me->query_temp("in_huanbo"))
    return;
  if (me->query_temp("huanbo/read"))
    return;
  i = random(sizeof(Xyj) / 2) * 2;
  s1 = Xyj[i];
  s2 = Xyj[i + 1];
  t1 = ran_msg(s1);
  t2 = ran_msg(s2);
  msg = t1["msg"] + "，" + t2["msg"];
  true = t1["zi"] + " " + t2["zi"];
  me->set_temp("huanbo/read", msg);
  me->set_temp("huanbo/read_true", true);
  me->set_temp("huanbo/reads", s1 + "、" + s2);
  return;
}

void create_room() {
  set("short", "西洞大门");
  set("long", @LONG
两扇洞门金光灿烂，在一片幽暗之中分外起眼。不知是
什么质地的玉石浑然雕琢而成，上面也有两个黑环(huan)，
洞门俱是圆拱形，关得严丝合缝。
    洞门两壁好似雕刻了一些图案(tu)。
LONG);
  set("exits", ([
    "east": __DIR__ "xuedi",
    "west": __DIR__ "shishi-w1",
  ]));
  create_door("west", "洞门", "east", DOOR_CLOSED);
  set("wuxing", "金");
  set("damage", 1200);
  set("damage_msg", HIY "\n只见半空金气大胜，阵法轰鸣，不多时便撒下万千金针，宛如瓢泼！\n" NOR);
  set("no_lianhua", 1);
  set("death_msg", "在幻波池西门「万精金针大阵」中化为齑粉！\n");
  set("hits", 3);
}

void init() {
  ::init();
  add_action("do_open", "open");
  add_action("do_look", "look");
  add_action("do_say", "say");
  add_action("do_la", "la");
}

int do_la(string arg) {
  object me = this_player();

  if (!arg)
    return 0;
  if (!me->query_temp("huanbo/can_la")) {
    write("你伸手拽了拽门上的圆环，结果手中一滑，不由打了个踉跄。\n");
    me->delete_temp("last_damage_from");
    me->set_temp("death_msg", "$N在幻波池脱力而亡。\n");
    me->receive_damage("kee", 500);
    return 1;
  }
  write("你伸手拽了拽门上的圆环，只听门内“嘎嘣”一声，机括响动，大门(door)有打开(open)的迹象。\n");
  me->set_temp("huanbo/can_open", 1);
  return 1;
}

int do_look(string arg) {
  object me = this_player();
  if (!arg)
    return 0;
  if (arg == "huan") {
    if (me->query_temp("huanbo/speak")) {
      write("两个黑黝黝的圆环，不知是什么制成，上面灵气逼人。\n");
      write("看起来，能用手拽拽(la)。\n");
      if (!me->query_temp("huanbo/can_la"))
        me->set_temp("huanbo/can_la", 1);
      return 1;
    }
    write("两个乌黑锃亮的大圆环，好大的说。\n");
    return 1;
  }
  if (arg == "tu") {
    if (me->query_temp("huanbo/read"))
      write(me->query_temp("huanbo/reads") + "\n");
    else {
      write("你仔细观看，方发现原来两行古篆。\n");
      if (random(me->query_skill("literate", 1) / 10) < 6) {
        write("可惜你腹中文墨羞涩，看不懂是什么。\n");
        return 1;
      }
      create_msg(me);
      write("你仔细辨认半响，发现原来刻的是:\n");
      write(me->query_temp("huanbo/read") + "\n");
      write("这少去的两字到底是什么呢？\n");
    }
    return 1;
  }
  return 0;
}

int do_say(string arg) {
  object me = this_player();
  if (!arg)
    return 0;
  if (me->query_temp("huanbo/speak"))
    return 0;
  message_vision(CYN "$N" CYN "低声喃喃自语道：" + arg + "。\n" NOR, me);
  if (me->query_temp("huanbo/read_true")
    && arg == me->query_temp("huanbo/read_true"))
    me->set_temp("huanbo/speak", 1);
  return 1;
}

void remove_door() {
  remove_call_out("remove_door");
  if (close_door("west"))
    tell_room(this_object(), "\n“轰隆隆”一声巨响，两扇大门又合了起来！\n\n");
}

int do_open(string arg) {
  object me = this_player();

  if (!arg || (arg != "west" && arg != "door" && arg != "洞门"))
    return 0;
  if (!me->query_temp("huanbo/can_open")) {
    write("你拉住门环，死命往怀里拉了拉。\n");
    write("结果什么反应也没有。\n");
    return 1;
  }
  if (open_door("west")) {
    //                me->delete_temp("huanbo);
    write("\n好一个别有洞天，快进快进！\n");
    call_out("remove_door", 30);
    return 1;
  }
  return 0;
}
