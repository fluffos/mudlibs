#include <ansi.h>
inherit __DIR__ "r.lpc";

void succ_break(object who);

void create_room() {
  set("short", "风洞");
  set("long", @LONG
    此处九天罡风四处激荡，呼啸猛烈，万物不存，更在那
罡风之上的极远处，便是无穷无尽地虚空，繁星点点，幽远
神秘。
    在飓风极远的中心便是那肆虐的风眼(fengyan)。
LONG);
  set("item_desc", ([
    "fengyan": "此处九天罡风的风眼，将之击破(break)方能止住此处呼啸激
荡的飓风。\n",
  ]));
}

void reset() {
  ::reset();
  set("jiguan", 1);
}

void succ_break(object who) {
  object ww, room;
  if (!who || !present(who)
    || !living(who))
    return;
  tell_room(this_object(), "\n\n风眼轰的化作了碎片，顿时风平浪静。。。。\n");
  set("long", "\n风平浪静... ... \n");
  set("jiguan", 0);
  message(
    "team",
    WHT "【队伍】" + who->name(1) + "：我已破除了" + query("short") + WHT "的禁制。\n" NOR,
    who->query_team()
  );
  if (userp(who))
    who->add_temp("huanbo/jiguan_flag", 1);
  else if (ww = who->query("owner"))
    ww->add_temp("huanbo/jiguan_flag", 1);
  who->delete_temp("breaking");
  who->delete_temp("huanbo/mijing_type");
  who->move(__DIR__ "mijing-e2");
  message_vision("\n浓雾散去，露出了$N的身影。\n\n", who);
}

void init() {
  ::init();
  add_action("do_break", "break");
  if (!userp(this_player()))
    call_out("succ_break", 5 + random(5), this_player());
}

string status_msg(int ratio) {
  string str = NOR "( 狂风";
  if (ratio > 9) str += HIG "依旧肆虐，四处激荡。" NOR;
  else if (ratio > 8) str += HIG "稍微减弱了一点，但依旧肆虐。" NOR;
  else if (ratio > 7) str += HIY "看起来很明显的减弱了。" NOR;
  else if (ratio > 6) str += HIY "渐渐变弱了，但是仍然四处呼啸。" NOR;
  else if (ratio > 5) str += HIR "明显不如以前，看起来状况并不太好。" NOR;
  else if (ratio > 4) str += HIR "变得软弱不堪，看来快要停住了。" NOR;
  else if (ratio > 3) str += RED "如同风中残烛，正在勉力支撑着不散去。" NOR;
  else str += RED "看起来已经力不从心,马上要支持不住了。" NOR;
  str += ")\n";
  return str;
}

void _break(object who, int t) {
  int mt;
  mapping action;
  object weapon;
  string str;
  if (!who || !present(who)
    || !living(who))
    return;
  if (t <= 0) {
    succ_break(who);
    return;
  }
  action = who->query("actions");
  str = "\n" + action["action"] + "\n";
  weapon = who->query_temp("weapon");
  str = replace_string(str, "$n", "狂风");
  str = replace_string(str, "$w", weapon ? weapon->query("name") : "双拳");
  str = replace_string(str, "$l", "");
  str += status_msg(t);
  message_vision(str, who);
  who->add("mana", -350);
}

void breaking(object who, int t) {
  remove_call_out("breaking");
  if (!who || !present(who))
    return;
  if (who->query("mana") < 350) {
    tell_object(who, "由于法力不足，你的动作停住了。\n");
    who->delete_temp("breaking");
    return;
  }
  if (t <= 0) {
    succ_break(who);
    return;
  }
  _break(who, t);
  t = t - 1;
  call_out("breaking", 1 + random(3), who, t);
}

int do_break(string arg) {
  int tt, succ = 0;
  object weapon, me = this_player();
  if (!arg || arg != "fengyan")
    return err_msg("你要击碎什么？\n");
  if (!query("jiguan"))
    return err_msg("此处禁制已经给破了。\n");
  if (me->query_temp("breaking"))
    return err_msg("你现在正忙呢。\n");
  if (weapon = me->query_temp("weapon"))
    succ++;
  if (random(me->query("mana") / 100) > 10)
    succ++;
  if (random(me->query("mana_factor") / 10) > 10)
    succ++;
  if (random(me->query("daoxing") / 100000) > 10)
    succ++;
  if (random(me->query("level") / 10) > 10)
    succ++;
  if (me->query_temp("huanbo/mijing_type") != "wind")
    succ = 0;
  message_vision("$N握紧" + (weapon ? weapon->query("name") : "双拳") + "，运足全身气力猛击风眼！\n", me);
  if (random(succ) <= 1)
    return err_msg("结果你的攻击被强风刮歪了。\n");

  me->set_temp("breaking", 1);
  call_out("breaking", 1, me, 10);
  return 1;
}
