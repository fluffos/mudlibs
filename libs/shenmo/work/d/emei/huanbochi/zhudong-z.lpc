#include <ansi.h>
#include <room.h>
inherit __DIR__"r.lpc";

void create_room()
{
        set("short","中洞主室");
        set("long",@LONG
内里乃是一间大约半亩的玉室，室中心横着一条青玉案，
天书、藏珍俱在其中，有的奇宝腾辉，精芒夺目；有的奇书
鸟篆，形制古异。五光十色，观之目眩。
LONG);  
        set("exits",([
                "north" : __DIR__"zhongdong-damen",
//              "down"  : __FILE__,   //乃圣姑坐死关的所在，无法进去，可由上层甬路开通出去，
                "out"   : __DIR__"lingqin", //灵寝
                "east"  : __DIR__"yd-z6",   //东洞复壁秘径
                "up"    : __DIR__"yd-u1", //上层甬道
                "enter" : __DIR__"bz-z1", //中洞宝藏
                
        ]));    
        create_door("north", "宫门", "south", DOOR_CLOSED); 
        set("no_lianhua",1);
/*      set("item_desc",([
                "down" : "下层乃圣姑坐死关的所在，不过各种阵法禁忌太多，无法进入。\n",
        ]));    */
}

void quest(object who)
{
        object zhou;
        remove_call_out("quest");
        if( !who || !present(who) )
                return;
        zhou = who->query_temp("huanbo/zhouqingyun");
        if( !zhou || !present(zhou) )
                return;
        zhou->command("say 既然此路不通，我们试试从上层绕过去。\n");
        return;
}               

int valid_leave(object who,string dir)
{
        if( dir=="out" && userp(who) )
        {
                call_out("quest",1+random(3),who);
                return notify_fail("忽听一个少女喝道：“来人止步，免遭不测。”\n");
        }
        if( dir=="up" && !who->query("huanbochi/tiezhu") && userp(who) )
                return notify_fail("还是先去中洞宝藏寻一称手的法宝。\n");
        return ::valid_leave(who,dir);
}       
