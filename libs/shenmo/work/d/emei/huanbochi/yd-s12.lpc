#include <ansi.h>
inherit __DIR__ "r.lpc";

void create_room() {
  set("short", "甬道");
  set("long", @LONG
小径开始由斜坡转入平路，甬道也已变作了圆形，
只有丈许方圆，宛如一条长蛇，一路婉蜒而来。
LONG);
  set("exits", ([
    "down": __DIR__ "yd-s11",
    "south": __DIR__ "zhongdong-damen",
  ]));
}

int valid_leave(object who, string dir) {
  if (dir == "south")
    return notify_fail("圆洞尽头有一片同样大小的黄光将路阻住，光景沉静晦暗，色彩并不鲜明，也看不出那光有多厚多深。\n");
  return ::valid_leave(who, dir);
}
