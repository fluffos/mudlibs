#include <ansi.h>
#include <room.h>
inherit __DIR__ "r.lpc";

void create_room() {
  set("short", "甬道");
  set("long", @LONG
这是一个与门一般大小的曲折甬道。顶上一颗颗的金星，
往前直排下去，每隔二三丈远，必有一个，行列甚是整齐，
金光四射，耀眼生花。
LONG);
  set("exits", ([
    "east": __DIR__ "yd-w1",
    "west": __DIR__ "yd-w3",
  ]));
}

int valid_leave(object who, string dir) {
  string msg;
  int damage, xk;
  object fb;
  if (!userp(who) || dir != "west")
    return ::valid_leave(who, dir);
  if (random(who->query_temp("huanbo_w")) < 1) {
    who->add_temp("huanbo_w", 1);
    tell_object(who, NOR YEL "只见一支穿云箭“嗖”的一声，风驰电掣般朝你面门而来！\n" NOR);
    damage = 100;
    xk = SPELL_D->wuxing_xs(SPELL_D->query_time_wuxing(), "金");
    if (xk == 1)
      damage = damage / 2;
    else if (xk == -1)
      damage *= 2;  //如果法宝五行克制时辰五行
      fb = who->query_temp("armor/FABAO");
    if (fb)
      damage = fb->protect_shen(damage, "金");
    if (damage > 50) {
      damage += random(damage);
      msg = NOR + YEL + COMBAT_D->damage_msg(damage, "刺伤") + NOR;
      msg = replace_string(msg, "$n", "你");
      msg = replace_string(msg, "$p", "你");
      msg = replace_string(msg, "$l", "面门");
      msg = replace_string(msg, "$w", "箭头");
      tell_object(who, msg);
      who->delete_temp("last_damage_from");
      who->set_temp("death_msg", "在地宫身中数箭而亡。");
      who->receive_wound("kee", damage);
      return notify_fail("\n");
    }
  }
  return ::valid_leave(who, dir);
}
