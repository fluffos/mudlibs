#include <ansi.h>
inherit __DIR__"r.lpc";

string *kn = ({
        "天","地","人",
});     

void create_room()
{
        set("short","方塘");
        set("long",@LONG
迎面是一座三丈多高、八尺来宽的玉壁。壁上白如玉
雪，晶明若镜，上面俱是水流影子，纵横交错，盘舞其上，
好些灵符，宛如龙蛇飞舞，极似塘中水光反映。
LONG);  
        set("exits",([
                "south" : __DIR__"fangtang",
        ]));    
}

void init()
{
        ::init();
        add_action("do_kneel","kneel");
        add_action("do_think","think");
}

int do_think()
{
        int ap;
        object me = this_player();
        if( me->is_busy() )
                return err_msg("你现在正忙。\n");
        if( me->query_temp("huanbo/shuizhen_learned") )
                return err_msg("你已学会了。\n");
        if( me->query("sen")<800 )
                return err_msg("你精神好差。\n");
        me->start_busy(2);      
        write("你静下心来一心默记壁间图形和上面符篆方位。\n");
        me->receive_damage("sen",800);
        ap = me->query_int();
        ap = ap/2+random(ap/2);
        if( random(ap)<20 )
                write("结果你悟性不够，与灵感失之交臂。\n");                    
        else
        {
                write("成功了！\n");
                write("你成功领悟了"HIG"「癸水大阵」"NOR"的破解之法。\n");
                me->set_temp("huanbo/shuizhen_learned",1);
        }       
        return 1;
}

int check_env()
{
        string str,*msgs;
        object room;
        if( !str=query("kneel") )
                return 0;
        msgs = ({});
        msgs+= ({str}); 
        room = find_object(__DIR__"fangtang-right");
        if( !room )
                return 0;
        if( !str=room->query("kneel") )
                return 0;
        if( member_array(str,msgs)!=-1 )
                return 0;
        msgs+= ({str}); 
        room = find_object(__DIR__"fangtang-left");
        if( !room )
                return 0;
        if( !str=room->query("kneel") )
                return 0;
        if( member_array(str,msgs)!=-1 )
                return 0;
        msgs+= ({str}); 
        if( sizeof(msgs)!=sizeof(kn) )
                return 0;
        return 1;
}                                       

void open_tang()
{
        object room;
        room = find_object(__DIR__"fangtang");
        if( !room )
                return;
        room->set("can_dive",1);
        tell_room(room,"\n\n这时地底风涛之声依旧猛烈，方塘已变作一泓清波，平明若镜，可鉴毛发。 \n\n");
        return;
}       

int do_kneel()
{
        string arg;
        object me = this_player();
        
        if( !me->query_temp("huanbochi/zhaoyaner_help") )
                return 0;
        if( me->is_busy() )
                return err_msg("你现在正忙着。\n");
        message_vision("$N在玉壁前拜倒下去，通诚默祝。\n",me);
        me->start_busy(2);
        arg = kn[random(sizeof(kn))];
        switch(arg)
        {
                case "天" : 
                        message_vision("\n\n只见壁上水影游动起来，仿若活物，直直朝上游动。\n\n",me);
                        break;
                case "地" : 
                        message_vision("\n\n只见壁上水影游动起来，仿若活物，直直朝上游动。\n\n",me);
                        break;
                case "人" : 
                        message_vision("\n\n只见壁上水影游动起来，仿若活物，不停原地游走。\n\n",me);
                        break;
                default : return 1;     
        }
        set("kneel",arg);
        if( check_env() )
        {
                message_vision("\n\n这时地底风涛之声依旧猛烈，方塘已变作一泓清波，平明若镜，可鉴毛发。 \n\n",me);
                open_tang();
        }
        return 1;
}
