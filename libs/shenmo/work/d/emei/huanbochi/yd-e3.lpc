#include <ansi.h>
inherit __DIR__ "r.lpc";

void create_room() {
  set("short", "甬道");
  set("long", @LONG
一进甬道，还没多远，忽然眼前一暗，轰隆之声大作。甬
路已经不见，前面一片甚是空旷，千百万根大树碧玉森森，重
重叠叠，潮涌而来。互相挤轧磨荡，汇为怒啸，声势惊人。
LONG);
  set("exits", ([
    "north": __DIR__ "dongdong-damen",
    "south": __DIR__ "yd-e2",
  ]));
  set("forall", 1);
  set("wuxing", "木");
  set("damage", 4500);
  set("mana", 6);
  set("damage_msg", NOR "\n千百万根大树碧玉森森，重重叠叠，潮涌而来。互相挤轧磨荡，
汇为怒啸，声势惊人。\n" NOR);
  set("death_msg", "在幻波池「四象庚木阵」中化作焦炭！\n");
}

void env_wuxing_hit(object who) {
  object fb;
  int damage;
  string death_msg, msg;

  if (query("mana") <= 0) {
    remove_call_out("env_wuxing_hit");
    return;
  }

  if (who && environment(who)
    && environment(who) == this_object()) {
    damage = query("damage");
    msg = query("damage_msg");
    if (!msg || !stringp(msg))
      msg = "一声巨响，五行之力源源不断的袭向$N！\n";
    message_vision(msg, who);
    fb = who->query_temp("armor/FABAO");
    if (fb && fb->query("mana") > 0)
      damage = fb->protect_shen(damage, "木");
    if (damage <= 0) {
      if (userp(who)
        && who->query("huanbochi/yinsiniang")
        && who->query("huanbochi/huxian"))
        add("mana", -1);
      if (query("mana") <= 0) {
        remove_call_out("env_wuxing_hit");
        message_vision(HIY "\n$N" HIY "顶梁忽现丈许长的半环金光，一左一右围上树木，青烟四起，顿时万木全消！\n\n" NOR, who);
        set("long", "空荡荡的一条甬道，深不见底。\n");
        return;
      }
    } else {
      death_msg = query("death_msg");
      if (!death_msg || !stringp(death_msg))
        death_msg = "在幻波池被五行之轰成亟灰！";
      who->delete_temp("last_damage_from");
      who->set_temp("death_msg", death_msg);
      who->receive_wound("sen", damage);
      COMBAT_D->report_sen_status(who, 1);
    }
  }
  call_out("env_wuxing_hit", 2 + random(3), who);
}

int valid_leave(object who, string dir) {
  if (dir == "north" || dir == "south") {
    if (query("mana") > 0)
      return notify_fail("千百万根大树碧玉森森，重重叠叠，潮涌而来。互相挤轧磨荡，
汇为怒啸，声势惊人。\n");
  }
  return ::valid_leave(who, dir);
}


void reset() {
  ::reset();
  set("mana", 6);
}
