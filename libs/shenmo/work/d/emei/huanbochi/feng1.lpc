#include <ansi.h>
#include <room.h>
inherit __DIR__"feng.lpc";

void create_room()
{
        set("short",HIY"风之道"NOR);
        set("long",@LONG
这狭长甬道之内遍布三界之风，人行走其中只感到举步
维艰。    
LONG);  
        set("exits",([
                "west"  :  (: random_exit :),
                "north" :  __DIR__"feng2",
                "south" :  (: random_exit :),
                "east"  : __DIR__"shishi-w2",
        ]));    
        create_door("east", "石壁", "west", DOOR_CLOSED); 
        set("no_lianhua",1);
        set("wuxing","土");
        set("damage",1);
}


varargs void do_close(object me)
{
        remove_call_out("do_close");
        close_door("east");
        tell_room(this_object(),"风沙骤起，一时看不清来时的方向。\n",me);
        if( me && present(me,this_object()) )
        {
                remove_call_out("do_open");
                call_out("do_open",10,me);
        }               
}

void do_open(object me)
{
        remove_call_out("do_open");
        if( !me || !present(me,this_object()) ) return;
        if( open_door("east") )
        {
                message_vision("$N念动真言，聚起无上法力，双手缓缓抵住石壁。\n",me);
                message_vision("狂风过后，现出一道大门。\n",me);
        }
        remove_call_out("do_close");
        call_out("do_close",10,me);
}       

void init()
{
        object me = this_player();
        if( me->query("id")=="zhou qing yun"
         && !userp(me) )
        {
                message_vision(CYN"$N"CYN"说道：看来此处乃「十万风沙慑心阵」。\n"NOR,me);
                remove_call_out("do_open");
                call_out("do_open",30,me);
        }
}                       

