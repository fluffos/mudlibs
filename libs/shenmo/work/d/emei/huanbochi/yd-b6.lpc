#include <ansi.h>
inherit __DIR__"r.lpc";

void create_room()
{
        set("short","甬道");
        set("long",@LONG
一条狭长的甬道，地势逐渐向下，头顶开始出现一些大
小不一的石乳。
    在一旁的石壁上，挂着一盏蓝灯(deng)。
LONG);  
        set("exits",([
                "north" : __DIR__"yd-b7",
                "east"  : __DIR__"yd-b5",
        ]));    
        set("item_desc",([
                "deng" : "一盏小巧的蓝灯，灯罩可以旋转(turn)。\n",
        ]));            
}

void init()
{
        ::init();
        add_action("do_turn","turn");
}

int do_turn(string arg)
{
        int k;
        object room;
        if( !arg || (arg!="deng" && arg!="灯") )
                return err_msg("你要转什么？\n");
        if( this_player()->is_busy() )
                return err_msg("你正忙着呢。\n");
        message_vision("$N将蓝灯的灯罩转了一转。\n",this_player());
        this_player()->start_busy(1);
        room = find_object(__DIR__"yd-b9");
        if( !room )
                room = load_object(__DIR__"yd-b9");
        if( !room )
                return 1;
        k = room->do_push("blu");
        if( k==1 )
                message_vision("「咔」的一声，蓝灯亮了起来。\n",this_player());
        else if( k==2 )                 
                message_vision("「咔」的一声，蓝灯熄灭了。\n",this_player());   
        if( room->checkD() )
        {
                message_vision("只听前方深处传来「嘎嘣」一声的机括声。\n",this_player());
                room->openD();
        }
        return 1;
}       

