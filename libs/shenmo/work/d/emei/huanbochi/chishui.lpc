#include <ansi.h>
inherit __DIR__"r.lpc";

void create_room()
{
        set("short","池水");
        set("long",@LONG
清波溶溶，雪浪翻飞，洞穴顶部一圈，俱是泉源。水
从四方八面平喷出来，齐射中央，成了一个漩涡。然后汇
成一个大水柱，直落千丈，宛如一根数百丈长的小晶柱。
LONG);  
        set("exits",([
                "east" : __FILE__,
                "west" : __FILE__,
                "north" : __FILE__,
                "south" : __FILE__,
        ])); 
        set("item_desc",([
                "east" : "泡泡，全是泡泡，oO⊙○О゜Οο⊙○O。\n",
                "west" : "泡泡，全是泡泡，oO⊙○О゜Οο⊙○O。\n",
                "south" : "泡泡，全是泡泡，oO⊙○О゜Οο⊙○O。\n",
                "north" : "泡泡，全是泡泡，oO⊙○О゜Οο⊙○O。\n",
        ]));
}

void init()
{
        ::init();
        add_action("do_go",({"go","west","east","north","south",}));
}

void finish(object me)
{
        if( !me || !living(me) || !present(me,this_object()) )
                return;
        me->set_temp("block_msg/all", 0);               
        tell_object(me,"\n你游了过来。\n");     
        me->delete_temp("last_damage_from");
        me->set_temp("death_msg","$N在幻波池溺水而亡。\n");
        me->receive_damage("kee",100);
        if( me && living(me) && random(me->query_kar())>30 )
        {
                tell_object(me,"大发现！\n");
                tell_object(me,"你发现了池底的泉眼，顺着水势钻了进去！\n");
                me->move(__DIR__"xuedi");
        }
        return;
}

int do_go(string arg)
{
        mapping dir;
        string str = query_verb();
        object me = this_player();

        if( me->is_busy() )
                return 0;

        if( str[0..1]=="go" )
        {
                if( !arg )
                        return 0;
                if( member_array(arg,({"west","east","north","south"}))==-1 )
                        return 0;
        }
        else 
        {
                arg = str;
                if( member_array(str,({"west","east","north","south"}))==-1 )       
                        return 0;
        }
        
        dir = ([
                "west" : "西",
                "east" : "东",
                "north" : "北",
                "south" : "南",
        ]);
        
        write("你努力向"+dir[arg]+"边游去。\n\n");
        me->start_call_out( (: call_other, __FILE__, "finish", me:),3+random(3));      
        me->set_temp("block_msg/all", 1); 
        return 1;
}

