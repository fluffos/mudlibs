#include <ansi.h>
inherit __DIR__ "r.lpc";

void create_room() {
  set("short", "深山");
  set("long", @LONG
满岭尽是老桧松柏梗捕之类的大木，郁郁森森，参天蔽
日，奇花异卉，遍地皆是。加以涧谷幽奇，岩壑深秀，珍禽
异兽，见人不惊。端的是一座灵山胜域，非同凡境。那岭原
是东西横亘，长约数十里，就只当中隆起如坟，最高最大。
    岭的中心地带生着一大片异草，绿波如潮，随风起伏不
定。不知风再大点是什么效果。
LONG);
  set("exits", ([
    "east": __DIR__ "shenshan8",
  ]));
}

void init() {
  ::init();
  add_action("do_ji", "ji");
}

int do_ji(string arg) {
  string msg;
  object zhou, seal, me = this_player();
  if (!arg)
    return 0;
  if (me->is_busy()) {
    write("你正忙着。\n");
    return 1;
  }
  seal = present(arg, me);
  if (!seal || base_name(seal) != "/d/dntg/sky/obj/fenglingfu")
    return 0;
  if (me->query("mana") < 500) {
    write("你的法力不够了。\n");
    return 1;
  }
  me->add("mana", -500);
  destruct(seal);
  me->start_busy(1);
  msg = HIY "你喃喃地念了几句咒语，";
  if (random(me->query("mana") / 100) < 5) {
    msg += "结果什么反应也没有。\n" NOR;
    write(msg);
    return 1;
  }
  msg += "但见四下里狂风乍起，将周围异草吹得“呼呼”翻滚。\n";
  msg += "猛见得，异草中心忽的一下凹陷进去，你脚下一空，不由掉了进去！\n\n" NOR;
  write(msg);
  zhou = present("bishui zhou", me);
  if (!zhou || base_name(zhou) != "/d/obj/magic/bishuizhou")
    me->move(__DIR__ "chishui", 2);
  else me->move(__DIR__ "xuedi", 2);
  msg = "
原来这地方是一个大深穴。适才所见异草，乃是一种从未见过的奇树，约有
万千株，俱都环生穴畔，平伸出来，互相纠结，将穴口盖没。除当中那一点
较稀外，别的地方都被树干缠绕得没有丝毫空隙。树叶极为繁密，根根向上
挺生，万叶怒发。每叶长有丈许，又坚又利，连野兽都不能闯入。休说远处
看不见下面有池，便是近看，也只能看见些微树干。\n\n";
  write(msg);
  return 1;
}
