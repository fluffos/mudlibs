#include <ansi.h>
#include <room.h>
inherit __DIR__ "r.lpc";

void create_room() {
  set("short", "东洞入口");
  set("long", @LONG
这地方甚是广大，壁色青紫，作两半合拢，当中微凸，甚
为平滑上面另有一条长约丈许的石笋，贴生两半之上，连洞带
壁，形式恰似两片肝叶。
LONG);
  set("exits", ([
    "west": __DIR__ "xuedi",
    "north": __DIR__ "yd-e4",
    "south": __DIR__ "yd-e3",
  ]));
  create_door("north", "洞口", "south", DOOR_CLOSED);
}

void telling(object me) {
  remove_call_out("telling");
  if (!me || !present(me))
    return;
  tell_object(me, "\n此处往西好似不是来时的道路了。\n");
  me->set_temp("huanbo/dongdong_go", 1);
}

void init() {
  object me = this_player();
  ::init();
  add_action("do_hit", "hit");
  if (me->query_temp("pf_check")
    && !me->query("huanbochi/pingfeng-save")) {
    remove_call_out("telling");
    call_out("telling", 1 + random(4), me);
  }
}

void guanmen() {
  remove_call_out("guanmen");
  if (close_door("north"))
    tell_room(this_object(), "\n石笋轰隆一声，又回复了原位。\n\n");
}

int do_hit(string arg) {
  string str;
  object me = this_player();

  if (!arg || arg != "石笋")
    return 0;
  if (me->is_busy())
    return err_msg("你正忙着呢。\n");
  str = "$N猛运玄功改扳为推，一掌击向石笋头上，";
  if (me->query("force") < 500) {
    str += "结果震得是双手发麻，两脚发颤。\n";
    message_vision(str, me);
    me->start_busy(3);
    return 1;
  }
  me->add("force", -150);
  if (random(me->query_skill("force") / 10) < 10) {
    str += "结果震得是口吐鲜血两眼冒青光。\n";
    message_vision(str, me);
    me->start_busy(1);
    me->receive_wound("kee", 200);
    COMBAT_D->report_status(me, 1);
    return 1;
  }
  if (random(me->query_skill("spells") / 10) < 20) {
    str += "结果没有什么反应。\n";
    message_vision(str, me);
    me->start_busy(1);
    return 1;
  }
  if (open_door("north")) {
    str += "无意之中，竟将机\n关触动，神力到处，一片轰隆之声，石笋立往壁间陷入，现出\n一条甬道。\n";
    message_vision(str, me);
    call_out("guanmen", 5 + random(5));
    me->start_busy(1);

    return 1;
  }
  str += "直震得石笋是金星直冒。\n";
  message_vision(str, me);
  me->start_busy(1);
  return 1;
}

int valid_leave(object who, string dir) {
  object zhou;
  if (dir == "west"
    && userp(who)
    && who->query_temp("huanbo/dongdong_go")) {
    who->move(__DIR__ "shuichi-e");
    zhou = who->query_temp("huanbo/zhouqingyun");
    if (zhou && present(zhou))
      zhou->move(__DIR__ "shuichi-e");
    return 2;
  }
  return ::valid_leave(who, dir);
}
