#include <ansi.h>
inherit __DIR__"r.lpc";

void create_room()
{
        set("short","池中");
        set("long",@LONG
池中水波飞涌，急流旋转，成了一个大漩涡。人
一旦卷入池心漩涡之中，恐怕便没了命。
    水底隐现红光闪闪，似有一朵木莲，开合不休。
LONG);  
        set("exits",([
                "up"  : __DIR__"shuichi-e",  
        ]));
        set("item_desc",([
                "木莲" : "一朵木莲，开合不休。花朵中心好似是空心的，似乎是个机关，能放(insert)下什么东西。\n",
                "lian" :  "一朵木莲，开合不休。花朵中心好似是空心的，似乎是个机关，能放(insert)下什么东西。\n",
        ]));    
}

void juanru(object who)
{
        remove_call_out("juanru");
        if( !who || !present(who) )
                return;
        who->add_temp("huanbo/water",1);        
        if( who->query_temp("huanbo/water")>=5 )
        {
                who->delete_temp("last_damage_from");
                who->set_temp("death_msg","在幻波池东门被卷入了池中漩涡！");
                who->die();
                return;
        }
        tell_object(who,"\n一阵暗流涌动，你被冲向了池底漩涡！\n");
        switch(who->query_temp("huanbo/water"))
        {
                case 1 : tell_object(who,"( 你"HIG"似乎受了点轻伤，不过光从外表看不大出来。"NOR")\n\n");break;
                case 2 : tell_object(who,"( 你"HIY"受伤不轻，看起来状况并不太好。"NOR")\n\n");break;
                case 3 : tell_object(who,"( 你"HIR"气息粗重，动作开始散乱，看来所受的伤着实不轻。"NOR")\n\n");break;
                case 4 : tell_object(who,"( 你"RED"伤重之下已经难以支撑，眼看就要倒在地上。"NOR")\n\n");break;
                default: tell_object(who,"( 你"RED"受伤过重，已经有如风中残烛，随时都可能断气。"NOR")\n\n");break;
        }
        call_out("juanru",3+random(4),who);
}               

void init()
{
        ::init();
        if( this_player()->query_temp("huanbo/dongdong_go") )
                add_action("do_insert","insert");
        else    this_player()->start_busy(60);
        remove_call_out("juanru");
        call_out("juanru",1,this_player());
}

int do_insert(string arg)
{
        object pf,xin,wei,key,me = this_player();
        
        if( !arg )
                return err_msg("你要放进什么？\n");
        if( me->is_busy() )
                return err_msg("你现在正忙着。\n");
        key = present(arg,me);
        if( !key )
                return err_msg("你身上没有"+arg+"。\n");
        if( key->is_character() )
        {
                write("你将"+key->query("name")+"从背上放了下来，搁在地上。\n");
                write("你将"+key->query("name")+"狠命的往莲花中心塞，可惜实在是太大了，你累的浑身瘫软。\n");
                me->start_busy(60);
                juanru(me);
                return 1;
        }
        write("你将"+key->query("name")+"放进木莲花朵中。\n");
        me->start_busy(1);
        if( base_name(key)==__DIR__"obj/huangyu-key"
         && key->query("name")==HIY"黄玉钥匙"NOR )
        {
                write("池底深处顿时传来一阵轰鸣。\n");
                write("\n\n只见木莲上青光闪了几闪，整个渐渐萎缩下去。\n\n");
                write("小池中顿时风平浪静。\n");
                remove_call_out("juanru");
                xin = me->query_temp("huanbo/pf_save_xin");
                if( xin )
                {
                        xin->powerup();
                        CHANNEL_D->do_channel(xin,"chat","感谢"+me->query("name")+"助我脱困，奈何此时方蒙救援，已坏我数百年苦炼之功，后会有期，容图报德。");
                        destruct(xin);
                }
                wei = me->query_temp("huanbo/pf_save_wei");
                if( wei )
                {
                        wei->powerup();
                        CHANNEL_D->do_channel(wei,"chat","感谢"+me->query("name")+"助我脱困，奈何此时方蒙救援，已坏我数百年苦炼之功，后会有期，容图报德。");
                        destruct(wei);
                        
                }
                pf = me->query_temp("huanbo/pf_save_pf");
                if( pf )
                {
                        pf->delete("owner");
                        pf->remove_room();
                }
                me->set("huanbochi/pingfeng-save",1);
                me->delete_temp("huanbo/pf_save_pf");
                me->delete_temp("huanbo/pf_save_xin");
                me->delete_temp("huanbo/pf_save_wei");
                me->delete_temp("huanbo/water");
        }
        destruct(key);
        return 1;
}
