#include <ansi.h>
inherit __DIR__ "r.lpc";

void create_room() {
  set("short", "迷雾中");
  set("long", @LONG
这里雾气浓密，一望沉冥。
    初上路时，只觉出暗影中含有一种奇怪力量，上下前后
都有吸力，将人抵住，无论进退，俱有阻滞，去不多远，渐
觉身后和上下两方吸力加重，越往前越厉害。
LONG);
}

void quest(object who) {
  string tt, *tmp;
  int i;
  object zhou, yi, lee;
  mapping type = ([
    "风": "wind",
    "雷": "storm",
    "火": "fire",
  ]);
  remove_call_out("quest");
  if (!who || !living(who)
    || !living(who))
    return;
  zhou = who->query_temp("huanbo/zhouqingyun");
  yi = who->query_temp("huanbo/yj");
  lee = who->query_temp("huanbo/lyq");

  if (!zhou || !yi || !lee
    || !present(zhou) || !present(yi) || !present(lee))
    return;

  tmp = keys(type);
  tt = tmp[random(sizeof(tmp))];
  tmp -= ({ tt });
  tmp -= ({ 0 });

  zhou = present("zhou qing yun");
  zhou->set_temp("huanbo/mijing_type", tt);
  message_vision(CYN "\n$N" CYN "说道：我便去破那「" + tt + "」禁制。\n" NOR, zhou);
  message_vision("$N在迷雾中找到一出口，走了出去。\n", zhou);
  zhou->move(__DIR__ "jiguan-" + type[tt]);

  message_vision(CYN "\n$N" CYN "说道：我与周姐姐同去。\n" NOR, lee);
  message_vision("$N在迷雾中找到一出口，走了出去。\n", lee);
  lee->move(__DIR__ "mijing-e2");

  tt = tmp[random(sizeof(tmp))];
  tmp -= ({ tt });
  tmp -= ({ 0 });
  yi->set_temp("huanbo/mijing_type", type[tt]);
  message_vision(CYN "\n$N" CYN "说道：我便去破那「" + tt + "」禁制。\n" NOR, yi);
  message_vision("$N在迷雾中找到一出口，走了出去。\n", yi);
  yi->move(__DIR__ "jiguan-" + type[tt]);

  tt = tmp[random(sizeof(tmp))];
  who->set_temp("huanbo/mijing_type", type[tt]);
  tell_object(who, HIY "\n\n看来你需要去破破那「" HIR + tt + HIY "」禁制。\n" NOR);
}

void do_say(object who, int v) {
  object npc;
  if (!who || !living(who)
    || !living(who)) {
    remove_call_out("do_say");
    return;
  }
  switch (v) {
    case 1:
      npc = who->query_temp("huanbo/zhouqingyun");
      if (!npc || !present(npc)) {
        remove_call_out("do_say");
        return;
      }
      npc->command("say 此地有风雷火禁制。");
      remove_call_out("do_say");
      call_out("do_say", random(3) + 1, who, 2);
      return;
    case 2:
      npc = who->query_temp("huanbo/yj");
      if (!npc || !present(npc)) {
        remove_call_out("do_say");
        return;
      }
      npc->command("say 我等在此兵分三处，将此三种禁制分别破去。");
      remove_call_out("do_say");
      call_out("do_say", random(3) + 1, who, 3);
      return;
    default:
      npc = who->query_temp("huanbo/lyq");
      if (!npc || !present(npc)) {
        remove_call_out("do_say");
        return;
      }
      npc->command("say 如此甚好，便依易师姐所言。");
      remove_call_out("quest");
      call_out("quest", random(3) + 1, who);
      return;

  }
}

void init() {
  int t;
  ::init();
  add_action("do_go", "go");

  if (userp(this_player())) {
    remove_call_out("do_say");
    call_out("do_say", random(3) + 1, this_player(), 1);
  }
}

int do_go(string arg) {
  object me = this_player();
  if (!arg || !userp(me))
    return 0;
  if (me->query("kee") < 300)
    return err_msg("你给撞得头破血流了。\n");
  if (!me->query_temp("huanbo/mijing_type"))
    return err_msg("你在浓雾中不辨东西，梆地撞到了石壁上。\n");
  if (arg == "east" || arg == "west"
    || arg == "north" || arg == "south") {
    if (random(5)) {
      message_vision("$N在浓雾中不辨东西，梆地撞到了石壁上。\n", me);
      me->receive_kee("kee", 300);
      COMBAT_D->report_status(me);
    } else {
      message_vision("$N在迷雾中找到一出口，走了出去。\n", me);
      me->move(sprintf(__DIR__ "miwu%d", 1 + random(3)));
    }
    return 1;
  }
  return 0;
}
