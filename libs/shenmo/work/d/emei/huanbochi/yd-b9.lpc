#include <ansi.h>
#include <room.h>
inherit __DIR__ "r.lpc";

mapping cm = ([
  "red": "炙之岩浆",
  "yel": "炫之金精",
  "blu": "怒之东海",
]);

string color_msg();

void create_room() {
  set("short", "甬道");
  set("long", @LONG
一条狭长的甬道，地势逐渐向下，头顶开始出现一些大
小不一的石乳。
    在左侧的石壁上篆刻着一行小字(word)。
LONG);
  set("exits", ([
    "west": __DIR__ "xiaceng-b",
    "south": __DIR__ "yd-b8",
  ]));
  set("item_desc", ([
    "word": (: color_msg :),
  ]));
  create_door("west", "石壁", "east", DOOR_CLOSED);
}

string color_msg() {
  mixed *cl;
  int i;
  string str;
  if (!cl = query("ture"))
    return 0;
  if (!arrayp(cl))
    return 0;
  str = "一行古朴的篆刻，内容是：「";
  for (i = 0; i < sizeof(cl); i++) {
    str += cm[cl[i]];
    if (i == 0)
      str += "兮，穿";
    else if (i == 1)
      str += "兮，达";
  }
  str += "」。\n";
  return str;
}

void reset() {
  string color, *tmp, *temp, *cl = ({ "red", "yel", "blu" });
  ::reset();
  delete("pushed");
  temp = ({});
  tmp = cl;
  color = cl[random(sizeof(cl))];
  temp += ({ color });
  tmp -= ({ color });
  color = tmp[random(sizeof(tmp))];
  temp += ({ color });
  tmp -= ({ color });
  color = tmp[0];
  temp += ({ color });
  set("ture", temp);
}

int checkD() {
  int i;
  string *str1, *str2;
  str1 = query("ture");
  str2 = query("pushed");
  if (!str1 || !arrayp(str1)
    || !str2 || !arrayp(str2))
    return 0;
  i = sizeof(str1);
  if (i != sizeof(str2))
    return 0;
  for (i = 0; i < sizeof(str1); i++) {
    if (str1[i] != str2[i])
      return 0;
  }
  return 1;
}

//0--无反应 1--按下 2--弹出
int do_push(string color) {
  mixed *pushed;
  if (!color)
    return 0;
  pushed = query("pushed");
  if (!pushed || !arrayp(pushed))
    pushed = ({});
  if (member_array(color, pushed) == -1) {
    pushed += ({ color });
    set("pushed", pushed);
    return 1;
  } else {
    pushed -= ({ color });
    set("pushed", pushed);
    return 2;
  }
}

void closeD() {
  remove_call_out("closeD");
  delete("pushed");
  if (close_door("west"))
    tell_room(this_object(), "\n轰的一声，左侧的石壁缓缓上升，封住了洞口。\n\n");
}

int openD() {
  if (open_door("west")) {
    tell_room(this_object(), "\n轰的一声，左侧的石壁下沉，露出一个洞口。\n\n");
    remove_call_out("closeD");
    call_out("closeD", 10 + random(10));
    return 1;
  }
  return 0;
}
