#include <ansi.h>
#include <room.h>
inherit __DIR__ "r.lpc";

void create_room() {
  set("short", "甬道");
  set("long", @LONG
空荡荡的一条甬道，深不见底。
LONG);
  set("exits", ([
    "north": __DIR__ "yd-e5",
    "south": __DIR__ "dongdong-damen",
  ]));
  create_door("south", "石笋", "north", DOOR_CLOSED);
}

void guanmen() {
  remove_call_out("guanmen");
  close_door("south");
}

void kaimen(object who) {
  remove_call_out("kaimen");
  if (who && present(who, this_object())
    && living(who) && who->query_temp("to_open")) {
    if (open_door("south"))
      message_vision("$N猛运玄功一掌击向一旁的石壁，只听一片轰隆之声，出现了一面石门。\n", who);
    who->delete_temp("to_open");
    call_out("guanmen", 5 + random(5));
  }
}

void init() {
  ::init();
  if (!userp(this_player())
    && this_player()->query_temp("to_open")
    && this_player()->query("id") == "zhou qing yun")
    call_out("kaimen", 2 + random(3), this_player());
}
