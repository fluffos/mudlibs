#include <ansi.h>
#include <room.h>
inherit __DIR__"r.lpc";

void create_room()
{
        set("short","东洞主洞");
        set("long",@LONG
这是一间数十丈长大的石室。最前面立着一座二十多丈长
短的木屏风。
LONG);  
        set("exits",([
                "south" : __DIR__"dongdong-damen2",
                "enter" : __DIR__"zhudong-e2",
                "in"    : __DIR__"pingfeng",
        ]));    
        set("objects",([
                __DIR__"obj/pingfeng" : 1,
        ]));    
        create_door("south", "大门", "north", DOOR_CLOSED); 
        create_door("in", "屏风", "out", DOOR_CLOSED); 
}

void quest(object who)
{
        object pf,wei,xin;
        remove_call_out("quest");
        if( !who || !living(who) 
         || !present(who) 
         || who->query_temp("pf_check") )
                return;  
        
        pf = load_object(__DIR__"pingfeng");
        if( !pf )
                return;
        //屏风中有剧情了
        if( pf->query("questing") )
        {
                if( !sizeof(all_inventory(pf)) )
                        pf->delete("questing");
                else    return;
        }
        if( !pf->remove_room() )
                return;
        wei = new(__DIR__"npc/wei-pingfeng");
        wei->set("owner",who);
        wei->set("max_kee",who->query("max_kee"));
        wei->set("max_force",who->query("max_force"));
        wei->powerup();
        wei->set_hide(1);
        if( wei->move(pf) )
        {
                xin = new(__DIR__"npc/xin-pingfeng");
                xin->set("owner",who);
                xin->set("max_kee",who->query("max_kee"));
                xin->set("max_force",who->query("max_force"));
                xin->powerup();
                xin->set_hide(1);
                if( !xin->move(pf) )
                {
                        if( wei )  destruct(wei);
                        if( xin )  destruct(xin);
                        return;
                }
                pf->set("owner",who);
                who->set_temp("huanbo/pf_save_xin",xin);
                who->set_temp("huanbo/pf_save_wei",wei);
                who->set_temp("huanbo/pf_save_pf",pf);  
                tell_object(who,"               
屏风虽是立着，居然储有一泓清水，并不下滴。最奇怪的是，有两个
赤身男女在里面游泳，身材才如豆大，浮沉上下，嬉乐方酣。
女的生得和玉人相似，眉目如画，仿佛甚美。男的须髯如戟，遍身虬
筋裸露，奇丑非常。\n");                 
                who->set_temp("pf_check",1);
                tell_object(who,HIR"\n这俩人将有劫难，赶紧照着屏风中的提示前去救他们。\n"NOR); 
        }               
}
        
void init()
{
        ::init();
        if( userp(this_player())
         && !this_player()->query_temp("pf_check") 
         && this_player()->query("huanbochi/zhouqingyun") 
         && !this_player()->query("huanbochi/pingfeng-save") )
        {
                remove_call_out("quest");
                call_out("quest",8,this_player());
        }
}

