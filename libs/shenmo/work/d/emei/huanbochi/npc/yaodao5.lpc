//B1 300skills
#include <ansi.h>
inherit __DIR__"npc.lpc";

void create_name()
{
        set_name("妖道",({"yao dao","dao"}));
        set("noboss",1);
        set("long","眉目猥琐的老道，面带煞气。\n");
        set("gender", "男性");
        set("age",10+random(10));
        set("class","human");
        create_family("将军府", 2, "蓝");
        set("title", HIR"妖尸爪牙"NOR);
        set("nickname",HIG"牡丹花下死 做鬼也风流"NOR);
        set_skill("literate",300);
        set_skill("unarmed",300);
        set_skill("yanxing-steps",300);
        set_skill("force",300);
        set_skill("lengquan-force",300);
        set_skill("axe",300);
        set_skill("dodge",300);
        set_skill("parry",300);
        set_skill("sanban-axe",300);
        set_skill("bawang-qiang",300);
        set_skill("spells",300);
        set_skill("baguazhou",300);
        set_skill("spear",300);
        set_skill("mace",300);
        map_skill("force", "lengquan-force");
        map_skill("spells", "baguazhou");
        map_skill("axe", "sanban-axe");
        map_skill("parry", "sanban-axe");
        map_skill("spear", "bawang-qiang");   
        map_skill("dodge", "yanxing-steps");     
        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
                (: perform_action, "spear", "wanjian" :),
        }) );
        set("env/brief_message",1);
}       

void create()
{
        create_name();
        set("str", 200);
        set("spi",100);
        set("max_kee", 50000);
        set("max_sen", 30000);
        set("force", 9000);
        set("max_force", 4500);
        set("force_factor",0);
        set("max_mana", 4500);
        set("mana",9000);
        set("mana_factor", 100);
        set("level",100);

        set("weapon",([
                "make" : 1,
                "type" : ([ 
                        "spear" : 35,
                        ]),
                "value" : 1000,
                "time" : "丁酉年三月八日辰时二刻",
                "name" : "霸王枪",
                "or" : "海底金母",
                "id" : "qiang",
        ])); 
        
        set("env/brief_message",1);
        set("die_msg","$N惨叫一声，化作一道青烟散去。\n"NOR);
        set("kill_msg",CYN"$N"CYN"说道：嘿嘿，本将军送你去西天！\n"NOR);
        set("fabao_time",4+random(3));  
        setup();
        carry_object("/d/emei/huanbochi/obj/bonnet")->wear();
        carry_object("/d/emei/huanbochi/obj/heidaopao")->wear();
        carry_object("/d/obj/drug/jinchuang")->set_amount(500);
        carry_object("/d/obj/drug/hunyuandan")->set_amount(500);
        add_temp("apply/armor",80);
        add_temp("apply/damage",55);
}

void super_attack(object who)
{
        if( !who )
                return;
        if( !query_temp("weapon") )
        {
                command("huhuan");
                command("bianhua spear");
        }
}

int reward_ob(object who)
{
        object obj;
        if( who )
        {
                message_vision("\n$N惨叫一声，化作一道青烟散去。\n\n",this_object());
                obj = new("/d/emei/huanbochi/obj/paper-e9");
                obj->info_obj(this_object());
                if( obj->move(environment()) )
                        message_vision(HIY"\n从$N"HIY"的身上掉落了一张旧纸片。\n\n"NOR,this_object());
                else    destruct(obj);
        }
        destruct(this_object());
        return 1;       
}               
