//500skills
#include <ansi.h>
inherit __DIR__"npc.lpc";

void create()
{
        set_name("谢璎", ({"xie ying", "xie","ying",}));
        set("long","一身冰绡雾縠，云裳霞帔，宛如松风水月，良玉润珠，清丽高华，迥出尘表。光艳照人之中，别饶一种静逸绝尘之概，装束较以前还要淡雅。。\n");
        set("gender", "女性");
        set("age", 18);
        create_family("峨嵋派", 3, "弟子");
        set("class", "human");
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("combat_exp", 20000000);
        set("daoxing", 30000000);
        set("rank_info/respect", "姑娘");
        set("rank_info/rude","臭丫头");
        set("rank_info/self","本姑娘");
        set("rank_info/self_rude","本姑娘");
        set("per", 28);
        set("str", 250);
        set("spi",500);
        set("max_kee", 150000);
        set("max_sen", 150000);
        set("force", 16500);
        set("max_force", 8250);
        set("force_factor", 300);
        set("max_mana", 8250);
        set("mana",17000);
        set("mana_factor", 300);
        set("level",300);
        set_skill("unarmed",500);
        set_skill("literate",500);
        set_skill("dodge",500);
        set_skill("force",500);
        set_skill("parry",500);
        set_skill("sword",500);
        set_skill("spells",500);
        set_skill("tianlei-sword",500);
        set_skill("emeiforce",500);
        set_skill("zhutian-bu",500);
        set_skill("mahayana",500);
        set_skill("jinding-zhang",500);
       
        map_skill("dodge", "zhutian-bu");
        map_skill("sword", "tianlei-sword");
        map_skill("parry", "tianlei-sword");
        map_skill("spells", "mahayana");
        map_skill("force", "emeiforce");
        map_skill("unarmed", "jinding-zhang");

        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
                (: perform_action, "sword", "fuliu" :),
                (: perform_action, "sword", "huan" :),
                (: perform_action, "sword", "mie" :),
                }) );
        set_temp("apply/armor",150);
        set_temp("apply/damage",120);
        set("env/brief_message",1);
        set("kill_msg",CYN"$N"CYN"说道：今天本姑娘就为了天下人除了你这个妖孽！\n"NOR);
        setup();
        carry_object("/d/city/npc/obj/armor")->wear();  
        carry_object("/d/emei/huanbochi/obj/qingdaopao")->wear();        
        carry_object("/d/emei/huanbochi/obj/qibao-jindong")->wear();
        carry_object("/d/city/npc/obj/sword")->wield();
        carry_object("/d/obj/drug/jinchuang")->set_amount(300);
        carry_object("/d/obj/drug/hunyuandan")->set_amount(300);
}

void super_attack(object who)
{
        if( !who || !this_object()->is_fighting(who) )
                return;
        if( present("qibao jindong",this_object()) )
                command("ji qibao jindong on "+who->query("id"));
}

