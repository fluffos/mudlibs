//B1 400skills
#include <ansi.h>
inherit __DIR__ "npc.lpc";

void create() {
  set_name("丙融", ({ "bing rong", "bing", "rong", "dao" }));
  set("long", "相貌古怪的道装妖人，邪法高强，五官尤为灵敏，最善察听
闻嗅敌人踪迹，多高明的隐形法，只要在二三十步之内，立被警觉。\n");
  set("gender", "男性");
  set("age", 66);
  create_family("东海龙宫", 1, "水族");
  set("title", "赤霞神君");
  set("class", "xian");
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("combat_exp", 6400000);
  set("daoxing", 8000000);
  set("rank_info/respect", "老神仙");
  set("rank_info/rude", "妖道");
  set("rank_info/self", "老神仙我");
  set("rank_info/self_rude", "贫道");
  set("per", 10);
  set("str", 200);
  set("spi", 300);
  set("max_kee", 50000);
  set("max_sen", 80000);
  set("force", 12000);
  set("max_force", 6000);
  set("force_factor", 250);
  set("max_mana", 5000);
  set("mana", 10000);
  set("mana_factor", 200);

  set("level", 100);
  set_skill("literate", 300);
  set_skill("unarmed", 400);
  set_skill("dodge", 400);
  set_skill("force", 400);
  set_skill("parry", 400);
  set_skill("fork", 400);
  set_skill("spells", 400);
  set_skill("seashentong", 400);
  set_skill("dragonfight", 400);
  set_skill("dragonforce", 400);
  set_skill("fengbo-cha", 400);
  set_skill("dragonstep", 400);
  map_skill("spells", "seashentong");
  map_skill("unarmed", "dragonfight");
  map_skill("force", "dragonforce");
  map_skill("fork", "fengbo-cha");
  map_skill("parry", "fengbo-cha");
  map_skill("dodge", "dragonstep");
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "fork", "fengbo" :),
    (: perform_action, "fork", "jiutian" :),
    (: perform_action, "unarmed", "leidong" :),
    (: perform_action, "unarmed", "sheshen" :),
  }));
  set("env/brief_message", 1);
  set("die_msg", HIR "\n$N万想不到对手如此厉害，吓得心胆皆寒，哪里还敢停留，忙带着残余妖光急飞遁去。\n\n" NOR);
  set("die_msg2", NOR YEL "\n只见$N投入池中心水柱之中，顺流飞泻，四旁飞泉重又干涸，只剩那根水柱凌空飞堕。\n\n" NOR);
  set("die_room", "/d/emei/huanbochi/xuedi");
  set("kill_msg", CYN "$N" CYN "说道：既然你求死，本道爷就成全你！\n" NOR);
  set("leave_msg", ({
    "$N低声说道：旧友一直不曾再见，分明人在洞中，怎会除玉娘子外一人俱无？\n",
    "$N低声说道：此女口蜜腹剑，阴毒淫凶，有名尤物祸水，什事都做得出，莫要中了她的道儿，把自己数百年苦炼之功断送她手。\n",
    "$N低声说道：罢罢罢，且先回去，好歹先恢复了原体，免却万一之忧，再作打算。\n",
    "$N急急忙忙的带着妖光急飞遁去。\n",
  }));
  set("job", ([
    "data": "bingrong",
    "shen": 10,
    "dx": 30000,
  ]));
  set("remove_weapon", "cha");
  set("fabao_time", 4 + random(3));
  setup();
  carry_object("/d/emei/huanbochi/obj/bonnet")->wear();
  carry_object("/d/emei/huanbochi/obj/xuedaopao")->wear();
  carry_object("/d/emei/huanbochi/obj/chiyin-feicha")->wield();
  carry_object("/d/emei/huanbochi/obj/tianwen-qiu");
  carry_object("/d/emei/huanbochi/obj/hongjiao-jian");
  carry_object("/d/emei/huanbochi/obj/huaxue-shending");
  carry_object("/d/obj/drug/jinchuang")->set_amount(500);
  carry_object("/d/obj/drug/hunyuandan")->set_amount(500);
  add_temp("apply/armor", 80);
  add_temp("apply/damage", 55);
}

void super_attack(object who) {
  if (!who)
    return;
  if (present("hongjiao jian", this_object()))
    command("ji hongjiao jian on " + who->query("id"));
  if (present("tianwen qiu", this_object()))
    command("ji tianwen qiu on " + who->query("id"));
  if (present("huaxue ding", this_object()))
    command("ji huaxue ding on " + who->query("id"));
}
