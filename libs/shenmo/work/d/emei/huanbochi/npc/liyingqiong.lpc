//500skills
#include <ansi.h>
inherit __DIR__ "npc.lpc";

void create() {
  set_name("李英琼", ({ "li ying qiong", "li", "qiong", }));
  set("long", "一派秀眉英风，姿容绝世的少女。\n");
  set("gender", "女性");
  set("age", 18);
  create_family("峨嵋派", 3, "弟子");
  set("class", "human");
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("combat_exp", 20000000);
  set("daoxing", 30000000);
  set("rank_info/respect", "姑娘");
  set("rank_info/rude", "臭丫头");
  set("rank_info/self", "本姑娘");
  set("rank_info/self_rude", "本姑娘");
  set("per", 30);
  set("str", 250);
  set("spi", 500);
  set("max_kee", 100000);
  set("max_sen", 100000);
  set("force", 16500);
  set("max_force", 8250);
  set("force_factor", 300);
  set("max_mana", 8250);
  set("mana", 17000);
  set("mana_factor", 300);
  set("level", 150);
  set_skill("unarmed", 500);
  set_skill("literate", 500);
  set_skill("dodge", 500);
  set_skill("force", 500);
  set_skill("parry", 500);
  set_skill("sword", 500);
  set_skill("spells", 500);
  set_skill("tianlei-sword", 500);
  set_skill("emeiforce", 500);
  set_skill("zhutian-bu", 500);
  set_skill("mahayana", 500);
  set_skill("jinding-zhang", 500);

  map_skill("dodge", "zhutian-bu");
  map_skill("sword", "tianlei-sword");
  map_skill("parry", "tianlei-sword");
  map_skill("spells", "mahayana");
  map_skill("force", "emeiforce");
  map_skill("unarmed", "jinding-zhang");

  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "sword", "fuliu" :),
    (: perform_action, "sword", "huan" :),
    (: perform_action, "sword", "mie" :),
    (: perform_action, "sword", "riluo" :),
    (: perform_action, "sword", "tianlei" :),
  }));
  set_temp("apply/armor", 150);
  set_temp("apply/damage", 120);
  set("env/brief_message", 1);
  set("kill_msg", CYN "$N" CYN "说道：今天本姑娘就为了天下人除了你这个妖孽！\n" NOR);

  setup();
  carry_object("/d/city/npc/obj/armor")->wear();
  carry_object("/d/emei/huanbochi/obj/mouni-dingzhu")->wear();
  carry_object("/d/emei/huanbochi/obj/shuimu-jinwan")->wear();
  carry_object("/d/emei/huanbochi/obj/ziqing-yan1")->wear();
  carry_object("/d/emei/huanbochi/obj/wannian-wenyu")->wear();
  carry_object("/d/emei/huanbochi/obj/qingdaopao")->wear();
  carry_object("/d/emei/huanbochi/obj/ziying-jian")->wield();
  carry_object("/d/emei/huanbochi/obj/suiren-zuan");
  carry_object("/d/obj/drug/jinchuang")->set_amount(200);
  carry_object("/d/obj/drug/hunyuandan")->set_amount(200);
  set_living_name("李英琼");
}

void super_attack(object who) {
  if (!query_temp("weapon"))
    command("wield sword");
  if (present("suiren zuan", this_object()))
    command("ji suiren zuan on " + who->query("id"));
}

void init() {
  ::init();
  add_action("do_bian", "bian");
}

int do_bian(string arg) {
  object me = this_player();
  if (!arg || !id(arg))
    return 0;
  if (!this_object()->is_fighting(me)) {
    copy_data(me);
    message_vision(CYN "$N" CYN "说道：诺那贼子，敢尔？！\n" NOR, this_object());
    kill_ob(me);
  }
  return 1;
}

void dest_ob(object ob) {
  remove_call_out("dest_ob");
  if (ob) destruct(ob);
}

int reward_ob(object who) {
  object zhou;
  if (query_temp("quest_npc"))
    return 0;
  if (!who || !present(who, environment())) {
    message_vision("$N紧咬银牙，将身要纵，化作一道青光冲天而去！\n", this_object());
    this_object()->move("/d/emei/huanbochi/empty");
    call_out("dest_ob", 1, this_object());
    return 0;
  }
  if (query_temp("my_killer") && who != query_temp("my_killer")) {
    message_vision("$N紧咬银牙，将身要纵，化作一道青光冲天而去！\n", this_object());
    this_object()->move("/d/emei/huanbochi/empty");
    call_out("dest_ob", 1, this_object());
    return 0;
  }
  zhou = present("zhou qing yun", environment());
  who->set("huanbochi/liyingqiong", 1);
  set_temp("quest_npc", 1);
  powerup();
#ifdef SDS_D
  SDS_D->powerup(this_object());
#endif
  message_vision(CYN "\n$N" CYN "注视着$n" CYN "的行动，企图寻找机会出手。\n" NOR, who, this_object());
  if (zhou) {
    message_vision(CYN "「BEEP！」，$N" CYN "好像要找$n" CYN "．．．\n" NOR, zhou, this_object());
    message_vision(CYN "$n" CYN "对着$N" CYN "惊讶地“啊”了一声。\n" NOR, zhou, this_object());
    message_vision(CYN "$n" CYN "高兴地一下子跳到了$N" CYN "的怀里，搂住了$P的脖子。\n" NOR, zhou, this_object());
  } else {
    message_vision(CYN "$N" CYN "很疑惑地看着$n" CYN "。\n" NOR, who, this_object());
    message_vision(CYN "$N" CYN "「嗯」的一声，一副欲言又止的样子。\n" NOR, this_object());
    message_vision(CYN "$N" CYN "一脸的迷茫，不知道周围发生了什么事。\n" NOR, this_object());
  }
  message_vision(CYN "$N" CYN "说道：我以为姐姐已遭不测。\n" NOR, this_object());
  message_vision(CYN "$N" CYN "很不好意思地向$n" CYN "行礼致歉。\n" NOR, this_object(), who);
  message_vision(
    CYN "$N" CYN "双手抱拳，对$n" CYN "作了个揖道：这位" + RANK_D->query_respect(who) + "请了！\n" NOR,
    this_object(),
    who
  );
  message_vision(CYN "$N" CYN "说道：除魔卫道乃我峨眉责无旁贷的责任，看来这位道友也是同道中人。\n" NOR, this_object());
  set("owner", who);
  set_leader(who);
  message_vision(CYN "$N" CYN "说道：本姑娘便和你一同查看此处的奥秘吧。\n" NOR, this_object());
  tell_object(who, name() + "决定开始跟随你一起行动。\n");
  who->add_team_member(this_object());
  tell_object(who, WHT "【队伍】" + this_object()->query("name") + WHT "加入队伍。\n" NOR);
  return 1;
}
