//B1 450skills
#include <ansi.h>
inherit __DIR__ "npc.lpc";

void create() {
  set_name("胡贤", ({ "hu xian", "hu", "xian" }));
  set("long", "一位大汉，生相却极丑陋。肤作紫黑，身材高大，狼面鹰目，
颔绕虬须，身上青筋怒凸，宛若蚯蚓，胸前一簇黑毛，直达
下部，臂腿等处也是长而黑硬的汗毛，手足十分粗大，神态
凶野，望去直似一个怪毛人。身后，背着一个大黑葫芦。\n");
  set("gender", "男性");
  set("age", 46);
  create_family("东海龙宫", 1, "水族");
  set("title", "鸠盘婆孽徒");
  set("class", "xian");
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("combat_exp", 10000000);
  set("daoxing", 12000000);
  set("rank_info/respect", "老神仙");
  set("rank_info/rude", "妖道");
  set("rank_info/self", "老神仙我");
  set("rank_info/self_rude", "贫道");
  set("per", 10);
  set("str", 200);
  set("spi", 300);
  set("max_kee", 50000);
  set("max_sen", 80000);
  set("force", 13500);
  set("max_force", 6750);
  set("force_factor", 250);
  set("max_mana", 7000);
  set("mana", 14000);
  set("mana_factor", 200);

  set("level", 150);
  set_skill("literate", 450);
  set_skill("unarmed", 450);
  set_skill("dodge", 450);
  set_skill("force", 450);
  set_skill("parry", 450);
  set_skill("fork", 450);
  set_skill("spells", 450);
  set_skill("seashentong", 450);
  set_skill("dragonfight", 450);
  set_skill("dragonforce", 450);
  set_skill("fengbo-cha", 450);
  set_skill("dragonstep", 450);
  map_skill("spells", "seashentong");
  map_skill("unarmed", "dragonfight");
  map_skill("force", "dragonforce");
  map_skill("fork", "fengbo-cha");
  map_skill("parry", "fengbo-cha");
  map_skill("dodge", "dragonstep");
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "fork", "fengbo" :),
    (: perform_action, "fork", "jiutian" :),
    (: perform_action, "unarmed", "leidong" :),
    (: perform_action, "unarmed", "sheshen" :),
  }));
  set("env/brief_message", 1);
  set("die_msg", HIB "\n$N想不到对手如此厉害，不敢停留，卷起一道黑烟遁去。\n\n" NOR);
  set("kill_msg", CYN "$N" CYN "说道：老子要了你的命！\n" NOR);
  set("leave_msg", ({
    "$N哈哈一笑：回去与那婆娘亲热一番。\n",
    "$N急急忙忙的带着妖光急飞遁去。\n",
  }));
  set("job", ([
    "data": "huxian",
    "shen": 15,
    "dx": 55000,
  ]));
  set("remove_weapon", "cha");
  set("fabao_time", 4 + random(3));
  setup();
  carry_object("/d/emei/huanbochi/obj/bonnet")->wear();
  carry_object("/d/emei/huanbochi/obj/heidaopao")->wear();
  carry_object("/d/emei/huanbochi/obj/chiyin-feicha")->wield();
  carry_object("/d/emei/huanbochi/obj/heihulu");
  carry_object("/d/obj/drug/jinchuang")->set_amount(200);
  carry_object("/d/obj/drug/hunyuandan")->set_amount(200);
  add_temp("apply/armor", 180);
  add_temp("apply/damage", 155);
  set_living_name("胡贤");
}

void super_attack(object who) {
  if (!who)
    return;
  if (present("hei hulu", this_object())) {
    if (random(3) == 0)
      command("drink hei hulu");
    command("ji hei hulu");
  }
}
