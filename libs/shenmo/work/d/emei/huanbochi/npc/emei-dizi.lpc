void create() {
  string id, name, *names, *ids, name1, id1;
  int i;

  names = keys(Names);
  if (random(2)) {
    name1 = "周";
    id1 = "zhou";
  } else if (random(2)) {
    name1 = "李";
    id1 = "li";
  } else {
    name1 = "余";
    id1 = "yu";
  }
  name = names[random(sizeof(names))];
  if (!name)
    name = "怀云";
  id = Names[name];
  set_name(name1 + name, ({ id1 + " " + id, id, id1 }));
  set("gender", "女性");
  set("age", 16);
  create_family("峨嵋派", 4, "弟子");
  set_living_name("峨眉弟子");
  set("class", "human");
  set("combat_exp", 100000);
  set("daoxing", 10000);
  set("per", 23 + random(15));
  set("max_kee", 50000);
  set("max_sen", 50000);
  set("force", 1500);
  set("max_force", 1500);
  set("max_mana", 1500);
  set("mana", 1500);
  set("level", 50);
  set_skill("unarmed", 100);
  set_skill("literate", 100);
  set_skill("dodge", 100);
  set_skill("force", 100);
  set_skill("parry", 100);
  set_skill("sword", 100);
  set_skill("spells", 100);
  set_skill("tianlei-sword", 100);
  set_skill("emeiforce", 100);
  set_skill("zhutian-bu", 100);
  set_skill("mahayana", 100);
  set_skill("jinding-zhang", 100);
  map_skill("dodge", "zhutian-bu");
  map_skill("sword", "tianlei-sword");
  map_skill("parry", "tianlei-sword");
  map_skill("spells", "mahayana");
  map_skill("force", "emeiforce");
  map_skill("unarmed", "jinding-zhang");

  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "sword", "fuliu" :),
    (: perform_action, "sword", "huan" :),
    (: perform_action, "sword", "mie" :),
    (: perform_action, "sword", "riluo" :),
    (: perform_action, "sword", "tianlei" :),
  }));
  set("env/brief_message", 1);
  set("kill_msg", CYN "$N" CYN "说道：除魔卫道乃是我峨眉正道职责，今天就代表正道消灭你！\n" NOR);
  set("stay_time", 60);
  set("die_room", "/d/emei/huanbochi/dongdong-damen2");
  setup();
  carry_object("/d/city/npc/obj/armor")->wear();
  carry_object("/d/emei/huanbochi/obj/qingdaopao")->wear();
  carry_object("/d/obj/weapon/sword/xijian")->wield();
  carry_object("/d/obj/drug/jinchuang")->set_amount(50);
  carry_object("/d/obj/drug/hunyuandan")->set_amount(50);
}

void init() {
  ::init();
  add_action("do_go", "go");
}

int do_go() {
  write(query("name") + "拦住了你的去路。\n");
  return 1;
}
