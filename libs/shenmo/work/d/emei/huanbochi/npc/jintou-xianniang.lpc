//450skills
#include <ansi.h>
inherit __DIR__"npc.lpc";

void create()
{
        set_name("金头仙娘", ({"jintou xianniang", "xianniang","niang",}));
        set("long","一位风骚的道姑，面相轻佻，目光勾人。
本是小南极四十七岛妖人中的健者，平日自恃邪法，甚是凶横，
人又陰鸷险诈，城府极深。\n");
        set("gender", "女性");
        set("level", 300);
        set("class","yao");
        set("age", 43);
        set("str", 200);
        set("per", 11);
        set("int", 30);
        set("cor", 50);
        set("cps", 40);
        set("combat_exp", 11600000);
        set("daoxing",15000000);
        set_skill("force",450);
        set_skill("wudu-xinfa",450);
        set_skill("spells",450);
        set_skill("xiuluo-yinshagong",450);
        set_skill("sword",450);
        set_skill("whip",450);
        set_skill("ruanhong-zhusuo",450);
        set_skill("unarmed",450);
        set_skill("wudu-shenzhang",450);
        set_skill("parry",450);
        set_skill("literate",450);
        set_skill("dodge",450);
        set_skill("jinshe-steps",450);
        set_skill("jinwu-goufa",450);
        set_skill("sword",450);
        map_skill("force", "wudu-xinfa");
        map_skill("spells", "xiuluo-yinshagong");
        map_skill("unarmed", "wudu-shenzhang");
        map_skill("sword", "jinwu-goufa");
        map_skill("whip", "ruanhong-zhusuo");   
        map_skill("parry", "jinwu-goufa");
        map_skill("dodge", "jinshe-steps");
        set("max_sen", 20000);
        set("max_kee", 20000);
        set("force", 13500);
        set("max_force", 6750);
        set("mana",13500);
        set("max_mana",6750);
        set("force_factor", 100);
        set("mana_factor", 200);
        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
                (: perform_action, "sword", "duo" :),  
                (: exert_function, "huti" :),   
        }) );
        create_family("黄花观五毒门", 1, "蓝");
        set("title",MAG"螂道姑"NOR);
        set("env/brief_message",1);
        set("kill_msg",CYN"$N"CYN"说道：居然和我们抢宝藏，要了你的命！\n"NOR);
        setup();
        carry_object("/d/city/npc/obj/armor")->wear();  
        carry_object("/d/emei/huanbochi/obj/heidaopao")->wear();        
        carry_object("/d/emei/huanbochi/obj/duohun-jian")->wield();
        carry_object("/d/obj/drug/jinchuang")->set_amount(500);
        carry_object("/d/obj/drug/hunyuandan")->set_amount(500);
}

void super_attack(object who)
{
        int i;
        object *inv,yuan;
        if( !who || !this_object()->is_fighting(who) )
                return;
        if( this_object()->query_condition() )
                command("cast huadu");
        yuan = present("yuan ling",environment());
        if( yuan && living(yuan) && base_name(yuan)==__DIR__"yuanling" 
         && query("mana")>300 && yuan->query("mana")>300 
         && time()>query_temp("taiji_zhen")+8 )
        {
//混元无极阵
                message_vision(
HIB"$N"HIB"与"+yuan->query("name")+HIB"交错踏步，口中念念有词，面前光景
忽变，眼前倏地一暗，只听陰风怒号，万木悲鸣之声，宛如狂涛暴涌，震撼天地。
众人身外一片沉冥，只两边暗影中各有一个圆洞，一青一紫，色甚鲜明，却无什光
华，好似暗雾昏夜之中悬有两个青紫色的大灯笼，内里烟雾溟檬，什么迹象也看不
出。\n"NOR,this_object() );
                yuan->add("mana",-200);
                add("mana",-200);
                set_temp("taiji_zhen",time());
                inv = all_inventory(environment());
                for(i=0;i<sizeof(inv);i++)
                {
                        if( !inv[i] || !this_object()->is_fighting(inv[i])
                         || !userp(inv[i]) )
                                continue;                        
                        inv[i]->set_temp("no_perform",([
                                "msg"   : "\n你冲了一阵，哪知仍在暗雾之中，视野以外，只是一片氤氲，冥黑如漆。\n",
                                "time"  : 5,
                                "start" : time(),
                        ]));
                        inv[i]->set_temp("no_exert",([
                                "msg"   : "\n你冲了一阵，哪知仍在暗雾之中，视野以外，只是一片氤氲，冥黑如漆。\n",
                                "time"  : 5,
                                "start" : time(),
                        ]));
                        inv[i]->set_temp("no_cast2",([
                                "msg"   : "\n你冲了一阵，哪知仍在暗雾之中，视野以外，只是一片氤氲，冥黑如漆。\n",
                                "time"  : 5,
                                "start" : time(),
                        ]));
                }               
        }
}

int reward_ob(object who)
{
        string msg,*msg1,*msg2;
        if( !who || !living(who)
         || !present(who,environment()) )
                return 0;
        msg1 = ({
                CYN"$N"CYN"磨了磨牙。\n"NOR,
                CYN"$N"CYN"劈胸抓住自己的衣领，伸长脖子狂喊：老娘要掐人啦！！！\n"NOR,
                CYN"$N"CYN"终于忍不住骂了句:......shit...╭∩╮（︶︿︶）～～Ｓｈｉｔ～～\n"NOR,
        });     
        msg2 = ({
                CYN"$N"CYN"说道：这次不算，老娘把法宝戒天尺丢在洞府没带来。\n"NOR,
                CYN"$N"CYN"说道：这次不算，老娘昨夜穿少了衣物，身体抱恙。\n"NOR,
                CYN"$N"CYN"说道：这次不算，老娘通宵未瞑，没有状态。\n"NOR,
        });
        
        msg = msg1[random(sizeof(msg1))];
        msg+= msg2[random(sizeof(msg2))];
        message_vision(msg,this_object());
        who->set_temp("huanbochi/jintouxian",1);
        message_vision("\n$N急急忙忙的离开了。\n",this_object());
        destruct(this_object());
        return 1;
}
