//B1 300skills
#include <ansi.h>
inherit __DIR__ "npc.lpc";

void create_name() {
  mapping name;
  string *ids;
  name = NAME_D->random_name("female");
  ids = name["id"];
  ids += ({ "di zi" });
  set_name(name["name"], ids);
  set("noboss", 1);
  set("long", "美艳娇媚的女子，面目含情，眼带桃花。\n");
  set("gender", "女性");
  set("age", 20 + random(20));
  set("class", "xian");
  create_family("月宫", 2, "水");
  set("title", HIR "月宫孽徒" NOR);
  set_skill("literate", 300);
  set_skill("unarmed", 350);
  set_skill("dodge", 350);
  set_skill("force", 350);
  set_skill("parry", 350);
  set_skill("sword", 350);
  set_skill("spells", 350);
  set_skill("whip", 350);
  set_skill("moonshentong", 350);
  set_skill("baihua-zhang", 350);
  set_skill("moonforce", 350);
  set_skill("snowsword", 350);
  set_skill("moondance", 350);
  map_skill("spells", "moonshentong");
  map_skill("unarmed", "baihua-zhang");
  map_skill("force", "moonforce");
  map_skill("sword", "snowsword");
  map_skill("parry", "snowsword");
  map_skill("dodge", "moondance");
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "sword", "tian" :),
    (: perform_action, "sword", "wuxue" :),
  }));
  set("env/brief_message", 1);
}

void create() {
  create_name();
  set("per", 25 + random(5));
  set("str", 200);
  set("spi", 300);
  set("max_kee", 50000);
  set("max_sen", 30000);
  set("force", 9000);
  set("max_force", 4500);
  set("force_factor", 0);
  set("max_mana", 4500);
  set("mana", 9000);
  set("mana_factor", 100);
  set("level", 100);

  set("weapon", ([
    "make": 1,
    "type": ([
      "sword": 35,
    ]),
    "value": 1000,
    "time": "丁酉年三月八日辰时二刻",
    "name": "风回雪舞剑",
    "or": "海底金母",
    "id": "jian",
  ]));

  set("env/brief_message", 1);
  set("die_msg", "$N惨叫一声，化作一道妖光急飞遁去。\n" NOR);
  set("kill_msg", CYN "$N" CYN "说道：无量寿佛，贫道送你去极乐！\n" NOR);
  set("fabao_time", 4 + random(3));
  setup();
  carry_object("/d/emei/huanbochi/obj/bonnet")->wear();
  carry_object("/d/emei/huanbochi/obj/heidaopao")->wear();
  carry_object("/d/obj/drug/jinchuang")->set_amount(500);
  carry_object("/d/obj/drug/hunyuandan")->set_amount(500);
  add_temp("apply/armor", 80);
  add_temp("apply/damage", 55);
}

int copy_data(object who) {
  if (!who)
    return 0;
  if (!::copy_data(who))
    return 0;
  set("force_factor", 0);
  return 1;
}

void super_attack(object who) {
  if (!who)
    return;
  if (!query_temp("weapon")) {
    command("huhuan");
    command("bianhua sword");
  }
}

int reward_ob(object who) {
  int shen;
  object obj;
  if (who && userp(who)) {
    message_vision("\n$N惨叫一声，化作一道妖光急飞遁去。\n\n", this_object());
    who->add_temp("huanbochi/moon_kill", 1);
    tell_object(who, HIY "你击退了一名月宫孽徒。\n" NOR);
    tell_object(
      who,
      HIY "你目前已击退了" + chinese_number(who->query_temp("huanbochi/moon_kill")) + "名月宫孽徒。\n" NOR
    );
    if (who->query_temp("huanbochi/moon_kill") >= 5) {
      who->delete_temp("huanbochi/moon_kill");
      if (who->query("huanbochi/yijing")
        && who->query("huanbochi/liyingqiong")) {
        if (random(20) > 4) {
          if (random(50) == 48)
            obj = new("/d/wizz/fangz/lianhua/hebing");
          else if (random(100) == 48)
            obj = new("/d/wizz/fangz/lianhua/hebingl");
          else if (random(50) == 48)
            obj = new("/d/wizz/fangz/lianhua/lhshengji");
          else if (random(80) == 48)
            obj = new("/d/wizz/fangz/lianhua/lhshengjim");
          else if (random(100) == 48)
            obj = new("/d/wizz/fangz/lianhua/lhshengjil");
          else obj = new("/d/wizz/fangz/lianhua/hebing-fake");
          if (obj->move(who)) {
            tell_object(who, HIY "你得到了" + obj->query("name") + HIY "。\n" NOR);
            message(
              "channel:chat",
              HIG "【幻波池】西王母(Xi wangmu)：" HIW + who->query("name") + HIG "助我剿灭孽徒，得奖励" + obj->query("name") + HIG "一颗。\n" NOR,
              users()
            );
          } else destruct(obj);
        } else {
          shen = 0;
          if (random(100) == 48)
            shen = 5;
          else if (random(80) == 48)
            shen = 3;
          else if (random(50) == 48)
            shen = 1;
          if (shen > 0) {
            who->add("shen", shen);
            tell_object(who, HIY "你得到了" + shen + "点神数。\n" NOR);
            message(
              "channel:chat",
              HIG "【幻波池】西王母(Xi wangmu)：" HIW + who->query("name") + HIG "助我剿灭孽徒，得奖励" + shen + HIG "点神数。\n" NOR,
              users()
            );
          } else {
            who->add("daoxing", 500);
            tell_object(who, HIY "你得到了半年道行\n" NOR);
          }
        }
      }
    }
    environment()->add("num", -1);
  }
  destruct(this_object());
  return 1;
}
