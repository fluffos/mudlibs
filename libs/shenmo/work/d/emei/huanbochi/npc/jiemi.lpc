//quest
#include <ansi.h>
inherit __DIR__"npc.lpc";

void create()
{
        set_name("落魄书生",({"shu sheng",}));
        set("noboss",1);
        set("long","一位进京赶考的书生，因失足葬身此处，鬼魂在此徘徊。\n");
        set("gender", "男性");
        set("age",20+random(20));
        set_skill("literate", 300);
        set("per", 20+random(5));
        set("str", 10);
        set("spi",10);
        set("max_kee", 1000);
        set("max_sen", 1000);
        setup();
        carry_object("/d/gao/obj/changpao")->wear();
}
                
        
