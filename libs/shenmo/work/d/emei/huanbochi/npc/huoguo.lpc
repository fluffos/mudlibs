inherit __DIR__ "beast.lpc";

void create_beast() {
  set_name("多即", ({ "duo ji", "ji", "dog", }));
  set("age", 300);
  set("gender", "中性");
  set("long", "一只似狼又似狗的怪兽，红嘴红眼白尾。据说常出没在火灾之地。\n");
  set("level", 80);
  set("skill_level", 210);
  set("type", "bear");
}

void init() {
  ::init();
  add_action("do_go", "go");
}

int do_go(string arg) {
  if (!arg || !userp(this_player()))
    return 0;
  if (base_name(environment()) != "/d/emei/huanbochi/huo4")
    return 0;
  tell_object(this_player(), query("name") + "阻住了你的去路。\n");
  return 1;
}
