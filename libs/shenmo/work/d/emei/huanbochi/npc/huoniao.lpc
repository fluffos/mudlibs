inherit __DIR__ "beast.lpc";

void create_beast() {
  set_name("九婴鸟", ({ "jiuying niao", "jiuying", "niao", "bird", }));
  set("age", 300);
  set("gender", "中性");
  set("long", "洪荒时期的水火之怪九婴的后裔。\n");
  set("level", 60);
  set("skill_level", 150);
  set("limbs", ({
    "头部", "颈部", "胸口", "后心", "尾巴", "翅膀", "眼睛",
  }));
  set("type", "bird");
}

void init() {
  ::init();
  add_action("do_go", "go");
}

int do_go(string arg) {
  if (!arg || !userp(this_player()))
    return 0;
  if (base_name(environment()) != "/d/emei/huanbochi/huo3")
    return 0;
  tell_object(this_player(), query("name") + "阻住了你的去路。\n");
  return 1;
}
