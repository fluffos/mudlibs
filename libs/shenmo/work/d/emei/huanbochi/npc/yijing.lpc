//550skills
#include <ansi.h>
inherit __DIR__ "npc.lpc";

void create() {
  set_name("易静", ({ "yi jing", "yi", "jing", }));
  set("long", "看去举动虽然老到，身材却极矮小，颇似七八岁的幼女，相貌
也极清秀。穿着一身青色衣服，腰系紫绦，提着一个长约七八
寸的紫荷包，背插一口尺多长的短剑。一双星眼，威光显露，
迥非寻常新进可比。\n");
  set("gender", "女性");
  set("age", 20);
  create_family("峨嵋派", 3, "弟子");
  set("class", "human");
  set("nickname", HIY "女神婴" NOR);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("combat_exp", 20000000);
  set("daoxing", 30000000);
  set("rank_info/respect", "仙姑");
  set("rank_info/rude", "臭道姑");
  set("rank_info/self", "本姑娘");
  set("rank_info/self_rude", "仙姑我");
  set("per", 30);
  set("str", 250);
  set("spi", 550);
  set("max_kee", 100000);
  set("max_sen", 100000);
  set("force", 16500);
  set("max_force", 8250);
  set("force_factor", 300);
  set("max_mana", 8250);
  set("mana", 17000);
  set("mana_factor", 300);
  set("level", 200);
  set_skill("unarmed", 550);
  set_skill("literate", 550);
  set_skill("dodge", 550);
  set_skill("force", 550);
  set_skill("parry", 550);
  set_skill("sword", 550);
  set_skill("spells", 550);
  set_skill("tianji-sword", 550);
  set_skill("emeiforce", 550);
  set_skill("zhutian-bu", 550);
  set_skill("mahayana", 550);
  set_skill("jinding-zhang", 550);

  map_skill("dodge", "zhutian-bu");
  map_skill("sword", "tianji-sword");
  map_skill("parry", "tianji-sword");
  map_skill("spells", "mahayana");
  map_skill("force", "emeiforce");
  map_skill("unarmed", "jinding-zhang");

  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed", "bashi" :),
    (: perform_action, "sword", "tianji" :),
    (: cast_spell, "haotian" :),
    (: exert_function, "youming" :),
  }));
  set_temp("apply/armor", 150);
  set_temp("apply/damage", 120);
  set("env/brief_message", 1);
  set("kill_msg", CYN "$N" CYN "说道：今天本姑娘就为了天下人除了你这个妖孽！\n" NOR);
  set("remove_weapon", "sword");
  setup();
  carry_object("/d/city/npc/obj/armor")->wear();
  carry_object("/d/emei/huanbochi/obj/zihe-bag")->wear();
  carry_object("/d/emei/huanbochi/obj/anan-jian")->wield();
  carry_object("/d/emei/huanbochi/obj/doulv-jinsan")->wear();
  carry_object("/d/emei/huanbochi/obj/zitao-dai")->wear();
  carry_object("/d/emei/huanbochi/obj/qingdaopao")->wear();
  carry_object("/d/emei/huanbochi/obj/jinputi-nianzhu")->wear();
  carry_object("/d/emei/huanbochi/obj/liuyang-jian");
  carry_object("/d/emei/huanbochi/obj/mouni-wan");
  carry_object("/d/emei/huanbochi/obj/baimei-zhen");
  carry_object("/d/emei/huanbochi/obj/miemo-yuenu");
  carry_object("/d/emei/huanbochi/obj/ziting-zhu");
  carry_object("/d/obj/drug/jinchuang")->set_amount(100);
  carry_object("/d/obj/drug/hunyuandan")->set_amount(100);
  set_living_name("易静");
}

void super_attack(object who) {
  if (!who || !this_object()->is_fighting(who))
    return;
  if (present("baimei zhen", this_object())
    && present("jinputi nianzhu", this_object()))
    command("install baimei zhen");
  if (present("ziting zhu", this_object())
    && present("miemo tanyue nu", this_object()))
    command("install ziting zhu");
  if (present("miemo tanyue nu", this_object()))
    command("ji miemo tanyue nu on " + who->query("id"));
  if (present("mouni sanguang wan", this_object()))
    command("ji mouni sanguang wan on " + who->query("id"));
  if (present("liuyang shenhuo jian", this_object()))
    command("ji liuyang shenhuo jian on " + who->query("id"));
  if (present("jinputi nianzhu", this_object()))
    command("ji jinputi nianzhu on " + who->query("id"));
}

void dest_ob(object ob) {
  remove_call_out("dest_ob");
  if (ob) destruct(ob);
}

int reward_ob(object who) {
  object zhou;
  if (query_temp("quest_npc"))
    return 0;
  if (!who || !present(who, environment())) {
    message_vision("$N紧咬银牙，将身要纵，化作一道青光冲天而去！\n", this_object());
    this_object()->move("/d/emei/huanbochi/empty");
    call_out("dest_ob", 1, this_object());
    return 0;
  }
  if (query_temp("my_killer") && who != query_temp("my_killer")) {
    message_vision("$N紧咬银牙，将身要纵，化作一道青光冲天而去！\n", this_object());
    this_object()->move("/d/emei/huanbochi/empty");
    call_out("dest_ob", 1, this_object());
    return 0;
  }
  zhou = present("zhou qing yun", environment());
  who->set("huanbochi/yijing", 1);
  set_temp("quest_npc", 1);
  powerup();
#ifdef SDS_D
  SDS_D->powerup(this_object());
#endif
  message_vision(CYN "\n$N" CYN "注视着$n" CYN "的行动，企图寻找机会出手。\n" NOR, who, this_object());
  if (zhou) {
    message_vision(CYN "「BEEP！」，$N" CYN "好像要找$n" CYN "．．．\n" NOR, zhou, this_object());
    message_vision(CYN "$n" CYN "对着$N" CYN "惊讶地“啊”了一声。\n" NOR, zhou, this_object());
    message_vision(CYN "$n" CYN "高兴地一下子跳到了$N" CYN "的怀里，搂住了$P的脖子。\n" NOR, zhou, this_object());
  } else {
    message_vision(CYN "$N" CYN "很疑惑地看着$n" CYN "。\n" NOR, who, this_object());
    message_vision(CYN "$N" CYN "「嗯」的一声，一副欲言又止的样子。\n" NOR, this_object());
    message_vision(CYN "$N" CYN "一脸的迷茫，不知道周围发生了什么事。\n" NOR, this_object());
  }
  message_vision(CYN "$N" CYN "说道：我以为妹妹已遭不测。\n" NOR, this_object());
  message_vision(CYN "$N" CYN "很不好意思地向$n" CYN "行礼致歉。\n" NOR, this_object(), who);
  message_vision(
    CYN "$N" CYN "双手抱拳，对$n" CYN "作了个揖道：这位" + RANK_D->query_respect(who) + "请了！\n" NOR,
    this_object(),
    who
  );
  message_vision(CYN "$N" CYN "说道：除魔卫道乃我峨眉责无旁贷的责任，看来这位道友也是同道中人。\n" NOR, this_object());
  set("owner", who);
  set_leader(who);
  message_vision(CYN "$N" CYN "说道：本姑娘便和你一同查看此处的奥秘吧。\n" NOR, this_object());
  tell_object(who, name() + "决定开始跟随你一起行动。\n");
  who->add_team_member(this_object());
  tell_object(who, WHT "【队伍】" + this_object()->query("name") + WHT "加入队伍。\n" NOR);
  return 1;
}
