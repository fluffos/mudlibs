#include <ansi.h>
inherit __DIR__ "npc.lpc";

void create() {
  set_name("卫仙客", ({ "wei xianke", "wei" }));
  set("title", "昆仑散仙");
  set("long", "西昆仑的一位散修，须髯如戟，遍身虬筋裸露，长得奇丑非常。\n");
  set("gender", "男性");
  set("age", 36);
  set("per", 10);
  set("attitude", "friendly");
  set("max_kee", 5000);
  set("eff_kee", 3000);
  set("kee", 3000);
  set("max_sen", 5000);
  set("max_sen", 5000);
  set("eff_sen", 3000);
  set("sen", 3000);
  set("mana_factor", 500);
  set("combat_exp", 300000);
  set("class", "human");
  set("max_force", 3400);
  set("force", 7200);
  set_skill("force", 180);
  set_skill("spells", 180);
  set_skill("zhenyuan-force", 180);
  set_skill("taiyi", 180);
  map_skill("force", "zhenyuan-force");
  map_skill("spells", "taiyi");
  setup();
  carry_object("/d/obj/drug/jinchuang")->set_amount(50);
}

void heart_beat() {
  if (query("eff_kee") < query("max_kee") && present("jinchuang yao")) {
    command("eat yao");
    command("eat yao");
  }
  if (query("eff_sen") < query("max_sen") && present("hunhuan dan")) {
    command("eat dan");
    command("eat dan");
  }
  if (query("kee") < query("eff_kee") && query("force") > 100)
    command("exert recover");
  if (query("sen") < query("eff_sen") && query("force") > 100)
    command("exert refresh");
  ::heart_beat();
}
