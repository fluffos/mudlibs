inherit __DIR__"beast.lpc";

void create_beast()
{
        string name;
        mapping Name = ([
                "眼镜蛇" : ({"yanjing she","she"}),      
                "竹叶青" : ({"zhuye qing","she",}),
                "响尾蛇" : ({"xiangwei she","she"}),
                "蝮蛇"   : ({"fu she","she"}),
                "五步倒" : ({"wubu dao","she"}),
        ]);     
        name = keys(Name)[random(sizeof(keys(Name)))];
        set_name(name,Name[name]);
        set("age",50);
        set("gender","中性");
        set("long","一条毒性无比的长虫，吃吃吐着信子。\n");
        set("level",10);
        set("unit","条");
        set("skill_level",100);
        set("limbs",({
                "头部", "颈部", "胸口", "后心","尾巴",
        }));
        set("type","snake");    
        set("die_msg","$N惨叫一声，身子缩成了一团。\n");
}

void setup()
{
        int t;
        ::setup();
        if( random(3) )
        {
                set("reward/obj",([
                        "file" : "/d/quest/occupation/medical/obj/shedan",
                        "num"  : 1+random(2),
                ]));
        }               
        if( random(3) )
                return;
        switch(random(5))
        {
                case 0 : 
                case 4 : t = 150+random(1000);set("reward/dx",t);break;
                case 1 : t = 200+random(300);set("reward/pot",t);break; 
                case 3 : t = 1;set("reward/shen",t);break;
                default : return;
        }
        return;
}
        
