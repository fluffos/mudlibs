//B2 500skills
#include <ansi.h>
inherit __DIR__ "npc.lpc";

void create() {
  set_name("铁姝", ({ "tie zhu", "tie", "zhu", }));
  set("long", "身围树叶，手持一钩一剑，披发赤足，裸臂露侞，面容死白，
碧瞳若电，周身烟笼雾约，神态服饰无不诡异的长身少女。\n");
  set("long2", "上身披着一件鸟羽和树叶合织成的云肩，色作翠绿，俱不知
名，碧辉闪闪，色甚鲜明。胸臂半露，仅将双侞虚掩。下半身也只是一件短裙，齐腰
围系，略遮前陰后婰。余者完全裸露，柔肌粉腻，掩映生辉，仿佛艳绝。只有满脸狞
厉之容，凶眉倒竖，碧瞳炯炯，威光四射，隐现无限杀气。左肩上钉着九柄血焰叉，
右额钉着五把三寸来长的金刀，俱都深嵌玉肌之内，仿佛天然生就，通没一点痕迹。
满头秀发已经披散，发尖上打了许多环结。前后胸各挂着一面三角形的晶镜。左腰插
着两面令牌。右腰悬着一个人皮口袋，其形也和人头一般无二。右手臂上还挂着三个
拳大骷髅，俱是红睛绿发，白骨晶晶，形象狞厉已极。通体黑烟围绕，若沉若浮，凌
虚而立。\n");
  set("gender", "女性");
  set("age", 22);
  create_family("阎罗地府", 1, "你好");
  set("title", "赤身教主 魔女");
  set("class", "xian");
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("combat_exp", 12500000);
  set("daoxing", 15000000);
  set("rank_info/respect", "圣女");
  set("rank_info/rude", "妖女");
  set("rank_info/self", "本姑娘");
  set("rank_info/self_rude", "老娘我");
  set("per", 30);
  set("str", 200);
  set("spi", 550);
  set("max_kee", 80000);
  set("max_sen", 80000);
  set("force", 15000);
  set("max_force", 7500);
  set("force_factor", 300);
  set("max_mana", 8000);
  set("mana", 16000);
  set("mana_factor", 300);

  set("level", 160);
  set_skill("unarmed", 500);
  set_skill("cuixin-zhang", 500);
  set_skill("dodge", 500);
  set_skill("xiaoyaoyou", 500);
  set_skill("parry", 500);
  set_skill("sword", 500);
  set_skill("bainiao-jian", 500);
  set_skill("blade", 500);
  set_skill("bingpo-blade", 500);
  set_skill("throwing", 500);
  set_skill("force", 500);
  set_skill("ningxie-force", 500);
  set_skill("literate", 500);
  set_skill("spells", 500);
  set_skill("dengxian-dafa", 500);
  map_skill("spells", "dengxian-dafa");
  map_skill("force", "ningxie-force");
  map_skill("unarmed", "cuixin-zhang");
  map_skill("sword", "bainiao-jian");
  map_skill("blade", "bingpo-blade");
  map_skill("dodge", "xiaoyaoyou");
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "sword", "chaofeng" :),
    (: perform_action, "sword", "zheng" :),
    (: cast_spell, "hufa" :),
    (: cast_spell, "bingfeng" :),
    (: cast_spell, "niepan" :),
  }));
  set_temp("apply/armor", 100);
  set_temp("apply/damage", 120);
  set("env/brief_message", 1);
  setup();
  carry_object("/d/emei/huanbochi/obj/mimo-zhuang")->wear();
  carry_object("/d/city/npc/obj/sword")->wield();
  carry_object("/d/emei/huanbochi/obj/renpi-bag");
  carry_object("/d/emei/huanbochi/obj/huoyan-cha");
  carry_object("/d/emei/huanbochi/obj/9zimo-pai");
  carry_object("/d/city/npc/obj/armor")->wear();
  carry_object("/obj/money/gold")->set_amount(1 + random(3));
  carry_object("/d/obj/drug/jinchuang")->set_amount(500);
  carry_object("/d/obj/drug/hunyuandan")->set_amount(500);
}

void super_attack(object who) {
  remove_call_out("do_fabao");
  if (!who || !this_object()->is_fighting(who))
    return;
  if (!query_temp("weapon"))
    command("wield all");
  if (present("jiuzimo pai", this_object()))
    command("ji jiuzimo pai on " + who->query("id"));
  if (present("renpi koudai", this_object()))
    command("ji renpi koudai on " + who->query("id"));
  if (present("huoyan cha", this_object()))
    command("ji huoyan cha on " + who->query("id"));
  call_out("do_fabao", 5 + random(2), who);
}


void init() {
  if (!query("start_time"))
    set("start_time", time());
  ::init();
  add_action("do_go", "go");
}

int do_go(string arg) {
  write(query("name") + "阻住了你的去路。\n");
  return 1;
}

void kill_ob(object who) {
  if (!who)
    return;
  if (!userp(who) || who != query_temp("my_killer")) {
    message_vision(CYN "$N" CYN "说道：单打独斗，你旁边去。\n" NOR, this_object());
    message_vision("$N退在一旁。\n", who);
    this_object()->remove_killer(who);
    who->remove_killer(this_object());
    return;
  }
  if (!is_fighting(who) && is_fighting()) {
    message_vision(CYN "$N" CYN "说道：单打独斗，你旁边去。\n" NOR, this_object());
    message_vision("$N退在一旁。\n", who);
    this_object()->remove_killer(who);
    who->remove_killer(this_object());
    return;
  }
  ::kill_ob(who);
}

int reward_ob(object who) {
  if (!who || !userp(who)) {
    powerup();
#ifdef SDS_D
    SDS_D->powerup(this_object(), 1);
#endif
    return 1;
  }

  //第一次打败
  if (!query("died")) {
    message_vision("
铁姝将手中剑钩一摆跳出圈外，银牙紧咬，眉目腾起千万煞气，将身一摇，
立时愁云密布将身心掩住，只见乌云中现出一具曼妙身形。
一声厉啸，铁姝从密云中杀出，只见她已换了份装束：
上身披着一件鸟羽和树叶合织成的云肩，色作翠绿，俱不知名，碧辉闪闪，
色甚鲜明。胸臂半露，仅将双侞虚掩。下半身也只是一件短裙，齐腰围系，
略遮前陰后婰。余者完全裸露，柔肌粉腻，掩映生辉，仿佛艳绝。只有满脸
狞厉之容，凶眉倒竖，碧瞳炯炯，威光四射，隐现无限杀气。左肩上钉着九
柄血焰叉，右额钉着五把三寸来长的金刀，俱都深嵌玉肌之内，仿佛天然生
就，通没一点痕迹。满头秀发已经披散，发尖上打了许多环结。前后胸各挂
着一面三角形的晶镜。左腰插着两面令牌。右腰悬着一个人皮口袋，其形也
和人头一般无二。右手臂上还挂着三个拳大骷髅，俱是红睛绿发，白骨晶晶，
形象狞厉已极。通体黑烟围绕，若沉若浮，凌虚而立。\n\n", this_object());
    set("died", 1);
    powerup();
#ifdef SDS_D
    SDS_D->powerup(this_object(), 1);
#endif
    add("force", query("max_force") / 10);
    add("mana", query("max_mana") / 10);
    add_temp("apply/armor", 100);
    add_temp("apply/damage", 120);
    set("long", query("long2"));
    kill_ob(who);
    return 1;
  }

  else {
    message_vision(YEL "\n$N" YEL "惨叫一声，化作一道乌云席卷而去！\n\n" NOR, this_object());
    if (!who->query("huanbochi/tiezhu")) {
      who->set("huanbochi/tiezhu", 1);
      who->add("shen", 45);
      who->add("daoxing", 50000);
      tell_object(who, HIY "你得到了五十年道行以及四十五点神数。\n" NOR);
    }
    who->set_temp("huanbochi/tiezhu", 1);
    destruct(this_object());
    return 1;
  }
}
