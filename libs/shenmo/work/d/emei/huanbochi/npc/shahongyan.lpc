#include <ansi.h>
inherit __DIR__ "npc.lpc";

void create() {
  set_name("沙红燕", ({ "sha hongyan", "sha", "yan", }));
  set("long", "兀南公的女弟子，乃是兀南公的转世爱妾。相貌虽美，却一脸
青气，细看又非妖邪一流。\n");
  set("gender", "女性");
  set("age", 36);
  create_family("盘丝洞", 1, "红");
  set("title", HIC "紫清玉女" NOR);
  set("class", "yao");
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("combat_exp", 9112500);
  set("daoxing", 9512500);
  set("rank_info/respect", "仙姑");
  set("rank_info/rude", "妖女");
  set("rank_info/self", "姑娘我");
  set("rank_info/self_rude", "老娘");
  set("per", 30);
  set("str", 80);
  set("spi", 100);
  set("max_kee", 100000);
  set("max_sen", 120000);
  set("force", 13500);
  set("max_force", 6750);
  set("force_factor", 250);
  set("max_mana", 6750);
  set("mana", 13500);
  set("mana_factor", 200);

  set("level", 250);
  set_skill("literate", 450);
  set_skill("unarmed", 450);
  set_skill("dodge", 450);
  set_skill("force", 450);
  set_skill("parry", 150);
  set_skill("sword", 450);
  set_skill("spells", 450);
  set_skill("whip", 450);
  set_skill("pansi-dafa", 450);
  set_skill("lanhua-shou", 450);
  set_skill("jiuyin-xinjing", 450);
  set_skill("qingxia-jian", 450);
  set_skill("yueying-wubu", 450);
  set_skill("yinsuo-jinling", 450);
  map_skill("spells", "pansi-dafa");
  map_skill("unarmed", "lanhua-shou");
  map_skill("force", "jiuyin-xinjing");
  map_skill("sword", "qingxia-jian");
  map_skill("parry", "yinsuo-jinling");
  map_skill("dodge", "yueying-wubu");
  map_skill("whip", "yinsuo-jinling");

  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "whip", "tian" :),
    (: perform_action, "whip", "wang" :),
    (: perform_action, "whip", "wanling" :),
  }));
  set("env/brief_message", 1);
  set("weapon", ([
    "make": 1,
    "type": ([
      "whip": 35,
    ]),
    "value": 1000,
    "time": "丁酉年三月八日辰时二刻",
    "name": "绝情鞭",
    "or": "海底金母",
    "id": "bian",
  ]));
  set("fabao_time", 4 + random(3));
  set("job", ([
    "data": "shy",
    "shen": 15,
    "dx": 30000,
  ]));
  setup();
  carry_object("/d/emei/huanbochi/obj/skirt")->wear();
}

void super_attack(object who) {
  if (!who)
    return;
  if (!query_temp("weapon")) {
    command("huhuan");
    command("bianhua whip");
  }
}
