inherit __DIR__"beast.lpc";

void create_beast()
{
        string name;
        mapping Name = ([
                "山猫" : ({"shan mao","hu"}),    
                "斑子" : ({"ban zi","hu",}),
                "白额侯" : ({"baie hou","hu"}),
                "黄斑"   : ({"huan ban","hu"}),
                "花团畜生" : ({"hua tuan","hu"}),
        ]);     
        name = keys(Name)[random(sizeof(keys(Name)))];
        set_name(name,Name[name]);
        set("age",300);
        set("gender","中性");
        set("long","一头山林霸王，黄皮黑纹长尾，好不威风。\n");
        set("level",50);
        set("skill_level",250);
        set("type","tiger");    
        set("die_msg","$N惨叫一声，夹着尾巴逃跑了。\n");
}

void setup()
{
        int t;
        ::setup();
        if( random(3) )
        {
                set("reward/obj",([
                        "file" : "/d/quest/occupation/medical/obj/hugu",
                        "num"  : 1+random(2),
                ]));
        }               
        if( random(3) )
                return;
        switch(random(5))
        {
                case 0 : 
                case 4 : t = 200+random(1000);set("reward/dx",t);break;
                case 1 : t = 250+random(300);set("reward/pot",t);break; 
                case 3 : t = 1;set("reward/shen",t);break;
                default : return;
        }
        return;
}       
