//B2 450skills
#include <ansi.h>
inherit __DIR__"npc.lpc";

void create()
{
        set_name("萧宝娘", ({"xiao baoniang", "xiao","niang","baoniang"}));
        set("long","本是五滢尊者情妇。生性滢凶，恣情滢欲。生得骨瘦如柴，细
眼疏眉，小鼻小口，两颧高耸，面白如纸，周身仿佛笼上一层
淡烟，活像吊死鬼，故意媚声媚气说话，满脸陰险狡诈神情。\n");
        set("gender", "女性");
        set("age", 36);
        create_family("盘丝洞", 1, "红"); 
        set("title", HIM"五株神女"NOR);
        set("class","yao");
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("combat_exp", 9112500);
        set("daoxing", 9512500);
        set("rank_info/respect", "仙姑");
        set("rank_info/rude","妖女");
        set("rank_info/self","姑娘我");
        set("rank_info/self_rude","老娘");
        set("per", 10);
        set("str", 150);
        set("spi",100);
        set("max_kee", 100000);
        set("max_sen", 120000);
        set("force", 13500);
        set("max_force", 6750);
        set("force_factor", 250);
        set("max_mana", 6750);
        set("mana",13500);
        set("mana_factor", 200);
        
        set("level",150);
        set_skill("literate", 450);
        set_skill("unarmed", 450);
        set_skill("dodge", 450);
        set_skill("force", 450);
        set_skill("parry", 150);
        set_skill("sword", 450);
        set_skill("spells", 450);
        set_skill("whip", 450);
        set_skill("pansi-dafa", 450);
        set_skill("lanhua-shou", 450);
        set_skill("jiuyin-xinjing", 450);
        set_skill("qingxia-jian", 450);
        set_skill("yueying-wubu", 450);
        set_skill("yinsuo-jinling", 450);
        map_skill("spells", "pansi-dafa");
        map_skill("unarmed", "lanhua-shou");
        map_skill("force", "jiuyin-xinjing");
        map_skill("sword", "qingxia-jian");
        map_skill("parry", "yinsuo-jinling");
        map_skill("dodge", "yueying-wubu");
        map_skill("whip", "yinsuo-jinling");

        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
                (: perform_action, "whip", "tian" :),
                (: perform_action, "whip", "wang" :),
                (: perform_action, "whip", "wanling" :),
                (: perform_action, "unarmed", "juehu" :),
                }) );
        set_temp("apply/armor",80);
        set_temp("apply/damage",35);
        set("env/brief_message",1);
        set("die_msg",HIR"\n$N吓得亡魂失魄，哪里还敢再留，忙施邪法，在一片暗灰色妖光护身之下，急飞遁去。\n\n"NOR);
        set("job",([
                "data" : "xiaobaoniang",
                "shen" : 15,
                "dx"   : 4000,
        ]));    
        set("kill_msg",CYN"$N"CYN"说道：既然你求死，姑奶奶就成全你！\n"NOR);
        set("leave_msg",({
                "$N低声说道：能全身而退更好；否则自己一生便吃了又瘦又丑的亏，所有情人全靠邪法媚术强迫而来，从未得人颠倒，想起就气。\n",
                "$N低声说道：罢罢罢，且先回去，依靠了那夙世情孽，免了眼下火光之灾，再作打算。\n",
                "$N急急忙忙的带着妖光急飞遁去。\n",
        }));
        setup();
        carry_object("/d/emei/huanbochi/obj/skirt")->wear();
        carry_object("/d/city/npc/obj/whip")->wield();
        carry_object("/d/emei/huanbochi/obj/yinling-pai");
        carry_object("/d/emei/huanbochi/obj/miyang-zhen");
        carry_object("/d/emei/huanbochi/obj/sejiemozhen-fan");
        carry_object("/obj/money/gold")->set_amount(1+random(3));
        carry_object("/d/obj/drug/jinchuang")->set_amount(500);
        carry_object("/d/obj/drug/hunyuandan")->set_amount(500);
}

void super_attack(object who)
{
        if( !who || !this_object()->is_fighting(who) )
                return;
        if( !query_temp("weapon") )
                command("wield all");
        if( present("sejie zhenfan",this_object()) )
                command("ji sejie zhenfan");
        if( present("miyang zhen",this_object()) )
                command("ji miyang zhen on "+who->query("id"));         
        if( present("yinling pai",this_object()) )
                command("ji yinling pai on "+who->query("id"));         
}

