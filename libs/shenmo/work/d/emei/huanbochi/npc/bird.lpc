inherit __DIR__"beast.lpc";

void create_beast()
{
        string name;
        mapping Name = ([
                "山鹰" : ({"shan ying","niao","bird"}),   
                "大雕" : ({"da diao","niao","bird",}),
                "乌鸦" : ({"wu ya","niao","bird"}),
                "恶鹞"   : ({"e yao","niao","bird"}),
        ]);     
        name = keys(Name)[random(sizeof(keys(Name)))];
        set_name(name,Name[name]);
        set("age",300);
        set("gender","中性");
        set("long","一只扁毛畜生，钩嘴利爪。\n");
        set("level",50);
        set("skill_level",250);
        set("type","bird");     
        set("die_msg","$N惨叫一声，扑哧扑哧飞走了。\n");
}

void setup()
{
        int t;
        ::setup();
        if( random(3) )
                return;
        switch(random(5))
        {
                case 0 : 
                case 4 : t = 200+random(1000);set("reward/dx",t);break;
                case 1 : t = 250+random(300);set("reward/pot",t);break; 
                case 3 : t = 1;set("reward/shen",t);break;
                default : return;
        }
        return;
}       
