//B2 450skills
#include <ansi.h>
inherit __DIR__"npc.lpc";

void create()
{
        set_name("矮子飞", ({"aizi fei", "fei","aizi",}));
        set("long","生得豹头环眼，狮鼻虎口，大耳如轮，颜如朱染，相貌甚是威
猛，只是身材太矮，好似十二四岁幼童，头大身小，上下不称。\n");
        set("gender", "男性");
        set("age", 40);
        
        set("level", 300);
        set("class","yao");
        set("chat_chance_combat", 100);
        set("chat_msg_combat", ({
                (: perform_action, "spear", "buhui" :),
                (: perform_action, "unarmed", "zhangxinlei" :),
  }) );
 
        create_family("火云洞", 1, "蓝");
        set("title", HIR"黑面神"NOR);
        set("class","yao");
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("combat_exp", 9112500);
        set("daoxing", 9512500);
        set("per", 10);
        set("str", 150);
        set("spi",100);
        set("max_kee", 100000);
        set("max_sen", 120000);
        set("force", 13500);
        set("max_force", 6750);
        set("force_factor", 250);
        set("max_mana", 6750);
        set("mana",13500);
        set("mana_factor", 200);
        
        set_skill("spear", 350);
        set_skill("force", 350);
        set_skill("dodge", 350);
        set_skill("stick", 350);
        set_skill("literate", 350);
        set_skill("dali-bang", 350);
        set_skill("huoyun-qiang", 350);
        set_skill("parry", 350);
        set_skill("unarmed", 350);
        set_skill("wuyue-spear", 350);
        set_skill("spells", 350);
        set_skill("pingtian-dafa", 350);
        set_skill("moshenbu", 350);
        set_skill("huomoforce", 350);
        set_skill("moyun-shou", 350);
        map_skill("force", "huomoforce");
        map_skill("spells", "pingtian-dafa");
        map_skill("unarmed", "moyun-shou");
        map_skill("spear", "wuyue-spear");
        map_skill("parry", "wuyue-spear");
        map_skill("stick", "dali-bang");
        map_skill("dodge", "moshenbu");

        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
                (: perform_action, "spear", "buhui" :),
                (: perform_action, "spear", "fengshan" :),
                }) );
        set("env/brief_message",1);
        set("death_msg","$N惨叫一声，忍住伤痛，运起兀南公秘法化作一道赤光冲天而去！\n");
        set("weapon",([
                "make" : 1,
                "type" : ([ 
                        "spear" : 45,
                        "stick" : 30,
                        ]),
                "value" : 1000,
                "time" : "丁酉年三月八日辰时二刻",
                "name" : "黑枪",
                "or" : "海底金母",
                "id" : "qiang",
        ])); 
        set("fabao_time",4+random(3));
        set("job",([
                "data" : "azf",
                "shen" : 20,
                "dx"   : 35000,
        ]));
        setup();
        carry_object("/d/emei/huanbochi/obj/armor")->wear();
}

void super_attack(object who)
{
        if( !who )
                return;
        if( !query_temp("weapon") )
        {
                command("huhuan");
                command("bianhua stick");
                command("perform shenli");
                command("bianhua spear");
        }
}

int reward_ob(object who)
{
        object npc;
        if( !who || !living(who) || !environment() )
                return 0;
        if( who->query("huanbochi/azf") )
                return 0;
        message_vision("$N惨叫一声，忍住伤痛，运起兀南公秘法化作一道赤光冲天而去！\n",this_object());          
        who->set("huanbochi/azf",1);
        who->add("shen",(int)query("job/shen"));
        who->add("daoxing",(int)query("job/dx"));
        tell_object(who,HIY"你得到了"+chinese_number(query("job/shen"))+"点神数和"+COMBAT_D->chinese_daoxing(who->query("job/dx"))+"道行。\n"NOR);
        if( who->query("huanbochi/shy") )
        {
                destruct(this_object());
                return 1;
        }
        npc = present("sha hongyan",environment());
        if( npc && !userp(npc) && living(npc)
         && npc->query_temp("my_killer")==who )
        {
                npc->command("say 啊？！居然伤我师弟？！老娘跟你拼了！！\n");
                npc->kill_ob(who);
        }
        destruct(this_object());
        return 1;
}
