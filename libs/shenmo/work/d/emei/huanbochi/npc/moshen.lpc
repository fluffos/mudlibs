//600skills
#include <ansi.h>
inherit __DIR__ "npc.lpc";

void create() {
  set_name("摩什", ({ "mo shen", "moshen", "mo", }));
  set("long", "一位矮胖的道人，面相凶恶，杀气熏天。\n");
  set("gender", "男性");
  set("level", 300);
  set("class", "yao");
  set("age", 53);
  set("str", 245);
  set("per", 11);
  set("int", 30);
  set("cor", 50);
  set("cps", 40);
  set("combat_exp", 21600000);
  set("daoxing", 25000000);
  set_skill("force", 600);
  set_skill("wudu-xinfa", 600);
  set_skill("spells", 600);
  set_skill("xiuluo-yinshagong", 600);
  set_skill("sword", 600);
  set_skill("whip", 600);
  set_skill("ruanhong-zhusuo", 600);
  set_skill("unarmed", 600);
  set_skill("wudu-shenzhang", 600);
  set_skill("parry", 600);
  set_skill("literate", 600);
  set_skill("dodge", 600);
  set_skill("jinshe-steps", 600);
  map_skill("force", "wudu-xinfa");
  map_skill("spells", "xiuluo-yinshagong");
  map_skill("unarmed", "wudu-shenzhang");
  map_skill("whip", "ruanhong-zhusuo");
  map_skill("parry", "ruanhong-zhusuo");
  map_skill("dodge", "jinshe-steps");
  set("max_sen", 20000);
  set("max_kee", 20000);
  set("force", 20000);
  set("max_force", 10000);
  set("mana", 20000);
  set("max_mana", 10000);
  set("force_factor", 200);
  set("mana_factor", 300);
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed", "shi" :),
    (: perform_action, "unarmed", "huan" :),
    (: perform_action, "whip", "bohu" :),
    (: perform_action, "whip", "pan" :),
    (: perform_action, "whip", "suo" :),
    (: perform_action, "whip", "teng" :),
    (: exert_function, "huti" :),
    (: cast_spell, "huadu" :),
  }));
  set("weapon", ([
    "make": 1,
    "type": ([
      "whip": 35,
    ]),
    "value": 352,
    "time": "丁酉年三月八日辰时二刻",
    "name": "蝎尾鞭",
    "or": "海底金母",
    "id": "whip",
  ]));
  set("job", ([
    "data": "moshen",
    "shen": 50,
    "dx": 55000,
  ]));
  create_family("黄花观五毒门", 1, "蓝");
  set("title", RED "毒手" NOR);
  set("env/brief_message", 1);
  set("remove_weapon", "whip");
  set("fabao_time", 5);
  set("kill_msg", "$N大喝一声：本道爷这就叫你去见佛祖！\n");
  setup();
  carry_object("/d/city/npc/obj/armor")->wear();
  carry_object("/d/emei/huanbochi/obj/heidaopao")->wear();
  carry_object("/d/emei/huanbochi/obj/qisha-xuanyinmu")->wear();
  carry_object("/d/obj/drug/jinchuang")->set_amount(300);
  carry_object("/d/obj/drug/hunyuandan")->set_amount(300);
  add_temp("apply/armor", 150);
  add_temp("apply/damage", 120);
}

void super_attack(object who) {
  if (!who || !this_object()->is_fighting(who))
    return;
  if (!query_temp("weapon")) {
    if (command("huhuan"))
      command("bianhua whip");
  }
  if (present("qisha xuanyin mu", this_object()))
    command("ji qisha xuanyin mu on " + who->query("id"));
}
