#include <ansi.h>
inherit NPC;

void create_beast() {
  set_name("野兽", ({ "ye shou", "shou" }));
  set("age", 30);
  set("gender", "中性");
  set("long", "一只龇牙咧嘴的大怪兽。\n");
  set("level", 10);
  set("skill_level", 100);
}

void create() {
  create_beast();
  set("str", 55);
  set("per", 35);
  set("combat_exp", query("skill_level") * query("skill_level") / 10 * query("skill_level"));
  set("daoxing", query("combat_exp"));
  set("family/family_name", "大雪山");
  set("class", "yao");
  set("level", 15);
  set_skill("dodge", query("skill_level") * 2);
  set_skill("force", query("skill_level"));
  set_skill("parry", query("skill_level") * 2);
  set_skill("unarmed", query("skill_level"));
  set_skill("spells", query("skill_level"));
  set_skill("ningxie-force", query("skill_level"));
  set_skill("dengxian-dafa", query("skill_level"));
  set_skill("beast-hurt", query("skill_level"));
  map_skill("spells", "dengxian-dafa");
  map_skill("force", "ningxie-force");
  map_skill("unarmed", "beast-hurt");

  set("max_kee", 8000 + query("level") * 100);
  set("max_sen", 6000 + query("level") * 100);
  set("max_force", query("skill_level") * 30 / 2);
  set("max_mana", query("skill_level") * 30 / 2);
  set("force", query("max_force") * 2);
  set("force_factor", query("skill_level") / 10);
  set("mana", query("max_mana") * 2);
  set("mana_factor", 30);

  setup();
  add_temp("apply/damage", 150);
  add_temp("apply/armor", 250);
}

int is_pet() { return 1; }

void kill_ob(object who) {
  if (!who || !environment())
    return;

  if (!environment()->is_huanbo()) {
    tell_object(who, query("name") + "吼道：咦，这里不是幻波池？\n");
    message_vision("$N急急忙忙的离开了。\n", this_object());
    remove_all_killer();
    all_inventory(environment())->remove_killer(this_object());
    destruct(this_object());
    return;
  }
  if (!query_temp("getdd/zhenshens"))
    command("zhenshens changeup");
  if (who->query("env/invisibility"))
    set("env/invisibility", 1);
  else set("env/invisibility", 0);
  set_temp("my_killer", who);
  ::kill_ob(who);
}

int reward_ob(object who) {
  object obj;
  string tmp, *msg;
  int t, i;
  mapping reward, temp;
  if (!who || !environment()
    || !present(who, environment())
    || !environment()->is_huanbo())
    return 0;
  reward = query("reward");
  if (!reward || !mapp(reward))
    return 0;
  temp = ([
    "wx": ({ "combat_exp", "武学经验", 1 }),
    "dx": ({ "daoxing", "道行", 2 }),
    "pot": ({ "potential", "潜能", 1 }),
    "shen": ({ "shen", "神数", 1 }),
  ]);
  msg = keys(temp);
  for (i = 0; i < sizeof(msg); i++) {
    tmp = msg[i];
    if (!undefinedp(reward[tmp])) {
      t = (int)reward[tmp];
      if (t > 0) {
        who->add(temp[tmp][0], t);
        if (temp[tmp][2] == 1)
          tell_object(who, "你得到了" + chinese_number(t) + "点" + temp[tmp][1] + "。\n");
        else tell_object(who, "你得到了" + COMBAT_D->chinese_daoxing(t) + temp[tmp][1] + "。\n");
      }
    }
  }
  if (!undefinedp(reward["obj"])) {
    temp = reward["obj"];
    if (temp && mapp(temp)) {
      tmp = temp["file"];
      t = temp["num"];
      if (tmp) {
        obj = new(tmp);
        if (t > 1 && obj)
          obj->set_amount(t);
        if (obj) {
          if (obj->move(who))
            tell_object(who, HIY "你得到了" + obj->query("name") + "。\n" NOR);
          else destruct(obj);
        }
      }
    }
  }
  destruct(this_object());
  return 1;
}

void unconcious() {
  die();
}

void init() {
  if (!query("start_time"))
    set("start_time", time());
  ::init();
}

void heart_beat() {
  if (query("start_time")
    && time() > query("start_time") + 120
    && !this_object()->is_fighting()
    && environment()) {
    message_vision("$N急急忙忙的离开了。\n", this_object());
    destruct(this_object());
    return;
  }
  ::heart_beat();
}
