inherit __DIR__ "beast.lpc";

void create_beast() {
  set_name("火光兽", ({ "huoguang shou", "huo shu", "shu", "beast", }));
  set("age", 100);
  set("gender", "中性");
  set("long", "生活在烈火中一种灵兽，体形甚大，重百斤，毛长接近一米，细如丝，见水即死。俗称火鼠。\n");
  set("level", 60);
  set("skill_level", 150);
  set("limbs", ({
    "头部", "颈部", "胸口", "后心", "尾巴", "爪子", "眼睛",
  }));
  set("type", "rat");
}


void init() {
  ::init();
  add_action("do_go", "go");
}

int do_go(string arg) {
  if (!arg || !userp(this_player()))
    return 0;
  if (base_name(environment()) != "/d/emei/huanbochi/huo2")
    return 0;
  tell_object(this_player(), query("name") + "阻住了你的去路。\n");
  return 1;
}
