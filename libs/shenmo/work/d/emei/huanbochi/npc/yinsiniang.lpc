//B1 400skills
#include <ansi.h>
inherit __DIR__"npc.lpc";

void create()
{
        set_name("阴四娘", ({"yin si niang","yin","niang"}));
        set("long","披发赤身，一丝未挂，身白如玉，粉腻若酥，生相妖艳已极。\n");
        set("gender", "女性");
        set("age", 26);
        create_family("盘丝洞", 1, "红"); 

        set("title", "鸠盘婆孽徒");
        set("class","xian");
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("combat_exp", 6400000);
        set("daoxing", 8000000);
        set("rank_info/respect", "美娇娘");
        set("rank_info/rude","淫娃");
        set("rank_info/self","美人我");
        set("rank_info/self_rude","老娘");
        set("per", 30);
        set("str", 100);
        set("spi",300);
        set("max_kee", 100000);
        set("max_sen", 80000);
        set("force", 12000);
        set("max_force", 6000);
        set("force_factor", 250);
        set("max_mana", 5000);
        set("mana",10000);
        set("mana_factor", 200);

        set("level",100);
        set_skill("literate",400);
        set_skill("unarmed",400);
        set_skill("dodge",400);
        set_skill("force",400);
        set_skill("parry", 150);
        set_skill("sword",400);
        set_skill("spells",400);
        set_skill("whip",400);
        set_skill("pansi-dafa",400);
        set_skill("lanhua-shou",400);
        set_skill("jiuyin-xinjing",400);
        set_skill("qingxia-jian",400);
        set_skill("yueying-wubu",400);
        set_skill("yinsuo-jinling",400);
        map_skill("spells", "pansi-dafa");
        map_skill("unarmed", "lanhua-shou");
        map_skill("force", "jiuyin-xinjing");
        map_skill("sword", "qingxia-jian");
        map_skill("parry", "yinsuo-jinling");
        map_skill("dodge", "yueying-wubu");
        map_skill("whip", "yinsuo-jinling");

        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
                (: perform_action, "whip", "tian" :),
                (: perform_action, "whip", "wang" :),
                (: perform_action, "whip", "wanling" :),
                (: perform_action, "unarmed", "juehu" :),
        }) );
        set("env/brief_message",1);
        set("die_msg",HIB"\n$N"HIB"将身一摇，化作一道妖光急飞遁去。\n\n"NOR);
        set("kill_msg",CYN"$N"CYN"说道：老娘要你的命！\n"NOR);
        set("leave_msg",({
                "$N嘻嘻一笑：那汉子还在洞府等我回去快活。\n",
                "$N将身一裹，驾起一道妖风急急忙忙遁去。\n",
        }));    
        set("job",([
                "data" : "yinsiniang",
                "shen" : 15,
                "dx"   : 50000,
        ]));
        set("remove_weapon","whip");
        set("fabao_time",4);    
        setup();
        carry_object("/d/city/npc/obj/whip")->wield();
        carry_object("/d/emei/huanbochi/obj/taohua-zhang");
        carry_object("/d/obj/drug/jinchuang")->set_amount(500);
        carry_object("/d/obj/drug/hunyuandan")->set_amount(500);
        add_temp("apply/armor",180);
        set_living_name("阴四娘");      
}

void super_attack(object who)
{
        if( who && present("wuyun taohua zhang",this_object()) )
                command("ji wuyun taohua zhang"); 
}               
