  setup();
  carry_object("/d/city/npc/obj/armor")->wear();
  carry_object("/d/obj/drug/jinchuang")->set_amount(500);
  carry_object("/d/obj/drug/hunyuandan")->set_amount(500);
}

void super_attack(object who) {
  int ap, dp;
  if (!who || !this_object()->is_fighting(who))
    return;
  if (!query_temp("weapon")) {
    if (command("huhuan"))
      command("bianhua sword");
  }
  if (time() > query("last_ji") + 8) {
    set("last_ji", time());
    message_vision(RED "
$N" RED "把手一指，那右方垂的半片帘幔，立化一大片血赤色的火焰，火网一
般电驰飞堕，罩向$n" RED "！\n" NOR, this_object(), who);
    ap = query("mana") / 100;
    dp = who->query("mana") / 100;
    if (random(100) > dp / (ap + dp) * 110) {
      message_vision(RED "$N" RED "闪避不及，给罩了个正着！\n" NOR, who);
      who->start_busy(random(2) + (int)who->query_busy());
    } else message_vision(HIC "$N" HIC "眼明手快，闪在了一旁。\n" NOR, who);
  }
}

void kill_ob(object who) {
  if (!who)
    return;
  if (!who->query_temp("huanbochi/yaoshi1")) {
    message_vision(CYN "$N" CYN "说道：你是谁？我不认识你。\n" NOR, this_object());
    tell_object(who, query("name") + "不想和你打。\n");
    this_object()->remove_killer(who);
    who->remove_killer(this_object());
    return;
  }
  if (!userp(who) || who != query_temp("my_killer")) {
    message_vision(CYN "$N" CYN "说道：单打独斗，你旁边去。\n" NOR, this_object());
    message_vision("$N退在一旁。\n", who);
    this_object()->remove_killer(who);
    who->remove_killer(this_object());
    return;
  }
  if (!is_fighting(who) && is_fighting()) {
    message_vision(CYN "$N" CYN "说道：单打独斗，你旁边去。\n" NOR, this_object());
    message_vision("$N退在一旁。\n", who);
    this_object()->remove_killer(who);
    who->remove_killer(this_object());
    return;
  }
  ::kill_ob(who);
}

int reward_ob(object who) {
  object zhou, yi, li;
  if (!who || !userp(who)) {
    powerup();
#ifdef SDS_D
    SDS_D->powerup(this_object(), 1);
#endif
    return 1;
  }
  zhou = who->query_temp("huanbo/zhouqingyun");
  if (zhou && present(zhou, environment()))
    message_vision(HIC "\n$N" HIC "化作一道青光冲入圈内。\n" NOR "$N口中念念有词。" HIC "
只见$N" HIC "将手中青索剑迎风一摆，娇斥一声“疾”，只见一道苍龙从$n" HIC "妖身穿体而过！\n" NOR, zhou, this_object());
  li = who->query_temp("huanbo/lyq");
  if (li && present(li, environment()))
    message_vision(HIC "\n$N" HIC "化作一道青光冲入圈内。\n" NOR "$N口中念念有词。" NOR MAG "
只见$N" NOR MAG "将手中紫郢剑迎风一摆，娇斥一声“疾”，只见一道紫雷平空而降，正击在$n" NOR MAG "妖身之上！\n" NOR, li, this_object());
  yi = who->query_temp("huanbo/yj");
  if (yi && present(yi, environment()))
    message_vision(HIC "\n$N" HIC "化作一道青光冲入圈内。\n" NOR "$N口中念念有词。" HIY "
只见$N" HIY "将周身法宝祭起，娇斥一声“疾”，顿时梵呗声起，万道金光将$n" HIY "妖身炸的粉身碎骨！\n\n" NOR, yi, this_object());

  message(
    "channel:chat",
    HIC "【" HIG "幻波池" HIC "】崔盈(Cui ying)：可恼！" + who->query("name") + "毁我肉身！\n" NOR,
    users()
  );
  message("channel:chat", HIC "【" HIG "幻波池" HIC "】崔盈(Cui ying)：可恨！再等十数载便将功成！\n" NOR, users());

  message_vision("\n$N肉身既毁，元神亦受创不轻，还不妨事，见势不佳，咬牙切齿厉啸一声，遁向一旁，晃眼无踪。\n\n", this_object());
  who->set_temp("huanbochi/cuiying", 1);
  if (!who->query("huanbochi/cuiying")) {
    who->set("huanbochi/cuiying", 1);
    who->add("shen", 80);
    who->add("daoxing", 100000);
    tell_object(who, HIY "你得到了一百年道行以及八十点神数。\n" NOR);
  }
  environment()->quest(who);
  destruct(this_object());
  return 1;
}

string long() {
  string *msg = ({
    "身上半盖半裹着一床质胜纨绮，色作淡青，看去又轻又软的被单。上半身
只双肩、前胸和手臂露出在外，一手微搭胸前，另一手臂懒洋洋支向右侧
玉栏之上。\n",
    "身穿一件薄如蝉翼，雪也似白的道衣，前胸微敞，露出雪白粉
颈和半段酥胸，下面乳峰隐隐坟起于冰纨锦被之间。\n",
    "那没盖着的地方，固是肌肤玉映，琼绡不掩，隐约可以窥见。还有那双手
臂，因为右手支颐默坐，露了半截臂膀和那十指春葱，说不出的粉铸脂合，
圆滑朗润。下半身虽被盖住，却在有意无意之中，由被角边半隐半现地露
出一段丰盈柔细的玉腿，以及半截底平指敛，粉光致致，柔若无骨的白足。\n",
    "面上神情是星波莹明，如蕴妙思，黛眉微颦，隐含幽怨。再加玉颊春生，
樱唇红破，瓠犀微露，欲语不语之状，好似半嗔半喜之中，蕴藏着万种风
流，无限情思。端的秾纤合度，体态妖烧，从头到脚，直无一处不撩拨人
的遐想。\n",
    "容光既如此妖艳，神态又那么淫冶，加上服饰华丽，迥绝人间。上面淡雅
的衣被与下面铺陈的锦褥文绣，再互一陪衬，越显得貌比花娇，人如玉琢，
光彩照人，不可逼视。\n",
    "人还不曾走近榻前，首先鼻孔中闻到一缕温香，其味非兰非麝，仿佛由榻
上人肌肤中隐隐透出，闻之令人魂销魄落，心神欲醉。\n",
  });
  return msg[random(sizeof(msg))];
}
