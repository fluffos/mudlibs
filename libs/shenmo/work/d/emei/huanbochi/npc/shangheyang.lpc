//B2 450skills
#include <ansi.h>
inherit __DIR__"npc.lpc";

void create()
{
        set_name("尚和阳", ({"shang heyang", "shang","yang",}));
        set("long","一个十一二岁的童子，一张红脸圆如满月，浓眉立目，大鼻
阔口。穿一件红短衫，赤着一双红脚，颈上挂着两串纸钱同
一串骷髅骨念珠。满身俱是红云烟雾围绕。\n");
        set("gender", "男性");
        set("age", 12);
        create_family("阎罗地府", 1, "你好");
        set("title", "东方魔鬼祖师");
        set("nickname","五鬼天王");
        set("class","xian");
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("combat_exp", 9112500);
        set("daoxing", 9512500);
        set("rank_info/respect", "天王");
        set("rank_info/rude","红贼");
        set("rank_info/self","本天王");
        set("rank_info/self_rude","本爷");
        set("per", 10);
        set("str", 250);
        set("spi",350);
        set("max_kee", 50000);
        set("max_sen", 80000);
        set("force", 13500);
        set("max_force", 6750);
        set("force_factor", 250);
        set("max_mana", 6750);
        set("mana",13500);
        set("mana_factor", 200);

        set("level",120);
        set_skill("jinghun-zhang", 450);
        set_skill("tonsillit", 450);
        set_skill("gouhunshu", 450);
        set_skill("unarmed", 450);
        set_skill("whip", 450);
        set_skill("sword", 450);
        set_skill("hellfire-whip",450);
        set_skill("zhuihun-sword", 450);
        set_skill("dodge", 450);
        set_skill("ghost-steps", 450);
        set_skill("parry", 450);
        set_skill("spells", 450);
        set_skill("force", 450);
        map_skill("sword", "zhuihun-sword");
        map_skill("parry", "zhuihun-sword");
        map_skill("dodge", "ghost-steps");
        map_skill("unarmed", "jinghun-zhang");
        map_skill("force", "tonsillit");
        map_skill("whip", "hellfire-whip");
        map_skill("spells", "gouhunshu");
        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
                (: perform_action, "whip", "ldlh" :),
                (: perform_action, "whip", "five" :),
                (: perform_action, "whip", "biluo" :),
                (: perform_action, "whip", "lunhui" :), 
                (: perform_action, "unarmed", "zhua" :), 
                (: cast_spell, "gouhun" :),
                (: cast_spell, "inferno" :),
                }) );
        set_temp("apply/armor",90);
        set_temp("apply/damage",60);
        set("env/brief_message",1);
        set("remove_weapon","whip");
        set("die_msg",HIR"\n$N知道再延下去，定有性命危险，将牙一错，猛地将身一滚，化成一溜火光，冲天而去。。\n\n"NOR);
        set("kill_msg",CYN"$N"CYN"说道：本天王要了你的命！\n"NOR);
        set("leave_msg",({
                "$N低声说道：罢罢罢，优昙老乞婆紧追不放，本想来此寻得一件顺手的法器，不想棘手难行。\n",
                "$N低声说道：先行回去，待我那七九大阵炼成再来也不迟。\n",
                "$N将身一滚，化成一溜火光，冲天而去。。\n",
        }));    
        set("job",([
                "data" : "shanghy",
                "shen" : 13,
                "dx"   : 40000,
        ]));
                
        setup();
        carry_object("/d/emei/huanbochi/obj/hongduanshan")->wear();
        carry_object("/d/city/npc/obj/whip")->wield();
        carry_object("/d/emei/huanbochi/obj/qiqing-wang");
        carry_object("/d/emei/huanbochi/obj/suixin-hammer");
        carry_object("/d/emei/huanbochi/obj/nili-qi");
        carry_object("/d/emei/huanbochi/obj/mohuo-jindong")->wear();
        carry_object("/d/obj/drug/jinchuang")->set_amount(500);
        carry_object("/d/obj/drug/hunyuandan")->set_amount(500);
}

void super_attack(object who)
{
        if( !who || !this_object()->is_fighting(who) )
                return;
        if( present("qiqing wang",this_object()) )
                command("ji qiqing wang");
        if( present("nili qi",this_object()) )
                command("ji nili qi");          
        if( present("baigu suixin chui",this_object()) )
                command("ji baigu suixin chui on "+who->query("id"));           
}

