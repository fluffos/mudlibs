//B1 300skills
#include <ansi.h>
inherit __DIR__ "npc.lpc";

void create_name() {
  mapping name;

  set_skill("unarmed", 300);
  set_skill("dodge", 300);
  set_skill("parry", 300);
  set_skill("spells", 300);
  set_skill("literate", 300);
  set_skill("sword", 300);
  set_skill("dodge", 300);
  set_skill("force", 300);
  set_skill("whip", 300);

  if (random(2)) {
    name = NAME_D->random_name("male");
    set("long", "相貌古怪的道装妖人，邪法高强。\n");
    set("gender", "男性");
    set("age", 40 + random(20));
    set("class", "yao");
    create_family("魔界", 1, "弟子");
    set("title", "魔教弟子");

    set_skill("molian-spells", 300);
    set_skill("xueling-jian", 300);
    set_skill("shifo-zhi", 300);
    set_skill("moshenbu", 300);
    set_skill("heilian-force", 300);
    set_skill("liudu-whip", 300);

    map_skill("spells", "molian-spells");
    map_skill("unarmed", "shifo-zhi");
    map_skill("force", "heilian-force");
    map_skill("sword", "xueling-jian");
    map_skill("parry", "liudu-whip");
    map_skill("dodge", "moshenbu");
    map_skill("whip", "liudu-whip");
    set("chat_chance_combat", 90);
    set("chat_msg_combat", ({
      (: perform_action, "whip", "shi" :),
    }));
  } else {
    name = NAME_D->random_name("female");
    set("long", "美艳娇媚的女子，面目含情，眼带桃花。\n");
    set("gender", "女性");
    set("age", 16 + random(10));
    create_family("盘丝洞", 2, "红");
    set("title", "赤身教徒");
    set("class", "yao");

    set_skill("pansi-dafa", 300);
    set_skill("lanhua-shou", 300);
    set_skill("jiuyin-xinjing", 300);
    set_skill("qingxia-jian", 300);
    set_skill("yueying-wubu", 300);
    set_skill("yinsuo-jinling", 300);
    map_skill("spells", "pansi-dafa");
    map_skill("unarmed", "lanhua-shou");
    map_skill("force", "jiuyin-xinjing");
    map_skill("sword", "qingxia-jian");
    map_skill("parry", "yinsuo-jinling");
    map_skill("dodge", "yueying-wubu");
    map_skill("whip", "yinsuo-jinling");
    set("chat_chance_combat", 90);
    set("chat_msg_combat", ({
      (: perform_action, "whip", "tian" :),
      (: perform_action, "whip", "wang" :),
      (: perform_action, "whip", "wanling" :),
    }));
  }
  set_name(name["name"], name["id"]);
}

void create() {
  create_name();
  set("per", 10);
  set("str", 200);
  set("spi", 300);
  set("max_kee", 50000);
  set("max_sen", 30000);
  set("force", 9000);
  set("max_force", 4500);
  set("force_factor", 150);
  set("max_mana", 4500);
  set("mana", 9000);
  set("mana_factor", 100);
  set("level", 100);

  set("weapon", ([
    "make": 1,
    "type": ([
      "sword": 35,
      "whip": 35,
    ]),
    "value": 352,
    "time": "丁酉年三月八日辰时二刻",
    "name": "死人骨",
    "or": "海底金母",
    "id": "whip",
  ]));

  set("env/brief_message", 1);
  set("die_msg", "$N惨叫一声，化作一道妖光急飞遁去。\n" NOR);
  set("kill_msg", CYN "$N" CYN "说道：无量寿佛，贫道送你去极乐！\n" NOR);
  set("fabao_time", 4 + random(3));
  setup();
  carry_object("/d/emei/huanbochi/obj/bonnet")->wear();
  carry_object("/d/emei/huanbochi/obj/heidaopao")->wear();
  carry_object("/d/obj/drug/jinchuang")->set_amount(300);
  carry_object("/d/obj/drug/hunyuandan")->set_amount(300);
  add_temp("apply/armor", 80);
  add_temp("apply/damage", 55);
}

void super_attack(object who) {
  if (!who)
    return;
  if (!query_temp("weapon")) {
    command("huhuan");
    command("bianhua whip");
  }
}

int reward_ob(object who) {
  object obj;
  if (who && userp(who)) {
    message_vision("\n$N惨叫一声，化作一道妖光急飞遁去。\n\n", this_object());
    who->add_temp("huanbochi/yaodao_kill", 1);
    tell_object(who, HIY "你击退了一名魔门弟子。\n" NOR);
    tell_object(
      who,
      HIY "你目前已击退了" + chinese_number(who->query_temp("huanbochi/yaodao_kill")) + "名魔门弟子。\n" NOR
    );
    if (who->query_temp("huanbochi/yaodao_kill") >= 10
      && who->query("huanbochi/yinsiniang")
      && who->query("huanbochi/huxian")) {
      obj = new("/d/emei/huanbochi/obj/wxfu-jin");
      if (obj->move(who)) {
        who->delete_temp("huanbochi/yaodao_kill");
        tell_object(who, HIY "你得到了一张" + obj->query("name") + HIY "。\n" NOR);
        tell_object(who, HIY "由于得到了额外奖励，你击退的魔门弟子数归零。\n" NOR);
        CHANNEL_D->do_channel(
          this_object(),
          "rumor",
          "听说" + who->query("name") + "从魔门弟子" + query("name") + "手中夺得了一张" + obj->query("name") + HIM "！" NOR
        );
      } else destruct(obj);
    }
    destruct(this_object());
    return 1;
  }
}
