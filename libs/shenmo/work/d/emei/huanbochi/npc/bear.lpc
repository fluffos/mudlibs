inherit __DIR__"beast.lpc";

void create_beast()
{
        string name;
        mapping Name = ([
                "棕熊" : ({"zong xiong","xiong"}),       
                "黑熊" : ({"hei xiong","xiong",}),
                "狗熊" : ({"gou xiong","xiong"}),
                "白熊"   : ({"bai xiong","xiong"}),
                "灰熊" : ({"hui xiong","xiong"}),
        ]);     
        name = keys(Name)[random(sizeof(keys(Name)))];
        set_name(name,Name[name]);
        set("age",100);
        set("gender","中性");
        set("long","一只山林中的黑瞎子，躯体粗壮，四肢强健有力，头圆颈短，眼小吻长。\n");
        set("level",20);
        set("skill_level",150);
        set("type","bear");     
        set("die_msg","$N惨叫一声，捂着脑袋仰倒在地。\n");
}

void setup()
{
        int t;
        ::setup();
        if( random(3) )
        {
                set("reward/obj",([
                        "file" : "/d/quest/occupation/medical/obj/xiongdan",
                        "num"  : 1+random(2),
                ]));
        }               
        if( random(3) )
                return;
        switch(random(5))
        {
                case 0 : 
                case 4 : t = 180+random(1000);set("reward/dx",t);break;
                case 1 : t = 220+random(300);set("reward/pot",t);break; 
                case 3 : t = 1;set("reward/shen",t);break;
                default : return;
        }
        return;
}       
