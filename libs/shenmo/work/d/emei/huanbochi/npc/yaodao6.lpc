//B1 300skills
#include <ansi.h>
inherit __DIR__"npc.lpc";

void create()
{
        int i,k;
        string *name1,*name2,name,*ids,id;
        name1 = ({
                "鱼","yu","蟹","xie","龟","gui","鲨","sha","虾","xia",
                "鲤","li","鲢","lian",
        });
        name2 = ({
                "八斗","badou","通天","tongtian","满仓","mancang",
                "千斤","qianjin","有水","you shui","无量","wuliang",
        });
        i = (random(sizeof(name1)/2))*2;  
        k = (random(sizeof(name2)/2))*2;  
        name = name1[i]+name2[k];
        id = name1[i+1]+" "+name2[k+1];
        ids = ({id,name1[i+1],name2[k+1],});
        set_name(name,ids);
        set("long","龙宫叛徒，一只修炼多年的"+name1[i]+"精。\n");
        set("gender", "男性");
        set("age", 56);
        create_family("东海龙宫", 1, "水族");
        set("title", HIC+name2[k]+"大圣"NOR);
        set("class","xian");
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("combat_exp", 6400000);
        set("daoxing", 8000000);
        set("rank_info/respect", "老"+name1[i]);
        set("rank_info/rude","臭"+name1[i]+"怪");
        set("rank_info/self","大圣我");
        set("rank_info/self_rude","大王");
        set("per", 10+random(10));
        set("str", 200);
        set("spi",300);
        set("max_kee", 50000);
        set("max_sen", 80000);
        set("force", 12000);
        set("max_force", 6000);
        set("force_factor", 250);
        set("max_mana", 5000);
        set("mana",10000);
        set("mana_factor", 200);

        set("level",100);
        set_skill("literate", 300);
        set_skill("unarmed", 400);
        set_skill("dodge", 400);
        set_skill("force", 400);
        set_skill("parry", 400);
        set_skill("fork", 400);
        set_skill("spells", 400);
        set_skill("seashentong", 400);
        set_skill("dragonfight", 400);
        set_skill("dragonforce", 400);
        set_skill("fengbo-cha", 400);
        set_skill("dragonstep", 400);
        map_skill("spells", "seashentong");
        map_skill("unarmed", "dragonfight");
        map_skill("force", "dragonforce");
        map_skill("fork", "fengbo-cha");
        map_skill("parry", "fengbo-cha");
        map_skill("dodge", "dragonstep");
        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
                (: perform_action, "fork", "fengbo" :),
                (: perform_action, "unarmed", "leidong" :),
                (: perform_action, "unarmed", "sheshen" :),
                }) );
        set("env/brief_message",1);
        set("weapon",([
                "make" : 1,
                "type" : ([ 
                        "fork" : 35,
                        ]),
                "value" : 1000,
                "time" : "丁酉年三月八日辰时二刻",
                "name" : "铁珊瑚",
                "or" : "海底金母",
                "id" : "cha",
        ])); 
        
        setup();
        carry_object("/d/emei/huanbochi/obj/bonnet")->wear();
        carry_object("/d/emei/huanbochi/obj/heidaopao")->wear();
        carry_object("/d/emei/huanbochi/obj/armor")->wear();
        carry_object("/d/obj/drug/jinchuang")->set_amount(200);
        carry_object("/d/obj/drug/hunyuandan")->set_amount(200);
        add_temp("apply/armor",80);
        add_temp("apply/damage",55);
}

void init()
{
        add_action("do_go","go");
}

int do_go(string arg)
{
        if( !arg || !userp(this_player()) )
                return 0;
        message_vision("$N猛地跳过来拦在$n面前，高声叫道：\n\t\t此山是我开，此树是我栽！\n\t\t要打此路过，留下买路财！\n\n",this_object(),this_player());
        return 1;
}

int reward_ob(object who)
{
        int shen;
        object obj;
        if( who && userp(who) )
        {
                message_vision("\n$N惨叫一声，变成了一条死鱼。\n\n",this_object());
                who->add_temp("huanbochi/lg_kill",1);
                tell_object(who,HIY"你击退了一名龙宫孽徒。\n"NOR);
                tell_object(who,HIY"你目前已击退了"+chinese_number(who->query_temp("huanbochi/lg_kill"))+"名龙宫孽徒。\n"NOR);
                if( who->query_temp("huanbochi/lg_kill")>=10 )
                {
                        who->delete_temp("huanbochi/lg_kill");
                        if( who->query("huanbochi/yijing")
                         && who->query("huanbochi/liyingqiong") )
                        {
                                if( random(100)==48 )
                                {
                                        obj = new("/d/wizz/fangz/drug/haomao");       
                                        if( obj->move(who) )
                                        {
                                                tell_object(who,HIY"你得到了"+obj->query("name")+HIY"。\n"NOR);
                                                message("channel:chat",HIG"【幻波池】敖广(Ao guang)："HIW+who->query("name")+HIG"助我剿灭孽徒，得奖励"+obj->query("name")+HIG"一颗。\n"NOR,users());
                                        }
                                        else    destruct(obj);
                                }
                                else
                                {
                                        shen = 0;
                                        if( random(100)==48 )
                                                shen = 5;
                                        else if( random(80)==48 )
                                                shen = 3;
                                        else if( random(50)==48 )
                                                shen = 1;
                                        if( shen>0 )
                                        {
                                                who->add("shen",shen);
                                                tell_object(who,HIY"你得到了"+shen+"点神数。\n"NOR);
                                                message("channel:chat",HIG"【幻波池】敖广(Ao guang)："HIW+who->query("name")+HIG"助我剿灭孽徒，得奖励"+shen+HIG"点神数。\n"NOR,users());
                                        }
                                }       
                        }
                }
        }
        destruct(this_object());
        return 1;       
}       
