#include <ansi.h>
inherit NPC;

string ask_me();

void create() {
  set_name("道士", ({ "dao shi", "dao" }));
  set("long", "峨眉山中一个修生养性的道士。\n");
  set("gender", "男性");
  set("age", 36);
  set("per", 20);
  set("attitude", "friendly");
  set("max_kee", 5000);
  set("eff_kee", 3000);
  set("kee", 3000);
  set("max_sen", 5000);
  set("max_sen", 5000);
  set("eff_sen", 3000);
  set("sen", 3000);
  set("mana_factor", 500);
  set("combat_exp", 300000);
  set("class", "human");
  set("max_force", 3400);
  set("force", 7200);

  set_skill("force", 180);
  set_skill("spells", 180);
  set_skill("zhenyuan-force", 180);
  set_skill("taiyi", 180);
  map_skill("force", "zhenyuan-force");
  map_skill("spells", "taiyi");

  set("inquiry", ([
    "all": "贫道前些日发现『崖下』有个大奥妙，待日后道行高升，自当前去。",
    "崖下": (: ask_me :),
  ]));
  setup();
  carry_object("/d/obj/cloth/daopao")->wear();
}

void kill_ob(object who) {
  remove_all_killer();
  all_inventory(environment())->remove_killer(this_object());
  say(query("name") + "说道：贫道修的是天道，不行杀戮之事。\n");
  return;
}

varargs int receive_damage(string type, int damage, object who) {
  return 0;
}

varargs int receive_wound(string type, int damage, object who) {
  return 0;
}

void die() {
  remove_all_killer();
  all_inventory(environment())->remove_killer(this_object());
  say(query("name") + "说道：贫道修的是天道，不行杀戮之事。\n");
  set("max_kee", 5000);
  set("eff_kee", 3000);
  set("kee", 3000);
  set("max_sen", 5000);
  set("max_sen", 5000);
  set("eff_sen", 3000);
  set("sen", 3000);
  set("max_force", 3400);
  set("force", 7200);
  return;
}

void unconcious() {
  die();
}

void leave(object who) {
  remove_call_out("leave");
  if (environment()) {
    message_vision(HIW "\n\n道士一声长鸣，脚下一团祥云出现，道士脚踏祥云缓缓而去……\n\n" NOR, who);
    who->move("/d/emei/huanbochi/empty");
    message_vision(HIW "\n\n祥云分开，道士从云中走了出来……\n\n" NOR, who);
    who->set("start_time", time());
    who->delete("noask");
  }
}

void quest2(object who) {
  object lee, yi, zhou, zhao, cy;

  message_vision(HIW "\n\n祥云分开，道士从云中走了出来……\n\n" NOR, this_object());

  remove_call_out("quest2");
  zhou = present("zhou qing yun", environment());
  lee = present("li ying qiong", environment());
  yi = present("yi jing", environment());
  zhao = present("zhao yaner", environment());
  cy = present("yan shi", environment());
  message_vision(HIW "\n\n道士一声长鸣，脚下一团祥云出现，道士脚踏祥云缓缓而去……\n\n" NOR, this_object());
  this_object()->move("/d/emei/jinding");
  message_vision(HIW "\n\n祥云分开，道士从云中走了出来……\n\n" NOR, this_object());
  if (who && living(who) && environment(who)
    && userp(who)
    && base_name(environment(who)) == "/d/emei/jinding") {
    if (!zhou || !environment(zhou)) {
      message_vision(CYN "$n朝$N一稽首，说道：有缘人尚未来，说不得啊说不得。\n" NOR, who, this_object());
      set("fail", 1);
    } else {
      message_vision(CYN "$n朝$N一稽首，说道：果真是有缘人啊。\n" NOR, who, this_object());
      message_vision(CYN "$N说道：此崖下密林之中有一隐匿之池，借那风婆之符当能窥得大机缘。\n" NOR, this_object());
      who->set_temp("huanbo/zhouqingyun", zhou);
      who->set_temp("in_huanbo", 1);
      if (lee)
        who->set_temp("huanbo/lyq", lee);
      if (yi)
        who->set_temp("huanbo/yj", yi);
      if (zhao)
        who->set_temp("huanbo/zhaoyaner", zhao);
      if (cy)
        who->set_temp("huanbo/yaoshi1", cy);
      tell_object(who, CYN "你暗自忖道：看来这池中有些古怪，不如下去探探？\n" NOR);
    }
    call_out("leave", 5, this_object());
  }
}

void quest1(object who) {
  remove_call_out("quest1");
  if (!who || !living(who) || !environment(who)
    || base_name(environment(who)) != "/d/emei/jinding")
    return;
  message_vision(HIM "\n\n道士一声长鸣，脚下一团祥云出现，道士脚踏祥云缓缓而去……\n\n" NOR, who);
  this_object()->move("/d/emei/huanbochi/empty");
  call_out("quest2", 3, who);
}

string ask_me() {
  if (query("noask"))
    return 0;
  if (query("eff_kee") < query("max_kee"))
    return "小道受伤了，暂时无心听你言语。";
  if (query("eff_sen") < query("max_sen"))
    return "小道心神有恙，暂时无心听你言语。";
  if (query("kee") < query("eff_kee"))
    return "贫道先得养精蓄锐。";
  if (query("sen") < query("eff_sen"))
    return "贫道须先凝神还虚。";
  if (query("fail"))
    return "不如归去，不如归去。。。。";
  if (time() < this_player()->query("huanbochi/last_end") + 3600)
    return "你不是刚刚从里面出来吗？怎么样，有什么奥妙？";
  set("eff_kee", 3000);
  set("kee", 3000);
  set("eff_sen", 3000);
  set("sen", 3000);
  set("noask", 1);
  call_out("quest1", 3, this_player());
  return "这位道友稍等片刻，待贫道先行看看。";
}

void heart_beat() {
  if (!this_object()->is_busy()
    || !this_object()->is_fighting()) {
    while (query("eff_kee") < query("max_kee")) {
      if (present("jinchuang yao", this_object()))
        command("eat yao");
      else break;
    }
    while (query("eff_sen") < query("max_sen")) {
      if (present("hunyuan dan", this_object()))
        command("eat dan");
      else break;
    }
    if (query("kee") < query("eff_kee")
      && query("force") > 100)
      command("exert recover");
    if (query("sen") < query("eff_sen")
      && query("force") > 100)
      command("exert refresh");
  }
  ::heart_beat();
}

void init() {
  add_action("do_give", "give");
}

int accept_object(object who, object obj) {
  return 0;
}

int do_give(string arg) {
  string id, oid;
  int num;
  object new_obj, obj, ob = this_object(), me = this_player();
  if (!living(ob) || ob->is_busy() || me->is_busy())
    return 0;
  if (!arg)
    return 0;
  if (sscanf(arg, "%d %s to %s", num, oid, id) == 3
    || sscanf(arg, "%s %d %s", id, num, oid) == 3
    || sscanf(arg, "%s %s", id, oid) == 2
    || sscanf(arg, "%s to %s", oid, id) == 2) {
    if (!id(id))
      return 0;
    obj = present(oid, me);
    if (!obj || obj->query_amount() < 1)
      return 0;
    if (obj->query("drug_type") != "良药"
      || userp(obj))
      return 0;
    if (!num)
      num = obj->query_amount();
    if (num > obj->query_amount())
      return 0;

    new_obj = new(base_name(obj));
    if (!new_obj)
      return 0;
    new_obj->set_amount(num);
    if (new_obj->move(ob)) {
      message_vision(
        "$N递给$n" + chinese_number(num) + obj->query("base_unit") + obj->query("name") + "。\n",
        me,
        ob
      );
      message_vision("$n由衷的向$N道谢。\n", me, ob);
      if (num < obj->query_amount())
        obj->add_amount(-num);
      else destruct(obj);
      return 1;
    } else {
      destruct(new_obj);
      return 0;
    }
  }
  return 0;
}

void return_home(object ob) {
  if (!environment()
    || time() >= query("start_time") + 3600)
    ::return_home(ob);
  return;
}
