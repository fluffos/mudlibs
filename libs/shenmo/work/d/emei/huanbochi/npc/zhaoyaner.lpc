//350skills
#include <ansi.h>
#include "/cmds/std/valid_move.h"
inherit __DIR__"npc.lpc";

void create()
{
        set_name("赵燕儿", ({"zhao yaner", "zhao","er",}));
        set("long","十四五岁一个小童，生得面如冠玉，头上梳了两个双丫角。
仪表非凡，口齿伶俐，十分惹人喜爱。\n");
        set("gender", "男性");
        set("age", 14);
        create_family("峨嵋派", 3, "弟子");
        set("class", "human");
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("combat_exp", 20000000);
        set("daoxing", 30000000);
        set("per", 30);
        set("str", 250);
        set("spi",350);
        set("max_kee", 50000);
        set("max_sen", 50000);
        set("force", 11500);
        set("max_force", 5250);
        set("force_factor", 200);
        set("max_mana", 5250);
        set("mana",11500);
        set("mana_factor", 300);
        set("level",150);
        set_skill("unarmed",350);
        set_skill("literate",350);
        set_skill("dodge",350);
        set_skill("force",350);
        set_skill("parry",350);
        set_skill("sword",350);
        set_skill("spells",350);
        set_skill("tianji-sword",350);
        set_skill("emeiforce",350);
        set_skill("zhutian-bu",350);
        set_skill("mahayana",350);
        set_skill("jinding-zhang",350);
       
        map_skill("dodge", "zhutian-bu");
        map_skill("sword", "tianji-sword");
        map_skill("parry", "tianji-sword");
        map_skill("spells", "mahayana");
        map_skill("force", "emeiforce");
        map_skill("unarmed", "jinding-zhang");

        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
                (: perform_action, "unarmed", "bashi" :),
                (: cast_spell, "haotian" :),  
                (: exert_function,"youming" :),              
                }) );
        set_temp("apply/armor",150);
        set_temp("apply/damage",120);
        set("env/brief_message",1);
        setup();
        carry_object("/d/city/npc/obj/armor")->wear();  
        carry_object("/d/emei/huanbochi/obj/qingdaopao")->wear();        
        carry_object("/d/obj/drug/jinchuang")->set_amount(100);
        carry_object("/d/obj/drug/hunyuandan")->set_amount(100);
        set_living_name("赵燕儿");
}

int copy_data(object who)
{
        if( ::copy_data(who) )
        {
                set("max_kee",who->query("max_kee"));
                set("max_sen",who->query("max_sen"));
                set("max_force",who->query("max_force"));
                set("max_mana",who->query("max_mana"));
                powerup();
#ifdef SDS_D
                SDS_D->powerup(this_object());
#endif                  
                return 1;
        }
        return 0;
}       

void init()
{
        ::init();
        if( this_player()->query_temp("huanbo/zhaoyaner") )
                add_action("do_push","push");
}

int err_msg(string arg)
{
        write(arg);
        return 1;
}

void breaks(object who)
{
        remove_call_out("breaks");      
        if( !who || !living(who) || !present(who,environment()) )
                return;
        if( !query_temp("in_shuiwu") )
                return;
        if( query_temp("break_shuiwu")>=3 )
        {
                this_object()->clear_condition("huanbo_shuiwu");
                this_object()->delete_temp("in_shuiwu");
                this_object()->delete_temp("break_shuiwu");
                message_vision("\n\n轰的一声，水雾四处炸开，$N的身形变得和真人一般大小。\n",this_object());
                powerup(1);
                command("thank");
                who->set("huanbochi/zhaoyaner_save",1);
                CHANNEL_D->do_channel(this_object(),"chat","多谢"+who->query("name")+"助我脱困！");
                who->add("shen",30);
                who->set("huanbochi/mijing-e",1);
                tell_object(who,HIY"你得到了三十点神数的奖励。\n"NOR);
                command("team talk 诸位，此处机关重重，前日探得东洞大石室处有一密径，直通中洞。\n");
                command("team talk 可惜如今师弟有伤在身，不能一同前往，先行别过，静候诸位佳音。\n");
                this_object()->dismiss_team();
                message_vision(HIC"\n$N纵身化作一道青光冲天而去。\n\n"NOR,this_object());
                destruct(this_object());
                return;         
        }               
        if( query("force")<300 )
        {
                command("daozuo 500");
                call_out("breaks",5,who);
                return;
        }
        if( query("mana")<300 )
        {
                command("mingsi 500");
                call_out("breaks",5,who);
                return;
        }
        if( query("kee")<query("eff_kee") )
        {
                command("exert recover");
                call_out("breaks",2,who);
                return;
        }
        if( query("sen")<query("eff_sen") )
        {
                command("exert refresh");
                call_out("breaks",2,who);
                return;
        }       
        message_vision("$N盘膝跌坐，暗运神功，开始炼化水雾。\n",this_object());
        add_temp("break_shuiwu",random(2));
        add("foce",-300);
        add("mana",-300);
        call_out("breaks",2,who);       
}

int do_push(string arg)
{
        object zhou,li,yi;
        mixed dir;
        mapping exit,PP=([
                "south" : "南",
                "north" : "北",
                "west"  : "西",
                "east"  : "东",
        ]);
        object env,me = this_player();
        if( !arg )
                return 0;
        if( !query_temp("in_shuiwu") )
                return 0;               
        env = environment();
        exit = env->query("exits");
        if( !exit || !mapp(exit) )
                return 0;               
        if( arg!="west" && arg!="east"
         && arg!="south" && arg!="north" )
                return err_msg("你要往哪个方向推？\n");
        if( me->is_busy() 
         || me->is_fighting() 
         || !valid_move(me) )
                return err_msg("你现在正忙。\n");
        if( me->query("mana")<300 )
                return err_msg("你的法力不足。\n");
        if( undefinedp(exit[arg]) )
                return err_msg(arg+"方向不通。\n");
        dir = exit[arg];
        if( !dir || !stringp(dir) )
                return err_msg(arg+"方向不通。\n");             

        zhou = present("zhou qing yun",env);
        li = present("li ying qiong",env);
        yi = present("yi jing",env);

        message_vision("$N运起大法力，将水雾向"+PP[arg]+"方向一推。\n",me);
        me->start_busy(2);
        me->add("mana",-300);
        if( !this_object()->move(dir) )
                return err_msg("结果什么反应也没有。\n");
        message_vision("水雾缓缓的向"+PP[arg]+"移去。\n",me);
        message_vision("\n一团水雾包裹着一个小人缓缓移了过来。\n\n",this_object());
        add_temp("pushed",1-random(3));
        if( me->move(dir) )
        {
                message_vision("$N跟了过来。\n",me);
                if( zhou && zhou==me->query_temp("huanbo/zhouqingyun") )
                        zhou->move(environment(me));
                if( li && li==me->query_temp("huanbo/lyq") )
                        li->move(environment(me));
                if( yi && yi==me->query_temp("huanbo/yj") )
                        yi->move(environment(me));
                if( query_temp("pushed")>=3 )
                {
                        message_vision("\n$N大叫：停停！便是此处！\n",this_object());
                        message_vision(CYN"$N说道：麻烦各位为我护法，待我破了此水雾。\n"NOR,this_object());
                        remove_call_out("break");
                        call_out("breaks",3,me);
                }
                return 1;
        }
        return err_msg("赶紧跟上去。\n");
}                       
                        
void start_shuiwu_hurt()
{
        object me = this_object();
        if( !me->query_temp("in_shuiwu") )
        {
                me->start_busy(1);
                return 0;       
        }       
        me->start_busy(5);      
        message("vision", HIR""+me->name() + "团坐在水雾之中，抵御着阴葵之水的侵蚀。\n"NOR, environment(me), me);
        message("vision", HIR""+me->name() + "哇的一声吐出一口腥血，脸上的青色淡了一些。\n"NOR, environment(me), me);
        me->receive_wound("sen",800+random(300)*2);
        COMBAT_D->report_sen_status(me,1);
        remove_call_out("start_shuiwu_hurt");
        call_out("start_shuiwu_hurt",2+random(4));
}       
                
