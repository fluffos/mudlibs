#include <ansi.h>
inherit __DIR__ "r.lpc";

void create_room() {
  set("short", "方塘");
  set("long", @LONG
方塘为一外方内圆，上窄下宽的形式，大小相差几十倍。
四壁有许多凹进去的深沟，一条极长而细的银链，乃是真水精
英所萃，光色灿烂，横拖在那里，
    此塘甚深，塘中云雾溟檬，波涛澎湃，激成数十百根大小
水柱，直上塘边，水花乱滚，珠迸雪飞，势绝汹涌。
    方塘有三面三座三丈多高、八尺来宽的玉壁环绕。三面壁
中有两壁所现均是圣姑仙容：
    左一座是个云鬟雾鬓，貌若天仙的少女，仪态万分，雍容
华贵；
    右一座却改作佛门装束，白衣如雪，玉跌双裸，闭目合睛，
盘坐其上，只是额束金箍，香发如云，尚未剃去，宝相庄严，
妙丽绝伦。
    方塘对岸一座白如玉雪，晶明若镜，上面俱是水流影子，
纵横交错，盘舞其上，好些灵符，宛如龙蛇飞舞，极似塘中水
光反映。
LONG);
  set("exits", ([
    "south": __DIR__ "xiaceng-b",
    "west": __DIR__ "fangtang-left",
    "east": __DIR__ "fangtang-right",
    "north": __DIR__ "fangtang-n",
  ]));
}

void help_yan(object who) {
  object zhou, yi, li;
  remove_call_out("help_yan");
  if (!who || !living(who) || !present(who))
    return;
  message_vision("\n只听水底忽然传来一声男子的呼救声。\n\n", who);
  who->set_temp("huanbochi/zhaoyaner_help", 1);
  zhou = present("zhou qing yun");
  if (zhou && !userp(zhou))
    zhou->command("say 啊！好似是赵师弟的声音。\n");
  li = present("li ying qiong");
  if (li && !userp(li))
    li->command("say 听声音，好似来自水底，看来水中有奥秘。\n");
  yi = present("yi jing");
  if (yi && !userp(yi))
    yi->command("say 事不宜迟，得赶紧找到赵师弟，免得迟则生变。\n");
}

void say_zhen(object who) {
  object zhou;
  remove_call_out("say_zhen");
  if (!who || !living(who) || !present(who))
    return;
  zhou = who->query_temp("huanbo/zhouqingyun");
  if (!zhou || !living(zhou) || !present(zhou))
    return;
  zhou->command("team talk 以石壁之上所学之法可以破(break)此处的「癸水大阵」。\n");
}

void init() {
  object zhou, me = this_player();
  ::init();
  if (userp(me) && me->query_temp("huanbo/shuizhen_learned")) {
    remove_call_out("say_zhen");
    call_out("say_zhen", 1 + random(3), me);
  }
  if (userp(me)) {
    if (me->query("huanbochi/liyingqiong")
      && me->query("huanbochi/yijing")
      && !me->query_temp("huanbochi/zhaoyaner_help")
      && !me->query("huanbochi/zhaoyaner_save"))
      call_out("help_yan", 3 + random(3), me);
  }
  add_action("do_dive", "dive");
  add_action("do_break", "break");
}

int do_break() {
  object zhou, yi, li, me = this_player();
  if (!me->query_temp("huanbo/shuizhen_learned")
    || !me->query("huanbochi/shy"))
    return 0;
  if (me->is_busy())
    return err_msg("你现在正忙。\n");
  if (me->query("mana") < 500)
    return err_msg("你法力不够。\n");
  me->start_busy(1);
  message_vision("
$N想起石壁之上所学到的用法符箓，连忙手中打出法诀。\n", me);
  if (random(me->query("mana") / 10) < 10) {
    me->add("mana", -300);
    message_vision("
结果什么反应也没有。\n", me);
    return 1;
  }
  message_vision("                
这时眼前光华如电，连闪两下，四外水柱忽然一齐倒退，现出一条道路。\n", me);
  zhou = me->query_temp("huanbo/zhouqingyun");
  if (zhou && present(zhou) && living(zhou))
    zhou->command("team talk 吾等先去东洞看看那密径有甚大机缘。\n");
  yi = me->query_temp("huanbo/yj");
  if (yi && present(yi) && living(yi))
    yi->command("team talk* agree zhou");
  li = me->query_temp("huanbo/lyq");
  if (li && present(li) && living(li))
    li->command("team talk 先返回西二层石室再做打算。\n");
  write("你点了点头，与众人一同返回西二层石室。\n");
  me->set_temp("huanbo/2mijing", 1);
  me->move(__DIR__ "shishi-w2");
  if (zhou && present(zhou))
    zhou->move(__DIR__ "shishi-w2");
  if (yi && present(yi))
    yi->move(__DIR__ "shishi-w2");
  if (li && present(li))
    li->move(__DIR__ "shishi-w2");
  return 1;
}

int do_dive() {
  object zhou, yi, li, me = this_player();
  if (userp(me) && me->is_busy())
    return err_msg("你一个猛子扎到水里。。。\n但没多会儿就被憋得半死，只好赶紧爬上岸来。\n");
  if (userp(me) && !me->query_temp("huanbochi/zhaoyaner_help"))
    return err_msg("你一个猛子扎到水里。。。\n但没多会儿就被憋得半死，只好赶紧爬上岸来。\n");
  if (!query("can_dive"))
    return err_msg("你一个猛子扎到水里。。。\n水花乱滚，珠迸雪飞，势绝汹涌。你憋得半死，只好赶紧爬上岸来。\n");
  if (userp(me))
    me->start_busy(2);
  message_vision(HIY "$N一个猛子扎到水中，然后不见了。\n" NOR, me);
  me->move(__DIR__ "under1");
  message_vision("$N潜了过来。\n", me);
  if (!userp(me))
    return 1;
  zhou = present("zhou qing yun");
  if (zhou && !userp(zhou))
    zhou->command("dive");
  li = present("li ying qiong");
  if (li && !userp(li))
    li->command("dive");
  yi = present("yi jing");
  if (yi && !userp(yi))
    yi->command("dive");
  return 1;
}

int valid_leave(object who, string dir) {
  object npc;
  if (dir == "south" && userp(who) && who->query("huanbochi/zhaoyaner_save")) {
    if (!who->query("huanbochi/shy")) {
      if (!who->query("huanbochi/azf")) {
        npc = present("aizi fei");
        if (npc && !userp(npc) && !npc->is_fighting())
          destruct(npc);

        npc = new(__DIR__ "npc/aizifei");
        if (npc->copy_data(who)) {
          message_vision("
只见一道人影窜了出来，立时跳入方塘，并带了根银链飞上岸来，
塘中立时雷鸣风吼，波涛汹涌，晃眼之间，风涛雷声越发猛烈，
上下四外一齐震撼。
平空现出无数水柱一般的白影，齐往中心挤压上来。头上又有大片
灰白影子罩落，挟着无边压力，由前、左、右三面疾涌上来。\n" NOR, who);
          who->receive_damage("kee", 300 + random(500));
          COMBAT_D->report_status(who);
          if (npc->move(this_object())) {
            npc->command("say 嘿嘿，今日叫尔等来得回不得！\n");
            npc->kill_ob(who);
          } else destruct(npc);
        } else destruct(npc);
      }

      npc = present("sha hongyan");
      if (npc && !userp(npc) && !npc->is_fighting())
        destruct(npc);

      npc = new(__DIR__ "npc/shahongyan");
      if (npc->copy_data(who)) {
        if (npc->move(this_object())) {
          message_vision(npc->query("name") + "从半空落了下来。\n", who);
          if (!who->query("huanbochi/azf")) {
            npc->command("giggle");
            npc->command("say 搬着板凳看戏咯。\n");
          } else {
            npc->command("heng");
            npc->command("say 天堂有路尔不走，地狱无门跑进来，臭贼！今天本姑娘要为师弟报仇！\n");
            npc->kill_ob(who);
          }
        } else destruct(npc);
      } else destruct(npc);
    }
    //NPC已干掉了，直接去
    else {
      message_vision("
你当头遇到两根自相撞来的白影，两下方一接触，只听惊天动地的
连声大震，身上立似有无数迅雷打到，被震得头晕耳鸣，连晃了好
几晃。
那两根白影也被飞剑冲散，果是两根大水柱。全洞俱是癸水神雷暴
发，直似万千天鼓急擂交鸣，震耳欲聋，震撼全洞。接着，癸水神
雷转为玄色，上下四外亮晶晶闪着玄色奇光的大小水柱，直似倒海
崩山一般，压了上来，更是厉害难当。\n", who);
      who->delete_temp("last_damage_from");
      who->set_temp("death_msg", "身陷" HIG "「癸水大阵」" HIM "，化作一滩脓水！\n" NOR);
      who->receive_wound("kee", 800 + random(800));
      COMBAT_D->report_status(who, 1);
      who->receive_damage("kee", 1000 + random(1500));
      COMBAT_D->report_status(who);
    }
    return 2;
  }
  return ::valid_leave(who, dir);
}
