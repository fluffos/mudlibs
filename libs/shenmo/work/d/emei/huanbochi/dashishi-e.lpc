#include <ansi.h>
#include <room.h>
inherit __DIR__"r.lpc";

void create_room()
{
        set("short","大石室");
        set("long",@LONG
一间大石室，中空无物。
LONG);  
        set("exits",([
                "south"         : __DIR__"yd-e9",
                "northwest"     : __DIR__"yd-b1",
        ]));
        create_door("south", "石门", "north", DOOR_CLOSED);             
}

int valid_leave(object who,string dir)
{
        object lee,yi;
        if( !userp(who) )
                return ::valid_leave(who,dir);  
        if( who->query_temp("huanbo/zhouqingyun")
         && present(who->query_temp("huanbo/zhouqingyun"))
         && who->query_temp("huanbo/yj")
         && present(who->query_temp("huanbo/yj"))
         && who->query_temp("huanbo/lyq")
         && present(who->query_temp("huanbo/lyq")) )
        {
                if( who->query_temp("huanbo/2mijing") )
                {
                        remove_call_out("openM");
                        call_out("openM",2+random(5),who);
                        return notify_fail("此地有些蹊跷，你停住了脚步。\n");
                }
                else    return ::valid_leave(who,dir);
        }       
                
        if( !who->query("huanbochi/huxian")
         || !who->query("huanbochi/zhouqingyun")
         || !who->query("huanbochi/yinsiniang")
         || !who->query("huanbochi/shanghy")
         || !who->query("huanbochi/bingrong")
         || !who->query("huanbochi/pingfeng-save") 
         || who->is_fighting() )
                return notify_fail("忽听一个少女喝道：“来人慎行，免遭不测！”\n");
                        
        lee = who->query_temp("huanbo/lyq");
        if( !lee )
                return notify_fail("忽听一个少女喝道：“来人慎行，免遭不测！”\n");
        if( !lee->copy_data(who) )
                return notify_fail("忽听一个少女喝道：“来人慎行，免遭不测！”\n");            
        if( !present(lee,this_object()) )
        {                        
                lee->move(this_object());
                message_vision(HIC"\n\n一道霞光冲进室内。\n"NOR,who);
                message_vision(HIC"云彩散去，却原来是一位秀眉英风，姿容绝世的少女。\n"NOR,who);
        }                                               
        if( !who->query("huanbochi/liyingqiong") )
        {
                message_vision(CYN"$N"CYN"用很疑惑的眼神看着$n"CYN"。\n"NOR,lee,who);
                if( who->query("gender")=="女性" )
                        message_vision(CYN"$N"CYN"说道：何方妖女，敢掳我周师姐！\n"NOR,lee);
                else    message_vision(CYN"$N"CYN"说道：兀那汉子，敢掳我周师姐！\n"NOR,lee);    
                lee->kill_ob(who);
                return 2;
        }
        if( who->add_team_member(lee) )
        {
                lee->set("owner",who);
                lee->set_leader(who);
                message_vision(CYN"$N"CYN"说道：本姑娘便和你一同继续查看此处的奥秘吧。\n"NOR,lee);
                tell_object(who,lee->name() + "决定开始跟随你一起行动。\n");
                tell_object(who,WHT"【队伍】"+lee->query("name")+WHT"加入队伍。\n"NOR); 
        }       
                                
        yi = who->query_temp("huanbo/yj");
        if( !yi )
                return notify_fail("忽听一个少女喝道：“来人慎行，免遭不测！”\n");
        if( !yi->copy_data(who) )
                return notify_fail("忽听一个少女喝道：“来人慎行，免遭不测！”\n");
        if( !present(yi,this_object()) )
        {                        
                yi->move(this_object());
                message_vision(HIC"\n\n一道霞光冲进室内。\n"NOR,who);
                message_vision(HIC"云彩散去，却原来是一位样似七八岁的幼女，相貌极清秀的少女。\n"NOR,who);
        }                                               
        if( !who->query("huanbochi/yijing") )
        {
                message_vision(CYN"$N"CYN"用很疑惑的眼神看着$n"CYN"。\n"NOR,yi,who);
                if( who->query("gender")=="女性" )
                        message_vision(CYN"$N"CYN"说道：何方妖女，敢掳我周师妹！\n"NOR,yi);
                else    message_vision(CYN"$N"CYN"说道：兀那汉子，敢掳我周师妹！\n"NOR,yi);     
                yi->kill_ob(who);
                return 2;
        }
        if( who->add_team_member(yi) )
        {
                yi->set("owner",who);
                yi->set_leader(who);
                message_vision(CYN"$N"CYN"说道：本姑娘便和你一同继续查看此处的奥秘吧。\n"NOR,yi);
                tell_object(who,yi->name() + "决定开始跟随你一起行动。\n");
                tell_object(who,WHT"【队伍】"+yi->query("name")+WHT"加入队伍。\n"NOR);  
                return 2;
        }
        return ::valid_leave(who,dir);
}

void closeD()
{
        remove_call_out("closeD");
        close_door("south",1);
}

void openD(object who)
{
        remove_call_out("openD");
        if( !who || !present(who) )
                return;
        if( open_door("south") )
        {       
                tell_room(this_object(),HIC"\n"+who->query("name")+HIC"运足法力在石壁上一抵，轰的一声，出现了一道门户。\n\n"NOR);
                who->delete_temp("dashishi_open");
                call_out("closeD",5+random(5));
        }
}

void openM2(object who,object yi,object zhou,object li)
{
        int flag = 0;
        remove_call_out("openM2");
        if( !who || !present(who)
         || !yi || !present(yi) )
                return;
        message_vision("三人合力在石壁一角一推，只听”轰隆“一声巨响，眼前景色已是大不相同。\n\n",who);
        who->delete_temp("huanbo/2mijing");
        who->move(__DIR__"mijing-e1");
        zhou->move(__DIR__"mijing-e1");
        li->move(__DIR__"mijing-e1");
        yi->move(__DIR__"mijing-e1");   
}       

varargs void _openM(object who,object yi,object zhou,object li)
{
        int flag = 0;
        remove_call_out("_openM");
        if( !who || !present(who)
         || !yi || !present(yi) )
                return;
        message_vision("$N闭目凝神，仔细在石壁上摸索。\n$N若有所思。\n",yi);
        flag++;
        if( zhou && present(zhou) )
        {
                flag++;
                message_vision("$N闭目凝神，仔细在石壁上摸索。\n$N若有所思。\n",zhou);
        }
        if( li && present(yi) )
        {
                flag++;
                message_vision("$N闭目凝神，仔细在石壁上摸索。\n$N若有所思。\n",li);
        }
        if( flag<3 )
                return;
        message_vision(CYN"咦？$N"CYN"的脸上露出疑惑的表情。\n"NOR,yi);
        zhou->command("say 什么情况？！");
        li->command("wow");
        remove_call_out("openM2");
        call_out("openM2",random(2),who,yi,zhou,li);
}

void openM(object who)
{
        object zhou,li,yi;
        remove_call_out("openM");
        if( !who || !present(who) )
                return;
        zhou = who->query_temp("huanbo/zhouqingyun");
        if( zhou && present(zhou) )
                zhou->command("team talk 赵师弟说的便是此处吧？");
        li = who->query_temp("huanbo/lyq");
        if( li && present(li) )
                li->command("team talk 不错不错，此间果然有些古怪。");
        yi = who->query_temp("huanbo/yj");
        if( yi && present(yi) )
        {
                yi->command("team talk 无需再作感慨，合力探查此间奥秘吧。");
                remove_call_out("_openM");
                call_out("_openM",random(3),who,yi,zhou,li);
                return;         
        }       
}

void init()
{
        object me = this_player();
        ::init();
        if( userp(me) && me->query_temp("huanbo/2mijing") )
        {
                remove_call_out("openM");
                call_out("openM",1+random(5),me);
                return;
        }
        if( me->query("id")=="zhou qing yun"
         && me->query_temp("dashishi_open") )
        {
                remove_call_out("openD");
                call_out("openD",random(5),me);
        }
}       
