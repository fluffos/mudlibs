#include <ansi.h>
#include <room.h>
inherit __DIR__"r.lpc";

string random_msg();

void create_room()
{
        set("short","西一层石室");
        set("long",@LONG
此洞为为炼丹炉鼎所在，圣姑飞升之时，毒龙丸刚刚第
二次炼成，尚未开炉，便即化去。那十二种仙草，也在其内。
此洞与其余三洞相通，
    这一层石室甚是宽大，室中黄云氤氲，仅能辨物。最里面
石壁之上有一个金环(huan)。    
LONG);  
        set("exits",([
                "east" : __DIR__"xidong-damen",
                "down" : __DIR__"yd-w1",
        ]));
        set("item_desc",([
                "huan" : (: random_msg :),
        ]));    
        create_door("down", "石壁", "up", DOOR_CLOSED); 
        create_door("east", "洞门", "west", DOOR_CLOSED); 
}

void init()
{
        ::init();
        add_action("do_turn","turn");
}

void remove_door()
{
        remove_call_out("remove_door");
        if( close_door("down") )
                tell_room(this_object(),"\n“轰隆隆”一声巨响，石壁又升了起来！\n\n");
}               

int do_turn(string arg)
{
        object npc;
        if( !arg || arg!="right" )
                return err_msg("你要朝哪边转？\n");
        message_vision("$N拉着壁上一个金环，往怀中用力一带，再往右一扭。\n",this_player());            
        if( open_door("down") )
        {
                message_vision("$N忽觉眼前奇亮。又是一阵隆隆之音，当中三丈多高的一块长方形石壁，忽往地下沉去。\n",this_player());                      
                write("\n好一个别有洞天，快进快进！\n");
                if( !this_player()->query("huanbochi/shanghy")
                 && userp(this_player()) )
                {
                        npc = present("shang heyang",this_object());
                        if( !npc || userp(npc) )
                        {
                                npc = new(__DIR__"npc/shangheyang");
                                npc->move(this_object());
                                message_vision("\n从石壁之内飞身闪出一人！\n",npc);
                        }
                        if( npc->copy_data(this_player()) )
                                npc->kill_ob(this_player());
                }
                call_out("remove_door",180);
                return 1;
        }               
        write("结果什么反应也没有。\n");
        return 1;
}

string random_msg()
{
        string msg;
        object me = this_player();
        string *poems = ({
                "保右命尔，燮伐大商。","溯洄从之，道阻且右","高眄邈四海，豪右何足陈。",
                "树多淮右地，山远汝南城。","钟鼓既设，一朝右之。","控弦破左的，右发摧月支。",
                "学书初学卫夫人，但恨无过王右军。","故人从军在右辅，为我度量掘臼科。",
                "愿书万本诵万遍，口角流沫右手胝。",
        });
        msg = poems[random(sizeof(poems))];
        msg = replace_string(msg,"右",HIR"右"NOR);
        tell_object(me,"隐隐约约耳边传来一声低吟："+msg+"\n");
        return "一个亮灿灿的金环，看起来能拉起转动(turn)。\n";
}

