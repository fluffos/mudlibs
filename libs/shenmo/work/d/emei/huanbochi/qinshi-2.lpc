#include <ansi.h>
inherit __DIR__"r.lpc";

void create_room()
{
        set("short","寝室");
        set("long",@LONG
原来这间卧室比外间还大，通体作正圆形，分成内外两
个半间。当中隔着一道帘幕，质类五色鲛绡，云锦双悬，流
苏下垂，看去鲜艳绝伦，华贵无比。妖尸卧榻便设在里面的
半间。
    内外合计约有十余丈方圆，这一隔开，成了两个半圆。
外半陈设坐具，已是精雅富丽，巧夺鬼工，宝气珠光，辉映
全室。而内半陈设之绮丽新奇，尤非笔墨可以形容。除当中
放着一个腰圆形的碧玉榻外，和寻常富贵人家红闺绣阁一样，
一切镜台奁具以至衣履被褥之类，无不齐备，应有尽有。只
是所有物品珍奇异常，尘世上多富贵的人家，也不易见到一
件罢了。
LONG);  
        set("exits",([
                "west" : __DIR__"qinshi-1",
        ]));
        set("objects",([
                __DIR__"obj/biyu-bed" : 1,
        ]));            
}

void quest2(object who)
{       
        object zhou,yi,li;      
        remove_call_out("quest2");
        if( !who || !present(who) )
                return; 
        zhou = who->query_temp("huanbo/zhouqingyun");
        li = who->query_temp("huanbo/lyq");     
        yi = who->query_temp("huanbo/yj");
        message_vision(YEL"房外卷进一股阴风，毒手摩什从中杀将出来！\n"NOR,who);
        tell_object(who,HIR"看起来摩什想杀死你！\n"NOR);
        message_vision(MAG"摩什将手一招，顿时一片乌金色的云霞展布甚宽，涛崩潮涌，片片妖云，
杂着无数魔鬼影子，惨啸如潮。\n似天倾一般，将里外室一齐布满！\n"NOR,who);
        tell_object(who,HIR"猛觉天旋地转，顿成了黑暗世界。只见光景昏黄，乌金云光不住明灭闪变，
较前更急，混乱目光。上下四方无边无际，妖光以外一无所见。就在天旋地
转，妖光明灭甚急之际，四下景色已是一变！\n"NOR);
        delete("quest");
        who->move("/d/emei/huanbochi/lingqin",2);
        if( zhou )  zhou->move("/d/emei/huanbochi/lingqin",2);
        if( li ) li->move("/d/emei/huanbochi/lingqin",2);
        if( yi ) yi->move("/d/emei/huanbochi/lingqin",2);
}

void quest(object who)
{
        if( !who || !present(who) 
         || !who->query_temp("huanbo/yaoshi1") )
                return;
        set("quest",1); 
        call_out("quest2",3+random(5),who);     
}

int valid_leave(object who,string dir)
{
        if( userp(who) && dir=="west" 
         && query("quest") )
                return notify_fail("你长叹了一口气。\n");
        return ::valid_leave(who,dir);
}                

