#include <ansi.h>
#include <room.h>
inherit __DIR__"r.lpc";

void create_room()
{
        set("short","甬道");
        set("long",@LONG
一条狭长的甬道，地势逐渐向下，头顶开始出现一些大
小不一的石乳。
LONG);  
        set("exits",([
                "west"  : __DIR__"yd-b4",
                "up"    : __DIR__"yd-b2",
        ]));    
        set("objects",([
                __DIR__"obj/shixiang-b3" : 1,
        ]));            
        create_door("west", "石壁", "east", DOOR_CLOSED);       
}

