#include <ansi.h>
inherit __DIR__ "r.lpc";

void create_room() {
  set("short", "大石室");
  set("long", @LONG
一间大石室，中空无物，四壁平滑细腻，宛如美玉，陈列
器皿，极为古雅精良。
LONG);
  set("exits", ([
    "west": __DIR__ "yd-u7",
    "down": __DIR__ "yd-u6",
    "east": __DIR__ "changtang",
  ]));
}

int valid_leave(object who, string dir) {
  object npc;
  if (!userp(who) || dir != "east")
    return ::valid_leave(who, dir);
  if (who->is_fighting())
    return notify_fail("加油加油。\n");
  if (!who->query("huanbochi/tiezhu"))
    return notify_fail("忽听一个少女喝道：“来人止步，免遭不测。”\n");
  if (!who->query("huanbochi/moshi")
    || !who->query_temp("huanbochi/moshi")) {
    npc = present("mo shen");
    if (!npc || userp(npc)) {
      npc = new(__DIR__ "npc/moshi");
      if (!npc->move(this_object())) {
        destruct(npc);
        return notify_fail(CYN "忽听一个少女喝道：“来人止步，免遭不测。”\n" NOR);
      }
      if (!npc->copy_data(who)) {
        destruct(npc);
        return notify_fail(CYN "忽听一个少女喝道：“来人止步，免遭不测。”\n" NOR);
      }
      message_vision("一阵阴风卷来，一道模糊的人影渐渐显了出来。\n", who);
    }
    message_vision(CYN "$N" CYN "朝$n" CYN "撇了撇嘴，一副瞧不起$c的样子。\n" NOR, npc, who);
    message_vision(CYN "$N" CYN "说道：哈哈！送上门来的肉！密西密西的思密达。。。。\n" NOR, npc);
    npc->kill_ob(who);
    return 2;
  }
  return ::valid_leave(who, dir);
}
