#include <ansi.h>
inherit __DIR__ "r.lpc";

void create_room() {
  set("short", "南洞外层洞府");
  set("long", @LONG
一间广大石室，满壁青光照眼。
    室中陈设颇多，形式奇古，大半皆修道人所用。
LONG);
  set("exits", ([
    "south": __DIR__ "yd-s6",
    "enter": __DIR__ "waidong-s2",
  ]));
  set("objects", ([
    __DIR__ "obj/guta": 1,
    __DIR__ "obj/guta2": 1,
  ]));
}

void fullme(object who) {
  if (!who || !present(who, this_object()))
    return;
  who->set("eff_kee", (int)who->query("max_kee"));
  who->set("kee", (int)who->query("max_kee"));
  who->set("eff_sen", (int)who->query("max_sen"));
  who->set("sen", (int)who->query("max_sen"));
  who->set("force", (int)who->query("max_force") * 2);
  who->set("mana", (int)who->query("max_mana") * 2);
  who->set("water", 1000);
  who->set("food", 1000);
  message_vision("\n$N长呼一口气，站了起来。\n\n", who);
}

void fullme2(object who) {
  int dx;
  if (!who || !present(who, this_object()))
    return;
  dx = 40 - who->query("kar") / 2;
  dx = dx / 2 + random(dx);
  if (dx < 1)
    dx = 1;
  message_vision("\n$N长呼一口气，站了起来。\n\n", who);
  if (who->query("huanbochi/yuchuang_dx") <= 10000) {
    who->add("huanbochi/yuchuang_dx", dx);
    who->add("daoxing", dx);
    tell_object(who, "你的道行增加了" + COMBAT_D->chinese_daoxing(dx) + "。\n");
    who->start_busy(3);
  }
}
