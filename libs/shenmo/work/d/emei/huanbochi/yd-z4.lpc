#include <ansi.h>
inherit __DIR__"r.lpc";

mapping kz = ([
        "颜":({"回","渊",29,}),
        "端木":({"赐","子贡",31,}),
        "仲":({"由","子路",9,}),
        "冉":({"求","子有",29,}),
        "曾":({"参","子舆",46,}),
        "卜":({"商","子夏",44,}),
        "公孙":({"龙","子石",53,}),
        "闵":({"损","子骞",15,}),
        "公西":({"赤","子华",42,}),
        "冉":({"耕","伯牛",7,}),
        "言":({"偃","子游",45,}),
        "颜":({"繇","季路",6,}),
        "樊":({"须","子迟",36,}),
        "冉":({"雍","仲弓",29,}),
        "原":({"宪","子思",36,}),
        "曾":({"点","皙",5,}),
        "澹台":({"灭明","子羽",36,}),
        "宓":({"不期","子贱",30,}),
        "陈":({"亢","子禽",40,}),
        "高":({"柴","子高",30,}),
        "秦":({"商","不慈",4,}),
        "巫马":({"施","子期",30,}),
        "伯":({"虔","子析",50,}),
        "曹":({"卹","子循",50,}),
        "冉":({"鲁","子鲁",50,}),
        "商":({"瞿","子木",29,}),
        "叔":({"仲","子期",50,}),
        "颜":({"高","子骄",50,}),
        "梁":({"鳣","叔鱼",29,}),
]);

void create_room()
{
        set("short","甬道");
        set("long",@LONG
这一带甬路本是又高又窄，忽然接连两个转折过去，
地势突往上高起了数十丈。
LONG);  
        set("exits",([
                "east" : __DIR__"yd-z3",
                "west" : __DIR__"yd-z5",
        ]));
        set("item_desc",([
                "east" : "你要看什么？\n",
                "west" : "你要看什么？\n",
                "shu sheng" : "一位进京赶考的书生，失足落崖而死。不知怎的，亡魂游
荡到此，难以入轮回。\n",
                "shusheng" : "一位进京赶考的书生，失足落崖而死。不知怎的，亡魂游
荡到此，难以入轮回。\n",
        ]));
}

void reset()
{
        ::reset();
        set("quest",1);
}

void init()
{
        ::init();
        add_action("do_look","look");
        add_action("do_ask","ask");
        add_action("do_answer","answer");
}

int do_look(string arg)
{
        string str;
        object *inv;
        int i;
        
        if( arg || !userp(this_player()) )
                return 0;
        if( !query("quest") )
                return 0;

        str = HIR"「"HIY"甬道"HIR"」"NOR;
        if( wizardp(this_player()) )
                str+= WHT"   - /d/emei/huanbochi/yd-z4"NOR;
        str+= " 
    这一带甬路本是又高又窄，忽然接连两个转折过去，
地势突往上高起了数十丈。
    这里的出口被一个鬼魂挡住了。\n";
        str+= "  落魄书生<"HIB"鬼魂"NOR">(Shu sheng)\n";
        inv = all_inventory();
        i=sizeof(inv);
        while(i--) 
        {
                if( !this_player()->visible(inv[i]) ) 
                        continue;
                if( inv[i]==this_player() ) 
                        continue;
                str+= "  " + inv[i]->short() + "\n";
        }
        write(str);
        return 1;
}               

void quest2(object who)
{
        string name1,name2,name3,*names;
        int i,age;
        
        remove_call_out("quest2");
        if( !who || !living(who) 
         || !present(who) 
         || !query("quest") )
        {
                delete("story"); 
                return;  
        }
        message_vision(CYN"书生「唉」的一声叹了口气。\n"NOR,who);
        names = keys(kz);
        name1 = names[random(sizeof(names))];
        name2 = kz[name1][0];
        name3 = kz[name1][1];
        age = kz[name1][2];
        if( random(2) )
                name1+= name2;
        else    name1+= name3;
        message_vision(CYN"书生说道：你可知"+name1+"比圣人年幼几何？\n"NOR,who);
        who->set_temp("huanbo/kongzi_ask",age);
        tell_object(who,"请回答书生的问题 answer <答案>\n");    
}
        
void quest(object who)
{
        remove_call_out("quest");
        if( !who || !living(who) 
         || !present(who) 
         || !query("quest") )
        {
                delete("story"); 
                return;  
        }
        message_vision(CYN"书生「唉」的一声叹了口气。\n"NOR,who);
        message_vision(CYN"书生说道：我苦读这么多年，到底为何？\n"NOR,who);
        remove_call_out("quest2");
        call_out("quest2",2+random(3),who);
}       

int do_ask(string arg)
{
        string sth;
        object me = this_player();
        if( !arg || sscanf(arg,"%s about %s",arg,sth)!=2 )
                return 0;
        if( !query("quest") )
                return 0;       
        if( arg!="shu sheng" && arg!="shusheng" )
                return 0;
        if( query("story") )
                return err_msg("鬼魂幽幽叹了一口气，说道：且听我慢慢道来。\n");        
        if( time()<me->query_temp("huanbo/last_kzask")+30 )
                return err_msg("鬼魂幽幽叹了口气，说道：朽木不可雕也。\n");     
        set("story",1); 
        message_vision(CYN"$N对着鬼魂「嗯」的一声，似乎有什么话要说。\n"NOR,me);
        message_vision(CYN"书生「唉」的一声叹了口气。\n"NOR,me);
        message_vision(CYN"书生说道：寒窗苦读十余载，一朝失足皆成空。\n"NOR,me);
        remove_call_out("quest");
        call_out("quest",2+random(3),me);
        return 1;
}

int valid_leave(object who,string dir)
{
        if( userp(who) && query("quest") )                      
                return notify_fail("这个方向没有出路。\n");
        return ::valid_leave(who,dir);
}       

int do_answer(string arg)
{
        int i,k;
        object me = this_player();
        
        if( !arg )
                return 0;
        if( !query("quest") )
                return 0;       
        if( !i=me->query_temp("huanbo/kongzi_ask") )
                return 0;
        message_vision("$N回答道：是"+arg+"。\n",me);   
        if( sscanf(arg,"%d",k)!=1 )
        {
                if( arg!=chinese_number(i) )
                {
                        me->set_temp("huanbo/last_kzask",time());
                        me->delete_temp("huanbo/kongzi_ask");
                        delete("story");
                        message_vision(CYN"书生「唉」的一声叹了口气。\n"NOR,me);
                        message_vision(CYN"书生说道：似我这等饱读诗书的人，年纪轻轻便命丧荒野；而
你这样的下里巴人却如此风光，唉~~~\n"NOR,me);
                        return 1;
                }
                else    
                {
                        message_vision(CYN"书生惊讶地“啊”了一声。\n"NOR,me);
                        message_vision(CYN"书生对$N一拱手道：原来"+RANK_D->query_respect(me)+"竟是学富五车，不才五体投地。\n"NOR,me);
                        message_vision("书生让开了道路。\n",me);
                        delete("story");
                        delete("quest");
                        return 1;
                }
        }
        if( k!=i )
        {
                me->set_temp("huanbo/last_kzask",time());
                me->delete_temp("huanbo/kongzi_ask");
                delete("story");
                message_vision(CYN"书生「唉」的一声叹了口气。\n"NOR,me);
                message_vision(CYN"书生说道：似我这等饱读诗书的人，年纪轻轻便命丧荒野；而
你这样的下里巴人却如此风光，唉~~~\n"NOR,me);
                return 1;               
        }
        else
        {
                message_vision(CYN"书生惊讶地“啊”了一声。\n"NOR,me);
                message_vision(CYN"书生对$N一拱手道：原来"+RANK_D->query_respect(me)+"竟是学富五车，不才五体投地。\n"NOR,me);
                message_vision("书生让开了道路。\n",me);
                delete("story");
                delete("quest");
                return 1;
        }
}
                
