#include <ansi.h>
inherit __DIR__"r.lpc";

void create_room()
{
        set("short","甬道");
        set("long",@LONG
这是一个与门一般大小的曲折甬道。顶上一颗颗的金星，
往前直排下去，每隔二三丈远，必有一个，行列甚是整齐，
金光四射，耀眼生花。
LONG);  
        set("exits",([
                "east" : __DIR__"mijing-e3",
                "west" : __DIR__"yd-z2",
        ]));
}

void init()
{
        ::init();
        if( this_player()->query_temp("huanbo/mj-fire") )
                this_player()->delete_temp("huanbo/mj-fire");
}               
