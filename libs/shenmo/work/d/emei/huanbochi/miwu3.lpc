#include <ansi.h>
inherit __DIR__ "r.lpc";

void create_room() {
  set("short", "迷雾中");
  set("long", @LONG
这里雾气浓密，一望沉冥。
    初上路时，只觉出暗影中含有一种奇怪力量，上下前后
都有吸力，将人抵住，无论进退，俱有阻滞，去不多远，渐
觉身后和上下两方吸力加重，越往前越厉害。
LONG);
}

void init() {
  ::init();
  add_action("do_go", "go");
}

int do_go(string arg) {
  string tt;
  object me = this_player();
  if (!arg || !userp(me))
    return 0;
  if (me->query("kee") < 300)
    return err_msg("你给撞得头破血流了。\n");
  if (!tt = me->query_temp("huanbo/mijing_type"))
    return err_msg("你在浓雾中不辨东西，梆地撞到了石壁上。\n");
  if (arg == "east" || arg == "west"
    || arg == "north" || arg == "south") {
    if (random(5)) {
      message_vision("$N在浓雾中不辨东西，梆地撞到了石壁上。\n", me);
      me->receive_kee("kee", 300);
      COMBAT_D->report_status(me);
    } else {
      message_vision("$N在迷雾中找到一出口，走了出去。\n", me);
      me->move(sprintf(__DIR__ "jiguan-%s", tt));
    }
    return 1;
  }
  return 0;
}
