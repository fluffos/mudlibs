#include <ansi.h>
inherit __DIR__ "r.lpc";

void create_room() {
  set("short", "水底");
  set("long", @LONG
到了一个水中世界。地底风涛之声猛烈，这里却静得出奇。一
群群银色的小鱼在碧绿的池水中游来游去，看似平静，但四面水压
陡然增强，纵是慢慢前行，依然甚耗心力。
LONG);
  set("exits", ([
    "up": __DIR__ "fangtang",
    "south": sprintf(__DIR__ "under%d", 1 + random(10)),
    "west": sprintf(__DIR__ "under%d", 1 + random(10)),
    "east": sprintf(__DIR__ "under%d", 1 + random(10)),
    "north": sprintf(__DIR__ "under%d", 1 + random(10)),
  ]));
}

void quest2(object who, object zhao) {
  object zhou, yi, li;
  remove_call_out("quest2");
  if (!who || !living(who) || !present(who))
    return;
  if (!zhao || !living(zhao) || !present(zhao))
    return;
  zhou = present("zhou qing yun");
  if (zhou && zhou == who->query_temp("huanbo/zhouqingyun")
    && living(zhou)) {
    message_vision(CYN "$N" CYN "对着$n" CYN "惊讶地“啊”了一声。\n" NOR, zhou, zhao);
    message_vision(CYN "$N" CYN "说道：是赵师弟！\n" NOR, zhou);
  }
  li = present("li ying qiong");
  if (li && li == who->query_temp("huanbo/lyq")
    && living(li))
    message_vision(CYN "$N" CYN "说道：果真是赵师弟！\n" NOR, li);
  yi = present("yi jing");
  if (yi && yi == who->query_temp("huanbo/yj")
    && living(yi))
    message_vision(CYN "$N" CYN "说道：赵师弟休慌，吾等来也！\n" NOR, yi);
  message_vision(CYN "$N" CYN "说道：诸位师姐，北面有一个尺八圆洞，将此水雾先推置彼处，再作打算。\n" NOR, yi);
  zhao->set("owner", who);
  who->add_team_member(zhao);
  tell_object(who, WHT "【队伍】" + zhao->query("name") + WHT "加入队伍。\n" NOR);
  zhao->set_temp("in_shuiwu", 1);
  zhao->start_shuiwu_hurt();
}

void quest(object who) {
  object zhao;
  remove_call_out("quest");
  if (!who || !living(who) || !present(who))
    return;
  zhao = who->query_temp("huanbo/zhaoyaner");
  if (!zhao || !living(zhao))
    return;
  if (!present(zhao)) {
    if (!zhao->copy_data(who))
      return;
    zhao->move(this_object());
    tell_room(this_object(), "\n\n只见前方漂浮着一团水雾，水雾中有个寸许的小人，在内苦苦挣扎。\n\n");
  }
  message_vision("$N在水雾中苦苦挣扎，叫道：救命！\n", zhao);
  remove_call_out("quest2");
  call_out("quest2", 3, who, zhao);
}

void init() {
  ::init();
  if (userp(this_player())
    && this_player()->query_temp("huanbochi/zhaoyaner_help")) {
    remove_call_out("quest");
    call_out("quest", 3, this_player());
  }
}
