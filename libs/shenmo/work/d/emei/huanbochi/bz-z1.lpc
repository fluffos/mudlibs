#include <ansi.h>
inherit __DIR__ "r.lpc";

void create_room() {
  set("short", "藏宝室");
  set("long", @LONG
内里乃是一间大约半亩的玉室，室中心横着一条青玉案，
天书、藏珍俱在其中，有的奇宝腾辉，精芒夺目；有的奇书
鸟篆，形制古异。五光十色，观之目眩。
LONG);
  set("exits", ([
    "out": __DIR__ "zhudong-z",
  ]));
  set("objects", ([
    __DIR__ "obj/box1": 1 + random(3),
  ]));
}

void reset() {
  string foo;
  int i;
  object *inv;
  inv = all_inventory();
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->is_fighting())
      return;
    if (!inv[i]->is_character()) {
      tell_room(this_object(), HIC "\n一阵清风将" + inv[i]->query("name") + "卷的无影无踪。。。。\n\n");
      destruct(inv[i]);
    } else if (userp(inv[i])) {
      message_vision("\n$N向外离去。\n\n", inv[i]);
      inv[i]->move(query("exits/out"));
    } else if (!inv[i]->is_huanbo()) {
      tell_room(this_object(), HIC "\n一阵清风将" + inv[i]->query("name") + "卷的无影无踪。。。。\n\n");
      destruct(inv[i]);
    } else if (!inv[i]->query("owner")) {
      foo = inv[i]->query("leave_msg");
      if (!foo || !stringp(foo))
        message_vision("$N将身一滚，化成一溜青光，冲天而去。。\n", inv[i]);
      else message_vision(foo, inv[i]);
      destruct(inv[i]);
    } else if (!environment(inv[i]->query("owner"))
      || !environment(inv[i]->query("owner"))->is_huanbo()) {
      foo = inv[i]->query("leave_msg");
      if (!foo || !stringp(foo))
        message_vision("$N将身一滚，化成一溜青光，冲天而去。。\n", inv[i]);
      else message_vision(foo, inv[i]);
      destruct(inv[i]);
    } else {
      message_vision("\n$N向外离去。\n\n", inv[i]);
      inv[i]->move(query("exits/out"));
    }
  }
  ::reset();
}

int valid_leave(object who, string dir) {
  if (userp(who) && who->is_fighting())
    return notify_fail("你正战斗着。\n");
  who->delete_temp("huanbochi/tiezhu");
  return ::valid_leave(who, dir);
}

void quest(object who) {
  object npc;
  if (!who || !present(who))
    return;
  if (who->is_fighting())
    return;
  npc = present("tie zhu");
  if (npc && !userp(npc)) {
    if (!npc->is_fighting()) {
      if (!npc->copy_data(who))
        return;
      npc->kill_ob(who);
      return;
    }
    return;
  } else {
    npc = new(__DIR__ "npc/tiezhu");
    if (!npc->move(this_object())) {
      destruct(npc);
      return;
    }
    if (!npc->copy_data(who)) {
      destruct(npc);
      return;
    }
    message_vision("一团乌云席卷而来，一道倩影从中杀将出来！\n", who);
    npc->command("say 兀那贼子妄想夺我囊中之物！\n");
    npc->kill_ob(who);
    return;
  }
}

void init() {
  object who = this_player();
  ::init();
  if (userp(who) && !who->query_temp("huanbochi/tiezhu")) {
    remove_call_out("quest");
    call_out("quest", random(3), who);
  }
}
