#include <ansi.h>
#include <room.h>
inherit __DIR__ "r.lpc";

string random_msg();

void create_room() {
  set("short", "甬道");
  set("long", @LONG
这是一个与门一般大小的曲折甬道。顶上一颗颗的金星，
往前直排下去，每隔二三丈远，必有一个，行列甚是整齐，
金光四射，耀眼生花。
LONG);
  set("exits", ([
    "west": __DIR__ "yd-w2",
    "up": __DIR__ "shishi-w1",
  ]));
  create_door("up", "石壁", "down", DOOR_CLOSED);
}

void init() {
  ::init();
  add_action("do_open", "open");
}

int do_open(string arg) {
  return err_msg("什么?\n");
}
