#include <ansi.h>
#include <room.h>
inherit __DIR__"r.lpc";

void create_room()
{
        set("short","甬道");
        set("long",@LONG
一条狭长的甬道，四壁发出微弱的青光。
LONG);  
        set("exits",([
                "southeast"     : __DIR__"yd-e8",
                "north"         : __DIR__"dashishi-e",
        ]));
        set("objects",([
                __DIR__"obj/shixiang-e9" : 1,
        ]));    
        create_door("north", "石门", "south", DOOR_CLOSED);     
}

