#include <ansi.h>
#include <room.h>
inherit __DIR__ "r.lpc";

string *story = ({
  CYN "$N说道：值此建春，万物更新。",
  "$N诚心向圣姑的画像祝告。",
  CYN "$N说道：追思圣姑，厚泽之恩。",
  "$N朝着圣姑的画像低首喃喃自语。",
  CYN "$N说道：虽彼飞升，祭祀宜诚。",
  "$N向着圣姑的画像低声自语。",
  CYN "$N说道：敬奉天人，慰灵于此。",
  "$N朝着圣姑的画像低首喃喃自语。",
  CYN "$N说道：拜而永祚，万世其昌。",
  "$N向着圣姑的画像低声自语。",
  CYN "$N说道：吾等子弟，福泽绵长。",
  "$N朝着圣姑的画像低首喃喃自语。",
  CYN "$N说道：匡正道义，源远流长。",
});

nosave int step = 0;

void create_room() {
  set("short", "东洞主洞");
  set("long", @LONG
转过屏风，屏风后前面一片青玉墙上留有圣姑遗影(ying)。
    像前矗立着一座九尺高的大鼎，非金非玉，色呈翠绿，
光可鉴人，上面都是朱文符箓。
LONG);
  set("exits", ([
    "out": __DIR__ "zhudong-e",
    "east": __DIR__ "liandan-shi",
  ]));
  set("item_desc", ([
    "ying": "此乃圣姑的画像，云鬟端正，姿容美秀，略似道姑打扮，形态装束，均甚飘逸。\n若是置于十万大山的民间，如此端庄圣洁的画像，倒也是百姓诚心祝告的对象。\n",
  ]));
  set("objects", ([
    __DIR__ "obj/dading": 1,
  ]));
}

void zhouqy(object who) {
  remove_call_out("zhouqy");
  if (!who || !living(who) || !present(who))
    return;
  who->command("daogao ying");
}

void init() {
  ::init();
  if (living(this_player()))
    this_player()->set_temp("huanbochi/dading", 0);
  add_action("do_daogao", ({ "daogao", "pray" }));
  if (!userp(this_player())
    && this_player()->query("id") == "zhou qing yun") {
    remove_call_out("zhouqy");
    call_out("zhouqy", 1 + random(3), this_player());
  }
}

mixed query_story_message(int step) {
  return step < sizeof(story) ? story[step] : 0;
}

void go_on_process(object who) {
  if (!who || !present(who) || !living(who)
    || who->query_temp("huanbochi/dading_daogao"))
    return;
  call_out("start_daogao", 3 + random(5), who);
}

void start_daogao(object who) {
  mixed line;
  string prompt;
  object ding;
  if (!who || !living(who) || !present(who)
    || who->query_temp("huanbochi/dading_daogao"))
    return;

  go_on_process(who);
  line = query_story_message(step);
  if (!line) {
    message_vision("\n$N祝告完毕，长呼一口气，恭恭敬敬的站了起来。\n", who);
    who->delete_temp("daogaoing");
    who->set_temp("huanbochi/dading_daogao", 1);
    ding = present("da ding");
    if (ding)
      message_vision(ding->query("name") + "上闪了几闪。\n", who);
    return;
  }
  step++;
  message_vision(line + NOR "\n", who);
  go_on_process(who);
}

void daogaoing(object who) {
  if (!who || !present(who) || !living(who))
    return;
  if (who->query_temp("huanbochi/dading_daogao")) {
    message_vision("\n$N祝告完毕，长呼一口气，恭恭敬敬的站了起来。\n", who);
    who->delete_temp("daogaoing");
  }
  step = 0;
  start_daogao(who);
}

int do_daogao(string arg) {
  object me = this_player();

  if (!arg || (arg != "ying" && arg != "画像"))
    return err_msg("你要向什么祝告？\n");
  if (me->query_temp("daogaoing"))
    return err_msg("你诚心向圣姑的画像祝告。\n");

  message_vision("$N正衣弹冠，俯下身诚心向圣姑的画像祝告。\n", me);
  me->set_temp("daogaoing", 1);
  call_out("daogaoing", random(5), me);
  return 1;
}

void npc_attack(object who) {
  object yuan, niang;
  remove_call_out("npc_attack");
  if (!who || !living(who)
    || !present(who)
    || who->is_fighting())
    return;
  yuan = present("yuan ling");
  if (yuan && !userp(yuan)) {
    if (!living(yuan))
      destruct(yuan);
  }
  if (!yuan || userp(yuan))
    yuan = new(__DIR__ "npc/yuanling");
  if (!yuan->copy_data(who)) {
    destruct(yuan);
    return;
  } else {
    yuan->move(this_object());
    yuan->kill_ob(who);
  }

  niang = present("jintou xianniang");
  if (niang && !userp(niang)) {
    if (!living(niang))
      destruct(niang);
  }
  if (!niang || userp(niang))
    niang = new(__DIR__ "npc/jintou-xianniang");
  if (!niang->copy_data(who)) {
    destruct(niang);
    return;
  } else {
    niang->move(this_object());
    niang->kill_ob(who);
  }
}

int valid_leave(object me, string dir) {
  if (userp(me) && (dir == "east" || dir == "north")) {
    if (!me->query("huanbochi/pingfeng-save"))
      return notify_fail("忽听一个少女喝道：“来人慎行，免遭不测！”\n");
    if (!me->query_temp("huanbochi/yuanling")
      || !me->query_temp("huanbochi/jintouxian")) {
      remove_call_out("npc_attack");
      call_out("npc_attack", 1 + random(3), me);
      return notify_fail("两个模糊的身影挡住了你的去路。\n");
    }
  }
  return ::valid_leave(me, dir);
}
