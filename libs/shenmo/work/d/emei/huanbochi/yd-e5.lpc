#include <ansi.h>
inherit __DIR__ "r.lpc";

void create_room() {
  set("short", "甬道");
  set("long", @LONG
空荡荡的一条甬道，深不见底。
LONG);
  set("exits", ([
    "north": __DIR__ "yd-e6",
    "south": __DIR__ "yd-e4",
  ]));
}

int valid_leave(object who, string dir) {
  if (!userp(who) && dir == "south")
    who->set_temp("to_open", 1);
  return ::valid_leave(who, dir);
}
