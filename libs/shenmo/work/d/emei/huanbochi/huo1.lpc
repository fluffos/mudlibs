#include <ansi.h>
#include <room.h>
inherit __DIR__ "huo.lpc";

void create_room() {
  set("short", HIR "火之道" NOR);
  set("long", @LONG
这狭长甬道之内遍布三界之火，人行走其中只感到浑身
燥热难当。    
LONG);
  set("exits", ([
    "east": (: random_exit :),
    "west": __DIR__ "shishi-w2",
  ]));
  create_door("west", "石壁", "east", DOOR_CLOSED);
  set("wuxing", "火");
  set("damage", 50);
  set("damage_msg", (: fire_msg :));
  set("no_lianhua", 1);
  set("death_msg", "在「十万火鸦阵」中化为焦炭！\n");
  set("num", random(3));
}

int valid_leave(object who, string dir) {
  string file;
  object guai;
  if (dir == "east"
    && random(who->query_kar()) > 30
    && !who->is_fighting() && query("num") > 0) {
    file = ({ "huoguo", "huoniao", "huoshu", })[random(3)];
    add("num", -1);
    guai = new(__DIR__ "npc/" + file);
    guai->move(this_object());
    guai->kill_ob(who);
    return notify_fail("火光一闪，万千火星居然聚成一只" + guai->query("name") + "。\n");
  }
  return ::valid_leave(who, dir);
}


varargs void do_close(object me) {
  remove_call_out("do_close");
  close_door("west");
  tell_room(this_object(), "风声起，大火平地里一卷，看不清来时的方向。\n", me);
  if (me && present(me, this_object())) {
    remove_call_out("do_open");
    call_out("do_open", 10, me);
  }
}

void do_open(object me) {
  remove_call_out("do_open");
  if (!me || !present(me, this_object())) return;
  if (open_door("west")) {
    message_vision("$N念动真言，聚起无上法力，双手缓缓抵住石壁。\n", me);
    message_vision("火光一卷，现出一道大门。\n", me);
  }
  remove_call_out("do_close");
  call_out("do_close", 10, me);
}

void init() {
  object me = this_player();
  if (me->query("id") == "zhou qing yun"
    && !userp(me)) {
    message_vision(CYN "$N" CYN "说道：看来此处乃「十万火鸦阵」。\n" NOR, me);
    remove_call_out("do_open");
    call_out("do_open", 30, me);
  }
}
