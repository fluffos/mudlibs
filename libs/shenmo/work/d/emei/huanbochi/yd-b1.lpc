#include <ansi.h>
inherit __DIR__"r.lpc";

void create_room()
{
        set("short","甬道");
        set("long",@LONG
一条狭长的甬道，地势逐渐向下，头顶开始出现一些大
小不一的石乳。
LONG);  
        set("exits",([
                "down"          : __DIR__"yd-b2",
                "southeast"     : __DIR__"dashishi-e",
        ]));    
}

int valid_leave(object who,string dir)
{
        if( !userp(who) && dir=="southeast" )
                who->set_temp("dashishi_open",1);
        return ::valid_leave(who,dir);
}       
