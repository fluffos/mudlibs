#include <ansi.h>
inherit ITEM;
void create()
{
    set_name(HIW"萧秋水传奇"NOR, ({ "xiao book" }) );
            set("no_put", 1);
            set("value", 0);
    set_weight(1);
    if( clonep() )
            set_default_object(__FILE__);
    else {
	        
            set("unit", "本");
            set("material", "paper");
            set("long", "一本由神书合并成的卷册，你可以用(chayue)来查阅它。\n");
          }

    setup();
}
void init()
{
   add_action("do_cha","chayue");
}
int do_cha(string arg)
{
	object me,ob;
        int exp,pot,score,i;
	me =this_player();
        if (!id(arg)) 
        return notify_fail("你要查什么？\n"); 
        exp = 60000+random(40000);
	             pot = exp/4;
        score = 60000+random(40000);
/*              me->add("combat_exp",exp);
             me->add("potential",pot);
             me->add("daoxing",score); */
                i=random(12);
	     message_vision("$N仔细地查阅了一遍"+this_object()->query("name")+"。\n"NOR, me);
tell_object(me,HIW"你被奖励了：\n" +
             chinese_number(exp) + "点实战经验\n"+
             chinese_number(pot) + "点潜能\n" +
            chinese_number(score)+"天道行\n"NOR);
        if (i>10) {
        if ( me->query("per")< 35)
        {
	me->add("per",1);tell_object(me,HIM"以及一点容貌。\n"NOR);
        }
	}
        else if (i>9) {
        if ( me->query("cor")< 35)
        {
        me->add("cor",1);tell_object(me,HIM"以及一点胆识。\n"NOR);
	}
	}
        else if(i>8)    {
        if ( me->query("str")< 35)
	{
	me->add("str",1);tell_object(me,HIC"以及一点臂力。\n"NOR);
	}
	}
        else if(i>7)    {
        if ( me->query("int")< 35)
	{
	me->add("int",1);tell_object(me,HIR"以及一点悟性。\n"NOR);
	}
	}
        else if(i>6)    {
        if ( me->query("con")< 35)
	{
	me->add("con",1);tell_object(me,HIM"以及一点根骨。\n"NOR);
	}
	}
        else if(i>5)    {
        if ( me->query("kar")< 35)
	{
	me->add("kar",1);tell_object(me,HIM"以及一点福缘。\n"NOR);
	}
	}
        else if(i>4)    {
        if ( me->query("cps")< 35)
        {
        me->add("cps",1);tell_object(me,HIM"以及一点定力。\n"NOR);
        }
        }
        else if(i>3)    {
        if ( me->query("spi")< 35)
        {
        me->add("spi",1);tell_object(me,HIM"以及一点灵性。\n"NOR);
        }
        }
        else if(i>2)    {
        if ( me->query("dgbang_ask")==1 && me->query("dgbang_agree")==0 && random(me->query("kar"))>25 )
        {
        me->set("dgbang_ask",0);tell_object(me,HIM"你似乎从萧秋水传奇中悟出了关于打狗棒法的一些窍门。\n"NOR);
        }
        }
        else if(i>1)    {
        if ( me->query("xlzhang_ask")==1 && me->query("xlzhang_agree")==0 && random(me->query("kar"))>35 )
        {
        me->set("xlzhang_ask",0);tell_object(me,HIM"你似乎从萧秋水传奇中悟出了关于降龙十八掌的一些窍门。\n"NOR);
        }
        }
        else if(i>0)    {
        if ( me->query("chshjue_ask")==1 && me->query("chshjue_agree")==0 && random(me->query("kar"))>35 )
        {
        me->set("chshjue_ask",0);tell_object(me,HIM"你似乎从萧秋水传奇中悟出了关于长生诀的一些窍门。\n"NOR);
        }
        }
        else {
        if ( me->query("wuhu_ask")==1 && me->query("wuhu_agree")==0 && random(me->query("kar"))>25 )
        {
        me->set("wuhu_ask",0);tell_object(me,HIM"你似乎从萧秋水传奇中悟出了关于五虎断门刀的一些窍门。\n"NOR);
        }
        }
          log_file("static/record",sprintf("%s(%s)时间 %s %s\n",me->name(1), geteuid(me),this_object()->name(1),ctime(time()) ) );
	destruct(this_object());
return 1;
}

