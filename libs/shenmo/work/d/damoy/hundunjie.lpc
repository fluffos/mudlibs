#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIG "混沌界" NOR);
  set("long", @LONG
这里是三界外的混沌世界，一眼望不到边际的黑暗世界。到处都是漆黑
一片，只在入口处漂浮着一颗巨大无比的树灯塔，照亮这入口处的些许
景物。在灯光照亮范围之外，有狂风呼啸，似乎只有跟着狂风刮过的方
向才能寻到出路。

=== 铭志，魂若残，难得真神，须舍魂而成生道，奉己修真行 
=== 铭志，生若残，难得真生，须舍生而成人道，奉己修真行 
=== 铭志，人若残，无生，无魂，无神，无道，当渡轮回，奉己修真行
=== 铭志，道分道再分道，无道可自成一道，立千道之上，众生皆为门徒，得真道，奉己修真行
=== 铭志，众灵皆困天道，挣扎苦海，难舍尘缘，众灵须舍弃执念，得七界之外，奉至修真行
=== 铭志，天道不仁，灭天之道，取天之血，断天之翼，融天之魂，得道今生，奉至修真行
=== 铭志，众魂常囚落海，难度轮回，众魂皆为门徒可解落海，奉至修真行
=== 铭志，捆天之命，驾天之躯，吾为天道，奉至修真行
=== 铭志，所困亦未困，生死，因果，轮回，欲得真道者，弃生死，了因果，渡轮回，奉至修真行

LONG);
  set("item_desc", ([
    "tree": GRN "\n这是一棵巨大古老的树灯塔，周身散发着"
    "无尽的光芒。\n" NOR,
  ]));

  //set("objects", ([
  //        __DIR__"npc/shoutalaoren" : 1,
  // ]));

  set("exits", ([
    "out": "/d/city/center",
  ]));

  set("outdoors", 1);

  set("no_fight", 1);
  setup();

}
