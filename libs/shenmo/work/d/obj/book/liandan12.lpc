inherit ITEM;
inherit F_UNIQUE;

void create() {
  set_name("〖淮南万毕术〗", ({ "liandan book", "book" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "古人关于黄白之术的典籍。\n");
    set("value", 0);
    set("material", "paper");
    set("skill", ([
      "name": "liandan",
      "exp_required": 100,
      "sen_cost": 20,
      "difficulty": 20,
      "max_skill": 300,
    ]));
  }
}

void init() {
  add_action("do_du", ({ "du", "study" }));
}

int do_du(string arg) {
  object me = this_player();

  if (!arg || !id(arg))
    return 0;
  if (me->query_skill("liandan", 1) < 200) {
    write("你的" + to_chinese("liandan") + "修为不够，看不懂书内的奥秘。\n");
    return 1;
  }
  return 0;
}
