//Cracked by Roath
// 转世特技----超级无字经
// by windy
inherit ITEM;

void create()
{
  set_name("超级无字经", ({"super wuzijing", "book", "jing", "shu"}));
  set_weight(1000);
  if( clonep() )
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "
我佛慈悲，只渡有缘。
\n");
    set("material", "paper");
    set("value", 0);
  }
}

void init()
{
  if (!wizardp(this_player())) {
    set("no_get", 1);
    set("no_drop",1);
    set("no_sell",1);
  }
  add_action("do_read", "read");
}

int do_read(string arg)
{
  object ob, me=this_player(),book=this_object();
  int sen_cost, gain,lev,exp;

  ob = me->query_temp("weapon");
  if( !book->id(arg) ) return notify_fail("你要读什么？\n");
  if( environment(book)!=me ) return notify_fail("书要拿起来读。\n");
  if(me->is_busy()) return notify_fail("你现在忙着呢，还是等静下心来再读书吧！\n");
  if(me->is_fighting()) return notify_fail("临阵磨枪可来不及啦！\n");
    if( !objectp(ob) ) return notify_fail("你需要装备相关的装备才能读。鸿儒者请装备一把琴。\n");
  if((int)me->query("spsk")!=15 && (int)me->query("spsk")!=16 && (int)me->query("spsk")!=17 && (int)me->query("spsk")!=18 && (int)me->query("spsk")!=19 && (int)me->query("spsk")!=20 && (int)me->query("spskk")!=1)
    return notify_fail("你拿起书仔细读了半天，但怎么也读不懂。\n");
  if((int)me->query_skill("sword",1)>1000 || (int)me->query_skill("blade",1)>1000 || (int)me->query_skill("whip",1)>1000 || (int)me->query_skill("stick",1)>1000 || (int)me->query_skill("staff",1)>1000 || (int)me->query_skill("unarmed",1)>1000 || (int)me->query_skill("literate",1)>1000)
    return notify_fail("你在这方面已经很有造诣，这本书不会让你长进多少。\n");
  sen_cost=10+(40-(int)me->query_int())+(35-(int)me->query_kar())+(int)lev/5;
if (sen_cost<=20)    sen_cost=20;
  if( (int)me->query("sen")<sen_cost )
    return notify_fail("你现在头晕脑胀，该休息休息了。\n");	
	me->receive_damage("sen", sen_cost);
  
  gain = (int)me->query_skill("literate",1)*5;
  gain -= random(me->query_int());
  gain +=random(me->query_kar());
  if(gain < 0) gain=0;
if (me->query("spsk")==15 && (string)ob->query("skill_type") == "sword")
  me->improve_skill("sword", gain);
if (me->query("spsk")==16 && (string)ob->query("skill_type") == "blade")
  me->improve_skill("blade", gain);
if (me->query("spsk")==17 && (string)ob->query("skill_type") == "whip")
  me->improve_skill("whip", gain);
if (me->query("spsk")==18 && (string)ob->query("skill_type") == "stick")
  me->improve_skill("stick", gain);
if (me->query("spsk")==19 && (string)ob->query("skill_type") == "staff")
  me->improve_skill("staff", gain);
if (me->query("spsk")==20 && (string)ob->query("skill_type") == "unarmed")
  me->improve_skill("unarmed", gain);
if (me->query("spskk")==1 && (string)ob->query("skill_type") == "qin")
  me->improve_skill("literate", gain);

  message_vision("$N正专心地研读"+book->query("name")+"。\n", me);

  return 1;
}





