#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIY "宝箱" NOR, ({ "box" }));
  set_weight(5000000);
  set_max_encumbrance(8000);
  set_max_items(5);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "这是一个宝箱，打开可能会有惊喜哦。\n");
    set("value", 50);
  }
}

void init() {
  add_action("do_open", "open");
}

int do_open(string arg) {
  int i, type;
  object ob, me = this_player();

  if (!arg || !id(arg))
    return 0;

  if (me->is_busy()) {
    write("你现在正忙着呢。\n");
    return 1;
  }
  me->start_busy(1);
  type = query("maze/box");
  if (type <= 0) {
    if (random(100) > 90) {
      write("你得到了1000点武学经验。\n");
      me->add("combat_exp", 1000);
    } else if (random(100) > 91) {
      write("你得到了一年的道行。\n");
      me->add("daoxing", 1000);
    } else if (random(100) > 92) {
      write("你得到了黄金百两。\n");
      ob = new("/obj/money/gold");
      ob->set_amount(100);
      ob->move(me);
    }
    //******************************        
    else if (random(100) > 93) {
      switch (random(20)) {
        case 1:
          write("你的先天福缘增加了1点。\n");
          me->add("kar", 1);
          break;
        case 8:
          write("你的先天容貌增加了1点。\n");
          me->add("per", 1);
          break;
        case 16:
          write("你的先天根骨增加了1点。\n");
          me->add("con", 1);
          break;
        case 5:
          write("你的先天定力增加了1点。\n");
          me->add("cps", 1);
          break;
        case 10:
          write("你的先天灵性增加了1点。\n");
          me->add("spi", 1);
          break;
        case 15:
          write("你的先天悟性增加了1点。\n");
          me->add("int", 1);
          break;
        case 7:
          write("你的先天胆识增加了1点。\n");
          me->add("cor", 1);
          break;
        case 14:
          write("你的先天体格增加了1点。\n");
          me->add("str", 1);
          break;
        default:
          write("你什么也没有得到。\n");
          break;

      }

    }
    //******************************        
    else if (random(100) > 90) {
      switch (random(8)) {
        case 0:
          write("你的后天福缘增加了1点。\n");
          me->add("gift_modify/kar", 1);
          break;
        case 1:
          write("你的后天容貌增加了1点。\n");
          me->add("gift_modify/per", 1);
          break;
        case 2:
          write("你的后天根骨增加了1点。\n");
          me->add("gift_modify/con", 1);
          break;
        case 3:
          write("你的后天定力增加了1点。\n");
          me->add("gift_modify/cps", 1);
          break;
        case 4:
          write("你的后天灵性增加了1点。\n");
          me->add("gift_modify/spi", 1);
          break;
        case 5:
          write("你的后天悟性增加了1点。\n");
          me->add("gift_modify/int", 1);
          break;
        case 6:
          write("你的后天胆识增加了1点。\n");
          me->add("gift_modify/cor", 1);
          break;
        case 7:
          write("你的后天体格增加了1点。\n");
          me->add("gift_modify/str", 1);
          break;
      }

    } else write("你什么也没有得到。\n");
    destruct(this_object());
    return 1;
  }
  ob = 0;
  switch (type) {
    case 2:  // 仙丹等物品 
      switch (random(8)) {
        case 0: ob = new("/d/city/obj/mihoutao"); break;
        case 1: ob = new("/d/obj/drug/jiedu"); break;
        case 2: ob = new("/d/city/obj/xieyao"); break;
        case 3: ob = new("/d/obj/drug/yaohe"); break;
        case 4: ob = new("/d/obj/drug/yanlei"); break;
        case 5: ob = new("/d/obj/drug/xianjiu"); break;
        case 6: ob = new("/d/obj/drug/xiantao"); break;
        case 7: ob = new("/d/obj/drug/xiaodan"); break;
      }
      break;
    case 3:  // 金块等物品 
      ob = new("/obj/money/jinbi");
      ob->set_amount(1 + random(2));
      break;
    case 4:  // 黄金 
      ob = new("/obj/money/gold");
      ob->set_amount(50 + random(60));
      break;
    case 5: break;                  // 任务物品 
    case 6: break;                  // 英雄商店出售的物品 
    case 7: break;                  // 降低NPC的武功 
    default: write("你什么也没有得到。\n");
  }
  if (ob) {
    if (ob->move(me))
      write("你得到了" + ob->short() + "。\n");
    else destruct(ob);
  }
  destruct(this_object());
  return 1;
}
