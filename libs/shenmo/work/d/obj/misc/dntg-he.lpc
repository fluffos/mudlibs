#include <ansi.h>
inherit ITEM;

void create() {
  set_name(WHT "书盒" NOR, ({ "shu he", "he" }));
  set_weight(5000);
  set_max_encumbrance(5000);
  if (clonep()) {
    object a1, a2, a3, a4, a5, a6, a7, a8, a9, a10;
    seteuid(getuid());
    if (a1 = new("/d/obj/books-nonskill/dntg1"))
      a1->move(this_object());
    if (a2 = new("/d/obj/books-nonskill/dntg2"))
      a2->move(this_object());
    if (a3 = new("/d/obj/books-nonskill/dntg3"))
      a3->move(this_object());
    if (a4 = new("/d/obj/books-nonskill/dntg4"))
      a4->move(this_object());
    if (a5 = new("/d/obj/books-nonskill/dntg5"))
      a5->move(this_object());
    if (a6 = new("/d/obj/books-nonskill/dntg6"))
      a6->move(this_object());
    if (a7 = new("/d/obj/books-nonskill/dntg7"))
      a7->move(this_object());
    if (a8 = new("/d/obj/books-nonskill/dntg8"))
      a8->move(this_object());
    if (a9 = new("/d/obj/books-nonskill/dntg9"))
      a9->move(this_object());
    if (a10 = new("/d/obj/books-nonskill/dntg10"))
      a10->move(this_object());
    set_default_object(__FILE__);
  } else {
    set("unit", "个");
    set("long", "一个大闹天宫的攻略合集，正版游戏才有哦。\n");
    set("value", 10000);
    set("no_sell", 1);
  }
}

int is_container() { return 1; }
