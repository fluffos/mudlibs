#include <ansi.h>
inherit ITEM;
#include "/cmds/std/valid_move.h"

void create() {
  set_name(HIY "募捐箱" NOR, ({ "mujuan xiang", "box", "xiang" }));
  set_weight(10000000);
  set("unit", "个");
  set("long", "一只大大的募捐箱，如果你想帮助新人，就在里面放(donate)些钱吧。
玩家可以从里面拿出(getout)钱来用。\n");
  set("no_get", "这么重的箱子你拿不起来。\n");
  setup();
}

void init() {
  add_action("do_donate", "donate");
  add_action("do_get", "getout");
}

int do_donate(string arg) {
  object me;
  int num;
  me = this_player();
  if (!valid_move(me))
    return notify_fail("你正忙着呢。\n");
  if (!arg || sscanf(arg, "%d", num) != 1)
    return notify_fail("格式为：donate <数量>   单位为黄金。\n");
  if (num < 1)
    num = 1;
  if (me->query("balance") < num * 10000)
    return notify_fail("你钱庄里的钱不够捐的。\n");
  message_vision("$N向$n内丢入了" + MONEY_D->money_str(num * 10000) + "。\n", me, this_object());
  me->start_busy(1);
  me->add("balance", -num * 10000);
  this_object()->add("number", num);
  return 1;
}

int do_get(string arg) {
  object gold, me;
  int num;
  me = this_player();
  if (!arg)
    return notify_fail("格式为：getout <数量>   单位为黄金。\n");
  if (!valid_move(me))
    return notify_fail("你正忙着呢。\n");
  if (sscanf(arg, "%d", num) != 1)
    return notify_fail("格式为：getout <数量>   单位为黄金。\n");
  if (num < 1) num = 1;
  if (num > query("number") / 2)
    return notify_fail("你太贪心了吧。\n");
  if (time() < query(query_ip_number(me)) + 3600) {
    message(
      "channel:rumor",
      sprintf(HIM "【千里眼】某人：听说" HIY " %s " HIM "频繁盗用募捐箱中的钱财，为天雷劈中了！\n" NOR, me->query("name")),
      users()
    );
    me->unconcious();
    return 1;
  }
  gold = new("obj/money/gold");
  gold->set_amount(num);
  if (!gold->move(me)) {
    destruct(gold);
    return notify_fail("你身上装不下这么多钱。\n");
  }
  this_object()->add("number", -num);
  message_vision("$N从$n中提取了" + MONEY_D->money_str(num * 10000) + "。\n", me, this_object());
  me->start_busy(1);
  this_object()->set(query_ip_number(me), time());
  return 1;
}

string long() {
  string str = query("long");
  int num = query("number");
  if (!num || num <= 0)
    str += "\n里面暂时没有募捐。\n";
  else str += "\n里面有" + MONEY_D->money_str(num * 10000) + "的募捐款。\n";
  return str;
}
