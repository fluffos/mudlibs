//Cracked by Roath
#include <ansi.h>
inherit ITEM;
inherit F_UNIQUE;

void create() 
{
        set_name(HIR"生死牌"NOR, ({"shengis pai","jinpai","pai"}));
        set_weight(200);
        set("value",1000000);
        set("no_sell",1);
        set("unit", "面");
        set("long", "一面金牌，上面刻着“生死之战 不死不休”八个字。\n
你可以凭这面金牌向其他玩家挑战(challenge)！\n");
        setup();
}

void init() 
{
        add_action("do_challenge","challenge");
}

int do_challenge(string arg) 
{
        object me=this_player();
        object who,old;
        
        if( !userp(me) ) return 0;
        if( (!arg) || (!who=find_player(arg))) 
                return notify_fail("你要向谁挑战？\n");
/*
        if( ( !wizardp(me) && wizardp(who) )
         || ( !wizardp(who) && wizardp(me) ) ) 
                return notify_fail("你要向谁挑战？\n");
*/
        if( who==me) 
                return notify_fail("挑战自我，有志气！\n");
        old = me->query_temp("xiuluo/challenge");
        if( who==old)   
                return notify_fail("你已经在向他挑战了。\n");
        if( old) 
        {
                write("你估计打不过"+old->query("name")+"，决定不和他打了。\n");
                old->delete_temp("xiuluo/being_challenged");
                tell_object(old,me->query("name")+"等你不到，以为你不敢去，决定不和你打了。\n");
        }
        message_vision("$N想向"+who->query("name")+RANK_D->query_respect(who)+"来一场生死之战以解决彼此间的恩怨。\n",me);
        tell_object(who,me->query("name")+"告诉你："+RANK_D->query_rude(who)+"，有没有胆子和我打上一架(accept)？！我在擂台等你！\n");
        me->set_temp("xiuluo/challenge",who);
        who->set_temp("xiuluo/being_challenged",me);
        return 1;
}


