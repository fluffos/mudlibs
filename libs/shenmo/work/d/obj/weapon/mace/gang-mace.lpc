#include <weapon.h>
#include <ansi.h>
inherit MACE;

void create() {
  set_name("水磨钢鞭", ({ "gang bian", "mace", "bian", "jian" }));
  set_weight(8000);
  if (clonep()) set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("long", "
自太宗建凌宵阁起，民间便纷纷仿制朝中元老所用兵器。这把乃是仿制" HIY "开国公"
      NOR "尉迟爷的那把" YEL "虎尾鞭" NOR "，鞭长三尺三寸，重八斤八两，精钢水磨而成。\n" NOR);
    set("material", "iron");
    set("value", 15000);
    set("wield_msg", "$N操起一根$n，在手里掂了掂重量。\n");
    set("unwield_msg", "$N将$n别回腰间。\n");
  }
  init_mace(80);
  setup();
}
