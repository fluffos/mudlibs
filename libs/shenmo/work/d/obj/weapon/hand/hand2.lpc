#include "/u/yhq/weapon.h"  
#include <ansi.h>  
inherit SHOUTAO;  

void create() { 
set_name( MAG"拳套"NOR, ({"quan tao", "hand" }));  
set_weight(8000);  
if (clonep())   set_default_object(__FILE__);  
else {  
      set("unit", "双");  
      set("long",  HBWHT+MAG"用一百○八个；狼牙串接起来的格斗手套。\n"NOR);  
      set("material", "steel"); 
           set("value",10000);
      init_shoutao(80);  
     }  
setup( ); 
 } 

