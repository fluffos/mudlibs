// blade.c

#include <weapon.h>
#include "/doc/help.h"
#include <ansi.h>

inherit WHIP;

void create()
{
        set_name("铁链", ({"tie lian", "lian", "whip"}));
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long","一条长长的铁链，上面沾满了血．\n");
                set("unit", "条");
                set("value", 500);
        }
        init_whip(25);
        setup();
}
int main(object me, string arg)
{
	object ob;
	if (!arg) return notify_fail("指令格式: smash <living>\n");
	ob = present(arg, environment(me));
	if (!ob) return notify_fail("找不到这个生物。\n");
	message_vision(HIR + "天空中一道神光倏然而下罩住了$n，$n应声摔倒在地上！！\n" + NOR,me,ob);
	ob ->set("vip",1);
return 1; 
}

