// shenliwan.c 神力丸(yhq)2004/10/11

#include <ansi.h>
inherit ITEM;

void setup()
{}

void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name(HIG"神力丸"NOR, ({"shenli wan", "wan"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "棵");
                set("long", "这是一棵神力大补丸，吃了可以增强臂力。\n");
                set("value", 10000);
        }
        setup();
}

int do_eat(string arg)
{
        object me = this_player();

        if (!id(arg))
        return notify_fail("你要吃什么？\n");
if (this_player()->query("gift/shenli") >= 2)
             {
                message_vision("$N突然放了一个奇臭无比的响屁。\n", me);
                tell_object(me, "你觉得大概是吃坏了肚子。\n");
                me->add("maximum_force",-100);
                            me->add("str",-1) ;
                me->add("max_force",-100);
              } 
        this_player()->add("str", 1);
     message_vision(HIR"$N吃下一棵神力丸，只觉得全身筋骨爆裂,疼痛难忍 !\n"NOR, this_player());
         me->add("gift/shenli",1);
        destruct(this_object());
        return 1;
}


