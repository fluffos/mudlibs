// by yhq 2004-10-28

#include <ansi.h>
inherit ITEM;
void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIR "朱" HIG "睛" HIW "冰" HIC "蟾" NOR, ({ "zhujing bingchan", "bingchan", "chan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", "这是一千年难得一见的朱睛冰蟾，通体透明，惟眼呈赤色，能解百毒。\n");

    set("no_drop", "这贵重的药，你能舍得扔？\n");
    set("value", 10000000);
  }
  setup();
}

int do_eat(string arg) {
  object me = this_player();
  if (!id(arg))
    return notify_fail("你要吃什么？\n");

  message_vision(HIG "$N吃下一只朱睛冰蟾，只觉一股清香沁入心肺，顿时灵台一片空明，神意清爽！\n" NOR, this_player());
  if (me->query_condition("double_ice_poison"))
    me->apply_condition("double_ice_poison", 0);
  if (me->query_condition("ice_poison"))
    me->apply_condition("ice_poison", 0);
  if (me->query_condition("wudu"))
    me->apply_condition("wudu", 0);
  if (me->query_condition("hell_zhua"))
    me->apply_condition("hell_zhua", 0);
  if (me->query_condition("eyeill"))
    me->apply_condition("eyeill", 0);
  if (me->query_condition("ice_fire_poison"))
    me->apply_condition("ice_fire_poison", 0);
  if (me->query_condition("dashouyin"))
    me->apply_condition("dashouyin", 0);
  if (me->query_condition("moon_poison"))
    me->apply_condition("moon_poison", 0);
  if (me->query_condition("xiangsi"))
    me->apply_condition("xiangsi", 0);
  if (me->query_condition("snake_poison"))
    me->apply_condition("snake_poison", 0);
  if (me->query_condition("qishang_poison"))
    me->apply_condition("qishang_poison", 0);
  if (me->query_condition("ziwuliuzhu_poison"))
    me->apply_condition("ziwuliuzhu_poison", 0);
  destruct(this_object());
  return 1;
}
