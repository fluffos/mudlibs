//白发药,age.c增加Mud_age，为了修复吃内丹减少Mud_age而出现的bug ID
//snowtu/2004/08/28

#include <ansi.h>
inherit COMBINED_ITEM;
void create() {
  set_name("白发膏", ({ "baifa  gao", "gao" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("base_unit", "盒");
    set("unit", "些");
    set("long", "这是一盒用天下妇人九千九百九十九颗泪水调制而成的伤心药，\n据说涂抹(mo)在脸上会使人年华早逝，没事还是不要乱抹的好。\n");
    set("value", 1000);
    set("drug_type", "良药");
  }
  set_amount(1);
  setup();
}

void init() {
  add_action("do_mo", "mo");
}

int do_mo(string arg) {
  object me = this_player();
  object yao = this_object();
  string *msgs = ({
    "$N扳开$n将其涂抹在自己的脸上。\n",
    "$N哭的昏天黑地，将$n拼命的往脸上涂，希望自己早死。\n",
    "$N哭的昏天黑地，将$n拼命的往脸上涂，希望死得快一点。\n",
    "$N哭的昏天黑地，拼命将$n往脸上涂，希望死得快一点。\n",
    "$N哭的昏天黑地，拼命将$n往脸上涂，希望死得快一点。\n",
    "$N将$n拼命的往脸上涂，希望能早熟一点。\n",
    "$N将$n拼命的往脸上涂，希望成熟一点。\n",
  });

  if (me != environment())
    return 0;
  if (!id(arg)) return 0;
  message_vision(msgs[random(sizeof(msgs))], me, yao);
  me->add("mud_age", 10000);
  me->add("mud_age_time", 1);
  me->save();
  yao->add_amount(-1);
  return 1;
}
