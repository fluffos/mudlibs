#define MAX_VERIFY   6

int do_enter(string arg);
void confirm_again(object who);

int do_huifu(string arg)
{
    object me = this_player();

    if (me->query_temp("digcao")==1)  return notify_fail("什么？\n");
/*
    if ( MAX_VERIFY < me->query_temp("quest/vf/huifu_num") )
    {
        tell_object(me, "想利用bug?\n");
        return 1;
    }
*/

    if ( !arg || "" == arg )
    {
        tell_object(me, "回答错误。\n");
        return 1;
    }

    if ( arg != me->query_temp("quest/vf/answer") )
    {
        if ( MAX_VERIFY <= me->query_temp("quest/vf/huifu_num") )
        {
            me->set_temp("quest/vf/huifu_num", MAX_VERIFY + 1);
            me->delete_temp("quest/vf/answer");
            tell_object(me, "连续回答错误，真可惜!\n");
            return 1;
        }
        else
        {
            confirm_again(me);
            return 1;
        }
    }

    me->set_temp("quest/vf/huifu_num", 0);
    me->delete_temp("quest/vf/answer");
tell_object(me, "回答正确,可以挖走你的琼草了!\n");
    me->set_temp("quest/vf/valid", 1);

    return 1;
}

void confirm_again(object who)
{
    mapping result;

    result = "/adm/daemons/text2pic_d"->random_chinese(4);

    who->set_temp("quest/vf/answer", result["rand_str"]);
    who->add_temp("quest/vf/huifu_num", 1);

    tell_object(who, result["output"] + "\n\n");
    tell_object(who, "请vf输入以下汉字、数字、或运算结果，注意小数位直接舍去。\n");

}
