// blade.c

#include <ansi.h>
#include <weapon.h>

inherit BLADE;

void create()
{
        set_name( HIC "七煞鬼刀" NOR, ({ "gui dao", "dao" }) );
	set_weight(4000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
                set("value", 1000);
		set("material", "iron");
                set("long", "这是钟馗惯用的大刀，充满一身鬼气，阴森森刀光逼人。\n");
                set("wield_msg", "$N抽出一把阴森森的$n握在手中，鬼笑一声，嘿！。\n");
		set("unequip_msg", "$N将手中的$n插入腰间的刀鞘。\n");
//                                set("no_sell",1);
//                                set("no_drop","去垃圾堆丢吧，乱扔会污染环境!\n");
//                                set("no_get","又不是你的，捡什么呀！\n");
}
        init_blade(105);
        setup();
}
