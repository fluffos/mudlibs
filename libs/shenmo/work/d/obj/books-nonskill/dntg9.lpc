
inherit ITEM;
#include <ansi.h>

string name = "《"HIR"齐天大圣"NOR"》第九回";
string number = "9";

void init();
int do_read();

void create()
{
set_name(name, ({"dntg", "book"}));
set_weight(200);
if( clonep() )
	set_default_object(__FILE__);
else {
	set("unit", "本");
	set("long", WHT"西游记--神魔传说"NOR"玩家大闹天宫攻略：\n"+name+" 请用 read 阅读。\n");
	set("material", "paper");
	}
}

void init()
{
add_action("read_book", "read");
}

int read_book(string arg)
{
object me = this_player();
object ob = this_object();
    
if (!ob->id(arg))
	return notify_fail("你要读什么？\n");
write("\n");
me->start_more(read_file("/d/obj/books-nonskill/text/dntg"+number));
write("\n");
return 1;
}

