inherit ITEM;
#include <ansi.h>

string name = "《霸王别姬心得》";
string num = "bwbj";

void create()
{
        set_name(name, ({"bwbj", "book"}));
        set_weight(200);
        if( clonep() )
                set_default_object(__FILE__);
        else 
        {
                set("unit", "本");
                set("long", " 花景因梦(flower)写的 "+name+" 请用 read 阅读。");
                set("material", "paper");
                set("no_sell","知识是物价滴。\n");
                set("value",200000);    
        }
}

void init()
{
        add_action("read_book", "read");
}

int read_book(string arg)
{
        object me = this_player();
        object ob = this_object();
    
        if( !arg ||!id(arg) )
                return 0;
        write("\n");
        me->start_more(read_file("/d/ourhome/book/"+num));
        write("\n");
        return 1;
}

