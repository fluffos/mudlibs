#include <ansi.h>
//#include "auth.lpc"

inherit ROOM;

int do_sail(string arg);

void create()
{
    set("short", "地下一层密室");
    set("long", @LONG
这里异常的阴冷，冻得你只打哆嗦。在火光照映下，你观察
着房间的布局，发觉这里面空空如也，什么也没有。

LONG
    );

    set("exits", ([
        "south" : __DIR__"digong1/entry",
    ]));

    setup();
}

void init()
{

    add_action("do_enter", "enter");
    this_player()->set_temp("ghost_kill",0);   //限制最大杀数
}

int do_enter(string arg)
{
    object me;
    object room;

    me = this_player();

    if ( (int)me->query_temp("killed_by_ghost") + 3 > time() )
    {
        tell_object(me, "身体是革命的本钱，你还是歇会儿吧，兄弟!\n");
        return 1;
    }



    room = call_other(__DIR__"digong1", "random_room");
    if ( !room )
    {
        write("加载房间失败。\n");
        return 1;
    }

    message_vision(HIW"只见一道白光，$N已经消失了。\n"NOR, me);

    me->set_temp("maze/ql_digong1/valid", 0);
    me->move(room);
    me->set_temp("ql_digong1_enter_time", time()); //随进入时间长短，增加难度add by wuxin

    message_vision(HIW"$N出现在这里。\n"NOR, me);

    return 1;
}

int valid_leave(object me, string dir)
{
    object another;

    if ( (int)me->query_temp("killed_by_wokou") + 30 > time() )
    {
        return notify_fail("身体是革命的本钱，你还是歇会儿吧，兄弟!\n");
    }

    if ( !userp(me) || wizardp(me) )
    {
        return ::valid_leave(me, dir);
    }

    if ( another = present("ql_ghost", this_object()) )
    {
        return notify_fail(another->name() + "面前的黑影突地猛扑到你的面前，完全挡住你的去路。\n");
    }


    me->set_temp("maze/qinling/valid", 0);
    return ::valid_leave(me, dir);
}


