//秦陵地宫二层
//tomcat
//modify by Wuxin 
//inherit VRM_SERVER;
inherit "/adm/daemons/vrm_server";

//怪物设定为盗墓者
//奖励武学，道行，潜能，以及盗墓者身上的盒子，其他待定

void create() {
  string *room_desc = ({
    "这里是秦始皇地下陵园的一条甬道，阴冷黑暗。你只能靠着,
手中火扇子的微弱光芒摸索前行。四周不时传来野兽的嚎叫。,
你鼓足勇气向前走去。\n",
  });


  // 迷宫房间所继承的物件的档案名称。
  set_inherit_room(__DIR__ "yongdao3");

  set_npcs_rate(75);   //原值为95
  set_maze_traps(0);
  set_lonely_create(1);
  set_maze_boxs(3);

  //刷新时间
  set_maze_refresh(1200);

  //迷宫的单边长
  set_maze_long(30);

  //入口方向(出口在对面)
  set_entry_dir("west");

  //  set_maze_npcs(VRM_NPC"0001/guard");

  //入口与区域的连接方向
  set_link_entry_dir("out");

  //入口与区域的连接档案名
  set_link_entry_room(__DIR__ "mishi3");

  //出口与区域的连接方向
  set_link_exit_dir("down");

  //出口与区域的连接档案名
  set_link_exit_room(__DIR__ "lingqin3");

  //入口房间短描述
  set_entry_short("地下三层密道");

  //入口房间描述
  set_entry_desc(@LONG
这里异常的阴冷，冻得你只打哆嗦。你顺着火把微弱的光朝黑暗深处走去。
LONG);

  //出口房间短描述
  set_exit_short("陵寝密道");

  //出口房间描述
  set_exit_desc(@LONG
黑暗中，你脚底下一个踉跄，仿佛踩到了什么，你不敢贸然弯腰查看，
只好用脚尖四处轻点。突然间“咔咔哒”一阵响声，你好像踩到了什么？
面前仿佛露出一个孔洞(down)。
LONG
  );

  //迷宫房间的短描述
  set_maze_room_short("地陵甬道");

  //迷宫房间的描述，如果有多条描述，制造每个房
  //间的时候会从中随机选择一个。
  set_maze_room_desc(room_desc);

  // 迷宫房间是否为户外房间？
  set_outdoors(0);
}
