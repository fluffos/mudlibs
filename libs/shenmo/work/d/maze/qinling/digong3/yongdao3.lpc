//秦陵地宫三层
//tomcat
//modify by Wuxin 
//inherit VRM_SERVER;
inherit ROOM;
#include <ansi.h> 
//#include "auth.lpc"

string *ql_ghost = ({"beast","stealer","killer","killer","killer","worker",});

void create()
{
    set("short", "地陵甬道");
    set("long", @LONG
"这里是秦始皇地下陵园的一条甬道，阴冷黑暗。你只能靠着\n",
"手中火扇子的微弱光芒摸索前行。四周不时传来野兽的嚎叫。\n",
"你鼓足勇气向前走去。\n",
LONG
    );

    set("indoors", "qinling");
    set("pass_user", ({}));

    setup(); 

	  set("no_clean_up", 0);
}

void reset() 
{
    ::reset(); 
    set("pass_user", ({}));
}

int valid_leave(object me, string dir)
{
    object another;

    if ( !userp(me) || wizardp(me) )
    {
        return ::valid_leave(me, dir);
    }

    if ( another = present("ql_ghost", this_object()) )
    {
        return notify_fail(another->name() + "这里黑咕隆咚的，什么也看不清楚。还是先解决面前的问题吧！\n");
    }

    return ::valid_leave(me, dir);
}

void init()
{
    object me = this_player();
    object another;
    int i,guai_num;

    if ( wizardp(me) )
    {
        add_action("do_maphere", "mapp");
        add_action("do_newguai", "newguai");
        return;
    }

    add_action("do_none", "", 1);

    if ( !userp(me) )
    {
        return;
    }
    
    guai_num=1+random(3);
    
    if ( -1 == member_array(me->query("id"), this_object()->query("pass_user")) )
    {
        this_object()->set("pass_user", query("pass_user") + ({me->query("id")}));
        for (i=1; i<=guai_num; i++)
        {
        	if (random(100) <= this_object()->query("random_rate"))
            another = new(__DIR__ + "npc/" + ql_ghost[random(sizeof(ql_ghost))]);
        if ( !another )
        {
            return;
        }

        another->move(this_object());

        another->kill_ob(me);

        tell_object(me, another->name() + "哇哇怪叫着，闪身挡住了你的路。\n");
        }
    }
}

int do_newguai(string arg)
{
    object another;

    if ( !wizardp(this_player()) )
    {
        return 1;
    }

    another = new(__DIR__ + "npc/" + ql_ghost[random(sizeof(ql_ghost))]);
    if ( !another )
    {
        return 1;
    }

    another->move(this_object());
    another->invocation(this_player());

    return 1;
}

int do_look(string arg)
{
    if ( !wizardp(this_player()) )
    {
        if ( "east" == arg || "west" == arg || "north" == arg || "south" == arg )
        {
            tell_object(this_player(), "黑咕隆咚的，什么也看不清楚。\n");
            return 1;
        }
    }

    return 0;
}

int do_maphere(string arg)
{
	  
    string map_desc = call_other(__DIR__"digong3", "map_here", this_object());

    if ( map_desc )
    {
        this_player()->start_more(map_desc);
    }

    return 1;
}

int do_none(string arg)
{
    string *no_cmds, *no_cast;
    object me = this_player();
    string verb = query_verb();
    object another;

    no_cmds = ({
        "gongji", "ji", "apply", "steal", "whisper", "bian", "surrender", "fly",
        "burn",                         //jjf
    });
    no_cast = ({
        "chuqiao",                 //all
        "yinshen",                 //bonze
        "shuidun",                 //dragon
        "huimeng",                 //moon
        "escape", "chongsheng",//emei swordman
        "townportal",              //hell
        "yin",                     //gumu
        "arrest", "drift", "taijitu",
                                  //kunlun ... so BT..
        "mysticism", "nophase",   //sanxian
        "jieti",                   //xueshan
        "tuoqiao",                 //shushan
        "bagua",                   //youxia
        "qimen", "qiankun",     //wzg
        "tudun", "huanying",    //wdd
        "zhuang",               //hyd
        "move",
    });

    if ( "look" == verb )
    {
        return do_look(arg);
    }

    if ( "maphere" == verb )
    {
        tell_object(this_player(), "黑咕隆咚的，什么也看不清楚。你以为你是谁啊？\n");
        return 1;
    }
    
    if ( "map" == verb )
    {
        tell_object(this_player(), "黑咕隆咚的，什么也看不清楚。你以为你是谁啊？\n");
        return 1;
    }
    
    if ( "drop" == verb )
    {
    	  tell_object(this_player(), "这里这么黑，东西扔了就找不回来了!\n");
        return 1;
    }

    if ( userp(me) && !wizardp(me) && -1 != member_array(verb, no_cmds) )
    {
        if ( another = present("ql_ghost", this_object()) )
        {
            tell_object(me, another->query("name") + HIR"看起来想要杀死你！\n"NOR);
            return 1;
        }
        tell_object(me,"你刚动念头想要...突然背脊梁一阵冷汗乱了方寸，愣在当场!\n");
        return 1;
    }

    if ( !wizardp(me) && "cast" == verb && -1 != member_array(arg, no_cast) )
    {
        if ( another = present("ql_ghost", this_object()) )
        {
            tell_object(me, another->query("name") + HIR"看起来想要杀死你！\n"NOR);
            return 1;
        }
        
        tell_object(me,"你念了几句咒语，竟然发觉自己的法力失灵了!\n");
        return 1;
    }

    return 0;
}

