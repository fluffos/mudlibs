#include <ansi.h>
inherit COMBINED_ITEM;

void setup()
{
}

void init()
{
add_action("do_eat", "eat");
}

void create()
{
set_name(HIR"刑天丹"NOR,({"xingtian dan","dan"}));
if (clonep())
        set_default_object(__FILE__);
else    {
        set("base_unit","粒");
        set("unit","些");
        set("long", "神奇的仙丹，据说了可以使人战意百倍。\n");
        set("value",0);
        set("drug_type", "良药");
        }
set_amount(1);
setup();
}

int do_eat(string arg)
{
mapping data;   
if ( !arg || !id(arg) || !present(this_object(),this_player()) )
        return 0;
message_vision("$N吃下一粒"+name()+"，面色一红，整个人变得战意凛然。\n",this_player());
this_player()->add("bellicosity",50);
this_player()->set_temp("apply/perf_action",([
        "start"  :  time(),
        "time"   :  5+random(15),
        "msg"    :  HIR"$N"HIR"忽然发疯似的挥舞兵器，对$n"HIR"又是一泼攻击！\n"NOR,
]));    
add_amount(-1);
return 1;
}
