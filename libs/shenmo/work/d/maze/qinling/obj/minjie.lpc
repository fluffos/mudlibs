#include <ansi.h>
inherit COMBINED_ITEM;

void setup()
{
}

void init()
{
add_action("do_eat", "eat");
}

void create()
{
set_name(HIG"敏捷丹"NOR,({"minjie dan","dan"}));
if (clonep())
        set_default_object(__FILE__);
else    {
        set("base_unit","粒");
        set("unit","些");
        set("long", "神奇的仙丹，据说了可以使人身轻如燕。\n");
        set("value",0);
        set("drug_type", "良药");
        }
set_amount(1);
setup();
}

int do_eat(string arg)
{
mapping data;   
if ( !arg || !id(arg) || !present(this_object(),this_player()) )
        return 0;
message_vision("$N吃下一粒"+name()+"，整个人变得轻灵起来。\n",this_player());
this_player()->set_temp("apply/perf_dodge",([
        "start"  :  time(),
        "time"   :  3+random(20),
        "msg"    :  HIG"$n"HIG"忽然身不由己的冲天而起，恰恰闪开了$N"HIG"的攻击。\n"NOR,
]));    
add_amount(-1);
return 1;
}
