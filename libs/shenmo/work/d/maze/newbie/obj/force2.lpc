#include <ansi.h>
inherit COMBINED_ITEM;

void init()
{
        add_action("do_eat", "drink");
}

void setup(){ return; }

void create()
{
        set_name("碧水玉瓶",({"bishui ping", "ping"}));
        if(clonep())
                set_default_object(__FILE__);
        else 
        {
                set("base_weight",1);
                set("long", "据说喝了可以增加内力的神奇琼浆，不过好似只能在特定的地点使用。\n");
                set("unit","些");
                set("base_unit","个");
                set("drug_type", "补品");
                set("no_sell","凡人哪里知道"+this_object()->query("name")+"的价值？还是自己留着吧。\n");
                set("value",3500);
                set("num",20000);
        }
        setup();
        set_amount(1);
}

int do_eat(string arg)
{
        int num,need;
        object me = this_player();
        if( !arg || !id(arg) || !present(this_object(),me) )
                return 0;
        if( !environment()->query("virtual_room") )
        {
                write("当前地图上使用没有效果。\n");
                return 1;
        }
        need = me->query("max_force")*2-me->query("force");
        if( need<=0 )
        {
                write("你内力充沛，没有必要使用。\n");
                return 1;
        }
        message_vision(HIG"$N"HIG"拿起$n"HIG"一仰脖，一阵猛喝。\n"NOR,me,this_object());
        num = query("num");
        if( num>need )
        {
                me->set("force",me->query("max_force")*2);
                add("num",-need);
        }
        else    
        {
                me->add("foce",num);
                if( query_amount()<=1 )
                        destruct(this_object());
                else    add_amount(-1); 
        }       
        return 1;
}

