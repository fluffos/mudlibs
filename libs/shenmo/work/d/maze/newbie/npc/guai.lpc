//背阴巷迷宫怪物
//进入条件为wx 20w-150w(最高skills245左右)
//snowtu 2011

#include <ansi.h>
inherit NPC;

void create() {
  int i;
  string *s, name, *id;
  mapping names = ([
    "流氓": ({ "liu mang", "liumang", }),
    "地痞": ({ "di pi", "dipi", }),
    "恶霸": ({ "e ba", "eba", }),
    "小偷": ({ "xiao tou", "xiaotou", }),
    "醉汉": ({ "zui han", "zuihan", }),
    "老千": ({ "lao qian", "laoqian", }),
    "混混": ({ "hun hun", "hunhun", }),
  ]);
  s = keys(names);
  name = s[random(sizeof(s))];
  if (!name)
    name = "地痞";
  id = names[name];

  set_name(name, id);
  set("gender", "男性");
  set("age", 17 + random(20));
  set("con", 30);
  set("per", 20);
  set("str", 55);
  set("int", 35);
  set("attitude", "aggressive");

  set_skill("unarmed", 60 + random(120));
  set_skill("dodge", 60 + random(120));
  set_skill("force", 60 + random(120));
  set_skill("parry", 60 + random(120));
  set_skill("fork", 60 + random(120));
  set_skill("spells", 60 + random(120));
  set_skill("seashentong", 60 + random(120));
  set_skill("dragonfight", 60 + random(120));
  set_skill("dragonforce", 60 + random(120));
  set_skill("fengbo-cha", 60 + random(120));
  set_skill("dragonstep", 60 + random(120));
  map_skill("spells", "seashentong");
  map_skill("unarmed", "dragonfight");
  map_skill("force", "dragonforce");
  map_skill("fork", "fengbo-cha");
  map_skill("parry", "fengbo-cha");
  map_skill("dodge", "dragonstep");
  i = query_skill("force", 1);
  set("combat_exp", i * i / 10 * i);
  i = query_skill("spells", 1);
  set("daoxing", i * i / 10 * i);
  i = query_skill("force");
  set("max_force", i * 10);
  set("force", i * 20);
  set("force_factor", i);
  i = query_skill("spells");
  set("max_mana", i * 10);
  set("mana", i * 20);
  set("mana_factor", i);

  set("max_kee", 15000);
  set("max_sen", 20000);
  set("water", 200000);
  set("food", 200000);

  create_family("东海龙宫", 4, "外家传人");
  set("title", "");
  set("env/no_msg", 1);
  set("chat_chance_combat", 10);
  set("chat_msg_combat", ({
    (: cast_spell, "hufa" :),
    (: cast_spell, "freez" :),
    (: cast_spell, "water" :),
    (: perform_action, "unarmed", "sheshen" :),
    (: perform_action, "unarmed", "leidong" :),
    (: exert_function, "recover" :),
  }));

  setup();
  carry_object("/d/sea/obj/yinjia")->wear();
}

void reward_player(object who, int p) {
  object ob, *team;
  int wx, dx, pt, pp;

  message_vision(HIB "\n$N" HIB "惨叫一声，化作一道青烟散去。\n\n" NOR, this_object());
  if (!who || !userp(who) || !present(
    who,
    environment()
  ) || !environment()->query("virtual_room")) {
    destruct(this_object());
    return;
  }
  //新手礼物，奖励超过5w/5w/3w后即无所得       
  wx = 2000 + random(2000);
  if (p <= 0)
    p = 0;
  if (p > 100)
    p = 100;
  wx += wx * p / 100;
  dx = wx / 2 + random(wx / 2);
  pt = wx / 5 + random(wx / 5);
  team = who->query_team();
  switch (random(3)) {
    case 0:
      if (who->query("giftmark/newbiewx") < 50000) {
        if (team)
          message("team", HIW "【背阴巷】" + who->query("name") + "得到了 " + wx + "点武学经验。\n" NOR, team);
        else tell_object(who, HIY "你得到了" + wx + "点武学经验。\n" NOR);
        who->add("combat_exp", wx);
        who->add("giftmark/newbiewx", wx);
      }
      break;
    case 1:
      if (who->query("giftmark/newbiedx") < 50000) {
        if (team)
          message(
            "team",
            HIW "【背阴巷】" + who->query("name") + "得到了 " + COMBAT_D->chinese_daoxing(dx) + HIW "道行。\n" NOR,
            team
          );
        else tell_object(who, HIY "你得到了" + COMBAT_D->chinese_daoxing(dx) + "道行。\n" NOR);
        who->add("daoxing", dx);
        who->add("giftmark/newbiedx", dx);
      }
      break;
    default:
      if (who->query("giftmark/newbiepot") < 30000) {
        if (team)
          message("team", HIW "【背阴巷】" + who->query("name") + "得到了 " + pt + "点潜能修为。\n" NOR, team);
        else tell_object(who, HIY "你得到了" + pt + "点潜能修为。\n" NOR);
        who->add("potential", pt);
        who->add("giftmark/newbiepot", pt);
      }
      break;
  }

  //钱财奖励
  switch (random(20)) {
    case 0:
    case 19:
      ob = new("/obj/money/thousand-cash");
      ob->set_amount(1 + random(5));
      break;
    case 1:
    case 18:
      ob = new("/obj/money/thousand-cash");
      break;
    default:
      ob = new("/obj/money/gold");
      break;
  }
  if (ob) {
    if (team)
      message(
        "team",
        HIW "【背阴巷】" + who->query("name") + "得到了 " + ob->short() + HIW "。\n" NOR,
        team
      );
    else tell_object(who, "你得到了" + ob->short() + "。\n");
    if (!ob->move(who))
      ob->move(environment(who));
  }

  destruct(this_object());
  return;
}


//组队杀，经验有加成
void reward_ob(object who) {
  object *team, *temp;
  int i, p;
  if (!who || !living(who))
    return;
  team = who->query_team();

  if (!team || sizeof(team) < 2) {
    reward_player(who, 100);  //无组队时，奖励为100%
    return;
  }

  p = 100;
  temp = ({});
  for (i = 0; i < sizeof(team); i++) {
    if (!team[i] || !living(team[i]) || !present(team[i], environment(who)))
      continue;
    p += 1;  //在场的队友每多一个增加1%的奖励加成
    temp += ({ team[i] });
  }
  if (sizeof(temp) < 3)  //仅有2人，无加成
    p = 100;
  for (i = 0; i < sizeof(temp); i++) {
    if (temp[i] == who)
      reward_player(who, (p + 2));  //杀死者比其他组员多2%的加成
      else reward_player(who, p);
  }
}

void unconcious() {
  die();
}

void init() {
  object me = this_player();

  if (!this_object()->is_fighting()
    && userp(me)) {
    this_object()->kill_ob(me);
    if (random(3) == 0)
      this_object()->command("follow " + me->parse_command_id_list()[0]);
  }
  add_action("do_go", "go");
}

int do_go(string arg) {
  if (!arg)
    return 0;
  if (living(this_object()) && is_fighting(this_player())) {
    write(query("name") + "将你拦住。\n");
    return 1;
  }
  return 0;
}
