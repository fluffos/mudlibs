inherit NPC;
#include <ansi.h>

string give_migong();

void create()
{
        set_name("萧禹", ({"xiao yu", "xiao","xiaoyu"})); 
        set ("long", @LONG
        疾风知劲草，板荡识诚臣        
LONG);
        set("title",HIC"宋国公"NOR);
        set("gender", "男性");
        set("age", 60);
        set("per", 30);
        set("attitude", "peaceful");
        set("inquiry", ([
                "长安恶霸" : (:give_migong:),
        ]));
        setup();
}

int check_day(object who)
{
        int time,month, day, hour, min, sec;    
        if( !who )
                return 0;
        time = who->query("mud_age");   
        sec = time % 60;
        time /= 60;
        min = time % 60;
        time /= 60;
        hour = time % 24;
        time /= 24;
        day = time % 30;
        month = time / 30;
        if( month>0 || day>=1 )
                return 1;
        return 0;               
}       
        
string give_migong()
{
        object me = this_player();

        if( time()<me->query("maze/newbie")+300 )
                return "你还是先休息休息再来。";
        if( me->query("combat_exp")>15000000 )
                return "你不算新手了，还是不要进去了。";
        if( me->query("combat_exp")<200000 )
                return "你武学也太低了，还是不要进去了。";
/*
        if( !check_day(me) )
                return "你刚刚来到这个世界，待熟悉熟悉再来吧。";        
        
*/
        message_vision("$N朝$n点了点头，说道：今长安背阴巷中恶霸横行，你去将之伏法。\n",this_object(),me);     
        me->set_temp("maze/公共地图","sys0001");
        if( MAZE_D->enter_maze(me, "newbie") )
        {
                me->set("maze/newbie",time());
                me->set_temp("duanwu_start",environment(me));
        }
        else   me->delete_temp("maze/公共地图");
        return "加油加油";
}


