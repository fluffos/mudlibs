#include <ansi.h>
inherit NPC;

void create() {
  int i;
  mapping names = NAME_D->random_name("male");
  if (!names)
    set_name("李霸天", ({ "li batian", "li" }));
  else set_name(names["name"], names["id"]);
  set("gender", "男性");
  set("age", 40);
  set("con", 30);
  set("per", 22);
  set("str", 155);
  set("int", 15);
  set("attitude", "aggressive");
  set("shilian", 1);
  set("class", "human");

  set_skill("force", 450);
  set_skill("unarmed", 450);
  set_skill("dodge", 450);
  set_skill("parry", 450);
  set_skill("sword", 450);
  set_skill("shenghuo-shengong", 450);
  set_skill("jiuyang-shengong", 450);
  set_skill("qiankun-danuoyi", 450);
  set_skill("qishang-quan", 450);
  set_skill("shenghuo-ling", 450);
  set_skill("spells", 450);
  set_skill("literate", 450);
  set_skill("qiankun-danuoyi", 450);
  set_skill("qingfu-shenfa", 450);

  map_skill("force", "jiuyang-shengong");
  map_skill("dodge", "qingfu-shenfa");
  map_skill("unarmed", "qishang-quan");
  map_skill("sword", "shenghuo-ling");
  map_skill("parry", "shenghuo-ling");
  map_skill("spells", "qiankun-danuoyi");

  set("combat_exp", 15000000);
  set("daoxing", 20000000);
  set("max_force", 8000);
  set("force", 16000);
  set("force_factor", 450);
  set("max_mana", 10000);
  set("mana", 20000);
  set("mana_factor", 550);

  set("max_kee", 50000);
  set("max_sen", 80000);
  set("water", 200000);
  set("food", 200000);

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: cast_spell, "nuoyi" :),
    (: perform_action, "sword", "can" :),
    (: perform_action, "sword", "hua" :),
    (: perform_action, "sword", "lian" :),
    (: perform_action, "sword", "xi" :),
    (: perform_action, "sword", "yin" :),
    (: exert_function, "recover" :),
    (: exert_function, "power" :),
  }));

  create_family("明教", 4, "外家传人");
  set("title", HIR "京城恶霸" NOR);
  set("env/no_msg", 1);

  setup();
  carry_object("/d/sea/obj/yinjia")->wear();
  add_temp("apply/armor", 300);
  carry_object("/d/obj/weapon/sword/ningbi-jian")->wield();
}

void reward_player(object who, int p) {
  string arg;
  object ob, *team;
  int wx, dx, pt, pp;

  message_vision(HIB "\n$N" HIB "惨叫一声，化作一道青烟散去。\n\n" NOR, this_object());
  if (!who || !userp(who) || !present(
    who,
    environment()
  ) || !environment()->query("virtual_room")) {
    destruct(this_object());
    return;
  }

  wx = 2000 + random(5000);
  if (p <= 0)
    p = 0;
  if (p > 100)
    p = 100;
  wx += wx * p / 100;
  dx = wx / 2 + random(wx / 2);
  pt = wx / 5 + random(wx / 5);
  team = who->query_team();
  arg = " ";
  switch (random(3)) {
    case 0:
      if (team)
        message("team", HIW "【背阴巷】" + who->query("name") + "得到了 " + wx + "点武学经验。\n" NOR, team);
      else tell_object(who, HIY "你得到了" + wx + "点武学经验。\n" NOR);
      arg += "武学 ";
      who->add("combat_exp", wx);
      break;
    case 1:
      if (team)
        message(
          "team",
          HIW "【背阴巷】" + who->query("name") + "得到了 " + COMBAT_D->chinese_daoxing(dx) + HIW "道行。\n" NOR,
          team
        );
      else tell_object(who, HIY "你得到了" + COMBAT_D->chinese_daoxing(dx) + "道行。\n" NOR);
      who->add("daoxing", dx);
      arg += "道行 ";
      break;
    default:
      if (team)
        message("team", HIW "【背阴巷】" + who->query("name") + "得到了 " + pt + "点潜能修为。\n" NOR, team);
      else tell_object(who, HIY "你得到了" + pt + "点潜能修为。\n" NOR);
      who->add("potential", pt);
      arg += "潜能 ";
      break;
  }

  //钱财奖励
  switch (random(20)) {
    case 0:
    case 19:
      ob = new("/obj/money/thousand-cash");
      ob->set_amount(25 + random(25));
      break;
    case 1:
    case 18:
      ob = new("/obj/money/thousand-cash");
      ob->set_amount(5 + random(35));
      break;
    default:
      ob = new("/obj/money/gold");
      ob->set_amount(50 + random(50));
      break;
  }
  if (ob) {
    arg += "钱财 ";
    if (team)
      message(
        "team",
        HIW "【背阴巷】" + who->query("name") + "得到了 " + ob->short() + HIW "。\n" NOR,
        team
      );
    else tell_object(who, "你得到了" + ob->short() + "。\n");
    if (!ob->move(who))
      ob->move(environment(who));
  }

  //特殊奖励，非每人必得
  if (random(who->query_kar()) > 28) {
    ob = new("/d/obj/drug/shenliwan");
    if (ob) {
      ob->set("no_get", 1);
      ob->set("value", 0);
      ob->set("no_give", 1);
      if (!ob->move(who))
        destruct(ob);
      else {
        arg += "以及" + ob->query("name") + " ";
        if (team)
          message(
            "team",
            HIW "【背阴巷】" + who->query("name") + "得到了 " + ob->query("name") + HIW "。\n" NOR,
            team
          );
        else tell_object(who, "你得到了" + ob->query("name") + "。\n");

      }
    }
  } else if (random(who->query_kar()) > 29) {
    ob = new("/d/obj/drug/wudiguo");
    if (ob) {
      ob->set("no_get", 1);
      ob->set("value", 0);
      ob->set("no_give", 1);
      if (!ob->move(who))
        destruct(ob);
      else {
        arg += "以及" + ob->query("name") + " ";
        if (team)
          message(
            "team",
            HIW "【背阴巷】" + who->query("name") + "得到了 " + ob->query("name") + HIW "。\n" NOR,
            team
          );
        else tell_object(who, "你得到了" + ob->query("name") + "。\n");

      }
    }

  } else if (random(who->query_kar()) > 30) {
    ob = new("/d/city/obj/bnmihoutao");
    if (ob) {
      ob->set("no_get", 1);
      ob->set("value", 0);
      ob->set("no_give", 1);
      if (!ob->move(who))
        destruct(ob);
      else {
        arg += "以及" + ob->query("name") + " ";
        if (team)
          message(
            "team",
            HIW "【背阴巷】" + who->query("name") + "得到了 " + ob->query("name") + HIW "。\n" NOR,
            team
          );
        else tell_object(who, "你得到了" + ob->query("name") + "。\n");

      }
    }

  }
  if (arg && strlen(arg) > 4)
    CHANNEL_D->do_channel(
      this_object(),
      "rumor",
      who->query("name") + "帮助官府除掉长安恶霸，得到了" HIY + arg + HIM "的奖励。" NOR
    );
  destruct(this_object());
  return;
}

//组队杀，经验有加成
void reward_ob(object who) {
  object ob, *team, *temp;
  int i, p;
  if (!who || !living(who))
    return;
  team = who->query_team();

  ob = new("/obj/money/jinbi");
  if (ob) {
    ob->set_amount(1);
    if (!ob->move(who))
      destruct(ob);
    else {
      if (team)
        message(
          "team",
          HIW "【背阴巷】" + who->query("name") + "得到了 " + ob->query("name") + HIW "。\n" NOR,
          team
        );
      else tell_object(who, "你得到了" + ob->query("name") + "。\n");
    }
  }
  if (!team || sizeof(team) < 2) {
    reward_player(who, 100);  //无组队时，奖励为100%
    return;
  }

  p = 100;
  temp = ({});
  for (i = 0; i < sizeof(team); i++) {
    if (!team[i] || !living(team[i]) || !present(team[i], environment(who)))
      continue;
    p += 1;  //在场的队友每多一个增加1%的奖励加成
    temp += ({ team[i] });
  }
  if (sizeof(temp) < 3)  //仅有2人，无加成
    p = 100;
  for (i = 0; i < sizeof(temp); i++) {
    if (temp[i] == who)
      reward_player(who, (p + 2));  //杀死者比其他组员多2%的加成
      else reward_player(who, p);
  }
}

void unconcious() {
  die();
}

int heal_up() {
  object weapon;
  weapon = query_temp("weapon");

  if (weapon) {
    if (random(2)) {
      command("unwield " + weapon->query("id"));
      set("chat_msg_combat", ({
        (: cast_spell, "nuoyi" :),
        (: perform_action, "unarmed", "cangli" :),
        (: perform_action, "unarmed", "sunxin" :),
        (: perform_action, "unarmed", "hunpofeiyang" :),
        (: perform_action, "unarmed", "cuiganchang" :),
        (: perform_action, "unarmed", "jingshi" :),
        (: perform_action, "unarmed", "sanjiao" :),
        (: perform_action, "unarmed", "shangfei" :),
        (: perform_action, "unarmed", "sunxin" :),
        (: perform_action, "unarmed", "yihuanghu" :),
        (: exert_function, "recover" :),
        (: exert_function, "power" :),
      }));
    } else {
      set("chat_msg_combat", ({
        (: cast_spell, "nuoyi" :),
        (: perform_action, "sword", "can" :),
        (: perform_action, "sword", "hua" :),
        (: perform_action, "sword", "lian" :),
        (: perform_action, "sword", "xi" :),
        (: perform_action, "sword", "yin" :),
        (: exert_function, "recover" :),
        (: exert_function, "power" :),
      }));
    }
  } else {
    if (random(2)) {
      command("wield all");
      if (query_temp("weapon")) {
        set("chat_msg_combat", ({
          (: cast_spell, "nuoyi" :),
          (: perform_action, "sword", "can" :),
          (: perform_action, "sword", "hua" :),
          (: perform_action, "sword", "lian" :),
          (: perform_action, "sword", "xi" :),
          (: perform_action, "sword", "yin" :),
          (: exert_function, "recover" :),
          (: exert_function, "power" :),
        }));
      }
    }
    if (!query_temp("weapon")) {
      set("chat_msg_combat", ({
        (: cast_spell, "nuoyi" :),
        (: perform_action, "unarmed", "cangli" :),
        (: perform_action, "unarmed", "sunxin" :),
        (: perform_action, "unarmed", "hunpofeiyang" :),
        (: perform_action, "unarmed", "cuiganchang" :),
        (: perform_action, "unarmed", "jingshi" :),
        (: perform_action, "unarmed", "sanjiao" :),
        (: perform_action, "unarmed", "shangfei" :),
        (: perform_action, "unarmed", "sunxin" :),
        (: perform_action, "unarmed", "yihuanghu" :),
        (: exert_function, "recover" :),
        (: exert_function, "power" :),
      }));
    }
  }
  return ::heal_up() + 1;
}
