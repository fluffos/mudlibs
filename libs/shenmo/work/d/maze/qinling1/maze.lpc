#include <ansi.h>
inherit VRM_SERVER;

void create()
{
        //迷宫房间所继承的物件的档案名称。
        set_inherit_room("/d/maze/qinling1/r");
        //迷宫房间里的怪物。
        set_maze_npcs( ([
        ]) );
        //迷宫中的唯一房间，例如BOSS所在区域等等
        set_unique_room(0);
        //每次刷新出现NPC的几率
        set_npcs_rate(100);
        //每次刷新出现陷阱的几率
        set_maze_traps(0);
        //迷宫创建新模式
        set_lonely_create(1);
        //迷宫中宝箱的数量
        set_maze_boxs(0);
        //迷宫显示模式 1:普通  2:详细  3:无地图显示
        set_display_map(2);     
        //迷宫的单边长
        set_maze_long(5);
        //入口方向(出口在对面)
        set_entry_dir("north");
        //入口与区域的连接方向
        set_link_entry_dir("north");
        //入口与区域的连接档案名
        set_link_entry_room(__DIR__"enter");
        //出口与区域的连接方向
        set_link_exit_dir("south");
        //出口与区域的连接档案名
        set_link_exit_room(__DIR__"out");  


         //普通房间描述
        set_maze_room_short("地陵甬道");
                        
        set_maze_room_desc(@LONG

这里是秦始皇地下陵园的一条甬道，阴冷黑暗。你只能靠着 
手中火扇子的微弱光芒摸索前行。四周不时传来野兽的嚎叫 
。你鼓足勇气向前走去。 
LONG); 

        //入口房间短描述 
        set_entry_short("地陵入口"); 
        //入口房间描述 
        set_entry_desc(@LONG

这里是秦始皇地下陵园的一条甬道，阴冷黑暗。你只能靠着 
手中火扇子的微弱光芒摸索前行。四周不时传来野兽的嚎叫 
。你鼓足勇气向前走去。
LONG);
        //出口房间短描述 
        set_exit_short("地下一层密室"); 
        //出口房间描述 
        set_exit_desc(@LONG

这里异常的阴冷，冻得你只打哆嗦。在火光照映下，你观察
着房间的布局，发觉这里面空空如也，什么也没有。

LONG);
        // 迷宫房间是否为户外房间？ 
        set_outdoors(0);    
        //死否假死
        set_maze_nodeath(0);        
      set_maze_refresh(3600);
}

