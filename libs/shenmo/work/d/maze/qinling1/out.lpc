#include <ansi.h>
inherit ROOM;

void create ()
{
        set("short", HIG"秦始皇陵寝"NOR);
        set("hell", 1);
        set("long", @LONG

如同受着巨大吸引力一般，你鬼使神差地走到了这里。在火
光照耀下，只见这里金碧辉煌，珠光宝气。陵寝正中央有一
个长约丈许的金棺(golden coffin),虽然被厚厚的尘土覆盖
着，仍然散发着叫人不可抗拒的气息。你忍不住朝它走去。

LONG);
        set("valid_startroom", 1);
        set("objects", ([ /* sizeof() == 1 */ 
                "/d/eastway/obj/bingma" : 4, 
                "/d/eastway/qinling/npc/beast" : random(6), 
])); 
        setup();
}
        
void init() 
{
        add_action("do_drop", "drop"); 
        add_action("do_push", "push"); 
}
int do_drop() 
{
        object me; 
        me=this_player(); 
        tell_object(me,"这里这么黑，东西扔了就找不回来了!\n"); 
        return 1; 
}

int err_msg(string arg)
{
        write(arg);
        return 1;
}

int do_push(string arg)
{
        object me=this_player();
        int mylevel=me->query("level");
        if( !arg || (arg != "golden coffin" && arg != "coffin") )
                return err_msg("你要推什么？\n");
        if(me->is_busy()) return err_msg("你忙着呢！\n");
        if(me->query_temp("no_move")) return err_msg("你被定住了，什么也干不了。\n");
        if (mylevel<50 || random(me->query("kar"))<15)
        {
                write(CYN"你的手指刚触摸到金棺的一角，不禁想起了官牒上的警告，缩回了手。\n"NOR);
                me->start_busy(2);
                return 1;
        }
        message_vision(CYN"$N早把官牒上的警告抛到了九霄云外，用尽全力推动棺盖。\n"NOR, me);
        message_vision(CYN"随着一阵“吱轧轧”声，棺盖开启。$N探头向金棺里看去。\n"NOR, me);
        message_vision(CYN"里面竟然什么也没有！$N大呼上当，原来是个疑冢！\n"NOR, me);
        message_vision(CYN"正当此时，$N只觉脚底地板翻转，想躲开已然不及，$N惨叫一声，直直地掉了下去！\n"NOR, me);
        message("channel:rumor",HIM"【千里眼】某人：听说"+me->name()+HIM"机缘巧合，进入了秦始皇陵地下第二层！\n"NOR,users());
        if (me->query("digong") == 0)
                me->add("digong", 1);
        write(HIY"\n这只是一个体验版，所以不会真正的去二层，毕竟还没定下来。\n\t\t\tby snowtu\n\n"NOR);                
        return 1;
}

int is_digong()    {return 1;}
