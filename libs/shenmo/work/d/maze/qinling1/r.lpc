#include <ansi.h>
inherit ROOM;
    
void create()
{
        set("short","地陵甬道");
        set("hs_world",1); //不能出窍
        set("channel_id","背阴巷");
        set("alternative_die",1);
        set("lianhua",95);  //莲花只增加95%的值
        set("任务",1);
        set("item_desc" , ([
                "east": "黑咕隆咚的，什么也看不清楚。\n", 
                "south": "黑咕隆咚的，什么也看不清楚。\n", 
                "west": "黑咕隆咚的，什么也看不清楚。\n", 
                "north": "黑咕隆咚的，什么也看不清楚。\n", 
        ])); 
        set ("long", @LONG

这里是秦始皇地下陵园的一条甬道，阴冷黑暗。你只能靠着 
手中火扇子的微弱光芒摸索前行。四周不时传来野兽的嚎叫 
。你鼓足勇气向前走去。 
LONG); 
        setup();
}

void alternative_die(object who)
{
        int i,lost;
        object target;
        if( !who )
                return;
        if( userp(who) )
        {
                set("alternative_die",0);
                who->delete_temp("maze/公共地图");
                who->die();
                set("alternative_die",1);
                return;
        }
        else
        {
                message_vision ("\n$N「啪」的一声倒在地上，挣扎着抽动了几下就死了。\n\n",who);          
                target = who->query_temp("last_damage_from");
                who->clear_condition();
                if( target && present(target,this_object()) )
                        who->reward_ob(target);
                if( who )  destruct(who);
                return;                         
        }
}                       

void init()
{
 	add_action("do_move",({"move","cast"}));
}

int do_move()
{
        write("ok.\n");
        return 1;
}

int is_digong() { return 1;}


