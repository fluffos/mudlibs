//试招迷宫
inherit VRM_SERVER;

void create()
{
    string *room_desc = ({ 
        "四周的墙壁上，刻画着形形色色的人物。\n",
        "四周的墙壁上，充斥着各种各样的图像。\n",
        });

    // 迷宫房间所继承的物件的档案名称。
    set_inherit_room( __DIR__"combatroom" );

    set_maze_traps(0);
    set_lonely_create(1);
    set_maze_boxs(0);

    //刷新时间
    set_maze_refresh(0);

    //迷宫的单边长
    set_maze_long(10);

    //入口方向(出口在对面)
    set_entry_dir("west");

    //入口与区域的连接方向
    set_link_entry_dir("west");

    //入口与区域的连接档案名
    set_link_entry_room("/d/city/wuguanzhong");

    //出口与区域的连接方向
    set_link_exit_dir("west");

    //出口与区域的连接档案名
    set_link_exit_room("/d/city/wuguanzhong");

    //入口房间短描述
    set_entry_short("试炼岛入口");

    //入口房间描述
    set_entry_desc(@LONG
循着猥琐的气息，你小心翼翼的向海岛深处走去。
LONG);

    //出口房间短描述
    set_exit_short("试炼岛大路");

    //出口房间描述
    set_exit_desc(@LONG
经过一番血战，你终于看到了前方的一片光明。
LONG
);

    //迷宫房间的短描述
    set_maze_room_short("山洞内");

    //迷宫房间的描述，如果有多条描述，制造每个房
    //间的时候会从中随机选择一个。
    set_maze_room_desc(room_desc);

    // 迷宫房间是否为户外房间？
    set_outdoors(0);
}

