inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "山洞内");
  set("long", @LONG
小路坑洼不平，很是难走。
LONG
  );

  set("alternative_die", 1);

  set("objects", ([
    __DIR__ "npc/badguy": 1,
  ]));

  setup();

  set("no_clean_up", 0);
}

void alternative_die(object who) {
  if (!who) {
    return;
  }

  message_vision("\n\n$N缓缓一点头：佛法无边！\n\n", who);

  SDS_D->powerup(who);

  return;
}

void init() {
  add_action("do_stop", "stop");
  add_action("do_check", "service");

  delete("exits");
}

int do_stop(string arg) {
  object room = this_object();
  object *inv;
  int i;

  inv = all_inventory(room);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->is_character()) {
      inv[i]->remove_all_killer();
      inv[i]->remove_all_enemy();
    }
  }

  message_vision("$N用巫师的神力停止了这场打斗。\n", this_player());

  return 1;
}

int do_check(string arg) {
  int service = this_player()->query_temp("combat_time");
  int t, d, h, m, s;
  string result;

  if (!service) {
    return 1;
  }

  t = service - time();

  s = t % 60;
  t /= 60;
  m = t % 60;
  t /= 60;
  h = t % 24;
  t /= 24;
  d = t;

  result = "你的服务时间还剩余: ";

  if (d) {
    result += chinese_number(d) + "天";
  } else {
    result += "";
  }

  if (h) {
    result += chinese_number(h) + "小时";
  }

  if (m) {
    result += chinese_number(m) + "分";
  }

  result += chinese_number(s) + "秒";

  tell_object(this_player(), result + "\n");

  return 1;
}
