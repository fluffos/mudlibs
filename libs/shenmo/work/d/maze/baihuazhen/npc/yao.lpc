int query_max_hp(object who)
{
	int level,num;
	level = this_object()->query_level();
	if( !who ) 
	{
		if( level>=80 )
			return 10000+level*500;
		else	return 5000+level*300;
	}
	num = (who->query_temp("maze/bhg_killed")+1)*5000;
	if( num>18000 )
		num = 18000;
	if( level>=60 )
		return 8000+num;
	else	return 3500+num/2+300;		
}

int information(object who)
{
	int kee,lvl;
	if( !who || !environment(who) 
	 || !environment(who)->is_bhg() )
		return 0;
	
	lvl = who->query_level()/10*10+9;
	if( lvl<39 )
		lvl = 39;
	set_level(lvl);
	kee = query_max_hp(who);
	default_level =lvl*10;
	init_family(default_level);
	set("max_kee",kee);
	set("max_sen",kee);
	set("max_force",default_level*15);
	set("max_mana",default_level*18);
	setup();
	powerup(0,1);
	set("force",this_object()->query_maxforce()*2);
	set("mana",this_object()->query_maxmana()*2);
	set("mana_factor",default_level*2);
	set("force_factor",default_level*2);
	set("daoxing",this_object()->query_max_daoxing());
	set("valid_time",time());
	
	this_object()->move(environment(who));
	message_vision(NOR"\n"HIR"花丛深处一阵索索声响，但见一个人影鬼鬼祟祟从中走出。\n"NOR CYN"$N"CYN"用锐利的目光盯着$n"CYN"，口中「嘿嘿嘿．．．．」地奸笑着。\n"NOR HIR"这厮忽的变了颜色，口中呢喃道：既然给你发现了，可不能怨我，要怪就怪你知道得太多了！\n"NOR,this_object(),who);
	this_object()->kill_ob(who);
	who->fight_ob(this_object());
	this_object()->set_follow(who);
	return 1;
}

void create()
{
	string name,*names,*ids,id;
	int i;
	
	ids = ({});
	names = ({
		"采","cai",
		"盗","dao",
		"食","shi",
		"偷","tou",
		"窃","qie",	
	});
	i = random(sizeof(names)/2)*2;
	name = names[i];
	id = names[i+1];

	names = ({
		"花","hua",
		"香","xiang",
		"卉","hui",
		"英","ying",
		"琼","qiong",
		"苞","bao",
	});	
	i = random(sizeof(names)/2)*2;
	name+= names[i];
	id+= names[i+1];
	
	names = ({
		"人","ren",
		"匠","jiang",
		"贼","zei",
		"汉","han",
		"精","jing",
		"怪","guai",
		"虫","chong",
	});	
	name+= names[i];
	id+= " "+names[i+1];
	ids = ({id,names[i+1]});
	
	set_name(name,ids);
	set("long","在园中偷香窃玉的怂货。\n");
	set("no_sleep",1);
	set("任务",1);
	set("env/test","HIM");
	set("env/brief_message",3);
	set("looking", HIB"面目猥琐，眼露邪光"NOR"。");
	set("rank_info/pos_msg", YEL"鬼鬼祟祟的看着四周"NOR"。\n");
	setup();
}

string obj_name(object ob)
{
        string str;
        if( !ob )
                return "";
        str = ob->name(1);
        str = COLOR_D->clean_color(str);
        return str;
}

void super_hit()
{
	int t;;
	remove_call_out("super_hit");
	if( !living(this_object()) 
	 || !this_object()->is_fighting() )
		return;
	t = 2+random(3);
	Super = 0;
	QUEST_D->addEffKee(this_object());
	QUEST_D->addKee(this_object());
	QUEST_D->addSen(this_object());
	QUEST_D->addEffSen(this_object());
	this_object()->stop_busy();
	Super = 1;
	QUEST_D->randomPfm(this_object());
	call_out("super_hit",t);
}

void kill_ob(object who)
{
	if( !who || !present(who,environment()) )
	{
		this_object()->powerup(1);
		remove_all_killer();
		all_inventory(environment())->remove_killer(this_object());
		return;
	}
	if( Die==1 )
	{
		remove_all_killer();
		all_inventory(environment())->remove_killer(this_object());
		return;
	}
	if( this_object()->is_fighting(who) )
		return;
	remove_call_out("super_hit");
	if( Super==0 )
		super_hit();	
	::kill_ob(who);
	if( this_object()->query_level()>=40 )
		command("cast xiaoshen");		
}

int follow_me(object ob, string dir)
{
	if( !ob || !living(this_object()) || ob==this_object() ) 
		return 0;
	if( ob==follow
	||(query("pursuer") && this_object()->is_killing(ob->query("id")))) 
		return follow_path(dir);
	return 0;
}

void reward_ob(object who)
{
        object ob;
        int i,succ,num;
        mixed *env,*dir;
        string color,file,str,arg="";

        if( !who || !userp(who) || !present(who,environment()) 
         || who->query("family/family_name")!="百花谷" )
        {
        	message_vision(HIY"\n$N"HIY"急急忙忙的离开了。\n\n"NOR,this_object());
        	this_object()->move("/obj/empty");
        	REMOVE_D->add_obj(this_object(),1);
                return;
        }

	message_vision(HIC"\n$N"HIC"连声讨饶：莫打莫打！哎呦喂，"+(who->query("gender")=="女性"?"姑奶奶":"爷爷")+"呀，您下手也忒重了！小的再也不敢采花了。\n"NOR,this_object());
        who->add_temp("maze/bhg_killed",1);
        num = who->query_temp("maze/bhg_killed");
        tell_object(who,HIR"你得到了一颗灵气珠，目前共有"+num+"颗。"HIY"(注意：退出副本后，灵气珠数量将清零)"HIR"。"NOR"\n");
        if( !arrayp(env=who->query_temp("maze/equip_color")) )
        	env = 0;   
        	
        i = who->query_spi()/15;
        i = random(i)+1;
        if( i>3 )
        	i = 3;
        while(i--)	
        {
        	succ = who->query_kar(); 
		succ = random(who->query_kar())/5;
		succ+= random(num);
        	if( succ>4 )
		{                
         		dir = ({ "hand","neck","ring","shield","waist","wrists","armor","cloth","kui","pifeng","shoes",});
               		file = dir[random(sizeof(dir))];
			ob = new("/d/obj/narmor/"+file);
			if( random(100)>95 )
				set("env/test","HIM");
			else if( random(100)>75 )
				set("env/test",({"HIM","HIR",})[random(2)]);
			else if( random(100)>50 )	
				set("env/test",({"HIM","HIR","HIB"})[random(3)]);
			else	set("env/test",({"HIY","HIB","HIB","HIB","HIC","HIR",})[random(6)]); 
                	set_temp("armor_level",default_level-5+random(5));
                	ob->init_armor(this_object());
                	if( ("/d/maze/bhg-baihua/npc/equip.lpc")->change_equip(ob) )
                		str = "百花珍藏"HIY+ob->query("name")+HIG;
                	else	str = obj_name(ob);
                	ob->set("no_give",1);
			if( stringp(color=ob->query("armor_color")) 
                 	 && env && member_array(color,env)==-1 )
			{
				tell_object(who,HIY"【副本】百花谷：你设置了装备过滤，"+str+HIY"被自动忽略。\n"NOR);
				ob->move("/obj/empty");
				REMOVE_D->add_obj(ob,1);
			}
                	else if( !ob->move(who) )
       	        	{
               			ob->move("/obj/empty");
				REMOVE_D->add_obj(ob,1);
                       		tell_object(who,HIR"【副本】百花谷：你的背包满了。\n"NOR);
			}
                	else    
                	{
                		if( arg!="" )
	                		arg+= "、";
				arg+= str;
			}
       		}	
        }
        
        succ = random(who->query_kar())/10;
        if( succ>5 )
        {
        	dir = ({"sword","unarmed","unarmed"});
        	file = dir[random(sizeof(dir))];
		ob = new("/d/obj/nweapon/"+file);
                if( random(100)>95 )
			set("env/test","HIM");
		else if( random(100)>75 )
			set("env/test",({"HIM","HIR",})[random(2)]);
		else if( random(100)>50 )	
			set("env/test",({"HIM","HIR","HIB"})[random(3)]);
		else	set("env/test",({"HIY","HIB","HIB","HIB","HIC","HIR",})[random(6)]); 
                set_temp("weapon_level",default_level-5+random(5));
                ob->init_weapon(this_object());
                ob->set("no_give",1);
                if( stringp(color=ob->query("weapon_color"))
                 && env && member_array(color,env)==-1 )
		{
                	tell_object(who,HIY"【副本】百花谷：你设置了装备过滤，"+obj_name(ob)+HIY"被自动忽略。\n"NOR);
                        ob->move("/obj/empty");
			REMOVE_D->add_obj(ob,1);
                }        
                else if( !ob->move(who) )
                {
                        ob->move("/obj/empty");
			REMOVE_D->add_obj(ob,1);
                        tell_object(who,HIR"【副本】百花谷：你的背包满了。\n"NOR);
                }
                else    
                {
                	if( arg!="" )
                		arg+= "、";
			arg+= obj_name(ob);
		}
        }
	
       if( arg!="" )
		tell_object(who,HIG"【副本】百花谷：你得到了 "+arg+" 。"NOR"\n");	
	this_object()->move("/obj/empty");
	REMOVE_D->add_obj(this_object(),1);
        return;
}

int accept_fight(object who){return 0;}

int is_bhg(){return 1;}