void init()
{
	::init();
	add_action("do_mark","mark");
}

int do_mark(string arg)
{
	int i;
	string str,*tmp,*temp;
	mapping color = ([
		"HIM" : "紫",
		"HIR" : "红",
		"HIC" : "青",
		"HIB" : "蓝",
		"HIY" : "金",
	]);
	if( !arg )
		return notify_fail(name()+"问道：你想记录哪些颜色，多种颜色可以用"HIY" , "NOR"分开。\n示例：mark HIC,HIM");
	arg = replace_string(arg,"，",",");	
	if( strsrch(arg,",")==-1 )
	{
		if( undefinedp(color[arg]) )
			return notify_fail(name()+"说道："+arg+" 这样颜色可没有。\n");
		else	tmp = ({arg});
	}
	else
	{
		temp = explode(arg,",");
		tmp = ({});
		for(i=0;i<sizeof(temp);i++)
		{
			if( undefinedp(color[temp[i]]) )
				return notify_fail(name()+"说道："+temp[i]+" 这样颜色可没有。\n");
			tmp+= ({temp[i]});	
		}
	}
	str = "";
	for(i=0;i<sizeof(tmp);i++)
	{
		str+= color[tmp[i]]+"色";
		if( i<sizeof(tmp)-1 )
			str+= "、";
	}
	this_player()->set_temp("maze/equip_color",tmp);
	write(HIC+name()+HIC"呵呵一笑，朝你一指。\n"NOR);		
	write(CYN+name()+CYN"说道：口可 口可，好了，除了"+str+"，其他品质的装备会自动清除。\n"NOR);
	return 1;
}

void heart_beat()
{
        object *inv,me = this_object();
        int i;
        if( !environment() )  
                return;
	::heart_beat();
	if( !environment()->query("virtual_room") )
		return;
	inv = all_inventory(environment());
	for(i=0;i<sizeof(inv);i++)
	{
		if( inv[i]==me 
		 || userp(inv[i])
		 || !inv[i]->is_bhg() )
			continue;
		message_vision(HIR"$N"HIR"一见$n"HIR"顿时白眉倒立，大喝一声：原来又是你！\n"NOR,me,inv[i]);
		switch(random(3))
		{
			case 0 :
				message_vision(HIM "$N"HIM"口中念了几句咒文，半空中无数"HIY"五"HIC"彩"HIG"鲜"HIW"花"HIM"迎风飞舞。花瓣片片飘落，如疾风骤雨箭般向$n"HIM"激射而下！\n"NOR HIR "结果无数花瓣从$n"HIR"身上透体嵌入，顿时血花飞溅！\n"NOR,me,inv[i]);
				message_vision(NOR"( "RED"$N"RED"已经陷入半昏迷状态，随时都可能摔倒晕去。"NOR" )\n",inv[i]);
				message_vision(NOR"( "RED"$N"RED"心智已经完全迷失，随时都有可能背过气去。"NOR" )\n",inv[i]);
				break;
			default :
				message_vision(HIM"$N"HIM"剑法一变，风声乍起，使出『纵横剑法』绝技－「纵横四海」，向$n"HIM"“刷刷刷”便是四剑！\n"NOR HIR"结果剑剑刺中$n"HIR"的要害！"NOR"\n",me,inv[i]);
				message_vision(NOR"( "RED"$N"RED"已经陷入半昏迷状态，随时都可能摔倒晕去。"NOR" )\n",inv[i]);
				break;
		}
		message_vision(HIC"\n$N"HIC"一阵狂风暴雨般的攻击，将$n"HIC"打成了灰灰！\n"NOR,me,inv[i]);
		all_inventory(environment())->remove_killer(inv[i]);
		inv[i]->remove_all_killer();
		inv[i]->move("/d/maze/bhg-baihua/empty");
//                REMOVE_D->add_obj(inv[i],1);
	}
}
						                
