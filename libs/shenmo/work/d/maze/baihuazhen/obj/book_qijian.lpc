#include <ansi.h>
inherit COMBINED_ITEM;

void setup(){}


void create()
{
	set_name("【纵横七剑秘笈】", ({"qijian book","qijian miji","book","mj"}));
	set_weight(1);
	if( clonep() )
		set_default_object(__FILE__);
  	else {
    		set("unit", "叠");
    		set("base_unit", "本");
    		set("value", 1);
    		set("no_sell", 1);
    		set("long", "百花谷前辈们对【纵横剑法之纵横七剑】研习的心得，阅之(read)有几率得到领悟【七剑精髓】的造化。\n"HIM"效果：领悟后，「纵横七剑」固定伤害增加50点。"NOR"\n");
    		set("material", "paper");
	}
	setup();
	set_amount(1);
}

void init()
{
	add_action("do_read",({"read","du",}));
}

int do_read(string arg)
{
	string str;
	object me = this_player(),ob=this_object();
	
	if( !arg || !id(arg) )
		return 0;
	if( !present(ob,me) )
		return 0;
	if( me->query("family/family_name")!="百花谷" )
		return notify_fail("百花谷弟子方能研习。\n");

	if( !query("owner_id") || query("owner_id")!=me->query("id") )
		return notify_fail("你从哪里得来的秘笈？！\n");
						
	if( me->query_level()<10 )
        	return notify_fail("你的人物等级不够。\n");
	
	if( (int)me->is_knowing("bhg_qijian")>=10000 )
        {
        	write(HIR"结果你觉得卷中所言甚浅，对自身修行无甚用处。\n"NOR);
        	message_vision("只见【纵横七剑秘笈】化成片片碎屑，从$N的手中飘落。\n",me);
        	if( query_amount()>1 )
        		add_amount(-1);
        	else	destruct(ob);
        	return 1;
        }	
	message_vision("$N拿起一张$n，仔细翻看。\n",me,ob);        	

        str = HIY"$N"HIY;
        str+= ({
		"沉浸在残卷绝妙的招数中，",
		"偶于残卷之中领悟一丝纵横剑法的精髓，",
		"对书中所述颇有心得，",
	})[random(3)];
        str+= ({		
		"久久不能自拔。。。。\n",
		"不由深深沉迷其中。。。。\n",
		"不禁摇头晃脑一番。。。。\n",
	})[random(3)];	
	message_vision(str,me);
	
	if( random(30)!=17 )
		write(HIR"奈何造化不够，你虽有感悟，然而却又一时难以抓住那份机缘。"NOR"\n");
	else		
	{
		write(HIY"你猛然间福至心灵，灵台清灵间抓住了那丝感悟！\n"NOR);
		me->set_knowing("bhg_qijian",1);
		write(HIR"你纵横七剑固定伤害增加70点，目前为"+(int)me->is_knowing("bhg_qijian")*70+"点。"NOR"\n");
		//CHANNEL_D->do_channel(this_object(),"rumor","听说"HIY+me->name()+HIM"领悟了【"HIG"纵横剑法"HIM"】之「"HIC"横剑精髓"HIM"」！"NOR);
	}
	message_vision("只见【纵横七剑秘笈】化成片片碎屑，从$N的手中飘落。\n",me);
	if( query_amount()>1 )
        	add_amount(-1);
        else	destruct(ob);
	return 1;
}