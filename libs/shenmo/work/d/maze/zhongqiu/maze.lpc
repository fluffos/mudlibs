#include <ansi.h>
inherit VRM_SERVER;

void create()
{
        //迷宫房间所继承的物件的档案名称。
        set_inherit_room("/d/maze/zhongqiu/r");

       //迷宫房间里的怪物。
        set_maze_npcs( ([
                "/d/maze/zhongqiu/npc/guai": 1 + random(3),
        ]) );
        set_unique_room( ({"/d/maze/zhongqiu/boss_room",}) );
        set_npcs_rate(75);
        set_maze_traps(0);
        set_lonely_create(1);
        set_maze_boxs(0);
        set_display_map(2);     
        //迷宫的单边长
        set_maze_long(5);
        //入口方向(出口在对面)
        set_entry_dir("west");
        //入口与区域的连接方向
        set_link_entry_dir("east");
        //入口与区域的连接档案名
        set_link_entry_room(__DIR__"enter");
        //出口与区域的连接方向
        set_link_exit_dir("south");
        //出口与区域的连接档案名
        set_link_exit_room(__DIR__"out");  


         //普通房间描述
        set_maze_room_short(HIG"长河渐落晓星沉"NOR);
                        
        set_maze_room_desc(@LONG
                
            目穷淮海满如银，万道虹光育蚌珍。
            天上若无修月户，桂枝撑损向西轮。

LONG); 

        //入口房间短描述 
        set_entry_short("遂令冷看世间人"); 
        //入口房间描述 
        set_entry_desc(@LONG

        　　玉颗珊珊下月轮，殿前拾得露华新。
        　　至今不会天中事，应是嫦娥掷与人。 
LONG);
        //出口房间短描述 
        set_exit_short("今夜清光似往年"); 
        //出口房间描述 
        set_exit_desc(@LONG

            星辰让光彩，风露发晶英。
            能变人间世，攸然是玉京。
LONG);
        // 迷宫房间是否为户外房间？ 
        set_outdoors(1);    
        // 迷宫房间是否刷新且刷新时间设置
        set_maze_refresh(86400);
        set_maze_nodeath(0);        
        set_remove_time(86400);     
}

