#include <ansi.h>
inherit ITEM;

void init()
{
                set("value",0);
        add_action("do_ask", "ask");
}

void create()
{
        set_name("中秋任务卷",({"zhongqiu job", "juan"}));
        set_weight(1000);
        if(clonep())
                set_default_object(__FILE__);
        else 
        {
                set("long", "中秋任务卷，带着它可以去向嫦娥打听(ask)"HIR"中秋"NOR"的消息，记住，只有1次打听的机会哦。\n");
                set("unit","些");
                set("base_unit","片");
                set("no_sell",1);
                set("no_put",1);
                set("no_get",1);
                set("value",10000);
        }
        setup();
}

int do_ask(string arg)
{
        string id;
        object who,me=this_player();
        
        if( !present(this_object(),me) 
         || !arg
         || sscanf(arg,"%s about %s",id,arg)!=2 )
                return 0;
        who = present(id,environment(me));
        if( !who || !living(who) )
                return 0;
        if( base_name(who)!="/d/moon/npc/change" )
                return 0;   
        if( arg!="中秋" )
                return 0;                                    
        if( me->query("giftmark/2011_zhongqiu1")>=3 )
        {
                write("你已经向嫦娥姐姐打听过了。\n");
                return 1;
        }
        write("你向嫦娥姐姐打听有关『中秋』的消息。\n");
        write(@LONG
嫦娥手抚残魂，低首不语，长久之后方才蹙眉轻吟：  
                我失骄杨君失柳， 
                杨柳轻飘直上重霄九。 
                问讯吴刚何所有， 
                吴刚捧出桂花酒。 
                寂寞有我舒广袖， 
                万里长空且为忠魂舞。 
                忽报人间曾伏虎， 
                泪飞顿作倾盆雨。        
LONG);
        write("嫦娥姐姐说道：去！去将羿的元神残片收集来给我。\n");
        if( MAZE_D->enter_maze(me, "zhongqiu") )
        {
                me->set("maze/newbie",time());
                me->add("giftmark/2011_zhongqiu1",1);
                destruct(this_object());
                return 1;
        }       
        else    write("嫦娥姐姐说道：还是再等等吧。\n");
        return 1;
}       
                        
                                        
    
