#include <ansi.h>
inherit COMBINED_ITEM;

void init() {
  if (!query("owner_id") && environment()
    && userp(environment()))
    set("owner_id", environment()->query("id"));
  add_action("do_ask", "ask");
}

void setup() { return; }

void create() {
  set_name("后羿残魂", ({ "houyi hun", "hun" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("base_weight", 1);
    set("long", "这是后羿元神残片，可以用收集它去向嫦娥讨要(ask)" HIR "赏赐" NOR "，记住哦，只有一次机会哦。\n");
    set("unit", "些");
    set("base_unit", "片");
    set("no_sell", 1);
    set("no_put", 1);
    set("no_get", 1);
    set("value", 0);
  }
  setup();
  set_amount(1);
}

int do_ask(string arg) {
  int num, max;
  string id;
  object who, g, me = this_player();

  if (!present(this_object(), me)
    || !arg
    || query("owner_id") != me->query("id")
    || sscanf(arg, "%s about %s", id, arg) != 2)
    return 0;
  who = present(id, environment(me));
  if (!who || !living(who))
    return 0;
  if (base_name(who) != "/d/moon/npc/change")
    if (arg != "赏赐") return 0;
  if (me->query("giftmark/2011_zhongqiu3")) {
    write("你已经向嫦娥姐姐讨要了奖励了。\n");
    return 1;
  }
  num = query_amount();
  if (num <= 0)
    return 0;
  write("你将" + chinese_number(num) + "片" + query("name") + "交到嫦娥姐姐的手里。\n");
  write(@LONG
嫦娥手抚残魂，低首不语，长久之后方才蹙眉轻吟：  
                我失骄杨君失柳， 
                杨柳轻飘直上重霄九。 
                问讯吴刚何所有， 
                吴刚捧出桂花酒。 
                寂寞有我舒广袖， 
                万里长空且为忠魂舞。 
                忽报人间曾伏虎， 
                泪飞顿作倾盆雨。        
LONG);
  write("嫦娥姐姐由衷的向你道谢。\n");
  num = num * 5;
  if (me->query("level") < 10)
    max = 10;
  else if (me->query("level") < 30)
    max = 100;
  else if (me->query("level") < 50)
    max = 300;
  else if (me->query("level") < 80)
    max = 500;
  else max = 1000;
  if (num >= max) num = max;
  g = new("/obj/money/gold");
  g->set_amount(num);
  if (!g->move(me))
    g->move(environment(me));
  write("嫦娥姐姐给你一些黄金。\n");
  me->set("giftmark/2011_zhongqiu3", 1);
  destruct(this_object());
  return 1;
}
