#include <ansi.h>
inherit NPC;

void create() {
  set_name("逢蒙", ({ "pang meng", "pang", "jingxiang" }));
  set("gender", "男性");
  set("age", 27 + random(20));
  set("con", 30);
  set("per", 20);
  set("str", 55);
  set("int", 35);
  set("attitude", "aggressive");

  set_skill("literate", 60);
  set_skill("unarmed", 60);
  set_skill("dodge", 60);
  set_skill("force", 60);
  set_skill("parry", 60);
  set_skill("sword", 60);
  set_skill("spells", 60);
  set_skill("moonshentong", 60);
  set_skill("baihua-zhang", 60);
  set_skill("moonforce", 60);
  set_skill("snowsword", 60);
  set_skill("moondance", 60);
  map_skill("spells", "moonshentong");
  map_skill("unarmed", "baihua-zhang");
  map_skill("force", "moonforce");
  map_skill("sword", "snowsword");
  map_skill("parry", "snowsword");
  map_skill("dodge", "moondance");
  create_family("月宫", 3, "红");
  set("long", "此乃后羿元神碎片仇恨镜像的投影，逄蒙本是一个山间猎手。
后羿发现他灵敏而又勇敢，就尽心竭力辅导他射箭。逢蒙学射
于后羿 ，尽羿之道。思天下唯羿胜己，于是杀羿 。");
  set("max_kee", 8000);
  set("max_sen", 8000);
  set("water", 200000);
  set("food", 200000);
  setup();
  carry_object("/d/sea/obj/yinjia")->wear();
}

int info_user(object who) {
  int i;
  if (!who || !userp(who))
    return 0;
  if (is_fighting() && query_temp("last_damage_from") != who)
    return 0;
  i = who->query_skill("force", 1);
  i = i / 2 + random(i * 2 / 3);
  set("combat_exp", i * i / 10 * i);
  i = query_skill("spells", 1);
  set("daoxing", i * i / 10 * i);
  i = query_skill("force");
  set("max_force", i * 10);
  set("force_factor", i);
  i = query_skill("spells");
  set("max_mana", i * 10);
  set("mana_factor", i);
  SDS_D->powerup(this_object());
  return 1;
}

void cast_arrow(object who) {
  int ap, dp;
  remove_call_out("cast_arrow");
  if (!who || !this_object()->is_fighting(who)
    || environment() != environment(who))

    return;
  message_vision(
    HIC "$N" HIC "口中念了几句咒文，随着一声“后羿在此！”半空中现出一位身披虎皮的大汉。\n只见他张弓搭箭，“嗖”的一声，一只蓝汪汪的长箭向$n" HIC "激射而下！\n" NOR,
    this_object(),
    who
  );
  ap = COMBAT_D->skill_power(this_object(), "spells", 1);
  dp = COMBAT_D->skill_power(who, "dodge", 2);
  if (random(100) >= dp / (ap + dp) * 100) {
    message_vision(HIC "结果长箭从$N" HIC "身上透体而过，顿时血花飞溅！\n" NOR, who);
    who->receive_damage("kee", 500 + random(500), this_object());
    COMBAT_D->report_status(who);
  } else message_vision(HIC "只见$N" HIC "轻轻一跳，长箭正好插在$N" HIC "脚边，兀自颤动不休！\n" NOR, who);
  call_out("cast_arrow", 3 + random(5), who);
}

void kill_ob(object who) {
  if (!who || !userp(who)) {
    message_vision("$N是高尚种族，不和$n一般见识。\n", this_object(), who);
    who->remove_killer(this_object());
    this_object()->remove_killer(who);
    return;
  }
  if (!query_temp("my_kill")) {
    if (!info_user(who)) {
      message_vision("$N是高尚种族，不和$n一般见识。\n", this_object(), who);
      who->remove_killer(this_object());
      this_object()->remove_killer(who);
      return;
    }
    set_temp("my_kill", who);
    remove_call_out("cast_arrow");
    call_out("cast_arrow", 2 + random(3), who);
  }
  ::kill_ob(who);
}

void reward_ob(object who) {
  object ob;
  int wx, dx, pt, pp;

  if (!who || !userp(who) || !present(
    who,
    environment()
  ) || !environment()->query("virtual_room")) {
    destruct(this_object());
    return;
  }
  message_vision(HIB "\n$N" HIB "一声尖叫，化作一道青光射入$n" HIB "手中。\n" NOR, this_object(), who);
  if (!who->query("giftmark/2011_zhongqiu5")) {
    wx = 6000 + random(2000);
    dx = wx / 2 + random(wx / 2);
    pt = wx / 5 + random(wx / 5);
    switch (random(3)) {
      case 0:
        who->add("combat_exp", wx);
        who->add("giftmark/2011_zhongqiu4", wx);
        tell_object(who, HIC "你得到了" + wx + "点武学经验。\n" NOR);
        break;
      case 1:
        tell_object(who, HIY "你得到了" + COMBAT_D->chinese_daoxing(dx) + "道行。\n" NOR);
        who->add("daoxing", dx);
        who->add("giftmark/2011_zhongqiu4", dx);
      default:
        tell_object(who, HIY "你得到了" + pt + "点潜能修为。\n" NOR);
        who->add("potential", pt);
        who->add("giftmark/2011_zhongqiu4", pt);
        break;
    }
    if (who->query("obstacle/reward")) {
      who->add("haomao", 3);
      tell_object(who, HIY "你得到了三根救命毫毛。\n" NOR);
    }
    tell_object(who, HIY "你得到了十点元神。\n" NOR);
    who->add("shen", 10);
    who->set("giftmark/2011_zhongqiu5", 1);
  } else tell_object(who, HIC "中秋快乐，你在此杀怪已得不到任何的数据奖励了。\n" NOR);
  ob = new("/d/maze/zhongqiu/obj/pian");
  ob->set_amount(10);
  if (ob->move(who)) {
    tell_object(who, "你得到了" + ob->short() + "。\n");
  } else if (ob)
    destruct(ob);
  destruct(this_object());
  return;
}

void unconcious() {
  die();
}
