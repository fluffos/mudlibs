#include <ansi.h>
inherit ROOM;
    
void create()
{
        set("short","长河渐落晓星沉");
        set("no_chuqiao",1);
        set("channel_id","中秋佳节");
        set("alternative_die",1);
        set("lianhua",5);  //莲花只增加10%的值
        set("任务",1);
        set("hell",1);
        setup();
}

void alternative_die(object who)
{
        string r;
        object target;
        if( !who )
                return;
        if( !userp(who) )
        {
                message_vision ("\n$N「啪」的一声倒在地上，挣扎着抽动了几下就死了。\n\n",who);          
                target = who->query_temp("last_damage_from");
                who->clear_condition();
                if( target && present(target,this_object()) && userp(target) 
                 && !target->query("giftmark/2011_zhongqiu2") )
                        who->reward_ob(target);
                if( who )  destruct(who);
                return;                         
        }
        SDS_D->powerup(who);
        if( who->query("combat_exp")>200000 
         && !who->query("giftmark/2011_zhongqiu2") )
        {
                who->add("combat_exp",30000);
                who->add("daoxing",30000);
                who->add("potential",10000);
                tell_object(who,HIY"你得到了武学、道行以及潜能各50000点。\n"NOR);
                who->set("giftmark/2011_zhongqiu2",1);
        }
        tell_object(who,HIC"你退出了中秋地图，祝您中秋快乐!\n"NOR);
        r = who->query("startroom");
        if( !r )
                r = "/d/city/center";
        who->move(r,2); 
        who->start_busy(1);
        return;
}                       


