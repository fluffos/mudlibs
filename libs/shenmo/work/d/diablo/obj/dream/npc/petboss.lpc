inherit NPC;

#include <ansi.h>
#include <login.h>
int do_sm();
void create() {
  set_name("老板", ({ "boss" }));
  set("title", "宠物店老板");
  set("gender", "男性");
  set("age", 32);
  set("long", "一个身着朴素的老板。\n");
  set("attitude", "peaceful");
  setup();
  carry_object("/d/obj/cloth/linen")->wear();

}

void init() {
  object ob;
  ::init();
  add_action("do_sm", "choose");
}


int do_sm() {
  object egg;
  object me = this_player();
  string id = me->query("id");
  string name = me->query("name");
  /*		   
if( (me->query("combat_exp")+me->query("daoxing")) < 4000000 )
	return notify_fail("你的道行太低，不能豢养宠物。\n");
	
if( me->query("egg")) 
	return notify_fail("你已经养了一头宠物了，请用 dispose 归还你现在的宠物n");
*/
  egg = new("/obj/loginload/petegg");
  egg->set("owner", id);
  egg->setup();
  egg->save();
  egg->move(me);
  if (present(egg, me))
    me->set("egg", 1);
  else return notify_fail("ERROE!\n");
  me->save();
  return 1;
}
