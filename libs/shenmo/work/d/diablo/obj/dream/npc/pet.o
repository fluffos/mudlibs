	msg =HIR"\n
"NOR+hs->name()+HIR"突发异彩，一团炙热无比的烈炎立刻卷向$n！\n"NOR;
	ap = me->query("combat_exp");
	dp = target->query("combat_exp");
	if( random(ap + dp) > dp )
		{
		damage=50*jl;
