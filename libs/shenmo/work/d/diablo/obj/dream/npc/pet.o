				id2=lei_name[i+2];
				hs->add("qz",1); //强壮 影响所加气血
				hs->add("mj",1); //敏捷 影响所加防御
				hs->add("ll",3); //力量 影响物理攻击
				hs->add("jl",3); //精力 影响法术攻击
				}
			break;
			case "水" : {
				i=(random(sizeof(shui_name)/3))*3;
