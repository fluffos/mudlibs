int do_watch(string arg)
{
int qz,mj,ll,jl,lvl,exp;
string msg,sx;
object me=this_player();
object hs=this_object();
qz=hs->query("qz"); //强壮 影响所加气血
mj=hs->query("mj"); //敏捷 影响所加防御
ll=hs->query("ll"); //力量 影响物理攻击
jl=hs->query("jl"); //精力 影响法术攻击
lvl=hs->query("lvl"); //等级
exp=hs->query("exp"); //经验值
sx=hs->query("shuxing");

if ( !arg || !id(arg) )
        return notify_fail("你要看什么?\n");


msg=HIY"\n
=======================================================\n\n
\t"+hs->query("long")+NOR HIY"\n
=======================================================\n"NOR;
msg+=HIG"〖名称〗"NOR"："+HIW""+hs->name()+"("+hs->query("id")+")"NOR HIG"\n
〖经验〗"NOR"： "HIW+exp+"/100"+"("+(exp*100)/100+"%)\n"NOR;
msg+=HIG"〖等级〗"NOR"："+HIW""+lvl+" 级\n"NOR HIG"〖属性〗"NOR"："HIC+sx+NOR+"\n";
msg+=HIG"〖敏捷〗"NOR"："HIC+mj+NOR"\t"HIG"〖强壮〗"NOR"："HIC+qz+NOR"\n";
msg+=HIG"〖力量〗"NOR"："HIC+ll+NOR"\t"HIG"〖精力〗"NOR"："HIC+jl+NOR HIY"\n
=======================================================\n\n"NOR;
tell_object(me,msg+NOR);
return 1;
}

object offensive_target(object me)
{
int sz;
object *enemy;

enemy = me->query_enemy();
if( !enemy || !arrayp(enemy) ) return 0;

sz = sizeof(enemy);
if( sz > 4 ) sz = 4;
if( sz > 0 ) return enemy[random(sz)];
else return 0;
}

int do_bianshen(string arg)
{
int i,qz,mj,ll,jl,lvl,add_dodge,add_damage,add_spells,add_kee,add_sen,add_armor,time;
string msg,name,id,sx;
object me=this_player();
object hs=this_object();

qz=hs->query("qz"); //强壮 影响所加气血
mj=hs->query("mj"); //敏捷 影响所加防御
ll=hs->query("ll"); //力量 影响物理攻击
jl=hs->query("jl"); //精力 影响法术攻击
lvl=hs->query("lvl"); //等级
sx=hs->query("shuxing");

if ( me->query("bianhuan") ) //还原
	{
	msg=HIY"\n
忽然从$N身上窜出了一道金光，耀眼到令众人睁不开眼睛。金光在$N身上猛烈的四射
出来，宛如个人形的太阳一般的灿烂。
金光散去后，$N身上的"NOR+hs->query_temp("apply/name")+NOR HIY"渐渐又幻化
成一只$n守侯在$N的身旁。\n"NOR;
	message_vision(msg,me,hs);
	call_out("huanyuan",1,me,hs);
	return 1;
	}

msg=HIY"\n
$n忽然窜出了三道金光，往$N身上一绕，霎时，一阵耀眼到令她睁不开眼睛的金光由
$N身上猛烈的四射出来，宛如个人形的太阳一般的灿烂。\n"NOR;

switch( hs->query("shuxing") ) //"土","风","火","雷","水","光","暗黑","太初","太始",
	{
	case "太始" : { //加防御+气血上限
		msg+=HIY"
好不容易，金光慢慢的消退，出现在众人面前的是一个身着一身覆盖全身，只留下双
眼部位外露，金光闪闪铠甲的$N。\n
只见，$N的兽幻铠发出神圣光芒，搭配他挺拔的身材，宛如"+me->query("gender")+"战神再世，尤其是在
盔甲各处不断的散发出缥缈的白雾，令$N整个人就像是包围在一团烟雾之中，令人望之生畏。\n"NOR;
		i=(random(sizeof(end_armor)/2))*2;
		name=col+end_armor[i]+NOR;
		name+=HIY"圣铠"NOR;
		id=end_armor[i+1];
		hs->set_temp("apply/name",({name}));
		hs->set_temp("apply/id",({id}));
		hs->set_temp("apply/long", ({HIY+sx+"幻兽"+hs->query("name")+"所幻化的终极金铠。\n"NOR}));
		add_armor=(mj+1)*(4+lvl);
		if ( add_armor<100 ) add_armor=100;
		if ( add_armor>1000 ) add_armor=1000;
		add_dodge=(mj+lvl)*5;
		if ( add_dodge<50 ) add_dodge=50;
		if ( add_dodge>200 ) add_dodge=200;
		add_kee=(qz+1)*(5+lvl/5);
		if ( add_kee<500 ) add_kee=500;
		if ( add_kee>5000 ) add_kee=5000;
		add_sen=(qz+1)*(5+lvl/5);
		if ( add_sen<500 ) add_sen=500;
		if ( add_sen>5000 ) add_sen=5000;
		tell_object(me,hs->name()+HIY"覆盖你全身，你觉得自己更加强壮了！\n"NOR);
		me->add("max_kee",add_kee);
		me->set_temp("add_kee",add_kee);
		me->add("max_sen",add_sen);
		me->set_temp("add_sen",add_sen);
		me->add_temp("apply/dodge",add_dodge);
		me->set_temp("add_dodge",add_dodge);
		me->add_temp("apply/armor",add_armor);
		me->set_temp("add_armor",add_armor);
		me->set("kee",(int)me->query("max_kee"));
		me->set("eff_kee",(int)me->query("max_kee"));
		me->set("sen",(int)me->query("max_sen"));
		me->set("eff_sen",(int)me->query("max_sen"));
		me->set("bianhuan",1);
                time=jl;
		time+=lvl;
		time/=2;	
		if ( time<3 ) time=3;
		if ( time>60 ) time=60;
		hs->save();
		me->save();
		hs->move(me);
		call_out("huanyuan",time,me,hs);
		return 1;
		}
