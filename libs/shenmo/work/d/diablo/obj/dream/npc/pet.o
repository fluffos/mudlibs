			hs->add("jl",15); //精力 影响法术攻击
		}
		else 	{
			title=col+"太始"NOR"·";
			hs->set("shuxing","太始");
			me->set("shuxing","太始");
			hs->add("qz",15); //强壮 影响所加气血
			hs->add("mj",15); //敏捷 影响所加防御
			}
		if ( random(5)==2 )
			{
			i=(random(sizeof(end_name2)/4))*4;
			name=end_name2[i+1];
			id=end_name2[i+2];
			id2=end_name2[i+3];
			title+=end_name2[i];
			}
		else   {
			i=(random(sizeof(end_name1)/3))*3;
			name=end_name1[i];
			id=end_name1[i+1];
			id2=end_name1[i+2];
			}
		msg+=HIB+"\n"+
