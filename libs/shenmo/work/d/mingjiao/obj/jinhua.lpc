#include <ansi.h>
#include <weapon.h>
inherit THROWING;
void create() {
  set_name(HIY "夺命金花" NOR, ({ "duoming jinhua", "jinhua" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIW "金花婆婆的专用暗器。\n" NOR);
    set("unit", "些");
    set("base_unit", "枝");
    set("base_weight", 40);
    set("value", 20000);
    set("base_value", 50);
  }
  set_amount(30);
  init_throwing(200);
  setup();
}
