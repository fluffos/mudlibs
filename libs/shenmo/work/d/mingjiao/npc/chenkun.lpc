// by yhq

#include <ansi.h>;
inherit NPC;
#include "/d/9sky/guzhanchang/npc/guai.h"

void create() {
  set_name("成昆", ({ "cheng kun", "cheng", "kun" }));
  set("gender", "男性");
  set("long",
    "金毛狮王谢迅的恩师,也是少林寺的大叛徒\n"
  );
  set("gender", "男性");
  set("age", 80);
  set("class", "human");
  set("attitude", "friendly");
  set("shen_type", 1);
  set("per", 26);
  set("looking", "笑里藏刀。");
  set("int", 30);
  set("max_kee", 6000);
  set("max_sen", 6000);
  set("sen", 6000);
  set("kee", 6000);
  set("max_mana", 6000);
  set("max_force", 6000);
  set("force", 6000);
  set("mana", 6000);
  set("daoxing", 8500000);
  set("combat_exp", 5000000);
  set("max_gin", 1000);
  set("force_factor", 20);
  set("mana_factor", 100);
  set_skill("unarmed", 250);
  set_skill("dodge", 250);
  set_skill("parry", 250);
  set_skill("sword", 250);
  set_skill("stick", 400);
  set_skill("spells", 250);
  set_skill("chanzong", 250);
  set_skill("banruo-zhang", 250);
  set_skill("jingang-leg", 250);
  set_skill("yijinjing", 250);
  set_skill("force", 250);
  set_skill("zui-gun", 250);
  set_skill("shaolin-sword", 250);
  set_skill("shaolin-shenfa", 250);
  map_skill("spells", "chanzong");
  map_skill("unarmed", "banruo-zhang");
  map_skill("force", "yijinjing");
  map_skill("stick", "zui-gun");
  map_skill("parry", "jingang-leg");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("sword", "shaolin-sword");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "sword", "wuying" :),
    (: exert_function, "recover" :),
    (: exert_function, "heal" :),
  }));
  create_family("少林寺", 34, "弟子");
  setup();
  carry_object("/d/mingjiao/obj/bag.lpc");
  carry_object("/d/obj/weapon/sword/qinghong")->wield();
  carry_object("/d/obj/armor/jinjia")->wear();
}


void init() {
  add_action("do_none", "perform");
  add_action("do_none", "cast");
  add_action("do_none", "ji");
}
int do_none() {
  object me = this_object();
  message_vision("想杀我？\n", me);
  return 1;
}


void die() {

  object ob = query_temp("my_killer");

  if (ob && ob->query("mingjiao/chenkun") != "done") {
    ob->start_busy(3);
    ob->set("mingjiao/chenkun", "done");
    ob->set("mingjiao/xiexun", 1);
    ob->save();
    tell_object(ob, "你为武林除了一害");

  }
  ::die();
}
