//zhangwuji.c

#include <ansi.h>

inherit F_MASTER;
inherit NPC;

void greeting(object ob);
void create()
{
    seteuid(getuid());
    set_name("张无忌", ({ "zhang wuji", "zhang", "wuji" }));
    set("long", "明教教主张无忌，统领天下十万教众，豪气干云，叱咤千秋，\n"
               +"「九阳神功」、「乾坤大挪移」独步天下，是江湖中不世出的\n"
               +"少年英雄。\n");
    set("title",HIG "明教"HIM"教主"NOR);
    set("gender", "男性");
    set("age", 20);
    set("attitude", "friendly");
        set("class", "human");

    set("per", 28);
    set("str", 30);
    set("int", 30);
    set("con", 30);
    set("dex", 30);

    set("kee", 15000);
    set("max_kee", 15000);
    set("sen", 15000);
    set("max_sen", 15000);
    set("force", 30000);
    set("max_force", 12000);
    set("mana", 12000);
    set("max_mana", 12000);
    set("force_factor", 400);
    set("mana_factor", 300);
    set("combat_exp", 150000000);
    set("daoxing",15000000); 
   
    set_skill("force", 500);
    set_skill("unarmed", 500);
    set_skill("dodge", 500);
    set_skill("parry", 500);
    set_skill("sword", 500);
    set_skill("shenghuo-shengong", 500);
    set_skill("qiankun-danuoyi", 500);
    set_skill("qishang-quan", 500);
    set_skill("shenghuo-ling",500);
    set_skill("spells",500);
    set_skill("literate",500);
    set_skill("qiankun-danuoyi",500);
    set_skill("qingfu-shenfa",500);
   
    map_skill("force", "shenghuo-shengong");
    map_skill("dodge", "qingfu-shenfa");
    map_skill("unarmed", "qishang-quan");
    map_skill("sword","shenghuo-ling");
    map_skill("parry","shenghuo-ling");
    map_skill("spells","qiankun-danuoyi");
  
    create_family("明教",34, "教主");

    set("chat_chance",2);
    set("chat_msg",({
 "张无忌愤然说道“大丈夫当以国为家, 捐躯沙场, 抗元大业未成, 同辈仍需努力!”\n",
        "张无忌叹道“人生失一知己, 生亦何欢, 死亦何忧, 敏儿, 你在哪里?”\n",
        "张无忌道“我教兄弟听了: 生于乱世, 当克己为公, 行侠仗义, 荡寇驱魔!”\n",
 }));
  set("chat_chance_combat", 50);
       set("chat_msg_combat", ({
               (: perform_action, "sword", "yin" :),
               (: perform_action, "unarmed", "yihuanghu" :),
               (: perform_action, "unarmed", "jingshi" :), 
}));
   

    set("inquiry",([
	          "金毛狮王" : "那是我义父谢大侠的职司。\n",
          "谢逊" :     "他就是我义父的大号。\n",
          "张翠山" :   "你想找我父亲有事麽? \n",
          "殷素素" :   "我妈是明尊座下紫微堂主。\n",
          "张三丰" :   "我太师父近来可好? \n",
          "赵敏" :     "人生失一知己, 生亦何欢, 死亦何忧, 敏儿, 你在哪里?\n",
          "小昭" :     "小昭我可一直念着她的好处。\n",
          "周芷若" :   "找她就去峨嵋山, 别来烦我。\n",
    ]));
    setup();
    carry_object("/d/mingjiao/obj/baipao")->wear();
    add_money("zuanshi",10);
}

