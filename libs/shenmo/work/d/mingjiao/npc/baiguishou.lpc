#include <ansi.h>

inherit NPC;
inherit F_MASTER;
inherit F_UNIQUE;
string ask_me();

void create()
{
	set_name("白龟寿", ({ "bai guishou", "bai", "guishou", }));
	set("long",
        "他是一位两鬓斑白的老者，身穿一件白布长袍。\n"
        "他脸上总是浮现出可亲的微笑，但有时又透出一丝狡谲。\n"
	);

    	set("title",HIG "明教" BLU "玄武坛" NOR "坛主");

	set("gender", "男性");
	set("attitude", "friendly");
        set("age", 42);
	set("per", 22);
	set("str", 30);
	set("int", 30);
	set("con", 30);
	set("dex", 30);

	set("kee", 12000);
	set("max_sen", 12000);
	set("sen", 12000);
	set("max_kee", 12000);
	set("force", 20000);
	set("max_force", 8000);
	set("mana", 8000);
        set("max_mana", 8000);
     	set("combat_exp", 9000000);
        set("daoxing",9000000);
        set("force_factor",300);
	
	set_skill("force", 350);
	set_skill("dodge", 350);
	set_skill("unarmed", 350);
	set_skill("parry", 350);
	set_skill("throwing", 500);
	set_skill("duoming-jinhua", 500);
	set_skill("literate", 350);
	set_skill("jiuyang-shengong", 350);
	set_skill("qingfu-shenfa", 350);
	set_skill("sougu", 350);
        set_skill("spells",350);
        set_skill("qiankun-danuoyi",350);
	
	map_skill("force", "jiuyang-shengong");
	map_skill("dodge", "qingfu-shenfa");
	map_skill("unarmed", "sougu");
	map_skill("parry", "sougu");
	map_skill("throwing", "duoming-jinhua");
	map_skill("spells","qiankun-danuoyi");

	set("chat_chance_combat", 50);
	set("chat_msg_combat", ({
		   (: perform_action, "throwing", "duo" :),
	}) );
	setup();

        carry_object("/d/mingjiao/obj/baipao")->wear();
}

void init()
{
	object me,ob;
	me = this_object () ;
	ob = this_player () ;

	::init();

	add_action("do_join","join");
	
	if( interactive(ob) && !is_fighting() )
	{
		remove_call_out("greeting");
		call_out("greeting", 1, me, ob);
	}
}
