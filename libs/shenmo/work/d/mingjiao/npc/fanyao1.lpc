#include "ansi.h"

inherit NPC;
inherit F_MASTER;
inherit F_UNIQUE;

string ask_me();

void create() {
  set_name("范遥", ({ "fan yao", "fan", "yao", }));
  set("long",
    "他是一位带发修行的头陀，身穿白布长袍。\n"
    "他的脸上七七八八的全是伤疤，简直看不出本来面目了。\n"
  );

  set("title", HIG "明教" HIR "光明右使" NOR);
  set("gender", "男性");
  set("attitude", "peaceful");
  set("class", "bonze");

  set("age", 38);
  set("per", 12);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("max_kee", 10000);
  set("max_sen", 10000);
  set("force", 10000);
  set("max_force", 10000);
  set("force_factor", 50);
  set("combat_exp", 4000000);
  set("daoxing", 4000000);
  set("mana", 10000);
  set("max_mana", 10000);

  set_skill("force", 200);
  set_skill("dodge", 200);
  set_skill("parry", 200);
  set_skill("unarmed", 200);
  set_skill("sword", 200);
  set_skill("hanbing-mianzhang", 200);
  set_skill("literate", 380);
  set_skill("jiuyang-shengong", 380);
  set_skill("qiankun-danuoyi", 380);
  set_skill("spells", 380);

  map_skill("force", "jiuyang-shengong");
  map_skill("parry", "hanbing-mianzhang");
  map_skill("unarmed", "hanbing-mianzhang");
  map_skill("spells", "qiankun-danuoyi");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed", "xixueqingfu" :),

  }));

  create_family("明教", 34, "光明右使");

  setup();

  carry_object("/d/mingjiao/obj/baipao")->wear();
}

void init() {
  object me, ob;
  me = this_object();
  ob = this_player();

  ::init();

  if (interactive(ob) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, me, ob);
  }
}

void attempt_apprentice(object ob) {
  command("say 我不收徒的，你找各位法王去。");
  return 0;
}

#include "fanyao.h"
