// PengYingYu.c
// pal 1997.05.11

inherit NPC;
inherit F_UNIQUE;
#include <ansi.h>

void create()
{
	set_name("彭莹玉", ({ "peng yingyu", "peng", "yingyu", }));
	set("long",
        "他是一位高高瘦瘦的僧人，身穿一件白布长袍。\n"
        "\n"
	);

        set("title", HIG "明教" NOR "五散人");
        set("nickname", "彭和尚");
	set("gender", "男性");
	set("attitude", "friendly");
        set("class", "bonze");

      set("age", 54);
	set("str", 25);
	set("int", 25);
	set("con", 25);
	set("dex", 25);
	set("max_kee", 3000);
	set("max_sen", 3000);
	set("force", 4000);
	set("max_force", 4000);
	set("force_factor", 200);
	set("combat_exp", 4000000);
	set("daoxing",4000000);
        set("mana",4000);
        set("max_mana",4000);

	set_skill("force", 150);
	set_skill("jiuyang-shengong", 150);
	set_skill("dodge", 150);
	set_skill("qingfu-shenfa", 150);
	set_skill("unarmed", 150);
	set_skill("jinwu-daofa", 150);
	set_skill("parry", 150);
	set_skill("qiankun-danuoyi", 150);
	set_skill("literate", 150);
        set_skill("spells",150);
	map_skill("force", "jiuyang-shengong");
	map_skill("dodge", "qingfu-shenfa");
	map_skill("blade", "jinwu-daofa");
	map_skill("parry", "jinwu-daofa");
        map_skill("spells","qiankun-danuoyi");
	
        create_family("明教", 3, "五散人");

	setup();

        carry_object("/d/mingjiao/obj/baipao")->wear();
        carry_object("/d/obj/weapon/blade/blade")->wield();
}

void init()
{
	::init();

	if (interactive(this_player()) && this_player()->query_temp("fighting"))
	{
		COMBAT_D->do_attack(this_object(), this_player(), query_temp("weapon") );
		this_player()->add_temp("beat_count", 1);
	}       
}
