inherit NPC;

#include <ansi.h>

void create()
{
        set_name("殷无禄", ({ "yin wulu", "yin", "wulu", }));
	set("long",
        "他是一位老者，身穿一件白布长袍。\n"
        "他是白眉鹰王殷天正的仆从。一双怪眼正恶狠狠地瞪着你呢！\n"
	);

        set("title", HIG "明教" HIC "天市堂" NOR "属下");
	set("gender", "男性");
	set("attitude", "friendly");
        set("class", "fighter");

        set("age", 58);
	set("shen_type", 1);
	set("str", 25);
	set("int", 25);
	set("con", 25);
	set("dex", 25);
	set("max_kee", 1000);
	set("max_sen", 1000);
	set("force", 4000);
	set("max_force", 4000);
	set("force_factor", 200);
	set("combat_exp", 5000000);
	set("max_mana",4000);
        set("mana",4000);
        set("daoxing",5000000);

	set_skill("force", 200);
	set_skill("jiuyang-shengong", 200);
	set_skill("dodge", 200);
	set_skill("qingfu-shenfa", 200);
	set_skill("unarmed", 200);
	set_skill("sougu", 200);
	set_skill("parry", 200);
	set_skill("buddhism", 200);
	set_skill("literate", 85);
        set_skill("spells",200);
        set_skill("qiankun-danuoyi",200);

	map_skill("force", "jiuyang-shengong");
	map_skill("dodge", "qingfu-shenfa");
	map_skill("unarmed", "sougu");
	map_skill("parry", "sougu");
        map_skill("spells","qiankun-danuoyi");
        create_family("明教", 4, "天市堂属下");

	setup();

        carry_object("/d/mingjiao/obj/baipao")->wear();
}

