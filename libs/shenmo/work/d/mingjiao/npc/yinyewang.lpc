// add by fang@tsrj 2005.3.7
if( (int)ob->query("shilian", 1) < 1 ) {
        command("say 这位" + RANK_D->query_respect(ob) + "你的功夫太浅，现在收你也是勉为其难，不如作罢！\n");       
        return;
       }
	command("say 好，我就收下你这位好徒弟！");
	command("recruit " + ob->query("id"));
        ob->set("mingjiao/men",1);
        ob->set("title", MAG "天微堂香主"NOR);
	return;
}
