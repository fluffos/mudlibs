// WeiYiXiao.c
// pal 1997.05.10

#include "ansi.h"

inherit NPC;
inherit F_MASTER;
inherit F_UNIQUE;

void create()
{
	set_name("韦一笑", ({"wei yixiao", "wei", "yixiao",}));
	set("long",
		"他长得活象是一只青翼大蝙蝠。\n"
		"他的脸色灰扑扑的。\n"
	);

	set("title",HIG "明教" HIC "青翼蝠王" NOR);
	set("gender", "男性");
	set("attitude", "peaceful");
        set("class", "human");

	set("age", 48);
	set("per", 19);
	set("str", 30);
	set("int", 30);
	set("con", 30);
	set("dex", 30);

	set("kee", 12000);
	set("max_sen", 12000);
	set("sen", 12000);
	set("max_kee", 12000);
	set("force", 20000);
	set("max_force", 8000);
	set("mana", 8000);
        set("max_mana", 8000);
     	set("combat_exp", 9000000);
        set("daoxing",9000000);
        set("force_factor",300);
	
	set_skill("force", 350);
	set_skill("dodge", 350);
	set_skill("unarmed", 350);
	set_skill("parry", 350);
	set_skill("sword", 350);
	set_skill("jinwu-daofa", 350);
	set_skill("literate", 350);
	set_skill("shenghuo-shengong", 350);
	set_skill("qingfu-shenfa", 350);
	set_skill("hanbing-mianzhang", 350);
        set_skill("spells",350);
        set_skill("qiankun-danuoyi",350);
	
	map_skill("force", "shenghuo-shengong");
	map_skill("dodge", "qingfu-shenfa");
	map_skill("unarmed", "hanbing-mianzhang");
	map_skill("parry", "hanbing-mianzhang");
	map_skill("blade", "jinwu-daofa");
	map_skill("spells","qiankun-danuoyi");
	set("chat_chance_combat", 50);
	set("chat_msg_combat", ({
		   (: perform_action, "unarmed", "xixueqingfu" :),
	}) );
	create_family("明教",34, "法王");
	setup();

        carry_object("/d/mingjiao/obj/baipao")->wear();
}

void init()
{
	object me,ob;
	me = this_object () ;
	ob = this_player () ;

	::init();

	if (interactive(this_player()) && this_player()->query_temp("fighting"))
	{
		COMBAT_D->do_attack(this_object(), this_player(), query_temp("weapon") );
		this_player()->add_temp("beat_count", 1);
	}       
	if( interactive(ob) && !is_fighting() )
	{
		remove_call_out("greeting");
		call_out("greeting", 1, me, ob);
	}
}

void attempt_apprentice(object ob)
{
	if((int)ob->query("mingjiao/men")<1)
	{
		command("say 不可越级拜师。");
		return 0;
	}
	if((string)ob->query("gender")=="无性")
	{
		command("say 你阳气不足，习我功夫恐将走火如魔。");
		return 0;
	}
if( (int)ob->query_skill("jiuyang-shengong", 1) < 280 ) {
        command("say 这位" + RANK_D->query_respect(ob) + "对我明教内功领会还不够深，现在收你也是勉为其难，不如作罢！\n");              
        return;
        }
if( (int)ob->query_skill("qiankun-danuoyi", 1) < 280 ) {
        command("say 这位" + RANK_D->query_respect(ob) + "对我明教心法领会还不够深，现在收你也是勉为其难，不如作罢！\n");              
        return;
        }
	command("say 好，我就收下你这位好徒弟！");
	command("say 你的职司就是本教的光明使者。");
	command("recruit " + ob->query("id"));
        ob->set("mingjiao/tang",1);
ob->set("class","human");
	ob->set("title", HIC"青翼蝠王坐下护法"NOR);
	return;
}
