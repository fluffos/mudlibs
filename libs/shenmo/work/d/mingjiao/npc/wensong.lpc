// WenSong.c
// pal 1997.05.11
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
inherit F_UNIQUE;

void create()
{
        set_name("闻苍松", ({ "wen cangsong", "wen", "cangsong", }));
	set("long",
        "他是一位高大魁伟的中年男子，身穿一件白布长袍。\n"
        "他天生神力，手中的两头狼牙棒有万夫不当之勇，真是一条威风凛凛的汉子。\n"
	);

        set("title", HIG "明教" HIC "巨木旗" NOR "掌旗使");
	set("gender", "男性");
	set("attitude", "friendly");
        set("class", "mingjiao");
 set("age", 58);
	set("shen_type", 1);
	set("str", 25);
	set("int", 25);
	set("con", 25);
	set("dex", 25);
	set("max_kee", 1000);
	set("max_sen", 1000);
	set("force", 3000);
	set("max_force", 3000);
	set("force_factor", 100);
	set("combat_exp", 1000000);
	set("max_mana",1000);
        set("mana",1000);
        set("daoxing",1000000);

	set_skill("force", 80);
	set_skill("shenghuo-ling", 80);
	set_skill("dodge", 80);
	set_skill("qingfu-shenfa", 80);
	set_skill("unarmed", 80);
	set_skill("sougu", 80);
	set_skill("parry", 80);
	set_skill("literate", 80);
        set_skill("sword",100);
        set_skill("spells",80);
        set_skill("qiankun-danuoyi",80);
        set_skill("shenghuo-shengong",80);

	map_skill("force", "shenghuo-shengong");
	map_skill("dodge", "qingfu-shenfa");
	map_skill("unarmed", "sougu");
	map_skill("parry", "sougu");
        map_skill("spells","qiankun-danuoyi");
  create_family("明教",37, "弟子");
	setup();

        carry_object("/d/mingjiao/obj/baipao")->wear();
}

void init()
{
	object me,ob;
	me = this_object () ;
	ob = this_player () ;

	::init();

	if( interactive(ob) && !is_fighting() )
	{
		remove_call_out("greeting");
		call_out("greeting", 1, me, ob);
	}
}


void attempt_apprentice(object ob)
{
	if((int)ob->query("int")<20)
	{
		command("say 你的悟性太低了，不适合学习我的功夫。");
		return 0;
	}
	if((string)ob->query("gender")=="无性")
	{
		command("say 你阳气不足，习我功夫恐将走火如魔。");
		return 0;
	}
	command("say 好，我就收下你这位好徒弟！");
	command("recruit " + ob->query("id"));
        ob->set("mingjiao/degree",1);
        ob->set("class","mingjiao");
        ob->set("title",HIG "明教" HIC "巨木旗" NOR "教众");
	return;
}