inherit NPC;
inherit F_MASTER;
#include <ansi.h>
string ask_mieyao(object me);
string ask_cancel();
#include "/d/panshi/panshi.h"


void create() {
  set_name("冷谦", ({ "leng qian", "leng", "qian", }));
  set("long",
    "他是一位冷冷的老者，身穿一件白布长袍。\n"
    "他说话极为简捷，便是杀了他的头也不肯多说半句废话。\n"
  );

  set("title", HIG "明教" NOR "五散人");
  set("nickname", "冷面先生");
  set("gender", "男性");
  set("attitude", "friendly");
  set("class", "mingjiao");

  set("age", 54);
  set("str", 25);
  set("int", 25);
  set("con", 25);
  set("dex", 25);
  set("max_kee", 3000);
  set("max_sen", 3000);
  set("force", 4000);
  set("max_force", 4000);
  set("force_factor", 200);
  set("combat_exp", 4000000);
  set("daoxing", 4000000);
  set("mana", 4000);
  set("max_mana", 4000);

  set_skill("force", 150);
  set_skill("jiuyang-shengong", 150);
  set_skill("dodge", 150);
  set_skill("qingfu-shenfa", 150);
  set_skill("unarmed", 150);
  set_skill("jinwu-daofa", 150);
  set_skill("parry", 150);
  set_skill("qiankun-danuoyi", 150);
  set_skill("literate", 150);
  set_skill("spells", 150);
  map_skill("force", "jiuyang-shengong");
  map_skill("dodge", "qingfu-shenfa");
  map_skill("blade", "jinwu-daofa");
  map_skill("parry", "jinwu-daofa");
  map_skill("spells", "qiankun-danuoyi");

  set("chat_chance", 50);
  set("chat_msg", ({
    (: msg :),
  }));
  create_family("明教", 3, "五散人");

  setup();



  set("inquiry", ([

    "惩恶": (: ask_mieyao :),
    "cancel": (: ask_cancel :),
  ]));


  carry_object("/d/mingjiao/obj/baipao")->wear();
  carry_object("/d/obj/weapon/blade/blade")->wield();
}

string ask_cancel() {
  object me = this_player();
  if ((int)me->query_temp("m_mieyao")) {
    me->add("daoxing", -2000);
    me->delete_temp("m_mieyao");
    me->delete("secmieyao");
    me->delete("secmieyao/type");
    me->delete("secmieyao/location");
    me->delete("secmieyao/place");
    me->delete("secmieyao/name");
    me->delete("secmieyao/id");
    return ("哎，我也不怪你，以后你可得努力哦！");
  } else {
    return ("你有任务吗？！");
  }
}
string ask_mieyao(object me) {
  me = this_player();
  if ((string)me->query("family/family_name") == "明教") {
    tell_room(environment(me), "冷谦说道.....\n");
    return "/d/obj/mieyao"->query_yao(me);
  }
  return ("本山人不知道你在说些什么。");
}
