inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void create()
{
    set_name("李天垣", ({ "li tianyuan", "li", "tianyuan", }));
	set("long",
        "他是一位看起来很慈祥的老者，身穿一件白布长袍。\n"
        "他是白眉鹰王殷天正的师弟。一双眼睛总是笑眯眯的，但不知为什么，他的下属\n"
        "对他畏如蛇蝎。\n"
    );

        set("title", HIG "明教" CYN "天市堂" NOR "堂主" );
        set("nickname", "慈眉善目");
	set("gender", "男性");
	set("attitude", "friendly");
       set("age", 58);
	set("shen_type", 1);
	set("str", 25);
	set("int", 25);
	set("con", 25);
	set("dex", 25);
	set("max_kee", 5000);
	set("max_sen", 5000);
	set("force", 6000);
	set("max_force", 6000);
	set("force_factor", 200);
	set("combat_exp", 5000000);
	set("max_mana",6000);
        set("mana",6000);
        set("daoxing",5000000);

	set_skill("force", 300);
	set_skill("shenghuo-shengong", 300);
	set_skill("dodge", 300);
	set_skill("qingfu-shenfa", 300);
	set_skill("unarmed", 300);
	set_skill("sougu", 300);
	set_skill("parry", 300);
	set_skill("literate", 300);
        set_skill("spells",300);
        set_skill("qiankun-danuoyi",300);

	map_skill("force", "shenghuo-shengong");
	map_skill("dodge", "qingfu-shenfa");
	map_skill("unarmed", "sougu");
	map_skill("parry", "sougu");
        map_skill("spells","qiankun-danuoyi");

        create_family("明教", 3, "天市堂堂主");

	setup();

    carry_object("/d/mingjiao/obj/baipao")->wear();
}


void attempt_apprentice(object ob)
{
	if((int)ob->query("mingjiao/qi")<1)
	{
		command("say 我明教拜师讲究循序渐进。");
		return 0;
	}
	if((string)ob->query("gender")=="无性")
	{
		command("say 你阳气不足，习我功夫恐将走火如魔。");
		return 0;
	}
if( (int)ob->query_skill("jiuyang-shengong", 1) < 180 ) {
        command("say 这位" + RANK_D->query_respect(ob) + "对我明教内功领会还不够深，现在收你也是勉为其难，不如作罢！\n");              
        return;
        }
if( (int)ob->query_skill("qiankun-danuoyi", 1) < 180 ) {
        command("say 这位" + RANK_D->query_respect(ob) + "对我明教心法领会还不够深，现在收你也是勉为其难，不如作罢！\n");              
        return;
        }
	command("say 好，我就收下你这位好徒弟！");
	command("recruit " + ob->query("id"));
        ob->set("mingjiao/men",1);
        ob->set("title",HIG"天市堂香主"NOR);
	return;
}
