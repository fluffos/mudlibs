// XieXun.c
// pal 1997.05.09

#include "ansi.h"

inherit NPC;
inherit F_MASTER;
inherit F_UNIQUE;

void create() {
  set_name("谢逊", ({ "xie xun", "xie", "xun", }));
  set("long",
    "他是一位身材魁伟异常的的老者，身穿一件白布长袍。\n"
    "他满头黄发，威风凛凛，真如天神一般，只是两只眼睛并不睁开。\n"
  );

  set("title", HIG "明教" HIY "金毛狮王" NOR);
  set("level", 9);
  set("gender", "男性");
  set("class", "human");
  set("attitude", "peaceful");

  set("per", 28);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("kee", 15000);
  set("max_kee", 15000);
  set("sen", 15000);
  set("max_sen", 15000);
  set("force", 30000);
  set("max_force", 12000);
  set("mana", 12000);
  set("max_mana", 12000);
  set("force_factor", 400);
  set("mana_factor", 300);
  set("combat_exp", 15000000);
  set("daoxing", 15000000);

  set_skill("force", 400);
  set_skill("unarmed", 500);
  set_skill("dodge", 400);
  set_skill("parry", 400);
  set_skill("sword", 400);
  set_skill("shenghuo-shengong", 400);
  set_skill("qiankun-danuoyi", 400);
  set_skill("qishang-quan", 600);
  set_skill("shenghuo-ling", 400);
  set_skill("spells", 400);
  set_skill("literate", 400);
  set_skill("qiankun-danuoyi", 400);
  set_skill("qingfu-shenfa", 400);

  map_skill("force", "shenghuo-shengong");
  map_skill("dodge", "qingfu-shenfa");
  map_skill("unarmed", "qishang-quan");
  map_skill("sword", "shenghuo-ling");
  map_skill("parry", "shenghuo-ling");
  map_skill("spells", "qiankun-danuoyi");

  set("chat_chance_combat", 100);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed", "yihuanghu" :),
    (: perform_action, "unarmed", "jingshi" :),
  }));

  create_family("明教", 34, "法王");
  setup();
  carry_object("/d/mingjiao/obj/baipao")->wear();
}

void init() {
  object me, ob;
  me = this_object();
  ob = this_player();

  ::init();

  if (interactive(this_player()) && this_player()->query_temp("fighting")) {
    COMBAT_D->do_attack(this_object(), this_player(), query_temp("weapon"));
    this_player()->add_temp("beat_count", 1);
  }
  if (interactive(ob) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, me, ob);
  }
}

int accept_object(object who, object ob) {
  object qkbook;
  object yixin = present("yi xin", ob);
  if (!yixin) {
    qkbook = new("/d/mingjiao/obj/qiankun");
    say("谢逊说道：谢谢你终于让我知道了阳教主的下落，我无以酬谢，这张羊皮就聊表谢意吧。\n"
      "谢逊把" + qkbook->query("name") + "交给了" + who->query("name") + "。\n");
    qkbook->move(who);
    command("rumor " + who->query("name") + "拿到乾坤大挪移心法了。\n");
    set("qk_trigger", 1);

  }
  return 1;
}

void attempt_apprentice(object ob) {
  if ((int)ob->query("mingjiao/men") < 1) {
    command("say 不可越级拜师。");
    return 0;
  }
  if ((int)ob->query("mingjiao/xiexun") < 1) {
    command("say 去帮我杀了成昆吧。");
    return 0;
  }
  if ((string)ob->query("gender") == "无性") {
    command("say 你阳气不足，习我功夫恐将走火如魔。");
    return 0;
  }
  if ((int)ob->query_skill("jiuyang-shengong", 1) < 320) {
    command("say 这位" + RANK_D->query_respect(ob) + "对我明教内功领会还不够深，现在收你也是勉为其难，不如作罢！\n");
    return;
  }
  if ((int)ob->query_skill("qiankun-danuoyi", 1) < 320) {
    command("say 这位" + RANK_D->query_respect(ob) + "对我乾坤大挪移绝学领会还不够深，现在收你也是勉为其难，不如作罢！\n");
    return;
  }
  command("say 好，我就收下你这位好徒弟！");
  command("say 你的职司就是本教的护法尊者。");
  command("recruit " + ob->query("id"));
  ob->set("mingjiao/tang", 1);
  ob->set("class", "human");
  ob->set("title", HIY "金毛狮王座下护法" NOR);
  return;
}
