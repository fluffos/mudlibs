#include "ansi.h"
inherit NPC;
string ask_for_join();
void create()
{
	set_name("接引使", ({"jieyin shi","jieyin","shi",}));
	set("long",
		"他是一位精明的中年人，身穿一件白布长袍。\n"
		"他正在上下打量着你。\n"
		);

	set("title", HIG "明教" NOR);

	set("gender", "男性");
	set("attitude", "friendly");

	set("age", 30);
	set("shen_type", 1);
	set("str", 25);
	set("int", 17);
	set("con", 50);
	set("dex", 21);
	set("max_kee", 450);
	set("max_sen", 200);
	set("force", 350);
	set("max_force", 350);
	set("force_factor", 30);
	set("combat_exp", 500000);

	set_skill("force", 130);
	set_skill("jiuyang-shengong", 130);
	set_skill("dodge", 150);
	set_skill("shaolin-shenfa", 150);
	set_skill("unarmed", 150);
	set_skill("qishang-quan", 150);
	set_skill("parry", 130);
	set_skill("buddhism", 130);
	set_skill("literate", 130);

	map_skill("force", "jiuyang-shengong");
	map_skill("dodge", "shaolin-shenfa");
	map_skill("unarmed", "qishang-quan");
	map_skill("parry", "qishang-quan");
set("chat_chance",2);
    set("chat_msg",({
 "接引使高兴的跳了起来“欢迎大家来我明教参观!”\n",
       
 }));
	setup();

        carry_object("/d/mingjiao/obj/baipao")->wear();
}

