#include "ansi.h"
inherit NPC;
inherit F_MASTER;

void create() {
  set_name("黛姬丝", ({ "dai jisi", "dai", "jisi", }));
  set("long",
    "他是一位相貌丑陋的老妇人，身穿一件白色长袍。\n"
    "不知为何一个人寡居在这荒岛上，听说她以前可\n"
    "是个大美人儿。\n"
  );

  set("title", HIG "明教" MAG "紫衫龙王" NOR);
  set("level", 9);
  set("gender", "女性");
  set("attitude", "peaceful");


  set("age", 42);
  set("per", 22);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("kee", 12000);
  set("max_sen", 12000);
  set("sen", 12000);
  set("max_kee", 12000);
  set("force", 20000);
  set("max_force", 8000);
  set("mana", 8000);
  set("max_mana", 8000);
  set("combat_exp", 4000000);
  set("daoxing", 9000000);
  set("force_factor", 50);

  set_skill("force", 350);
  set_skill("dodge", 200);
  set_skill("unarmed", 200);
  set_skill("parry", 200);
  set_skill("throwing", 200);
  set_skill("duoming-jinhua", 200);
  set_skill("literate", 350);
  set_skill("jiuyang-shengong", 350);
  set_skill("qingfu-shenfa", 200);
  set_skill("sougu", 350);
  set_skill("spells", 350);
  set_skill("qiankun-danuoyi", 350);

  map_skill("force", "jiuyang-shengong");
  map_skill("dodge", "qingfu-shenfa");
  map_skill("unarmed", "sougu");
  map_skill("parry", "sougu");
  map_skill("throwing", "duoming-jinhua");
  map_skill("spells", "qiankun-danuoyi");

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "throwing", "duo" :),
  }));
  create_family("明教", 34, "法王");
  setup();

  carry_object("/d/mingjiao/obj/baipao")->wear();
  carry_object("/d/mingjiao/obj/jinhua")->wield();
}

void init() {
  object me, ob;
  me = this_object();
  ob = this_player();

  ::init();

  if (interactive(this_player()) && this_player()->query_temp("fighting")) {
    COMBAT_D->do_attack(this_object(), this_player(), query_temp("weapon"));
    this_player()->add_temp("beat_count", 1);
  }
  if (interactive(ob) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, me, ob);
  }
}

void attempt_apprentice(object ob) {
  if ((int)ob->query("mingjiao/men") < 1) {
    command("say 不可越级拜师。");
    return 0;
  }
  if ((string)ob->query("gender") == "无性") {
    command("say 你阳气不足，习我功夫恐将走火如魔。");
    return 0;
  }
  if ((int)ob->query_skill("jiuyang-shengong", 1) < 280) {
    command("say 这位" + RANK_D->query_respect(ob) + "对我明教内功领会还不够深，现在收你也是勉为其难，不如作罢！\n");
    return;
  }
  command("say 好，我就收下你这位好徒弟！");
  command("say 你的职司就是本教的护法使者。");
  command("recruit " + ob->query("id"));
  ob->set("mingjiao/tang", 1);
  ob->set("title", MAG "紫衫龙王座下护法" NOR);
  return;
}
