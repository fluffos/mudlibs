// TuoBa.c
// pal 1997.05.14

#include "ansi.h"

inherit NPC;

void create()
{
        set_name("拓跋", ({ "tuoba", }));
	set("long",
        "他是一位带发修行的头陀，身穿一件白布长袍。\n"
        "他个子不高，但很结实，看上去颇为纯朴。可是脸上经常浮现出奇怪的笑容，让\n"
        "人有些摸不着头脑。\n"
	);

	set("title",HIG "明教" NOR "风字门门主");
	set("gender", "男性");
	set("attitude", "friendly");
	set("class", "mingjiao");

	 set("age", 58);
	set("shen_type", 1);
	set("str", 25);
	set("int", 25);
	set("con", 25);
	set("dex", 25);
	set("max_kee", 1000);
	set("max_sen", 1000);
	set("force", 3000);
	set("max_force", 3000);
	set("force_factor", 100);
	set("combat_exp", 1000000);
	set("max_mana",1000);
        set("mana",1000);
        set("daoxing",1000000);

	set_skill("force", 200);
	set_skill("shenghuo-shengong", 200);
	set_skill("dodge", 200);
	set_skill("qingfu-shenfa", 200);
	set_skill("unarmed", 200);
	set_skill("sougu", 200);
	set_skill("parry", 200);
	set_skill("literate", 200);
        set_skill("spells",200);
        set_skill("qiankun-danuoyi",200);
        set_skill("sword",200);

	map_skill("force", "shenghuo-shengong");
	map_skill("dodge", "qingfu-shenfa");
	map_skill("unarmed", "sougu");
	map_skill("parry", "sougu");
        map_skill("spells","qiankun-danuoyi");
  create_family("明教",37, "弟子");
	setup();

        carry_object("/d/mingjiao/obj/baipao")->wear();
}

void init()
{
	object me,ob;
	me = this_object () ;
	ob = this_player () ;

	::init();

	if( interactive(ob) && !is_fighting() )
	{
		remove_call_out("greeting");
		call_out("greeting", 1, me, ob);
	}
}


void attempt_apprentice(object ob)
{
	if((int)ob->query("mingjiao/degree")<1)
	{
		command("say 我教拜师必须循序渐进。");
		return 0;
	}
	if((string)ob->query("gender")=="无性")
	{
		command("say 你阳气不足，习我功夫恐将走火如魔。");
		return 0;
	}
if( (int)ob->query_skill("jiuyang-shengong", 1) < 75 ) {
        command("say 这位" + RANK_D->query_respect(ob) + "对我明教内功领会还不够深，现在收你也是勉为其难，不如作罢！\n");              
        return;
        }
if( (int)ob->query_skill("sword", 1) < 100 ) {
        command("say 你的剑法还不够!\n");
return;
}
	command("say 好，我就收下你这位好徒弟！");
	command("recruit " + ob->query("id"));
        ob->set("class","mingjiao");
        ob->set("mingjiao/qi",1);
        ob->set("title",HIG "明教"NOR"风字门教众");
	return;
}