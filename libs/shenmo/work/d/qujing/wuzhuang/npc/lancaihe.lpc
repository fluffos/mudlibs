#include <ansi.h>
inherit NPC;

string family_fabao();

void create() {
  set_name("蓝采和", ({ "lan caihe", "lan", "caihe" }));
  set("gender", "男性");
  set("age", 18);
  set("per", 20);
  set("long", "一位面腆和善的少年。\n");
  set("class", "xian");
  set("combat_exp", 120000);
  set("daoxing", 200000);

  set("attitude", "peaceful");
  create_family("五庄观", 3, "弟子");
  set_skill("unarmed", 60);
  set_skill("wuxing-quan", 60);
  set_skill("dodge", 80);
  set_skill("baguazhen", 80);
  set_skill("parry", 80);
  set_skill("force", 70);
  set_skill("zhenyuan-force", 70);
  set_skill("literate", 80);
  set_skill("spells", 80);
  set_skill("taiyi", 80);
  map_skill("spells", "taiyi");
  map_skill("force", "zhenyuan-force");
  map_skill("unarmed", "wuxing-quan");
  map_skill("dodge", "baguazhen");

  set("max_kee", 500);
  set("max_sen", 500);
  set("force", 1000);
  set("max_force", 800);
  set("mana", 1600);
  set("max_mana", 800);
  set("force_factor", 40);
  set("mana_factor", 40);
  set("inquiry", ([
    "帮忙": (: family_fabao :),
  ]));
  setup();
  carry_object("/d/obj/cloth/linen")->wear();
}

void attempt_apprentice(object ob) {
  if ((string)ob->query("family/family_name") == "五庄观") {
    if ((int)ob->query("family/generation") < 3) {
      if ((string)ob->query("gender") == "男性")
        command("say 师叔见笑了。\n");
      else command("say 师姑见笑了。\n");
    } else if ((int)ob->query("family/generation") == 3) {
      if ((string)ob->query("gender") == "男性") command("say 师兄太客气了。\n");
      else command("say 师妹太客气了。\n");
    } else {
      command("consider");
      command("say 是你自己要拜的，你师父打上门来我可得拿你挡。\n");
      command("recruit " + ob->query("id"));
    }
  } else {
    command("say 好，那我就勉为其难吧。\n");
    command("recruit " + ob->query("id"));
  }
  return;
}

string family_fabao() {
  object *inv, ob, where, npc, me = this_player();
  int i;
  if (me->query("family/family_name") != "五庄观")
    return 0;
  if (me->query_temp("family_quests/done")) {
    say(name() + "点了点头：既然你帮我找到了宝贝，我这就让你去那三清台前。\n");
    me->move("/d/qujing/wuzhuang/sanqingtai");
    message("channel:chat", sprintf(HIC "【" HIG "神仙界" HIC "】%s(%s)：%s" HIC "助我寻得宝物，特将之请至三清台前。\n" NOR,
      query("name"), capitalize(query("id")), me->query("name")),
      users());
    return "";
  }
  if (objectp(ob = me->query_temp("family_quests/ob"))) {
    if (!present(ob, me))
      return "不是让你帮我找" + ob->name() + "吗？";
    else return "你将" + ob->name() + "给我吧。\n";
  }

  where = SDS_D->random_place();
  if (!where)
    return "还是算了，宝贝不知掉哪儿了。";
  inv = all_inventory(where);
  i = sizeof(inv);
  if (i < 1)
    return "算了，宝贝不知掉哪儿了。";
  npc = inv[random(i)];
  if (!npc || !objectp(npc) || !living(npc))
    return "我自己帮得了自己。";
  inv = all_inventory(npc);
  i = sizeof(inv);
  if (i < 1)
    return 0;
  ob = inv[random(i)];
  if (!ob->move(npc) || ob->query("no_give")) return "宝贝不知掉哪儿了。";
  me->set_temp("family_quests/target", npc);
  me->set_temp("family_quests/ob", ob);
  return CYN "你去" + MISC_D->find_place(where) + "帮我找" + ob->name() + CYN "吧。" NOR;
}

int accept_object(object me, object ob) {
  if (me->query_temp("family_quests/done"))
    return 0;
  if (me->query("family/family_name") != "五庄观")
    return 0;
  if (ob == me->query_temp("family_quests/ob")) {
    say(name() + "点了点头：既然你帮我找到了宝贝，我这就让你去那三清台前。\n");
    if (!me->move("/d/qujing/wuzhuang/sanqingtai"))
      me->set_temp("family_quests/done", 1);
    message("channel:chat", sprintf(HIC "【" HIG "神仙界" HIC "】%s(%s)：%s" HIC "助我寻得宝物，特将之请至三清台前。\n" NOR,
      query("name"), capitalize(query("id")), me->query("name")),
      users());
    return 1;
  }
  return 0;
}
