inherit ROOM;
#include <ansi.h>
void kill(object ob);
void appear(object ob);
void check_time(object ob);

void create() {
  set("short", "果树上");
  set("long", @LONG

你终于爬到了果树的顶上，人参果在你的身边摇摆不定，这人参果
三千年一开花，三千年一结果，再三千年才得熟，短头一万年才可
吃，那果子的模样，就和三朝未满的小孩相似，四肢齐全，五官俱
全。

LONG);

  set("exits",
    ([  //sizeof() == 4
    "down": __DIR__ "shugan4",
    ]));
  setup();
}

int do_hit() {
  object ob = this_player();
  object wield, guo, guo1, guo2;
  object where = this_object();
  if (where->query("wait") > 0) {
    message_vision(HIW "人参果" NOR "还没有长出来" + chinese_number(where->query("wait")) + " 秒后再来吧\n", ob);
    return 1;
  }
  if (ob->is_busy()) {
    message_vision("你现在正忙着呢。\n", ob);
    return 1;
  }
  if (where->query("killed") ||
    ob->query_temp("kill_tree")) {
    message_vision("这棵树已经枯萎了。\n", ob);
    return 1;
  }


  if (!wield = ob->query_temp("weapon")) {
    message_vision("你应该找个东西来打人参果。\n", ob);
    return 1;
  }

  if (ob->query_temp("weapon")->query("name") != "金击子" ||
    ob->query("obstacle/wuzhuang") == "done") {
    message_vision(HIC "只见$N举起手中" + wield->query("name") + "，对着人参果敲去，\n", ob);
    message_vision(HIC "人参果只是咕碌一声，钻到地下不见了。\n", ob);
    return 1;
  }

  else if (!ob->query_temp("prepared")) {
    message_vision(HIC "只见$N举起手中" + wield->query("name") + "，对着人参果敲去，\n", ob);
    message_vision(HIC "人参果只是咕碌一声，钻到地下不见了。\n", ob);
    return 1;
  }
  if (!ob->query("obstacle/wuzhuang") &&
    ob->query("obstacle/village") == "done") {
    guo2 = new("/d/obj/drug/renshenguo-fake");
    guo2->move(ob);
    //return 1;
  } else {
    message_vision(HIC "只见$N举起手中" + wield->query("name") + "，对着人参果敲去，\n", ob);
    message_vision(HIC "人参果只是咕碌一声，钻到地下不见了。\n", ob);
    return 1;

  }

  message_vision(HIC "只见$N举起手中" + wield->query("name") + "，对着树上的果子砸去。\n" NOR, ob);
  message_vision(HIC "一个人参果飘然的落在$N的盘子里面。\n" NOR, ob);
  remove_call_out("kill");
  remove_call_out("appear");
  call_out("kill", 5, ob);
  call_out("appear", 2, ob);
  ob->start_busy(10);
  return 1;
}
void appear(object ob) {
  object where = this_object();

  object a = new("/d/qujing/wuzhuang/npc/mingyue");
  object b = new("/d/qujing/wuzhuang/npc/qingfeng");

  a->move(where);
  b->move(where);

  message_vision(HIW "\n忽然清风、明月闯了进来。\n", ob);
  message_vision(HIG "清风破口大骂：$N,这个混蛋，偷我们五庄观的人参果。\n", ob);
  message_vision(HIG "明月破口大骂：$N,你比猪还馋吗？\n", ob);
  message_vision(HIG "清风破口大骂：$N,你这个贼子，一家人都是贼，才生出这样的贼人。\n", ob);
  message_vision(HIG "明月破口大骂：$N,快把人参果从肚子里给我吐出来。\n", ob);
  message_vision(HIG "清风破口大骂：$N,你是不是平时也是偷鸡摸狗的货色。\n", ob);
  message_vision(HIG "明月破口大骂：$N,我看你是一身的贼骨头。\n", ob);
  message_vision(HIG "清风破口大骂：$N,你一定不得好死。\n", ob);
  message_vision(HIG "明月破口大骂：$N,他妈的，别怪老子不客气了。\n", ob);

}
void kill(object ob) {
  object wield = ob->query_temp("weapon");
  object where = this_object();
  object a = find_living("qing feng");
  object b = find_living("ming yue");

  message_vision(HIC "只见$N气的满脸通红，真是个怒发冲冠。\n", ob);
  message_vision(HIC "$N抡起手中的" + wield->query("name") + "对着人参果树狠命的砸了下去。\n" NOR, ob);
  message_vision(HIC "可怜一棵千年古树就这样慢慢的枯萎了。\n" NOR, ob);
  message(
    "channel:chat",
    HIC "【闲聊】明月(Ming yue)：不好了！" + ob->query("name") + "把人参果树砸倒了。\n" NOR,
    users()
  );
  tell_object(ob, "明月，清风飞也似的逃走了。\n");
  destruct(a);
  destruct(b);
  where->set("killed", 1);
  ob->set_temp("kill_tree", 1);
  where->set("wait", 1800);
  call_out("check_time", 1, where);
  return;
}

void check_time(object ob) {
  remove_call_out("check_time");

  if (ob->query("wait") <= 0) {
    ob->delete("going");
    ob->delete("killed");
    return;
  }
  ob->add("wait", -1);
  ob->save();
  call_out("check_time", 1, ob);
}

void init() {
  object ob = this_object();
  object me = this_player();
  object jiejing;

  add_action("do_hit", "hit");

  if (me->query("newborn/two_cfyl") && !me->query("newborn/two_cfy1_get")) {
    message_vision("$N定睛细看，只见树叶间有颗晶莹的露珠，在阳光照耀下发出金色光芒，刹是夺目。\n", me);
    message_vision("$N喃喃念道：不知何时才会化做结晶，我暂且在此等候片刻吧。\n", me);
    ob->set("cfyl", 1);
    jiejing = new("/d/newborn/two/obj/cfyl");
    call_out("grow", 1 + random(3), me, jiejing);
  }
}

int grow(object ob, object jiejing) {
  int i;
  if (ob && environment(ob) == this_object()) {

    if (ob->query("newborn/two_cfyl") && !ob->query("newborn/two_cfy1_get") && query("cfyl")) {
      i = random(9);
      if (i > 5) message_vision("只见露珠在微风中巍巍颤动，四周光华流动，刹是奇观。\n", ob);
      if (i < 6 && i > 0) message_vision("只见露珠发出的光华越来越盛，看来即将化做结晶了。\n", ob);
      if (i == 0) {
        message_vision("露珠缓缓从叶面上滑落，自半空中化做一晶莹剔透的结晶，$N赶紧紧捧双手，接住这珍贵的结晶。\n", ob);
        set("cfyl", 0);

        jiejing->set("owner", ob->query("id"));
        jiejing->move(ob);
        ob->set("newborn/two_cfy1_get", 1);
      }
      call_out("grow", 3 + random(3), ob, jiejing);
    }
  } else
    return 1;

}
