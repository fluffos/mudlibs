#include <ansi.h>
inherit ITEM;

int is_container() {
  return 1;
}

void create() {
  int i;
  object ob, *obs;
  set_name("藏剑石", ({ "jian shi", "shi" }));
  set_weight(500000);
  set_max_encumbrance(50000);
  switch (random(3)) {
    case 1: ob = new("/d/门派宝物/wzg/shangqing"); break;
    case 0: ob = new("/d/门派宝物/wzg/yuqing"); break;
    //      default: ob = new("/d/门派宝物/wzg/taiqing");
  }
  if (!ob)
    return;
  obs = children(base_name(ob));
  i = sizeof(obs);
  while (i--) {
    if (objectp(obs[i])) {
      ob = new("/d/city/npc/obj/sword");
      break;
    }
  }
  ob->move(this_object());
}
