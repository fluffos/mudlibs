#include <ansi.h>
inherit ROOM;

void resets()
{
int i;
object *inv;
        
remove_call_out("resets");
inv = all_inventory();
i = sizeof(inv);
while(i--)
        {
        if ( inv[i]->is_character() )
                inv[i]->move("/d/city/kezhan");
        }
call_out("resets",900);
}                                       

void create()
{
set("short","三清台");
set("long","\n三清台前，仙气弥漫，人若到此，必当有获。\n");
set("outdoor",1);
set("objects",([
     __DIR__"obj/jianshi" : 1,
]));
setup();
remove_call_out("resets");
call_out("resets",900);
}

void valid_move(object me)
{
me->delete_temp("family_quests");
message("channel:rumor",HIM"【"HIR"顺风耳"HIM"】某人：听说"HIW+me->name()+HIM"离开了三清台。\n"NOR,users());
}

                        
