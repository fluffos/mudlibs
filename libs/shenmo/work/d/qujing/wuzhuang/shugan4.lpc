inherit ROOM;

void create() {
  set("short", "树干");
  set("long", @LONG

．．．．．．一个粗粗的树干，足有三个合抱起来那么粗．．．．．

LONG);

  set("exits",
    ([  //sizeof() == 4
    "up": __DIR__ "intree",
      "down": __DIR__ "shugan3",
    ]));
  setup();
}

void init() {
  object ob = this_object();
  object me = this_player();

}

int valid_leave(object me, string dir) {

  if (dir == "up") {
    if (me->query("obstacle/wuzhuang") == "done" ||
      !me->query("obstacle/village")) return notify_fail("人参果还没有熟，等等再来吧!!!\n");
  }
  return ::valid_leave(me, dir);
}
