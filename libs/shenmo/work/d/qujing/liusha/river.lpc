inherit ROOM;

#include <ansi.h>
void jiulian_ok(object me);
void create ()
{
  set ("short", "流沙河");
  set ("long", @LONG

忽然一条大河挡住了出路，河水混沌不清，波涛汹涌，一眼望去
，了无边际，河水不停的打着旋涡，有的旋涡竟然方圆数亩，别
说是人，就是座山，也能被卷进去。你不禁双腿发软，胆颤心惊，
不敢在看。

LONG);
  set("exits", ([
        "east"  : __DIR__"kuangye2",
        "westup":   __DIR__"riverside",
        ]));
  set("outdoors","hfd");
  setup();
}


void init()
{
object me=this_player();

if(me->query("newborn/three_bai")) {
message_vision(HIY"空中出现一片彩云!好像是什么神仙要降临\n"NOR,me);
message_vision("你决定停下来看个究竟！\n",me);
call_out("jiulian_ok",5,me);
}
}


void jiulian_ok(object me)
{
object ob,ob1;
if(!me) return;
message_vision(HIY"彩云渐渐消去，原来是天庭中掌管惩罚的刑部天兵\n"NOR,me);
ob=new("/d/newborn/three/npc/tianbing");
ob->move(environment(me));
ob->command("say 卷帘大将何在？");
ob->command("say 吾奉玉帝法旨，对汝进行万剑穿心得惩罚？");
ob1=new("/d/newborn/three/npc/juanlian");
message_vision(HIW"只见水花翻滚，水面上出现一个人影\n"NOR,me);
ob1->move(environment(me));
ob1->command("say 罪将在！");
message_vision("卷帘大将？？？莫非他这就是白琉璃说的神将？\n你决定上前问个究竟！\n",me);
}
