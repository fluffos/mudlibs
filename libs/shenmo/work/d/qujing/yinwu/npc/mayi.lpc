inherit NPC;

void create()
{
        set_name("飞蚂蚁", ({ "mayi" }) );
        set("race", "野兽");
        set("age", 5);
       set("long", "一只会飞的蚂蚁，他是水老鼠的姐姐。\n");

        set("limbs", ({ "头部", "身体", "尾巴" }) );
        set("verbs", ({ "bite" }) );

        set_skill("dodge", 40);
	set("combat_exp", 20);

        setup();
}

void unconcious()
{
   die();
}

void kill_ob(object who)
{
   if( !who )  return;
   if( userp(who) && who!=query_temp("last_damage_from") )
         log_file("feimayi",sprintf("%s %s(%s) kill this npc.\n",ctime(time()),who->query("name"),who->query("id")) );
   ::kill_ob(who);
}
