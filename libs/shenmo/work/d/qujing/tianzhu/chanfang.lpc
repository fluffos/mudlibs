#include <ansi.h>;
inherit ROOM;
void create() {
  set("short", "禅房");
  set("long", @LONG
这个禅房已经有一段时间不用了，墙土脱落，地上有一层厚灰，
墙角垫着几张破旧的蒲团，蒲团上盖了一件素布长僧袍。禅房
的西北边有一门，通向后院的菜园小道。
LONG);
  set("exits", ([
    "northwest": __DIR__ "houyuan",
  ]));
  set("objects", ([
    __DIR__ "npc/realgirl": 1,
  ]));
  set("no_quit", 1);
  setup();
}

void init() {
  add_action("do_none", "move");
  add_action("do_none", "cast");
}
int do_none() {
  object me;
  me = this_player();

  tell_object(me, "这里还是不要乱来的好。\n");
  return 1;
}
