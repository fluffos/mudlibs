
#include <ansi.h>  
inherit NPC; 
int ask_sheli();

void create() 
{
set_name("石青璇", ({"shi qingxuan", "shi", "qingxuan"})); 
set ("long", @LONG
石青璇生的清新淡雅，恬静端庄，但又不乏几分俏皮娇憨。
她深得母亲碧秀心的真传，一曲箫音名动天下，闻者无不着
迷，更拴住了那个曾视天下女子如无物的陵少之心。
LONG); 

set("title", HIM"幽谷客"NOR);
set("gender", "女性");
set("inquiry",([
"邪帝舍利"     : (: ask_sheli :),
]));
set("age", 22); 
set("per", 45);
set("str", 35);
set("int", 30);
set("cor", 50);
set("attitude", "peaceful"); 
set("combat_exp", 100000000); 
set("daoxing", 100000000); 
set("shen_type", 1);
set("max_force", 12000);
set("max_mana", 12000);
set("force", 24000);
set("mana", 24000);
set("force_factor", 1000);
set("mana_factor", 1000);
set_skill("unarmed", 400); 
set_skill("dodge", 400); 
set_skill("parry", 400); 
set_skill("force", 400); 
set_skill("sword", 400); 
set_skill("jadesword", 400); 
set_skill("changshengjue", 60); 
map_skill("force", "changshengjue");
map_skill("sword", "jadesword");
setup(); 
carry_object("/d/obj/cloth/skirt")->wear(); 
carry_object("/d/obj/cloth/shoes")->wear(); 
carry_object("/d/obj/weapon/sword/qinghong")->wield(); 
}
int ask_sheli()
{
object me;
object item;
me=this_player();
if(me->query("level")<500)
{
command("hehe");
command("say 你现在的等级太低了，恐怕驾驭不了邪帝舍利！"); 
return 1; 
}
/*
if(me->query("shilian")<1)
{
command("hehe");
command("say 你还是先去不周山试炼塔锻炼锻炼吧！");
return 1;
}
*/
if(present("xiedi sheli",me))
{
command("heng");
command("say 你不是已经有了么？！");
return 1;
}
if(me->query("sheli_ask")==1 && me->query("busi_agree")==0)
{
command("say 并不是我不想给你，而是怕因此害了你，你死心吧！");
return 1;
}
if (me->query("busi_agree")!=1 && random(100) > 15)
{
command("sigh");
command("say 我看你印堂发暗，六神无主，恐怕难以驾驭邪帝舍利的能量。");
me->set("sheli_ask",1);
return 1;
}
else
{
command("smile");
command("say 我看你一身正气，就交给你吧，记住：邪帝舍利千万不能落入坏人之手！\n");
command("say 其实武功没有正邪之分，而在于人心善恶。望公子好自为之！\n");
me->set("sheli_ask",1);
me->set("busi_agree",1);
item=new("/d/qujing/baihuling/obj/xiesheli");
item->move(me);
message("channel:rumor",YEL+"\n【"+HIM" 顺风耳 "NOR+YEL"】某人：听说"+me->query("name")+"在邪王墓得到了"+HIR"邪"HIY"帝"HIB"舍利"NOR+YEL"！\n\n"+NOR,users() );
return 1;
}
return 0;
}
