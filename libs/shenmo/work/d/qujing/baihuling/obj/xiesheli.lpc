// forcebook2, level 100-140
#include <ansi.h>

inherit ITEM;
void init();

void create() {
  set_name(HIR "邪" HIY "帝" HIB "舍利" NOR, ({ "xiedi sheli", "sheli" }));
  set_weight(1000);
  set("no_sell", 1);
  set("no_put", 1);
  set("no_give", 1);
  set("no_steal", 1);
  set("no_get", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", HIB "一颗浑圆的舍利子，外表流光四射，电形走动，你忍不住想去摸一下(touch)。\n" NOR);
    set("material", "stone");
    set("value", 0);
  }
}

void init() {
  add_action("do_touch", "touch");
  if ((int)this_object()->query("created") != 1) {
    this_object()->set("created", 1);
    remove_call_out("destroy_book");
    call_out("destroy_book", 15000);  //5 hours
  }
}

void destroy_book() {
  message_vision(
    YEL "良久，" + (string)this_object()->query("name") + YEL "表面的流光渐渐暗淡，继而化为石粉随风而去了！\n" NOR,
    environment(this_object())
  );
  destruct(this_object());
}
int do_touch(string arg) {
  object me = this_player(), book = this_object();
  int sen_cost, gain, forcelev, exp;

  if (!book->id(arg)) return notify_fail("你要干什么？\n");
  if (environment(book) != me) return notify_fail("不拿起来怎么摸啊？\n");
  if (me->is_busy()) return notify_fail("你现在忙着呢！\n");
  if (me->is_fighting()) return notify_fail("激战中无暇旁顾！\n");
  if (me->query("busi_agree") == 0) {
    if (me->query("gender") == "女性")
      return notify_fail(HIB "你用手指小心翼翼地靠近舍利，可刚一触到就被一股大力弹开！\n" NOR);
    else
      return notify_fail(HIR "你迫不及待地用手拢向舍利，可突然间“啪”地一声响，你被一股大力震开了！\n" NOR);
  }
  if ((int)me->query_skill("busi-force", 1) > 99)
    return notify_fail("你的不死印法已颇有修为，邪帝舍利不会再让你长进了。\n");
  exp = (int)me->query("combat_exp");
  forcelev = (int)me->query_skill("busi-force", 1);
  if (exp / 100 < forcelev / 10 * forcelev / 10 * forcelev / 10)
    return notify_fail("你的武学经验不够，难以参透邪帝舍利里面的秘密。\n");
  if (me->query_skill("changshengjue", 1) > 0)
    return notify_fail("正邪不两立，不死印法恐怕难以与长生诀一起修炼。\n");
  sen_cost = 20 + (40 - (int)me->query_int()) + (35 - (int)me->query_kar());
  if (sen_cost <= 50) sen_cost = 50;
  if ((int)me->query("sen") < sen_cost)
    return notify_fail("你现在头晕脑胀，该休息休息了。\n");
  me->receive_damage("sen", sen_cost);

  gain = (int)me->query_skill("literate", 1) / 10;
  gain -= random((int)me->query_int());
  gain += random(me->query_kar());
  if (gain <= 0) gain = 1;
  me->improve_skill("busi-force", gain);

  message_vision("$N正在用手轻轻地抚摸着" + book->query("name") + "。\n", me);
  tell_object(me, "一股难以名状的力量涌入你的体内，你似乎进入了一种幻境！\n");

  return 1;
}
