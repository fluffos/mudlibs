// snowtu for 有淫拿着不丢导致其他玩家不能过关
#include <ansi.h>
inherit ROOM;

nosave void create_weapon(){return;}

void create ()
{
        set("short", "密洞");
        set("long", @LONG

这里光线极为微弱，你勉强地看见洞里隐隐约约的一些东西，
却又看得不是十分清楚。你不禁伸出手来扶着洞壁，小心地摸
索着行动。

LONG);

        set("exits", ([
                "down" : __DIR__"houdong",
        ]));
        create_weapon();
        set ("sleep_room",1);
        setup();
}


void init()
{
        if( !userp(this_player()) )  
        {
                message_vision("$N向下离去。\n",this_player());
                this_player()->move("/d/qujing/baotou/houdong");
        }
}

void reset()
{
        mapping data;
        string arg,file;
        object obj,env;
        
        arg = query("weapon");
        if( !arg )
                return;
        file = sprintf(__DIR__"obj/%s",arg);
        data = query_temp("objects");
        if( !data || !mapp(data) )
        {
                ::reset();
                return;
        }
        if( undefinedp(data[file]) )
        {
                ::reset();
                return;
        }
        obj = data[file];
        if( !obj || !environment(obj) )
        {
                ::reset();
                return;
        }
        env = environment(obj);
        if( env==this_object() )
        {
                ::reset();
                return;
        }       
        else if( !env->is_character()  )
                destruct(obj);
        else if( !userp(env) )
                destruct(obj);
        else
        {
                if( env->query_temp("baotou_last_befind/"+arg)>=2 )
                {
                        tell_object(env,"天上忽然传来一声断喝：还我"+obj->query("name")+"来！\n");
                        tell_object(env,"只见"+obj->query("name")+"凌空而去，霎时间不见了踪影。\n");  
                        env->delete_temp("baotou_last_befind/"+arg);
                        destruct(obj);
                }
                else
                {
                        tell_object(env,obj->query("name")+"上一道金光闪了闪。\n");
                        env->add_temp("baotou_last_befind/"+arg,1);
                }
        }
        ::reset();
}
