// Room: /d/qujing/wudidong/book_cave1
// created 9-14-97 pickle
// Rewrite By Snowtu For OBJ's update

#include <ansi.h>
inherit ROOM;

#define NOTE "/c/wdd_book_cave.log"

string book="/d/obj/book/kugu-";

int InMud(string file)
{
object *obs;
string temp;
int i,k;
if ( !file || !stringp(file) )
        return 0;
temp = read_file(NOTE);
k = str_to_int(temp);
obs = children(file);
i = sizeof(obs);
while(i--)
        {
        if ( obs[i] )
                {
                if ( !environment(obs[i]) || !environment(obs[i])->is_character() 
                  || time()>k+172800 )
                        {
                        if ( environment(obs[i]) )  tell_room(environment(obs[i]),YEL"\n地底伸出一只脏手，将"+obs[i]->name()+YEL"一把抓住，消失在地下！\n\n"NOR);
                        destruct(obs[i]);
                        continue;
                        }
                else    return 1;
                }
        }               
return 0;
}

void reset()
{
string file;
object dao, shu;
::reset();
file = book+"1";
if ( !InMud(file) )
        {
        shu = new(file);
        shu->move(this_object());
        }
file = book+"2";
if ( !InMud(file) )
        {
        shu = new(file);
        shu->move(this_object());
        }
file = book+"3";
if ( !InMud(file) )
        {
        shu = new(file);
        shu->move(this_object());
        }
if( "/d/obj/weapon/blade/kugudao"->in_mud() == 0 )
        {
        dao= new("/d/obj/weapon/blade/kugudao");
        dao->move(this_object());
        }
}               

void create ()
{
string temp;
int k;  
set ("short", "洞穴");
set ("long", @LONG

这里的洞穴突然大了许多。四壁插着几支牛油蜡烛，发出点若明若暗
的光。洞穴里空阔的很，除了北边靠墙处一张巨大的石桌外，什么都
没有。迎面墙上似乎刻着一排字(zi)。
LONG);

set("exits", ([
        "southup" : __DIR__"book-cave1",
]));
set("item_desc", ([
        "字": RED"汝既至此，乃是与吾有缘。既入吾门，则千刀万剐，在所不辞！"NOR"\n下面似乎有一排小字。(warning)\n",
        "zi": RED"汝既至此，乃是与吾有缘。既入吾门，则千刀万剐，在所不辞！"NOR"\n下面似乎有一排小字。(warning)\n",
        "warning": RED"吾门门规不多，仅忌贪。望汝好自为之。\n"NOR,
]) );
setup();
temp = read_file(NOTE);
k = str_to_int(temp);
if ( time()>=k+172800 )
        write_file(NOTE,int_to_str(time()),1);
}

void valid_move(object me)
{
object *inv;
int i, treasure_count=0;
if ( environment(me)==this_object() ||  environment(me)->query("short")=="十八层地狱" )
        return;


inv=all_inventory(me);
i=sizeof(inv);
while (i--)
        {
        if ( inv[i]->query("name_recognized")=="枯骨刀秘笈" )
                treasure_count++;
        continue;
        }
if ( treasure_count )
        {
        message("vision","\n平地卷起一阵黄风，将"+me->name()+"卷入其中，居然消失不见了！\n\n",environment(me),me);
        tell_object(me,"\n\n平地卷起一阵黄风，将你卷入密洞之中，一阵嘶嘶声言：“宝贝岂能带走？！\n\n"NOR);
        me->move(this_object());
        }
return;
}

