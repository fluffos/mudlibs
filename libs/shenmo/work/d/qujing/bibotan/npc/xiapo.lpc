#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create() {
  set_name("大肚虾婆", ({ "xia po", "po" }));
  set("long", "一个挺着肚子走来走去的老虾婆。\n");

  set("gender", "女性");
  set("age", 40);
  set("class", "yao");
  set("attitude", "friendly");
  set("per", 30);
  set("int", 30);
  set("max_kee", 6000);
  set("max_gin", 6000);
  set("max_sen", 8000);
  set("force", 4000);
  set("max_force", 4000);
  set("force_factor", 150);
  set("max_mana", 4000);
  set("mana", 4000);
  set("mana_factor", 140);
  set("combat_exp", 4000000);
  set("daoxing", 8000000);
  set("eff_dx", 2000000);
  set("nkgain", 350);
  set_skill("literate", 150);
  set_skill("unarmed", 150);
  set_skill("dodge", 150);
  set_skill("force", 150);
  set_skill("parry", 150);
  set_skill("fork", 150);
  set_skill("spells", 150);
  set_skill("bihai-spells", 150);
  set_skill("chuanyun-tui", 150);
  set_skill("zhuanlong-force", 150);
  set_skill("yueya-chan", 150);
  //        set_skill("qianzu-steps", 150);
  map_skill("spells", "bihai-spells");
  //  map_skill("spells", "mingyu-jue"); 
  map_skill("unarmed", "chuanyun-tui");
  map_skill("force", "zhuanlong-force");
  map_skill("fork", "yueya-chan");
  map_skill("parry", "yueya-chan");
  //        map_skill("dodge", "qianzu-steps");
  //map_skill("whip", "baihua-whip");
  create_family("乱石山碧波潭", 4, "弟子");
  setup();
  carry_object("/d/obj/cloth/skirt")->wear();

}
void attempt_apprentice(object ob) {
  if ((int)ob->query("str") < 25) {
    command("shake");
    command("say 以我看这位" +
      RANK_D->query_respect(ob) + "的资质并不适于学习，还是另请高就吧。\n");
    return;
  }
  command("pat " + ob->query("id"));
  command("say 好，希望" + RANK_D->query_respect(ob) +
    "多加努力，把我们乱石山碧波潭发扬光大。\n");
  command("recruit " + ob->query("id"));
  message("system", HIY "乱石山碧波潭又多了一个弟子  " + this_player()->name() + HIW "
                     乱石山碧波潭的势力加强了。\n" NOR, users());
  return;
}
int recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "yao");
}
