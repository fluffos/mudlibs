#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create() {
  set_name("何铁手", ({ "he tieshou", "he", "tieshou" }));
  set("nickname", HIR "五毒仙子" NOR);
  set("long", @LONG
你对面的是一个一身粉红纱裙，笑靥如花的少女。
她长得肌肤雪白，眉目如画，赤着一双白嫩的秀
足，手脚上都戴着闪闪的金镯。谁能想到她就是
五毒教的教主何铁手，武林人士提起她无不胆颤
心惊。
LONG);
  set("title", "五毒教教主");

  set("gender", "女性");
  set("age", 33);
  set("combat_exp", 25000000);
  set("daoxing", 25000000);

  set("attitude", "peaceful");
  set("int", 25);
  set("class", "wudang");
  create_family("五毒教", 11, "教主");

  set("eff_dx", 30000);
  set("nkgain", 200);

  set_skill("unarmed", 400);
  set_skill("dodge", 400);
  set_skill("parry", 400);
  set_skill("spells", 400);
  set_skill("xiuluo-yinshagong", 400);
  set_skill("literate", 400);
  set_skill("sword", 400);
  set_skill("jinwu-goufa", 400);
  set_skill("wudu-shenzhang", 400);
  set_skill("jinshe-youshenbu", 400);
  set_skill("dodge", 400);
  set_skill("force", 400);
  set_skill("wudu-xinfa", 400);
  set_skill("whip", 400);
  set_skill("ruanhong-zhusuo", 400);
  set_skill("wudu-tuifa", 600);

  map_skill("whip", "ruanhong-zhusuo");
  map_skill("spells", "xiuluo-yinshagong");
  map_skill("unarmed", "wudu-shenzhang");
  map_skill("force", "wudu-xinfa");
  map_skill("sword", "jinwu-goufa");
  map_skill("parry", "jinwu-goufa");
  map_skill("dodge", "jinshe-youshenbu");
  map_skill("unarmed", "wudu-tuifa");
  set("per", 30);
  set("max_kee", 15000);
  set("max_gin", 15000);
  set("max_sen", 15000);
  set("force", 12000);
  set("max_force", 12000);
  set("force_factor", 250);
  set("mana", 12000);
  set("max_mana", 12000);
  set("mana_factor", 250);
  set("chat_msg_combat", ({
    (: perform_action, "sword", "duo" :),
    (: perform_action, "whip", "suo" :),
    (: perform_action, "unarmed", "shi" :),

  }));
  setup();
  carry_object("/d/obj/weapon/sword/qinghong")->wield();
}
void attempt_apprentice(object ob) {
  if ((int)ob->query("MKS") < 5000) {
    command("say 做我五毒教弟子必须心狠手辣,你杀的人还不够多。");
    return;
  }
  if ((int)ob->query_skill("wudu-xinfa", 1) < 280) {
    command("say 你的五毒心法还学的不够啊。");
    return;
  }
  if ((int)ob->query_skill("xiuluo-yinshagong", 1) < 280) {
    command("say 我五毒教弟子以毒杀人，法术修为是首要的。");
    command("say 你是否还应该多多钻研本门的绝学？");
    return;
  }
  command("nod");
  command("say 不错，不错。");
  command("recruit " + ob->query("id"));
  return;
}
