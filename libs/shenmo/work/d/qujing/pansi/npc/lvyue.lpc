#include <ansi.h>
inherit NPC;
inherit F_MASTER;
//inherit SKILL;

void create() {
  set_name("吕  岳", ({ "lu yue", "lu", "yue", "luyue" }));
  set("long", @LONG
吕岳乃是雷火瘟斗四部正神当中的瘟部正神，主掌
着天下瘟癀毒疫，被奉为“五毒之祖”。别说是普
通百姓，就连玉皇大帝见了他腿肚子都打哆嗦。自
从姜子牙封神之后，吕岳榜上有名。从此修心养性
，一心向道。听说他的几个弟子在盘丝岭黄花观开
山立派，他特地从东海赶过来助阵。
LONG);

  set("title", HIY "主掌瘟癀之昊天大帝" NOR);
  set("gender", "男性");
  set("level", 1500);
  set("class", "yao");
  set("age", 403);
  set("str", 405);
  set("per", 305);
  set("int", 300);
  set("cor", 500);
  set("cps", 400);
  set("combat_exp", 8000000);
  set_skill("force", 550);
  set_skill("wudu-xinfa", 550);
  set_skill("spells", 550);
  set_skill("xiuluo-yinshagong", 550);
  set_skill("sword", 550);
  set_skill("whip", 550);
  set_skill("ruanhong-zhusuo", 550);
  set_skill("unarmed", 550);
  set_skill("wudu-shenzhang", 550);
  set_skill("parry", 550);
  set_skill("literate", 550);
  set_skill("dodge", 550);
  set_skill("jinshe-steps", 550);
  set_skill("wudu-tuifa", 600);
  map_skill("force", "wudu-xinfa");
  map_skill("spells", "xiuluo-yinshagong");
  map_skill("unarmed", "wudu-shenzhang");
  map_skill("unarmed", "wudu-tuifa");
  map_skill("whip", "ruanhong-zhusuo");
  map_skill("parry", "ruanhong-zhusuo");
  map_skill("dodge", "jinshe-steps");
  set("max_sen", 6000);
  set("max_kee", 8000);
  set("force", 8000);
  set("max_force", 6000);
  set("mana", 6000);
  set("max_mana", 6000);
  set("daoxing", 5000000);
  set("force_factor", 300);
  set("mana_factor", 300);
  set("chat_chance_combat", 100);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed", "shi" :),
    (: perform_action, "unarmed", "huan" :),
  }));

  create_family("黄花观五毒门", 1, "蓝");
  setup();

  carry_object("/d/yhg/obj/jiedudan");
  carry_object("/d/obj/cloth/taijicloth")->wear();
}

int accept_fight(object me) {
  command("say 你活得不耐烦了？\n");
  return 0;
}
void attempt_apprentice(object ob) {
  if ((string)ob->query("family/family_name") != "黄花观五毒门") {
    command("say 你是何人？");
    return;
  }
  if (((int)ob->query("combat_exp") < 1000000)) {
    command("say " + RANK_D->query_respect(ob) +
      "的经验不够，有些绝学秘法恐怕难以领悟。\n");
    return;
  }
  if (((int)ob->query("daoxing") < 1000000)) {
    command("say " + RANK_D->query_respect(ob) +
      "的道行不够高深，有些绝学秘法恐怕难以领悟。\n");
    return;
  }
  if ((int)ob->query_skill("wudu-xinfa", 1) < 200) {
    command("say 五毒心法是我门中人必修之课！");
    return;
  }
  if ((int)ob->query_skill("force") < 200) {
    command("say 你的内功修为太浅。");
    return;
  }
  command("say 你的根骨不错，我就收下你了。以后要好好努力啊，毒技学好了照样能天下无敌！\n");
  command("recruit " + ob->query("id"));
  return;
}
int recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob)) {
    ob->set("title", YEL "瘟神传人" NOR);
  }

}
