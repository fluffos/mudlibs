#include <ansi.h>
string ask_mieyao();
string ask_cancel();
int give_betray();  
inherit F_MASTER;
inherit NPC;

void create()
{
  set_name("蜈蚣道长的分身"NOR, ({ "wugong daozhang", "dao", "daozhang", "wugong" }));
  set("title", HIY"五毒门派任务大使"NOR);   
  set("long", "一位欲神欲仙的黄花观五公道士他老人家的分身，专门负责门派任务。");
set("class","yao");
  set("gender", "男性");
  set("age", 40);
  set("attitude", "heroism");
  set("per", 29);
  set("max_kee", 200000);
set("inquiry", ([
"瘟神": "瘟神就是我师傅啊，听说他老人家来了，不知道藏在哪里。", 
"练毒": (: ask_mieyao :), 
//"cancel": (: ask_cancel :), 
"leave"    :(:give_betray:),  
]) ); 
  set("max_gin", 1500);
  set("max_sen", 200000);
  set("force", 1200);
  set("max_force", 1200);
  set("force_factor", 100);
  set("max_mana", 600);
  set("mana", 600);
  set("mana_factor", 80);
  set("combat_exp", 550000);
  set("daoxing", 600000);

  set_skill("spells", 200);
  set_skill("dodge", 200);
  set_skill("xiuluo-yinshagong", 200);
  set_skill("force", 200);
  set_skill("wudu-xinfa", 200);
  set_skill("sword", 200);
  set_skill("jinwu-goufa", 200);
  set_skill("parry", 200);
  set_skill("jinshe-steps", 200);
  set_skill("unarmed", 200);
  set_skill("literate", 200);
map_skill("force", "wudu-xinfa");
map_skill("spells", "xiuluo-yinshagong");
map_skill("sword", "jinwu-goufa");
map_skill("parry", "jinwu-goufa");
map_skill("dodge", "jinshe-steps");
create_family("黄花观五毒门", 2, "弟子"); 
  setup();
  carry_object("/d/obj/cloth/daopao")->wear();
}
void attempt_apprentice(object ob) 
{
 ob=this_player(); 
if( (int)ob->query_skill("wudu-xinfa",1) < 120)
{
command("say " + RANK_D->query_respect(ob) + "，你五毒心法修为不够，我教不了你。");
return;
}
command("yeah");
command("recruit " + ob->query("id")); 
return ;
}
int recruit_apprentice(object ob)
{
if( ::recruit_apprentice(ob) ) {
ob->set("title", "黄花观五毒门第三代弟子"); 
}
}
int give_betray() 
{
int exp,dh;
object who=this_player();  
exp = (int)who->query("combat_exp");
dh = (int)who->query("daoxing");
if (who->query("family/family_name") != "黄花观五毒门" ){  
       command("say 你是什么东西，赶紧给我滚！");  
       return 1;  
}
who->add("叛师/num",1);  
who->set("title","普通百姓");  
who->delete("family");  
exp = exp/100*80;
dh = exp/100*80;
who->set("combat_exp", exp);  
who->set("daoxing", dh);  
who->delete_skill("wudu-xinfa");  
who->delete_skill("xiuluo-yinshagong");  
who->save(); 
command("say 我偷偷地方你离开，你可别再叫我看到哈！");  
return 1;  
}


string ask_mieyao()
{
object who=this_player(); 
if((string)who->query("family/family_name")=="黄花观五毒门") { 
command("good "+who->query("id")); 
return "/d/obj/mieyao"->query_yao(who);
}
return ("非我门人,何故来此?\n"); 
}
string ask_cancel() 
{
object me=this_player(); 
if((int)me->query_temp("m_mieyao")) 
{
me->add("daoxing",-2000); 
me->delete_temp("m_mieyao"); 
me->delete("secmieyao"); 
me->delete("secmieyao/type"); 
me->delete("secmieyao/location"); 
me->delete("secmieyao/place"); 
me->delete("secmieyao/name"); 
me->delete("secmieyao/id"); 
return ("真是个蠢材！"); 
}
else
{
return ("你有任务吗？！"); 
}
}

