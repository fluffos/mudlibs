inherit NPC;
#include <ansi.h>

void setup()
{
    float fwx, flvl;
    mapping my;
    int qi, shen, wx, lvl, i;
    string myforce, myspells, *tf;
    int myforce_lvl, myspells_lvl;
    object ob = this_object();

    ::setup();

    my = query_entire_dbase();

    if ( undefinedp(my["age"]) )
    {
        my["age"] = random(30) + 15;
    }

    tf = ({"str","cor","int","spi","cps","con","kar",});
    for ( i = 0; i < sizeof(tf); i++ )
    {
        if ( undefinedp(my[tf[i]]) )
        {
            my[tf[i]] = random(21) + 40;
        }
    }

    qi = (my["con"] + my["str"]) / 2;
    shen= (my["spi"] + my["int"]) / 2;

    if ( undefinedp(my["max_kee"]) )
    {
        if ( my["age"] <= 14 )
        {
            my["max_kee"] = 10 * qi;
        }
        else if ( my["age"] <= 30 )
        {
            my["max_kee"] = (my["age"] - 4) * qi;
        }
        else
        {
            my["max_kee"] = 26 * qi;
        }

        myforce = ob->query_skill_mapped("force");
        myforce_lvl = ob->query_skill("force");

        my["max_kee"] += myforce_lvl * 3;

        if ( my["max_force"] > 0 )
        {
            my["max_kee"] += my["max_force"] * 2 / 5;
        }

        if ( my["max_kee"] < 100 )
        {
            my["max_kee"] = 100;
        }
    }

    if ( undefinedp(my["max_sen"]) )
    {
        if ( my["age"] <= 14 )
        {
            my["max_sen"] = 10 * shen;
        }
        else if ( my["age"] <= 30 )
        {
            my["max_sen"] = (my["age"] - 4) * shen;
        }
        else if ( my["age"] <= 40 )
        {
            my["max_sen"] = 26 * shen;
        }
        else
        {
            if ( my["fake_age"] <= 40 )
            {
                my["max_sen"] = 26 * shen;
            }
            else
            {
                my["max_sen"] = 26 * shen - (my["fake_age"]- 40) * 5;
            }
        }

        myspells = ob->query_skill_mapped("spells");
        myspells_lvl = ob->query_skill("spells");

        my["max_sen"] += myspells_lvl * 3;

        if ( my["max_mana"] > 0 )
        {
            my["max_sen"] += my["max_mana"] * 2 / 5;
        }

        if ( my["max_sen"] < 100 )
        {
            my["max_sen"] = 100;
        }
    }

    if ( undefinedp(my["unit"]) )
    {
        my["unit"] = "位";
    }

    if ( undefinedp(my["gender"]) )
    {
        my["gender"] = "男性";
    }

    if ( undefinedp(my["can_speak"]) )
    {
        my["can_speak"] = 1;
    }

    if ( undefinedp(my["attitude"]) )
    {
        my["attitude"] = "peaceful";
    }

    wx = query("combat_exp");
    fwx = to_float(wx);

    if ( wx > 10000000 )
    {
        flvl = sqrt(fwx / 400) - 1;
    }
    else
    {
        flvl = sqrt(fwx / 1000) - 1;
    }

    lvl = to_int(flvl);

    if ( query("level") < lvl )
    {
        this_object()->set("level", lvl);
    }
}

void create()
{
    int i = 30 + random(9);
    set_name("不肖弟子", ({"baihua dizi"}));
    set("level", i);
    set("long", "百花谷的弟子，不知为何跑到这儿来了。\n");
    set("gender", "男性");
    set("attitude", "heroism");
    set("age", 30);

    set("chat_chance", 5);
    set("chat_msg", ({
         (: random_move :)
    }) );
    set("chat_chance_combat", 5);
    set("shilian", 1);
    set("任务",2);
    set("no_find",1);// no_find 标志为了防止使用find命令做zhong kui fang@tsrj

    set("force_factor", 150);
    set("mana_factor", 40);

    set_skill("zongheng-sword", i*10);
    set_skill("sword", i*10);
    set_skill("unarmed", i*10);
    set_skill("dodge", i*10);
    set_skill("force", i*10);
    set_skill("parry", i*10);
    set_skill("spells", i*10);
    set_skill("siji-zhang", i*10);
    set_skill("baihua-force", i*10);
    set_skill("wuyou-steps", i*10);
    map_skill("sword", "zongheng-sword");
    map_skill("unarmed", "siji-zhang");
    map_skill("force", "baihua-force");
    map_skill("parry", "zongheng-sword");
    map_skill("dodge", "wuyou-steps");

    setup();
}

void set_skills(int j, int level)
{
    object me = this_object();
    object weapon;

    set("class", "shen");
    me->set_skill("unarmed", j);
    me->set_skill("dodge", j);
    me->set_skill("parry", j);
    me->set_skill("force", j);
    me->set_skill("spells", j);

    me->set_skill("sword", j + random(15));
    me->set_skill("zongheng-sword", j + random(15));
    me->set_skill("wuyou-steps", j + random(15));
    me->set_skill("baihua-xianfa", j + random(15));
    me->set_skill("siji-zhang", j + random(15));
    me->set_skill("baihua-force", j + random(15));

    me->map_skill("force", "baihua-force");
    me->map_skill("sword", "zongheng-sword");
    me->map_skill("parry", "zongheng-sword");
    me->map_skill("spells", "baihua-xianfa");
    me->map_skill("dodge", "wuyou-steps");
    me->map_skill("unarmed", "siji-zhang");

    create_family("百花谷", 2, "弟子");
    if ( !query("nickname") )
    {
        set("nickname", HIB"无恶不作"NOR);
    }

    weapon = new("/d/obj/weapon/sword/xy_sword");
    weapon->move(me);
    carry_object("/d/city/npc/obj/cloth")->wear();
    carry_object("/d/city/npc/obj/armor")->wear();
    carry_object("/d/city/npc/obj/kui")->wear();
    carry_object("/d/city/npc/obj/shoes")->wear();

    command("wield all");
}

void copy_status(object me, object ob, int lv)
{
    int j, lvl;
    mapping skill;
    int i, *level, max_level, max_sen, max_kee, base;

    base = 20;

    lvl = lv + base - 2;

    skill = ob->query_skills();

    i = sizeof(skill);

    if ( i > 0 )
    {
        level = values(skill);
        max_level = level[0];
        while ( i-- )
        {
            if ( level[i] > max_level )
            {
                max_level = level[i];
            }
        }
        max_level = max_level * lvl / base;
    }
    else
    {
        max_level = 100;
    }

    if ( max_level < 150 )
    {
        max_level = 150;
    }

    set_skills(max_level, lv);

    max_sen = query("max_sen") / 2;
    max_kee = query("max_kee") / 2;
    if ( max_sen < 2000 )
    {
        max_sen = 2000;
    }
    if ( max_kee < 2000 )
    {
        max_kee = 2000;
    }
    max_kee *= 3;
    max_sen *= 3;

    add("max_sen", max_sen);
    add("max_kee", max_kee);
    add("eff_sen", max_sen);
    add("eff_kee", max_kee);
    add("sen", max_sen);
    add("kee", max_kee);

    add_temp("apply/armor", ob->query_temp("apply/armor"));
    add_temp("apply/damage", ob->query_temp("apply/damage") / 4);

    if ( ob->query("max_force") < 2500 )
    {
        set("max_force", 2500);
    }
    else
    {
        set("max_force", ob->query("max_force"));
    }

    if ( ob->query("max_mana") < 2500 )
    {
        set("max_mana", 2500);
    }
    else
    {
        set("max_mana", ob->query("max_mana"));
    }
    set("force", query("max_force") * 2);
    set("mana", query("max_mana") * 2);

    if ( (query("daoxing") + query("combat_exp")) / 2 > 1000000)
    {
        add("force", query("force"));
    }
    if ( query_skill("force") / 20 < 100 )
    {
        set("force_factor", 100);
    }
    else
    {
        set("force_factor", query_skill("force") / 20);
    }

    if ( query("max_mana") / 60 < 100 )
    {
        set("mana_factor", 100);
    }
    else
    {
        set("mana_factor", query("max_mana") / 60 + 1);
    }

    if ( query("combat_exp") < 3000000 )
    {
        set("combat_exp", 3000000);
    }

    set("daoxing", query("daoxing") + query("combat_exp") / 2);
    set("level", ob->query("level"));
    set("zhuanshi", ob->query("zhuanshi"));
}

int information(object who)
{
    object me = this_object();
    int level = 5 + random(3);

    copy_status(me, who, level - 2);

    if ( random(10) == 0 )
    {
        set("env/wimpy", 40);
    }
    else
    {
        set("env/wimpy", 1);
    }

    this_object()->move("/d/penglai/baihuagu" + random(5));
    set("owner", who);

    return 1;
}

void unconcious()
{
    die();
}

void die()
{
    object book;
    object ob = query_temp("my_killer");
    int succ;

    if ( !ob || !present(ob, environment())
        || query("owner_id") != ob->query("id") )
    {
        message_vision(HIR"不肖弟子撒腿跑了。\n\n"NOR, this_object());
        destruct(this_object());
        return;
    }
    message_vision(HIG"不肖弟子临死前留下一本秘籍......\n"NOR, this_object());
    CHANNEL_D->do_channel(environment(), "rumor","听说"+ob->name()+HIM"为百花谷成功找回失落多年的了"HIG"纵横剑法"HIM"。"NOR);

    book = new("/d/baihuagu/obj/zongheng");   
    book->move(ob);

    succ = random(ob->query("mark/zongheng_re"));
    if ( wizardp(ob) )
    {
        tell_object(ob, "succ="+succ+"\n");
    }

    if( ob->query("knowing/bhg_zongheng") > 0 )
    {
        destruct(this_object());
        return;
    }

    if ( random(6) == 4 && ob->query("level") >= 1250 && succ == 0 )
    {
        ob->set("knowing/bhg_zongheng", 2);
        tell_object(ob, HIR"【系统】你领悟了纵横剑法中"HIG"“纵剑”"HIR"一诀的用法。\n" NOR);        
    }
    else if ( random(6) == 5 && ob->query_level() >= 1250 && succ == 0 )
    {
        ob->set("knowing/bhg_zongheng", 1);
        tell_object(ob, HIR"【系统】你领悟了纵横剑法中"HIG"“横剑”"HIR"一诀的用法。\n" NOR);        
    }
    else
    {
        ob->set("knowing/bhg_zongheng", 3);
        tell_object(ob, HIR"【系统】你领悟了纵横剑法中“纵横四海”一招的用法。\n" NOR);        
    }

    ob->save(1);
    destruct(this_object());
}

varargs int receive_wound(string type, int damage, object who)
{
    if ( !who || !query("owner") || who != query("owner") )
    {
        damage = 1;
    }

    return ::receive_wound(type, damage, who);
}

varargs int receive_damage(string type, int damage, object who)
{
    if ( !who || !query("owner") || who != query("owner") )
    {
        damage = 1;
    }

    return ::receive_damage(type, damage, who);
}

void leave()
{
    if ( !environment() )
    {
        return;
    }
    remove_all_killer();
    all_inventory(environment())->remove_killer(this_object());             

    message("vision", HIB + name()+HIB"身子一晃，变成一股青烟散去了。\n" NOR, environment());

    this_object()->move("/obj/empty");
    call_out("leave2", 5);
}

void leave2()
{
    remove_call_out("leave2");

    if ( this_object() )
    {
        destruct(this_object());
    }
}

void chkowner(object who)
{
    if ( !who || !environment() || base_name(environment()) == "/obj/empty" )
    {
        return;
    }

    if ( !living(who) || who->is_ghost() )
    {
        leave();
        return;
    }

    if ( !present(who, environment()) )
    {
        SDS_D->powerup(this_object(), 1);
        return;
    }

    if ( is_busy() )
    {
        start_busy(1, 100);
        interrupt_me(this_object(), "super_npc");
        reset_action();
    }

    this_object()->start_call_out( (: call_other, __FILE__, "chkowner", who :), random(5));
}                                       

void kill_ob(object who)
{
    if ( !who || !query("owner") || who != query("owner") )
    {
        message_vision(HIC"不肖弟子冷冷的看着$N"HIC"。\n"NOR, who);
        who->remove_killer(this_object());
        this_object()->remove_killer(who);
        return;
    }        

    if ( !is_fighting(who) )
    {
        this_object()->start_call_out( (: call_other, __FILE__, "chkowner", who :), random(5) + 1);
        set_temp("no_return", 1);
        set_temp("my_killer", who);
        command("say 居然胆敢来抢我秘诀？找死啊。");
    }

    ::kill_ob(who);
}

int accept_fight (object who)
{
    kill_ob (who);
    return 1;
}

void heart_beat()
{
    string str;
    object me = this_object();

    if ( !environment() )
    {
        return;
    }

    if ( !query_temp("getdd/zhenshens") )
    {
        ("/cmds/std/zhenshens")->main(this_object(), "changeup");
    }

    //防奇门，防衣袖                
    if ( environment()->is_qiankun() 
        || environment()->is_qimen() )
    {
        leave();
        return;
    }        

    //放安全区，不死区
    if( environment()->query("no_fight")
        || environment()->query("no_magic")
        || environment()->query("alternative_die") )
    {
        random_move();
        return;
    }        

    if ( living(this_object()) && (!is_fighting() || !is_busy() ) )
    {       
        if ( query("eff_kee") < query("max_kee") )
        {
            SDS_D->addEffKee(me);
        }

        if ( query("kee") < query("eff_kee") )
        {
            SDS_D->addKee(me);
        }

        if ( query("sen") < query("eff_sen") )
        {
            SDS_D->addSen(me);
        }

        if ( query("eff_sen") < query("max_sen") )
        {
            SDS_D->addEffSen(me);
        }
    }

    if ( is_fighting() )
    {
        if ( objectp(query_temp("weapon")) )
        {
            str = query_temp("weapon")->query("skill_type");
        }
        else
        {
            str = "unarmed";
        }

        switch ( random(10) )
        {
            case 9 :
            case 8 :
            case 1 :
            case 0 :
                if ( !query("no_pfm") ) 
                {
                    SDS_D->randomPfm(this_object(), str);
                }
                break;
            case 2 :
            case 7 :
            case 8 :
            case 3 : 
                if ( !query("no_cast") )
                {
                    SDS_D->randomCast(this_object());
                }
                break;
            default:
                SDS_D->randomPfm(this_object(), str);
                break;
        }
    }

    ::heart_beat();
}

