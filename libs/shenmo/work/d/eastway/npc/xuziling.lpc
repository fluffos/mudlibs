
#include <ansi.h>  
inherit NPC; 
int ask_yumo();

void create() 
{
set_name("徐子陵", ({"xu ziling", "xu", "ziling"})); 
set ("long", @LONG
玄武门之变后，徐子陵便退隐江湖，过着无忧无虑的生活。
虽每日粗茶淡饭，倒也乐哉悠哉。不过他的武功倒是一点都
没有荒废，随时准备着把自己的长生诀神功传与有缘之人。
LONG); 

set("title", HIW"大唐双龙"NOR);
set("gender", "男性");
set("inquiry",([
"寇仲": "仲少是我的生死兄弟！",
"师妃暄": "妃暄。。。妃暄。。。",
"绾绾": "绾绾。。。绾绾。。。",
"石青璇": "青璇。。。青璇。。。",
"玉魔剑法"     : (: ask_yumo :),
]));
set("age", 30); 
set("str", 45);
set("per", 35);
set("int", 30);
set("cor", 50);
set("attitude", "peaceful"); 
set("combat_exp", 100000000); 
set("daoxing", 100000000); 
set("shen_type", 1);
set("max_force", 12000);
set("max_mana", 12000);
set("force", 24000);
set("mana", 24000);
set("force_factor", 1000);
set("mana_factor", 1000);
set_skill("unarmed", 400); 
set_skill("dodge", 400); 
set_skill("parry", 400); 
set_skill("force", 400); 
set_skill("sword", 400); 
set_skill("jadesword", 400); 
set_skill("changshengjue", 60); 
map_skill("force", "changshengjue");
map_skill("sword", "jadesword");
setup(); 
carry_object("/d/obj/cloth/linen")->wear(); 
carry_object("/d/obj/weapon/sword/qinghong")->wield(); 
}
int recognize_apprentice(object ob) 
{
return 1; 
}
int ask_yumo()
{
object me;
object item;
me=this_player();
if(me->query("chshjue_ask")==0)
{
command("heng");
command("say 你是怎么找到这里来的？是不是李小子派你来的？！"); 
return 1;
}

if(me->query("level")<600)
{
command("hehe");
command("say 你现在的等级太低了，恐怕难以领悟玉魔剑法的精深奥妙！"); 
return 1; 
}
if(me->query("shilian")<1)
{
command("hehe");
command("say 你还是先去不周山试炼塔锻炼锻炼吧！");
return 1;
}
if(me->query("yumo_ask")==1)
{
command("kick");
command("say 你怎么又问这个啊，好话不说二遍！");
return 1;
}
if (me->query("yumo_agree")!=1)
{
if( random(100) > 20 )
{
command("sigh");
command("say 你的资质不适合练习玉魔剑法，千万不要难过哈。");
me->set("yumo_ask",1);
}
else
{
command("wow");
command("say 你的资质太好了，正是练习玉魔剑法的材料啊！\n");
command("say 如果你不嫌弃，我可以给你指点一二！\n");
me->set("yumo_ask",1);
me->set("yumo_agree",1);
item=new("/d/obj/weapon/sword/qinghong");
item->move(me);
command("chat 玉魔剑法又有传人了！\n");
message("channel:rumor",YEL+"\n【"+HIM" 顺风耳 "NOR+YEL"】某人："+me->query("name")+"从徐子陵那里学到了"+HIG"玉魔剑法"NOR+YEL"！\n\n"+NOR,users() );
}
return 1;
}
return 0;
}
