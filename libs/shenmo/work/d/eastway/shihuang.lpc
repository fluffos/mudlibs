#include <ansi.h>  

inherit ROOM;

void create ()
{
  set ("short", "始皇陵");
  set ("long", @LONG

这是座落在官道以东的一个大丘陵，呈覆斗型。站在丘陵
上极目远眺，不禁心旷神怡。旁边有一座高大的石碑：
“秦始皇陵”。

LONG);

  set("exits", ([
        "east"       : __DIR__"bingma",
        "west"       : __DIR__"guandao3",
        "enter"      : "/d/maze/qinling/digong1/mishi1",
      ]));
set("objects", ([ /* sizeof() == 3 */
         __DIR__"npc/wujiang" : 2,
         __DIR__"npc/bing" : 3,
      ]));
set("no_fight",1);
set("no_magic", 1);

  set("outdoors", __DIR__);

  setup();
}






int valid_leave(object me,string dir)
{
object wujiang;
object map;
if (dir=="east" || dir=="west"|| !wujiang=present("wu jiang",environment(me)) )
return ::valid_leave(me,dir); 
if (!living(wujiang)) return ::valid_leave(me,dir);
if(!(map=present("stamp", me)) || (string)map->query("unit")!="张")
{
return notify_fail("武将把眼一瞪：“没有官牒不许进去！”\n"); 
}
message("channel:rumor",HIM"【千里眼】某人：听说"+me->name()+HIM"进入始皇陵开始了探宝之路！\n"NOR,users());
return ::valid_leave(me,dir);
}
