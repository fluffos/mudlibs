// create by snowcat.c 4/20/1997
// room: /d/eastway/xyt.c

inherit ROOM;

void create() {
  set("short", "小雁塔");
  set("long", @LONG

小雁塔是一座通高几十丈的砖塔，从底下向上看去，庄严而玲珑，
塔身檐角密布，一共有十五层之高，与东边的大雁塔遥遥相望。塔
底有门洞通向塔内，东边有路通向进士场。
LONG);

  set("exits", ([
    "enter": __DIR__ "xyt1",
    "east": __DIR__ "jinshi",
  ]));
  set("outdoors", __DIR__);

  setup();
}


void init() {
  add_action("do_jump", "jump");
}

int do_jump(string arg) {
  object me = this_player();
  if (me->query_skill("dodge", 1) < 200)
    return notify_fail("你手舞足蹈地跳了起来\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢。\n");
  if (!arg || arg != "up")
    return notify_fail("你要往哪里跳？\n");
  message_vision("$N抬头看了一眼小雁塔的塔顶，不假思索，纵身跃了上去。\n", me);
  me->move("/d/eastway/guanxingtai");
  return 1;
}
