#include <ansi.h>
#include <weapon.h>

inherit BLADE;

void create()
{
        set_name(HIW"九凤朝阳刀"NOR, ({"jiufeng dao", "dao", "blade"}));
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long","一杆宝刀，刀头亮如霜雪，刀尖上镶着一颗明珠。\n");
                set("unit", "杆");
                set("value", 500);
                set("no_break", 1);
        }
        init_blade(180);
        setup();
}

