#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create()
{
        set_name(BLU"虎头皂金戈"NOR, ({"hutou ge", "ge", "sword"}));
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long","一杆长柄金戈，虎头金身。\n");
                set("unit", "杆");
                set("value", 500);
                set("no_break", 1);
        }
        init_sword(180);
        setup();
}

