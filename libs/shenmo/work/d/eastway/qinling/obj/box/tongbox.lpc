// added by windy 2/27/06 
#include <ansi.h>
inherit ITEM;

void create() {
  set_name(YEL "青铜盒" NOR, ({ "box" }));
  set_weight(0);
  set_max_encumbrance(40000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("no_sell", 1);
    set("no_put", 1);
    set("no_give", 1);
    set("long", "一个生满了绿锈的青铜盒子。\n");
    set("value", 0);
  }
}

void init() {
  add_action("do_open", "openbox");
}

int do_open(string arg) {
  object me = this_player();
  object ob;

  tell_object(me, CYN "你迫不及待地将盒子打开，\n" NOR);
  if (!environment(me)->is_digong()) {
    tell_object(me, "结果你发现盒子里所有的东西全都腐烂了，原来是在古墓里放得太久了。\n" NOR);
    destruct(this_object());
    return 1;
  }


  else if (random(200) > 198) {
    ob = new("/d/eastway/qinling/obj/dengji");
    if (ob && ob->move(me))
      tell_object(me, "发现了一颗" + HIM "等级宝石" NOR + "。\n" NOR);
  } else if (random(20) > 18) {
    ob = new("/d/eastway/qinling/obj/shengji");
    if (ob && ob->move(me))
      tell_object(me, "发现了一颗" + HIB "升级魄石" NOR + "。\n" NOR);
  } else if (random(20) > 18) {
    ob = new("/d/eastway/qinling/obj/haomao");
    if (ob && ob->move(me))
      tell_object(me, "发现了一粒" + HIW "龟鹤松龄丹" NOR + "。\n" NOR);
  } else if (random(200) > 198) {
    ob = new("/obj/money/gold");
    ob->set_amount(1);
    if (ob && ob->move(me))
      tell_object(me, "发现了一堆" + HIY "金币" NOR + "。\n" NOR);
  } else if (random(50) > 48) {
    ob = new("d/9sky/guzhanchang/obj/yundan");
    ob->set_amount(1 + random(4));
    if (ob && ob->move(me))
      tell_object(me, "发现了一些" + HIG "护生云丹" NOR + "。\n" NOR);
  } else if (random(100) > 98) {
    ob = new("/obj/money/zuanshi");
    ob->set_amount(1 + random(4));
    if (ob && ob->move(me))
      tell_object(me, "发现了一堆" + HIW "钻石" NOR + "。\n" NOR);
  } else if (random(40) > 38) {
    ob = new("/obj/money/gold");
    ob->set_amount(random(200));
    if (ob && ob->move(me))
      tell_object(me, "发现了一些" + HIY "黄金" NOR + "。\n" NOR);
  } else if (random(40) > 38) {
    ob = new("/obj/money/silver");
    ob->set_amount(random(200));
    if (ob && ob->move(me))
      tell_object(me, "发现了一些" + HIW "白银" NOR + "。\n" NOR);
  } else if (random(40) > 38) {
    ob = new("/obj/money/coin");
    ob->set_amount(random(20000));
    if (ob && ob->move(me))
      tell_object(me, "发现了一堆" + HIY "铜钱" NOR + "。\n" NOR);
  } else if (random(20) > 18) {
    ob = new("/d/eastway/qinling/obj/book1");
    if (ob && ob->move(me))
      tell_object(me, "发现了一本" + HIW "武功秘籍" NOR + "。\n" NOR);
  } else if (random(80) > 78) {
    ob = new("/d/eastway/qinling/obj/lingzhi");
    if (ob && ob->move(me))
      tell_object(me, "发现了一颗" + HIR "灵芝草" NOR + "。\n" NOR);
  } else if (random(80) > 78) {
    ob = new("/d/eastway/qinling/obj/sanqing");
    if (ob && ob->move(me))
      tell_object(me, "发现了一包" + HIY "三清散" NOR + "。\n" NOR);
  } else if (random(40) > 38) {
    ob = new("/d/eastway/qinling/obj/neili");
    if (ob && ob->move(me))
      tell_object(me, "发现了一颗" + HIW "蛇胆" NOR + "。\n" NOR);
  } else if (random(40) > 38) {
    ob = new("/d/eastway/qinling/obj/fali");
    if (ob && ob->move(me))
      tell_object(me, "发现了一根" + HIG "狗鞭" NOR + "。\n" NOR);
  } else if (random(400) > 398) {
    ob = new("/d/eastway/qinling/obj/shenliwan");
    if (ob && ob->move(me))
      tell_object(me, "发现了一颗" + HIG "神力丸" NOR + "。\n" NOR);
  } else if (random(400) > 398) {
    ob = new("/d/eastway/qinling/obj/xiandan");
    if (ob && ob->move(me))
      tell_object(me, "发现了一颗" + HIY "仙丹" NOR + "。\n" NOR);
  } else if (random(400) > 398) {
    ob = new("/d/eastway/qinling/obj/xisuidan");
    if (ob && ob->move(me))
      tell_object(me, "发现了一颗" + YEL "洗髓丹" NOR + "。\n" NOR);
  } else if (random(400) > 398) {
    ob = new("/d/eastway/qinling/obj/xingtian");
    if (ob && ob->move(me))
      tell_object(me, "发现了一颗" + HIR "邢天丹" NOR + "。\n" NOR);
  } else if (random(400) > 398) {
    ob = new("/d/eastway/qinling/obj/minjie");
    if (ob && ob->move(me))
      tell_object(me, "发现了一颗" + HIG "敏捷丹" NOR + "。\n" NOR);
  } else if (random(500) > 498) {
    tell_object(me, "盒子里发出一团" + HIM "红雾,你躲闪不及,吸了一大口!" NOR + "。\n" NOR);
    me->unconcious();
  } else if (random(100) > 98) {
    me->apply_condition("chuanchang_poison", 10);
    me->add("kee", -500);
    tell_object(me, "突然间盒子里发出一支" + RED "利箭,你慌忙闪身,可是稍慢了些,你的左臂上破了点皮儿!" NOR + "。\n" NOR);
    tell_object(me, "你觉得破皮儿处非常的痒,你中了毒!" NOR + "。\n" NOR);
  } else if (random(100) > 98) {
    me->apply_condition("jjf_poison", 10);
    me->add("kee", -500);
    tell_object(me, "突然间盒子里发出一支" + RED "利箭,你慌忙闪身,可是稍慢了些,你的左臂上破了点皮儿!" NOR + "。\n" NOR);
    tell_object(me, "你觉得破皮儿处非常的痒,你中了毒!" NOR + "。\n" NOR);
  } else if (random(200) > 198) {
    me->apply_condition("double_ice_poison", 10);
    me->add("kee", -500);
    tell_object(me, "盒子里发出一团" + HIM "白雾,你躲闪不及,吸了一大口!" NOR + "。\n" NOR);
    tell_object(me, "你觉得呼吸疼痛,你中了寒毒!" NOR + "。\n" NOR);
  } else if (random(100) > 98) {
    me->add("max_kee", -800);
    me->add("max_sen", -800);
    tell_object(me, "突然间盒子里发出一支" + RED "利箭,你慌忙闪身,可是动作太慢," + RED "利箭正中你的肩窝!" NOR + "。\n" NOR);
  } else {
    tell_object(me, "结果盒子是空的，里面什么也没有。\n" NOR);
  }
  destruct(this_object());
  return 1;
}
