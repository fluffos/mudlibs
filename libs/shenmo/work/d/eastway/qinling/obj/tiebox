#include <ansi.h>
inherit ITEM;

void create()
{
set_name(BLU"锈铁盒"NOR, ({ "box" }) );
set_weight(0);
set_max_encumbrance(40000);
if( clonep() ) 
{
object me = this_object();
object ob;
int i;

seteuid(getuid());
i=random(100);
if(i >=99)
{
ob=new("/u/windy/digong/obj/dengji");

ob->move(this_object());
}
else if(i>=94)
{
ob=new("/d/nanhai/obj/lianhua/shengji");
ob->move(this_object());
}
else if(i>=82)
{
ob=new("/d/quest/组队任务/obj/book1");
ob->move(this_object()); 
}
else if(i>=70)

{
ob=new("d/9sky/guzhanchang/obj/yundan");
ob->set_amount(1+random(4));
ob->move(this_object());
}
else if(i>=60)
{
ob=new("/obj/money/jinbi");
ob->set_amount(0+random(1));
ob->move(this_object());
}
else if(i>=50)
{
ob=new("/obj/money/zuanshi");
ob->set_amount(1+random(4));
ob->move(this_object());
}


else if(i>=30)



{
ob=new("/obj/money/gold");
ob->set_amount(100+random(200));
ob->move(this_object());
}
else if(i>=10)
{
ob=new("/obj/money/silver");
ob->set_amount(200+random(800));
ob->move(this_object());
}
else
{
ob=new("/obj/money/coin");
ob->set_amount(2000+random(8000));
ob->move(this_object());
}

set_default_object(__FILE__);

}
else
{
set("unit", "个");
set("no_sell", 1);
set("no_put", 1);
set("no_give", 1);
set("long", "一个锈迹斑斑的铁盒子。\n");
set("value",0);

}
}
int is_container()
{
return 1;
}
void init()
{
add_action("do_reng", "reng");
}
int do_reng(string arg){ 
object ob,me;
me=this_player();
if( !this_object()->id(arg) ) return 0;
message_vision("$N把空盒子用力把它向前扔去。\n", me);
message_vision("只听得前面「嗷」的一声，似乎打到了一只野狗。\n", me);
destruct(this_object());
return 1;
}
