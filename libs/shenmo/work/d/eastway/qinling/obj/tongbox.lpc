#include <ansi.h>
inherit ITEM;
void create()
{
object me = this_object();
object ob;
int i;

set_name(YEL"青铜盒"NOR, ({ "box" }) );
set_weight(0);
set_max_encumbrance(40000);
seteuid(getuid());
i=random(100);
if(i >=99)
ob=new("/d/eastway/qinling/obj/dengji");
else if(i >=98)
ob=new("/d/eastway/qinling/obj/haomao");
else if(i>=91)
ob=new("/d/eastway/qinling/obj/shengji");
else if(i>=75)
ob=new("/d/eastway/qinling/obj/book1");
else if(i>=65)
{
ob=new("d/9sky/guzhanchang/obj/yundan");
ob->set_amount(1);
}
else if(i>=55)
{
ob=new("/obj/money/gold");
ob->set_amount(1);
}
else if(i>=45)
{
ob=new("/obj/money/thousand-cash");
ob->set_amount(3+random(4));
}
else if(i>=43)
ob=new("/d/eastway/qinling/obj/lingzhi");
else if(i>=41)
ob=new("/d/eastway/qinling/obj/sanqing");
else if(i>=30)
{
ob=new("/obj/money/gold");
ob->set_amount(random(200));
}
else if(i>=28)
ob=new("/d/eastway/qinling/obj/neili");
else if(i>=26)
ob=new("/d/eastway/qinling/obj/fali");
else if(i>=10)
{
ob=new("/obj/money/silver");
ob->set_amount(200+random(800));
}
else
{
ob=new("/obj/money/coin");
ob->set_amount(10000+random(5000));
}
if ( ob )       
        ob->move(this_object());
else    {
        ob=new("/obj/money/coin");
        ob->set_amount(1500+random(8000));
        if ( ob )       
                ob->move(this_object());
        }               
set("unit", "个");
set("no_sell", 1);
set("no_put", 1);
set("no_give", 1);
set("long", "一个生满了绿锈的青铜盒子。\n");
set("value",0);
}
int is_container()
{
return 1;
}
