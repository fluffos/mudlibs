#include <ansi.h>
inherit ITEM;

void create()
{
object me = this_object();
object ob;
int i;
        
set_name(BLU"锈铁盒"NOR, ({ "box" }) );
set_weight(0);
set_max_encumbrance(40000);
seteuid(getuid());
i=random(100);
if(i>=95)
        ob=new("/d/eastway/qinling/obj/shengji");
else if(i>=82)
        ob=new("/d/eastway/qinling/obj/book1");
else if(i>=80)
        ob=new("/d/eastway/qinling/obj/lingzhi");
else if(i>=70)
        {
        ob=new("d/9sky/guzhanchang/obj/yundan");
        ob->set_amount(1);
        }
else if(i>=60)
        {
        ob=new("/obj/money/gold");
        ob->set_amount(random(2));
        }
else if(i>=50)
        {
        ob=new("/obj/money/thousand-cash");
        ob->set_amount(1+random(4));
        }
else if(i>=48)
        ob=new("/d/eastway/qinling/obj/sanqing");
else if(i>=30)
        {
        ob=new("/obj/money/gold");
        ob->set_amount(random(100));
        }
else if(i>=29)
        ob=new("/d/eastway/qinling/obj/neili");
else if(i>=28)
        ob=new("/d/eastway/qinling/obj/fali");
else if(i>=10)
        {       
        ob=new("/obj/money/silver");
        ob->set_amount(200+random(800));
        }
else    {
        ob=new("/obj/money/coin");
        ob->set_amount(2000+random(8000));
        }
if ( ob )       
        ob->move(this_object());
else    {
        ob=new("/obj/money/coin");
        ob->set_amount(1500+random(8000));
        if ( ob )       
                ob->move(this_object());
        }               
set("unit", "个");
set("no_sell", 1);
set("no_put", 1);
set("no_give", 1);
set("long", "一个锈迹斑斑的铁盒子。\n");
set("value",0);
}

int is_container()
{
return 1;
}
