#include <ansi.h>
inherit ITEM;

void create() {
  set_name("升级魄石", ({ "shengji poshi", "po", "shi" }));
  set("unit", "颗");
  set("long", "一颗形状古朴的魄石，用它可以升级(sheng)圣衣。\n");
  set_weight(5000);
  set("value", 0);
  set("no_give", 1);
  set("no_put", 1);
  setup();
}

void init() {
  add_action("do_hebing", "sheng");
}

int err_msg(string arg) {
  write(arg);
  return 0;
}

int do_hebing(string arg) {
  object armor, me;
  mapping my;

  me = this_player();
  if (!present(this_object(), me))
    return 0;
  armor = present("sheng yi", me);
  if (!armor || !armor->is_shengyi()
    || armor->query("owner_id") != me->query("id"))
    return err_msg("你身上没有圣衣或是此圣衣不是你的。\n");
  if (armor->query("equipped"))
    return err_msg("你先将圣衣脱下来吧。\n");
  if (!armor->save())
    return err_msg("你先将圣衣脱下来吧。\n");
  if (me->is_busy())
    return err_msg("你正忙着呢。\n");
  my = me->query_entire_dbase();
  if (my["kee"] < 50
    || my["sen"] < 50)
    return err_msg("你现在状态不佳，实在是难以修炼圣衣。\n");
  if (my["force"] < my["max_force"] / 3 * 2)
    return err_msg("你的内力不够充沛。\n");
  if (my["mana"] < my["mana"] / 3 * 2)
    return err_msg("你的法力不够充沛。\n");
  if (my["combat_exp"] < 1000000)
    return err_msg("你的武学不够。\n");
  if (my["daoxing"] < 500000)
    return err_msg("你的道行不够。\n");
  if (my["max_force"] < 1000
    || my["maximum_force"] < 1000)
    return err_msg("你的内力太低了。\n");
  if (my["max_mana"] < 1000
    || my["maximum_mana"] < 1000)
    return err_msg("你的法力太低了。\n");
  if (my["potential"] - my["learned_points"] < 0)
    return err_msg("你的潜能不够了。\n");
  if (my["level"] < armor->query("level"))
    return err_msg("你的等级不够" + chinese_number(armor->query("level")) + "。\n");
  //if ( armor->query("level")>=100 )
  {
    write(name() + "轰的一声炸得四开五裂，看来是太小了。。。。\n");
    destruct(this_object());
    return 1;
  }
  message(
    "channel:rumor",
    HIM "【顺风耳】某人：听说" + me->name() + HIM "使用了" + name() + HIM "将" + armor->name() + HIM "升级了。\n" NOR,
    users()
  );
  write(NOR "ok\n");
  me->set_temp("shengyi_sheng", 1);
  armor->set("level_exp", armor->query_max_exp(armor->query("level")));
  me->command("xiulian sheng yi");
  me->start_busy(1 + random(3));
  armor->save();
  me->delete_temp("shengyi_sheng");
  destruct(this_object());
  return 1;
}

string short() {
  return ::short() + "(小)";
}
