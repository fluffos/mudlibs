#include <ansi.h>
inherit COMBINED_ITEM;

void setup() {}

void init() {
  add_action("do_eat", "huimeng");
}

void create() {
  set_name(HIG "回梦符" NOR, ({ "huimeng fu", "fu" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("base_unit", "张");
    set("unit", "些");
    set("long", "神奇的仙符，据说了可以使人入睡(huimeng <对象>。\n");
    set("value", 0);
    set("drug_type", "良药");
  }
  set_amount(1);
  setup();
}

int err_msg(string arg) {
  write(arg);
  return 1;
}

int do_eat(string arg) {
  string id, msg;
  object me, who, env;
  me = this_player();
  env = environment(me);
  if (!arg || !present(this_object(), this_player()))
    return 0;
  who = present(arg, environment(me));
  if (!who)
    return err_msg("你想对谁使用" + name() + "?\n");
  if (!living(who))
    return err_msg("有这个必要吗？\n");
  if (environment(me)->query("no_fight")
    || environment(me)->query("no_magic"))
    return err_msg("这里不可以用" + name() + "。\n");
  if (me->is_busy())
    return err_msg("你正忙着呢。\n");
  msg = HIM "$N" HIM "将" + name() + HIM "打开，凝视着$n" HIM "的双眼，温柔地拍着$p的头，在$n" HIM "耳边轻声唱着：“小宝宝，快睡觉。。。”\n" NOR;
  msg += HIM "$n" HIM "顿时觉得神倦眼困，全身无力。\n" NOR;
  message_vision(msg, me, who);
  me->start_busy(3);
  msg = HIM "$n" HIM "不知不觉的哈欠连连，眼皮沉重，终于支持不住，合上了双眼。\n" NOR;
  if (who->query("莲花")) {
    msg += HIM "$n" HIM "忽觉不妥，大喝一声，双目一张，精光四射！$N" HIM "猝不及防，吓了一跳！\n" NOR;
    message_vision(msg, me, who);
    if (living(who)) who->kill_ob(me);
  } else {
    message_vision(msg, me, who);
    if (!env->query("sleep_room")) {
      env->set("sleep_room", 1);
      env->set_temp("huimeng_fu/no_sleep_room", 1);
    }
    if (who->is_fighting())
      who->command_function("surrender");
    who->delete("last_sleep");
    who->set_temp("force_sleep", 1);
    if (!who->command("sleep"))
      message_vision(HIM "\n$N" HIM "晃了晃脑袋，似乎清醒了不少，又把眼睛睁开了。\n" NOR, who);
    who->delete_temp("force_sleep");
    if (env->query_temp("huimeng_fu/no_sleep_room")) {
      env->delete("sleep_room");
      env->delete_temp("huimeng_fu");
    }
  }
  add_amount(-1);
  return 1;
}
