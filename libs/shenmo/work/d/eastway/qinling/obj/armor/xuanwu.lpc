#include <ansi.h> 
#include <armor.h>
#include <dbase.h> 
inherit ARMOR;
inherit F_AUTOLOAD;
inherit F_SAVE;
inherit F_BACKUP;
void create()
{
seteuid(0);
set_name(BLU "玄武神甲" NOR, ({"xuanwu shenjia", "shenjia"}));
set_weight(5000);
if( clonep() ) 
set_default_object(__FILE__); 
else
{
set("long", BLU"灵兽玄武幻化成的一件圣物。\n"NOR);
set("material", "leather");
set("unit", "件"); 
set("value", 0); 
set("wear_msg",BLU"从北方的天际传来一声闷雷，$N身后一片黑芒闪烁。\n"NOR);  
set("unequip_msg",BLU"$N身后黑芒渐淡，$n"BLU"踪迹皆无。\n"NOR);
set("no_get", 1);
set("no_give", 1);
set("no_drop", 1); 
set("no_put", 1); 
set("no_break", 1);
set ("armor_prop/parry", 200); 
set("armor_prop/armor", 250); 
}
setup();
}
int save() 
{
return ::save(); 
}
void setup()
{
::setup();
}
int query_unique()  { return 1; } 
int query_autoload() { return 1; }
