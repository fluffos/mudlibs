#include <ansi.h>
#include <armor.h>
#include <dbase.h>
inherit CLOTH;
inherit F_AUTOLOAD;
inherit F_SAVE;
inherit F_BACKUP;
void create()
{
seteuid(0);
set_name(HIW "白虎战袍" NOR, ({"baihu zhanpao", "zhanpao"}));
set_weight(3000);
if( clonep() )
set_default_object(__FILE__);
else
{
set("long", HIW"灵兽白虎幻化成的一件圣物。\n"NOR);
set("material", "leather");
set("unit", "件");
set("value", 0);
set("wear_msg",HIW"从西方的天际传来一声虎啸，$N身后一片白芒闪烁。\n"NOR);  
set("unequip_msg",HIW"$N身后白芒渐淡，$n"HIW"踪迹皆无。\n"NOR);
set("no_get", 1);
set("no_give", 1);
set("no_drop", 1);
set("no_put", 1);
set("no_break", 1);
set ("armor_prop/strength", 200);
set("armor_prop/armor", 250);
}
setup();
}
int save()
{
return ::save();
}
void setup()
{
::setup();
}
int query_unique()  { return 1; }
int query_autoload() { return 1; }
