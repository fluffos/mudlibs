// forcebook2, level 100-140
#include <ansi.h>

inherit ITEM;
void init();

void create() {
  set_name(HIY "〖黄帝阴符经〗" NOR, ({ "huangdi yinfujing", "yinfujing", "book", "shu" }));
  set_weight(1000);
  set("no_sell", 1);
  set("no_put", 1);
  set("no_give", 1);
  set("no_steal", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "一本竹简，上面写满了字。\n");
    set("material", "cloth");
    set("value", 0);
  }
}

void init() {
  add_action("do_read", "read");
  if ((int)this_object()->query("created") != 1) {
    this_object()->set("created", 1);
    remove_call_out("destroy_book");
    call_out("destroy_book", 15000);  //5 hours
  }
}

void destroy_book() {
  message_vision(
    "终究是在古墓里放的时间太长了，" + (string)this_object()->query("name") + "片片碎落，随风而去了。\n",
    environment(this_object())
  );
  destruct(this_object());
}
int do_read(string arg) {
  object me = this_player(), book = this_object();
  int sen_cost, gain, forcelev, exp;

  if (!book->id(arg)) return notify_fail("你要读什么？\n");
  if (environment(book) != me) return notify_fail("书要拿起来读。\n");
  if (me->is_busy()) return notify_fail("你现在忙着呢，还是等静下心来再读书吧！\n");
  if (me->is_fighting()) return notify_fail("临阵磨枪可来不及啦！\n");
  if ((int)me->query_skill("spells", 1) < 800)
    return notify_fail("你看了半天，发现上面都是篆文，它认识你，你不认识它。\n");
  if ((int)me->query_skill("spells", 1) > (799 + random(100)))
    return notify_fail("你在这方面已经很有造诣，这本书不会让你长进多少。\n");
  exp = (int)me->query("combat_exp");
  forcelev = (int)me->query_skill("force", 1);
  if (exp / 100 < forcelev / 10 * forcelev / 10 * forcelev / 10)
    return notify_fail("你的武学经验不够，再怎么读也没用。\n");
  sen_cost = 20 + (40 - (int)me->query_int()) + (35 - (int)me->query_kar());
  if (sen_cost <= 20) sen_cost = 20;
  if ((int)me->query("sen") < sen_cost)
    return notify_fail("你现在头晕脑胀，该休息休息了。\n");
  me->receive_damage("sen", sen_cost);

  gain = (int)me->query_skill("literate", 1) / 4;
  gain -= random((int)me->query_int());
  gain += random(me->query_kar());
  if (gain <= 0) gain = 1;
  me->improve_skill("spells", gain);

  message_vision("$N正专心地研读" + book->query("name") + "。\n", me);
  tell_object(me, "你研读有关基本法术的技巧，似乎有点心得。\n");

  return 1;
}
