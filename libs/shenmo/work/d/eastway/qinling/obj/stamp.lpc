inherit ITEM;
#include <ansi.h>
void create()
{
set_name(HIG"【秦始皇陵通行官牒】"NOR, ({ "stamp","piao" }) );
set_weight(5);
set("value_c", 20);
setup();
set("unit", "张");
set("long", @LONG
                                      【秦始皇地下陵园】 

        自贞观十年始,秦皇陵园内一切文物皆收归官府管制.
        凡我大唐子民,有此官牒,皆可随意游览陵园景观.
        
        通告: 凡游览陵园者,不可妄动陵园内任何文物! 尤以古墓棺椁为甚!
              违者一切后果自负! 险甚! 戒之慎之!
              此牒之上有钦天监袁天罡大人所画的八卦符咒，所有者可以使
              用(moveto)命令到达指定的层数。

                                                   长安京兆尹  令
                                                   贞观二十五年示

LONG
);
setup();
}
void init()
{
add_action("do_moveto", "moveto"); 
}
int do_moveto(string arg) 
{
int i;
object *inv,env;
object me=this_player(); 
inv = all_inventory(me); 
env = environment(me);
if (me->is_busy())
        return notify_fail("你正忙着呢，无暇施展法术。\n"); 
if (me->is_fighting())
        return notify_fail("你正在激战，无暇施展法术。\n"); 
if ( env->query("no_fight")==1 || env->query("no_magic")==1 || env->query("magicroom")==1 )
        {
        return notify_fail("这里是安全区，不准念咒语！\n"); 
        }
if ( env->query("hell")==1 )
        {
        return notify_fail("这里阴气太重，不能念咒语！\n"); 
        }
for(i=0; i<sizeof(inv); i++)  
        {
        if ( userp(inv[i]) )  
                return notify_fail("还是先把身上的玩家放下来再去吧！\n");      
        }
if( !arg ) 
        return notify_fail("你要去哪里？你只能瞬间转移到 1, 2, ...... , 9层迷宫密室。\n"); 
else if ( arg == "1" )
        {
        if (me->query("digong") < 1)
                return notify_fail("你还从来没有到过那里呢！\n"); 
        message_vision(HIW"$N紧闭双目对着通行官牒默默念了几句咒语。。。。。。\n"NOR, me); 
        message_vision(HIW"一道白光闪过，$N的身形消失不见了！\n"NOR, me); 
        me->move("/d/eastway/qinling/mishi1"); 
        message_vision(HIW"白光闪现，$N慢慢睁开了双眼。\n"NOR, me); 
        }
else if ( arg == "2" )
        {
        if (me->query("digong") < 2)
                return notify_fail("你还从来没有到过那里呢！\n"); 
        message_vision(HIW"$N紧闭双目对着通行官牒默默念了几句咒语。。。。。。\n"NOR, me); 
        message_vision(HIW"一道白光闪过，$N的身形消失不见了！\n"NOR, me); 
        me->move("/d/eastway/qinling/mishi2"); 
        message_vision(HIW"白光闪现，$N慢慢睁开了双眼。\n"NOR, me); 
        }
else if ( arg == "3" )
        {
        if (me->query("digong") < 3)
                return notify_fail("你还从来没有到过那里呢！\n"); 
        message_vision(HIW"$N紧闭双目对着通行官牒默默念了几句咒语。。。。。。\n"NOR, me); 
        message_vision(HIW"一道白光闪过，$N的身形消失不见了！\n"NOR, me); 
        me->move("/d/eastway/qinling/mishi3"); 
        message_vision(HIW"白光闪现，$N慢慢睁开了双眼。\n"NOR, me); 
        }
else if ( arg == "4" )
        {
        if (me->query("digong") < 4)
                return notify_fail("你还从来没有到过那里呢！\n"); 
        message_vision(HIW"$N紧闭双目对着通行官牒默默念了几句咒语。。。。。。\n"NOR, me); 
        message_vision(HIW"一道白光闪过，$N的身形消失不见了！\n"NOR, me); 
        me->move("/d/eastway/qinling/mishi4"); 
        message_vision(HIW"白光闪现，$N慢慢睁开了双眼。\n"NOR, me); 
        }
else if ( arg == "5" )
        {
        if (me->query("digong") < 5)
                return notify_fail("你还从来没有到过那里呢！\n"); 
        message_vision(HIW"$N紧闭双目对着通行官牒默默念了几句咒语。。。。。。\n"NOR, me); 
        message_vision(HIW"一道白光闪过，$N的身形消失不见了！\n"NOR, me); 
        me->move("/d/eastway/qinling/mishi5"); 
        message_vision(HIW"白光闪现，$N慢慢睁开了双眼。\n"NOR, me); 
        }
else if ( arg == "6" )
        {
        if (me->query("digong") < 6)
                return notify_fail("你还从来没有到过那里呢！\n"); 
        message_vision(HIW"$N紧闭双目对着通行官牒默默念了几句咒语。。。。。。\n"NOR, me); 
        message_vision(HIW"一道白光闪过，$N的身形消失不见了！\n"NOR, me); 
        me->move("/d/eastway/qinling/mishi6"); 
        message_vision(HIW"白光闪现，$N慢慢睁开了双眼。\n"NOR, me); 
        }
else if ( arg == "7" )
        {
        if (me->query("digong") < 7)
                return notify_fail("你还从来没有到过那里呢！\n"); 
        message_vision(HIW"$N紧闭双目对着通行官牒默默念了几句咒语。。。。。。\n"NOR, me); 
        message_vision(HIW"一道白光闪过，$N的身形消失不见了！\n"NOR, me); 
        me->move("/d/eastway/qinling/mishi7"); 
        message_vision(HIW"白光闪现，$N慢慢睁开了双眼。\n"NOR, me); 
        }
else if ( arg == "8" )
        {
        if (me->query("digong") < 8)
                return notify_fail("你还从来没有到过那里呢！\n"); 
        message_vision(HIW"$N紧闭双目对着通行官牒默默念了几句咒语。。。。。。\n"NOR, me); 
        message_vision(HIW"一道白光闪过，$N的身形消失不见了！\n"NOR, me); 
        me->move("/d/eastway/qinling/mishi8"); 
        message_vision(HIW"白光闪现，$N慢慢睁开了双眼。\n"NOR, me); 
        }
else if ( arg == "9" )
        {
        if (me->query("digong") < 9)
                return notify_fail("你还从来没有到过那里呢！\n"); 
        message_vision(HIW"$N紧闭双目对着通行官牒默默念了几句咒语。。。。。。\n"NOR, me); 
        message_vision(HIW"一道白光闪过，$N的身形消失不见了！\n"NOR, me); 
        me->move("/d/eastway/qinling/mishi9"); 
        message_vision(HIW"白光闪现，$N慢慢睁开了双眼。\n"NOR, me); 
        }
else
        return notify_fail("指令格式：moveto 1,2......9！\n"); 
return 1; 
}
