// lingzhi.c 千年灵芝
//星星(lywin)2000/4/22

#include <ansi.h>
inherit ITEM;

void setup()
{}

void init()
{
	add_action("do_eat", "eat");
}

void create()
{
        set_name(HIR"万年灵芝草"NOR, ({"lingzhi cao", "lingzhi", "cao"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "棵");
                set("long", "这是一棵武林人士梦寐以求的百年灵芝，据说吃一棵可得20000经验，4000潜能。\n");
		set("value", 0);
	}
	setup();
}

int do_eat(string arg)
{
        object me = this_player();
	if (!id(arg))
	return notify_fail("你要吃什么？\n");

        this_player()->add("combat_exp", 20000);
        this_player()->add("potential",4000);
        message_vision(HIR"$N吃下一棵万年灵芝草，顿感武功潜质大增 !\n"NOR, this_player());
          log_file("static/record",sprintf("%s(%s)时间 %s %s\n",me->name(1), geteuid(me),this_object()->name(1),ctime(time()) ) );
	destruct(this_object());
	return 1;
}

