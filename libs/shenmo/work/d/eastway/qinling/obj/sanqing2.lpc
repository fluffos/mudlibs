// lingzhi.c 千年灵芝
//星星(lywin)2000/4/22

#include <ansi.h>
inherit ITEM;

void setup()
{}

void init()
{
	add_action("do_eat", "eat");
}

void create()
{
        set_name(HIY"三清丸"NOR, ({"sanqing wan", "sanqing", "wan"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
                set("unit", "粒");
                set("long", "此乃道家炼丹士所炼之物。吃上一包可得五年道行。\n");

		set("value", 0);
	}
	setup();
}

int do_eat(string arg)
{
	if (!id(arg))
	return notify_fail("你要吃什么？\n");

//        this_player()->add("daoxing", 5000);
        message_vision(HIY"$N吃下一粒三清丸，顿时神采奕奕 !\n"NOR, this_player());
	destruct(this_object());
	return 1;
}

