#include <ansi.h>
inherit __DIR__ "super_npc.lpc";
string *names = ({
  HIY "金冠灵蛇" NOR,
  HIR "赤尾火蝎" NOR,
  HIG "绿腹蟾蜍" NOR,
  BLK "黑丝蜘蛛" NOR,
  HIW "雪背蜈蚣" NOR,
});
void create() {
  set_name(names[random(sizeof(names))], ({ "lao duwu", "duwu", "drug" }));
  set("gender", "女性");
  set("class", "yao");
  set("title", HIB "天下我最毒" NOR);
  set("age", 35 + random(20));
  set("level", 500);
  set("long", "一个成了精的老毒物,正朝你扑过来！\n");
  set("combat_exp", 70000000 + random(30000000));
  set("daoxing", 70000000 + random(30000000));
  set("attitude", "aggressive");
  set("max_kee", 120000 + random(30000));
  set("kee", 100000);
  set("max_sen", 80000 + random(30000));
  set("sen", 100000);
  set("max_force", 12000 + random(6000));
  set("force", 15000);
  set("max_mana", 12000 + random(6000));
  set("mana", 15000);
  set("force_factor", 500);
  set("mana_factor", 600 + random(100));
  set("任务", 1);
  set("莲花", 1);
  set("chat_chance", 30);
  set("chat_msg", ({
    CYN "又到了喝人血的时间了！\n" NOR,
    (: random_move :),
    (: random_move :),
    (: random_move :),
    (: random_move :),
    (: random_move :),
  }));
  set_skill("force", 600 + random(300));
  set_skill("spells", 600 + random(200));
  set_skill("wudu-xinfa", 600 + random(200));
  set_skill("dengxian-dafa", 600 + random(200));
  set_skill("whip", 600 + random(200));
  set_skill("ruanhong-zhusuo", 1000);
  set_skill("wudu-shenzhang", 600 + random(200));
  set_skill("dodge", 600 + random(200));
  set_skill("jinshe-steps", 600 + random(200));
  set_skill("parry", 600 + random(200));
  set_skill("unarmed", 600 + random(200));
  set_skill("sword", 600 + random(200));
  set_skill("jinwu-goufa", 600 + random(200));
  map_skill("unarmed", "wudu-shenzhang");
  map_skill("sword", "jinwu-goufa");
  map_skill("force", "wudu-xinfa");
  map_skill("spells", "dengxian-dafa");
  map_skill("whip", "ruanhong-zhusuo");
  map_skill("parry", "ruanhong-zhusuo");
  map_skill("dodge", "jinshe-steps");
  /*
set("chat_chance_combat", 100); 
set("chat_msg_combat", ({  
        (: perform_action, "whip", "suo" :),  
        (: perform_action, "unarmed", "huan" :),  
        (: perform_action, "unarmed", "shi" :),  
        (: perform_action, "sword", "duo" :),  
        (: exert_function, "huti" :),  
        (: cast_spell, "niepan" :),  
}) ); 
*/
  SDS_D->powerup(this_object());
  create_family("黄花观五毒门", 2, "蓝");
  setup();
  carry_object("/d/eastway/qinling/obj/yubox")->set_amount(random(1));
  carry_object("/d/obj/armor/yinjia")->wear();
  carry_object("/d/obj/cloth/xueshan-pao")->wear();
  carry_object("/d/mojie/obj/ldwhip")->wield();
}
void die() {
  object ob, *inv;
  int i;
  object me = query_temp("last_damage_from");
  ob = this_object();
  if (!me
    || !present(me, environment())
    || !userp(me)
    || !living(me)) {
    ::die();
    return;
  }
  inv = all_inventory(ob);

  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->query("equipped") != "worn" &&
      inv[i]->query("equipped") != "wielded" &&
      sizeof(all_inventory(me)) < me->query_max_items()) {
      tell_object(me, HIW "你得到了" NOR + inv[i]->name() + "\n");
      inv[i]->move(me);
    }
  }

  if ((int)me->query("combat_exp") / 10000 < 0) {
    me->add("combat_exp", 4000);
    me->add("daoxing", 4000);
    me->add("potential", 800);
    tell_object(me, YEL "你的武功修为提高了。\n" NOR);
  }
  if (random(15) == 1)
    me->add("shen", 2 + random(3));
  ::die();
}
