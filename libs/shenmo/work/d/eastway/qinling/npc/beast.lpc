#include <ansi.h> //如果要用颜色，就要套用此头文件
inherit __DIR__ "super_npc2.lpc";
//inherit "/d/snowtu/npc/super_npc";  //增加难度 

string *names = ({
  "野狼",
  "野狗",
  "野猪",
  "野獾",
  "野熊",
  "怪蟒",
  "吊睛大虫",
  "卷毛狮子",
  "金钱豹子",
  "野豺",
});

void create() {
  set_name(names[random(sizeof(names))], ({ "ye shou", "shou", "beast" }));
  set("race", "野兽");
  set("long", "一头饥饿的野兽, 双眼中泛着贪婪的绿光。\n");
  set("limbs", ({ "头部", "身体", "尾巴" }));
  set("verbs", ({ "bite" }));
  set("age", 10);
  set("attitude", "aggressive");
  set("env/wimpy", 40 + random(10));
  set("combat_exp", 5000000 + random(5000000));
  set("max_kee", 20000 + random(20000));
  set("max_sen", 20000 + random(20000));

  set("max_force", 4000 + random(2000));
  set("force", query("max_force") * 2);
  set("force_factor", 200 + random(100));
  set("max_mana", 4000 + random(2000));
  set("mana_factor", 200 + random(100));
  set_skill("parry", 300 + random(200));
  set_skill("dodge", 300 + random(200));
  set_skill("unarmed", 300 + random(200));
  //set("任务",1);
  set("莲花", 1);
  //powerup(this_object());
  setup();
}

void init() {
  object me = this_player();
  ::init();  //套用地层
  //随机不跟
  //已经跟了，不跟
  if (query("is_gening") || random(10) > 5)
    return;
  if (!userp(me))  //不是玩家，不跟
    return;
  if (!command("gen " + me->query("id")))
    return;     //跟随失败
    //成功了，加标志
    set("is_gening", 1);
}

void die() {
  object me = query_temp("last_damage_from");
  if (!me                        //无伤害人
  || !present(me, environment())  //不在这里
  || !userp(me)                 //不是玩家
  || !living(me))              //异常状态--一般是昏迷|睡觉 了
  {
    ::die();                //直接套用地层死亡
    return;                 //返回，
  }
  if ((int)me->query("combat_exp") / 10000 < 0)  //1500改为0,不让增加
  {
    me->add("combat_exp", 200 + random(100));
    me->add("daoxing", 200 + random(100));
    me->add("potential", 50 + random(25));
    tell_object(me, YEL "你的武学和道行增加了。\n" NOR);
    if (random(20) == 1)
      me->add("shen", 1);
  }
  ::die();
}
