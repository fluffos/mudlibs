  set_name(names[random(sizeof(names))], ({ "ghost woman", "ghost", "gui" }));
  set("gender", "女性");
  set("class", "xian");
  set("title", HIR "终于等到你来" NOR);
  set("level", 450);
  set("age", 35 + random(20));
  set("long", "一个刚从棺材里挺尸出来的厉鬼,面目着实可怕！\n");
  set("combat_exp", 50000000 + random(20000000));
  set("daoxing", 50000000 + random(20000000));
  set("attitude", "aggressive");
  set("max_kee", 100000 + random(30000));
  set("kee", 100000);
  set("max_sen", 80000 + random(30000));
  set("sen", 166666);
  set("max_force", 10000 + random(4000));
  set("force", 20000);
  set("max_mana", 10000 + random(4000));
  set("mana", 20000);
  set("force_factor", 600 + random(100));
  set("mana_factor", 400);
  set("任务", 1);
  set("莲花", 1);
  set("chat_chance", 30);
  set("chat_msg", ({
    CYN "·#%￥￥￥……—*（*—#￥……………………￥￥……！\n" NOR,
    (: random_move :),
    (: random_move :),
    (: random_move :),
    (: random_move :),
    (: random_move :),
  }));
  set_skill("force", 600 + random(200));
  set_skill("spells", 600 + random(200));
  set_skill("tonsillit", 600 + random(200));
  set_skill("gouhunshu", 600 + random(200));
  set_skill("whip", 600 + random(200));
  set_skill("hellfire-whip", 800 + random(200));
  set_skill("dodge", 800 + random(200));
  set_skill("ghost-steps", 700 + random(200));
  set_skill("unarmed", 500 + random(200));
  set_skill("jinghun-zhang", 600 + random(200));
  set_skill("stick", 800 + random(200));
  set_skill("kusang-bang", 800 + random(200));
  set_skill("parry", 600 + random(200));
  set_skill("blade", 500 + random(200));
  map_skill("force", "tonsillit");
  map_skill("spells", "gouhunshu");
  map_skill("whip", "hellfire-whip");
  map_skill("unarmed", "jinghun-zhang");
  map_skill("parry", "kusang-bang");
  map_skill("dodge", "ghost-steps");
  map_skill("stick", "kusang-bang");
  /*
set("chat_chance_combat", 100); 
set("chat_msg_combat", ({  
        (: perform_action, "stick", "three" :),  
        (: perform_action, "unarmed", "zhua" :),  
        (: perform_action, "stick", "suoming" :),  
        (: cast_spell, "curse" :),  
}) ); 
*/
  SDS_D->powerup(this_object());
  create_family("阎罗地府", 2, "蓝");
  setup();
  carry_object("/d/eastway/qinling/obj/yubox")->set_amount(random(1));
  carry_object("/d/obj/armor/gujia")->wear();
  carry_object("/d/eastway/qinling/obj/weapon/ldwhip")->wield();
}
void die() {
  object ob, *inv;
  int i;
  object me = query_temp("last_damage_from");
  ob = this_object();
  if (!me
    || !present(me, environment())
    || !userp(me)
    || !living(me)) {
    ::die();
    return;
  }
  inv = all_inventory(ob);

  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->query("equipped") != "worn" &&
      inv[i]->query("equipped") != "wielded" &&
      sizeof(all_inventory(me)) < me->query_max_items()) {
      tell_object(me, HIW "你得到了" NOR + inv[i]->name() + "\n");
      inv[i]->move(me);
    }
  }

  if ((int)me->query("combat_exp") / 10000 < 0) {
    me->add("combat_exp", 3000 + random(1000));
    me->add("daoxing", 3000 + random(1000));
    me->add("potential", 600 + random(200));
    tell_object(me, YEL "你的武功修为提高了。\n" NOR);
  }
  if (random(15) == 0) me->add("shen", 1);
  ::die();
}
