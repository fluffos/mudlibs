#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
set("short", HIY"金棺密室"NOR);
set("long", @LONG

这是一个金碧辉煌的棺室，温暖而华丽，一看就是皇家的摆
设。房间正中间有个金色的平台，一位身着龙袍的中年男子
盘膝坐在上面，正微笑着看着你。你吓了一跳！难道他就是
秦始皇？难道他没死？这到底是怎么回事？？？

LONG );

set("exits", ([ /* sizeof() == 5 */ 
"north"   : __DIR__"mishi4",
"east"   : __DIR__"mishi1",
"south"   : __DIR__"mishi3",
"west"   : __DIR__"mishi2",
"down"   : __DIR__"mishi5",
"up" : "/d/city/dangpu2",
]));

set("objects",
([
    "/d/eastway/qinling/npc/qinhuang" : 1,
]));
setup();
}
void init()
{
add_action("do_cast", "cast");
}
int do_cast (string arg)
{
object who = this_player();
if ((arg=="escape" || arg=="shuidun" || arg=="tudun" || arg=="chuqiao" || arg=="qiankun"))
{
tell_object(who,"你结结巴巴念了几句咒语！\n");
return 1;
}
else   return 0;
}
