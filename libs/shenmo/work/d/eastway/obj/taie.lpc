//By windy 2/22/06
#include <weapon.h>
#include <ansi.h>
inherit SWORD;
void create()
{
set_name(HIG"太阿宝剑"NOR, ({"taie baojian", "sword", "jian","baojian", "taie"}));
set_weight(20000);
set("unit", "把");
if( clonep() )
set_default_object(__FILE__);
else
{
set("long","秦始皇的佩剑，削铁如泥，吹毛立断。\n");
set("value", 0);
set("no_put", 1);
set("no_sell", 1);
set("no_drop", 1);
set("no_break", 1);
set("wield_msg",
HIY"$N将$n擎在手中，刹那间风云变色，地动山摇！\n"NOR);
set("unwield_msg",
HIY"$N将手中的$n慢慢地背在背后，四周平静了下来。\n"NOR);
set("weapon_prop/courage", 20);
}
init_sword(300);
setup(); 
}
