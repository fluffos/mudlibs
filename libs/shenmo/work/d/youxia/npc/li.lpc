#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int ask_wenqing();
void create() {
  set_name(WHT "李寻欢" NOR, ({ "li xunhuan", "li", "master" }));
  set("long",
    "小李飞刀,例无虚发。\n");
  set("title", HIR "飞刀问情" NOR);
  set("gender", "男性");
  set("age", 45);
  set("class", "human");
  set("attitude", "friendly");
  set("per", 30);
  set("int", 30);
  set("max_kee", 8000);
  set("max_sen", 8000);
  set("force", 8000);
  set("max_force", 5000);
  set("force_factor", 200);
  set("max_mana", 5000);
  set("mana", 8000);
  set("mana_factor", 100);
  set("combat_exp", 5000000);
  set("daoxing", 4000000);
  set("inquiry", ([
    "飞刀问情": (: ask_wenqing :),
  ]));
  set_skill("literate", 300);
  set_skill("dodge", 300);
  set_skill("force", 300);
  set_skill("parry", 300);
  set_skill("throwing", 350);
  set_skill("spells", 300);
  set_skill("tianjijue", 300);
  set_skill("wuji-force", 300);
  set_skill("li-dao", 350);
  set_skill("piaoxiang", 300);
  map_skill("spells", "tianjijue");
  map_skill("throwing", "li-dao");
  map_skill("force", "wuji-force");
  map_skill("parry", "li-dao");
  map_skill("dodge", "piaoxiang");

  create_family("江湖浪子", 1, "弟子");
  setup();

  carry_object("/d/obj/cloth/zhanpao")->wear();
  carry_object("/d/tiankongjie/obj/weapon/feiyu")->wield();
}

void attempt_apprentice(object me) {

  if (me->query("str") < 25) {
    command("shake");
    command("say 我看大虾你好像不适合学我的飞刀。\n");
    return;
  }
  if (me->query("per") < 22) {
    command("shake");
    command("say 我看大虾你好像不适合学我的飞刀，还是请回吧。\n");
    return;
  }

  command("nod");
  command("bigman bigu");
  command("say 终于又找到一个可以继承我小李飞刀的传人了。\n");
  command("recruit " + me->query("id"));
  return;
}

int recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("title", WHT "小李飞刀传人" NOR);
}

void init() {
  object ob;
  ::init();
  add_action("do_qiecuo", "qiecuo");
  add_action("do_queding", "queding");
}


int ask_wenqing() {
  object ob = this_player();
  if (ob->query("family/master_id") != "li xunhuan") {
    command("say 你不是我弟子，无法学会[飞刀问情]。");
    return 1;
  }
  if (ob->query("youxia/wenqing_perform") == 1) {
    command("say 你不是已经学会了[飞刀问情]吗？");
    return 1;
  }

  else {
    command("say 要想学会[飞刀问情]，你要接我7招，
你确定要学（queding）？");
    this_player()->add_temp("youxia/ask_wenqing", 1);
    return 1;
  }
}


int do_queding() {
  mapping guild;
  object me, target, ob;
  int extra;
  me = this_player();
  target = this_object();
  extra = target->query_skill("li-dao", 1);
  if (!me->query_temp("youxia/ask_wenqing"))
    return 0;
  me->delete_temp("youxia/ask_wenqing");
  command("say 小心了！");
  if (!(ob = query_temp("weapon"))
    || ob->query_temp("skill_type") != "ling") {
    destruct(ob);
    ob = new("//d/tiankongjie/obj/weapon/feiyu");
    ob->move(target);
    command("wield ling");
  }
  target->add_temp("apply/attack", extra);
  target->add_temp("apply/damage", extra);
  message_vision(WHT "\n\n$N" + HIR "使出小李飞刀的绝学-----又--见--飞--刀！！" NOR "\n\n" NOR, target, me);
  message_vision(YEL "\n第一刀！" NOR, me, target);
  COMBAT_D->do_attack(target, me, query_temp("weapon"));
  message_vision(HIC "\n第二刀！" NOR, me, target);
  COMBAT_D->do_attack(target, me, query_temp("weapon"));
  message_vision(HIW "\n第三刀！" NOR, me, target);
  COMBAT_D->do_attack(target, me, query_temp("weapon"));
  message_vision(HIG "\n第四刀！" NOR, me, target);
  COMBAT_D->do_attack(target, me, query_temp("weapon"));
  message_vision(HIM "\n第五刀！" NOR, me, target);
  COMBAT_D->do_attack(target, me, query_temp("weapon"));
  message_vision(HIR "\n第六刀！" NOR, me, target);
  COMBAT_D->do_attack(target, me, query_temp("weapon"));
  message_vision(HIB "\n最后一刀！" NOR, me, target);
  COMBAT_D->do_attack(target, me, query_temp("weapon"));
  if (me->query("eff_kee") < 0 || !living(target)) {
    command("sigh");
    return 1;
  }
  command("haha");
  command("say 不错不错,果然我没教错人。");
  message_vision(RED "\n在你和李寻欢切磋的过程中，你深深领悟了李寻欢的境遇，
也学会了如何把飞刀问情发挥到最高极限的本能了。\n\n" NOR, me);
  me->set("youxia/wenqing_perform", 1);
  return 1;
}
