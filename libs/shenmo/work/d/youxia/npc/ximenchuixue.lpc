inherit NPC;
#include <ansi.h>
void copy_statue(object me,object ob);

void create()
{
       set_name("西门吹雪", ({ "ximen chuixue", "ximen", "chuixue" }) );
       set("long", "西门吹雪乃是当代绝顶高手之一．剑法已经到达了＂无剑＂的境界．．\n");
set("gender", "男性");
     set("title", HIR "万梅庄主"NOR);
   set("class", "youxia");
       set("age", 34);
       set("attitude", "friendly");
        create_family("江湖浪子", 1, "绿");
set("max_force",4000);
set("max_mana",4000);
set("force",4000);
set("mana",4000);
set("daoxing",400000);
set("combat_exp",400000);
set("apply/attrack",200);
set("kee",50000);
add_temp("apply/attack",400);
add_temp("apply/damage",400);
set("sen",50000);
set("apply/damage",500);
set("apply/attrack",500);
set("apply/damage",200);
           set("chat_chance_combat", 80);
       set("chat_msg_combat", ({
                (: perform_action, "feixian" :),
                (: perform_action, "sword", "feixian" :),
                (: exert_function, "recover" :),
                (: exert_function, "xue" :),
                }) );
set("tianwaifeixian","done");
setup();
        carry_object("/d/youxia/obj/gsjian")->wield();
        carry_object("/d/youxia/obj/xuecloth")->wear();
}
void init()
{
add_action("do_none","exert");
add_action("do_none","cast");
add_action("do_none","ji");
add_action("do_none","fight");
add_action("do_none","perform");
}

int do_none()
{
object me=this_object();
message_vision("这是紫禁不能乱来，你只能用(kill)!\n",me);
return 1;
}

void kill_ob(object ob)
{
	object me=this_object();
	if(ob->query_temp("zijing")!=1)
	{
		command("say 就你这三脚猫的功夫也想和我来比试？！！");
		command("say 看好了，我让你明白什么是真正的剑客！！");
                ::kill_ob(ob);
		message_vision(HIW "剑光一闪,你再也感觉不到疼痛了!"NOR,ob);
		ob->die();
		return;
	};
    set_temp("my_killer",ob);
	command("say 好吧，让我看看你的本事!!");
	copy_statue(me,ob);
	::kill_ob(ob);
}

void copy_statue(object me,object ob)
{
object *inv;	string *skillnames, *mapnames;	mapping skill_status, map_status;	int i;

	me->set("kee",ob->query("max_kee"));    me->set("eff_kee",ob->query("max_kee"));
me->set("sen",ob->query("max_sen"));    me->set("eff_sen",ob->query("max_sen"));
me->set("max_force",ob->query("max_force"));    me->set("max_mana",ob->query("max_mana"));
me->set("force",4*ob->query("max_force"));    me->set("mana",4*ob->query("max_mana"));
me->set("force",ob->query("max_force"));    me->set("mana",ob->query("max_mana"));
me->set("daoxing",ob->query("daoxing"));
me->set("combat_exp",ob->query("combat_exp"));

skill_status = ob->query_skills();
if ( mapp(skill_status) )
{
skillnames  = keys(skill_status);
for(i=0; i<sizeof(skillnames); i++) 
{
	me->set_skill(skillnames[i], skill_status[skillnames[i]]);
}
}

map_status = ob->query_skill_map();
if ( mapp(map_status) ) 
{
mapnames  = keys(map_status);
for(i=0; i<sizeof(mapnames); i++) 
{
me->map_skill(mapnames[i], map_status[mapnames[i]]);
}
}
me->set("force_factor",me->query_skill("force")*1/4);
}

void die()
{
object ob = query_temp("my_killer");
object me=this_object();
if((ob&&ob->query_temp("zijing")==1&&ob->query("tianwanfeixian")!=1)){
   message("chat",HIW+"【紫禁之战】西门吹雪(Ximen Chuixue):"+ob->name()+"学到叶孤城的绝学"HIY+"【天外飞仙】！\n"NOR,users());
ob->set("tianwaifeixian","done");
tell_object(ob,"你学得了天外飞仙的精髓");
}
destruct(me);
}
