
inherit ROOM;

void create()
{
        set("short", "青石大道");
        set("long", @LONG
你走在一条青石大道上，四周静悄悄的。东南面是一大
片松林，穿过松林就到达闻名天下的武当山了。
LONG );
        set("outdoors", "wudang");
        set("exits", ([
                "southwest" : __DIR__"songlin1",
                "north" : __DIR__"wdroad2",
        ]));
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}

