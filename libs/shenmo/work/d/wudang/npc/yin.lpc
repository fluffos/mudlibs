inherit NPC;
inherit F_MASTER;
#include <ansi.h>
void create()
{
       set_name("殷梨亭", ({"yin liting","yin", "liting"}));
       set("long", "他就是张三丰的六弟子殷梨亭。他今年三
十岁，精明能干，嫉恶如仇，性如烈火。\n");
       set("title", HIC"武当六侠"NOR);
       set("gender", "男性");
       set("age", 30);
        set("class", "saint");
       set("attitude", "friendly");
       set("shen_type", 1);
       set("per", 28);
        set("int", 30);
       set("max_kee", 50000);
       set("max_gin", 10000);
       set("max_sen", 50000);
       set("force", 10000);
       set("max_force", 4000);
       set("force_factor", 350);
       set("max_mana", 4000);
       set("mana", 10000);
       set("mana_factor", 250);
       set("combat_exp", 30000000);
        set("daoxing", 30000000);

       set_skill("literate", 150);
       set_skill("unarmed", 160);
       set_skill("dodge", 150);
       set_skill("parry", 150);
        set_skill("sword", 150);
        set_skill("spells", 120);
        set_skill("taixu-spells", 120);
        set_skill("taiji-quan", 150);
        set_skill("taiji-shengong", 150);
        set_skill("force", 150);
        set_skill("taiji-jian", 150);
        set_skill("tiyunzong", 150);
        map_skill("spells", "taixu-spells");
        map_skill("unarmed", "taiji-quan");
        map_skill("force", "taiji-shengong");
        map_skill("sword", "taiji-jian");
        map_skill("parry", "taiji-jian");
        map_skill("dodge", "tiyunzong");
	set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action, "sword", "chan" :),
                (: perform_action, "unarmed", "nian" :),
        }) );

create_family("武当派", 2, "弟子");
setup();

        carry_object("/d/wudang/obj/bluecloth")->wear();
        carry_object("/d/obj/weapon/sword/changjian")->wield();
}

void attempt_apprentice(object ob)
{
 if (ob->query("family/family_name")!="武当派" || ob->query("class")!="saint") 
        {
        command("say 你是何人？"); 
        return; 
        }
if( (int)ob->query_skill("taiji-shengong",1) < 60)
{
command("say 你还须在太极神功上面多下功夫啊！");
return;
}
  command("say 好吧！我收下你了。以后要好好努力，光大我武当一派！\n");
  command("recruit " + ob->query("id") );
return ;
}

int accept_fight(object me, object ob)
{	ob=this_player();
	command("say " + RANK_D->query_rude(ob) + "杀心太重，恐祸不久已！\n");
	return 0;
}
