inherit NPC;
inherit F_MASTER;
#include <ansi.h>
void create()
{
       set_name("俞莲舟", ({"yu lianzhou","yu", "lianzhou"}));
       set("long", "他就是张三丰的二弟子俞莲舟。他今年五
十岁，身材魁梧，气度凝重。虽在武当七
侠中排名第二，功夫却是最精。\n");
       set("title", HIC"武当二侠"NOR);
       set("gender", "男性");
       set("age", 51);
        set("class", "saint");
       set("attitude", "friendly");
       set("shen_type", 1);
       set("per", 30);
        set("int", 25);
       set("max_kee", 50000);
       set("max_gin", 10000);
       set("max_sen", 50000);
       set("force", 10000);
       set("max_force", 6000);
       set("force_factor", 350);
       set("max_mana", 6000);
       set("mana", 10000);
       set("mana_factor", 250);
       set("combat_exp", 150000000);
        set("daoxing", 150000000);

       set_skill("literate", 300);
       set_skill("unarmed", 300);
       set_skill("dodge", 300);
       set_skill("parry", 300);
        set_skill("sword", 300);
        set_skill("spells", 300);
        set_skill("taixu-spells", 300);
        set_skill("taiji-quan", 300);
        set_skill("taiji-shengong", 300);
        set_skill("force", 300);
        set_skill("taiji-jian", 300);
        set_skill("tiyunzong", 300);
        map_skill("spells", "taixu-spells");
        map_skill("unarmed", "taiji-quan");
        map_skill("force", "taiji-shengong");
        map_skill("sword", "taiji-jian");
        map_skill("parry", "taiji-jian");
        map_skill("dodge", "tiyunzong");
	set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action, "sword", "chan" :),
                (: perform_action, "sword", "lian" :),
                (: perform_action, "sword", "sui" :),
                (: perform_action, "sword", "jia" :),
                (: perform_action, "unarmed", "nian" :),
                (: perform_action, "unarmed", "ji" :),
                (: perform_action, "unarmed", "zhen" :),
                (: perform_action, "unarmed", "yin" :),
        }) );

create_family("武当派", 2, "弟子");
setup();

        carry_object("/d/wudang/obj/whiterobe")->wear();
        carry_object("/d/obj/weapon/sword/changjian")->wield();
}

void attempt_apprentice(object ob)
{
 if (ob->query("family/family_name")!="武当派" || ob->query("class")!="saint") 
        {
        command("say 你是何人？"); 
        return; 
        }
if( (int)ob->query_skill("taiji-shengong",1) < 250)
{
command("say 你还须在太极神功上面多下功夫啊！");
return;
}
  command("say 好吧！我收下你了。以后要好好努力，光大我武当一派！\n");
  command("recruit " + ob->query("id") );
return ;
}

int accept_fight(object me, object ob)
{	ob=this_player();
	command("say " + RANK_D->query_rude(ob) + "杀心太重，恐祸不久已！\n");
	return 0;
}
