inherit NPC;
inherit F_MASTER;
#include <ansi.h>
void create()
{
       set_name("谷虚道长", ({"guxu daozhang","guxu", "daozhang"}));
       set("long", "他就是俞莲舟的弟子谷虚道长。他今年四
十岁，主管武当派的俗事。\n");
       set("gender", "男性");
       set("age", 40);
        set("class", "saint");
       set("attitude", "friendly");
       set("shen_type", 1);
       set("per", 25);
        set("int", 20);
       set("max_kee", 10000);
       set("max_gin", 10000);
       set("max_sen", 10000);
       set("force", 4000);
       set("max_force", 2000);
       set("force_factor", 100);
       set("max_mana", 2000);
       set("mana", 4000);
       set("mana_factor", 100);
       set("combat_exp", 5000000);
        set("daoxing", 5000000);

       set_skill("literate", 60);
       set_skill("unarmed", 60);
       set_skill("dodge", 60);
       set_skill("parry", 60);
        set_skill("sword", 60);
        set_skill("spells", 60);
        set_skill("taixu-spells", 60);
        set_skill("taiji-quan", 60);
        set_skill("taiji-shengong", 60);
        set_skill("force", 60);
        set_skill("tiyunzong", 60);
        map_skill("spells", "taixu-spells");
        map_skill("unarmed", "taiji-quan");
        map_skill("force", "taiji-shengong");
        map_skill("dodge", "tiyunzong");
	set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action, "unarmed", "nian" :),
        }) );

create_family("武当派", 3, "弟子");
setup();

        carry_object("/d/wudang/obj/greyrobe")->wear();
}

void attempt_apprentice(object ob)
{
 if (ob->query("class")!="saint") 
        {
        command("say 你是何人？"); 
        return; 
        }
  command("say 好吧！我收下你了。以后要好好努力，光大我武当一派！\n");
  command("recruit " + ob->query("id") );
return ;
}

int accept_fight(object me, object ob)
{	ob=this_player();
	command("say " + RANK_D->query_rude(ob) + "杀心太重，恐祸不久已！\n");
	return 0;
}
