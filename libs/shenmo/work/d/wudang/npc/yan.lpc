inherit NPC;
inherit F_MASTER;
#include <ansi.h>
void create()
{
       set_name("俞岱岩", ({"yu daiyan","yu", "daiyan"}));
       set("long", "他就是张三丰的三弟子俞岱岩。只见他身穿
一件干干净净的灰色道袍，已年过四十。身
材瘦长，恬淡冲和，沉默寡言。\n");
       set("title", HIC"武当三侠"NOR);
       set("gender", "男性");
       set("age", 51);
        set("class", "saint");
       set("attitude", "friendly");
       set("shen_type", 1);
       set("per", 30);
        set("int", 25);
       set("max_kee", 50000);
       set("max_gin", 10000);
       set("max_sen", 50000);
       set("force", 10000);
       set("max_force", 6000);
       set("force_factor", 350);
       set("max_mana", 6000);
       set("mana", 10000);
       set("mana_factor", 250);
       set("combat_exp", 150000000);
        set("daoxing", 150000000);

       set_skill("literate", 250);
       set_skill("unarmed", 250);
       set_skill("dodge", 250);
       set_skill("parry", 250);
        set_skill("sword", 250);
        set_skill("spells", 250);
        set_skill("taixu-spells", 250);
        set_skill("taiji-quan", 250);
        set_skill("taiji-shengong", 250);
        set_skill("force", 250);
        set_skill("taiji-jian", 250);
        set_skill("shenmen-jian", 200);
        set_skill("tiyunzong", 250);
        map_skill("spells", "taixu-spells");
        map_skill("unarmed", "taiji-quan");
        map_skill("force", "taiji-shengong");
        map_skill("sword", "shenmen-jian");
        map_skill("parry", "taiji-jian");
        map_skill("dodge", "tiyunzong");
	set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action, "sword", "ci" :),
                (: perform_action, "sword", "raozhirou" :),
                (: perform_action, "unarmed", "nian" :),
                (: perform_action, "unarmed", "ji" :),
                (: perform_action, "unarmed", "zhen" :),
                (: perform_action, "unarmed", "yin" :),
        }) );

create_family("武当派", 2, "弟子");
setup();

        carry_object("/d/wudang/obj/greyrobe")->wear();
        carry_object("/d/obj/weapon/sword/changjian")->wield();
}

void attempt_apprentice(object ob)
{
 if (ob->query("family/family_name")!="武当派" || ob->query("class")!="saint") 
        {
        command("say 你是何人？"); 
        return; 
        }
if( (int)ob->query_skill("taiji-shengong",1) < 200)
{
command("say 你还须在太极神功上面多下功夫啊！");
return;
}
  command("say 好吧！我收下你了。以后要好好努力，光大我武当一派！\n");
  command("recruit " + ob->query("id") );
return ;
}

int accept_fight(object me, object ob)
{	ob=this_player();
	command("say " + RANK_D->query_rude(ob) + "杀心太重，恐祸不久已！\n");
	return 0;
}
