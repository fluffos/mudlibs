
#include <weapon.h>
#include <ansi.h>
inherit SPEAR;

void create()
{
        set_name(HIR"隆基弩斯之枪"NOR, ({ "longji spear", "jian", "sword" }) );
        set_weight(15000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long","一柄不属于人间凡铁的神物“隆基弩斯之枪”。 
\n");
                set("value", 2400);
                set("material", "blacksteel");
                set("wield_msg", "$N低颂咒言$n破空而来。\n");
                set("unequip_msg", "$N不知念了些什么，$n倏的不见了。\n");
        }
        init_spear(240);
        setup();
}
 
