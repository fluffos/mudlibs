
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create()
{
       set_name(HIW"苍月泉樱"NOR, ({"quan ying", "cang yue", "master"}));
       set("long", "  她娇弱轻盈，态拟天仙，面孔为薄纱遮住，只露出了白玉般的肌肤，与两道弯月似的眉毛；
秋水般的明眸，澄澈乌亮,周围的景物，在她姿态流动间，被重新赋予了生命，一切，彷
佛重新活了起来!\n");
       set("title", HIM"龙族族长"NOR);
       set("gender", "女性");
       set("age", 20);
       set("class","xian");
       set("attitude", "friendly");
       set("rank_info/respect", "小姑娘");
       set("cor", 30);
       set("per", 40);
       set("max_kee", 14500);
       set("max_gin", 1800);
       set("max_sen", 14500);
       set("force", 15000);
       set("max_force", 13000);
       set("force_factor", 125);
       set("max_mana", 12500);
       set("mana", 15000);
       set("mana_factor", 250);
       set("combat_exp", 13000000);
	   set("daoxing", 14000000);
       set_skill("literate", 350);
       set_skill("unarmed", 350);
       set_skill("dodge", 350);
       set_skill("force", 350);
       set_skill("parry", 350);
       set_skill("spear", 350);
       set_skill("spells", 350);
       set_skill("tianwei-power", 500);
   set_skill("wujitianshi", 150);
   set_skill("raozhirouhong", 350);
      set_skill("fencheng-qiang", 350);
set_skill("fukongshu", 350);
      map_skill("spells", "wujitianshi");
   map_skill("unarmed", "raoshirouhong");
   map_skill("force", "tianwei-power");
   map_skill("spear", "fencheng-qiang");
   map_skill("parry", "fencheng-qiang");
map_skill("dodge", "fukongshu");
   
   set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: cast_spell, "moon" :)
        }) );
   
create_family("苍月骑士团", 1, "红");
setup();

        carry_object("/d/obj/cloth/tianyi.lpc")->wear();
        carry_object("/d/qishituan/obj/ljspear.lpc")->wield();
        carry_object("/d/ourhome/obj/shoes")->wear();
}

void attempt_apprentice(object ob)
{

   if ( (string)ob->query("family/family_name")=="苍月骑士团") {
   if (((int)ob->query("combat_exp") < 600000 )) {
   command("say " + RANK_D->query_respect(ob) +
"的武学不够高深，有些绝学恐怕难以领悟。\n");
   return;
   }
        command("pat "+ob->query("id"));
        command("say 好，希望" + RANK_D->query_respect(ob) +
"多加努力，他日为我龙族扬威。\n");
       command("recruit " + ob->query("id") );
	   ob->set("title", "骑士团团长");
	   ob->set("class", "xian");
   return;
   }
   command("shake");
   command("say " + RANK_D->query_respect(ob) +
"还是先去学些基础功夫吧。\n");
        return;
}
int accept_fight(object me)
{
   return 0;
}



