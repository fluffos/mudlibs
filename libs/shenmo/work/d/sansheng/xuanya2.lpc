// changan wusheng
// xuanya2.c

inherit ROOM;
#include <room.h>

void create ()
{
  set ("short", "紫芝崖");
  set ("long", @LONG

你爬了一阵，这里竟然有一个平台，此处就是火云洞的紫芝崖
了。平台上长满了一种洋溢着药香的植物，沁人心脾，这就是
能够治疗瘟疫的柴胡仙草。
LONG);
  set("exits", ([ /* sizeof() == 3 */
  "down" : __DIR__"xuanya1",
]));
	set("outdoors", 1);
  setup();
}

void init()
{
	add_action("do_climb", "climb");
}

int do_climb(string arg)
{
	object me=this_player();
	
	if( !arg || (arg!="xuanya" && arg!="悬崖") )
		return notify_fail("你要爬什么？\n");
	if(me->is_busy())
		return notify_fail("你很忙，爬什么呀！\n");

	message_vision("$N搓了搓手，扒着石头的缝隙向崖上爬去 ... \n", me);
	me->start_busy(3);

	if( (int)me->query("kee") < 500 || (int)me->query("sen") < 500) {
		call_out("faila", 3, me);
		return 1;
	}

      if( (int)me->query_skill("dodge",1)+(int)me->query_skill("unarmed",1) <=300 ){
              call_out("faila", 3, me);
              return 1;
      }

	call_out("success", 3, me);
	return 1;
}
int success(object me)
{
	message_vision("$N越爬越高，渐渐隐入了云中 ... \n", me);
        me->move("/d/sansheng/xuanya3");
	me->receive_damage("kee", 400);
	me->receive_damage("sen", 400);
	message_vision("$N慢慢的爬了上来。\n", me);
	return 1;
}
