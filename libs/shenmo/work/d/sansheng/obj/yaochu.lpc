// staff.c

#include <ansi.h>
#include <weapon.h>

inherit STAFF;

void create() {
  set_name(HIC "药锄" NOR, ({ "yao chu", "chu", "staff" }));
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "一把用来挖草药的药锄。\n");
    set("value", 500);
    set("material", "steel");
  }

  init_staff(20);
  setup();
}
