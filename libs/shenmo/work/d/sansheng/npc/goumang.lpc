#include <ansi.h> 
inherit NPC;
inherit F_MASTER;

void create()
{
  set_name("句芒", ({"gou mang", "gou", "mang", "master"}));
  set ("long", @LONG
他是天皇伏羲氏部下的大将，对伏羲氏忠心耿耿。
LONG);
 
  set("title", "伏羲氏部将");
  set("gender", "男性");
  set("level", 500);
set("class","saint");
  set("age", 40);
  set("str", 45);
  set("per", 25);
  set("cor", 50);
  set("cps", 40);
  set("combat_exp", 50000000);
  set_skill("force", 200);
  set_skill("zhenlongqi", 200);
  set_skill("spells", 200);
  set_skill("xianfeng-spells", 200);
  set_skill("unarmed", 200);
  set_skill("fengyun-shou", 200);
  set_skill("parry", 200);
  set_skill("literate", 200);
  set_skill("blade", 200);
  set_skill("dodge", 200);
  set_skill("bagua-bufa", 200);
map_skill("force", "zhenlongqi");
map_skill("spells", "xianfeng-spells");
map_skill("unarmed", "fengyun-shou");
map_skill("dodge", "bagua-bufa");
  set("max_sen", 10000);
  set("max_kee", 10000);
set("force", 8000);
set("max_force", 4000);
set("mana",8000);
set("max_mana",4000);
set("daoxing",50000000);
set("force_factor", 200);
set("mana_factor", 200);
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
                (: perform_action, "unarmed", "qinna" :),
                (: perform_action, "unarmed", "fengyun" :),
                (: exert_function, "powerup" :),
                (: cast_spell, "fengyu" :),
  }) );
 
  create_family("三圣宫", 2, "蓝");
  setup();
 
carry_object("/d/obj/armor/jinjia")->wear();
}
 
void attempt_apprentice(object ob)
{
 if (ob->query("family/family_name")!="三圣宫" || ob->query("class")!="saint") 
        {
        command("say 你是何人？"); 
        return; 
        }
if( (int)ob->query_skill("zhenlongqi",1) < 100)
{
command("say 真龙之气是我三圣宫各种武学的根本，你还是得下些功夫啊！");
return;
}
  command("say 好吧，你就暂时在我这里学习吧！\n");
  command("recruit " + ob->query("id") );
return ;
}
