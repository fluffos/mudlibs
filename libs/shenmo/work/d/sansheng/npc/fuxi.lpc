#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  set_name("伏羲太昊", ({ "fuxi taihao", "fuxi", "taihao", "master" }));
  set("long", @LONG
他就是上古三皇中的天皇伏羲氏，八卦之祖。
LONG);

  set("title", HIC "上古三皇之天皇" NOR);
  set("gender", "男性");
  set("level", 1500);
  set("class", "saint");
  set("age", 100);
  set("str", 45);
  set("per", 35);
  set("int", 40);
  set("cor", 50);
  set("cps", 40);
  set("combat_exp", 300000000);
  set_skill("force", 500);
  set_skill("zhenlongqi", 500);
  set_skill("spells", 500);
  set_skill("xianfeng-spells", 500);
  set_skill("blade", 500);
  set_skill("unarmed", 500);
  set_skill("fengyun-shou", 500);
  set_skill("parry", 500);
  set_skill("fuxibagua-dao", 500);
  set_skill("literate", 500);
  set_skill("dodge", 500);
  set_skill("bagua-bufa", 500);
  map_skill("force", "zhenlongqi");
  map_skill("spells", "xianfeng-spells");
  map_skill("unarmed", "fengyun-shou");
  map_skill("blade", "fuxibagua-dao");
  map_skill("parry", "fuxibagua-dao");
  map_skill("dodge", "bagua-bufa");
  set("max_sen", 80000);
  set("max_kee", 80000);
  set("force", 20000);
  set("max_force", 8000);
  set("mana", 20000);
  set("max_mana", 8000);
  set("daoxing", 300000000);
  set("force_factor", 500);
  set("mana_factor", 500);
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "blade", "zhen" :),
    (: perform_action, "blade", "fan" :),
    (: perform_action, "blade", "pan" :),
    (: perform_action, "blade", "mang" :),
    (: perform_action, "unarmed", "qinna" :),
    (: perform_action, "unarmed", "fengyun" :),
    (: exert_function, "powerup" :),
    (: cast_spell, "fengyu" :),
  }));

  create_family("三圣宫", 1, "蓝");
  setup();

  carry_object("/d/9ct/zb/blade")->wield();
  carry_object("/d/sea/obj/longpao")->wear();
}

int accept_fight(object me) {
  command("say 老了，不中用了！\n");
  return 0;
}
void attempt_apprentice(object ob) {
  if (ob->query("family/family_name") != "三圣宫" || ob->query("class") != "saint") {
    command("say 你是何人？");
    return;
  }
  if (((int)ob->query("combat_exp") < 15000000)) {
    command("say " + RANK_D->query_respect(ob) +
      "的经验不够，有些绝学秘法恐怕难以领悟。\n");
    return;
  }
  if (((int)ob->query("daoxing") < 10000000)) {
    command("say " + RANK_D->query_respect(ob) +
      "的道行不够高深，有些绝学秘法恐怕难以领悟。\n");
    return;
  }
  if ((int)ob->query_skill("zhenlongqi", 1) < 400) {
    command("say 真龙之气是我三圣宫各种武学的根本，你还是得下些功夫啊！");
    return;
  }
  command("say 你真是一个武学奇才，看来朕的八卦刀法后继有人了！以后可要好好努力啊！\n");
  command("recruit " + ob->query("id"));
  return;
}
int recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob)) {
    ob->set("title", HIG "伏羲氏传人" NOR);
  }

}
