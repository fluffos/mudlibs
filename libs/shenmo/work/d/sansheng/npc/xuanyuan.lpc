#include <ansi.h> 
inherit NPC;
inherit F_MASTER;

void create()
{
  set_name("轩辕黄帝", ({"xuanyuan huangdi", "xuanyuan", "huangdi", "master"}));
  set ("long", @LONG
他就是上古三皇中的人皇轩辕氏，华夏之祖。
LONG);
 
  set("title", HIW"上古三皇之人皇"NOR);
  set("gender", "男性");
  set("level", 1000);
set("class","saint");
  set("age", 100);
  set("str", 45);
  set("kar", 40);
  set("per", 35);
  set("int", 30);
  set("cor", 50);
  set("cps", 40);
  set("combat_exp", 200000000);
  set("bellicosity",3000);
  set_skill("force", 400);
  set_skill("zhenlongqi", 400);
  set_skill("spells", 400);
  set_skill("xianfeng-spells", 400);
  set_skill("sword", 500);
  set_skill("unarmed", 400);
  set_skill("fengyun-shou", 400);
  set_skill("parry", 400);
  set_skill("xuanyuan-jian", 500);
  set_skill("literate", 400);
  set_skill("medical", 400);
  set_skill("dodge", 400);
  set_skill("bagua-bufa", 400);
map_skill("force", "zhenlongqi");
map_skill("spells", "xianfeng-spells");
map_skill("unarmed", "fengyun-shou");
map_skill("sword", "xuanyuan-jian");
map_skill("parry", "xuanyuan-jian");
map_skill("literate", "medical");
map_skill("dodge", "bagua-bufa");
  set("max_sen", 50000);
  set("max_kee", 50000);
set("force", 20000);
set("max_force", 6000);
set("mana",20000);
set("max_mana",6000);
set("daoxing",200000000);
set("force_factor", 500);
set("mana_factor", 500);
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
                (: perform_action, "unarmed", "qinna" :),
                (: perform_action, "unarmed", "fengyun" :),
                (: exert_function, "powerup" :),
                (: cast_spell, "fengyu" :),
  }) );
 
  create_family("三圣宫", 1, "蓝");
  setup();
 
carry_object("/d/sansheng/obj/sword")->wield();
carry_object("/d/sea/obj/longpao")->wear();
}
 
int accept_fight(object me)
{
  command("say 老了，不中用了！\n");
  return 0;
}
void attempt_apprentice(object ob)
{
 if (ob->query("family/family_name")!="三圣宫" || ob->query("class")!="saint") 
        {
        command("say 你是何人？"); 
        return; 
        }
 if (ob->query_temp("sansheng/chiyou_kill")!="done") 
        {
        command("say 朕已经不收徒弟了。你另去找他人吧。"); 
        return; 
        }
if( (int)ob->query_skill("zhenlongqi",1) < 300)
{
command("say 真龙之气是我三圣宫各种武学的根本，你还是得下些功夫啊！");
return;
}
  command("say 不错不错，朕收下你了！以后可要好好努力啊！\n");
  command("recruit " + ob->query("id") );
return ;
}
int recruit_apprentice(object ob)
{
if( ::recruit_apprentice(ob) ) {
ob->set("title", HIW"轩辕氏传人"NOR);
}

}
