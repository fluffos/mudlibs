#include <ansi.h>
inherit __DIR__ "n.lpc";

#include "/d/9sky/guzhanchang/npc/guai.h"
void create() {
  set_name("蚩尤", ({ "chi you", "chi", "you" }));
  set("title", HIR "混世魔王" NOR);
  set("max_kee", 10000);
  set("max_sen", 10000);
  set("max_force", 15000);
  set("max_mana", 20000);
  set("mana_factor", 800);
  set("force_factor", 800);
  set("daoxing", 999999999);
  set("combat_exp", 999999999);

  set_skill("dodge", 999);
  set_skill("unarmed", 999);
  set_skill("parry", 999);
  set_skill("force", 999);
  set_skill("spells", 999);
  set_skill("dragonfight", 999);
  map_skill("unarmed", "dragonfight");
  set_skill("seashentong", 999);
  map_skill("spells", "seashentong");
  set_skill("dragonforce", 999);
  map_skill("force", "dragonforce");
  set_skill("xiaoyaoyou", 999);
  map_skill("dodge", "xiaoyaoyou");
  map_skill("parry", "dragonfight");
  setup();
  powerup();
}

void init() {
  if (userp(this_player()) && !this_object()->is_fighting(this_player())) {
    command("say 我都躲到深山老林里了，你还是不放过我么？\n");
    command("shit " + this_player()->query("id"));
    kill_ob(this_player());
  }
}

void die() {
  object ob = query_temp("my_killer");
  if (ob && ob->query("family/family_name") == "三圣宫" && ob->query_temp("sansheng/chiyou_kill") != "done") {
    ob->start_busy(3);
    ob->set_temp("sansheng/chiyou_kill", "done");
  }
  message("sound", HIR "\n蚩尤仆倒在地，化作一缕红烟，散去了。。。\n\n" NOR, environment());
  destruct(this_object());
}

void unconcious() {
  die();
}
