#include <ansi.h>
inherit __DIR__"n.lpc";

void create()
{
set_name("雨师",({"yu shi","yu","shi"}));
set("title",HIG"蚩尤一族"NOR);
set("max_kee",10000);
set("max_sen",10000);
set("max_force",15000);
set("max_mana",20000);
set("mana_factor",800);
set("force_factor",800);
set("daoxing",99999999);
set("combat_exp",99999999);

set_skill("dodge",999);
set_skill("unarmed",999);
set_skill("parry",999);
set_skill("force",999);
set_skill("spells",999);        
set_skill("dragonfight",999);
map_skill("unarmed","dragonfight");
set_skill("seashentong",999);
map_skill("spells","seashentong");
set_skill("dragonforce",999);
map_skill("force","dragonforce");
set_skill("xiaoyaoyou",999);
map_skill("dodge","xiaoyaoyou");
map_skill("parry","dragonfight");
setup();
powerup();
}

void init()
{
if ( userp(this_player()) && !this_object()->is_fighting(this_player()) && this_player()->query("family/family_name")=="三圣宫")
        {
        command("say 真的要赶尽杀绝么？\n");
        kill_ob(this_player());
        }
}       
