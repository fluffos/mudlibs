#include <ansi.h>
inherit "/d/snowtu/npc/super_npc";

void super_attack(object me,object who,string type);

void heart_beat()
{
mapping my = query_entire_dbase();
object *enemys,me = this_object();
int i,flag=0;

if ( !environment() )
        return;
if ( my["kee"]<=0 || my["eff_kee"]<=0 
  || my["sen"]<=0 || my["eff_sen"]<=0 ) 
        {
        if ( my["force"]>500 )
                {
                SDS_D->addEffKee(me);           
                SDS_D->addKee(me);
                return;
                }
        else if ( my["mana"]>1000 )
                {
                my["mana"]-= 800;
                my["force"]+= 500;
                return;
                }
        else    {
                die();
                return;
                }
        }
if ( me->is_busy() )
        {
        if ( (!me->is_fighting() || random(3)==1)
          && my["mana"]>10 ) 
                {       
                my["mana"]-= 10;        
                switch(me->name(1))
                        {
                        case "雨师" :
                                message_vision(NOR WHT"\n$N"NOR WHT"口中念念有词，只见$P周身上下笼罩起一层水雾，水雾“哗”的炸开，$P动作立时变得顺畅起来！\n\n"NOR,me);        
                                break;
                        case "风伯" :
                                message_vision(NOR HIG"\n$N"NOR HIG"口中念念有词，只见$P脚下泛起一层清风将其笼罩住，风罩“哗”的炸开，$P动作立时变得顺畅起来！\n\n"NOR,me);    
                                break;
                        default :
                                message_vision(NOR HIR"\n$N"NOR HIR"口中念念有词，只见$P脚下泛起一层血气将其笼罩住，血罩“哗”的炸开，$P动作立时变得顺畅起来！\n\n"NOR,me);                    
                        }               
                me->start_busy(1,10000);
                me->interrupt_me(me,"蚩尤之力");  
                me->reset_action(); 
                }
        }       
if ( !me->is_fighting() )
        me->clear_condition();
else    {
        me->clean_up_enemy();
        enemys = me->query_enemy();
        for(i=0;i<sizeof(enemys);i++)
                {
                if ( !enemys[i] 
                  || !living(enemys[i])
                  || !present(enemys[i],environment())
                  || !me->is_fighting(enemys[i]) )
                        continue;
                flag++;
                }
        if ( !flag )
                {
                SDS_D->powerup(me,1);
                return;
                }
        enemys = me->query_enemy();
        for(i=0;i<sizeof(enemys);i++)
                {
                super_attack(me,enemys[i],me->name(1));
                }
        }
::heart_beat();
}

void super_attack(object me,object who,string type)
{
int damage,i;   
object *inv;
mapping armor;
if ( !me || !who || !me->is_fighting(who) )
        return; 
if ( me->query_temp("ATK") )
        return; 
if ( me->query("force")<50 && me->query("mana")<50 )
        return;
if ( !userp(who) )
        {
        COMBAT_D->attacking_perform_success(me,who,who->query_skill("dodge")*2,1000);
        who->set_temp("last_damage_from",me);
        who->die();
        return;
        }               
if ( random(3) )
        return;
if ( random(2) )
        {
        me->add("force",-25-random(25));
        me->set_temp("ATK",1);
        switch(type)
                {
                case "雨师"     :
                        message_vision(NOR WHT"\n$N丹田内息运转一周天，甩手丢出一道水雾，朝$n"NOR WHT"泼天盖地罩去！\n"NOR,me,who);
                        if ( random(3)==0 )
                                message_vision(HIG"\n$n"HIG"闪身避过。\n\n"NOR,me,who);
                        else    {
                                message_vision(NOR WHT"$n"NOR WHT"给"NOR HIG"水雾"NOR WHT"罩了个正着！顿时冻得打了个寒战，心神有些不宁。。。\n\n"NOR,me,who);
                                if ( !who->is_busy() )  who->start_busy(random(3));
                                damage = who->query_temp("apply/damage");
                                damage+= 500;
                                damage-= who->query_temp("apply/armor_vs_force");
                                if ( damage<800 )  damage = 800;
                                who->receive_wound("sen", damage,me);
                                if ( random(2) ) COMBAT_D->report_sen_status(who,damage);                                
                                }
                        break;
                
                case "风伯"     :
                        message_vision(NOR HIW"\n$N丹田内息运转一周天，仰头吹出一阵狂风，朝$n"NOR HIW"泼天盖地刮去！\n"NOR,me,who);
                        if ( random(3)==0 )
                                message_vision(HIG"\n$n"HIG"闪身避过。\n\n"NOR,me,who);
                        else    {
                                message_vision(NOR HIW"$n"NOR HIW"给刮了个正着！顿时步履蹒跚，心神有些不宁。。。\n\n"NOR,me,who);
                                if ( !who->is_busy() )  who->start_busy(3);
                                damage = who->query_temp("apply/damage");
                                damage+= 500;
                                damage-= who->query_temp("apply/armor_vs_force");
                                if ( damage<500 )  damage = 500;
                                who->receive_wound("sen", damage,me);
                                if ( random(2) ) COMBAT_D->report_sen_status(who,damage);                                
                                }
                        break;
                
                default         :
                        message_vision(NOR HIR"\n$N丹田内息运转一周天，双掌一推，一道猛烈的掌风朝$n"NOR HIR"排山倒海般逼去！\n"NOR,me,who);
                        if ( random(3)==0 )
                                message_vision(HIG"\n$n"HIG"闪身避过。\n\n"NOR,me,who);
                        else    {
                                message_vision(NOR HIR"$n"NOR HIW"给撞了个正着！\n\n"NOR,me,who);
                                message_vision(COMBAT_D->damage_msg(who->query("max_kee"),"撞伤"),me,who);
                                damage = who->query_temp("apply/damage");
                                damage+= 1000;
                                damage-= who->query_temp("apply/armor_vs_force");
                                if ( damage<1500 )  damage = 1500;
                                who->receive_wound("sen", damage,me);
                                if ( random(2) ) COMBAT_D->report_sen_status(who,damage);                                
                                }
                        break;
                }
        }
else if ( random(2) )
        {
        armor = who->query_temp("armor");
        if ( !armor || !mapp(armor) )
                return;
        me->add("mana",-25-random(25));
        me->set_temp("ATK",1);
        message_vision(NOR HIR"\n$N口中念动真言，拿手一指$n"NOR HIR"，喝道：卸！\n"NOR,me,who);
        if ( random(3)==0 )
                message_vision(HIG"\n结果$n"HIG"什么反应也没有。\n\n"NOR,me,who);
        else    {
                inv = values(armor);
                for(i=0;i<sizeof(inv);i++)
                        {
                        if ( !inv[i] )
                                continue;
                        if ( random(3)==0 )
                                message_vision(NOR YEL"$n"NOR YEL"脱下"+inv[i]->name()+NOR YEL"。\n"NOR,me,who);
                        inv[i]->unequip();
                        }
                }
        }
else    SDS_D->hitWeapon(me,who,who->query_temp("weapon"));
me->delete_temp("ATK");
}
         
varargs int receive_damage(string type, int damage, object who)
{
if ( !who || who==this_object() )
        damage = 0;
else    {
        if ( !userp(who) )
                damage = 0;
        if ( time()<query_temp("hit_by_"+who->query("id"))+5 )
                {
                if (name()!="蚩尤")     damage = 300;
                else                    damage = 0;
                }
        else    set_temp("hit_bt_"+who->query("id"),time());
        if ( damage<=0 )                               
                damage = 0;
        }
return ::receive_damage(type,damage,who);
}

varargs int receive_wound(string type, int damage, object who)
{
if ( !who || who==this_object() )
        damage = 0;
else    {
        if ( !userp(who) )
                damage = 0;
        if ( time()<query_temp("hits_by_"+who->query("id"))+15 )
                if (name()!="蚩尤")     damage = 100;
                else                    damage = 0;
        else    set_temp("hits_bt_"+who->query("id"),time());
        if ( damage<=0 )                               
                damage = 0;
        }
return ::receive_wound(type,damage,who);
}
