#include <ansi.h> 
string ask_mieyao(object me);
inherit NPC;
inherit F_MASTER;

void create()
{
  set_name("赤松子", ({"chisong zi", "chisong", "zi", "master"}));
  set ("long", @LONG
他是黄帝的好友，上古神仙赤松子。
LONG);
 
  set("title", HIC"上古神仙"NOR);
  set("gender", "男性");
  set("level", 500);
set("class","saint");
  set("age", 60);
  set("str", 45);
  set("per", 30);
  set("cor", 50);
  set("cps", 40);
  set("combat_exp", 100000000);
  set_skill("force", 220);
  set_skill("zhenlongqi", 220);
  set_skill("spells", 320);
  set_skill("xianfeng-spells", 300);
  set_skill("unarmed", 300);
  set_skill("sword", 320);
  set_skill("xuanyuan-jian", 320);
  set_skill("parry", 200);
  set_skill("literate", 300);
  set_skill("dodge", 220);
  set_skill("bagua-bufa", 220);
  set_skill("fengyun-shou", 220);
map_skill("force", "zhenlongqi");
map_skill("spells", "xianfeng-spells");
map_skill("unarmed", "fengyun-shou");
map_skill("dodge", "bagua-bufa");
map_skill("sword", "xuanyuan-jian");
map_skill("parry", "xuanyuan-jian");
  set("max_sen", 10000);
  set("max_kee", 10000);
set("force", 8000);
set("max_force", 5000);
set("mana",6000);
set("max_mana",5000);
set("daoxing",100000000);
set("force_factor", 200);
set("mana_factor", 200);
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
                (: perform_action, "unarmed", "qinna" :),
                (: perform_action, "unarmed", "fengyun" :),
                (: exert_function, "powerup" :),
                (: cast_spell, "fengyu" :),
  }) );
 
set("inquiry", ([ 
        "养性": (: ask_mieyao :), 
]) );
  create_family("三圣宫", 1, "蓝");
  setup();
 
carry_object("/d/obj/cloth/baguapao")->wear();
carry_object("/d/obj/weapon/sword/changjian")->wield();
}
 
string ask_mieyao(object me)
{
    me=this_player();
     if((string)me->query("family/family_name")=="三圣宫") {
    tell_room(environment(me),"赤松子说道.....\n");
    return "/d/obj/mieyao"->query_yao(me);
}
     return ("贫道不知道你在说些什么。");
}
