#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  set_name("应龙", ({ "ying long", "ying", "long", "master" }));
  set("long", @LONG
他是黄帝手下的大将应龙，曾辅佐黄帝大败蚩尤。
LONG);

  set("title", "轩辕氏部将");
  set("gender", "男性");
  set("level", 500);
  set("class", "saint");
  set("age", 40);
  set("str", 45);
  set("per", 18);
  set("cor", 50);
  set("cps", 40);
  set("combat_exp", 50000000);
  set_skill("force", 120);
  set_skill("zhenlongqi", 120);
  set_skill("spells", 120);
  set_skill("xianfeng-spells", 100);
  set_skill("unarmed", 100);
  set_skill("sword", 120);
  set_skill("parry", 100);
  set_skill("literate", 100);
  set_skill("dodge", 120);
  set_skill("bagua-bufa", 120);
  set_skill("fengyun-shou", 120);
  map_skill("force", "zhenlongqi");
  map_skill("spells", "xianfeng-spells");
  map_skill("unarmed", "fengyun-shou");
  map_skill("dodge", "bagua-bufa");
  set("max_sen", 10000);
  set("max_kee", 10000);
  set("force", 8000);
  set("max_force", 3000);
  set("mana", 4000);
  set("max_mana", 3000);
  set("daoxing", 50000000);
  set("force_factor", 200);
  set("mana_factor", 200);
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed", "qinna" :),
    (: perform_action, "unarmed", "fengyun" :),
    (: exert_function, "powerup" :),
    (: cast_spell, "fengyu" :),
  }));

  create_family("三圣宫", 2, "蓝");
  setup();

  carry_object("/d/obj/armor/jinjia")->wear();
}

void attempt_apprentice(object ob) {
  if (ob->query("class") != "saint") {
    command("say 你是何人？");
    return;
  }
  command("say 好吧，你就暂时在我这里学习吧！\n");
  command("recruit " + ob->query("id"));
  return;
}
