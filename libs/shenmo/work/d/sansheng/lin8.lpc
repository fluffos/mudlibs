// Room: /shulin/lin7.c
inherit ROOM;
#include <ansi.h>
void create() {
  set("short", "山洞外");
  set("long", @LONG
这是密临中心的一个山洞，极其隐蔽。洞外站着两位壮士。
LONG);
  set("exits", ([
    "north": __DIR__ "lin7",
    "enter": __DIR__ "lin9",
  ]));
  set("objects", ([
    __DIR__ "npc/fengbo": 1,
    __DIR__ "npc/yushi": 1,
  ]));
  set("no_clean_up", 0);
  setup();
}

int valid_leave(object me, string dir) {
  if (dir == "enter" && objectp(present("feng bo", environment(me))))
    return notify_fail(CYN "风伯拦住你喝说：站住！你想干什么？\n" NOR);
  if (dir == "enter" && objectp(present("yu shi", environment(me))))
    return notify_fail(CYN "雨师拦住你喝说：站住！你想干什么？\n" NOR);
  return ::valid_leave(me, dir);
}
