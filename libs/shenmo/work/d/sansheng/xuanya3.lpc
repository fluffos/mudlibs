// changan wusheng
// xuanya3.c

#include <ansi.h>
inherit ROOM;
#include <room.h>

void create() {
  set("short", "紫云崖");
  set("long", @LONG

你又爬了一阵，又爬上一个平台，豁然开朗，这里就是火云洞
的紫云崖了。平台长满了一种奇怪的植物，虽然外貌丑陋，却
治疗痘疮，这就是传说中的升麻仙草。
LONG);
  set("exits", ([ /* sizeof() == 3 */
    "north": __DIR__ "huoyunwai",
    "down": __DIR__ "xuanya2",
    "south": __DIR__ "lin1",
  ]));
  set("objects", ([
    __DIR__ "npc/zhangmen": 1,
  ]));
  set("outdoors", 1);
  setup();
}

int valid_leave(object me, string dir) {
  if (dir == "south") {
    if (objectp(present("zhang men", environment(me)))) {
      if ((string)me->query("family/family_name") == "三圣宫") {
        return ::valid_leave(me, dir);
      }
      return notify_fail(CYN "掌门大弟子嚷到：本派禁地，闲人勿近！\n" NOR);
    }
  }
  return ::valid_leave(me, dir);
}
