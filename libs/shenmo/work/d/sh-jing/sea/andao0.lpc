/********柳毅传书·暗道1-4*********/
// /d/sh-jing/sea/andao0-4.c
///连接 海底莽林 /d/sea/maze8.c enter

#include <ansi.h>
inherit ROOM;

string *bing=({ HIW"贝女"NOR,HIC"蚌母"NOR,HIG"虾兵"NOR,HIY"蟹将"NOR,HIB"夜叉"NOR,YEL"泥鳅兵"NOR,HIW"水母将"NOR,HIB"海蛇军"NOR, });

void create()
{
set("short",HIB"海底暗道"NOR);
set("long",@LONG
相传轩辕时期由共工修筑,用来封印蚩尤の首所用.其间机关重重,看守森严.
东海龙王敖广遂将此地用来禁锢重犯.
LONG);
set("water",1);
setup();
}

void init()
{
object book;
object me = this_player();
if ( book=present("liuyi's xin",me) && me->query_temp("/sh-jing/give_xin") )
	{
	remove_call_out("going");
	call_out("going",5, me);
	}
else      {
	message_vision(HIG"一股急流涌来,$N来不及反应,已给卷进浪花中!\n",me);
	me->set_temp("burnt_in_mount",0);
	me->set_temp("fanned_in_mount",0);
	me->set_temp("fan_times_in_mount",0);
	me->set_temp("fainted_in_mount",1);
	me->unconcious();
	me->move("/d/sea/under3");
	message_vision(HIG"一股急流涌来,$N从浪花中踉跄而出!\n",me);
	}
}

void going(object me)
{
int i,k;
string guard = bing[random(sizeof(bing))];
i = (int)me->query("dodge",1);
k=(int)me->query("dodge",1);
i = i/20;
i += (int)me->query("per");
k = k/50;
if (k<1) k=3;
if (k>10) k=10;
if ( i>random(50) )
	{
	for(i=1;i<k;i++)
		{
		message_vision(YEL"$N在黑暗中小心向前摸索,谨慎的迈出第"+chinese_number(i)+"步!\n"NOR,me);
		write("\n\n");
		me->add("sen",-(15+random(5)) );
//		if ( me->query("sen")<20 )  return notify_fail(HIR"你觉得心神不宁,再也不敢往前踏出半步!\n"NOR);
		}
		message_vision(HIC"$N终于摸到暗道下一层入口,见"+guard+HIC"不留神，连忙进入下一层.\n",me);
		me->move("/d/sh-jing/sea/andao"+sprintf("%d",random(5)));
	}
else      {
	message_vision(YEL"$N在黑暗中不小心拌到一块石头，"+guard+YEL"跑了出来:谁?!\n"+RED"\n糟糕!你失败啦.\n"NOR,me);
        me->delete_temp("/d/sh-jing/give_xin");
	message("channel:rumor",HIM"【"+HIW"柳毅传书"+HIM"】"+HIW+me->query("name")+"("+me->query("id")+")"+HIM"被看守三公主的"+guard+"发现了!\n"NOR,users());
	me->move("/d/city/kezhan");
	message_vision(HIY"$N见事情败露，灰溜溜的回到客栈.\n"NOR,me);
	}
}

