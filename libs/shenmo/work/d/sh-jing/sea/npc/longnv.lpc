/********龙宫三公主********/
// /d/sh-jing/sea/npc/liuyi.c 

#include <ansi.h>
inherit NPC;

int do_yes(string arg);
int regenerate();
void work_me(object me, object ob);

void create() {
  set_name("霞儿", ({ "xiaer gongzhu", "gongzhu" }));
  set("title", HIC "东海三公主" NOR);
  set("age", 18);
  set("per", 30 + random(10));
  set("long", "东海敖广的三女儿，因为和凡间书生接下情愫，故被龙王囚禁于此。");
  set("gender", "女性");
  set("kee", 5000);
  set("max_kee", 5000);
  set("sen", 5000);
  set("max_sen", 5000);
  set("combat_exp", 850000);
  set("daoxing", 3000000);
  set("attitude", "friendly");
  set("temp/armor", 300);
  set_skill("literate", 500);
  set_skill("unarmed", 100);
  set_skill("dodge", 300);
  setup();
  carry_object("/d/obj/cloth/shoes")->wear();
  carry_object("/d/obj/cloth/skirt")->wear();
}

void accept_kill(object me) {
  object ob;
  command("say " + "我不和你打~~~!");
  return 0
}

int accept_object(object me, object obj) {
  object ob, xin;
  me = this_player();
  ob = this_object();
  if ((int)me->query_temp("sh-jing/give_xin")) {
    if (xin == present("liu's xin", me)) {
      command("ah");
      message_vision("$N说道:果真是柳郎的亲笔书函...\n$n大侠可否帮小女子传书一回(yes)？\n\n", ob, me);
    } else {
      command("say " + "柳郎的信呢。。。\n");
      command("hmm");
    }
  } else {
    message_vision(
      "$N说道:在下受人之托,传书于那东海龙王,不想与其三公主一见钟情，\n奈何龙王顽固,不愿意将公主许配予偶这凡人，在下欲与公主近期逃脱东海范辖。\n怎奈公主为龙王所困，$n大侠可否帮小可传书予公主(yes)？\n\n",
      ob,
      me
    );
  }
}

void init() {
  add_action("do_yes", "yes");
}

int do_yes(string arg) {
  object me, ob;
  me = this_player();
  ob = this_object();

  if (me->query_temp("sh-jing/give_xin")) {
    message_vision("$N答道：某助汝一臂之力！\n\n", me);
    if (query("no_xin") == 0) {
      message_vision("$N对$n千叮万嘱道：此事极为危险,万一不成，先生就当没有这回事！\n", ob, me);
      me->set_temp("sh-jing/give_xin", 0);
      me->set_temp("sh-jing/xin", 0);

      carry_object("/d/sh-jing/obj/xin");
      command("give xin to " + me->query("id"));
      set("no_xin", 1);
      call_out("regenerate", 120);
    } else {
      message_vision("$N说道：不劳大侠了，此事自有他人相助。\n", ob);
      command("thank");
    }
    return 1;
  }
  return 0;
}
