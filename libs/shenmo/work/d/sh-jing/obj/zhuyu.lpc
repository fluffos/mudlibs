/***********祝余 + dodge *********/
// /d/sh-jing/obj/zhuyu.c 

#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIG "祝余" NOR, ({ "zhu yu", "cao" }));
  set_weight(200);
  if (clonep()) set_default_object(__FILE__);
  else {
    set("unit", "棵");
    set("long", "海中仙山自生成，据说吃了人可以身轻如燕。\n");
    set("value", 5000);
  }
  setup();
}

void init() {
  object me = this_player();
  if (!wizardp(me)) {
    set("no_get", this_object()->query("name") + "渐渐枯萎了！\n");
    set("no_give", this_object()->query("name") + "渐渐枯萎了！\n");
    set("no_drop", this_object()->query("name") + "渐渐枯萎了！\n");
    set("no_sell", this_object()->query("name") + "渐渐枯萎了！\n");
    set("no_put", this_object()->query("name") + "渐渐枯萎了！\n");
  }
  add_action("do_eat", "eat");
}

int do_eat(string arg) {
  object me = this_player();
  object ob = this_object();
  object book;
  if ((int)me->query_temp("zhuyu")) return notify_fail(HIW "莫非你想生仙？这东西不能乱吃。\n" NOR);
  if (!book = present("shanhaijing", me)) {
    message_vision(HIW "$N不知道从哪儿搞到一棵$n，兴奋的放在嘴中大嚼！\n", me, ob);
    destruct(ob);
    me->unconcious();
  }

  if (arg = ob->query("id")) {
    message_vision("$N将$n放进嘴中大嚼起来，觉得自己身体好似轻了许多。\n", me, ob);
    me->add_temp("apply/dodge", 100);
    me->set_temp("zhuyu", 1);
    destruct(ob);
  }
}
