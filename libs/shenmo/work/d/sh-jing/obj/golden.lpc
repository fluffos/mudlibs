/*****山海经·宝石，值100两黄金***********/
///d/sh-jing/obj/baoshi.c 
#include <ansi.h>
inherit ITEM;
string *names = ({ "赤金石", RED, "蓝金石", BLU, "黄金石", HIY, "白金石", WHT, });

void create() {
  int i;
  string name, clo;
  i = random(sizeof(names));
  name = names[i];
  clo = names[i + 1];
  set_name(clo + name + NOR, ({ "jinshi" }));
  if (clonep()) set_default_object(__FILE__);
  else {
    set("weight", 10);
    set("long", BLINK + HIW "亮晶晶的宝石，人见人爱。\n" NOR);
    set("unit", "颗");
    set("value", 1000000);
  }
}
