/*****山海经·宝石，值100两黄金***********/
///d/sh-jing/obj/baoshi.c 
#include <ansi.h>
inherit ITEM;
string *names = ({ "红宝石", HIR, "绿宝石", HIG, "黄宝石", HIY, "白宝石", HIW, });

void create() {
  int i;
  string name, clo;
  i = random(sizeof(names));
  name = names[i];
  clo = names[i + 1];
  set_name(clo + name + NOR, ({ "baoshi" }));
  if (clonep()) set_default_object(__FILE__);
  else {
    set("weight", 5);
    set("long", BLINK + HIW "亮晶晶的宝石，人见人爱。\n" NOR);
    set("unit", "颗");
    set("value", 500000);
  }
}
