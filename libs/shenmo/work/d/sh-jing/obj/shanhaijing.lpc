/**********山海经*********/
// /d/sh-jing/obj/shanhaijing.c 

#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIR "【" + HIW "山海经" + HIR "】" NOR, ({ "shanhaijing" }));
  set("long", "西汉刘歆做著之山海经，内含千奇百怪之事，为世人向往之迷离世界。");
  set("unit", "本");
  set("weight", 50);
  set("no_give", HIW "这本书得来不易，还是你自己留着吧......" NOR);
  set("no_drop", HIW "这本书得来不易，还是你自己留着吧......" NOR);
  set("no_sell", HIW "这本书得来不易，还是你自己留着吧......" NOR);
  set("no_get", HIW "这本书得来不易，还是让主人自己留着吧......" NOR);
  set("no_put", HIW "这本书得来不易，还是让主人自己留着吧......" NOR);
}
