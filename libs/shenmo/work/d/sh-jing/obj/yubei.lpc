/**********育贝*********/ 
// /d/sh-jing/obj/yubei.c 
        
#include <ansi.h> 
inherit ITEM; 
        
void create() 
{ 
set_name(HIW"育贝"NOR,({"yu bei","bei"})); 
set("long",BLINK+HIG"丽水里所生产的一种奇妙贝壳，据说吃了可以常年不饥。"NOR); 
set("unit","个"); 
set("weight",100); 
} 
       
void init() 
{ 
add_action("do_eat","eat"); 
 } 
       
int do_eat(string arg) 
{ 
object me=this_player(); 
object book; 
object ob = this_object(); 
//if ((arg)!="yu bei" || (arg)!="bei" )    return notify_fail("你要吃什么？\n"); 
if( book=present("shanhaijing",me) ) 
	{ 
	message_vision(HIG"$N吃下一片$n的肉，脸上露出满意的微笑“仙山之物，果然不同凡响”\n"NOR,me,ob); 
	me->set("food",10000); 
	me->set("water",10000); 
	destruct(ob); 
	} 
else return notify_fail(HIG"这个东西你可吃不得\n"NOR); 
} 