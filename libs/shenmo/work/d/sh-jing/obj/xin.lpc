/***********龙女给柳毅的书信********/ 
// /d/sh-jing/obj/longnvxin.c 
        
#include <ansi.h> 
inherit ITEM; 
        
create() 
{ 
set_name(HIC"柳毅"NOR+"给"+HIC"三公主"NOR+"的"+HIW"信"NOR,({"liuyi's xin"}) ); 
set("long","柳毅给东海三公主的私人密函......\n"); 
