1 /*******招摇山1********/ 2       // /d/sh-jing/zhaoyao1.c 
3 4 # include < ansi.h > 5 inherit ROOM;
6 object *bao = ({ "/d/sh-jing/obj/baoshi", "/d/sh-jing/obj/golden" });
7 8 void create() 9 {
  10 set("short", HIW "招摇山" NOR);
  11 set("long", @LONG  
12      南山第一山脉鹊山山脉的最高峰。濒临西海上端，山上生长的树种多为桂树，并且蕴  
13      含着大量的金玉矿石，地上满是一种叫“祝余”的草(cao)，绿油油的，开着青色的小花。   
14      再往高处去，树木模样一变，全是古怪的模样。隐约出来猿猴凄厉的尖叫声......   
15      山下一条小河(river)细细长流，向西注入西海。   
16      LONG); 
17      set("item_desc",([ 
18         "cao" : "一种叫祝余的小草，据说吃了人身轻如燕，你可以摘(dig)下来看看。\n",  
19         "river" : "丽水河，河底奇形怪状的小鱼在贝壳间悠闲的游荡，让人禁不住也想游(swim)去看看\n",  
20        ])); 
21      set("exits",([ 
22           "east" : __DIR__"tang",   
23            "up" :   __DIR__"zhaoyao2",   
24      ])); 
25       
26      set("water",1); 
27      setup(); 
28      } 
29       
30      void init() 
31      { 
32      add_action("do_dig","dig"); 
33      add_action("do_swim","swim"); 
34      } 
35       
36      int do_swim( ) 
37      { 
38      object me = this_player(); 
39      object book; 
40      if ( !book=present("shanhaijing",me) ) 
41         { 
42        message_vision("一阵清风吹过，$N一阵恍惚，已随清风去......\n",me); 
43        me->move("/d/city/center"); 
44        me->start_busy(2); 
45        message_vision("等$N清醒过来，已身在闹市......\n",me); 
46        } 
47       else { 
48      message_vision("$N见河水清澈见底，不禁纵身跳进河水里嬉戏......\n",me); 
49      me->move("/d/sh-jing/lishui"); 
50         } 
51      } 
52       
53      int do_dig(string arg) 
54      { 
55      object me = this_player(); 
56      object sth,book; 
57      if ( !book=present("shanhaijing",me) ) 
58            return notify_fail(BLINK+HIC"什么？\n"NOR); 
59       
60      if( arg=="cao" || arg=="草" ) 
61       { 
62         if(random(5)==5) 
63            { 
64            sth=new("/d/sh-jing/obj/zhuyu"); 
65           message_vision("$N从泥土中挖出一棵小草，累得满头大汗。\n",me); 
66            sth->move(me); 
67              me->add("kee",-(me->query("max_kee")/10) );  
68              me->add("sen",-( (me->query("max_sen"))/10 ) );  
69              me->start_busy(random(40-(int)me->query("kar")));  
70          } 
71          else { 
72             message_vision("$N累得满头大汗,可惜一无所获。\n",me);  
73             me->add("kee",-(me->query("max_kee")/10) );  
74             me->add("sen",-(me->query("max_sen")/10) );  
75             me->start_busy(random(5));  
76            } 
77       } 
78       
79      if( arg=="di"||arg=="土" ) 
80       { 
81         sth=bao[random(sizeof(bao))]; 
82          if(random(10)==5) {  
83         sth->move(me); 
84        message_vision(HIR"$N发现地下好似有些东西，赶紧挖开一看，哇！宝石~~ \n",me);  
85       message("channel:rumor",HIC"【 "+HIW"山 海 经"+HIC" 】"+BLINK+HIM+me->query("name")+NOR+HIC"在招摇山发现宝藏！\n"NOR,users());  
86             me->add("kee",-(me->query("max_kee")/30) );  
87             me->add("sen",-(me->query("max_sen")/30) );  
88             me->start_busy(random(3));  
89            } 
90         else { 
91        message_vision("$N忙了半天，结果除了累出一身臭汗，其他一无所获。\n",me);  
92             me->add("sen",-(me->query("max_sen")/50) );  
93             me->add("kee",-(me->query("max_kee")/50) );  
94             me->start_busy(random(3));  
95           } 
96       } 
97      } 
9




