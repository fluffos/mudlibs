1       /*******招摇山·丽水******/ 
2       // /d/sh-jing/lishui.c 
3        
4       #include <ansi.h> 
5       inherit ROOM; 
6        
7       void create() 
8       { 
9       set("short",HIG"丽水"NOR); 
10      set("long",@LONG 
11      丽水河，源于招摇山山顶的天池，向西流入大海。 
12      光线经过河水的折射，构成了水底五彩斑斓的世界。好多奇特的生物在水里悠闲 
13      的游来游去，水底的泥沙中懒懒的贝壳(beike)随水流微微动荡。 
14      LONG); 
15      set("item_desc",([ 
16           "beike" : "一种叫育贝的小贝壳，据说吃了它的肉可以常年不饥。\n", 
17         ])); 
18      set("exits",([ 
19          "up" : "/d/sh-jing/zhaoyao1" , 
20         ])); 
21      setup(); 
22      } 
23       
24      void init() 
25      { 
26      add_action("do_dig","dig"); 
27      } 
28       
29      int do_dig(string arg) 
30      { 
31      object me=this_player(); 
32      object ob=new("/d/sh-jing/obj/yubei"); 
33      object book; 
34      if ( !book=present("shanhaijing",me)) 
35       { 
36      message_vision("一阵水流急冲过来，$N还没来得及反应，已经卷入水流之中！\n",me); 
37      me->move("/d/city/kezhan"); 
38      message_vision("一阵大雨倾盆而下，$N随着水花落将下来！\n",me);  
39      me->unconcious(); 
40       } 
41      if (random(5)>3) 
42       { 
43      message_vision("$N在水底一阵乱挖，搞得河底淤泥泛起，吓得$N赶紧跳上岸去！\n",me); 
44      me->move("/d/sh-jing/zhaoyao1"); 
45      message_vision("水面翻起一阵气泡，$N狼狈不堪的跳上岸来！\n",me); 
46      me->set("title",HIY"落汤鸡"NOR); 
47       } 
48      else { 
49      message_vision("$N在水中看准一个贝壳，眼疾手快，贝壳到手！\n",me); 
50      ob->move(me); 
51      me->move("/d/sh-jing/zhaoyao1"); 
52      message_vision("水面翻起一阵气泡，$N兴高采烈的跳上岸来！\n",me); 
53      me->set("title",HIW"浪里白条"NOR);  
54        } 
55      } 
