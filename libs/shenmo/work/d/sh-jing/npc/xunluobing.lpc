/**********柳毅保镖*******/
#include <ansi.h>
inherit NPC;

void create() {
  set_name("龙女侍卫", ({ "longnv shiwei", "shiwei", "bing" }));
  set("gender", "男性");
  set("age", random(10) + 20);
  set("str", 35);
  set("con", 25);
  set("spi", 25);
  set("dex", 25);
  set("int", 25);
  set("long", HIC "龙女的贴身侍卫，奉命暗中保护心上人柳毅。\n" NOR);
  set("combat_exp", 8000000);
  set("class", "dragon");
  set("attitude", "herosim");
  set_skill("unarmed", 300);
  set_skill("force", 300);
  set_skill("dragonfight", 300);
  set_skill("dragonstep", 300);
  set_skill("dragonforce", 300);
  set_skill("seashentong", 300);
  set_skill("fengbo-cha", 300);
  set_skill("fork", 300);
  set_skill("dodge", 300);
  map_skill("unarmed", "dragonfight");
  map_skill("parry", "fengbo-cha");
  map_skill("dodge", "dragonstep");
  map_skill("parry", "fengbo-cha");
  map_skill("force", "dragonforce");
  set_skill("spells", 300);
  map_skill("spells", "seashentong");
  set("max_kee", 7000);
  set("max_sen", 7000);
  set("force", 9000);
  set("max_force", 4500);
  set("force_factor", 50 + random(50));
  set("max_mana", 4500);
  set("mana", 9000);
  set("mana_factor", 30);
  setup();
  carry_object("/d/obj/armor/tiejia")->wear();
}

int accept_fight(object me) {
  object ob = this_object();
  message_vision("$n朝$N翻了翻白眼，说道：公主叫某家不要在凡间闹事......\n\n", me, ob);
  return 0;
}

int accept_kill(object me) {
  object ob = this_object();
  message_vision("$n朝$N翻了翻白眼，说道：公主叫某家不要在凡间闹事......\n\n", me, ob);
  return 0;
}

int heal_up() {

  if (environment() && !is_fighting()) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  object stone;
  this_object()->add("time", 1);
  if ((int)this_object()->query("time") >= 3) {
    message(
      "vision",
      name() + "“吼吼”笑了两声:饶尔贱命,下次遇到,可没那么走运! 龙女侍卫走了出去。\n",
      environment(),
      this_object()
    );
    destruct(this_object());
  }
  return;
}
