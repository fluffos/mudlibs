/********柳毅********/
// /d/sh-jing/npc/liuyi.c 

#include <ansi.h>
inherit NPC;

int do_yes(string arg);
int regenerate();
void work_me(object me, object ob);

void create() {
  set_name("柳毅", ({ "liu yi", "liu" }));
  set("title", HIW "白衣书生" NOR);
  set("age", 22);
  set("per", 20 + random(20));
  set("long", "落第书生，洛阳人士。");
  set("gender", "男性");
  set("kee", 5000);
  set("max_kee", 5000);
  set("sen", 5000);
  set("max_sen", 5000);
  set("combat_exp", 550000);
  set("daoxing", 1000000);
  set("attitude", "friendly");
  set("env/wimpy", 80);
  set("inquiry", ([
    "name": "唉，一落第书生，何足挂齿。\n",
    "here": "我也不知道我在何处哦。\n",
    "书信": (: work_me :),
  ]));
  set_skill("literate", 500);
  set_skill("unarmed", 100);
  set_skill("dodge", 300);
  setup();
  carry_object("/d/obj/cloth/bai")->wear();
}

void accept_kill(object me) {
  object ob;
  if (is_fighting()) return;
  if (query("called")) return;
  command("say " + "龙女救偶~~~!");
  ob = present("xunluo guanbing");
  if (!ob) {
    seteuid(getuid());
    ob = new("/d/sh-jing/npc/xunluobing");
    ob->move(environment());
  }
  message_vision(HIB "\n\n忽然风云变色，从天上落下个龙首人身的神氐，对$N大喊一声:找死啊！想害偶家公主的心头好！\n\n", me);
  ob->kill_ob(me);
  ob->set_leader(me);
  me->fight_ob(ob);
  set("called", 1);
  call_out("regenerate", 300);
}

int regenerate() {
  set("called", 0);
  return 1;
}

void work_me(object me, object ob) {
  object xin;
  me = this_player();
  ob = this_object();
  if ((int)me->query_temp("sh-jing/xin")) {
    if (xin == present("longnvshuxin", me)) {
      command("say " + "呀，看你面带喜色，看来是有喜讯了，是不是公主有回音了？\n");
      command("hmm " + me->query("id"));
    } else {
      command("say " + "看先生面带愁容，此事情还作罢。。。\n");
      command("sigh");
      me->delete_temp("sh-jing/xin");
    }
  } else {
    me->set_temp("sh-jing/give_xin", 1);
    message_vision(
      "$N说道:在下受人之托,传书于那东海龙王,不想与其三公主一见钟情，\n奈何龙王顽固,不愿意将公主许配予偶这凡人，在下欲与公主近期逃脱东海范辖。\n怎奈公主为龙王所困，$n大侠可否帮小可传书予公主(yes)？\n\n",
      ob,
      me
    );
  }
}

void init() {
  add_action("do_yes", "yes");
}

int do_yes(string arg) {
  object me, ob, xin;
  me = this_player();
  ob = this_object();

  if (me->query_temp("sh-jing/give_xin")) {
    message_vision("$N答道：某助汝一臂之力！\n\n", me);
    if (query("no_xin") == 0) {
      message_vision("$N对$n千叮万嘱道：此事极为危险,万一不成，先生就当没有这回事！\n", ob, me);
      me->set_temp("sh-jing/give_xin", 1);
      xin = new("/d/sh-jing/obj/xin");
      message_vision("$N递给$n一封信！\n", ob, me);
      xin->move(me);
      set("no_xin", 1);
      call_out("regenerate", 120);
    } else {
      message_vision("$N说道：不劳大侠了，此事自有他人相助。\n", ob);
      command("thank");
    }
    return 1;
  }
  return 0;
}
