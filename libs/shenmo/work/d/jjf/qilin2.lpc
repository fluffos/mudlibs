// Room: /d/jjf/qilin2.c

#include <room.h>
#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "麒麟阁二楼");
        set("long", @LONG
    二楼比起一楼来，只有更加豪华气派。墙上绘着几幅沙场景象，
一幅是秦琼走马取关，一幅是程咬金斧劈隋将。席间一位黑脸将军正
在开怀畅饮。窗外，无数百姓聚集在街对面一座彩楼前指指点点。
LONG
        );
        set("no_fight", 1);
        set("objects", ([ /* sizeof() == 1 */
            "/d/jjf/npc/gong": 1,
]));
        set("light_up", 1);
        set("exits", ([ /* sizeof() == 1 */
      "down" : "d/jjf/qilin",
]));

        setup();
}



void init()
{
        add_action("do_none","cast");
        add_action("do_none","kill");
        add_action("do_none","ji");
        add_action("do_none","bian");
        add_action("do_none","exert");
}
int do_none()
{
        object me = this_player();
         tell_object(me,HIR"大神说了：禁止搞破坏!\n"NOR);
        return 1;
}

