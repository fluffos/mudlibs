int job_over(string arg) {
  int job_pot, job_exp, job_dx;
  object me = this_player();

  if (!arg) return 1;
  if (arg != "over") return 1;
  if (me->query_temp("mark/gong_city") == 0) {
    message_vision(CYN "$N瞧了$n一眼:“没任务还什么完成不完成。”\n", this_object(), me);
    return 1;
  }
  if (me->query_temp("job_over") == 0) {
    message_vision(CYN "$N瞧了$n一眼:“任务还没完成。”\n" NOR, this_object(), me);
    return 1;
  }
  if (me->query_temp("killed_hulu") < 10) {
    message_vision(CYN "$N瞧了$n一眼:“你才杀了几个敌人，还好意思来领赏？”\n" NOR, this_object(), me);
    return 1;
  }
  message_vision(
    CYN "$N拍了拍$n的肩膀说道：“辛苦" + RANK_D->query_respect(me) + "了，去休息一下吧。为国杀敌，忠勇可嘉！”\n" NOR,
    this_object(),
    me
  );
  me->set("gongjob/time_over", time());
  me->delete_temp("job_over");
  me->delete_temp("mark/gong_city");
  job_exp = ((int)me->query_temp("killed_hulu")) * 800;
  job_dx = job_exp;
  job_pot = job_exp / 8;
  me->add("combat_exp", job_exp);
  me->add("daoxing", job_dx);
  me->add("potential", job_pot);
  me->add("shen", 6);
  if (me->query("office_number") < 12001)
    me->add("office_number", 1);
  me->delete_temp("killed_hulu");
  job_dx = job_dx / 1000;
  tell_object(
    me,
    HIY "你被奖励了" + chinese_number(job_exp) + "点武学经验，\n" + chinese_number(job_dx) + "年道行，\n" + chinese_number(job_pot) + "点潜能，\n以及一点官职！\n"
  );
  tell_object(me, HIY "你额外得到了6点神的奖励！\n");
  me->start_busy(3);
  return 1;
}

string ask_jobover() {
  object me;
  me = this_player();
  if (!me->query_temp("mark/gong_city"))
    return "你没有领任务,跑这里瞎嚷嚷什麽?";
  me->clear_condition("gongjob_limit");
  me->add("combat_exp", -1000 + random(20));
  me->add("daoxing", -1000 + random(20));
  me->delete_temp("mark/gong_city");
  me->delete_temp("carry_location");
  me->delete_temp("job_over");
  me->delete_temp("start_job");
  me->set("gongjob/time_over", time());
  return "没关系，下次继续努力 。";
}
