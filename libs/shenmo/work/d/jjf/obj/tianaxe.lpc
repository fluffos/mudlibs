#include <weapon.h>

#include <ansi.h>
inherit AXE;
inherit F_UNIQUE;

void create() {
  set_name(HIW "天罡战斧" NOR, ({ "tiangang axe", "axe" }));
  set_weight(12000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "一把车轮大小的斧子，想当年程咬金三斧子定瓦岗就是靠的它。\n");
    set("value", 50000);
    set("material", "iron");
    set("no_break", 1);
    set("wield_msg", "$N从背后摘下一把$n握在手中，眼前闪过一道寒光．\n");
    set("replace_file", "/d/obj/weapon/axe/huafu");
    set("unwield_msg", "$N放下手中的$n，缓缓背到背后。\n");
  }

  init_axe(250);
  setup();
}
