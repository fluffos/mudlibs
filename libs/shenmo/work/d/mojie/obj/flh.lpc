#include <weapon.h>
#include <ansi.h>
#include <combat.h>
inherit WHIP;

void create()
{
  set_name(HIC"敷莲花"NOR, ({"fu lianhua", "lianhua", "lian hua" }) );
 init_whip(125);
  set("unit", "根");
  set_weight(300);
  if( clonep() )
     set_default_object(__FILE__);
  else {
    set("value", 280);
    set("material", "tron");

  }
  set("wield_msg",HIC"$N嘴唇含笑,十指轻颤，一道佛光化作$n"NOR+HIC"瞬时拈在手里。\n"NOR);
  set("unwield_msg", HIC"$N微微一笑，$n"NOR+HIC"已无影无踪！\n"NOR);
  
  setup();
}

mixed hit_ob(object me, object victim)
{
    int damage_bonus = 0;
    
    if( (string)me->query("family/family_name") == "魔界"
                && me->query_skill("liudu-whip",1) > 1)
    damage_bonus = me->query_skill("liudu-whip",1);
    damage_bonus = (damage_bonus+random(damage_bonus))/2;

    victim->receive_wound("kee",damage_bonus);
return HIC"敷莲花"+HIW"幻出道道异芒！\n" NOR;

}


