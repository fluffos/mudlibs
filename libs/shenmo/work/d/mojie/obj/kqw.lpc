// whip.c

#include <weapon.h>
//  inherit F_UNIQUE;

inherit WHIP;
#include <ansi.h>
void create()
{
 set_name(HIM"孔雀尾"NOR, ({"kongque wei", "whip"}));
        set_weight(500);
if( clonep() )
                set_default_object(__FILE__);
        else {
set("long","长长飘逸的孔雀长尾，相传为孔雀大明王菩萨手持四神器之一！\n");
                set("unit", "条");
                set("value", 12000);
		set("wield_msg", "$N倏地伸出手掌，手心中突然多了一条孔雀长尾\n");
		set("unwield_msg", "$N诡异的一笑$n神秘的消失了！\n");
		set("weapon_prop/courage", 20);
		}
        init_whip(100);
        setup();
}
mixed hit_ob(object me, object victim)
{
    int damage_bonus = 0;
    
    if( (string)me->query("family/family_name") == "魔界"
                && me->query_skill("liudu-whip",1) > 1)
    damage_bonus = me->query_skill("liudu-whip",1);
    damage_bonus = (damage_bonus+random(damage_bonus))/2;

victim->receive_wound("sen",damage_bonus);
    return HIM"孔雀尾"+HIW"上散出道道幻影！\n" NOR;

}

