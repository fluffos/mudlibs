#include <weapon.h>

inherit WHIP;
#include <ansi.h>
void create() {
  set_name(HIR "黑莲" NOR, ({ "heilian", "whip" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "杀神弑佛所用兵器之一。\n");
    set("unit", "条");
    set("value", 30000);
  }
  init_whip(100);
  setup();
}
