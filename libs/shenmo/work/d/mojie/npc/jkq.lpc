//mojie--kongque.c

#include <ansi.h>
inherit NPC;


void create() {
  set_name(HIY "金 色 孔 雀" NOR, ({ "kongque", "kong que" }));
  set("long", HIY "故老相传，金色孔雀为大金曜孔雀明王于灵山之颠收服的异兽" NOR + HIY "。\n" NOR);
  set("race", "野兽");
  set("title", "异兽");
  set("age", 10000);

  set("combat_exp", 100000);
  set("max_kee", 1000);
  set("kee", 1000);
  set("eff_kee", 1000);
  set("max_sen", 1000);
  set("sen", 1000);
  set("eff_sen", 1000);

  set("limbs", ({ "头部", "身体", "尾巴" }));
  set("verbs", ({ "bite" }));

  set("chat_chance", 1);

  set("ride/msg", "骑");
  set("ride/dodge", 70 + random(6));
  set_temp("apply/attack", 10);
  set_temp("apply/armor", 20);

  setup();
}
