#include <ansi.h>
inherit NPC;
#include <ansi.h>
inherit F_MASTER;
void create()
{
        set_name("无天", ({"wu tian"}));
        set("gender", "男性" );
        set("age", 33);
        set("title",HIR "魔界佛祖" NOR);
        set("combat_exp", 10000000);
	set("daoxing", 15000000);
              set("long","此魔是如来佛祖的心魔，魔罗转世。\n");
        set("attitude", "peaceful");
	set("int", 25);
        set("class", "yao");
        create_family("魔界", 1, "弟子");
	
        set("eff_dx", 30000);
        set("nkgain", 200);
         set("max_kee", 15000);
        set("max_sen", 15000);
        set("force", 12000);
        set("max_force", 6000);
        set("force_factor", 250);
        set("mana", 12000);
        set("max_mana", 6000);
        set("mana_factor", 250);


        set_skill("unarmed", 500);
        set_skill("dodge", 500);
        set_skill("parry", 500);
        set_skill("spells", 500);  
        set_skill("molian-spells", 500);
        set_skill("literate", 500);
        set_skill("sword", 500);  
        set_skill("xueling-jian", 500);
        set_skill("shifo-zhi", 500);  
        set_skill("moshenbu", 500);
        set_skill("dodge", 500);  
        set_skill("force", 500);   
        set_skill("heilian-force", 500);
  set_skill("whip", 500);
  set_skill("liudu-whip", 500);

        map_skill("spells", "molian-spells");
        map_skill("unarmed", "shifo-zhi");
        map_skill("force", "heilian-force");
        map_skill("sword", "xueling-jian");
        map_skill("parry", "xueling-jian");
        map_skill("dodge", "moshenbu");
         map_skill("whip", "liudu-whip");
        set("chat_chance_combat", 50);
       set("chat_msg_combat", ({
                (: cast_spell, "hufa" :),
                (: perform_action, "whip", "shi" :),
}));
        setup();
        carry_object("/d/mojie/obj/tongjia")->wear();
        carry_object("/d/mojie/obj/whip")->wield();
carry_object("/d/mojie/obj/hlbook");	
}
 void attempt_apprentice(object ob, object me)
{
  if( (int)ob->query_skill("force", 1) < 200 ) {
  command("say 这位" + RANK_D->query_respect(ob) + "对我魔道内功领会还不够深，现在收你也是勉为其难，不如作罢！\n");              
      return;
     }
        command("say 很好，" + RANK_D->query_respect(ob) +
"加入魔界以后多加努力，他日为杀如来做出你的贡献。\n");
        command("recruit " + ob->query("id") );
            ob->set("title", HIW"魔界无天佛祖亲传弟子"NOR);
	return;
}		

int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "yao");
}


