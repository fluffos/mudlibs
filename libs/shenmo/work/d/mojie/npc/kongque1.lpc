#include <ansi.h>
inherit NPC;
inherit F_MASTER;

string ask_wutian();

void create()
{
  set_name(HIC"孔雀大明王"NOR, ({"kongque", "kongque pusa"}));
       set("long",
            "佛母---孔雀大明王菩萨\n");
       set("title", HIY"佛 母"NOR);
       set("gender", "女性");
       set("age", 160);
       set("class", "xian");
       set("attitude", "friendly");
       set("rank_info/respect", "王者");
       set("per", 40);
	set("int", 30);
       set("max_kee", 9000);
       set("max_gin", 6000);
       set("max_sen", 8000);
       set("force", 8000);
       set("max_force", 8000);
       set("force_factor", 500);
       set("max_mana", 6000);
       set("mana", 6000);
       set("mana_factor", 400);
       set("combat_exp", 4000000);
       set("daoxing", 8000000);


        set("eff_dx", 200000);
        set("nkgain", 350);

       set_skill("dodge", 480);
       set_skill("blade", 480);
       set_skill("zileidao", 480);
       set_skill("force", 480);
       set_skill("parry", 480);
       set_skill("tianmogong", 480);
       set_skill("spells", 480);
        set_skill("huntianforce", 480);
        set_skill("literate", 480);
        set_skill("zhaoyangbu", 480);
        map_skill("spells", "tianmogong");
        map_skill("force", "huntianforce");
        map_skill("parry", "zileidao");
        map_skill("dodge", "zhaoyangbu");

        create_family("魔界", 2, "弟子");

        set("inquiry", ([
                ]) );

        set("inquiry", ([
                
                "魔界" : (: ask_wutian :),
                "魔王" : (: ask_wutian :),
                "无天" : (: ask_wutian :),
                ]) );

        setup();

        carry_object("/d/obj/armor/jinjia")->wear();
        carry_object("/d/obj/weapon/blade/blade")->wield();
}

string ask_wutian()
{
  object me=this_player();
  object ob=this_object();
     command("sigh");
 message_vision("$N长叹了一声，无天这些年来纵横三界，你确要见他，我也只好送你去了！\n",ob);
  me->move("/d/mojie/midong");
  return "切莫鲁莽！\n";
}
