inherit NPC;
inherit F_MASTER;
#include <ansi.h>
string ask_mieyao(object me);
string ask_cancel();
#include "/d/panshi/panshi.h"


void create() {
  set_name(HIC "孔雀大明王" NOR, ({ "kongque", "kongque pusa" }));
  set("long",
    "佛母---孔雀大明王菩萨\n");
  set("title", HIY "佛 母" NOR);
  set("gender", "女性");
  set("age", 160);
  set("class", "xian");
  set("attitude", "friendly");
  set("rank_info/respect", "王者");
  set("per", 40);
  set("int", 30);
  set("max_kee", 9000);
  set("max_gin", 6000);
  set("max_sen", 8000);
  set("force", 8000);
  set("max_force", 8000);
  set("force_factor", 500);
  set("max_mana", 6000);
  set("mana", 6000);
  set("mana_factor", 400);
  set("combat_exp", 4000000);
  set("daoxing", 8000000);


  set("eff_dx", 200000);
  set("nkgain", 350);

  set_skill("dodge", 480);
  set_skill("blade", 480);
  set_skill("zileidao", 480);
  set_skill("force", 480);
  set_skill("parry", 480);
  set_skill("tianmogong", 480);
  set_skill("spells", 480);
  set_skill("huntianforce", 480);
  set_skill("literate", 480);
  set_skill("zhaoyangbu", 480);
  map_skill("spells", "tianmogong");
  map_skill("force", "huntianforce");
  map_skill("parry", "zileidao");
  map_skill("dodge", "zhaoyangbu");

  set("chat_chance", 50);
  // set("chat_msg", ({
  // (: msg :),
  // }))
  create_family("魔界", 2, "弟子");

  setup();
  set("inquiry", ([

    "杀神弑佛": (: ask_mieyao :),
    "cancel": (: ask_cancel :),
  ]));


  carry_object("/d/moon/obj/luoyi")->wear();
  carry_object("/d/obj/weapon/sword/changjian")->wield();
}


string ask_cancel() {
  object me = this_player();
  if ((int)me->query_temp("m_mieyao")) {
    me->add("daoxing", -2000);
    me->delete_temp("m_mieyao");
    me->delete("secmieyao");
    me->delete("secmieyao/type");
    me->delete("secmieyao/location");
    me->delete("secmieyao/place");
    me->delete("secmieyao/name");
    me->delete("secmieyao/id");
    return ("哎，我也不怪你，以后你可得努力哦！");
  } else {
    return ("你有任务吗？！");
  }
}
string ask_mieyao(object me) {
  me = this_player();
  if ((string)me->query("family/family_name") == "魔界") {
    tell_room(environment(me), "孔雀明王说道.....\n");
    return "/d/obj/mieyao"->query_yao(me);
  }
  return ("孔雀明王不知道你在说些什么。");
}
