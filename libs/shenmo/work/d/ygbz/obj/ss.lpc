#include <armor.h>
#include <ansi.h>
inherit F_UNIQUE;

inherit SHIELD;

void create()
{
        set_name(MAG"埃辛诺斯壁垒"NOR, ({"boss shield"}));
        set_weight(6000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("no_put",1);
                set("no_pawn",1);
                set("no_sell",1);
                set("material", "wood");
                set("value", 1000);
                set("armor_prop/armor", 10000);
        }
        setup();
}
void announce(object who)
{
    if(!this_object()) return;
    if(!userp(who)) return;
    CHANNEL_D->do_channel(this_object(), "rumor", 
            who->query("name")+"得到了"+name()+"！\n");
}
void init()
{
    
    remove_call_out("announce");
    call_out("announce",random(10),this_player());
}

