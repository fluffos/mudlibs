#include <weapon.h>
inherit STICK;
#include <ansi.h>

void create()
{
        set_name(HIY"震魔棒"NOR, ({ "zhenmo bang", "club", "bang" }));
        set_weight(10000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("long", HIY"听说这是天上遗落在人间的仙物,凡人得之,将成为一件杀人利器。\n"NOR);
                set("value", 0);
                set("material", "steel");
                set("wield_msg", HIY"$N从背后拔出一根金光闪闪的震魔棒，天地为之失色。\n"NOR);
                set("unwield_msg", HIY"$N将手中震魔棒放下背在背后。\n");
        }
      init_stick(180);
    //set("no_give",1);
   // set("no_get",1);
        setup();
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        int pro;
        int dam;
        pro = (int) victim->query_temp("apply/armor_vs_fire");
        dam = (int) me->query("force");
        if(dam > pro)
        {
       
        victim->receive_wound("sen",200);
        return HIY"震魔棒突然发出嗡嗡的轰鸣,"NOR+MAG"『$n"NOR+MAG+"』"NOR+HBRED+HIY"觉得眼前一阵金星乱冒，耳朵痛得像是要裂开一样！。\n" NOR;
        }
}

