string check_me();

mapping quests = ([
	"name"	: ({"檀香木","水晶枕","珍珠玉","金龙指","枯叶笔","虎纹石"}),
	"id"	: ({"tan xiang","shui jing","zhen zhu","jin long","ku ye","hu wen",}),
]);	

void create()
{
mapping name = NAME_D->random_name("male");
set_name(name["name"],name["id"]);
set("gender","男性");
set("age",random(100)+16);
set("env/wimpy",random(100));
set("inquiry",([
	"美酒"	: (: check_me :) ,
	"酒"	: (: check_me :) ,	
]));
setup();
carry_object("/obj/loginload/linen")->wear();
carry_object("/d/shaolin/obj/jiuhulu");	
}

void init()
{
object me = this_player();
if ( me->query("family/family_name")!="少林寺" )
	return;
if ( me->query_temp("meet_drink") )
	return;
message_vision("$N朝$n打了个诺。\n",this_object(),me);
me->set_temp("meet_drink",1);
if ( me->query("human/class")!="human" )
	return;
message("vision",name()+"神神秘秘在"+me->name()+"耳边低语了几句。\n",environment(),me);
tell_object(me,name()+"在你耳边道：嘿嘿，这位师傅不知知不知道"YEL"美酒"NOR"的妙处。\n");
return;
}

string check_me()
{
int i;	
object ob;	
string *dirs;	
mapping quest;	
object me = this_player();
if ( me->query("family/family_name")!="少林寺" 	
  || me->query("human/class")!="human" )
	return "我认识你吗？";
	
if ( me->query_temp("ask_drinker") )
	{
	if ( mapp(quest=query("obj")) )	
		{
		tell_object(me,name()+"在你耳边道：寻得"+quest["name"]+"("+capitalize(quest["id"])+")，自然告诉你。\n");
		return "放心，此事你知，我知，天知，地知，师傅们是不知的。";
		}
	else	{
		me->delete_temp("ask_drinker");
		return check_me();
		}
	return "放心，此事你知，我知，天知，地知，师傅们是不知的。";
	}	  
me->set_temp("ask_drinker",1);

if ( mapp(quest=query("obj")) )	
	{
	tell_object(me,name()+"在你耳边道：寻得"+quest["name"]+"("+capitalize(quest["id"])+")，自然告诉你。\n");
	return "放心，此事你知，我知，天知，地知，师傅们是不知的。";
	}
	
dirs = dirs1;
if ( random(2) )
	dirs+= dirs2;
ob = new("/d/炼妖壶/obj/item");
i = random(6);
ob->set_name(quests["name"][i],({quests["id"][i]}) );
ob->set_weight(1000);
ob->set("long",name()+"掉落的"+ob->name());
ob->set("value",random(10000));
ob->set("unit","个");
ob->set("base_unit","个");
ob->set_amount(1);
if ( "/d/dntg/yunlou/npc/yaoguai"->random_place(ob,dirs) ) 
	{
	tell_object(me,name()+"在你耳边说道：昔日在"+MISC_D->find_place(environment(ob))+"掉落了一个"+quests["name"][i]+"。
如果你能帮我找到，我是不会亏待你的。\n");
	set("obj",([
		"name" : quests["name"][i],
		"id"   : quests["id"][i],
	]));		
	}
return "放心，此事你知，我知，天知，地知，师傅们是不知的。";
}	

int accept_object(object me,object ob)
{
int i;	
object obj,money=new("/obj/money/gold");	
mapping quest;	
if ( !mapp(query("obj")) )
	return 0;
quest=query("obj");
if ( ob->query("id")!=quest["id"]
  || ob->query("name")!=quest["name"] )
  	return 0;
if ( me->query("family/family_name")!="少林寺" 	
  || me->query("human/class")!="human" )
	{
	command("say 阁下好似不是寺内之人。\n");
	return 0;
	}	  	
command("wow");
message_vision("$N道：这正是在下遗失之物，多谢多谢。\n",this_object());
tell_object(me,name()+"在你耳边说道：前日我在酒席间偷拿个酒葫芦，给你尝尝新。\n");
obj = new("/d/shaolin/obj/jiuhulu");
if ( obj->move(me) )
	tell_object(me,name()+"偷偷递给你一个硕大的葫芦。\n");  	
if ( random(2) && me->query("balance")<100000 )
	{
	i = random(100);
	money->set_amount(i);
	money->move(me);
	message_vision("$N递给$n"+chinese_number(i)+"两黄金。\n",this_object(),me);
	}
delete("obj");
me->delete_temp("ask_drinker");
return 1;
}
