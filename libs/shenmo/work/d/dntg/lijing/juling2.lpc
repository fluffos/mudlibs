
inherit "/d/dntg/lijing/troops.lpc";
 
void create()
{
 
        set_name("巨灵神", ({ "juling shen", "shen", "juling" }) );
        set("gender", "男性" );
        set("long","托塔李天王帐下先锋大将，膀阔腰圆，力大无穷。\n");
        set("age",40);
        set("title", "先锋大将");
        set("info_rank/rude","毛神");
        set("str", 400);
        set("int", 20);
        set("con", 30);
        set("spi", 20);
        set("per", 15);
        set("class", "human");
        set("任务", 2);
        set("level", 500);
        set("attitude", "heroism");
        set("combat_exp", 100000000);
        set("daoxing", 100000000);

        set("max_kee", 75000);
        set("max_sen", 75000);
        set("force",9000);
        set("max_force",4000);
        set("force_factor", 500);
        set("mana", 9000);
        set("max_mana", 5000);
        set("mana_factor", 500);

        set_skill("unarmed",500);
        set_skill("dodge",500);
        set_skill("parry",500);
        set_skill("axe", 500);
        set_skill("force", 500);
        set_skill("spells", 500);
        set_skill("changquan", 500);
        set_skill("sanban-axe", 500);
        set_skill("baguazhou", 500);
        set_skill("moshenbu", 500);
        set_skill("lengquan-force", 500);
        map_skill("unarmed", "changquan");
        map_skill("force", "lengquan-force");
        map_skill("spells", "baguazhou");
        map_skill("axe", "sanban-axe");
        map_skill("parry", "sanban-axe");
        map_skill("dodge", "moshenbu");
        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
                (: perform_action, "axe", "sanban" :),
                (: perform_action, "axe", "san" :),
        }) );
        create_family("将军府", 2, "弟子"); 
        setup();
        carry_object("/d/obj/armor/tongjia")->wear();
        carry_object("/d/obj/weapon/axe/huafu")->wield();
}
