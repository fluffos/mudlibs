#include <ansi.h>

inherit "/d/dntg/lijing/troops.lpc";

int do_jifabao();

void create() {
  set_name("哪吒", ({ "nezha santaizi", "nezha", "santaizi" }));
  set("title", "三坛海会之神");
  create_family("陷空山无底洞", 1, "弟子");
  set("class", "yao");
  set("任务", 2);
  set("level", 800);
  set("long", "一位唇红齿白的美少年。\n");
  set("gender", "男性");
  set("age", 16);
  set("attitude", "friendly");
  set("rank_info/respect", "小太子");
  set("rank_info/rude", "乳臭未干的小儿");
  set("per", 40);
  set("str", 30);
  set("cor", 40);
  set("con", 40);
  set("int", 40);
  set("spi", 40);
  set("cps", 40);
  set("kar", 40);
  set("max_kee", 100000);
  set("max_sen", 100000);
  set("force", 15000);
  set("max_force", 4000);
  set("force_factor", 800);
  set("max_mana", 3000);
  set("mana", 15000);
  set("mana_factor", 600);
  set("combat_exp", 300000000);
  set("daoxing", 300000000);

  set_skill("spells", 800);
  set_skill("dao", 800);
  set_skill("unarmed", 800);
  set_skill("yinfeng-zhua", 800);
  set_skill("dodge", 800);
  set_skill("lingfu-steps", 800);
  set_skill("parry", 800);
  set_skill("force", 800);
  set_skill("huntian-qigong", 800);
  set_skill("spear", 800);
  set_skill("huoyun-qiang", 800);
  set_skill("blade", 600);
  set_skill("sword", 600);
  set_skill("qixiu-jian", 600);
  map_skill("spells", "dao");
  map_skill("unarmed", "yinfeng-zhua");
  map_skill("spear", "huoyun-qiang");
  map_skill("parry", "huoyun-qiang");
  map_skill("sword", "qixiu-jian");
  map_skill("dodge", "lingfu-steps");
  map_skill("force", "huntian-qigong");
  set("inquiry", ([
    "name": "我乃托塔天王三太子李哪吒是也。",
    "rumors": "玉帝敕封家严为降魔大元帅，在下为三坛海会之神，专管降妖除魔。",
    "风火轮": "送人了！",
  ]));
  setup();

  carry_object("/d/obj/cloth/taijicloth")->wear();
  carry_object("/d/obj/armor/jinjia")->wear();
  carry_object(__DIR__ "obj/huojianqiang")->wield();

  if ("/d/obj/fabao/huntian-ling"->in_mud())
    carry_object("/d/obj/fabao/huntian-fake");
  else
    carry_object("/d/obj/fabao/huntian-ling");
  if ("/d/obj/fabao/qiankun-quan"->in_mud())
    carry_object("/d/obj/fabao/qiankun-fake");
  else
    carry_object("/d/obj/fabao/qiankun-quan");

  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: do_jifabao :),
    (: perform_action, "unarmed", "duzun" :),
  }));

}

int do_jifabao() {
  object me = this_object();
  object target = query("master")->target();
  object fabao;

  //  message_vision("ji fabao on..\n",me);
  if (target) {
    //  message_vision(target->name()+"\n",me);
    if (random(2)) fabao = present("qiankun quan", me);
    else fabao = present("huntian ling", me);
    if (fabao) {
      //  message_vision(fabao->query("name")+"\n",me);
      fabao->ji_ob(target);
    }
  }
  return 1;
}
