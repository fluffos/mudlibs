  set("combat_exp", 50000000);
  set("daoxing", 50000000);

  set("max_kee", 50000);
  set("max_sen", 50000);
  set("force", 6000);
  set("max_force", 4000);
  set("force_factor", 300);
  set("mana", 6000);
  set("max_mana", 5000);
  set("mana_factor", 300);

  set_skill("unarmed", 300);
