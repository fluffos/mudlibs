#include <ansi.h>
inherit NPC;
#include <obstacle.h>
string *list = ({ "yg-sanjie", "yg-putuo", "yg-moon", "yg-wzg", "yg-shushan", "yg-hyd",
  "yg-fangcun", "yg-hell", "yg-jjf", "yg-pansi", "yg-jjf1",
  "yg-dragon", "yg-xueshan",
  "yg-wudidong", "yg-youxia", "yg-emei", "yg-shaolin", "yg-kunlun",
});

int work_me();
int cancel_me();
int delete_ask(object me);

void create() {

  set_name("李靖", ({ "li jing", "jing", "li" }));
  set("gender", "男性");
  set("long", "托塔李天王乃是天界元帅，麾下十万天兵天将，法力无边。\n");
  set("age", 40);
  set("title", "托塔天王");
  set("str", 40);
  set("int", 30);
  set("con", 30);
  set("spi", 30);
  set("per", 30);
  set("class", "xian");
  set("attitude", "heroism");
  set("combat_exp", 1500000);
  set("daoxing", 2000000);
  set("max_kee", 2000);
  set("max_sen", 2000);
  set("force", 5000);
  set("max_force", 3000);
  set("force_factor", 150);
  set("mana", 5000);
  set("max_mana", 3000);
  set("mana_factor", 150);

  set("eff_dx", 600000);
  set("nkgain", 600);

  set_skill("unarmed", 170);
  set_skill("dodge", 170);
  set_skill("parry", 170);
  set_skill("sword", 180);
  set_skill("force", 170);
  set_skill("spells", 170);
  set_skill("changquan", 170);
  set_skill("liangyi-sword", 180);
  set_skill("baguazhou", 170);
  set_skill("moshenbu", 170);
  set_skill("lengquan-force", 170);
  map_skill("unarmed", "changquan");
  map_skill("force", "lengquan-force");
  map_skill("spells", "baguazhou");
  map_skill("sword", "liangyi-sword");
  map_skill("parry", "liangyi-sword");
  map_skill("dodge", "moshenbu");

  set("chat_chance", 1);
  set("chat_msg", ({
    name() + "说道：哪位大仙可愿去下界灭妖？\n",
  }));

  seteuid(getuid());

  set("inquiry", ([
    "mieyao": (: work_me :),
    "kill": (: work_me :),
    "灭妖": (: work_me :),
    "放弃": (: cancel_me :),
    "fangqi": (: cancel_me :),
    "cancel": (: cancel_me :),
  ]));

  setup();
  carry_object("/d/obj/fabao/huangjin-baota");
  carry_object("/d/obj/armor/jinjia")->wear();
  carry_object("/d/sky/obj/zhanyaojian")->wield();
}
//this funtion is modified by vikee 2000-11-20 1:32
int cancel_me() {
  object ghost, me = this_player();
  //this modi by cnd delete here if for bug
  if (!me->query("mieyao/time_start") ||
    me->query("mieyao/time_start") + 900 < time() ||
    me->query("mieyao/time_start") > time() ||
    me->query("mieyao/done") ||
    !me->query_temp("mieyao/ob"))

  {
    tell_object(me, CYN "李靖磨了磨牙。\n" NOR);
    tell_object(me, CYN "李靖说道：你没有在杀妖，来凑什么热闹！\n" NOR);
    return 1;
  }
  ghost = me->query_temp("mieyao/ob");
  if (!living(ghost)) {
    tell_object(me, CYN "李靖说道：" + ghost->query("name") + "这个畜生已经跑了!\n" NOR);
    return 1;
  }
  me->delete_temp("mieyao/ob");
  // 删除灭妖资料
  me->delete_temp("mieyao/name");
  me->delete_temp("mieyao/time_start");
  //如果放弃这个怪物,当前的level从第一个开始.
  me->set_temp("mieyao/level", 1);
  tell_object(me, CYN "李靖唱道：涼風有信,秋月無邊,亏我思娇的情緒好比度日如年,虽則我唔係玉樹臨風,风流倜傥,但我有廣闊的胸襟和強勁的臂彎.\n" NOR);
  tell_object(me, CYN "李靖说道：你既然无力收服" + ghost->query("name") + ", 只好任它去了。\n" NOR);
  me->set("mieyao/done", 1);

  destruct(ghost);
  return 1;
}

int work_me() {
  object ghost, me;
  int t, lvl;
  int size1 = sizeof(obstacles);
  me = this_player();
  if (me->query("obstacle/number") >= size1) {
    tell_object(me, "李靖说" +
      "：这位" + RANK_D->query_respect(me)
      + "已取得真经，得成正果,请到我佛如来处帮助降魔除妖。\n",
    );
    return 1;
  }
  if (me->query("combat_exp") >= 10000000) {
    tell_object(me, "李靖说" + "：这位" + RANK_D->query_respect(me)
      + "你现在已经武功盖世了,请到我佛如来处帮助降魔除妖吧。\n");
    return 1;
  }
  //for first time.
  if (!me->query("mieyao")) {
    call_out("start_job", 1, me);
    return 1;
  }
  if ((t = (int)me->query("mieyao/time_start")) &&
    !me->query("mieyao/done")) {

    if (t <= time() &&
      time() < t + 900) {
      tell_object(me, CYN "李靖哼了一声。\n" NOR);
      tell_object(me, CYN "李靖说道：老夫不是派你去降服" + me->query("mieyao/name") + "吗？\n" NOR);
      return 1;
    }
    // here is modified by vikee for the #9 ask li about kill 's bug
    // or the #8 {u;ask li about kill;d}'s bug,
    // set a flag "mieyao/level_change" to judge the monster level.

    if (!me->query_temp("mieyao/level_changed")) {
      lvl = me->query_temp("mieyao/level");
      if (lvl > 0) lvl--;
      me->set_temp("mieyao/level", lvl);
      me->set_temp("mieyao/level_changed", 1);
    }
    // allow ask again.
  } else {  // job done
    if (t <= time() && time() < t + 50) {
      tell_object(me, "李靖对手中照妖镜一看，说" +
        "：这位" + RANK_D->query_respect(me)
        + ",妖魔已除尽,不妨先去歇息。\n",
      );
      return 1;
    }
    // succeed, increase lvl.
    if (!me->query_temp("mieyao/level_changed")) {
      lvl = me->query_temp("mieyao/level");
      if (lvl < 9) lvl++;  // total 10 levels: 0, ..., 9
      else
        lvl = 1;  // reach the top level, reduce difficulty.
        me->set_temp("mieyao/level", lvl);
      me->set_temp("mieyao/level_changed", 1);
    }
  }
  me->delete("mieyao/time_start");
  call_out("start_job", 1, me);
  return 1;
}
int start_job(object me) {
  string where;
  object ghost;
  int lvl;

  if (!me || !present(me, environment())) return 0;
  if (environment(me) != environment() && !wizardp(me)) return 1;
  if (me->query("mieyao/time_start")) return 1;
  me->delete("mieyao/done");
  me->set_temp("mieyao/level_changed", 0);

  // determine levels.
  // use temp mark, if quit, then start over.
  lvl = me->query_temp("mieyao/level");

  ghost = new(__DIR__ + list[random(sizeof(list))]);
  where = ghost->invocation(me, lvl);
  tell_object(me, "妖怪等级：" + lvl + "\n" NOR,);
  tell_object(me, "李靖将手中照妖镜朝下界一晃！\n");
  tell_object(me, "李靖对你说道：近有" + where + "为非作歹，"
    + "请速去降服！\n"
    ,);
  me->set("mieyao/where", where);
  me->add("mieyao/number", 1);
  me->set("mieyao/id", ghost->query("id"));

  me->set("mieyao/time_start", time());
  me->set("mieyao/name", ghost->query("name"));
  me->set_temp("mieyao/ob", ghost);
  return 1;
}

int delete_ask(object me) {
  me->delete_temp("asked/lijing");
  return 1;
}
