
#include <ansi.h>
inherit NPC;
void create()
{
        set_name("魔礼海", ({ "tian wang", "duowen tianwang", "hai", "tianwang" }) );
        set("gender", "男性" );
        set("long",
                "魔家四将之一，使一根盘龙棍，背上一面琵琶，上有四条弦；也按\n"
                "地、水、火、风，拨动弦声，风火齐至，如青云剑一般。\n"
        );
        set("class","xian");
        set("任务", 2);
        set("age",50);
        set("level",1500);
        set("title", "多闻天王");
        set("attitude", "friendly");
        set("sszj", "魔礼寿");
        set("jiebai", "tian wang");
        set("str",40);
        set("int",30);
        set("max_kee",150000);
        set("kee",150000);
        set("max_sen",150000);
        set("sen",150000);
        set("combat_exp",800000000);
        set("daoxing",800000000);
        set("force",40000);
        set("max_force",1500);
        set("mana",40000);
        set("max_mana",1600);
        set("force_factor", 1000);
        set("mana_factor",1000);

        set("eff_dx", 200000000);
        set("nkgain", 800);
        
        set_skill("unarmed",1500);
        set_skill("jinghun-zhang", 1500);
        set_skill("parry",1500);
        set_skill("dodge",1500);
        set_skill("stick",1500);
        set_skill("kusang-bang",1500);
        set_skill("force",1500);
        set_skill("spells", 1500);
        set_skill("moshenbu", 1500);
        map_skill("dodge", "moshenbu");
        map_skill("parry", "kusang-bang");
        map_skill("stick", "kusang-bang");
        map_skill("unarmed", "jinghun-zhang");
        set("inquiry", ([
                "name" : "在下多闻天王魔礼海，奉圣谕把守西天门。",
                "here" : "这里就是西天门, 入内就是天界了。",
        ]) );

        set("chat_chance_combat", 90); 
        set("chat_msg_combat", ({ 
                      (: perform_action, "stick", "suoming" :), 
                      (: perform_action, "stick", "three" :), 
                      (: perform_action, "unarmed", "zhua" :), 
        }) ); 
        create_family("阎罗地府", 2, "弟子"); 
        setup();
        carry_object("/d/sea/obj/dragonstick")->wield();
        carry_object("/d/obj/armor/jinjia")->wear();
}


void kill_ob (object ob)
{
  object me = this_object();

  call_out ("pipa",5+random(5),me,ob);  
  ::kill_ob(ob);
}


void pipa (object me, object ob)
{
  object huobing;
  int damage;

  if (! me)
    return;

  if( !living(me) )
    return;

  if (! ob)
    return;

  if (environment(ob) != environment(me))
    return;

  message_vision (HIY"$N掏出碧玉琵琶，竟在战场上悠然自得的弹了起来！\n"NOR,me);

  if ( (ob->query("mana")+random(40000)) > 60000 )
     message_vision (HIY"$N充耳不闻，不为所动。\n"NOR,ob);
  else 
    {
     message_vision (HIY"$N就象着了魔一样，顿感头昏脑涨！\n"NOR,ob);
     damage=(me->query("mana"))/5; 
     if ( !living(ob) )
             {
             ob->delete_temp("last_damage_from");
             ob->set_temp("death_msg", "被碧玉琵琶震死了。\n"); 
             ob->die();
             ob->set("KILLER", "tian wang");
             ob->set("KILLERNAME", "魔礼海");
             ob->save();
             }
     else if ( ob->query("sen") < damage || !random(11)) ob->unconcious();
     else ob->add("sen",-damage);
    } 

  remove_call_out ("pipa");  
  call_out ("pipa",random(15)+15,me,ob);  
}


void die ()
{
  object me = this_object();
  message_vision (HIY"$N吓得撒腿就跑。\n"NOR,me);
  destruct (this_object());
  return ;
}

