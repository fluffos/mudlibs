
#include <ansi.h>
inherit NPC;
void create()
{
        object ob;

        set_name("魔礼青", ({ "tian wang", "zengzhang tianwang", "qing", "tianwang" }) );
        set("gender", "男性" );
        set("long",
                "增长天王为四大天王之首, 身高二丈四尺, 善用一杆长枪, \n"
                "枪法登峰造极, 更有密传「青云宝剑」, 「地，水，火，风」\n"
                "四式一出, 大罗金仙也难逃。\n"
        );
        set("class", "yao");
        set("任务", 2);
        set("age",50);
        set("level",1500);
        set("title", "增长天王");
        set("attitude", "friendly");
        set("sszj", "魔礼红");
        set("jiebai", "tian wang");
        set("str",40);
        set("int",30);
        set("max_kee",150000);
        set("kee",150000);

        set("max_sen",150000);
        set("sen",150000);
        set("combat_exp",800000000);
        set("daoxing",800000000);
        set("force",40000);
        set("max_force",1500);
        set("mana",40000);
        set("max_mana",1600);
        set("force_factor", 1000);
        set("mana_factor",1000);
        

        set("eff_dx", 200000000);
        set("nkgain", 800);


        set_skill("unarmed",1500);
        set_skill("cuixin-zhang", 1500);
        set_skill("yingzhaogong", 1500);
        set_skill("parry",1500);
        set_skill("dodge",1500);
        set_skill("sword",1500);
        set_skill("throwing",1500);
        set_skill("ningxie-force",1500);
        set_skill("bainiao-jian",1500);
        set_skill("force",1500);
        set_skill("spells", 1500);
        set_skill("xiaoyaoyou", 1500);
        set_skill("dengxian-dafa", 1500);
        map_skill("dodge", "xiaoyaoyou");
        map_skill("force", "ningxie-force");
        map_skill("parry", "bainiao-jian");
        map_skill("sword","bainiao-jian");
        map_skill("unarmed", "cuixin-zhang");

        set_temp("lightshield", 1);
        set_temp("ironshirt", 1);

        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
                (: perform_action, "sword", "chaofeng" :),
                (: perform_action, "unarmed", "yinyang" :),
        }) );
        create_family("大雪山", 2, "弟子"); 

        setup();

        ob=carry_object("/d/obj/weapon/sword/qingfeng");
        ob->wield();
        ob->set_name("青云宝剑", ({ "sword", "bao jian" }) );
        ob->set("no_break", 1);

        carry_object("/d/obj/armor/jinjia")->wear();
}




void die ()
{
  object me = this_object();
  message_vision (HIY"$N吓得撒腿就跑。\n"NOR,me);
  destruct (this_object());
  return ;
}

