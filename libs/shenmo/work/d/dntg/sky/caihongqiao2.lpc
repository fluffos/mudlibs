int valid_leave(object me,string dir) 
{ 
     object where = this_object();  
    if (dir=="up") {
       if( !me->query("weapon/make")) 
       return notify_fail("你没有自造武器，去哪儿瞎掺和什么？\n");
       if( where->query("wait") > 0 ) 
            return notify_fail("你还是等"+to_chinese(where->query("wait"))+"秒后再来吧!!!\n"); 
       else
             {
               where->set("wait",1800);   
               call_out("check_time",1,where);   
               }
      } 
     return ::valid_leave(me,dir); 
}

void check_time(object ob)
{
remove_call_out("check_time");

if ( ob->query("wait")<=0 )
        {
        ob->delete("going");
        ob->delete("killed");
        return;
        }
ob->add("wait",-1);
ob->save();
call_out("check_time",1,ob);
}

