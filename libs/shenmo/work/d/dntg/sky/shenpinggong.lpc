//sgzl

#include <room.h>
inherit ROOM;

void create()
{
set("short", "坤平宫");
set("long", @LONG
    
LONG );


set("exits", ([
  "south"   : __DIR__"taiyanggong",
  "north"   : __DIR__"qianyuangong",
]));


set("objects", ([
]));



setup();
}

int valid_leave(object me,string dir) 
{ 
        object room=environment(me)->query("exits/north");

        if (dir=="south") 
          return ::valid_leave(me,dir); 

        if (me->query_temp("xwm_asked")) 
            room->set("exits/north","/d/tghj/lingxiao2");

        else 
            room->set("exits/north","/d/dntg/sky/lingxiao");

        return ::valid_leave(me,dir); 
        
      } 
