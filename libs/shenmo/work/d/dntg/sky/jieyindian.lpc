#include <room.h>
#include <ansi.h>
inherit ROOM;

void init();
void close_gate();
int do_knock(string);
int valid_leave();
string look_gate();

int do_shen();
void create() {
  set("short", "接引殿");
  set("long", @LONG

进了南天门，已经可以看到一座座天宫放着七彩霞光，忽隐忽现
于云遮雾绕之中。里壁厢有几根大柱，柱上缠绕着金鳞耀日赤须
龙；一座白玉桥弯弯曲曲地向北延伸，东西两边各有一座大殿，
也不知是干什么用的，你可以隐约听到东边殿中有喧哗之声，似
乎人不少。

LONG);

  set("exits", ([ /* sizeof() == 3 */
    "south": __DIR__ "nantian",
    "north": __DIR__ "caihongqiao",
    "west": __DIR__ "caifengdian",
    "east": __DIR__ "jinlongdian",
  ]));

  create_door("south", "南天门", "north", DOOR_CLOSED);
  set("no_clean_up", 0);

  setup();
}
void init() {
  if (!this_player()->query_temp("zhenshens_knowed")) {
    tell_object(
      this_player(),
      BLINK + HIY "\n等级到达一定程度可以用zhenshens命令来得到或卸除项链，具体命令请参照 help zhenshens。\n" NOR
    );
    this_player()->set_temp("zhenshens_knowed", 1);
  }
  add_action("do_drop", "drop");
  add_action("do_shen", "shen");
}

int do_shen() {
  object me;
  string s;
  int my_exp, my_level, temp, price, price2, pricegold, afford;

  me = this_player();
  my_exp = me->query("combat_exp");
  my_level = me->query("level");
  /*
         if( mapp(me->query("expell_menpai")) )
         {
                tell_object(me,"你已经出师了,不能再shen了！\n");
                return 1;
         }
*/
  if (my_level > 100 && my_exp > 10000000) {
    temp = (my_level + 1) * (my_level + 1) * 400;
  } else {
    temp = (my_level + 1) * (my_level + 1) * 1000;
  }
  if (my_exp < 1000000 || me->query("daoxing") < 1000000) {
    tell_object(me, "你的武学和道行不够100万，暂时不能升级！\n"); return 1;
  }
  if (my_exp - me->query("daoxing") > 100000000) {
    tell_object(me, "你的道行不够，暂时不能升级！\n"); return 1;
  }
  if (my_exp >= temp && (me->query("daoxing") >= temp || my_level < 101)) {
    pricegold = 50000 * (my_level + 1);
    if (my_level >= 100) {
      price = 20000 * (my_level + 2);
      if ((int)me->query("spsk") == 2)
        pricegold = 10000 * (my_level + 2);
      else
        pricegold = 20000 * (my_level + 2);
      //为了任务降为原来的1/2
      price2 = (my_level + 1) * 1000;
    } else {
      price = pricegold;
      price2 = 0;
    }

    if (me->query("c_balance") >= price) {
      me->add("c_balance", -pricegold);
      if (me->query("daoxing") - price > 500000 && my_level > 100)
        me->add("daoxing", -price2);
      me->add("combat_exp", -price2);
      temp = me->query("scorepoint") + (my_level / 10 + 100) * 100;
      me->set("level", my_level + 1);
      me->set("scorepoint", temp);
      me->set("kee", me->query("max_kee"));
      me->set("mana", me->query("max_mana"));
      me->set("last_combat_exp", me->query("combat_exp"));
      me->set_temp("login_time", time());
      message_vision("$N闭目静静的想着什么，突然人显得神采奕奕起来！\n", me);
      printf(HIW "你的级别得到了提升.\n" NOR);
    } else {
      printf(HIW "你没有足够的钱为三界捐助，升级到" HIY "%d" HIW "级的捐助费为" HIM "%d" HIW "金！\n " NOR,
        my_level + 1, pricegold / 10000);
    }
  } else
    printf(
      HIW "你的武学道行不够升级成" HIY "%d" HIW "级，需要你的武学达到" HIM "%d" HIW ",道行达到" HIM "%s" HIW "才行！\n" NOR,
      my_level + 1,
      temp,
      COMBAT_D->chinese_daoxing(temp)
    );
  return 1;
}


int do_drop() {
  object me;
  me = this_player();
  tell_object(me, "鬼鬼祟祟的想干什么!\n");
  return 1;
}
