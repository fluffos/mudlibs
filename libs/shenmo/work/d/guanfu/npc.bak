inherit NPC;
#include <ansi.h> 
#include "/u/fly/job/guanfu/place2.h"
string query_family_type(string fam);
void copy_status(object me,object ob,int lv);
int my_randommove();

void init()
{
        object ob, me;
        mapping dizhis;
        int exp, nei, nei1;

        ::init();
        ob = this_player();
        me = this_object();
        nei = me->query("force",1);
        nei1 = ob->query("force",1);      
        dizhis = dizhia[random(sizeof(dizhia))];
        exp = me->query("combat_exp");
        set("chat_chance", 10);
        set("chat_msg", ({
           (: random_move :)
        }) );
        
 if (interactive(ob)
                 //  如果 ob 是一个可互动的玩家, 就传回非零值.
    && me->query("id2") == ob->query("id")
    && !environment(ob)->query("no_fight")
    && present("wenshu", ob)
    && (string)me->query("name") == ob->query_temp("guanfu_target")) {
                if (ob->query_temp("mark/gkill1")){
                                me->set("title", me->query("title2")+HIB" 由"+ob->name()+"缉拿中的 "NOR);
                                me->set_name(me->query("name"),({ob->query("id")+"'s  pan tu","pantu","pan tu"}));
                                message_vision(RED"\n$n看到$N目光冷冷注视着自己一动不动，不由停下了脚步。\n"NOR, ob, me);
                                copy_status(me,ob,1);
                         switch(random(4)) {
                         case 0:
                                message_vision(YEL"$n嘿嘿奸笑几声，连忙赔笑道，这位"NOR+RANK_D->query_respect(ob)+YEL"是官府的捕头吗？\n"NOR,ob,me);
                                message_vision(YEL"$n接着道:大家都是妖神中人，今天能否高抬贵手？我必有重谢！你是否愿意？\n"NOR,ob,me);
                                write (HBYEL"你可以选择同意(yes)或者拒绝(no)。\n"NOR);
                                ob->set_temp("guanf_huida1", me->query("name"));
                        break;
                case 1:
                        message_vision(HIW"$n阴笑一声说道，这麽多不怕死的？再来十个大爷我也不怕！\n"NOR,ob,me);
                        message_vision(HIR"$n随即眼睛一瞪，向着$N就冲了过去！\n"NOR,ob,me);
                        me->set_leader(ob);
                        remove_call_out("kill_ob");
                        call_out("kill_ob", 1, ob);
                        ob->delete_temp("mark/gkill1");
                        break;
                case 2:
                        message_vision(HIW"$n待$N走到近前，冷冷一笑，说道，你千里追到这里，我看你又能奈我何！\n"NOR,ob,me);
                        write (WHT"你感到一股无形的杀气，心中不由一颤。\n"NOR);
                        ob->delete_temp("mark/gkill1");
                        break;
                case 3:
                        message_vision(HIG"$n忽然泪流满面，可怜地对$N说道，小人上有老下有小，完全是官府陷害才落此地步。\n"NOR,ob,me);    
                        message_vision(CYN"$n接着道:望你老明察秋毫，网开一面，我今生一定感激不禁。\n"NOR,ob,me);    
                        ob->delete_temp("mark/gkill1");
                }
                copy_status(me,ob,1);
                }
              if (ob->query_temp("mark/gkill1")
                 && (string)me->query("name") == ob->query_temp("guanfu_huida1")){
                message_vision(HIR"$n看到$N走到近前，狠狠的骂道，不识抬举的东西，我好言相劝没用。\n"NOR,ob,me);
                message_vision(HIR"$N,今天就让你尝尝大爷我$n的厉害。\n"NOR,ob,me);
                me->set_leader(ob);
                remove_call_out("kill_ob");
                call_out("kill_ob", 1, ob);
                ob->delete_temp("guanf_huida1");
                ob->delete_temp("mark/gkill1");
                me->add("combat_exp",exp/10);
                me->add("force",500);
                me->add("mana",500);
               }
             if (ob->query_temp("mark/gkill2")){
             switch(random(2)) {
                case 0:
                        message_vision(HIR"\n$n额头青筋跳动，冷哼了一声，瞪着通红的眼睛向着$N就冲了过去。\n"NOR,ob,me);
                        me->set_leader(ob);
                        remove_call_out("kill_ob");
                        call_out("kill_ob", 1, ob);
                        break;
                case 1:
                        message_vision(HIY"\n$n一看到$N，嘿嘿一笑，头也不回挤进行人之中，脚下抹油溜了。\n"NOR,ob,me); 
                        ob->delete_temp("mark/gkill2");
                        ob->set_temp("mark/gkill3",1); 
                        ob->set_temp("ch_weizhi", dizhis["cdizhi"]);
                        write(WHT"你根据多年的经验判断，「"NOR+ob->query_temp("guanfu_target")+WHT"」好象往「"NOR+FLA+HIR+dizhis["cdizhi"]+NOR+WHT"」的方向逃去。\n"NOR);
                        me->move(dizhis["weizhi2"]);
                        return; 
                   } 
                                me->set("title", me->query("title2")+HIB" 由"+ob->name()+"二次缉拿中的 "NOR);
                                me->set_name(me->query("name"),({ob->query("id")+"'s  pan tu","pantu","pan tu"}));
                                copy_status(me,ob,2);  
                   }
        if (ob->query_temp("mark/gkill3")){
                                me->set("title", me->query("title2")+HIB" 由"+ob->name()+"三次缉拿中的 "NOR);
                                me->set_name(me->query("name"),({ob->query("id")+"'s  pan tu","pantu","pan tu"}));
                                copy_status(me,ob,2);
                message_vision(HIR"\n$n气急败坏的对$N嚷道，杀人不过头点地，你一再苦苦向逼，大爷今天就和你拼个鱼死亡破。\n"NOR,ob,me);
                if(nei<nei1&&
                (!me->query_temp("gf_nlset"))){
                me->set("neili",nei1);
                me->set_temp("gf_nlset",1);
                }
                me->set_leader(ob);
                remove_call_out("kill_ob");
                call_out("kill_ob", 1, ob);
                copy_status(me,ob,2);
                me->add("mana",ob->query("max_mana")/5);
                me->add("force",ob->query("max_force")/4);
                me->add("combat_exp",ob->query("combat_exp")/10);
        }
        }
	remove_call_out("dest");
        call_out("dest",900);
        add_action("do_yes","yes");
//        add_action("do_kill","kill");
        add_action("do_no","no");
} 

int do_yes()
{
        object r_shen, me, ob;
        me = this_object();
        ob = this_player();

        if (!ob->query_temp("guanf_huida1"))
        return 0;
        if (ob->query_temp("guanf_huida1") != (string)me->query("name"))
        return 0;
        if (query_family_type(ob->query("family/family_name"))=="yao"
        && ob->query("combat_exp",1) < 180000){
        command("say 这位"+RANK_D->query_respect(ob)+"一定前途远大，嘿嘿，我是不会亏待你的。\n");
        me->add_money("gold",20+random(20));
        command("give "+ob->query("id")+" gold");
        message_vision("$N嘿嘿一笑，转身离开，一眨眼就消失不见了。\n",me);
        destruct(me);
        return 1;
        }
        if (  query_family_type(ob->query("family/family_name"))=="xian"
        && ob->query("combat_exp",1) > 180000
        && ob->query("combat_exp",1) < 500000){
        command("say 我早就看出这位"+RANK_D->query_respect(ob)+"是当世的俊杰，嘿嘿，这点小礼物请务必收下。\n");
        message_vision("$N嘿嘿奸笑两声，悄悄塞给了$n一棵人参。\n",me,ob);
        r_shen=new("/u/fly/job/guanfu/renshen");
        r_shen->move(ob);
        command("give "+ob->query("id")+" renshen");
        message_vision("$N嘿嘿一笑，转身离开，一眨眼就消失不见了。\n",me);
        destruct(me);
        return 1;
        }
        if (query_family_type(ob->query("family/family_name"))=="yao"
        && ob->query("combat_exp",1) > 500000){
        command("say 您老人家功夫如此出众，小的实在想不出拿什麽孝敬您老，回头我想起在说吧。\n");
        message_vision("$N嘿嘿一笑，转身离开，一眨眼就消失不见了。\n",me);
                destruct(me);
        return 1;
        }
        if (query_family_type(ob->query("family/family_name"))=="xian"
        && ob->query("combat_exp",1) < 120000){
        command("say 这位"+RANK_D->query_respect(ob)+"前途远大，一身正气，嘿嘿，佩服。\n");
        me->add_money("gold",20+random(30));
        command("give "+ob->query("id")+" gold");
        message_vision("$N嘿嘿一笑，转身离开，一眨眼就消失不见了。\n",me);
        destruct(me);
        return 1;
        }
        if (query_family_type(ob->query("family/family_name"))=="xian"
        && ob->query("combat_exp",1) > 120000
        && ob->query("combat_exp",1) < 500000){
        command("say 这位"+RANK_D->query_respect(ob)+"真是义薄云天，这个小礼物敬请务必收下。\n");
        me->add_money("gold",30+random(30));
        command("give "+ob->query("id")+" gold");
        message_vision("$N嘿嘿奸笑两声，悄悄塞给了$n一棵人参。\n",me,ob);
        r_shen=new("/u/fly/job/guanfu/renshen");
        r_shen->move(ob);
        message_vision("\n$N嘿嘿一笑，转身离开，一眨眼就消失不见了。\n",me);
        destruct(me);
        return 1;
         }
        command("say 自古邪正势不两立，在下不过开个小小玩笑，千万不要当真啊。\n");
        command("laugh " + ob->query("id"));
        write("对方好象在拿你取笑，你不由怒火中烧。\n");
        tell_room(environment(me), me->query("name")+"纵身跳入行人之中，转眼就不见了。\n", ({me}));        
        destruct(me);
        return 1;
}
   

int do_no()
{
        object me, ob;
        me = this_object();
        ob = this_player();

        if (!ob->query_temp("guanf_huida1"))
        return 0;
        if (ob->query_temp("guanf_huida1") != (string)me->query("name"))
        return 0;
        if (query_family_type(ob->query("family/family_name"))=="yao"){
        command("say 这位"+RANK_D->query_respect(ob)+"一身瘴气，你我本是一路货色，却在这里装什么侠义英雄呢？！\n");
        ob->delete_temp("guanf_huida1");
        ob->delete_temp("mark/gkill1");
        return 1;
        }
        command("say 这位"+RANK_D->query_respect(ob)+"一身正气，不愧名门正派弟子，不过不知道功夫怎麽样？！\n");
        command("hehe " + ob->query("id"));
        ob->delete_temp("guanf_huida1");
        ob->delete_temp("mark/gkill1");
        return 1;
}

void die()
{
        object ob, me,ob2,killer;
        mapping dizhis;
        
        ob = this_object();
        me = query_temp("last_damage_from");
     if (!me) return;
        dizhis = dizhia[random(sizeof(dizhia))];  
        
        if (!me->query_temp("mark/gkill3")
        &&  !me->query_temp("mark/gkill2")
    && ob->query("id2") == me->query("id")
        && (string)ob->query("name") == me->query_temp("guanfu_target")){
        message_vision("\n$N深吸口气，冷笑道，好身手！说完强忍伤痛纵身向「"+dizhis["cdizhi"]+"」处逃走。\n",ob,me);
        me->set_temp("mark/gkill2",1);
        me->set_temp("ch_weizhi", dizhis["cdizhi"]);
        me->set_temp("gstart_rooms",dizhis["weizhi2"]);
        ob2=new(me->query_temp("path_rooms"));
        ob2->move(dizhis["weizhi2"]);
        ob2->set("name2",ob->query("name2"));
        ob2->set("id2",ob->query("id2"));
        if (wizardp(me))
          tell_object(me,FLA+WHT"gstart_rooms="+me->query_temp("gstart_rooms")+"  ch_weizhi="+me->query_temp("ch_weizhi")+"\n"NOR);
        ob2->copy_status(ob2,me,2);
        destruct(ob);
        return;
        }
        if (me->query_temp("mark/gkill2")
    && ob->query("id2") == me->query("id")
        && (string)ob->query("name") == me->query_temp("guanfu_target")){
        message_vision("\n$N冷笑一声，说道，好俊的功夫！说完纵身向「"+dizhis["cdizhi"]+"」处逃走。\n",ob,me);
        me->delete_temp("mark/gkill2");
        me->set_temp("mark/gkill3",1);
        me->set_temp("ch_weizhi", dizhis["cdizhi"]);
        me->set_temp("gstart_rooms",dizhis["weizhi2"]);
        ob2=new(me->query_temp("path_rooms"));
        ob2->move(dizhis["weizhi2"]);
        ob2->set("name2",ob->query("name2"));
        ob2->set("id2",ob->query("id2"));
        if (wizardp(me))
        tell_object(me,FLA+WHT"gstart_rooms="+me->query_temp("gstart_rooms")+"  ch_weizhi="+me->query_temp("ch_weizhi")+"\n"NOR);
        ob2->copy_status(ob2,me,2);
        destruct(ob);
        return;
        }
       if(objectp(killer = query_temp("last_damage_from")) 
      && present("wenshu", killer)
      && ob->query("id2") == killer->query("id")
      && (string)ob->query("name") == killer->query_temp("guanfu_target")) {
                if (killer->query("id")=="fly")tell_object(killer,FLA+HIR"\nLast_Damage\n"NOR);
                killer->set_temp("guanfu/last_damage",1);
          }
        ::die();
}
int accept_fight(object me)
{
        command("say 大爷我正要赶路，没心思和你动手。");
        return 0;
}

