#include "/u/fly/job/guanfu/npc.h"
string *name = ({
  "妖精",
  "狐仙",
});
void create() {
  int i;
  set_name("古墓叛徒", ({ "pantu", "pan tu" }));
  set("title", HIY + name[random(sizeof(name))] + NOR);
  set("age", 20 + random(80));
  set("name2", query("name"));
  set("title2", query("title"));
  set("id2", query("id"));

  set("no_drop", 1);
  set("no_get", 1);
  set("attitude", "heroism");
  set("chat_chance", 5);
  setup();
}
void set_skills(int j, int level) {
  object me = this_object();
  object weapon;
  int exp;

  set("family/family_name", "轩辕古墓");
  set("gender", "女性");
  me->set_skill("unarmed", j);
  me->set_skill("dodge", j);
  me->set_skill("parry", j);
  me->set_skill("force", j);
  me->set_skill("spells", j);
  me->set_skill("needle", j);

  me->set_skill("blade", j + random(5));
  me->set_skill("xuanhu-blade", j + random(5));
  me->set_skill("huxing-step", j + random(5));
  me->set_skill("xuanhu-shentong", j + random(5));
  me->set_skill("xuanhu-xinfa", j + random(5));
  me->set_skill("fox-hand", j + random(5));
  me->set_skill("tianyi-zhen", j + random(5));

  me->map_skill("force", "xuanhu-xinfa");
  me->map_skill("blade", "xuanhu-blade");
  me->map_skill("parry", "xuanhu-blade");
  me->map_skill("needle", "tianyi-zhen");
  me->map_skill("spells", "xuanhu-shentong");
  me->map_skill("dodge", "huxing-step");
  me->map_skill("unarmed", "fox-hand");


  exp = query("combat_exp");
  if (exp > 500000) {
    set("chat_chance_combat", level);
    set("chat_msg_combat", ({
      (: cast_spell, "feisha" :),
      (: cast_spell, "luan" :),
      (: perform_action, "needle.caidie" :),
      (: perform_action, "needle.jue" :),
      (: perform_action, "blade.xian" :),
    }));

    if (exp < 10000000) {
      if (random(2)) {
        weapon = new("/clone/weapon/needle");
      } else {
        weapon = new("/d/obj/weapon/blade/dandao");
      }
      weapon->move(me);
      command("wield all");
    } else {
      if (random(2)) {
        weapon = new("/clone/weapon/needle1");

      } else {
        weapon = new("/d/obj/weapon/blade/jindao");

      }
      weapon->move(me);
      command("wield all");
    }
  }
}
