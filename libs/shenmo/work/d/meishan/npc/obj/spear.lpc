#include <weapon.h>

#include <ansi.h> 
inherit SPEAR;
inherit F_UNIQUE; 

void create()
{
        set_name(HIC"三尖两刃枪"NOR, ({"sanliang spear", "spear"}));
        set_weight(12000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "三尖两刃枪乃是二郎神君的独门兵器，锋利无比。\n");
                set("value", 50000);
                set("material", "iron");
                set("no_break", 1);
                set("wield_msg", "$N拿出一把$n握在手中，眼前闪过一道寒光．\n");
                set("replace_file", "/d/obj/weapon/spear/jinqiang");
                set("unwield_msg", "$N放下手中的$n。\n");
        }

        init_spear(400);
        setup();
}

