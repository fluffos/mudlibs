int valid_leave(object me,string dir) {
        if (dir=="southeast" || random(36))
                return ::valid_leave(me, dir); 
        else    {
                me->move(__DIR__"malingdao0");
                return notify_fail("\n");
                }
        }

void init()
{
        add_action("do_climb", "climb");
        add_action("do_cast", "cast");
        add_action("do_drop", "drop");
}

int do_climb(string arg)
{       
        object who;
        who=this_player();
        if ( !arg || arg != "tree" )
                return notify_fail("你要爬什么？\n");
        else    {
                message_vision(CYN"$N小心翼翼地爬到树上，呀！这里风景真好啊！\n"NOR,who);
                who->receive_damage("kee", 50);
                return 1;
                }
}

int do_cast()
{
   object who;
   who=this_player();
         tell_object(who,"鬼鬼祟祟的想干什么？\n");
   return 1;
}

int do_drop()
{
   object who;
   who=this_player();
         tell_object(who,"这里满地的枯叶，东西扔了就找不回来了！\n");
   return 1; 
}
