//【三界散仙】lestat 2001/8
// 鬼谷子

#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string expell_me(object me);
int jiu_pangjuan();

void create() {
  set_name("鬼谷子", ({ "gui guzi", "guzi", "gui" }));
  //        set("title","");
  set("long", "传说中的神仙，满头白发的老人，两眼炯炯有神。\n");

  set("gender", "男性");
  set("age", 665);
  set("attitude", "peaceful");
  set("str", 100);
  set("int", 40);
  set("con", 30);
  set("per", 20);
  set("class", "xian");

  set("kee", 4000);
  set("max_kee", 4000);
  set("sen", 3000);
  set("max_sen", 3000);
  set("force", 15000);
  set("max_force", 8000);
  set("max_mana", 8000);
  set("mana", 12000);
  set("force_factor", 500);
  set("mana_factor", 500);
  set("combat_exp", 50000000);
  set("daoxing", 50000000);

  set_skill("spells", 350);
  set_skill("force", 350);
  set_skill("dodge", 350);
  set_skill("stealing", 350);
  set_skill("blade", 350);
  set_skill("parry", 350);
  set_skill("sword", 350);
  set_skill("binfen-steps", 350);
  set_skill("literate", 350);
  set_skill("ice_fire_zhang", 350);
  set_skill("unarmed", 350);
  set_skill("butian-force", 350);
  set_skill("mysticism", 350);
  set_skill("spysword", 350);
  map_skill("dodge", "binfen-steps");
  map_skill("parry", "spysword");
  map_skill("sword", "spysword");
  map_skill("force", "butian-force");
  map_skill("spells", "mysticism");
  map_skill("unarmed", "ice_fire_zhang");

  set("m_success/剑道遗篇", 1);

  create_family("三界散仙", 1, " 白");

  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "sword", "name" :),
    (: perform_action, "sword", "bishou" :),
    (: cast_spell, "gold" :),

  }));
  add_temp("apply/damage", 135);
  add_temp("apply/attack", 135);
  add_temp("apply/dodge", 135);
  add_temp("apply/spells", 100);
  add_temp("apply/armor", 150);
  add_temp("apply/armor_vs_force", 250);
  add_temp("apply/armor_vs_spells", 250);
  set("inquiry", ([
    "庞涓": (: jiu_pangjuan :),
  ]));
  setup();
  carry_object("/d/obj/cloth/choupao")->wear();
  carry_object("/d/obj/weapon/sword/changjian")->wield();

}

void attempt_apprentice(object ob, object me) {
  if ((string)ob->query("family/family_name") == "三界散仙") {
    if (((int)ob->query("daoxing") < 600000)) {
      command("say 你的道行差了些，又怎么能学我的
绝学呢？" + RANK_D->query_respect(ob) + "还需多加努力才能学到真功夫。\n");
      return;
    }
    if (ob->query_skill("butian-force", 1) < 180) {
      command("say 你的补天心法差了些，又怎么能学我的剑法呢？" + RANK_D->query_respect(ob) + "还需多加努力才能学到真功夫。\n");
      return;
    }

    command("smile");
    command("say 好极，好极，。象" + RANK_D->query_respect(ob) + "这样的爱剑之士却是少见！\n"); ;
    command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
    command("recruit " + ob->query("id"));
    ob->set("class", "xian");
    ob->set("title", HIB "鬼谷子传人" NOR);
    return;
  }
  command("shake");
  command("say 老夫不收外门弟子，" + RANK_D->query_respect(ob) + "还是另寻他人吧！\n");
  return;
}

int jiu_pangjuan() {
  object who = this_player();
  if (who->query("family/master_id") != "gui guzi")
    message_vision("$N对着$n说道：“你和他没什么关系，还是不要为他操心了。\n", this_object(), who);
  else if (who->query_temp("pangjuan/ask"))
    message_vision("$N对着$n怒道：“不是已经让你去救他了么？难道失败了？\n", this_object(), who);
  else if (this_object()->query_temp("pangjuan/give"))
    message_vision("$N对着$n说道：“我已经派人去救他了，你不必担心。\n", this_object(), who);
  else {
    message_vision("$N对着$n叹道：“庞涓虽然不才，但好歹也是你的师兄，你这就去救他一命吧！\n", this_object(), who);
    who->set_temp("pangjuan/ask", 1);
    this_object()->set_temp("pangjuan/give", 1);
    who->move("/d/sanxian/malingdao");
  }
  return 1;
}
