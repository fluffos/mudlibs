#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string ask_box();
string ask_mieyao(object me);
string ask_cancel();

void create() {
  set_name(HIC "袁守诚" NOR, ({ "yuan shoucheng", "yuan" }));
  set("gender", "男性");
  set("long", "能知天地理，善晓鬼神情．长安城里没有不认识他的。\n" NOR);
  set("title", HIW "算命先生" NOR);
  set("age", 18);
  set("class", "xian");
  set("attitude", "heroism");
  set("str", 40);
  set("int", 50);
  set("per", 30);
  set("max_kee", 4100);
  set("kee", 4100);
  set("max_sen", 3100);
  set("sen", 3100);
  set("combat_exp", 100000000);
  set("daoxing", 125000000);
  set("force", 4000);
  set("max_force", 2000);
  set("mana", 15000);
  set("max_mana", 7500);
  set("force_factor", 150);
  set("mana_factor", 750);
  set_skill("unarmed", 120);
  set_skill("dodge", 120);
  set_skill("parry", 120);
  set_skill("spells", 120);
  set_skill("mysticism", 120);
  set_skill("literate", 120);
  set_skill("binfen-steps", 120);
  set_skill("dodge", 120);
  set_skill("force", 120);
  set_skill("butian-force", 120);
  set_skill("sword", 120);
  set_skill("spysword", 120);
  set_skill("ice_fire_zhang", 120);
  map_skill("spells", "mysticism");
  map_skill("unarmed", "ice_fire_zhang");
  map_skill("force", "butian-force");
  map_skill("parry", "ice_fire_zhang");
  map_skill("dodge", "binfen-steps");
  map_skill("sword", "spysword");


  set("per", 30);
  set("max_kee", 500);
  set("max_gin", 500);
  set("max_sen", 500);
  set("force", 1500);
  set("max_force", 1500);
  set("force_factor", 50);
  set("mana", 1500);
  set("max_mana", 1500);
  set("mana_factor", 50); ;
  create_family("三界散仙", 2, "弟子");
  set("inquiry", ([
    "中山夫子": (: ask_box :),
    "三界散仙": (: ask_box :),
    "除妖": (: ask_mieyao :),
    //           "cancel": (: ask_cancel :),
  ]));
  setup();

}


string ask_box() {
  return "中山夫子是我散仙宗师，死了不少年了，但是还不瞑目!\n";
}

int accept_object(object me, object ob) {
  object box;
  string thing = (string)ob->query("id");

  if (ob->query("id") != "dinghun deng") {
    command("say 谢谢你给我这个灯 :) ");
    return 1;
  } else {
    command("nod");
    command("say 就是这东西！我看能不能用这东西帮帮老夫子。\n");
    command("laugh");
    command("say 这样吧,我先送你到我散仙之地吧。\n");

    me->move("/d/sanxian/shudong");

    tell_object(me, "眼睛一阵昏暗，你发现自己到了另外一个地方。\n");

    return 1;
  }
}
// add by djx
void attempt_apprentice(object me) {

  if ((string)me->query("family/family_name") == "三界散仙") {
    command("smile");
    command("say 希望我能够指点你些什么。\n");
    command("recruit " + me->query("id"));
    me->set("class", "xian");
    me->set("title", "三界散仙 相士");
  }
  call_out("do_recruit", 2, me);
  command("say 我只会几招三脚猫的功夫。。。\n",);

}

void do_recruit(object ob) {
  if ((int)ob->query_temp("wait_time") < 30)

  {
    command("say 在下不敢误人子弟啊．．．\n");
    return;
  }
  if ((int)ob->query("water") > 0 || (int)ob->query("food") > 0) {
    command("say 在下不敢误人子弟啊．．．\n");
    return;
  } else {

    command("sigh");
    command("say 如此心诚，在下就传你玄玄神机！日后切勿妄泄天机。");
    command("recruit " + ob->query("id"));
  }
}
void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "xian");
  ob->set("title", "三界散仙 相士");
}

string ask_mieyao(object me) {
  me = this_player();
  if ((string)me->query("family/family_name") == "三界散仙") {
    command("smile " + me->query("id"));
    return "/d/obj/mieyao"->query_yao(me);
  }
  return ("非我门人,何故来此?\n");
}
string ask_cancel() {
  object me = this_player();
  if ((int)me->query_temp("m_mieyao")) {
    me->add("daoxing", -2000);
    me->delete_temp("m_mieyao");
    me->delete("secmieyao");
    me->delete("secmieyao/type");
    me->delete("secmieyao/location");
    me->delete("secmieyao/place");
    me->delete("secmieyao/name");
    me->delete("secmieyao/id");
    return ("哎，你真是笨的可以！");
  } else {
    return ("你有任务吗？！");
  }
}
