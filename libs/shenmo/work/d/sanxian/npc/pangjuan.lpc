#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  set_name("庞涓", ({ "pang juan", "pang", "juan" }));
  set("title", "魏国上将军");
  set("long", "他就是孙膑的师弟，鬼谷子的弟子，现任魏国上将军。\n");
  set("gender", "男性");
  set("age", 39);
  set("attitude", "peaceful");
  set("str", 100);
  set("int", 35);
  set("con", 30);
  set("per", 23);
  set("class", "xian");
  set("level", 250);

  set("kee", 12000);
  set("max_kee", 12000);
  set("sen", 12000);
  set("max_sen", 12000);
  set("force", 10000);
  set("max_force", 5000);
  set("max_mana", 5000);
  set("mana", 10000);
  set("force_factor", 300);
  set("mana_factor", 300);
  set("combat_exp", 15000000);
  set("daoxing", 15000000);

  set_skill("spells", 350);
  set_skill("force", 350);
  set_skill("dodge", 350);
  set_skill("parry", 350);
  set_skill("blade", 350);
  set_skill("binfen-steps", 350);
  set_skill("literate", 350);
  set_skill("ice_fire_zhang", 350);
  set_skill("unarmed", 350);
  set_skill("butian-force", 350);
  set_skill("mysticism", 350);
  set_skill("baihe-blade", 350);
  map_skill("dodge", "binfen-steps");
  map_skill("parry", "baihe-blade");
  map_skill("blade", "baihe-blade");
  map_skill("force", "butian-force");
  map_skill("spells", "mysticism");
  map_skill("unarmed", "ice_fire_zhang");

  create_family("三界散仙", 2, "蓝");

  set("chat_chance_combat", 70);
  set("chat_msg_combat", ({
    (: perform_action, "blade", "zongheng" :),
    (: perform_action, "unarmed", "lr" :),
  }));
  add_temp("apply/damage", 100);
  add_temp("apply/attack", 100);
  add_temp("apply/dodge", 100);
  add_temp("apply/spells", 50);
  add_temp("apply/armor", 200);
  add_temp("apply/armor_vs_force", 200);
  add_temp("apply/armor_vs_spells", 200);
  setup();
  carry_object("/d/obj/armor/jinjia")->wear();
  carry_object("/d/obj/weapon/blade/yanblade")->wield();

}

void attempt_apprentice(object ob) {
  if ((int)ob->query_temp("pangjuan/dajiu") != 1) {
    command("say 你我素不相识，也无任何瓜葛，何来拜师之说。");
    return;
  }
  if (ob->query("family/master_id") != "gui guzi") {
    command("say 你我素不相识，也无任何瓜葛，何来拜师之说。");
    return;
  }
  command("say 想不到垂死之人，还能收到一名得意弟子，庞涓我虽死无憾！");
  command("recruit " + ob->query("id"));
  ob->set("title", HIW "捭阖刀法传人" NOR);
  remove_call_out("selfkill");
  call_out("selfkill", 30);
}

void selfkill() {
  object me = this_object();
  message_vision("$N叹道：我虽大难不死，但又有何面目去见魏王。\n\n", me);
  message_vision("$N言毕，拔出佩剑，径向脖颈刎去！\n\n", me);
  me->die();
}
