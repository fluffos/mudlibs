
//creat by windy 2011 10
#include <ansi.h>
inherit NPC;

void create()
{
        set_name("孙膑", ({ "sun bin", "sun", "bin" }));
        set("title","齐国上将军");
        set("long", "他就是庞涓的师兄，鬼谷子的弟子，现任齐国上将军。\n");
        set("gender", "男性");
        set("age", 40);
        set("attitude", "peaceful");
        set("str", 100);
        set("int", 40);
        set("con", 30);
        set("per", 25);
        set("class","xian");
        set("level",300);
        
        set("kee", 15000);
        set("max_kee", 15000);
        set("sen", 13000);
        set("max_sen", 13000);
        set("force", 12000);
        set("max_force", 6000);
        set("max_mana",6000);
        set("mana",12000);
        set("force_factor", 300);
        set("mana_factor", 300);
        set("combat_exp", 20000000);
        set("daoxing", 20000000);

        set_skill("spells",400);
        set_skill("force", 400);
        set_skill("dodge", 400);
        set_skill("parry", 400);
        set_skill("sword", 400);   
        set_skill("binfen-steps", 400);        
        set_skill("literate", 400);
        set_skill("ice_fire_zhang", 400);
        set_skill("unarmed", 400);
        set_skill("butian-force", 400);
        set_skill("mysticism", 400);
        set_skill("spysword", 400);        
        map_skill("dodge", "binfen-steps");        
        map_skill("parry", "spysword");
        map_skill("sword", "spysword");
        map_skill("force", "butian-force");
        map_skill("spells", "mysticism");
        map_skill("unarmed", "ice_fire_zhang");
        
        set("m_success/剑道遗篇",1); 

        create_family("三界散仙", 2, "蓝");

        set("chat_chance_combat", 70);
        set("chat_msg_combat", ({
                (: perform_action, "sword","name" :),
                (: perform_action, "unarmed","lr" :),
                (: perform_action, "sword","dao" :),
                (: perform_action, "sword","bishou" :),            
        }) ); 
        add_temp("apply/damage", 150);
        add_temp("apply/attack", 150);
        add_temp("apply/dodge", 200);
        add_temp("apply/spells", 100);
        add_temp("apply/armor", 300);
        add_temp("apply/armor_vs_force",250);
        add_temp("apply/armor_vs_spells",250);
        setup();
        carry_object("/d/obj/armor/jinjia")->wear();
        carry_object("/d/obj/weapon/sword/qingfeng")->wield();

}

void die()
{
object weapon;
object me = this_object();
object who = query_temp("last_damage_from");
if (!who || !who->query_temp("pangjuan/ask") || who->query_temp("pangjuan/killbing")<2)
        {
        me->set("eff_sen", 13000);
        me->set("max_sen", 13000);
        me->set("sen", 13000);
        me->set("eff_kee", 15000);
        me->set("max_kee", 15000);
        me->set("kee", 15000);
        me->set("mana", 12000);
        me->set("force", 12000);
        message_vision(HIG"孙膑从怀里小心翼翼的拿出一颗云丹送入嘴中，果然见孙膑脸上慢慢泛出红光，法力和内力到了极限！\n"NOR,me); 
        if (!me->query_temp("weapon"))
                {
                weapon=carry_object("/d/obj/weapon/sword/qingfeng");
                weapon->wield();
                }
        }
else    {
        command("sigh");
        message("sound", "\n\n孙膑对着庞涓叹道：罢了！既然师傅可怜你，我就饶你一命吧！\n\n", environment());
        message("sound", "\n孙膑拨转马头，率军径向齐国撤去了。。。\n\n", environment());
        who->set_temp("pangjuan/dajiu", 1);
        destruct(me);
        }
}

void unconcious()
{
die ();
}

void heart_beat() 
{
   object pang;
   object me = this_object();

    if( !environment() )  return;
   if (!pang=present("pang juan",environment(me))) {
       message_vision(HIY"$N哈哈大笑：“弟兄们，咱么撤吧。”\n"NOR,this_object());
       destruct(me);
       return;
   }
   ::heart_beat();
}



