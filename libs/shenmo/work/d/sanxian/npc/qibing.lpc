
//creat by windy 2011 10
#include <ansi.h>
inherit NPC;

void create()
{
        set_name("齐兵", ({ "qi bing", "bing" }));
        set("title","冲锋陷阵");
        set("long", "一名精壮的齐国士兵，长的十分彪悍。\n");
        set("gender", "男性");
        set("age", 27);
        set("attitude", "peaceful");
        set("str", 60);
        set("int", 20);
        set("con", 30);
        set("per", 15);
        set("class","human");
        set("level", 100+random(100));
        set("kee", 8000);
        set("max_kee", 8000);
        set("sen", 8000);
        set("max_sen", 8000);
        set("force", 6000);
        set("max_force", 3000);
        set("max_mana",3000);
        set("mana",6000);
        set("force_factor", 150);
        set("mana_factor", 150);
        set("combat_exp", 5000000+random(4000000));
        set("daoxing", 5000000+random(4000000));

        set_skill("spells",150+random(150));
        set_skill("force", 150+random(150));
        set_skill("dodge", 150+random(150));
        set_skill("parry", 150+random(150));
        set_skill("spear", 200+random(150));   
        set_skill("yanxing-steps", 150+random(150));        
        set_skill("literate", 150+random(150));
        set_skill("longzhua-gong", 150+random(150));
        set_skill("unarmed", 150+random(150));
        set_skill("lengquan-force", 150+random(150));
        set_skill("baguazhou", 200+random(150));
        set_skill("bawang-qiang", 150+random(150));        
        map_skill("dodge", "yanxing-steps");        
        map_skill("parry", "bawang-qiang");
        map_skill("spear", "bawang-qiang");
        map_skill("force", "lengquan-force");
        map_skill("spells", "baguazhou");
        map_skill("unarmed", "longzhua-gong"); 

        create_family("将军府", 4, "蓝");

        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: perform_action, "spear","juanlian" :),            
        }) ); 
        add_temp("apply/damage", 50);
        add_temp("apply/attack", 50);
        add_temp("apply/dodge", 50);
        add_temp("apply/spells", 50);
        add_temp("apply/armor", 150);
        add_temp("apply/armor_vs_force",50);
        add_temp("apply/armor_vs_spells",50);
        setup();
        carry_object("/d/obj/armor/tiejia")->wear();
        carry_object("/d/obj/weapon/spear/changqiang")->wield();

}

void die()
{
object me = this_object();
object who = query_temp("last_damage_from");
if (!who || !who->query_temp("pangjuan/ask"))
        {
        me->set("eff_sen", 8000);
        me->set("max_sen", 8000);
        me->set("sen", 8000);
        me->set("eff_kee", 8000);
        me->set("max_kee", 8000);
        me->set("kee", 8000);
        me->set("mana", 6000);
        me->set("force", 6000);
        message_vision(HIG"齐兵从怀里小心翼翼的拿出一颗云丹送入嘴中，果然见齐兵脸上慢慢泛出红光，法力和内力到了极限！\n"NOR,me); 
        }
else    {
        command("fear");
        message("sound", "\n\n齐兵大喊一声：兄弟们！敌人太彪悍了，我们先撤吧！\n\n", environment());
        who->add_temp("pangjuan/killbing", 1);
        destruct(me);
        }
}

void unconcious()
{
die ();
}


void heart_beat() 
{
   object pang;
   object me = this_object();

    if( !environment() )  return;
   if (!pang=present("pang juan",environment(me))) {
       message_vision(HIY"$N哈哈大笑：“弟兄们，咱么撤吧。”\n"NOR,this_object());
       destruct(me);
       return;
   }
   ::heart_beat();
}

