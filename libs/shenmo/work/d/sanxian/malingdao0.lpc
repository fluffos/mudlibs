//Creat by windy  2011 08

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "马陵道");
  set("long", @LONG

这是齐国通往魏国的一条要道。自古以来，都是兵家必争之地。
道两旁长满了参天大树(tree)，林荫遮天蔽日，好不幽静。
LONG);

  set("item_desc", ([ /* sizeof() == 2 */
    "tree": "一颗参天大树，但是树皮(shupi)不知为何被人削了一大片下来。
",
    "shupi": "你发现削掉树皮的树干上竟然写了七个大字——“庞涓死于此树下”。
",
  ]));

  set("exits", ([ /* sizeof() == 2 */
    "northwest": __DIR__ "malingdao",
    "southeast": __DIR__ "malingdao",
  ]));
  set("objects", ([
  ]));
  setup();
  //  replace_program(ROOM);
}

void init() {
  add_action("do_climb", "climb");
  add_action("do_dajiu", "jiu");
  add_action("do_cast", "cast");
  add_action("do_drop", "drop");
}

int do_climb(string arg) {
  object who, pang;
  who = this_player();

  if (!arg || arg != "tree" || !who->query_temp("pangjuan/ask"))
    return notify_fail("你要爬什么？\n");
  else if (pang = present("pang juan", environment(who)))
    return notify_fail("庞涓就在你身边，处境十分危险。你还不赶紧去救(jiu)他？！\n");
  else {
    message_vision(CYN "$N小心翼翼地爬到树上，在枝叶间藏了起来。\n" NOR, who);
    who->receive_damage("kee", 50);
    remove_call_out("message1");
    call_out("message1", 20 + random(10), who);
    return 1;
  }
}

void message1(object who) {
  who = this_player();
  message_vision(CYN "$N隐隐约约听到远处传来一阵急促的马蹄声。\n\n" NOR, who);
  remove_call_out("message2");
  call_out("message2", 5 + random(5), who);
}

void message2(object who) {
  object victim;
  who = this_player();
  message_vision(CYN "$N等不多时，只见一匹战马狼狈地跑了过来。\n" NOR, who);
  message_vision(CYN "马鞍桥上端坐一人，盔歪甲斜，带懒袍松，吁吁带喘。\n" NOR, who);
  message_vision(CYN "$N定睛观瞧，来人正是自己的师兄庞涓，处境似乎很危险！\n" NOR, who);
  message_vision(CYN "$N心中暗道，不能见死不救(jiu)。想罢，$N纵身从树上跳了下来！\n" NOR, who);
  victim = new(__DIR__ "npc/pangjuan");
  victim->move(environment(who));
}

int do_dajiu(string arg) {
  object who, killer;
  who = this_player();

  if (!arg || arg != "pang juan" || !who->query_temp("pangjuan/ask"))
    return notify_fail("你要救谁？\n");
  else {
    message_vision(HIC "$N拍了拍胸脯对庞涓说道：“师兄，有我在，谁也不能把你怎么地！”\n" NOR, who);
    who->command("protect pang juan");
    message_vision(HIC "$N话音刚落，但听得四下里杀喊声震天价响，庞涓已被齐军团团围住！\n" NOR, who);
    killer = new(__DIR__ "npc/qibing");
    killer->move(environment(who));
    killer->command("kill pang juan");
    killer = new(__DIR__ "npc/sunbin");
    killer->move(environment(who));
    killer->command("kill pang juan");
    killer = new(__DIR__ "npc/qibing");
    killer->move(environment(who));
    killer->command("kill pang juan");
    killer = new(__DIR__ "npc/qibing");
    killer->move(environment(who));
    killer->command("kill pang juan");
    return 1;
  }
}

int do_cast() {
  object who;
  who = this_player();
  tell_object(who, "鬼鬼祟祟的想干什么？\n");
  return 1;
}

int do_drop() {
  object who;
  who = this_player();
  tell_object(who, "这里满地的枯叶，东西扔了就找不回来了！\n");
  return 1;
}
