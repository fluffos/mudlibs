#include <ansi.h>

inherit ITEM;

void create() {
  set_name("定魂灯", ({ "dinghun deng", "deng" }));
  set("long", "一盏油灯，去见中山夫子必须用到它。\n");
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("value", 10000);
    set("material", "cloth");
  }
  setup();
}
