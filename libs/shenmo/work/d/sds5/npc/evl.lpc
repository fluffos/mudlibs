#include <ansi.h>
inherit NPC;

void heart_beat() {
  if (living(this_object())) {
    if (query("eff_kee") < query("max_kee"))
      SDS_D->addEffKee(this_object());
    if (query("kee") < query("eff_kee"))
      SDS_D->addKee(this_object());
    if (query("sen") < query("eff_sen"))
      SDS_D->addSen(this_object());
    if (query("eff_sen") < query("max_sen"))
      SDS_D->addEffSen(this_object());
  }

  if (this_object()->is_fighting()) {
    if (this_object()->is_busy()
      && random(3) == 0) {
      this_object()->start_busy(1, 1000);
      this_object()->interrupt_me(this_object(), "sds");
      this_object()->continue_action();
      this_object()->reset_action();
    }
    SDS_D->randomPfm(this_object());
  }
  ::heart_beat();
}

void die() {
  object who, ob = this_object();

  ob->powerup();
  ob->remove_all_killer();
  all_inventory(environment())->remove_killer(ob);

  if (query_temp("block_msg/all")) {
    say("\n半空忽然传来童虎的训斥：对无还手之力者怎可动了杀机？！\n\n");
    return;
  }
  if (!objectp(who = query_temp("last_damage_from"))) {
    say("\n" + name() + "大喝一声：无人击打，怎可退缩！言罢，小宇宙又陡然燃烧起来！\n\n");
    return;
  }
  if (!present(who, environment())) {
    say("\n" + name() + "大吼一声：敌人已逃，怎可退缩！说罢，小宇宙又陡然燃烧起来！\n\n" NOR);
    return;
  }
}

void unconcious() {
  object who, ob = this_object();

  if (!living(ob))
    return;

  if (query("force") < 300) {
    die();
    return;
  }

  ob->remove_all_killer();
  all_inventory(environment())->remove_killer(ob);
  ob->remove_ride();
  SDS_D->addEffKee(ob);
  SDS_D->addEffSen(ob);
  SDS_D->addKee(ob);
  SDS_D->addSen(ob);

  if (objectp(who = query_temp("last_damage_from")))
    COMBAT_D->winner_reward(who, ob);

  message("system", HIR "\n你的眼前一黑，接着什么也不知道了．．．\n\n" NOR, ob);
  ob->disable_player(" <昏迷不醒>");
  set_temp("block_msg/all", 1);
  COMBAT_D->announce(ob, "unconcious");
  call_out("revive", 30 + random(30));
}
