#include <ansi.h>
inherit __DIR__ "evl.lpc";

void create() {
  set_name("亚鲁歌路", ({ "yalu gelu", "yalu", "gelu" }));
  set("莲花", 1);
  set("title", HIM "英仙座" NOR WHT "白银斗士" NOR);
  set("nickname", REV HIM " 美 杜 沙 " NOR);
  set("race", "人类");
  set("gender", "男性");

  set("combat_exp", 100000000);
  set("max_kee", 10000);
  set("max_sen", 10000);
  set("max_force", 15000);
  set("max_mana", 15000);
  set("force_factor", 500);
  set("mana_factor", 600);

  set_skill("mingwang-quan", 700 + random(200));
  set_skill("parry", 700 + random(200));
  set_skill("unarmed", 700 + random(200));
  map_skill("unarmed", "mingwang-quan");
  map_skill("parry", "mingwang-quan");
  set_skill("force", 700 + random(200));
  set_skill("ghostforce", 700 + random(200));
  map_skill("force", "ghostforce");
  set_skill("spells", 700 + random(200));
  set_skill("ghostspells", 700 + random(200));
  map_skill("spells", "ghostspells");
  set_skill("literate", 400);
  set_skill("dodge", 700 + random(200));
  set_skill("ghostdance", 700 + random(200));
  map_skill("dodge", "ghostdance");

  powerup();

  setup();
}

