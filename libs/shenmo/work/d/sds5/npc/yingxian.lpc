string query_hit_sen_msg(int v) {
  return query_hit_msg(v);
}

varargs int receive_damage(string type, int damage, object who) {
  object me = this_object();
  if (!me->is_fighting()) return 0;
  if (!who)
    who = select_opponent();
  if (!who)
    return 0;

  if (damage < 500 || random(damage) < 100)
    return 0;

  message_vision("$N见状，忙将手中美杜沙盾对着$n一摆，口中开始念动盾上符文。\n" NOR, me, who);
  say(CYN + name() + CYN "说道：蛇蝎之心，诅咒一言，赐敌同等之伤！\n" NOR);
  who->receive_damage(type, damage);
  who->receive_wound(type, damage / 3);
  COMBAT_D->report_status(who);
  who->set_temp("last_damage_from", me);
  return ::receive_damage(type, damage, who);
}


void die() {
  ::die();
  command("say 你牛×，我服了。。。。\n");
}
