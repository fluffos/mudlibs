#include <ansi.h>
inherit NPC;

#define MSK_D "/d/sds5/master.lpc"

string check_me();

void create()
{
set_name("童虎", ({"dohko", "tong hu"}));
set("long", "传说中在庐山五老峰静坐243年的中国神秘老人,天平座。上一代的
黄金圣斗士，负责看管被雅典娜封印的一百零八名冥斗士，并被雅典娜赐予返老还童术。 \n");
set("gender","男性");
set("title", HIW"天秤座"HIY"黄金圣斗士"NOR);
set("age",1000);
set("con",60);
set("per",60);
set("str",60);
set("int",60);
set("combat_exp",150000000);
set_skill("dodge", 600);
set_skill("force", 600);
set_skill("parry", 600);
set_skill("unarmed", 600);
set_skill("shengdou",600);
set_skill("lushan-quan",600);
set_skill("stars-steps",600);
set_skill("dragonforce",600);
set_skill("seashentong", 600);
map_skill("parry","shengdou");
map_skill("dodge","stars-steps");
map_skill("unarmed","lushan-quan");
map_skill("spells","seashentong");
map_skill("force","dragonforce");

set("max_force", 10000);
set("force", 20000);
set("max_mana",15000);
set("mana",27000);
set("mana_factor",600);
set("force_factor",300);
set("max_kee", 10000);
set("max_sen", 10000);

set("inquiry", ([ 
        "圣域"   : (: check_me :),       
]));

setup();
carry_object("/d/sds5/obj/tc_cloth")->wear();
}

string check_me()
{
int i;  
object *obs,me = this_player();

if ( this_object()->is_fighting() )
        return "没见我现在很忙吗?";

if ( sizeof(MSK_D->QueryTeam())<=0 )    //如果没有组队
        {
        if ( !MSK_D->IsStart() )        //还没有开始
                return "恩，你想求圣域看个究竟？好，带上你的同伴，到崖下去看个究竟吧。";
                                        //已经开始了，但是没有组队的人了
        MSK_D->resets();                  //冥界重新初始
        return "恩，你想求圣域看个究竟？好，带上你的同伴，到崖下去看个究竟吧。";                                              
        }
                        
if ( me!=MSK_D->QueryLeader() )
        {
        if ( member_array(me,MSK_D->QueryTeam())==-1 )
                {       
                say(CYN+name()+CYN"说道：咦？！你是什么人？怎么跑到五老峰来了？回去！\n");
                message_vision(HIY"\n$N"HIY"将手一招，一道强光笼罩住$n"HIY"！\n\n"NOR,this_object(),me);
                tell_object(me,HIY"眼前金光一闪，你已不知身在何处。\n"NOR);
                me->move("/d/city/kezhan");
                message_vision(HIY"\n金光一闪，$N"HIY"从光线中渐渐现出身来。\n\n"NOR,me);
                tell_object(me,HIY"你被童虎传送到了南城客栈。\n"NOR);
                return "现在什么人都有。。。。";
                }
        else    return "还是让你们的头和老夫说话。";
        }
                
if ( me->query("sds5/lushan")!="done" )
        return "你还是去崖下看个究竟再说。";

//庐山已过，直接传送
say(name()+"点了点头。\n");
obs = MSK_D->QueryTeam();
i = sizeof(obs);
while(i--)
        {
        if ( !obs[i] || !living(obs[i]) )               //无或昏
                continue;
        if ( environment(obs[i])->is_mingjie() )        //已在冥界地图
                continue;
        if ( obs[i]->query("sds5/lushan")!="done"       //庐山没过
          && userp(obs[i]) )
                MSK_D->LeaveTeam(obs[i]);               //清除出组

        if ( obs[i]->is_busy() || obs[i]->is_fighting() )
                {
                say(CYN+name()+CYN"合目冥思一番，说道：“"+obs[i]->query("name")+"还没准备好。\n"NOR); 
                break;
                }
        if ( !present(obs[i],environment()) )
                {
                if ( !userp(obs[i]) )
                        obs[i]->move(environment());
                else    {               
                        say(CYN+name()+CYN"说道：“"+obs[i]->query("name")+"怎么没来？\n"NOR);         
                        break;
                        }
                }               
        obs[i]->move("/d/sds5/12_shanjiao");    
        message_vision("$N将$n传送至圣域！\n",this_object(),obs[i]);
        }
return "各位好之为之。";
}               
                                
