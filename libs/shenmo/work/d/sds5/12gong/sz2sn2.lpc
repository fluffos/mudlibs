#include <ansi.h>
inherit ROOM;

void create ()
{
set ("short", "山路");
set ("long", @LONG

这是走向室女宫的路上，只见前面可以看到美丽的室女宫耸立在奥林
匹亚峰上！云雾中隐隐约约还可以看见山下的狮子宫。
LONG);

set("exits", ([
        "southup"    :       __DIR__"shinu",
        "westdown"  :       __DIR__"sz2sn1",
]));
set("outdoors", "12gong");
setup();
}

int do_none()
{
message_vision("赶紧去保护雅典娜！\n",this_player());
return 1;
}

void init()
{
object me = this_player();
add_action("do_none","kill");
add_action("do_none","fight");
add_action("do_none","ji");
add_action("do_none","perform");
add_action("do_none","cast");
add_action("do_none","recall");
add_action("do_none","whisper");
add_action("do_none","surrender");
add_action("do_none","bian");
add_action("do_none","get");
add_action("do_none","give");
add_action("do_none","move");
add_action("do_none","burn");
add_action("do_inspect","inspect");
remove_call_out("check");
call_out("check",1,this_object());
if ( (int)me->query_temp("yinshentime") )
        {
        me->delete_temp("yinshentime");
        me->delete("env/invisibility");      
        me->save();
        me->delete_temp("no_heal_up/yinshen");
        message_vision(HIW"\n白光闪过之后，$N又现出了身形。\n\n"NOR, me);
        }
if ( me->query("sds5/shizi")!="done" & userp(me) )
        {
        message_vision(HIY"“圣域现在有事发生，$N还是回吧！”\n"NOR,me);
        me->move("/d/city/kezhan");
        message_vision(HIY"白光有一闪，$N出现在大家的面前，世界真奇妙！\n"NOR);
        me->unconcious();       
        }
return;
}

int valid_leave(object me, string dir)
{
object mu;
object here = this_object();
if ( userp(me) )
        {
        mu = present("mu",here);
        if ( !mu )
                {
                call_out("mu_go",5+random(10),me,mu,here);
                return notify_fail("还是等等穆吧....\n");
                }
         if ( me->query("sds5/shizi")!="done"  )
                return notify_fail("狮子宫你还没去调查呢。\n");
        }
else return 1;
return ::valid_leave(me, dir);
}

void mu_go(object me,object mu,object here)
{
if ( !me || environment(me)!=here ) 
        return;
mu = present("mu",here);
if ( mu && !userp(mu) )
        return;
else    mu = find_object("/d/sds5/12gong/npc/baiyang");
if ( !mu )
        mu = new("/d/sds5/12gong/npc/baiyang");
mu->move(here);
message_vision("$N走了过来。\n",mu,me);
mu->set_leader(me);
return;
}

