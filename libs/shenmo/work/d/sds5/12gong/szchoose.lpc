#include <ansi.h>
#include <combat.h>
inherit ROOM;

void create ()
{
set ("short", "双子迷宫");
set ("long", @LONG
  迷恋斯巴达王妃勒达美色的宙斯，为接近她而化身为天鹅，两人生了一对双胞胎-波拉克
斯神子和人之子卡斯托。两人皆是骁勇冒险的武士，经常联手立下大功勋。他们二人也有一
对双胞胎堂弟-伊达斯和林克斯。一天四人准备去抓牛，他们抓了很多牛，并准备平分时，
贪心的伊达斯和林克斯趁波拉克斯，卡斯托兄弟不备时，将牛全部带回去。被激怒的两对双
胞胎大起争执，结果伊达斯用箭将卡斯托刺死。波拉克斯伤心得要随卡斯托赴天国，但却因
为拥有永远的生命而不能如愿。他的悲痛感动了宙斯，乃为他们二人设立星座，分别住在天
国和死亡之国。
LONG);
set("alternative_die",1);
setup();
}

void fullup(object obj) 
{
if (!obj) return;
obj->set("kee",250);
obj->set("eff_kee",(int)obj->query("max_kee")*(5+random(5))/10);
obj->set("sen",250);
obj->set("eff_sen",(int)obj->query("max_sen"));
obj->set("force",0);
obj->set("mana",0);
obj->save();
}

int do_none( )
{
message_vision("$N像只无头的苍蝇原地直打转。！\n"NOR,this_player());
return 1;
}

void alternative_die(object me)
{
string str;
str = WHT"【"NOR HIB"圣战"NOR HIY"十二宫"NOR HIB"之卷"NOR WHT"】"NOR;
str+=HIC+"$1($i)："NOR;
str = replace_string(str,"$1","童虎");
str = replace_string(str,"$i","Dohko");
str+= HIW+me->name()+NOR HIC"在双子迷宫中一阵迷茫。\n"NOR; 
if ( userp(me) && me->query("sds5/jinniu2")=="done" )
        {
        fullup(me);
        message("channel:rumor",str,users());  
        message("vision","$N像只无头的苍蝇原地直打转。！\n"NOR,this_object(),this_player());
        tell_object(this_player(),"四周一阵扭曲，你一时之间也想不出别的办法。\n");
        }
return;
}

object npc_name( )
{
int i;
object ob,*players;
players = users();
i = random(sizeof(players));
ob = players[i];
if ( !ob )
        ob = new("/d/sds3/npc/shuangzi");
return ob;
}

object npc_name2( )
{
object ob;
string *npc1,*npc2;
npc1 = ({
        "/d/9sky/guzhanchang/npc/shouhuzhe1",
        "/d/9sky/guzhanchang/npc/shouhuzhe2

",
        "/d/9sky/guzhanchang/npc/shouhuzhe3",
        "/d/9sky/guzhanchang/npc/shouhuzhe4",
        "/d/9sky/guzhanchang/npc/shouhuzhe5",
        "/d/9sky/guzhanchang/npc/shouhuzhe6",
        "/d/9sky/guzhanchang/npc/shouhuzhe7",
        "/d/9sky/guzhanchang/npc/shouhuzhe8",
        "/d/9sky/guzhanchang/npc/shouhuzhe9",
        "/d/9sky/guzhanchang/npc/tianzun",
});
npc2 = ({
        "/d/death/npc/dizhang",
        "/d/jjf/npc/chengyaojin",
        "/d/jjf/npc/luocheng",
        "/d/jjf/npc/qinqiong",
        "/d/jjf/npc/baifalaoren",
        "/d/moon/npc/chimeng",
        "/d/moon/npc/change",
        "/d/moon/npc/xiwangmu",
        "/d/pansi/npc/zixia",
        "/d/pansi/npc/qingxia",
