return ob;
}

void change_room(object where)
{
int i;
object *inv,me;
inv = all_inventory(where);
i = sizeof(inv);
remove_call_out("change_room");
while(i--)
        {
        if ( userp(inv[i]) )
                {
                if ( !inv[i]->query_temp("sds5/szmg") )
                        return;
                }
        else    {
                if ( inv[i]->query("id")!="mu" )
                        return;
                }
        me = inv[i];
        if ( me->query_temp("sds5/szmg") )
                me->delete_temp("sds5/szmg");
        tell_room(where,me->name()+"忽然哈哈大笑：这点伎俩....我早已看破。\n
"+me->name()+"运起小宇宙，向着某一点击去，空间一阵扭曲，人已消失不见！\n",me);
        tell_object(me,"你看准时机，从扭曲空间的空隙间钻了出去。\n");
        me->move(__DIR__"shuangzi");
        message("vision","时空一阵扭曲，"+me->name()+"从中跌将出来。\n",environment(me),me);
         if ( userp(me) && me->query("sds5/shuangzi")!="done" )
                {
                message("channel", WHT"【"NOR HIB"圣战"NOR HIY"十二宫"NOR HIB"之卷"NOR WHT"】"NOR HIC"童虎(Dohko)："+me->query("name")+HIC"闯过了双子迷宫!\n"NOR,users());
                me->add("daoxing",50000);
                me->set("sds5/shuangzi","done");
                me->save();
                tell_object(me,"你得到了五十年道行。\n");
                }
        }
call_out("change_room",where);
return;
}

void do_go(string arg)
{
int i,damage;
object me,env,target;
string msg;
me = this_player();
env = this_object();

if ( me->is_busy() )
        {
        tell_object(me,"你现在正忙着呢。\n");
        return;
        }

if ( !arg )
        {
        tell_object(me,"你要往哪个方向走？\n");
        return;
        }

me->start_busy(random(2));
msg = "$N在扭曲的空间中小心翼翼的往前摸索。";
if ( random(10)>=9 )
        {
        msg+= "$N终于发现一个出口。\n";
        message_vision(msg,me);
         me->set_temp("sds5/szmg",1);
        call_out("change_room",1,env);
        return;
        }
else if ( random(10)>=7 )
        {
        msg+= "$N终于发现一个出口。\n";
        msg = "结果一看，闹了半天还是在原地打转。\n";   
        message_vision(msg,me);
        return;
        }
else    {
        if ( random(10)<=3 )    target = npc_name();
        else    target = npc_name2();
        if ( !target || !living(target) )  return;
        msg+="忽然雾气一闪，$W从深处冲了出来！\n";
        msg+=HIR"看起来$W"HIR"像要杀了$N"HIR"!\n"NOR;
        msg = replace_string(msg,"$W",target->query("name"));
        message_vision(msg,me);
        for ( i=0;i<(3+random(7));i++ )
                {
                COMBAT_D->do_attack(target,me,target->query_temp("weapon"),0);
                }
        damage = target->query_temp("apply/damage");
        damage+=target->query_skill("force");
        damage+=target->query_skill("spells");
        if ( wizardp(me) ) tell_object(me,"damage="+damage+"\n");
         msg = COMBAT_D->damage_msg(damage,({"抽伤","割伤","劈伤","刺伤","筑伤","内伤",})[random(6)]);
         if ( target->query_temp("weapon") )
           msg = replace_string(msg,"$w",target->query_temp("weapon")->query("name"));
         else
         msg = replace_string(msg,"$w",BLU"斗气"NOR);
         msg = replace_string(msg,"$l",HIY+({"圣衣","脖子","屁股"})[random(3)]+NOR);
         msg = replace_string(msg,"$p","$n");
         message_vision(msg,target,me);
        me->receive_damage("kee",damage);
        COMBAT_D->report_status(me);
        target->remove_killer(me);
        me->remove_killer(target);
        return;
        }
}

void init() 
{ 
object me = this_player();
if ( userp(me) )
        {
        add_action("do_none","move"); 
        add_action("do_none","mark"); 
        add_action("do_none","recall"); 
        add_action("do_none","perform");
        add_action("do_none","cast");
        add_action("do_go","go");
        }
remove_call_out("change_room");
call_out("change_room",1,this_object());
return;
} 

void die(object who)
{
alternative_die(who);
}

void unconcious(object who)
{
alternative_die(who);
}

