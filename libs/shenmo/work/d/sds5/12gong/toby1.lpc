#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "山路");
  set("long", @LONG

这是走向白羊宫的路上，只见前面可以看到美丽的白羊宫耸立在奥林
匹亚峰上！

LONG);

  set("exits", ([
    "southup": __DIR__ "toby2",
  ]));
  set("objects", ([
    __DIR__ "npc/tianying": 1,
  ]));
  set("outdoors", 1);
  setup();
}

void init() {
  add_action("do_none", "bian");
  add_action("do_none", "perform");
  add_action("do_none", "cast");
  add_action("do_none", "get");
  add_action("do_none", "drop");
  add_action("do_none", "whisper");
  add_action("do_none", "ji");
  add_action("do_none", "fight");
  add_action("do_none", "kill");
  add_action("do_none", "ji");
  add_action("do_none", "move");
}

int do_none() {
  tell_object(this_player(), "赶紧去解救雅典娜吧！\n");
  return 1;
}

int valid_leave(object me, string dir) {
  int i;
  object *inv;
  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    if (userp(inv[i]))
      return notify_fail("还是先把身上的玩家放下来再去吧！\n");
    if (inv[i]->query("id") == "yueguang baohe")
      return notify_fail("还是先把身上的宝盒放下来再去吧！\n");
  }
  if (!userp(me))
    return notify_fail("小猫小狗的别想进圣域！\n");
  if (me->query("sds5/lushan") == "done") {
    if (me->query_temp("sds5/start")) {
      message(
        "channel:chat",
        HIC "【圣战·十二宫之卷】童虎(Dohko):" + HIW + me->name() + HIC "踏上了前往圣域解救雅典娜的路程!\n" NOR,
        users()
      );
      if (me->query_temp("ridee"))
        me->query_temp("ridee")->set_temp("rider", 0);
      me->set_temp("ridee", 0);
      me->add_temp("apply/dodge", -me->query_temp("ride/dodge"));
      me->set_temp("ride/dodge", 0);
      return 1;
    } else {
      call_out("start", 3 + random(3), me, this_object());
      return notify_fail("你警惕的朝四周巡视了一下，看看有没异状。\n" NOR);
    }
  } else return notify_fail("你看着四周雄伟的建筑，不禁止住了脚步。\n" NOR);
}

void start(object me, object env) {
  object npc;
  string str = "四周静悄悄的，只听到呼呼的风声在耳边呼啸。\n";
  if (!npc = present("marin", env) || userp(npc)) {
    npc = new(__DIR__ "npc/tianying");
    npc->move(env);
    str += "$n走了过来。\n";
  }
  str += "$n神色严肃的注视着地面，见到$N来也没有抬头。\n";
  str += "$N见壮连忙上前观看。\n";
  str += "$N“呀”的一声发出一声惊呼。\n";
  str = replace_string(str, "$n", npc->query("name"));
  message_vision(str, me);
  call_out("start2", 2 + random(3), me, env, npc);
}

void start2(object me, object env, object npc) {
  if (!me || !npc)
    return;
  message_vision("只见地面上一个硕大的深坑！\n", me);
  me->command("say 这...这是怎么一回事?!\n");
  npc->command("say 这是上次12宫之战亡者的灵冢!\n");
  call_out("start3", 1 + random(2), me, env, npc);
}

void start3(object me, object env, object npc) {
  if (!me || !npc)
    return;
  me->command("?");
  message_vision("$N不由跳将起来:到底是谁,居然在圣域破坏!\n", me);
  npc->command("shake");
  message_vision("魔铃指着深坑道:你仔细看看......\n", me);
  call_out("start4", 1 + random(2), me, env, npc);
}

void start4(object me, object env, object npc) {
  if (!me || !npc)
    return;
  message_vision("$N蹲下仔细观察深坑有什么不寻常之处。\n", me);
  me->command("ah");
  me->command("say 是从内部向外破坏的？！\n");
  npc->command("nod " + me->query("id"));
  npc->command("say 你去白羊宫看看，我回去叫大家准备！\n");
  me->set_temp("sds5/start", 1);
  message_vision("魔铃急急忙忙的离开了。\n", me);
  destruct(npc);
  return;
}
