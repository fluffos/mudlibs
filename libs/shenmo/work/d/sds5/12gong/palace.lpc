#include <ansi.h>
inherit ROOM;

void create ()
{
string msg;
set ("short", HIY"黄金圣殿"NOR);
msg = @LONG
                   !
                  /^\
                /     \
 |           | (       ) |           |
/^\ |       /^\ \     / /^\       | /^\
|O|/^\     (   )|-----|(   )     /^\|O|
|_||-| |^-^|-雅典娜与此执法-^-^| |-||_|
|O||O| |/^\|/^\||  |  ||/^\|/^\| |O||O|
|-||-| ||_|||_||| /^\ |||_|||_|| |-||-|
|O||O| |/^\|/^\||(   )||/^\|/^\| |O||O|
|-||-| ||_|||_||||   ||||_|||_|| |-||-|

LONG;
msg+="\n";

msg = replace_string(msg,"雅典娜",NOR BLINK HIC"雅典娜"NOR HIY);
msg = replace_string(msg,"与此执法",NOR HIR"与此执法"NOR HIY);
msg = replace_string(msg,"^",NOR BLINK HIG"^"NOR HIY);
msg = replace_string(msg,"O",NOR BLINK RED"O"NOR HIY);

set("long",msg);
set("no_fight", 1);
set("no_magic", 1);
set("exits", ([
        "down"  :       __DIR__"king",
        "enter"  :       __DIR__"shenxiang",
]));
set("objects",([
        __DIR__"npc/ydn" : 1,    
]));
set("no_clean_up",1);
setup();
}

int valid_leave(object me, string dir)
{
object blood;
if ( !userp(me)  ) return 0;
if ( dir=="enter" && !blood=present("nvshen's blood",me) && userp(me) )
        {
        call_out("give_blood",5+random(15),me);
        return notify_fail("你蹲在地上仔细收集残留的女神之血。\n");
        }
return ::valid_leave(me,dir);
}

void give_blood(object me)
{
object blood;
object env = this_object();

if ( !me || !present(me,env) )
        return;
if ( env->query("blood") )
        return;

blood = new(__DIR__"npc/obj/blood");
blood->set_name(HIM"雅典娜"NOR YEL"の"NOR +blood->name(),({"nvshen's blood","blood","xue"}));
blood->set("long",HIM"雅典娜自杀所留下的血滴。\n"NOR);
blood->set_amount(50+random(50));
blood->move(env);
tell_room(env,RED"\n\n地上渐渐渗出数滴血珠，殷红尽赤，在初升的朝阳之下益发的凄厉！\n\n"NOR);
env->set("blood",1);
remove_call_out("give_blood");
call_out("resets",600,env);
}

void resets(object env)
{
if ( query("blood") )
        env->delete("blood");
if ( query("story") )
        env->delete("story");
tell_room(env,RED"地上的鲜血渐渐蒸发在空气中了....\n"NOR);
return;
}

