////////////////////////////////////////////////////////
///////////////snowtu@xmxyj2000优化于2003圣诞////////////
////////////////////////////////////////////////////////
///////////////////////将谜底改为映射Mapping/////////////
////////////////////////////////////////////////////////

#include <ansi.h>
inherit ROOM;

mapping pass = ([
  "一": ({ "下楼来，金钱卜落。", "诸王侯，尽数化作土。", "茫茫苍穹，寥寥众生。", "那破碎的手，怎敌得过千人。", }),
  "二": ({ "问苍天，人在何方？", "春宵漫漫把郎思，对夫书，人难自持。", "直下余干望北云。", }),
  "三": ({ "恨王孙，一直去了。", "春日人难聚。", "那不祥的数字啊！每个人都知道。\n", }),
  "四": ({ "詈冤家，言去难留。", "驷马逝难追，", "坚固的结构因为你的插手而崩塌！", }),
  "五": ({ "悔当初，吾错失口。", "噤口无言语", "狡猾的人们想要平分也是不可能，因为那三人感到不平衡。", }),
  "六": ({ "有上交，无下交。", "歧路交叉无尽头", "那卑鄙的弟弟摇头一变，变作了最强者。", }),
  "七": ({ "皂白何须问，", "难掩心中虑", "山林之间的万兽之王啊，没有几只？", }),
  "八": ({ "分开不用刀。", "劳燕竟分飞，", "当他忽然倒地之时，居然化作了无限！", }),
  "九": ({ "从今莫把仇人靠，", "旭日淹晨雾，", "欲觅丹丸浑无计，", "坚固之中的坚固", }),
]);

string look_door() {
  int i, j, num;
  string msg, *ps_msg;
  object door, me;
  door = this_object();
  me = this_player();
  msg = "一扇金制的大门，上面铸刻只巨大的牛。下面写着奇怪的话：\n" YEL "\n";

  for (i = 1; i < 10; i++) {
    num = 1 + random(8);
    door->set("密码/" + i, num);
    door->save();
    ps_msg = pass[chinese_number(num)];
    if (ps_msg)
      msg += HIR + ps_msg[random(sizeof(ps_msg))] + "\n" NOR;
  }
  msg += YEL "\n
最下方是九个坚硬的石板，石板下方分别刻着数字，看来好似可以按(push)下去。\n
┏━━┓ ┏━━┓ ┏━━┓ ┏━━┓ ┏━━┓ ┏━━┓ ┏━━┓ ┏━━┓ ┏━━┓
┃ ① ┃ ┃ ② ┃ ┃ ③ ┃ ┃ ④ ┃ ┃ ⑤ ┃ ┃ ⑥ ┃ ┃ ⑦ ┃ ┃ ⑧ ┃ ┃ ⑨ ┃
┗━━┛ ┗━━┛ ┗━━┛ ┗━━┛ ┗━━┛ ┗━━┛ ┗━━┛ ┗━━┛ ┗━━┛\n" NOR;

  msg = replace_string(msg, "①", NOR HIY "①" NOR YEL);
  msg = replace_string(msg, "②", NOR HIY "②" NOR YEL);
  msg = replace_string(msg, "③", NOR HIY "③" NOR YEL);
  msg = replace_string(msg, "④", NOR HIY "④" NOR YEL);
  msg = replace_string(msg, "⑤", NOR HIY "⑤" NOR YEL);
  msg = replace_string(msg, "⑥", NOR HIY "⑥" NOR YEL);
  msg = replace_string(msg, "⑦", NOR HIY "⑦" NOR YEL);
  msg = replace_string(msg, "⑧", NOR HIY "⑧" NOR YEL);
  msg = replace_string(msg, "⑨", NOR HIY "⑨" NOR YEL);

  me->set_temp("sds5/passwd", 1);
  me->delete_temp("金牛宫/按");
  me->save();
  door->delete("key");
  door->save();
  tell_room(door, YEL "\n\n轰隆一声，九块石板重新凸了出来。\n\n" NOR);
  return msg;
}

void create() {
  set("short", HIY "金牛宫" NOR "深处");
  set("long", @LONG

金牛宫深处，长长的甬道一直向前延伸至无尽的黑
暗之中。
走到尽头是一扇大门(door)，门的那头就通向下一
宫--双子宫。
可是现在大门紧闭，眼前已经失去了敌人的踪影。

LONG);
  set("item_desc", ([
    "door": (: look_door :),
    "门": (: look_door :),
  ]));
  set("no_clean_up", 1);
  set("no_fight", 1);
  set("no_magic", 1);
  set("key", 0);
  setup();
}

void init() {
  object me = this_player();
  add_action("do_push", "push");
  add_action("do_push", "an");
  return;
}

int do_push(string arg) {
  int num, key;
  string msg, str, number;
  object me = this_player();
  object ob = this_object();

  if (!arg && arg != "一" && arg != "二" && arg != "三" && arg != "四" && arg != "五" && arg != "六" && arg != "七" && arg != "八" && arg != "九")
    return notify_fail("请按你想按的数字：( 一～九 )\n");

  if (ob->query("opened")) {
    if (ob->query("open_human") != me)
      return notify_fail("门已经开了，可惜不是你开的，等更新吧。\n");
    else
      return notify_fail("门已经开了，快去追赶吧。\n");
  }

  if (me->query_temp("金牛宫/按") > 3) {
    message_vision("$N想得脑浆都冒出来了，还是一点头绪也没，不由长叹一声，放弃了。\n", me);
    me->command("look door");
    return 1;
  }
  if (me->is_busy())
    return notify_fail("你忙着呢。\n");

  num = ob->query("key");
  num += 1;
  str = ob->query("密码/" + num);

  switch (arg) {
    case "一": number = "①"; break;
    case "二": number = "②"; break;
    case "三": number = "③"; break;
    case "四": number = "④"; break;
    case "五": number = "⑤"; break;
    case "六": number = "⑥"; break;
    case "七": number = "⑦"; break;
    case "八": number = "⑧"; break;
    case "九": number = "⑨"; break;
    case "1": number = "①"; arg = "一"; break;
    case "2": number = "②"; arg = "二"; break;
    case "3": number = "③"; arg = "三"; break;
    case "4": number = "④"; arg = "四"; break;
    case "5": number = "⑤"; arg = "五"; break;
    case "6": number = "⑥"; arg = "六"; break;
    case "7": number = "⑦"; arg = "七"; break;
    case "8": number = "⑧"; arg = "八"; break;
    case "9": number = "⑨"; arg = "九"; break;
  }

  msg = "$N看了看第" YEL + chinese_number(num) + NOR "块石板，朝" HIY + number + NOR "上按去。\n";

  if (arg == chinese_number(str)) {
    msg += "只听“吧嗒”一声，第" + YEL + chinese_number(num) + NOR "块石板陷了进去。\n";
    message_vision(msg, me);
    me->delete_temp("金牛宫/按");
    ob->add("key", 1);
  } else {
    msg += "结果第" + YEL + chinese_number(num) + NOR "块石板没有任何反应。重新再来一次吧。\n";
    message_vision(msg, me);
  }

  me->add_temp("金牛宫/按", 1);
  me->start_busy(1 + random(2));
  ob->save();
  me->save();

  if (ob->query("key") >= 9) {
    message_vision("轰隆一声，大门打开了。\n", me);
    msg = WHT "【" NOR HIB "圣战" NOR HIY "十二宫" NOR HIB "之卷" NOR WHT "】" NOR;
    msg += HIC + "$1($i)：" NOR;
    msg = replace_string(msg, "$1", "童虎");
    msg = replace_string(msg, "$i", "Dohko");
    msg += HIW + me->query("name") + NOR HIC "打开了金牛宫の扉！\n" NOR;
    message("channel:chat", msg, users());
    ob->set("exits/south", __DIR__ "jn2sz2");
    ob->set("opened", 1);
    ob->set("open_human", me);
    ob->save();
    call_out("resets", 12, ob);
  }
  return 1;
}

void resets(object ob) {
  tell_room(ob, "轰的一声，大门关上了！\n");
  ob->delete("exits");
  ob->delete("key");
  ob->delete("opened");
  ob->delete("open_human");
  ob->save();
  return;
}

int valid_leave(object me, string dir) {
  object ob = this_object();
  if (!userp(me)) return 1;
  if (ob->query("opened")) {
    if (dir == "south" && me != ob->query("open_human"))
      return notify_fail("虽然门开了，但是不是你开的。\n");
  }
  return ::valid_leave(me, dir);
}
