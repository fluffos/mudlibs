//jn2sz2.c

inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "山路");
  set("long", @LONG

这是走向双子宫的路上，只见前面可以看到美丽的双子宫耸立在奥林
匹亚峰上！云雾中隐隐约约还可以看见山下的金牛宫。

LONG);

  set("exits", ([
    "eastup": __DIR__ "jn2sz3",
  ]));
  set("outdoors", "12gong");
  setup();
}

int valid_leave(object me, string dir) {
  object mu;
  if (dir == "eastup") {
    if (!mu = present("mu"))
      return notify_fail("还是等等穆先生吧。\n");
    else if (userp(me) && me->query("sds5/jinniu2") != "done")
      return notify_fail("你一阵迷茫。\n");
    else return 1;
  }
  return ::valid_leave(me, dir);
}

void human(object me, object where) {
  object mu;
  if (!present(me, where))
    return;
  if (present("mu", where))
    return;
  mu = find_object("/d/sds5/12gong/npc/baiyang");
  if (!mu)
    mu = new(__DIR__ "npc/baiyang");
  mu->move(where);
  message_vision("穆走了过来。\n", me);
  call_out("check", 5, where, me);
  return;
}

void check(object ob, object me) {
  object mu, npc;
  if (!me || !userp(me) || present("nipunoen"))
    return;
  mu = present("mu", ob);
  if (!mu || userp(mu)) {
    tell_object(me, "还是等等穆先生吧。\n");
    call_out("human", 120, me, this_object());
    return;
  }
  if (me->query("sds5/jinniu2") == "done") return;
  npc = new(__DIR__ "npc/dian");
  message_vision("忽然四周一静，一个人影猛的从黑暗中窜出！\n", me);
  npc->move(ob);
  npc->command("heihei");
  npc->command("say 故意慢行一步就是等你们的到来，什么狗屁" + me->query("cloth_name") + "座圣斗士，在我家里就是一具死尸！\n");
  npc->kill_ob(me);
  me->kill_ob(npc);
  return;
}

int block_cmd(string args) {
  string verb;
  verb = query_verb();
  if (verb == "cast" || verb == "move" || verb == "surrender" ||
    verb == "ji" || verb == "fight" || verb == "apply" ||
    verb == "bian" || verb == "fly" || verb == "map") {
    tell_object(this_player(), "你不由感到一阵迷茫。\n");
    return 1;
  }
  return 0;
}

void init() {
  object ob = this_object();
  object me = this_player();

  if (!userp(me))
    return;
  add_action("block_cmd", "", 1);
  remove_call_out("check");
  call_out("check", 5, ob, me);
  return;
}
