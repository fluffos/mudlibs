//金羊座 里昂，穆先生之师，前教皇
//snowtu@XMxyj

#include <ansi.h>
inherit NPC;
#include "star.h"

void create() {
  set_name("里昂", ({ "leon" }));
  //set("long", HIW"传说中的金羊宫黄金战士，前教皇，在黄道12宫一篇中为亚历士所害。\n"NOR);
  set("gender", "男性");
  //set("title", HIY"金羊宫黄金圣斗士"NOR);
  set("age", 30);
  set("attitude", "friendly");
  set("con", 30);
  set("per", 30);
  set("str", 25);
  set("int", 40);
  set("combat_exp", 125000000);
  set("daoxing", 125000000);
  set_skill("dodge", 600);
  set_skill("force", 600);
  set_skill("parry", 600);
  set_skill("unarmed", 600);
  set_skill("shengdou", 600);
  set_skill("stars-steps", 600);
  set_skill("moonforce", 600);
  set_skill("moonshentong", 600);
  map_skill("parry", "shengdou");
  map_skill("dodge", "stars-steps");
  map_skill("unarmed", "shengdou");
  map_skill("spells", "moonshentong");
  map_skill("force", "moonforce");

  set("max_force", 8000);
  set("force", 16000);
  set("max_mana", 8000);
  set("mana", 16000);
  set("mana_factor", 350);
  set("force_factor", 200);
  set("max_kee", 70000);
  set("max_gin", 70000);
  set("max_sen", 70000);
  setup();
  carry_object(__DIR__ "obj/evl_cloth")->wear();
}

void kill_ob(object me) {
  int damage, lvl, r_lvl, skill, i;
  object ob = this_object();

  if (!present(me, environment())) {
    ob->delete_temp("my_killer");
    return;
  }

  if (me->is_ghost() || !me->is_fighting(ob)) {
    ob->delete_temp("my_killer");
    return;
  }

  switch (random(6)) {
    case 0:
      {
        message_vision(HIC "「星光灭绝」$N双手一挥，一团银芒直冲$n而去！\n", ob, me);
        if (random(2)) {
          message_vision(HIC "$N被$n的银芒刺得遍体鳞伤！\n" NOR, me, ob);
          me->add("eff_kee", -query("max_kee") / 50);
          me->add("eff_sen", -query("max_sen") / 50);
          kill_ob(me);
        } else {
          message_vision(HIR "$N轻而易举的躲过了$n的攻击！\n" NOR, me, ob);
        }
      }
      break;

    case 1:
      {
        r_lvl = random(5);
        if (r_lvl > 3) lvl = 3;
        if (r_lvl < 1) r_lvl = 1;
        message_vision(HIW "$N大喝一声“水晶墙！”在自己面前布出一面透明的气墙，$n的攻击立刻被反弹回去！\n" NOR, ob, me);
        for (i = 0; i < r_lvl; i++)
          COMBAT_D->do_attack(me, me, me->query_temp("weapon"));
        break;
      }

    case 2:
      {
        message_vision(HIR "$N运起[星屑旋转功],黄金斗气冲向$n \n", ob, me);
        if (random(2)) {
          message_vision(HIR "$N被[星屑旋转功]击中,顿时血流如注，顷刻染红了全身！\n" NOR, me);
          me->add("eff_kee", -3 * query("max_kee") / 30);
          me->add("eff_sen", -3 * query("max_sen") / 30);
        } else {
          message_vision(HIR "$N看准黄金斗气的方向，纵身跃起，躲过这致命一击！\n" NOR, me);
        }
      }
      break;
  }

  if (random(20) == 1)
    powerup();
  remove_call_out("kill_ob");
  call_out("kill_ob", 1 + random(9), me);
}

void end(object me, object ob, object npc) {
  object mu;
  string title = WHT "【" NOR HIB "圣战" NOR HIY "十二宫" NOR HIB "之卷" NOR WHT "】" NOR;

  if (!ob || !npc || environment(ob) != environment(me))
    return;
  ob->command("hmm");
  npc->command("say 我们两已经二百年没交过手了...\n");
  npc->command("say " + me->query("name") + ",我在此缠住他，你和穆去追阿布罗狄、迪斯马斯克。\n");
  mu = present("mu", environment(ob));
  if (!mu || userp(mu)) {
    mu = new(__DIR__ "baiyang");
    mu->move(environment(ob));
  }
  mu->command("ok");
  mu->command("follow " + me->query("id"));

  title += HIC + "$1($i)：" NOR;
  title = replace_string(title, "$1", "童虎");
  title = replace_string(title, "$i", "Dohko");
  message("channel:chat", title + HIW + me->name() + HIC "闯过了金羊座的里昂！\n" NOR, users());
  me->add("daoxing", 300000);
  tell_object(me, "你赢得了三百年道行。\n");
  me->set("sds5/baiyang", "done");
  me->command("northup");
  destruct(npc);
  destruct(ob);
  return;
}

void gift(object me, object ob) {
  object npc;
  if (environment(ob) != environment(me))
    return;
  npc = new("/d/sds5/lushan/npc/tonghu");
  npc->move(environment(ob));
  message_vision("$n正警惕的望着$N，童虎老师忽然出现在你的面前！\n", ob, me);
  npc->command("pat " + me->query("id"));
  call_out("end", 3 + random(5), me, ob, npc);
}

void die() {
  object ob = this_object();
  object me = ob->query_temp("last_opponent");
  powerup();

  if (!me || !present(me, environment(ob)))
    return;

  if (random(10) == 1) {
    say(HIB "\n" + name() + HIB "点了点头：不错不错，再来再来！\n" NOR);
    me->kill_ob(ob);
    ob->kill_ob(me);
    return;
  }

  me->remove_killer(ob);
  ob->remove_killer(me);

  me->start_busy(3);

  ob->command("great");
  ob->command("say 果真是后浪推前浪。。。\n");

  if (me->query("sds5/baiyang2") == "done" && me->query("sds5/baiyang") != "done") {
    call_out("gift", 3 + random(5), me, ob);
    return;
  }
  message_vision(HIW "$N化作尘土消失在夜风中！\n" NOR, ob);
  destruct(ob);
  return;
}
