#include <ansi.h>
inherit NPC;

void powerup();

void create() {
  set_name("魔铃", ({ "marin" }));
  set("long", WHT "星矢在希腊圣域的师父，时常鼓励垂危的星矢。她更被星矢怀疑是自已的姊姊星华。\n" NOR);
  set("gender", "女性");
  set("title", HIC "天鹰座" NOR WHT "白银圣斗士" NOR);
  set("age", 18);
  set("attitude", "friendly");
  set("con", 30);
  set("per", 30);
  set("str", 25);
  set("int", 40);
  set("combat_exp", 10000000);
  set("daoxing", 10000000);
  set_skill("dodge", 500);
  set_skill("force", 500);
  set_skill("parry", 500);
  set_skill("unarmed", 500);
  set_skill("shengdou", 500);
  set_skill("stars-steps", 500);
  set_skill("moonforce", 500);
  set_skill("moonshentong", 350);
  map_skill("parry", "shengdou");
  map_skill("dodge", "stars-steps");
  map_skill("unarmed", "shengdou");
  map_skill("spells", "moonshentong");
  map_skill("force", "moonforce");

  set("max_force", 7500);
  set("force", 15000);
  set("max_mana", 7500);
  set("mana", 15000);
  set("mana_factor", 250);
  set("force_factor", 250);
  set("max_kee", 4000);
  set("max_gin", 4000);
  set("max_sen", 4000);
  setup();
  carry_object(__DIR__ "obj/ty_cloth")->wear();
}

void kill_ob(object me) {
  int damage, lvl, r_lvl, skill, i;
  object ob = this_object();
  damage = ob->query_skill("shengdou", 1);
  damage += ob->query_skill("unarmed");
  damage += ob->query("force_factor");
  damage = damage / 2 + random(damage / 2);

  if (!present(me, environment())) {
    ob->delete_temp("my_killer");
    return;
  }

  if (me->is_ghost() || !me->is_fighting(ob)) {
    ob->delete_temp("my_killer");
    return;
  }

  switch (random(8)) {
    case 1: {
      powerup();
    }
    break;

    case 4:
      {
        message_vision(HIC "\n「神鹰爪」\n$N双手一挥，带着呼啸的风声直冲$n而去！\n", ob, me);
        if (random(2)) {
          message_vision(HIR "$N" HIR "被$n的双爪抓得遍体鳞伤！\n" NOR, me, ob);
          me->receive_damage("kee", damage);
          me->receive_wound("kee", damage / 2);
          COMBAT_D->report_status(me);
        } else message_vision(HIR "$N轻而易举的躲过了$n的攻击！\n" NOR, me, ob);
      }
      break;

    case 5:
      {
        skill = (int)ob->query_skill("shengdou", 1);
        lvl = skill / 100;
        r_lvl = random(lvl);
        if (r_lvl > 3) lvl = 3;
        if (r_lvl < 1) r_lvl = 1;
        message_vision(HIC "$N大喝一声“流星拳空拳！”双拳舞动，招招不离$n" HIC "的要害！\n" NOR, ob, me);
        for (i = 1; i < r_lvl; i++) {
          message_vision(HIC "\n第" + chinese_number(i) + HIC "拳! \n" NOR, ob, me);
          COMBAT_D->do_attack(ob, me, ob->query_temp("weapon"));
        }
        break;
      }
  }
  kill_ob(me);
}

void die() {
  object ob = this_object();
  object me = ob->query_temp("last_opponent");
  message_vision(WHT "$N擦了擦嘴角的鲜血，娇喝一声，就继续战斗！\n" NOR, ob);
  powerup();
  kill_ob(me);
}

void unconcious() {
  die();
}

void powerup() {
  object me = this_object();
  random(2) ? me->command_function("say 燃烧吧，小宇宙！\n") : me->command_function("say 小宇宙！爆发吧！\n");
  me->set("kee", query("max_kee"));
  me->set("eff_kee", query("max_kee"));
  me->set("sen", query("max_sen"));
  me->set("eff_sen", query("max_sen"));
  me->set("force", query("max_force"));
  me->set("mana", query("max_mana"));
  me->clean_condition();
  return;
}
