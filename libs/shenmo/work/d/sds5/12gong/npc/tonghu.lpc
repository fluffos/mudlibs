  set("gender", "男性");
  set("title", HIW "天秤座" HIY "黄金圣斗士" NOR);
  set("age", 1000);
  set("con", 30);
  set("per", 30);
  set("str", 25);
  set("int", 35);
  set("combat_exp", 40000000);
  set_skill("dodge", 330);
  set_skill("force", 330);
  set_skill("parry", 330);
  set_skill("unarmed", 330);
  set_skill("shengdou", 330);
  set_skill("lushan-quan", 330);
  set_skill("stars-steps", 330);
  set_skill("dragonforce", 330);
  set_skill("seashentong", 330);
  map_skill("parry", "shengdou");
  map_skill("dodge", "stars-steps");
  map_skill("unarmed", "lushan-quan");
  map_skill("spells", "seashentong");
  map_skill("force", "dragonforce");

  set("max_force", 5000);
  set("force", 10000);
  set("max_mana", 5000);
  set("mana", 10000);
  set("mana_factor", 150);
  set("force_factor", 150);
  set("max_kee", 6000);
  set("max_gin", 6000);
