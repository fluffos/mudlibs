#include <ansi.h>
inherit NPC;
#include "three_star.h"
 
void create()
{
set_name("卡妙", ({"kamus", "shui ping"}));
set("long", "冰河的师祖。十二宫之战中为让冰河领悟第七感，被冰河杀死。富有牺牲精神的黄金圣斗士,守护着水瓶座.\n");
set("gender","男性");
set("title", HIC"水瓶座"HIY"黄金圣斗士"NOR);
set("age",37);
set("con",55);
set("per",30);
set("str",73);
set("int",64);
set("combat_exp",300000000);
set("daoxing",300000000);
set_skill("dodge",650);
set_skill("force",650);
set_skill("parry",650);
set_skill("unarmed",650);
set_skill("shengdou",650);
set_skill("stars-steps",650);
set_skill("moonforce",650);
set_skill("moonshentong",650);
map_skill("parry","shengdou");
map_skill("dodge","stars-steps");
map_skill("unarmed","shengdou");
map_skill("spells","moonshentong");
map_skill("force","moonforce");

set("max_force", 8000);
set("force", 16000);
set("max_mana",8000);
set("mana",16000);
set("mana_factor",500);
set("force_factor",200);
set("max_kee", 80000);
set("max_gin", 80000);
set("max_sen", 80000);

setup();
carry_object(__DIR__"obj/evl_cloth")->wear();
}

void init()
{
add_action("do_pfm","perform");
add_action("do_cast","cast");
add_action("do_none","ji");
add_action("do_none","move");
add_action("do_none","surrender");
add_action("do_none","fight");
add_action("do_none","shoot");
}

void kill_ob(object me)
{
object ob=this_object();

if(! present(me,environment()) )
        {
        powerup();
        me->remove_killer(ob);
        ob->remove_killer(me);
        return;
        }
     
if( me->is_ghost() || !userp(me) )
        {
        powerup();
        me->remove_killer(ob);
        ob->remove_killer(me);
        return;
        }
     
set("chat_chance_combat",80);
set("chat_msg_combat", ({
        (: perform_action, "unarmed", "zsxc" :),
        (: perform_action, "unarmed", "sgnszks" :),
}) );
::kill_ob(me);
}


