#include <ansi.h>
inherit NPC;
 
void powerup();

void create()
{
string msg;
set_name(HIY"神像"NOR HIB"护卫"NOR, ({"statue guard","guard"}));
set("long", HIY"雅典娜神像的守护之神，积聚了三千年神之力的虚无之物。\n"NOR);
set("gender",random(2)?"男性":"女性");
msg = HIY+@LONG
                                                 __----~~~~~~~~~~~------___
                                      .  .   ~~//====......          __--~ ~~
                      -.            \_|//     |||\\  ~~~~~~::::... /~
                   ___-==_       _-~o~  \/    |||  \\            _/~~-
           __---~~~.==~||\=_    -_--~/_-~|-   |\\   \\        _/~
       _-~~     .=~    |  \\-_    '-~7  /-   /  ||    \      /
     .~       .~       |   \\ -_    /  /-   /   ||      \   /
    /  ____  /         |     \\ ~-_/  /|- _/   .||       \ /
    |~~    ~~|--~~~~--_ \     ~==-/   | \~--===~~        .\
             '         ~-|      /|    |-~\~~       __--~~
                         |-~~-_/ |    |   ~\_   _-~            /\
                              /  \     \__   \/~                \__
                          _--~ _/ | .-~~____--~-/                  ~~==.
                         ((->/~   '.|||' -_|    ~~-/ ,              . _||
                                    -_     ~\      ~~---l__i__i__i--~~_/
                                    _-~-__   ~)  \--______________--~~
                                  //.-~~~-~_--~- |-------~~~~~~~~
                                         //.-~~~--\
LONG+NOR;
msg = replace_string(msg,"o",NOR BLINK RED"o"NOR HIY);
set("title",msg);
set("age",25+random(1000));
set("con",40);
set("per",40);
set("str",40);
set("int",40);
set("combat_exp",300000000);
set("daoxing",300000000);
set("任务",1);
set_skill("dodge",600);
set_skill("force",600);
set_skill("parry",600);
set_skill("unarmed",600);
set_skill("shengdou",600);
set_skill("stars-steps",600);
set_skill("moonforce",600);
set_skill("moonshentong",600);
map_skill("parry","shengdou");
map_skill("dodge","stars-steps");
map_skill("unarmed","shengdou");
map_skill("spells","moonshentong");
map_skill("force","moonforce");

set("max_force", 8000);
set("force", 16000);
set("max_mana",8000);
set("mana",16000);
set("mana_factor",500);
set("force_factor",200);
set("max_kee", 9000);
set("max_gin", 9000);
set("max_sen", 9000);
setup();
set_temp("apply/armor",800);
set_temp("apply/damage",300);
}

void init()
{
object me=this_player();
::init();
if( !me || !visible(me) || environment(me) != environment() ) return;
add_action("do_pfm","perform");
add_action("do_cast","cast");
add_action("do_none","ji");
add_action("do_none","move");
add_action("do_none","surrender");
add_action("do_none","fight");
add_action("do_none","shoot");
}

void kill_ob(object me)
{
object ob=this_object();

if ( !me ) { powerup();return; }
            
if( !present(me,environment()) )
        {
        powerup();
        me->remove_killer(ob);
        ob->remove_killer(me);
        return;
        }
     
if( me->is_ghost() || !userp(me) )
        {
        powerup();
        me->remove_killer(ob);
        ob->remove_killer(me);
        return;
        }
if ( ob->is_fighting(me) && ( me->query("kee")<150 || me->query("sen")<150 )   ) 
        {
        powerup();
        me->remove_killer(ob);
        ob->remove_killer(me);
        say(ob->name()+"哈哈一笑，拱手笑道：承让承让，这位"+RANK_D->query_respect(me)+"还需努力。\n");
        if ( me->query("kee")<150 ) me->set("kee",150);
        if ( me->query("eff_kee")<150 ) me->set("eff_kee",150);
        return;
        }

set("chat_chance_combat",80);
set("chat_msg_combat", ({
        (: perform_action, "unarmed", "bmg" :),
        (: perform_action, "unarmed", "flcz" :),
        (: perform_action, "unarmed", "hjynq" :),
        (: perform_action, "unarmed", "hmg" :),
        (: perform_action, "unarmed", "jsqmjb" :),
        (: perform_action, "unarmed", "jxdz" :),
        (: perform_action, "unarmed", "jxhj" :),
        (: perform_action, "unarmed", "mhblq" :),
        (: perform_action, "unarmed", "mhfxq" :),
        (: perform_action, "unarmed", "sdb" :),
        (: perform_action, "unarmed", "sgnszks" :),
        (: perform_action, "unarmed", "sj" :),
        (: perform_action, "unarmed", "syq" :),
        (: perform_action, "unarmed", "xcdy" :),
        (: perform_action, "unarmed", "zsxc" :),
}) );
::kill_ob(me);
}

void gift_chat(object me,string arg)
{
string msg = WHT"【"NOR HIG" 圣 战 "NOR  WHT"】"NOR;
msg+= HIY"$N($I)：$n($i)解开黑夜的十二宫之谜，特奖励$W。\n"NOR;
msg = replace_string(msg,"$N","里昂");
msg = replace_string(msg,"$I","Leon");
msg = replace_string(msg,"$n",me->query("name"));
msg = replace_string(msg,"$i",capitalize(me->query("id")));
msg = replace_string(msg,"$W",NOR+HIG+arg+NOR+HIY);
message("channel:chat",msg,users());
return;
}

void gift_wx(object me,object ob)
{
int num;
if ( !me || !ob || !present(me,environment(ob)) )
        return;
if ( me->query("sds5/gift1") )
        return;
me->set("sds5/gift1",1);
num = 100000+random(400000);
gift_chat(me,chinese_number(num)+"点武学");
me->add("combat_exp",num);
me->save();
tell_object(me,HIY"你得到了奖励，你的武学上升了"+chinese_number(num)+"点。\n"NOR);
destruct(ob);
return;
}

void gift_dx(object me,object ob)
{
int num;
if ( !me || !ob || !present(me,environment(ob)) )
        return;
if ( me->query("sds5/gift1") )
        return;

me->set("sds5/gift1",1);

num = 100000+random(400000);
gift_chat(me,COMBAT_D->chinese_daoxing(num)+"道行");
me->add("daoxing",num);
me->save();
tell_object(me,HIY"你得到了"+COMBAT_D->chinese_daoxing(num)+"道行。\n"NOR);
destruct(ob);
return;
}

void gift_pot(object me,object ob)
{
int num;
if ( !me || !ob || !present(me,environment(ob)) )
        return;
if ( me->query("sds5/gift1") )
        return;

me->set("sds5/gift1",1);

num = 1000000+random(4000000);
gift_chat(me,chinese_number(num)+"点潜能");
me->add("potential",num);
me->save();
tell_object(me,HIY"你得到了"+chinese_number(num)+"点潜能。\n"NOR);
destruct(ob);
return;
}

void gift_sk(object me,object ob)
{
int size,i,num;
string name,skill,*strs; 
mapping skills = me->query_skills();

if ( !me || !ob || !present(me,environment(ob)) )
        return;
if ( me->query("sds5/gift1") )
        return;

me->set("sds5/gift1",1);

strs = keys(skills);
size = random(sizeof(strs));
skill = strs[size];
i = me->query_skill(skill,1);
num = 1+random(9);
name = to_chinese(skill);
gift_chat(me,chinese_number(num)+"级"+name);
me->set_skill(skill,i+num);
me->save();
tell_object(me,HIY"你得到了"+chinese_number(num)+"级"+name+"。\n"NOR);
destruct(ob);
return;
}

void die()
{
string name;
object ob = this_object();
object me = ob->query_temp("last_opponent");
object where = environment(ob);
powerup();
if ( environment(me)!=where || !me || !userp(me) || where->query("short")!=HIY"雅典娜神像"NOR )
        return;
if ( random(10)==1 )
	{
	say(HIY"\n"+name()+HIY"点了点头：不错不错，再来再来！\n"NOR);
	me->kill_ob(ob);
	ob->kill_ob(me);
	return;
	}


me->remove_killer(ob);
ob->remove_killer(me);

if ( me->query("sds5/all")=="done" && me->query("sds5/guard")!="done" )
        {
        message_vision("$n欣慰的说道：圣衣交给你又有何妨？\n说罢$n又化作青烟依附在神像上。",me,ob);
        me->start_busy(5);
        me->set("sds5/guard","done");
        me->save();
        switch(random(4))
                {
                case 1:call_out("gift_sk",1,me,ob);break;
                case 2:call_out("gift_pot",1,me,ob);break;
                case 3:call_out("gift_wx",1,me,ob);break;
                default:call_out("gift_dx",1,me,ob);break;
                }
        return;
        }
destruct(ob);
return;
}

void heart_beat()
{
::heart_beat();

if ( query("kee")<10 || query("sen")<10 )  die();
if ( query("kee") < (query("eff_kee")-10) )
        command("exert recover");
if ( query("sen") < (query("eff_sen")-10) ) 
        command("exert refresh");
if ( query("eff_kee")<query("max_kee") && random(20)==1 )
        powerup();
if ( query_condition("dashouyin") )  this_object()->apply_condition("dashouyin",0);
}

void unconcious()
{
  die();
}

void powerup()
{
object me = this_object();
random(2)?
message("vision",me->name()+WHT"深深吸了几口气，脸色看起来好多了。"NOR,environment(me),me):
message("vision",me->name()+MAG"略一凝神，吸了口气，精神看起来清醒多了。"NOR,environment(me),me);
me->set("kee",query("max_kee"));
me->set("eff_kee",query("max_kee"));
me->set("sen",query("max_sen"));
me->set("eff_sen",query("max_sen"));
me->set("force",query("max_force"));
me->set("mana",query("max_mana"));
me->clean_condition();
return;
}

int do_pfm(string arg)
{
if ( random(10)==1 )  powerup();
return 0;
}

int do_cast(string arg)
{
string args;
if ( arg=="huimeng" || arg=="qiankun" || arg=="yinshen" )
        return 1;
else  if ( sscanf(arg, "on %s",args)==1 && (arg=="huimeng"||arg=="qiankun"||arg=="yinshen") )
        return 1;
if ( random(10)==1 ) powerup();
return 0;
}

