inherit NPC;
#include <ansi.h>
#include "star.h"
#include "die.h"

void create() {
  set_name("迪斯马斯克", ({ "death mask", "mask", "ju xie" }));
  set("long", HIB "巨蟹座黄金圣斗士。最卑鄙无耻的黄金圣斗士，杀人无数。\n" NOR);
  set("gender", "男性");
  set("title", HIB "巨蟹座斗士" NOR);
  set("age", 37);
  set("con", 30);
  set("spi", 40);
  set("per", 30);
  set("str", 25);
  set("int", 35);
  set("combat_exp", 95000000);
  set("daoxing", 95000000);
  set_skill("dodge", 500);
  set_skill("force", 500);
  set_skill("parry", 500);
  set_skill("unarmed", 500);
  set_skill("shengdou", 500);
  set_skill("stars-steps", 500);
  set_skill("moonforce", 500);
  set_skill("moonshentong", 500);

  map_skill("parry", "shengdou");
  map_skill("dodge", "stars-steps");
  map_skill("unarmed", "shengdou");
  map_skill("spells", "moonshentong");
  map_skill("force", "moonforce");

  set("max_force", 7500);
  set("force", 14000);
  set("max_mana", 7500);
  set("mana", 14000);
  set("mana_factor", 400);
  set("force_factor", 250);
  set("max_kee", 50000);
  set("max_gin", 50000);
  set("max_sen", 50000);
  set_temp("apply/damage", 150);
  set_temp("apply/armor", 200);
  setup();
  carry_object(__DIR__ "obj/evl_cloth")->wear();
}

void kill_ob(object me) {
  object ob = this_object();
  if (!present(me, environment())) {
    me->remove_killer(ob);
    ob->remove_killer(me);
    powerup();
    return;
  }

  if (me->is_ghost() || !userp(me)) {
    me->remove_killer(ob);
    ob->remove_killer(me);
    powerup();
    return;
  }

  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed", "jsqmjb" :),
  }));
  if (random(10) == 1)
    powerup();
  ::kill_ob(me);
}
