/**********************************************************************************************/
/*                        巴比隆 地妖星座的冥界之蝶 蚕丝，冥届之蝶                              */
/*能因应敌人的力量而进化成最强的蝴蝶型态，他同时是念力的高手，在巨蟹宫与穆先生激战，但最後被穆打败。 */
/**********************************************************************************************/

#include <ansi.h>
inherit NPC;
#include "star.h"

void hudie(object ob);

void create() {
  set_name("巴比隆", ({ "babilon", "di yao" }));
  set("title", HIB "地" NOR HIM "妖" NOR WHT "星" NOR);
  set("long", "地妖星座的冥界之" HIB "蝶" NOR "。\n
能因应敌人的力量而进化成最强的蝴蝶型态，他同时是念力的高手。\n");
  set("gender", "男性");
  set("age", 20);
  set("con", 30);
  set("per", 10);
  set("str", 25);
  set("int", 40);
  set("dead", 2 + random(2));
  set("combat_exp", 200000000);
  set("daoxing", 200000000);
  set_skill("dodge", 500);
  set_skill("force", 500);
  set_skill("parry", 500);
  set_skill("unarmed", 500);
  set_skill("mingwang-quan", 500);
  set_skill("ghostdance", 500);
  set_skill("ghostforce", 500);
  set_skill("ghostspells", 500);
  map_skill("parry", "mingwang-quan");
  map_skill("dodge", "ghostdance");
  map_skill("unarmed", "mingwang-quan");
  map_skill("spells", "ghostspells");
  map_skill("force", "ghostforce");
  set("max_force", 9000);
  set("force", 18000);
  set("max_mana", 9000);
  set("mana", 18000);
  set("mana_factor", 450);
  set("force_factor", 250);
  set("max_kee", 80000);
  set("max_gin", 80000);
  set("max_sen", 80000);
  setup();
  carry_object(__DIR__ "obj/evl_cloth")->wear();
}

void heart_beat() {
  int time;
  string msg;
  object ob = this_object();
  object where = environment();
  ::heart_beat();

  if (where && living(ob) && where->query("short") != HIY "第四宫" HIB "巨蟹座" NOR) {
    command("say 待我去将雅典娜的头颅取来！\n");
    say(YEL + ob->name() + YEL "朝地下一钻，消失不见了！\n" NOR);
    ob->move("/d/sds5/12gong/shuangzi");
    return;
  }
  if (!is_fighting() && query("eff_kee") >= query("max_kee")
    && query("eff_kee") < query("max_kee") && random(2) == 1)
    command("exert heal");

  if (query("kee") < (query("eff_kee") - 10))
    command("exert recover");

  if (query("sen") < (query("eff_sen") - 10))
    command("exert refresh");
}

void kill_ob(object me) {
  object ob = this_object();

  if (query("变形")) {
    ob->remove_killer(me);
    me->remove_killer(ob);
    powerup();
    return;
  }

  if (!present(me, environment())) {
    powerup();
    ob->remove_killer(me);
    me->remove_killer(ob);
    return;
  }

  if (me->is_ghost() || !me->is_fighting(ob)) {
    powerup();
    ob->remove_killer(me);
    me->remove_killer(ob);
    return;
  }

  if (me->query_temp("yinshentime")) {
    me->delete_temp("yinshentime");
    me->delete("env/invisibility");
    me->save();
    me->delete_temp("no_heal_up/yinshen");
    message_vision(HIW "\n白光闪过之后，$N又现出了身形。\n\n" NOR, me);
  }

  set("chat_chance_combat", 100);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed", "cansi" :),
    (: perform_action, "unarmed", "die" :),
  }));
  if (random(20) == 1)
    powerup();
  ::kill_ob(me);
}

void init() {
  object me = this_player();
  ::init();
  add_action("do_pfm", "perform");
  add_action("do_cast", "cast");
  add_action("do_look", "look");
  add_action("do_none", "move");
  add_action("do_none", "surrender");
  add_action("do_none", "ji");
  add_action("do_none", "steal");
  add_action("do_none", "fight");
  add_action("do_none", "shoot");
  if (query("变形"))
    add_action("do_none", "look");
}

int do_none() {
  int damage = random(100);
  object me = this_player();
  object ob = this_object();
  say(ob->name() + "口中吐出一串细丝，" + me->name() + "一个不察，弄得一阵手忙脚乱。\n");
  if (random(3) == 1)
    me->start_busy(random(2));
  me->receive_damage("sen", damage);
  me->receive_damage("kee", damage / 4);
  COMBAT_D->report_sen_status(me);
  return 1;
}

int do_pfm(string arg) {
  string args;
  int damage = random(500);
  object me = this_player();
  object ob = this_object();
  if (arg == "fengchan" || arg == "meihua") {
    message(
      "vision",
      YEL + ob->name() + YEL "口中吐出一串细丝，" + me->name() + YEL "一个不察，弄得一阵手忙脚乱。\n" NOR,
      environment(),
      me
    );
    tell_object(me, CYN "\n" + ob->name() + CYN "腹部一动，朝你吐出一串细丝。\n" NOR);
    if (random(5) == 1) powerup();
    me->receive_damage("sen", damage);
    me->receive_damage("kee", damage / 4);
    COMBAT_D->report_sen_status(me);
    return 1;
  } else if (sscanf(arg, "on %s", args) == 1 && (arg == "fengchan" || arg == "meihua")) {
    message(
      "vision",
      YEL + ob->name() + YEL "口中吐出一串细丝，" + me->name() + YEL "一个不察，弄得一阵手忙脚乱。\n" NOR,
      environment(),
      me
    );
    tell_object(me, CYN "\n" + ob->name() + CYN "腹部一动，朝你吐出一串细丝。\n" NOR);
    if (random(5) == 1) powerup();
    me->receive_damage("sen", damage);
    me->receive_damage("kee", damage / 4);
    COMBAT_D->report_sen_status(me);
    return 1;
  }
  return 0;
}

int do_cast(string arg) {
  string args;
  int damage = random(500);
  object me = this_player();
  object ob = this_object();
  if (arg == "huimeng" || arg == "qiankun" || arg == "yinshen") {
    message(
      "vision",
      YEL + ob->name() + YEL "口中吐出一串细丝，" + me->name() + YEL "一个不察，弄得一阵手忙脚乱。\n" NOR,
      environment(),
      me
    );
    tell_object(me, CYN "\n" + ob->name() + CYN "腹部一动，朝你吐出一串细丝。\n" NOR);
    if (random(5) == 1) powerup();
    me->receive_damage("sen", damage);
    me->receive_damage("kee", damage / 4);
    COMBAT_D->report_sen_status(me);
    return 1;
  } else if (sscanf(
    arg,
    "on %s",
    args
  ) == 1 && (arg == "huimeng" || arg == "qiankun" || arg == "yinshen")) {
    message(
      "vision",
      YEL + ob->name() + YEL "口中吐出一串细丝，" + me->name() + YEL "一个不察，弄得一阵手忙脚乱。\n" NOR,
      environment(),
      me
    );
    tell_object(me, CYN "\n" + ob->name() + CYN "腹部一动，朝你吐出一串细丝。\n" NOR);
    if (random(5) == 1) powerup();
    me->receive_damage("sen", damage);
    me->receive_damage("kee", damage / 4);
    COMBAT_D->report_sen_status(me);
    return 1;
  }
  return 0;
}

void die() {
  int die_num;
  object mu, me, ob;
  string title;
  ob = this_object();
  me = ob->query_temp("last_opponent");

  powerup();

  if (!me || !present(me, environment(ob)))
    return;

  if (random(10) == 1) {
    say(HIB "\n" + name() + HIB "点了点头：不错不错，再来再来！\n" NOR);
    me->kill_ob(ob);
    ob->kill_ob(me);
    return;
  }

  ob->remove_killer(me);
  me->remove_killer(ob);

  ob->add("dead", -1);
  if (ob->query("dead") <= 0)
    ob->set("dead", 0);
  ob->save();

  die_num = ob->query("dead");

  me->start_busy(3);

  if (die_num >= 1) {
    remove_call_out("revive");
    call_out("revive", 1, me, ob);
  } else {
    if (me->query("sds5/shuangzi") == "done" && me->query("sds5/juxie") != "done") {
      title = WHT "【" NOR HIB "圣战" NOR HIY "十二宫" NOR HIB "之卷" NOR WHT "】" NOR;
      message("channel:chat", title + HIW + me->name() + HIC "闯过了地妖星巴比隆！\n" NOR, users());
      me->add("daoxing", 350000);
      me->set("sds5/juxie", "done");
      tell_object(me, "你赢得了三百五十年道行。\n");
      me->save();
    }
    title = WHT "【" NOR HIB "圣战" NOR HIY "十二宫" NOR HIB "之卷" NOR WHT "】" NOR;
    title += HIC + "$1($i)：你...们...等...着...吧，冥王..即...将..归来....\n" NOR;
    title = replace_string(title, "$1", ob->query("name"));
    title = replace_string(title, "$i", "Babilon");
    message("channel:chat", title, users());
    say(ob->name() + "惨叫一声，化作尘埃消失在夜风中！\n");
    destruct(ob);
  }
  return;
}

void revive(object me, object ob) {
  int time;
  object jian;
  if (environment(me) != environment())
    return;
  if (ob->query("变形") > 0)
    return;
  message_vision(HIB "\n\n$N" HIB "运动念力，朝$n" HIB "吐出千万丝线，转眼之间就将$n" HIB "包裹其中！\n\n" NOR, ob, me);
  message_vision(HIB "紧接着，$N摇身化作蛹状！\n" NOR, ob, me);
  ob->set("longs", query("long"));
  ob->set("title", "古怪的");
  ob->set("hiter", me);
  ob->save();
  time = 120 + random(240);
  jian = new("/d/sds5/12gong/npc/obj/jian");
  jian->set("owner", ob);
  jian->set("human", me);
  jian->set("time", time);
  jian->save();
  jian->move(environment());
  me->set_temp("si_time", time);
  me->move(jian);
  tell_object(me, HIB "\n\n你眼前一黑，已经身在丝线之中，难以动弹！\n\n" NOR);
}

int accept_kill(object me) {
  object ob, egg;
  ob = this_object();

  if (ob->query("变形")) {
    if (me = ob->query("hiter")) {
      egg = present("si xian", environment());
      if (!egg || userp(egg)) {
        egg = new(__DIR__ "obj/jian");
        egg->move(environment());
      }
      me->add_temp("si_time", 60);
      egg->set("owner", ob);
      egg->set("human", me);
      egg->save();
      me->move(egg);
      return 1;
    } else {
      tell_object(me, "那不是活物....\n");
      return 1;
    }
  }
  return 0;
}
