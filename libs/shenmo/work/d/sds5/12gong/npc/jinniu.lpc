#include <ansi.h>
inherit NPC;
 
void create()
{
set_name("亚鲁迪巴", ({"aldebaran", "jin niu"}));
set("long", HIY"金牛座。最勇猛凶悍的黄金圣斗士，但经常被招式诡异的对手打败，冥界之战中，与地暗星尼奥比同归于尽。\n"NOR);
set("gender","男性");
set("title", HIY"金牛座黄金圣斗士"NOR);
set("age",37);
set("con",30);
set("per",20);
set("str",30);
set("int",35);
set("combat_exp",5000000);
set("daoxing",2800000);
set("attitude", "friendly");
setup();
carry_object(__DIR__"obj/jn_cloth")->wear();
}
 
void init()
{
object me = this_player();
if ( me->query("sds5/baiyang")=="done"
  && me->query("sds5/jinniu")!="done" )
        {
        add_action("do_touch","touch");
        add_action("do_touch","mo");
        }
add_action("do_look","look");
add_action("do_none","ji");
add_action("do_none","fight");
add_action("do_none","ask");
add_action("do_none","move");
add_action("do_none","kill");
add_action("do_none","steal");
return;
}

int do_look(string arg)
{
string msg;
object mu;
object me = this_player();
object ob = this_object();
if ( id(arg) )
        {
        msg = ob->query("title");
        msg+= ob->query("name");
        msg+="\n"+ob->query("long");
        msg+="他一动不动的站在那儿，对你的言行不闻不问。\n";
        mu = present("mu",environment());
        if ( !mu || userp(mu) )
                return 0;
        tell_object(me,msg);
        mu->command("say 怎么回事？亚鲁迪巴。。。。。。\n");
        mu->command("whisper "+me->query("id")+" 看看亚鲁迪巴出了什么事。\n");
        message_vision("穆警惕的看着四周的环境。\n",me);
        return 1;
        }
return 0;
}

int do_touch(string arg)
{
int damage;
object mu;
object me = this_player();
object ob = this_object();
damage = ob->query("combat_exp");
damage-= me->query("combat_exp");
damage/= 50000;
if ( damage<500 ) damage = 500;
if ( damage>1500 ) damage = 1500;

if ( !arg || !id(arg) )
        return notify_fail("你想摸什么？\n");
if ( me->is_busy() )
        return notify_fail("你现在正忙着呢。\n");

mu = present("mu",environment());
if ( !mu || userp(mu) )
        return notify_fail("还是和穆先生一起比较稳妥。\n");
        
message_vision("$N伸出手去触摸$n的魁梧的身躯。\n",me,ob);
me->start_busy(3+random(7));
call_out("hits",1+random(5),me,ob,mu,damage);
return 1;
}

void hits(object me,object ob,object mu,int damage)
{
message_vision(HIY"$n身上忽然发出万道强光，向着四面八方绽射出去！\n"NOR,me,ob);
message_vision(HIY"$N措手不及，被强光笼罩其内！\n"NOR,me,ob);
me->receive_damage("kee",damage);
me->receive_damage("sen",damage);
COMBAT_D->report_status(me);
COMBAT_D->report_sen_status(me);
message_vision(HIY"强光渐渐黯淡，$n的身躯忽地化作千万的星光散放在空中！\n"NOR,me,ob);
mu->command("say 啊！亚鲁迪巴。。。。。。\n");
message_vision("穆好似略有所思。。。。。。\n",me);
if ( !me->is_busy() )
        me->start_busy(1+random(3));
call_out("story",2+random(3),me,ob,mu);
return ;
}

void story(object me,object ob,object mu)
{
message_vision("穆忽地抬起头来，眸中精光四溢，死死盯着左方一根石柱。\n",me,ob);
mu->command("say 什么人？！滚出来。\n");
message_vision("随着一声邪恶的奸笑，一道黑影窜出金牛宫外！\n",me,ob);
message_vision("穆紧随其后，追了出去。\n");
mu->command("westup");
me->set("sds5/jinniu","done");
me->save();
destruct(ob);
return;
}

int do_none()
{
object me = this_player();
object ob = this_object();
tell_object(me,ob->name()+"看起来有点异样，你触摸(mo)一下看看。\n");
return 1;
}

