///////////////////////////////////////////////////////////////////////////
/////////////////////////// 地狱星 莱米 虫足带 ///////////////////////////
////////在狮子宫牵制艾奥里亚的冥斗士。他能伏在地底自由活动及使用纲索///////////
////////攻击，不过败给艾奥里亚的光速拳。                          ///////////
///////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////snowtu@Xmxyj2000/2003/平安夜/////
//////////////////////////////////////////////////////////////////////////

#include <ansi.h>
inherit NPC;
#include "star.h"

void create()
{
set_name("莱米",({"lami","di yu"}));
set("title",HIB"地"NOR HIR"狱"NOR WHT"星"NOR);
set("long","能伏在地底自由活动及使用纲索攻击的冥斗士。\n");
set("gender","男性");
set("age",21);
set("con",30);
set("per",15);
set("str",35);
set("int",40);
set("combat_exp",250000000);
set("daoxing",250000000);
set_skill("dodge",550);
set_skill("force",550);
set_skill("parry",550);
set_skill("unarmed",550);
set_skill("mingwang-quan",550);
set_skill("ghostdance",550);
set_skill("ghostforce",550);
set_skill("ghostspells",550);
map_skill("parry","mingwang-quan");
map_skill("dodge","ghostdance");
map_skill("unarmed","mingwang-quan");
map_skill("spells","ghostspells");
map_skill("force","ghostforce");
set("max_force", 9000);
set("force", 18000);
set("max_mana",9000);
set("mana",18000);
set("mana_factor",450);
set("force_factor",250);
set("max_kee", 80000);
set("max_gin", 80000);
set("max_sen", 80000);
setup();
carry_object(__DIR__"obj/evl_cloth")->wear();
}

void heart_beat()
{
::heart_beat();
if ( !is_fighting() && query("eff_kee") >= query("max_kee") 
   && query("eff_kee") <  query("max_kee") && random(2)==1 )
        command("exert heal");
if ( query("kee") < (query("eff_kee")-10) )
        command("exert recover");
if ( query("sen") < (query("eff_sen")-10) ) 
        command("exert refresh");
}

void kill_ob(object me)
{
object ob=this_object();

if ( !me ) return;

if( !present(me,environment()) )
        {
        powerup();
        ob->remove_killer(me);
        me->remove_killer(ob);
        return;
        }
     
if( me->is_ghost() || !me->is_fighting(ob) )
        {
        powerup();
        ob->remove_killer(me);
        me->remove_killer(ob);
        return;
       }

if ( me->query_temp("yinshentime") )
        {
        me->delete_temp("yinshentime");
        me->delete("env/invisibility");      
        me->save();
        me->delete_temp("no_heal_up/yinshen");
        message_vision(HIW"\n白光闪过之后，$N又现出了身形。\n\n"NOR, me);
        }

set("chat_chance_combat",40);
set("chat_msg_combat", ({
        (: perform_action, "unarmed", "chongzu" :),
        (: powerup :),
}));
if( random(15)==1 )
        powerup();
::kill_ob(me);
}

void init()
{
object me = this_player();
::init();
add_action("do_pfm","perform");
add_action("do_cast","cast");
add_action("do_look","look");
add_action("do_none","move");
add_action("do_none","surrender");
add_action("do_none","ji");
add_action("do_none","steal");
add_action("do_none","fight");
add_action("do_none","shoot");
}

int do_none()
{
string msg;
int damage = 100+random(100);
object me = this_player();
object ob = this_object();
say(ob->name()+"手中钢索抖动，"+me->name()+"一个不察，给抽了个正着。\n");
msg = COMBAT_D->damage_msg(damage,"抽伤");
message_vision(msg,ob,me);
me->receive_damage("sen",damage);
me->receive_damage("kee",damage/4);
return 1;
}

int do_pfm(string arg)
{
string args,msg;
int damage = 100+random(500);
object me = this_player();
object ob = this_object();
if ( arg=="fengchan" || arg=="meihua" )
        {
        message("vision",ob->name()+"手中钢索抖动不止。\n",environment(),me);
        tell_object(me,CYN"\n"+ob->name()+CYN"朝你摆了两摆。\n"NOR);
        msg = COMBAT_D->damage_msg(damage,"抽伤");
        message_vision(msg,ob,me);
        me->receive_damage("sen",damage);
        me->receive_damage("kee",damage/4);
        if ( random(5)==1 )     powerup();
        return 1;
        }
else  if ( sscanf(arg, "on %s",args)==1 && (arg=="fengchan" || arg=="meihua") )
        {
        message("vision",ob->name()+"手中钢索抖动不止。\n",environment(),me);
        tell_object(me,CYN"\n"+ob->name()+CYN"朝你摆了两摆。\n"NOR);
        msg = COMBAT_D->damage_msg(damage,"抽伤");
        message_vision(msg,ob,me);
        me->receive_damage("sen",damage);
        me->receive_damage("kee",damage/4);
        if ( random(5)==1 )     powerup();
        return 1;
        }
return 0;
}

int do_cast(string arg)
{
string args,msg;
int damage = random(500);
object me = this_player();
object ob = this_object();
if ( arg=="huimeng" || arg=="qiankun" || arg=="yinshen" )
        {
        message("vision",ob->name()+"手中钢索抖动不止。\n",environment(),me);
        tell_object(me,CYN"\n"+ob->name()+CYN"朝你摆了两摆。\n"NOR);
        msg = COMBAT_D->damage_msg(damage,"抽伤");
        message_vision(msg,ob,me);
        me->receive_damage("sen",damage);
        me->receive_damage("kee",damage/2);
        if ( random(5)==1 )     powerup();
        return 1;
        }
else  if ( sscanf(arg, "on %s",args)==1 && (arg=="huimeng"||arg=="qiankun"||arg=="yinshen") )
        {
        message("vision",ob->name()+"手中钢索抖动不止。\n",environment(),me);
        tell_object(me,CYN"\n"+ob->name()+CYN"朝你摆了两摆。\n"NOR);
        msg = COMBAT_D->damage_msg(damage,"抽伤");
        message_vision(msg,ob,me);
        me->receive_damage("sen",damage);
        me->receive_damage("kee",damage/4);
        if ( random(5)==1 )     powerup();
        return 1;
        }
return 0;
}

void die()
{
int die_num;
object mu,me,ob;
string title;
ob = this_object();
me = ob->query_temp("last_opponent");

powerup();        

if ( !me || !present(me,environment(ob)) )
	return;

if ( random(10)==1 )
	{
	say(HIB"\n"+name()+HIB"点了点头：不错不错，再来再来！\n"NOR);
	me->kill_ob(ob);
	ob->kill_ob(me);
	return;
	}

ob->remove_killer(me);
me->remove_killer(ob);

me->start_busy(3);
        
if ( me->query("sds5/juxie")=="done"&&me->query("sds5/shizi")!="done" )
        {
        title = WHT"【"NOR HIB"圣战"NOR HIY"十二宫"NOR HIB"之卷"NOR WHT"】"NOR;
        message("channel:chat",title+HIC"穆(Mu)："+me->query("name")+HIC"杀死了 地狱星 莱米！\n"NOR,users());
        me->add("daoxing",350000);
        me->set("sds5/shizi","done");
        tell_object(me,"你赢得了三百五十年道行。\n");
        me->save();
        }
title = WHT"【"NOR HIB"圣战"NOR HIY"十二宫"NOR HIB"之卷"NOR WHT"】"NOR;
title+=HIC+"$1($i)：...冥王..将...我..复活....吧......\n"NOR;
title = replace_string(title,"$1",ob->query("name"));
title = replace_string(title,"$i","Babilon");
message("channel:chat",title,users());
say(ob->name()+"惨叫一声，化作尘埃消失在夜风中！\n");
destruct(ob);
return;
}


