#include <ansi.h>
inherit NPC;
#include "star.h"
#include "die.h"
 
void create()
{
set_name("阿布罗狄", ({"aphrodite", "shuang yu"}));
set("long", "号称最美丽的圣斗士，并以玫瑰为武器。也是比较邪恶的黄金圣斗士。\n");
set("gender","男性");
set("title", HIC"双鱼座"HIY"黄金圣斗士"NOR);
set("age",37);
set("con",60);
set("per",32);
set("str",80);
set("int",80);
set("combat_exp",96000000);
set("daoxing",96000000);
set_skill("dodge", 600);
set_skill("force", 600);
set_skill("parry", 600);
set_skill("unarmed", 600);
set_skill("shengdou",600);
set_skill("stars-steps",600);
set_skill("moonforce",600);
set_skill("moonshentong", 600);
map_skill("parry","shengdou");
map_skill("dodge","stars-steps");
map_skill("unarmed","shengdou");
map_skill("spells","moonshentong");
map_skill("force","moonforce");

set("max_force", 7600);
set("force", 16000);
set("max_mana",7600);
set("mana",16000);
set("mana_factor",110);
set("force_factor",110);
set("max_kee", 60000);
set("max_gin", 60000);
set("max_sen", 60000);
setup();
carry_object(__DIR__"obj/evl_cloth")->wear();
}

void kill_ob(object me)
{
object ob=this_object();

if(! present(me,environment()) )
        {
        me->remove_killer(ob);
        ob->remove_killer(me);
        powerup();
        return;
        }
     
if( me->is_ghost() || !userp(me) )
        {
        me->remove_killer(ob);
        ob->remove_killer(me);
        powerup();
        return;
        }
     
set("chat_chance_combat", 80);
set("chat_msg_combat", ({
        (: perform_action, "unarmed", "mgmg" :),
        (: perform_action, "unarmed", "bmg" :),
        (: perform_action, "unarmed", "hmg" :),
}) );
if ( random(5)==1 )
        powerup();
::kill_ob(me);
}

