//白羊座穆先生  修复圣衣，水晶墙，星光灭绝，星屑旋转功，电波术
//一开始便对现任教皇产生怀疑，故居住於帕尔米高原上，拒绝接受教皇的指示。
//穆的念力强大，亦是世上唯一拥有修补圣衣能力的人。

#include <ansi.h>
inherit NPC;
#include "star.h"

void create()
{
set_name("穆先生", ({"mu"}));
set("long", HIW"传说中的白羊宫黄金战士，守护着白羊座,极富正义与智慧的黄金圣斗士，并擅长修理圣衣。\n"NOR);
set("gender","男性");
set("title", HIW"白羊宫"NOR+HIY"黄金圣斗士"NOR);
set("age",20);
set("attitude", "friendly");
set("con",30);
set("per",30);
set("str",25);
set("int",40);
set("combat_exp",50000000);
set("daoxing",50000000);
set("chat_chance",5);
set("chat_msg", ({
        "穆先生说道：圣战终于来临！\n"   
}));
set_skill("dodge", 800);
set_skill("force", 800);
set_skill("parry", 800);
set_skill("unarmed", 800);
set_skill("shengdou",800);
set_skill("stars-steps",800);
set_skill("moonforce",800);
set_skill("moonshentong", 350);
map_skill("parry","shengdou");
map_skill("dodge","stars-steps");
map_skill("unarmed","shengdou");
map_skill("spells","moonshentong");
map_skill("force","moonforce");

set("max_force", 12000);
set("force", 24000);
set("max_mana",12000);
set("mana",24000);
set("mana_factor",250);
set("force_factor",250);
set("max_kee", 8000);
set("max_gin", 8000);
set("max_sen", 8000);
setup();
carry_object(__DIR__"obj/by_cloth")->wear();
}

void init()
{
object me = this_player();
object ob = this_object();
if ( me->query("sds5/baiyang")=="done" 
  && me->query("sds5/ydn")!="done"    //临时，指最后一关。
  && !query("follow") )
        call_out("gensui",1+random(3),me,ob);
return;
}

void gensui(object me,object ob)
{
ob->command("say 得加把劲，不然雅典娜就危险了。\n");
ob->command("follow "+me->query("id"));
ob->set("follow",1);
ob->save();
return;
}

void kill_ob(object me)
{
int damage, lvl, r_lvl,skill, i;
object ob=this_object();
    
if(! present(me,environment()) )
        {
        ob->delete_temp("my_killer");
        return;
        }
     
if( me->is_ghost() )
        {
        ob->delete_temp("my_killer");
        return;
        }
      
switch(random(6))
        {        
        case 0:
                {
                message_vision(HIC"「星光灭绝」$N双手一挥，一团银芒直冲$n而去！\n",ob,me);
                if(random(2))
                        {
                        message_vision(HIC"$N被$n的银芒刺得遍体鳞伤！\n"NOR,me,ob);
                        me->add("eff_kee",-query("max_kee")/10);
                        me->add("eff_sen",-query("max_sen")/10);
                        kill_ob(me);
                        }
         else   {
               message_vision(HIR"$N轻而易举的躲过了$n的攻击！\n"NOR,me,ob);
                kill_ob(me);
                        }
         }
        break;

        case 1:
                {
                skill = (int)ob->query_skill("dark-quan", 1);
                lvl = skill/20;
                r_lvl = 3+random(lvl);
                if( r_lvl > 9) lvl = 9;
                if( r_lvl < 1) r_lvl = 1;
                message_vision(HIW"$N大喝一声“水晶墙！”在自己面前布出一面透明的气墙，$n的攻击立刻被反弹回去！\n"NOR,ob,me);
                for(i = 0; i < r_lvl; i++)
                                COMBAT_D->do_attack(me, me, me->query_temp("weapon") );
                kill_ob(me);
                break;  
                }

        case 2:
                {
                message_vision(HIR"$N运起[星屑旋转功],黄金斗气冲向$n \n",ob,me);
                if(random(2))
                        {
                        message_vision(HIR"$N被[星屑旋转功]击中,顿时血流如注，顷刻染红了全身！\n"NOR,me);
                        me->add("eff_kee",-3*query("max_kee")/10);
                        me->add("eff_sen",-3*query("max_sen")/10);
                        kill_ob(me);
                        }
                else    {
                        message_vision(HIR"$N看准黄金斗气的方向，纵身跃起，躲过这致命一击！\n"NOR,me);
                        kill_ob(me);
                        }
                }
        break;
        }

if( random(8) == 5 )
        powerup();
kill_ob(me);
}

void die()
{
object ob = this_object();
object me = ob->query_temp("last_opponent");
message_vision(HIW"$N瞑目运用念力，立刻恢复了战斗力！\n"NOR,ob);
powerup();
me->remove_kill(ob);
ob->remove_kill(me);
}

