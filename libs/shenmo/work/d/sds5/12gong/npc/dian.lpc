#include <ansi.h>
inherit NPC;
#include "star.h"

void create() {
  set_name("涅普尼奥", ({ "nipunoen" }));
  set("long", "地暗星座冥斗士，生性鬼祟，喜欢暗中偷袭。\n" NOR);
  set("gender", "男性");
  set("title", WHT "地暗星" NOR HIB "冥斗士" NOR);
  set("age", 20);
  set("con", 30);
  set("per", 10);
  set("str", 25);
  set("int", 40);
  set("combat_exp", 155000000);
  set("daoxing", 155000000);
  set_skill("dodge", 570);
  set_skill("force", 570);
  set_skill("parry", 570);
  set_skill("unarmed", 570);
  set_skill("mingwang-quan", 570);
  set_skill("ghostdance", 570);
  set_skill("ghostforce", 570);
  set_skill("ghostspells", 570);
  map_skill("parry", "mingwang-quan");
  map_skill("dodge", "ghostdance");
  map_skill("unarmed", "mingwang-quan");
  map_skill("spells", "ghostspells");
  map_skill("force", "ghostforce");

  set("max_force", 8050);
  set("force", 16100);
  set("max_mana", 8050);
  set("mana", 16100);
  set("mana_factor", 450);
  set("force_factor", 250);
  set("max_kee", 80000);
  set("max_gin", 80000);
  set("max_sen", 80000);
  setup();
  carry_object(__DIR__ "obj/evl_cloth")->wear();
}

void kill_ob(object me) {
  int damage, lvl, r_lvl, skill, i;
  object ob = this_object();

  if (!present(me, environment())) {
    powerup();
    ob->delete_temp("my_killer");
    return;
  }

  if (me->is_ghost() || !me->is_fighting(ob)) {
    powerup();
    ob->delete_temp("my_killer");
    return;
  }
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed", "xlg" :),
    (: exert_function, "powerup" :),
  }));

  if (random(5) == 1)
    powerup();
  remove_call_out("kill_ob");
  call_out("kill_ob", 1 + random(5), me);
}

void end(object me, object ob, object npc) {
  object mu;
  string title = WHT "【" NOR HIB "圣战" NOR HIY "十二宫" NOR HIB "之卷" NOR WHT "】" NOR;

  if (!ob || !npc || environment(ob) != environment(me))
    return;
  ob->command("hmm");
  npc->command("say 你以为亚鲁迪巴真的那么容易被打倒吗？\n");
  ob->command("ah");
  ob->command("say ...巨...型...号...角....\n");
  message_vision("$N忽地惨号一声，身体渐渐坏死破裂，终于碎成粉末消散在夜风中！\n", ob, me);
  title += HIC + "$1($i)：" NOR;
  title = replace_string(title, "$1", "童虎");
  title = replace_string(title, "$i", "Dohko");
  message("channel:chat", title + HIW + me->name() + HIC "闯过了地暗星涅普尼奥！\n" NOR, users());
  me->add("daoxing", 350000);
  tell_object(me, "你赢得了三百五十年道行。\n");
  me->set("sds5/jinniu2", "done");
  me->save();
  destruct(ob);
  return;
}

void gift(object me, object ob) {
  object npc;
  if (environment(ob) != environment(me))
    return;
  npc = present("mu", environment(ob));
  message_vision("$n正警惕的望着$N，穆忽然对$N叹了口气！\n", ob, me);
  ob->command("??");
  npc->command("sigh " + ob->query("id"));
  npc->command("say 你已经死了，可惜你到现在还执迷不悟......\n");
  call_out("end", 3 + random(5), me, ob, npc);
}

void die() {
  object ob = this_object();
  object me = ob->query_temp("last_opponent");

  powerup();

  if (!me || !present(me, environment(ob)))
    return;

  if (random(10) == 1) {
    say(HIB "\n" + name() + HIB "点了点头：不错不错，再来再来！\n" NOR);
    me->kill_ob(ob);
    ob->kill_ob(me);
    return;
  }

  me->remove_killer(ob);
  ob->remove_killer(me);

  me->start_busy(3);

  ob->command("hmm");
  ob->command("say 果真是后浪推前浪。。。\n");
  if (me->query("sds5/jinniu") == "done" && me->query("sds5/jinniu2") != "done") {
    call_out("gift", 3 + random(5), me, ob);
    return;
  }
  message_vision(HIW "$N化作尘土消失在夜风中！\n" NOR, ob);
  destruct(ob);
  return;
}

void init() {
  add_action("do_none", "steal");
  add_action("do_none", "move");
  add_action("do_none", "ji");
  add_action("do_none", "fang");
  add_action("do_none", "aplly");
  add_action("do_none", "surrender");
  add_action("do_none", "move");
  add_action("do_none", "cast");
  add_action("do_pfm", "perform");
}

int do_none() {
  object me = this_player();
  object ob = this_object();
  message_vision(HIB "$n化作一片幻影在$N身旁乱舞，$N一时无法攻击。\n", me, ob);
  if (random(3) == 1)
    me->start_busy(1);
  return 1;
}

int do_pfm() {
  if (random(10) == 1) return 1;
  return 0;
}

void heart_beat() {
  object ob = this_object();
  ::heart_beat();

  if (!is_fighting() && query("eff_kee") >= query("max_kee")
    && query("eff_kee") < query("max_kee") && random(5) == 1)
    command("exert heal");

  if (query("kee") < query("eff_kee") - 10 && random(3) == 1)
    command("exert recover");

  if (query("sen") < query("eff_sen") - 10 && random(3) == 1)
    command("exert refresh");

  if (query("force") < query("max_force"))
    command("cast transfer");
}

int accept_kill(object who) {
  powerup();
  kill_ob(who);
  return 1;
}
