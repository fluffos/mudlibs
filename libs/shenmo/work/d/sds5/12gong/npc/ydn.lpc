////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////
////// 沙織命XX到教皇的房間拿回玉座下的東西,接著穆、艾奧里亞及米羅把 ///////
////// 受了重創的撒加、修羅及卡妙帶到沙織的面 前 ， 沙 織 隨 即 把十 ///////
////// 三年前撒加要用來行刺自己的黃金短劍交給撒加，並要撒加奪去她的性 ///////
////// 命。沙織竟然用黃金短劍插入自己的喉中                         ///////
////// 地上的血跡，這時里昂突然出現，他利用女神之血令化成神像的雅典娜 ///////
////// 聖衣復活，並說出只有他才知道雅典娜聖衣一事，所以一班黃金聖鬥士 ///////
////// 利用哈蒂斯的力量復活，來把這個消息告訴女神。薜安還使用女神之血 ///////
////// 來令眾人的聖衣復活                                          ///////
////// 里昂把雅典娜聖衣交給XX，命他們趕去哈蒂斯城，並說真正的戰鬥現在 ///////
////// 才開始。及後，他化成了灰塵，消失於空氣中。                    ///////
/////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////Snowtu@Xmxyj2000/2003/12圣诞后//
//////////////////////////////////////////////////////////////////////////

inherit NPC;
#include <ansi.h>

#define SZ __DIR__"shuangzi"
#define SP __DIR__"shuiping"
#define SY __DIR__"shanyang"
#define MU __DIR__"baiyang"
#define AO __DIR__"shizi"
#define ML __DIR__"tianxie"

void create()
{
set_name(HIM"雅典娜"NOR, ({ "athena", "na" }));
set("title", HIY"女 神"NOR);
set("long", HIM"圣域的守护神，转世为城户沙织。\n"NOR);
set("gender", "女性");
set("age", 16);
set("attitude", "peaceful");
set("per",39);
set("max_kee", 12000);
set("max_gin", 14000);
set("max_sen", 12000);
setup();
carry_object(__DIR__"obj/armor")->wear();
carry_object(__DIR__"obj/cloth")->wear();
carry_object(__DIR__"obj/pifeng")->wear();
carry_object(__DIR__"obj/shield")->wear();
carry_object(__DIR__"obj/staff")->wield();
}

void init()
{
object me = this_player();
object ob = this_object();
object where = environment(ob);
if ( where->query("short")!=HIY"黄金圣殿"NOR ) 
        return;
if ( me->query("sds5/shinu")!="done" || !userp(me) )
        return;
if ( ob->query("story") )
        return;
if ( me->query("sds5/all")=="done" )
     {
     say(name()+"对"+me->name()+"点了点头，径直去了。\n");
     destruct(ob);
     }
remove_call_out("check");
call_out("check",1,me,ob,where);
}

void check(object me,object ob,object where)
{
int i,flag = 0;
object mu,sz,sy,sp,ao,ml,*inv;
if ( !me || !ob || environment(me)!=where )
        return;
inv = all_inventory(where);
for ( i=0;i<sizeof(inv);i++ )
        {
        if ( !userp(inv[i]) ) continue;
        if ( me==inv[i] ) continue;
        flag++;
        }
if ( flag>0 )
        {
        say(ob->name()+"露出为难之色：这么多斗士聚集于此，着实有些难办....\n");
        call_out("check",120,me,ob,where);
        return;
        }
/*
==============================================================================
                  残余三人众  =^-^=  snowtu@xmxyj2000/2003/圣诞后夜
==============================================================================
*/
mu = present("mu",where);
if ( !mu || userp(mu) )
        {
        mu = find_object(MU);
        if ( !mu )
                mu = new(MU);
        mu->move(where);
        }
ao = present("aiolia",where);
if ( !ao || userp(ao) )
        {
        ao = find_object(AO);
        if ( !ao )
                ao = new(AO);
        ao->move(where);
        }
ml = present("milo",where);
if ( !ml || userp(ml) )
        {
        ml = find_object(ML);
        if ( !ml )
                ml = new(ML);
        ml->move(where);
        }
/*
==============================================================================
                  喋血三人众  =^-^=  snowtu@xmxyj2000/2003/圣诞后夜
==============================================================================
*/

sz = present("saga",where);
if ( !sz || userp(sz) )
        {
        sz = find_object(SZ);
        if ( !sz )
                sz = new(SZ);
        sz->move(where);
        }
sy = present("shura",where);
if ( !sy || userp(sy) )
        {
        sy = find_object(SY);
        if ( !sy )
                sy = new(SY);
        sy->move(where);
        }
sp = present("kamus",where);
if ( !sp || userp(sp) )
        {
        sp = find_object(SP);
        if ( !sp )
                sp = new(SP);
        sp->move(where);
        }
message_vision("穆、艾欧里亚和修罗分别将重伤的撒加、修罗和卡妙抬了过来。\n",me);
ob->set("story",1);
if ( me->query_temp("apply/name") )
        {
        message_vision(HIY"\n\n$n"HIY"朝$N"HIY"点了点头，$N"HIY"只觉胆裂欲碎，不由现了原形。\n\n"NOR,me,ob);
        me->delete_temp("apply/name");
        me->delete_temp("apply/id");
        me->delete_temp("apply/short");
        me->delete_temp("apply/long");
        me->delete_temp("family");
        me->delete_temp("no_heal_up/bian");
        me->save();
        }
if ( me->query_temp("yinshentime") )
        {
        message_vision(HIW"\n\n$n"HIW"朝$N"HIW"点了点头，$N"HIW"只觉胆裂欲碎，不由现了原形。\n\n"NOR,me,ob);
        me->delete_temp("yinshentime");
        me->delete("env/invisibility");      
        me->save();
        me->delete_temp("no_heal_up/yinshen");
        }
random(2)?
ob->command("tell "+me->query("id")+" 你去教皇室宝座之下把那物什取了过来，交与我。\n"):
ob->command("whisper "+me->query("id")+" 你去教皇室宝座之下把那物什取了过来，交与我。\n");
tell_object(me,"去教皇宝座下将东西拿来给雅典娜吧。\n");
mu->command("gen none");
me->set_temp("sword_get",1);
return;
}


int accept_object(object me,object sword)
{
if ( this_object()->query("get_sword") )
   {
   say(name()+"疑惑道：我不是已经有了吗？\n");
   return 0;
   }
if ( sword->query("skill_type")=="sword" || sword=present("huangjin duanjian",me) )
        {
        if ( me->query("sds5/king")!="done" || !me->query_temp("get_sword") )
                {
                say(name()+"疑惑的问：这东西你是怎么得来的？我暂时收了吧。\n");
                return 1;
                }
        say(name()+"喃喃自语道：这一天，终于还是来了。。。。。\n");
        set("get_sword",1);
        me->delete_temp("sword_get");
        call_out("zisha",5+random(5),this_object(),me);
        return 1;
        }
return notify_fail("没事乱给人东西做什么？\n");
}

void zisha(object ob,object me)
{
object sword;
if ( !me || !present(me,environment()) )
        return;
remove_call_out("zisha");
if ( !sword = present("huangjin duanjian",ob) )
        {
        sword = new(__DIR__"obj/sword");
        sword->move(ob);
        }
command("unwield staff");
command("wield sword");
command("stab "+ob->query("id"));
return;
}

