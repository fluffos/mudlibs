#include <ansi.h>
inherit NPC;
#include "three_star.h"
 
void create()
{
set_name("撒加", ({"saga"}));
set("long", HBBLU+HIR"神秘的双子座黄金圣斗士，自十叁年前便一直失踪。他拥有双重性格，一面是善良而又得人心，另一面却是充满罪恶。
他的身份一直是一个谜。\n"NOR);
set("gender","男性");
set("title", HBBLU+HIR"双子宫"NOR+HIY"黄金圣斗士"NOR);
set("age",25);
set("con",30);
set("per",30);
set("str",35);
set("int",40);
set("combat_exp",300000000);
set("daoxing",300000000);
set_skill("dodge",650);
set_skill("force",650);
set_skill("parry",650);
set_skill("unarmed",650);
set_skill("shengdou",650);
set_skill("stars-steps",650);
set_skill("moonforce",650);
set_skill("moonshentong",650);
map_skill("parry","shengdou");
map_skill("dodge","stars-steps");
map_skill("unarmed","shengdou");
map_skill("spells","moonshentong");
map_skill("force","moonforce");

set("max_force", 8000);
set("force", 16000);
set("max_mana",8000);
set("mana",16000);
set("mana_factor",500);
set("force_factor",200);
set("max_kee", 80000);
set("max_gin", 80000);
set("max_sen", 80000);

setup();
carry_object(__DIR__"obj/evl_cloth")->wear();
}

void init()
{
object me=this_player();
::init();
if( !me || !visible(me) || environment(me) != environment() ) return;
add_action("do_pfm","perform");
add_action("do_cast","cast");
add_action("do_none","ji");
add_action("do_none","move");
add_action("do_none","surrender");
add_action("do_none","fight");
add_action("do_none","shoot");
}

void kill_ob(object me)
{
object ob=this_object();
    
if(! present(me,environment()) )
        {
        powerup();
        me->remove_killer(ob);
        ob->remove_killer(me);
        return;
        }
     
if( me->is_ghost() || !userp(me) )
        {
        powerup();
        me->remove_killer(ob);
        ob->remove_killer(me);
        return;
        }
     
set("chat_chance_combat", 80);
set("chat_msg_combat", ({
        (: perform_action, "unarmed", "hlmhq" :),
        (: perform_action, "unarmed", "mhfxq" :),
        (: perform_action, "unarmed", "mhblq" :),
}) );
::kill_ob(me);
}

