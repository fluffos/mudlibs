#include <ansi.h>
#include <weapon.h>
inherit COMBINED_ITEM;

void create()
{
set_name(HIR"血滴"NOR,({"xue di","blood","xue"}));
set_weight(1);
if (clonep())
        set_default_object(__FILE__);
else    {
        set("unit",WHT"抹"NOR);
        set("base_unit",HIR"滴"NOR);
        set("long",RED"死人留下的血。\n"NOR);
        set("material", "water");
        set("no_drop","你既然要了它,何必扔掉?\n");
        set("no_give","你既然要了它,何必扔掉?\n");
        set("no_put","你既然要了它,何必扔掉?\n");
        }
set_amount(1);
setup();
}


