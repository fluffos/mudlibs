#include <ansi.h>
inherit ITEM;

string chinese_time(int time) {
  int t, d, h, m, s;
  string ret;

  t = time;
  s = t % 60; t /= 60;
  m = t % 60; t /= 60;
  h = t % 24; t /= 24;
  d = t;

  if (d) ret = chinese_number(d) + "天";
  else ret = "";

  if (h) ret += chinese_number(h) + "时";
  if (m) ret += chinese_number(m) + "分";
  ret += chinese_number(s) + "秒";

  return ret;
}

void create() {
  set_name("丝线", ({ "si xian", "xian" }));
  set_weight(6000000);
  set_max_encumbrance(100000000000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "一团乱糟糟的丝线团。\n");
    set("no_get", "那么大，怎么拿哦？\n");
  }
  setup();
}

int is_container() {
  return 1;
}

void init() {
  object me, ob, who;
  ob = this_object();
  me = this_player();
  who = ob->query("owner");
  if (!who || !me || me != ob->query("human"))
    return;
  if (!present(me, ob))
    return;
  ob->set("short", ob->short());
  remove_call_out("check");
  call_out("check", 1, ob, me);
  add_action("block_cmd", "", 1);
}

void check(object ob, object me) {
  int i;
  object who;
  if (!me || environment(me) != ob || !living(me))
    return;

  remove_call_out("check");

  if ((i = me->query_temp("si_time")) > 0) {
    me->add_temp("si_time", -1); me->save();
    if (random(3) == 1) tell_object(me, "再等" + chinese_time(i) + "，就可以出去了。\n");
    call_out("check", 1, ob, me);
    return;
  }
  me->move(environment(ob));
  message_vision("只见$N艰难的从$n里钻了出来。\n", me, ob);
  if (who = present("chong yong", environment()))
    call_out("hudie", 2 + random(5), who);
  call_out("dismiss", 10 + random(20), ob);
  return;
}

int block_cmd() {
  string msg, *msgs;
  string verb = query_verb();
  object me = this_player();
  object ob = this_object();
  if (verb == "chat") return 0;  //allow say
  if (verb == "break") return 0;
  if (verb == "na") return 0;
  if (verb == "fang") return 0;
  if (verb == "home") return 0;
  if (verb == "goto") return 0;
  if (verb == "chat*") return 0;
  if (verb == "look") return 0;
  if (verb == "i") return 0;
  if (verb == "inventory") return 0;
  msgs = ({
    "$N干哑的叫道：水，水，给我水。。。\n",
    "$N嘟嘟囔囔的说着人们听不懂的话。\n",
    "$N干嚎着。。。。。。\n",
    "$N在黑暗中摸索着。\n",
    "$N眼前一片黑......\n",
    "$N干嚎着：我们都是神经病。\n",
    "$N扑通扑通乱折腾一气。\n",
  });
  msg = msgs[random(sizeof(msgs))];
  message_vision(msg, me);
  tell_object(me, "看来还得等" YEL + chinese_time(me->query_temp("si_time")) + NOR "。\n");
  return 1;
}


void hudie(object ob) {
  string msg;
  object where = environment(ob);
  ob->delete("变形");
  ob->set_name("巴比隆", ({ "babilon", "di yao" }));
  ob->set("long", query("longs"));
  ob->set("title", HIB "地" NOR HIM "妖" NOR WHT "星 " NOR HIY "蝴蝶" NOR);
  ob->set("per", 30 + random(10));
  ob->save();
  msg = YEL "隔着丝线的空档，只见" + ob->name() + YEL "的蛹一阵蠕动..." NOR;
  msg += YEL + ob->name() + YEL "哗的一声，破蛹而出，化身为一只美丽的蝴蝶！\n" NOR;
  tell_room(where, msg);
  return;
}

void dismiss(object ob) {
  if (!ob) return;
  tell_room(environment(ob), ob->name() + "渐渐融入了地底....\n" NOR);
  destruct(ob);
  return;
}
