#include <ansi.h>
#include <armor.h>
inherit ARMOR;
#include "chk_owner.lpc"

void create()
{
set_name(HIB"巨蟹座"HIY"黄金圣衣"NOR, ({ "juxie shengyi" }) );
set_weight(3000);
if( clonep() )
        set_default_object(__FILE__);
else {
        set("unit", "件");
        set("material", "gold");
        set("armor_prop/armor",600);
        }
setup();
}

