#include <armor.h>
inherit ARMOR;
#include <ansi.h>

void create()
{
set_name("天蝎黄金圣衣", ({ "tianxie shengyi" }) );
set_weight(3000);
   if( clonep() )
     set_default_object(__FILE__);
else {
     set("unit", "件");
     set("material", "goldon");
     set("armor_prop/armor",575);
     }
setup();
}

