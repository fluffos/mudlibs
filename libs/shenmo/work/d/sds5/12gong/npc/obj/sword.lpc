#include <ansi.h>
#include <weapon.h>
inherit SWORD;

#define SZ "/d/sds5/12gong/npc/shuangzi"
#define SP "/d/sds5/12gong/npc/shuiping"
#define SY "/d/sds5/12gong/npc/shanyang"
#define MU "/d/sds5/12gong/npc/baiyang"
#define AO "/d/sds5/12gong/npc/shizi"
#define ML "/d/sds5/12gong/npc/tianxie"
#define LE "/d/sds5/12gong/npc/leon"
#define TH "/d/sds5/12gong/npc/tonghu"

void create() {
  set_name(HIY "黄金短剑" NOR, ({ "huangjin duanjian", "jian", "sword" }));
  set_weight(0);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", BLINK HIY "一把纯金打造的短剑，上面雕花络纹，在阳光之下锃锃生光。\n" NOR);
    set("material", "steel");
    set("wield_msg", BLINK HIY "$N" BLINK HIY "从颈上取下一把$n" BLINK HIY "握在手中。\n" NOR);
    set("unwield_msg", BLINK HIY "$N" BLINK HIY "将手中的$n" BLINK HIY "带回颈上。\n" NOR);
    set("no_drop", "你既然要了它,何必扔掉?\n");
  }
  init_sword(50);
  setup();
}

void init() {
  add_action("do_stab", "stab");
}

void stab_die(object me) {
  string str;
  str = WHT "〖" NOR HIM "谣言" NOR WHT "〗" NOR;
  str += HIM "某人：听说" NOR HIW "$N($I)" NOR HIM "一时想不开，割喉自刎了！\n" NOR;
  str = replace_string(str, "$N", me->query("name"));
  str = replace_string(str, "$I", capitalize(me->query("id")));
  message("channel:rumor", str, users());
  me->die();
  return;
}

void stab_ob(object me, object who, object where) {
  int damage;
  string str = WHT "〖" NOR HIM "谣言" NOR WHT "〗" NOR;

  if (!me || !who || environment(me) != environment(who))
    return;
  if (!present(this_object(), me))
    return;
  if (environment(me) != where)
    return;
  tell_object(me, RED "你慢慢的接近" + who->name() + RED "，等待机会下手...\n\n" NOR);
  tell_object(me, RED "好机会！你将手中短剑狠狠的朝" + who->name() + RED "刺去！！\n\n" NOR);
  damage = me->query_temp("apply/damage");
  damage += me->query("force_factor");
  damage += me->query_skill("dodge");
  damage -= who->query_temp("apply/armor");
  damage -= who->query_skill("parry");
  if (damage < 150) damage = 150;
  if (damage > 900) damage = 900;
  if (me->query("combat_exp") > random(who->query("combat_exp") / 5)) {
    tell_object(me, RED "成功了！正中要害，嘿嘿，不死也残...\n\n" NOR);
    message_vision(HIR "\n\n$N" HIR "手中寒光一闪，$n" HIR "只觉一阵剧痛！\n" NOR, me, who);
    who->receive_damage("kee", damage);
    COMBAT_D->report_status(who);
    message_vision(HIR "$n" HIR "手抚伤口，尚不敢相信的望着$N" HIR "....\n" NOR, me, who);
    who->set_temp("last_damage_from", me->query("name") + "用黄金短剑");
    if (who->query("kee") <= 0) {
      str += HIM "某人：听说$N($I)一时不察，被$n($i)用" NOR HIY "黄金短剑" NOR HIM "刺杀了！\n" NOR;
      who->set("die_reason", "为" + me->query("name") + "暗杀之");
      who->die();
      who->save();
    } else {
      who->save();
      str += HIM "某人：听说$N($I)一时不察，被$n($i)用" NOR HIY "黄金短剑" NOR HIM "所伤！\n" NOR;
      who->kill_ob(me);
      me->kill_ob(who);
    }
    str = replace_string(str, "$N", who->query("name"));
    str = replace_string(str, "$I", capitalize(who->query("id")));
    str = replace_string(str, "$n", me->query("name"));
    str = replace_string(str, "$i", capitalize(me->query("id")));
    message("channel:rumor", str, users());
  } else {
    tell_object(me, RED "不好！你失败了...\n\n" NOR);
    if (random(3) == 1)
      tell_object(me, YEL "还好还好，对方没发现....\n" NOR);
    else {
      message_vision(YEL "$n低头看看破了衣襟，再看看$N，恍然大悟，不由怒从心起....\n" NOR, me, who);
      who->kill_ob(me);
      me->kill_ob(who);
    }
  }
  return;
}

int do_stab(string arg) {
  object me, sword, where, who;
  string str;
  sword = this_object();
  me = environment(sword);
  where = environment(me);

  if (!arg || !who = present(arg, where))
    return notify_fail("你想刺杀谁？\n");
  if (!sword->query("equipped"))
    return notify_fail("你先得装备上这把武器。\n");
  if (!living(who))
    return notify_fail("对方已经不行了，何必多此一举？\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢。\n");

  if (who != me) {
    if (where->query("no_fight") || where->query("no_fight")) {
      message_vision("$N目露凶光，好似动了杀机。\n", me);
      return notify_fail("安全区内怎可行凶？！\n");
    }
    message(
      "vision",
      YEL + me->name() + YEL "将" + sword->name() + YEL "紧紧攥握在手，偷偷摸摸的接近" + who->name() + YEL "...\n" NOR,
      where,
      who
    );
    me->start_busy(3);
    call_out("stab_ob", 1 + random(4), me, who, where);
  } else {
    if (userp(me)) {
      if (me->query("gender") == "男性")
        str = ({ "如画似玉", "沉鱼落雁", "闭月羞花" })[random(3)] + "的" + ({ "姑娘", "女侠", "少女" })[random(3)];
      else str = ({ "大好前程", "正当少年", "风华正茂" })[random(3)] + "的" + ({ "少年", "大侠", "男儿" })[random(3)];
      message_vision(YEL "$N" YEL "心会意冷，掏出$n" YEL "朝自己脖子上一抹，叹道“人生苦短，就此别过....\n”\n" NOR, me, sword);
      message_vision(RED "\n\n几点殷红凭空溅出，入目惊心。可叹" + str + RED "就这么去了。\n\n" NOR, me);
      stab_die(me);
    } else if (me->query("id") == "athena")
      call_out("applying", 1, me, where);
    else stab_die(me);
  }
  return 1;
}

void applying(object me, object where) {
  int i, flag = 0;
  object player, mu, ao, ml, sz, sp, sy, *inv;
  if (!me || environment(me) != where)
    return;
  inv = all_inventory(where);
  for (i = 0; i < sizeof(inv); i++) {
    if (!userp(inv[i])) continue;
    player = inv[i];
    flag++;
  }
  tell_room(where, "雅典娜将黄金短剑提将在手，睹物思人，不禁一阵唏嘘。\n");
  if (flag != 1) {
    me->command("say 这么多斗士在此，还是算了....\n");
    tell_room(where, "说罢，雅典娜将手中的短剑又放了下来。\n");
    return;
  }
  if (player->query("sds5/king") != "done")
    return;
  mu = present("mu", where);
  if (!mu || userp(mu)) { mu = find_object(MU); if (!mu) mu = new(MU); mu->move(where); }

  ao = present("aiolia", where);
  if (!ao || userp(ao)) { ao = find_object(AO); if (!ao) ao = new(AO); ao->move(where); }

  ml = present("milo", where);
  if (!ml || userp(ml)) { ml = find_object(ML); if (!ml) ml = new(ML); ml->move(where); }

  sz = present("saga", where);
  if (!sz || userp(sz)) { sz = find_object(SZ); if (!sz) sz = new(SZ); sz->move(where); }

  sy = present("shura", where);
  if (!sy || userp(sy)) { sy = find_object(SY); if (!sy) sy = new(SY); sy->move(where); }

  sp = present("kamus", where);
  if (!sp || userp(sp)) { sp = find_object(SP); if (!sp) sp = new(SP); sp->move(where); }

  me->command("say 这一天终于也来临了....\n");
  tell_room(where, "\n说罢，雅典娜将短剑一横，向脖子抹去！\n\n");
  player->command("say 啊~~~女神......\n");
  mu->command("sigh " + ml->query("id"));
  ao->command("hmm " + player->query("id"));
  sz->command("whisper " + sp->query("id") + " 眠兔是我的偶像。=^-^=\n");
  sy->command("pat " + player->query("id"));
  tell_room(where, RED "血光之闪，雅典娜已经倒在了血泊当中！\n\n");
  me->set("disable_type", "<倒在血泊中>");
  me->set_temp("disabled", 1);
  player->start_busy(5);
  call_out("finish", 2 + random(3), player, me, mu, ao, ml, sz, sy, sp, where);
}

void finish(object me, object ydn, object mu, object ao, object ml,
  object sz, object sy, object sp, object where) {
  object le, th;
  if (!me || !ydn || !present(me, where))
    return;

  le = present("leon", where);
  if (!le || userp(le)) { le = find_object(LE); if (!le) le = new(LE); le->move(where); }

  th = present("dohko", where);
  if (!th || userp(th)) { th = find_object(TH); if (!th) th = new(TH); th->move(where); }

  tell_room(where, "众人尚在惊疑之中，童虎和里昂出现在大家面前。\n");
  me->command("say 老师，这到底......\n");
  le->command("say 这一切均在预料之中。\n");
  tell_room(where, "众人一时丈二和尚摸不着头脑。\n");
  sz->command("say 里昂先生早已知晓了圣战必将来临，另外圣战必须一样物品...\n");
  tell_room(where, ml->name() + "急切的问道：需要什么？\n");
  me->start_busy(5);
  call_out("end", 2 + random(3), me, ydn, mu, ao, ml, th, le, sz, sy, sp, where);
}


void end(object me, object ydn, object mu, object ao, object ml,
  object th, object le, object sz, object sy, object sp, object where) {
  string msg;
  object blood;
  if (!me || !present(me, where) || !present(ydn, where) || !present(mu, where)
    || !present(ml, where) || !present(ao, where) || !present(sz, where)
    || !present(sy, where) || !present(sp, where) || !present(le, where)
    || !present(th, where))
    return;
  msg = "一阵沉静之后，里昂将事情原委一五一十道来：\n";
  msg += "传说中的雅典娜聖衣其实并没有消失，只是被封在黄金聖殿后面的雅典娜神像
之中，但是聖衣必需要女神の血方可復活，所以一班黃金聖鬥士利用哈蒂斯的力量復活
，來把這個消息传达给女神。\n" NOR;
  msg = replace_string(msg, "女神の血", HIR "女神の血" NOR);
  tell_room(where, msg);
  me->command("say 但是现在女神已经....\n");
  tell_room(where, "童虎摇了摇头，道：这是去冥界最佳的途径了....\n");
  tell_room(where, "众人恍然大悟。\n");
  le->command("say 撒加你们三个继续扮演这个角色下去，将雅典娜的尸体带到哈蒂斯城。\n");
  sz->command("ok");
  tell_room(where, "撒加等人扶过雅典娜的尸体径直去了。\n");
  destruct(sz);
  destruct(sp);
  destruct(sy);
  tell_room(where, "穆也站起身来道：我们几个也不能闲着，先去哈蒂斯城。\n");
  tell_room(where, "说罢，穆等人也起身离开。\n");
  destruct(mu);
  destruct(ao);
  destruct(ml);
  destruct(th);
  tell_room(where, "里昂长身而起，长笑一声：忍辱负重，现在一切皆已如愿，该走的还是要走.....\n");
  tell_room(where, "微微晚风之中，里昂化作片片尘埃，消失在黎明到来的前夕.....\n");
  destruct(le);
  msg = WHT "【" NOR HIG " 圣 战 " NOR WHT "】" NOR;
  msg += HIC "里昂(Leon)：圣  战  正  式  开  始 ！ ！  ！ \n" NOR;
  message("channel:chat", msg, users());
  me->set("sds5/all", "done");
  tell_object(me, "去后面用" HIR "女神之血" NOR "加雅典娜圣衣复活吧。\n");
  blood = new(__DIR__ "blood");
  blood->set_name(
    ydn->name() + YEL "の" NOR + blood->name(),
    ({ "nvshen's blood", "blood", "xue" })
  );
  blood->set("long", HIM "雅典娜自杀所留下的血滴。\n" NOR);
  blood->set_amount(50 + random(50));
  blood->move(where);
  destruct(ydn);
  return;
}
