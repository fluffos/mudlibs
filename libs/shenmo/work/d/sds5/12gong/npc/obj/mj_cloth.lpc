#include <ansi.h>
#include <armor.h>

inherit ARMOR;

void create()
{
   set_name(MAG"山羊座"HIY"黄金圣衣"NOR, ({ "shanyang shengyi" }) );
   set_weight(3000);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("unit", "件");
     set("material", "steel");
     set("armor_prop/armor",175);
   }
   setup();
}
