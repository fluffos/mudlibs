inherit ITEM;
#include <ansi.h>

string *dies = ({
        "斯","司","洛","夫","奥","奇","尔","戈","卡","修","里","拉","尼","奧","路",
});
string *star = ({ 
        "骶","诋","骨","辜","斧","腐","耀","夭","毒","度","妒","黩",
});     
        
int do_mai(string arg);

void create()
{
set_name("无名尸体", ({ "corpse" }) );
set("long", "这是一具无名尸体。\n");
set("unit", "具" );
}

int is_container() { return 1; }

string short() { return name() + "(" + capitalize(query("id")) + ")"; }

void init()
{                                             
add_action("do_mai", "mai");
add_action("do_mai", "bury");
add_action("do_inspect","inspect");
}

int do_mai(string arg)
{
int i;
object here;
object me = this_player();
object *inv=all_inventory(this_object());
here = environment(me);

if (!id(arg))
        return notify_fail("你要埋什么？\n");
if(!here->query("mai_corpse_able"))
        return notify_fail("你不能在这里埋尸体！\n");
if ( !query("check") )
        return notify_fail("还是先检查检查(inspect)它吧。\n");

if( random(3)==1)
        {
        i = random(100);
        if ( i>0 )
                {
                me->add("potential",i);
                tell_object(me,"你得到了"YEL+chinese_number(i)+NOR"点潜能。\n");
                }
        }
if( random(3)==1) 
        {
        i = random(5000);
        if ( i>0 )
                {
                me->add("daoxing",i);
                tell_object(me,"你得到了"YEL+COMBAT_D->chinese_daoxing(i)+NOR"道行。\n");
                }
        }
if(me->query("bellicosity")>10) me->add("bellicosity", -10);
me->receive_damage("kee", 5);
me->add("bury_corpse", 1);
message_vision("\n$N不禁被穆先生博大的仁慈之心所感染，道：
先生果然是菩萨化身。听了先生的一番教导以后，我的心久久不能平静，震
撼啊！为什么会有如此好的人！我纵横江湖多年，自以为再也不会有任何话
语能打动我，没想到今天看到了如此仁慈的这样一颗心。先生，是你让我深
深地理解了‘大慈大悲’这句话。谢谢侬！听话你的话语以后，我没有立即
回应，因为我生怕我庸俗不堪的思想会玷污了这世上少有的纯洁的心灵。但
是我还是回应了，因为觉得如果不如此，那我死也不会瞑目的！能够在如此
仁慈的您带领下完成这次任务是多么骄傲的一件事啊！先生，请原谅我的自
私！我知道无论用多么华丽的辞藻来形容您的仁慈都是不够的，都是虚伪的
，所以我只想说一句：您的心地太仁慈了！我愿意一辈子的跟着您！您的仁
慈沉鱼落雁，闭月羞花，惊天地泣鬼神，可谓是寸寸慈悲心，分分菩萨肠，
是我辈应当学习之典范。本来我已经对这个世界失望了，觉得这个世界没有
前途了，心里充满了悲哀。但是自从见到了您，又让我对世界产生了希望。
是你让我的心里重新燃起希望之火，是你让我的心死灰复燃，是你拯救了我
一颗拨凉拨凉的心！苍天有眼啊，让我在有生之年得以遇到先生这样的人..
..\n\n",me);
message_vision("$N在地下刨了个坑，把$n放了进去，用土埋了起来。\n", me, this_object());
message_vision("$N对坟头鞠了个躬，道：怪你前世命短，好好修来生去吧！\n", me);
me->add("sds5/mai_corpse",1);
for(i=0;i<sizeof(inv);i++)
        destruct(inv[i]);
destruct(this_object());
return 1;
}

int do_inspect(string arg) 
{
int i,kar;
string title,name,msg;
object corpse,me;
me = this_player();
corpse = this_object();

if ( !id(arg) )
        return notify_fail("你要检查什么？\n");
if ( query("check") ) 
        return notify_fail("这具尸体已经知道来历了，尽快埋(mai)了吧...\n");

i = corpse->query("num"); //死者号码，后面还要用到
switch(i)
        {
        case 1: name="吉保";title=HIB"地"NOR WHT"陰"NOR HIY"星"NOR; break;
        case 2: name="米鲁斯";title=HIB"地"NOR YEL"劣"NOR HIY"星"NOR; break;
        case 3: name="欧克斯";title=HIB"地"NOR HIG"走"NOR HIY"星"NOR; break;
        default: {
                name = "";
                for ( i=(strlen(name)/2);i<3;i++ )
                        {
                        msg = dies[random(sizeof(dies))];
                        if ( strsrch(msg,name)==-1 ) name+=msg;
                        }
                title = HIB"地"NOR;
                title+= HIM+star[random(sizeof(star))];
                title+= WHT"星"NOR;
                break;
                }
        }
kar=me->query_kar();
msg = "$N蹲下来仔细检查尸体....";
if ( random(kar)>20 )
        {
        msg+="忽地脑中灵光一闪，恍然大悟：“哦，他是"+title+name+"，奇怪，怎么死在这里？\n";
        corpse->set_name(name+"的尸体",({"corpse"}));
        corpse->set("title",title);
        corpse->set("long",title+" "+name+"的尸体。\n");
        corpse->set("check",1);
        corpse->save();
        message("channel:chat",WHT"【"NOR HIB"圣战"NOR HIY"十二宫"NOR HIB"之卷"NOR WHT"】"NOR HIC"童虎(Dohko)："+me->query("name")+HIC"在"+environment(me)->query("short")+HIC"发现了"+corpse->query("name")+HIC"！\n"NOR,users()); 
        }
else    msg+="结果什么结论也得不到。\n";
message_vision(msg,me);
return 1;
}

