#include <armor.h>
#include <ansi.h>
#include "chk_owner.lpc"
inherit ARMOR;

void create() {
  set_name(HIM "天鹰座" NOR WHT "白银斗衣" NOR, ({ "tianying shengyi" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "steel");
    set("armor_prop/armor", 650);
  }
  setup();
}
