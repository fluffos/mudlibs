#include <ansi.h>
inherit ITEM;

void create()
{
set_name(HIY"雅典娜黄金圣衣"NOR,({"nvshen shengyi"}) );
set_weight(3000);
if( clonep() )
        set_default_object(__FILE__);
else    {
        set("unit", "件");
        set("long",HIM"雅典娜女神专用的圣衣。\n"NOR);
        }
setup();
}

int query_autoload()
{
object ob =this_object();
object me =environment(ob);

if ( me->query("sds5/gift1")!="done" || !userp(me) )
        return 0;
else 
        return 1;
}


