inherit ROOM;
#include <ansi.h>

#define SZ __DIR__"npc/shuangzi"
#define SP __DIR__"npc/shuiping"
#define SY __DIR__"npc/shanyang"

void create ()
{
set ("short", "第六宫处女座");
set ("long", @LONG
    农业女神得墨特尔和宙斯大帝育有一女普西芬妮，有一天普西芬妮在野地摘花时，有
朵从为见过的美丽花朵正盛开着，正当她伸手要摘时，地面突然裂成好几块，就掉下去了
。母亲得墨特尔誓死也要找回失踪的女儿而四处寻访。看到所有事情经过的太阳神赫利俄
斯乃告诉得墨特尔，因冥王海德斯欲娶普西芬妮为妻，而将她带回地下，得墨特尔因为悲
伤过度而使植物枯萎，大地一毛不生。宙斯看事态严重，乃向海德斯说情，可是海德斯在
普西芬妮要走时，拿了冥界石榴给她吃，普西芬妮因为可以离开，高兴吃了四个，结果被
迫一年有四个月要留在冥界，这四个月就变得今日万物不宜耕种的冬天，普西芬妮一回到
人间就是春天，得墨特尔就是处女座的化身。
LONG);
set("exits", ([
        "westup"    :       __DIR__"sn2tc1",
        "northdown"  :       __DIR__"sz2sn2",        
]));
set("no_clean_up",1);
setup();
}

int do_none()
{
message_vision("赶紧去保护雅典娜！\n",this_player());
return 1;
}

void init()
{
object me = this_player();
object where = this_object();

add_action("do_none","fight");
add_action("do_none","ji");
add_action("do_none","recall");
add_action("do_none","whisper");
add_action("do_none","surrender");
add_action("do_none","bian");
add_action("do_none","get");
add_action("do_none","give");
add_action("do_none","move");
add_action("do_none","burn");
add_action("do_inspect","inspect");
if ( userp(me) )
        {
        if ( me->query_temp("yinshentime") )
                {
                me->delete_temp("yinshentime");
                me->delete("env/invisibility");      
                me->save();
                me->delete_temp("no_heal_up/yinshen");
                message_vision(HIW"\n白光闪过之后，$N又现出了身形。\n\n"NOR, me);
                }
        if ( me->query("sds5/shizi")!="done" )
                {
                message_vision(HIY"“圣域现在有事发生，$N还是回吧！”\n"NOR,me);
                me->move("/d/city/kezhan");
                message_vision(HIY"白光有一闪，$N出现在大家的面前，世界真奇妙！\n"NOR);
                me->unconcious();       
                }
        if ( !where->query("story") )
                {
                message_vision("四下里一片不寻常的安静.....\n",me);
                call_out("story",5+random(5),me,where);
                }
        }
return;
}

int valid_leave(object me, string dir)
{
object here = this_object();
if ( userp(me) && dir=="westup" )
        {
         if ( me->query("sds5/shinu")!="done"  )
                return notify_fail("穆朝你摇了摇头。\n");
        }
else return 1;
return ::valid_leave(me, dir);
}

void story(object me,object where)
{
object mu;

remove_call_out("story");

if ( !me || !where || environment(me)!=where )
        return;
mu = present("mu",where);
if ( !mu || userp(mu) )
        {
        tell_object(me,"等等穆先生吧。\n");
        call_out("story",30+random(30),me,where);
        return;
        }
where->set("story",1);
message("channel:rumor",HIY"\n忽然一股强大的小宇宙覆盖住處女宮旁的花園！\n\n"NOR,users());
message_vision(HIY"整个花园在轰鸣声中崩塌离析......\n"NOR,me);
mu->command("sigh");
mu->command("say 阿賴耶識....\n");
me->command("??");
me->start_busy(3);
call_out("story2",5+random(5),me,mu,where);
}

void story2(object me,object mu,object where)
{
object npc1,npc2,npc3;
if ( !mu || !me || !where || environment(me)!=where 
  || environment(mu)!=where  || !where->query("story") )
        return;
npc1 = present("saga",where); ///////双子//////////
npc2 = present("shura",where);///////山羊/////////
npc3 = present("kamus",where);///////水瓶/////////
if ( !npc1 || userp(npc1) )
        {
        npc1 = find_object(SZ);
        if ( !npc1 ) 
                npc1 = new(SZ);
        npc1->move(where);
        }
if ( !npc2 || userp(npc2) )
        {
        npc2 = find_object(SY);
        if ( !npc2 ) 
                npc2 = new(SY);
        npc2->move(where);
        }
if ( !npc3 || userp(npc3) )
        {
        npc3 = find_object(SP);
        if ( !npc3 ) 
                npc3 = new(SP);
        npc3->move(where);
        }
tell_room(where,npc1->name()+"拿出一串东西，正是加妙的"WHT"百八粒念珠"NOR"。\n");
npc2->command("say 时间的车轮你们是阻挡不了的，让开吧，雅典娜必须死！\n");
npc3->command("nod");
mu->command("hmm");
call_out("story3",3+random(5),me,mu,npc1,npc2,npc3,where);
}

void story3(object me,object mu,object sz,object sp,object sy,object where)
{
if ( !mu || !me || !where || environment(me)!=where 
  || !sz || !sp || !sy  )
        return;
message_vision("$N看到加妙的遗物，不禁睹物思人，悲从心起。\n",me);
me->command("cry");
message_vision("穆拍拍$N的肩膀：少安毋躁，这里头大有文章....\n",me);
message_vision("$N再也顾不得许多，将穆的手一摔，对着三人大喝一声：将加妙还给我！\n",me);
me->kill_ob(sz);
me->kill_ob(sy);
me->kill_ob(sp);
sz->kill_ob(me);
sp->kill_ob(me);
sy->kill_ob(me);
call_out("resets",360,where);
return;
}

void resets(object where)
{
object npc;
if ( !where )
        return;
if ( npc=present("saga",where) && !userp(npc) )
        return;
if ( npc=present("shura",where) && !userp(npc) )
        return;
if ( npc=present("kamus",where) && !userp(npc) )
        return;
where->delete("story");
return;
}

