#include <ansi.h>
inherit ROOM;

void create() {
  string msg;
  set("short", HIY "雅典娜神像" NOR);
  msg = HIY + @LONG
                         .   \._
             .---.     .~/   ./|
            / ,-- \    \ \_-/ / 
    .--.   ( (^_^) )   .--. _~
  ,'    \  (.-`-'(_\___/  ||`.
 /       `-/ \ `.   -'    || \
: (_,' .  / (.\_ ")   . `._) :
|   `-'(_,\ \        ._)`-'~  |
|       .  `.\,O,     .   :|  |
|   . : !   /\_  /\   ! . !|  |
| ! |-'-|  : ""T"" :  |-'-| | |
| |-'   `-'|   H   |`-'   `-| |
`-'        |   H .:|      ||`-'
           | . H !||      ||
           | : H :!|      ||
           | ! H !||      ||
           | | H |||      ||
           | | H |||      ||
           /_,'V.L|.\     ||

LONG;
  msg += "\n" NOR;

  msg = replace_string(msg, "H", NOR HIG "H" NOR HIY);
  msg = replace_string(msg, ".", NOR BLINK HIR "." NOR HIY);
  msg = replace_string(msg, "O", NOR BLINK HIW "O" NOR HIY);

  set("long", msg);
  set("exits", ([
    "out": __DIR__ "palace",
  ]));
  set("no_clean_up", 1);
  set("outdoors", __DIR__);
  setup();
}

void init() {
  add_action("do_blood", "water");
}

void give_gift(object me, object env, object blood) {
  string msg;
  int kar;
  object cloth, book;
  cloth = new(__DIR__ "npc/obj/god_cloth");

  if (!me || !present(me, env))
    return;

  if (!present(blood, me)) {
    tell_object("你的女神血用完了。\n");
    if (me->query_temp("blood_busy")) me->delete_temp("blood_busy");
    return;
  }
  kar = me->query_kar();
  if (random(kar) > 20 && random(3) == 1) {
    if (!present("nvshen shengyi", me))
      cloth->move(me);
    if (present(cloth, me)) {
      message_vision(HIC "\n\n神像忽然化作一件圣衣掉在$N" HIC "手中，" NOR, me);
      msg = WHT "【" NOR HIG " 圣 战 " NOR WHT "】" NOR;
      msg += HIY "$N($I)：$n($i)得到了$W。\n" NOR;
      msg = replace_string(msg, "$N", "里昂");
      msg = replace_string(msg, "$I", "Leon");
      msg = replace_string(msg, "$n", me->query("name"));
      msg = replace_string(msg, "$i", capitalize(me->query("id")));
      msg = replace_string(msg, "$W", NOR HIY "雅典娜圣衣" NOR HIC);
      message("channel:chat", msg, users());
    }
    me->move("/d/city/kezhan");
    message_vision(HIC "。\n\n\n" CYN "$N" CYN "高高兴兴的从圣域返回了。\n" NOR, me);
    return;
  }
  message_vision("\n$N开始慢慢用女神之血擦拭神像。。。\n\n", me);
  blood->add_amount(-1);
  if ((blood->query_amount()) <= 0)
    destruct(blood);
  remove_call_out("give_gift");
  call_out("give_gift", 10 + random(20), me, env, blood);
}

int do_blood(string arg) {
  int i, flag = 0;
  object me, env, blood, guard, *inv;
  env = this_object();
  me = this_player();

  if (!arg || (arg != "神像" && arg != "像" && arg != "statue"))
    return notify_fail(HIR "你要对谁做这个动作？\n" NOR);

  if (!me->query("sds5/gift1")) {
    guard = present("statue guard", env);
    if (!guard) {
      guard = new(__DIR__ "npc/guard");
      guard->move(env);
      tell_room(env, HIB "神像上渐渐凝聚起一阵青烟，化作一个" + guard->name() + HIB "。\n" NOR);
    }
    guard->command("say 想要取圣衣，先过我这关！\n");
    return notify_fail(HIR "你还是安心战斗吧。\n" NOR);
  }

  if (me->is_busy())
    return notify_fail(HIR "你正忙着呢。\n" NOR);

  if (me->query_temp("blood_busy"))
    return notify_fail(HIR "你正擦着呢。\n" NOR);

  inv = all_inventory(env);
  for (i = 0; i < sizeof(inv); i++) {
    if (userp(inv[i]))
      flag++;
  }
  if (flag > 1)
    return notify_fail(HIR "这儿有外人，还是算了吧。\n" NOR);

  blood = present("nvshen's blood", me);
  if (!blood || blood->query("material") != "water")
    return notify_fail(HIR "你身上没有女神之血，在这儿也是浪费时间。\n" NOR);

  message_vision(HIW "\n$N开始慢慢用女神之血擦拭神像。。。\n\n" NOR, me);
  me->set_temp("blood_busy", 1);
  call_out("give_gift", 10 + random(20), me, env, blood);
  return 1;
}
