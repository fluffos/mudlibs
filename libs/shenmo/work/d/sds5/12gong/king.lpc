#include <ansi.h>
inherit ROOM;

string look_yi() {
  object me = this_player();
  if (!me->query_temp("sword_get"))
    return "一张普普通通的" HIY "涂金靠背椅" NOR "，在阳光下锃锃发光。\n";
  me->set_temp("sword_find", 1);
  return "一张" HIY "涂金靠背椅" NOR "，在阳光下锃锃发光。\n
咦？奇怪，椅脚好似有些松动，按(push)一下看看....\n";
}

void create() {
  set("short", HIY "教皇厅" NOR);
  set("long", @LONG

    圣域最高统治者：教 皇 的议会大厅，四周粗壮的大理石柱子高不见顶，
大厅里帷幕重重，正中上方高大的座椅上坐着的真是现任教皇。
    整个大厅常年不见天日，四角的高脚落地蜡烛映衬的整个大厅越加的
庄严，教皇坐在上方冷冷的看着你。

LONG);

  set("exits", ([
    "up": __DIR__ "palace",
    "down": __DIR__ "shuangyu",
  ]));
  set("item_desc", ([
    "座椅": (: look_yi :),
    "chair": (: look_yi :),
    "椅": (: look_yi :),
    "yizi": (: look_yi :),
    "yi": (: look_yi :),
    "zuoyi": (: look_yi :),
  ]));
  set("no_clean_up", 1);
  setup();
}

int valid_leave(object me, string dir) {
  object mu;
  if (!userp(me)) return 1;
  if (me->query_temp("get_sword")) return 1;
  else if (!mu = present("mu"))
    return notify_fail("还是等等穆先生吧。\n");
  else if (me->query("sds5/shinu") != "done")
    return notify_fail("你难道忘记加妙的死了吗？！\n");
  else return 1;
  return ::valid_leave(me, dir);
}

void human(object me, object where) {
  object mu;
  if (!present(me, where))
    return;
  if (mu = present("mu", where) && !userp(mu))
    return;
  mu = find_object("/d/sds5/12gong/npc/baiyang");
  if (!mu)
    mu = new(__DIR__ "npc/baiyang");
  mu->move(where);
  message_vision("穆走了过来。\n", me);
  call_out("check", 5, where, me);
  return;
}

void check(object ob, object me) {
  object mu, npc;
  if (!me || !userp(me))
    return;
  if (me->query("sds5/shinu") != "done") return;

  mu = present("mu", ob);
  if (!mu || userp(mu)) {
    tell_object(me, "还是等等穆先生吧。\n");
    call_out("human", 120, me, this_object());
    return;
  }
  return;
}

int block_cmd(string args) {
  string verb;
  verb = query_verb();
  if (verb == "cast" || verb == "move" || verb == "surrender" ||
    verb == "ji" || verb == "fight" || verb == "apply" ||
    verb == "bian" || verb == "fly" || verb == "map") {
    tell_object(this_player(), "你不由感到一阵迷茫。\n");
    return 1;
  }
  return 0;
}

void init() {
  object ob = this_object();
  object me = this_player();

  add_action("block_cmd", "", 1);
  add_action("do_push", "push");
  add_action("do_push", "an");
  remove_call_out("check");
  if (!userp(me) || me->query_temp("sword_get"))
    return;
  call_out("check", 5, ob, me);
  return;
}

int do_push(string arg) {
  string title;
  int kar;
  object sword;
  object me = this_player();
  object where = this_object();

  if (!arg && arg != "yi" && arg != "椅子" && arg != "chair" && arg != "椅" && arg != "座椅"
    && arg != "zuoyi" && arg != "yizi" && arg != "椅脚" && arg != "脚")
    return notify_fail("你想按什么？\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢。\n");

  message_vision(CYN "$N" CYN "上前按了按座椅的一脚，又用力移了移。\n" NOR, me);
  me->start_busy(3 + random(5));

  if (!me->query_temp("sword_find")) {
    if (random(10) == 1) {
      message_vision(CYN "哗，搬开了，椅子下面居然藏有奥秘......\n" NOR, me);
      call_out("hit", 1 + random(5), me);
      return 1;
    }
    message_vision(CYN "$N拥着座椅左转右转，搞了半天，还是不见什么动静。\n" NOR, me);
    return 1;
  }
  kar = me->query_kar();
  if (random(kar) < 20) {
    message_vision(CYN "哗，搬开了，椅子下面居然藏有奥秘......\n" NOR, me);
    call_out("hit", 1 + random(5), me);
    return 1;
  }
  message_vision(CYN "哗，搬开了，椅子下面居然藏有奥秘......\n" NOR, me);
  if (where->query("open")) {
    message_vision(CYN "里面居然有一个小小的暗格，可惜现在里面是空的，也不知道藏过什么....\n" NOR, me);
    return 1;
  }
  message_vision(CYN "里面居然有一个小小的暗格，里面有个金碧辉煌的" NOR HIY "黄金短剑" CYN "！\n" NOR, me);
  sword = new(__DIR__ "npc/obj/sword");
  sword->move(me);
  if (present(sword, me)) {
    title = WHT "【" NOR HIB "圣战" NOR HIY "十二宫" NOR HIB "之卷" NOR WHT "】" NOR;
    title += HIC "雅典娜(Athena)：" + me->query("name") + HIC "助我寻得了" + sword->name() + HIC "。\n" NOR;
    title += WHT "【" NOR HIB "圣战" NOR HIY "十二宫" NOR HIB "之卷" NOR WHT "】" NOR;
    title += HIC "里昂(Leon)：该来的还是终于来了，神也躲不掉....\n" NOR;
    message("channel:chat", title, users());
    tell_object(me, HIY "赶紧将宝剑交给女神吧。\n" NOR);
    me->delete_temp("sword_find");
    me->delete_temp("sword_get");
    me->set_temp("get_sword", 1);
    where->set("open", 1);
    call_out("resets", 1200, where);
    if (me->query("sds5/king") != "done")
      me->set("sds5/king", "done");
    me->save();
  }
  return 1;
}

void hit(object me) {
  int damage;

  if (!me || !present(me, this_object()))
    return;

  damage = me->query("max_kee");
  damage = damage / 2 + random(damage / 2);
  message_vision(RED "\n\n忽然从椅下暗格中射出" + chinese_number(damage / 5) + RED "排小箭！\n" NOR, me);
  if (random(2) == 1) {
    message_vision(RED "$N" RED "躲闪不及，给射了正着！\n\n" NOR, me);
    me->receive_damage("kee", damage);
    COMBAT_D->report_status(me);
    return;
  }
  message_vision(RED "$N" RED "见势不好，无奈之下避过要害，硬挨了一击！\n\n" NOR, me);
  damage = random(damage / 2);
  me->receive_damage("kee", damage);
  COMBAT_D->report_status(me);
  return;
}

void resets(object where) {
  if (where->query("open"))
    where->delete("open");
  tell_room(where, "座椅好似动了动....\n");
  return;
}
