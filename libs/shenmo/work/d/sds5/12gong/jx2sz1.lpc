void find_corpse(object me,object mu,object here)
{
int i=1;
object corpse; 
if ( !me || !mu || environment(me)!=here )
        return;
me->set_temp("sds5/find_corpse",1);
for ( i;i<=3;i++ )
        {
        corpse= new(__DIR__"npc/obj/corpse");
        corpse->set_name("来历不明的尸体",({"corpse"}));
        corpse->set("gender","男性");
        corpse->set("age",16+random(14));
        corpse->set("num",i);
        corpse->set("long","一具尸体，死者来历不明，很是蹊跷....\n");
        corpse->save();
        corpse->move(here);
        }
mu->command("say 看，这些尸体....\n");
me->command("??");
mu->command("say 去查查(inspect)看这些尸体的来历。\n");
return;
}

void mu_go(object me,object mu,object here)
{
if ( !me || environment(me)!=here ) 
        return;
mu = present("mu",here);
if ( mu && !userp(mu) )
        return;
else    mu = find_object("/d/sds5/12gong/npc/baiyang");
if ( !mu )
        mu = new("/d/sds5/12gong/npc/baiyang");
mu->move(here);
message_vision("$N走了过来。\n",mu,me);
mu->set_leader(me);
return;
}

