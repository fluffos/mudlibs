inherit ROOM;
#include <ansi.h>

void create ()
{
set ("short", "第一宫：白羊宫");
set ("long", HIW+@LONG

    :iW$$$$Wi:          :uWW$$$WWx
  :W$$$####$$$$W:    :i$$$$*###*$$$x
  $$$?      ~#$$$X  :$$$#~      ~$$$
  $$$          $$$X:$$$~         8$$!
  #$$i  ~      ~$$$$$$!   :   ~ x$$$
   #$$$WWi$$    ?$$$$$    8$WiW$$$#
     ~""""      ~$$$$!      """""
                 $$$$~  菲利塞斯(Phrixus)乃奈波勒(Nepele)之子，
                 $$$$~蒙上奸污碧雅蒂□ (Biadice)的不白之冤，而被判处死刑，
                 $$$$:临刑之前一只金色的公羊及时将他和妹妹海□(Helle) 一
                 $$$$~起背走不幸的是，妹妹因不胜颠簸，一时眼花落下羊背，
                ~$$$$ 菲利塞斯则安然获救，他将公羊献给宙斯当祭礼，宙斯将
                 ?$$? 它的形象化为天上的星座。后来杰生为了夺取这金羊的羊
                      毛，还展开了一段精彩的冒险故事。

LONG+NOR);


set("exits", ([
        "northup"  :   __DIR__"by2jn1",
        "eastdown" :   __DIR__"toby2",
]));

set("objects", ([
        __DIR__"npc/baiyang" : 1,
        ]));
set("outdoors", 1);
setup();
}

int valid_leave(object me, string dir)
{
object mu;
mu = present("mu",this_object());

if ( !mu || userp(mu) )
        {
        call_out("resets",5+random(5),this_object());
        return notify_fail("穆先生呢?\n");
        }
else if ( !userp(me) ) return 1;
else    {
        if ( present("leon")  )
                return notify_fail("里昂冷笑一声：先过我这关再说！\n");
        else if ( me->query("sds5/baiyang")!="done" )
                {
                call_out("story",1,me,mu);
                return notify_fail("穆拦住了你的去路：等等看，夜晚的圣域好似有不寻常的力量出现！\n"); 
                }
        }
return ::valid_leave(me, dir);
}

int do_kill(string arg)
{
int i;
object where = this_object();
object me = this_player();

if ( !arg )
        {
        tell_object(me,"你想杀谁？\n");
        return 1;
        }
else if ( arg=="mu" )
        {
        tell_object(me,"穆对你轻蔑一笑，你不禁流了一背的冷汗，再也下不去手。\n");
        return 1;
        }
else if ( !(int)where->query("story_end") )
        {
        tell_object(me,"还是先静观其变......\n");
        return 1;
        }
else if ( arg=="leon" )
        {
        if ( present("aphrodite",where) || present("death mask",where ) )
                {
                tell_object(me,"先将阿布罗狄和迪斯马斯克解决了吧。\n");
                return 1;
                }
        else return 0;
        }
else return 0;
}

int do_cast(string arg)
{
string dir;
object me = this_player();
if ( !arg )
        {
        tell_object(me,"你要用什么法术？\n");
        return 0;
        }
if( sscanf(arg, "shou on %s", dir)==1 
  ||sscanf(arg, "huimeng on %s", dir)==1 
  ||sscanf(arg, "qiankun on %s", dir)==1  
  ||sscanf(arg, "heijie on %s", dir)==1  
  ||arg=="huimeng"
  ||arg=="qiankun"
  ||arg=="heijie"
  ||arg=="chuqiao"
  ||arg=="shiyue" 
  ||arg=="yinshen" )  //容易引起bug的法术限制使用，欢迎补遗...
        {
        tell_object(me,"你结结巴巴的念动了几句咒语......还是算了......\n");
        return 1;
        }
return 0;
}

int do_none()
{
if ( present("leon",this_object()) )
        {
        message_vision("里昂骄傲的说：“没有人可以违背我的意愿！”\n",this_player());
        return 1;
        }
else if( present("mu",this_object()) )
        {
        message_vision("穆对$N摇了摇头。\n",this_player());
        return 1;
        }
return 0;
}

void init()
{
object me = this_player();
add_action("do_cast", "cast");
add_action("do_pfm", "perform");
add_action("do_none", "ji");
add_action("do_none", "fight");
add_action("do_none", "steal");
add_action("do_none", "recall");
add_action("do_none", "whisper");
add_action("do_none", "surrender");
add_action("do_none", "bian");
add_action("do_none", "get");
add_action("do_none", "give");
add_action("do_none", "move");
add_action("do_none", "burn");
add_action("do_kill","kill");

if ( (int)me->query_temp("yinshentime") )
        {
        me->delete_temp("yinshentime");
        me->delete("env/invisibility");      
        me->save();
        me->delete_temp("no_heal_up/yinshen");
        message_vision(HIW"\n白光闪过之后，$N又现出了身形。\n\n"NOR, me);
        }
if ( me->query("sds4/king")!="done" & userp(me) )
        {
        message_vision(HIY"穆先生对$N说道“圣域现在有事发生，你还是回吧！”\n说罢$N被念力送出了白羊宫！\n"NOR,me);
        me->move("/d/city/kezhan");
        message_vision(HIY"白光有一闪，$N出现在大家的面前，世界真奇妙！\n"NOR);
        me->unconcious();       
        }
}

void story(object me,object mu)
{
int i;
int dayphase =NATURE_D->query_current_day_phase();
object *inusers,envroom;
object leon = new(__DIR__"npc/leon");
object where = this_object();

inusers=users();

/********************************************************/
/*======================只有在夜晚才发生剧情==============*/
/********************************************************/

if ( !mu || !me || environment(me)!=this_object() )
        return;

if ( (int)where->query("story") )
        return;

if ( !me->query_temp("sds5/start") || me->query("sds5/baiyang")=="done" )
        return;

where->set("story",1);

if ( !wizardp(me) )
        {
//        if ( dayphase<0 )
if ( me )
                {
                random(2)?
                mu->command("say 圣域这几天有不可思议的事发生，难道是那家伙？！\n"):
                mu->command("say 雅典娜决定要封住前往圣域的路了......\n");
                remove_call_out("story_mu");
                call_out("story_mu",300,mu,me);
                return ;
                }
        }

/********************************************************/
/*=====================里昂出场=========================*/
/********************************************************/

if ( !present(leon,where) )
        {
        leon->move(where);
        leon->set_name("神秘人",({"shenmi ren"}));
        leon->set("title","黑影");
        leon->set("long","一个神秘的人物，他的脸隐藏在黑暗的斗篷之下看不真切。\n");
        for (i;i<sizeof(inusers);i++)
                {
                envroom=environment(inusers[i]);
                if (envroom)
                        tell_object(inusers[i],HIB"夜深了，广漠的天地现在是属于黑暗的了。\n"NOR);
                }
        message_vision(HIB"黑暗中，慢慢踱出一人,他的脸在深深的斗篷下面，看不真切！\n"NOR,this_player());
        mu->command("?");
        mu->command("say 阁下是谁？这里是圣域的禁地，止步吧！\n");
        leon->command("hmm mu");
        leon->command("say 在圣域中，没有我不可去的地方！没有人可以阻止我，尤其是你！穆......，你可以违抗我吗？！\n");
        remove_call_out("story_mu");
        call_out("story_leon",3+random(5),leon,mu,me,where);
        }
return;
}

void story_leon(object leon,object mu,object me,object where)
{
if ( !mu || !leon || !me )
        return;

message_vision(CYN"说罢，"+leon->name()+"慢慢从黑暗中走了出来！他的脸慢慢露了出来，居然是！！！\n"NOR,this_player());
call_out("story_leon2",2+random(3),leon,mu,me,where);
}

void story_leon2(object leon,object mu,object me,object where)
{
if ( !mu || !leon || !me )
        return;

leon->set_name("里昂",({"leon"}));
leon->set("title", HIY"金羊宫黄金圣斗士"NOR);
leon->set("long", HIW"传说中的金羊宫黄金战士，前教皇，在黄道12宫一篇中为亚历士所害。\n"NOR);

mu->command("ah");
mu->command("say 里昂？！！\n");
leon->command("say 穆！让开吧，将雅典娜的命交于我手！\n");
call_out("story2",3+random(5),leon,mu,me,where);
return;
}

void story2(object leon,object mu,object me,object where)
{
object juxie = new(__DIR__"npc/juxie");
object shuangyu = new(__DIR__"npc/shuangyu");
/********************************************************/

if ( !present(shuangyu,where) )
        shuangyu->move(where);
if ( !present(juxie,where) )
        juxie->move(where);
message_vision(HIB"黑暗中，又走出两人，居然是"+shuangyu->name()+"和"+juxie->name()+"！\n"NOR,this_player());
mu->command("ah mu");
mu->command("say 你们......你们竟然将生命献给了哈第斯？！\n");
where->save();
call_out("story_end",3+random(3),shuangyu,juxie,leon,mu,me);
return ;
}

void story_end(object shuangyu,object juxie,object leon,object mu,object me)
{
shuangyu->command("think");
juxie->command("say 我要取穆的首级！");
leon->command("say 穆！不要轻举妄动！\n");
this_object()->set("story_end",1); //防止剧情未完成，player就开杀 :)
this_object()->save();
call_out("resume",120,this_object());
me->command("say 无胆鼠类，你们的性命就交给我吧！！\n");
me->kill_ob(shuangyu);
me->kill_ob(juxie);
shuangyu->kill_ob(me);
juxie->kill_ob(me);
call_out("resets",300,this_object());
return;
}

void resets(object env)
{
if ( env->query("story") )
        env->delete("stroy");
env->reset();
return;
}

