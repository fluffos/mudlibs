#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIY "第二宫金牛座" NOR);
  set("long", HIY + @LONG

    经希腊哈莫尼亚地方的贝纳斯河，国王贝纳斯有位美丽的公主赫洛蓓。有一天，
公主和侍女们到野外摘花，玩耍，突然出现一只如雪花般洁白的牛，以级温柔的眼光望着
赫洛蓓，其实这只牛是仰慕公主美色的宙斯变的。一开始公主的确大吃一惊，但仍走向温
驯的牛只身旁，轻轻抚摸它。由于公牛显得非常乖巧而温驯，于是公主就放心的爬到牛背
上试骑，忽然间牛奔跑了起来，最后跳进爱琴海。公主紧抱着牛，海里生物皆出来向宙斯
行礼，公主终于知道牛是宙斯的化身，到了克里特岛后，就和宙斯举行婚礼，化身为牛的
宙斯和赫洛蓓公主过着幸福的日子。

LONG + NOR);

  set("exits", ([
    "westup": __DIR__ "jn2sz1",
    "northdown": __DIR__ "by2jn2",
  ]));
  set("no_clean_up", 1);
  setup();
}

int valid_leave(object me, string dir) {
  string title;
  object mu;
  title = WHT "【" NOR HIB "圣战" NOR HIY "十二宫" NOR HIB "之卷" NOR WHT "】" NOR;
  title += HIC + "$1($i)：" NOR;
  title = replace_string(title, "$1", "童虎");
  title = replace_string(title, "$i", "Dohko");
  title += HIC "金牛座亚鲁迪巴卒于其守护宫！\n" NOR;
  if (userp(me)) {
    if (me->query("sds5/jinniu") != "done") {
      mu = present("mu", this_object());
      if (!mu || userp(mu))
        return notify_fail("还是等等穆先生吧。\n");
      mu->command("say 慢着，好象有点不对劲。\n");
      return notify_fail("穆停了下来，警惕的看着四周！\n");
    } else {
      message("channel:chat", title, users());
      return 1;
    }
  } else if (me->query("id") == "mu")
    return 1;
  else
    return ::valid_leave(me, dir);
}

void init() {
  object corpse;
  object me = this_player();
  add_action("do_none", "move");
  add_action("do_none", "mark");
  add_action("do_none", "perform");
  add_action("do_none", "cast");
  add_action("do_none", "ji");
  add_action("do_none", "bian");
  add_action("do_none", "steal");
  add_action("do_none", "recall");
  add_action("do_none", "get");
  if (!userp(me))
    return;
  if (me->query("sds5/jinniu") != "done") {
    if (!present("aldebaran", this_object())) {
      corpse = new(__DIR__ "npc/jinniu");
      corpse->move(this_object());
      message_vision("只见前方一人，傲然而立，迎风不动，虎目圆睁，却是" HIY "金牛座黄金圣斗士" NOR "亚鲁迪巴!\n", me);
    }
    if (random(5) == 1)
      message_vision("穆好似稍有所思。\n", me);
  }
  return;
}

int do_none() {
  object me = this_player();
  message_vision("四下的空气中好似弥漫着异样的因素！\n", me);
  return 1;
}
