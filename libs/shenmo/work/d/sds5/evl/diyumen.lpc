#include <ansi.h>
inherit ROOM;
#include "road.h"

void create ()
{
string msg;
set("short", "地狱门");
msg = HIY+@LONG
  
              .--.
              _|__  
             /    \ 
          __|  []  |__
          |__________|                            
          |   ____   |        
          |  |\  /|  |        
          |  | \/ |  |       
          |  | /\ |  |        
          |__|/__\|__|
这里是冥界的大门，门上写着：“凡入此门者，必先舍弃希望……”

LONG;
msg = replace_string(msg,".",NOR BLINK RED"."NOR HIY);
msg = replace_string(msg,"这里是冥界的大门，门上写着：“",NOR YEL"这里是冥界的大门，门上写着：“"NOR HIY);
msg = replace_string(msg,"凡入此门者，必先舍弃希望……",NOR HIB"凡入此门者，必先舍弃希望……"NOR HIY);
msg = replace_string(msg,"”",NOR YEL"”"NOR HIY);
msg+= "\n"NOR;
set("long",msg);
set("exits", ([
        "southdown"     :       __DIR__"river",
]));                                                                                                                          
setup();                                                           
}

