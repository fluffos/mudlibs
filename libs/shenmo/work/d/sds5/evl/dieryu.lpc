#include <ansi.h>
inherit ROOM;
#include "looks.h"

void create() {
  string msg;
  set("short", "第二狱");
  msg = BLU + @LONG

            /\_/\____,
  ,___/\_/\ \  ~     /
  \     ~  \ )   XXX
    XXX     /    /\_/\___,
       \o-o/-o-o/   ~    /
        ) /     \    XXX
       _|    / \ \_/
    ,-/   _  \_/   \
   / (   /____,__|  )
  (  |_ (    )  \) _|
 _/ _)   \   \__/   (_
(,-(,(,(,/      \,),),)

LONG;
  msg = replace_string(msg, "X", NOR WHT "X" NOR BLU);
  msg = replace_string(msg, ",", NOR HIR "," NOR BLU);
  msg = replace_string(msg, "o", NOR BLINK HIY "o" NOR BLU);
  msg += NOR YEL "\n
这里就是冥界第二狱----犯贪婪的罪人，要被重而冷的雨吹打，还要
做看守的地狱犬的粮食。\n" NOR;
  msg = replace_string(msg, "第二狱", NOR RED "第二狱" NOR YEL);
  msg = replace_string(msg, "地狱犬", NOR HIM "地狱犬" NOR YEL);
  set("long", msg);
  set("exits", ([
    "westdown": __DIR__ "huatian",
    "eastup": __DIR__ "fenggu",
  ]));
  set("objects", ([
    //      __DIR__"npc/" : 1,
  ]));
  set("broadcast", 1);
  setup();
}
