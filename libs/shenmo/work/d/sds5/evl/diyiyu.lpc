#include <ansi.h>
inherit ROOM;

#define R_D "/d/sds5/evl/npc/rankd.lpc"

void create()
{
string message_vision;
set("short","第一狱");
message_vision = HIY+@LONG

             /\                  /\                  /\
            /  \                /  \                /  \
           / o  \              / o  \              / o  \
          /   o  \            /   o  \            /   o  \ 
         /  o   . \          /  o   . \          /  o   . \
        /      o  x\        /      o  x\        /      o  x\
       /  x   o   o \      /  x   o   o \      /  x   o   o \
      /     o        \    /     o        \    /     o        \
     /  %  o     x .  \  /  %  o     x .  \  /  %  o     x .  \
    / ______第________ \/ _______一_______ \/ _______狱_______ \   
      |_| /    \ |___|     |_| /    \ |___|   |_| /    \ |___|
      |_| /    \ |___|     | | /    \ |___|   |_| /    \ |___| 
      |_| /    \ |___|     |_| /    \ |___|   |_| /    \ |___| 
      |_| /    \ |___|     |_| /    \ |___|   |_| /    \ |___| 
      |_| /    \ |___|     |_| /    \ |___|   |_| /    \ |___| 
      |_| /    \ |___|     |_| /    \ |___|   |_| /    \ |___| 
      |_| /    \ |___|     |_| /    \ |___|   |_| /    \ |___| 

LONG+NOR;
message_vision+= YEL"这里就是冥界第一狱----审判死者的法庭，在这里就算是说谎也会被立刻看穿\n"NOR;
message_vision = replace_string(message_vision,"第",NOR HIR"第"NOR HIY);
message_vision = replace_string(message_vision,"一",NOR HIM"一"NOR HIY);
message_vision = replace_string(message_vision,"狱",NOR HIR"狱"NOR HIY);
message_vision = replace_string(message_vision,"x",NOR BLINK WHT"x"NOR HIY);
message_vision = replace_string(message_vision,"o",NOR BLINK RED"o"NOR HIY);
message_vision = replace_string(message_vision,".",NOR BLINK HIG"."NOR HIY);
message_vision = replace_string(message_vision,"----审判死者的法庭，在这里就算是说谎也会被立刻看穿",NOR YEL"----审判死者的法庭，在这里就算是说谎也会被立刻看穿"NOR YEL);
message_vision = replace_string(message_vision,"%",NOR BLINK HIC"%"NOR HIY);
set("long",message_vision);
set("exits", ([
      "westdown": __DIR__"fengzhigu",
      "out": __DIR__"yi",
]));
set("objects", ([ 
        __DIR__"npc/luni" : 1,
]));
set("no_clean_up",1);
set("broadcast",1);
setup();
}

void init()
{
object npc,me,env;
me = this_player();
env = this_object();
if ( !userp(me) ) return;
npc = present("luni",env);
if ( !npc || userp(npc) )
        {
        npc = find_object(__DIR__"npc/luni");
        if ( !npc ) 
                npc = new(__DIR__"npc/luni");
        npc->move(env);
        }
message_vision(CYN"开庭开庭！内廷传出一阵嘈杂之音，一人怒喝一声：安静！四下寂然....\n\n\n"NOR,me);
message_vision(CYN"路尼从内堂走了出来。\n"NOR,me);
me->start_busy(3);
call_out("law",2+random(3),me,npc,env);
return;
}

void law(object me,object npc,object env)
{
int i,kar;
object weapon,guard,*who;
string w_name;
if ( !me || !present(me,env) || env->query("law") )
        return;
if ( !npc || userp(npc) )
        {
        npc = find_object(__DIR__"npc/luni");
        if ( !npc ) 
                npc = new(__DIR__"npc/luni");
        npc->move(env);
        }
env->set("law",1);
call_out("resets",300,env);
npc->command("say "+R_D->selfs(npc)+"现在开庭!\n");
message_vision("$N自言自语不知道在说些什么。\n",me);
message_vision("路尼对$N一瞪眼："+R_D->jianchen(me)+"人不大胆子不小，居然敢在我的法庭上擅自发出声响！！\n",me);
message_vision("路尼大喝一声：人来，将这"+R_D->jianchen(me)+"打下拔舌地狱！\n",me);
message_vision("众幽魂一拥而上。\n",me);

who = all_inventory(env);
for ( i=0;i<sizeof(who);i++ )
        {
        if ( !userp(who[i]) && who[i]->query("id")!="luni" )
                guard = who[i];
        if ( guard )
                {
                message_vision("$N神秘兮兮的对着四下一竖食指：“嘘，小声点，路尼大人听到了会不高兴的。”\n",guard);
                message_vision("路尼上前一鞭打得$N皮开肉绽“叫你不要说话！还说，不给我面子啊！”\n",guard);
                message_vision("$N惨号一声，死了。\n",guard);
                guard->die();
                }
        }
kar = me->query_kar();
kar-= random(20);
if ( kar<10 )
        {
        message_vision(CYN"\n一阵鬼哭狼嚎中，$N"CYN"被一群隐约可见的幽灵簇拥而走。\n\n"NOR,me);
        me->add_temp("diyiyu",600);
        me->set_temp("old_room",this_object());
        me->save();
        me->move(__DIR__"lao");
        message_vision(CYN"\n到了，众人将$N"CYN"放地上一摔，径直去了。\n"NOR,me);
        }
else    {
        if ( weapon=me->query_temp("weapon") )
                w_name=weapon->name();
        else    w_name=random(2)?"双拳":"双掌";
        message_vision("$N挥动"+w_name+"打散众幽魂，大喝一声：今日"+R_D->selfs(me)+"便要拆了你的招牌。\n",me);
        if ( me->query("sds5/one")=="done" )
                {
                npc->command("say 原来是这个"+R_D->jianchen(me)+"....\n");
                npc->command("escape luni");
                destruct(npc);
                return;
                }
        me->kill_ob(npc);
        npc->kill_ob(me);
        }
return;
}
                        
void resets(object env)
{
if ( env->query("law") )
        env->delete("law");
env->reset();
env->save();
}

int valid_leave(object me, string dir)
{
if ( present("luni") || me->query("sds5/one")!="done" )
        return notify_fail("还是先打败第一狱的路尼再说吧。\n");
return ::valid_leave(me, dir);
}

