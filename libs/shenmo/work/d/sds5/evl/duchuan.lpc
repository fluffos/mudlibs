// 神话世界·西游记·版本（世纪）
/* <SecCrypt CPL V3R05> */

#include <ansi.h>
inherit ROOM;
#include "looks.h"

void create()
{
set("short",HIB"黄泉"NOR YEL"摆渡船"NOR);
set("long", WHT+@LONG
一叶小舟，最多也就能载七、八个人。天间星加路
手持长竹篙，正在船尾撑船。
LONG+NOR);
set("broadcast",1);
setup();
}

int valid_leave(object me, string dir)
{
object npc;
if ( !userp(me) ) return 1;
if ( !userp(npc=present("jialu")) )
                return notify_fail(CYN"加路一把拦住你：没钱就想过河？！\n"NOR);
return ::valid_leave(me, dir);
}

void init()
{
add_action("do_han","han");
}

int do_han(string arg) 
{
object me = this_player();
object room = this_object();

if ( !arg ) 
  return notify_fail("你要喊什么？\n");

message_vision("\n$N扯开嗓子喊道："+arg+"....\n",me);
if ( arg=="靠岸" && !present("jialu") )
   {
   message_vision("小船向着来时的路驶去.....\n",me);
   call_out("on_broad",5+random(5),me,room);
   return 1;
   }
return 1;
}

void on_broad(object me,object room)
{
if ( !me || !present(me,room) )
   return;
message_vision("\n\n到了！小船一震，到了岸边。\n\n",me);
me->move(__DIR__"river");
message_vision("\n\n$N急不可耐的跳下船去。\n",me);
me->command("out");
}

