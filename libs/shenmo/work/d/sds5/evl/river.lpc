:/* <SecCrypt CPL V3R05> */
///////////////////////////////////////////////////////////

#include <ansi.h>
inherit ROOM;
#include "looks.h"
#define NAMES_D  __DIR__"named.lpc"

void check_trigger();
void on_board();
void arrive(object npc);
int do_yell(string arg);
void reset();
void dismiss_ghost(object ghost);
void remove_zou(object room);

void create()
{
string msg;
set("short",YEL"三途河"NOR);
msg = YEL+@LONG

              |    |    |
             )_)  )_)  )_)
            )___))___))___)\
           )____)____)_____)\\
         _____|____|____|____\\\__
---------\                   /---------
  ^^^^^ ^^^^^ ^^^^  ^^^^^^^  ^^^^^    ^^^
         ^^^^     ^^^     ^^^    ^^^    ^^^
这里就是三途河了，也就是所谓的冥河或是黄泉。在华夏则称为奈何桥

LONG;
msg+="\n"NOR;
random(2)?
msg = replace_string(msg,"^",NOR BLINK RED"^"NOR YEL):
msg = replace_string(msg,"^",NOR BLINK HIR"^"NOR YEL);
msg = replace_string(msg,")",NOR WHT")"NOR YEL);
msg = replace_string(msg,"|",NOR HIM"|"NOR YEL);
msg = replace_string(msg,"_",NOR WHT"_"NOR YEL);
msg = replace_string(msg,"三途河",NOR HIB"三途河"NOR YEL);
msg = replace_string(msg,"冥河",NOR RED"冥河"NOR YEL);
msg = replace_string(msg,"黄泉",NOR RED"黄泉"NOR YEL);
msg = replace_string(msg,"奈何桥",NOR WHT"奈何桥"NOR YEL);
msg = replace_string(msg,"华夏",NOR HIY"华夏"NOR YEL);

set("long",msg);
set("item_desc", ([
        "boat"  :       "一叶扁舟，也许喊(yell)一声船家就能听见。\n",
        "river":        "有一叶扁舟，也许喊(yell)一声船家就能听见。\n",
        "河"    :       "有一叶扁舟，也许喊(yell)一声船家就能听见。\n",
        "三途河":       "有一叶扁舟，也许喊(yell)一声船家就能听见。\n",
        "冥河"  :       "有一叶扁舟，也许喊(yell)一声船家就能听见。\n",
        "黄泉"  :       "有一叶扁舟，也许喊(yell)一声船家就能听见。\n",
])); 
set("objects", ([ 
        __DIR__"npc/jialu" : 1,
]));
set("broadcast",1);
setup();
}

void init()
{
add_action("do_yell", "yell");
add_action("do_yell", "han");
}

void check_trigger()
{
object room;

if( query("exits/enter") ) 
        {
        message("vision",YEL"\n加路说道：正等着你呢，上来吧。\n"NOR,this_object() );    
        return;
        }
if( !(room=find_object(__DIR__"duchuan")) )
        room=load_object(__DIR__"duchuan");
if( room=find_object(__DIR__"duchuan") ) 
        {
        if( room->query("yell_trigger")==0 ) 
                {
                room->set("yell_trigger", 1);
                set("exits/enter", __DIR__"duchuan");
                room->set("exits/out", __FILE__);
                message("vision",YEL"一叶扁舟缓缓地驶了过来，加路将一块踏脚板搭上海滩，以便乘客上下。\n"NOR, this_object() );
                message("vision",YEL"\n加路将一块踏脚板搭上海滩，形成一个向上的阶梯。\n"NOR,room);
                remove_call_out("on_board");
                call_out("on_board",5+random(5));
                }
        else    message("vision",YEL"只听得海面上隐隐传来：“别急嘛，这儿正忙着呐……”\n"NOR,this_object() );
        }
else    message("vision", "ERROR: boat not found\n", this_object() );
return;
}

void on_board()
{
object npc;
if( !query("exits/enter") ) return;
npc = present("jialu",this_object());
if ( !npc )
        {
        npc = find_object(__DIR__"npc/jialu");
        if ( !npc )
                npc = new(__DIR__"npc/jialu");
        if ( objectp(environment(npc)) )
                tell_room(environment(npc),YEL"远方传来叫喊船家的声音，加路嘿嘿一笑：生意来了......\n"NOR);
        npc->move(this_object());
        tell_room(this_object(),"加路走了过来。\n");
        }
npc->command("enter");
remove_call_out("to_river");
call_out("to_river",15+random(15),npc);
return;
}

void to_river(object npc)
{
object room;
if ( !npc ) return;
message("vision",YEL"\n加路把踏脚板收了起来，竹篙一点，扁舟向波涛中驶去。\n"NOR,this_object() );
if( room=find_object(__DIR__"duchuan") )
        {
        room->delete("exits/out");
        message("vision",YEL"\n加路把踏脚板收起来，说了一声“坐稳喽”，竹篙一点，扁舟向\n波涛中驶去。\n"NOR,room);
        }
delete("exits/enter");
remove_call_out("arrive");
remove_call_out("do_kill");
call_out("do_kill",1+random(4),this_player(),npc,room);
call_out("arrive",15+random(25),npc);
}

void arrive(object npc)
{
object river,room,me;
me = this_player();

if( room = find_object(__DIR__"duchuan") )
        {
        room->set("exits/out", "/d/mingjie/yi");
        room->save();
        if ( npc && present(me,room) && me->query("sds5/river")!="done" )
                {
                npc->command("say 嘿嘿，到了冥河彼岸了，居然还打不赢我，真是丢人!\n");
                message_vision("$N不禁露出一丝羞愧之色。\n",me);
                message_vision("$N大声说道：士可杀不可辱，这船我不坐了！\n",me);
                message_vision("说罢,$N头也不回，纵身跳进了冥河之中！\n",me);
                message_vision(HIY"$N"HIY"纵身一跃，跳入海中。只见$N"HIY"使足了全身力气，
手足并用，不一会儿就游回了"+this_object()->query("short")+HIY"。\n"NOR,me);
                me->delete_temp("river_gived");
                me->save();
                me->move(this_object());
                message_vision(HIY"\n\n只见$N"HIY"浑身湿漉漉地从海里爬了上来。\n\n"NOR,me);
                }
        message("vision",YEL"“到啦，上岸吧”，随即一块踏脚板自动搭上海滩。\n"NOR,room );
        call_out("remove_zou",5+random(5),room);
        }
return;
}

void remove_zou(object room)
{
if ( !room->query("yell_trigger") )
        return;
remove_call_out("remove_zou");
room->delete("exits/out");
message("vision",YEL"踏脚板自动收了起来，扁舟驶回波涛中。\n"NOR, room);
room->delete("yell_trigger"); 
room->save();
return;
}

int do_yell(string arg)
{
mapping name;
string dir,id,str,room_name;
object ghost;
object me = this_player();

if( !arg || arg=="" ) return notify_fail("你要吆喝什么？\n");

if ( sscanf(arg,"%s %s",id,str)==2 )
        {
        ghost=find_player(id);
        if ( !ghost )
                return notify_fail("没这个人。\n");
            room_name = environment(ghost)->query("short");
          message("vision",me->name()+"朝着"+room_name+"方向，喊了一声："+str+"。\n",this_object(),me);
          tell_object(me,"你仰头对着"+room_name+"方向一阵哀号....\n");
        message("vision","隐隐约约从地底传来一阵鬼哭狼嚎，"+ghost->name()+"闻言，打了冷战。\n",environment(ghost),ghost);  
        tell_object(ghost,"隐隐约约有鬼魂之声在你耳边响起:"+str+"\n");
        return 1;
        }

if( arg=="boat" ) arg = "船家";

if( me->query("age") < 16 )
        message_vision(YEL"$N"YEL"使出吃奶的力气喊了一声：“"+arg+"”\n",me);
else if( me->query("force") < 500 )
        message_vision(YEL"$N"YEL"吸了口气，一声“"+arg+"”，声音中正平和地远远传了出去。\n"NOR,me);
else    message_vision(YEL"$N"YEL"鼓足中气，长啸一声：“"+arg+"！”\n"NOR,me);

if( arg=="船家" && me->query_temp("river_gived") )
        {
        check_trigger();
        return 1;
        }
else if ( ( arg=="亲爱的" || arg=="dear" ) && !query("ghost") )
        {
        ghost = new(__DIR__"npc/ghost");
        if ( me->query("gender")=="男性" )
                {
                name = NAMES_D->random_name(1, 0, 0, 0, 0);
                if( !name )
                        name = ([ "name": "如花",  "id": ({ "ru hua" }) ]);
                ghost->set_name(name["name"],name["id"]);
                ghost->set("title","女鬼" );
                ghost->set("gender","女性" );
                }
        else    {
                name = NAMES_D->random_name(0, 0, 0, 0, 0);
                if( !name )
                        name = ([ "name": "小强",  "id": ({ "xiao qiang" }) ]);
                ghost->set_name(name["name"],name["id"]);
                ghost->set("title","男鬼" );
                ghost->set("gender","男性" );
                }
        ghost->save();
        ghost->move(this_object());
        message_vision(CYN"\n\n一阵阴风卷起，平地卷起一道灰尘，一个人影出现在浓雾中。\n\n"NOR,me);
        ghost->command("say 谁叫我？\n");
        set("ghost",1);
        call_out("dismiss_ghost",10+random(50),ghost);
        return 1;
        }       
else
        message_vision(HIM"\n\n江面上远远传来一阵回声：“" +arg+"～～～”\n\n"NOR,me);
return 1;
}

int valid_leave(object me, string dir)
{
if ( !userp(me) ) return 1;
else if ( dir=="enter" )
        {
        if ( !me->query_temp("river_gived") )
                return notify_fail(CYN"加路一把拦住你：没钱就想过河？！\n"NOR);
        else if ( present("jialu",this_object()) )
                return notify_fail(CYN"加路把眼一瞪：爷爷我还没上船，你就想上？！\n"NOR);
        else    {
                tell_object(me,HIY"\n在船靠岸之前务必要将加路打败！\n"NOR);
                return 1;
                }
        }       
return ::valid_leave(me, dir);
}

void dismiss_ghost(object ghost)
{
if ( !ghost )
        return;
tell_room(environment(ghost),CYN"一阵阴风刮起，"+ghost->name()+CYN"抬头看看上方惨淡的光线，依依不舍
的消失在风中....\n"NOR);
delete("ghost");
destruct(ghost);
return;
}

void do_kill(object me,object npc,object where)
{
if ( !me || !npc || !present(me,where) || !present(npc,where) )
        return;
npc->command("say 嘿嘿，反正已经死了，身上值钱的东西全留下来吧！\n");
tell_object(me,HIR"\n\n务必在船靠岸之前打败加路！\n\n"NOR);
me->kill_ob(npc);
npc->kill_ob(me);
return;
}


