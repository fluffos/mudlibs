#include <ansi.h>
inherit ROOM;
#include "road.h"
#include "looks.h"

void create ()
{
string msg;
set ("short", "黑色疾风之谷");
msg = YEL+@LONG
  
这是通往第二狱的通道：黑色疾风之谷，爱欲的罪人将
被风吹气，永远在风地狱受苦

LONG+NOR;
msg = replace_string(msg,"第二狱",NOR HIB"第二狱"NOR YEL);
msg = replace_string(msg,"黑色",NOR BLU"黑色"NOR YEL);
msg = replace_string(msg,"疾风",NOR WHT"疾风"NOR YEL);
msg = replace_string(msg,"风地狱",NOR RED"风地狱"NOR YEL);
set("long",msg);
set("exits",([
        "eastup"    :       __DIR__"diyiyu",
        "westdown"    :       __DIR__"dieryu",
]));
set("broadcast",1);
setup();                                                           
}




