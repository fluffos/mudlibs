#include <ansi.h>
inherit NPC;

void powerup()
{
object me = this_object();
random(2)?
message_vision("\n\n$N一声哀鸣，蹲在地上不住用后腿挠动伤口。\n\n",me):
message_vision("\n\n$N仰天发出凄厉无比的哀号，不住用后腿挠动伤口。\n\n",me);
me->set("kee",query("max_kee"));
me->set("eff_kee",query("max_kee"));
me->set("sen",query("max_sen"));
me->set("eff_sen",query("max_sen"));
me->set("force",query("max_force")*2);
me->set("mana",query("max_mana")*2);
me->clear_condition();
return;
}

void exert_heal()
{
int tou;
string msg,limb,*limbs;
object me = this_object();

if( me->query("force")<50 ) return ;
if ( me->query("eff_kee")>=me->query("max_kee") )
     return;
tou = 1+random(2);
msg = "$N的第"+chinese_number(tou)+"个头伸出舌头舔了舔受伤的$l，仰天长号了几声，伤势渐渐减轻了。\n";
limbs = me->query("limbs");
limb = limbs[random(sizeof(limbs))];
msg = replace_string(msg,"$l",limb);
message_vision(msg,me);
me->receive_curing("kee",50+(int)me->query_skill("force")/5 );
me->add("force", -50);
return;
}

void exert_refresh()
{
int diff,neilineed,tou;
object me = this_object();

if( !me->is_fighting() ) return;

if( me->query("force")<20 ) return;
                
diff = me->query("eff_sen")-me->query("sen");
neilineed = diff*50/(int)me->query_skill("force");

if( neilineed<1 ) return;

if( neilineed>me->query("force") ) neilineed = me->query("force");
diff = neilineed*(int)me->query_skill("force")/50;
me->receive_heal("sen", diff);
me->add("force", -neilineed);
tou = 1+random(2);
message_vision("$N的第"+chinese_number(tou)+"只头略一凝神，吸了口气，精神看起来清醒多了。\n", me);
return;
}

void exert_recover()
{
int diff,neilineed,tou;
object me = this_object();

if( !me->is_fighting() ) return;

if( me->query("force")<20 ) return;

diff = me->query("eff_kee")-me->query("kee");
neilineed = diff*50/(int)me->query_skill("force");

if( neilineed<1 ) return;
    
if( neilineed>me->query("force") ) 
        neilineed = me->query("force");
    
diff = neilineed*(int)me->query_skill("force")/50;
    
me->receive_heal("kee", diff );
me->add("force",-neilineed);
tou = 1+random(2);
message_vision("$N的第"+chinese_number(tou)+"只头深深吸了几口气，脸色看起来好多了。\n", me);
return;
}

void create()
{
set_name("露比斯",({"lubis","dog"}));
set("age",1000);
set("title",HIM"三头犬"NOR);
set("long",RED"地狱的守护犬,拥有三只头的猛兽。\n"NOR);
set("race","野兽");
set("attitude", "aggressive");
set("head",3);
set("任务",1);
set("limbs",({
        "第一只头","第二只头","第三只头","脖子","前腿","后腿","尾巴",
        "眼睛","鼻子","嘴巴","耳朵","腰部",
}));
set("verbs", ({ "bite"}));
set("con",40);
set("per",10);
set("str",40);

set("combat_exp",50000000);
set("daoxing",50000000);

set_skill("dodge",800);
set_skill("force",800);
set_skill("parry",800);
set_skill("unarmed",800);
set_skill("mingwang-quan",800);
set_skill("ghostdance",800);
set_skill("ghostforce",800);
set_skill("ghostspells",800);
map_skill("parry","mingwang-quan");
map_skill("dodge","ghostdance");
map_skill("unarmed","mingwang-quan");
map_skill("spells","ghostspells");
map_skill("force","ghostforce");

set("max_force",8000);
set("force",16000);
set("max_mana",12000);
set("mana",24000);
set("mana_factor",700);
set("force_factor",300);
set("max_kee",20000);
set("max_gin",20000);
set("max_sen",20000);

setup();
set_temp("apply/armor",800);
set_temp("apply/damage",300);
}

void kill_ob(object me)
{
object ob=this_object();

if( !me || !present(me,environment()) )
        {
        delete_temp("killer");
        delete_temp("last_opponent");
        powerup();
        return;
        }
remove_call_out("kill_ob");
call_out("kill_ob",1+random(3),me);
}

void die()
{
int dx;
string title;
object npc;
object ob = this_object();
object me = ob->query_temp("last_opponent");

powerup();

if ( !me || environment(ob)!=environment(me) || !userp(me)
 || environment(ob)->query("short")!="第二狱" )
        return;

if ( random(50)==1 ) 
        {
        message_vision("\n\n$n拿蹬起后腿，挠了挠屁股，站起身来又朝$N发起进攻！\n\n",me,ob);
        return; 
        }

message_vision("\n\n\n$n仰天发出一声哀号，第"+chinese_number(4-ob->query("head"))+"只头齐颈断开！\n\n\n",me,ob);
ob->add("head",-1);
ob->save();

if ( ob->query("head")>0 )
        {
        message_vision("\n\n$n蹲在地上拿后腿挠了挠伤口，咆哮着朝$N扑了过去。\n\n\n",me,ob);
        ob->kill_ob(me);
        me->kill_ob(ob);
        return;
        }

ob->remove_killer(me);
me->remove_killer(ob);
message_vision("惨号声中，$n化作粒粒碎石，跌落尘埃。\n",me,ob);

if ( me->query("sds5/fenggu")>=6 && me->query("sds5/two")!="done" )
        {
        title = WHT"【"NOR HIY" 圣 战"NOR HIB" 冥 界 "NOR WHT"】"NOR;
        title+=HIC+"$1($i)：$N杀死了第二狱的$T"HIC"$n"HIC"！\n"NOR;
        title = replace_string(title,"$1","里昂");
        title = replace_string(title,"$i","Leon");
        title = replace_string(title,"$N",me->query("name"));
        title = replace_string(title,"$n",ob->name());
        title = replace_string(title,"$T",ob->query("title")+" ");
        message("channel:chat",title,users());
        dx = 50000+random(100000);
        me->add("daoxing",dx);
        me->save();
        tell_object(me,"你赢得了"+COMBAT_D->chinese_daoxing(dx)+"道行。\n");
        }
npc = present("falao",environment(ob));
if ( !npc || userp(npc) )
        {
        npc = find_object(__DIR__"falao");
        if ( !npc ) npc = new(__DIR__"falao");

        npc->move(environment(ob));
        message_vision("\n随着$n的惨号声，"+npc->name()+"从浓雾中杀将出来！\n\n",me,ob);
        }
message_vision("\n\n"+npc->name()+"把眼一瞪：敢杀我的狗狗？！不想活了！！\n\n",me,ob);
npc->kill_ob(me);
me->kill_ob(npc);
destruct(ob);
return;
}

void init()
{
object me = this_player();
object dog = this_object();

if ( !userp(me) ) return;
add_action("do_none","steal");
add_action("do_none","move");
add_action("do_none","accept");
add_action("do_none","burn");
add_action("do_none","ji");
add_action("do_none","fight");
add_action("do_none","fang");
add_action("do_none","aplly");
add_action("do_none","surrender");
add_action("do_none","move");
add_action("do_none","cast");
if ( me->query_temp("yinshentime") )
        {
        me->delete_temp("yinshentime");
        me->delete("env/invisibility");      
        me->save();
        me->delete_temp("no_heal_up/yinshen");
        message_vision("\n$n朝着$N站立之处看了看，龇牙咧嘴一阵低吼，$N头冒冷汗，不由现了身形。\n\n"NOR,me,dog);
        }
if ( me->query_temp("apply/name") )
        {
        me->delete_temp("apply/name");
        me->delete_temp("apply/id");
        me->delete_temp("apply/short");
        me->delete_temp("apply/long");
        me->delete_temp("family");
        me->delete_temp("no_heal_up/bian");
        me->save();
        message_vision("\n$n朝着$N龇牙咧嘴一阵低吼，$N头冒冷汗，不由现了原形。\n\n"NOR,me,dog);
        }
command("kill "+me->query("id"));
}


int do_none()
{
object me = this_player();
object ob = this_object();
message_vision("$n朝着$N恶狠狠的吠叫，$N一时间手脚发麻，不知如何是好。\n",me,ob);
if ( random(3)==1 )
   me->start_busy(1);
return 1;
}

void heart_beat()
{ 
object ob = this_object();
::heart_beat();
                   
if ( query("eff_kee") < (query("max_kee")-100) )
        exert_heal();
      
if ( query("kee") < (query("eff_kee")-100) )
        exert_recover();

if ( query("sen") < (query("eff_sen")-100) ) 
        exert_refresh();
}       

void unconcious()
{
  die();
}


