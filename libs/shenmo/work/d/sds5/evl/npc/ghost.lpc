#include <ansi.h>
inherit NPC;

string check_me();

void create() {
  set_name("鬼魂", ({ "ghost", "gui hun" }));
  set("age", 16 + random(14));
  set("gender", "女性");
  set("long", "一只鬼魂。\n");
  set("attitude", "friendly");
  set("per", 10 + random(20));
  set("inquiry", ([
    "运气": (: check_me :),
    "姓名": (: check_me :),
    "all": (: check_me :),
  ]));
  setup();
}

string check_me() {
  object me = this_player();
  int kar = me->query_kar();
  string r = RANK_D->query_respect(me);

  if (kar < 10)
    return r + "前途艰险，看来是有去无还....\n";
  else if (kar < 15)
    return r + "前途艰难，看来是十去九还....\n";
  else if (kar < 20)
    return r + "前途苦难参半，还是小心为妙....\n";
  else if (kar < 25)
    return r + "此去路上尚有危险，小心为好....\n";
  else if (kar < 30)
    return r + "此去路上虽有危险，然菩萨保佑，看来是事半功倍....\n";
  else if (kar < 35)
    return r + "只管上路，此去路上有风无浪....\n";
  else return r + "只管上路，此去路上无风无浪....\n";
}
