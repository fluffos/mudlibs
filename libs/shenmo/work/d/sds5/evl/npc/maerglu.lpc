#include <ansi.h>
inherit NPC;

string check_me();

void create()
{
set_name("馬爾其路",({"maerglu"}));
set("long", "冥界法庭的向导。\n");
set("gender","男性");
set("title", HIM"法庭向导"NOR);
set("age",28);
set("per",1);
set("任务",1);
set("inquiry", ([
        "第一狱": (: check_me :),
        "all": (: check_me :),
]));
setup();
carry_object("/d/sds5/city/obj/evl_cloth")->wear();
}

string check_me()
{
string msg;
object me = this_player();
object ob = this_object();

if ( environment(ob)->query("short")!="第一狱大门" )
         {
         call_out("go_back",2+random(3),ob);
         return "奇怪,我怎么到这里来了?路尼大人要发火了....\n";
         }

if ( me->query_temp("diyiyu_asked") )
        return random(2)?"罗哩罗嗦的为哪般？\n":"问过了还问，你白痴啊？！\n";

if ( me->query("sds5/river")!="done" || !present("nvshen shengyi",me) )
        return "凡人是不可过问的。\n";

if ( ob->query("asked") )
        return "在路尼大人的地盘，我还是沉默是金的好....\n";

if ( random(5)==1 )
        {
        ob->set("asked",1);
        ob->save();
        call_out("resets",30+random(30),ob);
        return "我现在懒得说....\n";
        }
ob->set("asked",1);
ob->save();
call_out("resets",30+random(30),ob);
me->set_temp("diyiyu_asked",1);
say(name()+"点了点头：新来的？跟着我吧，去见路尼大人。\n");
me->set_leader(ob);
call_out("do_move",2+random(3),ob,me);
return "在路尼大人面前可要规矩一点，不要发出声响，不然是死罪！\n";
}

void resets(object who)
{
if ( !who ) return;
remove_call_out("resets");
if ( who->query("asked") )
        who->delete("asked");
say(name()+"朝四周看了看：还有要进去的没？\n");
return;
}

void do_move(object ob,object me)
{
if ( !me || !present(me,environment(ob)) )
        return;
ob->command("say 随我去见路尼大人吧。\n");
ob->command("enter");
return;
}


void go_back(object ob)
{
object who;
if ( !ob || environment(ob)->query("short")=="第一狱大门" )
  return;
tell_room(environment(ob),ob->name()+"自言自语的离开了。\n");
ob->move("/d/sds5/evl/yi");
tell_room(environment(ob),ob->name()+"走了过来。\n");
who=present("maerglu",environment(ob));
if ( !userp(who) && who!=ob )
        destruct(who);
return;
}


