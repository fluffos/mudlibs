#include "/d/无限示/weapon.h"
#include <ansi.h>
#include "check_owner.h"
inherit SHOUTAO;


void create() {
  int i;
  set_name(HIM "巴比隆" NOR "之" YEL "鞭" NOR, ({ "babilon whip", "bian", "hand" }));
  set_weight(4000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("material", "steel");
    set("wield_msg", YEL "$N" YEL "举起一柄$n" YEL "敲了几敲，“肃静！”。\n" NOR);
    set("unwield_msg", YEL "$N" YEL "将手里的$n" YEL "放将下来。\n" NOR);
  }
  init_shoutao(300);
  setup();
}

void init() {
  check_owner();
}
