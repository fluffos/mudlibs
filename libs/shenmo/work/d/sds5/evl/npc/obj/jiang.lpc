#include "/d/无限示/weapon.h"
#include <ansi.h>
#include "check_owner.h"
inherit SHOUTAO;


void create()
{
int i;
set_name(WHT"船桨"NOR,({"chuan jiang","jiang","hand"}));
set_weight(4000);
if (clonep())
        set_default_object(__FILE__);
else    {
        set("unit","把");
        set("material", "steel");
        set("wield_msg",YEL"$N"YEL"扛起一把$n"YEL"嘿嘿一笑。\n"NOR);
        set("unwield_msg",YEL"$N"YEL"将肩头上的$n"YEL"放将下来。\n"NOR);
        }
init_shoutao(300);
setup();
}

void init()
{
check_owner();
}

