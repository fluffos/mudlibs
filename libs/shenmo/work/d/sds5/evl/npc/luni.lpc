#include <ansi.h>
inherit NPC;
#include "star.h"
 
void create()
{
set_name("路尼", ({"luni"}));
set("long", "冥界法庭的代庭长\n");
set("gender","男性");
set("title", HIW"天英星"NOR HIB"冥斗士"NOR);
set("age",38);
set("con",30);
set("per",20);
set("str",25);
set("int",40);
set("rank_info/self",random(2)?"大人":"本官");
set("combat_exp",155000000);
set("daoxing",155000000);
set_skill("dodge",650);
set_skill("force",650);
set_skill("parry",650);
set_skill("unarmed",650);
set_skill("mingwang-quan",650);
set_skill("ghostdance",650);
set_skill("ghostforce",650);
set_skill("ghostspells",650);
map_skill("parry","mingwang-quan");
map_skill("dodge","ghostdance");
map_skill("unarmed","mingwang-quan");
map_skill("spells","ghostspells");
map_skill("force","ghostforce");

set("max_force",9000);
set("force", 18000);
set("max_mana",9000);
set("mana",18000);
set("mana_factor",450);
set("force_factor",300);
set("max_kee", 25000);
set("max_gin", 25000);
set("max_sen", 25000);
set("任务",1);
setup();
//carry_object("/d/sds5/city/obj/evl_cloth")->wear();
//carry_object(__DIR__"obj/whip")->wield();
}

void heart_beat()
{ 
object ob = this_object();
::heart_beat();
                   
if ( query("eff_kee") < (query("max_kee")-100) )
        command("exert heal");
      
if ( query("kee") < (query("eff_kee")-100) )
        command("exert recover");

if ( query("sen") < (query("eff_sen")-100) ) 
        command("exert refresh");
}       

void init()
{
add_action("do_none","steal");
add_action("do_none","move");
add_action("do_none","accept");
add_action("do_none","burn");
add_action("do_none","ji");
add_action("do_none","fight");
add_action("do_none","kill");
add_action("do_none","fang");
add_action("do_none","aplly");
add_action("do_none","surrender");
add_action("do_none","move");
add_action("do_none","cast");
add_action("do_pfm","perform");
}

int do_none()
{
object me = this_player();
object ob = this_object();
message_vision(YEL"\n\n路尼大喝一声：法庭之上保持肃静！！\n"NOR,me);
if ( random(3)==1 )
   me->start_busy(1);
return 1;
}

int do_pfm()
{
if ( random(10)==1 )
        powerup();
return 0;
}

void kill_ob(object me)
{
object ob=this_object();

if ( !me)
        {
        powerup();
        return;
        }

if( !present(me,environment()) || me->is_ghost() || !me->is_fighting(ob) )
        {
        powerup();
        ob->remove_killer(me);
        me->remove_killer(ob);
        return;
        }
     
set("chat_chance_combat",100);
set("chat_msg_combat", ({
        (: perform_action, "unarmed", "whip" :),
}) );
      
if( random(10) == 1 )
        powerup();
remove_call_out("kill_ob");
call_out("kill_ob",1+random(3),me);
}

void die()
{
object ob = this_object();
object me = ob->query_temp("last_opponent");

powerup();

if ( !me || environment(ob)!=environment(me) || !userp(me)
 || environment(ob)->query("short")!="第一狱" )
        return;
if ( random(10)==1 ) { command("say 不错不错，再来再来...\n");return; }

me->remove_killer(ob);
ob->remove_killer(me);

me->start_busy(3);

ob->command("say 果然有些本事。。。好好好，后面的路还长着呢....\n");
if ( me->query("sds5/river")=="done" && me->query("sds5/one")!="done" )
        {
        call_out("gift",1,me,ob);
        return;
        }
message_vision(HIW"$N化作尘土消失在黑暗中！\n"NOR,ob);
destruct(ob);
return;
}

void gift(object me,object ob)
{
int dx;
object sz,sy,sp;
object where = environment(me);
string title = WHT"【"NOR HIB" 圣 战"NOR BLU" 冥 界 "NOR WHT"】"NOR;

if ( !ob || environment(ob)!=environment(me)
 || environment(ob)->query("short")!="第一狱" )
        return;

ob->command("say ...冥王...救...我....\n");
message_vision(YEL"\n$N"YEL"忽地惨号一声，身体渐渐坏死破裂，终于碎成粉末消散在黑暗中！\n",ob,me);
title+=HIC+"$1($i)："NOR;
title = replace_string(title,"$1","里昂");
title = replace_string(title,"$i","Leon");
message("channel:chat",title+HIW+me->name()+HIC"闯过了"+ob->query("title")+ob->name()+HIC"！\n"NOR,users());
dx = 100000+random(100000);
me->add("daoxing",dx);
tell_object(me,"你赢得了"+COMBAT_D->chinese_daoxing(dx)+"道行。\n");
me->set("sds5/one","done");
me->save();
destruct(ob);
return ;
}
