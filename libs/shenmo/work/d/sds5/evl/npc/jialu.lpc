//////////////////////////////////////////////////////////////////////////////
//////////////////////////////// 天間星 加路 /////////////////////////////////
///////// 第一獄前三途之河的守獄者﹐他只接載身上有金錢的亡者過河 /////////////////
//////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////snowtu@XMxyj///////////////////////

#include <ansi.h>
inherit NPC;
#include "star.h"

void create()
{
set_name("加路", ({"jialu"}));
set("long", "第一獄前三途之河的守獄者﹐他只接載身上有金錢的亡者過河。\n"NOR);
set("gender","男性");
set("title", HIW"天間星"NOR HIB"冥斗士"NOR);
set("age",38);
set("con",30);
set("per",20);
set("str",25);
set("int",40);
set("rank_info/self",random(2)?"爷爷我":"你家加路大爷我");
set("combat_exp",155000000);
set("daoxing",155000000);
set_skill("dodge",600);
set_skill("force",600);
set_skill("parry",600);
set_skill("unarmed",600);
set_skill("mingwang-quan",600);
set_skill("ghostdance",600);
set_skill("ghostforce",600);
set_skill("ghostspells", 600);
map_skill("parry","mingwang-quan");
map_skill("dodge","ghostdance");
map_skill("unarmed","mingwang-quan");
map_skill("spells","ghostspells");
map_skill("force","ghostforce");

set("max_force", 8050);
set("force", 16100);
set("max_mana",8050);
set("mana",16100);
set("mana_factor",450);
set("force_factor",250);
set("max_kee", 15000);
set("max_gin", 15000);
set("max_sen", 15000);
set("任务",1);
setup();
carry_object("/d/sds5/city/obj/evl_cloth")->wear();
carry_object(__DIR__"obj/jiang")->wield();
}

void kill_ob(object me)
{
object ob=this_object();

if ( !me)
        {
        powerup();
        return;
        }

if( !present(me,environment()) || me->is_ghost() || !me->is_fighting(ob) )
        {
        powerup();
        ob->remove_killer(me);
        me->remove_killer(ob);
        return;
        }
     
set("chat_chance_combat",80);
set("chat_msg_combat", ({
        (: perform_action, "unarmed", "sui" :),
}) );
      
if( random(10) == 1 )
        powerup();
remove_call_out("kill_ob");
call_out("kill_ob",1+random(3),me);
}

void gift(object me,object ob)
{
int dx;
object sz,sy,sp;
object where = environment(me);
string title = WHT"【"NOR HIB" 圣 战"NOR BLU" 冥 界 "NOR WHT"】"NOR;

if ( !ob || environment(ob)!=environment(me)
 || environment(ob)->query("short")!=HIB"黄泉"NOR YEL"摆渡船"NOR )
        return;

ob->command("say ...冥王...救...我....\n");
message_vision(YEL"\n$N"YEL"忽地惨号一声，身体渐渐坏死破裂，终于碎成粉末消散在黑暗中！\n",ob,me);
title+=HIC+"$1($i)："NOR;
title = replace_string(title,"$1","里昂");
title = replace_string(title,"$i","Leon");
message("channel:chat",title+HIW+me->name()+HIC"闯过了"+ob->query("title")+ob->name()+HIC"！\n"NOR,users());
dx = 90000+random(90000);
me->add("daoxing",dx);
tell_object(me,"你赢得了"+COMBAT_D->chinese_daoxing(dx)+"道行。\n");
me->set("sds5/river","done");
me->save();
destruct(ob);
return ;
}

void die()
{
object ob = this_object();
object me = ob->query_temp("last_opponent");

powerup();

if ( !me || environment(ob)!=environment(me) || !userp(me)
 || environment(ob)->query("short")!=HIB"黄泉"NOR YEL"摆渡船"NOR )
        return;
if ( random(10)==1 ) { command("say 不错不错，再来再来...\n");return; }

me->remove_killer(ob);
ob->remove_killer(me);

me->start_busy(3);

ob->command("say 果然有些本事。。。好好好，后面的路还长着呢....\n");
if ( me->query("sds5/city2")=="done" && me->query("sds5/river")!="done" )
        {
        call_out("gift",1,me,ob);
        return;
        }
message_vision(HIW"$N化作尘土消失在黑暗中！\n"NOR,ob);
destruct(ob);
return;
}

void init()
{
add_action("do_none","steal");
add_action("do_none","move");
add_action("do_none","accept");
add_action("do_none","burn");
add_action("do_none","ji");
add_action("do_none","fight");
add_action("do_none","kill");
add_action("do_none","fang");
add_action("do_none","aplly");
add_action("do_none","surrender");
add_action("do_none","move");
add_action("do_none","cast");
add_action("do_pfm","perform");
}

int do_none()
{
object me = this_player();
object ob = this_object();
message_vision(HIB"$n化作一片幻影在$N身旁乱舞，$N一时无法攻击。\n",me,ob);
if ( random(3)==1 )
   me->start_busy(1);
return 1;
}

int do_pfm()
{
if ( random(10)==1 )
        powerup();
return 0;
}

void heart_beat()
{ 
object ob = this_object();
::heart_beat();
                   
if ( query("eff_kee") < (query("max_kee")-100) )
        command("exert heal");
      
if ( query("kee") < (query("eff_kee")-100) )
        command("exert recover");

if ( query("sen") < (query("eff_sen")-100) ) 
        command("exert refresh");
}       

int accept_object(object me,object obj)
{
int value;
value = 100;
value-= random(me->query_kar());
value*= 10000;
if ( me->query("sds5/city2")!="done" )  return 1;
if ( obj->query("money_id") )
        {
        if ( obj->value()>=value ) 
                {
                say(YEL+name()+YEL"嘿嘿一笑："+query("rank_info/self")+YEL"平生爱的就是这个。\n"NOR);
                me->set_temp("river_gived",1);
                me->save();
                return 1;
                }
        say(YEL+name()+YEL"嘿嘿一笑："+query("rank_info/self")+YEL"平生爱的就是这个。
小猪猪，只要你给我"+MONEY_D->money_str(value)+YEL"，我便让你过河...\n"NOR);
        return 1;
        }
say(YEL+name()+YEL"嘿嘿一笑："+query("rank_info/self")+YEL"平生爱的只有钱，其他的全不要，连脸都不要了....\n"NOR);
return 0;
}

