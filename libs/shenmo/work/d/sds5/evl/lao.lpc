#include <ansi.h>
inherit ROOM;

mapping hit_msg = ([
        "9" : CYN"狱卒拿出一把烧得"NOR RED"火红"NOR CYN"的铁钳，夹住$N"CYN"的舌头！毁了，传出一股焦臭之味....\n"NOR,
        "7" : CYN"狱卒将$N"CYN"的舌头一拉，绷得笔直，猛得一放！$N"CYN"惨号一声，满口鲜血。\n"NOR,
        "5" : CYN"狱卒抽出一根狼牙棒，对着$N"CYN"的腮帮子左右开工就是一通胖揍....\n"NOR,
        "5" : CYN"狱卒抡圆了右手对着$N"CYN"就是几记耳光，$N"CYN"满口喷血的看着，无可奈何。\n"NOR,
        "5" : CYN"狱卒抡圆了右手对着$N"CYN"就是一记耳光，$N"CYN"呀的一声，吐了口碎牙。\n"NOR,
        "5" : CYN"狱卒对着$N"CYN"的嘴巴狠锤几下，$N"CYN"咿咿呀呀，嘴肿得说不出话。\n"NOR,
        "3" : CYN"狱卒掏出一瓶辣椒水对着$N"CYN"就是一通猛灌，$N"CYN"口鼻升烟，痛苦不堪。\n"NOR,
        "1" : CYN"掏出一个仙人掌塞进$N"CYN"口中，可怜哦~ $N"CYN"口鼻流血，肿大如斗....\n"NOR,
]);      

void takeout(object who)
{
object room;
if (  room=who->query_temp("old_room") )
        who->move(room);
else who->move("/d/city/kezhan");
who->save();
message_vision("$N被从牢房里面放了出来。\n",who);
return;
}

void alternative_die(object who)
{
who->set("kee",10);
who->set("sen",10);
who->set("eff_kee",who->query("max_kee")/2);
who->set("eff_sen",who->query("max_sen")/2);
who->set("force",10);
who->set("mana",10);
message_vision(RED"\n\n$N"RED"不堪折磨，连吐数升鲜血，哐铛一声，跌倒在地！\n\n"NOR,who);
//who->unconcious();
return; 
}

void create()
{
int time = 5+random(5);
set("short",HIR"拔舌狱"NOR);
set("long",YEL+@LONG
四周黑漆漆的一片。举目远眺仍看不到任何事物。拢耳
倾听却听不到任何声响。
LONG+NOR);
set("no_fight", 1);
set("no_magic",1);
set("no_kill",1);

set("alternative_die",1);
set("channel_id", "囚室");
setup();
}

void init()
{
object me = this_player();
if ( !userp(me) ) return ;

add_action("block_cmd","",1);  
message("vision",HIY"只听铁门匡地一响，一个家伙被扔了进来！\n\n" NOR, environment(me), me);
tell_object( me, HIR"进入拔舌狱，有你受的啦。\n"NOR);
remove_call_out("check");
call_out("check",1,me);
}

int block_cmd()
{
int *i;
string msg;
string verb = query_verb();
if (verb=="say") return 0; 
if (verb=="chat") return 0; 
if (verb=="chat*") return 0; 
if (verb=="quit") return 0;
if (verb=="who") return 0;
if (verb=="goto") return 0;
if (verb=="home") return 0;
if (verb=="look") return 0;
if (verb=="skills") return 0;
if (verb=="score") return 0;
if (verb=="eat") return 0;
if (verb=="exert") return 0;
if (verb=="hp") return 0;
i=keys(hit_msg);
msg = hit_msg[i[random(sizeof(i))]];
message_vision(msg,this_player());
message_vision(CYN"$N"CYN"嘴巴肿得象个笆斗,咿咿呀呀,说着人们不懂的话。\n"NOR,this_player());
return 1;
}

void check(object me)
{
object env;
int howlong,i,*damages,damage;
string msg;
env = this_object();

if ( !me ) return;
if ( !present(me,env) )
        {
        if ( me->query_temp("diyiyu")>0 )
                {
                message("vision",HIB"平地卷起一阵阴风，将"+me->name()+HIB"带走了！\n\n"NOR,environment(me),me);
                tell_object(me,HIB"一群鬼魂锁住了你“进入拔舌狱，还想跑?\n"NOR);
                me->move(env);
                message("vision",HIY"只听铁门匡地一响，一个家伙被扔了进来！\n\n" NOR, environment(me), me);
                tell_object( me, HIR"进入拔舌狱，有你受的啦。\n"NOR);
                }
        return;
        }
remove_call_out("check");

if ( me->query("food")<50 || me->query("water")<50 )
        {
        message_vision(CYN"总算可以吃饭了，狱卒扔来一碗剩饭，被$N"CYN"狼吞虎咽的干光了。\n"NOR,me);
        me->add("food",50);
        me->add("water",50);
        }
if ( random(3)==1 && me->query("kee")>100 )
        {
        message_vision(CYN"狱卒不怀好意的盯着$N"CYN"直看，直叫人心头起毛....\n"NOR,me);
        if ( random(2)==1 )
                message_vision(CYN"狱卒看了一会，低头行开了。\n"NOR,me);
        else    {
                damages=keys(hit_msg);
                damage=damages[random(sizeof(damages))];
                msg = hit_msg[damage];
                message_vision(CYN"狱卒嘿嘿一笑：好久没整人了，正好手痒....\n\n"NOR,me);
                tell_object(me,HIR"你惨了....\n"NOR);
                message_vision(msg,me);
                damage = to_int(damage);
                damage*=100;
                me->receive_damage("kee",damage);
                me->receive_wound("kee",damage);
                COMBAT_D->report_status(me);
                }
        }
howlong = me->query_temp("diyiyu");
if ( howlong<=0 )
        {
        me->delete_temp("diyiyu");
        takeout(me);
        }
else    me->add_temp("diyiyu",-1);
me->save();
if ( random(10)==1 || wizardp(me) )
        tell_object(me,HIM"你还得再受苦："NOR YEL+CHINESE_D->chinese_time(me->query_temp("diyiyu"))+"\n"NOR);
call_out("check",1,me);
}


