#include <ansi.h>
inherit ROOM;
#include "looks.h"

#define R_D "/d/sds5/evl/npc/rankd.lpc"

void create()
{
string message_vision;
set("short","第一狱大门");
set("long","这里就是冥界第一狱的入口。靠近死亡之河，不停有游荡的幽魂进进出出。\n");
set("exits", ([
        "enter": __DIR__"diyiyu",
]));
set("objects", ([ 
        __DIR__"npc/maerglu" : 1,  //////////馬爾其路
]));
set("broadcast",1); //////////////方便观看,省得老用snoop,相关文件 __DIR__"looks.h"
setup();
}

void init()
{
object npc;
object me = this_player();
if ( me->query("sds5/river")!="done" )
        {
        call_out("go_hell",1+random(4),me);
        message_vision("$N漫无目的的飘荡着。\n",me);
        }
npc = present("maerglu",this_object());
if ( !npc || userp(npc) )
        call_out("npc_come",5+random(25),me);
return;
}

int valid_leave(object me, string dir)
{
object npc;
if ( !userp(me) ) return 1;
else if ( me->query_temp("diyiyu_asked") )
        return 1;
else if ( present("maerglu",this_object()) )
        return notify_fail("只管跟着向导便是.\n");
return ::valid_leave(me, dir);
}

void go_hell(object me)
{
string msg;
object zhenshen;
object env = this_object();
remove_call_out("go_hell");
if ( !me || !present(me,env) )
        return;
if ( !interactive(me) && me->query("id")=="maerglu" ) 
        return;
msg = "冥冥之中刮起一股阴风，将$N的鬼魂卷住不见了。\n";
message_vision(msg,me);
me->receive_damage("sen", 30);
me->add("mana", -30);
if( !me->query_temp("in_hell") )
        {
        me->set_temp("in_hell", 1);
        seteuid(getuid());
        zhenshen= new("/obj/npc/zhenshen");
        zhenshen->move("/d/city/kezhan");
        zhenshen->invocation(me);
        me->set_temp("zhenshen", zhenshen);
        me->apply_condition("in_hell", 1);      
        }
me->move("/d/death/gate");
message_vision("四出刮起阴风，现出了$N的影子。\n", me);
return;
}

void npc_come(object me)
{
string msg;
object npc,zhenshen;
object env = this_object();
remove_call_out("npc_come");
if ( !me || !present(me,env) )
        return;
if ( npc=present("maerglu",env) && !userp(npc) )
        return;
npc = find_object(__DIR__"npc/maerglu");
if ( !npc )
        npc = new(__DIR__"npc/maerglu");
npc->move(env);
msg = npc->name()+"走了过来。\n";
message_vision(msg,me);
return;
}


