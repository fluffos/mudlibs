inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "仙人洞");
  set("long", @LONG
此地系自然风化天生石洞，高一十八尺，宽三六尺米，深五丈许。
洞顶为参差如手指的岩石覆盖，形似佛手，故又名“佛手岩”。
两旁尽是悬崖与竹林，名“仙路”。循“仙路”前行，可欣赏路
旁悬崖上诸多摩岩石刻，著名者有“竹林寺”、“云海”、“天
在山中”、“同舟共济”等。路边贴近壑谷一段有“访仙亭”、
“游仙石”诸胜。其中，游仙石为一突兀巨石，丹崖悬空，在此
纵览锦绣谷全景，气势极其壮阔。 

LONG);

  set("exits", ([
    "southeast": __DIR__ "bailudong",
    "east": __DIR__ "jinxiugu",
  ]));
  set("objects", ([
    //	__DIR__"npc/flower" : random(3),
  ]));
  set("outdoors", __DIR__ "");
  setup();
}
