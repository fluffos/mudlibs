#include <ansi.h>
inherit ROOM;

#define MSK_D "/d/sds5/master.lpc"

string do_look();

void create ()
{
set ("short", "五老峰下");
set ("long", @LONG

这里是五老峰的龙瀑之下。也就是以前封印冥界一百零八星的所在。
四下里水雾弥漫，只听到四周回荡着瀑布直冲而下的轰鸣之声。
眼前一颗大石头，散发着糁人魔鬼之气，上面贴着一张雅典娜二百
年前贴上的符篆。

LONG);

set("item_desc", ([ 
        "符篆"  : (: do_look :),    
]));
setup();
}

string do_look()
{
object env,me = this_player();
if ( !userp(me) || me->query("sds4/box")!="done" 
  || me!=MSK_D->QueryLeader() )
        return "一张看不懂的符篆纸，上面画了些看不明白的符号。。。。";
if ( random(me->query_skill("literate",1))<350 )
        return "一张符篆纸，上面画了些符号，可惜你看了半天看不明白。。。。";   
me->set_temp("sds5/lushan","start");    
return "为圣战准备(ready)好了？";
}

void init()
{
object npc;
object me = this_player();
object env = this_object();
if ( me->query("sds4/king")!="done" && userp(me) )
        {
        npc = new(__DIR__"npc/tonghu");
        npc->move(env);
        npc->command("say 大胆狂徒，莫非便是魔星转世，跑到此处闹事？！\n");
        npc->kill_ob(me);
        }
add_action("do_ready","ready");        
return;
}

int do_ready()
{
object me = this_player();
if ( me->query_temp("sds5/lushan")!="start" )
        return 0;
MSK_D->SetStart();
//(*)
return 1;
}               

