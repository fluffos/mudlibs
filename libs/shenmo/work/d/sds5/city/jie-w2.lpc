#include <ansi.h>
inherit ROOM;
#include "road.h"

void create() {
  set("short", WHT "爱因斯坦西街" NOR);
  set("long", @LONG
你走在一条宽阔的石板大街上，东面就快到城中心了，可以看到钟楼
耸立于前。南面是一家格斗馆。
LONG);
  set("exits", ([
    "east": __DIR__ "jie-w1",
    "south": __DIR__ "wuguan",
  ]));
  set("objects", ([
    __DIR__ "npc/jumin": random(2),
    __DIR__ "npc/jumin2": random(2),
  ]));
  setup();
}
