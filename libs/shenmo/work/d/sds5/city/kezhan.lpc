inherit ROOM;
#include <ansi.h>
#include "shop.h"

void create() {
  set("short", HIG "酒吧" NOR);
  set("long", @LONG
这里是城中的酒吧，可惜现在只有寥寥无几的几个当地居民在此喝酒。
LONG);
  set("exits", ([
    "south": __DIR__ "jie-e1",
  ]));
  set("chat_room", 1);
  set("objects", ([
    __DIR__ "npc/drink_boss": 1,
    __DIR__ "npc/jumin": random(4),
  ]));
  set("no_fight", 1);
  set("no_magic", 1);
  set("freeze", 1);
  set("water", 1);
  setup();
}
