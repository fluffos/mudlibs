#include <ansi.h>
inherit ROOM;
#include "road.h"

void create() {
  set("short", WHT "爱因斯坦西街" NOR);
  set("long", @LONG
你走在一条宽阔的石板大街上，东面就快到城中心了，可以看到钟楼
耸立于前。北面是一家书店。
LONG);
  set("exits", ([
    "east": __DIR__ "center",
    "west": __DIR__ "jie-w2",
    "north": __DIR__ "book",
  ]));
  set("objects", ([
    __DIR__ "npc/jumin3": random(2),
    __DIR__ "npc/jumin4": random(2),
  ]));
  setup();
}
