#include <ansi.h>
inherit NPC;

void create()
{
set_name("卡妙", ({"kamus", "shui ping"}));
set("long","冰河的师祖。十二宫之战中为让冰河领悟第七感，被冰河杀死。
富有牺牲精神的黄金圣斗士,守护着水瓶座.\n");
set("gender","男性");
set("title", HIC"水瓶座"HIY"黄金圣斗士"NOR);
set("age",37);
set("con",55);
set("per",30);
set("str",73);
set("int",64);
set("combat_exp",15000000);
set("daoxing",15000000);
set_skill("dodge",500);
set_skill("force",500);
set_skill("parry",500);
set_skill("unarmed",500);
set_skill("shengdou",500);
set_skill("stars-steps",500);
set_skill("moonforce",500);
set_skill("moonshentong",500);
map_skill("parry","shengdou");
map_skill("dodge","stars-steps");
map_skill("unarmed","shengdou");
map_skill("spells","moonshentong");
map_skill("force","moonforce");
set("max_force", 8000);
set("force", 16000);
set("max_mana",8000);
set("mana",16000);
set("mana_factor",150);
set("force_factor",150);
set("max_kee", 10000);
set("max_gin", 10000);
set("max_sen", 10000);
setup();
carry_object(__DIR__"obj/sp_cloth")->wear();
}

void heart_beat()
{
::heart_beat();

if ( query("eff_kee")<query("max_kee") )
        command("exert heal");
      
if (query("kee") < query("eff_kee") )
        command("exert recover");

if ( query("sen")<query("eff_sen") ) 
        command("exert refresh");
}       

