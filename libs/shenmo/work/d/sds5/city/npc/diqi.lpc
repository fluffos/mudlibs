:  //snowtu@XMxyj

#include <ansi.h>
inherit NPC;
#include "star.h"

#define SZ __DIR__"shuangzi"
#define SY __DIR__"shanyang"
#define SP __DIR__"shuiping"

void create() {
  set_name("哲洛斯", ({ "zelosi" }));
  set("long", "地奇星座冥斗士，哈蒂斯城的僕人﹐也是拉達曼迪斯的手下 。\n" NOR);
  set("gender", "男性");
  set("title", WHT "地奇星" NOR HIB "冥斗士" NOR);
  set("age", 20);
  set("con", 30);
  set("per", 10);
  set("str", 25);
  set("int", 40);
  set("combat_exp", 155000000);
  set("daoxing", 155000000);
  set_skill("dodge", 600);
  set_skill("force", 600);
  set_skill("parry", 600);
  set_skill("unarmed", 600);
  set_skill("mingwang-quan", 600);
  set_skill("ghostdance", 600);
  set_skill("ghostforce", 600);
  set_skill("ghostspells", 600);
  map_skill("parry", "mingwang-quan");
  map_skill("dodge", "ghostdance");
  map_skill("unarmed", "mingwang-quan");
  map_skill("spells", "ghostspells");
  map_skill("force", "ghostforce");

  set("max_force", 8050);
  set("force", 16100);
  set("max_mana", 8050);
  set("mana", 16100);
  set("mana_factor", 450);
  set("force_factor", 250);
  set("max_kee", 15000);
  set("max_gin", 15000);
  set("max_sen", 15000);
  set("任务", 1);
  setup();
  carry_object("/d/sds5/city/obj/evl_cloth")->wear();
  carry_object("/d/sds5/city/obj/weapon/evl_hand")->wield();
}

void kill_ob(object me) {
  int damage, lvl, r_lvl, skill, i;
  object ob = this_object();

  if (!present(me, environment())) {
    powerup();
    ob->delete_temp("my_killer");
    return;
  }

  if (me->is_ghost() || !me->is_fighting(ob)) {
    powerup();
    ob->delete_temp("my_killer");
    return;
  }
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed", "kousha" :),
  }));

  if (random(5) == 1)
    powerup();
  remove_call_out("kill_ob");
  call_out("kill_ob", 1 + random(5), me);
}

void gift(object me, object ob) {
  int wx, dx, pot;
  object sz, sy, sp;
  object where = environment(me);
  string title = WHT "【" NOR HIB "圣战" NOR RED "哈帝斯之城" NOR WHT "】" NOR;

  if (!ob || environment(ob) != environment(me))
    return;
  ob->command("say ...城主...救...我....\n");
  message_vision("$N忽地惨号一声，身体渐渐坏死破裂，终于碎成粉末消散在夜风中！\n", ob, me);
  title += HIC + "$1($i)：" NOR;
  title = replace_string(title, "$1", "里昂");
  title = replace_string(title, "$i", "Leon");
  message(
    "channel:chat",
    title + HIW + me->name() + HIC "闯过了" + ob->query("title") + ob->name() + HIC "！\n" NOR,
    users()
  );
  wx = 500000 + random(500000);
  dx = 500000 + random(500000);
  pot = 50000 + random(50000);
  me->add("daoxing", dx);
  me->add("combat_exp", wx);
  me->add("potential", pot);
  tell_object(me, "你赢得了" + chinese_number(wx) + "点武学经验。\n");
  tell_object(me, "你赢得了" + COMBAT_D->chinese_daoxing(dx) + "道行。\n");
  tell_object(me, "你赢得了" + chinese_number(pot) + "点潜能。\n");
  me->set("sds5/city2", "done");
  me->save();
  sz = present("saga", where);
  if (!sz) { sz = new(SZ); sz->move(where); }
  sy = present("shura", where);
  if (!sy) { sy = new(SY); sy->move(where); }
  sp = present("kamus", where);
  if (!sp) { sp = new(SP); sp->move(where); }

  sz->command("sigh");
  message_vision(CYN + sy->name() + CYN "说道：哈地斯只賜給復活的聖鬥士十二小時的生命，現在的日出....\n" NOR, me);
  message_vision(CYN + sp->name() + CYN "接着道：正是已過了十二小時的証明...\n" NOR, me);
  me->command("cry");
  message_vision(CYN + sz->name() + CYN "欣慰的道：幸亏你们已经逐渐成长起来了。\n" NOR, me);
  message_vision(CYN "三人相互对望了一下，道：身为雅典娜的圣斗士，这一天是早就预料到了的。\n" NOR, me);
  message_vision(CYN "生死相错，有生必然有死，这并不矛盾。纵使战死，也要对得起自己天空的那颗星....\n" NOR, me);
  message_vision("说罢，三人相繼化成尘埃消失在黎明的光辉之中...\n", me);
  destruct(sz);
  destruct(sy);
  destruct(sp);
  destruct(ob);
  return;
}

void die() {
  object ob = this_object();
  object me = ob->query_temp("last_opponent");

  powerup();

  if (!present("kamus", environment()))
    return;

  if (!me || !present(me, environment()) || !userp(me))
    return;

  me->remove_killer(ob);
  ob->remove_killer(me);

  me->start_busy(3);

  ob->command("say 果然有两把刷子。。。\n");
  if (me->query("sds5/city") == "done" && me->query("sds5/city2") != "done") {
    call_out("gift", 1, me, ob);
    return;
  }
  message_vision(HIW "$N化作尘土消失在夜风中！\n" NOR, ob);
  destruct(ob);
  return;
}

void init() {
  add_action("do_none", "steal");
  add_action("do_none", "move");
  add_action("do_none", "ji");
  add_action("do_none", "fang");
  add_action("do_none", "aplly");
  add_action("do_none", "surrender");
  add_action("do_none", "move");
  add_action("do_none", "cast");
  add_action("do_pfm", "perform");
}

int do_none() {
  object me = this_player();
  object ob = this_object();
  message_vision(HIB "$n化作一片幻影在$N身旁乱舞，$N一时无法攻击。\n", me, ob);
  if (random(3) == 1)
    me->start_busy(1);
  return 1;
}

int do_pfm() {
  if (random(10) == 1)
    powerup();
  return 0;
}

void heart_beat() {
  object ob = this_object();
  ::heart_beat();

  if (query("eff_kee") < (query("max_kee") - 500))
    command("exert heal");

  if (query("kee") < (query("eff_kee") - 500))
    command("exert recover");

  if (query("sen") < (query("eff_sen") - 500))
    command("exert refresh");
}

int accept_kill(object who) {
  powerup();
  who->kill_ob(this_object());
  this_object()->kill_ob(who);
  return 1;
}
