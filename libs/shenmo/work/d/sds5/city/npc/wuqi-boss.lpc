#define F_VENDOR_SALES __DIR__"vendor_sale"
inherit F_VENDOR_SALES;
#define WUQI_ "/d/sds5/city/obj/weapon/"

#include <ansi.h>
void create()
{
reload("wuqi_boss");
set_name("武器店老板",({"laoban","boss"}));
set("shop_id",({"laoban","boss"}));
set("shop_title","武器店老板");
set("gender","男性");
set("combat_exp", 1000);
set("age",38);
set("per", 40);
set("attitude", "friendly");
set("max_price",20);
set("vendor_goods", ([
        "axe": WUQI_+"axe",
        "hand": WUQI_+"hand",
        "blade": WUQI_+"blade",
        "sword": WUQI_+"double-jian",
]) );
if( clonep() ) CHANNEL_D->register_relay_channel("rumor");
setup();
carry_object("/d/sds5/city/obj/cloth/beixin")->wear();
}

