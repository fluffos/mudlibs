#include <ansi.h>
inherit NPC;

string kick_back();
int go_back();

void create()
{
set_name("潘多拉", ({ "panduo la", "la" }));
set("gender", "女性");
set("age",16);

set("str", 20);
set("per", 130);
set("cor", 30);
set("cps", 75);
set("kar", 100);
set("int", 40);
set("con", 40);
set("spi", 40);

set("long","这就是打开魔盒的潘多拉了\n");
set("title",HIM"爱因斯坦城主"NOR);
set("combat_exp", 2000000);
set("daoxing", 2000000);
set_skill("literate", 150);
set_skill("unarmed", 100);
set_skill("force", 100);
set_skill("lengquan-force", 100);
set_skill("axe", 150);
set_skill("sword", 100);
set_skill("dodge", 100);
set_skill("parry", 100);
set_skill("sanban-axe", 180);
set_skill("xiaofeng-sword", 100);
set_skill("spells", 160);
set_skill("baguazhou", 160);
set_skill("yanxing-steps", 100);
map_skill("force", "lengquan-force");
map_skill("spells", "baguazhou");
map_skill("axe", "sanban-axe");
map_skill("parry", "sanban-axe");
map_skill("dodge", "yanxing-steps");
map_skill("sword", "xiaofeng-sword");
set("max_sen", 4500);
set("max_kee", 3500);
set("force", 1500); 
set("max_force", 1500);
set("force_factor", 40);
set("max_mana", 3000);
set("mana", 3000);
set("mana_factor", 50);

set("inquiry", ([
        "冥界"  : (: kick_back :),
        "mingjie"  : (: kick_back :),
        "all"  : (: kick_back :),
        "back" : (: go_back :),
        "回去" : (: go_back :),
]) );
setup();
}

int go_back()
{
object me = this_player();
command("ok");
say(name()+"用念力将"+me->name()+"送出了哈地斯城。\n");
me->move("/d/city/kezhan");
message_vision(BLU"\n\n潘多拉从一道紫气中现身出来，对$N"BLU"道：到了。\n"NOR,me);
message_vision(BLU"紫气散去，潘多拉也消失不见。\n"NOR,me);
return 1;
}

string kick_back()
{
string str;
object me=this_player();
object ob=this_object();
if ( ob->query("asked")<=0 )
        {
        if ( me->query("sds5/city2")!="done" )
                {
                message_vision(CYN"$n"CYN"说道：你能进来也真是有本事啊....你这就去吧...\n"NOR,me,ob);
                message_vision(CYN"潘多拉把$N"CYN"一推，一道人影径直去了...．\n"NOR, me);
                me->move("/d/death/gate");
                message_vision(CYN"$N"CYN"眼前一花，咦？&#%%$%$$ \n"NOR,me);
                return "想去冥界？还是先把前面的关卡过了吧....\n";
                }
        if ( !present("nvshen shengyi",me) )
                return "没有雅典娜圣衣，去了也没什么作为。\n";

        message_vision(CYN"$n"CYN"说道：冥王正等着你们呢！\n"NOR,me,ob);
        message_vision(CYN"说罢，潘多拉把$N"CYN"一把推入了异次元空间...．\n"NOR,me);
        me->move("/d/sds5/evl/diyumen");
        message_vision(HIB"一道蓝光之后，$N"HIB"已身在冥界入口---地狱门。\n"NOR, me);
        str = WHT"【"NOR HIB"圣战"NOR RED"哈帝斯之城"NOR WHT"】"NOR;
        str+= HIC"潘多拉(Paduola)：$N($I)"HIC"看破哈地斯城的秘密，打败了拉達曼迪斯的仆人，进入了冥界。\n"NOR;
        str = replace_string(str,"$N",me->query("name"));
        str = replace_string(str,"$I",capitalize(me->query("id")));
        message("channel:chat",str,users());
        ob->set("asked",6000);
        call_out("resets",1,ob);
        return "到了。\n";
        }
return CHINESE_D->chinese_time(ob->query("asked"))+"后再来吧。\n";
}

void init()
{
add_action("do_none","ji");
add_action("do_none","move");
add_action("do_none","bian");
add_action("do_none","hua");
add_action("do_none","burn");
add_action("do_none","apply");
add_action("do_none","cast");
}

int do_none()
{
say(name()+"摇了摇头，欲言又止....\n");
return 1;
} 

void resets(object ob)
{
if ( ob->query("asked")>0 )
        {
        ob->add("asked",-1);
        ob->save();
        remove_call_out("resets");
        call_out("resets",1,ob);
        }
else    ob->delete("asked");
ob->save();
return;
}

