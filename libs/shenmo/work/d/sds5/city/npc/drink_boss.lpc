#define F_VENDOR_SALES __DIR__"vendor_sale"
inherit F_VENDOR_SALES;
#include <ansi.h>
void create() {
  reload("drink_boss");
  set_name("酒吧老板", ({ "jiuba laoban", "laoban", "boss" }));
  set("shop_id", ({ "laoban", "boss" }));
  set("shop_title", "酒吧老板");
  set("gender", "男性");
  set("combat_exp", 1000);
  set("age", 38);
  set("per", 40);
  set("attitude", "friendly");
  set("max_price", 20);
  set("vendor_goods", ([
    "dami": "/d/sds5/city/obj/food/dami",
    "jiubei": "/d/sds5/city/obj/food/cup",
  ]));
  if (clonep()) CHANNEL_D->register_relay_channel("rumor");
  setup();
  carry_object("/d/sds5/city/obj/cloth/beixin")->wear();
}
