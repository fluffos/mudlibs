#include <ansi.h>
inherit NPC;

void create() {
  set_name("土地", ({ "tudi" }));
  set("gender", "男性");
  set("age", 100 + random(900));
  set("long", "一位白胡子老公公。\n");
  set("title", "月宫神祀");
  set("combat_exp", 900000000);
  set("daoxing", 900000000);

  set_skill("dodge", 1000);
  set_skill("yanxing-steps", 1000);
  set_skill("unarmed", 1000);
  set_skill("parry", 1000);
  set_skill("staff", 1000);
  set_skill("force", 1000);
  set_skill("moonforce", 1000);
  set_skill("spells", 1000);
  set_skill("moonshentong", 1000);

  map_skill("dodge", "yanxing-steps");
  map_skill("force", "moonforce");
  map_skill("spells", "moonshentong");

  set("max_force", 150000);
  set("force", 300000);
  set("max_mana", 150000);
  set("mana", 300000);

  set("max_kee", 20000);
  set("max_gin", 20000);
  set("max_sen", 20000);
  setup();
  carry_object("/d/qujing/biqiu/obj/staff")->wield();
  carry_object("/d/obj/cloth/baipao")->wear();
}

void heart_beat() {
  object ob = this_object();
  ::heart_beat();

  if (query("eff_kee") < (query("max_kee") - 100))
    command("exert heal");

  if (query("kee") < (query("eff_kee") - 100))
    command("exert recover");

  if (query("sen") < (query("eff_sen") - 100))
    command("exert refresh");
}
