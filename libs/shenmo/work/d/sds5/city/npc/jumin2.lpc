//snowtu@XMxyj

#include <ansi.h>
inherit NPC;

void powerup();

void create() {
  set_name("居民", ({ "ju min" }));
  set("long", "哈地斯城里的普通居民，乍看和普通人没什么分别。\n" NOR);
  set("gender", random(2) ? "男性" : "女性");
  set("age", 16 + random(54));
  set("任务", 1);
  set("con", 30);
  set("per", 30);
  set("str", 30);
  set("int", 30);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: random_move :),
  }));

  setup();
  carry_object("/d/sds5/city/obj/evl_cloth")->wear();
  carry_object("/d/sds5/city/obj/weapon/hand")->wield();
}

void init() {
  object me = this_player();
  if (query("变身") && userp(me))
    command("kill " + me->query("id"));
  return;
}

void kill_ob(object me) {
  object ob = this_object();

  if (!me) {
    powerup();
    return;
  }

  if (!present(me, environment()) || me->is_ghost()) {
    powerup();
    ob->remove_killer(me);
    me->remove_killer(ob);
    return;
  }

  if (!ob->query("变身")) {
    powerup();
    ob->remove_killer(me);
    me->remove_killer(ob);
    return;
  }

  set("chat_chance_combat", 100);
  set("chat_msg_combat", ({
    (: exert_function, "bao" :),
    //        (: exert_function, "fire" :),
    //        (: exert_function, "water" :),
  }));
  ::kill_ob(me);
}

void die() {
  int dx;
  string title = WHT "【" NOR HIB "圣战" NOR RED "哈帝斯之城" NOR WHT "】" NOR;
  object ob = this_object();
  object me = ob->query_temp("last_opponent");

  powerup();

  if (!me || !present(me, environment(ob)))
    return;

  if (!ob->query("变身"))
    return;

  me->remove_killer(ob);
  ob->remove_killer(me);

  message_vision(YEL "$N" YEL "一声惨号，化作一堆尘土随风飞散开来。\n" NOR, ob, me);

  me->add("sds5/evl_num", 1);

  title += HIC + "$1($i)：$N($I)杀死了$m名$E！\n" NOR;
  title = replace_string(title, "$1", "童虎");
  title = replace_string(title, "$i", "Dohko");
  title = replace_string(title, "$N", me->query("name") + HIC);
  title = replace_string(title, "$I", capitalize(me->query("id")) + HIC);
  title = replace_string(title, "$E", ob->query("name") + HIC);
  title = replace_string(title, "$m", HIW + me->query("sds5/evl_num") + NOR HIC);

  message("channel:chat", title, users());

  if (me->query("sds5/city") != "done") {
    dx = 25000 + random(25000);
    me->add("daoxing", dx);
    tell_object(me, "你赢得了" + COMBAT_D->chinese_daoxing(dx) + "道行。\n");
    if (me->query("sds5/evl_num") >= 20) {
      tell_object(me, "恭喜，你已杀死了20名邪恶居民。\n");
      me->set("sds5/city", "done");
    } else {
      dx = 20;
      dx -= me->query("sds5/evl_num");
      tell_object(me, "你还需再杀" + chinese_number(dx) + "名邪恶居民。\n");
    }
    me->save();
  }
  destruct(ob);
  return;
}

void unconcious() {
  die();
}

void heart_beat() {
  int i, dayphase;
  object npc, ob, where, player, *who;
  dayphase = NATURE_D->query_current_day_phase();
  ob = this_object();
  ::heart_beat();

  if (dayphase <= 5 && query("变身"))
    call_out("huanyuan", 1, ob);

  if (query("kee") < 10 || query("sen") < 10)
    die();

  if (query("eff_kee") < query("max_kee"))
    command("exert heal");

  if (query("kee") < query("eff_kee") - 50)
    command("exert recover");

  if (query("sen") < query("eff_sen") - 50)
    command("exert refresh");
}

int accept_kill(object who) {
  object ob = this_object();

  if (!query("变身")) {
    say(ob->name() + "说道：我可是好市民。\n");
    return 0;
  }
  who->kill_ob(ob);
  ob->kill_ob(who);
  return 1;
}

void powerup() {
  object me = this_object();
  random(2) ? tell_room(
    environment(),
    name() + CYN "深深吸了几口气，脸色看起来好多了。\n" NOR
  ) : tell_room(environment(), name() + CYN "略一凝神，吸了口气，精神看起来清醒多了。\n" NOR);
  me->set("kee", query("max_kee"));
  me->set("eff_kee", query("max_kee"));
  me->set("sen", query("max_sen"));
  me->set("eff_sen", query("max_sen"));
  me->set("force", query("max_force") * 2);
  me->set("mana", query("max_mana") * 2);
  me->clean_condition();
  if (me->query_condition("dashouyin")) me->apply_condition("dashouyin", 0);
  return;
}

void huanyuan(object ob) {
  object npc;
  if (!ob->query("变身"))
    return;
  tell_room(environment(), HIW "阳光普照之下，" + ob->name() + HIW "又恢复了人形。\n" NOR);
  npc = new(__DIR__ "jumin2");
  npc->move(environment());
  destruct(ob);
  return;
}
