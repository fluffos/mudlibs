inherit ROOM;
#include <ansi.h>
#include "shop.h"

void create() {
  set("short", HIG "武器店" NOR);
  set("long", @LONG
城中的武器店，偶尔也有精制的武器出售。老板打着赤膊，正
热火朝天的打造着兵器。
LONG);
  set("exits", ([
    "north": __DIR__ "jie-e2",
  ]));
  set("chat_room", 1);
  set("objects", ([
    __DIR__ "npc/wuqi-boss": 1,
    __DIR__ "npc/jumin": random(3),
  ]));
  set("no_fight", 1);
  set("no_magic", 1);
  set("freeze", 1);
  setup();
}
