#include <ansi.h>
inherit ROOM;
#include "road.h"

void create() {
  set("short", WHT "爱因斯坦北街" NOR);
  set("long", @LONG
你走在一条宽阔的石板大街上，南面就快到城中心了，可以看到钟楼
耸立于前。北面是城主--潘多拉大人的宅邸。
LONG);
  set("exits", ([
    "north": __DIR__ "gate",
    "south": __DIR__ "center",
  ]));
  set("objects", ([
    __DIR__ "npc/jumin": random(2),
    __DIR__ "npc/jumin2": 1,
    __DIR__ "npc/jumin3": 1,
    __DIR__ "npc/jumin4": 1,
  ]));
  set("no_clean_up", 1);
  setup();
}

int valid_leave(object me, string dir) {
  int i;
  if (!userp(me))
    return 1;

  else if (me->query("sds5/city") != "done" && dir == "north") {
    i = 20;
    i -= me->query("sds5/evl_num");
    return notify_fail("等你再杀" + chinese_number(i) + "个变异居民才能进去！\n");
  } else return 1;
  return ::valid_leave(me, dir);
}
