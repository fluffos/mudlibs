#include <ansi.h>
inherit ROOM;
#include "road.h"

void create() {
  set("short", WHT "爱因斯坦东街" NOR);
  set("long", @LONG
你走在一条宽阔的石板大街上，西面就快到城中心了，可以看到钟楼
耸立于前。南面是一家武器店。
LONG);
  set("exits", ([
    "south": __DIR__ "wuqi",
    "west": __DIR__ "jie-e1",
  ]));
  set("objects", ([
    __DIR__ "npc/jumin": random(2),
    __DIR__ "npc/jumin2": 1,
    __DIR__ "npc/jumin3": 1,
    __DIR__ "npc/jumin4": 1,
  ]));
  setup();
}
