inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIG "爱因斯坦城格斗馆" NOR);
  set("long", @LONG
城里的格斗武馆，可惜现在已经是人去楼空，只剩下空荡荡的
场地中央一些格斗用的木头人。
LONG);
  set("exits", ([
    "north": __DIR__ "jie-w2",
  ]));
  set("objects", ([
    __DIR__ "obj/item/muren": 1 + random(4),
  ]));
  set("freeze", 1);
  setup();
}
