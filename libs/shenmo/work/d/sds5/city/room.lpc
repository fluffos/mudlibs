#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
set("short",HIM"城堡正殿"NOR);
set ("long",HIY+@LONG
爱因斯坦城的正殿，往日歌舞升平，现在冷冷清清。正对着大门
端坐着城堡唯一的正常人--堡主：潘多拉
LONG);
set("exits",([
        "south" : __DIR__"gate",
]));
set("objects",([
      __DIR__"npc/panduola" : 1,
]));
create_door("south", HIY"漆金宫门"NOR,"north",DOOR_CLOSED);
set("no_magic",1);
set("no_fight",1);
set("no_clean_up",1);
setup();
}

