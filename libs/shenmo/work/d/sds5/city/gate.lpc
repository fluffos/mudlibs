#include <ansi.h>
#include <room.h>
inherit ROOM;

#define SZ __DIR__"npc/shuangzi"
#define SY __DIR__"npc/shanyang"
#define SP __DIR__"npc/shuiping"
#define DQ __DIR__"npc/diqi"

void create() {
  set("short", HIY "宫殿大门" NOR);
  set("long", @LONG
潘多拉家族城堡的大门，庄严肃穆，金壁辉煌，宫墙里面殿
阁高大雄伟，层层叠叠，琉璃瓦白玉掾富丽堂皇。此刻宫门
紧闭。
LONG);
  set("exits", ([ /* sizeof() == 4 */
    "south": __DIR__ "jie-n1",
    "north": __DIR__ "room",
  ]));
  create_door("north", HIY "漆金宫门" NOR, "south", DOOR_CLOSED);
  set("no_clean_up", 1);
  setup();
}

void init() {
  object me, where;
  where = this_object();
  me = this_player();
  if (!userp(me)) return;
  if ((int)me->query_temp("yinshentime")) {
    me->delete_temp("yinshentime");
    me->delete("env/invisibility");
    me->save();
    me->delete_temp("no_heal_up/yinshen");
    message_vision(HIW "\n\n一阵白光过后，$N" HIW "现出了身形。\n\n" NOR, me);
  }
  if (me->query_temp("apply/name")) {
    message_vision(HIY "$N" HIY "口念咒语，身形一晃，现了真身。\n" NOR, me);
    me->delete_temp("apply/name");
    me->delete_temp("apply/id");
    me->delete_temp("apply/short");
    me->delete_temp("apply/long");
    me->delete_temp("family");
    me->delete_temp("no_heal_up/bian");
    me->save();
  }
  if (me->query("sds5/city") == "done" && me->query("sds5/city2") != "done")
    call_out("story", 5 + random(15), where, me);
}

void story(object where, object me) {
  string msg;
  object sz, sy, sp, dq;

  if (!me || !present(me, where) || where->query("story"))
    return;

  where->set("story", 1);
  sz = present("saga", where);
  if (!sz) { sz = new(SZ); sz->move(where); }
  sy = present("shura", where);
  if (!sy) { sy = new(SY); sy->move(where); }
  sp = present("kamus", where);
  if (!sp) { sp = new(SP); sp->move(where); }
  dq = present("zelosi", where);
  if (!dq) { dq = new(DQ); dq->move(where); }

  msg = CYN "$N" CYN "杀完众多变异居民后，擦擦额头的汗水，继续赶往潘多拉的住所。\n" NOR;
  msg += CYN "忽然前面传来一阵撕杀之声，却原来是$1$2" CYN "等一干人等！\n" NOR;
  msg = replace_string(msg, "$1", sz->name());
  msg = replace_string(msg, "$2", sp->name());
  message_vision(msg, me);
  sz->unconcious();
  sy->unconcious();
  sp->command("say 要不是因為城裡佈滿了哈蒂斯的意志發出的結界...真是虎落平阳被犬欺！\n");
  dq->command("laugh");
  dq->kill_ob(sp);
  sp->kill_ob(dq);
  dq->command("kill kamus");
  tell_object(me, "赶快上前助" + sp->name() + "一臂之力！\n");
  call_out("resets", 600, where);  //十分钟
  remove_call_out("stroy");
  call_out("check", 1, me, dq, sp, where);
  return;
}

void resets(object where) {
  if (where->query("story"))
    where->delete("story");
  where->reset();
  return;
}

void check(object me, object dq, object sp, object where) {
  object sz, sy;
  string msg;
  if (me->query("sds5/city2") != "done") {
    if (!sp || !living(sp) || !present(me, where)) {
      msg = WHT "【" NOR HIB "圣战" NOR RED "哈帝斯之城" NOR WHT "】" NOR;
      msg += HIC "卡妙(Kamus)：可叹可叹，功亏一篑，救不得女神！！\n" NOR;
      msg += WHT "\n【" NOR HIB "圣战" NOR RED "哈帝斯之城" NOR WHT "】" NOR;
      msg += HIC "里昂(Leon)：$N($I)" HIC "延误时机，冥界之门与之无缘！\n" NOR;
      msg = replace_string(msg, "$N", me->query("name"));
      msg = replace_string(msg, "$I", capitalize(me->query("id")));
      message("channel:chat", msg, users());
      remove_call_out("resets");
      call_out("resets", 1, where);
      me->move("/d/moon/fabao-room");
      message_vision("$N失去了即将到来的胜利，灰溜溜的离开了哈地斯城。\n", me);
      me->set_temp("sds5/lost", 1);
      me->save();
      return;
    }
  }
  remove_call_out("check");
  call_out("check", 1, me, dq, sp, where);
  return;
}

int valid_leave(object me, string dir) {
  int i;
  if (dir == "north") {
    if (me->query("sds5/city2") != "done" || present("zelosi", this_object()))
      return notify_fail("还是安心战斗吧！\n");
  }
  return ::valid_leave(me, dir);
}
