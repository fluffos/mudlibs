inherit ROOM;
#include <ansi.h>
#include "shop.h"

void create() {
  set("short", HIG "爱因斯坦城书店" NOR);
  set("long", @LONG
城里的书店，存货本是不少，不过可惜现在几乎是没有了。
LONG);
  set("exits", ([
    "south": __DIR__ "jie-w1",
  ]));
  set("chat_room", 1);
  set("objects", ([
    __DIR__ "npc/book-boss": 1,
    __DIR__ "npc/jumin": random(3),
  ]));
  set("no_fight", 1);
  set("no_magic", 1);
  set("freeze", 1);
  setup();
}
