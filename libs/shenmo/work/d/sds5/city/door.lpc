inherit ROOM;
#include <ansi.h>

void create() {
  set("short", YEL "昆仑山西山" NOR);
  set("long", @LONG
祥云光满，瑞霭香浮。在这冰天雪地里居然还有如此仙境。这里正是独立
云海，傲越千山的昆仑极巅之西。昆仑山的土地爷据说便居住在此附近。
LONG);

  set("outdoors", __DIR__);
  set("no_clean_up", 1);
  setup();
}

void init() {
  add_action("do_cast", "cast");
  add_action("do_guess", "guess");
}

int do_cast(string arg) {
  object tudi1, tudi2;
  object me = this_player();
  object env = this_object();

  if (arg == "tudi") {
    if (!me->query("sds5/gift1") || env->query("story") || me->query_temp("sds5/tudi_lost"))
      return 0;
    env->set("story", 1);
    env->save();
    message_vision(HIC "$N" HIC "念动咒语：太上老君急急如律令，本间土地何在？\n" NOR, me);
    tudi1 = new(__DIR__ "npc/tudi");
    tudi1->disable_player("<左>");
    tudi1->save();
    tudi1->move(env);
    message_vision(
      HIW "\n\n一道白光掠过，昆仑山土地从中走了出来。\n土地对着$N" HIW "深深一躬：不知" + RANK_D->query_respect(me) + HIW "降临，有失远迎。\n\n" NOR,
      me
    );
    tudi2 = new(__DIR__ "npc/tudi");
    tudi2->disable_player("<右>");
    tudi2->save();
    tudi2->move(env);
    message_vision(
      HIW "\n\n又一道白光掠过，昆仑山土地从中走了出来。\n土地对着$N" HIW "深深一躬：不知" + RANK_D->query_respect(me) + HIW "降临，有失远迎。\n\n" NOR,
      me
    );
    tudi1->command("ah");
    tudi2->command("hmm");
    call_out("story", 1, me, tudi1, tudi2, env);
    return 1;
  }
  return 1;
}

void story(object me, object tudi1, object tudi2, object env) {
  string msg;

  if (!me || !tudi1 || !tudi2 || !present(me, env))
    return;
  if (!env->query("story"))
    return;
  msg = CYN "$1" CYN "说道：自古昆仑山便是老夫的地界。汝为何人，居然敢冒充老夫？！\n" NOR;
  msg += CYN "$2" CYN "说道：自古昆仑山便是老夫的地界。汝为何人，居然敢冒充老夫？！\n" NOR;
  msg += CYN "$1" CYN "哼了一声。\n" NOR;
  msg += CYN "$2" CYN "红了脸，对着地下啐了一口：呸！\n" NOR;
  msg += CYN "两人一时之间争论不休。\n" NOR;
  msg = replace_string(msg, "$1", "土地（左）");
  msg = replace_string(msg, "$2", "土地（右）");
  message_vision(msg, me);
  remove_call_out("story");
  call_out("story2", 3 + random(5), me, tudi1, tudi2, env);
  return;
}

void story2(object me, object tudi1, object tudi2, object env) {
  string msg;

  if (!me || !tudi1 || !tudi2 || !present(me, env))
    return;
  if (!env->query("story"))
    return;

  msg = CYN "两人看到$N" CYN "，不由喜出望外，连忙拉住$N" CYN "。\n" NOR;
  msg += CYN "$1" CYN "说道：" + RANK_D->query_respect(me) + "帮我把这个妖孽打回原形，我自当告诉你一个秘密。\n" NOR;
  msg += CYN "$2" CYN "说道：" + RANK_D->query_respect(me) + "帮我把这个妖孽打回原形，我就告诉你一个天大的秘密。\n" NOR;
  msg = replace_string(msg, "$1", "土地（左）");
  msg = replace_string(msg, "$2", "土地（右）");
  message_vision(msg, me);
  me->set_temp("to_guess", 1);
  tell_object(me, "猜猜看，到底哪个才是真的土地爷。( guess 左/guess右 ) \n");
}

int do_guess(string arg) {
  int kar;
  string msg;
  object me = this_player();
  if (!me->query_temp("to_guess"))
    return notify_fail("没什么好猜的。\n");
  if (arg != "左" && arg != "右")
    return notify_fail("猜猜看，到底哪个才是真的土地爷。( guess 左/guess右 ) \n");
  kar = me->query_kar();
  msg = CYN "$N" CYN "左看看，右看看，抓耳挠腮了半天，指着" + arg + "边的土地道：你才是真正的土地爷。\n" NOR;
  message_vision(msg, me);
  me->delete_temp("to_guess");
  if (random(kar) < random(30))
    call_out("guess_win", 1, me, arg);
  else call_out("guess_lost", 1, me, arg);
  return 1;
}

void guess_win(object me, string arg) {
  int i;
  object env, *who;
  string msg;

  env = this_object();
  if (!me || !present(me, this_object()))
    return;
  who = all_inventory(env);
  if (sizeof(who) < 3)
    return;
  message_vision("\n" + arg + "边的土地高兴的跳将起来：群众的眼睛果然是雪亮的，哼哼，你有什么话说？！\n", me);
  if (arg == "左")
    msg = "右";
  else msg = "左";
  message_vision(msg + "边的土地臊红了脸，将袖一甩，覆面而去。\n", me);
  message_vision(arg + "边的土地对$N千恩万谢，道：此处有一捷径，可通异域，老夫就送你过去玩玩。\n", me);
  message_vision("说罢，土地念动咒语将$N送出了昆仑山。\n", me);
  call_out("resets", 3000, env);
  for (i = 0; i < sizeof(who); i++) {
    if (userp(who[i])) continue;
    destruct(who[i]);
  }
  me->move(__DIR__ "kezhan");
  message_vision("土地在$N耳边道声：到了！说罢，眼前已是一片新天地。\n", me);
  return;
}

void guess_lost(object me, string arg) {
  int i;
  object env, *who;
  string msg;

  env = this_object();
  if (!me || !present(me, this_object()))
    return;
  who = all_inventory(env);
  if (sizeof(who) < 3)
    return;
  message_vision("\n" + arg + "边的土地不由哈哈大笑！\n", me);
  if (arg == "左")
    msg = "右";
  else msg = "左";
  message_vision(msg + "边的土地冷哼一声，甩袖而去。\n", me);
  message_vision(arg + "边的土地哈哈一笑：好玩好玩，说完竟也不顾而去！\n", me);
  me->set_temp("sds5/tusi_lost", 1);
  me->save();
  call_out("resets", 120, env);
  for (i = 0; i < sizeof(who); i++) {
    if (userp(who[i])) continue;
    destruct(who[i]);
  }
  return;
}

void resets(object env) {
  if (env->query("story"))
    env->delete("story");
  return;
}
