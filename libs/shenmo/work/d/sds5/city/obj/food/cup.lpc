#include <ansi.h>
inherit ITEM;
inherit F_LIQUID;

string *drink = ({
        RED"女儿红"NOR,MAG"葡萄酒"NOR,HIG"竹叶青",WHT"老白干"NOR,HIW"汾酒"NOR,
});
string *names = ({
        HIR"赤木杯"NOR,MAG"夜光杯"NOR,WHT"白玉盏"NOR,HIG"青瓷盏"NOR,HIY"九龙杯"NOR,
});


void create()
{
set_name(names[random(sizeof(names))],({"jiu zhan","zhan","cup","bei"}));
set_weight(500);
if (clonep())
        set_default_object(__FILE__);
else    {
        set("long", "一个精致非常的酒盏。\n");
        set("unit", "个");
        set("value", 10000);
        set("max_liquid", 10);
        }

        // because a container can contain different liquid
        // we set it to contain wine at the beginning
set("liquid", ([
        "type": "alcohol",
        "name": drink[random(sizeof(drink))],
        "remaining": 100,
        "drunk_apply": 100,
]));
}

