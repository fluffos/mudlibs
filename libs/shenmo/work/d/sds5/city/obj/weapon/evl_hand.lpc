//#include "/d/无限示/weapon.h"
#include "/u/yhq/weapon.h"
inherit SHOUTAO;
#include <ansi.h>

string *names = ({
        HIB"幽"NOR,BLU"冥"NOR,YEL"黄"NOR,HIG"泉"NOR,HIM"腐"NOR,RED"朽"NOR,
});

void create()
{
int i;
string str,name="";
for ( i=(strlen(name)/2);i<3;i++ )
        {
        str = names[random(sizeof(names))];
        if ( strsrch(str,name)==-1 ) 
                name+=str;
        }
set_name(name+"の"WHT"刃"NOR,({"evl sword","tao","hand"}));
set_weight(4000);
if (clonep())
        set_default_object(__FILE__);
else    {
        set("unit", "股");
        set("material", "steel");
        }
init_shoutao(250);
setup();
}

