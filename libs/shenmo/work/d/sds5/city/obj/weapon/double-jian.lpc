#include <weapon.h>
inherit SWORD;

void create() {
  set_name("双手剑", ({ "duanjian", "jian" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "对");
    set("long", "这是一对剑身短小的精钢剑。\n");
    set("value", 150000);
    set("material", "steel");
    set("wield_msg", "$N「唰」的一声抽出一对$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
  }
  init_sword(100, TWO_HANDED);
  setup();
}
