#include <weapon.h>
#include <ansi.h>
inherit BLADE;

void create()
{
set_name("双手刀",({"shuangshou dao","dao","blade"}));
set_weight(8000);
if( clonep() )
        set_default_object(__FILE__);
else    {
        set("unit", "对");
        set("value", 150000);
        set("material", "iron");
        set("long", "这是一对寻常的双刀，份量大约十三、四斤重。\n");
        set("wield_msg", "$N抽出一对明晃晃的$n握在手中。\n");
        set("unequip_msg", "$N将手中的一对$n插入腰间。\n");
        }
init_blade(100,TWO_HANDED);
setup();
}

