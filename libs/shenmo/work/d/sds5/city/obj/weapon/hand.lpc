//#include "/d/无限示/weapon.h"
#include "/u/yhq/weapon.h"
inherit SHOUTAO;

void create() {
  set_name("拳套", ({ "quan tao", "tao", "hand" }));
  set_weight(4000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "对");
    set("long", "精钢打制的拳套，拳背嵌着钢刺。\n");
    set("value", 250000);
    set("material", "steel");
    set("wield_msg", "$N掏出一对$n戴在手中。\n");
    set("unwield_msg", "$N将手上的$n脱了下来。\n");
  }
  init_shoutao(150, TWO_HANDED);
  setup();
}
