#include <armor.h>
#include "check_owner.lpc"
inherit ARMOR;

void create()
{
   set_name(YEL"长袍"NOR, ({ "chang pao" }) );
   set_weight(3000);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("unit", "件");
     set("material", "steel");
     set("armor_prop/armor",800);
   }
   setup();
}

