#include <armor.h>
inherit BOOTS;

void create()
{
set_name("草履", ({"cao lv", "xie", "shoes" }) );
set_weight(1000);
if( clonep() )
        set_default_object(__FILE__);
else    {
        set("material", "wood");
        set("unit", "双");
        set("value", 10);
        set("armor_prop/dodge",2);
        set("armor_prop/armor",5);
        }
setup();
}

