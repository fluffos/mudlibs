#include <ansi.h>
inherit ROOM;
#include "road.h"

void create() {
  set("short", BLU "十字街头" NOR);
  set("long", WHT + @LONG
这里便是哈帝斯城的中心，四条大街交汇于此。一座巍峨高大的钟楼
耸立于前，很是有些气势。昔日这里也是车水马龙，来往人潮不断。
可惜现在只有寥寥一些路人。
LONG + NOR);

  set("exits", ([
    "north": __DIR__ "jie-n1",
    "west": __DIR__ "jie-w1",
    "east": __DIR__ "jie-e1",
    "down": __DIR__ "droproom",
  ]));

  set("objects", ([
    __DIR__ "npc/jumin2": random(2),
    __DIR__ "npc/jumin3": random(2),
  ]));

  setup();
}
