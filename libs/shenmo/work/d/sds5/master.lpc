//冥界数据查询系统
#include <ansi.h>
inherit ROOM;

nosave object leader, *team;
nosave int start = 0;

void SetStart();

void create()
{
set("short",HIB"冥界观摩室"NOR);
set("long",RED"这里是天神观察冥界动向的一间神奇房间。"NOR);
set("no_time",1);
set("no_fight",1);
set("no_magic",1);
set("freeze",1);
setup();
}

int AddTeam(object ob)
{
int i;  
if ( !living(ob) 
  || (userp(ob) && ob->query("sds4/box")!="done") )
        return 0;

if ( sizeof(team)>=4 )
        return 0;

if( arrayp(team) ) 
        {
        if( member_array(ob, team)==-1 ) 
                {
                team -= ({ 0 });
                team += ({ ob });
                for(i=sizeof(team)-1; i>=0; i--)
                        team[i]->SetTeam(team);
                } 
        else    return 0;
        } 
else    {
        team = ({ this_object(), ob });
        ob->SetTeam(team);
        }
message("channel:chat",sprintf(HIC"〖 "HIB"冥界"HIC" 〗童虎(Dohko)：%s(%s)"HIC"加入了圣战的队伍！\n"NOR,
                         ob->query("name"),
                         capitalize(ob->query("id")) ),users());
return 1;
}

int SetLeader(object ob)
{
if( !userp(ob) || !living(ob) || objectp(leader) )
        return 0;
if ( !AddTeam(ob) )
        return 0;        
leader = ob;
message("channel:chat",sprintf(HIC"〖 "HIB"冥界"HIC" 〗童虎(Dohko)：%s(%s)"HIC"决定领导众圣斗士进行圣战！\n"NOR,
                         ob->query("name"),
                         capitalize(ob->query("id")) ),users());
return 1;
}

void SetStart()
{
message("channel:chat",sprintf(HIC"〖 "HIB"冥界"HIC" 〗童虎(Dohko)：雅典娜的圣斗士们，圣战开始了！\n"NOR),users());
start = 1;
}

int IsStart()
{
return start;
}               

object QueryLeader() 
{ 
return leader; 
}

int SetTeam(object *t)
{
team = t;
}

int LeaveTeam(object ob)
{
int i;
if ( !ob || !arrayp(team) || member_array(ob,team)==-1 )
        return 0;
team -= ({ ob });
message("channel:chat",sprintf(HIC"〖 "HIB"冥界"HIC" 〗童虎(Dohko)：%s(%s)"HIC"离开了圣战的队伍！\n"NOR,
                         ob->query("name"),
                         capitalize(ob->query("id")) ),users());
return 1;
}

object *QueryTeam()
{
return team;
}

void reset()
{
string *msg = ({
        "哈哈，圣斗士们，你们纵是再努力也是没用的，我始终是要复活的！",
        "拉达曼迪斯！你在做什么？！怎么动作这么慢！！",
        "冥斗士们，对付这些蝼蚁怎么这么慢？！",
        "恩......，伟大的时刻即将来临，我要拿雅典娜的血来做降世的洗礼！！",
});     
string *msg1 = ({
        "黑暗的力量逐渐聚集在圣域......",
        "五老峰的巨渊之下不时传来嗜魂的吼叫......",
        "恐怖的冥界之主即将重临人间......",
});             
        
if ( IsStart() )
        message("shout",HIC"〖 "HIB"冥界"HIC" 〗哈帝斯(Hades)："+msg[random(sizeof(msg))]+"\n"NOR,users());
else    message("shout",HIB"\n"+msg1[random(sizeof(msg1))]+"\n\n"NOR,users()); 
}

void resets()  //数据初始
{
leader = 0;
team = ({});
start = 0;
reset();
}

