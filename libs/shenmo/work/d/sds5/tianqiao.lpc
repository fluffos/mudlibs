/*
花径湖以下，两崖拱峙、峭石堆砌，恰似断桥，故名。
天桥之奇，尚不全在桥本身。桥临绝谷，绝谷之内，
多峭壁峰壑，层层刻剥，如堆如砌，蔚为奇观。或如
雄狮长啸，或似猛虎跃间，或如捷猿攀登，或若仙翁
盘坐。如遇云海自谷底涌起，银浪翻滚，真似蓬莱仙
桥。待云雾飞上桥面，游人只需轻轻拂扫，便又飘然
而去。 
*/

inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "天桥");
  set("long", @LONG

这里便是闻名已久的庐山天桥，但见两崖拱峙、峭石堆砌，
恰似断桥。
桥临绝谷，绝谷之内，多峭壁峰壑，层层刻剥，如堆如砌，
蔚为奇观。或如雄狮长啸，或似猛虎跃间，或如捷猿攀登，
或若仙翁盘坐。如遇云海自谷底涌起，银浪翻滚，真似蓬
莱仙桥。待云雾飞上桥面，游人只需轻轻拂扫，便又飘然
而去。 

LONG);

  set("exits", ([
    "down": __DIR__ "shanlu1",
    "north": __DIR__ "jinxiugu",
  ]));
  set("objects", ([
    //	__DIR__"npc/animal" : random(3),
  ]));
  set("outdoors", __DIR__ "");
  setup();
}
