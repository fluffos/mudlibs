inherit ROOM;
#include <ansi.h>
#define MSK_D "/d/sds5/master.lpc"

void create() {
  set("short", "五老峰");
  set("long", @LONG

这便是庐山著名的五老峰。
上顶苍穹，下压鄱湖，削壁千仞，绵延数里，俯视城廓川原，历历在目；
远观则洪湖遥山，相错如绣，仰视五老峰，在绚丽云霞的映照下，铁壁
染翠，丹崖流金，犹如簇簇芙蓉，在云霞之中怒放。如果登临绝顶，朝
下府视，却另有一番景象：那波涛千顷的鄱阳湖，恰似奔来眼底纵横驰
骋的峰壑，顿生五色烟云。

LONG);

  set("exits", ([
    "northwest": __DIR__ "bailudong",
  ]));
  set("objects", ([
    __DIR__ "npc/tonghu": 1,
  ]));
  setup();
}

void init() {
  add_action("do_jump", "jump");
}

int do_jump() {
  int pot;
  string msg, *limbs, limb;
  object *obs;
  object me = this_player();
  object env = this_object();
  object npc = present("dohko", env);
  limbs = me->query("limbs");
  limb = limbs[random(sizeof(limbs))];

  if (!npc) {
    npc = new(__DIR__ "npc/tonghu");
    message_vision("童虎渐渐从沉睡中醒了过来。\n", me);
    npc->move(env);
  }
  if (me->query("sds4/king") != "done" && userp(me))
    return notify_fail("你高兴得象个小孩子似的蹦蹦跳跳。\n");

  if (MSK_D->IsStart()
    && member_array(me, MSK_D->QueryTeam()) == -1)
    return notify_fail("你高兴得象个小孩子似的蹦蹦跳跳。\n");

  if (sizeof(MSK_D->QueryTeam()) <= 0 || !arrayp(MSK_D->QueryTeam())) {
    if (!MSK_D->SetLeader(me))
      return notify_fail("你高兴得象个小孩子似的蹦蹦跳跳。\n");
  }

  if (member_array(me, MSK_D->QueryTeam()) == -1) {
    if (!MSK_D->AddTeam(me))
      return notify_fail("你高兴得象个小孩子似的蹦蹦跳跳。\n");
  }
  msg = CYN "\n$N" CYN "上前走到瀑布之前，毫不犹豫，纵身跳进了万丈之渊！\n\n\n" NOR;
  pot = me->query("kar");
  msg += CYN "水花一阵响动，$N" CYN "已跳至山崖之下。\n\n\n" NOR;
  message_vision(msg, me);
  me->move(__DIR__ "yaxia");
  if (random(pot) < 25) {
    me->receive_damage("kee", me->query("kee") / 10 * 9);
    me->receive_wound("sen", me->query("eff_sen") / 10 * 9);
    me->set("force", 0);
    me->set("mana", 0);
  }
  me->start_busy(3);
  return 1;
}
