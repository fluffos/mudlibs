// autoload.c

string *autoload;

void clean_up_autoload() { autoload = 0; }

void save_autoload() {
  object *inv;
  int i, j;
  mixed param;

  inv = all_inventory();
  autoload = allocate(sizeof(inv));
  for (i = 0, j = 0; i < sizeof(inv); i++) {
    if (!(param = inv[i]->query_autoload())) continue;
    autoload[j] = base_name(inv[i]);
    if (stringp(param)) autoload[j] += ":" + param;
    j++;
  }
  autoload = autoload[0..j - 1];
}

void restore_autoload() {
  int i, count;
  object ob;
  string file, param, err;
  object user, cloth, liuli;
  user = this_object();


  if (!pointerp(autoload)) return;

  for (i = 0; i < sizeof(autoload); i++) {
    if (sscanf(autoload[i], "%s:%s", file, param) != 2) {
      file = autoload[i];
      param = 0;
    }
    err = catch(ob = new(file));
    if (err || !ob ||
      (file[0..2] == "/u/" && !wizardp(this_object()))) {
      //mon 1/20/98
      write("你觉得似乎失落了什么重要的东西，最好通知一下巫师。\n");
      log_file("AUTOLOAD", sprintf(
        "Fail to autoload %s of %s, error %s on %s\n",
        file, this_object()->query("id"), err, ctime(time())));
      continue;
    }
    export_uid(ob);
    ob->move(this_object());
    count += ob->wear();
    ob->autoload(param);
  }
  // Not sure how count works, it isn't initialized (to be 0?) Dream 8/24/97
  //        if (count==0)
  {
    if (user->query("gender") == "女性") {
      cloth = new("/obj/loginload/skirt.lpc");
      cloth->move(user);
      cloth->wear();
      cloth = new("/obj/loginload/shoes.lpc");
      cloth->move(user);
      cloth->wear();
    } else {
      cloth = new("/obj/loginload/linen.lpc");
      cloth->move(user);
      cloth->wear();
    }
  }
  if (user->query("water_light") == 1) {
    cloth = new("/d/wiz/obj/j.lpc");
    cloth->move(user);
  }

  //***********************琉璃****************

  if (user->query("newborn/three_bai") == "done") {
    liuli = new("/d/newborn/three/obj/bai");
    liuli->set("owner", user->query("id"));
    liuli->move(user);
  }
  if (user->query("newborn/three_jin") == "done") {
    liuli = new("/d/newborn/three/obj/jin");
    liuli->set("owner", user->query("id"));
    liuli->move(user);
  }
  if (user->query("newborn/three_qing") == "done") {
    liuli = new("/d/newborn/three/obj/qing");
    liuli->set("owner", user->query("id"));
    liuli->move(user);
  }
  if (user->query("newborn/three_zi") == "done") {
    liuli = new("/d/newborn/three/obj/zi");
    liuli->set("owner", user->query("id"));
    liuli->move(user);
  }


  //*******************************************
  //*******************************************王者之冠******************************/
  if (user->query("king_of_crown") == "done") {
    liuli = new("/d/crown/obj/kingcrown");
    liuli->set("owner_id", user->query("id"));
    if (!liuli->restore()) {
      liuli->set("armor_prop", ([
        "strength": 1,
        "courage": 1,
        "intelligence": 1,
        "spirituality": 1,
        "composure": 1,
        "personality": 1,
        "constitution": 1,
        "karma": 1,

        "armor": 60,
        "spells": 1,
        "dodge": 1,
        "parry": 1,
        "force": 1,
      ]));
      liuli->set("level", 1);
      liuli->save();
    }

    liuli->move(user);
  }


  clean_up_autoload();            // To save memory.
}
