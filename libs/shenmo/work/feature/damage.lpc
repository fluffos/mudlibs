#include <ansi.h>
#include <dbase.h>
#include <login.h>
#include <skill.h>
#include <move.h>

void remove_faint(object me);

int ghost = 0;

int is_ghost() { return ghost; }

//自动full函数
varargs void powerup(int flag, int no_condition) {
  if (!objectp(this_object()))
    return;
  if (flag && flag >= 1)
    message_vision(HIG "$N" HIG "从怀里小心翼翼的拿出一颗云丹送入嘴中，果然见$P脸上慢慢泛出红光，法力和内力到了极限！\n" NOR, this_object());
  set("kee", (int)query("max_kee"));
  set("eff_kee", (int)query("max_kee"));
  set("sen", (int)query("max_sen"));
  set("eff_sen", (int)query("max_sen"));
  set("force", (int)query("max_force"));
  set("mana", (int)query("max_mana"));
  if (!no_condition || no_condition < 1)
    this_object()->clear_condition();
}

int self_purge() {
  object me = this_object();
  object link_ob = me->query_temp("link_ob");

  if (!userp(me))
    return 0;
  if ((int)me->query("max_kee") > 0
    && (int)me->query("max_sen") > 0)
    return 0;
  set_heart_beat(0);
  ghost = 1;
  me->move("/d/death/block.lpc");
  CHANNEL_D->do_channel(me, "rumor", me->query("name") + "因为年纪太大，心力交瘁，不幸与世长辞，永远离开了我们！");
  return 1;
}

void gameover() {
  object me = this_object();

  if (!userp(me)) return;

  me->move("/d/death/block.lpc");
  if (!me->query("life/death_announced")) {
    me->set("life/death_announced", 1);
    CHANNEL_D->do_channel(load_object(COMBAT_D), "rumor", me->query("name") + "寿终正寝，永远地离开了我们。");
  }
}

int check_gameover() {
  return 0;
}

void announce_live_forever(string reason) {
  object me = this_object();
  object dadi;

  if (!reason)
    return;

  if (me->query("life/live_forever_announced"))
    return;

  me->set("life/live_forever_announced", 1);
  me->set("life/live_forever", 1);
  me->set("fake_age", (int)me->query("age"));

  dadi = new("/d/wiz/npc/dadi.lpc");
  dadi->move(environment(me));

  message_vision(HIY "只听一阵仙乐缥缈，一驾五彩云车从天缓缓而降。\n" NOR, dadi);
  message_vision(HIY "$N从车上立起身来对$n一拱手：恭喜！恭喜！\n" NOR, dadi, me);
  dadi->command_function("chat " + reason);
  message_vision(HIY "$N一挥手，云车渐渐淡去...\n" NOR, dadi);
  destruct(dadi);
  return;
}

varargs int receive_damage(string type, int damage, object who) {
  mapping shield;
  string msg;
  object fabao;
  int pp, max_damage, val, mana, level, r_damage;

  if (damage < 0) return 0;  //add by fang
  if (type != "kee" && type != "sen")
    return 0;
  if (objectp(who)) {
    if (objectp(who->query_temp("invoker")))
      who = who->query_temp("invoker");
    set_temp("last_damage_from", who);
  }

  mana = 0;
  level = 0;
  /*---------------------------- 
  光影盾
  借用魔法盾，但做了较大调整
  作为xian法术的加强。
  windy  2011.08 
----------------------------*/
  if (this_object()->is_fighting() && query_temp("lightshield") && damage > 0
    && who && objectp(who) && who != this_object() && type == "kee" && who->query("spskkk") != 4) {
    mana = query("mana");
    level = query("level");
    max_damage = level * 10;
    if (level < 600)
      val = 4;
    else if (level < 1200)
      val = 3;
    else val = 2;
    if ((who->query("class") == "yao" && random(who->query("level")) > level / 2 && !random(20))
      || (who->query("class") == "saint" && random(who->query("level")) > level / 2 && !random(40))
      || (who->query("class") == "shen" && random(who->query("level")) > level / 2 && !random(40))) {
      message_vision(HIB "$N" HIB "周身的光影盾突然间“咔咔”出现数道裂纹，瞬间崩溃碎裂开来。\n" NOR, this_object());
      this_object()->delete_temp("lightshield");
      this_object()->set_temp("lightshield_over", time());
      damage = 0;
    } else if (damage >= max_damage) {
      message_vision(HIB "$N" HIB "周身的光影盾难以承受如此大的力道，瞬间崩溃碎裂开来。\n" NOR, this_object());
      this_object()->delete_temp("lightshield");
      this_object()->set_temp("lightshield_over", time());
      damage -= max_damage;
      if (mana > max_damage * val)
        set("mana", mana - (max_damage * val));
      else set("mana", 0);
    } else if (mana >= damage * val) {
      message_vision(HIB "$N" HIB "周身的光影盾蓝芒闪烁，将部分力道向其它方向反射出去。\n" NOR, this_object());
      damage = 0;
      set("mana", mana - (damage * val));
    } else {
      message_vision(HIB "$N" HIB "周身的光影盾在一阵扭曲颤抖之后碎裂开来，最终消散得无影无踪。\n" NOR, this_object());
      damage = 0;
      this_object()->delete_temp("lightshield");
      this_object()->set_temp("lightshield_over", time());
      set("mana", 0);
    }
  }
  /*----------------------------
为超级道具而加，数据为mapp
temp("apply/super_shield",([
        "type"   : "kee"|"sen"|"eff_sen"|"eff_kee",
        "persent": (int)pot 能抵挡pot%的伤害1-100%
        "unenduring": (int)pot 减少的持久,0<pot<max_enduring
        "fabao"  : (obj)ob 此道具
]));
        snowtu/2004/10/30
----------------------------*/
  shield = query_temp("apply/super_shield");
  if (shield && mapp(shield) && this_object()->is_fighting()) {
    fabao = shield["fabao"];
    if (!fabao || !present(fabao, this_object()))
      this_object()->delete_temp("apply/super_shield");
    else if (shield["type"] == type) {
      int per, unend;
      per = shield["persent"];
      if (per > 100)
        per = 100;
      if (per > 0 && damage > 0) {
        damage -= damage * per / 100;
        msg = CYN "$n" CYN "身体微微一斜，用" + fabao->name() + CYN "硬挡了这一击。\n" NOR;
      }
      if (damage <= 0)
        damage = 0;
      unend = shield["unenduring"];
      if (unend > 0) {
        msg += CYN + fabao->name() + CYN "上现出一道裂痕。\n" NOR;
        fabao->add("unenduring", -unend);
        if (fabao->query("unenduring") <= 0) {
          msg += CYN + fabao->name() + CYN "抵挡不住伤害，碎掉了！\n" NOR;
          destruct(fabao);
        }
      }
      this_object()->set_temp("super_shiled_msg", msg);
    }
  }

  //自动卸百分比伤害的防具 snowtu
  if (pp = query_temp("apply/remove_" + type + "_damage") > 0
    && who && who != this_object() && damage > 0
    && this_object()->is_fighting()) {
    if (pp >= 100) pp = 100;
    damage -= damage * pp / 100;
    if (damage < 0) damage = 0;
  }
  //反弹百分比伤害的防具 snowtu
  if (pp = query_temp("apply/redamage_" + type + "_damage") > 0
    && who && who != this_object() && !query_temp("redamage_" + type) && damage > 0
    && this_object()->is_fighting() && objectp(who)) {
    who->set_temp("redamage_" + type, 1);
    if (pp >= 100) pp = 100;
    r_damage = damage * pp / 100;
    who->receive_damage(type, r_damage, this_object());
    if (who) who->delete_temp("redamage_" + type);
  }
  if (damage <= 0) damage = 0;

  val = (int)query(type) - damage;

  if (val >= 0)
    set(type, val);
  else {
    set(type, -1);
    if (living(this_object()) && objectp(who)
      && userp(who) && !query_temp("last_fainted_from")) {
      set_temp("last_fainted_from", who->query("id"));
      if (userp(this_object()))
        call_out("remove_faint", 60, this_player());
    }
  }
  set_heart_beat(1);
  return damage;
}

void remove_faint(object me) {
  if (me)
    me->delete_temp("last_fainted_from");
}

varargs int receive_wound(string type, int damage, object who) {
  int val, pp, level, max_damage, r_damage;
  object fabao;

  if (damage < 0) return 0;  //add by fang
  if (type != "kee" && type != "sen")
    return 0;

  if (objectp(who)) {
    if (objectp(who->query_temp("invoker")))
      who = who->query_temp("invoker");
    set_temp("last_damage_from", who);
  }

  /*---------------------------- 
  铁布衫
  作为human内功的加强。
  windy  2011.08 
----------------------------*/
  if (this_object()->is_fighting() && who && objectp(who) && who != this_object()
    && query_temp("ironshirt") && damage > 0 && type == "kee" && who->query("spskkk") != 5) {
    level = query("level");
    max_damage = level * 10;
    if (objectp(who) && ((who->query("class") == "yao" && random(who->query("level")) > level / 2 && !random(20))
      || (who->query("class") == "saint" && random(who->query("level")) > level / 2 && !random(40))
      || (who->query("class") == "shen" && random(who->query("level")) > level / 2 && !random(40)))) {
      message_vision(HIW "$N" HIW "闷哼一声，莫名其妙间，铁布衫竟然失去了作用。\n" NOR, this_object());
      this_object()->delete_temp("ironshirt");
      damage = 0;
    } else if (damage >= max_damage) {
      message_vision(HIW "$N" HIW "大叫一声，喷出一口浊气，铁布衫顿时失去了作用。\n" NOR, this_object());
      this_object()->delete_temp("ironshirt");
      damage -= max_damage;
    } else damage = 0;
  }
  //自动卸百分比伤害的防具 snowtu
  if (pp = query_temp("apply/remove_eff_" + type + "_damage") > 0
    && who && who != this_object() && damage > 0
    && this_object()->is_fighting() && objectp(who)) {
    if (pp >= 100) pp = 100;
    damage -= damage * pp / 100;
    if (damage < 0) damage = 0;
  }
  //反弹百分比伤害的防具 snowtu
  if (pp = query_temp("apply/redamage_eff_" + type + "_damage") > 0
    && who && who != this_object() && !query_temp("redamage_eff_" + type) && damage > 0
    && this_object()->is_fighting()) {
    who->set_temp("redamage_eff_" + type, 1);
    if (pp >= 100) pp = 100;
    r_damage = damage * pp / 100;
    who->receive_damage(type, r_damage, this_object());
    if (who) who->delete_temp("redamage_eff_" + type);
  }
  if (damage <= 0) damage = 0;

  val = (int)query("eff_" + type) - damage;

  if (val >= 0)
    set("eff_" + type, val);
  else {
    set("eff_" + type, -1);
    val = -1;
    if (living(this_object()) && objectp(who)
      && userp(who) && !query_temp("last_fainted_from")) {
      set_temp("last_fainted_from", who->query("id"));
      if (userp(this_object()))
        call_out("remove_faint", 60, this_player());
    }
  }

  if ((int)query(type) > val)
    set(type, val);
  set_heart_beat(1);
  return damage;
}

int receive_heal(string type, int heal) {
  int val;

  if (heal < 0)
    return 0;
  if (type != "kee" && type != "sen")
    return 0;

  val = (int)query(type) + heal;

  if (val > (int)query("eff_" + type))
    set(type, (int)query("eff_" + type));
  else set(type, val);
  return heal;
}

int receive_curing(string type, int heal) {
  int max, val;

  if (heal < 0)
    return 0;
  if (type != "kee" && type != "sen")
    return 0;
  val = (int)query("eff_" + type);
  max = (int)query("max_" + type);

  if (val + heal > max) {
    set("eff_" + type, max);
    return max - val;
  } else {
    set("eff_" + type, val + heal);
    return heal;
  }
}


/*----------------------------
        snowcat feb 8 1998
从时间来看，这个应该是因骑马
的bug而加的了，:)
----------------------------*/
void remove_ride() {
  object rider, ridee;

  if (ridee = query_temp("ridee"))
    ridee->delete_temp("rider");
  delete_temp("ridee");
  add_temp("apply/dodge", -query_temp("ride/dodge"));
  set_temp("ride/dodge", 0);
  if (rider = query_temp("rider"))
    rider->remove_ride();
  delete_temp("rider");
}

void unconcious() {
  object defeater;
  object me = this_object();

  /*----------------------------
        如果是不死地
        比如擂台一类
----------------------------*/
  if (environment() && environment()->query("alternative_die")
    && me->query_temp("alternative_die") != 1) {
    environment()->alternative_die(this_object());
    return;
  }

  if (!living(this_object()))
    return;

  if (wizardp(this_object()) && query("env/immortal")) {
    message(
      "vision",
      HIR + "\n" + this_object()->name() + HIR "身子一歪，险些栽倒．．．\n\n" NOR,
      environment(),
      this_object()
    );
    tell_object(this_object(), HIY "你使用巫师的神力使自己迅速恢复了正常。\n" NOR);
    powerup();
    return;
  }
  if (objectp(defeater = query_temp("last_damage_from")))
    COMBAT_D->winner_reward(defeater, this_object());

  this_object()->remove_all_enemy();
  remove_ride();

  message("system", HIR "\n你的眼前一黑，接着什么也不知道了．．．\n\n" NOR, this_object());
  this_object()->disable_player(" <昏迷不醒>");
  //      set("gin", 0);
  set("kee", 0);
  set("sen", 0);
  set_temp("block_msg/all", 1);
  COMBAT_D->announce(this_object(), "unconcious");

  call_out("revive", random(100 - query("con")) + 30);
}


varargs void revive(int quiet) {
  remove_call_out("revive");

  /*----------------------------
delete_temp("last_fainted_from");
revive 不能移除此标记
----------------------------*/
  /*----------------------------
  有的时候玩家清醒过来后
  可能会依然不能动，从而
  不能自行恢复HP
  所以清除相关的标记
----------------------------*/
  delete_temp("no_move");
  delete_temp("no_special");
  if (this_object()->is_busy())
    this_object()->start_busy(1);

  while (environment()->is_character())
    this_object()->move(environment(environment()));
  this_object()->enable_player();
  set_temp("block_msg/all", 0);
  if (!quiet) {
    COMBAT_D->announce(this_object(), "revive");
    message("system", HIY "\n慢慢地你终于又有了知觉．．．\n\n" NOR, this_object());
  }
}

void die() {
  object corpse, killer, me, guai;
  object *inv;
  int i;
  string last_fainted_from, str;

  me = this_object();
  if (environment() && environment()->query("alternative_die")
    && me->query_temp("alternative_die") != 1) {
    environment()->alternative_die(this_object());
    return;
  }
  me->delete_temp("alternative_die");
  if (query_temp("last_fainted_from"))
    last_fainted_from = query_temp("last_fainted_from");

  if (!living(this_object()))
    revive(1);
  if (wizardp(this_object()) && query("env/immortal")) {
    message(
      "vision",
      HIR + "\n" + this_object()->name() + HIR "脸色一变，险些栽倒．．．\n\n" NOR,
      environment(),
      this_object()
    );
    tell_object(this_object(), HIY "你使用巫师神力使自己迅速恢复了正常。\n" NOR);
    powerup();
    return;
  }
  this_object()->clear_condition();
  /*----------------------------
因为last_fainted_from被revive()
清除了，所以需要
----------------------------*/
  if (last_fainted_from)
    set_temp("last_fainted_from", last_fainted_from);

  COMBAT_D->announce(this_object(), "dead");

  /*----------------------------
        如来任务
----------------------------*/
  if (me->query("rulaitask/get")) {
    guai = me->query("rulaitask/guai");
    if (guai == me->query_temp("last_damage_from")
      || guai == me->query_temp("last_opponent")) {
      powerup();
      me->set("kee", me->query("max_kee") / 3);
      me->set("sen", me->query("max_sen") / 3);
      me->add("combat_exp", -1000);
      me->add("daoxing", -1000);
      me->add("rulaitask_log/die", 1);
      me->delete("rulaitask/get");
      me->set("rulaitask/fail", 1);
      str = me->name() + HIM "被" + guai->name() + HIM "杀死了，所幸" HIY "如来" HIM "及时出手相救，才捡回一命。";
      message("channel:rumor", HIM "【" HIG "千里眼" HIM "】某人：" + str + "\n" NOR, users());
      log_file("taskdeath", sprintf("[%s] %s is task killed by %s.\n",
        ctime(time()),
        this_object()->query("id"),
        guai->name())
      );
      remove_ride();
      me->move("/d/qujing/lingshan/daxiong");
      message_vision(HIY "如来佛一伸左手把$N" HIY "的魂魄从地府里拉了回来，再一伸右手不知道从
哪里把$P的尸体抓了回来，接着两手一合，硬生生地把$N" HIY "魂魄逼回身体。\n" NOR, me);
      me->unconcious();
      me->start_busy(10);
      return;
    }
  }

  inv = all_inventory(this_object());
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->query("owner_id") == getuid(this_object())) {
      tell_object(this_object(), HIB "你看到" + inv[i]->query("name") + HIB "破空而去，慢慢消失在天际．．．\n" NOR);
      destruct(inv[i]);
    }
  }

  if ((int)this_object()->query("max_kee") > 0
    && (int)this_object()->query("max_sen") > 0) {
    if (objectp(killer = query_temp("last_damage_from"))) {
      set_temp("my_killer", killer->query("id"));
      COMBAT_D->killer_reward(killer, this_object());
      if (userp(this_object()))
        log_file("death", sprintf("[%s] %s is killed by %s.\n",
          ctime(time()),
          this_object()->query("id"),
          killer->query("id"))
        );
    } else {
      if (userp(this_object())) {
        COMBAT_D->victim_penalty(this_object());
        if (str = this_object()->query_temp("death_msg"))
          str = this_object()->name(1) + str;
        else str = this_object()->name(1) + "莫名其妙地死了。\n";
        COMBAT_D->announce(this_object(), "death_rumor", str);
        log_file("death", sprintf("[%s] %s is killed: %s.\n",
          ctime(time()),
          this_object()->query("id"),
          str)
        );
      }
    }
  }

  remove_ride();

  if (objectp(corpse = CHAR_D->make_corpse(this_object(), killer)))
    corpse->move(environment());

  this_object()->remove_all_killer();
  all_inventory(environment())->remove_killer(this_object());

  this_object()->dismiss_team();
  if (this_object()->self_purge())
    return;
  if (userp(this_object())) {
    set("kee", 1);
    set("eff_kee", 1);
    set("sen", 1);
    set("eff_sen", 1);
    if (!this_object()->query("life/life_time"))
      this_object()->set("life/life_time", 60);
    if (!this_object()->query("life/no_death_decrease"))
      this_object()->set("life/life_time", (int)this_object()->query("life/life_time") - 1);
    if (check_gameover())
      return;
    ghost = 1;
    this_object()->move(DEATH_ROOM);
    DEATH_ROOM->start_death(this_object());
  } else destruct(this_object());
}

void reincarnate() {
  ghost = 0;
  /*----------------------------
drop all,否则会将鬼魂带出地府
----------------------------*/
  command("drop all");
  //      set("eff_gin", query("max_gin"));
  set("eff_kee", query("max_kee"));
  set("eff_sen", query("max_sen"));
}

int max_food_capacity() {
  int final;
  final = (int)query_weight() / 200;
  if (final < 100)
    final = 100;
  return final;
}

int max_water_capacity() {
  int final;
  final = (int)query_weight() / 200;
  if (final < 100)
    final = 100;
  return final;
}

int max_level_exp() {
  int max_exp, lvl = query("level");
  if (lvl < 5)
    max_exp = 100;
  else if (lvl < 50)
    max_exp = (lvl + 5) * (lvl + 5) * 1500;
  else if (lvl < 200) max_exp = (lvl + 1) * (lvl + 1) * 1000;
  else max_exp = (lvl + 1) * (lvl + 1) * 700;
  if (max_exp > 1000000000) max_exp = 1000000000;
  if (max_exp < 0) max_exp = 1500000000;
  return max_exp;
}

int heal_up() {
  mapping my;
  int update_flag;

  if (!environment()) return 0;
  my = query_entire_dbase();

  if (environment()) {
    if (environment()->query("no_time"))
      return -1;
  }
  update_flag = 0;

  if (sizeof(query_temp("no_heal_up")))
    return update_flag;
  /*----------------------------
        mon 01/22/99
allow_heal_up 将允许NPC战斗时
heal up 默认为no help up.
----------------------------*/
  if (!userp(this_object())
    && this_object()->is_fighting()
    && !my["allow_heal_up"])
    return update_flag;
  if (my["water"] > 0) {
    my["water"] -= 1;
    update_flag++;
  }
  if (my["food"] > 0) {
    my["food"] -= 1;
    update_flag++;
  }
  if (my["water"] < 1 && userp(this_object()))
    return update_flag;
  /*----------------------------
kee和force依赖饮水来自动恢复
----------------------------*/
  my["kee"] += my["con"] / 3 + my["force"] / 10;
  if (my["kee"] >= my["eff_kee"]) {
    my["kee"] = my["eff_kee"];
    if (my["eff_kee"] < my["max_kee"]) {
      my["eff_kee"]++;
      update_flag++;
    }
  } else update_flag++;

  if (my["max_force"] && my["force"] < my["max_force"]) {
    my["force"] += (int)this_object()->query_skill("force", 1) / 2;
    if (my["force"] > my["max_force"])
      my["force"] = my["max_force"];
    update_flag++;
  }
  if (my["food"] < 1 && userp(this_object()))
    return update_flag;
  if (my["max_atman"] && my["atman"] < my["max_atman"]) {
    my["atman"] += (int)this_object()->query_skill("magic", 1) / 2;
    if (my["atman"] > my["max_atman"])
      my["atman"] = my["max_atman"];
    update_flag++;
  }
  /*----------------------------
sen和mana依赖饮食来自动恢复
----------------------------*/
  my["sen"] += my["con"] / 3 + my["mana"] / 10;
  if (my["sen"] >= my["eff_sen"]) {
    my["sen"] = my["eff_sen"];
    if (my["eff_sen"] < my["max_sen"]) {
      my["eff_sen"]++;
      update_flag++;
    }
  } else update_flag++;

  if (my["max_mana"] && my["mana"] < my["max_mana"]) {
    my["mana"] += (int)this_object()->query_skill("spells", 1) / 2;
    if (my["mana"] > my["max_mana"]) my["mana"] = my["max_mana"];
    update_flag++;
  }
  return update_flag;
}
