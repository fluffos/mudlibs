#pragma optimize

#include "/adm/simul_efun/atoi.lpc"
#include "/adm/simul_efun/chinese.lpc"
#include "/adm/simul_efun/gender.lpc"
#include "/adm/simul_efun/object.lpc"
#include "/adm/simul_efun/path.lpc"
#include "/adm/simul_efun/wizard.lpc"
#include "/adm/simul_efun/util.lpc"
// This must be after gender.c
#include "/adm/simul_efun/message.lpc"
#include "/adm/simul_efun/file.lpc"

void create() {
  seteuid(getuid());
  write("simul_efun loaded successfully.\n");
}

object unew(string str) {
  object ob;
  int i, j, k;
  object *clone;

  if (!stringp(str)) return 0;

  ob = new(str);
  // new() of a missing file returns 0; the query below would raise call_other() Bad argument 1 and kill
  // the caller (carry_object() in an NPC's create())
  if (!ob) return ob;

  i = ob->query("unique");

  if (!i) return ob;
  clone = filter_array(children(base_name(ob)), (: clonep :));
  j = sizeof(clone);
  while (j--)
    if (!clone[j]->query("clone_by_wizard")) {
      if (k = clone[j]->query_amount()) i -= k;
      else i--;
    }
  if (i < 0) destruct(ob);
  return ob;
}

// dump_socket_status(): the MudOS efun is gone from this driver; the same table, built from socket_status()
// (a driver without the sockets package -- the WASM build -- has no sockets to list: the table is its header only)
string dump_socket_status() {
  string ret = sprintf(
    "%-3s %-10s %-9s %-22s %s\n",
    "Fd",
    "State",
    "Mode",
    "Local Address",
    "Remote Address"
  );
#ifdef __PACKAGE_SOCKETS__
  {
    mixed *all = socket_status();
    int n;

    for (n = 0; n < sizeof(all); n++)
      if (arrayp(all[n]) && sizeof(all[n]) >= 5)
        ret += sprintf(
          "%-3d %-10s %-9s %-22s %s\n",
          all[n][0],
          all[n][1],
          all[n][2],
          all[n][3],
          all[n][4]
        );
  }
#endif
  return ret;
}
