#pragma optimize

#include "/adm/simul_efun/atoi.lpc"
#include "/adm/simul_efun/chinese.lpc"
#include "/adm/simul_efun/gender.lpc"
#include "/adm/simul_efun/object.lpc"
#include "/adm/simul_efun/path.lpc"
#include "/adm/simul_efun/wizard.lpc"
#include "/adm/simul_efun/util.lpc"
// This must be after gender.c
#include "/adm/simul_efun/message.lpc"
#include "/adm/simul_efun/file.lpc"

void create() {
  seteuid(getuid());
  write("simul_efun loaded successfully.\n");
}

object unew(string str) {
  object ob;
  int i, j, k;
  object *clone;

  if (!stringp(str)) return 0;

  ob = new(str);
  // new() of a missing file returns 0; the query below would raise call_other() Bad argument 1 and kill
  // the caller (carry_object() in an NPC's create())
  if (!ob) return ob;

  i = ob->query("unique");

  if (!i) return ob;
  clone = filter_array(children(base_name(ob)), (: clonep :));
  j = sizeof(clone);
  while (j--)
    if (!clone[j]->query("clone_by_wizard")) {
      if (k = clone[j]->query_amount()) i -= k;
      else i--;
    }
  if (i < 0) destruct(ob);
  return ob;
}
