void generate_wokou_2(string room, string name, int make_count, string *path)
{
    //第一轮倭寇数量比报名玩家数量多20%，以后每轮增加30%的数量
    //第一轮倭寇强度比报名玩家高30%，以后每轮增加10%的强度
    int count = sizeof(actors) * 120 / 100 ;

    //第二轮，增援部队，第一批，70%的倭寇和忍者，30%的罗刹和修罗
    int count_1 = count * 70 / 100;
