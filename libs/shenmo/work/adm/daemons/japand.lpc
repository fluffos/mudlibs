int can_join()
{
    return (WAR_START == war_state) || (WAR_PREPARE == war_state);
}

int can_reward()
{
    return WAR_END == war_state;
}

int in_war()
{
    return WAR_NONE != war_state;
}

void actor_retreat(object who)
{
    if ( who )
    {
        who->add_temp("sunrise/retreat", 1);
    }
}

mixed cannot_play(object who)
{
    if ( !wizardp(who) && who->query("combat_exp") < 2500000 )
    {
        return "大米也要参战?";
    }

    if ( MAX_ACTORS <= sizeof(actors) )
    {
        return "这次来犯的贼寇并没有那么多。";
    }

    return 0;
}

int have_join(object who)
{
    if ( !who )
    {
        return 0;
    }

    return who->query_temp("sunrise/honor");
}

void alternative_die(object who)
{
    if ( !who )
    {
        return;
    }

    who->move("/d/sunrise/guandao_1");
    who->clear_condition();
    who->delete_temp("no_move");
    message_vision(HIY"\n\n戚大帅盯着$N，叹了口气: 英雄好自为之。说完伸手在$N顶门一拍\n"NOR, who);

    who->set("kee", who->query("max_kee") / 3);
    who->set("sen", who->query("max_sen") / 3);
    who->set("eff_kee", who->query("max_kee"));
    who->set("eff_sen", who->query("max_sen"));
    who->set("force", 100);
    who->set("mana", 100);
    who->start_busy(10);

    //算撤退一次
    actor_retreat(who);
}

void init_player(object who)
{
    if ( who )
    {
        who->delete_temp("sunrise/retreat");
        who->delete_temp("sunrise/killed");
        who->delete_temp("sunrise/reward");
    }
}

//在玩家列表里添加一个玩家，如果已经存在这个玩家，返回0
int add_actor(object actor)
{
    if ( -1 != member_array(actor, actors) )
    {
        return 0;
    }

    //给参与者一个标记sunrise/honor，倭寇方的标记sunrise/dishonor
    actor->set_temp("sunrise/honor", 1);

    //删除撤退记录
    init_player(actor);

    actors += ({actor});

    return 1;
}

void clear_all_actor()
{
    object obj;

    foreach ( obj in actors )
    {
        if ( obj )
        {
            obj->delete_temp("sunrise/honor");
            init_player(obj);
        }
        reset_eval_cost();
    }

    actors = ({});
}

void set_master_state(int state)
{
    master_state = state;
}

int query_master_state()
{
    return master_state;
}

int query_actor(object actor)
{
    return (-1 != member_array(actor, actors));
}

int query_sunrise_block()
{
    return sunrise_block;
}

void proceed_war_defense(int state, int round)
{
    remove_call_out("proceed_war_defense");

    if ( !war_machine[round] )
    {
        return;
    }

    if ( !war_machine[round][state] )
    {
        return;
    }

    if ( !functionp(war_machine[round][state]) )
    {
        return;
    }

    set_state(state);
    set_round(round);

    evaluate(war_machine[round][state]);
}

string get_wokouname(string type)
{
    if ( !wokou_type[type] )
    {
        return "未知";
    }

    return wokou_type[type]["name"];
}

void destroy_all()
{
    string *wokou;
    int count, i;
    mixed *rzrs;
    object rzr, env;
    string enemy;

    //清除上一轮遗留的所有倭寇
    wokou = keys(wokou_type);
    count = sizeof(wokou);
    for ( i = 0; i < count; i++ )
    {
        enemy = wokou_type[wokou[i]]["file"];
        rzrs = children(enemy);

        foreach ( rzr in rzrs )
        {
            if ( !rzr )
            {
                continue;
            }

            env = environment(rzr);
            if ( env )
            {
                tell_room(env, HIR"号角响起，" + rzr->query("name") + "急匆匆的离开了。\n"NOR);
            }

            destruct(rzr);
            reset_eval_cost();
        }

        reset_eval_cost();
    }

    //清除上一轮遗留的所有守将
    foreach ( enemy in soldiers )
    {
        rzrs = children(enemy);

        foreach ( rzr in rzrs )
        {
            if ( !rzr )
            {
                continue;
            }

            env = environment(rzr);
            if ( env )
            {
                tell_room(env, HIR"号角响起，" + rzr->query("name") + "急匆匆的离开了。\n"NOR);
            }

            destruct(rzr);
            reset_eval_cost();
        }

        reset_eval_cost();
    }

    //清除上一轮遗留的所有城门
    foreach ( enemy in doors )
    {
        env = find_object(enemy);
        if ( !env )
        {
            env = load_object(enemy);
        }

        rzrs = all_inventory(env);
        foreach ( rzr in rzrs )
        {
            if ( "city gate" == rzr->query("id") )
            {
                destruct(rzr);
            }
            reset_eval_cost();
        }

        reset_eval_cost();
    }

    return;
}

void auto_reset_war()
{
    remove_call_out("auto_reset_war");
    call_out("auto_reset_war", UPDATE_TIME + random(3600));

    if ( WAR_NONE == query_state() )
    {
        proceed_war_defense(WAR_START, 1);
    }

    return;
}

varargs void war_message(string msg, string who)
{
    if ( !who )
    {
        message("channel:pk", HIW + "【灭寇大战】戚大帅(qi jiguang)：" + msg + "\n" + NOR, users());
    }
    else
    {
        message("channel:pk", HIW + "【灭寇大战】" + who + "：" + msg + "\n" + NOR, users());
    }
}

int query_user_count()
{
    int i, count;

    count = 0;
    for ( i = 0; i < sizeof(actors); i++)
    {
        if ( actors[i] )
        {
            count++;
        }
    }

    return count;
}

//#define DEBUG_PLAYERLEVEL
void calc_playerlevel()
{
    object obj;
    int power, step, i;
    string msg;

    actor_level = ([]);
    min_power = 2000000000;
    max_power = 0;

    //简化处理，暂时只看exp和dx的平均值
#ifdef DEBUG_PLAYERLEVEL
    min_power = 0;
    max_power = 1000000000;

    step = (max_power - min_power) / ACTOR_LEVEL_COUNT;

    for ( i = 0; i < 100; i++ )
    {
        for ( power = 0; power < ACTOR_LEVEL_COUNT; power++ )
        {
            if ( min_power + (max_power - min_power) / 100 * i < min_power + step * power 
                || min_power + (max_power - min_power) / 100 * i >= min_power + step * (power + 1) )
            {
                //不属于这一档
                continue;
            }

            if ( actor_level[power] )
            {
                if ( 0 == power )
                {
                    write(actor_level[power] + "   " + (min_power + (max_power - min_power) / 100 * i) + "\n");
                }
                actor_level[power] = (actor_level[power] + min_power + (max_power - min_power) / 100 * i) / 2;
                if ( 0 == power )
                {
                    write(actor_level[power] + "\n");
                }
            }
            else
            {
                actor_level += ([power: min_power + (max_power - min_power) / 100 * i]);
                if ( 0 == power )
                {
                    write(actor_level[power] + "\n");
                }
            }
        }

        reset_eval_cost();
    }
#else
    foreach ( obj in actors )
    {
        if ( obj )
        {
            power = obj->query("combat_exp") / 2 + obj->query("daoxing") / 2;
            if ( power < min_power )
            {
                min_power = power;
            }
            if ( power > max_power )
            {
                max_power = power;
            }
        }

        reset_eval_cost();
    }

    if ( sizeof(actors) < ACTOR_LEVEL_COUNT )
    {
        //不够划分
        for ( power = 0; power < ACTOR_LEVEL_COUNT; power++ )
        {
            actor_level += ([power: min_power / 2 + max_power / 2]);
        }
    }
    else
    {
        step = (max_power - min_power) / ACTOR_LEVEL_COUNT;

        foreach ( obj in actors )
        {
            if ( obj )
            {
                for ( power = 0; power < ACTOR_LEVEL_COUNT; power++ )
                {
                    if ( obj->query("combat_exp") / 2 + obj->query("daoxing") / 2 < min_power + step * power 
                        || obj->query("combat_exp") / 2 + obj->query("daoxing") / 2 >= min_power + step * (power + 1) )
                    {
                        //不属于这一档
                        continue;
                    }

                    if ( actor_level[power] )
                    {
                        actor_level[power] = (actor_level[power] + obj->query("combat_exp") / 2 + obj->query("daoxing") / 2) / 2;
                    }
                    else
                    {
                        actor_level += ([power: obj->query("combat_exp") / 2 + obj->query("daoxing") / 2]);
                    }
                }
            }

            reset_eval_cost();
        }

        //有遗漏的，则安排默认值处理
        for ( power = 0; power < ACTOR_LEVEL_COUNT; power++ )
        {
            if ( !actor_level[power] )
            {
                actor_level += ([power: min_power / 2 + max_power / 2]);
            }
        }
    }
#endif

    msg = "min: " + min_power + ", max: " + max_power;
    log_file("miekou", ctime(time()) + ": " + msg + "\n");

    msg = "";
    for ( power = 0; power < ACTOR_LEVEL_COUNT; power++ )
    {
        msg += power + ": " + actor_level[power] + ", ";
    }
    log_file("miekou", ctime(time()) + ": " + msg + "\n\n");
}

int get_power(int level)
{
    if ( level >= ACTOR_LEVEL_COUNT )
    {
        return min_power / 2 + max_power / 2;
    }

    if ( 1 == query_round() )
    {
        return actor_level[level] + actor_level[level] / 100 * 30;
    }

    return actor_level[level] + actor_level[level] / 100 * 30 + actor_level[level] / 100 * 10 * (query_round() - 1);
}

varargs void make_obj(string room, string file, int count, string *path)
{
    int i;
    object newroom;
    object obj;

    if ( count < 1 )
    {
        return;
    }

    if ( !newroom = find_object(room) )
    {
        newroom = load_object(room);
    }

    for ( i = 0; i < count; i++ )
    {
        obj = new(file);
        if ( !obj )
        {
            continue;
        }

        obj->move(newroom);
    }

    return;
}

varargs void make_guard(string room, string file, int count, string *path)
{
    int i;
    object newroom;
    object obj;
    int level;

    if ( count < 1 )
    {
        return;
    }

    if ( !newroom = find_object(room) )
    {
        newroom = load_object(room);
    }

    for ( i = 0; i < count; i++ )
    {
        obj = new(file);
        if ( !obj )
        {
            continue;
        }

        level = random(ACTOR_LEVEL_COUNT);
        obj->invocation(get_power(level));
        obj->set("guai_level", level);

        obj->move(newroom);

        reset_eval_cost();
    }

    return;
}

varargs void make_wokou(string room, string type, int count, string *path)
{
    int i;
    object newroom;
    object obj;
    string file = wokou_type[type]["file"];
    int level;

    if ( count < 1 )
    {
        return;
    }

    if ( !newroom = find_object(room) )
    {
        newroom = load_object(room);
    }

    for ( i = 0; i < count; i++ )
    {
        obj = new(file);
        if ( !obj )
        {
            continue;
        }

        if ( path && 0 == random(8) )
        {
            //倭寇有1/8的概率直奔大帅府
            obj->set_gopath(path);
        }

        level = wokou_type[type]["min_level"] + random(wokou_type[type]["random_level"]);
        obj->invocation(level);

        obj->move(newroom);

        reset_eval_cost();
    }

    return;
}

//这个函数产生城门、守军
void initialize_defense(int count)
{ 
    int i;
    object room, obj;
    object *inv;
    mixed *file;

    remove_call_out("initialize_defense");

    switch ( count )
    {
        case 1:
            //清除上一次战斗玩家的杀敌和撤退记录
            foreach ( obj in actors )
            {
                init_player(obj);
                reset_eval_cost();
            }

            //清除日出城其它玩家，这里已经不需要处理了，统一在日出城的room里处理
            /*file = get_dir( WAR_PLACE + "/""*.lpc", -1 );
            i = sizeof(file);
            while ( i-- )
            {
                if ( file[i][1] <= 0 )
                {
                    continue;
                }

                room = load_object(WAR_PLACE + "/" + file[i][0]);
                if ( !room )
                {
                    continue;
                }

                inv = all_inventory(room);
                foreach ( obj in inv )
                {
                    if ( userp(obj) && !wizardp(obj) && !obj->query_temp("sunrise/honor") )
                    {
                        message_vision(HIM"$N惊惶的逃离日出城！\n"NOR, obj);
                        obj->move("/d/city/kezhan");
                        obj->command("look");
                    }
                }
            }*/

            war_message(HIW + "敌人就要到达城下，各城门布防！各营将士立即到位！" + NOR);

            call_out("initialize_defense", 3, ++count);
            break;

        case 2:
            make_obj(EAST_GATE_OUTER, CITYGATE, 1);
            make_guard(EAST_GATE_OUTER, PIKEMAN, GUARD_NUMBER);
            make_obj(EAST_GATE_INNER, CITYGATE, 1);
            make_guard(EAST_GATE_INNER, PIKEMAN, GUARD_NUMBER);

            war_message("旭日门布防完毕！", "旭日营统制");

            call_out("initialize_defense", 3, ++count);
            break;        

        case 3:
            make_obj(SOUTH_GATE_OUTER, CITYGATE, 1);
            make_guard(SOUTH_GATE_OUTER, SWORDMAN, GUARD_NUMBER);
            make_obj(SOUTH_GATE_INNER, CITYGATE, 1);
            make_guard(SOUTH_GATE_INNER, SWORDMAN, GUARD_NUMBER);

            war_message("烈日门布防完毕！", "烈日营统制");

            call_out("initialize_defense", 3, ++count);
            break;

        case 4:
            make_obj(WEST_GATE_OUTER, CITYGATE, 1);
            make_guard(WEST_GATE_OUTER, BLADEMAN, GUARD_NUMBER);
            make_obj(WEST_GATE_INNER, CITYGATE, 1);
            make_guard(WEST_GATE_INNER, BLADEMAN, GUARD_NUMBER);

            war_message("落日门布防完毕！", "落日营统制");

            call_out("initialize_defense", 3, ++count);
            break;

        case 5:
            make_obj(NORTH_GATE_OUTER, CITYGATE, 1);
            make_guard(NORTH_GATE_OUTER, AXEMAN, GUARD_NUMBER);
            make_obj(NORTH_GATE_INNER, CITYGATE, 1);
            make_guard(NORTH_GATE_INNER, AXEMAN, GUARD_NUMBER);

            war_message("明月门布防完毕！", "明月营统制");

            call_out("initialize_defense", 3, ++count);
            break;

        case 6:
            if ( 0 >= query_user_count() )
            {
                //无人报名
                war_message(HIR + "可叹我堂堂中原，却连一个英雄人物都找不出来，我军孤军奋战！" + NOR);
                call_out("lose_war", 10);
            }
            else
            {
                door_broken = 0;

                //将日出城的入口封锁，所有城内未参战玩家都会被清理出去
                sunrise_block = 1;

                //报名玩家分档
                calc_playerlevel();

                war_message(HIY + "各路英雄请到城门协助加强城防！" + NOR);

                remove_call_out("proceed_war_defense");
                call_out("proceed_war_defense", TIME_GOTOGUARD, WAR_PROCESS, query_round());
            }
            break;

        default:
            break;;
    }

    return;
}

//flag==1，表示大帅回到内堂，不接受玩家询问
void set_block_general_room(int flag)
{     
    object npc, room1;
    object *inv;

    if ( 1 == flag )
    {
        room1 = find_object(MASTER_ROOM);
        if ( !room1 )
        {
            room1 = load_object(MASTER_ROOM);
        }

        inv = all_inventory(room1);
        foreach ( npc in inv )
        {
            if ( !userp(npc) && MASTER_ID == npc->query("id") )
            {
                tell_room(environment(npc), HIC"\n戚大帅低着头向内堂行去。\n\n"NOR);
                destruct(npc);
            }
            reset_eval_cost();
        }
    }
    else if ( 0 == flag )
    {
        room1 = find_object(MASTER_ROOM);
        if ( !room1 )
        {
            room1 = load_object(MASTER_ROOM);
        }

        inv = all_inventory(room1);
        foreach ( npc in inv )
        {
            if ( !userp(npc) && MASTER_ID == npc->query("id") )
            {
                npc->revive_me();
                return;
            }
            reset_eval_cost();
        }

        npc = new(MASTER_FILE);

        if ( npc )
        {
            npc->revive_me();
            npc->move(room1);
            tell_room(room1, HIC"\n戚大帅从内堂走了出来。\n\n"NOR);
        }
    }

    return;
}

void generate_wokou(string room, string name, int make_count, string *path)
{
    if ( !func_make_enemy[query_round()] )
    {
        return;
    }

    if ( !functionp(func_make_enemy[query_round()]) )
    {
        return;
    }

    evaluate(func_make_enemy[query_round()], room, name, make_count, path);
}

void lose_war()//这个函数只调用一次 game over
{
    remove_call_out("lose_war");

    war_message(HIW + "大帅身亡，日出城失陷了！！" + NOR, "溃败散兵(failure soldier)");
    war_message(HIM + "男人全杀了，花姑娘都带走！！" + NOR, "鬼童剑三(jap badguy)");
    war_message(HIM + "能搬的都搬走，不能搬的都烧了！！" + NOR, "修罗刀魔(jap badguy)");
    war_message(HIM + "哈哈哈!!!哈哈哈！！\n" + NOR, "倭寇(jap badguy)");

    war_finish();

    remove_call_out("auto_reset_war");
    call_out("auto_reset_war", UPDATE_TIME + random(3600));

    return;
}

void win_war(int win_state)//这个函数在每次阶段战斗胜利后调用
{
    switch ( win_state )
    {
        case 1:
            kill_all_enemy = 1;
            war_message(HIY + "日出城中的倭寇已全部被歼灭！！" + NOR);
            break;

        case 2:
            kill_all_enemy = 0;
            war_message(HIG + "日出城军民浴血奋战，终于使得倭寇无功而返！！" + NOR);
            break;

        default:
            kill_all_enemy = 0;
            break;
    }

    destroy_all();//每次阶段战斗结束

    sunrise_block = 0;//开门，没来得及加入的玩家可以加入下一轮战斗

    remove_call_out("proceed_war_defense");
    call_out("proceed_war_defense", 3, WAR_END, query_round());

    return;
}

//每30秒检查一次
#define CHECK_WAR_TICK  30
void check_war(int count)
{
    string *wokou;
    string enemy;
    int flag, number, i, j;

    remove_call_out("check_war");

    //如果大帅死了，则以失败告终
    if ( !query_master_state() )
    {
        lose_war();
        return;
    }

    //如果把敌人都杀光，当然胜利
    flag = 0;
    wokou = keys(wokou_type);
    number = sizeof(wokou);
    for ( i = 0; i < number; i++ )
    {
        enemy = wokou_type[wokou[i]]["file"];
        j = sizeof(children(enemy));
        if ( 0 < j )
        {
            j--;//有个基础object，需要扣除
        }
        if ( 0 < j )
        {
            war_message(HIR + "城内剩余" + wokou_type[wokou[i]]["name"] + j + HIR + "名！！" + NOR, "探子");
            flag = 1;
        }
    }
    if ( 0 == flag ) 
    {
        win_war(1);
        return;
    }

    //如果超过MAX_WAR_TIME，大帅未死，则胜利
    if ( count * CHECK_WAR_TICK >= MAX_WAR_TIME )
    {
        win_war(2);
        return;
    }

    war_message(HIY + "战斗进入白热化，诸位英雄请保重！！" + NOR);
    call_out("check_war", CHECK_WAR_TICK, ++count);

    return;
}

//这个函数产生倭寇 count 流程控制变量， make_count表示在城门制造倭寇的次数
void make_enemy(int count, int make_count)
{
    remove_call_out("make_enemy");

    switch ( count )
    {
        case 1:
            generate_wokou(EAST_GATE_OUTER, "旭日门", make_count, WAY_FROM_EAST);
            call_out("make_enemy", 3, ++count, make_count);
            break;

        case 2:
            generate_wokou(SOUTH_GATE_OUTER, "烈日门", make_count, WAY_FROM_SOUTH);
            call_out("make_enemy", 3, ++count, make_count);
            break;

        case 3:
            generate_wokou(WEST_GATE_OUTER, "落日门", make_count, WAY_FROM_WEST);
            call_out("make_enemy", 3, ++count, make_count);
            break;

        case 4:
            generate_wokou(NORTH_GATE_OUTER, "明月门", make_count, WAY_FROM_NORTH);
            call_out("make_enemy", 3, ++count, make_count);
            break;

        case 5:
            //这里需要启动一个进程check_war(0)，用于监视战争状态，判断输赢
            //这个进程在所有的倭寇产生完毕后启动
            if ( make_count == query_round() )
            {
                check_war(0);
            }
            else//还没制造完，继续
            {
                //第一次战斗产生一批，第二次两批，第三次三批
                call_out("make_enemy", TIME_ENEMY_COME_INTERNAL, 1, ++make_count);
            }

            break;

        default:
            break;
    }

    return;
}

void spread_soldier(int count)
{
    make_guard(EAST_GATE_OUTER, soldiers[random(sizeof(soldiers))], count);
    make_guard(SOUTH_GATE_OUTER, soldiers[random(sizeof(soldiers))], count);
    make_guard(WEST_GATE_OUTER, soldiers[random(sizeof(soldiers))], count);
    make_guard(NORTH_GATE_OUTER, soldiers[random(sizeof(soldiers))], count);

    war_message(HIW + "报告戚将军，日出城的兵力进一步加强了！！" + NOR, "巡视校尉(xiao wei)");

    return;
}

void calc_reward()
{
/*
    影响奖励的因素
    1、杀死敌人数量
    2、敌人等级
    3、回合
    4、守住城门数量
    5、全歼敌人还是守住时间
    6、撤退次数
*/

    int count = sizeof(actors);
    int count2;
    int i, j;
    string *wokou;
    int reward, single_reward;

    wokou = keys(wokou_type);
    count2 = sizeof(wokou);

    for ( i = 0; i < count; i++ )
    {
        if ( !actors[i] )
        {
            continue;
        }

        reward = 0;

        for ( j = 0; j < count2; j++ )
        {
            reward += (int)actors[i]->query_temp("sunrise/killed/" + wokou[j]) * (int)wokou_type[wokou[j]]["reward"];
        }

        //每回合增加20%的奖励
        reward = reward / 100 * (100 + (query_round() - 1) * 20);

        //每守住一个城门，增加5%的奖励
        reward = reward / 100 * (100 + (DOOR_ALL - door_broken) * 5);

        //全歼敌人，增加50%的奖励
        if ( kill_all_enemy )
        {
            reward = reward / 100 * (100 + 50);
        }

        //每撤退一次，减少1%的奖励
        if ( actors[i]->query_temp("sunrise/retreat") >= 100 )
        {
            //撤退100次就无奖励了，防止玩家利用无限撤退导致溢出bug
            single_reward = reward;
        }
        else
        {
            single_reward = reward / 100 * (int)actors[i]->query_temp("sunrise/retreat");
        }

        if ( single_reward < reward )
        {
            reward -= single_reward;
        }
        else
        {
            reward = 0;
        }

        //复仇回合，双倍奖励
        reward *= reward_level;

        actors[i]->set_temp("sunrise/reward", reward);

        reset_eval_cost();
    }

    return;
}

void war_start_1()
{
    set_start_time(time());

    //将军府大堂开放，玩家可以进入
    set_block_general_room(0);
    sunrise_block = 0;//开城门

    war_message(HIY + "据探子回报，倭寇大军即将来犯日出城！" + NOR);
    war_message(HIY + "天下英豪，当群起而逐之！" + NOR);
    if ( 1 != reward_level )
    {
        war_message(HIY + "本轮为双倍奖励！" + NOR);
    }

    remove_call_out("proceed_war_defense");
    //这段时间玩家可以修城门、报名参战
    call_out("proceed_war_defense", TIME_JOIN, WAR_PREPARE, query_round());
}

void war_prepare_1()
{
    initialize_defense(1);
}

void generate_wokou_1(string room, string name, int make_count, string *path)
{
    //第一轮倭寇数量比报名玩家数量多20%，以后每轮增加30%的数量
    //第一轮倭寇强度比报名玩家高30%，以后每轮增加10%的强度
    int count = sizeof(actors) * 120 / 100 ;

    //第一轮，先锋部队，70%的倭寇和忍者，30%的罗刹和修罗
    int count_1 = count * 70 / 100;
    int count_2 = count - count_1;
    int temp_count;

    string guai_1 = "wokou";
    string guai_2 = "renzhe";
    string guai_3 = "luosha";
    string guai_4 = "xiuluo";

    if ( count <= 0 )
    {
        count = WOKOU_NUMBER + query_round();
    }

    if ( count_1 <= 0 )
    {
        count_1 = WOKOU_NUMBER + query_round();
    }

    if ( count_2 <= 0 )
    {
        count_2 = WOKOU_NUMBER + query_round();
    }

    temp_count = 1 + random(count_1);
    make_wokou(room, guai_1, temp_count, path);
    make_wokou(room, guai_2, count_1 - temp_count, path);

    temp_count = 1 + random(count_2);
    make_wokou(room, guai_3, temp_count, path);
    make_wokou(room, guai_4, count_2 - temp_count, path);

    //倭寇怒了,必出高手
    if ( 1 < reward_level )
    {
        make_wokou(room, "leader", 1 + random(2), path);
        make_wokou(room, "luosha", random(2), path);
        make_wokou(room, "xiuluo", random(2), path);
        make_wokou(room, "jiang", random(2), path);
        make_wokou(room, "shen", random(2), path);
    }

    if ( 1 == make_count )
    {
        war_message(HIW + "倭寇开始攻打" + name + "！！" + NOR);
    }
    else
    {
        war_message(HIR + "倭寇持续增援" + name + "！！" + NOR);
    }
}

void war_process_1()
{
    war_message(HIR + "倭寇先锋部队已出现！！" + NOR);
    war_message(HIR + "各部各自迎战，务必将其全歼！！" + NOR);

    make_enemy(1, 1);//制造倭寇，进入具体的战争流程
}

void war_end_1()
{
    war_message(HIW + "这次全靠大家齐心协力才能挫败倭寇先锋！！" + NOR);

    if ( !door_broken )
    {
        war_message(HIW + "倭寇先锋没能踏入我日出城一步，大家打得好！！" + NOR);
        war_message(HIM + "八格！看我们的厉害吧！！增援部队，死拉死拉地！！" + NOR, "鬼影天翔(jap badguy)");
        enemy_angry++;
    }
    else
    {
        war_message(HIC + "但是有" + chinese_number(door_broken) + "处城门失陷！！" + NOR);
    }

    calc_reward();

    war_message(HIR + "战斗还没完全结束，请各位英雄来将军府记录军功，过时不候！！" + NOR);

    remove_call_out("proceed_war_defense");
    call_out("proceed_war_defense", WAR_PERIOD, WAR_NONE, query_round());
}

void war_none_1()
{
    remove_call_out("proceed_war_defense");
    call_out("proceed_war_defense", 3, WAR_START, query_round() + 1);
}

