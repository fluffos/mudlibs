void auto_reset_war();
void set_state(int state);
void clear_all_actor();
void destroy_all();
void set_block_general_room(int flag);
void set_end_time(int time);

void war_finish()
{
    //状态回到无战争
    set_state(WAR_NONE);

    //清除以前创建的obj
    destroy_all();

    if ( enemy_angry_all > 0 )
    {
        //复仇回合，双倍奖励
        reward_level = 2;
    }
    else
    {
        //清除所有参战玩家
        clear_all_actor();

        set_block_general_room(1);//大帅回家，不玩了

        reward_level = 1;
    }

    enemy_angry = 0;
    enemy_angry_all = 0;
    master_state = 1;
    door_broken = 0;
    sunrise_block = 1;

    set_end_time(time());
}

void create()
{
    seteuid(getuid());

    war_finish();

    remove_call_out("auto_reset_war");
    //call_out("auto_reset_war", 300 + random(300));

    return;
}

