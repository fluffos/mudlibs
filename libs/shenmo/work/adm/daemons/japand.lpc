#include <ansi.h>

//倭寇攻城战
//1、城门失陷数量，影响奖励
//2、大帅挂掉，战斗失败
//3、全歼倭寇或者守住一定时间，战斗胜利，奖励不同
//4、倭寇采用多回合进攻，如果一直攻不破城门，倭寇难度会提升，并且最终可能怒值爆发，引来超级boss血洗
//5、破城后，倭寇会进城烧杀掳虐，玩家要追进去找了
//6、根据倭寇难度，会增加守将npc，同时超级boss驾临中原，考虑中原武林不出世高手出山助拳
//7、玩家不会真死，回到大帅处
//8、部分倭寇进城后，会直奔大本营，如果戚继光挂掉了，则守城失败，全部零奖励

//战争状态，对应变量war_state
#define WAR_NONE        0
#define WAR_START       1
#define WAR_PREPARE     2
#define WAR_PROCESS     3
#define WAR_END         4

#define UPDATE_TIME     10800   //3小时更新一次
//报名的时间
#define TIME_JOIN       60
//玩家走去城门布防的时间
#define TIME_GOTOGUARD  30
//城门制造倭寇时，每批之间的时间间隔
#define TIME_ENEMY_COME_INTERNAL 10
//随机制造的士兵个数
#define RANDOM_SOLDIER_COUNT 5
//每回合的最大时间 15 min
#define MAX_WAR_TIME 90
//两回合之间的间隔时间
#define WAR_PERIOD  60
//城门数量
#define DOOR_ALL    8

#define DEFAULT_EXP     2500000  //没有玩家报名时，默认的平均exp

#define WAR_PLACE       "/d/sunrise"
#define MASTER_FILE     "/d/sunrise/npc/qijiguang"
#define MASTER_ROOM     "/d/sunrise/jiangjuntang"
