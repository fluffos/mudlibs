void generate_wokou_3(string room, string name, int make_count, string *path)
{
    //第一轮倭寇数量比报名玩家数量多20%，以后每轮增加30%的数量
    //第一轮倭寇强度比报名玩家高30%，以后每轮增加10%的强度
    int count = sizeof(actors) * 120 / 100 ;

    //第三轮，主力部队，第一批，70%的倭寇和忍者，30%的罗刹和修罗
    int count_1 = count * 70 / 100;
    int count_2 = count - count_1;
    int temp_count;

    string guai_1 = "wokou";
    string guai_2 = "renzhe";
    string guai_3 = "luosha";
    string guai_4 = "xiuluo";

    if ( make_count == query_round() - 1 )
    {
        //第二批，50%的罗刹和修罗，50%的月读和风神
        count *= 30 / 100;
        count_1 = count / 2;
        count_2 = count - count_1;

        guai_1 = "luosha";
        guai_2 = "xiuluo";
        guai_3 = "jiang";
        guai_4 = "shen";
    }
    else if ( make_count == query_round() )
    {
        //第三批，100%的月读和风神，必出首领
        count *= 30 / 100;
        count_2 = 1;
        count_1 = count - count_2;

        guai_1 = "jiang";
        guai_2 = "shen";
        guai_3 = "leader";
        guai_4 = "leader";
    }

    if ( count <= 0 )
    {
        count = WOKOU_NUMBER + query_round();
    }

    if ( count_1 <= 0 )
    {
        count_1 = WOKOU_NUMBER + query_round();
    }

    if ( count_2 <= 0 )
    {
        count_2 = WOKOU_NUMBER + query_round();
    }

    temp_count = 1 + random(count_1);
    make_wokou(room, guai_1, temp_count, path);
    make_wokou(room, guai_2, count_1 - temp_count, path);

    temp_count = 1 + random(count_2);
    make_wokou(room, guai_3, temp_count, path);
    make_wokou(room, guai_4, count_2 - temp_count, path);

    //倭寇怒了,必出高手
    if ( 1 < reward_level )
    {
        make_wokou(room, "leader", 1 + random(3), path);
        make_wokou(room, "luosha", 2 + random(2), path);
        make_wokou(room, "xiuluo", 2 + random(2), path);
        make_wokou(room, "jiang", 1 + random(2), path);
        make_wokou(room, "shen", 1 + random(2), path);
    }

    if ( 1 == make_count )
    {
        war_message(HIW + "倭寇开始攻打" + name + "！！" + NOR);
    }
    else
    {
        war_message(HIR + "倭寇持续增援" + name + "！！" + NOR);
    }
}

void war_process_3()
{
    war_message(HIR + "倭寇主力部队出现！！" + NOR);
    war_message(HIR + "各部各自迎战，务必将其全歼！！" + NOR);

    //第三级难度加一些master
    spread_soldier(1 + random(RANDOM_SOLDIER_COUNT) + random(RANDOM_SOLDIER_COUNT));
    //spread_othernpc(RANDOM_OTHER_COUNT);  //强势中原人士助战

    make_enemy(1, 1);//制造倭寇，进入具体的战争流程
}

void war_end_3()
{
    war_message(HIR + "这次全靠大家齐心协力才能全歼倭寇主力！！" + NOR);

    calc_reward();

    if ( !door_broken )
    {
        war_message(HIW + "倭寇主力没能踏入我日出城一步，大家打得好！！" + NOR);
        war_message(HIR + "战斗已结束，请各位英雄来将军府领赏！！" + NOR);

        // 倭寇怒了,5分钟后重新灭寇
        if ( random(enemy_angry) >= 2 )
        {
            enemy_angry_all++;
        }
        else
        {
            enemy_angry_all = 0;
        }
    }
    else
    {
        enemy_angry_all = 0;

        war_message(HIC + "但是有" + chinese_number(door_broken) + "处城门失陷！！" + NOR);
        war_message(HIR + "战斗已结束，请各位英雄来将军府领赏！！" + NOR);
    }

    // 倭寇怒了,5分钟后重新灭寇
    if ( 0 < enemy_angry_all )
    {
        war_message(HIM + "八格！八格呀噜！召集神风敢死队，给我冲！" + NOR, "百鬼夜狂(jap badguy)");
        war_message(HIY + "战斗虽然结束，但是倭寇随时都会卷土重来，一定要小心提防！！" + NOR);
    }

    remove_call_out("proceed_war_defense");
    call_out("proceed_war_defense", WAR_PERIOD, WAR_NONE, query_round());
}

void war_none_3()
{
    war_finish();

    if ( 1 < reward_level )
    {
        // 倭寇怒了,5分钟后重新灭寇
        war_message(HIW + "倭寇神风敢死队秘密集结！！" + NOR, "探子");

        remove_call_out("auto_reset_war");
        call_out("auto_reset_war", 300 + random(120));
    }
    else
    {
        war_message(HIW + "这次粉碎了倭寇的阴谋，多谢众位英雄鼎力相助！！" + NOR);

        remove_call_out("auto_reset_war");
        call_out("auto_reset_war", UPDATE_TIME + random(3600));
    }
}

//刷新日出城所有房间
void refresh_sunrise()
{
    mixed *file;
    int i;
    object room;

    file = get_dir( WAR_PLACE + "/""*.lpc", -1 );
    i = sizeof(file);

    while ( i-- )
    {
        if ( file[i][1] <= 0 )
        {
            continue;
        }

        room = load_object(WAR_PLACE + "/" + file[i][0]);
        if ( !room )
        {
            continue;
        }

        destruct(room);
    }
}

