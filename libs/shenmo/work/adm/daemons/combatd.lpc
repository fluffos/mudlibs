#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include "/cmds/std/valid_kill.h"
inherit F_DBASE;
#include <damage_msg.h>

int victim_lose(object killer, object victim, string killerid);
void victim_penalty(object victim);
int nk_gain(object killer, object victim);
string chinese_daoxing(int gain);

string check_class(object who);
int check_family(string fam);
int restrain(object me, object victim);


void create() {
  seteuid(getuid());
  set("name", "战斗精灵");
  set("id", "combatd");
}

varargs int skill_power(object ob, string skill, int usage) {
  float fwx, flvl;
  int wx, lvl, status, level, power;
  if (!ob || !living(ob))
    return 0;
  level = ob->query_skill(skill);
  level /= 60;
  if (environment(ob) && environment(ob)->query("combat_room")) tell_room(
    environment(ob),
    sprintf("\t%O ：1 level == %d\n", ob, level)
  );
  if (environment(ob) && environment(ob)->query("combat_room")) tell_room(
    environment(ob),
    sprintf("\t%O ：2 level == %d\n", ob, level)
  );
  power = level * level * level;
  if (environment(ob) && environment(ob)->query("combat_room")) tell_room(
    environment(ob),
    sprintf("\t%O ：3 level == %d\n", ob, power)
  );
  if (power < 1) power = 1;
  power += random(ob->query("force_factor") / 100);
  power += random(ob->query("mana_factor") / 100);
  if (environment(ob) && environment(ob)->query("combat_room")) tell_room(
    environment(ob),
    sprintf("\t%O ：4 level == %d\n", ob, power)
  );
  if ((level = ob->query("level")) <= 0) {
    wx = ob->query("combat_exp");
    fwx = to_float(wx);
    if (wx > 10000000)
      flvl = sqrt(fwx / 400) - 1;
    else if (wx > 1000)
      flvl = sqrt(fwx / 1000) - 1;
    else flvl = random(2);
    lvl = to_int(flvl);
    level = lvl;
  }
  if (!userp(ob)) level += random(level / 10);
  if (level > 255) level = 255;
  power += level * 5;
  if (environment(ob) && environment(ob)->query("combat_room")) tell_room(
    environment(ob),
    sprintf("\t%O ：5 level == %d\n", ob, power)
  );
  switch (usage) {
    case SKILL_USAGE_ATTACK:
      power += ob->query_temp("apply/attack") / 10;
      break;
    case SKILL_USAGE_DEFENSE:
      power += ob->query_temp("apply/defense") / 10;
      break;
  }
  if (environment(ob) && environment(ob)->query("combat_room")) tell_room(
    environment(ob),
    sprintf("\t%O ：6 level == %d\n", ob, power)
  );
  return power;
}

varargs void report_status(object ob, int effective) {
  string msg = NOR "( $N" NOR;
  if (effective)
    msg += eff_status_msg(ob->query("eff_kee") * 100 / (1 + ob->query("max_kee")));
  else msg += status_msg(ob->query("kee") * 100 / (1 + ob->query("max_kee")));
  msg += NOR " )\n";
  message_vision(msg, ob);
}

varargs void report_sen_status(object ob, int effective) {
  string msg = NOR "( $N" NOR;
  msg += sen_status_msg(ob->query("sen") * 100 / (1 + ob->query("max_sen")));
  msg += NOR " )\n";
  message_vision(msg, ob);
}
varargs int do_attack(object me, object victim, object weapon, int attack_type) {
  mapping my, your, action, victim_action, v_armor;
  mapping mm;
  object v_ar;
  string *ars, arr;
  string limb, *limbs, result, fail_hit_msg, hit_ob_msg;
  string my_class, your_class, my_family, your_family;
  string attack_skill, force_skill, martial_skill, dodge_skill, parry_skill;
  mixed foo;
  int ap, dp, pp, afp, vfp;
  int damage, damage_bonus, defense_factor, force_adj;
  int wounded = 0;
  int mod_val;
  int r;

  my = me->query_entire_dbase();
  your = victim->query_entire_dbase();

  action = me->query("actions");
  if (!mapp(action)) {
    me->reset_action();
    action = me->query("actions");
    if (!mapp(action)) {
      CHANNEL_D->do_channel(
        this_object(),
        "sys",
        sprintf("%s(%s): bad action = %O", me->name(1), me->query("id"), me->query("actions", 1))
      );
      return 0;
    }
  }

  if (action["name"])
    me->set_temp("action_name", action["name"]);
  result = "\n" NOR + action["action"] + "！\n" NOR;
  if (stringp(victim->query_temp("super_shiled_msg"))) {
    result += victim->query_temp("super_shiled_msg");
    victim->delete_temp("super_shiled_msg");
  }

  if (objectp(weapon)) {
    if (weapon->query("use_apply_skill"))
      attack_skill = weapon->query("apply/skill_type");
    else attack_skill = weapon->query("skill_type");
  } else attack_skill = "unarmed";

  if (arrayp(victim->query_temp("apply/limbs"))
    && strlen(victim->query_temp("apply/limbs")[0]) > 1)
    limbs = victim->query_temp("apply/limbs");
  else limbs = victim->query("limbs");
  limb = limbs[random(sizeof(limbs))];

  if ((victim->query_temp("jldl") || victim->query_temp("nlch"))
    && living(victim)) {
    afp = skill_power(me, "force", SKILL_USAGE_ATTACK);
    if (afp < 1) afp = 1;
    vfp = skill_power(victim, "force", SKILL_USAGE_DEFENSE);
    if (victim->is_busy()) vfp /= 3;
    if (vfp < 1) vfp = 1;
    mod_val = 0;
    mod_val -= random(6) * 5 + 5;
    if (!victim->query_temp("weapon"))
      mod_val += 10;
    if (vfp > 1000000)
      mod_val = vfp / 100 * (100 + mod_val);
    else mod_val = (100 + mod_val) * vfp / 100;
    if (mod_val < 1) mod_val = 1;
    force_adj = random(afp + vfp);
  } else {
    force_adj = 1;
    mod_val = 1;
  }

  if (force_adj < mod_val) {
    if (victim->query_temp("jldl"))
      foo = "/daemon/class/puti/wuxiangforce/jldl"->jldl_result(
        victim,
        me,
        mod_val,
        force_adj,
        action
      );
    if (victim->query_temp("nlch"))
      foo = "/daemon/class/wudang/taiji-shengong/nlch"->nlch_result(
        victim,
        me,
        mod_val,
        force_adj,
        action
      );
    result += foo;
    damage = RESULT_FORCE;
  }

  else {
    ap = skill_power(me, attack_skill, SKILL_USAGE_ATTACK);
    if (ap < 1) ap = 1;
    dp = skill_power(victim, "dodge", SKILL_USAGE_DEFENSE);
    if (living(victim))
      dodge_skill = victim->query_skill_mapped("dodge");
    else dodge_skill = 0;
    mod_val = 0;
    if (dodge_skill) {
      victim_action = SKILL_D(dodge_skill)->query_action();
      if (victim_action && victim_action["dodge_power"])
        mod_val = victim_action["dodge_power"];
    }
    if (victim->is_busy())
      dp /= 3;
    if (dp < 0) dp = 0;
    if (action["dodge"])
      mod_val += action["dodge"];
    if (dp > 1000000)
      mod_val = dp / 100 * (100 + mod_val);
    else mod_val = (100 + mod_val) * dp / 100;
    if (mod_val < 0)
      mod_val = 0;

    if (mapp(victim->query_temp("apply/perf_dodge"))
      && victim->is_fighting(me)) {
      mm = victim->query_temp("apply/perf_dodge");
      if (time() < mm["start"] + mm["time"]) {
        if (stringp(mm["msg"]))
          result += mm["msg"] + NOR;
        else result += CYN "$n" CYN "身轻如燕，一下子闪开了$N" CYN "的攻击。\n" NOR;
        damage = 0;
      }
    } else if (random(ap + dp) < mod_val) {
      if (!dodge_skill) {
        dodge_skill = "dodge";
        result += SKILL_D(dodge_skill)->query_dodge_msg(limb);
      } else {
        if (victim_action && victim_action["dodge_action"])
          result += victim_action["dodge_action"];
        else result += SKILL_D(dodge_skill)->query_dodge_msg(limb);
      }
      if (dp < ap && (!userp(victim) || !userp(me))
        && random(sizeof(victim->query_enemy())) < 4
        && 0 < your["max_sen"] && random(your["sen"] * 100 / your["max_sen"] + your["int"] * your["cps"]) > 150) {
        your["combat_exp"] += 1;
        victim->improve_skill("dodge", 1);
      }
      if ((ap < dp) && !userp(me))           // This is for NPC only. NPC have chance to get exp when fail to hit.
      {
        if (random(my["int"]) > 15)
          my["combat_exp"] += 1;
        me->improve_skill(attack_skill, random(my["int"]));
      }
      damage = RESULT_DODGE;
    } else {
      if (victim->query_temp("weapon")) {
        pp = skill_power(victim, "parry", SKILL_USAGE_DEFENSE);
        if (!weapon) pp *= 2;
        parry_skill = victim->query_skill_mapped("parry");
      } else {
        if (weapon) pp = 0;
        else pp = skill_power(victim, "unarmed", SKILL_USAGE_DEFENSE);
        parry_skill = victim->query_skill_mapped("unarmed");
      }
      if (victim->is_busy()) pp /= 3;
      if (!living(victim)) pp /= 3;
      if (pp < 0) pp = 0;
      mod_val = 0;
      if (action["parry"])
        mod_val = action["parry"];
      if (pp > 1000000)
        mod_val = pp / 100 * (100 + mod_val);
      else mod_val = (100 + mod_val) * pp / 100;
      if (mod_val < 0) mod_val = 0;
      if (random(ap + pp) < mod_val) {
        parry_skill = victim->query_skill_mapped("parry");
        if (!parry_skill) parry_skill = "parry";
        dodge_skill = SKILL_D(parry_skill)->query_parry_msg(weapon);
        if (dodge_skill)
          result += dodge_skill;
        else result += SKILL_D("parry")->query_parry_msg(weapon);

        if (pp < ap && (!userp(victim) || !userp(me))
          && random(sizeof(victim->query_enemy())) < 4
          && 0 < your["max_sen"] && random(your["sen"] * 100 / your["max_sen"] + your["int"] * your["cps"]) > 150) {
          your["combat_exp"] += 1;
          victim->improve_skill("parry", 1);
        }
        damage = RESULT_PARRY;
      }

      else {
        damage = me->query_temp("apply/damage");
        damage = (damage + random(damage)) / 2;
        if (action["damage"])
          damage += action["damage"] * damage / 100;
        damage_bonus = me->query_str();
        if (my["force_factor"] && (my["force"] / 4 > my["force_factor"])) {
          if (force_skill = me->query_skill_mapped("force")) {
            foo = SKILL_D(force_skill)->hit_ob(me, victim, damage_bonus, my["force_factor"]);
            if (stringp(foo)) result += foo;
            else if (intp(foo)) damage_bonus += foo;
          }
        }
        if (action["force"])
          damage_bonus += action["force"] * damage_bonus / 100;
        if (martial_skill = me->query_skill_mapped(attack_skill)) {
          foo = SKILL_D(martial_skill)->hit_ob(me, victim, damage_bonus);
          if (stringp(foo)) result += foo;
          else if (intp(foo)) damage_bonus += foo;
        }
        if (weapon)                    // Let weapon or monster have their special damage.
        {
          foo = weapon->hit_ob(me, victim, damage_bonus);
          if (stringp(foo)) result += foo;
          else if (intp(foo)) damage_bonus += foo;
        } else {
          foo = me->hit_ob(me, victim, damage_bonus);
          if (stringp(foo)) result += foo;
          else if (intp(foo)) damage_bonus += foo * 3 / 4;
        }
        if (damage_bonus > 0)
          damage += (damage_bonus + random(damage_bonus)) / 2;
        if (damage < 0) damage = 0;

        dp = your["combat_exp"];
        ap = my["combat_exp"];
        if (ap > 1000000000) {
          ap /= 1000000;
          dp /= 1000000;
          if (dp < 1)
            dp = 1;
        } else if (ap > 10000000) {
          ap /= 10000;
          dp /= 10000;
          if (dp < 1)
            dp = 1;
        } else if (ap > 100000) {
          ap /= 100;
          dp /= 100;
          if (dp < 1)
            dp = 1;
        }
        while (random(dp) > ap && damage > 5) {
          damage -= damage / 5;
          dp /= 2;
        }
        ap = dp = 0;
        dodge_skill = victim->query_skill_mapped("dodge");
        if (dodge_skill) {
          foo = SKILL_D(dodge_skill)->ob_hit(me, victim, damage);
          if (stringp(foo)) result += foo;
          else if (intp(foo) && foo != 0) {
            damage += foo;
            if (victim->query_temp("dodge_skill_msg")
              && stringp(victim->query_temp("dodge_skill_msg"))) {
              result += victim->query_temp("dodge_skill_msg");
              victim->delete_temp("dodge_skill_msg");
            }
          }
        }

        my_class = check_class(me);
        your_class = check_class(victim);
        while (class_restrain[your_class] == my_class && random(3) == 1)
          damage -= damage / 3;
        while (random(me->query_skill("jiayi-force") / 100 + 1) > 3 && me->query("jiayi_second") > 0)
          damage += damage / 3;
        v_ar = present("jia sha", victim);
        if (objectp(v_ar) && v_ar->query("equipped")) {
          foo = v_ar->ob_hit_msg(victim, me, damage);
          if (stringp(foo))
            result += foo;
          foo = v_ar->ob_hit_int(victim, me, damage);
          if (intp(foo))
            damage += foo;
        }
        if (damage < 0) damage = 0;  //add by fang
        damage = victim->receive_damage("kee", damage, me);
        if ((me->is_killing(victim) || weapon)
          && random(damage) > (int)victim->query_temp("apply/armor")) {
          victim->receive_wound("kee", damage - (int)victim->query_temp("apply/armor"), me);
          wounded = 1;
        }

        if (me->query_temp("ldlh"))
          result = "\n" + action["action"] + "！\n";
        result += damage_msg(damage, action["damage_type"]);

        if (!userp(me) || !userp(victim)) {
          if ((ap < dp)
            && (random(my["sen"] * 100 / my["max_sen"] + my["int"] * my["cps"]) > 150)) {
            my["combat_exp"] += 1;
            if (my["potential"] - my["learned_points"] < 100)
              my["potential"] += 1;
            me->improve_skill(attack_skill, 1);
          }
          if (random(your["max_kee"] + your["kee"]) < damage) {
            your["combat_exp"] += 1;
            if (your["potential"] - your["learned_points"] < 100)
              your["potential"] += 1;
          }
        }
      }
    }
  }

  foo = victim->ob_hit(me, victim, damage);
  if (stringp(foo))
    result += foo;
  else if (intp(foo))
    damage -= foo;
  if (damage < 0) damage = 0;

  if (damage > 0) {
    v_ar = victim->query_temp("armor/shield");
    if (v_ar && objectp(v_ar) && living(victim)) {
      foo = v_ar->ob_hit(me, victim, damage);
      if (stringp(foo))
        result += foo;
      else if (intp(foo))
        damage -= foo;
      if (damage < 0) damage = 0;
    }
  }

  result = replace_string(result, "$l", limb);
  if (stringp(action["weapon"]))
    result = replace_string(result, "$w", action["weapon"]);
  else if (objectp(weapon))
    result = replace_string(result, "$w", weapon->name());
  if (objectp(victim->query_temp("weapon")))
    result = replace_string(result, "$W", victim->query_temp("weapon")->name());

  if ((damage != RESULT_DODGE) && (damage != RESULT_PARRY)) {
    if (!me->query("env/no_msg") && !victim->query("env/no_msg"))
      message_vision(result, me, victim);
    if (damage == RESULT_FORCE && me->query("eff_kee") <= 0)
      message(
        "channel:rumor",
        HIM "【顺风耳】某人：" + me->name() + "中了" + victim->name() + "的拨转招式之法，自己把自己打死了。\n" NOR,
        users()
      );
  }

  else {
    if (((string)me->query("env/brief_message") != "YES"
      && (string)victim->query("env/brief_message") != "YES") || me->query_temp("ldlh")) {
      if (!me->query("env/no_msg") && !victim->query("env/no_msg"))
        message_vision(result, me, victim);
    }
    if (martial_skill = me->query_skill_mapped(attack_skill)) {
      fail_hit_msg = SKILL_D(martial_skill)->fail_hit(me, victim);
      if (stringp(fail_hit_msg)) {
        if (!me->query("env/no_msg") && !victim->query("env/no_msg"))
          message_vision(fail_hit_msg, me, victim);
      }
    }
  }

  if (wizardp(me) && me->query("env/combat")) {
    tell_object(me, sprintf(GRN "AP：%d，DP：%d，PP：%d，Mod：%d，伤害力：%d\n" NOR,
      ap / 100, dp / 100, pp / 100, mod_val / 100, damage));
  }
  if (wizardp(victim) && victim->query("env/combat")) {
    tell_object(victim, sprintf(GRN "AP：%d，DP：%d，PP：%d，Mod：%d，伤害力：%d\n" NOR,
      ap / 100, dp / 100, pp / 100, mod_val / 100, damage));
  }

  if (damage > 0) {
    if (me->query("env/no_status") == 0 || userp(victim))
      report_status(victim, wounded);
    if (martial_skill = me->query_skill_mapped(attack_skill)) {
      hit_ob_msg = SKILL_D(martial_skill)->hit_ob_msg(me, victim);
      if (stringp(hit_ob_msg)) {
        if (!me->query("env/no_msg") && !victim->query("env/no_msg"))
          message_vision(hit_ob_msg, me, victim);
      }
    }

    if (me->query_temp("zxzx") == 1)
      "/daemon/class/yaomo/wudidong/qixiu-jian/zxzx"->zxzx_effect(me, victim, damage);

    if (victim->is_busy()) victim->interrupt_me(me);

    if ((!me->is_killing(your["id"])) && (!victim->is_killing(my["id"]))) {                       // fight until one side's kee is < 50%
      if (victim->query("kee") < victim->query("max_kee") * 50 / 100) {
        me->remove_enemy(victim);
        victim->remove_enemy(me);
        message_vision(winner_msg[random(sizeof(winner_msg))], me, victim);
      }
    }
  }

  if (functionp(action["post_action"]))
    evaluate(action["post_action"], me, victim, weapon, damage);

  if (damage > 0 && attack_type != TYPE_QUICK
    && me->query_temp("perf_quick") && me->is_fighting(victim)) {
    if (me->query_temp("weapon")
      && me->query_temp("perf_quick/" + me->query_temp("weapon")->query("skill_type"))) {
      if (me->query_temp("perf_quick/msg"))
        message_vision(CYN + me->query_temp("perf_quick/msg") + NOR, me, victim);
      else message_vision(CYN "$N" CYN "得势不饶人，对$n" CYN "展开连续攻击。" + NOR, me, victim);
      do_attack(me, victim, me->query_temp("weapon"), TYPE_QUICK);
      attack_type = 99;
      return 1;
    }
  }
  if (mapp(me->query_temp("apply/perf_action"))
    && me->is_fighting(victim) && attack_type != 9 && random(me->query("kar")) > 20) {
    mm = me->query_temp("apply/perf_action");
    if (time() < mm["start"] + mm["time"]) {
      if (stringp(mm["msg"]))
        message_vision(mm["msg"] + NOR, me, victim);
      else message_vision(CYN "$N" CYN "得势不饶人，对$n" CYN "展开连续攻击。" + NOR, me, victim);
      do_attack(me, victim, me->query_temp("weapon"), 9);
      attack_type = 9;
      return 1;
    }
  }


  // See if the victim can make a riposte.
  if (attack_type == TYPE_REGULAR && damage < 1
    && victim->query_temp("guarding")) {
    victim->set_temp("guarding", 0);
    if (random(my["cps"]) < 5) {
      message_vision("$N一击不中，露出了破绽！\n", me);
      do_attack(victim, me, victim->query_temp("weapon"), TYPE_QUICK);
    } else {
      message_vision("$N见$n攻击失误，趁机发动攻击！\n", victim, me);
      do_attack(victim, me, victim->query_temp("weapon"), TYPE_RIPOSTE);
    }
  }
  return damage;
}

void fight(object me, object victim) {
  object ob, *teams, hufa;
  int i;
  string msg;

  if (!living(me)) return;
  if (me->query_temp("netdead"))
    return;
  if (victim->query_temp("netdead")) {
    if (member_array(me, victim->query_netdead_enemy()) == -1)
      return;     // can't start fight if the victim is already netdead
  }

  if (!me->visible(victim)
    && (random(100 + (int)me->query_skill("perception")) < 100))
    return;

  teams = victim->query_team();
  i = sizeof(teams);
  while (i--) {
    if (!teams[i] || !objectp(teams[i])
      || !living(teams[i]) || !present(teams[i], environment(victim))
      || userp(teams[i]))
      continue;
    hufa = teams[i];
    if (functionp(hufa->be_hufa(me, victim))) {
      hufa->be_hufa(me, victim);
      break;
    } else {
      if (stringp(msg = hufa->query("hufa_msg")))
        message_vision(msg, me, victim);
      else message_vision("$N开始保护$n。\n", hufa, victim);
      if (!hufa->is_fighting(me))
        hufa->fight_ob(me);
      do_attack(hufa, me, hufa->query_temp("weapon"), TYPE_REGULAR);
    }
  }

  if (victim->is_busy() || (victim->query_temp("no_move")) || !living(victim)) {
    me->set_temp("guarding", 0);
    if (!victim->is_fighting(me))
      victim->fight_ob(me);
    do_attack(me, victim, me->query_temp("weapon"), TYPE_QUICK);
  } else if (random((int)victim->query("cps") * 3) < ((int)me->query("cor") + (int)me->query("bellicosity") / 50)) {
    me->set_temp("guarding", 0);
    if (!victim->is_fighting(me))
      victim->fight_ob(me);
    do_attack(me, victim, me->query_temp("weapon"), TYPE_REGULAR);
  } else if (!me->query_temp("guarding")) {
    me->set_temp("guarding", 1);
    message_vision(guard_msg[random(sizeof(guard_msg))], me, victim);
    return;
  } else return;
}

void auto_fight(object me, object obj, string type) {
  if (!userp(me) && !userp(obj)) return;         // Don't let NPC autofight NPC.

  if (me->query_temp("looking_for_trouble")) return;
  me->set_temp("looking_for_trouble", 1);
  call_out("start_" + type, 0, me, obj);                 // This call_out gives victim a chance to slip trough the fierce guys.
}

void start_berserk(object me, object obj) {
  int bellicosity;
  if (!me) return;       // Are we still exist( not becoming a corpse )?
  me->set_temp("looking_for_trouble", 0);
  if (!obj) return;
  if (wizardp(me)) return;
  if (wizardp(obj)) return;
  if (me->is_fighting(obj)                                // Are we busy fighting?
  || !living(me)                                         // Are we capable for a fight?
  || environment(me) != environment(obj)                   // Are we still in the same room?
  || environment(me)->query("no_fight")                  // Are we in a peace room?
  || environment(me)->query("no_magic"))                // Are we in a peace room?
    return;

  bellicosity = (int)me->query("bellicosity");
  message_vision("$N用一种异样的眼神扫视着在场的每一个人。\n", me);

  if (me->query("class") == "xian")
    bellicosity += random(bellicosity / 3);
  if (me->query("class") == "human")
    bellicosity += random(bellicosity / 4);
  if (me->query("class") == "yao")
    bellicosity += random(bellicosity / 2);

  if ((int)me->query("force") > (random(bellicosity) + bellicosity) / 2)
    return;

  if (bellicosity > (int)me->query("score") && !wizardp(obj)) {               // auto kill, mark my_killer_list. -- mon 9/23/98
    if (userp(me) && userp(obj) && ((int)me->query("zhuanshi") == (int)obj->query("zhuanshi") || obj->query("KILLER") != me->query("id")))
      set_my_killer_list(me, obj);
    message_vision("$N对着$n喝道：" + RANK_D->query_self_rude(me) + "看你实在很不顺眼，去死吧。\n", me, obj);
    me->kill_ob(obj);
  } else {
    message_vision(
      "$N对着$n喝道：喂！" + RANK_D->query_rude(obj) + "，" + RANK_D->query_self_rude(me) + "正想找人打架，陪我玩两手吧！\n",
      me,
      obj
    );
    me->fight_ob(obj);
  }
}


void start_hatred(object me, object obj) {
  if (!me || !obj) return;                               // Are we still exist( not becoming a corpse )?

  me->set_temp("looking_for_trouble", 0);

  if (me->is_fighting(obj)                               // Are we busy fighting?
  || !living(me)                                        // Are we capable for a fight?
  || environment(me) != environment(obj)                  // Are we still in the same room?
  || environment(me)->query("no_fight"))               // Are we in a peace room?
    return;

  // We found our hatred! Charge!
  message_vision(catch_hunt_msg[random(sizeof(catch_hunt_msg))], me, obj);
  me->kill_ob(obj);
}

void start_vendetta(object me, object obj) {
  if (!me || !obj) return;                               // Are we still exist( not becoming a corpse )?

  me->set_temp("looking_for_trouble", 0);

  if (me->is_fighting(obj)                               // Are we busy fighting?
  || !living(me)                                        // Are we capable for a fight?
  || environment(me) != environment(obj)                  // Are we still in the same room?
  || environment(me)->query("no_fight"))               // Are we in a peace room?
    return;

  // We found our vendetta opponent! Charge!
  me->kill_ob(obj);
}

void start_aggressive(object me, object obj) {
  if (!me || !obj) return;                               // Are we still exist( not becoming a corpse )?

  me->set_temp("looking_for_trouble", 0);

  if (me->is_fighting(obj)                               // Are we busy fighting?
  || !living(me)                                        // Are we capable for a fight?
  || environment(me) != environment(obj)                  // Are we still in the same room?
  || environment(me)->query("no_fight"))               // Are we in a peace room?
    return;

  // We got a nice victim! Kill him/her/it!!!
  me->kill_ob(obj);
}

void announce(object ob, string event, string msg) {
  switch (event) {
    case "dead":
      message_vision("\n$N死了。\n\n", ob);
      break;
    case "unconcious":
      message_vision("\n$N脚下一个不稳，跌在地上一动也不动了。\n\n", ob);
      break;
    case "revive":
      message_vision("\n$N慢慢睁开眼睛，清醒了过来。\n\n", ob);
      break;
    case "death_rumor":
      CHANNEL_D->do_channel(this_object(), "rumor", msg);
      break;
  }
}

void winner_reward(object killer, object victim) {
  killer->defeated_enemy(victim);
}

