        case "perform_tougu":
          rkmsg = "神爪透骨"; break;
        case "perform_tulong":
          rkmsg = "天雷屠龙"; break;
        case "perform_huanying":
          rkmsg = "无形幻影"; break;
        case "perform_hou":
          rkmsg = "天吼八式"; break;
