string abbrdir(string dir) {
  if (!undefinedp(abbr_dir[dir]))
    return abbr_dir[dir];
  else
    return dir;
}

string cdir(string dir) {
  dir = abbrdir(dir);
  if (!undefinedp(chinese_dir[dir]))
    return chinese_dir[dir];
  else return dir;
}

string oppdir(string dir) {
  if (!undefinedp(opp_dir[dir]))
    return opp_dir[dir];
  else
    return 0;
}
