//npc === this_object()
//who === this_player()
//lvl === skills_lvl
//fam === family_name

varargs int random_family(object npc,object who,int lvl,string fam)
{
int i,k;
string *fams,*skills,cls;
mapping data;
object weapon;

if ( !who || !npc )
        return 0;
if ( !lvl )
        lvl = 150+random(100);
if ( lvl>1000 )
        lvl = 1000;
if ( lvl<150 ) lvl = 150;

fams = keys(familys);
if ( !fam || member_array(fam,fams)==-1 )
        fam = fams[random(sizeof(fams))];       //取得门派
data = familys[fam];
cls = data["class"];
weapon = new(data["weapon"]);
if ( !weapon )
        {
        message("channel:sys",sprintf(YEL"┣"WHT" 系统"YEL" ┫"WHT"圣斗士地层(Sdsd.c)：%s 文件调用随机门派时，%s门派武器文件不存在或出错。\n"NOR,
                                        base_name(npc),fam),
                users());
        return 0;
        }
skills = data["skills"];
for(i=0;i<sizeof(skills)/2;i++)
        {
        k = i*2;
        npc->set_skill(skills[k],lvl);
        npc->set_skill(skills[k+1],lvl);
        npc->map_skill(skills[k],skills[k+1]);
        }
npc->set("max_force",npc->query_skill("force")*10);
npc->set("max_mana",npc->query_skill("spells")*10);
if ( fam!="月宫" )
        npc->set("force_factor",npc->query_skill("force")/3);
npc->set("mana_factor",npc->query_skill("spells")/3);
npc->set("combat_exp",npc->query_skill("force")/10*npc->query_skill("force")*npc->query_skill("force") );
npc->set("daoxing",npc->query_skill("spells")/10*npc->query_skill("spells")*npc->query_skill("spells") );
npc->set("max_kee",npc->query("max_force")/2);
npc->set("max_sen",npc->query("max_mana")/2);
npc->set("class",cls);
npc->set("weapon_file",data["weapon"]);
npc->set("family/family_name",fam);
if ( objectp(npc->query_temp("weapon")) )
        {
        npc->query_temp("weapon")->equip();
        destruct(npc->query_temp("weapon"));
        }
weapon->move(npc);
npc->command("wield all");
powerup(npc);
if ( !userp(npc) )  npc->set("level",lvl);
npc->save();
return 1;
}

varargs int super_attack(object npc,object who,int damage,string clr)
{
mapping action,t_action;
string *limbs,limb,str,msg,w_name,tw_name,damage_type;
object weapon,t_weapon;
int ap,dp;

if ( !npc || !who )
        return 0;
if ( !stringp(clr) )
        clr = "RED";
weapon = npc->query_temp("weapon");
if ( !weapon )
        {
        w_name = ({"左","右","双"})[random(3)]+({"拳","掌","爪"})[random(3)];
        weapon = new("/d/city/npc/obj/sword");
        }
else    w_name = weapon->name();
if ( !stringp(w_name) )
        w_name = "手中兵器";
t_weapon = who->query_temp("weapon");
if ( !t_weapon )
        tw_name = ({"左","右","双"})[random(3)]+({"拳","掌","爪"})[random(3)];
else    tw_name = t_weapon->name();
if ( !stringp(tw_name) )
        tw_name = "手中兵器";

limbs = who->query("limbs");
limb = limbs[random(sizeof(limbs))];

action = npc->query("actions");

msg = "\n"+action["action"]+"\n";
msg = replace_string(msg,"$w",w_name);
msg = replace_string(msg,"$l",limb);

msg = no_color_msg(msg);
msg = clr+msg+NOR;
msg = color_msg(msg);
if ( !npc->query("env/no_msg") && !who->query("env/no_msg") )
message_vision(msg,npc,who);
who->set_temp("last_damage_from",npc);

ap = npc->query("combat_exp")/1000000;
if ( ap<10 ) ap = 10;
dp = who->query("combat_exp")/1000000;
if ( dp<10 ) dp = 10;
if ( ap>random(dp/2) )
        {
        if ( !damage || damage<50 )
                {
                damage = action["damage"];
                damage+= npc->query_temp("apply/damage");
                damage+= npc->query("force_factor");
                }
        damage = damage/2+random(damage);
        if ( damage>1000 && !userp(npc) ) damage = 1000;
        if ( damage<100 )  damage = 100;
        damage_type = action["damage_type"];
        if ( !damage_type )
                damage_type = "淤伤";
        msg = " ";     
        msg+= COMBAT_D->damage_msg(damage,damage_type);
        msg = replace_string(msg,"$w",w_name);
        msg = replace_string(msg,"$l",limb);
        msg = no_color_msg(msg);
        msg = clr+msg+NOR;
        msg = color_msg(msg);
        if ( !npc->query("env/no_msg") && !who->query("env/no_msg") )
        message_vision(msg,npc,who);
        if ( random(npc->query("force_factor"))>100 )
                {
                who->receive_wound("kee", damage,npc);
                COMBAT_D->report_status(who,damage);
                }
        else    {
                who->receive_damage("kee", damage,npc);
                COMBAT_D->report_status(who);
                }
        }
else    {
        t_action = who->query("actions");
        msg = " ";     
        if ( stringp(t_action["parry_msg"]) )
                msg+= t_action["parry_msg"];
        msg+= "$n纵身闪开了$N的这一击！\n";     
        msg+= "\n";
        msg = replace_string(msg,"$w",tw_name);
        msg = replace_string(msg,"$l",limb);
        msg = no_color_msg(msg);
        msg = clr+msg+NOR;
        msg = color_msg(msg);
        if ( !npc->query("env/no_msg") && !who->query("env/no_msg") )
        message_vision(msg,npc,who);
        }
return 1;
}


varargs object random_place(string *dirr)
{
int  m,n,i, j, k;
object temp,newob;
mapping ex;

mixed*  file, exit;
string *dirs = ({
        "/d/city",
        "/d/jjf",
        "/d/westway",
//        "/d/kaifeng",    //开封解谜会造成胡敬德气血不断增加，好像其他npc也会影响，暂时关闭。@wuxin 2016.1
        "/d/lingtai",
        "/d/moon",
        "/d/gao",
        "/d/sea", 
        "/d/nanhai", 
        "/d/eastway",
        "/d/xueshan",
        "/d/dntg/hgs",
        
        "/d/qujing/wuzhuang", 
        "/d/qujing/baotou", 
        "/d/qujing/baoxiang", 
        "/d/qujing/bibotan",
        "/d/qujing/biqiu",
        "/d/qujing/chechi",
        "/d/qujing/dudi",
        "/d/qujing/fengxian",
        "/d/qujing/firemount",
        "/d/qujing/jilei",
        "/d/qujing/jindou",
        "/d/qujing/jingjiling",
        "/d/qujing/jinping",
        "/d/qujing/jisaiguo",
        "/d/qujing/maoying",
        "/d/qujing/nuerguo",
        "/d/qujing/pingding",
        "/d/qujing/pansi",
        "/d/qujing/tongtian",
        "/d/qujing/qilin",
        "/d/qujing/qinfa",
        "/d/qujing/qinglong",
        "/d/qujing/tianzhu",
        "/d/qujing/wudidong",
        "/d/qujing/wuji",
        "/d/qujing/xiaoxitian",
        "/d/qujing/yinwu",
        "/d/qujing/yuhua",
        "/d/qujing/zhujie",
        "/d/qujing/zhuzi",
        "/d/penglai",
        "/d/pantao",
        "/d/death",  
        "/d/meishan",
        "/d/qujing/lingshan",
});

if ( dirr && arrayp(dirr) && sizeof(dirr)>0 )
                  dirs = dirr;
n = 0;
i = random(sizeof(dirs));    // pick up one directory
file = get_dir( dirs[i]+"/*.lpc", -1 );
if( !sizeof(file) )
        return 0;
for(k=0;k<30;k++)
        {
        j = random(sizeof(file));
        if( file[j][1] > 0 )
                {
                newob=load_object(dirs[i]+"/"+file[j][0]);
                if ( !newob )
                        continue;
                if ( newob->query("no_fight") 
                  || newob->query("no_magic") 
                  || newob->query("no_mieyao") 
                  || !(exit=newob->query("exits")) 
                  || sizeof(keys(exit))<1 
                  || newob->query("alternative_die") )
                        continue;
                if ( !mapp(ex=newob->query("exits")) )
                        continue;
                m = sizeof(keys(ex));
                while(m--)
                        {
                        temp = load_object(ex[keys(ex)[m]]);
                        if ( temp )
                                {
                                if ( temp->query("exits/"+walks[keys(ex)[m]])!=base_name(newob) )
                                        n++;
                                }                                       
                        else    continue;
                        }
                if ( n )
                        continue;       
                if ( newob )    
                        return newob;
                }
        }
return 0;
}
        
varargs object random_npc(string *dirr,object obj)
{
object *inv,npc,where = random_place(dirr);
int i;
while( !where || sizeof(all_inventory(where))<1 )
        where = random_place(dirr);
inv = all_inventory(where);
i = sizeof(inv);
while(i--)
        {
        if ( !inv[i] || !inv[i]->is_character() 
          || inv[i]->is_fighting() 
          || !living(inv[i]) 
          || inv[i]->is_busy() )
                continue;
        if ( inv[i] )
                return inv[i];
        }
return random_npc(dirr,obj); 
}                         


object find_user(string arg)
{
int lv = 0;     
object who,body;

if ( !arg )
        return 0;
return FINGER_D->acquire_login_ob(arg);
}        

object *add_arr_obj(object *ob,object obj)
{
int i;
object *oo = ({});      
if ( !obj )
        return ob;
i = sizeof(ob);         
while(i--)
        if ( ob[i] )  oo+= ({ob[i]});
oo+= ({obj});
return oo;
}       

object *clear_arr_obj(object *ob,object obj)
{
int i;
object *oo = ({});      
if ( !obj )
        return ob;
i = sizeof(ob);         
while(i--)
        {
        if ( ob[i] && ob[i]!=obj )
                oo+= ({ob[i]});
        }       
return oo;
}                       

