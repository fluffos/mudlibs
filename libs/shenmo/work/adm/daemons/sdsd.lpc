//查询玩家是否为变或隐身过程
//who = this_player()
//npc = this_object()
void check_player(object who,object npc)
{
if ( !who || !npc
  || !present(who,environment(npc)) || !interactive(who) )
        return;
        //隐身
if ( who->query("env/invisibility")
  || who->query_temp("yinshentime") )
        {
        who->delete_temp("yinshentime");
        who->delete("env/invisibility");
        who->save();
        who->delete_temp("no_heal_up/yinshen");
        message_vision(HIW"\n白光闪过之后，$N"HIW"又现出了身形。\n\n"NOR,who);
        who->set("mana",(int)who->query("mana")/2);
        }
        //变
if ( who->query_temp("apply/name") )
        {
        who->delete_temp("spellslevel");
        who->delete_temp("apply/name");
        who->delete_temp("apply/id");
        who->delete_temp("apply/short");
        who->delete_temp("apply/long");
        who->delete_temp("family");
        message_vision(HIY"只见$N"HIY"面色苍白，一个恍惚之间，已经现了原形。\n"NOR,who);
        who->delete_temp("no_heal_up/bian");
        who->set("mana",(int)who->query("mana")/2);
        }
return;
}

