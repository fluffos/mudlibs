int check_fight(object npc,object target,object env)
{
return 1;
}

varargs void powerup(object who,int flag)
{
if ( !who )  return;
who->set("kee",who->query("max_kee"));
who->set("eff_kee",who->query("max_kee"));
who->set("sen",who->query("max_sen"));
who->set("eff_sen",who->query("max_sen"));
who->set("mana",who->query("max_mana")*2);
who->set("force",who->query("max_force")*2);
who->clear_condition();
who->delete_temp("no_move");
who->delete_temp("no_cast");
if ( who->is_busy() )
        {
        who->start_busy(1,10);
        who->interrupt_me(who,"神力");          
        who->reset_action();
        if ( flag )
                message_vision("\n$N念动真言：“金木水火土，急急如律令！”顿时变的身轻如燕！\n\n",who);
        }
if ( flag && flag==1 )
        message_vision(HIG"\n$N"HIG"从怀里小心翼翼的拿出一颗云丹送入嘴中，果然见$P脸上慢慢
泛出红光，法力和内力到了极限！\n"NOR,who);
return;
}

void addSen(object me)
{
int neilineed,diff;
if( me->query("force")<20 ) return;
diff = me->query("eff_sen")-me->query("sen");
neilineed = diff*50/(me->query_skill("spells")+1);
if( neilineed<1 ) return;
if( neilineed>me->query("force") ) neilineed = me->query("force");
diff = neilineed*(int)me->query_skill("force")/50;
if ( diff<1 ) return;
me->receive_heal("sen", diff);
me->add("force", -neilineed);
if ( random(3)==1 )  message_vision("$N略一凝神，吸了口气，精神看起来清醒多了。\n", me);
return;
}

void addKee(object me)
{
int diff,neilineed;
if( me->query("force")<20 ) return;
diff = me->query("eff_kee")-me->query("kee");
neilineed = diff*30/(me->query_skill("force")+1);
if( neilineed<1 ) return;
if( neilineed>200 ) neilineed=200;
if( neilineed>me->query("force") )
        neilineed = me->query("force");
diff = neilineed*(int)me->query_skill("force")/20;
if ( diff<1 ) return;
me->receive_heal("kee", diff );
me->add("force",-neilineed);
if ( random(3)==1 )  message_vision("$N深深吸了几口气，脸色看起来好多了。\n", me);
return;
}

void addEffSen(object me)
{
int addSen;
addSen = me->query("max_sen")-me->query("eff_sen");
if ( addSen<=0 ) return;
while( me->query("eff_sen")<me->query("max_sen") )
        {
        if ( me->query("mana")<200 )
                return;
        me->receive_curing("sen",(200+(int)me->query_skill("spells",1)/2) );
        me->add("mana",-200);
        }
if ( random(3) )  message_vision("$N吃下一些混元丹，气色看起来好多了。\n"NOR,me); 
return;
}

void addEffKee(object me)
{
int add_kee;
add_kee = me->query("max_kee")-me->query("eff_kee");
if ( add_kee<=0 ) return;
while( me->query("eff_kee")<me->query("max_kee") )
        {
        if ( me->query("force")<200 )
                return;
        me->receive_curing("kee",(100+(int)me->query_skill("force",1)/2) );
        me->add("force",-200);
        }
if ( random(3)==1 )  message_vision("$N吃下一些金创药，气色看起来好多了。\n"NOR,me); 
return;
}

varargs void hitWeapon(object me, object target, object weapon)
{
object ob;
int wap, wdp;

if( objectp(weapon) && objectp(ob=target->query_temp("weapon")) && present(ob,target) )
        {
        wap = weapon->weight()/500;
        wap+= weapon->query("rigidity");
        wap+= me->query("str");
        wap+= weapon->query("luck");

        wdp = ob->weight()/500;
        wdp+= ob->query("rigidity");
        wdp+= target->query("str");
        wdp+= ob->query("luck");
        wap = random(wap);

        if( wap>wdp*2 )
                {
                message_vision(HIW"$N"HIW"只觉得手中"+ob->name()+HIW"把持不定，脱手飞出！\n" NOR,target);
                ob->unequip();
                if ( ob->query("zizhi") )
                        destruct(ob);
                else if ( ob->query("no_get") )
                        ob->move(target);
                else    {
                        ob->move(environment(target));
                        call_out("remove_broken_weapon",random(300)+60,ob);
                        }
                target->delete_temp("weapon");
                target->reset_action();
                }
        else if( wap>wdp && !ob->query("no_break") && !ob->query("zizhi"))
                {
                message_vision(HIY"只听见「啪」地一声，$N"HIY"手中的"+ob->name()+HIY"已经断为两截！\n" NOR,target);
                ob->set("name","断掉的"+ob->query("name"));
                ob->set("value", 0);
                ob->add("weapon_prop/damage",-ob->query("weapon_prop/damage")/5);
                ob->unequip();
                if ( ob->query("zizhi") )
                        destruct(ob);
                else if ( ob->query("no_get") )
                        ob->move(target);
                else    {
                        ob->move(environment(target));
                        call_out("remove_broken_weapon",random(300)+60,ob);
                        }
                target->delete_temp("weapon");
                target->reset_action();
                }
        else if( wap>wdp/3 )
                {
                 if( !ob->query("zizhi") )  //增加自制兵器抗兵器受损，防止攻击持续下降 wuxin@tsrj 2013 
                   {  message_vision("$N手中的"+weapon->name()+"与$n的兵刃"+ob->name()+"相交，“啪”的一声，将"+
ob->name()+"崩出一个豁口。\n",me,target);
                target->set_temp("apply/damage",target->query_temp("apply/damage")*95/100);
                    }
                else  message_vision("$N连忙用真气护住兵刃，手中的"+ob->name()+"发出阵阵龙吟！\n" NOR,target);
                }
        else if ( wap>wdp/5 )
                message_vision("$N只觉得手中" + ob->name() + "一震，险些脱手！\n",target);
        else    message_vision("$N的" + weapon->name() + "和$n的" + ob->name()+"相击，冒出点点的火星。\n", me,target);
        }
}

void remove_broken_weapon(object ob)
{
if( ob && environment(ob) )
        {
        tell_object(environment(ob),"一阵微风吹过，"+ob->name()+"化为片片尘土，消失不见了。\n");
        destruct(ob);
        }
}

int sort_skill(string file)
{
int i;
if ( !sscanf(file, "%*s.lpc") )  return 0;
i = strlen(file);
while(i--)
        {
        if( file[i] == '.' ) continue;
        if( file[i] < 'a' || file[i] > 'z' )
                return 0;
        }
return 1;
}

int max(int a,int b)
{
if ( a>b )  return a;
return b;
}

string checkSkill(object who,string arg)
{
int i;
string *str,sk,exert,*file;
object newSk;
mapping skill = who->query_skills();

if ( !skill || !mapp(skill) )  return 0;
if ( !skill[arg] )    return 0;
str = keys(skill);
for( i=0;i<sizeof(str);i++ )
        {
        if ( who->query_skill_mapped(arg)==str[i] )
                {
                sk = str[i];
                break;
                }
        }
if ( !stringp(sk) )     return 0;
if(file_size(SKILL_D(sk)+".lpc") < 1)
        error ("daemon/"+sk+".c文件损坏.\n");
newSk = load_object(SKILL_D(sk));
if( stringp(exert=SKILL_D(sk)->perform_action_file("")) )
        {
        file = get_dir(exert);
        if ( sizeof(file)>0 )
                file = filter_array(file, (: sort_skill :) );
        }
else if( stringp(exert = SKILL_D(sk)->exert_function_file("")) )
        {
        file = get_dir(exert);
        if ( sizeof(file)>0 )
                file = filter_array(file, (: sort_skill :) );
        }
else if( stringp(exert = SKILL_D(sk)->cast_spell_file("")) )
        {
        file = get_dir(exert);
        if ( sizeof(file)>0 )
                file = filter_array(file, (: sort_skill :) );
        }
if ( sizeof(file)<=0 )
        return 0;

i = random(sizeof(file));
if ( !file[i] )  return 0;
exert = replace_string(file[i],".lpc","");
who->set_temp("sdsd/checkskill",exert);
return exert;
}

//最高的skills
int maxSkill(object who)
{
int i,num = 1;
mapping skills;
string *skill;

skills = who->query_skills();
if ( !skills || 0 == sizeof(skills) )
{
    return 100;
}
skill = keys(skills);

if ( sizeof(skill)>0 )
        {
        for (i=0;i<sizeof(skill);i++)
                {
                if ( who->query_skill(skill[i],1)>num )
                        num = who->query_skill(skill[i],1);
                }
        }
else    num = 200+random(300);
return num;
}

varargs void randomPfm(object who,string arg)
{
string exert;
object weapon;
if ( !who )
        return;
if ( !who->is_fighting() )
        return; 
if ( !arg )
        {
        if ( !objectp(weapon=who->query_temp("weapon")) )
                arg = "unarmed";
        else    arg = weapon->query("skill_type");
        }                       
if ( !arg || !stringp(arg) )   arg = "unarmed";
exert = checkSkill(who,arg);
if ( !exert || !stringp(exert) )  return;
if ( !who->perform_action(arg,exert) )
        who->command("perform "+exert);
}

void randomCast(object who)
{
string exert,*noMsg;
if ( !who )
        return;
exert = checkSkill(who,"spells");
noMsg = ({      "shuidun",                 //dragon
                "escape","chongsheng",//emei swordman
                "townportal",              //hell
                "yin",                     //gumu
                "nophase",               //sanxian
                "jieti",               //xueshan
                "tuoqiao",                 //shushan
                "bagua",                   //youxia
                "qimen",                    //wzg
                "tudun",                   //wdd
                "chuqiao",              //all
                });
if ( who->is_fighting()
   && member_array(exert,noMsg)!=-1 )
        {
        randomCast(who);
        return;
        }
if ( !who->cast_spell(exert) )
        who->command("cast "+exert);
}

void randomExert(object who)
{
string exert;
if ( !who )
        return;
exert = checkSkill(who,"force");
if ( !who->exert_function(exert) )
        who->command("exert "+exert);
}

