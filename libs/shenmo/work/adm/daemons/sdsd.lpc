return oo;
}                       

string random_msg(string arg)
{
int i,k,j;
string str,arg1;        
if ( !arg || !stringp(arg) )
        return "";
arg = no_color_msg(arg);        
i = strlen(arg);
if ( random(2) ) j= i/2;
else j = i-2;
for(j;j>0;j--)
        {
        k = random(i*2)/2;
        while( k==i-2 || k%2!=0 )  
                k = random(i*2)/2;
        str = sprintf("%c%c",arg[k],arg[k+1]);
        arg = replace_string(arg,str,"□");
        }
arg = no_color_msg(arg);        
return arg;
}


int copy_data(object who,object npc)
{
object weapon;  
mapping my,his;
string *m_skills,temp;
int i,k;
        
if ( !who || !npc || userp(npc) )
        return 0;
//基本属性
my = who->query_entire_dbase();
his = npc->query_entire_dbase();
his["max_kee"] = my["max_kee"]*3;
his["max_sen"] = my["max_sen"]*3;
his["max_force"] = my["max_force"]*3;
his["max_mana"] = my["max_mana"]*3;
his["level"] = my["level"]+random(my["level"]/2);
his["combat_exp"] = my["combat_exp"]+random(my["combat_exp"]/2);
his["daoxing"] = my["daoxing"]+random(my["daoxing"]/2);
his["kar"] = my["kar"]+random(my["kar"]/2);
his["int"] = my["int"]+random(my["int"]/2);
his["str"] = my["str"]+random(my["str"]/2);
his["bellicosity"] = my["bellicosity"]+random(200);
his["莲花"] = 1;
his["class"] = my["class"];
his["family"] = my["family"];
//技能
my = who->query_skills();
m_skills = keys(my);
i = sizeof(m_skills);
while(i--)
        if ( m_skills[i] && stringp(m_skills[i]) )
                npc->set_skill(m_skills[i],my[m_skills[i]]);
my = npc->query_skills();
m_skills = keys(my);
i = sizeof(m_skills);
while(i--)
        {
        if ( m_skills[i] && stringp(m_skills[i]) )
                npc->map_skill(m_skills[i],who->query_skill_mapped(m_skills[i]));
        }
SDS_D->powerup(npc);
//临时文件
my = who->query_entire_temp_dbase();
his = npc->query_entire_temp_dbase();
if( his && my && !undefinedp(his["apply"]) && !undefinedp(my["apply"]) )  {
his["apply"] = my["apply"];
his["apply/armor"] = my["apply/armor"]+200;
}
weapon = my["weapon"];
if ( weapon && objectp(weapon) )
        {
        //可以NPC拿     
        if ( !functionp(weapon->check_owner()) 
          && !weapon->query("owner") )
                weapon = new(base_name(weapon));
        else    weapon = new("/d/city/npc/obj/"+weapon->query("skill_type"));
        if ( weapon && weapon->move(npc) )
                npc->command("wield all");
        }
return 1;
}

varargs object random_item(string *dirr)
{
object *inv,npc=random_npc(dirr),obj;
int i;
while( !npc || !living(npc) || sizeof(all_inventory(npc))<1 )
        npc = random_npc(dirr);
inv = all_inventory(npc);
i = sizeof(inv);
while(i--)
        {
        obj = inv[random(i)];   
        if ( !obj || obj->is_character() || obj->query("no_get") )
                continue;
        return inv[i];
        }
return random_item(dirr); 
}

