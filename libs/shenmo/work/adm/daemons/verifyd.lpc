public void task_verify_string(object ob) {
  task_set_verify_string(ob);
  tell_object(ob, ob->query_temp("task_verify_graph"));
  tell_object(ob, HIY "  恭喜你完成任务，请输入 " HIR "vf + <屏幕字符>" HIY " 获得奖励！！！(例如：vf AC)\n" NOR);
  tell_object(ob, HIY "  注：不区分大小写！！(验证答案有两秒的致忙)\n" NOR);
}

public void task_verify_reward(object ob) {}

public void task_verify_fail(object ob) {
  ob->delete_temp("task_verify_result");
  ob->delete_temp("task_verify_graph");
  tell_object(ob, HIW "很遗憾，你输入的字符不正确！\n" NOR);
}

