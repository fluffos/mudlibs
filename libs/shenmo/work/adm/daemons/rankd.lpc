string describe_dx(int value)
{
int grade, two_year, n;
	
//two_year = value/2000;
//由于现在都太高，修改描述范围，是原来的４０倍。
two_year = value/80000;
for(grade=0; grade<sizeof(dx_level_desc); grade++)
	{
	n = (grade+1)*(grade+1)*(grade+1);
	if( two_year<n ) break;
	}
if( grade>=sizeof(dx_level_desc) ) 
	grade=sizeof(dx_level_desc)-1;
return dx_level_desc[grade];
}

int grade_dx(string desc)
{
int grade, n;

for(grade=0; grade<sizeof(dx_level_desc); grade++) 
	{
	n = grade;
	if ( dx_level_desc[grade] == desc )
		return n;
	}
return 0;
}

string describe_exp(int value)
{
int grade, lvl , n;
	
//lvl = (value*2)/675;
//由于现在都太高，修改描述范围，是原来的５０倍。
lvl = (value*2)/33750;

	//note, this is to make 深不可测 requires 2700k combat_exp,
	//which also means player can learn skill level to 300.

for(grade=0; grade<sizeof(exp_level_desc); grade++) 
	{
	n = (grade+1)*(grade+1)*(grade+1);
	if( lvl<n ) break;
	}
if( grade>=sizeof(exp_level_desc) ) 
	grade=sizeof(exp_level_desc)-1;
return exp_level_desc[grade];
}

int grade_exp(string desc)
{
int grade, n;

for(grade=0; grade<sizeof(exp_level_desc); grade++) 
	{
	n = grade;
	if ( exp_level_desc[grade] == desc )
		return n;
	}
return 0;
}

string describe_neili(int value)
{
int year, sixty, left;
string line;
	
year = value/100;
sixty = year/60;
left = year - sixty*60;

if( year <= 0 )
	{
	line = HIB "不到一年" NOR;
	return line;
	}
	
if(sixty > 0 )
	{
	if ( left != 0 )
		line = HIW + chinese_number(sixty) + "甲子" + NOR + "又" +  HIR + chinese_number(left) + "年" + NOR;
	else	line = HIW + chinese_number(sixty) + "甲子"  + NOR;	
	}
else	line = HIR + chinese_number(year)+"年" + NOR;
return line;
}

string describe_fali(int value)
{
int grade, lvl, n;

	//in unit of 40, increase by n^2.
lvl=value/40;
for(grade=0; grade<sizeof(fali_level_desc); grade++) 
	{
	n=(grade+1)*(grade+1);
	if( lvl<n ) break;
	}
if( grade>=sizeof(fali_level_desc) ) 
	grade=sizeof(fali_level_desc)-1;
return fali_level_desc[grade];
}
 
int grade_fali(string desc)
{
int grade;

for(grade=0; grade<sizeof(fali_level_desc); grade++) 
	{
	if ( (string)fali_level_desc[grade] == desc )
		return grade;
	}
return 0;
}

string describe_yishu(int value)
{
int grade, n , two_lvl;
two_lvl = value/2;
for(grade=0; grade<sizeof(yishu_level_desc); grade++) 
	{
	n = (grade+1)*(grade+1);
	if( two_lvl<n ) break;
        }
if( grade>=sizeof(yishu_level_desc) ) 
	grade=sizeof(yishu_level_desc)-1;
return yishu_level_desc[grade];
}

int grade_yishu(string desc)
{
int grade, n;
for(grade=0; grade<sizeof(yishu_level_desc); grade++) 
        {
	n = grade;
	if ( yishu_level_desc[grade] == desc )
		return n;
	}
return 0;
}

string query_description(int type)
{
int i;
string *level_desc;
string line = "";
if(type==0) 
	level_desc = dx_level_desc;
else if(type==1) 
	level_desc = exp_level_desc;
else	level_desc = fali_level_desc;
    
for(i=0; i<sizeof(level_desc); i++)
	{
	line += level_desc[i] + "    ";
	if( (i%4)==3 ) 
		line += "\n";
	}
return line;
}

string _query_rank(object ob);

string query_rank(object ob)
{
string rank=_query_rank(ob);
string s1,s2,s3;
int len, len1, len2;
    
if(sscanf(rank,"%s【%s】%s",s1,s2,s3)!=3) 
	return rank;
len=14-sizeof(s2);
if(len<1) 
	return rank;

len1=len/2;
len2=len-len1;
if( len1 ) 
	s2=repeat_string(" ",len1)+s2;
if( len2 ) 
	s2+=repeat_string(" ",len2);
    
return s1+"【"+s2+"】"+s3;
}

string _query_rank(object ob)
{
string at,str;
string fam,*fams,*arg;
mapping ranks;
int dx;

if(strlen(ob->query("added_title"))<1) 
	ob->set("added_title", "无名");

at = ob->query("added_title");
dx = (int)ob->query("daoxing");

if( ob->is_ghost() ) 
	return HIB "【 鬼  魂 】" NOR;

if ( wizardp(ob) )
	{
	if ( stringp(ob->query("wiz_rank")) )
		return WHT"【 "NOR+HIY"天"HIR"上"HIC"人"HIG"间"NOR"◆"HIY+ob->query("wiz_rank")+NOR+WHT" 】"NOR;
	else	{	
		switch( ob->query("gender") )
			{
			case "女性" :
				switch(wizhood(ob))
					{
                        		case "(admin)"	:	return WHT"【 "NOR HIY"天"HIR"上"HIC"人"HIG"间"NOR"※"HIY"帝后"NOR WHT" 】" NOR;
                        		case "(arch)"	:	return WHT"【 "NOR HIY"天"HIR"上"HIC"人"HIG"间"NOR"※"HIC"天后"NOR WHT" 】" NOR;
                        		case "(wizard)"	:	return WHT"【 "NOR HIY"天"HIR"上"HIC"人"HIG"间"NOR"※"HIM"巫女"NOR WHT" 】" NOR;
                        		case "(apprentice)":	return WHT"【 "NOR HIY"天"HIR"上"HIC"人"HIG"间"NOR"※"HIG"见习巫女"NOR WHT" 】" NOR;
                        		case "(immortal)":	return WHT"【 "NOR HIY"天"HIR"上"HIC"人"HIG"间"NOR"※"HIR"客座巫女"NOR WHT" 】" NOR;
                        		case "(elder)"	:	return WHT"【 "NOR HIY"天"HIR"上"HIC"人"HIG"间"NOR"※"HIW"荣誉玩家"NOR WHT" 】" NOR;
					default		:	return WHT"【 "NOR HIY"天"HIR"上"HIC"人"HIG"间"NOR"※"RED"准巫师"NOR WHT" 】" NOR;
					}
			default :
				switch(wizhood(ob))
					{
					case "(admin)"	:	return WHT"【 "NOR HIY"天"HIR"上"HIC"人"HIG"间"NOR"※"HIY"帝王"NOR WHT" 】" NOR;
					case "(arch)"	:	return WHT"【 "NOR HIY"天"HIR"上"HIC"人"HIG"间"NOR"※"HIC"天王"NOR WHT" 】" NOR;
					case "(wizard)"	:	return WHT"【 "NOR HIY"天"HIR"上"HIC"人"HIG"间"NOR"※"HIM"神君"NOR WHT" 】" NOR;
					case "(apprentice)":	return WHT"【 "NOR HIY"天"HIR"上"HIC"人"HIG"间"NOR"※"HIG"见习神君"NOR WHT" 】" NOR;
					case "(immortal)":	return WHT"【 "NOR HIY"天"HIR"上"HIC"人"HIG"间"NOR"※"HIR"客座神君"NOR WHT" 】" NOR;
					case "(elder)"	:	return WHT"【 "NOR HIY"天"HIR"上"HIC"人"HIG"间"NOR"※"HIW"荣誉玩家"NOR WHT" 】" NOR;
					default		:	return WHT"【 "NOR HIY"天"HIR"上"HIC"人"HIG"间"NOR"※"RED"准神君"NOR WHT" 】" NOR;									
					}
			}
		}	
	}
else 	{
	if ( ob->query("gender")!="女性" )
		ranks = m_ranks;
	else 	ranks = f_ranks;
	fams = keys(ranks);
	fam = ob->query("family/family_name");
        if ( !fam || member_array(fam,fams)==-1 )
		{
		if ( dx<1000 )		return HIM"【西游记--神魔传说·游民】"NOR;
		else if ( dx<10000 )	return HIM"【西游记--神魔传说·流民】"NOR;
		else if ( dx<100000 )	return HIM"【西游记--神魔传说·游士】"NOR;
		else if ( dx<500000 )	return HIM"【西游记--神魔传说·游侠】"NOR;
		else if ( dx<1000000 )	return HIM"【西游记--神魔传说·侠士】"NOR;
		else 			return HIM"【西游记--神魔传说·大侠】"NOR;
		}
	arg = ranks[fam]["rank"];
	if ( dx<1000 )		str = arg[0];
	else if ( dx<10000 )	str = arg[1];
	else if ( dx<100000 )	str = arg[2];
	else if ( dx<500000 )	str = arg[3];
	else if ( dx<1000000 )	str = arg[4];
	else 			str = arg[5];
	str = replace_string(str,"$a",at);
	return str;
	}
}						

string query_respect(object ob)
{
int age,dx,gender;
string str,fam,*fams,*arg;
mapping ranks;

if( stringp(str = ob->query("rank_info/respect")) )
	return str;

	// added by snowcat
age = ob->query("fake_age");
if (age == 0) 
	age = ob->query("age");

if (ob->query("gender")=="女性" )
	{
	ranks = f_ranks;
	gender = 0;
	}
else 	{
	ranks = m_ranks;
	gender = 1;
	}
fams = keys(ranks);
fam = ob->query("family/family_name");
if ( !fam || member_array(fam,fams)==-1 )
	{
	if ( age<18 )
		{
		if ( ob->query("class")=="bonze" )
			return ({"小师傅","小师父"})[gender];
		else	return ({"小姑娘","小兄弟"})[gender];
		}
	else if ( age<25 )
		{
		if ( ob->query("class")=="bonze" )
			return ({"小师太","小和尚"})[gender];
		else	return ({"姑娘","小相公",})[gender];
		}
        else if ( age<50 )      
		{
		if ( ob->query("class")=="bonze" )        
			return ({"师太","大师"})[gender];
		else	return ({"夫人","壮士"})[gender];
		}
	else	{
		if ( ob->query("class")=="bonze" )
			return ({"老师太","老师父"})[gender];
		else	return ({"老婆婆","老公公",})[gender];
		}
	}
dx = ob->query("daoxing");
arg = ranks[fam]["respect"];
if ( age<16 )	str = arg[0];
else	{
	if ( age<16 )		str = arg[0];
	else if ( age<35 )	str = arg[1];
	else if ( age<50 )	str = arg[2];
	else if ( dx<500000 )	str = arg[3];
	else if ( dx<1000000 )	str = arg[4];
	else 			str = arg[5];
	}	
return str;
}

string query_rude(object ob)
{
int age,gender;
string str,fam,*fams,*arg;
mapping ranks;

if( stringp(str = ob->query("rank_info/rude")) )
	return str;

age = ob->query("fake_age");
if ( age==0 ) 
	age = ob->query("age");

if (ob->query("gender")=="女性" )
	{
	ranks = f_ranks;
	gender = 0;
	}
else 	{
	ranks = m_ranks;
	gender = 1;
	}
fams = keys(ranks);
fam = ob->query("family/family_name");
if ( !fam || member_array(fam,fams)==-1 )
	{
	if ( age<25 )
		{
		if ( ob->query("class")=="bonze" )
			return ({"小贼尼","小秃驴"})[gender];
		else	return ({"小贱人","小王八蛋"})[gender];
		}
	else if ( age<50 )
		{
		if ( ob->query("class")=="bonze" )
			return ({"贼尼","秃驴"})[gender];
		else	return ({"贱人","臭贼"})[gender];
		}
	else	{
		if ( ob->query("class")=="bonze" )
			return ({"老贼尼","老秃驴"})[gender];
		else	return ({"死老太婆","老匹夫"})[gender];
		}
	}
arg = ranks[fam]["rude"];
if ( age<25 )		str = arg[0];
else if ( age<50 )	str = arg[1];
else			str = arg[2];
return str;
}

string query_self(object ob)
{
int age,dx,gender;
string str,fam,*fams,*arg;
mapping ranks;

if( stringp(str = ob->query("rank_info/self")) )
	return str;

age = ob->query("fake_age");
if (age == 0) 
	age = ob->query("age");

if (ob->query("gender")=="女性" )
	{
	ranks = f_ranks;
	gender = 0;
	}
else 	{
	ranks = m_ranks;
	gender = 1;
	}
fams = keys(ranks);
fam = ob->query("family/family_name");
if ( !fam || member_array(fam,fams)==-1 )
	{
	if ( age<18 )
		{
		if ( ob->query("class")=="bonze" )
			return ({"小尼姑","小和尚"})[gender];
		else	return ({"姑娘我","小爷我"})[gender];
		}
	else if ( age<50 )
		{
		if ( ob->query("class")=="bonze" )
			return ({"本师太","大和尚"})[gender];
		else	return ({"本姑娘","本大侠",})[gender];
		}
	else	{
		if ( ob->query("class")=="bonze" )
			return ({"本师太","老和尚"})[gender];
		else	return ({"本姑奶奶","爷爷我"})[gender];
		}
	}
dx = ob->query("daoxing");
arg = ranks[fam]["self"];
if ( age<16 )	str = arg[0];
else	{
	if ( age<16 )		str = arg[0];
	else if ( age<35 )	str = arg[1];
	else if ( age<50 )	str = arg[2];
	else if ( dx<500000 )	str = arg[3];
	else if ( dx<1000000 )	str = arg[4];
	else 			str = arg[5];
	}	
return str;
}

