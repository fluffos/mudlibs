#include <ansi.h>
#include <mudlib.h>

void topten_checkplayer(object);
int get_all_data(object, string);
int topten_del(string, string);
int topten_add(object, string);
int topten_save(string, string, string);
string topten_query(string);
string query_type();


void topten_checkplayer(object player) {
  topten_add(player, "exp");
  topten_add(player, "daoheng");
  topten_add(player, "level");
  topten_add(player, "age");
  topten_add(player, "rich");
  topten_add(player, "force");
  topten_add(player, "mana");
  topten_add(player, "quests");
  topten_add(player, "kill");
  topten_add(player, "dead");
  topten_add(player, "zhuzao");
  topten_add(player, "task");
  topten_add(player, "literate");
  topten_add(player, "medical");
  topten_add(player, "tianfu");
  topten_add(player, "unarmed");
  topten_add(player, "dodge");
  topten_add(player, "sword");
  topten_add(player, "blade");
  topten_add(player, "stick");
  topten_add(player, "staff");
  topten_add(player, "whip");
  return;
}

string query_type() {
  return HIY + CHINESE_MUD_NAME + "现在有以下类型的排行榜：\n" + HIC "exp\t" HIW + EXP_B + "\n" + HIC "daoheng\t" HIW + DAOHENG_B + "\n" + HIC "level\t" HIW + LEVEL_B + "\n" + HIC "age\t" HIW + AGE_B + "\n" + HIC "rich\t" HIW + RICH_B + "\n" + HIC "force\t" HIW + FORCE_B + "\n" + HIC "mana\t" HIW + MANA_B + "\n" + HIC "quests\t" HIW + QUESTS_B + "\n" + HIC "kill\t" HIW + KILL_B + "\n" + HIC "dead\t" HIW + DEAD_B + "\n" + HIC "zhuzao\t" HIW + ZHUZAO_B + "\n" + HIC "task\t" HIW + TASK_B + "\n" + HIC "literate\t" HIW + LITERATE_B + "\n" + HIC "medical\t" HIW + MEDICAL_B + "\n" + HIC "tianfu\t" HIW + TIANFU_B + "\n" + HIC "unarmed\t" HIW + UNARMED_B + "\n" + HIC "dodge\t" HIW + DODGE_B + "\n" + HIC "sword\t" HIW + SWORD_B + "\n" + HIC "blade\t" HIW + BLADE_B + "\n" + HIC "stick\t" HIW + STICK_B + "\n" + HIC "staff\t" HIW + STAFF_B + "\n" + HIC "whip\t" HIW + WHIP_B + "\n" + NOR;
}
int topten_save(string f_name, string b_name, string str) {
  string *astr;
  int i;
  astr = explode(str, "\n");
  str = "";
  for (i = 0; i < sizeof(astr) && i < 10; i++)
    str += astr[i] + "\n";
  if (!write_file(f_name, str, 1))
    return notify_fail("无法写文件" + f_name + "，权限不够!不能更新" + b_name + "!\n");
  return 1;
}

string topten_query(string type) {
  string b_name, f_name, str, *astr, *bstr, name, id;
  int i, j, data;
  switch (type) {
    case "exp":
      b_name = EXP_B;
      f_name = TOPTEN_EXP;
      break;
    case "daoheng":
      b_name = DAOHENG_B;
      f_name = TOPTEN_DAOHENG;
      break;
    case "level":
      b_name = LEVEL_B;
      f_name = TOPTEN_LEVEL;
      break;
    case "age":
      b_name = AGE_B;
      f_name = TOPTEN_AGE;
      break;
    case "rich":
      b_name = RICH_B;
      f_name = TOPTEN_RICH;
      break;
    case "force":
      b_name = FORCE_B;
      f_name = TOPTEN_FORCE;
      break;
    case "mana":
      b_name = MANA_B;
      f_name = TOPTEN_MANA;
      break;
    case "quests":
      b_name = QUESTS_B;
      f_name = TOPTEN_QUESTS;
      break;
    case "kill":
      b_name = KILL_B;
      f_name = TOPTEN_KILL;
      break;
    case "dead":
      b_name = DEAD_B;
      f_name = TOPTEN_DEAD;
      break;
    case "zhuzao":
      b_name = ZHUZAO_B;
      f_name = TOPTEN_ZHUZAO;
      break;
    case "task":
      b_name = TASK_B;
      f_name = TOPTEN_TASK;
      break;
    case "literate":
      b_name = LITERATE_B;
      f_name = TOPTEN_LITERATE;
      break;
    case "medical":
      b_name = MEDICAL_B;
      f_name = TOPTEN_MEDICAL;
      break;
    case "tianfu":
      b_name = TIANFU_B;
      f_name = TOPTEN_TIANFU;
      break;
    case "unarmed":
      b_name = UNARMED_B;
      f_name = TOPTEN_UNARMED;
      break;
    case "dodge":
      b_name = DODGE_B;
      f_name = TOPTEN_DODGE;
      break;
    case "sword":
      b_name = SWORD_B;
      f_name = TOPTEN_SWORD;
      break;
    case "blade":
      b_name = BLADE_B;
      f_name = TOPTEN_BLADE;
      break;
    case "stick":
      b_name = STICK_B;
      f_name = TOPTEN_STICK;
      break;
    case "staff":
      b_name = STAFF_B;
      f_name = TOPTEN_STAFF;
      break;
    case "whip":
      b_name = WHIP_B;
      f_name = TOPTEN_WHIP;
      break;
    default:
      return "没有" + type + "这种排行榜！\n";
  }
  if (file_size(f_name) == -1)
    return b_name + "的数据文件还没有创建！\n";
  astr = explode(read_file(f_name), "\n");
  str = HIY + CHINESE_MUD_NAME + "：\n" NOR + HIC + b_name + "\n";
  for (i = 0; i < sizeof(astr); i++) {
    bstr = explode(astr[i], ";");
    str += HIC "排行第" + chinese_number(i + 1) + "：" HIW;
    for (j = 0; j < sizeof(bstr); j++) {
      if (sscanf(bstr[j], "%s(%s)%d", name, id, data) != 3)
        return "数据错误!文件：" + f_name + "第" + i + "行第" + j + "项！\n" +
          "该行数据：" + bstr[j] + "\n";
      str += "ZJURL" + id + ":look " + id + "NOR";
    }
    str += "\n" NOR;
  }
  str = replace_string(str, "\n", "$br#");
  return "007" + str + "\n";
}
int get_all_data(object player, string type) {
  int total;
  switch (type) {
    case "exp":
      total = (int)player->query("combat_exp") / 200000;
      break;
    case "daoheng":
      total = (int)player->query("daoxing") / 200000;
      break;
    case "level":
      total = (int)player->query("level");
      break;
    case "age":
      total = (int)player->query("mud_age") + (int)player->query("mud_age0") + (int)player->query("mud_age1") + (int)player->query("mud_age2");
      break;
    case "rich":
      total = (int)player->query("c_balance_credit") * 100 + (int)player->query("c_balance") / 10000000 + (int)player->query("balance") / 10000000;
      break;
    case "force":
      total = (int)player->query("max_force");
      break;
    case "mana":
      total = (int)player->query("max_mana");
      break;
    case "quests":
      total = (int)player->query("quest/number");
      break;
    case "kill":
      total = (int)player->query("PKS") * 10000 + (int)player->query("MKS");
      break;
    case "dead":
      total = (int)player->query("DIE");
      break;
    case "zhuzao":
      total = (int)player->query("work/wakuang");
      break;
    case "task":
      total = (int)player->query("TASK");
      break;
    case "literate":
      total = (int)player->query_skill("literate", 1);
      break;
    case "medical":
      total = (int)player->query_skill("medical", 1);
      break;
    case "tianfu":
      total = (int)player->query("str") + (int)player->query("cor") + (int)player->query("int") + (int)player->query("spi") + (int)player->query("cps") + (int)player->query("per") + (int)player->query("con") + (int)player->query("kar");
      break;
    case "unarmed":
      total = (int)player->query_skill("unarmed", 1);
      break;
    case "dodge":
      total = (int)player->query_skill("dodge", 1);
      break;
    case "sword":
      total = (int)player->query_skill("sword", 1);
      break;
    case "blade":
      total = (int)player->query_skill("blade", 1);
      break;
    case "stick":
      total = (int)player->query_skill("stick", 1);
      break;
    case "staff":
      total = (int)player->query_skill("staff", 1);
      break;
    case "whip":
      total = (int)player->query_skill("whip", 1);
      break;
    default:
      total = -1;  //用-1标志类型出错！
  }
  return total;
}

int topten_del(string pid, string type) {
  string str, *astr, *bstr, name, id, b_name, f_name;
  int i, j, k, money;
  switch (type) {
    case "exp":
      b_name = EXP_B;
      f_name = TOPTEN_EXP;
      break;
    case "daoheng":
      b_name = DAOHENG_B;
      f_name = TOPTEN_DAOHENG;
      break;
    case "level":
      b_name = LEVEL_B;
      f_name = TOPTEN_LEVEL;
      break;
    case "age":
      b_name = AGE_B;
      f_name = TOPTEN_AGE;
      break;
    case "rich":
      b_name = RICH_B;
      f_name = TOPTEN_RICH;
      break;
    case "force":
      b_name = FORCE_B;
      f_name = TOPTEN_FORCE;
      break;
    case "mana":
      b_name = MANA_B;
      f_name = TOPTEN_MANA;
      break;
    case "quests":
      b_name = QUESTS_B;
      f_name = TOPTEN_QUESTS;
      break;
    case "kill":
      b_name = KILL_B;
      f_name = TOPTEN_KILL;
      break;
    case "dead":
      b_name = DEAD_B;
      f_name = TOPTEN_DEAD;
      break;
    case "zhuzao":
      b_name = ZHUZAO_B;
      f_name = TOPTEN_ZHUZAO;
      break;
    case "task":
      b_name = TASK_B;
      f_name = TOPTEN_TASK;
      break;
    case "literate":
      b_name = LITERATE_B;
      f_name = TOPTEN_LITERATE;
      break;
    case "medical":
      b_name = MEDICAL_B;
      f_name = TOPTEN_MEDICAL;
      break;
    case "tianfu":
      b_name = TIANFU_B;
      f_name = TOPTEN_TIANFU;
      break;
    case "unarmed":
      b_name = UNARMED_B;
      f_name = TOPTEN_UNARMED;
      break;
    case "dodge":
      b_name = DODGE_B;
      f_name = TOPTEN_DODGE;
      break;
    case "sword":
      b_name = SWORD_B;
      f_name = TOPTEN_SWORD;
      break;
    case "blade":
      b_name = BLADE_B;
      f_name = TOPTEN_BLADE;
      break;
    case "stick":
      b_name = STICK_B;
      f_name = TOPTEN_STICK;
      break;
    case "staff":
      b_name = STAFF_B;
      f_name = TOPTEN_STAFF;
      break;
    case "whip":
      b_name = WHIP_B;
      f_name = TOPTEN_WHIP;
      break;
    default:
      return notify_fail("没有" + type + "这种排行榜！\n");
  }
  if (file_size(f_name) == -1)
    return notify_fail(b_name + "还没有创建！\n");
  str = read_file(f_name);
  astr = explode(str, "\n");
  for (i = 0; i < sizeof(astr); i++) {
    if (strsrch(astr[i], pid) != -1)  //该行包括id则为真
    {
      if (strsrch(astr[i], ";") == -1)  //为真表示该行只有一个id，即pid
      {
        str = "";
        for (j = 0; j < sizeof(astr); j++)
          if (j != i)
            str += astr[j] + "\n";
        return topten_save(f_name, b_name, str);
      } else {
        bstr = explode(astr[i], ";");
        for (j = 0; j < sizeof(bstr); j++)
          if (strsrch(bstr[j], pid) != -1)  //说明该项即pid,应该去除
          {
            astr[i] = "";
            for (k = 0; k < sizeof(bstr); k++)
              if (k != j) {
                if ((k + 1) != sizeof(bstr)
                  && !((j + 1) == sizeof(bstr) && j == (k + 1))
                )
                  astr[i] += bstr[k] + ";";
                else
                  astr[i] += bstr[k];
              }
            //本来去除后j的循环应该停止,但是不影响结果
          }
        str = implode(astr, "\n");
        return topten_save(f_name, b_name, str);
      }
    }
  }
  return 1;
}

int topten_add(object player, string type) {
  string str, name, id, str1, b_name, f_name;
  string *astr;
  int i, j, data;
  if (wizardp(player))  //禁止巫师参加排行榜
    return 0;
  switch (type) {
    case "exp":
      b_name = EXP_B;
      f_name = TOPTEN_EXP;
      break;
    case "daoheng":
      b_name = DAOHENG_B;
      f_name = TOPTEN_DAOHENG;
      break;
    case "level":
      b_name = LEVEL_B;
      f_name = TOPTEN_LEVEL;
      break;
    case "age":
      b_name = AGE_B;
      f_name = TOPTEN_AGE;
      break;
    case "rich":
      b_name = RICH_B;
      f_name = TOPTEN_RICH;
      break;
    case "force":
      b_name = FORCE_B;
      f_name = TOPTEN_FORCE;
      break;
    case "mana":
      b_name = MANA_B;
      f_name = TOPTEN_MANA;
      break;
    case "quests":
      b_name = QUESTS_B;
      f_name = TOPTEN_QUESTS;
      break;
    case "kill":
      b_name = KILL_B;
      f_name = TOPTEN_KILL;
      break;
    case "dead":
      b_name = DEAD_B;
      f_name = TOPTEN_DEAD;
      break;
    case "zhuzao":
      b_name = ZHUZAO_B;
      f_name = TOPTEN_ZHUZAO;
      break;
    case "task":
      b_name = TASK_B;
      f_name = TOPTEN_TASK;
      break;
    case "literate":
      b_name = LITERATE_B;
      f_name = TOPTEN_LITERATE;
      break;
    case "medical":
      b_name = MEDICAL_B;
      f_name = TOPTEN_MEDICAL;
      break;
    case "tianfu":
      b_name = TIANFU_B;
      f_name = TOPTEN_TIANFU;
      break;
    case "unarmed":
      b_name = UNARMED_B;
      f_name = TOPTEN_UNARMED;
      break;
    case "dodge":
      b_name = DODGE_B;
      f_name = TOPTEN_DODGE;
      break;
    case "sword":
      b_name = SWORD_B;
      f_name = TOPTEN_SWORD;
      break;
    case "blade":
      b_name = BLADE_B;
      f_name = TOPTEN_BLADE;
      break;
    case "stick":
      b_name = STICK_B;
      f_name = TOPTEN_STICK;
      break;
    case "staff":
      b_name = STAFF_B;
      f_name = TOPTEN_STAFF;
      break;
    case "whip":
      b_name = WHIP_B;
      f_name = TOPTEN_WHIP;
      break;
    default:
      return notify_fail("没有" + type + "这种排行榜！\n");
  }
  if (!objectp(player) || !userp(player))
    return 0;
  //snowtu 2011
  if (get_all_data(player, type) <= 0) {
    if (get_all_data(player, type) != -1)
      topten_del(player->query("id"), type);
    return 0;
  }
  if (file_size(f_name) == -1) {
    str = "(" + player->query("id") + ")" + get_all_data(player, type);
    return topten_save(f_name, b_name, str);
  }
  //主要程序！
  if (get_all_data(player, type) == -1)
    return notify_fail("数据查询错误，可能是查询类型错误！\n");
  //应该先排除该player的id!
  topten_del(player->query("id"), type);
  str = read_file(f_name);
  astr = explode(str, "\n");
  i = 0;
  while (i < sizeof(astr)) {
    if (sscanf(astr[i], "(%s)%d", id, data) != 2)
      if (astr && sscanf(astr, "(%s)%d;%*s", id, data) != 2)
        return notify_fail(b_name + "文件数据错误！请呼叫巫师！\n");
    str = "";
    if (data < (int)get_all_data(player, type)) {
      //单独加入，暂时没考虑人数超过十行！
      for (j = 0; j < sizeof(astr); j++) {
        if (j == i)
          str += "(" + player->query("id") + ")" + get_all_data(player, type) + "\n";
        str += astr[j] + "\n";
      }
      return topten_save(f_name, b_name, str);
    } else if (data == (int)get_all_data(player, type)) {
      //并排加入
      for (j = 0; j < sizeof(astr); j++) {
        if (j == i)
          str += astr[j] + ";" +
            "(" + player->query("id") + ")" + get_all_data(player, type) + "\n";
        else
          str += astr[j] + "\n";
      }
      return topten_save(f_name, b_name, str);
    }
    i++;
  }
  if (sizeof(astr) < 10) {
    str = implode(astr, "\n") + "\n" + "(" + player->query("id") + ")" + get_all_data(player, type);
    return topten_save(f_name, b_name, str);
  }
  return 0;
}
