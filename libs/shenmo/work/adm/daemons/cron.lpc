// TIEYU@FY3
// This is a daemon that calls itself every minte. it checks
// all major daemons to make sure that they are up and running.
#include <ansi.h>
#include <command.h>
#include <globals.h>
#include <net/daemons.h>
#include <net/macros.h>

nosave int update = 0;
int LAST_HARD_DIS= 0;
void init_cron();

void create()
{
seteuid( ROOT_UID );
init_cron();
}

int query_last_hard_dis()
{
return LAST_HARD_DIS;
}

int set_last_hard_dis()
{
LAST_HARD_DIS = time();
return time();
}

void init_cron()
{
mixed *local;
local = localtime(time());

if ( !random(60)) 
        TASK_D->init_dynamic_quest();
if ( !((local[1])%31))
        {
        if ( !update )
                {
                message("system","100"+NOR+HIR"【西游记--神魔传说】将在五分钟后重新分布task！\n\n" NOR,users() );
                update++;               
                remove_call_out("countdown");
                call_out("countdown", 60, 5);
                }
        }
remove_call_out("init_cron");   
call_out("init_cron", 60);
}

