// object.c

varargs int getoid(object ob) {
  int id;

  if (!ob) ob = previous_object();
  sscanf(file_name(ob), "%*s#%d", id);
  return id;
}

// Get the owner of a file.  Used by log_error() in master.c.
string file_owner(string file) {
  string name, rest;

  if (file[0] != '/') {
    file = "/" + file;
  }
  // Only the FIRST segment after /u/ is the wizard's name, regardless of
  // how deeply nested the file is (/u/<wizard>/<any/number/of/subdirs>/x) --
  // matching domain_file()'s own first-segment-only discipline below.
  // A fixed-depth 3-%s match here (see AGENTS.md §7.26) misattributes
  // every file nested more than one level under /u/<wizard>/ to whatever
  // its first subdirectory happens to be named, and log_error() then
  // tries to write into a nonexistent /u/<subdir>/ log path.
  if (sscanf(file, "/u/%s/%s", name, rest) == 2) {
    return name;
  }
  return 0;
}

// domain_file should return the domain associated with a given file.
string domain_file(string file) {
  string domain;

  if (sscanf(file, "/d/%s/%*s", domain))
    return domain;

  return ROOT_UID;
}

// creator_file should return the name of the creator of a specific file.
string creator_file(string file) {
  string *path;

  path = explode(file, "/") - ({ 0 });
  switch (path[0]) {
    case "adm":
      if (file == SIMUL_EFUN_OB) return "MudOS";
      else return ROOT_UID;
    case "cmds":
      return ROOT_UID;
    case "u":
      if (sizeof(path) >= 4) return path[2];
    case "d":
    case "open":
    case "ftp":
      if (sizeof(path) >= 3) return path[1];
    default:
      if (this_player(1))
        return getuid(this_player(1));
      else
        return "MudOS";
  }
}

// author_file should return the name of the author of a specific file.
string author_file(string file) {
  string name;

  if (sscanf(file, "/u/%*s/%s/%*s", name))
    return name;
  return ROOT_UID;
}


// added by xuy. 
int living(object ob) {
  if (!ob) return 0;
  if (ob && (ob->query_temp("disabled") && !ob->query_temp("disabled_living")))
    return 0;
  return efun::living(ob);
}

void destruct(object ob) {
  if (ob) {
    if (previous_object()) ob->remove(geteuid(previous_object()));
    else ob->remove(0);
  }

  efun::destruct(ob);
}

// addn: compatibility shim for a driver efun this build doesn't have.
// Delegates to feature/dbase.lpc's own add(), matching the established
// fix pattern for this bug class (AGENTS.md §7.79/§7.79-variant).
varargs mixed addn(string prop, mixed data, object ob) {
  if (!ob) ob = this_object();
  return ob->add(prop, data);
}

// check the object's euid wehter is root
int is_root(mixed ob) {
  if (stringp(ob))
    return (SECURITY_D->get_status(ob) == "(admin)");

  if (objectp(ob)) {
    if (geteuid(ob) == ROOT_UID)
      // Root object want to execute
      return 1;

    return (SECURITY_D->get_status(geteuid(ob)) == "(admin)");
  }

  return 1;
}
