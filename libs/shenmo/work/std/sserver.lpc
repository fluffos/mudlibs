#include <ansi.h>
inherit F_CLEAN_UP;

nosave string pfm_name = "此外功";

int valid_pfm(object me);

// This function selects a random target for offensive spells/functions.
object offensive_target(object me)
{
int sz;
object *enemy;
object victim;

        // mon 4/28/99
        // clean_up my enemy before selecting a target.
me->clean_up_enemy();

enemy = me->query_enemy();
if( !enemy || !arrayp(enemy) ) 
        return 0;

sz = sizeof(enemy);
if( sz > 4 ) 
        sz = 4;
if( sz > 0 ) 
        victim=enemy[random(sz)];
else    return 0;
        
if ( !victim ) 
        return 0;

if ( victim->query_temp("netdead") )
        {
        if( member_array( me, victim->query_netdead_enemy() ) == -1 )
                return 0; // can't start fight if the 
                        //victim is already netdead
        }
if ( userp(victim) && userp(me) )
        {       
        if ( !environment(victim)->query("alternative_die")  //不死地
          && !victim->query_condition("no_pk_time") )   //杀人犯        
                return 0;
        }
return victim;
}

void set_pfm_name(string name)
{
pfm_name = name;
}       

string query_pfm_name()
{
return pfm_name;
}

//add by snowtu for 个别pfm文件没有定义int valid_perform(object me,object target)导致dzxy出差哦
varargs int valid_perform(object me,object target)
{
     return notify_fail("这一式不支持斗转星移。\n");
}
