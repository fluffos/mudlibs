//snowtu 2007
#include <ansi.h>
#include <weapon.h>
inherit M_WEAPON;

void destrory(object ob) {
  if (ob)
    destruct(ob);
}

int check_owner(object me) {
  string w_name, w_id, w_or;
  int w_lv, i, *lvs;
  mapping temp;

  if (!me || !me->query("weapon/name")) {
    remove_call_out("destrory");
    call_out("destrory", 1, this_object());
    return 0;
  }
  //读入数据
  w_name = me->query("weapon/name");
  w_id = me->query("weapon/id");
  w_or = me->query("weapon/or");
  //w_lv = me->query("weapon/lv");
  w_lv = 0;
  temp = me->query("weapon/type");
  lvs = values(temp);
  for (i = 0; i < sizeof(lvs); i++)
    w_lv += lvs[i];
  w_lv /= sizeof(lvs);

  set("owner_id", me->query("id"));
  set_desc(w_lv, w_or, w_name);
  if (!query("unit"))
    set("unit", "把");
  set("wield_msg", HIY "$N" HIY "凌空一握，手中由虚变实的赫然现出一把" + HIR "" + w_name + NOR HIY "。\n" NOR);
  set("unwield_msg", HIY "$N" HIY "手中" + HIR "" + w_name + NOR HIY "一抖，眨眼间已然不见影踪。\n" NOR);

  switch (w_or) {
    case "千年神木":
      set_weight(500);
      set("material", "wood");
      break;
    case "海底金母":
      set_weight(1000);
      set("material", "steel");
      break;
    default:
      set_weight(300);
      set("material", "bamboo");
      break;
  }
  return 1;
}

void create() {
  if (!check_owner(this_player())) {
    set_name("自制武器", ({ "owner weapon", "weapon" }));
    set("unit", "件");
  }
  set("no_get", 1);
  set("no_give", 1);
  set("nopawn", 1);
  set("zizhi", 1);
  set("value", 0);
  setup();
}
