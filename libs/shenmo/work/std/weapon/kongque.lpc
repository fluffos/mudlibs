//creat by focus

#include <weapon.h>
#include <ansi.h>
inherit YUMAO;
void create()
{
            set_name("孔雀翎", ({"kongque ling","ling","mao","yu","yumao"}));
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("long", "一根五彩斑斓的孔雀毛。\n");
                set("value", 10000);
 //             set("material", "crimsonsteel");
                set("wield_msg","$N小心翼翼的从耳边掏出一根$n握在手中，很是威风。。。。\n");
                set("unwield_msg","$N小心翼翼的将$n插在耳边。\n");
              }
        
            init_yumao(160);
        setup();
}
