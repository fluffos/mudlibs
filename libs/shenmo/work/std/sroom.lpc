//sroom.c

#pragma save_binary
#include <dbase.h>
inherit F_DBASE;
inherit F_CLEAN_UP;

#define DOOR_CLOSED		1
#define DOOR_LOCKED		2
#define DOOR_SMASHED		4

nosave mapping doors;
varargs int close_door(string dir, int from_other_side);
varargs int open_door(string dir, int from_other_side);
mapping query_doors();

int query_max_encumbrance() { return 100000000000; }
int query_max_items() { return 50; }
void reset_msg() { return; }

object make_inventory(string file) {
  object ob;
  ob = new(file);
  ob->move(this_object());
  ob->set("startroom", base_name(this_object()));
  return ob;
}

void reset() {
  mapping exits, tempExits;
  mapping ob, ob_list, doors;
  string *list, *dirs;
  int i, j;
  object *inv;
  inv = all_inventory();
  /***************************************
**  删去ROOM中无用的存在              **
**  保留：                            **
**  容器,非get品,尸体                 **
**  任务NPC                           **
***************************************/
  for (i = sizeof(inv) - 1; i >= 0; i--) {
    if (inv[i]->is_character()) continue;  //容器
    if (inv[i]->query("no_get")) continue;  //不能get
    if (inv[i]->is_corpse()) continue;  //尸体
    if (inv[i]->query("任务")) continue;  //任务NPC
    if (userp(inv[i])) continue;  //player
    destruct(inv[i]);
  }
  exits = query("exits");
  if (!mapp(exits)) return;
  tempExits = query_temp("exits");
  if (mapp(tempExits)) {
    list = keys(tempExits);
    i = sizeof(list);
    while (i--)
      delete("exits/" + list[i]);
  }
  reset_msg();

  set("no_clean_up", 0);
  ob_list = query("objects");
  if (!mapp(ob_list)) return;

  if (!mapp(ob = query_temp("objects")))
    ob = allocate_mapping(sizeof(ob_list));
  list = keys(ob_list);
  for (i = 0; i < sizeof(list); i++) {
    if (undefinedp(ob[list[i]])
      && intp(ob_list[list[i]])
      && ob_list[list[i]] > 1)
      ob[list[i]] = allocate(ob_list[list[i]]);

    switch (ob_list[list[i]]) {
      case 1:
        if (!ob[list[i]])
          ob[list[i]] = make_inventory(list[i]);
        if (environment(ob[list[i]]) != this_object()
          && ob[list[i]]->is_character()
          && !ob[list[i]]->query("任务")) {
          if (!ob[list[i]]->return_home(this_object()))
            add("no_clean_up", 1);
        }
        break;
      default:
        for (j = 0; j < ob_list[list[i]]; j++) {
          if (!objectp(ob[list[i]][j])) {
            ob[list[i]][j] = make_inventory(list[i]);
            continue;
          }
          if (environment(ob[list[i]][j]) != this_object()
            && ob[list[i]][j]->is_character()
            && !ob[list[i]]->query("任务")) {
            if (!ob[list[i]][j]->return_home(this_object()))
              add("no_clean_up", 1);
          }
        }
    }
  }
  set_temp("objects", ob);

  doors = query_doors();
  if (!mapp(doors)) return;
  else {
    dirs = keys(doors);
    for (i = 0; i < sizeof(dirs); i++) {
      if (stringp(doors[dirs[i]]["name"]))
        close_door(dirs[i], 0);
    }
  }
}

//障碍物或是门
string look_door(string dir) {
  string str;
  if (!mapp(doors) || undefinedp(doors[dir]))
    return "你要看什么？\n";

  if (doors[dir]["status"] & DOOR_CLOSED
    || doors[dir]["status"] & DOOR_LOCKED)
    return "一个" + doors[dir]["name"] + "挡住了去路。\n";
  else {
    if (doors[dir]["type"] == "door")
      str = "是开着的。\n";
    else str = "歪斜在路边。\n";
    return "这个方向的" + doors[dir]["name"] + str;
  }
}

varargs int open_door(string dir, int from_other_side) {
  int i;
  string door;
  mapping exits;
  object ob;

  if (!mapp(doors) || undefinedp(doors[dir]))
    return notify_fail("这个方向没有障碍物。\n");

  if (doors[dir]["type"] != "door")
    door = "已经给人搬开";
  else door = "已经开着的";
  if (!(doors[dir]["status"] & DOOR_CLOSED)
    && !(doors[dir]["status"] & DOOR_LOCKED))
    return notify_fail(doors[dir]["name"] + door + "了。\n");

  exits = query("exits");
  if (!mapp(exits) || undefinedp(exits[dir]))
    error("Room: open_door: attempt to open a door with out an exit.\n");

  if (doors[dir]["status"] & DOOR_CLOSED
    || doors[dir]["status"] == DOOR_LOCKED) {
    if (stringp(doors[dir]["owner"])
      && this_player()->query_temp("japan/openDoor") != doors[dir]["owner"]) {
      if (from_other_side)
        message("vision", doors[dir]["name"] + "摇了两摇，又没动静了。\n", this_object());
      else message(
        "vision",
        this_player()->name() + "拼命敲了敲" + doors[dir]["name"] + "，可惜没反应。\n",
        this_object(),
        this_player()
      );
      return notify_fail("看来你现在打不开" + doors[dir]["name"] + "。\n");
    }

    if (doors[dir]["type"] != "door")
      door = "搬";
    else door = "打";
    if (from_other_side)
      message("vision", "有人从另一边将" + doors[dir]["name"] + door + "开了。\n", this_object());
    else if (objectp(ob = find_object(exits[dir]))) {
      if (!ob->open_door(doors[dir]["other_side_dir"], 1))
        return 0;
    }
    if (doors[dir]["status"] == DOOR_CLOSED)
      doors[dir]["status"] &= (!DOOR_CLOSED);
    else doors[dir]["status"] &= (!DOOR_LOCKED);
    return 1;
  }
}

varargs int close_door(string dir, int from_other_side) {
  string door;
  mapping exits;
  object ob;

  if (doors[dir]["type"] != "door")
    door = "障碍物";
  else door = "门";
  if (!mapp(doors) || undefinedp(doors[dir]))
    return notify_fail("这个方向没有" + door + "。\n");

  if (doors[dir]["type"] != "door")
    door = "挡住路";
  else door = "关着的";
  if (doors[dir]["status"] == DOOR_CLOSED
    || doors[dir]["status"] == DOOR_LOCKED)
    return notify_fail(doors[dir]["name"] + door + "了。\n");

  exits = query("exits");
  if (!mapp(exits) || undefinedp(exits[dir]))
    error("Room: close_door: attempt to open a door with out an exit.\n");

  if (doors[dir]["status"] != DOOR_CLOSED
    && doors[dir]["status"] != DOOR_LOCKED) {
    if (doors[dir]["type"] != "door")
      door = "搬在了路中间。\n";
    else door = "关上了。\n";
    if (from_other_side)
      message("vision", "有人从另一边将" + doors[dir]["name"] + door, this_object());
    else if (objectp(ob = find_object(exits[dir]))) {
      if (!ob->close_door(doors[dir]["other_side_dir"], 1))
        return 0;
    }
    if (doors[dir]["status"] == DOOR_CLOSED)
      doors[dir]["status"] |= DOOR_CLOSED;
    else doors[dir]["status"] |= DOOR_LOCKED;
    return 1;
  }
}

int check_door(string dir, mapping door) {
  if (!mapp(doors) || undefinedp(doors[dir])) return 1;
  door["status"] = doors[dir]["status"];
  return 1;
}

/*********************************************
**  举例                                    **
**      create_door("south","door",         **
**                  "木门","north",         **
**                  DOOR_CLOSED,"owner");           **
*********************************************/
varargs void create_door(string dir, string type, string name,
  string other_side_dir, int status, string owner) {
  mapping d, exits, item_desc;
  object ob;

  if (!stringp(type))
    type = "door";

  exits = query("exits");
  if (!mapp(exits) || undefinedp(exits[dir]))
    error("Room: create_door: attempt to create a door without exit.\n");

  if (!stringp(name))
    name = "大门";

  d = allocate_mapping(7);
  d["name"] = name;
  d["id"] = ({ dir, name, "door" });
  d["other_side_dir"] = other_side_dir;
  d["exit"] = dir;
  d["status"] = status;
  d["type"] = type;
  d["owner"] = owner;

  set("item_desc/" + dir, (: look_door, dir :));

  if (objectp(ob = find_object(exits[dir]))) {
    if (!ob->check_door(other_side_dir, d))
      return;
  }
  if (!mapp(doors)) doors = ([ dir: d ]);
  else doors[dir] = d;
}

mapping query_doors() { return doors; }

mixed query_door(string dir, string prop) {
  if (!mapp(doors) || undefinedp(doors[dir])) return 0;
  else return doors[dir][prop];
}

int valid_leave(object me, string dir) {
  string str;

  if (mapp(doors) && !undefinedp(doors[dir])) {
    if (doors[dir]["status"] & DOOR_CLOSED
      || doors[dir]["status"] & DOOR_LOCKED) {
      if (!userp(me)) {
        me->command("open " + doors[dir]["name"]);
        if (!(doors[dir]["status"] & DOOR_CLOSED))
          return 1;
      }
      if (doors[dir]["type"] != "door")
        str = "搬开！\n";
      else str = "打开！\n";
      return notify_fail(
        "你必须先把" + doors[dir]["name"] + str);
    }
  }
  return 1;
}

void setup() {
  string file, msg = "\n";
  if (stringp(file = query("map")))
    msg = read_file("/d/圣斗士/room/map/" + file + ".map");
  set("long", msg);
  seteuid(getuid());
  this_object()->reset();
}
