// thousand.c

inherit MONEY;

void create()
{
        set_name("一百美金", ({"meijin", "meijin_money"}));
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("money_id", "meijin");
                set("long", "一张面值为一百美金的钞票。\n");
                set("unit", "张");
		set("base_value", 800000);
		set("base_unit", "张");
		set("base_weight", 3);
	}
	set_amount(1);
}

