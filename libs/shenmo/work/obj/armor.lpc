string query_name() {
  return "特殊防具(+技能)";
}
string query_save_file() {
  if (!query("owner_id") || !stringp(query("owner_id")))
    return 0;
  return sprintf(
    "/c/data/armor/%c/%s/%s",
    query("owner_id")[0],
    query("owner_id"),
    query("armor_type")
  );
}

int query_max_exp() {
  int max_exp, lvl = query("armor_level");
  if (lvl <= 0) max_exp = 0;
  if (lvl < 10) max_exp = 500;
  else if (lvl < 50) max_exp = 5000;
  else if (lvl < 100) max_exp = 50000;
  else if (lvl < 200) max_exp = 500000;
  else max_exp = 5000000;
  return max_exp;
}

void leave() {
  remove_call_out("leave");
  write("\n" + this_object()->name() + HIY "化作一道金光冲天而去。\n\n" NOR);
  destruct(this_object());
}

void _leave() {
  call_out("leave", 2 + random(5));
}

void check_owner() {
  object ob = this_object();
  object env = environment();
  if (env) {
    if (env->is_character()) {
      if (!userp(env)) {
        if (!env->query("任务"))
          _leave();
      } else {
        if (query("owner_id") && query("owner_id") != env->query("id"))
          _leave();
      }
    } else {
      if (query("owner_id"))
        _leave();
    }
  }
  return;
}

int save() {
  object who;
  who = environment();
  if (!who)
    return 0;
  if (!userp(who))
    return 0;
  if (!who->query("new_armor/" + query("armor_type")))
    who->set("new_armor/" + query("armor_type"), short2());
  else if (who->query("new_armor/" + query("armor_type")) != short2()) {
    tell_object(who, "你已有了相同类型的装备了。\n");
    return 0;
  }
  return ::save();
}

int do_save(string arg) {
  object me = this_player();
  if (!arg || !id(arg))
    return 0;
  if (me != environment())
    return 0;
  if (query("owner_id") || query("saved")) {
    write(name() + "已经被" + (stringp(query("owner_id")) ? query("owner_id") : "") + "保存过了。\n");
    return 1;
  }
  if (query("equipped")) {
    write("你必须先将" + name() + "卸下。\n");
    return 1;
  }
  if ((me->query("potential") - me->query("learned_points")) < 1000) {
    write("你的潜能不够,无法保存法宝。\n");
    return 1;
  }
  set("owner_id", me->query("id"));
  set("saved", 1);
  if (save()) {
    set("no_give", 1);
    me->add("learned_points", 1000);
    write(name() + "作为你的专属防具保存成功。\n");
    return 1;
  }
  write("你似乎难以驾御" + name() + "。\n");
  delete("no_give");
  delete("owner_id");
  delete("saved");
  return 1;
}

int do_dest(string arg) {
  object me = this_player();
  if (!arg || !id(arg))
    return 0;
  if (me != environment())
    return 0;
  if (!query("saved")) {
    write(name() + "是无主的防具。\n");
    return 1;
  }
  if (query("owner_id")
    && me->query("id") != query("owner_id")) {
    write(name() + "是" + query("owner_id") + "的专属防具。\n");
    return 1;
  }
  if ((me->query("potential") - me->query("learned_points")) < 1000) {
    write("你的潜能不够,无法注销法宝。\n");
    return 1;
  }
  me->add("learned_points", 1000);
  if (!("cmds/wiz/rm.lpc")->main(this_object(), query_save_file() + ".o")) {
    write("注销失败。\n");
    return 1;
  }
  write("注销成功。\n");
  me->delete("new_armor/" + this_object()->query("armor_type"));
  me->save();
  message_vision("$N随手将$n当垃圾般丢开。。。。\n", me, this_object());
  destruct(this_object());
  return 1;
}

int restore() {
  if (!::restore())
    return 0;
  set("saved", 1);
  set_name(query("names"), query("ids"));
  setup();
  return 1;
}

void init() {
  check_owner();
  add_action("do_save", "save");
  add_action("do_dest", "destruct");
  //add_action("do_promote","promote");
}


string random_code() {
  string *str = ({
    HIY "金", HIG "木", HIG "水", HIR "火", YEL "土", HIB "雷", HIC "电",
    BLU "影", HIW "风", HIC "日", WHT "月", HIM "神", HIB "鬼", HIY "圣"
  });
  return NOR + str[random(sizeof(str))] + NOR;
}

void create() {
  string name, *names, id, *ids, name2;
  string *a_t, type, unit, *tmp, ad;
  mixed temp;
  int p, we, i, k, lvl;

  names = keys(nn);
  name = names[random(sizeof(names))];
  id = nn[name];

  a_t = keys(a_types);
  type = a_t[random(sizeof(a_t))];
  id = id + " " + a_types[type][0];
  ids = ({ id, a_types[type][0], type });
  name2 = a_types[type][1][random(sizeof(a_types[type][1]))];
  name = name + name2;
  unit = a_types[type][2];
  p = a_types[type][3];

  set("armor_type", type);
  set("flag", 2);
  set("unit", unit);
  set("value", 0);
  lvl = random(5) + 1;
  set("armor_level", lvl);
  p += random(p);
  p += (random(lvl) + 1) * 3;
  set("armor_prop/armor", p);
  set_weight(p / 5 + random(p));
  i = random(p / 2) + p / 3;
  if (i > 200) i = 200;
  tmp = ({
    "axe", "blade", "dagger", "dodge", "force", "fork", "hammer",
    "literate", "mace", "magic", "parry", "rake", "spear",
    "spells", "staff", "stick", "sword", "stealing", "throwing",
    "unarmed", "whip",
  });
  if (random(3)) {
    ad = tmp[random(sizeof(tmp))];
    set("armor_prop/ad_" + ad, 1 + random(i) - random(i / 2));
    if (query("armor_prop/ad_" + ad) == 0)
      delete("armor_prop/ad_" + ad);
  }
  set_name(name, ids);
  set("ids", ids);
  set("names", name);
  set("防具类型", name2);
  set("code", random_code());
  set("no_put", 1);
  setup();
}

string short2() {
  return ::short() + NOR "(" + query("code") + ")";
}

string short() {
  string *temp, str = short2();
  int i;
  temp = ({
    "axe", "blade", "dagger", "dodge", "force", "fork", "hammer",
    "literate", "mace", "parry", "rake", "spear",
    "spells", "staff", "stick", "sword", "stealing", "throwing",
    "unarmed", "whip",
  });
  for (i = 0; i < sizeof(temp); i++) {
    if (query("armor_prop/ad_" + temp[i]) != 0)
      str += "(" HIY + to_chinese(temp[i]) + NOR + HIR + (query("armor_prop/ad_" + temp[i]) > 0 ? "+" : "") + query("armor_prop/ad_" + temp[i]) + NOR ")";
  }
  return str;
}

string check_data() {
  object env;
  string *da, tmp, str, need;
  int i, flag = 0;
  mapping data;
  env = environment();
  if (!env || !userp(env))
    return "          隐藏";
  str = "";
  data = query("armor_prop");
  if (data && mapp(data)) {
    da = keys(data);
    for (i = 0; i < sizeof(da); i++) {
      if (sscanf(da[i], "ad_%s", tmp)) {
        if (file_size(SKILL_D(tmp) + ".lpc") > 0)
          str += "          " + to_chinese(tmp) + (data["ad_" + tmp] > 0 ? "+" : "") + data["ad_" + tmp] + "\n";
        /*                        else    {
                                if ( !s_ad[tmp] )
                                        continue;
                                str+= "          "+s_ad[tmp];
                                need = query("need_obj/ad_"+tmp);
                                if ( !need || !stringp(need) )
                                        str+= "\n";
                                else    str+= NOR HIR" <需要"NOR+SDS_D->no_color_msg(need)+NOR HIR"激活>\n"NOR;
                                }
*/
        flag++;
      } else continue;
    }
  }
  if (!flag)
    str = "          --";
  return str;
}

string long() {
  object who;
  int i, flag = 0;
  string *tmp, type, msg, str;
  mapping his = query_entire_dbase();

  i = this_object()->query_weight();
  if (i < 1000)
    str = "灵巧";
  else if (i < 5000)
    str = "坚实";
  else str = "沉重";
  msg = sprintf(
    "    这是一%s%s属性的%s的%s。%s\n",
    his["unit"],
    his["code"],
    str,
    his["name"],
    his["long"] ? his["long"] : ""
  );
  msg += "如果你想让它变成你的专属防具，可以保存它的记录(save <id>)。\n";
  msg += "另外你可以注销(destruct)或升级(promote)已记录的防具。\n";
  msg += sprintf("防具类别：%s\n", his["防具类型"]);
  msg += sprintf("防具等级：%d/255\n", his["armor_level"]);
  msg += sprintf("防具经验：%d/%d\n", his["level_exp"], query_max_exp());
  msg += sprintf("防具所属: %s\n", query("owner_id") ? query("owner_id") : "--");
  msg += sprintf("防具防御: %d\n", his["armor_prop"]["armor"]);
  msg += sprintf("附加属性: \n%s", check_data());
  return msg;
}

int is_zhaohuan() {
  return 1;
}

//增加特别效果
varargs void level_up2(object who) {
  object need;
  string *temp, tmp;
  int i;
  if (!who || !userp(who))
    return;
  if (random(10) && !wizardp(who) && !who->query("env/test"))
    return;
  temp = keys(s_ad);
  tmp = temp[random(sizeof(temp))];
  if (query("armor_prop/ad_" + tmp))
    return;
  for (i = 0; i < sizeof(temp); i++) {
    if (query("armor_prop/ad_" + temp[i]))
      return;
  }
  i = query("armor_level") / 5;
  i = random(i);
  if (!i)
    return;
  set("armor_prop/ad_" + tmp, i);
  if (random(10)) {
    need = new("/obj/armor");
    if (!need)
      error("特殊防具文件缺少!!\n");
    set("need_obj/ad_" + tmp, need->short());
    destruct(need);
  }
}
