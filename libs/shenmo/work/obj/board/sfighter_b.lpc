// moon_b.c

inherit BULLETIN_BOARD;

void create()
{
        set_name("格斗家交流板", ({ "board" }) );
      set("location", "/d/sfighter/pianting");
        set("board_id", "sfighter_b");
        set("long",     "格斗家交流板。\n" );
set("capacity", 80);
        setup();
        replace_program(BULLETIN_BOARD);
}

