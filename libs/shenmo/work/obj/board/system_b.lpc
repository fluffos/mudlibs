// wizard_b.c
#include <ansi.h>
inherit BULLETIN_BOARD;

void create() {
  set_name(HBMAG + HIW "画皮" NOR, ({ "board" }));
  set("location", "/d/wiz/system");
  set("board_id", "system_b");
  set("long",
    "这是一个专门公告系统资讯的板子，只有巫师能 post。\n");
  setup();
  set("capacity", 150);
  replace_program(BULLETIN_BOARD);
}
