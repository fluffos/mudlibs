// newbie_b.c

inherit BULLETIN_BOARD;
#include <ansi.h>

void create() {
  set_name(HIR "武功法术发展留言版" NOR, ({ "board" }));
  set("location", "/d/wiz/entrance3");
  set("board_id", "newbie_b");
  set("long",
    "这是一个专门讨论武功法术发展的版子，有关perform和cast等的问题可以在此 post。\n");
  setup();
  set("capacity", 150);
}
