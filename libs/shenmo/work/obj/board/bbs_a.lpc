#include "ansi.h"
inherit BBS_BOARD;

void create() {
  set_name("西游记--神魔传说" + HIG + " BBS " + NOR + "留言板", ({ "board" }));
  set("location", "/d/wiz/entrance");
  set("board_id", "bbs_a");
  set("long", "这是一个供各位交流讨论的" + HIG + " BBS " + NOR + "板。\n");
  setup();
  set("capacity", 500);
  replace_program(BBS_BOARD);
}
