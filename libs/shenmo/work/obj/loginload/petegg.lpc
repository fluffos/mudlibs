inherit ITEM;
#include <ansi.h>
#include <login.h>
void need_food(object egg, object me);
int do_food(string arg);
void check_owner();
void dismiss(object egg);

string *col = ({ RED "", GRN "", YEL "", BLU "", MAG "", CYN "", WHT "",
  HIR "", HIG "", HIY "", HIB "", HIM "", HIC "", HIW "",
  HBRED "", HBGRN "", HBYEL "", HBBLU "", HBMAG "", HBCYN "", HBWHT "", BRED "",
  BYEL "", BBLU "", BMAG "", BCYN "",
});


/*----------------------土属性---------------------*/
string *tu_name = ({
  "土女蝠", "tunv fu", "fu",
  "胃土雉", "weitu zhi", "zhi",
  "柳土獐", "liutu zhang", "zhang",
  "氏土貉", "shitu he", "he",
});
/*----------------------风属性---------------------*/
string *feng_name = ({
  "角木蛇", "jiaomu she", "she",
  "斗木豸", "doubu zhi", "zhi",
  "奎木狼", "kuimu lang", "lang",
  "升木犴", "shengmu an", "an",
});
/*----------------------火属性---------------------*/
string *huo_name = ({
  "尾火虎", "weihuo hu", "hu",
  "室火猪", "shihuo zhu", "zhu",
  "嘴火猴", "zuihuo hou", "hou",
  "翼火蛇", "yihuo she", "she",
});
/*----------------------雷属性---------------------*/
string *lei_name = ({
  "牛金牛", "niujin niu", "niu",
  "鬼金羊", "guijin yang", "yang",
  "娄金狗", "loujin gou", "gou",
  "亢金龙", "kanjin long", "long",
});
/*----------------------水属性---------------------*/
string *shui_name = ({
  "箕水豹", "jishui bao", "bao",
  "璧水崳", "bishui yu", "yu",
  "叁水猿", "sanshui yuan", "yuan",
  "轸水蚓", "zhenshui yin", "yin",
});
/*----------------------光属性---------------------*/
string *light_name = ({
  "昂日鸡", "angri ji", "ji",
  "虚日鼠", "xuri shu", "shu",
  "房日兔", "fangri tu", "tu",
});
/*----------------------谙属性---------------------*/
string *dark_name = ({
  "毕月乌", "biyue wu", "wu",
  "危月燕", "weiyue yan", "yan",
  "心月狐", "xinyue hu", "hu",
  "张月鹿", "zhangyue lu", "lu",
});
/*-------------------属     性---------------------*/
string *shuxing = ({
  "土", "风", "火", "雷", "水", "光",
});

void create() {
  set_name(col[random(sizeof(col))] + "幻兽の卵" NOR, ({ "egg" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", col[random(sizeof(col))] + "一个散发着奇异的霞光的蛋。\n" NOR);
    set("unit", "个");
    set("value", 0);
    set("no_give", 1);
    set("no_get", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("no_steal", 1);
  }
  setup();
}

void init() {
  check_owner();
  add_action("do_food", "food");
}

int query_autoload() { return 1; }

void check_owner() {
  object egg = this_object();
  object me = environment(egg);

  if (egg->query("id") != "egg")
    return;

  if (!userp(me))
    dismiss(egg);

  if (me->is_corpse()
    || egg->query("owner") != me->query("id")) {
    me = find_player(egg->query("owner"));
    if (!me) return;
    if (me->query("huanshou"))
      dismiss(egg);
    egg->move(me);
    me->save();
    tell_object(HIG "忽然从天上落下一些东西掉进了你的背包。\n");
    return;
  }
  return;
}

void dismiss(object egg) {
  message_vision(HIG "$N啪的一声碎成八瓣，掉在地上不见了。\n" NOR, egg);
  destruct(egg);
  return;
}

int do_food(string arg) {
  int i, rev;
  string name, hs_name, msg, sx, id, id2;
  object hs, egg, me;
  egg = this_object();
  me = this_player();

  if (!living(me) || arg != "egg" || me != environment(egg))
    return 0;

  if (me->query("huanshou")) {
    message("wiz", me->query("name") + "得到了多余的egg,请联系查看。\n", users());
    tell_object(me, "你已经有幻兽了！\n");
    egg->set_name(me->query("name") + "多得的幻兽蛋", ({ "error egg" }));
    egg->set("no_drop", 0);
    me->command("drop error egg");
    return 1;
  }

  if (me->query("sen") < 100)
    return notify_fail("你还是先休息休息吧。\n");

  if (egg->query("grow") >= 20) {
    msg = "幻兽蛋啪的一声，终于孵化了！\n";
    switch (random(10)) {
      case 1:
        me->set("shuxing", "暗黑");
        break;
      default: {
        sx = shuxing[random(sizeof(shuxing))];
        if (!sx) return notify_fail("ERROR!\n");
        me->set("shuxing", sx);
      }
      break;
    }

    hs = new("/d/diablo/obj/dream/npc/pet");

    if (!hs)
      return notify_fail("ERROR\n");

    switch ((string)me->query("shuxing"))  //"土","风","火","雷","水","光","暗黑"
    {
      case "土": {
        i = (random(sizeof(tu_name) / 3)) * 3;
        name = tu_name[i];
        id = tu_name[i + 1];
        id2 = tu_name[i + 2];
        sx = "土";
      }
      break;
      case "风": {
        i = (random(sizeof(feng_name) / 3)) * 3;
        name = feng_name[i];
        id = feng_name[i + 1];
        id2 = feng_name[i + 2];
        sx = "风";
      }
      break;
      case "火": {
        i = (random(sizeof(huo_name) / 3)) * 3;
        name = huo_name[i];
        id = huo_name[i + 1];
        id2 = huo_name[i + 2];
        sx = "火";
      }
      break;
      case "雷": {
        i = (random(sizeof(tu_name) / 3)) * 3;
        name = lei_name[i];
        id = lei_name[i + 1];
        id2 = lei_name[i + 2];
        sx = "雷";
      }
      break;
      case "水": {
        i = (random(sizeof(shui_name) / 3)) * 3;
        name = shui_name[i];
        id = shui_name[i + 1];
        id2 = shui_name[i + 2];
        sx = "水";
      }
      break;
      case "光": {
        i = (random(sizeof(light_name) / 3)) * 3;
        name = light_name[i];
        id = light_name[i + 1];
        id2 = light_name[i + 2];
        sx = "光";
      }
      break;
      case "暗黑": {
        i = (random(sizeof(dark_name) / 3)) * 3;
        name = dark_name[i];
        id = dark_name[i + 1];
        id2 = dark_name[i + 2];
        sx = "暗黑";
      }
      break;
    }

    seteuid(id);
    rev = export_uid(hs);
    seteuid(getuid());

    hs->set_name(name, ({ id, id2 }));
    hs->set("shuxing", sx);
    hs->set("title", col[random(sizeof(col))] + sx + col[random(sizeof(col))] + "幻兽" NOR);
    hs->set("long", me->query("name") + "(" + me->query("id") + ")所饲养的" + sx + "属性幻兽。\n" NOR);
    hs->set("owner", me->query("id"));
    hs->set("lvl", 1);
    me->set("huanshou", 1);
    me->set("hs/hs_id", id);
    me->set("hs/hs_name", name);
    me->save();
    hs->save();
    hs->setup();
    hs->save();
    msg += HIW "一阵强光过后，一只" + hs->query("shuxing") + "属性的" + hs->name() + "出现在众人的面前！\n" NOR;
    message_vision(msg, me);
    hs->move(environment(me));
    hs->command("follow " + me->query("id"));
    destruct(egg);
  } else {
    if (random(3) == 1)
      egg->add("grow", 2 + random(2));
    else egg->add("grow", 1);
    i = egg->query("grow");
    if (i <= 5) {
      message_vision("幻兽蛋微微震动了一下，好似胀大了一点点。\n", me);
      call_out("need_food", 10 + random(5), egg, me);
    } else if (i <= 10) {
      message_vision("幻兽蛋微微震动了一下，好似又大了一圈。\n", me);
      call_out("need_food", 8 + random(5), egg, me);
    } else if (i <= 15) {
      message_vision("幻兽蛋动了几动，好似开始酝酿着新生命。\n", me);
      call_out("need_food", 6 + random(4), egg, me);
    } else {
      message_vision("幻兽蛋快活得跳动了一下，仿佛随时有生命将破壳而出。\n", me);
      call_out("need_food", 4 + random(4), egg, me);
    }
  }
  me->add("sen", -50 - random(50));
  me->start_busy(1 + random(3));
  return 1;
}

void need_food(object egg, object me) {
  int i;
  string msg;
  if (me != environment(egg) || !living(me))
    return;

  remove_call_out("need_food");
  egg->add("grow", -1 - random(4));

  i = egg->query("grow");
  if (i >= 15)
    msg = "稍微动了动。\n";
  else if (i >= 10)
    msg = "上的光泽稍微暗淡了一点点。\n";
  else if (i >= 5)
    msg = "上的光泽渐渐暗淡了。\n";
  else if (i >= 2)
    msg = "看上去渐渐缺乏生机了。\n";
  else
    msg = "停止了生长。\n";
  tell_object(me, egg->name() + NOR + msg);
  if (egg->query("grow") < 0)
    egg->set("grow", 0);
  return;
}
