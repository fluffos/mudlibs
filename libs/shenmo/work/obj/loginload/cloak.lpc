#include <ansi.h>
#include <dbase.h>
#include <armor.h>

//inherit F_UNIQUE;
inherit NECK;

int do_wear(string arg);
int do_remove(string arg);
object offensive_target(object me);

void create() {
  set_name(HIC "水瑟天光" NOR, ({ "water light cloak", "cloak" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("no_drop", "如此宝贵的防具再世难求啊。\n");
    set("no_give", "这种稀世之宝怎么能轻易送人呢?\n");
    set("no_sell", "卖?这种稀世之宝谁买得起啊!\n");
    set("long", HIY "\n传说中的神仙姐姐的戴过的斗篷，香气四溢。\n即便是未见其人，也能意淫一把。：）" NOR);
    set("no_put", 1);
    set("no_steal", 1);
    set("value", 300000);
    set("material", "crystal");
    set("armor_type", "cape");
    set("armor_prop/armor", 1000);
    set("armor_prop/dodge", 50);
    set("armor_prop/parry", 50);
    set("armor_prop/unarmed", 50);
    set("armor_prop/force", 50);

  }
  setup();
}

int init() {
  add_action("do_wear", "wear");
  add_action("do_remove", "remove");
  return 1;
}

// This function selects a random target for offensive spells/functions.
object offensive_target(object me) {
  int sz;
  object *enemy;

  enemy = me->query_enemy();
  if (!enemy || !arrayp(enemy)) return 0;

  sz = sizeof(enemy);
  if (sz > 4) sz = 4;

  if (sz > 0) return enemy[random(sz)];
  else return 0;
}

int do_wear(string arg) {
  object me = this_player();
  object cloak = this_object();
  string msg;

  if (arg != "all" && arg != "water light cloak" && arg != "cloak")
    return notify_fail("你要佩带什么？\n");
  msg = HIC "水色天光" NOR + HIW "在萧瑟的秋水下，让天际泛起了阵阵炫目的光彩，耀眼夺目。\n";
  cloak->set("wear_msg", msg);
  remove_call_out("check");
  call_out("check", 1, me, cloak);
  return 0;
}

int do_remove(string arg) {
  object me = this_player();
  object cloak = this_object();
  string msg;

  if (arg != "all" && arg != "water light cloak" && arg != "cloak")
    return notify_fail("你要摘掉什么？\n");

  msg = HIW "耀眼炫目的光彩不再，" HIC "水色天光" NOR + HIW "渐渐稳没在萧瑟的秋水下。\n";
  cloak->set("unequip_msg", msg);
  remove_call_out("check");
  return 0;
}

void check(object who, object ob) {
  object target;
  string type;
  type = ob->query("armor_type");
  if (who->query_temp("armor/" + type) && ob->query("equipped") != "worn")
    return;
  target = offensive_target(who);
  if (who->is_fighting() && target) {
    if (!target) return;
    if (!present(target, environment(who))) return;

    message_vision(
      HIW "突然由" HIC "水瑟天光" NOR + HIW "中传出一阵惊天狂啸，$N犹如绝代战神附身，将战意发挥到极限使出战神绝技\n" NOR,
      who,
      target
    );
    message_vision(
      HIM "－＝≡ " HIC "惊 － 天 － 动 － 地 － 式" NOR + HIY " ～◎～ " HIC "狂 － 灭 － 天 － 九 － 绝" NOR + HIM " ≡＝－\n\n" NOR,
      who,
      target
    );

    switch (random(10)) {
      case 0:
        message_vision(
          HIR "狂灭天九绝第一式" HIY "○天翔奔雷破○" NOR + HIR "由天降下的无数雷球电气四射，向$n狂袭.\n" NOR,
          who,
          target
        );
        target->receive_damage("sen", (target->query("max_sen") / 30));
        target->receive_damage("kee", (target->query("max_kee") / 30));
        COMBAT_D->report_status(target);
        break;

      case 1:
        message_vision(
          HIC "狂灭天九绝第二式" HIG "☆天风卷千钧☆" NOR + HIC "庞然巨大的龙卷飓风狂吹乱扫，向$n袭击.\n" NOR,
          who,
          target
        );
        target->receive_damage("sen", (target->query("max_sen") / 28));
        target->receive_damage("kee", (target->query("max_kee") / 28));
        COMBAT_D->report_status(target);
        break;

      case 2:
        message_vision(
          HIW "狂灭天九绝第三式" HIB "◇天龙舞飞旋◇" NOR + HIW "无数的龙气聚然成形激射狂旋，向$n飞舞.\n" NOR,
          who,
          target
        );
        target->receive_damage("sen", (target->query("max_sen") / 26));
        target->receive_damage("kee", (target->query("max_kee") / 26));
        COMBAT_D->report_status(target);
        break;

      case 3:
        message_vision(
          HIB "狂灭天九绝第四式" HIY "□天水月流转□" NOR + HIB "朦胧的月色若隐若现轻盈流转，向$n盈绕.\n" NOR,
          who,
          target
        );
        target->receive_damage("sen", (target->query("max_sen") / 24));
        target->receive_damage("kee", (target->query("max_kee") / 24));
        COMBAT_D->report_status(target);
        break;

      case 4:
        message_vision(
          HIY "狂灭天九绝第五式" HIR "§天将伏千军§" NOR + HIY "威武的神将慕然出现身旋四转，向$n急攻.\n" NOR,
          who,
          target
        );
        target->receive_damage("sen", (target->query("max_sen") / 22));
        target->receive_damage("kee", (target->query("max_kee") / 22));
        COMBAT_D->report_status(target);
        break;

      case 5:
        message_vision(
          HIG "狂灭天九绝第六式" RED "→天风驰阴雷←" NOR + HIG "低鸣阴沉的天际突然风雷骤现，向$n猛降.\n" NOR,
          who,
          target
        );
        target->receive_damage("sen", (target->query("max_sen") / 20));
        target->receive_damage("kee", (target->query("max_kee") / 20));
        COMBAT_D->report_status(target);
        break;

      case 6:
        message_vision(
          HIM "狂灭天九绝第七式" WHT "※天灵箭幻舞※" NOR + HIM "大地的灵气如幻箭般激射四起，向$n狂射.\n" NOR,
          who,
          target
        );
        target->receive_damage("sen", (target->query("max_sen") / 18));
        target->receive_damage("kee", (target->query("max_kee") / 18));
        COMBAT_D->report_status(target);
        break;

      case 7:
        message_vision(
          HIM "狂灭天九绝第八式" HIR "〓天火怒燎原〓" NOR + HIM "天神怒火由四面八方袭卷而至，向$n焚烧.\n" NOR,
          who,
          target
        );
        target->receive_damage("sen", (target->query("max_sen") / 16));
        target->receive_damage("kee", (target->query("max_kee") / 16));
        COMBAT_D->report_status(target);
        break;

      case 8:
        message_vision(
          HIC "狂灭天九绝第九式" HIW "◎天冰寒星雨◎" NOR + HIC "万点的寒星如骤雨般破空急降，向$n暴降.\n" NOR,
          who,
          target
        );
        target->receive_damage("sen", (target->query("max_sen") / 14));
        target->receive_damage("kee", (target->query("max_kee") / 14));
        COMBAT_D->report_status(target);
        break;

      case 9:
        message_vision(
          HIR "狂灭天九绝第一式" HIY "○天翔奔雷破○" NOR + HIR "由天降下的无数雷球电气四射，向$n狂袭.\n" NOR,
          who,
          target
        );
        message_vision(
          HIC "狂灭天九绝第二式" HIG "☆天风卷千钧☆" NOR + HIC "庞然巨大的龙卷飓风狂吹乱扫，向$n袭击.\n" NOR,
          who,
          target
        );
        message_vision(
          HIW "狂灭天九绝第三式" HIB "◇天龙舞飞旋◇" NOR + HIW "无数的龙气聚然成形激射狂旋，向$n飞舞.\n" NOR,
          who,
          target
        );
        message_vision(
          HIB "狂灭天九绝第四式" HIY "□天水月流转□" NOR + HIB "朦胧的月色若隐若现轻盈流转，向$n盈绕.\n" NOR,
          who,
          target
        );
        message_vision(
          HIY "狂灭天九绝第五式" HIR "§天将伏千军§" NOR + HIY "威武的神将慕然出现身旋四转，向$n急攻.\n" NOR,
          who,
          target
        );
        message_vision(
          HIG "狂灭天九绝第六式" RED "→天风驰阴雷←" NOR + HIG "低鸣阴沉的天际突然风雷骤现，向$n猛降.\n" NOR,
          who,
          target
        );
        message_vision(
          HIM "狂灭天九绝第七式" WHT "※天灵箭幻舞※" NOR + HIM "大地的灵气如幻箭般激射四起，向$n狂射.\n" NOR,
          who,
          target
        );
        message_vision(
          HIM "狂灭天九绝第八式" HIR "〓天火怒燎原〓" NOR + HIR "天神怒火由四面八方袭卷而至，向$n焚烧.\n" NOR,
          who,
          target
        );
        message_vision(
          HIC "狂灭天九绝第九式" HIW "◎天冰寒星雨◎" NOR + HIC "万点的寒星如骤雨般破空急降，向$n暴降.\n" NOR,
          who,
          target
        );
        target->receive_damage("sen", (target->query("max_sen") / 10));
        target->receive_damage("kee", (target->query("max_kee") / 10));
        target->start_busy(3);
        COMBAT_D->report_status(target);
        break;
    }
  }
  call_out("check", 1, who, ob);
}
