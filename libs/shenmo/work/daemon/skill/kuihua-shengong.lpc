//Cracked by Roath

//Ansi 99.8
inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_learn(object me) {
  if ((int)me->query_skill("kuihua-shengong", 1) < 80)
    return notify_fail("你的葵花神功火候还不够，还不能学习。\n");
  if (me->query("lunhui_zhuanshi") < 1)
    return notify_fail("没转世的人是无法学习葵花神功的。\n");

  return 1;
}

int practice_skill(object me) {
  return notify_fail("葵花心法只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func) {
  return CLASS_D("jjg") + "/kuihua-shengong/" + func;
}



void skill_improved(object me) {

  if (me->query("lunhui_zhuanshi") >= 2 && (int)me->query_skill("pixie-jian",

    1) > 350) {
    me->set_skill("pixie-jianfa", 81);
    me->delete_skill("pixie-jian");

    tell_object(me, "你对辟邪剑法有所领悟。\n");

  }


  if (me->query("lunhui_zhuanshi") >= 3 && (int)me->query_skill("pixie-jianfa",

    1) > 350) {
    me->set_skill("pixie-mijian", 81);
    me->delete_skill("pixie-jianfa");

    tell_object(me, "你对辟邪剑法有所领悟。\n");

  }


  if (me->query("lunhui_zhuanshi") >= 4 && (int)me->query_skill("pixie-mijian",

    1) > 350) {
    me->set_skill("jinling-jianfa", 81);
    me->delete_skill("pixie-mijian");

    tell_object(me, "你对辟邪剑法有所领悟。\n");

  }


}
