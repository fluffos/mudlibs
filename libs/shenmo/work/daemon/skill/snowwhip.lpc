// former snowwhip.c or es2
// modified to use

#include <ansi.h>

inherit SKILL;

mapping *action = ({
  ([ "name": "寒风起兮",
    "action": "$N使一招「寒风起兮」，手中$w抖得笔直向$n的$l连刺数鞭",
    "dodge": -10,
    "damage": 30,
    "damage_type": "刺伤"
  ]),
  ([ "name": "漫天飞雪",
    "action": "$N身形一转，一招「芦花满天」$w幻出满天鞭影，虚虚实实地袭向$n的$l",
    "dodge": -20,
    "damage": 20,
    "damage_type": "瘀伤"
  ]),
  ([ "name": "雪花翩翩",
    "action": "$N力贯$w，一招「芦花飘香」点点鞭影飘浮不定地点向$n的$l",
    "dodge": -20,
    "damage": 25,
    "damage_type": "刺伤"
  ]),
});

int valid_learn(object me) {
  write("寒雪鞭法乃是三界通用鞭法，凭借你一人之力岂能参悟？\n");
  return 0;
}

int valid_enable(string usage) {
  return usage == "whip" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  write("寒雪鞭法乃是三界通用鞭法，凭借你一人之力岂能参悟？\n");
  return 0;
}

int valid_effect(object me, object weapon, string name, int skill) {}
string perform_action_file(string func) {
  return "/daemon/class/公共/snowwhip/" + func;
}
