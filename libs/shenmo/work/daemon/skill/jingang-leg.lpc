式" + BLINK "" + HIY "「碧渊腾蛟」" NOR + "，踢中的$n的胸口",
    "parry": 0,
    "dodge": -60,
    "damage": 50,
    "damage_type": "瘀伤",
    "skill_name": "碧渊腾蛟"
  ]),
  ([ "action": "$N突然跃起，双足连环圈转，一式" + BLINK "" + HIG "「秋风落叶」" NOR + "，足带风尘，攻向$n的全身",
    "parry": 10,
    "dodge": -20,
    "damage": 60,
    "damage_type": "瘀伤",
    "skill_name": "秋风落叶"
  ]),
});

int valid_learn(object me) {
  mapping shaolin;
  if (me->query_temp("weapon")
    || me->query_temp("secondary_weapon"))
    return notify_fail("练大力金刚腿必须空手。\n");
  shaolin = me->query("门派/shaolin");
  if (shaolin && shaolin["jingang-leg"])
    return notify_fail("你的腿法早已升级了，再学这种下等腿法也是枉然。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if (me->query("class") != "human")
    return notify_fail("非尘世之人如何参得？\n");
  if (me->query("family/family_name") != "少林寺"
    && me->query_skill("jingang-leg", 1) < 350)
    return notify_fail("你金刚腿尚未到开宗创祖的等级。\n");
  if (me->query("sen") < 150)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if (me->query("kee") < 150)
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");
  if (me->query("force") < 200)
    return notify_fail("你的内力不够了。\n");
  me->receive_damage("kee", 12, me);
  me->receive_damage("sen", 12, me);
  me->add("force", -18);
  return 1;
}

string perform_action_file(string func) {
  return CLASS_D("shaolin") + "/jingang-leg/" + func;
}

