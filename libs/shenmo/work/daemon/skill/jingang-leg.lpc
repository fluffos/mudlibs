#include <ansi.h>;

mapping *action = ({
  ([ "action": "$N双手虚晃，左脚猛地飞起，一式" + BLINK "" + HIW "「风起云涌」" NOR + "，脚尖晃动，踢向$n的屁股",
    "parry": 10,
    "dodge": -50,
    "damage": 50,
    "damage_type": "瘀伤",
    "skill_name": "风起云涌"
  ]),
