// 五毒神腿

inherit SKILL;

mapping *action = ({
  ([ "action":
    "$N纵身跃起，一招「飞龙在天」，双脚以排山倒海之势击向$n的$l",
    "dodge": -10,
    "parry": -10,
    "force": 150,
    "damage_type": "瘀伤",
    "weapon": "双脚",
    "parry_msg": "只听见「锵」一声，被$N劈手格开",
  ]),
  ([ "action":
    "$N似退反进，突然欺身向前，脚趾如钩，对准$n的$l一把勾了过去",
    "dodge": 10,
    "parry": -20,
    "force": 200,
    "damage_type": "抓伤",
    "weapon": "右脚五指",
    "parry_msg": "只听见「锵」一声，被$N劈手格开",
  ]),
  ([ "action":
    "只见$N一旋身，双腿如铁棍一般扫向$n。这一招「神龙摆尾」当真是防不胜防",
    "dodge": -10,
    "parry": -20,
    "force": 220,
    "damage_type": "砸伤",
    "weapon": "双腿",
    "parry_msg": "只听见「锵」一声，被$N劈手格开",
  ]),
  ([ "action":
    "$N忽发龙吟，使出一招「龙战于野」，啸声中和身而上，向$n直撞而来",
    "dodge": 10,
    "parry": -10,
    "force": 200,
    "damage_type": "撞伤",
    "weapon": "全身",
    "parry_msg": "只听见「锵」一声，被$N劈手格开",
  ]),
  ([ "action":
    "只见$N一个筋斗翻在半空，一招「龙腾四海」将发未发，但是全身劲气疾卷$n",
    "dodge": 0,
    "parry": -20,
    "force": 250,
    "damage_type": "内伤",
    "weapon": "劲气",
    "parry_msg": "只听见「锵」一声，被$N劈手格开",
  ]),
  ([ "action":
    "$N身形一长，朝$n劈面就是一脚。这招「苍龙出海」势若奔雷，锐利无比",
    "dodge": 10,
    "parry": -30,
    "force": 280,
    "damage_type": "瘀伤",
    "weapon": "双脚",
    "parry_msg": "只听见「锵」一声，被$N劈手格开",
  ]),
});
int valid_learn(object me) {
  if ((int)me->query_skill("wudu-shengong", 1) < (int)me->query_skill("wudu-tui", 1) / 2)
    return notify_fail("你的心法还不够精湛，无法领会更深层的五毒神腿！\n");


  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练腿法必须空手。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if (me->query("class") != "yao" && !me->samsara_check("wudu-tui"))
    return notify_fail("这是妖界特有的功夫，你还是省省吧。\n");
  if (me->query("family/family_name") != "黄花观五毒门"
    && me->query_skill("wudu-tuifa", 1) < 350 && !me->samsara_check("wudu-tuifa"))
    return notify_fail("你的五毒神腿基础还不够扎实。\n");

  if ((int)me->query("sen") < 50)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");

  if ((int)me->query("kee") < 50)
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");

  if ((int)me->query("force") < 20)
    return notify_fail("你的内力不够了。\n");

  me->receive_damage("kee", 30);
  me->add("force", -20);

  return 1;
}

string perform_action_file(string func) {
  return CLASS_D("wudu") + "/wudu-tuifa/" + func;
}
