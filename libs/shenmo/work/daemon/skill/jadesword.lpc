int valid_learn(object me)
{
object ob;
me=this_player();
if (me->query("yumo_agree")==0 )
       return notify_fail("玉魔剑法只能有缘者习之！\n");
if ((int)me->query_skill("jadesword",1) > 59 && me->query("yumo_agree")<2)
       return notify_fail("玉魔剑法精深奥妙，看来单纯通过学习或者练习是难以有更大进步的！\n");
if ((int)me->query("int") < 20)
       return notify_fail("你悟性太差，恐怕领悟不了精深奥妙的玉魔剑法！\n");
    
    if ((int)me->query("max_force") < 100)
	return notify_fail("你的真气不足，难以领悟剑法的精妙之处。\n");
    
    if (!(ob = me->query_temp("weapon"))
	||	(string)ob->query("skill_type") != "sword" )
	return notify_fail("你必须先找一把剑才能练剑法。\n");
    
    return 1;
}

int valid_enable(string usage)
{
    return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
int i;
mapping* m_actions;
m_actions=me->query("skill_jadesword");
i=me->query_temp("qishen");
if(!me->query_temp("qishen"))
    {
    if(me->query("jadesword")==0)
    return action[random(6)];
    if(random(2)) return action[random(6)];
    return m_actions[random(sizeof(m_actions))];
    }
else if(i==4)
    {
        return action[6+random(9)];
    }
else if(i==3)
    {
        return action[15+random(7)];
    }
else if(i==2)
    {
        return action[22+random(6)];
    }
else
        return action[random(6)];
}

int practice_skill(object me)
{
object ob; 
if ((int)me->query("yumo_agree") < 2)
        return notify_fail("你试着练了几趟玉魔剑法，但是没有任何进步。\n");
if( (int)me->query("sen") < 50) 
        return notify_fail("你的精神无法集中了，休息一下再练吧。\n"); 
if( (int)me->query("kee") < 50 ) 
        return notify_fail("你现在头晕眼花，休息一下再练吧。\n"); 
if( (int)me->query("force") < 50 ) 
        return notify_fail("你的内力不够了。\n"); 
me->receive_damage("kee", 30); 
me->receive_damage("sen", 30); 
me->add("force", -20); 
return 1; 
}
string perform_action_file(string action)
{
        return "/daemon/class/forall/jadesword/"+action;
}
