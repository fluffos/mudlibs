inherit SKILL;

int valid_enable(string usage) { return usage=="spells"; }

int valid_learn(object me)
{
       if ( me->query("class")!="xian" && !me->samsara_check("yuxu-spells") ) return notify_fail("你非仙族弟子，无法习得！\n");
	if( (int)me->query_skill("spells", 1) < 10 
		|| (int)me->query_skill("spells", 1) <= (int)me->query_skill("yuxu-spells", 1) )
		return notify_fail("你的法术修为还不够高深，无法学习玉虚仙法。\n");
	return 1;
}

string cast_spell_file(string spell)
{
        return CLASS_D("kunlun") + "/yuxu-spells/" + spell;
}

string type() { return "magic";} 
