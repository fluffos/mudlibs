
#include <ansi.h>
inherit SKILL;

string *dodge_msg = ({
	"$n一招「秋风起兮白云飞」轻轻巧巧地避了开去。\n",
	"只见$n身影一晃，一式「草木黄落兮雁南归」早已避在七尺之外。\n",
	"$n使出「兰有秀兮菊有芳」，轻轻松松地闪过。\n",
	"$n左足一点，一招「怀佳人兮不能忘」腾空而起，避了开去。\n",
	"可是$n使一招「泛楼船兮济汾河」，身子轻轻飘了开去。\n",
	"$n身影微动，已经藉一招「横中流兮扬素波」轻轻闪过。\n",
	"但是$n一招「箫鼓鸣兮发棹歌」使出，早已绕到$N身後！\n",
        "但是$n身形飘忽，轻轻一纵，一招「欢乐极兮哀情多」，避开这一击。\n",
        "$n身形往上一拔，一招「少壮几时兮奈老何」，一个转折落在数尺之外。\n",

});

int valid_enable(string usage)
{
	return (usage=="dodge") ;
}

int valid_learn(object me)
{
	if( (int)me->query("max_force") < 50 )
                return notify_fail("你的内力不够，没有办法练血海飘香步。\n");

	return 1;
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
	if( (int)me->query("kee") < 30
	||	(int)me->query("force") < 3 )
                return notify_fail("你的气或内力不够，不能练血海飘香。\n");
        if( me->query("family/family_name")!="江湖浪子" && (int)me->query("spsk")!=10)
                return notify_fail("血海飘香是江湖浪子不传之密。\n");
        if( (int)me->query_skill("piaoxiang", 1) > 1499)
                return notify_fail("你的血海飘香已经不能再通过练习提高了。\n");
	me->receive_damage("kee", 30);
	me->add("force", -3);
	return 1;
}
int effective_level() { return 15;}

int learn_bonus()
{
	return -20;
}
int practice_bonus()
{
	return -10;
}
int black_white_ness()
{
	return 40;
}

string perform_action_file(string action)
{
        return CLASS_D("youxia") + "/piaoxiang/" + action;
}


int ob_hit(object ob, object me, int damage)
{
object wp1;
string msg;
int p,j=0,skill, neili, neili1;
wp1 = ob->query_temp("weapon");
skill = me->query_skill("piaoxiang", 1);
neili = me->query("force");
neili1 = ob->query("force");

if (damage <10)
        damage=10;      

if(random(skill) > ob->query_skill("dodge", 1)/4
&& random(me->query("combat_exp")) > ob->query("combat_exp")/4
&& random(me->query("level")) > ob->query("level")/4
&& me->query_skill_mapped("dodge") == "piaoxiang"
&& (int)ob->query("spskkk")!=2
&& (int)ob->query("spsk")!=24
&& neili > 100 && skill > 150)
    {
msg = "$n不见有任何动作，只是身子一晃一转，蹴的一下转到$N的背后。\n";
if ( !ob->query("env/no_msg"))
tell_object(ob, HIR "你只觉眼前一花，不见了对手的身影！\n" NOR);
if ( neili >= random(neili1)+damage ) 
        {
        msg+= WHT"结果$N的力道被$n完全躲开了！\n"NOR, 
        j = -damage;
        }
else if ( neili<random(neili1)+damage && neili*3/2>=random(neili1)+damage )
        {
        msg+= CYN"结果$n躲过了$N的一大半力道！\n"NOR, 
        j = -damage/4*3;
        }
else if ( neili*3/2<random(neili1)+damage && neili*2>=random(neili1)+damage )
        {
        msg+= YEL"结果$N的力道被躲过了一半！\n"NOR, 
        j = -damage/2;
        }
else    {
        msg+= BLU"结果$n只躲过了$N的一小半力道！\n"NOR, 
        j = -damage/4; 
        } 
if ( !j )
        return 0;                 
me->set_temp("dodge_skill_msg",msg);    
return j;
    }
}
