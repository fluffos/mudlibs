// literate.c

#include <ansi.h>

inherit SKILL;

string type() { return "knowledge"; }

string level_description(int level) {
  int grade;
  string *level_desc = ({
    HIB "初通文理" NOR,
    YEL "略知一二" NOR,
    HIY "知书达理" NOR,
    HIG "文采斐然" NOR,
    HIM "博学多才" NOR,
    MAG "高才硕望" NOR,
    CYN "饱学鸿儒" NOR,
    WHT "学贯古今" NOR,
    HIW "满腹经纶" NOR,
    HIY "学富五车" NOR
  });

  grade = level / 100;

  if (grade >= sizeof(level_desc))
    grade = sizeof(level_desc) - 1;
  return level_desc[grade];
}
