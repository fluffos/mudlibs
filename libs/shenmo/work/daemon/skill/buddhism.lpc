// buddhism.c

inherit SKILL;

int valid_enable(string usage) { return usage == "spells"; }

int valid_learn(object me) {
  if (me->query("class") != "xian" && !me->samsara_check("buddhism") && me->query("spskk") != 13) return notify_fail("你非仙族弟子，无法习得！\n");

  if ((int)me->query_skill("spells", 1) <= (int)me->query_skill("buddhism", 1))
    return notify_fail("你的法术修为还不够高深，无法学习大乘佛法。\n");
  if ((int)me->query("bellicosity") > 100)
    return notify_fail("你的杀气太重，无法修炼大乘佛法。\n");
  return 1;
}

string cast_spell_file(string spell) {
  return CLASS_D("bonze") + "/buddhism/" + spell;

}

string type() { return "magic"; }
