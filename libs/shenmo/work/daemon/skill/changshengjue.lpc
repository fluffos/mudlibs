// 两大神功之长生诀
#include <ansi.h>
inherit FORCE;

int valid_enable(string usage) {
  return usage == "force";
}

int valid_learn(object me) {
  if (me->query("chshjue_agree") == 0)
    return notify_fail("长生诀神功只能有缘者习之！\n");
  if (me->query_skill("busi-force", 1) > 0)
    return notify_fail("正邪不两立，长生诀恐怕难以与不死印法一起修炼！\n");
  if (me->query_skill("changshengjue", 1) >= 1200)
    return notify_fail("你的长生诀已经登峰造极，很难再靠潜心研究来进步了。\n");
  else return 1;
}

int practice_skill(object me) {
  return notify_fail("长生诀神功只能静心钻研，或是从运用(exert)中增加熟练度。\n");
}

string exert_function_file(string func) {
  return CLASS_D("forall") + "/changshengjue/" + func;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  if (damage_bonus < 100)
    return 0;
  if (random(3 * (me->query_skill("changshengjue", 1))) > (damage_bonus)
    && (random(me->query_skill("changshengjue", 1)) > victim->query_skill("douzhuan-xingyi", 1)
      || victim->query_skill_mapped("parry") != "douzhuan-xingyi"
      || victim->query("dzxy_agree") == 0)) {
    victim->receive_wound("kee", (damage_bonus), me);
    victim->receive_wound("sen", (damage_bonus), me);
    if (me->query("chshjue_agree") == 2) {
      victim->add("force", -(int)me->query("force_factor") / 4);
      victim->add("mana", -(int)me->query("force_factor") / 4);
    }
    if (!me->query("env/no_msg") && !userp(victim))
      message_vision(HIR "$N" HIR "体内的长生诀真气汹涌澎湃，势不可挡，$n" HIR "只觉得心神俱碎！\n" NOR, me, victim);
    return 1;
  } else return 0;
}


int stage(int level) {
  if (level < 100) return 1;
  else if (level < 200) return 2;
  else if (level < 300) return 3;
  else if (level < 400) return 4;
  else if (level < 500) return 5;
  else if (level < 600) return 6;
  else if (level < 700) return 7;
  else if (level < 800) return 8;
  else if (level < 900) return 9;
  else return 10;
}

string level_description(int level) {
  if (stage(level) < 2)
    return HIB "第" + chinese_number(stage(level)) + "重　" NOR;
  else if (stage(level) < 3)
    return HIB "第" + chinese_number(stage(level)) + "重　" NOR;
  else if (stage(level) < 4)
    return YEL "第" + chinese_number(stage(level)) + "重　" NOR;
  else if (stage(level) < 5)
    return YEL "第" + chinese_number(stage(level)) + "重　" NOR;
  else if (stage(level) < 6)
    return HIM "第" + chinese_number(stage(level)) + "重　" NOR;
  else if (stage(level) < 7)
    return HIM "第" + chinese_number(stage(level)) + "重　" NOR;
  else if (stage(level) < 8)
    return HIC "第" + chinese_number(stage(level)) + "重　" NOR;
  else if (stage(level) < 9)
    return HIC "第" + chinese_number(stage(level)) + "重　" NOR;
  else if (stage(level) < 10)
    return HIW "第" + chinese_number(stage(level)) + "重　" NOR;
  else
    return HIY "第" + chinese_number(stage(level)) + "重　" NOR;
}
