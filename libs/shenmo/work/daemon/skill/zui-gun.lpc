inherit SKILL;
#include <ansi.h>;

string* skill_head =({
        "$N身形稍退，使出一招",
        "$N仰天长笑，看也不看，一招",
        "$N轻轻一跃，使了个",
        "$N神态悠闲，一招",
        "$N身形转个不停，突然一招",
        "$N脚下踏了个少林步法，一招",
});
string* skill_tail =({
        "，手中$w势若飞瀑向$n拦腰一斩",
        "，手中$w对准$n的$l凌空一斩",
        "，反手将$w对准$n$l一棍劈去",
        "，手中$w轻妙地划向$n的$l",
        "，反手对准$n$l一棍劈去",
        "，趁$n转身之际，挥出一棍",
});

void post_zhui(object me,object victim,object weapon, int damage) 
{
int num = me->query_condition("drunk");         
if ( me->is_fighting(victim) && random(num+1)>0 )
        {
        if ( !me->query("env/no_msg") && !victim->query("env/no_msg")  ) 
        message_vision(HIY"$N"HIY"仰天再打一个饱嗝，脚下踉踉跄跄，连人带棍朝着$n"HIY"径直撞去！\n"NOR,me,victim);              
        if ( damage>0 )
                {
             if ( !me->query("env/no_msg") && !victim->query("env/no_msg")  ) 
                message_vision(HIY"$n"HIY"迫不及防，给撞了个人仰马翻！\n"NOR,me,victim);                                       
                damage+=me->query_skill("stick");
          /*
                damage = damage/2+random(damage*2);
                */ 
                // zui-gun实在是太厉害了，这儿做了部分消弱
          // fang@tsrj 2005.3.12
                damage = damage+random(damage);
//                damage=damage*num/5;
//真正厉害的是这里
// windy 削弱, 2011.08.04
                damage=damage*num/50;
                victim->receive_damage("kee",damage,me);
                COMBAT_D->report_status(victim);
                }
        else   if ( !me->query("env/no_msg") && !victim->query("env/no_msg")  ) { message_vision(HIG"$n"HIG"慌忙闪开。\n"NOR,me,victim); }
        }
}

