int valid_learn(object me)
{
object ob;
int i, f;
i = 0;
if (me->query_skill("bore-zhang"))    i+=1;
if (me->query_skill("suixing-tui"))    i+=1;
if (me->query_skill("jingang-zhi"))      i+=1;
if (me->query_skill("damo-jian"))      i+=1;
if (me->query_skill("longzhua-gong"))  i+=1;
if (me->query_skill("cibei-dao"))        i+=1;

f=1;
   if ((int)me->query_skill("chanzong", 1)>1499)   f=6;
   else if ((int)me->query_skill("chanzong", 1)>1249)   f=5;
   else if ((int)me->query_skill("chanzong", 1)>999)   f=4;
   else if ((int)me->query_skill("chanzong", 1)>749)    f=3;
   else if ((int)me->query_skill("chanzong", 1)>499)    f=2; 
   else if ((int)me->query_skill("chanzong", 1)>249)    f=1;
else f=0;

   if (f<i && !me->samsara_check("zui-gun"))
    return notify_fail("你必须参悟更深的禅宗佛法才能研习更多的少林武技。\n");

if( (int)me->query("max_force") < 100 )
        return notify_fail("你的内力不够，没有办法练少林醉棍。\n");

if( !(ob = me->query_temp("weapon"))
   || ob->query("skill_type") != "stick" )
        return notify_fail("你必须先找一根棒子才能练少林醉棍。\n");
if ((int)me->query_skill("yijinjing", 1) < 100)
    return notify_fail("你的易筋经神功火候不够，无法学习少林醉棍。\n");
if ( me->query("family/family_name")!="少林寺"  
&& me->query_skill("zui-gun",1)<350 && !me->samsara_check("zui-gun")) 
    return notify_fail("你的少林醉棍尚未到独创一家的地步。\n"); 

return 1;
}

int valid_enable(string usage)
{
return usage=="stick" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
if ( me->query_temp("zui_powerup") )    
        return s_action[random(sizeof(action))];
else    return action[random(sizeof(s_action))];
}

int practice_skill(object me)
{
if ( me->query("class")!="human" && !me->samsara_check("zui-gun") ) 
        return notify_fail("非尘世之人如何参得？\n");
if ( me->query("family/family_name")!="少林寺" 
  && me->query_skill("zui-gun",1)<350 && !me->samsara_check("zui-gun")) 
        return notify_fail("你醉棍尚未到开宗创祖的等级。\n"); 

if( (int)me->query("kee") < 30
  ||(int)me->query("force") < 5 )
        return notify_fail("你的内力或气不够，没有办法练习少林醉棍。\n");
me->receive_damage("kee", 30);
me->add("force", -5);
write("你按着所学练了一遍少林醉棍。\n");
return 1;
}

