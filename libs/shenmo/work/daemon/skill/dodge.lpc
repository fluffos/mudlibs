// dodge.c
#include <ansi.h>

inherit SKILL;

string *dodge_msg = ({
  "但是和$p$l偏了几寸。\n",
  "但是被$p机灵地躲开了。\n",
  "但是$n身子一侧，闪了开去。\n",
  "但是被$p及时避开。\n",
  "但是$n已有准备，不慌不忙地躲开。\n",
});

string query_dodge_msg() {
  return dodge_msg[random(sizeof(dodge_msg))];
}

string level_description(int level) {
  int grade;
  string *level_desc = ({
    BLU "笨手笨脚" NOR,
    HIB "步伐轻盈" NOR,
    YEL "身形灵动" NOR,
    HIY "身轻如燕" NOR,
    HIG "疾若飞鸿" NOR,
    HIM "踏雪无痕" NOR,
    MAG "登萍渡水" NOR,
    CYN "来去如风" NOR,
    HIC "一泻千里" NOR,
    WHT "移形换影" NOR,
    HIW "凌空渡虚" NOR,
    HIY "独步天下" NOR,
    HIY "开宗创祖" NOR
  });

  grade = level / 100;

  if (grade >= sizeof(level_desc))
    grade = sizeof(level_desc) - 1;
  return level_desc[grade];
}
