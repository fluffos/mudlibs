//天空界

#include <ansi.h>
inherit SKILL;

mapping *action = ({
  ([ "action":
    "只见$N凝神运气，气沉丹田，右拳轻轻后撤，突然大喝一声，夹杂着风火之势袭向$n$l",
    "dodge": -150,
    "parry": -55,
    "force": 180,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N见对方向自己袭来，双脚向后微微一撤，让开身去，突地向$n$l击去，实在巧妙至极。",
    "dodge": -125,
    "parry": -25,
    "force": 170,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N口念梵语，左拳笼罩着肃杀之气，带着虎虎风声打向$n$l",
    "dodge": -150,
    "parry": -50,
    "force": 160,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N轻轻一跃，在空中快速旋转，突然消失了身影，突然间出现在敌人背后，悄无声息地击向$n$l",
    "dodge": -150,
    "parry": -50,
    "force": 200,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N顿下身形，突然下坠，与$n错身而过。$N突然双拳向上击出，打向$n的$l",
    "dodge": -125,
    "parry": -50,
    "force": 190,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N接连几个急转，身形如陀螺般向$n滚去，转一圈击一拳，拳拳不离$n的$l",
    "dodge": -135,
    "parry": -50,
    "force": 160,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "只听$N一声清啸，身体跃向空中，右拳全力击出，一道光流包围$n周身要害",
    "dodge": -145,
    "parry": -45,
    "force": 180,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N往后一纵，就势连续击出，一拳快似一拳，瞬间几股力量合成一招快速击向$n$l",
    "dodge": -180,
    "parry": -35,
    "force": 160,
    "damage_type": "瘀伤"
  ]),
});

int valid_learn(object me) {
  if ((me->query("class") != "shen" || me->query("family/family_name") != "天空界") && !me->samsara_check(
    "mopo-quan",
    1
  ))
    return notify_fail("天空界的绝招,你从那里偷学的?\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon")
  )
    return notify_fail("练魔破拳必须空手。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("sen") < 30)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if ((int)me->query("kee") < 30)
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");
  if ((int)me->query("force") < 10)
    return notify_fail("你的内力不够了。\n");

  me->receive_damage("kee", 30);
  me->add("force", -10);

  return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  if (damage_bonus < 200) return 0;
  if (me->query_skill("shenyu", 1) < 180) return 0;
  if (me->query_skill("mopo-quan", 1) < 180) return 0;
  if (random((int)me->query_skill("shenyu", 1)) > 200) {
    victim->receive_wound("kee", (damage_bonus - 100) / 4);
    victim->apply_condition("qi_poison", 1 + random(4));
    return HIC "$N顺势上前一拳带着亦正亦邪之气击向$n的心口，$n猛退几步，嘴角流出点鲜血。\n" NOR;
  } else return HIB "$N顺势上前一拳带着亦正亦邪之气击向$n的心口，$n连忙运真气将掌中毒气逼出体外。\n" NOR;
}


string perform_action_file(string action) {
  return CLASS_D("tiankongjie") + "/mopo-quan/" + action;
}
