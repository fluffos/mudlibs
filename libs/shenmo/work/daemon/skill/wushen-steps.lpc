
#include <ansi.h>
inherit SKILL;

string *dodge_msg = ({
	"$n身子猛然贴地向后滑出丈余，好似有人用绳缚住以快迅无纶的手法向后扯动一般。\n",
	"不见$n提足抬脚，突然之间倒退丈余，一转身。已在数丈之外。\n",
	"只听得呼的一声，$n身子笔直的向空中飞起，直至丈余高，躲过了这一招。\n",
	"$n陡然身形拔起，在空中急速盘旋，连转四个圈子，愈转愈高，一个转折落在数丈之外。\n",
	"$n绕着圈子，东转西闪，滑如游鱼，在间不容发之际躲过了这招。\n",
	"$n大吃一惊，不及趋避，足尖使劲，拔身急起，斜飞而上，及时的躲过了这一招。\n",
	"$n有如一溜轻烟，左一闪，右一趋，正转一圈，反转一圈，已闪了开去。\n"
});

int valid_enable(string usage) { return (usage == "dodge"); }

int valid_learn(object me) { 
if( (me->query("class")!= "saint" || me->query("family/family_name")!= "格斗家") && !me->samsara_check("wushen-steps",1) )
        return notify_fail("你非格斗家，自然学不得！\n");
return 1;
}

string query_dodge_msg(object me)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
if( (me->query("class")!= "saint" || me->query("family/family_name")!= "格斗家") && !me->samsara_check("wushen-steps",1) )
        return notify_fail("你非格斗家，自然学不得！\n");
	if( (int)me->query("sen") < 50)
		return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
	if( (int)me->query("kee") < 50 )
		return notify_fail("你现在手足酸软，休息一下再练吧。\n");
	if ((int)me->query("force") < 20)
		return notify_fail("你的内力不够武神流身法。\n");
        if( (int)me->query_skill("wushen-steps", 1) > 1499)
                return notify_fail("你的武神流身法已经不能再通过练习提高了。\n");
	me->receive_damage("kee", 30);
	me->add("force", -10);
	return 1;
}

string perform_action_file(string action)
{
  return CLASS_D("sfighter") + "/wushen-steps/" + action;
}

int ob_hit(object ob, object me, int damage)
{
object wp1;
string msg;
int p,j=0,skill, neili, neili1;
wp1 = ob->query_temp("weapon");
skill = me->query_skill("wushen-steps", 1);
neili = me->query("force");
neili1 = ob->query("force");

if (damage <10)
        damage=10;      

if(random(skill) > ob->query_skill("dodge", 1)/6
&& random(me->query("combat_exp")) > ob->query("combat_exp")/6
&& random(me->query("level")) > ob->query("level")/6
&& me->query_skill_mapped("dodge") == "wushen-steps"
&& (int)ob->query("spsk")!=14
&& (int)ob->query("spskkk")!=2
&& neili > 100 && skill > 150)
    {
msg = "$n不见有任何动作，只是身子一晃一转，蹴的一下转到$N的背后。\n";
if ( !ob->query("env/no_msg"))
tell_object(ob, HIR "你只觉眼前一花，不见了对手的身影！\n" NOR);
if ( neili >= random(neili1)+random(damage) ) 
        {
        msg+= WHT"结果$N的力道被$n完全躲开了！\n"NOR, 
        j = -damage;
        }
else if ( neili<random(neili1)+random(damage) && neili*3/2>=random(neili1)+random(damage) )
        {
        msg+= CYN"结果$n躲过了$N的一大半力道！\n"NOR, 
        j = -damage/4*3;
        }
else if ( neili*3/2<random(neili1)+random(damage) && neili*2>=random(neili1)+random(damage) )
        {
        msg+= YEL"结果$N的力道被躲过了一半！\n"NOR, 
        j = -damage/2;
        }
else    {
        msg+= BLU"结果$n只躲过了$N的一小半力道！\n"NOR, 
        j = -damage/4; 
        } 
if ( !j )
        return 0;                 
me->set_temp("dodge_skill_msg",msg);    
return j;
    }
}
