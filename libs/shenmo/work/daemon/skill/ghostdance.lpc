//【黄泉之舞】ghostdance.c
#include <ansi.h>
inherit SKILL;

string *dodge_msg = ({
        YEL"$n"YEL"诡异一笑，脚下乱点，$N"YEL"眼前一花，已失去$n"YEL"的踪迹。\n"NOR,
        HIB"$n"HIB"一转身，一股"NOR YEL"腐朽之气"NOR HIB"顺势挡开$N的攻击。\n"NOR,
        MAG"$n"MAG"化作幻影在$N"MAG"周围乱舞，$N"MAG"一时无法作出攻击。\n"NOR,
        WHT"但见$n"WHT"不慌不忙，身子如幻雾般往后一飘...再一飘，早避到了一丈开外。\n"NOR,
        YEL"$n"YEL"诡异一笑，脚下乱点，$N"YEL"眼前一花，已失去$n"YEL"的踪迹。\n"NOR,
        HIB"$n"HIB"一转身，一股"NOR YEL"腐朽之气"NOR HIB"顺势挡开$N的攻击。\n"NOR,
        MAG"$n"MAG"化作幻影在$N"MAG"周围乱舞，$N"MAG"一时无法作出攻击。\n"NOR,
        WHT"但见$n"WHT"不慌不忙，身子如幻雾般往后一飘...再一飘，早避到了一丈开外。\n"NOR,
});

int valid_enable(string usage)
{
        return (usage=="dodge") || (usage=="move");
}

int valid_learn(object me)
{
if( (int)me->query("max_force") < 0 )
        return notify_fail("你的内力不够，没有办法学黄泉之舞。\n");
return 1;
}

string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
if( (int)me->query("kee") < 30)
        return notify_fail("你现在太虚弱，练黄泉之舞当心摔死。\n");
if((int)me->query("force") < 3 )
        return notify_fail("你现在内力不够，不能乘风而起。\n");
me->receive_damage("kee", 30);
me->add("force", -3);
return 1;
}

