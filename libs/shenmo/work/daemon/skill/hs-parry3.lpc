//无四肢类专用

inherit SKILL;

mapping *action = ({
  ([ "action":
    "$N猛的一个转身，尾巴带着劲力往$n的$l甩了过来",
    "dodge": -10,
    "parry": -10,
    "force": 150,
    "damage_type": "砸伤",
    "weapon": "尾巴",
    "parry_msg": "$N微微动了动，避开了这招",
  ]),
  ([ "action":
    "$N张开大嘴,往$n的$l狠狠地一咬",
    "dodge": 10,
    "parry": -20,
    "force": 100,
    "damage_type": "咬伤",
    "weapon": "嘴巴",
    "parry_msg": "$N微微动了动，避开了这招",
  ]),
  ([ "action":
    "$N用尽全身力量，往$n猛的一撞",
    "dodge": -10,
    "parry": -20,
    "force": 120,
    "damage_type": "撞伤",
    "weapon": "全身",
    "parry_msg": "$N微微动了动，避开了这招",
  ]),
});


int valid_enable(string usage) {
  return usage == "unarmed" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}


string perform_action_file(string func) {
  return CLASS_D("hs/hs") + "/hs_parry3/" + func;
}
