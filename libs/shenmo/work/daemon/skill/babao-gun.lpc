#include <ansi.h>
inherit SKILL;


mapping *action = ({
        
([       "action":"$N手中$w大开大阖，每一棍向$n劈去，都有似开山大斧一般，好一招势大力雄的「金刚伏魔」",
                "dodge":                -10,
                "parry":                10,
                "damage":               20,
                "damage_type":          "砸伤"
        ]),
        
([      "action":"只见$N身形稍退，右足点地斜斜跃起，手中$w笔直地向$n的$l推去\n""正是一招「佛门广渡」！",
                "dodge":                -10,
                "parry":                -10,
                "damage":               15,
                "damage_type":          "刺伤"
        ]),
        
([      "action":"$N飞身上前，手中$w疾舞，一招「天设牢笼」幻出团团棍芒，将$n紧紧裹在其中",
                "dodge":                -10,
                "parry":                -5,
                "damage":               35,
                "damage_type":          "砸伤"
        ]),
        
([       "action":"$N打到兴发，蓦地里一声清啸，手中$w冲天而起，直指$n的$l！这招山崩海啸般的「万佛归宗」完全将$n惊呆了",
                "dodge":                -20,
                "parry":                -10,
                "damage":               35,
                "damage_type":          "砸伤"
        ]),
        
([      "action":"只见$N左脚跃步落地，使出一招「佛光普照」，手中$w顺势往前，挟风声劈向$n的$l",
                "dodge":                -20,
                "parry":                -5,
                "damage":               40,
                "damage_type":          "砸伤"
        ]),
        
([      "action":"$N蓦然下蹲，一式「佛法无边」，身随棍转，如若旋风般旋转，$n哪里闪避得过",
                "dodge":                -10,
                "parry":                -10,
                "damage":               45,
                "damage_type":          "砸伤"
        ]),
        
([      "action":"$N左手握着$w，右手不住抖动，一式「如来下凡」，手中$w平平推出，\n""棍尖急颤，根本不知攻向何处",

                
                "dodge":                -30,
                "parry":                -10,
                "damage":               55,
                "damage_type":          "刺伤"
        ]),
        ([      "action":"$N吸一口气，手中连环七棍，一棍快似一棍，一式「八面埋伏」，顿时棍风中无数棍影从四面八方涌向$n的$l",
                "dodge":                -50,
                "parry":                0,
                "damage":               60,
                "damage_type":          "砸伤"
        ]),
});
int valid_learn(object me)
{
        object ob;

        if( (int)me->query("max_force") < 100 )
                return notify_fail("你的内力修为不够深，无法练习八宝棍法。\n");
        if (!(ob = me->query_temp("weapon"))
           || (string)ob->query("skill_type") != "stick" )
                return notify_fail("你必须先找一棍子才能练习棍法。\n");
if ( me->query("family/family_name")!="少林寺" 
    && me->query_skill("babao-gun",1)<350 && !me->samsara_check("babao-gun") ) 
        return notify_fail("你八宝混元棍基础还不够扎实。\n"); 
        return 1;
}

int practice_skill(object me)
{
        int dod=(int)me->query_skill("dodge");
        int gun=(int)me->query_skill("babao-gun");

        if (dod/2<gun)
                return notify_fail("你的身法跟不上棍法，练下去很可能会伤到自己。\n");
        if ((int)me->query("kee") < 30)
                return notify_fail("你体质欠佳，强练八宝混元棍有害无益。\n");
        if ((int)me->query("force") < 5)
                return notify_fail("你内力不足，强练八宝混元棍有走火入魔的危险。\n");
        me->receive_damage("kee", 30);
        me->add("force", -5);
        message_vision("$N默默回忆了一会儿，然后练了一遍八宝混元棍。\n", me);
        return 1;
}

int valid_enable(string usage)
{
        return usage=="stick"||usage=="parry";
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

string perform_action_file(string func)
{
        return __DIR__"babao-gun/"+func;
}

