// dagou-bang.c 打狗棒法
// Modified by Venus Oct.1997
// write by Xiang
#include <ansi.h>
inherit SKILL;

mapping *action = ({
  ([ "action": "$N使出一招「棒打双犬」，手中$w化作两道青光砸向$n的$l",
    "dodge": -10,
    "damage": 30,
    "damage_type": "挫伤"
  ]),
  ([ "action": "$N手中$w左右晃动，一招「拨草寻蛇」向$n的$l攻去",
    "dodge": -20,
    "damage": 40,
    "damage_type": "挫伤"
  ]),
  ([ "action": "$N举起$w，居高临下使一招「打草惊蛇」敲向$n的$l",
    "dodge": -30,
    "damage": 50,
    "damage_type": "挫伤"
  ]),
  ([ "action": "$N施出「拨狗朝天」，$w由下往上向$n撩去",
    "dodge": -20,
    "damage": 40,
    "damage_type": "挫伤"
  ]),
});

int valid_enable(string usage) { return (usage == "stick") || (usage == "parry"); }

int valid_learn(object me) {
  object ob;
  if (me->query("dgbang_agree") == 0)
    return notify_fail("你还没有掌握打狗棒法的诀窍。\n");
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "stick")
    return notify_fail("你必须先找一根棒子才能练打狗棒法。\n");
  return 1;
}

mapping query_action(object me, object weapon) {
  if (me->query_temp("pfm_dagoubang/super")
    && me->query("force") > 1000) {
    me->add("force", -200);
    return ([
      "action": HIG "$N" HIG "眼中射出一道青芒，使出「天下无狗」，劈天盖地劈落" NOR,
      "damage": 300,
      "force": 100,
      "dodge": -80,
      "parry": -80,
      "damage_type": "挫伤" ]);
  }
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query_skill("dagou-bang", 1) < 350 && (int)me->query("dgbang_agree") < 2)
    return notify_fail("以你目前打狗棒法的修为还不能练习。\n");
  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 3)
    return notify_fail("你的内力或气不够，没有办法练习打狗棒法。\n");
  me->receive_damage("kee", 30);
  me->add("force", -3);
  write("你按着所学练了一遍打狗棒法。\n");
  return 1;
}

string perform_action_file(string action) {
  return "/daemon/class/forall/dagou-bang/" + action;
}
