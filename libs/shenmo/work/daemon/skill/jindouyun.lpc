// jindouyun.c

inherit SKILL;
#include <ansi.h>
string *dodge_msg = ({
	"$n轻轻一纵，使个「踏云步」，避开了这一招。\n",
	"$N眼一花，$n使出「翻云式」一个筋斗从$N头顶越过。\n",
	"$n一声：好！一招「追云式」连翻几个筋斗，连影子都没了。\n",
	"$n左足一点，一招「穿云式」腾空而起，避了开去。\n",
	"但是$n使一招「流云步」，身子轻轻飘了开去。\n",
	"可是$n胸腹往后一缩，在间不容发之际一个筋斗倒翻而出，好个「倒骑云」！\n",
	"只见$n一声长啸，卷起一股疾风，身形亦腾风而起，\n$N的攻击早失了准头。正是“筋斗云”中的「腾云式」！\n"
});

int valid_enable(string usage)
{
	return (usage=="dodge") || (usage=="move");
}

int valid_learn(object me)
{
	if( (int)me->query("max_force") < 0 )
		return notify_fail("你的内力不够，没有办法练筋斗云。\n");
        if( me->query("family/family_name")!="方寸山三星洞" && (int)me->query("spsk")!=11 && !me->samsara_check("jindouyun"))
                return notify_fail("筋斗云是方寸山三星洞不传之密。\n");

	return 1;
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
	if( (int)me->query("kee") < 30
	||	(int)me->query("force") < 3 )
		return notify_fail("你的气或内力不够，不能练筋斗云。\n");
        if( me->query("family/family_name")!="方寸山三星洞" && !me->samsara_check("jindouyun"))
                return notify_fail("筋斗云是方寸山三星洞不传之密。\n");
        if( me->query_skill("jindouyun", 1)>999 && !me->samsara_check("jindouyun"))
                return notify_fail("你的筋斗云已经不能再通过练习进步了。\n");
	me->receive_damage("kee", 30);
	me->add("force", -3);
	return 1;
}

int ob_hit(object ob, object me, int damage)
{
object wp1;
string msg;
int p,j=0,skill, neili, neili1;
wp1 = ob->query_temp("weapon");
skill = me->query_skill("jindouyun", 1);
neili = me->query("force");
neili1 = ob->query("force");

if (damage <10)
        damage=10;      

if(random(skill) > ob->query_skill("dodge", 1)/8
&& random(me->query("combat_exp")) > ob->query("combat_exp")/7
&& random(me->query("level")) > ob->query("level")/9
&& me->query_skill_mapped("dodge") == "jindouyun"
&& (int)ob->query("spskk")!=6
&& (int)ob->query("spskkk")!=2
&& neili > 100 && skill > 150)
    {
msg = "$n不见有任何动作，只是身子一晃一转，蹴的一下转到$N的背后。\n";
if ( !ob->query("env/no_msg"))
tell_object(ob, HIR "你只觉眼前一花，不见了对手的身影！\n" NOR);
if ( neili >= random(neili1)+damage ) 
        {
        msg+= WHT"结果$N的力道被$n完全躲开了！\n"NOR, 
        j = -damage;
        }
else if ( neili<random(neili1)+damage && neili*3/2>=random(neili1)+damage )
        {
        msg+= CYN"结果$n躲过了$N的一大半力道！\n"NOR, 
        j = -damage/4*3;
        }
else if ( neili*3/2<random(neili1)+damage && neili*2>=random(neili1)+damage )
        {
        msg+= YEL"结果$N的力道被躲过了一半！\n"NOR, 
        j = -damage/2;
        }
else    {
        msg+= BLU"结果$n只躲过了$N的一小半力道！\n"NOR, 
        j = -damage/4; 
        } 
if ( !j )
        return 0;                 
me->set_temp("dodge_skill_msg",msg);    
return j;
    }
}
