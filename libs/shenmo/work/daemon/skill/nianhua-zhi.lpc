int valid_enable(string usage)
{
if ( this_player()->query("门派/shaolin/宗派")=="拳" 
  || this_player()->query("family/family_name")== "少林寺" )
        return usage=="unarmed" || usage=="parry";
else    return usage=="unarmed";
}

int valid_learn(object me)
{
mapping shaolin;    
shaolin = me->query("门派/shaolin");

if ( !shaolin || !mapp(shaolin) || shaolin["luohan-quan"] )
        return notify_fail("你没有罗汉拳做根基,无法学习拈花指。\n");
if ( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
        return notify_fail("练拈花指法必须空手。\n");
if ( me->query_skill("yijinjing",1)<=550 )
        return notify_fail("你的易筋经功力不够，无法学习拈花指。\n");
return 1;
}

int practice_skill(object me)
{
if ( !valid_learn(me) )
        return 0;       
if ( me->query("kee")<300 )
        return notify_fail("你的体力太低了。\n");
if ( me->query("force")<100 )
        return notify_fail("你的内力不够练拈花指。\n");
me->receive_damage("kee",100,me);
me->add("force", -50);
return 1;
}

string perform_action_file(string func)
{
if ( (this_player()->query("门派/shaolin/宗派")=="拳"
   && this_player()->query("family/family_name")== "少林寺")
  || !userp(this_player()) )
        return CLASS_D("shaolin") + "/nianhua-zhi/levelup/" + func;
else    return CLASS_D("shaolin") + "/nianhua-zhi/" + func;
}

string query_parry_msg(object weapon)
{
if ( weapon )
        return parry_msg[random(sizeof(parry_msg))];
else    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

mapping query_action(object me, object weapon)
{
if ( this_player()->query("门派/shaolin/宗派")=="拳" 
  || this_player()->query("family/family_name")== "少林寺" )
        return action2[random(sizeof(action2))];
else    return action1[random(sizeof(action1))];
}

void skill_improved(object who)
{
mapping fam,shaolin;    
if ( !who ) 
        return;
//已有无相劫指的自动del拈花指
if ( who->query_skill("wuxiang-zhi",1)>0 )
        {
        tell_object(who,"你的拈花指早已晋升为无相劫指了。\n");
        who->delete_skill("nianhua-zhi");
        who->reset_action();
        who->save();
        return;
        }
fam = who->query("family");
shaolin = who->query("门派/shaolin");
if ( !fam || !mapp(fam)  
|| ( fam["family_name"]!="少林寺" 
  && ( (!shaolin || !mapp(shaolin)) ) ) )
        {
        tell_object(who,"你不是少林弟子,无法真正习得"+to_chinese("nianhua-zhi")+"的精髓。\n");
        who->delete_skill("nianhua-zhi");
        return;
        }
if ( fam["family_name"]!="少林寺" && who->query_skill("nianhua-zhi",1)>=550 )
        {
        tell_object(who,"可惜你对拈花指的领悟还不够全面。\n");  
        tell_object(who,HIC"你的「拈花指」到了停滞不前的地步！\n");     
        who->set_skill("nianhua-zhi",550);
        who->save();
        return;
        }
        
//没达到拈花指学习等级的
if ( !shaolin["luohan-quan"] )
        {
        tell_object(who,"你的罗汉拳基础不够,无法真正习得"+to_chinese("nianhua-zhi")+"的精髓。\n");
        who->delete_skill("nianhua-zhi");
        return;
        }
if ( who->query_skill("nianhua-zhi",1)>=450 )
        {
        tell_object(who,"你对拈花指的使用了如指掌。\n");
        tell_object(who,"你对拈花指的研究更进了一步。\n");
        tell_object(who,"你领悟了“拈花说法，无相无劫”的精髓。\n");
        tell_object(who,"你的拈花指晋升为无相劫指了。\n");
        shaolin["nianhua-zhi"]=1;
        who->delete_skill("nianhua-zhi");
        if ( !who->query_skill("wuxiang-zhi",1) )
                who->set_skill("wuxiang-zhi",1);
        who->map_skill("unarmed","wuxiang-zhi");
        who->map_skill("parry","wuxiang-zhi");  
        who->reset_action();
        who->save();
        message("channel:rumor",HIM"【千里眼】某人：听说"+who->name()+HIM"的拈花指晋升为无相劫指了。\n"NOR,users());
        }
return;
}
