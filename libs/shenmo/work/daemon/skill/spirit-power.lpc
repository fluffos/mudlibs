inherit SKILL;

int valid_enable(string usage) { return usage == "spells"; }

int valid_learn(object me) {
  if ((me->query("class") != "saint" || me->query("family/family_name") != "格斗家") && !me->samsara_check(
    "spirit-power",
    1
  ))
    return notify_fail("你非格斗家，自然学不得「精神力量」！\n");
  if ((int)me->query_skill("spells", 1) < 10
    || (int)me->query_skill("spells", 1) <= (int)me->query_skill("spirit-power", 1))
    return notify_fail("你的法术修为还不够高深，无法学习精神力量。\n");
  return 1;
}

string cast_spell_file(string spell) {
  return CLASS_D("sfighter") + "/spirit-power/" + spell;
}

string type() { return "magic"; }
