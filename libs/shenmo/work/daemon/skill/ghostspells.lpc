// ghostspells.c 【冥界之力】
inherit SKILL;
int valid_enable(string usage) { return usage == "spells"; }

int valid_learn(object me) {
  if ((int)me->query_skill("spells", 1) < 10
    || (int)me->query_skill("spells", 1) <= (int)me->query_skill("ghostspells", 1))
    return notify_fail("你的法术修为还不够高深。\n");
  return 1;
}

string cast_spell_file(string spell) {
  return CLASS_D("star") + "/ghost/ghostspells/" + spell;
}

string type() { return "magic"; }
