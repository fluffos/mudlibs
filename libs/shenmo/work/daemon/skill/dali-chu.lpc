#include <ansi.h>
inherit SKILL;

mapping *action = ({
  ([ "action": "$N高高举起$w，施一招「天神降世」，狠狠的向$n的$l砸去",
    "dodge": -50,
    "parry": -70,
    "damage": 130,
    "skill_name": "天神降世",
    "damage_type": "挫伤",
  ]),
  ([ "action": "$N拔地而起，半空中一个筋斗，手中$w一式「崩山」扫向$n",
    "dodge": -50,
    "parry": -50,
    "damage": 140,
    "skill_name": "崩山",
    "damage_type": "挫伤",
  ]),
  ([ "action": "$N手中$w舞动，一招「力撼九天」挟着震天撞击之声，猛砸$n",
    "dodge": -60,
    "parry": -50,
    "damage": 180,
    "skill_name": "力撼九天",
    "damage_type": "挫伤",
  ]),
  ([ "action": "$N施一招「佛嗔」，手中$w呼呼有声，连续砸向$n的各个部位",
    "dodge": 0,
    "parry": -30,
    "damage": 150,
    "skill_name": "佛嗔",
    "damage_type": "挫伤",
  ]),
  ([ "action": "$N横过手中$w，使出「轰顶」，手中$w劈空而下，击向$n$l",
    "dodge": -80,
    "parry": -50,
    "damage": 160,
    "skill_name": "轰顶",
    "damage_type": "挫伤",
  ]),
});

int valid_enable(string usage) {
  return usage == "stick" || usage == "parry";
}

int valid_learn(object me) {
  if (me->query("family/family_name") != "大昭寺" && !me->samsara_check("dali-chu", 1))
    return notify_fail("你非密宗弟子，难以领会无上大力杵的奥妙之处！\n");
  if ((int)me->query("max_force") < 300)
    return notify_fail("你的内力修为不够，难以修炼无上大力杵。\n");

  if ((int)me->query_skill("force") < 130)
    return notify_fail("你的内功火候太浅，难以修炼无上大力杵。\n");

  if ((int)me->query_skill("stick", 1) < 20)
    return notify_fail("你的基本棍法不够，难以修炼无上大力杵。\n");

  if ((int)me->query_skill("lamaism", 1) < (int)me->query_skill("dali-chu", 1) / 2)
    return notify_fail("你的密宗佛法水平有限，无法领会更高深的无上大力杵。\n");

  return 1;
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon")) ||
    (string)weapon->query("skill_type") != "stick")
    return notify_fail("你使用的武器不对。\n");

  if ((int)me->query("kee") < 40)
    return notify_fail("你的体力不够，练不了无上大力杵。\n");

  if ((int)me->query("force") < 50)
    return notify_fail("你的内力不够，练不了无上大力杵。\n");

  me->receive_damage("kee", 35);
  me->add("force", -40);

  return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  if (damage_bonus < 100) return 0;
  if (random(damage_bonus / 2) > victim->query_str() / 10 && !victim->is_busy()) {
    victim->start_busy(1);
    return HIW "$n" HIW "被$N" HIW "威猛的气势惊得目瞪口呆，手足无措！\n" NOR;
  }
}

string perform_action_file(string action) {
  return CLASS_D("dazhaosi") + "/dali-chu/" + action;
}
