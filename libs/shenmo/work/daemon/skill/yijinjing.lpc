
                                                                  // yijinjing.c

#include <ansi.h>
inherit FORCE;

int valid_enable(string usage) { return usage=="force"; }
int valid_learn(object me) {
       if ( me->query("class")!="human" && !me->samsara_check("yijinjing"))         return notify_fail("你非人族弟子，无法习得！\n");
 return 1;}

int practice_skill(object me)
{
        return notify_fail("易筋经神功只能用学的，或是从运用(exert)中增加熟练度。\n");
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
object weapon;
if ( damage_bonus < 100 ) 
        return 0;
weapon = me->query_temp("weapon"); 
if (weapon)
        return 0;
if ( random(3*(me->query_skill("yijinjing",1)))>(damage_bonus) 
 && me->query("family/family_name")=="少林寺"
 && me->query_skill("yijinjing", 1) > 199)
        {
        victim->receive_wound("kee", damage_bonus/5, me); 
        victim->receive_damage("kee", damage_bonus/4+random(damage_bonus/3), me); 
        message_vision(HIR"$N"HIR"运转易筋经神功，发力攻向$n"HIR"，$n"HIR"顿时被震出一口鲜血！\n"NOR,me,victim); 
        return 1;
        }
else    return 0;       
}

string exert_function_file(string func)
{
        return CLASS_D("shaolin") + "/yijinjing/" + func;
}
