inherit SKILL;

#include <ansi.h>

mapping *action = ({
  ([ "action":
    "$N一指点向$n的百汇穴。",
    "dodge": -40,
    "parry": -30,
    "force": 230,
    "damage_type": "指伤",
  ]),
  ([ "action":
    "$N一指点向$n的会阴穴。",
    "dodge": -20,
    "parry": -50,
    "force": 280,
    "damage_type": "指伤",
  ]),
  ([ "action":
    "$N一指点向$n的气海穴。",
    "dodge": -80,
    "parry": -30,
    "force": 654,
    "damage_type": "指伤",
  ]),
  ([ "action":
    "$N一指点向$n的尾闾穴。",
    "dodge": -30,
    "parry": -40,
    "force": 310,
    "damage_type": "指伤",
  ]),
  ([
    "action":
    "$N一指点向$n的章门穴。",
    "dodge": -70,
    "parry": -5,
    "force": 350,
    "damage_type": "指伤",
  ]),
  ([
    "action":
    "$N一指点向$n的太阳穴。",
    "dodge": -20,
    "parry": 15,
    "force": 260,
    "damage_type": "指伤",
  ]),
});

int valid_learn(object me) {

  if ((string)me->query("gender") == "女性")
    return notify_fail("自古没有女人可以学葵花心法的。\n");
  if ((string)me->query("gender") == "男性")
    return notify_fail("葵花心法第一要诀：欲练神功，必先自宫。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练葵花点穴手最好空手，不然弄坏了东西怎么办？\n");
  if ((int)me->query_skill("kuihua-xinfa", 1) < 60)
    return notify_fail("学习葵花点穴手必须能很好地控制自己的力量，把基础打好了再来吧！\n");
  if ((int)me->query("max_kee") < 399)
    return notify_fail("以你现在的体力，恐怕受不了葵花点穴手修炼的痛苦。\n");
  if ((int)me->query("max_sen") < 399)
    return notify_fail("以你现在的精力要修炼葵花点穴手简直是找死，爱惜生命吧！\n");



  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((string)me->query("gender") == "女性")
    return notify_fail("自古没有女人可以学葵花心法的。\n");
  if ((string)me->query("gender") == "男性")
    return notify_fail("葵花心法第一要诀：欲练神功，必先自宫。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练葵花点穴手最好空手，不然弄坏了东西怎么办？\n");
  if ((int)me->query_skill("kuihua-xinfa", 1) < 60)
    return notify_fail("学习葵花点穴手必须能很好地控制自己的力量，把基础打好了再来吧！\n");
  if ((int)me->query("max_kee") < 399)
    return notify_fail("以你现在的体力，恐怕受不了葵花点穴手修炼的痛苦。\n");
  if ((int)me->query("max_sen") < 399)
    return notify_fail("以你现在的精力要修炼葵花点穴手简直是找死，爱惜生命吧！\n");


  if ((int)me->query("sen") < 100)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if ((int)me->query("kee") < 100)
    return notify_fail("你现在体力不够了，休息一下再练吧。\n");
  if ((int)me->query("force") < 50)
    return notify_fail("你的体力不够了。\n");
  me->receive_damage("sen", 60);
  me->add("force", -20);

  return 1;
}

string perform_action_file(string func) {
  return CLASS_D("jjg") + "/kuihua-dianxue/" + func;
}

void skill_improved(object me) {
  tell_object(me, "哇，你好厉害呀，帅呀！\n");
}
