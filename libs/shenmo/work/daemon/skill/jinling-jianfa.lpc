int valid_learn(object me) {
  object ob;

  if ((string)me->query("family/family_name") != "神策军")
    return notify_fail(HIR 你 非 神 策 军 中 人 ， 难 以 领 会 金 灵 剑 法 的 奥 妙 之 处 。 \ n ");

   if( (int)me->query(" max_force ") < 500 )
     return notify_fail(" 你 的 内 力 不 够 。 \ n "NOR);
   if( (string)me->query_skill_mapped(" force ")!= " kuihua - baodian ")
     return notify_fail(HIR" 金 灵 剑 法 "NOR" 必 须 配 合 的 "HIR" 葵 花 宝 典 "NOR" 才 能 练 。 \ n ");
   if( (int)me->query_skill(" force ",1) < 100 && me->query(" family / class ")!=" qi ")
     return notify_fail(" 你 的 真 力 不 够 纯 熟 ， 没 有 办 法 学 "HIR" 金 灵 剑 法 。 \ n "NOR);
   if( (int)me->query_skill(" sword ",1) < 100 && me->query(" family / class ")!=" jian ")
     return notify_fail(" 你 的 剑 法 不 够 纯 熟 ， 没 有 办 法 学 "HIR" 金 灵 剑 法 。 \ n "NOR);
   if( (int)me->query_skill(" dodge ",1) < 100 && me->query(" family / class ")!=" ling ")
     return notify_fail(" 你 的 轻 功 不 够 ， 没 有 办 法 练 "HIR" 金 灵 剑 法 。 \ n "NOR);

   if( !(ob = me->query_temp(" weapon ")) || (string)ob->query(" skill_type ") != " sword " )
     return notify_fail(" 你 必 须 先 找 一 把 剑 才 能 练 剑 法 。 \ n ");

   return 1;
}

int valid_enable(string usage)
{
   return usage==" sword " || usage==" parry ";
}

mapping query_action(object me, object weapon)
{
    int level;
            
    level   = (int) me->query_skill(" jinling - jianfa ",1);

       if(random(level) > 200 && (int)me->query(" force ",1) > 500) { 
            if (me->query(" family / class ")==" jian ") {  
                me->add(" force ",-50);
              return actionj[random(sizeof(actionj))];                
              }
            if (me->query(" family / class ")==" qi ") {  
                me->add(" force ",-100);
              return actionq[random(sizeof(actionq))];                
              }
            if (me->query(" family / class ")==" ling ") {  
                me->add(" force ",-30);
              return actionl[random(sizeof(actionl))];                
             }
       }
          return action[random(sizeof(action))];
}  
