int practice_skill(object me)
{
int valid_learn(object me)
{
   if( !(ob = me->query_temp(" weapon "))
       || (string)ob->query(" skill_type ") != " sword " )
       return notify_fail(" 你 必 须 先 找 一 把 剑 才 能 练 剑 法 。 \ n ");
}

int valid_enable(string usage) { return usage==" unarmed "||usage==" parry "; }

mapping query_action(object me, object weapon)
{
    return action[random(sizeof(action))];
}

int practice_skill(object me)
{
if (me->query(" class ") != " human ")
	return notify_fail(" 你 又 不 是 人 族 。 \ n ");
if ( me->query(" family / family_name ")!=" 神 策 军 " 
  && me->query_skill(" jinling - jianfa ",1)<150 )
	return notify_fail(" 你 的 金 灵 剑 法 火 候 还 不 够 。 \ n ");
if( (int)me->query(" sen ") < 40)
	return notify_fail(" 你 的 精 神 无 法 集 中 了 ， 休 息 一 下 再 练 吧 。 \ n ");
if( (int)me->query(" kee ") < 40 )
	return notify_fail(" 你 现 在 手 足 酸 软 ， 休 息 一 下 再 练 吧 。 \ n ");
if( (int)me->query(" force ") < 10 )
	return notify_fail(" 你 的 内 力 不 够 了 。 \ n ");
me->receive_damage(" kee ", 5);
me->add(" force ", -10);
return 1;
}

string perform_action_file(string func)
{
return CLASS_D(" human ") + " / jjg / jinling - jianfa / " + func;
}
