int valid_learn(object me)
{
object ob;
me=this_player();
if (me->query("yumo_agree")!=1 )
       return notify_fail("玉魔剑法只能有缘者习之！\n");
if ((int)me->query_skill("qixiu-jian", 1)>50 )
       return notify_fail("原来这玉魔剑法与七修剑法本属同宗，却功行相悖，难以兼而有之！\n");
if ((int)me->query_skill("jadesword",1) > 59)
       return notify_fail("玉魔剑法精深奥妙，看来单纯通过学习或者练习是难以有更大进步的！\n");
    
    if ((int)me->query("max_force") < 100)
	return notify_fail("你的真气不足，难以领悟剑法的精妙之处。\n");
    
    if (!(ob = me->query_temp("weapon"))
	||	(string)ob->query("skill_type") != "sword" )
	return notify_fail("你必须先找一把剑才能练剑法。\n");
    
    return 1;
}

int valid_enable(string usage)
{
    return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
    return action[random(sizeof(action))];
}

int practice_skill(object me)
{
        return notify_fail("你试着练了几趟玉魔剑法，但是没有任何进步。\n");
}
string perform_action_file(string action)
{
        return "/daemon/class/forall/jadesword/"+action;
}
