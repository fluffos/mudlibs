#include <ansi.h>
inherit SKILL;

mapping *action = ({
  ([ "action":
    HIB "$N" HIB "左掌微分，右手一长使出一招「" NOR RED "冥王归来" NOR HIB "」，一股腐臭之气冲向$n" HIB "的$l" NOR,
    "dodge": 10,
    "parry": 15,
    "force": 100,
    "damage_type": "刺伤",
    "weapon": HIB "腐臭之气" NOR
  ]),
  ([ "action":
    HIB "$N" HIB "倏地一个转身，面上呈现诡异之色，现出「" NOR WHT "幽魂之色" NOR HIB "」，张口一吹，一股阴风直扑$n" NOR,
    "dodge": 20,
    "parry": -35,
    "force": 60,
    "damage_type": "内伤"
  ]),
  ([ "action":
    HIB "$N" HIB "身子微斜，随即跨出一步，双拳乱舞，杂乱无章，「" NOR BLU "群魂乱舞" NOR HIB "」，拍向$n" HIB "的$l" NOR,
    "dodge": 50,
    "parry": 10,
    "force": 80,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    HIB "$N" HIB "仰天长啸，「" NOR YEL "鬼哭狼嚎" NOR HIB "」中，双手化作" NOR WHT "幽冥之刃" NOR HIB "斜插$n" HIB "的$l" NOR,
    "dodge": 10,
    "parry": -10,
    "force": 200,
    "damage_type": "刺伤",
    "weapon": WHT "幽冥之刃" NOR
  ]),
  ([ "action":
    HIB "$N" HIB "双掌抱于胸前，一声大吼，掌呈" NOR HIG "碧绿，一股「" NOR HIY "黄泉之气" NOR HIB "」直扑向$n" HIB "$l" NOR,
    "dodge": 50,
    "parry": 20,
    "force": 80,
    "damage_type": "筑伤",
    "weapon": YEL "黄泉之气" NOR
  ]),
  ([ "action":
    HIB "$N" HIB "使出「" NOR BLU "虚无鬼影" NOR HIB "」，凌空跃起，冷不防在空中对准$n" HIB "$l踢出三脚" NOR,
    "dodge": -10,
    "parry": -20,
    "force": 120,
    "damage_type": "瘀伤"
  ]),
});

mapping *action_dog = ({
  ([ "action":
    "$N张开血盆大口朝着$n$l狠狠扑去",
    "dodge": 20,
    "parry": 10,
    "force": 100,
    "damage_type": "刺伤",
    "weapon": WHT "犬牙" NOR,
  ]),
  ([ "action":
    "$N纵身越起，在空中一个灵活的扭身，尾巴向$n$l狠狠抽去",
    "dodge": 30,
    "parry": 40,
    "force": 130,
    "damage_type": "抽伤",
    "weapon": YEL "尾巴" NOR,
  ]),
  ([ "action":
    "$N摇了摇三只硕大的头颅，从三只口中分别吐出" HIG "绿" NOR HIB "蓝" NOR HIR "赤" NOR "三色火焰烧向$n",
    "dodge": 10,
    "parry": 10,
    "force": 200,
    "damage_type": "淤伤",
    "weapon": ({ HIG "绿炎" NOR, HIB "蓝火" NOR, HIR "赤焰" NOR })[random(3)],
  ]),
});

string *parry_msg = ({
  YEL "$n" YEL "诡异一笑，脚下乱点，$N" YEL "眼前一花，已失去$n" YEL "的踪迹。\n" NOR,
  HIB "$n" HIB "一转身，一股" NOR YEL "腐朽之气" NOR HIB "顺势挡开$N的攻击。\n" NOR,
  MAG "$n" MAG "化作幻影在$N" MAG "周围乱舞，$N" MAG "一时无法作出攻击。\n" NOR,
});

string *parry_msg_dog = ({
  "$n摇摇尾巴，往前一窜，$N眼前一花，已失去$n的踪迹。\n" NOR,
  "$n巨头一摆，就地一滚，顺势躲开了$N的攻击。\n" NOR,
  "$n扭身将尾巴一甩，将$N的攻击挡开。\n" NOR,
});

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练冥王拳必须空手。\n");
  if ((int)me->query("max_force") < 50)
    return notify_fail("你的内力太弱，无法练习。\n");
  message_vision(RED "$N" RED "面露诡异之色，潜心修炼" NOR HIB "冥王拳" NOR RED "。\n" NOR, me);
  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  if (me->query("race") == "野兽")
    return action_dog[random(sizeof(action_dog))];
  return action[random(sizeof(action))];
}

string query_parry_msg(object weapon) {
  object me = this_player();
  if (me->query("race") == "野兽")
    return parry_msg_dog[random(sizeof(parry_msg_dog))];
  return parry_msg[random(sizeof(parry_msg))];
}

int practice_skill(object me) {
  if ((int)me->query("sen") < 40)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if ((int)me->query("kee") < 40)
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");
  if ((int)me->query("force") < 10)
    return notify_fail("你的内力不够了。\n");
  me->receive_damage("kee", 40);
  me->receive_damage("sen", 40);
  me->add("force", -10);
  return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  if (damage_bonus < 100) return 0;
  if (!victim || random(victim->query_str()) > damage_bonus / 3)
    return 0;
  damage_bonus = damage_bonus / 2 + random(damage_bonus);

  if (me->query("race") == "野兽") {
    if (random(2))
      victim->receive_wound("kee", damage_bonus / 3);
    else victim->receive_wound("sen", damage_bonus / 3);
    switch (random(3)) {
      case 0: return "$N一声咆哮，纵起身来，一口咬得$n$l鲜血淋漓！\n";
      case 1: return "$N尾巴一摇，狠狠抽在$n$l，$n闷哼一声，掩住伤口连连后退！\n";
      default: return "$n「哇」地一声，一口腥血逆口而出！\n";
    }
  } else {
    if (random(2))
      victim->receive_wound("kee", damage_bonus / 2);
    else
      victim->receive_wound("sen", damage_bonus / 2);
    switch (random(3)) {
      case 0: return YEL "$N" YEL "小宇宙高涨，听到「喀啦」一声轻响，$n" YEL "$l一阵骨碎的声音！\n" NOR;
      case 1: return MAG "$N" MAG "一声长啸，$n" MAG "闷哼一声，掩耳后退！\n" NOR;
      default: return BLU "$n" BLU "「哇」地一声，一口腥血逆口而出！\n" NOR;
    }
  }
}

string perform_action_file(string func) {
  return CLASS_D("star") + "/ghost/mingwang-quan/" + func;
}
