inherit SKILL;
#include <ansi.h>;

mapping *action = ({
  ([ "action": "$N双手虚晃，左脚猛地飞起，一式" + BLINK "" + HIW "「断子绝孙」" NOR + "，脚尖晃动，踢向$n的屁股",
    "parry": -20,
    "dodge": -50,
    "force": 120,
    "damage_type": "瘀伤",
    "skill_name": "断子绝孙"
  ]),
  ([ "action": "$N左脚顿地，别转身来抽身欲走，只一刹那间一回身，右脚一式
" + BLINK "" + HIB "「猴子偷桃」" NOR + "，猛踹$n的$l",
    "parry": -30,
    "dodge": -50,
    "force": 100,
    "damage_type": "瘀伤",
    "skill_name": "猴子偷桃"
  ]),
  ([ "action": "$N左手一挣，反手扭搭住$n的右手，右脚同时踹出，既猛且准，一
式" + BLINK "" + HIY "「子孙断绝」" NOR + "，踢中的$n的胸口",
    "parry": -50,
    "dodge": -60,
    "force": 150,
    "damage_type": "瘀伤",
    "skill_name": "子孙断绝"
  ]),
  ([ "action": "$N突然跃起，双足连环圈转，一式" + BLINK "" + HIG "「痛不欲生」" NOR + "，足带风尘，攻向$n的全身",
    "parry": -60,
    "dodge": -20,
    "force": 180,
    "damage_type": "瘀伤",
    "skill_name": "痛不欲生"
  ]),
});

int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }

int valid_learn(object me) {
  int i, f;

  i = 0;
  if (me->query_skill("bixie-canjian")) i += 1;
  if (me->query_skill("bixie-mijian")) i += 1;
  if (me->query_skill("kuihua-xinfa")) i += 1;
  if (me->query_skill("qiushen-blade")) i += 1;
  if (me->query_skill("rouqingjian")) i += 1;
  // if (me->query_skill("guimei"))        i+=1;

  f = 1;
  if ((int)me->query_skill("guimei", 1) > 1499) f = 6;
  else if ((int)me->query_skill("guimei", 1) > 849) f = 5;
  else if ((int)me->query_skill("guimei", 1) > 699) f = 4;
  else if ((int)me->query_skill("guimei", 1) > 549) f = 3;
  else if ((int)me->query_skill("guimei", 1) > 329) f = 2;
  else if ((int)me->query_skill("guimei", 1) > 249) f = 1;
  else f = 0;

  // if (f<i && !me->samsara_check("duanzijuesun-tui"))
  // return notify_fail("你必须参悟更深的断子绝孙腿才能研习更多的武技。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练习断子绝孙腿必须空手。\n");
  if ((int)me->query_skill("kuihua-xinfa", 1) < 100 && !me->samsara_check("duanzijuesun-tui"))
    return notify_fail("你的葵花心法火候不够，无法学习断子绝孙腿。\n");
  if ((int)me->query("max_force") < 200)
    return notify_fail("你的内力太弱，无法练习断子绝孙腿。\n");
  if (me->query("family/family_name") != "神策军"
    && me->query_skill("duanzijuesun-tui", 1) < 350 && !me->samsara_check("duanzijuesun-tui"))
    return notify_fail("你的断子绝孙腿尚未到独创一家的地步。\n");

  return 1;
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 50
    || (int)me->query("force") < 100)
    return notify_fail("你的内力或气不够，没有办法练习断子绝孙腿。\n");

  me->receive_damage("kee", 50);
  me->add("force", -100);
  write("你按着所学练了一遍断子绝孙腿。\n");
  return 1;
}

string perform_action_file(string func) {
  return CLASS_D("jjg") + "/duanzijuesun-tui/" + func;
}
