inherit SKILL;

mapping *action = ({
  ([ "action":
    "$N双手一晃，手中的$w如一条银蛇般飞向$n的$l",
    "dodge": -40,
    "damage": 60,
    "post_action": (: call_other, WEAPON_D, "throw_weapon" :),
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N右手一抖，$w发出刺耳的破空声直射$n的$l",
    "dodge": -40,
    "damage": 80,
    "post_action": (: call_other, WEAPON_D, "throw_weapon" :),
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N手指微动，$w斜斜的飞向$n的$l",
    "dodge": -40,
    "damage": 80,
    "post_action": (: call_other, WEAPON_D, "throw_weapon" :),
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N力发肩肘，右手一甩，手中的$w化作一道弧光射向$n的$l",
    "dodge": -50,
    "post_action": (: call_other, WEAPON_D, "throw_weapon" :),
    "damage": 100,
    "damage_type": "刺伤"
  ]),
});

int valid_learn(object me) {
  write("飞刀绝技乃三界通用投技，凭借你一人之力岂能参悟？\n");
  return 0;
}

int valid_enable(string usage) {
  return usage == "throwing" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  write("飞刀绝技乃三界通用投技，凭借你一人之力岂能参悟？\n");
  return 0;
}

string perform_action_file(string action) {
  return "/daemon/class/公共/feidao/" + action;
}

int effective_level() { return 15; }

int learn_bonus() {
  return -2220;
}
int practice_bonus() {
  return -1110;
}
int black_white_ness() {
  return 15;
}
