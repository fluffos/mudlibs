
inherit SKILL;

string *dodge_msg = ({
	"$n身形陡地变得飘忽不定，令$N无法看清。\n",
	"$n双脚点地，全身化为一道白影，急速绕着$N打了几转。\n",
	"$n如一阵清风，舒缓地闪过了$N的凌厉攻势。\n",
	"$n便如闲庭信步，在弹指间已然退出丈外。\n",
	"可是$n左一转，右一绕，身影已消失不见。\n",

});

int valid_enable(string usage) { return (usage=="dodge"); }

int valid_learn(object me)
{
	int i = (int)me->query_skill("guimei", 1);
	if ( me->query("family/family_name") != "神策军")
		return notify_fail("你不是神策军门下，难以领会这门功夫的精髓。\n");	return 1;
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
	int i = (int)me->query_skill("guimei", 1);
	if ( me->query("family/family_name") != "神策军")
		return notify_fail("你不是神策军门下，难以领会这门功夫的精髓。\n");
	if( (int)me->query("sen") < 30 )
		return notify_fail("你的精神太差了，不能练guimei步法。\n");
	if( me->query_int() < 25 )
		return notify_fail("你的悟性不足，无法自己修习鬼魅步法。\n");
	me->receive_damage("sen", 30);
	return 1;
}
string perform_action_file(string func)
{
       return CLASS_D("jjg") + "/guimei/" + func;
}