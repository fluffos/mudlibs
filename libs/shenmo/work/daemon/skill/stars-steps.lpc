//星座步法 stars-step.c

inherit SKILL;

string *dodge_msg = ({
        "$n幻作万点星光，避了开去。\n",
	"$n催动小宇宙，步法加快，避开了$N是攻击。\n",
	"只见$n身影一晃，一式「星光朦胧」，身子轻轻的从$N身旁掠过。\n",
	"$n开启第六感，识破了$N的攻势，轻松闪在一旁。\n",
	"只听$n轻蔑一笑，一招「银河光旋」，趁$N一发呆，身子轻轻飘了开去。\n",
	"$n借圣斗衣硬接$N一击，身子顺势向后纵出数尺，卸去了这一招的伤害。\n",
});

int valid_enable(string usage)
{
        return (usage=="dodge");
}

string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}


