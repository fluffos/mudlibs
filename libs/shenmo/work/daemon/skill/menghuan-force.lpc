inherit SKILL;
#include <ansi.h>
#include <combat.h>

string check() { return "force"; }

int valid_enable(string usage) {
  return usage == "force";
}

int valid_learn(object me) {
  return 1;
}

int practice_skill(object me) {
  return notify_fail(" 梦幻心法只能在学习中进步！\n");

}

int stage(int level) {
  if (level < 100) return 1;
  else if (level < 150) return 2;
  else if (level < 200) return 3;
  else if (level < 250) return 4;
  else if (level < 300) return 5;
  else if (level < 400) return 6;
  else if (level < 500) return 7;
  else if (level < 850) return 8;
  else if (level < 900) return 9;
  else return 10;
}

string level_description(int level) {
  if (stage(level) == 1)
    return HIC "琉 璃 光" NOR;
  else if (stage(level) == 2)
    return HIC "龙 神 甲" NOR;
  else if (stage(level) == 3)
    return HIC "纵 四 海" NOR;
  else if (stage(level) == 4)
    return HIW "笑 山 河" NOR;
  else if (stage(level) == 5)
    return HIY "乱 乾 坤" NOR;
  else if (stage(level) == 6)
    return HIG "渺 穹 苍" NOR;
  else if (stage(level) == 7)
    return HIR "小 天 位" NOR;
  else if (stage(level) == 8)
    return HIB "强 天 位" NOR;
  else if (stage(level) == 9)
    return HIM "斋 天 位" NOR;
  else
    return HIW "太 天 位" NOR;
}


void skill_improved(object me) {
  int level = (int)me->query_skill("menghuan-force", 1);
  string power_col;
  if (stage(level) == stage(level - 1) + 1) {
    me->set("power_lvl", stage(level));

    if (stage(level) == 1)
      power_col = HIC "琉璃光" NOR;
    else if (stage(level) == 2)
      power_col = HIC "龙神甲" NOR;
    else if (stage(level) == 3)
      power_col = HIC "翱四海" NOR;
    else if (stage(level) == 4)
      power_col = HIW "笑山河" NOR;
    else if (stage(level) == 5)
      power_col = HIY "乱乾坤" NOR;
    else if (stage(level) == 6)
      power_col = HIG "渺穹苍" NOR;
    else if (stage(level) == 7)
      power_col = HIR "小 天 位" NOR;
    else if (stage(level) == 8)
      power_col = HIB "强 天 位" NOR;
    else if (stage(level) == 9)
      power_col = HIM "斋 天 位" NOR;
    else
      power_col = BLK "太 天 位" NOR;

    me->set("power_col", power_col);
    message_vision(HIC "$N突觉灵台一片清明，无知无觉之间已进入 " + power_col + HIW " 境界!!!\n" NOR, me);

  }


}





string exert_function_file(string func) {
  return CLASS_D("tsrj") + "/menghuan-force/" + func;
}
