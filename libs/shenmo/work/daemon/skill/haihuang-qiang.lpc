#include "ansi.h"

inherit SKILL;

mapping *action = ({
  ([ "action": HBBLU "$N双手一别，尽力前伸，使出一招「波塞冬之指」，手中$w" NOR + HBBLU "平平直出，刺向$n的$l" NOR,
    "force": 40,
    "dodge": -30,
    "damage": 80,
    "skill_name": "波塞冬之指",
    "damage_type": "刺伤"
  ]),
  ([ "action": HBMAG "$N手中$w" NOR + HBMAG "盘旋回转，风响阵阵，屈身下蹲，反手一招「波塞冬之怒」自下向$n的$l刺去" NOR,
    "force": 40,
    "dodge": -15,
    "damage": 50,
    "skill_name": "波塞冬之怒",
    "damage_type": "内伤"
  ]),
  ([ "action": HBYEL "$N举起$w," NOR + HBYEL "抖出一朵枪花，一招「波塞冬之眼」向$n分心扎去" NOR,
    "force": 80,
    "dodge": -10,
    "damage": 100,
    "skill_name": "波塞冬之眼",
    "damage_type": "刺伤"
  ]),
  ([ "action": HBRED "$N一招「波塞冬之返」，手中$w" NOR + HBRED "划个小圈消去$n的后招，而后$w" NOR + HBRED "微抬，指向$n的$l" NOR,
    "force": 120,
    "dodge": -5,
    "damage": 100,
    "skill_name": "波塞冬之返",
    "damage_type": "内伤"
  ]),
});

int valid_enable(string usage) { return usage == "spear" || usage == "parry"; }

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int valid_effect(object me, object weapon, string name, int skill) {}

string perform_action_file(string action) {
  return CLASS_D("star/sea") + "/haihuang-qiang/" + action;
}
