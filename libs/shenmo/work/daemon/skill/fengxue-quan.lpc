//奥丁风雪拳fengxue-quan

#include <ansi.h>
inherit SKILL;

mapping *action = ({
([	"action" : HIW"$N"HIW"身子微挫，怒吼一声「千重寒风」，腰马运力，一拳带着寒风直捅$n"HIW"的$l"NOR,
	"force" : 70,
	"dodge" : 0,
       "parry" : 10,
	"skill_name" : "千重寒风",
	"damage_type" : "瘀伤"
]),
([	"action" : HIW"$N"HIW"“嘿嘿”一笑，双拳一前一后，一招「风雪交加」，交替打向$n"NOR,
	"force" : 100,
	"dodge" : 15,
       "parry" : 15,
	"skill_name" : "风雪交加",
	"damage_type" : "瘀伤"
]),
([	"action" : HIW"$N"HIW"对$n"HIW"一声大喝，使一招「风霜满面」，双拳齐发，两股寒风打向$n"HIW"的$l"NOR,
	"force" : 130,
	"dodge" : 10,
       "parry" : 20,
	"skill_name" : "风霜满面",
	"damage_type" : "震伤"
]),
([	"action" : HIW"$N"HIW"闷喝一声，双拳兵分两路，一记「雪花乱飞」，拳划弧线，左右同时击向$n"HIW"的$l"NOR,
	"force" : 60,
	"dodge" : 10,
       "parry" : 10,
	"skill_name" : "雪花乱飞",
	"damage_type" : "内伤"
]),
([	"action" : HIW"$N"HIW"施出「奥丁之力」，冲上前来，发起一阵暴风骤雨般的攻击!"NOR,
	"force" : 90,
	"dodge" : 20,
       "parry" : 25,
	"skill_name" : "奥丁之力",
	"damage_type" : "撞伤"
]),
([	"action" : HIW"$N笑吼一声，凌空飞起，一式「瑞雪丰年」，居高临下，带着一股摄人的寒意冲向$n!"NOR,
	"force" : 50,
	"dodge" : 50,
       "parry" : 50,
	"skill_name" : "瑞雪丰年",
	"damage_type" : "撞伤"
])
});

int valid_enable(string usage) { return usage=="unarmed" || usage=="parry"; }

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int valid_effect(object me, object weapon, string name, int skill)
{
}

string perform_action_file(string action)
{
      return "/daemon/class/star/ice/fengxue-quan/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
object weapon = me->query_temp("weapon");     
string msg;
       
if( ( damage_bonus > 350 ) && (userp(me)))
	return 0;

if(me->query("force")<200) 
	return 0;
          
if(damage_bonus<250) damage_bonus= 250;
          
if ( random(5)==5 )
	{
	victim->receive_wound("kee", (450-damage_bonus) );
	msg = HIW"\n$N"HIW"小宇宙异常高涨，拳风中风雪之声愈加浓烈！\n"NOR;
	message_vision(msg,me,victim);
	}
switch(random(3)) 
	{
	case 0:
		{ 
		victim->receive_damage("kee",damage_bonus/3*2);
		msg = HIW"\n$n"HIW"被$N"HIW"拳风中的寒意冻得神情萎靡！\n"NOR;
		break;
		}
                                
       case 1:
		{  
		msg = HIW"\n$N"HIW"拳风一涨，$n"HIW"被铺天盖地的风霜冻得动弹不得！\n"NOR;
              victim->start_busy(1+random(2) );
		break;
		}
                                
	case 2:
		{  
		msg =HIR"\n$N嘿嘿一笑，默运奥丁神力，$n"HIR"突然觉得体内真气不受控制的外泄而出！\n"NOR;
		if ( victim->query("force")>=2500 )
			{
			victim->add("force",-2000);
			me->add("force",random(2000));
			if ( me->query("force")>=me->query("max_force")*2 )
				me->set("force",(int)me->query("max_force")*2) ;
			}
		else  {
			victim->add("force",-(int)victim->query("force")*3/4);
			me->add("force",random((int)victim->query("force")*3/4));
			if ( me->query("force")>=me->query("max_force")*2 )
				me->set("force",(int)me->query("max_force")*2) ;
			}		
		break;
		}
	}
message_vision(msg,me,victim);
return 0;
}
