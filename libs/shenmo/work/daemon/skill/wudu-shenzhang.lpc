int valid_enable(string usage)
{
        return usage == "parry" || usage == "unarmed";
}
int valid_learn(object me)
{
if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
                return notify_fail("练五毒神掌必须空手。\n");
        if ((int)me->query_skill("force") < 150)
                return notify_fail("你的内功火候不够，无法练五毒神掌。\n");
        if ((int)me->query("max_force") < 1200)
                return notify_fail("你的内力太弱，无法练五毒神掌。\n");
        if ((int)me->query_skill("unarmed", 1) < 120)
                return notify_fail("你的扑击格斗之术火候不够，无法练五毒神掌。\n");
if ((int)me->query_skill("unarmed", 1) < (int)me->query_skill("wudu-shenzhang", 1))
                return notify_fail("你的扑击格斗之术水平有限，无法领会更高深的五毒神掌。\n");
        return 1;
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}
int practice_skill(object me)
{
if ((int)me->query("kee") < 90)
                return notify_fail("你的体力太低了。\n");
if ( me->query("family/family_name")!="黄花观五毒门"  && me->query_skill("jinwu-goufa",1)<350 ) 
return notify_fail("非妖魔之身不可习也。\n"); 
        if ((int)me->query("force") < 80)
                return notify_fail("你的内力不够练五毒神掌。\n");
        me->receive_damage("kee", 30);
        me->add("force", -50);
        return 1;
}
string perform_action_file(string action)
{
        return CLASS_D("wudu") + "/wudu-shenzhang/" + action;
}

