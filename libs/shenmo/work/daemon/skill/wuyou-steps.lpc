// Wuyou-steps.c 无忧步法
// Cracked by 凌惊雪 4-1-2003

#include <ansi.h>

inherit SKILL;

string *dodge_msg = ({
  "$n身形陡地变得飘忽不定，令$N无法看清。\n",
  "$n双脚点地，全身化为一道白影，急速绕着$N打了几转。\n",
  "$n如一阵清风，舒缓地闪过了$N的凌厉攻势。\n",
  "$n便如闲庭信步，在弹指间已然退出丈外。\n",
  "可是$n左一转，右一绕，身影已消失不见。\n",

});

int valid_enable(string usage) {
  return "dodge" == usage;
}

int valid_learn(object me) {
  int i = (int)me->query_skill("wuyou-steps", 1);
  int j = (int)me->query_skill("baihua-force", 1);

  if ("百花谷" != me->query("family/family_name")) {
    return notify_fail("你不是百花谷门下，难以领会这门功夫的精髓。\n");
  }

  if (i >= j) {
    return notify_fail("你的花开四季心法不够高深，强学小心走火入魔。\n");
  }

  return 1;
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  int i = (int)me->query_skill("wuyou-steps", 1);
  int j = (int)me->query_skill("baihua-force", 1);

  if ("百花谷" != me->query("family/family_name")) {
    return notify_fail("你不是百花谷门下，难以领会这门功夫的精髓。\n");
  }

  if (i >= j) {
    return notify_fail("你的花开四季心法不够高深，强学小心走火入魔。\n");
  }

  if ((int)me->query("sen") < 30) {
    return notify_fail("你的精神太差了，不能练无忧步法。\n");
  }

  if (me->query("int") < 40) {
    return notify_fail("你的悟性不足，无法自己修习无忧步法。\n");
  }

  me->receive_damage("sen", 30);
  return 1;
}

string perform_action_file(string func) {
  return CLASS_D("baihuagu") + "/wuyou-steps/" + func;
}

int ob_hit(object ob, object me, int damage) {
  string msg;
  int skill, neili;
  int j = 0;

  skill = me->query_skill("wuyou-steps", 1);
  neili = me->query_skill("dodge");

  if (skill <= random(ob->query_skill("dodge", 1))
    || random(me->query("combat_exp")) <= ob->query("combat_exp") / 3
    || me->query_skill_mapped("dodge") != "wuyou-steps"
    || neili <= 500 || skill <= 500 || random(10) <= 5
  ) {
    return 0;
  }

  if (neili < random(ob->query_skill("dodge"))) {
    return 0;
  }

  msg = random(2) ? HIR + dodge_msg[random(sizeof(dodge_msg))] + NOR : HIC + dodge_msg[random(sizeof(dodge_msg))] + NOR;
  msg += HIW "结果$N" HIW "的力道被基本躲开了！\n" NOR;

  message_vision(msg, ob, me);

  j = -(damage / 4 + random(damage / 4));

  return j;
}
