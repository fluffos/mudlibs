int valid_enable(string usage) { return usage == "unarmed"; }
int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练六脉神剑必须空手。\n");
  if ((int)me->query_skill("force", 1) < 200)
    return notify_fail("你的基本内功火候不够，无法学六脉神剑。\n");
  if ((int)me->query("max_force") < 4000)
    return notify_fail("你的内力太弱，无法练六脉神剑。\n");
  return 1;
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}
int practice_skill(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练六脉神剑必须空手。\n");
  if ((int)me->query("kee") < 50)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("force") < 80)
    return notify_fail("你的内力不够练六脉神剑!\n");
  me->receive_damage("kee", 40);
  me->add("force", -70);
  return 1;
}
string perform_action_file(string action) {
  return CLASS_D("forall") + "/liumai-shenjian/" + action;
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  int dxlvl, txlvl;
  dxlvl = (int)me->query_skill("liumai-shenjian", 1);
  txlvl = (int)victim->query_skill("dodge", 1);
  txlvl += (int)victim->query_skill("parry", 1);
  if (dxlvl < 300) return;
  if (dxlvl > random(txlvl) / 3) {
    victim->receive_wound("kee", damage_bonus, me);
    switch (random(3)) {
      case 2: if (!victim->is_busy()) victim->start_busy(1 + random(2));
      return HIR "$n浑身一麻，已经行动不得\n" NOR;
      case 1: if (!victim->is_busy()) victim->start_busy(1);
      return HIR "$n半身一麻，感觉行动有些困难！\n" NOR;
      case 0: return HIR "你听到“嗤”的一声轻响，竟然有剑气破空之声！\n" NOR;
    }
  }
}
