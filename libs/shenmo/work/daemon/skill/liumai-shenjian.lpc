    "force": 180,
    "dodge": 30,
    "damage": 120,
    "skill_name": "关冲剑",
    "damage_type": "刺伤",
    "weapon": "无形剑气"
  ]),
  ([ "action": "$N右手食指连点,使出「" + CYN + "少商剑" + NOR + "」,指端真气激荡，如虚如幻地刺至$n的$l",
    "force": 200,
    "dodge": -40,
