inherit SKILL;

string *dodge_msg = ({
  "$n一式「千里长空聚萍踪」，随着$N的攻势飘起，从容闪过这一招。\n",
  "$n使出「东风是恶欢情薄」，猛然纵起丈余，结果$N扑在了空气中。\n",
  "$n身形一摇，幻出几个虚影，一式「身似浮萍无归处」躲过了$N的攻势。\n",
  "$n使出「流水落花春去也」纵身跃起，倏忽已落至$N身后。\n",
  "$n左一摇，右一晃，一式「乱红飞过秋千去」已轻松闪过。\n",
  "$n双足一点，斜斜飞起，使出「长空万里会秋燕」已飘到$N身侧。\n",
  "$n轻身一晃，一式「无计应悔春风意」，轻轻闪过。\n",
  "$n身形突地变稳，「蓬莱几度入梦来」顿然幻出，倏忽已落至$N身后。\n",
  "$n身形猛然变快，一式「逢春方知花如许」，$N顿时迷失了$n的身影。\n",
});

int valid_enable(string usage) {
  return (usage == "dodge");
}

int valid_learn(object me) {
  return 1;
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  if ((int)me->query("sen") < 50)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if ((int)me->query("kee") < 50)
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");
  if ((int)me->query("force") < 20)
    return notify_fail("你的内力不够练习浮空术。\n");
  me->receive_damage("kee", 30);
  me->add("force", -10);
  return 1;
}
string perform_action_file(string action) {
  return CLASS_D("qishituan") + "/fukong-shu/" + action;
}
