/*三界神话V2.0版本*/

inherit SKILL;
int valid_enable(string usage) {
  return usage == "literate";
}

#include <ansi.h>

int valid_learn(object me) {
  object ob;

  if ((int)me->query("level") < 5)
    return notify_fail("" HIW "你的等级不够还不能学习医术." NOR "\n");

  if ((int)me->query_skill(
    "medical",
    1
  ) + 1 > 900 || ((int)me->query_skill(
    "medical",
    1
  ) + 1 > 800 && me->query("family/family_name") != "三圣宫"))
    //除去三圣宫可以学习到900 之外，其他门派只能学习到800， 剩下的只有靠读书了。
    return notify_fail("" HIW "你已得医术的精髓了，不用在学了。" NOR "\n");

  if ((int)me->query_skill("medical", 1) > ((int)me->query("level") - 5) * 2)
    //从5-200级每一级等级可以学4级医术技能。
    return notify_fail("" HIW "你的等级不够,不能继续学习医术这样技能了。" NOR "\n");

  return 1;
}



string level_description(int level) {
  int grade;
  string *level_desc = ({
    BLU "一知半解" NOR,
    HIB "粗通皮毛" NOR,
    YEL "开方抓药" NOR,
    YEL "悬壶济世" NOR,
    HIY "小有名气" NOR,
    HIY "药到病除" NOR,
    BRED YEL "妙手回春" NOR,
    CYN "名扬四海" NOR,
    HIC "华佗再世" NOR,
    BRED HIW "扁鹊重生" NOR,
    HIY "起死回生" NOR
  });

  grade = level / 100;

  if (grade >= sizeof(level_desc))
    grade = sizeof(level_desc) - 1;
  return level_desc[grade];
}
