// buduolunhui-dafa.c 【不堕轮回大法】
// BY Cigar 2002.04.19
#include <ansi.h>
inherit SKILL;

int valid_enable(string usage) { return usage == "spells"; }

int valid_learn(object me) {
  if ((int)me->query_skill("spells", 1) < 10
    || (int)me->query_skill("spells", 1) <=
    (int)me->query_skill("buduolunhui-dafa", 1))
    return notify_fail(RED "你的法术修为还不够高深，无法修行不堕轮回大法。\n" NOR);
  return 1;
}

string cast_spell_file(string spell) {
  return CLASS_D("lunhui") + "/buduolunhui-dafa/" + spell;
}

string type() { return "magic"; }
