// tiyunzong.c 梯云纵
// modified by fang
// written by fang
#include <ansi.h>
inherit SKILL;

string *dodge_msg = ({
    "只见$n一招「白鹤冲天」，身体向上笔直地纵起丈余，躲过了$N这一招。\n",
    "$n一个「鹞子翻身」，向后纵出数丈之远，避开了$N的凌厉攻势。\n",
    "$n使出「大鹏展翅」，向一旁飘然纵出，轻轻着地。\n"
    "但是$n身形飘忽，轻轻一纵，早已避开。\n",
    "$n身随意转，倏地往一旁挪开了三尺，避过了这一招。\n",
    "可是$n侧身一让，$N这一招扑了个空。\n",
    "却见$n足不点地，往旁窜开数尺，躲了开去。\n",
    "$n身形微晃，有惊无险地避开了$N这一招。\n"
});

int valid_enable(string usage) { return (usage == "dodge") || (usage == "move");
 }

int valid_learn(object me) { 
        if( me->query("family/family_name")!="武当派" && !me->samsara_check("tiyunzong",1))
                return notify_fail("你非武当弟子，难以领会梯云纵的奥妙之处！\n");
        
        return 1; }

string query_dodge_msg(string limb)
{
    return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
    if( (int)me->query("kee") < 40 )
   return notify_fail("你的体力太差了，不能练梯云纵。\n");
        if( (int)me->query_skill("tiyunzong", 1) > 1499)
                return notify_fail("你的梯云纵已经不能再通过练习提高了。\n");
    me->receive_damage("kee", 30);
   me->add("force", -3);  return 1;
}

int ob_hit(object ob, object me, int damage)
{
object wp1;
string msg;
int p,j=0,skill, neili, neili1;
wp1 = ob->query_temp("weapon");
skill = me->query_skill("tiyunzong", 1);
neili = me->query("force");
neili1 = ob->query("force");

if (damage <10)
        damage=10;      

if(random(skill) > ob->query_skill("dodge", 1)/6
&& random(me->query("combat_exp")) > ob->query("combat_exp")/6
&& random(me->query("level")) > ob->query("level")/6
&& me->query_skill_mapped("dodge") == "tiyunzong"
&& (int)ob->query("spsk")!=14
&& (int)ob->query("spskkk")!=2
&& neili > 100 && skill > 150)
    {
msg = "$n不见有任何动作，只是身子一晃一转，蹴的一下转到$N的背后。\n";
if ( !ob->query("env/no_msg"))
tell_object(ob, HIR "你只觉眼前一花，不见了对手的身影！\n" NOR);
if ( neili >= random(neili1)+damage ) 
        {
        msg+= WHT"结果$N的力道被$n完全躲开了！\n"NOR, 
        j = -damage;
        }
else if ( neili<random(neili1)+damage && neili*3/2>=random(neili1)+damage )
        {
        msg+= CYN"结果$n躲过了$N的一大半力道！\n"NOR, 
        j = -damage/4*3;
        }
else if ( neili*3/2<random(neili1)+damage && neili*2>=random(neili1)+damage )
        {
        msg+= YEL"结果$N的力道被躲过了一半！\n"NOR, 
        j = -damage/2;
        }
else    {
        msg+= BLU"结果$n只躲过了$N的一小半力道！\n"NOR, 
        j = -damage/4; 
        } 
if ( !j )
        return 0;                 
me->set_temp("dodge_skill_msg",msg);    
return j;
    }
}
