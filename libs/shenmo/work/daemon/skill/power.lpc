inherit SKILL;
#include <ansi.h>
#include <sfighter_skill.h>
#include <combat.h>

string check() { return "force"; }

int valid_enable(string usage) {
  return usage == "force";
}

int valid_learn(object me) {

  if ((me->query("class") != "saint" || me->query("family/family_name") != "格斗家") && !me->samsara_check(
    "power",
    1
  ))
    return notify_fail("你非格斗家，自然学不得「鬭气力量」！\n");
  if (me->query("faith") / 500 < (me->query_skill(
    "power",
    1
  ) - 500) / 50) return notify_fail("你需要为格斗家多做贡献，才能学习该技能！\n");
  return 1;
}

int practice_skill(object me) {
  return notify_fail(" 鬭气力量 只能用学的，或是从运用(exert)中增加熟练度。\n");

}

void skill_improved(object me) {
  int level = (int)me->query_skill("power", 1);
  string power_col;
  if (stage(level) == stage(level - 1) + 1) {
    me->set("power_lvl", stage(level));

    if (stage(level) == 1)
      power_col = HIC "X 级力量" NOR;
    else if (stage(level) == 2)
      power_col = HIC "Z 级力量" NOR;
    else if (stage(level) == 3)
      power_col = HIC "V 级力量" NOR;
    else if (stage(level) == 4)
      power_col = HIW "白 鬭 气" NOR;
    else if (stage(level) == 5)
      power_col = HIY "黄 鬭 气" NOR;
    else if (stage(level) == 6)
      power_col = HIG "绿 鬭 气" NOR;
    else if (stage(level) == 7)
      power_col = HIR "红 鬭 气" NOR;
    else if (stage(level) == 8)
      power_col = HIB "蓝 鬭 气" NOR;
    else if (stage(level) == 9)
      power_col = HIM "紫 鬭 气" NOR;
    else
      power_col = BLK "黑 鬭 气" NOR;

    me->set("power_col", power_col);
    message_vision(HIC "$N突觉全身充满力量，灵台一片清明，进入 " + power_col + HIC " 境界!!!\n" NOR, me);

  }


}

