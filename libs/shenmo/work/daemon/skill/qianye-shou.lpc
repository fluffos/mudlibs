int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }

int valid_learn(object me) {
  mapping shaolin;
  shaolin = me->query("门派/shaolin");

  if (!shaolin || !mapp(shaolin) || shaolin["jingang-zhi"])
    return notify_fail("你没有大力金刚指做根基,无法学习如来千叶手。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练如来千叶手法必须空手。\n");
  return 1;
}

int practice_skill(object me) {
  if (me->query("kee") < 500)
    return notify_fail("你的体力太低了。\n");
  if (me->query("force") < 500)
    return notify_fail("你的内力不够练如来千叶手。\n");
  me->receive_damage("kee", 10, me);
  me->add("force", -20);
  return 1;
}

string perform_action_file(string action) {
  return CLASS_D("shaolin") + "/qianye-shou/" + action;
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

void skill_improved(object who) {
  mapping fam, shaolin;
  if (!who)
    return;
  //非少林弟子只能950的如来千叶手
  if (who->query("family/family_name") != "少林寺"
    && who->query_skill("qianye-shou", 1) >= 950) {
    tell_object(who, "可惜你对如来千叶手的领悟还不够全面。\n");
    tell_object(who, HIC "你的「如来千叶手」到了停滞不前的地步！\n");
    who->set_skill("jingang-zhi", 950);
    who->save();
    return;
  }
  fam = who->query("family");
  shaolin = who->query("门派/shaolin");
  if (!fam || !mapp(fam)
    || (fam["family_name"] != "少林寺"
      && ((!shaolin || !mapp(shaolin))))) {
    tell_object(who, "你不是少林弟子,无法真正习得" + to_chinese("qianye-shou") + "的精髓。\n");
    who->delete_skill("qianye-shou");
    return;
  }
  //没达到如来千叶手学习等级的
  if (!shaolin["jingang-zhi"]) {
    tell_object(who, "你的大力金刚指基础不够,无法真正习得" + to_chinese("qianye-shou") + "的精髓。\n");
    who->delete_skill("qianye-shou");
    return;
  }
  return;
}
