// mingyu-jue.c 

inherit SKILL;

int valid_enable(string usage) { return usage=="spells"; }

int valid_learn(object me)
{
       if ( me->query("class")!="human" && !me->samsara_check("mingyu-jue"))         return notify_fail("你非人族弟子，无法习得！\n");
        if( (int)me->query_skill("spells", 1) < 10
        ||      (int)me->query_skill("spells", 1) <=
(int)me->query_skill("mingyu-jue", 1) )
                return
notify_fail("你的法术修为还不够高深，无法学习明玉诀。\n");
        return 1;
}

string cast_spell_file(string spell)
{
        return CLASS_D("yhg") + "/mingyu-jue/" + spell;
}

string type() { return "magic"; }

