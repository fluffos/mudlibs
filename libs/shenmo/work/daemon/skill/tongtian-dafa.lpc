// dengxian-dafa.c 【登仙大法】
inherit SKILL;

int valid_enable(string usage) { return usage == "spells"; }

int valid_learn(object me) {
  if (me->query("class") != "saint") return notify_fail("你非圣族弟子，无法习得！\n");
  if ((int)me->query_skill("spells", 1) < 10
    || (int)me->query_skill("spells", 1) <=
    (int)me->query_skill("tongtian-dafa", 1))
    return notify_fail("你的法术修为还不够高深，无法学习通天大法。\n");
  if (me->query("faith") / 500 < (me->query_skill(
    "tongtian-dafa",
    1
  ) - 500) / 50) return notify_fail("你需要为通天教多做贡献，才能学习该技能！\n");
  return 1;
}

string cast_spell_file(string spell) {
  return CLASS_D("tongtianjiao") + "/tongtian-dafa/" + spell;
}

string type() { return "magic"; }
