//
// yujiamu-quan.c 金刚瑜迦母拳
//

#include <ansi.h>
inherit SKILL;

mapping *action = ({
  ([ "action": "$N并举双拳，使出一招「灌顶」，当头砸向$n的$l  ",
    "skill_name": "灌顶",
    "force": 160,
    "parry": -50,
    "dodge": 5,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N使出一招「解苦」，身形一低，左手护顶，右手一拳击向$n的裆部  ",
    "skill_name": "解苦",
    "force": 200,
    "parry": -60,
    "dodge": -5,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N使出一招「颦眉」，左拳虚击$n的前胸，一错身，右拳横扫$n的太阳穴  ",
    "skill_name": "颦眉",
    "force": 220,
    "parry": -70,
    "dodge": 10,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N神形怪异，使一招「嗔恚」，双拳上下击向$n的$l  ",
    "skill_name": "嗔恚",
    "force": 250,
    "parry": -50,
    "dodge": 5,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N使出一招「静寂」，双拳交错，缓缓击出，劲气直指$n的$l  ",
    "skill_name": "静寂",
    "force": 270,
    "parry": -60,
    "dodge": -5,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N微微一笑，使出一式「妙音」，双拳前后击出，直取$n的左胸  ",
    "skill_name": "妙音",
    "force": 300,
    "parry": -45,
    "dodge": 10,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N使出一招「明心」，全身疾转，双拳横扫$n的$l  ",
    "skill_name": "明心",
    "force": 310,
    "parry": -35,
    "dodge": 20,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N飞身一跃，使出一招「制胜」，一拳猛击$n咽喉  ",
    "skill_name": "制胜",
    "force": 330,
    "parry": -50,
    "dodge": 5,
    "damage_type": "瘀伤",
  ]),
});

int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }

int valid_learn(object me) {
  if ((me->query("class") != "saint" || me->query("family/family_name") != "大昭寺") && !me->samsara_check(
    "yujiamu-quan",
    1
  ))
    return notify_fail("密宗的绝招,你从那里偷学的?\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练金刚瑜迦母拳必须空手。\n");

  if ((int)me->query("max_force") < 600)
    return notify_fail("你的内力不够。\n");

  if ((int)me->query_skill("force") < 100)
    return notify_fail("你的内功火候不够。\n");

  if ((int)me->query_skill("lamaism", 1) < (int)me->query_skill("yujiamu-quan", 1) / 2)
    return notify_fail("你的密宗佛法修为不够，无法领会更高深的金刚瑜迦母拳。\n");

  return 1;
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  object weapon;

  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练金刚瑜迦母拳必须空手。\n");

  if ((int)me->query("kee") < 60)
    return notify_fail("你的体力不够，练不了金刚瑜迦母拳。\n");

  if ((int)me->query("force") < 70)
    return notify_fail("你的内力不够，练不了金刚瑜迦母拳。\n");

  me->receive_damage("kee", 50);
  me->add("force", -61);
  return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  if (damage_bonus < 100) return 0;
  if (random(damage_bonus / 2) > victim->query_str() / 10) {
    victim->receive_wound("kee", (damage_bonus - 50) / 5);
    switch (random(2)) {
      case 0: return HIR "你听到「喀啦」一声轻响，竟似是骨头爆裂的声音！\n" NOR;
      case 1: return HIY "$N" HIY "劲力一吐，$n" HIY "的$l发出「喀」地一声爆响！\n" NOR;
    }
  }
}

string perform_action_file(string action) {
  return CLASS_D("dazhaosi") + "/yujiamu-quan/" + action;
}
