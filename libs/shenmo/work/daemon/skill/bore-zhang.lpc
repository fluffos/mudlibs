int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }

int valid_learn(object me) {
  int i, f;

  i = 0;
  if (me->query_skill("suixing-tui")) i += 1;
  if (me->query_skill("jingang-zhi")) i += 1;
  if (me->query_skill("damo-jian")) i += 1;
  if (me->query_skill("cibei-dao")) i += 1;
  if (me->query_skill("longzhua-gong")) i += 1;
  if (me->query_skill("zui-gun")) i += 1;

  f = 1;
  if ((int)me->query_skill("chanzong", 1) > 1499) f = 6;
  else if ((int)me->query_skill("chanzong", 1) > 1249) f = 5;
  else if ((int)me->query_skill("chanzong", 1) > 999) f = 4;
  else if ((int)me->query_skill("chanzong", 1) > 749) f = 3;
  else if ((int)me->query_skill("chanzong", 1) > 499) f = 2;
  else if ((int)me->query_skill("chanzong", 1) > 249) f = 1;
  else f = 0;

  if (f < i && !me->samsara_check("bore-zhang"))
    return notify_fail("你必须参悟更深的禅宗佛法才能研习更多的少林武技。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练习般若掌必须空手。\n");
  if ((int)me->query_skill("yijinjing", 1) < 100 && !me->samsara_check("bore-zhang"))
    return notify_fail("你的易筋经神功火候不够，无法学习般若掌。\n");
  if ((int)me->query("max_force") < 200)
    return notify_fail("你的内力太弱，无法练习般若掌。\n");
  if (me->query("family/family_name") != "少林寺"
    && me->query_skill("bore-zhang", 1) < 350 && !me->samsara_check("bore-zhang"))
    return notify_fail("你的般若掌尚未到独创一家的地步。\n");

  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if (me->query("class") != "human" && !me->samsara_check("bore-zhang"))
    return notify_fail("你非我人族，不能练习般若掌。\n");

  if ((int)me->query("kee") < 50
    || (int)me->query("force") < 10)
    return notify_fail("你的内力或气不够，没有办法练习般若掌。\n");

  me->receive_damage("kee", 50);
  me->add("force", -10);
  write("你按着所学练了一遍般若掌。\n");
  return 1;
}

string perform_action_file(string func) {
  return CLASS_D("shaolin") + "/bore-zhang/" + func;
}
