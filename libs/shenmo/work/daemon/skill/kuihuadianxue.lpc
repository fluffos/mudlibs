int valid_learn(object me)
{    
   
       if ((int)me->query_skill("kuihuadianxue", 1) < 80)
               return notify_fail("你的葵花点穴手火候还不够，还不能学习。\n");
if (me->query("lunhui_zhuanshi") < 1)
return notify_fail("没转世的人是无法学习葵花点穴手法的。\n");

if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
     return notify_fail("练葵花点穴手最好空手，不然弄坏了东西怎么办？\n");
     if( (int)me->query("max_kee") < 399 )
     return notify_fail("以你现在的体力，恐怕受不了葵花点穴手修炼的痛苦。\n");
     if( (int)me->query("max_sen") < 399 )
     return notify_fail("以你现在的精力要修炼葵花点穴手简直是找死，爱惜生命吧！\n");
    
     

   return 1;
}

int valid_enable(string usage)
{
 return usage=="unarmed"||usage=="parry";
}

mapping query_action(object me, object weapon)
{
     return action[random(sizeof(action))];
}

int practice_skill(object me)
{  
       if ((int)me->query_skill("kuihuadianxue", 1) < 80)
               return notify_fail("你的葵花点穴手火候还不够，还不能学习。\n");
if (me->query("lunhui_zhuanshi") < 1)
return notify_fail("没转世的人是无法学习葵花点穴手法的。\n");

if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
     return notify_fail("练葵花点穴手最好空手，不然弄坏了东西怎么办？\n");
     if( (int)me->query("max_kee") < 399 )
     return notify_fail("以你现在的体力，恐怕受不了葵花点穴手修炼的痛苦。\n");
     if( (int)me->query("max_sen") < 399 )
     return notify_fail("以你现在的精力要修炼葵花点穴手简直是找死，爱惜生命吧！\n");
    
   
   if( (int)me->query("sen") < 100)
   return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
   if( (int)me->query("kee") < 100 )
   return notify_fail("你现在体力不够了，休息一下再练吧。\n");
   if( (int)me->query("force") < 50 )
   return notify_fail("你的体力不够了。\n");
   me->receive_damage("sen", 60);
   
   return 1;
}

string perform_action_file(string func)
{
  return CLASS_D("jjg") + "/kuihuadianxue/" + func;
}

void skill_improved(object me)
{
   tell_object (me, "哇，你好厉害呀，帅呀！\n");
}



mixed hit_ob(object me, object victim, int damage_bonus)
{
  int damage,dforce,dmana;
  if(me->query("family/family_name") != "神策军")
return 0;
  if( random(damage_bonus) > victim->query_str()/10) {
 damage=damage_bonus/3+random(damage_bonus/3);
 dforce = (int)victim->query("force", 1);
 dmana = (int)victim->query("mana", 1);
 victim->delete_temp("jldl");
 victim->set_temp("jldl_end", time() );
//  victim->add("force", -dforce/5 );
// victim->add("mana", -dmana/5 );
if (me->query("force") < me->query("max_force")*2)
{
  me->add("force", damage*2 );
}
       }


 }


