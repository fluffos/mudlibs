int valid_enable(string usage)
{
        return usage == "blade" || usage == "parry";
}

int valid_learn(object me)
{
if( me->query("family/family_name")!="三圣宫" && !me->samsara_check("fuxibagua-dao",1)) 
        return notify_fail("你非三圣宫弟子，难以领会伏羲八卦刀法的奥妙之处！\n"); 
        if ((int)me->query("max_force") < 1200)
                return notify_fail("你的内力修为尚浅，无法练习伏羲八卦刀法。\n");

        if ((int)me->query_skill("force") < 150)
                return notify_fail("你的内功火候太浅。\n");

        if ((int)me->query_skill("blade", 1) < 100 )
                return notify_fail("你的基本刀法水平有限，无法练习伏羲八卦刀法。\n");

        return 1;
}

mapping query_action(object me, object weapon)
{
        int i, level, tiandao;
        level = (int)me->query_skill("bagua-dao", 1);
        tiandao = me->query_temp("pfm_tiandao");
        switch (tiandao)
        {
        case 1:
                return ([ "action": WHT "$N" WHT "施出「" HIY "天刀八势" NOR +
                                    WHT "」起手势" HIY "『乾』" NOR + WHT "字"
                                    "诀，手中的$w" WHT "宛如一道闪电对准$n" WHT
                                    "直劈而下",
                           "force"  : 80,
                           "damage" : 180,
                           "dodge"  : -50,
                           "parry"  : -65,
                           "damage_type" : "割伤",
                        ]);
                break;
        case 2:
                return ([ "action": WHT "$N" WHT "身形一转，一招" HIY "『坤』"
                                    NOR + WHT "字诀随手施出，手中$w" WHT "顿时"
                                    "幻作一道道刀芒笼罩$n" WHT "全身",
                           "force"  : 80,
                           "damage" : 180,
                           "dodge"  : -45,
                           "parry"  : -55,
                           "damage_type" : "割伤",
                        ]);
                break;
        case 3:
                return ([ "action": WHT "$N" WHT "深深吸入一口气，施一招" HIY
                                    "『巽』" NOR + WHT "字诀施出，手中$w" WHT
                                    "顺势翻手一刀，向$n" WHT "劈斩出",
                           "force"  : 90,
                           "damage" : 180,
                           "dodge"  : -45,
                           "parry"  : -55,
                           "damage_type" : "割伤",
                        ]);
                break;
        case 4:
                return ([ "action": WHT "$N" WHT "身法陡然加快，手中$w" WHT "随"
                                    "着" HIY "『震』" NOR + WHT "字诀方位斩出，"
                                    "数道刀芒直劈向$n" WHT "要害所在",
                           "force"  : 100,
                           "damage" : 200,
                           "dodge"  : -45,
                           "parry"  : -55,
                           "damage_type" : "割伤",
                        ]);
                break;
        case 5:
                return ([ "action": WHT "接着$N" WHT "一声长叹，依照八卦方位施"
                                    "出" HIY "『坎』" NOR + WHT "字诀，$w" WHT
                                    "刀身顿时迸出道金光射向$n" WHT,
                           "force"  : 110,
                           "damage" : 180,
                           "dodge"  : -45,
                           "parry"  : -50,
                           "damage_type" : "割伤",
                        ]);
                break;
        case 6:
                return ([ "action": WHT "$N" WHT "飞身一跃而起，凌空施一式" HIY
                                    "『兑』" NOR + WHT "字诀，顿时刀光烁烁犹如"
                                    "千万柄$w" WHT "齐罩向$n" WHT,
                           "force"  : 100,
                           "damage" : 180,
                           "dodge"  : -45,
                           "parry"  : -65,
                           "damage_type" : "割伤",
                        ]);
                break;
        case 7:
                return ([ "action": WHT "$N" WHT "紧接着施展出" HIY "『离』" NOR +
                                    WHT "字诀，$w" WHT "犹如九天神雷，携着呼啸"
                                    "破空之声直贯向$n" WHT "而去",
                           "force"  : 90,
                           "damage" : 190,
                           "dodge"  : -45,
                           "parry"  : -40,
                           "damage_type" : "割伤",
                        ]);
                break;
        case 8:
                return ([ "action": WHT "最后$N" WHT "一声冷笑，施出「" HIY "天"
                                    "刀八式" WHT "」最终" HIY "『艮』" NOR + WHT
                                    "字诀，只见$w" WHT "一闪，已至$n" WHT "眼前",
                           "force"  : 100,
                           "damage" : 190,
                           "dodge"  : -50,
                           "parry"  : -70,
                           "damage_type" : "割伤",
                        ]);
                break;
        default:
                return action[random(sizeof(action))];
                break;
        }
}

int practice_skill(object me)
{
        object weapon;

        if (!objectp(weapon = me->query_temp("weapon"))
           || (string)weapon->query("skill_type") != "blade")
                return notify_fail("你使用的武器不对。\n");

        if ((int)me->query("kee") < 60)
                return notify_fail("你的体力不够，练不了伏羲八卦刀法。\n");

        if ((int)me->query("force") < 80)
                return notify_fail("你的内力不够，练不了伏羲八卦刀法。\n");

        me->receive_damage("kee", 55);
        me->add("force", -70);
        return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus) 
{
if( damage_bonus < 100 ) return 0; 
if( random(damage_bonus/2) > victim->query_str()/10) { 
        victim->receive_wound("kee", (damage_bonus - 50) / 5 ); 
        switch(random(2)) { 
                case 0: return HIB"你听到$N"HIB"的刀风中隐隐有风雷之声！\n"NOR; 
                case 1: return HIY"$N"HIY"一发力，一道金芒从刀尖中迸出！\n"NOR; 
                       } 
        }
}

string perform_action_file(string action)
{
        return CLASS_D("sansheng") + "/fuxibagua-dao/" + action;
}
