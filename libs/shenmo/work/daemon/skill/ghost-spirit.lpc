#include <ansi.h>

inherit SKILL;

int stage(int level)
{
        if( level <100 ) return 1;
        else if ( level < 200 ) return 2;
        else if ( level < 300 ) return 3;
        else if ( level < 400 ) return 4;
        else if ( level < 500 ) return 5;
        else if ( level < 600 ) return 6;
        else return 7;
}

string level_description(int level)
{
   object me=this_player();

        if ( stage(level) == 1 && me->query("sfighter/sha"))
                return HIR "殺意初段" NOR;
        else if ( stage(level) == 1 && me->query("sfighter/ba"))
                return HIY "霸意初段" NOR;
        else if ( stage(level) == 2 && me->query("sfighter/sha"))
                return HIR "殺意境界" NOR;
        else if ( stage(level) == 2 && me->query("sfighter/ba"))
                return HIY "霸意境界" NOR;
        else if ( stage(level) == 3)
                return HIB "滅の初段" NOR;
        else if ( stage(level) == 4)
                return HIB "滅の境界" NOR;
        else if ( stage(level) == 5)
                return HIC "天の初段" NOR;
        else if ( stage(level) == 6)
                return HIC "天の境界" NOR;
        else 
                return BLK "无の境界" NOR;
}

int valid_learn(object me)
{
if( (me->query("class")!= "saint" || me->query("family/family_name")!= "格斗家") && !me->samsara_check("ghost-spirit",1) )
        return notify_fail("你非格斗家，自然学不得！\n");
        if( !me->query("ghost-spirit"))
                return notify_fail("你无法领悟阿修羅戰道。\n");
        if( me->query_skill("yuanwu-xinfa"))
                return notify_fail("元武门心法与阿修羅戰道不相兼容，勉强学之会走火入魔。\n");
if ( me->query("faith")/500 < (me->query_skill("ghost-spirit",1)-500)/50 ) return notify_fail("你需要为格斗家多做贡献，才能学习该技能！\n"); 
        return 1;
}

void skill_improved(object me)
{
        int level = (int)me->query_skill("ghost-spirit", 1);
        if ( stage(level) == stage(level-1) + 1)
        {
                        message_vision(HIG "$N突然觉得脑中一阵灵光闪现。$N的阿修羅戰道已步入"+level_description(stage(level))+HIG"！\n" NOR, me);

        }
                        
}

