// luohan-quan.c 罗汉拳
#include <ansi.h>
inherit SKILL;

mapping *action1 = ({
  ([ "action": "$N连续上步，一式「黄莺落架」，左右手分靠，变拳为掌，击向$n的$l",
    "force": 50,
    "dodge": 20,
    "skill_name": "黄莺落架",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N左脚虚踏，全身右转，一招「丹凤朝阳」，右掌猛地插向$n的$l",
    "force": 80,
    "dodge": 30,
    "skill_name": "丹凤朝阳",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N双手大开大阖，宽打高举，使一招「洛钟东应」，双拳向$n的$l打去",
    "force": 90,
    "dodge": 30,
    "skill_name": "洛钟东应",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N左掌圈花扬起，屈肘当胸，虎口朝上，一招「偏花七星」打向$n的$l",
    "force": 90,
    "dodge": 10,
    "skill_name": "偏花七星",
    "damage_type": "瘀伤"
  ]),
});

mapping *action2 = ({
  ([ "action": "$N使一招「苦海回头」，上身前探，双手划了个半圈，击向$n的$l",
    "force": 100,
    "dodge": 5,
    "skill_name": "苦海回头",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N双掌划弧，一记「挟山超海」，掌出如电，一下子切到$n的手上",
    "force": 150,
    "dodge": 30,
    "skill_name": "挟山超海",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N施出「慑服外道」，双拳拳出如风，同时打向$n头，胸，腹三处要害",
    "force": 160,
    "dodge": -10,
    "skill_name": "慑服外道",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N左脚内扣，右腿曲坐，一式「三入地狱」，双手齐齐按向$n的胸口",
    "force": 200,
    "dodge": -20,
    "skill_name": "三入地狱",
    "damage_type": "瘀伤"
  ]),
});

int valid_learn(object me) {
  mapping shaolin;
  shaolin = me->query("门派/shaolin");

  if (me->query("class") != "human")
    return notify_fail("非尘世弟子，无法参悟罗汉。\n");
  if (!shaolin || !mapp(shaolin) || !shaolin["banruo-zhang"])
    return notify_fail("你没有般若掌做根基,无法学习罗汉拳。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练罗汉拳法必须空手。\n");
  if (me->query_skill("yijinjing", 1) <= 350)
    return notify_fail("你的易筋经功力不够，无法学习罗汉拳。\n");
  if (me->query_skill("luohan-quan", 1) > 250 && !me->query_temp("shaolin_luohan_improve"))
    return notify_fail("你的罗汉拳需要去后山领悟罗汉拳图谱了。\n");
  return 1;
}

int valid_enable(string usage) {
  if (this_player()->query("门派/shaolin/宗派") == "拳"
    || this_player()->query("family/family_name") == "少林寺")
    return usage == "unarmed" || usage == "parry";
  else return usage == "unarmed";
}

mapping query_action(object me, object weapon) {
  if (this_player()->query("门派/shaolin/宗派") == "拳"
    || this_player()->query("family/family_name") == "少林寺")
    return action2[random(sizeof(action2))];
  else return action1[random(sizeof(action1))];
}

int practice_skill(object me) {
  if (!valid_learn(me))
    return 0;
  if (me->query("kee") < 50)
    return notify_fail("你的体力不够了，休息一下再练吧。\n");
  me->receive_damage("kee", 30, me);
  return 1;
}

string *parry_msg = ({
  "$n一招「普渡众生」，猛击$N的面门，逼得$N中途撤回手中的$w。\n",
  "$n右拳虚幌，左拳一招「菩提本无树」，逼得$N后退三步。\n",
  "$n以守为攻，一招「明镜亦非台」，猛击$N握$w的手腕。\n",
});

string *unarmed_parry_msg = ({
  "$n一招「普渡众生」，逼得$N中途撤招。\n",
  "$n脚走阴阳，一招「菩提本无树」，攻$N之必救。\n",
  "$n左拳击下，右拳自保，一招「明镜亦非台」，将$N封于尺外。\n",
});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string perform_action_file(string func) {
  if ((this_player()->query("门派/shaolin/宗派") == "拳"
    && this_player()->query("family/family_name") == "少林寺")
    || !userp(this_player()))
    return CLASS_D("shaolin") + "/luohan-quan/levelup/" + func;
  else return CLASS_D("shaolin") + "/luohan-quan/" + func;
}

void skill_improved(object who) {
  mapping fam, shaolin;
  if (!who)
    return;
  //已有拈花指的自动del罗汉拳
  if (who->query_skill("nianhua-zhi", 1)) {
    tell_object(who, "你的罗汉拳早已晋升为拈花指了。\n");
    who->delete_skill("luohan-quan");
    who->reset_action();
    who->save();
    return;
  }
  //非少林弟子只能450的罗汉拳        
  if (who->query("family/family_name") != "少林寺"
    && who->query_skill("luohan-quan", 1) >= 450) {
    tell_object(who, "可惜你对罗汉拳的领悟还不够全面。\n");
    tell_object(who, HIC "你的「罗汉拳」到了停滞不前的地步！\n");
    who->set_skill("luohan-quan", 450);
    who->save();
    return;
  }
  fam = who->query("family");
  shaolin = who->query("门派/shaolin");
  if (!fam || !mapp(fam)
    || (fam["family_name"] != "少林寺"
      && ((!shaolin || !mapp(shaolin))))) {
    tell_object(who, "你不是少林弟子,无法真正习得" + to_chinese("luohan-quan") + "的精髓。\n");
    who->delete_skill("luohan-quan");
    return;
  }
  //没达到罗汉拳学习等级的
  if (!shaolin["banruo-zhang"]) {
    tell_object(who, "你的般若掌基础不够,无法真正习得" + to_chinese("luohan-quan") + "的精髓。\n");
    who->delete_skill("luohan-quan");
    return;
  }
  if (who->query_skill("luohan-quan", 1) > 450) {
    tell_object(who, "你对罗汉拳的使用了如指掌。\n");
    tell_object(who, "你对罗汉拳的研究更进了一步。\n");
    tell_object(who, "你领悟了“罗汉本谛，拈花说法”的精髓。\n");
    tell_object(who, "你的罗汉拳晋升为拈花指了。\n");
    shaolin["luohan-quan"] = 1;
    who->delete_skill("banruo-zhang");
    if (!who->query_skill("nianhua-zhi", 1))
      who->set_skill("nianhua-zhi", 1);
    who->map_skill("unarmed", "nianhua-zhi");
    who->map_skill("parry");
    who->reset_action();
    who->save();
    if (who->query("sen") > 200)
      CHANNEL_D->do_channel(who, "rumor", "听说" HIW + who->name(1) + HIM "的罗汉拳晋升为拈花指了。\n" NOR);
  }
  return;
}
