#include <ansi.h>
#include <sfighter_skill.h>
#include <sfighter_damage.h>
inherit SKILL;

mapping *action = ({
  ([ "action": "$N攸地变爪为掌，身形不动，右臂陡长，「忽」的一掌朝$n$l劈去",
    "damage": 80,
    "dodge": -120,
    "lvl": 0,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N乘势疾上，双臂直上直下，飘忽不定。跟着大喝一声，双掌同时推出",
    "damage": 90,
    "dodge": -150,
    "lvl": 40,
    "damage_type": "内伤"
  ]),
  ([ "action": "$N双掌不住地舞动，只听「喀喇」一声轻响，右掌一立，左掌已向$n$l击去",
    "damage": 100,
    "dodge": -120,
    "lvl": 80,
    "damage_type": "淤伤"
  ]),
  ([ "action": "$N身形挫动，风声虎虎，接着朝$n连发数掌，一掌快似一掌，一掌猛似一掌",
    "damage": 110,
    "dodge": -180,
    "lvl": 120,
    "damage_type": "内伤"
  ]),
  ([ "action": "$N一声长啸，形如飘风，左掌已如风行电挚般拍出，掌未到，风先至，迅猛已极",
    "damage": 120,
    "dodge": -130,
    "lvl": 160,
    "damage_type": "内伤"
  ]),
});

int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }


int valid_learn(object me) {
  if ((me->query("class") != "saint" || me->query("family/family_name") != "格斗家") && !me->samsara_check(
    "wushen-kungfu",
    1
  ))
    return notify_fail("你非格斗家，自然学不得！\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练武神流绝学必须空手。\n");
  if ((int)me->query("max_force") < 500)
    return notify_fail("你的内力太弱，无法练武神流绝学。\n");
  return 1;
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((me->query("class") != "saint" || me->query("family/family_name") != "格斗家") && !me->samsara_check(
    "wushen-kungfu",
    1
  ))
    return notify_fail("你非格斗家，自然学不得！\n");
  if ((int)me->query("sen") < 50)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if ((int)me->query("kee") < 50)
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");
  if ((int)me->query("force") < 20)
    return notify_fail("你的内力不够练武神流绝学。\n");
  me->receive_damage("kee", 30);
  me->add("force", -10);
  return 1;
}

string perform_action_file(string func) {
  return CLASS_D("sfighter") + "/wushen-kungfu/" + func;
}
