        return notify_fail("九阳神功只能向师父学，或是从运用(exert)中增加熟练度。\n");
}
*/
string exert_function_file(string func)
{
        return CLASS_D("mingjiao") + "/jiuyang-shengong/" + func;
}

int stage(int level)
{
        if( level <90 ) return 1;
        else if ( level < 180 ) return 2;
        else if ( level < 270 ) return 3;
        else if ( level < 360 ) return 4;
        else if ( level < 450 ) return 5;
        else if ( level < 540 ) return 6;
        else if ( level < 630 ) return 7;
        else if ( level < 720 ) return 8;
        else if ( level < 810 ) return 9;
        else if ( level < 900 ) return 10;
        else if ( level < 990 ) return 11;
        else return 12;
}

string level_description(int level)
{
	if ( stage(level) < 3 )
                return HIB "第"+chinese_number( stage(level) )+"重　" NOR;
	else if ( stage(level) < 5 )
                return YEL "第"+chinese_number( stage(level) )+"重　" NOR;
	else if ( stage(level) < 7 )
                return HIM "第"+chinese_number( stage(level) )+"重　" NOR;
	else if ( stage(level) < 9 )
                return HIC "第"+chinese_number( stage(level) )+"重　" NOR;
       else if ( stage(level) < 11)
                return HIW "第"+chinese_number( stage(level) )+"重  " NOR;
       else 
                return HIY "第"+chinese_number( stage(level) )+"重" NOR; 
}

void skill_improved(object me)
{
	//if stage increased, give bonus...?
	int level = (int)me->query_skill("jiuyang-shengong", 1);
	if ( stage(level) == stage(level-1) + 1)
	{
		//this is to prevent ppls from abondoning skill to get bonus.
		if( (int)me->query("jy-shengong_bonus") < stage(level) )
		{
			me->set("jy-shengong_bonus", stage(level));
//			me->set("max_force", (int)me->query("max_force") + stage(level)*50 );
			// mon 12/13/98
		me->set("maximum_force", (int)me->query("maximum_force") + stage(level)*50 );
			me->save();
			log_file("jiuyang-shengong-bonus", ctime( time() )+": "
				+me->query("name")+"("+me->query("id")+")"
				+" got neili "+(stage(level)*50)+".\n");
			message_vision(HIY "$N突然觉得通体舒畅。原来是$N的九阳神功进入了第"+chinese_number(stage(level))+"重境界！\n" NOR, me);

		}
	}
			
}
