inherit SKILL;
#include <ansi.h>;

mapping *action = ({
([      "action" : "$N双手虚晃，左脚猛地飞起，一式"+BLINK""+HIW"「风起云涌」"NOR+"，脚尖晃动，踢向$n的屁股",
        "parry" : -20,
        "dodge" : -50,
         "force" : 120,
        "damage_type" : "瘀伤",
        "skill_name" : "风起云涌"
]),
([      "action" : "$N左脚顿地，别转身来抽身欲走，只一刹那间一回身，右脚一式
"+BLINK""+HIB"「空谷足音」"NOR+"，猛踹$n的$l",
        "parry" : -30,
        "dodge" : -50,
         "force" : 100,
        "damage_type" : "瘀伤",
        "skill_name" : "空谷足音"
]),
([      "action" : "$N左手一挣，反手扭搭住$n的右手，右脚同时踹出，既猛且准，一
式"+BLINK""+HIY"「碧渊腾蛟」"NOR+"，踢中的$n的胸口",
        "parry" : -50,
        "dodge" : -60,
         "force" : 150,
        "damage_type" : "瘀伤",
        "skill_name" : "碧渊腾蛟"
]),
([      "action" : "$N突然跃起，双足连环圈转，一式"+BLINK""+HIG"「秋风落叶」"NOR+"，足带风尘，攻向$n的全身",
        "parry" : -60,
        "dodge" : -20,
         "force" : 180,
        "damage_type" : "瘀伤",
        "skill_name" : "秋风落叶"
]),
});

int valid_enable(string usage) { return usage=="unarmed" ||  usage=="parry"; }   

int valid_learn(object me)
{
   int i, f;
   
   i = 0;
   if (me->query_skill("bore-zhang"))    i+=1;
   if (me->query_skill("jingang-zhi"))    i+=1;
   if (me->query_skill("damo-jian"))      i+=1;
   if (me->query_skill("cibei-dao"))      i+=1;
   if (me->query_skill("longzhua-gong"))  i+=1;
   if (me->query_skill("zui-gun"))        i+=1;
   
   f=1;  
   if ((int)me->query_skill("chanzong", 1)>1499)   f=6;
   else if ((int)me->query_skill("chanzong", 1)>1249)   f=5;
   else if ((int)me->query_skill("chanzong", 1)>999)   f=4;
   else if ((int)me->query_skill("chanzong", 1)>749)    f=3;
   else if ((int)me->query_skill("chanzong", 1)>499)    f=2; 
   else if ((int)me->query_skill("chanzong", 1)>249)    f=1;
   else f=0;
   
   if (f<i && !me->samsara_check("suixing-tui"))
   return notify_fail("你必须参悟更深的禅宗佛法才能研习更多的少林武技。\n");
   if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
   return notify_fail("练习如影随形腿必须空手。\n");
   if ((int)me->query_skill("yijinjing", 1) < 100 && !me->samsara_check("suixing-tui") )
   return notify_fail("你的易筋经神功火候不够，无法学习如影随形腿。\n");
   if ((int)me->query("max_force") < 200)
   return notify_fail("你的内力太弱，无法练习如影随形腿。\n");
   if ( me->query("family/family_name")!="少林寺"  
  && me->query_skill("suixing-tui",1)<350 && !me->samsara_check("suixing-tui")) 
        return notify_fail("你的如影随形腿尚未到独创一家的地步。\n"); 

   return 1;
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
if ( me->query("class")!="human" && !me->samsara_check("suixing-tui"))
        return notify_fail("你非我人族，不能练习如影随形腿。\n");

if( (int)me->query("kee") < 50
 || (int)me->query("force") < 10 )
        return notify_fail("你的内力或气不够，没有办法练习如影随形腿。\n");

me->receive_damage("kee", 50);
me->add("force", -10);
write("你按着所学练了一遍如影随形腿。\n");
return 1;
}

string perform_action_file(string func)
{
        return CLASS_D("shaolin") + "/suixing-tui/" + func;
}
