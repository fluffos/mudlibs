inherit SKILL;
#include <ansi.h>

mapping *action = ({
  ([ "action":
    "$N身体一侧，右肩微耸，右手一记「死神召来」，带着一阵鬼哭狼嚎之声冲向$n的$l",
    "dodge": 15,
    "parry": 15,
    "force": 60,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N倏地一个转身，侧对着$n，忽地左手对着$n一指，「死の觉悟」，一股阴黯的小宇宙直扑$n",
    "dodge": -35,
    "parry": -35,
    "force": 40,
    "damage_type": "内伤"
  ]),
  ([ "action":
    "$N左脚点地身子斜斜插向空中，身形未定却又诡秘的一个旋身，「死亡旋涡」，劲气直冲$n的$l",
    "dodge": 5,
    "parry": 5,
    "force": 30,
    "damage_type": "内伤"
  ]),
  ([ "action":
    "$N一声冷笑，收拳变式，一招「冥界亡灵」，双手似爪非爪，迅速对准$n的$l抓去",
    "dodge": -5,
    "parry": -10,
    "force": 40,
    "damage_type": "抓伤"
  ]),
  ([ "action":
    "$N衣袍鼓动，以左脚为轴，整个带着惊人的气势扫向$n$1，好一招「地狱悲歌」",
    "dodge": 15,
    "parry": 15,
    "force": 30,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N一个倒翻，双手撑地，两腿连环踢出，脚风带着冥界的「死亡之气」，扫向$n$l",
    "dodge": -5,
    "parry": -5,
    "force": 50,
    "damage_type": "瘀伤"
  ]),
});

int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  if (damage_bonus < 60) return 0;

  if (random(damage_bonus) > victim->query_str()) {
    victim->receive_wound("sen", 100 + random(damage_bonus) / 4);
    switch (random(3)) {
      case 0: return HIB "四周鬼影幢幢，$n一个松懈，心神不由一震！\n" NOR;
      case 1: return RED "$N对着$n一声阴笑，$n攻势不禁慢了下来！\n" NOR;
      case 2: return YEL "$N拳风中带着地狱的呼声，$n精神开始萎靡下来...\n" NOR;
    }
  }
}

string perform_action_file(string func) {
  return CLASS_D("star/hell") + "/hellfight/" + func;
}
