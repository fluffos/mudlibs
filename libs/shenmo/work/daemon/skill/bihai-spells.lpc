
inherit SKILL;

int valid_enable(string usage) { return usage=="spells"; }

int valid_learn(object me)
{
       if ( me->query("class")!="yao" && !me->samsara_check("bihai-spells"))         return notify_fail("你非妖族弟子，无法习得！\n");
        if( (int)me->query_skill("spells") <= (int)me->query_skill("bihai-spells") )
                return notify_fail("你的法术修为还不够高深，无法学习碧海秘宗。\n");
        if( (int)me->query("bellicosity") > 2000 )
                return notify_fail("你的杀气太重，无法修炼碧海秘宗。\n");
        return 1;
}

string cast_spell_file(string spell)
        {
return CLASS_D("yaomo") + "/bibotan/bihai-spells/" + spell;

        }

string type() { return "magic";}


