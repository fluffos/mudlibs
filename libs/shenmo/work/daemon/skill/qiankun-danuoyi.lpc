inherit SKILL;
#include <ansi.h>
int valid_enable(string usage) { return usage == "spells"; }
int valid_learn(object me) {
  if (me->query("class") != "human" && !me->samsara_check(
    "qiankun-danuoyi",
    1
  )) return notify_fail("你非人族弟子，无法习得！\n");
  if ((int)me->query_skill("spells", 1) < 20
    || (int)me->query_skill("spells", 1) <= (int)me->query_skill("qiankun-danuoyi", 1))
    return notify_fail("你的法术修为还不够高深，无法学习乾坤大挪移。\n");
  if ((int)me->query_skill("qiankun-danuoyi", 1) / 10 > (int)me->query("int") * 2)
    return notify_fail("你的先天悟性太低，无法领悟更高深的乾坤大挪移心法。\n");
  return 1;
}
string cast_spell_file(string spell) {
  return CLASS_D("mingjiao") + "/nuoyi/" + spell;
}
string type() { return "magic"; }

int stage(int level) {
  if (level < 100) return 0;
  else if (level < 200) return 1;
  else if (level < 300) return 2;
  else if (level < 400) return 3;
  else if (level < 500) return 4;
  else if (level < 600) return 5;
  else if (level < 700) return 6;
  else if (level < 800) return 7;
  else if (level < 900) return 8;
  else return 9;
}

string level_description(int level) {
  if (stage(level) < 1)
    return BLU "经脉错乱" NOR;
  else if (stage(level) < 3)
    return HIB "第" + chinese_number(stage(level)) + "层　" NOR;
  else if (stage(level) < 5)
    return YEL "第" + chinese_number(stage(level)) + "层　" NOR;
  else if (stage(level) < 7)
    return HIC "第" + chinese_number(stage(level)) + "层　" NOR;
  else if (stage(level) < 9)
    return HIW "第" + chinese_number(stage(level)) + "层  " NOR;
  else
    return HIY "第" + chinese_number(stage(level)) + "层  " NOR;
}
