//暗黑杀人拳法dark-quan.c
//暗黑斗士所用
#include <ansi.h>

inherit SKILL;

mapping *action = ({
  ([ "action": "$N一招" + HIR "「死亡火鸟」" NOR "，双掌切向$n的太阳穴，就在$n回身自防的一瞬间，右腿膝盖已顶向$n的$l",
    "dodge": -50,
    "parry": -50,
    "force": 30,
    "damage_type": "刺伤",
    "weapon": "双掌",
  ]),
  ([ "action": "$N双手一翻，出" + RED "「炎之乌鸦」" NOR "，双手如夜空的乌鸦一般翻飞。\n$n看花了眼，刹那间$N已欺身到了眼前",
    "dodge": -125,
    "parry": -150,
    "force": 60,
    "damage_type": "内伤",
    "weapon": "双手",
  ]),
  ([ "action": "只见$N一转身，双腿连环倒踢，直打$n的$l，却正是一招" + HIR "「冲天岩浆」" NOR,
    "dodge": -250,
    "parry": -100,
    "force": 200,
    "damage_type": "刺伤",
    "weapon": "双腿",
  ]),
  ([ "action": "$N双掌一错，掌心向外横推而出，这一招" + RED "「烈炎翻滚」" NOR "挟雷霆之势扑向$n的$l",
    "dodge": -20,
    "parry": -20,
    "force": 140,
    "damage_type": "内伤",
    "weapon": "双手",
  ]),
  ([ "action": "$N一招" + HIB "「亡灵召唤」" NOR "，左手在空中虚划了个半弧，拍向$n的$l",
    "dodge": -300,
    "parry": -100,
    "force": 170,
    "damage_type": "内伤",
    "weapon": "左手",
  ]),
  ([ "action": "忽听$N一声怒吼，右手高高举起，一式" + HIG "「落之焰石」" NOR "，砍向$n的$l",
    "dodge": -10,
    "parry": -10,
    "force": 220,
    "damage_type": "砍伤",
    "weapon": "右手",
  ]),
  ([ "action": HIR "$N双掌一错，左右手突发炙红之光，随着一声热浪，两个火球电般地射向了$n" NOR,
    "dodge": -280,
    "parry": -500,
    "force": 500,
    "damage_type": "内伤",
  ]),
});

int valid_enable(string usage) {
  return usage == "unarmed";
}

mapping query_action(object me, object weapon) {
  int i;
  i = me->query_temp("moyunshou_per");
  if (!me->query_temp("moyunshou_per")) {
    return action[random(6)];
  } else {
    return action[i];
  }
}

string perform_action_file(string func) {
  return CLASS_D("star") + "/dark-quan/" + func;
}
