#include <ansi.h>
inherit SKILL;
int valid_learn(object me)
{
if( (me->query("class")!= "saint" || me->query("family/family_name")!= "格斗家") && !me->samsara_check("yuanwu-xinfa",1) )
        return notify_fail("你非格斗家，自然学不得！\n");
if( me->query_skill("ghost-spirit")) 
        return notify_fail("元武门心法与阿修羅戰道不相兼容，勉强学之会走火入魔。\n"); 
if ( me->query("faith")/500 < (me->query_skill("yuanwu-xinfa",1)-500)/50 ) return notify_fail("你需要为格斗家多做贡献，才能学习该技能！\n"); 
return 1;
}
