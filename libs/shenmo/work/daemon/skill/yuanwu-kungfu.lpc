#include <ansi.h>
#include <sfighter_skill.h>
#include <sfighter_damage.h>

inherit SKILL;

mapping *action = ({
  ([ "action": "$N身子腾空跃起，两臂张开，紧跟着右拳左掌突然随势向前疾探，打向$n$l",
    "damage": 100,
    "dodge": -150,
    "parry": 10,
    "lvl": 0,
    "skill_name": "玄鹤捕食",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N左手探出，左右虚晃几招，右拳“嗖”地一声从掌风中猛穿出来，击向$n的$l",
    "damage": 120,
    "dodge": -200,
    "parry": 15,
    "lvl": 10,
    "skill_name": "金蛇戏龟",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N气沉丹田，猛然怒喝一声，向前一个弓步，双掌带着风雷之声奋力击向$n",
    "damage": 140,
    "dodge": -220,
    "parry": 20,
    "lvl": 20,
    "skill_name": "野马上槽",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N腾空飞起,右拳对着$n胸口雷霆般猛捣过去",
    "damage": 160,
    "dodge": -225,
    "parry": 25,
    "lvl": 30,
    "skill_name": "黑虎掏心",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N往前一个猛冲,双拳突然同时击出，直取$n的双目",
    "damage": 180,
    "dodge": -230,
    "parry": 30,
    "lvl": 40,
    "skill_name": "二龙戏珠",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N上身向后一仰，正好避开$n的攻击，突然一转身，反手一把扭住$n臂膀，右拳却捣向$n的面门",
    "damage": 200,
    "dodge": -235,
    "parry": 35,
    "lvl": 50,
    "skill_name": "麒麟反挂",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N向前一个弓箭步，一记勾拳，不顾一切地捣向$n",
    "damage": 220,
    "dodge": -240,
    "parry": 40,
    "lvl": 60,
    "skill_name": "青龙夺食",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N运起丹田之气，猛喝一声，突然右拳变得赤红，挟带着狂风，如雷似电捣往$n$l",
    "damage": 240,
    "dodge": -245,
    "parry": 45,
    "lvl": 70,
    "skill_name": "赤龙穿云",
    "damage_type": "瘀伤"
  ])
});

int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }


int valid_learn(object me) {

  if ((me->query("class") != "saint" || me->query("family/family_name") != "格斗家") && !me->samsara_check(
    "yuanwu-kungfu",
    1
  ))
    return notify_fail("你非格斗家，自然学不得！\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练元武门绝学必须空手。\n");
  if ((int)me->query("max_force") < 50)
    return notify_fail("你的内力太弱，无法练元武门绝学。\n");
  return 1;
}


mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("sen") < 50)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if ((int)me->query("kee") < 50)
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");
  if ((int)me->query("force") < 20)
    return notify_fail("你的内力不够练元武门绝学。\n");
  me->receive_damage("kee", 30);
  me->add("force", -10);
  return 1;
}

string perform_action_file(string func) {
  return CLASS_D("sfighter") + "/yuanwu-kungfu/" + func;
}
