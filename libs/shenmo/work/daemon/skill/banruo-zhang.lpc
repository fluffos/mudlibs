int valid_learn(object me) {
  if (me->query("class") != "human" && !me->samsara_check("banruo-zhang"))
    return notify_fail("非尘世弟子，无法参悟般若。\n");
  if (me->query("门派/shaolin/banruo-zhang"))
    return notify_fail("你的般若掌早已升级了。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练般若掌必须空手。\n");
  return 1;
}

int valid_enable(string usage) {
  if (this_player()->query("门派/shaolin/宗派") == "拳"
    || this_player()->query("family/family_name") == "少林寺")
    return usage == "unarmed" || usage == "parry";
  else return usage == "unarmed";
}

mapping query_action(object me, object weapon) {
  if (me->query("门派/shaolin/宗派") == "拳")
    return action2[random(sizeof(action2))];
  else return action1[random(sizeof(action1))];
}

int practice_skill(object me) {
  if (!valid_learn(me))
    return 0;
  if (me->query("family/family_name") != "少林寺"
    && me->query_skill("banruo-zhang", 1) < 350)
    return notify_fail("你般若掌尚未到开宗创祖的等级。\n");
  if ((int)me->query("sen") < 30)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if ((int)me->query("kee") < 30)
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");
  if ((int)me->query("force") < 10)
    return notify_fail("你的内力不够了。\n");
  me->receive_damage("kee", 30, me);
  me->add("force", -10);
  return 1;
}

string perform_action_file(string func) {
  if ((this_player()->query("门派/shaolin/宗派") == "拳"
    && this_player()->query("family/family_name") == "少林寺")
    || !userp(this_player()))
    return CLASS_D("shaolin") + "/banruo-zhang/levelup/" + func;
  else return CLASS_D("shaolin") + "/banruo-zhang/" + func;
}

