//作者：tonii@飘渺水云间，2003-4-27于浙大，修改请保留此行。
//【三辰恒舞杖法】之【封魔灭杀】
//禁止对方使用特技和法术
//修改的相关文件有：std/skill.c

#include <ansi.h>

inherit F_DBASE;
inherit SSERVER;

void remove_effect_npc(object);
void remove_effect_player(object);

int perform(object me, object target) {
  int howlong = 0;
  int ap, dp, ap2;
  int npc_chance = 0;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这一招「封魔灭杀」？\n");

  if (me->query("family/family_name") != "灵剑门")
    return notify_fail("非灵剑门不能使用此项技能！\n");

  if (me->query_skill("sanchen-sword", 1) < 500)
    return notify_fail("你的三辰恒舞剑法级别不够，无法使用「封魔灭杀」！\n");
  if (me->query_skill("spells") < 120)
    return notify_fail("你对法术级别还不够，尚未领悟到「封魔灭杀」！\n");

  if (me->query_temp("no_perform") > time())
    return notify_fail("你现在不能使用绝招！\n");
  if ((int)me->query("force") < 200)
    return notify_fail("你的内力不够，无法使用「封魔灭杀」！\n");
  if ((int)me->query("kee") < 200)
    return notify_fail("你的体力这么差，还是先休息一会儿吧！\n");
  if ((int)me->query("sen") < 200)
    return notify_fail("你的精神太差，无法使用「封魔灭杀」！\n");
  if ((int)target->query_temp("fengmo"))
    return notify_fail("对方已经出于封魔状态了！\n");
  if (me->query_temp("no_sanchen-sword_fengmo") > time())
    return notify_fail("你不能连续使用「封魔灭杀」！\n");
  me->set_temp("no_sanchen-sword_fengmo", time() + 4);


  me->add("force", -100);
  message_vision(
    HIC "$N运用念力往法杖中输入封禁的魔咒，\n 然后疾挥法杖，一道魔光向$n飞驰而去！\n" NOR, me, target);
  ap = (int)me->query_skill("sword");
  ap = ap * ap * ap / 1800;
  ap2 = me->query_skill("sanchen-sword");
  ap2 = ap2 * ap2 * ap2 / 1800;
  ap += ap2;
  ap += (int)me->query("daoxing") / 100;
  dp = (int)target->query_skill("sanchen-sword");
  dp = dp * dp * dp / 1200;
  dp += (int)target->query("daoxing") / 100;
  if (me->query_temp("magic_set")) ap += ap / 2;

  if (random(ap + dp) > dp) {
    if ((!userp(target))) {
      npc_chance = target->query("chat_chance_combat");
      target->set_temp("chat_chance_combat", npc_chance);
      target->set_temp("fengmo", 1);
      target->delete("chat_chance_combat");
      howlong = (int)me->query_skill("sanchen-sword") + (int)me->query_skill("sword");
      howlong = random(howlong / 25) + 5;
      if (howlong > 60) howlong = 60;
      if (me->query_temp("magic_set")) howlong += howlong / 2;
      call_out("remove_effect_npc", howlong, target, me);
      message_vision(MAG "\n$n不明所以，结果被魔光穿透，顿时忘记了所学绝技！\n" NOR, me, target);
    }
    if ((userp(target))) {
      howlong = (int)me->query_skill("sanchen-sword") + (int)me->query_skill("sword");
      howlong = random(howlong / 25) + 5;
      if (howlong > 60) howlong = 60;
      target->set_temp("fengmo", 1);
      call_out("remove_effect_player", howlong, target, me);
      message_vision(MAG "\n$n不明所以，结果被魔光穿透，顿时忘记了所学绝技！\n" NOR, me, target);
      me->set_temp("no_perform", time() + 3);
    }
  } else {
    message_vision(HIG "\n$n早有防备，及时隐藏全身内息与灵力，$N的魔光便无可封禁！\n" NOR, me, target);
    me->start_busy(1 + random(2));
  }
  return 1;
}

void remove_effect_npc(object target) {
  if (!target) return;
  target->set("chat_chance_combat", target->query_temp("chat_chance_combat"));
  target->delete_temp("fengmo");
  message_vision(HIG "\n$N感觉自己又回忆起那些绝技了！\n" NOR, target);
}

void remove_effect_player(object target) {
  target->delete_temp("fengmo");
  message_vision(HIG "\n$N感觉自己又回忆起那些绝技了！\n" NOR, target);
}
