#include "ansi.h"

inherit SKILL;

mapping *action = ({
  ([ "action": HBBLU "$N使一招「苍龙点头」，手中$w" NOR + HBBLU "平平直出，刺向$n的$l" NOR,
    "force": 40,
    "dodge": -30,
    "damage": 80,
    "skill_name": "苍龙点头",
    "damage_type": "刺伤"
  ]),
  ([ "action": HBMAG "$N不待招数使老，抖起$w，一招「惊涛拍岸」无数枪芒卷向$n$l" NOR,
    "force": 40,
    "dodge": -15,
    "damage": 50,
    "skill_name": "惊涛拍岸",
    "damage_type": "内伤"
  ]),
  ([ "action": HBYEL "$N身形变幻，两折三晃，在空中化出好几道身影，虚实莫测，一招「千里羿龙」手中$w幻为九道龙影袭向$n$l" NOR,
    "force": 80,
    "dodge": -10,
    "damage": 100,
    "skill_name": "千里羿龙",
    "damage_type": "刺伤"
  ]),
  ([ "action": HBRED "$N分身不定，连发数击，一招「雾隐云龙」，上下左右，虚虚实实分袭$n全身大穴" NOR,
    "force": 120,
    "dodge": -5,
    "damage": 100,
    "skill_name": "雾隐云龙",
    "damage_type": "内伤"
  ]),
});

int valid_enable(string usage) { return usage == "spear" || usage == "parry"; }

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int valid_effect(object me, object weapon, string name, int skill) {}

string perform_action_file(string action) {
  return CLASS_D("qishituan") + "/fencheng-qiang/" + action;
}
