int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }

int valid_learn(object me) {
  int i, f;

  i = 0;
  if (me->query_skill("bore-zhang")) i += 1;
  if (me->query_skill("suixing-tui")) i += 1;
  if (me->query_skill("damo-jian")) i += 1;
  if (me->query_skill("cibei-dao")) i += 1;
  if (me->query_skill("jingang-zhi")) i += 1;
  if (me->query_skill("zui-gun")) i += 1;

  f = 1;
  if ((int)me->query_skill("chanzong", 1) > 1499) f = 6;
  else if ((int)me->query_skill("chanzong", 1) > 1249) f = 5;
  else if ((int)me->query_skill("chanzong", 1) > 999) f = 4;
  else if ((int)me->query_skill("chanzong", 1) > 749) f = 3;
  else if ((int)me->query_skill("chanzong", 1) > 499) f = 2;
  else if ((int)me->query_skill("chanzong", 1) > 249) f = 1;
  else f = 0;

  if (f < i && !me->samsara_check("longzhua-gong"))
    return notify_fail("你必须参悟更深的禅宗佛法才能研习更多的少林武技。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练习龙爪功必须空手。\n");
  if ((int)me->query_skill("yijinjing", 1) < 200 && !me->samsara_check("longzhua-gong"))
    return notify_fail("你的易筋经神功火候不够，无法学习少林龙爪功。\n");
  if ((int)me->query("max_force") < 500)
    return notify_fail("你的内力太弱，无法练习龙爪功。\n");
  if (me->query("family/family_name") != "少林寺"
    && me->query_skill("longzhua-gong", 1) < 350 && !me->samsara_check("longzhua-gong"))
    return notify_fail("你的龙爪功尚未到独创一家的地步。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action); i > 0; i--)
    if (level >= action[i - 1]["lvl"])
      return action[i - 1]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if (me->query("class") != "human" && !me->samsara_check("longzhua-gong"))
    return notify_fail("你非我人族，不能练习龙爪功。\n");

  if ((int)me->query("kee") < 50
    || (int)me->query("force") < 10)
    return notify_fail("你的内力或气不够，没有办法练习龙爪功。\n");

  me->receive_damage("kee", 50);
  me->add("force", -10);
  write("你按着所学练了一遍龙爪功。\n");
  return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int i;
  object weapon = me->query_temp("weapon");
  if ((int)me->query_skill("longzhua-gong", 1) < 200)
    return 0;
  if (random((int)me->query_skill("unarmed")) > (int)victim->query_skill("dodge") / 7 && time() - (int)me->query_temp("longzhua_autopfm") > 2 + random(2)) {
    me->set_temp("longzhua_autopfm", time());
    message_vision(HIY "只见$N身形陡然加快，出爪如风，闪电般已向$n攻出三爪！\n" NOR, me, victim);
    if (!victim->is_busy()) victim->start_busy(1);
    for (i = 0; i < 3; i++) {
      COMBAT_D->do_attack(me, victim, me->query_temp("weapon"), TYPE_REGULAR);
    }
  }
}

string perform_action_file(string func) {
  return CLASS_D("shaolin") + "/longzhua-gong/" + func;
}
