// dianxue.c
#include <ansi.h>

inherit SKILL;
//点穴  dodge 20 parry -20 force 20
mapping *action = ({
 ([      "name":                 "指风",
       "action":
       "$N身形晃动，以一招"+HIW"「指风」"NOR"点向$n的"+HIR"膻中穴"NOR,
       "dodge":                   25,
       "parry":                  -15,
       "force":                  5,
       "damage_type":	"内伤",
       "weapon":		          "右手食指"
]),
 ([      "name":                 "旋风",
       "action":
       "$N身形晃动，以一招"+HIW"「旋风」"NOR"点向$n的"+HIY"天突穴"NOR,
       "dodge":                   25,
       "parry":                  -35,
       "force":                  15,
       "damage_type":   "内伤",
       "weapon":                          "食指"
]),
 ([      "name":                 "灵犀",
       "action":
       "$N身形晃动，以一招"+HIW"「灵犀」"NOR"点向$n的"+HIY"百会穴"NOR,
       "dodge":                   35,
       "parry":                  -25,
       "force":                  35,
       "damage_type":   "内伤",
       "weapon":                          "食指"
]),
 ([      "name":                 "暗渡",
       "action":
       "$N身形晃动，以一招"+HIW"「暗渡」"NOR"点向$n的"+HIB"死穴"NOR,
       "dodge":                   55,
       "parry":                  -45,
       "force":                  200,
       "damage_type":   "内伤",
       "weapon":                          "食指"
]),
});
int valid_enable(string usage)
{
return usage=="unarmed";
}

int valid_learn(object me)
{
if((int)me->query_skill("force",1)<300)
  return notify_fail("你的内功修为不够，没办法学习点穴大法。\n");
return 1;
}


mapping query_action(object me, object weapon)
{
return action[random(sizeof(action))];
}


practice_skill(object me)
{
if ((int)me->query("dianxue_agree") ==0)  
  return notify_fail("点穴只能通过读书，或是运用(perform)，或者研究(research)增加熟练度\n");
if( (int)me->query("sen") < 50)  
        return notify_fail("你的精神无法集中了，休息一下再练吧。\n");   
if( (int)me->query("kee") < 50 )   
        return notify_fail("你现在手足酸软，休息一下再练吧。\n");   
if( (int)me->query("force") < 50 )   
        return notify_fail("你的内力不够了。\n");   
if( me->query_skill("liumai-shenjian", 1))   
        return notify_fail("你的六脉神剑实乃天下各家指法之冠，你再去学一些垃圾指法恐徒劳无益。\n");
me->receive_damage("kee", 30);   
me->receive_damage("sen", 30);   
me->add("force", -20);  
message_vision(WHT "只见$N一边将右手食指与中指并拢，凌空疾点，一边大喝着：指如疾风，势如闪电！\n" NOR,me);
return 1;
}


mixed hit_ob(object me, object victim, int damage_bonus)
{
int dxlvl,txlvl;
dxlvl=me->query_skill("dianxue",1);
txlvl=victim->query_skill("dodge",1);
txlvl+=victim->query_skill("parry",1);
if (dxlvl<300) return;
if(dxlvl>random(txlvl)/3)
{
victim->receive_wound("kee", damage_bonus, me);
switch(random(3)){
case 2: if(!victim->is_busy())  victim->start_busy(1+random(2));
     return HIY"$n浑身一麻，已经行动不得\n"NOR;
case 1: if(!victim->is_busy()) victim->start_busy(1);
    return HIY"$n浑身一麻，感觉行动有些困难！\n"NOR;
case 0: return HIY"$n浑身一麻，竟似是骨碎的声音！\n"NOR;
}
}

}
void skill_improved(object who)
{
if ( !who )
        return;
if ( who->query("dianxue_agree")==0 )
            return;
if ( who->query_skill("liumai-shenjian",1) )
        {
        tell_object(who,"你的葵花点穴手早已晋升为六脉神剑了。\n");
        who->delete_skill("dianxue");
        who->reset_action();
        who->save();
        return;
        }
if ( who->query("dianxue_agree")==1
  && who->query_int()<60
  && who->query_skill("dianxue",1)>=350 )
        {
        tell_object(who,"你感觉你刚才的点穴手法和以往些不同，但又说不上来。\n");  
        tell_object(who,HIC"你的「葵花点穴手」竟然停滞不前，你似乎有一丝极为重要的东西没有抓住！\n");     
        who->set_skill("dianxue",350);
        who->save();
        return;
        }
if ( who->query_skill("dianxue",1)>=350 
  && who->query_int()>=60
  && who->query("dianxue_agree")==1 )
        {
        tell_object(who,"你对点穴之术了如指掌。\n");
        tell_object(who,"你对天下各家指法的研究更进了一步。\n");
        tell_object(who,"你领悟了“无形剑气”的指法最高境界。\n");
        tell_object(who,"你的葵花点穴手晋升为六脉神剑了。\n");
        who->delete_skill("dianxue");
        if ( !who->query_skill("liumai-shenjian",1) )
                who->set_skill("liumai-shenjian",1);
        who->map_skill("unarmed","liumai-shenjian");
        who->reset_action();
        who->save();
        message("channel:rumor",HIM"【千里眼】某人：听说"+who->name()+HIM"从点穴之术中悟出了无形剑气的奥妙。\n"NOR,users());
        message("channel:rumor",HIM"【千里眼】某人：听说"+who->name()+HIM"练成了六脉神剑！\n"NOR,users());
        }
return;
}


string perform_action_file(string action)
{
   return CLASS_D("forall")+"/dianxue/"+action;
}
