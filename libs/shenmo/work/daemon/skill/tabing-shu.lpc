//踏冰术。宇文轻功。

#include <ansi.h>
inherit SKILL;


mapping *action = ({
  ([ "action": "$n脚尖连点，一招「蜻蜓点水」，向后急退，躲开了$N的攻击。"
  ]),
  ([ "action": "$n双脚猛的一踩，整个人冲天而起，一招「凌空飞度」闪到了$N的身旁。"
  ]),
  ([ "action": "$n的身影忽左忽右，琢磨不定，一招「浮光掠影」轻松地躲开了$N的攻击！"
  ]),

});

mapping query_action(object me) {


  return action[random(sizeof(action))];
}


int valid_learn(object me) {

  int i = (int)me->query_skill("tabing-shu", 1);
  if (i >= 400) return notify_fail("学就只能学的这里了，剩下的要靠你自己练习了。 \n");

  return 1;
}



int practice_skill(object me) {


  return 1;
}

string query_type() {
  return "dodge";
}
string query_base() {
  return "dodge";
}

int query_dodge(object me) {
  return 45;

}
