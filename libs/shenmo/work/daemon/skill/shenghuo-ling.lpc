inherit SKILL;

mapping *action = ({
  ([ "action": "$N踏上一步，忽地在地上一坐，已抱住了$n小腿。十指扣住了$n小腿上
的‘中都’‘筑宾’两穴，$n只觉下半身酸麻难动，大吃一惊",
    "dodge": -10,
    "damage": 230,
    "damage_type": "挫伤"
  ]),
  ([ "action": "突然之间，$N身形晃动，同时欺近，手中$w往$n身上划去。脚下不知如何
移动，身形早变。右手同时抓住$n后领，一抖之下，将$n向外远远掷了出去",
    "dodge": -20,
    "damage": 250,
    "damage_type": "挫伤"
  ]),
  ([ "action": "$N欺身直进，左手持$w向$n天灵盖上拍落。便在这一瞬之间，$n滚身向
左，已然一拳打在$n腿上。$n一个踉跄，$N横过$w戳向$n后心",
    "dodge": -30,
    "damage": 170,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N忽地放手，手中那柄$w尾端向上弹起，拍的一响，正好打中$n手腕。",
    "dodge": -20,
    "damage": 190,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N忽然低头，一个头锤向$n撞来，$n不动声色，向旁又是一让，突觉胸口
一痛，已被$N手肘撞中",
    "dodge": -20,
    "damage": 210,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N忽然低头，一个头锤向$n撞来，$n不动声色，向旁又是一让，突觉胸口
$N手中$w急挥横扫，突然连翻三个空心筋斗。$n不知对方是何用意，心想还是避之
为妙，刚向左踏开一步，眼前白光急闪，$N的$w已到右肩",
    "dodge": -20,
    "damage": 230,
    "damage_type": "挫伤"
  ]),
  ([ "action": "$N忽然低头，一个头锤向$n撞来，$n不动声色，向旁又是一让，突觉胸口
一痛，已被$N手肘撞中",
    "dodge": -20,
    "damage": 150,
    "damage_type": "挫伤"
  ]),
});

int valid_learn(object me) {
  object ob;

  if ((int)me->query("max_force") < 50)
    return notify_fail("你的内力不够，没有办法练圣火令法。\n");

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能练剑法。\n");

  if (!me->samsara_check("shenghuo-ling", 1) && me->query("class") != "human")
    return notify_fail("你非我祖,不能练剑法。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 3)
    return notify_fail("你的内力或气不够，没有办法练习圣火令法。\n");
  me->receive_damage("kee", 30);
  me->add("force", -3);
  write("你按着所学练了一遍圣火令法。\n");
  return 1;
}

string perform_action_file(string action) {
  return CLASS_D("mingjiao") + "/shenghuo-ling/" + action;
}
