#include <ansi.h>
inherit SKILL;

mapping *action = ({
  ([ "action": "$N随手前踏上一步，右指中宫直进，一式「无声无息」点向$n的$l",
    "force": 80,
    "parry": 20,
    "dodge": 15,
    "damage": 20,
    "skill_name": "无声无息",
    "damage_type": "点穴",
  ]),
  ([ "action": "$N一招「无欲无望」，轻唱一声佛号，左右看似随意一弹，一屡劲风已射向$n",
    "parry": 5,
    "dodge": 15,
    "damage": 275,
    "skill_name": "无欲无望",
    "damage_type": "刺伤",
    "weapon": "指风",
  ]),
  ([ "action": "$N身形飘忽不定，一式「无法无天」，右指点向$n的$l",
    "force": 150,
    "parry": 13,
    "dodge": 25,
    "skill_name": "无法无天",
    "damage_type": "点穴"
  ]),
  ([ "action": "$N脚踏七星步，突然一招「佛光普照」，左指从意想不到的角度攻向$n的各大要穴",
    "force": 180,
    "parry": 13,
    "dodge": -10,
    "damage": 100,
    "skill_name": "佛光普照",
    "damage_type": "点穴"
  ]),
  ([ "action": "$N一招「佛恩济世」，背朝$n，转身一指，令$n防不胜防",
    "force": 230,
    "parry": 10,
    "dodge": 8,
    "skill_name": "佛恩济世",
    "damage_type": "劈伤",
    "weapon": "劲气",
  ]),
  ([ "action": "$N盘膝端坐，一招「佛法无边」，右手拇指弹出一道劲风，击向$n",
    "force": 170,
    "parry": 22,
    "dodge": 5,
    "skill_name": "佛法无边",
    "damage_type": "抽伤",
    "weapon": "劲气",
  ]),
  ([ "action": "$N双目紧闭，一招「无色无相」，聚集全身内力于一指射出一道无色劲气直逼$n",
    "force": 250,
    "parry": 5,
    "dodge": 10,
    "skill_name": "无色无相",
    "damage_type": "内伤"
  ]),
});

int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }

int valid_learn(object me) {
  mapping shaolin;
  shaolin = me->query("门派/shaolin");

  if (!shaolin || !mapp(shaolin) || shaolin["nianhua-zhi"])
    return notify_fail("你没有拈花指做根基,无法学习无相劫指。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练无相劫指法必须空手。\n");
  if (me->query_skill("yijinjing", 1) <= 650)
    return notify_fail("你的易筋经功力不够，无法学习无相劫指。\n");
  if (me->query_skill("unarmed", 1) <= 650)
    return notify_fail("你的扑击格斗之技功力不够，无法学习无相劫指。\n");
  return 1;
}

int practice_skill(object me) {
  if (me->query("kee") < 300)
    return notify_fail("你的体力太低了。\n");
  if (me->query("force") < 100)
    return notify_fail("你的内力不够练无相劫指。\n");
  if (me->query_skill("unarmed", 1) <= 650)
    return notify_fail("你的扑击格斗之技功力不够，无法练习无相劫指。\n");
  me->receive_damage("kee", 150, me);
  me->add("force", -60);
  return 1;
}

string perform_action_file(string action) {
  return CLASS_D("shaolin") + "/wuxiang-zhi/" + action;
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

void skill_improved(object who) {
  mapping fam, shaolin;
  if (!who)
    return;
  //已有无相劫指的自动del无相劫指
  if (who->query_skill("duoluo-zhi", 1)) {
    tell_object(who, "你的无相劫指早已晋升为多罗叶指了。\n");
    who->delete_skill("wuxiang-zhi");
    who->reset_action();
    who->save();
    return;
  }
  //非少林弟子只能650的无相劫指
  if (who->query("family/family_name") != "少林寺"
    && who->query_skill("wuxiang-zhi", 1) >= 650) {
    tell_object(who, "可惜你对无相劫指的领悟还不够全面。\n");
    tell_object(who, HIC "你的「无相劫指」到了停滞不前的地步！\n");
    who->set_skill("wuxiang-zhi", 650);
    who->save();
    return;
  }
  fam = who->query("family");
  shaolin = who->query("门派/shaolin");
  if (!fam || !mapp(fam)
    || (fam["family_name"] != "少林寺"
      && ((!shaolin || !mapp(shaolin))))) {
    tell_object(who, "你不是少林弟子,无法真正习得" + to_chinese("wuxiang-zhi") + "的精髓。\n");
    who->delete_skill("wuxiang-zhi");
    return;
  }
  //没达到无相劫指学习等级的
  if (!shaolin["nianhua-zhi"]) {
    tell_object(who, "你的拈花指基础不够,无法真正习得" + to_chinese("wuxiang-zhi") + "的精髓。\n");
    who->delete_skill("wuxiang-zhi");
    return;
  }
  if (who->query_skill("wuxiang-zhi", 1) >= 650) {
    tell_object(who, "你对无相劫指的使用了如指掌。\n");
    tell_object(who, "你对无相劫指的研究更进了一步。\n");
    tell_object(who, "你领悟了“无相无劫，多罗叶天”的精髓。\n");
    tell_object(who, "你的无相劫指晋升为多罗叶指了。\n");
    shaolin["wuxiang-zhi"] = 1;
    who->delete_skill("wuxiang-zhi");
    if (!who->query_skill("duoluo-zhi", 1))
      who->set_skill("duoluo-zhi", 1);
    who->map_skill("unarmed", "duoluo-zhi");
    who->map_skill("parry", "duoluo-zhi");
    who->reset_action();
    who->save();
    message("channel:rumor", HIM "【千里眼】某人：听说" + who->name() + HIM "的无相劫指晋升为多罗叶指了。\n" NOR, users());
  }
  return;
}
