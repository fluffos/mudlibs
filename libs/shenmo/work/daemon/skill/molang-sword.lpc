int valid_learn(object me)
{
	object ob;

	if( ( me->query("class") != "shen" || me->query("family/family_name")!= "天空界") && !me->samsara_check("molang-sword",1) )
                        return notify_fail("天空界的绝招,你从那里偷学的?\n");
	if( !(ob = me->query_temp("weapon"))
	||	(string)ob->query("skill_type") != "sword" )
		return notify_fail("你必须先找一把剑才能练剑法。\n");

	return 1;
}

int valid_enable(string usage)
{
         return (usage=="sword") || (usage=="parry");
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	if( (int)me->query("kee") < 30
	||	(int)me->query("force") < 5 )
		return notify_fail("你的内力或气不够，没有办法练习疾风魔狼剑。\n");
	me->receive_damage("kee", 30);
	me->add("force", -5);
	write("你按著所学练了一遍疾风魔狼剑。\n");
	return 1;
}

int valid_effect(object me, object weapon, string name, int skill)
{
}

void skill_improved(object me)
{
	if( (int)me->query_skill("molang-sword", 1)	% 10 == 0 ) {
		tell_object(me,
			RED "\n你突然觉得一股恶气冲上心头，只觉得想杀人....\n\n" NOR);
		me->add("bellicosity", 10);
	} else
		me->add("bellicosity", 1);
}

int effective_level() { return 10;}

int learn_bonus()
{
	return 20;
}
int practice_bonus()
{
	return 10;
}
int black_white_ness()
{
	return -20;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
        string msg;
        int ap,dp;
        object weapon;

        ap = me->query_skill("sword");
        ap += me->query_skill("molang-sword");
        dp =  victim->query_skill("parry");

        weapon = victim->query_temp("weapon");
        if(me->query_skill("molang-sword")>350 && me->query_skill("sword")>350){ 
        if( random(ap+dp) > dp && random(2)>0){
        if(me->query("force") > random(victim->query("force"))){
                               victim->start_busy(2);    
                               victim->receive_damage("kee", random(ap));
                               victim->receive_wound("kee", random(ap)/2); 
       msg = HIR"$n看见$N的剑气已近在眼前，身形却无法移动分毫，剑气在$n划开一道道的伤口。\n" NOR; 
                               }
                        else{
                               victim->start_busy(1);
                               victim->receive_damage("kee", random(ap)/2); 
                               victim->receive_wound("kee", random(ap)/4);  
       msg = HIW"$N念动真言，已经用剑气将$n团团围住。\n" NOR;
                                }
                                }
                   else {   
       msg = HIY"$n大喝一声，舞动手中兵器，拨开剑阵，连忙跳出开来！\n" NOR;
                                                           }
                }
                return msg; 
}

string perform_action_file(string action)
{
    return CLASS_D("tiankongjie") + "/molang-sword/" + action;
}

