	([	"name":			"风卷残云",
		"action":		"$N揉身上前，手中$w卷起阵阵劲风袭向$n的$l",
		"dodge":		50,
    "parry":    -40,
		"damage":		170,
		"damage_type":	"刺伤"
	]),
	([	"name":			"风驰电掣",
		"action":		"$n眼前一花，$N手中的$w已经迅捷无比的刺向$n的$l",
		"dodge":		50,
    "parry":    -40,	
		"damage":		180,
		"damage_type":	"刺伤"
	]),
	([	"name":			"血雨腥风",
		"action":		"$N高高跃起，反手一挥，手中$w铺天盖地封住了$n的去处",
		"dodge":		40,
    "parry":    -30,	
		"damage":		190,
		"damage_type":	"刺伤"
	]),
	([	"name":			"长风破浪",
		"action":		"$N身形一正，手中$w一抖，往$n的$l连续的刺出",
		"dodge":		40,
    "parry":    -50,	
		"damage":		180,
		"damage_type":	"刺伤"
	]),
	([	"name":			"疾风劲草",
		"action":		"$N的$w，简单而有效地往$n的$l刺去，仿佛后面的一剑快似之前",
		"dodge":		60,
    "parry":    -30,	
		"damage":		180,
