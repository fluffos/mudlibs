//windy
inherit SKILL;

mapping *action = ({
  ([ "action": "$N高举起手中$w，使出一招「金刚在世」，直直劈向$n的$l处",
    "dodge": -50,
    "parry": -20,
    "damage": 30,
    "skill_name": "金刚在世",
    "damage_type": "挫伤",
  ]),
  ([ "action": "$N使出「金刚伏魔」，单手舞动$w，一伏身，$w横扫$n的下盘",
    "dodge": -50,
    "parry": -20,
    "damage": 40,
    "skill_name": "金刚伏魔",
    "damage_type": "挫伤",
  ]),
  ([ "action": "$N反身仰面，使出一式「金刚宣法」，双手握$w，直刺$n的$l",
    "dodge": -80,
    "parry": -20,
    "damage": 50,
    "skill_name": "金刚宣法",
    "damage_type": "挫伤",
  ]),
  ([ "action": "$N使出一招「引趣众生」，双手高高举起$w，猛撩向$n的裆部",
    "dodge": -70,
    "parry": -30,
    "damage": 50,
    "skill_name": "引趣众生",
    "damage_type": "挫伤",
  ]),
  ([ "action": "$N舞动手中$w，使一式「歌舞阎罗」，锤影顿时罩住$n的全身",
    "dodge": -100,
    "parry": -30,
    "damage": 50,
    "skill_name": "歌舞阎罗",
    "damage_type": "挫伤",
  ]),
  ([ "action": "$N使出一招「浮游血海」，全身贴地而飞，手中$w直捣$n的$l",
    "dodge": -90,
    "parry": -40,
    "damage": 60,
    "skill_name": "浮游血海",
    "damage_type": "挫伤",
  ]),
  ([ "action": "$N使出一式「驱鬼御魔」，以手中$w支地，双足飞揣$n的$l处",
    "dodge": -70,
    "parry": -70,
    "damage": 70,
    "skill_name": "驱鬼御魔",
    "damage_type": "挫伤",
  ]),
  ([ "action": "$N运力于掌，使出「荡魔除妖」飞身疾进，手中$w横扫$n的$l",
    "dodge": -80,
    "parry": -30,
    "damage": 80,
    "skill_name": "荡魔除妖",
    "damage_type": "挫伤",
  ]),
});

int valid_enable(string usage) {
  return usage == "stick" || usage == "parry";
}

int valid_learn(object me) {
  if (me->query("family/family_name") != "大昭寺" && !me->samsara_check("xiangmo-chu", 1))
    return notify_fail("你非密宗弟子，难以领会金刚降魔杵的奥妙之处！\n");
  if ((int)me->query("max_force") < 800)
    return notify_fail("你的内力修为不够，难以修炼金刚降魔杵。\n");

  if ((int)me->query_skill("force") < 200)
    return notify_fail("你的内功火候太浅，难以修炼金刚降魔杵。\n");

  if ((int)me->query_skill("stick", 1) < 50)
    return notify_fail("你的基本棍法不够，难以修炼金刚降魔杵。\n");

  if ((int)me->query_skill("lamaism", 1) < (int)me->query_skill("xiangmo-chu", 1) / 2)
    return notify_fail("你的密宗佛法水平有限，无法领会更高深的金刚降魔杵。\n");

  return 1;
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon")) ||
    (string)weapon->query("skill_type") != "stick")
    return notify_fail("你使用的武器不对。\n");

  if ((int)me->query("kee") < 50)
    return notify_fail("你的体力不够，练不了金刚降魔杵。\n");

  if ((int)me->query("force") < 70)
    return notify_fail("你的内力不够，练不了金刚降魔杵。\n");

  me->receive_damage("kee", 45);
  me->add("force", -60);

  return 1;
}

string perform_action_file(string action) {
  return CLASS_D("dazhaosi") + "/xiangmo-chu/" + action;
}
