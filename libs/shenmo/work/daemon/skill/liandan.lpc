// lianyao.c
#include <ansi.h>
inherit SKILL;

string level_description(int level)
{
        int grade;
        string *level_desc = ({
                BLU "若有若无" NOR,
                HIB "初窥门径" NOR,
                HIY "渐入佳境" NOR,
                HIB "初窥药道" NOR,
                YEL "登堂入室" NOR,
                YEL "英华内敛" NOR,
                YEL "通关在即" NOR,
                CYN "豁然开朗" NOR,
                HIC "举世无双" NOR,
                HIC "震古铄今" NOR,
                HIW "一代宗师" NOR
        });
        grade = level / 20;

        if( grade >= sizeof(level_desc) )
                grade = sizeof(level_desc)-1;
        return level_desc[grade];
}
