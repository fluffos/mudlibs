    "force": 280,
    "damage": 170,
    "lvl": 36,
    "damage_type": "抓伤"
  ]),
  ([ "action": "$N绕着$n快速的转了几圈，暴吼一声，掌爪互逆，几道冷风从指端射出，袭向$n\n",

    "dodge": 10,
    "parry": 25,
    "force": 350,
    "damage": 170,
    "lvl": 45,
