    "damage": 100,
    "lvl": 0,
    "damage_type": "抓伤"
  ]),
  ([ "action":
    "$N突然倒下装死，就在$n疑惑不定之间，猛然跃起，双手抓向$n的面门",
    "dodge": 10,
    "parry": 10,
    "force": 160,
    "damage": 120,
    "lvl": 10,
    "weapon": "五根手指",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N在地上快速爬了几步，绕到$n身后，一爪抓下",
    "dodge": 15,
    "parry": 15,
    "force": 180,
    "damage": 140,
    "lvl": 18,
    "damage_type": "抓伤"
  ]),

  ([ "action": "$N脸上隐隐泛出绿色，一显即逝，右爪探向$n",
    "dodge": 5,
    "parry": 25,
    "force": 200,
    "damage": 150,
    "lvl": 26,
    "damage_type": "内伤"
  ]),
  ([ "action": "$N轻轻的对着$n脸上吹了一口气，$n瞬间方寸大乱，$N借机连向$n胸前抓了数下\n",

    "dodge": 15,
