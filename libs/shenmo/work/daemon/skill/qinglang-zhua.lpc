    "force": 450,
    "damage": 185,
    "lvl": 63,
    "damage_type": "抓伤"
  ])
});
int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }


int valid_learn(object me) {

  return 1;
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  return 1;
}

string perform_action_file(string func) {
  return CLASS_D("sfighter") + "/qinglang-zhua/" + func;
}

string powercol(int level) {
  if (level == 1)
    return HIC "X 级力量" NOR;
  else if (level == 2)
    return HIC "Z 级力量" NOR;
  else if (level == 3)
    return HIC "V 级力量" NOR;
  else if (level == 4)
    return HIW "白 鬭 气" NOR;
  else if (level == 5)
    return HIY "黄 鬭 气" NOR;
  else if (level == 6)
    return HIG "绿 鬭 气" NOR;
  else if (level == 7)
    return HIR "红 鬭 气" NOR;
  else if (level == 8)
    return HIB "蓝 鬭 气" NOR;
  else if (level == 9)
    return HIM "紫 鬭 气" NOR;
  else
    return BLK "黑 鬭 气" NOR;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int mylvl, tlvl, i, j, k;
  string msg, msgcol;
  object tweapon, target;
  target = victim;
  mylvl = me->query_skill("power", 1);
  tlvl = target->query_skill("power", 1);
  tweapon = target->query_temp("weapon");
  i = mylvl * 2 + me->query_skill("unarmed", 1) / 2;
  j = target->query_skill("parry", 1) * 2 + target->query_skill("dodge", 1);
  if (me->query("power_lvl") > 3) {
    if (i * me->query("power_lvl") / 6 > random(j)) {
      damage_bonus += damage_bonus * me->query("power_lvl") / 10;
      victim->receive_wound("kee", damage_bonus);
      target->start_busy(1);
      msgcol = powercol(me->query("power_lvl"));
      switch (random(1)) {
        case 0: msg = HIW "$n被$N的" + msgcol + HIW "一震，气血翻腾不休！\n" NOR;
        case 1: msg = HIW "$N劲力一吐，" NOR + msgcol + HIW "化为一道气波冲出,击中$n的$l！\n" NOR;
      }
      return msg;
    }
  }
}
