#include <ansi.h>
inherit SKILL;

mapping *action = ({
  ([ "action": "$N双手虚晃，左脚猛地飞起，一式「风起云涌」，脚尖晃动，踢
向$n的$l",
    "damage_type": "撞伤",
    "parry": 8,
    "dodge": -55,
    "damage": 60,
    "skill_name": "风起云涌"
  ]),
  ([ "action": "$N两手护胸，双脚交叉踢起，一式「风扫残云」，脚脚不离$n的面门左右",
    "damage_type": "拳伤",
    "parry": -15,
    "dodge": -55,
    "damage": 50,
    "skill_name": "风扫残云"
  ]),
  ([ "action": "$N突然侧身，却步后退，一个前空翻，右脚自上而下一式「流星坠
地」，照$n的面门直劈下来",
    "damage_type": "劈伤",
    "parry": -5,
    "dodge": -65,
    "damage": 60,
    "weapon": "右脚",
    "skill_name": "流星坠地"
  ]),
  ([ "action": "$N使一式「朔风吹雪」，全身突然飞速旋转，双足忽前忽后，迅猛
无及踹向$n的胸口",
    "damage_type": "瘀伤",
    "parry": 7,
    "dodge": -22,
    "damage": 70,
    "skill_name": "朔风吹雪"
  ]),
  ([ "action": "$N抽身跃起，开声吐气，大喝一声：嗨！一式「风卷残云」，双脚
如旋风般踢向$n的$l",
    "force": 5,
    "damage": 70,
    "dodge": 5,
    "damage_type": "重伤",
    "parry": -5,
    "skill_name": "风卷残云"
  ]),
});

int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int valid_learn(object me) {
  mapping shaolin;
  if (me->query_temp("weapon")
    || me->query_temp("secondary_weapon"))
    return notify_fail("练连环鸳鸯腿必须空手。\n");
  shaolin = me->query("门派/shaolin");
  if (shaolin["saoye-leg"])
    return notify_fail("你的腿法早已升级了，再学这种下等腿法也是枉然。\n");
  if (me->query_skill("saoye-leg", 1) > 300 && !me->query_temp("shaolin_saoye_improve"))
    return notify_fail("你需要去向昙宗大师傅请教腿法的奥妙了。\n");
  return 1;
}

int practice_skill(object me) {
  if (me->query("class") != "human")
    return notify_fail("非尘世之人如何参得？\n");
  if (me->query("sen") < 200)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if (me->query("kee") < 200)
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");
  if (me->query("force") < 250)
    return notify_fail("你的内力不够了。\n");
  me->receive_damage("kee", 15, me);
  me->receive_damage("sen", 15, me);
  me->add("force", -20);
  return 1;
}

string perform_action_file(string func) {
  return CLASS_D("shaolin") + "/saoye-leg/" + func;
}

void skill_improved(object who) {
  mapping shaolin;
  if (!who || !wizardp(who))
    return;
  if (who->query_skill("yuanyang-leg", 1)) {
    tell_object(who, "你的狂风扫叶腿早已晋升为连环鸳鸯腿了。\n");
    who->delete_skill("saoye-leg");
    who->reset_action();
    who->save();
    return;
  }
  shaolin = who->query("门派/shaolin");
  if (!shaolin || !mapp(shaolin)) shaolin = ([]);
  if (who->query_skill("saoye-leg", 1) > 450) {
    tell_object(who, "你对狂风扫叶腿的使用了如指掌。\n");
    tell_object(who, "你对狂风扫叶腿的研究更进了一步。\n");
    tell_object(who, "你的狂风扫叶腿晋升为连环鸳鸯腿了。\n");
    shaolin["saoye-leg"] = 1;
    who->set("门派/shaolin", shaolin);
    who->delete_skill("saoye-leg");
    if (!who->query_skill("yuanyang-leg", 1))
      who->set_skill("yuanyang-leg", 1);
    who->map_skill("unarmed", "yuanyang-leg");
    who->map_skill("parry", "yuanyang-leg");
    who->reset_action();
    who->save();
    message(
      "channel:rumor",
      HIM "【千里眼】某人：听说" + who->name() + HIM "的狂风扫叶腿晋升为连环鸳鸯腿了。\n" NOR,
      users()
    );
  }
  return;
}
