// tianmogong.c  【天魔功】

#include <ansi.h>

inherit SKILL;

int valid_enable(string usage) { return usage == "spells"; }

int valid_learn(object me) {
  if (me->query("class") != "yao" && !me->samsara_check("tianmogong") && me->query("spskk") != 13) return notify_fail("你非妖族弟子，无法习得！\n");
  if (2 * (int)me->query_skill("spells", 1) <= (int)me->query_skill("tianmogong", 1))
    return notify_fail("你的法术修为还不够高深，无法学习天魔功。\n");
  return 1;
}

string cast_spell_file(string spell) {
  return CLASS_D("sanjie") + "/tianmogong/" + spell;
}

string type() { return "magic"; }

int stage(int level) {
  if (level < 200) return 1;
  else if (level < 400) return 2;
  else if (level < 600) return 3;
  else if (level < 800) return 4;
  else return 5;
}

string level_description(int level) {
  if (stage(level) < 2)
    return HIR "天魔蚀肉" NOR;
  else if (stage(level) < 3)
    return HIM "天魔蚀骨" NOR;
  else if (stage(level) < 4)
    return HIC "天魔蚀经" NOR;
  else if (stage(level) < 5)
    return HIW "天魔蚀魂" NOR;
  else
    return HIY "天魔极乐" NOR;
}
