inherit SKILL;

int valid_enable(string usage) { return usage == "spells"; }

int valid_learn(object me) {
  if (me->query("family/family_name") != "武当派" && !me->samsara_check(
    "taixu-spells",
    1
  )) return notify_fail("你非人族，无法学习。\n");
  if ((int)me->query_skill("spells", 1) < 10
    || (int)me->query_skill("spells", 1) <= (int)me->query_skill("taixu-spells", 1))
    return notify_fail("你的法术修为还不够高深，无法学习太虚仙法。\n");
  return 1;
}

string cast_spell_file(string spell) {
  return CLASS_D("wudang") + "/taixu-spells/" + spell;
}

string type() { return "magic"; }
