inherit SKILL;

mapping *action = ({
  ([ "action": "$N气凝如山，一式「金戈铁马」，双拳蓄势而发，击向$n的$l",
    "force": 180,
    "dodge": 5,
    "skill_name": "金戈铁马",
    "damage_type": "内伤"
  ]),
  ([ "action": "$N身形凝重，劲发腰背，一式「木已成舟」，缓缓向$n推出",
    "force": 200,
    "dodge": 5,
    "damage": 110,
    "skill_name": "木已成舟",
    "damage_type": "内伤"
  ]),
  ([ "action": "$N步伐轻灵，两臂伸舒如鞭，一式「水中捞月」，令$n无可躲闪",
    "force": 230,
    "dodge": 15,
    "damage": 110,
    "skill_name": "水中捞月",
    "damage_type": "内伤"
  ]),
  ([ "action": "$N身形跃起，一式「火海刀山」，双拳当空击下，势不可挡",
    "force": 270,
    "dodge": 5,
    "damage": 120,
    "skill_name": "火海刀山",
    "damage_type": "内伤"
  ]),
  ([ "action": "$N身形一矮，一式「土载万物」，两拳自下而上，攻向$n",
    "force": 320,
    "dodge": 10,
    "damage": 115,
    "skill_name": "土载万物",
    "damage_type": "内伤"
  ]),
  ([ "action": "$N身形一转，一式「阴风惨惨」，攻向$n的身前身后",
    "force": 380,
    "dodge": 25,
    "damage": 125,
    "skill_name": "阴风惨惨",
    "damage_type": "内伤"
  ]),
  ([ "action": "$N移形换位，步到拳到，一式「阳光普照」，四面八方都是拳影",
    "force": 450,
    "dodge": 15,
    "damage": 135,
    "skill_name": "阳光普照",
    "damage_type": "内伤"
  ]),
  ([ "action": "$N长啸一声，向前踏出一步，双拳中宫直进，一式「七者皆伤」，骤然击向$n的前胸",
    "force": 530,
    "dodge": 20,
    "damage": 150,
    "skill_name": "七者皆伤",
    "damage_type": "内伤"
  ])
});

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练七伤拳必须空手。\n");
  if (me->query("class") != "human" && !me->samsara_check(
    "qishang-quan",
    1
  ) && me->query("spskkk") != 6)
    return notify_fail("非我族类，勿练此术！\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("sen") < 30)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if ((int)me->query("kee") < 30)
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");
  if ((int)me->query("mingjiao/xiexun") < 1)
    return notify_fail("你没帮他杀了成昆吧。\n");
  if ((int)me->query("force") < 10)
    return notify_fail("你的内力不够了。\n");

  me->add("force", -10);
  call_out("skill_improved", 1, me);
  return 1;
}

void skill_improved(object me) {
  int skill;
  skill = (int)me->query_skill("qishang-quan", 1);
  if ((skill == 50
    || skill == 60
    || skill == 70
    || skill == 80
    || skill == 90
    || skill >= 100)
    && me->query("spskk") != 9) {
    me->set("mark/qishang_poison", 1);
    me->apply_condition("qishang_poison", skill / 5);
    tell_object(me, "你被七伤拳所伤，五脏六腑全部受伤了。\n");
  }
}

string perform_action_file(string func) {
  return CLASS_D("mingjiao") + "/qishang-quan/" + func;
}
