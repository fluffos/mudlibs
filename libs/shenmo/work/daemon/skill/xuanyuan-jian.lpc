// 轩辕剑法

inherit SKILL;
#include <ansi.h>

mapping *action = ({
  ([ "action": "$N手中的$w荡出，就如大江东去，威力势不可挡",
    "dodge": -30,
    "parry": -70,
    "damage": 130,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N踏上一步，手中$w舞出一道剑光劈向$n的$l",
    "dodge": -30,
    "parry": -80,
    "damage": 120,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N手中$w一抖，一剑刺出，攻向$n的$l，没有半点花巧",
    "dodge": -40,
    "parry": -80,
    "damage": 140,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N手中$w微微颤动，忽然刺出，一道剑光射向$n的$l",
    "dodge": -50,
    "parry": -90,
    "damage": 140,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N横过$w，蓦然横扫$n，气势如虹，荡气回肠",
    "dodge": -50,
    "parry": -100,
    "damage": 150,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N手中的$w连削带刺，夹带着一阵旋风掠过$n全身",
    "dodge": -50,
    "parry": -100,
    "damage": 200,
    "damage_type": "刺伤"
  ])
});

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

int valid_learn(object me) {
  if (me->query("family/family_name") != "三圣宫" && !me->samsara_check("xuanyuan-jian", 1))
    return notify_fail("你非三圣宫弟子，难以领会轩辕剑法的奥妙之处！\n");
  if (me->query("int") < 45)
    return notify_fail("你的先天悟性太差，无法领会轩辕剑法。\n");

  if (me->query("str") < 45)
    return notify_fail("你的先天膂力孱弱，无法学习轩辕剑法。\n");

  if ((int)me->query_skill("force") < 380)
    return notify_fail("你的内功火候不到，无法学习轩辕剑法。\n");

  if (me->query_skill("zhenlongqi", 1) < 220)
    return notify_fail("你的真龙之气等级不够，无法领悟轩辕剑法！\n");

  if (me->query("max_force") < 5000)
    return notify_fail("你的内力太差，无法学习轩辕剑法。\n");

  if (me->query_skill("force", 1) < me->query_skill("xuanyuan-jian", 1))
    return notify_fail("你的基本内功水平有限，无法领会更高深的轩辕剑法。\n");

  if (me->query_skill("zhenlongqi", 1) < me->query_skill("xuanyuan-jian", 1) / 2)
    return notify_fail("你的真龙之气水平有限，无法领会更高深的轩辕剑法。\n");

  return 1;
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  object weapon;
  object env;

  env = environment(me);
  if (!env->query("can_practice_xuanyuan-jian"))
    return notify_fail("你拿起剑挥舞了半天，只觉得此处不适合练习轩辕剑法。\n");

  if (!objectp(weapon = me->query_temp("weapon")) ||
    (string)weapon->query("skill_type") != "sword" ||
    weapon->query("id") != "xuanyuan sword")
    return notify_fail("必须装备轩辕剑才能练习轩辕剑法。\n");

  if ((int)me->query("kee") < 300)
    return notify_fail("你的体力不够练轩辕剑法。\n");
  if ((int)me->query("sen") < 300)
    return notify_fail("你的精神不足练轩辕剑法。\n");

  if ((int)me->query("force") < 500)
    return notify_fail("你的内力不够练轩辕剑法。\n");

  me->receive_damage("kee", 200);
  me->receive_damage("sen", 200);
  me->add("force", -50);

  message_vision(HIW "\n$N" HIW "屏气凝息，挥舞着手中的" + weapon->name() + HIW "，专心练习轩辕剑法。\n", me);

  return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int lvl, i;
  object weapon = me->query_temp("weapon");
  if ((int)me->query_skill("xuanyuan-jian", 1) < 350)
    return 0;
  lvl = (int)me->query_skill("xuanyuan-jian", 1) / 100;
  if (lvl > 15) lvl = 15;

  if (random((int)me->query_kar()) > (int)victim->query_kar() / 10 && time() - (int)me->query_temp("xuanyuan_autopfm") > 1 + random(2)) {
    me->set_temp("xuanyuan_autopfm", time());
    message_vision(
      HIW "只见$N" HIW "手中" + weapon->name() + HIW "犹如神助，从天而下，威不可挡地劈向$n" HIW "，气势恢弘之极！\n" NOR,
      me,
      victim
    );
    for (i = 1; i <= lvl; i++) {
      COMBAT_D->do_attack(me, victim, me->query_temp("weapon"));
    }
  }
}

string perform_action_file(string action) {
  return CLASS_D("sansheng") + "/xuanyuan-jian/" + action;
}
