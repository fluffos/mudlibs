// ghost-dodge.c 鬼影迷踪步法
#include <ansi.h>

inherit SKILL;

string *dodge_msg = ({

  "$n身似鬼魅，足不动，腿不抬，竟然飘然飞起，居然轻描淡写避过了$N这招。\n\n",

  "$N一招击至，看似打个正着，却不料$n身形突然消失，一回头，发现竟然已在身后！\n\n",

  "只见$n脚步散乱，身形乱晃，$N眼前顿时只剩一团鬼影，不知如何攻击！\n\n",

  "$n突然加快步法，化作一团烟雾在$N身前身后忽左忽右游走，$N眼花缭乱招招落空。\n\n",

  "$n面带诡笑，身体竟似全无重量，看似被击中，却随$N招式飘出，并未受一丝伤害。\n\n",

  "$n膝盖不弯，直上直下地跳动，看似极笨拙，却轻而易举地躲开了$N的攻击。\n\n" NOR });


int valid_enable(string usage) { return (usage == "dodge") || (usage == "move"); }

int valid_learn(object me) {
  if ((int)me->query("max_force") < 0)
    return notify_fail("你的内力不够，没有办法练鬼影迷踪。\n");
  return 1;
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 40)
    return notify_fail("你的体力太差了，不能练鬼影迷踪。\n");
  if (me->query("family/family_name") != "阎罗地府" && (int)me->query("spsk") != 10)
    return notify_fail("鬼影迷踪是阎罗地府不传之密。\n");
  if (me->query_skill("ghost-steps", 1) > 1499)
    return notify_fail("你的鬼影迷踪已经不能再通过练习进步了。\n");
  me->receive_damage("kee", 30);
  return 1;
}

int ob_hit(object ob, object me, int damage) {
  object wp1;
  string msg;
  int p, j = 0, skill, neili, neili1;
  wp1 = ob->query_temp("weapon");
  skill = me->query_skill("ghost-steps", 1);
  neili = me->query("force");
  neili1 = ob->query("force");

  if (damage < 10)
    damage = 10;

  if (random(skill) > ob->query_skill("dodge", 1) / 4
    && random(me->query("combat_exp")) > ob->query("combat_exp") / 4
    && random(me->query("level")) > ob->query("level") / 4
    && me->query_skill_mapped("dodge") == "ghost-steps"
    && (int)ob->query("spsk") != 14
    && (int)ob->query("spskkk") != 2
    && neili > 100 && skill > 150) {
    msg = "$n不见有任何动作，只是身子一晃一转，蹴的一下转到$N的背后。\n";
    if (!ob->query("env/no_msg"))
      tell_object(ob, HIR "你只觉眼前一花，不见了对手的身影！\n" NOR);
    if (neili >= random(neili1) + damage) {
      msg += WHT "结果$N的力道被$n完全躲开了！\n" NOR,
        j = -damage;
    } else if (neili < random(neili1) + damage && neili * 3 / 2 >= random(neili1) + damage) {
      msg += CYN "结果$n躲过了$N的一大半力道！\n" NOR,
        j = -damage / 4 * 3;
    } else if (neili * 3 / 2 < random(neili1) + damage && neili * 2 >= random(neili1) + damage) {
      msg += YEL "结果$N的力道被躲过了一半！\n" NOR,
        j = -damage / 2;
    } else {
      msg += BLU "结果$n只躲过了$N的一小半力道！\n" NOR,
        j = -damage / 4;
    }
    if (!j)
      return 0;
    me->set_temp("dodge_skill_msg", msg);
    return j;
  }
}
