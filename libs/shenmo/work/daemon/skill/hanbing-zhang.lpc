// 寒冰掌 宇文阀武功
//中极-->终极武功

#include <ansi.h>
inherit SKILL;

mapping *action = ({
  ([ "action": "$N双手一翻，两掌带着淡淡的蓝光，一招「冰封三尺」直向$n拍去",
    "apply_factor": 4,
    "name": "冰封三尺",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N右手冒出阵阵寒气，正是一招「冰寒刺骨」划了一个弧线朝$n的$l处打去!",
    "apply_factor": 8,
    "name": "冰寒刺骨",
    "damage_type": "瘀伤"
  ]),

  ([ "action": "$N掌中的寒气呈螺旋气劲，一招「冰剐万斩」猛地朝$n的$l处击去!",
    "apply_factor": 5,
    "name": "冰剐万斩",
    "damage_type": "刺伤"
  ]),

  ([ "action": "$N手掌一翻，双手掌重叠，使出一招「冰河莽莽」，只见一股螺旋冰气劲朝$n的$l处激射过去！",
    "apply_factor": 7,
    "name": "冰河莽莽",
    "damage_type": "内伤"
  ]),

  ([ "action": "$N双掌平推，$n只觉得一股翻江倒海之力朝自己压来,正是那招「冰玄成盾」!",
    "apply_factor": 10,
    "name": "冰玄成盾",
    "damage_type": "震伤"
  ]),
  ([ "action": "$N默运内力，使出一招「冰冻时空」，只见$N双掌中突然散发出一股极其阴寒的真气只扑$n的全身",
    "apply_factor": 6,
    "name": "冰冻时空",
    "damage_type": "震伤"
  ]),
});

string *parry_weapon = ({

  "$N手掌左右连续变换，$n一时不知从何处下手。\n",
  "$N微微一笑，手掌中一道阴寒的真气喷出，$n的进攻已经被冰消瓦解！\n",
  "$N手掌一挥，随后迅速闪开，伺机寻找着进攻的机会。\n",
  "$N身躯一震，双掌中猛的一推，虽是简单的招式，却封住了$n的全部进攻之力！\n"
});

string *parry_hand = ({

  "$N手掌左右连续变换，$n一时不知从何处下手。\n",
  "$N微微一笑，手掌中一道阴寒的真气喷出，$n的进攻已经被冰消瓦解！\n",
  "$N手掌一挥，随后迅速闪开，伺机寻找着进攻的机会。\n",
  "$N身躯一震，双掌中猛的一推，虽是简单的招式，却封住了$n的全部进攻之力！\n"

});

mapping query_action(object me) {
  return action[random(sizeof(action))];
}
mapping *query_all_action(object me) {
  return action;
}

string query_parry_action(object me, object victim) {
  if (victim->query_temp("weapon"))
    return parry_weapon[random(sizeof(parry_weapon))];
  return parry_hand[random(sizeof(parry_hand))];

}

int valid_learn(object me) {



  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("空了手才能学习寒冰掌。\n");
  return 1;


}

int practice_skill(object me) {
  object weapon;


  if (objectp(weapon = me->query_temp("weapon")))
    return notify_fail("必须空手才可以练习寒冰掌。\n");
  return 1;
}

string *query_perform() {
  return ({ "bingfeng", "dragon" });
}


string query_type() {
  return "hand";
}

string query_base() {
  return "strike";
}



int skill_damage(object me) {

  int damage;


  return damage;
}
