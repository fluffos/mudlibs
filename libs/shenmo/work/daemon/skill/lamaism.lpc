// chanzong.c

inherit SKILL;

int valid_enable(string usage) { return usage == "spells"; }

int valid_learn(object me) {
  if ((int)me->query_skill("spells", 1) <= (int)me->query_skill("lamaism", 1))
    return notify_fail("你的法术修为还不够高深，无法学习密宗佛法。\n");
  if ((int)me->query("bellicosity") > 100)
    return notify_fail("你的杀气太重，无法修炼密宗佛法。\n");
  //if ( me->query("faith")/500 < (me->query_skill("lamaism",1)-500)/50 ) return notify_fail("你需要为大昭寺多做贡献，才能学习该//技能！\n");
  return 1;
}

string cast_spell_file(string spell) {
  return CLASS_D("dazhaosi") + "/lamaism/" + spell;

}

string type() { return "magic"; }
