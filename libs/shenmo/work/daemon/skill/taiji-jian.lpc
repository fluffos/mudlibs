int valid_learn(object me) {

  object ob;

  if (me->query("family/family_name") != "武当派" && !me->samsara_check("taiji-jian", 1))
    return notify_fail("你非武当弟子，难以领会太极剑法的奥妙之处！\n");

  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力不够，没有办法练太极剑法。\n");

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能练剑法。\n");

  return 1;
}

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  me->query_temp("taiji");
  if (me->query_temp("taiji")) {
    if (!victim->is_busy() && random(4) == 1) victim->start_busy(1);
    // 部分消弱,fang@tsrj 2012-07-08
    //                        victim->receive_wound("kee",me->query_skill("taiji-jian",1)*2);
    victim->receive_wound("kee", me->query_skill("taiji-jian", 1));
    if (!me->query("env/no_msg") && !victim->query("env/no_msg"))
      message_vision(HIY "$N意走太极，看来$n受伤不轻！\n" NOR, me, victim);
  }
  if (damage_bonus < 100) return 0;

  if (random(damage_bonus / 2) > victim->query_str() / 10) {
    victim->receive_wound("kee", (damage_bonus - 50) / 5);
    switch (random(2)) {
      case 0: return HIR "你听到「喀啦」一声轻响，竟似是骨头爆裂的声音！\n" NOR;
      case 1: return HIY "$N劲力一吐，$n的$l发出「喀」地一声爆响！\n" NOR;
    }
  }
}
int practice_skill(object me) {

  if (me->query("family/family_name") != "武当派" && !me->samsara_check("taiji-jian", 1))
    return notify_fail("你非武当弟子，难以领会太极剑法的奥妙之处！\n");

  if ((int)me->query("sen") < 20
    || (int)me->query("force") < 300)
    return notify_fail("你的精力或内力不够，没有办法练习太极剑法。\n");


  me->receive_damage("sen", 15);
  me->add("force", -5);
  message_vision(HIY "$N你按照所学练习了一遍太极剑法。\n" NOR, me);

  return 1;
}
string perform_action_file(string func) {
  return CLASS_D("wudang") + "/taiji-jian/" + func;
}
