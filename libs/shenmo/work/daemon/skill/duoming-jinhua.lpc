int valid_learn(object me) {
  object ob;

  if ((int)me->query("max_force") < 500)
    return notify_fail("你的内力不够，没有办法练夺命金花。\n");


  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "throwing")
    return notify_fail("你必须先找一些暗器才能练夺命金花。\n");

  if (!me->samsara_check("duoming-jinhua", 1) && me->query("class") != "human")
    return notify_fail("你的种族不对，没有办法练夺命金花。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "throwing" || usage == "parry";
}
mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 500)
    return notify_fail("你的内力或气不够，没有办法练习夺命金花。\n");
  me->receive_damage("kee", 30);
  me->add("force", -30);
  write("你按著所学练了一遍夺命金花。\n");
  return 1;
}

string perform_action_file(string action) {
  return CLASS_D("mingjiao") + "/duoming-jinhua/" + action;
}

int effective_level() { return 15; }

int learn_bonus() {
  return -2220;
}
int practice_bonus() {
  return -1110;
}
int black_white_ness() {
  return 15;
}
