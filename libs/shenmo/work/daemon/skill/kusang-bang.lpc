int valid_learn(object me)
{
        object ob;

        if( (int)me->query("max_force") < 50 )
                return notify_fail("你的内力不够，没有办法练哭丧棒。\n");
if ( me->query("family/family_name")!="阎罗地府"   
  && me->query_skill("kusang-bang",1)<350 && !me->samsara_check("kusang-bang"))  
        return notify_fail("你的哭丧棒还没到开宗创祖的火候。\n");  

        if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "stick" )
                return notify_fail("你必须先找一根棒子才能练哭丧棒。\n");

        return 1;
}

int valid_enable(string usage)
{
        return usage=="stick" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
string name;
int i;
mapping actions;
        
i=me->query("HellZhen");
if ( me->query_temp("hell_three_stick") )
        actions = s_action[random(sizeof(s_action))];
else    {
        if( !me->query("HellZhen") ) 
                {
                actions=action[random(6)];
                }
        else    {
                actions=action[i];
                }
        }
name=actions["name"];
me->set_temp("kill_msg","special_msg");
me->set_temp("special_msg",name);
return actions;
}

int practice_skill(object me)
{
if ( me->query("class")!="xian" && !me->samsara_check("kusang-bang")) 
        return notify_fail("你不是仙界的。\n");
        if( (int)me->query("kee") < 30
        ||      (int)me->query("force") < 5 )
                return notify_fail("你的内力或气不够，没有办法练习哭丧棒。\n");
        me->receive_damage("kee", 30);
        me->add("force", -5);
        write("你按着所学练了一遍哭丧棒。\n");
        return 1;
}

int valid_effect(object me, object weapon, string name, int skill)
{
}

void skill_improved(object me)
{
        if( (int)me->query_skill("kusang-bang", 1)  % 10 == 0 ) {
                tell_object(me,
                        RED "\n你突然觉得一股恶气冲上心头，只觉得想杀人....\n\n" NOR);
                me->add("bellicosity", 100);
        } else
                me->add("bellicosity", 10);
}

string perform_action_file(string func)
{
return CLASS_D("ghost") + "/kusang-bang/" + func;
}

void post_zhua(object me,object target,object weapon, int damage)
{
int k,dayphase = NATURE_D->query_current_day_phase();

if ( !me || !target || !present(target,environment(me)) )
        return;

if ( (string)me->query("family/family_name")!="阴曹地府" )
        return;

if ( damage>800 && me->query_skill("jinghun-zhang",1)<350 )
        return;

k = (int)me->query_skill("jinghun-zhang");
if ( k>100 )
        k = 100;
if ( dayphase<5 )
        k+= 100;

target->apply_condition("hell_zhua",(int)target->query_condition("hell_zhua")+2+k/20);
message_vision(HIG"$n"HIG"身子一晃，背上留下了一个惨绿色的爪痕！\n"NOR,me,target);
if ( !target->is_busy() && k>50 && random(me->query_kar())>30 )
        target->start_busy(k/50);
}

void post_gun(object me,object target,object weapon, int damage)
{
int dayphase = NATURE_D->query_current_day_phase();
string msg,limb,*limbs,w_msg;

if ( !me || !target || !present(target,environment(me)) )
        return;

if ( (string)me->query("family/family_name")!="阴曹地府"
   || me->query_skill("kusang-bang",1)<180 )
        return;

if ( damage>800 && me->query_skill("kusang-bang",1)<350 )
        return;
if ( damage<=0 )
        damage = 100;
damage = damage/2+random(damage/2);
damage+= me->query_temp("apply/damage");
damage-= target->query_temp("apply/armor");
if ( damage<=100 )
        damage = 100;
if ( damage>500 )
        damage = 500;
if ( dayphase<5 )
        damage*= 2;

weapon = me->query_temp("weapon");
if ( !weapon )
        w_msg = "双拳";
else    w_msg = weapon->name();

msg = sprintf(HIB"$N"HIB"顺势将%s"HIB"一转，整个人高高跃起，连人带%s狠狠向$n"HIB"砸去!\n"NOR,
                w_msg,w_msg,w_msg);
if ( me->query("combat_exp")<random(target->query("combat_exp")/2) && !target->is_busy() )
        {
        msg+= sprintf(HIB"$n"HIB"见势不好,连忙用%s"HIB"架开了这一击。\n"NOR,
                        objectp(target->query_temp("weapon"))?target->query_temp("weapon")->name():"双拳",
                );
        message_vision(msg,me,target);
        return;
        }
msg+= sprintf(HIB"$n"HIB"哪里料到还有这一击，结果给%s"HIB"狠狠的砸了一下！\n"NOR,
                        w_msg);
msg+= COMBAT_D->damage_msg(damage,"砸伤");
limbs = target->query("limbs");
limb = limbs[random(sizeof(limbs))];
msg = replace_string(msg,"$l",limb);
msg = replace_string(msg,"$w",w_msg);
message_vision(msg,me,target);
target->receive_damage("kee",damage);
COMBAT_D->report_status(target);
}

void post_whip(object me,object target,object weapon, int damage)
{
int dayphase = NATURE_D->query_current_day_phase();
object env = environment(me);

if ( !me || !target || !present(target,env) )
        return;

if ( (string)me->query("family/family_name")!="阴曹地府" )
        return;

if ( damage>800 && me->query_skill("hellfire-whip",1)<350 )
        return;

if ( env->query("no_magic") || env->query("no_fight") )
        return;

if ( damage<100 )
        damage = 100;
damage = random(damage/5);
if ( dayphase<5 )
        damage+= random(250);

message_vision(HIB"\n「啪」地一团蓝色火焰在$N"HIB"脚下燃起，如鬼魅缠身，将$N"HIB"拢在中央。\n"NOR, target);
target->apply_condition("hell_fire",(int)target->query_condition("hell_fire")+damage/30);
}

