  ([ "action": "$N双掌一错，掌心向外横推而出，这一招" + YEL "「力士推山」" NOR "带着一股罡风扑向$n的$l",
    "dodge": 10,
    "parry": -30,
    "force": 150,
    "damage_type": "内伤",
    "weapon": "左手",
  ]),
