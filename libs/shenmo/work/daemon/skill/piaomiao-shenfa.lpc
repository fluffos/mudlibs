// piaomiao-shenfa.c 缥缈身法

#include <ansi.h>
inherit SKILL;

string *dodge_msg = ({
  "$n左一点右一晃，随即回到原地，轻巧地躲过了$N这一招。\n",
  "$n腾身跃起一个空翻，并顺势闪到一边。\n",
  "$n轻轻往旁边一纵，就已离$N有了相当的距离，$N这一招自然失效。\n",
  "$n揉身而上，轻灵地跃过$N，闪到了$N的背后。\n",
  "$n身形急闪，斜向前一步，竟然已经躲开了$N的这一招。\n",
  "$N眼前一花，却见$n竟然已离自己有数丈之远，却没见$n如何躲过自己的攻击。\n",
  "$N一个不留神，$n已没了踪影。$N急转身，却见$n在那儿向自己招手。\n",
  "$N一招攻出，$n已然不见，$N茫然四顾，却不见$n的影子！\n",
});

int valid_enable(string usage) { return (usage == "dodge"); }

int valid_learn(object me) {
  if ((me->query("class") != "saint" || me->query("family/family_name") != "通天教") && !me->samsara_check(
    "piaomiao-shenfa",
    1
  ))
    return notify_fail("你非通天教，自然学不得！\n");
  return 1;
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 50)
    return notify_fail("你的体力太差了，不能练缥缈身法。\n");
  if (me->query("family/family_name") != "通天教")
    return notify_fail("缥缈身法是通天教不传之密。\n");
  if (me->query_skill("piaomiao-shenfa", 1) > 999)
    return notify_fail("你的缥缈身法已经不能再通过练习进步了。\n");

  me->receive_damage("kee", 40);
  return 1;
}

int ob_hit(object ob, object me, int damage) {
  object wp1;
  string msg;
  int p, j = 0, skill, neili, neili1;
  wp1 = ob->query_temp("weapon");
  skill = me->query_skill("piaomiao-shenfa", 1);
  neili = me->query("force");
  neili1 = ob->query("force");

  if (damage < 10)
    damage = 10;

  if (random(skill) > ob->query_skill("dodge", 1) / 8
    && random(me->query("combat_exp")) > ob->query("combat_exp") / 8
    && random(me->query("level")) > ob->query("level") / 8
    && me->query_skill_mapped("dodge") == "piaomiao-shenfa"
    && (int)ob->query("spskk") != 6
    && (int)ob->query("spskkk") != 2
    && neili > 100 && skill > 150) {
    msg = "$n不见有任何动作，只是身子一晃一转，蹴的一下转到$N的背后。\n";
    if (!ob->query("env/no_msg"))
      tell_object(ob, HIR "你只觉眼前一花，不见了对手的身影！\n" NOR);
    if (neili >= random(neili1) + damage) {
      msg += WHT "结果$N的力道被$n完全躲开了！\n" NOR,
        j = -damage;
    } else if (neili < random(neili1) + damage && neili * 3 / 2 >= random(neili1) + damage) {
      msg += CYN "结果$n躲过了$N的一大半力道！\n" NOR,
        j = -damage / 4 * 3;
    } else if (neili * 3 / 2 < random(neili1) + damage && neili * 2 >= random(neili1) + damage) {
      msg += YEL "结果$N的力道被躲过了一半！\n" NOR,
        j = -damage / 2;
    } else {
      msg += BLU "结果$n只躲过了$N的一小半力道！\n" NOR,
        j = -damage / 4;
    }
    if (!j)
      return 0;
    me->set_temp("dodge_skill_msg", msg);
    return j;
  }
}
