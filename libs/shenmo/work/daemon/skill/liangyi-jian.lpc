int valid_enable(string usage) {
    return usage == "sword" || usage == "parry";
}

int valid_learn(object me) {
object ob; 
if( me->query("family/family_name")!="武当派" && !me->samsara_check("liangyi-jian",1)) 
        return notify_fail("你非武当弟子，难以领会两仪剑法的奥妙之处！\n"); 
if( (string)me->query_skill_mapped("force")!= "taiji-shengong")
        return notify_fail("你不激发太极神功，没法学两仪剑法！\n");
    if ((int)me->query_skill("taiji-quan", 1) < 40)
        return notify_fail("两仪剑法必须配合太极拳才可以进步！\n");
if( !(ob = me->query_temp("weapon")) 
||      (string)ob->query("skill_type") != "sword" ) 
        return notify_fail("你必须先找一把剑才能练剑法。\n"); 
    return 1;
}

mapping query_action(object me, object weapon)
{
mapping* m_actions;
m_actions=me->query("skill_liangyi-jian");
if(me->query("skill_liangyi-jian")==0 )
return action[random(sizeof(action))];
if( random(4) == 1 )
return m_actions[random(sizeof(m_actions))];
else
return action[random(sizeof(action))];
}

int practice_skill(object me) {
       if ((int)(me->query("kee")) < 50)
        return notify_fail("你已经精疲力竭，没法儿练下去啦！\n");
    me->receive_damage("kee", 30);
        write(HIW"『两仪生四象，四象生八卦』\n"NOR);
    return 1;
}

string perform_action_file(string action)
{
        return CLASS_D("wudang") + "/liangyi-jian/" + action;
}
