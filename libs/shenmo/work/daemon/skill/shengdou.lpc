int valid_enable(string usage) {
  return usage == "unarmed" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  string id = me->query("id");
  string name = me->name();   //(*)
  object victim = offensive_target(me);

  if (id == "zi long" || name == "紫龙") {
    if (random(3) == 1) {
      switch (random(3)) {
        case 0:
          message_vision(HIB "\n$N大喊一声『庐山升龙霸』一条居龙自九天而起，直飞$n！\n" NOR, me, victim);
          if (random(3) == 1 || random(me->query("combat_exp")) > random(victim->query("combat_exp") / 3)) {
            message_vision(HIB "$n" HIB "被巨龙在空中顶得翻了几十个跟头！\n" NOR, me, victim);
            victim->add("eff_kee", -victim->query("max_kee") / 10);
          } else message_vision(HIB "$n" HIB "身型急转，不知道绕了多少圈才夺过巨龙的攻击！\n" NOR, me, victim);
          break;

        case 1:
          message_vision(HIR "\n$N" HIR "高喊一声：『庐山亢龙霸』，一条恶龙自溅底而出，尾巴向$n" HIR "扫去！\n" NOR, me, victim);
          if (random(3) == 1 || random(me->query("combat_exp")) > random(victim->query("combat_exp") / 3)) {
            message_vision(HIR "$n" HIR "被恶龙的尾巴甩了个正着，$n" HIR "顿时眼冒金星！\n" NOR, me, victim);
            victim->add("eff_sen", -victim->query("max_sen") / 10);
          } else message_vision(
            RED "$n" RED "用尽全身力气，飞升而气，恶龙的尾巴正从$n" RED "的脚底板扫过！\n" NOR,
            me,
            victim
          );
          break;

        default:
          message_vision(HIW "\n$N高喊一声：『庐山百龙霸』，无数只巨龙向$n冲过来！\n" NOR, me, victim);
          if (random(3) == 1 || random(me->query("combat_exp")) > random(victim->query("combat_exp") / 3)) {
            message_vision(HIW "$n" HIW "如一个球一样，被无数只巨龙在空中戏弄着！\n" NOR, me, victim);
            victim->add("kee", -victim->query("max_kee") / 5);
            victim->add("sen", -victim->query("max_sen") / 5);
          } else message_vision(WHT "$n" WHT "看准了巨龙之间的空隙，左转右转，才勉强离难！\n" NOR, me, victim);
      }
    }
    return action_tl[random(sizeof(action_tl))];
  }

  else if (id == "xing shi" || name == "星矢") {
    if (random(3) == 1) {
      switch (random(3)) {
        case 3:
          message_vision(HIW "\n$N" HIW "跳在半空，大喝一声：『天马彗星拳』，千万流星汇作一点击向$n" HIW "！\n", me, victim);
          if (random(3) == 1 || random(me->query("combat_exp")) > random(victim->query("combat_exp") / 3)) {
            message_vision(BLU "$n" BLU "立刻被彗星的光辉淹没，顿时皮开肉绽，惨不忍睹！\n" NOR, me, victim);
            victim->add("kee", -(victim->query("max_kee") / 8));
          } else message_vision(
            HIY "$n" HIY "用尽全身力气，飞升而起，彗星的尾巴正从$n" HIY "的脚底板扫过！\n" NOR,
            me,
            victim
          );
          break;

        default:
          message_vision(HIC "\n$N大喊一声『天马流星拳』，双拳以光速化作千万流星冲向$n！\n", me, victim);
          if (random(3) == 1 || random(me->query("combat_exp")) > random(victim->query("combat_exp") / 3)) {
            message_vision(HIC "$n" HIC "被无数强劲的光团贯穿全身！\n" NOR, me, victim);
            victim->add("eff_kee", -(victim->query("max_kee") / 5));
          } else message_vision(HIG "$n" HIG "看破了$N" HIG "流星拳的轨迹，轻松躲开！\n" NOR, me, victim);
      }
    }
    return action_tm[random(sizeof(action_tm))];
  }
  //阿瞬
  else if (id == "a shun" || name == "阿瞬") {
    if (random(3) == 1) {
      switch (random(4)) {
        case 1:
          message_vision(HIM "\n$N" HIM "高喊一声：『星云锁链』，圣衣立刻在$n" HIM "四周布上重重封印！\n", me, victim);
          if (random(3) == 1 || random(me->query("combat_exp")) > random(victim->query("combat_exp") / 3)) {
            message_vision(HIM "\n$n" HIM "的攻击立刻变得无效起来！\n" NOR, me, victim);
            if (random(2) == 1)
              SDS_D->powerup(me);
            victim->start_busy(random(3));
          } else message_vision(HIC "\n$n" HIC "纵身跳出锁链的包围，再次发动攻击！\n" NOR, me, victim);
          break;

        case 2:
          message_vision(HIM "\n$N" HIM "高喊一声：『星云黑洞』，$n" HIM "心神一震，想是受了重创！\n" NOR, me, victim);
          if (random(3) == 1 || random(me->query("combat_exp")) > random(victim->query("combat_exp") / 3)) {
            message_vision(HIR "$n" HIR "胸口一甜，一口鲜血已控制不住的喷出！\n" NOR, me, victim);
            victim->add("eff_sen", -(victim->query("max_sen") / 10));
            victim->add("kee", -(victim->query("max_kee") / 20));
          } else message_vision(HIG "$n" HIG "暗自凝聚元神，将体内的逆血平复！\n" NOR, me, victim);
          break;

        default:
          message_vision(HIG "\n$N" HIG "将星云锁链舞动如风，一股旋转的气流在$P四周旋动。\n" NOR, me);
          if (random(3) == 1) {
            message_vision(YEL "$n" YEL "的攻击受气流的影响，招招打向自己。\n" NOR, me, victim);
            COMBAT_D->do_attack(victim, victim, victim->query_temp("weapon"));
          } else message_vision(HIG "气流旋转着，$n" HIG "沉着应战，不受它的影响。\n" NOR, me, victim);
      }
    }
    return action_xn[random(sizeof(action_xn))];
  }

  //冰河
  else if (id == "bing he" || name == "冰河") {
    if (random(3) == 1) {
      switch (random(4)) {
        case 1:
          message_vision(HIW "\n$N" HIW "高喊一声：『鑽石星塵拳』，$n" HIW "四周的空气立刻好似凝固起来！\n", me, victim);
          if (random(3) == 1 || random(me->query("combat_exp")) > random(victim->query("combat_exp") / 3)) {
            message_vision(HIW "$n" HIW "顿时觉得行动缓慢起来，连呼吸都变得困难！\n" NOR, me, victim);
            victim->add("kee", -(victim->query("max_kee") / 5));
            victim->start_busy(1 + random(1));
          } else message_vision(HIW "$n" HIW "连忙运起浑身真气，抵御住刺骨的寒风！\n" NOR, me, victim);
          break;

        case 2:
          message_vision(
            HIW "\n$N" HIW "高喊一声：『曙光女神之宽恕』，$n" HIW "所在的空间立刻好似变成了另一个空间！\n" NOR,
            me,
            victim
          );
          if (random(3) == 1 || random(me->query("combat_exp")) > random(victim->query("combat_exp") / 3)) {
            message_vision(WHT "$n" WHT "冻得不住的打冷战，哪里有心思继续战斗！\n" NOR, me, victim);
            victim->add("eff_kee", -(victim->query("max_kee") / 20));
            victim->start_busy(random(4));
          } else message_vision(HIG "$n" HIG "哈哈大笑，这点伎俩算不得什么！\n" NOR, me, victim);
          break;

        default:
          message_vision(WHT "\n四周的空气逐渐越来越寒冷....\n" NOR, me);
          if (random(3) == 1 || random(me->query("combat_exp")) > random(victim->query("combat_exp") / 3)) {
            victim->start_busy(random(3));
            message_vision(WHT "$n" WHT "的动作渐渐变的缓慢起来。\n" NOR, me, victim);
          } else message_vision(HIG "$n" HIG "沉着应战，不受空气的影响。\n" NOR, me, victim);
      }
    }
    return action_te[random(sizeof(action_te))];
  }
  //一辉 (*)
  else if (id == "yi hui" || name == "一辉")
    return action_phix[random(sizeof(action_phix))];
  //那智
  else if (id == "na zhi" || name == "那智") {
    if (random(3) == 1) {
      message_vision(HIB "\n$N" HIB "身形一缩，内外气息一张一阖之间，身形斗然爆涨！毛发虬张，仰天发
出一声长嚎！\n" NOR, me, victim);
      if (random(3) != 1 && random(me->query("combat_exp")) < random(victim->query("combat_exp") / 3))
        message_vision(HIG "\n$n" HIG "对之置若罔闻，有条不紊的应战。\n\n" NOR, me, victim);
      switch (random(5)) {
        case 0:
          message_vision(HIB "$n" HIB "只觉耳痛欲裂，慌忙掩耳后退。\n" NOR, me, victim);
          victim->add("eff_sen", -(int)victim->query("max_sen") / 20);
          break;

        case 1:
          message_vision(HIB "一声巨响中，$n" HIB "身上的", me, victim);
          if (victim->query_temp("armor/armor")) {
            message_vision(victim->query_temp("armor/armor")->name() + HIB "给震得", me, victim);
            if (victim->query_temp("armor/armor")->query("no_get")) {
              message_vision("歪歪斜斜。\n" NOR, me, victim);
              victim->query_temp("armor/armor")->unequip();
            } else {
              message_vision("化作齑粉！\n" NOR, me, victim);
              destruct(victim->query_temp("armor/armor"));
            }
          } else if (victim->query_temp("weapon")) {
            message_vision(
              victim->query_temp("weapon")->name() + HIB "给劲气震得直接响！\n" NOR,
              me,
              victim
            );
            WEAPON_D->bash_weapon(me, victim, new(SDS_W("qi")), -2);
          } else {
            message_vision("内息一阵紊乱！" NOR, me, victim);
            victim->add("force", -victim->query("max_force") / 10);
          }
          break;

        default:
          COMBAT_D->do_attack(me, victim, new(SDS_W("qi")));
      }
    }
    return action_wolf[random(sizeof(action_wolf))];
  }
  //独角兽 邪武
  else if (id == "xie wu" || name == "邪武") {
    if (random(3) == 1) {
      message_vision(HIG "\n$N" HIG "战罢多时，疲态乍现，开始气喘吁吁，显是力不从心。\n" NOR, me, victim);
      if (random(3) == 1 || random(me->query("combat_exp")) > random(victim->query("combat_exp") / 3)) {
        message_vision(HIG "$n" HIG "见状大喜，连忙加紧攻击！\n" NOR, me, victim);
        COMBAT_D->do_attack(victim, me, victim->query_temp("weapon"));
        if (living(me)) {
          message_vision(HIG "哪知" HIG "$N" HIG "忽然攻势一变，全然无有败像！\n" NOR, me, victim);
          message_vision(HIG "$n" HIG "方知中计，后悔不已。\n" NOR, me, victim);
          message_vision(
            HIG "\n$N" HIG "大喝一声：“" HIC "獨角飛奔" NOR HIG "“，发出数道肉眼难以察觉的飞针！\n" NOR,
            me,
            victim
          );
          message_vision(HIR "$n" HIR "给扎得哭天抢地，号哭不已！\n" NOR, me, victim);
          victim->add("kee", -victim->query("eff_kee") / 2);
          victim->add("eff_kee", -victim->query("max_kee") / 10);
          SDS_D->addEffKee(me);
          SDS_D->addEffSen(me);
          SDS_D->addKee(me);
          SDS_D->addSen(me);
        }
      } else message_vision(HIC "$n" HIC "知道其中有诈，并不上当。\n" NOR, me, victim);
    }
    return action_dj[random(sizeof(action_dj))];
  }
  //幼獅座　蠻
  else if (id == "a man" || name == "蠻") {
    if (random(3) == 1) {
      message_vision(HIC "
$N" HIC "后退一步，浑身斗气横溢，忽然化作一只青面獠牙的狮子，张开血盆大口向
$n" HIC "咬去！\n" NOR, me, victim);
      if (random(3) == 1 || random(me->query("combat_exp")) > random(victim->query("combat_exp") / 3)) {
        message_vision(HIR "结果$n" HIR "给咬了个正着！\n\n" NOR, me, victim);
        victim->add("kee", -victim->query("eff_kee") / 20);
      } else message_vision(HIC "$n" HIC "连忙一侧身闪在一旁。\n" NOR, me, victim);
    }
    return action_ys[random(sizeof(action_ys))];
  }
  //大熊座 檄
  else if (id == "jiao" || name == "檄") {
    if (random(3) == 1) {
      message_vision(HIW "\n$N" HIW "使出角力之技，伸手抓向$n！" NOR, me, victim);
      if (random(2) != 1)
        message_vision(HIW "$n" HIW "侧身闪开。\n" NOR, me, victim);
      else {
        message_vision(HIW "$n" HIW "躲闪不及，给抓了个正着！\n" NOR, me, victim);
        message_vision(HIW "$n" HIW "连忙拼命挣脱。。。\n", me, victim);
        if (random(3) == 1 || random(me->query("combat_exp")) > random(victim->query("combat_exp") / 3)) {
          message_vision(HIR "$N" HIR "顺势运力，使出角力绝招：" HIM "大熊高掛" NOR HIR "！\n" NOR, me, victim);
          message_vision(RED "$n" RED "立时给勒得双眼翻白，口吐白沫！\n" NOR, me, victim);
          victim->add("eff_kee", -victim->query("max_kee") / 5);
        } else {
          message_vision(HIW "终于费九牛二虎之力，从$N" HIW "手中挣脱出来，累了一身的臭汗。\n" NOR, me, victim);
          victim->start_busy(random(5));
        }
      }
    }
    return action_dx[random(sizeof(action_dx))];
  }

  //水蛇 希拉
  else if (id == "xi la" || name == "希拉") {
    if (random(3)) {
      message_vision(HIR "\n$N" HIR "忽然从手中飞出一把飞爪，朝$n" HIR "抓去！\n" NOR, me, victim);
      if (random(3) != 1 && random(me->query("combat_exp")) < random(victim->query("combat_exp") / 3))
        random(2) ? message_vision(
          HIG "$n" HIR "连忙飞身闪开。\n" NOR,
          me,
          victim
        ) : message_vision(HIG "$n" HIR "将之击飞。\n" NOR, me, victim);
      else {
        message_vision(HIR "结果爪处猩红，带出了点点鲜血！\n" NOR, me, victim);
        if (random(2) == 1)
          victim->apply_condition("shake_poison", 100);
        victim->add("kee", victim->query("eff_kee") / 5);
      }
    }
    return action_ss[random(sizeof(action_ss))];
  }

  else {
    if (userp(me)) {
      switch (random(10)) {
        case 3: return action_phix[random(sizeof(action_phix))];
        case 4: return action_te[random(sizeof(action_te))];
        case 5: return action_tm[random(sizeof(action_tm))];
        case 6: return action_xn[random(sizeof(action_xn))];
        case 10: return action_tl[random(sizeof(action_tl))];
        default: return action_phix[random(sizeof(action_phix))];
      }
    } else return action_star[random(sizeof(action_star))];
  }
}

string perform_action_file(string func) {
  return CLASS_D("star") + "/shengdou/" + func;
}

string *parry_msg_phix = ({
  "$n展开双臂，驭风而行，闪开了$N的攻击。\n",
  "$n略一转身，一招「 凤凰展翅 」拍开$N的手。\n",
  "$n使出「 风中逍遥 」，双掌一划，引偏了$N的攻击。\n",
});

string *parry_msg_tm = ({
  "$n脚下急行，似碎星扑簌，闪开了$N的攻击。\n",
  "$n略一转身，一招「 星空流星 」撞开$N的手。\n",
  "$n使出「 星坠大地 」，双掌一划，引偏了$N的攻击。\n",
});

string *parry_msg_te = ({
  "$n展开双臂，驭风而行，闪开了$N的攻击。\n",
  "$n略一转身，一招「 白鸟展翅 」拍开$N的手。\n",
  "$n使出「 白鸟风卸 」，双掌一划，引偏了$N的攻击。\n",
});

string *parry_msg_xn = ({
  "$n舞动星云锁链，格开了$N的攻击。\n",
  "$n略一转身，锁链飞舞，将$N的攻击卸去一旁。\n",
  "$n波澜不惊，见招拆招，$N无功而返。\n",
});

string *parry_msg_tl = ({
  "$n长发飘动，潇洒的挡住$N的攻击。\n",
  "$n怒喝一声，击退$N的攻击。\n",
  "$n从容应战，见招拆招，$N无功而返。\n",
});

string *parry_msg_star = ({
  HIY "$n借助圣衣之力，卸去了$N的攻击。\n" NOR,
  HIY "$n略一转身，圣衣一道金光闪过，格开$N的手。\n" NOR,
});

string query_parry_msg(object weapon) {
  object me = this_player();
  switch (me->query("id")) {
    case "yi hui":
      return parry_msg_phix[random(sizeof(parry_msg_phix))];
    case "bing he":
      return parry_msg_te[random(sizeof(parry_msg_te))];
    case "a shun":
      return parry_msg_xn[random(sizeof(parry_msg_xn))];
    case "xing shi":
      return parry_msg_tm[random(sizeof(parry_msg_tm))];
    case "zi long":
      return parry_msg_tl[random(sizeof(parry_msg_tl))];
    default:
      return parry_msg_star[random(sizeof(parry_msg_star))];
  }
}

