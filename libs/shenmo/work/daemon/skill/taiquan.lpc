#include <ansi.h>
#include <sfighter_skill.h>
#include <sfighter_damage.h>
inherit SKILL;

mapping *action = ({
  ([ "action": "$N左拳猛的往$n脸上打去，正当$n闪身躲避之时，$N疾速迫近，右手一个反肘，往$n咽喉击去。",
    "force": 280,
    "dodge": -170,
    "lvl": 0,
    "weapon": "五根手指",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N左拳突然在$n眼前上围下钩，左旋右转，连变了七八般，蓦地里右手一挥，一记平肘往$n脸上砸去。",
    "force": 320,
    "dodge": -160,
    "lvl": 40,
    "weapon": "五根手指",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N二话不说，一记左引拳往$n眼鼻之间攻去。",
    "force": 480,
    "dodge": -150,
    "lvl": 80,
    "weapon": "五根手指",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "突然人影闪动，$N已飞身迫到$n身前，一招上擊拳往$n$l打去",
    "force": 500,
    "dodge": -180,
    "lvl": 120,
    "weapon": "五根手指",
    "damage_type": "瘀伤"
  ]),
  ([ "action": "只听$N一声清叱，旋身飞腿，一招旋身踢往$n$l硬攻过去。",
    "force": 600,
    "dodge": -200,
    "lvl": 160,
    "weapon": "五根手指",
    "damage_type": "瘀伤"
  ]),
});

int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }


int valid_learn(object me) {
  if ((me->query("class") != "saint" || me->query("family/family_name") != "格斗家") && !me->samsara_check(
    "taiquan",
    1
  ))
    return notify_fail("你非格斗家，自然学不得！\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练泰拳必须空手。\n");
  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力太弱，无法练泰拳。\n");
  return 1;
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((me->query("class") != "saint" || me->query("family/family_name") != "格斗家") && !me->samsara_check(
    "taiquan",
    1
  ))
    return notify_fail("你非格斗家，自然学不得！\n");
  if ((int)me->query("sen") < 50)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if ((int)me->query("kee") < 50)
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");
  if ((int)me->query("force") < 20)
    return notify_fail("你的内力不够练泰拳。\n");
  me->receive_damage("kee", 30);
  me->add("force", -10);
  return 1;
}
string perform_action_file(string func) {
  return CLASS_D("sfighter") + "/taiquan/" + func;
}
