// 两大神功之不死印法
#include <ansi.h>
inherit FORCE;

int valid_enable(string usage) {
  return usage == "force" || usage == "parry";
}

int valid_learn(object me) {
  if (me->query("busi_agree") == 0)
    return notify_fail("不死印法只能有缘者习之！\n");
  if (me->query_skill("changshengjue", 1) > 0)
    return notify_fail("正邪不两立，不死印法恐怕难以与长生诀一起修炼！\n");
  if (me->query("int") < 30)
    return notify_fail("你的先天悟性太低，难以领悟不死印法的精深奥妙！\n");
  if (me->query("shilian") < 1)
    return notify_fail("你武功低微，难以参透不死印法。\n");
  if (me->query_skill("busi-force", 1) >= 1200)
    return notify_fail("你的不死印法已经登峰造极，很难再靠潜心研究来进步了。\n");
  else return 1;
}

int practice_skill(object me) {
  return notify_fail("不死印法只能静心钻研，或是从运用(exert)中增加熟练度。\n");
}

string exert_function_file(string func) {
  return CLASS_D("forall") + "/busi-force/" + func;
}

string *parry_msg = ({
  "$n衣衫澎湃，内力汩汩，$N根本不可近身。\n",
  "$n长袖一甩，一股大力将$N送出丈外。\n",
  "$n施展出「不死印法」，轻描淡写的化解了$N的攻势。\n",
});

string query_parry_msg(object me, object weapon) {
  return parry_msg[random(sizeof(parry_msg))];
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  if (damage_bonus < 100)
    return 0;
  if (random(3 * (me->query_skill("busi-force", 1))) > (damage_bonus)
    && me->query_skill("busi-force", 1) > 299
    && (random(me->query_skill("busi-force", 1)) > victim->query_skill("changshengjue", 1)
      || victim->query_skill_mapped("force") != "changshengjue"
      || victim->query("chshjue_agree") == 0)) {
    victim->receive_wound("kee", damage_bonus, me);
    victim->receive_damage("kee", damage_bonus + random(damage_bonus), me);
    if (!me->query("env/no_msg") && !userp(victim))
      message_vision(HIB "$N" HIB "突感一股极强的内劲震透心脉，惊骇莫名之下，" HIR "一口鲜血" HIB "狂喷而出！\n" NOR, victim);
    return 1;
  } else return 0;
}

int stage(int level) {
  if (level < 100) return 1;
  else if (level < 200) return 2;
  else if (level < 300) return 3;
  else if (level < 400) return 4;
  else if (level < 500) return 5;
  else if (level < 600) return 6;
  else if (level < 700) return 7;
  else if (level < 800) return 8;
  else if (level < 900) return 9;
  else return 10;
}

string level_description(int level) {
  if (stage(level) < 2)
    return HIB "第" + chinese_number(stage(level)) + "重　" NOR;
  else if (stage(level) < 3)
    return HIB "第" + chinese_number(stage(level)) + "重　" NOR;
  else if (stage(level) < 4)
    return YEL "第" + chinese_number(stage(level)) + "重　" NOR;
  else if (stage(level) < 5)
    return YEL "第" + chinese_number(stage(level)) + "重　" NOR;
  else if (stage(level) < 6)
    return HIM "第" + chinese_number(stage(level)) + "重　" NOR;
  else if (stage(level) < 7)
    return HIM "第" + chinese_number(stage(level)) + "重　" NOR;
  else if (stage(level) < 8)
    return HIC "第" + chinese_number(stage(level)) + "重　" NOR;
  else if (stage(level) < 9)
    return HIC "第" + chinese_number(stage(level)) + "重　" NOR;
  else if (stage(level) < 10)
    return HIW "第" + chinese_number(stage(level)) + "重　" NOR;
  else
    return HIY "第" + chinese_number(stage(level)) + "重　" NOR;
}
