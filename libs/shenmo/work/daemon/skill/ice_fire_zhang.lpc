// ice_fire_zhang.c 玄冰烈焰掌
// /daemon/skill/ice_fire_zhang.c
// writted by mind 2001/2
#include <ansi.h>
inherit SKILL;

//攻击慢，命中低，伤害大
mapping *action = ({
  ([ "action": "$N一式" + HIC "「卷起千堆雪」" NOR + "，双掌大开大合，直向$n的$l击去",
    "dodge": 10,
    "parry": 10,
    "force": 170,
    "damage_type": "瘀伤",
    "weapon": "双掌",
  ]),
  ([ "action": "$N身形一变，一式" + HIC "「独钓寒江雪」" NOR + "，双掌似曲似直，拍向$n的$l",
    "dodge": 0,
    "parry": 20,
    "force": 150,
    "damage_type": "瘀伤",
    "weapon": "双掌",
  ]),
  ([ "action": "$N使一式" + HIC "「春雪缠绵入梦来」" NOR + "，左掌如微风拂面，右掌似细雨缠身，直取$n的$l",
    "dodge": 10,
    "parry": 30,
    "force": 170,
    "damage_type": "刺伤",
    "weapon": "右手掌",
  ]),
  ([ "action": "$N两掌一分，一式" + HIR "「九阳熔熔照沧海」" NOR + "，隐隐发出龙吟，向$n横击过去",
    "dodge": 10,
    "parry": 20,
    "force": 160,
    "damage_type": "砸伤",
    "weapon": "双掌",
  ]),
  ([ "action": "$N身形一转，使出一式" + HIR "「如日中天」" NOR + "，只见漫天掌影罩住了$n的全身",
    "dodge": 10,
    "parry": 30,
    "force": 170,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N突然身形一缓，使出一式" + HIR "「非枯非荣」" NOR + "，左掌凝重，右掌轻盈，击往$n的$l",
    "dodge": 10,
    "parry": 40,
    "force": 180,
    "damage_type": "刺伤",
    "weapon": "右手掌",
  ]),
  ([ "action": "$N使一式" + HIC "「风雪凭临江山娇」" NOR + "，双掌挟狂风暴雪之势，猛地劈向$n的$l",
    "dodge": 10,
    "parry": 10,
    "force": 100,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N一招" + HIC "「玄霜凝梅意阑珊」" NOR + "，双掌带着萧瑟的寒气，拍向$n的$l",
    "dodge": 60,
    "parry": 50,
    "force": 200,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N身法陡然一变，使出一式" + HIR "「凤凰涅磐」" NOR + "，掌影千变万幻，令$n无法躲闪",
    "dodge": 50,
    "parry": 60,
    "force": 250,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N清啸一声，左掌一式" + HIC "「冰魄刀」" NOR + "，右手招展" + HIR "「火焰刀」" NOR + "，两股截然不同的气劲击向$n的$l",
    "dodge": 60,
    "parry": 50,
    "force": 250,
    "damage_type": "瘀伤",
  ])
});

int valid_enable(string usage) {
  return usage == "unarmed" || usage == "parry";
}

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练玄冰烈焰掌必须空手。\n");

  if ((int)me->query("max_force") < 400)
    return notify_fail("你的内力太弱，无法练玄冰烈焰掌");
  if ((string)me->query_skill_mapped("force") != "butian-force" && !me->samsara_check("ice_fire_zhang"))
    return notify_fail("你的内功心法不对无法练习。\n");
  return 1;
}


mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if (me->query("class") != "xian" && !me->samsara_check("ice_fire_zhang"))
    return notify_fail("你非仙界之友。\n");
  if (me->query("family/family_name") != "三界散仙"
    && me->query_skill("ice_fire_zhang", 1) < 350 && !me->samsara_check("ice_fire_zhang"))
    return notify_fail("你的" + to_chinese("ice_fire_zhang") + "还不够火候。\n");
  if ((int)me->query("kee") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("force") < 40)
    return notify_fail("你的内力不够练玄冰烈焰掌。\n");
  me->receive_damage("kee", 30);
  me->add("force", -30);
  write(HIW "浑身忽青忽红，闪烁不停。\n" NOR);
  return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  if (damage_bonus < 50) return 0;

  if (random(damage_bonus / 2) > victim->query_str() / 10) {
    damage_bonus = damage_bonus / 10 + random(damage_bonus / 10);
    if (damage_bonus > 100) damage_bonus = 100;
    victim->receive_wound("kee", damage_bonus);
    switch (random(3)) {
      case 1: return HIR "运转内力，九阴九阳两道不同属性的劲力输入$n的体内，造成致命的伤害！\n" NOR;
      default: return HIY "$N劲力一吐，一道玄冰真气，一道烈焰真气，双双击中了$n的$l！\n" NOR;
    }
  }
}

string perform_action_file(string func) {
  return CLASS_D("sanxian") + "/aaaa/" + func;
}
