int valid_enable(string usage) { return usage=="unarmed" || usage=="parry"; }

int valid_learn(object me)
{
mapping shaolin;    
shaolin = me->query("门派/shaolin");

if ( !shaolin || !mapp(shaolin) || shaolin["duoluo-zhi"] )
        return notify_fail("你没有多罗叶指做根基,无法学习大力金刚指。\n");
if ( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
        return notify_fail("练大力金刚指法必须空手。\n");
if ( me->query_skill("yijinjing",1)<=850 )
        return notify_fail("你的易筋经功力不够，无法学习大力金刚指。\n");
if ( me->query_skill("unarmed",1)<=850 )
        return notify_fail("你的扑击格斗之技功力不够，无法学习大力金刚指。\n");
return 1;
}

int practice_skill(object me)
{
if ( me->query("kee")<500 )
        return notify_fail("你的体力太低了。\n");
if ( me->query("force")<500 )
        return notify_fail("你的内力不够练大力金刚指。\n");
if ( me->query_skill("unarmed",1)<=850 )
        return notify_fail("你的扑击格斗之技功力不够，无法练习大力金刚指。\n");
me->receive_damage("kee",200,me);
me->add("force", -100);
return 1;
}

string perform_action_file(string action)
{
return CLASS_D("shaolin") + "/jingang-zhi/" + action;
}

mapping query_action(object me, object weapon)
{
return action[random(sizeof(action))];
}

void skill_improved(object who)
{
mapping fam,shaolin;    
if ( !who ) 
        return;
//已有大力金刚指的自动del大力金刚指
if ( who->query_skill("qianye-shou",1) )
        {
        tell_object(who,"你的大力金刚指早已晋升为如来千叶手了。\n");
        who->delete_skill("jingang-zhi");
        who->reset_action();
        who->save();
        return;
        }
//非少林弟子只能850的大力金刚指
if ( who->query("family/family_name")!="少林寺"
  && who->query_skill("jingang-zhi",1)>=850 )
        {
        tell_object(who,"可惜你对大力金刚指的领悟还不够全面。\n");  
        tell_object(who,HIC"你的「大力金刚指」到了停滞不前的地步！\n");     
        who->set_skill("jingang-zhi",850);
        who->save();
        return;
        }       
fam = who->query("family");
shaolin = who->query("门派/shaolin");
if ( !fam || !mapp(fam)  
|| ( fam["family_name"]!="少林寺" 
  && ( (!shaolin || !mapp(shaolin)) ) ) )
        {
        tell_object(who,"你不是少林弟子,无法真正习得"+to_chinese("jingang-zhi")+"的精髓。\n");
        who->delete_skill("jingang-zhi");
        return;
        }
//没达到大力金刚指学习等级的
if ( !shaolin["duoluo-zhi"] )
        {
        tell_object(who,"你的多罗叶指基础不够,无法真正习得"+to_chinese("jingang-zhi")+"的精髓。\n");
        who->delete_skill("jingang-zhi");
        return;
        }
if ( who->query_skill("jingang-zhi",1)>850 )
        {
        tell_object(who,"你对大力金刚指的使用了如指掌。\n");
        tell_object(who,"你对大力金刚指的研究更进了一步。\n");
        tell_object(who,"你领悟了“不动金刚，千叶如来”的精髓。\n");
        tell_object(who,"你的大力金刚指晋升为如来千叶手了。\n");
        shaolin["jingang-zhi"]=1;
        who->delete_skill("jingang-zhi");
        if ( !who->query_skill("qianye-shou",1) )
                who->set_skill("qianye-shou",1);
        who->map_skill("unarmed","qianye-shou");
        who->map_skill("parry","qianye-shou");  
        who->reset_action();
        who->save();
        message("channel:rumor",HIM"【千里眼】某人：听说"+who->name()+HIM"的大力金刚指晋升为如来千叶手了。\n"NOR,users());
        }
return;
}

