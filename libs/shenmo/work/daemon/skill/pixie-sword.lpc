int valid_enable(string usage) {
  return usage == "sword" || usage == "dodge" || usage == "parry";
}

string query_parry_msg(object me, object weapon) {
  string msg;
  object my_weapon;

  if (!(my_weapon = me->query_temp("weapon"))) {
    if (!(my_weapon = me->query_temp("secondary_weapon")))
      return "";
  } else {
    if (!valid_enable(my_weapon->query("skill_type"))) {
      if (!(my_weapon = me->query_temp("secondary_weapon")))
        return "";
      else if (!valid_enable(my_weapon->query("skill_type")))
        return "";
    }
  }
  if (weapon)
    msg = weapon_vs_weapon_msg[random(sizeof(weapon_vs_weapon_msg))];
  else
    msg = unarmed_vs_weapon_msg[random(sizeof(unarmed_vs_weapon_msg))];
  msg = replace_string(msg, "$i", my_weapon->name());
  return msg;
}

mapping query_action(object me, object weapon) {
  int i;
  mapping *m_actions;
  m_actions = me->query("skill_pixie-sword");
  if (!me->query_temp("HTH_perform")) {
    if (me->query("skill_pixie-sword") == 0)
      return action[random(6)];
    if (random(2)) return action[random(6)];
    return m_actions[random(sizeof(m_actions))];
  } else return action[6];
  return action[random(sizeof(action))];

}

string query_dodge_msg(string limb, object me) {
  me->set_temp("fight/dodge", 5 * me->query_skill("pixie-sword", 1));
  return dodge_msg[random(sizeof(dodge_msg))];
}

int valid_learn(object me) {
  int ob;
  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力不够，没有办法练少林醉棍。\n");

  if (!(ob = me->query_temp("weapon"))
    || ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能练习辟邪剑法。\n");
  if ((int)me->query_skill("kuihua-shengong", 1) < 100)
    return notify_fail("你的葵花神功火候不够，无法学习辟邪剑法。\n");
  return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  if (damage_bonus < 110) return 0;
  if (me->query("force") < 50) return 0;
  if (random(10) < 2) return 0;

  //  第六等级的伤气
  if (me->query_skill("pixie-sword", 1) > 3000) {
    victim->receive_damage("max_kee", (damage_bonus) * 5, me);
    return WHT "$N的辟邪剑法已入返璞归真境界，随意一剑带出一阵剑气扑向$n！！！！！\n" NOR;
  }
  //  第五等级的伤气
  if (me->query_skill("pixie-sword", 1) > 2000) {
    victim->receive_damage("max_kee", (damage_bonus) * 3, me);
    return YEL "$N的辟邪剑法已入返璞归真境界，随意一剑带出一阵剑气扑向$n！！！！！\n" NOR;
  }
  if (damage_bonus < 100) return 0;

  //  第四等级的伤气
  if (me->query_skill("pixie-sword", 1) > 1000) {
    victim->receive_damage("max_kee", (damage_bonus) * 2, me);
    return MAG "$N的辟邪剑法已入返璞归真境界，随意一剑带出一阵剑气扑向$n！！！！！\n" NOR;
  }

  //  第三等级的伤气
  if (me->query_skill("pixie-sword", 1) > 500) {
    victim->receive_wound("max_kee", (damage_bonus - 100), me);
    return CYN "$N的辟邪剑法已入返璞归真境界，随意一剑带出一阵剑气扑向$n！！！！！\n" NOR;
  }
  // 第二等级的伤气
  if (me->query_skill("pixie-sword", 1) > 300) {
    victim->receive_wound("max_kee", (damage_bonus - 100) / 2, me);
    return RED "$N的辟邪剑法已初有小成,带出一小阵" HIR "剑气" HIW "扑向$n！！！！！\n" NOR;
  }
}

// 辟邪剑法的特殊攻击
void do_interlink(object me, object victim) {
  int skill, i, j;
  object *enemy;

  skill = me->query_skill("pixie-sword", 1);
  if (skill > 500) {
    enemy = me->query_enemy();
    if (!sizeof(enemy)) return;
    // 对所有敌人均自动进行攻击
    for (i = 0; i < sizeof(enemy); i++) {
      for (j = 0; j < (skill / (20 * sizeof(enemy))); j++)
        if ((me->is_fighting(enemy[i]) || enemy[i]->is_fighting(me)) && enemy[i]->query("qi") > 0) {
          if (environment(me) == environment(enemy[i])) {
            me->add_temp("str", skill / 10);
            me->add_temp("dex", skill / 10);
            COMBAT_D->do_attack(me, enemy[i], me->query_temp("weapon"), TYPE_REGULAR);
            COMBAT_D->do_attack(me, enemy[i], me->query_temp("weapon"), TYPE_REGULAR);
            COMBAT_D->do_attack(me, enemy[i], me->query_temp("weapon"), TYPE_REGULAR);
          }
        } else break;
    }
    me->delete_temp("str");
    me->delete_temp("dex");
  }
}
