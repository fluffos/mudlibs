//大力金刚指  低命中，高伤害
inherit SKILL;
#include <ansi.h>

mapping *action = ({
  ([ "action": "$N身体半蹲，右指中宫直进，一式「降龙伏虎」击向$n的前心",
    "force": 190,
    "parry": 10,
    "dodge": -5,
    "skill_name": "降龙伏虎",
    "damage_type": "刺伤",
    "weapon": "右指",
  ]),
  ([ "action": "$N轻轻一纵，居高临下，一式「普渡众生」，点向$n的周身大穴",
    "parry": 5,
    "dodge": 5,
    "force": 295,
    "lvl": 40,
    "skill_name": "普渡众生",
    "damage_type": "点穴",
  ]),
  ([ "action": "$N身形飘忽不定，一式「佛祖献花」，右指击向$n的面门",
    "force": 130,
    "parry": -25,
    "dodge": -15,
    "skill_name": "佛祖献花",
    "damage_type": "刺伤",
    "weapon": "右指",
  ]),
  ([ "action": "$N不动声色，突然一招「斩妖除魔」，左右双指分别指向$n的各大要穴",
    "force": 120,
    "parry": -15,
    "dodge": -10,
    "skill_name": "斩妖除魔",
    "damage_type": "刺伤",
    "weapon": "双指",
  ]),
  ([ "action": "$N摒指如刀，一招「五丁开山」，双指呈刀势从意想不到的角度劈向$n",
    "force": 180,
    "parry": 10,
    "dodge": -15,
    "damage": 160,
    "skill_name": "五丁开山",
    "damage_type": "割伤",
    "weapon": "指刀",
  ]),
  ([ "action": "$N盘膝端坐，一招「佛法无边」，右手拇指弹出一道劲风，击向$n",
    "force": 185,
    "parry": 0,
    "dodge": 0,
    "damage": 230,
    "skill_name": "佛法无边",
    "damage_type": "点穴",
  ]),
  ([ "action": "$N纵身而上，一招「金刚伏魔」，双手食指端部各射出一道青气击向$n",
    "force": 180,
    "parry": 0,
    "dodge": -5,
    "skill_name": "金刚伏魔",
    "damage_type": "点穴"
  ]),
  ([ "action": "$N脸上忽现祥和之气，一招「无色无相」，一指遥遥指向$n，似乎毫无劲力",
    "parry": 5,
    "dodge": 5,
    "damage": 295,
    "skill_name": "无色无相",
    "damage_type": "点穴"
  ]),
});

int valid_enable(string usage) { return usage == "unarmed"; }

int valid_learn(object me) {
  int i, f;

  i = 0;
  if (me->query_skill("bore-zhang")) i += 1;
  if (me->query_skill("suixing-tui")) i += 1;
  if (me->query_skill("damo-jian")) i += 1;
  if (me->query_skill("cibei-dao")) i += 1;
  if (me->query_skill("longzhua-gong")) i += 1;
  if (me->query_skill("zui-gun")) i += 1;

  f = 1;
  if ((int)me->query_skill("chanzong", 1) > 1499) f = 6;
  else if ((int)me->query_skill("chanzong", 1) > 1249) f = 5;
  else if ((int)me->query_skill("chanzong", 1) > 999) f = 4;
  else if ((int)me->query_skill("chanzong", 1) > 749) f = 3;
  else if ((int)me->query_skill("chanzong", 1) > 499) f = 2;
  else if ((int)me->query_skill("chanzong", 1) > 249) f = 1;
  else f = 0;

  if (f < i && !me->samsara_check("jingang-zhi"))
    return notify_fail("你必须参悟更深的禅宗佛法才能研习更多的少林武技。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练习大力金刚指必须空手。\n");
  if ((int)me->query_skill("yijinjing", 1) < 200 && !me->samsara_check("jingang-zhi"))
    return notify_fail("你的易筋经神功火候不够，无法学习大力金刚指。\n");
  if ((int)me->query("max_force") < 500)
    return notify_fail("你的内力太弱，无法练习大力金刚指。\n");
  if (me->query("family/family_name") != "少林寺"
    && me->query_skill("jingang-zhi", 1) < 350 && !me->samsara_check("jingang-zhi"))
    return notify_fail("你的大力金刚指尚未到独创一家的地步。\n");

  return 1;
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if (me->query("class") != "human" && !me->samsara_check("jingang-zhi"))
    return notify_fail("你非我人族，不能练习大力金刚指。\n");

  if ((int)me->query("kee") < 50
    || (int)me->query("force") < 10)
    return notify_fail("你的内力或气不够，没有办法练习大力金刚指。\n");

  me->receive_damage("kee", 50);
  me->add("force", -10);
  write("你按着所学练了一遍大力金刚指。\n");
  return 1;
}

string perform_action_file(string func) {
  return CLASS_D("shaolin") + "/jingang-zhi/" + func;
}
