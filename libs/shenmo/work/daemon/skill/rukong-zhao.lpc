#include <ansi.h>
#include <sfighter_skill.h>
#include <sfighter_damage.h>
inherit SKILL;

mapping *action = ({
  ([ "action": "$N双手微张，十根尖尖的指甲映出灰白光芒，突然翻腕出爪，五指猛地插落",
    "force": 280,
    "dodge": -170,
    "lvl": 0,
    "weapon": "五根手指",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N左手突然在$n眼前上围下钩，左旋右转，连变了七八般，蓦地里右手一伸，五根手指直插$n$l",
    "force": 320,
    "dodge": -160,
    "lvl": 40,
    "weapon": "五根手指",
    "damage_type": "刺伤"
  ]),
  ([ "action": "但听「喀喇」一响，$N的手臂斗然长了半尺，一掌按向$n$l，五指即要插进",
    "force": 480,
    "dodge": -150,
    "lvl": 80,
    "weapon": "五根手指",
    "damage_type": "刺伤"
  ]),
  ([ "action": "突然人影闪动，$N已飞身迫到$n身后，探手出袖，五指伸张，疾向$n$l插去",
    "force": 500,
    "dodge": -180,
    "lvl": 120,
    "weapon": "五根手指",
    "damage_type": "刺伤"
  ]),
  ([ "action": "只听$N一声清叱，左手径向$n$l抓去，跟着手肘撞向$n胸口穴道，右手箕张，五指竟已虚抓在$n咽喉",
    "force": 600,
    "dodge": -200,
    "lvl": 160,
    "weapon": "五根手指",
    "damage_type": "刺伤"
  ]),
});

int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }


int valid_learn(object me) {
  if ((me->query("class") != "saint" || me->query("family/family_name") != "格斗家") && !me->samsara_check(
    "rukong-zhao",
    1
  ))
    return notify_fail("你非格斗家，自然学不得！\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练入空爪必须空手。\n");
  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力太弱，无法练入空爪。\n");
  return 1;
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((me->query("class") != "saint" || me->query("family/family_name") != "格斗家") && !me->samsara_check(
    "rukong-zhao",
    1
  ))
    return notify_fail("你非格斗家，自然学不得！\n");
  if ((int)me->query("sen") < 50)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if ((int)me->query("kee") < 50)
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");
  if ((int)me->query("force") < 20)
    return notify_fail("你的内力不够练入空爪。\n");
  me->receive_damage("kee", 30);
  me->add("force", -10);
  return 1;
}
string perform_action_file(string func) {
  return CLASS_D("sfighter") + "/rukong-zhao/" + func;
}
