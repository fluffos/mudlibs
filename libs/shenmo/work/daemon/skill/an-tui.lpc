//72腿
//大力金刚腿->扫叶腿->连环腿->怀心腿->绝命腿->七十二暗腿
inherit SKILL;
#include <ansi.h>

void post_antui(object me, object victim, object weapon, int damage) {
  int ap, dp;
  if (!me || !victim)
    return;
  if (victim == me->query_temp("hit_on_antui")) {
    me->add_temp("antui_checker", 1);
    if (me->query_temp("antui_checker") > 5) {
      me->delete_temp("hit_on_antui");
      me->delete_temp("antui_checker");
    }
    return;
  }
  me->set_temp("hit_on_antui", victim);
  if (!me->is_fighting(victim) || !living(victim)) {
    victim->delete_temp("hit_by_antui");
    me->delete_temp("hit_on_antui");
    return;
  }
  ap = COMBAT_D->skill_power(me, "unarmed");
  dp = COMBAT_D->skill_power(victim, "parry") / 2;
  dp += COMBAT_D->skill_power(victim, "dodge") / 2;
  if (random(ap + dp) > dp) {
    message_vision(CYN "\n$N" CYN "踢出一招之后,不等$n" CYN "有喘息机会,紧跟着又是一腿!" NOR, me, victim);
    if (COMBAT_D->do_attack(me, victim, me->query_temp("weapon")) > 0) {
      message_vision(CYN "\n$N" CYN "一招得手之后,不等$n" CYN "有喘息机会,紧跟着又是一腿!" NOR, me, victim);
      if (COMBAT_D->do_attack(me, victim, me->query_temp("weapon")) <= 0) {
        message_vision(CYN "\n$N" CYN "见$n" CYN "闪过此招,趁$n" CYN "心神松懈之际,紧跟着又是一腿!" NOR, me, victim);
        COMBAT_D->do_attack(me, victim, me->query_temp("weapon"));
      }
    }
  }
  return;
}

mapping *action = ({
  ([ "action":
    "$N双腿连环踢出，攻向$n$l",
    "dodge": 5,
    "parry": 5,
    "damage": 255,
    "damage_type": "瘀伤",
    "post_action": (: post_antui :),
  ]),
});

int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int valid_learn(object me) {
  mapping shaolin;
  if (me->query_temp("weapon")
    || me->query_temp("secondary_weapon"))
    return notify_fail("练七十二暗腿必须空手。\n");
  shaolin = me->query("门派/shaolin");
  return 1;
}

int practice_skill(object me) {
  if (me->query("class") != "human")
    return notify_fail("非尘世之人如何参得？\n");
  if (me->query("sen") < 500)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if (me->query("kee") < 500)
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");
  if (me->query("force") < 800)
    return notify_fail("你的内力不够了。\n");
  me->receive_damage("kee", 300, me);
  me->receive_damage("sen", 300, me);
  me->add("force", -500);
  return 1;
}

string perform_action_file(string func) {
  return CLASS_D("shaolin") + "/an-tui/" + func;
}

string *parry_msg = ({
  "$n双腿连环踢出，将$N的$w的攻势踢的七零八落,不成章法。\n",
});

string *unarmed_parry_msg = ({
  "$n双腿连环踢出，将$N的攻势踢的七零八落,不成章法。\n",
});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}
