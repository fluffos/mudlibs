//海神拳

#include <ansi.h>
inherit SKILL;

mapping *action = ({
  ([ "action": HBBLU "$N身子微挫，暗喝一声，一招「万川激流」，腰马运力，一拳直捅$n的$l" NOR,
    "force": 70,
    "dodge": -10,
    "parry": 10,
    "skill_name": "万川激流",
    "damage_type": "瘀伤"
  ]),
  ([ "action": HBBLU "$N“哈哈”一笑，左拳由下至上，右拳平平击出，一招「子母看海」，交替打向$n" NOR,
    "force": 100,
    "dodge": -5,
    "parry": 5,
    "skill_name": "子母看海",
    "damage_type": "瘀伤"
  ]),
  ([ "action": HBBLU "$N对$n一声大喝，使一招「双叠浪」，左拳击出，随即右拳跟上，两重力道打向$n的$l" NOR,
    "force": 50,
    "dodge": -10,
    "parry": 10,
    "skill_name": "双叠浪",
    "damage_type": "震伤"
  ]),
  ([ "action": HBBLU "$N闷喝一声，双拳向上分开，一记「波涛汹涌」，拳划弧线，左右同时击向$n的$l" NOR,
    "force": 60,
    "dodge": -0,
    "parry": 10,
    "skill_name": "波涛汹涌",
    "damage_type": "内伤"
  ]),
  ([ "action": HBBLU "$N施出「冲天浪」，一声大吼，一拳凌空打出，拳风直逼$n的$l" NOR,
    "force": 90,
    "dodge": 0,
    "parry": 5,
    "skill_name": "冲天浪",
    "damage_type": "撞伤"
  ]),
  ([ "action": HBBLU "$N一声长啸，双拳交错击出，一招「巨淘骇浪」，拳风密布$n的前后左右" NOR,
    "force": 100,
    "dodge": 10,
    "parry": 10,
    "skill_name": "巨淘骇浪",
    "damage_type": "内伤"
  ]),
  ([ "action": HBBLU "$N怒吼一声，凌空飞起，一式「海天一体」，双拳居高临下，齐齐捶向$n" NOR,
    "force": 80,
    "dodge": 20,
    "parry": -10,
    "skill_name": "海天一体",
    "damage_type": "内伤"
  ]),
  ([ "action": HBBLU "$N仰天大笑，势若疯狂，衣袍飞舞，一招「怒海吞噬」，拳风凌厉，如雨点般向$n打去" NOR,
    "force": 80,
    "dodge": -5,
    "parry": -10,
    "skill_name": "怒海吞噬",
    "damage_type": "内伤"
  ])
});

int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int valid_effect(object me, object weapon, string name, int skill) {}

string perform_action_file(string action) {
  return "/daemon/class/star/sea/haishen-quan/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  object weapon = me->query_temp("weapon");
  string msg;

  if ((damage_bonus > 350) && (userp(me)))
    return 0;

  if (me->query("force") < 200)
    return 0;

  if (damage_bonus < 250) damage_bonus = 250;

  if (((int)me->query_skill("unarmed", 1) / 2) > random((int)victim->query_skill("force", 1))) {
    victim->receive_wound("kee", (450 - damage_bonus));
    msg = HBBLU "$N猛催小宇宙，拳风中隐隐带着浪啸之声！\n" NOR;
    message_vision(msg, me, victim);
  }
  switch (random(3)) {
    case 0:
      {
        victim->receive_damage("kee", damage_bonus / 3 * 2);
        msg = HBBLU "$n一个不察，已被浪花溅了一身，狼狈不堪！\n" NOR;
        break;
      }

    case 1:
      {
        msg = HBBLU "$N一声长啸，$n一不留神，骇的目瞪口呆！\n" NOR;
        COMBAT_D->report_status(victim);
        break;
      }

    case 2:
      {
        msg = HBBLU "$N嘿嘿一笑，默运海王之手，$n突然觉得体内真气不受控制的外泄而出！\n" NOR;
        if (victim->query("force") >= damage_bonus * 5) {
          victim->add("force", -damage_bonus * 5);
          me->add("force", damage_bonus * random(5));
        } else {
          victim->set("force", 0);
          me->add("force", damage_bonus * random(3));
        }
        break;
      }
  }
  message_vision(msg, me, victim);
  return 0;
}
