// Zongheng-sword.c 纵横剑法
// Cracked by 凌惊雪 5-4-2003

#include <ansi.h>
inherit SKILL;

mapping *action = ({
  ([ "name": "纵横",
    "action": "$N手中$w正正刺向$n，正是纵横剑法的起手式，" + HIG "「纵横」" NOR + "。",
    "dodge": -10,
    "parry": -10,
    "damage": 150,
    "force": 150,
    "damage_type": "刺伤"
  ]),
  ([ "name": "风云天下",
    "action": "$N手中$w突然间剑光一吐，化作一道白虹，气势大开大阂，正是纵横剑法的精要所在，一招" + HIG "「风云天下」" NOR + "向$n$l直刺过来",
    "dodge": -15,
    "parry": -15,
    "damage": 155,
    "force": 160,
    "damage_type": "刺伤"
  ]),
  ([ "name": "日月同辉",
    "action": "$N使出纵横剑法中的" + HIG "「日月同辉」" NOR + "，不慌不忙，$N横手一提，又拿住剑柄，剑光一盎，又罩向$n",
    "dodge": -20,
    "parry": -20,
    "damage": 160,
    "force": 170,
    "damage_type": "刺伤"
  ]),
  ([ "name": "横扫六合",
    "action": "$N只觉真似天河一般壮丽的气势，使出纵横剑法中的" + HIG "「横扫六合」" NOR + "，攻向$n",
    "dodge": -20,
    "parry": -20,
    "damage": 170,
    "force": 180,
    "damage_type": "刺伤"
  ]),
  ([ "name": "纵横四海",
    "action": "$n感觉到剑势,铺天盖地的涌压而来，正是纵横剑法中的" + HIG "「纵横四海」" NOR + "",
    "dodge": -25,
    "parry": -25,
    "damage": 180,
    "force": 190,
    "damage_type": "刺伤"
  ]),
  ([ "name": "纵字诀",
    "action": HIR "$N身形突然向外直飞，陡然间剑光一吐，纵横剑法之" + HIG "「纵字诀」" HIR + "已如闪电惊虹般刺出，\n$N手中$w" HIR "化成一道血光，气壮雄浑，一股无匹的力量直向$n" HIR "$l直刺过来。" NOR,
    "dodge": -50,
    "parry": -50,
    "damage": 500,
    "force": 500,
    "damage_type": "刺伤"
  ]),
  ([ "name": "横字诀",
    "action": HIR "$N剑意若有若无，手中$w" HIR "突然消失，剑光一盎，$w" HIR "缓缓划出，剑气如浪，此招正是纵横剑法之" + HIG "「横字诀」" HIR + "，\n白茫茫一片光芒随着$N横划的$w" HIR "澎湃涌出，犹如海天一线，无懈可击，直逼$n" HIR "。" NOR,
    "dodge": -50,
    "parry": -50,
    "damage": 500,
    "force": 500,
    "damage_type": "刺伤"
  ]),
});

int valid_learn(object me) {
  object ob;

  if ((int)me->query("max_force") < 2000) {
    return notify_fail("你的内力不够，没有办法练纵横剑法。\n");
  }

  if ((string)me->query_skill_mapped("force") != "baihua-force") {
    return notify_fail("纵横剑法必须配合花开四季心法才能练。\n");
  }

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword") {
    return notify_fail("你必须先找一把剑才能练剑法。\n");
  }

  return 1;
}

int valid_enable(string usage) {
  return "sword" == usage || "parry" == usage;
}

mapping query_action(object me, object weapon) {
  int i = me->query_temp("zongheng_pfm");

  if (!i) {
    return action[random(sizeof(action) - 2)];
  } else {
    if (i > sizeof(action)) {
      i = sizeof(action);
    }
    return action[i - 1];
  }
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword") {
    return notify_fail("你使用的武器不对。\n");
  }

  if ((int)me->query("kee") < 100) {
    return notify_fail("你的体力不够练「纵横剑法」。\n");
  }

  if ((int)me->query("force") < 50) {
    return notify_fail("你的内力不够练「纵横剑法」。\n");
  }

  me->receive_damage("kee", 30);
  me->add("force", -30);
  return 1;
}

string perform_action_file(string func) {
  return CLASS_D("baihuagu") + "/zongheng-sword/" + func;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  string msg;

  if (damage_bonus < 200) {
    return 0;
  }

  if (random(damage_bonus / 2) > random(victim->query_str() / 2)) {
    if (me->query_skill("zongheng-sword", 1) > 1600 && random(10) > 8) {
      victim->receive_damage("kee", (damage_bonus * 2), me);
      msg = HIY "$N纵横剑法已到最高等级，一剑攻出，剑气横飞，时若游龙穿空，时若惊鸿渡云扑向$n！！！！！\n" NOR;
      message_vision(msg, me, victim);
    } else  //  第五等级的伤气
    if (me->query_skill("zongheng-sword", 1) > 1500 && random(10) > 8) {
      victim->receive_damage("kee", damage_bonus, me);
      msg = HIC "$N的纵横剑法已到第五等级，一剑随意挥出，如生了眼睛一般扑向$n！！！！！\n" NOR;
      message_vision(msg, me, victim);
    } else  //  第四等级的伤气
    if (me->query_skill("zongheng-sword", 1) > 1400 && random(10) > 8) {
      victim->receive_damage("kee", (damage_bonus) * 2 / 3, me);
      msg = MAG "$N的纵横剑法已到第四等级，随意一剑带出九十阵剑气扑向$n！！！！！\n" NOR;
      message_vision(msg, me, victim);
    } else  //  第三等级的伤气
    if (me->query_skill("zongheng-sword", 1) > 1300 && random(10) > 8) {
      victim->receive_damage("kee", (damage_bonus) / 2, me);
      msg = CYN "$N的纵横剑法已入返璞归真境界，随意一剑带出九阵剑气扑向$n！！！！！\n" NOR;
      message_vision(msg, me, victim);
    } else  // 第二等级的伤气
    if (me->query_skill("zongheng-sword", 1) > 1200 && random(10) > 8) {
      victim->receive_damage("kee", (damage_bonus) / 3, me);
      msg = HIR "$N的纵横剑法已初有小成，带出九缕剑气扑向$n！！！！！\n" NOR;
      message_vision(msg, me, victim);
    } else if (me->query_skill("zongheng-sword", 1) > 1000 && random(10) > 8) {
      victim->receive_damage("kee", (damage_bonus) / 4, me);
      msg = RED "$N的纵横剑法已初有领悟，带出三缕剑气扑向$n！！！！！\n" NOR;
      message_vision(msg, me, victim);
    }
  }

  switch (random(3)) {
    case 0:
      victim->receive_damage("kee", damage_bonus / 15, me);
      msg = HIG "$n一个不查，被$N的神剑重重地击中腿部！\n" NOR;
      break;

    case 1:
      victim->receive_damage("sen", damage_bonus / 13, me);
      msg = HIM "漫天剑气中，$n突然被刺中头部,不禁尖声嚎叫!\n" NOR;
      break;


    case 2:
    default:
      victim->receive_damage("kee", damage_bonus / 15, me);
      victim->receive_damage("sen", damage_bonus / 15, me);
      msg = HIR "剑气中突现无数鞭影，$n顿时被剑气鞭影攻击的体无完肤！\n" NOR;
      break;
  }

  message_vision(msg, me, victim);

  return 0;
}
