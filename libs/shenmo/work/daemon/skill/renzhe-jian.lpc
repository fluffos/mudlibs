  "$N身形稍退，使出一招",
  "$N不闪不避，一式",
  "$N使出",
  "$N暗自一笑，一式",
  "$N一个急转，使出",
});
string *skill_tail = ({
  "，手中$w化为一道疾光刺向$n的$l。",
  "，手中$w化为一道金光罩向$n。",
  "，手中$w不偏一歪，直刺$n的$l。",
  "，手中$w如飞，发出点点寒光。",
});

void post_anqi(object, object, object, int);

mapping *action = ({
  ([ "action":
    "$N提身纵气，轻手轻脚，手中$w毫无声息的刺向$n$l",
    "dodge": -5,
    "parry": -10,
    "damage": 10,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "只见$N将$w一摆，使了个虚式，脚下暗暗运劲，踢向$n的$l",
    "dodge": -35,
    "parry": -5,
    "damage": 20,
    "damage_type": "淤伤"
  ]),
  ([ "action":
    "$N嘿嘿一笑，一式「暗弑无影千万众」幻出无数幻影，$n只觉四面人
影袭来，却不知该如何闪躲",
    "dodge": -10,
    "parry": -15,
    "damage": 15,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N手中$w轻轻一抖，一式「生死之间敌我灭」舞出道道寒光，
空门大开，舍命罩向$n",
    "dodge": -30,
    "parry": -5,
    "damage": 15,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N将$w一摆，抽身后退，$n不知有诈，贴身跟来，不想$N左手一甩
，“看暗器！”，说罢$w也随之直刺$p$l",
    "dodge": -20,
    "parry": -20,
    "damage": 15,
    "weapon": "袖里剑",
    "damage_type": "刺伤",
    "post_action": (: post_anqi :)
  ]),
});

int valid_learn(object me) {
  object ob;

  if ((int)me->query("max_force") < 50)
    return notify_fail("你的内力不够，没有办法练忍者剑术法。\n");

  if ((string)me->query_skill_mapped("spells") != "renshu")
    return notify_fail("你不会忍术，学习忍者剑也是枉然。\n");

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能练剑法。\n");

  if (me->query("class") != "human")
    return notify_fail("这可是人间界的奇术。\n");

  if (me->query_skill("renzhe-jian", 1) < 250
    && me->query("family/master_name") != "服部半藏")
    return notify_fail("你的忍者剑修为不够，光练是没用的。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry" || usage == "throwing";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if (me->query_skill("renzhe-jian", 1) < 250
    && me->query("family/master_name") != "服部半藏")
    return notify_fail("你的忍者剑修为不够，光练是没用的。\n");

  if (me->query("class") != "human")
    return notify_fail("这可是人间界的奇术。\n");

  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 3)
    return notify_fail("你的内力或气不够，没有办法练习剑法。\n");

  me->receive_damage("kee", 30);
  me->add("force", -3);
  write("你按著所学练了一遍忍者剑术。\n");
  return 1;
}

string perform_action_file(string func) {
  return CLASS_D("human") + "/renzhe-jian/" + func;
}

void skill_improved(object me) {
  int m_skill = me->query_skill("renzhe-jian", 1);

  if (m_skill > 200 && m_skill % 10 == 0) {
    tell_object(me, HIB "你对忍者剑术的领悟加深了，你的忍者剑术进入了一个新的境界！\n" NOR);
    if (me->query("zichuang/times") > 10) {
      tell_object(me, HIB "然而你的功夫已经练至顶峰，不能再创出新招了。\n" NOR);
      return;
    }
    if (random(me->query("kar")) < 20) {
      tell_object(me, HIB "然而你的心中居然产生了一种失落感！\n" NOR);
      return;
    }
    if ((random(me->query("int") / 2) + (int)me->query_skill("literate") / 50) < 10) {
      tell_object(me, HIB "然而你的心中升起一种惆怅的感觉，仿佛有一丝重要的东西没有抓住。\n" NOR);
      return;
    }
    tell_object(me, HIB "你突然福至心灵，对忍者剑术领悟出了一招新的用法！\n" NOR);
    tell_object(me, "请为这招取一个名字：");
    input_to((: call_other, __FILE__, "name_skill", me :));
  }
  return;
}

void name_skill(object me, string arg) {
  string *banned_name = ({
    "你", "你", "我", "他", "她", "它", "爸", "妈",
    "爷", "奶", "巫师", "天神", "神仙",
  });
  mapping *m_actions;
  mapping m_act = ([]);
  int content, i = strlen(arg);
  string msg;

  m_actions = me->query("skill_renzhe-jian");
  if (!pointerp(m_actions))
    m_actions = ({});

  content = me->query("int") + 2 * me->query_skill("renshu", 1) / 10;
  m_act += ([ "damage": content ]);
  content = -me->query("spi");
  m_act += ([ "dodge": content ]);
  content = -me->query("cps");
  m_act += ([ "parry": content ]);
  content = me->query("con") + me->query_skill(
    "force",
    1
  ) / 20 + random(me->query_skill("force", 1) / 20);
  m_act += ([ "force": content ]);
  m_act += ([ "damage_type": "刺伤" ]);
  if (!arg || arg == "") {
    tell_object(me, "请为你的新招式取一个名字：");
    input_to((: call_other, __FILE__, "name_skill", me :));
    return;
  } else while (i--) {
    if (arg[i] <= ' ') {
      tell_object(me, "招式名字不能使用控制字元，请重新设定一个名字：");
      input_to((: call_other, __FILE__, "name_skill", me :));
      return;
    }
    if (strsrch(arg, "　") >= 0) {
      tell_object(me, "招式名字不能有空格，请重新设定一个名字：");
      input_to((: call_other, __FILE__, "name_skill", me :));
      return;
    }
    if (i % 2 == 0 && !is_chinese(arg[i..<0])) {
      tell_object(me, "请您用「中文」为你的新招式取名字：");
      input_to((: call_other, __FILE__, "name_skill", me :));
      return;
    }
  }

  if (member_array(arg, banned_name) != -1) {
    tell_object(me, "对不起，这种名字会造成其他人的困扰。请重新设定一个名字：");
    input_to((: call_other, __FILE__, "name_skill", me :));
    return;
  }

  if ((strlen(arg) < 4) || (strlen(arg) > 16)) {
    tell_object(me, "对不起，招式名字必须是 ２ 到 ８ 个中文字：");
    input_to((: call_other, __FILE__, "name_skill", me :));
    return;
  }

  m_act += ([ "name": arg ]);
  msg = skill_head[random(sizeof(skill_head))] + HIB "「" + arg + "」" NOR + skill_tail[random(sizeof(skill_tail))];
  m_act += ([ "action": msg ]);
  m_actions += ({ m_act });
  me->set("skill_renzhe-jian", m_actions);
  me->add("zichuang/times", 1);
}

void post_anqi(object me, object victim, object weapon, int damage) {
  int i, a_damage;
  object anqi, *inv;
  string msg, limb, *limbs;
  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->query("name") == "袖里剑"
      && inv[i]->query("type") == "暗器") {
      anqi = inv[i];
      break;
    }
  }
  if (!anqi || !objectp(anqi)) {
    message_vision("结果什么反应也没有，$N讪讪一笑。\n" NOR, me);
    tell_object(me, "你的" HIR "袖里剑" NOR "不够了。\n");
  } else {
    anqi->add_amount(-1);
    if (anqi->query_amount() <= 0)
      destruct(anqi);
    if (damage <= 0) {
      message_vision("袖里剑被$n一格，“啪”的一声，斜斜插在地上。\n", me, victim);
      anqi = new("/d/swordman/obj/anqi");
      anqi->set_amount(1);
      anqi->move(environment(me));
    } else {
      if (intp(anqi->query("base_damage"))) a_damage = anqi->query("base_damage");
      else a_damage = 10;
      a_damage = a_damage / 2 + random(a_damage / 2);
      msg = "$w笔直朝着$n$l直射而去，$n避无可避，给刺了正着，立刻鲜血淋漓！\n";
      limbs = victim->query("limbs");
      limb = limbs[random(sizeof(limbs))];
      msg = replace_string(msg, "$l", limb);
      msg = replace_string(msg, "$w", anqi->name());
      message_vision(msg, me, victim);
      victim->receive_wound("kee", a_damage);
      COMBAT_D->report_status(victim, a_damage);
    }
  }
}
