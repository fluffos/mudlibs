//【绕指柔红】raozhi.c
#include <ansi.h>

inherit SKILL;

mapping *action = ({
  ([ "action":
    "$N低吟一声，十指上下穿飞，一招" + BLINK "" + HIG "「千里姻缘巧安排」" NOR "，双指直取$n的$l",
    "dodge": -10,
    "parry": -10,
    "force": 250,
    "damage_type": "刺伤",
    "weapon": "右手五指",
  ]),
  ([ "action":
    "$N十指互错，虚虚实实，一招" + BLINK "" + HIM "「相识一笑西湖畔」" NOR "，前后左右，瞬息间向$n刺出了六招",
    "dodge": -20,
    "parry": -20,
    "force": 250,
    "damage_type": "刺伤",
    "weapon": "右手五指",
  ]),
  ([ "action":
    "$N左掌竖立胸前，一式" + BLINK "" + HIR "「人间相思不曾闲」" NOR "，右手食指扣住拇指，对着$n轻轻指去",
    "dodge": 10,
    "parry": -20,
    "force": 300,
    "damage_type": "刺伤",
    "weapon": "右手五指",
  ]),
  ([ "action":
    "$N双掌化指，指中带掌，双手齐推，一招" + BLINK "" + HIW "「为谁独自倚楼台」" NOR "，暗蕴内力，直扑$n$l",
    "dodge": -10,
    "parry": -20,
    "force": 220,
    "damage_type": "刺伤",
    "weapon": "右手五指",
  ]),
  ([ "action":
    "$N一招" + BLINK "" + HIC "「颠颠倒倒将心织」" NOR "，右手一拳击出，左掌化指，一掌一指凌空飘向$n的$l",
    "dodge": 10,
    "parry": -10,
    "force": 200,
    "damage_type": "刺伤",
    "weapon": "右手五指",
  ]),
  ([ "action":
    "$N突然身行急转，一招" + BLINK "" + HIY "「却问何日君再来」" NOR "，十指纷飞，霎时之间将$n四面八方都裹住了",
    "dodge": 0,
    "parry": -20,
    "force": 250,
    "damage_type": "内伤",
    "weapon": "右手五指",
  ]),
  ([ "action":
    "$N一式" + BLINK "" + HIC "「曲终回收低顾盼」" NOR "，并指如刃，一束束锐利无俦的刀气，凌虚向$n的$l切去",
    "dodge": 10,
    "parry": -30,
    "force": 180,
    "damage_type": "刺伤",
    "weapon": "右手五指",
  ]),
  ([ "action":
    "忽听嗤嗤几声轻响，一股柔和的指劲自$N手心涌出，正是一招" + BLINK "" + HIB "「焉知情爱几多愁」" NOR "，缓缓点向$n$l",
    "dodge": 10,
    "parry": -30,
    "force": 180,
    "damage_type": "刺伤",
    "weapon": "右手五指",
  ]),

});

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("绕指柔红须空手练习。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query_skill("unarmed", 1) < (int)me->query_skill("raozhirouhong", 1) / 2)
    return notify_fail("你的扑击格斗还不够精湛，无法领会更深层的指劲！\n");

  if ((int)me->query("sen") < 50)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");

  if ((int)me->query("kee") < 50)
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");

  if ((int)me->query("force") < 20)
    return notify_fail("你的内力不够了。\n");

  me->receive_damage("kee", 30);
  me->add("force", -20);

  return 1;
}

string perform_action_file(string func) {
  return CLASS_D("qishituan") + "/raozhirouhong/" + func;
}
