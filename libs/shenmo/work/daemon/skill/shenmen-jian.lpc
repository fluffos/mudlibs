
#include <ansi.h>
inherit SKILL;

mapping *action = ({
([      "action" : "$N身形斜飞，手中$w轻轻点向$n的腕部",
        "dodge"  : -80,
        "parry"  : -70,
        "damage" : 5,
        "damage_type" : "刺伤"
]),
([      "action" : "$N长跃而起，$w猛然下刺，直打$n腕部的神门穴",
        "dodge"  : -120,
        "parry"  : -100,
        "damage" : 9,
        "damage_type" : "刺伤"
]),
([      "action" : "$N手中$w自上而下反刺，模拟冰轮横空、清光铺地的光景",
        "dodge"  : -150,
        "parry"  : -110,
        "damage" : 17,
        "damage_type" : "刺伤"
]),
([      "action" : "$N手中$w颤动来回挥削，只幌得$n眼花撩乱，浑不知从何攻来",
        "dodge"  : -120,
        "parry"  : -120,
        "damage" : 21,
        "damage_type" : "刺伤"
]),
([      "action" : "$N手中$w由内自外一刺，左手虚击，身形一晃，$w已搭在$n腕部",
        "dodge"  : -130,
        "parry"  : -70,
        "damage" : 29,
        "damage_type" : "刺伤"
]),
([      "action" : "$N左掌横摆胸前，右手中$w轻轻挥拂，直取$n的神门要穴",
        "dodge"  : -130,
        "parry"  : -100,
        "damage" : 28,
        "damage_type" : "刺伤"
]),
([      "action" : "$N手中$w中宫直入，携着强大的劲道攻向$n的$l",
        "dodge"  : -140,
        "parry"  : -140,
        "damage" : 39,
        "damage_type" : "刺伤"
]),
});

int valid_enable(string usage)
{
        return usage == "sword" || usage == "parry";
}

int valid_learn(object me)
{
if( me->query("family/family_name")!="武当派" && !me->samsara_check("shenmen-jian",1)) 
        return notify_fail("你非武当弟子，难以领会神门十三剑的奥妙之处！\n"); 
        if ((int)me->query_skill("taiji-jian", 1) < 300)
                return notify_fail("你的太极剑法火候不到，无法学习神门十三剑。\n");
        if ((int)me->query_skill("liangyi-jian", 1) < 300)
                return notify_fail("你的两仪剑法火候不到，无法学习神门十三剑。\n");

        if ((int)me->query("force") < 300)
                return notify_fail("你的内力太差，无法学习神门十三剑。\n");


        return 1;
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))]; 
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
        object weapon;
        weapon = victim->query_temp("weapon");

        if (! victim->query_temp("weapon")
           || ! living(victim)
           || me->query("max_force") / 2 < victim->query("max_force")
           || damage_bonus < 100
           || me->query("force") < 1000
           || me->query_skill("shenmen-jian", 1) < 180
           || victim->is_busy()
           || random(2) == 1)
                return 0;

        victim->start_busy(2);
        weapon->move(environment(victim));

        return HIW "突然间$n" HIW "被$N" HIW "一剑刺中神门要穴，手中" +
               weapon->name() + HIW "再也抓拿不住，不禁脱手飞出。\n" NOR;
}

int practice_skill(object me)
{
        object weapon;

        if (! objectp(weapon = me->query_temp("weapon")) ||
            (string)weapon->query("skill_type") != "sword")
                return notify_fail("你使用的武器不对。\n");

        if ((int)me->query("kee") < 65)
                return notify_fail("你的体力不够练神门十三剑。\n");

        if ((int)me->query("force") < 65)
                return notify_fail("你的内力不足以练神门十三剑。\n");

        me->receive_damage("kee", 52);
        me->add("force", -58);
        return 1;
}

string perform_action_file(string action)
{
        return CLASS_D("wudang") + "/shenmen-jian/" + action;
}

