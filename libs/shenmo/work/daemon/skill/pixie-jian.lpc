int valid_learn(object me)
{
        
        object ob;
        
        if( me->query("family/family_name")!="神策军")
                return notify_fail("你非神策军中人，难以领会辟邪剑法的奥妙之处！\n");
 if ((int)me->query_skill("pixie-jian", 1) < 80)
               return notify_fail("你的辟邪剑法火候还不够，还不能学习。\n");
if (me->query("zhuanshi") < 1)
return notify_fail("没转世的人是无法学习辟邪剑法的。\n");
        
if( (string)me->query_skill_mapped("force")!= "kuihua-shengong")
return notify_fail("辟邪剑法必须配合神策军的葵花心法才能练。\n");
if ((string)me->query("gender") == "女性" )
return notify_fail("自古没有女人可以学葵花心法的。\n");
if ((string)me->query("gender") == "男性" )
return notify_fail("葵花心法第一要诀：欲练神功，必先自宫。\n");
if( (int)me->query_skill("pixie-jian", 1) > 699 )
return notify_fail("你的辟邪剑法残缺，只能练到这个地步了。\n");

if( (int)me->query("max_force") < 100 )
                return notify_fail("你的内力不够，没有办法练辟邪剑法。\n");

        if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "sword" )
                return notify_fail("你必须先找一把剑才能练剑法。\n");

        return 1;
}

int valid_enable(string usage)
{
        return usage=="sword" || usage=="throwing"|| usage=="parry";
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
        
        int sword_level=(int)me->query_skill("sword");
        int pot=random(2)*random(2)*random(2)*random(2)*random(2);
        //练习中有1/(2*2*2*2*2)的机会是加气血.
        if( me->query("family/family_name")!="神策军")
                return notify_fail("你非神策军中人，难以领会辟邪剑法的奥妙之处！\n");

        if( (int)me->query("sen") < 20
        ||      (int)me->query("force") < 300 )
                return notify_fail("你的精力或内力不够，没有办法温习辟邪剑法。\n");
        
        if (me->query("max_kee")*1000 > me->query("combat_exp")) 
                tell_object(me, "你的武学修为没到，修炼辟邪剑法已经不能修养气血了！\n");                
if( (int)me->query_skill("pixie-jian", 1) > 699 )
return notify_fail("你的辟邪剑法残缺，只能练到这个地步了。\n");

if ((string)me->query("gender") == "女性" )
return notify_fail("自古没有女人可以学葵花心法的。\n");
if ((string)me->query("gender") == "男性" )
return notify_fail("葵花心法第一要诀：欲练神功，必先自宫。\n");
        me->receive_damage("sen", 15);  
        me->add("force", -5);   
        message_vision(MAG"$N按照自己的学识，默默温习了一遍辟邪剑法。\n"NOR,me);
        
        if (me->query("jingya/addpot")==0)      
          me->set("jingya/addpot",1);
                
                
        if (    me->query("max_kee") < sword_level*50                   //c1. 气血小于 有效剑法*50 
                && sword_level >175                                     //c2. 有效剑法>175      
                && (me->query("max_kee")*1000 < me->query("combat_exp"))//c3. 气血 * 1000 < 武学                
                && pot!=0)
                {
                  me->add("max_kee",pot);
                 me->add("eff_kee",pot);                         
                 tell_object(me, "你感到内息畅顺，运行于四肢百骇，似乎气血有所增益！\n");
                 me->add("jingya/addpot",pot);               
                }
        
        return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
  int damage;
       if( damage_bonus < 30 ) return 0;

if(me->query("family/family_name") != "神策军")
return 0;
      if( random(damage_bonus) > victim->query_str()/10) {
 damage=damage_bonus/3+random(damage_bonus/3);
//  victim->receive_wound("kee", damage/3 );
 victim->delete_temp("jldl");
if (me->query("force") < me->query("max_force")*2)
{
  me->add("force", damage*2 );
 }
                 if (wizardp(me) && me->query("env/combat")=="verbose")
                  tell_object(me, sprintf(HIM+BLINK+"autopfm_damage: %d\n" NOR, 
(damage_bonus ) ));
                switch(random(3)) {
                       case 0: return HIW"$n"+HIW+"身中的葵花阴劲发作了！\n"NOR;
                       case 1: return HIW"$N"+HIW+"劲力一吐，一道阴劲从$w"+HIW+"中冲出击伤$n"+HIW+"的经脉！\n"NOR;

                       case 2: return HIW"$N"+HIW+"低喝一声，$w"+HIW+"上阴劲吞吐！\n"NOR;

               }
        }

}



string perform_action_file(string action)
{
        return CLASS_D("jjg") + "/pixie-jian/" + action;
}



