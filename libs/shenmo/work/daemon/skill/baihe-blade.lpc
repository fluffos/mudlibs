//By windy 2011.08
//鬼谷门捭阖刀法
//命中率高，伤害力中

inherit SKILL;
#include <ansi.h>
mapping *action = ({
  ([ "name": "东击胡夷",
    "action":
    "$N飞步上前，手中$w迎风一抖，一式「" HIG "东击胡夷" NOR "」闪电般劈向$n的左肩",
    "dodge": -10,
    "parry": -10,
    "damage": 80,
    "damage_type": "劈伤"
  ]),
  ([ "name": "西伐羌戎",
    "action":
    "$N刀光连闪，手中$w一式「" HIY "西伐羌戎" NOR "」用力斩向$n的右肋",
    "dodge": -30,
    "parry": -30,
    "damage": 100,
    "damage_type": "劈伤"
  ]),
  ([ "name": "南征蛮越",
    "action":
    "$N向前一个滚翻，$w随身而走，一式「" HIR "南征蛮越" NOR "」悄无声息地削向$n的双腿",
    "dodge": -20,
    "parry": -20,
    "damage": 90,
    "damage_type": "割伤"
  ]),
  ([ "name": "北驱匈奴",
    "action":
    "$N双手一振，$w突发异芒，一式「" HIB "北区匈奴" NOR "」势不可挡地向$n前心刺去",
    "dodge": -40,
    "parry": -40,
    "damage": 120,
    "damage_type": "刺伤"
  ]),
  ([ "name": "纵横捭阖",
    "action":
    "$N突然间势如下山猛虎，手中$w挟着一股凌厉霸气，「" HIW "纵横捭阖" NOR "」般斩向$n",
    "dodge": -50,
    "parry": -50,
    "damage": 180,
    "damage_type": "劈伤"
  ]),
});


int valid_learn(object me) {
  object ob;

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "blade")
    return notify_fail("你必须先找一把刀才能学捭阖刀法。\n");
  if (me->query("family/family_name") != "三界散仙"
    && me->query_skill("baihe-blade", 1) < 350 && !me->samsara_check("baihe-blade"))
    return notify_fail("你捭阖刀法基础还不够扎实。\n");
  if ((int)me->query_skill("spysword", 1) >= 120)
    return notify_fail("越是练到后来，你越发觉得捭阖刀法与刺客剑法的主旨一为合纵，一为连横，很难统一起来。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "parry" || usage == "blade";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if (me->query("class") != "xian" && !me->samsara_check("baihe-blade"))
    return notify_fail("这是仙界特有的功夫，你还是省省吧。\n");


  if ((int)me->query("kee") < 50
    || (int)me->query("force") < 20)
    return notify_fail("你的内力或气不够，没有办法练习捭阖刀法。\n");

  me->receive_damage("kee", 30);
  me->add("force", -10);
  write("你按着所学练了一遍捭阖刀法。\n");
  return 1;
}

int valid_effect(object me, object weapon, string name, int skill) {}

string perform_action_file(string func) {
  return CLASS_D("sanxian") + "/baihe-blade/" + func;
}
