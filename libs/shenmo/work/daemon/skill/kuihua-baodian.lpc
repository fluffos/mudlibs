//fofa.c

inherit SKILL;

int valid_enable(string usage) { return usage == "spells"; }

int valid_learn(object me) {
  if ((int)me->query_skill("spells") <= (int)me->query_skill("kuihua-baodian"))
    return notify_fail("你的法术修为还不够高深，无法学习葵花宝典。\n");
  if ((int)me->query("bellicosity") > 100)
    return notify_fail("你的杀气太重，学了葵花宝典也无法使用。\n");
  if (me->query("family/family_name") != "神策军")
    return notify_fail("你非神策军中人，难以领会葵花心法的奥妙之处！\n");
  return 1;
}

string cast_spell_file(string spell) {
  return CLASS_D("jjg") + "/kuihua-baodian/" + spell;

}
