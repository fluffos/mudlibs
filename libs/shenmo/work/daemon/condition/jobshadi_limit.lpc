// bonze_drug.c



#include <login.h>
#include <ansi.h>

inherit F_CLEAN_UP;


int update_condition(object me, int duration)

{

  if (duration < 1) {
    if (me->query_temp("killed_mgb") > 0) {
      me->set_temp("job_over", 1);
    } else me->apply_condition("jobshadi_failed", 6);
    me->delete_temp("start_job");
    tell_object(me, HIY "\n恭喜你成功的保护天庭\n" NOR);
    return 0;
  }

  me->apply_condition("jobshadi_limit", duration - 1);

  return 1;

}

int can_clear() { return 0; }

string name() { return "系统"; }

string query_type(object me)

{

  return "job";

}
