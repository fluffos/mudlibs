#include <ansi.h>
#include <condition.h>
inherit F_CLEAN_UP;

int update_condition(object me, int duration) {
  int damage, p;
  string msg;

  damage = me->query_temp("hell_fire_damage");
  if (!damage || damage < 10)
    damage = 10;
  p = 40 - me->query("kar");
  if (p < 1)
    p = 1;
  damage *= p;

  if (living(me)) {
    message_vision(HIB "\n「啪」地一团蓝色火焰在$N" HIB "脚下燃起，如鬼魅缠身，将$N" HIB "拢在中央。\n" NOR, me);
    me->receive_wound("kee", damage / 2);
    me->receive_wound("sen", damage / 3);
    random(2) ? COMBAT_D->report_sen_status(me, damage) : COMBAT_D->report_status(me, damage);
  }
  me->set_temp("death_msg", "给地狱火烧死了。\n");
  me->apply_condition("hell_fire", duration - 1);
  if (duration < 1)
    return 0;
  return CND_CONTINUE;
}

string query_type(object me) {
  return "hurt";
}

int can_clear() { return 0; }

string name() { return "系统"; }
