#include <condition.h>
#include <ansi.h>
inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{
if ( me )
        {
        if ( time()>= me->query("invisibility_seal") || ( me->is_fighting() && random(5)==1 ) )
                {
                if ( me->query("env/invisibility")>0 || me->query("env/invisibility")=="YES" )
                        {
                        message_vision(YEL"浓雾散去，$N"YEL"渐渐露出了身影。。。。\n"NOR,me);
                        me->delete("env/invisibility");
                        me->delete("invisibility_seal");
                        return 0;
                        }
                }
        }               
return CND_CONTINUE;
}


string name() {return "系统";}

int can_clear() { return 0; }
