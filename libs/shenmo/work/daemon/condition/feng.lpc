// By windy
#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration) {
  if (duration < 1) return 0;
  if (!living(me)) {
    message(
      "vision",
      HIG "" + me->name() + "可能刚被打狗棒法之「封」字诀封住了经脉，行动略显不便。\n" NOR,
      environment(me),
      me
    );
  } else {
    tell_object(me, HIW "你被打狗棒法之「封」字诀封住了经脉，一时难以脱困！n" NOR);
    message(
      "vision",
      HIG "" + me->name() + "可能刚被打狗棒法之「封」字诀封住了经脉，行动略显不便。\n" NOR,
      environment(me),
      me
    );
  }
  if (!me->is_busy())
    me->start_busy(5 + random(3));
  me->apply_condition("feng", duration - 1);

  if (duration < 1) return 0;
  return CND_CONTINUE;
}

int can_clear() { return 0; }

string name() { return "系统"; }
