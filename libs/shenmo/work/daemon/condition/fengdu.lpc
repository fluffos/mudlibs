//蜂毒
#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{
   if( duration < 1 ) return 0;
   if( !living(me) ) {
      message("vision", HIR""+me->name() + "突然浑身如同针扎，体内的蜂毒发作了。\n"NOR, environment(me), me);
   }
   else {
      tell_object(me, HIR "蜂毒发作了。\n" NOR );
      message("vision", HIR""+me->name() + "突然浑身如同针扎，体内的蜂毒发作了。\n"NOR,
            environment(me), me);
   }
   me->receive_wound("kee", 200);
   me->receive_damage("kee", 200);
   me->apply_condition("fengdu", duration - 1);

   if( duration < 1 ) return 0;
   return CND_CONTINUE;
}
int can_clear(){return 0;}
string name() {return "蜂王之毒";}
