// bonze_drug.c



#include <login.h>
#include <ansi.h>

inherit F_CLEAN_UP;


int update_condition(object me, int duration)

{

        if (duration < 1 || environment(me)->query("warcity")==0)
          return 0;

        me->apply_condition("gongjob_limit", duration - 1);
        message_vision(HIY"$N正站在城墙上密切注视着城下"HIR"突厥军队"HIY"的一举一动。\n"NOR,me);

        return 1;

}

int can_clear() { return 0; }

string name() {return "系统";}

string query_type(object me)

{

        return "job";

}


