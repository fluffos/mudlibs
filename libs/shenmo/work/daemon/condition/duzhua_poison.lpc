// duzhua_poison.c

#include <ansi.h>

int update_condition(object me, int duration) {
  int damage_kee = random(5), damage_sen = random(5);


  me->receive_wound("sen", damage_sen);
  me->receive_wound("kee", damage_kee);
  me->set_temp("death_msg", "被药王爪的剧毒毒死了。\n");
  me->apply_condition("zhua_poison", duration - 1);

  if ((int)me->query("kee") < (int)me->query("max_kee") / 4)
    message_vision(HIC "\n$N" HIC "毒入膏肓，抖着抖着，眼看就不行了！\n" NOR, me);
  else if ((int)me->query("kee") < (int)me->query("max_kee") / 2)
    message_vision(HIW "\n$N" HIW "浑身的烂肉掉的差不多了，露出白骖骖的骨头！\n" NOR, me);
  else
    message_vision(HIM "\n$N" HIM "面色发黑，浑身渐渐腐烂，“啪”的一声掉一块肉来！\n" NOR, me);

  if (duration < 1) return 0;
  return 1;
}


string name() { return HIR "毒爪" HIB "巨毒" NOR; }
int can_clear() { return 1; }
