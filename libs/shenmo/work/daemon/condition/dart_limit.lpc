// bonze_drug.c

//运镖限制
#include <login.h>
inherit F_CLEAN_UP;

int update_condition(object me, int duration)

{

        if (duration < 1) return 0;

        me->apply_condition("dart_limit", duration - 1);

        return 1;

}


string name() {return "系统";}

string query_type(object me)

{

        return "job";

}

int can_clear(){return 0;}
