//lianhua.c
//莲花新写法使用此
#include <ansi.h>

void lianhua_con(object me,object ob,string temp,int i)
{
string msg="";
if ( !me || !ob || !present(ob,me) || ob->query("equipped")!="worn" )
        return;
switch(temp)
        {
        case "kee" :
                if ( me->query("kee")>=me->query("eff_kee") )
                        return;
                msg+= "$n在$N身后隐隐约约摆动，$P立刻觉得气血充沛起来。\n";
                break;
        case "eff_kee" :
                if ( me->query("eff_kee")>=me->query("max_kee") )               
                        return;
                msg+= "$n在$N身后隐隐约约摆动，$P立刻觉得气血渐渐恢复了起来。\n";
                break;
        case "sen" :
                if ( me->query("sen")>=me->query("eff_sen") )
                        return;
                msg+= "$n在$N身后隐隐约约摆动，$P精神一振！\n"NOR;                              
                break;
        case "eff_sen" :
                if ( me->query("eff_sen")>=me->query("max_sen") )
                        return;
                msg+= "$n在$N身后隐隐约约摆动，$P精神一振！\n";   
                break;
        case "force" :
                if ( me->query("force")/2>=me->query("max_force") )
                        return;
                msg+= "$n在$N身后隐隐约约摆动，$P顿时觉得内力充沛起来！\n";
                break;
        case "mana" :
                if ( me->query("mana")/2>=me->query("max_mana") )
                        return;
                msg+= "$n在$N身后隐隐约约摆动，$P顿时觉得法力充沛起来！\n";
                break;
        default : return;       
        }
message_vision(msg,me,ob);
me->add(temp,i);
if ( me->query("kee")>me->query("eff_kee") )   
        me->set("kee",me->query("eff_kee") );
if ( me->query("eff_kee")>me->query("max_kee") )   
        me->set("eff_kee",me->query("max_kee") );
if ( me->query("sen")>me->query("eff_sen") )   
        me->set("sen",me->query("eff_sen") );
if ( me->query("eff_sen")>me->query("max_sen") )   
        me->set("eff_sen",me->query("max_sen") );
if ( me->query("force")>me->query("max_force")*2 )
        me->set("force",me->query("max_force")*2 );
if ( me->query("mana")>me->query("max_mana")*2 )
        me->set("mana",me->query("max_mana")*2 );
}

int update_condition(object me, int duration)
{
mixed temp;     
object *inv,ob;
int i,j,k;      
if ( !me )
        return 0;
me->apply_condition("lianhua",100);
inv = all_inventory(me);
for(j=0;j<sizeof(inv);j++)
        {
        if ( !inv[j]->is_lianhua() 
          || inv[j]->query("equipped")!="worn" )
                continue;
        ob = inv[j];    
        i = ob->query("莲花/lvl"); 
        i*= 500;
        i = i/2+random(i/2); 
        if ( i>2500*(me->query("zhuanshi")>0?me->query("zhuanshi"):1) )
                i = 2500*(me->query("zhuanshi")>0?me->query("zhuanshi"):1);
        temp = ob->query("莲花/addType");
        if ( temp && stringp(temp) )
                lianhua_con(me,ob,temp,i);
        else if ( temp && arrayp(temp) )
                {
                for(k=0;k<sizeof(temp);k++)
                        lianhua_con(me,ob,temp[k],i);
                }
        else    continue;               
        }
return 1;
}

