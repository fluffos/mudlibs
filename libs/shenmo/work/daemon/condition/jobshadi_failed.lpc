#include <login.h>

inherit F_CLEAN_UP;


int update_condition(object me, int duration)

{

        if (duration < 1) return 0;

        me->apply_condition("jobshadi_failed", duration - 1);

        return 1;

}

int can_clear() { return 0; }
string name() {return "ϵͳ";}


string query_type(object me)

{

        return "job";

}


