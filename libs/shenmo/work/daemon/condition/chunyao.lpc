// snake_poison.c

#include <ansi.h>

int update_condition(object me, int duration)
{
if( duration < 1 ) return 0;
if (me->query_temp("chunyao")>10)
        {
        me->delete_temp("chunyao");
        me->delete_temp("last_damage_from");
        me->set_temp("death_msg","春药发作死了。\n"); 
        me->die();
        me->save();
        }
else    me->receive_damage("sen", 20);
me->apply_condition("chunyao", duration - 1);
if (me->query("gender")=="男性")
        tell_object(me, HIM"你全身燥热难当，若是在一时三刻之内找不到女子与你交合，恐有性命之忧! \n"NOR);
else
        tell_object(me, HIM"你全身奇痒难耐，若是在一时三刻之内找不到男子与你交合，恐有性命之忧! \n"NOR);
me->add_temp("chunyao", 1);
message("vision", HIM""+me->name() + "抓耳挠腮，满面赤红，眼中似要喷出火来。\n"NOR, environment(me), me);
return 1;
}
int can_clear() { return 1; }
string name() {return "春药";}
