//sanqing.c 一剑化三清 
//snowtu
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SSERVER;

string name()
{
return "「"HIC"一剑化三清"NOR"」";
}

int valid_perform(object me)
{
int time = 3+random(4);
if ( me->query_skill("sanqing-jian",1)<60 )
        return notify_fail("你的"+to_chinese("sanqing-jian")+"等级不足"+80+"级，无法使出"+name()+"。\n");
if(me->query("family/family_name")!="五庄观" && !me->samsara_check("sanqing-jian",1))
        return notify_fail(name()+"是五庄观不传之技。\n");
if ( me->query("force") < 300 )
        return notify_fail("你的真气不足 300 点，不能使出"+name()+"。\n");
if ( time()<me->query_temp("wzg_sanqing")+time )
        return notify_fail("三清都给你叫烦了！\n");
return 1;
}       
        
void postfabao1(object,object,object,int);
void postfabao2(object,object,object,int);
void postfabao3(object,object,object,int);

mapping *actions_fabao = ({
        ([      "action":
HIY"$N"HIY"抖足精神，大喝一声“看法宝！”，只见一道金光从$P手中祭起，「呼」地一下飞
到半空，霎那间天色一变，风声大作！那物什径直击向$n"HIY"$l"NOR,
                "damage_type" : "内伤",
                "post_action" : (: postfabao1 :),
        ]),
        ([      "action":
HIW"$N"HIW"抖足精神，大喝一声“看法宝！”，只见一道白光从$P手中祭起，「呼」地一下飞
到半空，霎那间天色一变，风声大作！那物什砸向$n"HIW"$l"NOR,
                "damage_type" : "砸伤",
                "post_action" : (: postfabao2 :),

        ]),
        ([      "action":
HIY"$N"HIY"抖足精神，大喝一声“看法宝！”，只见一道金光从$P手中祭起，「呼」地一下飞
到半空，霎那间天色一变，风声大作！万道金光从那物什上射向$n"HIY"$l"NOR,
                "damage_type" : "刺伤",
                "weapon" :  BLINK HIY"金光"NOR,
                "post_action" : (: postfabao3 :),
        ]),
        ([      "action":
HIB"$N"HIB"抖足精神，大喝一声“看法宝！”，只见一道蓝光从$P手中祭起，「呼」地一下飞
到半空，霎那间天色一变，风声大作！那蓝光直刺$n"HIB"$l"NOR,
                "damage_type" : "刺伤",
                "weapon"      : BLINK HIB"蓝光"NOR,
                "post_action" : (: postfabao1 :),
        ]),
});

mapping ranAction()
{
return actions_fabao[random(sizeof(actions_fabao))];
}

int perform(object me, object target)
{
object weapon, ob;
string msg, string1;
int myexp, myskill, myforce, myfactor, mylevel;
int success=0;
myexp = (int)me->query("combat_exp");
myforce = (int)me->query("force");
myfactor = (int)me->query("force_factor");
mylevel = (int)me->query("level");
myskill = (int)me->query_skill("sanqing-jian", 1);

if ( !valid_perform(me) )
        return 0;
if ( !target ) target = offensive_target(me);
if ( !target
  || !target->is_character()
  || !me->is_fighting(target) )
        return notify_fail(name()+"只能对战斗中的对手使用。\n");
if ( !me->is_fighting() )
        return notify_fail(name()+"必须战斗中使用。\n");

if (!objectp(weapon = me->query_temp("weapon"))
|| (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对，无法施展"+name()+"。\n");

me->set_temp("wzg_sanqing",time());
if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
        msg = YEL"\n$N"YEL"将手中"+me->query_temp("weapon")->name()+YEL"一摆，跳出圈外，
左手捏诀，右手对着$n"YEL"一指，大喝一声“疾！”\n\n"NOR;
else    msg = HIC"$N"HIC"对$n"HIC"使用了"+name()+"。\n"NOR;
message_vision(msg, me,target);
if ( target->is_busy() || me->query_skill("sanqing-jian")>random(target->query_skill("parry")) )
        success = 1;
if ( success!=1 )
        {
        write(HIB"结果什么反应也没有。\n"NOR);
        if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
                {
                message("vision",YEL"但见风云变色，天地撼动，一时间地动山摇！只是半天也没什么反应....\n"NOR,environment(me),me);
                message_vision(HIM"$n"HIM"给吓了一跳！定睛观瞧，不由哈哈大笑：这等伎俩也来嚣张！！\n"NOR,me,target);
                }
        if ( random(me->query_kar())<20 )
                me->start_busy(0);
        }
else    {
        object npc;
        int i;
        string *msgs = ({
                "只听得正东上一声钟响，来了一位道人，戴九云冠，穿大红白鹤绛绡衣，说道：\n\t\t混元初判道如先，常有常无得自然；\n\t\t紫气东来三万里，函关初度五千年。\n",       //上清道人
                "只听得正南上又有钟响，来了一位道者，戴如意冠，穿淡黄八卦衣，唱曰：\n\t\t函关初出至昆仑，一统华夷属道门；\n\t\t我体本同天地老，须弭山倒性还存。\n",           //玉清道人
                "正北上又是一声玉磬响，来了一位道人；戴九霄冠，穿八宝万寿紫霞衣，唱道：\n\t\t混沌从来不计年，鸿蒙剖处我居先；\n\t\t叁同先天地玄黄理，任我傍门望眼穿。\n",     //太清道人
        });
        mapping f_npc = ([
                "上清道人" : "shangqing zhenren",
                "玉清道人" : "yuqing daoren",
                "太清道人" : "taiqing daoren",
        ]);

        for(i=0;i<3;i++)
                {
                if ( present(target,environment(me) ) && me->is_fighting(target) )
                        {
                        msg = HIC+msgs[i]+NOR;
                        if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
                                message_vision(msg,me,target);
                        npc = new("/d/qujing/wuzhuang/npc/daxian");
                        npc->delete("title");
                        npc->set_name(keys(f_npc)[i],({values(f_npc)[i],"zhen ren"}) );
                        npc->set("actions",ranAction());
                        npc->set("combat_exp", myexp/2*3);
                        npc->set("force", myforce/2*3);
                        npc->set("force_factor", myfactor/2*3);
                        npc->set("level", mylevel/2*3);
                        npc->set_skill("sword", myskill/2*3);
                        npc->set_skill("sanqing-jian", myskill/2*3);
                        npc->set_skill("parry", myskill/2*3);
                        npc->set_skill("dodge", myskill/2*3);
                        npc->set_skill("force", myskill/2*3);
                        npc->set("default_actions",ranAction());
                        npc->set("env/no_msg",1);
                        npc->move(environment(me));
                        npc->command("say "+me->name()+"道友，某来助你一臂之力。\n");
                         COMBAT_D->do_attack(npc,target,npc->query_temp("weapon") );
                        if ( !me->query("env/no_msg") && !target->query("env/no_msg") )        
                                message_vision(HIC"\n"+npc->name()+HIC"哈哈一笑，化作一道青烟直冲云霄。\n\n"NOR,me);
                        target->set_temp("last_damage_from",me);                                
                        destruct(npc);
                        }
                }
        }
return 1;
}

void postfabao1(object me,object victim,object weapon, int damage)
{
string msg;
if ( victim && me->is_fighting(victim) )
        {
        msg = HIG"\n\n$w"HIG"在空中定住不动，$N"HIG"掐咒一指“疾！”\n"NOR;
        if ( random(2) )
                {
                msg+= HIG"结果$n"HIG"轻一挥手，嘿嘿笑了几声：想跟我斗？再去修个三五百年吧！\n"NOR;
                msg+= HIG"只见$w"HIG"几个翻滚，又回到了$N"HIG"的手中。\n\n"NOR;
                msg = replace_string(msg,"$w",me->query("fabao"));
                if ( !me->query("env/no_msg") && !victim->query("env/no_msg") )  message_vision(msg,me,victim);
                }
        else    {
                msg+= HIG"结果$w"HIG"发出一道夺目的强光，将$n"HIG"牢牢的罩在其中！\n"NOR;
                msg+= HIG"$n"HIG"如同蛛网上的蚊蝇般，动弹不得！\n\n"NOR;
                msg = replace_string(msg,"$w",me->query("fabao"));
                if ( !me->query("env/no_msg") && !victim->query("env/no_msg") )        
                        message_vision(msg,me,victim);
                damage+= 100;
                damage = damage/2+random(damage/2);
                if ( damage>500 ) damage = 500;
                if ( damage<300 ) damage = 300;
                victim->receive_damage("sen",damage*2);
                victim->receive_wound("sen",damage);
                COMBAT_D->report_sen_status(victim);
                COMBAT_D->report_sen_status(victim,damage);
                if ( !me->is_busy() )
                        me->start_busy(0);
                msg = HIG"\n$N"HIG"口中念咒，将$w"HIY"收了回去。\n\n"NOR;
                msg = replace_string(msg,"$w",me->query("fabao"));
                if ( !me->query("env/no_msg") && !victim->query("env/no_msg") ) 
                        message_vision(msg,me,victim);
                }
        }
}

void postfabao2(object me,object victim,object weapon, int damage)
{
string msg,limb,*limbs;
if ( victim && me->is_fighting(victim) )
        {
        msg = HIW"\n\n$w"HIW"在空中盘旋了几下，狠狠朝$n"HIW"$l砸去！\n\n"NOR;
        limbs = victim->query("limbs");
        limb = limbs[random(sizeof(limbs))];
        msg = replace_string(msg,"$l",limb);
        msg = replace_string(msg,"$w",me->query("fabao"));
        if ( random(2) )
                {
                msg+= HIR"结果$n"HIR"$l被砸了个正着,鲜血直流！\n\n"NOR;
                msg = replace_string(msg,"$w",me->query("fabao"));
                msg = replace_string(msg,"$l",limb);
                if ( !me->query("env/no_msg") && !victim->query("env/no_msg") ) 
                        message_vision(msg,me,victim);
                if ( damage>400 ) damage = 400;
                damage = damage/2+random(damage/2);
                if ( damage<10 ) damage = 10;
                victim->receive_damage("sen",damage/2);
                victim->receive_damage("kee",damage/2);
                COMBAT_D->report_sen_status(victim);
                msg = HIW"\n$N"HIW"口中念咒，将$w"HIW"收了回去。\n\n"NOR;
                msg = replace_string(msg,"$w",me->query("fabao"));
                if ( !me->query("env/no_msg") && !victim->query("env/no_msg") ) 
                        message_vision(msg,me,victim);
                }
        else    {
                msg = HIW"结果$n"HIW"轻一挥手，嘿嘿笑了几声：想跟我斗？再去修个三五百年吧！\n"NOR;
                msg+= HIW"只见$w"HIW"几个翻滚，又回到了$N"HIW"的手中。\n\n"NOR;
                msg = replace_string(msg,"$w",me->query("fabao"));
                if ( !me->query("env/no_msg") && !victim->query("env/no_msg") ) 
                        message_vision(msg,me,victim);
                }
        }
}

void postfabao3(object me,object victim,object weapon, int damage)
{
string msg,limb,*limbs;
if ( victim && me->is_fighting(victim) )
        {
        msg = HIY"$w"HIY"在空中发出一道金光，朝着$n"HIY"$l直射过去！\n"NOR;
        limbs = victim->query("limbs");
        limb = limbs[random(sizeof(limbs))];
        msg = replace_string(msg,"$l",limb);
        if ( random(3)==1 )
                {
                msg+= HIY"\n\n结果$n"HIY"轻一挥手，嘿嘿笑了几声：想跟我斗？再去修个三五百年吧！\n"NOR;
                msg+= HIY"只见$w"HIY"几个翻滚，又回到了$N"HIG"的手中。\n\n"NOR;
                msg = replace_string(msg,"$w",me->query("fabao"));
                if ( !me->query("env/no_msg") && !victim->query("env/no_msg") ) 
                        message_vision(msg,me,victim);
                }
        else    {
                msg+= HIY"\n\n结果$n"HIY"虽然堪堪躲开，但$l还是给那强光灼射了一记！\n\n"NOR;
                limbs = victim->query("limbs");
                limb = limbs[random(sizeof(limbs))];
                msg = replace_string(msg,"$l",limb);
                message_vision(msg,me,victim);
                if ( victim->query("force")<1000 )
                        victim->set("force",0);
                else    victim->add("force",-1000);
                msg = HIY"$n"HIY"立时觉得丹田真气如泄堤洪水般瞬时外泻而去！！\n\n"NOR;
                if ( !me->query("env/no_msg") && !victim->query("env/no_msg") ) 
                        message_vision(msg,me,victim);
                me->add("force",100+random(900));
                msg = HIY"\n$N"HIY"口中念咒，将$w"HIY"收了回去。\n\n"NOR;
                msg = replace_string(msg,"$w",me->query("fabao"));
                if ( !me->query("env/no_msg") && !victim->query("env/no_msg") ) 
                        message_vision(msg,me,victim);
                }
        }
}

int help(object me)
{
string temp;    
temp = "\t\t"+to_chinese("sanqing-jian")+" 60 级\n";
temp+= "\t\t真    气 300 点\n";
temp+= "\t\t战斗状态下使用\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");
write(@HELP

        使用功效：
                招出三清道人对对手进行攻击
        出招类型：
                延迟型外功
                带有隐藏攻击
                不可以叛师带出
        出手要求：              
HELP);                          
write(temp);
return 1;
}
