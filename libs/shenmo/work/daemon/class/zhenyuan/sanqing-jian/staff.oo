//化剑为杖

#include <ansi.h>
inherit PERFORM;

int temp_time()
{
object me = this_player();
int time = me->query_skill("sanqing-jian")/10+4;
if ( time>4 ) time = 4;
return time;
}

void create()
{
set("name",HIC"化剑为杖");
set("class","xian");
set("family","五庄观");
set("betray_lvl",350);
set("limit_skill",([
        "sanqing-jian"  :       80,
        "fumo-zhang"            :       80,
        "sword"         :       80,
        "staff"         :       80,
        "force"         :       80,
]));
set("force",800);
set("need_force",100);
set("temp","wzg/sword_to_staff");
set("temp_time", (: temp_time :));
set("target",1);
}

void hit_msg(object me,object target,int num)
{
object  ob = new("/d/obj/weapon/staff/tieguai");
SDS_D->hitWeapon(me,target,ob);
}

void lost_hit_msg(object me,object target,int num) { normal_hit_msg(me); }
void success_hit_msg(object me,object target,int num) { normal_hit_msg(me); }

void normal_hit_msg(object me)
{
object weapon = me->query_temp("weapon");

if ( me && me->is_fighting() && weapon )
        {
        message_vision(HIY"$N"HIY"舞动手中"+weapon->name()+HIY"，以剑化杖，使出伏魔杖法，怪招迭出，
把对手看得眼花缭乱，目瞪口呆！\n"NOR,me);
        weapon->set_temp("original/use_apply_skill",weapon->query("use_apply_skill"));
        weapon->set_temp("original/skill_type",weapon->query("apply/skill_type"));
        weapon->set_temp("original/skill_type2",weapon->query("skill_type"));
        weapon->set("use_apply_skill",1);
        weapon->set("apply/skill_type","staff");
        weapon->set("skill_type","staff");
        me->reset_action();
        call_out("rmove_weapon",query("temp_time"),me,weapon);
        }
return;
}

void rmove_weapon(object me,object weapon)
{
if ( me && weapon && weapon->query("equipped") )
        {
        weapon->set("use_apply_skill",weapon->query_temp("original/use_apply_skill"));
        weapon->set("apply/skill_type",weapon->query_temp("original/skill_type"));
        weapon->set("skill_type",weapon->query_temp("original/skill_type2"));
        me->reset_action();
        }
}

void remove_eff(object me,string temp_busy)
{
object weapon;
if ( me && me->query_temp(temp_busy) )
        {
        me->delete_temp(temp_busy);
        message_vision(HIY"\n$N"HIY"的剑法渐渐恢复了常态。\n\n"NOR,me);
        }
return;
}



