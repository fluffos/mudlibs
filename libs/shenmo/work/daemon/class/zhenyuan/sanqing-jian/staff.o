//化剑为杖
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

void end_pfm(object me, int enhance,int damage,object weapon);

int temp_time(object me)
{
int time = me->query_skill("sanqing-jian")/10+4;
if ( time>4 ) time = 4;
return time;
}

string name()
{
return "「"HIR"化剑为杖"NOR"」";
}

int valid_perform(object me)
{
int time = 1+random(4);
if ( me->query_skill("sanqing-jian",1)<80 )
        return notify_fail("你的"+to_chinese("sanqing-jian")+"等级不足"+80+"级，无法使出"+name()+"。\n");
if ( me->query_skill("fumo-zhang",1)<80 )
        return notify_fail("你的"+to_chinese("fumo-zhang")+"等级不足"+80+"级，无法使出"+name()+"。\n");
if ( me->query_skill("sword",1)<80 )
        return notify_fail("你的"+to_chinese("sword")+"等级不足"+80+"级，无法使出"+name()+"。\n");
if ( me->query_skill("staff",1)<80 )
        return notify_fail("你的"+to_chinese("staff")+"等级不足"+80+"级，无法使出"+name()+"。\n");
if ( me->query_skill("zhenyuan-force",1)<80 )
        return notify_fail("你的"+to_chinese("zhenyuan-force")+"等级不足"+80+"级，无法使出"+name()+"。\n");
if (  me->query("family/family_name")!="五庄观" 
//     && me->query_skill("sanqing-jian",1)<350 )
  || me->query("class")!="xian" )
        return notify_fail(name()+"是五庄观不传之技。\n");
if ( time()<me->query_temp("wzg_staff")+temp_time(me) )
        return notify_fail(name()+"需要"+temp_time(me)+"秒的冷却时间。\n");
if ( me->query("max_force")<800 )
        return notify_fail("你内力修为不足 800 点，不能"+name()+"。\n");
if ( me->query("max_force")<100 )
        return notify_fail("你真气不足 100 点，不能"+name()+"。\n");    
return 1;
}       
        
int perform(object me, object target)
{
object weapon=me->query_temp("weapon");
int enhance,damage,howlong;
if (!objectp(weapon = me->query_temp("weapon"))
|| (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对，无法施展"+name()+"。\n");
if (weapon->query("zizhi"))
        return notify_fail("你不能用这把剑施展"+name()+"。\n");

if ( !valid_perform(me) )
        return 0;
me->add("force", -100);
message_vision(HIY"$N"HIY"舞动手中"+weapon->name()+HIY"，以剑化杖，使出伏魔杖法，怪招迭出，把对手
看得眼花缭乱，目瞪口呆！\n"NOR,me);
weapon->set_temp("original/use_apply_skill",weapon->query("use_apply_skill"));
weapon->set_temp("original/skill_type",weapon->query("apply/skill_type"));
weapon->set_temp("original/skill_type2",weapon->query("skill_type"));
weapon->set("use_apply_skill",1);
weapon->set("apply/skill_type","staff");
weapon->set("skill_type","staff");
enhance = me->query_skill("sword")/3;
me->add_temp("apply/attack", enhance);  
damage = weapon->query("weapon_prop/damage");
me->add_temp("apply/damage",damage);        
howlong = temp_time(me);
me->set_temp("wzg_staff",time());
me->reset_action();
call_out("remove_effect",howlong,me,enhance,damage,weapon);
return 1;
}

void remove_effect(object me,int enhance,int damage,object weapon) 
{
remove_call_out("remove_effect");       
if ( !me ) 
        return; 
write(NOR HIY BLK "你的剑法渐渐恢复了常态。\n"NOR);     
me->delete_temp("wzg_staff");
me->add_temp("apply/attack",-enhance);
me->add_temp("apply/damage",-damage);
if (weapon) 
        {
        weapon->set("use_apply_skill",weapon->query_temp("original/use_apply_skill"));
        weapon->set("apply/skill_type",weapon->query_temp("original/skill_type"));
        weapon->set("skill_type",weapon->query_temp("original/skill_type2"));
        }
me->reset_action();
}

int help(object me)
{
string temp;    
temp = "\t\t"+to_chinese("sanqing-jian")+" 80 级\n";
temp+= "\t\t"+to_chinese("fumo-zhang")+" 80 级\n";
temp+= "\t\t"+to_chinese("sword")+" 80 级\n";
temp+= "\t\t"+to_chinese("staff")+" 80 级\n";
temp+= "\t\t"+to_chinese("zhenyuan-force")+" 80 级\n";
temp+= "\t\t内力修为 800 点\n";
temp+= "\t\t真    气 100 点\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");
write(@HELP

        使用功效：
                转化武器状态，同时提高自身攻击力
        出招类型：
                延迟型外功
                无隐藏攻击
                不可叛师带出
        出手要求：              
HELP);                          
write(temp);
return 1;
}
