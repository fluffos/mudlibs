//by windy 2007/01/10

#include <ansi.h>
inherit SSERVER;
#include "/daemon/skill/eff_msg.h";

string *xue_name = ({ 
        HIR"劳宫穴"NOR,HIR"膻中穴"NOR,HIR"曲池穴"NOR,
        HIG"关元穴"NOR,HIG"曲骨穴"NOR,HIG"中极穴"NOR,
        HIY"承浆穴"NOR,HIY"天突穴"NOR,HIY"百会穴"NOR,
        HIM"幽门穴"NOR,HIM"章门穴"NOR,HIM"大横穴"NOR,
        HIW"紫宫穴"NOR,HIW"冷渊穴"NOR,HIW"天井穴"NOR,
        HIC"极泉穴"NOR,HIC"清灵穴"NOR,HIC"至阳穴"NOR,
}); 
string *weapon1_name = ({ HIR"一道剑气"NOR,HIR"左手剑"NOR,HIG"疾风般的快剑"NOR});
string *weapon2_name = ({ HIW"半轮剑弧"NOR,HIB"一道闪光"NOR,HIR"无形剑气"NOR});
string *weapon3_name = ({ HBRED"回旋剑气"NOR,HBGRN"一道剑光"NOR,HBBLU"无数剑气"NOR}); 

string name() 
{
        return "「"HIR"荡气回肠"NOR"」";
}

int valid_perform(object me) 
{
        if(me->query("family/family_name")!="五庄观" && !me->samsara_check("sanqing-jian",1))
                return notify_fail(name()+"是五庄观不传之密！\n");
        if( time()-(int)me->query_temp("HUICHANG_end") < 4+random(4) )
                return notify_fail("绝招用多就不灵了！\n");
        if( (int)me->query_skill("sanqing-jian", 1) < 100 )
                return notify_fail("你的三清剑法还不够熟练，不能使用"+name()+"对敌！\n");
        if( (int)me->query_skill("sword", 1) < 100 )
                return notify_fail("你的剑法不够娴熟，使不出"+name()+"！\n");
        if( (int)me->query_skill("force", 1) < 100 )
                return notify_fail("你的内功不够娴熟，使不出"+name()+"！\n");
        if( (int)me->query_skill("parry", 1) < 100 )
                return notify_fail("你的招架不够娴熟，使不出"+name()+"！\n");
        if( (int)me->query_skill("zhenyuan-force", 1) < 100 )
                return notify_fail("你的镇元神功不够精湛，使不出"+name()+"！\n");
        if(! me->query_temp("weapon") )
                return notify_fail("你必须用剑才能使用"+name()+"！\n");
        if( (int)me->query("max_force") < 1500 )
                return notify_fail("你现在内力修为不足，使不出"+name()+"！\n");     
        if( (int)me->query("force") < 1000 )
                return notify_fail("你现在内力不足，使不出"+name()+"！\n");     
        return 1;
}

int perform(object me, object target) 
{
        int damage, p;
        string msg, dodge_skill,*limbs;
        if ( !valid_perform(me) ) 
                return 0; 
        if ( !target )  
                target = offensive_target(me); 
        if ( !target  
         || !target->is_character() 
         || target==me ) 
                return notify_fail(name()+"只能在战斗中使用。\n"); 
        if ( !me->is_fighting() ) 
                return notify_fail(name()+"必须在战斗中使用。\n"); 

        msg = HIG"突然之间，$N"HIG"剑交右手，寒光一闪，剑拉弧形，剑气森森直逼向$n"HIG"。\n"NOR;
        me->set_temp("HUICHANG_end",time());
        if( random(me->query_skill("force")) > random(target->query_skill("force") /4)
         && random(me->query("combat_exp")) > random(target->query("combat_exp") /4) )
        {                     
                msg += CYN"$n"CYN"大吃一惊，变招不及，$w"+CYN"已在他的"NOR+xue_name[random(sizeof(xue_name))]+CYN"对穿而出，真气不由一散。\n"NOR;
                damage = (int)me->query_skill("sword", 1);       
                damage = damage + random(damage/2);
                target->receive_damage("kee", damage, me);
                target->receive_wound("kee", damage/3, me);
                p = (int)target->query("kee")*100/(int)target->query("max_kee");

                msg += "( $n"+eff_status_msg(p)+" )\n";
                msg = replace_string(msg, "$w", weapon1_name[random(sizeof(weapon1_name))]);   
                message_vision(msg, me, target);
                target->set_temp("last_damage_from", me);
                me->add("force", -(int)me->query_skill("sword", 1)/2);
                if( (int)me->query_skill("parry", 1) > 200 
                 && (int)me->query_skill("zhenyuan-force", 1) > 200 
                 && (int)me->query_skill("sword", 1) > 200 
                 && (int)me->query_skill("sanqing-jian", 1) > 200 
                 && (int)me->query_skill("force", 1) > 200 ) 
                { 
/*remove会将所有玩家call_out的perform2全部remove了，换个写法 by snowtu                  
                        remove_call_out("perform2");
                        call_out("perform2", 0, me, target);  
*/                      
                        me->start_call_out( (: call_other, __FILE__, "perform2", me, target:), 0);
                        
                }
        }
        else 
        {
                msg += HIY"\n$n"HIY"却识得那团剑芒的厉害,早已远远避在一边。\n" NOR;
                message_vision(msg, me, target);
        }
        return 1;
}

int perform2(object me, object target)
{
        int cost_force,damage,p;
        string msg, dodge_skill,*limbs,force_skill,force_skill_name,wep;
        
        if( !me || !target || !me->is_fighting(target) )
                return 1;
        if(!objectp(wep = me->query_temp("weapon")) || wep->query("skill_type") != "sword")
        {
                if(!wep)msg = HIY"$N"HIY"手中武器既失，荡气回肠的剑气也随之消散，$n"HIY"不禁松了口气。\n"NOR;
                else  msg = HIY"$N"HIY"亮出"+wep->name()+HIY"而停止追击，$n"HIY"身边密布的剑幕也随之消散，压力骤然减轻！\n"NOR;
                message_vision(msg, me, target);
                return 1;
        } 
        if (me->query_skill_mapped("sword") != "sanqing-jian")
        {
                message_vision(HIY"$N"HIY"突然变招，划破剑幕，使出和三清剑法剑法完全不同的招数来！\n"NOR,me);
                return 1;
        }
        if(!me->is_fighting(target) && !me->is_killing(target->query("id")))
        {
                if(!living(target)) 
                        msg = HIY"$N"HIY"不屑地望了$n"HIY"一眼，将手中"+wep->name()+HIY"一向后摆，撤回了散开的剑幕。\n"NOR;
                else    msg = HIY"$N"HIY"将手中"+wep->name()+HIY"向后一摆，抱圆守一，停止了攻击。\n"NOR;
                message_vision(msg, me, target);
                return 1;
        }           
        if(!living(target)) 
                return 1;
        //addby snowtu 防止内力为负导致无心跳           
        cost_force = (int)me->query_skill("sword", 1)/2;                
        if( (int)me->query("force", 1) < 1000 
         || (int)me->query("force", 1) < cost_force ) 
        {
                message_vision(HIY"$N"HIY"剑招渐见涩滞，刚才一剑刺出竟然软弱无力，原来是真气不足了！\n"NOR,me);
                return 1;
        }
        force_skill = target->query_skill_mapped("force");
        
        if( !force_skill ) 
                force_skill_name = "内家真气";
        else
        {
                force_skill_name = to_chinese(force_skill);        
                if( !force_skill_name )
                        force_skill_name = "绝世神功";   
        }                       
        msg = HIG "\n跟着，$N"HIG"随式一转，右跨一步，蓦地剑交左手，剑势却是千变万化，剑气万重。\n"NOR;        
        if( random(me->query_skill("force")) > random(target->query_skill("force") /3)
         && random(me->query("combat_exp")) > random(target->query("combat_exp") /4) )
        {            
                msg += CYN"只听$n"CYN"一声惨嚎,剑气从"NOR+xue_name[random(sizeof(xue_name))]+CYN"掠过，$n"CYN"连运"NOR+HIY+force_skill_name+NOR+CYN"，真气已然无法凝聚。\n"NOR;
                damage = (int)me->query_skill("sword", 1);       
                damage = damage*3/2 + random(damage);
                target->receive_damage("kee", damage, me);
                target->receive_wound("kee", damage/3, me);
                p = (int)target->query("kee")*100/(int)target->query("max_kee");
                msg += "( $n"+eff_status_msg(p)+" )\n";                
                msg = replace_string(msg, "$w", weapon2_name[random(sizeof(weapon2_name))]);
                me->add("force", -(int)me->query_skill("sword", 1)/2);   
                target->set_temp("last_damage_from", me);
                message_vision(msg, me, target);    
                if( (int)me->query_skill("parry", 1) > 300 
                 && (int)me->query_skill("zhenyuan-force", 1) > 300 
                 && (int)me->query_skill("sword", 1) > 300 
                 && (int)me->query_skill("sanqing-jian", 1) > 300 
                 && (int)me->query_skill("force", 1) > 300 ) 
                {
                        me->start_call_out( (: call_other, __FILE__, "perform3", me, target:), 0);
                }
        } 
        else 
        {
                msg += HIY"\n$n"HIY"顺势亦是右转，轻轻一带，竟然躲过这招迅捷的"NOR+HIR"左手剑"NOR+HIY"。\n" NOR;
                me->add("force", -(int)me->query_skill("sword", 1)/2);     
                message_vision(msg, me, target);    
        }

        return 1;
}
int perform3(object me, object target)
{
        int cost_force,damage , p;
        string msg, weapon,dodge_skill,*limbs,force_skill,force_skill_name;

        if( !me || !target || !me->is_fighting(target) )
                return 1;
        if(!objectp(weapon = me->query_temp("weapon")) || weapon->query("skill_type") != "sword")
        {
                if(!weapon)msg = HIY"$N"HIY"手中武器既失，荡气回肠的剑气也随之消散，$n"HIY"不禁松了口气。\n"NOR;
                else  msg = HIY"$N"HIY"亮出"+weapon->name()+HIY"而停止追击，$n"HIY"身边密布的剑幕也随之消散，压力骤然减轻！\n"NOR;
                message_vision(msg, me, target);
                return 1;
        } 
        if( me->query_skill_mapped("sword") != "sanqing-jian")
        {
                message_vision(HIY"$N"HIY"突然变招，划破剑幕，使出和三清剑法完全不同的招数来！\n"NOR,me);
                return 1;
        }
        if(!me->is_fighting(target) && !me->is_killing(target->query("id")))
        {
                if(!living(target)) msg = HIY"$N"HIY"不屑地望了$n"HIY"一眼，将手中"+weapon->name()+HIY"一向后摆，撤回了散开的剑幕。\n"NOR;
                else msg = HIY"$N"HIY"将手中"+weapon->name()+HIY"向后一摆，抱圆守一，停止了攻击。\n"NOR;
                message_vision(msg, me, target);
                return 1;
        }           
        //addby snowtu 防止内力为负导致无心跳           
        cost_force = (int)me->query_skill("sword", 1)/2;                
        if( (int)me->query("force", 1) < 1000 
         || (int)me->query("force", 1) < cost_force ) 
        {
                message_vision(HIY"$N"HIY"剑招渐见涩滞，刚才一剑刺出竟然软弱无力，原来是真气不足了！\n"NOR,me);
                return 1;
        }
        force_skill = target->query_skill_mapped("force");
        if( !force_skill ) 
                force_skill_name = "内家真气";
        else
        {
                force_skill_name = to_chinese(force_skill);        
                if( !force_skill_name )
                        force_skill_name = "绝世神功";   
        }                       
   
        weapon = me->query_temp("weapon");  
        msg = HIW "\n紧接着，$N"HIW"飞身向前，身剑合一，所幻的光圈一圈一圈，$n"HIW"全身已被套在其中！\n"NOR;        
        if( random(me->query_skill("force")) > random(target->query_skill("force") /3)
         && random(me->query("combat_exp")) > random(target->query("combat_exp") /4) )
        {   
                msg += weapon3_name[random(sizeof(weapon3_name))]+WHT"刺破了$n"WHT"苦修多年的"NOR+HIY+force_skill_name+NOR+WHT",喀嚓一声$n"WHT"的手臂已被斩断，同时"NOR+xue_name[random(sizeof(xue_name))]+WHT"上血如泉涌。\n"NOR;
                damage = (int)me->query_skill("sword", 1);       
                damage = damage*2 + random(damage*2);
                target->receive_damage("kee", damage, me);
                target->receive_wound("kee", damage/2, me);
                p = (int)target->query("kee")*100/(int)target->query("max_kee");
                 msg += damage_msg(damage, "砸伤");
                msg += "( $n"+eff_status_msg(p)+" )\n";     
                limbs = target->query("limbs");
                msg = replace_string(msg, "$l", limbs[random(sizeof(limbs))]);
                msg = replace_string(msg, "$w", weapon->name());   
               target->set_temp("last_damage_from", me);
                me->add("force", -(int)me->query_skill("sword", 1)/2);
        } 
        else 
        {
                msg += HIY"\n$n"HIY"却识得那团光圈的厉害，中宫直入，势如破竹。\n" NOR;
                me->add("force", -(int)me->query_skill("sword", 1)/2);
        }
        message_vision(msg, me, target); 
        return 1;
}

int help(object me)
{
string temp;    
temp = "\t\t"+to_chinese("sanqing-jian")+" 100 级\n";
temp+= "\t\t"+to_chinese("sword")+" 100 级\n";
temp+= "\t\t"+to_chinese("force")+" 100 级\n";
temp+= "\t\t"+to_chinese("zhenyuan-force")+" 100 级\n";
temp+= "\t\t"+to_chinese("parry")+" 100 级\n";
temp+= "\t\t内力修为十五点\n";
temp+= "\t\t内力１０００点\n";
temp+= "\t\t战斗状态下使用\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");
write(@HELP

        使用功效：
                连续牵制敌人并打击敌人的气血
        出招类型：
                延迟型外功
                有隐藏攻击
                不可叛师带出
        出手要求：              
HELP);                          
write(temp);
return 1;
}

