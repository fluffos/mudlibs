#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() {
  return "「" HIW "灵幻剑芒" NOR "」";
}

int temp_time(object me) {
  int time = me->query_skill("sanqing-jian", 1);
  time /= 50;
  time -= 20;
  if (time > 15) time = 15;
  if (time < 5) time = 5;
  return time;
}

int valid_perform(object me) {
  if (me->query_skill("sword", 1) < 100)
    return notify_fail("你的" + to_chinese("sword") + "等级不足" + 100 + "级，无法使出" + name() + "。\n");
  if (me->query_skill("sanqing-jian", 1) < 100)
    return notify_fail("你的" + to_chinese("sanqing-jian") + "等级不足" + 100 + "级，无法使出" + name() + "。\n");
  if (me->query("family/family_name") != "五庄观"
    && me->query_skill("sanqing-jian", 1) < 350)
    return notify_fail(name() + "是五庄观不传之密。\n");
  if (me->query("class") != "xian" && !me->samsara_check("sanqing-jian"))
    return notify_fail(name() + "此乃仙家不传之密。\n");
  if (me->query("max_force") < 800)
    return notify_fail("你的内力修为不足800点，不能使出" + name() + "。\n");
  if (me->query("max_force") < 100)
    return notify_fail("你的真气不足100点，不能使出" + name() + "。\n");
  if (time() < me->query_temp("wzg_jianmang") + temp_time(me))
    return notify_fail(name() + "需要" + temp_time(me) + "秒的冷却时间。\n");
  return 1;
}
int perform(object me, object target) {
  string msg;
  int ap, myexp, yourexp, extra;
  object weapon;

  if (!valid_perform(me))
    return 0;
  if (!target)
    target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(name() + "只能在战斗中使用.\n");
  if (!me->is_fighting())
    return notify_fail(name() + "必须在战斗中使用。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对，无法施展" + name() + "。\n");

  ap = (int)me->query("spi");
  myexp = (int)me->query("combat_exp");
  yourexp = (int)target->query("combat_exp");

  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    msg = HIC "\n$N" HIC "一声朗笑,手中长剑斜指向天,剑尖吐出一团尺余的银芒,似有灵性般吞缩不定!
$n" HIC "正诧异间,那团剑芒却猛得暴涨,朝着$p" HIC "的面门直射而来!\n" NOR;
  else msg = HIC "$N" HIC "对$n" HIC "使用了" + name() + HIC "。\n" NOR;
  message_vision(msg, me, target);
  me->set_temp("wzg_jianmang", time());
  if (random(myexp / 10) > yourexp / 50) {
    msg = HIR "只听$n" HIR "一声惨嚎,剑芒从$p的额头掠过,带出一缕血光!!\n" NOR;
    msg += HIW "\n剑芒长虹经天般自天际处转得一转,又飞回$N" HIW "的身边。\n" NOR;
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(msg, me, target);
    target->start_busy(2 + random(3));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
  } else {
    msg = HIY "\n$n" HIY "却识得那团剑芒的厉害,早已远远避在一边。\n" NOR;
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(msg, me, target);
  }
  me->add("force", -100);
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("sanqing-jian") + " 100 级\n";
  temp += "\t\t" + to_chinese("sword") + " 100 级\n";
  temp += "\t\t内力修为 800 点\n";
  temp += "\t\t真    气 100 点\n";
  temp += "\t\t战斗状态下使用\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                牵制对手
        出招类型：
                延迟型外功
                造成对手2-4秒的busy
                350级可以叛师带出
        出手要求：              
HELP);
  write(temp);
  return 1;
}
