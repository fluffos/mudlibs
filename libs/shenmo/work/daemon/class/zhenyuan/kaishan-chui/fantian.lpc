#include <ansi.h>
inherit SSERVER;
string name() {
  return "「" HIR "翻天覆地" NOR "」";
}
int valid_perform(object me) {
  if (!me) return 0;
  if (time() - (int)me->query_temp("fantian_end") < 2)
    return notify_fail("绝招用多就不灵了！\n");
  if (userp(me))
    return notify_fail("你不能使用这一绝招！\n");
  if ((int)me->query("max_force") < 1000)
    return notify_fail("你的内功修为太差。\n");
  if ((int)me->query("force") < 500)
    return notify_fail("你的内力不足！\n");
  if ((int)me->query("sen") < 200)
    return notify_fail("你的精神不足，没法子施展" + name() + "！\n");
  if (me->query_skill("kaishan-chui", 1) < 1000)
    return notify_fail("你的开山锤修为太浅，还施展不出" + name() + "！\n");
  return 1;
}
int perform(object me, object target) {
  object weapon;
  string msg, str;
  weapon = me->query_temp("weapon");
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用！\n");

  message_vision(HIR "\n$N仰天大喝了一声：四猛八大锤何在？" NOR, me, target);
  message_vision(HIR "\n刹那间风雷乍起，从半空中杀出四员威风凛凛的神将，各自舞动双锤攻向$n！\n" NOR, me, target);
  target->start_busy(8);
  message_vision(HIY "\n从东面传来一声断喝：李元霸在此！话音未落，一对擂鼓瓮金锤劈头砸向$n的面门！\n\n" NOR, me, target);
  target->receive_damage("kee", 10000, me);
  target->receive_wound("kee", 10000, me);
  COMBAT_D->report_status(target);
  target->receive_damage("kee", 10000, me);
  target->receive_wound("kee", 10000, me);
  COMBAT_D->report_status(target);
  message_vision(HIW "\n紧接着从西面传来一声断喝：裴元庆在此！说罢，一对八楞梅花亮银锤兜向$n的小腹！\n\n" NOR, me, target);
  target->receive_damage("kee", 10000, me);
  target->receive_wound("kee", 10000, me);
  COMBAT_D->report_status(target);
  target->receive_damage("kee", 10000, me);
  target->receive_wound("kee", 10000, me);
  COMBAT_D->report_status(target);
  message_vision(YEL "\n紧接着从南面传来一声断喝：秦佣在此！一对走线铜锤飞向$n前心！\n\n" NOR, me, target);
  target->receive_damage("kee", 10000, me);
  target->receive_wound("kee", 10000, me);
  COMBAT_D->report_status(target);
  target->receive_damage("kee", 10000, me);
  target->receive_wound("kee", 10000, me);
  COMBAT_D->report_status(target);
  message_vision(HIB "\n随后从北面传来一声断喝：粱世泰在此！一对镔铁压油锤猛击$n后背！\n\n" NOR, me, target);
  target->receive_damage("kee", 10000, me);
  target->receive_wound("kee", 10000, me);
  COMBAT_D->report_status(target);
  target->receive_damage("kee", 10000, me);
  target->receive_wound("kee", 10000, me);
  COMBAT_D->report_status(target);
  me->set_temp("fantian_end", time());
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("kaishan-chui") + " 1000 级\n";
  temp += "\t\t内力上限１０００点\n";
  temp += "\t\t内力５００点\n";
  temp += "\t\t精神２００点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP 

        使用功效： 
                连续打击对手的气血
        出招类型： 
                延时型外功
                六耳猕猴专用复仇武技
                叛师可带出 
        出手要求：               
HELP);
  write(temp);
  return 1;
}
