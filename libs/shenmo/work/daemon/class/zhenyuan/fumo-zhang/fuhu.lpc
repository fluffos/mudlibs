#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name()
{
return "「"HIY"降龙伏虎"NOR"」";
}

int valid_perform(object me)
{
if ( me->query_skill("fumo-zhang",1)<100 )
        return notify_fail("你的"+to_chinese("fumo-zhang")+"等级不足"+100+"级，无法使出"+name()+"。\n");
if ( me->query_skill("staff",1)<100 )
        return notify_fail("你的"+to_chinese("staff")+"等级不足"+100+"级，无法使出"+name()+"。\n");
if ( me->query_skill("force",1)<100 )
        return notify_fail("你的"+to_chinese("force")+"等级不足"+100+"级，无法使出"+name()+"。\n");
if ( me->query("family/family_name") != "五庄观"
    && me->query_skill("fumo-zhang",1)<300 )
        return notify_fail(name()+"是五庄观不传之密。\n");
if ( me->query("class")!="xian" && !me->samsara_check("fumo-zhang") )
        return notify_fail(name()+"此乃仙家不传之密。\n");
if ( me->query("force")<500 )
        return notify_fail("你的真气不足"+500+"点，不能使出"+name()+"。\n");
if ( time()<me->query_temp("wzg_fuhu")+3 )
        return notify_fail(name()+"需要3秒的冷却时间。\n");     
return 1;
}

int perform(object me, object target)
{
string msg;
int extra,i,lmt;
object weapon;

if ( !valid_perform(me) )
        return 0;
extra = me->query_skill("fumo-zhang",1)/10+me->query_skill("staff",1)/10+me->query("level")/5;

if ( !target ) target = offensive_target(me);
if ( !target
  || !target->is_character()
  || !me->is_fighting(target) )
        return notify_fail("［降龙伏虎］只能对战斗中的对手使用。\n");
if ( !me->is_fighting() )
        return notify_fail(name()+"必须在战斗中使用。\n");

if (!objectp(weapon = me->query_temp("weapon"))
|| (string)weapon->query("skill_type") != "staff")
        return notify_fail("你使用的武器不对，无法施展"+name()+"。\n");

msg = HIY"$N"HIY"身型闪动，地面随之起伏一降狂风，手中"+ weapon->name()+HIY"也有如狂风暴雨般地向$n"HIY"卷来！\n" NOR;
message_vision(msg,me,target);
me->set_temp("wzg_fuhu",time());
me->add_temp("apply/attack",extra);
me->add_temp("apply/damage",extra);
if ( (int)me->query_skill("fumo-zhang", 1)<200 )
        lmt = 7;
else    lmt = 9;
for(i=6;i<=lmt;i++)
        {
        me->set_temp("FMZ_perform",i);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
        SDS_D->hitWeapon(me,target,me->query_temp("weapon") );
        }
me->add_temp("apply/attack",-extra);
me->add_temp("apply/damage",-extra);
me->add("force",-500);
if (me->query("family/family_name") != "五庄观" && !me->samsara_check("fumo-zhang",1))
me->start_busy(random(2));
me->delete_temp("FMZ_perform");
return 1;
}

int help(object me)
{
string temp;    
temp = "\t\t"+to_chinese("fumo-zhang")+" 100 级\n";
temp+= "\t\t"+to_chinese("staff")+" 100 级\n";
temp+= "\t\t"+to_chinese("force")+" 100 级\n";
temp+= "\t\t内力 500 点\n";
temp+= "\t\t战斗状态下使用\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");
write(@HELP

        使用功效：
                对敌人进行连续三次的攻击，并有可能对之武器进行破坏
        出招类型：
                延迟性外功
                延迟性外功，非五庄观弟子有随机 busy
                能破坏对方的武器
                300级可以叛师带出
        出手要求：              
HELP);                          
write(temp);
return 1;
}
