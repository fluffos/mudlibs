#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string *bagua = ({
  "乾", "坤", "震", "巽", "坎", "离", "艮", "兑",
});

string name() {
  return "「" HIW "五行归位" NOR "」";
}

int valid_perform(object me) {
  if (me->query_skill("wuxing-quan", 1) < 100)
    return notify_fail("你的" + to_chinese("wuxing-quan") + "等级不足" + 100 + "级，无法使出" + name() + "。\n");
  if (me->query("force") < 100)
    return notify_fail("你的真气不足 100 点，无法使用" + name() + "。\n");
  if (me->query("class") != "xian" && !me->samsara_check("wuxing-quan"))
    return notify_fail(name() + "此乃仙家不传之密。\n");
  if (me->query("kee") < 50)
    return notify_fail("你的气血不足 50 点，无法使用" + name() + "。\n");
  return 1;
}

varargs void do_damage(object who, object victim, int self) {
  int damage;
  string msg;
  if (!who || !victim || !who->is_fighting(victim))
    return;
  damage = who->query_skill("unarmed");
  damage += who->query("force_factor");
  damage += who->query("mana_factor");
  damage += who->query_temp("apply/damage");
  damage -= victim->query_temp("apply/armor");
  if (damage < 100)
    damage = 100;
  damage = damage / 2 + random(damage / 2);

  if (!who->query("env/no_msg") && !victim->query("env/no_msg"))
    message_vision(HIM "结果$n" HIM "被$N" HIM "的真元逼的连连倒退！\n" NOR, who, victim);
  victim->receive_wound("kee", damage, who);
  if (!victim->is_busy())
    victim->start_busy(random(4));
  COMBAT_D->report_status(victim, damage);
  if (who->query_skill("wuxing-quan", 1) > 550
    && victim->query("family/family_name") != "五庄观"
    && (who->query("family/family_name") == "五庄观" || who->samsara_check("wuxing-quan", 1))
    && victim->query("combat_exp") > 10000
    && self) {
    msg = HIM "\n\n$N" HIM "见$n" HIM "已被" HIG "五" HIY "色" HIW "光" HIB "球" HIM "打得动弹不得，顺势上前，暗捺五行，脚踩
八卦，将$n" HIM "困于死门" + bagua[random(sizeof(bagua))] + "方！\n" NOR;
    msg += HIR "结果$n" HIR "的真元尽被$N" HIR "打破，$p的五行四散而去！\n" NOR;
    if (!who->query("env/no_msg") && !victim->query("env/no_msg"))
      message_vision(msg, who, victim);
    victim->add("combat_exp", -10000);
    victim->add("death/combat_exp_loss", 10000);
    if (userp(victim)) victim->save();
    tell_object(
      victim,
      HIR BLK "\n你的武学修为尽被" + who->name() + NOR HIR BLK "打散，欲要精深，还需从头修过。。。。\n\n" NOR
    );
    if (userp(victim) || wizardp(who))
      CHANNEL_D->do_channel(who, "rumor", sprintf(NOR WHT "%s" NOR HIM "惨被" NOR WHT "%s" NOR HIM "用" HIR "%s" HIM "毁去了一身修为！\n",
        victim->name(),
        who->name(),
        name(),
      ));
  }
}

int perform(object me, object target) {
  int ap, dp;
  string msg;

  if (!valid_perform(me))
    return 0;
  if (!target)
    target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || !me->is_fighting(target))
    return notify_fail(name() + "只能在战斗中使用。\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用。\n");

  me->add("force", -100);
  me->receive_damage("kee", 50);

  ap = me->query_skill("unarmed");
  ap /= 100;
  ap *= me->query("level");
  dp = target->query_skill("parry");
  dp += target->query_skill("dodge");
  dp /= 200;
  dp *= target->query("level");

  if (me->query("family/family_name") == "五庄观" || me->samsara_check("wuxing-quan", 1))
    ap = ap * 3 / 2;
  if (target->query("family/family_name") == "五庄观")
    dp = dp * 3 / 2;
  if (COMBAT_D->restrain(me, target))
    ap = ap * 3 / 2;
  if (COMBAT_D->restrain(target, me))
    dp = dp * 3 / 2;

  msg = HIW "$N" HIW "突然双手双举对天大喊道：金、木、水、火、土五行真元速速归位！
只见空气中突然暴开五色光球急速向$n" HIW "飞去！\n" NOR;
  message_vision(msg, me, target);
  if (random(ap + dp) < dp) {
    if (!COMBAT_D->restrain(target, me)) {
      message_vision(HIC "但是$n" HIC "轻轻一跳就躲了开来。\n" NOR, me, target);
      me->start_busy(3);
    } else {
      message_vision(HIR "但是$N" HIR "的真元被$n" HIR "的真元硬给逼了回来！\n" NOR, me, target);
      do_damage(target, me, 0);
    }
  } else do_damage(me, target, 1);
  me->start_busy(1 + random(2));
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("wuxing-quan") + " 100 级\n";
  temp += "\t\t真    气 100 点\n";
  temp += "\t\t气    血 50 点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                伤害对手的气血
        出招类型：
                busy型外功
                可叛师带出
                有隐藏属性
        出手要求：              
HELP);
  write(temp);
  return 1;
}
