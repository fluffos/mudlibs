// 北方群狼拳wolfs.c

#include <ansi.h>

inherit SSERVER;
int wolf(object me, object target);

int perform(object me, object target) {
  string msg;
  int i, skill;
  skill = me->query_skill("fengxue-quan");
  skill = skill / 50;
  if (skill < 5) skill = 5;
  if (skill > 20) skill = 20;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail(HIR "你要用群狼拳打谁？\n" NOR);

  if ((int)me->query("force") < 500)
    return notify_fail("你的内力不够！\n");

  msg = HIR "\n$N" HIR "一声长啸，踏前一步，一招“北方群狼拳”，暴风骤雨般攻向$n" HIR "！\n" NOR;
  message_vision(msg, me, target);
  me->add_temp("apply/damage", -100);
  me->add_temp("apply/dodge", -100);
  for (i = 0; i < skill; i++)
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  me->start_busy(2 + random(2));
  me->add("force", 100 + random(400));
  me->add_temp("apply/dodge", 100);
  me->add_temp("apply/damage", 100);
  return 1;
}
