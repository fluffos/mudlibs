//奥汀仙风拳 aoding.c

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
int ap,dp,damage,chance;
string msg;
object weapon;
                
if( !target ) target = offensive_target(me);

if( !target
 || !target->is_character()
 ||  target->is_corpse()
 ||  target==me)
	return notify_fail("你要对谁施展"HIW"奥汀仙风拳"NOR"？\n");

if(!me->is_fighting())
	return notify_fail("「"HIW"奥汀仙风拳"NOR"」只能在战斗中使用！\n");

if((int)me->query("max_force") < 500 )
	return notify_fail("你的内力不够！\n");

if((int)me->query("force") < 500 )
	return notify_fail("你的内力不足！\n");

if((int)me->query("sen") < 300 )
	return notify_fail("你的精神不足，没法子施用外功！\n");

if((int)me->query_skill("fengxue-quan", 1) < 100)
	return notify_fail("你的拳法修为还不够，使用这一招会有困难！\n");

msg = BYEL+HIW"\n$N"BYEL+HIW"目中神光一闪,平心静气,立刻全身浸没在奥丁的庇佑之下!\n"NOR;
ap = me->query_skill("unarmed");
ap = ap*ap*ap / 20;
dp = target->query("combat_exp"); 
chance = (int)(random( ap + dp ) / dp * 100);
if (target->is_busy()) chance *= 3;
if( chance > 30 ) 
	{
	switch (random(4))
		{
		case 0:{
			target->add("force",(int)target->query("force")/2 );
			me->add("force",(int)target->query("force")/4+random((int)target->query("force")/4) );
			me->command_function("exert recover"); 
			me->command_function("exert refresh"); 
			}
		break;
		default: {					
			me->set("eff_kee",(int)me->query("max_kee"));
			me->set("eff_sen",(int)me->query("max_sen"));
			me->command_function("exert recover"); 
			me->command_function("exert refresh"); 
			}	
		break;
		}
	}
else   msg += "\n";
message_vision(msg, me, target);
me->add("force",-100);
me->start_busy(2);
return 1;
}
