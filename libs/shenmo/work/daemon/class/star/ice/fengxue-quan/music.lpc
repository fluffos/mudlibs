//魔弦送葬曲music.c

#include <ansi.h>
#include <combat.h>

inherit SSERVER;
string *body = ({
  "脖子", "左手", "右手", "左腿", "右腿", "小腹", "双眼",
});

int perform(object me, object target) {
  string msg, pot;
  int extra, damage, wound;
  int orforce;
  object weapon;
  pot = body[random(sizeof(body))];

  if (me->is_busy())
    return notify_fail("你现在正忙着！！\n");

  extra = me->query_skill("fengxue-quan", 1);
  damage = extra / 4 + random(extra * 3 / 4);
  wound = random(damage - 100);

  if ((int)me->query_skill("fengxue-quan", 1) < 200)
    return notify_fail("你的菩提指级别还不够！\n");


  if (me->query("force") < 300)
    return notify_fail(WHT "你内力不足，无法继续使出魔弦送葬曲。\n" NOR);

  if ((int)me->query_skill("unarmed", 1) < extra)
    return notify_fail(WHT "你的基本扑击格斗还不成熟。\n" NOR);

  if ((int)me->query("combat_exp", 1) < 5000000)
    return notify_fail("你的武学不够，不能使用这一招！\n");

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［" HIG "魔弦送葬曲" NOR "］只能对战斗中的对手使用。\n");

  weapon = me->query_temp("weapon");

  msg = HIW "\n$N" HIG "并不乘胜追击,反而停住了攻击,再抚琴弦弹奏一曲,口中低吟:\n\n" NOR;
  msg += HIC "I know that I hung on the windy tree\n";
  msg += "For nights, all of nineWounded byspear - and given to Odin\n";
  msg += "Myself to myself\n";
  msg += "On that Tree\n";
  msg += "And no man knows where the roots of it run.\n";
  msg += "None gave me bread ,\n";
  msg += "None gave me mead ,\n";
  msg += "I peered down ,\n";
  msg += "I took up the Runes,\n";
  msg += "Screaming of need I took them\n";
  msg += "And fell back hence.\n" NOR;
  message_vision(msg, me, target);

  if (random(me->query("combat_exp")) > random((int)target->query("combat_exp") / 3)) {
    me->add_temp("apply/attack", extra * 3);
    me->add_temp("apply/damage", extra * 3);
    msg = HIR "\n$n" HIR "正听得入神,哪里发觉$N" HIR "的琴弦已毒蛇般的缠了过来!\n" NOR;
    message_vision(msg, me, target);
    switch (pot) {
      case "双眼":
        {
          msg = HIR "$n" HIR "眼前一黑,已被琴弦遮住了" + pot + "!\n" NOR;
          msg += HIR "$n" HIR "发了疯般一阵攻击,章法全无,结果是空打了一场!\n" NOR;
          message_vision(msg, me, target);
          COMBAT_D->do_attack(target, target, target->query_temp("weapon"), TYPE_REGULAR);
          COMBAT_D->do_attack(target, target, target->query_temp("weapon"));
        }
        break;
      case "脖子":
        {
          msg = HIM "$n" HIM + pot + "一紧,已被琴弦牢牢缠住,立刻呼吸困难,动作停滞难行!\n" NOR;
          message_vision(msg, me, target);
          target->start_busy(1 + random(extra / 50));
          COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
        }
        break;
      default:
        {
          target->receive_damage("kee", damage * (2 + random(3)), me);
          if (wound > 0) target->receive_wound("kee", wound, me);
          msg = HIY "$n" HIY "躲闪不及," + pot + "已经挨了一下，给抽得鲜血淋漓!\n" NOR;
          msg += COMBAT_D->damage_msg(damage, "内伤");
          message_vision(msg, me, target);
        }
    }
    me->add("force", -200);
    me->start_busy(2 + random(2));
  } else {
    message_vision(HIW "可是$n" HIW "听出琴声中的杀机,躲过一劫!\n" NOR, me, target);
    me->add("force", -300);
    me->start_busy(3);
  }
  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }
  return 1;
}
