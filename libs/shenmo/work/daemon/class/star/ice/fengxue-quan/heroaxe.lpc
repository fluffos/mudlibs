// heroaxe.c
#include <ansi.h>
inherit SSERVER;

int perform(object me, object target) {
  int damage;
  string msg, f_msg, s_msg;
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || !me->is_fighting(target))
    return notify_fail(HIR "你要用夺命飞斧打谁？\n" NOR);
  if ((int)me->query("force") < 500)
    return notify_fail("你的内力不够！\n");
  me->add("force", -100 - random(400));
  if (time() < me->query_temp("last_heroaxe") + 8 + random(5))
    return notify_fail("绝招用多就不灵了。\n");
  switch (random(3)) {
    case 0:
      msg = HIW "\n$N仰头长啸一声，全身血筋虬张,拳风化作巨大的斧子带着风雪咆哮之声劈向$n!\n" NOR;
      s_msg = HIR "\n结果$n" HIR "被打个正着，顿时血溅当场！\n" NOR;
      f_msg = HIY "\n$n认识得这招的厉害，赶紧连退数步,躲开这一击,心魂未定。\n" NOR;
      break;
    case 1:
      msg = HIW "\n$N仰头长啸一声，全身血筋虬张,拳风化作巨大的斧子带着风雪咆哮之声劈向$n!\n" NOR;
      s_msg = HIR "\n结果$n" HIR "被打个正着，顿时血溅当场！\n" NOR;
      f_msg = HIY "\n$n认识得这招的厉害，赶紧连退数步,躲开这一击,心魂未定。\n" NOR;
      break;
    default:
      msg = HIW "\n$N仰头长啸一声，全身血筋虬张,拳风化作巨大的斧子带着风雪咆哮之声劈向$n!\n" NOR;
      s_msg = HIR "\n结果$n" HIR "被打个正着，顿时血溅当场！\n" NOR;
      f_msg = HIY "\n$n认识得这招的厉害，赶紧连退数步,躲开这一击,心魂未定。\n" NOR;
      break;
  }
  damage = me->query_temp("apply/damage");
  damage += me->query_skill("unarmed");
  message_vision(msg, me, target);
  me->set_temp("last_heroaxe", time());
  if (random(3)) {
    message_vision(s_msg, me, target);
    target->receive_wound("kee", damage, me);
    target->receive_wound("sen", damage, me);
    COMBAT_D->report_status(target, 1);
    COMBAT_D->report_sen_status(target, 1);
  } else {
    message_vision(f_msg, me, target);
    me->start_busy(1);
  }
  return 1;
}
