// 神威狼牙拳wolf.c

#include <ansi.h>

inherit SSERVER;
int wolf(object me, object target);

int perform(object me, object target) {
  string msg;
  int skill;
  skill = me->query_skill("spells");
  skill = skill / 50;
  if (skill < 1) skill = 1;
  if (skill > 5) skill = 5;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail(HIR "你要用神威狼牙拳打谁？\n" NOR);

  if ((int)me->query("force") < 500)
    return notify_fail("你的内力不够！\n");

  if (me->query_temp("wolf"))
    return notify_fail("你已在使出神威狼牙拳！\n");

  msg = HIB "\n$N邪笑一声，后退一步，上身微俯，两手撑地，仰首发出一阵凄厉的长啸！\n" NOR;
  msg += HIB "\n长啸中，$N和身而上，双手带着一片萧杀一声直抓$n" HIB "全身!\n" NOR;
  message_vision(msg, me, target);
  me->add("force", -100 - random(400));
  if (random((int)me->query("combat_exp")) > random((int)target->query("combat_exp") / 4)) {
    me->set_temp("f_wolf", skill);
    me->set_temp("wolf", 1);
    call_out("wolf", 1, me, target);
  } else {
    msg = HIM "\n$n" HIM "眼疾手快，不慌不忙，封住了$N" HIM "的攻击！\n" NOR;
    message_vision(msg, me, target);
    me->start_busy(1 + random(3));
  }

  return 3 + random(5);
}

int wolf(object me, object target) {
  string msg;

  if (!me || !target || !me->is_fighting(target)) return 1;
  if (me->is_fighting(target) && me->query_temp("f_wolf") > 0) {
    msg = HIR "\n$n" HIR "一个不防，中了$N" HIR "一抓，只觉得精气随之一空！\n" NOR;
    message_vision(msg, me, target);

    me->add_temp("apply/damage", (int)target->query_temp("apply/damage"));
    me->add_temp("apply/attack", (int)target->query_temp("apply/attack"));

    if (target->query_temp("apply/dodge") > 100)
      target->add_temp("apply/dodge", -100);
    else target->set_temp("apply/dodge", 0);

    if (target->query_temp("apply/armor") > 100)
      target->add_temp("apply/armor", -100);
    else target->set_temp("apply/armor", 0);

    if ((int)target->query("force") > 100)
      target->add("force", -100);
    else target->set("force", 0);

    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

    me->add_temp("apply/damage", -(int)target->query_temp("apply/damage"));
    me->add_temp("apply/attack", -(int)target->query_temp("apply/attack"));
    me->add_temp("f_wolf", -1);

    call_out("wolf", 1 + random(2), me, target);
  } else {
    msg = HIB "\n$N" HIB "嘿嘿一笑，收起了神威狼牙拳的攻击......\n" NOR;
    message_vision(msg, me, target);
    me->delete_temp("wolf");
    me->delete_temp("f_wolf");
    return 1;
  }
  return 1;
}
