//紫晶冥晶拳 zi.c

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
int ap,dp,damage,chance;
string msg;
object weapon;
                
if( !target ) target = offensive_target(me);

if( !target
 || !target->is_character()
 ||  target->is_corpse()
 ||  target==me)
	return notify_fail("你要对谁施展"MAG"紫晶冥晶拳"NOR"？\n");

if(!me->is_fighting())
	return notify_fail("「"MAG"紫晶冥晶拳"NOR"」只能在战斗中使用！\n");

if((int)me->query("max_force") < 500 )
	return notify_fail("你的内力不够！\n");

if((int)me->query("force") < 500 )
	return notify_fail("你的内力不足！\n");

if((int)me->query("sen") < 300 )
	return notify_fail("你的精神不足，没法子施用外功！\n");

if((int)me->query_skill("fengxue-quan", 1) < 100)
	return notify_fail("你的拳法修为还不够，使用这一招会有困难！\n");

msg = CYN"\n$N"CYN"手腕就一翻,"HIW"巴路莫古之剑"NOR+CYN"已然擎在手，高喝一声"NOR+HIR" 紫晶冥晶拳 "NOR+CYN"！\n"NOR;
ap = me->query_skill("unarmed");
ap = ap*ap*ap / 20;
dp = target->query("combat_exp"); 
chance = (int)(random( ap + dp ) / dp * 100);
if (target->is_busy()) chance *= 3;
if( chance > 20 ) 
	{
	switch (random(20))
		{
		case 19:{
                        msg+=CYN"\n$n"CYN"不知道这招的厉害,仍然埋首苦战,不想一个不察,已被$N"CYN"封进了"NOR+MAG"紫水晶"NOR+CYN"中!\n"NOR;
                        target->move("/d/sds4/ice/shuijing");
			msg+=CYN"$n"CYN"眼前一花,已经身在"NOR+MAG"紫水晶"NOR+CYN"中!\n"NOR;
                        target->unconcious();
			}
		break;
		default: {					
			damage = me->query_skill("unarmed") * 2 + me->query("force_factor");
                        if (damage < 700) damage = 650+random(75);
                        if (damage > 1000) damage = 900+random(275);
			target->receive_damage("kee",damage);
			target->receive_wound("kee",damage/3);
			target->start_busy(random(1)+1);
                        msg += CYN"$n"CYN"知道这一招的厉害,连忙躲闪,哪知$N"CYN"一招"NOR+HIR" 天人合一 "NOR+CYN"随即跟击！\n"HIR"$n"HIR"避无可避,硬接了这一拳!\n"NOR;
			}
		break;
		}
	}
else   msg += "但是被$n躲开了。\n"NOR;
message_vision(msg, me, target);

if( damage > 0 ) COMBAT_D->report_status(target);
   
if( !target->is_fighting(me) ) 
	{
	if( living(target) ) 
		{
		if( userp(target) ) target->fight_ob(me);
		else target->kill_ob(me);
		}
        }
me->add("force",-200-me->query("force_factor"));
me->start_busy(2);
return 1;
}
