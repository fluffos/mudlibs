//催命安灵曲 anling.c

inherit SSERVER;
#include <ansi.h>

int perform(object me, object target)
{
string msg;
int success, ap, dp, ap2, ap3, ap4, dp2, dp3, dp4,howlong;

if( !target ) target = offensive_target(me);

if((int)me->query_skill("spells") < 180
 || (int)me->query_skill("fengxue-quan",1) < 180)
	return notify_fail("你的修为不够。\n");

if( !target
 || !target->is_character()
 ||  target->is_corpse()
 ||  target==me)
	return notify_fail("你想对谁奏曲？\n");  

if((int)me->query("mana") < 400 )
	return notify_fail("你的法力不够！\n");

if((int)me->query("force") < 400 )
	return notify_fail("你的内力不够！\n");

if((int)me->query("sen") < 20 )
	return notify_fail("你无法集中精力！\n");

if (!living(target)) return notify_fail("有这个必要吗？\n");

me->add("mana", -400);
me->add("force", -400);
me->receive_damage("sen", 20);

msg = HIM"$N忧伤的眼神凝视着$n"HIM"的双眼，双手在圣衣上的竖琴轻轻抚动，弹奏出\n一曲["NOR+HIR"催命安灵曲"NOR+HIM"],似汩汩清泉般的乐音立刻响起......\n$n"HIM"顿时觉得神倦眼困，全身无力，斗志全无。\n"NOR;

success=1;
ap = me->query_skill("spells");
ap = ap * ap * ap /10 ;
ap += (int)me->query("daoxing")/2;
dp = target->query("daoxing");

if (target->is_fighting(me)) dp=dp*2;
if ( random(ap+dp)<random(dp) ) success=0;
    
ap = (int)me->query("mana");
dp = (int)target->query("mana");
if( random(ap + dp)<dp ) success = 0;

if(success == 1 )
	{
	msg +=  HIM"$n"HIM"不知不觉的哈欠连连，眼皮沉重，终于无心作战。\n"NOR;
       message_vision(msg, me, target);
	target->command_function("surrender");
	COMBAT_D->report_status(target);  
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	target->start_busy(ap/2000);
	me->start_busy(1+random(2)); 
	}	    
	else {
	msg +=HIM"\n$n"HIM"忽觉不妥，听出了音乐中隐隐所带的萧杀之气！当下定下心来作战。\n" NOR;	
       message_vision(msg, me, target);
       if( living(target) ) target->kill_ob(me);
	me->start_busy(5+random(5));
	} 
return 1;
}

