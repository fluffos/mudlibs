//白金虎口拳 hu.c
#include <ansi.h>
inherit SSERVER;

void hu(object me, object target);

int perform(object me, object target) {
  int i, k;
  string msg;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" HIW "白金虎口拳" NOR " ？\n");
  if (!me->is_fighting())
    return notify_fail("「" HIW "白金虎口拳" NOR "」只能在战斗中使用！\n");
  if ((int)me->query("max_force") < 500)
    return notify_fail("你的内力不够！\n");
  if ((int)me->query_temp("hu"))
    return notify_fail("「" HIW "白金虎口拳" NOR "」已经在使用！\n");
  if ((int)me->query("force") < 500)
    return notify_fail("你的内力不足！\n");
  if ((int)me->query("sen") < 300)
    return notify_fail("你的精神不足，没法子施用外功！\n");
  if ((int)me->query_skill("fengxue-quan", 1) < 100)
    return notify_fail("你的拳法修为还不够，使用这一招会有困难！\n");

  msg = HIW "\n$N" HIW "后退几步站稳,“吼吼”一笑：“看我" HBWHT "白金虎口拳" NOR + HIW "”！\n" NOR;
  message_vision(msg, me, target);
  i = (int)me->query_skill("spells");
  i = i / 40;
  me->set_temp("hu", 1);
  target->add_temp("hu/number", i);
  me->add("force", -250);
  me->receive_damage("sen", 50);
  me->start_call_out((: call_other, __FILE__, "hu", me, target :), random(5));
  return 1;
}

void hu(object me, object target) {
  string msg;
  int success_adj, damage_adj;
  success_adj = 30;
  damage_adj = 25;
  if (!me) return;
  if (!target || !living(target)
    || target->query("kee") < 300
    || target->query_temp("hu/number") <= 0
    || !me->is_fighting(target)) {
    msg = HIW "\n$N" HIW "哈哈大笑一声,收起了攻势,“$n" HIW "想要战胜我，还得多练几年！\n" NOR;
    message_vision(msg, me, target);
    me->command_function("surrender");
    me->remove_killer(target);
    target->remove_killer(me);
    me->set("kee", (int)me->query("max_kee"));
    me->set("eff_kee", (int)me->query("max_kee"));
    me->set("sen", (int)me->query("max_sen") + 50);
    me->set("eff_sen", (int)me->query("max_sen"));
    me->set("force", (int)me->query("max_force") * 2 + 250);
    me->set("mana", (int)me->query("max_mana") * 2);
    me->command_function("exert recover");
    me->command_function("exert refresh");
    me->delete_temp("hu");
    target->delete_temp("hu");
    return;
  }

  message_vision(HIW "\n$N" HIW "咆哮一声,合身而上,背后闪出白虎之气，仿佛张开血盆大口向$n" HIW "咬去！\n" NOR, me, target);
  if (random(3)) {
    message_vision(HIR "\n结果$n" HIR "被打了个正着！一口鲜血不由喷出！\n" NOR, me, target);
    target->receive_wound("kee", 500 + random(500), me);
    target->receive_damage("kee", 500 + random(500), me);
    COMBAT_D->report_status(target, random(2));
  } else message_vision(HIW "\n$n" HIW "连忙一侧身闪在一旁。\n" NOR, me, target);
  target->add_temp("hu/number", -1);
  me->start_call_out((: call_other, __FILE__, "hu", me, target :), random(5));
  return;
}
