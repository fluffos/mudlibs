//反白金虎口拳 fanhu.c
#include <ansi.h>
inherit SSERVER;

int perform(object me, object target) {
  int damage;
  string msg, s_msg, f_msg;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || !me->is_fighting(target))
    return notify_fail("你要对谁施展" HIW "反白金虎口拳" NOR " ？\n");

  if ((int)me->query("max_force") < 500)
    return notify_fail("你的内力不够！\n");

  if ((int)me->query("force") < 500)
    return notify_fail("你的内力不足！\n");

  if ((int)me->query("sen") < 300)
    return notify_fail("你的精神不足，没法子施用外功！\n");

  if ((int)me->query_skill("fengxue-quan", 1) < 100)
    return notify_fail("你的拳法修为还不够，使用这一招会有困难！\n");
  if (time() < me->query_temp("last_fanhu") + 3 + random(5))
    return 0;

  msg = HIB "\n$N" HIB "咆哮一声,合身而上,背后闪出白虎之气，仿佛张开血盆大口向$n" HIB "咬去！\n" NOR;
  s_msg = HIR "\n结果$n" HIR "被打了个正着！一口鲜血不由喷出！\n" NOR;
  f_msg = HIB "\n$n" HIB "连忙一侧身闪在一旁。\n" NOR;
  message_vision(msg, me, target);
  me->command("exert recover");
  me->command("exert refresh");

  me->set_temp("last_fanhu", time());
  if (random(target->query("kar")) < 30) {
    damage = me->query_skill("unarmed");
    damage += me->query_temp("apply/damage");
    damage += random(damage);
    message_vision(s_msg, me, target);
    target->receive_damage("kee", damage, me);
    COMBAT_D->report_status(target);
  } else {
    message_vision(f_msg, me, target);
    me->add_temp("last_fanhu", 3 + random(5));
  }

  if (target && (!living(target) || target->query("kee") < 500)) {
    msg = HIW "\n$N" HIW "哈哈大笑一声,收起了攻势,“$n" HIW "想要战胜我，还得多练几年！\n" NOR;
    message_vision(msg, me, target);
    me->command("surrender");
    me->remove_killer(target);
    target->remove_killer(me);
    me->set("kee", (int)me->query("max_kee"));
    me->set("eff_kee", (int)me->query("max_kee"));
    me->set("sen", (int)me->query("max_sen") + 50);
    me->set("eff_sen", (int)me->query("max_sen"));
    me->set("force", (int)me->query("max_force") * 2 + 250);
    me->set("mana", (int)me->query("max_mana") * 2);
  }
  return 1;
}
