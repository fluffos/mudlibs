//尼培尔根戒指 ring.c

#include <ansi.h>
#include <combat.h>

inherit SSERVER;
string *body=({
		"脖子","左手","右手","左腿","右腿","小腹","双眼",
});

int perform(object me, object target)
{
string msg,pot;
int extra,damage,wound;
int orforce;
object weapon;
pot=body[random(sizeof(body))];

if(me->is_busy())
	return notify_fail("你现在正忙着！！\n");

extra = me->query_skill("fengxue-quan",1);
damage=extra*3/2+random(extra*2);
wound=random(damage-100);

if (me->query("force")<300)
	return notify_fail(WHT"你内力不足，无法继续驾驭尼培尔根戒指。\n"NOR);

if((int)me->query_skill("unarmed", 1) <extra)
	return notify_fail(WHT"你的基本扑击格斗还不成熟。\n"NOR);

if( !target ) target = offensive_target(me);

if( !target
  ||!target->is_character()
  ||!me->is_fighting(target) )
	return notify_fail("［"HIG"尼培尔根戒指"NOR"］只能对战斗中的对手使用。\n");

weapon = me->query_temp("weapon");

msg = HIB"\n$N"HIB"脸上忽露痛苦之色，$n"HIB"尚在迟疑之际，$N"HIB"悲啸一声，仿佛换了个人一般对$n"HIB"发起攻击！\n"NOR;
message_vision(msg,me,target);

switch(random(10))
	{
	case 5 :
		{
		target->receive_damage("kee",damage);
		target->receive_wound("kee",damage*2/3);
		msg += HIB"\n$n"HIB"闪身纵开，看似躲开了这一击，怎料$N"HIB"手中的尼培尔根戒指忽地一闪！\n"NOR;
		msg += HIB"\n$n"HIB"立刻好似失魂落魄般心神一阵迷茫，哪里还躲得开$N"HIB"的致命一击！\n"NOR;
		msg+=HIB"\n"+COMBAT_D->damage_msg(damage, "内伤")+"\n"NOR;
		}
	break;

	case 8 :
		{
		msg += HIB"\n$n"HIB"闪身纵开，躲开了这一击。\n"NOR;
		}
	break;

	default:
		{
		msg += HIB"\n$n"HIB"闪身纵开，看似躲开了这一击，怎料$N"HIB"手中的尼培尔根戒指忽地一闪！\n"NOR;
		msg += HIB"\n一道红光闪向$n"HIB"！\n"NOR;
                target->receive_damage("kee",damage);
                target->receive_wound("kee", damage);
		msg=HIY"$n"HIY"躲闪不及,"+pot+"已经挨了一下，一时间鲜血淋漓!\n"NOR;
		msg+=COMBAT_D->damage_msg(damage, "内伤");
		}
	break;
	}
message_vision(msg,me,target);	
me->add("force", -200);
me->start_busy(1+random(2));
return 1;
}
