//九天游龙拳 long.c

#include <ansi.h>

inherit SSERVER;
void hu(object me,object target);

int perform(object me, object target)
{
int damage;
string msg;

                
if( !target ) target = offensive_target(me);

if( !target
 || !target->is_character()
 ||  target->is_corpse()
 ||  target==me)
	return notify_fail("你要对谁施展"HIC"九天游龙拳"NOR" ？\n");

if(!me->is_fighting())
	return notify_fail("「"HIC"九天游龙拳"NOR"」只能在战斗中使用！\n");

if((int)me->query("max_force") < 500 )
	return notify_fail("你的内力不够！\n");

if((int)me->query_temp("hu") )
	return notify_fail("「"HIC"九天游龙拳"NOR"」已经在使用！\n");

if((int)me->query("force") < 500 )
	return notify_fail("你的内力不足！\n");

if((int)me->query("sen") < 300 )
	return notify_fail("你的精神不足，没法子施用外功！\n");

if((int)me->query_skill("fengxue-quan", 1) < 100)
	return notify_fail("你的拳法修为还不够，使用这一招会有困难！\n");

msg = HIC"\n$N"HIC"提动真气,纵身跃起,仰头发出一阵龙吟般的长啸：“"HBBLU+HIR"九天游龙拳"NOR+HIC"”！\n"NOR;
if ( random(2)==1 )
	{
	msg+=HIR+@LONG
                                                 /===-_---~~~~~~~~~------____
                                                |===-~___                _,-'
                 -==\\                         `//~\\   ~~~~`---.___.-~~
             ______-==|                         | |  \\           _-~`
       __--~~~  ,-/-==\\                        | |   `\        ,'
    _-~       /'    |  \\                      / /      \      /
  .'        /       |   \\                   /' /        \   /'
 /  ____  /         |    \`\.__/-~~ ~ \ _ _/'  /          \/'
/-'~    ~~~~~---__  |     ~-/~         ( )   /'        _--~`
                  \_|      /        _)   ;  ),   __--~~
                    '~~--_/      _-~/-  / \   '-~ \	
                   {\__--_/}    / \\_>- )<__\      \	
                   /'   (_/  _-~  | |__>--<__|      | 	
                  |0  0 _/) )-~     | |__>--<__|      |	
                  / /~ ,_/       / /__>---<__/      |  
                 o o _//        /-~_>---<__-~      /	
                 (^(~          /~_>---<__-      _-~	
                ,/|           /__>--<__/     _-~   
             ,//('(          |__>--<__|     /                  .----_ 	
            ( ( '))          |__>--<__|    |                 /' _---_~\
         `-)) )) (           |__>--<__|    |               /'  /     ~\`\
        ,/,'//( (             \__>--<__\    \            /'  //        ||
      ,( ( ((, ))              ~-__>--<_~-_  ~--____---~' _/'/        /'
    `~/  )` ) ,/|                 ~-_~>--<_/-__       __-~ _/ 
  ._-~//( )/ )) `                    ~~-'_/_/ /~~~~~~~__--~ 
   ;'( ')/ ,)(                              ~~~~~~~~~~ 
  ' ') '( (/
    '   '  ` 
LONG+NOR;
	damage=(int)me->query_skill("fengxue-quan",1);
	damage=damage/2+random(damage/2);
        damage=damage*(1+random(3));
	damage=damage/2+random(damage/2);
	target->receive_damage("kee",damage);
	target->receive_wound("kee", damage/2);
        msg+=HIR+COMBAT_D->damage_msg(damage, "内伤")+NOR;
	}
else   msg+=HIC"\n$n"HIC"闪身躲开这一击!\n"NOR;

message_vision(msg,me,target);
me->add("force",-250);
me->start_busy(2+random(2));
return 1;
}
