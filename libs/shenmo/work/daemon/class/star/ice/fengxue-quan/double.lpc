// 凍結拳、熱壓拳 double.c
#include <ansi.h>
inherit SSERVER;

int perform(object me, object target)
{
        mixed t;
        int type,damage;
        string msg,f_msg,s_msg;
        
        if( !target ) target = offensive_target(me);

        if( !target
         || !target->is_character()
         ||  target->is_corpse()
         || !me->is_fighting(target) )
                return notify_fail(HIR"你要攻击谁？\n"NOR);
        if( time()<me->query_temp("last_double")+3+random(5) )
                return 0;
        if((int)me->query("force") < 300 )
                return notify_fail("你的内力不够！\n");

        me->add("force", -100-random(200));

        switch(random(2)) 
        {
                case 1: 
                        msg = HIW"\n$N双拳互击，然后猛的扑向$n"HIW"!一招["NOR+HBWHT+HIR"冷冻拳"NOR+HIW"]，把周围的一切似乎都冻住啦！\n" NOR;
                        s_msg = HIW"\n$n"HIW"冰冷的拳风笼罩全身，是进退两难！\n"NOR;
                        f_msg = HIW"\n$n"HIW"看准机会，趁着$N"HIW"招式的空隙，全身而退。\n" NOR;
                        type = 1;
                        break;
                default: 
                        msg = HIR"\n$N"HIR"双拳互击，然后猛的扑向$n"HIR"!一招["NOR+HBRED+HIW"热压拳"NOR+HIR"]，周围的一切似乎都被炽热的空气封住啦！\n" NOR;
                        s_msg = HIR"\n$n"HIR"被火热的拳风打了个正着！心神不禁一阵恍惚！\n"NOR;
                        f_msg = HIR"\n$n"HIR"不敢硬接这一招，连退数步，避开$N"HIR"这一雷霆一击。\n" NOR;
                        type = 2;
                        break;
        }
        
        damage = me->query_temp("apply/damage")+1;
        damage = damage/2+random(damage/2);
        
        message_vision(msg,me,target);
        me->set_temp("last_double",time());
        if( random(3) )
        {
                message_vision(s_msg,me,target);
                if( type==1 )
                {
                        t = target->query_busy();
                        target->start_busy(3+t);
                }
                else
                {       
                        target->receive_wound("kee", damage, me);
                        target->receive_damage("kee", damage, me);
                        COMBAT_D->report_status(target); 
                        COMBAT_D->report_status(target,1);
                }
        }
        else
        {
                message_vision(f_msg,me,target);
                me->start_busy(3);
        }        
        return 1;
}


