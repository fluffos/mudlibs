#include <ansi.h>
inherit SSERVER;


int perform(object me, object target) {
  string msg;
  int damage, p, time;
  if (!wizardp(me))
    return 0;
  if (!target)
    target = offensive_target(me);
  if (!target || !target->is_character())
    return notify_fail("「雷动九天」只能在战斗中使用。\n");
  if (time() < target->query_temp("no_cmd/start") + target->query_temp("no_cmd/time"))
    return notify_fail(target->name() + "已身不由己了。\n");

  message_vision(HIW "\n$N" HIW "念道真言，对着$n" HIW "喝道：封！！\n\n" NOR, me, target);
  target->set_temp("no_cmd", ([
    "start": time(),
    "time": 15,
    "msg": HIG "$N" HIG "只觉耳内一道声音在道：听" + me->name() + HIG "的话，什么也别做！\n" NOR,
  ]));
  return 1;
}
