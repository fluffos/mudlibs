#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int shanhu(object me,object target); 
  
int perform(object me, object target)
{
string msg;
int extra,my_pot,his_pot;
object weapon,where;

where = environment (me);  

if ( (int)where->query("shanhu") )
	return notify_fail("这儿已经是"HIR"死亡"HIG"珊瑚礁"NOR"了。\n");

if((int)me->query("max_force") < 300 )
	return notify_fail("你的内力不够！\n");

if((int)me->query("force") < 300 )
	return notify_fail("你的内力不足！\n");

if((int)me->query("sen") < 300 )
	return notify_fail("你的精神不足，没法子施用外功！\n");

extra = me->query_skill("haishen-quan",1);

if ( extra < 50) return notify_fail("你的海神拳法还不够纯熟！\n");

if( !target ) target = offensive_target(me);

if( !target
  ||!target->is_character()
  ||!me->is_fighting(target) )
	return notify_fail(HIR"死亡"HIG"珊瑚礁"NOR"只能对战斗中的对手使用。\n");

if (  environment(me)!=environment(target) )  
	return notify_fail("没有敌人!\n");

weapon = me->query_temp("weapon");
msg=HIM"\n$N"HIM"玉体轻摇,金莲微点,娇躯向后连退,同时双手舞动,幻化千万拳影！\n" NOR;
my_pot = me->query_temp("apply/damage");
my_pot += me->query_skill("dodge");
my_pot += me->query_skill("unarmed");
his_pot = target->query_temp("apply/armor");
his_pot += target->query_skill("dodge");
his_pot += target->query_skill("parry");

if ( random( my_pot ) > random( his_pot ) )
	{
	msg += HIM"\n$n"HIM"只觉眼前景象大变,无数珊瑚拔地而起!将$p"HIM"重重包围起来!\n"NOR;

	where->set("shorts",where->query("short") );
	where->set("longs",where->query("long"));
	where->set("exitss",where->query("exits") );

	where->set("short",HIB"珊瑚丛中"NOR);
	where->set("long","\n四周重重珊瑚交错纵横,难以看清方向!\n");
	where->set("exits",([ ]) );
       call_out("shanhu",1,me,target);
	}
else  { 
	msg += HIM"\n$n"HIM"知道其中有诈,停住攻势,$N"HIM"乘机发起猛烈的攻击!\n"NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),1+random(5));
	}
message_vision(msg,me,target);
//me->receive_damage("sen", 100);
me->add("force", -100);
me->start_busy(1+random(2));
return 1;
}

int shanhu(object me,object target)
{
string msg;
object where = environment (me);  
int skill = me->query_skill("spells");
skill = skill/50;
if ( skill<5) skill=5;
if ( skill>15 ) skill=15;

if( target && target->is_character()&& me->is_fighting(target) && where->query("shanhu")<skill )
	{
	msg = HIR " \n$n"HIR"一个不小心,浑身被珊瑚拌得鲜血淋漓,疼痛难忍!\n\n"NOR;
	message_vision(msg,me,target);
	where->add("shanhu",1);
	target->add("kee", -(150+random(350)));  
	target->add("sen", -(150+random(350)));  
	target->add("eff_kee", -(150+random(350)));  
	target->add("eff_sen", -(150+random(350)));  
	call_out("shanhu",1+random(2),me,target);
	}
else   {
       msg = HIW"\n$N"HIW"一阵攻击之后,收起了"NOR+HIB"死亡"HIM"珊瑚礁"NOR+HIW"!\n\n"NOR;
	message_vision(msg,me,target);
	where->set("short",where->query("shorts") );
	where->set("long",where->query("longs"));
	where->set("exits",where->query("exitss") );
	where->delete("shanhu");
	where->reset();
	return 1;
	}
}

