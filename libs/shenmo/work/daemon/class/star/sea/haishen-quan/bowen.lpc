#include <ansi.h>
//海马波纹
#include <combat.h>
inherit SSERVER;

int bowen(object me,object target); 
int remove_effect(object me);  

string *msgs=({  HIW"\n$n"HIW"被$N"HIW"的气势吓得心惊肉跳，乱了方寸!\n\n"NOR,
		HIY"\n$n"HIY"畏畏缩缩的战斗，一不小心，就自己打了自己一记!\n\n"NOR,
		HIB"\n$N"HIB"猛的一声打吼!$n"HIB"惊吓一下，一阵手忙脚乱！\n\n"NOR,
		HIG"\n$n"HIG"被$N"HIG"四周的气劲波及，不由自主的对自己发起了攻击!\n\n"NOR,
});
  
int perform(object me, object target)
{
string msg;
int extra,my_pot,his_pot;
object weapon,where;

where = environment (me);  

if ( me->query_temp("bowen") )
	return notify_fail(HIG"绝招用多就不灵了。\n"NOR);

if((int)me->query("max_force") < 300 )
	return notify_fail(HIG"你的内力不够！\n"NOR);

if((int)me->query("force") < 300 )
	return notify_fail(HIG"你的内力不足！\n"NOR);

if((int)me->query("sen") < 300 )
	return notify_fail(HIG"你的精神不足，没法子施用外功！\n"NOR);

extra = me->query_skill("haishen-quan",1);

if ( extra < 50) return notify_fail(HIG"你的"HIB"海神拳法"HIG"还不够纯熟！\n"NOR);

if( !target ) target = offensive_target(me);

if( !target
  ||!target->is_character()
  ||!me->is_fighting(target) )
	return notify_fail(HIC"海马波纹"HIG"只能对战斗中的对手使用。\n"NOR);

if (  environment(me)!=environment(target) )  
	return notify_fail(HIG"没有敌人!\n"NOR);

weapon = me->query_temp("weapon");
msg=HIC"\n$N"HIC"退后两步,马步站稳,一声大喝“海马波纹”！\n" NOR;
my_pot = me->query_temp("apply/damage");
my_pot += me->query_skill("dodge");
my_pot += me->query_skill("unarmed");
his_pot = target->query_temp("apply/armor");
his_pot += target->query_skill("dodge");
his_pot += target->query_skill("parry");

if ( random( my_pot ) > random( his_pot/2 ) )
	{
	msg += HIC"\n只见一股摄人的气势从$N"HIC"身上凛然而起！$n"HIC"见状，不由动作滞涩起来!\n"NOR;
       COMBAT_D->do_attack(target,target,target->query_temp("weapon"));
	target->set_temp("bowen",extra/30);
	target->start_busy(2);
	}
else  { 
	msg += HIC"\n$n"HIC"并不理会$N"HIC"，一言不发，只管战斗!\n"NOR;
	me->start_busy(2);
	}
message_vision(msg,me,target);
me->add("force", -100);
me->set_temp("bowen",1);
call_out("bowen",1,me,target);
}

int bowen(object me,object target)
{
string msg;
int skill;
if( me || !target || !me->is_fighting(target) ) return 0;
skill = me->query_skill("spells");
skill = skill/50;
if ( skill<5) skill=5;
if ( skill>15 ) skill=15;

if( me->is_fighting(target) && target->query_temp("bowen")> 0 )
	{
       msg = msgs[random(sizeof(msgs))];
	message_vision(msg,me,target);
       COMBAT_D->do_attack(target,target,target->query_temp("weapon"));
	target->add_temp("bowen",-1);
	target->add("kee", -(50+random(50)));  
	target->add("sen", -(50+random(50)));  
	target->add("eff_kee", -(50+random(50)));  
	target->add("eff_sen", -(50+random(50)));  
	target->start_busy(random(2));
	call_out("bowen",1+random(2),me,target);
	}
else   {
	msg = HIG"\n$N"HIG"散去海马波纹,四周摄人心魄的气势终于消失了......\n"NOR;
	message_vision(msg,me,target);
	me->delete_temp("bowen");  
	return 1;
	}
return 1;
}

