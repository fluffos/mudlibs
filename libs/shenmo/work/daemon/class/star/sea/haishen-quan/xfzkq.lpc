// 巴尔安---旋风真空拳

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target)
{
	int damage;

	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("你不在战斗中。\n");

	if( me->query("force") <= 600 )
		return notify_fail("你的内力不够！\n");

	if( me->query("sen") <= 300 )
		return notify_fail("你的精力不够！\n");

        if( target->is_busy() )
                return notify_fail(target->name()+"已经够忙了，你使的再漂亮也不会注意到。\n");



	if( !target || !me->is_fighting(target) ) return 0;

	if( !living(me) || me->is_ghost() ) return 0;

	if( !target || environment(me) != environment(target) || !me->is_fighting() ) return 0;


	damage = (int)me->query_skill("unarmed", 1);
	damage += (int)me->query_skill("force", 1);


	message_vision(HIW "\n$N右拳不断晃圈，速度越来越快，只见内劲缓缓聚集在$N右拳之上,形成了一道旋风。\n" NOR,me,target);
	message_vision(HIC "\n$N大喝一声：旋风真空拳，右拳猛的击出。\n"NOR,me,target);

         if( me->query("combat_exp")*6/10 > random(target->query("combat_exp")) ){

               message_vision(HIR"$n一个失神，已被袭来的旋风卷中，身形失控。\n"NOR,me,target);

	 	target->start_busy(2+random(2));

          }else{

              if( me->query("combat_exp")*6/10 > random(target->query("combat_exp")) ){

	  	   message_vision(HIR"$n眼见旋风袭来，急忙抽身而退，岂知旋风形成一阵真空，硬是将$n吸了过去。\n"NOR,me,target );
	 	target->start_busy(2+random(2));

                }else{
		      message_vision(HIG "$n乘着风势在旋风之中起起落落，毫发无伤。\n" NOR, me, target);
                    me->start_busy(2+random(2));}
          }

        me->add("force",-500);
            return 1;
}

         
