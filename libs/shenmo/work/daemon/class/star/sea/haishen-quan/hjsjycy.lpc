// 加隆---黄金三角异次元

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target) {
  int damage;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("你不在战斗中。\n");

  if (me->query("force") <= 600)
    return notify_fail("你的内力不够！\n");

  if (me->query("sen") <= 300)
    return notify_fail("你的精力不够！\n");


  if (!target || !me->is_fighting(target)) return 0;

  if (!living(me) || me->is_ghost()) return 0;

  if (!target || environment(me) != environment(target) || !me->is_fighting()) return 0;


  message_vision(HIY "\n$N右手在面前疾速划了几下，用内劲拟化出一个黄金三角体，只见$N右手一挥，三角体往$n缓缓飞来。\n" NOR, me, target);
  message_vision(HIY "$n只觉得此黄金三角体越变越大，到达面前时已是巨大无比，产生强烈的吸力将$n牵引过去。\n" NOR, me, target);

  if (random(me->query("combat_exp")) > target->query("combat_exp")) {

    message_vision(HIC "$n被吸力硬是扯了进去，只觉一阵晕旋，已到了另外一个地方。\n" NOR, me, target);

    target->move("/d/sds4/road13");

  } else {

    message_vision(HIG "$n急忙沉腰扎马，定住身形，大喝一声，一掌猛的将黄金三角体击散。\n\n" NOR, me, target);
  }

  me->add("force", -500);
  me->start_busy(2 + random(1));
  return 1;
}
