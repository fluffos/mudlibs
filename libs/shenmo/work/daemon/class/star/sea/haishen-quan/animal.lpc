// 斯基拉---圣兽之牙(魔鹰之牙，恶狼之牙，女王峰之刺，巨蟒之牙，吸血蝙蝠之牙，北极熊之爪)

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target)
{
	int damage,i;
       string *limbs;
       object weapon;

	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("你不在战斗中。\n");

	if( me->query("force") <= 600 )
		return notify_fail("你的内力不够！\n");

	if( me->query("sen") <= 300 )
		return notify_fail("你的精力不够！\n");


	if( !target || !me->is_fighting(target) ) return 0;

	if( !living(me) || me->is_ghost() ) return 0;

	if( !target || environment(me) != environment(target) || !me->is_fighting() ) return 0;


	damage = 1000+random(500);

       limbs=target->query("limbs");


       i=random(60);
//************************************************
       if (i<10) {

                    if( target->is_busy() )
                        return notify_fail(target->name()+"已经够忙了，你使的再漂亮也不会注意到。\n");

                    message_vision(HIB"\n$N大喝一声：魔鹰之喙。$n眼前一花，$N一跃腾空，仿若恶魔之鹰，往$n眼睛啄击而来。\n"NOR,me,target);

                    if( random(3)<2 ){

                        message_vision(HIR"$n一个躲闪不及，只觉得眼睛一阵剧痛，什么也看不见了。\n"NOR,me,target);
                        target->start_busy(2+random(2));

                    }else{
                           message_vision(HIG"$n急忙飞身而退，避过夺眼之险。\n"NOR,me,target);
                           me->start_busy(2+random(2));
                          }         
                   }
//************************************************

       if (i>9&&i<20)  {
                         message_vision(BLU"\n$N大喝一声：恶狼之牙。$n只觉得杀气扑面，$N已化做一头巨大恶狼，张着血盆大口往$n猛噬过来。\n"NOR,me,target);
                         if( random(3)<3 ){
                             message_vision(HIR"$n一不疏忽，被恶狼一口咬住咽喉，顿时血流而注，赶忙运劲招架，险被咬破喉咙。\n"NOR,me,target);
                             damage=1000+random(500);
                	 	  target->receive_damage("kee", damage);
		                target->receive_wound("kee", damage/2);
                              COMBAT_D->report_status(target);
                          
                          }else{
                               message_vision(HIG"$n急忙抽身而退，避过此招。\n"NOR,me,target);
                          }
                        me->start_busy(2+random(2));
                        }
                             
//*************************************************

       if (i>19&&i<30) {
                        message_vision(HIY"\n$N大喝一声：女王峰之刺。右手戟指往$n"+HIW+limbs[random(sizeof(limbs))]+HIY"猛刺而来。\n"NOR,me,target);
                        if( random(3)<2 ){

                            message_vision(HIC"$n一个躲闪不及，被刺个正着,身上多了个针孔般的小伤口，伤处不痛不痒。\n"NOR,me,target);
                            target->apply_condition("fengdu",5);
                        }else{
                             message_vision(HIG"$n深知此招厉害，左躲右闪总算避过了这招。\n"NOR,me,target);
                        }
                        me->start_busy(2+random(2));
                       }
                
//************************************************

       if (i>29&&i<40) {
                        if (!weapon=target->query_temp("weapon")) return 0;

                        message_vision(HIB"$N大喝一声：巨蟒之牙，右手成蛇状，迅疾往$n猛攻而来。\n"NOR,me,target);

                        if( random(3)<2 ){
                            message_vision(HIR"$n急忙用手中"+weapon->query("name")+HIR"攻去，只见$N右手随着"+weapon->query("name")+HIR"来势，一把将其夺了过来。\n"NOR,me,target);
                            weapon->unequip();
                            weapon->move(me);
                            target->reset_action();
                         }else{
                              message_vision(HIG"$n深知打蛇随棍上的道理，与$N互拼一掌，化去此招。\n"NOR,me,target);
                         }
                         me->start_busy(2+random(2));
                         } 
 
//************************************************

       if (i>39&&i<50) {
                        message_vision(HIB"\n$N大喝一声：吸血蝙蝠之牙,双手成爪，往$n的脖颈抓来。\n"NOR,me,target);
                        if( random(3)<2 ){
                            message_vision(HIR"$n急忙闪身，$N却不知道什么时候来到了身后，对准$n的脖子就是一爪。\n"NOR,me,target);
                            target->add("kee",-1500);
                            me->add("kee",1500);
                            if (me->query("kee")>me->query("max_kee")) me->set("kee",me->query("max_kee"));
                          }else{
                             message_vision(HIG"$n急忙一跃，凌空一个翻身，闪过此招。\n"NOR,me,target);
                          }
                         me->start_busy(2+random(2));
                        } 

//***********************************************

       if (i>49&&i<60) {
                        message_vision(HIW"\n$N大喝一声，北极熊之爪。$n眼前一花，眼前似乎出现了一头巨大的北极熊，猛的一爪打了过来。\n"NOR,me,target);
                         
                        if( random(3)<2 ){
                             message_vision(HIR"$n一个躲闪不及，被打了个正着，顿时鲜血狂喷。\n"NOR,me,target);
                             damage=2000;
	 	               target->receive_damage("kee", damage);
		               target->receive_wound("kee", damage/2);
                             COMBAT_D->report_status(target);
                          }else{
                             message_vision(HIG"$n急忙运劲招架，硬是架住了这一击。\n"NOR,me,target);  
                          }
                            me->start_busy(2+random(2));
                        }


        me->add("force",-500);
            return 1;
}

         
