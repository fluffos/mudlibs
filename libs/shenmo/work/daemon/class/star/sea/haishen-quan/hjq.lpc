// 克修拉---黄金枪

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target) {
  int damage;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("你不在战斗中。\n");

  if (me->query("force") <= 600)
    return notify_fail("你的内力不够！\n");

  if (me->query("sen") <= 300)
    return notify_fail("你的精力不够！\n");


  if (!target || !me->is_fighting(target)) return 0;

  if (!living(me) || me->is_ghost()) return 0;

  if (!target || environment(me) != environment(target) || !me->is_fighting()) return 0;


  damage = 1000 + random(500);

  message_vision(HIY "\n$N右手虚空一握，手中豁然出现了一把金光闪闪的黄金枪。\n" NOR, me, target);

  message_vision(HIY "\n$N大喝一声将手中黄金枪脱手掷出，在空中高低左右回旋。\n", me, target);

  me->set_temp("hjq", 1);

  call_out("check_fight", 1, me, target);

  return 1;
}

void check_fight(object me, object target) {
  string *limbs, limb, result, str, type;
  int damage;

  if (!me || !target || !me->is_fighting(target)) return;
  me->reset_action();

  if (me->query_temp("hjq") >= 5) {
    call_out("remove_attack", 1, me);
  } else if (me->is_fighting() && me->query_temp("hjq")) {
    limbs = target->query("limbs");
    limb = limbs[random(sizeof(limbs))];

    message_vision(HIR "\n突然间黄金枪自行向$N的" + limb + "猛然飞撞过去！\n" NOR, target);

    if (me->query("combat_exp") * 6 / 10 > random(target->query("combat_exp"))) {

      damage = 500;
      target->receive_damage("kee", damage);
      target->receive_wound("kee", damage / 2);
      COMBAT_D->report_status(target);

    } else {
      message_vision(HIG "$N看得分明，身形一让，避过了这招！\n" NOR, target);
    }

    message_vision(HIC "\n$N猛吸一口气，飘身赶上,伸掌在枪尾一推，将其又推在半空飞旋。\n\n" NOR, me);

    me->add_temp("hjq", 1);
    me->start_busy(2);
    me->add("force", -100);
    call_out("check_fight", 2, me, target);
  } else {
    call_out("remove_attack", 1, me);

  }
}

int remove_attack(object me) {
  remove_call_out("check_fight");
  if (!me) return 1;
  me->delete_temp("hjq");

  if (living(me)) {
    message_vision(HIY "\n$N纵身上前，将飞旋的枪收回。\n\n" NOR, me);
  } else {
    message("vision", "只听得锵的一声，黄金枪力尽由半空消失了。\n", me);
  }

  return 1;
}
