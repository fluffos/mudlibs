//Cracked by Snowtu

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  object weapon;
  int i;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这一招「" HIG "飓风海啸拳" NOR "」？\n");

  if (!me->is_fighting())
    return notify_fail("「" HIG "飓风海啸拳" NOR "」只能在战斗中使用！\n");

  if ((int)me->query("max_force") < 500)
    return notify_fail("你的内力不够！\n");

  if ((int)me->query("force") < 500)
    return notify_fail("你的内力不足！\n");

  if ((int)me->query("sen") < 500)
    return notify_fail("你的精神不足，没法子施用外功！\n");

  i = (int)me->query_skill("haishen-quan", 1) + (int)me->query_kar();

  if (i < 150)
    return notify_fail("你的拳法级别还不够，使用这一招会有困难！\n");

  if ((int)me->query_temp("wind"))
    return notify_fail("绝招用的太多太滥就不灵了。\n");

  message_vision(HIG "\n$N" HIG "运聚精神，一声大吼,背后卷起一阵飓风,带起千层海浪,朝$n" HIG "迎面击来！\n" NOR, me, target);

  me->delete("env/brief_message");
  target->delete("env/brief_message");

  me->set_temp("wind", 1);
  me->add_temp("apply/damage", 300);
  me->add_temp("apply/dodge", 200);
  me->add_temp("apply/armor", 500);
  me->add_temp("apply/parry", 200);
  me->add_temp("apply/attack", 300);

  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  me->add("force", -200);

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }

  //me->start_busy(2)
  me->set_temp("no_move", 1);
  call_out("remove_effect", 8 + random(5), me);
  call_out("remove_no_move", 1, me);
  return 1;
}

void remove_effect(object me) {
  if (!me) return;
  me->delete_temp("wind");
  if (me->query("kee") < me->query("eff_kee")) me->set("kee", (int)me->query("eff_kee"));
  if (me->query("sen") < me->query("eff_sen")) me->set("sen", (int)me->query("eff_sen"));
  me->clean_condition();
  if (me->is_busy()) me->start_busy(0);
  me->add_temp("apply/damage", -300);
  me->add_temp("apply/attack", -300);
  me->add_temp("apply/dodge", -200);
  me->add_temp("apply/parry", -200);
  me->add_temp("apply/armor", -500);
  message_vision(HIG "\n$N" HIG "静静平复气血,收起了拳势......\n" NOR, me);
}

void remove_no_move(object me) {
  if (me) me->delete_temp("no_move");
}
