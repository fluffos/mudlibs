//雷电神爪zap.c
#include <ansi.h>
inherit SSERVER;

int perform(object me, object target) {
  string msg;
  int damage;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || !me->is_fighting(target))
    return notify_fail("你要对谁施展雷电神爪？\n");

  if ((int)me->query("force") < 100)
    return notify_fail("你的内力不够！\n");

  me->add("force", -100);


  msg = HIY "$N" HIY "蓄势微蹲，猛的腾空跃起!半空中变拳为爪,十指之上微微凝聚蓝白电花!\n只见他一声怪叫，居高临下，双爪带着雷电之声朝$n" HIY "直抓而来！\n" NOR;
  if (random(target->query("kar")) < 25) {
    damage = 500;
    damage += me->query_temp("apply/damage");
    damage += random(damage * 3 / 2);
    msg += HIY "$n" HIY "闪避不及,惨叫中已中一击,伤处一片焦黑！\n" NOR;
    message_vision(msg, me, target);
    target->receive_wound("kee", damage / 2, me);
    target->receive_damage("kee", damage, me);
    target->receive_wound("sen", damage / 2, me);
    target->receive_damage("sen", damage / 2 * 3, me);
    COMBAT_D->report_status(target, 1);
    COMBAT_D->report_status(target);
    COMBAT_D->report_sen_status(target, 1);
    COMBAT_D->report_sen_status(target);
    me->start_busy(1 + random(3));
  } else {
    msg += HIY "$n" HIY "一式“四两拨千斤”顺势将$N" HIY "的攻击卸在一旁！\n" NOR;
    message_vision(msg, me, target);
    me->start_busy(2 + random(5));
  }
  return 1;
}
