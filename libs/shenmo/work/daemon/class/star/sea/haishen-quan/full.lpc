#include <ansi.h>

inherit F_DBASE;
inherit SSERVER;

void remove_effect(object me);

int perform(object me, object target) {
  int skill = (int)me->query_skill("haishen-quan", 1);
  skill = 1000 - skill;
  skill = skill / 40;
  if (skill < 5) skill = 5;
  if (skill > 15) skill = 15;

  if ((int)me->query("force") < 50)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_temp("powerup"))
    return notify_fail("你已经在运功中了。\n");
  if ((int)me->query("kee") >= (int)me->query("max_kee") / 2)
    return notify_fail("现在不是时候。\n");

  me->add("force", -50);
  random(2) ? me->command_function("chat 燃烧吧，小宇宙！\n") : me->command_function("chat 小宇宙！爆发吧！\n");

  switch (random(10)) {
    case 1:
      {
        me->set("kee", (int)me->query("max_kee"));
        me->set("eff_kee", (int)me->query("max_kee"));
        me->set("sen", (int)me->query("max_sen"));
        me->set("eff_sen", (int)me->query("max_sen"));
        me->set("force", (int)me->query("max_force") * 2);
        me->set("mana", (int)me->query("max_mana") * 2);
        me->clean_condition();
      }
      break;
    case 2:
      {
        me->set("eff_kee", (int)me->query("max_kee"));
        me->clean_condition();
        me->command_function("exert refresh");
        me->command_function("exert recover");
      }
      break;
    case 3:
      {
        me->set("force", (int)me->query("max_force") * 2);
        me->set("mana", (int)me->query("max_mana") * 2);
        me->clean_condition();
        me->command_function("exert refresh");
        me->command_function("exert recover");
      }
      break;
    default:
      {
        me->set("force", (int)me->query("max_force") * (1 + random(1)));
        me->clean_condition();
        me->command_function("exert refresh");
        me->command_function("exert recover");
      }
      break;
  }

  me->set_temp("powerup", 1);
  me->start_call_out((: call_other, __FILE__, "remove_effect", me :), skill);
  return 1;
}

void remove_effect(object me) {
  me->delete_temp("powerup");
  random(2) ? me->command_function("sweat") : me->command_function("heihei");
}
