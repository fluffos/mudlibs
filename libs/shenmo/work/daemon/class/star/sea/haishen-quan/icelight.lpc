//寒冷的极光 icelight.c

#include <ansi.h>
inherit SSERVER;
#include "/daemon/skill/eff_msg.h";

int perform2(object me, object target);
int def;
int perform(object me, object target) {
  string msg;
  int damage, p, time;
  if (!target) target = offensive_target(me);
  if (!target || !target->is_character()
    || !me->is_fighting(target) || !living(target))
    return notify_fail(HBBLU + HIW "「寒冷的极光」只能在战斗中使用。\n" NOR);
  if (target->is_busy()) notify_fail(HIW + target->query("name") + HBBLU + HIW "已经被雪封住了。\n" NOR);
  if ((int)me->query_skill("haishen-quan", 1) < 100 ||
    (int)me->query_skill("unarmed", 1) < 100
  )
    return notify_fail("你有的功夫还不够娴熟，不会使用「寒冷的极光」。\n");
  if (me->query_skill("force", 1) < 100)
    return notify_fail("以你现在的内功修为还使不出「寒冷的极光」。\n");
  if (me->query_skill_mapped("unarmed") != "haishen-quan")
    return notify_fail("你现在无法使用「寒冷的极光」进行攻击。\n");
  if ((int)me->query("max_force") < 1200)
    return notify_fail("你的内力修为太弱，不能使用「寒冷的极光」！\n");
  if ((int)me->query("force") < 600)
    return notify_fail("你的真气不够！\n");
  msg = HBBLU + HIW "\n 突然$N大喝一声:「极光」,面色唰的变得惨白,浑身上下充满冰寒之气,\n";
  message_vision(msg, me, target);
  msg = HBBLU + HIW "$n" NOR + HBBLU + HIW "周围立刻变成冰天雪地！\n";
  if (random(me->query("combat_exp")) > random((target->query("combat_exp") / 5))) {
    msg += HBBLU + HIW "风雪咆哮，$n浑身上下立刻积满了雪霜，动作立刻变得迟钝起来。\n" NOR;
    target->start_busy(3 + random(2));
    me->add("force", -100);
    if (me->query_skill("haishen-quan", 1) > 119)
      perform2(me, target);
  } else {
    me->start_busy(2);
    me->add("force", -200);
    msg += HBBLU + HIW "$p立刻催动真元，驱挡住寒意。\n" NOR;
  }
  message_vision(msg, me, target);
  return 1;
}

int perform2(object me, object target) {
  string msg, weapon;
  if (!me || !target || !living(me) || !me->is_fighting(target))
    return 1;
  weapon = me->query_temp("weapon");
  if (!living(target))
    return notify_fail("对手已经不能再战斗了。\n");
  if ((int)me->query("force", 1) < 300)
    return notify_fail("你待要再出第二击，却发现自己的内力不够了！\n");
  msg = HBBLU + HIW "\n$N小宇宙越烧越烈，瞑目蓄劲，四周的一切仿佛都停顿了。\n";
  msg += HBBLU + HIW "$N忽然睁开双眼，眸中透出万层的寒意！$P摆动双手又发出凌厉的连击！！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  return 1;
}
