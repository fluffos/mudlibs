#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int music(object me,object target); 
  
int perform(object me, object target)
{
string msg;
int extra,my_pot,his_pot,skill;
object weapon;

if( !target ) target = offensive_target(me);

if( !target
  ||!target->is_character()
  ||!me->is_fighting( ) )
	return notify_fail(HIR"死亡交响曲"NOR"只能对战斗中的对手使用。\n");

if((int)me->query("max_force") < 300 )
	return notify_fail("你的内力不够！\n");

if((int)me->query("force") < 300 )
	return notify_fail("你的内力不足！\n");

if((int)me->query("sen") < 300 )
	return notify_fail("你的精神不足，没法子施用外功！\n");

extra = me->query_skill("haishen-quan",1);

if ( extra < 50) return notify_fail("你的海神拳法还不够纯熟！\n");

if ( (int)target->query_temp("music") )
	return notify_fail("敌人已经中了死亡交响曲。\n");

weapon = me->query_temp("weapon");
msg=HIR"\n$N"HIR"眸中寒芒一闪,从背后抽出法宝:"NOR HIB"魔笛"NOR HIR",奏出一曲『死亡交响曲』!\n" NOR;
my_pot = me->query_temp("apply/damage");
my_pot += me->query_skill("dodge");
my_pot += me->query_skill("unarmed");
his_pot = target->query_temp("apply/armor");
his_pot += target->query_skill("dodge");
his_pot += target->query_skill("parry");

if ( random( my_pot ) > random( his_pot ) )
	{
	msg += HIR"\n$n"HIR"只觉心中一股怨气直冲天灵,心神立刻似波涛般难以平复!\n"NOR;
	skill=extra/10;
	target->set_temp("music",skill);
       call_out("music",1,me,target);
	}
else  { 
	msg += HIR"\n$n"HIR"知道是$N的怪招,勉强压制心神,$N"HIM"乘机发起猛烈的攻击!\n"NOR;
        COMBAT_D->do_attack(target,me, target->query_temp("weapon"),1+random(5));
	}
message_vision(msg,me,target);
me->add("force", -100);
me->start_busy(1+random(2));
return 1;
}

int music(object me,object target)
{
string msg;
object where;
int skill;
if( !me || !target || !me->is_fighting(target) ) return 1;
where = environment (me);  
skill = me->query_skill("spells");
skill = skill/50;
if ( skill<5) skill=5;
if ( skill>15 ) skill=15;

if( target && target->is_character()&& me->is_fighting(target) && target->query_temp("music")>skill )
	{
	msg = HIR " \n$n"HIR"心神一颤,神情不由越加恍惚!\n\n"NOR;
	message_vision(msg,me,target);
	target->add_temp("music",-1-random(9));
	target->add("sen", -(250+random(350)));  
	target->add("eff_sen", -(250+random(350)));  
	call_out("music",1+random(2),me,target);
	}
else   {
       msg = HIR"\n$n"HIR"战罢多时,方从$N的笛音中挣扎出来!\n\n"NOR;
	message_vision(msg,me,target);
	target->delete_temp("music");
	return 1;
	}
}

