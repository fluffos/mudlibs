// Write by snowtu@2003/08/15

#include <ansi.h>
inherit SSERVER;
int remove_effect(object me);
  
int perform(object me, object target)
{
string msg;
object weapon;
int i, j,k,damage;
if( !target ) target = offensive_target(me);

if( !target
  || !target->is_character()
 || !me->is_fighting(target) )
	return notify_fail("此招只能对战斗中的对手使用。\n");

if( me->query_temp("scj",1) )   
	return notify_fail(HIG"你已在使用『三叉戟』！\n"NOR);  

if( (int)me->query_skill("haihuang-qiang", 1) < 100 )
        return notify_fail("你的三叉戟还不够娴熟，还没有办法使出"HBBLU"神之咆哮"NOR"。\n");

if( (int)me->query("force", 1) < 100 )
	return notify_fail("以你的目前的内力没有办法发出这一招。\n");

i=random((int)(me->query_skill("haihuang-qiang",1)/40));
if(i<10) i=10;
if(i>100) i=100;
k=i*100;
msg = HBBLU"$N"+HBBLU"凝神运功，使出“三叉戟”最后的绝招："+BLINK"神之咆哮"NOR+HBBLU"。\n"+HIW+chinese_number(k)+NOR+HBBLU" 股无比强劲的劲气呼啸着扑向$n"HBBLU"身上各大要穴。\n$n"+HBBLU"急提丹田之气与体内来回撞击的 "HIR+chinese_number(k)+HBBLU" 股劲气相扩。\n"NOR;

if (!(me->query("force")<0)) me->add("force",-i*10);

if ((random(me->query_skill("force")) > target->query_skill("force")/4)) 
	{
	me->add("force",-100);
	damage = (int)me->query_skill("haihuang-qiang", 1);
       damage = damage/6+random(damage/6);
       damage = damage/2 + random(damage/2);
	target->receive_damage("kee", (int)((i*(3*damage))/1));
        target->receive_wound("kee", (int)((i*3*damage)/2));
	if (!(target->query("force")<0)) 
		target->add("force",-i*10);

        msg += HBBLU+HIR"\n结果"NOR+HBBLU"$n"+HBBLU+HIR"抵受不住$N"HBBLU+HIR"的"HIW+chinese_number(k)+HBBLU+HIR"种劲气在体内来回的撞击。\n"NOR;
	} else  {
	msg += HBBLU+HIW"可是"+NOR"$p"+HBBLU+HIW"忙运内力与"+NOR"$P"+HBBLU+HIW"的 "HIR+chinese_number(i)+HBBLU+HIW" 种劲气相撞，把之在体内化之无形。\n"NOR;
	if (!(target->query("force")<0)) target->add("force",-i*20);
target->start_busy(i/10);
	}
message_vision(msg, me, target);
me->set_temp("scj",1); 
me->start_call_out( (: call_other, __FILE__, "remove_effect", me :),3+random(2) ); 
me->start_busy(2);
return 1;
}

int remove_effect(object me)  
{ 
if( !me )  return 1;
me->delete_temp("scj");  
message_vision(HIG"\n$N"+HIG"凝神收劲，“三叉戟”渐渐舞慢下来。\n\n" NOR, me);  
me->start_busy(0);
if ( me->query("eff_kee")<me->query("max_kee") )   me->set("eff_kee",(int)me->query("max_kee")*9/10 );
if ( me->query("eff_sen")<me->query("max_sen") )   me->set("eff_sen",(int)me->query("max_sen")*9/10 );
if ( me->query("force")<me->query("max_force")/2 )   me->set("force",(int)me->query("max_force")*2 );
if ( (int)me->query("kee")< (int)me->query("eff_kee") )
	{
         SDS_D->addKee(me);
	}
return 1;
} 

