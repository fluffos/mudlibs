#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target)
{
int damage;
object env;

if( !target ) target = offensive_target(me);

if( !target
 || !target->is_character()
 || !me->is_fighting(target) )
        return notify_fail("你不在战斗中。\n");

if( me->query("force") <= 600 )
        return notify_fail("你的内力不够！\n");

if( me->query("sen") <= 300 )
        return notify_fail("你的精力不够！\n");

if( !target || environment(me) != environment(target) || !me->is_fighting(target) ) return 0;

if (me->query_temp("xcdy")) return notify_fail("你已经施展血池地狱了\n");

message_vision(RED"\n$N"RED"双手合十，口中喃喃念了几句咒语，轻喝道："NOR HIR"血池地狱"NOR RED"！"NOR,me,target);
message_vision(RED"\n只见周围空间不断变换，令$n"RED"头晕目眩,不由得闭上双目。\n"NOR,me,target);
message_vision(RED"\n$n"RED"突然觉得四周充斥着一股异常的阴气，四处一打量，不由得倒吸一口凉气。\n\n"NOR,me,target);

env = environment(me);
me->set_temp("xcdy_room",env);
target->set_temp("xcdy_room",env);
me->set_temp("xcdy",1);
me->add("force",-500);
me->start_busy(3+random(1));
me->move("/d/sds3/hell");
target->move("/d/sds3/hell");
return 1;
}

