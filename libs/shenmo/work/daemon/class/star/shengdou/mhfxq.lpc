// 双子---魔皇粉星拳

#include <ansi.h>
#include <combat.h>

inherit SSERVER;
int perform(object me, object target) {
  string msg, *limbs;
  int i, size, damage;
  object target_w;


  if (!target) target = offensive_target(me);


  if (target->is_busy())
    return notify_fail(target->name() + "目前正茫然不知所措，加紧攻击吧。\n"
    );

  if ((int)me->query("force") < 300)
    return notify_fail("你的内力不够。\n");

  me->add("force", -200);

  target_w = target->query_temp("weapon");

  if (target->query_temp("weapon") || target->query_temp("secondary_weapon")) {

    message_vision(HIB "$N缓缓举起右臂，屈指成拳，拳头上突然发出一阵奇异光芒。\n" NOR, me, target);
    message_vision(
      HIC "$N口中喃喃念道：魔皇粉星拳，一挺右臂，右拳以不可思议的高速往$n手中的" + target_w->query("name") + HIC "击去！\n" NOR,
      me,
      target
    );


    if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 3) {


      message_vision(HIY "结果$n手中的" + target_w->query("name") + "被$N一拳击个粉碎!\n\n" NOR, me, target);
      message_vision(
        HIC "$N右拳又是一挥，" + target_w->query("name") + HIC "的碎片受$N劲力牵引化做万千流星，往$n激射而去。\n" NOR,
        me,
        target
      );

      target_w->unequip();
      target_w->move(environment(target));
      target_w->set("name", target_w->query("name") + "的碎片");
      target_w->set("value", target_w->query("value") / 10);
      target_w->set("weapon_prop", 0);
      target->reset_action();
      limbs = target->query("limbs");


      damage = 100 + random(100);
      size = random(10);
      if (size < 3) size = 3;
      for (i = 0; i <= size; i++) {
        msg = HIR "\n“嗤”，碎片射入$n" + limbs[random(sizeof(limbs))] + "！\n" NOR;

        message_vision(msg, me, target);

        target->receive_damage("kee", damage, me);
        target->receive_wound("kee", damage / 3, me);
        COMBAT_D->report_status(target);

      }

    } else {
      message_vision(HIG "可是$n急忙将自己的兵刃闪开，使得$N一拳击空。\n" NOR, me, target);
    }
    return 1;
  }
  return notify_fail(target->name() + "目前是空手，你想砸什么？\n");
}
