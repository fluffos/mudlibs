// 教皇幻魔拳

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target) {
  int damage, i;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("你不在战斗中。\n");

  if (me->query("force") <= 600)
    return notify_fail("你的内力不够！\n");

  if (me->query("sen") <= 300)
    return notify_fail("你的精力不够！\n");

  i = random(29);

  if (target->is_busy()) i = random(19);

  if (!target || !me->is_fighting(target)) return 0;

  if (!living(me) || me->is_ghost()) return 0;

  if (!target || environment(me) != environment(target) || !me->is_fighting()) return 0;


  message_vision(BLU "\n突然邪恶之气大盛，$n顿觉四周阴风刺骨，鬼哭狼嚎声不绝于耳，如坠修罗地狱！\n" NOR, me, target);

  message_vision(MAG "$N面带狞笑，右拳携着一团黑气轻飘飘地望$n直击而来。\n\n", me, target);

  if (me->query("combat_exp") * 6 / 10 > random(target->query("combat_exp"))) {

    message_vision(HIC "$n只觉$N此招拳速太慢，正欲抢攻，$N右拳突然加速，一拳正中$n胸口。\n" NOR, me, target);


    if (i < 10) {
      message_vision(HIY "以前种种不快沥沥在目，强大的刺激使得$n如被重锤敲击,连退数步，方才缓过气来。\n" NOR, me, target);
      damage = 500 + random(500);
      target->receive_damage("sen", damage);
      target->receive_wound("sen", damage / 3);
      me->start_busy(3 + random(3));
    }

    if (i < 20 && i > 9) {
      message_vision(HIR "没想到$N轻飘飘的一拳竟有如此大的威力，$n口鼻鲜血直喷，硬生生被打退数丈。\n" NOR, me, target);
      damage = 500 + random(1000);
      target->receive_damage("kee", damage);
      target->receive_wound("kee", damage / 2);
      COMBAT_D->report_status(target);
      me->start_busy(3 + random(3));
    }

    if (i > 19 && i < 30) {
      message_vision(HIB "黑气甫一沾身，便疾速窜入$n体内。$n全身剧震，赶忙运劲抵抗入侵的黑气。\n" NOR, me, target);
      target->start_busy(3 + random(3));
      me->start_busy(1 + random(1));
    }
  } else {
    message_vision(HIG "$n刚欲侧身闪避，$N右拳突然加速，$n急忙一个驴打滚往侧一翻险险闪过此招。\n" NOR, me, target);
    me->start_busy(3 + random(3));
  }

  me->add("force", -500);
  return 1;
}
