// 双鱼---黑玫瑰

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target) {
  int damage;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("你不在战斗中。\n");

  if (me->query("force") <= 600)
    return notify_fail("你的内力不够！\n");

  if (me->query("sen") <= 300)
    return notify_fail("你的精力不够！\n");


  if (!target || !me->is_fighting(target)) return 0;

  if (!living(me) || me->is_ghost()) return 0;

  if (!target || environment(me) != environment(target) || !me->is_fighting()) return 0;


  damage = 1000 + random(500);

  message_vision(HIB "\n$N右手一晃，手中突然出现一朵闪着黑色光泽的玫瑰！" NOR, me, target);

  message_vision(HIM "\n$N动作优雅的将手中玫瑰抛出，玫瑰划出一道美妙的弧线，往$n手中落下。\n\n", me, target);

  message_vision(HIC "黑玫瑰缓缓掉落，突然间，速度猛增，往$n激射过去。\n\n" NOR, me, target);


  if (me->query("combat_exp") * 6 / 10 > random(target->query("combat_exp"))) {

    message_vision(HIR "$n一个闪避不及，被玫瑰扎中气海穴，内力狂泻而出。\n\n" NOR, me, target);

    target->add("force", -2000);
    if (target->query("force") < 0) target->set("force", 0);

  } else {

    message_vision(HIG "$n挥手打出一股气劲，将黑玫瑰一下击落。\n" NOR, me, target);
  }

  me->add("force", -500);
  me->start_busy(3 + random(1));
  return 1;
}
