// 金牛---黄金野牛拳

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target)
{
	int damage;

	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("你不在战斗中。\n");

	if( me->query("force") <= 600 )
		return notify_fail("你的内力不够！\n");

	if( me->query("sen") <= 300 )
		return notify_fail("你的精力不够！\n");


	if( !target || !me->is_fighting(target) ) return 0;

	if( !living(me) || me->is_ghost() ) return 0;

	if( !target || environment(me) != environment(target) || !me->is_fighting() ) return 0;


	damage = (int)me->query_skill("unarmed", 1);
	damage += (int)me->query_skill("force", 1);


	message_vision(HIY "\n$N双腿一弯，蹲下身来，一声大吼：黄金野牛拳，运起浑身劲力，右拳带着无匹的劲力往$n击去。\n这一击实乃$N毕生功力之所聚，$n猛然感受到万牛斗冲般的劲力袭来。\n" NOR,me,target);
	
         if( me->query("combat_exp")*6/10 > random(target->query("combat_exp")) ){

               message_vision(HIR"突闻$n前胸一片骨裂之声，已被$N一拳击中，哼也哼不出一声，仰身向后跌退，脸如白纸，端的是生死难料。\n"NOR,me,target);

	 	target->receive_damage("kee", damage);
		target->receive_wound("kee", damage/2);
              COMBAT_D->report_status(target);

          }else{
		message_vision(HIG "$n眼见这一击来势凶猛，挡既不能，避又不可，当下双足一点，跃高四尺，躲开了这一击。\n只听身後腾的一声大响，$N这一拳的劲力激起一股狂风巨浪，顿时尘土纷扬，令人惊骇不已。\n\n" NOR, me, target);}



       message_vision(HIY "\n$N第一击刚使完，第二击又已迅速异常的赶到，前劲未衰，后劲继至，拳风越发猛烈。\n" NOR,me,target);

         if( me->query("combat_exp")*6/10 > random(target->query("combat_exp")) ){

		message_vision(HIR"只听$N一声惨叫，这一拳正中小腹。但见$n一个身躯突然平平飞出，腾的一响，尘土飞扬，跌在丈许之外。\n\n"NOR, target,target );
	 	target->receive_damage("kee", damage);
		target->receive_wound("kee", damage/2);
              COMBAT_D->report_status(target);

           }else{
		 message_vision(HIG "$n眼见这一拳气势汹汹，当下双足一点，侧跃三尺，躲开了这一击。\n只听轰的一声巨响，猛劲激得灰泥弥漫，又是一片尘土飞扬，声势惊人。\n" NOR, me, target);}


        me->add("force",-500);
        me->start_busy(2+random(1));
            return 1;
}

         
