// 双鱼---魔宫玫瑰

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target)
{
	int damage,num,i;
       string *limbs;


	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("你不在战斗中。\n");

	if( me->query("force") <= 600 )
		return notify_fail("你的内力不够！\n");

	if( me->query("sen") <= 300 )
		return notify_fail("你的精力不够！\n");


	if( !target || !me->is_fighting(target) ) return 0;

	if( !living(me) || me->is_ghost() ) return 0;

	if( !target || environment(me) != environment(target) || !me->is_fighting() ) return 0;


	damage = 200+random(200);

       message_vision(HIM "\n$N右手一晃，手中突然出现一朵闪着奇异光泽的玫瑰！" NOR, me,target);

       message_vision(HIM"\n$N动作优雅的将手中玫瑰抛出，玫瑰划出一道美妙的弧线，往$n手中落下。\n\n",me,target);

       message_vision(HIC"$n不明此理，正欲将玫瑰甩开，突然间玫瑰花瓣片片散开，疾射而来。\n\n"NOR,me,target);

       num=random(5);
       if (num<2) num=2;
       limbs=target->query("limbs");


       for (i=0;i<num;i++){

         if( me->query("combat_exp")*6/10 > random(target->query("combat_exp")) ){

              message_vision(HIR"\n$n闪避不及，被花瓣打中"+limbs[random(sizeof(limbs))]+HIR",割开一长道伤口。\n\n"NOR,me,target);

	 	target->receive_damage("kee", damage);
		target->receive_wound("kee", damage/2);
              COMBAT_D->report_status(target);

          }else{
              
             message_vision(HIG"\n$n急忙闪身，躲开玫瑰花瓣的攻击。\n"NOR,me,target);
               }
        }  

        me->add("force",-500);
        me->start_busy(3+random(1));
            return 1;
}

         
