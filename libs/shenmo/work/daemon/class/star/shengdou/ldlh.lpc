// 处女---六道轮回

#include <ansi.h>
#include <combat.h>

inherit SSERVER;


int perform(object me, object target)
{
	int damage;

	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("你不在战斗中。\n");

	if( me->query("force") <= 600 )
		return notify_fail("你的内力不够！\n");

	if( me->query("sen") <= 300 )
		return notify_fail("你的精力不够！\n");


	if( !target || !me->is_fighting(target) ) return 0;

	if( !living(me) || me->is_ghost() ) return 0;

	if( !target || environment(me) != environment(target) || !me->is_fighting() ) return 0;


	damage = 400;

       message_vision(HIY "\n$N突然全身暴起金光，双手一挥，喝道：六道轮回！" NOR, me,target);

       message_vision(HIW"\n$n只觉得眼前的场景逐渐模糊起来。\n\n"NOR,me,target);
   
       me->start_busy(1);
       target->start_busy(1);
       call_out("ldlh1",1,me,target);
            return 1;
}

int ldlh1(object me,object target)
{         
             if( !me || !target || !me->is_fighting(target) || !living(me) )   return 1;
       message_vision(HIY"  天道：\n"NOR,me,target);
       message_vision(HIG"天，有自然的意思，可以随身，思衣得衣，思食得食，享受自然的快乐，而且清净光洁，最胜最尊，所以称为天。\n\n"NOR,me,target);

       if (target->query("dntg/number")){
              message_vision(HIR"一入此道，$n自觉罪孽深重，不禁黯然涕下。\n\n"NOR,me,target);
	 	target->receive_damage("sen", 200);
		target->receive_wound("sen", 100);
              }
       else {
             message_vision(HIW"一入此道，$n顿觉神清气顺，精神抖擞。\n\n"NOR,me,target);
             target->add("sen",100);
             }

       me->start_busy(1);
       target->start_busy(1);
       call_out("ldlh2",1,me,target);
       return 1;
}

int ldlh2(object me,object target)
{
       message_vision(HIY"  人道：\n"NOR,me,target);
       message_vision(HIG"人世多苦，即使既富且贵，而生、老、病、死之大苦，则极公平，况千万人中难得一二是既富且贵的。多数人多为衣\n"NOR,me,target);
       message_vision(HIG"食所驱，名利所使，不得自由。而刀兵水火，饥馑疾疫，时时予人类以侵袭。故佛说此身，是秽恶所成，贪嗔所集，\n"NOR,me,target);
       message_vision(HIG"众苦之本，而人们偏能忍受，不求出离。所以说，人者忍也。\n\n"NOR,me,target) ;

       if (target->query("PKS")){
              message_vision(HIR"一入此道，$n自觉罪孽深重，不禁黯然涕下。\n\n"NOR,me,target);
	 	target->receive_damage("sen", 200);
		target->receive_wound("sen", 100);
              }
       else {
             message_vision(HIW"一入此道，$n顿觉神清气顺，精神抖擞。\n\n"NOR,me,target);
             target->add("sen",200);
             }
       me->start_busy(1);
       target->start_busy(1);
       call_out("ldlh3",1,me,target);
       return 1;
}

int ldlh3(object me,object target)
{
       message_vision(HIY"  阿修罗道：\n"NOR,me,target);
       message_vision(HIG"阿修罗者，翻为非天。宫殿园林，皆七宝所成，有天福而无天德故。男子丑陋而女人端正，故又翻为无端正。阿修罗\n"NOR,me,target);
       message_vision(HIG"曾采百花，投大海以酿酒，无所成就，故愤不饮酒，故又翻为不饮酒。\n\n"NOR,me,target);

       if (target->query("cps")<21){
              message_vision(HIR"一入此道，$n自觉罪孽深重，不禁黯然涕下。\n\n"NOR,me,target);
	 	target->receive_damage("sen", 200);
		target->receive_wound("sen", 100);
              }
       else {
             message_vision(HIW"一入此道，$n顿觉神清气顺，精神抖擞。\n\n"NOR,me,target);
             target->add("sen",200);
             }

       me->start_busy(1);
       target->start_busy(1);
       call_out("ldlh4",1,me,target);
       return 1;
}

int ldlh4(object me,object target)
{
       message_vision(HIY"  地狱道：\n"NOR,me,target);
       message_vision(HIG"如是等报，狱中，有百千种业道之器，无非是铜、是铁、是石、是火。此四种物，皆是南阎浮提，行恶众生，业感如\n"NOR,me,target);
       message_vision(HIG"是。业力甚大，能敌须弥，能深巨海，能障圣道。是故众生，莫轻小恶，以为无罪。死后有恶，纤毫受之。父子至亲，\n"NOR,me,target);
       message_vision(HIG"歧路各别，纵然相逢，无肯代受。略说如是，若广解说，穷劫不尽。\n\n"NOR,me,target);

       if (target->query("bellicosity")>100 ){
              message_vision(HIR"一入此道，$n自觉罪孽深重，不禁黯然涕下。\n\n"NOR,me,target);
	 	target->receive_damage("sen", 200);
		target->receive_wound("sen", 100);
              }
       else {
             message_vision(HIW"一入此道，$n顿觉神清气顺，精神抖擞。\n\n"NOR,me,target);
             target->add("sen",200);
             }

       me->start_busy(1);
       target->start_busy(1);
       call_out("ldlh5",1,me,target);
       return 1;
}

int ldlh5(object me,object target)
{
       message_vision(HIY"  饿鬼道：\n"NOR,me,target);
       message_vision(HIG"鬼者、畏也，因其虚怯多畏。又希求名鬼，因鬼道中有所谓饿鬼者，常向他人希求饮食，以活性命。\n\n"NOR,me,target);

       if (target->query("water")<target->max_water_capacity()||
           target->query("food")< target->max_food_capacity() ){
              message_vision(HIR"一入此道，$n自觉罪孽深重，不禁黯然涕下。\n\n"NOR,me,target);
	 	target->receive_damage("sen", 200);
		target->receive_wound("sen", 100);
              }
       else {
             message_vision(HIW"一入此道，$n顿觉神清气顺，精神抖擞。\n\n"NOR,me,target);
             target->add("sen",200);
             }

       me->start_busy(1);
       target->start_busy(1);
       call_out("ldlh6",1,me,target);
       return 1;
}

int ldlh6(object me,object target)
{
       message_vision(HIY"  畜生道：\n"NOR,me,target);
       message_vision(HIG"畜生者，由其先世，造作愚痴身语意十种恶行，所以禀性闇钝，背天而行，不能自立，赖人畜养，故曰畜生。但是卵胎\n"NOR,me,target);
       message_vision(HIG"湿化，水陆空行，遍满人间。\n\n"NOR,me,target);

       if (target->query("MKS")>1000){
              message_vision(HIR"一入此道，$n自觉罪孽深重，不禁黯然涕下。\n\n"NOR,me,target);
	 	target->receive_damage("sen", 200);
		target->receive_wound("sen", 100);
              }
       else {
             message_vision(HIW"一入此道，$n顿觉神清气顺，精神抖擞。\n\n"NOR,me,target);
             target->add("sen",200);
             }
       message_vision(HIM"\n\n$n走出了六道轮回，似乎经受了无数的劫难。\n"NOR,me,target);
        me->add("force",-500);
        me->start_busy(4+random(1));

       return 1;
}
