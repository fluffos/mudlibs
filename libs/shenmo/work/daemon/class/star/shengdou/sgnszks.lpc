// 水瓶---曙光女神之宽恕

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target) {
  int damage;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("你不在战斗中。\n");

  if (me->query("force") <= 600)
    return notify_fail("你的内力不够！\n");

  if (me->query("sen") <= 300)
    return notify_fail("你的精力不够！\n");


  if (!target || !me->is_fighting(target)) return 0;

  if (!living(me) || me->is_ghost()) return 0;

  if (!target || environment(me) != environment(target) || !me->is_fighting()) return 0;


  damage = 800 + random(200);

  message_vision(HIB "\n$n正欲攻向$N，忽然四周变得无比黑暗。\n" NOR, me, target);

  message_vision(WHT "黑暗之中忽然出现了一丝丝的光亮，$n抬头望去，光竟然是由浮在半空的$N发出。\n", me, target);

  message_vision(WHT "遥遥望去，隐隐可以见$N眼中满是怜悯。\n\n" NOR, me, target);
  message_vision(HIW "曙光女神之宽恕，随着这声轻喝，一阵光芒从$N身上射出。\n" NOR, me, target);

  if (me->query("combat_exp") * 6 / 10 > random(target->query("combat_exp"))) {

    message_vision(HIR "$n只觉得光芒有点耀眼却又不失温暖，心神不由得被此所摄。\n\n" NOR, me, target);

    target->receive_damage("sen", damage);
    target->receive_wound("sen", damage / 3);
    COMBAT_D->report_status(target);

  } else {

    message_vision(HIG "$n只觉得光芒有点耀眼却又不失温暖，全身舒畅无比。\n" NOR, me, target);
  }

  me->add("force", -500);
  me->start_busy(3 + random(1));
  return 1;
}
