// 处女---法伦常转

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target) {
  int damage;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("你不在战斗中。\n");

  if (me->query("force") <= 600)
    return notify_fail("你的内力不够！\n");

  if (me->query("sen") <= 300)
    return notify_fail("你的精力不够！\n");


  if (!target || !me->is_fighting(target)) return 0;

  if (!living(me) || me->is_ghost()) return 0;

  if (!target || environment(me) != environment(target) || !me->is_fighting()) return 0;

  if (target->query("force") < 100) return notify_fail("对方已没多少内力供你吸纳了。\n");


  damage = 1000 + random(500);

  message_vision(HIY "\n$N气聚双手，缓缓划了一个圜，在手划过的地方慢慢形成了一个金光闪闪的法轮。" NOR, me, target);

  message_vision(HIY "\n金光越闪越灿烂，法轮越变越巨大。$N忽然一声轻喝，法轮直飞入云，继而往$n当头套下。\n" NOR, me, target);

  if (me->query("combat_exp") * 6 / 10 > random(target->query("combat_exp"))) {

    message_vision(HIW "$n一个躲闪不及，被法轮一把套住。法轮不断紧缩，$n体内真气不住被吸摄过去。\n\n" NOR, me, target);
    message_vision(HIY "$N双手一挥，法轮离$n而去，融入$N手中。\n\n" NOR, me, target);

    if (target->query("force") < damage) damage = target->query("force");
    target->add("force", -damage);
    me->add("force", damage);
    if (me->query("force") > (me->query("max_force") * 2)) me->set(
      "force",
      me->query("max_force") * 2
    );

  } else {

    message_vision(HIG "$n急忙运劲抵住法轮，猛的发力，将法轮击散。\n" NOR, me, target);
  }

  me->add("force", -500);
  me->start_busy(3 + random(1));
  return 1;
}
