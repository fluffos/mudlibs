// 双子---幻胧魔皇拳

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target) {
  int damage, num;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("你不在战斗中。\n");

  if (me->query("force") <= 600)
    return notify_fail("你的内力不够！\n");

  if (me->query("sen") <= 300)
    return notify_fail("你的精力不够！\n");


  if (!target || !me->is_fighting(target)) return 0;

  if (!living(me) || me->is_ghost()) return 0;

  if (!target || environment(me) != environment(target) || !me->is_fighting()) return 0;


  damage = 500 + random(1000);

  message_vision(HIB "\n$N口中喃喃念了几句咒语，$n只觉眼睛一花，定神一看，竟然有一模一样的八个人，全都是$N ！！\n" NOR, me, target);

  message_vision(WHT "\n八个$N同声齐喝：幻胧魔皇拳,从八个方位合击而来。\n\n", me, target);

  if (me->query("combat_exp") * 6 / 10 > random(target->query("combat_exp"))) {

    message_vision(HIR "$n眼中满是$N的身影，不知如何闪避，硬生生中了此八人合击一招。\n\n", me, target);

    target->receive_damage("kee", damage);
    target->receive_wound("kee", damage / 2);
    COMBAT_D->report_status(target);

  } else {

    message_vision(HIG "$n不慌不忙，定睛静立，直到八人合击已至身前，方纵身腾空，一个筋斗翻出。\n" NOR, me, target);
  }

  message_vision(HIB "\n一击过后，八个$N聚于一处，慢慢的又融合为一个$N,好奇妙的一招。\n" NOR, me, target);

  me->add("force", -500);
  me->start_busy(2 + random(1));
  return 1;
}
