// 狮子---狮牙拳

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target) {
  int damage;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("你不在战斗中。\n");

  if (me->query("force") <= 600)
    return notify_fail("你的内力不够！\n");

  if (me->query("sen") <= 300)
    return notify_fail("你的精力不够！\n");


  if (!target || !me->is_fighting(target)) return 0;

  if (!living(me) || me->is_ghost()) return 0;

  if (!target || environment(me) != environment(target) || !me->is_fighting()) return 0;


  damage = 1000 + random(500);

  message_vision(HIY "\n$N全身劲气激荡，双手一个大擐，屈指成爪，整个人化做一巨大的金色狮王，而爪就是那吞噬万物的狮牙。\n" NOR, me, target);

  message_vision(WHT "$n顿觉一股强烈的霸者之气迎面扑来，高昂的战意不由得灭了半分。\n", me, target);

  message_vision(HIY "\n$n尚未平息心中的振荡，金色狮王已张开血盆大口猛噬而来。\n", me, target);

  if (me->query("combat_exp") * 6 / 10 > random(target->query("combat_exp"))) {

    message_vision(HIR "在巨大霸气的压迫之下，$n战意全无，被狮牙狠狠咬住，顿时血流如柱。\n\n" NOR, me, target);

    target->receive_damage("kee", damage);
    target->receive_damage("sen", 500);
    target->receive_wound("kee", damage / 2);
    COMBAT_D->report_status(target);

  } else {

    message_vision(HIG "$n强提战意，右手运劲推出，硬是将来招抵去。\n" NOR, me, target);
  }

  me->add("force", -500);
  me->start_busy(3 + random(1));
  return 1;
}
