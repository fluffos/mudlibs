// 水瓶---钻石星尘

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target)
{
	int damage;

	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("你不在战斗中。\n");

        if( target->is_busy() )
                return notify_fail(target->name()+"已经够忙了，你使的再漂亮也不会注意到。\n");

	if( me->query("force") <= 600 )
		return notify_fail("你的内力不够！\n");

	if( me->query("sen") <= 300 )
		return notify_fail("你的精力不够！\n");


	if( !target || !me->is_fighting(target) ) return 0;

	if( !living(me) || me->is_ghost() ) return 0;

	if( !target || environment(me) != environment(target) || !me->is_fighting() ) return 0;


       message_vision(HIC "\n$N全身突然冒出阵阵寒气，寒气越来越盛，$n知道此乃猛招前奏，遂暗自提防。\n" NOR, me,target);
       message_vision(HIC"只见$N缓缓举起右手，使劲一握，霎时间，寒气全部聚集在$N的拳头之上。\n",me,target);
       message_vision(HIW"\n$N大喝一声：钻石星尘,右拳划出一道优美弧线往$n直击而来。\n",me,target);

         if( me->query("combat_exp")*5/10 > random(target->query("combat_exp")) ){

              message_vision(HIR"拳势未到，寒气已经扑面而来，$n一个躲闪不及，惨被寒气冰封，动弹不得。\n\n"NOR,me,target);

	 	target->start_busy(3+random(1));

          }else{
              
             message_vision(HIG"$n拳势未到，寒气已经扑面而来，$n急忙运起轻功，飞身疾退，险被此招冰封。\n"NOR,me,target);
               }

        me->add("force",-200);
        me->start_busy(1+random(1));
            return 1;
}

         
