// 山羊---圣剑

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target) {
  int damage;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("你不在战斗中。\n");

  if (me->query("force") <= 600)
    return notify_fail("你的内力不够！\n");

  if (me->query("sen") <= 300)
    return notify_fail("你的精力不够！\n");


  if (!target || !me->is_fighting(target)) return 0;

  if (!living(me) || me->is_ghost()) return 0;

  if (!target || environment(me) != environment(target) || !me->is_fighting()) return 0;


  damage = 1000 + random(500);

  message_vision(HIY "\n$N大喝一声,混身暴发出强烈的黄金斗气。\n" NOR, me, target);
  message_vision(HIW "$N右手成拳横立于前，左手成剑指缓缓前推，只见剑指所过之处即形成一光芒四射的剑身。\n" NOR, me, target);
  message_vision(HIC "\n$N收指直立，右手中已握有内力凝聚而成的巨大" + HIW "圣 剑" + HIC "。\n\n" NOR, me, target);
  message_vision(HIW "看我圣剑威力！！,$N刚一说完，便高举圣剑，望$n直掷而来。\n" NOR, me, target);

  if (me->query("combat_exp") * 6 / 10 > random(target->query("combat_exp"))) {

    message_vision(HIR "$n正欲格挡，圣剑忽然提速，$n急忙闪身，但依然被刺中肩头，顿时血流如柱。\n\n" NOR, me, target);

    target->receive_damage("kee", damage);
    target->receive_wound("kee", damage / 2);
    COMBAT_D->report_status(target);

  } else {

    message_vision(HIG "$n身形忽然变得飘忽不定，直到圣剑已至面前，方轻松闪过。\n" NOR, me, target);
  }

  me->add("force", -500);
  me->start_busy(2 + random(1));
  return 1;
}
