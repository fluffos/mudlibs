// 双鱼---白玫瑰

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target) {
  int damage;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("你不在战斗中。\n");

  if (me->query("force") <= 600)
    return notify_fail("你的内力不够！\n");

  if (me->query("sen") <= 300)
    return notify_fail("你的精力不够！\n");


  if (!target || !me->is_fighting(target)) return 0;

  if (!living(me) || me->is_ghost()) return 0;

  if (!target || environment(me) != environment(target) || !me->is_fighting()) return 0;


  damage = 1000 + random(500);

  message_vision(HIW "\n$N右手一晃，手中突然出现一朵透明水晶玫瑰！" NOR, me, target);

  message_vision(HIM "\n$N动作优雅的将手中玫瑰抛出，玫瑰划出一道美妙的弧线，往$n手中落下。\n\n", me, target);

  message_vision(HIC "玫瑰缓缓掉落，在半空中闪烁着美丽的光芒。\n\n" NOR, me, target);


  if (me->query("combat_exp") * 5 / 10 > random(target->query("combat_exp"))) {

    message_vision(HIR "这一瞬间，$n只觉得世界上唯有这玫瑰才是真正的真实存在，心神被深深吸引。\n\n" NOR, me, target);

    target->start_busy(3 + random(2));

  } else {

    message_vision(HIG "$n目不偏视，对玫瑰的存在毫不关心，眼中只有敌人。。。\n" NOR, me, target);
  }

  me->add("force", -500);
  me->start_busy(1 + random(1));
  return 1;
}
