// 巨蟹---积尸气冥界波

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target)
{
	int damage;

	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("你不在战斗中。\n");

	if( me->query("force") <= 600 )
		return notify_fail("你的内力不够！\n");

	if( me->query("sen") <= 300 )
		return notify_fail("你的精力不够！\n");


	if( !target || !me->is_fighting(target) ) return 0;

	if( !living(me) || me->is_ghost() ) return 0;

	if( !target || environment(me) != environment(target) || !me->is_fighting() ) return 0;


	damage = 1000+random(500);

       message_vision(BLU "\n$N对着$n一阵狂笑，双手往周围一环，遍地尸骸突然都飞出一股奇怪气芒，聚集在$N高举的左手之中。\n"NOR, me,target);

       message_vision(BLU"$N浑身散发出无限杀意，一声暴吼:积尸气冥界波,右拳使劲将左手中的怪异气芒打出。\n",me,target);

       message_vision(HIC"\n气芒夹杂着一阵鬼哭神嚎，望$n激射而来。\n");     

         if( me->query("combat_exp")*6/10 > random(target->query("combat_exp")) ){

              message_vision(HIR"$n被此怪异一幕所摄，动弹不得，被气芒打个正着。\n\n"NOR,me,target);

	 	target->receive_damage("kee", damage);
		target->receive_wound("kee", damage/2);
              COMBAT_D->report_status(target);

          }else{
              
             message_vision(HIG"$n赶忙一个闪身，避过气芒。\n\n"NOR,me,target);

             message_vision(HIY"$n正待趁机攻向$N,忽觉气劲袭背，回头一望，刚才的气芒又回旋攻来。\n"NOR,me,target);

             if( me->query("combat_exp")*6/10 > random(target->query("combat_exp")) ){

                  message_vision(HIR"$n大惊，正想闪避，但已为时过晚，被气芒击中后背。\n\n"NOR,me,target);

	 	    target->receive_damage("kee", damage);
		    target->receive_wound("kee", damage/2);
                  COMBAT_D->report_status(target);
             }else{ 

                  message_vision(HIG"$n急忙回身运劲一个侧踢，将气芒硬生生打散。\n"NOR,me,target);
                   }

               }

        me->add("force",-500);
        me->start_busy(3+random(1));
            return 1;
}

         
