//quan.c暗黑流星拳
#include <ansi.h>
inherit SSERVER;
string *clo=({ HIW" ",HIC" ",HIY" ",HIM" ",CYN" ",WHT" ",HIR" ",RED" ",MAG" ",YEL" ", });

int perform(object me, object target)
{
       
int i,j,k,u,damage;

if( !target ) target = offensive_target(me);
if( !target
||  !target->is_character()
||   target->is_corpse()
||  target==me)
                return notify_fail("你要攻击谁？\n");

if(!me->is_fighting())
                return notify_fail("你们没有在打架！\n");

if((int)me->query("max_force") < 300 )
                return notify_fail("你的内功太差。\n");

if((int)me->query("force") < 300 )
                return notify_fail("你的内力不足！\n");

if((int)me->query("sen") < 30 )
                return notify_fail("你的精神不足，没法子施用外功！\n");

if((int)me->query_skill("dark-quan", 1) < 100)
        	return notify_fail("你的拳法等级不够，不能使用这一招！\n");

k=(int)me->query_skill("unarmed");
j=(int)target->query_skill("dodge");

if(k<150)        
        return notify_fail("你的拳法级别还不够，使用这一招会有困难！\n");

u=1+k/10;
if (u>20) u=20;
me->delete("env/brief_message");
target->delete("env/brief_message");

message_vision(HIC"\n$N仰天大喝了一声："NOR,me,target);
message_vision(HIB"暗黑流星拳！\n"NOR,me,target);
message_vision(HIW"\n一刹那间天地仿佛都暗下来了，无数流星破空而来，劈向$n\n\n"NOR,me,target);

for (i=0;i<=u;i++)
	{
	if (random(k+j)>j) 
		{
                message_vision(clo[random(sizeof(clo))]+"流星闪动，$n一个不慎，中了一拳！\n"NOR,me,target);
		damage=100+random(100);
                target->receive_damage("kee",damage*2/3);
                target->receive_wound("kee",damage/5);
		COMBAT_D->report_status(target);
//                me->receive_damage("sen", 10);
		me->add("force", -20);
		}
	else {
                message_vision(clo[random(sizeof(clo))]+"$n左跳右闪，好不容易避开了黑暗流星雨\n"NOR,me,target);
		me->receive_damage("sen", 10);
		me->add("force", -20);
		}
	}
        
if( !target->is_fighting(me) ) 
	{
	if( living(target) ) 
		{
		if( userp(target) ) target->fight_ob(me);
		else target->kill_ob(me);
		}
	}
    
me->start_busy(3);
return 1;
}
