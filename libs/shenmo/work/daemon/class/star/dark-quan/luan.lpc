//幻魔拳huan.c

#include <ansi.h>
inherit SSERVER;
void npc_attack(object invoker, object target, string npc, object where);
void check(object me,object target);
string *npc=({
	"/d/nanhai/npc/guanyin",
	"/d/moon/npc/xiwangmu",
	"/d/changan/npc/huang",
	"/d/death/npc/yanluowang",
	"/d/xueshan/npc/dapeng",
	"/d/tiankongjie/npc/xiewu",
	"/d/kunlun/npc/tianzun",
	"/d/emei/npc/baimei",
	"/d/pansi/npc/zixia",
	"/d/lingtai/npc/puti",
	"/d/sea/npc/longwang",
	"/d/qujing/wuzhuang/npc/zhenyuan",
	"/d/jjf/npc/yuchigong",
	"/d/shaolin/npc/damo",
	"/d/swordman/npc/bigu",
	"/d/youxia/npc/shaolong",
});

int perform(object me, object target)
{
   string msg;
   object where,weapon;
   object soldier;
   int i,j;

   if( !target ) target = offensive_target(me);

   if( !target
   ||   !target->is_character()
   ||   target->is_corpse()
   ||   target==me)
     return notify_fail("你对谁施展暗黑幻魔拳？\n");
      if (!target->is_fighting(me))             return notify_fail("只有在战斗中才可以使用「幻魔拳」！\n");
             
   if((int)me->query_skill("dark-quan", 1) < 100)
         return notify_fail("你的暗杀拳修为不深，施展不出暗黑幻魔拳。\n");

   if( time()-(int)me->query_temp("ba_end") < 5 )
                return notify_fail("你刚用过「暗黑幻魔拳」,内息还无法调整！\n");

   if((int)me->query("force") < 400 )
     return notify_fail("你的内力不够。\n");

   if((int)me->query("sen") < 100 )
     return notify_fail("你现在神智不清！\n");

   me->add("force", -200);
   me->delete("env/brief_message");
   target->delete("env/brief_message");
   weapon=me->query_temp("weapon");
   message_vision(HIM"$N提升小宇宙，竟然使出"HIB"「暗黑幻魔拳」"HIM"舍身扑向$n！\n"NOR,me,target);
   COMBAT_D->do_attack(me, target, weapon);
   i=(int)me->query_skill("dark-quan",1); 
   i/=100;
   if( i < 1 )  i=1;
   if( i > 5 )  i=5;
   msg = HIM "$N大喝一声"HIC"『暗黑幻魔拳』"HIM"！\n" NOR;  
   message_vision(msg, me, target);
   where=environment(target);
   for(j=1;j<=i;j++)
     {
   call_out("npc_attack", 1, me, target, npc, where);
     }
   call_out("check", 2, me, target);
   me->start_busy(random(2));
   me->set_temp("ba_end",random(3));
   return 1;
}

void npc_attack(object invoker, object target, string npc, object where)
{
   object attacker;
   string msg,str;
   if(!invoker || !target) return;
   if( environment(invoker) != environment(target) ) return;
   if( environment(target) != where) return;
   seteuid(getuid());
   attacker = new(npc[random(sizeof(npc))]);
   attacker->move(environment(invoker));
   msg=HIR"$N精神恍惚，只见四下人影憧憧，定睛观察却又无异常......\n"NOR;
   msg+=HIR"忽然$N眼前一花，却见自己仿佛已身上"+HIG+attacker->query("family/family_name")+HIR"地界!\n"NOR;
   msg+=HIG+attacker->query("name")+HIR"忽然出现在$N的面前！\n"NOR;		
   message_vision(msg,target);
   target->start_busy(1+random(2));
   attacker->kill_ob(target);
   COMBAT_D->do_attack(attacker, target, attacker->query_temp("weapon"));
   if ( living(target) )
	msg = HIR"\n$N一阵发泄方魂魄入壳般醒悟过来，发觉自己依然身处"+HIG+where->query("short")+HIR"！\n\n"NOR;
   else msg= HIR"\n$N一时分不清幻象与现实，发出凄厉的惨叫声迷失在自己的幻觉中！\n"NOR;
   message_vision(msg,target);
   if(target->query_temp("last_damage_from")==attacker)
       target->set_temp("last_damage_from", invoker);
   if(target->query_temp("last_fainted_from")==attacker)
       target->set_temp("last_fainted_from", invoker->query("id"));
   destruct(attacker);
}

