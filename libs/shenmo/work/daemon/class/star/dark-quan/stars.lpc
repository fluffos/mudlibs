//星云锁链stars.c
//暗黑仙女所有

#include <ansi.h>
inherit SSERVER;

int perform(object me, object target)
{
string who1, who2;
int damage, lvl, r_lvl, count, form, skill, i;
string msg;

if( !target ) target = offensive_target(me);
       
if( !me->query_skill("dark-quan", 1) )
		return notify_fail("你不会星云锁链大法。\n");
if( !target
	|| !target->is_character()
	||  target->is_corpse()
	||  target==me)
		return notify_fail("你要对谁施展这一招「星云锁链」？\n");

if( skill > 300 ) skill=300;

if(!me->is_fighting())
		return notify_fail("「星云锁链」只能在战斗中使用！\n");

if((int)me->query("max_force") < 1000 )
		return notify_fail("你的内力不够！\n");

if((int)me->query("force") < 500 )
		return notify_fail("你的内力不足！\n");

if((int)me->query("sen") < 100 )
		return notify_fail("你的精神不足，没法子施用外功！\n");

if((int)me->query_skill("dark-quan", 1) < 100)
		return notify_fail("你的杀人拳法级别还不够，小心走火入魔！\n");               

me->delete("env/brief_message");
target->delete("env/brief_message");
skill = (int)me->query_skill("dark-quan", 1);
lvl = skill/20;
r_lvl = 3+random(lvl);

if( r_lvl > 9) lvl = 9;
if( r_lvl < 1) r_lvl = 1;

count = me->query_str();
msg= HIB"$N提升小宇宙，圣衣锁暴涨,漫天飞舞,瞬间在周身裹成一团黑黑星云,$n的攻击被尽数挡回。\n"NOR;
msg +=HIB"忽然，$n发现有一股奇怪的力量袭来,四周一切似乎已经开始凝结！\n"NOR;

if((random(me->query("combat_exp")) > random((int)target->query("combat_exp")/4 )) )
	{
	msg+=HIG"$n周身不畅，似乎有股奇异的力量，将$p的出招竟然反了回来击向自己！\n"NOR;
	target->start_busy(random(2));
	message_vision(msg, me, target);
	message("vision", HIG"\n" + target->name() + HIG"忽然如中魔一般，招招击向自己！\n\n"NOR, environment(me), target);
	for(i = 0; i < r_lvl; i++)
	COMBAT_D->do_attack(target, target, target->query_temp("weapon") );
	me->add("force", -100);
	}

else  {
	msg += HIW"\n$n洞察$N的目的，以一静应万变，$N的星云锁链立刻失去效果！\n"NOR;
	message_vision(msg, me, target);
	me->start_busy(1+random(2));
	}
return 1;
}

