#include <ansi.h>
#include <skill.h>
inherit SSERVER;

int perform(object me, object target) {
  int i, j, k, damage;
  string msg;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁使用修罗功？\n");

  if (!me->is_fighting())
    return notify_fail("你们没有在打架！\n");

  if ((int)me->query("max_force") < 200)
    return notify_fail("你的内功太差。\n");

  if ((int)me->query("force") < 100)
    return notify_fail("你的内力不足！\n");

  if ((int)me->query("sen") < 100)
    return notify_fail("你的精神不足，没法子施用外功！\n");

  if ((int)me->query_skill("mingwang-quan", 1) < 50)
    return notify_fail("你的冥王拳等级不够，不能使用这一招！\n");

  if (me->query_temp("yinshentime"))
    return notify_fail("你已经使出了修罗功。\n");
  i = (int)me->query("combat_exp");
  j = (int)target->query("combat_exp");
  k = (int)me->query_skill("mingwang-quan", 1);

  me->delete("env/brief_message");
  target->delete("env/brief_message");
  msg = HIB "\n$N" HIB "嘴角边露出一丝诡异的笑意，口中叫道：“青山不改，绿水长流，我们走着瞧。”\n" NOR;
  msg += HIB "言罢，$N" HIB "忽地一闪，踪迹皆无，小宇宙消失得无影无踪。\n" NOR;
  message_vision(msg, me, target);

  if (i > random(k / 3) || random(3) > 1) {
    msg = HIB "四下里廖无人迹，只有片片鬼火随风飘荡，诡异至极。\n" NOR;
    message_vision(msg, me, target);
    me->set_temp("yinshentime", 1);
    me->set("env/invisibility", 1);
    me->add_temp("no_heal_up/yinshen", 1);
    me->remove_killer(target);
    target->remove_killer(me);
    damage = k + random(2 * k);
    call_out("perform2", 5 + random(5), me, target, damage);
  } else {
    msg = HIB "$n" HIB "眼中精光一闪，怒喝道：匹夫敢尔，以此下三滥手段，甚为不智！\n" NOR;
    msg += HIB "$N" HIB "见「脱逃之计」已遭看破，不由面色一红，现身出来。\n" NOR;
    message_vision(msg, me, target);
    me->start_busy(1 + random(2));
    me->receive_damage("sen", 30);
  }
  me->add("force", -100);
  me->receive_damage("kee", 30);
  return 1;
}

int perform2(object me, object target, int damage) {
  string msg;
  if (!me || !target) return 1;
  me->delete_temp("yinshentime");
  me->delete("env/invisibility");
  me->save();
  me->delete_temp("no_heal_up/yinshen");
  if (environment(me) != environment(target))
    return 1;
  msg = HIB "$n" HIB "尚在举目四顾之际，四下忽地寂然一静，$n" HIB "立生警觉，已是为时已晚！\n" NOR;
  msg += HIB "$N" HIB "从$n" HIB "身后急窜而出，发起一阵急攻，$n" HIB "给打了个措手不及，慌乱之中频频中招！\n" NOR;
  message_vision(msg, me, target);
  target->receive_damage("kee", damage);
  target->receive_wound("kee", damage / 5);
  target->start_busy(2 + random(3));
  COMBAT_D->report_status(target);
  me->kill_ob(target);
  target->kill_ob(me);
  return 1;
}
