////////////////////////////////////////////////////////////
/////////////////////////////蚕丝///////////////////////////
///////////////////////////////////snowtu@2003.12//////////
//////////////////////////////////////////////////////////

#include <ansi.h>
inherit SSERVER;

int perform(object me,object target)
{
string msg;
object si;
int lvl,power,flag=0;
if (!target) target=offensive_target(me);
if (!target||!target->is_character()||!me->is_fighting(target))
        return notify_fail(HIB"「蚕丝」只能对战斗对手使用.\n"NOR);
lvl=me->query_skill("mingwang-quan",1);
lvl/=50;
if ( lvl<1 ) return notify_fail("你的拳法修炼不足.\n");
if ( lvl>9 ) lvl=9;
if (me->query("force")<30*lvl)
        return notify_fail("你内力不足,无法使出这招.\n");
me->add("force",-25*lvl);
msg=HIB"\n$N"HIB"纵身跃起，整个人迎风而立，长发乱舞，形如鬼魅，对着$n鄙夷一笑。\n"NOR;
if ( random(3)==1 )
        {
        msg+= HIR"$n"HIR"心神一震，胸口仿若挨了一记重锤，硬生生的停住了脚步！\n\n"NOR;
        flag = 1;
        }
else    msg+= HIB"$n"HIB"对之置若罔闻，不理不睬。\n\n"NOR;
message_vision(msg,me,target);
if ( flag>0 )
    me->start_busy(3);
msg = HIB"$N"HIB"随风晃动，在$n"HIB"四周游走，猛地吐出"NOR HIM+chinese_number(random(lvl*5))+NOR HIB"道银丝，缠向$n"HIB"！\n"NOR;

if ( random(3)==1 )
        {
        msg+= HIC"\n$n"HIC"闪避不及，被缠了个正着，立刻被银丝包裹起来！\n\n"NOR;
        message_vision(msg,me,target);
        si = present("si xian",environment(me));
        if ( !si || userp(si) )
                si = find_object("/d/sds5/12gong/npc/obj/jian");
        if ( !si )
                si = new("/d/sds5/12gong/npc/obj/jian");
        si->set("human",target);
        si->set("owner",me);
        si->move(environment(me));
        target->set_temp("si_time",5+random(25));
        target->move(si);
        }
else    msg+=HIW"\n$n身形一展,轻轻巧巧躲了过去。\n\n"+NOR;
message_vision(msg, me, target);
me->start_busy(1+random(2));
return 1;
}

