////////////////////////////////////////////////////////////
/////////////////////////////冥届之蝶///////////////////////
///////////////////////////////////snowtu@2003.12//////////
//////////////////////////////////////////////////////////

#include <ansi.h>
inherit SSERVER;

int perform(object me,object target)
{
string msg;
object si;
int lvl,power,flag=0;
if (!target) target=offensive_target(me);
if (!target||!target->is_character()||!me->is_fighting(target))
        return notify_fail(HIB"「冥届之蝶」只能对战斗对手使用.\n"NOR);
lvl=me->query_skill("mingwang-quan",1);
power = lvl;
lvl/=50;
if ( lvl<1 ) return notify_fail("你的拳法修炼不足.\n");
if ( lvl>9 ) lvl=9;
if (me->query("force")<30*lvl)
        return notify_fail("你内力不足,无法使出这招.\n");
if ( !wizardp(me) && me->query("title")!=HIB"地"NOR HIM"妖"NOR WHT"星 "NOR HIY"蝴蝶"NOR )
        return notify_fail("你现在还不是蝴蝶形态....\n");
me->add("force",-30*lvl);
msg = HIM"\n$N"HIM"拍动背后一对五彩斑斓的翅膀，高高飞起。\n"NOR;
message_vision(msg,me,target);
COMBAT_D->attacking_perform(me,target,power,50,50,"sen",
HIM"$N"HIM"背后五彩翅膀一阵煽动，旋起强大的气流朝$n"HIM"卷去！\n"NOR,
HIC"$n"HIC"被庞大的气流刮的扑倒翻腾，身不自制！\n"NOR,
HIW"$n"HIW"马步站定，在气流中纹丝不动！！\n"NOR,
HIR"$n"HIR"奋力一吹，将气流反吹向$N"HIR"！！\n"NOR,
WHT"$n"WHT"卷在庞大的气流中，身不由己的扑倒翻腾！\n"NOR);
me->start_busy(1+random(2));
return 1;
}

