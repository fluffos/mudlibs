//虫足带 chongzu.c

#include <ansi.h>
#include <skill.h>
inherit SSERVER;

int perform(object me, object target)
{
int i,j,k,damage;
string msg,limb,*limbs;

if( !target ) target = offensive_target(me);

if( !target
 || !target->is_character()
 || target->is_corpse()
 || target==me)
        return notify_fail(YEL"你要对谁使用虫足带？\n"NOR);
                
if(!me->is_fighting())
        return notify_fail(YEL"你们没有在打架！\n"NOR);

if((int)me->query("max_force") < 200 )
        return notify_fail(YEL"你的内功太差。\n"NOR);

if((int)me->query("force") < 100 )
        return notify_fail(YEL"你的内力不足！\n"NOR);

if((int)me->query("sen") < 100 )
        return notify_fail(YEL"你的精神不足，没法子施用外功！\n"NOR);
        
if((int)me->query_skill("mingwang-quan", 1) < 50)
        return notify_fail(YEL"你的冥王拳等级不够，不能使用这一招！\n"NOR);
        
if ( me->query_temp("yinshentime") )
      return notify_fail(YEL"你已经使出了虫足带。\n"NOR);
i=(int)me->query("combat_exp");
j=(int)target->query("combat_exp");
k=(int)me->query_skill("mingwang-quan",1);

me->delete("env/brief_message");
target->delete("env/brief_message");
msg = YEL"\n$N"YEL"嘿嘿一声奸笑，将身子摆了几摆，冥衣上的钢索随风乱摆....\n"NOR;
msg+= YEL"$N"YEL"忽地将身子向下一窜，整个人钻入地底消失不见！\n"NOR;
message_vision(msg,me,target);
me->remove_killer(target);
target->remove_killer(me);
me->set_temp("yinshentime",1);
me->set("env/invisibility", 1);
me->add_temp("no_heal_up/yinshen",1);
damage=k+random(2*k);
call_out("remove_effect",k/20,me,target);
call_out("perform2",1+random(5),me,target,damage);
me->add("force", -100);
me->receive_damage("kee", 30);
return 1;
}

void perform2(object me,object target,int damage)
{
string msg,limb,*limbs;
if ( !me || !target || environment(me)!=environment(target) )  return ;
if ( !me->query_temp("yinshentime") ) return;

msg= YEL"\n$N"YEL"忽然从地底发出数道钢索，朝着$n"YEL"径直抽去！\n"NOR;
message_vision(msg,me,target);
if ( random(3)==1 )
        {
        msg = YEL"$n"YEL"给抽了正着，不由鲜血淋漓......\n"NOR;
        msg+= YEL+COMBAT_D->damage_msg(damage,"抽伤")+NOR;
        msg = replace_string(msg,"$w",NOR WHT"钢索"NOR YEL);
         limbs = target->query("limbs");
         limb = limbs[random(sizeof(limbs))];
        msg = replace_string(msg,"$l",NOR RED+limb+NOR YEL);
        message_vision(msg,me,target);
        target->receive_damage("kee",damage);
        target->receive_wound("kee",damage/5);
        target->start_busy(2+random(3));
        COMBAT_D->report_status(target);
        }
else    {
        msg = YEL"$n"YEL"眼明手快，连忙闪身躲开。\n"NOR;
        message_vision(msg,me,target);
        me->start_busy(1+random(2));
        }
msg = CYN"$n"CYN"低头细细搜索$N"CYN"的踪迹，只见泥土翻滚，$N"CYN"又消失在地下！\n"NOR;
message_vision(msg,me,target);
remove_call_out("pefform2");
call_out("perform2",3+random(7),me,target,damage);
}

void remove_effect(object me,object target)
{
if ( !me->query_temp("yinshentime") ) return;
me->delete_temp("yinshentime");
me->delete("env/invisibility");
me->delete_temp("no_heal_up/yinshen");
message_vision(YEL"\n\n泥土一翻，$N"YEL"从地下钻了出来。\n\n"NOR,me);
if ( target && me && environment(me)==environment(target) )
        {
        me->kill_ob(target);
        target->kill_ob(me);
        }
return;
}



