#include <ansi.h> 
inherit SSERVER; 

int perform(object me,object target)
{
int i;
if (!target) target=offensive_target(me); 
if (!target||!target->is_character()||!me->is_fighting(target)) 
     return notify_fail(HIB"「地狱疯犬」只能对战斗对手使用.\n"NOR); 
message_vision(HIR"$N"HIR"大喝一声，对着$n"HIR"发起一阵猛攻！\n\n"NOR,me,target);
for(i=0;i<5+random(5);i++)
     SDS_D->super_attack(me,target);
me->start_busy(2);
return 1;
}
