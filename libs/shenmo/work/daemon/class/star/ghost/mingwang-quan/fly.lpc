///////////////////////  神鷲襟翼 fly.c  ////////////////////
///////////////////////////////////snowtu@2003.12//////////

#include <ansi.h>
inherit SSERVER;

mapping hit_limb = ([
  "limb": ({
    "头部", "颈部", "胸口", "后心", "左肩", "右肩", "左臂", "右臂", "左手", "右手", "腰间", "小腹", "左腿", "右腿", "左脚", "右脚",
  }),
  "damage": ({
    1000, 800, 900, 850, 400, 400, 300, 300, 200, 200, 550, 650, 300, 300, 250, 250,
  }),
  "type": ({
    "重伤", "重伤", "重伤", "重伤", "淤伤", "淤伤", "淤伤", "淤伤", "轻伤", "轻伤", "内伤", "内伤", "淤伤", "淤伤", "轻伤", "轻伤",
  }),
]);

string damage_msg(int damage, string type) {
  string str;

  if (damage <= 0)
    return "结果没有造成任何伤害。\n";

  switch (type) {
    case "重伤":
      if (damage < 300) return "结果虽然没中要害，但是$n的面色明显变得苍白。\n";
      else if (damage < 400) return "结果$p呼吸立刻变得迟缓起来。\n";
      else if (damage < 500) return "结果一击命中，$n一言不发，显是吃了暗亏！\n";
      else if (damage < 600) return "结果一击命中，$n连连后退，歪歪斜斜，已是强弩之末！\n";
      else if (damage < 700) return "结果「砰」地一声，$n身形悬空，直飞而出！\n";
      else if (damage < 800) return "结果这一下「砰」地一声打得$n连连后退，再难反击！\n";
      else if (damage < 900) return "结果重重地击中，$n连喷鲜血，身形向后直栽！\n";
      else return "结果「砰」地一声巨响，$n已是摇摇欲倒，心力交瘁！\n";
      break;

    case "瘀伤":
      if (damage < 300) return "结果只是轻轻地碰到，比拍苍蝇稍微重了点。\n";
      else if (damage < 400) return "结果在$p的$l造成一处瘀青。\n";
      else if (damage < 500) return "结果一击命中，$n的$l登时肿了一块老高！\n";
      else if (damage < 600) return "结果一击命中，$n闷哼了一声显然吃了不小的亏！\n";
      else if (damage < 700) return "结果「砰」地一声，$n退了两步！\n";
      else if (damage < 800) return "结果这一下「砰」地一声打得$n连退了好几步，差一点摔倒！\n";
      else if (damage < 900) return "结果重重地击中，$n「哇」地一声吐出一口鲜血！\n";
      else return "结果只听见「砰」地一声巨响，$n动作明显的缓慢下来！\n";
      break;
    case "抽伤":
      if (damage < 300) return "结果只是在$n的皮肉上碰了碰，好象只蹭破点皮。\n";
      else if (damage < 400) return "结果在$n$l抽出一道轻微的紫痕。\n";
      else if (damage < 500) return "结果「啪」地一声在$n$l抽出一道长长的血痕！\n";
      else if (damage < 600) return "结果只听「啪」地一声，$n的$l被抽得皮开肉绽，痛得$p咬牙切齿！\n";
      else if (damage < 700) return "结果只听「啪」地一声，$n的$l被抽得皮开肉绽，痛得$p咬牙切齿！\n";
      else if (damage < 800) return "结果「啪」地一声爆响！这一下好厉害，只抽得$n皮开肉绽，血花飞溅！\n";
      else return "结果只听见$n一声惨嚎，翅膀重重地抽上了$p的$l，$n顿时血肉横飞，十命断了九条！\n";
      break;
    case "内伤":
      if (damage < 300) return "结果只是把$n打得退了半步，毫发无损。\n";
      else if (damage < 400) return "结果$n痛哼一声，在$p的$l造成一处瘀伤。\n";
      else if (damage < 500) return "结果一击命中，把$n打得痛得弯下腰去！\n";
      else if (damage < 600) return "结果$n闷哼了一声，脸上一阵青一阵白，显然受了点内伤！\n";
      else if (damage < 700) return "结果$n脸色一下变得惨白，昏昏沉沉接连退了好几步！\n";
      else if (damage < 800) return "结果重重地击中，$n「哇」地一声吐出一口鲜血！\n";
      else if (damage < 900) return "结果「轰」地一声，$n全身气血倒流，口中鲜血狂喷而出！\n";
      else return "结果只听见几声喀喀轻响，$n一声惨叫，像滩软泥般塌了下去！\n";
      break;
    default:
      if (!type) type = "伤害";
      if (damage < 300) str = "结果只是勉强造成一处轻微";
      else if (damage < 400) str = "结果造成轻微的";
      else if (damage < 500) str = "结果造成一处";
      else if (damage < 600) str = "造成一处严重";
      else if (damage < 700) str = "结果造成颇为严重的";
      else if (damage < 800) str = "结果造成十分严重的";
      else if (damage < 900) str = "结果造成极其严重的";
      else str = "结果造成非常可怕的严重";
      return str + type + "！\n";
  }
}

string status_msg(int ratio) {
  if (ratio < 300) return HIY "看起来可能有些累了。" NOR;
  if (ratio < 400) return HIY "动作似乎有点不太灵光，但仍然有条不紊。" NOR;
  if (ratio < 500) return HIY "气喘嘘嘘，看起来状况并不太好。" NOR;
  if (ratio < 600) return HIR "似乎十分疲惫，看来需要好好休息了。" NOR;
  if (ratio < 700) return HIR "招架已然散乱，正勉力支撑著不倒下去。" NOR;
  if (ratio < 800) return HIR "看起来已经力不从心了。" NOR;
  if (ratio < 900) return RED "歪歪斜斜地站都站立不稳，眼看就要倒地。" NOR;
  return RED "已经陷入半昏迷状态，随时都可能摔倒晕去。" NOR;
}

int perform(object me, object target) {
  string msg, str, *limbs, limb;
  int i, lvl, damage;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail(HIB "「神鷲襟翼」只能对战斗对手使用.\n" NOR);
  lvl = me->query_skill("mingwang-quan", 1);
  lvl /= 50;
  if (lvl < 1) return notify_fail("你的拳法修炼不足.\n");
  if (lvl > 9) lvl = 9;
  if (me->query("force") < 30 * lvl)
    return notify_fail("你内力不足,无法使出这招.\n");
  if ((string)me->query("old_name_fly"))
    return notify_fail("你刚刚变身，还是休息休息吧。\n");

  me->add("force", -25 * lvl);

  msg = HIY "\n$N" HIY "退后一步，深吸了一口气，身后金光隐隐一闪。\n" NOR;
  msg += HIY "$N" HIY "猛的冲天一起，身后金光大盛，瞬时淹没了整个身体！待到金光散去，$N" HIY "已化
作了一只铁翅钢啄的碧眼金雕！\n" NOR;
  message_vision(msg, me, target);
  me->set("old_name_fly", me->query("name"));
  me->set("name", "神鹰");
  me->save();

  msg = HIY "\n\n$N" HIY "居高临下，振翅猛扑而下！带起了一股铺天盖地的飓风！！\n" NOR;
  message_vision(msg, me, target);

  call_out("remove_eff", 15 + random(15), me);

  if (random(3) == 1) {
    msg = HIY "$n" HIY "见怪不怪，沉着应战，闪开了$N" HIY "的攻击。\n" NOR;
    message_vision(msg, me, target);
  } else {
    switch (random(3)) {
      case 1:
        msg = HIG "$N" HIG "铁翅一扇，$n" HIG "给飓风刮得东倒西歪，难以站稳。\n" NOR;
        message_vision(msg, me, target);
        target->start_busy(1 + random(2));
        break;
      default:
        msg = HIG "$N" HIG "“喀”的一声，正啄在$n" HIY "$l之上，立刻鲜血淋漓，血肉模糊，深可
见骨！\n" NOR;
        limbs = hit_limb["limb"];
        i = random(sizeof(limbs));
        limb = limbs[i];
        damage = hit_limb["damage"][i];
        str = hit_limb["type"][i];
        msg = replace_string(msg, "$l", limb);
        msg += HIG + damage_msg(damage, str) + NOR;
        msg += "($n" + status_msg(damage) + NOR ")\n";
        message_vision(msg, me, target);
        target->receive_damage("kee", damage);
        target->receive_wound("kee", damage / 2);
        break;
    }
  }
  call_out("fly_hit", 1 + random(2), me, target);
  return 1;
}

void remove_eff(object me) {
  string msg;

  remove_call_out("remove_eff");

  if (!me) return;
  if ((string)me->query("old_name_fly")) {
    msg = HIY "金光一闪，$N" HIY "又化作了人形。\n" NOR;
    message_vision(msg, me);
    me->set("name", me->query("old_name_fly"));
    me->delete("old_name_fly");
    me->save();
  }
  return;
}

void fly_hit(object me, object target) {
  string msg, str, limb, *limbs;
  int i, damage;

  remove_call_out("fly_hit");

  if (!me || !target || !living(target))
    return;
  if (!(string)me->query("old_name_fly"))
    return;
  if (!me->is_fighting(target))
    return;

  msg = HIY "\n\n$N" HIY "居高临下，振翅猛扑而下！带起了一股铺天盖地的飓风！！\n" NOR;
  message_vision(msg, me, target);

  if (random(3) == 1) {
    msg = HIY "$n" HIY "见怪不怪，沉着应战，闪开了$N" HIY "的攻击。\n" NOR;
    message_vision(msg, me, target);
  } else {
    switch (random(3)) {
      case 1:
        msg = HIG "$N" HIG "铁翅一扇，$n" HIG "给飓风刮得东倒西歪，难以站稳。\n" NOR;
        message_vision(msg, me, target);
        target->start_busy(1 + random(2));
        break;
      default:
        msg = HIG "$N" HIG "“喀”的一声，正啄在$n" HIY "$l之上，立刻鲜血淋漓，血肉模糊，深可
见骨！\n" NOR;
        limbs = hit_limb["limb"];
        i = random(sizeof(limbs));
        limb = limbs[i];
        damage = hit_limb["damage"][i];
        str = hit_limb["type"][i];
        msg = replace_string(msg, "$l", limb);
        msg += HIG + damage_msg(damage, str) + NOR;
        msg += "($n" + status_msg(damage) + NOR ")\n";
        message_vision(msg, me, target);
        target->receive_damage("kee", damage);
        target->receive_wound("kee", damage / 2);
        break;
    }
  }
  call_out("fly_hit", 1 + random(2), me, target);
}
