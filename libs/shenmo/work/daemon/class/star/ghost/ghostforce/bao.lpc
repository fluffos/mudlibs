#include <ansi.h>

inherit F_CLEAN_UP;

int exert(object me, object target)
{
object *ob;
int i, skill, damage, force;

if( !me->is_fighting() )
        return notify_fail(RED"冥神现身只能在战斗中使用。\n"NOR);

if( (int)me->query("force") < 200 )
        return notify_fail("你的内力不够。\n");

if( (int)me->query("kee") < 100)
        return notify_fail("你的力气不够了。\n");

skill = me->query_skill("force");
force = me->query("max_force");
me->add("force", -150);
me->receive_damage("kee", 50);
me->receive_wound("kee", 30);

message_vision(RED"\n$N退后两步，大喝一声，浑身爆起层层血筋。\n
忽然$N全身一炸，血筋爆裂，鲜血四射！\n\n"NOR, me);
ob = all_inventory(environment(me));
for(i=0; i<sizeof(ob); i++) 
        {
        if( !living(ob[i]) || ob[i]==me ) continue;
        if ( !userp(ob[i]) ) continue;
        if( skill/2 + random(skill/2) < (int)ob[i]->query("cps") * 2 ) continue;
       damage = skill + force/10 - ((int)ob[i]->query("max_force") / 10);
        if( damage > 0 ) 
                {
                ob[i]->receive_wound("sen", damage);
                tell_object(ob[i], HIR"你看来有点心神不宁！\n"NOR);
                }
        COMBAT_D->report_sen_status(ob[i]);             
        ob[i]->fight_ob(me);
       }
return 1;
}

