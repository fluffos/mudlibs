// heal.c

#include <ansi.h>

int exert(object me, object target)
{
if( (int)me->query("force") < 50 )
        return notify_fail("你的真气不够。\n");
if ( me->query("eff_kee")>=me->query("max_kee") )
     return notify_fail("你现在气血充沛，不需要疗伤。\n");
message_vision(HIB"$N"HIB"盘膝坐地，双手插于地上，一股邪恶的小宇宙笼罩其身，不久，吐出一口瘀血，脸色看起来好多了。\n"NOR,me);
me->receive_curing("kee",50+(int)me->query_skill("force")/5 );
me->add("force", -50);
return 1;
}


