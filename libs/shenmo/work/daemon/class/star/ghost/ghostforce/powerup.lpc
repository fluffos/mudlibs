// powerup.c
#include <ansi.h>
inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int exert(object me, object target) {
  int skill;
  skill = me->query_skill("ghostforce", 1);
  if (skill > 500) skill = 500;

  if (target != me)
    return notify_fail("你只能用反五行摄气诀提升自己的战斗力。\n");
  if ((int)me->query("force") < skill * 2)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_temp("powerup"))
    return notify_fail("你已经在运功中了。\n");
  me->add("force", -skill);
  me->receive_damage("kee", 50);
  message_vision(RED "$N" RED "将小宇宙运转全身，只见身后黑光一闪，浑身好似包裹在一片黑暗之中。\n" NOR, me);
  message_vision(RED "$N" RED "大喝一声，身体剧变，化作一身长丈八的黑影。\n" NOR, me);

  me->save();
  if (skill < 500) skill = 500;
  me->add_temp("apply/attack", skill / 5);
  me->add_temp("apply/strength", skill / 5);
  me->add_temp("apply/damage", skill / 5);
  me->add_temp("apply/armor", skill / 5);
  me->set_temp("powerup", 1);
  me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill / 5 :), skill);
  return 1;
}

void remove_effect(object me, int amount) {
  if (!me) return;
  me->add_temp("apply/attack", -amount);
  me->add_temp("apply/strength", -amount);
  me->add_temp("apply/damage", -amount);
  me->add_temp("apply/armor", -amount);
  me->delete_temp("powerup");
  me->save();
  message_vision(BLU "$N" BLU "小宇宙运行一周天完毕，渐渐恢复了常态。\n", me);
}
