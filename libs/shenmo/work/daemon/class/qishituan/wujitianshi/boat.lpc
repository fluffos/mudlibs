#include <ansi.h>
inherit SSERVER;
#define WIND_FILE "/d/jjf/obj/wind_seal.lpc"
void get_out(object where);
int cast(object me, object target)
{
  string msg,dest,dir;
  object sleeveroom,boat;
  string sname;
  object env=environment(me);
    seteuid(getuid());
   if(me->query("family/family_name") != "苍月骑士团")
                return notify_fail("没有用的，你不是骑士团的佣兵！\n");
   if(me->query_temp("pkgame")) return notify_fail("在比赛中还是不要用吧!\n");

  if (me->query_skill("tianwei-power",1)<600)
     return notify_fail("你的天位力量还不够纯熟。\n");
      sleeveroom=load_object("/d/wiz/sleeveroom");
  if(!sleeveroom) return notify_fail("你失败了。\n");
  sname=me->query("id")+"'s boat";
  //if (me->query_temp("cast_boat") || present(sname,sleeveroom))
    //return notify_fail("你已经在施展逆行之舟了!\n");
  if( (int)me->query("mana") < 1400 )
          return notify_fail("你的法力不够了！\n");
  if( (int)me->query("sen") < (int)me->query("max_sen")/2 )
      return notify_fail("你现在头脑不清醒，哪里使得出逆行之舟！\n");
  if( random(me->query("max_mana")) < 1250 ) {
       write("你失败了！\n");
       return 1;
  }
  if (me->is_busy())
    return notify_fail("你上一个动作还没有完成。\n");
     msg =  HIY "$N唱颂着咒文,接引着召唤而来的黑暗神明之力
         “恒久不变的古老之梦，遵守时光的约定……
   请将您手中的巨塔，放置在过去与未来的交会之处，让愚者在塔中失去方向… 
       迷失在比宇宙诞生还久远的古代，比世界灭亡更遥远的未来，直至无尽的永恒..."NOR" "HIG"
当咒语唱颂已近尾声，在激烈旋转的黑暗冥气漩涡中，四下的环境随着你的天心意识改变了！ \n" NOR;
   message_vision(msg, me,target);
   me->add("mana", -500);
   boat=new("/d/qishituan/boat");
   if(!boat) return notify_fail("下半截咒语念错了!\n");
   boat->set_name(me->query("name")+"精神力量下的时间流",({sname,"boat"}));
   if(!boat->move(sleeveroom)) 
      return notify_fail("下半截咒语念错了！\n");
     me->receive_damage("sen", 100);
   if (!env) return notify_fail("下半截咒语念错了。:(\n");
   env->set("altered_dir",dir);
   env->set("old_room",dest);
   env->set("exits/"+dir,boat);
   boat->set("host",me);
   if (me->move(boat)) ;(!target->move(boat));{
     if (me->ride()) me->ride()->move(environment(me));
     boat->set("old_room",env);
     env=environment(me);
     boat->set_exits(dest);
     me->set_temp("cast_boat",1);
   }  
  me->start_busy(random(2));
  return 1;
}
