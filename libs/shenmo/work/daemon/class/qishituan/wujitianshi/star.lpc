//cast star
//星辰之门

#include <ansi.h>

inherit SSERVER;

#define WIND_FILE "/d/jjf/obj/wind_seal.lpc"

void get_out(object where);

int cast(object me, object target) {
  string msg;
  int success, ap, dp;
  object sleeveroom, sleeve;
  string sname;
  object env, *inv;
  int size, i, wujitianshi_level;
  int maxenc;

  seteuid(getuid());


  //      if( !target ) target = offensive_target(me);

  if (!target) {
    //see if I am fighting someone...this is useful for NPC...
    if ((offensive_target(me))) target = offensive_target(me);
    else {
      // then take stuff out.
      sleeveroom = load_object("/d/wiz/yikongjian");
      if (!sleeveroom) return notify_fail("你的咒言失效了。\n");

      sname = me->query("id") + "'s sleeve";
      if (!sleeve = present(sname, sleeveroom)) {
        message_vision(
          "$N低诵魔咒，无匹的天位力量将异空间扭曲！！\n", me);
        return 1;
      }

      size = sizeof(inv = all_inventory(sleeve));
      if (!size) {
        message_vision(
          "$N低诵魔咒，无匹的天位力量将异空间扭曲！！\n", me);
        return 1;
      }

      msg = "$N低诵魔咒，无匹的天位力量将异空间扭曲！！";
      for (i = 0; i < size; i++) {
        if (inv[i]->is_character())
          msg += "一片片雪花飘落，$n从黑暗的异空间回到了现实中来。\n";
        else
          msg += "$n迷迷糊糊的从异空间的出口走了出来。\n";

        env = environment(me);
        while (!(inv[i]->move(env))) env = environment(env);

        message_vision(msg, me, inv[i]);
        msg = "";
      }
      return 1;
    }
  }

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展星辰之门？\n");

  if ((int)me->query("mana") < 1400)
    return notify_fail("你的法力不够了！\n");
  if ((int)me->query_skill("tianwei-power", 1) < 500)
    return notify_fail("你尚未晋升天位，强运五极天式肉身无法适应！ \n");
  if ((int)me->query("sen") < (int)me->query("max_sen") / 2)
    return notify_fail("你现在头脑不清醒，哪里能施展星辰之门！\n");

  if (random(me->query("max_mana")) < 50) {
    write("你的咒言失败了！\n");
    return 1;
  }

  msg = HIC "$N喃喃念动咒语：
                           比虚无更飘渺的所在，
                        比幽冥更为深沉的归宿，
         幽游于一切存有的伟大旅者，请驻足垂怜，吾将以未来一切可能为礼，
  求前进现世异界渺茫之路，，自九幽地渊之底复现，我以自身鲜血为誓，传承
彼幽谙之力，将惶惶于您前的羔羊，牵引至永无终点的无尽旅途。。。
\n" NOR;
  message_vision(msg, me, target);

  target->kill_ob(me);

  success = 1;
  ap = me->query_skill("spells");
  ap = ap * ap * ap / 10;
  ap += (int)me->query("daoxing");
  ap = 3 * ap;
  dp = target->query("daoxing");
  if (random(ap + dp) < dp / 2) success = 0;
  //here we compared exp and spells level. 
  //note: has nothing to do with target's spells level.

  ap = (int)me->query("max_mana");
  dp = (int)target->query("max_mana");
  if (ap < random(dp)) success = 0;
  //here we compared max_mana.
  //if the attacher has half of the max_mana of the target, 
  //he has 50% chance to success.

  if (success == 1) {
    me->add("mana", -1400);

    sleeveroom = load_object("/d/wiz/yikongjian");
    if (!sleeveroom) return notify_fail("已经有人被吸蚀到异空间了！\n");

    sname = me->query("id") + "'s sleeve";
    if (!sleeve = present(sname, sleeveroom)) {
      sleeve = new("/d/obj/fabao/sleeve");
      if (!sleeve) return notify_fail("已经有人被吸蚀到异空间了！\n");

      wujitianshi_level = (int)me->query_skill("wujitianshi", 1);
      maxenc = wujitianshi_level * 3000;
      if (maxenc > 400000) maxenc = 400000;
      sleeve->set_max_encumbrance(maxenc);
      // mon 4/15/98


      sleeve->set_name(
        me->query("name") + "的异空间", ({ sname, "sleeve" }));
      sleeve->set("short",
        me->query("name") + "的异空间");
      if (!sleeve->move(sleeveroom))
        return notify_fail("异空间里已经有人了！\n");
    }

    if (target->move(sleeve)) {
      msg = HIB "$n四面八方全部被狂啸的黑暗冥气所笼罩，脚下一空，方圆十丈的空间化成个无底深洞，将$n吸扯入内！！！\n" NOR;
      message_vision(msg, me, target);


      if (!userp(me)) {
        call_out("get_out", 320 + random(240), sleeve);
      } else
        call_out("get_out", 340 + random(480), sleeve);


    } else {
      msg = HIR "$n大惊失色不管三七二十一展开身型紧随着你，\n" NOR;
      msg += "$N大骇之下，，慌忙撤回禁咒。\n";
      message_vision(msg, me, target);
    }

  } else {
    msg = HIR "$n不等$N念完咒文，已经远远遁去。\n" NOR;
    message_vision(msg, me, target);

    me->add("mana", -400);
  }

  return 3 + random(5);
}

void get_out(object where) {
  object wind, *inv;
  int i;

  if (!where) return;

  i = sizeof(inv = all_inventory(where));
  while (i--) {
    if (inv[i]->is_character()) {  // NPC or players 
      wind = new(WIND_FILE);  // wind can only be used once, so need to new.
      wind->do_blow(inv[i]);
      message_vision("一片片雪花飘落，$N从黑暗的异空间回到了现实中来。！！\n",
        inv[i]);
      //         inv[i]->unconcious();
      destruct(wind);
    } else  // objects.
      destruct(inv[i]);
  }

  return;
}
