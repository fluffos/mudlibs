#include <ansi.h>

inherit SSERVER;

int cast(object me, object target) {
  string msg;
  int damage, ap;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁引动深蓝的判决？\n");
  //if(me->query("family/family_name")!="555")
  //return notify_fail("你不是弟子，不能使用这项技能！\n");

  if ((int)me->query_skill("tianwei-power", 1) < 600)
    return notify_fail("你的意识尚未达到斋天位！\n");
  //if(!me->query("shushan/jiushen_master"))
  // return notify_fail("你还不会这种法术！\n");

  if ((int)me->query("mana") < (int)me->query("max_mana"))
    return notify_fail("你的法力不够,不能和深蓝大魔王订契约！\n");

  if ((int)me->query("force") < (int)me->query("max_force"))
    return notify_fail("你的内力不够！\n");

  if ((int)me->query("sen") < 10)
    return notify_fail("你现在神智不清！\n");

  me->set("mana", 0);
  me->set("force", 0);

  msg = HIG "$N双眸微闭，两手快速地结着法印，口中念念有词，神情专注：
" HIC "          比大海更深沉的忧伤， 
　　         比天空更青蓝的悠远…… 
                  自九幽地渊之底复现， 
　                      　我以自身鲜血为誓， 
　　                        传承彼幽暗之力， 
　　                          赐予所能触及的一切， 
　　                                 彼之判决！ 

" NOR "　" HIC "大海般的淡蓝光辉，在$N周身镀上一层氤氲光环，神异的气氛笼罩四周。耀眼的光芒，犹如成千上万的蓝宝石齐放光彩，瞬间将$n卷入，似缓实快的往外扩张，夹带强大能源的冲击波摧毁着所经过的一切，将方圆半里的大范围全数吞噬在内…… \n" NOR,
    //initial message
    BLU "$n只觉得眼前一亮，跟著耳边就只听到呼呼风声，还有周遭土石树木被一一粉碎的声响。再接着就是意识的飞速丧失。。。 
\n" NOR;

  ap = me->query_skill("spells");
  damage = (me->query("force") + me->query("mana")) / 4;
  damage += (int)me->query("sen") / 5 + ap + (int)me->query("mana_factor") - random((int)target->query("mana_factor"));
  damage = damage * 3 + random(damage);
  if (damage > 15200) damage = 15050 + random(875);
  msg += RED "$N已被咒言所伤！\n" NOR;
  target->receive_wound("sen", damage, me);
  //target->apply_condition("drunk",50);
  message_vision(msg, me, target);
  if (damage > 0) COMBAT_D->report_sen_status(target);

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
    me->kill_ob(target);
  }

  me->start_busy(2 + random(2));
  return 5 + random(5);
}
