#include <ansi.h>

int cast(object me, object target) {
  int sp, dp;

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁使用蛊冥恸哭破？\n");
  if (me->query_temp("po"))
    return notify_fail("你刚刚使用过蛊冥恸哭破！\n");


  if ((int)me->query_skill("wujitianshi", 1) < 180)
    return notify_fail("你的天心意识不够，不能使用蛊冥恸哭破！n");

  if ((int)me->query("mana", 1) < 500)
    return notify_fail("你的法力不够，不能使用蛊冥恸哭破。\n");

  if ((int)target->query("kee") <= 50)
    return notify_fail(target->name() +
      "已经快断气了,用蛊冥恸哭破借力也没什么用！\n");


  message_vision(
    HIR "
                     $N默念咒文：
                      “比鬣狗更饥渴的饿鬼，
                       比饕餮更贪婪的死灵。 
　　                   速自生畜道中而来。 
　　                   应汝之所期， 
　　                   将此生灵肉厕血， 
　　                      皆为献祭! 
 
　”\n\n" NOR,
    me, target);

  if (!target->is_killing(me->query("id"))) target->kill_ob(me);

  sp = me->query_skill("force") + me->query_skill("dodge") + me->query("kar");
  dp = target->query_skill("force") + target->query_skill("dodge") - me->query("kar");

  me->set_temp("po", 1);

  if (random(sp * 2) > random(dp)) {
    tell_object(target, HIW "
          轰然巨响间，邪恶冰寒弥漫四周，阴森黑气笔直冲天而起，
                隐约凝成了一个穿着黑袍的骷髅巨影，
         那是五大闇神之中，司掌瘟疫、疾病、饥饿等灾害的毒神蛊冥，
           魔法阵随着他的形影渐渐清晰，疯狂地飙转至高峰。
               漫卷的黑气吸噬着你的元气! \n" NOR);

    tell_object(me, HIG "天地间被吸噬的元气源源不断的进入你的身体。\n" NOR);

    target->add("kee", -1 * (int)me->query_skill("wujitianshi", 1));
    me->add("kee", (int)me->query_skill("wujitianshi", 1));

    if (target->query("combat_exp") >= me->query("combat_exp")) {
      if ((int)me->query("potential") - (int)me->query("learned_points") < 100)
        me->add("potential", 1);
      me->add("combat_exp", 1);
    }

    me->start_busy(random(2));
    target->start_busy(random(2));
    me->add("mana", -200);

    call_out("del_po", 2, me);
  } else {
    message_vision(HIY "可是$p看破了$P的企图，飞快的逃出了魔法阵!\n" NOR, me, target);
    me->start_busy(2);
    call_out("del_po", 4, me);
  }

  return 1;
}

void del_po(object me) {
  if (me->query_temp("po"))
    me->delete_temp("po");
}
