// moon.c
#include <ansi.h>
//#define SPELL_D "/adm/daemons/spelld"
inherit SSERVER;
int cast(object me, object target) {
  int success_adj, damage_adj;
  success_adj = 150;
  damage_adj = 500;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁引动舫穗之月？\n");
  if ((int)me->query("mana") < 25 + 2 * (int)me->query("mana_factor"))
    return notify_fail("你的法力不够！\n");
  //if(me->query("family/family_name")!="天空界")
  //       return notify_fail("非天空界弟子不能用！\n");

  if ((int)me->query("sen") < 20)
    return notify_fail("你无法集中精力施展舫穗之月。\n");
  me->add("mana", -25 - 2 * (int)me->query("mana_factor"));
  me->receive_damage("sen", 10);
  if (random(me->query("max_mana")) < 50) {
    write("咒言无法牵动！\n");
    return 1;
  }
  SPELL_D->attacking_cast(
    me,
    //attacker
    target,
    //target
    success_adj,
    //success adjustment
    damage_adj,
    //damage adjustment
    "both",
    //damage type: could be "qi"/"kee", "shen"/"sen", ...default "both"
    HIG "$N轻轻唱颂咒文：
" HIW "比初始更悠远的存在，比故乡更温柔的归宿，神圣三角的黑色支点，我在此请您聆听我的祈愿，我在此以善之生灵为献祭，一如您便照冥府的月光，让我所面对的存在，笼罩在您的怀抱之中。”
" NOR "　" WHT "黑暗中出现了一位身着黑斗篷的老妇，全身覆盖着漆黑的鳞片，背上长着四对翅膀，如同蜥蜴一般的长尾，头顶着龙颅做的皇冠，没有任何前奏的声音，巨大的镰刀斩向$n！\n" NOR,
    //initial message
    RED "$n还来不及感到痛楚，只是惊楞的。。。看着自己的身躯从肩头斜斜的裂开，经过了淌血的空洞的胸膛，继续往下。。。\n" NOR,
    //success message
    HIM "$n左侧十尺的空间忽然裂开，倾斜，那是一种难以形容的怪异景象，好象是一幅风景画，被斜斜的斩了一刀！\n" NOR,
    //fail message
    HIW "$N一下击在空处，后力不继，脸色刹时惨白！\n" NOR,
    //backfire initial message
    RED "$N反被咒言所伤！\n" NOR
    //backfire hit message. note here $N and $n!!!
  );
  me->start_busy(1 + random(1));
  return 3 + random(5);
}
