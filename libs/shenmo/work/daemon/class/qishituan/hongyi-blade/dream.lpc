#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
        string msg;
        int extra,i,k,lmt;
        object weapon;

        extra = me->query_skill("hongyi-blade",1)+me->query_skill("blade",1);
        if ( extra < 200) return notify_fail("你的刀术修为不深！\n");

 // if(me->query_skill("tianwei-power",1) < 220)
    return notify_fail("你的天位力量不够。\n");

 
//if(me->query("family/family_name")!="苍月骑士团")
        return notify_fail("此招仅限骑士团使用！\n");       
//if((string)me->query_skill_mapped("force")!="tianwei-power")
        return notify_fail("你有天位力量吗?\n");
if(me->query("max_force") < 1200)
      return notify_fail("你的内力不足。\n");
if(me->query("force") < 1200)
return notify_fail("你的内力不足。\n");

       if( !target ) target = offensive_target(me);
       if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("「人间如梦」只能对战斗中的对手使用。\n");

        weapon = me->query_temp("weapon");

        msg =  HIG  "一道璀璨刀光自爆炸的烟尘中迸射出来, 重重的刀劲直逼$n,"NOR+" \n"
    HIW "招式中尽容八式刀招意象，忽如崇山伟岳，忽如碧波万顷；

乍似千军万马奔腾杀伐，又骤变为空谷禅钟万籁渐寂。

天地间至壮至美的情境，全包容在刀里!\n" NOR;
	        message_vision(msg,me,target);

   
me->add_temp("apply/attack",extra/3);
        me->add_temp("apply/damage",extra/3);
      k=(int)me->query_skill("blade",1); 
 lmt = 5+(k-100)/15;
 
 if (lmt>20) lmt=20;     
 for(i=5;i<=lmt;i++)
        {
        me->set_temp("dr_perform",i);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
        }
        me->add_temp("apply/attack",-extra/3);
        me->add_temp("apply/damage",-extra/3);
        me->add("force",-300);
         me->delete_temp("dr_perform");
        me->start_busy(2+random(1));
        return 1;
}
