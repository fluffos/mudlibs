#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target) {
  int damage, k;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("你不在战斗中。\n");

  if (me->query("force") <= 600)
    return notify_fail("你的内力不够！\n");

  if (me->query("family/family_name") != "苍月骑士团")
    return notify_fail("焚城枪是龙族的不传之秘!!\n");


  if (me->query("sen") <= 300)
    return notify_fail("你的精力不够！\n");


  if (!target || !me->is_fighting(target)) return 0;

  if (!living(me) || me->is_ghost()) return 0;

  if (!target || environment(me) != environment(target) || !me->is_fighting()) return 0;


  k = (int)me->query_skill("tianwei-power", 1);
  if (k > 300) k = 300;

  message_vision(HIY "\n         $N苍龙心法全面运转,强大的冲击波激荡四周.\n" NOR, me, target);
  message_vision(HIR "    $N酡红的面容，蓦地一白，继而再转盛红，凄艳地恍若要燃烧起来!\n" NOR, me, target);
  message_vision(HIG "\n       $N连连催劲，无视于身体各处隐然作痛，将功力提至最顶峰，
焚城枪法的沛然气魄，燃起熊熊烽火，炙乾了周围的水气。\n\n" NOR, me, target);
  message_vision(HIW "      灼热的火劲，升华成巨大的爆炸力，直似万马奔腾，势如破竹，
瞬间烧破了护体真气，袭向$n。\n" NOR, me, target);

  if (random(me->query("combat_exp")) > target->query("combat_exp") / k * 150)


  {

    message_vision(HIR "$n胸口好似大铁锤用力击中，喉间一甜，鲜血飞溅，整个人给轰的飞了出去。\n\n" NOR, me, target);

    target->receive_damage("kee", 1000);
    target->receive_wound("kee", 450);
    COMBAT_D->report_status(target);

  } else {

    message_vision(HIG "$n面对狂风暴雨般的枪击，$n淡然以对,面对飘忽不定的枪尖,幻出无数身影,避开了这焚城一击!\n" NOR, me, target);
  }

  me->add("force", -500);
  me->start_busy(2 + random(1));
  return 1;
}
