// duanhun.c 九天断魂掌
// By Kayin @ CuteRabbit Studio 99-4-16 19:18 new
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target) {
  int extra;
  object weapon, ob;
  if (me->is_busy())
    return notify_fail("你现在没空！！\n");
  extra = me->query_skill("jitian-zhang", 1);
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「九天断魂掌」只能在战斗中使用。\n");


  if ((int)me->query("force") < 1000)
    return notify_fail("你的真气不够！\n");

  if ((int)me->query_skill("jitian-zhang", 1) < 150)
    return notify_fail("你的祭天神掌火候不够，无法使用「九天断魂掌」！\n");

  if (time() - (int)me->query_temp("duanhun_end") < 3)
    return notify_fail(CYN "凄凄凉凉的九天断魂掌对真气损耗太大,无法连续使用！\n" NOR);
  if ((int)me->query_skill("jiutianhuangquan-sword", 1) < 150)
    return notify_fail("你的九天黄泉剑法火候不够，无法领悟「九天断魂掌」！\n");
  if ((int)me->query_skill("force", 1) < 160)
    return notify_fail("你的内功修为不够，无法使用「九天断魂掌」！\n");
  me->add_temp("apply/attack", extra * 3);
  me->add_temp("apply/damage", extra * 3);
  weapon = me->query_temp("weapon");

  message_vision(HIC "\n$N心如止水，感觉到九天之上冥冥之中赐予有巨大力量，无意之中使出了" + HIR "“九天断魂掌”！\n" NOR, me, target);
  message_vision(HIC "\n就似傍晚的遥烟，顿时天地间产生一丝苦涩！\n" NOR, me, target);

  message_vision(HIM "\n  ～ 九 ～\n" NOR, me, target);
  me->set_temp("QJB_perform", 1);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  message_vision(HIY "\n         ～ 天 ～\n" NOR, me, target);
  me->set_temp("QJB_perform", 2);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  message_vision(HIW "\n                  ～ 断 ～\n" NOR, me, target);
  me->set_temp("QJB_perform", 3);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  message_vision(HIR "\n                           ～ 魂 ～\n" NOR, me, target);
  me->set_temp("QJB_perform", 4);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  message_vision(HIB "\n                                    ～ 掌 ～\n" NOR, me, target);
  me->set_temp("QJB_perform", 5);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  me->delete_temp("QJB_perform");
  me->add_temp("apply/attack", -extra * 3);
  me->add_temp("apply/damage", -extra * 3);
  me->add("force", -200);
  //        me->start_busy(2);
  me->set_temp("duanhun_end", time());

  return 1;
}
