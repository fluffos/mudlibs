// windy
#include <ansi.h>
inherit SSERVER;
string name() {
  return "「" HIR "焚心似火" NOR "」";
}

int valid_perform(object me) {
  if (me->query_skill("guangming-force", 1) < 60)
    return notify_fail("你的「光明心法」等级不够, 不能使出「焚心似火」！\n");
  if (me->query("force") < 500)
    return notify_fail("你的内力不够，无法运功！\n");

  return 1;
}

int perform(object me, object target) {
  string msg;
  object weapon;
  int skill, ap, dp;
  int neili_wound, qi_wound;
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用！\n");
  skill = me->query_skill("guangming-shouyin", 1);
  if ((string)target->query_skill_mapped("dodge") == "lingbo-weibu" && target->query_skill(
    "lingbo-weibu",
    1
  ) > 149)
    skill -= target->query_skill("lingbo-weibu", 1) / 3;

  msg = HIC "$N聚气在手，手掌渐渐变红,使出一招" HIR "「焚心似火」" HIC "，向$n的胸口卷去。\n" NOR;
  ap = (int)me->query("combat_exp");
  dp = (int)target->query("combat_exp");
  if (dp < 1)
    dp = 1;

  if (random(ap + dp) > dp) {
    me->add("force", -300);
    neili_wound = 100 + skill + random(skill);
    if (neili_wound > target->query("force"))
      neili_wound = target->query("force");
    qi_wound = neili_wound * 2 + random(neili_wound);
    if (qi_wound > target->query("kee"))
      qi_wound = target->query("kee") + 1;
    target->receive_damage("kee", qi_wound, me);
    target->receive_wound("kee", qi_wound / 2, me);
    target->add("force", -neili_wound);
    if (!target->is_busy())
      target->start_busy(2);
    msg += HIR "$n只觉得眼前一黑，一阵赤炎扑面而来，“哇”的一声喷出一口鲜血！\n" NOR;
    if ((string)target->query_skill_mapped("dodge") == "lingbo-weibu" && target->query_skill(
      "lingbo-weibu",
      1
    ) > 149)
      msg += HIW "但是$N惊叹于$n凌波仙子般的神妙步法，力道已大为减弱！\n" NOR;
  } else {
    if ((string)target->query_skill_mapped("dodge") == "lingbo-weibu" && target->query_skill(
      "lingbo-weibu",
      1
    ) > 149)
      msg += HIW "$n脚踏凌波微步，身法逍遥飘逸，$N直看得呆了！\n" NOR;
    msg += HIG "只见$n不慌不忙，轻轻一闪，躲过了$N的必杀一击！\n" NOR;
  }
  message_vision(msg, me, target);
  me->start_busy(3);
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("guangming-force") + " 60 级\n";
  temp += "\t\t内力 500 点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP  

        使用功效：  
                打击对手的气血
        出招类型：  
                busy 型外功 
                有隐藏攻击 
                任务NPC技能
        出手要求：    
HELP);
  write(temp);
  return 1;
}
