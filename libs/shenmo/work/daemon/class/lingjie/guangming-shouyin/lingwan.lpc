//link 2001.2.20
#include <ansi.h>

inherit SSERVER;

string name()  
{
return "「"HIC"灵丸"NOR"」";
}

int valid_perform(object me)
{
    if( (int)me->query_skill("guangming-force", 1) < 50 )
   return notify_fail("你的光明心法火候不够，使不出「灵丸」。\n");

    if( (int)me->query_skill("guangming-shouyin", 1) < 50 )
   return notify_fail("你的光明手印不够熟练，不能使用灵丸」。\n");

    if( (int)me->query_skill("fengtian-steps", 1) < 50 )
   return notify_fail("你的风天神紫云步不够熟练，不能使用灵丸」。\n");


    if( (int)me->query_skill("kongming-spells", 1) < 50 )
   return notify_fail("你的空明灵法不够熟练，不能使用灵丸」。\n");
    if( (int)me->query("force") < 1000 )
   return notify_fail("你的内力修为还不够高。\n");

return 1;  
}

int perform(object me, object target)
{
    int damage, hurt;
    string msg;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

    msg = HIW "
$N将全身每个气海光球各涌出三分之一，分为两道纳入两条手臂中，\n"NOR+HIC"
眼看劲力逐渐凝聚，身旁的气劲却越旋越快，回旋的劲力与$N护身的气劲碰触到，直是嘎然作响，
忽然同时轰然的爆裂开来，两道粗大凝结如实物一般的光球，撕裂空间般的往$n狂奔而去...！\n"NOR;  
   if( random((int)me->query("combat_exp")/10000) > (int)target->query("combat_exp")/20000) { 
   damage = ((int)me->query_skill("guangming-shouyin", 1))/2*5+(int)me->query_skill("guangming-force",1);
if((string)target->query_skill_mapped("dodge")=="lingbo-weibu" && target->query_skill("lingbo-weibu",1)>149) 
damage-=(int)target->query_skill("lingbo-weibu",1);
   damage = damage/2 + random(damage);
  if(damage>target->query("kee")) 
     damage=target->query("kee")+1;
   hurt = ((int)me->query_skill("guangming-shouyin", 1))/2*5+(int)me->query_skill("guangming-force",1);
   hurt = hurt/2 + random(hurt);
  if(hurt>target->query("sen")) 
     hurt=target->query("sen")+1;
   target->receive_damage("kee", damage, me);
   target->receive_wound("kee", damage/(random(5)+1), me);
   target->receive_damage("sen", hurt, me);
   target->receive_wound("sen", hurt/(random(5)+1), me);
   me->add("force", -100);
   msg += HIR"
能量相击之下，$n马上被$N狂龙一般的内劲瞬间吞噬，两股光球轰然的击到了$n的身上。\n"NOR;
if((string)target->query_skill_mapped("dodge")=="lingbo-weibu" && target->query_skill("lingbo-weibu",1)>149) 
        msg += HIW "但是$N惊叹于$n凌波仙子般的神妙步法，力道已大为减弱！\n"NOR;
    } else
    {
if((string)target->query_skill_mapped("dodge")=="lingbo-weibu" && target->query_skill("lingbo-weibu",1)>149) 
        msg += HIW "$n脚踏凌波微步，身法逍遥飘逸，$N直看得呆了！\n"NOR;
       msg += HIY"可是$p看破了$P的企图，早就闪在了一边,不过也惊出一身冷汗。\n"NOR;
    if (!target->is_busy())
    target->start_busy(1);
    }
 message_vision(msg, me, target);
me->start_busy(3);

    if(!target->is_fighting(me)) target->fight_ob(me);
    return 1;
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("guangming-force")+" 50 级\n"; 
temp+= "\t\t"+to_chinese("guangming-shouyin")+" 50 级\n"; 
temp+= "\t\t"+to_chinese("fengtian-steps")+" 50 级\n"; 
temp+= "\t\t"+to_chinese("kongming-spells")+" 50 级\n"; 
temp+= "\t\t内力 1000 点\n";  
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP  

        使用功效：  
                打击对手的气血和精神
        出招类型：  
                busy 型外功 
                有隐藏攻击 
                任务NPC技能
        出手要求：    
HELP);              
write(temp);  
return 1;  
}
