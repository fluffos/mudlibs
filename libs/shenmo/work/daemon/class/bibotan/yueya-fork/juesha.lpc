#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target) {
  string msg;
  int damage, def, time;
  object weapon;

  if (!target)
    target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("月牙绝杀只能对战斗中的对手使用。\n");
  weapon = me->query_temp("weapon");
  if (me->query_skill("yueya-fork", 1) < 300)
    return notify_fail("你铲法不够娴熟。\n");
  if (me->query("family/family_name") != "乱石山碧波潭")
    return notify_fail("非我门人请勿乱用！\n");
  if (me->query_skill("zhuanlong-force", 1) < 120)
    return notify_fail("你的内功修为不够。\n");
  time = 4 + random(4);
  if (time() < me->query_temp("juesha_busy") + time)
    return notify_fail("你的内力消耗太大，等一会再用吧!\n");
  if (me->query("force") <= 1200)
    return notify_fail("你内力不够，使用绝杀没什么威力！\n");
  msg = HIW "$N" HIW "气运丹田，脸色变的苍白，手中" + weapon->name() + HIW "带着呼呼风声对着$n" HIW "狂扫而至！\n" NOR;
  message_vision(msg, me, target);

  if (random(me->query("combat_exp")) > target->query("combat_exp") / 8) {
    msg = YEL "$n" YEL "一愣，不自觉的被带了一个踉跄。\n" NOR;
    msg += HIC "$N" HIC "仰天长啸，一式" HIW "『绝杀九连』" HIC "奇快无比的向$n" HIC "连续刺出九叉！\n" NOR;
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(msg, me, target);
    for (int i = 0; i < 9; i++) {
      if (me->query("force") > 800
        && target && me->is_fighting(target))
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    }
    me->add("force", -200 - me->query("force_factor"));
    me->add("mana", -50);
  } else {
    msg = YEL "$n" YEL "早已经看出$N的企图，没有上当。\n" NOR;
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(msg, me, target);
    me->add("force", -200 - me->query("force_factor"));
  }
  me->set_temp("juesha_busy", time());
  me->start_busy(random(2));
  return 1;
}
