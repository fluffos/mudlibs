//血海飘香
#include <ansi.h>
inherit SSERVER;

int perform(object me, object target) {
  object weapon;
  int damage, time;
  string msg;

  if (!target)
    target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「血海飘香」只能对战斗中的对手使用。\n");
  if (me->query_skill("huaxue-blade", 1) < 60)
    return notify_fail("你的刀法不够娴熟。\n");
  if (me->query("family/family_name") != "乱石山碧波潭"
    && (me->query_skill("huaxue-blade", 1) < 350
      || me->query("class") != "yao") && !me->samsara_check("huaxue-blade"))
    return notify_fail("你还不够资格！\n");
  time = 5 + random(5);
  if (time() < me->query_temp("piao_busy") + time)
    return notify_fail("你刚用完这招，再用会有危险!\n");
  if (me->query_skill("zhuanlong-force", 1) < 60)
    return notify_fail("你的内功修为不够高。\n");
  if (me->query("force") < 1000
    || me->query("force") < 250 + me->query("force_factor"))
    return notify_fail("你现在内力太弱，不能使用「血海飘香」。\n");
  weapon = me->query_temp("weapon");
  msg = HIC "$N" HIC "一声清啸，气运丹田，围绕$n" HIC "疾转，手中" + weapon->name() + HIC "闪出无数血红的刀光!\n" NOR;
  message_vision(msg, me, target);
  me->set_temp("piao_busy", time());
  msg = HIR "$n" HIR "顿觉四周眼花缭乱，仿佛置身于重重血海之中......" NOR;
  msg += HIC "却见$N" HIC "突然身形一顿，人刀合一，带着一丝淡淡的血光，穿向$n" HIC "......\n" NOR;
  if (random(me->query("combat_exp") / 10000) > target->query("combat_exp") / 40000) {
    damage = me->query_skill("huaxue-blade", 1) + me->query("force_factor");
    damage = damage / 2 + random(damage / 2 + 100);
    damage = damage * 3 / 2;
    target->receive_damage("kee", damage);
    target->receive_wound("kee", damage / 4);
    msg += HIM "$n" HIM "只觉一股热流穿心而过，喉头一甜，鲜血狂喷而出！\n" NOR;
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(msg, me, target);
    me->add("force", -250 - me->query("force_factor"));
    COMBAT_D->report_status(target);
  } else {
    msg += HIM "可是$n" HIM "猛地向边上一跃,跳出了$N" HIM "的攻击范围。\n" NOR;
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(msg, me, target);
    me->add("force", -150 - me->query("force_factor"));
  }
  return 1;
}
