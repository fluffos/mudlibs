#include <ansi.h>
inherit SSERVER;
string name() 
{
return "「"HIM"麟生雾彩"NOR"」";
}
int valid_perform(object me) 
{
if ( !me )   return 0; 
if( time()-(int)me->query_temp("kunlun_lin") < 1+random(3) ) 
        return notify_fail("绝招用多就不灵了！\n"); 
if((int)me->query("max_force") < 500 ) 
        return notify_fail("你内力修为不足 500 点，不能施展"+name()+"。\n");
if ( me->query("force")<200 )
        return notify_fail("你内力不足 200 点，不能施展"+name()+"。\n");
if ( me->query("sen")<100 )
        return notify_fail("你精神不足 100 点，不能施展"+name()+"。\n");
if ( me->query_skill("huntian-jian",1)<100 )
        return notify_fail("你的"+to_chinese("huntian-jian")+"等级不足100，无法施展"+name()+"。\n");
if ( me->query_skill("sword",1)<100 )
        return notify_fail("你的"+to_chinese("sword")+"等级不足100，无法施展"+name()+"。\n");
if ( ((me->query("family/family_name")!="昆仑山玉虚洞" 
&& me->query_skill("huntian-jian",1)<350 )
|| me->query("class")!="xian" ) && !me->samsara_check("huntian-jian") )
        return notify_fail("你还不够资格！\n"); 
return 1; 
}
int perform(object me, object target)
{
        object weapon;
int i,j,k,u,t,mylvl,talvl,damage;
string msg,str; 
weapon = me->query_temp("weapon");
if ( !valid_perform(me) ) 
        return 0;   
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
||      target==me) 
                return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n"); 
        
k=me->query_skill("huntian-jian",1);
j=target->query_skill("parry", 1);
t=me->query_skill("sword",1);
mylvl=me->query("level");
talvl=target->query("level");
damage = 200 + t/4 + me->query("force_factor")/4 + random(me->query("force_factor")/2);
if (me->query("family/family_name")=="昆仑山玉虚洞" || me->samsara_check("huntian-jian",1) )
damage=damage+random(damage);
u=1+k/50;
if (u>9) u=9;
msg =HIM"\n$N"HIM"双手持剑，平地随之升起一团彩雾，手中"+ weapon->name()+ HIM"也有如狂漫天飞雨般地向$n"+HIM"卷来！\n"NOR;
if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
        msg+= NOR"\t"REV HIR "█"NOR BRED BLK"█"NOR REV HIR "█"NOR BRED  BLK"█"NOR REV HIR "█"NOR BRED  BLK"█"NOR"  "BLINK HIR"  手中一招 "+name()+"转眼而出"NOR"  "REV HIR "█"NOR BRED  BLK"█"NOR REV HIR "█"NOR BRED  BLK"█"NOR REV HIR "█"NOR BRED  BLK"█\n"NOR;
message_vision(msg,me,target);
for (i=0;i<=u;i++)
{
if (random(k)>j/3 || random(mylvl)>talvl/2) {
if ( !me->query("env/no_msg") && !target->query("env/no_msg") ) 
target->receive_damage("kee",damage,me);
target->receive_wound("kee",damage/2,me);
     if( me->query("env/no_status")==0 && !userp(target) )
            COMBAT_D->report_status(target);
me->receive_damage("sen", 10);
me->add("force", -50);
}
             else {
me->receive_damage("sen", 10);
me->add("force", -20);
}
}
if (t>799 && random(mylvl)>talvl/2)
        {
        message_vision(HIM"$N蓦地一声巨吼，声如狻猊，状若麒麟，手中"+weapon->query("name")+HIM"左突右击，
                                剑气氤氲，竟使出了麟生雾彩的精髓----「麒麟九式」！\n"NOR,me,target);
        damage=damage*9;
        target->receive_damage("kee",damage,me);
        target->receive_wound("kee",damage/2,me);
        COMBAT_D->report_status(target);
        }
me->set_temp("kunlun_lin",time());
return 1;
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("huntian-jian")+" 100 级\n"; 
temp = "\t\t"+to_chinese("sword")+" 100 级\n"; 
temp+= "\t\t内力修为五年\n";  
temp+= "\t\t内力２００点\n";  
temp+= "\t\t精神１００点\n";  
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                连续打击对手的气血
        出招类型： 
                延时型外功
                有隐藏攻击
                叛师可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
