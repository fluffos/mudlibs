#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name()
{
return "「"WHT"天下有雪"NOR"」";
}

int valid_perform(object me)
{
if (me->query("family/family_name")!="昆仑山玉虚洞" && !me->samsara_check("huntian-jian",1) )
        return notify_fail(name()+"是昆仑山的功夫。\n");
if ( me->query_skill("huntian-jian",1)<100 )
        return notify_fail("你的"+to_chinese("huntian-jian")+"等级不足100，无法施展"+name()+"。\n");
if( time()-(int)me->query_temp("kunlun_xue") < 4+random(4) ) 
        return notify_fail("绝招用多就不灵了！\n"); 
if ( me->query_skill("xuanzong-force",1)<100 )
        return notify_fail("你的"+to_chinese("xuanzong-force")+"等级不足100，无法施展"+name()+"。\n");
if ( me->query("force")<100 )
        return notify_fail("你内力不足 100 点，不能施展"+name()+"。\n");
return 1;               
}

int perform(object me, object target)
{
int ap,dp,time;
object weapon;

if ( !valid_perform(me) )  
        return 0;    
if ( !target ) 
        target = offensive_target(me);
if ( !target
  || !target->is_character()
  || !me->is_fighting(target) )
        return notify_fail(name()+"只有在战斗中才能使用。\n");
if ( !me->is_fighting() )
        return notify_fail(name()+"必须在战斗中使用。\n");        
if ( target->is_busy() )
        return notify_fail(target->name()+"已经够忙了，你使的再漂亮也不会注意到。\n");

weapon = me->query_temp("weapon"); 
message_vision(HIW"\n$N"HIW"把玄宗心法在体内运行一周，"+weapon->name()+HIW"好似被雪花缠绕一般！\n" NOR, me);
me->add("force",-100);

ap = COMBAT_D->skill_power(me,"sword",SKILL_USAGE_ATTACK);
dp = COMBAT_D->skill_power(target,"parry",SKILL_USAGE_DEFENSE);
if ( COMBAT_D->restrain(me,target) )
        ap = ap*3/2;
if ( COMBAT_D->restrain(target,me) )
        dp = dp*3/2;    
if ( ap<1 )  ap = 1;
if ( dp<1 )  dp = 1;
if ( random(ap+dp)>dp ) 
        {
        message_vision(HIW"$n"HIW"被"+weapon->name()+HIW"带出的雪花给冻的严严实实，半分动弹不得！\n"NOR,me,target);
        target->start_busy(5);
        }
else    {
        message_vision(HIW"不料却被$n"HIW"看破，以极快的速度跳出站圈，才没被$N"HIW"的无形寒气所伤！\n"NOR,me,target);
        }
if ( !target->is_fighting(me) ) 
        {
        if ( living(target) ) 
                {
                if ( userp(target) ) 
                        target->fight_ob(me);
                else    target->kill_ob(me);
                }
        me->kill_ob(target);
        }
if ( wizardp(me) )  
        tell_object(me,sprintf(HIW BLK"\t\tap===%d  | dp==%d \n"NOR,ap,dp));
me->set_temp("kunlun_xue",time());
return 1;
}

int help(object me)
{
string temp;    
temp = "\t\t"+to_chinese("huntian-jian")+" 等级 100 级\n";
temp+= "\t\t"+to_chinese("xuanzong-force")+" 等级 100 级\n";
temp+= "\t\t内    力 100 点\n";
temp+= "\t\t战斗中使用\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");
write(@HELP

        使用功效：
                使对手busy 5 秒
        出招类型：
                延时型外功
                无隐藏攻击
                不可叛师带出
                对手busy状态下无用
        出手要求：              
HELP);                          
write(temp);
return 1;
}
