#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name()
{
return "「"HIM"麟生雾彩"NOR"」";
}

int valid_perform(object me)
{
int time;       
if ( me->query("class")!="xian" )
        return notify_fail(name()+"是仙界的功夫。\n");
if ( me->query_skill("sword",1)<100 )
        return notify_fail("你的"+to_chinese("sword")+"等级不足100，无法施展"+name()+"。\n");
if ( me->query_skill("huntian-jian",1)<100 )
        return notify_fail("你的"+to_chinese("huntian-jian")+"等级不足100，无法施展"+name()+"。\n");
if ( me->query("max_force")<500 )
        return notify_fail("你内力修为不足 500 点，不能施展"+name()+"。\n");
if ( me->query("force")<200 )
        return notify_fail("你内力不足 200 点，不能施展"+name()+"。\n");
if ( me->query("sen")<100 )
        return notify_fail("你精神不足 100 点，不能施展"+name()+"。\n");
if ( time()<me->query_temp("kunlun_lin")+4+random(4) )
        return notify_fail("绝招用多就不灵了。\n");        
if ( !me->is_fighting() )
        return notify_fail(name()+"必须在战斗中使用。\n");        
return 1;               
}

int perform(object me, object target)
{
string msg;
int ap,dp,lvl,i,damage;
object weapon;
if ( !valid_perform(me) )
        return 0;
if ( !target ) 
        target = offensive_target(me);
if ( !target
  || !target->is_character()
  || !me->is_fighting(target) )
        return notify_fail(name()+"只能对战斗中的对手使用。\n");

weapon = me->query_temp("weapon");      
ap = COMBAT_D->skill_power(me,"sword",SKILL_USAGE_ATTACK);
dp = COMBAT_D->skill_power(target,"parry",SKILL_USAGE_DEFENSE);
if ( ap<1 )  ap = 1;
if ( dp<1 )  dp = 1;
if ( COMBAT_D->restrain(me,target) )
        ap = ap*3/2;
if ( COMBAT_D->restrain(target,me) )
        dp = dp*3/2;    

msg =HIM"\n$N"HIM"双手持剑，平地随之升起一团彩雾，手中"+ weapon->name()+ HIM"也有如狂漫天飞雨般地向$n"+HIM"卷来！\n"NOR;

if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
        msg+= NOR"\t"REV HIR "█"NOR BRED BLK"█"NOR REV HIR "█"NOR BRED  BLK"█"NOR REV HIR "█"NOR BRED  BLK"█"NOR"  "BLINK HIR"  手中一招 "+name()+"转眼而出"NOR"  "REV HIR "█"NOR BRED  BLK"█"NOR REV HIR "█"NOR BRED  BLK"█"NOR REV HIR "█"NOR BRED  BLK"█\n"NOR;
message_vision(msg,me,target);
me->add("force",-200);
me->set_temp("kunlun_lin",time());

damage = me->query_temp("apply/damage");
damage+= me->query_temp("apply/attack");
damage+= me->query("force_factor");
damage+= me->query("level")*3;
damage-= target->query_temp("apply/armor");
if ( COMBAT_D->restrain(me,target) )
        damage = damage/2*3;
if ( COMBAT_D->restrain(target,me) )
        damage = damage/3*2;    
if ( me->query("family/family_name")!="昆仑山玉虚洞" )
        damage = 0;
lvl = me->query_skill("sword");
lvl/= 100;
if ( lvl>6 ) lvl = 6;
while(lvl--)
        {
        if ( !me || !target || !living(target) || !me->is_fighting(target) )
                  continue;
        if ( random(ap+dp)>dp )
                {
                COMBAT_D->do_attack(me,target,weapon);
                if ( damage )
                        target->receive_damage("kee",damage,me);
                }
        else    COMBAT_D->do_attack(me,target,weapon,TYPE_REGULAR);
        }       
me->receive_damage("sen",50,me);
if ( wizardp(me) )  
        tell_object(me,sprintf(HIW BLK"\t\tap===%d  | dp==%d \n"NOR,ap,dp));
return 1;
}

int help(object me)
{
string temp;    
temp = "\t\t"+to_chinese("sword")+" 等级 100 级\n";
temp+= "\t\t"+to_chinese("huntian-jian")+" 等级 100 级\n";
temp+= "\t\t内    力 200 点\n";
temp+= "\t\t内力修为 500 点\n";
temp+= "\t\t精    神 100 点\n";
temp+= "\t\t战斗中使用\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");
write(@HELP

        使用功效：
                对对手连续攻击
        出招类型：
                延迟型外功
                有隐藏攻击
                可以叛师带出
        出手要求：              
HELP);                          
write(temp);
return 1;
}

