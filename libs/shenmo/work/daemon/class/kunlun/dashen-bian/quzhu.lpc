#include <ansi.h>
inherit SSERVER;

string name() {
  return "「" HIB "驱神逐魔" NOR "」";
}

int valid_perform(object me) {
  int time;
  if (me->query("family/family_name") != "昆仑山玉虚洞" && !me->samsara_check("dashen-bian", 1))
    return notify_fail(name() + "只有昆仑山玉虚洞门人才可以用！\n");
  if (time() - (int)me->query_temp("quzhu_end") < 4 + random(2))
    return notify_fail("绝招用多就不灵了！\n");
  if (me->query_skill("dashen-bian", 1) < 80)
    return notify_fail("你的" + to_chinese("dashen-bian") + "等级不足80，无法施展" + name() + "。\n");
  if (me->query("force") < 100)
    return notify_fail("你内力不足 100 点，不能施展" + name() + "。\n");
  return 1;
}

int perform(object me, object target) {
  string msg;
  int ap, dp, mystr, yourstr;
  object weapon1, weapon2;
  if (!valid_perform(me))
    return 0;
  if (!target)
    target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(name() + "只能对战斗中的对手使用。\n");
  if (!me->is_fighting())
    return notify_fail(name() + "必须在战斗中使用。\n");

  weapon1 = me->query_temp("weapon");
  weapon2 = target->query_temp("weapon");
  yourstr = target->query_str();
  mystr = me->query_str();

  ap = me->query_skill("dashen-bian", 1);
  ap = ap / 10 * ap / 10 * ap / 10;
  ap += me->query("combat_exp") / 100;
  ap /= 100;
  if (ap < 1) ap = 1;
  dp = target->query_skill("spells", 1);
  dp = dp / 10 * dp / 10 * dp / 10;
  dp += target->query("combat_exp") / 100;
  dp /= 100;
  if (dp < 1) dp = 1;
  if (COMBAT_D->restrain(me, target))
    ap = ap * 3 / 2;
  if (COMBAT_D->restrain(target, me))
    dp = dp * 3 / 2;

  me->add("force", -100);
  msg = YEL "\n$N" YEL "口中念动箴言，将手中" + weapon1->name() + YEL "对着$n" YEL "一挥。 \n" NOR;
  if (random(ap + dp) > dp) {
    msg += YEL "$n" YEL "但觉心头肉跳，不由魂不守势，";
    if (weapon2 && objectp(weapon2) && random(mystr + yourstr) > yourstr / 2) {
      weapon2->unequip();
      weapon2->move(environment(target));
      msg += YEL "手中的" + weapon2->name() + YEL "不知怎么就落在了尘埃。\n" NOR;
      message_vision(msg, me, target);
      if (!target->is_busy())
        target->start_busy(2);
    } else {
      msg += YEL "不由得只觉一股杀气直冲顶梁。\n\n" NOR "$n发了疯似的自己打起自己起来。" NOR;
      message_vision(msg, me, target);
      target->add("bellicosity", 500);
      COMBAT_D->do_attack(target, target, target->query_temp("weapon"));
    }
    target->receive_wound("sen", target->query("eff_sen") / 5, me);
    COMBAT_D->report_sen_status(target, target->query("eff_sen") / 5);
  } else {
    msg += CYN "$n" CYN "嘿嘿一笑“子牙那点伎俩，对付那些笨神还可以”。\n" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(target, me, weapon2);
  }
  me->set_temp("quzhu_end", time());
  if (wizardp(me))
    tell_object(me, sprintf(NOR HIW BLK "\nap===%d  | dp==%d \n" NOR, ap, dp));
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("dashen-bian") + " 等级 100 级\n";
  temp += "\t\t内    力 100 点\n";
  temp += "\t\t战斗中使用\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                扰乱对手心智
        出招类型：
                延时型外功
                有隐藏攻击
                不可以叛师带出
        出手要求：              
HELP);
  write(temp);
  return 1;
}
