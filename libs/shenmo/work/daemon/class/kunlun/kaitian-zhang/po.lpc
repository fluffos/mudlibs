#include <ansi.h>
inherit SSERVER;

string name() {
  return "「" HIR "天龙破" NOR "」";
}

int valid_perform(object me) {
  if (me->query("max_force") < 1000)
    return notify_fail("你的内力修为不足 1000 点，施展不出" + name() + "。\n");
  if (me->query("force") < 500)
    return notify_fail("你的内力不足 500 点，施展不出" + name() + "。\n");
  if (me->query_skill("kaitian-zhang", 1) < 100)
    return notify_fail("你的" + to_chinese("kaitian-zhang") + "等级不足100，无法施展" + name() + "。\n");
  if (me->query_skill("unarmed", 1) < 100)
    return notify_fail("你的" + to_chinese("unarmed") + "等级不足100，无法施展" + name() + "。\n");
  if (me->query("family/family_name") != "昆仑山玉虚洞" && !me->samsara_check("kaitian-zhang", 1))
    return notify_fail("你与昆仑无缘,领悟不到掌法的精髓!!\n");
  return 1;
}

int perform(object me, object target) {
  string msg = "";
  if (!valid_perform(me))
    return 0;
  if (!target)
    target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(name() + "只能对战斗中的对手使用。\n");
  if (!me->is_fighting())
    return notify_fail(name() + "必须在战斗中使用。\n");
  if (!me->query("env/no_msg") && !target->query("env/no_msg")) msg += HIC "
$N" HIC "默运玄宗心法，突然双掌变爪，使出开天掌绝学" HIR + name() + HIC "，步法连绵，撒出一片爪影从半空中逼向$n" HIC "！\n" NOR;
  else msg += HIC "$N" HIC "对$n" HIC "施展了" + name() + "。\n" NOR;
  message_vision(msg, me, target);
  me->add("force_factor", me->query_skill("kaitian-zhang", 1));
  me->add_temp("apply/attack", me->query_skill("kaitian-zhang", 1)); for (int i = 0; i < 3; i++) {
    if (me && target && me->is_fighting(target) && living(target))
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  }
  me->add("force_factor", -me->query_skill("kaitian-zhang", 1));
  me->add_temp("apply/attack", -me->query_skill("kaitian-zhang", 1));
  me->start_busy(1 + random(3));
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("unarmed") + " 等级 100 级\n";
  temp += "\t\t" + to_chinese("kaitian-zhang") + " 等级 100 级\n";
  temp += "\t\t内    力 500 点\n";
  temp += "\t\t内力修为 1000 点\n";
  temp += "\t\t战斗中使用\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                对敌人连续攻击
        出招类型：
                busy型外功
                无隐藏攻击
                不可以叛师带出
        出手要求：              
HELP);
  write(temp);
  return 1;
}
