
#include <ansi.h>
inherit SSERVER;

string name()
{
return "「"HIR"天霸封神"NOR"」";
}

int valid_perform(object me)
{
if (me->query("family/family_name")!="昆仑山玉虚洞" && !me->samsara_check("wugou-jian",1) )
        return notify_fail("天霸封神只有昆仑山玉虚洞门人才可以用！\n");
if ( me->query_skill("wugou-jian",1)<120 )
        return notify_fail("你的"+to_chinese("wugou-jian")+"等级不足120，无法施展"+name()+"。\n");
if ( me->query_skill("lingyunbu",1) < 120)
        return notify_fail("你的"+to_chinese("lingyunbu")+"等级不足120，无法施展"+name()+"。\n");
if ( me->query_skill_mapped("force")!="xuanzong-force" )
        return notify_fail(name()+"必须和玄宗心法配合。\n");
if ( me->query("force")<1000 )
        return notify_fail("你的内力不足 1000 点，施展不出"+name()+"。\n");
if ( me->query("kee")<150 )
        return notify_fail("你的气血不足 150 点，施展不出"+name()+"。\n");
return 1;               
}

int perform(object me, object target)
{
string msg;
int extra,lvl;
object weapon;
if ( !valid_perform(me) )
        return 0;
if ( !target ) 
        target = offensive_target(me);
if ( !target
  || !target->is_character()
  || !me->is_fighting(target) )
        return notify_fail("天霸封神只能对战斗中的对手使用。\n");
if ( !me->is_fighting() )
        return notify_fail(name()+"必须在战斗中使用。\n");        
weapon = me->query_temp("weapon");
extra = me->query_skill("wugou-jian",1) / 2;
extra+= me->query_skill("lingyunbu",1) / 15;
lvl = me->query_skill("sword");
me->add_temp("apply/attack", extra);
me->add_temp("apply/damage", extra);
  
me->receive_damage("kee", 150);
target->start_busy(1);
msg = MAG"
$N"MAG"凝聚起天地间诸神的无边力量，一式"NOR HIW"－天－霸－封－神 －"NOR MAG+"如急电般劈向$n"MAG"！\n"NOR;
message_vision(msg, me, target);
COMBAT_D->do_attack(me, target,weapon);
COMBAT_D->do_attack(me, target,weapon);
COMBAT_D->do_attack(me, target,weapon);

if ( lvl>=350 )
        {
        if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
                message_vision(HIW"$N"HIW"手中"+ weapon->name()+HIW"幻出奇异的光华刺向$n"HIW"！" NOR,me,target);
        COMBAT_D->do_attack(me, target,weapon);
        COMBAT_D->do_attack(me, target,weapon);
        }
if ( lvl>=500 )
        {
        if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
                message_vision(HIW"\n$N"HIW"手中"+weapon->name()+HIW"发出摄人心魄的呼啸向$n"HIW"挥去！"NOR,me,target);
        COMBAT_D->do_attack(me, target,weapon);
        COMBAT_D->do_attack(me, target,weapon);
        }
if ( lvl>=1000 )
        {       
        if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
                message_vision(HIW"\n$N"HIW"手中"+weapon->name()+HIW"竟然发出妙不可言的奇香扑向$n"HIW"！"NOR,me,target);
        COMBAT_D->do_attack(me, target,weapon);
        COMBAT_D->do_attack(me, target,weapon);    
        COMBAT_D->do_attack(me, target,weapon);
        }
me->add("force",-250);
me->add_temp("apply/attack", -extra);
me->add_temp("apply/damage", -extra);
me->start_busy(1+random(4));
return 1;
}

int help(object me)
{
string temp;    
temp = "\t\t"+to_chinese("wugou-jian")+" 等级 120 级\n";
temp+= "\t\t"+to_chinese("lingyunbu")+" 等级 120 级\n";
temp+= "\t\t内    力 1000 点\n";
temp+= "\t\t内力激发 玄宗心法\n";
temp+= "\t\t战斗中使用\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");
write(@HELP

        使用功效：
                对敌人连续攻击
        出招类型：
                busy型外功
                无隐藏攻击
                不可以叛师带出
        出手要求：              
HELP);                          
write(temp);
return 1;
}
