// drift_sense.c

#include <ansi.h>

inherit SSERVER;

int cast(object me, object target) {
  if (me->is_fighting())
    return notify_fail("战斗中无法使用金光纵地法！\n");
  if (me->query("mana") < 800)
    return notify_fail("你的法力不够！\n");
  if (me->query("sen") <= 500)
    return notify_fail("你的精神太差！\n");
  if (time() - (int)me->query_temp("drift_end") < 5 + random(5))
    return notify_fail("纵地金光法不能连续使用！\n");
  if (me->query("faith") < 500)
    return notify_fail("以你在昆仑山玉虚洞的名望，还不会使用金光纵地法。\n");
  if (me->is_ghost())
    return notify_fail("鬼魂无法使用金光纵地法！\n");
  if (me->query("family/family_name") != "昆仑山玉虚洞" && !wizardp(me) && !me->samsara_check(
    "yuxu-spells",
    1
  ))
    return notify_fail("你与昆仑无缘,领悟不到玉虚仙法的精髓!!\n");
  if (target)
    return notify_fail("金光纵地法只能对自己使用！\n");
  write("你要移动到哪一个人身边？");
  input_to((: call_other, __FILE__, "select_target", me :));
  return 1;
}

void select_target(object me, string name) {
  object ob, env;
  int i;
  object *inv;
  inv = all_inventory(me);

  if (!name || name == "") {
    write("中止施法。\n");
    return;
  }

  ob = find_player(name);
  if (!ob || !me->visible(ob) || wizardp(ob))
    ob = find_living(name);
  if (!ob || !me->visible(ob) || wizardp(ob) || !environment(ob)) {
    write("你无法感受到这个人的灵力 ....\n");
    return;
  }
  /*
for(i=0; i<sizeof(inv); i++) 
        {
        if ( userp(inv[i]) )   
                write("还是先把身上的玩家放下来再施法吧！\n");
        return;
        }
*/
  if (me->query_temp("in_dart")) {
    write("你一想到自己镖车在身，责任重大，就打消了藏匿形迹的念头！\n");
    return;
  }
  if (me->is_fighting()) {
    write("战斗中无法使用金光纵地法！\n");
    return;
  } else if (me->query("mana") < 800) {
    write("你的法力不够！\n");
    return;
  }

  me->add("mana", -75);
  me->receive_damage("sen", 30);

  message_vision(HIY "$N低头闭目，开始施展金光纵地术 ....\n" NOR, me);
  me->set_temp("drift_end", time());
  if (random((int)ob->query("max_mana")) > (int)me->query("mana") / 5) {
    write("你感受到对方的灵力，但是不够强烈。\n");
    return;
  }
  env = environment(ob);
  if (env->query("no_fight") == 1 || env->query("no_magic") == 1 || env->query("magicroom") == 1) {
    write("对方身在安全之处，你如何去得？\n");
    return;
  }
  if (domain_file(base_name(environment(ob))) == "eastway"
    || domain_file(base_name(environment(ob))) == "death"
    || domain_file(base_name(environment(ob))) == "gumu") {
    write("那里阴气好重，非你的道术所能及！\n");
    return;
  }
  if (domain_file(base_name(environment(ob))) == "12gong"
    || domain_file(base_name(environment(ob))) == "axiuluo"
    || domain_file(base_name(environment(ob))) == "axlj"
    || domain_file(base_name(environment(ob))) == "bwbj"
    || domain_file(base_name(environment(ob))) == "huashan"
    || domain_file(base_name(environment(ob))) == "sds"
    || domain_file(base_name(environment(ob))) == "sds2"
    || domain_file(base_name(environment(ob))) == "sds3"
    || domain_file(base_name(environment(ob))) == "sds4"
    || domain_file(base_name(environment(ob))) == "sds5"
    || domain_file(base_name(environment(ob))) == "shashou"
    || domain_file(base_name(environment(ob))) == "shendian"
    || domain_file(base_name(environment(ob))) == "mingjie") {
    write("那里杀气好重，非你的道术所能及！\n");
    return;
  }
  if (domain_file(base_name(environment(ob))) == "lingtai"
    || domain_file(base_name(environment(ob))) == "shushan"
    || domain_file(base_name(environment(ob))) == "tongtianjiao"
    || domain_file(base_name(environment(ob))) == "shenjian") {
    write("那里道气好重，非你的道术所能及！\n");
    return;
  }
  if (domain_file(base_name(environment(ob))) == "nanhai"
    || domain_file(base_name(environment(ob))) == "shaolin") {
    write("那里佛气好重，非你的道术所能及！\n");
    return;
  }
  message(
    "vision",
    HIY "\n一道耀眼的光芒忽然罩住" + me->name() + "，一道金光钻入地下，光芒和人一齐消失得无影无踪！\n\n",
    environment(me),
    ({ me })
  );
  me->move(env);
  me->start_busy(5);
  message("vision", HIY "\n你的眼前突然出现一团耀眼的光芒，光芒中浮现出一个人影！\n\n" NOR, environment(ob), ({ me }));
}
