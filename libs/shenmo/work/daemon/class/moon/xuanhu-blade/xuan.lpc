#include <ansi.h>
#include <combat.h>

inherit SSERVER;
int perform(object me, object target)
{
int def;
int damage,skill,i;
string msg;
object weapon = me->query_temp("weapon");
skill=me->query_skill("xuanhu-blade",1);
i = 0;

if( !target ) target = offensive_target(me);

if( !target
  ||!target->is_character()
  ||!me->is_fighting(target) )
        return notify_fail("你只能对战斗中的对手使用「玄狐再现」。\n");
    
if(me->query("family/family_name") != "月宫")
        return notify_fail("[玄狐再现]是月宫不传之密！\n");
  
if( skill < 150)
        return notify_fail("你目前功力还使不出「玄狐再现」。\n");
  
if( (int)me->query("force") < 500 )
        return notify_fail("你的内力不够。\n");
   
if( !weapon )
        return notify_fail("你必须用兵器才能使用绝技！\n");

me->add("force", -100);
msg = WHT"$N"WHT"对着$n"WHT"嫣然一笑，顿时六宫粉黛皆无颜，说时迟，那时快！$N"WHT"手中的"NOR HIC+weapon->name()
+NOR WHT"弯成了狐型，刹那间已连劈出三刀，$n"WHT"的脸顿时如纸样煞白。\n"NOR;

if( random(me->query("combat_exp")) >(int)target->query("combat_exp")/4 ) 
        {
        // target->start_busy( (int)me->query_skill("xuanhu-blade") / 20 );
        damage = skill;
        damage+=(int)me->query_skill("blade");
        damage = damage *2 + random(damage);
        def=(int)target->query_temp("apply/armor_vs_force");
        damage -=damage*def/2000;
        target->receive_damage("kee", damage,me);
        target->receive_wound("kee", damage,me);
        msg += RED
"\n只见$n"RED"已被"NOR HIC+weapon->name()+NOR RED"切得体无完肤，血如箭般由全身喷射而出！\n\n"NOR;
        target->start_busy(2+random(1+skill/150) );
        } else {
	 i=damage;
        msg += HIC "可是$p急忙抽身躲开，$P这招没有得逞。\n" NOR;
        }

//AddBy Snowtu@xmxyj2000/2003/10
if ( skill>400 )
        {
        msg += WHT"\n
却见$N"WHT"使完了这一招，再度回眸一笑，$n"WHT"顿时只觉这世上万物皆化为虚有，眼中止留得一个"+me->query("name")+WHT"
。\n$N"WHT"罗裳轻舞，抚袖藏刀，妩媚一笑。$n"WHT"只觉堕入温柔乡中，心头什么事也不再想。\n
寒光一闪！\n\n"NOR RED"$n"RED"眼带迷离，捂住喷血的伤口，呆对对面的佳人。\n\n"NOR;
	 damage+=i;
        target->receive_damage("kee", damage,me);
        target->receive_wound("kee", damage,me);
        }

message_vision(msg, me, target);
COMBAT_D->report_status(target);
COMBAT_D->report_status(target,damage);
me->start_busy(1+random(target->query_skill("force")/150));
return 1;
}

