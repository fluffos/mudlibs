
// write by windy 2011.08
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string *where = ({"左肋","右肋","前胸","后胸","小腹","后背"});
string name()  
{
return "「"HIM"问情"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name")!="月宫" && !me->samsara_check("jueqingbian")) 
        return notify_fail("你还不够资格使用"+name()+"！\n");  
if((int)me->query_skill("jueqingbian", 1) < 300) 
        return notify_fail("你的绝情鞭法修为不够，还用不出"+name()+"！\n"); 
if((int)me->query_skill("moonforce", 1) < 300 && !me->samsara_check("jueqingbian")) 
        return notify_fail("你的圆月心法修为不够，还用不出"+name()+"！\n"); 
if((int)me->query_skill("whip", 1) < 300) 
        return notify_fail("你的基础鞭术修为不够，还用不出"+name()+"！\n"); 
if((int)me->query_skill("moondance", 1) < 300) 
        return notify_fail("你的冷月凝香舞修为不够，还用不出"+name()+"！\n"); 
if( time()-(int)me->query_temp("wenqing_end") < 3+random(3))  
        return notify_fail("你难以频频使用"+name()+"！\n");  
if((int)me->query("max_force") < 3000 ) 
        return notify_fail("你的内力修为不够！\n"); 
if((int)me->query("force") < 1000 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
object weapon;
int skl,i,k,extra,mylvl,talvl;
string msg;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
skl=(int)me->query_skill("jueqingbian", 1);
mylvl=me->query_skill("whip");
mylvl+=me->query_skill("moondance", 1);
talvl=target->query_skill("parry");
extra=(int)me->query_skill("whip");
extra+= me->query_temp("apply/damage");
extra+= me->query("force_factor");
extra-= target->query_temp("apply/armor");
extra+=(int)me->query_skill("moonforce", 1);
extra-=(int)target->query_skill("buddhism", 1);
extra-=(int)target->query_skill("chanzong", 1);
if (extra<300)  extra=300;
k=skl/100;
if (k>5) k=5;
weapon = me->query_temp("weapon");
message_vision(HIM"\n$N双目凝视$n，忽然轻叹一声道：“你可知情为何物？”"NOR,me,target);
message_vision(HIM"\n那声音如泣如诉，似嗔似怨，$n不觉痴了······\n"NOR,me,target);
for(i=0;i<k;i++)
    {
    me->add("force",-50);
    message_vision(HIW"恍惚间$N手中"+ weapon->query("name")+ HIW"已闪电般抽向$n的"+HIR+where[random(sizeof

(where))]+HIW+"！\n"NOR,me,target);
    if(random(mylvl+talvl)>talvl/3)
        {
        target->receive_damage("kee",extra,me);
        target->receive_wound("kee",extra/2+random(extra/2),me);
        COMBAT_D->report_status(target,0);
        }
    }
me->set_temp("wenqing_end",time());
return 1;
}
int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("jueqingbian")+" 300 级\n"; 
temp+= "\t\t"+to_chinese("whip")+" 300 级\n"; 
temp+= "\t\t"+to_chinese("moonforce")+" 300 级\n"; 
temp+= "\t\t"+to_chinese("moondance")+" 300 级\n";  
temp+= "\t\t内力修为三十年\n";  
temp+= "\t\t内力1000点\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP  

        使用功效：  
                连续打击对手的气血
        出招类型：  
                延时型外功 
                无隐藏攻击 
                叛师不可带出  
        出手要求：    
HELP);              
write(temp);  
return 1;  
}

