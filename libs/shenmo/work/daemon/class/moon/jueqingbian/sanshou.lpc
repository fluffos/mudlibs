//lestat for moon
//2001 三无三不手

#include <ansi.h>

inherit F_DBASE;
inherit SSERVER;

string name() {
  return "「" HIM "三无三不手" NOR "」";
}

int valid_perform(object me) {
  if (time() - (int)me->query_temp("wuxue_end") < 10)
    return notify_fail("绝招用多就不灵了！\n");
  if (me->query_temp("JQB_perform"))
    return notify_fail("你已经使出" + name() + "了！\n");
  if ((int)me->query("max_force") < 1000)
    return notify_fail("你的内力修为不够！\n");
  if ((int)me->query("force") < 500)
    return notify_fail("你的内力不足！\n");
  if ((int)me->query("sen") < 50)
    return notify_fail("你的精神不足，没法子施用外功！\n");
  if ((int)me->query_skill("jueqingbian", 1) < 100)
    return notify_fail("你的绝情鞭级别还不够施展这一招" + name() + "!!\n");
  if ((int)me->query_skill("moondance", 1) < 100)
    return notify_fail("你的冷月凝香舞等级不够!!\n");
  if ((int)me->query_skill("moonforce", 1) < 100)
    return notify_fail("你的圆月心法等级太低!!\n");
  if ((int)me->query_skill("moonshentong", 1) < 100)
    return notify_fail("你的月宫仙法等级不够!!\n");
  if ((string)me->query("gender") != "女性" && !me->query("任务"))
    return notify_fail("你非为纯阴之身,怎能知哓女儿家的心思??\n");
  if (me->query("family/family_name") != "月宫" && !me->samsara_check("jueqingbian", 1))
    return notify_fail("你与痴梦无缘,领悟不到鞭法的精髓!!\n");
  return 1;
}

int perform(object me, object target) {
  object weapon;
  int skill;
  string msg;
  if (!valid_perform(me))
    return 0;
  if (!target)
    target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "?\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用!!\n");

  weapon = me->query_temp("weapon");
  msg = HIC "\n问世间情为何物?直叫人生死相许!$N心中一阵酸楚,鞭法忽然变得灵动异常!\n" NOR;
  message_vision(msg, me, target);
  skill = me->query_skill("whip");
  me->set_temp("JQB_perform", 1);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  if (skill > 299 && me && target && living(me) && me->is_fighting(target)) {
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  }
  if (skill > 599 && me && target && living(me) && me->is_fighting(target)) {
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  }
  if (skill > 899 && me && target && living(me) && me->is_fighting(target)) {
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  }
  me->start_call_out((: call_other, __FILE__, "checking", me, target :), 1);
  me->start_call_out((: call_other, __FILE__, "remove_effect", me :), skill / 2);
  me->add("force", -200);
  return 1;
}

void checking(object me, object target) {
  object weapon;
  if (!me) return;

  if ((me->query_temp("weapon")))
    weapon = me->query_temp("weapon");
  if (me->query_temp("JQB_perform")) {
    if (!target || !me->is_fighting(target)) {
      tell_object(me, "\n你现在没有和人过招，当下收回了「三无三不手」的攻势。\n\n" NOR);
      me->delete_temp("JQB_perform");
      me->set_temp("JQB_end", time());
      return;
    } else if (!objectp(weapon = me->query_temp("weapon"))
      || (string)weapon->query("skill_type") != "whip") {
      tell_object(me, "\n你手中没有持鞭，「三无三不手」的攻势便即瓦解！\n" NOR);
      me->delete_temp("JQB_perform");
      me->set_temp("JQB_end", time());
      return;
    } else if (weapon->query("weapon_prop") == 0) {
      tell_object(me, "\n你的" + weapon->name() + "已毁，无法持续「三无三不手」的攻势！\n\n" NOR);
      me->delete_temp("JQB_perform");
      me->set_temp("JQB_end", time());
      return;
    } else if ((int)me->query("force") < 400) {
      tell_object(me, "\n你的内力后继不足，难以持续「三无三不手」的威力，只好收缓剑招。\n\n" NOR);
      me->delete_temp("JQB_perform");
      me->set_temp("JQB_end", time());
      return;
    } else if (me->query_skill_mapped("whip") != "jueqingbian") {
      tell_object(me, "\n你转而施展其他鞭法，无法再以「三无三不手」攻敌！\n\n" NOR);
      me->delete_temp("JQB_perform");
      me->set_temp("JQB_end", time());
      return;
    } else me->start_call_out((: call_other, __FILE__, "checking", me, target :), 1);
  }
}

void remove_effect(object me, int amount) {
  if (!me)
    return;
  if (me->query_temp("JQB_perform")) {
    message_vision(HIM "$N心头一酸,一颗泪珠滴了下来。\n" NOR, me);
    me->delete_temp("JQB_perform");
    me->set_temp("JQB_end", time());
  }
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("jueqingbian") + " 100 级\n";
  temp += "\t\t" + to_chinese("moondance") + " 100 级\n";
  temp += "\t\t" + to_chinese("moonshentong") + " 100 级\n";
  temp += "\t\t" + to_chinese("moonforce") + " 100 级\n";
  temp += "\t\t内力修为十年\n";
  temp += "\t\t内力５００点\n";
  temp += "\t\t精神５０点\n";
  temp += "\t\t必须为女性\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                连续打击敌人的气血，并且大幅度提升自己的战力
        出招类型：
                延时型外功
                有隐藏攻击
                不可以叛师带出
        出手要求：              
HELP);
  write(temp);
  return 1;
}
