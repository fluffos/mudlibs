#include <ansi.h>
inherit SSERVER;

string name() {
  return "「" HIY "昆仑·一落" NOR "」";
}

int valid_perform(object me) {
  int time;
  if (me->query("family/family_name") != "月宫" && !me->samsara_check("snowsword", 1))
    return notify_fail(name() + "乃是月宫不传之密。\n");
  if (me->query_skill("snowsword", 1) < 80)
    return notify_fail("你的" + to_chinese("snowsword") + "等级不足80，不能施展" + name() + "。\n");
  if (me->query_skill("moondance", 1) < 80)
    return notify_fail("你的" + to_chinese("moondance") + "等级不足80，不能施展" + name() + "。\n");
  if (me->query("force") < 100)
    return notify_fail("你内力不足 100 点，不能施展" + name() + "。\n");
  if (me->query("max_force") < 500)
    return notify_fail("你内力修为不足 500 点，不能施展" + name() + "。\n");
  if (time() < me->query_temp("moon_yiluo") + 3)
    return notify_fail("绝招用多就不灵了。\n");
  return 1;
}

int perform(object me, object target) {
  string msg, str;
  int damage, ap, dp, lvl;
  object weapon;

  if (!valid_perform(me))
    return 0;
  if (!target)
    target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || !me->is_fighting(target))
    return notify_fail(name() + "必须在战斗中使用。\n");

  lvl = me->query_skill("snowsword", 1);
  lvl += me->query_skill("moondance", 1);
  lvl /= 2;
  lvl /= 20;
  if (lvl > 9) lvl = 9;
  if (lvl < 1) lvl = 1 + random(2);
  weapon = me->query_temp("weapon");

  damage = me->query_skill("snowsword", 1);
  damage += me->query_temp("apply/damage");
  damage += me->query_temp("apply/attack");
  damage += me->query("force_factor");
  damage -= random(target->query_temp("apply/armor"));
  if (COMBAT_D->restrain(me, target))
    damage += random(damage / 10);
  if (COMBAT_D->restrain(target, me))
    damage -= random(damage / 10);
  if (target->query("family/family_name") == "月宫")
    damage -= random(target->query_skill("dodge"));
  if (damage)
    damage = (damage / 2 + random(damage / 2)) / 3 * lvl;
  if (me->query("force_factor") == 0)
    damage += random(damage / 3);
  ap = me->query_skill("snowsword", 1);
  ap += me->query_skill("moondance", 1);
  ap /= 60;
  ap = ap / 10 * ap * ap;
  ap += me->query("combat_exp") / 500;
  dp = target->query_skill("parry", 1);
  dp += target->query_skill("dodge", 1);
  dp /= 60;
  dp = dp / 10 * dp * dp;
  dp += target->query("combat_exp") / 500;
  str = sprintf("初始：攻击方判断点 %d ，受攻击方判断点 %d\n", ap, dp);
  if (COMBAT_D->restrain(me, target))
    ap += random(ap / 5);
  if (COMBAT_D->restrain(target, me))
    dp += random(dp / 5);
  str += sprintf("相克：攻击方判断点 %d ，受攻击方判断点 %d\n", ap, dp);

  if (wizardp(me))
    tell_object(me, str);

  msg = HIC "\n$N" HIC "使出" + name() + HIC "，" + weapon->query("name") + HIC + "剑尖一颤，抖出" + chinese_number(lvl) + "朵剑花,直刺$n" HIC "。\n" + NOR;
  message_vision(msg, me, target);
  me->add("force", -100);
  me->set_temp("moon_yiluo", time());
  msg = "";
  if (random(ap + dp) > dp && damage) {
    message_vision(
      HIR "$n" HIR "眼前一花,身上已被划出" + chinese_number(lvl) + "道伤口，血流不止。\n" NOR,
      me,
      target
    );
    target->receive_wound("kee", damage, me);
    if (target->query("kee") > damage / 10)
      target->receive_damage("kee", damage / 10, me);
    COMBAT_D->report_status(target);
  } else message_vision(CYN "\n$n" CYN "身形一展,轻轻巧巧躲过了这招.\n" + NOR, me, target);
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("snowsword") + " 80 级\n";
  temp += "\t\t" + to_chinese("moondance") + " 80 级\n";
  temp += "\t\t内    力 100 点\n";
  temp += "\t\t内力修为 500 点\n";
  temp += "\t\t战斗状态下使用\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                给敌人造成严重的伤势
        出招类型：
                延迟型外功
                不可以叛师带出
        出手要求：              
HELP);
  write(temp);
  return 1;
}
