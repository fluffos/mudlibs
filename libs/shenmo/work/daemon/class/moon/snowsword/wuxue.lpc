#include <ansi.h>
inherit SSERVER;

string name()
{
return "「"HIW"昆仑·舞雪"NOR"」";
}

int valid_perform(object me)
{
int time;       
if ( me->query("family/family_name") != "月宫"  && !me->samsara_check("snowsword",1))
        return notify_fail(name()+"乃是月宫不传之密。\n");
if ( me->query_skill_mapped("dodge") != "moondance" )
        return notify_fail("你还没有施展冷月凝香舞呢。\n");
if ( me->query_skill_mapped("force")!="moonforce")
        return notify_fail(name()+"必须配合圆月心法才能使用。\n");
if ( me->query_skill("dodge")<100 )
        return notify_fail("你的轻功有效等级不足100，无法施展"+name()+"。\n");
if ( me->query_skill("force")<100 )
        return notify_fail("你的内功有效等级不足100，无法施展"+name()+"。\n");
if ( me->query_skill("sword")<100 )
        return notify_fail("你的剑法有效等级不足100，无法施展"+name()+"。\n");
if ( me->query("force")<50)
        return notify_fail("你内力不足 50 点，不能施展"+name()+"。\n");
if ( me->query_temp("moon_wuxue") )
        return notify_fail("你已经在运功中了。\n");
return 1;               
}

void remove_effect(object me);
 
int perform(object me, object target)
{
if ( !valid_perform(me) )
        return 0;
        
me->add("force", -50);
message_vision(
HIW"$N"HIW"略一提气，运起轻功，拔剑起舞。只见$N"HIW"足不沾地，手中剑越舞
越快，逐渐幻做一团白雾，满堂滚动。\n" NOR,me);
me->set_temp("moon_wuxue",1);
me->add_temp("apply/attack",150);
//me->add_temp("apply/dodge",200);
me->start_call_out( (: call_other, __FILE__, "remove_effect", 
                me :), me->query_skill("sword")/5);
return 1;
}
 
void remove_effect(object me)
{
int dodge_amount,attack_amount;
if ( !me || !me->query_temp("moon_wuxue") )
        return;
me->add_temp("apply/attack",-150);
//me->add_temp("apply/dodge",-200);
me->delete_temp("moon_wuxue");
message_vision(HIW"$N"HIW"渐感气力不支，不得不放慢脚步，放缓剑招。\n"NOR,me);
}

int help(object me)
{
string temp;    
temp = "\t\t"+to_chinese("sword")+"有效等级 100 级\n";
temp+= "\t\t"+to_chinese("force")+"有效等级 100 级\n";
temp+= "\t\t"+to_chinese("dodge")+"有效等级 100 级\n";
temp+= "\t\t内    力 50 点\n";
temp+= "\t\t激发"+to_chinese("moondance")+"\n";
temp+= "\t\t激发"+to_chinese("moonforce")+"\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");
write(@HELP

        使用功效：
                增加自身的闪避力和攻击频率
        出招类型：
                辅助型外功
                无隐藏攻击
                不可以叛师带出
        出手要求：              
HELP);                          
write(temp);
return 1;
}
