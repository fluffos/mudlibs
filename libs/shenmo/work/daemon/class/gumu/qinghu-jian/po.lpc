
// modify by windy 06/05/20
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIC"破·暴风刃"NOR"」";  
}

int valid_perform(object me)
{
if (me->query("family/family_name") != "轩辕古墓" && me->query_skill("qinghu-jian", 1) < 350)
        return notify_fail("你还不够资格使用"+name()+"！\n"); 
if ( me->query("class")!="yao" && !me->samsara_check("qinghu-jian"))
        return notify_fail("你还不够资格！\n"); 
if((int)me->query_skill("qinghu-jian", 1) < 100) 
        return notify_fail("你的青狐剑法根基太差，难以施展"+name()+"！\n"); 
if((int)me->query("max_force") < 1000 )
        return notify_fail("你的内力修为不够！\n"); 
if((int)me->query("force") < 500 )
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
string msg; 
int extra, myexp, hisexp; 
object weapon, myweapon; 
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
if (!objectp(myweapon = me->query_temp("weapon")))
        return notify_fail(" 你手中没有兵刃，无法施展"+name()+"。\n");

extra = me->query_skill("qinghu-jian",1) ; 
extra+= me->query("apply/damage") ; 
weapon = target->query_temp("weapon");
myexp = (int)me->query("combat_exp"); 
hisexp= (int)target->query("combat_exp"); 

msg = HIC "$N手中"+myweapon->name()+HIC"在空中划了一了半圆，同时大喝一声"+HIW"破·暴风刃！
"HIY"$n眼前处处是寒光剑影，顿感感到一股巨大的压力冲击着自己。\n";
message_vision(msg, me, target);

if(random(hisexp) < myexp*2/3 && weapon)
    {
    msg = "突然$n觉得手臂一麻，手中";
    msg += weapon->name();
    msg += "脱手而出！\n" NOR;
    message_vision(msg, me, target);
    weapon->move(environment(me));
    return 1;
    }
else
    {
    msg = "危急之中$n发现自己没有武器，只得挥舞着双手胡乱招架！\n";
    message_vision(msg, me, target);
    if(random(hisexp) < myexp*2/3 )
        {
        target->receive_damage("kee", extra*2, me);
        target->receive_wound("kee", extra, me);
        COMBAT_D->report_status(target);
        }
    else
        {
        msg = "可是$n看破了$N的企图，使$N的「破·暴风刃」没有起到作用。\n"NOR;
        message_vision(msg, me, target);
        }
    }
me->add("force", -200); 
me->start_busy(2);
return 1; 
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("qinghu-jian")+" 100 级\n"; 
temp+= "\t\t内力修为十年\n";  
temp+= "\t\t内力５００点\n";  
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP  

        使用功效：  
                打掉敌人的武器或者伤害敌人的气血
        出招类型：   
                busy 型外功   
                无隐藏攻击 
                叛师可带出    
        出手要求：  
HELP);   
write(temp);   
return 1;   
}
