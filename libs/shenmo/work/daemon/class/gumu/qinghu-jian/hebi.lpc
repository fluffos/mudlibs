
//qinghu-jian perform hebi 紫青合璧 風雷四擊
// modify by windy 2006-05-20
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name()  
{
return "「"MAG"紫青合璧"NOR"」";  
}

int valid_perform(object me)
{
if((me->query("family/family_name") != "轩辕古墓" || me->query("class")!="yao") && !me->samsara_check("qinghu-jian",1))
        return notify_fail("就凭你也想使用"+name()+"！\n"); 
if(me->query_skill("qinghu-jian", 1) < 200) 
        return notify_fail("你的青狐剑法根基太差，难以施展"+name()+"！\n"); 
if(me->query_skill("zizhi-blade", 1) < 200) 
        return notify_fail("你的紫雉刀法根基太差，难以施展"+name()+"！\n"); 
if (me->query_skill_mapped("blade")!="zizhi-blade") 
        return notify_fail(name()+"没有紫雉刀法配合是不行的。\n"); 
if(me->query_skill("jiuyin-force", 1) < 200) 
        return notify_fail("你的玄天九阴真经根基太差，难以施展"+name()+"！\n"); 
if(me->query_skill("blade", 1) < 200) 
        return notify_fail("你的基本刀法根基太差，难以施展"+name()+"！\n"); 
if(me->query_skill("sword", 1) < 200) 
        return notify_fail("你的基本剑术根基太差，难以施展"+name()+"！\n"); 
if((int)me->query("max_force") < 2000 )
        return notify_fail("你的内力修为不够！\n"); 
if((int)me->query("force") < 1000 )
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
string msg; 
int mysword, myblade, myskill1,myskill2, taparry, tadodge, myforce, taforce, myexp, taexp, mylvl, talvl, damage;
object weapon,tweapon;

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

weapon = me->query_temp("weapon");
tweapon = target->query_temp("weapon");
mysword= me->query_skill("sword",1);
myblade= me->query_skill("blade",1);
myskill1= me->query_skill("qinghu-jian",1);
myskill2= me->query_skill("zizhi-blade",1);
taparry= target->query_skill("parry",1);
tadodge= target->query_skill("dodge",1);
myforce= (int)me->query("max_force");
taforce= (int)target->query("max_force");
myexp= (int)me->query("combat_exp");
taexp= (int)target->query("combat_exp");
mylvl= me->query("level");
talvl= target->query("level");

message_vision(HIM"$N双手一扬，只见刀剑齐飞，紫青乍现，使出了轩辕古墓的绝学--『风雷四击』！\n\n" NOR,me,target);
message_vision(MAG"$N左手一挥，一招『紫雷天矶』挟着滚滚雷声源源不断的劈向$n"MAG"！\n"NOR,me,target);
if (random(myexp) > taexp/4) 
        {
        msg = MAG"$n"MAG"只觉得一股劲气象闪电炸雷一般，穿体而过！\n"NOR;
        damage=myblade + myskill2;
        damage=damage + random(damage);
        target->receive_damage("kee", damage, me);
        target->receive_wound("kee", damage/2, me);
        message_vision(msg, me, target);
        COMBAT_D->report_status(target);
        }
else    {
        msg = HIC"$n"HIC"忙运功向抗，深厚的内力将$N的攻势都激散了。\n"NOR;
        message_vision(msg, me, target);
        }

message_vision(HIG"$N右手一挥，一招『青风破邪』划过一道青光，如闪电般飞至$n"HIG"！\n" NOR,me,target);
if (random(mylvl) > talvl/4) 
        {
        msg = HIG"$n"HIG"马上手忙脚乱，不知该如何去招架这股劲风！\n"NOR;
        damage=mysword + myskill1;
        damage=damage + random(damage);
        target->receive_damage("kee", damage, me);
        target->receive_wound("kee", damage/2, me);
        message_vision(msg, me, target);
        COMBAT_D->report_status(target);
        }
else    {
        msg = HIC"$n"HIC"丝毫不显慌乱,绕过风头,瓦解了$N这激烈的攻势。\n"NOR;
        message_vision(msg, me, target);
        }

message_vision(HIB"$N双手一分，一招『大道归源』气势磅礴，加之风吼雷鸣，震人心神！\n" NOR,me,target);
if (random(mysword/2+myskill1+myblade/2+myskill2) > (taparry+tadodge)/4) 
        {
        msg = HIB"$n"HIB"见那刀剑齐齐扑面而来，不仅骇然，手足无措！\n"NOR;
        damage=mylvl*2;
        damage=damage + random(damage);
        target->receive_damage("sen", damage, me);
        target->receive_wound("sen", damage/2, me);
        message_vision(msg, me, target);
        COMBAT_D->report_sen_status(target);
        }
else    {
        msg = HIC"$n"HIC"却心静如水,见招拆招,瓦解了$N这气势磅礴的攻势。\n"NOR;
        message_vision(msg, me, target);
        }

message_vision(HIW"$N双手一合，一招『紫青合璧』将轩辕古墓派的武学精髓发挥地淋漓尽致！\n" NOR,me,target);
if (random(myforce) > taforce/20) 
        {
        msg = HIW"$n"HIW"已是万难招架，牙关一咬硬硬地受了这一击！\n"NOR;
        damage=myforce/10;
        damage=damage + random(damage);
        target->receive_damage("kee", damage, me);
        target->receive_wound("kee", damage/2, me);
        target->receive_damage("sen", damage, me);
        target->receive_wound("sen", damage/2, me);
        message_vision(msg, me, target);
        COMBAT_D->report_status(target);
        COMBAT_D->report_sen_status(target);
        }
else    {
        msg = HIC"$n身形一低,刀剑分合的瞬间轻轻跃起，避过了致命的一击！\n"NOR;
        message_vision(msg, me, target);
        }
me->add("force", -500); 
me->start_busy(2);
return 1; 
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("qinghu-jian")+" 200 级\n"; 
temp+= "\t\t"+to_chinese("sword")+" 200 级\n"; 
temp+= "\t\t"+to_chinese("zizhi-blade")+" 200 级\n"; 
temp+= "\t\t"+to_chinese("blade")+" 200 级\n"; 
temp+= "\t\t"+to_chinese("jiuyin-force")+" 200 级\n"; 
temp+= "\t\t必须激发刀法为紫雉刀法\n";  
temp+= "\t\t内力修为二十年\n";  
temp+= "\t\t内力１０００点\n";  
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP  

        使用功效：  
                连续打击敌人的气血和精神
        出招类型：   
                busy 型外功   
                无隐藏攻击 
                叛师不可带出    
        出手要求：  
HELP);   
write(temp);   
return 1;   
}
