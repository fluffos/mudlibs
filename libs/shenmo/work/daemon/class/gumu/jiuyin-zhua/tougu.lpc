
//modify by windy 06/05/20
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() 
{
return "「"HIW"神爪透骨"NOR"」";   
}

int valid_perform(object me) 
{
if ( !me )   return 0; 
if (( me->query("family/family_name")!="轩辕古墓" || me->query("class")!="yao" ) && !me->samsara_check("jiuyin-zhua",1))
        return notify_fail(name()+"是轩辕古墓不传之密！\n"); 
if( time()-(int)me->query_temp("tougu_end") < 4) 
        return notify_fail("你现在真气不纯。\n");   
if (me->query_skill("jiuyin-zhua",1)<80)  
        return notify_fail("你的九阴白骨爪等级不够，难以施展"+name()+"。\n"); 
if (me->query("force")<300)
        return notify_fail("你内力不继，难以出招。\n"); 
return 1; 
}

int perform(object me, object target)
{
string msg; 
object weapon; 
int skill, ap, dp; 
int force_wound, kee_wound;

if ( !valid_perform(me) ) 
        return 0;   
if( !target ) target = offensive_target(me);
if( !target
||      !target->is_character()
||      target->is_corpse()
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if (!me->is_fighting())
        return notify_fail(name()+"只能在战斗中使用！\n"); 

msg = HIW " 
$N突然脸色苍白，眼神中显出一丝戾气，一声清啸你越起数丈，居高临下 
五指箕张，向着$n"HIW"直扑而来，正是九阴白骨爪绝学——"+HIB"「神爪透骨」！\n"NOR; 
message_vision(msg, me, target);
skill = me->query_skill("jiuyin-zhua",1); 
ap = me->query("level") + skill;
dp = target->query("level");
if( dp < 1 )
        dp = 1; 
if( random(ap+dp) > (dp/2) )
        {
        me->add("force",-100); 
        msg = HIR " 
$n"HIR"突然觉得左腿一凉，一股寒气直窜丹田，低头一看，左腿上已被$N抓出五个血洞！\n"NOR;  
        force_wound = 200 + random(skill)*3; 
        if(force_wound > target->query("force")) 
                force_wound = target->query("force"); 
        kee_wound = 200 + random(skill)*3; 
        if(kee_wound > target->query("eff_kee"))
                kee_wound = target->query("eff_kee")+1; 
        target->add("force",-force_wound); 
        target->receive_damage("kee", kee_wound,me); 
        target->receive_wound("kee", kee_wound,me); 
        }
else    {
        msg = HIY "$n"HIY"慌忙中翻倒在地，就势一滚，狼狈的躲开了$N的猎猎爪风！\n"NOR;
        me->add("force",-100); 
        me->start_busy(2);
        }
message_vision(msg, me, target);
me->set_temp("tougu_end",time()); 
return 1; 
}

int help(object me)  
{
string temp;  
temp = "\t\t"+to_chinese("jiuyin-zhua")+" 80 级\n";  
temp+= "\t\t内力３００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP  

        使用功效： 
                强力伤害敌人的气血并且破坏敌人的内力
        出招类型： 
                延时型外功，失败后会有 busy
                有隐藏攻击 
                叛师不可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
