//modify by windy 06/05/20
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() {
  return "「" HIG "玲珑连环" NOR "」";
}

int valid_perform(object me) {
  if (!me) return 0;
  if (me->query("family/family_name") != "轩辕古墓" && me->query_skill("zizhi-blade", 1) < 350)
    return notify_fail(name() + "是轩辕古墓不传之密！\n");
  if (me->query("class") != "yao" && !me->samsara_check("zizhi-blade"))
    return notify_fail("你还不够资格！\n");
  if (time() - (int)me->query_temp("lianhuan_end") < 3 + random(3))
    return notify_fail("绝招用多就不灵了。\n");
  if (me->query_skill("zizhi-blade", 1) < 120)
    return notify_fail("你的紫雉刀法等级不够，难以施展" + name() + "。\n");
  if (me->query_skill("force", 1) < 120)
    return notify_fail("你的内功心法等级不够，难以施展" + name() + "。\n");
  if (me->query_skill("blade", 1) < 120)
    return notify_fail("你的基本刀法等级不够，难以施展" + name() + "。\n");
  if (me->query("max_force") < 800)
    return notify_fail("你内力修为太差。\n");
  if (me->query("force") < 400)
    return notify_fail("你内力不继，难以出招。\n");
  if (me->query("sen") < 400)
    return notify_fail("你现在精神不足，难以出招。\n");
  return 1;
}

int perform(object me, object target) {
  object weapon = me->query_temp("weapon");
  int extra, damage;
  string msg;

  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用！\n");

  extra = me->query_skill("blade", 1) / 5;
  extra += me->query_skill("force", 1) / 5;
  extra += me->query("level") / 3;
  damage = extra * 3;

  message_vision(HIG "\n$N刀势突转，使出了玄天紫雉刀的绝学----玲珑连环！\n\n" NOR, me, target);
  me->add_temp("apply/attack", extra);
  me->add_temp("apply/damage", extra);
  message_vision(HIG "第一招----风玲珑，$N手中的刀如一阵疾风般攻向$n" HIG "！\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR);
  message_vision(HIM "第二招——花玲珑，$N手中的刀连刺五刀如一朵盛放的梅花！\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR);
  message_vision(HIW "第三招——雪玲珑！$N手中的刀突闪一道寒光，如片片雪花！\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR);
  message_vision(HIC "第四招——月玲珑！$N手中的刀从上至下，斜劈下来，犹如一轮弯月！\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR);
  me->add_temp("apply/attack", -extra);
  me->add_temp("apply/damage", -extra);
  if ((me->query("family/family_name") == "轩辕古墓" || me->samsara_check(
    "zizhi-blade",
    1
  )) && me->query_skill(
    "zizhi-blade",
    1
  ) > 499 && random(me->query("level")) > target->query("level") / 2) {
    message_vision(HIW "\n风花雪月·玲珑连环，$n" HIW "早就被着良辰美景搞得飘飘然了，哪里还记得自己在战斗......\n" NOR, me, target);
    target->receive_damage("kee", damage, me);
    target->receive_wound("kee", damage / 2, me);
    target->receive_damage("sen", damage, me);
    target->receive_wound("sen", damage / 2, me);
    COMBAT_D->report_status(target);
    COMBAT_D->report_sen_status(target);
  }
  me->add("force", -100);
  me->receive_damage("sen", 100);
  me->set_temp("lianhuan_end", time());
  if (me->query("family/family_name") != "轩辕古墓" && !me->samsara_check("zizhi-blade", 1))
    me->start_busy(2);
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("zizhi-blade") + " 120 级\n";
  temp += "\t\t" + to_chinese("blade") + " 120 级\n";
  temp += "\t\t" + to_chinese("force") + " 120 级\n";
  temp += "\t\t内力修为八年\n";
  temp += "\t\t内力４００点\n";
  temp += "\t\t精神４００点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP  

        使用功效： 
                连续打击敌人的气血
        出招类型： 
                延时型外功
                古墓弟子使用有隐藏攻击 
                叛师可带出 
        出手要求：               
HELP);
  write(temp);
  return 1;
}
