
//modify by windy 06/05/20
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() 
{
return "「"WHT"刀影连身"NOR"」";   
}

int valid_perform(object me) 
{
if ( !me )   return 0; 
if (( me->query("family/family_name")!="轩辕古墓" || me->query("class")!="yao" ) && !me->samsara_check("zizhi-blade",1))
        return notify_fail(name()+"是轩辕古墓不传之密！\n"); 
if( time()-(int)me->query_temp("daoying_end") < 4) 
        return notify_fail("你现在真气不纯。\n");   
if (me->query_skill("jiuyin-zhua",1)<60)  
        return notify_fail("你的九阴白骨爪等级不够，难以施展"+name()+"。\n"); 
if (me->query_skill("zizhi-blade",1)<60) 
        return notify_fail("你的紫雉刀法等级不够，难以施展"+name()+"。\n"); 
if (me->query_skill("jiuyin-force",1)<60) 
        return notify_fail("你的玄天九阴真经等级不够，难以施展"+name()+"。\n"); 
if (me->query_skill_mapped("force")!="jiuyin-force") 
        return notify_fail("没有九阴真力如何使用"+name()+"？\n"); 
if (me->query_skill_mapped("unarmed")!="jiuyin-zhua")
        return notify_fail(name()+"没有九阴爪配合是不行的。\n"); 
if (me->query("force")<150)
        return notify_fail("你内力不继，难以出招。\n"); 
return 1; 
}

int perform(object me, object target)
{
object weapon=me->query_temp("weapon"); 
int enhance,damage;
string str;
if ( !valid_perform(me) ) 
        return 0;   
if( !target ) target = offensive_target(me);
if( !target
||      !target->is_character()
||      target->is_corpse()
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if (!me->is_fighting())
        return notify_fail(name()+"只能在战斗中使用！\n"); 

message_vision(HIW"
$N默运九阴真力，刀爪齐施，晃晃刀影中，夹杂着无数爪风。
霎时间，风走沙滚，刀光爪影，当真是刀刀连身，爪爪要命！\n"NOR,me);

if (random(me->query("level")) > target->query("level")/3 && !target->is_busy())
        target->start_busy(1+random(3));

enhance=me->query_skill("jiuyin-zhua",1);
me->add_temp("apply/attack", enhance);
damage=me->query_skill("jiuyin-force",1);
damage+=me->query("level");
damage=damage/2;
me->add_temp("apply/damage",damage); 

COMBAT_D->do_attack(me, target, weapon);
if ( weapon && weapon==me->query_temp("weapon") )  weapon->unequip();
COMBAT_D->do_attack(me, target);
if ( weapon && weapon!=me->query_temp("weapon") )  weapon->wield();

me->add_temp("apply/attack",-enhance);
me->add_temp("apply/damage",-damage); 
me->reset_action();
me->set_temp("daoying_end",time()); 
return 1;
}

int help(object me)
{
string temp; 
temp = "\t\t"+to_chinese("zizhi-blade")+" 60 级\n"; 
temp+= "\t\t"+to_chinese("jiuyin-zhua")+" 60 级\n";  
temp+= "\t\t"+to_chinese("jiuyin-force")+" 60 级\n";
temp+= "\t\t必须激发玄天九阴真功\n";
temp+= "\t\t必须激发九阴白骨爪\n";
temp+= "\t\t内力 150 点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP  

        使用功效： 
                给对手强有力的两击
        出招类型： 
                延时型外功
                无隐藏攻击 
                叛师不可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
