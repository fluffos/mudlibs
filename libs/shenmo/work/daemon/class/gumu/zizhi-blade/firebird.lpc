//modify by windy 06/05/20
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() {
  return "「" HIR "火鸟飞天" NOR "」";
}

int valid_perform(object me) {
  if (!me) return 0;
  if (me->query("family/family_name") != "轩辕古墓" && me->query_skill("zizhi-blade", 1) < 350)
    return notify_fail("你还不够资格使用" + name() + "！\n");
  if (me->query("class") != "yao" && !me->samsara_check("zizhi-blade"))
    return notify_fail("你还不够资格！\n");
  if (me->query_skill("zizhi-blade", 1) < 100)
    return notify_fail("你的紫雉刀法修为太浅，还施展不出" + name() + "！\n");
  if (me->query_skill("blade", 1) < 100)
    return notify_fail("你的基本刀法修为太浅，还施展不出" + name() + "！\n");
  if ((int)me->query("max_force") < 500)
    return notify_fail("你的内力修为太差。\n");
  if ((int)me->query("force") < 300)
    return notify_fail("你的内力不足！\n");
  if (time() - (int)me->query_temp("firebird_end") < 2 + random(3))
    return notify_fail("此技过于费力，少用为好！\n");
  return 1;
}

int perform(object me, object target) {
  object weapon;
  int ap, dp, mylvl, talvl, damage;
  string msg;

  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用！\n");

  weapon = me->query_temp("weapon");
  ap = me->query_skill("zizhi-blade", 1);
  dp = target->query_skill("parry", 1);
  mylvl = me->query("level");
  talvl = target->query("level");
  damage = me->query_skill("blade", 1);
  damage += random(me->query_skill("blade", 1));
  damage += me->query("force_factor") * 2;
  if (me->query("family/family_name") == "轩辕古墓" || me->samsara_check("zizhi-blade", 1))
    damage += me->query("level");

  message_vision(HIR "\n$N把" + weapon->query("name") + HIR "举过头顶，积聚全身力量，一刀劈出！\n" NOR, me, target);
  message_vision(MAG "\n刀锋带着一道紫色火焰划过,犹如一只火鸟冲天而起！\n" NOR, me, target);
  if (random(ap + mylvl) > (dp + talvl) / 3) {
    message_vision(HIB "\n$n" HIB "周身被紫色火焰包围着......\n" NOR, me, target);
    target->receive_damage("kee", damage, me);
    target->receive_wound("kee", damage, me);
    COMBAT_D->report_status(target);
    me->add("force", -200);
  } else {
    message_vision(HIG "\n$n" HIG "急忙后跃，才堪堪躲开火焰的攻击！\n" NOR, me, target);
    me->add("force", -100);
  }
  me->set_temp("firebird_end", time());
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("zizhi-blade") + " 100 级\n";
  temp += "\t\t" + to_chinese("blade") + " 100 级\n";
  temp += "\t\t内力修为五年\n";
  temp += "\t\t内力３００点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP 

        使用功效： 
                给对手强有力的一击
        出招类型： 
                延时型外功
                无隐藏攻击 
                叛师可带出 
        出手要求：               
HELP);
  write(temp);
  return 1;
}
