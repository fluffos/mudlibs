#include <ansi.h>
inherit PERFORM;

int set_damage()
{
int damage;
object me = this_player();
damage=(int)me->query_skill("blade")+random((int)me->query_skill("blade")); 
damage/=40;
return damage;
}

void create()
{
int damage;
damage=set_damage();
set("name",HIG"［玲珑连环］"NOR);
set("class","yao");
set("belong","zizhi-blade");
set("base_type","blade");
set("target",1);
set("force",800);
set("need_force",100);
set("betray_lvl",350);
set("limit_skill",([
    "zizhi-blade":120,
    "blade":120,
    "force":120,
]));
set("limit_other",([
    "sen"   : 400,
]));
set("double_hit",([
         "num" : 4,
   "t_del_env"     :       1,    
     "me_del_env"    :       1, 
    "attack"    :   damage,
]));
set("persent",120);
set("busy_self",(2+random(2)));
}

void hit_msg(object me,object target,int num)
{


  if(me&&target&&num==1)
{
           message_vision(HIG"\n$N刀势突转使出玄天紫雉刀的绝学--玲珑连环！！\n"NOR,me,target); 
target->set_busy(1+random(2));
}
}


void double_hit_msg(object me,object target,int num)
{
object weapon=me->query_temp("weapon");
string *hit_msg,msg;
hit_msg=({
          HIW"\n第一招----风玲珑，$N手中的"+ weapon->name()+  "如一阵疾风般攻向$n！\n" NOR,
          HIC"第二招——花玲珑，$N手中的"+ weapon->name()+  "连刺五刀如一朵盛放的梅花！\n"NOR,
          HIW"第三招——雪玲珑！$N手中的"+ weapon->name()+  "突闪一道寒光，如片片雪花！\n"NOR,
          HIC"第四招——月玲珑！$N手中的"+ weapon->name()+  "从上至下，之劈下来，犹如一轮弯月！\n"NOR,
});
msg=hit_msg[num];
message_vision(msg,me,target);
return;
}
int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("zizhi-blade")+" 120 级\n"; 
temp+= "\t\t"+to_chinese("blade")+" 120 级\n"; 
temp+= "\t\t"+to_chinese("force")+" 120 级\n"; 
temp+= "\t\t精神 400 点\n"; 
temp+= "\t\t内力 800 点\n"; 
write(@HELP 
紫雉刀法 之 「玲珑连环」：

        使用功效： 
                连续打击对手的气血
        出招类型： 
                busy型外功
                无隐藏攻击 
                叛师可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
