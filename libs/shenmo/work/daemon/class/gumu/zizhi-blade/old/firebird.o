#include <ansi.h>
inherit PERFORM;

int set_damage()
{
int damage;
object me = this_player();
damage+= me->query("force_factor")*2;
damage=(int)me->query_skill("blade")+random((int)me->query_skill("blade")); 
damage+= me->query_temp("apply/damage");
return damage;
}

void create()
{
set("name",HIR"火鸟"NOR);
set("class","yao");
set("belong","zizhi-blade");
set("base_type","blade");
set("persent",250);
set("target",1);
set("force",800);
set("need_force",100);
set("betray_lvl",350);
set("damage_type","eff_kee");
set("limit_skill",([
    "zizhi-blade":120,
    "blade":120,
    "force":120,
]));
set("limit_other",([
    "sen"   : 400,
]));
set("temp","gumu/fb");
set("temp_time",(2+random(3)));
}

void hit_msg(object me,object target,int num)
{
string msg;
if ( me && target&&num==1 )
	{
      set("damage",(: set_damage :) );
      message_vision(HIR"\n$N刀过头顶，积聚全身力量，一刀劈出\n\n"NOR,me,target); 
      message_vision(MAG"\n刀锋带着一道紫色火焰划过,犹如一只火鸟\n"NOR,me,target); 
	}
}

void success_hit_msg(object me,object target,int num)
{
string msg;
if ( me && target )
	{
              message_vision(HIB"\n$n周身被紫色火焰包围着......\n"NOR,me,target); 
	}
}

void lost_hit_msg(object me,object target,int num)
{
string msg;
if ( me && target )
	{
        message_vision(HIG"\n$n急忙后跃，才将将躲开火焰的攻击！\n"NOR,me,target); 
	}
}

void normal_hit_msg(object me)
{
int damage;
string msg;
if ( me )
	{
 	msg = HIC "但是被对方以内力一逼，指力尽数反挫！\n" NOR;
       msg+= HIC "结果只听喀嚓！几声，$N"HIC"十指几乎全部折断！\n" NOR;
        message_vision(msg,me);
	damage = query("damage");
	damage = damage/5+random(damage/5);
	if ( damage>0 )
		{
		me->receive_damage("kee",damage);
		COMBAT_D->report_status(me);
		}
	}
}



void remove_eff_msg( object me )
{
   string msg;
   if( me )
   {
           msg = HIR"\n刀锋上的火焰熄灭，火鸟消失\n"NOR;
           message_vision( msg , me );
      }
}
int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("zizhi-blade")+" 120 级\n"; 
temp+= "\t\t"+to_chinese("blade")+" 120 级\n"; 
temp+= "\t\t"+to_chinese("force")+" 120 级\n"; 
temp+= "\t\t精神 400 点\n"; 
temp+= "\t\t内力 800 点\n"; 
write(@HELP 
紫雉刀法 之 「火鸟飞天」：

        使用功效： 
                给对手强有力的一击
        出招类型： 
                延时型外功
                无隐藏攻击 
                叛师可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
