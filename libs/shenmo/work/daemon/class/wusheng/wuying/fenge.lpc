#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() {
  return "「" HIW "分割天地" NOR "」";
}

int valid_perform(object me) {
  if (!me) return 0;
  if (me->query("shilian") < 1)
    return notify_fail("你还没有通过试炼塔的考验！\n");
  if (me->query("class") != "xian" && !me->samsara_check("wuying", 1) && me->query("spskkk") != 6)
    return notify_fail(name() + "乃是仙家不传之秘。\n");
  if (me->query_skill("wuying", 1) < 50)
    return notify_fail("你的" + to_chinese("wuying") + "等级不足 50 级，不能施展" + name() + "。\n");
  if (me->query_skill("feisheng", 1) < 50 && me->query("spskkk") != 6)
    return notify_fail("你的" + to_chinese("feisheng") + "等级不足 50 级，不能施展" + name() + "。\n");
  if (me->query("max_force") < 500)
    return notify_fail("你的内力修为不足五年，不能施展" + name() + "。\n");
  if (me->query("force") < 100)
    return notify_fail("你的内力不足 100 点，不能施展" + name() + "。\n");
  if (me->query("sen") < 100)
    return notify_fail("你的精神不足 100 点，不能施展" + name() + "。\n");
  if (time() < me->query_temp("wusheng_pfm_fenge") + 2 + random(5))
    return notify_fail("绝招用多就不灵了。\n");
  return 1;
}

int perform(object me, object target) {
  object weapon;
  string msg;
  int ap, dp, skill, time;
  weapon = me->query_temp("weapon");

  if (!valid_perform(me))
    return 0;
  if (!target)
    target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || !me->is_fighting(target))
    return notify_fail("你要对谁施展「分割天地」？\n");
  if (!me->is_fighting())
    return notify_fail("「分割天地」只能在战斗中使用！\n");

  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    msg = HIG "
$N" HIG "运足精神，将" + weapon->name() + HIG "擎将在手，朝着$n" HIG "反手一劈，只见四周瞬间
变得一片死寂！在恐怖的沉静之后，猛然一道剑光彷若将虚空劈成了两半！\n" NOR;
  else msg = HIG "$N" HIG "对$n" HIG "使出了" + HIR + name() + HIG "！\n" NOR;
  message_vision(msg, me, target);
  me->receive_damage("sen", 80, target);
  ap = COMBAT_D->skill_power(me, "sword", 1);
  dp = COMBAT_D->skill_power(target, "parry", 1);
  dp += COMBAT_D->skill_power(target, "dodge", 1);
  dp /= 3;
  if (COMBAT_D->restrain(me, target))
    ap += ap / 3;
  if (COMBAT_D->restrain(target, me))
    dp += dp / 3;
  skill = (int)me->query_skill("feisheng", 1);
  if (me->query("spskkk") == 6)
    skill += (int)me->query_skill("spells", 1) / 2;
  if (target->query("任务"))
    time = skill / 50;
  else
    time = skill / 20;
  if (time < 3) time = 3;
  if (time > 60) time = 60;
  if (wizardp(me)) tell_object(me, "time====" + time + "\n");
  me->set_temp("wusheng_pfm_fenge", time() + time / 2);

  if (random(ap) > random(dp) || wizardp(me) || (random(ap) > dp / 10 && me->query("spskkk") == 6)) {
    target->set_temp("no_perform", ([
      "start": time(),
      "time": time,
      "msg": HIM "你被" + me->name() + "的一式" HIR + name() + HIM "封住了外功气门。。。。" NOR,
    ]));
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(HIG "结果$n" HIG "被$N" HIG "的这一招封住了全身经脉气门！\n" NOR, me, target);
    me->add("force", -100);
  } else {
    message_vision(HIG "结果$n" HIG "对此异像熟视无睹，$N" HIG "的这一招落了空处。\n" NOR, me, target);
    me->add("force", -50);
  }
  return 1;
}


int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("feisheng") + " 50 级\n";
  temp += "\t\t" + to_chinese("wuying") + " 50 级\n";
  temp += "\t\t非武圣门弟子必须通过shilian\n";
  temp += "\t\t内    力 200 点\n";
  temp += "\t\t内力修为 五 年\n";
  temp += "\t\t精    神 100 点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP 
        使用功效： 
                封住对方的外功气门
        出招类型：   
                延迟型外功  
                无隐藏攻击
                叛师可带出   
        出手要求： 
HELP);
  write(temp);
  return 1;
}
