#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() {
  return "「" HIR "无极无影" NOR "」";
}

int valid_perform(object me) {
  if (!me) return 0;
  if (me->query("shilian") < 1)
    return notify_fail("你还没有通过试炼塔的考验！\n");
  if (me->query("class") != "xian" && !me->samsara_check("wuying", 1))
    return notify_fail(name() + "乃是仙家不传之秘。\n");
  if (me->query_skill("wuying", 1) < 100)
    return notify_fail("你的" + to_chinese("wuying") + "等级不足 100 级，不能施展" + name() + "。\n");
  if (me->query("max_force") < 2000)
    return notify_fail("你的内力修为不足二十年，不能施展" + name() + "。\n");
  if (me->query("force") < 500)
    return notify_fail("你的内力不足 500 点，不能施展" + name() + "。\n");
  if (me->query("sen") < 300)
    return notify_fail("你的精神不足 300 点，不能施展" + name() + "。\n");
  //if ( time()<me->query_temp("wusheng_pfm_piyi")+20 )
  //        return notify_fail("你刚刚使用过「"+HIG"六军辟易"NOR"」，难以再施展"+name()+"。\n");     
  if (time() < (int)me->query_temp("wusheng_pfm_wuji") + 5)
    return notify_fail("绝招用多就不灵了。\n");
  return 1;
}

int perform(object me, object target) {
  object weapon;
  string str, msg;
  int extra, damage, pot = 0, num = 0;

  if (!valid_perform(me))
    return 0;
  if (!target)
    target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || !me->is_fighting(target))
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用！\n");

  weapon = me->query_temp("weapon");
  extra = me->query_skill("wuying", 1);

  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    msg = HIM "
$N" HIM "使出" + to_chinese("wuying") + HIM "中的绝招" + name() + HIM "，身形灵动，只见$P手中的" + weapon->name() + HIM "
闪电般向$n" HIM "打出一轮剑波！\n\n" NOR;
  else msg = HIW "$N" HIW "对$n" HIW "使出了" + name() + NOR HIW "。\n" NOR;
  message_vision(msg, me, target);
  me->set_temp("wusheng_pfm_wuji", time());
  me->add("force", -150);
  me->receive_damage("sen", 50 + random(150));

  //COMBAT_D->do_attack(me,target, weapon);
  //num++;
  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    message_vision(HIM "「风起云涌」\n" NOR, me, target);
  if (me->query("env/no_msg") || target->query("env/no_msg"))
    message_vision("", me);
  damage = COMBAT_D->do_attack(me, target, weapon);
  num++;
  if (damage || COMBAT_D->restrain(me, target)) {
    pot++;
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(HIM "「电闪雷鸣」\n" NOR, me);
    if (me->query("env/no_msg") || target->query("env/no_msg"))
      message_vision("", me);
    damage = COMBAT_D->do_attack(me, target, weapon);
    num++;
    if (damage || COMBAT_D->restrain(me, target)) {
      pot++;
      if (!me->query("env/no_msg") && !target->query("env/no_msg"))
        message_vision(HIM "「雷振九天」\n" NOR, me);
      if (me->query("env/no_msg") || target->query("env/no_msg"))
        message_vision("", me);
      COMBAT_D->do_attack(me, target, weapon);
      num++;
    }
  }

  if (extra > 200) {
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(HIM "「火烧连天」\n" NOR, me);
    if (me->query("env/no_msg") || target->query("env/no_msg"))
      message_vision("", me);
    damage = COMBAT_D->do_attack(me, target, weapon);
    num++;
    if (damage || COMBAT_D->restrain(me, target)) {
      pot++;
      if (!me->query("env/no_msg") && !target->query("env/no_msg"))
        message_vision(HIM "「云罩漫天」\n" NOR, me, target);
      if (me->query("env/no_msg") || target->query("env/no_msg"))
        message_vision("", me);
      COMBAT_D->do_attack(me, target, weapon);
      num++;
    }
  }

  if (extra > 400) {
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(HIW "「无极无影」\n" NOR, me);
    if (me->query("env/no_msg") || target->query("env/no_msg"))
      message_vision("", me);
    damage = COMBAT_D->do_attack(me, target, weapon);
    num++;
    if (damage || COMBAT_D->restrain(me, target)) {
      pot++;
      damage = COMBAT_D->do_attack(me, target, weapon);
      num++;
      if (damage || COMBAT_D->restrain(me, target)) {
        pot++;
        COMBAT_D->do_attack(me, target, weapon);
        num++;
      }
    }
    COMBAT_D->do_attack(me, target, weapon);
    num++;
  }

  message_vision(
    HIM "\n$N" HIM "连出" + chinese_number(num) + "剑，结果$n" HIM "被攻了个措手不及！\n" NOR,
    me,
    target
  );
  //if ( random(pot)>3 && living(target) && !target->is_busy() )
  //        target->start_busy(random(3));
  if (random(me->query("level")) > target->query("level") / 2) {
    target->receive_damage("kee", extra + random(extra), me);
    target->receive_wound("kee", extra, me);
    COMBAT_D->report_status(target);
  }

  if ((target->query("eff_kee") < 0
    || !living(target))
    && random(me->query_kar()) > 25) {
    str = HIW + target->name() + HIW "被" + me->name() + HIW "用本门绝技" + SDS_D->color_msg(HIW + SDS_D->no_color_msg(name())) + HIW "杀死了，听说尸体惨被分解！";
    message("channel:job", HIW "【" HIR "武圣门" HIW "】听说" + str + "\n" NOR, users());
  }
  me->reset_action();
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("wuying") + " 100 级\n";
  //temp+= "\t\t在「"HIG"六军辟易"NOR"」使用后一段时间内不可使用。\n";
  temp += "\t\t非武圣门弟子必须通过试炼塔\n";
  temp += "\t\t内    力 500 点\n";
  temp += "\t\t内力修为 二十 年\n";
  temp += "\t\t精    神 300 点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP 
        使用功效： 
                给对手以连续的打击，并暗藏玄机
        出招类型：   
                延迟型外功  
                有隐藏攻击
                叛师可带出   
        出手要求： 
HELP);
  write(temp);
  return 1;
}
