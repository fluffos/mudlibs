#include <ansi.h>
inherit SSERVER;

string name() {
  return "「" HIC "绝尘无影" NOR "」";
}

int valid_perform(object me) {
  if (!me) return 0;
  if ((me->query("family/family_name") != "武圣门" && me->query("shilian") < 1)
    || (me->query("class") != "xian" && !me->samsara_check("wuying", 1)))
    return notify_fail(name() + "乃是武圣之不传绝招。\n");
  if (me->query_skill("wuying", 1) < 60)
    return notify_fail("你的" + to_chinese("wuying") + "等级不足 60 级，不能施展" + name() + "。\n");
  if (me->query_skill_mapped("dodge") != "mizongbu")
    return notify_fail(name() + "必须有" + to_chinese("mizongbu") + "的支持。\n");
  if (me->query("max_force") < 500)
    return notify_fail("你的内力修为不足五年，不能施展" + name() + "。\n");
  if (me->query("force") < 500)
    return notify_fail("你的内力不足 500 点，不能施展" + name() + "。\n");
  if (me->query("sen") < 300)
    return notify_fail("你的精神不足 300 点，不能施展" + name() + "。\n");
  if (time() < me->query_temp("wusheng_pfm_fenge") + 2 + random(5))
    return notify_fail("绝招用多就不灵了。\n");
  return 1;
}

int perform(object me, object target) {
  int skill, ap, dp, damage, ap1, dp1, look = 1, num;
  string msg;
  object weapon;

  if (!valid_perform(me))
    return 0;
  if (!target)
    target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || !me->is_fighting(target))
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用！\n");

  weapon = me->query_temp("weapon");
  skill = me->query_skill("wuying", 1);
  num = skill / 6;

  ap = COMBAT_D->skill_power(me, "sword", 1);
  ap += COMBAT_D->skill_power(me, "wuying", 1);
  ap /= 2;
  dp = COMBAT_D->skill_power(target, "parry", 1);
  dp += COMBAT_D->skill_power(target, "spells", 1);
  dp += COMBAT_D->skill_power(target, "linterate", 1);
  dp /= 3;
  if (COMBAT_D->restrain(me, target))
    ap += ap / 3;
  if (COMBAT_D->restrain(target, me))
    dp += dp / 3;
  if (target->is_busy())
    dp -= random(dp / 3);
  ap1 = me->query_spi();
  dp1 = target->query_spi();
  if (COMBAT_D->restrain(me, target))
    ap1 += ap1 / 3;
  if (COMBAT_D->restrain(target, me))
    dp1 += dp1 / 3;
  if (random(ap1 + dp1) > dp1)
    look = 0;

  if (look) {
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      msg = HIR "
$N" HIR "手腕晃动如疾风，" + weapon->name() + HIR "以疾风的速度瞬间挥出" + chinese_number(num) + "剑，剑锋无影直逼$n" HIR "！\n" NOR;
    else msg = HIR "$N" HIR "对$n" HIR "使出了" + name() + HIR "！\n" NOR;
    message_vision(msg, me, target);
  } else tell_object(me, HIR "你对" + target->name() + HIR "使出了" + name() + "！\n" NOR);

  damage = weapon->query("weapon_prop/damage");
  damage = damage / 2 + random(damage / 2);
  if (damage > 300)
    damage = 300;
  if (damage < 100)
    damage = 100;
  damage *= skill / 60;
  if (damage > 2500)
    damage = 2500;
  damage = damage / 2 + random(damage / 2);

  if (random(ap + dp) > dp) {
    if (look)
      message_vision(HIR "结果$n" HIR "被$N" HIR "的这招" + name() + HIR "拦腰而过！\n" NOR, me, target);
    target->receive_damage("kee", damage, me);
    if (damage < 1000)
      target->receive_wound("kee", damage / 3, me);
    else target->start_busy(random(3) + 1);
    if (look) COMBAT_D->report_status(target);
    me->start_busy(1);
  } else {
    if (look)
      message_vision(HIR "但是被$n" HIR "躲开了。\n" NOR, me, target);
    me->add("force", -100);
    me->start_busy(3);
  }
  me->add("force", -200);
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("wuying") + " 60 级\n";
  temp = "\t\t必须激发" + to_chinese("mizongbu") + "\n";
  temp += "\t\t非武圣门弟子必须通过shilian\n";
  temp += "\t\t内    力 500 点\n";
  temp += "\t\t内力修为 五 年\n";
  temp += "\t\t精    神 300 点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP 
        使用功效： 
                无视对方防御，减少并有可能损伤对方的气血
        出招类型：   
                busy型外功  
                有隐藏攻击
                叛师可带出   
        出手要求： 
HELP);
  write(temp);
  return 1;
}
