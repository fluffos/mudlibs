#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name()
{
return "「"HIG"六军辟易"NOR"」";  
}

int valid_perform(object me)
{
if ( !me )   return 0;
if ( me->query("shilian")<1 )
        return notify_fail("你还没有通过试炼塔的考验！\n");
if ( me->query("class")!="xian" && !me->samsara_check("wuying",1) )
        return notify_fail(name()+"乃是仙家不传之秘。\n");
if ( me->query_skill("wuying",1)<180 )
        return notify_fail("你的"+to_chinese("wuying")+"等级不足 180 级，不能施展"+name()+"。\n");
if ( me->query("max_force")<2000 )
        return notify_fail("你的内力修为不足二十年，不能施展"+name()+"。\n");
if ( me->query("force")<1000 )
        return notify_fail("你的内力不足 1000 点，不能施展"+name()+"。\n");   
if ( me->query("sen")<800 )
        return notify_fail("你的精神不足 800 点，不能施展"+name()+"。\n");   
//if ( time()<me->query_temp("wusheng_pfm_wuji")+10 )
//        return notify_fail("你刚刚使用过「"+HIR"无极无影"NOR"」，难以再施展"+name()+"。\n");     
return 1;
}       

int perform(object me, object target)
{
object weapon;
string str,msg;
int i,temp,ad=0,damage;

if ( !valid_perform(me) )
        return 0;                
if ( !target ) 
        target = offensive_target(me);
if ( !target
  || !target->is_character()
  || target->is_corpse()
  || !me->is_fighting(target) )
        return notify_fail("你要对谁施展"+name()+"？\n");
if ( !me->is_fighting() )
        return notify_fail(name()+"只能在战斗中使用！\n");

weapon = me->query_temp("weapon");
damage = weapon->query("weapon_prop/damage");
damage+= me->query("force");
damage-= me->query("max_force");
damage+= me->query_skill("sword");
damage-= random(target->query_temp("apply/armor"));
temp = me->query_skill("wuying",1);
temp/= 20;

if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
        msg = HIW"
$N"HIW"长啸一声：教单于折箭，六军辟易，一招"NOR+name()+HIW"，瞬间幻出万马千军闪电般的向$n"HIW"攻去！\n"NOR;
else    msg = HIW"$N"HIW"对$n"HIW"使出了"+name()+NOR HIW"。\n"NOR;      
message_vision(msg, me, target);
me->set_temp("wusheng_pfm_piyi",time());
me->add("force", -500);
me->receive_damage("sen", 50+random(150));

if ( COMBAT_D->restrain(me,target) )
        {
        target->start_busy(1);  
        if ( random(me->query_spi())>target->query_cps() )
                {
                ad++;
                me->add_temp("apply/attack",temp);
                me->add_temp("apply/damage",temp);
                }
        }
i = random(3)+1;
while(i--)
        {
        if ( me && me->is_fighting(target) && living(target) )          
                COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
        }
while ( ad )
        {
        me->add_temp("apply/attack",-temp);
        me->add_temp("apply/damage",-temp);
        ad--;   
        }

if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
        message_vision(HIW"
$N"HIW"虚空一抓，一股气流激荡指间，手中的"+weapon->name()+HIW"被这无形气劲牵扯，如山川大河，连绵不绝的
攻向$n"HIW"！\n"NOR,me,target); 
i = random(2)+1;
while(i--)
        {
        if ( me && me->is_fighting(target) && living(target) )          
                COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
        }
        
if ( me->query_skill("wuying",1)>250 )
        {
        if ( COMBAT_D->restrain(me,target) 
          || random(me->query_spi())>target->query_cps() )
                {
                message_vision(HIW"\t\t为谁开？茶花满路？"NOR,me);
                if ( me->query("env/no_msg") || target->query("env/no_msg") )
                        message_vision("\n",me);
                COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
                }
        }

if ( me->query_skill("wuying",1)>260 )
        {
        if ( COMBAT_D->restrain(me,target) 
          || random(me->query_spi())>target->query_cps() )
                {
                message_vision(HIW"\t\t燕云十八骑，奔腾如虎风！"NOR,me);
                if ( me->query("env/no_msg") || target->query("env/no_msg") )
                        message_vision("\n",me);
                COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
                }
        }
        
if ( me->query_skill("wuying", 1)>270 )
        {
        if ( COMBAT_D->restrain(me,target) 
          || random(me->query_spi())>target->query_cps() )
                {
                message_vision(HIW"\t\t敝屣荣华，浮云生死，此身何惧！"NOR,me);
                if ( me->query("env/no_msg") || target->query("env/no_msg") )
                        message_vision("\n",me);                
                COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
                }
        }
if ( me->query_skill("wuying",1)>330 )
        {
        damage = damage/2+random(damage/2);     
        message_vision(HIW"\t\t王孙落魄，怎生消得，杨枝玉露？"NOR,me);
        if ( me->query("env/no_msg") || target->query("env/no_msg") )
                message_vision("\n",me);        
        if ( COMBAT_D->restrain(me,target) )
                {
                SDS_D->super_attack(me,target,damage,"");       
                if ( random(me->query_spi())>target->query_cps() )
                        SDS_D->hitWeapon(me,target,weapon); 
                }
        else    COMBAT_D->do_attack(me, target, me->query_temp("weapon"),TYPE_REGULAR); 
        }

if ( me->query_skill("wuying",1)>350 )
        {
        damage+= random(damage/2);
        message_vision(HIW"\t\t却试问，几时把痴心断？"NOR,me);
        if ( me->query("env/no_msg") || target->query("env/no_msg") )
                message_vision("\n",me);        
        if ( COMBAT_D->restrain(me,target) )
                {
                SDS_D->super_attack(me,target,damage,"");       
                if ( random(me->query_spi())>target->query_cps() )
                        SDS_D->hitWeapon(me,target,weapon); 
                }
        else    COMBAT_D->do_attack(me, target, me->query_temp("weapon"),TYPE_REGULAR); 
        }

if ( me->query_skill("wuying", 1)>400 )
        {
        damage+= random(damage);
        message_vision(HIW"\t\t红颜弹指老，刹那芳华。"NOR,me,target); 
        if ( me->query("env/no_msg") || target->query("env/no_msg") )
                message_vision("\n",me);        
        SDS_D->super_attack(me,target,damage,"");       
        SDS_D->hitWeapon(me,target,weapon); 
        }
        
if ( me->query_skill("wuying", 1)>449 )
        {
        message_vision(HIW"\t\t王霸雄图，血海仇深，尽归尘土！"NOR,me);
        if ( me->query("env/no_msg") || target->query("env/no_msg") )
                message_vision("\n",me);        
        me->add_temp("apply/attack",temp*2);
        me->add_temp("apply/damage",temp*2);
//        target->add_temp("apply/attack",-temp/2);
//        target->add_temp("apply/damage",-temp/2);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
        me->add_temp("apply/attack",-temp*2);
        me->add_temp("apply/damage",-temp*2);
//        target->add_temp("apply/attack",temp/2);
//        target->add_temp("apply/damage",temp/2);
        }
        
if ( (target->query("eff_kee")<0 
   || !living(target))
 && random(me->query_kar())>25 )  
        {
        str = HIW+target->name()+HIW"被"+me->name()+HIW"用本门绝学"+name()+HIW"斩杀！听说尸体上尽是万马千军践踏的痕迹！";
        message("channel:job",HIM"【武圣门】听说"+str+"\n"NOR,users());
        }
me->start_busy(3+random(3));
return 1;
}

int help(object me)  
{
string temp;
temp= "\t\t"+to_chinese("wuying")+" 180 级\n"; 
//temp = "\t\t不能与「"+HIR"无极无影"NOR"」同时使用。\n";
temp+= "\t\t非武圣门弟子必须通过shilian\n"; 
temp+= "\t\t内    力 1000 点\n"; 
temp+= "\t\t内力修为 二十 年\n"; 
temp+= "\t\t精    神 800 点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");
write(@HELP 
        使用功效： 
                给对手以连续的打击，并暗藏玄机
        出招类型：   
                busy型外功  
                有隐藏攻击
                叛师可带出   
        出手要求： 
HELP);  
write(temp);  
return 1;  
}

