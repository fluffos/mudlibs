// duo.c 「夺」字诀 by seawind
#include <ansi.h>
#include <combat.h>
inherit SSERVER; 

string name()
{
return "「"HIW"夺"NOR"」字诀";
}

int valid_perform(object me)
{
if ( !me )
        return 0;
if ( me->query("shilian")<1 )
        return notify_fail("你还没有通过试炼塔的考验！\n");
if ( me->query("class")!="xian" && !me->samsara_check("fumobashi",1) )
        return notify_fail(name()+"乃是仙家不传之秘。\n");
if ( me->query_skill("fumobashi", 1)<288 )
        return notify_fail("你的"+to_chinese("fumobashi")+"等级不足 288 级，不能施展"+name()+"。\n");
if ( me->query("max_force")<1500 )
        return notify_fail("你的内力修为不足十五年，不能施展"+name()+"。\n");
if ( me->query("force")<500 )
        return notify_fail("你的内力不足 500 点，不能施展"+name()+"。\n");   
if ( me->query_con()<30 )
        return notify_fail("「夺」字诀乃靠出其不意，才能制胜。你的根骨好象还不够。\n");
return 1;               
}

int perform(object me, object target)
{
string msg,limb1,limb2,*limbs,type;
object weapon;
int ap,dp;
if ( !valid_perform(me) )
        return 0;
if ( !target ) 
        target = offensive_target(me);
if ( !target
  || !target->is_character()
  || !me->is_fighting(target) )
        return notify_fail(name()+"只能对战斗中的对手使用。\n");
if ( !me->is_fighting() )
        return notify_fail(name()+"只能对战斗中的对手使用。\n");        
if ( !target->query_temp("weapon") )
        {       
        if ( target->is_busy() )
                return notify_fail(target->name()+"已在全力化解自已的招数，你可以放胆的击！\n");
        }
limbs = target->query("limbs");
limb1 = limbs[random(sizeof(limbs))];   
limb2 = limbs[random(sizeof(limbs))];   
msg = me->query("actions")["action"]+"。\n";
if ( !msg || !stringp(msg) 
  || me->query("env/no_msg")
  || target->query("env/no_msg") )
        msg = "$N对$n使出了"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"。\n";
weapon = target->query_temp("weapon");
if ( !weapon )
        {
        msg+= HIW"$N"HIW"双手一振，双手已巧妙的搭在$n"HIW"的$l和$M上，企图以伏魔八式「夺」字诀把$n"HIW"的锁住。\n"NOR;       
        type = "busy";
        }
else    {
        msg+= HIW"$N"HIW"双手一振，双手已巧妙的搭在$n"HIW"的"+weapon->name()+HIW"上，企图以伏魔八式「夺」字诀将之夺下。\n"NOR;                       
        type = "weapon";
        }

ap = COMBAT_D->skill_power(me,"unarmed",1);
ap+= COMBAT_D->skill_power(me,"force",1);
ap/= 2;
dp = COMBAT_D->skill_power(target,"parry",1);
dp+= COMBAT_D->skill_power(target,"dodge",1);
dp/= 2;
if ( COMBAT_D->restrain(me,target) )
        ap+= ap/3;
if ( COMBAT_D->restrain(target,me) )
        dp+= dp/3;
if ( random(ap+dp)>dp && time()>target->query_temp("hit_by_wusheng_duo")+3 )
        {
        if ( type=="weapon" )
                {
                msg+= HIW"结果"+weapon->name()+HIW"被$N的双手巧妙的一压一带，已被$P夺下！\n" NOR;
                if ( weapon->query("no_drop")
                  || weapon->query("no_get") 
                  || weapon->query("warcity") )
                        destruct(weapon); 
                else if ( !weapon->move(me) )
                        {
                        if ( !weapon->move(environment(me)) )
                                destruct(weapon);
                        }                                         
                me->add("force", -300);
                target->set_temp("hit_by_wusheng_duo",time());
                }
        else    {
                msg+= HIW"结果$n"HIW"被$N的双手锁住，顿时浑身酸麻，动弹不得！\n" NOR;         
                if ( !target->is_busy() )
                        target->start_busy(2);
                me->add("force", -300); 
                }
        }               
else    {
        msg+= HIW"$n"HIW"看破了$N"HIW"的企图，连消带打，将这招避开。\n" NOR;
        if ( random(100)>80 )
                COMBAT_D->do_attack(target,me, target->query_temp("weapon"),TYPE_REGULAR);
        me->add("force", -500);
        }
msg = replace_string(msg,"$l",limb1);
msg = replace_string(msg,"$M",limb2);        
msg = SDS_D->no_color_msg(msg);
msg = HIW+msg+NOR;
msg = SDS_D->color_msg(msg);
message_vision(msg, me, target);
return 1;
}

int help(object me)  
{
string temp;
temp = "\t\t"+to_chinese("fumobashi")+" 288 级\n"; 
temp+= "\t\t非武圣门弟子必须通过試練塔。\n"; 
temp+= "\t\t内力修为 十五年 。\n"; 
temp+= "\t\t内    力 500 点 。\n"; 
temp+= "\t\t根骨 30 点以上\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");
write(@HELP 
        使用功效： 
                夺取敌人的武器
        出招类型：   
                连发型外功  
                有隐藏攻击
                叛师可带出   
        出手要求： 
HELP);  
write(temp);  
return 1;  
}
