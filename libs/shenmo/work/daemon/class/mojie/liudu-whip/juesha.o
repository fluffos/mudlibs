
#include <ansi.h>

inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("[31m天魔绝杀只能对战斗中的对手使用。[37m\n");
            if((int) me->query_skill("liudu-whip",1) <= 299)
		return notify_fail("你还不会天魔绝杀。\n");
if(me->query("family/family_name")!="魔界")
     
           return notify_fail("你未入魔界,不能使用这项技能！\n");

if((int) me->query_skill("heilian-force",1) <= 299)
		return notify_fail("你还不会天魔绝杀。\n");if((int) me->query_skill("whip",1) <= 299)
		return notify_fail("你还不会天魔绝杀。\n");if((int) me->query_skill("molian-spells",1) <= 299)
		return notify_fail("你还不会天魔绝杀。\n");if((int) me->query_skill("shifo-zhi",1) <= 299)
		return notify_fail("你还不会天魔绝杀。\n");
        if((int) me->query("force") <= 2999)
		return notify_fail("你的内力不够。\n");
 if (me->query_temp("dead_busy")) return notify_fail("你已经在使用天魔绝杀了。\n");


	message_vision(RED"$N双目紧闭,鞭指$n，准备发出致命一击。\n"NOR,me,target);
       me->start_call_out( (: call_other, __FILE__, "kill_him", me, target :), random(5)+5);
	me->start_busy(5+random(2));
       me->set_temp("dead_busy",1);
       call_out("remove_effect",6+random(3),me);
	return 1;
}

void kill_him(object me, object target)
{
	string msg;
         string myname=me->name(), npcname=target->name();
	if(me->is_fighting() && 
	environment(me) == environment(target))
	{
msg = HIB "$N双目突然张开，一道诡异"NOR+HIC"冲击波"NOR+HIB"闪动，$n"NOR+HIB"只觉得头重脚轻，昏昏欲睡！！！\n" ;
msg +=  "\n一股血箭喷涌而出．．$N一声长叹，一滴滴鲜血从#n颈上滴下．．\n\n" NOR;

	message_vision(msg, me, target);
	target->die();
       {
	// message("channel:rumor",HIM"【风言风语】某人："+npcname+"被"+myname+"用神谷活心流的最高奥义[冥界召返]直接送去了地狱，尸体的脸上还带着诡异的笑容。\n"NOR,users());
	 }

	}
	return ;
}
void remove_effect(object me) {
  if (!me) return;
  me->delete_temp("dead_busy");
}

