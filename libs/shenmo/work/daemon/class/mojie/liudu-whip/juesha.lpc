
#include <ansi.h>

inherit SSERVER;
int check_fight(object me, int amount, object weapon);
string name()  
{
return "「"HIB"天魔绝杀"NOR"」";  
}

int valid_perform(object me)
{
            if((int) me->query_skill("liudu-whip",1) <= 299)
                return notify_fail("你还不会"+name()+"。\n");
        if( me->query("shilian") < 1 )
                return notify_fail("你还没有通过试炼塔的考验！\n");
if ( me->query("class")!="yao" && !me->samsara_check("liudu-whip",1) )
        return notify_fail(name()+"乃是魔界不传之秘。\n");


if((int) me->query_skill("heilian-force",1) <= 299)
                return notify_fail("你还不会"+name()+"。\n");if((int) me->query_skill("whip",1) <= 299)
                return notify_fail("你还不会"+name()+"。\n");if((int) me->query_skill("molian-spells",1) <= 299)
                return notify_fail("你还不会"+name()+"。\n");if((int) me->query_skill("shifo-zhi",1) <= 299)
                return notify_fail("你还不会"+name()+"。\n");
        if((int) me->query("force") <= 2999)
		return notify_fail("你的内力不够。\n");
 if (me->query_temp("dead_busy")) return notify_fail("你已经在使用"+name()+"了。\n");


return 1;  
}

int perform(object me, object target)
{
        string msg;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

	message_vision(RED"$N双目紧闭,鞭指$n，准备发出致命一击。\n"NOR,me,target);
 call_out("kill_him",random(5)+5,me, target);
        me->start_busy(8+random(2));
       me->set_temp("dead_busy",1);
check_fight(me,100,me->query_temp("weapon"));
       call_out("remove_effect",6+random(3),me);
	return 1;
}

int check_fight(object me, int amount, object weapon)
{  
object wep;    
if(!me) return 0;
wep = me->query_temp("weapon");  
if(!me->is_fighting() || !living(me) || me->is_ghost() || !wep || weapon != wep )
{
     remove_call_out("kill_him");
     remove_call_out("check_fight");
     }
    else {
        call_out("check_fight", 1, me, amount, weapon);
    }
return 1;
}

void kill_him(object me, object target)
{
	string msg;
         string myname,npcname;
         myname=me->name();
         npcname=target->name();
	if(me->is_fighting() && 
	environment(me) == environment(target))
	{
msg = HIB "$N双目突然张开，一道诡异"NOR+HIC"冲击波"NOR+HIB"闪动，$n"NOR+HIB"只觉得头重脚轻，昏昏欲睡！！！\n" ;
msg +=  "\n一股血箭喷涌而出．．$N一声长叹，一滴滴鲜血从$n颈上滴下．．\n\n" NOR;

	message_vision(msg, me, target);
    if(!target->query("莲花") && !target->query("任务") && (int)target->query_skill("busi-force", 1)<500 && me->query("combat_exp")>target->query("combat_exp")/3 && me->query("level")>target->query("level")/3)
{ if( living(target) ) target->die();}
          else    
          {        target->receive_damage("kee",300,me);COMBAT_D->report_status(target); }
       {
	// message("channel:rumor",HIM"【风言风语】某人："+npcname+"被"+myname+"用神谷活心流的最高奥义[冥界召返]直接送去了地狱，尸体的脸上还带着诡异的笑容。\n"NOR,users());
	 }

	}
	return ;
}
void remove_effect(object me) {
  if (!me) return;
  me->delete_temp("dead_busy");
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("liudu-whip")+" 300 级\n"; 
temp+= "\t\t"+to_chinese("whip")+" 300 级\n"; 
temp+= "\t\t"+to_chinese("molian-spells")+" 300 级\n"; 
temp+= "\t\t"+to_chinese("heilian-force")+" 300 级\n"; 
temp+= "\t\t"+to_chinese("shifo-zhi")+" 300 级\n"; 
temp+= "\t\t必须通过shilian\n"; 
temp+= "\t\t内力 3000 点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                给对手必杀一击
        出招类型： 
                busy型武功
                有隐藏攻击 
                叛师可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
