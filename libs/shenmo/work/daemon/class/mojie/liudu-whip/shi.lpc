#include <ansi.h>

inherit F_DBASE;
inherit SSERVER;

string name() {
  return "「" HIB "蚀" NOR "」";
}

int valid_perform(object me) {
  if (me->query_skill("force") < 300)
    return notify_fail("你的黑莲魔功火候未到，无法施展" + name() + "！\n");
  if (me->query("class") != "yao" && !me->samsara_check("liudu-whip", 1))
    return notify_fail(name() + "乃是魔界不传之秘。\n");

  if (me->query_skill("whip") < 300)
    return notify_fail(name() + "需要精湛的留度鞭法方能有效施展！\n");

  if (me->query_temp("shi_busy")) return notify_fail("你气血翻腾，休息一下吧。\n");
  if (me->query("shilian") < 1)
    return notify_fail("你还没有通过试炼塔的考验！\n");
  //if( me->query_temp("shixie",1) ) 
  //        return notify_fail("你已经运起了嗜血，难以再使用"+name()+"！\n");   
  if (me->query("force") < 300)
    return notify_fail("你的内力不够使用" + name() + "！\n");
  if (me->query("sen") < 100)
    return notify_fail("你的精力不够使用" + name() + "！\n");

  return 1;
}

int perform(object me, object target) {
  int str, skill, num, damage1, damage2, count;
  object weapon;
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用！\n");

  skill = me->query_skill("liudu-whip", 1);
  num = skill / 20;
  if (num > 9) num = 9;
  weapon = me->query_temp("weapon");

  message_vision(HIC "酣战中，$n眼前一花，$N的踪影已失，$n忽觉有异，迅即抬头上望。\n" NOR, me, target);
  message_vision(MAG "只见半空中，$N映着背后的烈日，气氛异常怪异。\n" NOR, me, target);
  message_vision(
    CYN "$N将黑莲魔功运注于手中" + weapon->query("name") + CYN "，混身散发出一股与背后烈日相异的黑暗---极暗！\n" NOR,
    me,
    target
  );
  message_vision(
    BLU "$N猛的一扬" + weapon->query("name") + BLU "。$n顿觉烈日从中心处逐渐被那极暗所吞噬，刹那，天地间陷入无边无际的黑暗之中!\n" NOR,
    me,
    target
  );
  message_vision(BLU "极暗世界里，$n只觉周身的空间不断压缩，急忙定睛凝神，一条乌黑的鞭子已经绕身而至！\n" NOR, me, target);

  damage1 = skill + me->query_skill(
    "heilian-force",
    1
  ) + me->query_skill(
    "whip",
    1
  ) + me->query_skill("force", 1) + me->query("force_factor") + me->query("apply/damage");

  for (count = 0; count < num; count++) {
    if (count > 0 && !me->query("env/no_msg") && !target->query("env/no_msg")) message_vision(
      HIB "\n极暗的空间不断压缩...\n" NOR,
      me,
      target
    );

    if (me->query("combat_exp") / 5 * 6 > random(target->query("combat_exp"))) {
      damage2 = damage1 / 10 + random(damage1 / 5);
      if (damage2 < 200) damage2 = 200;
      //              if (damage2>1000) damage2=1000;
      target->receive_damage("kee", damage2, me);
      target->receive_wound("kee", damage2 / 2, me);
      COMBAT_D->report_status(target);
    }

    else
      message_vision(HIY "\n$n急忙缩身上跃，躲开了攻击，吓的脸色惨白。\n" NOR, me, target);
  }

  ///////////////////// 最后一招////////////////////
  if (skill > 249) {

    message_vision(
      HIW "\n黑暗之中突然闪过一道电光！不，那不是雷电，$N手中的" + weapon->query("name") + HIW "化做疾电刺破无边黑暗，往$n奔迅而来！！！\n" NOR,
      me,
      target
    );
    message_vision(HIC "\n$n双眼已被那极暗中的极光所伤，眼中只有那逼人的光亮。\n" NOR, me, target);

    if (me->query("combat_exp") / 5 * 6 > random(target->query("combat_exp"))) {
      damage2 = random(damage1);
      target->receive_damage("kee", damage2, me);
      target->receive_wound("kee", damage2 / 2, me);
      COMBAT_D->report_status(target);
      if (!target->is_busy() && !me->query_temp("shixie"))
        target->start_busy(2);
    }

    else {
      message_vision(HIY "\n$n赶忙纵身一旋堪堪闪出那光亮所罩，险险躲过此招。\n" NOR, me, target);
      if (!target->is_busy() && !me->query_temp("shixie"))
        target->start_busy(1);
    }
  }

  /////////////////////////////////////////////////

  me->set_temp("shi_busy", 1);
  call_out("remove_effect", 3 + random(5), me);
  me->start_busy(2 + random(2));
  me->add("force", -50 * num);




  return 1;
}


void remove_effect(object me) {
  if (!me) return;
  me->delete_temp("shi_busy");
}
int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("force") + " 300 级\n";
  temp += "\t\t" + to_chinese("whip") + " 300 级\n";
  temp += "\t\t必须通过shilian\n";
  //temp+= "\t\t不可与血灵剑法之嗜血并用\n"; 
  temp += "\t\t内力 300 点\n";
  temp += "\t\t精神 100 点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP 

        使用功效： 
                连续打击对手的气血并有机会牵制对手
        出招类型： 
                busy并有延时型武功
                有隐藏攻击 
                叛师可带出 
        出手要求：               
HELP);
  write(temp);
  return 1;
}
