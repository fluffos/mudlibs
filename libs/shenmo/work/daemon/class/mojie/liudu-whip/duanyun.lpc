#include <ansi.h>
#include <combat.h>
inherit F_DBASE;
inherit SSERVER;

int second_hit(object me, object target);
int duo(object me, object target);
int duo2(object me, object target);
int end_att(object me);

string name() {
  return "「" HIB "断云" NOR "」";
}

int valid_perform(object me) {
  if (me->query("shilian") < 1)
    return notify_fail("你还没有通过试炼塔的考验！\n");
  if (me->query("class") != "yao" && !me->samsara_check("liudu-whip", 1))
    return notify_fail(name() + "乃是魔界不传之秘。\n");
  if (me->query_skill("molian-spells", 1) < 150)
    return notify_fail("你魔莲法修为不足！\n");
  if (me->query_skill("liudu-whip", 1) < 150)
    return notify_fail("你的「留度鞭」修为不足！\n");
  if (me->query_skill("whip", 1) < 150)
    return notify_fail("你的鞭法的基本功不扎实！\n");
  if (me->query("force") <= 500)
    return notify_fail("你的内力不够使用" + name() + "！\n");
  //修改，不然skills高了，出了会死人的
  //snowtu        
  if (me->query("sen") <= me->query_skill("whip") / 10)
    return notify_fail("你的精力不够使用" + name() + "！\n");
  if (me->query_temp("duanyun"))
    return notify_fail("你正在使用" + name() + "绝招。\n");
  if (me->query_temp("duanyun_busy"))
    return notify_fail("绝招用的太多太滥就不灵了。\n");
  return 1;
}

int perform(object me, object target) {
  object weapon;
  mapping myfam;
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || !me->is_fighting(target))
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用！\n");

  message_vision(
    HIW "\n$N" HIW "心中平和，渐渐将手中长鞭使得圆转如意，手中" + (me->query_temp("weapon")->query("name")) + HIW "在内力摧动下闪出点点银光，有如云彩将$n" HIW "逐渐包围在其中。\n" NOR,
    me,
    target
  );
  me->set_temp("duanyun", 1);
  me->add("sen", -me->query_skill("whip") / 10);
  remove_call_out("second_hit");
  call_out("second_hit", 3, me, target);
  return 1;
}

int second_hit(object me, object target) {
  int ap, dp, damage;
  string str;

  if (!me)
    return 0;
  if (!target || !me->is_fighting(target)) {
    call_out("remove_effect", 1 + random(3), me);
    message_vision(HIW "\n$N" HIW "见战势已毕，长长的吸了一口气，将内力收回。\n" NOR, me);
    return 1;
  }
  me->delete_temp("duanyun", 1);
  message_vision(HIW "\n$N" HIW "内力鼓荡，一声清哮声中，向$n" HIW "猛地发出两招，瞬时间鞭上银光陡散，风声大作。\n" NOR, me, target);
  me->set_temp("duanyun_busy", 1);
  remove_call_out("remove_effect");
  call_out("remove_effect", 2 + random(4), me);

  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  ap = COMBAT_D->skill_power(me, "whip", SKILL_USAGE_ATTACK);
  ap += COMBAT_D->skill_power(me, "force", SKILL_USAGE_ATTACK);
  dp = COMBAT_D->skill_power(target, "parry", SKILL_USAGE_DEFENSE);
  dp += COMBAT_D->skill_power(target, "whip", SKILL_USAGE_DEFENSE);

  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    message_vision(
      HIW "\n两招过后，$N" HIW "招数一变，手中" + me->query_temp("weapon")->name() + HIW "在空中划了一个弧线，向$n" HIW "击落。\n" NOR,
      me,
      target
    );
  //if ( random(ap)>dp/4 )
  if (random(ap) > dp / 4 && !wizardp(me)) {
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(
        HIR "\n只听见$n" HIR "一声惨叫，" + me->query_temp("weapon")->name() + HIR "已打在$n" HIR "肩头，鲜血溅了一地。\n" NOR,
        me,
        target
      );
    damage = me->query_skill("liudu-whip", 1);
    damage -= me->query_skill("xueling-jian", 1) / 2;
    damage = damage * (3 + random(5));
    if (damage < 500) damage = 500;
    if (damage > 2500) damage = 2500;
    target->receive_wound("kee", damage / 2, me);
    target->receive_damage("kee", damage, me);
    COMBAT_D->report_status(target);
  } else if (random(ap) > dp / 3 && objectp(target->query_temp("weapon")) && random(4) == 1) {
    if (!me->query("env/no_msg") && !target->query("env/no_msg")) {
      message_vision(
        HIW "\n$n" HIW "见敌人招势凶猛，忙举起手中" + target->query_temp("weapon")->name() + HIW "招架。\n",
        me,
        target
      );
      message_vision(
        HIW "\n$N" HIW "鞭梢微扬，已经将$n" HIW "手中的" + target->query_temp("weapon")->name() + HIW "卷住，两人同时运力回夺。\n" NOR,
        me,
        target
      );
    }
    me->start_busy(3);
    target->start_busy(3);
    remove_call_out("duo");
    call_out("duo", 3, me, target);
    return 1;
  } else if (random(ap) > dp / 5 && objectp(target->query_temp("weapon")) && random(4) == 1) {
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(HIW "\n$n" HIW "身随意转，微微一晃已经将鞭梢抓住，两人同时运力回夺。\n" NOR, me, target);
    me->start_busy(3);
    target->start_busy(3);
    remove_call_out("duo2");
    call_out("duo2", 3, me, target);
    return 1;
  } else if (random(ap) > random(dp)) {
    if (!me->query("env/no_msg") && !target->query("env/no_msg")) {
      message_vision(HIW "\n$n" HIW "见此招来势凶猛，大骇之下向后跳开。\n" NOR, me, target);
      message_vision(HIW "\n$N" HIW "一击不中，身子一转，反手又是一招，猛地向$n" HIW "打去。\n" NOR, me, target);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    }
  } else message_vision(HIW "\n$n" HIW "见此招来势凶猛，忙向后跃开。\n" NOR, me, target);
  me->start_busy(1 + random(2));
  return 1;
}

int duo(object me, object target) {
  int amount1, amount2;

  if (!target || !me->is_fighting(target))
    return 1;
  if (!living(me) || me->is_ghost())
    return 1;
  //防止三秒内取下兵器后出错
  //snowtu        
  if (!me->query_temp("weapon") || !target->query_temp("weapon"))
    return 1;

  if (me->query("force") < me->query_skill("force", 1) * 15
    || target->query("force") < target->query_skill("force", 1) * 15) {
    if (me->query("force") > target->query("force")) {
      if (!me->query("env/no_msg") && !target->query("env/no_msg")) {
        message_vision(
          HIW "\n$N" HIW "运足了气力，猛地将" + me->query_temp("weapon")->name() + HIW "向后一拉，将$n" HIW "手中的" + target->query_temp("weapon")->name() + HIW "拉得脱手而出，掉在了地上。\n" NOR,
          me,
          target
        );
        message_vision(HIW "\n$N" HIW "顺手就是一招，向$n" HIW "击去。" NOR, me, target);
      }
      //加力data为force_factor        
      me->add("force_factor", me->query_skill("whip", 1));
      me->add_temp("apply/attack", me->query_skill("whip", 1));
      me->add_temp("apply/damage", me->query_skill("whip", 1));
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
      me->add("force_factor", -me->query_skill("whip", 1));
      me->add_temp("apply/attack", -me->query_skill("whip", 1));
      me->add_temp("apply/damage", -me->query_skill("whip", 1));
      target->query_temp("weapon")->move(environment(me));
      //更新敌人的动作
      //snowtu
      target->reset_action();
      target->start_busy(3 + random(3));
    } else {
      if (!me->query("env/no_msg") && !target->query("env/no_msg"))
        message_vision(
          HIW "\n$n" HIW "运足了气力，猛地将" + target->query_temp("weapon")->query("name") + HIW "向后一拉，将$N" HIW "手中的" + me->query_temp("weapon")->query("name") + HIW "拉得脱手而出，掉在了地上。\n" NOR,
          me,
          target
        );
      me->query_temp("weapon")->move(environment(me));
      me->reset_action();
      me->start_busy(1 + random(2));
    }
  } else {
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(
        HIW "\n只见$N" HIW "和$n" HIW "运足了内力用力回夺自己的兵刃，两人的衣服在内力鼓荡下如遇骤风。\n" NOR,
        me,
        target
      );
    amount1 = me->query_skill("force", 1);
    amount2 = target->query_skill("force", 1);
    if (random(amount1) > random(amount2)) {
      if (!me->query("env/no_msg") && !target->query("env/no_msg"))
        message_vision(YEL "\n只见$n" YEL "身子一晃，似乎有些支持不住。\n" NOR, me, target);
      target->add("force", -amount1);
      //防止内为负
      if (target->query("force") <= 0)
        target->set("force", 0);
    } else {
      if (!me->query("env/no_msg") && !target->query("env/no_msg"))
        message_vision(YEL "\n只见$N" YEL "身子一晃，似乎有些支持不住。\n" NOR, me, target);
      me->add("force", -amount2);
      //防止内力为负
      if (me->query("force") <= 0)
        me->set("force", 0);
    }
    me->add("force", -50);
    target->add("force", -50);
    //防止内为负
    if (target->query("force") <= 0)
      target->set("force", 0);
    if (me->query("force") <= 0)
      me->set("force", 0);
    me->start_busy(3);
    target->start_busy(3);
    me->start_busy(3);
    target->start_busy(3);
    call_out("duo", 3, me, target);
  }
  return 1;
}

int duo2(object me, object target) {
  int amount1, amount2;

  if (!target || !me->is_fighting(target))
    return 1;
  if (!living(me) || me->is_ghost())
    return 1;
  //防止三秒内取下兵器后出错
  //snowtu        
  if (!me->query_temp("weapon") || !target->query_temp("weapon"))
    return 1;

  if (me->query("force") < me->query_skill("force", 1) * 15
    || target->query("force") < target->query_skill("force", 1) * 15) {
    if (me->query("force") > target->query("force")) {
      if (!me->query("env/no_msg") && !target->query("env/no_msg"))
        message_vision(
          HIW "\n$N" HIW "运足了气力，猛地将" + me->query_temp("weapon")->query("name") + HIW "夺回，顺手就是一招，向$n" HIW "击去。" NOR,
          me,
          target
        );
      me->add("force_factor", me->query_skill("whip", 1));
      me->add_temp("apply/attack", me->query_skill("whip", 1));
      me->add_temp("apply/damage", me->query_skill("whip", 1));
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
      me->add("force_factor", -me->query_skill("whip", 1));
      me->add_temp("apply/attack", -me->query_skill("whip", 1));
      me->add_temp("apply/damage", -me->query_skill("whip", 1));
      target->start_busy(2 + random(2));
    } else {
      if (!me->query("env/no_msg") && !target->query("env/no_msg"))
        message_vision(
          HIW "\n$n" HIW "运足了气力，猛地将$N" HIW "手中的" + me->query_temp("weapon")->query("name") + HIW "拉得脱手而出，掉在了地上。\n" NOR,
          me,
          target
        );
      me->query_temp("weapon")->move(environment(me));
      me->reset_action();
      me->start_busy(1 + random(2));
    }
  } else {
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(WHT "\n只见$N" WHT "和$n" WHT "运足了内力用力回夺，两人的衣服在内力鼓荡下如遇骤风。\n" NOR, me, target);
    amount1 = me->query_skill("force", 1);
    amount2 = target->query_skill("force", 1);
    if (random(amount1) > random(amount2)) {
      if (!me->query("env/no_msg") && !target->query("env/no_msg"))
        message_vision(YEL "\n只见$n" YEL "身子一晃，似乎有些支持不住。\n" NOR, me, target);
      target->add("force", -amount1);
      if (target->query("force") <= 0)
        target->set("force", 0);
    } else {
      if (!me->query("env/no_msg") && !target->query("env/no_msg"))
        message_vision(YEL "\n只见$N身子一晃，似乎有些支持不住。\n" NOR, me, target);
      me->add("force", -amount2);
      if (me->query("force") <= 0)
        me->set("force", 0);
    }
    me->add("force", -50);
    target->add("force", -50);
    //防止内为负
    if (target->query("force") <= 0)
      target->set("force", 0);
    if (me->query("force") <= 0)
      me->set("force", 0);
    me->start_busy(3);
    target->start_busy(3);
    call_out("duo2", 3, me, target);
  }
  return 1;
}

void remove_effect(object me) {
  if (!me)
    return;
  me->delete_temp("duanyun_busy");
  me->delete_temp("duanyun", 1);
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("liudu-whip") + " 150 级\n";
  temp += "\t\t" + to_chinese("whip") + " 150 级\n";
  temp += "\t\t" + to_chinese("molian-spells") + " 150 级\n";
  temp += "\t\t必须已经通过shilian\n";
  temp += "\t\t内力 500 点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP 

        使用功效： 
                蓄力后发制人,并有机会夺取对方兵器
        出招类型： 
                延时型武功
                有隐藏攻击 
                叛师可带出 
        出手要求：               
HELP);
  write(temp);
  return 1;
}
