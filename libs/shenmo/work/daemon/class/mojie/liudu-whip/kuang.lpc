#include <ansi.h>

inherit SSERVER;

string name() {
  return "「" HIB "狂" NOR "」";
}

int valid_perform(object me) {
  if ((int)me->query_skill("liudu-whip", 1) < 60)
    return notify_fail("你的修为不够深，还使不出这一招！\n");

  if (me->query("shilian") < 1)
    return notify_fail("你还没有通过试炼塔的考验！\n");
  if (me->query("class") != "yao" && !me->samsara_check("liudu-whip", 1))
    return notify_fail(name() + "乃是魔界不传之秘。\n");

  if ((int)me->query("sen") < 100)
    return notify_fail("你的精神不够，无法使出这一招！\n");


  return 1;
}

int perform(object me, object target) {
  int mypot, tapot, time;
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用！\n");

  if (target->is_busy())
    return notify_fail(target->name() + "已经够忙了，你大胆的攻击吧。\n");
  message_vision(HIW "$N一声大喝，一招" HIG "「狂字决」" HIW "攻向$n，$n眼前仿佛出现了一条灵蛇！\n\n" NOR, me, target);
  if (!me->query("env/no_msg") && !target->query("env/no_msg")) {
    message_vision(HIG "                          _,..,,,_ \n" NOR, me, target);
    message_vision(HIG "                     '``````^~'-,_`'-,_\n" NOR, me, target);
    message_vision(HIG "       .-~c~-.                    `~:. ^-.\n" NOR, me, target);
    message_vision(
      HIG "   `~~~-.c    ;                      `:.  `-,     _.-~~^^~:.\n" NOR,
      me,
      target
    );
    message_vision(
      HIG "         `.   ;      _,--~~~~-._       `:.   ~. .~          `.\n" NOR,
      me,
      target
    );
    message_vision(
      HIG "          .` ;'   .:`           `:       `:.   `    _.:-,.    `.\n" NOR,
      me,
      target
    );
    message_vision(
      HIG "        .' .:   :'    _.-~^~-.    `.       `..'   .:      `.    '\n" NOR,
      me,
      target
    );
    message_vision(
      HIG "       :  .' _:'   .-'        `.    :.     .:   .'`.        :    ;\n" NOR,
      me,
      target
    );
    message_vision(
      HIG "        `-.__,-~                  ~-.        ,' ':    '.__.`    :'\n" NOR,
      me,
      target
    );
    message_vision(
      HIG "                                     ~--..--'     ':.         .:'\n" NOR,
      me,
      target
    );
    message_vision(
      HIG "                                                     ':..___.:'\n" NOR,
      me,
      target
    );
  }
  me->add("sen", -100);

  mypot = (int)me->query_skill("whip");
  mypot = mypot * mypot * mypot / 10 + (int)me->query("combat_exp");

  tapot = (int)target->query_skill("parry");
  tapot = tapot * tapot * tapot / 10 + (int)target->query("combat_exp");
  time = (int)me->query_skill("liudu-whip", 1) / 50;
  if (time > 10) time = 10;
  if (time < 2) time = 2;

  if (random(mypot + tapot) > tapot / 3) {
    message_vision(HIW "$N被吓得当时目瞪口呆，身体被灵蛇缠住，动弹不得！\n" NOR, target);

    target->start_busy(time);
  } else {
    message_vision(HIW "不料招被$N看破，攻其不备，$n反被打了个措手不及！\n" NOR, target,
      me);
    me->start_busy(2);
  }

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
    me->kill_ob(target);
  }
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("liudu-whip") + " 60 级\n";
  temp += "\t\t必须已经通过shilian\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP 

        使用功效： 
                长时间牵制对手
        出招类型： 
                busy型武功
                无隐藏攻击 
                叛师可带出 
        出手要求：               
HELP);
  write(temp);
  return 1;
}
