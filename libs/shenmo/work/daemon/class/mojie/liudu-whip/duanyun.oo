
#include <ansi.h>

inherit F_DBASE;
inherit SSERVER;

int second_hit(object me, object target);
int duo(object me, object target);
int duo2(object me, object target);
int end_att(object me);


string name()  
{
return "「"HIB"断云"NOR"」";  
}

int valid_perform(object me)
{
        if(me->query("family/family_name") != "魔界"  && me->query("shilian") < 1 )
                return notify_fail("你功夫太菜,领悟不到其精髓!!\n");
	                  
        if( (int)me->query_skill("molian-spells",1) < 150 )
                return notify_fail("你魔莲法修为不足！\n");
                
        if( me->query_skill("liudu-whip",1) < 150 )
                return notify_fail("你的「留度鞭」修为不足！\n");

	if( me->query_skill("whip",1) < 150 )
                return notify_fail("你的鞭法的基本功不扎实！\n");
        
        if( me->query("force") <= 500 )
                return notify_fail("你的内力不够使用"+name()+"！\n");
        if( me->query("sen") <= 200 )
                return notify_fail("你的精力不够使用"+name()+"！\n");     
        
        if(me->query_temp("duanyun"))
                return notify_fail("你正在使用"+name()+"绝招。\n");

        if (me->query_temp("duanyun_busy")) 
              return notify_fail("绝招用的太多太滥就不灵了。\n");

        
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
return 1;  
}

int perform(object me, object target)
{
        object weapon;
        mapping myfam;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 

        message_vision(HIW"\n$N心中平和，渐渐将手中长鞭使得圆转如意，手中"+(me->query_temp("weapon")->query("name"))+HIW"在内力摧动下闪出点点银光，有如云彩将$n逐渐包围在其中。\n"NOR,me,target);
        
        me->set_temp("duanyun",1);
        
     //   me->add("force",-me->query_skill("whip")/2);
        me->add("sen",-me->query_skill("whip")/10);
        
        remove_call_out("second_hit");
        call_out("second_hit", 1, me, target);        
 
 	return 1;       
}

int second_hit(object me, object target){

	int ap, dp, damage;
	string str;

	me->delete_temp("duanyun",1);
	
	if(me->is_fighting()){
	
		message_vision(HIY"\n$N内力鼓荡，一声清哮声中，向$n猛地发出三招，瞬时间鞭上银光陡散，风声大作。\n"NOR, me, target);

        me->set_temp("duanyun_busy",1);

        call_out("remove_effect",2+random(4),me);


		//me->add("jiali", me->query_skill("whip",1)/5);
		//me->add_temp("apply/strength", me->query_str());
		//me->add_temp("apply/attack",me->query_skill("whip",1));
		//me->add_temp("apply/damage",me->query_skill("whip",1));
		
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	
		//me->add("jiali", -me->query_skill("whip",1)/5);
		//me->add_temp("apply/attack",-me->query_skill("whip",1));
		//me->add_temp("apply/damage",-me->query_skill("whip",1));
		
		//printf("\n");
		//me->add("jiali", me->query_skill("whip",1)/5);
		//me->add_temp("apply/strength", me->query_str());
		//me->add_temp("apply/attack",me->query_skill("whip",1));
		//me->add_temp("apply/damage",me->query_skill("whip",1));
		
		
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
		
		//me->add("jiali", -me->query_skill("whip",1)/5);
		//me->add_temp("apply/attack",-me->query_skill("whip",1));
		//me->add_temp("apply/damage",-me->query_skill("whip",1));
		//me->add_temp("apply/strength", -me->query_str());
		
		ap=me->query("combat_exp")/100+me->query_skill("whip",1)+me->query("force");
		dp=target->query("combat_exp")/100+target->query_skill("whip",1)+target->query("force");
		
		message_vision(HIY"\n两招过后，$N招数一变，手中"+me->query_temp("weapon")->query("name")+HIY"在空中划了一个弧线，向$n击落。\n"NOR,me,target);
		
		if(random(ap)>dp/4){
		
                        message_vision(HIR"\n只听见$n一声惨叫，"+me->query_temp("weapon")->query("name")+HIR"已经打在$n肩头，鲜血溅了一地。\n"NOR, me, target);
			
                        damage=me->query_skill("liudu-whip",1);
                        damage-=me->query_skill("xueling-jian",1)/2;
                        damage=damage*(4+random(4));
			
			if (damage<500) damage=500;
				if (damage>2500) damage=2500;
			
//			if(wizardp(me))
//				printf("damage======%d", damage);
			
                        target->receive_damage("kee", damage, me);
                        target->receive_wound("kee", damage, me);                             
		
			str = COMBAT_D->status_msg((int)target->query("kee") * 100 /(int)target->query("max_kee"));
			message_vision("($N"+str+")\n", target);
			
		} else if(random(ap)>dp/3 && objectp(target->query_temp("weapon")) && me->is_fighting() && random(4)==1){
			
			message_vision(HIG"\n$n见敌人招势凶猛，忙举起手中"+target->query_temp("weapon")->query("name")+HIG"招架。\n", me, target);
			message_vision(HIW"\n$N鞭梢微扬，已经将$n手中的"+target->query_temp("weapon")->query("name")+HIW"卷住，两人同时运力回夺。\n"NOR, me, target);
			
			me->start_busy(3);
			target->start_busy(3);
		
			remove_call_out("duo");
 		        call_out("duo", 3, me, target);        
 		        
 		        return 1;
 			
		} else if(random(ap)>dp/3 && !objectp(target->query_temp("weapon")) && me->is_fighting() && random(4)==1){
		
			message_vision(HIG"\n$n身随意转，微微一晃已经将鞭梢抓住，两人同时运力回夺。\n"NOR,me,target);
			
			me->start_busy(3);
			target->start_busy(3);
		
			remove_call_out("duo2");
 		        call_out("duo2", 3, me, target);        
 		        
 		        return 1;
		
		} else if(random(ap)>random(dp)) {
		
			message_vision(HIY"\n$n见此招来势凶猛，大骇之下向后跳开。\n"NOR, me, target);		
		
			message_vision(HIG"\n$N一击不中，身子一转，反手又是一招，猛地向$n打去。\n"NOR,me,target);
		
			//me->add_temp("apply/strength", me->query_str());
			//me->add_temp("apply/attack",me->query_skill("whip",1));
			//me->add_temp("apply/damage",me->query_skill("whip",1));
						
			COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
		
			//me->add_temp("apply/attack",-me->query_skill("whip",1));
			//me->add_temp("apply/damage",-me->query_skill("whip",1));
			//me->add_temp("apply/strength", -me->query_str());
		
		} else
			message_vision(HIY "\n$n见此招来势凶猛，忙向后跃开。\n"NOR,me,target);        			
		
		me->start_busy(1+random(2));
	} else 
		message_vision(HIY "\n$N见战势已毕，长长的吸了一口气，将内力收回。\n"NOR, me);
		
		remove_call_out("second_hit");
		//remove_call_out("end_att");
		call_out("end_att", 1, me);
				
		return 1;
}



int duo(object me, object target){

	int amount1, amount2;
	
	if( !target || !me->is_fighting(target) ) return 1;

        if( !living(me) || me->is_ghost() ) return 1;

        if( !target || environment(me) != environment(target) || !me->is_fighting() ) return 1;

	if((me->query("force")<(me->query_skill("force",1)*15) || target->query("force")<(target->query_skill("force",1)*15))){
	
		if(me->query("force")>target->query("force")){
		
			message_vision(HIG"\n$N运足了气力，猛地将"+me->query_temp("weapon")->query("name")+HIG"向后一拉，将$n手中的"+target->query_temp("weapon")->query("name")+HIG"拉得脱手而出，掉在了地上。\n"NOR,me,target);

			message_vision(HIG"\n$N顺手就是一招，向$n击去。"NOR,me,target);

			me->add("jiali", me->query_skill("whip",1));
			me->add_temp("apply/attack",me->query_skill("whip",1));
			me->add_temp("apply/damage",me->query_skill("whip",1));
		
			COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	
			//printf("\n");
					
			me->add("jiali", -me->query_skill("whip",1));
			me->add_temp("apply/attack",-me->query_skill("whip",1));
			me->add_temp("apply/damage",-me->query_skill("whip",1));
					
			target->query_temp("weapon")->move(environment(me));
		
			target->start_busy(3+random(3));
		} else {
	
			message_vision(HIG"\n$n运足了气力，猛地将"+target->query_temp("weapon")->query("name")+HIG"向后一拉，将$N手中的"+me->query_temp("weapon")->query("name")+HIG"拉得脱手而出，掉在了地上。\n"NOR,me,target);
			
			me->query_temp("weapon")->move(environment(me));
		
			me->start_busy(1+random(2));
		}
	
	} else {
	
		message_vision(WHT"\n只见$N和$n运足了内力用力回夺自己的兵刃，两人的衣服在内力鼓荡下如遇骤风。\n"NOR, me, target);
		
		amount1=me->query_skill("force",1);
		amount2=target->query_skill("force",1);
		
		if(random(amount1)>random(amount2)){
			message_vision(YEL"\n只见$n身子一晃，似乎有些支持不住。\n"NOR, me, target);
			target->add("force",-amount1);
		} else {
		
			message_vision(YEL"\n只见$N身子一晃，似乎有些支持不住。\n"NOR, me, target);
			me->add("force",-amount2);
		}
		me->add("force", -50);
		target->add("force", -50);
		
		me->start_busy(3);
		target->start_busy(3);
		
		remove_call_out("duo");
 		call_out("duo", 3, me, target);        
 		        
 		return 1;
	}
	remove_call_out("duo");
	return 1;
}

int duo2(object me, object target){
	
	int amount1, amount2;

	if( !target || !me->is_fighting(target) ) return 1;

        if( !living(me) || me->is_ghost() ) return 1;

        if( !target || environment(me) != environment(target) || !me->is_fighting() ) return 1;

	if((me->query("force")<(me->query_skill("force",1)*15) || target->query("force")<(target->query_skill("force",1)*15))){

		if(me->query("force")>target->query("force")){
		
			message_vision(HIG"\n$N运足了气力，猛地将"+me->query_temp("weapon")->query("name")+HIG"夺回，顺手就是一招，向$n击去。"NOR,me,target);

			me->add("jiali", me->query_skill("whip",1));
			me->add_temp("apply/attack",me->query_skill("whip",1));
			me->add_temp("apply/damage",me->query_skill("whip",1));
		
			COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	
			//printf("\n");
					
			me->add("jiali", -me->query_skill("whip",1));
			me->add_temp("apply/attack",-me->query_skill("whip",1));
			me->add_temp("apply/damage",-me->query_skill("whip",1));
		
			target->start_busy(2+random(2));
		
		} else {
	
			message_vision(HIG"\n$n运足了气力，猛地将$N手中的"+me->query_temp("weapon")->query("name")+HIG"拉得脱手而出，掉在了地上。\n"NOR,me,target);

			me->query_temp("weapon")->move(environment(me));
		
			me->start_busy(1+random(2));
		}
	
	} else {
		
		message_vision(WHT"\n只见$N和$n运足了内力用力回夺，两人的衣服在内力鼓荡下如遇骤风。\n"NOR, me, target);
		
		amount1=me->query_skill("force",1);
		amount2=target->query_skill("force",1);
		
		if(random(amount1)>random(amount2)){
			message_vision(YEL"\n只见$n身子一晃，似乎有些支持不住。\n"NOR, me, target);
			target->add("force",-amount1);
		} else {
		
			message_vision(YEL"\n只见$N身子一晃，似乎有些支持不住。\n"NOR, me, target);
			me->add("force",-amount2);
		}
		me->add("force", -50);
		target->add("force", -50);
		
		me->start_busy(3);
		target->start_busy(3);
		
		remove_call_out("duo2");
 		call_out("duo2", 3, me, target);        
 		        
 		return 1;
	}

	remove_call_out("duo2");
	return 1;
}

void remove_effect(object me) {
  if (!me) return;
  me->delete_temp("duanyun_busy");
}
int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("liudu-whip")+" 150 级\n"; 
temp+= "\t\t"+to_chinese("whip")+" 150 级\n"; 
temp+= "\t\t"+to_chinese("molian-spells")+" 150 级\n"; 
temp+= "\t\t必须已经通过shilian\n"; 
temp+= "\t\t内力 500 点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP 

        使用功效： 
                蓄力后发制人,并有机会夺取对方兵器
        出招类型： 
                延时型武功
                有隐藏攻击 
                叛师可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
