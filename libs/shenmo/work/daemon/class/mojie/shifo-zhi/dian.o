
#include <ansi.h>

inherit F_DBASE;
inherit SSERVER;

string* xuedao1 = ({
	"四白穴",
	"地仓穴",
	"大迎穴",
	"峡车穴",
	"头维穴",
	"下关穴"
});

string* xuedao2 = ({
	"隐白穴",
	"太白穴",
	"商丘穴",
	"地机穴"
});

string* xuedao3 = ({
	"少冲穴",
	"少海穴",
	"通理穴",
	"神门穴"
});

string* xuedao4 = ({
	"印堂穴",
	"金律穴",
	"玉液穴",
	"鱼腰穴",
	"百劳穴"
});

string* xuedao5 = ({
	"百会穴",
	"灵台穴",
	"太阳穴",
	"膻中穴",
	"命门穴",
	"鸠尾穴",
	"气海穴"
});

int perform(object me, object target)
{
	int sp, dp, time;

	if( !target && me->is_fighting() ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      !me->is_fighting( target )
        ||      target==me)
                return notify_fail("你要攻击谁？\n");


	if ( me->query_temp("weapon") ) 
		return notify_fail("拿着武器怎么点穴？\n");


	if( me->query_str() < 25 )
		return notify_fail("你在臂力上先天禀赋不足，点穴反受其害！\n");
        if(me->query("family/family_name") != "魔界"  && me->query("shilian") < 1 )
                return notify_fail("你功夫太菜,领悟不到其精髓!!\n");

	             
	if( me->query_skill("unarmed") < 90 )
		return notify_fail("你的功夫太差，不会点穴！\n");

	if( me->query_skill("heilian-force", 1) < 90 )
		return notify_fail("你的内功修为火候未到，无法使用点穴！\n");

	if( me->query("max_force") <= 300 )
		return notify_fail("你的内力修为不足，劲力不能贯透，无法点穴！\n");

	sp = me->query_skill("dodge")/50 + me->query_skill("parry")/50 + me->query("kar")+me->query_skill("unarmed",1)/50+me->query_skill("shifo-zhi",1)/50;
	dp = target->query_skill("dodge")/50 + target->query_skill("parry")/50 + target->query("kar");
		
	time = (me->query_skill("force") - target->query_skill("force") + me->query_skill("shifo-zhi",1))/15;
     
       if (time>5) time=5;

	if( me->query("force") <= 2*time )
		return notify_fail("你的内力不够，劲力不能贯穿穴道！\n");

	if( random(sp) > dp*2/4 && time > 0 )
	{
		if( me->query_skill("unarmed") >=  90 && me->query_skill("unarmed") < 115)
		message_vision(HIR "\n$N五指并拢，身形闪动间，已点中了$n的" + xuedao1[1+random(5)] + "！\n\n" NOR, me, target);

		if( me->query_skill("unarmed") >= 115 && me->query_skill("unarmed") < 140)
		message_vision(HIR "\n$N伸出三根手指，一挥手点中了$n的" + xuedao2[1+random(3)] + "！\n\n" NOR, me, target);

		if( me->query_skill("unarmed") >= 140 && me->query_skill("unarmed") < 165)
		message_vision(HIR "\n$N双指如刀如戟，着着进逼，唰地一声，已戳在了$n的" + xuedao3[1+random(3)] + "上！\n\n" NOR, me, target);

		if( me->query_skill("unarmed") >= 165 && me->query_skill("unarmed") < 190)
		message_vision(HIR "\n$N交叉两根食指，一缕罡气破空迸出，笔直射入$n的" + xuedao4[1+random(4)] + "！\n\n" NOR, me, target);

		if( me->query_skill("unarmed") >= 190 )
		message_vision(HIR "\n$N食指轻弹，一片排山倒海的暗劲顿时涌出，击在$n的" + xuedao5[1+random(6)] + "上！\n\n" NOR, me, target);

		me->add("force", (-10)*time);

		target->start_busy(time);

		}
	else
	{	
		message_vision(HIW "\n$N一指点去，可是$n早已料敌机先，一闪身避了开去！ \n\n$N身前顿时空门大露，狼狈地招架着 .... \n" NOR, me, target);
		if( !target->is_fighting(me) ) target->fight_ob(me);
		me->start_busy(2+random(1));
	}
//        if (random(2) == 1) {
//	    if (! target->is_killing(me)) target->kill_ob(me);
// 	}

	return 1;
}
