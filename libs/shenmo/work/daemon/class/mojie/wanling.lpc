#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
        object sword;
        int kee_wound;
	        
	if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招「傲雪争霜」？\n");

        if(!me->is_fighting())
                return notify_fail("「傲雪争霜」只能在战斗中使用！\n");

        if((int)me->query("force") < 500 )
                return notify_fail("你的内力不够！\n");
	if(me->query("family/family_name")!="大雪山")
                return notify_fail("“傲雪争霜”只有大雪山弟子才可以用！\n");
        if((int)me->query("kee") < 300 )
                return notify_fail("你的气血不足，没法子施用外功！\n");

        if((int)me->query_skill("bainiao－jian", 1) < 150)
                return notify_fail("你的百鸟剑法级别还不够，使用这一招会有困难！\n");
        if (me->query_skill_mapped("sword") != "sword")
        return notify_fail("你现在无法使用「傲雪争霜」来攻击。\n");
		 if(random(60) > (int)me->query("kar"))
	 return notify_fail("你已经使不出这招惊天地、泣鬼神的「傲雪争霜」了。\n");	 
	me->delete("env/brief_message");

	message_vision(HIC"\n$N剑走龙蛇，剑风四起，霍霍的光影忽高忽低，与余树奇所挥舞的金光，互相辉映。“"HIR"傲雪争霜"NOR+HIC"”！与余树奇所挥舞的金光，互相辉映。顿时间天昏地暗，电闪雷鸣，地动天摇！\n"NOR, me);


//	me->set_temp("sword_per", 8);
	COMBAT_D->do_attack(me, target, me->query_temp("sword"));

//	me->delete_temp("sword_per");
        
        kee_wound = me->query("eff_kee")/(2+random(5));
	me->receive_damage("kee", 1500);
	target->add("kee", -kee_wound);	
	target->add("eff_kee", -(kee_wound));
	me->add("force", -10);
	message_vision(HIW"$n只感觉眼前一晃，看不见对方的剑势从何而来，又往何处去，只能感觉到突然觉得有件冰冷的东西刺人了自己的肋骨。\n"NOR,me, target);
	target->start_busy(0);

        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }

	me->start_busy(0);
	return 1;
}
