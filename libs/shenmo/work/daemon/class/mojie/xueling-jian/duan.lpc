// 断剑 duan.c

#include <ansi.h>
#include <combat.h>

inherit SSERVER;
string name() {
  return "「" HIR "断云" NOR "」";
}

int valid_perform(object me) {
  if (me->query("shilian") < 1)
    return notify_fail("你还没有通过试炼塔的考验！\n");
  if (me->query("class") != "yao" && !me->samsara_check("xueling-jian", 1))
    return notify_fail(name() + "乃是魔界不传之秘。\n");
  if ((int)me->query_skill("xueling-jian", 1) < 150)
    return notify_fail("你的剑法修为不足以驾驭" + name() + "。\n");


  if ((int)me->query("force") < 300)
    return notify_fail("你的内力不够。\n");

  return 1;
}

int perform(object me, object target) {
  string msg, *limbs, *ghost;
  int i, size, damage;
  object me_w;
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "必须战斗中方可使用。\n");

  me->add("force", -200);

  me_w = me->query_temp("weapon");




  msg = HIR "$N" HIR "缓缓举起手中的" + me_w->query("name") + HIR "，将黑莲魔功注入" + me_w->query("name") + HIR "，" + me_w->query("name") + HIR "头上突然发出一阵奇异光芒。\n" NOR;
  message_vision(msg, me, target);

  if (random((int)me->query("combat_exp")) > random((int)target->query("combat_exp") / 2)) {
    msg = HIR "$N运起黑莲魔功,大喝一声“去！”\n" NOR;
    msg += HIR + me_w->query("name") + HIR "上立时喷射出千万怨灵朝$n" HIR "扑嗜而去！\n" NOR;
    if (random((int)me->query_skill("dodge")) > random((int)target->query_skill("parry") / 3)) {
      limbs = target->query("limbs");
      ghost = ({
        HIB "尸灵" NOR, HIM "腐灵" NOR, BBLU + HIR "戾灵" NOR, BBLU + HIB "缢灵" NOR, HIC "情灵" NOR,
      });

      damage = (int)me->query_skill("xueling-jian", 1);
      damage += (int)me->query_skill("sword");
      damage = damage / 4 + random(damage / 4);
      size = random(damage / 50);
      if (size < 3) size = 3;
      for (i = 0; i <= size; i++) {
        msg += HIR "一声惨叫，" + ghost[random(sizeof(ghost))] + HIR "一口咬住$n" + limbs[random(sizeof(limbs))] + "！\n" NOR;
        target->receive_damage("kee", damage, me);
        target->receive_damage("sen", damage, me);
        target->receive_wound("kee", damage / 3, me);
        if (!me->query("env/no_msg") && !target->query("env/no_msg"))
          msg += HIR + COMBAT_D->damage_msg(damage, "内伤") + NOR;
      }
    } else {
      msg += HIR "$n" HIR "见势不妙，一个“野驴打滚 ”堪堪躲开，不由被这诡异的招式惊得目瞪口呆。\n" NOR;
      if (!target->is_busy())
        target->start_busy(1 + random(3));
    }
  } else {
    msg += HIR "$n" HIR "知道$N" HIR "有杀招暗藏其中，连忙退后一步，小心防范。\n" NOR;
    msg += HIR "$N" HIR "见$n" HIR "已有戒备，暗叹一声，收起黑莲魔功。\n" NOR;
  }
  message_vision(msg, me, target);
  me->start_busy(1);
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("xueling-jian") + " 150 级\n";
  temp += "\t\t必须已经通过shilian\n";

  temp += "\t\t内力 300 点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP 

        使用功效： 
                连续打击对手的气血和精神
        出招类型： 
                busy型武功
                无隐藏攻击 
                叛师可带出 
        出手要求：               
HELP);
  write(temp);
  return 1;
}
