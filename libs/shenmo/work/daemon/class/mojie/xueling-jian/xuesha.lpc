#include <ansi.h>
inherit SSERVER;

string name()  
{
return "「"HIR"血杀"NOR"」";
}

int valid_perform(object me)
{
        if(me->query("family/family_name") != "魔界"  && me->query("shilian") < 1 )
                return notify_fail("你功夫太菜,领悟不到其精髓!!\n");

        if( (int)me->query_skill("xueling-jian", 1) < 70 )
                return notify_fail("你的血灵剑法不够娴熟，不会使用"+name()+"。\n");

        if( (int)me->query_skill("heilian-force", 1) < 70 )
                return notify_fail("你的黑莲魔功不够高，不能用来反震伤敌。\n");

        if( (int)me->query("force", 1) < (int)me->query("max_force")/50)
                return notify_fail("你现在内力不够，不能使用"+name()+"。\n");

return 1;
}

int perform(object me, object target)
{
        object weapon;
        int damage;
        string msg;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");

        msg = CYN "$N微微一笑，猛吸一口气，欲使出以气驭剑绝技攻击$n。\n"NOR;
        if( !target->is_killing(me) ) target->kill_ob(me);
        if (random(me->query_skill("force")) > target->query_skill("force")/5 )
{
    target->start_busy( (int)me->query_skill("xueling-jian") / 30 + 1);

                damage = me->query_skill("sword", 1);
                damage = damage*2+  me->query_skill("xuelian-jian", 1);
                target->receive_damage("kee", damage);
                target->receive_wound("kee", damage/2);            
                me->add("force", -200);          
                msg += HIR"只见$N手中剑光幻作一团鲜血，腾空而起，倏的罩向$n。\n"NOR;
                msg += HIR"$n只觉一股大力铺天盖地般压来,登时眼前一花，两耳轰鸣,哇的喷出一口鲜血！！\n"NOR;
                me->start_busy(2);
        } else 
{
                msg += CYN"可是$p猛地向前一跃,跳出了$P的攻击范围。\n"NOR;
                me->add("force", -(int)me->query("max_force")/50);
                me->start_busy(3);
}
        message_vision(msg, me, target);

        return 1;
}


int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("xueling-jian")+" 70 级\n"; 
temp+= "\t\t"+to_chinese("heilian-force")+" 70 级\n"; 
temp+= "\t\t内力不得低于最大内力的1/50\n"; 
temp+= "\t\t必须已经通过shilian\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                给对手强有力的一击并长时间牵制对手
        出招类型： 
                busy型武功
                无隐藏攻击 
                叛师可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
