// shixie.c 嗜血
//因为需要放弃whip才能学，所以需要NB一点
//snowtu@xmxyj2000/2003/10

#include <ansi.h>
inherit SSERVER; 
int remove_effect(object me);  

string name()  
{
return "「"HIR"嗜血"NOR"」";  
}

int valid_perform(object me)
{
if( (int)me->query_skill("xueling-jian", 1) < 150 )
        return notify_fail("你的血灵剑法不够娴熟，不会使用"+name()+"。\n");


if( (int)me->query_skill("molian-spells", 1) < 150 )
        return notify_fail("你的魔莲法不够高，不能用来使用此招。\n");

        if( me->query("shilian") < 1 )
                return notify_fail("你还没有通过试炼塔的考验！\n");

if ( me->query("class")!="yao" && !me->samsara_check("xueling-jian",1))
        return notify_fail(name()+"乃是魔界不传之秘。\n");
                         
if( (int)me->query("force", 1) < 500 )
        return notify_fail("你现在内力太弱，不能使用"+name()+"。\n");

if( me->query_temp("shixie",1) )   
        return notify_fail("你已经运起了"+name()+"！\n");  


return 1;  
}

int perform(object me, object target)
{
int i,damage,skill;
string msg,name;
object weapon = me->query_temp("weapon");
name = weapon->query("name");
skill = (int)me->query_skill("molian-spells",1);
skill = skill/40;
skill =  25-skill;
if (skill<5) skill=5;
if (skill>15) skill=15;
skill = random(skill);

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

msg = RED"$N"RED"退后数步，将体内黑莲之气输入"NOR WHT+name+NOR RED"，"NOR WHT+name+RED"上好似包裹住一层朦胧的红光。\n"NOR;
msg+= RED"$n"RED"对此异像惊得目瞪口呆。\n"NOR;


me->add("force",-100);
me->set_temp("shixie",1); 
me->start_call_out( (: call_other, __FILE__, "remove_effect", me :),skill ); 
message_vision(msg, me, target);

damage = (int)me->query_skill("xueling-jian", 1);
damage = damage/2 + random(damage/2);
if ( wizardp(me) ) tell_object(me,HIW"\n伤害力:"NOR+HIR+chinese_number(damage)+"\n\n"NOR );

if (!target->start_busy() && random(me->query("level"))>target->query("level")/3 && !(int)me->query_skill("liudu-whip"))
        target->start_busy(1+random(4));

if ( random(me->query("combat_exp")) > target->query("combat_exp")/3)
        {
        for ( i=0;i<damage/50;i++ ) 
                {
                msg = HIR"$n"HIR"一个不防，中了一剑，"NOR+name+HIR"上的红光愈加浓烈，好似吸了人血一般！\n"NOR;
              target->receive_damage("kee", damage+random(damage)+100);
                if( me->query_temp("shixie",1) )   
                        me->add("eff_kee",100+random(damage) ) ;
                if (me->query("eff_kee")>me->query("max_kee")) 
                        me->set("eff_kee",(int)me->query("max_kee") ) ;
                if( me->query_temp("shixie",1) )   
                        me->add("kee",100+random(damage) ) ;
                if (me->query("kee")>me->query("eff_kee")) 
                        me->set("kee",(int)me->query("eff_kee") ) ;
if ( !me->query("env/no_msg") && !target->query("env/no_msg") ) 
                message_vision(msg, me, target);
     if( me->query("env/no_status")==0 && !userp(target) )
                COMBAT_D->report_status(target);
                }
        tell_object(me,name+HIW"上红光笼罩住你，你觉得自己气血渐渐恢复起来。\n"NOR);
        }
else if (  random(me->query("combat_exp")) > target->query("combat_exp")/6 )
        {
        msg = RED"结果$n"RED"被$N"RED"的邪力一震，眼前一黑，向后便倒，眼看就要不醒人事了！\n"NOR;
        target->receive_damage("sen", damage*2+random(damage*2) );
        target->receive_wound("sen", damage*2+random(damage*2) );
        message_vision(msg, me, target);
        COMBAT_D->report_sen_status(target);
        }
else  {
        msg = RED"$n"RED"看破了$N"RED"的企图，嗔目大喝，消去了$N"RED"的邪力。\n"NOR;
        message_vision(msg, me, target);
        }
return 1;
}

int remove_effect(object me)  
{ 
me->delete_temp("shixie");  
if ( me->query_temp("weapon") )
message_vision(RED"\n$N"RED"长长呼出一口气，收起了邪力，"+NOR+WHT+(me->query_temp("weapon"))->query("name")+NOR+RED"上的红艳之光渐渐淡了下来。\n\n" NOR, me);  
return 0;  
} 

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("xueling-jian")+" 150 级\n"; 
temp+= "\t\t"+to_chinese("molian-spells")+" 150 级\n"; 
temp+= "\t\t必须已经通过shilian\n"; 
temp+= "\t\t内力 500 点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                连续打击对手气血化为己有
                退而求其次可严重伤害敌人的精神
        出招类型： 
                延时型武功
                当没有兼学留度鞭时有隐藏攻击 
                叛师可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
