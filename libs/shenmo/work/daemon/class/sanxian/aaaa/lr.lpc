#include <ansi.h>
inherit SSERVER;

int perform2(object me, object target);
int def;

string name() {
  return "「" HIG "寒冰烈焰" NOR "」";
}

int valid_perform(object me) {
  if (!me)
    return 0;
  if (me->query("family/family_name") != "三界散仙" && !me->samsara_check("ice_fire_zhang", 2))
    return notify_fail("你非三界散仙弟子，不能用此招。\n");
  if (me->query_skill("ice_fire_zhang", 1) < 100)
    return notify_fail("你的" + to_chinese("ice_fire_zhang") + "等级不足 100 级，不能施展" + name() + "。\n");
  if (me->query_skill("unarmed", 1) < 100)
    return notify_fail("你的" + to_chinese("unarmed") + "等级不足 100 级，不能施展" + name() + "。\n");
  if (me->query_skill("force", 1) < 100)
    return notify_fail("你的" + to_chinese("force") + "等级不足 100 级，不能施展" + name() + "。\n");
  if (me->query("max_force") < 1200)
    return notify_fail("你的内力修为不足 1200 点，不能施展" + name() + "。\n");
  if (me->query("force") < 600)
    return notify_fail("你的真气不足 600 点，不能施展" + name() + "。\n");
  return 1;
}

int perform(object me, object target) {
  string msg, str;
  int damage, p, time, ap, dp;
  if (!valid_perform(me))
    return 0;
  if (!target)
    target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("只能在战斗中使用。\n");
  if (!me->is_fighting())
    return notify_fail(name() + "必须在战斗中使用。\n");

  msg = HIG "突然$N" HIG "大喝一声:「" HIW "寒冰掌" HIG "」";
  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    msg += ",左掌突然变得奇寒无比！\n" NOR;
  else msg += "！\n" NOR;
  ap = me->query("combat_exp");
  ap /= 10000;
  dp = target->query("combat_exp");
  dp /= 10000;
  if (COMBAT_D->restrain(me, target))
    ap += ap / 3;
  if (COMBAT_D->restrain(target, me))
    dp += dp / 3;
  if (random(ap + dp) > dp) {
    me->start_busy(2);
    target->start_busy(1);
    damage = (int)me->query_skill("ice_fire_zhang", 1);
    damage = damage + random(damage / 2);
    def = target->query_temp("apply/armor_vs_force");
    damage -= damage / 100 * def / 4000000;
    if (damage > 1200) damage = 1200;
    target->receive_damage("kee", damage, me);
    target->receive_wound("kee", damage / 2, me);
    me->add("force", -(damage / 4));
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      msg += HIB "“嗡”的一声，一掌击中$n" HIB "的前胸！\n" NOR;
    message_vision(msg, me, target);
    COMBAT_D->report_status(target);
  } else {
    me->start_busy(random(3));
    me->add("force", -200);
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      msg += HIY "可是$p伏地一滚，躲开了对手的攻击。\n" NOR;
    message_vision(msg, me, target);
  }
  if (me->query_skill("ice_fire_zhang", 1) > 149)
    return perform2(me, target);
  return 1;
}

int perform2(object me, object target) {
  int damage, p, skill, ap, dp, hit = 0;
  string msg, weapon, str;
  weapon = me->query_temp("weapon");
  if (!me)
    return 0;
  if (!target || !me->is_fighting(target)) {
    write(HIR "你见已无敌人，将" + name() + "平息了下来。\n" NOR);
    return 1;
  }
  if (me->query("force", 1) < 300) {
    write(HIR "你待要再出第二击，却发现自己的内力不够了！\n" NOR);
    return 1;
  }
  msg = HIR "紧接着，$N" HIR "大喝一声:「" NOR RED "烈焰掌" NOR HIR "」！\n";
  ap = COMBAT_D->skill_power(me, "unarmed");
  dp = COMBAT_D->skill_power(target, "parry");
  dp += COMBAT_D->skill_power(target, "dodge");
  dp /= 2;
  if (COMBAT_D->restrain(me, target))
    hit = 1;
  if (COMBAT_D->restrain(target, me))
    hit = -1;
  if (hit == -1) {
    me->start_busy(random(3));
    me->add("force", -200);
    msg += HIR "可是$p伏地一滚，躲开这一掌。\n" NOR;
    message_vision(msg, me, target);
  } else if (random(dp + ap) < dp / 2 && hit < 1) {
    me->start_busy(random(3));
    me->add("force", -200);
    msg += HIR "可是$p伏地一滚，躲开这一掌。\n" NOR;
    message_vision(msg, me, target);
  } else {
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      msg += HIR "$N" HIR "的右拳热浪滔天向$n" HIR "的胸口击来。
$n" HIR "经受着一冷一热两股力量的攻击，已经陷入精神恍惚的状态。\n" NOR;
    else msg += "" NOR;
    me->start_busy(2);
    target->start_busy(1);
    damage = me->query_skill("ice_fire_zhang", 1);
    damage = damage + (int)me->query_skill("unarmed", 1);
    damage = damage + (int)me->query_skill("butian-force", 1);
    damage = (damage + random(damage)) / 2;
    def = target->query_temp("apply/armor_vs_force");
    damage -= damage / 100 * def / 8000000;
    if (damage > 2000) damage = 2000;
    target->receive_damage("sen", damage, me);
    target->receive_wound("sen", damage / 2, me);
    if (!me->query("env/innoxious") && target->query("spskk") != 9)
      target->apply_condition("ice_fire_poison", 20);
    me->add("force", -random(damage / 10));
    message_vision(msg, me, target);
    COMBAT_D->report_sen_status(target);
  }
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("ice_fire_zhang") + " 100 级\n";
  temp += "\t\t" + to_chinese("unarmed") + " 100 级\n";
  temp += "\t\t" + to_chinese("force") + " 100 级\n";
  temp += "\t\t内    力 600 点\n";
  temp += "\t\t内力修为 1200 点\n";
  temp += "\t\t战斗状态下使用\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                对敌人造成气血和精神的全面伤害
                并能使得敌人中毒
        出招类型：
                busy性外功
                不可叛师带出
        出手要求：              
HELP);
  write(temp);
  return 1;
}
