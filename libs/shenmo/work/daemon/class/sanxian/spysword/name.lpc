#include <ansi.h>
inherit SSERVER;

string name()
{
return "「"HIW"名可名 非常名"NOR"」";
}

string *names = ({
        HIW"\t无名天地之始\n"NOR,
        HIG"\t有名万物之母\n"NOR,
        HIR"\t同为之玄，玄之又玄，众妙之门\n"NOR,
});     

int valid_perform(object me)
{
if ( !me ) 
        return 0;       
if ( me->query("class")!="xian" && !me->samsara_check("spysword"))
        return notify_fail("你非三界散仙弟子，不能用此招。\n");
if ( me->query_skill("spysword", 1) < 100 )
        return notify_fail("你的"+to_chinese("spysword")+"等级不足 100 级，不能施展"+name()+"。\n");
if ( me->query_skill("sword", 1) < 100 )
        return notify_fail("你的"+to_chinese("sword")+"等级不足 100 级，不能施展"+name()+"。\n");
if ( me->query("max_force")<500 )
        return notify_fail("你的内力修为不足 500 点，不能施展"+name()+"。\n");
if ( me->query("force")<100 )
        return notify_fail("你的真气不足 100 点，不能施展"+name()+"。\n");
if ( me->query("bellicosity")>300 )
        return notify_fail("你的杀气太盛，施展不开"+name()+"。\n");        
return 1;       
}

int perform(object me, object target)
{       
string msg;
int damage, ap,dp,skill,i;
object weapon;

if ( !valid_perform(me) )
        return 0;
if ( !target ) 
        target = offensive_target(me);
if ( !target 
  || !target->is_character()
  || !me->is_fighting(target) )
        return notify_fail("只能在战斗中使用。\n");
if ( !me->is_fighting() )
        return notify_fail(name()+"必须在战斗中使用。\n");

weapon = me->query_temp("weapon");
//if ( me->query("family/family_name")=="三界散仙"  )
//        me->set_temp("sanxian_bishou",time());
msg = HIC"
$N"HIC"妙悟刺客剑法的要旨「名可名 非常名」，连续几剑，浑无招式痕迹可循向$n"HIC"刺去！\n"NOR;
message_vision(msg,me,target);
msg = "";

ap = COMBAT_D->skill_power(me,"sword",1);
ap+= COMBAT_D->skill_power(me,"dodge",1);
ap/= 2;
dp = COMBAT_D->skill_power(target,"parry",1);
dp+= COMBAT_D->skill_power(target,"dodge",1);
dp/= 2;

if ( COMBAT_D->restrain(me,target) 
  || me->query("family/family_name")=="三界散仙"  )
        ap+= ap/3;
if ( COMBAT_D->restrain(target,me) )
        dp+= dp/3;

COMBAT_D->do_attack(me,target,me->query_temp("weapon"));
COMBAT_D->do_attack(me,target,me->query_temp("weapon"));
COMBAT_D->do_attack(me,target,me->query_temp("weapon"));

if ( me && target && me->is_fighting(target) 
  && me->query("force")>=100 && living(target) 
  && me->query_skill("spysword",1)>350 )
        {
        if ( !me->query("env/no_msg") && !target->query("env/no_msg") )  
                msg+= HIW"\n$N"HIW"酣畅淋漓地使了这招，剑意舒展，"+weapon->name()+"在手中一转又如狂风般攻向$n"HIW"！\n"NOR;
        skill = me->query_skill("spysword",1);
        skill/= 100;
        if ( skill>3 ) skill = 3;
        damage = me->query_skill("sword");
        damage+= me->query("force_factor");
        damage+= me->query_temp("apply/damage");
        damage = damage/3+random(damage/2);
        damage-= target->query_temp("apply/armor")/2;
        if ( damage<100 )
                damage = 100;
        message_vision(msg,me,target);          
        for(i=0;i<skill;i++)
                {
                if ( !me || !target || !me->is_fighting(target) 
                  || me->query("force")<100 || !living(target) )
                        continue;
                if ( random(ap+dp)*(i+1)>dp )                                       
                        {
                        msg = names[i]; 
                        message_vision(msg,me,target);  
                        me->add("force",-30);
                        if ( me->query("family/family_name")=="三界散仙" || me->samsara_check("spysword",1) )
                                damage+= random(damage/2);
                        target->receive_damage("kee",damage,me);
                        COMBAT_D->report_status(target);
                        }
                else    me->add("force",-50);   
                }
        }
me->start_busy(1+random(3));
if ( me->query("family/family_name")=="三界散仙" || me->samsara_check("spysword",1) )
        target->start_busy(random(3));
return 1;
}       

int help(object me)
{
string temp;    
temp = "\t\t"+to_chinese("spysword")+" 100 级\n";
temp+= "\t\t"+to_chinese("sword")+" 100 级\n";
temp+= "\t\t内    力 100 点\n";
temp+= "\t\t内力修为 500 点\n";
temp+= "\t\t杀    气 300 点以下\n";
temp+= "\t\t战斗状态下使用\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");
write(@HELP

        使用功效：
                连续对敌人造成气血的减少
                并且每次的伤害递加
        出招类型：
                busy型外功
                可叛师带出
                有隐藏效果
        出手要求：              
HELP);  
write(temp);
return 1;
}

