#include <ansi.h>
inherit SSERVER;

string name()
{
return "「"HIC"道可道 非常道"NOR"」";
}

int valid_perform(object me)
{
if ( !me ) 
        return 0;       
if ( me->query("class")!="xian" && !me->samsara_check("spysword"))
        return notify_fail("你非三界散仙弟子，不能用此招。\n");
if ( !me->query("m_success/剑道遗篇") && !me->samsara_check("spysword"))
        return notify_fail("你不会剑道密传绝技。\n");
if ( me->query_skill("spysword", 1) < 100 )
        return notify_fail("你的"+to_chinese("spysword")+"等级不足 150 级，不能施展"+name()+"。\n");
if ( me->query("max_force")<500 )
        return notify_fail("你的内力修为不足 500 点，不能施展"+name()+"。\n");
if ( me->query("force")<100 )
        return notify_fail("你的真气不足 100 点，不能施展"+name()+"。\n");
if ( time()<me->query_temp("sanxian_pfm_dao")+3+random(5) )
        return notify_fail("你刚展施完"+name()+"，内息还没调整过来。\n");        
return 1;       
}

int perform(object me, object target)
{       
string msg;
int damage, ap,dp,ratio;
object weapon;

if ( !valid_perform(me) )
        return 0;
if ( !target ) 
        target = offensive_target(me);
if ( !target 
  || !target->is_character()
  || !me->is_fighting(target) )
        return notify_fail("只能在战斗中使用。\n");
if ( !me->is_fighting() )
        return notify_fail(name()+"必须在战斗中使用。\n");

weapon = me->query_temp("weapon");
me->set_temp("sanxian_pfm_dao",time());
msg = HIM"$N"HIM"突然剑招一变，手中的"+ weapon->query("name")+ HIM"无影无踪，浑身喷薄出凌厉的剑气。\n"NOR;
message_vision(msg,me,target);
msg = "";

ap = COMBAT_D->skill_power(me,"sword",1);
dp = COMBAT_D->skill_power(target,"parry",1);
dp+= COMBAT_D->skill_power(target,"dodge",1);
dp/= 2;

if ( COMBAT_D->restrain(me,target)  || me->samsara_check("spysword",1)
  || me->query("family/family_name")=="三界散仙"  )
        ap+= ap/3;
if ( COMBAT_D->restrain(target,me) )
        dp+= dp/3;

damage = me->query_temp("apply/damage");
damage-= target->query_temp("apply/armor");
damage+= (me->query_str()-target->query_con())*random(me->query_cor());  
if ( damage>2000) damage = 1000+random(1000);
damage = damage * me->query("old_flag/jiandao")/2;
if ( random(ap+dp)>dp && damage )
        {
        target->receive_wound("kee",damage/3,me);
        if ( target )
                target->receive_damage("kee",damage,me);
        me->add("force",-100);
        ratio = target->query("kee")/target->query("max_kee")*100;
        if ( damage<500 ) 
                msg += HIM"结果$n"HIM"胸口一痛，闷哼一声。\n"NOR;
        else if( damage<800 ) 
                msg += HIM"结果$n"HIM"被$N"HIM"连中几剑，『嘿』地一声退了两步。\n"NOR;
        else if( damage<1200 ) 
                msg += HIM"结果$n"HIM"被$N"HIM"重重的剑气袭中，有如受到数记重锤，连退了五六步！\n"NOR;
        else msg+= HIM"结果$n"HIM"被$N"HIM"的『道可道 非常道』剑气穿心，眼前一黑，身子向后飞出丈许！！\n"NOR;
        msg+= NOR"( $n";
        if( ratio==100 ) 
                msg+= RED"看起来充满活力，一点也不累。"NOR;
        if( ratio>95 ) 
                msg+= RED"似乎有些疲惫，但是仍然十分有活力。"NOR;
        if( ratio>90 ) 
                msg+= HIR"看起来可能有些累了。"NOR;
        if( ratio>80 ) 
                msg+= HIR"动作似乎开始有点不太灵光，但是仍然有条不紊。"NOR;
        if( ratio>60 ) 
                msg+= HIR "气喘嘘嘘，看起来状况并不太好。"NOR;
        if( ratio>40 )
                msg+= HIY "似乎非常疲惫，看来需要好好休息了。"NOR;
        if( ratio>30 )
                msg+= HIY"已经一副头重脚轻的模样，正在勉力支撑着不倒下去。"NOR;
        if( ratio>20 ) 
                msg+= HIY"看起来已经力不从心,马上要支持不住了。"NOR;
        if( ratio>10 ) 
                msg+= HIG"摇头晃脑、歪歪斜斜地站都站不稳，眼看就要倒在地上。"NOR;
        else    msg+= HIG"已经陷入半昏迷状态，随时都可能摔倒晕去。"NOR;
        msg+= NOR" )\n";
        }
else    {
        msg+= WHT"$N"WHT"手中"+weapon->name()+WHT"一震,结果蓬勃的剑气又缩了回去!\n"NOR;
//        if( me->query("family/family_name")!="三界散仙" )
//                me->start_busy(3);
        }
if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
        message_vision(msg,me,target);
else    COMBAT_D->report_status(target);
if ( !me || !target || !me->is_fighting(target) )   return 1;
                        
if ( random(ap+dp)>dp/2
  && ( me->query("family/family_name")=="三界散仙"  || me->samsara_check("spysword",1)
    || me->query_skill("spysword",1)>600 )
   && target
  && me->is_fighting(target) 
  && me->query("force")>200 )
        {  
        msg = HIR"\n这一式"+name()+"使毕，$N"HIR"闲步微移，"+ weapon->name()+ HIR"灵动异常，
在剑意已尽，劲势已灭之际，又生新力，又续杀机！\n" NOR;
        if ( me->query("force")<target->query("force") )
                {
                msg+= HIR"$n只觉得剑气袭体，顿时混身一震，一副魂不守舍的模样．．\n" NOR;
                damage*=2;
                }
        else    {
                msg+= HIR"$n只觉得剑气袭体，不由混身一震，心神有些不宁．．\n" NOR;
                damage = target->query("sen")/2;
                }
        damage = damage/2+random(damage/2);
        if ( COMBAT_D->restrain(target,me) )
                damage-= damage/3;
        if ( COMBAT_D->restrain(me,target) )            
                damage+= damage/3;
        target->receive_wound("sen",damage/3,me);
        if ( target )
                target->receive_damage("sen",damage,me);
        if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
                message_vision(msg,me,target);
        COMBAT_D->report_sen_status(target);            
        if ( !target->is_busy() && (me->query("family/family_name")=="三界散仙" || me->samsara_check("spysword",1) ))
                target->start_busy(1+random(4));
        me->add("force",-150);  
        }       
return 1;
}       

int help(object me)
{
string temp;    
temp = "\t\t"+to_chinese("spysword")+" 100 级\n";
temp+= "\t\t最大内力 500 点\n";
temp+= "\t\t内力 100 点\n";
temp+= "\t\t必须找到剑道遗篇\n";
temp+= "\t\t战斗状态下使用\n";
write(@HELP
刺客剑法  之 「道可道 非常道」

        使用功效：
                连续打击敌人的气血并有可能严重打击对方的心神
                并使之僵直
        出招类型：
                延迟型外功
                可叛师带出
                有隐藏效果
        出手要求：              
HELP);  
write(temp);
return 1;
}

