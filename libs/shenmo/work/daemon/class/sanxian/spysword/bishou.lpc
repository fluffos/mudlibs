#include <ansi.h>
inherit SSERVER;

string name()
{
return "「"HIR"图穷匕现"NOR"」";
}

string *names = ({
        "白虹贯日",
        "流血五步",
        "天下缟素",
        "禁招 -- 图穷匕首现",
});
        
int valid_perform(object me)
{
if ( !me ) 
        return 0;       
if ( me->query("class")!="xian" && !me->samsara_check("spysword"))
        return notify_fail("你非三界散仙弟子，不能用此招。\n");
if ( me->query_skill("spysword", 1) < 120 )
        return notify_fail("你的"+to_chinese("spysword")+"等级不足 120 级，不能施展"+name()+"。\n");
if ( me->query("max_force")<500 )
        return notify_fail("你的内力修为不足 500 点，不能施展"+name()+"。\n");
if ( me->query("force")<100 )
        return notify_fail("你的真气不足 100 点，不能施展"+name()+"。\n");
if ( time()<me->query_temp("sanxian_bishou")+5 )
        return notify_fail(name()+"需要五秒的冷却时间。\n");        
return 1;       
}

int perform(object me, object target)
{       
string msg,*limbs,limb,*hit_msg;
string str;
int damage, ap,dp,skill,i;
object weapon;

if ( !valid_perform(me) )
        return 0;
if ( !target ) 
        target = offensive_target(me);
if ( !target 
  || !target->is_character()
  || !me->is_fighting(target) )
        return notify_fail("只能在战斗中使用。\n");
if ( !me->is_fighting() )
        return notify_fail(name()+"必须在战斗中使用。\n");

weapon = me->query_temp("weapon");
limbs = target->query("limbs");
hit_msg = ({
        "$n躲闪不及，$l被$W刺个正着，鲜血从$l汩汩而出！\n",
        "眨眼间，$N手中的$W无声无息地刺中了$n的$l！\n",
        "$n突然觉得$l一阵剧痛，原来被$N手上的$W狠狠刺伤！\n",
});     
if ( me->query("family/family_name")=="三界散仙" || me->samsara_check("spysword",1) )
        me->set_temp("sanxian_bishou",time());
msg = HIW"
$N"HIW"突然收起手中"+ weapon->name()+ HIW"，悄无声息地闪到$n"HIW"身旁！\n"NOR;
message_vision(msg,me,target);
msg="";

ap = COMBAT_D->skill_power(me,"sword",1);
ap+= COMBAT_D->skill_power(me,"dodge",1);
ap/= 2;
dp = COMBAT_D->skill_power(target,"parry",1);
dp+= COMBAT_D->skill_power(target,"dodge",1);
dp/= 2;

if ( COMBAT_D->restrain(me,target) 
  || me->query("family/family_name")=="三界散仙" || me->samsara_check("spysword",1) )
        ap+= ap/3;
if ( COMBAT_D->restrain(target,me) )
        dp+= dp/3;

skill = me->query_skill("spysword",1);
skill/= 60;
if ( skill>4 )
        skill = 4;
for(i=0;i<skill;i++)
        {
        if ( !me || !target || !me->is_fighting(target) 
          || me->query("force")<50 )
                continue;       
        damage = me->query_skill("spysword",1);
        damage-= me->query_skill("baihe-blade",1);
        damage+= me->query("force_factor");
        damage+= me->query_temp("apply/damage");
        damage = damage/4+random(damage/2);
        damage-= target->query_temp("apply/armor");
        if ( damage<100 )
                damage = 100;
        damage+= (i+1)*150;
        limb = limbs[random(sizeof(limbs))];
        str = hit_msg[random(sizeof(hit_msg))];
        msg = name()+"第"+chinese_number(i+1)+"式"+names[i]+"。";
        if ( random(ap+dp)>random(dp/2*3) || me->samsara_check("spysword",1) || ( me->query("family/family_name")=="三界散仙" && me->query_skill("spysword",1)>=350 ) )
                {
                if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
                        msg+= str;
                else msg+= "\n";
                msg = replace_string(msg,"$W",weapon->name());
                msg = replace_string(msg,"$l",limb);
                message_vision(msg,me,target);
                me->add("force",-30);
                target->receive_wound("kee",damage,me);
                COMBAT_D->report_status(target,damage);
                message_vision("\n",me,target);
                }
        else    {
                msg+= "\n";
                message_vision(msg,me,target);
                me->add("force",-50);   
                }
        }       
if ( me->query("family/family_name")!="三界散仙"  && !me->samsara_check("spysword",1))        
        me->start_busy(1+random(3));
return 1;
}                       

int help(object me)
{
string temp;    
temp = "\t\t"+to_chinese("spysword")+" 120 级\n";
temp+= "\t\t内    力 100 点\n";
temp+= "\t\t内力修为 500 点\n";
temp+= "\t\t战斗状态下使用\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");
if ( me->query("family/family_name")!="三界散仙"  )        
        write(@HELP

        使用功效：
                连续对敌人造成气血的伤害
                并且每次的伤害递加
        出招类型：
                busy型外功
                可叛师带出
                有隐藏效果
        出手要求：              
HELP);  
else    write(@HELP

        使用功效：
                连续对敌人造成气血的伤害
                并且每次的伤害递加
        出招类型：
                延迟型 外功
                可叛师带出
                有隐藏效果
        出手要求：              
HELP);  

write(temp);
return 1;
}

