//write by windy 2011 08
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() {
  return "「" HIB "鬼谷七阴刀" NOR "」";
}

int valid_perform(object me) {
  if (me->query("family/family_name") != "三界散仙" && !me->samsara_check("baihe-blade", 1))
    return notify_fail("只有散仙弟子才可以施展" + name() + "！\n");
  if ((int)me->query("force") < 1000)
    return notify_fail("你内力不够，施展不出" + name() + "！\n");
  if ((int)me->query("max_force") < 2000)
    return notify_fail("你内力修为不够，施展不出" + name() + "！\n");
  if (me->query_skill("baihe-blade", 1) < 350)
    return notify_fail("你的捭阖刀法还不够娴熟，施展不出" + name() + "。\n");
  if (me->query_skill("blade", 1) < 350)
    return notify_fail("你的基本刀法水平太低，施展不出" + name() + "。\n");
  if (me->query_skill("butian-force", 1) < 350)
    return notify_fail("你对补天心法的理解尚浅，施展不出" + name() + "。\n");
  return 1;
}

int perform(object me, object target) {
  string msg;
  int extra;
  object weapon;

  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用！\n");

  weapon = me->query_temp("weapon");
  extra = me->query_skill("baihe-blade", 1) / 3;
  extra += me->query_skill("butian-force", 1) / 5;
  me->add_temp("apply/attack", extra);
  me->add_temp("apply/damage", extra);

  msg = HIB "$N" HIB "掌中" + weapon->name() + HIB "闪烁不定，神出鬼没般已连出七刀，正是鬼谷子一生捭阖之术精华之体现！\n" NOR;
  message_vision(msg, me, target);

  if (!target->is_busy())
    target->start_busy(1);

  msg = HIY "\n盛神法五龙！" NOR;
  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR);
  msg = HIM "\n养志法灵龟！" NOR;
  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR);
  msg = HIG "\n实意法腾蛇！" NOR;
  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR);
  msg = HIW "\n分威法伏熊！" NOR;
  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR);
  msg = HIC "\n散势法鸷鸟！" NOR;
  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR);
  msg = HIB "\n转圆法猛兽！" NOR;
  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR);
  msg = HIR "\n损悦法灵蓍！" NOR;
  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR);

  me->add_temp("apply/attack", -extra);
  me->add_temp("apply/damage", -extra);
  me->add("force", -100);
  me->start_busy(2);
  return 1;
}
int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("baihe-blade") + " 350 级\n";
  temp += "\t\t" + to_chinese("blade") + " 350 级\n";
  temp += "\t\t" + to_chinese("butian-force") + " 350 级\n";
  temp += "\t\t内力修为二十年\n";
  temp += "\t\t内力1 0 0 0点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                连续打击对手气血
        出招类型：
                busy型外功
                有隐藏效果
                叛师不可带出
        出手要求：
HELP);
  write(temp);
  return 1;
}
