//modify by windy 06/05/20
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() {
  return "「" HIW "纵横天下" NOR "」";
}

int valid_perform(object me) {
  if (!me) return 0;
  if (me->query("family/family_name") != "三界散仙" && me->query_skill("baihe-blade", 1) < 350)
    return notify_fail("你还不够资格使用" + name() + "！\n");
  if (me->query("class") != "xian" && !me->samsara_check("baihe-blade"))
    return notify_fail("你还不够资格使用" + name() + "！\n");
  if (me->query_skill("baihe-blade", 1) < 150)
    return notify_fail("你的捭阖刀法修为太浅，还施展不出" + name() + "！\n");
  if (me->query_skill("blade", 1) < 150)
    return notify_fail("你的基本刀法修为太浅，还施展不出" + name() + "！\n");
  if ((int)me->query("max_force") < 1000)
    return notify_fail("你的内力修为太差。\n");
  if ((int)me->query("force") < 500)
    return notify_fail("你的内力不足！\n");
  if (time() - (int)me->query_temp("baihe_end") < 3 + random(3))
    return notify_fail("绝招用多了就不灵了！\n");
  return 1;
}

int perform(object me, object target) {
  object weapon;
  int ap, dp, damage;

  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用！\n");

  weapon = me->query_temp("weapon");

  ap = me->query_skill("blade");
  if (me->query("family/family_name") == "三界散仙")
    ap += ap / 3;

  dp = target->query_skill("parry");
  if (me->query("family/family_name") == "三界散仙")
    dp += dp / 3;

  damage = me->query_temp("apply/damage");
  damage -= target->query_temp("apply/armor");
  if (damage < 0) damage = 0;
  damage += me->query_skill("baihe-blade", 1);
  damage += me->query_skill("spysword", 1) * 7;  //baihe-blade高的，spysword不会高。
  damage += me->query_skill("butian-force", 1);
  damage += me->query("force_factor");
  damage += me->query("mana_factor");
  damage += me->query("level");

  message_vision(
    HIW "\n$N" HIW "右手的" + weapon->query("name") + HIW "挥出一道死亡的弧线，向着$n" HIW "呼啸而来！\n" NOR,
    me,
    target
  );
  message_vision(HIW "长刀所向，天地变色，风云倒卷，天幕仿若塌陷般，凝聚在$N" HIW "这一刀之中！\n" NOR, me, target);

  if (random(ap) > dp / 4) {
    message_vision(HIG "\n只听$n" HIG "惨叫一声，肩头已被刀锋穿透！\n" NOR, me, target);
    target->receive_damage("kee", damage + random(damage / 2), me);
    target->receive_wound("kee", damage / 2, me);
    COMBAT_D->report_status(target);
  } else message_vision(HIY "\n$n" HIY "骇然之下瞬间闪身躲避，刀芒从其身旁划过！\n" NOR, me, target);

  me->add("force", -300);
  me->set_temp("baihe_end", time());
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("baihe-blade") + " 150 级\n";
  temp += "\t\t" + to_chinese("blade") + " 150 级\n";
  temp += "\t\t内力修为十年\n";
  temp += "\t\t内力5 0 0点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP 

        使用功效： 
                攻击对手的气血
        出招类型： 
                延时型外功
                无隐藏攻击 
                叛师可带出 
        出手要求：               
HELP);
  write(temp);
  return 1;
}
