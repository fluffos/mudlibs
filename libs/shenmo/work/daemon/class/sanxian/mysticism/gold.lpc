// gold.c,金砖
#include <ansi.h>

inherit SSERVER;

int cast(object me, object target)
{
        int success_adj, damage_adj;

//        if(!me->query("m_success/金砖"))
//                return notify_fail("你又不会这法术。。。。\n");
        if( !target ) target = offensive_target(me);

   if( (string)me->query("class")!="xian" && !me->samsara_check("mysticism",1))
                return notify_fail("非仙族弟子无法使用此招？\n");
     if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要用金砖砸谁？\n");

if( time()-(int)me->query_temp("gold_cast") < 3+random(5) ) 
        return notify_fail(YEL"你的魔法尚未恢复！\n"NOR);
        if((int)me->query("mana") < 25+2*(int)me->query("mana_factor") )
                return notify_fail("你的法力不够！\n");

        if((int)me->query("sen") < 20 )
                return notify_fail("你无法集中精力，别砸中自己了！\n");

        if (me->query("betrayer") || me->query("betray/count"))
           return notify_fail("三心二意者很难领悟散仙的精髓所在。\n");
        
        
        me->add("mana", -25-2*(int)me->query("mana_factor"));
        me->receive_damage("sen", 10);

        if( random(me->query("max_mana")) < 50 ) {
                write("好象没反应，再来一次吧！\n");
                return 1;
        }

        SPELL_D->attacking_cast(
                me, 
                        //attacker 
                target, 
                        //target
                "kee",                 
                        //damage type: could be "qi"/"kee", "shen"/"sen", ...default "both"
                HIY "$N祭起一道金光，一块金砖呼！地一声向$n当头砸下！\n" NOR,
                        //initial message
                HIY "结果砸个正着，把$n砸得血肉模糊！\n" NOR, 
                        //success message
                HIY "但是$n在千钧一发之际跳了开来。\n" NOR, 
                        //fail message
                HIY "但是金砖被$n以法力一引，反而砸到了$N的顶门！\n" NOR, 
                        //backfire initial message
                HIY "结果砸个正着，把$n砸得血肉模糊！\n" NOR
                        //backfire hit message. note here $N and $n!!!
        );

if ( me->query("family/family_name")!="三界散仙" && !me->samsara_check("mysticism",1)) 
        me->start_busy(1+random(2));
me->set_temp("gold_cast",time());
        return 3+random(5);
}


