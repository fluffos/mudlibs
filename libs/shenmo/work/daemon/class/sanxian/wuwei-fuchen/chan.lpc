#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
	int mypot,tapot,time;

	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("「有所为 有所不为」只有在战斗中才能使用。\n");
        if(me->query("family/family_name")!="三界散仙")
                return notify_fail("非三界散仙弟子怎能悟透无未精髓！\n");
	if( (int)me->query_skill("wuwei-fuchen", 1) < 100 ) 
		return notify_fail("你的修为不够深，还使不出这一招！\n");
        if(me->is_busy())
                return notify_fail("你太忙了！\n");;
	if( target->is_busy() )
		return notify_fail(target->name()+"已经够忙了，无为对他起不了什么作用。\n");
  message_vision(HIW"$N大喝一声,$n你知道有所为 有所不为吗！\n\n"NOR,me, target);

	mypot=(int)me->query_skill("blade");
	mypot=mypot*mypot*mypot/10 + random( (int)me->query("combat_exp"));

	tapot=(int)target->query_skill("parry");
	tapot=tapot*tapot*tapot/10 + random( (int)target->query("combat_exp"));

time=(int)me->query_skill("wuwei-fuchen", 1) /100;
      if ( time > 10 ) time = 10;
        if ( time < 4  ) time = 4;

        if ( random( mypot + tapot ) > tapot/2 ) {
		message_vision(HIY"$N果然为你所动,陷入深思中！\n"NOR,target);
//                target->start_busy(5+random(time));
target->start_busy(2+random(2));
me->start_busy(1);
                
	}else {
	message_vision(HIR"不料确被$N看破，纵身一跃，跳出站圈！\n"NOR,target,
me);
me->start_busy(1+random(time/2));
	}

        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
                me->kill_ob(target);
        }
	return 1;
}
