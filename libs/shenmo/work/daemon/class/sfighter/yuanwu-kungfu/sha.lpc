#include <ansi.h>
inherit SSERVER;

string name() {
  return "「" RED "瞬·狱·杀" NOR "」";
}

int valid_perform(object me) {
  if (me->query("family/family_name") != "格斗家" || me->query("class") != "saint")
    return notify_fail("你不够资格使用" + name() + "！\n");
  if ((int)me->query_skill("yuanwu-kungfu", 1) < 200)
    return notify_fail("你的元武门绝学还不够娴熟，不会使用" + name() + "。\n");
  if ((int)me->query_skill("unarmed", 1) < 200)
    return notify_fail("你的扑击格斗之技还不够娴熟，不会使用" + name() + "。\n");
  if ((int)me->query("max_force") < 1000)
    return notify_fail("你的内力太弱，不足以使用" + name() + "。\n");
  if ((int)me->query("force") < 50 + me->query("force_factor"))
    return notify_fail("你的内力不足！\n");
  if ((int)me->query("sen") < 200)
    return notify_fail("你的精神不足，没法子施用外功！\n");
  if (me->query_temp("sha_busy") + 5 + random(5) > time())
    return notify_fail("绝招用多就不灵了。\n");
  return 1;
}

int perform(object me, object target) {
  int i, damage, tui, fly, j;
  string powercol;

  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用！\n");

  i = me->query("combat_exp") / 8000 + 1;
  j = target->query("combat_exp") / 25000 + 1;
  damage = me->query_skill("unarmed") + me->query("force_factor") + me->query("apply/damage") + me->query_skill("literate");
  if (me->query_temp("yi")) damage = damage * 3 / 2;
  damage = damage / 2 + random(damage / 2);
  if (damage < 1000) damage = 1000;

  message_vision(BLU "\n微笑，一个极其诡异的微笑在$N" BLU "嘴角缓缓展现。\n" NOR, me, target);
  message_vision(BLU "恐惧，一股令人恶寒的恐惧在$n" BLU "心际蓦然诞生。\n" NOR, me, target);
  message_vision(BLU "强烈的血腥味随风而至，$n" BLU "回神四顾，豁然发现，炼狱，一个活生生的修羅炼狱，而自己，正身处其中！\n" NOR, me, target);
  message_vision(BLU "$n" BLU "急忙纵身欲跳出此炼狱，一道劲而疾的风袭来，$N" BLU "双手已迎面抓至！\n" NOR, me, target);

  if (random(i * me->query_int()) > j * target->query_int()) {
    message_vision(
      HIR "\n$n" HIR "避无可避，被$N" HIR "抓了个正着，轰的一声巨响，整个人被重重摔至地面，登时胸前一闷，鲜血狂喷不止。\n" NOR,
      me,
      target
    );
    message_vision(HIR "一道人影飘然而至，刹那间，万千劲气袭身而来，蚀肉销骨，$n" HIR "如堕修羅炼狱,惨叫连连。\n" NOR, me, target);
    target->receive_damage("kee", damage, me);
    target->receive_wound("kee", damage, me);
    COMBAT_D->report_status(target);
  } else {
    message_vision(HIG "\n$n" HIG "急忙提气运劲，在半空中硬是横移了数丈，堪堪躲过这招。\n" NOR, me, target);
    message_vision(HIG "$N" HIG "所造修羅炼狱随着此招的失败土崩瓦解，$n" HIG "压力顿失，不由得长舒了一口气。\n" NOR, me, target);
  }
  me->set_temp("sha_busy", time());
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("yuanwu-kungfu") + " 200 级\n";
  temp += "\t\t" + to_chinese("unarmed") + " 200 级\n";
  temp += "\t\t内力修为十年\n";
  temp += "\t\t内力至少２００点\n";
  temp += "\t\t精神２００点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP 

        使用功效：   
                伤害对手的气血
        出招类型：   
                延时型外功  
                无隐藏效果  
                叛师不可带出   
        出手要求：     
HELP);
  write(temp);
  return 1;
}
