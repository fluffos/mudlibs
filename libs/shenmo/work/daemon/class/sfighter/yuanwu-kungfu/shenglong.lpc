
#include <ansi.h> 
 
inherit SSERVER; 
 
string dcol(int level) 
{ 
        if ( level == 1 ) 
                return HIC "波状气劲" NOR; 
        else if ( level == 2) 
                return HIC "波状气劲" NOR; 
        else if ( level == 3) 
                return HIC "波状气劲" NOR; 
        else if ( level == 4) 
                return HIW "白色气波" NOR; 
        else if ( level == 5) 
                return HIY "黄色气波" NOR; 
        else if ( level == 6) 
                return HIG "绿色气波" NOR; 
        else if ( level == 7) 
                return HIR "红色气波" NOR; 
        else if ( level == 8) 
                return HIB "蓝色气波" NOR; 
        else if ( level == 9) 
                return HIM "紫色气波" NOR; 
        else    return BLK "黑色气波" NOR; 
} 
 
string powercol(int level) 
{ 
        if ( level == 1 ) 
                return HIC "X 级力量" NOR; 
        else if ( level == 2) 
                return HIC "Z 级力量" NOR; 
        else if ( level == 3) 
                return HIC "V 级力量" NOR; 
        else if ( level == 4) 
                return HIW "白 鬭 气" NOR; 
        else if ( level == 5) 
                return HIY "黄 鬭 气" NOR; 
        else if ( level == 6) 
                return HIG "绿 鬭 气" NOR; 
        else if ( level == 7) 
                return HIR "红 鬭 气" NOR; 
        else if ( level == 8) 
                return HIB "蓝 鬭 气" NOR; 
        else if ( level == 9) 
                return HIM "紫 鬭 气" NOR; 
        else    return BLK "黑 鬭 气" NOR; 
} 

string name()  
{
return "「"HIY"昇龍拳"NOR"」";  
}

int valid_perform(object me)
{
        if(me->query("family/family_name") != "格斗家" || me->query("class")!="saint")
                return notify_fail("你不够资格使用"+name()+"！\n");
        if( (int)me->query_skill("yuanwu-kungfu",1) < 100 )
                return notify_fail("你的元武门绝学还不够娴熟，不会使用"+name()+"。\n");
        if((int)me->query("max_force") < 500 ) 
                return notify_fail("你的内力不够！\n"); 
 
        if((int)me->query("force") < 200 ) 
                return notify_fail("你的内力不足！\n"); 
 
        if((int)me->query("sen") < 200 ) 
                return notify_fail("你的精神不足，没法子施用外功！\n"); 
 
        if(me->query_temp("sl_busy")+2 > time() )  
                return notify_fail("你刚使用过"+name()+",体力尚未恢复。\n"); 
        return 1;
}

int perform(object me, object target) 
{ 
        int i,damage,tui,fly,skill,skill2; 
        string dcol,powercol; 

        if ( !valid_perform(me) )
                return 0;
        if( !target ) target = offensive_target(me); 
        if( !target 
        ||      !target->is_character() 
        ||      target->is_corpse() 
        ||      target==me) 
                return notify_fail("你要对谁施展"+name()+"？\n"); 
        if(!me->is_fighting()) 
                return notify_fail(name()+"只能在战斗中使用！\n");
 
        if((!me->query("sfighter/sha")&&!me->query("sfighter/ba")) ||( me->query_temp("sl_count")>100 && !me->query_temp("yi")) ){ 
 
            message_vision("\n昇龍拳起手式刚起，$N突起异变,蓄满的劲力顿失，全身不住颤抖。\n",me); 
            message_vision(HIY"$N皮肤突然发出金色光芒，令人窒息的强烈霸意不断从$N身上散发出来，周围的事物亦禁不住颤抖起来！\n"NOR,me); 
 
            skill=me->query_skill("yuanwu-kungfu",1); 
            skill2=me->query_skill("ghost-spirit",1); 
            me->set_temp("sfighter/skill",skill); 
            me->set_temp("sfighter/skill2",skill2); 
//            me->set("old_name",me->query("name")); 
//            me->set("name",HIY"霸意·"+me->query("name")+""NOR); 
            me->set("sfighter/ba",1); 
            me->set_temp("bayi",1); 
            me->set_temp("yi",1); 
            me->set_temp("max_sen",me->query("max_sen")); 
            me->add_temp("apply/damage",(skill+skill2)/3); 
            me->add_temp("apply/armor",(skill+skill2)/2); 
            me->add_temp("apply/dodge",(skill+skill2)/3); 
            me->add_temp("apply/parry",(skill+skill2)/3); 
            me->add_temp("apply/unarmed",(skill+skill2)/3); 
            call_out("check_yi",5,me); 
            return 1; 
          } 
 
                
        dcol=dcol(me->query("power_lvl")); 
        powercol=powercol(me->query("power_lvl")); 
 
        i=(int)me->query_skill("unarmed"); 
        i+=(int)me->query_skill("ghost-spirit", 1); 
        i=i*3/2; 
        damage=i+me->query("force_factor")+me->query("apply/damage")+me->query_skill("yuanwu-xinfa", 1); 
 
        if (me->query_temp("shayi")) damage=damage*6/5; 
        if (me->query_temp("yi")&&me->query_skill("ghost-spirit",1)>299&&me->query_skill("ghost-spirit",1)<600) damage=damage*8/5; 
        if (me->query_temp("yi")&&me->query_skill("ghost-spirit",1)>599&&me->query_skill("ghost-spirit",1)<900) damage=damage*9/5; 
        if (me->query_temp("yi")&&me->query_skill("ghost-spirit",1)>899) damage=damage*2; 
        if (!me->query_temp("yi")&&me->query_skill("yuanwu-xinfa",1)>200&&!me->query("ghost-spirit")) damage=damage*2;
        if(tui=target->query_temp("sfighter/tui")) damage=damage*3/2; 
        if(fly=target->query_temp("sfighter/fly")) damage=damage*3/2;  
 
//**************************** normal 
 
      if (!me->query_temp("yi")||me->query_temp("shayi")){ 
         message_vision(HIC"\n$N俯身蓄力，将全身力量聚在右拳之上，自下而上划出一个刁滑的的角度，带着冲天的劲道直击而上。\n"NOR,me,target); 
 
         if(fly)  
           message_vision(HIR"身体刚刚坠下,这一击打的恰是时机!$n立刻似乎断线的风筝一般,在半空中连翻了数个筋斗！波的喷出一口鲜血。\n"NOR,me,target); 
 
         if( random(me->query("combat_exp")/8000 * me->query_int())  
                > random((int)target->query("combat_exp")/25000 * target->query_int())){ 
 
            message_vision(HIR"只见一条"+dcol+HIR"拔地而起，张牙舞爪直冲而上，$n一个闪避不及，被撞个正着。\n"NOR,me,target); 
    
            if (!random(3)&&!tui&&!fly) {message_vision(HIW"\n$n乍不及防，硬被此招击上了半空。\n"NOR,me,target); 
                                         target->set_temp("sfighter/fly",1); 
                                         call_out("remove_effect2",2,target);} 
             
          }else{  
               message_vision(HIG"$n早有防备，往后轻轻一跃，闪了开去。\n"NOR,me,target);         
               damage=0;} 
                
      } 
 
//**************************** bayi 
 
      if (me->query_temp("bayi")){ 
         message_vision(HIY"\n$N"+HIY"再也控制不住体内的澎湃的霸意，金色双眸牢牢摄住$n。\n"NOR,me,target); 
         message_vision(HIY"一股凛冽逼人的霸气充斥周遭空间，$N"+HIY"缓缓握紧右拳，金色光芒闪耀不已。\n"NOR,me,target); 
         message_vision(HIY"“霸意·昇龍拳”，$N"+HIY"一声怒喝，俯身上跃，右拳划出一道弧线直击$n。\n\n"NOR,me,target); 
 
         if(fly)  
           message_vision(HIR"$n尚在空中翻滚的身体立刻被这惊天骇地的一招打得似巨滔中的小舟，哪里定得住身形！\n"NOR,me,target); 
 
         if( random(me->query("combat_exp")/8000 * me->query_int())  
                > random((int)target->query("combat_exp")/25000 * target->query_int())){ 
 
            message_vision(HIR"只见一条"+dcol+HIR"拔地而起，张牙舞爪直冲而上，$n一个闪避不及，被撞个正着！\n"NOR,me,target); 
    
            if (!random(3)&&!tui&&!fly) {message_vision(HIW"\n$n乍不及防，硬被此招击上了半空。\n"NOR,me,target); 
                                         target->set_temp("sfighter/fly",1); 
                                         call_out("remove_effect2",2,target);} 
             
          }else{  
               message_vision(HIG"$n早有防备，往后轻轻一跃，闪了开去。\n"NOR,me,target);         
               damage=0;} 
                
      } 
 
//**************************** mie 
 
      if (me->query_temp("yi")&&me->query_skill("ghost-spirit",1)>299&&me->query_skill("ghost-spirit",1)<600){ 
 
         message_vision(HIB"\n$n突然不住的颤抖，一股无边的恐惧由然而生。\n"NOR,me,target); 
         message_vision(HIB"只见$N"+HIB"全身不住散发出奇异的气息，气息之中毫无任何生机，惟有的只是破坏，无边无际的---破坏！\n"NOR,me,target); 
         message_vision(HIB"“滅の昇龍”，$N"+HIB"一声怒喝，右拳挟着无匹的劲力猛冲而上。\n\n"NOR,me,target); 
 
         if(fly)  
           message_vision(HIR"无边的破坏气息扑面而来，$n身在半空哪里躲得开，只听一声惨叫，$n在空中翻腾数周，波的喷出一口鲜血。\n"NOR,me,target); 
 

         if( random(me->query("combat_exp")/8000 * me->query_int())  
                > random((int)target->query("combat_exp")/25000 * target->query_int())){ 
 
            message_vision(HIR"无尽的破坏气息迎面而来，$n硬生生挨了这一下，只觉体内真气乱串，难以控制，好似要将身体撕裂一般！不禁发出一声恐怖的惨嚎！\n"NOR,me,target); 
    
            if (!random(3)&&!tui&&!fly) {message_vision(HIW"\n$n乍不及防，硬被此招击上了半空。\n"NOR,me,target); 
                                         target->set_temp("sfighter/fly",1); 
                                         call_out("remove_effect2",2,target);} 
             
          }else{  
               message_vision(HIG"$n早有防备，往后轻轻一跃，闪了开去。\n"NOR,me,target);         
               damage=0;} 
                
      } 
 
//**************************** tian 

      if (me->query_temp("yi")&&me->query_skill("ghost-spirit",1)>599&&me->query_skill("ghost-spirit",1)<900){ 
 
         message_vision(HIC"\n周遭空间突然弥漫着一股奇异的劲气，$n心中不住抖颤，一种只有对天才有的肃穆崇敬之意油然而生。\n"NOR,me,target); 
         message_vision(HIC"“天の昇龍”，$N"+HIC"狂吼一声，拳风带雷霆之音直扑$n，拳风在空气中擦出霹雳的火光，仿若一条"+dcol+"卷向$n！\n"NOR,me,target); 
 
         if(fly)  
           message_vision(dcol+HIR"由下而至，$n身在半空哪里躲得开，只听一声惨叫，$n在空中翻腾数周，波的喷出一口鲜血。\n"NOR,me,target); 
 
 
         if( random(me->query("combat_exp")/8000 * me->query_int())  
                > random((int)target->query("combat_exp")/25000 * target->query_int())){ 
 
            message_vision(HIR"天，睥睨天下的压倒性气息破空而来，$n硬生生挨了这一下，只觉体内真气乱串，难以控制，好似要将身体撕裂一般！不禁发出一声恐怖的惨嚎！\n"NOR,me,target); 
    
            if (!random(3)&&!tui&&!fly) {message_vision(HIW"\n$n乍不及防，硬被此招击上了半空。\n"NOR,me,target); 
                                         target->set_temp("sfighter/fly",1); 
                                         call_out("remove_effect2",2,target);} 
             
          }else{  
               message_vision(HIG"$n早有防备，往后轻轻一跃，闪了开去。\n"NOR,me,target);         
               damage=0;} 
                
      } 
 
//**************************** wu 
 
      if (me->query_temp("yi")&&me->query_skill("ghost-spirit",1)>899){ 
 
         message_vision(BLU"\n$n突然感觉不到$N"+BLU"的存在气息，定睛细看，$N"+BLU"却犹在原处，一股难以名状的怪异刹时充斥于$n的心际。\n"NOR,me,target); 
         message_vision(BLU"$N"+BLU"默立不动，突然空间一阵晃动，$N倏地出现在$n面前。\n"NOR,me,target); 
         message_vision(BLU"“無の昇龍”，$N俯身蓄力，将全身力量聚在右拳之上，自下而上划出一个刁滑的的角度，带着冲天的劲道直击而上。\n\n"NOR,me,target); 
 
         if(fly)  
           message_vision(HIR"一股无形的压力至下而来，$n身在半空哪里躲得开，只听一声惨叫，$n在空中翻腾数周，波的喷出一口鲜血。\n"NOR,me,target); 
 
         if( random(me->query("combat_exp")/8000 * me->query_int())  
                > random((int)target->query("combat_exp")/25000 * target->query_int())){ 
 
            message_vision(HIR"无形的气劲冲天而起，$n闪避不及，硬生生挨了这一下，只觉体内真气乱串，难以控制，好似要将身体撕裂一般！不禁发出一声恐怖的惨嚎！\n"NOR,me,target); 
    
           if (!random(3)&&!tui&&!fly) {message_vision(HIW"\n$n乍不及防，硬被此招击上了半空。\n"NOR,me,target); 
                                         target->set_temp("sfighter/fly",1); 
                                         call_out("remove_effect2",2,target);} 
             
          }else{  
               message_vision(HIG"$n早有防备，往后轻轻一跃，闪了开去。\n"NOR,me,target);         
               damage=0;} 
                
      } 

//**************************** true 

      if (!me->query_temp("yi")&&me->query_skill("yuanwu-xinfa",1)>=200){ 
 
         message_vision(HIY"\n$N$N俯身蓄力，将全身力量聚在右拳之上。\n"NOR,me,target); 
         message_vision(HIY"突然之间，$N仿佛与天地万物融为一体，天地元气齐往$N右拳之上汇聚。\n"NOR,me,target); 
         message_vision(HIY"“真·昇龍拳”，随着一声轻喝，一条前所未有的巨龙冲天而起。\n\n"NOR,me,target); 
 
         if(fly)  
           message_vision(HIR"$n身在半空哪里躲得开，只听一声惨叫，$n在空中翻腾数周，波的喷出一口鲜血。\n"NOR,me,target); 
 
         if( random(me->query("combat_exp")/8000 * me->query_int())  
                > random((int)target->query("combat_exp")/25000 * target->query_int())){ 
 
            message_vision(HIR"巨龙张牙舞爪由下而至，$n闪避不及，硬生生挨了这一下，只觉体内真气乱串，难以控制，好似要将身体撕裂一般！\n"NOR,me,target); 
    
            if (!random(3)&&!tui&&!fly) {message_vision(HIW"\n$n乍不及防，硬被此招击上了半空。\n"NOR,me,target); 
                                         target->set_temp("sfighter/fly",1); 
                                         call_out("remove_effect2",2,target);} 
             
          }else{  
               message_vision(HIG"$n早有防备，往后轻轻一跃，闪了开去。\n"NOR,me,target);         
               damage=0;} 
                
      } 
 
//**************************** over 

//ReWriteBySnowtu 
        if(me->query("force_factor")<1)  
                { 
                damage=damage/3; 
                me->set_temp("sl_busy",time());
                } 
        else if(me->query("force_factor")<=me->query_skill("force")/4)  
                { 
                damage=damage*2/3;
                if (!target->is_busy())  
                        target->start_busy(1+random(3)); 
                if(me->query_skill("ghost-spirit",1) < 600 ) 
                        me->start_busy(1+random(3)); 
                else { if( ((int)me->query_temp("sl_count")%3)== 0 ) me->set_temp("sl_busy",time()+2+random(3)); } 
                } 
        else if(me->query("force_factor")<=me->query_skill("force")/2)  
                {
                damage=damage;
                if (!target->is_busy()) 
                        target->start_busy(2+random(2)); 
                if(me->query_skill("ghost-spirit",1) < 600 ) 
                        me->start_busy(2+random(2)); 
                else { if( ((int)me->query_temp("sl_count")%3)== 0 ) me->set_temp("sl_busy",time()+2+random(4)); } 
                }
        else    {
                damage=damage;
                if(me->query_skill("ghost-spirit",1) < 400 ) 
                me->start_busy(2+random(2));
                else { if( ((int)me->query_temp("sl_count")%3)== 0 ) me->set_temp("sl_busy",time()+2+random(4)); } 
                }
 
           if(damage>0){ 
              target->receive_damage("kee", damage, me); 
              target->receive_damage("sen", damage, me); 
              COMBAT_D->report_status(target);
              COMBAT_D->report_sen_status(target);} 
           
          me->add("force",-200-me->query("force_factor")); 
          me->add_temp("sl_count",1); 
 
return 1; 
} 
 
void remove_effect2(object target)  
{ 
if( !objectp(target) ) return; 
  target->delete_temp("sfighter/fly"); 
  target->delete_temp("sfighter/tui"); 
  return; 
} 

void check_yi(object me) 
{ 
   int skill,skill2; 
      if( !objectp(me) ) return;
      skill=me->query_temp("sfighter/skill"); 
      skill2=me->query_temp("sfighter/skill2"); 
 
      if(!objectp(me)||!me->query_temp("yi")) return; 
       message_vision(HIY"$N意识混乱，身体亦变得异变了。\n"NOR,me);       
       
           if( me->query("max_sen") > (skill+skill2)/2) {  
           me->add("sen",-(skill+skill2)/2);  
           me->add("eff_sen",-(skill+skill2)/2);  
           me->add("max_sen",-(skill+skill2)/2);  
           }  
           else { me->set("sen",1);me->set("eff_sen",1);me->set("max_sen",1);} 

      call_out("check_yi",5,me); 
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("yuanwu-kungfu")+" 100 级\n";
temp+= "\t\t内力修为五年\n";
temp+= "\t\t内力２００点\n";
temp+= "\t\t精神２００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                强力打击对手的气血和精神前值
        出招类型：   
                busy或延时型外功  
                有隐藏效果  
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
} 
