
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name()  
{
return "「"HIG"龙卷旋风腿"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "格斗家" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if( (int)me->query_skill("yuanwu-kungfu",1) < 100 )
        return notify_fail("你的元武门绝学还不够娴熟，不会使用"+name()+"。\n");
if( (int)me->query_skill("unarmed",1) < 100 )
        return notify_fail("你的扑击格斗之技还不够娴熟，不会使用"+name()+"。\n");
if((int)me->query("max_force") < 500 )
        return notify_fail("你的内力太弱，不足以使用"+name()+"。\n");
if((int)me->query("force") < 200 )
        return notify_fail("你的内力不足！\n");
if (  me->query_temp("xf_busy")+3+random(3) > time() )
        return notify_fail("绝招用多就不灵了。\n");
if((int)me->query("sen") < 200 )
        return notify_fail("你的精神不足，没法子施用外功！\n");
return 1;
}

int perform(object me, object target)
{
int i,damage,num;
string dcol,powercol;

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
        
i=(int)me->query_skill("unarmed");
num=i/100;
if(num>10) num=10;

// a big bug fang@2013
//me->add_temp("apply/damage",i/6); 
me->add_temp("apply/damage",(int)me->query_skill("unarmed")/6);
message_vision(HIC"-------------------------龙卷旋风腿-------------------------------\n\n"NOR,me,target);
message_vision(HIW"\n$N将内劲灌注于双腿，整个人盘旋升起，形成一巨大龙卷旋风。\n\n"NOR,me,target);
message_vision(HIW"\n旋风呼啸而来，往$n刮去。\n"NOR,me,target);
for (i=0;i<num;i++)
        {
        COMBAT_D->do_attack(me,target, TYPE_REGULAR);
        }
//me->add_temp("apply/damage",-i/6); 
me->add_temp("apply/damage",-(int)me->query_skill("unarmed")/6);
if( me->query_skill("ghost-spirit",1) < 600 )
me->start_busy(2+random(2));
else   me->set_temp("xf_busy",time());
return 1;
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("yuanwu-kungfu")+" 100 级\n";
temp+= "\t\t"+to_chinese("unarmed")+" 100 级\n";
temp+= "\t\t内力修为五年\n";
temp+= "\t\t内力２００点\n";
temp+= "\t\t精神２００点\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                连续打击对手的气血
        出招类型：   
                busy型外功  
                有隐藏效果  
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
