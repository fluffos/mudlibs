#include <ansi.h>

inherit SSERVER;

string dcol(int level)
{
        if ( level == 1 )
                return HIC "波状气劲" NOR;
        else if ( level == 2)
                return HIC "波状气劲" NOR;
        else if ( level == 3)
                return HIC "波状气劲" NOR;
        else if ( level == 4)
                return HIW "白色气波 " NOR;
        else if ( level == 5)
                return HIY "黄色气波" NOR;
        else if ( level == 6)
                return HIG "绿色气波" NOR;
        else if ( level == 7)
                return HIR "红色气波" NOR;
        else if ( level == 8)
                return HIB "蓝色气波" NOR;
        else if ( level == 9)
                return HIM "紫色气波" NOR;
        else 
                return BLK "黑色气波" NOR;
}

string powercol(int level)
{
        if ( level == 1 )
                return HIC "X 级力量" NOR;
        else if ( level == 2)
                return HIC "Z 级力量" NOR;
        else if ( level == 3)
                return HIC "V 级力量" NOR;
        else if ( level == 4)
                return HIW "白 鬭 气" NOR;
        else if ( level == 5)
                return HIY "黄 鬭 气" NOR;
        else if ( level == 6)
                return HIG "绿 鬭 气" NOR;
        else if ( level == 7)
                return HIR "红 鬭 气" NOR;
        else if ( level == 8)
                return HIB "蓝 鬭 气" NOR;
        else if ( level == 9)
                return HIM "紫 鬭 气" NOR;
        else 
                return BLK "黑 鬭 气" NOR;
}


string name()  
{
return "「"HIW"波动拳"NOR"」";
}
int valid_perform(object me)
{
if(me->query("family/family_name") != "格斗家" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n");

if((int)me->query_skill("yuanwu-kungfu", 1) < 100) 
        return notify_fail("你的元武门绝学修为太浅，难以施展"+name()+"！\n"); 
        if((int)me->query("max_force") < 500 )
        return notify_fail("你的内力修为太浅！\n");
        if((int)me->query("force") < 200 )
                return notify_fail("你的内力不足！\n");

        if((int)me->query("sen") < 200 )
                return notify_fail("你的精神不足，没法子施用外功！\n");

if(time()-me->query_temp("bd_busy") < 2)
        return notify_fail("绝招用多了就不灵了！\n");

return 1;
}

int perform(object me, object target)
{
        int i,damage,tui,fly,skill,skill2;
        string dcol,powercol;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

        i=(int)me->query_skill("unarmed");


        if((!me->query("sfighter/sha")&&!me->query("sfighter/ba"))||(me->query("bd_count")>999 && !me->query_temp("yi")) ){

            message_vision("\n波動拳起手式刚起，$N突起异变,蓄满的劲力顿失，全身不住颤抖。\n",me);
            message_vision(HIR"$N"HIR"皮肤突然变成赤红，双目亦红得快流出血来，一股强烈的杀意从$N"HIR"散发出来，不住往四周空间迸射！\n"NOR,me);

            skill=me->query_skill("yuanwu-kungfu",1);
            skill2=me->query_skill("ghost-spirit",1);
            me->set_temp("sfighter/skill",skill);
            me->set_temp("sfighter/skill2",skill2);
//            me->set("old_name",me->query("name"))
//            me->set("name",HIR"殺意·"+me->query("name")+""NOR);
            me->set("sfighter/sha",1);
            me->set_temp("shayi",1);
            me->set_temp("yi",1);
            me->set_temp("max_sen",me->query("max_sen"));
            me->add_temp("apply/damage",(skill+skill2)/3);
            me->add_temp("apply/armor",(skill+skill2)/2);
            me->add_temp("apply/dodge",(skill+skill2)/3);
            me->add_temp("apply/parry",(skill+skill2)/3);
            me->add_temp("apply/unarmed",(skill+skill2)/3);
            call_out("check_yi",5,me);
            return 1;
          }

               
        dcol=dcol(me->query_skill("power", 1)/100+1);
        powercol=powercol(me->query_skill("power", 1)/100+1);

        i=(int)me->query_skill("unarmed");
	 i+=(int)me->query_skill("yuanwu-kungfu");
	 i=i*3/2;
        damage=i+me->query("force_factor")+me->query("apply/damage")+me->query_skill("literate");

        if(tui=target->query_temp("sfighter/tui")) damage=damage*2;
        if(fly=target->query_temp("sfighter/fly")) damage=damage*2;
        if (me->query_temp("shayi")) damage=damage*6/5;
        if (me->query_temp("yi")&&me->query_skill("ghost-spirit",1)>199&&me->query_skill("ghost-spirit",1)<400) damage=damage*8/5;
        if (me->query_temp("yi")&&me->query_skill("ghost-spirit",1)>399&&me->query_skill("ghost-spirit",1)<600) damage=damage*9/5;
        if (me->query_temp("yi")&&me->query_skill("ghost-spirit",1)>599) damage=damage*2;
        if (!me->query_temp("yi")&&me->query_skill("yuanwu-xinfa",1)>200&&!me->query("ghost-spirit")) damage=damage*4;

//**************************** normal

      if (!me->query_temp("yi")||me->query_temp("bayi")){
         message_vision(HIC"\n$N"HIC"扎定腰马，双手抱圆，致于腰间，将体内"+powercol+HIC"聚集于掌心之间形成一个"+dcol+HIC"。\n"NOR,me,target);
         message_vision(HIC"只见$N"HIC"掌心间的"+dcol+HIC"越来越大，气劲不住往四周激荡。\n"NOR,me,target);
         message_vision(HIC"“波動拳”，$N"HIC"一声大喝，将"+dcol+HIC"猛的推出。\n\n"NOR,me,target);

         if(fly) 
           message_vision(dcol+HIR"以惊人的速度破空而至，$n"HIR"身在半空哪里躲得开此招，只听一声惨叫，$n"HIR"在空中翻腾数周，波的喷出一口鲜血。\n"NOR,me,target);

         if(tui)
           message_vision(HIR"$n"HIR"尚未站稳脚步,"+dcol+HIR"已破空而至,$n"HIR"硬打了正着，一声闷哼，胸间气血不住翻腾！\n"NOR,me,target);

         if( random(me->query("combat_exp") * me->query_int() / 80) 
                > random((int)target->query("combat_exp") * target->query_int() / 250 )){

            message_vision(dcol+HIR"以惊人的速度破空而至，$n"HIR"闪避不及，照单全收。\n"NOR,me,target);
   
            if (!random(3)&&!tui&&!fly) {message_vision(HIW"\n$n"HIR"硬被此招击退数步，顿失平衡。\n"NOR,me,target);
                                         target->set_temp("sfighter/tui",1);
                                         call_out("remove_effect2",2,target);}
            
          }else{ 
               message_vision(HIG"$n"HIG"见此怪招，心中暗暗警惕，连忙纵身闪过！\n"NOR,me,target);	
               damage=0;}
               
      }

//**************************** shayi

      if (me->query_temp("shayi")){
         message_vision(HIR"\n$N"+HIR"再也控制不住体内的杀气，血红的双眼紧紧盯住$n"HIR"。\n"NOR,me,target);
         message_vision(HIR"一股血红的气波在$N"HIR"掌心逐渐成形，无比凄厉的萧杀之气登时充斥周遭空间。\n"NOR,me,target);
         message_vision(HIR"“殺意·波動拳”，"+HIR"$N"HIR"一声怒喝，将巨大的血红气波猛得推出。\n\n"NOR,me,target);

         if(fly) 
           message_vision(HIR"从炼狱诞生的索魂之气破空而来，$n"HIR"身在半空哪里躲得开此招，只听一声惨叫，$n"HIR"在空中翻腾数周，波的喷出一口鲜血。\n"NOR,me,target);

         if(tui)
           message_vision(HIR"$n"HIR"尚未站稳脚步,无边的杀气经已破空而至,$n"HIR"硬打了正着，一声闷哼，胸间气血不住翻腾！\n"NOR,me,target);

         if( random(me->query("combat_exp") * me->query_int() / 80) 
                > random((int)target->query("combat_exp") * target->query_int() / 250 )){

            message_vision(HIR"气波挟着无尽的杀气由远即近，$n"HIR"硬生生挨了这一下，只觉体内真气乱串，难以控制，好似要将身体撕裂一般！不禁发
出一声恐怖的惨嚎！\n"NOR,me,target);
   
            if (!random(3)&&!tui&&!fly) {message_vision(HIW"\n$n"HIW"硬被此招击退数步，顿失平衡。\n"NOR,me,target);
                                         target->set_temp("sfighter/tui",1);
                                         call_out("remove_effect2",2,target);}
            
          }else{ 
               message_vision(HIG"$n"HIG"见此怪招，心中暗暗警惕，连忙纵身闪过！\n"NOR,me,target);	
               damage=0;}
               
      }

//**************************** mie

      if (me->query_temp("yi")&&me->query_skill("ghost-spirit",1)>199&&me->query_skill("ghost-spirit",1)<400){

         message_vision(HIB"\n$n"HIR"突然不住的颤抖，一股无边的恐惧由然而生。\n"NOR,me,target);
         message_vision(HIB"只见$N"HIB"全身不住散发出奇异的气息，气息之中毫无任何生机，惟有的只是破坏，无边无际的---破坏！\n"NOR,me,target);
         message_vision(HIB"“滅の波動”，$N"+HIB"一声怒喝，一个巨大的气波挟着毁天灭地之势破空而出。\n\n"NOR,me,target);

         if(fly) 
           message_vision(HIR"无边的破坏气息扑面而来，$n"HIR"身在半空哪里躲得开，只听一声惨叫，$n"HIR"在空中翻腾数周，波的喷出一口鲜血。\n"NOR,me,target);

         if(tui)
           message_vision(HIR"$n"HIR"尚未站稳脚步,气波经已即身,$n"HIR"硬打了正着，一声闷哼，胸间气血不住翻腾！\n"NOR,me,target);

         if( random(me->query("combat_exp") * me->query_int() / 80) 
                > random((int)target->query("combat_exp") * target->query_int() / 250 )){

            message_vision(HIR"无尽的破坏气息扑天盖地而来，$n"HIR"硬生生挨了这一下，只觉体内真气乱串，难以控制，好似要将身体撕裂一般！不禁发
出一声恐怖的惨嚎！\n"NOR,me,target);
   
            if (!random(3)&&!tui&&!fly) {message_vision(HIW"\n$n"HIW"硬被此招击退数步，顿失平衡。\n"NOR,me,target);
                                         target->set_temp("sfighter/tui",1);
                                         call_out("remove_effect2",2,target);}
            
          }else{ 
               message_vision(HIG"$n"HIG"见此怪招，心中暗暗警惕，连忙纵身闪过！\n"NOR,me,target);	
               damage=0;}
               
      }

//**************************** tian

      if (me->query_temp("yi")&&me->query_skill("ghost-spirit",1)>399&&me->query_skill("ghost-spirit",1)<600){

         message_vision(HIC"\n周遭空间突然弥漫着一股奇异的劲气，$n"HIC"心中不住抖颤，一种只有对天才有的肃穆崇敬之意油然而生。\n"NOR,me,target);
         message_vision(HIC"$N"HIC"扎定腰马，双手抱圆，致于腰间，气劲不住汇聚于掌心之间！\n"NOR,me,target);
         message_vision(HIC"“天の波動”，$N"HIC"缓缓喝出这并不平淡的话，一颗巨大的气波由掌间迸射而出。\n\n"NOR,me,target);

         if(fly) 
           message_vision(HIR"气波迎面而至，$n"HIR"身在半空哪里躲得开，只听一声惨叫，$n"HIR"在空中翻腾数周，波的喷出一口鲜血。\n"NOR,me,target);

         if(tui)
           message_vision(HIR"$n尚未站稳脚步,气波经已即身,$n"HIR"硬打了正着，一声闷哼，胸间气血不住翻腾！\n"NOR,me,target);

         if( random(me->query("combat_exp") * me->query_int() / 80) 
                > random((int)target->query("combat_exp") * target->query_int() / 250 )){

            message_vision(HIR"天，睥睨天下的压倒性气息破空而来，$n"HIR"硬生生挨了这一下，只觉体内真气乱串，难以控制，好似要将身体撕裂一般！不禁发
出一声恐怖的惨嚎！\n"NOR,me,target);
   
            if (!random(3)&&!tui&&!fly) {message_vision(HIW"\n$n"HIW"硬被此招击退数步，顿失平衡。\n"NOR,me,target);
                                         target->set_temp("sfighter/tui",1);
                                         call_out("remove_effect2",2,target);}
            
          }else{ 
               message_vision(HIG"$n"HIG"见此怪招，心中暗暗警惕，连忙纵身闪过！\n"NOR,me,target);	
               damage=0;}
               
      }

//**************************** wu

      if (me->query_temp("yi")&&me->query_skill("ghost-spirit",1)>600){

         message_vision(BLU"\n$n"BLU"突然感觉不到$N"BLU"的存在气息，定睛细看，$N"BLU"却犹在原处，一股难以名状的怪异刹时充斥于$n"BLU"的心际。\n"NOR,me,target);
         message_vision(BLU"$N"BLU"默立不动，周身的气劲却不住汇聚。\n"NOR,me,target);
         message_vision(BLU"“無の波動”，$N"BLU"扎定腰马，将一无形气波缓缓推出，登时气劲破空之声不绝于耳。\n\n"NOR,me,target);

         if(fly) 
           message_vision(HIR"一股无形的压力袭面而来，$n"HIR"身在半空哪里躲得开，只听一声惨叫，$n"HIR"在空中翻腾数周，波的喷出一口鲜血。\n"NOR,me,target);

         if(tui)
           message_vision(HIR"$n"HIR"尚未站稳脚步,劲气经已即身,$n"HIR"硬打了正着，一声闷哼，胸间气血不住翻腾！\n"NOR,me,target);

         if( random(me->query("combat_exp") * me->query_int() / 80) 
                > random((int)target->query("combat_exp") * target->query_int() / 250 )){

            message_vision(HIR"无形的气劲正面袭至，$n"HIR"无法闪避，硬生生挨了这一下，只觉体内真气乱串，难以控制，好似要将身体撕裂一般！不禁发
出一声恐怖的惨嚎！\n"NOR,me,target);
   
            if (!random(3)&&!tui&&!fly) {message_vision(HIW"\n$n"HIW"硬被此招击退数步，顿失平衡。\n"NOR,me,target);
                                         target->set_temp("sfighter/tui",1);
                                         call_out("remove_effect2",2,target);}
            
          }else{ 
               message_vision(HIG"$n"HIG"见此怪招，心中暗暗警惕，连忙纵身闪过！\n"NOR,me,target);	
               damage=0;}
               
      }

//**************************** true

      if (!me->query_temp("yi")&&me->query_skill("yuanwu-xinfa",1)>200&&!me->query("ghost-spirit") ){

         message_vision(HIY"\n$N"HIY"扎定腰马，双手抱圆，致于腰间，将体内"+powercol+HIY"聚集于掌心之间形成一个"+dcol+HIY"\n"NOR,me,target);
         message_vision(HIY"突然之间，$N"HIY"仿佛与天地万物融为一体，天地元气逐渐汇聚于$N"HIY"掌间。\n"NOR,me,target);
         message_vision(HIY"“真·波動拳”，随着一声轻喝，集天地元气所成的巨大"+dcol+HIY"挟着无匹的威势破空而出。\n\n"NOR,me,target);
		
         if(fly) 
           message_vision(HIR"$n"HIR"身在半空哪里躲得开，只听一声惨叫，$n"HIR"在空中翻腾数周，波的喷出一口鲜血。\n"NOR,me,target);

         if(tui)
           message_vision(HIR"$n"HIR"尚未站稳脚步,气波经已即身,$n"HIR"硬打了正着，一声闷哼，胸间气血不住翻腾！\n"NOR,me,target);

         if( random(me->query("combat_exp") * me->query_int() / 80) 
                > random((int)target->query("combat_exp") * target->query_int() / 250 )){

            message_vision(HIR"气波迎面而至，$n"HIR"闪避不及，硬生生挨了这一下，只觉体内真气乱串，难以控制，好似要将身体撕裂一般！不禁发
出一声恐怖的惨嚎！\n"NOR,me,target);
   
            if (!random(3)&&!tui&&!fly) {message_vision(HIW"\n$n"HIW"硬被此招击退数步，顿失平衡。\n"NOR,me,target);
                                         target->set_temp("sfighter/tui",1);
                                         call_out("remove_effect2",2,target);}
            
          }else{ 
               message_vision(HIG"$n"HIG"见此怪招，心中暗暗警惕，连忙纵身闪过！\n"NOR,me,target);	
               damage=0;}
               
      }

//**************************** over
//ReWriteBy snowtu@xmxyj200/2003/10
	if(me->query("force_factor")<1) 
	{
        damage=damage/4;
        me->set_temp("bd_busy",time()+random(2));
	target->start_busy(1+random(3));
	}
	else if(me->query("force_factor")<=me->query_skill("force")/4) 
	{
        damage=damage/2;
        target->start_busy(1+random(3));
         if(me->query_skill("ghost-spirit",1) < 600 )
        me->start_busy(1+random(3));
        me->set_temp("bd_busy",time()+random(3));
	}
	else if(me->query("force_factor")<=me->query_skill("force")/2) 
	{
        target->start_busy(2+random(2));
         if(me->query_skill("ghost-spirit",1) < 600 )
        me->start_busy(2+random(2));
        me->set_temp("bd_busy",time()+random(4));
        damage=damage*3/4;
	}
        else  {
        me->start_busy(2+random(2));
        me->set_temp("bd_busy",time()+random(4));
        }
           if(damage>0){
              target->receive_damage("kee", damage, me);
              target->receive_wound("kee", damage, me);
              COMBAT_D->report_status(target);}
          
          me->add("force",-200-me->query("force_factor"));
          me->add("bd_count",1);

return 1;
}
void remove_effect2(object target) 
{
  target->delete_temp("sfighter/fly");
  target->delete_temp("sfighter/tui");
  return;
}

void check_yi(object me)
{
   int skill,skill2;
      skill=me->query_temp("sfighter/skill");
      skill2=me->query_temp("sfighter/skill2");

      if(!me->query_temp("yi")) return;
      
      if( me->query("max_sen") > (skill+skill2)/2) {
      me->add("sen",-(skill+skill2)/2);
      me->add("eff_sen",-(skill+skill2)/2);
      me->add("max_sen",-(skill+skill2)/2);
      }
      else { me->set("sen",1);me->set("eff_sen",1);me->set("max_sen",1);}

      call_out("check_yi",5,me);
}



int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("yuanwu-kungfu")+" 100 级\n";  
temp+= "\t\t内力修为五年\n"; 
temp+= "\t\t内力２００点\n"; 
temp+= "\t\t精神２００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                伤害对手气血
        出招类型：   
                busy型外功，但如果适当加力且阿修羅戰道大于一定级别则成为延时型外功
                有隐藏效果  
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
