
//双发刭 shuang.c
//相关连接：虎裂倒 百裂腿 龙星落 霸山天升脚

#include <ansi.h>
inherit SSERVER;

#include "bianzhao.h"

string name()  
{
return "「"HIG"双发刭"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "格斗家" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 

if ( me->query("ghost-spirit") && me->query_skill("ghost-spirit")<1500 )  //入魔不可
        return notify_fail("以你充满仇恨的心，怎么使得出"+name()+"。\n");

if( (int)me->query_skill("feiyan-cu",1) < 350 )
        return notify_fail("你的飞燕蹴还不够娴熟，不会使用"+name()+"。\n");

if( (int)me->query_skill("unarmed",1) < 350 )
        return notify_fail("你的扑击格斗之技还不够娴熟，不会使用"+name()+"。\n");
        
if( (int)me->query_skill("dodge",1) < 350 )
        return notify_fail("你的身法还不够娴熟，不会使用"+name()+"。\n");

if(me->query_skill("force") <350)
        return notify_fail("你的内功修为不足以使用"+name()+"。\n");

if (me->query_skill_mapped("dodge") != "yuanwu-steps")
        return notify_fail("你现在无法使用"+name()+"。\n");                                                                                         
if (me->query_temp("sh_busy")+2 > time())
        return notify_fail("你刚使用过"+name()+"，体力尚未恢复。\n");                                                                                 
if( (int)me->query("max_force") < 1000 )
        return notify_fail("你的内力太弱，不足以使用"+name()+"。\n");

if( (int)me->query("force") < 800 )
        return notify_fail("你的真气不够！\n");

if ( me->query("gender")!="女性" && me->query_skill("yuanwu-xinfa", 1)<2000)
        return notify_fail("以你笨拙的男儿身怎使得出飞燕蹴的精髓！\n");

if ( me->query_temp("chunli/xuanyuan")>=3 )
        return notify_fail("绝招用多就不灵！\n");

return 1;
}

int perform(object me, object target)
{       
string msg,hit;
int ap,dp,damage,time;

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n"); 

damage = me->query_skill("unarmed");
damage+= me->query_skill("yuanwu-xinfa",1);
damage+= me->query("force_factor");

me->start_call_out( (: call_other, __FILE__, "remove_effect",me :),2+random(2));

if ( !me->query_temp("chunli/xuanyuan") )
        {
        if ( me->query_temp("chunli/hejiao")==2 )
                {
                if ( me->query_temp("chunli/qianlie") )
                        {
                        tell_object(me,"你正使用千裂腿中。\n"NOR);
                        return 1;
                        }
                //call_out("qianlie",0,me,target,damage);
                me->start_call_out( (: call_other, __FILE__, "qianlie",me,target,damage:));
                }
        else if ( me->query_temp("chunli/qingting")==2 )
                {
                if ( me->query_temp("chunli/longxing") )
                        {
                        tell_object(me,RED"你正使用龙星落中。\n"NOR);
                        return 1;
                        }
                //call_out("longxing",0,me,target,damage);
                me->start_call_out( (: call_other, __FILE__, "longxing",me,target,damage :));
                }
        else    
                {
                me->add("force", -150);
                msg = HIG"\n$N"HIG"一声娇叱，单足点地，身体横飞，双腿交叉直剪$n"HIG"！\n"NOR,
                message_vision(msg,me,target);

                ap = me->query("combat_exp")/10000+1;
                dp = target->query("combat_exp")/10000+1;
                if ( ap > random(dp/3) )
                        {
                        msg = HIG"$n"HIG"闪避不及，$1被夹了正着！\n"NOR;
                                hit=hits[random(sizeof(hits))];
                        msg=replace_string(msg,"$1",hit);
                        message_vision(msg,me,target);
                        damage = damage/2+random(damage*3/2);
                        target->receive_damage("kee", damage, me);
                        COMBAT_D->report_status(target);
                        }
                else    {
                        msg+=HIG"$n"HIG"知道这招厉害，堪堪闪在一旁。\n"NOR;
                        message_vision(msg,me,target);
                        }
                msg = RED"\n$n正心怀侥幸，不想$N双腿再度在空中一个交叉，又是一击剪刀腿！\n"NOR;
                message_vision(msg,me,target);
                if ( ap > random(dp/3) )
                        {
                        msg = RED"\n$n"RED"哪里知晓有此变招，$1挨了一下，立刻口吐鲜血向后倒飞！\n"NOR;
                        msg=replace_string(msg,"$1",hit);
                        message_vision(msg,me,target);
                        damage = damage+random(damage*3/2);
                        target->receive_damage("kee", damage, me);
                        target->receive_wound("kee", damage, me);
                        COMBAT_D->report_status(target,damage);
                        }
                else    {
                        damage = random(damage*2);
                        msg+=HIR"$n"HIR"实在避无可避，只得强运一口气，硬挨了这一腿。\n"NOR;
                        message_vision(msg,me,target);
                        target->receive_damage("kee", damage, me);
                        target->receive_wound("kee", damage/2, me);
                        COMBAT_D->report_status(target);
                        }
                }
        }

else if ( me->query_temp("chunli/xuanyuan")==2 )
        {
        if ( me->query_temp("chunli/bailie") )
                {
                tell_object(me,RED"你正使用百裂腿中。\n"NOR);
                return 1;
                }
        //call_out("bailie",0,me,target,damage);
        me->start_call_out( (: call_other, __FILE__, "bailie",me,target,damage :));
        }

else if ( me->query_temp("chunli/xuanyuan")==1 )
        {
        if ( me->query_temp("chunli/huxi") )
                {
                tell_object(me,RED"你正使用虎袭倒中。\n"NOR);
                return 1;
                }
        //call_out("huxi",0,me,target,damage);
        me->start_call_out( (: call_other, __FILE__, "huxi",me,target,damage :));
        }       

me->add_temp("chunli/xuanyuan",1);
me->add_temp("sh_count",1);
if( ((int)me->query_temp("sh_count")%4)== 0 ) me->set_temp("sh_busy",time()+random(3)); //防止#n

return 1;
}
 
void remove_effect(object me)
{
if ( me->query_temp("chunli/xuanyuan")>1 )
        me->add_temp("chunli/xuanyuan",-1);
else    me->delete_temp("chunli/xuanyuan");
return;
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("feiyan-cu")+" 350 级\n";
temp+= "\t\t"+to_chinese("unarmed")+" 350 级\n";
temp+= "\t\t"+to_chinese("dodge")+" 350 级\n";
temp+= "\t\t"+to_chinese("force")+" 350 级\n";
temp+= "\t\t不可入魔\n";
temp+= "\t\t必须激发轻功为元武门身法\n";
temp+= "\t\t内力修为十年\n";
temp+= "\t\t内力８００点\n";
temp+= "\t\t元武门心法低于2000级时必须女性才能使用\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                重创对手的气血或精神
        出招类型：   
                busy或延时型外功  
                有隐藏效果  
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
