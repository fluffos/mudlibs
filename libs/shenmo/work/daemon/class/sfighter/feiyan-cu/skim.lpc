//蜻蜓点水 skim.c
//相关连接：风翼扇  天升脚  千裂脚  霸天天升脚

#include <ansi.h>
inherit SSERVER;
#include "bianzhao.h"

string name() {
  return "「" WHT "蜻蜓点水" NOR "」";
}

int valid_perform(object me) {
  if (me->query("family/family_name") != "格斗家" || me->query("class") != "saint")
    return notify_fail("你不够资格使用" + name() + "！\n");

  if (me->query("ghost-spirit") && me->query_skill("ghost-spirit") < 1500)  //入魔不可
    return notify_fail("以你充满仇恨的心，怎么使得出" + name() + "。\n");

  if ((int)me->query_skill("feiyan-cu", 1) < 150)
    return notify_fail("你的飞燕蹴还不够娴熟，不会使用" + name() + "。\n");

  if ((int)me->query_skill("unarmed", 1) < 150)
    return notify_fail("你的扑击格斗之技还不够娴熟，不会使用" + name() + "。\n");

  if ((int)me->query_skill("dodge", 1) < 150)
    return notify_fail("你的身法还不够娴熟，不会使用" + name() + "。\n");

  if (me->query_skill("force", 1) < 150)
    return notify_fail("你的内功修为不足以使用" + name() + "。\n");

  if (me->query_skill_mapped("dodge") != "yuanwu-steps")
    return notify_fail("你现在无法使用" + name() + "。\n");
  if (me->query_temp("sk_time") + 2 > time())
    return notify_fail("你刚刚使用了" + name() + "。\n");
  if ((int)me->query("max_force") < 1000)
    return notify_fail("你的内力太弱，不足以使用" + name() + "。\n");

  if ((int)me->query("force") < 600)
    return notify_fail("你的真气不够！\n");

  if (me->query("gender") != "女性" && me->query_skill("yuanwu-xinfa", 1) < 1000)
    return notify_fail("以你笨拙的男儿身怎使得出飞燕蹴的精髓！\n");

  if (me->query_temp("chunli/qingting") > 3)
    return notify_fail("绝招用多就不灵了。\n");

  return 1;
}

int perform(object me, object target) {
  string msg;
  int dodge_amount, damage, time;

  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用！\n");

  damage = me->query_skill("unarmed");
  damage += me->query_skill("yuanwu-xinfa", 1);
  damage += me->query("force_factor");

  dodge_amount = me->query_skill("dodge");
  dodge_amount = dodge_amount * (5 + random(6)) / 10;

  me->start_call_out((: call_other, __FILE__, "remove_effect", me :), 2 + random(3));

  if (!me->query_temp("chunli/qingting")) {
    if (me->query_temp("chunli/hejiao") == 2) {
      if (me->query_temp("chunli/longxing")) {
        tell_object(me, HIW "你正使用龙星落中。\n" NOR);
        return 1;
      }
      call_out("longxing", 0, me, target, damage);
    } else if (me->query_temp("chunli/xuanyuan") == 2) {
      if (me->query_temp("chunli/bashan")) {
        tell_object(me, HIW "你正使用霸山中。\n" NOR);
        return 1;
      }
      call_out("bashan", 0, me, target, damage);
    } else {
      me->add("force", -100);
      msg = WHT "\n$N" WHT "双足点地身形轻盈，纵身越起，运起轻功，在半空随风飞舞，仿若夏雨后荷叶池上
的蜻蜓一般，身形轻曼，优雅致极。\n" NOR;
      msg += WHT "\n$N" WHT "越舞越快，整个人幻化出无数残影，一时分不清哪一个才是真正的$N" WHT "。\n" NOR;
      message_vision(msg, me, target);
      msg = WHT "\n$N" WHT "在空中一个转身，对$n发起一阵猛击！\n" NOR;
      message_vision(msg, me, target);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
      message_vision(WHT "$N" WHT "嘻嘻一笑，皱了皱鼻子，放慢了脚步。\n" NOR, me);
    }
  }

  else if (me->query_temp("chunli/qingting") == 1) {
    if (me->query_temp("chunli/yingzhua")) {
      tell_object(me, HIW "你正使用鹰爪中。\n" NOR);
      return 1;
    }
    call_out("yingzhua", 0, me, target, damage);
  } else if (me->query_temp("chunli/qingting") == 2) {
    if (me->query_temp("chunli/tianxing")) {
      tell_object(me, HIW "你正使用天星中。\n" NOR);
      return 1;
    }
    call_out("tianxing", 0, me, target, damage);
  }
  me->add_temp("chunli/qingting", 1);
  me->add_temp("sk_count", 1);
  if (me->query_temp("sk_count") % 4 == 0) me->set_temp("sk_busy", time() + random(4));
  return 1;
}

void remove_effect(object me) {
  if (me->query_temp("chunli/qingting") <= 1)
    me->delete_temp("chunli/qingting");
  else me->add_temp("chunli/qingting", -1);
  return;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("feiyan-cu") + " 150 级\n";
  temp += "\t\t" + to_chinese("unarmed") + " 150 级\n";
  temp += "\t\t" + to_chinese("dodge") + " 150 级\n";
  temp += "\t\t" + to_chinese("force") + " 150 级\n";
  temp += "\t\t不可入魔\n";
  temp += "\t\t必须激发轻功为元武门身法\n";
  temp += "\t\t内力修为十年\n";
  temp += "\t\t内力６００点\n";
  temp += "\t\t元武门心法低于1000级时必须女性才能使用\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP 

        使用功效：   
                重创对手的气血或精神
        出招类型：   
                busy或延时型外功  
                有隐藏效果  
                叛师不可带出   
        出手要求：     
HELP);
  write(temp);
  return 1;
}
