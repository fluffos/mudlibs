#include <ansi.h>
#include <armor.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int cast(object me) {
  int skill;
  me = this_player();

  if (!wizardp(me)) return notify_fail("测试中。。。\n");

  if ((int)me->query_skill("spirit-power", 1) < 50)
    return notify_fail(HBGRN + HIW "你的精神力量等级不够。\n" NOR);
  if (me->query("family/family_name") != "格斗家")
    return notify_fail("不是元武门弟子不能用「" + HBGRN + HIW "玄武之甲" NOR "」！\n");
  if ((int)me->query("mana") < 900)
    return notify_fail("你的法力不够。\n");
  if ((int)me->query("kee") < 500)
    return notify_fail("你的气血不足。\n");
  if ((int)me->query("sen") < 500)
    return notify_fail("你的精神不足。\n");
  if ((int)me->query_temp("anti_magic"))
    return notify_fail("你已经在运功中了。\n");

  skill = (int)me->query_skill("spirit-power") / 10;

  me->add("mana", -100);
  me->receive_damage("kee", 30);
  me->receive_damage("sen", 30);

  message_vision(
    HBGRN + HIW "$N瞑目念动咒语，全身立刻被一股无形的气墙笼罩。\n" NOR, me);

  me->set_temp("anti_magic", skill);

  me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill / 2 :), skill);

  if (me->is_fighting()) me->start_busy(1 + random(2));

  return 1;
}

void remove_effect(object me, int amount) {
  me->delete_temp("anti_magic");
  tell_object(me, HBGRN + HIW "你周围的气墙渐渐淡去。\n" NOR);
  return;
}

string ob_hit_msg(object me, object victim, int damage_bonus) {
  string msg;

  if ((int)me->query_temp("anti_magic")) {
    msg = HBGRN + HIW "$N周围的气墙顺势起了微微的波动..." NOR;
    msg += HBGRN + HIW "结果$N所中的攻击被气墙尽数卸去！\n" NOR;
    me->set_temp("jia_baohu", 1);
    message_vision(msg, me);
  } else return "";
}

int ob_hit_int(object me, object victim, int damage_bonus) {
  int level, damage, skill;
  skill = (int)me->query_skill("spirit-power");
  if (me->query_temp("jia_baohu") && (int)me->query_temp("anti_magic")) {
    skill = 1000 - skill;
    if (skill < 10) skill = 10;
    if (skill > 900) skill = 900;
    if (damage < skill / 10) damage = skill / 10;
    if (damage > skill / 2) damage = skill / 2;
    damage = random(damage / 2) + damage / 2;
    me->delete_temp("jia_baohu");
    return -damage;
  } else return 0;
}
