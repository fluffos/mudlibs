
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIC"鹰翔扑袭"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "格斗家" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("rukong-zhao", 1) < 100) 
        return notify_fail("你的入空爪修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("max_force") < 500 ) 
        return notify_fail("你的内力修为太浅！\n"); 
if((int)me->query("force") < 200 ) 
        return notify_fail("你的内力不足！\n"); 
if((int)me->query("sen") < 200 ) 
        return notify_fail("你的精神不足！\n"); 
if(time()-me->query_temp("sfighter_pu") < 3+random(3))
        return notify_fail("绝招用多了就不灵了！\n"); 
return 1;  
}

int perform(object me, object target)
{
int i,damage,ap,dp;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

i=(int)me->query_skill("unarmed");
damage=i*2+me->query("force_factor");
ap=(int)me->query("combat_exp");
dp=(int)target->query("combat_exp");

message_vision(HIW"\n$N"HIW"长啸一声，高跃在天，突然空中一个旋身，往$n"HIW"猛扑而来。\n"NOR,me,target);
if (random(ap/8000*me->query_int()) > dp/24000*target->query_int())
        {
        message_vision(HIR"$N"HIR"曲指成爪，一把扣住$n"HIR"的咽喉，左右一抓，$n"HIR"顿时血流如柱。\n"NOR,me,target);
        target->receive_damage("kee", damage+random(damage), me);
        target->receive_wound("kee", damage, me);
        COMBAT_D->report_status(target);
        }
else    {
        message_vision(HIY"$n"HIY"见此招凶猛，使个铁板桥，堪堪躲过这招。\n"NOR,me,target);
        }
//第二式
message_vision(HIG"\n$N"HIG"不给敌人喘息之机，纵身一跃，左鹰爪，右蛇牙，往$n"HIG"的咽喉和心脏攻去。\n"NOR,me,target);
if (random(ap/8000*me->query_kar()) > dp/16000*target->query_kar())
        {
        target->receive_damage("kee", damage+random(damage), me);
        target->receive_wound("kee", damage, me);
        COMBAT_D->report_status(target);
        }
else    message_vision(HIY"$n"HIY"提气纵身，凌空翻去，避过此招。\n"NOR,me,target);
me->add("force",-200);
me->receive_damage("sen", 200, target);
me->set_temp("sfighter_pu", time());
return 1;
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("rukong-zhao")+" 100 级\n";  
temp+= "\t\t内力修为五年\n"; 
temp+= "\t\t内力２００点\n"; 
temp+= "\t\t精神２００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                连续伤害对手气血
        出招类型：   
                延时型外功  
                无隐藏效果  
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
