
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIB"毒蛇疾电滚"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "格斗家" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("rukong-zhao", 1) < 150) 
        return notify_fail("你的入空爪修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("max_force") < 500 ) 
        return notify_fail("你的内力修为太浅！\n"); 
if((int)me->query("force") < 200 ) 
        return notify_fail("你的内力不足！\n"); 
if((int)me->query("sen") < 200 ) 
        return notify_fail("你的精神不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
int i,j,damage,ap,dp;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
if(target->query_temp("block_msg/all"))
        return notify_fail("你的对手已经看不见了，还不赶快攻击。\n");

i=(int)me->query_skill("unarmed");
damage=i*2/3+me->query("force_factor");
j=i/30;
if (j<5) i=5;
if(j>15) i=15;
ap=(int)me->query("combat_exp");
dp=(int)target->query("combat_exp");

message_vision(HIC"\n$N"HIC"双手抱腿，曲身成球，猛运鬭气往$n"HIC"撞来。\n\n"NOR,me,target); 
me->delete("env/brief_message"); 
target->delete("env/brief_message");
if( random(ap/8000) > dp/12000 )
        {
        target->receive_damage("kee", damage, me); 
        target->receive_wound("kee", damage, me); 
        COMBAT_D->report_status(target); 
        }
message_vision(HIB"\n蓦地里$N"HIB"猱身而上，右手成爪，往$n"HIB"双目挑去！\n"NOR, me,target); 
if (ap/20000 > random(dp/50000*23))
        {
        tell_object(target, HIB"你双眼一黑，再也瞧不见甚么。\n"NOR); 
        target->set_temp("block_msg/all",1); 
        message_vision(HIB"$N"HIB"身形飘忽，有如灵蛇，转了几转，倒纵出去，出手之奇之快，直是匪夷所思！\n"NOR, me,target);
        message_vision(HIR"只见$n"HIR"双眼中流下两道极细的血线，横过面颊，直挂到下颏。\n"NOR, me,target);
        target->start_busy(2); 
        target->add_temp("apply/attack", - i/3); 
        target->add_temp("apply/dodge", - i/3); 
        target->add_temp("apply/parry", -i/3); 
        call_out("back",j, target,i); 
        }
else    message_vision(HIY"$n"HIY"抱头缩颈一个滚翻，总算躲开了$N"HIY"这一招。\n"NOR,me,target); 
me->start_busy(2+random(2)); 
return 1;
}

void back(object target,int i) 
{
if(!living(target)) return;
target->add_temp("apply/attack", i/3);
target->add_temp("apply/dodge", i/3); 
target->add_temp("apply/parry", i/3);
target->set_temp("block_msg/all", 0); 
tell_object(target, HIW "你抹掉双目血迹，终于能看到东西了，幸好没瞎。\n" NOR); 
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("rukong-zhao")+" 150 级\n";  
temp+= "\t\t内力修为五年\n"; 
temp+= "\t\t内力２００点\n"; 
temp+= "\t\t精神２００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                伤害对手气血，
                降低对手攻防，
                牵制对手，
                使对手在一段时间内失明
        出招类型：   
                busy型外功  
                有隐藏效果  
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
