#include <ansi.h>
#include <combat.h>
inherit SSERVER;

//inherit F_CLEAN_UP;

int check_fight(object me, int amount);
int remove_effect(object me, int amount);

string powercol(int level)
{
        if ( level == 1 )
                return HIC "X 级力量" NOR;
        else if ( level == 2)
                return HIC "Z 级力量" NOR;
        else if ( level == 3)
                return HIC "V 级力量" NOR;
        else if ( level == 4)
                return HIW "白 鬭 气" NOR;
        else if ( level == 5)
                return HIY "黄 鬭 气" NOR;
        else if ( level == 6)
                return HIG "绿 鬭 气" NOR;
        else if ( level == 7)
                return HIR "红 鬭 气" NOR;
        else if ( level == 8)
                return HIB "蓝 鬭 气" NOR;
        else if ( level == 9)
                return HIM "紫 鬭 气" NOR;
        else 
                return BLK "黑 鬭 气" NOR;
}

int exert(object me, object target)
{
        int skill;


	if( !target ) target = offensive_target(me);
	if( !me->is_fighting() )
            return notify_fail("「鬭气」只能在战斗中使用。\n");
if(me->query("family/family_name") != "格斗家" && !me->samsara_check("power",1))
                return notify_fail("你是哪儿偷学来的武功！\n");

 
        if( (int)me->query_temp("powerup") ) 
                return notify_fail("你已经在运功中了。\n");
        if( (int)me->query_temp("yi") ) 
                return notify_fail("你正在使用精神力量「意」。\n");

        skill = me->query_skill("power",1);


        message_vision(
                HIC"$N微一凝神，运起鬭 气 力 量，顿时全身为"+powercol(me->query("power_lvl"))+HIC"所笼罩。\n" NOR, me);
 
        me->add_temp("apply/armor",skill);
        me->add_temp("apply/damage",skill/2);
        me->set_temp("powerup", 1);
        
        check_fight(me,skill);

        return 1;
}

int check_fight(object me, int amount)
{  
    if(!me) return 0;
    if(!me->is_fighting() || !living(me) || me->is_ghost())
        remove_effect(me, amount);

    else {
	call_out("check_fight", 1, me,amount);
    }
    return 1;
}

int remove_effect(object me, int amount)
{
        me->add_temp("apply/armor", - amount);
        me->add_temp("apply/damage",- amount/2);
        me->delete_temp("powerup");
        tell_object(me, "你散去所凝聚的鬭 气 力 量。\n");
	 return 1;
}
