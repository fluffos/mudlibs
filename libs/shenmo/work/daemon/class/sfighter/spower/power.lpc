#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int cast(object me)
{
	int skill;
	me=this_player();


	if( (int)me->query_skill("spirit-power", 1) < 100 )
		return notify_fail("你的精神力量等级不够。\n");

        if( (int)me->query("mana") < 500 )     
                return notify_fail("你的法力不够。\n");
	if( (int)me->query("kee") < 500 )
		return notify_fail("你的气血不足。\n");
	if( (int)me->query("sen") < 500 )
		return notify_fail("你的精神不足。\n");

        if( (int)me->query_temp("spower_magic") ) 
                return notify_fail("你已经在运功中了。\n");

        skill = me->query_skill("spells");

        me->add("mana", -300);
        me->receive_damage("kee", 50);
	me->receive_damage("sen", 50);

        message_vision(
                HIC"$N微一凝神，将精神力量提至极限，顿时心清目明，反应斗增。\n" NOR, me);

        me->set_temp("spower_magic", skill);
        me->add_temp("apply/dodge",skill*2/3);
        me->add_temp("apply/parry",skill*2/3);

        me->start_call_out( (: call_other, __FILE__, "remove_effect", me, skill/3 :), skill);

        if( me->is_fighting() ) me->start_busy(1);

        return 1;
}

void remove_effect(object me, int amount)
{
        me->delete_temp("spower_magic");
        me->add_temp("apply/dodge",-amount*2);
        me->add_temp("apply/parry",-amount*2);
        tell_object(me, "你精神力量运行过久，忽觉疲倦，遂散去精神力量。\n");
	return;
}

