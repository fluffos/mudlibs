

#include <ansi.h>
#include <combat.h>

inherit F_CLEAN_UP;

void remove_effect(object me);
void check_mapped(object me);
string huan_result(object me, object victim, int mod_val, int force_adj, mapping action);

int perform(object me, object target)
{
        int skill;


        skill = me->query_skill("wushen-steps",1);

	if( skill > 250 ) skill=250;
	
if(me->query("family/family_name") != "格斗家" && !me->samsara_check("wushen-steps",1) )
                return notify_fail("你不是格斗家不能用幻影提升自己的闪避率。\n");
/*
        if( target != me ) 
		return notify_fail("你只能用幻影提升自己的闪避率。\n");
*/
        if(time()-(int)me->query_temp("huan_end") < 10) return notify_fail("你刚使过幻影，歇歇吧。\n");
        
        if( (int)me->query("force") < skill*2 )     
		return notify_fail("你的内力不够。\n");
		
        
        
        if( me->query_temp("huan") ) 
	{remove_effect(me);return 1;}

        me->add("force", -skill);
        message_vision(HIW "$N将内劲运足双腿，使出武神流绝学---幻影，$N的身形顿时变得飘忽不定，难以捉摸！\n" NOR, me,target);
        me->set_temp("huan", 1);
        me->set_temp("huan_time",skill);
        call_out("check_mapped", 1, me);
        
        return 1;
}


void check_mapped(object me)
{
	if(!me) return;                
	if( me->query_skill_mapped("dodge") != "wushen-steps" ) 
	remove_effect(me);
	else if(me->query_temp("huan_time")<1)
	remove_effect(me);			
	else {  me->add_temp("huan_time",-1);
		call_out("check_mapped", 1, me);
	     }
}


void remove_effect(object me)
{
        if(!me) return;
        remove_call_out("check_mapped");
        me->delete_temp("huan");
        me->set_temp("huan_end", time() );
	tell_object(me, "你散去双腿的内劲,身形慢了下来,。\n");
}


string huan_result(object me, object victim, int mod_val, int force_adj,mapping action)
{   string result,str;
    int me_force,v_dodge;
    object vweapon;
    int damage, damage_bonus,defense_factor,wounded;
    mixed foo;	 
 
          if( force_adj > mod_val*3/4 ){
             switch(random(5)){
                case 0:  result =HIW"$N轻轻一跳，$n的招式打空了。\n"NOR; break;
                case 1:  result =HIW"$n一招重重打中$N,正得意时，却发现$N坐在一旁啃着面包，原来$n打中了$N的幻影。\n"NOR;break;
                case 2:  result =HIW"$N面带微笑，身法虚无缥缈，御风而行，$n一招已至面前，却不料$N飘在半空顺势\n而出，当真逍遥似仙！\n"NOR;break;
	         case 3:  result =HIW"$N足不点地，飘然而走，东一幌、西一斜，便如游鱼一般，从$n招式的缝隙之中\n硬生生地挤了过去。\n"NOR;break;
                case 4:  result =HIW"$N硬生生笔直跃起，将$n的攻势化于无形。\n"NOR;break;
                case 5:  result =HIW"$N身法一变，随着$n攻势，敌左则左，敌右则右，$n虽看似大占上风，却无一招能够击中。\n"NOR;break;
              }
            return result;
         }

                if ( damage > 0 && wounded)  result += "( $N" + COMBAT_D->eff_status_msg(
			       (int)victim->query("eff_kee") * 100 /(1+(int)victim->query("max_kee")) ) 
			       + " )\n";
                          else result +=   "( $N" + COMBAT_D->status_msg(
			       (int)victim->query("kee") * 100/(1+(int)victim->query("max_kee")) ) 
			       + " )\n";              
                    return result;

}

