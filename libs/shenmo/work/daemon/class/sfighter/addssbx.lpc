#include <action.h>
#include <ansi.h>

string powercol(int level) {
  if (level == 1)
    return HIC "X 级力量" NOR;
  else if (level == 2)
    return HIC "Z 级力量" NOR;
  else if (level == 3)
    return HIC "V 级力量" NOR;
  else if (level == 4)
    return HIW "白 鬭 气" NOR;
  else if (level == 5)
    return HIY "黄 鬭 气" NOR;
  else if (level == 6)
    return HIG "绿 鬭 气" NOR;
  else if (level == 7)
    return HIR "红 鬭 气" NOR;
  else if (level == 8)
    return HIB "蓝 鬭 气" NOR;
  else if (level == 9)
    return HIM "紫 鬭 气" NOR;
  else
    return BLK "黑 鬭 气" NOR;
}

int full(object me) {
  int jin, qi, neili, fali, shiwu, yinshui;
  jin = me->query("max_sen");
  qi = me->query("max_kee");
  fali = me->query("max_mana");
  neili = me->query("max_force");
  shiwu = me->max_food_capacity();
  yinshui = me->max_water_capacity();
  me->set("eff_sen", jin);
  me->set("eff_kee", qi);
  me->set("sen", jin);
  me->set("kee", qi);
  me->set("mana", fali * 2);
  me->set("force", neili * 2);
  me->set("food", shiwu);
  me->set("water", yinshui);
  return 1;
}


int main(object me) {
  int powerlvl = (int)me->query("power_lvl");
  string powercol = powercol(powerlvl);

  if (!me->query("ssbx_done")) return notify_fail("你还未能领悟出此最高秘诀。\n");
  if (me->is_busy()) return notify_fail("你正忙着呢！\n");
  if (me->query_skill_mapped("unarmed") != "yuanwu-kungfu") return notify_fail("你现在并没使用元武门绝学。\n");
  if (me->query("ssbx_num") == 10) return notify_fail("你体内元气充沛，可以使用『生生不息』。\n");

  message_vision("$N练了一遍元武门绝学，吸取着天地元气，将其转化为自身元气。\n", me);
  me->add("ssbx_num", 1);
  tell_object(me, "你体内的元气增加了！\n");
  if (me->query("ssbx_num") == 10)
    tell_object(me, "你所能容纳的元气已经到达极限。\n");
  me->start_busy(5);
  return 1;

}

int help(object me) {
  write(@HELP
指令格式 : addssbx

吸收天地元气，以供『生生不息』之用。

HELP
  );
  return 1;
}
