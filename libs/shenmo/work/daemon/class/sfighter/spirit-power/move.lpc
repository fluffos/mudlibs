
#include <ansi.h>

inherit SSERVER;

int cast(object me, object target)
{
	target = offensive_target(me);

	if( (int)me->query("mana") < 100 )
		return notify_fail("你的法力不够了！\n");

	if( (int)me->query("sen") < (int)me->query("max_sen")/2 )
		return notify_fail("你现在头脑不清醒，无法使用时空穿梭术！\n");

if(me->query("family/family_name") != "格斗家" && !me->samsara_check("spirit-power",1) )
		return notify_fail("你并非格斗家，无法使用时空穿梭术。\n");

	message_vision(HIY "$N屏气凝神，将精神力量运至顶峰，浑身散发出阵阵金色光芒！\n" NOR, me);
	message_vision(HIY "光芒越来越盛，周围的空间不住晃动！\n\n" NOR, me);

	if(me->is_fighting() ) {
		if(random((int)me->query("max_mana")) > (int)target->query("max_mana")/2 && random((int)me->query("mana")) > (int)target->query("mana")/2 ) {
			message_vision(HIC "$N身形逐渐模糊，只见一道强光闪过，$N消失了！\n" NOR, me);
			me->receive_damage("sen", 50);
			me->add("mana", -100);
			if(random(3)==0) me->move("/d/sfighter/jiejie2");
			else if(random(3)==1) me->move("/d/sfighter/center");
			else me->move("/d/city/center");
			message_vision(HIC "周围的空间突然不住晃动，强光一闪，$N突然出现在眼前。\n" NOR, me);
		}
		else{
			message_vision(HIC "$N身形逐渐模糊，$n急忙一招攻去，$N逼不得以，中止施法。\n" NOR, me, target);
			me->receive_damage("sen", 50);
			me->add("mana", -100);
		}
	}

	else{
		message_vision(HIC "$N身形逐渐模糊，只见一道强光山过，$N消失了！\n" NOR, me);
		me->add("mana", -100);
              if(random(3)==0) me->move("/d/sfighter/jiejie2");
		else if(random(3)==1) me->move("/d/sfighter/center");
		else me->move("/d/city/center");
		message_vision(HIC "周围的空间突然不住晃动，强光一闪，$N突然出现在眼前。\n" NOR, me);

	}

	return 3+random(5);
}

