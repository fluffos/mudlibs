
//modify by fang 20070425
#include <ansi.h>

inherit SSERVER;
void remove_yi(object me,int skill,int skill2);

int cast(object me, object target)
{
       int skill,skill2;

        if( (int)me->query("mana") < 600 )
                return notify_fail("你的法力不够了！\n");

        if( (int)me->query("sen") < (int)me->query("max_sen")/2 )
                return notify_fail("你现在头脑不清醒，冒然使用『意』只怕会走火入魔！\n");

if(me->query("family/family_name") != "格斗家" && !me->samsara_check("spirit-power",1) )
                return notify_fail("你并非格斗家，无法使用『意』来提升力量。\n");

       if(me->query_skill("yuanwu-xinfa",1))
              return notify_fail("你心中正义凛然，不再受『意』的控制。\n");

       if(me->query_temp("powerup", 1))
              return notify_fail("你「鬭气」正运行当中。\n");

      if(!me->query("sfighter/sha")&&!me->query("sfighter/ba")) 
              return notify_fail("你尚不会这招！\n");

       if (me->query_temp("yi")&&me->query_skill("ghost-spirit",1)>=200)  {
              remove_yi(me,me->query_temp("sfighter/skill"),me->query_temp("sfighter/skill2"));
              return 1;}

       if (me->query_temp("yi")&&me->query_skill("ghost-spirit",1)<200) 
              return notify_fail("你的心智已经迷失，无法控制自己。\n");

       skill=me->query_skill("yuanwu-kungfu",1);
       skill2=me->query_skill("ghost-spirit",1);

       me->set_temp("sfighter/skill",skill);
       me->set_temp("sfighter/skill2",skill2);

//*****************************************************************************************************************************

       if (me->query("sfighter/sha")&&me->query_skill("ghost-spirit",1)<300&&!me->query_temp("yi")){ 

            tell_object(me,HIR "\n你放任自己的意识不住扩散，只觉得一股强烈的杀意逐渐高涨！\n" NOR);
            tell_object(me,HIR "“轰”，你只觉脑海中一声巨响，意识随即被高涨的杀意所淹没！\n\n" NOR);
           message_vision(HIR"$N皮肤突然变成赤红，双目亦红得快流出血来，一股强烈的杀意从$N散发出来，不住往四周空间迸射！\n"NOR,me);

           me->set("title",HIR"殺意"NOR);
           me->set_temp("shayi",1);
           me->set_temp("yi",1);
          }

//*****************************************************************************************************************************

       if (me->query("sfighter/ba")&&me->query_skill("ghost-spirit",1)<300&&!me->query_temp("yi")){ 

            tell_object(me,HIY "\n你放任自己的意识不住扩散，一股无法压制的强烈霸意逐渐高涨！\n" NOR);
            tell_object(me,HIY "“轰”，你只觉脑海中一声巨响，仅存的意识被高涨的霸意所吞没！\n\n" NOR);
           message_vision(HIY"$N皮肤突然发出金色光芒，令人窒息的强烈霸意不断从$N身上散发出来，周围的事物亦禁不住颤抖起来！\n"NOR,me);

           me->set("title",HIY"霸意"NOR);
           me->set_temp("bayi",1);
           me->set_temp("yi",1);
          }

//*****************************************************************************************************************************

       if (me->query_skill("ghost-spirit",1)<600&&!me->query_temp("yi")){ 

            tell_object(me,HIB "\n你放任自己的意识不住扩散，一股莫名的滅の意逐渐高涨！\n" NOR);
            tell_object(me,HIB "“轰”，你只觉脑海中一声巨响，脑中的意识突然消失不见，唯有无尽的---破坏！\n\n" NOR);
           message_vision(HIB"周围的空间突然不住晃动，$N双眼变得墨黑，令人恐惧的强烈破坏气息不断从$N身上散发出来！\n"NOR,me);

            me->set("title",HIB"滅の意"NOR);
           me->set_temp("yi",1);
          }

//*****************************************************************************************************************************

       if (me->query_skill("ghost-spirit",1)<900&&!me->query_temp("yi")){ 

            tell_object(me,HIC "\n你放任自己的意识不住扩散，一股令人肃穆的意逐渐高涨！\n" NOR);
            tell_object(me,HIC "“轰”，你只觉脑海中一声巨响，原有的意识消失殆尽，被一股睥睨天下的意识所占据！\n\n" NOR);
           message_vision(HIC"$N周身突然散发出一股令人慑服的气息，周遭生物皆拜身降伏，一股天的气息...！\n"NOR,me);

           me->set("title",HIC"天の意"NOR);
           me->set_temp("yi",1);
          }
//*****************************************************************************************************************************

       if (me->query_skill("ghost-spirit",1)>=900&&!me->query_temp("yi")){ 

            tell_object(me,BLU "\n你放任自己的意识不住扩散，慢慢的，被一股难以形容的意识所占据！\n" NOR);
            tell_object(me,BLU "“轰”，你只觉脑海中一声巨响，所有的意识消失殆尽！\n\n" NOR);
           message_vision(BLU"$N突然消失！不，不是消失，身形犹在，只是从$N身上再也感觉不到任何生命的气息，无尽的虚无！\n"NOR,me);
           
           me->set("title",BLU"無の意"NOR);
           me->set_temp("yi",1);
          }

//*****************************************************************************************************************************

       me->add_temp("apply/damage",(skill+skill2)/3);
       me->add_temp("apply/armor",(skill+skill2)/2);
       me->add_temp("apply/dodge",(skill+skill2)/3);
       me->add_temp("apply/parry",(skill+skill2)/3);
       me->add_temp("apply/unarmed",(skill+skill2)/3);
     me->set_temp("max_sen",me->query("max_sen"));
       call_out("check_yi",5,me);

       me->add("mana",-500);
if( me->query_skill("ghost-spirit",1) < 600 )
        return 2+random(2);
else  return -1;
}

void remove_yi(object me,int skill,int skill2)
{
      if (!me->query_temp("yi")) return;

       me->add_temp("apply/damage",-(skill+skill2)/3);
       me->add_temp("apply/armor",-(skill+skill2)/2);
       me->add_temp("apply/dodge",-(skill+skill2)/3);
       me->add_temp("apply/parry",-(skill+skill2)/3);
       me->add_temp("apply/unarmed",-(skill+skill2)/3);
       me->delete_temp("shayi",1);
       me->delete_temp("bayi",1);
     if( me->query_temp("max_sen")>0 ) {me->set("max_sen",me->query_temp("max_sen"));me->set("sen",me->query_temp("max_sen"));me->set("eff_sen",me->query_temp("max_sen"));me->delete_temp("max_sen");}
       me->delete_temp("yi",1);
       me->set("title", HIB"真·豪鬼秘传弟子"NOR); 
       message_vision(HIB"$N意识逐渐回复，身上的异变亦恢复了正常。\n"NOR,me);       
}

void check_yi(object me)
{
   int skill,skill2;
      if( !objectp(me) ) return;
      skill=me->query_temp("sfighter/skill");
      skill2=me->query_temp("sfighter/skill2");

    if(!objectp(me)||!me->query_temp("yi")) return; 
       message_vision(HIY"$N意识混乱，身体亦变得异变了。\n"NOR,me);  

           if( me->query("max_sen") > (skill+skill2)/2) { 
           me->add("sen",-(skill+skill2)/2); 
           me->add("eff_sen",-(skill+skill2)/2); 
           me->add("max_sen",-(skill+skill2)/2); 
           } 
           else { me->set("sen",1);me->set("eff_sen",1);me->set("max_sen",1);}

      call_out("check_yi",5,me);
}

