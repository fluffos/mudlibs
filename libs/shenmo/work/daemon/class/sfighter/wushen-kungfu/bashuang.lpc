
// write by windy 07/07/05
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 
string name()  
{
return "「"WHT"武神八双掌"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "格斗家" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("wushen-kungfu", 1) < 150) 
        return notify_fail("你的武神流绝学修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("wushen-steps", 1) < 150) 
        return notify_fail("你的武神流身法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("max_force") < 1500 ) 
        return notify_fail("你的内力修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("force") < 1000 ) 
        return notify_fail("你的内力不足！\n"); 
if (time()-me->query_temp("sfighter_bashuang")<4+random(4) && me->query_skill("ghost-spirit", 1)<200)
        return notify_fail("绝招用多了就不灵了！\n"); 
if (time()-me->query_temp("sfighter_bashuang")<2+random(2) && me->query_skill("ghost-spirit", 1)>=200)
        return notify_fail("绝招用多了就不灵了！\n"); 
return 1;  
}

int perform(object me, object target)
{
int i;
object weapon;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

weapon = me->query_temp("weapon"); 

message_vision(WHT  "\n$N"WHT"运起武神流身法，化出八个分身，往$n"WHT"攻去。\n" NOR,me,target); 
for (i=0;i<=7;i++)
        {
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR); 
        }
me->set_temp("sfighter_bashuang", time());
return 1; 
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("wushen-kungfu")+" 150 级\n";  
temp+= "\t\t"+to_chinese("wushen-steps")+" 150 级\n";  
temp+= "\t\t内力修为十五年\n"; 
temp+= "\t\t内力１０００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                连续打击对手的气血 
        出招类型：   
                延时型外功  
                无隐藏攻击  
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
