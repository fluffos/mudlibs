
// write by windy 07/07/16
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIR"武神斩"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "格斗家" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("wushen-kungfu", 1) < 100) 
        return notify_fail("你的武神流绝学修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("force") < 500 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
int amount;
object weapon;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

weapon = me->query_temp("weapon"); 
amount = (int)me->query_skill("unarmed")*2/3;

message_vision(HIC "\n$N"HIC"大喝一声，长吸一口气，纵身跃起，右腿一旋划作一片刀影从半空中直劈下来。\n" NOR,me,target);
message_vision(YEL"只听呼地一声，刀影离地尚有数尺，地下已是尘沙飞扬，败草落叶被劲风激得团团而舞，端的是威力惊人！\n" NOR,me,target);
message_vision(HIG"刹那间$n"HIG"已被裹在一阵刺骨的劲气之中，不由得倒吸了一口冷气。\n" NOR,me,target);
if (!target->is_busy())
        target->start_busy(1);
me->add_temp("apply/attack", amount);
me->add_temp("apply/damage", amount);
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR); 
me->add_temp("apply/damage",amount);
message_vision(HIC "\n$N"HIC"招势未尽，半空中一旋，结合第一腿的威力，猛劈下来。\n" NOR,me, target);
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR); 
me->add("force", -200);
me->add_temp("apply/attack", -amount);
me->add_temp("apply/damage", -amount*2);
me->start_busy(1+random(2));
return 1;
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("wushen-kungfu")+" 100 级\n";  
temp+= "\t\t内力５００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                连续打击对手的气血 
        出招类型：   
                busy型外功  
                有隐藏效果  
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
