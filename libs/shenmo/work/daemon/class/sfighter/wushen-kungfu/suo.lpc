
// write by windy 07/07/14
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 
string name()  
{
return "「"HIC"武神嶽锁拳"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "格斗家" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("wushen-kungfu", 1) < 100) 
        return notify_fail("你的武神流绝学修为太浅，难以施展"+name()+"！\n"); 
return 1;  
}

int perform(object me, object target)
{
int mypot,tapot,time; 
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
if( target->is_busy() ) 
        return notify_fail(target->name()+"已经够忙了，你使的再漂亮也不会注意到。\n"); 

mypot=me->query_skill("unarmed"); 
mypot*=me->query_int(); 
tapot=target->query_skill("parry"); 
tapot*=target->query_int(); 
time=me->query_skill("wushen-kungfu",1); 
time/=100; 
if ( time<1 ) time=1; 
if ( time>7 ) time=7; 

message_vision(HIC"$N"HIC"双手划了个按圈，顿时一招一式节节贯串，左圈右圈圆转不断，如千山万壑，连绵不绝。\n"NOR,me, target); 
if( (random(mypot)*3/4+mypot) > tapot/2 )  
        {
        message_vision( HIY"但见这招一圈过后，又是一圈，$n"HIY"登时被劲气锁住了，动弹不得。\n"NOR,me, target); 
        target->start_busy(time+random(3)); 
        }
else    {
        message_vision(HIR"$n"HIR"全身内力一震，$N"HIR"双手按他不住，被$n"HIR"跃出圈外！\n" NOR,me,target); 
        time-=4; 
        if ( time> 3 ) time=3; 
        if ( time<1 )  time=1; 
        me->start_busy(time); 
        }
return 1; 
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("wushen-kungfu")+" 100 级\n";  
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                牵制对手
        出招类型：   
                busy型外功  
                无隐藏攻击  
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
