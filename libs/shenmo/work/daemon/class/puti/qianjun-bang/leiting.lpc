#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name()
{
return "「"HIB"雷霆一击"NOR"」";
}

void remove_broken_weapon(object ob)
{
if( ob && environment(ob) ) 
        {
        tell_object(environment(ob),"一阵微风吹过，"+ob->name()+"化为片片尘土，消失不见了。\n");
        destruct(ob);
        }
}

int valid_perform(object me)
{
if ( me->query("family/family_name")!="方寸山三星洞"  && !me->samsara_check("qianjun-bang",1) )
        return notify_fail("你是哪儿偷学来的武功，也想用"+name()+"？\n");
if ( me->query_skill("qianjun-bang",1) < 80 )
        return notify_fail("你的"+to_chinese("qianjun-bang")+"等级不足"+80+"级，无法使出"+name()+"。\n");
if ( me->query("force")<100 )
        return notify_fail("你的真气不足 100 点，不能使出"+name()+"。\n");
return 1;
}       
        
int perform(object me, object target)
{
string msg;
int ap,dp;
object weapon1,weapon2;

if ( !valid_perform(me) )
        return 0;
if ( !target ) 
        target = offensive_target(me);
if ( !target
  || !target->is_character()
  || !me->is_fighting(target) )
        return notify_fail(name()+"只能对战斗中的对手使用。\n");
if ( !me->is_fighting() )
        return notify_fail(name()+"必须战斗中使用。\n");

if (!objectp(weapon1 = me->query_temp("weapon"))
|| (string)weapon1->query("skill_type") != "stick")
        return notify_fail("你使用的武器不对，无法施展"+name()+"。\n");
weapon2 = target->query_temp("weapon");
if ( !objectp(weapon2) ) 
        return notify_fail("你的对手没有用兵器！\n");

ap = me->query("level")/10;
ap*= me->query_str()/10;
dp = target->query("level")/10+10;
dp*= target->query_str()/10;
ap*= me->query_skill("stick",1)/80 ;
dp*= target->query_skill("dodge",1)/80;
if ( COMBAT_D->restrain(me,target) )
        ap+= random(ap/3);
if ( COMBAT_D->restrain(target,me) )
        dp+= random(dp/3);
if ( !userp(me) )
        ap+= random(ap/5);      
if ( !userp(target) )
        dp+= random(dp/5);
if ( target->query("family/family_name")=="方寸山三星洞" )
        dp+= random(dp/3);
if ( wizardp(me) )
        tell_object(me,"ap=="+ap+"   dp=="+dp+"\n");
        

message_vision(CYN"\n\n$N"CYN"一个大跳，双手将"+weapon1->name()+CYN"抡圆了朝下一砸！
"+weapon1->name()+CYN"带着呼呼风雷之声朝着$n"CYN"手中的"+weapon2->name()+CYN"砸去！\n"NOR,me,target);
me->add("force",-100);
if ( random(ap+dp)>dp && target->query("spsk")!=6 && !weapon2->query("no_break"))
        {
        if ( !me->query("env/no_msg") && !target->query("env/no_msg") )  
                message_vision(CYN"$n"CYN"的"+weapon2->name()+CYN"断成两截落在了地下！\n"NOR,me,target);       
        weapon2->unequip();
        weapon2->set("name","断成两截的"+weapon2->query("name"));
        weapon2->set("value",0);
        weapon2->delete("weapon_prop");
        weapon2->set("long","一件断成两截的"+weapon2->query("name"));
        weapon2->move(environment(target));
        call_out("remove_broken_weapon", random(30)+60,weapon2);
        target->start_busy(2);
        }
else    {
        if ( !me->query("env/no_msg") && !target->query("env/no_msg") )  
                message_vision(CYN"结果$n"CYN"看破了$P的企图，轻巧地躲过，而$N"CYN"用
力过度，闹了个手忙脚乱。\n"NOR,me,target);
        COMBAT_D->do_attack(target,me, weapon2, TYPE_REGULAR);
        }
me->start_busy(2);
return 1;
}

int help(object me)
{
string temp;    
temp = "\t\t"+to_chinese("puti-zhi")+" 80 级\n";
temp+= "\t\t真    气 100 点\n";
temp+= "\t\t敌人装备兵器\n";
temp+= "\t\t战斗状态下使用\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");
write(@HELP

        使用功效：
                牺牲自身的灵活性来打击敌人
                的武器并致使对方动作缓慢
        出招类型：
                busy型外功
                无隐藏攻击
                不可以叛师带出
        出手要求：              
HELP);                          
write(temp);
return 1;
}
