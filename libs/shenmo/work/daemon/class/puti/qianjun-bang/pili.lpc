#include <ansi.h> 
#include <combat.h>;
inherit SSERVER;

string name()
{
return "「"HIR"霹雳流星"NOR"」";
}

int temp_time(object me)
{
return 1+random(3);     
}

int valid_perform(object me)
{
if ( me->query("family/family_name")!="方寸山三星洞" 
    && me->query_skill("qianjun-bang",1)<350 )
        return notify_fail("你是哪儿偷学来的武功，也想用"+name()+"？\n");
if ( me->query("class")!="xian" && !me->samsara_check("qianjun-bang") )
        return notify_fail(name()+"此乃仙家不传之密。\n");
if ( me->query_skill("qianjun-bang",1) < 100 )
        return notify_fail("你的"+to_chinese("qianjun-bang")+"等级不足"+100+"级，无法使出"+name()+"。\n");
if ( me->query_skill("stick",1) < 100 )
        return notify_fail("你的"+to_chinese("stick")+"等级不足"+100+"级，无法使出"+name()+"。\n");
if ( me->query_skill("dodge",1) < 100 )
        return notify_fail("你的"+to_chinese("dodge")+"等级不足"+100+"级，无法使出"+name()+"。\n");
if ( me->query_skill("force",1) < 100 )
        return notify_fail("你的"+to_chinese("force")+"等级不足"+100+"级，无法使出"+name()+"。\n");
if ( me->query("force")<50 )
        return notify_fail("你的真气不足 50 点，不能使出"+name()+"。\n");
if ( me->query("max_force")<500 )
        return notify_fail("你的内力修为不足 500 点，不能使出"+name()+"。\n");
if ( time()<me->query_temp("fc_pili")+me->query_temp("fc_pili_time") )  
        return notify_fail(name()+"需要"+me->query_temp("fc_pili_time")+"秒的冷却时间。\n");
return 1;
}       
        
int perform(object me, object target)
{
object weapon,ob;
int i,j,skill,damage;
string msg,clr;

if ( !valid_perform(me) )
        return 0;
if ( !target ) 
        target = offensive_target(me);

if ( !target
  || !target->is_character()
  || !me->is_fighting(target) )
        return notify_fail(name()+"只能在战斗中使用。\n"NOR);
if ( !me->is_fighting() )
        return notify_fail(name()+"必须战斗中使用。\n");

if (!objectp(weapon = me->query_temp("weapon"))
|| (string)weapon->query("skill_type") != "stick")
        return notify_fail("你使用的武器不对，无法施展"+name()+"。\n");
message_vision(HIC"\n$N"HIC"运足精神，身形一转，霹雳间连续向$n"HIC"攻出了数招！\n"NOR,me,target);
me->set_temp("perf_quick/msg",HIG"$N"HIG"心有巧意，无意之间加快了攻击！\n"NOR);
for(i=0;i<3+random(3);i++)
        {
        COMBAT_D->do_attack(me,target,weapon,RESULT_FORCE);
        if ( (me->query("family/family_name")=="方寸山三星洞" || me->samsara_check("qianjun-bang",1))
          && target->query("family/family_name")!="方寸山三星洞" )
                SDS_D->hitWeapon(me,target,weapon);        
        }
if ((me->query("spskk")==7 && (int)me->query("level")>(int)target->query("level") && random(3)) || (me->query("spskk")==8 && (int)me->query("level")<(int)target->query("level") && random(3)) || (me->query("spskkk")==3 && random(5)))
        {
        message_vision(HIC"\n$N"HIC"一招得手，精神大振，同时手中棒招加紧，舞动如风，又向$n"HIC"攻去！\n"NOR,me,target);
        for(i=0;i<3+random(3);i++)
                {
                COMBAT_D->do_attack(me,target,weapon,RESULT_FORCE);
                SDS_D->hitWeapon(me,target,weapon);
                }
        }
me->delete_temp("perf_quick");
me->add("force",-50);
me->set_temp("fc_pili",time());
me->set_temp("fc_pili_time",temp_time(me));
return 1;
}

int help(object me)
{
string temp;    
temp = "\t\t"+to_chinese("dodge")+" 100 级\n";
temp+= "\t\t"+to_chinese("force")+" 100 级\n";
temp+= "\t\t"+to_chinese("stick")+" 100 级\n";
temp+= "\t\t"+to_chinese("qianjun-bang")+" 100 级\n";
temp+= "\t\t真    气 50 点\n";
temp+= "\t\t内力修为 100 点\n";
temp+= "\t\t战斗状态下使用\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");
write(@HELP

        使用功效：
                给予敌人至少连续三次攻击
                并有可能打击对方的武器
        出招类型：
                延迟型外功
                有隐藏攻击
                350级可叛师带出
        出手要求：              
HELP);                          
write(temp);
return 1;
}
