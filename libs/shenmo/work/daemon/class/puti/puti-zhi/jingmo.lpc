#include <ansi.h>
inherit SSERVER;

string name()
{
return "「"HIR"惊魔一指"NOR"」";
}

int valid_perform(object me)
{
if ( me->query_skill("puti-zhi",1)<100 )
        return notify_fail("你的"+to_chinese("puti-zhi")+"等级不足"+100+"级，无法使出"+name()+"。\n");
if ( me->query("class")!="xian" && !me->samsara_check("puti-zhi") )
        return notify_fail(name()+"是仙界不传之技。\n");
if ( me->query("force") < 100 )
        return notify_fail("你的真气不足 100 点，不能使出"+name()+"。\n");
if ( me->query("max_force") < 800 )
        return notify_fail("你的内力修为不足 800 点，不能使出"+name()+"。\n");
return 1;
}       
        
int perform(object me, object target)
{
string msg;
int ap,dp,lvl;

if ( !valid_perform(me) )
        return 0;
if ( !target ) target = offensive_target(me);
if ( !target
  || !target->is_character()
  || !me->is_fighting(target) )
        return notify_fail(name()+"只能对战斗中的对手使用。\n");
if ( !me->is_fighting() )
        return notify_fail(name()+"必须战斗中使用。\n");
if ( target->is_busy() )
        return notify_fail(target->name()+"已经够忙的了。\n");

ap = me->query("level");
ap+= me->query_skill("puti-zhi",1);
ap/= 5;
if ( ap<1 )  ap = 1;
dp = target->query("level");
dp+= (target->query_skill("dodge",1)+target->query_skill("parry",1))/2;
dp/=5;
if ( dp<1 )  dp = 1;
if ( COMBAT_D->restrain(me,target) )
        ap+= random(ap/3);
if ( COMBAT_D->restrain(target,me) )
        dp+= random(dp/3);
if ( !userp(me) )
        ap+= random(ap/5);      
if ( !userp(target) )
        dp+= random(dp/5);
if ( me->query("family/family_name")=="方寸山三星洞" )
        ap+= random(ap/3);
if ( target->query("family/family_name")=="方寸山三星洞" )
        dp+= random(dp/3);
if ( wizardp(me) )
        tell_object(me,"ap = "+ap+"    dp = "+dp+"\n");
if ( wizardp(target) )
        tell_object(target,"ap = "+ap+"    dp = "+dp+"\n");
                        
message_vision(HIC"\n$N"HIC"脸色忽转肃穆，右手中指朝向$n"HIC"缓缓
点出，正是惊天地、泣鬼神的惊魔一指！\n" NOR,me,target);
if ( random(ap+dp)>dp )
        {
        if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
                message_vision(HIG"$n"HIG"只觉一股劲力直透肩井穴，顿时全身一麻，动弹不得！\n"NOR,me,target);
        lvl = me->query_skill("puti-zhi",1)/30;
        if (lvl>5) lvl=5;
        target->start_busy(1+random(lvl));
        if ( me->query("family/family_name")!="方寸山三星洞" && !me->samsara_check("puti-zhi",1))
                me->start_busy(random(2));
        }
else    {
        if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
                message_vision(HIY"可是$n"HIY"似乎看破了$N"HIY"的企图，险险躲过了这一招。\n" NOR,me,target);
        me->start_busy(2);
        }
me->add("force",-100);
return 1;
}

int help(object me)
{
string temp;    
temp = "\t\t"+to_chinese("puti-zhi")+" 100 级\n";
temp+= "\t\t真    气 100 点\n";
temp+= "\t\t内力修为 800 点\n";
temp+= "\t\t战斗状态下使用\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");
write(@HELP

        使用功效：
                使敌人最多busy 5 秒的特殊技
        出招类型：
                使敌定身型外功
                带有隐藏攻击
                可以叛师带出
        出手要求：              
HELP);                          
write(temp);
return 1;
}
