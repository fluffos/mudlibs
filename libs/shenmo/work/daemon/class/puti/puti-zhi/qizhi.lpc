//菩提本无树，明镜亦非台；本来无一物，何处惹尘埃！
//改编自fs2
//create by huarong 2003.12
#include <ansi.h>
inherit SSERVER;
int perform(object me, object target) {
  int damage, skill, myexp, youexp, duration, myunarmed, youdodge, skilll;
  string msg, str;
  object ob = me->query_temp("weapon");
  string *name;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［气指］只能对战斗中的对手使用。\n");

  if (me->query_skill("wuxiangforce", 1) < 100)
    return notify_fail("你的小无相功不够纯熟，无法聚气指尖。\n");

  if (me->query("family/family_name") != "方寸山三星洞")
    return notify_fail("［气指］只有方寸山三星洞的门人才可以使用。\n");

  skill = (int)me->query_skill("blade", 1) / 2 + (int)me->query_skill("bingpo-blade", 1) / 2;

  if ((int)me->query("max_force") < 500)
    return notify_fail("你的内力不够！\n");
  if ((int)me->query("force") < 500)
    return notify_fail("你的内力不足！\n");
  if ((int)me->query("sen") < 100)
    return notify_fail("你的精神不足，没法子施用外功！\n");
  if ((int)me->query_skill("puti-zhi", 1) < 100)
    return notify_fail("你的菩提指级别还不够，使用这一招会有困难！\n");
  if ((int)me->query_skill("wuxiangforce", 1) < 100)
    return notify_fail("你的小无相功修为不够，使用这一招会有困难！\n");
  if (time() - (int)me->query_temp("qizhi_end") < 2)
    return notify_fail("绝招用多了就不灵了！\n");

  skill = ((int)me->query_skill("puti-zhi", 1) + (int)me->query_skill("wuxiangforce", 1)) * 2 / 3;
  skilll = (int)me->query_skill("puti-zhi", 1);
  myexp = me->query("combat_exp");
  youexp = target->query("combat_exp");
  myunarmed = me->query_skill("unarmed", 1);
  youdodge = target->query_skill("dodge", 1);
  duration = skill / 20;

  if (skilll >= 400) {
    message_vision(HIR "\n$N双手合十向前指去，使出菩提指法" + HIW + "--烈日诀--\n"
      +HIR + "霎时间$N" + HIR + "的护体真气逆流，一股至阳刚烈的真气充斥在$N" + HIR + "的手上\n"
      + "$N" + HIR + "的双掌散发出炙热的光芒，指尖聚集了无数颗的明亮的" + HIW + "光球" + HIR + "！\n\n" NOR, me, target);
    message_vision(HIR "\n$N" + HIR + "狂吼一声，无数的菩提指气向$n" + HIR + "射去！\n"
      +HIY + "    -------------------------------------------------------------*\n"
      + "    -------------------------------------------------------------*\n"
      + "    -------------------------------------------------------------*\n"
      + "    -------------------------------------------------------------*\n"
      + "    -------------------------------------------------------------*\n\n" NOR, me, target);
    damage = skill * 2 + random(skill);
  } else if (skilll >= 300) {
    message_vision(HIR "\n$N将双掌成虎形，使出菩提指法" + NOR + WHT + "--浩日诀--\n"
      +HIR + "$N" + HIR + "将十尺内的热气集中在双掌之内，只见$N" + HIR + "的双掌发出阵阵闷热的气劲\n"
      +HIR + "$N" + HIR + "双掌发光炙热，掌中聚集一颗明亮的" + HIW + "光球" + HIR + "！\n\n" NOR, me, target);
    message_vision(HIR "$N" + HIR + "双掌向前一推，掌中的菩提指气向$n" + HIR + "射出！\n"
      +HIY + "    -------------------------------------------------------------*\n"
      + "    =============================================================***\n"
      + "    -------------------------------------------------------------*\n\n" NOR, me, target);
    damage = skill + random(skill);
  } else if (skilll >= 200) {
    message_vision(HIR "\n$N" + HIR + "将手向天一指，运起菩提指法" + NOR + YEL + "--赤日诀--\n"
      +HIR + "$N" + HIR + "把太阳的光线集中在手中，一股至阳刚烈的内劲从丹田升起，\n"
      +HIR + "$N" + HIR + "全身发光炙热，指尖聚集一颗明亮的" + HIW + "光球" + HIR + "！\n\n" NOR, me, target);
    message_vision(HIR "$N" + HIR + "运劲指尖，一道菩提指气向$n" + HIR + "射去！\n" + HIY
      +HIY + "                                                      * *\n"
      + "    =====================================================* *\n"
      + "                                                      * *\n\n" NOR, me, target);
    damage = skill + random(skill / 2);
  } else {
    message_vision(HIR "\n$N" + HIR + "低吼一声，跃至空中使出菩提指法之" + HIY + "--旭日诀--\n"
      +HIR + "$N" + HIR + "在半空如太阳般散出至阳刚烈的真气，$N" + HIR + "将真气聚在掌上\n"
      +HIR + "真气的聚集使$N" + HIR + "的双掌炙热通红，发出辉眼光芒!!\n\n" NOR, me, target);
    message_vision(HIR "$N" + HIR + "运劲以足，将菩提指气从天空向$n" + HIR + "射去！\n" NOR, me, target);
    damage = skill / 2 + random(skill / 2);
  }
  me->add("kee", -100);
  me->add("force", -skill / 4);

  if (random(myexp + youexp) > youexp / 2) {
    message_vision(HIR "$n" + HIR + "躲避不及，被强大的指气击中，霎时烈火笼罩$n" + HIR + "全身！\n" NOR, me, target);
    //     target->apply_condition("burn",duration);
    damage -= target->query_temp("apply/armor_vs_force");
    if (damage < 0) damage = 0;

    target->receive_wound("kee", damage / 2 + random(damage / 2), me);
    target->receive_damage("kee", damage, me);
    if (wizardp(me) && me->query("env/combat") == "verbose")
      tell_object(me, sprintf(HIM + BLINK + "damage: %d\n" NOR, damage));
    COMBAT_D->report_status(target);
  } else if (random(myunarmed + youdodge) > youexp) {
    message_vision(HIG + "$n" + HIR + "虽运功避开，但仍受指气侵袭，只见$n" + HIG + "的伤口焦黑一块。\n" NOR, me, target);
    //       target->apply_condition("burn",duration);
    COMBAT_D->report_status(target);
  } else message_vision(HIB + "$n" + HIB + "看准来势，躲开了攻击。\n" NOR, me, target);

  me->start_busy(1 + random(1));
  me->set_temp("qizhi_end", time());
  return 1;
}
