#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name()
{
return "「"HIC"无相菩提"NOR"」";
}

int valid_perform(object me)
{
if ( me->query_skill("puti-zhi",1)<200 )
        return notify_fail("你的"+to_chinese("puti-zhi")+"等级不足"+200+"级，无法使出"+name()+"。\n");
        if ( me->query("family/family_name")!="方寸山三星洞" && !me->samsara_check("puti-zhi",1))
        return notify_fail(name()+"是方寸山不传之技。\n");
if ( me->query("force")<100 )
        return notify_fail("你的真气不足 100 点，不能使出"+name()+"。\n");
if ( me->query("max_force") < 800 )
        return notify_fail("你的内力修为不足 800 点，不能使出"+name()+"。\n");
if ( time()<me->query_temp("lingtai_pfm_puti")+5 )
        return notify_fail(name()+"需要五秒的冷却时间。\n");
return 1;
}       
        
int perform(object me, object target)
{
string *msg,*msg2,str;
int i,extra,lvl;
object weapon;

if ( !valid_perform(me) )
        return 0;    
if ( !target ) target = offensive_target(me);
if ( !target
  || !target->is_character()
  || !me->is_fighting(target) )
        return notify_fail(name()+"只能对战斗中的对手使用。\n");
if ( !me->is_fighting() )
        return notify_fail(name()+"必须战斗中使用。\n");
extra = me->query_skill("unarmed");
lvl = me->query_skill("puti-zhi",1);
lvl/= 150;
if ( lvl>7 )  lvl = 7;
if ( lvl<2 )  lvl = 2;
         
me->add("force_factor",extra/5);
me->add("force",extra*2);
me->add_temp("apply/attack",extra/10);
me->add_temp("apply/damage",extra/10);
me->add_temp("apply/dodge",extra/10);
me->add_temp("apply/unarmed",extra/10);
weapon = me->query_temp("weapon");

message_vision(HIR"\n\n$N"HIR"使出菩提指中的"+name()+HIR"，一招连环"+chinese_number(lvl)+"式向$n"HIR"攻出！\n"NOR,me,target);
me->set_temp("lingtai_pfm_puti",time());
msg = ({
        "上","下","左","右","前","后","最后",
});
msg2 = ({
        "天界邪仙歪道","阴曹饿魂怨鬼","人间不平之事",
        "此间拦路之人","此地碍事之徒","背后难防冷箭",
        "灵台之间吾见不平之事",
});     
for(i=0;i<lvl;i++)
        {
        if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
                message_vision(CYN"\n$N"CYN"口中唱道："+msg[i]+"一拳打倒"+msg2[i]+"\n"NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR);
        }
me->add("force_factor",-extra/5);
//防止fc过强，限制panlong 和puti 不可兼得nobusy, windy
if (( !me->query("叛师/num") || me->query("shilian")<1 ) && !me->samsara_check("puti-zhi",1))
me->start_busy(random(2));
me->add("force",-extra*2);
me->add_temp("apply/unarmed",-extra/10);
me->add_temp("apply/damage",-extra/10);
me->add_temp("apply/dodge",-extra/10);
me->add("force",-100);
if ( me->query("force")<=0 )
        me->set("force",0);
me->add_temp("apply/attack",-extra/10);
return 1;
}

int help(object me)
{
string temp;    
temp = "\t\t"+to_chinese("puti-zhi")+" 200 级\n";
temp+= "\t\t真    气 100 点\n";
temp+= "\t\t内力修为 800 点\n";
temp+= "\t\t战斗状态下使用\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");
write(@HELP

        使用功效：
                短时间内牺牲自身的灵活性来
                提升自己的攻击力量和速度以
                对敌人作出最多七次的连续攻
                击
        出招类型：
                延迟型外功
                无隐藏攻击
                不可以叛师带出
        出手要求：              
HELP);                          
write(temp);
return 1;
}
