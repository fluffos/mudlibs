#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string str;
  int extra;
  object weapon;
  extra = me->query_skill("wuying", 1);
  if (extra < 100) return notify_fail("你的无影剑法还不够纯熟！\n");
  if (time() - (int)me->query_temp("wuying_end") < 3)
    return notify_fail("此招不能使用太多！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［无极无影］只能对战斗中的对手使用。\n");
  if (me->query("family/family_name") != "武圣门")
    return notify_fail("不是武圣门的不能用「无极无影」！\n");
  if ((int)me->query("force") < 150)
    return notify_fail("你的内力不够。\n");
  me->add("force", -50);
  weapon = me->query_temp("weapon");
  message_vision(
    HIM "$N" HIM "使出无影剑法中的绝招" HIW "［无极无影］" HIM "，身形灵动，只见$N手中的" + weapon->name() + HIM "闪电般向$n打出第一剑波！\n\n" NOR,
    me,
    target
  );
  if (random((int)me->query_skill(
    "dodge",
    1
  ) / 2) > random((int)target->query_skill("dodge") / 5)) {
    COMBAT_D->do_attack(me, target, weapon);
    message_vision(HIB "「风起云涌」\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, weapon);
    message_vision(HIY "「电闪雷鸣」\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, weapon);
    message_vision(HIG "「雷振九天」\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, weapon);
    message_vision(HIR "「火烧连天」\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, weapon);
    message_vision(HIC "「云罩漫天」\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, weapon);
    message_vision(HIW "「无极无影」\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, weapon);
    COMBAT_D->do_attack(me, target, weapon);
    COMBAT_D->do_attack(me, target, weapon);
    COMBAT_D->do_attack(me, target, weapon);

    message_vision(WHT "$N连出七剑，结果$n被攻了个措手不及！\n" NOR, me, target);
    me->start_busy();
  } else {
    message_vision(HIC "可是$n看破了$N的招式,趁机发动进攻！\n" NOR, me, target);
    me->start_busy(random(1));
  }
  if (target->query("eff_kee") < 0 || (!living(target) && target->query("kee") < 0)) {
    str = target->name() + HIM "被" + me->name() + HIM "用武圣绝技" HIW "「无极无影」" HIM "杀死了，听说尸体已经被分解了！";
    //                         message("channel:rumor",HIM"〖无中生有〗某人："+str+"\n"NOR,users());
  }
  me->reset_action();
  me->set_temp("wuying_end", time());
  return 1;
}
