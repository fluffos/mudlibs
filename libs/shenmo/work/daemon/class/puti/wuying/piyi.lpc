#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
void wuying_ok(object); 
inherit SSERVER; 

void remove_effect(object me, int a_amount, int d_amount);
int perform(object me, object target)
{
        object weapon,ob;
        string str;
        int skill;
        int extra;
        string msg;
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("「"HIG"六军辟易"NOR"」只能在战斗中使用。\n");
if (!objectp(weapon = me->query_temp("weapon"))
                || (string)weapon->query("skill_type") != "sword")
              return notify_fail(" 你使用的武器不对，无法施展「"HIG"六军辟易"NOR"」。\n");
        if((int)me->query("sen") < 800 )
                return notify_fail("你的精神不足，没法子施用外功！\n");
        if(me->query("family/family_name")!="武圣门")
                return notify_fail("不是武圣门的不能用「六军辟易」！\n");
        if( (int)me->query_skill("wuying", 1) < 180 )
return notify_fail("你的无影剑不够娴熟，无法施展「"HIG"六军辟易"NOR"」。\n");
        if( (int)me->query("force") < 1000  ) 
                return notify_fail("你的内力不够。\n");
        if( (int)me->query("max_force") < 3000  ) 
                return notify_fail("你的内力不足，无法施展「"HIG"六军辟易"NOR"」。\n");
        if((int)me->query("combat_exp") < 1000000 )
                return notify_fail("你武学经验不够，领悟不到「"HIW"六军辟易"NOR"」！\n");
        skill = me->query_skill("wuying");
        extra = me->query_skill("wuying",1) / 2;
      extra += me->query_skill("wuying",1) ;
        me->add_temp("apply/attack", extra);    
        me->add_temp("apply/damage", extra);
        msg = HIW "\n$N长啸一声：教单于折箭，六军辟易，一招"HIG"「六军辟易」"HIW"瞬间幻出万马千军闪电般的向$n攻去！\n"NOR;
        message_vision(msg, me, target);
        me->set_temp("WYJ_perform", 1); 
        COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
        me->set_temp("WYJ_perform", 2); 
        COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
        me->set_temp("WYJ_perform", 3); 
        COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 

message_vision(HIG"$N虚空一抓，一股气流激荡指间，手中的兵器被这无形气劲牵扯，如山川大河，连绵不绝的攻向$n!\n"NOR,me,target); 
        me->set_temp("WYJ_perform", 4); 
        COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
        me->set_temp("WYJ_perform", 5); 
        COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 

        if( (int)me->query_skill("wuying", 1) > 250 ){
message_vision(HIM"   为谁开？茶花满路？\n"NOR,me,target); 
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR,msg);
}
        if( (int)me->query_skill("wuying", 1) > 260 ){
message_vision(HIW"   燕云十八骑，奔腾如虎风！\n"NOR,me,target); 
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR,msg);
}
        if( (int)me->query_skill("wuying", 1) > 270 ){
message_vision(HIG"   敝屣荣华，浮云生死，此身何惧！\n"NOR,me,target); 
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR,msg);
}
        if( (int)me->query_skill("wuying", 1) > 330 ){
message_vision(HIR"   王孙落魄，怎生消得，杨枝玉露？\n"NOR,me,target); 
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR,msg);
}
        if( (int)me->query_skill("wuying", 1) > 350 ){
message_vision(HIC"   却试问，几时把痴心？\n"NOR,me,target); 
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR,msg);
}
        if( (int)me->query_skill("wuying", 1) > 400 ){
message_vision(HIB"   红颜弹指老，刹那芳华。\n"NOR,me,target); 
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR,msg);
}
        if( (int)me->query_skill("wuying", 1) > 449 ){
message_vision(HIY"  王霸雄图，血海仇深，尽归尘土！\n"NOR,me,target); 
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR,msg);
}
 //                   if (target->query("eff_kee")<0 || !living(target))
{str=target->name()+"被"+""HIW""+me->name()+""HIM""+"用武圣门绝学『"HIW"六军辟易"HIM"』斩杀！听说尸体上尽是万马千军践踏的痕迹！";
       // message("channel:rumor",HIM"【雁门关外】某人："+str+"\n"NOR,users());
                       }
           me->start_busy(3+random(2));
         me->add("force", -500);
        me->set_temp("no_wuying",1);
        me->receive_damage("sen", 50+random(50));
        call_out("wuying_ok",5+random(3),me); 
        me->add_temp("apply/attack", -extra);
        me->add_temp("apply/damage", -extra);

        return 1;
}
void wuying_ok(object me)
{
if (!me) return; 
      me->delete_temp("no_wuying"); 
}
