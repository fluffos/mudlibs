// duo.c 「夺」字诀 by seawind
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SSERVER; 
int perform(object me, object target)
{
        string msg;

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("「夺」字诀只能对战斗中的对手使用。\n");

        if(target->is_busy() )
                return notify_fail(target->name() + "已在全力化解自已的招数，你可以放胆的击！\n");

        if(!target->query_temp("weapon"))
          return notify_fail("对方没有使用武器。\n");     

        if( (int)me->query_skill("fumobashi", 1) < 288 )
                return notify_fail("你的手法还不够娴熟，不会使用「夺」字诀。\n");

 if( (int)me->query("max_force") < 1500 )
                return notify_fail("你的内力不够！\n");

          if( (int)me->query_con() < 30 )
                  return notify_fail("「夺」字诀需要很高的内功，才能出奇不异的把对方的兵器夺下来，你的条件好象还不够。\n");

 msg = HIW"$N双手一振，双手已巧妙的搭在$n的兵器上，企图以伏魔八式「夺」字诀把$n的兵器夺下。\n"NOR;
        
        if( random(me->query("combat_exp")) > (int)target->query("combat_exp")/3*2 &&
        !(target->query_temp("weapon"))->query("no_get") &&
me->query("force") > target->query("force") && me->query("max_force")+200 > target->query("max_force")) {
                msg += HIY "\n结果$p的兵器被$P的双手巧妙的一压一带，$p兵器已被$P夺下！\n" NOR;
                (target->query_temp("weapon"))->move(me);
me->add("force", -580);
                  me->start_busy(2);
                target->start_busy(1);
        } 
        else{
                msg += "可是$p看破了$P的企图，并没有上当。\n" NOR;
                  me->start_busy(2);
 me->add("force", -240);
        }
        message_vision(msg, me, target);

        return 1;
}
