// dingshen.c 定身法
#include <ansi.h>

inherit SSERVER;

void free(object target);

int cast(object me, object target)
{
        string msg;
        int success, ap, dp, howlong;

        if( !target ) target = offensive_target(me);
        if(me->query("family/family_name")!="方寸山三星洞" && !me->samsara_check("dao",1))
          {
               return notify_fail("你不能用「定身术」！\n");
          }
        if((int)me->query_skill("spells") < 100)
                return notify_fail("你还没学会定身法。。。\n");

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你想把谁定住？\n");

        if ( time()<target->query_temp("no_move/start")+target->query_temp("no_move/time") )
                return notify_fail(target->query("name")+"已经动弹不得了！\n");

        if((int)me->query("mana") < 500 )
                return notify_fail("你的法力不够！\n");

        if((int)me->query("sen") < 10 )
                return notify_fail("你无法集中精力！\n");

        me->add("mana", -500);
        me->receive_damage("sen", 10);

        msg = HIC
"$N口中念了句咒文，朝$n一指，大喝一声：定！\n" 
NOR;

        success = 1;
        ap = me->query_skill("spells");
        ap = ap/10 * ap/10 * ap /10;
        ap += (int)me->query("daoxing")/100;
        dp = target->query("daoxing")/100;
        if( random(ap + dp) < dp*4/5 ) success = 0;
//here we compared exp and spells level. 
//note: has nothing to do with target's spells level.

        ap = (int)me->query("max_mana");
        dp = (int)target->query("max_mana");
        if( random(ap + dp) < dp*3/5 ) success = 0;
//here we compared max_mana.

        ap = (int)me->query("mana");
        dp = (int)target->query("mana");
        if( random(ap + dp) < dp*2/5 ) success = 0;
//here we compare current mana. this is important. you need recover to try again.

        if(((int)me->query("level")>(int)target->query("level") && me->query("spskk")==2) || me->query("spskkk")==1) success = 1;
        if(target->query("spskk")==3 || target->query("spskkk")==1) success = 0;
//这里检查转世特技

        howlong = 0;        
        if(success == 1 ){
                msg +=  HIR "结果$n手足僵硬，果然动弹不得！\n" NOR;
        
                howlong = 15 + random((me->query_skill("spells") -100))/3;
                if(howlong>300) howlong=300;
//a typical level is 100+100 ->enabled 150, so will "ding" about 1 minute in the best case.
                target->set_temp("no_move/start",time());
                target->set_temp("no_move/time",howlong);
        }           
        else {
                msg +=  HIR "结果$n被吓了一跳！\n" NOR; 
        } 

        message_vision(msg, me, target);

//he'll try kill you...
        if( living(target) ) target->kill_ob(me);

if (success == 0) {
return 1+random(2);
}

        if( howlong>0 ) call_out("free", howlong, target);
//        
        return 3+random(5);
}

void free(object target)
{
        if(target) target->delete_temp("no_move");      
        return;
}


