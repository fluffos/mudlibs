
#include <ansi.h>
#include <combat.h>

inherit SSERVER;

void feijian_ok(object);
void postfeijian(object,object,object,int);

string name()  
{
return "「"HIC"飞叉绝技"NOR"」";  
}

int valid_perform(object me)
{
      if (me->query_temp("no_feijian") )
          return notify_fail("你现在状态不佳，不能使用飞叉。\n");      
      if (me->query_skill("zhuanlong-force",1)<100)
          return notify_fail("你的内功太差，叉飞出去肯定飞不回来。\n");
      if (me->query_skill("yueya-fork",1)<100) 
          return notify_fail("你的叉法那么烂，当心把插自己身上。\n");
      if (me->query("force")<100)
           return notify_fail("你内力不继，难以驾御飞叉。\n");
 if (( me->query("family/family_name")!="乱石山碧波潭" || me->query("class")!="yao")&&!me->samsara_check("yueya-fork",1))
              return notify_fail("非我门人请勿乱用！\n");
return 1;  
}

int perform(object me, object target)
{
    mapping feijian= ([
       "damage": 300,
       "force": 300,
       "dodge" : -10,
       "parry" : -10,
       "damage_type" : "刺伤",
       "action" :  HIY"$w"+HIY"在空中一闪，毒蛇般向$n的$l刺去",
       "post_action" : (: postfeijian :)
    ]);

      object weapon=me->query_temp("weapon");
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

      me->add("force", -100);
      me->set("actions",feijian);
    message_vision(HIC"$N突然清啸一声，掌中"+weapon->query("name")+HIC"脱手而出，直向$n飞去！\n"NOR,me,target);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
      me->set_temp("no_feijian",1);
      call_out("feijian_ok",2+random(2),me);
      me->reset_action();
      return 1;
}

void feijian_ok(object me) {
      if (!me) return;
      me->delete_temp("no_feijian");
}         

void postfeijian(object me,object victim,object weapon, int damage) {
      if (damage>0 || damage==RESULT_DODGE)
         message_vision(HIW"$N用劲一带，"+weapon->query("name")+HIW"在空中打了个转，又回到手中。\n"NOR,me);
}
int help(object me)
{
string temp;
temp = "\t\t"+to_chinese("yueya-fork")+" 100 级\n";
temp+= "\t\t"+to_chinese("zhuanlong-force")+" 100 级\n";
temp+= "\t\t内力 100 点\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP

        使用功效：
                给对手强有力的一击
        出招类型：
                延时型外功 
                无隐藏攻击
                叛师不可带出
        出手要求：
HELP);
write(temp);
return 1;
}
