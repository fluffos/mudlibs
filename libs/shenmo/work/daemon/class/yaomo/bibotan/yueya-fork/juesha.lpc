//write by redrain
//2001.5.10

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
string name() {
  return "「" HIW "月牙绝杀" NOR "」";
}

int valid_perform(object me) {
  if ((int)me->query_skill("yueya-fork", 1) < 200)
    return notify_fail("你铲法不够娴熟。\n");
  if ((me->query("family/family_name") != "乱石山碧波潭" || me->query("class") != "yao") && !me->samsara_check(
    "yueya-fork",
    1
  ))
    return notify_fail("非我门人请勿乱用！\n");
  if ((int)me->query_skill("zhuanlong-force", 1) < 120)
    return notify_fail("你的内功修为不够。\n");
  if (me->query_temp("juesha_busy"))
    return notify_fail("你的内力消耗太大，等一会再用吧!\n");
  if ((int)me->query("force") <= 1200)
    return notify_fail("你内力不够，使用绝杀没什么威力！\n");
  return 1;
}

int perform(object me, object target) {
  string msg;
  int damage, def;
  object weapon;
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用！\n");

  weapon = me->query_temp("weapon");
  msg = HIW "\n$N气运丹田，脸色变的苍白，手中" + weapon->name() + HIW "带着呼呼风声对着$n狂扫而至！\n\n" NOR;
  message_vision(msg, me, target);
  if (random((int)me->query("combat_exp")) > (int)target->query("combat_exp") / 9) {
    msg = YEL "$n一愣，不自觉的被带了一个踉跄。" NOR;
    message_vision(msg, me, target);
    {
      msg = HIC "\n\n$N仰天长啸，一式" HIW "『绝杀九连』" HIC "奇快无比的向$n连续刺出九叉！\n" NOR;
      message_vision(msg, me, target);
      me->set("juesha", 5);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
      me->set("juesha", 6);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
      me->set("juesha", 7);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
      me->delete("juesha");
      me->add("mana", -50);
    }
  } else {
    msg = YEL "\n$n早已经看出$N的企图，没有上当。\n" NOR;
    message_vision(msg, me, target);
    me->add("force", -200);
  }
  me->set_temp("juesha_busy", 1);
  call_out("remove_effect", 4 + random(4), me);
  return 1;
}
void remove_effect(object me, object target) {
  string msg;
  if (!me) return;
  me->delete_temp("juesha_busy");
  message_vision(HIB "$N的内功运转一周天，脸色又恢复了红润。\n" NOR, me);

}
int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("yueya-fork") + " 200 级\n";
  temp += "\t\t" + to_chinese("zhuanlong-force") + " 120 级\n";
  temp += "\t\t内力 1200 点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效： 
                连续打击对手气血
        出招类型： 
                延时型外功 
                无隐藏攻击 
                叛师不可带出 
        出手要求：               
HELP);
  write(temp);
  return 1;
}
