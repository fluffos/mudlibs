#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name()  
{
return "「"HIW"寒潭飞花"NOR"」";  
}

int valid_perform(object me)
{
if( ( !me->query("family/family_name") || !me->query("class") || me->query("family/family_name") != "乱石山碧波潭" || me->query("class") != "yao" ) && !me->samsara_check("huaxue-blade",1))
        return notify_fail("只有碧波潭弟子才能使用"+name()+"！\n"); 
                
        if((int)me->query("max_force") < 1000 )
                return notify_fail("你的内力不够！\n");

	if((int)me->query("force") < 1000 )
		return notify_fail("你的内力不足！\n");

        if((int)me->query("sen") < (int)(me->query("max_sen")/2) )
                return notify_fail("你的精神不足，没法子施展寒潭飞花！\n");

if(me->query_skill("huaxue-blade", 1) < 180) 
                return notify_fail("你的化血刀法级别还不够。\n");
return 1;  
}

int perform(object me, object target)
{
        object weapon;
        int myskill,times, damage;
        string number;
        myskill = (int)me->query_skill("huaxue-blade", 1);  
        weapon = me->query_temp("weapon");
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
        if(!me->is_fighting())
                return notify_fail(name()+"只能在战斗中使用！\n");

            if(myskill <200){
                times = 3;        
                number = "三";}
            else
                if (myskill <250){
                    times = 4;
                    number = "四";}
                      else{ 
                           times = 5;
                           number = "五";}

        me->delete("env/brief_message");
	target->delete("env/brief_message");
	damage = me->query_str() + random(me->query_skill("zhuanlong-force"));

        damage+= me->query("level");
message_vision(HIC"\n$N一声长啸，"+ weapon->query("name")+ HIR"血光"HIC"一闪，一式"HIR"「寒潭飞花」"HIC"闪电般向$n攻出了"HIB""+number+""HIC"刀！\n"NOR,me,target);

        for(int i=1;i<=times;i++)
        COMBAT_D->do_attack(me, target, weapon);
        COMBAT_D->report_status(target, 0);
        me->receive_damage("sen", 20);
        me->add("force", -(times*50));

        if( target && !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }
        if(  target && me->is_fighting(target) && times>4 && weapon && me->query_temp("weapon") && weapon==me->query_temp("weapon") )
	{

              message_vision(HIR"\n$n一愣，已被$N的"+ weapon->query("name")+"砍得面目全非！\n" NOR,me,target);
                target->receive_damage("sen",damage,me);
                target->receive_wound("sen", random(damage), me);
                target->receive_damage("kee",damage+1,me);
                target->receive_wound("kee", random(damage), me);
                  			
		COMBAT_D->report_status(target, 0);
	}
        me->start_busy(2);
        return 1;
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("huaxue-blade")+" 120 级\n"; 
temp+= "\t\t内力 1000 点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                连续打击对手气血
        出招类型： 
                busy型外功 
                有隐藏攻击 
                叛师不可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
