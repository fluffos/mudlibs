
// modify by windy 06/05/16
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIR"血海飘香"NOR"」";  
}

int valid_perform(object me)
{
if (me->query("family/family_name") != "乱石山碧波潭" && me->query_skill("huaxue-blade",1) < 350) 
        return notify_fail("你还不够资格使用"+name()+"！\n"); 
if ( me->query("class")!="yao" && !me->samsara_check("huaxue-blade") )
        return notify_fail("你还不够资格！\n"); 
if(me->query_skill("huaxue-blade", 1) < 120) 
        return notify_fail("你的化血刀法修为太差，难以施展"+name()+"！\n"); 
if(me->query_skill("blade", 1) < 120) 
        return notify_fail("你的基本刀法修为太差，难以施展"+name()+"！\n"); 
if(me->query_skill("force", 1) < 120) 
        return notify_fail("你的内功心法修为太差，难以施展"+name()+"！\n"); 
if( time()-(int)me->query_temp("huaxue_end") < 3+random(3) ) 
        return notify_fail("你都杀红眼了，小心走火入魔！\n"); 
if((int)me->query("max_force") < 800 ) 
        return notify_fail("你的内力修为不够！\n"); 
if((int)me->query("force") < 200 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
string dodskill,msg;
int extra, damage;
int tmp;
object weapon;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

extra = me->query_skill("huaxue-blade",1)/4;
extra+= me->query_skill("blade",1)/4;
extra+= me->query("level")/4;
weapon = me->query_temp("weapon");
damage=extra*2 + me->query("force_factor");
damage+=me->query_skill("zhuanlong-force", 1);
if (me->query("family/family_name") == "乱石山碧波潭")
damage=damage+random(damage);

message_vision(HIC "\n$N一声清啸，气运丹田，围绕$n"HIC"疾转，手中"+weapon->query("name")+HIC"闪出无数血红的刀光！\n"NOR,me,target); 
message_vision(HIR "$n"HIR"顿觉四周眼花缭乱，仿佛置身于重重血海之中......\n\n"NOR,me,target); 
me->add_temp("apply/attack", extra);
me->add_temp("apply/damage", extra);
message_vision( HIY  "<<<>>>"RED"血光一现！\n" NOR,me,target);
COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
message_vision( HIY  "<<<<<<>>>>>>"RED"鲜血迸溅！\n" NOR,me,target);
COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
message_vision( HIY  "<<<<<<<<<>>>>>>>>>"RED"血雨腥风！\n" NOR,me,target);
COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
message_vision( HIY  "<<<<<<<<<<<<>>>>>>>>>>>>"RED"血流成河！\n" NOR,me,target);
COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
if (random(me->query("level")) > target->query("level")/4 && (me->query_skill("huaxue-blade",1)>599 || me->query("family/family_name")=="乱石山碧波潭"))
        {
        message_vision(WHT"却见$N突然身形一顿，人刀合一，带着一丝淡淡的血光，穿向$n"WHT"......\n"NOR,me,target); 
        target->receive_damage("kee", damage, me);
        target->receive_wound("kee", damage*3/4, me);
        COMBAT_D->report_status(target);
        me->add("force", -100);
        }
me->add_temp("apply/attack", -extra);
me->add_temp("apply/damage", -extra);
me->set_temp("huaxue_end", time());
me->add("force", -100);
return 1;
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("huaxue-blade")+" 120 级\n"; 
temp+= "\t\t"+to_chinese("blade")+" 120 级\n"; 
temp+= "\t\t"+to_chinese("force")+" 120 级\n"; 
temp+= "\t\t内力修为八年\n"; 
temp+= "\t\t内力２００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                连续伤害敌人的气血
        出招类型： 
                延时型外功
                有隐藏效果
                叛师可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
