#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() {
  return "「" HIW "无边地狱" NOR "」";
}

int valid_perform(object me) {
  if (((me->query("family/family_name") != "陷空山无底洞"
    && me->query_skill("kugu-blade", 1) < 450)
    || me->query("class") != "yao") && !me->samsara_check("kugu-blade"))
    return notify_fail(name() + "只有无底洞门人才可以用！\n");
  if ((int)me->query("force") < 1000)
    return notify_fail("你内力不够，不能使用" + name() + "！\n");

  if ((int)me->query("max_force") < 2000)
    return notify_fail("你内力修为不够，不能使用" + name() + "！\n");
  if (me->query_skill("kugu-blade", 1) < 60)
    return notify_fail("你枯骨刀法还不够娴熟，施展不出" + name() + "。\n");
  return 1;
}

int perform(object me, object target) {
  string msg;
  int extra, lvl, lv;
  int i;
  object weapon;
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用！\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail(" 你使用的武器不对，无法施展" + name() + "。\n");

  extra = me->query_skill("kugu-blade", 1) / 3;
  extra += me->query("level") / 3;
  me->add_temp("apply/attack", extra);
  me->add_temp("apply/damage", extra);
  msg = HIR "$N" HIR "使出枯骨刀法的「无边地狱」，手中的" + weapon->name() + HIR "斜斜劈出，$n" HIR "顿觉呼吸一窒！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR);
  msg = HIW "$N刀光连闪，$n" HIW "周围鬼哭神号，恰似无边地狱！\n" NOR;
  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    message_vision(msg, me, target);
  lvl = 2 + (int)me->query_skill("kugu-blade", 1) / 100;
  if (lvl > 9) lvl = 9;
  if (lvl > 5 && me->query("family/family_name") != "陷空山无底洞" && !me->samsara_check(
    "kugu-blade",
    1
  )) lvl = 5;
  for (i = 0; i <= lvl; i++) {
    if (!target
      || !me->is_fighting(target))
      continue;
    msg = HIR "\n$N" HIR "劈出一刀！" NOR;
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(msg, me, target);
    COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR);
  }
  me->add_temp("apply/attack", -extra);
  me->add_temp("apply/damage", -extra);
  me->add("force", -100);
  me->start_busy(2);
  return 1;
}
int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("kugu-blade") + " 60 级\n";
  temp += "\t\t内力修为二十年\n";
  temp += "\t\t内力 1000 点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                连续打击对手气血
        出招类型：
                busy型外功
                无底洞弟子更能将其发挥得淋漓尽致
                叛师可带出
        出手要求：
HELP);
  write(temp);
  return 1;
}
