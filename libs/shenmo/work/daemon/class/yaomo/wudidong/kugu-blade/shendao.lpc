
// modify by windy 06/04/28
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIR"祭血神刀"NOR"」";  
}

int valid_perform(object me)
{
if (me->query("family/family_name") != "陷空山无底洞" && me->query_skill("kugu-blade", 1) < 350 )  
        return notify_fail("以你现在的修为还施展不出"+name()+"！\n");  
if ( me->query("class")!="yao" && !me->samsara_check("kugu-blade"))
        return notify_fail("你还不够资格！\n"); 
if (me->query_skill("kugu-blade", 1) < 100)
        return notify_fail("你枯骨刀法还不够娴熟，施展不出"+name()+"。\n");
if( time()-(int)me->query_temp("wdd_shendao") < 2+random(2) ) 
        return notify_fail("绝招用多就不灵了！\n"); 
if ((int)me->query("eff_kee") < (int)me->query("max_kee")/2)
        return notify_fail("以你目前的身体状态，还是不要冒险的好！\n"); 
if ((int)me->query("max_force") < 600)
        return notify_fail("你的内力修为不够！\n"); 
if((int)me->query("force") < 600 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
int damage;
string msg;
object weapon;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
if (!objectp(weapon = me->query_temp("weapon"))
|| (string)weapon->query("skill_type") != "blade")
        return notify_fail("你手中无刀，如何施展"+name()+"？\n");

msg = HIC "$N右手持刀向左肩一勒，一阵血珠溅满刀面，紧接着右臂抡出，一片血光裹住刀影向$n当头劈落！\n"NOR;
if ( random(me->query("combat_exp")/10000) > (int)target->query("combat_exp")/60000 )
        {
        msg += HIR"$n想侧身避让，但血刀如电，只觉眼前一阵血红，刀刃劈面而下，鲜血飞溅，惨声大嚎！\n"NOR;
        message_vision(msg, me, target);
        damage = random(me->query_skill("blade", 1)) + random(me->query("level")/2);
        me->add("force", -300);
        me->receive_wound("kee", me->query("kee")/20);
        target->receive_damage("kee", damage+random(damage));
        target->receive_wound("kee", damage);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        }
else    {
        me->receive_wound("kee", me->query("kee")/50);
        msg += HIY"可是$n侧身避让，不慌不忙，躲过了$N的血刀。\n"NOR;
        message_vision(msg, me, target);
        me->add("force", -200);
        }
me->set_temp("wdd_shendao",time());
return 1;
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("kugu-blade")+" 100 级\n"; 
temp+= "\t\t内力修为六年\n"; 
temp+= "\t\t内力６００点\n"; 
temp+= "\t\t气血上限５０％以上\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                牺牲自己的少量气血强力伤敌
        出招类型： 
                延时型外功
                无隐藏攻击
                叛师可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
