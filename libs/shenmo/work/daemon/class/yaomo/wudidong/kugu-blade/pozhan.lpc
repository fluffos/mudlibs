
// modify by windy 06/04/28
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"CYN"破绽百出"NOR"」";  
}

int valid_perform(object me)
{
if ( me->query("family/family_name") != "陷空山无底洞" && me->query_skill("kugu-blade", 1) < 350 )  
        return notify_fail("以你现在的修为还施展不出"+name()+"！\n");  
if ( me->query("class")!="yao" && !me->samsara_check("kugu-blade"))
        return notify_fail("你还不够资格！\n"); 
if (me->query_skill("kugu-blade", 1) < 50)
        return notify_fail("以你现在枯骨刀法的修为，露破绽给人太危险了。\n");
return 1;  
}

int perform(object me, object target)
{
string msg;
int delay, myblade;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

myblade=(int)me->query_skill("kugu-blade",1);
delay=myblade/100;
if (delay<2)  delay=2;
if (delay>5)  delay=5;
if( target->is_busy() )
        return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧！\n");

msg = CYN "$N的招式突然一变，变得全无章法，浑身上下破绽百出，\n";
if( ((random(me->query("combat_exp"))/4*3 + (me->query("combat_exp")/2) > (int)target->query("combat_exp")/8*3 )))
    {
    msg += "$n想攻，却不知道哪个破绽是真，哪个是假。\n";
    msg += "结果$p被$P攻了个措手不及！\n" NOR;
    target->start_busy(delay);
    }
else    {
    msg += "可是$p看破了$P的企图，将计就计，顺着你的破绽攻了上来！\n" NOR;
    me->start_busy(2);
//命中率太高，此处作为不命中的惩罚。其他不变。windy。
    COMBAT_D->do_attack(target,me, target->query_temp("weapon"),TYPE_REGULAR,msg);  
    }
message_vision(msg, me, target);
return 1;
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("kugu-blade")+" 50 级\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                牵制对手
        出招类型： 
                busy型外功
                无隐藏攻击
                叛师可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
