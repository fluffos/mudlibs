#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{       
        string msg;
        int damage, ap, dp;

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me
        ||      !me->is_fighting(target)
        ||      !living(target))
                return notify_fail("你要对谁施展这一招"HIR"「妖魔三绝」"NOR"？\n");        

        if( (int)me->query_skill("blade", 1) < 200 
        ||  (int)me->query_skill("huntian-qigong", 1) < 150 
        ||  (int)me->query_skill("kugu-blade", 1) < 200)
                return notify_fail("你的功夫还不到家，用"HIR"「妖魔三绝」"NOR"太危险了。\n");
                
        if( (int)me->query("max_force") < 1200 )
                return notify_fail("以你现在的内功修为还使不出「妖魔」。\n");
                
        if( (int)me->query("force") < 1200 )
                return notify_fail("你的真气不够！\n");
 
     if ( me->query("叛师/num") )
        return notify_fail("你叛过师，无法使用\n");   
                
        if((string)me->query("family/family_name")!="陷空山无底洞")
                return notify_fail("你运了半天的内劲，就是用不出来。");

        me->start_busy(1);

        me->add("force", -100-(int)me->query("force_factor"));
        me->receive_damage("kee", 30);
        msg = HIC "\n$N微一凝神，运起混天气功，全身骨节发出一阵爆豆般的声响！\n" NOR;
        ap = (int)me->query("combat_exp");
        dp = target->query("combat_exp");
          if( ap > dp/2 )
        {           call_out("perform3", 0, me, target);
                    call_out("perform2", 0, me, target);
                    call_out("perform1", 0, me, target);
        }        
          else
                msg += HIC "\n没想到$N运力过度，一下瘫软在地上。\n" NOR;
                me->start_busy(3);
                
                message_vision(msg, me, target);
                if( damage > 0 ) 
                COMBAT_D->report_status(target);
      
                if( !target->is_fighting(me) ) 
                {
                        if( living(target) ) 
                        {
                                if( userp(target) ) target->fight_ob(me);
                                else target->kill_ob(me);
                        }
                }
                return 1;
}

//第一式
int perform1(object me, object target)
{
        int damage;
        string msg;
        
        msg = HIY "『腥风血雨』 \n"NOR;
        damage = (int)me->query("max_force") / 5 + random((int)me->query("eff_kee") *4);
damage = damage - (int)target->query("max_force") / 8 - random((int)target->query("eff_kee") *8);
        damage+=(int)me->query("force_factor")-random((int)target->query("force_factor"));
if( damage > 0 )
            {
                msg += HIC "$N左手扫出一阵狂风，掌中的刀夹杂着无数的血雨向$n扫来！\n" NOR;
                msg += HIC "$n被腥风带起的妖雾熏得睁不开眼，结果后腰被砍了个正着！\n" NOR;
                    target->receive_damage("kee", damage, me);
                    target->receive_wound("kee", damage/4, me);
                    me->improve_skill("kugu-blade", 1, 1);

            }
            else
            {
                    msg += HIR "$n不闪不避，轻而易举的化解了这招。\n" NOR;
                    me->improve_skill("blade", 1, 1);
            }
                 
        message_vision(msg, me, target);
        if( damage > 0 ) COMBAT_D->report_status(target);

        return 1;
}

// 第二式
int perform2(object me, object target)
{
        int damage;
        string msg;

        
        msg = HIY "『群魔乱舞』\n"NOR;
        if (random(5)>2)
                msg += HIC"\n$N手中幻出满天刀光，身行如飞，无声无息地转到$n的背后，猛剁向$n！\n"NOR;
        else
        msg += HIC"\n$N大喝一声，手上的刀卷起一阵狂风，风夹刀势吓得$n魂飞魄散！\n"NOR;

       if (me->query("combat_exp") > random(target->query("combat_exp"))*2)
        {
                msg += HIC "$n没能识破这招群魔乱舞，被捅了个透心凉！\n" NOR;
                me->add("force", -200);
                damage = (int)me->query_skill("kugu-blade", 1);
                damage = damage+(int)me->query_skill("blade", 1);
                damage = damage*2;
                damage = random(damage - (int)target->query_skill("parry", 1) - (int)target->query_skill("dodge", 1));
                target->receive_damage("kee", damage);
                target->receive_wound("kee", damage/4);
                me->improve_skill("kugu-blade", 1, 1);
                

        }
        else 
        {
                msg += HIR "$n满脸不屑，奚落道：区区雕虫小技，如何伤得了我？\n"NOR;
                me->improve_skill("blade", 1, 1);
        }
                 
        message_vision(msg, me, target);
        if( damage > 0 ) COMBAT_D->report_status(target);

        return 1;
}

//第三式
int perform3(object me, object target)
{
        int damage;
        string msg;
        
        msg = HIY "『血染长空』\n"NOR;
        if (random(5)>2)
        {
                msg += HIC "\n$N手一挥，顿时半空血云密布，一阵骷髅像狂风暴雨般的砸向了$n！\n"NOR;
       }
        else
        msg += HIC "\n$N手一挥，顿时半空血云密布，一阵骷髅像狂风暴雨般的砸向了$n！\n"NOR;

if (me->query_skill("kugu-blade",1) > random(target->query_skill("dodge",1)+target->query_skill("parry",1))*2)
        {
                msg += HIC "$n一鹤冲天，轻轻松松的躲过了风暴，但是正掉进了$N的圈套！\n" NOR;
                msg += HIC "$N一声暴喝，吃～我～～一～～～刀！\n" NOR;
                msg += HIC "$n在半空中，看见无数刀风袭来，绝望的发出了一声惨叫！\n" NOR;
                me->add("force", -300);
                damage = (int)me->query_skill("kugu-blade", 1);
                damage = damage+(int)me->query_skill("blade", 1);
                damage = random(damage*2);
                target->receive_damage("kee", damage);
                target->receive_wound("kee", damage/3);
                me->improve_skill("kugu-blade", 1, 1);
        }
        else 
        {
                msg += HIR "$n似乎早以晓得风雨其中有鬼，不闪不避，确也是安然无恙。\n"NOR;
                me->add("force", -300);
        }
        
        message_vision(msg, me, target);
        if( damage > 0 ) COMBAT_D->report_status(target);
        
        me->start_busy(2+random(2));
        return 1;
}
