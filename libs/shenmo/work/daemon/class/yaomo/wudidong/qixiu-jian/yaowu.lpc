
// modify by windy 06/04/24
#include <ansi.h> 
#include <combat.h> 
#include <condition.h> 
inherit SSERVER; 
string name()  
{
return "「"MAG"妖雾冲天"NOR"」";  
}

int valid_perform(object me)
{
if((me->query("family/family_name")!="陷空山无底洞" || me->query("class")!="yao")&&!me->samsara_check("qixiu-jian",1))
        return notify_fail("非鼠类不能用"+name()+"！\n"); 
if((int)me->query("max_force") < 1500 ) 
        return notify_fail("你的内力修为不够！\n"); 
if((int)me->query("force") < 500 ) 
        return notify_fail("你的内力不足！\n"); 
if((int)me->query_skill("qixiu-jian", 1) < 120) 
        return notify_fail("你的七修剑法修为还不够，使用这一招会有困难！\n"); 
if( time()-(int)me->query_temp("yaowu_end") < 4+random(2))  
        return notify_fail("你的内息尚未回转！\n");  
return 1;  
}
int perform(object me, object target)
{
object weapon; 
weapon=me->query_temp("weapon"); 
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if (!weapon || weapon->query("skill_type") != "sword"  )
        return notify_fail("你必须在使用剑时才能使用"+name()+"！\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
message_vision(MAG"\n$N阴阴一笑，手中的"+weapon->name()+""+MAG"轻轻一挥，登时飞沙走石，妖雾直冲天际！\n"NOR,me,target); 
me->set_temp("QXJ_perform", 6); 
COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
me->delete_temp("QXJ_perform"); 
me->add("force", -150); 
if (!me->query("env/innoxious") && random(me->query("level"))>target->query("level")/2 && target->query("spskk")!=10)
        {
        message_vision(HIR"$n一个不慎，被一团红雾迷了双眼！\n"NOR,me,target); 
        target->apply_condition("eyeill",20); 
        }
me->set_temp("yaowu_end",time());
return 1; 
}
int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("qixiu-jian")+" 120 级\n"; 
temp+= "\t\t内力修为十五年\n"; 
temp+= "\t\t内力５００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                给对手强有力的一击并可能使对手中毒
        出招类型： 
                延时型外功
                有隐藏攻击
                叛师不可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
