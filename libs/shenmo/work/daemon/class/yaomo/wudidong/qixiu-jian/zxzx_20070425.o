#include <ansi.h>

inherit SSERVER;
string name()  
{
return "「"RED"追腥逐血"NOR"」";  
}

int check_fight(object me, int amount, object weapon);
private int remove_effect(object me, int amount);
int valid_perform(object me)
{
if ( (int)me->query_skill("qixiu-jian", 1) < 180 )
        return notify_fail("你的七修剑法不够娴熟，不能使用"+name()+"。\n");
if ( (int)me->query_skill("sword", 1) < 150 )
        return notify_fail("你的基本剑法修为不够，不能使用"+name()+"。\n");
if((me->query("family/family_name")!="陷空山无底洞" || me->query("class")!="yao")&&!me->samsara_check("qixiu-jian",1))
        return notify_fail(name()+"只有无底洞门人才可以用！\n");
if ( (int)me->query_skill("huntian-qigong", 1) < 150 )
        return notify_fail("你的混天气功修为不够，不能使用"+name()+"。\n");
if ( (int)me->query("force") < 500 )
        return notify_fail("你现在内力太弱，不能使用"+name()+"。\n");
if ( (int)me->query_temp("wdd_zxzx") ) 
        return notify_fail("你已经在运功中了。\n"); 
if (me->query_skill_mapped("force") != "huntian-qigong")
        return notify_fail(name()+"必须配合混天气功才能使用。\n"); 
return 1;  
}

int perform(object me, object target)
{
object weapon = me->query_temp("weapon");  
int skill;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting() )
        return notify_fail(name()+"只能在战斗中使用。\n");

message_vision(HIR "$N把混天气功在体内运行一周，只觉浑身杀气腾腾，看谁都不顺眼。\n" NOR, me); 
me->add("force", -500);  
skill = me->query_skill("qixiu-jian");
me->add_temp("apply/damage",  skill/6);
me->set_temp("wdd_zxzx", 1);
check_fight(me, skill, weapon);
return 1;
}

int check_fight(object me, int amount, object weapon)
{  
object wep;    
if(!me) return 0;
wep = me->query_temp("weapon");  
if(!me->is_fighting() || !living(me) || me->is_ghost() || !wep || weapon != wep )
remove_effect(me, amount);
    else {
	call_out("check_fight", 1, me, amount, weapon);
        me->start_perform(1, "追腥逐血");
    }
return 1;
}

private int remove_effect(object me, int amount)
{
me->add_temp("apply/damage", -amount/6);
me->delete_temp("wdd_zxzx");
if(living(me) && !me->is_ghost())
tell_object(me, GRN"你将混天气功收回丹田。\n"NOR); 
return 0;
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("qixiu-jian")+" 180 级\n"; 
temp+= "\t\t"+to_chinese("huntian-qigong")+" 150 级\n"; 
temp+= "\t\t"+to_chinese("sword")+" 150 级\n"; 
temp+= "\t\t内力 500 点\n"; 
temp+= "\t\t必须激发混天气功\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                提升自己的攻击伤害力
        出招类型： 
                延时型外功
                无隐藏攻击 
                叛师不可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
