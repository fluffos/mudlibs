#include <ansi.h>
inherit SSERVER;

void check(object me);
void zxzx_effect(object me, object victim);
void remove_effect(object me);

string name()  
{
return "「"RED"追腥逐血"NOR"」";  
}

int valid_perform(object me)
{
if( me->query_skill("huntian-qigong",1) < 150 )
        notify_fail("你的混天气功修为不够。\n");
if( me->query_skill("sword",1) < 150 )
        return notify_fail("你的基本剑法未够纯熟。\n");
if( me->query_skill("qixiu-jian",1) < 160 )
        return notify_fail("你的七修剑未够纯熟。\n");
if (me->query_skill_mapped("force")!="huntian-qigong")
        return notify_fail(name()+"必须配合混天气功才能使用。\n");
if(me->query("family/family_name") != "陷空山无底洞" || me->query("class")!="yao")
        return notify_fail(name()+"是陷空山无底洞不传之密！\n");     
if( (int)me->query("force") < 250 )     
        return notify_fail("你的内力不够。\n");
return 1;  
}

int perform(object me)
{
int skill;
int sword_skill,qixiu_skill;
skill = me->query_skill("huntian-qigong",1);
if( skill > 250 ) skill=250;
sword_skill= me->query_skill("sword",1);
qixiu_skill= me->query_skill("qixiu-jian",1);

if ( !valid_perform(me) )
        return 0;
if( me->query_temp("zxzx") && me->query_skill("qixiu-jian",1)<600) 
        {remove_effect(me);return 1;}
if( me->query_temp("zxzx") && me->query_skill("qixiu-jian",1)>599) 
        return notify_fail("你已经在运功中了。\n");
if( time()-(int)me->query_temp("zxzx_end") < 10 )
        return notify_fail("你现在真气不纯！\n");       
        me->add("force", -skill);
        message_vision(HIR "$N把混天气功在体内运行一周，只觉浑身杀气腾腾，看谁都不顺眼。\n" NOR, me);
        me->set_temp("zxzx", 1);
              skill=random(skill);
              if (skill>120) skill=120;
              if (skill<20) skill=20;
        me->set_temp("zxzx_time",skill);
              
                   
        call_out("check", 1, me);
           call_out("remove_effect",skill/5,me);
        return 1;
}


void check(object me)
{       
        object weapon;
        
         if(!me) return;
                
         if (me->query_skill_mapped("force") != "huntian-qigong"
                 || !objectp(weapon=me->query_temp("weapon")) 
                 || (weapon->query("apply/skill_type") != "sword" 
                     && weapon->query("skill_type") != "sword" ) 
                 ||  me->query_skill_mapped("sword") != "qixiu-jian" )     
             remove_effect(me);
         else if(me->query_temp("zxzx_time")<1)
             remove_effect(me);                 
         else {  me->add_temp("zxzx_time",-1);
                call_out("check", 1, me);
              }
                     
}


void remove_effect(object me)
{
        if(!me) return;
        remove_call_out("check");
        me->delete_temp("zxzx");
        me->set_temp("zxzx_end",time());
        tell_object(me, GRN"你将混天气功收回丹田。\n"NOR);
}

void zxzx_effect(object me, object victim)
{   
int damage,ini_damage_apply;
string str;

if ( !me || !victim || !me->is_fighting(victim) || !living(victim) )
            return;
if ( random(23)>19 && me->query("yumo_agree")!=1 )
        { 
        me->add_temp("zxzx",1);
        message_vision(HIR"\n$N一剑中敌，双目精光四谢，发狂般向$n又攻出一招！\n"NOR,me,victim);
        damage = COMBAT_D->do_attack(me, victim, me->query_temp("weapon"));         
        if( damage > 100 && random(3)>1)
                {
                message_vision(HIR"\n$N看到敌人伤口上滴着的血，状近疯狂，居然在不可能的情况下又再攻出一招！\n"NOR,me);
                COMBAT_D->do_attack(me, victim, me->query_temp("weapon"));         
                }
        me->add_temp("zxzx",-1);
        }
else if ( random(23)>16 && me->query("yumo_agree")==1) 
        {
        message_vision(HIG"\n$N激战中突然灵光一现，恍然顿悟，原来这玉魔剑法的最高剑意便是「逍遥」二字！\n"NOR,me);
        if ( !me->query("env/no_msg") && !victim->query("env/no_msg") )   message_vision(HIG"\n念及此处，往日练剑时的种种困惑立时迎刃而解。$N狂喜之下，剑光暴长，疾电般向$n刺去！\n"NOR,me,victim);
        damage = COMBAT_D->do_attack(me, victim, me->query_temp("weapon"));
        if( damage > 100 && random(3)>1)
                {
                message_vision(HIW"\n$N心剑相通，无所顾忌，只觉得不管是拳脚刀棒皆可为剑，招数连绵不绝，应手而出，三丈之内剑气纵横！\n"NOR,me);
                me->add_temp("apply/damage", 100);
                COMBAT_D->do_attack(me, victim, me->query_temp("weapon")); 
                me->add_temp("apply/damage", -100);
                }
        }
}
 
int help(object me)
{
string temp;
temp = "\t\t"+to_chinese("qixiu-jian")+" 160 级\n";
temp+= "\t\t"+to_chinese("sword")+" 150 级\n";
temp+= "\t\t"+to_chinese("huntian-qigong")+" 150 级\n";
temp+= "\t\t内力 250 点\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP

        使用功效：
                进入嗜血发狂状态
        出招类型：
                延时型武功
                有隐藏效果
                叛师不可带出
        出手要求：
HELP); 
write(temp);
return 1;
}
