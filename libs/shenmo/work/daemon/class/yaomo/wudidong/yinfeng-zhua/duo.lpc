// duo.c 空手入白刃
#include <ansi.h>
inherit SSERVER;

string name() {
  return "「" HIW "空手入白刃" NOR "」";
}

int valid_perform(object me) {
  if (me->query_temp("duo"))
    return notify_fail("你已经在夺敌人的兵刃了。\n");
  if (me->query("family/family_name") != "陷空山无底洞" && !me->samsara_check("yinfeng-zhua", 1))
    return notify_fail("你不是老鼠家族的，不能用空手入白刃\n");
  if (me->query_skill("yinfeng-zhua", 1) < 80)
    return notify_fail("你的阴风爪不足" + 80 + "级, 不能空手入白刃！\n");
  if (me->query("force") < 200)
    return notify_fail("你的内力不足" + 200 + "点，无法空手入白刃！\n");
  return 1;
}

int perform(object me) {
  string msg;
  object weapon, weapon2, target;
  int skill, dp, damage;

  me->clean_up_enemy();
  target = me->select_opponent();

  if (!valid_perform(me))
    return 0;
  if (!me->is_fighting())
    return notify_fail("空手入白刃只能对战斗中的对手使用。\n");
  if (!objectp(target->query_temp("weapon")))
    return notify_fail("对方没有兵刃，你不用担心。\n");
  skill = me->query_skill("yinfeng-zhua", 1);
  weapon2 = target->query_temp("weapon");
  msg = CYN "$N" CYN "凝神闭息，打算施展空手入白刃的绝技. \n";
  message_vision(msg, me);
  dp = target->query_skill("parry") / 3;
  if (dp < 1)
    dp = 1;
  if (random(skill) > dp) {
    if (userp(me))
      me->add("force", -80);
    msg = "$N突然手臂暴涨, $n顿时觉得眼前一花，手腕一麻，手中兵刃脱手而出！\n" NOR;
    if (!target->is_busy())
      target->start_busy(2);
    if (weapon2->query("no_get") || weapon2->query("no_drop") || weapon2->query("warcity"))
      destruct(weapon2);
    else
      weapon2->move(me);
    me->start_busy(random(2));
  } else {
    msg = "可是$n的看破了$N的企图，立刻采取守势，使$N没能夺下兵刃。\n" NOR;
    me->start_busy(random(2));
  }
  message_vision(msg, me, target);
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("yinfeng-zhua") + " 80 级\n";
  temp += "\t\t内力 200 点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                夺取对方武器，并能牵制对手
        出招类型：
                妖族武功
                busy型外功
                无隐藏攻击
                叛师不可带出
        出手要求：              
HELP);
  write(temp);
  return 1;
}
