// sandu.c 阴风爪散毒 edited by peaceful

#include <ansi.h>

inherit SSERVER;
string name()  
{
return "「"HIB"阴风散毒"NOR"」";  
}

int valid_perform(object me)
{
	if( !(int)me->query_condition("poison_sandu"))
		return notify_fail("你现在没毒可散。\n");

	if( environment(me)->query("no_fight") )
		return notify_fail("这里不能攻击别人! \n");



	if( (int)me->query_skill("huntian-qigong", 1) < 180 )
		return notify_fail("你的混天气功大法不够娴熟，不能散毒。\n");

	if( (int)me->query_skill("yinfeng-zhua", 1) < 180 )
		return notify_fail("你的阴风爪不够娴熟，不能散毒。\n");

if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
return 1;  
}

int perform(object me, object target)
{
        string msg;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 

        msg = HIB "只听得$N的骨节格格作响，$N的手猛地长了半尺，居然一把抓住$n"HIB"手
腕，将毒质运于手心，源源不断传入$n"HIB"体内。\n";

	me->start_busy(1);
	if( random( (int)me->query_skill("yinfeng-zhua",1))
          > random(target->query_skill("dodge") ) ) {
		msg += CYN " 结果$p无力挣扎，$P的本身阴毒不断散入$n体内！\n" NOR;
            target->receive_damage("kee",200);
            target->receive_wound("kee",100 + random(80));
            target->apply_condition("poison_sandu", 1000);
            me->clear_condition();
            target->start_busy(random(2));
	} else {
		msg += "可是$p急提内力奋力一震，将$N的手震了开去。\n" NOR;
		me->start_busy(3);
	}
	message_vision(msg, me, target);
	if( !target->is_killing(me) ) target->kill_ob(me);
	return 1;
}

int help(object me)
{
string temp;
temp = "\t\t"+to_chinese("yinfeng-zhua")+" 180 级\n";
temp+= "\t\t"+to_chinese("huntian-qigong")+" 180 级\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 
            使用功效：
                将自身毒质散于对手体内
            出招类型：
                妖族武功
                busy型外功
                无隐藏攻击
                叛师可以带出
            出手要求：
HELP);   //必须顶格写，格式要求
write(temp);
return 1;
}
