#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() {
  return "「" HIR "唯我独尊" NOR "」";
}

int valid_perform(object me) {
  if (me->query("family/family_name") != "陷空山无底洞" && !me->samsara_check("yinfeng-zhua", 1))
    return notify_fail(name() + "只有无底洞门人才可以用！\n");
  if (me->query_skill("yinfeng-zhua", 1) < 100)
    return notify_fail("你阴风爪还不够娴熟，施展不出" + name() + "。\n");
  if (me->query_skill("huntian-qigong", 1) < 100)
    return notify_fail("你混天气功还不够娴熟，施展不出" + name() + "。\n");
  if (time() - (int)me->query_temp("duzun_end") < 3 + random(2))
    return notify_fail("你现在内息不畅！\n");
  if ((int)me->query("max_force") < 1000)
    return notify_fail("你内力修为不够，不能使用" + name() + "！\n");
  if ((int)me->query("force") < 300)
    return notify_fail("你内力不够，不能使用" + name() + "！\n");
  return 1;
}

int perform(object me, object target) {
  int myexp, yourexp, myskill, yourskill, mylvl, yourlvl;
  int damage, def;
  string msg;

  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用！\n");

  myexp = (int)me->query("combat_exp");
  yourexp = (int)target->query("combat_exp") / 5;
  myskill = me->query_skill("yinfeng-zhua", 1);
  yourskill = target->query_skill("dodge") / 5;
  mylvl = me->query("level");
  yourlvl = target->query("level") / 5;
  msg = RED "\n$N双目尽赤，使出阴风爪之禁招「唯我独尊」，双爪奋力向$n" RED "天灵盖戳下！\n" NOR;

  if (random(myexp) > yourexp && random(myskill) > yourskill && random(mylvl) > yourlvl) {
    msg += HIR "\n只听「喀啦」一声，竟是骨折的声音，$n" HIR "的头顶多了五个血色指洞！\n" NOR;
    damage = (int)target->query("max_kee") / 4;
    def = (int)target->query_temp("apply/armor_vs_force");
    damage -= damage * def / 3000;
    if (damage < 300) damage = 300;
    target->receive_damage("kee", damage, me);
    target->receive_wound("kee", damage / 2, me);
    target->receive_wound("sen", damage / 4, me);
  } else {
    msg += HIY "可是$p" HIY "纵身躲过了$P的全力一击！！！\n" NOR;
  }
  me->set_temp("duzun_end", time());
  message_vision(msg, me, target);
  me->add("force", -300);
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("yinfeng-zhua") + " 100 级\n";
  temp += "\t\t" + to_chinese("huntian-qigong") + " 100 级\n";
  temp += "\t\t内力修为十年\n";
  temp += "\t\t内力３００点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                给对手的气血和精神全力一击
        出招类型：
                延时型外功
                无隐藏攻击
                叛师不可带出
        出手要求：              
HELP);
  write(temp);
  return 1;
}
