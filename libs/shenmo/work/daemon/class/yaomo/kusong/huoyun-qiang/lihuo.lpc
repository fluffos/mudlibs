
// modify by windy 06/05/15
#include <ansi.h> 
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIR"离火三重"NOR"」";  
}

int valid_perform(object me)
{
if((me->query("family/family_name")!="火云洞" || me->query("class")!="yao") && !me->samsara_check("huoyun-qiang",1))
        return notify_fail("非火云洞弟子不能用"+name()+"！\n"); 
if(me->query_skill("huoyun-qiang", 1) < 120) 
        return notify_fail("你的火云枪修为还不够，使用这一招会有困难！\n"); 
if(me->query_skill("huomoforce", 1) < 120) 
        return notify_fail("你的火魔心法修为还不够，使用这一招会有困难！\n"); 
if( time()-(int)me->query_temp("lihuo_end") < 3+random(3))  
        return notify_fail("你的周身已经火光重重！\n");  
if((int)me->query("max_force") < 1000 ) 
        return notify_fail("你的内力修为不够！\n"); 
if((int)me->query("force") < 500 ) 
        return notify_fail("你的内力不足！\n"); 
if((int)me->query("sen") < 300 ) 
        return notify_fail("你的精神不足，没法子施用外功！\n"); 
return 1;  
}

int perform(object me, object target)
{
int extra; 
object weapon=me->query_temp("weapon"); 
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

message_vision(HIR"\n$N手中"+weapon->query("name")+HIR"的枪尖突然“砰”地炸出一团紫红色的火焰，绕着通红透亮的枪身燃烧起来！\n\n"NOR,me,target);

extra = me->query_skill("spear",1)/2;
extra+= me->query("level")/2;
me->add_temp("apply/attack", extra);
me->add_temp("apply/damage", extra);
if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
message_vision(HIR"\n“刷”地拉出一道火红中映着紫焰的流光，哗啦啦地就是一片遮天的火舌，往$n"HIR"的头上盖去！\n"NOR,me,target);
COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
message_vision(HIR  "\n$N全身真气外放，衣衫冉冉飘动，双眸倏转妖红！\n" NOR,me,target);
COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
message_vision(HIR  "\n$N手中"+weapon->query("name")+ HIR"内所有阳气已是内燃敛收，放出肉眼难以直视的青白光华！\n" NOR,me,target);
COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
me->add_temp("apply/attack", -extra);
me->add_temp("apply/damage", -extra);
me->add("force", -100); 
me->set_temp("lihuo_end",time());
return 1; 
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("huoyun-qiang")+" 120 级\n"; 
temp+= "\t\t"+to_chinese("huomoforce")+" 120 级\n"; 
temp+= "\t\t内力修为十年\n"; 
temp+= "\t\t内力５００点\n"; 
temp+= "\t\t精神３００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                连续打击对手的气血
        出招类型： 
                延时型外功
                无隐藏攻击
                叛师不可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
