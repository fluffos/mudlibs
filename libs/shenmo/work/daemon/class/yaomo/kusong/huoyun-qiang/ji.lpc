//modify by windy
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() {
  return "「" RED "祭枪" NOR "」";
}

int valid_perform(object me) {
  if ((me->query("family/family_name") != "火云洞" || me->query("class") != "yao") && !me->samsara_check("huoyun-qiang"))
    return notify_fail(name() + "只有火云洞门人才可以用！\n");
  if ((int)me->query_skill("huoyun-qiang", 1) < 100)
    return notify_fail("你的火云枪法火候不够，难以施展" + name() + "。\n");
  if ((int)me->query_skill("huomoforce", 1) < 100 && !me->samsara_check("huoyun-qiang"))
    return notify_fail(name() + "必须配合火魔心法才能使用。\n");
  if ((int)me->query("max_force") < 1000)
    return notify_fail("你的内力修为不够！\n");
  if ((int)me->query("force") < 1000)
    return notify_fail("你的内力不足！\n");
  if ((int)me->query("mana") < 1000)
    return notify_fail("你的法力不足，无法念咒语！\n");
  if ((int)me->query("sen") < 500)
    return notify_fail("你的精神不足，没法子施用外功！\n");
  if (time() - (int)me->query_temp("ji_end") < 2 + random(3))
    return notify_fail("绝招用多就不灵了！\n");
  return 1;
}

int perform(object me, object target) {
  object weapon;
  int damage;
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用！\n");

  weapon = me->query_temp("weapon");
  damage = me->query_skill("huoyun-qiang", 1);
  damage += me->query_skill("huomoforce", 1) / 2;
  damage += me->query_skill("spear", 1) / 2;
  damage += me->query("force_factor");
  if (random(me->query("level")) > target->query("level") / 2)
    damage += me->query("level");
  damage = damage / 2 + random(damage / 2);

  message_vision(HIR "\n只见$N向" + weapon->query("name") + HIR "上吐了口鲜血,大喝一声：祭枪！\n" NOR, me);
  if (random(me->query_skill(
    "spear",
    1
  ) + target->query_skill("spells", 1)) > target->query_skill("spells", 1)) {
    message_vision(RED "只见$n" RED "被$N一枪击中，胸前被划开一道长长的口子，血如箭般喷射而出！\n" NOR, me, target);
    target->receive_damage("kee", damage, me);
    target->receive_wound("kee", damage / 2 + random(damage / 2), me);
    COMBAT_D->report_status(target);
    me->add("force", -500);
    me->add("mana", -500);
  } else {
    message_vision(HIC "可是$n" HIC "急忙抽身躲开，$N这招没能得逞。\n" NOR, me, target);
    me->add("force", -200);
    me->add("mana", -200);
  }
  me->set_temp("ji_end", time());
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("huoyun-qiang") + " 100 级\n";
  temp += "\t\t" + to_chinese("huomoforce") + " 100 级\n";
  temp += "\t\t内力修为十年\n";
  temp += "\t\t内力１０００点\n";
  temp += "\t\t法力１０００点\n";
  temp += "\t\t精神５００点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP 

        使用功效： 
                给对手的气血造成严重伤害
        出招类型： 
                延时型外功
                无隐藏攻击
                叛师不可带出 
        出手要求：               
HELP);
  write(temp);
  return 1;
}
