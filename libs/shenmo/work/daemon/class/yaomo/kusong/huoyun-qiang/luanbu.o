
#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
	int mypot,tapot,time;

	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("「乱步」只有在战斗中才能使用。\n");
        if(me->query("family/family_name")!="火云洞")
                return notify_fail("你不是火云弟子！\n");
	if( (int)me->query_skill("moshenbu", 1) < 150 ) 
		return notify_fail("你的修为不够深，还使不出这一招！\n");
        if( (int)me->query_skill("huoyun-qiang", 1) < 150 ) 
		return notify_fail("你的修为不够深，还使不出这一招！\n");
        if(me->is_busy())
                return notify_fail("你太忙了！\n");;
	if( target->is_busy() )
		return notify_fail(target->name()+"已经够忙了，你使的再漂亮也不会注意到。\n");
        message_vision(HIR"$N按念真诀，四下游走，
$n就势直追，不想$N的脚步暗藏玄机，几个回落之后$n步伐大乱！\n\n"NOR,me, target);

	mypot=(int)me->query_skill("dodge");
	mypot=mypot*mypot*mypot/10 + (int)me->query("combat_exp");

	tapot=(int)target->query_skill("parry");
	tapot=tapot*tapot*tapot/10 + (int)target->query("combat_exp");

	time=(int)me->query_skill("moshenbu", 1) /10;
      if ( time > 4 ) time = 5;
        if ( time < 5  ) time = 3;

        if ( random( mypot + tapot ) > tapot/4 ) {
		message_vision(HIR"$N已经头晕脑转，现在正是可乘之机！\n"NOR,target);
		target->start_busy(time);
               
	}else {
		message_vision(HIW"$N不为所惑，原地接招！\n"NOR,target,me);
		me->start_busy(2);
	}

        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
                me->kill_ob(target);
        }
	return 1;
}
