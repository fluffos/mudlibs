#include <ansi.h>
inherit PERFORM;

void create()
{
set("name",HIC"祭枪"NOR);
set("class","yao");
set("belong","huoyun-qiang");
set("base_type","spear");
set("target",1);
set("force",1000);
set("need_force",200);
set("damage_type","eff_kee");
set("limit_skill",([
	"huoyun-qiang"      :          60,
]));
set("busy_self",(random(1)));
set("double_hit",([
        "num"           :       1,
        "temp"          :       "HYQ_perform", 
        "temp_num"      :       ({8}),          
        "me_del_env"    :       1,                      
        "t_del_env"     :       1,                      
]));
//set("busy_self",2);
set("temp","kusong/ji");
set("temp_time", 2+random(2));


}

void hit_msg(object me,object target,int num)
{
object weapon=me->query_temp("weapon");
if ( me && target &&num==1 )
   message_vision(HIR"\n只见$N向"+weapon->query("name")+HIR"上吐了口鲜血,大喝一声:祭枪！\n"NOR,me);
}

void double_hit_msg(object me,object target,int i) 
{ 
} 
void remove_eff(object me,string temp_busy)
{
	me->delete_temp(temp_busy);
}


int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("huoyun-qiang")+" 60 级\n"; 
temp+= "\t\t内力 200 点\n"; 
write(@HELP 
火云枪法 之 「祭枪」：

        使用功效： 
                给对手强有力的一击
        出招类型： 
                延时型武功
                无隐藏攻击 
                叛师可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
