//不动
//能将反 busy状态 50%

#include <ansi.h>
inherit F_CLEAN_UP;

string name()
{
return NOR"「"YEL"山之不动"NOR"」";
}        
 
int exert(object me)
{
int time;       
if ( me->query("family/family_name")!="火云洞")
        return notify_fail(name()+"乃是火云洞不传之密。\n");
if ( me->query_skill("force",1)<250 
  || me->query_skill("huomoforce",1)<250 ) 
        return notify_fail("你基本内功等级不足 ，施展不了"+name()+"。\n");
if ( me->query("force")<150 )      
        return notify_fail("你的内力不够了。\n");
if ( me->query("kee")<100 )
        return notify_fail("你的气血不够，恐怕施展"+name()+"有些危险。\n");    
if ( me->query_temp("hyd_budong") )
        return notify_fail("你已经在运功中了。\n");
time = me->query_skill("force",1);
time+= me->query_skill("huomoforce",1);
time+= me->query("force")/10;
time/= 30;
time = time/2+random(time/2);
if ( wizardp(me) )  tell_object(me,"time=="+time+"\n");
me->add("force", -150);
me->receive_damage("kee",100);
message_vision(HIY"$N"HIY"略一提气，运起"HIR+to_chinese("huomoforce")+HIY"，整个人身形立刻变得稳健起来。
只见$N"HIY"足下深陷石中，整个人挑起了东岳泰山的气势！\n" NOR, me);
me->set_temp("hyd_budong",1);
remove_call_out("check");
call_out("check",0,me,time);
return 1;
}

void check(object me, int time)
{
if ( !me )
        return;
time--;        
if ( !time ) 
        {
        message_vision(YEL"\n$N"YEL"周身内劲运作一周天，「不动」一式渐渐平息了下来。。。\n\n"NOR,me);   
        me->delete_temp("hyd_budong");
        return;
        }
if ( me->is_fighting() 
  && living(me) 
  && me->is_busy() )
        {
        if ( !me->query_temp("hyd_budong_check") )
                {
                message_vision(YEL"\n$N"YEL"大喝一声，周身内劲运作，动作立时变得顺畅起来！\n\n"NOR,me);
                me->start_busy(1,10000);
                me->interrupt_me(me,"不动");
                me->reset_action();
                me->add_temp("hyd_budong_check",1);
                }
        else    {
                me->delete_temp("hyd_budong_check");
                message_vision(HIR"\n$N"HIR"大喝一声，「不动」一式开始运行起来。\n\n"NOR,me);
                }
        }
me->delete_temp("hyd_budong_check");
remove_call_out("check");
call_out("check",0,me,time);
return ;
}

