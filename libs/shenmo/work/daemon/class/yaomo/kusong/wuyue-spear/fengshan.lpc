//modify by windy
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() {
  return "「" HIG "五岳封禅" NOR "」";
}

int valid_perform(object me) {
  if (!me) return 0;
  if (me->query("family/family_name") != "火云洞" && me->query_skill("wuyue-spear", 1) < 500)
    return notify_fail(name() + "乃是武成王黄飞虎之不传绝招。\n");
  if (me->query("class") != "yao" && !me->samsara_check("wuyue-spear"))
    return notify_fail("你还不够资格！\n");
  if (me->query_skill("wuyue-spear", 1) < 180)
    return notify_fail("你的" + to_chinese("wuyue-spear") + "修为太差，难以施展" + name() + "。\n");
  if (me->query_skill("spear", 1) < 180)
    return notify_fail("你的" + to_chinese("spear") + "修为太差，难以施展" + name() + "。\n");
  if (me->query_skill("literate", 1) < 180)
    return notify_fail("你的" + to_chinese("literate") + "修为太浅，难以领悟" + name() + "的奥妙。\n");
  if (me->query("max_force") < 2000)
    return notify_fail("你的内力修为不够，不能施展" + name() + "。\n");
  if (me->query("force") < 800)
    return notify_fail("你的内力不足，不能施展" + name() + "。\n");
  if (me->query("sen") < 300)
    return notify_fail("你的精神不足，不能施展" + name() + "。\n");
  return 1;
}

int perform(object me, object target) {
  object weapon, ob;
  string msg, str;
  int extra, damage, skill, k, mystr;

  if (!valid_perform(me))
    return 0;
  if (!target)
    target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || !me->is_fighting(target))
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用！\n");

  weapon = me->query_temp("weapon");
  ob = target->query_temp("weapon");
  str = "右臂";
  if (objectp(ob)) str = "手中的" + ob->query("name");
  extra = me->query_skill("literate", 1) / 4;
  extra += me->query_skill("spear", 1) / 4;
  extra += me->query_skill("huomoforce", 1) / 4;
  if (me->query("family/family_name") == "火云洞" || me->samsara_check("wuyue-spear", 1))
    extra += me->query("level") / 3;
  skill = me->query_skill("wuyue-spear", 1);
  k = (int)me->query_skill("literate");
  mystr = me->query_str();
  damage = extra;

  if (me->query("env/no_msg") || target->query("env/no_msg")) {
    msg = HIW "$N" HIW "对$n" HIW "使出了火云洞镇派绝技" + name() + HIW "！\n" NOR;
    message_vision(msg, me, target);
  }
  msg = HIC "$N神功妙悟，" + weapon->query("name") + HIC "砸出一式\n\n";
  msg += HIC "┏━━━━┓\n";
  msg += HIC "┃正气岱宗┃\n";
  msg += HIC "┗━━━━┛\n一股浩然正气已笼罩$n" HIC "全身！\n";
  me->add("force", -100);
  me->receive_damage("sen", 50);
  //me->add_temp("apply/attack", extra)
  //me->add_temp("apply/damage", extra);
  if (random(me->query("combat_exp")) > target->query("combat_exp") / 3) {
    target->receive_damage("kee", damage, me);
    target->receive_wound("kee", damage, me);
    msg += "$n" HIC "举起" + str + HIC "一架，不料枪风正气凛冽，微一迟疑。\n";
    msg += "$N枪势斗转，" + weapon->query("name") + HIC "发出摄人心魄的呼啸向$n" HIC "刺去！\n\n" NOR;
    msg += HIB "瞬间锋锐的枪尖已到了$n" HIB "的咽喉，\n";
  } else damage = damage + mystr * 2;
  //COMBAT_D->do_attack(me,target, me->query_temp("weapon"),1);

  msg += HIB "   ┏━━━━┓\n";
  msg += HIB "   ┃忠勇西岳┃\n";
  msg += HIB "   ┗━━━━┛\n这式犹如华山一条道直取$n" HIB "要害！\n";
  if (random(skill) > target->query_skill("parry", 1) / 4) {
    target->receive_damage("kee", damage, me);
    target->receive_wound("kee", damage / 2, me);
    msg += HIB "结果$n" HIB "咽喉一麻，差点喘不过气来。\n" NOR;
  } else damage = damage + mystr * 3;
  //COMBAT_D->do_attack(me,target, me->query_temp("weapon"),1);

  msg += HIW "\n紧跟着$N到转" + weapon->query("name") + HIW "尾刺向$n" HIW "的大腿，\n";
  msg += "同时长啸高吟“恒溪风流禅月明”——\n";
  msg += HIW "      ┏━━━━┓\n";
  msg += HIW "      ┃恒岭儒雅┃\n";
  msg += HIW "      ┗━━━━┛\n";
  msg += HIW "这式俊秀倜傥，结果$n" HIW "的腿部被划开深深的一道口子。\n" NOR;
  if (random(me->query("level")) > target->query("level") / 3) {
    target->receive_damage("kee", damage, me);
    msg += HIW "$n" HIW "紧闭双眼，胡乱拆招。\n" NOR;
  } else damage = damage + mystr * 4;
  //COMBAT_D->do_attack(me,target, me->query_temp("weapon"),1);

  msg += HIM "\n$N接着顺势连人带" + weapon->query("name") + HIM "撞向$n" HIM "，仿佛如椽巨笔饱墨临纸，";
  msg += HIM "令$n" HIM "肝胆俱裂！\n" NOR;
  msg += HIM "         ┏━━━━┓\n";
  msg += HIM "         ┃文章衡峰┃\n";
  msg += HIM "         ┗━━━━┛\n";
  msg += HIM "这式深得“如椽健笔意纵横”的神髓！\n" NOR;
  if (random(k) > target->query_skill("literate", 1) / 3) {
    target->receive_damage("kee", damage, me);
    target->receive_wound("kee", damage / 2, me);
    target->receive_damage("sen", damage, me);
    target->receive_wound("sen", damage, me);
    msg += HIM "结果$n" HIM "神智迷糊，差点晕倒。\n" NOR;
  } else damage = damage + mystr * 5;
  //COMBAT_D->do_attack(me,target, me->query_temp("weapon"),1);

  msg += HIY "\n$N枪意绵绵，" + weapon->query("name") + HIY "平平正正，直取中路刺向$n" HIY "，";
  msg += HIY "$n" HIY "不晓这招厉害，居然不知如何应付！\n" NOR;
  msg += HIY "            ┏━━━━┓\n";
  msg += HIY "            ┃平冲中庸┃\n";
  msg += HIY "            ┗━━━━┛\n";
  msg += HIY "这式登堂入室，把基本枪法的“中平”一式发挥到妙到毫巅！\n" NOR;
  if (random(me->query("max_force")) > target->query("max_force") / 3) {
    target->receive_damage("kee", damage, me);
    target->receive_wound("kee", damage, me);
    msg += HIR "结果“噗！”的一声，$n" HIR "胸口被搠出个大窟窿！\n" NOR;
  } else damage = damage + mystr * 6;
  //COMBAT_D->do_attack(me,target, me->query_temp("weapon"),1);

  if ((me->query("family/family_name") == "火云洞" || me->samsara_check("wuyue-spear")) && k > 399 && skill > 599 && !random(6) && random(me->query("kar")) > 25) {
    msg += HIG "\n$N脸上露出恐惧之色，" + weapon->query("name") + HIG "竟然不听使唤，";
    msg += "犹如妖魔控制一般，\n在枪意已尽，劲势已灭之际，又生新力，又续杀机，死神般活跃！\n" NOR;
    msg += HIG "┏━━━━━━━┓\n";
    msg += HIG "┃五岳归来不看山┃\n";
    msg += HIG "┗━━━━━━━┛\n";
    msg += HIG "这式受天上地下十万神魔诅咒过的一招，真是鬼泣神啼，天地顿时失色！\n" NOR;
    target->set_temp("last_damage_from", me);
    target->receive_wound("kee", 10, me);
    target->die();
    //COMBAT_D->do_attack(me,target, me->query_temp("weapon"),1);
  }
  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    message_vision(msg, me, target);

  //me->add_temp("apply/attack", -extra);
  //me->add_temp("apply/damage", -extra);
  me->start_busy(3 + random(3));
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("wuyue-spear") + " 180 级\n";
  temp += "\t\t" + to_chinese("spear") + " 180 级\n";
  temp += "\t\t" + to_chinese("literate") + " 180 级\n";
  temp += "\t\t内力修为二十年\n";
  temp += "\t\t内力８００点\n";
  temp += "\t\t精神３００点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP  

        使用功效：  
                连续打击对手的气血和精神
        出招类型：  
                busy 型外功 
                有隐藏攻击 
                叛师可带出  
        出手要求：    
HELP);
  write(temp);
  return 1;
}
