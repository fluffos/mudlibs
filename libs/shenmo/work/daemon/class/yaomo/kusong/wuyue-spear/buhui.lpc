
// modify by windy 06/10/15
#include <ansi.h> 
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIC"不悔"NOR"」";  
}

int valid_perform(object me)
{
//if ( me->query("family/family_name")!="火云洞"  && me->query("zhuanshi") == 0 )
//        return notify_fail("你是哪儿偷学来的武功，也想用"+name()+"？\n");
if ( !me->samsara_check("wuyue-spear",2)  && me->query("class")!="yao" )
        return notify_fail("你是哪儿偷学来的武功，也想用"+name()+"？\n");
if(me->query_skill("wuyue-spear", 1) < 350) 
        return notify_fail("你的五岳神枪修为尚浅，使用这一招会有困难！\n"); 
if(me->query_skill("spear", 1) < 350) 
        return notify_fail("你的基本枪法修为尚浅，使用这一招会有困难！\n"); 
if(me->query_skill("pingtian-dafa", 1) < 350 ) 
        return notify_fail("你的平天大法修为尚浅，使用这一招会有困难！\n"); 
if((int)me->query("max_force") < 1000 ) 
        return notify_fail("你的内力修为不够！\n"); 
if((int)me->query("force") < 500 ) 
        return notify_fail("你的内力不足！\n"); 
if((int)me->query("kee") < 300 ) 
        return notify_fail("你的气血不足，没法子施展外功！\n"); 
if((int)me->query("sen") < 100 ) 
        return notify_fail("你的精神不足，没法子施用外功！\n"); 
if ( me->query("叛师/num") )
        return notify_fail("你叛过师，也想用"+name()+"？\n");   
if ( time()-me->query_temp("buhui_end")<2+random(4) )  
        return notify_fail("你刚使完不悔，已经气喘吁吁！\n");
return 1;  
}

int perform(object me, object target)
{
object weapon;
int i,j,k,damage;
weapon = me->query_temp("weapon");

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

i=(int)me->query("combat_exp")/200000;
j=(int)target->query_("combat_exp")/200000+1;
k=(int)me->query_skill("spear");
k+=(int)me->query_skill("pingtian-dafa");
k+=(int)me->query_skill("wuyue-spear");
k+=(int)me->query_str();
k+=(int)me->query("level");

if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
message_vision(HIM"\n$N一挺手中"+weapon->name()+NOR+HIB"直刺$n！\n"NOR,me,target);
else message_vision(HIM"$N"HIM"对$n"HIM"使用了"NOR+name()+"。\n"NOR,me,target);
if (random(i)>random(j))
        {
        damage=k+random(k);
        target->receive_damage("kee",damage,me);
        target->receive_wound("kee",damage/3,me);
        COMBAT_D->report_status(target);
        }
//else if (random(i)>random(j))
if (random(i)>random(j))
        {
        if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
        message_vision(HIM"\n$N一枪刺空，又是一肘，仍击向$n！\n"NOR,me,target);
//        damage=k*2+random(k);
        damage=k+random(k);
        target->receive_damage("kee",damage,me);
        target->receive_wound("kee",damage/4,me);
        COMBAT_D->report_status(target);
        }
//else if (random(i)>random(j))
if (random(i)>random(j))
        {
        if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
        message_vision(HIM"\n$N一肘又空，但仍不收招，一头撞向$n！\n"NOR,me,target);
//        damage=k*3+random(k);
        damage=k+random(k);
        target->receive_damage("kee",damage,me);
        target->receive_wound("kee",damage/5,me);
        COMBAT_D->report_status(target);
        }
//else if (random(i)>random(j))
if (random(i)>random(j))
        {
        if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
        message_vision(HIM"\n$N一头虽然又撞空，但$n也被这拼命的举动吓了一跳！\n"NOR,me,target);
        if (!target->is_busy())
                target->start_busy(3+random(3));
        }
else    {
        if ( !me->query("env/no_msg") && !target->query("env/no_msg") ) {
        message_vision(HIM"\n$N一枪刺空，又是一肘，仍击向$n！\n"NOR,me,target);
        message_vision(HIM"\n$N一肘又空，但仍不收招，一头撞向$n！\n"NOR,me,target);
        }
        message_vision(HIW"\n$n哈哈大笑，只逞匹夫只勇又有何用，轻松避开。\n"NOR,me,target);
        me->receive_damage("kee", 100); 
        }
me->receive_damage("sen", 50);
me->add("force", -100-(int)me->query("force_factor"));
me->set_temp("buhui_end",time());
return 1; 
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("wuyue-spear")+" 350 级\n"; 
temp+= "\t\t"+to_chinese("spear")+" 350 级\n"; 
temp+= "\t\t"+to_chinese("pingtian-dafa")+" 350 级\n"; 
temp+= "\t\t内力修为十年\n"; 
temp+= "\t\t内力５００点\n"; 
temp+= "\t\t气血３００点\n"; 
temp+= "\t\t精神１００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                打击对手的气血并有可能牵制对手
        出招类型： 
                延时型外功
                有隐藏攻击
                必须无叛师纪录
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
