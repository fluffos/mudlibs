#include <ansi.h>
inherit PERFORM;

void create()
{
set("name",HIC"掌心雷"NOR);
set("class","yao");
set("belong","moyun-shou");
set("base_type","unarmed");
set("target",1);
set("force",500);
set("need_force",100);
set("damage_type","eff_kee");
set("limit_skill",([
	"moyun-shou"      :          100,
]));
set("busy_self",(random(1)));
set("double_hit",([
        "num"           :       1,
        "temp"          :       "moyunshou_per", 
        "temp_num"      :       ({6}),          
        "me_del_env"    :       1,                      
        "t_del_env"     :       1,                      
]));
set("temp","kusong/zxl");
set("temp_time", 2+random(1));

}

void hit_msg(object me,object target,int num)
{
if ( me && target )
message_vision("\n$N大喝一声“掌心雷”！\n", me);
}

void double_hit_msg(object me,object target,int i) 
{ 
} 
void remove_eff(object me,string temp_busy)
{
	me->delete_temp(temp_busy);
}


int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("moyun-shou")+" 100 级\n"; 
temp+= "\t\t内力 100 点\n"; 
write(@HELP 
摩云手 之 「掌心雷」：

        使用功效： 
                给对手强又有力的一击
        出招类型： 
                延时型武功
                无隐藏攻击 
                叛师可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
