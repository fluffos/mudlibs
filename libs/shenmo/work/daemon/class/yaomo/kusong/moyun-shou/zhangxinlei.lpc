
// modify by windy 06/05/15
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIB"掌心雷"NOR"」";  
}

int valid_perform(object me)
{
if( me->query("family/family_name") != "火云洞" && me->query_skill("moyun-shou", 1) < 350 && !me->samsara_check("moyun-shou",1))
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if ( me->query("class")!="yao" && !me->samsara_check("moyun-shou"))
        return notify_fail("你还不够资格！\n"); 
if((int)me->query_skill("moyun-shou", 1) < 100) 
        return notify_fail("你的摩云手修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("unarmed", 1) < 100) 
        return notify_fail("你的扑击格斗之技修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("max_force") < 1000 ) 
        return notify_fail("你的内力修为太浅！\n"); 
if((int)me->query("force") < 300 ) 
        return notify_fail("你的内力不足！\n"); 
if( time()-(int)me->query_temp("zhangxinlei_end") < 3+random(3) )
        return notify_fail("绝招用多就不灵了！\n"); 
return 1;  
}

int perform(object me, object target)
{
object weapon;
string msg;
int extra;

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

weapon = me->query_temp("weapon"); 
extra = me->query_skill("moyun-shou",1)/5;
extra+= me->query_skill("unarmed",1)/5;
extra+=me->query("level")/3;

message_vision(HIB"\n$N大喝一声“掌心雷”！\n"NOR, me);
me->add_temp("apply/attack", extra); 
me->add_temp("apply/damage", extra); 
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR); 
if ( (me->query("family/family_name")=="火云洞" && me->query("level")>499 && me->query_skill("moyun-shou", 1)>599) || me->samsara_check("moyun-shou",1))
        {
        message_vision(HIR"\n激战中$N突然忆起自己当年在火焰山之中修炼摩云手时的种种困厄，\n"
        "福至心灵，竟然使出了摩云手的的无上绝学「摩云绝杀」！\n"NOR, me);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR); 
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR); 
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR); 
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR); 
        }
me->add_temp("apply/attack", -extra); 
me->add_temp("apply/damage", -extra); 
me->add("force", -100); 
me->set_temp("zhangxinlei_end",time());
return 1;
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("moyun-shou")+" 100 级\n";  
temp+= "\t\t"+to_chinese("unarmed")+" 100 级\n";  
temp+= "\t\t内力修为十年\n"; 
temp+= "\t\t内力５００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                严重伤害对手的气血
        出招类型：   
                延时型外功  
                火云洞弟子使用时有隐藏攻击  
                叛师可以带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
