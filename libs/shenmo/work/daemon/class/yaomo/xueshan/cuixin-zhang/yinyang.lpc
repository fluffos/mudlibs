
// write by windy 06/05/18
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIR"阴阳双掌"NOR"」";  
}

int valid_perform(object me)
{
if((me->query("family/family_name") != "大雪山" || me->query("class") != "yao") && !me->samsara_check("cuixin-zhang",1))
        return notify_fail("只有雪山弟子才能使用"+name()+"！\n"); 
if(me->query_skill("cuixin-zhang", 1) < 200) 
        return notify_fail("你的摧心掌修为太浅，难以施展"+name()+"！\n"); 
if(me->query_skill("yingzhaogong", 1) < 200) 
        return notify_fail("你的鹰爪功修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("unarmed", 1) < 200) 
        return notify_fail("你的扑击格斗之技修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("force", 1) < 200) 
        return notify_fail("你的内功心法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("max_force") < 2000 ) 
        return notify_fail("你的内力修为太浅！\n"); 
if((int)me->query("force") < 1000 ) 
        return notify_fail("你的内力不足！\n"); 
if( time()-(int)me->query_temp("yinyang_end") < 3+random(2) )
        return notify_fail("不可连续催发阴阳内劲！\n"); 
return 1;  
}

int perform(object me, object target)
{
object weapon;
string msg;
int damage, extra;

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

damage=(int)me->query_skill("cuixin-zhang", 1);
damage+=(int)me->query_skill("unarmed", 1)/2;
damage+=(int)me->query_skill("force", 1)/2;
damage+=me->query("level");
damage=damage/2 + random(damage/2);
extra=(int)me->query_skill("yingzhaogong", 1);

message_vision(HIB"\n$N左掌凝重如山，掌心呈暗红色，带着深厚的内劲往$n"HIB"的小腹按去！\n"NOR, me, target);
if (random(me->query_skill("force", 1)+me->query_skill("unarmed", 1)) > target->query_skill("force", 1)/2)
        {
        message_vision(HIR"\n$N掌力未到，$n"HIR"已感胸口呼吸不畅，稍一迟疑，$N的掌力如怒潮般汹涌而至！\n"NOR, me, target);
        target->receive_damage("kee", damage, me);
        target->receive_wound("kee", damage/3+random(damage/2), me);
        if (!me->query("env/innoxious") && me->query("family/family_name") == "大雪山" && me->query_skill("ningxie-force", 1) > 100 && random(me->query("combat_exp")) > target->query("combat_exp")/3 && me->samsara_check("cuixin-zhang",1))
        target->apply_condition("bp_poison",5 + target->query_condition("bp_poison")); 
        COMBAT_D->report_status(target);
        if (!target->is_busy())    
        target->start_busy(1);
        message_vision(HIW"\n$N完全不给$n"HIW"喘息之机，右手化掌为爪，出手如电，抓向$n"HIW"的面门！\n"NOR, me, target);
        me->add_temp("apply/attack", extra); 
        me->add_temp("apply/damage", extra); 
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR); 
        me->add_temp("apply/attack", -extra); 
        me->add_temp("apply/damage", -extra); 
        me->add("force", -500); 
        }
else    {
        message_vision(HIY"\n不料$n"HIY"知道这招的厉害，早有防范，默运护体神功护住了丹田要害！\n"NOR, me, target);
        me->add("force", -200); 
        }
me->set_temp("yinyang_end",time());
return 1;
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("cuixin-zhang")+" 200 级\n";  
temp+= "\t\t"+to_chinese("yingzhaogong")+" 200 级\n";  
temp+= "\t\t"+to_chinese("unarmed")+" 200 级\n";  
temp+= "\t\t"+to_chinese("force")+" 200 级\n";  
temp+= "\t\t内力修为二十年\n"; 
temp+= "\t\t内力１０００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                连续伤害对手的气血并牵制对手
        出招类型：   
                延时型外功  
                有隐藏攻击 
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
