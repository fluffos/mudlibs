

// modify by windy 06/05/16
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"WHT"千蛇出洞"NOR"」";  
}

int valid_perform(object me)
{
if (me->query("family/family_name") != "大雪山" && me->query_skill("bingpo-blade",1) < 350) 
        return notify_fail("你还不够资格使用"+name()+"！\n"); 
if ( me->query("class")!="yao" && !me->samsara_check("bingpo-blade"))
        return notify_fail("你还不够资格！\n"); 
if(me->query_skill("bingpo-blade", 1) < 100) 
        return notify_fail("你的冰魄寒刀修为太差，难以施展"+name()+"！\n"); 
if(me->query_skill("blade", 1) < 100) 
        return notify_fail("你的基本刀法根基太差，难以施展"+name()+"！\n"); 
//if(me->query_skill("xiaoyaoyou", 1) < 100) 
//        return notify_fail("你的逍遥游修为太差，难以施展"+name()+"！\n"); 
if( time()-(int)me->query_temp("qscd_end") < 2+random(3) ) 
        return notify_fail("你还是先喘口气吧！\n"); 
if((int)me->query("max_force") < 500 ) 
        return notify_fail("你的内力修为不够！\n"); 
if((int)me->query("force") < 500 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
string dodskill,msg;
int extra;
int tmp;
object weapon;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

extra = me->query_skill("bingpo-blade",1)/2;
if(me->query("family/family_name") == "大雪山") 
extra+=me->query("level")/3;
weapon = me->query_temp("weapon");

message_vision( WHT  "\n$N手中的"+weapon->query("name")+WHT"幻出千朵刀花使出冰魄寒刀之不传绝学 ---千-蛇-出-洞--- ！\n\n" NOR, me);
me->add_temp("apply/attack", extra);
me->add_temp("apply/damage", extra);
message_vision( HIY  "金蛇欲探头！$N手中"+weapon->query("name")+HIY"直刺$n"HIY"！\n" NOR,me,target);
COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
message_vision( HIW  "白蛇微吐芯！$N手中"+weapon->query("name")+HIW"斜劈$n"HIW"！\n" NOR,me,target);
COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
message_vision( HIB  "青蛇翻身搏！$N手中"+weapon->query("name")+HIB"横劈$n"HIB"！\n" NOR,me,target);
COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
message_vision( HIR  "毒蛇啮八方！$N手中"+weapon->query("name")+HIR"猛劈$n"HIR"！\n" NOR,me,target);
COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
message_vision( HIC  "仙蛇云里游！$N手中"+weapon->query("name")+HIC"反撩$n"HIC"！\n" NOR,me,target);
COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
if ((me->query("spskk")==7 && (int)me->query("level")>(int)target->query("level") && random(3)) || (me->query("spskk")==8 && (int)me->query("level")<(int)target->query("level") && random(3)) || (me->query("spskkk")==3 && random(5)))
        {
        message_vision(WHT"千蛇齐出洞！$N手中"+weapon->query("name")+WHT"发出万道刀芒，激射$n"WHT"！\n" NOR,me,target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
        COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
        COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
        COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
        }
me->add_temp("apply/attack", -extra);
me->add_temp("apply/damage", -extra);

if (((!me->query("env/innoxious") && me->query("family/family_name") == "大雪山" && me->query_skill("ningxie-force", 1) > 100 && random(me->query("combat_exp")) > target->query("combat_exp")/3 && target->query("spskk")!=10) || me->samsara_check("bingpo-blade",1)) && (time()-(int)me->query_temp("jclh_end")>1) && (time()-(int)me->query_temp("fc_pili")>1))
        {
        message_vision( WHT  "$n"WHT"身子微微一颤，只感觉一股阴寒之气直透心肺！\n" NOR,me,target);
        target->apply_condition("bp_poison",5+random(5) + target->query_condition("bp_poison"));
        }
me->set_temp("qscd_end", time());
return 1;  
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("bingpo-blade")+" 100 级\n"; 
temp+= "\t\t"+to_chinese("blade")+" 100 级\n"; 
//temp+= "\t\t"+to_chinese("xiaoyaoyou")+" 100 级\n"; 
temp+= "\t\t内力修为五年\n"; 
temp+= "\t\t内力５００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                连续伤害敌人的气血
        出招类型： 
                延时型外功
                大雪山弟子使用有隐藏效果
                叛师可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
