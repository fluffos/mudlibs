#include <ansi.h> 
inherit F_DBASE; 
inherit SSERVER; 
#include <combat.h>  

string *msgs=({ 
	"「"+BLINK+HIW"百灵嘤咛"+HIW"」",
	" 「"+BLINK+HIC"西来鹦鹉"+HIW"」" ,
	"「"+BLINK+HIB"乌鸦哺食"+HIW"」" ,
	"「"+BLINK+HIM"盈鹊飞来"+HIW"」",
	"「"+BLINK+HIY"鹰击长空"+HIW"」",
	" 「"+BLINK+HIC"孔雀开屏"+HIW"」" ,
	"「"+BLINK+HIC"凤凰涅滂"+HIW"」" ,
	"「"+BLINK+HIR"炎之朱雀"+HIW"」",
	"「"+BLINK+HIY"百禽归巢"+HIW"」",
});

int remove_effect(object me,int skill);
       
int perform(object me, object target) 
{ 
string weapon,msg,str,*limb; 
int skill,damage,num,i,def,ap,dp; 
       
if( !target ) target = offensive_target(me); 
      
if( !target || !target->is_character() || !me->is_fighting(target) ) 
	return notify_fail("『舞禽回巢』只能对战斗中的对手使用。\n"); 
       
if(me->query("family/master_name")!="大鹏明王") 
	return notify_fail("不是明王的人不能用『舞禽回巢』！\n"); 

if( me->query_temp("kongjue") ) 
	return notify_fail("你已在使用『舞禽回巢』！\n"); 
     
if( (int)me->query_skill("ningxie-force",1) < 250 ) 
	return notify_fail("你的内功火候未到，无法施展『舞禽回巢』！\n"); 
       
if( (int)me->query_skill("bainiao-jian",1) < 250 ) 
	return notify_fail("你的百鸟剑法修为不足，还不会使用『舞禽回巢』！\n"); 
if( (int)me->query_skill("dengxian-dafa",1) < 250 ) 
	return notify_fail("你的法术修为不足，还不会使用『舞禽回巢』！\n"); 

if( (int)me->query_skill("xiaoyaoyou",1) < 250 ) 
	return notify_fail("你的轻功修为不足，还不会使用『舞禽回巢』！\n"); 
     
if( me->query("family/family_name") != "大雪山") 
	return notify_fail("你非雪山弟子，无法使用『舞禽回巢』！\n"); 
       
skill =  ( me->query_skill("bainiao-jian")+ me->query_skill("force") ) / 5; 
if( me->query("force") <= skill*5 ) 
	return notify_fail("你的内力不够使用『舞禽回巢』！\n"); 

if( me->query("sen") <= skill*2 ) 
	return notify_fail("你的精神不够使用『舞禽回巢』！\n"); 
    
weapon = me->query_temp("weapon"); 
me->add_temp("apply/speed", skill*2); 
me->add_temp("apply/attack",skill); 
me->add_temp("apply/dodge", skill*3/2); 
me->add_temp("apply/parry", skill*3/2); 
me->add("force", -skill*3 ); 
me->set_temp("kongjue",1); 
me->start_call_out( (: call_other, __FILE__, "remove_effect", me ,skill :),5+random(7) ); 
       
if( me->query_skill("bainiao-jian",1) <450 || me->query_skill("ningxie-force",1) <450 )
	{ 
	message_vision(WHT "$N"HIW"运转凝血邪功，剑招突变，"+RED+(me->query_temp("weapon"))->query("name")+NOR WHT"绽出万点星光,绮丽非常！\n\n" NOR, me, target); 
	num=3;} 
     
else { 
	message_vision(HIW "$N运转凝血邪功，剑招突变，"+RED+(me->query_temp("weapon"))->query("name")+NOR HIW"绽出万点星光,绮丽非常！\n\n" NOR, me, target); 
       num=7;} 
     
damage = me->query_skill("sword") + (int)me->query_skill("ningxie-force", 1); 
damage = damage - random( target->query_skill("dodge")/2);  

for(i=0;i<=num;i++)     
	{
	msg =  HIW "\n$N大喝一声："+msgs[i]+HIW"！\n" NOR; 
	message_vision(msg,me,target); 
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);    
	ap = me->query("combat_exp");
	ap/= 500000;
	ap+= me->query_skill("bainiao-jian",1);
	dp = target->query("combat_exp");
	dp/= 500000;
	dp+= target->query_skill("parry");
	if ( random(ap) > (random(dp)/3) )
		{
		msg = WHT"\n$n"WHT"大叫：不愧是大雪山绝学！\n"NOR;
		limb = ({
			"劈伤","刺伤","砍伤","筑伤","砸伤","割伤","瘀伤","内伤",
			});
		str = limb[random(sizeof(limb))];
		msg+= YEL+COMBAT_D->damage_msg(damage,str)+NOR;
		limb=({"屁股","耳朵","鼻子","眼珠","舌头"});
		str = limb[random(sizeof(limb))];
                msg = replace_string(msg,"$l",RED+str+NOR+YEL);
                msg = replace_string(msg,"$w",BLINK+HIC+weapon->name()+NOR+YEL);
		message_vision(msg,me,target);
		target->receive_damage("kee", damage*num );
		target->receive_wound("kee", damage*num/2 );  
		}
	else	{
		msg = HIC"\n$n"HIC"大叫：大雪山绝学也不外如此！\n"NOR;
		message_vision(msg,me,target);
		}
	}


if( me->query_skill("bainiao-jian",1) > 450 &&
    me->query_skill("ningxie-force",1) >450 &&
    target )
	{		
	msg=HIC+(me->query_temp("weapon"))->query("name")+WHT"的光华暗淡下来，但是$N"WHT"的攻势并没有放慢。
一招"+msgs[8]+NOR+WHT"仿佛积蓄了所有变招的精华，$n"WHT"想躲开已是妄想。\n\n"NOR;

	damage = (int)me->query_skill("bainiao-jian", 1); 
	damage+= (int)me->query_skill("sword"); 
	damage+= (int)me->query_skill("ningxie-force", 1); 
	damage = (damage + random(damage))*3/8; 
	def=(int)target->query_temp("apply/armor_vs_force"); 
	damage -=damage*def/10000; 
	if ( damage<500 ) damage=500;
	target->receive_damage("kee", damage);
	target->receive_wound("kee", damage); 
	message_vision(msg,me,target);
	COMBAT_D->report_status(target); 
	}                 
return 1; 
} 
      
int remove_effect(object me,int skill) 
{ 
me->add_temp("apply/speed", -skill*2); 
me->add_temp("apply/attack",-skill); 
me->add_temp("apply/dodge", -skill*3/2); 
me->add_temp("apply/parry", -skill*3/2); 
me->delete_temp("kongjue"); 
message_vision(HIG "\n$N吸了一口气，将内力收回丹田，剑招也恢复正常！\n\n" NOR, me); 
return 0; 
} 
