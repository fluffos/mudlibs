
// modify by windy 06/05/18
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIG"百鸟争鸣"NOR"」";  
}

int valid_perform(object me)
{
if (me->query("family/family_name") != "大雪山" && me->query_skill("bainiao-jian",1) < 350) 
        return notify_fail("你还不够资格使用"+name()+"！\n"); 
if ( me->query("class")!="yao" && !me->samsara_check("bainiao-jian"))
        return notify_fail("你还不够资格！\n"); 
if(me->query_skill("bainiao-jian", 1) < 80) 
        return notify_fail("你的百鸟剑法修为太差，难以施展"+name()+"！\n"); 
if(me->query_skill("sword", 1) < 80) 
        return notify_fail("你的基本剑术根基太差，难以施展"+name()+"！\n"); 
if( (int)me->query("max_force") < 800)
        return notify_fail("你内力修为不够，难以施展"+name()+"。\n");
if((int)me->query("force") < 400 ) 
        return notify_fail("你内力不够，难以施展"+name()+"。\n");
return 1;  
}

int perform(object me, object target)
{
string msg;
int myexp, yourexp;
object weapon; 

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail("你们没有在打架！\n");

weapon = me->query_temp("weapon");
myexp = (int)me->query("combat_exp")/1000*(int)me->query_skill("sword");
yourexp = (int)target->query("combat_exp")/1000*(int)target->query_skill("dodge");
msg = HIG
"$N长剑一振，忽然发出一阵悦耳的乐声，细听那乐声，平和中正，清新典雅。\n"
"这乐声绝不沾半分妖邪之气，正是上古神曲---百鸟争鸣！\n" NOR;

if( random(myexp) > yourexp/3)
        {
        msg += HIC
        "$n"HIC"听得入了神，将身旁的敌人搁在一边。\n" NOR;
        if (!target->is_busy())
        target->start_busy(3);
        msg += HIR"$N却剑交左手，剑尖从一极刁的角度刺来，极尽毒、阴、狠、辣之能事，与曲中意境大异其趣！\n" NOR;
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
        me->start_busy(1);
        me->add("force",-200);
        }
else    {
        msg += HIY
        "$n"HIY"似乎对$N的乐声不感兴趣，轻轻地避在一旁。\n" NOR;
        me->start_busy(2);
        me->add("force",-150); 
        message_vision(msg, me, target);
        }
return 1;
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("bainiao-jian")+" 80 级\n"; 
temp+= "\t\t"+to_chinese("sword")+" 80 级\n"; 
temp+= "\t\t内力修为八年\n"; 
temp+= "\t\t内力４００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                牵制对手并把握时机攻击对手
        出招类型： 
                busy 型武功
                无隐藏攻击 
                叛师可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
