#include <ansi.h> 
inherit F_DBASE; 
inherit SSERVER; 
#include <combat.h>  
string *msgs=({ "「"+BLINK+HIW"百灵嘤咛"+HIW"」"," 「"+BLINK+HIC"西来鹦鹉"+HIW"」" ,"「"+BLINK+HIB"乌鸦哺食"+HIW"」" ,"「"+BLINK+HIM"盈鹊飞来"+HIW"」",
		"「"+BLINK+HIY"鹰击长空"+HIW"」"," 「"+BLINK+HIC"孔雀开屏"+HIW"」" ,"「"+BLINK+HIC"凤凰涅滂"+HIW"」" ,"「"+BLINK+HIR"炎之朱雀"+HIW"」",
		"「"+BLINK+HIY"百禽归巢"+HIW"」",
		});
int remove_effect(object me); 
       
int perform(object me, object target) 
{ 
string weapon,msg,str; 
int skill, att,damage,num,i; 
       
if( !target ) target = offensive_target(me); 
      
if( !target || !target->is_character() || !me->is_fighting(target) ) 
	return notify_fail("『舞禽回巢』只能对战斗中的对手使用。\n"); 
       
if(me->query("family/master_name")!="大鹏明王") 
	return notify_fail("不是明王的人不能用『舞禽回巢』！\n"); 

if( me->query_temp("kongjue",1) ) 
	return notify_fail("你已在使用『舞禽回巢』！\n"); 
     
if( (int)me->query_skill("ningxie-force",1) < 250 ) 
	return notify_fail("你的内功火候未到，无法施展『舞禽回巢』！\n"); 
       
if( (int)me->query_skill("bainiao-jian",1) < 250 ) 
	return notify_fail("你的百鸟剑法修为不足，还不会使用『舞禽回巢』！\n"); 
if( (int)me->query_skill("dengxian-dafa",1) < 250 ) 
	return notify_fail("你的法术修为不足，还不会使用『舞禽回巢』！\n"); 

if( (int)me->query_skill("xiaoyaoyou",1) < 250 ) 
	return notify_fail("你的轻功修为不足，还不会使用『舞禽回巢』！\n"); 
     
if( me->query("family/family_name") != "大雪山") 
	return notify_fail("你非雪山弟子，无法使用『舞禽回巢』！\n"); 
       
skill =  ( me->query_skill("bainiao-jian")+ me->query_skill("force") ) / 5; 
if( me->query("force") <= skill*5 ) 
	return notify_fail("你的内力不够使用『舞禽回巢』！\n"); 

if( me->query("sen") <= skill*2 ) 
	return notify_fail("你的精神不够使用『舞禽回巢』！\n"); 
    
weapon = me->query_temp("weapon"); 
me->set_temp("apply/speed", me->query_temp("apply/speed",1)+skill*2); 
att = skill; 
if ( att < 20) att = 20;
if (att >100 ) att = 100; 
me->set_temp("apply/attack", me->query_temp("apply/attack",1)+att); 
me->set_temp("apply/dodge", skill*3/2); 
me->set_temp("apply/parry", skill*3/2); 
       
if( me->query_skill("bainiao-jian",1) <450 || me->query_skill("ningxie-force",1) <450 ){ 
	message_vision(HIW "$N运转凝血邪功，剑招突变，"+(me->query_temp("weapon"))->query("name")+HIY"绽出万点星光,绮丽非常！\n\n" NOR, me, target); 
	num=3;} 
     
else { 
	message_vision(HIW "$N运转凝血邪功，剑招突变，"+(me->query_temp("weapon"))->query("name")+HIY"绽出万点星光,绮丽非常！\n\n" NOR, me, target); 
       num=7;} 
     
damage = me->query_skill("sword") + (int)me->query_skill("ningxie-force", 1); 
damage = damage - random( target->query_skill("dodge")/2);  

for(i=0;i<=num;i++)     
	{
	msg =  HIW "$N大喝一声："+msgs[i]+HIW"！\n" NOR; 
	message_vision(msg,me,target); 
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);    
	 }

target->receive_damage("kee", random(damage)*num/5 ); 
target->receive_wound("kee", damage*num/5 );  

/*
if (target->query("eff_kee")<0 || !living(target))  
	{
	str=me->name()+HIM"使用了明王绝学『舞禽回巢』！"+target->name()+HIM"不幸死于其"+(me->query_temp("weapon"))->query("name")+HIM"下，尸体惨遭"+chinese_number(num)+"百只飞禽啄食！";
	message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users());
	}
*/

if( me->query_skill("bainiao-jian",1) > 450 || me->query_skill("ningxie-force",1) >450)
	{ 
	me->start_busy(2); 
	target->start_busy(2); 
	call_out("perform2", 2, me, target);
            }
else me->start_busy(1+random(2));         
 
me->add("force", -skill*3 ); 
me->set_temp("kongjue",1); 
me->start_call_out( (: call_other, __FILE__, "remove_effect", me :),8+random(2) ); 
return 1; 
} 
      
int remove_effect(object me) 
{ 
me->set_temp("apply/speed", 0); 
me->set_temp("apply/attack", 0); 
me->set_temp("apply/dodge", 0); 
me->set_temp("apply/parry", 0); 
me->delete_temp("kongjue"); 
  
if( me->is_fighting() ) 
message_vision(HIG "\n$N吸了一口气，将内力收回丹田，剑招也恢复正常！\n\n" NOR, me); 
return 0; 
} 

int perform2(object me, object target) 
{ 
string weapon,str; 
int damage,def; 
weapon = me->query_temp("weapon");   
     
if(!living(target))  return 1; 
      
message_vision(HIC+(me->query_temp("weapon"))->query("name")+HIW"的光华暗淡下来，但是$N的攻势并没有放慢。\n"NOR,me,target); 
message_vision(HIW"一招"+msgs[8]+NOR+HIW"仿佛积蓄了所有变招的精华，$n想躲开已是妄想。\n\n"NOR,me,target); 
	damage = (int)me->query_skill("bainiao-jian", 1); 
	damage = damage+(int)me->query_skill("sword", 1); 
	damage = damage+(int)me->query_skill("ningxie-force", 1); 
	damage = (damage + random(damage))*3/8; 
	def=(int)target->query_temp("apply/armor_vs_force"); 
	damage -=damage*def/4000; 
	target->receive_damage("kee", damage); 
	target->receive_wound("kee", damage); 
/*
if (target->query("eff_kee")<0 || !living(target))  
	{
	str=me->name()+HIM"使用了明王绝学『舞禽回巢』！"+target->name()+HIM"不幸死于其"+(me->query_temp("weapon"))->query("name")+HIM"下，尸体惨遭"+chinese_number(9)+"百只飞禽啄食！";	message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users());
	}
*/
	COMBAT_D->report_status(target); 
me->start_busy(1+random(2)); 
return 1; 
}                 
      
