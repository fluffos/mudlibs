#include <ansi.h> 
inherit F_DBASE; 
inherit SSERVER; 
#include <combat.h>  

string *msgs=({ 
        "「"+BLINK+HIW"百灵嘤咛"+HIW"」"," 「"+BLINK+HIC"西来鹦鹉"+HIW"」" ,
        "「"+BLINK+HIB"乌鸦哺食"+HIW"」" ,"「"+BLINK+HIM"盈鹊飞来"+HIW"」",
        "「"+BLINK+HIY"鹰击长空"+HIW"」"," 「"+BLINK+HIC"孔雀开屏"+HIW"」",
        "「"+BLINK+HIC"凤凰涅滂"+HIW"」" ,"「"+BLINK+HIR"炎之朱雀"+HIW"」",
        "「"+BLINK+HIY"百禽归巢"+HIW"」",
});

string name()
{
return "『舞禽归巢』";  
}

int valid_perform(object me)
{
int skill;      
if ( !me ) 
        return 0;       
if ( time()<me->query_temp("pfm_kongque_gui")+3 )
        return notify_fail("你刚刚参悟过"+name()+"，暂时无法再行施展。\n");     
skill =  ( me->query_skill("bainiao-jian")+ me->query_skill("force") ) / 5; 
if ( me->query("force")<=skill*5 
  || me->query("family/family_name")!="大雪山" 
  || me->query("sen")<=skill*2 
  || !me->is_fighting() 
  || me->query_skill("throwing",1)<350 )
        return notify_fail("你隐约觉得手中"+me->query_temp("weapon")->name()+"和平时有些不一样，但就是说不出来。\n"); 
return 1;
}              

int perform(object me, object target) 
{ 
string weapon,msg,str; 
int skill, att,damage,num,i,dd; 
int sk;
       
if ( !valid_perform(me) )
        return 0;       
if ( !target ) 
        target = offensive_target(me); 
if ( !target || !target->is_character() || !me->is_fighting(target) ) 
        return notify_fail("你吸了一口气，将内力收回丹田，剑招也恢复正常。\n"); 

skill =  ( me->query_skill("bainiao-jian")+ me->query_skill("force") ) / 5; 
sk = me->query_skill("bainiao-jian",1);
weapon = me->query_temp("weapon"); 
sk = sk-300;
sk/= 50;
num = sk;
if ( num>9 ) num = 9;
msg = HIW"$N"HIW"运转凝血邪功，剑招突变，"+(me->query_temp("weapon"))->name()+HIW"绽出"+chinese_number(num)+"点星光,绮丽非常！\n\n" NOR; 
if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
        message_vision("\n"+msg,me,target);     
me->set_temp("pfm_kongque_gui",time()); 
        
damage = me->query_skill("sword") + me->query_skill("force"); 
damage = damage - random( target->query_skill("dodge")/2);  
damage-= target->query_temp("apply/armor");
for(i=0;i<=num-1;i++)     
        {
        msg =  "$N大喝一声："+msgs[i]+NOR"！"; 
        if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
                message_vision(msg,me,target); 
        dd = COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        if ( !dd )
                {
                target->receive_damage("kee", random(damage),me); 
                target->receive_damage("sen", damage,me);  
                COMBAT_D->report_status(target); 
                }
        }
me->add("force", -skill*3 ); 
return 1; 
}
