#include <ansi.h>
inherit SSERVER;
int perform(object me, object target)
{
string msg;
int myexp, yourexp,time;
object weapon;    
       
if( !target ) target = offensive_target(me);
if( !target
  ||!target->is_character()
  ||!me->is_fighting(target) )
	return notify_fail("百鸟争鸣只能在战斗中使用.\n");

weapon = me->query_temp("weapon");

if (!weapon||weapon->query("skill_type") != "sword" )
	return notify_fail("你手中无剑，不能使用百鸟争鸣！\n");

if( (int)me->query_skill("bainiao-jian",1) < 50)
	return notify_fail("你的百鸟剑法等级还不够!\n");

if(me->query("family/family_name")!="大雪山")
	return notify_fail("你不能用别派的特殊攻击\n"); 

if( (int)me->query_skill("ningxie-force",1) < 50)
	return notify_fail("你的冰谷凝血功还不够纯熟.\n");

if( (int)me->query("max_force") < 800)
	return notify_fail("你的内力太弱了!\n");
	
if( (int)me->query("force") < 400)
	return notify_fail("你的内力不够了.\n");;

myexp = (int)me->query("combat_exp")/1000*(int)me->query_skill("sword");
yourexp = (int)target->query("combat_exp")/1000*(int)target->query_skill("dodge");

// "time" AddBy Snowtu@xmxyj2000
time=me->query_skill("bainiao-jian",1);
time/=50;
if ( time<1 ) time=1;
if ( time>7 ) time=7;

msg = HIC
"$N"HIC"长剑一振,忽然发出一阵悦耳的乐声,细听那乐声,平和中正,清新典雅。
这乐声绝不沾半分妖邪之气,正是上古神曲---百鸟争鸣!!\n" NOR;

message_vision(msg, me, target);

if( random(myexp*4) > random(yourexp) ) //RewriteBySnowtu/2003/原文为 *3
	{
	msg = HIG"$n听得入了神,将身旁的敌人搁在一边.\n" NOR;
	message_vision(msg, me, target);
	if ( random(2)>=1 )
		{
		msg = WHT"$N"WHT"却剑交左手,剑尖从一极刁的角度刺来,极尽毒,阴,狠,辣之能事.与曲中意境大异其趣!\n" NOR;
		message_vision(msg, me, target);
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
		}
	target->start_busy(time+random(3));
//        me->start_busy(1)
	me->add("force",-200);
	}
else  {
	msg = HIC"$n"HIC"似乎对$N"HIC"的乐声不感兴趣，轻轻地避在一旁。\n" NOR;
	message_vision(msg, me, target);
	me->start_busy(random(3));  ////RewriteBySnowtu/2003/原文为 busy 2
	me->add("force",-150);  
	}
return 1;
}
