#include <ansi.h>
inherit PERFORM;

void create()
{
set("name","百鸟争鸣");
set("target",1);
set("need_force",100);
set("force",300);
//set("family","方寸山三星洞");
set("class","yao");
set("belong","bainiao-jian");
set("base_type","sword");
set("betray_lvl",350);
set("limit_skill",([
        "bainiao-jian" : 60,
]));
set("persent",200);
set("busy_pfm",1);
}

void hit_msg(object me,object target,int num)
{
string msg;
if ( me && target&&num==1 )
msg = HIC
"$N"HIC"长剑一振,忽然发出一阵悦耳的乐声,细听那乐声,平和中正,清新典雅。
这乐声绝不沾半分妖邪之气,正是上古神曲---百鸟争鸣!!\n" NOR;
message_vision(msg, me, target);

}

void success_hit_msg(object me,object target,int num)
{
string msg="";
int lvl;
if ( me && target )
	{
	msg += HIG"$n听得入了神,将身旁的敌人搁在一边.\n" NOR;
	message_vision(msg,me,target);

	if ( random(2)>=1 )
		{
		msg = WHT"$N"WHT"却剑交左手,剑尖从一极刁的角度刺来,极尽毒,阴,狠,辣之能事.与曲中意境大异其趣!\n" NOR;
		message_vision(msg, me, target);
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
		COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
		}
	}

           target->start_busy(3+random(2));
           me->start_busy(random(1));
}
 
void lost_hit_msg(object me,object target,int num)
{
string msg="";

if ( me && target )
	{
	msg += HIC"$n"HIC"似乎对$N"HIC"的乐声不感兴趣，轻轻地避在一旁。\n" NOR;
	message_vision(msg,me,target);
            me->start_busy(1+random(1));
	}
}
int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("bainiao-jian")+" 60 级\n"; 
temp+= "\t\t内力 100 点\n"; 
write(@HELP 
百鸟剑法 之 「百鸟争鸣」：

        使用功效： 
                牵制对手 3 - 5 秒
        出招类型： 
                busy型武功
                无隐藏攻击 
                叛师可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
