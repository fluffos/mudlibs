
// modify by windy 06/04/28
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIR"百花追魂"NOR"」";  
}

int valid_perform(object me)
{
if ( me->query("family/family_name")!="移花宫" && !me->samsara_check("baihua-whip", 1))
        return notify_fail(name()+"是移花宫不传之密！\n");
if((int)me->query_skill("baihua-whip",1)<300) 
        return notify_fail("你的百花鞭法等级不够，玩不出来这招。\n"); 
if((int)me->query_skill("whip",1)<300) 
        return notify_fail("你的基本鞭法还不够纯熟。\n"); 
if((int)me->query_skill("yihua-force",1)<200) 
        return notify_fail("你的移花心法还不够纯熟。\n"); 
if((int)me->query("combat_exp")<800000) 
        return notify_fail("以你现在的武学恐怕使出来也打不中对手。\n"); 
if((int)me->query("daoxing")<200000) 
        return notify_fail("你这点微末道行，就算用出来了，也没什么威力。\n"); 
if((int)me->query("max_force")<1500 || (int)me->query("force")<400) 
return notify_fail("你的内力或者内力修为不够！\n"); 
if((int)me->query("max_mana")<1000 || (int)me->query("mana")<200) 
        return notify_fail("你的法力或者法力修为不够！\n"); 
if( time()-(int)me->query_temp("zhuihun_end") < 3+random(3) )
        return notify_fail("你已经在使用"+name()+"了！\n");
return 1;  
}

int perform(object me, object target)
{
int damage, mywx, yourwx, yourskill, number, num, t, mylvl, yourlvl; 
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
damage = (int)me->query_skill("whip",1) + (int)me->query_skill("baihua-whip",1) + me->query("force_factor") + me->query("mana_factor") + me->query("level");
yourskill = (int)target->query_skill("parry",1) + (int)target->query_skill("dodge",1) + target->query("level");
if(yourskill<1) yourskill=1;
mywx=(int)me->query("combat_exp")/10000; 
yourwx=(int)target->query("combat_exp")/10000;
mylvl=me->query("level");
yourlvl=target->query("level");
number=damage-(yourskill/3*2)+(damage/yourskill)*100+random(damage/20)+random(10);
if (number>5000)  number=5000;
if (number<100)  number=100;
num=random(number/100+1);

message_vision(HIG "$N将手中长鞭一抛，那长鞭居然围绕着$N旋转起来。\n花瓣形成了如刀般的气流，四射而开。\n" NOR,me,target);
me->add("force",-100); 
if (mywx>random(yourwx) || mylvl>random(yourlvl) && mywx>yourwx/3)
    {
    message_vision(HIR "结果$n躲闪不及，身上中了"+chinese_number(num)+"处的蔷薇花瓣！\n" NOR,me,target);
    target->receive_damage("kee",number*3,me); 
    target->receive_damage("sen",number,me); 
    target->receive_wound("kee",number*2,me);
    target->receive_wound("sen",number,me); 
    COMBAT_D->report_status(target,0); 
    COMBAT_D->report_sen_status(target,0); 
    }
else
    {
    message_vision(GRN "$n急忙提高自己的气，抵挡住了$N如刀般的花瓣。\n" NOR,me,target);
    target->add("mana",-100); 
    target->add("kee",-100); 
    target->add("sen",-100); 
    }
me->set_temp("zhuihun_end", time());
return 1;
}

int help(object me) 
{
string temp; 
temp = "\t\t"+to_chinese("baihua-whip")+" 300 级\n";  
temp+= "\t\t"+to_chinese("whip")+" 300 级\n";  
temp+= "\t\t"+to_chinese("yihua-force")+" 200 级\n";  
temp+= "\t\t武学 80 万\n";
temp+= "\t\t道行 200 年\n"; 
temp+= "\t\t内力修为 15 年\n";  
temp+= "\t\t内力 400 点\n";  
temp+= "\t\t法力修为 1000 点\n";  
temp+= "\t\t法力 200 点\n";  
temp+= "\t\t内力 1500 点\n";  
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                强力伤害对手的精神和气血
        出招类型：   
                延时型外功  
                无隐藏攻击
                叛师不可带出   
        出手要求： 
HELP);  
write(temp);  
return 1;  
}
