
// modify by windy 06/04/28
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIM"百花争艳"NOR"」";  
}

int valid_perform(object me)
{
if ( me->query("family/family_name")!="移花宫" && !me->samsara_check("baihua-whip"))
        return notify_fail(name()+"是移花宫不传之密！\n");
if((int)me->query("force") < 25+(int)me->query("force_factor") )
        return notify_fail("你的内力不够！\n");
if((int)me->query("kee") < 500 )
        return notify_fail("你的气血不足，没法子施用外功！\n");
if((int)me->query_skill("baihua-whip", 1) <200)
        return notify_fail("你的百花鞭法级别还不够！\n");
if( time()-(int)me->query_temp("zheng_end") < 4 )
        return notify_fail("绝招用多就不灵了！\n");
return 1;  
}

int perform(object me, object target)
{
string msg,str;
int damage, ap, dp, s_num, chance;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
msg = HIR"\n$N双手舞动，身体盈盈旋转，隐身于花丛之中... ...\n"+"$n只觉一时之间身边多出了很多艳丽的花朵！\n" NOR;
s_num = (int)(random(me->query_skill("whip")/10)) + (int)(me->query_skill("baihua-whip")/10)+ 1;
ap = me->query_skill("whip");
ap =  ap * ap * ap / 100;
dp = target->query("combat_exp")* 4 /5;
if (dp < 100000) {
     chance = 100;
            }
else {
chance = (int)(random(ap + dp) * 100 / dp);
    }
if( chance > 66 ) 
    {
    damage = s_num * 50 ;
    damage +=(int)me->query("force_factor")-random((int)target->query("force_factor"));
    if ( damage > 3000 ) damage=3000+random(1000);
    msg += HIR "$n面对漫天的花朵，不知如何下手，被你从花丛中偷袭屡屡得手！\n" NOR;
    target->receive_wound("kee", damage,me);
    me->improve_skill("unarmed", s_num, 1);
    }
else if ( chance > 33 ) 
    {
    damage = s_num * 8 ; 
    if ( damage > 800 ) damage=800+random(800);
    msg += HIC "$n面对漫天的花朵，打起精神小心提防，但还是被你从花丛中偷袭屡屡得手！\n" NOR;
    target->receive_wound("kee", damage,me);
    me->improve_skill("whip", s_num, 1);
    }
else
    msg += "谁知$n竟看破你的企图，百花丛中择路走出你的包围！\n";
message_vision(msg, me, target);
if( damage > 0 ) COMBAT_D->report_status(target);
else if( damage < 0 ) COMBAT_D->report_status(me);
me->set_temp("zheng_end",time());
return 1;
}

int help(object me)  
{
string temp;
temp = "\t\t"+to_chinese("baihua-whip")+" 200 级\n"; 
temp+= "\t\t内力不小于加力值加 25\n"; 
temp+= "\t\t气血 500 点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                给对手的气血有力的一击
        出招类型：   
                延时型外功  
                无隐藏攻击
                叛师不可带出   
        出手要求： 
HELP);  
write(temp);  
return 1;  
}
