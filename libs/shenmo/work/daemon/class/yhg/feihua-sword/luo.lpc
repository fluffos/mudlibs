
// modify by windy 06/04/28
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIM"花落谁家"NOR"」";  
}

int valid_perform(object me)
{
if ( me->query("family/family_name")!="移花宫" && !me->samsara_check("feihua-sword", 1))
        return notify_fail("只有移花宫弟子才配使用"+name()+"！\n");  
if( (int)me->query_skill("feihua-sword", 1) < 200 )
        return notify_fail("你的飞花剑法不够娴熟，难以施展"+name()+"！\n"); 
if( (int)me->query("max_force") <= 2000 ) 
        return notify_fail("你的内力修为太差！\n"); 
if( (int)me->query("force") <= 1000 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
object weapon,ob;
int skill;
string msg;

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
weapon = me->query_temp("weapon");
skill = me->query_skill("sword");
skill+=me->query("level");

msg = HIG "$N以手嗜剑，朵朵鲜花似从"+ weapon->name() + HIG "上喷出。\n"NOR;
message_vision(msg, me, target);
me->add("force", -100);
me->add_temp("apply/attack", skill/5);
me->add_temp("apply/damage", skill/5);

message_vision(HIW"【梅花落】！\n"NOR, me, target);
COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
message_vision(HIR"【杏花落】！\n"NOR, me, target);
COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
message_vision(HIM"【桃花落】！\n"NOR, me, target);
COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
message_vision(WHT"【梨花落】！\n"NOR, me, target);
COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
message_vision(HIR"【荷花落】！\n"NOR, me, target);
COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
if (skill>799 && skill<1200)
        {
        message_vision(MAG"【桂花落】！\n"NOR, me, target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
        }
if (skill>1199 && skill<1600)
        {
        message_vision(MAG"【桂花落】！\n"NOR, me, target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
        message_vision(HIY"【菊花落】！\n"NOR, me, target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
        }
if (skill>1599)
        {
        message_vision(MAG"【桂花落】！\n"NOR, me, target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
        message_vision(HIY"【菊花落】！\n"NOR, me, target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
        message_vision(YEL"【百花落】！\n"NOR, me, target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
        }
me->add_temp("apply/attack", -skill/5);
me->add_temp("apply/damage", -skill/5);
me->start_busy(2);
return 1;
}

int help(object me) 
{
string temp;
temp = "\t\t"+to_chinese("feihua-sword")+"２００级\n"; 
temp+= "\t\t内力修为２０年\n"; 
temp+= "\t\t内力１０００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

                连续打击对手的气血
        出招类型：   
                busy 型外功  
                无隐藏攻击
                叛师不可带出   
        出手要求： 
HELP);  
write(temp);  
return 1;  
}
