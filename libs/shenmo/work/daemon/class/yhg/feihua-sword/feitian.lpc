
// modify by windy 06/04/28
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"WHT"雪花飞天"NOR"」";  
}

int valid_perform(object me)
{
if ( me->query("family/family_name")!="移花宫" && me->query_skill("feihua-sword",1)<350 ) 
        return notify_fail("你还没有资格使用"+name()+"！\n");  
if ( me->query("class")!="human" && !me->samsara_check("feihua-sword"))
        return notify_fail("你还不够资格！\n"); 
if( time()-(int)me->query_temp("feitian_end") < 4+random(2) ) 
        return notify_fail("绝招用多就不灵了！\n"); 
if((int)me->query_skill("feihua-sword", 1) < 100) 
        return notify_fail("你的飞花剑法修为太差，难以施展"+name()+"！\n"); 
if( (int)me->query("force") <= 1000 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
string msg,str;
int extra,lvl,lv;
int i;
object weapon;

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
extra = me->query_skill("feihua-sword",1)/2;
lvl=2+extra/50;
if(lvl>7 && me->query("family/family_name")!="移花宫" && !me->query("任务")) lvl =7;
if (lvl>13) lvl =13;
extra+=me->query("level")/2;
weapon = me->query_temp("weapon");
me->add_temp("apply/attack", extra/3); 
me->add_temp("apply/damage", extra/2);
msg = WHT  "$N手中的"+ weapon->name() + WHT " 以极快的速度在空中飞舞，$n"+WHT"好象看到了漫天的雪花！\n" NOR;
message_vision(msg, me, target);
for(i=0;i<=lvl;i++) 
    {
    COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR); 
    }
me->add_temp("apply/attack", -extra/3); 
me->add_temp("apply/damage", -extra/2); 
me->set_temp("feitian_end",time());
return 1; 
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("fei-sword")+" 100 级\n"; 
temp+= "\t\t内力１０００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                连续打击对手的气血
        出招类型： 
                延时型外功
                无隐藏攻击
                叛师可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
