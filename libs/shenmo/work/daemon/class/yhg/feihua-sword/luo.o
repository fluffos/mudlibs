
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>


void remove_effect(object me, int a_amount, int d_amount);

inherit SSERVER;
int perform(object me, object target)
{
        object weapon,ob;
        int skill;
        string msg;

        if( !target ) target = offensive_target(me);

        if( !target

        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("「花落谁家」只能在战斗中使用。\n");

        if (!objectp(weapon = me->query_temp("weapon"))
                || (string)weapon->query("skill_type") != "sword")
                return notify_fail("「花落谁家」必须用剑才能施展。\n");

             if( (int)me->query_skill("feihua-sword", 1) < 100 )
                return notify_fail("你的「飞花剑法」不够娴熟，不会使用「花落谁家
」。\n");
if (me->query("family/family_name")!="移花宫")
        return notify_fail("你不是移花宫弟子，用不了「花落谁家」!\n");
        if( (int)me->query("force") < 500  )
                return notify_fail("你的内力不够。\n");

        skill = me->query_skill("feihua-sword");
        skill = 0;
        msg = HIG "$N以手嗜剑，朵朵鲜花似从宝剑上喷出。\n"NOR;
        message_vision(msg, me, target);

        me->add("force", -100);
me->add_temp("apply/attack", skill);
 me->add_temp("apply/damage", skill);

        msg = HIR"【桃花落】！\n"NOR;
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
        msg = HIY"【菊花落】！\n"NOR;
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
        msg = HIG"【桂花落】！\n"NOR;
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
        msg = HIR"【杏花落】！\n"NOR;
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
        msg = HIW"【梨花落】！\n"NOR;
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
me->add_temp("apply/attack", -skill);
 me->add_temp("apply/damage", -skill);

        me->start_busy(2);

        return 1;
}
int help(object me) 
{
string temp;
temp = "\t\t"+to_chinese("feihua-sword")+" 100 级\n"; 
temp+= "\t\t内力 500 点\n"; 
write(@HELP 
飞花剑法 之 「花落谁家」： 

        使用功效： 
                连续打击对手的气血
        出招类型：   
                busy 型外功  
                无隐藏攻击
                叛师不可带出   
        出手要求： 
HELP);  
write(temp);  
return 1;  
}
