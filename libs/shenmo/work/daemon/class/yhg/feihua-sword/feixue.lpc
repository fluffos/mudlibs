
// modify by windy 06/04/28
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"WHT"落花飞雪"NOR"」";  
}

int valid_perform(object me)
{
if (me->query("family/family_name")!="移花宫" && me->query_skill("feihua-sword",1)<350 ) 
        return notify_fail("你还没有资格使用"+name()+"！\n");  
if ( me->query("class")!="human" && !me->samsara_check("feihua-sword"))
        return notify_fail("你还不够资格！\n"); 
if( (int)me->query_skill("feihua-sword", 1) < 50 )
        return notify_fail("你的飞花剑法修为太差，难以施展"+name()+"！\n"); 
if( (int)me->query("force") <= 100 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
int mypot,tapot,time;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
if( target->is_busy() )
        return notify_fail(target->name()+"已经够忙了，你使的再漂亮也不会注意到。\n");

mypot=(int)me->query_skill("sword");
mypot=mypot*mypot*mypot/10 + random( (int)me->query("combat_exp"));
tapot=(int)target->query_skill("parry");
tapot=tapot*tapot*tapot/10 + random( (int)target->query("combat_exp"));
time=(int)me->query_skill("feixue-sword", 1) /20;
if ( time > 6 ) time = 6;
if ( time < 2  ) time = 2;
message_vision(HIW"$N凝气在剑，瞬间一股寒流由剑尖汹涌而出！\n"NOR,me, target);
if ( random(mypot + tapot ) > tapot ) 
    {
    message_vision(HIR"$N被这突如其来的寒气，一时之间无从下手！\n"NOR,me, target);
    target->start_busy(time);
    }
else
    {
    message_vision(HIG"不料确被$N看破，攻其不备，$n的寒气竟然被$N避回剑体！\n"NOR,target,me);
    me->start_busy(1+random(2));
    }
return 1;
}

int help(object me)  
{
string temp;
temp = "\t\t"+to_chinese("feihua-sword")+" 50 级\n"; 
temp+= "\t\t内力１００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                牵制对手
        出招类型：   
                busy 型外功  
                无隐藏攻击
                叛师可带出   
        出手要求： 
HELP);  
write(temp);  
return 1;  
}
