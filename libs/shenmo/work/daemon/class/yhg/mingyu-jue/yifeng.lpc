// thunder.c
#include <ansi.h>

inherit SSERVER;

int cast(object me, object target) {
  int success_adj, damage_adj;

  if (me->query("class") != "human")
    return notify_fail("你非人族弟子，不能用「移风起兮」！\n");
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展移风起兮？\n");

  if (time() - (int)me->query_temp("yifeng_cast") < 3 + random(5))
    return notify_fail(YEL "你的魔法尚未恢复！\n" NOR);
  if ((int)me->query("mana") < 100 + 2 * (int)me->query("mana_factor"))
    return notify_fail("你的法力不够！\n");

  if ((int)me->query("sen") < 100)
    return notify_fail("你无法集中精力！\n");

  me->add("mana", -25 - 2 * (int)me->query("mana_factor"));
  me->receive_damage("sen", 50);

  if (random(me->query("max_mana")) < 50) {
    write("你的明玉诀这次竟然失灵了。\n");
    return 1;
  }


  SPELL_D->attacking_cast(
    me,
    //attacker 
    target,
    //target
    "kee",
    //damage type: could be "qi"/"kee", "shen"/"sen", ...default "both"
    HIC "\n$N口中念了句咒文，紧接双手向半空一招，刹那间风声大作，狂风里夹杂着无数的花瓣，利箭般疾速射向$n！\n" NOR,
    //initial message
    HIR "\n结果天昏地暗，无数花瓣已然深深地嵌入到$n的肉里，\n鲜血立时从花瓣间渗了出来，淅淅沥沥洒了满地！\n" NOR,
    //success message
    HIC "$n心知不妙，慌忙闪身，还好只被花瓣擦破了点皮儿。\n" NOR,
    //fail message
    HIC "但是花瓣被$n以法力反激，反向$N射去！\n" NOR,
    //backfire initial message
    HIR "结果无数花瓣深深地嵌入到$n的肉里，鲜血立时从花瓣间渗了出来，淅淅沥沥洒了满地！\n" NOR
    //backfire hit message. note here $N and $n!!!
  );

  if (me->query("family/family_name") != "移花宫")
    me->start_busy(1 + random(2));
  me->set_temp("yifeng_cast", time());
  return 3 + random(5);
}
