
// modify by windy 06/04/28
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIR"夺魂"NOR"」";  
}

int valid_perform(object me)
{
if ( me->query("family/family_name")!="移花宫" && !me->samsara_check("yihua-jiemu", 1))
        return notify_fail("只有移花宫弟子才能使用"+name()+"！\n");  
if(me->query_skill("yihua-jiemu",1) < 50 )
        return notify_fail("你的移花接玉不够娴熟，难以施展"+name()+"！\n"); 
if( (int)me->query("mana") < 400 )
        return notify_fail("你的法力不足，再怎么吸也吸不动。");
return 1;  
}

int perform(object me, object target)
{
string msg,str;
int extra;
object weapon;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

extra = me->query_skill("yihua-jiemu",1) ;
msg = HIG "\n$N逆运移花心法，双掌带着花瓣刺的$n睁不开眼！" NOR;
if(random((int)me->query("mana")) >= (int)target->query("mana")/2)
    {
    message_vision(msg+"\n",me,target);
    message_vision( HIG "$N只觉得眼前一阵眩晕，元神几乎要脱窍而出！\n" NOR,target);
    target->receive_wound("sen",extra);
    me->receive_curing("sen",extra);
    me->add("mana",-200);
    COMBAT_D->report_sen_status(target);
    }
else
    {
    message_vision(msg+"\n",me,target);
    message_vision( HIB "$N大笑道：雕虫小计，也拿来现丑！\n" NOR,target);
    weapon = me->query_temp("weapon");
    COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
    me->add("mana",-300);
    }
me->start_busy(2);
return 1;
}

int help(object me)  
{
string temp;
temp = "\t\t"+to_chinese("yihua-jiemu")+" 50 级\n"; 
temp+= "\t\t法力 400 点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                吸取对方的精神为己有
        出招类型：   
                busy 型外功  
                无隐藏攻击
                叛师不可带出   
        出手要求： 
HELP);  
write(temp);  
return 1;
}
