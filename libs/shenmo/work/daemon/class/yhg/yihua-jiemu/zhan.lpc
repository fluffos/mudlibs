
// modify by windy 06/04/28
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIC"粘字诀"NOR"」";  
}

int valid_perform(object me)
{
if ( me->query("family/family_name")!="移花宫" && !me->samsara_check("yihua-jiemu", 1))
        return notify_fail("只有移花宫弟子才能使用"+name()+"！\n");  
if(me->query_skill("yihua-jiemu",1) < 400 )
        return notify_fail("你的移花接玉不够娴熟，难以施展"+name()+"！\n"); 
if( (int)me->query("force", 1) < 500 ) 
        return notify_fail("你现在真气不够，强行使用「粘」是发挥不了它的威力的！\n");   
if( me->query_temp("weapon")) 
        return notify_fail("你先放下手中的武器再说吧？！\n");  
return 1;  
}

int perform(object me, object target)
{
int damage; 
string msg; 

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

if( target->is_busy())
        return notify_fail("对方正自顾不暇呢，你不忙使用"+name()+"。\n");   
damage = (int)me->query_skill("yihua-jiemu", 1)/40; 
damage = 2+random(damage);
if(damage > 9) damage = 9;  

msg = CYN "\n$N贯通移花接木绝学，$n似乎看到的全是你的掌影！\n"NOR; 
if(random(me->query("combat_exp")) > target->query("combat_exp")/5)
    {
    target->start_busy(damage); 
    me->add("force", -(damage*40)); 
    me->add("kee", -50);
    msg += HIR"这漫天掌影登时便套得$p跌跌撞撞，身不由主的立足不稳，所有攻击全部无效！\n"NOR;
    }
else
    {
    me->start_busy(1+random(2));
    me->add("kee", -25);
    me->add("force", -150); 
    msg += HIY"$p只觉在$P移花接木笼罩之下，无可抵御，只得只得运劲于足，飘然闪开。\n"NOR; 
    }
message_vision(msg, me, target); 
return 1;
}

int help(object me)  
{
string temp; 
temp = "\t\t"+to_chinese("yihua-jiemu")+" 400 级\n"; 
temp+= "\t\t内力 500 点\n"; 
temp+= "\t\t必须空手\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效：  
                牵制敌人 
        出招类型：    
                busy 型外功   
                无隐藏攻击 
                叛师不可带出    
        出手要求：  
HELP);   
write(temp);   
return 1; 
}
