#include <ansi.h>
inherit SSERVER;
void remove_broken_cloth(object obj);

string name() {
  return "「" HIW "混元一破" NOR "」";
}

int temp_time(object me) {
  if (!me)
    return 100;
  if (me->query("family/family_name") == "东海龙宫" || me->samsara_check("huntian-hammer"))
    return 1 + random(2);
  return 1 + random(3);
}

int valid_perform(object me) {
  int time = temp_time(me);
  if (me->query("family/family_name") != "东海龙宫"
    && !me->samsara_check("huntian-hammer"))
    return notify_fail("非龙宫弟子不能用" + name() + "。\n");
  if (time() - (int)me->query_temp("lg_break") < 10)
    return notify_fail(name() + "需要10秒的冷却时间。\n");
  if (me->query("max_force") < 200)
    return notify_fail("你的内力修为不足 200 点，不能施展" + name() + "。\n");
  if (me->query("force") < 200)
    return notify_fail("你的真气不足 200 点，不能施展" + name() + "。\n");
  if (me->query("sen") < 200)
    return notify_fail("你的精神不足 200 点，不能施展" + name() + "。\n");
  if (me->query_skill("huntian-hammer", 1) < 100)
    return notify_fail("你的" + to_chinese("huntian-hammer") + "等级不足 100 级，无法使出" + name() + "。\n");
  return 1;
}

int perform(object me, object target) {
  object *inv, obj;
  int i, ap, dp, flag = 0;

  if (!valid_perform(me))
    return 0;
  if (!target)
    target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || !me->is_fighting(target))
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "必须在战斗中使用。\n");
  message_vision(HIC "
$N" HIC "运足精神，大喝一声，对着$n" HIC "发出了全力一击！\n" NOR, me, target);
  me->add("force", -150);
  me->receive_damage("sen", 50);
  target->kill_ob(me);
  me->start_busy(1);
  target->start_busy(1 + random(2));
  me->set_temp("lg_break", time());

  ap = me->query_skill("hammer", 1);
  ap += me->query_skill("huntian-hammer", 1);
  ap /= 2;
  ap = ap / 10 * ap * ap;
  ap += me->query("combat_exp");
  ap /= 10000;

  dp = target->query_skill("parry", 1);
  dp += target->query_skill("dodge", 1);
  dp /= 2;
  dp = dp / 10 * dp * dp;
  dp += target->query("combat_exp");
  dp /= 10000;
  if (COMBAT_D->restrain(me, target))
    ap += ap / 5;
  if (COMBAT_D->restrain(target, me))
    dp += dp / 5;

  if (random(ap + dp) <= dp || (int)target->query("spsk") == 6) {
    message_vision(HIC "却被$N躲开了！\n" NOR, target);
    return 1;
  }

  inv = all_inventory(target);
  i = sizeof(inv);
  while (i--) {
    obj = inv[i];
    if (!obj || !objectp(obj))
      continue;
    //        if ( obj->query_autoload()      //下线不掉的    
    if (obj->query("no_break")     //有此标志的
    //          || !obj->query("equipped")    //没装备在身的
    //          || obj->query("owner")==me    //特殊的
    || obj->query("owner_id") == me->query("id"))
      continue;
    obj->unequip();
    obj->set("value", 0);
    obj->set("No_Wear", 1);
    message_vision(HIY "$N" HIY "身上的" + obj->name() + HIY "被打的粉碎！\n" NOR, target);
    obj->set("name", "破碎的" + obj->query("name"));
    //        remove_call_out("remove_broken_cloth");
    //        call_out("remove_broken_cloth",random(25)+5,obj);
    obj->move(environment(target));
    remove_broken_cloth(obj);
    flag++;
  }
  if (flag)
    return 1;
  message_vision(HIR "$N" HIR "躲闪不及，被打个正着！\n" NOR, target);
  target->receive_damage(
    "kee",
    random(me->query("max_force") / 50 + me->query("force_factor")) + 50
  );
  COMBAT_D->report_status(target);
  return 1;
}

void remove_broken_cloth(object obj) {
  if (obj && environment(obj)) {
    tell_object(environment(obj), "一阵微风吹过，" + obj->name() + "化为片片尘土，消失不见了。\n");
    destruct(obj);
  }
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("huntian-hammer") + " 100 级\n";
  temp += "\t\t内    力 200 点\n";
  temp += "\t\t内力修为 200 点\n";
  temp += "\t\t精    神 200 点\n";
  temp += "\t\t战斗状态下使用\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                降低敌人的气血或将其普通装备全部打碎
        出招类型：
                延迟型外功
                带有1秒的busy
                不可以叛师带出
        出手要求：              
HELP);
  write(temp);
  return 1;
}
