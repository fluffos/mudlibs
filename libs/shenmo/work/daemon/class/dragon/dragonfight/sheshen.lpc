#include <ansi.h>
#include <combat.h>
#include "/daemon/skill/eff_msg.h";
inherit SSERVER;

string name()
{
return "「"HIC"舍身技"NOR"」";
}

int temp_time(object me)
{
int mydf,time;
if ( !me )
        return 10;
mydf = me->query_skill("dragonforce",1);
mydf+= me->query_skill("dragonfight",1);
mydf/= 2;
if ( mydf<120 )
        time = 4+random(5);
if ( mydf<250 )
        time = 3+random(5);
if ( mydf<350 )
        time = 2+random(5);
if ( mydf<500 )
        time = 1+random(5);
if ( mydf<700 )
        time = 2+random(4);
if ( mydf<900 )
        time = 2+random(3);
else    time = 1+random(3);
return time;
}       

int valid_perform(object me)
{
int time = temp_time(me);       
if ( !me->query("任务") && me->query("family/family_name")!="东海龙宫" && !me->samsara_check("dragonfight",1))
        return notify_fail("非龙宫弟子不能用"+name()+"。\n");
if ( time()<me->query_temp("lg_sheshen")+time )
        return notify_fail(name()+"需要 "+time+" 秒的冷却时间。\n");
if ( me->query_skill("dragonfight",1)<100 )
        return notify_fail("你的"+to_chinese("dragonfight")+"等级不足 100 级，无法使出"+name()+"。\n");
if ( me->query_skill("dragonforce",1)<100 )
        return notify_fail("你的"+to_chinese("dragonforce")+"等级不足 100 级，无法使出"+name()+"。\n");
if ( me->query_skill("force",1)<100 )
        return notify_fail("你的"+to_chinese("force")+"等级不足 100 级，无法使出"+name()+"。\n");
if ( me->query("force")<300 )
        return notify_fail("你的真气不足 300 点，不能使出"+name()+"。\n");
return 1;
}

int calculate_damage(object me, object target, int base_damage, int damge_bonus);
int check_base_damage(object me,object target);

int perform(object me, object target)
{
string msg, str;
int mydf;
int ap, dp, pp;
int youcps, mycor, mystr, youstr;
int damage_bonus, damage, wound;
int delay;
object ob;

if ( !valid_perform(me) )
        return 0;
if ( !target ) 
        target = offensive_target(me);
if ( !target
  || !target->is_character()
  || !me->is_fighting(target) )
        return notify_fail("不在战斗中，舍什么身？\n");
if ( !me->is_fighting() )
        return notify_fail(name()+"必须在战斗中使用。\n");
me->set_temp("lg_sheshen",time());
if ( me->query("env/no_msg") || target->query("env/no_msg") )
        message_vision(HIB"$N"HIB"使出了舍身技！\n"NOR,me,target);
msg = CYN"$N"CYN"右掌挥出，捣向$n"CYN"的左肩，\n";

mycor = me->query_cor();
youcps = target->query_cps();
ob = target->query_temp("weapon");
if ( ob && objectp(ob) )
        str="手中的"+ob->query("name");
else    str = "右手";        
ap = COMBAT_D->skill_power(me, "unarmed", SKILL_USAGE_ATTACK);
dp = COMBAT_D->skill_power(target,"dodge", SKILL_USAGE_DEFENSE);
dp/=2;
pp = COMBAT_D->skill_power(target,"unarmed", SKILL_USAGE_DEFENSE);
pp/=2;
if ( objectp(ob) )
        pp/=2;
if ( COMBAT_D->restrain(me,target) )
        ap+= ap/3;
if ( COMBAT_D->restrain(target,me) )
        dp+= dp/3;
                
mystr=(me->query_str()+me->query_kar())/2;
youstr=me->query_str();

damage_bonus = (100+me->query("force_factor"))/80*mystr+me->query_temp("apply/damage");

if ( random(youcps) < 15 || random(ap+dp)>dp )
        {
        msg += CYN"$n"CYN"想用"HIC+str+CYN"挡开，不料却被$N"CYN"一把抓住。\n"NOR;
        msg += CYN"$N"CYN"顺势上步，使出了「舍身技」！\n\n" NOR;
        msg += CYN"$N"CYN"左脚铲向$n"CYN"右腿膝盖，"NOR;
        if(random(ap+pp)>pp)
                {
                msg += CYN"结果正铲在$n"CYN"的小腿上。\n" NOR;
                damage=calculate_damage(me, target,check_base_damage(me,target),damage_bonus);
                wound=random(damage-(int)target->query_temp("apply/armor"));
                if(damage>0)
                        {
                        target->receive_damage("kee", damage, me);
                        if(wound>0)
                                target->receive_wound("kee", wound, me);
                        msg+=COMBAT_D->damage_msg(damage, "内伤");
                        if ( !target->is_busy() )
                                target->start_busy(random(3));
                        }
                }
        else msg+= CYN"结果被$n"CYN"提腿挡开了。\n" NOR;
        msg+= CYN "\n紧跟着$N"CYN"收左脚，提左膝撞向$n"CYN"的软肋，\n";
        msg+= "同时右手曲肘撞向$n"CYN"的面门，";
        if(random(ap+pp)>pp || target->is_busy() )
                {
                msg += "结果正中$n。\n" NOR;
                damage=calculate_damage(me, target, check_base_damage(me,target), damage_bonus);
                wound=random(damage-(int)target->query_temp("apply/armor"));
                if(damage>0)
                        {
                        target->receive_damage("kee", damage, me);
                        if(wound>0) target->receive_wound("kee", wound, me);
                        msg+=COMBAT_D->damage_msg(damage, "内伤");
                        }
                if ( target->query("force")>250 )
                        {
                        msg+= CYN"$n"CYN"立刻觉得肋下一麻，真气外泻，浑身不禁一阵酥软。\n"NOR;
                        target->add("force",-250);
                        }
                }
        else msg+= CYN"结果被$n"CYN"挡开了。\n" NOR;
        msg+= CYN"\n$N"CYN"接着顺势用右手抓住$n"CYN"右臂，半转身将$p摔了出去，";
        if(random(ap+pp)>pp || target->is_busy() )
                {
                msg += "结果$n"CYN"一跟头摔在地上。\n" NOR;
                damage=calculate_damage(me, target, check_base_damage(me,target), damage_bonus);
                wound=random(damage-(int)target->query_temp("apply/armor"));
                if(damage>0)
                        {
                        target->receive_damage("kee", damage, me);
                        if(wound>0) target->receive_wound("kee", wound, me);
                        msg+=COMBAT_D->damage_msg(damage, "内伤");
                        }
                if ( !target->is_busy() )
                        target->start_busy(1+random(3));
                }
        else msg+="结果被$n"CYN"一个踉跄，却没摔倒。\n" NOR;
        if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
                message_vision(msg, me, target);
        COMBAT_D->report_status(target, 0);
        target->set_temp("last_damage_from",me);
        }
else    {
        msg += "可是$p看破了$P的企图，向后越开。\n" NOR;
        message_vision(msg, me, target);
        }
me->add("force", -200);
return 1;
}

int calculate_damage(object me, object target, int base_damage, int damage_bonus)
{
int damage;
int myexp, youexp;

damage = base_damage+(damage_bonus+random(damage_bonus))*7/10;
myexp = me->query("combat_exp")/10000;
myexp+= me->query("level")*1000;
youexp = target->query("combat_exp")/10000;
youexp+= target->query("level")*1000;

if ( !userp(me) ) 
        {
        damage+= random(damage/5);
        myexp+= random(myexp/10);
        }
if ( !userp(target) )
        {
        youexp+= random(youexp/10);
        damage-= random(damage/5);
        }
if ( COMBAT_D->restrain(me,target) )
        {
        damage+= random(damage/3);      
        myexp+= random(myexp/10);
        }
if ( COMBAT_D->restrain(target,me) )
        {
        youexp+= random(youexp/10);
        damage-= random(damage/3);
        }
if ( random(youexp)>myexp )
        damage-=damage/3;

if (wizardp(me) && me->query("env/combat")=="verbose")
        tell_object(me, sprintf(GRN "damage: %d\n" NOR, damage));

return damage;
}

int check_base_damage(object me,object target)
{
int base_damage;
if ( !me || !target || !present(me,environment(target)) )
        return 0;
if ( me->query_skill("dragonfight",1)>350 )
        base_damage = 150;
else if ( me->query_skill("dragonfight",1)>200 )
        base_damage = 100;
else    base_damage = 50;
base_damage+= me->query("force_factor")/10;
base_damage+= me->query_temp("apply/damage");
base_damage-= target->query_temp("apply/armor")/5;
base_damage+= me->query_str();
if ( base_damage>300 )
        base_damage = 300;
return base_damage;
}

int help(object me)
{
string temp;    
temp = "\t\t"+to_chinese("dragonfight")+" 100 级\n";
temp+= "\t\t"+to_chinese("dragonforce")+" 100 级\n";
temp+= "\t\t"+to_chinese("force")+" 100 级\n";
temp+= "\t\t内    力 300 点\n";
temp+= "\t\t战斗状态下使用\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");
write(@HELP

        使用功效：
                进身搏击，对敌造成气血上的减少和伤害
        出招类型：
                延迟性外功
                不可以叛师带出
        出手要求：              
HELP);                          
write(temp);
return 1;
}

