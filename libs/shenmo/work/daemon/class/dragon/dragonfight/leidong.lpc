#include <ansi.h>
#include <combat.h>
#include "/daemon/skill/eff_msg.h";
inherit SSERVER;

string name() {
  return "「" HIR "雷动九天" NOR "」";
}

int valid_perform(object me) {
  if (me->query("family/family_name") != "东海龙宫"
    && me->query_skill("dragonfight", 1) < 350)
    return notify_fail("非龙宫弟子不能用" + name() + "。\n");
  if (me->query("class") != "xian" && !me->samsara_check("dragonfight"))
    return notify_fail(name() + "此乃仙家不传之密。\n");
  if (me->query_skill("dragonfight", 1) < 100)
    return notify_fail("你的" + to_chinese("dragonfight") + "等级不足 100 级，无法使出" + name() + "。\n");
  if (me->query_skill("unarmed", 1) < 100)
    return notify_fail("你的" + to_chinese("unarmed") + "等级不足 100 级，无法使出" + name() + "。\n");
  if (me->query_skill("force", 1) < 100)
    return notify_fail("你的" + to_chinese("force") + "等级不足 100 级，无法使出" + name() + "。\n");
  if (me->query("force") < 600)
    return notify_fail("你的真气不足 600 点，不能使出" + name() + "。\n");
  if (me->query("max_force") < 1200)
    return notify_fail("你的内力修为不足 1200 点，不能使出" + name() + "。\n");
  if (time() < me->query_temp("lg_leidong") + 6)
    return notify_fail(name() + "需要6秒的冷却时间。\n");
  return 1;
}

int def;
void perform2(object me, object target);

int perform(object me, object target) {
  string msg;
  int damage, p, time;
  if (!valid_perform(me))
    return 0;
  if (!target)
    target = offensive_target(me);
  if (!target || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(name() + "只能在战斗中使用。\n");
  if (!me->is_fighting())
    return notify_fail(name() + "必须在战斗中使用。\n");
  me->set_temp("lg_leidong", time());
  if (me->query("env/no_msg") || target->query("env/no_msg"))
    msg = MAG "$N" MAG "使出了雷动九天！\n" NOR;
  else msg = RED "突然$N" RED "大喝一声:「雷动」,面色唰的变得通红,须发皆飞,浑身上下充满杀气,\n" NOR;
  message_vision(msg, me, target);
  msg = YEL "\n        “嗡”的一声，一掌凌空击向$n" YEL "的胸口！\n" NOR;
  if (random(me->query("combat_exp")) > random((target->query("combat_exp") / 2))) {
    damage = (int)me->query_skill("dragonfight", 1);
    damage = damage + random(damage / 2);
    def = (int)target->query_temp("apply/armor_vs_force");
    damage -= damage * def / 3000;
    target->receive_wound("kee", damage);
    target->receive_damage("kee", damage / 2);
    me->add("force", -(damage / 4));
    p = (int)target->query("eff_kee") * 100 / (int)target->query("max_kee");
    msg += damage_msg(damage, "内伤");
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(msg, me, target);
    msg = "( $n" + eff_status_msg(p) + " )\n";
    message_vision(msg, me, target);
    target->set_temp("last_damage_from", me);
    if (me->query_skill("dragonfight", 1) > 119)
      perform2(me, target);
  } else {
    me->add("force", -200);
    msg += HIY "可是$p伏地一滚，躲开了对手的攻击。\n" NOR;
    message_vision(msg, me, target);
  }
  return 1;
}

void perform2(object me, object target) {
  int damage, p, skill;
  string msg, weapon;
  weapon = me->query_temp("weapon");

  if (!me || !target
    || !living(target) || !me->is_fighting(target))
    return;
  if ((int)me->query("force", 1) < 300)
    return;
  msg = MAG "\n只见$N衣袍鼓起，猎猎飞舞，身子凌空飞起，又是一声大吼「九天」，\n" NOR;
  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    message_vision(msg, me, target);
  msg = CYN "\n       “哗”的挥出九个光圈，居高临下，直向$n逼来。\n" NOR;
  damage = (int)me->query_skill("dragonfight", 1);
  damage = damage + (int)me->query_skill("unarmed", 1);
  damage = damage + (int)me->query_skill("dragonforce", 1);
  damage = (damage + random(damage)) / 2;
  def = (int)target->query_temp("apply/armor_vs_force");
  damage -= damage * def / 2000;
  target->receive_wound("kee", damage);
  target->receive_damage("kee", damage / 2);
  me->add("force", -random(damage / 10));
  p = (int)target->query("kee") * 100 / (int)target->query("max_kee");
  msg += damage_msg(damage, "内伤");
  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    message_vision(msg, me, target);
  COMBAT_D->report_status(target, damage);
  target->set_temp("last_damage_from", me);
  return;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("dragonfight") + " 100 级\n";
  temp += "\t\t" + to_chinese("unarmed") + " 100 级\n";
  temp += "\t\t" + to_chinese("force") + " 100 级\n";
  temp += "\t\t内    力 600 点\n";
  temp += "\t\t内力修为 1200 点\n";
  temp += "\t\t战斗状态下使用\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                使用东海之力对敌人造成一定的内伤
        出招类型：
                延迟性外功
                350级可以叛师带出
        出手要求：              
HELP);
  write(temp);
  return 1;
}
