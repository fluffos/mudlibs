#include <ansi.h>
inherit SSERVER;

string name() {
  return "「" HIG "无尽风波" NOR "」";
}

int temp_time(object me) {
  int lvl;
  if (!me)
    return 100;
  lvl = me->query_skill("fengbo-cha", 1);
  if (lvl < 120)
    return 15;
  if (lvl < 250)
    return 10;
  if (lvl < 350)
    return 8;
  if (lvl < 700)
    return 5;
  return 3;
}

int valid_perform(object me) {
  int time = temp_time(me);
  if (me->query("family/family_name") != "东海龙宫"
    && !me->samsara_check("fengbo-cha", 1))
    return notify_fail("非龙宫弟子不能用" + name() + "。\n");
  if (me->query_skill("fengbo-cha", 1) < 60)
    return notify_fail("你的" + to_chinese("dragonfight") + "等级不足 60 级，无法使出" + name() + "。\n");
  if (me->query_skill("fork", 1) < 60)
    return notify_fail("你的" + to_chinese("fork") + "等级不足 60 级，无法使出" + name() + "。\n");
  if (me->query("force") < 100)
    return notify_fail("你的真气不足 100 点，不能使出" + name() + "。\n");
  if (time() < me->query_temp("lg_fengbo") + time)
    return notify_fail(name() + "需要 " + time + " 秒的冷却时间。\n");
  return 1;
}

int perform(object me, object target) {
  int ap, dp, time;
  float m_wx, y_wx;
  object weapon;

  if (!valid_perform(me))
    return 0;
  if (!target)
    target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(name() + "只有在战斗中才能使用。\n");
  if (!me->is_fighting())
    return notify_fail(name() + "必须在战斗中使用。\n");
  if (target->is_busy())
    return notify_fail("对方已经够忙的了，你使得再漂亮也没用。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "fork")
    return notify_fail("你使用的武器不对，无法施展" + name() + "。\n");
  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    message_vision(HIC "\n$N" HIC "将" + weapon->name() + "挥展开来，左一叉，右一叉，幻出无数大小光环向
$n" HIC "绕去。虽看起来柔弱无力，却宛若秋波般连绵不绝，实是暗藏杀机！\n\n" NOR, me, target);
  else message_vision(HIC "\n$N" HIC "对$n" HIC "使用了" + name() + HIC "！\n" NOR, me, target);
  me->add("force", -100);

  ap = me->query_skill("fengbo-cha", 1);
  ap /= 30;
  dp = target->query_skill("dodge", 1);
  dp /= 30;
  if (dp <= 1)
    dp = 1;
  m_wx = to_float(me->query("combat_exp") / 10000);
  m_wx = sqrt(m_wx);
  y_wx = to_float(target->query("combat_exp") / 10000);
  y_wx = sqrt(y_wx);
  ap = to_int(m_wx) * ap;
  dp = to_int(y_wx) * dp;
  ap *= me->query("str");
  dp *= target->query("str");
  if (wizardp(me))
    tell_object(me, "ap==" + ap + "  dp==" + dp + "\n");

  if ((me->query("family/family_name") == "东海龙宫" || me->samsara_check("fengbo-cha", 1))
    && target->query("family/family_name") != "东海龙宫")
    ap += ap / 3;
  if (COMBAT_D->restrain(me, target))
    ap += ap / 5;
  if (COMBAT_D->restrain(target, me))
    dp += dp / 5;
  if (wizardp(me))
    tell_object(me, "last ap==" + ap + "  last dp==" + dp + "\n");
  time = ap - dp;
  time /= 8500;
  if (wizardp(me))
    tell_object(me, "time==" + time + "\n");
  if (time > 9) time = 9;
  if (time < 3) time = 3;

  if (random(ap + dp) > dp) {
    message_vision(HIR "\n$n" HIR "果然被这光环套住，当时目瞪口呆，不知所措！\n" NOR, me, target);
    target->start_busy(time);
  } else {
    message_vision(HIR "\n不料确被$n" HIR "看破，攻其不备，$P" HIR "反被打了个措手不及！\n" NOR, me, target);
    me->set_temp("lg_fengbo", time());
    COMBAT_D->do_attack(target, me, target->query_temp("weapon"));
  }
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("fengbo-cha") + " 60 级\n";
  temp += "\t\t" + to_chinese("fork") + " 60 级\n";
  temp += "\t\t内    力 100 点\n";
  temp += "\t\t战斗状态下使用\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                利用东海之力，对敌人造成3-15秒的busy
        出招类型：
                敌人busy状态下不可使用
                失败后自身无busy，但有延迟
                不可以叛师带出
        出手要求：              
HELP);
  write(temp);
  return 1;
}
