#include <ansi.h>
inherit SSERVER;

string name()
{
return "「"HIY"龙啸九天"NOR"」";
}

int temp_time(object me)
{
if ( !me )
        return 100;
if ( me->query("family/family_name")=="东海龙宫" || me->samsara_check("fengbo-cha",1) )
        return 1+random(2);
return 1+random(3);             
}                                               

int valid_perform(object me)
{
int time = temp_time(me);       
if ( me->query("family/family_name")!="东海龙宫" 
    && me->query_skill("fengbo-cha",1)<350 )
        return notify_fail("非龙宫弟子不能用"+name()+"。\n");
if ( me->query("class")!="xian" && !me->samsara_check("fengbo-cha") )
        return notify_fail(name()+"此乃仙家不传之密。\n");
if ( me->query_skill("fengbo-cha",1)<100 )
        return notify_fail("你的"+to_chinese("dragonfight")+"等级不足 100 级，无法使出"+name()+"。\n");
if ( me->query_skill("fork",1)<100 )
        return notify_fail("你的"+to_chinese("fork")+"等级不足 100 级，无法使出"+name()+"。\n");
if ( me->query_skill("dodge",1)<100 )
        return notify_fail("你的"+to_chinese("dodge")+"等级不足 100 级，无法使出"+name()+"。\n");
if ( me->query_skill("force",1)<100 )
        return notify_fail("你的"+to_chinese("force")+"等级不足 100 级，无法使出"+name()+"。\n");
if ( me->query("force")<50 )
        return notify_fail("你的真气不足 50 点，不能使出"+name()+"。\n");
if ( me->query("max_force")<500 )
        return notify_fail("你的内力修为不足 500 点，不能使出"+name()+"。\n");
return 1;
}

int perform(object me, object target)
{
int ap,dp,time,temp,i,lvl;
object weapon;

if ( !valid_perform(me) )
        return 0;
if ( !target ) 
        target = offensive_target(me);
if ( !target
  || !target->is_character()
  || !me->is_fighting(target) )
        return notify_fail(name()+"只有在战斗中才能使用。\n");
if ( !me->is_fighting() )
        return notify_fail(name()+"必须在战斗中使用。\n");
/*
if (!objectp(weapon = me->query_temp("weapon"))
|| (string)weapon->query("skill_type") != "fork")
        return notify_fail("你使用的武器不对，无法施展"+name()+"。\n");
*/
weapon = me->query_temp("weapon");
time = temp_time(me);

message_vision(HIY"
$N"HIY"气沉丹田，身形一变，犹如五爪金龙般腾空而起，使出「龙啸九天」绝招，连续发动进攻！\n"NOR,me,target);
me->add("force", -50);

ap = me->query("combat_exp")/100000;
if ( ap<1 ) ap = 1;
ap+= me->query_skill("fengbo-cha",1);
ap/= 100;
if ( ap<1 ) ap = 1;
dp = target->query("combat_exp")/100000;
if ( dp<1 ) dp = 1;
dp+= target->query_skill("dodge",1);
dp/= 100;
if ( dp<1 ) dp = 1;

if ( wizardp(me) )
        tell_object(me,"ap=="+ap+"  dp=="+dp+"\n");
        
if ( (me->query("family/family_name")=="东海龙宫"||me->samsara_check("fengbo-cha",1))
  && target->query("family/family_name")!="东海龙宫" )
        ap+= ap/3;
if ( COMBAT_D->restrain(me,target) )
        ap+= ap/5;
if ( COMBAT_D->restrain(target,me) )
        dp+= dp/5;
temp = ap-dp;   
lvl = me->query_skill("fork",1);
lvl+= me->query_skill("force",1);
lvl+= me->query_skill("fengbo-cha",1);
lvl/= 200;
if ( lvl<2 )  lvl = 2;
if ( lvl>9 )  lvl = 9;
if ( wizardp(me) )
        tell_object(me,"lvl==="+lvl+"  temp==="+temp+"\n");

me->add_temp("apply/damage",temp);
me->add_temp("apply/dodge",temp);
for(i=0;i<lvl;i++)
        COMBAT_D->do_attack(me,target,weapon,2);

me->add_temp("apply/damage",-temp);
me->add_temp("apply/dodge",-temp);
me->start_busy(time);   
return 1;
}

int help(object me)
{
string temp;    
temp = "\t\t"+to_chinese("fengbo-cha")+" 100 级\n";
temp+= "\t\t"+to_chinese("fork")+" 100 级\n";
temp+= "\t\t"+to_chinese("dodge")+" 100 级\n";
temp+= "\t\t"+to_chinese("force")+" 100 级\n";
temp+= "\t\t内    力 50 点\n";
temp+= "\t\t内力修为 500 点\n";
temp+= "\t\t战斗状态下使用\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");
write(@HELP

        使用功效：
                对敌人连续攻击
        出招类型：
                busy型外功
                350级可以叛师带出
        出手要求：              
HELP);                          
write(temp);
return 1;
}
