
// modify by windy 06/05/07
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIC"万刃归一"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "将军府" && !me->samsara_check("wusi-mace", 1))
        return notify_fail("从哪里偷学的武功，也想用"+name()+"?\n");
if( (int)me->query_skill("wusi-mace", 1) < 100 )
        return notify_fail("你的无私锏法修为不够，还用不出"+name()+"！\n"); 
if( (int)me->query_skill("lengquan-force", 1) < 80 )
        return notify_fail("你的冷泉神功修为不够，还用不出"+name()+"！\n"); 
if( me->query("str") < 22 )
        return notify_fail("你的先天膂力孱弱, 不能使用"+name()+"！\n");
if( me->query("force") < 500 )
        return notify_fail("你的内力不足！\n");
return 1;  
}
int perform(object me)
{
string msg;
object weapon, weapon2, target;
int skill, skill1, skill2, ap, dp, damage;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
if (!objectp(weapon2 = target->query_temp("weapon")))
        return notify_fail("对方没有使用兵器，你用不了"+name()+"。\n");
 me->clean_up_enemy();
skill = me->query_skill("lengquan-force",1);
skill1 = me->query_skill("wusi-mace",1);
skill2 = me->query_skill("dodge",1);
weapon = me->query_temp("weapon");
weapon2 = target->query_temp("weapon");
damage = (int)me->query_skill("lengquan-force", 1);
damage = damage +  (int)me->query_skill("wusi-mace", 1);
damage = damage +  (int)me->query_skill("mace", 1);
ap = me->query_skill("mace") / 4 + (skill1 / 3);
dp = target->query_skill("dodge") / 2;
if( dp < 1 )  dp = 1;
msg = HIC "$N手中"+weapon->name()+""HIC"迎面一架，斜刺一拉，好一招「万刃归一」!\n$N手中"+weapon->name()+""HIC"正好锁在$n的"+weapon2->name()+"上。\n";
message_vision(msg, me, target);
if( random(ap) > random(dp) )
    {
    if(userp(me))
    me->add("force",-150);
    msg = HIW"$n顿时觉得一股强大的力量传向自己的手腕，手中";
    msg += weapon2->name();
    msg += "脱手飞出! \n"NOR;
    msg += HIR"同时逆血冲上心头，忍不住吐出一口鲜血.\n"NOR;
    me->start_busy(random(2));
    target->receive_damage("kee", damage, me);
    target->start_busy( (int)me->query_skill("wusi-mace") / 20 + 1);
    if (weapon2->query("no_get") || weapon2->query("no_drop") || weapon2->query("warcity")) 
    destruct(weapon2); 
    else
    weapon2->move(environment(me));
    }
else
    {
    if(userp(me))
    me->add("force",-50);
    msg = RED"$n急运内力，将手中" + weapon2->name()+
    "斜斜顺势一送一搭，抽了回来。\n"NOR;
    me->start_busy(4+random(2));
    }
message_vision(msg, me, target);
return 1;
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("lengquan-force")+" 80 级\n"; 
temp+= "\t\t"+to_chinese("wusi-mace")+" 100 级\n"; 
temp+= "\t\t对手必须有兵器\n"; 
temp+= "\t\t先天臂力 22 \n"; 
temp+= "\t\t内力 500 点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP  

        使用功效： 
                夺取对方武器并给对方强有力的一击
                成功后还可以牵制对手
        出招类型： 
                busy型外功
                无隐藏攻击 
                叛师不可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
