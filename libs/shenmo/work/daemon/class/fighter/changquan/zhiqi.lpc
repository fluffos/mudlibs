// 窒气诀

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
	string msg;
	int delay,myunarmed;

	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("[窒气诀]只能在战斗中使用\n");

	if(me->query("family/family_name") != "将军府")
                return notify_fail(HIR"「窒气诀」"+NOR"是将军府不传之密！\n");
 if( time()-(int)me->query_temp("zhiqi_end") < 3 )
          return notify_fail("绝招用多就不灵了！\n");

	myunarmed=(int)me->query_skill("changquan",1);
	if(myunarmed<60) 
		return notify_fail("你的长拳修为不够深，无法使用[窒气诀]。\n");

	if( target->is_busy() )
		return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧！\n");

       if( me->query("env/brief_message") || target->query("env/brief_message") )
                msg = HIW"$N"HIW"对$n"HIW"施展了「"HIM"窒气诀"HIW"」。\n"NOR;
	else     msg = HIY"$N收拳发力，招化长拳之秘奥义[窒气诀]向$n攻去！\n"NOR;

	if( random(me->query("combat_exp")) > (int)target->query("combat_exp")/2 ) {
		delay = random(myunarmed/20);
              if (delay>5) delay=5;
		target->start_busy(delay);
		me->start_busy(random(3));
              if( me->query("env/brief_message") || target->query("env/brief_message") )
                        msg+= HIR"结果造成"HIY+delay+HIR"秒的动作僵硬。\n"NOR;
	else	msg += HIB "$n被一阵拳风扫中，身形不由慢了下来。\n" NOR;
	} else {
              if( me->query("env/brief_message") || target->query("env/brief_message") )        
                        msg+= HIR"结果$n"HIR"成功闪避。\n"NOR;
	  else	msg += HIG "可是$p连跳了几步，闪开了这阵拳风！\n" NOR;
	
	}
	message_vision(msg, me, target);
          me->set_temp("zhiqi_end",time());
	return 1;
}
