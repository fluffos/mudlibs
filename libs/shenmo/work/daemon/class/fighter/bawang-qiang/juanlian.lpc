
// modify by windy 06/04/28
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIC"珍珠倒卷帘"NOR"」";  
}

int valid_perform(object me)
{
if ( me->query("family/family_name")!="将军府" && me->query_skill("bawang-qiang",1)<350 ) 
        return notify_fail("你还没有资格使用"+name()+"！\n");  
if ( me->query("class")!="human" && !me->samsara_check("bawang-qiang"))
        return notify_fail("你还不够资格！\n"); 
if( time()-(int)me->query_temp("juanlian_end") < 2+random(2) ) 
        return notify_fail("绝招用多就不灵了！\n"); 
if((int)me->query_skill("bawang-qiang", 1) < 100) 
        return notify_fail("你的霸王枪法修为太差，难以施展"+name()+"！\n"); 
if( (int)me->query("max_force") < 500 ) 
        return notify_fail("你的内力修为不够！\n"); 
if( (int)me->query("force") < 300 ) 
        return notify_fail("你的内力不足！\n"); 
if( (int)me->query("sen") < 100 ) 
        return notify_fail("你现在精神太差！\n"); 
return 1;  
}

int perform(object me, object target)
{
int extra;
object weapon;

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
extra = me->query("level")/2;
weapon = me->query_temp("weapon");
message_vision(HIC"\n$N将手中大枪一抖，由下而上翻将上来，一股大力向$n狂涌而至，如流沙河水，天幕倒垂！\n"NOR,me,target); 
me->add_temp("apply/attack", extra); 
me->add_temp("apply/damage", extra);
COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR); 
COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR); 
COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR); 
me->add_temp("apply/attack", -extra); 
me->add_temp("apply/damage", -extra); 
me->add("force", -100);
me->add("sen", -50);
me->set_temp("juanlian_end",time());
return 1; 
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("bawang-qiang")+" 100 级\n"; 
temp+= "\t\t内力修为五年\n"; 
temp+= "\t\t内力３００点\n"; 
temp+= "\t\t精神１００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                连续打击对手的气血
        出招类型： 
                延时型外功
                无隐藏攻击
                叛师可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
