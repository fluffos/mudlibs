#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target)
{
        string msg;
        int damage, ap, dp;
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me
        ||      !me->is_fighting(target)
        ||      !living(target))
                return notify_fail("你要对谁施展这一招"HIR"「满江红」"NOR"？\n");        
        if( (int)me->query_skill("bawang-qiang", 1) < 100 
        ||  (int)me->query_skill("spear", 1) < 100 
        ||  (int)me->query_skill("lengquan-force", 1) < 100)
                return notify_fail("你的功夫还不到家，用"HIR"「满江红」"NOR"太危险了。\n");
        if( (int)me->query("max_force") < 1200 )
                return notify_fail("以你现在的内功修为还使不出「满江红」。\n");
     if ( me->query("叛师/num") )
        return notify_fail("你叛过师，无法使用\n");   

        if( (int)me->query("force") < 1200 )
                return notify_fail("你的真气不够！\n");
        if((string)me->query("family/family_name")!="将军府")
                return notify_fail("你运了半天的内劲，就是用不出来。");
        me->start_busy(1);
       target->start_busy(3+random(1));
        me->add("force", -100-(int)me->query("force_factor"));
        me->receive_damage("kee", 30);
        msg = HIR "\n$N看似烂醉如泥，却趁着醉意吟出一首词来！\n" NOR;
        ap = (int)me->query("combat_exp");
        dp = target->query("combat_exp");
          if( ap*3+random(dp) > dp )
   if((int)me->query_skill("bawang-qiang",1) > 799) { 
            call_out("perform8", 0, me, target);
            call_out("perform7", 0, me, target);
            call_out("perform6", 0, me, target);
            call_out("perform5", 0, me, target);
            call_out("perform4", 0, me, target);
            call_out("perform3", 0, me, target);
            call_out("perform2", 0, me, target);
            call_out("perform1", 0, me, target);
    }
   else    if((int)me->query_skill("bawang-qiang",1) > 699) { 
            call_out("perform7", 0, me, target);
            call_out("perform6", 0, me, target);
            call_out("perform5", 0, me, target);
            call_out("perform4", 0, me, target);
            call_out("perform3", 0, me, target);
            call_out("perform2", 0, me, target);
            call_out("perform1", 0, me, target);
    }
   else    if((int)me->query_skill("bawang-qiang",1) > 599) { 
            call_out("perform6", 0, me, target);
            call_out("perform5", 0, me, target);
            call_out("perform4", 0, me, target);
            call_out("perform3", 0, me, target);
            call_out("perform2", 0, me, target);
            call_out("perform1", 0, me, target);
    }
   else    if((int)me->query_skill("bawang-qiang",1) > 499) { 
             call_out("perform5", 0, me, target);
             call_out("perform4", 0, me, target);
             call_out("perform3", 0, me, target);
             call_out("perform2", 0, me, target);
             call_out("perform1", 0, me, target);
    }
   else    if((int)me->query_skill("bawang-qiang",1) > 399) { 
             call_out("perform4", 0, me, target);
             call_out("perform3", 0, me, target);
             call_out("perform2", 0, me, target);
             call_out("perform1", 0, me, target);
    }
   else    if((int)me->query_skill("bawang-qiang",1) > 299) { 
             call_out("perform3", 0, me, target);
             call_out("perform2", 0, me, target);
             call_out("perform1", 0, me, target);
    }
   else    if((int)me->query_skill("bawang-qiang",1) > 199) { 
             call_out("perform2", 0, me, target);
             call_out("perform1", 0, me, target);
    }
    else         {           call_out("perform1", 0, me, target); }
          else
                msg += HIR "\n没想到$N醉的太厉害，词还没吟出来就醉倒在地。\n" NOR;
                me->start_busy(3);
                message_vision(msg, me, target);
                if( damage > 0 ) 
                COMBAT_D->report_status(target);
                if( !target->is_fighting(me) ) 
                {
                        if( living(target) ) 
                        {
                                if( userp(target) ) target->kill_ob(me);
                                else target->kill_ob(me);
                        }
                }
                return 1;
}

int perform1(object me, object target)
{
        int damage;
        string msg;
        msg = HIR "$n似乎也感受到了$N的那股悲壮的情怀！\n\n『怒发冲冠，凭栏处，潇潇雨歇。』 \n"NOR;
        damage = (int)me->query_skill("spear");
        damage -= (int)target->query_skill("dodge", 1);
                    target->receive_damage("kee", damage, me);
                    target->receive_wound("kee", damage/4, me);
                    me->improve_skill("bawang-qiang", 1, 1);
        message_vision(msg, me, target);
        message_vision(HIW "$N趁着$n思考词义之时，又刺出一枪。" NOR ,me,target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
                        me->start_busy(2+random(2));
        return 1;
}
int perform2(object me, object target)
{
        int damage;
        string msg;
        if(!living(target)) 
                  return notify_fail("对手已经不能再战斗了。\n");
        if(!me->is_fighting(target))
                  return notify_fail("对手已经不能再战斗了。\n");                          
        if (environment(me)!=environment(target)) return notify_fail("可惜对手已经跑了。\n");
        msg = HIR "『抬望眼，仰天长啸，壮怀激烈』\n"NOR;
        damage = (int)me->query_skill("spear");
        damage -= (int)target->query_skill("dodge", 1);
                    target->receive_damage("kee", damage, me);
                    target->receive_wound("kee", damage/4, me);
                    me->improve_skill("bawang-qiang", 1, 1);
        message_vision(msg, me, target);
        message_vision(HIW "$N趁着$n思考词义之时，又刺出一枪。" NOR ,me,target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
                        me->start_busy(2+random(2));
        return 1;
}
