// 回马枪back.c 
//snowtu

#include <ansi.h>
inherit SSERVER;

void remove_effect(object me);
mapping default_dirs = ([
        "north":                "北",
        "south":                "南",
        "east":                 "东",
        "west":                 "西",
        "northup":              "北边",
        "southup":              "南边",
        "eastup":               "东边",
        "westup":               "西边",
        "northdown":            "北边",
        "southdown":            "南边",
        "eastdown":             "东边",
        "westdown":             "西边",
        "northeast":            "东北",
        "northwest":            "西北",
        "southeast":            "东南",
        "southwest":            "西南",
        "up":                   "上",
        "down":                 "下",
        "enter":                "里",
        "out":                  "外",
        "left":                 "左",
        "right":                "右",

]);


string name()  
{
return "「"HIY"罗家回马枪"NOR"」";  
}

int valid_perform(object me)
{
if (me->query("family/family_name")!="将军府" && !me->samsara_check("bawang-qiang", 1))
        return notify_fail(name()+"是将军府不传之秘！\n");
if ( (int)me->query_skill("bawang-qiang",1)<80 )
        return notify_fail("你的霸王枪法修为不够，还用不出"+name()+"！\n"); 
if ( (int)me->query_skill("yanxing-steps",1)<80 )
        return notify_fail("你的雁行步法修为不够，还用不出"+name()+"！\n"); 
if ( (int)me->query_skill("lengquan-force",1) < 80)
        return notify_fail("你的冷泉神功修为不够，还用不出"+name()+"！\n"); 
if ( me->query_temp("jjf_back") )
        return notify_fail(name()+"不可滥用！\n");
if ( (int)me->query("max_force")<500 )
        return notify_fail("你的内力修为不够！\n");
if ( (int)me->query("force")<200 )
        return notify_fail("你的内力不足！\n");
return 1;  
}

int perform(object me, object target)
{
int ap,dp,mace,spear,i,flag=0;
object ride,env1;
mapping exit;
string msg,*exits,dir;

if ( !valid_perform(me) )
        return 0;
if ( !target )
        target = offensive_target(me);

if ( !target
  || !target->is_character()
  || target->is_corpse()
  || target==me)
        return notify_fail("你要对谁施展"+name()+"？\n");
if ( !me->is_fighting() )
        return notify_fail(name()+"只能在战斗中使用！\n");

spear = me->query_skill("bawang-qiang",1);
ride = me->query_temp("ridee");
env1 = environment(me);
if ( !mapp(exit=env1->query("exits")) )
        return notify_fail("此地为绝地死巷，难以施展"+name()+"。\n");

exits = keys(exit);
for(i=0;i<sizeof(exit);i++)
        {
        if ( !exit[exits[i]] )  continue;
        if ( exit[exits[i]]->query("no_fight")
          || exit[exits[i]]->query("no_fight")
          || env1->valid_leave(me,exit[i])==0 )
                continue;
        flag++;
        dir = exits[i];
        }
if ( flag<1 )
        return notify_fail("此地为绝地死巷，难以施展"+name()+"。\n");

msg = YEL"\n$N"YEL"战罢多时，虚晃一枪，抽身往"+default_dirs[dir]+"便走！\n\n"NOR;
message_vision(msg,me,target);
me->set_temp("jjf_next_room",exit[dir]);
me->add("force",-100);
me->set_temp("jjf_back",1);
me->start_call_out( (: call_other, __FILE__, "remove_effect", me :), 2+random(4) );
if ( ride )
        ride->move(me->query_temp("jjf_next_room"));
me->move(me->query_temp("jjf_next_room"));
message_vision(YEL"$N"YEL"倒拖着大枪"YEL"急急忙忙地走了过来。\n"NOR,me);

ap = me->query_cor()+me->query_kar()+me->query_int();
dp = target->query_cor()+target->query_kar()+target->query_int();
if ( ap<random(dp) )
        {
        msg = sprintf(YEL"%s"YEL"只觉其中有诈，停住脚步，并不追赶。\n"NOR,target->name());
        message("vision",msg,environment(target),target);
        tell_object(target,CYN"你觉得"+me->name()+CYN"败像外露，内藏玄机，不由停住了脚步。\n"NOR);
        tell_object(me,YEL"你的计谋给别人看穿了。。。\n"NOR);
        if ( ride )
                ride->move(environment(target));
        me->move(environment(target));
        message_vision(YEL"\n$N"YEL"无奈之下，只得又回头再战。。。\n\n"NOR,me,target);
        me->add("force",-50);
        return 1;
        }
msg = sprintf(CYN"%s"CYN"见状，大呼一声：尔往哪里走？！，%s追将下去。\n"NOR,
                target->name(),
                objectp( ride=target->query_temp("ridee") )?"一提缰绳，":"" );
message("vision",msg,environment(target),target);
tell_object(target,YEL"你哪里肯放过对手，连忙追了过去。\n"NOR);
if ( ride )
        ride->move(me->query_temp("jjf_next_room"));
if ( target->move(me->query_temp("jjf_next_room")) )
        {
        tell_object(me,YEL+target->name()+YEL"追了过来！。\n"NOR);
        message_vision(HIW"$n"HIW"一见$N"HIW"，分外眼红，大喝一声“尔往哪里走！”\n"NOR,me,target);
        target->start_busy(1);
        if ( !target->is_fighting(me) )
                {
                if ( userp(target) )
                        target->fight_ob(me);
                else    target->kill_ob(me);
                }
        if ( spear<150 )
                {
                i = spear/40;
                msg = YEL"$N"YEL"见$n"YEL"追了过来，不由暗喜，手中大枪的枪头猛然从地上弹起，回身便是"+chinese_number(i+1)+"枪！\n"NOR;
                message_vision(msg,me,target);
                if ( me->query("family/family_name")!="将军府" )
                        spear/= 5;
                me->add_temp("apply/damage",spear);
                me->add_temp("apply/dodge",spear);
                me->add_temp("apply/attack",spear);
                while(i--)
                        COMBAT_D->do_attack(me,target,me->query_temp("weapon"));
                me->add_temp("apply/damage",-spear);
                me->add_temp("apply/dodge",-spear);
                me->add_temp("apply/attack",-spear);
                return 1;
                }
        else    {
                mapping w_action;
                int damage;
                string damage_type,*limbs,limb;

                limbs = target->query("limbs");
                limb = limbs[random(sizeof(limbs))];

                msg = HIR"$N"HIR"见$n"HIR"追了过来，突然停住脚步，扭身旋枪，闪电般对着$n"HIR"就是一击！\n"NOR;
                w_action = me->query("actions");
                msg+= "\n"+w_action["action"]+"！\n"NOR;
                if ( me->query("combat_exp")>random(target->query("combat_exp")/2) )
                        {
                        damage = w_action["damage"];
                        damage*= 3;
                        damage = damage/2+random(damage/2);
                        if ( me->query("family/family_name")!="将军府" )
                                damage/= 4;
                        if ( damage<10 )
                                damage = 10;
                        damage_type = w_action["damage_type"];
                        msg+= COMBAT_D->damage_msg(damage,damage_type);
                        msg = SDS_D->no_color_msg(msg);
                        msg = HIR+msg+NOR;
                        msg = replace_string(msg,"$w",me->query_temp("weapon")->name());
                        msg = replace_string(msg,"$l",limb);
                        message_vision(msg,me,target);
                        target->receive_damage("kee", damage,me);
                        COMBAT_D->report_status(target);
                        }
                else    {
                        msg+= HIM"$n"HIM"见状，慌忙停步，堪堪闪了过去。。。。\n"NOR;
                        message_vision(msg,me,target);
                        }
                if ( me->query_skill("bawang-qiang",1)<250 )
                        return 1;
                mace = me->query_skill("wusi-mace",1);
                if ( mace>=250 && present(target,environment(me)) )
                        {
                        msg = YEL"$N"YEL"一枪刺毕，顺势跨步上前，抽枪头，现枪攥，以枪作锏，又是一击！\n"NOR;
                        w_action = ("/daemon/skill/wusi-mace.lpc")->query_action(me,me->query_temp("weapon"));
                        msg+= "\n"+w_action["action"]+"！\n"NOR;
                        if ( me->query("combat_exp")>random(target->query("combat_exp")/3) )
                                {
                                damage = w_action["damage"];
                                damage = damage+random(damage*3);
                                if ( me->query("family/family_name")!="将军府" )
                                        damage/= 3;
                                if ( damage<10 )
                                        damage = 10;
                                damage_type = w_action["damage_type"];
                                msg+= HIY+COMBAT_D->damage_msg(damage,damage_type)+NOR;
                                msg = replace_string(msg,"$w",me->query_temp("weapon")->name());
                                limbs = target->query("limbs");
                                limb = limbs[random(sizeof(limbs))];
                                msg = replace_string(msg,"$l",limb);
                                msg = SDS_D->no_color_msg(msg);
                                msg = HIY+msg+NOR;
                                message_vision(msg,me,target);
                                target->receive_damage("kee", damage,me);
                                COMBAT_D->report_status(target);
                                }
                        else    {
                                msg+= HIC"$n"HIC"见状，慌忙停步，堪堪闪了过去。。。。\n"NOR;
                                message_vision(msg,me,target);
                                }
                        }
                }
        }
else    {
        msg = sprintf(YEL"%s"YEL"只觉其中有诈，停住脚步，并不追赶。\n"NOR,target->name());
        message("vision",msg,environment(target),target);
        tell_object(target,CYN"你觉得"+me->name()+CYN"败像外露，内藏玄机，不由停住了脚步。\n"NOR);
        tell_object(me,YEL"你的计谋给别人看穿了。。。\n"NOR);
        if ( ride )
                ride->move(environment(target));
        me->move(environment(target));
        message_vision(YEL"\n$N"YEL"无奈之下，只得又回头再战。。。\n\n"NOR,me,target);
        me->add("force",-50);
        return 1;
        }        
return 1;
}

void remove_effect(object me)
{
me->delete_temp("jjf_back");
me->delete_temp("jjf_next_room");
message_vision(YEL"\n$N"YEL"把大枪竖在身后，擦了擦额头上的冷汗。\n\n"NOR,me);
}
int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("bawang-qiang")+" ８０级\n"; 
temp+= "\t\t"+to_chinese("lengquan-force")+" ８０级\n"; 
temp+= "\t\t"+to_chinese("yanxing-steps")+" ８０级\n"; 
//temp+= "\t\t必须有坐骑\n"; 
temp+= "\t\t战斗地点必须有出口\n"; 
temp+= "\t\t内力修为五年\n"; 
temp+= "\t\t内力２００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP

        使用功效： 
                连续打击敌人的气血
        出招类型： 
                延时型外功
                配合无私锏法有隐藏攻击 
                叛师不可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
