
// modify by windy 06/05/07
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"RED"霸王不攻"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name")!="将军府" && (int)me->query_skill("bawang-qiang", 1) < 350) 
        return notify_fail("非将军府弟子恐怕难以使用"+name()+"！\n"); 
if ( me->query("class")!="human" && !me->samsara_check("bawang-qiang"))
        return notify_fail("你还不够资格！\n"); 
if((int)me->query_skill("bawang-qiang", 1) < 480) 
        return notify_fail("你的霸王枪法修为不够，还用不出"+name()+"！\n"); 
	if( time()-(int)me->query_temp("bugong_end") < 1+random(2) ) 
        return notify_fail("绝招用多就不灵了！\n");
if((int)me->query("force") < 200 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
string msg;
object weapon;
int i , mkee, b_time;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
if( target->is_busy() )
        return notify_fail(target->name() + "还在犹豫不决，放胆攻击吧。\n");
weapon = me->query_temp("weapon");
b_time = 2 + (int)me->query_skill("bawang-qiang") * 10;
if (b_time>7)  b_time=7;
if (b_time<3)  b_time=3;
msg = CYN "$N手中"RED"长枪"CYN"猛抖，脚踏奇步，登时涌起凛冽杀气，遥罩$n，似攻非攻，似守非守!
"RED"霸王不攻"CYN"一出，$n立时感到若不主动进攻，将陷於被动挨打的劣势。\n";
if( random(me->query("combat_exp")) > (int)target->query("combat_exp")*2 )
        {
        msg += RED "$n连忙上前猛攻,但是却无从着手，不由陷入了两难的境地。\n" NOR;
        target->start_busy(b_time);
        }
else
        {
        msg += "可是$n也并不着急,反而收起兵刃急退数步。\n" NOR;
       
        }
message_vision(msg, me, target);
me->add("force",-200);
me->set_temp("bugong_end",time());
return 1;
}
int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("bawang-qiang")+" 80 级\n"; 
temp+= "\t\t内力２００点\n";  
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP  

        使用功效：  
                牵制敌人
        出招类型：  
                busy 型外功 
                无隐藏攻击 
                叛师可带出  
        出手要求：    
HELP);              
write(temp);  
return 1;  
}
