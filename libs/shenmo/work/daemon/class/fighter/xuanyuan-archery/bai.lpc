//chaofeng.c yushu 2000.10.25

#include <ansi.h>
inherit SSERVER;
int perform(object me, object target) {
  object weapon;
  string msg;
  int ii, req, num_anqi, num_hit, max_hit, hitt, damage, op, opfa, remain;
  string anqi_type, b_unit;

  int wound = 0;

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要攻击谁？\n");

  weapon = me->query_temp("secondary_weapon");
  if (!weapon)
    return 0;
  req = me->query_skill("archery", 1) + me->query_skill("xuanyuan-archery", 1);
  if (me->query_temp("baibu_busy")) return notify_fail("搭弓射箭需要时间呀。\n");
  num_anqi = 100000;
  anqi_type = weapon->name();
  damage = me->query("force_factor") + 10;
  msg = HIW "只见$N手中" + me->query_temp("weapon")->name() + HIW "形如满月，跳跃着耀眼的光芒，无数" + anqi_type + HIW "有如闪电般向$n扑来！\n" NOR;
  max_hit = 1000;
  num_hit = random(max_hit / 2) + (max_hit / 2);
  opfa = 30;
  if (weapon->query("anqi/type") == "震天箭") b_unit = "支";
  else b_unit = "根";
  remain = weapon->query("anqi/now") - num_hit;
  target->receive_damage("kee", damage, me);
  msg += HIW "$n躲闪不及，身上被射中了" + anqi_type + "！\n" NOR;
  message_vision(msg, me, target);
  msg = HIW "$n对着$N笑到道：小子，基础还没有打好就来这里丢人现眼?看我怎么收拾你！\n" NOR;
  message_vision(msg, me, target);
  me->set_temp("baibu_busy", 1);
  call_out("remove_effect", 3 + random(5), me);
  return 1;
}

void remove_effect(object me) {
  if (!me) return;
  me->delete_temp("baibu_busy");
}
