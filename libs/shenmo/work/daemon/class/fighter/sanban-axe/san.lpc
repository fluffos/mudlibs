#include <ansi.h>
inherit SSERVER;

string name()
{
return "「"HIR"三板斧·叁"NOR"」";   
}

int valid_perform(object me) 
{
//if ( me->query("family/family_name")!="将军府"  && me->query("zhuanshi") == 0 )
//        return notify_fail("你是哪儿偷学来的武功，也想用"+name()+"？\n");
if ( !me->samsara_check("sanban-axe",2)  && me->query("class")!="human" )
        return notify_fail("你是哪儿偷学来的武功，也想用"+name()+"？\n");
if ( me->query("叛师/num") ) 
        return notify_fail(name()+"不传三心二意之徒！\n"); 
if ( me->query("force")<me->query("force_factor") ) 
        return notify_fail("你的内力不够！\n"); 
if ( me->query("force")<800 ) 
        return notify_fail("你的内力不足！\n"); 
if ( me->query("kee")<500 ) 
        return notify_fail("你的气血不足，没法子施用外功！\n"); 
if ( me->query_skill("sanban-axe", 1)<350 ) 
        return notify_fail("你对宣花三斧不够熟悉，无法一气呵成地使出"+name()+"！\n");  
if ( me->query_skill("axe", 1)<350 ) 
        return notify_fail("你的基本斧法太差，难以使出"+name()+"！\n");  
if ( me->query_skill("lengquan-force", 1)<350 ) 
        return notify_fail("你的冷泉神功修为太差，无法使出"+name()+"！\n");  
if ( time()<me->query_temp("sanban_pfm_san")+6 ) 
        return notify_fail("绝招用多就不灵了。\n"); 
return 1;   
}

int perform(object me, object target)
{
mapping action,t_action;
string *limbs,limb,str,msg,w_name,tw_name,damage_type;
object weapon,t_weapon,armor;
int i,ap,dp,success=0;
int damage;

if ( !valid_perform(me) ) 
        return 0; 
if ( !target ) 
        target = offensive_target(me);

if ( !target
  || !target->is_character()
  ||  target->is_corpse()
  ||  target==me )
        return notify_fail("你要对谁施展这一招"+HIM"「三板斧·叁」"+NOR"？\n");
if(!me->is_fighting())  
        return notify_fail(name()+"只能在战斗中使用！\n");    


limbs = target->query("limbs");
i = random(sizeof(limbs));
limb = limbs[i];
weapon = me->query_temp("weapon");
if ( !weapon )
        w_name = ({"左","右","双"})[random(3)]+({"拳","掌","爪"})[random(3)];
else    w_name = weapon->name();
t_weapon = target->query_temp("weapon");
if ( !t_weapon )
        tw_name = ({"左","右","双"})[random(3)]+({"拳","掌","爪"})[random(3)];
else    tw_name = t_weapon->name();

action = me->query("actions");

t_action = target->query("actions");

msg = HIW"\n$N"HIW"三招过毕，将手中$w"HIW"狠舞一圈，大喝一声：“$l！”\n\n"NOR;
msg = replace_string(msg,"$w",w_name);
msg = replace_string(msg,"$l",limb);
message_vision(msg,me,target);
me->set_temp("sanban_pfm_san",time());
msg = "\n"+action["action"]+"。\n";
msg = replace_string(msg,"$w",w_name);
msg = replace_string(msg,"$l",limb);
msg = SDS_D->no_color_msg(msg);
msg = HIY+msg+NOR;
message_vision(msg,me,target);

if ( me->query("level")>target->query("level") )
        success++;

if ( COMBAT_D->restrain(me,target) )
        success++;
else if ( COMBAT_D->restrain(target,me) )
        success--;              
ap = me->query("combat_exp");
dp = target->query("combat_exp");
if ( random(ap)>dp/3 )
        success++;
else if ( ap<dp/3 )
        success--;

ap = me->query_int();
dp = target->query_int();
if ( random(ap)>dp/2 )
        success--;
else    success++;

ap = me->query_skill("dodge");
dp = target->query_skill("dodge");
if ( ap>random(dp/3*2) )
        success++;
else    success--;

if ( success<=0 )
        {
        if ( stringp(t_action["parry_msg"]) )
                msg = t_action["parry_msg"];
        else if ( stringp(t_action["dodge_msg"]) )
                msg = t_action["dodge_msg"];
        else    msg = "$N见势不好，连忙纵身闪开，$W"HIY"堪堪从$P的$l旁闪过！\n"NOR;
                
        msg = replace_string(msg,"$l",limb);
        msg = replace_string(msg,"$W",w_name);
        msg = replace_string(msg,"$w",tw_name);
        msg = SDS_D->no_color_msg(msg);
        msg = HIY+msg+NOR;
        message_vision(msg,target,me);
        me->add("force",-200);
        me->receive_damage("kee",300);
        me->receive_wound("kee",200);                                   
        }
else    {
        msg = HIR"但听“喀”的一声，$W"HIR"正中$n的$l！\n"NOR;
        msg = replace_string(msg,"$l",limb);
        msg = replace_string(msg,"$W",w_name);
        msg = replace_string(msg,"$w",tw_name);
        message_vision(msg,me,target);
        target->receive_damage("kee",500,me);
        target->set_temp("last_damage_from",me);

        switch(limb)
                {
                case "头部" :
                case "颈部" :   //要害，必死
                        if ((int)target->query_skill("busi-force", 1)>=500)
                        msg = WHT"\n这一击本可击中要害，但$n"WHT"却鬼使神差地将大斧当了开去！\n\n"NOR;
                        else
                        msg = HIR"\n这一击正中要害，$n"HIR"惨叫一声，立时瘫软在地！\n\n"NOR;
                        message_vision(msg,me,target);
                        if ((int)target->query_skill("busi-force", 1)<500)
                        target->unconcious();
                        break;
                case "胸口" :
                case "后心" :
                case "腰间" :
                        damage = target->query("kee")/2;
                        damage = damage/2+random(damage/2);
                        target->receive_wound("kee",damage,me);
                        COMBAT_D->report_status(target,damage);
                        break;
                
                case "左肩" :
                case "右肩" :
                case "左臂" :
                case "右臂" :
                case "左手" :
                case "右手" :
                        if ( !t_weapon )
                                {
                                if ( !target->is_busy() )
                                        target->start_busy(3);
                                else if ( intp(target->query_busy()) )
                                        target->start_busy(3+target->query_busy());
                                else error(sprintf("%O 's busy is what?\n",target));
                                }
                        else    {
                                message_vision(HIW"\n$n"HIW"手中拿捏不住，"+t_weapon->name()+HIW"立刻脱手飞出丈外！\n\n"NOR,me,target);
                                t_weapon->unwield();
                                target->reset_action();
                                destruct(t_weapon);
                                }
                        break;
                default :
                        damage = target->query("kee")/2;
                        damage = damage/2+random(damage/2);
                        damage-= target->query_temp("apply/armor");
                        if ( damage<100 ) damage = 100;
                        target->receive_wound("kee",damage/3,me);
                        target->receive_damage("kee",damage,me);
                        COMBAT_D->report_status(target);
                        break;
                }
        }

me->receive_damage("kee",200);
me->add("force",-500);
return 1;
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("sanban-axe")+" 350 级\n"; 
temp+= "\t\t"+to_chinese("axe")+" 350 级\n"; 
temp+= "\t\t"+to_chinese("lengquan-force")+" 350 级\n"; 
temp+= "\t\t必须没有叛师纪录\n"; 
temp+= "\t\t内力 800 点\n"; 
temp+= "\t\t气血 500 点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效： 
                给对手的气血造成严重伤害
        出招类型： 
                延时型外功
                无隐藏攻击 
                叛师不可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
