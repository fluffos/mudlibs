
// modify by windy 06/05/07
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIR"雷殛怒火"NOR"」";  
}

int valid_perform(object me)
{
if ( me->query("family/family_name")!="将军府" && me->query_skill("bawang-qiang",1)<350 )
        return notify_fail("就凭你现在的武功修为，也想用"+name()+"?\n");
if ( me->query("class")!="human" && !me->samsara_check("jinglei-mace"))
        return notify_fail("你还不够资格！\n"); 
if (me->query_skill("mace",1) < 120)
        return notify_fail("你的基本锏法修为不够，还用不出"+name()+"！\n"); 
if(me->query_skill("jinglei-mace", 1) < 120) 
        return notify_fail("你的惊雷鞭法修为不够，还用不出"+name()+"！\n"); 
if (me->query_skill("lengquan-force",1) < 120 && !me->samsara_check("jinglei-mace"))
        return notify_fail("你的冷泉神功修为不够，还用不出"+name()+"！\n"); 
if ((int)me->query("force")<1000) 
        return notify_fail("你的内力不够。\n");  
return 1;  
}

int perform(object me, object target)
{
int extra,mylvl,talvl; 
object *inv, ob, weapon; 
string msg;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

mylvl=me->query("level");
talvl=target->query("level");
extra=(int)me->query_skill("jinglei-mace", 1)/2;
extra+=mylvl/2;
weapon = me->query_temp("weapon");

message_vision(HIR"$N招式一缓，手中"+weapon->name()+HIR"仿佛挽了千斤似的，使出了惊雷鞭法的绝学----『雷殛怒火』！\n\n" NOR,me,target);
me->add_temp("apply/attack", extra); 
me->add_temp("apply/damage", extra);
if ( !me->query("env/no_msg") && !target->query("env/no_msg") ) 
message_vision(HIC"$N气运丹田，平平砸出一锏，慢，却嘶嘶作风雷之声。\n"NOR,me); 
COMBAT_D->do_attack(me, target, weapon);
if ( !me->query("env/no_msg") && !target->query("env/no_msg") ) 
message_vision(HIC"$N由静转动，一动便急如风，脚踏奇门，锏走奇招，锏锏从$n意想不到的方位无声无息地砸出！\n" NOR,me,target); 
COMBAT_D->do_attack(me, target, weapon);
if ( !me->query("env/no_msg") && !target->query("env/no_msg") ) 
message_vision(HIC"$N突然收住身形，回步而立，撤锏于背后，无招胜有招，无形胜有形。\n"NOR,me); 
COMBAT_D->do_attack(me, target, weapon);
if ( !me->query("env/no_msg") && !target->query("env/no_msg") ) 
message_vision(HIC"这一招『雷殛怒火』把惊雷鞭法的精髓要旨发挥地酣畅爽快！\n"NOR,me); 
COMBAT_D->do_attack(me, target, weapon);
inv = all_inventory(target);
if ( sizeof(inv) )
ob = inv[random(sizeof(inv))]; 
if ( me->query("family/family_name")=="将军府" && random(talvl)<mylvl/2 && ob && !ob->is_character() && !ob->query("no_break") && (int)target->query("spsk")!=6)
    {
message_vision(HIW"$N锏起处，耳轮中只听得“啪”地一声，$n身上的"+ob->name()+HIW"已被打得粉碎！\n"NOR,me,target); 
message_vision(HIW"$N倒吸了一口冷气，暗叹幸亏身上有个"+ob->name()+HIW"才救了自己一命！\n"NOR,target); 
if (ob->query("id")=="yun dan")
    ob->set_amount((int)ob->query_amount()/2+random((int)ob->query_amount()/2));
else
    destruct(ob); 
    }
me->add_temp("apply/attack", -extra); 
me->add_temp("apply/damage", -extra); 
me->start_busy(2+random(2));
return 1;
}

int help(object me) 
{
string temp; 
temp = "\t\t"+to_chinese("jinglei-mace")+" 120 级\n"; 
temp+= "\t\t"+to_chinese("mace")+" 120 级\n";
temp+= "\t\t"+to_chinese("lengquan-force")+" 120 级\n";
temp+= "\t\t内力１０００点\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP  

        使用功效：  
                连续打击敌人的气血
        出招类型：  
                busy型外功 
                将军府弟子使用时有隐藏攻击
                叛师可带出  
        出手要求：     
HELP);    
write(temp); 
return 1; 
}
