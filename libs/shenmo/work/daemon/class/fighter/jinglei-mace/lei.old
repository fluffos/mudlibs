#include <ansi.h>
inherit PERFORM;

void create()
{

set("name",HIC"雷殛怒火"NOR);
set("class","human");
set("belong","jinglei-mace");
set("base_type","unarmed");
set("target",1);
set("force",1000);
set("need_force",500);
set("damage_type","eff_kee");
set("limit_skill",([
	"jinglei-mace"      :          120,
	"mace"      :          120,
	"lengquan-force"      :          120,

]));
set("busy_self",5);
set("busy_lost",5);


}

void hit_msg(object me,object target,int num)
{
  int damage;
string msg="";
object weapon;

       damage = (int)me->query_skill("jinglei-mace", 1);
       damage += (int)me->query_skill("lengquan-force",1);
            damage += me->query("force_factor")*2;  
            damage+= me->query_temp("apply/damage");
       damage = damage*2/3 + random(damage/3);

      if ( me && target&&num==1 ) {
          set("special_hit",([
         "num"                 :       3, 
        "temp_persent"     :     ({ 120,120,120}),           
        "temp_damage"        :     ({ damage,damage,damage}),                                         
         "success_next"     :     ({ 0,0,1}),        
         "fail_next"        :     ({ 0,0,1}),            
           ]));
                    
           }
      if ( me && target&&num==1 ) {
           weapon=me->query_temp("weapon");
	        msg +=HIC"$N招式一缓，手中"+weapon->name()+HIC"仿佛挽了千斤似的，使出了惊雷鞭法的绝学--『雷殛怒火』！\n\n" NOR;
            msg +=CYN"$N气运丹田，平平砸出一锏，慢，却嘶嘶作风雷之声。\n"NOR;
                     msg+=CYN"这一招『雷霆薄击』挟着内力，却象密云乍现，惊雷含劲欲发！\n\n"NOR;
	message_vision(msg,me,target);
            }
      if ( me && target&&num==2 ) {
                 msg +=CYN"$N由静转动，一动便急如风，脚踏奇门，锏走奇招，锏锏从$n意想不到的方位无声无息地砸出！\n" NOR;
                 msg +=CYN"这一招『天雷荡邪』好似天公作怒，要把天下妖孽尽数劈死，使得个痛快淋漓\n\n" NOR;
	message_vision(msg,me,target);
           }
      if ( me && target&&num==3 ) {
                 msg +=CYN"$N突然收住身形，回步而立，撤锏于背后，无招胜有招，无形胜有形。\n"NOR;
                 msg +=CYN"这一招『雷殛怒火』把惊雷鞭法的精髓要旨发挥地酣畅爽快！\n\n"NOR;
	message_vision(msg,me,target);
           }

return;
}

void success_hit_msg(object me,object target,int num)
{
string msg="";
object weapon=me->query_temp("weapon");

      if ( me && target&&num==1 ) {
                 msg +=HIC"$n只觉得一股劲气象闪电一般，穿体而过！\n"
                                "“哇”的一声，$n喷出一大口鲜血，看来是受了内伤！\n\n"NOR;
	message_vision(msg,me,target);
           }
      if ( me && target&&num==2 ) {
                 msg +=HIC"$n马上手忙脚乱，不知该如何去招架这静若水、快如电的锏法！\n"
        "果不然，$N的"+weapon->name()+HIC"招招命中，$n浑身上下被砸的遍体鳞伤！\n\n"NOR;
	message_vision(msg,me,target);
           }
      if ( me && target&&num==3 ) {
                 msg +=HIC"$n果然上当，以为$N露出破绽，大喜之下，急忙上前想抢攻。\n"
"$N微微一笑，待$n靠近，长袖一抖，袖尽锏出，直探$n的胸口。\n"
"$n连锏影还没看到，就差点儿被穿的透心凉！\n\n"NOR;
	message_vision(msg,me,target);
           }
	
}
 
void lost_hit_msg(object me,object target,int num)
{
string msg="";
object weapon=me->query_temp("weapon");

      if ( me && target&&num==1 ) {
                 msg +=HIC"$n忙运功向抗，深厚的内力将$N的攻势都激散了。\n\n"NOR;
	message_vision(msg,me,target);
           }

      if ( me && target&&num==2 ) {
                 msg +=HIC"$n却心静如水，丝毫不显慌乱，见招拆招，瓦解了$N这无声的攻势。\n\n"NOR;
	message_vision(msg,me,target);
           }

      if ( me && target&&num==3 ) {
                 msg +=HIC"$n看破了这招的虚实，将计就计，假装冲上前，却在$N出锏的一瞬间腾空跃开，回手竟反攻一招！\n\n"NOR;
	   message_vision(msg,me,target);
        COMBAT_D->do_attack(target, me, target->query_temp("weapon"));
           }

	
}



int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("jinglei-mace")+" 120 级\n"; 
temp+= "\t\t"+to_chinese("mace")+" 120 级\n"; 
temp+= "\t\t"+to_chinese("lengquan-force")+" 120 级\n"; 
temp+= "\t\t内力 500 点\n"; 
write(@HELP 

惊雷鞭法 之 「雷殛怒火」：

        使用功效： 
                连续打击对手气血
        出招类型： 
                busy型外功
                无隐藏攻击 
                叛师可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
