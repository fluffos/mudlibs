#include <ansi.h>
inherit SSERVER;
int exert(object me, object target) {
  int lvl, lvl2;
  if (!me->is_fighting())
    return notify_fail("只能在战斗中对敌人使用！\n");
  lvl = me->query_skill("dushen-xinjing", 1);
  if (!target) target = offensive_target(me);
  if (target == me) target = offensive_target(me);
  if ((int)me->query("force") < 500)
    return notify_fail("你的真气不够。\n");
  if (lvl < 100)
    return notify_fail("你的【赌神心经】火候太浅，用不出“飞牌伤人”！\n");
  lvl = me->query_skill("force") * me->query("force") / me->query("max_force");
  lvl2 = target->query_skill("force") * target->query("force") / target->query("max_force");
  message_vision(HIR + "$N默运赌神心经，随手扔出几张扑克牌。\n" + NOR, me);
  if (random((me->query("combat_exp"))) > (int)target->query("combat_exp") / 3) {
    message_vision(
      HIR +
      "$N躲闪不及，被$n发出的扑克牌刺个正着！\n$N中了飞牌以后,仿佛看到了漫天的金币！\n" + NOR, target, me);
    target->receive_damage("kee", target->query("kee"));
    target->receive_wound("kee", target->query("kee"));
    target->start_busy((int)me->query_skill("dushen-xinjing", 1) / 10 + 2);
    target->set_temp("last_damage_from", me);
    target->start_busy(lvl / (lvl2 + 1) + 1);
  } else {
    message_vision(
      HIW +
      "$N觉出危险，身行急退，躲开四处飞散的扑克牌！\n" + NOR, target);
  }
  me->add("force", -5);
  me->start_busy(1 + random(2));
  return 1;
}
