
//qixue.c 泣神十六剑 by windy 06.04.02
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name()
{
return "「"HIR"泣神十六剑"NOR"」";
}

int valid_perform(object me) 
{
if((int)me->query_temp("qishen_jianshi"))
        return notify_fail("你正在以"+name()+"对敌！\n");
if (me->query("yumo_agree")==0)
        return notify_fail("你领悟不了玉魔剑法的精髓。\n"); 
if( (int)me->query("force") < 1000 || (int)me->query("max_force")<12000  )
          return notify_fail("你的内力或内力修为不够。\n");
if( (int)me->query_skill("jadesword",1) < 600 )
           return notify_fail("你的玉魔剑法太低了，难以施展绝技。\n");
if( (int)me->query_skill("sword",1) < 600 )
           return notify_fail("你的基本剑术太低了，难以施展绝技。\n");
return 1; 
}

int perform(object me, object target)
{
object weapon;
string msg;
if ( !valid_perform(me) ) 
        return 0;   
if( !target ) target = offensive_target(me);
if( !target
||      !target->is_character()
||      target->is_corpse()
||      target==me) 
        return notify_fail(name()+"只能对战斗中的对手使用。\n");
if( !me->is_fighting() )
           return notify_fail(name()+"只能在战斗中使用。\n");
if (!objectp(weapon = me->query_temp("weapon"))
|| (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对。\n");

msg = HIC "\n$N右手手中"+weapon->query("name")+HIC"剑尖斜指苍天，左手负手而立，面露凄楚悲怆之情，似有无限伤心往事！" NOR;
msg+= HIC "\n突然间$N双目中精光暴射，身形变得飘忽异常，同时剑芒吞吐，闪烁不定，一路疾风暴雨般的剑法奔腾而出！\n" NOR;
message_vision(msg, me,target);
me->delete_temp("qishen");
me->set_temp("qishen",4);
me->add("force", -200);
me->set_temp("qishen_jianshi", 1);
call_out("checking", 1, me, target);
return 1;
}
void checking(object me, object target)
{
object weapon;
int extra;
weapon = me->query_temp("weapon");
if ( me->query_temp("qishen")  )
    {
    if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
        {
        tell_object(me, "\n你手中无剑，收起了泣神剑势。\n" NOR);
        me->delete_temp("qishen");
        me->delete_temp("qishen_jianshi");
        return;
        }
    else if ( (int)me->query("force") < 200  )
        {
        tell_object(me, "\n你的内力后继不足，难以继续泣神剑势！\n\n" NOR);
        me->delete_temp("qishen");
        me->delete_temp("qishen_jianshi");
        return;
        }
    else if ( me->query_skill_mapped("sword") != "jadesword" )
       {
        tell_object(me, HIR "\n你转而施展其他剑法，无法再以泣神剑势攻敌！\n\n" NOR);
        me->delete_temp("qishen");
        me->delete_temp("qishen_jianshi");
        return;
        }
    else if ( !target || !target->is_character() || !me->is_fighting() ) 
       {
        tell_object(me,  "\n你的对手已经不在，当下收回了泣神剑势。\n\n" NOR);
        me->delete_temp("qishen");
        me->delete_temp("qishen_jianshi");
        return;
        }
    else
       {
        if ( me->query_temp("qishen") ==4 )
        {
        extra = me->query_skill("jadesword",1)/4;
message_vision(HIY"\n$N纵身近前，"+weapon->name()+HIY"陡然直刺，似乎是少林正宗无影剑，却又比无影剑更加轻灵飘逸！\n" NOR, me,target);
        }
        if ( me->query_temp("qishen") ==3 )
        {
        extra = me->query_skill("jadesword",1)/3;
message_vision(HIG"\n$N伸指在"+weapon->name()+HIG"上一弹，剑声嗡嗡，有若龙吟，依稀是仙家三清剑法，只是多了几分威猛霸道！\n" NOR, me,target);
        }
        if ( me->query_temp("qishen") ==2 )
        {
        extra = me->query_skill("jadesword",1)/2;
message_vision(HIR"\n$N剑招突变，"+weapon->name()+HIR"上寒光闪动，竟然使出了魔族七修剑法，可招数来得光明正大，其剑意与七修剑法大相径庭！\n" NOR, me,target);
        }
        if ( me->query_temp("qishen") ==1 )
        {
        extra = me->query_skill("jadesword",1);
message_vision(HIW"\n只见$N手中"+weapon->name()+HIW"随意挥舞，看似不成招式，信手拈来，但是仔细品味起来竟比任何招式都神妙无方！\n" NOR, me,target);
        }
        me->add("force", -100);
        me->add_temp("apply/attack", extra); 
        me->add_temp("apply/damage", extra);
        message_vision(HIY"左一剑！\n" NOR,me,target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        message_vision(HIG"右一剑！\n" NOR,me,target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        message_vision(HIR"上一剑！\n" NOR,me,target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        message_vision(HIW"下一剑！\n" NOR,me,target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        me->add_temp("apply/attack", -extra); 
        me->add_temp("apply/damage", -extra);
        me->set_temp("qishen", me->query_temp("qishen")-1);
        call_out("checking", 2, me, target);
        }
    }
    else
    {
    message_vision(HIC "\n$N回转手中"+weapon->name()+HIC"，仍旧负手而立，「泣神十六剑」已然尽数使出！\n" NOR, me, weapon);
    me->delete_temp("qishen");
    me->delete_temp("qishen_jianshi");
    }
}

int help(object me)
{
string temp;
temp = "\t\t"+to_chinese("jadesword")+" 600 级\n";
temp+= "\t\t"+to_chinese("sword")+" 600 级\n";
temp+= "\t\t内力修为二甲子\n";
temp+= "\t\t内力修６００点\n";
temp+= "\t\t必须在战斗状态下\n";
temp+= "\t\t必须解密\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP

        使用功效：
                连续打击敌人的气血
        出招类型：
                延时型外功
                公共技能
                无隐藏效果
        出手要求：              
HELP);  
write(temp);
return 1;
}
