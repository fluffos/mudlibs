
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name()
{
return "「"HIG"逍遥剑意"NOR"」";
}

int valid_perform(object me) 
{
      if( me->query("yumo_agree")==0 )
          return notify_fail("你领悟不了玉魔剑法的「剑意」。\n");
      if( (int)me->query("force") < 800 || (int)me->query("max_force")<4000  ) 
                return notify_fail("你的内力或内力修为不够。\n");
     if( (int)me->query_skill("jadesword",1) < 200 )
                return notify_fail("你的玉魔剑法太低了，难以施展绝技。\n");
     if( (int)me->query_skill("sword",1) < 200 )
                return notify_fail("你的基本剑术太低了，难以施展绝技。\n");
     if( (int)me->query_skill("jadesword",1) < (int)me->query_skill("sword",1) )
                return notify_fail("你在剑术上的修为尚有许多潜质，不把玉魔剑法练到极致恐怕难以领悟剑意。\n");
      if ( time()<me->query_temp("jianyi")+1 )
                return notify_fail("你正在精心体会玉魔剑法的「剑意」。\n");
return 1; 
}

int perform(object me, object target)
{
string msg;
object *inv, ob, weapon; 
int i,k,damage;
if ( !valid_perform(me) ) 
        return 0;   
if( !target ) target = offensive_target(me);
if( !target
||      !target->is_character()
||      target->is_corpse()
||      target==me) 
        return notify_fail(""+name()+"只能对战斗中的对手使用。\n");
if( !me->is_fighting() )
          return notify_fail("玉魔剑法的「剑意」不在实战中恐怕难以领悟。\n");
if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "sword")
        return notify_fail("你还没有达到手中无剑，心中有剑之境界。\n");

k=random(5);
damage=(int)me->query_skill("jadesword", 1)/2 + random((int)me->query_skill("jadesword", 1)/2);
damage+=random((int)me->query("force_factor"));
inv = all_inventory(target);
if ( sizeof(inv) )
ob = inv[random(sizeof(inv))]; 

if (k==0 && ob && !ob->is_character())
        {
        message_vision(HIY"\n$N身形潇洒飘逸，本可一击毙敌却故意戏弄，用剑尖将$n身上的"+ob->name()+HIY"挑落在地！\n"NOR,me,target);
        if (ob->query("no_get") || ob->query("no_drop") || ob->query("warcity"))
        destruct(ob); 
        else
        ob->move(environment(target));
        }
else if (k==1)
        {
        message_vision(HIG"\n$N激战中突然灵光一现，恍然顿悟，原来这玉魔剑法的最高剑意便是「逍遥」二字！\n"NOR,me);
        message_vision(HIG"\n念及此处，往日练剑时的种种困惑立时迎刃而解。$N狂喜之下，剑光暴长，疾电般向$n刺去！\n"NOR,me,target);
        for (i=0;i<=3+random(4);i++)
                {
                target->receive_damage("kee",damage,me);
                target->receive_wound("kee",damage/3,me);
                COMBAT_D->report_status(target);
                }
        }
else if (k==2 && random(me->query("level"))>target->query("level")/5)
        {
        message_vision(HIC"\n$N剑势如大海狂涛，从四面八方向敌人压去，$n犹如置身狂风暴雨之中，身上几处要穴同时受制！\n"NOR,me,target);
        target->map_skill("spells",0);
        target->map_skill("dodge",0);
        target->map_skill("force",0);
        }
else if (k==3 && !target->is_busy())
        {
        message_vision(HIC"\n$N突然会心一笑，剑招变得怪异无比，看似杂乱无章，其实是随心所欲，但见$n顿时被逼得手忙脚乱！\n"NOR,me,target);
        target->start_busy(2+random(3));
        }
else    {
        message_vision(HIW"\n$N妙悟玉魔剑法「剑意」，顿觉世间万物皆可为剑，招数变得迅猛异常！\n"NOR,me);
        message_vision(HIW"\n$N心剑相通，无所顾忌，剑招连绵不绝，应手而出，三丈之内剑气纵横！\n"NOR,me);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
        COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
        COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
        }
me->set_temp("jianyi", time()); 
me->add("force", -500); 
return 1;
}

int help(object me)
{
string temp;
temp = "\t\t"+to_chinese("jadesword")+" 200 级\n";
temp+= "\t\t"+to_chinese("sword")+" 200 级\n";
temp+= "\t\t必须将玉魔剑法练到极致\n";
temp+= "\t\t内力修为四十年\n";
temp+= "\t\t内力修８００点\n";
temp+= "\t\t必须在战斗状态下\n";
temp+= "\t\t必须解密\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP

        使用功效：
                在战斗中发挥剑法的最高境界
        出招类型：
                延时型外功
                公共技能
                有隐藏效果
        出手要求：              
HELP);  
write(temp);
return 1;
}
