#include <ansi.h>
inherit SSERVER;
string name() {
  return "「" HIG "随心挥舞" NOR "」";
}

int valid_perform(object me) {
  if (me->query("yumo_agree") == 0)
    return notify_fail("你灵台之中杂念太多，难以驾驭玉魔剑法。\n");
  if ((int)me->query_skill("jadesword", 1) < 60)
    return notify_fail("你的玉魔剑法太低了, 还是向别人多请教请教练功的要诀再来演练吧！\n");
  if (me->query("force") < 500)
    return notify_fail("你的内力不够，难以继续演练玉魔剑法！\n");
  if (me->query("sen") < 500)
    return notify_fail("你现在精神太低，无法集中精力演练玉魔剑法！\n");
  return 1;
}

int perform(object me) {
  string msg;
  object weapon;
  int skill, sen_cost, exp, skill2, extra, gain;
  if (!valid_perform(me))
    return 0;
  if (me->is_fighting())
    return notify_fail("玉魔剑法精深奥妙，你还是等到心平气和的时候再演练吧，否则容易走火入魔。\n");

  skill = (int)me->query_skill("jadesword", 1);
  skill2 = (int)me->query_skill("sword", 1);
  extra = skill / 4;
  sen_cost = me->query_skill("literate", 1);
  sen_cost = 1000 - sen_cost;
  if (sen_cost < 100) sen_cost = (int)me->query("int");
  gain = (int)me->query_skill("literate", 1);
  gain += (int)me->query_skill("sword", 1);
  gain -= random((int)me->query_int());
  gain += random(me->query_kar());
  if (gain <= 0) gain = 1;
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("要达到「手中无剑，心中有剑」之剑法最高境界得循序渐进。\n");
  exp = (int)me->query("combat_exp");
  if (skill / 10 * skill / 10 * skill / 10 > exp / 100)
    return notify_fail("你的武学经验不足，无法领会更高深的玉魔剑法！\n");
  if (skill >= skill2)
    return notify_fail("你的基本剑法修为尚浅，难以修炼更高深的玉魔剑法！\n");
  msg = HIG "$N一边揣摩着玉魔剑法的一招一式，一边将手中的" + weapon->name() + HIG "慢慢地挥舞。\n" NOR;
  message_vision(msg, me);
  me->add("force", -200);
  me->add("sen", -sen_cost);

  if (skill < 200)
    me->improve_skill("jadesword", extra);
  else
    me->improve_skill("jadesword", extra + random(gain));
  msg = MAG "$P的「玉魔剑法」进步了！\n" NOR;
  me->delete_temp("qishen_jianshi");
  me->start_busy(random(3));
  message_vision(msg, me);
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("jadesword") + " 60 级\n";
  temp += "\t\t内力５００点\n";
  temp += "\t\t精神５００点\n";
  temp += "\t\t必须在非战斗状态下\n";
  temp += "\t\t必须解密\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                提高玉魔剑法的经验
        出招类型：
                练习型外功
                公共技能
                无隐藏效果
        出手要求：              
HELP);
  write(temp);
  return 1;
}
