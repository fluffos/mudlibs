#include <ansi.h>
inherit PERFORM;

int set_rate(object me,object target)
{
string msg;
int rate,ap,dp,ab,db;
ap = (int)me->query_skill("unarmed");
dp = (int)target->query_skill("parry");
db = (int)target->query_skill("dodge");
ab = (int)me->query_skill("dodge");

if(random(ab)>db/2)
	ab*=4;			//here we compare dodge
else	ab/=4;

if(random(ap)>dp/2)
	ap*=2;			//here we compare parry
else	ap/=2;

//if me dodge > target dodge and me parry > target parry
// so we success
   
rate=(ab+ap)*100/(db+dp);
rate=random(rate*2);
rate+=100;//最少50%的点中概率
msg=sprintf("\nrate：%d\n",rate);
if(wizardp(me))
	tell_object(me,msg);
if (rate > 1000 )
	rate = 1000;
if (rate < 10 )
	rate = 10;
return rate;
}

void create()
{
set("name","点穴");
set("belong","dianxue");
set("base_type","unarmed");
set("target",1);
set("busy_pfm",1);
set("force",1200);
set("need_force",200);
set("limit_skill",([
    "dodge"  : 350,
    "force"  : 350,
    "dianxue"  : 350,
    ]));

set("busy_time",(5+random(5)));
set("busy_lost",(2+random(3)));
}


void hit_msg(object me,object target,int num)
{
int rate;
string dodge_skill,msg,str,*limbs,limb;		//加点描述...
::hit_msg(me,target,num);

rate=set_rate(me,target);
set("persent",rate);

dodge_skill = me->query_skill_mapped("dodge");
if ( dodge_skill )
	{
	str = SKILL_D(dodge_skill+".lpc")->query_dodge_msg("");
	if ( str )
		{
		str = replace_string(str,"$n",HIW"$n");
		str = replace_string(str,"$N",HIW"$N");	
                msg = HIW"战罢多时，$n"HIW"摆了个败势，$N"HIW"见状连忙趋步跟击，"NOR;
                msg+= HIW+str+NOR;
		}	
        else    msg = HIW"$n"HIW"身形晃动，$N"HIW"一点儿一找不到$n"HIW"的身影。\n"NOR;
	}
else    msg = HIW"$n"HIW"身形晃动，$N"HIW"一点儿一找不到$n"HIW"的身影。\n"NOR;    
msg+= HIW"但见$n"HIW"运劲指端，朝着$N"HIW"$l径直点去，$N"HIW"立时间只觉指风刺激的$P的皮肤隐隐作痛！\n"NOR;
limbs = ({
	"人中","肩井","气海","少阳","少阴","三焦","印堂","气平",
});
limb = limbs[random(sizeof(limbs))];
msg = replace_string(msg,"$l",NOR HIR+limb+"穴"NOR HIW);
message_vision(msg,target,me);
}

void success_hit_msg(object me,object target,int num)
{
::success_hit_msg(me,target,num);
message_vision(HIY"「啪」的一声，这一指正中目标，$n立刻"HIY"浑身一麻，动弹不得！\n"NOR,me,target);
}

void lost_hit_msg(object me,object target,int num)
{
::lost_hit_msg(me,target,num);
message_vision(HIB"$n"HIB"冷笑一声说道：“这点伎俩太简单了”\n",me,target);
}
int help(object me)
{
string temp;
temp = "\t\t"+to_chinese("dianxue")+" 350 级\n";
temp+= "\t\t"+to_chinese("dodge")+" 350 级\n";
temp+= "\t\t"+to_chinese("force")+" 350 级\n";
temp+= "\t\t最大内力 1200 点\n";
temp+= "\t\t内力 200 点\n";
write(@HELP
点穴之术  之 「点穴」

        使用功效：
                牵制敌人
        出招类型：
                busy型外功
                公共技能
                无隐藏效果
        出手要求：              
HELP);  
write(temp);
return 1;
}
