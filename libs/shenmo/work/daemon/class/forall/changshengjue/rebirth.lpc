// xiaobutian.c 小补天
// written by mind 2001/2
// /daemon/class/sanxian/butian-force/xiaobutian.c

#include <ansi.h>

int exert(object me, object target, int amount) {
  if (target != me) return notify_fail("别人恐怕难以驾驭你的长生诀内力！\n");


  if ((int)me->query("force") < 100)
    return notify_fail("你的真气不够。\n");

  if (me->query_temp("rebirth_time") > time())
    return notify_fail("绝招用多了，就不灵了。\n");
  write(HIW "你默运长生诀神功，体内一冷一热两股气流交汇于丹田！\n" NOR);

  me->receive_curing("kee", (int)me->query("max_kee"));
  me->receive_curing("sen", (int)me->query("max_sen"));
  me->set("kee", (int)me->query("max_kee"));
  me->set("sen", (int)me->query("max_sen"));
  me->add("force", -100);
  if (me->is_fighting())
    me->set_temp("rebirth_time", time() + 2 + random(2));
  if ((int)me->query_skill("force", 1) > (int)me->query_skill("changshengjue", 1))
    me->improve_skill("changshengjue", (int)me->query_skill("force", 1) / 2);
  return 1;
}
