#include <ansi.h>

inherit F_CLEAN_UP;

string name() { return HIY "他人嫁衣" NOR; }

int exert(object me, object target) {
  int skill, force, mana;
  mixed cd;
  int i;
  string *cds, str;
  if (me->query("jiayi_second") < 2)
    return notify_fail("你还没有学会这项功夫。\n");
  if (me->query_skill("jiayi-force", 1) < 1000)
    return notify_fail("你的武功等级太低了。\n");

  if (me->query_temp("jiayi_time") > time())
    return notify_fail(name() + "用多了，就不灵了。\n");
  if ((int)me->query("force") < 900)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query("kee") < 1500)
    return notify_fail("你的气血不足。\n");
  if ((int)me->query("sen") < 1500)
    return notify_fail("你的精神不足。\n");



  me->receive_curing("kee", (int)me->query("max_kee"));
  me->receive_curing("sen", (int)me->query("max_sen"));
  me->set("kee", (int)me->query("max_kee"));
  me->set("sen", (int)me->query("max_sen"));

  me->set("force", (int)me->query("max_force") * 2);
  me->set("mana", (int)me->query("max_mana") * 2);

  /*
	me->update_condition();
	cd = me->query_entire_conditions();
	me->set_temp("毒",cd);
	if ( !cd || !mapp(cd) )
		{
                tell_object(me,"你没中毒。。。。\n");
		}               
        else {
	cds = keys(cd);
	i = sizeof(cds);
	while(i--)
		{
		if ( file_size("/daemon/condition/"+cds[i]+".lpc")<=0 )
			continue;
		if ( ("/daemon/condition/"+cds[i]+".lpc")->name()=="系统" )
			continue;
		str ="你身中的"+("/daemon/condition/"+cds[i]+".lpc")->name();     
		if ( !("/daemon/condition/"+cds[i]+".lpc")->can_clear() )   {
                        str+= name()+"不能解除。\n";
			continue;
			}
		else    str+= "已经解了。\n";           
		me->clear_condition(cds[i]);   
		}
        tell_object(me,str);
        }
    me->set("force_factor", 0);
    me->delete_temp("no_move");
*/
  tell_object(me, HIW "你运转嫁衣神功，天地之间的精气随之灵动，只见你瞬间神采飞扬，精神抖擞。\n" NOR);

  if (me->is_fighting())
    me->set_temp("jiayi_time", time() + 3 + random(3));
  return 1;
}
