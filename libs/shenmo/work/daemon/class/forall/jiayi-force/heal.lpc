// heal.c

#include <ansi.h>

int exert(object me, object target)
{
        if( me->is_fighting() )
                return notify_fail("战斗中疗伤？找死吗？\n");
        if( (int)me->query("force") < 50 )
                return notify_fail("你的真气不够。\n");

/*
	if( (int)me->query("eff_kee") == (int)me->query("max_kee") )
		return notify_fail("你气血圆满，不需要疗伤。\n");
*/

        if( (int)me->query("eff_kee") < (int)me->query("max_kee") / 3 )
                return notify_fail("你已经受伤过重，只怕一运真气便有生命危险！\n");

        tell_object(me,HIW"你运用嫁衣神功，伤口也渐渐愈合了。\n"NOR);

        me->receive_curing("kee", 20 + (int)me->query_skill("force")/5 );
        me->add("force", -50);
        if ((int)me->query_skill("force", 1) > (int)me->query_skill("jiayi-force", 1) && me->query("jiayi_second") > 1 )
                me->improve_skill("jiayi-force", (int)me->query_skill("force")/3);

        return 1;
}

