//fang@tsrj

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

void check_fight(object me)
{
    if (!me) return;

      if (!me->is_fighting() || me->query("force") < 100) {
                remove_call_out("remove_effect"); 
                 remove_effect(me,(int)me->query_skill("jiayi-force",1)/2);
                }
    else call_out("check_fight", 1, me);
}
int exert(object me, object target)
{
    int skill;
        if( me->query("jiayi_second") < 1 )
            return notify_fail("你还没有学会这项功夫。\n");
        if( me->query_skill("jiayi-force",1) < 440 )
                return notify_fail("你的武功等级太低了。\n");

    if( (int)me->query("force") < 300 )     
        return notify_fail("你的内力不够。\n");
        if( (int)me->query("kee") < 150 )
                return notify_fail("你的气血不足。\n");
        if( (int)me->query("sen") < 150 )
                return notify_fail("你的精神不足。\n");
      if( !me->is_fighting() )
          return notify_fail("你只能在战斗中对对手使用。\n");
    if( (int)me->query_temp("powerup") ) 
        return notify_fail("你已经在运功中了。\n");
        
    skill = me->query_skill("jiayi-force",1);

        

    me->add("force", -300);
    me->receive_damage("kee", 130);
        me->receive_damage("sen", 130);

    message_vision(
HIY"$N凝神运气，大喝一声，身体给一层黄色的圣光罩了起来。\n"NOR, me);


    me->add_temp("apply/armor", skill/2);
        me->add_temp("apply/damage", skill/2);
        me->add_temp("apply/attack", skill/2);
        me->add_temp("apply/strength", skill/2);

    me->set_temp("powerup", 1);

      check_fight(me);
      call_out("remove_effect", skill, me,skill/2);


    return 1;
}

void remove_effect(object me, int amount)
{
        if( !me->query_temp("powerup") ) return;
    amount = me->query_skill("jiayi-force",1)/2;
        me->add_temp("apply/armor", - amount);
        me->add_temp("apply/damage", -amount);
        me->add_temp("apply/attack", -amount);
        me->add_temp("apply/strength", -amount);
    me->delete_temp("powerup");
    tell_object(me, HIY"你的嫁衣心法运行一周天完毕，黄色的圣光渐渐散去。\n"NOR);
        return;
}


