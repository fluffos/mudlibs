#include <ansi.h>

int exert(object me, object target) {
  if (me->is_fighting())
    return notify_fail("战斗中运功疗伤？找死吗？\n");

  if ((int)me->query("force") < 50)
    return notify_fail("你的真气不够。\n");

  if ((int)me->query("eff_kee") < (int)me->query("max_kee") / 2)
    return notify_fail("你已经受伤过重，只怕一运真气便有生命危险！\n");

  write(HIB "你全身放松，神游物外，运起" HIR "[不死印法]" HIB "开始运功疗伤。\n" NOR);

  me->receive_curing("kee", 10 + (int)me->query_skill("force") / 10);
  me->add("force", -50);
  me->set("force_factor", 0);
  if ((int)me->query_skill("force", 1) > (int)me->query_skill("busi-force", 1))
    me->improve_skill("busi-force", (int)me->query_skill("force", 1) / 3);

  return 1;
}
