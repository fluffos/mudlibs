#include <ansi.h>
int exert(object me, object target) {
  if (me->is_fighting())
    return notify_fail("战斗中运功疗伤？找死吗？\n");
  if ((int)me->query("force") < 50)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query("eff_sen") >= (int)me->query("max_sen"))
    return notify_fail("你精神饱满，无需疗伤。\n");
  message_vision(
    HIB "$N" HIB "潜运不死印法，独辟蹊径，将真气缓缓地在体内逆转......\n"
    "瞬间，$N" HIB "吐出一口瘀血，脸色看起来红润多了。\n" NOR,
    me);
  me->receive_curing("sen", 10 + (int)me->query_skill("force") / 2);
  me->add("force", -50);
  return 1;
}
