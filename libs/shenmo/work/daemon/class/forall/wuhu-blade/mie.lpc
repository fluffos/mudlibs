
// modify by windy 06/04/28
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"RED"五虎灭"NOR"」";  
}

int valid_perform(object me)
{
if (me->query_skill("wuhu-blade", 1) < 100)
        return notify_fail("你五虎断门刀还不够娴熟，施展不出"+name()+"。\n");
if (me->query("wuhu_agree") == 0)
        return notify_fail("你还没有掌握五虎断门刀的精华所在。\n");
if( time()-(int)me->query_temp("wuhu_mie") < 3+random(2) ) 
        return notify_fail("绝招用多就不灵了！\n"); 
if ((int)me->query("max_force") < 4000)
        return notify_fail("你的内力修为不够！\n"); 
if((int)me->query("force") < 1000 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
int damage;
string msg;
object weapon;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
if (!objectp(weapon = me->query_temp("weapon"))
|| (string)weapon->query("skill_type") != "blade")
        return notify_fail("你手中无刀，如何施展"+name()+"？\n");

msg = HIR "$N手中的"+weapon->name()+HIR"猛然斩向$n"HIR"头顶，犹如天神下凡，威力无比，正是五虎断门刀中的精髓「五虎灭」！\n"NOR;
if ( random((int)me->query("combat_exp")/10000) > (int)target->query("combat_exp")/60000 )
        {
        msg += HIR"$n见势不妙，急忙闪身，可惜慢了一步，结果呲的一声砍在了肩膀上！\n"NOR;
        message_vision(msg, me, target);
        damage = random(me->query_skill("blade", 1)) + random(me->query_skill("wuhu-blade", 1));
        me->add("force", -300);
        target->receive_damage("kee", damage+random(damage),me);
        target->receive_wound("kee", damage, me);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        if ( random(me->query_cor())>target->query("cor") )
                {
                message_vision(WHT"\n$n惊慌失色，掌中兵器招数散乱，只有招架之功，无有还手之力！\n"NOR,me,target);
                target->map_skill("sword",0);
                target->map_skill("blade",0);
                target->map_skill("staff",0);
                target->map_skill("stick",0);
                target->map_skill("hammer",0);
                target->map_skill("spells",0);
                target->map_skill("spear",0);
                target->map_skill("whip",0);
                target->map_skill("fork",0);
                target->map_skill("qin",0);
                target->map_skill("mace",0);
                target->map_skill("axe",0);
                if (me->query("wuhu_agree")==2)
                target->map_skill("unarmed",0);
                }
        }
else    {
        msg += HIC"可是$n灵敏非凡，于千钧一发之际躲了开来。\n"NOR;
        message_vision(msg, me, target);
        me->add("force", -200);
        }
me->set_temp("wuhu_mie",time());
return 1;
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("wuhu-blade")+" 100 级\n"; 
temp+= "\t\t内力修为四十年\n"; 
temp+= "\t\t内力１０００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                强力伤害敌人的气血
        出招类型： 
                延时型外功
                有隐藏攻击
                公共武功
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
