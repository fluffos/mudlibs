
// write by windy 06/04/28
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIR"六脉惊神"NOR"」";  
}

int valid_perform(object me)
{
if((int)me->query_skill("liumai-shenjian", 1) < 600) 
        return notify_fail("你的六脉神剑修为太差，难以施展"+name()+"！\n"); 
if( time()-(int)me->query_temp("jingshen_end") < 4+random(4) ) 
        return notify_fail("绝招用多就不灵了！\n"); 
if((int)me->query("force") < 2000 ) 
        return notify_fail("你的内力不足！\n"); 
if((int)me->query("sen") < 500 )
        return notify_fail("你的精神不足！\n"); 
if((int)me->query("max_force") < 6000 ) 
        return notify_fail("你的内力修为不够！\n"); 
return 1;  
}

int perform(object me, object target)
{
string msg; 
int extra, ap, dp, ad, dd, am, dm, as, ds; 
object weapon; 
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
weapon = me->query_temp("weapon");
if (weapon) return notify_fail("必须空手才能发出六脉惊神。\n"); 
extra = (int)me->query_skill("liumai-shenjian",1); 
extra += (int)me->query("force_factor"); 
ap = (int)me->query("combat_exp")/10000;
dp = (int)target->query("combat_exp")/10000;
ad = (int)me->query_skill("dodge");
dd = (int)target->query_skill("dodge");
am = (int)me->query("mana") + (int)me->query("max_mana");
dm = (int)target->query("mana") + (int)target->query("max_mana");
as = (int)me->query_skill("sword");
ds = (int)target->query_skill("sword");

message_vision(MAG"$N"MAG"十指连动，忽伸忽缩，或点或按，空中气流激荡，剑气自$N"MAG"指端汹涌而出，此去彼来，连绵无尽。\n" NOR,me,target);
if ( random(ap) > dp/3)
        {
        target->receive_wound("kee", 100+extra*3+random(extra), me);
        target->receive_wound("sen", 100+extra*3+random(extra), me);
        COMBAT_D->report_status(target,0);
        COMBAT_D->report_sen_status(target,0);
        me->receive_damage("sen", 100,target);
        me->add("force", -500,target);
        }
if (random(ad)>dd/3 && (int)me->query_skill("lingbo-weibu", 1)>=600 && me->query_skill_mapped("dodge")=="lingbo-weibu" && (int)target->query_skill("lingbo-weibu", 1)<600)
        {
        message_vision(WHT"$N"WHT"脚踏八卦，施展凌波微步，身形迅捷曼妙无比，这招"HIW"「逍遥劫」"WHT"顿时把$n"WHT"绕了个眼花缭乱！\n" NOR,me,target);
        if (!target->is_busy())
        target->start_busy(2+random(3));
        me->receive_damage("sen", 100,target);
        me->add("force", -500,target);
        }
if (random(am)>dm/3 && (int)me->query_skill("douzhuan-xingyi", 1)>=600 && me->query_skill_mapped("parry")=="douzhuan-xingyi" && (int)target->query_skill("douzhuan-xingyi", 1)<600)
        {
        message_vision(CYN "$N"CYN"左手剑气不断，右手竟然施出斗转星移之绝技，这招"HIC"「星斗落」"CYN"当真气势逼人！\n" NOR,me,target);
        target->receive_wound("sen", 100+extra*2+random(extra), me);
        COMBAT_D->report_sen_status(target,0);
        me->receive_damage("sen", 100,target);
        me->add("force", -500,target);
        }
if (random(as)>ds/3 && (int)me->query_skill("jadesword", 1)>=600 && me->query_skill_mapped("sword")=="jadesword" && (int)target->query_skill("jadesword", 1)<600)
        {
        message_vision(HIG "$N"HIG"妙悟玉魔剑法，指端剑气顿时暴涨数丈，一式"HIR"「剑指灭」"HIG"摧枯拉朽般攻向$n"HIG"！\n" NOR,me,target); 
        target->receive_wound("kee", 100+extra*2+random(extra), me);
        COMBAT_D->report_status(target,0);
        me->receive_damage("sen", 100,target);
        me->add("force", -500,target);
        }
me->set_temp("jingshen_end",time());
return 1; 
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("liumai-shenjian")+" 600 级\n"; 
temp+= "\t\t内力２０００点\n"; 
temp+= "\t\t精神５００点\n"; 
temp+= "\t\t内力修为一甲子\n"; 
temp+= "\t\t必须空手\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                重创敌人
        出招类型： 
                延时型外功
                有隐藏攻击
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
