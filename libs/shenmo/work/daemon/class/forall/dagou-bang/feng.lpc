// write by windy 2006.3.28
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name()
{
return "「"HIG"封"NOR"」字诀";
}
int valid_perform(object me) 
{
if ( me->query("dgbang_agree")==0 )
        return notify_fail("你还没有掌握「封」字诀的要领。\n");
if ( me->query_skill("dagou-bang", 1) < 250 )
        return notify_fail("你的"+to_chinese("dagou-bang")+"修为尚浅，不能施展"+name()+"。\n");
if ( me->query_skill("stick", 1) < 250 )
        return notify_fail("你的"+to_chinese("stick")+"修为尚浅，不能施展"+name()+"。\n");
if ( me->query_skill("force", 1) < 250 )
        return notify_fail("你的"+to_chinese("force")+"修为尚浅，不能施展"+name()+"。\n");
if ( me->query("max_force")<4000 )
        return notify_fail("你的内力修为尚浅，不能施展"+name()+"。\n");
if ( me->query("force")<1000 )
        return notify_fail("你的真气不足，不能施展"+name()+"。\n");
if(me->query_temp("feng_busy"))
        return notify_fail("你现在真气不畅，不能施展"+name()+"。\n");
return 1; 
}

int perform(object me, object target)
{
int mypot,tapot;
if ( !valid_perform(me) ) 
        return 0;   
if( !target ) target = offensive_target(me);
if( !target
||      !target->is_character()
||      target->is_corpse()
||      target==me) 
        return notify_fail(""+name()+"只能对战斗中的对手使用。\n");
if ( !me->is_fighting() )
        return notify_fail(name()+"必须在战斗中使用。\n");
if( target->is_busy() )
        return notify_fail("敌人目前已经手忙脚乱，你就放胆攻击吧。\n");

message_vision(HIG"\n$N身随棒走，东戳西挑，上劈下绊，在$n四周舞出无数的棒花，\n试图将$n"HIG"的所有可能退路全部封死！\n"NOR,me, target);
me->add("sen", -50);
me->add("force", -500);
mypot=me->query_skill("dagou-bang", 1);
tapot=target->query_skill("dodge", 1);
if (mypot*2/3+random(tapot)>tapot)
{
message_vision(HIW"$N"HIW"左躲右闪，却始终跳不出你的棒圈，全身经脉尽被你封住，立时行动不便！\n"NOR,target);
   target->apply_condition("feng", 3+random(2));
}
else
{
message_vision(HIY"$N"HIY"看出此招厉害，慌忙乖巧的向后猛地一纵，跳出了$n的棒圈！\n"NOR,target,me);
}
me->set_temp("feng_busy",1);
call_out("dgbang_feng",5+random(5),me);
return 1;
}
void dgbang_feng(object me)
{
if(!me) return;
me->delete_temp("feng_busy");
}
int help(object me)
{
string temp;
temp = "\t\t"+to_chinese("dagou-bang")+" 250 级\n";
temp+= "\t\t"+to_chinese("force")+" 250 级\n";
temp+= "\t\t"+to_chinese("stick")+" 250 级\n";
temp+= "\t\t内力修为四十年\n";
temp+= "\t\t内力 1000 点\n";
temp+= "\t\t必须在战斗状态下\n";
temp+= "\t\t必须解密\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP

        使用功效：
                封住敌人经脉使敌人长时间行动不便
        出招类型：
                延时型外功
                公共技能
                有隐藏效果
        出手要求：              
HELP);  
write(temp);
return 1;
}
