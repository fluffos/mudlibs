
// write by windy 2006.4.1 
#include <ansi.h> 
#include <combat.h>
inherit SSERVER; 

string name() 
{
return "「"HIW"天下无狗"NOR"」"; 
}
int valid_perform(object me) 
{
    if ( me->query_skill("dagou-bang", 1) < 600 ) 
        return notify_fail("你的"+to_chinese("dagou-bang")+"修为尚浅，不能施展"+name()+"。\n"); 
    if ( me->query_skill("stick", 1) < 600 ) 
        return notify_fail("你的"+to_chinese("stick")+"修为尚浅，不能施展"+name()+"。\n");
    if ( me->query_skill("force", 1) < 600 ) 
        return notify_fail("你的"+to_chinese("force")+"修为尚浅，不能施展"+name()+"。\n");
if ( me->query("dgbang_agree")==0 )
        return notify_fail("你还没有掌握"+name()+"的要领。\n");
    if ( me->query("max_force")<6000 ) 
        return notify_fail("你的内力修为尚浅，不能施展"+name()+"。\n"); 
    if ( me->query("force")<1000 ) 
        return notify_fail("你的真气不足，不能施展"+name()+"。\n"); 
    if(time()-me->query_temp("tianxia_busy")< 4+random(2))
        return notify_fail(name()+"不能用得这么频繁！\n");  
return 1; 
}

int perform(object me, object target)
{
    string msg;
    object weapon;
    int extra, damage;
if ( !valid_perform(me) ) 
        return 0;   
    if( !target ) target = offensive_target(me);
    if( !target
    ||      !target->is_character()
    ||      target->is_corpse()
    ||      target==me) 
        return notify_fail(""+name()+"只能对战斗中的对手使用。\n");
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n"); 

    extra = me->query_skill("dagou-bang",1) + me->query_skill("stick",1);
    weapon = me->query_temp("weapon");
    me->add("force",-500);
    me->set_temp("tianxia_busy",time());

message_vision(HIG"\n$N眼中青芒大盛，使出打狗棒法中的无上绝技"+name()+HIG"，\n手中的"+weapon->name()+HIG"舞动一阵棒雨，朝$n"HIG"铺天盖地打来！\n" NOR,me,target);
    if ((int)me->query("dgbang_agree")==2)
    extra = extra/3;
    else
    extra = extra/10;//消弱 fang@tsrj 2007
    me->add_temp("apply/attack", extra);
    me->add_temp("apply/damage", extra);
if (random((int)me->query_skill("dodge", 1)/2)>random((int)target->query_skill("dodge",1)/6 ) || (int)me->query("dgbang_agree")==2)
    {
    if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
    message_vision(HIB"绊狗腿！\n" NOR,me,target);
    COMBAT_D->do_attack(me,target, weapon); 
    if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
    message_vision(HIC"敲狗牙！\n" NOR,me,target);
    COMBAT_D->do_attack(me,target, weapon); 
    if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
    message_vision(YEL"戳狗臀！\n" NOR,me,target);
    COMBAT_D->do_attack(me,target, weapon); 
    if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
    message_vision(HIB"砸狗背！\n" NOR,me,target);
    COMBAT_D->do_attack(me,target, weapon); 
    if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
    message_vision(HIR"打狗头！\n" NOR,me,target);
    COMBAT_D->do_attack(me,target, weapon); 
    if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
    message_vision(HIW"天下无狗！\n" NOR,me,target);
    COMBAT_D->do_attack(me,target, weapon); 
    if (me->query_skill("xianglong-zhang", 1)> 599 )
        {
        msg = HIG "$N嫉恶如仇，怒发冲冠，力求除恶务尽，于打狗棒法中夹杂了"+HIR+"降龙十八掌绝学！\n"NOR;
        message_vision(msg, me);
        COMBAT_D->do_attack(me,target, weapon);
        COMBAT_D->do_attack(me,target, weapon);
        COMBAT_D->do_attack(me,target, weapon);
        }
    if (random(me->query("level")) > target->query("level")/3 || (int)me->query("dgbang_agree")==2)
        {
        message_vision(HIM"$N棒法精妙绝伦，$n"HIM"被打得满地找牙！\n" NOR,me,target);
        damage=extra*4;
        damage+=random(me->query("level"));
        damage+=me->query("force_factor");
        damage-=target->query("level")/3;
        if (damage<500)  damage=500;
        target->receive_damage("kee", damage, me);
        target->receive_wound("kee", damage, me);
        COMBAT_D->report_status(target);
        me->add("force",-me->query("force_factor"));
        }
    }
    else
    {
    message_vision(HIB"$N不慌不忙，沉着应战，对着$n狞笑道：看我破你这招"+name()+"！\n" NOR,target,me);
    COMBAT_D->do_attack(target,me, target->query_temp("weapon"),TYPE_REGULAR,msg);
    COMBAT_D->do_attack(target,me, target->query_temp("weapon"),TYPE_REGULAR,msg);
    COMBAT_D->do_attack(target,me, target->query_temp("weapon"),TYPE_REGULAR,msg);
    }
    me->add_temp("apply/attack", -extra);
    me->add_temp("apply/damage", -extra);
    return 1;
}
int help(object me)   
{
string temp; 
temp = "\t\t"+to_chinese("dagou-bang")+" 600 级\n";
temp+= "\t\t"+to_chinese("force")+" 600 级\n";
temp+= "\t\t"+to_chinese("stick")+" 600 级\n";
temp+= "\t\t内力修为一甲子\n";
temp+= "\t\t内力 1000 点\n";
temp+= "\t\t必须在战斗状态下\n";
temp+= "\t\t必须解密\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP

        使用功效：
                连续打击敌人的气血
        出招类型：
                延时型外功
                公共技能
                有隐藏效果
        出手要求：              
HELP);  
write(temp);
return 1;
}
