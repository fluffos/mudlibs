
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

void remove_effect(object me)
{
    if(me && me->query_temp("pfm_shenli")){
        me->add_temp("apply/strength",-me->query_skill("xianglong-zhang",1)/2);
      me->delete_temp("pfm_shenli");
      tell_object(me,HIY"你的「降龙」运功完毕，将内力收回丹田。\n"NOR);
      }
}
void check_fight(object me)
{
    if (!me) return;

      if (!me->is_fighting() || me->query("force") < 100) {
        	remove_call_out("remove_effect"); 
                remove_effect(me);
                }
    else call_out("check_fight", 1, me);
}

string name()
{
return "「"HIY"降龙"NOR"」";
}

int valid_perform(object me) 
{
      if( me->query("xlzhang_agree")==0 )
          return notify_fail("你还没有领悟"+name()+"的真谛。\n");

      if( (int)me->query("force") < 800 || (int)me->query("max_force")<4000  ) 
                return notify_fail("你的内力或内力修为不够。\n");
     if( (int)me->query_skill("xianglong-zhang",1) < 250 )
                return notify_fail("你的降龙十八掌修为尚浅。\n");
     if( (int)me->query_skill("force",1) < 250 )
                return notify_fail("你的内功心法修为尚浅。\n");
      if( me->query_temp("pfm_shenli") ) 
                return notify_fail("你已经将"+name()+"绝技运于双臂了。\n");

return 1;  
}

int perform(object me, object target)
{
      int i;
if ( !valid_perform(me) )  
        return 0;    
if( !target ) target = offensive_target(me);
if( !target
||      !target->is_character()
||      target->is_corpse()
||      target==me )
        return notify_fail(name()+"只能在战斗中向对手使用！\n");
      if( !me->is_fighting() )
          return notify_fail(name()+"绝技只能在战斗中对对手使用。\n");

      i = me->query_skill("xianglong-zhang", 1)/3;
      me->add("force", -500);

      message_vision(HIW "$N突然全身骨骼作响，妙悟降龙十八掌之「降龙」真谛，全身好象有使不完的力量一样！\n" NOR, me);
      me->add_temp("apply/strength",me->query_skill("xianglong-zhang",1)/2);
      me->set_temp("pfm_shenli", 1);
      check_fight(me);
      call_out("remove_effect", i, me);
      return 1;
}

int help(object me)
{
string temp;
temp = "\t\t"+to_chinese("xianglong-zhang")+" 250 级\n";
temp+= "\t\t"+to_chinese("force")+" 250 级\n";
temp+= "\t\t内力修为四十年\n";
temp+= "\t\t内力 800 点\n";
temp+= "\t\t必须在战斗状态下\n";
temp+= "\t\t必须解密\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP

        使用功效：
                大幅度提升自己的战时臂力
        出招类型：
                延时型外功
                公共技能
                无隐藏效果
        出手要求：              
HELP);  
write(temp);
return 1;
}
