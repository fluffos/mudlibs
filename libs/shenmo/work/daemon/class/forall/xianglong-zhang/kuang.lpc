
// By windy

#include <ansi.h> 
#include <combat.h> 
inherit SSERVER; 
string name()
{
return "「"HIR"神龙狂舞"NOR"」";
}

int valid_perform(object me) 
{
	if((int)me->query_skill("xianglong-zhang",1)<600
           ||(int)me->query_skill("unarmed",1)<600
           ||(int)me->query_skill("force",1)<600)
                return notify_fail("以你目前的武功修为还难以施展"+name()+"。\n");

        if( me->query("xlzhang_agree")==0 )
                return notify_fail("你还没有领悟到降龙十八掌的精髓所在。\n");
	if((int)me->query("max_force") < 6000 )

                return notify_fail("你的内功修为不够。\n");

        if((int)me->query("force") < 1000 )

                return notify_fail("你的内力不足！\n");

        if((int)me->query("sen") < 500 )

                return notify_fail("你的精神不足，难以集中精力！\n");
        if(time()-me->query_temp("kuang_busy")<3+random(3))
               return notify_fail("你现在内息不畅，强行发功恐怕会不伤敌反伤己！\n");
return 1;  
}

int perform(object me, object target)
{
        string msg;
        int damage_bonus,target_bonus,damage, wound;
if ( !valid_perform(me) )  
        return 0;    
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me )
                return notify_fail(name()+"只能在战斗中向对手使用！\n");
if( !me->is_fighting() )
        return notify_fail(name()+"只能在战斗中使用。\n");

        me->add("force",-500);
        me->set_temp("kuang_busy",time());


message_vision(HIY"$N将降龙十八掌贯熟于胸，招式如江翻浪涌，连绵不绝，以排山倒海之势攻向$n！\n"NOR,me,target); 
        msg = HIC "$N身形恰似一条神龙长空飞舞，双掌运转如风，蕴有无穷后劲！\n";

message_vision(HIG "【密云不雨】"HIC" $N带起的劲风袭向$n全身！\n"NOR,me,target); 

        damage_bonus=(int)me->query_skill("unarmed", 1) + (int)me->query_skill("xianglong-zhang", 1);
        target_bonus=(int)target->query_skill("parry", 1) + (int)target->query_skill("dodge", 1);
  if(me->query("xlzhang_agree") != 2 ) damage_bonus/=2 ;//消弱其威力
        if((damage_bonus)>random(target_bonus))
           {

           damage=500+damage_bonus+random(damage_bonus);
           wound=random(damage-(int)target->query_temp("apply/armor"));

           msg +=HIR "$n避无所避，胸口中了一掌！ \n";

	   target->receive_damage("kee", damage, me);
           if(wound<500)    wound=500;
	   target->receive_wound("kee", wound, me);
//           msg+=COMBAT_D->damage_msg(damage, "内伤");
	   }
           else msg+=HIY"$n临危不乱，移形换影，躲了开来。\n" NOR;
message_vision(HIG "【双龙取水】"HIC" $N施展少林正宗擒龙手抓向$n的琵琶骨！\n"NOR,me,target); 
        damage_bonus=(int)me->query_skill("force", 1)*10 + (int)me->query("max_force", 1);

        target_bonus=(int)target->query_skill("force", 1)*10 + (int)target->query("max_force", 1);
  if(me->query("xlzhang_agree") != 2 ) damage_bonus/=2 ;//消弱其威力
        if((damage_bonus)>random(target_bonus))
           {
           damage=500+damage_bonus/20+random(damage_bonus)/20;
           wound=random(damage-(int)target->query_temp("apply/armor"));
           msg +=HIR "$n躲闪不及，竟被$N制住！ \n";
           target->receive_damage("kee", damage, me);
           if(wound<500)    wound=500;
           target->receive_wound("kee", wound, me);
           if (!target->is_busy())
           target->start_busy(random(3)+2);
//           msg+=COMBAT_D->damage_msg(damage, "内伤");
           }
           else msg+=HIY"$n见招拆招，将对方的力道卸了开去。\n" NOR;
message_vision(HIG "【龙战于野】"HIC" $N掌力浑雄以极，猛击向$n的小腹！\n"NOR,me,target); 
        damage_bonus=(int)me->query("combat_exp", 1)/200000;
        target_bonus=(int)target->query("combat_exp", 1)/200000;
  if(me->query("xlzhang_agree") != 2 ) damage_bonus/=2 ;//消弱其威力
        if((damage_bonus)>random(target_bonus))
           {
           damage=(damage_bonus+random(damage_bonus))/2;
           wound=random(damage-(int)target->query_temp("apply/armor"));
           msg +=HIR "$n中掌后闷哼一声，一口鲜血狂喷而出！ \n";
           target->receive_damage("kee", damage, me);
           if(wound<500)    wound=damage;
           target->receive_wound("kee", wound, me);
//           COMBAT_D->report_status(target);
           }
           else msg+=HIY"$n见势不妙，收胸缩腹向后纵去。\n" NOR;
message_vision(HIG "【震惊百里】"HIC" $N不依不饶，如影随形，双掌带起一股气流击向$n！\n"NOR,me,target); 
        damage_bonus=me->query("level");
        target_bonus=target->query("level");
  if(me->query("xlzhang_agree") != 2 ) damage_bonus/=2 ;//消弱其威力
        if((damage_bonus)>random(target_bonus))
           {
           damage=500+damage_bonus+random(damage_bonus);
           wound=random(damage-(int)target->query_temp("apply/armor"));
           msg +=HIR "$n被气流击中，所受内伤着实不轻！ \n";
           target->receive_damage("kee", damage, me);
           target->receive_damage("sen", damage, me);
           if(wound<0)    wound=1000;
           target->receive_wound("kee", wound, me);
           target->receive_wound("sen", wound, me);
//           msg+=COMBAT_D->damage_msg(damage, "内伤");
	   }

           else msg+=HIY"$n见无可躲避，只得气运丹田，双掌前推，硬借了$N的这一招。\n" NOR;
    if(random(5)>1 && (int)me->query_skill("xianglong-zhang",1)>799)

        {

message_vision(WHT "$N看似力竭，哪知道不等$n喘息，又出一招！\n"NOR,me,target); 
message_vision(HIW "【亢龙有悔】"HIC" $N长啸一声，掌力绵绵，气势恢宏！\n"NOR,me,target); 
        damage_bonus=(int)me->query_kar();
        target_bonus=(int)target->query_kar();
        if((damage_bonus)>random(target_bonus)) 
           {

           damage_bonus*=100;
           damage=1000+damage_bonus/2;
           msg +=HIR  "$n不知所措，束手待毙，被$N一掌击中胸口。 \n";
	   target->receive_damage("kee", damage, me);
           target->receive_damage("sen", damage, me);
	   }

           else msg+=HIY"$n知道此招厉害，慌忙就地十八滚，虽然躲开了，确是狼狈已极！\n" NOR;
        }
if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
        message_vision(msg, me, target);
           COMBAT_D->report_status(target);
          return 1;
}
int help(object me) 
{
string temp; 
temp = "\t\t"+to_chinese("xianglong-zhang")+" 600 级\n"; 
temp+= "\t\t"+to_chinese("force")+" 600 级\n"; 
temp+= "\t\t"+to_chinese("unarmed")+" 600 级\n"; 
temp+= "\t\t内力修为一甲子\n"; 
temp+= "\t\t内力 1000 点\n"; 
temp+= "\t\t精神 500 点\n"; 
temp+= "\t\t必须在战斗状态下\n"; 
temp+= "\t\t必须解密\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                连续打击敌人的气血并有可能牵制敌人
        出招类型：
                延时型外功 
                公共技能 
                有隐藏效果 
        出手要求：      
HELP);   
write(temp); 
return 1; 
}
