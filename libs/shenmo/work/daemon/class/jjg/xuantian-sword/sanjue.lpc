// 三绝剑

#include <ansi.h>
inherit SSERVER;
#include <combat.h>
void free(object target);
int perform(object me, object target) {
  object weapon;
  int damage;
  string fer;
  if (!target) target = offensive_target(me);
  fer = me->query("id");
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你想对谁施展这一招「三绝」？\n");
  if (!me->is_fighting() || !target->is_fighting())
    return notify_fail("「三绝」只能在战斗中使用！\n");

  if (me->query("family/family_name") != "神策军")
    return notify_fail("「三绝]只有神策军的人才可以用！\n");
  if ((int)me->query("max_force") < 800)
    return notify_fail("你的内力修为不够！无法催动「三绝」。\n");
  if ((int)me->query("force") < 1500)
    return notify_fail("你的内力不够！\n");
  if ((int)me->query_skill("xuantian-sword", 1) < 300)
    return notify_fail("你的火候不到，无法驾御这么厉害的武功。\n");
  if ((int)me->query_skill("sword", 1) < 300)
    return notify_fail("你的基本剑法火候不到，无法驾御这么厉害的武功。\n");
  if ((int)me->query_skill("force", 1) < 300)
    return notify_fail("你的基本内功火候不到，无法驾御这么厉害的武功。\n");
  if ((int)me->query_skill("pixie-canjian", 1) < 300)
    return notify_fail("你的辟邪残剑火候不到，无法驾御这么厉害的武功。\n");
  if ((int)me->query_skill("parry", 1) < 300)
    return notify_fail("你的拆招卸力火候不到，无法驾御这么厉害的武功。\n");
  if ((int)me->query_skill("dodge", 1) < 300)
    return notify_fail("你的基本轻功火候不到，无法驾御这么厉害的武功。\n");
  if ((int)me->query_skill("pixie-mijian", 1) < 300)
    return notify_fail("你的密剑火候不到，无法驾御这么厉害的武功。\n");

  message_vision(MAG "$N身影轻轻一晃，脸上紫气突地一现，内力呼的
一声从剑尖爆烈而出，手中宝剑随着你的内力不停地跳动，身上隐隐有一条黄
金神龙在飞舞,不断地绕着剑身发出金色光芒。$N看也不看对方，纵声长
啸道：“上天入地，唯我独尊”，刷地一声闪电般地攻出三剑。正
是神策军的不传之秘[三绝]。 \n" NOR, me, target,);

  {
    me->delete("env/brief_message");
    target->delete("env/brief_message");

    message_vision(HIC "$n正看得入迷呆在那里不知所错时，$N脚踩飞仙
步法，“腾”地一下蹿到半空中，只见双手一抖，三绝剑脱手而出，三绝剑上
的黄金神龙“啪”地一下重重地打下。 \n" NOR, me, target,);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    message_vision(HIY "$n依然呆呆的不动，$N默运[葵花心法]，全身被
紫气所围，手中宝剑随着黄金神龙自上而下，只见四周血雾纷飞。 \n" NOR, me, target,);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    message_vision(HIG "$n已恢复了正常,可是身体却依然麻木无法移动，
只见三绝剑上的黄金神龙越来越现，$N脸上紫气第三次现出，半空中紫气与黄
金神龙合而为一形成一道巨大的紫气金龙，$n只觉剑影如山，躲避不及，被紫
气金龙穿胸而过。 \n" NOR, me, target,);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    me->add("force", -200);
    me->start_busy(random(0) + 1);
    damage = (int)me->query_skill("xuantian-sword");
    target->receive_damage("kee", damage);
    target->receive_wound("kee", damage / 3);
    target->receive_damage("sen", damage);
    target->receive_wound("sen", damage / 3);

  }
  return 1;
}
