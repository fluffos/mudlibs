
#include <ansi.h>
#include <combat.h> 

inherit SSERVER;

int perform(object me, object target)
{
        string msg;

        if( !target ) target = offensive_target(me);

        if( !target || !target->is_character() || !me->is_fighting(target) )
                return notify_fail("你一个人跳甚么？\n");

           if( (string)me->query("gender") != "无性" )
                return notify_fail("只有无性才能练的武功。\n");
if(me->query("family/family_name") != "神策军" )
                return notify_fail("你是哪儿偷学来的武功");
        if((int)me->query_skill("guimei",1) < 350)
                return notify_fail(HIY "你的鬼魅不够熟练。\n" NOR);

        if((int)me->query("force") < 1200)
                return notify_fail(HIY "你现在真气不足。\n" HIY);
    if ( time() < me->query_temp("guimei_time") + 1 )
    {
        return notify_fail("绝招用多就不灵了。\n");
    }

        if( target->is_busy(6) )
                return notify_fail(target->name() + "目前正自顾不暇，攻击吧骚年！\n");

        if( me->query("gender") == "无性")
               {msg = YEL
"$N提起真气，速度暴涨,一招快如鬼魅,如入无人之境！\n" NOR;}
        else   {msg = YEL 
"$N娇笑一声，身上衣服件件落下，入九天仙女下凡！\n" NOR;}

        if( me->query("combat_exp") > random((int)target->query("combat_exp")/3)) {
                msg += HIW "结果$p被$P的诡异身法吓得目瞪口呆！\n" NOR;
                target->start_busy(8);
                me->set_temp("guimei_time", time()); 
                me->add("force", -100);
                       } else {
                msg +=  "$p只是勉强的逃了开去。\n";
                me->add("force", -1200);
                me->start_busy(0);
        }
        message_vision(msg, me, target);

        return 1;
}
