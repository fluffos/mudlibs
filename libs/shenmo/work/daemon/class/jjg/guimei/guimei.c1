

#include <ansi.h>
inherit SSERVER;
int perform(object me, object target)
{
        string msg;
        int shu, mepo, tarpo;
        
        if(me->is_busy())
                return notify_fail("你现在没空！！\n");

        shu = me->query_skill("guimei",1) ;
        if ( shu < 280) return notify_fail("你的[鬼魅]还不够熟练！\n");

        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("［鬼魅］只能对战斗中的对手使用。\n");
      if((int)me->query_skill("kuihua-xinfa",1) < 330)
                return notify_fail(HIY "你的葵花心法修为不够。\n" NOR);
           if( (string)me->query("gender") != "无性" )
                return notify_fail("只有无性才能练的武功。\n");
if(me->query("family/family_name") != "神策军" )
                return notify_fail("你是哪儿偷学来的武功");
        if((int)me->query_skill("guimei",1) < 350)
                return notify_fail(HIY "你的鬼魅不够熟练。\n" NOR);

        if((int)me->query("force") < 1200)
                return notify_fail(HIY "你现在真气不足。\n" HIY);
        
        mepo = (int)me->query("combat_exp")+(int)me->query_skill("dodge")+(int)me->query_skill("meigui");
        mepo = mepo + (int)me->query("mana");
        
        tarpo = (int)target->query("combat_exp")+(int)me->query_skill("dodge");
        tarpo = tarpo + (int)target->query("mana");

        if(random(mepo) > tarpo/2)
 {
        message_vision(
        HIM "\n\n$N旋空而起，卷起一股股淡淡的紫云，将$n紧紧的裹住.....\n\n" NOR, me,target);

        target->start_busy(8+random(5));
        me->add("force", -1200);
}
else {
       message_vision(
       HIB "\n$n已有警觉，身体飘然向后退去......\n" NOR, me, target);

       me->start_busy(random(3));
       me->receive_damage("sen",100);
     }
       me->set_temp("guimei_busy",1);
       call_out("guimei_busy",5+random(3),me);
       return 1;
}

void zifu_busy(object me) {
      if (!me) return;
      me->delete_temp("guimei_busy");
}
