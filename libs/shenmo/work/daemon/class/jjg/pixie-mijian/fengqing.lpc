
#include <ansi.h>

inherit SSERVER;

#include "/daemon/skill/eff_msg.h";

void remove_effect(object me);

int perform2(object me, object target, int p);
int perform3(object me, object target, int p);

int perform(object me, object target)
{
    int damage, p;
    string msg, dodge_skill;

    if ( !target )
    {
        target = offensive_target(me);
    }

    if ( !target || !target->is_character()
        || !me->is_fighting(target) || !living(target) )
    {
        return notify_fail("风情万种只能对战斗中的对手使用。\n");
    }

    if ( (int)me->query_skill("pixie-mijian", 1) < 150 )
    {
        return notify_fail("你的辟邪密剑还不够熟练，不能使用此绝招对敌！\n");
    }

    if ( (string)me->query("gender") != "无性" )
    {
        return notify_fail("只有无性才能练的武功。\n");
    }

    if ( me->query("family/family_name") != "神策军" )
    {
        return notify_fail("你是哪儿偷学来的武功");
    }

    if ( (int)me->query("force") < 600 )
    {
        return notify_fail("你现在内力不足，使不出辟邪剑法的绝招！\n");     
    }

    if ( (int)me->query_skill("sword", 1) < 120 )
    {
        return notify_fail("你的剑法不够娴熟，使不出辟邪密剑的绝招！\n");
    }

    if ( me->query_temp("pixie-fengqing") )
    {
        return notify_fail("你刚使完「风情万种」绝招，目前气血翻涌，无法再次运用！\n");
    }

    me->set_temp("pixie-fengqing", 1);

    msg = HIY "\n\n$N手中剑气直直刺出，使的正是「辟邪密剑--第一式」绝招，手中宝剑直逼$n而去！\n"NOR;        

    if ( random(me->query_skill("force")) > target->query_skill("force") /4 )
    {                     
        me->add("force", -400);
        me->add("mana", -80);
        damage = (int)me->query_skill("pixie-mijian", 1);                
        damage = damage * 20 + random(damage) + (int)me->query("level") + me->query_con();
        if ( me->query("force") > target->query("force") * 20 )
        {
            damage += random(damage);
        }
        target->receive_damage("kee", damage);
        target->receive_wound("kee", damage/2);
        p = (int)target->query("kee") * 100/(int)target->query("max_kee");
        msg += damage_msg(damage, "内伤");
        msg += "( $n" + eff_status_msg(p) + " )\n";
        //call_out("perform2", 0, me, target, p);  
        perform2(me, target, p);
    }
    else
    {
        me->add("force", -100);
        tell_object(target, HIY"你但觉一股微风扑面而来，风势虽然不劲，然已逼得自己呼吸不畅，知道不妙，连忙跃开数尺。\n" NOR);
        dodge_skill = target->query_skill_mapped("dodge");
        if ( !dodge_skill )
        {
            dodge_skill = "dodge";
        }
        msg += SKILL_D(dodge_skill)->query_dodge_msg(target, 1);
        call_out("remove_effect", me->query_con() / 2, me);
    }

    message_vision(msg, me, target); 

    return 1;
}

int perform2(object me, object target, int p)
{
    int damage;
    string msg, dodge_skill;
    object weapon;

    if ( !living(target) )
    {
        tell_object(me, HIC"对手已经不能再战斗了。\n"NOR); 
        remove_effect(me);
        return 1;
    }

    if ( !(weapon = me->query_temp("weapon")) || "sword" != weapon->query("skill_type") )
    {
        tell_object(me, HIC"手中无剑，如何卖弄风情。\n"NOR); 
        remove_effect(me);
        return 1;
    }

    if ( environment(target) != environment(me) )
    {
        tell_object(me, HIC"对手已经不在这里了。\n"NOR); 
        remove_effect(me);
        return 1;
    }

    if ( "pixie-mijian" != me->query_skill_mapped("sword") )
    {
        tell_object(me, HIC"不用密剑，如何卖弄风情。\n"NOR); 
        remove_effect(me);
        return 1;
    }

    if ( (int)me->query("force", 1) < 800 )
    {
        tell_object(me, HIC"你待要再发一剑，却发现自己的内力不够了！\n"NOR); 
        remove_effect(me);
        return 1;
    }

    msg = HIC "\n$N第一剑剑气未消，第二剑也跟着刺出，功力相叠，「辟邪剑法--第二式」剑气排山倒海般涌向$n！\n"NOR;        
    if ( random(me->query_skill("force")) > target->query_skill("force") / 4 &&
        me->query_skill("pixie-mijian", 1) > 150 )
    {                
        me->add("force", -600);
        me->add("mana", -100);                
        damage = (int)me->query_skill("pixie-mijian", 1);                
        damage = damage * 3 + random(damage) * 20 + (int)me->query("level") + me->query_con();
        if ( me->query("force") > target->query("force") * 20 )
        {
            damage += random(damage);
        }
        target->receive_damage("kee", damage);
        target->receive_wound("kee", damage / 2);
        p = (int)target->query("kee") * 100/(int)target->query("max_kee");
        msg += damage_msg(damage, "刺伤");
        msg += "( $n" + eff_status_msg(p) + " )\n";
        //call_out("perform3", 0, me, target, p);  
        perform3(me, target, p);
    } 
    else 
    {
        me->add("force", -800);
        tell_object(target, HIY"你喘息未定，又觉一股剑气扑面而来，连忙跃开数尺，狼狈地避开。\n" NOR);
        dodge_skill = target->query_skill_mapped("dodge");
        if ( !dodge_skill )
        {
            dodge_skill = "dodge";
        }
        msg += SKILL_D(dodge_skill)->query_dodge_msg(target, 1);
        call_out("remove_effect", me->query_con() / 2, me);
    }

    message_vision(msg, me, target); 

    return 1;
}

int perform3(object me, object target, int p)
{
    int damage;
    string msg, dodge_skill;
    object weapon;

    if ( !living(target) )
    {
        tell_object(me, HIC"对手已经不能再战斗了。\n"NOR); 
        remove_effect(me);
        return 1;
    }

    if ( !(weapon = me->query_temp("weapon")) || "sword" != weapon->query("skill_type") )
    {
        tell_object(me, HIC"手中无剑，如何卖弄风情。\n"NOR); 
        remove_effect(me);
        return 1;
    }

    if ( environment(target) != environment(me) )
    {
        tell_object(me, HIC"对手已经不在这里了。\n"NOR); 
        remove_effect(me);
        return 1;
    }

    if ( "pixie-mijian" != me->query_skill_mapped("sword") )
    {
        tell_object(me, HIC"不用密剑，如何卖弄风情。\n"NOR); 
        remove_effect(me);
        return 1;
    }

    if ( (int)me->query("force", 1) < 500 )
    {
        tell_object(me, HIC"你待要再发一剑，却发现自己的内力不够了！\n"NOR); 
        remove_effect(me);
        return 1;
    }

    msg = HIW "\n$N周身剑气猛力推出，$n连同身前方圆三丈全在「辟邪剑法--第三式」劲力笼罩之下！\n"NOR;        
    if ( random(me->query_skill("force")) > target->query_skill("force") / 4 &&
        me->query_skill("pixie-mijian", 1) > 199 )
    {
        me->add("force", -300);
        me->add("mana", -30);                
        damage = (int)me->query_skill("pixie-mijian", 1);                

        damage = damage * 5 + random(damage) * 10 + (int)me->query("level") + me->query_con();
        if ( me->query("force") > target->query("force") * 20 )
        {
            damage += random(damage);
        }
        target->receive_damage("kee", damage);
        target->receive_wound("kee", damage / 2);
        p = (int)target->query("kee") * 100/(int)target->query("max_kee");
        msg += damage_msg(damage, "刺伤");
        msg += "( $n" + eff_status_msg(p) + " )\n";
    }
    else 
    {
        me->add("force", -300);
        target->add("mana", -100);
        tell_object(target, HIY"你用尽全身力量向右一纵一滚，摇摇欲倒地站了起来，但总算躲开了这致命的一击！\n" NOR);
        dodge_skill = target->query_skill_mapped("dodge");
        if ( !dodge_skill )
        {
            dodge_skill = "dodge";
        }
        msg += SKILL_D(dodge_skill)->query_dodge_msg(target, 1);
    }

    call_out("remove_effect", me->query_con() / 2, me);

    message_vision(msg, me, target); 

    return 1;
}

void remove_effect(object me)
{
    if ( !me )
    {
        return;
    }
    me->delete_temp("pixie-fengqing");
    tell_object(me, HIC"\n你经过一段时间调气养息，又可以使用「风情万种」绝招了。\n"NOR); 
}

