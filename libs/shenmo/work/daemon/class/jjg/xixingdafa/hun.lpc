//modify by ken
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int exert(object me, object target)
{
        string msg;
        int extra;
        object weapon;
        if( !target ) target = offensive_target(me);

                if( target == me ) return notify_fail("你疯了？\n");
        extra = me->query_skill("xixingdafa",1) ;
        if(extra < 50 ) return notify_fail("你的吸星大法修练不精，再怎么运也不运不出来！\n");
        if( (string)me->query("family/family_name") != "神策军" )
              return notify_fail("你又不是太监，怎能吸人精血？\n");
if ( time() - (int)me->query_temp("hun") < 3 )
    {
        return notify_fail("绝招用多就不灵了！\n");
    }

        if( (int)me->query("mana") < 400 )
              return notify_fail("你的法力不足，再怎么吸也吸不动。");
        msg = HIG "\n$N使出吸星大法，双掌发出一道耀眼的绿光刺的$n睁不开眼！" NOR;
        if(random((int)me->query("mana")) >= (int)target->query("mana")/2)
        {
        message_vision(msg+"\n",me,target);
        message_vision( HIG "$N只觉得眼前一阵群魔乱舞，元神几乎要脱窍而出！\n" NOR,target);
        target->receive_wound("sen",extra);
        me->receive_curing("sen",extra);
        me->add("mana",-200);
        COMBAT_D->report_status(target);

        }       
        else{
        message_vision(msg+"\n",me,target);
        message_vision( HIB "$N大笑道：雕虫小计，也拿来现丑！\n" NOR,target);
        weapon = me->query_temp("weapon");
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        me->add("mana",-300);
        me->set_temp("hun", time());
        }
        me->start_busy(0);
        return 1;
}
