
// creat by windy 2011.08
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIC"断子绝孙"NOR"」";  
}

int valid_perform(object me)
{
if ( me->query("family/family_name")!="神策军" && me->query_skill("duanzijuesun-tui",1)<350 )
        return notify_fail("就凭你现在的武功修为，也想用"+name()+"?\n");
if (me->query_skill("unarmed",1) < 200)
        return notify_fail("你的扑击格斗之技修为不够，还用不出"+name()+"！\n"); 
if(me->query_skill("duanzijuesun-tui", 1) < 200) 
        return notify_fail("你的断子绝孙腿修为不够，还用不出"+name()+"！\n"); 
	if(me->query_skill("guimei", 1) < 299) 
        return notify_fail("你的鬼魅身法修为不够，还用不出"+name()+"！\n"); 
if (me->query_skill("dodge",1) < 200)
        return notify_fail("你的基本轻功修为不够，还用不出"+name()+"！\n"); 
if((int)me->query("max_force") < 1000 )
        return notify_fail("你的内力修为太浅！\n");
if((int)me->query("force") < 600 )
        return notify_fail("你的内力不足！\n");
if( time()-(int)me->query_temp("rysx_end") < 1+random(2) ) 
        return notify_fail("绝招用多就不灵了！\n"); 
return 1;  
}

int perform(object me, object target)
{
object weapon;
int myskill, times, extra;
string number;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

myskill = (int)me->query_skill("duanzijuesun-tui", 1);
extra = (int)me->query_skill("kuihua-xinfa", 1)/4;

if(myskill <400){
        times = 3;
        number = "三";}
    else
        if (myskill <500){
            times = 4;
            number = "四";}
        else
            if(myskill <600 ){
                   times = 5;
                   number = "五";}
             else if(myskill<700){
                   times = 6;
                   number = "六";}
             else if(myskill<800){
                   times = 7;
                   number = "七";}
             else if(myskill<900){
                   times = 8;
                   number = "八";}
             else{
                   times = 9;
                   number = "九";}

message_vision(HIC"\n但见$N屁股一撅，一腿撩出，风起云涌，直向对方大腿根部而去！
轻者脑瘫蛋疼，重者必断子绝孙，云雾缭绕，金光乍现，中间突然幻象出男根向$n甩出了"+number+"下！\n"NOR,me,target);
me->add_temp("apply/attack", extra); 
me->add_temp("apply/damage", extra);
for(int i=1;i<=times;i++)
COMBAT_D->do_attack(me, target, me->query_temp("weapon"),TYPE_REGULAR);
me->add_temp("apply/attack", -extra); 
me->add_temp("apply/damage", -extra); 
me->add("force", -(times*50));
me->set_temp("rysx_end", time());
return 1;
}

int help(object me) 
{
string temp; 
temp = "\t\t"+to_chinese("duanzijuesun-tui")+" 200 级\n"; 
temp+= "\t\t"+to_chinese("unarmed")+" 200 级\n";
temp+= "\t\t"+to_chinese("dodge")+" 200 级\n";
temp+= "\t\t内力修为十年\n";
temp+= "\t\t内力６００点\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP  

        使用功效：  
                连续打击敌人的气血
        出招类型：  
                延时型外功 
                无隐藏攻击       
        出手要求：     
HELP);    
write(temp); 
return 1; 
}

