//steelarmor.c 气钢斗衣
//created by foc,01-7-01
//特点说明：加战斗攻防。

#include <ansi.h>
inherit F_CLEAN_UP;

int exert(object me, object target)
{
    int defence, time, str;
    if(me->query_temp("keearmor"))
    return notify_fail("你已经运起葵花挪移大法了。\n");
    if((int)me->query_skill("kuihua-xinfa",1)<100)
    return notify_fail("你的葵花心法还不够强。\n");
       if( (string)me->query("gender") != "无性" )
                return notify_fail("只有无性才能练的武功。\n");
if(me->query("family/family_name") != "神策军" )
                return notify_fail("你是哪儿偷学来的武功");
    if((int)me->query("max_force")<600 || (int)me->query("force")<500)
    return notify_fail("你的气不够。\n");
    if((int)me->query("daoxing")<300000)
    return notify_fail("你的修为还不够，就算用出来了也不会有多大的效果。\n");
    if( target != me )
    return notify_fail("葵花挪移大法无法对他人使用。\n");
    if(me->is_ghost())
    return notify_fail("你都已经是鬼了，还闹腾个什么呀？\n");
    else
{
    message_vision(HIW "$N运起葵花挪移大法。四周的空间似乎都\n扭曲了

！$N继续提高自己的气，$N的\n身体开始慢慢的朦胧起来！\n" 

NOR,me);
    defence=(int)me->query_skill("kuihua-xinfa",1)/2;
    time=(int)me->query_skill("kuihua-xinfa",1)*5;
    if(defence >=200) defence=200;
    if(time >=360 ) time=360;
    me->add_temp("apply/armor", defence);
  me->add_temp("apply/strength",defence);
me->add_temp("apply/armor_vs_spells",defence*2);
me->add_temp("apply/armor_vs_force",defence*2);
    me->add_temp("apply/attack",defence*2);
    me->add_temp("apply/dodge",defence);
    me->add_temp("apply/parry",defence);
    me->add_temp("force_factor",defence);
    me->add_temp("mana_factor",defence);
    me->set_temp("keearmor",1);
  me->add("force", -200);
//     if(me->is_fighting())
//     me->start_busy(3);
    call_out("remove_effect",time,me);
}
    return 1;
}

void remove_effect(object me, int defence )
{
	  if (!me )
    {
        return;
    }
    defence=(int)me->query_skill("kuihua-xinfa",1)/2;
    if(defence >=200) defence=200;
message_vision(HIW "$N身上的葵花真气逐渐散开，\n回到了$N的身体中。

\n" NOR,me);
    me->add_temp("apply/armor",-defence);
 me->add_temp("apply/strength",-defence);
    me->add_temp("apply/attack",-defence*2);
    me->add_temp("apply/dodge",-defence);
    me->add_temp("apply/armor_vs_spells",-defence*2);
    me->add_temp("apply/armor_vs_force",-defence*2);
    me->add_temp("apply/parry",-defence);
    me->add_temp("force_factor",-defence);
    me->add_temp("mana_factor",-defence);
    me->delete_temp("keearmor");
}


