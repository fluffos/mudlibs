#include <ansi.h>
#include "/daemon/skill/eff_msg.h";
inherit SSERVER;
int perform(object me, object target)
{
   string str;//谣言的变量
   int damage,ddmage,edamage,p;
   string msg;
    object weapon;

   if (!target ) target = offensive_target(me);
   if (!target || !target->is_character() || !me->is_fighting(target) )
       return notify_fail(HIR"「葵花」"NOR"只能对战斗中的对手使用。\n");
  if (!PFM_D->valid_family(me, "神策军"))
 return notify_fail("“葵花”只有神策军才可以用！\n");
  if ((int)me->query_skill("kuihuadianxue", 1) < 80 )
      return notify_fail(WHT"你葵花点穴手不够娴熟，使不出「葵花」。\n"NOR);
   if ((int)me->query("max_force")<400)
       return notify_fail(RED"你内力修为不足，无法运足内力。\n"NOR);
   if ((int)me->query("force")<200)
    {
       return notify_fail(HIC"你现在内力不够，没能将「葵花」使完！\n"NOR);
    }
   if( time()-(int)me->query_temp("khdx_end") < 2 )
           return notify_fail("绝招用多就不灵了！\n");

message_brief(me, target, "葵花点穴手", "「葵花」");
   
       msg = HIC "$N脚踏七星，一式葵花施展开来！\n"NOR;
   if (random(me->query_skill("force")) > target->query_skill("force")/6|| 
       random(me->query("combat_exp")) > (int)target->query("combat_exp")/7 )
    {
    //    me->start_busy(1);
       target->start_busy(2+random(2));
damage = (int)target->query("kee", 1);
      ddmage = (int)target->query("force", 1);
      edamage = (int)target->query("mana", 1);
        damage = damage/2 + random(damage);
        target->receive_damage("kee", damage/2);
 //   target->receive_wound("kee", damage/2);
    //    target->apply_condition("kuihua_poison", 1+(me->query_str()));
       p = (int)target->query("kee")*100/(int)target->query("max_kee");
        msg += "( $n"+eff_status_msg(p)+" )\n";
message_vision(msg,me,target,0,"env/brief_perform");
       //         me->add("force", -damage/10);
       me->set_temp("khdx_end", 1);
        target->set_temp("block_msg/all",1);
 me->set_temp("cimu1_end",time());
     } else
    {
     //  me->start_busy(2);
       message_vision(msg, me, target); 
   }
    if(!target->is_fighting(me)) target->fight_ob(me);
   return 1;
}






