#include <ansi.h>
inherit SSERVER;

int perform(object me, object target)
{
        int skill, skill1, skill2;
        object weapon;

        if(!target) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招「秋声问情」？\n");

        if(!me->is_fighting())
                return notify_fail("「秋声问情」只能在战斗中使用！\n");

        if(me->query("family/family_name")!="神策军")
                return notify_fail("非神策军弟子不能用「秋声问情」！\n");
       if( (string)me->query("gender") != "无性" )
                return notify_fail("只有无性才能练的武功。\n");

        if((int)me->query("max_force") < 500)
                return notify_fail("你的内力不够！\n");

        if((int)me->query("force") < 500 )
                return notify_fail("你的内力不足！\n");

        if((int)me->query("sen") < 250)
                return notify_fail("你的精神不足，没法子施用外功！\n");

        if((int)me->query_skill("xuantian-sword",1) < 100)
                return notify_fail("你的玄天剑法还不够娴熟，使用这一招会有困难!\n");

        if((int)me->query_skill("qiushen-blade",1) < 100)
                return notify_fail("你的秋声刀法还不够娴熟，使用这一招会有困难!\n");

        weapon=me->query_temp("weapon");
        if(!objectp(weapon)) 
                return notify_fail("没刀怎么施展「秋声问情」?\n");

        message_vision(HIM"\n$N手中"+weapon->query("name")+HIM"刷刷砍出几刀，直逼$n全身要害!\n"NOR, me, target);

        me->set_temp("CQD_perform", 1);
        COMBAT_D->do_attack(me, target, weapon);
        COMBAT_D->do_attack(me, target, weapon);
        COMBAT_D->do_attack(me, target, weapon);
        COMBAT_D->do_attack(me, target, weapon);

        message_vision(HIC"\n$n正忙于从$N的刀光中脱身时，$N抽出"+weapon->query("name")+HIC"向$n刺去。"NOR, me, target);

        weapon->unequip();
        weapon->wield();

        me->set_temp("CQD_perform", 2);
        COMBAT_D->do_attack(me, target, weapon);
        COMBAT_D->do_attack(me, target, weapon);

        me->set_temp("CQD_perform", 3);
        COMBAT_D->do_attack(me, target, weapon);
        COMBAT_D->do_attack(me, target, weapon);

        me->delete_temp("CQD_perform");

        me->receive_damage("sen", 100);
        me->add("force", -100);

        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }

        weapon->unequip();
        weapon->wield();

        me->start_busy(0);

        return 1;
}

