#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() {
  return "「" HIR "乱披风" NOR "」";
}

int valid_perform(object me) {
  if ((int)me->query("force") < 100 || (int)me->query("max_force") < 900)
    return notify_fail("你的内力或内力修为不够。\n");
  if ((string)me->query("gender") != "无性")
    return notify_fail("只有无性才能练的武功。\n");
  if (me->query("family/family_name") != "神策军")
    return notify_fail("你是哪儿偷学来的武功");
  if ((int)me->query_skill("siqi-sword", 1) < 500)
    return notify_fail("你的四奇剑法太低了，难以施展乱披风。\n");
  if ((int)me->query_skill("sword", 1) < 500)
    return notify_fail("你的基本剑术太低了，难以施展乱披风。\n");
  if ((int)me->query_skill("guimei", 1) < 400)
    return notify_fail("你的鬼魅太低了，难以施展乱披风。\n");
  if ((int)me->query_skill("pixie-mijian", 1) < 400)
    return notify_fail("你的辟邪密剑太低了，难以施展乱披风。\n");
  return 1;
}

int perform(object me, object target) {
  int extra, i, k;
  string msg;
  object weapon;
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail(name() + "只能对战斗中的对手使用。\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");

  msg = HIC "\n$N手中" + weapon->query("name") + HIC "剑尖斜指对方，满面妖娆，轻声低叹！" NOR;
  msg += HIC "\n突然间$N手中宝剑光芒，飘忽异常，疾风暴雨般的攻势狂泻而出！\n" NOR;
  message_vision(msg, me, target);
  me->add("force", -200);
  me->set_temp("luan_jianshi", time());

  extra = me->query_skill("siqi-sword", 1);
  if (extra >= 1200) k = 4;
  else if (extra >= 900) k = 3;
  else k = 2;

  message_vision(HIY "\n$N纵身近前，" + weapon->name() + HIY "陡然直刺，突然间，剑光有了移动！\n" NOR, me, target);
  me->add_temp("apply/attack", extra / 6);
  me->add_temp("apply/damage", extra / 6);
  me->set_temp("qishen", 4);
  for (i = 0; i < k; i++) {
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    me->add("force", -25);
  }
  me->add_temp("apply/attack", -extra / 6);
  me->add_temp("apply/damage", -extra / 6);

  message_vision(
    HIG "\n$N伸指在" + weapon->name() + HIG "上一弹，剑光颤动，不知怎地，竞已化做一片光幕，这一是是击向哪一个部位？谁也瞧不出。这是快如白驹过隙的一刹那！！\n" NOR,
    me,
    target
  );
  me->add_temp("apply/attack", extra / 6);
  me->add_temp("apply/damage", extra / 6);
  me->set_temp("qishen", 3);
  for (i = 0; i < k; i++) {
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    me->add("force", -25);
  }
  me->add_temp("apply/attack", -extra / 6);
  me->add_temp("apply/damage", -extra / 6);

  message_vision(
    HIR "\n$N剑招突变，" + weapon->name() + HIR "根本不知道剑从何来，毫无蛛丝马迹可寻，如山泉涌地，蓦然出现，当行则行，当止则止，简直就是“羚羊挂角，无迹可求”、“不着一字，尽得风流”的诗境！\n" NOR,
    me,
    target
  );
  me->add_temp("apply/attack", extra / 6);
  me->add_temp("apply/damage", extra / 6);
  me->set_temp("qishen", 2);
  for (i = 0; i < k; i++) {
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    me->add("force", -25);
  }
  me->add_temp("apply/attack", -extra / 6);
  me->add_temp("apply/damage", -extra / 6);

  message_vision(
    HIW "\n只见$N手中" + weapon->name() + HIW "突听呛然两声龙吟，万丈金波上，已多了两道剑气。落日、金被，与剑气相映，直似七宝莲池，大放光明！群豪只觉目眩神迷，竟是不敢逼视！\n" NOR,
    me,
    target
  );
  me->add_temp("apply/attack", extra / 3);
  me->add_temp("apply/damage", extra / 3);
  me->set_temp("qishen", 1);
  for (i = 0; i < k; i++) {
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    me->add("force", -25);
  }
  me->add_temp("apply/attack", -extra / 3);
  me->add_temp("apply/damage", -extra / 3);
  me->delete_temp("qishen");
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("siqi-sword") + " 500 级\n";
  temp += "\t\t" + to_chinese("sword") + " 500 级\n";
  temp += "\t\t内力修６００点\n";
  temp += "\t\t必须在战斗状态下\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP 

        使用功效： 
                连续打击敌人的气血 
        出招类型： 
                无隐藏效果 
        出手要求：    
HELP);
  write(temp);
  return 1;
}
