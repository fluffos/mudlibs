//绕指柔情剑
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
        string msg;
        int extra;
        int addon, tmp, atk;
        object weapon;
        extra = me->query_skill("rouqingjian",1);
        if ( extra < 150) return notify_fail("你的绕指柔情剑还不够纯熟！\n");

        if ((int)me->query("force")<1000)
                return notify_fail("你的内力不足了。\n");
        
       if( (string)me->query("gender") != "无性" )
                return notify_fail("只有无性才能练的武功。\n");
if(me->query("family/family_name") != "神策军" )
                return notify_fail("你是哪儿偷学来的武功");
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("没事别乱用绕指柔情剑。\n");
        
        atk = (addon+tmp)/2;
        me->add_temp("apply/attack",atk);
        me->add_temp("apply/damage",extra);
        weapon = me->query_temp("weapon");
        message_vision(HIW"\n$N手中无剑，剑在心中！\n "NOR, me,target);
        message_vision(HIC"剑光犹如狂风暴雨般刺向$n\n"NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
              COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        message_vision(HIM"$N的剑势随着尖锋而变化，这变化就是这一剑的命脉居然已经达到到达无剑之境，以气育化万剑刺向$N！！！\n"NOR,target,me);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        me->add_temp("apply/attack",-atk);
        me->add_temp("apply/damage",-extra);
        me->add("force",-1000);
        me->start_busy(random(0));
        return 1;
}

