#include <ansi.h>

inherit SSERVER;

int cast(object me, object target)
{
   string msg;
   int damage, ap, dp;

   if( !target ) target = offensive_target(me);

   if( !target
   ||   !target->is_character()
   ||   target->is_corpse()
   ||   target==me)
     return notify_fail(HIR"你要对谁使用“情深深雨蒙蒙”？\n"NOR);

    if((int)me->query_skill("kuihua-baodian", 1) < 380 )
     return notify_fail("你的葵花宝典不够，哪里用得出这招！\n");
   
   if((int)me->query("mana") < 40+(int)me->query("mana_factor") )
     return notify_fail("你的法力不够！\n");
       if( (string)me->query("gender") != "无性" )
                return notify_fail("只有无性才能练的武功。\n");
if(me->query("family/family_name") != "神策军" )
                return notify_fail("你是哪儿偷学来的武功");

   if((int)me->query("force") < 200 )
     return notify_fail("你的内力不够，无法“情深深雨蒙蒙”了。\n");

   if((int)me->query("sen") < 40 )
     return notify_fail("你现在神智不清，别把自己打倒了！\n");

   me->add("mana", -50-(int)me->query("mana_factor"));
   me->add("force", -150);
   me->receive_damage("sen", 50);

   if( random(me->query("max_mana")) < 150 ) 
   {
     write("这一次好象失灵了。\n");
     return 1;
   }

   msg = HIW "$N口念咒语，脸色变得沉思、多愁善感，对着$n露出无限愁思！\n" NOR;

   ap = me->query_skill("spells");
      ap = ( ap * ap * ap / (4 * 400) ) * (int)me->query("sen");
   ap += (int)me->query("daoxing");
   dp = target->query("daoxing");
   if( random(ap + dp) > dp ) 
   {
     damage = (int)me->query("max_mana") / 10 + random((int)me->query("eff_sen") / 10);
     damage -= ((int)target->query("max_mana") / 10 + random((int)me->query("eff_sen") / 10));
     damage +=((int)me->query("mana_factor")-random((int)target->query("mana_factor")));
     damage +=((int)me->query_spi()-random((int)target->query_spi()));

     if( damage > 0 ) 
     {
        damage +=damage+random((damage*(int)me->query_skill("spells"))/240);
        msg += HIM "结果$n站在“情深深雨蒙蒙”的境界中，被雨丝迷住了双眼，被情思感化了心灵！\n" NOR;
        target->receive_damage("sen", damage, me);
        target->receive_wound("sen", damage*2, me);
        target->receive_damage("kee", damage*2, me);
        target->receive_wound("kee", damage*3, me);
        target->start_busy(1);
        me->improve_skill("wuji", 1, 1);
        me->start_busy(2);
     }
     else 
        {

        msg += HIC "结果$N的“情深深雨蒙蒙”并没有感染$n的思绪！\n" NOR;
        damage -= (int)target->query("mana_factor");
        damage -= random((-damage*(int)target->query_skill("spells"))/250);
        me->receive_damage("sen", -damage, target);
        me->receive_wound("sen", -damage, target);
        me->receive_damage("kee", -damage, target);
        me->receive_wound("kee", -damage, target);

     }
   } 
   else
     msg += "但是被$n躲开了。\n";

   message_vision(msg, me, target);
   if( damage > 0 ) COMBAT_D->report_status(target);
   else if( damage < 0 ) COMBAT_D->report_status(me);

   if( !target->is_fighting(me) ) 
   {
        if( living(target) ) 
     {
        if( userp(target) ) target->fight_ob(me);
        else target->kill_ob(me);
     }
     me->kill_ob(target);
   }

   me->start_busy(1+random(2));
   return 3+random(3);
}
