#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  object weapon;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("「" HIM "刺目" NOR "」只能在战斗中使用！\n");

  if (!me->is_fighting())
    return notify_fail("「" HIM " 刺目" NOR "」只能对战斗中的对手使用。\n");

  if ((int)me->query("max_force") < 500)
    return notify_fail(RED "你的内力修为不足，无法运足「刺目」的内力。\n" NOR);


  if ((int)me->query("force") < 500)
    return notify_fail(HIC "你现在内力不够，没能将「刺目」使完！\n" NOR);
  if (me->query("family/family_name") != "神策军")
    return notify_fail("你是哪儿偷学来的武功");

  if ((int)me->query("sen") < 500)
    return notify_fail(HIC "你的精神不足，没法子施用「刺目」！\n" NOR);

  if ((int)me->query_skill("pixie-canjian", 1) < 80)
    return notify_fail(HIM "你的辟邪残剑不够娴熟，还使不出「幻剑」。\n" NOR);
  if ((string)me->query("gender") != "无性")
    return notify_fail("只有无性才能练的武功。\n");

  if ((int)me->query_skill("sword", 1) < 80)
    return notify_fail(HIY "你的基本剑法火候不够，「刺目」不成招式。\n" NOR);
  if (me->query_temp("last_pili") + 3 > time())
    return notify_fail("你内力使用过度，「" HIM "刺目" NOR "」不成招式。\n");
  me->delete("env/brief_message");
  target->delete("env/brief_message");

  if (!present(target, environment(me))) return 1;
  message_vision(HIM "\n$N手中长剑直指对方双眼，剑尖渐\n" NOR, me, target);
  message_vision(HIM "渐逼近$n，$n看到漫天剑光，抽身后跃，只这一刹，漫天剑\n" NOR, me, target);
  message_vision(HIM "影化为一剑直刺$n双眼，变幻莫测，决定命运的一剑终于发出了！\n" NOR, me, target);
  me->set_temp("QJB_perform", 4);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 10);

  if (!present(target, environment(me))) return 1;
  me->set_temp("QJB_perform", 1);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 10);

  if (!present(target, environment(me))) return 1;
  me->set_temp("QJB_perform", 6);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 10);



  me->delete_temp("QJB_perform");

  me->receive_damage("sen", 100);
  me->add("force", -100);

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }

  me->set_temp("last_pili", time());
  return 1;
}
