#include <ansi.h>
inherit SSERVER;

void check(object me);
void pfmgui_effect(object me, object victim);
void guimei_effect(object me, object victim);
void remove_effect(object me);

int perform(object me)
{
        int skill;
        int sword_skill,snowsword_skill;
        
        skill = me->query_skill("kuihua-xinfa",1);
      if( skill > 200 ) skill=200;
        sword_skill= me->query_skill("sword",1);
        snowsword_skill= me->query_skill("pixie-canjian",1);
                       
                               
        if( skill < 100 )  return notify_fail("你的葵花心法修为不够。\n");
        if( sword_skill < 80 )  return notify_fail("你的基本剑法未够纯熟。\n");
        if( snowsword_skill < 120 )  return notify_fail("你的辟邪残剑未够纯熟。\n");
       if( (string)me->query("gender") != "无性" )
                return notify_fail("只有无性才能练的武功。\n");
                        
        
  if(me->query("family/family_name") != "神策军")
               return notify_fail("[鬼魅]是神策军不传之密！\n");     
        
               
        
        if( (int)me->query("force") < skill )     
                return notify_fail("你的内力不够。\n");
 
//    me->add("force", -skill);
        message_vision(HIW "$N把葵花心法在体内运行一周，只觉得身体都轻了不少！\n" NOR, me);
        me->set_temp("pfmgui", 1);
        me->set_temp("guimei", 1);
        me->set_temp("guimei_time",skill*3);
        me->set_temp("pfmgui_time",skill*3);
//         me->add_temp("apply/dodge",skill/2);
  //      me->set_temp("apply/sword",skill/2);
                   
        call_out("check", 1, me);
        return 1;
}


void check(object me)
{       
        object weapon;
        
         if(!me) return;
                
         if (me->query_skill_mapped("force") != "kuihua-xinfa"
                 || !objectp(weapon=me->query_temp("weapon")) 
                 || (weapon->query("apply/skill_type") != "sword" 
                     && weapon->query("skill_type") != "sword" ) 
                 ||  me->query_skill_mapped("sword") != "pixie-canjian" )     
             remove_effect(me);
         else if(me->query_temp("pfmgui_time")<1)
             remove_effect(me);                 
         else {  me->add_temp("pfmgui_time",-1);
                call_out("check", 1, me);
              }
                     
}


void remove_effect(object me)
{
        int skill = me->query_skill("kuihua-xinfa",1);
        if(!me) return;
        remove_call_out("check");
        me->delete_temp("pfmgui");
        me->set_temp("pfmgui_end",time());
//         me->add_temp("apply/dodge",-skill/2);
        me->delete_temp("guimei");
//        me->delete_temp("apply/sword");
//         tell_object(me, GRN"你将葵花心法收回丹田。\n"NOR);
}

void pfmgui_effect(object me, object victim)
{   int damage,ini_damage_apply,skill,ini_attack_apply;
    string str;
    skill = me->query_skill("pixie-canjian",1)/2; 
   
   if ( random(2)>0 )
          { ini_damage_apply = me->query_temp("apply/damage");
            ini_attack_apply = me->query_temp("apply/attack");
            me->add_temp("pfmgui",1);
   message_vision(HIW"\n$N腰枝一摆，$n眼前仿佛突然出现了七八个$N，一起刺向$n！\n"NOR,me,victim);
  //          me->add_temp("apply/damage",30);
   //         me->add_temp("apply/attack",skill);
            damage = COMBAT_D->do_attack(me, victim, me->query_temp("weapon"));         
         
               
   if( damage <= 0 )
          {
message_vision(HIW"\n$N腰枝一摆，$n眼前仿佛突然出现了七八个$N，一起刺向$n！\n"NOR,me,victim);
   //        me->add_temp("apply/damage",30);
    //       me->add_temp("apply/attack",skill);
           COMBAT_D->do_attack(me, victim, me->query_temp("weapon"));         
           me->add_temp("pfmgui",-1);
           }             
    else me->add_temp("pfmgui",-1);
    
 //   me->set_temp("apply/damage",ini_damage_apply);
  //  me->set_temp("apply/attack",ini_attack_apply);
          }
}
 

void guimei_effect(object me, object victim)
{   int damage,ini_damage_apply;
    string str;

   if ( random(2)>0 )
          { ini_damage_apply = me->query_temp("apply/damage");
            me->add_temp("guimei",1);
   message_vision(HIW"\n$N脚踏葵花挪移大法，微一转身，从几乎不可能的角度刺向$n！\n"NOR,me,victim);
      //      me->add_temp("apply/damage",15);
            damage = COMBAT_D->do_attack(me, victim, me->query_temp("weapon"));         
         
               
   if( damage > 0 )
          {
   message_vision(HIW"\n$N脚踏葵花挪移大法，微一转身，从几乎不可能的角度刺向$n！\n"NOR,me,victim);
     //      me->add_temp("apply/damage",15);
           COMBAT_D->do_attack(me, victim, me->query_temp("weapon"));         
           me->add_temp("guimei",-1);
           }             
    else me->add_temp("guimei",-1);
    
   // me->set_temp("apply/damage",ini_damage_apply);
          }
}

