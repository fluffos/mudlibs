//bazhinv.c by yushu 2001.1
#include <ansi.h>
inherit SSERVER;
int perform(object me, object target) {
  object weapon;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这一招「乱弹琴」？\n");

  if (!me->is_fighting())
    return notify_fail("「乱弹琴」只能在战斗中使用！\n");

  if ((int)me->query("max_force") < 2100)
    return notify_fail("你的内力不够！\n");
  if ((string)me->query("gender") != "无性")
    return notify_fail("只有无性才能练的武功。\n");
  if (me->query("family/family_name") != "神策军")
    return notify_fail("你是哪儿偷学来的武功");
  if (time() - (int)me->query_temp("lt_end") < 2)
    return notify_fail("绝招用多就不灵了！\n");

  if ((int)me->query("force") < 1000)
    return notify_fail("你的内力不足！\n");

  if ((int)me->query("sen") < 250)
    return notify_fail("你的精神不足，没法子施用外功！\n");

  if ((int)me->query_skill("pixie-canjian", 1) < 150)
    return notify_fail("你的辟邪残剑级别还不够，无法使用「乱弹琴」!\n");

  weapon = me->query_temp("weapon");

  message_vision(HIR "\n$N大喊一声:老杂毛竟敢和贫僧抢尼姑。。接招!罗汉发疯-天地无极-乾坤借法,直冲向$n!\n" NOR, me, target);

  COMBAT_D->do_attack(me, target);
  message_vision("\n" HIY "辟邪剑法一段" NOR "-------" BLINK HIR "落花流水\n" NOR, me);
  COMBAT_D->do_attack(me, target);
  message_vision("\n" HIY "辟邪剑法二段" NOR "-------" BLINK HIG "摧花斫柳\n" NOR, me);
  COMBAT_D->do_attack(me, target);
  message_vision("\n" HIY "辟邪剑法三段" NOR "-------" BLINK HIR "月缺花残\n" NOR, me);
  COMBAT_D->do_attack(me, target);
  message_vision("\n" HIY "辟邪剑法四段" NOR "-------" BLINK HIR "天人五衰\n" NOR, me);
  COMBAT_D->do_attack(me, target);
  message_vision("\n" HIY "辟邪剑法五段" NOR "-------" BLINK HIR "残花败柳\n" NOR, me);
  COMBAT_D->do_attack(me, target);
  me->receive_damage("sen", 100);
  me->add("force", -800);

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }

  me->set_temp("lt_end", time());

  return 1;
}
