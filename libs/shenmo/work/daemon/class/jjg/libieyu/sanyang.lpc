
#include <ansi.h> 
#include <combat.h>
inherit SSERVER; 

string name() 
{
return "「"HIW"三阳玄针"NOR"」"; 
}
int valid_perform(object me) 
{
    if ( me->query_skill("libieyu", 1) < 320 ) 
        return notify_fail("你的"+to_chinese("libieyu")+"修为尚浅，不能施展"+name()+"。\n"); 
    if ( me->query_skill("xixingdafa", 1) < 100 ) 
        return notify_fail("你的"+to_chinese("xixingdafa")+"修为尚浅，不能施展"+name()+"。\n");
    if ( me->query_skill("force", 1) < 100 ) 
        return notify_fail("你的"+to_chinese("force")+"修为尚浅，不能施展"+name()+"。\n");
    if ( me->query("max_force")<600 ) 
        return notify_fail("你的内力修为尚浅，不能施展"+name()+"。\n"); 
    if ( me->query("force")<1000 ) 
        return notify_fail("你的真气不足，不能施展"+name()+"。\n"); 
    if(time()-me->query_temp("sanyang_busy")< 1+random(0))
        return notify_fail(name()+"不能用得这么频繁！\n");  
return 1; 
}

int perform(object me, object target)
{
    string msg;
    object weapon;
    int extra, damage;
if ( !valid_perform(me) ) 
        return 0;   
    if( !target ) target = offensive_target(me);
    if( !target
    ||      !target->is_character()
    ||      target->is_corpse()
    ||      target==me) 
        return notify_fail(""+name()+"只能对战斗中的对手使用。\n");
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n"); 

    extra = me->query_skill("libieyu",1) + me->query_skill("stick",1);
    weapon = me->query_temp("weapon");
    me->add("force",-500);
    me->set_temp("tianxia_busy",time());

message_vision(HIG"\n$N速度突然加快，直若鬼魅使出离别羽中的无上绝技"+name()+HIG"，\n手中的"+weapon->name()+HIG"刺出一点点x光，朝$n"HIG"铺天盖地！\n" NOR,me,target);
    if ((int)me->query("dgbang_agree")==2)
    extra = extra/3;
    else
    extra = extra/5;
    me->add_temp("apply/attack", extra);
    me->add_temp("apply/damage", extra);
if (random((int)me->query_skill("dodge", 1)/2)>random((int)target->query_skill("dodge",1)/2 ) || (int)me->query("dgbang_agree")==2)
    {
    if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
    message_vision(HIB"云卷流星！\n" NOR,me,target);
    COMBAT_D->do_attack(me,target, weapon); 
    if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
    message_vision(HIC"金丝断魂！\n" NOR,me,target);
    COMBAT_D->do_attack(me,target, weapon); 
    if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
    message_vision(YEL"金针识络！\n" NOR,me,target);
    COMBAT_D->do_attack(me,target, weapon); 
    if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
    message_vision(HIB"神针追命！\n" NOR,me,target);
    COMBAT_D->do_attack(me,target, weapon); 
    if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
    message_vision(HIR"飞针引穴！\n" NOR,me,target);
    COMBAT_D->do_attack(me,target, weapon); 
    if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
    message_vision(HIW"通经活络！\n" NOR,me,target);
    COMBAT_D->do_attack(me,target, weapon); 
    if (me->query_skill("zhaixing-shou", 1)> 199 )
        {
        msg = HIG "$N嫉天道玄默，皎阳似火，深浅在志，远近如一。其中中夹杂了"+HIR+"摘星手！\n"NOR;
        message_vision(msg, me);
        COMBAT_D->do_attack(me,target, weapon);
        COMBAT_D->do_attack(me,target, weapon);
        COMBAT_D->do_attack(me,target, weapon);
        }
    if (random(me->query("level")) > target->query("level")/2 || (int)me->query("dgbang_agree")==2)
        {
        message_vision(HIM"$N如临深渊，手如握虎，天覆地载，万物悉备。，$n"HIM"被刺的体无完肤！\n" NOR,me,target);
        damage=extra*4;
        damage+=random(me->query("level"));
        damage+=me->query("force_factor");
        damage-=target->query("level")/2;
        if (damage<500)  damage=500;
        target->receive_damage("kee", damage, me);
        target->receive_wound("kee", damage, me);
        COMBAT_D->report_status(target);
        me->add("force",-me->query("force_factor"));
        }
    }
    else
    {
    message_vision(HIB"$N对着$n笑道：必欲治病，莫如用针。巧运神机之妙，功开圣理之深破你这招"+name()+"！\n" NOR,target,me);
    COMBAT_D->do_attack(target,me, target->query_temp("weapon"),TYPE_REGULAR,msg);
    COMBAT_D->do_attack(target,me, target->query_temp("weapon"),TYPE_REGULAR,msg);
    COMBAT_D->do_attack(target,me, target->query_temp("weapon"),TYPE_REGULAR,msg);
    }
    me->add_temp("apply/attack", -extra);
    me->add_temp("apply/damage", -extra);
    return 1;
}
int help(object me)   
{
string temp; 
temp = "\t\t"+to_chinese("libieyu")+" 100 级\n";
temp+= "\t\t内力 1000 点\n";
temp+= "\t\t必须在战斗状态下\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP

        使用功效：
                连续打击敌人的气血
        出招类型：
                延时型外功
                有隐藏效果
        出手要求：              
HELP);  
write(temp);
return 1;
}
