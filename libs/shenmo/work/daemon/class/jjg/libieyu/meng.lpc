#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
string msg;
int extra;
object weapon;
if (extra = me->query_skill("libieyu",1)<100) return notify_fail("你的离别羽还不够纯熟！\n");
if( !target ) target = offensive_target(me);
if( !target
||      !target->is_character()
||      !me->is_fighting(target) )
return notify_fail("［诗梦雾幻］只能对战斗中的对手使用。\n");
weapon = me->query_temp("weapon");
message_vision(HIG"\n$N暗器突转使出离别羽的绝学--诗梦雾幻！！\n"NOR,me,target);
message_vision(HIW"幻灭，$N手中的"+ weapon->name()+  "雾化出点点星光攻向$n！" NOR,me,target);
         target->strat_busy(1);
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
message_vision(HIC"\n红线，$N手中的"+ weapon->name()+  "暗点三十六处大穴，搂、打、腾、踢、弹、扫，变化无穷，虚实莫测！"NOR,me,target);
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg
);
message_vision(HIW"\n
梳妆！$N手中的"+ weapon->name()+  "引动天地之力，和自己的黑气融为一体，如乌云直下！"NOR,me,target);
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg
);
message_vision(HIC"\n
班姬赋诗！$N手中的"+ weapon->name()+  "如暴雨般倾泻，又如狂风般猛烈，这就是暴雨狂风之绝。！"NOR,me,target);
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg
);
me->start_busy(1+random(1));
return 1;
}

