#include <ansi.h>
inherit SSERVER;

string name() {
  return "「" HIB "六道轮回" NOR "」";
}

int valid_perform(object me) {
  if (time() < me->query_temp("ldlh_end") + 10)
    return notify_fail("不能频繁出入「六道轮回」！\n");
  if (me->query("family/family_name") != "阎罗地府" && !me->samsara_check("hellfire-whip", 1))
    return notify_fail(name() + "是地府的绝招。\n");
  if (me->query_skill("hellfire-whip", 1) < 250)
    return notify_fail("你的" + to_chinese("hellfire-whip") + "等级不足250，无法施展" + name() + "。\n");
  if (me->query_skill("gouhunshu", 1) < 100)
    return notify_fail("你的" + to_chinese("gouhunshu") + "等级不足100，无法施展" + name() + "。\n");
  if (me->query_skill_mapped("force") != "tonsillit")
    return notify_fail("「六道轮回」必须配合摄气诀才能使用。\n");
  if (me->query_skill_mapped("spells") != "gouhunshu")
    return notify_fail("「六道轮回」必须配合勾魂术才能使用。\n");
  if (me->query("force") < 1000)
    return notify_fail("你的内力不足 1000 点，施展不出" + name() + "。\n");
  if (me->query("kee") < 300)
    return notify_fail("你的气血不足 300 点，施展不出" + name() + "。\n");
  return 1;
}

void remove_effect(object me) {
  if (!me)
    return;
  me->delete_temp("ldlh");
  me->delete_temp("lunhui");
  message_vision(HIW "$N" HIW "从「六道轮回」走了出来。\n" NOR, me);
  me->set_temp("ldlh_end", time());
}

int perform(object me, object target) {
  object weapon;
  int i, j;

  if (!valid_perform(me))
    return 0;
  if (me->query_temp("ldlh")) {
    remove_effect(me);
    return 1;
  }
  weapon = me->query_temp("weapon");
  message_vision(HIW "\n$N" HIW "口中念念有词：般若波罗密，般若波罗密，苦难众生
与我共堕六道，再渡轮回。\n" NOR, me);
  me->set_temp("lunhui", 0);
  me->set_temp("ldlh", 1);
  me->set_temp("ldlh_time", 60 + random((me->query_skill("force") + me->query_skill("whip")) / 6));
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("hellfire-whip") + " 等级 250 级\n";
  temp += "\t\t" + to_chinese("gouhunshu") + " 等级 100 级\n";
  temp += "\t\t内    力 1000 点\n";
  temp += "\t\t气    血 300 点\n";
  temp += "\t\t法术激发 勾魂术\n";
  temp += "\t\t内力激发 摄气诀\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                改变自身的攻击招式                
        出招类型：
                延迟型外功
                无隐藏攻击
                不可以叛师带出
                可二次关闭
        出手要求：              
HELP);
  write(temp);
  return 1;
}
