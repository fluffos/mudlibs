#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name()
{
return "「"HIG"碧落黄泉"NOR"」";
}

int valid_perform(object me)
{
if ( me->query("class")!="xian" && !me->samsara_check("hellfire-whip") )
        return notify_fail(name()+"是仙界的绝招。\n");
if ( me->query_skill("hellfire-whip",1)<120 )
        return notify_fail("你的"+to_chinese("hellfire-whip")+"等级不足120，无法施展"+name()+"。\n");
if ( me->query("force")<150 )
        return notify_fail("你的内力不足 150 点，施展不出"+name()+"。\n");
if ( me->query("max_force")<500 )
        return notify_fail("你的内力修为不足 500 点，施展不出"+name()+"。\n");
if ( me->query("kee")<200 )
        return notify_fail("你的气血不足 200 点，施展不出"+name()+"。\n");   
return 1;               
}

int perform(object me, object target)
{
string msg;
int ap,dp,damage,self=0,dodge=0;
object weapon;
if ( !valid_perform(me) )
        return 0;
if ( !target ) 
        target = offensive_target(me);
if ( !target
  || !target->is_character()
  || !me->is_fighting(target) )
        return notify_fail(name()+"只能对战斗中的对手使用。\n");
if ( !me->is_fighting() )
        return notify_fail(name()+"必须在战斗中使用。\n");        

me->add("force",-150);
if ( random(me->query("max_force"))<250 ) 
        {
        write("糟糕，没成功！\n");
        return 1;
        }       

ap = COMBAT_D->skill_power(me,"whip",SKILL_USAGE_ATTACK);
ap/= 50;
dp = COMBAT_D->skill_power(target,"dodge",SKILL_USAGE_DEFENSE); 
dp+= COMBAT_D->skill_power(target,"parry",SKILL_USAGE_DEFENSE); 
dp/= 150;
if ( COMBAT_D->restrain(me,target) )
        ap+= random(ap/5);
if ( COMBAT_D->restrain(target,me) )
        dp+= random(dp/5);
if ( me->query("family/family_name")=="阴曹地府" )
        ap+= random(ap/10);
if ( ap<1 )  ap = 1;            
if ( dp<1 )  dp = 1;

damage = ap-dp;
damage/= 5;
weapon = me->query_temp("weapon");

me->receive_damage("kee",100,me);
msg = MAG"
$N"MAG"惨号一声，一口鲜血喷向半空，$P手中"+weapon->name()+MAG"吃这主人心血一逼，
啸声大作，夹着阵阵鬼哭闪电般飞袭$n"MAG"的胸口七处大穴！\n"NOR;
if ( random(ap+dp)>dp )
        {
        self++; 
        if ( damage>0 ) 
                {
                if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
                        msg+= HIR"结果"+weapon->name()+HIR"在$n"HIR"胸口三进三出，带出一地鲜血！\n"NOR;
                target->receive_wound("kee",damage,me);
                }
        else    {
                dodge++;
                if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
                        msg+=MAG"但是$n"MAG"一声轻笑，身形摇晃，避了开去。\n" NOR;
                }       
        }
else    {
        if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
                msg+= MAG"但是被$n"MAG"以内力一逼，"+weapon->name()+MAG"掉转头来，反噬其主！\n" NOR; 
        if ( damage>=0 )
                {
                dodge++;        
                if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
                        msg+=MAG"但是$N"MAG"一声轻笑，身形摇晃，避了开去。\n" NOR;
                }
        else    {
                if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
                        msg+= MAG"结果只听“噗嗤”一声，$N"MAG"反被长鞭透胸而过！\n" NOR;
                damage = -damage;
                if ( damage>5 )
                        me->receive_wound("kee",damage/5,target);
                }
        }
message_vision(msg,me,target);
if ( !dodge )
        {
        if ( self )
                {
                if ( damage )
                        COMBAT_D->report_status(target,damage);
                }
        else    {
                if ( damage>5 )
                        COMBAT_D->report_status(me,damage/5);
                }               
        }
me->start_busy(random(3));
if ( wizardp(me) )
        tell_object(me,NOR HIC BLK"\tap==="+ap+"  dp==="+dp+"\n"NOR);
return 1;
}

int help(object me)
{
string temp;    
temp = "\t\t"+to_chinese("hellfire-whip")+" 等级 120 级\n";
temp+= "\t\t内    力 150 点\n";
temp+= "\t\t内力修为 500 点\n";
temp+= "\t\t气    血 200 点\n";
temp+= "\t\t战斗中使用\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");
write(@HELP

        使用功效：
                利用减少自己的气血来增加
                武器的伤害以对敌人造成气
                血的损伤
                
        出招类型：
                busy型外功
                无隐藏攻击
                可以叛师带出
                与对手修为相差太大，会有反噬的可能                
        出手要求：              
HELP);                          
write(temp);
return 1;
}
