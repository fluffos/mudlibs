#include <ansi.h>
inherit SSERVER;
inherit F_DBASE;

string name() {
  return "「" HIR "炼狱轮回" NOR "」";
}

int valid_perform(object me) {
  if (me->query("family/family_name") != "阎罗地府" && !me->samsara_check("hellfire-whip", 1))
    return notify_fail(name() + "乃是地府不传之密。\n");
  if (me->query_skill("tonsillit", 1) < 60)
    return notify_fail("你的" + to_chinese("tonsillit") + "等级不足60，无法施展" + name() + "。\n");
  if (me->query_skill("whip", 1) < 60)
    return notify_fail("你的" + to_chinese("whip") + "等级不足60，无法施展" + name() + "。\n");
  if (me->query_skill("hellfire-whip", 1) < 60)
    return notify_fail("你的" + to_chinese("hellfire-whip") + "等级不足60，无法施展" + name() + "。\n");
  if (me->query("force") < 300)
    return notify_fail("你的内力不足 300 点，施展不出" + name() + "。\n");
  if (time() < me->query_temp("hell_lunhui") + 4)
    return notify_fail(name() + "需要4秒的冷却时间。\n");
  return 1;
}

void delay_effect(object me, object target, object weapon, int power) {
  mapping action;
  mapping new_act = ([]);
  int attack, damage;

  if (!me || !target || environment(me) != environment(target)
    || !weapon || me->query_temp("weapon") != weapon
    || !me->is_fighting(target))
    return;

  message_vision(HIR "
$N" HIR "鞭势突然一变，手中" + weapon->name() + HIR "幻做漫天鞭影，将$n" HIR "的退路全部封死。\n" NOR, me, target);
  message_vision(HIR "$N" HIR "觉得有如置身炼狱，四周都是熊熊鬼火，深受轮回之苦，连气都透不过来。\n" NOR, target);
  me->set("actions", (: call_other, SKILL_D("hellfire-whip"), "query_pfm_action" :));
  attack = me->query_temp("apply/attack");
  damage = me->query_temp("apply/damage");
  me->add_temp("apply/attack", me->query_skill("hellfire-whip", 1) * power);
  me->add_temp("apply/damage", damage * power + me->query("force_factor"));
  COMBAT_D->do_attack(me, target, weapon);
  me->set_temp("apply/attack", attack);
  me->set_temp("apply/damage", damage);
  me->reset_action();
  me->start_busy(1 + random(2));
}


int perform(object me, object target) {
  int delay, skill;
  object weapon = me->query_temp("weapon");

  if (!valid_perform(me))
    return 0;

  if (!target)
    target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(name() + "只能对战斗中的对手使用。\n");
  if (!me->is_fighting())
    return notify_fail(name() + "必须在战斗中使用。\n");
  skill = me->query_skill("whip");

  me->add("force", -200);
  delay = random(2) + 1;
  message_vision(HIB "
$N" HIB "阴恻恻地一笑，手中" + weapon->name() + HIB "突然慢了下来，$n" HIB "一见大喜，抓住机会，
上前就是一轮疾攻！\n" NOR, me, target);
  me->set_temp("hell_lunhui", time());
  //me->start_busy(delay);
  me->start_call_out((: call_other, __FILE__, "delay_effect",
    me, target, weapon, delay :), delay);
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("tonsillit") + " 等级 60 级\n";
  temp += "\t\t" + to_chinese("whip") + " 等级 60 级\n";
  temp += "\t\t" + to_chinese("hellfire-whip") + " 等级 60 级\n";
  temp += "\t\t内    力 300 点\n";
  temp += "\t\t战斗中使用\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                改变自身攻击方式对敌人进行一次打击
        出招类型：
                延迟型外功
                无隐藏攻击
                不可以叛师带出
        出手要求：              
HELP);
  write(temp);
  return 1;
}
