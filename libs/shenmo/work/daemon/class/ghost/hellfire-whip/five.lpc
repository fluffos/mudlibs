#include <ansi.h>
inherit SSERVER;

string name()
{
return "「"HIB"天·地·神·人·鬼"NOR"」";
}

int valid_perform(object me)
{
if ( me->query("family/family_name")!="阎罗地府" && !me->samsara_check("hellfire-whip", 1) )
        return notify_fail(name()+"乃是地府不传之密。\n");
if ( me->query_skill_mapped("stick")!="kusang-bang" )
        return notify_fail(name()+"必须配合苦丧棒才能使用。\n");              
if ( me->query_skill_mapped("unarmed")!="jinghun-zhang" )
        return notify_fail(name()+"必须配合惊魂掌才能使用。\n");              
if ( me->query_skill("hellfire-whip",1)<100 )
        return notify_fail("你的"+to_chinese("hellfire-whip")+"等级不足100，无法施展"+name()+"。\n");
if ( me->query_skill("whip",1)<100 )
        return notify_fail("你的"+to_chinese("whip")+"等级不足100，无法施展"+name()+"。\n");
if ( me->query("force") < 300 )      
        return notify_fail("你的内力不足 300 点，施展不出"+name()+"。\n");
if ( me->query("max_force") < 1000 )      
        return notify_fail("你的内力修为不足 1000 点，施展不出"+name()+"。\n");
if ( time()<me->query_temp("hell_three")+2+random(4) )
        return notify_fail(name()+"需要一定的冷却时间。\n");
return 1;               
}

int perform(object me, object target)
{
int delay,skill;
object weapon=me->query_temp("weapon");

if ( !valid_perform(me) )
        return 0;

if ( !target ) 
        target = offensive_target(me);
if ( !target
  || !target->is_character()
  || !me->is_fighting(target) )
        return notify_fail(name()+"只能对战斗中的对手使用。\n");
if ( !me->is_fighting() )
        return notify_fail(name()+"必须在战斗中使用。\n");        
skill = me->query_skill("whip");
       
me->add("force", -200);
if ( me->query("family/family_name")=="阎罗地府" )
        {
        if ( !target->is_busy() )       
                target->start_busy(1);
        me->add_temp("apply/damage",300);
        me->add_temp("apply/attack",300);
        }
message_vision(HIB"
$N"HIB"双手划一大圆，猛然托天而举，伴着天上雷鸣电闪，祭出了"+name()+HIB"五招。\n"NOR,me,target);
if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
        message_vision(HIB"\n四周磷光点点，$N"HIB"舞动"+weapon->name()+HIB"，咯咯一笑，扑向$n"HIB"。\n"NOR,me,target);
COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

me->set("actions", (: call_other, SKILL_D("jinghun-zhang"), "query_action" :) );
if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
        message_vision(HIB"\n但见幢幢鬼影四周飘浮，突然$N"HIB"鬼唱一声，无数鬼手抓向$n"HIB"。\n"NOR, me,target); COMBAT_D->do_attack(me, target);
COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

me->set("actions", (: call_other, SKILL_D("kusang-bang"), "query_action" :) );
if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
        message_vision(HIB"\n$N"HIB"双手一抖，手中"+weapon->name()+NOR+HIB"顿时变的笔直，如同一根铁棍。\n"NOR,me);
COMBAT_D->do_attack(me, target, me->query_temp("weapon"));      
COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        
me->reset_action();
me->set_temp("hell_three",time());
if ( me->query("family/family_name")=="阎罗地府" )
        {
        me->add_temp("apply/damage",-300);
        me->add_temp("apply/attack",-300);
        }
return 1;
}

int help(object me)
{
string temp;    
temp = "\t\t"+to_chinese("whip")+" 等级 100 级\n";
temp+= "\t\t"+to_chinese("hellfire-whip")+" 等级 60 级\n";
temp+= "\t\t内    力 300 点\n";
temp+= "\t\t内力修为 1000 点\n";
temp+= "\t\t战斗中使用\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");
write(@HELP

        使用功效：
                改变自身攻击方式对敌人进行五次打击
        出招类型：
                延迟型外功
                有隐藏攻击
                不可叛师带出
        出手要求：              
HELP);                          
write(temp);
return 1;
}
