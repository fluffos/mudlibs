
#include <ansi.h>
inherit SSERVER;
void breaken(object obj);
 
int perform(object me)
{
string msg;
object weapon, weapon2, target;
int skill, dp, damage;

me->clean_up_enemy();
target = me->select_opponent();

if( (int)me->query_temp("duo") )
	return notify_fail("你已经在夺敌人的兵刃了。\n");
skill = me->query_skill("jinghun-zhang",1);

if( !(me->is_fighting() ))
	return notify_fail("空手入白刃只能对战斗中的对手使用。\n");
 
if (objectp(weapon = me->query_temp("weapon")))
	return notify_fail("你必须空手。\n");

if(me->query("family/family_name")!="阎罗地府")
	return notify_fail("你非鬼类，地府的武功你从哪里偷来的\n");
        
if (!objectp(weapon2 = target->query_temp("weapon")))
	return notify_fail("对方没有兵刃，你不用担心。\n");

if((int)me->query_skill("jinghun-zhang",1) < 100)
	return notify_fail("你的惊魂掌等级不够, 不能空手入白刃！\n");
                
if( me->query("force") < 200 )
	return notify_fail("你的内力不够，无法空手入白刃！\n");
 
msg = HBBLU "$N突然现出一张鬼脸，双臂暴涨,冷冷一笑，你敢空手和我斗不. \n";
message_vision(msg, me);
 
dp = target->query_skill("parry") /4;
if( dp < 1 )
	dp = 1;
if( random(skill) > dp )
	{
	if(userp(me))
	me->add("force",-80);
	msg = HBMAG "$n大怒，我有何不敢。说罢扔掉手中兵器就朝$N扑了过去！\n" NOR;
	target->start_busy(2);
	weapon2->unequip();
	weapon2->move(environment(target));
	call_out("breaken",5+random(5),weapon2);
	me->start_busy(random(2));
	}
else	{
	msg =HBMAG "可是$n不为$N的鬼话所迷，对$N的jjyy不理不睬。\n"NOR;
	me->start_busy(random(2));
	}
message_vision(msg, me, target);
return 1;
}

void breaken(object obj)
{
if ( obj )
	{
	write ("一阵微风飞过，"+obj->name()+NOR"随之化作一团尘土散去。\n");
	destruct(obj);
	}
return;
}