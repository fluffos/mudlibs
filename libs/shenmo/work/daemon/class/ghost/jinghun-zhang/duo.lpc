#include <ansi.h>
inherit SSERVER;
void breaken(object obj);

string name() {
  return "「" HIW "空手入白刃" NOR "」";
}

int valid_perform(object me) {
  if ((int)me->query_temp("duo"))
    return notify_fail("你已经在夺敌人的兵刃了。\n");


  if (me->query("family/family_name") != "阎罗地府" && !me->samsara_check("jinghun-zhang", 1))
    return notify_fail("你非鬼类，地府的武功你从哪里偷来的\n");


  if ((int)me->query_skill("jinghun-zhang", 1) < 100)
    return notify_fail("你的惊魂掌等级不够, 不能" + name() + "！\n");

  if (me->query("force") < 200)
    return notify_fail("你的内力不够，无法" + name() + "！\n");

  return 1;
}

int perform(object me, object target) {
  string msg;
  object weapon, weapon2;
  int skill, dp, damage;
  me->clean_up_enemy();
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!(me->is_fighting()))
    return notify_fail(name() + "只能对战斗中的对手使用。\n");
  if (objectp(weapon = me->query_temp("weapon")))
    return notify_fail("你必须空手。\n");
  if (!objectp(weapon2 = target->query_temp("weapon")))
    return notify_fail("对方没有兵刃，你不用担心。\n");
  skill = me->query_skill("jinghun-zhang", 1);

  msg = HBBLU "$N突然现出一张鬼脸，双臂暴涨,冷冷一笑，你敢空手和我斗不. \n";
  message_vision(msg, me);

  dp = target->query_skill("parry") / 4;
  if (dp < 1)
    dp = 1;
  if (random(skill) > dp) {
    if (userp(me))
      me->add("force", -80);
    msg = HBMAG "$n大怒，我有何不敢。说罢扔掉手中兵器就朝$N扑了过去！\n" NOR;
    target->start_busy(2);
    weapon2->unequip();
    if (weapon2->query("no_get") || weapon2->query("no_drop") || weapon2->query("warcity"))
      destruct(weapon2);
    else
      weapon2->move(environment(target));
    call_out("breaken", 5 + random(5), weapon2);
    me->start_busy(random(2));
  } else {
    msg = HBMAG "可是$n不为$N的鬼话所迷，对$N的jjyy不理不睬。\n" NOR;
    me->start_busy(random(2));
  }
  message_vision(msg, me, target);
  return 1;
}

void breaken(object obj) {
  if (obj) {
    write("一阵微风飞过，" + obj->name() + NOR "随之化作一团尘土散去。\n");
    destruct(obj);
  }
  return;
}
int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("jinghun-zhang") + " 等级 100 级\n";
  temp += "\t\t内力 200 点\n";
  temp += "\t\t对方必须有兵器\n";
  temp += "\t\t自己必须无兵器\n";
  temp += "\t\t必须在战斗中\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效： 
                夺取敌人的兵器并有可能牵制敌人
        出招类型： 
                busy 型外功 
                无隐藏攻击 
                不可叛师带出 
        出手要求：      
HELP);
  write(temp);
  return 1;
}
