#include <ansi.h>
inherit SSERVER;

void post_zhua(object me, object target, object weapon, int damage);
void post_gun(object me, object target, object weapon, int damage);
void post_whip(object me, object target, object weapon, int damage);
void hell_fire(object me, object target, object env, int damage);

string name() {
  return "「" HIB "人·鬼·神" NOR "」";
}

int valid_perform(object me) {
  if (me->query("class") != "xian" && !me->samsara_check("kusang-bang"))
    return notify_fail(name() + "乃是仙界不传之密。\n");
  if (time() < me->query_temp("hell_bang_busy") + 2 + random(5))
    return notify_fail("你已经祭出了「人·鬼·神」了！\n");
  if (me->query_skill("kusang-bang", 1) < 150)
    return notify_fail("你的" + to_chinese("kusang-bang") + "等级不足150，无法施展" + name() + "。\n");
  if (me->query("force") < 1000)
    return notify_fail("你的内力不足 1000 点，施展不出" + name() + "。\n");
  if (me->query("kee") < 300)
    return notify_fail("你的气血不足 300 点，施展不出" + name() + "。\n");
  return 1;
}

mapping query_action(object me, object weapon) {
  mapping *action;
  mapping *action1 = ({
    ([ "action":
      "$N发出一声厉叫，手中$w以一招" HIR "「凄风长号」" NOR "狂风骤雨般地向$n的$l连连扫去" NOR,
      "damage": 150,
      "force": 50,
      "post_action": (: post_gun :),
      "damage_type": "砸伤",
    ]),
    ([ "action":
      "$N身形一转，面带戚色，一招" HIB "「怨妇伤情」" NOR "使出，\n手中$w好像沾上了$n，甩也甩不开" NOR,
      "force": 50,
      "damage": 260,
      "post_action": (: post_gun :),
      "damage_type": "砸伤",
    ]),
  });
  mapping *action2 = ({
    ([ "action":
      "$N发出一声厉叫，手中$w以一招" HIR "「凄风长号」" NOR "狂风骤雨般地向$n的$l连连扫去" NOR,
      "damage": 150,
      "force": 50,
      "post_action": (: post_gun :),
      "damage_type": "砸伤",
    ]),
    ([ "action":
      "$N身形一转，面带戚色，一招" HIB "「怨妇伤情」" NOR "使出，\n手中$w好像沾上了$n，甩也甩不开" NOR,
      "force": 50,
      "damage": 260,
      "post_action": (: post_gun :),
      "damage_type": "砸伤",
    ]),
    ([ "action":
      "$N使出" RED "「鬼影幢幢」" NOR "，双手滑溜异常对准$n的$l抓去" NOR,
      "dodge": -100,
      "parry": -100,
      "damage": 80,
      "damage_type": "瘀伤",
      "post_action": (: post_zhua :),
    ]),
    ([ "action":
      "$N右手在$n$l划过，随后一招" WHT "「厉鬼缠身」" NOR "左爪又向同一方位抓到" NOR,
      "dodge": -100,
      "parry": -100,
      "damage": 100,
      "damage_type": "抓伤",
      "post_action": (: post_zhua :),
    ]),
  });
  mapping *action3 = ({
    ([ "action":
      "$N发出一声厉叫，手中$w以一招" HIR "「凄风长号」" NOR "狂风骤雨般地向$n的$l连连扫去" NOR,
      "damage": 150,
      "force": 50,
      "post_action": (: post_gun :),
      "damage_type": "砸伤",
    ]),
    ([ "action":
      "$N身形一转，面带戚色，一招" HIB "「怨妇伤情」" NOR "使出，\n手中$w好像沾上了$n，甩也甩不开" NOR,
      "force": 50,
      "damage": 260,
      "post_action": (: post_gun :),
      "damage_type": "砸伤",
    ]),
    ([ "action":
      "$N怒发冲冠，$w作链狂舞，舞得如天罗地网，$n方悟得这招叫「" + BLINK "" + HIR "修罗无敌" + NOR "」",
      "dodge": -50,
      "parry": -50,
      "damage": 150,
      "damage_type": "鞭伤",
      "post_action": (: post_whip :),
    ]),
    ([ "action":
      "$N右手一引，一招" RED "「地狱烈火」" NOR "$w贴地而飞，再疾卷而上，
仿佛带出了地狱中的烈火，夹头夹脑地扑向$n" NOR,
      "dodge": -30,
      "damage": 300,
      "damage_type": "抽伤",
      "post_action": (: post_whip :),
    ]),
  });
  mapping *action4 = ({
    ([ "action":
      "$N发出一声厉叫，手中$w以一招" HIR "「凄风长号」" NOR "狂风骤雨般地向$n的$l连连扫去" NOR,
      "damage": 150,
      "force": 50,
      "post_action": (: post_gun :),
      "damage_type": "砸伤",
    ]),
    ([ "action":
      "$N身形一转，面带戚色，一招" HIB "「怨妇伤情」" NOR "使出，\n手中$w好像沾上了$n，甩也甩不开" NOR,
      "force": 50,
      "damage": 260,
      "post_action": (: post_gun :),
      "damage_type": "砸伤",
    ]),
    ([ "action":
      "$N使出" RED "「鬼影幢幢」" NOR "，双手滑溜异常对准$n的$l抓去" NOR,
      "dodge": -100,
      "parry": -100,
      "damage": 80,
      "damage_type": "瘀伤",
      "post_action": (: post_zhua :),
    ]),
    ([ "action":
      "$N右手在$n$l划过，随后一招" WHT "「厉鬼缠身」" NOR "左爪又向同一方位抓到" NOR,
      "dodge": -100,
      "parry": -100,
      "damage": 100,
      "damage_type": "抓伤",
      "post_action": (: post_zhua :),
    ]),
    ([ "action":
      "$N怒发冲冠，$w作链狂舞，舞得如天罗地网，$n方悟得这招叫「" + BLINK "" + HIR "修罗无敌" + NOR "」",
      "dodge": -50,
      "parry": -50,
      "damage": 150,
      "damage_type": "鞭伤",
      "post_action": (: post_whip :),
    ]),
    ([ "action":
      "$N右手一引，一招" RED "「地狱烈火」" NOR "$w贴地而飞，再疾卷而上，
仿佛带出了地狱中的烈火，夹头夹脑地扑向$n" NOR,
      "dodge": -30,
      "damage": 300,
      "damage_type": "抽伤",
      "post_action": (: post_whip :),
    ]),
  });
  if (me->query_skill("jinghun-zhang", 1) < 150) {
    if (me->query_skill("hellfire-whip", 1) < 150)
      action = action1;
    else action = action3;
  } else {
    if (me->query_skill("hellfire-whip", 1) < 150)
      action = action2;
    else action = action4;
  }
  return action[random(sizeof(action))];
}

int perform(object me, object target) {
  object weapon;
  int i, j, num, skill;

  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || !me->is_fighting(target))
    return notify_fail("你要对谁施展这一招" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "必须在战斗中使用。\n");

  weapon = me->query_temp("weapon");
  if (me->query("env/brief_message"))
    i = 1;
  else i = 0;
  if (target->query("env/brief_message"))
    j = 1;
  else j = 0;

  me->delete("env/brief_message");
  target->delete("env/brief_message");

  message_vision(HIY "\n$N" HIY "双手划一大圆，猛然托天而举，伴着天上雷鸣电闪，祭出了「人·鬼·神」三招。\n" NOR, me);
  me->set_temp("hell_bang_busy", time());

  if (me->query_skill("kusang-bang", 1) < 200
    || me->query_skill("jinghun-zhang", 1) < 200
    || me->query_skill("hellfire-whip", 1) < 200)
    num = 1;
  else if (me->query_skill("kusang-bang", 1) < 250
    || me->query_skill("jinghun-zhang", 1) < 250
    || me->query_skill("hellfire-whip", 1) < 250)
    num = 2;
  else if (me->query_skill("kusang-bang", 1) < 300
    || me->query_skill("jinghun-zhang", 1) < 300
    || me->query_skill("hellfire-whip", 1) < 300)
    num = 3;
  else if (me->query_skill("kusang-bang", 1) < 350
    || me->query_skill("jinghun-zhang", 1) < 350
    || me->query_skill("hellfire-whip", 1) < 350)
    num = 4;
  else num = 5;

  while (num--) {
    me->set("actions", query_action(me, weapon));
    me->set("HellZhen", (num + 1));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  }
  me->delete("HellZhen");
  if (i) me->set("env/brief_message", 1);
  if (j) target->set("env/brief_message", 1);
  me->add("force", -250);
  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target))
        target->fight_ob(me);
      else target->kill_ob(me);
    }
  }
  me->start_call_out((: call_other, __FILE__, "remove_effect", me :), (10 - num) * 3);
  return 1;
}

void remove_effect(object me) {
  if (!me)
    return;
  me->reset_action();
}

void post_zhua(object me, object target, object weapon, int damage) {
  int k, dayphase = NATURE_D->query_current_day_phase();

  if (!me || !target || !present(target, environment(me)))
    return;

  if ((string)me->query("family/family_name") != "阴曹地府")
    return;

  if (damage > 800 && me->query_skill("jinghun-zhang", 1) < 350)
    return;

  k = (int)me->query_skill("jinghun-zhang");
  if (k > 100)
    k = 100;
  if (dayphase < 5)
    k += 100;

  target->apply_condition("hell_zhua", (int)target->query_condition("hell_zhua") + 2 + k / 20);
  message_vision(HIG "$n" HIG "身子一晃，背上留下了一个惨绿色的爪痕！\n" NOR, me, target);
  if (!target->is_busy() && k > 50 && random(me->query_kar()) > 30)
    target->start_busy(k / 50);
}

void post_gun(object me, object target, object weapon, int damage) {
  int dayphase = NATURE_D->query_current_day_phase();
  string msg, limb, *limbs, w_msg;

  if (!me || !target || !present(target, environment(me)))
    return;

  if ((string)me->query("family/family_name") != "阴曹地府"
    || me->query_skill("kusang-bang", 1) < 180)
    return;
  if (damage > 800 && me->query_skill("kusang-bang", 1) < 350)
    return;
  if (damage <= 0)
    damage = 100;
  damage = damage / 2 + random(damage / 2);
  damage += me->query_temp("apply/damage");
  damage -= target->query_temp("apply/armor");
  if (damage <= 100)
    damage = 100;
  if (damage > 500)
    damage = 500;
  if (dayphase < 5)
    damage *= 2;

  weapon = me->query_temp("weapon");
  if (!weapon)
    w_msg = "双拳";
  else w_msg = weapon->name();

  msg = sprintf(HIB "$N" HIB "顺势将%s" HIB "一转，整个人高高跃起，连人带%s狠狠向$n" HIB "砸去!\n" NOR,
    w_msg, w_msg, w_msg);
  if (me->query("combat_exp") < random(target->query("combat_exp") / 2) && !target->is_busy()) {
    msg += sprintf(HIB "$n" HIB "见势不好,连忙用%s" HIB "架开了这一击。\n" NOR,
      objectp(target->query_temp("weapon")) ? target->query_temp("weapon")->name() : "双拳",
    );
    message_vision(msg, me, target);
    return;
  }
  msg += sprintf(HIB "$n" HIB "哪里料到还有这一击，结果给%s" HIB "狠狠的砸了一下！\n" NOR,
    w_msg);
  msg += COMBAT_D->damage_msg(damage, "砸伤");
  limbs = target->query("limbs");
  limb = limbs[random(sizeof(limbs))];
  msg = replace_string(msg, "$l", limb);
  msg = replace_string(msg, "$w", w_msg);
  message_vision(msg, me, target);
  target->receive_damage("kee", damage, me);
  COMBAT_D->report_status(target);
}

void post_whip(object me, object target, object weapon, int damage) {
  int dayphase = NATURE_D->query_current_day_phase();
  object env = environment(me);

  if (!me || !target || !present(target, env))
    return;

  if ((string)me->query("family/family_name") != "阴曹地府")
    return;

  if (damage > 800 && me->query_skill("hellfire-whip", 1) < 350)
    return;

  if (env->query("no_magic") || env->query("no_fight"))
    return;

  if (damage < 100)
    damage = 100;
  damage = random(damage / 5);
  if (dayphase < 5)
    damage += random(250);

  if (!env->query_temp("HellFire") && damage > 0) {
    message_vision(HIB "但见" + env->query("short") + HIB "一时间阴风阵阵，空气中漂浮着诡异的磷光。\n" NOR, me, target);
    env->set_temp("HellFire", 1);
    env->start_call_out(
      (: call_other, __FILE__, "hell_fire", me, target, env, damage :),
      1 + random(5)
    );
  }
}

void hell_fire(object me, object target, object env, int damage) {
  remove_call_out("hell_fire");
  if (!me || !env || !env->query_temp("HellFire") || !me->is_fighting(target))
    return;
  if (!target || !present(target, env)) {
    env->delete_temp("HellFire");
    return;
  }
  message_vision(HIB "\n「啪」地一团蓝色火焰在$N" HIB "脚下燃起，如鬼魅缠身，将$N" HIB "拢在中央。\n" NOR, target);
  target->receive_wound("sen", damage, me);
  COMBAT_D->report_sen_status(target, damage);
  env->start_call_out(
    (: call_other, __FILE__, "hell_fire", me, target, env, damage :),
    1 + random(5)
  );
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("kusang-bang") + " 等级 150 级\n";
  temp += "\t\t内   力 1000 点\n";
  temp += "\t\t气   血 300 点\n";
  temp += "\t\t战斗中使用\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                减少敌人的气血
        出招类型：
                延迟型外功
                阴曹地府弟子使用有隐藏攻击
                可以叛师带出
        出手要求：              
HELP);
  write(temp);
  return 1;
}
