#include <ansi.h>
inherit SSERVER;
string name() {
  return "「" BLU "冤魂索命" NOR "」";
}

int valid_perform(object me) {
  if (me->query("class") != "xian" && !me->samsara_check("kusang-bang"))
    return notify_fail(name() + "乃是仙界不传之密。\n");
  if (me->query_skill("kusang-bang", 1) < 120)
    return notify_fail("你的" + to_chinese("kusang-bang") + "等级不足120，无法施展" + name() + "。\n");
  if (me->query_skill("stick", 1) < 120)
    return notify_fail("你的" + to_chinese("stick") + "等级不足120，无法施展" + name() + "。\n");
  if (me->query("force") < 300)
    return notify_fail("你的内力不足 300 点，施展不出" + name() + "。\n");
  if (me->query("max_force") < 1000)
    return notify_fail("你的内力修为不足 1000 点，施展不出" + name() + "。\n");
  return 1;
}

int perform(object me, object target) {
  int damage, skill, ap, dp;
  object weapon = me->query_temp("weapon");

  if (!valid_perform(me))
    return 0;

  if (!target)
    target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(name() + "只能对战斗中的对手使用。\n");
  if (!me->is_fighting())
    return notify_fail(name() + "必须在战斗中使用。\n");

  skill = me->query_skill("stick");
  damage = skill + me->query_temp("apply/damage") + me->query("force_factor");
  damage = damage * 3 / 2 + random(damage / 2);
  damage -= random(target->query_temp("apply/armor"));

  me->add("force", -300);
  me->start_busy(2 + random(3));
  message_vision(HIB "$N" HIB "举棍向天，大喝道：风起、云卷、雷动、雨骤！。\n" NOR, me, target);

  ap = COMBAT_D->skill_power(me, "stick");
  dp = COMBAT_D->skill_power(target, "dodge");
  if (COMBAT_D->restrain(me, target)) {
    ap += ap / 5;
    damage += random(damage / 3);
  }
  if (COMBAT_D->restrain(target, me))
    dp += dp / 5;
  if (me->query("family/family_name") == "阎罗地府"
    && target->query("family/family_name") != "阎罗地府") {
    ap += ap / 5;
    damage += random(damage / 3);
  }
  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    message_vision(HBBLU "
只见漫天的棍影化做飓风在$n" HBBLU "身后合拢，一片妖云搅的天地大乱，
震天的狂雷，缠绵的靡雨，带着屈死冤魂伴着那无尽诅咒卷向$n" HBBLU "。
一片幻影忽然全部消逝，无边的棍影只化做一棍，如影随形的望$n" HBBLU "
当头砸去。。。\n" NOR, me, target);

  if (random(ap + dp) > dp) {
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(RED "\n$n" RED "心神大乱，猛招罩顶却忘了闪避，只闻“轰”的一声猛响，被$N" RED "砸了个正着。\n" NOR, me, target);
    target->receive_damage("kee", damage, me);
  } else message_vision(HIY "但是$n" HIY "一声轻笑，身形摇晃，避了开去。\n" NOR, me, target);
  if (wizardp(me)) tell_object(me, "ap===" + ap + " dp===" + dp + "\n");
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("stick") + " 等级 120 级\n";
  temp += "\t\t" + to_chinese("kusang-bang") + " 等级 120 级\n";
  temp += "\t\t内    力 300 点\n";
  temp += "\t\t内力修为 1000 点\n";
  temp += "\t\t战斗中使用\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                减少敌人的气血
        出招类型：
                busy型外功
                无隐藏攻击
                可以叛师带出
        出手要求：              
HELP);
  write(temp);
  return 1;
}
