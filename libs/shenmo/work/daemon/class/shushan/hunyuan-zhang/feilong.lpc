
// modify by windy
#include <ansi.h>
string name() 
{
return "「"WHT"飞龙探云手"NOR"」";   
}
int valid_perform(object me) 
{
if ( !me )   return 0; 
if((int)me->query_skill("hunyuan-zhang", 1) < 100)
        return notify_fail("你的混元掌等级不够, 不使用飞龙探云手！\n");
if ( me->query("class")!="human" && !me->samsara_check("hunyuan-zhang"))
        return notify_fail("你不能使用飞龙探云手！\n");
if( me->query("force") < 50 )
        return notify_fail("你的内力不够，无法飞龙探云手！\n");
return 1; 
}
int perform(object me)
{
string msg;
object weapon, weapon2, target;
int skill, dp, damage;
me->clean_up_enemy();
target = me->select_opponent(); 
if ( !valid_perform(me) ) 
        return 0;   
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n"); 

if (objectp(weapon = me->query_temp("weapon")))
        return notify_fail("你必须空手。\n");
if (!objectp(weapon2 = target->query_temp("weapon")))
        return notify_fail("对方没有兵刃，你不用担心。\n");
msg = CYN "$N凝神闭息，打算施展飞龙探云手夺取对方兵器. \n";
message_vision(msg, me);
        dp = target->query("str") * 3;
        if( dp < 1 )  dp = 1;
if( random((int)me->query_skill("hunyuan-zhang", 1)) > dp )
    {
    if(userp(me))
    me->add("force",-50);
    msg = HIW"$N使出飞龙探云手的绝招, 
$n顿时觉得眼前一花，手腕一麻，手中"HIM+weapon2->query("name")+HIW"到了$N的手中！\n" NOR;
    if (weapon2->query("no_get") || weapon2->query("no_drop") || weapon2->query("warcity")) 
    destruct(weapon2); 
    else
    weapon2->move(me);
    me->start_busy(random(3));
    }
    else
    {
    msg = "可是$n的看破了$N的企图，立刻采取守势，使$N没能夺下兵刃。\n"NOR;
    me->start_busy(random(4));
    }
    message_vision(msg, me, target);
return 1;
}
int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("hunyuan-zhang")+" 100 级\n"; 
temp+= "\t\t内力 50 点\n"; 
temp+= "\t\t必须对方手中有兵器\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                夺取对方武器
        出招类型： 
                busy型外功
                无隐藏攻击 
                叛师可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
