#include <ansi.h>
inherit SSERVER;
string name() {
  return "「" HIC "万剑俱发" NOR "」";
}
int valid_perform(object me) {
  if (!me) return 0;
  if (time() - (int)me->query_temp("xiao_end") < 3 + random(2))
    return notify_fail("绝招用多就不灵了！\n");
  if ((int)me->query("max_force") < 1000)
    return notify_fail("你的内功修为太差。\n");
  if ((int)me->query("force") < 500)
    return notify_fail("你的内力不足！\n");
  if ((int)me->query("sen") < 200)
    return notify_fail("你的精神不足，没法子施展" + name() + "！\n");
  if (me->query_skill("yujianshu", 1) < 120)
    return notify_fail("你的御剑术修为太浅，还施展不出" + name() + "！\n");
  if (((me->query("family/family_name") != "蜀山剑派"
    && me->query_skill("yujianshu", 1) < 350)
    || me->query("class") != "human") && !me->samsara_check("yujianshu"))
    return notify_fail("你还不够资格！\n");
  return 1;
}
int perform(object me, object target) {
  object weapon;
  int i, j, k, u, t, mylvl, talvl, damage;
  string msg, str;
  weapon = me->query_temp("weapon");
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用！\n");

  k = me->query_skill("yujianshu", 1);
  j = target->query_skill("dodge", 1);
  t = me->query_skill("sword", 1);
  mylvl = me->query("level");
  talvl = target->query("level");
  if (mylvl > talvl * 2) mylvl = mylvl * 2;
  if (mylvl < talvl / 2) mylvl = mylvl / 2;
  damage = 200 + random(mylvl) + random(t) + random(me->query("force_factor"));
  u = 2 + k / 100;
  if (u > 9 && me->query("family/family_name") != "蜀山剑派" && !me->query("任务")) u = 9;
  if (u > 15) u = 15;
  message_vision(HIW "\n$N仰天大喝了一声：八方神剑助我克敌！" NOR, me, target);
  message_vision(HIW "\n刹那间千万剑光破空而来，铺天盖地罩向$n！\n" NOR, me, target);
  for (i = 0; i <= u; i++) {
    if (random(k + j) > j / 2) {
      if (!me->query("env/no_msg") && !target->query("env/no_msg"))
        message_vision(HIY "$n一个不慎，中了一剑！\n" NOR, me, target);
      target->receive_damage("kee", damage, me);
      target->receive_wound("kee", damage / 2, me);
      if (me->query("env/no_status") == 0 && !userp(target))
        COMBAT_D->report_status(target);
      me->receive_damage("sen", 10);
      me->add("force", -50);
    } else {
      message_vision(HIC "$n左跳右闪，好不容易避开了一轮剑雨！\n" NOR, me, target);
      me->receive_damage("sen", 10);
      me->add("force", -20);
    }
  }
  if (target->query("eff_kee") < 0 || (!living(target) && target->query("kee") < 0)) {
    str = target->name() + HIM "被" + me->name() + "用蜀山秘传" NOR + HIC "「万剑诀」" + HIM "杀死了，据说尸体竟然插满数万灵剑！";
    //                         message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users());
  }
  me->set_temp("xiao_end", time());
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("yujianshu") + " 120 级\n";
  temp += "\t\t内力上限１０００点\n";
  temp += "\t\t内力５００点\n";
  temp += "\t\t精神２００点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP 

        使用功效： 
                连续打击对手的气血
        出招类型： 
                延时型外功
                蜀山弟子不限制 HIT 数，更能体现「万剑」二字
                叛师可带出 
        出手要求：               
HELP);
  write(temp);
  return 1;
}
