#include <ansi.h>
inherit SSERVER;
int perform(object me, object target)
{
        object weapon;
int i,j,k,u,damage;
string msg,str; 
weapon = me->query_temp("weapon");
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招"HIY"「"HIR" 剑"HIG" 气"HIW" 纵"HIC" 横 "HIY"」"NOR"？\n");

        if(me->query("family/family_name")!="蜀山剑派")
                return notify_fail("非蜀山不能用"HIY"「"HIR" 剑"HIG" 气"HIW" 纵"HIC" 横 "HIY"」！\n");
       if(!me->is_fighting())
                return notify_fail(""HIY"「"HIR" 剑"HIG" 气"HIW" 纵"HIC" 横 "HIY"」"NOR"只能在战斗中使用！\n");
        if((int)me->query("max_force") < 3000 )
                return notify_fail("你的内功太差。\n");
        if((int)me->query("force") < 2000 )
                return notify_fail("你的内力不足！\n");
if( me->query("force_factor") > 0)
return notify_fail("「"HIR" 剑"HIG" 气"HIW" 纵"HIC" 横 "NOR"」绝技重招不重力。加力出招怎能剑气纷飞？\n");
        if((int)me->query("sen") < 1300 )
                return notify_fail("你的精神不足，没法子施用外功！\n");
        if((int)me->query_skill("taoism", 1) < 200)
                return notify_fail("你的天师正道等级不够，不能使用这一招！\n");
        if((int)me->query_skill("force", 1) < 250)
                return notify_fail("你的基本内功等级不够，不能使用这一招！\n");
        k=(int)me->query_skill("sword",1);
       j=(int)target->query_skill("dodge");
                  if(k<250)        
                return notify_fail("你的剑法级别还不够，使用这一招会有困难！\n");
u=(k-150)/20;
if (u>20) u=20;
me->delete("env/brief_message");
        target->delete("env/brief_message");
message_vision(HIW"\n$N使出蜀山镇山绝学"HIY"【"HIR" 剑"HIG" 气"HIW" 纵"HIC" 横 "HIY"】"HIM"，漫天剑气扑向$n
"NOR,me,target);
for (i=0;i<=u;i++)
{
if (random(k+k+k)>j/2) {
message_vision(BLINK HIC"剑气袭来.....
"NOR,me,target);

damage=300+random(500);
target->receive_damage("kee",damage);
target->receive_wound("kee",damage);
COMBAT_D->report_status(target);
me->receive_damage("sen", 10);
me->add("force", -200);
}
else {
message_vision(BLINK HIC"\n$n说道,好厉害的剑气.差点被k死,吓死我老人家了
"NOR,me,target);
me->receive_damage("sen", 10);
me->add("force", -50);
}
}
    if (target->query("eff_kee")<0 || (!living(target) && target->query("kee")<0))  
                       {str=target->name()+HIM"被"+me->name()+"用蜀山镇山绝学"HIY"【"HIR" 剑"HIG" 气"HIW" 纵"HIC" 横 "HIY"】"HIM"杀死了，据说尸体身中无数剑气，衣衫破碎！";
               //  message("channel:rumor",HIM"【天上人间 * 天外飞仙】某人："+str+"\n"NOR,users());
	               }
    me->start_busy(3+random(2));
return 1;
}
