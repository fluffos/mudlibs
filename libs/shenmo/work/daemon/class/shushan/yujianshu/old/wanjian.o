#include <ansi.h>
inherit SSERVER;

int perform(object me, object target)
{
int i,j,k,u,damage,num,num1,num2,success,lost;
string msg,str;

if ( !target )
	target = offensive_target(me);
if ( !target
  || !target->is_character()
  || target->is_corpse()
  || target==me )
	return notify_fail("你要攻击谁？\n");
if ( !me->is_fighting() )
	return notify_fail("你们没有在打架！\n");
if ( time()-(int)me->query_temp("xiao_end") < 5 )
	return notify_fail("绝招用多就不灵了！\n");
if ( (int)me->query("max_force") < 1000 )
	return notify_fail("你的内功太差。\n");
if ( (int)me->query("force") < 500 )
	return notify_fail("你的内力不足！\n");
if ( (int)me->query("sen") < 200 )
	return notify_fail("你的精神不足，没法子施用外功！\n");

success = lost = 0;
k = (int)me->query_skill("sword",1);
j = (int)target->query_skill("dodge");
if ( k<120 )
	return notify_fail("你的剑法级别还不够，使用这一招会有困难！\n");
u=1+k/50;
if ( u>9 )
	u=9;
me->delete("env/brief_message");
target->delete("env/brief_message");

message_vision(HIW"$N"HIW"仰天大喝了一声：助我克敌者赏神剑一柄！\n"NOR,me,target);

for(i=0;i<u;i++)
	{
	if ( random(k+j)>j/3 )
		success++;
	else	lost++;
	}

num = (9-success)*10000;
num = 10000+random(num);
if ( success>0 )
	{
	if ( success<9 )
		{
		num1 = 100+random(num);
		num2 = num-num1-100;
		}
	else 	{
		num1 = 0;
		num2 = num;
		}
	}
else	{
	num1 = num;
	num2 = 0;
	}
message_vision(HIY"一刹那间"+chinese_number(num)+"道剑光破空而来，劈面罩向$n"HIY"！\n"NOR,me,target);
message_vision(HIY"一时间四下里剑光阵阵，光华四溢，破空之声连绵不绝。\n\n"NOR,me,target);
if ( lost>0 )
	{
	message_vision(HIR"$n"HIR"左跳右闪避过了"+chinese_number(num1)+"剑，"NOR,me,target);
	me->receive_damage("sen", 10*lost);
	me->add("force", -20*lost);
	}
if ( success>0 )
	{
	message_vision(HIR"$n"HIR"一个不慎，身中"+chinese_number(num2)+"剑。\n"NOR,me,target);
	damage=100+random(150);
	damage*= success;
        target->receive_damage("kee",damage*2);
	target->receive_wound("kee",damage/2);
	COMBAT_D->report_status(target);
	target->set_temp("last_damage_from",me);
	me->receive_damage("sen", 10*success);
	me->add("force", -20*success);
	}
else	message_vision("。。。\n"NOR,me,target);
me->set_temp("xiao_end",time());
return 1;
}
