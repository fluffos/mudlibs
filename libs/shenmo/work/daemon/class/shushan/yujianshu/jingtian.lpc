// yujianshu 惊天一击

#include <ansi.h>
#include <combat.h> 

inherit SSERVER;
string name()  
{
return "「"WHT"惊天一击"NOR"」";  
}
int valid_perform(object me)  
{
if ( !me )   return 0;  
if((int)me->query("max_force") < 2000 )  
        return notify_fail("你的内功修为太差。\n");  
if((int)me->query("force") < 500 )  
        return notify_fail("你的内力不足！\n");  
if((int)me->query("sen") < 100 )  
        return notify_fail("你的精神不足，无法施展"+name()+"！\n");  
if(me->query_skill("yujianshu", 1) < 180 )  
        return notify_fail("你的御剑术修为太浅，还施展不出"+name()+"！\n");  
if(me->query_skill("sword", 1) < 180 )  
        return notify_fail("你的基本剑法修为太浅，还施展不出"+name()+"！\n");  
if(me->query_skill("zixia-shengong", 1) < 180 )  
        return notify_fail("你的紫霞神功火候不够，还施展不出"+name()+"！\n");  
if ( me->query("family/family_name")!="蜀山剑派" && !me->samsara_check("yujianshu", 1))
        return notify_fail("从哪偷学来的武功！\n");  
return 1;  
}
int perform(object me, object target) 
{
	object weapon;
        int j,k,mylvl,talvl,damage;
	string msg;
if ( !valid_perform(me) ) 
        return 0;   
	if( !target ) target = offensive_target(me);
        if( !target || !target->is_character() || target==me )
                return notify_fail(name()+"只能对战斗中的对手使用。\n");
if(!me->is_fighting())  
        return notify_fail(name()+"只能在战斗中使用！\n");  

        msg = HIM "$N突然一跃而起，手腕抖出一个七彩绚丽的剑花，带起一股劲流向$n飞去！\n"NOR;
        j=(int)me->query("combat_exp");
        j=j/200000;
        k=(int)target->query("combat_exp");
        k=k/400000;
        mylvl=me->query("level");
        talvl=target->query("level")/2;
        if (random(mylvl)>talvl && j>random(k) || random(j)>k)
	{
		damage = (int)me->query_skill("force", 1);
		damage = damage +  (int)me->query_skill("yujianshu", 1);
		damage = damage +  (int)me->query_skill("sword", 1);
                damage = damage +  (int)me->query_skill("zixia-shengong", 1);
                damage = damage +  mylvl;
                target->receive_damage("kee", damage,me);
                target->receive_damage("sen", damage/2,me);
                target->receive_wound("kee", damage/4,me);
                target->receive_wound("sen", damage/4,me);
                me->add("force", -damage/4);
                msg += HIR"$n躲闪不及，被那朵剑花穿心而过，一口鲜血狂喷而出！\n"NOR;
		me->start_busy(2);
	} else 
	{
                msg += CYN"可是$p猛地向边上一跃,跳出了剑花的攻击范围。\n"NOR;
		me->add("force", -100);
		me->start_busy(2);
	}
	message_vision(msg, me, target);
	return 1;
}
int help(object me) 
{
string temp;
temp = "\t\t"+to_chinese("yujianshu")+" 180 级\n"; 
temp+= "\t\t"+to_chinese("sword")+" 180 级\n"; 
temp+= "\t\t"+to_chinese("zixia-shengong")+" 180 级\n"; 
temp+= "\t\t内力上限２０００点\n"; 
temp+= "\t\t内力５００点\n"; 
temp+= "\t\t精神１００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                给对手的气血和精神同是造成严重的伤害
        出招类型： 
                busy 型外功
                无隐藏攻击
                叛师不可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
