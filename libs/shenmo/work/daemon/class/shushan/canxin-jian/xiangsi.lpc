
// modify by windy 06/04/24
#include <ansi.h> 
#include <combat.h> 
#include <condition.h> 
inherit SSERVER; 
string name()  
{
return "「"HIM"相思三剑"NOR"」";  
}

int valid_perform(object me)
{
if ( me->query("family/family_name")!="蜀山剑派" && !me->samsara_check("canxin-jian", 1))
        return notify_fail("非蜀山弟子不能用"+name()+"！\n"); 
if((int)me->query("faith") < 500 ) 
        return notify_fail("你的门派忠诚度不够！\n"); 
if(me->query("shushan/ask_zuidao_go") !=1 ) 
        return notify_fail("没有伤心的体会，用不了缠绵的"+name()+"！\n"); 
if((int)me->query("max_force") < 500 ) 
        return notify_fail("你的内力修为不够！\n"); 
if((int)me->query("force") < 300 ) 
        return notify_fail("你的内力不足！\n"); 
if((int)me->query("sen") < 300 ) 
        return notify_fail("你的精神不足，没法子施用外功！\n"); 
if((int)me->query_skill("zixia-shengong", 1) < 100) 
        return notify_fail("你的紫霞神功修为还不够，使用这一招会有困难！\n"); 
if((int)me->query_skill("canxin-jian", 1) < 100) 
        return notify_fail("你的残心剑修为还不够，使用这一招会有困难！\n"); 
if( time()-(int)me->query_temp("xiangsi_end") < 4+random(2))  
        return notify_fail("你已经黯然神伤！\n");  
return 1;  
}
int perform(object me, object target)
{
int extra,damage; 
object weapon=me->query_temp("weapon"); 
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
message_vision(MAG"$N突然间神色黯然凄苦，绝望地凝视着$n，转瞬间竟然施展出残心剑法的绝招「相思三剑」！\n"NOR,me,target); 
extra = me->query_skill("canxin-jian",1)/10;
extra+= me->query("level")/5;
extra-= target->query("level");
if (extra < 150)  extra=150;
damage = extra*2;
me->add_temp("apply/attack", extra);
me->add_temp("apply/damage", extra);
COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
message_vision(HIG"$n被剑意中的相思之苦感染，身中情毒！\n"NOR,me,target); 
if (!me->query("env/innoxious") && target->query("spskk")!=11)
target->apply_condition("xiangsi",20); 
COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
message_vision(HIG"$n恍恍惚惚，似乎有了点醉意！\n"NOR,me,target); 
if (!me->query("env/innoxious"))
target->apply_condition("drunk",20); 
COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
message_vision(HIG"梦无痕，随风逝，仙灵如月长伴君．\n"NOR,me,target); 
if (!me->query("env/innoxious") && target->query("spskk")!=10)
target->apply_condition("xiang_air",20); 
me->add_temp("apply/attack", -extra);
me->add_temp("apply/damage", -extra);
target->receive_damage("sen", damage,me); 
target->receive_wound("sen", damage/2,me); 
me->add("kee", -50); 
me->add("force", -100); 
me->add("sen",-50); 
me->set_temp("xiangsi_end",time());
return 1; 
}
int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("canxin-jian")+" 100 级\n"; 
temp+= "\t\t"+to_chinese("zixia-shengong")+" 100 级\n"; 
temp+= "\t\t内力上限５００点\n"; 
temp+= "\t\t内力３００点\n"; 
temp+= "\t\t精神３００点\n"; 
temp+= "\t\t门忠５００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                连续打击对手的气血并使对手中毒
        出招类型： 
                延时型外功
                有隐藏攻击
                叛师不可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
