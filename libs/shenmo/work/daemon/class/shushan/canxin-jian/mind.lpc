
// write by windy 06/04/25
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string *where = ({"左肋","右肋","前胸","后胸","小腹","后背"});
string name()  
{
return "「"HIW"心剑齐发"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name")!="蜀山剑派" && (int)me->query_skill("canxin-jian", 1) < 600) 
        return notify_fail("你还不够资格使用"+name()+"！\n"); 
if ( me->query("class")!="human" && !me->samsara_check("canxin-jian"))
        return notify_fail("你还不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("canxin-jian", 1) < 350) 
        return notify_fail("你的残心剑修为不够，还用不出"+name()+"！\n"); 
if((int)me->query_skill("zixia-shengong", 1) < 350 && !me->samsara_check("canxin-jian")) 
        return notify_fail("你的紫霞神功修为不够，还用不出"+name()+"！\n"); 
if((int)me->query_skill("sword", 1) < 350) 
        return notify_fail("你的基本剑法修为不够，还用不出"+name()+"！\n"); 
if((int)me->query_skill("yujianshu", 1) < 350) 
        return notify_fail("你的御剑术修为不够，还用不出"+name()+"！\n"); 
if((int)me->query_skill("spells", 1) < 350) 
        return notify_fail("你的法术修为不够，还用不出"+name()+"！\n"); 
if( time()-(int)me->query_temp("mind_end") < 3+random(3))  
        return notify_fail("你难以频频使用"+name()+"！\n");  
if((int)me->query("max_force") < 4000 ) 
        return notify_fail("你的内力修为不够！\n"); 
if((int)me->query("force") < 1000 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
object weapon;
int skl,i,k,extra,mylvl,talvl;
string msg;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
skl=(int)me->query_skill("yujianshu", 1);
mylvl=me->query("level");
talvl=target->query("level");
extra=(int)me->query_skill("canxin-jian", 1);
extra+=(int)me->query_skill("sword", 1);
extra-=(int)target->query_skill("dodge", 1);
if (extra<100)  extra=100;
k=skl/100;
if (k>9) k=9;
weapon = me->query_temp("weapon");
message_vision(HIR"\n$N将残心剑法和御剑之术融会贯通，达到了蜀山剑法之最高境界「以心御剑,心剑齐发」！！！"NOR,me,target);
message_vision(HIW"\n只见$N闭目凝神,周身白光闪耀：手中$n"+HIW"冉冉升至空中···\n"NOR,me,weapon);
for(i=1;i<=k;i++)
    {
    me->add("force",-50);
    msg=weapon->name(1)+HIW"在长空飞舞，突然向$n的"+HIR+where[random(sizeof(where))]+HIW+"射去！\n";
    if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
    message_vision(msg,me,target);
    COMBAT_D->do_attack(me,target, me->query_temp("weapon"),1);
    if(random(mylvl)>talvl/3 && me->query("family/family_name") == "蜀山剑派")
        {
        msg="\n"+weapon->name(1)+HIG"似有了灵性一样又飞了回来，闪电般从$n体内刺入又贯出，剑尖"HIR"带出一地鲜血。\n";
    if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
        message_vision(msg,me,target);
        target->receive_damage("kee",extra,me);
        target->receive_wound("kee",extra,me);
        target->receive_damage("sen",extra,me);
        target->receive_wound("sen",extra,me);
        COMBAT_D->report_status(target,0);
        }
    }
if(random(skl)<60 && skl<600 && (string)weapon->query("id")!="qixing sword")
    {
    weapon->move(environment(me));
    message_vision("\n"HIG"$N御剑之术终究差些火候，$n"HIG"在空中飞了几圈，突然斜插在地上！\n"NOR,me,weapon); 
    }
else
    message_vision(HIG"\n$n"HIG"带着呼啸之声在空中飞了几圈，又飞回到$N手中！\n"NOR,me,weapon);
me->start_busy(2);
me->set_temp("mind_end",time());
return 1;
}
int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("canxin-jian")+" 350 级\n"; 
temp+= "\t\t"+to_chinese("yujianshu")+" 350 级\n"; 
temp+= "\t\t"+to_chinese("zixia-shengong")+" 350 级\n"; 
temp+= "\t\t"+to_chinese("sword")+" 350 级\n"; 
temp+= "\t\t"+to_chinese("spells")+" 350 级\n"; 
temp+= "\t\t内力上限４０００点\n";  
temp+= "\t\t内力１０００点\n";  
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP  

        使用功效：  
                连续打击对手的气血
        出招类型：  
                busy 并有延时型外功 
                有隐藏攻击 
                叛师可带出  
        出手要求：    
HELP);              
write(temp);  
return 1;  
}
