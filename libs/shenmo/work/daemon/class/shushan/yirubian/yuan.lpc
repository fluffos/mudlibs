#include <ansi.h>

inherit SSERVER;

string name()  
{
return "「"HIM"无怨无悔"NOR"」";  
}

int valid_perform(object me)
{
if ( me->query("family/family_name")!="蜀山剑派" && !me->samsara_check("yirubian", 1))
                return notify_fail("不是蜀山剑派的不能用"+name()+"！\n");
        if((int)me->query("max_force") < 500 )
                return notify_fail("你的内力修为不够！\n");
        if((int)me->query("force") < 500 )
                return notify_fail("你的内力不足！\n");
        if((int)me->query("sen") < 200 )
                return notify_fail("你的精神不足，没法子施用外功！\n");
        if((int)me->query_skill("yirubian", 1) < 70)
                return notify_fail("你的忆如鞭法还不精湛，使用这一招会有困难！\n");
			if( time()-(int)me->query_temp("lt_end") < 2 )
                return notify_fail("绝招用多就不灵了！\n");

return 1;  
}

int perform(object me, object target)
{
        int ap,dp,damage,chance;
        string msg;
        object weapon;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
        if(!me->is_fighting())
                return notify_fail(name()+"只能在战斗中使用！\n");

        msg = HIR"\n$N轻轻的叹了口气，手中的长鞭在天空中画了个圈，突然鞭梢直逼$n！\n"NOR;
        ap = me->query_skill("whip");
        ap = ap*ap*ap / 20;
        dp = target->query("combat_exp"); 
        chance = (int)(random( ap + dp ) / dp * 100);
        if (target->is_busy()) chance *= 3;
        if( chance > 40 ) {
                damage = me->query_skill("whip") * 2 + me->query("force_factor");
                if (damage > 800) damage = 750+random(75);
                target->receive_damage("kee",damage);
                target->receive_wound("kee",damage/3);
if (!target->is_busy())
target->start_busy(random(1)+1);
if (target->query("spskk")!=10)
target->apply_condition("snake_poison",30); 
                msg += CYN"结果$n被$N的「无怨无悔」拦腰而过！\n"NOR;
        }
        
        else 
                msg += "但是被$n躲开了。\n"NOR;
        message_vision(msg, me, target);
        if( damage > 0 ) COMBAT_D->report_status(target);
   
        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }
        me->add("force",-200-me->query("force_factor"));
        me->set_temp("lt_end",time());
        return 1;
}
int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("yirubian")+" 70 级\n"; 
temp = "\t\t精神２００点\n"; 
temp = "\t\t内力修为五年\n"; 
temp = "\t\t内力５００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                给对方强有力的一击并随机牵制对手，还会使对手身中蛇毒
        出招类型： 
                cd型外功
                有隐藏攻击 
                叛师不可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
