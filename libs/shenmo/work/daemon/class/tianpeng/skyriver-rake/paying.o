
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target)
{
	string dodskill,msg;
	int extra,i,k;
	object weapon;
	extra = me->query_skill("skyriver-rake",1);
//        if (!wizardp(me) )  return notify_fail("想要,想要你就说啊,没理由你不说我就知道你......\n");
	if ( extra < 100) return notify_fail("你的［天河钯法］还不够纯熟！\n");
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail(HIR"［猪头乱舞］"NOR"只能对战斗中的对手使用。\n");
        if((int)me->query("max_force") < 3000 )
                return notify_fail("你的内力不够！\n");
	if(me->is_busy())
		return notify_fail("你现在正忙着！！\n");

	if((int)me->query("combat_exp", 1) < 3000000)
        	return notify_fail("你的武学不够，不能使用这一招！\n");

	if((int)me->query_skill("literate", 1) < 100)
        	return notify_fail("你的读书识字不够，不能使用这一招！\n");

	if((int)me->query("force") < 1000 )
		return notify_fail("你的内力不足！\n");

        if( me->query("force_factor") > 100)
		return notify_fail("不战而屈人之兵！\n");

	weapon = me->query_temp("weapon");
	message_vision(HIC"\n$N"HIC"嘴里哼了几哼，狂舞手中的钯，使出了一式绝杀技 "BLINK HIY"猪头乱舞\n"NOR,me,target);

	i=me->query_temp("apply/attack");
	me->set_temp("apply/attack",0);
	k=me->query_temp("apply/damage");
	me->set_temp("apply/damage",0);

	message_vision(HIY"\n$N"HIY"说道:打你个上厕所不带草纸！\n"NOR,me); 
       message_vision(HIW"\n$N"HIW"说道:打你个吃饭不拉屎！\n\n"NOR,me); 
       if ( target->query("gender")=="女性")
		me->command_function("say 打你个超级大恐龙！"); 
        else me->command_function("say 打你个超时代大伟哥！");
	message_vision(HIB"\n$N"HIB"说道:叫你叫鸡不给钱！！\n"NOR,me); 
	message_vision(HIR"\n$N"HIR"说道:叫你调戏90岁老太婆！！！\n"NOR,me); 
	message_vision(HIG"\n$N"HIG"说道:叫你当汉奸！！！\n"NOR,me); 
	message_vision(MAG"\n$N"MAG"说道:打你每天三脚着地！！！！\n"NOR,me); 
	message_vision(HIM"\n$N"HIM"说道:打你个...没话说了，就是打你没商量，爽啊~~！！\n"NOR,me); 
       COMBAT_D->do_attack(me,target, me->query_temp("weapon"));
	target->command_function("exert recover"); 

//        me->command_function("surrender"); 
//        target->command_function("surrender"); 
	me->remove_killer(target);
	target->remove_killer(me);
	me->set_temp("apply/attack",i);
	me->set_temp("apply/damage",k);
       me->add("force", -100);
	me->start_busy(1+random(2));
	target->start_busy(2+random(2));
	return 1;
}
