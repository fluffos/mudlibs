#include <ansi.h>
inherit SSERVER;

string name()
{
return "「"HIY"倒打一钯"NOR"」";
}

int temp_time(object me)
{
return 1+random(3);     
}

int valid_perform(object me)
{
if ( me->query("tianhe_agree")==0 ) 
        return notify_fail("没得到净坛使者的真传，难以施展"+name()+"。\n");
if( time()-(int)me->query_temp("daoda_end") < 3+random(3) ) 
        return notify_fail("绝招用多就不灵了！\n"); 
if ( me->query_skill("skyriver-rake",1) < 600 )
        return notify_fail("你的"+to_chinese("skyriver-rake")+"等级不足"+600+"级，无法使出"+name()+"。\n");
if ( me->query("force")<500 )
        return notify_fail("你的真气不足 500 点，不能使出"+name()+"。\n");
if ( me->query("max_force")<6000 )
        return notify_fail("你的内力修为不足十年，不能使出"+name()+"。\n");
return 1;
}       
        
int perform(object me, object target)
{
object weapon;
int damage;

if ( !valid_perform(me) )
        return 0;
if ( !target ) 
        target = offensive_target(me);

if ( !target
  || !target->is_character()
  || !me->is_fighting(target) )
        return notify_fail(name()+"只能在战斗中使用。\n"NOR);
if ( !me->is_fighting() )
        return notify_fail(name()+"必须战斗中使用。\n");

weapon = me->query_temp("weapon");
damage = me->query_temp("apply/damage");
damage+= me->query_temp("apply/attack");
damage-= target->query_temp("apply/armor");
damage+= me->query_skill("skyriver-rake",1);
damage/= 5;
if ( damage<50 )  damage = 50;
damage+= me->query("force_factor")*3;
damage+= random(damage);
if ( COMBAT_D->restrain(target,me) )
        damage-= damage/5;
if ( COMBAT_D->restrain(me,target) )    
        damage+= damage/5;
message_vision(HIY"\n$N"HIY"渐渐招式散乱，体力不支，突然疾掣手中的"+weapon->query("name")+HIY"，气喘吁吁，转身便跑！\n"NOR,me,target);
message_vision(HIY"$n"HIY"不知有诈，紧紧追赶，$N"HIY"却冷不防使出了净坛使者的看家本领「倒打一钯」！\n"NOR,me,target);
me->add("force",-500);
SDS_D->super_attack(me,target,damage,"NOR");
if ( wizardp(me) )  tell_object(me,"damage="+damage+"\n");
if ( damage>500 )  target->receive_wound("kee",damage/10);
if ( random(me->query("combat_exp"))>target->query("combat_exp")/3
   && random(me->query("level"))>target->query("level")/3 )
      target->receive_wound("kee",target->query("eff_kee")/2);
target->set_temp("last_damage_from",me);
me->set_temp("daoda_end",time());
return 1;
}

int help(object me)
{
string temp;    
temp = "\t\t"+to_chinese("skyriver-rake")+" 600 级\n";
temp+= "\t\t内力修为一甲子\n";
temp+= "\t\t内力５００点\n";
temp+= "\t\t战斗状态下使用\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");
write(@HELP

        使用功效：
                重创敌人的气血
        出招类型：
                延时型外功
                有隐藏攻击
                天河钯法必须为转世武功
        出手要求：              
HELP);                          
write(temp);
return 1;
}
