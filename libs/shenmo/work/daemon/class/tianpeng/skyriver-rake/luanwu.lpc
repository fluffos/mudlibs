
// modify by windy 06/04/28
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIR"猪头乱舞"NOR"」";  
}

int valid_perform(object me)
{
if((int)me->query_skill("skyriver-rake", 1) < 50) 
        return notify_fail("你的天河钯法修为太差，难以施展"+name()+"！\n"); 
if( (int)me->query("max_force") < 500 ) 
        return notify_fail("你的内力修为不够！\n"); 
if( (int)me->query("force") < 300 ) 
        return notify_fail("你的内力不足！\n"); 
if( (int)me->query("sen") < 100 ) 
        return notify_fail("你现在精神太差！\n"); 
if( time()-(int)me->query_temp("luanwu_end") < 2+random(2) ) 
        return notify_fail("绝招用多就不灵了！\n");
return 1;  
}

int perform(object me, object target)
{
int i, extra;
object weapon;

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
extra = (int)me->query_skill("skyriver-rake", 1)/50;
if (extra>25)    extra=25;
weapon = me->query_temp("weapon");
message_vision(HIR"\n$N似乎被被惹急眼了，嘴里含糊不清地哼吃了一声：老猪我跟你拼了！
说罢，晃着脑袋舞动手中"+weapon->name()+HIR"疯狂攻向$n"HIR"！\n"NOR,me,target); 
for(i=1;i<=extra;i++)
    {
    COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR); 
    }
if (me->query("tianhe_agree")>0)
me->start_busy(extra/7);
else
me->start_busy(extra);
me->add("force", -100);
me->add("sen", -50);
me->set_temp("luanwu_end",time());
return 1; 
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("skyriver-rake")+" 50 级\n"; 
temp+= "\t\t内力修为五年\n"; 
temp+= "\t\t内力３００点\n"; 
temp+= "\t\t精神１００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                连续打击对手的气血
        出招类型： 
                busy型外功
                无隐藏攻击
                公共武功
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
