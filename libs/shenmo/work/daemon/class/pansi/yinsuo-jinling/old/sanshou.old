//modify by lost 2004.11.5
#include <ansi.h>

inherit SSERVER;
void wuying_ok(object); 
int perform(object me, object target)
{
        object weapon;
        int i;
        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招「三无三不手」？\n");

        if(!me->is_fighting())
                return notify_fail("「三无三不手」只能在战斗中使用！\n");
if(me->query("family/family_name")!="盘丝洞")
           return notify_fail("“三无三不手”只有盘丝洞门人才可以用！\n");

        if((int)me->query("max_force") < 1000 )
                return notify_fail("你的内力不够！\n");

        if((int)me->query("force") < 1000 )
                return notify_fail("你的内力不足！\n");
  if( time()-(int)me->query_temp("wuying_end") < 5 )
                return notify_fail("绝招用多就不灵了！\n");
        if((int)me->query("sen") < 500 )
                return notify_fail("你的精神不足，没法子施用外功！\n");

	i=(int)me->query_skill("yinsuo-jinling",1)+(int)me->query_kar();

        if( i < 250 )
                return notify_fail("你的银索金铃级别还不够，使用这一招会有困难！\n");

        message_vision(HIR"\n　　　　　　问世间情为何物？直叫人生死相许！$N心中一阵酸楚，鞭法忽然变得灵动异常！\n"NOR,me);

	me->delete("env/brief_message");
	target->delete("env/brief_message");
             target->add_temp("apply/dodge",-i/4);
             target->add_temp("apply/parry",-i/4);
             me->add_temp("apply/attack",i/4);
             me->add_temp("apply/damage",i/4);
        me->set_temp("QJB_perform", 7);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

             if( (int)me->query_skill("yinsuo-jinling", 1) > 150 )   {
        me->set_temp("QJB_perform", 7);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        me->set_temp("QJB_perform", 8);  
        COMBAT_D->do_attack(me, target, me->query_temp("weapon")); }

             if( (int)me->query_skill("yinsuo-jinling", 1) > 180 )   {
        me->set_temp("QJB_perform", 9);  
        COMBAT_D->do_attack(me, target, me->query_temp("weapon")); }

        me->delete_temp("QJB_perform");
        me->receive_damage("sen", 100+random(100));
target->add_temp("apply/dodge",i/4);
             target->add_temp("apply/parry",i/4);
             me->add_temp("apply/attack",-i/4);
             me->add_temp("apply/damage",-i/4);
        me->add("force", -200);
       me->set_temp("wuying_end",time());
//        call_out("wuying_ok",5+random(2),me); 
           if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }

          return 1;
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("yinsuo-jinling")+" 250 级\n"; 
temp+= "\t\t内力 1000 点\n"; 
write(@HELP 
银索金铃 之 「三无三不手」：

        使用功效： 
                连续打击对手的气血
        出招类型： 
                延时型武功
                无隐藏攻击 
                叛师不可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
