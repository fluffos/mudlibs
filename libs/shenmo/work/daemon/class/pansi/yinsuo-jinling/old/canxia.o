//perform canxia

#include <ansi.h>


inherit SSERVER;

int perform(object me, object target)
{
        string msg;
        int i, j, z;
        object weapon;
        j = me->query_skill("yinsuo-jinling", 1)*2;
        z = me->query_skill("yinsuo-jinling", 1)/2;
        weapon = me->query_temp("weapon");

        if( !target ) target = offensive_target(me);

        if( !target || !me->is_fighting(target) )
                return notify_fail("「残霞映虹」只能在战斗中对对手使用。\n");

        if (!weapon || weapon->query("skill_type") != "whip"
        || me->query_skill_mapped("whip") != "yinsuo-jinling")
                return notify_fail("你必须在使用鞭时才能使出「残霞映虹」！\n");

        if(me->query_skill("yinsuo-jinling", 1) < 220 )
                return notify_fail("你的银索金铃还不够娴熟，使不出「残霞映虹」绝技。\n");
      if(me->query("family/family_name")!="盘丝洞")
           return notify_fail("“残霞映红”只有盘丝洞门人才可以用！\n");
        
        if( (int)me->query_skill("force") < 170 )
                return notify_fail("你的内功等级不够，使不出「残霞映虹」绝技。\n");

        if( (int)me->query_kar() < 28)
                return notify_fail("你的福缘不够，使不出「残霞映虹」绝技。\n");

        if( (int)me->query_per() < 30)
                return notify_fail("你的容貌还不够条件，使不出「残霞映虹」绝技。\n");

        if( (int)me->query("max_force") < 1700 )
                return notify_fail("你现在内力太弱，使不出「残霞映虹」。\n");      

        if( (int)me->query("force") < 500 )
                return notify_fail("你现在真气太弱，使不出「残霞映虹」。\n");

        msg = HIG"\n突然$N绕着$n快速奔走，猛然抽出两鞭一掌，齐齐指向$n！\n\n"NOR;

     

         target->add_temp("apply/dodge",-j/2);
            target->add_temp("apply/parry",-j/2);
            me->add_temp("apply/attack",j/3);
            me->add_temp("apply/damage",j/3);
          msg = HIR"\n$N手中银索金铃轻轻送出，逼出道道银光，鞭影中$N化身为二，直指$n！\n\n"NOR;
         

        message_vision(msg, me, target);

        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
      
         
        message_vision(HIY"   ※※  夕  ※※                                                                    \n"NOR,me);       

        
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
       
         message_vision(HIY"    ※※  阳  ※※                                                                   \n"NOR,me);

        
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
      

          message_vision(HIY"    ※※  西  ※※                                                                   \n"NOR,me);

            
       
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
        
         message_vision(HIY"   ※※   下  ※※                                                                   \n"NOR,me);        
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);


            
         
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
        
        
          message_vision(MAG"                                                                     ※※  残  ※※\n"NOR,me);       

        
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
       
       
          message_vision(MAG"                                                                     ※※  霞  ※※\n"NOR,me);

       
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
        
          
          message_vision(MAG"                                                                     ※※  映  ※※\n"NOR,me);

       
        
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
        
       
       message_vision(MAG"                                                                     ※※   红  ※※\n"NOR,me);        
                
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
message_vision(HIW"$N"HIW"疯狂的连出这绝天灭地的"NOR RED"最后三招"NOR HIW"! \n"NOR,me);   
 COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
 COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
 COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
      
        me->add("force", -300);
            target->add_temp("apply/dodge",j/2);
            target->add_temp("apply/parry",j/2);
            me->add_temp("apply/attack",-j/3);
            me->add_temp("apply/damage",-j/3);
       
        me->start_busy(1+random(1));
               return 1;
}
