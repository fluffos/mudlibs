
//write by windy 06-05-22
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() 
{
return "「"HIY"万铃魔音"NOR"」";   
}

int valid_perform(object me) 
{
if ( !me )   return 0; 
        if(me->query("family/family_name")!="盘丝洞" && !me->samsara_check("yinsuo-jinling",1))
        return notify_fail("只有盘丝洞弟子才能使用"+name()+"！\n"); 
if(me->query_skill("yinsuo-jinling", 1) < 250 ) 
    return notify_fail("你的银索金铃修为太浅，还施展不出"+name()+"！\n"); 
if(me->query_skill("whip", 1) < 250 ) 
        return notify_fail("你的基础鞭术修为太浅，还施展不出"+name()+"！\n"); 
if(me->query_skill("force", 1) < 250 ) 
        return notify_fail("你的内功心法修为太浅，还施展不出"+name()+"！\n"); 
if((int)me->query("max_force") < 3000 ) 
        return notify_fail("你的内功修为太差。\n"); 
if((int)me->query("force") < 1000 ) 
        return notify_fail("你的内力不足！\n"); 
if((int)me->query("sen") < 500 ) 
        return notify_fail("你的精神不足，没法子施展"+name()+"！\n"); 
return 1; 
}

int perform(object me, object target)
{
object weapon;
int i,extra,lvl,mylvl,talvl,damage;
string msg; 
if ( !valid_perform(me) ) 
        return 0;   
if( !target ) target = offensive_target(me);
if( !target
||      !target->is_character()
||      target->is_corpse()
||      target==me) 
                return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n"); 

weapon = me->query_temp("weapon");
mylvl=me->query("level");
talvl=target->query("level");
mylvl+=me->query_skill("whip", 1);
mylvl+=me->query_skill("force", 1);
talvl+=target->query_skill("spells", 1);
talvl+=target->query_skill("force", 1);
lvl=me->query_skill("yinsuo-jinling", 1)/100;
if (lvl<5)  lvl=5;
if (lvl>10)  lvl=10;

message_vision(HIY "\n$N嫣然一笑，暗将内力运行了大小周天，抖动手中"+weapon->query("name")+HIY"，顿时天地间激荡着一种摄人魂魄的魔音！\n\n"NOR, me);
if (random(mylvl)>talvl/6 && random((int)me->query("combat_exp"))>(int)target->query("combat_exp")/6)
        {
        for (i=0;i<=lvl;i++)
                {
                message_vision(HIB"$n"HIB"头痛欲裂，慌乱之间身上已多了一处鞭痕！\n"NOR,me,target);
                damage=mylvl/4+random(mylvl/2)+random(me->query("force_factor"));
                target->receive_damage("kee",damage,me);
                target->receive_wound("kee",damage/2,me);
                COMBAT_D->report_status(target);
                me->add("force", -50);
                }
        message_vision(HIR"$n"HIR"嘴角溢出一丝鲜血，万铃魔音已将其五脏六腑都给震坏了！\n"NOR,me,target);
        extra=mylvl + random(mylvl) + (int)me->query("force_factor")*2;
        target->receive_damage("sen",extra,me);
        target->receive_wound("sen",extra,me);
        me->add("sen", -200);
        COMBAT_D->report_sen_status(target);
        }
else    {
        message_vision(HIW"$n"HIW"勉强抵抗住了这魔功的杀伤力，却也被万铃齐鸣的魔音搅得心神不宁！\n"NOR,me, target);
        target->start_busy(1);
        me->add("force", -300);
        me->add("sen", -100);
        }
me->start_busy(2);
return 1;
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("yinsuo-jinling")+" 250 级\n"; 
temp+= "\t\t"+to_chinese("whip")+" 250 级\n"; 
temp+= "\t\t"+to_chinese("force")+" 250 级\n"; 
temp+= "\t\t内力修为三十年\n"; 
temp+= "\t\t内力１０００点\n"; 
temp+= "\t\t精神５００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                连续打击对手的气血，
                严重伤害敌人的精神，
                或者牵制敌人
        出招类型： 
                busy 型外功
                有隐藏攻击
                叛师不可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
