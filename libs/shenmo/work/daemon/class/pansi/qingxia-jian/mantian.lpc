// mantian.c 青霞漫天
// 功力浅sword 有效等级180下时，可以震碎自己手中宝剑，以碎剑袭人
// 功力深厚sword 有效等级180上时，就可以施展剑铓（不碎剑）
// 考虑了手中剑碎后，无武器，就call_out("perform_qiao", 10, me)
// 用剑鞘杀人，连续发三招。剑鞘文件/d/pansi/obj/qiao
// daemon/class/pansi/qingxia-jian/mantian 青霞剑法
// jie 2001-2-4
 
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name()  
{
return "「"HIG"青霞漫天"NOR"」";  
}

int valid_perform(object me)
{
if((me->query("family/family_name") != "盘丝洞" 
  || me->query("class")!="yao") && !me->samsara_check("qingxia-jian",1))
        return notify_fail("你还不够资格使用"+name()+"！\n"); 
if(me->query_skill("qingxia-jian", 1) < 100) 
        return notify_fail("你的青霞剑法修为太差，难以施展"+name()+"！\n"); 
if(me->query_skill("sword", 1) < 100) 
        return notify_fail("你的基本剑术修为太差，难以施展"+name()+"！\n"); 
if(me->query_skill("jiuyin-xinjing", 1) < 100) 
        return notify_fail("你的九阴心经修为太差，难以施展"+name()+"！\n"); 
if( time()-(int)me->query_temp("mantian_end") < 3+random(3) ) 
        return notify_fail("你还是先歇歇吧！\n"); 
if((int)me->query("max_force") < 600 ) 
        return notify_fail("你的内力修为不够！\n"); 
if((int)me->query("force") < 300 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
string msg;
object weapon;
object ob;
int skill, skill2, ap, dp,kee_wound;

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

skill = me->query_skill("sword", 1);
skill2 = me->query_skill("force", 1);
weapon = me->query_temp("weapon");

msg = HIW "$N突然向后疾退两步，力惯"+weapon->query("name")+HIW"，手腕一振，竟然使出了青霞剑法密传绝技－－
"HIC"★★★★★青霞漫天★★★★★！！！
"HIW"万点剑芒云起风涌，如清风拂铃，如靡音过耳罩向$n"HIW"！\n" NOR;
                message_vision(msg, me, target);

                ap = ((me->query("level"))*(me->query_spi()));
                dp = (target->query("level"))*(target->query_spi());

                if( dp < 1 )
                        dp = 1;
                if( random(ap) > dp/3 )
                {
msg = HIR "$n"HIR"对付这招显然束手无策，万道剑芒恰如无数剑片打在了$n"HIR"的身上，\n$n"HIR"惨叫一声，脸上露出极为痛苦的表情。\n"NOR;
                        message_vision(msg, me, target);
                        kee_wound = 100 + skill + random(skill+skill2);

                        if(kee_wound > target->query("kee")) kee_wound = target->query("kee") + 1;
                        target->receive_damage("kee", kee_wound, me);
                        target->receive_wound("kee", kee_wound/4, me);
                        COMBAT_D->report_status(target, 0);
                        me->add("force",-200);
                }
                else
                {
                        msg = HIG "$n"HIG"显然老练至极，脚一点地疾飞冲天，堪堪躲过了这满天的剑芒。\n"NOR;
                        message_vision(msg, me, target);
                        me->add("force",-100);
                }
me->set_temp("mantian_end", time());
return 1;
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("qingxia-jian")+" 100 级\n"; 
temp+= "\t\t"+to_chinese("sword")+" 100 级\n"; 
temp+= "\t\t"+to_chinese("jiuyin-xinjing")+" 90 级\n"; 
temp+= "\t\t内力修为六年\n"; 
temp+= "\t\t内力３００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                伤害敌人的气血
        出招类型： 
                延时型武功
                有隐藏攻击 
                叛师不可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
