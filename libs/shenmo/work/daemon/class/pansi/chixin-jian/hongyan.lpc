
// modify by windy 06/05/21
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIM"红颜白发"NOR"」";  
}

int valid_perform(object me)
{
if (me->query("family/family_name") != "盘丝洞" && me->query_skill("chixin-jian",1) < 350) 
        return notify_fail("你还不够资格使用"+name()+"！\n"); 
if ( me->query("class")!="yao" && !me->samsara_check("chixin-jian"))
        return notify_fail("你还不够资格！\n"); 
if(me->query_skill("chixin-jian", 1) < 120) 
        return notify_fail("你的痴心情长剑修为太差，难以施展"+name()+"！\n"); 
if(me->query_skill("sword", 1) < 120) 
        return notify_fail("你的基本剑术修为太差，难以施展"+name()+"！\n"); 
if(me->query_skill("dodge", 1) < 120) 
        return notify_fail("你的基本轻功修为太差，难以施展"+name()+"！\n"); 
if( time()-(int)me->query_temp("hongyan_end") < 4+random(2) ) 
        return notify_fail("你还是先歇歇吧！\n"); 
if((int)me->query("max_force") < 1000 ) 
        return notify_fail("你的内力修为不够！\n"); 
if((int)me->query("force") < 500 ) 
        return notify_fail("你的内力不足！\n"); 
if((int)me->query("sen") < 500 ) 
        return notify_fail("你的精神难以集中！\n"); 
return 1;  
}

int perform(object me, object target)
{
string msg;
int extra,lvl;
int i;
object weapon,ob;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

weapon = me->query_temp("weapon");
extra = me->query_skill("sword",1) / 10;
extra += me->query_skill("dodge",1) / 10;
if (me->query("family/family_name")=="盘丝洞")
extra += me->query("level")/6;

lvl=me->query_skill("chixin-jian",1)/100;
if (lvl<3)  lvl=3;
if (lvl>5)  lvl=3+random(4);

msg = HIM  "$N长发飘飘，曼歌轻舞，一抖掌中的"+weapon->query("name")+HIM"，使出了「痴心情长剑」的精髓－－
"HIR"             『红颜"HIW"白发』"HIM"，无边气韵氤氲般卷向$n！\n" NOR;
message_vision(msg, me, target);
msg =  HIW ""+ weapon->name() +HIW"犹如长虹浸空，仿佛消失．．．．\n\n" NOR;
message_vision(msg, me, target);
me->add_temp("apply/attack", extra);    
me->add_temp("apply/damage", extra);
for(i=0;i<lvl;i++)
        {
        COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
        }
me->add_temp("apply/attack", -extra);
me->add_temp("apply/damage", -extra);
me->add("sen", -100);
me->set_temp("hongyan_end", time());
return 1;  
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("chixin-jian")+" 120 级\n"; 
temp+= "\t\t"+to_chinese("sword")+" 120 级\n"; 
temp+= "\t\t"+to_chinese("dodge")+" 120 级\n"; 
temp+= "\t\t内力修为十年\n"; 
temp+= "\t\t内力５００点\n"; 
temp+= "\t\t精神５００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                连续伤害敌人的气血
        出招类型： 
                延时型外功
                无隐藏攻击
                叛师可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
