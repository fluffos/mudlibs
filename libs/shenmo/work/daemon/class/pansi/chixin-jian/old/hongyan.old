#include <ansi.h>
inherit PERFORM;

void create( )
{
set("name","红颜白发");
set("target",1);
set("type","chixin-jian");
set("need_force",50);
set("force",100);
//set("family","方寸山三星洞");
set("class","yao");
set("belong","chixin-jian");
set("base_type","sword");
set("betray_lvl",350);
set("limit_skill",([
        "chixin-jian" : 100,
        "sword" : 100,
        "yueying-wubu" : 100,
        "dodge" : 100,
]));
set("busy_self",3);
}

void hit_msg(object me,object target,int num)
{
string msg;
int extra;
object weapon=me->query_temp("weapon");
if ( me && target&&num==1 ){

msg = HIM  "$N脚踏［月影舞步］，曼歌轻舞，使出［痴心情长剑法］的精髓－－
	\n"HIR"             『红颜"HIW"白发』
	\n"MAG"－－只见$N长发飘飘，裙裾袂袂，清丽哀怨不可方物！\n\n使到动情尽意处，索性抛了手中的"+ weapon->name() +MAG"，双指轮弹，无边气韵氤氲般卷向$n！\n\n" NOR;

	extra = me->query_skill("chixin-jian",1) / 10;
	extra += me->query_skill("yueying-wubu",1) / 10;
       if (extra>6) extra=6;

set("double_hit",([
        "num"           :       extra,
        "me_del_env"    :       1,
        "t_del_env"     :       1,      
]));
}
        message_vision(msg,me,target);
}

void double_hit_msg(object me,object target,int i)
{
string msg;
object weapon=me->query_temp("weapon");

	msg =  HIW ""+ weapon->name() +HIW"犹如长虹浸空，仿佛消失．．．．\n\n" NOR;
        message_vision(msg,me,target);
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("chixin-jian")+" 100 级\n"; 
temp+= "\t\t"+to_chinese("sword")+" 100 级\n"; 
temp+= "\t\t"+to_chinese("yueying-wubu")+" 100 级\n"; 
temp+= "\t\t"+to_chinese("dodge")+" 100 级\n"; 
temp+= "\t\t内力 50 点\n"; 
write(@HELP 
痴心情长剑 之 「红颜白发」：

        使用功效： 
                连续打击对手气血
        出招类型： 
                busy型武功
                无隐藏攻击 
                叛师可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
