//pansi chixin-jian之pfm
//tianchang.c

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target)
{
string str;
string msg;
int extra;
int orforce,orff;
object weapon;
if(me->is_busy())
	return notify_fail("你现在没空！！\n");
if(me->query("family/family_name")!="盘丝洞")
	return notify_fail(HIM"盘丝洞的武功岂是你所能参悟的!\n");


extra = me->query_skill("sword");
if ((int)me->query_skill("chixin-jian", 1) < 150) 
           return notify_fail("你的痴心情长剑还不够纯熟！\n");

if( !target ) target = offensive_target(me);

if( !target
||    !target->is_character()
||    !me->is_fighting(target) )
	return notify_fail("[ 天长地久 ]只能对战斗中的对手使用。\n");
                
if((int)me->query("force") < 500 )
	return notify_fail("你的内力不足！\n");

if((int)me->query("sen") < (int)(me->query("max_sen")/2) )
	return notify_fail("你的精神不足，没法子施展[ 天长地久 ]！\n");


weapon = me->query_temp("weapon");
target->add_temp("apply/dodge",-extra);
            target->add_temp("apply/parry",-extra);
            me->add_temp("apply/dodge",extra*2);
            me->add_temp("apply/parry",extra*2);
msg = HIR  "$N一跃而起，手腕一抖，挽出一个美丽的剑花，飞向$n.\n一时间沉迷在你的剑招之中,不知所措!!\n"NOR;
message_vision(msg,me,target);

msg = HIG  "$N一招「雁行斜击」，身形斜飞，手中长剑轻轻点向$n！”\n" NOR;
message_vision(msg,me,target);
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

msg = HIY  "$N长跃而起，「白虹经天」，手中长剑猛然下刺！”\n" NOR;
message_vision(msg,me,target);
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

msg = HIB  "$N稍稍平息内息，使出「浪迹天涯」，挥剑直劈，威不可当！\n" NOR;
message_vision(msg,me,target);
COMBAT_D->do_attack(me,target, me->query_temp("weapon")); 

msg = HIM  "$N使「花前月下」一招自上而下搏击，模拟冰轮横空、清光铺地的光
景！\n" NOR;
message_vision(msg,me,target);
COMBAT_D->do_attack(me,target, me->query_temp("weapon")); 

if ((int)me->query_skill("chixin-jian", 1) > 200) 
	{
		
	weapon = me->query_temp("weapon");
            target->add_temp("apply/dodge",-extra);
            target->add_temp("apply/parry",-extra);
            me->add_temp("apply/dodge",extra*2);
            me->add_temp("apply/parry",extra*2);
	msg = HIC  "$N手中长剑颤动，如鲜花招展来回挥削，只幌得$n眼花撩乱，浑不知从
何攻来!!\n"NOR;
	message_vision(msg,me,target);
	msg = HIW  "$N嫣然一笑：“雁行斜击！”\n" NOR;
	message_vision(msg,me,target);
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),msg);
	msg = HIG  "$N身形转动,再续前招!\n" NOR;
	msg+=BLINK HIY"白虹经天！\n"NOR;
	message_vision(msg,me,target);
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"));
	msg = BLINK HIB  "浪迹天涯！\n" NOR;
	message_vision(msg,me,target);
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"));
	msg = BLINK HIM  "花前月下！\n" NOR;
	message_vision(msg,me,target);
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"));
       msg = HIC  "$N突然脸色苍白, 想起周星驰对$N所作的种种事情，默然间使出天长地久最后一式！\n" NOR;
       msg+=BLINK HIW"祝天下有情人不成眷属！\n"NOR;
	message_vision(msg,me,target);
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"));
}
	me->start_busy(1+random(2));    
        me->add("force",-300); 
	target->add_temp("apply/dodge",extra);
        target->add_temp("apply/parry",extra);
	me->add_temp("apply/dodge",-extra*2);
        me->add_temp("apply/parry",-extra*2);
	   if (!userp(target)&& me->is_fighting() && target->is_fighting() )
	      	str=target->query("name")+"被"+me->query("name")+"用盘丝洞绝学:"BLINK""HIR"天长地久"NOR+HIM"杀死了！";
	//message("channel:rumor",HIM"【紫霞仙子】某人："+str+"\n"NOR,users());

         return 1;
}
 
