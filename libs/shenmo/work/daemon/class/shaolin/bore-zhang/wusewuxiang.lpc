
// modify by windy 06/05/07
#include <ansi.h>
inherit SSERVER;

string name()  
{
return "「"HIW"无色无相"NOR"」";  
}

int valid_perform(object me)
{
if ( me->query("family/family_name")!="少林寺" && me->query_skill("bore-zhang",1)<350 )
        return notify_fail("就凭你现在的武功修为，也想用"+name()+"?\n");
if ( me->query("class")!="human"  && !me->samsara_check("bore-zhang") )
        return notify_fail("你是哪儿偷学来的武功，也想用"+name()+"？\n");
if( time()-(int)me->query_temp("wswx_end") < 3+random(3) ) 
        return notify_fail("绝招用多就不灵了！\n"); 
if ( me->query_skill("bore-zhang",1) < 100 )
        return notify_fail("你的"+to_chinese("bore-zhang")+"等级不足"+100+"级，无法使出"+name()+"。\n");
if ( me->query_skill("yijinjing",1) < 100 && !me->samsara_check("bore-zhang"))
        return notify_fail("你的"+to_chinese("yijinjing")+"等级不足"+100+"级，无法使出"+name()+"。\n");
if ( me->query("force")<200 )
        return notify_fail("你的真气不足 200 点，不能使出"+name()+"。\n");
if ( me->query("max_force")<1000 )
        return notify_fail("你的内力修为不足 1000 点，不能使出"+name()+"。\n");
return 1;
}

int perform(object me, object target)
{
int i;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

        me->add("force", -25-(int)me->query("force_factor"));
        me->receive_damage("kee", 100);
        i =  (int)me->query_skill("bore-zhang", 1);
        if ( me->query_skill("yijinjing",1) < 100 )   i/= 2;
        COMBAT_D->attacking_perform(
                me, 
                        //attacker 
                target, 
                        //target
                i, 
                        //level of skill used
                400, 
                        //success adjustment
                220, 
                        //damage adjustment
                "qi", 
                        //damage type: could be "qi"/"kee", "shen"/"sen", ...default "both"
                HIC "$N双掌合十，气运丹田，猛得向外一翻，只见一道几乎实质化却又
微不可查的气旋径直飞向$n！正是般若掌的绝学“无色无相”！\n" NOR,
                        //initial message
                RED "结果$n躲闪不及，正好被气旋打中前心，当时喷出一口鲜血！\n" NOR, 
                        //success message
                CYN "$n识得这招的厉害，连忙侧身，堪堪将气旋躲了开来！\n" NOR, 
                        //fail message
                HIB "但是被$n面带嘲讽之色，单掌用力一推，竟将气旋生生逼回,反向$N打去！\n" NOR, 
                        //backfire initial message
                HIB "结果气旋打回到$n的双掌之上。\n" NOR
                        //backfire hit message. note here $N and $n!!!
        );
        me->set_temp("wswx_end", time());
        return 3+random(5);
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("bore-zhang")+" 100 级\n"; 
temp+= "\t\t"+to_chinese("yijinjing")+" 100 级\n";
temp+= "\t\t内力修为十年\n";  
temp+= "\t\t内力200点\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP  

        使用功效： 
                打击对手的气血
        出招类型： 
                延时型外功
                无隐藏攻击 
                出师可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}


