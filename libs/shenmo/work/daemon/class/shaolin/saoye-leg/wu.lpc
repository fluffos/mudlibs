#include <ansi.h>
inherit SSERVER;

string name() {
  return "「佛法风·舞」";
}

int valid_perform(object me) {
  if (!me)
    return 0;
  if (me->query("class") != "human")
    return notify_fail(name() + "乃是少林绝招。\n");
  if (me->query_skill("unarmed", 1) < 500)
    return notify_fail("你的" + to_chinese("unarmed") + "等级不足 500 级，不能施展" + name() + "。\n");
  if (me->query_skill("saoye-leg", 1) < 120)
    return notify_fail("你的" + to_chinese("saoye-leg") + "等级不足 120 级，不能施展" + name() + "。\n");
  if (me->query("max_force") < 3000)
    return notify_fail("你的内力修为不足三十年，不能施展" + name() + "。\n");
  if (me->query("force") < 1000)
    return notify_fail("你的内力不足 1000 点，不能施展" + name() + "。\n");
  return 1;
}

int set_damage(object me, object target) {
  int damage;

  if (!me || !target)
    return 0;
  damage = me->query_skill("saoye-leg", 1) * 5;
  damage = damage / 2 + random(damage / 2);
  damage += me->query("force_factor");
  damage += me->query_temp("apply/damage");
  damage -= target->query_temp("apply/armor");
  damage -= target->query_skill("parry");
  damage -= me->query("bellicosity");

  if (COMBAT_D->restrain(me, target))
    damage += random(damage / 3);
  if (COMBAT_D->restrain(target, me))
    damage -= random(damage / 3);
  if (me->query("family/family_name") == "少林寺")
    damage += damage / 3;
  if (time() < me->query_temp("shaolin_pfm_chui") + 3)
    damage *= 2;
  damage = damage / 4 + random(damage / 4);
  return damage;
}

int perform(object me, object target) {
  int damage, d, ap, dp;
  string msg, *limbs, limb, type, temp;
  mapping actions, lb;

  if (!valid_perform(me)) return 0;

  if (!me->is_fighting())
    return notify_fail(name() + "只能对战斗中的对手使用。\n");

  if (!target)
    target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || !me->is_fighting(target))
    return notify_fail("你要对谁施展这一招" + name() + "？\n");

  if (time() < target->query_temp("be_attack_by_wu") + 5)
    return notify_fail(target->name() + "已被" + name() + "打的不行了，师傅教导：慈悲为怀。\n");
  lb = ([
    "头部": 100,
    "颈部": 95,
    "胸口": 90,
    "后心": 90,
    "左肩": 80,
    "右肩": 80,
    "左臂": 80,
    "右臂": 80,
    "左手": 10,
    "右手": 10,
    "腰间": 80,
    "小腹": 85,
    "左腿": 40,
    "右腿": 40,
    "左脚": 20,
    "右脚": 20,
  ]);
  limbs = keys(lb);
  limb = limbs[random(sizeof(limbs))];

  damage = set_damage(me, target);
  if (wizardp(me))
    tell_object(me, "damage=" + damage + "\n");
  msg = HIW "$N" HIW "使出了" HIY + to_chinese("saoye-leg") + HIW "第二式：" + name() + "！\n" NOR;
  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    msg += HIW + me->query("actions")["action"] + HIW "。\n" NOR;
  msg = replace_string(msg, "$l", limb);
  msg = replace_string(
    msg,
    "$w",
    me->query_temp("weapon") ? me->query_temp("weapon")->name() : "双脚"
  );
  message_vision(msg, me, target);
  me->add("force", -250);
  target->set_temp("be_attack_by_wu", time());
  ap = COMBAT_D->skill_power(me, "unarmed", 1) / 10;
  dp = COMBAT_D->skill_power(target, "dodge", 1) / 10;
  if (COMBAT_D->restrain(me, target))
    ap += ap / 2;
  if (COMBAT_D->restrain(target, me))
    dp += dp / 2;
  if (me->query("family/family_name") == "少林寺")
    ap += random(ap / 2);

  if (random(ap + dp) > dp) {
    if (target->query("race") != "人类") {
      if (!me->query("env/no_msg") && !target->query("env/no_msg"))
        message_vision(HIR "结果只听见「砰」地一声巨响，$n" HIR "口中鲜血喷出，整个人横飞了出去！\n" NOR, me, target);
    } else {
      damage = damage * 100 / lb[limb];
      if (!me->query("env/no_msg") && !target->query("env/no_msg"))
        message_vision(HIR "$n" HIR "但觉" + limb + "一阵剧通，整个人口中鲜血喷出，横飞了出去！\n" NOR, me, target);
    }
    target->receive_damage("kee", damage, me);
    COMBAT_D->report_status(target);
    if (time() < me->query_temp("shaolin_pfm_chui") + 3)
      target->start_busy(2);
  } else {
    message_vision(HIR "$n" HIR "双脚点地，将这一招轻松闪过！\n" NOR, me, target);
    me->add("force", -300);
  }
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("unarmed") + " 500 级\n";
  temp += "\t\t" + to_chinese("saoye-leg") + " 120 级\n";
  temp += "\t\t内力修为 三十年\n";
  temp += "\t\t内    力 1000点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP 
        使用功效：  
                给对手的气血造成严重伤害
        出招类型：  
                有隐藏攻击  
                叛师可带出  
        出手要求：          
HELP);
  write(temp);
  return 1;
}
