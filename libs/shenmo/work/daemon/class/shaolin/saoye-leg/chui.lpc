#include <ansi.h>
inherit SSERVER;

string name()
{
return "「佛法风·吹」";
}       

void postfozhi(object me,object victim,object weapon, int damage);
 
int check_time(object me)
{
int time;       
if ( !me )
        return 0;
time = me->query_skill("saoye-leg",1);
time/= 50;
if ( me->query("family/family_name")=="少林寺" )
        time+= 1;
if ( time<1 ) time = 1;
if ( time>10 ) time = 5+random(5);
time = 10-time; 
return time;
}

int valid_perform(object me)
{
if ( !me )
        return 0; 
if ( me->query("class")!="human" )
        return notify_fail(name()+"乃是少林绝招。\n");
if ( me->query_skill("unarmed",1)<500 )
        return notify_fail("你的"+to_chinese("unarmed")+"等级不足 500 级，不能施展"+name()+"。\n");
if ( me->query_skill("saoye-leg",1)<60 )
        return notify_fail("你的"+to_chinese("saoye-leg")+"等级不足 60 级，不能施展"+name()+"。\n");
if ( me->query("max_force")<3000 )
        return notify_fail("你的内力修为不足三十年，不能施展"+name()+"。\n");
if ( me->query("force")<1000 )
        return notify_fail("你的内力不足 1000 点，不能施展"+name()+"。\n");   
if ( time()<me->query_temp("shaolin_pfm_chui")+2+random(4) )
        return notify_fail("绝招用多就不灵了。\n");        
return 1;               
}

int set_damage(object me,object target)
{
int damage;

if ( !me || !target )
        return 0;
damage = me->query_skill("saoye-leg",1)*5;
damage = damage/2+random(damage/2);
damage+= me->query("force_factor");
damage+= me->query_temp("apply/damage");
damage-= target->query_temp("apply/armor");
damage-= target->query_skill("parry");
damage-= me->query("bellicosity");

if ( COMBAT_D->restrain(me,target) )
        damage+= random(damage/3);
if ( COMBAT_D->restrain(target,me) )
        damage-= random(damage/3);
if ( me->query("family/family_name")=="少林寺" )
        damage+= damage/3;        
damage = damage/4+random(damage/4);     
return damage;
}

int perform(object me, object target)
{
int damage,d,ap,dp;
string msg,*limbs,limb,type,temp;
mapping actions;

if ( !valid_perform(me) )    return 0;

if ( !me->is_fighting() )
        return notify_fail(name()+"只能对战斗中的对手使用。\n");        

if ( !target ) 
        target = offensive_target(me);
if ( !target
  || !target->is_character()
  || target->is_corpse()
  || !me->is_fighting(target) )
        return notify_fail("你要对谁施展这一招"+name()+"？\n");

damage = set_damage(me,target);
if ( wizardp(me) )  tell_object(me,"damage="+damage+"\n");

msg = me->query("actions")["action"];
msg+= "。
这一招正是"+to_chinese("saoye-leg")+"的入门功夫："+name()+"！\n";
limbs = target->query("limbs");
limb = limbs[random(sizeof(limbs))];
msg = replace_string(msg,"$l",limb);
msg = replace_string(msg,"$w",me->query_temp("weapon")?me->query_temp("weapon")->name():"双脚");
msg = SDS_D->no_color_msg(msg);
msg = HIC+msg+NOR;
msg = SDS_D->color_msg(msg);
message_vision(msg,me,target);
me->set_temp("shaolin_pfm_chui",time());
me->add("force",-200);

ap = COMBAT_D->skill_power(me,"unarmed",1)/10;
dp = COMBAT_D->skill_power(target,"dodge",1)/10;
if ( COMBAT_D->restrain(me,target) )
        ap+= ap/2;
if ( COMBAT_D->restrain(target,me) )
        dp+= dp/2;
if ( me->query("family/family_name")== "少林寺" )
        ap+= random(ap/2);

if ( random(ap+dp)>dp )
        {
        if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
                message_vision(HIR"$n"HIR"但觉胸中一闷，一身真气已被这一招逼散！\n"NOR,me,target);
        if ( damage<1000 && damage/5 )
                target->receive_wound("kee",damage/5,me);       
        target->receive_damage("kee",damage,me);
        COMBAT_D->report_status(target);
        if ( userp(target) || random(me->query_str())>target->query("str") )
                target->map_skill("force",0);
        }
else    {
        message_vision(HIR"$n"HIR"大喝一声，浑身真气澎湃，将这一招硬生生地逼退！\n"NOR,me,target);
        me->add("force",-200);
        }
return 1;
}                         

int help(object me)
{
string temp;
temp = "\t\t"+to_chinese("unarmed")+" 500 级\n";  
temp+= "\t\t"+to_chinese("saoye-leg")+" 60 级\n";  
temp+= "\t\t内力修为 三十年\n";
temp+= "\t\t内    力 1000点\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");
write(@HELP 
        使用功效：  
                给对手的气血造成严重伤害，并有可能打散对手的内力激发
        出招类型：  
                延时型外功 
                有隐藏攻击  
                叛师可带出  
        出手要求：          
HELP);           
write(temp);  
return 1;  
}

