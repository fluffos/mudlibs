
// creat by windy 2011.08
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIW"慈悲为怀"NOR"」";  
}

int valid_perform(object me)
{
if ( me->query("family/family_name")!="少林寺" && me->query_skill("cibei-dao",1)<350 )
        return notify_fail("就凭你现在的武功修为，也想用"+name()+"?\n");
if ( me->query("class")!="human" && !me->samsara_check("cibei-dao"))
        return notify_fail("你还不够资格！\n"); 
if (me->query_skill("blade",1) < 300)
        return notify_fail("你的基本刀法修为不够，还用不出"+name()+"！\n"); 
if(me->query_skill("cibei-dao", 1) < 300) 
        return notify_fail("你的慈悲刀法修为不够，还用不出"+name()+"！\n"); 
if (me->query_skill("chanzong",1) < 300 && !me->samsara_check("cibei-dao"))
        return notify_fail("你的禅宗佛法修为不够，还用不出"+name()+"！\n"); 
if((int)me->query("max_force") < 2000 )
        return notify_fail("你的内力修为太浅！\n");
if((int)me->query("force") < 1000 )
        return notify_fail("你的内力不足！\n");
if((int)me->query("sen") < 300 )
        return notify_fail("你的精神不足！\n");
if( time()-(int)me->query_temp("cibei_end") < 3+random(3) ) 
        return notify_fail("绝招用多就不灵了！\n"); 
return 1;  
}

int perform(object me, object target)
{
object weapon;
int damage, ap, dp, eff_qi, max_qi, qi_bi;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

eff_qi=(int)target->query("eff_kee");
max_qi=(int)target->query("max_kee");
qi_bi=eff_qi*100/max_qi;
if (qi_bi<99)
        return notify_fail("对方已然受伤不轻，此刻用此绝招有违佛家慈悲为怀之本。\n"); 

ap = (int)me->query_skill("blade");
dp = (int)target->query_skill("dodge");
damage = max_qi/5;
if (me->query_skill_mapped("force")=="yijinjing")
damage+=random(damage);
if (me->query_skill("chanzong",1) < 300)
damage = damage/2;

message_vision(HIW"\n$N见$n仍然执迷不悟，长叹一声，突然间反转刀背，向着$n的肩头用力打去！
此招只求制敌，不求杀生，正是慈悲刀法中的一式“慈悲为怀”！\n"NOR,me,target);

if (random(ap+dp)>dp/3)
        {
        target->receive_damage("kee",damage,me);
        target->receive_wound("kee",damage,me);
        message_vision(HIR"\n结果$n躲闪不及，刀背正中肩头，虽无大碍，却是受了内伤！\n" NOR,me,target);
        COMBAT_D->report_status(target, 0);
        }
else    message_vision(HIC"\n$n暗叫不好，身形微微一侧，将此招堪堪躲了开去！\n" NOR,me,target);
        
me->receive_damage("sen", 200);
me->add("force", -500);
me->set_temp("cibei_end", time());
return 1;
}

int help(object me) 
{
string temp; 
temp = "\t\t"+to_chinese("blade")+" 300 级\n"; 
temp+= "\t\t"+to_chinese("cibei-dao")+" 300 级\n";
temp+= "\t\t"+to_chinese("chanzong")+" 300 级\n";
temp+= "\t\t内力修为二十年\n";
temp+= "\t\t内力1000点\n";
temp+= "\t\t精神300点\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP  

        使用功效：  
                强力伤害敌人的气血上限
        出招类型：  
                延时型外功 
                无隐藏攻击
                出师可带出  
        出手要求：     
HELP);    
write(temp); 
return 1; 
}


