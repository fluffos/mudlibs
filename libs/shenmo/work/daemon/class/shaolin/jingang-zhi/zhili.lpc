
// creat by windy 2011.08
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIR"金刚指力"NOR"」";  
}

int valid_perform(object me)
{
if ( me->query("family/family_name")!="少林寺" && me->query_skill("jingang-zhi",1)<350 )
        return notify_fail("就凭你现在的武功修为，也想用"+name()+"?\n");
if ( me->query("class")!="human" && !me->samsara_check("jingang-zhi"))
        return notify_fail("你还不够资格！\n"); 
if (me->query_skill("unarmed",1) < 300)
        return notify_fail("你的扑击格斗之技修为不够，还用不出"+name()+"！\n"); 
if(me->query_skill("jingang-zhi", 1) < 300) 
        return notify_fail("你的大力金刚指修为不够，还用不出"+name()+"！\n"); 
if (me->query_skill("yijinjing",1) < 300 && !me->samsara_check("jingang-zhi"))
        return notify_fail("你的易筋经神功修为不够，还用不出"+name()+"！\n"); 
if((int)me->query("max_force") < 2000 )
        return notify_fail("你的内力修为太浅！\n");
if((int)me->query("force") < 1000 )
        return notify_fail("你的内力不足！\n");
if((int)me->query("sen") < 300 )
        return notify_fail("你的精神不足！\n");
if( time()-(int)me->query_temp("zhili_end") < 3+random(5) ) 
        return notify_fail("绝招用多就不灵了！\n"); 
return 1;  
}

int perform(object me, object target)
{
object weapon;
int damage, ap, dp;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
weapon = me->query_temp("weapon"); 
if (weapon && (int)me->query_skill("jingang-zhi", 1) < 600)
        return notify_fail("你的功力不足以隔着拳套发出金刚指力。\n"); 

ap = (int)me->query_skill("unarmed");
ap+= (int)me->query("level");

dp = (int)target->query_skill("parry");
dp+= (int)target->query("level");

damage = (int)me->query_skill("jingangzhi", 1);
if (me->query_skill_mapped("force")=="yijinjing")
damage+= (int)me->query_skill("yijinjing", 1);
damage-= (int)target->query_skill("force", 1);
damage+= random(damage/2);
if (damage<200)    damage=200;

message_vision(HIR"\n$N战罢多时，突然间回身一指，只听得嗤地一声，少林金刚指力向着$n凌空而来！\n"NOR,me,target);

if (random(ap+dp)>dp/3)
        {
        target->receive_damage("kee",damage,me);
        target->receive_wound("kee",random(damage/2),me);
        message_vision(HIR"\n无形指力袭来，$n躲无可躲，一个食指大小的血洞出现在前胸，登时半个身子动弹不得！\n" NOR,me,target);
        COMBAT_D->report_status(target, 0);
        if( !target->is_busy() )    target->start_busy(3);
        }
else    message_vision(YEL"\n$n知道这招大金刚指力的厉害，不敢怠慢，身形一动，竟在电光火石间躲了开去！\n" NOR,me,target);
        
me->receive_damage("sen", 50);
me->add("force", -200);
me->set_temp("zhili_end", time());
return 1;
}

int help(object me) 
{
string temp; 
temp = "\t\t"+to_chinese("unarmed")+" 300 级\n"; 
temp+= "\t\t"+to_chinese("jingang-zhi")+" 300 级\n";
temp+= "\t\t"+to_chinese("yijinjing")+" 300 级\n";
temp+= "\t\t内力修为二十年\n";
temp+= "\t\t内力1000点\n";
temp+= "\t\t精神300点\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP  

        使用功效：  
                伤害对手的气血并牵制对手
        出招类型：  
                延时型外功 
                无隐藏攻击
                出师可带出  
        出手要求：     
HELP);    
write(temp); 
return 1; 
}

