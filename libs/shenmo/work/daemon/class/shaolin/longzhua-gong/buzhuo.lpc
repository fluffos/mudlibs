
                                                                                                               
// creat by windy 2011.08
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIY"捕风捉影"NOR"」";  
}

int valid_perform(object me)
{
if ( me->query("family/family_name")!="少林寺" && me->query_skill("longzhua-gong",1)<350 )
        return notify_fail("就凭你现在的武功修为，也想用"+name()+"?\n");
if ( me->query("class")!="human" && !me->samsara_check("longzhua-gong"))
        return notify_fail("你还不够资格！\n"); 
if (me->query_skill("unarmed",1) < 300)
        return notify_fail("你的扑击格斗之技修为不够，还用不出"+name()+"！\n"); 
if(me->query_skill("longzhua-gong", 1) < 300) 
        return notify_fail("你的少林龙爪功修为不够，还用不出"+name()+"！\n"); 
if (me->query_skill("yijinjing",1) < 300 && !me->samsara_check("longzhua-gong"))
        return notify_fail("你的易筋经神功修为不够，还用不出"+name()+"！\n"); 
if (me->query_skill("chanzong",1) < 300 && !me->samsara_check("longzhua-gong"))
        return notify_fail("你的禅宗佛法修为不够，还用不出"+name()+"！\n"); 
if((int)me->query("max_force") < 2000 )
        return notify_fail("你的内力修为太浅！\n");
if((int)me->query("force") < 1000 )
        return notify_fail("你的内力不足！\n");
if((int)me->query("mana") < 1000 )
        return notify_fail("你的法力不足！\n");
if((int)me->query("sen") < 300 )
        return notify_fail("你的精神不足！\n");
if( time()-(int)me->query_temp("buzhuo_end") < 2+random(3) ) 
        return notify_fail("绝招用多就不灵了！\n"); 
return 1;  
}

int perform(object me, object target)
{
object weapon;
int lvl, ff, mm, ap, dp;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
weapon = me->query_temp("weapon"); 
if (weapon && (int)me->query_skill("longzhua-gong", 1) < 600)
        return notify_fail("你的功力不足以隔着拳套使出捕风捉影。\n"); 

ap = (int)me->query_skill("unarmed");
ap+= (int)me->query_skill("yijinjing", 1);
ap+= (int)me->query_skill("chanzong", 1);

dp = (int)target->query_skill("force");
dp+= (int)target->query_skill("spells");

lvl= (int)me->query_skill("unarmed");
ff = (int)target->query("force")/2;
if (ff<0)    ff=0;
else if (ff<lvl)    ff=lvl;
mm = (int)target->query("mana")/2;
if (mm<0)    mm=0;
else if (mm<lvl)    mm=lvl;

message_vision(HIY"\n陡然间$N跳出圈外，袍袖鼓荡，爪风猎猎，只是向着$n遥遥做出虚抓之势！\n"NOR,me,target);

if (random(ap+dp)>dp/2)
        {
        target->add("force", -ff);
        target->add("mana", -mm);
        message_vision(HIC"\n$n正莫名其妙间，忽觉得丹田之内的真气与灵台之间的法力急剧外泄，大叫不好！\n"NOR,me,target);
        if (me->query_skill_mapped("force")=="yijinjing" && (int)me->query("force")<(int)me->query("max_force")*3)
        me->add("force", random(ff/2));
        if (me->query_skill_mapped("spells")=="chanzong" && (int)me->query("mana")<(int)me->query("max_mana")*3)
        me->add("mana", random(mm/2));
        }
else    message_vision(YEL"\n$n识得此招乃夺人真气法力，立刻定气凝神进行抵抗，$N的捕风捉影之术未能得逞！\n"NOR,me,target);
        
me->receive_damage("sen", 50);
me->add("force", -200);
me->add("mana", -200);
me->set_temp("buzhuo_end", time());
return 1;
}

int help(object me) 
{
string temp; 
temp = "\t\t"+to_chinese("unarmed")+" 300 级\n"; 
temp+= "\t\t"+to_chinese("longzhua-gong")+" 300 级\n";
temp+= "\t\t"+to_chinese("yijinjing")+" 300 级\n";
temp+= "\t\t"+to_chinese("chanzong")+" 300 级\n";
temp+= "\t\t内力修为二十年\n";
temp+= "\t\t内力1000点\n";
temp+= "\t\t法力1000点\n";
temp+= "\t\t精神300点\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP  

        使用功效：  
                散去对手的内力法力
        出招类型：  
                延时型外功 
                有隐藏效果
                出师可带出  
        出手要求：     
HELP);    
write(temp); 
return 1; 
}

