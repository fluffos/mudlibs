#include <ansi.h>
inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int exert(object me, object target)
{
int skill,num,max_num;
string msg;

if( target!= me ) 
	return notify_fail(HIY"你只能用易筋经神功保护自己。\n"NOR);

if((string)me->query("family/family_name") != "少林寺") 
	return notify_fail(HIR"你非佛门弟子！\n"NOR);  

if( (int)me->query("force") < 100 )     
	return notify_fail(HIY"你的内力不够。无法运用金刚罩！\n"NOR);

if( (int)me->query("kee") < 50 )
	return notify_fail(HIY"你的气血不足。无法运用金刚罩！\n"NOR);

if( (int)me->query("sen") < 50 )
	return notify_fail(HIY"你的精神不足。无法运用金刚罩！\n"NOR);

num = me->query_skill("yijinjing",1);
if ( num<60 )
	max_num = 1;
else if ( num<100 )
	max_num = 2;
else if ( num<150 )
	max_num = 3;
else if ( num<200 )
	max_num = 4;
else if ( num<250 )
	max_num = 5;
else if ( num<300 )
	max_num = 6;
else if ( num<350 )
	max_num = 7;
else if ( num<400 )
	max_num = 8;
else	max_num = 9;
	
if ( me->query_temp("zao_powerup")>=max_num ) 
	return notify_fail("你的金钟罩只能到达第"+chinese_number(max_num)+"层境界。\n"NOR);
	
me->add("force", -100);
me->add_temp("zao_powerup", 1);
num = me->query_temp("zao_powerup");
if ( num<=3 )
	{
	me->receive_damage("kee", 30);
	me->receive_damage("sen", 30);
	}
if ( num>=9 )
	{
	me->set_temp("zao_powerup", 9);	
	num = 9;
	}

switch(num)
	{
	case 1 : msg = HIY"
$N"HIY"微一凝神，运起易筋经神功，顿时浑身劲气四溢，正是少林的金刚罩第一重境界。\n" NOR;
		break;
	case 2 : msg = HIW"
$N"HIW"微一凝神，运起易筋经神功，顿时浑身真气四溢，正是少林的金刚罩第二重境界。\n" NOR;
		break;
	case 3 : msg = HIC"
$N"HIC"微一凝神，运起易筋经神功，顿时浑身罡气四溢，正是少林的金刚罩第三重境界。\n" NOR;
		break;
	case 4 : msg = HIM"
$N"HIM"微一凝神，运起易筋经神功，顿时浑身劲气缭绕，正是少林的金刚罩第四重境界。\n" NOR;
		break;
	case 5 : msg = HIG"
$N"HIG"微一凝神，运起易筋经神功，顿时浑身真气缭绕，正是少林的金刚罩第五重境界。\n" NOR;
		break;
	case 6 : msg = HIM"
$N"HIM"微一凝神，运起易筋经神功，顿时浑身罡气缭绕，正是少林的金刚罩第六重境界。\n" NOR;
		break;
	case 7 : msg = HIC"
$N"HIC"微一凝神，运起易筋经神功，顿时浑身流光四溢，正是少林的金刚罩第七重境界。\n" NOR;
		break;
	case 8 : msg = HIW"
$N"HIW"微一凝神，运起易筋经神功，顿时浑身流光四射，正是少林的金刚罩第八重境界。\n" NOR;
		break;
	default : msg = HIY"
$N"HIY"微一凝神，运起易筋经神功，顿时变得宝相庄严，正是少林的金刚罩第九重境界。\n" NOR;
	}

message_vision(msg,me);
		
skill = me->query_skill("force",1);
if ( me->query("human/class")!="human" )
	skill/= 50;		
else	skill/= 30;	
if ( skill>100 )
	skill = 100;		
me->add_temp("apply/armor",skill);
me->start_call_out( (: call_other, __FILE__, "remove_effect", me, skill :), skill*5+random(15));
if( me->is_fighting() && !me->is_busy() ) 
	me->start_busy(1+random(2));
return 1;
}

void remove_effect(object me, int amount)
{
int num = me->query_temp("zao_powerup");
message_vision(HIY"$N"HIY"呼了一口气，易筋经运行一周天完毕，散去第"+chinese_number(num)+"重金钟罩。\n"NOR,me);	
me->add_temp("apply/armor", - amount);
me->add_temp("zao_powerup",-1);
if ( me->query_temp("zao_powerup")<=0 )
	me->delete_temp("powerup");
return;
}

