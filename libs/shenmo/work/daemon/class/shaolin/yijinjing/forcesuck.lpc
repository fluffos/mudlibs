#include <ansi.h> 
inherit SSERVER;
        
int exert(object me, object target) 
{ 
int sp, dp,qi_gain, qi_lost,success;
string msg;	
qi_lost = (int)me->query_skill("yijinjing", 1) ;
      
if( !target
 || !target->is_character()
 || target->is_corpse()
 ||  target==me)
	return notify_fail("你要吸吸纳谁的内力？\n"); 

if((string)me->query("family/family_name") != "少林寺") 
	return notify_fail(HIR"你非佛门弟子！\n"NOR);  
  
if ( me->query_temp("sucked") ) 
	return notify_fail("你刚刚吸纳过内力！\n"); 
  
if( !me->is_fighting(target) ) 
	return notify_fail("你必须在战斗中才能吸纳对方的内力！\n"); 

if( (int)me->query_skill("yijinjing",1) <80) 
	return notify_fail("你的易筋经神功功力不够，不能吸纳对方的内力！n"); 
 
if( (int)me->query("force",1) < 500 ) 
	return notify_fail("你的内力不够，不能使用海纳百川。\n"); 
  
//if( (int)me->query("force") >= (int)me->query("max_force")*2 ) 
//        return notify_fail("你的内力充沛，无须使用海纳百川。\n"); 

if( (int)target->query("max_force") <= 0 ) 
	return notify_fail( target->name() + "没有任何内力！\n"); 

if( (int)target->query("force") < (int)target->query("max_force") / 10 ) 
	return notify_fail( target->name() + "已经内力涣散，你已经无法从他体内吸纳任何内力了！\n"); 

msg=HIW "$N"HIW"运气易筋经神功，白光一闪，大喊一声：“海纳百川”！\n\n" NOR;

if( !target->is_killing(me) ) target->kill_ob(me); 

sp = me->query_skill("force") + me->query_skill("dodge") + me->query("kar"); 
dp = target->query_skill("force") + target->query_skill("dodge") - me->query("kar"); 
success = 1;
me->set_temp("sucked", 1);               
       
if( random(sp*3) <= random(dp) ) success = 0;

if(success == 1 ){
		msg +=HIR "$n顿觉身上微痛，如同被尖针刺了个无数小孔，全身内力如水银般循孔飞泄而出！\n"NOR;
		msg +=HIG "$N觉得$n的内力源源不绝地流入$P的体内。\n" NOR;
		target->add("force", -qi_lost);
		qi_gain = qi_lost;
                if ( (int)me->query("force")>=(int)me->query("max_force")*3 )   qi_gain = 0;
 		me->add("force", qi_gain);
		if( target->query("combat_exp") >= me->query("combat_exp") ) 
			{           
			if( (int)me->query("potential") - (int)me->query("learned_points") < 100 ) 
			if ( random(2) )
				{
				me->add("potential", 1); 
				me->add("combat_exp", 1); 
				}
			} 
		me->start_busy(random(2)); 
		target->start_busy(random(2)); 
		}

if(success == 0 ){
		msg += HIY "可是$n看破了此招的企图，机灵地闪了开去。\n" NOR;	
		me->start_busy(2); 
		me->add("force", -100); 
		}	
call_out("del_sucked", 3, me); 
message_vision(msg, me, target);
return 1;
}

