//zui.c
#include <ansi.h> 

int exert(object me) 
{
if ( me->is_busy() )
    return notify_fail("你现在正忙着呢。\n");
if ( me->query("sen")<100 )
    return notify_fail("你现在神智不清。\n");
if ( me->query("force")<150 )
    return notify_fail("你内力不够了。\n");
if ( me->query_skill("force",1)<150 || me->query_skill("yijinjing",1)<150 )
    return notify_fail("你内力修为不够深厚。\n");
if ( me->query_condition("drunk")>100 ) 
    return notify_fail("你现在正醉着呢。\n");

write(HIY"\n你运起丹田一口真氣，過泥丸渡五贓，立刻覺得一股濁氣直冲頂梁！\n\n"NOR);
message("vision",HIR"\n"+me->name()+HIR"悶喝一聲，衣襟颯動，面色立時變得通紅！\n"NOR,environment(me), me);  
me->add("force",-100);
me->apply_condition("drunk",(int)me->query_condition("drunk")+100);
if ( me->is_fighting() )
   me->start_busy(1);
return 1;
}
