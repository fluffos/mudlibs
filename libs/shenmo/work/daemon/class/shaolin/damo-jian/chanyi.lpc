
                                                                                                                 // creat by windy 2011.08
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIY"禅意无尽"NOR"」";  
}

int valid_perform(object me)
{
if ( me->query("family/family_name")!="少林寺" && me->query_skill("damo-jian",1)<500 )
        return notify_fail("就凭你现在的武功修为，也想用"+name()+"?\n");
if ( me->query("class")!="human" && !me->samsara_check("damo-jian"))
        return notify_fail("你还不够资格！\n"); 
if (me->query_skill("sword",1) < 300)
        return notify_fail("你的基本剑法修为不够，还用不出"+name()+"！\n"); 
if(me->query_skill("damo-jian", 1) < 300) 
        return notify_fail("你的达摩剑法修为不够，还用不出"+name()+"！\n"); 
if (me->query_skill("yijinjing",1) < 300 && !me->samsara_check("damo-jian"))
        return notify_fail("你的易筋经神功修为不够，还用不出"+name()+"！\n"); 
if (me->query_skill("chanzong",1) < 300 && !me->samsara_check("damo-jian"))
        return notify_fail("你的禅宗佛法修为不够，还用不出"+name()+"！\n"); 
if((int)me->query("max_force") < 3000 )
        return notify_fail("你的内力修为太浅！\n");
if((int)me->query("force") < 1000 )
        return notify_fail("你的内力不足！\n");
if((int)me->query("sen") < 300 )
        return notify_fail("你的精神不足！\n");
if( time()-(int)me->query_temp("chanyi_end") < 3+random(4) ) 
        return notify_fail("绝招用多就不灵了！\n"); 
return 1;  
}

int perform(object me, object target)
{
object weapon;
int damage, ap, dp;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

weapon = me->query_temp("weapon");
ap = (int)me->query_skill("sword");
ap+= (int)me->query_skill("chanzong", 1);
dp = (int)target->query_skill("parry");
dp+= (int)me->query_skill("literate", 1);
damage = (int)me->query_skill("damo-jian", 1);
if (me->query_skill_mapped("force")=="yijinjing")
damage+= (int)me->query_skill("yijinjing", 1);
damage+= (int)me->query("mana_factor");
damage+= (int)me->query("force_factor");
damage-= (int)target->query("mana_factor");
damage = damage/2 + random(damage/2);
if (damage<300) damage=300;
if (damage>1500) damage=1500;

message_vision(HIY"\n$N轻抚掌中"+ weapon->query("name")+ HIY"道：“我达摩祖师面壁九年，顿悟无尽禅意，尽在此剑之中！
言毕，"+ weapon->query("name")+ HIY"轻轻挥出，携带一股禅意笼向$n！\n"NOR,me,target);

if (random(ap+dp)>dp*3/4)
        {
        target->receive_damage("kee",damage,me);
        target->receive_wound("kee",damage/4+random(damage/2),me);
        COMBAT_D->report_status(target, 0);
        }
else if (random(ap+dp)>dp*3/4)
        {
        message_vision(HIY"\n结果$n不为所动。$N一剑落空，第二剑随即挥出，此剑之禅意更是浓郁无比！\n"NOR,me,target);
        damage+= damage*4;
        target->receive_damage("kee",damage,me);
        target->receive_wound("kee",damage/4+random(damage/2),me);
        COMBAT_D->report_status(target, 0);
        }
else if (random(ap+dp)>dp*3/4)
        {
        message_vision(HIY"\n结果$n不为所动。$N一剑落空，第二剑随即挥出，此剑之禅意更是浓郁无比！\n"NOR,me,target);
        message_vision(HIY"\n结果$n仍不为所动。$N又一剑落空，第三剑随即挥出，此剑之禅意已经浓郁到了极限，似已充满了这天地！\n"NOR,me,target);
        damage+= damage*8;
        target->receive_damage("kee",damage,me);
        target->receive_wound("kee",damage/4+random(damage/2),me);
        COMBAT_D->report_status(target, 0);
        }
else    {
        message_vision(HIY"\n结果$n不为所动。$N一剑落空，第二剑随即挥出，此剑之禅意更是浓郁无比！\n"NOR,me,target);
        message_vision(HIY"\n结果$n仍不为所动。$N又一剑落空，第三剑随即挥出，此剑之禅意已经浓郁到了极限，似已充满了这天地！\n"NOR,me,target);
        message_vision(HIW"\n不料$n对这无尽禅意全然不理，反而仰天大笑道：“达摩剑法不过如此！\n"NOR,me,target);
        }
me->receive_damage("sen", 200);
me->add("force", -500);
me->set_temp("chanyi_end", time());
return 1;
}

int help(object me) 
{
string temp; 
temp = "\t\t"+to_chinese("sword")+" 300 级\n"; 
temp+= "\t\t"+to_chinese("damo-jian")+" 300 级\n";
temp+= "\t\t"+to_chinese("yijinjing")+" 300 级\n";
temp+= "\t\t"+to_chinese("chanzong")+" 300 级\n";
temp+= "\t\t内力修为三十年\n";
temp+= "\t\t内力1000点\n";
temp+= "\t\t精神300点\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP  

        使用功效：  
                伤害敌人的气血
        出招类型：  
                延时型外功 
                无隐藏攻击
                出师可带出  
        出手要求：     
HELP);    
write(temp); 
return 1; 
}

