#include <ansi.h>
inherit SSERVER;

string name()
{
return "「乱披风」";    
}

string force = "";

int valid_perform(object me)
{
if ( !me )
        return 0; 
if ( (me->query("family/family_name")!= "少林寺" && me->query_skill("zui-gun",1)<500))
        return notify_fail(name()+"乃是少林绝招。\n");
if ( me->query("class")!="human" && !me->samsara_check("zui-gun"))
        return notify_fail("你还不够资格！\n"); 
if ( me->query_skill("zui-gun",1)<350 )
        return notify_fail("你的"+to_chinese("zui-gun")+"等级不足 350 级，不能施展"+name()+"。\n");
if ( me->query_skill("stick",1)<350 )
        return notify_fail("你的"+to_chinese("stick")+"等级不足 350 级，不能施展"+name()+"。\n");
if ( me->query_skill("yijinjing",1)<350 )
        return notify_fail("你的"+to_chinese("yijinjing")+"等级不足 350 级，不能施展"+name()+"。\n");
if ( me->query("max_force")<1000 )
        return notify_fail("你的内力修为不足十年，不能施展"+name()+"。\n");
if ( me->query("force")<1000 )
        return notify_fail("你的内力不足 1000 点，不能施展"+name()+"。\n");   
if ( !me->is_fighting() )
        return notify_fail(name()+"只能对战斗中的对手使用。\n");        
return 1;               
}

int perform(object me, object target)
{
int num;
string msg;
if ( !valid_perform(me) )    return 0;
if ( !target ) 
        target = offensive_target(me);
if ( !target
  || !target->is_character()
  || target->is_corpse()
  || !me->is_fighting(target) )
        return notify_fail("你要对谁施展这一招"+name()+"？\n");

message_vision(HIY"\n$N"HIY"抖擞精神，一个高跳在空，舞起重重棍影砸向$n"HIY"！\n"NOR,me,target);
me->add("force",-100);
num = me->query_skill("zui-gun",1);
num/= 80;
if ( num>8 ) num = 8;
while(num--)
        {
        if ( me && target && me->is_fighting(target) )
                COMBAT_D->do_attack(me,target,me->query_temp("weapon"));
        }
me->start_busy(2);
return 1;
}                       
        
int help(object me)  
{
string temp;
temp = "\t\t"+to_chinese("zui-gun")+" 350 级\n"; 
temp+= "\t\t"+to_chinese("yijinjing")+" 350 级\n"; 
temp+= "\t\t"+to_chinese("stick")+" 350 级\n"; 
temp+= "\t\t内力修为 十年 。\n"; 
temp+= "\t\t内    力 1000 点 。\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");
write(@HELP 
        使用功效： 
                连续攻击对方
        出招类型：   
                busy型外功  
                无隐藏效果
                可叛师带出   
        出手要求： 
HELP);  
write(temp);  
return 1;  
}
