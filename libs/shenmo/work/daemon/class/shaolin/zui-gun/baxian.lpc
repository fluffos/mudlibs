
// creat by windy 2011.08
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「醉八仙」";  
}

int valid_perform(object me)
{
if ( me->query("family/family_name")!="少林寺" && me->query_skill("zui-gun",1)<350 )
        return notify_fail("就凭你现在的武功修为，也想用"+name()+"?\n");
if ( me->query("class")!="human" && !me->samsara_check("zui-gun"))
        return notify_fail("你还不够资格！\n"); 
if (me->query_skill("zui-gun",1) < 60)
        return notify_fail("你的少林醉棍修为不够，还用不出"+name()+"！\n"); 
if(me->query_skill("shaolin-shenfa", 1) < 60) 
        return notify_fail("你的少林身法修为不够，还用不出"+name()+"！\n");  
if((int)me->query("force") < 200 )
        return notify_fail("你的内力不足！\n");
if (me->query_skill_mapped("dodge")!="shaolin-shenfa")
        return notify_fail(name()+"必须配合少林身法才能发挥作用。\n");
return 1;  
}

int perform(object me, object target)
{
int ap, dp;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
if( target->is_busy() ) 
        return notify_fail("对方已经应接不暇了，还是赶紧进攻吧！\n"); 

ap = (int)me->query_skill("zui-gun", 1);
ap+= (int)me->query_skill("shaolin-shenfa", 1);

dp = (int)target->query_skill("dodge");

message_vision(HIY "只见$N"HIY"喷出一口酒气，围着$n"HIY"一摇一摆地走动着。"NOR"\n" NOR,me,target);

if (random(ap+dp)>dp/2)
        {
        message_vision(HIR "$N"HIR"脚下却是暗含八卦，步步紧逼，使得$n"HIR"不知所措！"NOR"\n" NOR,me,target);
        target->start_busy(3+random(2));
        }
else    {
        message_vision(CYN "可是$n"CYN"看破了$N"CYN"的招数，向后纵了开去。"NOR"\n" NOR,me,target);
        me->start_busy(2);
        }
        
me->add("force", -100);
return 1;
}

int help(object me) 
{
string temp; 
temp = "\t\t"+to_chinese("zui-gun")+" 60 级\n"; 
temp+= "\t\t"+to_chinese("shaolin-shenfa")+" 60 级\n";
temp+= "\t\t必须激发少林身法\n";
temp+= "\t\t内力200点\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP  

        使用功效：  
                牵制对手
        出招类型：  
                busy型外功 
                无隐藏攻击
                出师可带出  
        出手要求：     
HELP);    
write(temp); 
return 1; 
}

