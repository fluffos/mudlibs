

//modify by windy 2011.08
#include <ansi.h>
inherit SSERVER;
void remove_effect(object me); 

string name()
{
return "「醉罗汉」";    
}

string force = "";

int valid_perform(object me)
{
if ( !me )
        return 0; 
if ( (me->query("family/family_name")!= "少林寺" && me->query_skill("zui-gun",1)<400))
        return notify_fail(name()+"乃是少林绝招。\n");
if ( me->query("class")!="human" && !me->samsara_check("zui-gun"))
        return notify_fail("你还不够资格！\n"); 
if ( me->query_skill("zui-gun",1)<100 )
        return notify_fail("你的"+to_chinese("zui-gun")+"等级不足 100 级，不能施展"+name()+"。\n");
if ( me->query_skill("stick",1)<100 )
        return notify_fail("你的"+to_chinese("stick")+"等级不足 100 级，不能施展"+name()+"。\n");
if ( me->query_skill("yijinjing",1)<120 )
        return notify_fail("你的"+to_chinese("yijinjing")+"等级不足 120 级，不能施展"+name()+"。\n");
if ( me->query("max_force")<500 )
        return notify_fail("你的内力修为不足五年，不能施展"+name()+"。\n");
if ( me->query("force")<150 )
        return notify_fail("你的内力不足 150 点，不能施展"+name()+"。\n");
if (me->query_skill_mapped("force")!="yijinjing")
        return notify_fail(name()+"必须配合易筋经神功才能使用。\n");
if (me->query_temp("zui_powerup"))
        return notify_fail("你已经进入了"+name()+"状态。\n");         
return 1;               
}

int perform(object me, object target)
{
int skill;
string msg;
if ( !valid_perform(me) )    return 0;
if ( me->query_condition("drunk")<1 )
        return notify_fail("你又没醉。\n");
skill = (me->query_skill("yijinjing", 1))/5;
if (skill>120)    skill=120;

message_vision(HIY"$N"HIY"酒意渐起，打了个酒嗝，手中棍法一变，变得扑簌迷离。\n" NOR, me);
me->add("force",-100-random(50));
me->set_temp("zui_powerup",1);
me->start_call_out( (: call_other, __FILE__, "remove_effect", me :), skill); 

return 1;
}                       

void remove_effect(object me)
{
if ( !me )
        return;
if( (int)me->query_temp("zui_powerup") )
        {       
        me->delete_temp("zui_powerup");
        message_vision(HIY"$N"HIY"酒意淡去，手中长棍渐渐恢复了原样。\n"NOR,me);
        }
return;
}
        
int help(object me)  
{
string temp;
temp = "\t\t"+to_chinese("zui-gun")+" 100 级\n"; 
temp+= "\t\t"+to_chinese("yijinjing")+" 120 级\n"; 
temp+= "\t\t"+to_chinese("stick")+" 100 级\n"; 
temp+= "\t\t内力修为 五年 。\n"; 
temp+= "\t\t内    力 150 点 。\n";
temp+= "\t\t必须激发易筋经神功\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");
write(@HELP 
        使用功效： 
                强力增强少林醉棍之威力
        出招类型：   
                状态型外功，无busy  
                在非战斗情况下即可进入状态
                可叛师带出   
        出手要求： 
HELP);  
write(temp);  
return 1;  
}

