#include <ansi.h>
inherit SSERVER;

int cast(object me, object target)
{
if( !target ) target = offensive_target(me);

if( !target
  ||!target->is_character()
  || target->is_corpse()
  || target==me)
	return notify_fail("你要用狮子吼攻击谁？\n");

if ( !me->is_fighting(target) )
	return notify_fail("想偷袭？佛门弟子还是正大光明点好。\n");
if( time()-(int)me->query_temp("roar_cast") < 3+random(5) ) 
        return notify_fail(YEL"你的魔法尚未恢复！\n"NOR);
	
if((int)me->query("mana") < 25+2*(int)me->query("mana_factor") )
	return notify_fail("你的法力不够！\n");
	
if((string)me->query("class") != "human") 
	return notify_fail(HIR"你非人族弟子！\n"NOR);  
	
if((int)me->query("sen") < 20 )
	return notify_fail("你无法集中精力，别震伤了自己！\n");

me->add("mana", -25-2*(int)me->query("mana_factor"));
me->receive_damage("sen", 10);

if( random(me->query("max_mana")) < 50 ) {
	write("好象没反应，再来一次吧！\n");
	return 1;
	}

SPELL_D->attacking_cast(
		me, 
		target, 
		"sen", 		
                HIY"$N"HIY"深深地吸一口气，发出有如山崩海啸般的一声巨吼！\n\n"NOR HIR"\t\t狮\t子\t吼\n\n" NOR,
                HIY "\n$n"HIY"觉得眼前一阵金星乱冒，耳朵痛得像是要裂开一样！\n" NOR, 
                HIY "\n但是$n"HIY"好像跟聋子一样，什么也没听见。\n" NOR, 
                HIY "\n但是狮子吼被$n"HIY"以法力一引，$N"HIY"反而被自己的吼声所震！\n" NOR, 
                HIY "\n$n"HIY"觉得眼前一阵金星乱冒，耳朵痛得像是要裂开一样！\n" NOR, 
	);
if ( me->query("family/family_name")!="少林寺" ) 
	me->start_busy(1+random(2));
me->set_temp("roar_cast",time());
return 3+random(5);
}

