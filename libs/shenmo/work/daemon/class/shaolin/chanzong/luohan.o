// cast...jingang.c
#include <ansi.h>
inherit SSERVER;

int cast(object me, object target)
{
int invocation_time;
object soldier;
object soldier2;

if( !me->is_fighting() )
	return notify_fail("只有战斗中才能召唤十八罗汉！\n");

if ( me->query_skill("chanzong",1)<80 )
	return notify_fail("你的禅宗佛法还不够娴熟。\n");

if ( soldier=present("luo han",environment(me)) )
	{
  	if ( soldier->query("owner_id")==me->query("id") )
		return notify_fail("你刚叫过十八罗汉，他们都被你叫烦了！\n");
	}
	    	       
invocation_time=60+(200-(int)me->query_skill("spells"));
if(invocation_time<30) invocation_time=30;
if((time()-me->query("last_invocation"))<invocation_time)
	return notify_fail("你刚叫过十八罗汉，他们都被你叫烦了！\n");

if( (int)me->query("mana") < 500 )
	return notify_fail("你的法力不够了！无法召唤十八罗汉！\n");

if( (int)me->query("sen") < 150 )
	return notify_fail("你的精神无法集中！无法召唤十八罗汉！\n");

message_vision(HIY"$N"HIY"喃喃地念了几句禅经，", me);

me->add("mana", -300);
me->receive_damage("sen", 150);

if( random(me->query("max_mana")) < 800 ) 
	{
	message_vision("但是什么也没有发生。\n"NOR,me);
	return 1;
        }

seteuid(getuid());
soldier = new("/d/shaolin/npc/luohan");
soldier->move(environment(me));
soldier->invocation(me);
soldier->command("protect "+me->query("id"));
soldier->set_temp("invoker",me);
me->set("last_invocation",time());
//me->start_busy(1+random(2));
return 8+random(5);
}


