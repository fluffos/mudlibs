// shou.c 罗汉十八手
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform2(object, object, int, int);
int perform3(object, object, int, int);
int perform4(object, object, int, int);

string name() {
  return "「" HIG "罗汉十八手" NOR "」";
}

int valid_perform(object who) {
  if (!who)
    return 0;
  if (who->query("class") != "human"
    || (who->query("family/family_name") != "少林寺"
      && who->query_skill("luohan-quan", 1) < 350))
    return notify_fail(name() + "是少林寺不传绝学。\n");
  if (who->query_skill("luohan-quan", 1) < 60)
    return notify_fail("你的" + to_chinese("luohan-quan") + "等级不足 60 级，是施展不了" + name() + "。\n");
  if (who->query_skill("yijinjing", 1) < 60)
    return notify_fail("你的" + to_chinese("yijinjing") + "等级不足 60 级，是施展不了" + name() + "。\n");
  if (who->query_skill("unarmed", 1) < 60)
    return notify_fail("你的" + to_chinese("unarmed") + "等级不足 60 级，是施展不了" + name() + "。\n");
  if (who->query("force") < 100)
    return notify_fail("你的内力不足 100 点，施展不了" + name() + "。\n");
  if (who->query("max_force") < 600)
    return notify_fail("你的内力修为不足 六年，施展不了" + name() + "。\n");
  if (time() < who->query_temp("shaolin_pfm_shou") + 3)
    return notify_fail("绝招用多就不灵了。\n");
  return 1;
}

int check_time(object who) {
  int sk;
  if (!who || who->query("family/family_name") != "少林寺")
    return 0;
  sk = who->query_skill("luohan-quan", 1);
  sk /= 5;
  sk = sk / 2 + random(sk);
  return sk;
}

int fleeze(object who) {
  int time;
  if (!who)
    return 0;
  if (who->query("family/family_name") != "少林寺")
    return notify_fail(name() + "必须在战斗中使用。\n");
  time = check_time(who);
  if (time() < who->query_temp("shaolin_pfm_xiang") + time)
    return notify_fail("绝招用多就不灵了。\n");
  message_vision("$N仰掌为水，立掌为木，扑掌为火，握拳为土，钩手为金，将十八路罗汉拳使了个淋漓。\n", who);
  tell_object(who, "你的罗汉拳的熟练度增加了。\n");
  who->improve_skill("luohan-quan", random(100), 1);
  who->set_temp("shaolin_pfm_xiang", time());
  return 1;
}

int perform(object me, object target) {
  string msg;
  int ap, dp, time, damage;

  if (!valid_perform(me))
    return 0;

  if (!target) {
    me->clean_up_enemy();
    target = offensive_target(me);
  }
  if (!target || !me->is_fighting(target))
    return fleeze(me);

  time = check_time(me);
  me->add("force", -30);
  me->set_temp("shaolin_pfm_shou", time());
  msg = "$N嗨的一声，一拳平平朝$n打出，姿势有板有眼，颇具风范。\n";
  ap = COMBAT_D->skill_power(me, "unarmed", 1);
  dp = COMBAT_D->skill_power(target, "parry", 1);
  if (COMBAT_D->restrain(me, target))
    ap += ap / 3;
  if (COMBAT_D->restrain(target, me))
    dp += dp / 3;
  if (me->query("family/family_name") == "少林寺")
    ap += random(ap / 3);

  if (random(ap + dp) > dp / 2) {
    damage = COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    if (damage <= 0) {
      msg += "$n见招拆招，与$N战了个棋逢对手，不分输赢。\n";
      message_vision(msg, me, target);
      me->add("force", -50);
      return 1;
    }
    msg += "只见$n一个招架失误，登时被一拳打了个正着，闷哼一声，退了一步。\n";
    message_vision(msg, me, target);
    if (!target->is_busy())
      target->start_busy(1 + random(time / 3));
    return perform2(me, target, ap, dp);
  } else {
    msg += CYN "可是$p" CYN "轻轻一格，架住了$P" CYN "的来拳。\n" NOR;
    me->add("force", -100);
    me->start_busy(1 + random(3));
  }
  message_vision(msg, me, target);
  me->start_busy(1);
  return 1;
}

int perform2(object me, object target, int ap, int dp) {
  string msg, *limbs, limb;
  int damage, k;
  mapping damages = ([
    "头部": 10,
    "颈部": 8,
    "胸口": 9,
    "后心": 7,
    "左肩": 5,
    "右肩": 5,
    "左臂": 5,
    "右臂": 5,
    "左手": 1,
    "右手": 1,
    "腰间": 6,
    "小腹": 7,
    "左腿": 4,
    "右腿": 4,
    "左脚": 1,
    "右脚": 1,
  ]);

  if (!me || !target || !me->is_fighting(target))
    return 0;
  if (me->query_skill("luohan-quan", 1) < 120 || me->query("force") < 100)
    return 1;
  me->add("force", -80);
  limbs = target->query("limbs");
  limb = limbs[random(sizeof(limbs))];
  if (target->query("race") != "人类")
    limb = "胸口";
  msg = "$N紧接着，撤招压马，双掌一仰，分击$n的前胸！\n";
  if (random(ap + dp) > dp / 2) {
    msg += "$n来不及撤招招架，慌忙侧身闪避，“轰”的一声，$l已狠很挨了两掌！\n";
    if (member_array(limb, keys(damages)) == -1)
      k = 3;
    else k = damages[limb];
    damage = me->query_temp("apply/damage");
    damage += me->query("force_factor");
    damage -= target->query_temp("apply/armor");
    if (damage < 100)
      damage = 100;
    damage += random(damage);
    damage = damage / 10 * k;
    msg += COMBAT_D->damage_msg(damage, "掌伤");
    msg = replace_string(msg, "$l", limb);
    message_vision(msg, me, target);
    target->receive_damage("kee", damage, me);
    COMBAT_D->report_status(target);
  } else {
    msg += "$n来不及撤招招架，慌忙侧身闪开。\n";
    message_vision(msg, me, target);
    me->add("force", -20);
  }
  return perform3(me, target, ap, dp);
}

int perform3(object me, object target, int ap, int dp) {
  string msg;
  int damage, time;

  if (!me || !target || !me->is_fighting(target))
    return 0;
  time = check_time(me);
  if (me->query_skill("luohan-quan", 1) < 250
    || me->query("force") < 100
    || time() >= me->query_temp("shaolin_pfm_xiang") + time)
    return 1;
  msg = "$n胸口一闷，脚下不稳，连连后退了几步。\n";
  msg += "$N顺势脚踏中宫，双掌一立，直劈$n！\n";
  msg += "$n但觉胸口一闷，内气一阵翻腾，一口鲜血脱口而出！\n";
  msg += "结果只听见「轰」地一声巨响，$n像一捆稻草般飞了出去！\n";
  message_vision(msg, me, target);
  damage = me->query_temp("apply/damage");
  damage += me->query("force_factor");
  damage += me->query_skill("unarmed");
  damage -= target->query_temp("apply/armor");
  if (damage < target->query("kee") / 2)
    damage = target->query("kee") / 2;
  target->receive_damage("kee", damage, me);
  COMBAT_D->report_status(target);
  me->add("force", -100);
  return perform4(me, target, ap, dp);
}

int perform4(object me, object target, int ap, int dp) {
  string msg;
  int damage, time;

  if (!me || !target || !me->is_fighting(target))
    return 0;
  time = check_time(me);
  if (me->query_skill("luohan-quan", 1) < 250
    || me->query("force") < 500
    || time() >= me->query_temp("shaolin_pfm_xiang") + time)
    return 1;
  me->add("force", -50);
  msg = "$N将十八路罗汉拳使了个淋漓尽致，继续跟击！\n";
  if (random(ap + dp) > dp) {
    msg += "$N以神运劲，刚柔俱化，劲透体外，一记重拳呼呼有声的攻向$n！\n";
    damage = me->query_skill("force");
    damage += me->query_skill("unarmed");
    damage += me->query("force_factor");
    damage += me->query_temp("apply/damage");
    damage -= target->query_temp("apply/armor");
    if (damage < 500)
      damage = 500;
    damage += random(damage);
    msg += COMBAT_D->damage_msg(damage, "内伤");
    message_vision(msg, me, target);
    target->receive_wound("kee", damage, me);
    COMBAT_D->report_status(target, damage);
  } else if (ap > random(dp)) {
    msg += "$N以气运劲，腰马一坠，化掌变拳，呼呼有声的捶向$n！\n";
    msg += "$n被逼无奈，只得团身谨守，给攻得还击不得！\n";
    message_vision(msg, me, target);
    me->add("force", -50);
    if (!target->is_busy())
      target->start_busy(3);
  } else {
    msg += "$n暗自调息真气，将$N的这轮攻击招招化解开来！\n";
    message_vision(msg, me, target);
    me->add("force", -100);
    if (!me->is_busy())
      me->start_busy(1);
  }
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("luohan-quan") + " 60 级\n";
  temp += "\t\t" + to_chinese("yijinjing") + " 60 级\n";
  temp += "\t\t" + to_chinese("unarmed") + " 60 级\n";
  temp += "\t\t内力修为 六年 。\n";
  temp += "\t\t内    力 100 点 。\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP
使用功效:
        对敌人作出一系列的连击
出招类型：    
        busy型外功   
        有隐藏效果 
        叛师可带出    
出手要求：  
HELP);
  write(temp);
  return 1;
}
