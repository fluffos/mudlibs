//xuehai.c 血海万里
#include <ansi.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int damage, ap, dp;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展「血海万里」？\n");
  if (me->query("family/family_name") != "黄花观五毒门")
    return notify_fail("不是五毒门的弟子不能使用？\n");
  if (environment(me) != environment(target))
    return notify_fail("你现在没有了攻击目标!\n");
  if ((string)me->query_skill_mapped("force") != "wudu-xinfa")
    return notify_fail("欲施五毒绝学，需修罗阴煞功为根基啊。\n");
  if ((int)me->query("force") < 65 + (int)me->query("force_factor"))
    return notify_fail("你的内力不足！\n");
  if (me->query("max_force") < 1000 || me->query("force") < 500)
    return notify_fail("内力不足，根本无法发挥绝学的威力。\n");
  if ((int)me->query("kee") < 200)
    return notify_fail("你身体太虚弱了，无法施展「血海万里」！\n");
  if ((int)me->query_skill("wudu-tuifa", 1) < 200)
    return notify_fail("你的五毒腿法练得不够纯熟，无法使出这招「血海万里」！\n");
  if ((int)me->query_skill("wudu-xinfa", 1) < 200)
    return notify_fail("你对修罗阴煞功领悟尚浅，不能使出「血海万里」！\n");
  me->add("force", -50 - (int)me->query("force_factor"));
  msg = HIW
    "$N凝神一吼，双脚由下而上翻将上来，如天幕倒垂般卷向将过去！ 



                ┏━┓ ┏━┓ ┏━┓ ┏━┓ 
                ┃血┃ ┃海┃ ┃万┃ ┃里┃             
                ┗━┛ ┗━┛ ┗━┛ ┗━┛ 






                      血.海.万.里\n" NOR;

  ap = me->query_skill("wudu-tuifa", 1);
  ap = (ap * ap * ap / (4 * 400));
  ap = ap * 250 + (int)me->query("combat_exp");
  dp = target->query_skill("parry");
  dp = (dp * dp * dp / (7 * 400));
  dp = dp * 250 + target->query("combat_exp");
  if (random((ap + dp) / 1000) < dp / 1200) {
    msg += HIY "$n慌忙中左躲右闪，逃过了铺天盖地的一击！\n\n" NOR;
    message_vision(msg, me, target);
  } else {
    damage = (int)me->query_skill(
      "mohuang-blade",
      1
    ) / 10 + (int)me->query("sen") / 200 + random((int)me->query("sen") / 150) + (int)me->query("kee") / 250 + random((int)me->query("kee") / 150);
    msg += HIR "\n$n顿时被包围在一片无际的天幕中！\n\n" NOR;
    damage += random(10);
    target->receive_damage("sen", me->query("eff_sen") * damage / 100, me);
    target->receive_damage("kee", me->query("eff_kee") * damage / 100, me);
    target->receive_wound("kee", me->query("eff_kee") * damage / 300, me);
    me->improve_skill("wudu-tuifa", 1, 1);
    message_vision(msg, me, target);
    COMBAT_D->report_status(target);
  }
  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }
  me->start_busy(1 + random(3));
  return 1;
}
