#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string dodskill, msg;
  int extra;
  int tmp;
  string str;

  object weapon;
  extra = me->query_skill("wudu-tuifa", 1);
  if (extra < 180) return notify_fail("你的「五毒神腿」还不够纯熟！\n");
  if (me->query("family/family_name") != "黄花观五毒门")
    return notify_fail("“云龙九现”只有黄花观五毒门弟子才可以使用！\n");
  if ((int)me->query("max_force") < 1500)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query("force") < 1000)
    return notify_fail("你的内力不足。\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「云龙九现」只能对战斗中的对手使用。\n");
  me->add_temp("apply/attack", extra);
  me->add_temp("apply/damage", extra);
  weapon = me->query_temp("weapon");
  message_vision(WHT "\n\n$N挥出五毒腿法中的一式－－－云－龙－九－现－！！\n\n" NOR, me, target);
  message_vision(YEL "\n囚牛劲！" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  message_vision(HIC "\n睚眦闪！" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  message_vision(HIW "\n嘲风腿！" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

  if ((int)me->query_skill("wudu-tuifa", 1) > 250) {
    message_vision(HIG "\n蒲牢吼！" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    message_vision(HIM "\n狻猊扑！" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    message_vision(HIR "\n霸下盘！" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  }

  if ((int)me->query_skill("wudu-tuifa", 1) > 500) {
    message_vision(HIB "\n狴犴伏！" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    message_vision(MAG "\n负屃动！" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    message_vision(RED "\n螭吻吞！" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  }
  if (target->query("eff_kee") < 0 || !living(target)) {
    str = target->name() + "被" + "" HIW "" + me->name() + "" HIM "" + "用五毒神腿『" HIW "云龙九现" HIM "』杀死了。";
    message("channel:rumor", HIM "【" HIW "空穴来风" HIM "】某人：" + str + "\n" NOR, users()); ;
  }

  me->add("force", -500);
  me->receive_damage("sen", 100);
  me->start_busy(1 + random(1));
  me->add_temp("apply/attack", -extra);
  me->add_temp("apply/damage", -extra);
  return 1;
}
