#include <ansi.h>
#include <combat.h>
inherit SSERVER;
string name() {
  return "「" HIY "金钩夺魄" NOR "」";
}

int valid_perform(object me) {
  if ((me->query("family/family_name") != "黄花观五毒门") && (me->query_skill("jinwu-goufa", 1) < 350))
    return notify_fail("你还没有资格。\n");
  if (me->query("class") != "yao" && !me->samsara_check("jinwu-goufa"))
    return notify_fail("你还没有资格。\n");
  if ((int)me->query_skill("jinwu-goufa", 1) < 160)
    return notify_fail("你的金蜈钩法还不够娴熟，无法施展" + name() + "。\n");
  if ((int)me->query("force", 1) < 300)
    return notify_fail("你现在真气不够，无法施展" + name() + "。\n");
  return 1;
}

int perform(object me, object target) {
  object weapon, weapon2;
  int damage;
  string msg;
  string pmsg;
  string *limbs;
  string limb;
  int ap, dp;
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用！\n");

  weapon = me->query_temp("weapon");
  msg = HIY "突然$N" HIY "一声冷哼，手中" + weapon->name() + NOR + HIY "挥出，在空中划出个美丽的弧线，直攻$n" HIY
    "的要穴！\n" NOR;
  me->add("force", -200);
  ap = me->query_skill("jinwu-goufa", 1) + me->query_skill("sword", 1) / 2;
  dp = target->query_skill("parry", 1);
  me->want_kill(target);
  if (ap + random(ap) > dp) {
    me->start_busy(1 + random(2));
    me->add("force", -700);
    damage = 0;
    if ((me->query("max_force") > target->query("max_force") * 2) && me->query("family/family_name") == "黄花观五毒门" && !target->query("任务") && !target->query("莲花")) {
      msg += HIR "只见$N" HIR "这一击来势好快，寒光一"
        "闪，正钩中$n" HIR "的咽喉，$n" HIR "一声"
        "惨叫，软绵绵的瘫了下去。\n" NOR "( $n" RED "受伤过重，已经有如风中残烛，随时都可能断"
        "气。" NOR ")\n";
      damage = -1;
    } else if (objectp(weapon2 = target->query_temp("weapon"))) {
      msg += HIR "只听“嗤啦”一声，$n" HIR "手腕被"
        "钩个正中，手中" + weapon2->name() + NOR
        +HIR "再也捉拿不住，脱手而飞！\n" NOR; me->start_busy(2 + random(1));
      weapon2->move(environment(target));
    } else {
      damage = ap + (int)me->query_skill("force");
      damage = damage / 2 + random(damage / 2);
      if (damage > target->query("kee"))
        damage = target->query("kee") + 1;
      if (arrayp(limbs = target->query("limbs")))
        limb = limbs[random(sizeof(limbs))];
      else
        limb = "要害";
      msg += HIR "$n" HIR "飞身躲闪，然而只听“嗤啦”"
        "一声，$N" HIR "的" + weapon->name() + NOR
        +HIR "正钩在$n" HIR + limb + "上，顿时鲜"
        "血狂溅而出。\n" NOR;
      target->receive_damage("kee", damage, me);
      target->receive_wound("kee", damage, me);
      if (me->query_skill_mapped("force") == "wudu-xinfa" && !me->query("env/innoxious") && target->query("spskk") != 9)
        target->apply_condition("wudu", 20);
      me->start_busy(0);
    }
  } else {
    me->start_busy(3);
    msg += CYN "可是$p" CYN "看破了$P"
      CYN "的企图，避开了这一招。\n" NOR;
  }
  message_vision(msg, me, target);
  if (damage < 0) target->die(me);
  return 1;
}
int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("jinwu-goufa") + " 260 级\n";
  temp += "\t\t内力 300 点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP  

        使用功效：  
                打掉敌人的武器或伤害敌人的气血甚至造成必杀
        出招类型：  
                busy型外功 
                当用五毒心法催发时可使敌人中毒
                叛师可带出  
        出手要求：     
HELP);
  write(temp);
  return 1;
}
