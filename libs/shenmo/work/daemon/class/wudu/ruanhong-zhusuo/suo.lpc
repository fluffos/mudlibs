
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIR"锁龙诀"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name")!="黄花观五毒门" && !me->samsara_check("ruanhong-zhusuo", 1)) 
        return notify_fail("只有五毒门弟子才能使用"+name()+"！\n"); 
if((int)me->query_skill("ruanhong-zhusuo", 1) < 100) 
        return notify_fail("你的软红蛛索修为不够，还用不出"+name()+"！\n"); 
if((int)me->query_skill("whip", 1) < 100) 
        return notify_fail("你的基础鞭术修为不够，还用不出"+name()+"！\n"); 
if((int)me->query_skill("dodge", 1) < 100) 
        return notify_fail("你的基本轻功修为不够，还用不出"+name()+"！\n"); 
if((int)me->query("max_force") < 2000 ) 
        return notify_fail("你的内力修为不够！\n"); 
if((int)me->query("force") < 1000 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
int skill,extra; 
string msg;
object weapon=me->query_temp("weapon");
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

skill=me->query_skill("ruanhong-zhusuo",1);
extra=me->query_skill("whip",1)/3;
extra+=me->query("level")/2;

msg =HIW"$N使出软红蛛索之「锁龙诀」，手中"+weapon->name()+HIW"一抖，登时幻出漫天鞭影，宛如蛟龙通天，银蛇乱舞！\n" NOR; 
message_vision(msg, me, weapon);
me->add_temp("apply/attack", extra);
me->add_temp("apply/damage", extra);
COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
if (skill>149)    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
if (skill>199)    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
if (skill>299)    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
if (skill>399)    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
if (skill>599)    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
if (skill>799)    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
if (skill>999)    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
me->add_temp("apply/attack", -extra);
me->add_temp("apply/damage", -extra);
if (me->query_skill_mapped("force")=="wudu-xinfa" && !me->query("env/innoxious") && target->query("spskk")!=9) 
target->apply_condition("wudu",5+random(5));
me->start_busy(2+random(1)); 
return 1; 
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("ruanhong-zhusuo")+" 100 级\n"; 
temp+= "\t\t"+to_chinese("whip")+" 100 级\n"; 
temp+= "\t\t"+to_chinese("dodge")+" 100 级\n"; 
temp+= "\t\t内力修为二十年\n";  
temp+= "\t\t内力１０００点\n";  
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP  

        使用功效：  
                连续打击对手的气血
        出招类型：  
                busy 型外功 
                如果激发五毒心法可以使得敌人中毒
                叛师不可带出  
        出手要求：    
HELP);              
write(temp);  
return 1;  
}
