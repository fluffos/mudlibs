// tengshe.c 腾蛇诀
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
string name() {
  return "「" HIW "腾蛇诀" NOR "」";
}

int valid_perform(object me) {
  if (me->query("family/family_name") != "黄花观五毒门" && me->query_skill("ruanhong-zhusuo", 1) < 350)
    return notify_fail("你还没有资格。\n");
  if (me->query("class") != "yao" && !me->samsara_check("ruanhong-zhusuo"))
    return notify_fail("你还不够资格！\n");
  if ((int)me->query_skill("ruanhong-zhusuo", 1) < 60)
    return notify_fail("你的软红蛛索不够娴熟，无法施展" + name() + "。\n");
  if (me->query("force") < 200)
    return notify_fail("你的真气不够，无法施展" + name() + "。\n");
  if (time() - me->query_temp("teng_end") < 3 + random(2))
    return notify_fail("你用力过度了。\n");
  return 1;
}

int perform(object me, object target) {
  object weapon;
  string msg;
  int ap, dp;
  int damage;
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用！\n");
  weapon = me->query_temp("weapon");
  msg = WHT "$N" WHT "陡然施展出「腾蛇」诀，手腕轻轻一抖，" + weapon->name() + WHT "顿时拔地弹起，如同活物一般悄然袭向$n" + WHT "！\n" NOR;
  me->set_temp("teng_end", time());
  ap = me->query_skill("whip", 1) + me->query_skill("force", 1);
  if (me->query("family/family_name") == "黄花观五毒门")
    ap += me->query_skill("level", 1);
  dp = target->query_skill("force", 1) + target->query_skill("parry", 1);
  if (ap / 2 + random(ap) > dp) {
    damage = (int)me->query_skill("ruanhong-zhusuo", 1);
    damage += ap / 3 + random(ap / 3);
    me->add("force", -150);
    msg += HIR "然而$n" HIR "未能看破企图，一声惨嚎，"
      +weapon->name() + HIR "鞭端已没入体内半寸"
      "，登时连退数步！\n" NOR;
    target->receive_damage("kee", damage, me);
    target->receive_wound("kee", random(damage), me);
    if (me->query_skill_mapped("force") == "wudu-xinfa" && !me->query("env/innoxious") && target->query("spskk") != 9)
      target->apply_condition("wudu", 5);
  } else {
    me->add("force", -100);
    msg += CYN "可是$p" CYN "运足内力，奋力挡住了"
      CYN "$P" CYN "这神鬼莫测的一击！\n" NOR;
  }
  message_vision(msg, me, target);
  return 1;
}
int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("ruanhong-zhusuo") + " 60 级\n";
  temp += "\t\t内力 200 点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP  

        使用功效：  
                伤害对手气血
        出招类型：  
                延时型外功 
                当用五毒心法催发时可使对手中毒
                叛师可带出  
        出手要求：     
HELP);
  write(temp);
  return 1;
}
