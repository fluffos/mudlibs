// bohu.c 搏虎诀
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
string name() {
  return "「" HIY "搏虎诀" NOR "」";
}

int valid_perform(object me) {
  if (me->query("family/family_name") != "黄花观五毒门" && me->query_skill("ruanhong-zhusuo", 1) < 350)
    return notify_fail("你还没有资格。\n");
  if (me->query("class") != "yao" && !me->samsara_check("ruanhong-zhusuo"))
    return notify_fail("你还不够资格！\n");
  if ((int)me->query_skill("ruanhong-zhusuo", 1) < 150)
    return notify_fail("你的软红蛛索不够娴熟，无法施展" + name() + "。\n");
  if (me->query("force") < 300)
    return notify_fail("你的真气不够，无法施展" + name() + "。\n");
  return 1;
}

int perform(object me, object target) {
  object weapon;
  string msg;
  int ap, dp;
  int damage;
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用！\n");
  weapon = me->query_temp("weapon");

  msg = HIY "$N" HIY "一声暴喝，使出「搏虎」诀，手中" + weapon->name() + HIY "狂舞，漫天鞭影幻作无数小圈，铺天盖地罩向$n" + HIY "！\n" NOR;
  ap = me->query_skill("whip", 1) + me->query_skill("force", 1);
  dp = target->query_skill("force", 1) + target->query_skill("parry", 1);
  if (ap + random(ap) > dp) {
    damage = ap / 4 + random(ap / 3);
    me->add("force", -300);
    me->start_busy(1);
    msg += HIR "只听$n" HIR "一声惨叫，" + weapon->name() + HIR
      "已在$p" + HIR "身上划出数道深可见骨的伤口，皮肉"
      "分离，鲜血飞溅，苦不堪言！\n" NOR;
    target->receive_damage("sen", damage * 2, me);
    target->receive_wound("sen", damage, me);
    if (me->query_skill_mapped("force") == "wudu-xinfa" && !me->query("env/innoxious") && target->query("spskk") != 9)
      target->apply_condition("wudu", 5);
  } else {
    me->add("force", -100);
    me->start_busy(1 + random(2));
    msg += CYN "可是$p" CYN "运足内力，奋力挡住了"
      CYN "$P" CYN "这神鬼莫测的一击！\n" NOR;
  }
  message_vision(msg, me, target);
  return 1;
}
int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("ruanhong-zhusuo") + " 150 级\n";
  temp += "\t\t内力 300 点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP  

        使用功效：  
                伤害对手精神
        出招类型：  
                busy型外功 
                当用五毒心法催发时可使对手中毒
                叛师可带出  
        出手要求：     
HELP);
  write(temp);
  return 1;
}
