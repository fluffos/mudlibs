// panying.c 盘鹰诀
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
string name()  
{
return "「"YEL"盘鹰诀"NOR"」";  
}

int valid_perform(object me)
{
if (me->query("family/family_name")!="黄花观五毒门" && me->query_skill("ruanhong-zhusuo",1)<350 )
return notify_fail("你还没有资格。\n"); 
if ( me->query("class")!="yao" && !me->samsara_check("ruanhong-zhusuo"))
        return notify_fail("你还不够资格！\n"); 
        if ((int)me->query_skill("ruanhong-zhusuo", 1) < 80)
                return notify_fail("你的软红蛛索不够娴熟，无法施展"+name()+"。\n");
        if (me->query("force") < 100)
                return notify_fail("你的真气不够，无法施展"+name()+"。\n");
return 1;  
}

int perform(object me, object target)
{
        object weapon;
        string msg;
        int ap, dp;
      int damage;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
        if (target->is_busy())
                return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧！\n");
weapon = me->query_temp("weapon");
        msg = YEL "$N" YEL "使出软红蛛索「盘鹰」诀，手腕轻轻一抖，顿时鞭"
              "影重重，完全笼罩$n" YEL "四周！\n";
       if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 3)
        {
                msg += HIR "$n" HIR "微作诧异，一时勘破不透$N" HIR "招中"
                       "奥妙，顿被攻了个措手不及！\n" NOR;
                target->start_busy(random(3) + 3);
        } else
        {
                msg += CYN "可是$p" CYN "看破了$P"
                      CYN "的企图，小心应对，并没有上当。\n" NOR;
               me->start_busy(1+random(2));
        }
        message_vision(msg, me, target);
        return 1;
}
int help(object me) 
{
string temp; 
temp = "\t\t"+to_chinese("ruanhong-zhusuo")+" 80 级\n"; 
temp+= "\t\t内力 100 点\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP  

        使用功效：  
                牵制对手
        出招类型：  
                busy 型外功 
                无隐藏攻击
                叛师可带出  
        出手要求：     
HELP);    
write(temp); 
return 1; 
}
