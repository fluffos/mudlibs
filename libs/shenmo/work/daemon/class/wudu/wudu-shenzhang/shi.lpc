#include <ansi.h>
#include <combat.h>
inherit SSERVER;
string name() {
  return "「" HIR "万毒噬体" NOR "」";
}

int valid_perform(object me) {
  if (me->query("family/family_name") != "黄花观五毒门" && !me->samsara_check("wudu-shenzhang", 1))
    return notify_fail("你是哪儿偷学来的武功，也想用" + name() + "？\n");
  if ((int)me->query_skill("wudu-xinfa", 1) < 200)
    return notify_fail("你的内功不够火候，难以施展" + name() + "。\n");
  if (me->query_skill_mapped("force") != "wudu-xinfa")
    return notify_fail("不用五毒心法催发掌力怎能施展毒功？\n");
  if ((int)me->query_skill("wudu-shenzhang", 1) < 150)
    return notify_fail("你的五毒神掌不够娴熟，难以施展" + name() + "。\n");
  if (me->query("force") < 1000)
    return notify_fail("你现在的真气不够，难以施展" + name() + "。\n");
  if ((int)me->query_skill("unarmed", 1) < 150)
    return notify_fail("你的扑击格斗之技修为不够，难以施展" + name() + "。\n");
  return 1;
}

int perform(object me, object target) {
  string msg;
  int damage;
  int ap, dp;
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用！\n");

  msg = HIW "$N" HIW "将体内真气运于双掌之间，只见双掌微微泛出紫光，猛"
    "地拍向$n。\n" NOR;
  ap = me->query_skill("unarmed", 1);
  dp = target->query_skill("force", 1);
  ap += me->query_skill("wudu-xinfa", 1);
  if (random(ap + dp) > dp) {
    damage = ap + random(ap);
    damage += me->query("level");
    damage += me->query("force_factor");
    msg += HIR "只见$n" HIR "被$N" HIR "一掌拍中"
      "，倒退几步，却见脸色已微微泛黑。\n" NOR;
    target->receive_damage("sen", damage * 2, me);
    target->receive_wound("sen", damage, me);
    target->receive_damage("kee", damage * 2, me);
    target->receive_wound("kee", damage, me);
    if (!me->query("env/innoxious") && target->query("spskk") != 9)
      target->apply_condition("wudu", (int)me->query_skill("wudu-shenzhang", 1) / 50);
    me->start_busy(2);
  } else {
    msg += CYN "可是$p" CYN "眼明手快，侧身一跳$P"
      CYN "已躲过$N这招。\n" NOR;
    me->start_busy(2 + random(3));
  }
  message_vision(msg, me, target);
  return 1;
}
int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("wudu-shenzhang") + " 150 级\n";
  temp += "\t\t" + to_chinese("unarmed") + " 150 级\n";
  temp += "\t\t" + to_chinese("wudu-xinfa") + " 200 级\n";
  temp += "\t\t必须激发五毒心法\n";
  temp += "\t\t内力 1000 点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP  

        使用功效：  
                伤害对手气血和精神的同时使对手严重中毒
        出招类型：  
                busy型外功 
                有隐藏攻击
                叛师不可带出  
        出手要求：     
HELP);
  write(temp);
  return 1;
}
