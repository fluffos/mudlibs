#include <ansi.h>
#include <combat.h>
inherit SSERVER;
string name()  
{
return "「"HIG"千幻神诀"NOR"」";
}

int valid_perform(object me)
{
if(me->query("family/family_name")!="黄花观五毒门" && !me->samsara_check("wudu-shenzhang", 1)) 
        return notify_fail("你是哪儿偷学来的武功，也想用"+name()+"？\n");
       if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
                return notify_fail(name()+"只能空手施展。\n");
        if ((int)me->query_skill("wudu-shenzhang", 1) < 100)
               return notify_fail("你五毒神掌不够娴熟，难以施展"+name()+"。\n");
        if ((int)me->query_skill("wudu-xinfa", 1) < 100)
               return notify_fail("你五毒心法不够娴熟，难以施展"+name()+"。\n");
        
        if ((int)me->query_skill("dodge", 1) < 150)
                return notify_fail("你的轻功修为不够，难以施展"+name()+"。\n");
        if ((int)me->query("force") < 200)
                return notify_fail("你现在的真气不够，难以施展"+name()+"。\n");
if( time()-(int)me->query_temp("huan_end") < 6+random(6) ) 
        return notify_fail("绝招用多就不灵了！\n"); 
return 1;  
}

int perform(object me, object target)
{
        string msg;
        int ap, dp;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

if (target->is_busy())
        return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧。\n");
        ap = me->query_skill("wudu-shenzhang", 1) +
             me->query_skill("dodge", 1);
        dp = target->query_skill("dodge", 1);
        msg = HIC "\n$N" HIC "身法陡然变快，使出绝招「" HIG "千幻神诀" HIC "」，"
              "双掌不断拍出，\n招式如影如幻，虚实难测，试图扰乱$n" HIC "的攻"
              "势。\n" NOR;
        message_vision(msg, me, target);
       if (random(ap) > dp / 3)
        {
		msg = HIY "$n" HIY "只见$N" HIY "双掌飘忽不定，毫"
                      "无破绽，竟被困在$N" HIY "的掌风之中。\n" NOR;
                target->start_busy(2+random(3));
                me->add("force", -700);
        } else
        {
                msg = CYN "$n" CYN "看破$N" CYN "毫无攻击之意，于"
                      "是大胆反攻，将$N" CYN "这招尽数化解。\n" NOR;
                me->add("force", -600);
        }
        message_vision(msg, me, target);
me->set_temp("huan_end",time());
        return 1;
}
int help(object me) 
{
string temp; 
temp = "\t\t"+to_chinese("wudu-shenzhang")+" 300 级\n"; 
temp+= "\t\t"+to_chinese("wudu-xinfa")+" 300 级\n"; 
temp+= "\t\t"+to_chinese("dodge")+" 450 级\n"; 
temp+= "\t\t内力 400 点\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP  

        使用功效：  
                牵制对手
        出招类型：  
                延时型外功 
                无隐藏攻击
                叛师不可带出  
        出手要求：     
HELP);    
write(temp); 
return 1; 
}
