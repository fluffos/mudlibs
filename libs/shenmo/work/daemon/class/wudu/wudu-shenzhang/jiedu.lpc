
// jiedu.c 解五毒神掌
#include <ansi.h>

inherit SSERVER;
int perform(object me, object target )
{
        string msg;

        if( !target ) target = offensive_target(me);

        if( !target || !target->is_character() )
                return notify_fail("你要给谁解毒。\n");

        if( (int)me->query_skill("wudu-xinfa", 1) < 300 )
                return notify_fail("你的五毒心法修为太差，不能解五毒门奇毒。\n");

        if( (int)me->query_skill("wudu-shenzhang", 1) < 200 )
                return notify_fail("你的五毒神掌不够娴熟，不能解五毒门奇毒。\n");

        if( (int)me->query("force", 1) < 1000 )
                return notify_fail("你现在内力太弱，不能解毒。\n");
                
        if( target->query_condition("wudu")< 1)
        	return notify_fail("他没有中毒。\n");

        me->add("force", -800);
        target->apply_condition("wudu", 0);
        msg = HIW "$N使出五毒神掌解毒的手法为$n推拿。接着给$n服下一粒解药.\n"NOR;

        message_vision(msg, me, target);
        return 1;
}

