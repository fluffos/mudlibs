
// recover.c
#include <ansi.h>

inherit SSERVER;

int cast(object me, object target, int amount)
{
        int force, lvl;
        if( target ) return 
        notify_fail("你只能化解自身体内的毒素为己用。\n");
        force =(int) me->query("mana") - (int) me->query("max_mana");
        if( force <=100) return notify_fail("你的法力不足。\n");
    lvl = me->query_skill("xiuluo-yinshagong",1);
        if (random(lvl) < 20)
        {               me->add("mana", -100  );
                        message_vision(HIY"$N慢慢化解体内毒素导入丹田，脸上白一阵黑一阵。。。。。。\n", me);
                        return notify_fail("糟糕！你的法力不够，难以承受如此剧毒！\n");
        }
        else
        {
        me->clear_condition();  
me->improve_skill("xiuluo-yinshagong", lvl);
message_vision(HIY"$N慢慢化解体内毒素导入丹田，脸上白一阵黑一阵。。。。。。\n", me);
                write(HIY"良久，你神采奕奕地站了起来，感觉功力大增！\n");
        return 1;
        }
}
 
