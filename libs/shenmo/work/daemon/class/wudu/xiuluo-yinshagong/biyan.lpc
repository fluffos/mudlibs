// thunder.c
#include <ansi.h>

inherit SSERVER;

int cast(object me, object target)
{
	int success_adj, damage_adj;

        if(me->query("class")!="yao")
               return notify_fail("你非妖族弟子，不能用「碧焰」！\n");
	if( !target ) target = offensive_target(me);

	if( !target
	||      !target->is_character()
	||      target->is_corpse()
	||      target==me)
                return notify_fail("你要对谁施展碧焰？\n");

if( time()-(int)me->query_temp("biyan_cast") < 3+random(5) ) 
        return notify_fail(YEL"你的魔法尚未恢复！\n"NOR);
	if((int)me->query("mana") < 100+2*(int)me->query("mana_factor") )
		return notify_fail("你的法力不够！\n");

	if((int)me->query("sen") < 100 )
		return notify_fail("你无法集中精力！\n");

	me->add("mana", -25-2*(int)me->query("mana_factor"));
	me->receive_damage("sen", 50);

	if( random(me->query("max_mana")) < 50 ) {
                write("你发觉这次不灵。\n");
		return 1;
	}
	

	SPELL_D->attacking_cast(
		me, 
			//attacker 
		target, 
			//target
                "kee",          
			//damage type: could be "qi"/"kee", "shen"/"sen", ...default "both"
                HIC "\n$N口中喃喃了几句，突然双掌向前平平推出，掌缝里吐出一道"HIG"碧焰"HIC"，射向$n！\n" NOR,
			//initial message
                HIR "\n结果「啪」地一声，碧焰正好打在$n的胸口，\n$n惨叫一声，一口鲜血狂喷而出！\n" NOR, 
			//success message
                HIC "$n全力向后一纵一闪，凶险万分地避开了那急速而来的碧焰！\n" NOR, 
			//fail message
                HIC "但是碧焰被$n以法力反激，反向$N射去！\n" NOR, 
			//backfire initial message
                HIR "结果「啪」地一声，碧焰正好打在$n的胸口，$n惨叫一声，一口鲜血狂喷而出！\n" NOR
			//backfire hit message. note here $N and $n!!!
	);

if ( me->query("family/family_name")!="黄花观五毒门" ) 
	me->start_busy(1+random(2));
me->set_temp("biyan_cast",time());
	return 3+random(5);
}

