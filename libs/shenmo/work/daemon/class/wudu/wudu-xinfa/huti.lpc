
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

void remove_effect(object me)
{
    if(me && me->query_temp("powerup")){
      me->add_temp("apply/damage", -me->query_skill("wudu-xinfa", 1)/6);
      me->add_temp("apply/armor", -me->query_skill("wudu-xinfa", 1)/8);
      me->delete_temp("powerup");
      tell_object(me,HIG"你的「五毒护体神功」运功完毕，感到内劲渐渐消退,脸色也恢复正常。\n"NOR);
      }
}
void check_fight(object me)
{
    if (!me) return;

    if (me->query_skill_mapped("force"!="wudu-xinfa") ||
        !me->is_fighting() || me->query("force") < 10
        ) {
        	remove_call_out("remove_effect"); 
                remove_effect(me);
                }
    else call_out("check_fight", 1, me);
}

int exert(object me)
{

      int i, z;

      if( !me->is_fighting() )
          return notify_fail("「五毒护体神功」只能在战斗中对对手使用。\n");
if(me->query("family/family_name") != "黄花观五毒门" && me->query("spskk")!=12)
return notify_fail("「"HIB"五毒护体神功"NOR"」是五毒门不传之密！\n");

      if( (int)me->query("force") < 800 || (int)me->query("max_force")<1200  ) 
                return notify_fail("你的内力不够。\n");
      if( (int)me->query_temp("powerup") ) 
                return notify_fail("你已经在运功中了。\n");

      i = me->query_skill("wudu-xinfa", 1)/6;
      z = me->query_skill("wudu-xinfa", 1)/8;
      me->add("force", -500);

      message_vision(HIC "\n$N运起五毒心法，头顶黑气蒸腾，全身肌肤坟起黑色的鳞甲，双目凶光四射！\n\n" NOR, me);
      me->add_temp("apply/damage", i);
      me->add_temp("apply/armor", z);
      me->set_temp("powerup", 1);
      check_fight(me);
      call_out("remove_effect", z, me);
      return 1;
}

