#include <ansi.h>
inherit SSERVER;

string name() {
  return "「" HIM "光之荣耀" NOR "」";
}

int valid_perform(object me) {


  if (me->query("force") < 25 + me->query("force_factor"))
    return notify_fail("你的内力不足" + 25 + me->query("force_factor") + "点，不能施展" + name() + "。\n");
  if (me->query("kee") < 500)
    return notify_fail("你的气血不足 500 点，不能施展" + name() + "。\n");
  if (me->query_skill("shenfa-quan", 1) < 80)
    return notify_fail("你的" + to_chinese("shenfa-quan") + "等级不足 80 级，无法使出" + name() + "。\n");
  if (time() - (int)me->query_temp("moon_flower") < 4)
    return notify_fail(name() + "需要4秒的冷却时间。\n");
  return 1;
}

int perform(object me, object target) {
  string msg, str, temp;
  int sk, wx, damage = 0, ap, dp, s_num, chance;

  if (!valid_perform(me))
    return 0;
  if (!target)
    target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || !me->is_fighting(target))
    return notify_fail("你要对谁施展" + name() + "？\n");

  if (target->query_temp("weapon"))
    temp = target->query_temp("weapon")->name();
  else temp = "长袖";

  me->add("force", -125 - (int)me->query("force_factor"));
  me->receive_damage("kee", 100);
  me->set_temp("moon_flower", time());
  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    msg = MAG "
$N" MAG "微微一笑，身子凌空而起，洒下万千光线，一时眼花缭绕。$n" MAG "只觉周身
都被金光罩住了，一时竟然不知如何招架，更不用说躲闪了！\n\n" NOR;
  else msg = MAG "\n$N" MAG "对$n" MAG "使用了" + name() + MAG "。\n" NOR;
  message_vision(msg, me, target);

  msg = "";
  s_num = (random(me->query_skill("unarmed", 1) * 10));
  s_num += (me->query_skill("shenfa-quan", 1) * 10) + 1;

  ap = me->query_skill("unarmed", 1);
  ap = (ap / 10) * (ap / 10) * ap;
  dp = target->query_skill("dodge", 1);
  dp = (dp / 10) * (dp / 10) * dp;
  if (dp < 1) dp = 1;
  ap += me->query("combat_exp") / 100;
  dp += target->query("combat_exp") / 100;

  if (wizardp(me))
    tell_object(me, "ap===" + ap + ", dp===" + dp + "\n");
  damage = 0;
  chance = (random(ap + dp) - dp) / 150;
  if (COMBAT_D->restrain(me, target))
    chance += random(chance * 5);
  if (COMBAT_D->restrain(target, me))
    chance -= random(chance * 5);

  if (wizardp(me))
    tell_object(me, "chance==" + chance + "\n");
  if (chance > 500) {
    s_num = chance * 8;
    damage = s_num * 5;
    damage += me->query("force_factor");
    damage -= random(target->query("force_factor"));
    damage -= random(target->query_temp("apply/armor"));
    if (damage > 5000) damage = 5000;
    msg += HIM "这些光线看似柔弱无力，却如疾风骤雨般射向$n," + HIW + chinese_number(s_num) + HIM "条金线深深的嵌入$n" HIM "肉里！\n" NOR;
    target->receive_wound("kee", damage, me);
    wx = me->query("combat_exp");
    sk = (int)me->query_skill("unarmed", 1);
    sk = sk - (int)me->query_temp("apply/ad_unarmed");
    if (sk * sk / 80 * sk > wx / 8)
      me->improve_skill("unarmed", 500, 1);
  } else if (chance > 10) {
    s_num = chance / 10;
    damage = s_num * 80;
    if (damage > 1600) damage = 1600;
    msg += HIC "这些光线看似柔弱无力，却如疾风骤雨般射向$n" HIC ",$p躲闪不及被" + HIW + chinese_number(s_num) + HIC "条金线擦伤！！\n" NOR;
    target->receive_wound("kee", damage, me);
    wx = me->query("combat_exp");
    sk = (int)me->query_skill("unarmed", 1);
    sk = sk - (int)me->query_temp("apply/ad_unarmed");
    if (sk * sk / 80 * sk > wx / 8)
      me->improve_skill("unarmed", 50, 1);
  } else msg += HIC "谁知$n" HIC "竟险中求胜，" + temp + HIC "一摆，已将所有金线打落！\n";
  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    message_vision(msg, me, target);
  if (damage > 0)
    COMBAT_D->report_status(target, damage);
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("shenfa-quan") + " 80 级\n";
  temp += "\t\t气    血 500 点\n";
  temp += "\t\t战斗状态下使用\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                损伤敌人的气血
        出招类型：
                延迟型外功

        出手要求：              
HELP);
  write(temp);
  return 1;
}
