#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target) {
  string msg;
  int extra;
  object weapon, ob;
  if (me->is_busy())
    return notify_fail("你现在没空！！\n");
  extra = me->query_skill("shenfa-quan", 1);
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「神怒」只能在战斗中使用。\n");

  if ((int)me->query("force") < 1000)
    return notify_fail("你的真气不够！\n");

  if ((int)me->query_skill("shenfa-quan", 1) < 350)
    return notify_fail("你的神罚拳火候不够，无法使用「神怒」！\n");
  if ((int)me->query_skill("shenmo-force", 1) < 200)
    return notify_fail("你的神魔心法火候不够，无法领悟「神怒」！\n");
  if ((int)me->query_skill("force", 1) < 310)
    return notify_fail("你的内功修为不够，无法使用「神怒」！\n");
  if (time() - (int)me->query_temp("sn_end") < 2)
    return notify_fail("绝招用多就不灵了！\n");
  me->add_temp("apply/attack", extra * 3);
  me->add_temp("apply/damage", extra * 2);
  weapon = me->query_temp("weapon");

  msg = HIM "那一刹那间$N的拳，出奇的稳定，就像是已完全凝结在空气中，人也变得有种逼人的锋芒与杀气，$N瞳孔收缩，忽然大喝，拳已打出，鲜红的拳风，如闪电飞虹" HIR "“神怒”！这就是神怒，所有动作突然凝结，大地间的万事万物，在这一瞬间似已全部停顿\n" NOR;
  msg += HIM "神之怒，血流万里，天地不仁，以万物为刍狗！\n" NOR;
  message_vision(msg, me, target);
  msg = HIC "\n   神 \n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "\n          之\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIW "\n                   愤\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIR "\n                            怒\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIB "\n                                     杀\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  me->add_temp("apply/attack", -extra * 3);
  me->add_temp("apply/damage", -extra * 2);
  me->add("force", -500);
  me->set_temp("sn_end", time());

  return 1;
}
