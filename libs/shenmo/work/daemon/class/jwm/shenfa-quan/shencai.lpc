//【神罚拳】之【神裁】
//四连击

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target) {
  int i, extra;
  string msg;
  object weapon;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这一招「神裁」？\n");


  if (!me->is_fighting())
    return notify_fail("「神裁」只能在战斗中使用！\n");
  if (me->query_skill("shenfa-quan", 1) < 100)
    return notify_fail("你的神罚拳等级不够，尚未领会到这个绝招！\n");
  if (me->query("kee") < 300)
    return notify_fail("你的体力太差了，发出「神裁」后恐怕对身体不利！");
  if (me->query("force") < 1000)
    return notify_fail("你的内力不够，无法发出「神裁」！");
  if (time() - (int)me->query_temp("sc_end") < 3)
    return notify_fail("绝招用多就不灵了！\n");

  extra = me->query_skill("unarmed") * 5;
  extra = extra * 1;
  if (me->query_temp("might_set")) extra += extra / 3;
  me->add_temp("apply/attack", extra);
  me->add_temp("apply/strength", extra);
  me->add_temp("apply/add_phy", extra);
  msg = HIY "$N使出神罚拳的不传之密「神裁」，身体腾空而起，凌空发拳，
 瞬间已经攻出10拳！" NOR;
  message_vision(msg, me, target);

  message_vision(HIC "\n只见$N面显庄严，一式「" HIY "百破神拳" NOR MAG "」，提一口真气，飘身而上，半空中双拳交错，一股内劲狭带着热
浪，如风如火，似雷似电，这一拳打出，击向$n" NOR MAG "，招式平平淡淡，一成不变，但却挡无可挡，避无可避！\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  message_vision(HIC "\n$N突然眼睛一闪，猛吸一口气，使出全身的力气出拳向$n击去！\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  message_vision(msg, me, target);
  message_vision(HIC "\n$N拳出如风，$n霎时间眼中尽是$N的拳影，不觉已身中数拳，“哇”的一声喷出一口鲜血！\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  message_vision(HIC "\n$N出手既快，方位又奇，$n如何避得，当即被$N揪住，重重的摔在地上！\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  message_vision(HIC "\n$n前胸中了$N全力一击，只觉一阵剧痛，“哇”的一声喷出一口鲜血！\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

  for (i = 0; i < 10; i++)
    COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR);

  msg = HIC "$N完成最后一击之后，左手轻轻在$n的肩头一拍，身体便借力远远飘开了三丈有余。\n" NOR;
  message_vision(msg, me, target);
  me->add_temp("apply/attack", -extra);
  me->add_temp("apply/strength", -extra);
  me->add_temp("apply/add_phy", -extra);
  me->add("force", -100 - random(1000));
  me->set_temp("sc_end", time());

  return 1;
}
