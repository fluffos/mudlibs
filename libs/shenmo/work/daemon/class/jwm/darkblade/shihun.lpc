// 作者： tonii@ 缥缈水云间, 2003-4-29于浙大，修改请保留此行。
//【暗黑蚀魂剑】之【蚀魂】
// 伤害对方精神为我所用

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target)
{
        int damage;
        int ap,dp;
        string msg;

        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
        return notify_fail("你要对谁施展这一招「蚀魂」？\n");

        if(!me->is_fighting())
                return notify_fail("「蚀魂」只能在战斗中使用！\n");
        if( me->query_skill("darkblade",1) < 50)
               return notify_fail("你的暗黑蚀魂刀等级不够，尚未领悟到这个绝招！\n");
        if(me->query("kee")<100)
               return notify_fail("你的体力太差了，不能使用「蚀魂」！");
        if(me->query("force")<300)
               return notify_fail("你的内力不够，无法发出「蚀魂」！");
        if(me->query_temp("no_darkblade_shihun")>time())
			return notify_fail("你不能连续使用「蚀魂」！\n");
     me->set_temp("no_darkblade_shihun",time()+1);
     
        ap=(int)me->query_skill("blade");
if( ap > 1000)  ap=ap/10*ap*ap/10+me->query("combat_exp")/20+me->query("daoxing")*2;
else  ap=ap*ap*ap/1000+me->query("combat_exp")/20+me->query("daoxing")/20;
        dp=(int)target->query_skill("force")+(int)target->query_skill("parry")/2;
        dp=dp*dp*dp/8000+target->query("combat_exp")/10;
        
        damage=(int)me->query_skill("blade")+me->query("force_factor");
       damage=random(damage)+50;//modifyed by dogdog,+30->+50
	   damage=damage*8/10;
if(me->query_temp("magic_set")) {
ap += ap/2;
damage += damage/2;
}

        msg=HIR"$N的刀尖距离$n大约尚有一尺之时，突然剑体发出诡异的蓝光，闪烁跳跃！\n\n"NOR;
        message_vision(msg, me, target);

      if(random(ap*3/2+dp)>dp) //modifyed by dogdog,ap->ap*3/2
        {
        
        	msg=RED"$n突然感觉精神减弱了许多！\n\n"NOR;
        	message_vision(msg, me, target);
        	target->receive_damage("sen",damage);
        	target->receive_wound("sen",damage/2);
        	if( me->query("sen")<me->query("max_sen")-30||me->query("eff_sen")!=me->query("max_sen"))
              {
               	msg=HIY"$N将吸收来的精神化为己用，神志清醒了许多！\n\n"NOR;
                     message_vision(msg, me, target);
        	       me->receive_heal("sen",damage/2);
	        	me->receive_curing("sen",damage/4);
              }
              if (random(2) >0 || wizardp(me)){ //added by dogdog,2004-4-21
            msg = HIY"$N一待神志清醒了许多，马上又攻出一招。。。！\n\n"NOR;
               message_vision(msg, me, target);
             me->add_temp("apply/damage",8*me->query_skill("blade",1)/4);
               COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_REGULAR);
              me->add_temp("apply/damage",-8*me->query_skill("blade",1)/4);
         }
         }
        else
        {
         	msg=HIC"$N聚精会神，同时催动内力使身体四周形成一道金光护体，
$N的绝招失败了！\n\n"NOR;
              message_vision(msg, me, target);
              me->start_busy(0+random(0));
         }
 	if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }
        me->add("force",-50-me->quey("force_factor"));
       return 0+random(0);
}






