#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
	string dodskill,msg;
	int extra;
	int tmp;
        string str;

	object weapon;
	extra = me->query_skill("dugu-jiujian",1);
	if ( extra < 180) return notify_fail("你的「独孤九剑」还不够纯熟！\n");
       
        if( (int)me->query("max_force") < 500 )      
                return notify_fail("你的内力不够。\n");
        if( (int)me->query("force") < 100 )      
                return notify_fail("你的内力不足。\n");
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
                return notify_fail("「总决式」只能对战斗中的对手使用。\n");
	me->add_temp("apply/attack",extra);
        me->add_temp("apply/damage",extra);
	weapon = me->query_temp("weapon");
	  message_vision(WHT  "\n\n$N刺出独孤九剑中的(￣ε(#￣)☆╰╮o(￣皿￣///)总决式！！\n\n" NOR,me,target);  
        message_vision(YEL  "\n◎■破剑式】〓〓〓〓〓〓〓〓〓〓>！" NOR,me,target);
	  COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        message_vision( HIC  "\n◎■破枪式】〓〓〓〓〓〓〓〓〓〓>！" NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        message_vision(HIW  "\n◎■破刀式】〓〓〓〓〓〓〓〓〓〓>！" NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        
              if( (int)me->query_skill("dugu-jiujian", 1) > 150 )   {
        message_vision(HIG  "\n◎■破掌式】〓〓〓〓〓〓〓〓〓〓>！" NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        message_vision(HIM  "\n◎■破气式】〓〓〓〓〓〓〓〓〓〓>！" NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        message_vision(HIR  "\n破箭式◎■】〓〓〓〓〓〓〓〓〓〓>！" NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
              }
  
              if( (int)me->query_skill("dugu-jiujian", 1) > 200 )   {
              message_vision(HIB  "\n◎■破鞭式】〓〓〓〓〓〓〓〓〓〓>！" NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        message_vision(MAG  "\n◎■破索式】〓〓〓〓〓〓〓〓〓〓>！" NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        message_vision(RED  "\n
		◎■破】〓〓〓〓〓〓〓〓〓〓>
		◎■破】〓〓〓〓〓〓〓〓〓〓>
		◎■破】〓〓〓〓〓〓〓〓〓〓>
		◎■破】〓〓〓〓〓〓〓〓〓〓>
 oooO ↘┏━┓ ↙ Oooo 
 ( 总)→┃诀┃ ←(式 ) 
  \ ( →┃√┃ ← ) / 
　 \_)↗┗━┛ ↖(_/
		◎■破】〓〓〓〓〓〓〓〓〓〓>
		◎■破】〓〓〓〓〓〓〓〓〓〓>
		◎■破】〓〓〓〓〓〓〓〓〓〓>" NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
              }
      //               if (target->query("eff_kee")<0 || !living(target))  
//{str=target->name()+"被"+""HIW""+me->name()+""HIM""+"用"+weapon->query("name")+HIM"杀死了。";
     //   message("channel:rumor",HIM"【"HIW""+me->name()+""HIM"】"HIW""+me->name()+""HIM"："+str+"\n"NOR,users());;
	  //             }

       me->add("force", -1000);
        me->receive_damage("sen", 100);
       me->start_busy(0+random(0));
       me->add_temp("apply/attack",-extra);
       me->add_temp("apply/damage",-extra);
	return 1;
}