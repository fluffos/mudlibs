
//dugu-jiujian


#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target)
{
        int i,extra;
        string msg;
        object weapon;
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
        return notify_fail("你要对谁施展这一招「总决式」？\n");

  
        if(!me->is_fighting())
                return notify_fail("「总决式」只能在战斗中使用！\n");
        if (objectp(weapon = me->query_temp("sword")))
                return notify_fail("你必须装备剑才能使用总决式的绝招。\n");
        if( me->query_skill("dugu-jiujian",1) < 100)
               return notify_fail("你的独孤九剑等级不够，尚未领会到这个绝招！\n");
        if(me->query("kee")<300)
               return notify_fail("你的体力太差了，发出「总决式」后恐怕对身体不利！");
        if(me->query("force")<1000)
               return notify_fail("你的内力不够，无法发出「总决式」！");
     
        extra = me->query_skill("sword") / 6;
		extra = extra*8/10;
if(me->query_temp("might_set")) extra += extra/2;
        me->add_temp("apply/attack", extra);
	 me->add_temp("apply/strength", extra);
	 me->add_temp("apply/add_phy", extra);
        msg = HIY  "$N使出独孤九剑的不传之密「总决式」，剑招后发先至，
 瞬间已经攻出5剑！" NOR;
        message_vision(msg, me, target);
        for(i=0;i<12;i++)
              COMBAT_D->do_attack(me,target,weapon,TYPE_REGULAR);
        msg=HIC"$n满身鲜血倒地不起。\n"NOR;
        message_vision(msg, me, target);
        me->add_temp("apply/attack", -extra);
        me->add_temp("apply/strength", -extra);
         me->add_temp("apply/add_phy", -extra);
        me->add("force", -200-random(4000));
        me->start_busy(0);
        return 1;
}






