#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  object weapon;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这一招「北斗七星」？\n");

  if (!me->is_fighting())
    return notify_fail("「北斗七星」只能在战斗中使用！\n");

  if ((int)me->query("max_force") < 500)
    return notify_fail("你的内力不够！\n");

  if ((int)me->query("force") < 500)
    return notify_fail("你的内力不足！\n");

  if ((int)me->query("sen") < 500)
    return notify_fail("你的精神不足，没法子施用外功！\n");

  if ((int)me->query_skill("dugu-jiujian", 1) < 100)
    return notify_fail("你的独孤九剑级别还不够，使用这一招会有困难！\n");

  if (me->query_temp("fbd_pfm_busy")) return notify_fail("连续使用此招有损丹田真气。\n");

  me->delete("env/brief_message");
  target->delete("env/brief_message");

  message_vision(HIC "\n$N使出独孤九剑之北斗七星，剑锋一转，右手食指跟着弹出，只见剑花指风相辉相映，直袭$n！\n" NOR, me, target);

  target->start_busy(1);
  message_vision(HIC "\n$N嫣然一笑，诡异之极，身法陡然加快！" NOR, me, target);
  me->set_temp("QJB_perform", 1);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  message_vision(HIC "\n$N情急智生，提指向$n右眼刺去，！" NOR, me, target);
  me->set_temp("QJB_perform", 2);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  message_vision(HIC "\n$N双手合十互击，陡然向外一分，双掌顿时变得轻灵飘逸，灵动异常！" NOR, me, target);
  me->set_temp("QJB_perform", 3);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  message_vision(HIC "\n$N这一下使得剑气纵横，竟然声震山谷。不明其理之人，无不骇异！！" NOR, me, target);
  me->set_temp("QJB_perform", 4);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  message_vision(HIC "\n$N似有无穷弹力，似真似幻，无论$n怎么变招抢攻，总是被弹了出去！" NOR, me, target);
  me->set_temp("QJB_perform", 5);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  message_vision(HIC "\n$N这时一声高喝，脸上殷红如血，不明其理之人，无不骇异！" NOR, me, target);
  me->set_temp("QJB_perform", 6);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  message_vision(HIC "\n只听“啪”的一声，$N手中的利器被内力冲击，裂成了碎片，飞向$n" NOR, me, target);
  me->set_temp("QJB_perform", 7);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  me->delete_temp("QJB_perform");

  me->receive_damage("sen", 100);
  me->add("force", -100);

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }


  me->set_temp("fbd_pfm_busy", 1);
  me->set_temp("no_move", 1);
  call_out("remove_no_move", 3, me);
  call_out("remove_effect", 5 + random(3), me);
  return 1;
}

void remove_effect(object me) {
  if (!me) return;
  me->delete_temp("fbd_pfm_busy");
}
void remove_no_move(object me) {
  if (me) me->delete_temp("no_move");
}
