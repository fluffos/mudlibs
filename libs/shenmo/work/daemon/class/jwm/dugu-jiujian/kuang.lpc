#include <ansi.h>
#include "/daemon/class/jwm/dugu-jiujian/eff_msg.h";
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string dodskill, msg;
  int extra, i, j, tmp, strength, howlong, str, damage, targetforce;
  object weapon = me->query_temp("weapon");
  mapping action;
  extra = me->query_skill("dugu-jiujian", 1);
  j = me->query("opinion/mete");
  howlong = 1 + j / 3;

  damage = extra + j * 60;
  if (damage > 700) damage = 700;

  if (me->query_skill("sword", 1) < 200) return notify_fail("你的基本剑法还不够纯熟！\n");

  if ((int)me->query("force") < 800)
    return notify_fail("你的内力不够。\n");

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［独孤九剑］只能对战斗中的对手使用。\n");

  if (time() - (int)me->query_temp("daya_end") < 1)
    return notify_fail(HIR "绝招用多就不灵了！\n" NOR);


  me->add_temp("apply/attack", extra);
  me->add_temp("apply/damage", extra);


  me->add("force", -300);

  call_out("remove_ansi", howlong, me, str);
  me->set("actions", action);
  me->reset_action();


  if (!target->is_busy() && random(target->query("cps")) < 28) target->start_busy(random(3));


  message_vision(
    HIW "\n\n$N将手中的" + weapon->name() + RED "指向天际，手指不受控制的对着$n凌空划来划去 ！\n\n" NOR,
    me,
    target
  );

  message_vision(HIY "\n「惊天一剑」，$N手中" + weapon->name() + HIM "化为万千幻影朝$n的身上疯狂划去！\n" NOR, me, target);
  //message_vision(RED  "\n\n$N伸手朝空中"+ weapon->name() +RED"一召，似乎有鲜血一样的顺着"+ weapon->name() +RED"的剑锋滴滴答答流了下来。$N肃穆而立，心中默念："+HIW"“我操你妈”！\n" NOR, me, target);
  //message_vision(HIR  "\n$N将手中的"+ weapon->name() +HIM"捏来捏去，忽然变出了个"+HIW"「▄︻┳═一」"+HIM"对着$n的的脑袋瓜子疯狂扫射！\n" NOR, me, target);
  target->receive_damage("kee", damage, me, "pfm");


  j = j + 3;
  if (j > 8) j = 8;
  for (i = 0; i < j; i++) {
    message_vision(HIR "\n$N手中的" + weapon->name() + HIM "不由自主地划来划去，只见漫天剑气直裹向$n！\n" NOR, me, target);
    if (i / 3 == 0)
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), msg);
    else if (i / 3 == 1)
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), msg);
    else
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), msg);
  }
  targetforce = target->query("force");


  target->add("force", -targetforce / 2);
  if (targetforce < 0) targetforce = 0;


  me->set_temp("daya_end", time());

  return 1;
}


int remove_ansi(object me, int extra) {
  object here;
  if (!me) return 1;
  extra = me->query_skill("dugu-jiujian", 1);
  if (me->query_temp("apply/attack"))
    me->add_temp("apply/attack", -extra);
  if (me->query_temp("apply/damage"))
    me->add_temp("apply/damage", -extra);
  message_vision(HIW "$N发觉手中武器剑气隐去！\n" NOR, me);
  return 1;
}
