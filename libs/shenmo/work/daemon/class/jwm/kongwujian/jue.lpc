//by dewbaby@sk_sjsh
//九剑·情绝

#include <ansi.h>
inherit SSERVER; 
int perform(object me, object target)
{
        int lvl;
        object weapon;
        weapon = me->query_temp("weapon");
        if( !target ) target = offensive_target(me);
        if( !target
         || !target->is_character()
         || !me->is_fighting(target) )
                return notify_fail("你只能对战斗中的对手使「情绝」。\n");

        if( (int)me->query_skill("kongwujian", 1) < 300 )
                return notify_fail("你的空无剑不够娴熟，无法施展出「情绝」。\n");
        if ( (int)me->query("max_force") < 2000)
                return notify_fail("你的内力不够，无法施展出「情绝」。\n");
        if ( (int)me->query("force") < 500)
                return notify_fail("你的真气不够，无法施展出「情绝」。\n");
        if ((int)me->query("kee") < 500)
                return notify_fail("你的气血不够，无法施展出「情绝」。\n");
        if( time()-(int)me->query_temp("kongwu_end") < 3 )
                return notify_fail("绝招用多就不灵了！\n");
     
        lvl = me->query_skill("kongwujian", 1);
     message_vision(WHT"$N神情轻蔑地看着$n。\n\n"NOR,me,target);
     message_vision(WHT"$N凝神定气，突然手中"+ weapon->name() +HIY"化为九道金色剑气朝$n射去！\n"NOR,me, target);
 
        me->add("force", -200);
        me->add("kee", -50);
        me->add_temp("apply/attack",lvl*3);
        me->add_temp("apply/damage",lvl*2);
        me->add_temp("apply/sword", lvl*3);
		me->add_temp("apply/kongwujian", lvl*3);

        message_vision(HIY"$N身形如风，手中剑气影射不断！\n"NOR,me,target);
message_vision(WHT"$n"+WHT"被被迎面而来的剑气逼得连连后退，似乎颇为吃力。\n"NOR,me,target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1); 
message_vision(HIY"红藕香残玉蕈秋"+BLINK+HIC+"瑞脑消金兽\n"NOR,me,target); 
 COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1); 
message_vision(HIY"云中谁寄锦书来 "+BLINK+HIC+"半夜凉初透\n"NOR,me,target); 
 COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1); 
message_vision(HIY"花自飘零水自流"+BLINK+HIC+"莫道不消魂\n"NOR,me,target); 
         COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
message_vision(HIY"花自飘零水自流 "+BLINK+WHT+"迢迢银汉隔\n"NOR,me,target); 
                 COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
message_vision(HIY"薄雾浓云愁永昼 "+BLINK+HIM+"去做花间蝶\n"NOR,me,target);
         COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
message_vision(HIY"东篱把洒黄昏後 "+BLINK+WHT+"情绝情难了\n"NOR,me,target);
         COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 3);

        me->start_busy(0+random(0));
        me->add_temp("apply/attack", -lvl*3);
        me->add_temp("apply/damage", -lvl*2);
        me->add_temp("apply/sword", -lvl*3);
		me->add_temp("apply/kongwujian", -lvl*3);
        me->set_temp("kongwu_end",time());
        return 1;
}


