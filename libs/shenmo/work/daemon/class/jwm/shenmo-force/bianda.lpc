#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me);
void check_fight(object me);

int exert(object me, object target)
{
        int skill;
        skill = (int)me->query_skill("shenmo-force",1);
        if( target != me ) 
                return notify_fail("变大术只能给自己使用。\n");

        if( (int)me->query("force") < 1000 )     
                return notify_fail("你的内力不够。\n");
        if( (int)me->query_temp("bianda") ) 
                return notify_fail("你已经施展变大术了。\n");
        if( (int)me->query("eff_sen") < (int)me->query("max_sen") )
                return notify_fail("你已经受伤，使用变大术只怕有生命危险！\n");
        if( (int)me->query("eff_kee") < (int)me->query("max_kee") )
                return notify_fail("你已经受伤，使用变大术只怕有生命危险！\n");
        if( !me->is_fighting() )
          return notify_fail("你只能在战斗中对对手使用。\n");


        me->add("force", -1000);
        me->receive_damage("kee", 100);

        message_vision(HIC "$N猛吸一口气，运起神魔心法，全身闪起点点"BLINK+HIY"金光"NOR+HIC"，只见$N的身体慢慢的变大了!\n" NOR, me);

        me->set("eff_kee", me->query("max_kee")*3);
        me->set("eff_sen", me->query("max_sen")*3);
        me->set("sen", me->query("max_sen")*3);
        me->set("kee", me->query("max_kee")*3);
        me->set_temp("bianda", 1);
        check_fight(me);
        call_out("remove_effect", skill/2, me,skill);
        return 1;
}

void remove_effect(object me)
{
        if(!me) return;
          me->set("eff_kee", me->query("max_kee"));
          me->set("eff_sen", me->query("max_sen"));
          me->set("sen", me->query("max_sen"));
          me->set("kee", me->query("max_kee"));
          me->delete_temp("bianda");
                tell_object(me, HIC"你的神魔心法运行一周天完毕，接着身体变了回来。\n"NOR);
}
void check_fight(object me)
{
    if (!me) return;

      if (!me->is_fighting() || me->query("force") < 100 || me->query_skill_mapped("force") != "shenmo-force") {
                remove_call_out("remove_effect"); 
                remove_effect(me);
                }
    else call_out("check_fight", 1, me);
}

