#include <ansi.h>
inherit SSERVER;

  int exert(object me, object target)
{
        int lvl;
        if( target != me ) 
                return notify_fail("你只能用真气将自己体内毒素逼出。\n");
        if( me->is_fighting() )
                return notify_fail("战斗中运功疗伤？找死吗？\n");
        if( (int)me->query("force") < 50 ) 
                return notify_fail("你的真气不够。\n");
          if( time()-(int)me->query_temp("anti_end") < 1 ) 
           return notify_fail("你刚运完功，还是等内力恢复再运功吧！\n"); 
        lvl = me->query_skill("shenmo-force",1);
        if (random(lvl) < 20)
        {               me->add("force", -100  );
                        message_vision(HIY"$N运功抗毒，头上冒出豆大的汗．．．\n"NOR, me);
                        return notify_fail(HIY"你失败了。\n"NOR);
                      me->set_temp("anti_end",time());
        }
        else
        {
        me->clear_condition();
                message_vision(HIY"$N运功抗毒，头上冒出豆大的汗．．．\n"NOR, me);  
                write(HIY"你成功了！\n"NOR);
                      me->set_temp("anti_end",time());
        return 1;
        }
}
