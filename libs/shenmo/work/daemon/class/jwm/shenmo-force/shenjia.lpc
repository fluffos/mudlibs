#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int exert(object me, object target)
{
        int skill;

        if( target != me ) 
                return notify_fail("你只能用神魔心法保护自己。\n");

        if( (int)me->query("force") < 100 )     
                return notify_fail("你的内力不够。\n");
        if( (int)me->query("kee") < 50 )
                return notify_fail("你的气血不足。\n");
        if( (int)me->query("sen") < 50 )
                return notify_fail("你的精神不足。\n");
        if( (int)me->query_temp("shenjia") ) 
                return notify_fail("你已经在运功中了。\n");

        skill = (int)me->query_skill("shenmo-force",1);

        me->add("force", -1000);
        me->receive_damage("kee", 300);
        me->receive_damage("sen", 300);

        message_vision(HIR"$N微一凝神，运起神魔心法,顿时身上像穿了神甲一般!\n" NOR, me);

        me->add_temp("apply/armor", skill);
        me->add_temp("apply/armor_vs_force", skill/2);
            me->add_temp("apply/armor_vs_spells", skill);
        me->set_temp("shenjia", 1);

        call_out("remove_effect", skill/2, me,skill);

        if( me->is_fighting() ) me->start_busy(2);

        return 1;
}

void remove_effect(object me, int amount)
{
    if (!me) return;
        me->add_temp("apply/armor", - amount);
        me->add_temp("apply/armor_vs_force", - amount/2);
              me->add_temp("apply/armor_vs_spells", - amount);
        me->delete_temp("shenjia");
        tell_object(me, "你的神魔心法运行一周天完毕，神甲渐渐消去了。\n");
        return;
}
