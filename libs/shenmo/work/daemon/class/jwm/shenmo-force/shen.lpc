#include <ansi.h>
inherit F_CLEAN_UP;
void remove_effect(object me, int amount);
void check_fight(object me);
  int exert(object me, object target)
{
        int skill,extra;
        
        skill = (int)me->query_skill("shenmo-force",1);
        if( (int)me->query_temp("powerup") ) 
                return notify_fail("你已经在运功中了。\n");

        if( (int)me->query_skill("shenmo-force", 1) < 200) 
                return notify_fail("你神魔心法等级太低，无法驾驭真气。\n"); 

        if( (int)me->query("force") < 500 )
                return notify_fail("你的真气不够。\n");
      if( !me->is_fighting() )
          return notify_fail("你只能在战斗中对对手使用。\n");

        if( (int)me->query("eff_sen") < (int)me->query("max_sen") / 2 )
                return notify_fail("你已经受伤过重，只怕一运真气便有生命危险！\n");
        write( HIB "你凝神敛气默运神魔心法，一股至阴之气在你的四肢百骸缓缓游走。\n" NOR);
        message("vision",HIW + me->name() +HIW "默运神魔心法，一股至阴至冷之气从百会穴悠悠浮上，笼罩着全身......\n"NOR,environment(me), me);
        
        me->add("force", -2000);              
        me->add_temp("apply/damage", skill);
        me->add_temp("apply/attack", skill);
        me->add_temp("apply/strength", skill);

        me->set_temp("powerup", 1);

        check_fight(me);
        call_out("remove_effect", skill, me,skill);
        return 1;
}

void remove_effect(object me, int amount)
{
        if(!me) return;
        if(!me->query_temp("powerup")) return; 
     
        me->add_temp("apply/damage", -amount);
        me->add_temp("apply/attack", -amount);
        me->add_temp("apply/strength", -amount);
        
        me->delete_temp("powerup");        
        tell_object(me, HIB"你神魔心法转一个大周天后，真气又聚回丹田。\n"NOR);
        return;
}
void check_fight(object me)
{
    if (!me) return;

      if (!me->is_fighting() || me->query("force") < 100 || me->query_skill_mapped("force") != "shenmo-force") {
                remove_call_out("remove_effect"); 
                remove_effect(me,(int)me->query_skill("shenmo-force",1));
                }
    else call_out("check_fight", 1, me);
}
