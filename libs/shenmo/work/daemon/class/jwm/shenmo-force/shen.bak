//2006.8.12 by ken
#include <ansi.h>
inherit F_CLEAN_UP;
void remove_effect(object me, int amount);

int exert(object me, object target)
{
	int skill,extra;
	
          skill = me->query_skill("shenmo-force",1);
//	if(me->query("lingwu/jwm_dabeifu_dabei")!="done") return notify_fail
//("你尚未领悟大悲诀。\n");

            if( (int)me->query_temp("shen") ) 
                return notify_fail("你已经在运功中了。\n");
        if( me->is_fighting() )
                return notify_fail("战斗中运功？你不怕走火入魔？\n");

        if( (int)me->query_skill("shenmo-force", 1) < 200) 
                return notify_fail("你神魔心法等级太低，无法驾驭真气。\n"); 

        if( (int)me->query("force") < 500 )
                return notify_fail("你的真气不够。\n");

        if( (int)me->query("eff_sen") < (int)me->query("max_sen") / 2 )
                return notify_fail("你已经受伤过重，只怕一运真气便有生命危险！\n");

        write( HIB "你凝神敛气默运神魔心法，一股至阴之气在你的四肢百骸缓缓游走。\n" NOR);
        message("vision",HIW + me->name() +HIW "默运神魔心法，一股至阴至冷之气从百会穴悠悠浮上，笼罩着全身......\n"NOR,environment(me), me);
        
        me->add("force", -2000+me->query("cps")/10);
      
        extra=(skill-400)/2+me->query("cor")*me->query("int")*me->query("con")/(1+me->query("kar")/20);
                    if(extra>4000) extra=4000+(extra-4000)/15;
    //if(extra>5000) extra=5000;
		
       
              me->set_temp("shen",1);        
        me->set_temp("exert/jwm_dabei",extra);
        me->add_temp("apply/damage", extra);
        me->add_temp("apply/attack", extra/10);
        //me->add_temp("apply/strength", extra);
        me->start_call_out( (: call_other, __FILE__, "remove_effect", me, extra :),skill);
        if(me->query("is_xiongnu")!=1) me->start_busy(2+random(4));
        

        return 1;
}

void remove_effect(object me, int amount)
{
	if(!me) return;
            if(!me->query_temp("shen")) return; 
     
        me->add_temp("apply/damage", -amount);
        me->add_temp("apply/attack", -amount/10);
        //me->add_temp("apply/strength", -amount);
        
            me->delete_temp("shen");        
        tell_object(me, HIB"你神魔心法转一个大周天后，真气又聚回丹田。\n"NOR);
        return;
}



