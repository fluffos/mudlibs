#include <ansi.h>
inherit SSERVER;

int exert(object me, object target)
{
        if( target != me ) 
                return notify_fail("你只能用真气将自己解除定身。\n");
        if( (int)me->query("force") < 50 ) 
                return notify_fail("你的真气不够。\n");
        if( time()-(int)me->query_temp("jiefeng_end") < 2 ) 
                    return notify_fail("你刚运完功，还是等内力恢复再运功吧！\n"); 
         if ((int)me->query("shenmo-1") < 0 ) 
                    return notify_fail("你无权使用！\n");


         me->add("force", -100  );
         message_vision(HIY"$N将神魔心法运行一周天，成功解除定身状态。\n"NOR, me);
         me->delete_temp("no_move");
         me->set_temp("jiefeng_end",time());
         return 1;
}


