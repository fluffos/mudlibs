#include <ansi.h>
inherit SSERVER;

mapping xian_fabao = ([
	"方寸山三星洞"	:	
		([
			"name"	: ({"玉菩提","万刃剑","缚身云"}),
			"msg"	: ({"祥云氤氲，一颗斗大的玉珠腾空而起，在半空「滴溜溜」乱转。",
				    "金光一闪，半空中升起万把光华四射的短剑，在半空中合作一把长剑！",
				    "一道彩云从半空落下，仿若深晓人性般在$n四周游走。",
				  }),
			"col"	: ({"WHT","HIY","HIW"}),			    	
			"damage": ({100,150,50}),
		]),
			
	"南海普陀山"	:	
		([
			"name"	: ({"三宝玉如意","降魔杵","金玉璎珞",}),
			"msg"	: ({"半空梵音阵阵，一把光华四溢的玉如意在半空打着转的落下。",
				    "半空中「霹雳」一声，一把飞旋的$f带着风雷之声斗然落下！",
				    "半空中梵音阵阵，氤氲缭绕，一把$f渐渐现了出来。",
				  }),  	
			"col"	: ({"HIW","HIY","HIC"}),	
			"damage": ({80,150,60}),
		]),
			
	"月宫"		:	
		([
			"name"	: ({"落日神箭","捣药杵","月中刃",}),
			"msg"	: ({"一支金光四射的长箭穿破长空，落将下来。",
				    "半空中「轰隆」一声，一把飞旋的$f带着风雷之声斗然落下！",
				    "从明月中「刷」的飞来一把奇形长刃，在半空发出淡淡的霞光。",
				  }),  	
			"col"	: ({"HIY","YEL","WHT"}),
			"damage": ({80,80,80}),
		]),
				
	"阎罗地府"	:	
		([	
			"name"	: ({"勾魂幡","丧魂钟","索命爪"}),
			"msg"	: ({"一时间阴风阵阵，鬼影憧憧，一杆丈许长幡自地下升将起来。",
				    "半空中「轰隆隆」一声钟敲之声，一道蓝光在半空滴溜溜直转！",
				    "一时间四下阴风阵阵，雾气缭绕，从黑暗中猛的射出一把红凄凄的铁爪！",
				  }),  	
			"col"	: ({"HIB","HIB","RED"}),				  
			"damage": ({80,100,100}),
		]),
			
	"东海龙宫"	:	
		([	
			"name"	: ({"龙息珠","海潮鼓","灭汐锤"}),
			"msg"	: ({"平地忽然起了一道水波，一个斗大的珠子在水柱之上滴溜溜直转。",
				    "半空中「轰隆」一阵震天鼓声，现出一道团龙环绕的大鼓！",
				    "平地忽然起了一道水柱，一个硕大的赤色之锤在水柱之上打着转。",
				  }),
			"col"	: ({"HIC","HIY","HIR"}),				    	
			"damage": ({50,80,100}),
		]),
	
	"天空界"	:	
		([	
			"name"	: ({"风缚羽","百毒羽","灭杀羽"}),
			"msg"	: ({"平地忽然现起一道旋风，一个洁白的羽毛在风中打着转。",
				    "平地忽然现起层层浓雾，一个羽状的物什在雾中隐约可见。",
				    "忽然半空中红光一闪，一根杀意逼人的羽毛现了出来。",
				  }),  	
			"col"	: ({"HIW","HIR","RED"}),				  
			"damage": ({50,100,150}),
		]),
	
	"三界散仙"	:	
		([	
			"name"	: ({"渡人刀","屠鬼刀","斩仙刀"}),
			"msg"	: ({"$N胸前忽然凭空现出一把长刀，发出道道金光。",
				    "地下忽然钻出一把长刀，发出蓝幽幽的光芒。",
				    "半空中红光一闪，忽然现出一把红幽幽的长刀。",
				  }),  	
			"col"	: ({"HIY","HIB","HIR"}),				  
			"damage": ({80,80,80}),
		]),
	
	"五庄观"	:	
		([	
			"name"	: ({"金击子","金罗剑","斩妖刃"}),
			"msg"	: ({"$N念念有词，半空中氤氲缭绕，一根$f渐渐现了出来。",
				    "$N念念有词，半空中氤氲缭绕，一根$f渐渐现了出来。",
				    "$N念念有词，半空中氤氲缭绕，一根$f渐渐现了出来。",
				  }),  	
			"col"	: ({"HIY","HIC","BLU"}),				  
			"damage": ({80,100,100}),
		]),
	
	"昆仑山玉虚洞"	:	
		([	
			"name"	: ({"打神鞭","番天印","九龙罩"}),
			"msg"	: ({"$N右手一指，半空中金光闪闪，一根神鞭呼啸着临空而下！",
				    "$N右手一指，半空中金光闪闪，一个金印呼啸着临空而下！",
				    "$N右手一指，半空中热气腾腾，一个物什呼啸着临空而下！",
				  }),  	
			"col"	: ({"HIY","HIY","RED"}),				  
			"damage": ({100,150,80}),
		]),
	
]);

int cast(object me,object target)
{
int ap,dp,i,damage,success = 0;
string hit_msg,fam,*fams,*fabaos,fabao,limb,*limbs;
string a_class,d_class,clo;

if ( !me->query_temp("auto_combat_cast") )
	return 0;
fam = me->query("family/family_name");
if ( !fam )
	return 0;	

fams = keys(xian_fabao);

if ( member_array(fam,fams)==-1 )
	return 0;

fabaos = xian_fabao[fam]["name"];
i = random(sizeof(fabaos));
fabao = fabaos[i];
damage = xian_fabao[fam]["damage"][i];
clo = xian_fabao[fam]["col"][i];
fabao = NOR+BLINK+clo+fabao+NOR;
damage = random(damage);
if ( COMBAT_D->restrain(target,me) )  //target克me
	damage/= 2;
limbs = target->query("limbs");
limb = limbs[random(sizeof(limbs))];

hit_msg = "\n战罢多时，$N晃身跳出圈外，大喝一声『疾！』\n"NOR;
hit_msg+= "只见"+xian_fabao[fam]["msg"][i]+"正
是"NOR HIG+fam+NOR+"镇界之宝：$f \n"NOR;

hit_msg+= "霎那间天色一变，风声大作！$f带出一道低啸向$n$l凌空击来！\n"NOR;

ap = (int)me->query("daoxing")/5000;
ap+= (int)me->query("mana")/50;
ap+= (int)me->query("mana_factor")/100;
if ( ap<1 ) ap=1;

dp = (int)target->query("daoxing")/5000;
dp+= (int)target->query("mana")/50;
dp+= (int)target->query("mana_factor")/100;
if ( dp<1 ) dp=1;

if( ap*2<dp )
	{
	hit_msg+="结果$n轻一挥手，嘿嘿笑了几声：想跟我斗？再去修个三五百年吧！\n"NOR;   
        hit_msg+="只见$f几个翻滚，又回到了$N的手中。\n"NOR;    
	success = -1;                
	}

else if( random(ap*2)<random(dp) )
	{
	hit_msg+="结果$n身形急闪，躲过了$f的攻势。\n"NOR;
	success = 0;
        }
else	{        
	hit_msg+= "结果$n$l衣襟破碎，给$f打了个正着！\n"NOR;
	success = 1;
	}
hit_msg = replace_string(hit_msg,"$f",fabao);
hit_msg = replace_string(hit_msg,"$l",limb);

hit_msg = replace_string(hit_msg,"HIY",HIY"");
hit_msg = replace_string(hit_msg,"HIW",HIW"");
hit_msg = replace_string(hit_msg,"HIR",HIR"");
hit_msg = replace_string(hit_msg,"HIC",HIC"");
hit_msg = replace_string(hit_msg,"HIB",HIB"");
hit_msg = replace_string(hit_msg,"WHT",WHT"");
hit_msg = replace_string(hit_msg,"RED",RED"");
hit_msg = replace_string(hit_msg,"BLU",BLU"");
hit_msg = replace_string(hit_msg,"NOR",NOR"");
hit_msg = replace_string(hit_msg,"CYN",CYN"");
hit_msg = replace_string(hit_msg,"YEL",YEL"");

hit_msg = replace_string(hit_msg,"手","胸");
hit_msg = replace_string(hit_msg,"脚","肩");

message_vision(hit_msg,me,target);
switch ( success )
	{
	case -1 :
		me->add("mana", -10);
		break;
	case 0 :
		me->add("mana", -30);
		break;
	case 1 :
		if ( damage<= 0 )
			{
			hit_msg = "结果$n硬受$f一记，却是毫发无伤！\n";
			hit_msg = replace_string(hit_msg,"$f",fabao);
			message_vision(hit_msg,me,target);
			me->add("mana", -40);
			break;
			}
		else	{
			target->receive_damage("sen",damage*2); 
			target->receive_wound("sen",damage); 
			if ( random(2) )
				COMBAT_D->report_sen_status(target); 
			else	COMBAT_D->report_sen_status(target,damage);
			me->add("mana", -50);
			break;
			}
	}
return 1;	
}

