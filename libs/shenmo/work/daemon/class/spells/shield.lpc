//光影盾  windy 2011.08
#include <ansi.h>
inherit F_CLEAN_UP;
void remove_effect(object me);

int cast(object me) {
  int level;
  me = this_player();

  if (me->query("class") != "xian" && me->query("class") != "saint")
    return notify_fail("你的体质不适合施展光影盾。\n");
  if ((int)me->query("level") < 300)
    return notify_fail("你的等级太低，不够资格施展光影盾。\n");
  if ((int)me->query("shen") < 1)
    return notify_fail("你现在元神虚弱，难以施展光影盾。\n");
  if ((int)me->query_skill("spells", 1) < 350)
    return notify_fail("你的法术修为太低，施展不了光影盾。\n");
  if ((int)me->query("mana") < 500)
    return notify_fail("你的法力不够。\n");
  if ((int)me->query("sen") < 300 || (int)me->query("eff_sen") < 300)
    return notify_fail("你现在精神无法集中。\n");
  if ((int)me->query_temp("lightshield"))
    return notify_fail("你正在施展光影盾。\n");
  if (time() - (int)me->query_temp("lightshield_over") < 10 + random(10) && me->query("spskkk") != 9)
    return notify_fail("你无法连续施展光影盾。\n");

  level = (int)me->query("level") / 10;
  if (level < 15) level = 15;
  if (level > 120) level = 120;

  me->add("mana", -300);

  message_vision(HIB "$N" HIB "右手抬起指向天空，在这一瞬间，天地之中所有的草木、生灵、屋舍、甚至是星辰，
全部散发出璀璨的光芒。那无尽的光芒刹那来临，形成一层淡蓝色的光晕，笼罩在$N
" HIB "身体四周。那光芒刺目，在这一刻，$N" HIB "整个人好似成为了这天地中光之源泉。\n" NOR, me);
  me->set_temp("lightshield", 1);
  if (!random(1000)) me->add("shen", -1);
  me->start_call_out((: call_other, __FILE__, "remove_effect", me :), level);
  return 1;
}

void remove_effect(object me) {
  if (!me)
    return;
  if (me->query_temp("lightshield")) {
    me->delete_temp("lightshield");
    me->set_temp("lightshield_over", time());
    message_vision(HIB "$N" HIB "周身的蓝色光晕渐渐淡去，化作无数光丝消散在空中。\n" NOR, me);
  }
  return;
}
