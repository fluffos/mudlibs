
// modify by windy 06/04/26
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIG"琴震四方"NOR"」";  
}

int valid_perform(object me)
{
if ( me->query("family/family_name") != "江湖浪子" && !me->samsara_check("xiaohunqin", 1))
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if (!present("liuxiang qin", me) && !present("jiaowei qin", me) && !present("wuxian qin", me) && !present("琴", me))
        return notify_fail("还是先去找一把琴再来施展"+name()+"吧！\n");
if((int)me->query_skill("xiaohunqin", 1) < 350) 
        return notify_fail("你的销魂琴修为不够，还用不出"+name()+"！\n"); 
if((int)me->query_skill("piaoxiang", 1) < 350) 
        return notify_fail("你的血海飘香修为不够，还用不出"+name()+"！\n"); 
if((int)me->query_skill("sword", 1) < 350) 
        return notify_fail("你的基本剑术修为不够，还用不出"+name()+"！\n"); 
if((int)me->query_skill("wuji-force", 1) < 350) 
        return notify_fail("你的无极心法修为不够，还用不出"+name()+"！\n"); 
if((int)me->query_skill("qin", 1) < 350) 
        return notify_fail("你在音乐方面的造诣太差，还用不出"+name()+"！\n"); 
if((int)me->query_skill("tanzhishentong", 1) < 350) 
        return notify_fail("你的弹指神通修为不够，难以催发"+name()+"！\n"); 
if((int)me->query("max_force") < 3000 )
        return notify_fail("你的内力修为不够，无法施展"+name()+"！\n");
if((int)me->query("force") < 1500 )
        return notify_fail("你的内力不足，无法施展"+name()+"！\n");
if((int)me->query("sen") < 800 )
        return notify_fail("你的精神不足，无法集中精力施展"+name()+"！\n");
if( time()-(int)me->query_temp("qin_end") < 5+random(5) )
        return notify_fail("你过渡使用了内力，暂时无法施展"+name()+"！\n");
return 1;  
}

int perform(object me, object target)
{
int ini_damage_apply,damage;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

ini_damage_apply = me->query_temp("apply/damage");

message_vision(HIW"\n$N销魂一笑，妙用弹指神通拂动琴弦，此时琴声凌震天下，势若雷霆，卷向$n。\n"NOR,me,target);
damage=1;
//前三剑
message_vision(HIG"$N弹出销魂三曲，竟从乐理中悟出高深剑法，漫天琴声如虹，攻向$n。\n"NOR,me,target);
me->set_temp("WX_perform", 5);
damage=COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
if (damage < 1) me->add_temp("apply/damage",100);
me->set_temp("WX_perform", 0);  
damage=COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
if (damage < 1) {me->add_temp("apply/damage",100);}
        else    {me->set_temp("apply/damage",ini_damage_apply);}
me->set_temp("WX_perform", 6);
damage=COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

//再两剑
if( (int)me->query_skill("xiaohunqin",1) > 299 && (int)me->query_skill("qin",1) > 299 )
{
message_vision(HIG"$N纵声长啸，掌中琴脱手飞出，气势刚猛无俦，犹若风雷并发，又使出了两招。\n"NOR,me);
if (damage < 1) {me->add_temp("apply/damage",200);}
    else    {me->set_temp("apply/damage",ini_damage_apply);}
me->set_temp("WX_perform", 7);
damage=COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
if (damage < 1) {me->add_temp("apply/damage",200);}
    else    {me->set_temp("apply/damage",ini_damage_apply);}
me->set_temp("WX_perform", 8);
damage=COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
}

//最后两剑
if( (int)me->query_skill("xiaohunqin",1) > 349 && (int)me->query_skill("qin",1) > 349 )
{
message_vision(HIG"$N冷喝一声，脚踏血海飘香步法，倏地前飘，复将琴接入掌中，旋又闪电般攻向$n。\n"NOR,me,target);
if (damage < 1) {me->add_temp("apply/damage",300);}
     else    {me->set_temp("apply/damage",ini_damage_apply);}
me->set_temp("WX_perform", 9);
damage=COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
if (damage < 1) {me->add_temp("apply/damage",300);}
    else    {me->set_temp("apply/damage",ini_damage_apply);}
me->set_temp("WX_perform", 10);
COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
}

me->delete_temp("WX_perform");
me->set_temp("apply/damage",ini_damage_apply);
me->receive_damage("sen", 300);
me->add("force", -1000);
me->set_temp("qin_end",time());
return 1;
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("xiaohunqin")+" 350 级\n"; 
temp+= "\t\t"+to_chinese("qin")+" 350 级\n"; 
temp+= "\t\t"+to_chinese("wuji-force")+" 350 级\n"; 
temp+= "\t\t"+to_chinese("sword")+" 350 级\n"; 
temp+= "\t\t"+to_chinese("piaoxiang")+" 350 级\n"; 
temp+= "\t\t"+to_chinese("tanzhishentong")+" 350 级\n"; 
temp+= "\t\t身上必须有一件琴类乐器\n";  
temp+= "\t\t内力上限３０００点\n";  
temp+= "\t\t内力１５００点\n";  
temp+= "\t\t精神８００点\n";  
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP  

        使用功效：  
                连续打击对手的气血
        出招类型：  
                延时型外功 
                无隐藏攻击 
                叛师不可带出  
        出手要求：    
HELP);              
write(temp);  
return 1;  
}
