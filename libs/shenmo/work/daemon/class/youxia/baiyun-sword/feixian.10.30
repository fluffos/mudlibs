
#include <ansi.h>
inherit PERFORM;

int set_damage()
{
object me=this_player();
int damage;
damage=me->query_skill("baiyun-sword",1);
damage/=10;
return damage;
}

int set_attack()
{
object me=this_player();
int attack;
attack=me->query_skill("piaoxiang",1);
attack/=10;
return attack;
}

void create()
{
set("name",HIW"天外飞仙"NOR);
set("class","human");
set("target",1);
set("force",1200);
set("need_force",300);

set("limit_skill",([
"baiyun-sword"  : 180,
"piaoxiang"  : 180,
"sword"  : 180,
"dodge"  : 180,
]));

set("limit_other",([
"max_force"  :  1000,
]));
set("busy_self",(2+random(2)));

}

int perform(object me,object target)
{
if ( me->query("family/family_name")!="江湖浪子"
   && me->query_skill("baiyun-sword",1)<350 )
     return notify_fail("你的白云剑法光靠自己领悟是不够的。\n");
return ::perform(me,target);
}


void hit_msg(object me,object target,int num)
{
int skill,damage,attack;
object weapon=me->query_temp("weapon");
if(me&&target&&num==1)
{
skill=me->query_skill("baiyun-sword",1)+me->query_skill("piaoxiang",1);
skill/=80;
damage=set_damage();
attack=set_attack();
if( skill>7) skill=7;
if( skill<2) skill=2;
set("double_hit",([
"num" : skill,
"me_del_env": 1,
"t_del_env" : 1,
"damage" : damage,
"attack" : attack,
]));
message_vision(HIC"\n$N脚踏"HIW"「"HIR"血海飘香"HIW"」"HIC"身法，同时使出"HIW"「"HIG"白云剑法"HIW"」"HIC"中的精髓－－"HIW"『"HIB"天外飞仙"HIW"』!\n"HIC"            $N手中的"NOR""+ weapon->name() +""HIC"划出一道长虹，闪电般的击向$n！\n" NOR,me,target);
message_vision(HIY "\n只见$N手中的"NOR""+ weapon->name() +""HIY"剑光一闪，瞬间消失．．．．\n" NOR,me,target);
}

}

void double_hit_msg(object me,object target,int num)
{
if(me&&target)
message_vision(HIY"\n$N身形突转，御剑回飞！\n"NOR,me,target);
}
