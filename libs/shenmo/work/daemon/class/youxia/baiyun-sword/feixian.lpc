
// write by windy 06/04/26
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIW"天外飞仙"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name")!="江湖浪子" && (int)me->query_skill("baiyun-sword", 1) < 350) 
        return notify_fail("你还不够资格使用"+name()+"！\n"); 
if ( me->query("class")!="human" && !me->samsara_check("baiyun-sword"))
        return notify_fail("你还不够资格！\n"); 
if((int)me->query_skill("baiyun-sword", 1) < 180) 
        return notify_fail("你的白云剑法修为不够，还用不出"+name()+"！\n"); 
if((int)me->query_skill("sword", 1) < 180) 
        return notify_fail("你的基本剑术修为不够，还用不出"+name()+"！\n"); 
if((int)me->query_skill("piaoxiang", 1) < 180) 
        return notify_fail("你的血海飘香根基太差，难以施展"+name()+"！\n"); 
if((int)me->query_skill("dodge", 1) < 180) 
        return notify_fail("你的基本轻功修为不够，还用不出"+name()+"！\n"); 
if((int)me->query("max_force") < 2000 ) 
        return notify_fail("你的内力修为不够！\n"); 
if((int)me->query("force") < 1200 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
int skill,damage,extra,i; 
object weapon=me->query_temp("weapon");
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
skill=me->query_skill("baiyun-sword",1)+me->query_skill("piaoxiang",1);
skill/=100;
if( skill>7) skill=7;
if( skill<2) skill=2;
extra=me->query_skill("baiyun-sword",1)/5;
if(me->query("family/family_name")=="江湖浪子")
extra+=me->query("level")/5;
damage=extra*5;
message_vision(HIC"\n$N脚踏"HIW"「"HIR"血海飘香"HIW"」"HIC"身法，同时使出"HIW"「"HIG"白云剑法"HIW"」"HIC"中的精髓－－"HIW"『"HIB"天外飞仙"HIW"』!\n"HIC"            $N手中的"NOR""+ weapon->name() +""HIC"划出一道长虹，闪电般的击向$n！\n" NOR,me,target);
message_vision(HIY "\n只见$N手中的"NOR""+ weapon->name() +""HIY"剑光一闪，瞬间消失．．．．\n" NOR,me,target);
me->add_temp("apply/attack", extra);
me->add_temp("apply/damage", extra);
for(i=1;i<=skill;i++)
    {
    me->add("force",-50);
    if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
    message_vision(HIY"\n$N身形突转，御剑回飞！\n"NOR,me,target);
    COMBAT_D->do_attack(me,target, me->query_temp("weapon"),1);
    }
me->add_temp("apply/attack", -extra);
me->add_temp("apply/damage", -extra);
if(random(me->query("level"))>(target->query("level"))/2 && me->query("family/family_name") == "江湖浪子" && (int)me->query_skill("baiyun-sword", 1) > 399)
message_vision(HIW "\n$N仿佛看到遥远的天际一颗流星飞来，划过，闪亮，没入自己的身体！\n" NOR,target);
target->receive_damage("kee",damage,me);
target->receive_wound("kee",damage,me);
COMBAT_D->report_status(target,0);
me->start_busy(2);
return 1;
}
int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("baiyun-sword")+" 180 级\n"; 
temp+= "\t\t"+to_chinese("sword")+" 180 级\n"; 
temp+= "\t\t"+to_chinese("piaoxiang")+" 180 级\n"; 
temp+= "\t\t"+to_chinese("dodge")+" 180 级\n"; 
temp+= "\t\t内力上限２０００点\n";  
temp+= "\t\t内力１２００点\n";  
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP  

        使用功效：  
                连续打击对手的气血
        出招类型：  
                busy 型外功 
                有隐藏攻击 
                叛师可带出  
        出手要求：    
HELP);              
write(temp);  
return 1;  
}
