
#include <ansi.h>
inherit PERFORM;

int set_damage()
{
object me=this_player();
int damage;
damage=me->query_skill("baiyun-sword",1);
damage/=10;
return damage;
}

int set_attack()
{
object me=this_player();
int attack;
attack=me->query_skill("piaoxiang",1);
attack/=10;
return attack;
}

void create()
{
set("name",HIW"天外飞仙"NOR);
set("class","human");
set("belong","baiyun-sword");
set("betray_lvl",350);
set("target",1);
set("family","江湖浪子");
set("force",1200);
set("need_force",300);

set("limit_skill",([
"baiyun-sword"  : 180,
"piaoxiang"  : 180,
"sword"  : 180,
"dodge"  : 180,
]));

set("limit_other",([
"max_force"  :  1000,
]));
//set("busy_self",(2+random(2)));
set("busy_self",2);

}


void hit_msg(object me,object target,int num)
{
int skill,damage,attack;
object weapon=me->query_temp("weapon");
if(me&&target&&num==1)
{
skill=me->query_skill("baiyun-sword",1)+me->query_skill("piaoxiang",1);
skill/=80;
damage=set_damage();
attack=set_attack();
if( skill>7) skill=7;
if( skill<2) skill=2;
set("double_hit",([
"num" : skill,
"me_del_env": 1,
"t_del_env" : 1,
"damage" : damage,
"attack" : attack,
]));
message_vision(HIC"\n$N脚踏"HIW"「"HIR"血海飘香"HIW"」"HIC"身法，同时使出"HIW"「"HIG"白云剑法"HIW"」"HIC"中的精髓－－"HIW"『"HIB"天外飞仙"HIW"』!\n"HIC"            $N手中的"NOR""+ weapon->name() +""HIC"划出一道长虹，闪电般的击向$n！\n" NOR,me,target);
message_vision(HIY "\n只见$N手中的"NOR""+ weapon->name() +""HIY"剑光一闪，瞬间消失．．．．\n" NOR,me,target);
}

}

void double_hit_msg(object me,object target,int num)
{
if(me&&target)
message_vision(HIY"\n$N身形突转，御剑回飞！\n"NOR,me,target);
}
int help(object me)  
{
string temp;
temp = "\t\t"+to_chinese("baiyun-sword")+" 180 级\n"; 
temp+= "\t\t"+to_chinese("sword")+" 180 级\n"; 
temp+= "\t\t"+to_chinese("dodge")+" 180 级\n"; 
temp+= "\t\t"+to_chinese("piaoxiang")+" 180 级\n"; 
temp+= "\t\t内力 1200 点\n"; 
write(@HELP 
白云剑法 之 「天外飞仙」： 

        使用功效： 
                连续打击对手的气血
        出招类型：   
                busy型外功  
                无隐藏攻击
                叛师可带出   
        出手要求： 
HELP);  
write(temp);  
return 1;  
}
