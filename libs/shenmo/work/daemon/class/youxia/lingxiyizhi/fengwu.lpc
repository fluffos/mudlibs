
// modify by windy 06/04/26
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 
string name()  
{
return "「"HIR"凤舞九天"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "江湖浪子" && !me->samsara_check("lingxiyizhi", 1))
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("lingxiyizhi", 1) < 150) 
        return notify_fail("你的灵犀一指修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("unarmed", 1) < 150) 
        return notify_fail("你的扑击格斗之技修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("force", 1) < 150) 
        return notify_fail("你的内功心法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("force") < 1000 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
string msg, str;
int extra;
object weapon,ob;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

extra = me->query_skill("lingxiyizhi",1)/2;
extra+=me->query("level")/2;
weapon = me->query_temp("weapon"); 

msg = HIW "$N灵犀一指，浑然之中使出了"HIR"「凤舞九天」"HIW"顿时天地间仿佛出现一只凤凰飞向$n！ 
"HIR"凤                                                                  凤 
      舞                                                      舞 
            九                                          九 
                  天                              天\n" NOR; 
str = HIW "$N灵犀一指，浑然之中使出了"HIR"「凤舞九天」"HIW"顿时天地间仿佛出现一只凤凰飞向$n！\n" NOR;  
if ( !me->query("env/no_msg") && !target->query("env/no_msg") ) 
message_vision(msg, me, target); 
else
message_vision(str, me, target); 
me->add_temp("apply/attack", extra); 
me->add_temp("apply/damage", extra); 
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR); 
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR); 
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR); 
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR); 
me->add_temp("apply/attack", -extra); 
me->add_temp("apply/damage", -extra); 
me->add("force", -400); 
me->start_busy(2+random(2));
return 1; 
}
int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("lingxiyizhi")+" 150 级\n";  
temp+= "\t\t"+to_chinese("unarmed")+" 150 级\n";  
temp+= "\t\t"+to_chinese("force")+" 150 级\n";  
temp+= "\t\t内力１０００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                连续打击对手的气血 
        出招类型：   
                busy 型外功  
                无隐藏攻击  
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
