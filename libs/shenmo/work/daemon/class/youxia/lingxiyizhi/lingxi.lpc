
// modify by windy 06/04/26
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 
string name()  

{
return "「"HIY"灵犀一指"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "江湖浪子" && !me->samsara_check("lingxiyizhi"))
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("lingxiyizhi", 1) < 100) 
        return notify_fail("你的灵犀一指修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("force") < 500 ) 
        return notify_fail("你的内力不足！\n"); 
if( time()-(int)me->query_temp("lingxi_end") < 5+random(5) ) 
        return notify_fail("你现在内息不畅！\n"); 
return 1;  
}

int perform(object me, object target)
{
string msg;
object weapon;
int damage, p;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
weapon = me->query_temp("weapon"); 

msg = HIY "$N双手一前一后，缓缓伸出，中指突地一弹，两道劲风汇成一股，“咝咝”有声，直袭$n前胸。\n"NOR; 
damage = (int)me->query_skill("lingxiyizhi", 1) + (int)me->query_skill("unarmed", 1) + me->query("level");
damage += random(damage / 2);
if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 4)
    {
    msg += HIR"$n躲闪不及，“噗”地一声，被指劲击中前胸！\n"NOR; 
    target->receive_damage("kee", damage,me); 
    target->receive_wound("kee", damage/3,me);
    p = (int)target->query("kee") * 100 / (int)target->query("max_kee"); 
    msg += RED "$n胸口一阵巨痛，大叫倒地！\n" ; 
    }
else if (random(me->query("combat_exp")) > (int)target->query("combat_exp")/2)
    {
msg += HIC"$n向旁边一闪，让过了劲风，没想到这股指劲竟然有回力，从$n背后倒转回来，正刺中$p的后背。\n"NOR;
    target->receive_damage("kee", damage/2,me);
    target->receive_wound("kee", damage/6,me);
    p = (int)target->query("kee") * 100 / (int)target->query("max_kee");
    msg += RED "$n觉的胸口有点痛！\n" ;
    }
else
    {
msg += HIC"$n向旁边一闪，让过了劲风，却忽然发觉这股指劲竟然有回力，匆忙中只好一个前扑才堪堪躲过，模样狼狈之极。\n" NOR;
    }
message_vision(msg, me, target); 
me->add("force", -300);
me->set_temp("lingxi_end",time());
return 1;
}
int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("lingxiyizhi")+" 100 级\n";  
temp+= "\t\t内力５００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                给对手强有力的一击
        出招类型：   
                延时型外功  
                无隐藏攻击  
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
