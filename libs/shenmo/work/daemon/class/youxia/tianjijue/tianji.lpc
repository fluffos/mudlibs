// jushu.c
#include <ansi.h>

inherit SSERVER;

int cast(object me, object target) {
  int success_adj, damage_adj;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展「" HIY "天机咒" NOR "」？\n");
  if (me->query("class") != "human")
    return notify_fail("你是哪儿偷学来的武功?\n");
  if (time() - (int)me->query_temp("tianji_cast") < 3 + random(5))
    return notify_fail(YEL "你的魔法尚未恢复！\n" NOR);
  if ((int)me->query("mana") < 25 + 2 * (int)me->query("mana_factor"))
    return notify_fail(HIR "你的法力不够，施展天机咒！\n");

  if ((int)me->query("sen") < 200)
    return notify_fail(HIR "你无法集中精力，无法施展天机咒！\n");

  me->add("mana", -25 - 2 * (int)me->query("mana_factor"));

  if (random(me->query("max_mana")) < 50) {
    write(HIC "你咒语念错了，没有施展出天机咒！\n");
    return 1;
  }

  SPELL_D->attacking_cast(
    me,
    //attacker 
    target,
    //target
    "both",
    //damage type: could be "qi"/"kee", "shen"/"sen", ...default "both"
    HIY "$N口中喃喃地念著咒文，手中一团紫光渐渐扩大，灵动无比！
只听$N大喝一声“天机咒！”，阵阵咒语声传向$n！\n" NOR,
    //initial message
    HIY "\n$n被震的口吐鲜血，跌倒在地！\n" NOR,
    //success message
    HIY "但是$n好像聋子一样，什么也没有听到似的。\n" NOR,
    //fail message
    HIR "咒文被$n以法力一引，反而传入$N的耳朵里！\n" NOR,
    //backfire initial message
    HIR "\n$n被震的口吐鲜血，跌倒在地！\n" NOR,
    //backfire hit message. note here $N and $n!!!
  );

  if (me->query("family/family_name") != "江湖浪子")
    me->start_busy(1 + random(2));
  me->set_temp("tianji_cast", time());
  return 3 + random(5);
}
