
// modify by windy 06/04/26
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"BLU"攻守兼备"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "江湖浪子" && me->query_skill("mozi-sword", 1) < 400)
        return notify_fail("你还不够资格使用"+name()+"！\n"); 
if ( me->query("family/family_name") != "江湖浪子" && !me->samsara_check("mozi-sword", 1))
        return notify_fail("你还不够资格！\n"); 
if((int)me->query_skill("mozi-sword", 1) < 100) 
        return notify_fail("你的墨子剑法根基太差，难以施展"+name()+"！\n"); 
if((int)me->query("force") < 150 )
        return notify_fail("你的内力不足！\n"); 
if((int)me->query("sen") < 150 )
        return notify_fail("你无法集中精力！\n"); 
return 1;  
}

int perform(object me, object target)
{
string msg; 
int extra, myexp, hisexp; 
object weapon, myweapon; 
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
if (!objectp(myweapon = me->query_temp("weapon")))
        return notify_fail(" 你手中没有兵刃，无法施展"+name()+"。\n");

extra = me->query_skill("mozi-sword",1) ; 
weapon = target->query_temp("weapon");
myexp = (int)me->query("combat_exp"); 
hisexp= (int)target->query("combat_exp"); 

if(random(hisexp) < myexp*2/3 && weapon)
    {
message_vision(BLU "\n$N窥准$n剑势已老,心力未致的瞬间,内力狂吐,登时把$n手中的"NOR""+ weapon->name()+  ""BLU"震得脱手而飞。\n" NOR,me,target);
    weapon->unequip();
    if( weapon->unequip()) weapon->move(environment(target));
    }
else
    {
message_vision(BLU "\n$N使出一式墨子剑法中的"HIW"「攻守兼备」"BLU",手中"+(me->query_temp("weapon"))->name()+  ""BLU"将"NOR"$n"BLU"越缠越紧。
    "HIW"逼的"NOR"$n"HIW"一阵手忙脚乱！\n" NOR, me,target); 
    if(random(hisexp) < myexp*2/3 )
        {
        if(!target->is_busy())
        target->start_busy(2+random(4)); 
        }
    else
        {
        message_vision( HIW "\n$n不为所惑，站了个马步，凝神拆招！\n" NOR, me, target);
        }
    }
me->add("force", -100); 
me->receive_damage("sen", 100); 
me->start_busy(2);
me->improve_skill("force", 1, 1); 
return 1; 
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("mozi-sword")+" 100 级\n"; 
temp+= "\t\t内力１５０点\n";  
temp+= "\t\t精神１５０点\n";  
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP  

        使用功效：  
                打掉敌人的武器或者牵制对手 
        出招类型：   
                busy 型外功   
                无隐藏攻击 
                叛师可带出    
        出手要求：  
HELP);   
write(temp);   
return 1;   
}
