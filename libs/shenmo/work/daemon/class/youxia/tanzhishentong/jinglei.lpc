
// modify by windy 06/04/26
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIC"弹指惊雷"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "江湖浪子" && !me->samsara_check("tanzhishentong", 1))
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("tanzhishentong", 1) < 100) 
        return notify_fail("你的弹指神通修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("force") < 200 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me)
{
string msg;
object weapon, weapon2, target;
int skill, dp, wound;
if ( !valid_perform(me) )
        return 0;
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
target = me->select_opponent();
skill = me->query_skill("tanzhishentong",1);
if ( objectp(weapon = me->query_temp("weapon")))
        return notify_fail("「"HIC"弹指惊雷"NOR"」必须空手使用。\n");
message_vision(HIC"$N使出弹指神通之"HIG"「弹指惊雷」"HIC", 顿时眼内精光暴射，出手攻向$n的全身穴位！\n"NOR,me,target); 
dp = target->query("combat_exp");
if( dp < 1 )
    dp = 1;
if( random(me->query("combat_exp")) > random(dp))
    {
    if(userp(me))
    me->add("force",-150);
message_vision( HIR"$n只觉得眼前一花，气海穴上微微一痛，全身真气狂泄而出！\n"NOR,me,target); 
    weapon = target->query_temp("weapon");
    if(objectp(weapon))
        {
        message_vision(HIR"同时手腕一麻，手中武器脱手而出！\n"NOR,me,target); 
        if (weapon->query("no_get") || weapon->query("no_drop") || weapon->query("warcity")) 
        destruct(weapon); 
        else
        weapon->move(environment(target));
        }
    wound = skill+random(skill);
    if((int)target->query("force") < wound)
    wound = target->query("force");
    target->add("force", -wound);
    target->receive_wound("sen", wound,me);
    target->start_busy(4);
    me->start_busy(1);
    COMBAT_D->report_sen_status(target);
    }
else
    {
message_vision( HIC"可是$n看破了$N的企图，立刻采取守势，$P的「弹指惊雷」没有起到作用。\n"NOR,me,target); 
    me->start_busy(2);
    }
if(!target->is_fighting(me)) target->fight_ob(me);
return 1;
}

int help(object me)  
{
string temp;
temp = "\t\t"+to_chinese("tanzhishentong")+" 100 级\n"; 
temp+= "\t\t内力２００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                牵制敌人
                并伤害敌人的内力和精神
                同时打掉敌人的兵器
        出招类型：   
                busy 型外功  
                无隐藏攻击  
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
