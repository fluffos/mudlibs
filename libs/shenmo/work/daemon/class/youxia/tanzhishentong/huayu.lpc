
// modify by windy 06/04/26
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIM"漫天花雨"NOR"」";  
}

int valid_perform(object me)
{
if( me->query("family/family_name") != "江湖浪子" && me->query_skill("tanzhishentong", 1)<400 )
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if ( me->query("class")!="human" && !me->samsara_check("tanzhishentong"))
        return notify_fail("你还不够资格！\n"); 
if((int)me->query_skill("tanzhishentong", 1) < 120) 
        return notify_fail("你的弹指神通修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("force") < 500 ) 
        return notify_fail("你的内力不足！\n"); 
if( time()-(int)me->query_temp("huayu_end") < 4+random(2) ) 
        return notify_fail("你怀里的暗器光了！\n"); 
return 1;  
}

int perform(object me, object target)
{
string msg;
string desc_msg="";
int sword_level;
string str;
object weapon;
int damage, num, lvl, p;

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
weapon = me->query_temp("weapon"); 
if (weapon && (int)me->query_skill("tanzhishentong", 1) < 666)
        return notify_fail("你的功力不足以带着拳套发出漫天花雨。\n"); 

sword_level=(1+random(10));
desc_msg = chinese_number(sword_level);
if ( sword_level > 9 ) desc_msg = "百";
message_vision(HIC"\n$N手从怀里抓出喑器，使出一招"HIM"「漫天花雨」"HIC"运用指力将暗器漫天地弹了出去！\n"NOR,me,target); 
damage = lvl * 2 + (int)me->query_skill("unarmed", 1);
damage += random(damage / 3);
if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 4)
    {
    msg = HIR"\n$n躲闪不及，“噗噗”地几声，被"+desc_msg+"十多道暗器击中！\n"NOR;
    target->receive_damage("kee", damage, me);
    target->receive_wound("kee", damage / 3,me);
    p = (int)target->query("kee") * 100 / (int)target->query("max_kee");
    msg += RED "\n$n只觉得眼前一花，漫天的暗器打了他一身！\n"NOR;
    }
else
    {
    msg = HIC"$n吓得赶忙抱头团身，万分狼狈地向旁边一滚，方才堪堪地躲了过去。\n" NOR;
    }
message_vision(msg, me, target);
me->add("force", -300);
COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
me->set_temp("huayu_end",time());
return 1;
}

int help(object me)  
{
string temp;
temp = "\t\t"+to_chinese("tanzhishentong")+" 120 级\n"; 
temp+= "\t\t内力５００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                给对手强有力的一击
        出招类型：   
                延时型外功  
                无隐藏攻击  
                叛师可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
