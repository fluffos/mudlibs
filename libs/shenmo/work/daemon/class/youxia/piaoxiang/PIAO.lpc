
// write by windy 06/04/26
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIR"血海飘香"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "江湖浪子" && !me->samsara_check("piaoxiang", 1))
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("piaoxiang", 1) < 100) 
        return notify_fail("你的血海飘香根基太差，难以施展"+name()+"！\n"); 
if((int)me->query_skill("dodge", 1) < 100) 
        return notify_fail("你的基本轻功修为不够，还用不出"+name()+"！\n"); 
if((int)me->query("force") < 100 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
string msg;
int extra,myexp,taexp;
object weapon;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
if(target->is_busy())
        return notify_fail(target->name()+"已经手忙脚乱了！\n");

extra = me->query_skill("piaoxiang",1);
extra/=100;
if (extra>5)  extra=5;
myexp=me->query("combat_exp");
taexp=target->query("combat_exp");
message_vision(HIR"$N脚踏八方，身行如血海之中飘过一丝血腥，飘渺不定！\n"NOR,me,target);
if (random(taexp)<myexp/2)
    {
        message_vision(HIW"结果$N被扰得眼花潦乱，接应不暇！\n"NOR,target);
        target->start_busy(extra);
    }
    else
        {
        message_vision(HIW"可惜$N看破了$n身法之中的玄机，向$n迅然攻击！\n"NOR,target,me);
        COMBAT_D->do_attack(target,me, target->query_temp("weapon"),TYPE_REGULAR,msg);  
        }
return 1;
}
int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("piaoxiang")+" 100 级\n"; 
temp+= "\t\t"+to_chinese("dodge")+" 100 级\n"; 
temp+= "\t\t内力１００点\n";  
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP  

        使用功效：  
                牵制对手
        出招类型：   
                连发型外功  
                无隐藏攻击
                叛师不可带出   
        出手要求： 
HELP);  
write(temp);  
return 1;  
}
