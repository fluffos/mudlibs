//【千羽风灵术】之【飞龙落】

#include <ansi.h>

inherit SSERVER;

int ap,dp,damage;

int cast(object me, object target)
{
       int damage;

	if( !target ) target = offensive_target(me);

	if( !target
	||   !target->is_character()
	||   target->is_corpse()
	||   target==me)
		return notify_fail("你要对谁使用飞龙落？\n");

      if(me->query("family/family_name")!="幻世勇者")
               return notify_fail("非幻世勇者不能使用此项技能！\n");


 /*       if (!target->is_fighting(me))
               return notify_fail("只有在战斗中才能使用飞龙落！\n");
*/
        if((int)me->query("kee") < 100 )
                return notify_fail("你体力不足，无法使用飞龙落！\n");

        if((int)me->query("force") < 100 )
                return notify_fail("你须运足内力才能使用飞龙落！\n");

	if((int)me->query_skill("windspells", 1) < 50 )
		return notify_fail("你的千羽风灵术还不够纯熟。\n");

	if((int)me->query("mana") < 200 )
		return notify_fail("你的法力不足以使用飞龙落！\n");
        
        message_vision(HIY"$N突然伸手朝天一指，\n"+"一根金光闪闪宛若飞龙形状的
巨矛霎时出现在天际，向$n俯冲而下，正是绝招[飞龙落]！\n"NOR, me, target);
        
        //命中率极高，伤害小
        ap=2*(int)me->query_skill("spells");
        dp=(int)target->query_skill("spells")/5+(int)target->query_skill("dodge")/10
                    +(int)target->query_skill("parry")/10;
        damage=random((int)me->query_skill("spells")+me->query("mana_factor"))/2;
		damage=damage*8/10;
        if(damage<100) damage=100;
        if(damage>250) damage=240+random(100);
        if(random(ap)>dp/2)
        {
           target->receive_damage("kee",damage);
           message_vision(HIR"$n哪想得到这一招，在惊惶失措间已被飞龙击中！\n"NOR, me, target);
           COMBAT_D->report_status(target);
        }
        else 
        {
         message_vision(HIC"$n不慌不忙，看准飞龙来势，
往旁边一跃，躲过了攻击！\n"NOR, me, target);
         }
        me->start_busy(1);
        me->add("mana", -50);
        target->kill_ob(me);
        return 2+random(3);
}


