// 作者： tonii@ 缥缈水云间, 2003-4-22于浙大，修改请保留此行。
//【天雷猛袭剑】之必杀技【秋意浓·无想冥杀】

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

void qizhan_ok(object);

int perform(object me, object target) {
  int damage, ap, ap2, dp, dp2, tforce, tmana, mforce, mmana;
  string str;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁使用「秋意浓·无想冥杀」？\n");

  if (me->query("family/family_name") != "幻世勇者")
    return notify_fail("非幻世勇者不能使用此项技能！\n");

  if ((int)me->query_skill("tianlei-sword", 1) < 200)
    return notify_fail("你的天雷猛袭剑火候还不够！\n");

  if ((int)me->query_skill("starforce", 1) < 180)
    return notify_fail("你的辰星灵云壁修为太低！\n");
  if (me->query_skill_mapped("spells") != "windspells")
    return notify_fail("「秋意浓·无想冥杀」必须配合千羽风灵术方可使用！\n");

  if (!target->is_fighting(me))
    return notify_fail("你们没有在打架！\n");
  if (!target->is_killing(me->query("id")))
    return notify_fail("好端端的比武，何必性命相搏？\n");

  if (me->query("force") < 1000)
    return notify_fail("你内力不够，无力作出致命一击！\n");
  if (me->query("kee") < 500)
    return notify_fail("你体力不济，无法作出致命一击！\n");
  if (me->query("sen") < 1000)
    return notify_fail("「秋意浓·无想冥杀」必须提供充足的精神力量支持！\n");

  message_vision(HIY "\n$N一声喟叹，使出天雷猛袭剑的必杀绝技「秋意浓·无想冥杀」，
剑光渐渐化为无形，却掠出一番凉凉的秋意，
落叶飘零、飘零，随风舞蹈，如同大千世界之芸芸众生，
曾经繁花似锦、枝荣叶茂，终归零落成泥碾似土尘。" + HIW "
                                      ◢
                   ●         ╲█◤
                            ◢█◣◣
            ◣                ◤◥
          ◥█╱
          ◢◤█◣ ─┬─  │     ╮
            ◤◥   ─┼─  ││ ╭╯
                   │││╰│╯ ╰╮
            ╰╮   ││    │     ╰╮
              ╰╮ ╯│   ╱╲    ╭╯
                │         ◣     │
                ╰╮     ◥█╱
                  ╯     ◢◤█◣
                           ◤◥    \n" NOR, me, target);
  ap = me->query_skill("sword") / 2;
  ap = ap * ap * ap / 1000;
  ap2 = me->query_skill("spells") / 2;
  ap2 = ap2 * ap2 * ap2 / 1500;
  ap += ap2;
  ap += (int)me->query("combat_exp") / 200;
  dp = target->query_skill("spells") / 2;
  dp = dp * dp * dp / 1000;
  dp2 = target->query_skill("parry") / 2;
  dp2 = dp2 * dp2 * dp2 / 3200;
  dp += dp2;
  dp2 = target->query_skill("dodge") / 2;
  dp2 = dp2 * dp2 * dp2 / 3200;
  dp += dp2;
  dp += (int)target->query("combat_exp") / 400 + (int)target->query("daoxing") / 400;
  if (dp < 1) dp = 1;

  tforce = target->query("force");
  tmana = target->query("mana");
  mforce = me->query("force");
  mmana = me->query("mana");

  if (tforce < 0) tforce = 0;
  if (tmana < 0) tmana = 0;

  //等级相同情况下，命中率为1/2多 
  if (random(ap + dp) > dp) {
    message_vision(HIB "\n$n意随之动，在这萧瑟的秋风中顿感万念俱灰，
不自主地抛弃一切战意，昏昏沉沉地倒下了……\n" NOR, me, target);
    if (userp(target)) {
      target->set("kee", 1);
      target->set("eff_kee", 1);
      target->set("sen", 1);
      target->set("eff_sen", 1);
      target->set("force", 0);
      target->set("mana", 0);  //防止target反PK
      COMBAT_D->report_status(target, 1);
      COMBAT_D->report_sen_status(target, 1);
    } else {
      target->receive_damage("sen", 2 * target->query("sen"), me);
      COMBAT_D->report_sen_status(target);
      if (target->query("sen") < 0) {
        str = target->name() + "被" + me->name() + "用幻世绝招「" + HIC "秋意浓·无想冥杀" NOR + HIM "」所降服。听说" + target->name() + "在这招面前无丝毫抗衡能力！" NOR;
        message("channel:rumor", HIM "【空穴来风】某人：" + str + "\n" NOR, users());
      }
    }
    me->start_busy(5 + random(4));
    target->start_busy(1);  //防止target吸气
  } else {
    message_vision(HIY "\n$n大喝一声，丝毫不为所动，
反而越战越勇，满眼落叶皆被其凌厉攻势所破碎！\n" NOR, me, target);
    me->start_busy(3 + random(4));
  }
  me->add("force", -(tforce / 2 + mforce / 4));
  me->add("mana", -(tmana / 2 + mmana / 4));
  if (me->query("force") < 0)
    me->set("force", 0);
  if (me->query("mana") < 0)
    me->set("mana", 0);
  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }
  return 1;
}
