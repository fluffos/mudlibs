// 作者： tonii@ 缥缈水云间, 2003-4-22于浙大，修改请保留此行。
//【天雷猛袭剑】之【慌雨斩】
//同时伤对方气血和精神

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
 int ap,dp,dp2;
int l;
int lv1;
string msg;
 int i,damage;
 int time,time1,time2;
 object weapon;
 
 if( !target ) target = offensive_target(me);
 if( !target
 || !target->is_character()
 || !me->is_fighting(target) )
 	return notify_fail("慌雨斩只能对战斗中的对手使用。\n");
 if(me->query("family/family_name")!="幻世勇者")
               return notify_fail("非幻世勇者不能使用此项技能！\n");

 weapon = me->query_temp("weapon");
 if( (string)weapon->query("skill_type") != "sword" )
 	return notify_fail("你手中无剑，不能使用慌雨斩\n");
 if( (int)me->query("force") <= 800 )
 	return notify_fail("你内力不够，不能使用慌雨斩！\n");

 time1 =(int)me->query_skill("tianlei-sword",1) / 40;
 if (time1>5) time1=5;
 time2=random(3);
 time=time1+time2;
 ap=me->query_skill("sword");
 ap=ap*ap*ap/1200;
 ap+=(int)me->query("combat_exp")/100;
ap=ap/10;
 dp=(int)target->query_skill("dodge")/2+(int)target->query_skill("parry")/2;
 dp=dp*dp*dp/1200;
 dp+=(int)target->query("combat_exp")/100;
 dp2=target->query_cps();
 dp2=dp2*dp2*dp2/10;
 dp+=dp2;
dp=dp/10;

 for(i=0;i<time;i++)
 {
  //每剑的命中率大约为2/5左右

 message_vision(HIB"剑气四溢，如狂风暴雨般袭来！\n"NOR, me, target);
 if(random((ap+dp)*3)>dp*2)
 {
    message_vision(HIR"$n手足无措，刹时被剑光击中！\n"NOR, me, target);
    damage=50+(int)random(me->query_skill("tianlei-sword",1)/2)
          +(int)(me->query_skill("tianlei-sword",1));
//    damage=damage*8/10;
    target->receive_damage("kee",damage,me,"phy");
    target->receive_wound("kee",random(damage),me);
    target->receive_damage("sen",damage,me,"phy");
    target->receive_wound("sen",random(damage),me);
    COMBAT_D->report_status(target, 0);
    COMBAT_D->report_sen_status(target);
 }
 else 
    message_vision(HIY"$n临危不乱，分辨出剑光来向，将其化解。\n"NOR, me, target);
 }
l = (int)me->query_skill("dodge",1);
if(me->query("skill_level/sword")=="expert")
lv1 = 2;
else if(me->query("skill_level/sword")=="master")
   lv1 = 3;
else if (me->query("skill_level/sword")=="grandmaster")
  lv1 = 4;
if ((l > 100 && lv1 == 2 && random(10) > 4) || wizardp(me))
{
  msg = HIY"$N一声长啸，内力集中于剑身，剑势陡然加快，$n出其不意，被攻了个手忙脚乱..\n"NOR;
  message_vision(msg, me, target);
 target->start_busy(1+random(2));
}
if ((l > 140 && lv1 == 3 && random(10) > 6) || wizardp(me))
{
   msg = HIW"$N身形陀螺般旋转开来，一时平地风声呖呖，$n不得不眯了下眼,\n"NOR;
  msg+= HIC"然后说时迟那时快，$N已经一剑刺至$n的眼前,\n"NOR;
  msg+= HIB"$n只能向后连退数步，身形不由地慢了下来..\n"NOR;
  message_vision(msg, me, target);
  target->start_busy(2+random(2));
}
if ((l > 200 && lv1 == 4 && random(10) > 8) || wizardp(me))
{
  msg = HIR"$N忽感神灵之佑护，丹田之气直冲脑门，$n在撼人的剑雨中忽然目瞪口呆，\n"NOR;
  msg+= HIY"$N得势不饶人，鬼魅般飘到了$n身后，撑起一脚直抵$n后心，\n"NOR;
  msg+= HIW"$n还没有回过神来，已经被摔了个狗吃屎，呆坐在了地上\n"NOR;
  message_vision(msg, me, target);
  target->start_busy(3+random(2));
}
if( !target->is_fighting(me) ) {
  if( living(target) ) {
     if( userp(target) ) target->fight_ob(me);
      else target->kill_ob(me);
  }
}
 me->add("force",-200);
me->add("mana",-100);
me->start_busy(1+random(3));

return 3+random(2);
}

