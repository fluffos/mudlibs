#include <ansi.h>
#include <combat.h>
 
inherit F_DBASE;
inherit SSERVER;
 
void delay_effect(object me, object target, object weapon,int delay);
 
int perform(object me, object target)
{
 int delay,skill,pow;
string wlevel;
        object weapon=me->query_temp("weapon");

         if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招「跳斩」？\n");
        if (!me->is_fighting(target))
          return notify_fail("你们不在打架。\n");
     
                        skill=me->query_skill("ghostaxe",1);        
        if (skill< 120) return notify_fail("你的丧神鬼斧不够纯熟。\n");
        skill=me->query_skill("starforce",1);
        if (skill<120) 
           return notify_fail("你的辰星灵云壁太差劲了。\n"); 
        skill=me->query_skill("dodge",1);
       if (skill<150) 
           return notify_fail("你的轻功也太差劲了，怎么跳的起来啊。\n");    
        if( (int)me->query("force") < 300 )      
                return notify_fail("你的内力不够。\n");
        if( (int)me->query_temp("tiaozhan_delay") )
                return notify_fail("你已经在身在半空了。\n");
        
                                wlevel = me->query("skill_level/axe");
        me->add("force", -200);
                                delay=random(3)+1;
        message_vision(HIW"只见$N暴喝一声，紧抱手中"+weapon->name()+
             HIW"纵身腾空而起，$n不由的一愣！\n"NOR, me,target);
                                skill = me->query_skill("dodge",1)/3-100;
                                me->add_temp("apply/dodge",skill); //轻功不行的话....
    
        me->set_temp("tiaozhan_delay", 1);
                                me->start_busy(delay);


        me->start_call_out( (: call_other, __FILE__, "delay_effect", 
me, target,weapon,delay:), delay);
 
         return 1;
}
 
void delay_effect(object me,object target,object weapon,int delay)
{
        mapping action;
        mapping new_act=([]);
        int attack,damage, pow;
                                string wlevel;
                                 wlevel = me->query("skill_level/axe");
        
        me->delete_temp("tiaozhan_delay");
                if (!target) return;
        if (environment(me)!=environment(target)) return;
        if (me->query_temp("weapon")!=weapon) return;
                if (me->query_skill_mapped("axe") != "ghostaxe") 
                {
                return;
                }
                        if(!wlevel) pow = (delay+1)*(delay+1)/4;
                        else if(wlevel == "expert") pow = (delay+1)*(delay+2)/4;
                        else if(wlevel == "master") pow = (delay+2)*(delay+2)/4;
                        else if(wlevel == "grandmaster") pow = (delay+2)*(delay+2)/3;
                if(me->query_temp("might_set")) pow += pow/2;
                
                message_vision(HIG"但见半空中$N飞身而至，手中"+weapon->name()+
        HIG"向$n当头直劈过去。\n"NOR,me,target);
        message_vision(HIY"$N觉得全身都被漫天的斧影所笼罩，吓的是手足无措心胆俱裂。\n"NOR,target);

                attack=me->query_temp("apply/sub_armor");
                    damage=me->query_temp("apply/damage");
                        
  
        me->add_temp("apply/sub_armor",me->query_skill("ghostaxe",1) *pow/3);
        me->add_temp("apply/damage",damage*pow*2+me->query("force_factor")/13);
        COMBAT_D->do_attack(me, target, weapon,TYPE_QUICK);
                        me->add_temp("apply/dodge",100-me->query_skill("dodge",1)/3); 
                                me->set_temp("apply/sub_armor",attack);
        me->set_temp("apply/damage",damage);
        me->reset_action();
         me->start_busy(1+random(2));
                   if(!target->is_busy())
                                target->start_busy(1);
                        
}


