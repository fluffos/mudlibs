//【丧神鬼斧】之【坏灭咆哮袭】
//粉碎对方的兵器，并造成伤害。

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
	object tweapon;
	int ap,dp,damage;

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招「坏灭咆哮袭」？\n");

        if(!me->is_fighting())
                return notify_fail("「坏灭咆哮袭」只能在战斗中使用！\n");

        if((int)me->query("max_force") < 200 )
                return notify_fail("你的内力不够！\n");

	if((int)me->query("force") < 200 )
		return notify_fail("你的内力不足！\n");

        if((int)me->query("sen") < 200 )
                return notify_fail("你的精神不足，没法子施用外功！\n");

        if((int)me->query_skill("ghostaxe", 1) < 50)
                return notify_fail("你的丧神鬼斧级别还不够，使用这一招会有困难！\n");

message_vision(HIC"\n$N怒吼一声，向着$n作出凶猛一击！\n"NOR, me, target);

       //相同水平，命中率略低于1/2
	ap=(int)me->query_skill("axe");
	ap=ap*ap*ap/10 + (int)me->query("combat_exp");

	dp=(int)target->query_skill("parry");
	dp=dp+(int)target->query_skill("dodge")/10;
	dp=dp*dp*dp/10 + (int)target->query("combat_exp");

       damage=random((int)me->query("max_force")/7)+2*(int)me->query("force_factor");
	   damage=damage*8/10;
if(me->query_temp("might_set")) {ap += ap/2;
damage += damage/2;
}
	if( random( ap+dp ) > dp ) {
		tweapon=target->query_temp("weapon");
		if (tweapon) {
                    tweapon->unequip();
                    tweapon->set("value",0);
                    tweapon->set("no_get",1);
                    message_vision(HIY"$N手中的$n竟然被打成了碎片！\n"NOR, target,tweapon);
                    tweapon->set("name","粉碎的"+tweapon->query("name"));
                    call_out("remove_broken_weapon",random(100)+60,tweapon);
                    tweapon->move(environment(target));
		} 
             target->receive_damage("kee",damage,me,"phy");
             target->receive_wound("kee",damage/2,me);
             message_vision(HIY"$N悴不及防，被强大的冲击力所伤！\n"NOR, target,tweapon);
	      COMBAT_D->report_status(target);
       }
       else {
	 message_vision(HIC"$N早有提防，一闪就躲开了！\n"NOR, target);
	 }

        me->add("force", -150);
	 me->receive_damage("sen", 50);

	 target->kill_ob(me);

        me->start_busy(1+random(3));
        return 1+random(5);
}

void remove_broken_weapon(object weapon)
{
  if(weapon && environment(weapon)) {
    tell_object(environment(weapon),
      "一阵微风吹过，"+weapon->name()+"化为片片尘土，消失不见了。\n");
    destruct(weapon);
  }
}

