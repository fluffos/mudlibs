//【千羽风灵术】之【精神统一】 (powerup)

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount1,int ammount2);

int cast(object me, object target)
{
        int skill;

     //  if(me->query("family/family_name")!="幻世勇者")
       //        return notify_fail("非幻世勇者不能使用此项技能！\n");

        skill = me->query_skill("wanxi-spells",1);
        if( (int)me->query("mana") < skill*2 )     
		return notify_fail("你的法力不够。\n");
        if( (int)me->query_temp("powerup") ) 
		return notify_fail("你已经出于精神高度集中状态了。\n");

        me->add("mana", -skill);
        me->receive_damage("sen", 50);

        message_vision(
                HIR "$N略一凝神，脚步轻盈如御风而行，
精神也转入高度集中状态，攻防明显提高了！\n" NOR, me);

        me->add_temp("apply/attack", skill/6);
        me->add_temp("apply/dodge",skill/4);
        me->set_temp("powerup", 1);

        me->start_call_out( (: call_other, __FILE__, "remove_effect", me, skill/6, skill/4 :), skill/2);

        if( me->is_fighting() ) me->start_busy(3);

        return 3+random(3);
}

void remove_effect(object me, int amount1, int amount2)
{
       if(!me) return;
       me->add_temp("apply/attack", - amount1);
	me->add_temp("apply/dodge", - amount2);
       me->delete_temp("powerup");
       tell_object(me, "你感觉千羽风灵术的提升作用已经慢慢消退了。\n");
}


