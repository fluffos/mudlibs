// kuang.c 噬魂无极

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

#define pf_name "「" HIG "噬魂无极" NOR "」"

int perform(object me, object target) {
  object weapon;
  string msg;
  int count;
  int attack_time, i, busy_time, level;

  me->clean_up_enemy();
  if (!target) target = me->select_opponent();

  if (!me->is_fighting())
    return notify_fail(pf_name "只能对战斗中的对手使用。\n");

  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对！\n");

  if ((int)me->query("neili") < 1000)
    return notify_fail("你的真气不够，无法施展" pf_name "！\n");

  if (me->query_skill_mapped("blade") != "darkblade")
    return notify_fail("必须激发噬魂刀才能施展" pf_name "！\n");


  if ((int)me->query_skill("darkblade", 1) < 300)
    return notify_fail("你的噬魂刀还不到家，无法施展" pf_name "！\n");



  if ((int)me->query_skill("dodge", 1) < 50)
    return notify_fail("你的轻功修为不足，无法施展" pf_name "！\n");

  level = (int)me->query_skill("darkblade", 1);
  if (level < 1) level = 1;
  busy_time = 4;
  attack_time = 8;
  count = level;
  if (level >= 500) {
    busy_time = 3;
    attack_time = 10;
  }
  if (level >= 800) {
    busy_time = 2;
    attack_time = 12;
    count = level * 3;
  }
  if (level >= 1000) {
    busy_time = 1;
    attack_time = 16;
    count = level * 5;
  }
  msg = HIC "$N纵身近前，手中的" + weapon->name() + HIC "斗然弯弯弹出，刀尖直砍$n胸口，出招之快真乃为任何刀法所不及！\n" NOR;
  message_vision(msg, me, target);
  if (attack_time >= 16) {
    msg = HIC "还没来得及反应，「噬魂刀」之「噬魂无极」已砍出四四一十六刀！\n" NOR;
    message_vision(msg, me, target);
  }
  me->add("neili", -150);
  me->add_temp("apply/attack", count * 3);
  me->add_temp("apply/damage", count * 3);
  me->set_temp("no_exp", 1);

  for (i = 0; i < attack_time; i++) {
    if (!me->is_fighting(target))
      break;
    COMBAT_D->do_attack(me, target, weapon, 0);
  }
  me->add_temp("apply/attack", -count * 3);
  me->add_temp("apply/damage", -count * 3);
  me->delete_temp("no_exp");
  me->start_busy(busy_time);
  return 1;
}

int help(object me) {
  write(WHT "\n「噬魂刀」 之 「噬魂无极」" NOR "\n");
  write(@HELP

	第一阶段：
		噬魂刀 300级

		4秒busy、8连

	第二阶段：
		噬魂刀 500级
		3秒busy、10连

	第三阶段：
		噬魂刀 800级
		2秒busy、12连
		
	第四阶段：
		噬魂刀 1000级
		1秒busy、16连
HELP
  );
  return 1;
}
