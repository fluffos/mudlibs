// 作者： tonii@ 缥缈水云间, 2003-4-28于浙大，修改请保留此行。
//【暗黑蚀魂剑】之【虚晃斩】
//busy+attack

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target)
{
     int i,dp2,lv2;
int lv,l,ret;
        int ap,dp;
        string msg;
        object weapon;

        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
        return notify_fail("你要对谁施展这一招「虚晃斩」？\n");
        if(!me->is_fighting())
                return notify_fail("「虚晃斩」只能在战斗中使用！\n");
        if( me->query_skill("darkblade",1) < 50)
               return notify_fail("你的暗黑蚀魂剑等级不够，尚未领会到这个绝招！\n");
        if(me->query("kee")<100)
               return notify_fail("你的体力太差了，不能使用「虚晃斩」！");
        if(me->query("force")<300)
               return notify_fail("你的内力不够，无法发出「虚晃斩」！");
        if(me->query_temp("no_darkblade_xuhuang")>time())
			return notify_fail("「虚晃斩」多用对方就会看穿的！\n");
		me->set_temp("no_darkblade_xuhuang",time()+1);

        weapon=me->query_temp("weapon");
     
        ap=(int)me->query_skill("blade");
 if(ap > 500) ap=ap/10*ap*ap/2+me->query("combat_exp")/2;
 else  ap=ap*ap*ap/1000+me->query("combat_exp")*10;
        dp=(int)target->query_skill("parry")+(int)target->query_skill("dodge")/2;
        dp=dp*dp*dp/5000+target->query("combat_exp")*10;
 ap+=ap*2;
        msg=HIW"「虚晃斩」！\n$N左一剑、右一剑、上一剑、下一剑，连出四剑，却是四招空招！\n\n"NOR;
        message_vision(msg, me, target);
   if(random(4*ap+dp)>dp)
        {
             target->start_busy(0+random(0));
              msg = HIR"$n一愣，$N突然化剑为刀，“唿！”“唿！”连劈四剑！\n"NOR+HIW"       这才是致命的杀招\n" NOR;
              message_vision(msg, me, target);
             for(i=0;i<7;i++)
 COMBAT_D->do_attack(me,target,weapon,TYPE_QUICK);
       me->start_busy(0+random(0));
         }
         else
         {
              msg=HIC"$n异常小心地退后两步，静观$N进一步动作，$N的绝招落空了！\n"NOR;
              message_vision(msg, me, target);
             me->start_busy(0+random(0));
          }
        me->add("force",-100);
 if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }
         return 0+random(0);
}



