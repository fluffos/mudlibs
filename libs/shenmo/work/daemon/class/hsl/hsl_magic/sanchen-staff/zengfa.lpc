//【三辰恒舞杖法】之【三辰增法】
//加spells

#include <ansi.h>

inherit F_DBASE;
inherit SSERVER;

void remove_effect(object me, int spells_amount, int flag);

int perform(object me, object target) {
  int skill_spells, skill_staff, spells_amount, flag;
  string stlvl;

  if (target && target != me)
    return notify_fail("你只能对自己使用「三辰增法」！\n");

  if (me->query("family/family_name") != "幻世魔导")
    return notify_fail("非幻世魔导不能使用此项技能！\n");

  if (me->query_skill("sanchen-staff", 1) < 50)
    return notify_fail("你的三辰恒舞杖法级别不够，无法使用「三辰增法」！\n");
  if (me->query_skill("spells") < 70)
    return notify_fail("你对法术级别还不够，尚未领悟到「三辰增法」！\n");

  if ((int)me->query("force") < 200)
    return notify_fail("你的内力不够，无法使用「三辰增法」！\n");
  if ((int)me->query("kee") < 200)
    return notify_fail("你的体力这么差，还是先休息一会儿吧！\n");
  if ((int)me->query("sen") < 200)
    return notify_fail("你的精神太差，无法使用「三辰增法」！\n");
  if ((int)me->query_temp("zengfa"))
    return notify_fail("你已经处于高魔力状态了！\n");
  stlvl = me->query("skill_level/staff");

  me->receive_damage("kee", 50);
  me->receive_damage("sen", 50);
  me->add("force", -100);
  message_vision(
    HIC "$N面向苍穹念了一句咒语，借助日月星之神力，$N的魔力明显提升了！\n" NOR, me);

  skill_spells = (int)me->query_skill("spells");
  skill_staff = (int)me->query_skill("staff");
  spells_amount = (skill_spells + skill_staff) * (5 + random(4)) / 50;

  // all 200 ,amount ==60--96
  //all 500  ,amount = 150-240
  if (me->query_temp("magic_set")) spells_amount += spells_amount / 2;

  me->add_temp("apply/spells", spells_amount);
  flag = 0;
  if (stlvl) {
    me->add_temp("apply/add_spells_all", spells_amount);
    flag = 1;
  }
  if (stlvl == "master" || stlvl == "grandmaster") {
    me->add_temp("apply/add_max_spells_all", spells_amount * 20);
    flag = 2;

  }
  if (stlvl == "grandmaster") {
    me->add_temp("apply/add_spells_all", spells_amount);
    me->add_temp("apply/add_max_spells_all", spells_amount * 20);
    flag = 3;

  }
  me->set_temp("zengfa", 1);
  me->start_call_out((: call_other, __FILE__, "remove_effect",
    me, spells_amount, flag :), (int)skill_staff / 4);

  return 1;
}

void remove_effect(object me, int spells_amount, int flag) {
  me->add_temp("apply/spells", -spells_amount);
  if (flag == 3) {
    me->add_temp("apply/add_spells_all", -spells_amount);
    me->add_temp("apply/add_max_spells_all", -spells_amount * 20);

  }
  if (flag >= 2)
    me->add_temp("apply/add_max_spells_all", -spells_amount * 20);
  if (flag >= 1)
    me->add_temp("apply/add_spells_all", -spells_amount);
  me->delete_temp("zengfa");
  message_vision(HIY "$N感觉日月星的神力开始在自身上慢慢消退了！\n" NOR, me);
}
