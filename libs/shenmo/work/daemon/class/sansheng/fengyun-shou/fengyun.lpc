
// write by windy 07/06/15
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 
string name()  
{
return "「"HIG"风起云涌"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "三圣宫" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("fengyun-shou", 1) < 250) 
        return notify_fail("你的风云手修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("unarmed", 1) < 250) 
        return notify_fail("你的扑击格斗之技修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("zhenlongqi", 1) < 250) 
        return notify_fail("你的真龙之气修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("force") < 1000 ) 
        return notify_fail("你的内力不足！\n"); 
if((int)me->query_temp("fys_fy") > time() ) 
        return notify_fail("你难以频繁施展"+name()+"！\n"); 
if((int)me->query("max_force") < 2000 ) 
        return notify_fail("你的内力修为太浅，难以施展"+name()+"！\n"); 
return 1;  
}

int perform(object me, object target)
{
string msg;
int extra, lvl, i;
object weapon,ob;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

extra = me->query_skill("fengyun-shou", 1) + me->query_skill("unarmed", 1)/2;
extra += me->query_skill("zhenlongqi", 1);
lvl = extra/200;
if (extra>6)    extra=6;
if (extra<4)    extra=4;
weapon = me->query_temp("weapon"); 

msg = HIC "\n$N"HIC"双臂暴涨，挂定风声，幻出千百只手臂攻向$n"HIC"，正是风云手的绝学"HIG"「风起云涌」"HIC"！\n" NOR;  
message_vision(msg, me, target); 
me->add_temp("apply/attack", extra); 
me->add_temp("apply/damage", extra); 
for (i=0;i<=lvl;i++)
        {
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR); 
        }
me->add_temp("apply/attack", -extra); 
me->add_temp("apply/damage", -extra); 
me->add("force", -500); 
me->set_temp("fys_fy",time()+2+random(3));
//me->start_busy(2+random(2));
return 1; 
}
int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("fengyun-shou")+" 250 级\n";  
temp+= "\t\t"+to_chinese("unarmed")+" 250 级\n";  
temp+= "\t\t"+to_chinese("zhenlongqi")+" 250 级\n";  
temp+= "\t\t内力１０００点\n"; 
temp+= "\t\t内力修为二十年\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                连续打击对手的气血 
        出招类型：   
                延时型外功  
                无隐藏攻击  
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
