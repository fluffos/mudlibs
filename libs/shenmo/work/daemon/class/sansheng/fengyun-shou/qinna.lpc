// write by windy 07/06/15
#include <ansi.h>
inherit SSERVER;
string name() {
  return "「" HIY "擒拿" NOR "」";
}

int valid_perform(object me) {
  if (me->query("family/family_name") != "三圣宫" || me->query("class") != "saint")
    return notify_fail("你不够资格使用" + name() + "！\n");
  if ((int)me->query_skill("fengyun-shou", 1) < 120)
    return notify_fail("你的风云手不够熟练，施展不出" + name() + "! \n");
  if ((int)me->query("force") < 500)
    return notify_fail("你的内力还不够高！\n");
  return 1;
}

int perform(object me, object target) {
  object weapon;
  int skill, ap, dp, damage;

  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用。\n");
  if (target->is_busy())
    return notify_fail("对方已经够忙了。\n");

  ap = me->query_skill("unarmed");
  dp = target->query_skill("parry");
  message_vision(
    HIC "\n$N" HIC "贴上前来，和$n" HIC "近身搏击，只见$N" HIC "的手忽折忽扭，或抓或甩，令人眼花缭乱！\n" NOR,
    me,
    target
  );
  if (ap / 2 + random(ap) > dp / 2) {
    me->add("force", -100);
    damage = 120 + ap / 4 + random(ap / 4);
    message_vision(HIR "\n$n" HIR "奋力抵抗，终究不敌$N" HIR "，连中数招后还是被压制得无法反击！\n" NOR, me, target);
    target->receive_damage("kee", damage, me);
    COMBAT_D->report_status(target, 0);
    target->start_busy(random(3) + 2);
  } else {
    message_vision(CYN "\n可是$n" CYN "的看破了$N" CYN "的招式，巧妙的一一拆解，没露半点破绽！\n" NOR, me, target);
    me->add("force", -50);
    me->start_busy(1 + random(2));
  }

  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("fengyun-shou") + " 120 级\n";
  temp += "\t\t内力５００点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP 

        使用功效：   
                牵制对手并打击对手气血
        出招类型：   
                busy 型外功  
                无隐藏攻击  
                叛师不可带出   
        出手要求：     
HELP);
  write(temp);
  return 1;
}
