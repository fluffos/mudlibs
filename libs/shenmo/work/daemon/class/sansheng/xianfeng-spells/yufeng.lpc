//Cracked by Roath
//
#include <ansi.h>

inherit SSERVER;

int cast(object me, object target)
{
        if( !target ) target = offensive_target(me);

        if( (int)me->query("mana") < 50 )
                return notify_fail("你的法力不够了！\n");

        if( (int)me->query("sen") < 50 )
                return notify_fail("你的精神无法集中！\n");

        if((string)me->query("family/family_name")!="三圣宫" )
                return notify_fail("你试着随风而去，却始终感觉自己太重了！\n");

        message_vision("$N喃喃地念了几句咒语。\n", me);

	me->add("mana", -25);
	me->receive_damage("sen", 20);

	if(me->is_fighting() ) {
 if((random(5)>1 && target->query("spskk")!=4) || me->query("spsk")==8) {
                        message_vision(HIC"$N念了几句咒语，身形渐渐模糊，随清风而去。。。\n"NOR, me);
                        me->move("/d/sansheng/room1");
			tell_room(environment(me),
HIC"一阵清风过后，隐约现出"+me->query("name")+"的身形。\n\n"NOR, ({me, me}) );

		} else {
                        message_vision(HIC"$N转身想跑，却被$n一个箭步拦住。\n"NOR, me, target);
			me->start_busy(2);
		}
	} else {
                message_vision(HIC"$N念了几句咒语，身形渐渐模糊，随清风而去。。。\n"NOR, me);
                me->move("/d/sansheng/room1");
                tell_room(environment(me),
HIC"一阵清风过后，隐约现出"+me->query("name")+"的身形。\n\n"NOR, ({me, me}) );

	}

        return 5+random(5);
}

