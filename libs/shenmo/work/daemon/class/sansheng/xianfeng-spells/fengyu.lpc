
// windy
#include <ansi.h>
inherit SSERVER;

int cast(object me, object target)
{
        int success_adj, damage_adj;
        if(me->query("family/family_name")!="三圣宫" || me->query("class")!="saint")
               return notify_fail("你非三圣宫弟子，不能用「狂风暴雨」！\n");
        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展狂风暴雨？\n");
if( time()-(int)me->query_temp("fengyu_cast") < 3+random(5) ) 
        return notify_fail(YEL"你的魔法尚未恢复！\n"NOR);
        if((int)me->query("mana") < 100+2*(int)me->query("mana_factor") )
                return notify_fail("你的法力不够！\n");
        if((int)me->query("sen") < 100 )
                return notify_fail("你无法集中精力！\n");

        me->add("mana", -25-2*(int)me->query("mana_factor"));
        me->receive_damage("sen", 50);

        if( random(me->query("max_mana")) < 50 ) {
                write("你现在心神不宁。\n");
                return 1;
        }

        SPELL_D->attacking_cast(
                me, 
                        //attacker 
                target, 
                        //target
                "both",          
                        //damage type: could be "qi"/"kee", "shen"/"sen", ...default "both"
                HIB "\n$N"HIB"念了几句咒语，风伯雨师应召而来，二人齐齐施法，刹那间狂风暴雨弥漫天地，将$n"HIB"困在风雨之中！\n" NOR,
                        //initial message
                HIW "\n风雨交加之中，$n"HIW"直被冻得瑟瑟发抖，精气大为受挫！\n" NOR, 
                        //success message
                HIC "$n"HIC"不慌不忙，大喝一声，风伯雨师吓得掉头就跑，转瞬间风止雨歇。\n" NOR, 
                        //fail message
                HIC "谁知$n"HIC"也善于呼风唤雨，默默运转法力，风雨反困住了$N！\n" NOR, 
                        //backfire initial message
                HIW "\n结果$N"HIW"反把自己冻得瑟瑟发抖，精气大为受挫！\n" NOR, 
                        //backfire hit message. note here $N and $n!!!
        );
me->set_temp("fengyu_cast",time()); 
        return 3+random(5);
}
