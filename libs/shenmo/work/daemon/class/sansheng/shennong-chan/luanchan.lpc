
// write by windy 07/06/18
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIC"泼风乱铲"NOR"」";  
}

int valid_perform(object me)
{
if ( (string)me->query("family/family_name")!= "三圣宫" || me->query("class")!="saint") 
        return notify_fail("你不够资格使用"+name()+"。\n"); 
if ( me->query_skill("shennong-chan",1)<150 )
        return notify_fail("你的神农铲法不够纯熟，无法使用"+name()+"。\n"); 
if ( me->query_skill("staff",1)<150 )
        return notify_fail("你的基本杖法不够纯熟，无法使用"+name()+"。\n"); 
if ( me->query("force")<1000 )
        return notify_fail("你现在内力不足，不能使用"+name()+"。\n");
if ( me->query("max_force")<1000 )
        return notify_fail("你的内力修为不够，不能使用"+name()+"。\n");
if (time()-me->query_temp("luanchan_end")<3+random(3))
        return notify_fail("你现在气血翻涌，不能使用"+name()+"。\n");
return 1;
}

int perform(object me, object target)
{
object weapon;
int i, extra;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

extra = me->query_skill("shennong-chan",1)/5;
extra += me->query_skill("zhenlongqi",1)/2;
extra += me->query_skill("xianfeng-spells",1)/2;
weapon = me->query_temp("weapon");

message_vision(HIC"\n$N"HIC"东一铲，西一铲，似给庄稼锄草一般，闪电般向$n"HIC"攻出数铲！\n" NOR, me, target);
me->add_temp("apply/attack", extra);
me->add_temp("apply/damage", extra);
for (i=0;i<=3+random(3);i++)
        {
        COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
        if( me->query_skill_mapped("unarmed")=="fengyun-shou" ) {
            if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
               message_vision(HIY"\n$N"HIY"放下手中的"+weapon->name()+""HIY"，招式一变！\n"NOR,me,target);
            if ( weapon && weapon==me->query_temp("weapon") )  weapon->unequip();
                COMBAT_D->do_attack(me, target);
            if ( weapon && weapon!=me->query_temp("weapon") )  weapon->wield();
        }
        }
me->add_temp("apply/attack", -extra);
me->add_temp("apply/damage", -extra);
me->set_temp("luanchan_end", time());
return 1;  
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("shennong-chan")+" 150 级\n"; 
temp+= "\t\t"+to_chinese("staff")+" 150 级\n"; 
temp+= "\t\t内力修为十年\n"; 
temp+= "\t\t内力１０００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                连续攻击敌人
        出招类型： 
                延时型外功
                有隐藏攻击
                叛师不可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
