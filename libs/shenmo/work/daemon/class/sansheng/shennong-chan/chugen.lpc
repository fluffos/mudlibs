
//writs by windy
#include <ansi.h>
inherit SSERVER;

string name()
{
return "「"HIR"斩草除根"NOR"」";
}

int valid_perform(object me)
{
if ( (string)me->query("family/family_name")!= "三圣宫" || me->query("class")!="saint") 
        return notify_fail("你不够资格使用"+name()+"。\n"); 
if ( me->query_skill("shennong-chan",1)<100 )
        return notify_fail("你的神农铲法不够纯熟，无法使用"+name()+"。\n"); 
if ( me->query_skill("staff",1)<100 )
        return notify_fail("你的基本杖法不够纯熟，无法使用"+name()+"。\n"); 
if ( me->query_skill("xianfeng-spells",1)<100 )
        return notify_fail("你的仙风云体术级别不够，无法使用"+name()+"。\n"); 
if ( me->query("sen")<500 )
        return notify_fail("你现在精神太差，不能使用"+name()+"。\n");
if ( me->query_temp("snc_chg")>time() )
        return notify_fail("你暂时无法使用"+name()+"。\n"); 
if ( me->query("force")<500 )
        return notify_fail("你现在内力不足，不能使用"+name()+"。\n");
return 1;
}

int perform(object me, object target)
{
object weapon;
int damage;

if ( !valid_perform(me) )
        return 0;
if (!objectp(weapon = me->query_temp("weapon"))
|| (string)weapon->query("skill_type") != "staff")
        return notify_fail("你使用的武器不对，无法施展"+name()+"。\n");
if ( !target ) 
        target = offensive_target(me);
if ( !target
  || !target->is_character()
  || target->is_corpse()
  || target==me )
        return notify_fail("你要攻击谁？\n");
if ( !me->is_fighting() )
        return notify_fail(name()+"必须在战斗状态下使用。\n");

message_vision(HIR"\n$N"HIR"怒眼圆睁，用尽全力挥舞手中"+weapon->name()+""HIR"铲向$n"HIR"，毫不留情！\n"NOR,me,target);
damage = me->query_skill("xianfeng-spells"); 
damage+= me->query_skill("shennong-chan"); 
damage+= me->query_skill("staff")/2; 
damage+= me->query("mana_factor");
if (random(me->query("daoxing")/20000+1) > target->query("daoxing")/5)
        {
message_vision(HIR"\n$n"HIR"正诧异间，一个不慎，被铲了个正着！\n"NOR,me,target);
me->receive_damage("sen", 200, target);
me->add("force", -300);
target->receive_damage("kee",damage, me);
target->receive_wound("kee",damage/3, me);
COMBAT_D->report_status(target);
        }
else    {
message_vision(CYN"\n$n"CYN"冷冷一笑，移形换影，躲过了$N"CYN"的这一杀招！\n"NOR,me,target);
me->add("force", -100);
me->receive_damage("sen", 100);
        }
//me->set_temp("snc_chg",time()+2+random(4));
me->start_busy(2+random(2));
return 1;
}

int help(object me)
{
string temp;    
temp = "\t\t"+to_chinese("shennong-chan")+" 100 级\n";
temp+= "\t\t"+to_chinese("staff")+" 100 级\n";
temp+= "\t\t"+to_chinese("xianfeng-spells")+" 100 级\n";
temp+= "\t\t精神 500 点\n";
temp+= "\t\t内力 500 点\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");
write(@HELP

        使用功效：
                伤害敌人的气血
        出招类型：
                busy 型外功
                不可叛师带出
                没有隐藏攻击
        出手要求：              
HELP);                          
write(temp);
return 1;
}
