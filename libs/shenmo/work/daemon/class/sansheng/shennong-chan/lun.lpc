//writs by windy
#include <ansi.h>
inherit SSERVER;

string name() {
  return "「" HIR "破凰天轮" NOR "」";
}

int valid_perform(object me) {
  if ((string)me->query("family/family_name") != "三圣宫" || me->query("class") != "saint")
    return notify_fail("你不够资格使用" + name() + "。\n");
  if (me->query_skill("shennong-chan", 1) < 300)
    return notify_fail("你的神农铲法不够纯熟，无法使用" + name() + "。\n");
  if (me->query_skill("staff", 1) < 300)
    return notify_fail("你的基本杖法不够纯熟，无法使用" + name() + "。\n");
  if (me->query_skill("xianfeng-spells", 1) < 300)
    return notify_fail("你的仙风云体术级别不够，无法使用" + name() + "。\n");
  if (me->query("sen") < 500)
    return notify_fail("你现在精神太差，不能使用" + name() + "。\n");
  if (me->query("force") < 1000)
    return notify_fail("你现在内力不足，不能使用" + name() + "。\n");
  if (me->query("max_force") < 3000)
    return notify_fail("你内力修为太差，不能使用" + name() + "。\n");
  if (me->query("mana") < 1000)
    return notify_fail("你现在法力不足，不能使用" + name() + "。\n");
  return 1;
}

int perform(object me, object target) {
  object weapon;
  int i, damage;
  int ap, dp;

  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用！\n");

  damage = (int)me->query_skill("shennong-chan", 1);
  damage += (int)me->query_skill("staff", 1) / 2;
  damage += (int)me->query_skill("xianfeng-spells", 1);
  ap = (int)me->query("daoxing") / 200000;
  ap += (int)me->query("level") * (int)me->query("level") / 500;
  dp = (int)target->query("daoxing") / 200000;
  dp += (int)target->query("level") * (int)target->query("level") / 500;
  weapon = me->query_temp("weapon");

  message_vision(
    HIR "\n$N" HIR "一声暴喝，手中" + weapon->name() + "" HIR "狂舞，杖影化作无数大圈，宛若风火轮般铺天盖地卷向$n" HIR "！\n" NOR,
    me,
    target
  );
  if (random(ap + dp) > dp) {
    message_vision(HIR "\n$n" HIR "完全看不清招中虚实，只听得「砰砰砰」几声，已被$N" HIR "击中数杖，呕血连连！\n" NOR, me, target);
    for (i = 0; i <= 3 + random(2); i++) {
      target->receive_damage("kee", damage, me);
      target->receive_wound("kee", damage / 3, me);
      COMBAT_D->report_status(target); ;
    }
    me->receive_damage("sen", 300);
    me->add("force", -1000);
    me->add("mana", -1000);
  } else {
    message_vision(CYN "$n" CYN "识得此招厉害，奋力躲闪，跳出了杖影的笼罩，心下胆寒！\n" NOR, me, target);
    me->receive_damage("sen", 200);
    me->add("force", -500);
    me->add("mana", -500);
  }
  me->start_busy(1 + random(2));
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("shennong-chan") + " 300 级\n";
  temp += "\t\t" + to_chinese("staff") + " 300 级\n";
  temp += "\t\t" + to_chinese("xianfeng-spells") + " 300 级\n";
  temp += "\t\t精神５００点\n";
  temp += "\t\t内力１０００点\n";
  temp += "\t\t法力１０００点\n";
  temp += "\t\t内力修为三十年\n";
  write(@HELP;

        使用功效：
                连续伤害敌人的气血
        出招类型：
                busy 型外功
                不可叛师带出
                无隐藏攻击
        出手要求：
HELP);
  write(temp);
  return 1;
}
