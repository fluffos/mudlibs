#include <ansi.h>
inherit F_CLEAN_UP;
void remove_effect(object me, int amount);
int exert(object me, object target) {
  int skill;
  if ((int)me->query("force") < 500)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query("kee") < 150)
    return notify_fail("你的气血不足。\n");
  if ((int)me->query("sen") < 150)
    return notify_fail("你的精神不足。\n");
  if (me->query("family/family_name") != "三圣宫" || me->query("class") != "saint")
    return notify_fail("你不够资格！\n");
  if ((int)me->query_temp("powerup"))
    return notify_fail("你已经在运功中了。\n");
  skill = me->query_skill("zhenlongqi", 1);
  me->add("force", -300);
  me->receive_damage("kee", 135);
  me->receive_damage("sen", 135);
  message_vision(
    HIW "$N" HIW "略一凝神，体内真龙之气运转一小周天，提起全身潜质！\n" NOR, me);
  me->add_temp("apply/armor", skill / 5);
  me->add_temp("apply/attack", skill / 5);
  me->set_temp("powerup", 1);
  me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill / 5 :), skill);
  if (me->is_fighting()) me->start_busy(4);
  return 1;
}
void remove_effect(object me, int amount) {
  me->add_temp("apply/armor", -amount);
  me->add_temp("apply/attack", -amount);
  me->delete_temp("powerup");
  tell_object(me, HIC "你气血渐渐平复，真龙之气归于丹田。\n");
  return;
}
