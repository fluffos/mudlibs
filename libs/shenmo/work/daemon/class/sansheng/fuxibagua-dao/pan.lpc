#include <ansi.h>
inherit SSERVER;
string name()  

{
return "「"HIY"乾龙盘身"NOR"」";
}

int valid_perform(object me)
{
if (me->query("family/family_name")!="三圣宫" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if( (int)me->query_skill("fuxibagua-dao", 1) < 100)
       return notify_fail("你的伏羲八卦刀法不够熟练，施展不出"+name()+"! \n");
return 1;
}

int perform(object me, object target)
{
object weapon;
int myexp, taexp, mylvl, talvl;

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if( !me->is_fighting() )
        return notify_fail(name()+"只能在战斗中使用。\n");
if( target->is_busy() )
        return notify_fail("对方已经够忙了。\n");

myexp = (int)me->query("combat_exp")/200000;
taexp = (int)target->query("combat_exp")/200000;
mylvl = (int)me->query("level");
talvl = (int)target->query("level");
weapon = me->query_temp("weapon");

message_vision(HIY"\n$N"HIY"突然招式一变，手中"NOR""+weapon->name()+""HIY"幻出一道黄芒，恰似一条金龙，绕向$n"HIY"！"NOR,me,target);
if (random(myexp)>taexp/8 && random(mylvl)>talvl/8)
        {
        message_vision(HIW"\n$n"HIW"躲闪不及，被金龙盘个正着，动弹不得！\n"NOR,me,target);
        target->start_busy(random(2) + 3);
        }
else    {
        message_vision(CYN"\n$n"CYN"情知不妙，急忙闪在一旁，黄芒擦身而过！\n"NOR,me,target);
        me->start_busy(2);
        }
        return 1;
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("fuxibagua-dao")+" 100 级\n";  
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                牵制对手
        出招类型：   
                busy 型外功  
                无隐藏攻击  
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
