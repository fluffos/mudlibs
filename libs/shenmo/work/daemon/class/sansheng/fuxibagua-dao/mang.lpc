
// write by windy 07/06/18
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIC"劈天神芒"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "三圣宫" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("fuxibagua-dao", 1) < 300) 
        return notify_fail("你的伏羲八卦刀法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("blade", 1) < 300) 
        return notify_fail("你的基本刀法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("zhenlongqi", 1) < 300) 
        return notify_fail("你的真龙之气修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_temp("fxbg_mang") > time()) 
        return notify_fail("你难以频繁施展"+name()+"！\n"); 
if((int)me->query("max_force") < 3000 ) 
        return notify_fail("你的内力修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("force") < 1000 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
int ap, dp, damage;
object weapon;

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

ap = me->query_skill("blade");
dp = target->query_skill("parry");
damage = (int)me->query_skill("fuxibagua-dao", 1);
damage+= (int)me->query_skill("blade", 1)/2;
damage+= (int)me->query("force_factor");
damage+= (int)me->query("level");
damage-= (int)target->query("force_factor");
weapon = me->query_temp("weapon");
if (damage<1000)    damage = 1000;

message_vision(HIC"\n$N"HIC"脚踏八卦四方之位，陡然一振手中"NOR""+weapon->name()+""HIC"！"NOR,me,target);
message_vision(HIC"\n刀身顿时卷起阵阵雪亮刀芒，将$n"HIC"团团裹住！"NOR,me,target);
if (ap/2 + random(ap) > dp/2)
        {
        message_vision(HIR"\n只听$n"HIR"一声惨叫，一蓬血雨自亮白的刀芒中飞溅而出！\n"NOR,me,target);
        me->add("force", -500);
        target->receive_wound("kee",damage,me);
        target->receive_wound("sen",damage,me);
        target->receive_damage("kee",damage*5+random(damage),me);
        target->receive_damage("sen",damage*5+random(damage),me);
        COMBAT_D->report_status(target,0);
        COMBAT_D->report_sen_status(target,0);
        }
else    {
        message_vision(CYN"\n可是$n"CYN"眼明手快，只听叮叮当当响起了一串刀鸣，$n"CYN"将$N"CYN"的招式全部挡开！\n"NOR,me,target);
        me->add("force", -100);
        }
me->set_temp("fxbg_mang",time()+2+random(3));
//me->start_busy(2);
return 1;
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("fuxibagua-dao")+" 300 级\n";  
temp+= "\t\t"+to_chinese("blade")+" 300 级\n";  
temp+= "\t\t"+to_chinese("zhenlongqi")+" 300 级\n";  
temp+= "\t\t内力１０００点\n"; 
temp+= "\t\t内力修为三十年\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                伤害对手的气血和精神
        出招类型：   
                延时型外功  
                无隐藏攻击  
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
