
// write by windy 07/06/18
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIC"返身一刀"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "三圣宫" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("fuxibagua-dao", 1) < 150) 
        return notify_fail("你的伏羲八卦刀法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("bagua-bufa", 1) < 150) 
        return notify_fail("你的八卦步法太差，难以施展"+name()+"！\n"); 
if (time()-me->query_temp("fuxi_fan") < 2+random(2))
        return notify_fail("绝招用多了就不灵了！\n"); 
return 1;  
}

int perform(object me, object target)
{
int extra, damage;
object weapon;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

extra = me->query_skill("blade");
damage = extra + me->query("force_factor");
damage-= target->query_temp("apply/armor");
if (damage < extra)    damage = extra;
message_vision(HIC"\n$N"HIC"卖了个破绽，虚晃一招败下阵去，可是脚下步法丝毫不乱。"NOR,me,target);
message_vision(HIC"\n$n"HIC"不知有诈，紧紧追赶，不料$N"HIC"突然返身，一刀劈向$n"HIC"的面门！\n"NOR,me,target);
target->receive_wound("kee",damage,me);
target->receive_damage("kee",damage,me);
COMBAT_D->report_status(target,0);
me->set_temp("fuxi_fan",time());
return 1;
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("fuxibagua-dao")+" 150 级\n";  
temp+= "\t\t"+to_chinese("bagua-bufa")+" 150 级\n";  
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                伤害对手气血
        出招类型：   
                延时型外功  
                无隐藏攻击  
                叛师不可带出   
                百分之百命中
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
