
// write by windy 07/06/18
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIW"天刀八式"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "三圣宫" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("fuxibagua-dao", 1) < 400) 
        return notify_fail("你的伏羲八卦刀法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("blade", 1) < 400) 
        return notify_fail("你的基本刀法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("zhenlongqi", 1) < 400) 
        return notify_fail("你的真龙之气修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("bagua-bufa", 1) < 400) 
        return notify_fail("你的八卦步法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("max_force") < 6000 ) 
        return notify_fail("你的内力修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("force") < 2000 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
int i, count, damage;
object weapon;
string dod;

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

count = me->query_skill("fuxibagua-dao", 1) / 4;
count += me->query_skill("zhenlongqi", 1);
weapon = me->query_temp("weapon");
dod = target->query_skill_mapped("dodge");

message_vision(HIW"\n$N"HIW"蓦地一振手中"NOR""+weapon->name()+""HIW"发出万千龙吟，霎时漫天刀光，笼罩$n"HIW"全身！\n"NOR,me,target);
me->add_temp("apply/attack", count);
me->add_temp("apply/damage", count);
target->map_skill("dodge",0); 
for (i = 0; i < 8; i++)
        {
        if (! me->is_fighting(target))
                break;
        me->add_temp("pfm_tiandao", 1);
        COMBAT_D->do_attack(me, target, weapon);
        if( me->query_skill_mapped("unarmed")=="fengyun-shou" ) {
            if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
               message_vision(HIY"\n$N"HIY"放下手中的"+weapon->name()+""HIY"，刀光中风云突变！\n"NOR,me,target);
            if ( weapon && weapon==me->query_temp("weapon") )  weapon->unequip();
                COMBAT_D->do_attack(me, target);
            if ( weapon && weapon!=me->query_temp("weapon") )  weapon->wield();
        }
        }
target->map_skill("dodge",dod); 
me->add_temp("apply/attack", -count);
me->add_temp("apply/damage", -count);
me->delete_temp("pfm_tiandao");
me->start_busy(2);
return 1;
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("fuxibagua-dao")+" 400 级\n";  
temp+= "\t\t"+to_chinese("blade")+" 400 级\n";  
temp+= "\t\t"+to_chinese("zhenlongqi")+" 400 级\n";  
temp+= "\t\t"+to_chinese("bagua-bufa")+" 400 级\n";  
temp+= "\t\t内力修为一甲子\n";  
temp+= "\t\t内力２０００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                连续伤害敌人的气血
        出招类型：   
                busy 型外功  
                有隐藏效果
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
