
// write by windy 07/06/18
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIB"坤龙震背"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "三圣宫" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("fuxibagua-dao", 1) < 120) 
        return notify_fail("你的伏羲八卦刀法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("blade", 1) < 120) 
        return notify_fail("你的基本刀法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("zhenlongqi", 1) < 120) 
        return notify_fail("你的真龙之气修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("max_force") < 1000 ) 
        return notify_fail("你的内力修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("force") < 500 ) 
        return notify_fail("你的内力不足！\n"); 
if (time()-me->query_temp("fuxi_zhen") < 3+random(3))
        return notify_fail("绝招用多了就不灵了！\n"); 
return 1;  
}

int perform(object me, object target)
{
int ap, dp, damage;
object weapon;

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

ap = (int)me->query_skill("force", 1) + (int)me->query("str")*50;
dp = (int)target->query_skill("dodge", 1) + (int)target->query("cor")*50;
damage = (int)me->query_skill("fuxibagua-dao", 1);
damage+= (int)me->query_skill("blade", 1)/2;
damage+= (int)me->query_skill("zhenlongqi", 1);
damage+= (int)me->query_skill("xianfeng-spells", 1);
damage+= (int)me->query("force_factor");
damage-= (int)target->query("force_factor");
weapon = me->query_temp("weapon");
if (damage<500)    damage = 500;

message_vision(HIB"\n$N"HIB"电步移身，倏地转到$n"HIB"背后，用"NOR""+weapon->name()+""HIB"的刀背猛击$n"HIB"的后心！"NOR,me,target);
if (ap/3 + random(ap) > dp/2)
        {
        message_vision(HIR"\n$n"HIR"躲闪不及，刀背正中后心，$n"HIR"一个踉跄，差点栽倒在地！\n"NOR,me,target);
        me->add("force", -500);
        target->receive_wound("kee",damage,me);
        target->receive_damage("kee",damage*5+random(damage),me);
        COMBAT_D->report_status(target,0);
        if (!target->is_busy())
                target->start_busy(1);
        }
else    {
        message_vision(CYN"\n$n"CYN"暗叫不妙，急忙闪身，堪堪躲过了这招，却已是狼狈不堪！\n"NOR,me,target);
        me->add("force", -100);
        }
me->set_temp("fuxi_zhen", time());
return 1;
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("fuxibagua-dao")+" 120 级\n";  
temp+= "\t\t"+to_chinese("blade")+" 120 级\n";  
temp+= "\t\t"+to_chinese("zhenlongqi")+" 120 级\n";  
temp+= "\t\t内力５００点\n"; 
temp+= "\t\t内力修为十年\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                伤害对手气血
        出招类型：   
                延时型外功  
                有隐藏攻击  
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
