#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
        object weapon;
        int j,n,k;

        if(me->query("family/class")!="ling")
                return notify_fail("你所使用的外功中没有这种功能。\n");
                                 
        if( !target ) target = offensive_target(me);

        if( !target
        ||  !target->is_character()
        ||  target->is_corpse()
        ||  target==me)
                return notify_fail("你要对谁施展这一招「连环剑式」？\n");

        if(!me->is_fighting())
                return notify_fail("「连环剑式」只能在战斗中使用！\n");

        if((int)me->query("max_force") < 1000 )
                return notify_fail("你的内力不够！\n");

        if((int)me->query("force") < 1000 )
                return notify_fail("你的内力不足！\n");

        if(me->query("family/family_name")!="灵剑门")
                return notify_fail("你不是灵剑门弟子，不能使用这项技能！\n");

        if((int)me->query("sen") < 500 )
                return notify_fail("你的精神不足，没法子施用外功！\n");

        if((int)me->query_skill("lingjian-shi", 1) < 100)
                return notify_fail("你的灵剑七式级别还不够，使用这一招会有困难！\n");
                
        if((int)me->query_skill("lingjian-step", 1) < 100)
                return notify_fail("你的灵剑步法级别还不够，使用这一招会有困难！\n");

        me->delete("env/brief_message");
        target->delete("env/brief_message");
        j=(int)me->query_skill("lingjian-shi",1)*3+2;
        if(j > (int)me->query_int()*5) j=(int)me->query_int()*2;
        k=(int)me->query_skill("lingjian-shi",1);
        
message_vision(HIW"\n$N身形一晃，剑灵离体而出，虚虚实实向$n连环刺出"+chinese_number(j+random(10))+HIW"道剑影！\n"NOR,me,target);
        me->add_temp("apply/damage",k);        
        for(n=1;n<=j;n++)
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        me->add_temp("apply/damage",-k);

        me->receive_damage("sen", 100);
        me->add("force", -300);

        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }

        me->start_busy(random(2));
        return 1;
}

