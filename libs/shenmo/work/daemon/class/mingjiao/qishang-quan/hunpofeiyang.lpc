#include <ansi.h>
inherit SSERVER;

string name()  
{
return "「"HIR"魂魄飞扬"NOR"」";
}

int valid_perform(object me)
{
if ( me->query("shilian")<1 )
        return notify_fail("你还没有通过试炼塔的考验！\n");
if ( me->query("class")!="human" && !me->samsara_check("qishang-quan",1))
        return notify_fail(name()+"乃是人类不传之秘。\n");

if( (int)me->query("force") < 500 )
	return notify_fail("你的内力还不够高！\n");

if( (int)me->query_skill("unarmed") < 350 )
	return notify_fail("你的拳法还不到家，无法使用魂魄飞扬！\n");
if( (int)me->query_skill("qishang-quan", 1) < 350)
	return notify_fail("你七伤拳的修为不够，不能使用魂魄飞扬! \n");
 if((int) me->query_skill("jiuyang-shengong",1) < 350 && (int) me->query_skill("shenghuo-shengong",1) < 350)
	return notify_fail("你的内功还不够精纯。\n");
if( me->query_skill_mapped("unarmed") != "qishang-quan") 
	return notify_fail("你没有激发七伤拳，无法使用魂魄飞扬！\n");

return 1;
}

int perform(object me, object target)
{
string msg;
object weapon;
int skill, ap, dp, neili_wound, fali_wound, qi_wound, sen_wound;
me->clean_up_enemy();
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if( !me->is_fighting() )
        return notify_fail(name()+"只能在战斗中使用。\n");

skill = me->query_skill("qishang-quan",1);
skill+= me->query_skill("shenghuo-shengong",1)*2;
skill+= me->query_skill("jiuyang-shengong",1);

msg = HIY "$N大喝一声，使出七伤拳的绝技「魂魄飞扬」，双拳势如雷霆，向$n击去。\n"NOR;
message_vision(msg, me, target);
ap = me->query("combat_exp") + skill * 500;
dp = target->query("combat_exp") / 6;
ap/= 10000;
dp/= 10000;
if( dp < 1 )	dp = 1;
//if( ( random(ap*3/4)+(ap/2*(int)me->query_con()) ) >
//    ( (dp*2/5)*target->query_con()) )
// add by bowl 
if( ( random(ap/4*3)+(ap/2*(int)me->query_con()) ) >  ( (dp/5*2)*target->query_con()) )
	{
	me->add("force",-500);
	msg = HIG "$n只觉得胸前一阵剧痛，“哇”的一声喷出一口鲜血！\n"NOR;
        neili_wound = 300 + random(skill)*5;
        if (target->query("莲花") || target->query("任务"))   
                neili_wound = 500;
	if(neili_wound > target->query("force"))
		neili_wound = target->query("force");
        fali_wound = 300 + random(skill)*5;
        if(fali_wound > target->query("mana"))
                fali_wound = target->query("mana");
	qi_wound = (100 + skill*2+random(skill)*2) / 2;
	if(qi_wound > target->query("kee"))
		qi_wound = target->query("kee")+1;
	sen_wound = (100 + skill*2+random(skill)*2) / 2;
	if(sen_wound > target->query("sen"))
		sen_wound = target->query("sen")+1;
        target->add("force", -neili_wound);
             target->set_temp("last_damage_from",me);
		target->receive_wound("kee", qi_wound);
	target->receive_wound("sen",sen_wound);
        target->add("mana", -fali_wound);
	me->start_busy(2);
	}
else	{
	msg = HIG "只见$n不慌不忙，轻轻一闪，躲过了$N的必杀一击！\n"NOR;
	if(userp(me))
		me->add("force",-500);
	me->start_busy(3);
	}
message_vision(msg, me, target);
if(!target->is_fighting(me)) target->fight_ob(me);
return 1;
}
int help(object me)
{
string temp;    
temp = "\t\t"+to_chinese("unarmed")+" 350 级\n";
temp+= "\t\t"+to_chinese("qishang-quan")+" 350 级\n";
temp+= "\t\t"+to_chinese("jiuyang-shengong")+" 320 级\n";
temp+= "\t\t或者"+to_chinese("shenghuo-shengong")+" 350 级\n";
temp+= "\t\t非明教弟子必须通过shilian\n";
temp+= "\t\t内力 500 点\n";
temp+= "\t\t战斗状态下使用\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP

        使用功效：
                同时严重伤害敌人的气血、精神、内力和法力
        出招类型：
                busy型外功
                可叛师带出
                有隐藏效果
        出手要求：              
HELP);  
write(temp);
return 1;
}
