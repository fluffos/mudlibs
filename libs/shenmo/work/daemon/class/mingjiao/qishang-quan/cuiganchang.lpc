#include <ansi.h>
inherit SSERVER;
string name() {
  return "「" HIR "摧肝肠诀" NOR "」";
}

int valid_perform(object me) {
  if ((int)me->query("force") < 700)
    return notify_fail("你的内力还不够高！\n");
  if (me->query("shilian") < 1)
    return notify_fail("你还没有通过试炼塔的考验！\n");
  if (me->query("class") != "human" && !me->samsara_check("qishang-quan", 1))
    return notify_fail(name() + "乃是人类不传之秘。\n");
  if (time() - (int)me->query_temp("qsq_cgc") < 2 + random(4))
    return notify_fail("你现在气血翻涌，不宜连续施功！\n");


  if ((int)me->query_skill(
    "jiuyang-shengong",
    1
  ) < 320 && (int)me->query_skill("shenghuo-shengong", 1) < 350)
    return notify_fail("你的内功还不够精纯。\n");
  if ((int)me->query_skill("unarmed") < 150)
    return notify_fail("你的拳法还不到家，无法体现七伤拳的各种总诀！\n");
  if ((int)me->query_skill("qishang-quan", 1) < 150)
    return notify_fail("你七伤拳的修为不够，不能够体会摧肝肠诀! \n");

  if (me->query_skill_mapped("unarmed") != "qishang-quan")
    return notify_fail("你没有激发七伤拳，无法运用摧肝肠诀！\n");
  return 1;
}

int perform(object me, object target) {
  string msg;
  object weapon;
  int skill, ap, dp, qi_wound;
  me->clean_up_enemy();
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用。\n");

  skill = me->query_skill(
    "qishang-quan",
    1
  ) + me->query_skill("shenghuo-shengong", 1) + me->query_skill("jiuyang-shengong", 1);
  msg = HIY "$N凝神定气，使出七伤拳总诀中的「" HIR "摧肝肠诀" HIY "」，双拳势如雷霆，向$n击去。\n" NOR;
  message_vision(msg, me, target);
  ap = me->query("combat_exp") + skill * 500;
  dp = target->query("combat_exp") / 4;
  if (dp < 1)
    dp = 1;
  if (random(ap) > dp) {
    if (userp(me))
      me->add("force", -200);
    msg = HIG "$n前胸中了$N全力一击，只觉一阵剧痛，“哇”的一声喷出一口鲜血！\n" NOR;
    qi_wound = 500 + random(skill) * 2;
    if (qi_wound > target->query("kee"))
      qi_wound = target->query("kee") + 1;
    target->receive_wound("kee", qi_wound / 2);
  } else {
    msg = HIG "只见$n不慌不忙，轻轻一闪，躲过了$N的必杀一击！\n" NOR;
    if (userp(me))
      me->add("force", -100);
  }
  message_vision(msg, me, target);
  me->set_temp("qsq_cgc", time());
  return 1;
}
int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("unarmed") + " 150 级\n";
  temp += "\t\t" + to_chinese("qishang-quan") + " 150 级\n";
  temp += "\t\t" + to_chinese("jiuyang-shengong") + " 320 级\n";
  temp += "\t\t或者" + to_chinese("shenghuo-shengong") + " 350 级\n";
  temp += "\t\t非明教弟子必须通过shilian\n";
  temp += "\t\t内力 700 点\n";
  temp += "\t\t战斗状态下使用\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                伤害敌人的气血
        出招类型：
                延时型外功
                可叛师带出
                无隐藏效果
        出手要求：              
HELP);
  write(temp);
  return 1;
}
