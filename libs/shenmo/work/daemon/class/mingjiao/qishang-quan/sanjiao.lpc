#include <ansi.h>
inherit SSERVER;
string name() {
  return "「" HIY "三焦齐逆诀" NOR "」";
}

int valid_perform(object me) {
  if ((int)me->query("force") < 2000)
    return notify_fail("你的内力还不够高！\n");
  if ((int)me->query_skill("unarmed") < 210)
    return notify_fail("你的拳法还不到家，无法体现七伤拳的各种总诀！\n");
  if (me->query("shilian") < 1)
    return notify_fail("你还没有通过试炼塔的考验！\n");
  if (me->query("class") != "human" && !me->samsara_check("qishang-quan", 1))
    return notify_fail(name() + "乃是人类不传之秘。\n");


  if ((int)me->query_skill("qishang-quan", 1) < 210)
    return notify_fail("你七伤拳的修为不够，不能够体会三焦齐逆诀! \n");
  if ((int)me->query_skill(
    "jiuyang-shengong",
    1
  ) < 320 && (int)me->query_skill("shenghuo-shengong", 1) < 350)
    return notify_fail("你的内功还不够精纯。\n");
  if (me->query_skill_mapped("unarmed") != "qishang-quan")
    return notify_fail("你没有激发七伤拳，无法运用三焦齐逆诀！\n");
  return 1;
}

int perform(object me, object target) {
  string msg;
  object weapon;
  int skill, ap, dp, neili_wound, qi_wound;
  me->clean_up_enemy();
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用。\n");

  skill = me->query_skill(
    "qishang-quan",
    1
  ) + me->query_skill("shenghuo-shengong", 1) + me->query_skill("jiuyang-shengong", 1);

  msg = HIY "$N凝神定气，企图使出七伤拳总诀中的「" HIR "三焦齐逆诀" HIY "」，将敌方招数反弹！\n" NOR;
  ap = me->query("combat_exp") + skill * 400;
  dp = target->query("combat_exp") / 2;
  if (dp < 1) dp = 1;
  if (random(ap) > dp) {
    if (userp(me))
      me->add("force", -100);
    msg += HIG "$n只觉得胸前一阵剧痛，“哇”的一声喷出一口鲜血！\n" NOR;
    neili_wound = 100 + random(skill) * 2;
    if (neili_wound > target->query("force"))
      neili_wound = target->query("force"); qi_wound = neili_wound / 2;
    if (qi_wound > target->query("kee"))
      qi_wound = target->query("kee") + 1; target->add("force", -neili_wound);
    target->receive_wound("kee", qi_wound);
    me->start_busy(random(3));
  } else {
    msg += HIG "只见$n不慌不忙，轻轻一闪，躲过了$N的必杀一击！\n" NOR;
    if (userp(me))
      me->add("force", -100);
    me->start_busy(2);
  }
  message_vision(msg, me, target);
  if (!target->is_fighting(me)) target->fight_ob(me);
  return 1;
}
int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("unarmed") + " 210 级\n";
  temp += "\t\t" + to_chinese("qishang-quan") + " 210 级\n";
  temp += "\t\t" + to_chinese("jiuyang-shengong") + " 320 级\n";
  temp += "\t\t或者" + to_chinese("shenghuo-shengong") + " 350 级\n";
  temp += "\t\t非明教弟子必须通过shilian\n";
  temp += "\t\t内力 2000 点\n";
  temp += "\t\t战斗状态下使用\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                伤害敌人的气血和内力
        出招类型：
                busy型外功
                可叛师带出
                无隐藏效果
        出手要求：              
HELP);
  write(temp);
  return 1;
}
