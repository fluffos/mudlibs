#include <ansi.h>
inherit SSERVER;
string name() {
  return "「" HIC "意恍惚诀" NOR "」";
}

int valid_perform(object me) {
  if (me->query("shilian") < 1)
    return notify_fail("你还没有通过试炼塔的考验！\n");
  if (me->query("class") != "human" && !me->samsara_check("qishang-quan", 1))
    return notify_fail(name() + "乃是人类不传之秘。\n");

  if ((int)me->query("force") < 1000)
    return notify_fail("你的内力还不够高！\n");

  if ((int)me->query_skill("unarmed") < 250)
    return notify_fail("你的拳法还不到家，无法体现七伤拳的各种总诀！\n");
  if ((int)me->query_skill("qishang-quan", 1) < 250)
    return notify_fail("你七伤拳的修为不够，不能够体会意恍惚诀! \n");
  if ((int)me->query_skill(
    "jiuyang-shengong",
    1
  ) < 320 && (int)me->query_skill("shenghuo-shengong", 1) < 350)
    return notify_fail("你的内功还不够精纯。\n");
  if (me->query_skill_mapped("unarmed") != "qishang-quan")
    return notify_fail("你没有激发七伤拳，无法运用意恍惚诀！\n");
  return 1;
}

int perform(object me, object target) {
  string msg;
  object weapon;
  int skill, ap, dp, time, tt;
  me->clean_up_enemy();
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用。\n");
  if (target->is_busy())
    return notify_fail(target->name() + "已经够忙了.\n");

  skill = me->query_skill("qishang-quan", 1);
  skill += me->query_skill("shenghuo-shengong", 1);
  skill += me->query_skill("jiuyang-shengong", 1);
  time = me->query_skill("qishang-quan", 1);
  time += me->query_skill("shenghuo-shengong", 1) * 2;
  time += me->query_skill("jiuyang-shengong", 1);
  time /= 150;
  tt = (int)target->query_skill("parry", 1) / 150;
  msg = HIY "$N凝神定气，使出七伤拳总诀中的「" HIR "意恍惚诀" HIY "」，双拳势如雷霆，向$n击去。\n" NOR;
  message_vision(msg, me, target);
  ap = me->query("combat_exp");
  dp = target->query("combat_exp") / 2;
  if (dp < 1)
    dp = 1;
  //if( (random(ap*3/4)+ap/2*(int)me->query_con()) > (target->query("combat_exp")*2/5)*(int)target->query_con() )
  //add by bowl 2004.1.16 
  if (to_float(random(ap * 3 / 4) + ap / 2) * to_float((int)me->query_con()) > to_float(dp * 4 / 5) * to_float((int)target->query_con())) {
    if (time > 4) time = 4;  //减少 1 s busy fang@tsrj
    if (time < 2) time = 2;
    if (userp(me))
      me->add("force", -300);
    msg = HIC "结果$N双拳击中时，却是若有若无。\n$n正在奇怪间，已被$N的真气制住，神情恍恍忽忽的！\n" NOR;
    target->start_busy(time);
  } else {
    msg = HIG "只见$n不慌不忙，轻轻一闪，躲过了$N的必杀一击！\n" NOR;
    if (userp(me))
      me->add("force", -100);
    me->start_busy(2);
  }
  message_vision(msg, me, target);
  return 1;
}
int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("unarmed") + " 250 级\n";
  temp += "\t\t" + to_chinese("qishang-quan") + " 250 级\n";
  temp += "\t\t" + to_chinese("jiuyang-shengong") + " 320 级\n";
  temp += "\t\t或者" + to_chinese("shenghuo-shengong") + " 350 级\n";
  temp += "\t\t非明教弟子必须通过shilian\n";
  temp += "\t\t内力 1000 点\n";
  temp += "\t\t战斗状态下使用\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                牵制敌人
        出招类型：
                busy型外功
                可叛师带出
                无隐藏效果
        出手要求：              
HELP);
  write(temp);
  return 1;
}
