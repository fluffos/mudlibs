#include <ansi.h>
inherit SSERVER;
string name() {
  return "「" HIB "伤肺诀" NOR "」";
}

int valid_perform(object me) {
  if (!wizardp(this_player()) && (me->query("family/family_name") != "明教") && me->query("shilian") < 1)
    return notify_fail("你功夫太浅无法使用明教神功。\n");

  if (me->query("class") != "human" && !me->samsara_check(
    "qishang-quan",
    1
  )) return notify_fail(name() + "乃是人类不传之秘。\n");
  if ((int)me->query("force") < 600)
    return notify_fail("你的内力还不够高！\n");
  if ((int)me->query_skill("unarmed") < 100)
    return notify_fail("你的拳法还不到家，无法体现七伤拳的各种总诀！\n");
  if ((int)me->query_skill("qishang-quan", 1) < 100)
    return notify_fail("你七伤拳的修为不够，不能够体会伤肺诀! \n");
  if ((int)me->query_skill(
    "jiuyang-shengong",
    1
  ) < 320 && (int)me->query_skill("shenghuo-shengong", 1) < 350)
    return notify_fail("你的内功还不够精纯。\n");
  if ((int)me->query_skill("jiuyang-shengong", 1) < 320)
    return notify_fail(HIM "你的九阳神功修为不足，不能随便使用伤肺诀! \n" NOR);
  if (me->query_skill_mapped("unarmed") != "qishang-quan")
    return notify_fail("你没有激发七伤拳，无法运用伤肺诀！\n");
  return 1;
}

int perform(object me, object target) {
  string msg;
  object weapon;
  int skill, ap, dp, dodge_decrease;
  me->clean_up_enemy();
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用。\n");

  skill = me->query_skill("qishang-quan", 1) + me->query_skill("jiuyang-shengong", 1);

  msg = HIY "$N凝神定气，使出七伤拳总诀中的「" HIR "伤肺诀" HIY "」，双拳势如雷霆，向$n击去。\n" NOR;
  message_vision(msg, me, target);
  ap = me->query("combat_exp") + skill * 500;
  dp = target->query("combat_exp") / 4;
  if (dp < 1)
    dp = 1;
  if (random(ap) > dp) {
    if (userp(me))
      me->add("force", -100);
    msg = HIG "$N的拳风隐含风雷，“澎”的一声打在$n身上！\n$n只觉得呼吸不顺，顿时脚步慢了许多！\n" NOR;
    dodge_decrease = (int)target->query("apply/dodge") / 10;
    target->add_temp("apply/damage", -dodge_decrease);
    target->start_busy(2);
    me->start_busy(random(3));
  } else {
    msg = HIG "只见$n不慌不忙，轻轻一闪，躲过了$N的必杀一击！\n" NOR;
    if (userp(me))
      me->add("force", -100);
    me->start_busy(2);
  }
  message_vision(msg, me, target);
  return 1;
}
int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("unarmed") + " 100 级\n";
  temp += "\t\t" + to_chinese("qishang-quan") + " 120 级\n";
  temp += "\t\t" + to_chinese("jiuyang-shengong") + " 320 级\n";
  temp += "\t\t或者" + to_chinese("shenghuo-shengong") + " 350 级\n";
  temp += "\t\t非明教弟子必须通过shilian\n";
  temp += "\t\t内力 600 点\n";
  temp += "\t\t战斗状态下使用\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                降低敌人的攻击
        出招类型：
                busy型外功
                可叛师带出
                无隐藏效果
        出手要求：              
HELP);
  write(temp);
  return 1;
}
