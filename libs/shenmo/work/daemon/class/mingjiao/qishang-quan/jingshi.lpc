#include <ansi.h>
inherit SSERVER;
string name()  
{
return "「"HIG"精失诀"NOR"」";
}

int valid_perform(object me)
{
        if( (int)me->query("force") < 900 )
                return notify_fail("你的内力还不够高！\n");
if ( me->query("shilian")<1 )
        return notify_fail("你还没有通过试炼塔的考验！\n");
if ( me->query("class")!="human" && !me->samsara_check("qishang-quan",1))
        return notify_fail(name()+"乃是人类不传之秘。\n");


       if( (int)me->query_skill("unarmed") < 280 )
               return notify_fail("你的拳法还不到家，无法体现七伤拳的各种总诀！\n");
 if((int) me->query_skill("jiuyang-shengong",1) < 320 && (int) me->query_skill("shenghuo-shengong",1) < 350)
                return notify_fail("你的内功还不够精纯。\n");
        if( (int)me->query_skill("qishang-quan", 1) < 280)
                return notify_fail("你七伤拳的修为不够，不能够体会"+name()+"! \n");
        
        if( me->query_skill_mapped("unarmed") != "qishang-quan")
                return notify_fail("你没有激发七伤拳，无法运用精失诀！\n");
return 1;
}

int perform(object me, object target)
{
        string msg;
        object weapon;
        int skill, ap, dp, jing_wound, eff_jing_wound, neili_wound;
        me->clean_up_enemy();
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
        if( !me->is_fighting() )
                return notify_fail(name()+"只能在战斗中使用。\n");

       skill = me->query_skill("qishang-quan",1) + me->query_skill("shenghuo-shengong",1) *2 +me->query_skill("jiuyang-shengong",1);
        msg = HIY "$N凝神定气，使出七伤拳总诀中的「" HIR "精失诀" HIY "」，双拳势如雷霆，向$n击去。\n"NOR;
        message_vision(msg, me, target);
        ap = me->query("combat_exp");
        dp = target->query("combat_exp") / 4;
if (random(ap)>dp || random(me->query("level"))>target->query("level")/2)
        {
                if(userp(me))
                        me->add("force",-200);
                msg = HIG "$N的拳只是轻轻的碰到了$n，但$N的真气趁这一瞬间已流入了$n体内！\n$n只觉得有点疲惫。。。\n"NOR;
                jing_wound = (int)skill*4/5+random((int)skill/2);
                eff_jing_wound = random((int)skill*2) ;
                if(jing_wound > target->query("sen"))
			jing_wound = target->query("sen")+1;	
                target->receive_wound("sen", jing_wound);
                target->receive_damage("sen", jing_wound);
                me->start_busy(1+random(2));
        }
        else
        {
                msg = HIG "只见$n不慌不忙，轻轻一闪，躲过了$N的必杀一击！\n"NOR;
               if(userp(me))
                        me->add("force",-100);
                me->start_busy(2);
        }
       message_vision(msg, me, target);
        return 1;
}
int help(object me)
{
string temp;    
temp = "\t\t"+to_chinese("unarmed")+" 280 级\n";
temp+= "\t\t"+to_chinese("qishang-quan")+" 280 级\n";
temp+= "\t\t"+to_chinese("jiuyang-shengong")+" 320 级\n";
temp+= "\t\t或者"+to_chinese("shenghuo-shengong")+" 350 级\n";
temp+= "\t\t非明教弟子必须通过shilian\n";
temp+= "\t\t内力 900 点\n";
temp+= "\t\t战斗状态下使用\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP

        使用功效：
                伤害敌人的精神
        出招类型：
                busy型外功
                可叛师带出
                无隐藏效果
        出手要求：              
HELP);  
write(temp);
return 1;
}
