
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name()
{
return "「"HIR"损心诀"NOR"」";
}

int valid_perform(object me)
{
if ( !me )   return 0;
if ( me->query("shilian")<1 )
        return notify_fail("你还没有通过试炼塔的考验！\n");
if ( me->query("class")!="human" && !me->samsara_check("qishang-quan",1) && me->query("spskkk")!=6)
        return notify_fail(name()+"乃是人类不传之秘。\n");
if ( me->query_skill("qishang-quan",1)<100 )
        return notify_fail("你的"+to_chinese("qishang-quan")+"等级不足 100 级，不能施展"+name()+"。\n");
if ( me->query_skill("qiankun-danuoyi",1)<100 && me->query("spskkk")!=6)
        return notify_fail("你的"+to_chinese("qiankun-danuoyi")+"等级不足 100 级，不能施展"+name()+"。\n");
if ( me->query("max_force")<500 )
        return notify_fail("你的内力修为不足五年，不能施展"+name()+"。\n");
if ( me->query("force")<100 )
        return notify_fail("你的内力不足 100 点，不能施展"+name()+"。\n");   
if ( me->query("sen")<100 )
        return notify_fail("你的精神不足 100 点，不能施展"+name()+"。\n");   
if ( time()<me->query_temp("sunxin_end")+2+random(5) )
        return notify_fail("绝招用多就不灵了。\n");     
return 1;
}       

int perform(object me, object target)
{
object weapon;
string msg;
int ap,dp,skill,time;
weapon = me->query_temp("weapon");

if ( !valid_perform(me) )
        return 0;
if ( !target ) 
        target = offensive_target(me);
if ( !target
  || !target->is_character()
  || target->is_corpse()
  || target==me )
        return notify_fail("你要对谁施展"+name()+"？\n");
if ( !me->is_fighting() )
        return notify_fail(name()+"只能在战斗中使用！\n");

if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
        msg = HIY"
$N"HIY"凝神定气，使出七伤拳总诀中的「" HIR "损心诀" HIY "」，双拳势如雷霆，向$n"HIY"击去。\n"NOR; 
else    msg = HIY"$N"HIY"对$n"HIY"使出了"+name()+HIY"！\n"NOR;
message_vision(msg,me,target);
me->receive_damage("sen",80,target);
ap = COMBAT_D->skill_power(me,"unarmed",1);
dp = COMBAT_D->skill_power(target,"parry",1);
dp+= COMBAT_D->skill_power(target,"dodge",1);
dp/= 3;
if ( COMBAT_D->restrain(me,target) )
        ap+= ap/3;
if ( COMBAT_D->restrain(target,me) )
        dp+= dp/3;
skill = (int)me->query_skill("qiankun-danuoyi", 1);
if (me->query("spskkk")==6)
        skill+= (int)me->query_skill("spells", 1)/2;
if (target->query("任务"))
time = skill/50;
else
time = skill/20;
if ( time<3 ) time = 3;
if ( time>60 ) time = 60;
if ( wizardp(me) ) tell_object(me,"time===="+time+"\n");
me->set_temp("sunxin_end",time()+time/2);

if (random(ap)>random(dp) || wizardp(me) || (random(ap)>dp/10 && me->query("spskkk")==6))
        {
        target->set_temp("no_exert",([
                "start" : time(),
                "time"  : time,
                "msg"   : HIY"你被"+me->name()+"的一式"+name()+HIY"封住了内功气门。。。。"NOR,
        ]));
        if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
                message_vision(HIR "$N连环拳势如风雷，$n"HIR"中了$N开山裂石的一拳，顿时心神大震！\n"NOR,me,target);
        me->add("force",-100);  
        }                       
else    {
        message_vision(HIG "只见$n"HIG"不慌不忙，轻轻一闪，躲过了$N的全力一击！\n"NOR,me,target);                    
        me->add("force",-50);   
        }       
return 1;
}

   
int help(object me)  
{
string temp;
temp = "\t\t"+to_chinese("qiankun-danuoyi")+" 100 级\n"; 
temp+= "\t\t"+to_chinese("qishang-quan")+" 100 级\n"; 
temp+= "\t\t非明教弟子必须通过shilian\n"; 
temp+= "\t\t内    力 200 点\n"; 
temp+= "\t\t内力修为 五 年\n"; 
temp+= "\t\t精    神 100 点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");
write(@HELP 
        使用功效： 
                封住对方的内功气门
        出招类型：   
                延迟型外功  
                无隐藏攻击
                叛师可带出   
        出手要求： 
HELP);  
write(temp);  
return 1;  
}
