#include <ansi.h>
inherit SSERVER;

string name()  
{
return "「"HIC"藏离诀"NOR"」";  
}
int valid_perform(object me)
{
if ( !wizardp(this_player()) && (me->query("family/family_name") != "明教") &&  me->query("shilian")< 1 )
                return notify_fail("你功夫太浅无法使用明教神功。\n");
if ( me->query("class")!="human" && !me->samsara_check("qishang-quan",1)) return notify_fail(name()+"乃是人类不传之秘。\n");


 if((int) me->query_skill("jiuyang-shengong",1) < 320 && (int) me->query_skill("shenghuo-shengong",1) < 350)
                return notify_fail("你的内功还不够精纯。\n");
        if( (int)me->query("force") < 800 )
                return notify_fail("你的内力还不够高！\n");
if( (int)me->query_skill("unarmed") < 120 )
                return notify_fail("你的拳法还不到家，无法体现七伤拳的各种总诀！\n");
        if( (int)me->query_skill("qishang-quan", 1) < 120)                return notify_fail("你七伤拳的修为不够，不能够体会"+name()+"! \n");
return 1;
}

int perform(object me, object target)
{
        object weapon;
        int mypot,tapot,damage,damage_pot;
        weapon = me->query_temp("weapon");
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
              if(!me->is_fighting())
                return notify_fail("你们没有在打架！\n");

	mypot=(int)me->query_skill("unarmed");
	mypot=mypot*mypot*mypot/10 + random( (int)me->query("combat_exp"));
        tapot=((int)target->query_skill("dodge")+(int)target->query_skill("parry"))/2;
        tapot=tapot*tapot*tapot/10 + random( (int)target->query("combat_exp"));      
        
        damage_pot=(int)me->query_skill("qishang-quan");           
                  
        me->delete("env/brief_message");
	target->delete("env/brief_message");
	message_vision(HIY "$N凝神定气，使出七伤拳总诀中的「" HIR "藏离诀" HIY "」，双拳势如雷霆，向$n击去。\n"NOR,me,target);
	
	
	if ( random( mypot + tapot ) > tapot )	
	{     	
     	message_vision(HIG "$n被$N拳风扫中，只觉全身真气失却驾驭，往外急泻！\n"NOR,me,target);
          
          damage=damage_pot+random(damage_pot)*2; 
              
          
	    target->add("force",-damage);
            if ((int)target->query("force")<0)
             {
             	target->set("force",0);
		message_vision(HIR"$n已经内力尽失！\n"NOR);
	     }
	
	     target->add("mana",-damage);
	     
	     if ((int)target->query("mana")<0)
	     {
	     	target->set("mana",0);
	     	message_vision(HIR"$n法力尽失！\n"NOR);
	     }
           	
           	me->add("force", -random(damage/2));  
           	me->add("mana",-random(damage/2));
           	me->receive_damage("sen", 100);
           	           	         
           	if ((int)me->query("force")<0) me->set("force",0);
	
        }
        
        else 
     	message_vision(HIG "只见$n不慌不忙，轻轻一闪，躲过了$N的必杀一击！\n"NOR,me,target);
        
           if( !target->is_fighting(me) )
            {
                if( living(target) ) 
                {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
            }
        me->start_busy(1+random(1));
        return 1;
}

   
int help(object me)
{
string temp;    
temp = "\t\t"+to_chinese("unarmed")+" 120 级\n";
temp+= "\t\t"+to_chinese("qishang-quan")+" 120 级\n";
temp+= "\t\t"+to_chinese("jiuyang-shengong")+" 320 级\n";
temp+= "\t\t或者"+to_chinese("shenghuo-shengong")+" 350 级\n";
temp+= "\t\t非明教弟子必须通过shilian\n";
temp+= "\t\t内力 800 点\n";
temp+= "\t\t战斗状态下使用\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP

        使用功效：
                伤害敌人的内力和法力
        出招类型：
                busy型外功
                可叛师带出
                有隐藏效果
        出手要求：              
HELP);  
write(temp);
return 1;
}
