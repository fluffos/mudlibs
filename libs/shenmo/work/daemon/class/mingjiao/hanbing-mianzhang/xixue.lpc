#include <ansi.h>
inherit SSERVER;
string name() {
  return "「" CYN "吸血青蝠" NOR "」";
}

int valid_perform(object me) {
  if (me->query_skill("hanbing-mianzhang", 1) < 60)
    return notify_fail("你的「寒冰绵掌」等级不够, 不能使用" + name() + "！\n");
  if ((me->query("family/family_name") != "明教") && (me->query("class") != "human" || me->query("shilian") < 1) && !me->samsara_check(
    "hanbing-mianzhang",
    1
  ))
    return notify_fail("你功夫太浅无法使用明教神功。\n");
  if (me->query("kee") >= me->query("max_kee") * 10)
    return notify_fail("你现在气血饱满，再吸的话肚子就要爆了！\n");

  if (me->query_skill("dodge", 1) < 150)
    return notify_fail("你的轻功不够，无法运用" + name() + "！\n");
  return 1;
}

int perform(object me, object target) {
  string msg;
  object weapon;
  int skill, ap, dp, neili_wound, qi_wound;
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!(me->is_fighting()))
    return notify_fail(name() + "只能对战斗中的对手使用。\n");
  if (objectp(weapon = me->query_temp("weapon")))
    return notify_fail("你使用了武器。\n");

  skill = me->query_skill("hanbing-mianzhang", 1);
  msg = HIC "$N突然如同「吸血青蝠」，欺近$n的身前，张嘴便向$n的咽喉咬去。\n" NOR;
  message_vision(msg, me, target);
  ap = me->query("combat_exp") + skill * 400;
  dp = target->query("combat_exp") / 2;
  if (dp < 1) dp = 1;
  if (random(ap) > dp) {
    if (userp(me))
      me->add("force", -500);
    msg = HIR "$n" HIR "只觉得咽喉一阵剧痛，$N正在狂吸$n" HIR "的鲜血！\n" NOR;
    qi_wound = 500 + random(skill);
    if (qi_wound > target->query("kee"))
      qi_wound = target->query("kee") + 1;
    target->receive_wound("kee", qi_wound, me);
    me->add("kee", qi_wound / 2);
    me->start_busy(1 + random(2));
    if ((int)me->query_skill("unarmed") > 300 && target->query("spskk") != 10)
      target->apply_condition("bp_poison", 5 + random(5) + target->query_condition("bp_poison"));
  } else {
    msg = HIG "只见$n不慌不忙，轻轻一闪，躲过了$N的利齿！\n" NOR;
    if (userp(me))
      me->add("force", -500);
    me->start_busy(2);
  }
  message_vision(msg, me, target);
  return 1;
}
int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("hanbing-mianzhang") + " 60 级\n";
  temp += "\t\t" + to_chinese("dodge") + " 150 级\n";
  temp += "\t\t非明教弟子必须通过shilian\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                吸取敌人的气血化为已有
        出招类型：
                busy型外功
                可叛师带出
                有隐藏效果
        出手要求：              
HELP);
  write(temp);
  return 1;
}
