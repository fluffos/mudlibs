#include <ansi.h>
inherit SSERVER;
string name() {
  return "「" HIY "牧野鹰扬" NOR "」";
}

int valid_perform(object me) {
  if (!wizardp(this_player()) && (me->query("family/family_name") != "明教") && me->query("shilian") < 1)
    return notify_fail("你功夫太浅无法使用明教神功。\n");
  if (me->query("class") != "human" && !me->samsara_check("sougu", 1))
    return notify_fail(name() + "乃是人类不传之秘。\n");

  if ((int)me->query("force") < 500)
    return notify_fail("你的内力还不够高！\n");
  if ((int)me->query_skill("unarmed") < 150)
    return notify_fail("你的拳法等级不够！\n");
  if ((int)me->query_skill("sougu", 1) < 120)
    return notify_fail("你的搜骨鹰爪功修为不够! \n");
  if ((int)me->query_skill("jiuyang-shengong", 1) < 120)
    return notify_fail(HIW "你的九阳神功修为不足，不能随便使用白眉鹰王的成名绝技! \n" NOR);
  return 1;
}

int perform(object me, object target) {
  string msg;
  object weapon;
  int skill, ap, dp, time;
  me->clean_up_enemy();
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用。\n");
  if (target->is_busy())
    return notify_fail(target->name() + "已经够忙了.\n");

  skill = me->query_skill("qishang-quan", 1) + me->query_skill("sougu", 1);
  time = ((int)me->query_skill("sougu", 1) + me->query_skill("jiuyang-shengong", 1)) / 20;
  msg = HIY "$N使出搜骨鹰爪功绝技「牧野鹰扬」，双爪蓦地抓向$n的全身要穴。\n" NOR;
  message_vision(msg, me, target);
  ap = me->query("combat_exp") + skill * 500;
  dp = target->query("combat_exp") / 4;
  if (dp < 1)
    dp = 1;
  if (((random(me->query("combat_exp")) * 3 / 4 + (me->query("combat_exp") / 2) > (int)target->query("combat_exp") / 2))) {
    if (time > 4) time = 4;
    if (time < 1) time = 1;
    if (userp(me))
      me->add("force", -100);
    msg = HIY "结果$p被$P点中要穴，立时动弹不得！\n" NOR;
    target->start_busy(time);
  } else {
    msg = HIG "可是$p看破了$P的企图，并没有上当！\n" NOR;
    if (userp(me))
      me->add("force", -100);
    me->start_busy(2);
  }
  message_vision(msg, me, target);
  return 1;
}
int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("sougu") + " 120 级\n";
  temp += "\t\t" + to_chinese("jiuyang-shengong") + " 120 级\n";
  temp += "\t\t" + to_chinese("unarmed") + " 150 级\n";
  temp += "\t\t非明教弟子必须通过shilian\n";
  temp += "\t\t内力 500 点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                牵制敌人
        出招类型：
                busy型外功
                可叛师带出
                无隐藏效果
        出手要求：              
HELP);
  write(temp);
  return 1;
}
