#include <ansi.h>
inherit SSERVER;
string name()  
{
return "「"HIY"金花夺命"NOR"」";
}

int valid_perform(object me)
{
        if( (int)me->query("force") < 700 )
                return notify_fail("你的内力还不够高！\n");
if ( !wizardp(this_player()) && (me->query("family/family_name") != "明教") && (me->query("class") != "human" || me->query("shilian")< 1 ) && !me->samsara_check("duoming-jinhua",1) )
                return notify_fail("你功夫太浅无法使用明教神功。\n");

        if( (int)me->query_skill("throwing") < 120 )
                return notify_fail("你的暗器功夫还不到家！\n");
        if( (int)me->query_skill("duoming-jinhua", 1) < 90)
                return notify_fail("你的暗器功夫修为不够!! \n");
        if( (int)me->query_skill("jiuyang-shengong", 1) < 90)
                return notify_fail( "你的九阳神功修为不足! \n" );
       
return 1;
}

int perform(object me, object target)
{
        string msg;
        object weapon;
        int skill, ap, dp, qi_wound;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
        if( !me->is_fighting() )
               return notify_fail(name()+"只能在战斗中使用。\n");

        skill = me->query_skill("duoming-jinhua",1) + me->query_skill("jiuyang-shengong",1);
       msg = HBBLU "$N双手挥动。一式「" HIR "金花夺命" HIY "」向$n击去，漫天的暗器出现在$n周围。\n"NOR;
        message_vision(msg, me, target);
        ap = me->query("combat_exp") + skill * 500;
       dp = target->query("combat_exp") / 4;
        if( dp < 1 )
      dp = 1;
       if( random(ap) > dp )
       {
               if(userp(me))
                        me->add("force",-200);
                msg = HIR "$n被$N发出的暗器所伤，只觉得浑身难受！\n"NOR;
               qi_wound = 500 + random(skill)*2;
                if(qi_wound > target->query("kee"))
                        qi_wound = target->query("kee")+1;
                target->receive_wound("kee", qi_wound, me);
                me->start_busy(1+random(2));
       }
        else
       {
              msg = HIC "只见$n不慌不忙，轻轻一闪，躲过了$N的必杀一击！\n"NOR;
                if(userp(me))
                        me->add("force",-100);
                me->start_busy(2);
        }
       message_vision(msg, me, target);
        return 1;
}
int help(object me)
{
string temp;
temp = "\t\t"+to_chinese("duoming-jinhua")+" 90 级\n";
temp+= "\t\t"+to_chinese("throwing")+" 120 级\n";
temp+= "\t\t"+to_chinese("jiuyang-shengong")+" 90 级\n";
temp+= "\t\t非明教弟子必须通过shilian\n";
temp+= "\t\t内力 700 点\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP

        使用功效：
                给敌人的气血强有力的一击
        出招类型：
                busy型外功
                可叛师带出
                无隐藏效果
        出手要求：              
HELP);  
write(temp);
return 1;
}
