#include <ansi.h>
#include <combat.h>
inherit SSERVER;
string name()  
{
return "「"HIG"敛心令"NOR"」";
}

int valid_perform(object me)
{
if ( !wizardp(this_player()) && (me->query("family/family_name") != "明教") &&  me->query("shilian")< 1 )
                return notify_fail("你功夫太浅无法使用明教神功。\n");

        if (me->query_skill("shenghuo-ling", 1) < 250)
                return notify_fail("你的圣火令法等级不够, 不能使用圣火令法之"+name()+"。\n");
        if (me->query("max_force") < 3000 )
                return notify_fail("你的内力修为不足，不能使用圣火令法之"+name()+"。\n");
if ( me->query("class")!="human" && !me->samsara_check("shenghuo-ling",1))
        return notify_fail(name()+"乃是人类不传之秘。\n");
        if (me->query("force") < 500 )
                return notify_fail("你的内力不够，不能使用圣火令法之"+name()+"。\n");
        if (me->query_skill_mapped("sword") != "shenghuo-ling") 
              return notify_fail("你没有激发圣火令法，不能使用圣火令法之"+name()+"。\n");
return 1;
}

int perform(object me, object target)
{
        string msg;
        object weapon;
        int skill, ap, dp, damage;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");

weapon=me->query_temp("weapon");
        msg = HIW "$N" HIW "一个筋斗猛翻至$n" HIW "跟前，陡然使出圣火"
              "令法之敛心令，手中" + weapon->name() + NOR + HIW "忽伸"
              "忽缩，招式诡异无比。\n" NOR;
        skill = me->query_skill("shenghuo-ling", 1);
        damage = skill / 2 + random(skill);
        ap = me->query_skill("sword");
        dp = target->query_skill("parry");
        if (ap / 2 + random(ap) > dp)
        {
                me->add("force", -300);
                me->start_busy(2);
                msg += HIR "$n" HIR "只见眼前寒光颤动，突"
              "然$N" HIR "双手出现在自己眼前，两处太阳穴顿"
              "时一阵剧痛。\n" NOR;
                       
                target->receive_damage("sen", damage / 2, me);
                target->receive_wound("sen", damage / 4, me);
                target->start_busy(1);
                message_vision(msg, me, target); 
        }
        else
        {
                me->add("force", -100);
                msg += CYN "$n" CYN "见眼前寒光颤动，连忙振作精神勉强"
                     "抵挡，向后疾退数步，好不容易闪在了$N" CYN "攻"
                      "击范围之外。\n" NOR;
                me->start_busy(3);
                message_vision(msg, me, target); 
        }
        return 1;
}
int help(object me)
{
string temp;
temp = "\t\t"+to_chinese("shenghuo-ling")+" 250 级\n";
temp+= "\t\t非明教弟子必须通过shilian\n";
temp+= "\t\t最大内力 1500 点\n";
temp+= "\t\t内力 500 点\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP

        使用功效：
                给敌人的精神强有力的一击
        出招类型：
                busy型外功
                可叛师带出
                无隐藏效果
        出手要求：              
HELP);  
write(temp);
return 1;
}
