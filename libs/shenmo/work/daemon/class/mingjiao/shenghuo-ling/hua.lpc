
// write by windy 06/04/26
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIW"光华令"NOR"」";  
}

int valid_perform(object me)
{
if ( me->query("shilian")<1 )
        return notify_fail("你还没有通过试炼塔的考验！\n");
if ( me->query("class")!="human" && !me->samsara_check("shenghuo-ling",1))
        return notify_fail(name()+"乃是人类不传之秘。\n");
if (me->query("max_force") < 1500) 
        return notify_fail("你的内力修为不够！\n"); 
if (me->query("force") < 500) 
        return notify_fail("你的内力不足！\n"); 
if((int)me->query_skill("shenghuo-ling", 1) < 140) 
        return notify_fail("你的圣火令修为不够，还用不出"+name()+"！\n"); 
return 1;  
}

int perform(object me, object target)
{
object weapon; 
int damage, skill, ap, dp; 
string msg; 
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
if ( time()<target->query_temp("no_move/start")+target->query_temp("no_move/time") )
        return notify_fail(target->query("name")+"已经处于你的光华照耀之下难以脱身！\n");  

ap = me->query_skill("sword") + me->query_skill("force"); 
dp = target->query_skill("parry") + target->query_skill("force"); 
weapon=me->query_temp("weapon");
msg = HIY "$N" HIY "猛吸一口气，使出圣火令法之「" HIW "光华令" HIY "」，手中" 
+ weapon->name() + NOR + HIY "御驾如飞，幻出无数道金芒，将$n" HIY "笼罩起来！\n" NOR; 

if (ap+ random(dp) > dp) 
    {
    msg +=  HIW "$n被刺目的光华照得睁不开眼睛！\n" NOR;
    skill = me->query_skill("shenghuo-ling",1);
    skill=skill/10;
    if (skill>10)  skill=10;
    if (skill<5)  skill=5;
    target->set_temp("no_move/start",time());
    target->set_temp("no_move/time",skill);
    call_out("free", skill, target);
    }
else  {
    msg +=  HIR "$n一声长啸，纵身跳出$N的光华笼罩之内！\n" NOR;   
    me->start_busy(2+random(2));  
    }
message_vision(msg, me, target);
return 1;
}

void free(object target)
{
        if (target)
        target->delete_temp("no_move");      
        return;
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("shenghuo-ling")+" 140 级\n"; 
temp+= "\t\t非明教弟子必须通过shilian\n"; 
temp+= "\t\t最大内力 1500 点\n"; 
temp+= "\t\t内力 150 点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP  

        使用功效：  
                使敌人不能移动
        出招类型：  
                busy 型外功 
                无隐藏攻击 
                叛师可带出  
        出手要求：    
HELP);              
write(temp);  
return 1;  
}
