#include <ansi.h>
inherit SSERVER;
string name()  
{
return "「"HIM"吸焰令"NOR"」";  
}

int valid_perform(object me)
{
if ( me->query("shilian")<1 )
        return notify_fail("你还没有通过试炼塔的考验！\n");
if ( me->query("class")!="human" && !me->samsara_check("shenghuo-ling",1))
        return notify_fail(name()+"乃是人类不传之秘。\n");

        if (me->query_skill("shenghuo-ling", 1) < 200)
               return notify_fail("你的圣火令法等级不够, 不能使用圣火令法之"+name()+"。\n");
        if (me->query("max_force") < 1500)
                return notify_fail("你的内力修为不足，不能使用圣火令法之"+name()+"。\n");
        if (me->query("force") < 300)
                return notify_fail("你的真气不够，不能使用圣火令法之"+name()+"。\n");
return 1;  
}

int perform(object me, object target)
{
        string msg;
        object weapon, weapon2;
        int skill, ap, dp;
        if (! target)
        {
                me->clean_up_enemy();
                target = me->select_opponent();
        }
if ( !valid_perform(me) )
        return 0;
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
          if (! objectp(weapon2 = target->query_temp("weapon")))
                return notify_fail("对方没有使用兵器，不能使用圣火令法之"+name()+"。\n");
        if (! objectp(weapon = me->query_temp("weapon")) ||
            weapon->query("skill_type") != "sword")
                return notify_fail("你使用的兵器不对，不能使用圣火令法之"+name()+"。\n");

        msg = HIM "突然$N" HIM "诡异的一笑，使出圣火令法之吸焰"
              "令，手中" + weapon->name() + HIM "幻出数个小圈"
              "，将$n" HIM "的" + weapon2->name() + HIM "紧紧"
             "缠住。\n" NOR;
        ap = me->query_skill("sword");
        dp = target->query_skill("parry");
        if (ap + random(ap / 2) > dp)
        {
                me->add("force", -240);
               msg += HIM "$n" HIM "只见眼前无数寒光颤跃闪动，顿时只感"
                      "头晕目眩，手腕一麻，手中" + weapon2->name() + HIM
                      "已被$N" HIM "纳入怀中！\n" NOR;
                me->start_busy(2);
                if (weapon2->query("no_get") || weapon2->query("no_drop") || weapon2->query("warcity")) 
                destruct(weapon2); 
                else
                weapon2->move(me);
        } else
        {
                me->add("force", -100);
               msg += CYN "可是$n" CYN "看破$N" CYN "的企图，将手中兵"
                     "刃挥舞得密不透风，使得$N" CYN "无从下手。\n" NOR;
                me->start_busy(3);
        }
        message_vision(msg, me, target);
        return 1;
}
int help(object me)
{
string temp;
temp = "\t\t"+to_chinese("shenghuo-ling")+" 200 级\n";
temp+= "\t\t非明教弟子必须通过shilian\n";
temp+= "\t\t最大内力 1500 点\n";
temp+= "\t\t内力 300 点\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP

        使用功效：
                夺取敌人的武器
        出招类型：
                busy型外功
                可叛师带出
                无隐藏效果
        出手要求：              
HELP);  
write(temp);
return 1;
}
