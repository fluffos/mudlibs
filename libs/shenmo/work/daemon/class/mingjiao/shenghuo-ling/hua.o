#include <ansi.h>
#include <combat.h>
#define GUANG "「" HIY "光华令" NOR "」"
inherit SSERVER;
int perform(object me, object target)
{
        object weapon;
        int damage, skill, ap, dp;
        string msg;
                if (! target) target = offensive_target(me);
        skill = me->query_skill("shenghuo-ling",1);
        if (! (me->is_fighting()))
               return notify_fail(GUANG "只能对战斗中的对手使用。\n");        if (! objectp(weapon = me->query_temp("weapon")) ||
           (string)weapon->query("skill_type") != "sword")
               return notify_fail("你使用的兵器不对，不能使用圣火令法之" GUANG "。\n");
        if (skill < 140)
               return notify_fail("你的圣火令法等级不够, 不能使用圣火令法之" GUANG "。\n");
if ( !wizardp(this_player()) && (me->query("family/family_name") != "明教") &&  me->query("shilian")< 1 )
                return notify_fail("你功夫太浅无法使用明教神功。\n");


        if (me->query("max_force") < 1500)
                return notify_fail("你的内力修为不足，不能使用圣火令法之" GUANG "。\n");
        if (me->query("force") < 500)
               return notify_fail("你的内力不够，不能使用圣火令法之" GUANG "。\n");
        if (! living(target))
                return notify_fail("对方都已经这样了，用不着这么费力吧？\n");
        msg = HIY "$N" HIY "猛吸一口气，使出圣火令法之「" HIW "光华令" HIY "」，手中"
              + weapon->name() + NOR + HIY "御驾如飞，幻出无数道金"
              "芒，将$n" HIY "笼罩起来！\n" NOR;
        ap = me->query_skill("sword") + me->query_skill("force");
        dp = target->query_skill("parry") + target->query_skill("force");
        if (ap / 2 + random(ap) > dp)
        {
                damage = ap + random(ap / 2);
                me->add("force", -300);
                msg +=   COMBAT_D->do_attack(me, target, weapon, 0,
                       HIR "$n" HIR "只觉万道金芒铺天盖地席卷而来，"
                       "完全无法阻挡。顿时只感全身几处刺痛，鲜血飞"
                       "溅而出！\n" NOR);
                me->start_busy(1+random(2));
        } else
        {
                msg += CYN "可是$n" CYN "看准$N" CYN "的破绽，猛地向"
                       "前一跃，跳出了$N" CYN "的攻击范围。\n"NOR;
                me->add("force", -150);
                me->start_busy(2);
        }
        message_vision(msg, me, target);
        return 1;
}
int help(object me)
{
string temp;
temp = "\t\t"+to_chinese("shenghuo-ling")+" 140 级\n";
temp+= "\t\t非明教弟子必须通过shilian\n";
temp+= "\t\t最大内力 1500 点\n";
temp+= "\t\t内力 150 点\n";
write(@HELP
圣火令  之 「光华令」

        使用功效：
                给敌人的气血强有力的一击
        出招类型：
                busy型外功
                可叛师带出
                无隐藏效果
        出手要求：              
HELP);  
write(temp);
return 1;
}
