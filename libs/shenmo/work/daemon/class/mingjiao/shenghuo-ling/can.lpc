#include <ansi.h>
#include <combat.h>
inherit SSERVER;
string name()  
{
return "「"RED"残血令"NOR"」";  
}

int valid_perform(object me)
{
        if (me->query_skill("shenghuo-ling", 1) < 220)
                return notify_fail("你的圣火令法等级不够, 不能使用圣火令"
                                   "法之"+name()+"。\n");
if( time()-(int)me->query_temp("can_end") < 4+random(2) ) 
            return notify_fail("你现在气血翻涌，恐怕难以继续施展"+name()+"！\n"); 
if ( me->query("shilian")<1 )
        return notify_fail("你还没有通过试炼塔的考验！\n");
if ( me->query("class")!="human" && !me->samsara_check("shenghuo-ling",1))
        return notify_fail(name()+"乃是人类不传之秘。\n");


        if (me->query_skill("force") < 150)
                return notify_fail("你的内功火候不够，不能使用圣火令法之"
                                   +name()+"。\n");
        if (me->query("max_force") < 3000)
               return notify_fail("你的内力修为不足，不能使用圣火令法之"
                                   +name()+"。\n");
       if (me->query("force") < 400)
                return notify_fail("你的内力不够，不能使用圣火令法之"+name()+"。\n");
        if (me->query_skill_mapped("sword") != "shenghuo-ling")
               return notify_fail("你没有激发圣火令法，无法使用"+name()+"。\n");
return 1;  
}

int perform(object me, object target)
{
        object weapon;
        string msg;
        int count;
        int damage, skill;
        int i;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
        if (! (me->is_fighting()))
                return notify_fail(name()+"只能对战斗中的对手使用。\n");

        skill = me->query_skill("shenghuo-ling", 1);
        weapon = me->query_temp("weapon");

        msg = HIR "$N" HIR "一声长啸，手中" + weapon->name() +
              HIR "一转，招数顿时变得诡异无比，从意想不到的方"
              "位攻向$n" HIR "！\n" NOR;
      if (random(me->query_skill("sword")) > target->query_skill("parry") / 3)
        {
                msg += HIR "$n" HIR "完全无法看透$N" HIR "招中虚实，不由得心"
                       "生惧意，招式一滞，登时破绽百出。\n" NOR;
                count = me->query_skill("shenghuo-ling", 1) / 6;
                me->add_temp("shenghuo-ling/max_hit", 1);
        } else
        {
                msg += HIY "$n" HIY "见$N" HIY "来势汹涌，心底一惊，打起精"
                       "神小心接招。\n" NOR;
               count = 0;
        }
        message_vision(msg, me, target);
       me->add("force", -400);
        me->add_temp("apply/attack", count);
        for (i = 0; i < 7; i++)
        {
                if (! me->is_fighting(target))
                        break;
                if (random(3) == 1 && ! target->is_busy())
                        target->start_busy(1);
                COMBAT_D->do_attack(me, target, weapon, 0);
        }
        me->add_temp("apply/attack", -count);
       me->delete_temp("shenghuo-ling/max_hit");
me->set_temp("can_end",time());
       return 1;
}
int help(object me)
{
string temp;
temp = "\t\t"+to_chinese("force")+" 150 级\n";
temp+= "\t\t"+to_chinese("shenghuo-ling")+" 220 级\n";
temp+= "\t\t非明教弟子必须通过shilian\n";
temp+= "\t\t最大内力 3000 点\n";
temp+= "\t\t内力 400 点\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP

        使用功效：
                连续打击敌人的气血
        出招类型：
                延时型外功
                可叛师带出
                有隐藏效果
        出手要求：              
HELP);  
write(temp);
return 1;
}
