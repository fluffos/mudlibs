// yin.c 阴风刀
#include <ansi.h>
inherit SSERVER;
string name() {
  return "「" HIB "阴风刀" NOR "」";
}

int valid_perform(object me) {
  if (me->query_skill("jiuyang-shengong", 1) < 120)
    return notify_fail("你的九阳神功等级不够, 不能使用" + name() + "！\n");
  if (me->query("shilian") < 1)
    return notify_fail("你还没有通过试炼塔的考验！\n");
  if (me->query("class") != "human" && !me->samsara_check("shenghuo-ling", 1))
    return notify_fail(name() + "乃是人类不传之秘。\n");

  if (me->query_skill("shenghuo-ling", 1) < 120)
    return notify_fail("你的圣火令法等级不够, 不能使用" + name() + "！\n");
  if (me->query("force") < 500)
    return notify_fail("你的内力不够，无法运用" + name() + "！\n");
  return 1;
}

int perform(object me, object target) {
  string msg;
  object weapon;
  int skill, ap, dp, neili_wound, qi_wound, shen_wound;
  me->clean_up_enemy();
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能对战斗中的对手使用。\n");

  skill = me->query_skill("shenghuo-ling", 1);
  weapon = me->query_temp("weapon");
  msg = HIB
    "$N双手晃动，" + weapon->name() + HIB "闪动不止，突然架到$n" HIB "的身上，而$N的劲力也在不经意中传到$n" HIB "体内。\n" NOR;
  message_vision(msg, me, target);
  ap = me->query_skill("sword") + skill;
  dp = target->query_skill("force") / 2;
  if (dp < 1) dp = 1;
  if (random(ap) > dp) {
    if (userp(me))
      me->add("force", -100);
    msg = HIR "$n" HIR "顿时觉得眼前双耳嗡嗡内鸣，内心气血沸腾，两眼一黑，一股鲜血狂喷而出！\n" NOR;
    qi_wound = (int)me->query_skill(
      "shenghuo-shengong",
      1
    ) * 2 + (int)me->query_skill("shenghuo-ling", 1) + (int)me->query_skill("sword", 1) / 2;
    qi_wound = qi_wound * 2 + random(qi_wound) / 2;
    if (qi_wound > target->query("kee"))
      qi_wound = target->query("kee") + 1;
    target->receive_damage("kee", qi_wound, me);
    target->receive_wound("kee", qi_wound, me);
    me->start_busy(random(3));
  } else {
    if (userp(me))
      me->add("force", -200);
    msg = HIW "可是$n" HIW "宁心静气，随手挥洒，将$N的招数撇在一边。\n" NOR;
    me->start_busy(2);
  }
  message_vision(msg, me, target);
  if (!target->is_fighting(me)) target->fight_ob(me);
  return 1;
}
int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("shenghuo-ling") + " 120 级\n";
  temp += "\t\t" + to_chinese("jiuyang-shengong") + " 120 级\n";
  temp += "\t\t非明教弟子必须通过shilian\n";
  temp += "\t\t内力 500 点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                给敌人的气血强有力的一击
        出招类型：
                busy型外功
                可叛师带出
                有隐藏效果
        出手要求：              
HELP);
  write(temp);
  return 1;
}
