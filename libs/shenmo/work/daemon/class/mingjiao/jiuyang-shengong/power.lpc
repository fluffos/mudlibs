
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

void remove_effect(object me)
{
    if(me && me->query_temp("powerup")){
      me->add_temp("apply/damage", -(int)me->query_skill("jiuyang-shengong", 1)/4);
      me->add_temp("apply/armor", -(int)me->query_skill("jiuyang-shengong", 1)/3);
      me->delete_temp("powerup");
      tell_object(me,HIW"你的「九阳神功」运功完毕，将内力收回丹田。\n"NOR);
      }
}
void check_fight(object me)
{
    if (!me) return;

    if (me->query_skill_mapped("force"!="jiuyang-shengong") ||
        !me->is_fighting() || me->query("force") < 10
        ) {
        	remove_call_out("remove_effect"); 
                remove_effect(me);
                }
    else call_out("check_fight", 1, me);
}

int exert(object me)
{

      int i, z;

      if( !me->is_fighting() )
          return notify_fail("「九阳神功」只能在战斗中对对手使用。\n");

      if( (int)me->query("force") < 800 || (int)me->query("max_force")<1200  ) 
                return notify_fail("你的内力不够。\n");
if ( (me->query("family/family_name") != "明教") && (me->query("class") != "human" || me->query("shilian")< 1 ) && !me->samsara_check("jiuyang-shengong",1) && me->query("spskk")!=12 )
		return notify_fail("你不是明教教众不能使用九阳神功。\n");
      if( (int)me->query_temp("powerup") ) 
                return notify_fail("你已经在运功中了。\n");

      i = (int)me->query_skill("jiuyang-shengong", 1)/4;
      z = (int)me->query_skill("jiuyang-shengong", 1)/3;
      me->add("force", -500);

      message_vision(HIR "$N微一凝神，运起九阳神功，全身骨节发出一阵爆豆般的声响, 将全身潜能尽数提起。ⅵ\n" NOR, me);
      me->add_temp("apply/damage", i);
      me->add_temp("apply/armor", z);
      me->set_temp("powerup", 1);
      check_fight(me);
      call_out("remove_effect", z, me);
      return 1;
}

