#include <ansi.h>
inherit SSERVER;
void npc_attack(object invoker, object target, string npc, object where);
int cast(object me, object target)
{
	string msg;
string npc_dir = "/d/mingjiao/npc/";
	object where;
	if( !target ) target = offensive_target(me);
	if( !target
	||   !target->is_character()
	||   target->is_corpse()
	||   target==me)
		return notify_fail("你想布阵揍谁？\n");
        if(me->query("family/family_name")!="明教" && !me->samsara_check("qiankun-danuoyi",1) )
		return notify_fail("你又不是明教弟子。\n");	if((int)me->query_skill("qiankun-danuoyi", 1) < 150)
	    	return notify_fail("你的乾坤大挪移修为不深。\n");
		if((int)me->query("mana") < 800 )
		return notify_fail("你的法力不够。\n");
        if (!target->is_fighting(me))
               return notify_fail("只有在战斗中才能启动光明圣火阵！\n");
	if((int)me->query("sen") < 10 )
		return notify_fail("你现在神智不清，不被人揍已是万幸了！\n");
	me->add("mana", -500);
	me->receive_damage("sen", 10);
        if( random(me->query("max_mana")) < 50 || (int)target->query("spsk")==9)
	{
		write("咦？这一次好像不灵。\n");
		return 1;
	}
	msg = HIR "$N为难之中猛然想到了明教的光明圣火阵！\n"+
	       "$N大叫一声，明教弟子有难，光明圣火阵！ \n"+
	       "速来相助!一时间，四大法王和逍遥二使出现\n"+
	       "$N一指$n：help me kill！call die $n\n\n" NOR;	
	message_vision(msg, me, target);
	//msg = HIW "$n对着$N高声骂道：好家伙，一拥而上了，我宰了你！\n" NOR;	
	//message_vision(msg, me, target);
	target->kill_ob(me);
	where=environment(target);
call_out("npc_attack", 2, me, target, npc_dir+"yintianzheng1", where);
call_out("npc_attack", 3, me, target, npc_dir+"weiyixiao1", where);
call_out("npc_attack", 5, me, target, npc_dir+"yangxiao1", where);
call_out("npc_attack", 6, me, target, npc_dir+"fanyao1", where);	call_out("npc_attack", 8, me, target, npc_dir+"jinhua1", where);	call_out("npc_attack", 9, me, target, npc_dir+"xiexun1", where);
//        me->start_busy(2+random(2));
	return 30+random(30);
}
void npc_attack(object invoker, object target, string npc, object where)
{
	object attacker;
	int rd;
	string tid;
	if(!invoker || !target) return;
	if( environment(invoker) != environment(target) ) return;
	if( environment(target) != where) return;
	seteuid(getuid());
	attacker = new(npc);
	attacker->move(environment(invoker));
if( (int)target->query("daoxing")+(int)target->query("combat_exp") < 10000 )
	{
		tid = (string)target->query("id");
		rd = random(7);
		if( rd == 0 ) attacker->command_function("maoli " + tid);
		else if( rd == 1 ) attacker->command_function("kick " + tid);
		else if( rd == 2 ) attacker->command_function("noescape " + tid);
		else if( rd == 3 ) attacker->command_function("slogan " + tid);
		else if( rd == 4 ) attacker->command_function("hit " + tid);
		else if( rd == 5 ) attacker->command_function("hammer " + tid);
		else attacker->command_function("nip " + tid);
	}
	else
	{
		COMBAT_D->do_attack(attacker, target, attacker->query_temp("weapon"));
if(target->query_temp("last_damage_from")==attacker)
			target->set_temp("last_damage_from", invoker);
		if(target->query_temp("last_fainted_from")==attacker)
			target->set_temp("last_fainted_from", invoker->query("id"));
	}
	destruct(attacker);
}
