// thunder.c
#include <ansi.h>

inherit SSERVER;

int cast(object me, object target) {
  int success_adj, damage_adj;

  if (me->query("family/family_name") != "明教" && !me->samsara_check("qiankun-danuoyi", 1))
    return notify_fail("你非人族弟子，不能用「光明圣火」！\n");
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展光明圣火？\n");

  if (time() - (int)me->query_temp("shenghuo_cast") < 3 + random(5))
    return notify_fail(YEL "你的魔法尚未恢复！\n" NOR);
  if ((int)me->query("mana") < 100 + 2 * (int)me->query("mana_factor"))
    return notify_fail("你的法力不够！\n");

  if ((int)me->query("sen") < 100)
    return notify_fail("你无法集中精力！\n");

  me->add("mana", -25 - 2 * (int)me->query("mana_factor"));
  me->receive_damage("sen", 50);

  if (random(me->query("max_mana")) < 50) {
    write("你现在心神不宁。\n");
    return 1;
  }


  SPELL_D->attacking_cast(
    me,
    //attacker 
    target,
    //target
    "both",
    //damage type: could be "qi"/"kee", "shen"/"sen", ...default "both"
    HIC "\n$N忽然将双手交于胸前。口中不住念着咒语。瞬间在$N胸前出现一团熊熊的火焰，火焰越来越旺，最后化作一个硕大的火球，飞向$n！\n" NOR,
    //initial message
    HIR "\n结果“砰”的一声，火球在$n身前炸开，\n$n躲闪不及，被烧得焦头烂额，惨不忍睹！\n" NOR,
    //success message
    HIC "$n不慌不忙，闪身避开，火球落到了空处，渐渐熄灭。\n" NOR,
    //fail message
    HIC "但是火球被$n以法力反激，反向$N飞去！\n" NOR,
    //backfire initial message
    HIR "结果“砰”的一声，火球在$n身前炸开，$n躲闪不及，被烧得焦头烂额，惨不忍睹！\n" NOR
    //backfire hit message. note here $N and $n!!!
  );

  if (me->query("family/family_name") != "明教")
    me->start_busy(1 + random(2));
  me->set_temp("shenghuo_cast", time());
  return 3 + random(5);
}
