#include <ansi.h>
inherit SSERVER;

void free(object target);

int cast(object me, object target) {
  object gu;
  string msg;
  int success, ap, dp, ap2, ap3, ap4, dp2, dp3, dp4, howlong;

  gu = present("jin gu", me);
  if (!gu || gu->query("name") != HIR "金箍" NOR)
    return notify_fail("没有金箍，紧箍咒也没什么用。\n");

  if (!target) target = offensive_target(me);

  if ((int)me->query_skill("spells") < 100 || (int)me->query_skill("buddhism", 1) < 60)
    return notify_fail("你还没学会紧箍咒。。。\n");

  if ((me->query("family/family_name") != "南海普陀山"
    || me->query("叛师/num")) && !me->samsara_check("buddhism", 1))
    return notify_fail("[紧箍咒]是南海普陀山不传之密！\n");

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你想对谁念咒？\n");

  if (target->query_temp("no_move"))
    return notify_fail(target->query("name") + "已经很忙了！\n");

  if ((int)me->query("mana") < 200)
    return notify_fail("你的法力不够！\n");

  if ((int)me->query("sen") < 10)
    return notify_fail("你无法集中精力！\n");

  me->add("mana", -200);
  me->receive_damage("sen", 10);

  msg = HIC "$N" HIC "默默的对着$n" HIC "念了几遍咒语！\n" NOR;
  success = 1;
  ap = me->query_skill("spells");
  ap = ap / 10 * ap / 10 * ap / 12;
  ap += (int)me->query("daoxing") / 100;
  dp = (int)target->query("daoxing") / 100;

  ap2 = (int)me->query_int();
  dp2 = (int)target->query_int();


  ap3 = (int)me->query("mana");
  dp3 = (int)target->query("mana");
  if (random(ap + dp + 2500 * (ap2 + dp2) + 200 * (ap3 + dp3)) < (dp + 3500 * dp2 + 200 * dp3)) success = 0;
  gu->set("target", target);
  gu->set("owner", me);
  if (!gu->move(target))
    success = 0;
  else success = 1;

  if (success == 1) {
    msg += HIC "结果把个$n痛得竖蜻蜓，翻筋斗，耳红面赤，眼胀身麻，不由得抓破了自己的头。\n" NOR;
    target->set_temp("no_move/start", time());
    target->set_temp("no_move/time", 6);
  } else {
    msg += HIR "但是什么也没发生！\n" NOR;
    me->start_busy(2 + random(2));
    if (living(target)) target->kill_ob(me);
  }
  message_vision(msg, me, target);
  return 1;
}
