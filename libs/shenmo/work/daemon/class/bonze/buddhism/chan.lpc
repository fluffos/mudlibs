// 神话世界·西游记·版本４．５０
/* <SecCrypt CPL V3R05> */

//chan.c 缠身莲花
#include <ansi.h>
inherit SSERVER;

void check_target(object target);

int cast(object me, object target) {
  int flag, ap, dp, num;
  string msg, str, arg;
  object where, weapon;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你想祭莲花缠谁？\n");

  if ((string)me->query("family/family_name") != "南海普陀山" && me->query("spskk") != 13 && !me->samsara_check(
    "buddhism",
    1
  ))
    return notify_fail("你又不是普陀山弟子。\n");
  if ((int)me->query("daoxing") < 300000)
    return notify_fail("你的道行不够深厚。\n");
  if ((int)me->query_skill("buddhism", 1) < 60)
    return notify_fail("你的大乘佛法修为不深。\n");
  if ((int)me->query("mana") < 300)
    return notify_fail("你的法力不够了。\n");
  if ((int)me->query("sen") < 10)
    return notify_fail("你现在神智不清。\n");
  if (mapp(target->query_temp("lianhua_busy"))
    && time() < (target->query_temp("lianhua_busy/time_start") + 60))
    return notify_fail(target->name() + "已经给莲花缠住了。\n");

  me->add("mana", -200);
  me->receive_damage("sen", 10);

  if (random(me->query("max_mana")) < 50) {
    write("咦？这一次好像不灵。\n");
    return 1;
  }
  where = environment(me);
  weapon = me->query_temp("weapon");
  if (objectp(weapon))
    str = "单手持" + weapon->name() + HIC "，右手";
  else str = "双手互交，快速";
  msg = HIC "激战多时，$N" HIC "忽地跳出圈外，" + str + "结咒，往空一指，喝声”疾！“\n" NOR;
  str = where->query("short");
  num = (int)me->query_skill("buddhism", 1);
  if (num <= 180) {
    arg = GRN "青莲" NOR;
    num = 180;
  } else if (num <= 240) {
    arg = HIG "绿莲" NOR;
    num = 240;
  } else if (num <= 300) {
    arg = WHT "白莲" NOR;
    num = 300;
  } else if (num <= 360) {
    arg = HIW "白莲" NOR;
    num = 360;
  } else if (num <= 420) {
    arg = HIM "红莲" NOR;
    num = 420;
  } else if (num <= 480) {
    arg = HIR "红莲" NOR;
    num = 480;
  } else {
    arg = HIY "金莲" NOR;
    num = 540;
  }
  num /= 60;
  msg += HIC "但见" + str + HIC "被一片檀香之气笼罩，氤氲之中乍现" + chinese_number(num) + "朵" + arg + HIC "! \n" NOR;

  if (me->query("daoxing") > target->query("daoxing")
    || me->query("combat_exp") > target->query("combat_exp")
    || me->query("max_mama") > target->query("max_mana")
    || me->query_spi() > target->query_spi()
    || me->query_skill("spells") > target->query_skill("spells"))
    flag = 2;
  else {
    ap = me->query("daoxing") / 100000;
    dp = target->query("daoxing") / 100000;
    ap += me->query_temp("apply/spells");
    dp += target->query_temp("apply/spells");
    ap += me->query_spi() / 5;
    dp += target->query_spi() / 5;
    if (ap > dp)
      flag = 2;
    else if (ap > random(dp))
      flag = 1;
    else flag = 0;
  }

  if (flag != 0 && random(me->query("level") + target->query("level")) > target->query("level")) {
    msg += HIC "$n" HIC "并未察觉脚下有变,一个不防,已被" + arg + HIC "团团围住!\n\n" NOR;
    message_vision(msg, me, target);
    target->kill_ob(me);
    target->set_temp("lianhua_busy", ([
      "type": flag,
      "time": num,
      "time_start": time(),
      "lianhua": arg,
    ]));
    call_out("check_target", 1, target);
  } else {
    msg += HIC "$n" HIC "哈哈大笑:这点伎俩也想瞒过我?!\n\n" NOR;
    message_vision(msg, me, target);
    target->kill_ob(me);
    me->add("mana", -100);
  }
  return 3 + random(5);
}

void check_target(object target) {
  int flag, t, num, times;
  string msg, str;
  mapping busy;
  if (!target)
    return;
  remove_call_out("check_target");
  busy = target->query_temp("lianhua_busy");
  if (mapp(busy)) {
    flag = busy["type"];
    num = busy["time"];
    times = num * 5;
    t = busy["time_start"];
    str = busy["lianhua"];
    if (!target->is_busy()) {
      msg = HIM "\n但见梵香缭绕,氤氲阵阵," + str + HIM "迅速的缠绕住$N" HIM "双脚!\n\n" NOR;
      message_vision(msg, target);
      target->start_busy(3 + random(times / 2));
    }
    if (flag == 2) {
      msg = HIG "\n空气中弥漫着一股肃穆一气," + str + HIG "好似渐渐生长开来....\n" NOR;
      msg += HIG "$N" HIG "只觉脚底一麻,真气源源不绝的被" + str + HIG "吸收了....\n" NOR;
      message_vision(msg, target);
      if (target->query("force") >= 250)
        target->add("force", -50 - random(200));
    }
    if (time() > t + times)
      target->delete_temp("lianhua_busy");

    call_out("check_target", 5 + random(5), target);
  } else message_vision(HIY "金光一闪,$N" HIY "脚下的莲花渐渐枯萎凋谢了....\n" NOR, target);
}
