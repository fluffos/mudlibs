// 暴风骤雨
#include <ansi.h>
inherit SSERVER;

string name() {
  return "「" HIC "暴风骤雨" NOR "」";
}

int valid_perform(object me) {
  if ((me->query("family/family_name") != "南海普陀山"
    || me->query("class") != "xian") && !me->samsara_check("jienan-zhi", 1))
    return notify_fail("你并非出家和尚,不能使用这项技能！\n");
  if (me->query("force") < 25 + me->query("force_factor"))
    return notify_fail("你的真气不足" + 25 + me->query("force_factor") + "点，不能使用" + name() + "。\n");
  if (me->query("kee") < 100)
    return notify_fail("你的气血不足 100 点，无法使出" + name() + "。\n");
  if (me->query_skill("jienan-zhi", 1) < 100)
    return notify_fail("你的" + to_chinese("jienan-zhi") + "等级不足" + 100 + "级，无法使出" + name() + "。\n");
  return 1;
}

int perform(object me, object target) {
  if (!target)
    target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || !me->is_fighting(target))
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "必须在战斗状态下使用。\n");

  me->add("force", -25 - (int)me->query("force_factor"));
  me->receive_damage("kee", 100);

  if (random(me->query("max_force")) < 50) {
    write("糟糕，没成功！\n");
    return 1;
  }

  COMBAT_D->attacking_perform(
    me,                                     //attacker 
    target,                                 //target
    me->query_skill("jienan-zhi", 1),       //level of skill used
    150,                                    //success adjustment
    100,                                    //damage adjustment
    "both",                                 //damage type: could be "qi"/"kee", "shen"/"sen", ...default "both"
    HIC "\n$N" HIC "口中大喝了一声，施展出「暴风骤雨」，双手十指上下翻飞，身形前后左右移动，
$n" HIC "只觉得到处是$N" HIC "的影子，根本不知如何招架，更不用说躲闪了！\n\n" NOR,
    HIC "结果十指结结实实全部击中了$n" HIC "，差点没把$p戳了个透心凉！\n" NOR,
    HIC "但是$n" HIC "轻轻一跳就躲了开来。\n" NOR,
    HIC "但是被$n" HIC "以内力一逼，指力尽数反挫！\n" NOR,
    HIR "结果只听喀嚓！几声，$n" HIR "十指几乎全部折断！\n" NOR
  );
  me->start_busy(3);
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("jienan-zhi") + " 100 级\n";
  temp += "\t\t真气大于内功加力 25 点\n";
  temp += "\t\t气    血 100 点\n";
  temp += "\t\t南海普陀山弟子\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                减少并伤害对手的气血和精神
        出招类型：
                busy型外功
                不可叛师带出
                无隐藏属性
        出手要求：              
HELP);
  write(temp);
  return 1;
}
