#include <ansi.h>
inherit SSERVER;

void sandu2(object, object);
void sandu3(object, object);
void sandu4(object, object);

string name() {
  return "「" HIW "佛门三渡" NOR "」";
}

int valid_perform(object me) {
  if (me->query("bellicosity") > 300 && me->query("shilian") < 1)
    return notify_fail("你杀气高于 300 点，无法施展佛门绝技" + name() + "。\n");
  if (me->query("family/family_name") != "南海普陀山"
    && me->query_skill("lunhui-zhang", 1) < 350)
    return notify_fail("你非佛门弟子，无法施展佛门绝技" + name() + "。\n");
  if (me->query("class") != "xian" && !me->samsara_check("lunhui-zhang"))
    return notify_fail(name() + "此乃仙家不传之密。\n");
  if (me->query_skill("lotusforce", 1) < 100)
    return notify_fail("你的" + to_chinese("lotusforce") + "不足 100 级，施展不出" + name() + "。\n");
  if (me->query_skill("staff", 1) < 120)
    return notify_fail("你的" + to_chinese("staff") + "不足 120 级，施展不出" + name() + "。\n");
  if (me->query_skill("lunhui-zhang", 1) < 120)
    return notify_fail("你的" + to_chinese("force") + "不足 120 级，施展不出" + name() + "。\n");
  if (me->query_skill_mapped("force") != "lotusforce" && !me->samsara_check("lunhui-zhang"))
    return notify_fail("你无莲台心法辅助，施展不出" + name() + "。\n");
  if (!objectp(me->query_temp("weapon")))
    return notify_fail("你的杖呢？\n");
  if (me->query("force") < 200)
    return notify_fail("你的真气不足 200 点，施展不出" + name() + "。\n");
  if (me->query("max_force") < 500)
    return notify_fail("你的内力修为不足 500 点，施展不出" + name() + "。\n");
  return 1;
}

int perform(object me, object target) {
  string msg;
  object weapon;
  int ap1, ap2, ap3, dp1, dp2, ap, dp, damage, wound;

  if (!valid_perform(me))
    return 0;
  me->clean_up_enemy();
  target = me->select_opponent();
  if (!target)
    target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(name() + "只能对战斗中的对手使用。\n");
  if (!me->is_fighting())
    return notify_fail(name() + "必须在战斗状态下使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "staff")
    return notify_fail("你使用的武器不对，无法施展" + name() + "。\n");
  if (me->query("env/no_msg") || target->query("env/no_msg"))
    message_vision(HIW "$N" HIW "使出了佛门三渡！\n" NOR, me, target);
  msg = HIW "$N" HIW "默吟佛号，手中的" + weapon->query("name") + HIW "带一层淡淡的白雾直直拍向$n" HIW "的胸前！
这第一招名唤「渡劫」！\n" NOR;
  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    message_vision(msg, me, target);

  ap1 = (int)me->query("combat_exp") / 1000;
  dp1 = (int)target->query("combat_exp") / 1000;
  ap2 = me->query_str();
  dp2 = target->query_str();
  ap3 = (int)me->query_skill("buddhism", 1);

  ap = ap1 + ap2 + ap3;
  dp = (dp1 + dp2) / 2;
  if (dp < 1)
    dp = 1;
  if (ap3 > 60 || random(ap) > dp) {
    msg = HIR "$n" HIR "心神一慌，一个躲闪不及，被$N" HIR "的" + weapon->query("name") + HIR "实实在在的印在胸膛，
$n" HIR "的胸膛立刻就塌了下去！\n" NOR;
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(msg, me, target);
    me->add("force", -100);
    damage = (50 + me->query_str() + random(me->query_skill("staff"))) / 2;
    wound = random(damage - (int)target->query_temp("apply/armor"));
    if (wound > 0) target->receive_wound("kee", wound, me);
    target->receive_damage("kee", damage, me);
    COMBAT_D->report_status(target, 0);
    sandu2(me, target);
  } else {
    msg = HIG "只见$n" HIG "神色一凛，不敢硬接，一个翻身及时的退出战圈，躲开了
$N" HIG "凌厉的攻势！\n\n" NOR;
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(msg, me, target);
    me->add("force", -100);
    me->start_busy(3);
  }
  return 1;
}

void sandu2(object me, object target) {
  string msg;
  object weapon;
  int ap1, ap2, ap3, dp1, dp2, ap, dp, damage, wound;

  if (!me || !target || !me->is_fighting(target)
    || !living(me))
    return;
  if (me->query("force") < 300)
    return;
  if (me->query_skill("staff") < 135
    || me->query_skill("force") < 135)
    return;

  weapon = me->query_temp("weapon");
  msg = HIW "$N" HIW "手中" + weapon->query("name") + HIW "一振，白色劲气已然布满全身，
风雷之声渐起，这第二式「渡难」猛然拍出！\n" NOR;
  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    message_vision(msg, me, target);
  ap1 = (int)me->query("combat_exp") / 1000;
  dp1 = (int)target->query("combat_exp") / 1000;
  ap2 = me->query_str();
  dp2 = target->query_str();
  ap3 = (int)me->query_skill("buddhism", 1);

  ap = ap1 + ap2 + ap3;
  dp = (dp1 + dp2) / 2;
  if (dp < 1)
    dp = 1;
  if (ap3 > 70 || random(ap * 7 / 6) > dp) {
    msg = HIR "$n" HIR "正瞠目间，" + weapon->query("name") + NOR HIR "已到了胸前，内劲一吐，
$n" HIR "立时口喷鲜血，倒飞出三丈有余！\n" NOR;
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(msg, me, target);
    me->add("force", -200);
    damage = (100 + me->query_str() + random(me->query_skill("staff"))) / 2;
    wound = random(damage - (int)target->query_temp("apply/armor"));
    if (wound > 0) target->receive_wound("kee", wound, me);
    target->receive_damage("kee", damage, me);
    COMBAT_D->report_status(target, 0);
    sandu3(me, target);
  } else {
    msg = HIG "$n" HIG "躲无可躲，就地一滚，非常狼狈的堪堪躲开了这第二招。\n\n" NOR;
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(msg, me, target);
    me->add("force", -100);
    me->start_busy(3);
  }
}

void sandu3(object me, object target) {
  string msg;
  object weapon;
  int ap1, ap2, ap3, dp1, dp2, ap, dp, damage, wound;

  if (!me || !target || !me->is_fighting(target)
    || !living(me))
    return;
  if (me->query("force") < 400)
    return;
  if (me->query_skill("staff") < 150)
    return;
  if (me->query_skill("force") < 150)
    return;
  weapon = me->query_temp("weapon");
  msg = HIW "$N" HIW "梵唱又起，" + weapon->query("name") + HIW "象鼓满了风的劲帆，汹涌而出！
「渡厄」一式之凶险显见佛家动嗔也会做“狮子吼”！\n" NOR;
  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    message_vision(msg, me, target);

  ap1 = (int)me->query("combat_exp") / 1000;
  dp1 = (int)target->query("combat_exp") / 1000;
  ap2 = me->query_str();
  dp2 = target->query_str();
  ap3 = (int)me->query_skill("buddhism", 1);

  ap = ap1 + ap2 + ap3;
  dp = (dp1 + dp2) / 2;
  if (dp < 1)
    dp = 1;
  if (ap3 > 80 || random(ap * 4 / 3) > dp) {
    msg = HIR "$n" HIR "被这弧形的汹涌劲气一罩，身法全乱，象喝醉了的东倒西歪！\n" NOR;
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(msg, me, target);
    me->add("force", -300);
    damage = (150 + me->query_str() + random(me->query_skill("staff"))) / 2;
    wound = random(damage - (int)target->query_temp("apply/armor"));
    if (wound > 0) target->receive_wound("kee", wound, me);
    target->receive_damage("kee", damage, me);
    COMBAT_D->report_status(target, 0);
    sandu4(me, target);
  } else {
    msg = HIG "$n临危不乱，看准来势，堪堪拆了这一招。\n\n" NOR;
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(msg, me, target);
    me->add("force", -100);
    me->start_busy(3);
  }
}

void sandu4(object me, object target) {
  string msg;
  object weapon;
  int ap1, ap2, ap3, dp1, dp2, ap, dp, damage, wound;

  if (!me || !target || !me->is_fighting(target)
    || !living(me))
    return;
  if (me->query("max_force") < 800)
    return;
  if (me->query("force") < 400)
    return;
  if (me->query_skill("staff") < 180)
    return;
  if (me->query_skill("force") < 180)
    return;
  weapon = me->query_temp("weapon");
  msg = HIC "$N轻声禅唱“回头是岸”，周身七尺劲气涌动，这普陀佛门禅功的无上功力终化作
「慈光普渡」澎湃而出！\n" NOR;
  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    message_vision(msg, me, target);
  ap1 = (int)me->query("combat_exp") / 1000;
  dp1 = (int)target->query("combat_exp") / 1000;
  ap2 = me->query_str();
  dp2 = target->query_str();
  ap3 = (int)me->query_skill("buddhism", 1);

  ap = ap1 + ap2 + ap3;
  dp = (dp1 + dp2) / 2;
  if (dp < 1)
    dp = 1;
  if (ap3 > 100 || random(ap * 3 / 2) > dp) {
    msg = HIR "$n似一片枯叶，被「慈光普渡」的劲气包围、卷起、压扁、抛下，\n重重的摔在地上，眼看是不行了！\n" NOR;
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(msg, me, target);
    me->add("force", -400);
    damage = (200 + me->query_str() + random(me->query_skill("staff"))) / 2;
    wound = random(damage - (int)target->query_temp("apply/armor"));
    if (wound > 0) target->receive_wound("kee", wound, me);
    target->receive_damage("kee", damage, me);
    COMBAT_D->report_status(target, 0);
    target->start_busy(random(2));
    me->start_busy(1 + random(2));
  } else {
    msg = HIG "$n一颗流星般急退而出，总算从鬼门关上拣回了一条命。\n\n" NOR;
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(msg, me, target);
    me->add("force", -100);
    me->start_busy(1);
  }
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("lotusforce") + " 100 级\n";
  temp += "\t\t" + to_chinese("lunhui-zhang") + " 120 级\n";
  temp += "\t\t" + to_chinese("staff") + " 120 级\n";
  temp += "\t\t当前的" + to_chinese("force") + "激发必须为" + to_chinese("lotusforce") + "\n";
  temp += "\t\t真    气 200 点\n";
  temp += "\t\t杀气低于 300 点\n";
  temp += "\t\t内力修为 500 点\n";
  temp += "\t\t战斗状态下\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                对敌人发起连续的攻击
                同时造成自身动作的缓
                慢
        出招类型：
                busy型外功
                350级可叛师带出
                带连续隐藏攻击  
        出手要求：              
HELP);
  write(temp);
  return 1;
}
