#include <ansi.h>
inherit SSERVER;

string name()
{
return "「"HIR"我入地狱"NOR"」";
}

int valid_perform(object me)
{
if ( me->query("max_force")<800 )
        return notify_fail("你的内功修为不足 800 点，不能使用"+name()+"。\n");
if ( me->query("force")<200 )
        return notify_fail("你的内力不足 200 点，不能使用"+name()+"。\n");
if ( (string)me->query("family/family_name")!= "南海普陀山" && !me->samsara_check("lunhui-zhang")) 
        return notify_fail("你非佛门弟子，无法施展佛门绝技"+name()+"。\n"); 
if( time()-(int)me->query_temp("diyu_end") < 3+random(2) ) 
        return notify_fail("绝招用多就不灵了！\n"); 
if ( me->query("sen")<500 )
        return notify_fail("你的精神不足 500 点，不能使用"+name()+"。\n");
if ( me->query("kee")<300 )
        return notify_fail("你的气血不足 300 点，不能使用"+name()+"。\n");
if ( me->query_skill("buddhism",1)<60 )
        return notify_fail("你的"+to_chinese("buddhism")+"等级不足 60 级，不能使用"+name()+"。\n");
if ( me->query_skill("lunhui-zhang",1)<60 )
        return notify_fail("你的"+to_chinese("lunhui-zhang")+"等级不足 60 级，不能使用"+name()+"。\n");
if ( me->query_skill("staff",1)<60 )
        return notify_fail("你的"+to_chinese("staff")+"等级不足 60 级，不能使用"+name()+"。\n");
if ( me->query("class")!="xian" && !me->samsara_check("lunhui-zhang",1))
        return notify_fail("你并非仙族,不能使用"+name()+"！\n");
if ( !objectp(me->query_temp("weapon")) )
        return notify_fail("你空手能使"+name()+"？真是活见鬼了！\n");   
return 1;
}

int perform(object me, object target)
{
object weapon;
int i,j,damage;

if ( !valid_perform(me) )
        return 0;
if (!objectp(weapon = me->query_temp("weapon"))
|| (string)weapon->query("skill_type") != "staff")
        return notify_fail("你使用的武器不对，无法施展"+name()+"。\n");
if ( !target ) 
        target = offensive_target(me);
if ( !target
  || !target->is_character()
  || target->is_corpse()
  || !me->is_fighting(target) )
        return notify_fail("你要攻击谁？\n");
if ( !me->is_fighting() )
        return notify_fail(name()+"必须在战斗状态下使用。\n");

i = me->query_skill("lunhui-zhang",1)+me->query_skill("staff",1)/2;
j = me->query_skill("lunhui-zhang",1);
        
message_vision(HIY"\n$N"HIY"口诵佛号，将全身功力注入手中"+weapon->name()+NOR+HIY"顿时间霞光四射，照得
$n"HIY"睁不开眼！\n\n"NOR,me,target);
damage = me->query_skill("buddhism")/2; 
damage+= me->query_skill("staff")/2; 
damage+= me->query_skill("lunhui-zhang");
damage+= me->query("max_force");
damage-= target->query_temp("apply/armor");
if ( damage<15 ) damage = 15;
target->receive_damage("kee",damage/5);
me->receive_damage("sen", 100);
me->add("force", -200);
me->receive_damage("kee",100);
COMBAT_D->report_status(target);
COMBAT_D->report_status(me);
if ( !target->is_fighting(me) ) 
        {
        if( living(target) ) 
                {
                if( userp(target) ) 
                        target->fight_ob(me);
                else    target->kill_ob(me);
                }
        }
me->set_temp("diyu_end",time());
return 1;
}

int help(object me)
{
string temp;    
temp = "\t\t"+to_chinese("buddhism")+" 80 级\n";
temp+= "\t\t"+to_chinese("lunhui-zhang")+" 80 级\n";
temp+= "\t\t"+to_chinese("staff")+" 80 级\n";
temp+= "\t\t真    气 200 点\n";
temp+= "\t\t气    血 300 点\n";
temp+= "\t\t精    神 500 点\n";
temp+= "\t\t内力修为 800 点\n";
temp+= "\t\t战斗状态下\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");
write(@HELP

        使用功效：
                短时间内牺牲自身的气血和精神来
                对敌人造成气血的伤害
        出招类型：
                延时型外功
                不可叛师带出
                使用后敌人会再次叫杀
        出手要求：              
HELP);                          
write(temp);
return 1;
}
