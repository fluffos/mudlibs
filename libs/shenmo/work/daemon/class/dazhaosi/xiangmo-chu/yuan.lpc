
// write by windy 07/06/20
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIC"圆满势"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "大昭寺" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("xiangmo-chu", 1) < 180) 
        return notify_fail("你的金刚降魔杵修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("stick", 1) < 180) 
        return notify_fail("你的基本棍法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("longxiang", 1) < 180) 
        return notify_fail("你的龙象般若功修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("max_force") < 2000 ) 
        return notify_fail("你的内力修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("force") < 1000 ) 
        return notify_fail("你的内力不足！\n"); 
if((int)me->query("sen") < 500 ) 
        return notify_fail("你的精神不足！\n"); 
if(time()-me->query_temp("dazhaosi-yuan_end")<3+random(4)) 
        return notify_fail("你的攻势尚未结束！\n"); 
return 1;  
}

int perform(object me, object target)
{
int ap, dp, damage;
object weapon;

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

ap = me->query_skill("stick");
dp = target->query_skill("parry");
weapon = me->query_temp("weapon");
damage = (int)me->query_skill("xiangmo-chu", 1);
damage+= (int)me->query_skill("stick", 1)/2;
damage+= (int)me->query("force_factor");
damage-= (int)target->query("force_factor");
if (damage<100)    damage = 100;

message_vision(HIC"\n$N"HIC"力贯双臂，将手中"+weapon->name()+""HIC"抡出一个大圆，划破长空砸向$n"HIC"！"NOR,me,target);
if (ap/3 + random(ap) > dp/2)
        {
        message_vision(HIR"\n只听$n"HIR"躲闪不及，一声惨号，肩头已被砸得血肉模糊！\n"NOR,me,target);
        me->add("force", -500);
        target->receive_wound("kee",damage,me);
        target->receive_damage("kee",damage+damage/3+random(damage),me);
        COMBAT_D->report_status(target,0);
        }
else    {
        message_vision(CYN"\n$n"CYN"不敢怠慢，打起精神小心应敌，幸无大碍。\n"NOR,me,target);
        me->add("force", -200);
        }
me->receive_damage("sen", 200);
me->set_temp("dazhaosi-yuan_end", time());
return 1;
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("xiangmo-chu")+" 180 级\n";  
temp+= "\t\t"+to_chinese("stick")+" 180 级\n";  
temp+= "\t\t"+to_chinese("longxiang")+" 180 级\n";  
temp+= "\t\t内力修为二十年\n"; 
temp+= "\t\t内力１０００点\n"; 
temp+= "\t\t精神５００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                伤害对手的气血
        出招类型：   
                延时型外功  
                无隐藏攻击  
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
