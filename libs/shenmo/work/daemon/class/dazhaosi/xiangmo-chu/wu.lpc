
// write by windy 07/06/20
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"RED"镇魂舞"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "大昭寺" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("xiangmo-chu", 1) < 350) 
        return notify_fail("你的金刚降魔杵修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("stick", 1) < 350) 
        return notify_fail("你的基本棍法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("lamaism", 1) < 350) 
        return notify_fail("你的密宗佛法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("shenkong-xing", 1) < 350) 
        return notify_fail("你的身空行修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("max_force") < 5000 ) 
        return notify_fail("你的内力修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("force") < 2000 ) 
        return notify_fail("你的内力不足！\n"); 
if((int)me->query("sen") < 500 ) 
        return notify_fail("你的精神不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
object weapon;
int i,lvl,ap,dp,damage;
if ( !valid_perform(me) ) 
        return 0;   
if( !target ) target = offensive_target(me);
if( !target
||      !target->is_character()
||      target->is_corpse()
||      target==me) 
                return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n"); 

weapon = me->query_temp("weapon");
ap = (int)me->query("combat_exp")/200000;
dp = (int)target->query("combat_exp")/200000;
ap+= (int)me->query("level")*(int)me->query("level")/500;
dp+= (int)target->query("level")*(int)target->query("level")/500;
lvl = (int)me->query_skill("xiangmo-chu", 1)/120;
if (lvl<3)    lvl=3;
if (lvl>9)    lvl=9;
damage = (int)me->query_skill("stick", 1)/2;
damage+= (int)me->query_skill("lamaism", 1)/2;
damage+= (int)me->query("force_factor")/3;
damage+= (int)me->query_skill("longxiang", 1)/2;
damage+= (int)me->query_skill("xiangmo-chu", 1)/2;
message_vision(HIR"\n只见$N"HIR"向$n"HIR"念了几句梵音咒语，$n"HIR"似中了邪一般，原地手舞足蹈起来！"NOR, me, target);
message_vision(HIR"\n$N"HIR"趁机舞动手中"+weapon->name()+""HIR"，罡风猎猎，如车轮般攻向$n"HIR"！\n"NOR, me, target);
if (random(ap)>dp/6)
        {
        for (i=0;i<=lvl;i++)
                {
                target->receive_wound("kee",damage/3,me);
                target->receive_damage("kee",damage+random(damage),me);
                COMBAT_D->report_status(target);
                me->add("force", -100);
                }
        }
else    {
        message_vision(HIC"$n"HIC"见"+weapon->name()+""HIC"攻到，猛然惊觉，匆忙招架不迭！\n"NOR,me, target);
        if (!target->is_busy())
                target->start_busy(1);
        me->add("force", -500);
        }
me->add("sen", -100);
me->start_busy(2);
return 1;
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("xiangmo-chu")+" 350 级\n"; 
temp+= "\t\t"+to_chinese("stick")+" 350 级\n"; 
temp+= "\t\t"+to_chinese("lamaism")+" 350 级\n"; 
temp+= "\t\t"+to_chinese("shenkong-xing")+" 350 级\n"; 
temp+= "\t\t内力修为五十年\n"; 
temp+= "\t\t内力２０００点\n"; 
temp+= "\t\t精神５００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                连续打击对手的气血，并可能牵制敌人
        出招类型： 
                busy 型外功
                有隐藏攻击
                叛师不可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
