
//writs by windy 07/06/20
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() 
{
return "「"HIC"破立势"NOR"」";   
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "大昭寺" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("xiangmo-chu", 1) < 200) 
        return notify_fail("你的金刚降魔杵修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("yujiamu-quan", 1) < 200) 
        return notify_fail("你的金刚瑜伽母拳修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("longxiang", 1) < 200) 
        return notify_fail("你的龙象般若功修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("max_force") < 1000 ) 
        return notify_fail("你的内力修为太差。\n"); 
if((int)me->query("force") < 500 ) 
        return notify_fail("你的内力不足！\n"); 
if( time()-(int)me->query_temp("dazhaosi-poli_end") < 2+random(3) ) 
        return notify_fail("绝招用多了就不灵了！\n");
return 1; 
}

int perform(object me, object target)
{
object weapon;
int extra;
string str;
if ( !valid_perform(me) ) 
        return 0;   
if( !target ) target = offensive_target(me);
if( !target
||      !target->is_character()
||      target->is_corpse()
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n"); 

weapon = me->query_temp("weapon");
message_vision(HIC"$N"HIC"面上表情怪异无比，左手将"+weapon->name()+""HIC"往地上一杵，
身体借力腾空而起，右手拳顺势捣出，同时左手杵也轮番而至！\n"NOR,me);
extra = (int)me->query_skill("stick", 1);
extra+= (int)me->query_skill("unarmed", 1);
extra-= (int)target->query_skill("force", 1);
if (extra<300)    extra = 300;
if (extra>1500)    extra = 1500;
me->add_temp("apply/damage",extra); 
me->add_temp("apply/attack",extra); 
me->set_temp("dazhaosi-poli_end",time()); 

if (random(me->query_skill("dodge")) > target->query_skill("dodge")/3 && !target->is_busy())
        {
        message_vision(YEL"\n$n"YEL"脚下一个不稳，打了个趔趄，差点栽倒！\n"NOR,me,target); 
        target->start_busy(1+random(3));
        }
if ( weapon && weapon==me->query_temp("weapon") )  weapon->unequip();
COMBAT_D->do_attack(me, target);
if ( weapon && weapon!=me->query_temp("weapon") )  weapon->wield();
COMBAT_D->do_attack(me, target, weapon);
if ( weapon && weapon==me->query_temp("weapon") )  weapon->unequip();
COMBAT_D->do_attack(me, target);
if ( weapon && weapon!=me->query_temp("weapon") )  weapon->wield();
COMBAT_D->do_attack(me, target, weapon);

me->add_temp("apply/attack",-extra);
me->add_temp("apply/damage",-extra); 
me->reset_action();
return 1;
}

int help(object me)
{
string temp; 
temp = "\t\t"+to_chinese("xiangmo-chu")+" 200 级\n";  
temp+= "\t\t"+to_chinese("yujiamu-quan")+" 200 级\n";  
temp+= "\t\t"+to_chinese("longxiang")+" 200 级\n";  
temp+= "\t\t内力５００点\n"; 
temp+= "\t\t内力修为十年\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                连续伤害对手的气血并可能牵制对手
        出招类型：   
                延时型外功  
                有隐藏攻击  
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
