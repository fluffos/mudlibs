// windy
#include <ansi.h>
inherit SSERVER;

int cast(object me, object target) {
  int success_adj, damage_adj;
  if (me->query("family/family_name") != "大昭寺" || me->query("class") != "saint")
    return notify_fail("你非大昭寺弟子，不能用「五雷轰顶」！\n");
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展「五雷轰顶」？\n");
  if (time() - (int)me->query_temp("wulei_cast") < 3 + random(5))
    return notify_fail(YEL "你的魔法尚未恢复！\n" NOR);
  if ((int)me->query("mana") < 100 + 2 * (int)me->query("mana_factor"))
    return notify_fail("你的法力不够！\n");
  if ((int)me->query("sen") < 100)
    return notify_fail("你无法集中精力！\n");

  me->add("mana", -25 - 2 * (int)me->query("mana_factor"));
  me->receive_damage("sen", 50);

  if (random(me->query("max_mana")) < 50) {
    write("你现在心神不宁。\n");
    return 1;
  }

  SPELL_D->attacking_cast(
    me,
    //attacker 
    target,
    //target
    "sen",
    //damage type: could be "qi"/"kee", "shen"/"sen", ...default "both"
    HIC "\n$N" HIC "念了几句咒语，突然在$n" HIC "头顶正上方爆出一个光球，五道焦雷朝下方的$n" HIC "劈了下来！\n" NOR,
    //initial message
    HIR "\n结果$n" HIR "躲闪不及，被劈个正着，精神委顿不堪！\n" NOR,
    //success message
    HIC "$n" HIC "不慌不忙，轻轻一闪，躲了开去。\n" NOR,
    //fail message
    HIC "谁知$n" HIC "用法力一逼，焦雷反向$N" HIC "劈去！\n" NOR,
    //backfire initial message
    HIR "\n结果$N" HIR "躲闪不及，被劈个正着，精神委顿不堪！\n" NOR,
    //backfire hit message. note here $N and $n!!!
  );
  me->set_temp("zijinchui_cast", time());
  return 3 + random(5);
}
