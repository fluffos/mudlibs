
// write by windy 07/06/20
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIC"若悲若喜"NOR"」";  
}

int valid_perform(object me)
{
if ( (string)me->query("family/family_name")!= "大昭寺" || me->query("class")!="saint") 
        return notify_fail("你不够资格使用"+name()+"。\n"); 
if ( me->query_skill("mingwang-jian",1)<150 )
        return notify_fail("你的不动明王剑还不够纯熟，无法使用"+name()+"。\n"); 
if ( me->query_skill("sword",1)<150 )
        return notify_fail("你的基本剑法不够纯熟，无法使用"+name()+"。\n"); 
if ( me->query_skill("longxiang",1)<150 )
        return notify_fail("你的龙象般若功不够纯熟，无法使用"+name()+"。\n"); 
if ( me->query("combat_exp")<1000000 )
        return notify_fail("你的武学修为太低，无法使用"+name()+"。\n"); 
if ( me->query("force")<1000 )
        return notify_fail("你现在内力不足，不能使用"+name()+"。\n");
if ( me->query("sen")<500 )
        return notify_fail("你现在精神不足，不能使用"+name()+"。\n");
return 1;
}

int perform(object me, object target)
{
object weapon;
int ap, dp, extra;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
if(target->is_busy()) 
        return notify_fail("对方尚处于痴迷之中！\n");   

ap = me->query("combat_exp")/200000;
dp = target->query("combat_exp")/200000;
weapon = me->query_temp("weapon");
extra = me->query_skill("mingwang-jian", 1)/100;
if (extra<3)    extra = 3;
if (extra>9)    extra = 9;

message_vision(HIW"\n$N"HIW"似喜似嗔，手中的"+weapon->name()+""HIW"轻轻递出，发出一阵轻鸣。。。\n" NOR, me, target);
if (random(ap)>dp/6)
        {
        message_vision(HIR"\n$n"HIR"心头一震，一时竟然沉迷当中，忘记了继续攻击。\n" NOR, me, target);
        target->start_busy(extra);
        me->receive_damage("sen", 300);
        me->add("force", -500);
        }
else    {
        message_vision(HIC"\n可是$n"HIC"神智只是略微一滞，随即清醒，没有被梵音困扰。\n" NOR, me, target);
        me->start_busy(2);
        me->receive_damage("sen", 100);
        me->add("force", -50);
        }
return 1;  
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("mingwang-jian")+" 150 级\n"; 
temp+= "\t\t"+to_chinese("sword")+" 150 级\n"; 
temp+= "\t\t"+to_chinese("longxiang")+" 150 级\n"; 
temp+= "\t\t内力１０００点\n"; 
temp+= "\t\t精神５００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                牵制敌人
        出招类型： 
                busy 型外功
                无隐藏攻击
                叛师不可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
