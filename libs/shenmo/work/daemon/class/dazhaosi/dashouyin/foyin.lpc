#include <ansi.h>
#include <combat.h>
inherit SSERVER;
string name() {
  return "「" HIY "文殊佛大手印" NOR "」";
}

int valid_perform(object me) {
  if (me->query("family/family_name") != "大昭寺" || me->query("class") != "saint")
    return notify_fail("你是哪儿偷学来的武功，也想用" + name() + "？\n");
  if ((int)me->query_skill("lamaism", 1) < 500)
    return notify_fail("你的密宗佛法修为太浅，难以施展" + name() + "。\n");
  if ((int)me->query_skill("dashouyin", 1) < 300)
    return notify_fail("你的密宗大手印不够娴熟，难以施展" + name() + "。\n");
  if (me->query("force") < 1000)
    return notify_fail("你现在的真气不够，难以施展" + name() + "。\n");
  if (me->query("max_force") < 5000)
    return notify_fail("你的内力修为太浅，难以施展" + name() + "。\n");
  return 1;
}

int perform(object me, object target) {
  string msg;
  int ap, dp;
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用！\n");
  if (!target->query_skill_mapped("spells") && !target->query_skill_mapped("force"))
    return notify_fail("对方的法门已经被你封死了。\n");

  msg = HIY "$N" HIY "面色庄重，双手轮转不定，刹那间$n" HIY "只见"
    "天地间有无数的手印向自己压了过来！\n" NOR;
  ap = me->query_skill("dashouyin", 1);
  ap += me->query_skill("lamaism", 1);
  ap += me->query_skill("lamaism", 1) / 500 * me->query_skill("lamaism", 1);
  dp = target->query_skill("spells");
  if (random(ap + dp) > dp) {
    msg += HIW "面对这排山倒海的攻势，$n" HIW "完全无法抵挡，"
      "全身的经脉已被$N" HIW "尽数封死！\n" NOR;
    if (random(4) == 1 && target->query_skill_mapped("spells") != 0)
      if (random(2) && target->query_skill_mapped("spells") != 0) {
        target->map_skill("spells", 0);
        target->set("mana_factor", 0);
        msg += HIY "$n法术激发给毁掉\n";
      } else {
        if (random(4) == 1 && target->query_skill_mapped("dodge") != 0) {
          msg += HIY "$n内功激发给毁掉\n";
          target->map_skill("force", 0);
          target->set("force_factor", 0);
        }
      }
    me->start_busy(random(3));
  } else {
    msg += CYN "$n" CYN "凝神应战，竭尽全力化解了$N" CYN "的"
      "大手印攻势。\n" NOR;
    me->start_busy(3);
  }
  message_vision(msg, me, target);
  return 1;
}
int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("dashouyin") + " 300 级\n";
  temp += "\t\t" + to_chinese("lamaism") + " 500 级\n";
  temp += "\t\t内力 1000 点\n";
  temp += "\t\t内力修为五十年\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP  

        使用功效：  
                毁灭对手内功或法术的激发
        出招类型：  
                busy型外功 
                有隐藏攻击
                叛师不可带出  
        出手要求：     
HELP);
  write(temp);
  return 1;
}
