#include <ansi.h>
#include <combat.h>
inherit SSERVER;
string name() {
  return "「" HIB "密宗大手印" NOR "」";
}

int valid_perform(object me) {
  if (me->query("family/family_name") != "大昭寺" || me->query("class") != "saint")
    return notify_fail("你是哪儿偷学来的武功，也想用" + name() + "？\n");
  if ((int)me->query_skill("longxiang", 1) < 120)
    return notify_fail("你的内功不够火候，难以施展" + name() + "。\n");
  if (me->query_skill_mapped("force") != "longxiang")
    return notify_fail("密宗大手印须当以龙象般若功为基础。\n");
  if ((int)me->query_skill("dashouyin", 1) < 120)
    return notify_fail("你的密宗大手印不够娴熟，难以施展" + name() + "。\n");
  if (me->query("force") < 1000)
    return notify_fail("你现在的真气不够，难以施展" + name() + "。\n");
  return 1;
}

int perform(object me, object target) {
  string msg;
  int damage;
  int ap, dp;
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用！\n");

  msg = HIB "$N" HIB "面现凶光，单手携着劲风朝$n" HIB "猛然拍出，但见"
    "你掌心发红，正是密宗绝学「大手印」！\n" NOR;
  ap = me->query_skill("dashouyin", 1);
  ap += me->query_skill("longxiang", 1);
  dp = target->query_skill("force", 1);
  if (random(ap) > dp) {
    damage = ap + random(ap);
    damage += me->query("force_factor");
    msg += HIR "结果$n" HIR "招架不及，被$N" HIR "一掌拍中"
      "直打得$n" HIR "七窍生烟，吐血连连。\n" NOR;
    target->receive_damage("kee", damage, me);
    target->receive_wound("kee", damage / 3, me);
    if (!me->query("env/innoxious") && target->query("spskk") != 9)
      target->apply_condition("dashouyin", 5 + random(5));
    me->start_busy(3);
  } else {
    msg += CYN "可是$n" CYN "不慌不忙，巧妙地架开了$N" CYN ""
      "的这一招「大手印」。\n" NOR;
    me->start_busy(3 + random(3));
  }
  message_vision(msg, me, target);
  return 1;
}
int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("dashouyin") + " 120 级\n";
  temp += "\t\t" + to_chinese("longxiang") + " 120 级\n";
  temp += "\t\t必须激发龙象般若功\n";
  temp += "\t\t内力 1000 点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP  

        使用功效：  
                伤害对手气血的同时使对手中毒
        出招类型：  
                busy型外功 
                有隐藏攻击
                叛师不可带出  
        出手要求：     
HELP);
  write(temp);
  return 1;
}
