
// write by windy 07/06/20
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIW"轰天砸"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "大昭寺" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("dali-chu", 1) < 120) 
        return notify_fail("你的无上大力杵修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("stick", 1) < 120) 
        return notify_fail("你的基本棍法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("longxiang", 1) < 120) 
        return notify_fail("你的龙象般若功修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("max_force") < 800 ) 
        return notify_fail("你的内力修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_temp("dali_za") > time() ) 
        return notify_fail("你无法频繁施展"+name()+"！\n"); 
if((int)me->query("force") < 300 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
object weapon, weapon1;
int ap, dp, damage;

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

weapon = target->query_temp("weapon");
weapon1 = me->query_temp("weapon");
ap = (int)me->query_str();
dp = (int)target->query_str();
damage = (int)me->query_skill("dali-chu", 1);
damage+= (int)me->query("force_factor");
damage+= (int)me->query_temp("apply/damage");
damage+=random(damage);

message_vision(HIW"\n$N"HIW"窥见$n"HIW"露出空门，抡起手中"+weapon1->name()+""HIW"奋力向$n"HIW"的顶梁砸去！"NOR,me,target);
if (random(ap)>dp/5)
        {
        if (weapon)
                {
                message_vision(HIY"\n$n"HIY"避无可避，举起手中"+weapon->name()+""HIY"迎了上去，结果被震得脱手而飞！\n"NOR,me,target);
                weapon->unequip();
                if( weapon->unequip()) weapon->move(environment(target));
                }
        else    {
                message_vision(HIR"\n$n"HIR"避无可避，手足无措，结果被砸得血肉模糊！\n"NOR,me,target);
                target->receive_damage("kee", damage, me);
                target->receive_wound("kee", damage/2, me);
                }
        }
else    message_vision(HIC"\n$n"HIC"见势不妙，急忙闪在一旁，躲开了这威猛的一击！\n"NOR,me,target);
me->add("force", -200);
me->set_temp("dali_za",time()+2+random(3));
//me->start_busy(2);
return 1;
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("dali-chu")+" 120 级\n"; 
temp+= "\t\t"+to_chinese("stick")+" 120 级\n"; 
temp+= "\t\t"+to_chinese("longxiang")+" 120 级\n"; 
temp+= "\t\t内力３００点\n";  
temp+= "\t\t内力修为八年\n";  
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP  

        使用功效：  
                打掉敌人的武器或者伤害敌人气血
        出招类型：   
                延时型外功   
                无隐藏攻击 
                叛师不可带出    
        出手要求：  
HELP);   
write(temp);   
return 1;   
}
