
// write by windy 07/06/18
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIC"连环杵"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "大昭寺" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("dali-chu", 1) < 200) 
        return notify_fail("你的无上大力杵修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("stick", 1) < 200) 
        return notify_fail("你的基本棍法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("max_force") < 1000 ) 
        return notify_fail("你的内力修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("force") < 1000 ) 
        return notify_fail("你的内力不足！\n"); 
if((int)me->query("sen") < 300 ) 
        return notify_fail("你的精神不足！\n"); 
if(time()-me->query_temp("dali-lianhuan_end") < 3 +random(4)) 
        return notify_fail("绝招用多了就不灵了！\n"); 
return 1;  
}

int perform(object me, object target)
{
object weapon;
int i, extra;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 

if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

extra = me->query_skill("dali-chu",1)/4;
weapon = me->query_temp("weapon");

message_vision(HIC"\n$N"HIC"双掌将"+weapon->name()+""HIC"舞动如飞，连环五式，迅雷般攻向$n"HIC"！\n" NOR, me, target);
me->add_temp("apply/attack", extra);
me->add_temp("apply/damage", extra);
for (i=0;i<=5;i++)
        {
        COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
        }
me->add_temp("apply/attack", -extra);
me->add_temp("apply/damage", -extra);
me->set_temp("dali-lianhuan_end", time());
me->receive_damage("sen", 100);
return 1;  
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("dali-chu")+" 200 级\n"; 
temp+= "\t\t"+to_chinese("stick")+" 200 级\n"; 
temp+= "\t\t内力修为十年\n"; 
temp+= "\t\t内力１０００点\n"; 
temp+= "\t\t精神３００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                连续攻击敌人
        出招类型： 
                延时型外功
                无隐藏攻击
                叛师不可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
