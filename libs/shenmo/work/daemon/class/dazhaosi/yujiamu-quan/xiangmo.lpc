
// write by windy 07/06/20
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 
string name()  

{
return "「"HIW"金刚降魔"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "大昭寺" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("yujiamu-quan", 1) < 300) 
        return notify_fail("你的金刚瑜伽母拳修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("unarmed", 1) < 300) 
        return notify_fail("你的扑击格斗之技修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("lamaism", 1) < 300) 
        return notify_fail("你的密宗佛法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_temp("yjq_xm") > time() ) 
        return notify_fail("你无法频繁施展"+name()+"！\n"); 
if((int)me->query("force") < 2000 ) 
        return notify_fail("你的内力不足！\n"); 
if((int)me->query("max_force") < 4000 ) 
        return notify_fail("你的内力修为太浅，难以施展"+name()+"！\n"); 
return 1;  
}

int perform(object me, object target)
{
string msg;
int extra, i;
object weapon;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

weapon = me->query_temp("weapon");
extra = me->query_skill("yujiamu-quan", 1) + me->query_skill("unarmed", 1)/2;
msg = HIW "\n$N"HIW"念了几句咒语，袍袖鼓动如风，双拳藏于袍袖之下，疾电般攻向$n"HIW"！\n" NOR;  
message_vision(msg, me, target); 
me->add_temp("apply/attack", extra); 
me->add_temp("apply/damage", extra); 
for (i=0;i<=5;i++)
        {
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR); 
        if( me->query_skill_mapped("force")=="longxiang" && me->query_skill_mapped("dodge")=="shenkong-xing") 
          SKILL_D("longxiang")->hit_ob(me,target,me->query_skill("longxiang",1) );
        }
me->add_temp("apply/attack", -extra); 
me->add_temp("apply/damage", -extra); 
me->add("force", -500); 
me->set_temp("yjq_xm",time()+3+random(3));
//me->start_busy(2+random(2));
return 1; 
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("yujiamu-quan")+" 300 级\n";  
temp+= "\t\t"+to_chinese("unarmed")+" 300 级\n";  
temp+= "\t\t"+to_chinese("lamaism")+" 300 级\n";  
temp+= "\t\t内力３０００点\n"; 
temp+= "\t\t内力修为四十年\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                连续打击对手的气血 
        出招类型：   
                延时型外功  
                无隐藏攻击  
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
