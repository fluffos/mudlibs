
// write by windy 07/06/20
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIR"金刚降世"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "大昭寺" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("yujiamu-quan", 1) < 200) 
        return notify_fail("你的金刚瑜伽母拳修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("unarmed", 1) < 200) 
        return notify_fail("你的扑击格斗之技修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("lamaism", 1) < 200) 
        return notify_fail("你的密宗佛法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("force") < 1000 ) 
        return notify_fail("你的内力不足！\n"); 
if((int)me->query("mana") < 1000 ) 
        return notify_fail("你的法力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
int ap, dp, damage;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

ap = me->query_skill("yujiamu-quan", 1);
ap = me->query_skill("lamaism", 1);
dp = target->query_skill("spells");
damage = me->query_skill("unarmed");
damage+= me->query("force_factor");
damage+= me->query("mana_factor");
damage+= random(damage);

message_vision(HIR"\n$N"HIR"突然跃入半空，大喝一声，面色赤红，双拳携劲风从天而降，击向$n"HIR"！"NOR,me,target);
if (random(ap+dp) > dp/3)
        {
        message_vision(HIR"\n$n"HIR"无法抵挡这雷霆一击，登时被打得金星乱迸，摇晃不定！\n"NOR,me,target);
        target->receive_damage("kee", damage*3, me);
        target->receive_damage("sen", damage*3, me);
        COMBAT_D->report_status(target, 0);
        COMBAT_D->report_sen_status(target, 0);
        me->add("force", -500);
        me->add("mana", -500);
        }
else    {
        message_vision(CYN"\n可是$n"CYN"并未被这气势所慑，轻移脚步，躲开了$N"CYN"的攻击。\n"NOR,me,target);
        me->add("force", -100);
        me->add("mana", -100);
        }
me->start_busy(2+random(2));
return 1;
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("yujiamu-quan")+" 200 级\n";  
temp+= "\t\t"+to_chinese("unarmed")+" 200 级\n";  
temp+= "\t\t"+to_chinese("lamaism")+" 200 级\n";  
temp+= "\t\t内力１０００点\n"; 
temp+= "\t\t法力１０００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                伤害对手的气血和精神
        出招类型：   
                busy 型外功  
                无隐藏攻击  
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
