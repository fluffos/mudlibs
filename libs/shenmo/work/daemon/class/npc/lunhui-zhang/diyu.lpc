#include <ansi.h>
inherit PERFORM;

int set_damage(object me)
{
int damage;
damage = me->query_skill("buddhism",1)/2;
damage+= me->query_skill("staff")/2;
damage+= me->query_skill("lunhui-zhang",1);
damage+= me->query("max_force");
//if ( damage>1000 ) damage = 1000;
damage = damage/30+random(damage)/30;
return damage;
}

void create()
{
set("name",HIG"地狱归来"NOR);			//pfm名
set("class","xian");					//class
//set("family","南海普陀山");				//门派
set("base_type","staff");
set("belong","lunhui-zhang");
set("betray_lvl",350);				//叛师能
set("target",1);					//战斗类
set("force",800);					//需要force
set("kee",100);					//需要kee  ----- 这里考虑做成mapping,不过时间不够，以后再说
set("limit_skill",([					//skill限制
	"buddhism"	:	60,
	"staff"	:	60,
	"lunhui-zhang":	60,
]));
set("need_force",200);				//消耗force
set("damage_type","eff_kee");				//伤害类型 kee eff_kee 
set("self_busy",3);					//发完busy	
set("busy_lost",2);
set("belong","lunhui-zhang");
set("base_type","staff");
set("persent",10050);                                     //命中率，具体参阅 /std/perform
}

void hit_msg(object me,object target,int num)
{
object weapon;
int damage;
if ( !me || !target || !present(target,environment(me)) )
	return;
damage=set_damage(me);
set("damage", damage);			//伤害
weapon = me->query_temp("weapon");
me->delete("env/brief_message");
target->delete("env/brief_message");
message_vision(HIY"\n
$N"HIY"口诵佛号，将全身功力注入手中"+weapon->name()+HIY"顿时间霞光四射，照得$n"HIY"睁不开眼！\n\n"NOR,me,target);
return;
}

void success_hit_msg(object me,object target,int num)
{
if ( !me || !target || !present(target,environment(me)) )
	return;
message_vision(HIY"$n"HIY"睁眼欲盲，正迟疑之际，胸口一阵剧痛，已挨了$N"HIY"重重的一击！\n\n"NOR,me,target);
return;
}

void lost_hit_msg(object me,object target,int num)
{
if ( !me || !target || !present(target,environment(me)) )
	return;
message_vision(HIY"$n"HIY"睁眼欲盲，举袖掩面，及时的避开了这一击！\n\n"NOR,me,target);
return;
}

void normal_hit_msg(object me)
{
object weapon;
if ( !me || !living(me) )
	return;
weapon = me->query_temp("weapon");
message_vision(HIY+weapon->name()+HIY"上霞光闪了几下，又渐渐黯淡下来，最后恢复了常态。\n\n"NOR,me);
return;
}


   
