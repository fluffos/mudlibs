#include <ansi.h>
inherit PERFORM;

void create() {

  set("name", HIC "佛门三渡" NOR);
  set("class", "xian");
  set("belong", "lunhui-zhang");
  set("base_type", "staff");
  set("target", 1);
  set("force", 500);
  set("need_force", 100);
  set("damage_type", "eff_kee");
  set("limit_skill", ([
    "lunhui-zhang": 100,
    "staff": 100,
    "lotusforce": 100,

  ]));
  set("busy_self", (3 + random(2)));
  set("busy_lost", (3 + random(2)));

  set("limit_other2", ([
    "bellicosity": 300,
  ]));
}

void hit_msg(object me, object target, int num) {
  int damage1, damage2, damage3, damage4, k;
  string msg = "";
  object weapon;
  weapon = me->query_temp("weapon");
  if (me && target && num == 1) {
    msg += HIW "$N默吟佛号，手中的" + weapon->query("name") + HIW "带一层淡淡的白雾直直拍向$n的胸前！\n
        这第一招名唤「渡劫」！\n" NOR;
  }

  if (num == 2) msg += HIW "$N手中" + weapon->query("name") + HIW "一振，白色劲气已然布满全身，风雷之声渐起，
        这第二式「渡难」猛然拍出！\n\n" NOR;
  if (num == 3) msg += HIW "$N梵唱又起，" + weapon->query("name") + HIW "象鼓满了风的劲帆，汹涌而出！
        「渡厄」一式之凶险显见佛家动嗔也会做“狮子吼”！\n\n" NOR;
  if (num == 4)
    msg += HIC "$N轻声禅唱“回头是岸”，周身七尺劲气涌动，这普陀佛门禅功的无上功力终化作「慈光普渡」澎湃而出！\n\n" NOR;

  message_vision(msg, me, target);

  damage1 = (50 + me->query_str() + random(me->query_skill("staff"))) / 2;
  damage2 = (100 + me->query_str() + random(me->query_skill("staff"))) / 2;
  damage3 = (150 + me->query_str() + random(me->query_skill("staff"))) / 2;
  damage4 = (200 + me->query_str() + random(me->query_skill("staff"))) / 2;
  if (me->query_skill(
    "lunhui-zhang",
    1
  ) > 149 && me->query_skill("staff", 1) > 149 && me->query_skill("lotusforce", 1) > 149) {
    set("special_hit", ([
      "num": 4,
      "temp_persent": ({ 150, 130, 120, 110 }),
      "temp_damage": ({ damage1, damage2, damage3, damage4 }),
      "success_next": ({ 0, 0, 0, 1 }),
      "fail_next": ({ 1, 1, 1, 1 }),
    ]));
  } else {
    set("special_hit", ([
      "num": 3,
      "temp_persent": ({ 150, 130, 120 }),
      "temp_damage": ({ damage1, damage2, damage3 }),
      "success_next": ({ 0, 0, 1 }),
      "fail_next": ({ 1, 1, 1 }),
    ]));
  }


  return;
}

void success_hit_msg(object me, object target, int num) {
  string msg;
  object weapon = me->query_temp("weapon");
  msg = "";
  if (num == 1) msg += HIR "$n心神一慌，一个躲闪不及，被$N的" + weapon->query("name") + HIR "实实在在的印在胸膛，\n$n的胸膛立刻就塌了下去！\n\n" NOR;
  if (num == 2) msg += HIR "$n正瞠目间，" + weapon->query("name") + HIR "已到了胸前，内劲一吐，\n$n立时口喷鲜血，倒飞出三丈有余！\n\n" NOR;
  if (num == 3) msg += HIR "$n被这弧形的汹涌劲气一罩，身法全乱，象喝醉了的东倒西歪！\n\n" NOR;
  if (num == 4) msg += HIR "$n似一片枯叶，被「慈光普渡」的劲气包围、卷起、压扁、抛下，\n重重的摔在地上，眼看是不行了！\n\n" NOR;
  message_vision(msg, me, target);

}

void lost_hit_msg(object me, object target, int num) {
  string msg;
  object weapon = me->query_temp("weapon");

  if (me && target) {
    msg = "";
    if (num == 1) msg += HIG "只见$n神色一凛，不敢硬接，一个翻身及时的退出战圈，躲开了$N凌厉的攻势！\n\n" NOR;
    if (num == 2) msg += HIG "$n躲无可躲，就地一滚，非常狼狈的堪堪躲开了这第二招。\n\n" NOR;
    if (num == 3) msg += HIG "$n临危不乱，看准来势，堪堪拆了这一招。\n\n" NOR;
    if (num == 4) msg += HIG "$n一颗流星般急退而出，总算从鬼门关上拣回了一条命。\n\n" NOR;
    message_vision(msg, me, target);
  }
}

int limit_other_msg(object me, object target, string name) {
  return notify_fail("你的杀气太重，无法施展佛门绝技。\n");
}
