#include <ansi.h>
inherit SSERVER;

string name() {
  return "「" HIC "超生渡化" NOR "」";
}

int valid_perform(object me) {
  if (me->query_temp("putuo_chaodu") + 8 > time())
    return notify_fail(name() + "需要8秒的冷却时间。\n");
  if (me->query_skill("lunhui-zhang", 1) < 80)
    return notify_fail("你的" + to_chinese("lunhui-zhang") + "等级不足" + 80 + "级，无法使出" + name() + "。\n");
  if (me->query("force") < 200)
    return notify_fail("你的真气不足" + 200 + "点，不能使用" + name() + "。\n");
  if (me->query("kee") < 500)
    return notify_fail("你的气血不足" + 500 + "点，不能使用" + name() + "。\n");
  return 1;
}

int perform(object me, object target) {
  string msg;
  int extra;
  object weapon;

  if (!valid_perform(me))
    return 0;
  if (!target)
    target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(name() + "只能对战斗中的对手使用。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "staff")
    return notify_fail("你使用的武器不对，无法施展" + name() + "。\n");
  if (!me->is_fighting())
    return notify_fail(name() + "必须在战斗状态下使用。\n");

  me->add("force", -100);
  me->receive_damage("kee", 200);
  me->add_temp("apply/damage", 350);
  me->add_temp("apply/attack", 350);

  msg = HIR "$N" HIR "缓缓说道：佛曰，以杀止杀！我今天就大开杀戒，代表佛来惩罚
你们这些顽恶之徒！\n" NOR;
  message_vision(msg, me, target);
  me->set_temp("putuo_chaodu", time());

  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    message_vision(HIY "\t\t天理循环，报应不爽！\n" NOR, me, target);
  me->set_temp("LUNHUI_perform", 0);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    message_vision(HIC "\t\t天网恢恢，疏而不漏！\n" NOR, me, target);
  me->set_temp("LUNHUI_perform", 3);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    message_vision(HIG "\t\t放下屠刀，立地成佛！\n" NOR, me, target);
  me->set_temp("LUNHUI_perform", 5);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    message_vision(HIW "\t\t$n" HIW "好象已经到了极乐世界．．．．\n" NOR, me, target);
  me->set_temp("LUNHUI_perform", 7);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  me->add_temp("apply/damage", -350);
  me->add_temp("apply/attack", -350);
  me->delete_temp("LUNHUI_perform");
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("lunhui-zhang") + " 80 级\n";
  temp += "\t\t真    气 200 点\n";
  temp += "\t\t气    血 500 点\n";
  temp += "\t\t战斗状态下\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                短时间内牺牲自身的气血来提高攻击
                并对敌人造成连续三次的攻击
        出招类型：
                延迟型外功
                350级可叛师带出
                无隐藏属性
        出手要求：              
HELP);
  write(temp);
  return 1;
}
