
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

void remove_effect(object me)
{
    if(me && me->query_temp("taiji")){
      me->add_temp("apply/damage", -(int)me->query_skill("taiji-shengong", 1)/5);
      me->add_temp("apply/armor", -(int)me->query_skill("taiji-shengong", 1)/5);
      me->delete_temp("taiji");
      tell_object(me,HIY"你的「太极神功」运功完毕，将内力收回丹田。\n"NOR);
      }
}
void check_fight(object me)
{
    if (!me) return;

    if (me->query_skill_mapped("force")!="taiji-shengong" ||
        !me->is_fighting() || me->query("force") < 10
        ) {
                remove_call_out("remove_effect"); 
                remove_effect(me);
                }
    else call_out("check_fight", 1, me);
}

int exert(object me)
{

      int i, z;

      if( !me->is_fighting() )
          return notify_fail("「太极神功」只能在战斗中对对手使用。\n");

      if( (int)me->query("force") < 800 || (int)me->query("max_force")<1200  ) 
                return notify_fail("你的内力不够。\n");
          if (  (me->query("family/family_name") != "武当派") && !me->samsara_check("taiji-shengong",1))                 return notify_fail("你不是武当弟子。\n");
      if( (int)me->query_temp("taiji") ) 
                return notify_fail("你已经在运功中了。\n");

      i = me->query_skill("taiji-shengong", 1)/5;
      z = me->query_skill("taiji-shengong", 1)/3;
      me->add("force", -500);

      message_vision(HIY "$N微一凝神，运起太极神功，全身灌满真气，衣裳无风自舞，气势迫人。\n" NOR, me);
      me->add_temp("apply/damage", i);
      me->add_temp("apply/armor", i);
      me->set_temp("taiji", 1);
      check_fight(me);
      call_out("remove_effect", z, me);
      return 1;
}


