
// write by windy 07/06/26
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIY"真武除邪"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "武当派" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("taiji-jian", 1) < 350) 
        return notify_fail("你的太极剑法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("sword", 1) < 350) 
        return notify_fail("你的基本剑术修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("taiji-shengong", 1) < 350) 
        return notify_fail("你的太极神功修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("tiyunzong", 1) < 350) 
        return notify_fail("你的梯云纵修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("taixu-spells", 1) < 350) 
        return notify_fail("你的太虚仙法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("max_force") < 4000 ) 
        return notify_fail("你的内力修为太浅，难以施展"+name()+"！\n"); 
if( me->query_temp("tjj_zhenwu") > time() )
        return notify_fail("你身体不适，难以施展"+name()+"！\n"); 
if((int)me->query("force") < 1000 ) 
        return notify_fail("你的内力不足！\n"); 
if((int)me->query("sen") < 500 ) 
        return notify_fail("你的精神不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
object weapon;
int ap, dp, damage; 

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

weapon = me->query_temp("weapon");
ap = me->query_skill("sword");
dp = target->query_skill("parry");
damage = me->query_skill("sword");
damage+= me->query_skill("taiji-shengong", 1);
damage+= me->query_skill("tiyunzong", 1);
damage+= me->query_skill("taixu-spells", 1);
damage+= random(damage);

message_vision(HIY"\n$N"HIY"跨前一步，平平挥出一剑，横扫$n"HIY"而去，毫无半点花巧可言。"NOR,me,target);
if (ap * 3 / 5 + random(ap) > dp * 4 / 5)
        {
        message_vision(HIY"\n结果$n"HIY"却丝毫未把这招放在眼里，随手应了一招，"NOR,me,target);
        message_vision(HIY"\n却见$N"HIY"剑势忽然一变，气象万千，变幻无穷，极具王者风范！\n"NOR,me,target);
        message_vision(HIR"\n$n"HIR"顿时惊慌失措，被$N"HIR"一剑击中要害，鲜血崩流，惨不忍睹！\n"NOR,me,target);
        target->receive_damage("kee", damage*2, me);
        target->receive_wound("kee", damage/2, me);
        target->receive_damage("sen", damage*2, me);
        target->receive_wound("sen", damage/2, me);
        COMBAT_D->report_status(target);
        COMBAT_D->report_sen_status(target);
        me->add("force", -500);
        me->receive_damage("sen", 200);
        }
else    {
        message_vision(HIC"\n可是$n"HIC"看透$N"HIC"招后更有杀招，镇定逾恒，全神应对自如。\n"NOR,me,target);
        me->add("force", -100);
        me->receive_damage("sen", 100);
        }
me->set_temp("tjj_zhenwu",time()+2+random(2));
//me->start_busy(1);
return 1;
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("taiji-jian")+" 350 级\n";  
temp+= "\t\t"+to_chinese("sword")+" 350 级\n";  
temp+= "\t\t"+to_chinese("taiji-shengong")+" 350 级\n";  
temp+= "\t\t"+to_chinese("tiyunzong")+" 350 级\n";  
temp+= "\t\t"+to_chinese("taixu-spells")+" 350 级\n";  
temp+= "\t\t内力修为四十年\n"; 
temp+= "\t\t内力１０００点\n"; 
temp+= "\t\t精神５００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                伤害对手的气血和精神
        出招类型：   
                延迟型外功  
                无隐藏效果
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
