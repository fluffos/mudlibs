// write by windy 07/06/26
#include <ansi.h>
#include <combat.h>
inherit F_DBASE;
inherit SSERVER;
void remove_effect(object me, object target, int amount);

string name() {
  return "「" HIB "随字诀" NOR "」";
}

int valid_perform(object me) {
  if (me->query("family/family_name") != "武当派" || me->query("class") != "saint")
    return notify_fail("你不够资格使用" + name() + "！\n");
  if ((int)me->query_skill("taiji-jian", 1) < 100)
    return notify_fail("你的太极剑不够熟练，施展不出" + name() + "! \n");
  if ((int)me->query_skill("tiyunzong", 1) < 100)
    return notify_fail("你的梯云纵不够熟练，施展不出" + name() + "! \n");
  if ((int)me->query_skill("dodge", 1) < 100)
    return notify_fail("你的基本轻功不够熟练，施展不出" + name() + "! \n");
  if ((int)me->query_skill("taiji-shengong", 1) < 100)
    return notify_fail("你的太极神功修为太浅，施展不出" + name() + "! \n");
  if ((int)me->query_skill("sword", 1) < 100)
    return notify_fail("你的基本剑法不够熟练，施展不出" + name() + "! \n");
  if ((int)me->query("force") < 50)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_temp("wudang_sui"))
    return notify_fail("你已经在运功中了。\n");
  return 1;
}

int perform(object me, object target) {
  int dodge_amount, attack_amount;
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用。\n");

  attack_amount = me->query_skill("sword") / 5;
  dodge_amount = me->query_skill("dodge") * (5 + random(6)) / 10;

  message_vision(HIB "$N" HIB "使出太极剑法「随」字诀，剑圈逐渐缩小将周身护住。\n" NOR, me);
  me->add("force", -50);
  me->add_temp("apply/attack", -attack_amount);
  me->add_temp("apply/dodge", dodge_amount);  //trade offense for defense.   
  me->set_temp("wudang_sui", 1);
  me->start_call_out((: call_other, __FILE__, "remove_effect",
    me, dodge_amount, attack_amount :), me->query_skill("sword") / 10);
  return 1;
}

void remove_effect(object me, int dodge_amount, int attack_amount) {
  me->add_temp("apply/dodge", -dodge_amount);
  me->add_temp("apply/attack", attack_amount);
  me->delete_temp("wudang_sui");
  message_vision(HIY "$N" HIY "的「随」字诀运行完毕，将内力收回丹田。\n" NOR, me);
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("taiji-jian") + " 100 级\n";
  temp += "\t\t" + to_chinese("taiji-shengong") + " 100 级\n";
  temp += "\t\t" + to_chinese("tiyunzong") + " 100 级\n";
  temp += "\t\t" + to_chinese("sword") + " 100 级\n";
  temp += "\t\t" + to_chinese("dodge") + " 100 级\n";
  temp += "\t\t内力５０点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                牺牲攻击力而猛增防御力
        出招类型：
                延时型外功
                无隐藏效果
                叛师不可带出
        出手要求：              
HELP);
  write(temp);
  return 1;
}
