
// write by windy 07/06/26
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name()  
{
return "「"HIY"连字诀"NOR"」";
}

int valid_perform(object me)
{
if (me->query("family/family_name")!="武当派" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if( (int)me->query_skill("taiji-jian", 1) < 200)
       return notify_fail("你的太极剑不够熟练，施展不出"+name()+"! \n");
if( (int)me->query_skill("sword", 1) < 200)
       return notify_fail("你的基本剑术不够熟练，施展不出"+name()+"! \n");
if( (int)me->query_skill("taiji-shengong", 1) < 200)
       return notify_fail("你的太极神功修为太浅，施展不出"+name()+"! \n");
if( (int)me->query("max_force") < 3000 )
        return notify_fail("你的内力修为太差！\n");
if( (int)me->query("force") < 2000 )
        return notify_fail("你现在内力太低！\n");
return 1;
}

int perform(object me, object target)
{
int ap, dp, myskill, i;
object weapon;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if( !me->is_fighting() )
        return notify_fail(name()+"只能在战斗中使用。\n");

weapon = me->query_temp("weapon");
ap = me->query_skill("sword", 1);
ap+= me->query_skill("taiji-shengong", 1);
dp = target->query_skill("parry", 1);
dp+= target->query_skill("force", 1);
myskill = me->query_skill("taiji-jian", 1);
myskill/= 100;
if (myskill>8)    myskill=8;

message_vision(HIY"\n$N"HIY"一声清啸，手中"+weapon->name()+""HIY"龙吟不定，化出一个个圆圈，把$n"HIY"圈在当中。"NOR,me,target);
if (ap / 2 + random(ap * 2) > dp)
        {
        message_vision(HIW"\n结果$n"HIW"被$N"HIW"攻了个措手不及，连连后退不暇！\n"NOR,me,target);
        for (i=0;i<=myskill;i++)
                {
                if( !target || !me->is_fighting(target) )
                        continue;
                if( me->query("force")<me->query("force_factor") || me->query("force")<100 )
                        {
                        tell_object(me,HIW"你发觉你的内力不继了！\n"NOR);
                        continue;
                        }
                if ( !me->query("env/no_msg") && !target->query("env/no_msg") ) 
                message_vision(HIY"\n$N剑招连绵不断，剑意层层叠叠！\n"NOR,me,target); 
                COMBAT_D->do_attack(me,target,weapon);
        if( me->query_skill_mapped("unarmed")=="taiji-quan" && me->query_skill_mapped("force")=="taiji-shengong" && me->query_skill_mapped("dodge")=="tiyunzong" ) {
            if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
               message_vision(HIY"\n$N"HIY"放下手中的"+weapon->name()+""HIY"，脚踏梯云纵，抬手舞太极！\n"NOR,me,target);
            if ( weapon && weapon==me->query_temp("weapon") )  weapon->unequip();
                COMBAT_D->do_attack(me, target);
            if ( weapon && weapon!=me->query_temp("weapon") )  weapon->wield();
        }
                }
        }
else    {
        message_vision(HIC"\n$n"HIC"见$N"HIC"这几剑并无破绽，不敢大意，聚精会神小心应付。\n"NOR,me,target);
        }
me->start_busy(2);
return 1;
}

int help(object me)
{
string temp;    
temp = "\t\t"+to_chinese("taiji-jian")+" 200 级\n";
temp+= "\t\t"+to_chinese("taiji-shengong")+" 200 级\n";
temp+= "\t\t"+to_chinese("sword")+" 200 级\n";
temp+= "\t\t内力修为三十年\n";
temp+= "\t\t内力２０００点\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP

        使用功效：
                连续打击对手气血
        出招类型：
                busy 型外功
                有隐藏效果
                叛师不可带出
        出手要求：              
HELP);  
write(temp);
return 1;
}
