// write by fang 2012-07-08
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() {
  return "「" HIW "剑意绵绵" NOR "」";
}

int valid_perform(object me) {
  if (me->query("family/family_name") != "武当派" || me->query("class") != "saint")
    return notify_fail("你不够资格使用" + name() + "！\n");
  if ((int)me->query_skill("taiji-jian", 1) < 800)
    return notify_fail("你的太极剑不够熟练，施展不出" + name() + "! \n");
  if ((int)me->query_skill("sword", 1) < 800)
    return notify_fail("你的基本剑术不够熟练，施展不出" + name() + "! \n");
  if ((int)me->query_skill("taiji-shengong", 1) < 800)
    return notify_fail("你的太极神功修为太浅，施展不出" + name() + "! \n");
  if ((int)me->query("max_force") < 8000)
    return notify_fail("你的内力修为太差！\n");
  if ((int)me->query("force") < 8000)
    return notify_fail("你现在内力太低！\n");
  if (time() - (int)me->query_temp("tj_mian") < 3 + random(3))
    return notify_fail("绝招用多了就不灵了！\n");

  return 1;
}

int perform(object me, object target) {
  int ap, dp, myskill, i;
  object weapon;
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用。\n");

  weapon = me->query_temp("weapon");
  myskill = me->query_skill("taiji-jian", 1);
  myskill /= 250;
  if (myskill > 8) myskill = 8;

  message_vision(
    HIW "\n$N" HIW "左手剑决斜引," + weapon->name() + "" HIW "横过，画个半圆，平搭在$n" HIW "手中的武器上。\n" NOR,
    me,
    target
  );
  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    message_vision(HIW "劲力传出,$n" HIW "招数中渐渐涩滞！\n" NOR, me, target);
  if (!target->is_busy()) target->start_busy(1);
  for (i = 0; i < myskill; i++) {
    if (!target || !me->is_fighting(target))
      continue;
    if (me->query("force") < me->query("force_factor") || me->query("force") < 100) {
      tell_object(me, HIW "你发觉你的内力不继了！\n" NOR);
      continue;
    }
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(HIW "$N以意运剑,剑招层出不穷！\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, weapon);
    if (me->query_skill_mapped("unarmed") == "taiji-quan" && me->query_temp("taiji") && objectp(weapon)) {
      weapon->set("apply/skill_type", "unarmed");
      weapon->set("skill_type", "unarmed");
      if (!me->query("env/no_msg") && !target->query("env/no_msg"))
        message_vision(HIW "$N的剑招变为拳招，$n一时不知如何应付！\n" NOR, me, target);
      me->reset_action();
      COMBAT_D->do_attack(me, target, weapon);
      weapon->set("apply/skill_type", "sword");
      weapon->set("skill_type", "sword");
      me->reset_action();

    }
  }
  me->set_temp("tj_mian", time());
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("taiji-jian") + " 800 级\n";
  temp += "\t\t" + to_chinese("taiji-shengong") + " 800 级\n";
  temp += "\t\t" + to_chinese("sword") + " 800 级\n";
  temp += "\t\t内力修为八十年\n";
  temp += "\t\t内力8０００点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                连续打击对手气血
        出招类型：
                延迟型外功
                有隐藏效果
                叛师不可带出
        出手要求：
HELP);
  write(temp);
  return 1;
}
