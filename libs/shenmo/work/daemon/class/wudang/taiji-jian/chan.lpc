// write by windy 07/06/23
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() {
  return "「" HIG "缠字诀" NOR "」";
}

int valid_perform(object me) {
  if (me->query("family/family_name") != "武当派" || me->query("class") != "saint")
    return notify_fail("你不够资格使用" + name() + "！\n");
  if ((int)me->query_skill("taiji-jian", 1) < 300)
    return notify_fail("你的太极剑不够熟练，施展不出" + name() + "! \n");
  if ((int)me->query_skill("taiji-shengong", 1) < 300)
    return notify_fail("你的太极神功修为太浅，施展不出" + name() + "! \n");
  if ((int)me->query("force") < 300)
    return notify_fail("你现在内力太低！\n");
  return 1;
}

int perform(object me, object target) {
  int ap, dp, myskill;
  object weapon;
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用。\n");
  if (target->is_busy())
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧。\n");

  ap = me->query("combat_exp") / 200000 + me->query("level") * me->query("level") / 500;
  dp = target->query("combat_exp") / 200000 + target->query("level") * target->query("level") / 500;
  myskill = me->query_skill("taiji-jian", 1) / 100;
  if (myskill > 10) myskill = 10;
  weapon = me->query_temp("weapon");

  message_vision(HIG "\n$N" HIG "使出太极剑法「缠」字诀，剑意圈转，连绵不绝，连递数个虚招企图扰乱$n" HIG "的攻势。" NOR, me, target);
  if (ap / 2 + random(ap / 4 * 3) > dp / 8 * 3) {
    message_vision(HIW "\n结果$n" HIW "被$N" HIW "闹个手忙脚乱，惊慌失措，呆在当场，不知如何应对！\n" NOR, me, target);
    target->start_busy(myskill);
  } else {
    message_vision(CYN "\n可是$n" CYN "看破了$N" CYN "的企图，镇定逾恒，全神应对自如。\n" NOR, me, target);
    me->start_busy(2 + random(2));
  }
  me->add("force", -300);
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("taiji-jian") + " 300 级\n";
  temp += "\t\t" + to_chinese("taiji-shengong") + " 300 级\n";
  temp += "\t\t内力５００点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                牵制对手
        出招类型：
                busy 型外功
                无隐藏效果
                叛师不可带出
        出手要求：              
HELP);
  write(temp);
  return 1;
}
