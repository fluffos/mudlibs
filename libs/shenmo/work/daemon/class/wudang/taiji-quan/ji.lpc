
// write by windy 07/06/23
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name()  
{
return "「"HIC"挤字诀"NOR"」";
}

int valid_perform(object me)
{
if (me->query("family/family_name")!="武当派" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if( (int)me->query_skill("taiji-quan", 1) < 200)
       return notify_fail("你的太极拳不够熟练，施展不出"+name()+"! \n");
if( (int)me->query_skill("taiji-shengong", 1) < 200)
       return notify_fail("你的太极神功修为太浅，施展不出"+name()+"! \n");
if( (int)me->query_skill("unarmed", 1) < 200)
       return notify_fail("你的扑击格斗之技不够熟练，施展不出"+name()+"! \n");
if( (int)me->query("force") < 500 )
        return notify_fail("你现在内力太低！\n");
if( (int)me->query("max_force") < 2000 )
        return notify_fail("你现在内力修为太差！\n");
if (time()-me->query_temp("wudang_ji")<=3+random(3))
        return notify_fail("绝招用多了就不灵了！\n");
return 1;
}

int perform(object me, object target)
{
int damage;
int ap, dp;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if( !me->is_fighting() )
        return notify_fail(name()+"只能在战斗中使用。\n");

ap = me->query_skill("unarmed");
dp = target->query_skill("parry");
damage = me->query_skill("taiji-quan", 1);
damage+= me->query_skill("taiji-shengong", 1);
damage+= me->query("force_factor");
damage-= target->query_temp("apply/armor")/3;
if (damage<100)    damage=100;

message_vision(HIC"\n$N"HIC"使出太极拳「挤」字诀，右脚实，左脚虚，右掌已搭住$n"HIC"左腕，横劲发力。"NOR,me,target);
if (ap/3+random(ap)>dp/2)
        {
        message_vision(HIR"\n$n"HIR"稍不留神，让$N"HIR"这么一挤，只觉全身力气犹似流入汪洋大海，无影无踪。\n"NOR,me,target);
        target->receive_damage("kee", damage*2+random(damage), me);
        target->receive_wound("kee", damage, me);
        COMBAT_D->report_status(target);
        if( (int)me->query_temp("taiji") && !target->is_busy() )
                {
                message_vision(HIY "同时，$N"HIY"体内太极神功激荡，$n"HIY"立时被挤得无法动弹。\n" NOR, me, target); 
                target->start_busy(1+random(2));
                }
        me->add("force", -300);
        }
else    {
        message_vision(CYN"\n$n"CYN"见状大吃一惊，急忙向后猛退数步，终于避开了$N"CYN"这一击。\n"NOR,me,target);
        me->add("force", -100);
        }
me->set_temp("wudang_ji", time());
return 1;
}

int help(object me)
{
string temp;    
temp = "\t\t"+to_chinese("taiji-quan")+" 200 级\n";
temp+= "\t\t"+to_chinese("taiji-shengong")+" 200 级\n";
temp+= "\t\t"+to_chinese("unarmed")+" 200 级\n";
temp+= "\t\t内力５００点\n";
temp+= "\t\t内力修为二十年\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP

        使用功效：
                伤害敌人的气血
        出招类型：
                延时型外功
                无隐藏效果
                叛师不可带出
        出手要求：              
HELP);  
write(temp);
return 1;
}
