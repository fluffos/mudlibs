// write by windy 07/06/23
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
string name() {
  return "「" HIY "粘字诀" NOR "」";
}

int valid_perform(object me) {
  if (me->query("family/family_name") != "武当派" || me->query("class") != "saint")
    return notify_fail("你不够资格使用" + name() + "！\n");
  if ((int)me->query_skill("taiji-quan", 1) < 120)
    return notify_fail("你的太极拳不够熟练，施展不出" + name() + "! \n");
  if ((int)me->query_skill("taiji-shengong", 1) < 120)
    return notify_fail("你的太极神功修为太浅，施展不出" + name() + "! \n");
  if ((int)me->query("force") < 1000)
    return notify_fail("你现在内力太低！\n");
  if ((int)me->query("kee") < 300)
    return notify_fail("你现在气力不足！\n");
  return 1;
}

int perform(object me, object target) {
  object weapon;
  int skill, ap, dp, tt;
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用。\n");
  if (target->is_busy())
    return notify_fail("对方已经够忙了。\n");

  ap = (me->query("combat_exp") / 200000 + 1) * me->query_int();
  dp = (target->query("combat_exp") / 200000 + 1) * target->query_int();
  weapon = me->query_temp("weapon");
  skill = me->query_skill("taiji-quan", 1);
  tt = skill / 100;
  if (tt > 3) tt = 3;
  message_vision(
    HIY "\n$N" HIY "左手带着$n" HIY "的右手，转了一个大圈，一股极强的螺旋力带动$n" HIY "全身，正是太极云手。" NOR,
    me,
    target
  );
  if (random(ap) > dp / 8) {
    message_vision(HIC "\n结果$n" HIC "被$N" HIC "带得跌跌撞撞，身不由主的立足不稳，犹如中酒昏迷。" NOR, me, target);
    message_vision(HIC "\n结果$N" HIC "这云手连绵不断，一圈过后，又是一圈，$n" HIC "已经完全被粘住了。\n" NOR, me, target);
    target->start_busy(tt);
  } else {
    switch (random(3)) {
      case 0: message_vision(CYN "\n$n" CYN "急忙使出“千斤坠”之力定住身形。\n" NOR, me, target);
      case 1: message_vision(CYN "\n$n" CYN "不敢便接，斜身闪开。\n" NOR, me, target);
      case 3: message_vision(
        CYN "\n$n" CYN "全身内力一震，$N" CYN "双手按他不住，被$n" CYN "跃出圈外！\n" NOR,
        me,
        target
      );
    }
    me->start_busy(2 + random(2));
  }
  me->add("force", -200);
  me->receive_damage("kee", 200);
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("taiji-quan") + " 120 级\n";
  temp += "\t\t" + to_chinese("taiji-shengong") + " 120 级\n";
  temp += "\t\t内力１０００点\n";
  temp += "\t\t气血３００点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                牵制敌人
        出招类型：
                busy型外功
                无隐藏效果
                叛师不可带出
        出手要求：              
HELP);
  write(temp);
  return 1;
}
