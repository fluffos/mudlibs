
// write by windy 07/06/23
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
string name()  
{
return "「"HIB"引字诀"NOR"」";
}

int valid_perform(object me)
{
if (me->query("family/family_name")!="武当派" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if( (int)me->query_skill("taiji-quan", 1) < 300)
       return notify_fail("你的太极拳不够熟练，施展不出"+name()+"! \n");
if( (int)me->query_skill("taiji-shengong", 1) < 300)
       return notify_fail("你的太极神功修为太浅，施展不出"+name()+"! \n");
if( (int)me->query("max_force") < 4000 )
        return notify_fail("你的内力修为太差！\n");
if( (int)me->query("force") < 1000 )
        return notify_fail("你现在内力太低！\n");
return 1;
}

int perform(object me, object target)
{
int dam;
int skill, ap, dp, i;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if( !me->is_fighting() )
        return notify_fail(name()+"只能在战斗中使用。\n");

ap = me->query_skill("taiji-shengong", 1);
ap+= me->query_skill("taiji-quan", 1);
dp = target->query_skill("force");
dam = me->query_temp("apply/damage")+target->query_temp("apply/damage");
skill = me->query_skill("taiji-quan", 1);
skill/= 150;
if (skill>9)    skill=9;

message_vision(HIW"\n$N"HIW"双手一圈，施出「引」字诀，如抱太极，一股雄浑无比的力道组成了一个旋涡，圈向$n"HIW"。"NOR,me,target);
if (random(ap+dp)>dp)
        {
        message_vision(HIR"\n$n"HIR"微微一楞，自己的招数登时被这力道一牵一引，全都往自己的身上招呼起来！\n"NOR,me,target);
        if( (int)me->query_temp("taiji") && !target->is_busy() )
                {
                message_vision(HIY "同时，$N"HIY"体内太极神功激荡，$n"HIY"立时被引得无法动弹。\n" NOR, me, target); 
                target->start_busy(1+random(2));
                }
        for (i=0;i<=skill;i++)
                {
                SDS_D->super_attack(target,target,dam,"HIB");
                }
        target->receive_damage("sen",10,me);
        me->add("force", -500);
        }
else    {
        message_vision(CYN"\n$n"CYN"见状连忙使出“千斤坠”之力定住身形，摆脱了$N"CYN"的力道。\n"NOR,me,target);
        me->add("force", -100);
        }
me->start_busy(2+random(2));
return 1;
}

int help(object me)
{
string temp;    
temp = "\t\t"+to_chinese("taiji-quan")+" 300 级\n";
temp+= "\t\t"+to_chinese("taiji-shengong")+" 300 级\n";
temp+= "\t\t内力１０００点\n";
temp+= "\t\t内力修为四十年\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP

        使用功效：
                借力打力，以彼制彼
        出招类型：
                busy型外功
                无隐藏效果
                叛师不可带出
        出手要求：              
HELP);  
write(temp);
return 1;
}
