
// write by windy 07/06/23
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name()  
{
return "「"HIR"震字诀"NOR"」";
}

int valid_perform(object me)
{
if (me->query("family/family_name")!="武当派" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if( (int)me->query_skill("taiji-quan", 1) < 150)
       return notify_fail("你的太极拳不够熟练，施展不出"+name()+"! \n");
if( (int)me->query_skill("taiji-shengong", 1) < 150)
       return notify_fail("你的太极神功修为太浅，施展不出"+name()+"! \n");
if( (int)me->query("force") < 1000 )
        return notify_fail("你现在内力太低！\n");
return 1;
}

int perform(object me, object target)
{
object weapon;
int damage;
int ap, dp;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if( !me->is_fighting() )
        return notify_fail(name()+"只能在战斗中使用。\n");

damage = (int)me->query_skill("force", 1);
damage+= random(damage);
damage/= 40;
if( damage > 100 )    damage = 100;
ap = me->query_skill("force");
dp = target->query_skill("force",1);

message_vision(HIW"\n$N"HIW"使出太极拳「震」字诀，左手高，右手低，陡然回圈，企图以内力震伤$n"HIW"！"NOR,me,target);
if (random(ap/3*4) > dp/2)
        {
        target->receive_damage("kee", target->query("max_kee")/100*damage, me);
        target->receive_wound("kee", target->query("max_kee")/300*damage, me);
        me->add("force", -damage*10);
        if (damage < 25)
                message_vision(YEL"\n结果$n"YEL"受到$N"YEL"一震，闷哼一声。\n"NOR,me,target);
        else if (damage < 50)
                message_vision(HIY"\n结果$n"HIY"被$N"HIY"以内力一震，「嘿」地一声退了两步。\n"NOR,me,target);
        else if (damage < 75)
                message_vision(RED"\n结果$n"RED"被$N"RED"以内力一震，胸口犹如受到一记重锤，连退了五六步！\n"NOR,me,target);
        else    message_vision(HIR"\n结果$n"HIR"被$N"HIR"以内力一震，眼前一黑，身子向后飞出丈许！\n"NOR,me,target);
        COMBAT_D->report_status(target);
        if( (int)me->query_temp("taiji") && !target->is_busy() )
                {
                message_vision(HIY "同时，$N"HIY"体内太极神功激荡，$n"HIY"立时被震得无法动弹。\n" NOR, me, target); 
                target->start_busy(1+random(2));
                }
        }
else    message_vision(CYN"\n可是$n"CYN"看破了$N"CYN"的企图，并没有上当。\n"NOR,me,target);
me->start_busy(2);
return 1;
}

int help(object me)
{
string temp;    
temp = "\t\t"+to_chinese("taiji-quan")+" 150 级\n";
temp+= "\t\t"+to_chinese("taiji-shengong")+" 150 级\n";
temp+= "\t\t内力１０００点\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP

        使用功效：
                伤害敌人的气血
                内功越高，威力越强
        出招类型：
                busy型外功
                无隐藏效果
                叛师不可带出
        出手要求：              
HELP);  
write(temp);
return 1;
}
