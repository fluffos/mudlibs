
// write by windy 07/06/26
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIR"刺腕"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "武当派" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("shenmen-jian", 1) < 300) 
        return notify_fail("你的神门十三剑修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("sword", 1) < 300) 
        return notify_fail("你的基本剑术修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("force") < 1000 ) 
        return notify_fail("你的内力不足！\n"); 
if (time()-me->query_temp("wudang_ciwan")<4+random(4))
        return notify_fail("绝招用多了就不灵了！\n"); 
return 1;
}

int perform(object me, object target)
{
object *ob, where;
int i, ap, dp;
object weapon, weapon2;
if ( !valid_perform(me) )
        return 0;
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

weapon = me->query_temp("weapon");
where=environment(me);
ob = all_inventory(environment(me));
ap = me->query_skill("sword");

message_vision(HIR"\n突然$N"HIR"一声冷哼，手中"+weapon->name()+""HIR"变幻无方，剑光疾若流星，“唰唰唰唰”攻向周围环伺的敌人！\n" NOR,me);
for(i=0; i<sizeof(ob); i++)
        {
        if( !living(ob[i]) || ob[i]==me ) continue;
        if(!ob[i]->is_fighting(me)) continue;
        dp = ob[i]->query_skill("parry");
        if (ap/3+random(ap) < dp/2)    continue;
        weapon2 = ob[i]->query_temp("weapon");
        if (weapon2)
                {
                message_vision(HIW"$n"HIW"只感觉手腕神门穴一凉，紧接着一阵剧痛，手中"+weapon->name()+""HIW"撒手扔在地上！\n" NOR,me,ob[i]);
                weapon2->move(environment(me));
               destruct(weapon2);
                }
        else    {
                message_vision(HIW"$n"HIW"只感觉手腕神门穴一凉，紧接着一阵剧痛，立时手忙脚乱！\n" NOR,me,ob[i]);
                if (!ob[i]->is_busy())    ob[i]->start_busy(1);
                }
        }
me->add("force", -500);
me->set_temp("wudang_ciwan", time());
return 1;
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("shenmen-jian")+" 300 级\n";  
temp+= "\t\t"+to_chinese("sword")+" 300 级\n";  
temp+= "\t\t内力１０００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                击落对手的武器或牵制对手
        出招类型：   
                延时型外功  
                同时袭击多个对手
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
