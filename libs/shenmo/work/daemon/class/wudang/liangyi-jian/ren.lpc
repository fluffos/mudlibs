
// write by windy 07/06/26
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name()  
{
return "「"HIC"天地同仁"NOR"」";
}

int valid_perform(object me)
{
if (me->query("family/family_name")!="武当派" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if( (int)me->query_skill("liangyi-jian", 1) < 200)
       return notify_fail("你的两仪剑法不够熟练，施展不出"+name()+"! \n");
if( (int)me->query_skill("sword", 1) < 200)
       return notify_fail("你的基本剑术不够熟练，施展不出"+name()+"! \n");
if( (int)me->query_skill("taiji-shengong", 1) < 200)
       return notify_fail("你的太极神功修为太浅，施展不出"+name()+"! \n");
if( (int)me->query("max_force") < 2000 )
        return notify_fail("你现在内力修为太差！\n");
if( (int)me->query("force") < 300 )
        return notify_fail("你现在内力太低！\n");
if (time()-me->query_temp("wudang_ren")<=3+random(3))
        return notify_fail("绝招用多了就不灵了！\n");
return 1;
}

int perform(object me, object target)
{
object weapon;
int ap, dp, damage;

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if( !me->is_fighting() )
        return notify_fail(name()+"只能在战斗中使用。\n");

weapon = me->query_temp("weapon");
ap = me->query("combat_exp")/200000+1;
dp = target->query("combat_exp")/200000+1;
damage = me->query_skill("sword");
damage+= me->query_skill("taiji-shengong", 1);
damage+= me->query_skill("taiji-quan", 1);
damage+= me->query_skill("taixu-spells", 1);
damage+= me->query_skill("tiyunzong", 1);
damage+= me->query("force_factor");
damage-= target->query_temp("apply/armor")/3;
if (damage<100)    damage=100;
damage+=random(damage/2);
damage *=2;

message_vision(HIC"\n$N"HIC"手中"+weapon->name()+""HIC"剑芒跃动，剑光暴长，剑尖颤动似乎分为左右刺向$n"HIC"！"NOR,me,target);
message_vision(HIC"\n$n"HIC"看到剑光偏左，疾侧身右转，但只这一刹，剑光刹时袭向右首！"NOR,me,target);
if (random(ap)>dp/3 || random(me->query("level"))>target->query("level")/3 || random(me->query_skill("force")) > target->query_skill("force")/3)
        {
        message_vision(HIR"\n$n"HIR"疾忙左转，却发现$N"HIR"的剑根本没有右偏，一式「天地同仁」已在"NOR,me,target);
        message_vision(HIR"\n$n"HIR"左胸留下一个血洞！$n"HIR"一低头，看到胸口鲜血涌泉喷出！\n"NOR,me,target);
        target->receive_damage("kee", damage, me);
        target->receive_wound("kee", damage/2, me);
        COMBAT_D->report_status(target);
        me->add("force", -300);
        }
else    {
        message_vision(HIY"\n可是$n"HIY"轻轻一笑，侧身右转，果然$N"HIY"的剑式突然左展，在$n"HIY"身前"NOR,me,target);
        message_vision(HIY"\n划过，仅差半寸。一根毫毛都没伤到。\n"NOR,me,target);
        me->add("force", -100);
        }
me->set_temp("wudang_ren", time());
return 1;
}

int help(object me)
{
string temp;    
temp = "\t\t"+to_chinese("liangyi-jian")+" 200 级\n";
temp+= "\t\t"+to_chinese("sword")+" 200 级\n";
temp+= "\t\t"+to_chinese("taiji-shengong")+" 200 级\n";
temp+= "\t\t内力修为二十年\n";
temp+= "\t\t内力３００点\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP

        使用功效：
                伤害敌人的气血
        出招类型：
                延时型外功
                无隐藏效果
                叛师不可带出
        出手要求：              
HELP);  
write(temp);
return 1;
}
