#include <ansi.h>
inherit SSERVER;

string name() {
  return "「" HIW "妖极天世" NOR "」";
}

int temp_time(object me) {
  return 1 + random(3);
}

int valid_perform(object me) {
  if ((me->query("family/family_name") != "三界山"
    || me->query("class") != "yao") && !me->samsara_check("tianyaofa"))
    return notify_fail("你是哪儿偷学来的武功，也想用" + name() + "？\n");
  if (time() - (int)me->query_temp("onebang_end") < 4 + random(2))
    return notify_fail("绝招用多就不灵了！\n");
  if (me->query_skill("tianyaofa", 1) < 100)
    return notify_fail("你的" + to_chinese("tianyaofa") + "等级不足" + 60 + "级，无法使出" + name() + "。\n");
  if (me->query("force") < 200)
    return notify_fail("你的真气不足 200 点，不能使出" + name() + "。\n");
  if (me->query("max_force") < 1000)
    return notify_fail("你的内力修为不足 1000 点，不能使出" + name() + "。\n");
  return 1;
}

int perform(object me, object target) {
  object weapon;
  int damage;

  if (!valid_perform(me))
    return 0;
  if (!target)
    target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(name() + "只能在战斗中使用。\n" NOR);
  if (!me->is_fighting())
    return notify_fail(name() + "必须战斗中使用。\n");

  weapon = me->query_temp("weapon");
  damage = me->query_temp("apply/damage");
  damage += me->query_temp("apply/attack");
  damage -= target->query_temp("apply/armor");
  damage += me->query_skill("tianyaofa", 1);
  damage /= 5;
  if (damage < 50) damage = 50;
  damage += me->query("force_factor") * 3;
  damage += random(damage);
  if (target->query("family/family_name") == "三界山")
    damage -= damage / 8;
  if (me->query("family/family_name") != "三界山")
    damage += damage / 8;
  if (COMBAT_D->restrain(target, me))
    damage -= damage / 5;
  if (COMBAT_D->restrain(me, target))
    damage += damage / 5;
  message_vision(
    HIW "\n$N" HIW "抡动手中的" + weapon->query("name") + HIW "，挂定风声，使了一招「妖极天世」砸向$n" HIW "！\n" NOR,
    me,
    target
  );
  me->add("force", -200);
  SDS_D->super_attack(me, target, damage, "NOR");
  if ((me->query("family/family_name") == "三界山" || me->samsara_check("tianyaofa", 1))
    && target->query("family/family_name") != "三界山")
    SDS_D->hitWeapon(me, target, weapon);
  if (wizardp(me)) tell_object(me, "damage=" + damage + "\n");
  if (damage > 500) target->receive_wound("kee", damage / 10);
  if ((me->query("family/family_name") == "三界山" || me->samsara_check(
    "tianyaofa",
    1
  )) && random(me->query("combat_exp")) > target->query("combat_exp") / 3
    && random(me->query("level")) > target->query("level") / 3 && me->query_skill(
      "tianyaofa",
      1
    ) > 350)
    target->receive_wound("kee", target->query("eff_kee") / 2);
  target->set_temp("last_damage_from", me);
  me->set_temp("onebang_end", time());
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("tianyaofa") + " 100 级\n";
  temp += "\t\t内力修为十年\n";
  temp += "\t\t内力２００点\n";
  temp += "\t\t战斗状态下使用\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                牺牲自身的速度给予敌人
                较大的打击，并有可能打
                击对方的武器
        出招类型：
                延时型外功
                有隐藏攻击
                不可叛师带出
        出手要求：              
HELP);
  write(temp);
  return 1;
}
