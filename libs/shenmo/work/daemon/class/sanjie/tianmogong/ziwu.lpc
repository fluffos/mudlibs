// ziwu.c 紫雾迷踪
// /daemon/class/sanjie/tianmogong/ziwu.c
// writted by windy 2006/11

inherit SSERVER;
#include <ansi.h>

int cast(object me) {
  int howlong;
  int spell;
  spell = me->query_skill("spells") / 2 + me->query_skill("tianmogong");
  if ((me->query("family/family_name") != "三界山" && me->query("spskk") != 13 || me->query("class") != "yao") && !me->samsara_check(
    "tianmogong",
    1
  ))
    return notify_fail("紫雾迷踪是三界山不传之秘。\n");
  if (spell < 300)
    return notify_fail("你法术修为太浅。\n");

  if ((int)me->query("mana") < 2 * (int)me->query_skill("spells"))
    return notify_fail("你的法力不够了！\n");

  if ((int)me->query("sen") < 50)
    return notify_fail("你的精神无法集中！\n");
  if (me->query_temp("in_dart"))
    return notify_fail("你一想到自己镖车在身，责任重大，就打消了藏匿形迹的念头！\n");


  message_vision("$N将天魔功融会贯通，魔力通达四肢百骸，身后渐渐升腾起一团紫雾。\n", me);

  if (random(me->query("max_mana")) < 100) {
    me->add("mana", -(int)me->query_skill("spells"));
    me->receive_damage("sen", 10);
    message("vision", "然而紫雾似乎不够浓烈，没起到什么作用。\n", environment(me));
    return 5 + random(5);
  }

  me->add("mana", -2 * (int)me->query_skill("spells"));
  me->receive_damage("sen", 20);

  howlong = 10 + random((me->query_skill("spells") - 100));
  if (me->query("env/invisibility"))
    return notify_fail("你已经在隐身了！\n");

  me->set("env/invisibility", 2);
  me->set_temp("yinshen/start", time());
  me->set_temp("yinshen/time", howlong);
  me->set_temp("yinshen/msg", HIR "\n紫雾渐渐散去，你显出身来!\n" NOR);
  me->set_temp("no_heal_up/wanying", 1);

  message_vision(MAG "\n紫雾越来越浓，弥漫四周，笼罩之下，$N不见了身影。\n\n" NOR, me);

  return 5 + random(5);
}

void free(object user, int howlong) {
  if (!user) return;
  if (!user->query("env/invisibility")) return;
  if (user->query_temp("wanyingtime") - howlong) {
    user->set_temp("wanyingtime",
      user->query_temp("wanyingtime") - howlong);
    call_out("free", user->query_temp("wanyingtime"),
      user, user->query_temp("wanyingtime"));
    return;
  }
  user->delete_temp("wanyingtime");
  user->set("env/invisibility", 0);
  user->save();
  message_vision(MAG "\n紫雾渐渐散开，$N从中走了出来。\n\n" NOR, user);
  user->delete_temp("no_heal_up/wanying");
  return;
}
