// liushen.c 六神合一

#include <ansi.h>

inherit SSERVER;

string name()  
{
return "「"HIR"六神合一"NOR"」";
}

int valid_perform(object me)
{
        if( (me->query("family/family_name") != "三界山" || me->query("class")!="yao") && !me->samsara_check("liushenjue",1))
                return notify_fail(name()+"只有三界山门人才可以用！\n");

        if((int)me->query("force") < 500 )
                return notify_fail("你的内力不够！\n");

        if((int)me->query("kee") < 300 )
                return notify_fail("你的气血不足，没法子施用外功！\n");

        if((int)me->query_skill("liushenjue", 1) < 100)
                return notify_fail("你的六神诀级别还不够，使用这一招会有困难！\n");

return 1;
}

int perform(object me, object target)
{
        object weapon;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
        if(!me->is_fighting())
                return notify_fail(name()+"只能在战斗中使用！\n");

	me->delete("env/brief_message");

	message_vision(HIR"\n$N大喝一声“六神合一”！\n"NOR, me);


	me->set_temp("liushenjue_per", 6);
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

	me->delete_temp("liushenjue_per");

	me->receive_damage("kee", 50);
	me->add("force", -100);

        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }

	me->start_busy(2);
	return 1;
}
int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("liushenjue")+" 100 级\n"; 
temp+= "\t\t气血３００点\n"; 
temp+= "\t\t内力５００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                给敌人强有力的一击
        出招类型： 
                busy型外功
                无隐藏攻击 
                叛师不可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
