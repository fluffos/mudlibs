//sanjie huxiaojian之pfm
//天吼八式 hou.c

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target)
{
string msg;
int extra;
int orforce,orff;
object weapon;
if(me->is_busy())
	return notify_fail("你现在没空！！\n");
if(me->query("family/family_name")!="三界山")
	return notify_fail(HIM"想偷用别人的功夫?你还真是个天才呀!\n");


extra = me->query_skill("sword");
if ((int)me->query_skill("huxiaojian", 1) < 150) 
           return notify_fail("你的虎啸皇剑还不够纯熟！\n");

if( !target ) target = offensive_target(me);

if( !target
||    !target->is_character()
||    !me->is_fighting(target) )
	return notify_fail("[ 天吼八式 ]只能对战斗中的对手使用。\n");
                
if((int)me->query("force") < 500 )
	return notify_fail("你的内力不足！\n");

if((int)me->query("sen") < (int)(me->query("max_sen")/2) )
	return notify_fail("你的精神不足，没法子施展[ 天吼八式 ]！\n");

orff=(int)me->query("force_factor");
orforce=(int)me->query("force");
me->add_temp("apply/damage",extra/10);
me->add_temp("apply/parry",extra/10);
me->add_temp("apply/dodge",extra/10);
weapon = me->query_temp("weapon");
//前四式
msg = HIY  "$N手中宝剑突然向上一挑，使出了本门绝学[ 天吼八式 ]之势，\n一时间惊天地的皇家霸气笼罩住四周!!\n"NOR;
message_vision(msg,me,target);

msg = HIR  "$N大喝一声：“定江山！”\n" NOR;
message_vision(msg,me,target);
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

msg = HIW  "$N须发皆张，大吼一声：“破胡虏！”\n" NOR;
message_vision(msg,me,target);
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

msg = HIM  "$N稍稍平息内息，攻势大开大阖，好一式“整河山”！\n" NOR;
message_vision(msg,me,target);
COMBAT_D->do_attack(me,target, me->query_temp("weapon")); 

msg = HIC  "$N以攻为守，一式“天地在心”攻守兼备！\n" NOR;
message_vision(msg,me,target);
COMBAT_D->do_attack(me,target, me->query_temp("weapon")); 

if ((int)me->query_skill("huxiaojian", 1) < 300) 
	{
	target->start_busy(2+random(2));     
	me->start_busy(1+random(2));     
	me->set("force",orforce-300);
	me->add_temp("apply/damage",-extra/10);
	me->add_temp("apply/parry",-extra/10);
	me->add_temp("apply/dodge",-extra/10);

	}
else     {
	if((int)me->query("force") < 500 )
		return notify_fail("你的内力不足，无法再续击！\n");
	if( !target
	||    !target->is_character()
	||    !me->is_fighting(target) )
		return notify_fail("你蓄劲欲发，可惜对手已是力不从心。\n");

	//后四式
	me->add("force_factor",extra/4);
	me->add_temp("apply/attack",extra);
	me->add_temp("apply/damage",-extra/10);
	me->add_temp("apply/damage",extra);
	weapon = me->query_temp("weapon");

	msg = HIY  "$N气息渐稳，向踏上一步，霸气益弥!!\n"NOR;
	message_vision(msg,me,target);
	msg = HIB  "$N一声大吼：“破生死！”\n" NOR;
	message_vision(msg,me,target);
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),msg);
	msg = HIW  "$N转守为攻，暴风骤雨般连发三击!\n" NOR;
	msg+=HIC"情已死！\n"NOR;
	message_vision(msg,me,target);
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"));
	msg = HIM  "心已死！\n" NOR;
	message_vision(msg,me,target);
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"));
	msg = HIB  "天地死！\n" NOR;
	message_vision(msg,me,target);
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"));
	me->start_busy(1+random(2));     
	me->set("force_factor",orff);
	me->set("force",orforce-300);
	me->add_temp("apply/attack",-extra);
	me->add_temp("apply/damage",-extra);
	me->add_temp("apply/parry",-extra/10);
	me->add_temp("apply/dodge",-extra/10);

	}

return 1;
}
 
