
//write by windy 06-05-23
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() 
{
return "「"HIY"天吼八式"NOR"」";   
}

int valid_perform(object me) 
{
if ( !me )   return 0; 
if( (me->query("family/family_name")!="三界山"
  || me->query("class")!="yao" ) && !me->samsara_check("huxiaojian",1))
        return notify_fail("只有三界山门人才能使用"+name()+"！\n"); 
if(me->query_skill("huxiaojian", 1) < 250 ) 
    return notify_fail("你的虎啸皇剑修为太浅，还施展不出"+name()+"！\n"); 
if(me->query_skill("sword", 1) < 250 ) 
        return notify_fail("你的基本剑术修为太浅，还施展不出"+name()+"！\n"); 
if(me->query_skill("huntianforce", 1) < 250 ) 
        return notify_fail("你的混天宝鉴修为太浅，还施展不出"+name()+"！\n"); 
if(me->query_skill("force", 1) < 250 ) 
        return notify_fail("你的内功心法修为太浅，还施展不出"+name()+"！\n"); 
if((int)me->query("max_force") < 2500 ) 
        return notify_fail("你的内力修为太差。\n"); 
if((int)me->query("force") < 1000 ) 
        return notify_fail("你的内力不足！\n"); 
return 1; 
}

int perform(object me, object target)
{
object weapon;
int extra,lvl,damage;
string msg; 
if ( !valid_perform(me) ) 
        return 0;   
if( !target ) target = offensive_target(me);
if( !target
||      !target->is_character()
||      target->is_corpse()
||      target==me) 
                return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n"); 

weapon = me->query_temp("weapon");
extra=me->query_skill("sword", 1)/5;
extra+=me->query_skill("force", 1)/5;
lvl=me->query_skill("huxiaojian", 1);

msg = HIY  "$N手中"+weapon->query("name")+HIY"突然向上一挑，使出了本门绝学「天吼八式」，一时间震惊天地的皇家霸气笼罩四周!\n\n"NOR;
message_vision(msg,me,target);
me->add_temp("apply/attack",extra);
me->add_temp("apply/damage",extra);
msg = HIR  "$N大喝一声：“定江山！”\n" NOR; 
message_vision(msg,me,target); 
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

msg = HIW  "$N须发皆张，大吼一声：“破胡虏！”\n" NOR; 
message_vision(msg,me,target); 
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg); 

msg = HIM  "$N稍稍平息内息，攻势大开大阖，好一式“整河山！”\n" NOR; 
message_vision(msg,me,target); 
COMBAT_D->do_attack(me,target, me->query_temp("weapon"));

msg = HIY  "$N气息渐稳，向前踏上一步，霸气益彰！\n"NOR; 
message_vision(msg,me,target); 
COMBAT_D->do_attack(me,target, me->query_temp("weapon"));
me->add_temp("apply/attack",-extra);
me->add_temp("apply/damage",-extra);

if (lvl>599)
        {
        msg = HIW  "紧跟着$N又是一声怒吼，暴风骤雨般连发四击!\n\n" NOR; 
        message_vision(msg,me,target); 
        damage=me->query_skill("huntianforce", 1);
        damage+=me->query("level")*2;
        damage+=me->query("force_factor")*2;
        damage=damage/3+random(damage/2);
        if (random(me->query("level"))>target->query("level")/5 && random(me->query("combat_exp"))>target->query("combat_exp")/5)
                {
                msg = HIR  "$N一声大吼：“破生死！”\n" NOR; 
                message_vision(msg,me,target);
                target->receive_damage("kee",damage,me);
                target->receive_wound("kee",damage*3/4,me);
                COMBAT_D->report_status(target);
                msg=HIC"情已死！\n"NOR; 
                message_vision(msg,me,target);
                target->receive_damage("kee",damage,me);
                target->receive_wound("kee",damage*3/4,me);
                COMBAT_D->report_status(target);
                msg = HIM  "心已死！\n" NOR; 
                message_vision(msg,me,target);
                target->receive_damage("kee",damage,me);
                target->receive_wound("kee",damage*3/4,me);
                COMBAT_D->report_status(target);
                msg = HIW  "天地死！\n" NOR; 
                message_vision(msg,me,target);
                target->receive_damage("kee",damage,me);
                target->receive_wound("kee",damage*3/4,me);
                COMBAT_D->report_status(target);
                }
        else    {
                message_vision(HIW"$n"HIW"心叫不妙，狼狈地向后一跃，躲开了$N强大的攻势！\n"NOR,me, target);
                if (!target->is_busy())
                target->start_busy(1);
                }
        me->add("force", -400);
        }
me->start_busy(2);
return 1;
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("huxiaojian")+" 250 级\n"; 
temp+= "\t\t"+to_chinese("sword")+" 250 级\n"; 
temp+= "\t\t"+to_chinese("huntianforce")+" 250 级\n"; 
temp+= "\t\t"+to_chinese("force")+" 250 级\n"; 
temp+= "\t\t内力修为二十五年\n"; 
temp+= "\t\t内力１０００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                连续打击对手的气血，
                或者牵制敌人
        出招类型： 
                busy 型外功
                有隐藏攻击
                叛师不可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
