
// modify by windy 06/05/23
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIY"金丝缠"NOR"」";  
}

int valid_perform(object me)
{
if (me->query("family/family_name") != "三界山" && me->query_skill("huxiaojian", 1) < 350 )  
        return notify_fail("以你现在的修为还施展不出"+name()+"！\n");  
if ( me->query("class")!="yao" && !me->samsara_check("huxiaojian"))
        return notify_fail("你还不够资格！\n"); 
if (me->query_skill("huxiaojian", 1) < 60)
        return notify_fail("你的虎哮皇剑还不够纯熟！\n"); 
if ( me->query("force")<100 ) 
        return notify_fail("你内力不够，强行运功会害了自己!\n"); 
if ( me->query("sen")<50 ) 
        return notify_fail("你元神不济,强行运功会害了自己!\n"); 
return 1;  
}

int perform(object me, object target)
{
string msg;
int delay, mysword;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

mysword=(int)me->query_skill("huxiaojian",1);
delay=mysword/100;
if (delay<2)  delay=2;
if (delay>6)  delay=6;
if( target->is_busy() )
        return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧！\n");

message_vision(HIY"$N激战中突然画出一道金光，身形灵动，动作变得诡异起来！\n\n"NOR,me, target); 
if(random(me->query("combat_exp")) > (int)target->query("combat_exp")/3 && random(me->query("level")) > target->query("level")/3)
        {
        message_vision(HIR"$n"HIR"顿时觉得眼前金光一闪，不由自主的跟着$N的剑招走动！\n"NOR, me, target); 
        target->start_busy(delay);
        }
else    {
        message_vision(HIB"结果$N自己转了个头晕眼花！手脚顿时慢了下来.\n"+NOR,me);
        me->start_busy(2+random(1));
        }
return 1;
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("huxiaojian")+" 60 级\n"; 
temp = "\t\t内力１００点\n"; 
temp = "\t\t精神５０点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                牵制对手
        出招类型： 
                busy型外功
                无隐藏攻击
                叛师可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
