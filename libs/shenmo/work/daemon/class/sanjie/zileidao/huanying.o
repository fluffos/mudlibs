#include <ansi.h>
inherit PERFORM;

int set_damage()
{
int damage;
object me = this_player();
damage=(int)me->query_skill("blade")+random((int)me->query_skill("blade")); 
damage+= me->query_temp("apply/damage");
damage+= me->query("force_factor")*2;
return damage;
}

int check_time()
{
object me = this_player();
int time = 10+random(5);
if ( me->query_skill("zileidao",1)>350 )
    time = 1+random(5);
else if ( me->query_skill("zileidao",1)>250 )
    time = 3+random(5);
else if ( me->query_skill("zileidao",1)>150 )
    time = 5+random(5);
return time;
}

void create()
{
int damage;
set("name","「无形幻影」");
set("class","yao");
set("belong","zileidao");
set("persent",200);
set("base_type","blade");
set("target",1);
set("force",800);
set("need_force",100);
set("betray_lvl",350);
set("damage_type","eff_kee");
set("limit_skill",([
    "zileidao" : 100,
    "huntianforce" : 100,
    "force":120,
]));
set("limit_other",([
    "sen"   : 400,
]));
set("temp","huanying_busy");
set("temp_time",(: check_time :) );
}

void hit_msg(object me,object target,int num)
{
string msg;
if ( me && target&&num==1 )
	{
           set("damage",(: set_damage :) );
     msg = HIC "$N大喝一声，全场四处游动，$n只看到$N化做数团身影，漫天刀光席卷而来，\n $n奋力一架，但$N刀分数路，$n只架住一刀！\n"NOR; 
     message_vision(msg,me,target);
	}
}

void success_hit_msg(object me,object target,int num)
{
string msg;
if ( me && target )
	{
              message_vision(HIC"\n$n根本没法躲避，顿时几刀都砍在$n肩头！\n"+HIR"$n鲜血溅起，$n自觉眼前一片鲜红，遮住视线！\n"NOR,me,target); 
	}
}

void lost_hit_msg(object me,object target,int num)
{
string msg;
if ( me && target )
	{
              message_vision(HIY"\n可是$p早以看出那是虚招，毫不在意地坦然面对，果真只有架住的是实招。\n"NOR,me,target); 
	}
}
void remove_eff(object me,string temp_data)
{
if ( !me )	return;
temp_data = "huanying_busy";

if( (int)me->query_temp(temp_data) )
   {
   me->delete_temp(temp_data);
   message_vision(RED"$N将手中宝刀抹了几抹。\n"NOR,me);
   }
return;
}

void remove_eff_msg( object me )
{
     string msg;
     if( me )
     {
           msg = HIB"\n漫天刀光，渐渐散去\n"NOR;
           message_vision( msg ,me );
         }
}

int limit_other_msg( object me ,object target , string str )
{
      if( me )
      {
           tell_object( me,"你的精神不够，无法施展无形幻影\n");
         }
          return 1;
}
int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("zileidao")+" 100 级\n"; 
temp+= "\t\t"+to_chinese("huntianforce")+" 100 级\n"; 
temp+= "\t\t"+to_chinese("force")+" 100 级\n"; 
temp+= "\t\t精神４００点\n"; 
temp+= "\t\t内力８００点\n"; 
write(@HELP 
紫雷刀法　之　「无形幻影」：

。
        使用功效： 
                给对手强有力的一击
        出招类型： 
                延时型外功
                无隐藏攻击 
                叛师可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
