
// modify by windy 06/05/21
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIB"天打雷劈屠真龙"NOR"」";  
}

int valid_perform(object me)
{
if (me->query("family/family_name") != "三界山" && me->query_skill("zileidao",1) < 350) 
        return notify_fail("你还不够资格使用"+name()+"！\n"); 
if ( me->query("class")!="yao" && !me->samsara_check("zileidao"))
        return notify_fail("你还不够资格！\n"); 
if(me->query_skill("zileidao", 1) < 180) 
        return notify_fail("你的紫雷刀法修为太差，难以施展"+name()+"！\n"); 
if(me->query_skill("blade", 1) < 180) 
        return notify_fail("你的基本刀法修为太差，难以施展"+name()+"！\n"); 
if(me->query_skill("force", 1) < 180) 
        return notify_fail("你的内功心法修为太差，难以施展"+name()+"！\n"); 
if( time()-(int)me->query_temp("tulong_end") < 2+random(4) ) 
        return notify_fail("你频繁使用天雷，也不怕雷公烦？\n"); 
if((int)me->query("max_force") < 1200 ) 
        return notify_fail("你的内力修为不够！\n"); 
if((int)me->query("force") < 600 ) 
        return notify_fail("你的内力不足！\n"); 
if((int)me->query("sen") < 400 ) 
        return notify_fail("你的精神难以集中！\n"); 
return 1;  
}

int perform(object me, object target)
{
string msg;
int extra, lvl, i;
object weapon;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

weapon = me->query_temp("weapon");
extra = me->query_skill("zileidao",1) / 10;
extra += me->query_skill("blade",1) / 10;
extra += me->query_skill("huntianforce",1) / 10;
if (me->query("family/family_name")=="三界山")
extra += me->query("level")/8;

lvl=me->query_skill("zileidao",1)/100;
if (lvl<3)  lvl=3;
if (lvl>7)  lvl=7;
message_vision(HIC"\n$N舌绽春雷，暴喝一声，雷霆霹雳般连续向$n"HIC"攻出了"+chinese_number(lvl)+"招！\n\n"NOR,me,target);
me->add_temp("apply/attack", extra);    
me->add_temp("apply/damage", extra);
if ((random(me->query("level")) > target->query("level")/2) && !target->is_busy())
target->start_busy(1);
for(i=0;i<lvl;i++)
        {
          if( !me || !target || !me->is_fighting(target) )  continue;
        if ( !me->query("env/no_msg") && !target->query("env/no_msg") ) 
        message_vision(HIC"\n$N刀光霍霍，天地间紫雷滚滚！\n"NOR,me,target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
        }
if( (me->query("family/family_name")=="三界山" || !me->samsara_check("zileidao",1))&& me->query_skill("zileidao",1)>799)
        {
        message_vision(HIY"\n$N意犹未尽，催动内力，一道金色刀芒从"+weapon->query("name")+HIY"之中激射而出！\n"NOR,me,target);
        target->receive_damage("kee", extra);
        target->receive_wound("kee", extra);
        COMBAT_D->report_status(target);
        }
me->add_temp("apply/attack", -extra);
me->add_temp("apply/damage", -extra);
me->add("force", -200);
me->add("sen", -50);
me->set_temp("tulong_end", time());
return 1;  
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("zileidao")+" 180 级\n"; 
temp+= "\t\t"+to_chinese("blade")+" 180 级\n"; 
temp+= "\t\t"+to_chinese("force")+" 180 级\n"; 
temp+= "\t\t内力修为十二年\n"; 
temp+= "\t\t内力８００点\n"; 
temp+= "\t\t精神４００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                连续伤害敌人的气血并有可能牵制敌人
        出招类型： 
                延时型外功
                有隐藏攻击
                叛师可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
