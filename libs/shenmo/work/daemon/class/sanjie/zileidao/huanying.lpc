
// modify by windy 06/05/21
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIC"无形幻影"NOR"」";  
}

int valid_perform(object me)
{
if((me->query("family/family_name") != "三界山" || me->query("class")!="yao") && !me->samsara_check("zileidao",1))
        return notify_fail("只有三界山弟子才能使用"+name()+"！\n"); 
if(me->query_skill("zileidao", 1) < 100) 
        return notify_fail("你的紫雷刀法修为太差，难以施展"+name()+"！\n"); 
if(me->query_skill("blade", 1) < 100) 
        return notify_fail("你的基本刀法修为太差，难以施展"+name()+"！\n"); 
if(me->query_skill("huntianforce", 1) < 100) 
        return notify_fail("你的混天宝鉴修为太差，难以施展"+name()+"！\n"); 
if( time()-(int)me->query_temp("huanying_end") < 4+random(2) ) 
        return notify_fail("绝招用多了就不灵了！\n"); 
if((int)me->query("max_force") < 500 ) 
        return notify_fail("你的内力修为不够！\n"); 
if((int)me->query("force") < 300 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
int damage; 
string msg; 
object weapon; 

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

weapon = me->query_temp("weapon");
damage=me->query_skill("zileidao",1);
damage+=me->query_skill("blade",1);
damage+=me->query_skill("huntianforce",1);
damage+=me->query("force_factor");
damage=damage/3 + random(damage/2);

msg = HIC "$N大喝一声，全场四处游动，$n"HIC"只看到$N化做数团身影，漫天刀光席卷而来！\n"NOR;
if (random(me->query("combat_exp")) > (int)target->query("combat_exp")/3 || random(me->query_skill("zileidao")) > target->query_skill("parry")/2)
        {
        msg += HIR"$n根本没法躲避，顿时数刀都砍在$n"HIR"肩头！鲜血溅起，$n"HIR"自觉眼前一片鲜红，遮住视线！\n"NOR;
        target->receive_damage("kee", damage, me); 
        target->receive_wound("kee", damage/3*2, me); 
        me->add("force", -300);
        message_vision(msg, me, target); 
        COMBAT_D->report_status(target);
        }
else    {
        msg += HIY"可是$p"HIY"早以看出那是虚招，毫不在意地坦然面对，果真只有架住的是实招。\n"NOR; 
        me->add("force", -100);
        message_vision(msg, me, target); 
        }
me->set_temp("huanying_end", time());
return 1;  
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("zileidao")+" 100 级\n"; 
temp+= "\t\t"+to_chinese("blade")+" 100 级\n"; 
temp+= "\t\t"+to_chinese("huntianforce")+" 100 级\n"; 
temp+= "\t\t内力修为五年\n"; 
temp+= "\t\t内力３００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                强力伤害敌人的气血
        出招类型： 
                延时型外功
                无隐藏攻击
                叛师不可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
