
#include <ansi.h>
inherit SSERVER;

int perform(object me, object target)
{       
        int damage;
        object weapon;

        if( !target ) target = offensive_target(me);
        if( !target || !target->is_character()
           || !me->is_fighting(target) || !living(target) )
                return notify_fail("「天惊五击」只能在战斗中使用。\n");

	 if(me->query("family/master_id") != "xiang yu")
	  	  return notify_fail("非项羽亲自传授，无法使用此招！\n");
  
        if (me->query_skill_mapped("blade") != "zileidao")
                return notify_fail("你现在无法使用「天惊五击」进行攻击。\n");     
                                                                            
        if( (int)me->query("max_force") < 1500 )
                return notify_fail("你的内力修为太弱，不能使用「天惊五击」！\n");

        if( (int)me->query("force") < 200+me->query("force_factor"))
                return notify_fail("你的真气不够！\n");
        weapon=me->query_temp("weapon");


  message_vision(HIY"\n第一击："+HIW" 风翔万里 "+HIY"！！\n"NOR,me,target);
  message_vision(HIW"$N将内劲汇聚至顶峰，"NOR+weapon->query("name")+HIW"斜举，刹时间，狂风大作，飞砂走石，怒飙的旋风，夹着沛然无匹的气劲，袭向$n。\n"NOR,me,target);
  message_vision(HIW"面对如此强招，稍一不留神，脚下竟有些虚浮，给风力卷动，$n沈声吐气，运起内劲，踩着千斤坠的势子，止住身形。\n"NOR,me,target);
  message_vision(HIW"$N纵身跃起，乘着旋风，"NOR+weapon->query("name")+HIW"毫无花巧，银光如虹，直劈$n。天地刃、宇宙锋顺着风势，化作千百道光影，环剁$n周身各处要害。\n"NOR,me,target);

  if (random(me->query("combat_exp")) > random((target->query("combat_exp")/3)) )
        {

                message_vision(HIM"$n正待闪躲，岂知被袭来的旋风一把钳制住，刹那间，眼前银光闪现，"NOR+weapon->query("name")+HIM"已在身上留下了无数道伤痕。\n"NOR,me,target);

                damage = (int)me->query_skill("blade");
                damage = damage + me->query("force_factor");

                damage = random(damage*3/2);

                if (weapon->query("id") == "zilei dao") damage=damage*4/3;
                if (weapon->query("id") == "diyu leidao") damage=damage*2;

                
                target->receive_damage("kee", damage);
                target->receive_wound("kee", damage/2);
                COMBAT_D->report_status(target);
               
                me->start_busy(3);

        } else {
                me->start_busy(2);
                message_vision(MAG"$n不慌不忙，看准了风向，身形急转，将此击卸去。\n"NOR,me,target);
        }

                me->add("force", -100+me->query("force_factor"));

                if(me->query_skill("zileidao", 1) > 149 )
                   call_out("perform2", 2, me, target,weapon);    

        return 1;
}

int perform2(object me, object target,object weapon)
{
        int damage;
        weapon = me->query_temp("weapon");  

        if(!living(target)) 
          return notify_fail("对手已经不能再战斗了。\n");

        if( me->query("force")<(300+me->query("force_factor")) )
                return notify_fail("你待要再出第二击，却发现自己的内力不够了！\n");   

        if (me->query_skill_mapped("blade") != "zileidao")
                return notify_fail("你现在并没使用紫雷刀法。\n");     
  

        message_vision(HIY"\n第二击："+HIR" 怒火燎原 "+HIY"！！\n"NOR,me,target);
        message_vision(HIR"$n只觉上方一股灼热压迫而来，$N将凝聚完成的烈火劲气，混於风中，全力轰出。\n只见风助火势，数道烈火旋风，犹如九天炎龙，吐着炽盛光舌，天火熊熊，焚空而来。\n",me,target);

        if (random(me->query("combat_exp")) > random((target->query("combat_exp")/3)) )
        {
                message_vision(HIM"$n只觉在滔天烈焰中气血不住翻腾，此时烈焰突然高涨起来，只见"NOR+weapon->query("name")+HIM"化作火龙将$n贯体而过。\n"NOR,me,target);
                me->start_busy(3);

                damage = (int)me->query_skill("blade");
                damage = damage + me->query("force_factor");

                damage = random(damage*3/2);                          

                if (weapon->query("id") == "zilei dao") damage=damage*4/3;
                if (weapon->query("id") == "diyu leidao") damage=damage*2;


                target->receive_damage("kee", damage);
                target->receive_wound("kee", damage/2);
                COMBAT_D->report_status(target);
          }else{
                message_vision(MAG"$n露出凝重之色，猛吸一口气，体内骨骼喀喀作响，周身劲气忽地实体化，组成气罩，将自己团团包裹於其中。\n"NOR,me,target);
                message_vision(MAG"火龙飙至，尖锥似的火劲撞在护身气罩上，爆出连天巨响，火舌四散，逼得周围全燃起燎天炎柱。\n"NOR,me,target);
                me->start_busy(2);
               }

                me->add("force", -100+me->query("force_factor"));

                if(me->query_skill("zileidao", 1) > 199 )
                   call_out("perform3", 2, me, target,weapon);    

        return 1;
}

int perform3(object me, object target,object weapon)
{
        int damage;
        weapon = me->query_temp("weapon");  

        if(!living(target)) 
          return notify_fail("对手已经不能再战斗了。\n");

        if( me->query("force")<(400+me->query("force_factor")) )
                return notify_fail("你待要再出第三击，却发现自己的内力不够了！\n");     

        if (me->query_skill_mapped("blade") != "zileidao")
                return notify_fail("你现在并没使用紫雷刀法。\n");     


        message_vision(HIY"\n第三击："+HIC" 巨浪淘沙 "+HIY"！！\n"NOR,me,target);
        message_vision(HIC"半空中，$N一个翻身，没有丝毫停留，人刀合一，自空中急速俯冲，往$n急攻而来。\n"NOR,me,target);
        message_vision(HIC"人未至，漫天水势如巨浪咆哮，澎湃不可当，直压向$n，誓要将其淹没於无边巨浪。\n"NOR,me,target);

        if (random(me->query("combat_exp")) > random((target->query("combat_exp")/3)) )
        {
                message_vision(HIM"$n深知此招威力，往地一蹬，人跃於空，竟主动迎击而来。\n"NOR,me,target);
                message_vision(HIM"双方将交锋的刹那，$n轰在"NOR+weapon->query("name")+HIM"刀尖，两股巨劲相触，倒迸出强猛的罡风，似流星天雨，乱坠於地，把地面射得千疮百孔。\n"NOR,me,target);
                message_vision(HIM"劲道一时僵持不下，但第三重水劲爆发，如江河溃堤，海啸噬天，澎湃绝伦，将$n势道已老的招式瞬间轰溃，趁胜涌向$n。\n"NOR,me,target);

                me->start_busy(3);

                damage = (int)me->query_skill("blade");
                damage = damage + me->query("force_factor");

                damage = random(damage*3/2);                          

                if (weapon->query("id") == "zilei dao") damage=damage*4/3;
                if (weapon->query("id") == "diyu leidao") damage=damage*2;


                target->receive_damage("kee", damage);
                target->receive_wound("kee", damage/2);
                COMBAT_D->report_status(target);
          }else{
                message_vision(MAG"$n猛吸一口气，将内劲运至顶峰，猛的一招击出，将$N来势震歪，立即抽身而退。\n"NOR,me,target);
                me->start_busy(2);
               }

                me->add("force", -100+me->query("force_factor"));

                if(me->query_skill("zileidao", 1) > 249 )
                   call_out("perform4", 2, me, target,weapon);    

        return 1;
}

int perform4(object me, object target,object weapon)
{
        int damage;
        weapon = me->query_temp("weapon");  

        if(!living(target)) 
          return notify_fail("对手已经不能再战斗了。\n");

        if( me->query("force")<(500+me->query("force_factor")) )
                return notify_fail("你待要再出第四击，却发现自己的内力不够了！\n");     

        if (me->query_skill_mapped("blade") != "zileidao")
                return notify_fail("你现在并没使用紫雷刀法。\n");     


        message_vision(HIY"\n第四击："+HIC" 地裂天崩 "+HIY"！！\n"NOR,me,target);
        message_vision(HIG"只闻大地震动，由缓而剧，地面迸裂出多道地堑，地缝底咽呜鸣响，很快便响到了令人两耳生疼的地步，远近山峰受到感应，一齐作鸣。\n顷刻间山动地摇，鬼哭神号，又是火起，又是地鸣，彷佛末日降临。\n"NOR,me,target);
        message_vision(HIG"$n脚下陡然一空，方圆二十丈的空间，化成了个无底深洞，猛烈的飓风，造成强大的吸引力，将上方的所有物体，全吸扯入内。\n"NOR,me,target);
                message_vision(HIG"$n大惊失色，急忙纵身跃起，突然头顶一阵强烈劲气袭来，$N手中"NOR+weapon->query("name")+HIG"已乘万山重压之势当头劈来。\n"NOR,me,target);


        if (random(me->query("combat_exp")) > random((target->query("combat_exp")/3)) )
        {
                message_vision(HIM"$n已无法闪躲，硬是被此招劈中，登时鲜血狂喷不止。\n"NOR,me,target);
                me->start_busy(3);

                damage = (int)me->query_skill("blade");
                damage = damage + me->query("force_factor");

                damage = random(damage*3/2);                          

                if (weapon->query("id") == "zilei dao") damage=damage*4/3;
                if (weapon->query("id") == "diyu leidao") damage=damage*2;


                target->receive_damage("kee", damage);
                target->receive_wound("kee", damage/2);
                COMBAT_D->report_status(target);
          }else{
                message_vision(MAG"$N猛的一刀劈下，却是劈了个空，$n不知何时已窜出了数丈之外。\n"NOR,me,target);
                me->start_busy(3);
               }

                me->add("force", -100+me->query("force_factor"));

                if(me->query_skill("zileidao", 1) > 299 )
                   call_out("perform5", 2, me, target,weapon);    

        return 1;
}

int perform5(object me, object target,object weapon)
{
        int damage;
        weapon = me->query_temp("weapon");  

        if(!living(target)) 
          return notify_fail("对手已经不能再战斗了。\n");

        if( me->query("force")<(600+me->query("force_factor")) )
                return notify_fail("你待要再出最后一击，却发现自己的内力不够了！\n");

        if (weapon->query("id") != "zilei dao" && weapon->query("id") != "diyu leidao") 
                return notify_fail("你所持并非雷刀，最后一势的威力使将不出。\n");

        if (me->query_skill_mapped("blade") != "zileidao")
                return notify_fail("你现在并没使用紫雷刀法。\n");     


        message_vision(HIY"\n最后一击："+HIB" 雷落九天 "+HIY"！！！\n"NOR,me,target);
        message_vision(HIB"$N乘风在天，高举"NOR+weapon->query("name")+HIB",神情肃穆，一股睥睨天下的极强霸气登时涌身而来。\n"NOR,me,target);
        message_vision(HIB"霸气越来越盛，突然云朵之上急雷电闪，一道迅雷携着紫色电芒自九天而落，正好劈在"NOR+weapon->query("name")+HIB"之上。\n"NOR,me,target);
        message_vision(HIB"$N借着无匹天威，手中"NOR+weapon->query("name")+HIB"携紫色雷电，以迅猛无比之势，望$n劈来。\n"NOR,me,target);

        message_vision(HIM"$n被此招所摄，心中战意顿失，只见眼前紫光一闪，体内鲜血喷涌而出。。。\n"NOR,me,target);

                damage = (int)me->query_skill("blade",1);
                damage = damage + me->query("force_factor");

                damage = random(damage*2);                          


                if (weapon->query("id") == "zilei dao") damage=damage*4/3;
                if (weapon->query("id") == "diyu leidao") damage=damage*2;


                target->receive_damage("kee", damage);
                target->receive_wound("kee", damage/2);
                COMBAT_D->report_status(target);

                me->add("force", -100+me->query("force_factor"));
                me->start_busy(2+random(3));

        return 1;
}
