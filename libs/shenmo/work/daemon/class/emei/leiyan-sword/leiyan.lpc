#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() 
{
return "「"HIC"雷炎万怒"NOR"」"; 
}

int valid_perform(object me) 
{
if ( !me )  
        return 0; 
if ( me->query("family/family_name") != "峨嵋派"  
  || me->query("class")!="human" )   
        return notify_fail("你是哪儿偷学来的武功，也想用"+name()+"?\n"); 
if ( me->query_skill("leiyan-sword",1)<150 ) 
        return notify_fail("你的"+to_chinese("leiyan-sword")+"等级不足 150,施展不了"+name()+"。\n"); 
if ( me->query("force")< 500) 
        return notify_fail("你的内力不足 500 点。\n");  
return 1; 
}
int perform(object me, object target)
{
string msg, tparryskill, str;
int myskill, myskill1, tparryb, tparryh, myforce, tforce, myexp, texp, damage;
object weapon,tweapon;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me);
if( !target
 || !target->is_character()
 || target==me )
        return notify_fail(name()+"只能在战斗中使用。\n");
if ( !me->is_fighting() ) 
        return notify_fail("你要对谁施展"+name()+"?\n");            
weapon = me->query_temp("weapon");
myskill= (int)me->query_skill("sword",1);
myskill1= (int)me->query_skill("leiyan-sword",1);
myforce = (int)me->query("force");
myexp = (int)me->query("combat_exp")/2;
msg = "";
tweapon = target->query_temp("weapon");  
tparryb= (int)target->query_skill("parry",1);
tforce = (int)target->query("force");
texp = (int)target->query("combat_exp");
tparryskill = target->query_skill_mapped("parry");
tparryh=target->query_skill(tparryskill,1);
me->add("force",-300);
me->receive_damage("sen", 20);
if ( me->query("env/no_msg") || target->query("env/no_msg") )
        message_vision(HIC"$N"HIC"使出了峨嵋山雷炎剑绝学--『"HIW"雷炎飞虹"HIC"』！\n"NOR,me);
else    {       
        message_vision(HIC"$N人剑合一，放出手中"+weapon->name()+HIC"化作一条彩虹，竟使出了峨嵋山雷炎剑绝学--『"HIW"雷炎飞虹"HIC"』！\n" NOR,me,target);        
        message_vision(HIC"$N飞身而起，身法之快追上握住"+weapon->name()+HIC"，只见无数剑影闪过。\n"NOR,me);
        message_vision(HIM"剑影随着彩虹直上云霄，『"HIW"雷炎飞虹"HIM"』含劲欲发！\n"NOR,me);
        }
if (random(myexp)>(int)(texp/9) && random(myforce) > (int)(tforce/3)) 
        {
        msg = HIR"$n正看着入神，彩虹中的无数剑影纵然直下！\n"
                                "“嗖”的一声，从$n的身上穿体而过，血溅满地！\n"NOR;
        damage = 1;
        target->receive_damage("kee", me->query("eff_kee")*damage/3, me);
        target->receive_wound("kee", me->query("eff_sen")*damage/3, me);
        if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
                message_vision(msg, me, target);
        COMBAT_D->report_status(target);
        target->set_temp("last_damage_from",me);
        }
else    {
        msg = HIW"$n情神一聚，知道天玑之中暗藏无限杀机。侧身闪过了这招『"HIM"雷炎飞虹"HIW"』\n"NOR;
        if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
                message_vision(msg, me, target);
        }

if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
        {
        message_vision(HIM"$N身形转动，原来还有后招，转眼间又杀出一剑！\n" NOR,me,target);
        message_vision(HIM"这一招『"HIW"雷炎再现"HIM"』比刚才那招更快，好像要一鼓作气，斩妖除魔！\n" NOR,me,target);
        }
if(random(myexp)>(int)(texp/10)&& random((int)(myskill + myskill1*3/2))>(int)((tparryb+tparryh)/2))
        {
        msg = HIR"$n还没有招架住刚才的攻势，就看杀招袭来竟不知所措！\n被$N的"+weapon->name()+HIR"刺的遍体鳞伤，突出一口鲜血！\n"NOR;
        damage = 1;
        target->receive_damage("kee", me->query("eff_kee")*damage/3, me);
        target->receive_wound("kee", me->query("eff_sen")*damage/3, me);
        if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
                message_vision(msg, me, target);
        COMBAT_D->report_status(target);
        }
else    {
        msg = HIW"$n临危不乱，使出浑身招数终于化解了$N的攻势。\n"NOR;
        if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
                message_vision(msg, me, target);
        }
if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
        {               
        message_vision(HIM"$N突然收住身形，回步而立，撤锏于背后，无招胜有招，无形胜有形。\n"NOR,me);
        message_vision(HIM"这一招正是天玑剑的精华，尽在『"HIW"雷炎万怒"HIM"』！\n"NOR,me);
        }
if(random(myexp)>(int)(texp/2))
        {
        msg = HIR"$n以为$N破绽百出，大喜之下，急忙上前想抢攻。竟不知$N这招杀机无限，$n刚一靠近，只见剑光一闪，从$n胸口穿体而过！\n$n没有想到招中之招如此厉害，险些丢掉性命！\n"NOR;
        damage = 1;
        target->receive_damage("kee", me->query("eff_kee")*damage/3, me);
        target->receive_wound("kee", me->query("eff_sen")*damage/3, me);
        if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
                message_vision(msg, me, target);
        COMBAT_D->report_status(target);
        }
else    {
        msg = HIW"$n看破了这招的虚实，将计就计，假装冲上前，却在$N出剑的一瞬间腾空跃开，回手竟反攻一招！\n"NOR;
        if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
                message_vision(msg, me, target);
        COMBAT_D->do_attack(target, me, tweapon);
        }
me->start_busy(2);
return 1;
}

int help(object me)
{
string temp;    
temp = "\t\t"+to_chinese("leiyan-sword")+" 150 级\n";
temp+= "\t\t内    力 500 点\n";
temp+= "\t\t战斗状态下使用\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");
write(@HELP

        使用功效：
                连续对敌人造成气血的减少和损害
                并且每次的伤害递加
        出招类型：
                busy型外功
                有隐藏攻击
                不可叛师带出
        出手要求：              
HELP);  
write(temp);
return 1;
}
