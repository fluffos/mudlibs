
// write by windy 06/04/26
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIM"峨嵋·幻剑"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name")!="峨嵋派" || me->query("class")!="human") 
        return notify_fail("你还不够资格使用"+name()+"！\n"); 
if(me->query_skill("huifeng-sword", 1) < 80) 
        return notify_fail("你的回风拂柳剑法修为不够，还用不出"+name()+"！\n"); 
if(me->query_skill("dodge", 1) < 80) 
        return notify_fail("你的基本轻功修为不够，还用不出"+name()+"！\n"); 
if(me->query_skill("sword", 1) < 80) 
        return notify_fail("你的基本剑术修为不够，还用不出"+name()+"！\n"); 
if((int)me->query("max_force") < 500 )
        return notify_fail("你的内力修为不够！\n"); 
if((int)me->query("force") < 500 ) 
        return notify_fail("你的内力不足！\n"); 
if((int)me->query("sen") < 500 )
        return notify_fail(HIC"你的精神不足，没法子施用"+name()+"！\n"NOR);
if(me->query_temp("emei_huan")+5>time())
        return notify_fail("你内力使用过度，"+name()+"不成招式。\n");
return 1;  
}

int perform(object me, object target)
{
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

me->delete("env/brief_message");
target->delete("env/brief_message");
if (! present(target,environment(me))) return 1;
if ( me->query("env/no_msg") || target->query("env/no_msg") )
        message_vision(HIM"$N"HIM"使出了幻剑一技！\n"NOR,me);
else    {    
        message_vision(HIM"\n$N手中长剑剑芒跃动，剑光暴长，幻出死亡的色彩，剑尖渐\n"NOR,me,target);
        message_vision(HIM"渐逼近$n，$n看到漫天剑光，抽身后跃，只这一刹，漫天剑\n"NOR,me,target);
        message_vision(HIM"影化为数剑直刺$n前胸，变幻莫测，突来三剑！\n"NOR,me,target);
        }
me->set_temp("QJB_perform", 4);
COMBAT_D->do_attack(me, target, me->query_temp("weapon"),10);
if (! present(target,environment(me))) return 1;
me->set_temp("QJB_perform", 1);  
COMBAT_D->do_attack(me, target, me->query_temp("weapon"),10); 
if (! present(target,environment(me))) return 1;
me->set_temp("QJB_perform", 6);
COMBAT_D->do_attack(me, target, me->query_temp("weapon"),10);
me->delete_temp("QJB_perform");
me->receive_damage("sen", 100);
me->add("force", -100);
if( !target->is_fighting(me) ) {
        if( living(target) ) {
                if( userp(target) ) target->fight_ob(me);
                else target->kill_ob(me);
        }
    }
me->set_temp("emei_huan",time());
return 1;
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("huifeng-sword")+" 80 级\n"; 
temp+= "\t\t"+to_chinese("sword")+" 80 级\n"; 
temp+= "\t\t"+to_chinese("dodge")+" 80 级\n"; 
temp+= "\t\t内力修为五年\n";  
temp+= "\t\t内力５００点\n";  
temp+= "\t\t精神５００点\n";  
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP  

        使用功效：  
                连续打击对手的气血
        出招类型：  
                延时型外功 
                无隐藏攻击 
                叛师不可带出  
        出手要求：    
HELP);              
write(temp);  
return 1;  
}
