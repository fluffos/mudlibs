#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIB"峨嵋·灭剑"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name")!="峨嵋派" || me->query("class")!="human") 
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if(me->query_skill("huifeng-sword", 1) < 100 && me->query_skill("tianlei-sword", 1) < 100) 
        return notify_fail("你的峨嵋派剑法修为不够，还用不出"+name()+"！\n"); 
if(me->query_skill("sword", 1) < 100) 
        return notify_fail("你的基本剑术修为不够，还用不出"+name()+"！\n"); 
if (me->query_skill_mapped("force")!="emeiforce")
        return notify_fail(name()+"必须配合峨嵋心法才能发挥威力。\n");
if((int)me->query("max_force") < 1000 )
        return notify_fail("你的内力修为不够！\n"); 
if((int)me->query("force") < 1000 ) 
        return notify_fail("你的内力不足！\n"); 
if((int)me->query("sen") < 500 )
        return notify_fail("你的精神不足，没法子施用"+name()+"！\n");
if( time()-(int)me->query_temp("emei_mie") < 3+random(2) ) 
        return notify_fail("你内力使用过度，"+name()+"不成招式。\n");
return 1;  
}

int perform(object me, object target)
{
int extra;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

extra=me->query_skill("sword", 1);
extra+=me->query("level");

message_vision(HIG"\n$N运起内力，脸上怒气大盛，一声巨吼之下发出了一招"+name()+HIG"！\n"NOR,me);
me->add_temp("apply/attack", extra);
me->add_temp("apply/damage", extra);
COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
me->add_temp("apply/attack", -extra);
me->add_temp("apply/damage", -extra);
me->add("force", -200);
if( !target->is_fighting(me) ) {
        if( living(target) ) {
                if( userp(target) ) target->fight_ob(me);
                else target->kill_ob(me);
        }
    }
me->set_temp("emei_mie",time());
return 1;
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("huifeng-sword")+" 100 级或者"+to_chinese("tianlei-sword")+" 100 级\n"; 
temp+= "\t\t"+to_chinese("sword")+" 100 级\n"; 
temp+= "\t\t内力修为十年\n";  
temp+= "\t\t内力１０００点\n";  
temp+= "\t\t精神５００点\n";  
temp+= "\t\t必须激发内功为峨嵋心法\n";  
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP  

        使用功效：  
                给对手强有力的一击
        出招类型：  
                延时型外功 
                无隐藏攻击 
                叛师不可带出  
        出手要求：    
HELP);              
write(temp);  
return 1;  
}
