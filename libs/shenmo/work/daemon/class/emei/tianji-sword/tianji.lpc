#include <ansi.h>
inherit SSERVER;

string name() {
  return "「" HIM "天玑无限" NOR "」";
}

int valid_perform(object me) {
  if (!me)
    return 0;
  if (me->query("family/family_name") != "峨嵋派"
    || me->query("class") != "human")
    return notify_fail("你是哪儿偷学来的武功，也想用" + name() + "?\n");
  if (me->query_skill("tianji-sword", 1) < 150)
    return notify_fail("你的" + to_chinese("tianji-sword") + "等级不足 150,施展不了" + name() + "。\n");
  if (me->query("force") < 500)
    return notify_fail("你的内力不足 500 点。\n");
  return 1;
}

int perform(object me, object target) {
  string msg;
  int ap, dp, damage;
  object weapon;
  msg = "";

  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target == me)
    return notify_fail(name() + "只能在战斗中使用。\n");
  if (!me->is_fighting())
    return notify_fail("你要对谁施展" + name() + "?\n");

  weapon = me->query_temp("weapon");

  ap = COMBAT_D->skill_power(me, "sword", 1);
  ap += COMBAT_D->skill_power(me, "force", 1);
  ap /= 2;
  dp = COMBAT_D->skill_power(target, "dodge", 1);
  dp += COMBAT_D->skill_power(target, "parry", 1);
  dp += COMBAT_D->skill_power(target, "force", 1);
  dp /= 3;

  if (COMBAT_D->restrain(me, target)
    || me->query("family/family_name") == "峨嵋派")
    ap += ap / 3;
  if (COMBAT_D->restrain(target, me)
    || target->query("family/family_name") == "峨嵋派")
    dp += dp / 3;

  me->add("force", -300);
  me->receive_damage("sen", 20, target);

  damage = me->query("max_force") / 2;
  damage += me->query("force");
  damage += (random(me->query_str()) + 1) * 80;
  damage -= random(target->query("max_force") / 2);
  damage -= random(target->query("force"));
  if (damage < 100)
    damage = 100;
  if (damage > 800)
    damage = 800;

  message_vision(
    HIM "$N人剑合一，放出手中" + weapon->name() + HIM "化作一条彩虹，竟使出了峨嵋山天玑剑绝学--『" HIW "天玑飞虹" HIM "』！\n\n" NOR,
    me,
    target
  );
  if (!me->query("env/no_msg") && !target->query("env/no_msg")) {
    message_vision(HIC "$N飞身而起，身法之快追上握住" + weapon->name() + HIC "，只见无数剑影闪过。\n" NOR, me);
    message_vision(HIM "剑影随着彩虹直上云霄，『" HIW "天玑飞虹" HIM "』含劲欲发！\n\n" NOR, me);
  }
  if (random(ap + dp) > dp) {
    msg = HIR "$n正看着入神，彩虹中的无数剑影纵然直下！
“嗖”的一声，从$n的身上穿体而过，血溅满地！\n\n" NOR;
    target->receive_wound("kee", damage, me);
    target->receive_damage("kee", damage, me);
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(msg, me, target);
    COMBAT_D->report_status(target);
    if (wizardp(me))
      tell_object(me, "damage==" + damage + "\n");
  } else {
    msg = HIW "$n情神一聚，知道天玑之中暗藏无限杀机。侧身闪过了这招『" HIM "天玑飞虹" HIW "』\n\n" NOR;
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(msg, me, target);
  }

  if (!me->query("env/no_msg") && !target->query("env/no_msg")) {
    message_vision(HIM "$N身形转动，原来还有后招，转眼间又杀出一剑！\n" NOR, me, target);
    message_vision(HIM "这一招『" HIW "天玑再现" HIM "』比刚才那招更快，好像要一鼓作气，斩妖除魔！\n\n" NOR, me, target);
  }

  if (random(ap + dp) > dp * 3 / 2) {
    msg = HIR "$n还没有招架住刚才的攻势，就看杀招袭来竟不知所措！\n被$N的" + weapon->name() + HIR "刺的遍体鳞伤，突出一口鲜血！\n\n" NOR;
    damage += me->query_temp("apply/damage");
    damage += me->query_temp("apply/attack");
    damage -= random(target->query_temp("apply/damage"));
    if (damage < 100)
      damage = 100;
    target->receive_wound("kee", damage, me);
    target->receive_damage("kee", damage, me);
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(msg, me, target);
    COMBAT_D->report_status(target);
    if (wizardp(me))
      tell_object(me, "damage==" + damage + "\n");
  } else {
    msg = HIW "$n临危不乱，使出浑身招数终于化解了$N的攻势。\n\n" NOR;
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(msg, me, target);
  }

  if (!me->query("env/no_msg") && !target->query("env/no_msg")) {
    message_vision(HIM "$N突然收住身形，回步而立，撤锏于背后，无招胜有招，无形胜有形。\n" NOR, me);
    message_vision(HIM "这一招正是天玑剑的精华，尽在『" HIW "天玑无限" HIM "』！\n\n" NOR, me);
  }
  if (random(ap) > dp / 2) {
    msg = HIR "$n" HIR "以为$N" HIR "破绽百出，大喜之下，急忙上前想抢攻。
竟不知$N" HIR "这招杀机无限，$n" HIR "刚一靠近，只见剑光一闪，从$n" HIR "胸口穿体而过！
$n" HIR "没有想到招中之招如此厉害，险些丢掉性命！\n" NOR;
    damage += (me->query("max_force") / me->query("force")) * me->query("force_factor");
    if (damage < 1)
      damage = 1;
    target->receive_wound("kee", damage, me);
    target->receive_damage("kee", damage, me);
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(msg, me, target);
    COMBAT_D->report_status(target);
    if (wizardp(me))
      tell_object(me, "damage==" + damage + "\n");
  } else {
    msg = HIW "$n看破了这招的虚实，将计就计，假装冲上前，却在$N出剑的一瞬间腾空跃开，回手竟反攻一招！\n\n" NOR;
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(msg, me, target);
    COMBAT_D->do_attack(target, me, target->query_temp("weapon"));
  }
  me->start_busy(2);
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("tianji-sword") + " 150 级\n";
  temp += "\t\t内    力 500 点\n";
  temp += "\t\t战斗状态下使用\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                连续对敌人造成气血的减少和损害
                并且每次的伤害递加
        出招类型：
                busy型外功
                有隐藏效果
                不可叛师带出
        出手要求：              
HELP);
  write(temp);
  return 1;
}
