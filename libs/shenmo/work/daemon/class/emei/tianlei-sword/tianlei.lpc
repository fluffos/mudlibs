#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name()  
{
return "「"HIW"天雷合并"NOR"」";  
}

void tianlei_ok(object);

int valid_perform(object me)
{
if ( me->query("class")!="human" && !me->samsara_check("tianlei-sword"))
        return notify_fail("你不是人间界！\n");
if ( me->query_skill_mapped("force")!="emeiforce" 
     && me->query_skill("tianlei-sword",1)<350 )
        return notify_fail(name()+"必须配合峨嵋心法才能使用。\n");
if ( (int)me->query("force") < 1000 )
        return notify_fail("你的内力不足！\n");
if ( (int)me->query("max_force") < 3000 )
        return notify_fail("你的内力修为不够！\n");
if ( (int)me->query("sen") < 1000 )
        return notify_fail("你的精神不足，没法子施用外功！\n");
if ( (int)me->query("combat_exp") < 1500000 )
        return notify_fail("你武学经验不够，领悟不到"+name()+"！\n");
if ( (int)me->query_skill("emeiforce",1) < 180 )
        return notify_fail("你的峨嵋心法级别还不够，使不出"+name()+"！\n");
if ( (int)me->query_skill("zhutian-bu",1) < 180 && !me->samsara_check("tianlei-sword"))
        return notify_fail("你的诸天化身步级别还不够，使不出"+name()+"！\n");
if ( (int)me->query_skill("jinding-zhang",1) < 180 && !me->samsara_check("tianlei-sword"))
        return notify_fail("你的金顶绵掌级别还不够，使不出"+name()+"！\n");
if ( (int)me->query_skill("tianlei-sword", 1) < 180 )
        return notify_fail("你的天雷双剑还不够，使不出"+name()+"！\n");
if ( me->query_temp("no_tianlei") )  //在此处设置标志位 ;
        return notify_fail("你刚刚使过"+name()+"，先歇一歇吧。\n");
return 1;
}

int perform(object me, object target) 
{
string str1,str2,msg; 
mapping clr; 
object weapon; 
int skill,i,num; 
int extra; 

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if ( !me->is_fighting() )
        return notify_fail(name()+"只能在战斗中使用！\n");

me->delete("env/brief_message");
target->delete("env/brief_message");
skill = me->query_skill("tianlei-sword");
extra = me->query_skill("tianlei-sword",1) /3;
extra += me->query_skill("tianlei-sword",1);

message_vision(HIY"$N"HIY"右手幻出"HIR"天玑剑"HIY"，左手幻出"HIG"雷炎剑"HIY"，将两剑并为一处，
瞬间化作一条"HIM"彩虹"HIY"，正是一招「"HIR"天"HIG"雷"HIW"合"HIB"并"HIY"」。\n"NOR,me,target);
if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
        message_vision(HIY"$n"HIY"还没有来得及看清楚是怎么回事，以被彩虹透体而过。\n" NOR,me,target);

if( (int)me->query_skill("tianlei-sword", 1)>400 && me->query("family/family_name")=="峨嵋派")
        num=8;
else if( (int)me->query_skill("tianlei-sword", 1)>300 && me->query("family/family_name")=="峨嵋派")
        num=7;
else if( (int)me->query_skill("tianlei-sword", 1)>280 && me->query("family/family_name")=="峨嵋派")
        num=6;
else if( (int)me->query_skill("tianlei-sword", 1)>260 && me->query("family/family_name")=="峨嵋派")
        num=5;
else if( (int)me->query_skill("tianlei-sword", 1)>240 )
        num=4;
else if( (int)me->query_skill("tianlei-sword", 1)>200 )
        num=3;
else if( (int)me->query_skill("tianlei-sword", 1)>180 )
        num=2;
else    num=1;
extra/= 4;
extra*= num;
target->add_temp("apply/dodge",-extra*2);
target->add_temp("apply/parry",-extra*2);
me->add_temp("apply/attack",extra*2);
me->add_temp("apply/damage",extra*2);
me->set_temp("QJB_perform",num);

clr = ([
        HBRED"" :       BRED"",
        HBGRN"" :       BGRN"",
        HBYEL"" :       BYEL"",
        HBBLU"" :       BBLU"",
        HBMAG"" :       BMAG"",
        HBCYN"" :       BCYN"",
]);
str1 = keys(clr)[random(sizeof(keys(clr)))];
str2 = clr[str1];

msg = NOR"\t\t"+str1+"┏─━─━─━─━─┓\n"NOR;
msg+= NOR"\t\t"+str1+"│　天　雷　合　并　│\n"NOR;
msg+= NOR"\t\t"+str1+"┗─━─━─━─━─┛\n"NOR;

msg = replace_string(msg,"　",str1+"　"NOR);
msg = replace_string(msg,"┏",NOR +str1+ HIM"┏"NOR);
msg = replace_string(msg,"┛",NOR +str1+ HIM"┛"NOR);
msg = replace_string(msg,"┓",NOR +str1+ HIM"┓"NOR);
msg = replace_string(msg,"┗",NOR +str1+ HIM"┗"NOR);
msg = replace_string(msg,"━",NOR +str1+ HIM"━"NOR);
msg = replace_string(msg,"│",NOR +str2+ CYN"│"NOR);
msg = replace_string(msg,"─",NOR +str2+ CYN"─"NOR);
msg = replace_string(msg,"天",NOR +str1+ HIY"天"NOR +str1);
msg = replace_string(msg,"雷",NOR +str1+ HIY"雷"NOR +str1);
msg = replace_string(msg,"合",NOR +str1+ HIY"合"NOR +str1);
msg = replace_string(msg,"并",NOR +str1+ HIY"并"NOR +str1);
switch(num)
        {
        case 1:
        case 2:
                msg = replace_string(msg,"天",NOR +str1+ BLINK HIM"天"NOR +str1);
                break;
        case 3:
        case 4:
                msg = replace_string(msg,"天",NOR +str1+ BLINK HIM"天"NOR +str1);
                msg = replace_string(msg,"雷",NOR +str1+ BLINK HIG"雷"NOR +str1);
                break;
        case 5:
        case 6:
                msg = replace_string(msg,"天",NOR +str1+ BLINK HIM"天"NOR +str1);
                msg = replace_string(msg,"雷",NOR +str1+ BLINK HIG"雷"NOR +str1);
                msg = replace_string(msg,"合",NOR +str1+ BLINK HIW"合"NOR +str1);
                break;
        default:
                msg = replace_string(msg,"天",NOR +str1+ BLINK HIM"天"NOR +str1);
                msg = replace_string(msg,"雷",NOR +str1+ BLINK HIG"雷"NOR +str1);
                msg = replace_string(msg,"合",NOR +str1+ BLINK HIW"合"NOR +str1);
                msg = replace_string(msg,"并",NOR +str1+ BLINK HIB"并"NOR +str1);
        }
if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
        message_vision("\n"+msg+"\n",me,target);
COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
me->delete_temp("QJB_perform");
me->receive_damage("sen", 100);
me->add("force", -800/num);
me->start_busy(random(2));
me->set_temp("no_tianlei",1); ;
target->add_temp("apply/dodge",extra*2);
target->add_temp("apply/parry",extra*2);
me->add_temp("apply/attack",-extra*2);
me->add_temp("apply/damage",-extra*2);
call_out("tianlei_ok",4+random(2),me); ;
if( !target->is_fighting(me) )
        {
        if( living(target) )
                {
                if( userp(target) ) target->fight_ob(me);
                else target->kill_ob(me);
                }
        }
return 1;
}

void tianlei_ok(object me)
{
if ( !me ) return;
        me->delete_temp("no_tianlei");
}
int help(object me) 
{
string temp; 
temp = "\t\t"+to_chinese("tianlei-sword")+" 180 级\n"; 
temp+= "\t\t"+to_chinese("sword")+" 180 级\n";
temp+= "\t\t"+to_chinese("emeiforce")+" 180 级\n";
temp+= "\t\t"+to_chinese("zhutian-bu")+" 180 级\n";
temp+= "\t\t"+to_chinese("jinding-zhang")+" 180 级\n";
temp+= "\t\t内力 1000 点\n";
temp+= "\t\t武学经验1500000\n";
temp+= "\t\t天雷双剑低于350级者必须激发峨嵋心法\n";
write(@HELP  
天雷双剑 之 「天雷合并」：

        使用功效：  
                给敌人强有力的一击
        出招类型：  
                随机busy 并有延时型外功 
                峨嵋弟子使用威力加倍  
                叛师可带出  
        出手要求：     
HELP);    
write(temp); 
return 1; 
}
