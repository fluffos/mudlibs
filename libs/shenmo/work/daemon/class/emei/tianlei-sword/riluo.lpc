
// modify by windy 06/04/26
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIY"峨嵋·日落"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name")!="峨嵋派" && !me->samsara_check("tianlei-sword", 1)) 
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if(me->query_skill("tianlei-sword", 1) < 200) 
        return notify_fail("你的天雷双剑修为不够，还用不出"+name()+"！\n"); 
if((int)me->query("max_force") < 2000 )
        return notify_fail("你的内力修为不够！\n"); 
if((int)me->query("force") < 1000 ) 
        return notify_fail("你的内力不足！\n"); 
if( time()-(int)me->query_temp("emei_riluo") < 4+random(4) ) 
        return notify_fail(name()+"不可频繁使用。\n");
return 1;  
}

int perform(object me, object target)
{
object weapon, ob;
string msg;
int myexp,yourexp;    
int extra;

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

ob = target;
myexp = (int) me->query("combat_exp")/20000;
yourexp = (int) target->query("combat_exp")/20000;
extra = me->query_skill("tianlei-sword", 1)/6;
if (random(target->query("level")) < me->query("level"))
extra+=me->query("level");

message_vision(HIY"\n$N凝望西山之中的黄昏晚霞，脚步轻盈，灵由神生，竟使出了"+name()+HIY"一技。\n"NOR,me,target);
msg = HIR"\n日，朦胧降于小雾西山，犹有风吹，只为洒脱，衬佳人漫步。\n" NOR;
if(random(myexp)>yourexp/8)
    {
    me->add_temp("apply/attack", extra);
    me->add_temp("apply/damage", extra);
    msg+= HIW "\n“亭下花草，万千，袅袅婷婷，雨露知多少，含香含态醉人，暮香深惹情深......”\n" NOR;
    if ( !me->query("env/no_msg") && !target->query("env/no_msg") )  
        message_vision(msg, me, target);
    if (!target->is_busy())
    target->start_busy(random(4));
    if ( !me->query("env/no_msg") && !target->query("env/no_msg") )  
        message_vision(HIG"$n觉，影动雾稀，日落西山，驻足，叹：“惜哉，惜哉...”"NOR, me, ob);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    if ( !me->query("env/no_msg") && !target->query("env/no_msg") )  
        message_vision(HIG"$n眺，叶落花残，侔憔悴，意：“怜哉，怜哉...”"NOR, me, ob);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    if ( !me->query("env/no_msg") && !target->query("env/no_msg") )  
        message_vision(HIG"$n忆当年，最爱弄玉团酥，幽卧，孤赏霞中日落，悯：“风亭梦魂，幽意何去，唉...”"NOR, me, ob);
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
    me->add_temp("apply/attack", -extra);
    me->add_temp("apply/damage", -extra);
    }
else
    {
    msg+= HIC "\n落日朝霞化于无形之中，$n庆幸自己于朝霞之中拓步而归。\n" NOR;
    if ( !me->query("env/no_msg") && !target->query("env/no_msg") )  
        message_vision(msg, me, target);
    }
me->add("force", -150);
me->set_temp("emei_riluo",time());
return 1;
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("tianlei-sword")+" 200 级\n"; 
temp+= "\t\t内力修为二十年\n";  
temp+= "\t\t内力１０００点\n";  
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP  

        使用功效：  
                牵制对手并连续伤害对手的气血
        出招类型：  
                延时型外功 
                无隐藏攻击 
                叛师不可带出  
        出手要求：    
HELP);              
write(temp);  
return 1;  
}
