//modify by windy 06/05/14
#include <ansi.h>
inherit F_DBASE;
inherit SSERVER;

string name() {
  return "「" HIC "清风拂柳" NOR "」";
}

int valid_perform(object me) {
  if (me->query("family/family_name") != "峨嵋派" && !me->samsara_check("tianlei-sword", 1))
    return notify_fail(name() + "乃是峨嵋派不传之密。\n");
  if (me->query_skill_mapped("dodge") != "zhutian-bu")
    return notify_fail(name() + "必须配合诸天化身步才能使用。\n");
  if (me->query_skill("dodge") < 100)
    return notify_fail("你的基本轻功修为太差，无法施展" + name() + "。\n");
  if (me->query_skill("force") < 100)
    return notify_fail("你的内功心法修为太差，无法施展" + name() + "。\n");
  if (me->query_skill_mapped("force") != "emeiforce")
    return notify_fail(name() + "必须配合峨嵋心法才能使用。\n");
  if (me->query_skill("sword") < 100)
    return notify_fail("你的基本剑术修为太差，无法施展" + name() + "。\n");
  if ((int)me->query("force") < 50)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_temp("emei_fuliu"))
    return notify_fail("你已经在运功中了。\n");
  return 1;
}

void remove_effect(object me, object target, int amount);

int perform(object me, object target) {
  int skill_sword, skill_dodge, dodge_amount, attack_amount;
  if (!valid_perform(me))
    return 0;
  skill_sword = me->query_skill("sword");
  attack_amount = skill_sword * random(6) / 10;
  skill_dodge = me->query_skill("dodge");
  dodge_amount = skill_dodge * (5 + random(6)) / 10;

  me->add("force", -50);
  message_vision(HIW "$N脚踏诸天化身步，运起轻功，步走乾坤，使出一招回风拂柳剑中的「" HIC "清风拂柳" HIW "」！\n" NOR, me);
  me->set_temp("emei_fuliu", 1);
  me->add_temp("apply/dodge", 200);
  me->start_call_out(
    (: call_other, __FILE__, "remove_effect", me, dodge_amount, attack_amount :),
    skill_sword / 5
  );
  return 1;
}

void remove_effect(object me, int dodge_amount, int attack_amount) {
  if (!me) return;
  me->add_temp("apply/dodge", -200);
  me->delete_temp("emei_fuliu");
  message_vision(HIW "$N渐感气力不支，不得不放慢脚步，放缓剑招。\n" NOR, me);
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("sword") + " 100 级\n";
  temp += "\t\t" + to_chinese("dodge") + " 100 级\n";
  temp += "\t\t" + to_chinese("force") + " 100 级\n";
  temp += "\t\t必须激发轻功为诸天化身步\n";
  temp += "\t\t必须激发内功为峨嵋心法\n";
  temp += "\t\t内力５０点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                增加自身的闪避能力
        出招类型：
                辅助型外功
                无隐藏攻击
                不可以叛师带出
        出手要求：              
HELP);
  write(temp);
  return 1;
}
