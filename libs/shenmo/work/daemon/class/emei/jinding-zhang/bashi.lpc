// bashi.c 金顶绵掌 八式合一

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SSERVER;
void remove_effect(object target, int aamount, int damount);

string name() {
  return "「" HIR "八式合一" NOR "」";
}

int valid_perform(object me) {
  if (me->query("family/family_name") != "峨嵋派" && !me->samsara_check("jinding-zhang", 1))
    return notify_fail("只有峨嵋派弟子才能使用" + name() + "！\n");
  if ((int)me->query("force") < (int)me->query("max_force") / 50)
    return notify_fail("你的内力还不够高！\n");
  if ((int)me->query_skill("emeiforce", 1) < 80)
    return notify_fail("你的峨嵋心法的修为不够，不能使用" + name() + "！\n");
  if ((int)me->query_skill("jinding-zhang", 1) < 80)
    return notify_fail("你的金顶绵掌的八式修习不全，无法使用" + name() + "！\n");
  if (me->query_temp("last_bashi") + 4 > time())
    return notify_fail("你内力使用过度，" + name() + "不成招式。\n");
  return 1;
}

int perform(object me, object target) {
  object weapon;
  int damage;
  string msg;
  int count, d_count, qi, maxqi, skill;
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用！\n");

  //        if( !target->is_killing(me) ) target->kill_ob(me);

  if (me->query("env/no_msg") || target->query("env/no_msg"))
    message_vision(HIY "$N" HIY "使出了金顶绵掌之" + name() + "！\n" NOR, me);

  msg = HIY "$N深深吸了一口气，提起全身的功力于双掌，只听的$N骨骼一阵爆响！\n" NOR;
  if (me->query("combat_exp") > (int)target->query("combat_exp") / 4) {
    damage = (int)me->query_skill("emeiforce", 1) / 2;
    damage = damage + (int)me->query_skill("jinding-zhang", 1);
    target->set_temp("bashi", 1);
    if (target->query("apply/attack") > damage / 3)
      target->add_temp("apply/attack", -damage / 5);
    if (target->query("apply/dodge") > damage / 3)
      target->add_temp("apply/dodge", -damage / 5);
    msg += HIR "$N腾空而起，使出了「八式合一」，漫天的掌影，飘忽不定的罩向$n全身各个部位，\n" NOR;
    //                target->start_call_out( (: call_other, __FILE__, "remove_effect",target,damage/3, damage/3:), damage/30);
    me->add("force", -(int)me->query("max_force") / 50);
    if (!target->is_busy())
      target->start_busy(3);
  } else {
    msg += CYN "可是$p猛地向前一跃,跳出了$P的攻击范围。\n" NOR;
    me->start_busy(1);
  }
  if (!me->query("env/no_msg") && target->query("env/no_msg"))
    message_vision(msg, me, target);
  me->set_temp("last_bashi", time());
  return 1;
}

void remove_effect(object target, int aamount, int damount) {
  if (!target)
    return;
  target->add("kee", -100);
  target->add("sen", -100);
  target->add_temp("apply/attack", aamount);
  target->add_temp("apply/dodge", damount);
  target->delete_temp("bashi");
  message_vision(HIG "$N从猛烈的攻击中摆脱了出来，连退数步,稳住了脚步\n" NOR, target);
}
int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("jinding-zhang") + " 80 级\n";
  temp = "\t\t" + to_chinese("emeiforce") + " 80 级\n";
  temp += "\t\t内力不少于最大内力的五十分之一\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP  

        使用功效：  
                牵制敌人的同时，降低敌人的攻击力和防御力
        出招类型：  
                辅助型外功 
                无隐藏攻击
                叛师不可带出  
        出手要求：     
HELP);
  write(temp);
  return 1;
}
