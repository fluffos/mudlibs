// bighammer.c
#include <ansi.h>

inherit SSERVER;

int cast(object me, object target) {
  int success_adj, damage_adj;


  if (!target) target = offensive_target(me);
  if (me->query("class") != "human")
    return notify_fail("你非人界弟子，无法领会这项技能！\n");

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这招" HIW "剑" HIR "中" HIW "剑" NOR "？\n");

  if (time() - (int)me->query_temp("sword_cast") < 3 + random(5))
    return notify_fail(YEL "你的魔法尚未恢复！\n" NOR);
  if ((int)me->query("mana") < 25 + 2 * (int)me->query("mana_factor"))
    return notify_fail("你的法力不够！\n");

  if ((int)me->query("sen") < 20)
    return notify_fail("你无法集中精力，别砸中自己了！\n");

  me->add("mana", -25 - 2 * (int)me->query("mana_factor"));

  if (random(me->query("max_mana")) < 50) {
    write("好象没反应，再来一次吧！\n");
    return 1;
  }

  SPELL_D->attacking_cast(
    me,
    //attacker 
    target,
    //target
    "kee",
    //damage type: could be "qi"/"kee", "shen"/"sen", ...default "both"
    HIC "\n$N对着$n" NOR + HIC "大喝一声:" BLINK + HIR "看剑" NOR + HIC "！\n" + HIR "\n      劍   劍   劍   劍   劍   劍   劍   劍\n\n\t" HIB "剑   剑   剑   剑   剑   剑   剑\n\n" HIR "      劍   劍   劍   劍   劍   劍   劍   劍\n\n" + HIY "$N" NOR + HIY "剑光四射光彩满天，奇异中化成一道彩虹，\n$N" NOR + HIY "不由的一愣，刹那间，那彩虹又汇成一剑,\n剑气弥漫，剑色迷人，当$N" NOR + HIY "发觉是剑气已侵人心脾，\n剑色已夺去$n" NOR + HIY "的心志，$n" NOR + HIY "奈的想到了，\n这就是传说中的" HIW "剑" HIC "中" HIW "剑" HIY "！\n" NOR,
    //initial message
    HIY "只见这把剑活活的插在了$n" NOR + HIY "的身上！\n" NOR,
    //success message
    HIY "但是$n" NOR + HIY "身体轻轻一闪，躲了过去。\n" NOR,
    //fail message
    HIY "但是$N" NOR + HIY "一个不小心，剑没有出去却掉在自己的脚上！\n" NOR,
    //backfire initial message
    HIY "只见这把剑活活的插在了$n" NOR + HIY "的身上！\n" NOR
    //backfire hit message. note here $N and $n!!!
  );

  if (me->query("family/family_name") != "神剑山庄")
    me->start_busy(1 + random(2));
  me->set_temp("sword_cast", time());
  return 3 + random(5);
}
