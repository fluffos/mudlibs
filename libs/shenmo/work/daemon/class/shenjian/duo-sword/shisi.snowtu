 //Snowtu 06 rewrite
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target)
{      
int ap, dp;
string msg;
int i,extra,damage,ff;
object weapon;                 

extra = me->query_skill("duo-sword",1);
if ( extra < 200) 
        return notify_fail("你的夺命连环剑法还不够纯熟！\n");
if ( me->query_skill("cloudforce", 1)<200 )
        return notify_fail("你的心法还不够纯熟！\n");
if ( me->query("family/family_name") != "神剑山庄" )
        return notify_fail("神剑山庄的绝技不是谁都可以用！\n"); 
if ( time()<me->query_temp("shenjian_shisi")+3 )
        return notify_fail("绝招用多就不灵了！\n");
if ( me->query("force")<1500 )
        return notify_fail("你的真气不够了。\n");
        
if ( !target ) target = offensive_target(me);
if ( !target
   ||!target->is_character()
   ||!me->is_fighting(target) )
        return notify_fail(HIR"［夺命十四剑］"HIB"只能对战斗中的对手使用。\n"NOR);

weapon = me->query_temp("weapon");
damage = me->query_temp("apply/damage");
damage+= me->query("force_factor");
damage-= target->query_temp("apply/armor");
if ( damage<100 ) damage = 100;
if ( extra<300 ) i = 5;
else if ( extra<350 ) i = 8;
else if ( extra<400 ) i = 10;
else  i = 13;
ff = 100;
message_vision(HIR"$N"HIR"轻描淡写，挥尘如意，一瞬间就已使出夺命十三式，手中的"+ weapon->name()+ HIR "轻灵流动，\n就像是河水般的向$n"HIR"刺出"BLINK+HIC+chinese_number(i)+NOR HIR"剑!\n" NOR,me,target);
me->set_temp("shenjian_shisi",time());
while(i--)
        {
        damage+= damage;
        ff+= 100;
        }
damage = damage/2+random(damage/2);
if ( wizardp(me) )
        tell_object(me,"damage="+damage+"\n");
if ( wizardp(target) )
        tell_object(target,"damage="+damage+"\n");
        
me->add("force",-ff);
SDS_D->super_attack(me,target,damage,"HIR");

if ( me && target && me->is_fighting(target) )
        {
        ap = me->query_skill("duo-sword",1);
        dp = target->query_skill("dodge")+target->query_skill("parry");
        message_vision(CYN"$N"CYN"的第十三剑刺出后，所有的变化都似已穷尽，又像是流水已到尽头，剑势也慢了，很慢。\n"NOR,me,target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        message_vision(HIC"虽然慢，却还是在变，$N忽然一剑挥出，不著边际，不成章法。但是这一剑却像是画龙点晴，虽然空，却是所有转变的枢纽。" NOR,me,target);
        message_vision(HIR"\n\n然后$N就刺出了夺命十三剑的"HIY"第"HIB"十四"HIY"剑"HIR"-------------------------------------------\n\n"NOR,me,target);
        msg = RED"\n"RED"$N的剑气和杀气都很重，宛如满天岛云密布。这一剑刺出，忽然间就将满天乌云都拨开了，现出了阳光。这一剑刺出，所有的变化才真的已到了穷尽，本已到了尽头的流水，现在就像是已完全枯竭.\n$N"RED"的力也已竭了。\n\n" NOR; 
        if( random(ap+dp)>dp/2 ) 
                {
                msg +="$n被$N的剑势所迫，动弹不得！\n";
                if ( !target->is_busy() )  target->start_busy(5+random(5));
                if ( damage>5000 )   damage = 5000;
                damage = damage/2+random(damage/2);
                if ( wizardp(me) )  tell_object(me,"damage="+damage+"\n");
                if ( wizardp(target) ) tell_object(target,"damage="+damage+"\n");
                target->receive_wound("kee",damage);
                target->receive_wound("sen",damage);
                } 
        else    msg += "但是$n并不惧于$N的剑势。\n";
        message_vision(msg+NOR, me, target);
        }
return 1;
}
int help(object me)  
{
string temp;
temp = "\t\t"+to_chinese("duo-sword")+" 200 级\n"; 
temp+= "\t\t"+to_chinese("cloudforce")+" 200 级\n"; 
temp+= "\t\t内力 1500 点\n"; 
write(@HELP 
夺命剑法 之 「夺命十四剑」： 

        使用功效： 
                连续打击对手的气血和精神，并牵制对手
        出招类型：   
                延时型外功  
                无隐藏攻击
                叛师不可带出   
        出手要求： 
HELP);  
write(temp);  
return 1;  
}
