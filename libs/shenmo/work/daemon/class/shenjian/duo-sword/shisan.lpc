
                                                                               // modify by windy 06/04/28
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIR"夺命十三剑"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("class") != "human" && !me->samsara_check("duo-sword"))  
        return notify_fail("你根本无法领悟"+name()+"！\n");  
if((int)me->query_skill("duo-sword", 1) < 200) 
        return notify_fail("你的夺命剑法修为太差，难以施展"+name()+"！\n"); 
if((int)me->query_skill("cloudforce", 1) < 200) 
        return notify_fail("你的云裳心法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("max_force") < 2000 ) 
        return notify_fail("你的内力修为不够！\n"); 
if((int)me->query("force") < 1000 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
string msg;
int extra, i, ap, dp;
int urkee;
object weapon;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

urkee=me->query("eff_kee");  
extra = me->query_skill("duo-sword",1);
extra+= me->query_skill("cloudforce",1);
extra+= me->query_skill("sword",1);
extra+= me->query("level");
weapon = me->query_temp("weapon");
message_vision(HIR"$N轻描淡写，挥尘如意，一瞬间就已使出夺命十三式.\n只见$N手中的"+ weapon->name()+ HIR "轻灵流动，就像是河水般向$n连续刺出了十三剑!\n" NOR,me,target);
me->add_temp("apply/attack",extra/10);
me->add_temp("apply/damage",extra/10);
for (i=0;i<13;i++)
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
me->add_temp("apply/attack",-extra/10);
me->add_temp("apply/damage",-extra/10);
if((int)me->query_skill("duo-sword", 1) > 249 && (int)me->query("force")>99 && me->query("family/family_name") == "神剑山庄")
{
message_vision(CYN"\n$N的第十三剑刺出后，所有的变化都似已穷尽，又像是流水已到了尽头，剑势也慢了，很慢。\n"NOR,me,target);
message_vision(HIR"蓦地$N竟然刺出了夺命十三剑的"HIY"第"HIB"十四"HIY"剑"HIR"---------------------------\n" NOR,me,target);
extra+= me->query_temp("apply/damage");
extra-= target->query_temp("apply/armor");
extra = extra + random(extra/2);
if (extra<300)    extra=300;
ap = me->query_skill("sword");
dp = target->query_skill("dodge")+target->query_skill("parry");
    if (random(ap+dp) > dp/3)    {
        msg =HIW"$n被$N的剑势所迫，动弹不得！\n";
        if ( !target->is_busy() )  target->start_busy(2+random(2));
        target->receive_wound("kee",extra*2,me);
        target->receive_wound("sen",extra*2,me);
        COMBAT_D->report_status(target);
        COMBAT_D->report_sen_status(target);
        }
    else    msg = WHT"但是$n并不惧于$N的剑势。\n";
    message_vision(msg+NOR, me, target);
    }
// 第15剑，恢复为原来的限制条件，如果random(7)概率太高了，那样也太恐怖了
//fang@tsrj,希望windy大虾理解
//可以，但原先杀气的条件的确不太合适，这里一般都不带杀气的，形同虚设，hehe。windy
if((int)me->query_skill("duo-sword", 1) > 349 &&  !random(20) && me->query("family/family_name") == "神剑山庄" )    {
message_vision(CYN "$N的这一剑刺出，所有的变化已到了穷尽，本已到了尽头的流水，现在就像是已完全枯竭。
$N的力也已将竭了。可是就在这时候，$N手中的剑忽然又起了奇异的震动,天地万物忽然全都静止，
绝对静止，没有变化，没有生机!这一剑带来的，只有死!只有"NOR+BLINK+BLU"「死」"NOR+CYN"，才是所有一切的终结，才是
真正的终结!流水乾枯，变化穷尽，生命终结，万物灭亡!这才是"NOR+BLINK+RED"「夺命十三剑」"NOR+CYN"真正的精粹!这才是
真正夺命的一剑!这一剑赫然已经是"HIR"第"BLINK+HIW"\t十\t五\t"NOR+HIR"剑"NOR+CYN"！\n"NOR,me,target);
msg = HIB "所有的生命和力量，都已被$N这一剑夺去,$n脸上忽然露出种恐惧之极的表情。\n"NOR;
message_vision(msg, me, target);
target->set_temp("last_damage_from",me);
target->receive_wound("kee",10,me);//防止杀了不算的bug
target->die();
        }
me->start_busy(2+random(2));
return 1;
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("duo-sword")+" 200 级\n"; 
temp+= "\t\t"+to_chinese("cloudforce")+" 200 级\n"; 
temp+= "\t\t内力修为二十年\n"; 
temp+= "\t\t内力1000点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                连续打击对手的气血并有可能导致必杀
        出招类型： 
                busy 型外功
                有隐藏攻击
                叛师不可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}

