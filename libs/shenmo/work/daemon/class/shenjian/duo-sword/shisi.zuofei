
// modify by windy 06/04/28
#include <ansi.h>
inherit SSERVER; 

string name()  
{
return "「"HIB"夺命十四剑"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "神剑山庄")  
        return notify_fail("只有神剑山庄弟子才能使用"+name()+"！\n");  
if((int)me->query_skill("duo-sword", 1) < 200) 
        return notify_fail("你的夺命剑法修为太差，难以施展"+name()+"！\n"); 
if ( me->query_skill("cloudforce", 1)<200 )
        return notify_fail("你的云裳心法还不够纯熟！\n");
if ( time()-me->query_temp("shisi_end")<3 )
        return notify_fail("绝招用多了就不灵了！\n");
if ( me->query("force")<1500 )
        return notify_fail("你的真气不够了。\n");
return 1;  
}

int perform(object me, object target)
{
int ap, dp;
string msg;
int i,extra,damage,ff;
object weapon;                 

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
extra = me->query_skill("duo-sword",1);
weapon = me->query_temp("weapon");
damage = me->query_temp("apply/damage");
damage+= me->query("force_factor");
damage-= target->query_temp("apply/armor");
if ( damage<100 ) damage = 100;
if ( extra<300 ) i = 5;
else if ( extra<350 ) i = 8;
else if ( extra<400 ) i = 10;
else  i = 13;
ff = 100;

message_vision(HIR"$N"HIR"轻描淡写，挥尘如意，一瞬间就已使出夺命十三式，手中的"+ weapon->name()+ HIR "轻灵流动，\n就像是河水般的向$n"HIR"刺出"BLINK+HIC+chinese_number(i)+NOR HIR"剑!\n" NOR,me,target);
me->set_temp("shisi_end",time());
while(i--)
    {
    damage+= damage;
    ff+= 100;
    }
damage = damage/2+random(damage/2);
if ( wizardp(me) )
        tell_object(me,"damage="+damage+"\n");
if ( wizardp(target) )
        tell_object(target,"damage="+damage+"\n");
me->add("force",-ff);

if ( me && target && me->is_fighting(target) )
    {
    ap = me->query_skill("duo-sword",1);
    dp = target->query_skill("dodge")+target->query_skill("parry");
if ( !me->query("env/no_msg") && !target->query("env/no_msg") ) 
message_vision(CYN"$N"CYN"的第十三剑刺出后，所有的变化都似已穷尽，又像是流水已到尽头，剑势也慢了，很慢。\n"NOR,me,target);
COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
if ( !me->query("env/no_msg") && !target->query("env/no_msg") ) 
message_vision(CYN"虽然慢，却在变，$N忽然一剑挥出，不着边际，不成章法。但是这一剑却像是画龙点晴，虽然空，却是所有转变的枢纽。" NOR,me,target);
message_vision(HIR"\n蓦地$N竟然就刺出了夺命十三剑的"HIY"第"HIB"十四"HIY"剑"HIR"-------------------------------------------\n"NOR,me,target);
//msg = RED"\n"RED"$N的剑气和杀气都很重，宛如满天岛云密布。这一剑刺出，忽然间就将满天乌云都拨开了，现出了阳光。这一剑刺出，所有的变化才真的已到了穷尽，本已到了尽头的流水，现在就像是已完全枯竭.\n$N"RED"的力也已竭了。\n\n" NOR; 
    if( random(ap+dp)>dp/2 ) 
        {
        msg =HIW"$n被$N的剑势所迫，动弹不得！\n";
        if ( !target->is_busy() )  target->start_busy(2+random(2));
        if ( damage>5000 )   damage = 5000;
       damage = damage/2+random(damage/2);
        if ( wizardp(me) )  tell_object(me,"damage="+damage+"\n");
        if ( wizardp(target) ) tell_object(target,"damage="+damage+"\n");
        target->receive_wound("kee",damage,me);
        target->receive_wound("sen",damage,me);
        COMBAT_D->report_status(target);
        COMBAT_D->report_sen_status(target);
        }
    else    msg = WHT"但是$n并不惧于$N的剑势。\n";
    message_vision(msg+NOR, me, target);
    }
return 1;
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("duo-sword")+" 200 级\n"; 
temp+= "\t\t"+to_chinese("cloudforce")+" 200 级\n"; 
temp+= "\t\t内力１５００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                连续打击对手的气血和精神并有可能牵制敌人
        出招类型： 
                延时型外功
                有隐藏攻击
                叛师不可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
