
// modify by windy 06/04/28
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIW"剑气纵横"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "神剑山庄" && !me->samsara_check("qingfeng-jian", 1))  
        return notify_fail("只有神剑山庄的人才可以用！\n");  
if((int)me->query_skill("qingfeng-jian", 1) < 120) 
        return notify_fail("你的清风细雨温柔剑根基太差，难以施展"+name()+"！\n"); 
if((int)me->query("max_force") < 1000 ) 
        return notify_fail("你的内力修为不够！\n"); 
if((int)me->query("force") < 500 ) 
        return notify_fail("你的内力不足！\n"); 
if((int)me->query("sen") < 300 ) 
        return notify_fail("你的精神不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
string msg;
int extra; 
object weapon;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
extra = me->query_skill("qingfeng-jian",1); 
extra+= me->query_skill("sword",1); 
extra/=10;
weapon = me->query_temp("weapon"); 
message_vision(HIW"$N手中的"NOR+ weapon->name()+ HIW "一出鞘，就化做一道光华击向$n"HIG"，一道弧形的光华：灿烂、辉煌、美丽。\n"NOR,me,target);
me->add_temp("apply/attack", extra);
me->add_temp("apply/damage", extra);
COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
//if ( !me->query("env/no_msg") && !target->query("env/no_msg") ) 
message_vision(HIY"可是它确实在那里，而且无处不在。可是就在$n"HIY"已确定它存在时，它忽然又不见了。\n"NOR,me,target);
COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
//if ( !me->query("env/no_msg") && !target->query("env/no_msg") ) 
message_vision(WHT"又奇迹般忽然出现，又奇迹般忽然消失。\n"NOR,me,target);
COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
//if ( !me->query("env/no_msg") && !target->query("env/no_msg") ) 
message_vision(HIR"所有的动作和变化，都已在一瞬间完成，终止。就像是流星或者闪电，却又比流星和闪电更接近奇迹。因为催动这变化的力量是$N发出来的。\n"NOR,me,target);
COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
if (extra>200)
COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
if (extra>300)
COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
if (extra>400)
COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
if (extra>500)
COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
me->add_temp("apply/attack", -extra);
me->add_temp("apply/damage", -extra);
me->start_busy(2);
return 1;
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("qingfeng-jian")+" 120 级\n"; 
temp+= "\t\t内力修为１０００点\n"; 
temp+= "\t\t内力５００点\n"; 
temp+= "\t\t精神３００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                连续打击对手的气血
        出招类型： 
                busy 型外功
                无隐藏攻击
                叛师不可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
