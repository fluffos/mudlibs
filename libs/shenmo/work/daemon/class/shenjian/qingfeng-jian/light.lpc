
// write by windy 06/04/28
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"WHT"一剑光寒"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "神剑山庄" && !me->samsara_check("qingfeng-jian", 1))  
        return notify_fail("只有神剑山庄的人才可以用！\n");  
if((int)me->query_skill("qingfeng-jian", 1) < 80) 
        return notify_fail("你的清风细雨温柔剑根基太差，难以施展"+name()+"！\n"); 
if( time()-(int)me->query_temp("light_end") < 2+random(2) ) 
        return notify_fail("绝招用多就不灵了！\n"); 
if((int)me->query("force") < 100 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
string msg; 
int extra; 
object weapon; 
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
extra = me->query_skill("qingfeng-jian",1); 
extra+= me->query_skill("sword",1); 
extra+= me->query("level"); 
extra+= me->query("force_factor"); 
extra+= random(extra/2); 

message_vision(HIB "$N一剑刺出，接着对$n说到：“我这一剑，势在必中，若是不中，再多千百剑也是没用的。”\n" NOR,me,target);
target->receive_damage("kee",extra,me);
target->receive_wound("kee",extra/2,me);
COMBAT_D->report_status(target,0);
me->receive_damage("kee", extra/5,target);
me->add("force", -50);
me->set_temp("light_end",time());
message_vision(HIW "一道寒光从$n身上穿过。\n" NOR,me,target);
return 1; 
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("qingfeng-jian")+" 80 级\n"; 
temp+= "\t\t内力１００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                给对手的气血造成伤害
        出招类型： 
                延时型外功
                百发百中
                叛师不可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
