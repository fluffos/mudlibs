
// modify by windy 06/04/28
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIM"计出连环"NOR"」";  
}
int valid_perform(object me)
{
if(me->query("family/family_name") != "神剑山庄" && me->query_skill("shenji-blade",1) < 350 && !me->samsara_check("shenji-blade") ) 
        return notify_fail("谢掌柜的绝技不是谁都可以用的！\n"); 
if((int)me->query_skill("shenji-blade", 1) < 100) 
        return notify_fail("你的神机刀法根基太差，难以施展"+name()+"！\n"); 
if( time()-(int)me->query_temp("jclh_end") < 1+random(2) ) 
        return notify_fail("你还是先歇歇吧！\n"); 
if((int)me->query("max_force") < 500 ) 
        return notify_fail("你的内力修为不够！\n"); 
if((int)me->query("force") < 500 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
string dodskill,msg;
int extra;
int tmp;
object weapon;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

extra = me->query_skill("shenji-blade",1)/3;
if(me->query("family/family_name") == "神剑山庄") 
extra+=me->query("level")/2;
weapon = me->query_temp("weapon");

message_vision(CYN  "\n$N挥出神机刀法中的绝天灭地的一式－－－计－出－连－环－！！！！\n\n" NOR, me);
message_vision(HIG  "论战篇！$N手中"+weapon->name()+HIG"直劈$n"HIG"！\n" NOR, me, target);
me->add_temp("apply/attack", extra);
me->add_temp("apply/damage", extra);
COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
message_vision(HIY  "胜战篇！$N手中"+weapon->name()+HIY"斜刺$n"HIY"！\n" NOR, me, target);
COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
message_vision(HIM  "混战篇！$N手中"+weapon->name()+HIM"狠剁$n"HIM"！\n" NOR, me, target);
COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
message_vision(HIR  "决战篇！$N手中"+weapon->name()+HIR"加紧，旋风般向$n"HIR"杀去！\n" NOR, me, target);
COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
if ((me->query("spskk")==7 && (int)me->query("level")>(int)target->query("level") && random(3)) || (me->query("spskk")==8 && (int)me->query("level")<(int)target->query("level") && random(3)) || (me->query("spskkk")==3 && random(5)))
        {
        message_vision(HIG  "谋攻篇！$N手中"+weapon->name()+HIG"上挑$n"HIG"的哽嗓咽喉！\n" NOR, me, target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        message_vision(HIY  "九地篇！$N手中"+weapon->name()+HIY"下撩$n"HIY"的下阴要穴！\n" NOR, me, target); 
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        message_vision(HIM  "虚实篇！$N手中"+weapon->name()+HIM"直晃$n"HIM"的面门！\n" NOR, me, target); 
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        message_vision(HIR  "杂变篇！$N手中"+weapon->name()+HIR"刀光连闪，携数道刀气攻向$n"HIR"的前心！\n" NOR, me, target); 
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        }
me->add_temp("apply/attack", -extra);
me->add_temp("apply/damage", -extra);
target->start_busy(random(2));
me->set_temp("jclh_end", time());
return 1;  
}
int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("shenji-blade")+" 100 级\n"; 
temp+= "\t\t内力修为５００点\n"; 
temp+= "\t\t内力５００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效： 
                连续伤害敌人的气血
        出招类型： 
                延时型外功
                有隐藏攻击
                叛师可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
