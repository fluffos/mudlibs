
// write by windy 07/06/22
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIB"掌雷"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "通天教" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("jitian-zhang", 1) < 120) 
        return notify_fail("你的祭天掌法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("unarmed", 1) < 120) 
        return notify_fail("你的扑击格斗之技修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("tongtian-dafa", 1) < 120) 
        return notify_fail("你的通天大法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("max_force") < 1000 ) 
        return notify_fail("你的内力修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("force") < 500 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
object weapon;
int ap, dp, damage;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

ap = (int)me->query("daoxing")/10000+me->query_skill("spells")/10*me->query_skill("spells")/10;
dp = (int)target->query("daoxing")/10000+target->query_skill("spells")/10*target->query_skill("spells")/10;
damage = me->query_skill("unarmed");
damage+= me->query("mana_factor");
damage+= me->query("force_factor");
damage+= me->query("level");
damage-= target->query_temp("apply/armor");
if (damage<100)    damage=100;

message_vision(HIB"\n$N"HIB"潜运通天大法，一张手，一道掌雷飞出，击向$n"HIB"！"NOR,me,target);
if (random(ap+dp)>dp)
        {
        message_vision(HIR"\n$n"HIR"躲闪不及，被掌雷击个正着，全身焦黑！\n"NOR,me,target);
        target->receive_damage("kee", damage+random(damage), me);
        target->receive_wound("kee", damage, me);
        COMBAT_D->report_status(target, 0);
        me->add("force", -500);
        }
else    {
        message_vision(CYN"\n$n"CYN"叫声不好，连忙闪身躲过，掌雷击空，烧出一片焦土。\n"NOR,me,target);
        me->add("force", -100);
        }
me->start_busy(2+random(2));
return 1;
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("jitian-zhang")+" 120 级\n";  
temp+= "\t\t"+to_chinese("unarmed")+" 120 级\n";  
temp+= "\t\t"+to_chinese("tongtian-dafa")+" 120 级\n";  
temp+= "\t\t内力修为十年\n"; 
temp+= "\t\t内力５００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                伤害对手的气血
        出招类型：   
                busy 型外功  
                无隐藏攻击  
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
