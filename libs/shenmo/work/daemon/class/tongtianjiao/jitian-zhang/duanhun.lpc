
// write by windy 07/06/22
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIY"九天断魂"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "通天教" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("jitian-zhang", 1) < 200) 
        return notify_fail("你的祭天掌法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("unarmed", 1) < 200) 
        return notify_fail("你的扑击格斗之技修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("max_force") < 2000 ) 
        return notify_fail("你的内力修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("force") < 1000 ) 
        return notify_fail("你的内力不足！\n"); 
if (time()-me->query_temp("ttj_duanhun")<2+random(3))
        return notify_fail("绝招用多了就不灵了！\n"); 
return 1;  
}

int perform(object me, object target)
{
object weapon;
int extra;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

extra = me->query_skill("unarmed");
weapon = me->query_temp("weapon"); 

message_vision(HIY"\n$N"HIY"心如止水，感觉到九天之上冥冥之中赐予有巨大力量，无意之中使出了通天绝学"HIR"“九天断魂”"HIY"！\n" NOR,me,target);
me->add_temp("apply/attack",extra/3); 
me->add_temp("apply/damage",extra/3); 
if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
message_vision(HIM  "\n  ～ 九 ～\n" NOR,me,target); 
COMBAT_D->do_attack(me, target, weapon); 
if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
message_vision(HIY  "\n         ～ 天 ～\n" NOR,me,target);
COMBAT_D->do_attack(me, target, weapon); 
if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
message_vision(HIW  "\n                  ～ 断 ～\n" NOR,me,target);
COMBAT_D->do_attack(me, target, weapon); 
if ( !me->query("env/no_msg") && !target->query("env/no_msg") )
message_vision(HIR  "\n                           ～ 魂 ～\n" NOR,me,target);
COMBAT_D->do_attack(me, target, weapon); 
me->add_temp("apply/attack",-extra/3); 
me->add_temp("apply/damage",-extra/3); 
me->set_temp("ttj_duanhun",time()); 
return 1;
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("jitian-zhang")+" 200 级\n";  
temp+= "\t\t"+to_chinese("unarmed")+" 200 级\n";  
temp+= "\t\t内力修为二十年\n"; 
temp+= "\t\t内力１０００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                连续打击对手的气血 
        出招类型：   
                延时型外功  
                无隐藏攻击  
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
