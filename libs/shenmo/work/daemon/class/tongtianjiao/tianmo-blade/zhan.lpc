
// write by windy 07/06/21
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIR"天魔斩"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "通天教" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("tianmo-blade", 1) < 300) 
        return notify_fail("你的天魔刀法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("blade", 1) < 300) 
        return notify_fail("你的基本刀法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("tongtian-dafa", 1) < 300) 
        return notify_fail("你的通天大法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("piaomiao-shenfa", 1) < 300) 
        return notify_fail("你的缥缈身法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("max_force") < 4000 ) 
        return notify_fail("你的内力修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("force") < 1000 ) 
        return notify_fail("你的内力不足！\n"); 
if((int)me->query("sen") < 500 ) 
        return notify_fail("你的精神不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
object weapon;
int damage, dragon,skill;
int myhammer;
string msg;

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

weapon = me->query_temp("weapon");
skill = me->query_skill("tongtian-dafa",1);
damage = me->query_skill("tianmo-blade", 1);
damage+= skill;
damage+= me->query_skill("piaomiao-shenfa", 1);;
damage+= me->query("mana_factor");
if (damage < 1000)    dragon = 1;
else if (damage < 2000)    {
        damage = damage/3*4;
        dragon = 2;
}
else {
        damage = damage/5*8;
        dragon = 3;
    }
message_vision(HIG"\n$N"HIG"撮嘴尖啸，猛吸一口气,快速运转通天大法，浑圆霸气散布四周五丈范围，\n"NOR,me,target);
message_vision(HIG"$N"HIG"紧接着一连三刀带起三道劲风，从上，中，下三路带着撕布裂帛般的声音扫向$n"HIG"！\n"NOR,me,target);
message_vision(HIG"$N"HIG"这正是通天教的绝学"HIR"「天魔斩」"HIG"！\n"NOR,me,target);
if (random(skill) > target->query_skill("spells", 1)/6)
        {
        message_vision(HIC"\n$n"HIC"被$N"HIC"刀风中的劲力牵制动弹不得，身中"+chinese_number(dragon)+"刀！\n"NOR,me,target);
        message_vision(HIC"$n"HIC"只觉兵刃对身体造成的疼痛似乎已经不算什么，那巨大的霸气，只震的$n"HIC"的五脏六腑都在颤抖！\n"NOR,me,target);
        if (!target->is_busy())
                target->start_busy(1);
        target->receive_damage("kee", damage*3+random(damage), me);
        target->receive_wound("kee", damage/3, me);
        COMBAT_D->report_status(target);
        }
else    {
        message_vision(MAG"\n$n"MAG"识得这招的厉害，向后几个纵身跳出了$N"MAG"浑圆霸气散布的范围。\n"NOR,me,target);
        }
me->add("force", -500);
me->add("sen", -200);
me->start_busy(1+random(2));
return 1;
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("tianmo-blade")+" 300 级\n";  
temp+= "\t\t"+to_chinese("blade")+" 300 级\n";  
temp+= "\t\t"+to_chinese("tongtian-dafa")+" 300 级\n";  
temp+= "\t\t"+to_chinese("piaomiao-shenfa")+" 300 级\n";  
temp+= "\t\t内力修为四十年\n"; 
temp+= "\t\t内力１０００点\n"; 
temp+= "\t\t精神５００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                伤害对手的气血
        出招类型：   
                busy 型外功  
                有隐藏效果
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
