#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIB"天魔附体"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "通天教" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("tianmo-blade", 1) < 200) 
        return notify_fail("你的天魔刀法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("blade", 1) < 200) 
        return notify_fail("你的基本刀法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("tongtian-dafa", 1) < 200) 
        return notify_fail("你的通天大法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("max_force") < 1000 ) 
        return notify_fail("你的内力修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("force") < 500 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
object weapon; 
int damage, skill, ap, dp; 
string msg; 

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 

if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
if ( time()<target->query_temp("no_move/start")+target->query_temp("no_move/time") )
        return notify_fail(target->query("name")+"已经被天魔附体制住元神了！\n");  
ap = me->query_skill("blade") + me->query_skill("tongtian-dafa", 1); 
dp = target->query_skill("parry") + target->query_skill("spells", 1); 
weapon=me->query_temp("weapon");

message_vision(HIB"\n$N"HIB"突然大喝一声，将掌中"+weapon->name()+""HIB"向空中一立，瞬时从刀中幻出一道蓝光飞向$n"HIB"！\n"NOR,me, target); 
if (ap/2+ random(ap) > dp/2) 
        {
        message_vision(HIB"$n"HIB"不知所措，恰好被这道蓝光罩住，登时元神无主，呆立当场！\n"NOR,me,target); 
        skill = me->query_skill("tongtian-dafa",1);
        skill=skill/30;
        if (skill>30)  skill=30;
        target->set_temp("no_move/start",time());
        target->set_temp("no_move/time",skill);
//        call_out("free", skill, target);
        }
else    {
        message_vision(HIC"不料确被$n"HIC"看破玄机，纵身一跃，躲开了蓝光！\n"NOR,me,target); 
        me->start_busy(1+random(3));  
        }
me->add("force", -200);
return 1;
}

void free(object target)
{
        if (target)
        target->delete_temp("no_move");      
        return;
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("tianmo-blade")+" 200 级\n"; 
temp+= "\t\t"+to_chinese("blade")+" 200 级\n"; 
temp+= "\t\t"+to_chinese("tongtian-dafa")+" 200 级\n"; 
temp+= "\t\t内力修为十年\n"; 
temp+= "\t\t内力５００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                使对手不能移动
        出招类型：  
                busy 型外功 
                无隐藏攻击 
                叛师不可带出  
        出手要求：    
HELP);              
write(temp);  
return 1;  
}
