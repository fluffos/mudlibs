
// write by windy 07/06/21
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIC"疾风刀"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "通天教" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("tianmo-blade", 1) < 350) 
        return notify_fail("你的天魔刀法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("blade", 1) < 350) 
        return notify_fail("你的基本刀法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("yiqi-hunyuan", 1) < 350) 
        return notify_fail("你的一气混元功修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("piaomiao-shenfa", 1) < 350) 
        return notify_fail("你的缥缈身法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("max_force") < 5000 ) 
        return notify_fail("你的内力修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("force") < 2000 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
object weapon;
int extra, i;
int addon, tmp, atk;

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

weapon = me->query_temp("weapon");
extra = me->query_skill("tianmo-blade",1);
addon = me->query_skill("yiqi-hunyuan",1);
tmp= me->query_skill("piaomiao-shenfa",1);
atk = (addon+tmp)/3;

message_vision(HIW"\n$N"HIW"神气贯通，将一气混元功运转一周天，身体急旋施展出天魔疾风刀的绝技！\n "NOR, me,target);
message_vision(HIC"但见漫天刀光犹如狂风暴雨般卷向$n"HIC"！\n"NOR,me,target);
if (!target->is_busy())    target->start_busy(1);
me->add_temp("apply/attack",atk/2);
me->add_temp("apply/damage",extra/3);
for (i=0;i<=7;i++)
        {
        COMBAT_D->do_attack(me,target,weapon);
        if (target->query("force")>200)    target->add("force", -200);
        }
message_vision(HIM"$n"HIM"在暴风雨般的刀光中飘摇不定，最后$N"HIM"聚万道刀光和一迅捷无比的砍向$n"HIM"！！！\n"NOR,me,target);
COMBAT_D->do_attack(me,target,weapon);
me->add_temp("apply/attack",-atk/2);
me->add_temp("apply/damage",-extra/3);
me->start_busy(2);
return 1;
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("tianmo-blade")+" 350 级\n";  
temp+= "\t\t"+to_chinese("blade")+" 350 级\n";  
temp+= "\t\t"+to_chinese("yiqi-hunyuan")+" 350 级\n";  
temp+= "\t\t"+to_chinese("piaomiao-shenfa")+" 350 级\n";  
temp+= "\t\t内力修为五十年\n"; 
temp+= "\t\t内力２０００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                连续打击对手的气血
        出招类型：   
                busy 型外功  
                有隐藏攻击
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
