
// write by windy 07/06/22
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIC"天魔献月"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "通天教" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("tianmo-blade", 1) < 150) 
        return notify_fail("你的天魔刀法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("blade", 1) < 150) 
        return notify_fail("你的基本刀法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("yiqi-hunyuan", 1) < 150) 
        return notify_fail("你的一气混元功修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("max_force") < 500 ) 
        return notify_fail("你的内力修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("force") < 300 ) 
        return notify_fail("你的内力不足！\n"); 
if (time()-me->query_temp("tianmo_xian")<3+random(2))
        return notify_fail("你现在体力不继！\n"); 
return 1;  
}

int perform(object me, object target)
{
object weapon;
int ap, dp, damage;

if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

weapon = me->query_temp("weapon");
ap = (int)me->query("combat_exp")/200000;
ap+= (int)me->query("level")*(int)me->query("level")/500;
dp = (int)target->query("combat_exp")/200000;
ap+= (int)target->query("level")*(int)target->query("level")/500;
damage = (int)me->query_skill("blade");
damage+= (int)me->query_skill("yiqi-hunyuan", 1);
message_vision(HIC"\n只见"+weapon->name()+""HIC"在$N"HIC"掌中急速旋转，越转越快，突然飞出，向$n"HIC"切去！"NOR,me,target); 
if (random(ap)>dp/5)
        {
        message_vision(RED"\n$n"RED"躲闪不及，已被"+weapon->name()+""RED"切得体无完肤，血如箭般由全身喷射而出！\n"NOR,me,target); 
        target->receive_damage("kee",damage, me); 
        target->receive_wound("kee",damage/2, me); 
        COMBAT_D->report_status(target); 
        }
else    {
        message_vision(CYN"可是$n"CYN"急忙抽身躲开，$N"CYN"这招没有得逞。\n" NOR,me,target); 
        }
me->add("force", -200); 
me->set_temp("tianmo_xian",time()); 
return 1;
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("tianmo-blade")+" 150 级\n";  
temp+= "\t\t"+to_chinese("blade")+" 150 级\n";  
temp+= "\t\t"+to_chinese("yiqi-hunyuan")+" 150 级\n";  
temp+= "\t\t内力修为五年\n"; 
temp+= "\t\t内力３００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                伤害对手的气血
        出招类型：   
                延时型外功  
                无隐藏效果
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
