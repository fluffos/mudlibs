#include <ansi.h>
int exert(object me, object target)
{
	if( me->is_fighting() )
		return notify_fail("战斗中运功疗伤？找死吗？\n");
	if( (int)me->query("force") < 50 )
		return notify_fail("你的内力不够。\n");
if ( !wizardp(this_player()) && (me->query("family/family_name") != "通天教"))
                return notify_fail("你不够资格。\n");
	if( (int)me->query("eff_sen") < (int)me->query("max_sen") / 2 )
		return notify_fail("你精神实在不济，运功死的更快，还是别忙了！\n");
        message_vision(
   HIC "$N坐了下来运起一气混元功，一股上清真气在体内运转......\n"
		"过了不久，$N额头上冒出豆大的汗珠，吐出一口瘀血，脸色看起来红润多了。\n" NOR,
	me );
me->receive_curing("sen", 10 + (int)me->query_skill("spells")/2 );
	me->add("force", -50);
	me->set("force_factor", 0);
	return 1;
}
