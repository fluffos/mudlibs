
// write by windy 07/06/18
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"YEL"浊流剑"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "通天教" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("shangqing-sword", 1) < 120) 
        return notify_fail("你的上清剑法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("sword", 1) < 120) 
        return notify_fail("你的基本剑术修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("yiqi-hunyuan", 1) < 120) 
        return notify_fail("你的一气混元功修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("max_force") < 1000 ) 
        return notify_fail("你的内力修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("force") < 500 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
int ap, dp, damage;
object weapon;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

ap = me->query_skill("sword");
dp = target->query_skill("parry");
damage = me->query_skill("shangqing-sword", 1);
damage+= me->query_skill("sword", 1)/2;
damage+= me->query_skill("force_factor", 1);
damage-= target->query("force_factor");
if (damage<500)    damage = 500;
weapon = me->query_temp("weapon");

message_vision(YEL"\n只见$N"YEL"手中"+weapon->name()+""YEL"一抖，施出上清剑法之「浊流剑」，霎时无数剑光罩向$n"YEL"！"NOR,me,target);
if (ap / 2 + random(ap) > dp)
        {
        message_vision(HIR"\n$n"HIR"只感剑光夺目，顿时眼花缭乱，被$N"HIR"一剑刺中，鲜血飞溅。\n"NOR,me,target);
        me->add("force", -500);
        target->receive_wound("kee",damage,me);
        target->receive_damage("kee",damage*2+random(damage),me);
        COMBAT_D->report_status(target,0);
        if (me->query("ttj/zhuo_success")<300 && !me->query("ttj/qing_agree"))
                {
                tell_object(me,HIW"\n实战中，你似乎对上清剑法的领悟又加深了一层。\n"NOR); 
                me->add("ttj/zhuo_success", 1);
                }
        if (me->query("ttj/zhuo_success")>=300)
                {
                tell_object(me,BLINK+HIW"\n经过勤加练习，你的上清剑法进入了一个崭新的境界！\n"NOR); 
                me->set("ttj/qing_agree", 1);
                me->delete("ttj/zhuo_success");
                }
        }
else    {
        message_vision(CYN"\n可是$n"CYN"看破了$N"CYN"的招数，飞身一纵，避开了这一剑。\n"NOR,me,target);
        me->add("force", -200);
        }
me->start_busy(2+random(2));
return 1;
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("shangqing-sword")+" 120 级\n";  
temp+= "\t\t"+to_chinese("sword")+" 120 级\n";  
temp+= "\t\t"+to_chinese("yiqi-hunyuan")+" 120 级\n";  
temp+= "\t\t内力修为十年\n"; 
temp+= "\t\t内力５００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                伤害对手气血
        出招类型：   
                busy 型外功  
                无隐藏攻击  
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
