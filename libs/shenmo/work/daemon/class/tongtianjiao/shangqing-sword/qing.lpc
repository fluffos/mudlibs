
// write by windy 07/06/22
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIG"清流剑"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "通天教" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("shangqing-sword", 1) < 360) 
        return notify_fail("你的上清剑法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("sword", 1) < 360) 
        return notify_fail("你的基本剑术修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("yiqi-hunyuan", 1) < 360) 
        return notify_fail("你的一气混元功修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("piaomiao-shenfa", 1) < 360) 
        return notify_fail("你的缥缈身法修为太浅，难以施展"+name()+"！\n"); 
if (me->query("ttj/qing_agree")==0)
        return notify_fail("你还没有练成"+name()+"，还是在「"YEL"浊流剑"NOR"」上多下些功夫吧！\n"); 
if((int)me->query("max_force") < 4000 ) 
        return notify_fail("你的内力修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("force") < 1000 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
int ap, dp, damage;
object weapon;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

ap = me->query_skill("sword");
dp = target->query_skill("parry");
damage = me->query_skill("shangqing-sword", 1);
damage+= me->query_skill("sword", 1)/2;
damage+= me->query_skill("force_factor", 1);
damage+= me->query_skill("yiqi-hunyuan", 1);
damage+= me->query_skill("piaomiao-shenfa", 1);
damage+= me->query("level");
damage-= target->query("level");
if (damage<100)    damage = 100;
weapon = me->query_temp("weapon");

message_vision(HIG"\n$N"HIG"施出上清剑法「清流剑」绝技，手中"+weapon->name()+""HIG"急颤，对准$n"HIG"连攻数剑，招式凌厉无比！"NOR,me,target);
if (ap / 2 + random(ap) > dp/2)
        {
        message_vision(HIR"\n$n"HIR"奋力抵挡，却哪里招架得住，被$N"HIR"这一剑刺中要脉，鲜血四处飞溅！\n"NOR,me,target);
        me->add("force", -500);
        target->receive_wound("kee",damage/2,me);
        target->receive_damage("kee",damage*4+random(damage),me);
        COMBAT_D->report_status(target,0);
        }
else    {
        message_vision(CYN"\n$n"CYN"凝神聚气，硬声声将"CYN"这一剑架开，丝毫无损。\n"NOR,me,target);
        me->add("force", -200);
        }
me->start_busy(2+random(2));
return 1;
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("shangqing-sword")+" 360 级\n";  
temp+= "\t\t"+to_chinese("sword")+" 360 级\n";  
temp+= "\t\t"+to_chinese("yiqi-hunyuan")+" 360 级\n";  
temp+= "\t\t"+to_chinese("piaomiao-shenfa")+" 360 级\n";  
temp+= "\t\t内力修为四十年\n"; 
temp+= "\t\t内力１０００点\n"; 
temp+= "\t\t须解密\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                伤害对手气血
        出招类型：   
                busy 型外功  
                无隐藏攻击  
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
