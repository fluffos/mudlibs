
// write by windy 07/06/24
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIC"通天彻地"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "通天教" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("shangqing-sword", 1) < 300) 
        return notify_fail("你的上清剑法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("sword", 1) < 300) 
        return notify_fail("你的基本剑术修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("tongtian-dafa", 1) < 300) 
        return notify_fail("你的通天大法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("piaomiao-shenfa", 1) < 300) 
        return notify_fail("你的缥缈身法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("max_force") < 4000 ) 
        return notify_fail("你的内力修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("force") < 2000 ) 
        return notify_fail("你的内力不足！\n"); 
if((int)me->query_temp("td_busy")+random(5) > time() ) 
        return notify_fail("绝招用的太多，不灵了！\n"); 
return 1;  
}

int perform(object me, object target)
{
object weapon;
int extra, i;
int lvl;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

weapon = me->query_temp("weapon");
extra = me->query_skill("sword",1);
extra+= me->query_skill("tongtian-dafa",1);
extra+= me->query_skill("piaomiao-shenfa",1);
extra/=10;
lvl = me->query_skill("shangqing-sword")/100;
if (lvl>9)    lvl=9;

message_vision(HIC"\n$N"HIC"采天地之灵气，吸日月之精华，急颤手中"+weapon->name()+""HIC"，一式「通天彻地」磅礴而出，气势惊人！\n "NOR, me,target);
if (!target->is_busy())    target->start_busy(1);
me->add_temp("apply/attack",extra);
me->add_temp("apply/damage",extra);
for (i=0;i<=lvl;i++)
        {
        COMBAT_D->do_attack(me,target,weapon);
        if (target->query("mana")>200)    target->add("mana", -200);
        }
me->add_temp("apply/attack",-extra);
me->add_temp("apply/damage",-extra);
me->set_temp("td_busy",time());
return 1;
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("shangqing-sword")+" 300 级\n";  
temp+= "\t\t"+to_chinese("sword")+" 300 级\n";  
temp+= "\t\t"+to_chinese("tongtian-dafa")+" 300 级\n";  
temp+= "\t\t"+to_chinese("piaomiao-shenfa")+" 300 级\n";  
temp+= "\t\t内力修为四十年\n"; 
temp+= "\t\t内力２０００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                连续打击对手气血
        出招类型：   
                延迟型外功  
                有隐藏效果  
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
