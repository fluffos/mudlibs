#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIW"逍遥快剑"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "通天教" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("shangqing-sword", 1) < 300) 
        return notify_fail("你的上清剑法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("sword", 1) < 300) 
        return notify_fail("你的基本剑术修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("force") < 1000 ) 
        return notify_fail("你的内力不足！\n"); 
if (time()-me->query_temp("ttj_kuai")<3+random(3))
        return notify_fail("绝招用多了就不灵了！\n"); 
return 1;
}

int perform(object me, object target)
{
object *ob, where;
int i, ap;
object weapon;

if ( !valid_perform(me) )
        return 0;
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

weapon = me->query_temp("weapon");
where=environment(me);
ob = all_inventory(environment(me));
ap = me->query("combat_exp")/200000+me->query("level")*me->query("level")/500;
message_vision(HIW"\n$N"HIW"一声长啸，急颤手中"+weapon->name()+""HIW"，身形似闪电一般，竟然在转瞬间向在场的每一个人都刺出了一剑！\n" NOR,me);
for(i=0; i<sizeof(ob); i++)
        {
        if( !living(ob[i]) || ob[i]==me ) continue;
        if(!ob[i]->is_fighting(me)) continue;
        if(ob[i]->is_busy()) continue;
        if( random(ap) < (ob[i]->query("combat_exp")/200000+ob[i]->query("level")*ob[i]->query("level")/500)/5 ) continue;
        message_vision(HIM"结果$n"HIM"未曾防范，吃惊非小，被$N"HIM"的剑势逼得手忙脚乱！\n" NOR,me,ob[i]);
        ob[i]->start_busy(3);
        }
me->add("force", -600);
me->set_temp("ttj_kuai", time());
return 1;
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("shangqing-sword")+" 300 级\n";  
temp+= "\t\t"+to_chinese("sword")+" 300 级\n";  
temp+= "\t\t"+to_chinese("piaomiao-shenfa")+" 300 级\n";  
temp+= "\t\t内力１０００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                牵制对手
        出招类型：   
                延时型外功  
                同时袭击多个对手
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
