
// write by windy 07/06/22
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIW"白云无尽"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "通天教" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("duanyun-zhang", 1) < 250) 
        return notify_fail("你的断云掌法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("unarmed", 1) < 250) 
        return notify_fail("你的扑击格斗之技修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("max_force") < 3000 ) 
        return notify_fail("你的内力修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("force") < 1500 ) 
        return notify_fail("你的内力不足！\n"); 
return 1;  
}

int perform(object me, object target)
{
object weapon;
int extra, i;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
extra = me->query_skill("unarmed");
weapon = me->query_temp("weapon"); 
message_vision(HIW"\n$N"HIW"双掌翻飞，如白云朵朵，看似轻飘无力，实则暗藏绵劲，转瞬间已攻出数招！\n" NOR,me,target);
me->add_temp("apply/attack",extra/4); 
me->add_temp("apply/damage",extra/4); 
for (i=0;i<=5;i++)
        {
        COMBAT_D->do_attack(me, target, weapon); 
        }
me->add_temp("apply/attack",-extra/4); 
me->add_temp("apply/damage",-extra/4); 
me->start_busy(2+random(2));
return 1;
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("duanyun-zhang")+" 250 级\n";  
temp+= "\t\t"+to_chinese("unarmed")+" 250 级\n";  
temp+= "\t\t内力修为三十年\n"; 
temp+= "\t\t内力１５００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                连续打击对手的气血 
        出招类型：   
                busy 型外功  
                无隐藏攻击  
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
