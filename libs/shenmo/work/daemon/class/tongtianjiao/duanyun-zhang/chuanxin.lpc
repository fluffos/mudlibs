
// write by windy 07/06/22
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIR"穿心"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "通天教" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("duanyun-zhang", 1) < 150) 
        return notify_fail("你的断云掌法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("unarmed", 1) < 150) 
        return notify_fail("你的扑击格斗之技修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("yiqi-hunyuan", 1) < 150) 
        return notify_fail("你的一气混元功修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("max_force") < 1000 ) 
        return notify_fail("你的内力修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query("force") < 500 ) 
        return notify_fail("你的内力不足！\n"); 
if (time()-me->query_temp("ttj_chuanxin")<3+random(3))
        return notify_fail("绝招用多了就不灵了！\n"); 
return 1;  
}

int perform(object me, object target)
{
int ap, dp, damage;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

ap = (int)me->query_skill("unarmed", 1);
ap+= (int)me->query_skill("yiqi-hunyuan", 1);
dp = (int)target->query_skill("parry", 1);
dp+= (int)target->query_skill("force", 1);

damage = me->query_skill("duanyun-zhang", 1);
damage+= me->query_skill("force_factor");
damage+= random(damage);

message_vision(HIY"\n$N"HIY"一声冷笑，双掌一错，陡然施出一招"HIR"「穿心掌」"HIY"，幻出千百之手掌一齐插向$n"HIY"！"NOR,me,target);
if (ap/2+random(ap)>dp/2)
        {
        message_vision(HIR"\n结果$n"HIR"没能避开$N"HIR"变幻莫测的掌法，掌劲顿时透胸而过！\n"NOR,me,target);
        target->receive_damage("kee", damage*3+random(damage), me);
        target->receive_wound("kee", damage, me);
        COMBAT_D->report_status(target, 0);
        me->add("force", -300);
        }
else    {
        message_vision(CYN"\n可是$n"CYN"识破了$N"CYN"这一招，斜斜一跃避开。\n"NOR,me,target);
        me->add("force", -100);
        }
me->set_temp("ttj_chuanxin", time());
return 1;
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("duanyun-zhang")+" 150 级\n";  
temp+= "\t\t"+to_chinese("unarmed")+" 150 级\n";  
temp+= "\t\t"+to_chinese("yiqi-hunyuan")+" 150 级\n";  
temp+= "\t\t内力修为十年\n"; 
temp+= "\t\t内力５００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                伤害对手的气血
        出招类型：   
                延时型外功  
                无隐藏攻击  
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
