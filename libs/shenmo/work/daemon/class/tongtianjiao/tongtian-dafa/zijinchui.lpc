
// windy
#include <ansi.h>
inherit SSERVER;

int cast(object me, object target)
{
        int success_adj, damage_adj;
        if(me->query("family/family_name")!="通天教" || me->query("class")!="saint")
               return notify_fail("你非通天教弟子，不能用「紫金锤」！\n");
        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展「紫金锤」？\n");
if( time()-(int)me->query_temp("zijinchui_cast") < 3+random(5) ) 
        return notify_fail(YEL"你的魔法尚未恢复！\n"NOR);
        if((int)me->query("mana") < 100+2*(int)me->query("mana_factor") )
                return notify_fail("你的法力不够！\n");
        if((int)me->query("sen") < 100 )
                return notify_fail("你无法集中精力！\n");

        me->add("mana", -25-2*(int)me->query("mana_factor"));
        me->receive_damage("sen", 50);

        if( random(me->query("max_mana")) < 50 ) {
                write("你现在心神不宁。\n");
                return 1;
        }

        SPELL_D->attacking_cast(
                me, 
                        //attacker 
                target, 
                        //target
                "kee",          
                        //damage type: could be "qi"/"kee", "shen"/"sen", ...default "both"
                MAG "\n$N"MAG"念了几句咒语，手里突然多了一柄紫金锤，紧接着一锤飞出，打向$n"MAG"的前心！\n" NOR,
                        //initial message
                HIR "\n紫金锤携风雷之势而来，$n"HIR"躲闪不及，被打个正着，鲜血狂喷而出！\n" NOR, 
                        //success message
                HIC "$n"HIC"镇定自若，轻轻一闪，紫金锤打了个空。\n" NOR, 
                        //fail message
                HIC "谁知$n"HIC"用法力一逼，紫金锤反向$N"HIC"打去！\n" NOR, 
                        //backfire initial message
                HIR "\n结果$N"HIR"躲闪不及，被打个正着，鲜血狂喷而出！\n" NOR, 
                        //backfire hit message. note here $N and $n!!!
        );
me->set_temp("zijinchui_cast",time()); 
        return 3+random(5);
}
