// zhangyan.c 障眼法
// writted by windy 2006/11

inherit SSERVER;
#include <ansi.h>

int cast(object me)
{
        int howlong;
        int spell;
        spell=me->query_skill("spells")/2 + me->query_skill("tongtian-dafa");
if((me->query("family/family_name") != "通天教" || me->query("class")!="saint") && !me->samsara_check("tongtian-dafa",1))
                return notify_fail("障眼法是通天教不传之秘。\n");
        if(spell < 300)
                return notify_fail("你法术修为太浅。\n");

        if( (int)me->query("mana") < 2*(int)me->query_skill("spells"))
                return notify_fail("你的法力不够了！\n");

        if( (int)me->query("sen") < 50 )
                return notify_fail("你的精神无法集中！\n");
        if(me->query_temp("in_dart"))
                return notify_fail("你一想到自己镖车在身，责任重大，就打消了藏匿形迹的念头！\n");

        
        message_vision("$N使了个障眼法，拟将身形隐去。\n", me);

        if( random(me->query("max_mana")) < 100 ) {
                me->add("mana",-(int)me->query_skill("spells"));
                me->receive_damage("sen",10);
                message("vision", "可是却失败了，看来通天大法练得还不到家。\n", environment(me));
                return 5+random(5);
        }

        me->add("mana", -2*(int)me->query_skill("spells"));
        me->receive_damage("sen", 20);

        howlong = 10 + random((me->query_skill("spells") -100));
        if (!me->query("env/invisibility"))
                call_out("free", howlong, me, howlong);
else
 return notify_fail("你已经在隐身了！\n"); 
        me->set_temp("zhangyantime", howlong+(int)me->query_temp("zhangyantime"));

        me->set("env/invisibility", 3);
        me->set_temp("no_heal_up/zhangyan",1);
        
        message_vision(HIB"\n果真$N"HIB"不见了身影。\n\n"NOR, me);
        
        return 5+random(5);
}

void free(object user, int howlong)
{
        if(!user) return;
        if (!user->query("env/invisibility")) return;
        if (user->query_temp("zhangyantime") - howlong) {
                user->set_temp("zhangyantime", 
                        user->query_temp("zhangyantime") - howlong);
                call_out("free", user->query_temp("zhangyantime"), 
                        user, user->query_temp("zhangyantime"));
                return;
                }
        user->delete_temp("zhangyantime");
        user->set("env/invisibility", 0);      
        user->save();
        message_vision(HIB"\n障眼法到限，$N"HIB"又显出了身形。\n\n"NOR, user);
        user->delete_temp("no_heal_up/zhangyan");
        return;
}


