
// write by windy 07/06/22
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIW"点字诀"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "通天教" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("riyue-bian", 1) < 250) 
        return notify_fail("你的日月鞭法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("whip", 1) < 250) 
        return notify_fail("你的基础鞭术修为太浅，难以施展"+name()+"！\n"); 
if( (int)me->query_skill("piaomiao-shenfa", 1) < 250 )
        return notify_fail("你的缥缈身法修为太浅，难以施展"+name()+"！\n"); 
if( me->query("force") < 1000 )
        return notify_fail("你的内力不足！\n");
if( me->query("max_force") < 3000 )
        return notify_fail("你的内力修为太差！\n");
if (time()-me->query_temp("ttj_dian")<3+random(3))
        return notify_fail("绝招用多了就不灵了！\n");
return 1;  
}

int perform(object me, object target)
{
object weapon;
int ap, dp, damage;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

weapon = me->query_temp("weapon");
ap = me->query_skill("whip", 1);
ap+= me->query_skill("force", 1);
ap+= me->query_skill("dodge", 1);
dp = target->query_skill("parry", 1);
dp+= target->query_skill("force", 1);
damage = me->query_skill("riyue-bian", 1);
damage+= me->query_skill("whip", 1)/2;
damage+= me->query_skill("piaomiao-shenfa", 1)/2;
damage+= me->query("force_factor");
damage+= me->query("level");
damage-= target->query_temp("apply/armor")/3;
if (damage<100)    damage=100;

message_vision(HIW"\n$N"HIW"力贯鞭身，手中"+weapon->name()+""HIW"变得笔直，鞭梢带着啸声疾点$n"HIW"面门！"NOR,me,target);
if (ap/3+random(ap)>dp/2)
        {
        message_vision(HIR"\n$n"HIR"躲闪不及，鞭梢正中面门，顿时被击得血肉模糊！\n"NOR,me,target);
        target->receive_damage("kee", damage, me);
        target->receive_wound("kee", damage/3, me);
        target->receive_damage("sen", damage, me);
        target->receive_wound("sen", damage/3, me);
        COMBAT_D->report_status(target, 0);
        COMBAT_D->report_sen_status(target, 0);
        me->add("force", -500);
        }
else    {
        message_vision(CYN"\n$n"CYN"暗叫不妙，连忙把头一闪，鞭梢贴着耳畔钻了过去。\n"NOR,me,target);
        me->add("force", -200);
        }
me->set_temp("ttj_dian", time());
return 1;
}

int help(object me)  
{
string temp;    
temp = "\t\t"+to_chinese("riyue-bian")+" 250 级\n";  
temp+= "\t\t"+to_chinese("whip")+" 250 级\n";  
temp+= "\t\t"+to_chinese("piaomiao-shenfa")+" 250 级\n";  
temp+= "\t\t内力修为三十年\n"; 
temp+= "\t\t内力１０００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");   
write(@HELP 

        使用功效：   
                伤害对手的气血和精神
        出招类型：   
                延时型外功  
                无隐藏攻击  
                叛师不可带出   
        出手要求：     
HELP);    
write(temp); 
return 1;   
}
