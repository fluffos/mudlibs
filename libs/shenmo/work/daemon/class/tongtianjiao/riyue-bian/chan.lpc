
// write by windy 07/06/22
#include <ansi.h>
#include <combat.h> 
inherit SSERVER; 

string name()  
{
return "「"HIY"缠字诀"NOR"」";  
}

int valid_perform(object me)
{
if(me->query("family/family_name") != "通天教" || me->query("class")!="saint")
        return notify_fail("你不够资格使用"+name()+"！\n"); 
if((int)me->query_skill("riyue-bian", 1) < 150) 
        return notify_fail("你的日月鞭法修为太浅，难以施展"+name()+"！\n"); 
if((int)me->query_skill("whip", 1) < 150) 
        return notify_fail("你的基础鞭术修为太浅，难以施展"+name()+"！\n"); 
if( (int)me->query_skill("yiqi-hunyuan", 1) < 150 )
        return notify_fail("你的一气混元功修为太浅，难以施展"+name()+"！\n"); 
if( me->query("force") < 500 )
        return notify_fail("你的内力不足！\n");
if((int)me->query_temp("rychan_time") > time() ) 
        return notify_fail("频繁使用"+name()+"对身体不利！\n"); 
return 1;  
}

int perform(object me, object target)
{
string msg;
object weapon, weapon2;
int skill, skill1, skill2, ap, dp, damage;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   
if (!objectp(weapon2 = target->query_temp("weapon")))
        return notify_fail("对方没有使用兵器，你用不了"+name()+"。\n");

skill = me->query_skill("yiqi-hunyuan",1);
skill1 = me->query_skill("riyue-bian",1);
skill2 = me->query_skill("whip",1);
weapon = me->query_temp("weapon");
damage = skill+skill1+skill2;
damage = damage+random(damage)/2;
ap = skill1+skill2;
dp = target->query_skill("parry", 1);
dp+=target->query_skill("unarmed", 1);
message_vision(HIY"\n$N"HIY"轻叱一声，手中的"+weapon->name()+""HIY"似灵蛇一般，缠向$n"HIY"手中的"+weapon2->name()+""HIY"！"NOR,me,target);
if (ap/3+random(ap)>dp/2)
        {
        message_vision(HIW"\n结果$n"HIW"手中的"+weapon->name()+""HIW"被缠个正着，收也不是，放也不是，进退两难！"NOR,me,target);
        message_vision(HIW"\n$n"HIW"正惊疑间，只感觉一股强大的混元劲传到自己的手臂，随即一口鲜血喷出！\n"NOR,me,target);
        target->receive_damage("kee", damage, me);
        target->receive_wound("kee", damage/3, me);
        COMBAT_D->report_status(target); 
        message_vision(HIY"\n$n"HIY"无奈之下，只得撒手，掌中"+weapon2->name()+""HIY"当啷一声被$N"HIY"甩在地上！\n"NOR,me,target);
        if (weapon2->query("no_get") || weapon2->query("no_drop") || weapon2->query("warcity"))  
                destruct(weapon2);  
        else    weapon2->move(environment(me));
        target->start_busy(1+random(2));
        }
else    {
        message_vision(CYN"\n$n"CYN"识得此招厉害，急掣手中"+weapon2->name()+""CYN"，幸好没被缠中。\n"NOR,me,target);
        }
me->set_temp("rychan_time",time()+3+random(3));
me->add("force", -300);
return 1;
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("riyue-bian")+" 150 级\n"; 
temp+= "\t\t"+to_chinese("whip")+" 150 级\n"; 
temp+= "\t\t"+to_chinese("yiqi-hunyuan")+" 150 级\n"; 
temp+= "\t\t对手必须有兵器\n"; 
temp+= "\t\t内力 500 点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP  

        使用功效： 
                伤害对手的气血，击落对手兵器，牵制对手
        出招类型： 
                延时型外功
                无隐藏攻击 
                叛师不可带出 
        出手要求：               
HELP);                           
write(temp); 
return 1; 
}
