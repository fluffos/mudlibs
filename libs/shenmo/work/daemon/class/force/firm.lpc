
                           
//铁布衫  windy 2011.08
#include <ansi.h>
inherit F_CLEAN_UP;
void remove_effect(object me);

int exert(object me, object target)
{
        int level;
        if( me->query("class")!="human" && me->query("class")!="saint" )
                return notify_fail("你的体质不适合施展铁布衫。\n");
        if( (int)me->query("level") < 300 )     
                return notify_fail("你的等级太低，不够资格施展铁布衫。\n");
        if( (int)me->query("shen") < 1 )     
                return notify_fail("你现在元神虚弱，难以施展铁布衫。\n");
        if( (int)me->query("force") < 500 )     
                return notify_fail("你的内力不够。\n");
        if( (int)me->query("sen") < 200 || (int)me->query("eff_sen") < 200)
                return notify_fail("你现在无法集中精力。\n");
        if( (int)me->query_temp("ironshirt") ) 
                return notify_fail("你已经在运功中了。\n");
        if( (int)me->query_skill("force", 1) < 350 )     
                return notify_fail("你的内功心法修为太浅，难以施展铁布衫。\n");
        level = me->query("level")/10;
        if (level<30)    level=30;
        me->add("force", -300);
        message_vision(HIW"$N"HIW"默运铁布衫功，护体真气布满每一寸肌肤，顿时变得刀枪不入！\n"NOR, me);
        me->set_temp("ironshirt", 1);
        if (!random(1000))    me->add("shen", -1);
        me->start_call_out( (: call_other, __FILE__, "remove_effect", me :), level);
        if( me->is_fighting() && me->query("spskkk")!=9 ) me->start_busy(5);
        return 1;
}

void remove_effect(object me)
{
if (!me)
        return;
if (me->query_temp("ironshirt"))
        {
        me->delete_temp("ironshirt");
        message_vision(HIW"$N"HIW"功行一大周天，长出了一口气，身体又恢复了正常。\n"NOR, me);
        }
        return;
}

