//modify by windy 06-05-09
#include <ansi.h>
inherit SSERVER;
string name() {
  return "「" HIB "切合之术" NOR "」";
}
int valid_perform(object me) {
  if (time() - (int)me->query_temp("qiehe_end") < 4 + random(2))
    return notify_fail("绝招用多就不灵了！\n");
  if (me->query("family/family_name") != "剑客联盟"
    && me->query_skill("huoxin-sword", 1) < 350)
    return notify_fail("你还不够资格！\n");
  if (me->query("class") != "human" && !me->samsara_check("huoxin-sword"))
    return notify_fail("你还不够资格！\n");
  if (me->query_skill("huoxin-sword", 1) < 60)
    return notify_fail("你的神古活心流修为太浅，还施展不出" + name() + "！\n");
  if (me->query_skill("sword", 1) < 60)
    return notify_fail("你的基本剑术修为太浅，还施展不出" + name() + "！\n");
  if (me->query_skill("dodge", 1) < 60)
    return notify_fail("你的基本轻功修为太浅，还施展不出" + name() + "！\n");
  if (me->query_skill("kongshoudao", 1) < 60)
    return notify_fail("你的空手道修为太浅，还施展不出" + name() + "！\n");
  if (me->query_skill("unarmed", 1) < 60)
    return notify_fail("你的扑击格斗之技修为太浅，还施展不出" + name() + "！\n");
  if (me->query_skill("parry", 1) < 60)
    return notify_fail("你的拆招卸力之法修为太浅，还施展不出" + name() + "！\n");
  if ((int)me->query("max_force") < 500)
    return notify_fail("你的内力修为太差。\n");
  if ((int)me->query("force") < 100)
    return notify_fail("你的内力不足！\n");
  return 1;
}

int perform(object me, object target) {
  int damage, dd, pp;
  string msg;
  object weapon;
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用！\n");

  weapon = me->query_temp("weapon");
  damage = me->query_skill("huoxin-sword", 1);
  damage += me->query_skill("sword", 1);
  damage += me->query("force_factor");
  damage -= me->query("bellicosity");
  damage += me->query_temp("apply/damage");
  damage -= target->query_temp("apply/armor");
  damage += me->query("level");
  damage -= target->query("level");
  damage = damage / 2 + random(damage / 2);
  if (damage < 700) damage = 200 + random(500);
  if (damage > 5000) damage = 3000 + random(2000);
  dd = me->query_skill("sword", 1) + me->query_skill("dodge", 1);
  pp = target->query_skill("parry", 1);
  message_vision(
    HIB "$N" HIB "双手握住" + weapon->name() + HIB "围着$n" HIB "快速的游走，一时间$n" HIB "的面前净是晃动的人影！\n\n" NOR,
    me,
    target
  );

  if (random(dd / 2) > pp / 3) {
    message_vision(YEL "$N" YEL "握剑上撩，剑刃带着一抹触目的艳丽寒光从$n" YEL "胸前掠过。\n" NOR, me, target);
    target->receive_damage("kee", damage, me);
    COMBAT_D->report_status(target);
    me->add("force", -50);
    if (me->query_skill("huoxin-sword", 1) >= 400
      && me->query_skill("sword", 1) >= 400
      && me->query_skill("dodge", 1) >= 400
      && me->query_skill("kongshoudao", 1) >= 400) {
      message_vision(YEL "$N" YEL "招式去势已竭，不待变招，一个旋身，对着$n" YEL "“刷刷刷”就是三剑！\n" NOR, me, target);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    }
  } else {
    message_vision(YEL "$n" YEL "心中早有提防，连忙跃身闪开。\n" NOR, me, target);
    me->add("force", -50);
  }
  me->set_temp("qiehe_end", time());
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("huoxin-sword") + " 60 级\n";
  temp += "\t\t" + to_chinese("sword") + " 60 级\n";
  temp += "\t\t" + to_chinese("dodge") + " 60 级\n";
  temp += "\t\t" + to_chinese("kongshoudao") + " 60 级\n";
  temp += "\t\t" + to_chinese("unarmed") + " 60 级\n";
  temp += "\t\t" + to_chinese("parry") + " 60 级\n";
  temp += "\t\t内力修为五年\n";
  temp += "\t\t内力１００点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP 

        使用功效：  
                连续打击对手的气血 
        出招类型：  
                延时型外功 
                有隐藏攻击
                叛师可带出
        出手要求： 
HELP);
  write(temp);
  return 1;
}
