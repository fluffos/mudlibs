
// modify by windy 06/05/09
#include <ansi.h>
inherit SSERVER; 

string name()  
{
return "「"HIM"神气活现"NOR"」";  
}

int valid_perform(object me)
{
if ( me->query("family/family_name")!="剑客联盟" && me->query_skill("huoxin-sword",1)<350 )
        return notify_fail("就凭你现在的武功修为，也想用"+name()+"?\n");
if ( me->query("class")!="human" && !me->samsara_check("huoxin-sword"))
        return notify_fail("你还不够资格！\n"); 
if (me->query_skill("huoxin-sword",1) < 60)
        return notify_fail("你的神古活心流修为不够，还用不出"+name()+"！\n"); 
if((int)me->query("force") < 100 )
        return notify_fail("你的内力不足！\n");
return 1;  
}

int perform(object me, object target)
{
int mypot,tapot;
if ( !valid_perform(me) )
        return 0;
if( !target ) target = offensive_target(me); 
if( !target 
||      !target->is_character() 
||      target->is_corpse() 
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n");   

if( target->is_busy() )
	return notify_fail(target->name()+"已经够忙了，根本没注意到你的剑招。\n");
mypot=(int)me->query_skill("sword");
tapot=(int)target->query_skill("parry",1);
message_vision(HIG"$N扬起手中的长剑，舞起漫天剑花。只看见空中剑影闪动，虚虚实实，令人眼花缭乱。\n"NOR,me);
if ( mypot*3/4 + random(tapot) > tapot )
        {
        message_vision(HIR"$N果然看得目瞪口呆，不知所措，哪里分得清什么虚实！\n"NOR,target);
        target->start_busy(4);
        }
else
        {
        message_vision(HIR"$N凝神而立，不为虚招所动，$n反而被打了个措手不及。\n"NOR,target,me);
        me->start_busy(3);
        }
me->add("force", -50);
return 1;  
}

int help(object me)  
{
string temp;
temp = "\t\t"+to_chinese("huoxin-sword")+" 60 级\n";  
temp+= "\t\t内力 100 点\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n");  
write(@HELP  

        使用功效：   
                牵制对手
        出招类型：
                busy 型外功
                无隐藏攻击 
                叛师可带出 
        出手要求： 
HELP); 
write(temp);
return 1;  
}
