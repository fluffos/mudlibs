/*************************************************
**	此处强烈要求做类似的PFM的wiz注意!	**
**	为了尊重做其他任务wiz的苦心，不想	**
**	让必杀在任务中可用			**
**	请不要为了一时之爽而不顾其他wiz的	**
**	辛勤劳动！！！切记切记！！！		**
**************************************************
**	在需必杀无效NPC上set("任务",1)		**
**			Snowtu 2004		**
*************************************************/		

#include <ansi.h>
inherit PERFORM;

int check_time()
{
object me = this_player();
int time = me->query_skill("huoxin-sword",1);
time+= me->query("bellicosity");
time/= 50;
time = 15-time;
if ( time<3 )
	time = 3;
if ( time>10 )
	time = 10;	
if ( wizardp(me) )
	tell_object(me,"time = "+time+"\n");
return time;
}		

void create()
{
set("name",HIB"冥界召返"NOR);	
set("class","human");
set("target",1);
set("family","剑客联盟");
set("betray_lvl",400);
set("persent",1000);
set("belong","huoxin-sword");
set("base_type","sword");
set("belong","huoxin-sword");
set("temp","dead_busy");
set("temp_time",(:check_time:));
set("limit_skill",([
	"huoxin-sword"	:	250,
	"sword"		:	250,
]));
set("busy_self",5+random(2));	
set("force",1000);
set("need_force",500);
}

void hit_msg(object me,object target,int num)
{
if ( me && target && present(target,environment(me)) && num )
	{
	message_vision(RED"\n$N"RED"突然插剑归鞘，好象忘记了$n"RED"的存在一般，一阵令人窒息
的杀气从$P的身上缓缓散发出来。\n"NOR,me,target);
	me->set_temp("dead_pfm_to",target);
	}
}

void success_hit_msg(object me,object target,int num)
{
}

void remove_eff(object me,string temp)
{
string msg;	
object target;
int ap,dp,pot,damage;
if ( !me || !me->query_temp(temp) )
	return;
target = me->query_temp("dead_pfm_to");
if ( target && me->is_fighting(target) )
	{
	msg = RED "\n$N"RED"使出了神谷活心流的最终奥义[冥界召返]，普天之下无人可破的
必中必杀的招式！！！" ;
	ap = me->query("combat_exp");
	dp = target->query("combat_exp");
	if ( ap>dp/3 && !target->query("任务") )
		{
		msg +=  RED"\n\n似乎带着九天十地所有恶魔的祝福一般，剑以藐视一切的姿态刺入了
$n"RED"的咽喉，鲜血箭一般的喷射而出，连惨叫都来不及，$n"RED"
便倒在了血泊之中。\n"NOR;
		pot = 1;
		}
	else	msg =   RED"\n\n似乎带着九天十地所有恶魔的祝福一般，剑以藐视一切的姿态径直刺
向$n"RED"的咽喉，$n"RED"避无可避，无奈之下，堪堪躲开要害，硬接了此一剑！
鲜血箭一般的喷射而出，$n"RED"一声闷哼，脸色立刻变色煞白。\n"NOR;
	message_vision(msg, me, target);
	if ( pot==1 )
		{
		if ( interactive(target) )
			target->unconcious();
		else	target->die();
		}
	else	{		
		if ( target->query("任务") )
			{
			msg = RED"\n\n但见$n"RED"反手一抹，流血的伤口立即奇异的消失不见！
$n"RED"嘿嘿一笑：此招对我无效，你还是死了心吧！！\n"NOR;
			message_vision(msg,me,target);			
			}		
		else	{
			damage = me->query_skill("huoxin-sword");
			damage+= me->query_temp("apply/damage");
			damage-= target->query_temp("apply/armor");
			damage+= me->query("force_factor");
			damage+= me->query("bellicosity")*2;
			damage = damage/2+random(damage/2);
			if ( damage>0 )
				{
	                        target->receive_damage("kee",damage);
	                        target->receive_wound("kee",damage);
	                        target->receive_damage("sen",damage);
	                        target->receive_wound("sen",damage);
	                        switch(random(4))
	                        	{
	                        	case 0 : COMBAT_D->report_sen_status(target);break;
	                        	case 1 : COMBAT_D->report_status(target);break;
	                        	case 2 : COMBAT_D->report_sen_status(target,damage);break;
	                        	default : COMBAT_D->report_status(target,damage);break;
					}	                        		                        	
				}	
			}	
		}
	}		
else	{
	msg = RED"\n$N"RED"见无敌手，将剑缓缓的又抽离了剑鞘。。。\n\n"NOR;
	message_vision(msg, me, target);
	}
me->delete_temp(temp);
me->delete_temp("dead_pfm_to");
}	

int perform(object me,object target)
{
if( !me->query("swordman/dead_perform") )
	return notify_fail("你还没学会「冥界召返」！\n");
return ::perform(me,target);
}	
