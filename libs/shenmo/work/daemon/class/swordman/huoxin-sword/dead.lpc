
//modify by windy 06-05-09
#include <ansi.h>
inherit SSERVER;

string name() 
{
return "「"RED"冥界召返"NOR"」";   
}

int valid_perform(object me) 
{
if ( me->query("family/family_name")!="剑客联盟" 
&& me->query_skill("huoxin-sword",1)<400 )
        return notify_fail("你还不够资格！\n"); 
if ( me->query("class")!="human" && !me->samsara_check("huoxin-sword"))
        return notify_fail("你还不够资格！\n"); 
if( !me->query("swordman/dead_perform") && !me->samsara_check("huoxin-sword") )
        return notify_fail("你还没学会"+name()+"！\n");
if(me->query_skill("huoxin-sword", 1) < 250 ) 
        return notify_fail("你的神古活心流修为太浅，还施展不出"+name()+"！\n"); 
if(me->query_skill("sword", 1) < 250 ) 
        return notify_fail("你的基本剑术修为太浅，还施展不出"+name()+"！\n"); 
if (me->query_temp("dead_busy"))
        return notify_fail("你没办法连续使出"+name()+"。\n");
if((int)me->query("max_force") < 2000 ) 
        return notify_fail("你的内力修为太差。\n"); 
if((int)me->query("force") < 1000 ) 
        return notify_fail("你的内力不足！\n"); 
return 1; 
}

int perform(object me, object target)
{
string msg;
if ( !valid_perform(me) ) 
        return 0;   
if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me) 
                return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n"); 

message_vision(RED"\n$N突然插剑归鞘，好象忘记了$n"RED"的存在一般，一阵令人窒息的杀气从$N的身上缓缓散发出来，\n"NOR,me,target);
me->start_call_out( (: call_other, __FILE__, "kill_him", me, target :), 4+random(2));
me->start_busy(5);
me->set_temp("dead_busy",1);
call_out("remove_effect",6+random(3),me);
return 1;
}

void kill_him(object me, object target)
{
string msg;
if(me->is_fighting() && environment(me) == environment(target))
    {
    msg = RED "\n$N使出了神古活心流的最终奥义「冥界召返」，普天之下无人可破的必中必杀的招式！！！\n" ;
    msg +=  "\n似乎带着九天十地所有恶魔的祝福一般，剑以藐视一切的姿态刺向$n"RED"的咽喉！\n";
    if(!target->query("莲花") && !target->query("任务") && (int)target->query_skill("busi-force", 1)<500 && (int)me->query("combat_exp")>(int)target->query("combat_exp")/3 && (int)me->query("level")>(int)target->query("level")/3)
        {
        msg +=  "连惨叫都来不及，$n"RED"便倒在了血泊之中。\n" NOR;
        message_vision(msg, me, target);
        target->die();
        }
    else
        {
        if ((int)target->query_skill("busi-force", 1)>=500)
        msg +=  WHT"哪料$n"WHT"却鬼使神差地荡开了这一剑！竟是江湖中失传已久的"RED"不死印法！\n" NOR;
        else
        msg +=  WHT"$n"WHT"大惊之下，情急生智，施展平生所学，堪堪躲开了此一剑！\n" NOR;
        msg +=  WHT"即便如此，$n"WHT"亦被吓出一身冷汗，脸色立刻变得煞白。\n" NOR;
        message_vision(msg, me, target);
        }
    return;
    }
}

void remove_effect(object me)
{
if (!me) return;
me->delete_temp("dead_busy");
}

int help(object me)  
{
string temp;
temp = "\t\t"+to_chinese("sword")+" 250 级\n";  
temp+= "\t\t"+to_chinese("huoxin-sword")+" 250 级\n";  
temp+= "\t\t内力修为二十年\n";
temp+= "\t\t内力１０００点\n";
temp+= "\t\t必须解密\n";
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效：   
                给对手必杀一击，若对方武学高出自己太多，可能落空
        出招类型：
                蓄势型外功
                无隐藏攻击 
                叛师可带出 
        出手要求： 
HELP); 
write(temp);
return 1;  
}
