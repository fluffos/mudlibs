
//modify by windy 06-05-09
#include <ansi.h>
inherit SSERVER;

string name() 
{
return "「"RED"密剑·焰灵"NOR"」";   
}

int valid_perform(object me) 
{
if ( me->query("family/family_name")!="剑客联盟" 
&& me->query_skill("doom-sword",1)<350 )
        return notify_fail("你还不够资格！\n"); 
if ( me->query("class")!="human" && !me->samsara_check("doom-sword"))
        return notify_fail("你还不够资格！\n"); 
if(me->query_skill("doom-sword", 1) < 200 ) 
        return notify_fail("你的杀人剑法修为太浅，还施展不出"+name()+"！\n"); 
if(me->query_skill("sword", 1) < 200 ) 
        return notify_fail("你的基本剑术修为太浅，还施展不出"+name()+"！\n"); 
if(me->query_skill("dodge", 1) < 200 ) 
        return notify_fail("你的基本轻功修为太浅，还施展不出"+name()+"！\n"); 
if(me->query_skill("spells", 1) < 200 ) 
        return notify_fail("你的法术修为太浅，还施展不出"+name()+"！\n"); 
if((int)me->query("max_force") < 1500 ) 
        return notify_fail("你的内力修为太差。\n"); 
if((int)me->query("force") < 800 ) 
        return notify_fail("你的内力不足！\n"); 
if(me->query("swordman/yanling_perform")!=1 && !me->samsara_check("doom-sword"))
        return notify_fail("你还没有学会"+name()+"。\n"); 
return 1; 
}

int perform(object me, object target)
{
int myexp, yourexp, myskill, yourskill, mylvl, yourlvl;
int ap, dp, damage, def;
string msg;
if ( !valid_perform(me) ) 
        return 0;   
if( !target ) target = offensive_target(me);
if( !target
||      !target->is_character()
||      target->is_corpse()
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n"); 

myexp= me->query("combat_exp") /200000;
yourexp=target->query("combat_exp")/200000;
myskill=me->query_skill("sword");
myskill+=me->query_skill("dodge");
yourskill=target->query_skill("parry");
yourskill+=target->query_skill("spells");
mylvl= me->query("level");
yourlvl= target->query("level");
damage = me->query("eff_kee");
damage-= target->query("eff_kee")/2;
if ( damage<200 ) 
        damage=200; 
if ( damage>500 ) 
        damage=500; 
if ( me->query("family/master_name")=="志志雄真实" )   
        damage+= me->query("force_factor"); 
if ( me->query("MKS")>15000 || me->query("PKS")>3 )  
        damage+= me->query("bellicosity"); 
if ( damage>(int) target->query("max_kee")/2 ) 
        damage = (int) target->query("max_kee")/2; 

msg = RED
"\n$N长剑挥划，带着撕裂空气的速度与力量，向$n"RED"的胸口急刺而去。
因摩擦产生的高温更是将剑周围的空气燃烧起来。\n" NOR;
msg += RED""+BLINK"
┏━━━━━━━┓
┃  密剑·焰灵  ┃
┗━━━━━━━┛" NOR;
if (random(myexp+yourexp)>yourexp && random(myskill+yourskill)>yourskill || random(mylvl+yourlvl)>yourlvl)
    {
    msg += RED
    "\n\n$n"RED"一个躲闪不及，胸口被长剑刺个正着，剑上的炽热气息迅速在
$n"RED"身上散发开来，让$n"RED"如同置身炼狱!!\n" NOR;
    target->receive_wound("kee",damage,me);
    me->add("force",-500);
    me->start_busy(1+random(2));
    }
else
    {
    msg += HIY "\n\n$n"HIY"左躲右闪，终于避开了$P的这一击！！\n" NOR;
    me->start_busy(2+random(1));
    me->add("force",-300);
    }
message_vision(msg, me, target);
return 1;
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("doom-sword")+" 200 级\n"; 
temp+= "\t\t"+to_chinese("sword")+" 200 级\n"; 
temp+= "\t\t"+to_chinese("dodge")+" 200 级\n"; 
temp+= "\t\t"+to_chinese("spells")+" 200 级\n"; 
temp+= "\t\t内力修为十五年\n"; 
temp+= "\t\t内力８００点\n"; 
temp+= "\t\t必须解密\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效：  
                给对手强有力的一击
        出招类型：  
                busy 型外功 
                无隐藏攻击
                叛师可带出
        出手要求： 
HELP); 
write(temp); 
return 1; 
}
