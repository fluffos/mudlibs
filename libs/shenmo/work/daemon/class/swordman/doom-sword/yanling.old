#include <ansi.h>
inherit PERFORM;

int check_damage(object me,object target)
{
int damage = me->query("eff_kee");	
damage-= target->query("eff_kee")/2;
if ( damage<200 )
	damage=200;
if ( damage>500 )
	damage=500;	
if ( me->query("family/master_name")=="志志雄真实" )	
	damage+= me->query("force_factor");
if ( me->query("MKS")>15000 || me->query("PKS")>3 )	
	damage+= me->query("bellicosity");
return damage;
}

void create()
{
set("name","密剑·焰灵");
set("target",1);
set("family","剑客联盟");
set("class","human");
set("force",800);
set("need_force",400);
set("betray_lvl",350); 
set("persent",100); 
set("type","doom-sword"); 
set("base_type","sword"); 
set("belong","doom-sword"); 
set("limit_skill",([
	"doom-sword"	:	200,
	"sword"		:	200,
	"dodge"		:	200,
]));	
set("busy_self",1+random(2));
set("damage_type","eff_kee");
}

void hit_msg(object me,object target,int num)
{
string msg;
int damage;	
::hit_msg(me,target,num);
msg = RED"$N"RED"长剑挥划，带着撕裂空气的速度与力量，向$n"RED"的胸口急刺而去。
因摩擦产生的高温更是将剑周围的空气燃烧起来。\n"NOR;
msg += RED+BLINK+@LONG
		┏━━━━━━━┓
		┃   密剑·焰灵	┃
		┗━━━━━━━┛
LONG+NOR;
msg = replace_string(msg,"密剑",NOR BLINK MAG"密剑"NOR RED BLINK);
msg = replace_string(msg,"·",NOR HIY"·"NOR RED BLINK);
msg = replace_string(msg,"焰灵",NOR BLINK HIR"焰灵"NOR RED BLINK);
message_vision(msg,me,target);
damage = check_damage(me,target);
set("damage",damage);
}		

void success_hit_msg(object me,object target,int num)
{
string msg;
::success_hit_msg(me,target,num);
msg = RED"\n\n$n"RED"一个躲闪不及，被长剑刺个正着，剑上的炽热气息迅速从
$n"RED"伤口传散开来，迅速笼罩全身，让$n"RED"如同置身炼狱！\n" NOR;
message_vision(msg,me,target);
target->apply_condition("fire",6);
}

void lost_hit_msg(object me,object target,int num)
{
string msg;	
::lost_hit_msg(me,target,num);
msg = RED"\n\n$n"RED"左躲右闪，终于避开了$P的这一击！\n"NOR;
message_vision(msg,me,target);
}

void normal_hit_msg(object me)
{
string msg;
::normal_hit_msg(me);
msg = HIR"\n只见$N"HIR"$w"HIR"上的火焰迅速黯淡了下去....\n\n"NOR;
msg = replace_string(msg,"$w",me->query_temp("weapon")->name());
message_vision(msg,me);
}

int help(object me) 
{
string temp; 
temp = "\t\t"+to_chinese("doom-sword")+" 200 级\n"; 
temp+= "\t\t"+to_chinese("sword")+" 200 级\n"; 
temp+= "\t\t"+to_chinese("dodge")+" 200 级\n"; 
temp+= "\t\t内力 800 点\n"; 
write(@HELP 
杀人剑法　之　「密剑·焰灵」：

        使用功效： 
                连续打击对手的气血
        出招类型： 
                busy型外功
                无隐藏攻击 
                叛师可带出
        出手要求： 
HELP); 
write(temp);
return 1;  
}
