//modify by windy 06-05-09
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() {
  return "「" HIR "无想斩" NOR "」";
}

int valid_perform(object me) {
  if (me->query("family/family_name") != "剑客联盟"
    && me->query_skill("doom-sword", 1) < 500)
    return notify_fail("你还不够资格！\n");
  if (me->query("class") != "human" && !me->samsara_check("doom-sword"))
    return notify_fail("你还不够资格！\n");
  if (me->query_skill("doom-sword", 1) < 150)
    return notify_fail("你的杀人剑法修为太浅，还施展不出" + name() + "！\n");
  if (me->query_skill("sword", 1) < 150)
    return notify_fail("你的基本剑术修为太浅，还施展不出" + name() + "！\n");
  if (me->query("swordman/wuxiang_perform") != 1 && !me->samsara_check("doom-sword"))
    return notify_fail("你还没学会" + name() + "！\n");
  if ((int)me->query("max_force") < 1000)
    return notify_fail("你的内力修为太差。\n");
  if ((int)me->query("force") < 500)
    return notify_fail("你的内力不足！\n");
  return 1;
}

int perform(object me, object target) {
  string msg;
  int extra;
  object weapon;
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用！\n");

  extra = me->query_skill("doom-sword", 1) / 2;
  weapon = me->query_temp("weapon");

  message_vision(
    RED "\n\n$N腾空越起，变换身形，手中的" + weapon->name() + RED "划出森然剑气，一招「无想斩」一气呵成 ！\n\n" NOR,
    me,
    target
  );
  me->add_temp("apply/attack", extra);
  me->add_temp("apply/damage", extra);
  message_vision(HIC "「厉鬼缠身」，$N手中" + weapon->name() + HIC "带着一阵寒意直刺$n！\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  message_vision(HIR "「群魔夜宴」，$N手中" + weapon->name() + HIR "带着冷冷的剑气斜刺$n！\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  message_vision(HIY "「百鬼夜行」，$N手中" + weapon->name() + HIY "落叶般横刺$n！\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  if (me->query_skill("doom-sword", 1) > 199) {
    message_vision(HIW "「十万神魔」，$N手中" + weapon->name() + HIW "闪电般猛刺$n！\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  }
  if (me->query_skill("doom-sword", 1) > 249) {
    message_vision(HIR "「群魔乱舞」，$N手中" + weapon->name() + HIR "带着冷冷的剑气斜刺$n！\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  }
  if (me->query_skill("doom-sword", 1) > 299) {
    message_vision(HIY "「十万幻想」，$N手中" + weapon->name() + HIY "落叶般横刺$n！\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  }
  if (me->query_skill("doom-sword", 1) > 349) {
    message_vision(HIW "「万天神魔」，$N手中" + weapon->name() + HIW "闪电般猛刺$n！\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  }
  if (me->query_skill("doom-sword", 1) > 399) {
    message_vision(BLU "「万灵俱灭」，$N手中" + weapon->name() + BLU "带着无边的杀气扫向$n！\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  }
  me->add_temp("apply/attack", -extra);
  me->add_temp("apply/damage", -extra);
  me->start_busy(3);
  me->add("force", -100);
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("doom-sword") + " 150 级\n";
  temp += "\t\t" + to_chinese("sword") + " 150 级\n";
  temp += "\t\t内力修为十年\n";
  temp += "\t\t内力５００点\n";
  temp += "\t\t必须解密\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP 

        使用功效：  
                连续打击对手的气血 
        出招类型：  
                busy 型外功 
                无隐藏攻击
                叛师可带出
        出手要求： 
HELP);
  write(temp);
  return 1;
}
