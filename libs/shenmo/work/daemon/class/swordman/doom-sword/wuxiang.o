int help(object me)  
{
string temp;
temp = "\t\t"+to_chinese("doom-sword")+" 150 级\n"; 
temp+= "\t\t"+to_chinese("sword")+" 150 级\n"; 
temp+= "\t\t"+to_chinese("dodge")+" 150 级\n"; 
temp+= "\t\t"+to_chinese("spells")+" 150 级\n"; 
temp+= "\t\t内力 1000 点\n"; 
temp+= "\t\t福缘 22 点\n"; 
write(@HELP  
杀人剑法　之　「无想斩」： 

        使用功效：  
                连续打击对手的气血 
        出招类型：  
                busy型外功 
                志志雄真实的弟子会有更多的 HIT 数
                叛师可带出
        出手要求： 
HELP); 
write(temp); 
return 1; 
}
