#include <ansi.h>
inherit PERFORM;

int check_num(object me)
{
int num,pot = me->query_skill("doom-sword",1);
if ( pot>350 )
	{
	if ( me->query("family/master_name")=="志志雄真实" )	
		num = 7;
	else 	num = 5;
	}	
else if ( pot>250 )
	{
	if ( me->query("family/master_name")=="志志雄真实" )	
		num = 5;
	else 	num = 3;
	}	
else 	{
	if ( me->query("family/master_name")=="志志雄真实" )	
		num = 3;
	else 	num = 1+random(2);
	}	
return num;
}

string *hit_msgs =({
	HIC"「厉鬼缠身」，$N"HIC"手中$w"HIC"带着一阵寒意直刺$n！"NOR,
	HIR"\n「群魔夜宴」，$N"HIR"手中$w"HIR"带着冷冷的剑气斜刺$n！"NOR,
	HIY"\n「百鬼夜行」，$N"HIY"手中$w"HIY"落叶般横刺$n！"NOR,
	HIW"\n「十万神魔」，$N"HIW"手中$w"HIW"闪电般猛刺$n！"NOR,
	RED"\n「群魔乱舞」，$N"RED"手中$w"RED"带着冷冷的剑气斜刺$n！"NOR,
	YEL"\n「十万幻想」，$N"YEL"手中$w"YEL"落叶般横刺$n！"NOR,
	WHT"\n「万天神魔」，$N"WHT"手中$w"WHT"闪电般猛刺$n！"NOR,
});
	
void create()
{
set("name","无想斩");
set("target",1);
set("family","剑客联盟");
set("class","human");
set("force",1000);
set("need_force",300);
set("betray_lvl",500); 
set("persent",150); 
set("type","doom-sword"); 
set("base_type","sword"); 
set("belong","doom-sword"); 
set("limit_skill",([
	"doom-sword"	:	150,
	"sword"		:	150,
	"dodge"		:	150,
	"spells"	:	150,
]));	
set("busy_self",2+random(3));
set("limit_other",([
	"kar"	:	22,
]));
set("double_hit",([
	"num"	:	7,
]));	
}

void hit_msg(object me,object target,int num)
{
message_vision(RED"\n\n$N"RED"腾空越起，变换身行，手中的"+ me->query_temp("weapon")->name()+RED+"划出森然剑气，一招「无想斩」一气呵成 ！！\n\n" NOR,me,target);	
num = check_num(me);
set("double_hit/num",num);
}

void double_hit_msg(object me,object target,int i)
{
string msg = hit_msgs[i];
msg = replace_string(msg,"$w",me->query_temp("weapon")->name());
message_vision(msg,me,target);
}

