#include <ansi.h>
inherit PERFORM;

int check_damage(object me,object target)
{
int damage;
damage = me->query_skill("feitian-sword");
damage+= me->query("force_factor");
damage+= me->query_temp("apply/damage");
damage-= target->query_temp("apply/armor");
if ( damage<0 )
	damage = me->query_temp("apply/damage");
damage = damage/2+random(damage*2);
return damage;
}

void create()
{
set("name","天翔龙闪");
set("target",1);
set("family","剑客联盟");
set("class","human");
set("betray_lvl",800);
set("persent",50);
set("belong","feitian-sword");
set("base_type","sword");
set("belong","feitian-sword");
set("force",2000);
set("need_force",1000);
set("limit_skill",([
	"feitian-sword"		: 300,
	"sword"			: 300,
	"fengyu-piaoxiang"	: 300,
	"guixi-force"		: 300,
]));
set("enable",([
	"force"	: "guixi-force",
	"dodge" : "fengyu-piaoxiang",
]));	
set("busy_self",random(5));   
set("damage_type","all");
}

void hit_msg(object me,object target,int num)
{
string msg;
int damage;
if ( me && target && me->is_fighting(target) && num )
	{
	msg = HIC"\n$N"HIC"抚剑对$n"HIC"淡淡说道：能死在这招“天翔龙闪”之下，你也可无憾。"NOR;
	msg+= HIC"\n\n言毕，$N手中的$w"HIC"不着边际地缓缓向$n"HIC"刺去，如同曼妙的舞者手中
舞动的长剑一般，不带半丝杀气。\n"NOR;
	msg = replace_string(msg,"$w",me->query_temp("weapon")->name());
	message_vision(msg,me,target);
	
	damage = check_damage(me,target);
	set("damage",damage);
	set("old_persent",query("persent"));
	
	if ( me->query("family/master_name")=="緋村劍心" && !query_temp("add_per/master") )
		{
		add("persent",10);
		set_temp("add_per/master",1);
		}
	if ( me->query("bellicosity")<100 && !query_temp("add_per/bell") )
		{
		add("persent",20);
		set_temp("add_per/bell",1);
		}
	if ( me->query("MKS")>50000 && !query_temp("add_per/MKS") )
		{
		add("persent",30);
		set_temp("add_per/bell",1);
		}
		
	if ( !me->query("swordman/jiulong_perform") && !query_temp("add_per/jiulong") )
		{
		add("persent",50);
		set_temp("add_per/jiulong",1);
		}
	}
}

void success_hit_msg(object me,object target,int num)
{
string msg;
object weapon;	
if ( me && target && me->is_fighting(target) && num )
	{
	msg = RED"\n$n"RED"左躲右闪，但$N"RED"手中的$w"RED"却如同跗骨之锥一般，始终不离$n"RED"的眉心半寸。\n"NOR;
	msg+= BLU"\n$n"BLU"只觉得眼前蓝光一闪，业已疑是$p"BLU"在这个世界看到的最后色彩了！\n"NOR;
	weapon = me->query_temp("weapon");
	msg = replace_string(msg,"$w",weapon->name());
	message_vision(msg,me,target);
	}					
}

void lost_hit_msg(object me,object target,int num)
{
string msg;
object weapon;	
if ( me && target && me->is_fighting(target) && num )
	{
	msg = RED "\n$n"RED"向后远远跃开，终于避开了$P的这一击！！\n" NOR;
	message_vision(msg,me,target);
	}					
}

void normal_hit_msg(object me)
{
string msg;
object weapon;	
if ( me && me->is_fighting() )
	{
	msg = BLU"\n$N"BLU"将手中$w"BLU"一抖，化作点点寒光，护住周身要害，脚尖一
点，跃出圈外，变招换势，蓄势待发。\n"NOR;
	weapon = me->query_temp("weapon");
	msg = replace_string(msg,"$w",weapon->name());
	message_vision(msg,me);
	}										
}
int help(object me)  
{
string temp;
temp = "\t\t"+to_chinese("feitian-sword")+" 300 级\n"; 
temp+= "\t\t"+to_chinese("sword")+" 300 级\n"; 
temp+= "\t\t"+to_chinese("guixi-force")+" 300 级\n"; 
temp+= "\t\t"+to_chinese("fengyu-piaoxiang")+" 300 级\n"; 
temp+= "\t\t内力 2000 点\n"; 
temp+= "\t\t必须解密\n"; 
temp+= "\t\t必须激发归吸吐纳之术\n"; 
temp+= "\t\t必须激发风雨飘香步\n"; 
write(@HELP  
飞天御剑流　之　「天翔龙闪」：  

        使用功效：    
                打击对手的精神和气血
        出招类型： 
                busy 型外功 
                无隐藏攻击  
                叛师可带出  
        出手要求：  
HELP);  
write(temp); 
return 1;   
}
