#include <ansi.h>
inherit PERFORM;

int check_damage(object me,object target)
{
int damage;
damage = me->query_skill("feitian-sword");
damage+= me->query_skill("fengyu-piaoxiang");
damage+= me->query("force_factor");
damage+= me->query("bellicosity");
damage+= me->query_temp("apply/damage");
damage-= target->query_temp("apply/armor");
damage-= target->query_temp("apply/parry");
damage-= target->query_temp("apply/dodge");
damage = damage/3+random(damage/2);
if ( wizardp(me) )
	tell_object(me,"damage = "+damage+"\n");
return damage;
}

void create()
{
set("name","龙翔闪");
set("target",1);
set("family","剑客联盟");
set("class","human");
set("betray_lvl",300);
set("persent",100);
set("belong","feitian-sword");
set("base_type","sword");
set("belong","feitian-sword");
set("force",600);
set("need_force",100);
set("limit_skill",([
	"feitian-sword"	: 80,
	"sword"		: 80,
	"dodge"		: 80,
	"force"		: 80,
]));
set("busy_self",1+random(3));	
set("damage_type","kee");
}

void hit_msg(object me,object target,int num)
{
string msg;
int damage;
if ( me && target && me->is_fighting(target) && num )
	{
	msg = YEL"\n$N"YEL"突然身形跃起，如神龙翱翔在天，手中的"
+ me->query_temp("weapon")->name()+YEL"挟雷霆万钧之势，闪电般的刺向$n"YEL"！\n" NOR;		
	message_vision(msg,me,target);
	
	damage = check_damage(me,target);
	set("damage",damage);
	set("old_persent",query("persent"));  //千万千万，不然有persent递加的bug snowtu/2004
	
	if ( me->query("family/master_name")=="緋村劍心" && !query_temp("add_per/master") )
		{
		add("persent",50);
		set_temp("add_per/master",1);
		}
	if ( me->query("bellicosity")<400 && !query_temp("add_per/bell") )
		{
		add("persent",50);
		set_temp("add_per/bell",1);
		}
	if ( me->query("MKS")>10000 && !query_temp("add_per/MKS") )
		{
		add("persent",50);
		set_temp("add_per/bell",1);
		}
	if ( me->query("lvl")<100 && !query_temp("add_per/lvl") )
		{
		add("persent",50);			
		set_temp("add_per/lvl",1);
		}
		
	if ( !me->query("swordman/jiulong_perform") )
		{
		if ( random(me->query_int())>20 )
			{	
			me->add("swordman/longxiang_perform_num",1);
			msg = WHT"你觉得自己对飞天御剑流的理解加深了。"NOR;	
			if ( me->query("swordman/longxiang_perform_num")>=500 )
				{
				msg+= WHT"在剑影雷鸣中你
似乎抓住了"NOR HIB"九头龙闪"NOR WHT"的奥义所在！\n"NOR;
				msg+= HIB"你领悟了飞天御剑流奥义『九头龙闪』\n"NOR;
				me->delete("swordman/longxiang_perform_num");
				me->set("swordman/jiulong_perform",1);
				}			 	
			else	msg+= WHT"在剑影雷鸣中你
似乎领悟了什么，可惜一时间又无甚头绪，你若有所失，若有所得。\n"NOR;
			tell_object(me,msg);
			}
		}	
	}
}

void success_hit_msg(object me,object target,int num)
{
string msg,limb,*limbs;
object weapon;	
if ( me && target && me->is_fighting(target) && num )
	{
	msg = YEL"但见一道闪电斜斜劈过天空，一时间众人皆睁眼若盲。待到视力恢
复之际，只见场中缠斗二人已经分开。\n"NOR;
	msg+= YEL"只见$N"YEL"手中握着$w"YEL"屹立不动，对面的$n"YEL"气喘吁吁，
$l处的衣襟沁出点点殷红，狼狈的看着$N"YEL"。\n"NOR;
	limbs = target->query("limbs");
	limb = limbs[random(sizeof(limbs))];
	weapon = me->query_temp("weapon");
	msg = replace_string(msg,"$l",limb);
	msg = replace_string(msg,"$w",weapon->name());
	message_vision(msg,me,target);
	}					
}

void lost_hit_msg(object me,object target,int num)
{
string msg;
object weapon;	
if ( me && target && me->is_fighting(target) && num )
	{
	msg = YEL"但见一道闪电斜斜劈过天空，一时间众人皆睁眼若盲。待到视力恢
复之际，只见场中缠斗二人已经分开。\n"NOR;
	msg+= YEL"只见$N"YEL"手中握着$w"YEL"气喘吁吁，样子有些狼狈，对面的$n
"YEL"怡然站立。看来$N"YEL"并未沾到便宜。\n"NOR;
	weapon = me->query_temp("weapon");
	msg = replace_string(msg,"$w",weapon->name());
	message_vision(msg,me,target);
	}					
}

void normal_hit_msg(object me)
{
string msg;
object weapon;	
if ( me && me->is_fighting() )
	{
	msg = YEL"$N"YEL"将手中$w"YEL"一抖，化作点点寒光，护住周身要害，脚尖一
点，跃出圈外，变招换势，蓄势待发。\n"NOR;
	weapon = me->query_temp("weapon");
	msg = replace_string(msg,"$w",weapon->name());
	message_vision(msg,me);
	}										
}
int help(object me)  
{
string temp;
temp = "\t\t"+to_chinese("feitian-sword")+" 80 级\n"; 
temp+= "\t\t"+to_chinese("sword")+" 80 级\n"; 
temp+= "\t\t"+to_chinese("dodge")+" 80 级\n"; 
temp+= "\t\t"+to_chinese("force")+" 80 级\n"; 
temp+= "\t\t内力 300 点\n"; 
write(@HELP  
飞天御剑流　之　「龙翔闪」：  

        使用功效：    
                打击对手的气血
        出招类型： 
                busy 型外功 
                无隐藏攻击  
                叛师可带出  
        出手要求：  
HELP);  
write(temp); 
return 1;   
}
