#include <ansi.h>
inherit PERFORM;

string *zhaoshi = ({
	YEL"土  龙  闪"NOR,
	HIG"水  龙  闪"NOR,
	WHT"木  龙  闪"NOR,
	HIY"金  龙  闪"NOR,
	HIB"雷  龙  闪"NOR,
	HIR"火  龙  闪"NOR,
	RED"狂  龙  闪"NOR,
	HIC"天  龙  闪"NOR,
	BLU"九	头  龙  闪"NOR,
});		

int check_num(object me)
{
int num,pot;
pot = me->query_skill("feitian-sword",1);
if ( pot>350 )
	num = 9;
else if ( pot>250 )
	num = 7;
else if ( pot>180 )
	num = 5;
else 	num = 3;
return num;
}			
		
void create()
{
set("name","九头龙闪");
set("target",1);
set("family","剑客联盟");
set("class","human");
set("betray_lvl",500);
set("persent",150);
set("belong","feitian-sword");
set("base_type","sword");
set("belong","feitian-sword");
set("force",1000);
set("need_force",500);
set("limit_skill",([
	"feitian-sword"	: 120,
	"sword"		: 120,
	"dodge"		: 120,
	"force"		: 120,
]));
set("double_hit",([		
//	"num" : (: check_num :),
        "me_del_env": 1,
	"t_del_env" : 1,
]));
set("busy_self",1+random(2));
set("temp","perform_jiulong");
set("temp_time",5+random(5));
}

int perform(object me, object target)
{
if(me->query("swordman/jiulong_perform")!=1)
	return notify_fail("你还没学会「九头龙闪」！\n");
return ::perform(me,target);
}

void hit_msg(object me,object target,int num)
{
int extra;
string msg;	
if ( me && target && me->is_fighting(target) && num )
	{
	extra = me->query_skill("feitian-sword");
	if ( extra>200 )
		extra = 200;
	extra = 250-extra;
	
	if ( extra>=me->query_temp("apply/attack") )
		extra = me->query_temp("apply/attack")/2;				
	me->add_temp("apply/attack",-extra);
	me->set_temp("jiulong_add_temp",extra);
	
	msg = WHT"\n\n$N"WHT"挥出飞天御剑流中的绝天灭地的一式－－－九－头－龙－闪－！！\n\n" NOR;
	message_vision(msg,me,target);
	extra = check_num(me);
	set("double_hit/num",extra);
	me->receive_damage("sen",100);
	}
}

void double_hit_msg(object me,object target,int num)
{
string msg;	
msg = "\n"+zhaoshi[num];
message_vision(msg,me,target);
}

void remove_eff(object me,string temp)
{
int pot;	
if ( me && me->query_temp(temp) )
	{
	pot = me->query_temp("jiulong_add_temp");
	me->add_temp("apply/attack",pot);
        me->delete_temp("jiulong_add_temp");
        me->delete_temp(temp);
	}	
}
int help(object me)  
{
string temp;
temp = "\t\t"+to_chinese("feitian-sword")+" 120 级\n"; 
temp+= "\t\t"+to_chinese("sword")+" 120 级\n"; 
temp+= "\t\t"+to_chinese("dodge")+" 120 级\n"; 
temp+= "\t\t"+to_chinese("force")+" 120 级\n"; 
temp+= "\t\t内力 1000 点\n"; 
temp+= "\t\t必须解密\n"; 
write(@HELP  
飞天御剑流　之　「九头龙闪」：  

        使用功效：    
                连续打击敌人的气血
        出招类型： 
                busy 并带有延时型外功 
                无隐藏攻击  
                叛师可带出  
        出手要求：  
HELP);  
write(temp); 
return 1;   
}
