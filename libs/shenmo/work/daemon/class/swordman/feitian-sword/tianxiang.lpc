
//modify by windy 06-05-09
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() 
{
return "「"HIC"天翔龙闪"NOR"」";   
}

int valid_perform(object me) 
{
if(me->query("family/family_name")!="剑客联盟" && me->query_skill("feitian-sword",1) < 500 )
        return notify_fail(name()+"不是谁都可以用的！\n");
if ( me->query("class")!="human" && !me->samsara_check("feitian-sword"))
        return notify_fail("你还不够资格！\n"); 
if ( me->query_skill("feitian-sword",1) < 300)
        return notify_fail("你的飞天御剑流修为太浅，还施展不出"+name()+"！\n"); 
if ( me->query_skill("sword",1) < 300)
        return notify_fail("你的基本剑术修为太浅，还施展不出"+name()+"！\n"); 
if ( me->query_skill("dodge",1) < 300)
        return notify_fail("你的基本轻功修为太浅，还施展不出"+name()+"！\n"); 
if ( me->query_skill("fengyu-piaoxiang",1) < 300 && !me->samsara_check("feitian-sword"))
        return notify_fail("你的风雨飘香步修为太浅，还施展不出"+name()+"！\n"); 
if ( me->query_skill("guixi-force",1) < 300)
        return notify_fail("你的归吸吐纳之术修为太浅，还施展不出"+name()+"！\n"); 
if( (int)me->query("max_force") < 2000 )  
        return notify_fail("你的内力修为太差。\n"); 
if( (int)me->query("force") < 1000 )   
        return notify_fail("你的内力不足！\n"); 
if(me->query("swordman/tianxiang_perform")!=1 && !me->samsara_check("feitian-sword"))
        return notify_fail("你还没学会"+name()+"！\n");
return 1; 
}

int perform(object me, object target)
{
int myexp, yourexp, myskill, yourskill,fskill,mylvl,talvl;
object weapon;
int ap, dp,damage;
string msg;
if ( !valid_perform(me) ) 
        return 0;   
if( !target ) target = offensive_target(me);
if( !target
||      !target->is_character()
||      target->is_corpse()
||      target==me) 
        return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n"); 

weapon=me->query_temp("weapon");
myexp= (int)me->query("combat_exp") /200000;
yourexp=(int)target->query("combat_exp")/200000;
myskill=(int)me->query_skill("sword");
yourskill=(int)target->query_skill("parry");
mylvl=(int)me->query("level");
talvl=(int)target->query("level");
ap=myexp*myskill/10*mylvl/10;
dp=yourexp*yourskill/10*talvl/10;

message_vision(HIC  "\n$N"HIC"抚剑对$n"HIC"淡淡说道：能死在这招“天翔龙闪”之下，你已可无憾。"NOR,me,target);
message_vision(WHT"\n言毕，$N"WHT"手中的"+weapon->name()+WHT"不着边际地缓缓向$n"WHT"刺去，如同曼妙的舞者手中舞动的长剑一般，不带半丝杀气。\n" NOR,me,target);
if (random(myexp)>yourexp/6 && random(myskill)>yourskill/6 && random(mylvl)>talvl/6)
    {
    if (me->query("swordman/dead_perform")!=1 && me->query("bellicosity")<100 && !target->query("莲花") && !target->query("任务") && (int)target->query_skill("busi-force", 1)<500)
        {
        message_vision(HIB"$n"HIB"只觉得眼前蓝光一闪，那已是$n"HIB"在这个世界看到的最后色彩。\n"NOR,me,target);
        target->unconcious();
        me->start_busy(5+random(5));
        me->add("force",-500);
        }
    else
        {
    message_vision(RED"\n$n"RED"左躲右闪，但$N"RED"手中的"+weapon->name()+RED"却如同跗骨之锥一般，始终不离$n"RED"的眉心半寸。\n"NOR,me,target);
    target->receive_damage("sen",target->query("max_sen")/5,me);
    target->receive_wound("sen", random((int)target->query("max_sen")/10), me);
    target->receive_damage("kee",target->query("max_kee")/5,me);
    target->receive_wound("kee", random((int)target->query("max_kee")/10), me);
    COMBAT_D->report_status(target);
    COMBAT_D->report_sen_status(target);
    me->start_busy(2);
    me->add("force",-500);
        }
    }
else
    {
    message_vision(RED "\n$n"RED"向后远远跃开，终于避开了$P"RED"的这一击！！\n" NOR,me,target);
    me->start_busy(3+random(3));
    me->add("force",-500);
    }
return 1;
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("feitian-sword")+" 300 级\n"; 
temp+= "\t\t"+to_chinese("sword")+" 300 级\n"; 
temp+= "\t\t"+to_chinese("dodge")+" 300 级\n"; 
temp+= "\t\t"+to_chinese("fengyu-piaoxiang")+" 300 级\n"; 
temp+= "\t\t"+to_chinese("guixi-force")+" 300 级\n"; 
temp+= "\t\t内力修为二十年\n"; 
temp+= "\t\t内力１０００点\n"; 
temp+= "\t\t必须解密\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效：  
                强力伤害敌人的气血和精神
        出招类型：  
                busy 型外功 
                若没有学会冥界召返可令敌人昏厥
                叛师可带出
        出手要求： 
HELP); 
write(temp); 
return 1; 
}
