//modify by windy 06-05-09
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() {
  return "「" WHT "九头龙闪" NOR "」";
}

int valid_perform(object me) {
  if (me->query("family/family_name") != "剑客联盟" && !me->samsara_check("feitian-sword", 1))
    return notify_fail(name() + "只有剑客联盟弟子才可以使用！\n");
  if (me->query_skill("feitian-sword", 1) < 180)
    return notify_fail("你的「飞天御剑流」还不够纯熟！\n");
  if (me->query_skill("guixi-force", 1) < 180)
    return notify_fail("你的「归吸吐纳法」还不够纯熟！\n");
  if (me->query("swordman/jiulong_perform") != 1 && !me->samsara_check("feitian-sword", 1))
    return notify_fail("你还没学会" + name() + "！\n");
  if (me->query_skill("sword", 1) < 180)
    return notify_fail("你的基本剑术还不够纯熟！\n");
  if (me->query_skill("dodge", 1) < 180)
    return notify_fail("你的基本轻功修为太浅，还施展不出" + name() + "！\n");
  if (time() - (int)me->query_temp("jiulong_end") < 4 + random(2))
    return notify_fail("你现在气血翻涌，难以再施展绝技！\n");
  if ((int)me->query("max_force") < 1500)
    return notify_fail("你的内力修为太差。\n");
  if ((int)me->query("force") < 1000)
    return notify_fail("你的内力不足！\n");
  return 1;
}

int perform(object me, object target) {
  string msg;
  int extra;
  object weapon;
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail(name() + "只能在战斗中使用！\n");

  extra = me->query_skill("feitian-sword", 1);
  extra += me->query("level");
  extra /= 6;
  weapon = me->query_temp("weapon");

  message_vision(WHT "\n$N挥出飞天御剑流中的绝天灭地的一式－－－九－头－龙－闪－！！\n" NOR, me, target);
  me->add_temp("apply/attack", extra);
  me->add_temp("apply/damage", extra);
  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    message_vision(YEL "土龙闪！\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    message_vision(WHT "水龙闪！\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  if (!me->query("env/no_msg") && !target->query("env/no_msg"))
    message_vision(HIG "木龙闪！\n" NOR, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  if ((int)me->query_skill("feitian-sword", 1) > 250) {
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(HIY "金龙闪！\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(HIB "雷龙闪！\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(HIR "火龙闪！\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  }
  if ((int)me->query_skill("feitian-sword", 1) > 400) {
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(HIM "狂龙闪！\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(HIC "天龙闪！\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    if (!me->query("env/no_msg") && !target->query("env/no_msg"))
      message_vision(HIW "九头龙闪！\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  }
  me->add("force", -100);
  me->add_temp("apply/attack", -extra);
  me->add_temp("apply/damage", -extra);
  me->set_temp("jiulong_end", time());
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("feitian-sword") + " 180 级\n";
  temp += "\t\t" + to_chinese("guixi-force") + " 180 级\n";
  temp += "\t\t" + to_chinese("sword") + " 180 级\n";
  temp += "\t\t" + to_chinese("dodge") + " 180 级\n";
  temp += "\t\t内力修为十五年\n";
  temp += "\t\t内力１０００点\n";
  temp += "\t\t必须解密\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP 

        使用功效：  
                连续打击对手的气血 
        出招类型：  
                延时型外功 
                无隐藏攻击
                叛师不可带出
        出手要求： 
HELP);
  write(temp);
  return 1;
}
