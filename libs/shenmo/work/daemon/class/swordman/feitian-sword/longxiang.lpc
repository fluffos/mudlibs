//modify by windy 06-05-09
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

string name() {
  return "「" HIY "龙翔闪" NOR "」";
}

int valid_perform(object me) {
  if (me->query("family/family_name") != "剑客联盟" && me->query_skill("feitian-sword", 1) < 350)
    return notify_fail(name() + "可不是你能用出来的！\n");
  if (me->query("class") != "human" && !me->samsara_check("feitian-sword"))
    return notify_fail("你还不够资格！\n");
  if ((int)me->query_skill("feitian-sword", 1) < 120)
    return notify_fail("你的「飞天御剑流」还不够纯熟！\n");
  if ((int)me->query("force") < 600)
    return notify_fail("你的内力不足！\n");
  return 1;
}

int perform(object me, object target) {
  string msg;
  int extra;
  object weapon;
  if (!valid_perform(me))
    return 0;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展" + name() + "？\n");
  if (!me->is_fighting())
    return notify_fail("你要对谁施展" + name() + "？\n");

  weapon = me->query_temp("weapon");
  extra = me->query_skill("sword");
  message_vision(
    HIG "\n$N突然身形跃起，如神龙翱翔在天，手中的" + weapon->name() + HIG "挟雷霆万钧之势，闪电般的刺向$n！\n" NOR,
    me,
    target
  );
  me->add_temp("apply/attack", extra);
  me->add_temp("apply/damage", extra);
  me->add("force", -100);
  if (!me->query("swordman/jiulong_perform", 1) && random(me->query_int()) > 20) {
    me->add("swordman/longxiang_perform", 1);
    tell_object(me, HIY "你觉得自己对飞天御剑流的理解加深了。\n" NOR);
  }
  if (me->query(
    "swordman/longxiang_perform",
    1
  ) > 300 && me->query("family/family_name") == "剑客联盟") {
    me->set("swordman/jiulong_perform", 1);
    tell_object(me, HIY "你在不知不觉间领悟到了「九头龙闪」的要领。\n" NOR);
    me->delete("swordman/longxiang_perform");
  }
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);
  me->add_temp("apply/attack", -extra);
  me->add_temp("apply/damage", -extra);
  me->start_busy(1);
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("feitian-sword") + " 120 级\n";
  temp += "\t\t内力６００点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP 

        使用功效：  
                给对手强有力的一击
        出招类型：  
                busy 型外功 
                是领悟“九头龙闪”的唯一途径
                叛师可带出
        出手要求： 
HELP);
  write(temp);
  return 1;
}
