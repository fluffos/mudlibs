// fenshen.c 分身术

inherit SSERVER;

int cast(object me, object target) {
  int fenshen_time, fenshen_num;
  object soldier;

  if (!me->is_fighting())
    return notify_fail("只有战斗中才能使用分身法！\n");

  if (me->query("family/family_name") != "剑客联盟")
    return notify_fail("你不能用「分身术」！\n");

  //if ( !me->query("swordman/renshu_ask_fenshen") )       
  //        return notify_fail("你还没有参悟「分身术」的秘密！\n");

  fenshen_time = 60 + (200 - (int)me->query_skill("spells"));
  fenshen_time = me->query_skill("spells");
  fenshen_time += me->query_skill("renshu");
  fenshen_time = fenshen_time / 2 + random(fenshen_time / 2);

  if (fenshen_time < 60)
    fenshen_time = 60;

  if (fenshen_time > 300)
    fenshen_time = 300;

  fenshen_num = fenshen_time / 60;

  if (me->query_temp("renshu/fenshen_num") >= fenshen_num)
    return notify_fail("以你目前的修为，还是省省吧....\n");

  if ((int)me->query("mana") < 4 * (int)me->query_skill("spells"))
    return notify_fail("你的法力不够了！\n");

  if ((int)me->query("sen") < 50)
    return notify_fail("你的精神无法集中！\n");

  message_vision("$N喃喃地念了几句咒语。\n", me);

  if (random(me->query("max_mana")) < 200) {
    me->add("mana", -(int)me->query_skill("spells"));
    me->receive_damage("sen", 10);
    message("vision", "但是什么也没有发生。\n", environment(me));
    return 1;
  }

  me->add("mana", -4 * (int)me->query_skill("spells"));
  me->receive_damage("sen", 40);
  me->add_temp("renshu/fenshen_num", 1);
  seteuid(getuid());
  soldier = new("/d/swordman/npc/renzhe");
  soldier->move(environment(me));
  soldier->invocation(me);
  soldier->command("protect " + me->query("id"));
  soldier->set_temp("invoker", me);
  soldier->set("time", fenshen_time);
  soldier->set("yinshen_per", 10);
  //me->start_busy(2+random(2));
  return 3 + random(5);
}
