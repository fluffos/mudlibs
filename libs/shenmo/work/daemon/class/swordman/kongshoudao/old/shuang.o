#include <ansi.h>
inherit PERFORM;

void create()
{
set("name","双重极限");
set("class","human");
set("family","剑客联盟");
set("betray_lvl",350);	
set("target",1);
set("belong","kongshoudao");
set("base_type","unarmed");
set("limit_skill",([
	"kongshoudao"	:	150,
	"unarmed"	:	150,
	"dodge"		: 	150,
]));	
set("force",800);
set("double_hit",([
	"num"		:	1,
	"me_del_env"	:	1,
]));
set("temp","kongshoudao_shuang");
set("temp_time",1);
}

void hit_msg(object me,object target,int num)
{
if ( me && target && present(target,environment(me)) && num )
	{
	message_vision(HIY"\n$N"HIY"突然大喝一声，右拳挟风雷之势向$n"HIY"的胸口击来。\n"NOR, me,target);
	}	
}		
		
void double_hit_msg(object me,object target,int num)
{
return;
}

void remove_eff(object me,string temp)
{
int extra;
object target;
if ( !me || !me->query_temp(temp) )
	return;
extra = me->query_skill("kongshoudao",1);
if ( extra>500 )
	extra = 500;	
target = offensive_target(me);
if( target && me->query_skill("kongshoudao",1)>=200 
 && random(me->query("str"))>random(target->query("str")) 
 && me->is_fighting(target) )
	{
	message_vision(HIR "\n就在$n以为$N拳力不继之时，$N的右拳忽然再往前急速击出。
这一招，正是精妙无双的[双重极限]。\n"NOR,me,target);
	me->add_temp("apply/attack", extra);
	me->add_temp("apply/damage", extra);	
	COMBAT_D->do_attack(me, target);
	me->add_temp("apply/attack", -extra);
	me->add_temp("apply/damage", -extra);
	me->start_busy(1+random(2));
	}
me->delete_temp(temp);
}
		
int help(object me)  
{
string temp;
temp = "\t\t"+to_chinese("kongshoudao")+" 150 级\n"; 
temp+= "\t\t"+to_chinese("unarmed")+" 150 级\n"; 
temp+= "\t\t"+to_chinese("dodge")+" 150 级\n"; 
temp+= "\t\t内力 800 点\n"; 
write(@HELP  
空手道　之　「双重极限」：  

        使用功效：    
                连续打击对手气血
        出招类型： 
                延时型外功 
                无隐藏攻击    
                叛师可带出  
        出手要求：  
HELP);  
write(temp); 
return 1;   
}
