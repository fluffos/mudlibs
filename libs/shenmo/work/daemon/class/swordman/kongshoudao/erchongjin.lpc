//modify by windy 06-05-09
#include <ansi.h>
#include "/daemon/skill/eff_msg.h";
inherit PERFORM;

int perform2(object me, object target);
int perform3(object me, object target);
int def;
string name() {
  return "「" HIY "二重勁" NOR "」";
}

int valid_perform(object me) {
  if (!me)
    return 0;
  if (me->query("family/family_name") != "剑客联盟" && me->query_skill("kongshoudao", 1) < 350)
    return notify_fail(name() + "对你来说还有些难度！\n");
  if (me->query("class") != "human" && !me->samsara_check("kongshoudao"))
    return notify_fail("你还不够资格！\n");
  if (me->query_skill("kongshoudao", 1) < 100)
    return notify_fail("你的空手道修为太浅，还施展不出" + name() + "！\n");
  if (me->query_skill("unarmed", 1) < 100)
    return notify_fail("你的扑击格斗之技修为太浅，还施展不出" + name() + "！\n");
  if (me->query_skill("force", 1) < 150)
    return notify_fail("你的内功心法修为太浅，还施展不出" + name() + "！\n");
  if ((int)me->query("max_force") < 1200)
    return notify_fail("你的内力修为不够！\n");
  if ((int)me->query("force") < 500)
    return notify_fail("你的内力不足！\n");
  return 1;
}

int perform(object me, object target) {
  string msg, str;
  int damage, p, time;
  if (!valid_perform(me))
    return 0;
  if (!target)
    target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target == me)
    return notify_fail("只能在战斗中使用。\n");
  if (!me->is_fighting())
    return notify_fail(name() + "必须在战斗中使用。\n");

  msg = HIG "\n突然$N大喝一声:「一重勁」,飞身上前,举拳前进,浑身上下充满可怖的杀气~!\n" NOR;
  message_vision(msg, me, target);
  msg = HIB "\n“嗡”的一声，一拳捣向$n的胸口！\n" NOR;
  if (random(me->query("combat_exp")) > target->query("combat_exp") / 5) {
    if (!target->is_busy()) target->start_busy(2);
    damage = (int)me->query_skill("kongshoudao", 1);
    if (me->query("family/family_name") == "剑客联盟" || me->query("任务"))
      damage += me->query("level");
    damage = damage + random(damage / 2);
    def = (int)target->query_temp("apply/armor_vs_force");
    damage -= damage * def / 400000000;
    target->receive_damage("kee", damage, me);
    target->receive_wound("kee", damage / 2, me);
    me->add("force", -(damage / 4));
    p = (int)target->query("kee") * 100 / (int)target->query("max_kee");
    msg += damage_msg(damage, "内伤");
    msg += "( $n" + eff_status_msg(p) + " )\n";
  } else {
    me->start_busy(1);
    me->add("force", -200);
    msg += HIY "可是$p伏地一滚，躲开了对手的攻击。\n" NOR;
  }
  message_vision(msg, me, target);
  if (me->query_skill("kongshoudao", 1) > 149)
    return perform2(me, target);
  return 1;
}

int perform2(object me, object target) {
  int damage, p, skill;
  string msg, weapon, str;
  weapon = me->query_temp("weapon");
  if (!living(target))
    return notify_fail("对手已经不能再战斗了。\n");
  if ((int)me->query("force", 1) < 300)
    return notify_fail("你待要再出第二击，却发现自己的内力不继了！\n");
  msg = HIW "\n只见$N突然大喝一声「二重勁」，\n" NOR;
  message_vision(msg, me, target);
  msg = HIR "\n$N的右拳挟风雷之势向$n的胸口击来。\n" NOR;
  if (random(me->query("combat_exp")) > target->query("combat_exp") / 5) {
    if (!target->is_busy()) target->start_busy(2);
    damage = (int)me->query_skill("kongshoudao", 1);
    damage += (int)me->query_skill("unarmed", 1);
    damage += (int)me->query_skill("guixi-force", 1);
    if (me->query("family/family_name") == "剑客联盟" || me->query("任务"))
      damage += me->query("level") * 2;
    damage = (damage + random(damage)) / 2;
    def = (int)target->query_temp("apply/armor_vs_force");
    damage -= damage * def / 800000000;
    target->receive_damage("kee", damage, me);
    target->receive_wound("kee", damage / 2, me);
    me->add("force", -random(damage / 10));
    p = (int)target->query("kee") * 100 / (int)target->query("max_kee");
    msg += damage_msg(damage, "内伤");
    msg += "( $n" + eff_status_msg(p) + " )\n";
  } else {
    me->start_busy(1);
    me->add("force", -200);
    msg += HIY "可是$p伏地一滚，躲开了对手的攻击。\n" NOR;
  }
  message_vision(msg, me, target);
  if (me->query_skill("kongshoudao", 1) > 249)
    return perform3(me, target);
  return 1;
}

int perform3(object me, object target) {
  int damage, p, skill;
  string msg, weapon, str;
  weapon = me->query_temp("weapon");
  if (!living(target))
    return notify_fail("对手已经不能再战斗了。\n");
  if ((int)me->query("force", 1) < 400)
    return notify_fail("你待要再出第三击，却发现自己的内力不继了！\n");
  msg = HIG "\n只见$N起身上前,来到$n的面前。\n" NOR;
  message_vision(msg, me, target);
  msg = HIC "\n变拳为掌用出相乐佐之助的奥义决学双重极限「三重勁」！\n" NOR;
  if (random(me->query("combat_exp")) > target->query("combat_exp") / 5) {
    me->start_busy(1);
    if (!target->is_busy()) target->start_busy(2);
    damage = (int)me->query_skill("kongshoudao", 1);
    damage += (int)me->query_skill("unarmed", 1);
    damage += (int)me->query_skill("guixi-force", 1);
    if (me->query("family/family_name") == "剑客联盟" || me->query("任务"))
      damage += me->query("level") * 3;
    damage = (damage + random(damage)) / 2;
    def = (int)target->query_temp("apply/armor_vs_force");
    damage -= damage * def / 1200000000;
    target->receive_damage("kee", damage, me);
    target->receive_wound("kee", damage / 2, me);
    me->add("force", -random(damage / 10));
    p = (int)target->query("kee") * 100 / (int)target->query("max_kee");
    msg += damage_msg(damage, "内伤");
    msg += "( $n" + eff_status_msg(p) + " )\n";
  } else {
    me->start_busy(1);
    me->add("force", -200);
    msg += HIY "可是$p伏地一滚，躲开了对手的攻击。\n" NOR;
  }
  message_vision(msg, me, target);
  return 1;
}

int help(object me) {
  string temp;
  temp = "\t\t" + to_chinese("kongshoudao") + " 100 级\n";
  temp += "\t\t" + to_chinese("unarmed") + " 100 级\n";
  temp += "\t\t" + to_chinese("force") + " 100 级\n";
  temp += "\t\t内力修为十二年\n";
  temp += "\t\t内力５００点\n";
  write("\n" + to_chinese(explode(__FILE__, "/")[<2]) + "之" + name() + "：" NOR "\n");
  write(@HELP

        使用功效：
                连续打击对手气血
        出招类型： 
                busy 型外功 
                无隐藏攻击    
                叛师可带出  
        出手要求：  
HELP);
  write(temp);
  return 1;
}
