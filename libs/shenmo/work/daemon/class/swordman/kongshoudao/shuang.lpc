
//modify by windy 06-05-09
#include <ansi.h>
inherit SSERVER;
string name() 
{
return "「"HIR"双重极限"NOR"」";   
}

int valid_perform(object me) 
{
if(me->query("family/family_name")!="剑客联盟" && !me->samsara_check("kongshoudao", 1))
        return notify_fail(name()+"只有剑客联盟弟子才可以使用！\n");
if(me->query_skill("kongshoudao", 1) < 150 ) 
        return notify_fail("你的空手道修为太浅，还施展不出"+name()+"！\n"); 
if(me->query_skill("unarmed", 1) < 150 ) 
        return notify_fail("你的扑击格斗之技修为太浅，还施展不出"+name()+"！\n"); 
if(me->query_skill("dodge", 1) < 150 ) 
        return notify_fail("你的基本轻功修为太浅，还施展不出"+name()+"！\n"); 
if(me->query_skill("parry", 1) < 150 ) 
        return notify_fail("你的拆招卸力之法修为太浅，还施展不出"+name()+"！\n"); 
if((int)me->query("force") < 800 ) 
    return notify_fail("你的内力不足！\n"); 
if( time()-(int)me->query_temp("shuang_end") < 3+random(2) ) 
        return notify_fail("绝招用多就不灵了！\n"); 
return 1;
}

int perform(object me, object target)
{
int extra; 
if ( !valid_perform(me) ) 
        return 0;   
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
||      target==me) 
                return notify_fail("你要对谁施展"+name()+"？\n"); 
if(!me->is_fighting()) 
        return notify_fail(name()+"只能在战斗中使用！\n"); 

extra = me->query_skill("kongshoudao",1);
extra+=me->query("level");

message_vision(HIY "\n$N突然大喝一声，右拳挟风雷之势向$n的胸口击来。\n"NOR, me,target);
me->add_temp("apply/attack", extra);
COMBAT_D->do_attack(me, target);
me->add_temp("apply/attack", -extra);
if((int)me->query_skill("kongshoudao",1)>=200 && me->query("level")>random(target->query("level")/2))
        {
        message_vision(HIR "\n就在$n以为$N拳力不继之时，$N的右拳忽然再往前急速击出。这一招，正是精妙无双的「双重极限」！\n"NOR,me,target);
        me->add_temp("apply/attack", extra);
        me->add_temp("apply/damage", extra);
        COMBAT_D->do_attack(me, target);
        me->add_temp("apply/attack", -extra);
        me->add_temp("apply/damage", -extra);
        }
me->set_temp("shuang_end",time());
return 1;
}

int help(object me) 
{
string temp;    
temp = "\t\t"+to_chinese("kongshoudao")+" 150 级\n"; 
temp+= "\t\t"+to_chinese("unarmed")+" 150 级\n"; 
temp+= "\t\t"+to_chinese("dodge")+" 150 级\n"; 
temp+= "\t\t"+to_chinese("parry")+" 150 级\n"; 
temp+= "\t\t内力８００点\n"; 
write("\n"+to_chinese(explode(__FILE__,"/")[<2])+"之"+name()+"："NOR"\n"); 
write(@HELP 

        使用功效：  
                连续打击对手的气血 
        出招类型：  
                延时型外功 
                无隐藏攻击
                叛师不可带出
        出手要求： 
HELP); 
write(temp); 
return 1; 
}
