dbase (["id":"mailbox","owner_id":"supermi","no_give":1,"no_insert":1,"long":"这是一个用来寄信、收信的信箱，你可以用以下指令来处理你的邮件：mail <某人>               寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read <信件编号>           阅读一封信件。readmail <信件编号>       阅读一封信件。discard <信件编号>        丢弃一封信件。dismail <信件编号>        丢弃一封信件。如果跟留言板冲突，请用readmail来阅读信件。","unit":"个","name":"喝酒的的信箱","no_drop":1,])
mails ({(["title":"杨中顺：帐目结算","time":1110825046,"to":"supermi","text":"你的店主(杨中顺)任期结束，结余二千四百四十三两黄金六十两银子已存入你的户头。其中盈利二千四百四十三两黄金六十两银子，剩余预付金零文钱。","from":"杨中顺(yang zhongshun)","status":"O",]),})
