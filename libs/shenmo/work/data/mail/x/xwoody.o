#/obj/mailbox.c
dbase (["no_drop":1,"id":"mailbox","no_give":1,"no_insert":1,"long":"这是一个用来寄信、收信的信箱，你可以用以下指令来处理你的邮件：mail <某人>               寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read <信件编号>           阅读一封信件。readmail <信件编号>       阅读一封信件。discard <信件编号>        丢弃一封信件。dismail <信件编号>        丢弃一封信件。如果跟留言板冲突，请用readmail来阅读信件。","unit":"个","name":"小武帝的信箱","owner_id":"xwoody",])
mails ({(["from":"茶花娘子(chahua niangzi)","title":"茶花娘子：帐目结算","to":"xwoody","status":"O","text":"你的店主(茶花娘子)任期结束，结余零文钱已存入你的户头。其中盈利零文钱，剩余预付金零文钱。","time":1320485084,]),(["from":"郑寡妇(zheng guafu)","title":"郑寡妇：帐目结算","to":"xwoody","status":"O","text":"你的店主(郑寡妇)任期结束，结余五十七两黄金已存入你的户头。其中盈利五十七两黄金，剩余预付金零文钱。","time":1320485448,]),(["from":"姚富贵(yao fugui)","title":"姚富贵：帐目结算","to":"xwoody","status":"O","text":"你的店主(姚富贵)任期结束，结余零文钱已存入你的户头。其中盈利零文钱，剩余预付金零文钱。","time":1320488143,]),(["from":"老孙(lao sun)","title":"老孙：帐目结算","to":"xwoody","status":"O","text":"你的店主(老孙)任期结束，结余零文钱已存入你的户头。其中盈利零文钱，剩余预付金零文钱。","time":1320488441,]),})
