#/obj/mailbox.c
dbase (["no_drop":1,"long":"这是一个用来寄信、收信的信箱，你可以用以下指令来处理你的邮件：mail <某人>               寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read <信件编号>           阅读一封信件。readmail <信件编号>       阅读一封信件。discard <信件编号>        丢弃一封信件。dismail <信件编号>        丢弃一封信件。如果跟留言板冲突，请用readmail来阅读信件。","name":"宝来的信箱","id":"mailbox","no_give":1,"no_insert":1,"owner_id":"bora","unit":"个",])
mails ({(["to":"bora","time":1100771645,"title":"萧萧：帐目结算","text":"你的店主(萧萧)任期结束，结余十两黄金已存入你的户头。其中盈利十两黄金，剩余预付金零文钱。","status":"O","from":"萧萧(xiao xiao)",]),})
