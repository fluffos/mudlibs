#/obj/mailbox.c
dbase (["no_insert":1,"no_give":1,"unit":"个","name":"信箱","id":"mailbox","no_drop":1,"owner_id":"llc","long":"这是一个用来寄信、收信的信箱，你可以用以下指令来处理你的邮件：mail <某人>               寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read <信件编号>           阅读一封信件。readmail <信件编号>       阅读一封信件。discard <信件编号>        丢弃一封信件。dismail <信件编号>        丢弃一封信件。如果跟留言板冲突，请用readmail来阅读信件。",])
mails ({(["from":"胖店主(pang dianzhu)","time":1099518142,"title":"胖店主：帐目结算","to":"llc","status":"N","text":"你的店主(胖店主)任期结束，结余三两黄金已存入你的户头。其中盈利三两黄金，剩余预付金零文钱。",]),(["time":1099590159,"from":"胖店主(pang dianzhu)","title":"胖店主：帐目结算","to":"llc","status":"N","text":"你的店主(胖店主)任期结束，结余五十两银子已存入你的户头。其中盈利五十两银子，剩余预付金零文钱。",]),})
