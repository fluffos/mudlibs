#/obj/mailbox.c
dbase (["long":"这是一个用来寄信、收信的信箱，你可以用以下指令来处理你的邮件：mail <某人>               寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read <信件编号>           阅读一封信件。readmail <信件编号>       阅读一封信件。discard <信件编号>        丢弃一封信件。dismail <信件编号>        丢弃一封信件。如果跟留言板冲突，请用readmail来阅读信件。","name":"西门吹水的信箱","no_give":1,"id":"mailbox","unit":"个","no_drop":1,"owner_id":"eyes","no_insert":1,])
mails ({(["from":"孔方兄(kong fang)","to":"eyes","status":"O","title":"孔方兄：帐目结算","time":1103993773,"text":"你的店主(孔方兄)任期结束，结余一百二十两黄金已存入你的户头。其中盈利一百二十两黄金，剩余预付金零文钱。",]),})
