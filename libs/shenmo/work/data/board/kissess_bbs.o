dbase (["long":"这是巫师追风的工作台。","capacity":200,"no_get":1,"board_id":"kissess_bbs","location":"/u/kissess/workroom","id":"board","notes":({(["msg":"我～～kissess又一次来到了mud的神奇世界想当初，大学2年级就陷入泥潭并且为之奋斗近3年的时光随着站点的倒闭和岁月的流逝偶渐渐远离的她如今看到那熟悉的id和文字真是叹息－－岁月如歌，往事留情愿mud事业生生世世万古长青曾经年轻的咖啡留于新年初42004","author":"咖啡(Kissess)","ip":"kissess.tsrj.station","title":"青春追忆","time":1075029372,"sx":"◆",]),}),"master":"kissess","name":"[1;33m追风工作台[2;37;0m",])
