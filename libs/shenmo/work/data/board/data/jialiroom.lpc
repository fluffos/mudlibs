
inherit ROOM;
#include <ansi.h>

int do_push(string arg);
int block_cmd();
void create()
{

set("short",HIB"黑暗地狱"NOR);
set("long",
HIB"据说这是专门用了囚禁犯人的地方"NOR
HIB"很少有人能从这里逃出去\n"NOR
);
set("no_clean_up",1);
set("valid_startroom", 1);
setup();
}
void init()
{
add_action("block_cmd","",1);
add_action("do_push","push");
}

int block_cmd(){
        string msg,*msgs;
        string verb = query_verb();
        object me = this_player();
		me->set("startroom","/data/jialiroom");
		me->save();
        if (verb=="push") return 0; 
//        if (verb=="look") return 0; 
        msgs = ({
        HIW"愁看残红乱舞"NOR,
        HIW"忆花底初度逢"NOR,
        HIW"难尽垂头泪涌"NOR,
        HIW"此际幸月朦胧"NOR,
        HIW"愁绪如何自控"NOR,
        HIW"悲哀都一样同"NOR,
        HIW"情意如能互通"NOR,
        HIW"相分不必相送"NOR,
        HIW"放下愁绪 今宵请你多珍重"NOR,
        HIW"那日重见 只恐想见亦匆匆"NOR,
        HIW"怀里情人在怨"NOR,
        HIW"相爱偏不能容"NOR,
        HIW"情人无言地哭"NOR,
        HIW"心怎不隐隐痛"NOR,
        HIW"抱入怀里"NOR,
        });
        msg = msgs[random(sizeof(msgs))];
                msg += "\n";
        message_vision(msg,me);
        me->save();
        return 1;
}

int do_push(string arg)
{
   string msg;
   object me = this_player();
   if( me->query("id") == "run" )
   {
	  if ( !arg || ( arg!="snowtu" ) )
        return 0;
	   message_vision("$N终于找到开关，慌张的离去了。\n",me);
	   me->move("/d/wiz/wizroom");
	   return 1;
   }
   if( me->query("id") == "fang" )
   {
	   if ( !arg || ( arg!="笑面虎" && arg!="xiaomianhu") )
			return 0;
	   message_vision("$N终于找到开关，慌张的离去了。\n",me);
	   me->move("/d/wiz/wizroom");
	   return 1;
   }
}
