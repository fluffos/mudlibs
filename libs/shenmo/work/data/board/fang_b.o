  }     } }int ling_wu(){   ..... //相关变量及说明   object me = this_player();   check_player();   if( me->query(\"lingwu_time\") >= me->query(\"work_lingwu\") )    {       tell_object(\"你现在还不能领悟这些招数，等你的铸造功夫高了之后再说吧\",me);       return 1;    }   else    {       .... //领悟的判断            //无论成功与否都add lingwu_time 1       me->add(\"lingwu_time\",1);    }}","time":1109392111,"author":"方舟(Fang)","ip":"fang.tsrj.station","title":"for tom","sx":"◆",]),(["msg":"bibotan,xueshan,wdd,houyun,ok!","time":1176623997,"author":"方舟(Fang)","ip":"fang.tsrj.station","title":"任务进程","sx":"◆",]),(["msg":"putuo ok","time":1176638001,"author":"方舟(Fang)","ip":"fang.tsrj.station","title":"newzhuanshi (2)","sx":"◆",]),(["msg":"rt","time":1177565640,"author":"方舟(Fang)","ip":"fang.tsrj.station","title":"gumu ok","sx":"◆",]),(["msg":"rt","time":1177568929,"author":"方舟(Fang)","ip":"fang.tsrj.station","title":"sanjie ok","sx":"◆",]),(["msg":"rt","time":1183862207,"author":"方舟(Fang)","ip":"fang.tsrj.station","title":"pansidong ok","sx":"◆",]),(["msg":"rt","time":1183906241,"author":"方舟(Fang)","ip":"fang.tsrj.station","title":"yao ok","sx":"◆",]),(["msg":"rt","time":1183909908,"author":"方舟(Fang)","ip":"fang.tsrj.station","title":"puti ok","sx":"◆",]),(["msg":"rt","time":1183969267,"author":"方舟(Fang)","ip":"fang.tsrj.station","title":"dragon ok","sx":"◆",]),(["msg":"rtwusheng","time":1183971120,"author":"方舟(Fang)","ip":"fang.tsrj.station","title":"wuying ok","sx":"◆",]),(["msg":"眠兔到此一游","time":1189956858,"ip":"snowtu.tsrj.station","author":"眠兔(Snowtu)","title":"1","sx":"◆",]),}),"no_get":1,"id":"board",])
