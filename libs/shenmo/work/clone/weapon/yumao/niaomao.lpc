//creat by focus

#include <weapon.h>
#include <ansi.h>
inherit YUMAO;
void create()
{
            set_name("鸟毛", ({"niao mao", "yumao"}));
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("long", "一根不知从哪只扁毛禽兽身上拔下的不知哪儿的毛，乌漆抹黑的.....\n");
                set("value", 5);
 //             set("material", "crimsonsteel");
                set("wield_msg","$N小心翼翼的从耳边掏出一根$n握在手中，很是威风。。。。\n");
                set("unwield_msg","$N小心翼翼的将$n插在耳边。\n");
              }
        
            init_yumao(8);
        setup();
}
