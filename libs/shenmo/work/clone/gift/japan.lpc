#include <ansi.h>

string give_gift();

private mixed *story = ({
"--- 江户城内",
"德川齐昭：如今我部兵强马壮，看来一统天下，指日可待了。",
"下面一阵人声嘈杂。",
"德川齐昭：田口永九郎 你有什么看法？",
"田口永九郎：此出海向西之大唐，国力喻我等千万倍。。。",
"德川齐昭：哦？",
"德川齐昭：听说你昨日在后堂偷吃了一只老母鸡！",
"德川齐昭：来人，将田口永九郎推出斩了！",
"田口永九郎：主公，冤枉啊。。。",
"～～～”喀嚓“～～～",
"... ... ... ...",

"德川齐昭：一事还一事,田口永九郎的建议不错！",
"德川齐昭：看来得找个唐人来问上一问。",
"逸剑宗之助：属下愿往。",
"德川齐昭：恩，偷偷的进行，发现的不要。",
"... ... ... ...",
"",
(: give_gift :),
});

void create()
{
        seteuid(getuid());
}

mixed query_story_message(int step)
{
        return step < sizeof(story) ? story[step] : 0;
}

string give_gift()
{
	string msg,arg;
        int i;
        object ob;
        object env;
        object *players;

        players = users();
        if (sizeof(players)<5 )
        	{
        	story+= ({
        		"逸剑宗之助：守卫森严，没成功。",
        		"",
			"德川齐昭：你偷了那么多鸡，白吃了？！",
			"德川齐昭：来人，拉出去斩了！",
			"德川齐昭：等等，人才稀薄，留着下次吧。。。",
		});
		return "";
		}

	for (i = 0; i < 5; i++)
		{
		ob = players[random(sizeof(players))];
                env = environment(ob);
		while ( env && env->is_character() )
			env = environment(env);
		if (env) break;
		}
	if ( i>=5 || !objectp(env) || env->query("map") )
		{
        	story+= ({
        		"逸剑宗之助：守卫森严，没成功。",
        		"",
			"德川齐昭：你偷了那么多鸡，白吃了？！",
			"德川齐昭：来人，拉出去斩了！",
			"德川齐昭：等等，人才稀薄，留着下次吧。。。",
		});
		return "";
		}
        story+= ({
		HIM"    “轰隆”一声，从屋顶掉下几人，爬将起来，弹了弹屁股上"NOR,
		HIM"的尘土，捂住眼睛道：你们看不到我。。。你们看不到我。。。 -_—! "NOR,
		"    逸剑宗之助掂起脚尖，在"+ob->query("name")+"耳边细声道：",
		"扶桑的水户藩主请你去江户一游。",
		ob->query("name")+"暗思：反正没什么事，不如去游玩一番。当下点头应允。",
		"",
		"一路无话",
		"",
		ob->query("name")+"到了地头，笑道：待我四处游玩游玩。。。
众人不是其对手，只好眼巴巴的看着他离开。",
		"","",
		"德川齐昭：中原有句话：偷米不成反蚀只鸡，果然是对的。。。",
		"","",
		WHT+ob->query("name")+"("+capitalize(ob->query("id"))+")"NOR HIM"将扶桑闹得鸡犬不宁！"NOR,
	});

	arg = HIM"\n\n“轰隆”一声，从屋顶掉下几人，爬将起来，弹了弹屁股
上的尘土，捂住眼睛道：你们看不到我。。。你们看不到我。。。 -_—! \n\n"NOR;
	tell_room(env, arg);
	message("vision","那厮掂起脚尖，在"+ob->name()+"耳边低语了几句。"+
ob->name()+"点了点头。\n",env,ob);
	tell_object(ob,"那厮掂起脚尖，在你耳边细声道：扶桑的水户藩主请你去江户一游。\n");
	tell_object(ob,"你暗思：反正没什么事，不如去游玩一番。当下点头应允。\n");
	message_vision("$N与那厮急急忙忙的离开了。\n",ob);
	ob->move(SDS_ROOM("center"));
	message_vision("$N到了地头，笑道：待我四处游玩游玩。。。
众人不是$P的对手，只好眼巴巴的看着$P离开。\n",ob);
return env->query("short");
}
