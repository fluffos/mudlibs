inherit ITEM;

void create() {
  set_name("棋盘", ({ "qipan" }));
  set_weight(500);
  set_max_encumbrance(8000);
  if (clonep()) {
    object a, b, c, d;
    seteuid(getuid());
    if (a = new("/d/obj/drug/huozao"))
      a->move(this_object());

    seteuid(getuid());
    if (d = new("/d/obj/drug/jiaoli"))
      d->move(this_object());

    seteuid(getuid());
    if (b = new("/d/obj/drug/biou"))
      b->move(this_object());

    seteuid(getuid());
    if (c = new("/d/obj/drug/mihoutao"))
      c->move(this_object());
    set_default_object(__FILE__);
  } else {
    set("unit", "个");
    set("long", "这是蓬莱三星下围棋的棋盘。\n");
    set("value", 0);
    set("no_give", 1);
    set("no_put", 1);
  }
}

int is_container() { return 1; }
