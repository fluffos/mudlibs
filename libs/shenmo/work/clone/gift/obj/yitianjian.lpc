//yitianjian.c
#include <weapon.h>
#include <ansi.h>
inherit F_UNIQUE;
inherit SWORD;

void create() {
  set_name(HIG "倚" HIW "天" HIY "剑" NOR, ({ "yitian", "yitian jian", "jian" }));
  set_weight(20000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 50000);
    set("no_drop", "1");
    set("no_give", "1");
    set("no_break", "1");
    set("replace_file", "/d/obj/weapon/sword/qingfeng");
    set("material", "iron");
    set("long", "这是天下第一利器，有“倚天不出，谁与争锋”之说。\n");
    set("wield_msg", "直如矫龙吞水，长虹冠日一般，$n已在$N手中，天地为之变色。\n");
    set("unwield_msg", "$N将$n插回腰间，华光顿敛，天地间只闻龙鸣。\n");
    set("weapon_prop/intelligence", 8);
  }
  init_sword(350);
  setup();
}
