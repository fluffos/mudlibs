#include <ansi.h>
inherit ITEM;
#include "skill_book.h"

void create()
{
set_name("半月剑术", ({"moonsword book", "book"}));
set_weight(1000);
if( clonep() )
	set_default_object(__FILE__);
else {
	set("unit", "本");
	set("material", "paper");
	set("value", 10000);
	set("long", "学习剑法的基本书籍。\n");
	set("level",7);
	set("skill/type","moonsword");
	set("skill/name","半月剑术");
	}
}

