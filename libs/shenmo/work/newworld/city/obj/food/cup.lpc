#include <ansi.h>
inherit ITEM;
inherit F_LIQUID;
string *name = ({
  HIW "白玉酒盏" NOR,
  HBBLU + RED "夜光杯" NOR,
  HIG "青瓷酒樽" NOR,
  HIY "镀金海碗" NOR,
  HIC "雕木巧盏" NOR,
});
string *jiu = ({
  HIR "女儿红" NOR,
  MAG "葡萄美酒" NOR,
  HIG "竹叶青" NOR,
  HBWHT + HIG "杏花酒" NOR,
  HBWHT + HIR "状元红" NOR,
  HIM "杜康酒" NOR,
});

void create() {
  set_name(name[random(sizeof(name))], ({ "jiu bei", "bei", "cup" }));
  set_weight(200 + random(5) * 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "酒楼种目繁多的酒樽中的一种，做工精巧。\n");
    set("unit", "个");
    set("value", (random(9) + 1) * 10000);
    set("max_liquid", 10);
  }

  set("liquid", ([
    "type": "alcohol",
    "name": jiu[random(sizeof(jiu))],
    "remaining": 10,
    "drunk_apply": 5,
  ]));
}
