void init()
{
add_action("do_qiu","qiu");
}

int do_qiu(string arg)
{
int i;
object me=this_player();
object where =  this_object();
i=(int)me->query_kar();

if ( !me || !arg || arg!="qian" )
	return notify_fail("你想求什么？\n");

if ( (int)me->query("ask_life") )
	return notify_fail("你已经求过一次了，这种事情一生人只得一次哦。\n");

if ( (int)where->query("coe") && me->query("id")!=where->query("id") )
	return notify_fail("先等等吧，现在有人在求签呢。\n");

i=i/10+random(i/10);
message_vision("$N跪在佛像之下，虔心祷告......\n",me);
me->receive_damage("sen", 10);
where->set("coe",(int)where->query("coe")+1 );
where->set("id",me->query("id") );
if( (int)where->query("coe") >=(11-i) ) 
	{
	message_vision("\n求签箱中有了动静了！\n一支签掉了出来。\n"NOR,me);
	tell_object(me,"还是去向方丈问问你的卦象吧！ \n");
	me->set("ask_life",1);
	me->set("luckys",i);
	call_out("resets",30,where);
	}
return 1;
}

void resets(object where)
{
where->delete("coe");
where->delete("id");
return;
}
