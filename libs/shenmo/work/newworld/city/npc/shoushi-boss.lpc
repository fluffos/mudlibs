#include <ansi.h>
inherit F_VENDOR_SALE;

void create() {
  reload("newcity_shoushi");
  set_name("金颜玉", ({ "jin yanyu", "jin", "yanyu", "yu", "seller", "vendor" }));
  set("shop_id", ({ "seller" }));
  set("gender", "女性");
  set("age", 20 + random(10));
  set("title", "首饰店老板娘");
  set("long", "卖首饰的老板娘，虽已为人妇，倒也长的貌美如花。\n");
  set("combat_exp", 40000);
  set("daoxing", 40000);

  set_skill("dodge", 70);
  set_skill("parry", 70);
  set_skill("unarmed", 70);
  set_skill("literate", 70);

  set("attitude", "friendly");
  set("rank_info/respect", "newcity_shoushi");
  set("per", 25 + random(10));
  set("vendor_goods", ([
    //    "sword-book": "/newworld/city/obj/book/skill/sword",
    //    "fuji": "/d/obj/books-nonskill/fuji",
    //    "kunlun": "/d/obj/books-nonskill/kunlun",
  ]));
  setup();
  carry_object("/obj/loginload/skirt")->wear();
  carry_object("/obj/loginload/shoes")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || !visible(ob) || environment(ob) != environment())
    return;
  command("say 这位" + RANK_D->query_respect(ob) + "请进请进。");
}

mixed buy_object(object who, object item) {
  object npc = this_object();
  string st;

  st = "total" + (string)item;
  if (npc->query_temp("total_books") < 10) {
    if (npc->query_temp(st) < 10)
      return ::buy_object(who, item);
    else
      return notify_fail(name() + "说道：对不起，您老要的卖完了！您等下一批进货吧。\n");
  } else
    return notify_fail(name() + "说道：小店本小，今日以将存货卖完了。您老等下一批吧。\n");
}
