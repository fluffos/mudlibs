#include <ansi.h>
inherit NPC;
#include "girl.h"
string *name = ({
  "如意",
  "吉祥",
  "阿喜",
  "阿吉",
});

void create() {
  set_name(name[random(sizeof(name))], ({ "ban niang", "niang", "girl" }));
  set("gender", "女性");
  set("age", 14 + random(6));
  set("per", 20 + random(10));
  set("title", HIW "小伴娘" NOR);
  set("long", HIC "一个漂亮的小伴娘。\n" NOR);
  set("combat_exp", 500);
  set("attitude", "friendly");
  setup();
  carry_object("/d/obj/cloth/xiuhuaxie")->wear();
  carry_object("/d/obj/cloth/pink_cloth")->wear();
}
