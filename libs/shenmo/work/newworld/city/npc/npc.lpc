// kid.c

#include <ansi.h>
#include "npc.h"
inherit NPC;

void create() {
  set_name("稻草人", ({ "daocao ren", "ren" }));
  set("gender", random(2) ? "男性" : "女性");
  set("age", 14 + random(36));
  if (query("gender") == "男性")
    set("long", chinese_number(query("age")) + "上下的男性居民。\n");
  else set("long", chinese_number(query("age")) + "上下的女性居民。\n");
  set("kee", 300);
  set("sen", 300);
  set("eff_kee", 300);
  set("eff_sen", 300);
  set("combat_exp", 100);
  set("attitude", "peaceful");
  set("level", 1);
  set("exp", 500);
  set("obj", "/d/obj/cloth/linen");
  set("persent", 5 + random(45));
  setup();
  carry_object("/d/obj/cloth/linen")->wear();
}
