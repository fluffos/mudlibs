#include <ansi.h>
inherit NPC;
string *name=({
	"破","异","见","空","生","契","身","体","故",
	"世","尊","以","微","尘","世","界","非","异",
	"示","言","微","尘","观","实","愚","合","相",
	"离","凡","异","平","等","理",
});

void create()
{
set_name("静"+name[random(sizeof(name))], ({"monk"}));
set("long", "一位和尚，看起来慈善的很，口里还不停的咏经。\n");
set("gender", "男性");
set("attitude", "peaceful");
set("class", "bonze");
set("age", 20+random(10));
set("combat_exp", 25000);
set("daoxing", 30000);

set("shen_type", 1);
set("per", 25);
set("max_kee", 380);
set("max_gin", 300);
set("force", 250);
set("force_factor", 5);
set_skill("force", 20+random(30));
set_skill("unarmed", 20+random(30));
set_skill("dodge", 20+random(30));
set_skill("parry", 20+random(30));

setup();
carry_object("/d/obj/cloth/sengyi")->wear();
}

int accept_fight(object me)
{
command("say 好吧，砌搓技艺，点到为止！\n");
return 1;
}

