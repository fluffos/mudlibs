
#include <ansi.h>
inherit NPC;

string suanming(object me);
string suan_fuyuan(object me);
string suan_rsg(object me);

void create()
{
set_name("枯荣禅师", ({"kurong chanshi","chanshi"}));
set("title","般若寺方丈");
set("gender", "男性" );
set("age", 55+random(25));
set("class","taoist");
set("long", "般若寺主持，德高望重，据说是前朝的皇族之后。\n");
set("combat_exp", 18000);
set("daoxing", 80000);

set("attitude", "peaceful");
set_skill("unarmed", 80);
set_skill("dodge", 80);
set_skill("parry", 80);
set_skill("literate", 80);
set_skill("spells", 80);
set("per", 25);
set("max_kee", 350);
set("max_gin", 300);
set("max_sen", 300);
set("max_mana", 200);
set("mana", 200);
set("mana_factor", 5);
setup();
carry_object("/d/obj/cloth/monkcloth")->wear(); 
}

void init()
{
object ob=this_object();

::init();
set("chat_chance", 1);
set("inquiry", ([
	"name" : "老衲枯荣。\n",
	"here" : "佛在心中。\n", 
	"卦象" : (: suan_fuyuan :),
	"命运" : (: suanming :),
]) );

set("chat_msg", ({
            ob->name()+"垂眉低颂：南无阿弥陀佛。\n",       
        }) );
}


string suan_fuyuan(object me)
{
int my_level;

string *levels = ({
	"霉气冲天，恕在下直言，血光之灾不远矣！\n",
	"印堂发暗，这个这个．．．\n",
	"运道尚可。\n",
	"今生福缘不浅呀！。\n",
	"定是多福多寿之人。\n",
	"今生必有奇缘，恭喜，恭喜！\n",
	"真是福如东海，寿比南山呀！\n",
});

me = this_player();

my_level=me->query("luckys");
if(my_level>6 ) my_level=6;

if( !(int)me->query("luckys") )
        {
	message_vision("$N瞑目沉思片刻。\n",this_object(),me);
	return "这个．．．天机不可泄露啊。\n";
	}
message_vision(this_object()->name()+"对$N道：施主等待片刻！说罢低头算了几算。\n", me);
if(my_level<0 )
	return "奇怪！"+RANK_D->query_respect(me)+"运数十分怪异，在下修为不够，算不出来．．．\n";
else
	return RANK_D->query_respect(me)+levels[my_level];
}


string suanming(object me)
{
me = this_player();

message_vision(this_object()->name()+"对$N道：你算是找对人了！说罢掐指算了几算。\n", me);
if(me->query("life/live_forever"))
	return "失敬！失敬！原来"+RANK_D->query_respect(me)+"跳出三界外，不在五行中，已是戡破生死大限了！\n";
else if(me->query("age")<16)
	return RANK_D->query_respect(me)+"定会长命百岁，前途不可限量！\n";
else
	return RANK_D->query_respect(me)+"有"+chinese_number(me->query("life/life_time"))+"年的阳寿。\n";
}


