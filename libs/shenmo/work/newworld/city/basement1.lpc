// basement.c

#include <ansi.h>
inherit ROOM;
object treasure_obj;
object findobj();

void create ()
{
  object box;
  set ("short",HIY"钱庄二楼"NOR );
  set ("long", @LONG
  
一间戒备森严的地下室，专门提供寄存服务。你可以在
这里寄存(jicun)物品，价格公道，不论物品贵贱，一律
按原价的四成收费。可以随时取回(qu)。

LONG);

set("exits", ([ /* sizeof() == 1 */
	"down" : __DIR__"bank",
]));
set("no_clean_up",1);
set("no_magic",1);
set("no_fight",1);
  
set("objects",([
	__DIR__"npc/bank-boss2" :1,
]));  
setup();
}

object findobj()
{
if(treasure_obj && environment(treasure_obj)==this_object()) 
	return treasure_obj;
treasure_obj=new(__DIR__"obj/shopobj");
treasure_obj->move(this_object());
return treasure_obj;  
}    

void init()
{
  add_action("do_jicun","jicun");
 // add_action("do_qu","qu");
 }

int do_jicun(string arg)
{
int i,limit,value,afford;
object ob,*inv;
object me=this_object();
object who=this_player();
inv=all_inventory(who);
for(i=0; i<sizeof(inv); i++) 
	{
	if ( inv[i]->query("id")!=arg ) continue;
	ob=inv[i];
	}

if (!treasure_obj=findobj()) 
        return notify_fail("对不起,本钱庄暂停营业!\n");

if (!ob) 
	return notify_fail("你要寄存什么东西?\n"NOR);

if (!present(arg,who)) 
        return notify_fail("你身上没有这样东西。\n");

limit=(int)who->query_temp("jicun_limit");

if (limit && limit>20) 
	return notify_fail("对不起,每个人最多只能寄存20个物品。\n");

value=(int)ob->query("value")/4;

if( !(afford=who->can_afford(value)) )  
	{
	write("你没有足够的钱。\n");
	return 1; 
	}   
else if( afford == 2 )  
	{
	write("你没有足够的零钱，而银票又没人找得开。\n");
	return 1;
	}
treasure_obj->set("goods/"+arg,ob);
treasure_obj->set("goods/owner",who->query("id"));
message_vision("$N寄存"+ob->name()+"一"+ob->query("unit")+"。\n"NOR,who); 

if (!treasure_obj->query("goods/number")) treasure_obj->set("goods/number",0);
treasure_obj->add("goods/number",1);
ob->move(treasure_obj);
who->start_busy(1);
who->pay_money(value);
who->add_temp("jicun_limit",1);
return 1;
}

