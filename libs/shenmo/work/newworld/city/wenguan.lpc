// yashi.c
#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
  set ("short","文驿");
  set ("long", @LONG

这儿是京师三品以下文官们的居住之所，虽众合居一檐下，
然大槐国民风使然，并不觉言行不便。
这儿有张大木床(bed)供各人休息之用。

LONG);
set("exits", ([ 
	"east" : __DIR__"beijie5",
]));
set("objects", ([
//    __DIR__"npc/" : 1,  //文官若干三品以下官衔·文
  ]));
set("sleep_room",1);  
set("no_fight",1);  
set("no_magic",1);  
create_door("east", "朱漆大门", "west", DOOR_CLOSED);
set("no_clean_up", 0);
setup();
}

void init()
{
add_action("do_bed", "gosleep");
add_action("do_bed", "gobed" );
add_action("do_bed", "bed");
}

int do_bed()
{
object me = this_player();
message_vision(HIY "$N掀开纱帐，准备上床了。\n\n" NOR, me);
me->move(__DIR__"bed_wenguan");
message_vision(HIY "\n沙帐轻轻一动，$N钻了进来。\n" NOR, me);
return 1;
}
