// yang.c 杨戬
#include <ansi.h>
inherit NPC;
void create() {
  set_name("杨戬", ({ "yang jian", "yang" }));
  set("title", HIR "二郎神" NOR);
  set("gender", "男性");
  set("age", 32);
  set("str", 55);
  set("per", 30);
  set("kar", 50);
  set("long", "二郎神杨戬是玉皇大帝的亲外甥，受托塔天王指派，在此监斩四方妖孽。\n");
  set("combat_exp", 40000000);
  set("daoxing", 40000000);
  set("attitude", "heroism");
  set("bellicosity", 3000);
  set("level", 1200);
  set_skill("unarmed", 700);
  set_skill("force", 1200);
  set_skill("sword", 1200);
  set_skill("dodge", 1200);
  set_skill("zhenlongqi", 1200);
  set_skill("fengyun-shou", 1200);
  set_skill("xianfeng-spells", 1200);
  set_skill("spells", 1200);
  set_skill("parry", 1200);
  set_skill("xuanyuan-jian", 1200);
  set_skill("bagua-bufa", 1200);
  map_skill("parry", "xuanyuan-jian");
  map_skill("sword", "xuanyuan-jian");
  map_skill("unarmed", "fengyun-shou");
  map_skill("force", "zhenlongqi");
  map_skill("spells", "xianfeng-spells");
  map_skill("dodge", "bagua-bufa");
  set_temp("apply/attack", 200);
  set_temp("apply/defense", 200);
  set_temp("apply/armor", 200);
  set_temp("apply/damage", 200);
  set("inquiry", ([
    "zhuibu": "你没看到玉柱上面的告示么？问我作甚！\n",
    "追捕": "你没看到玉柱上面的告示么？问我作甚！\n",
  ]));
  set("max_kee", 100000);
  set("kee", 100000);
  set("max_sen", 80000);
  set("sen", 80000);
  set("max_force", 12000);
  set("force", 24000);
  set("max_mana", 12000);
  set("mana", 20000);
  set("force_factor", 600);

  setup();
  carry_object("/d/sky/obj/zhanyaojian")->wield();
  carry_object("/d/obj/armor/jinjia")->wear();
}

int accept_fight(object me) {
  command("say 小神现在有公务缠身，恕不奉陪！");
  return 0;
}
