#include <ansi.h>
inherit BULLETIN_BOARD;

void create() {
  set_name("天宫公告榜", ({ "tiangong board", "board" }));
  set("long", @LONG
    这是天庭为了此次魔界进犯大唐而招募天下有能力之奇人异士而
设立的公告榜，你可以在这里揭榜以获得当前进犯的魔界先锋军的信
息。
    下面围观了许多看热闹的人，当中不乏一些方外高手，但是要捉
拿的魔界恶孽都很扎手，很少有人随便揭榜。但也有不少刚刚修行有
所成就的人士在一旁跃跃欲试。
LONG
  );
  set_weight(10000);
  set("no_get", "这玩意太重。\n");
  set("master", "玉皇大帝");
  set("board_id", "sky-mojie_b");
  set("location", "/d/dntg/sky/taiyanggong");
  set("channel_id", "李靖(Li jing)");
  setup();
  set("capacity", 300);
  remove_call_out("clean_guai1");
  call_out("clean_guai1", 3540);
  remove_call_out("clean_guai");
  call_out("clean_guai", 3600);
}

void clean_guai1() {
  CHANNEL_D->do_channel(this_object(), "chat", "现魔国妖孽在人间横行，诸天将听令，随我下界除魔！");
}

void clean_guai() {
  object *gg;
  int i, k = 0;
  //清理残余魔兵
  gg = children(__DIR__ "npc/yaoguai.lpc");
  for (i = 0; i < sizeof(gg); i++) {
    if (!gg[i] || !environment(gg[i]))
      continue;
    gg[i]->delete_temp("last_damage_from");
    gg[i]->remove_all_killer();
    all_inventory(environment(gg[i]))->remove_killer(gg[i]);
    tell_room(
      environment(gg[i]),
      "\n半空一声怒喝：妖孽，还不束手？！\n\n天空中伸出一只大手，将" + gg[i]->name() + "一把抓去。\n\n"
    );
    k++;
    destruct(gg[i]);
  }
  if (k > 0)
    CHANNEL_D->do_channel(
      this_object(),
      "chat",
      "诸天将齐心协力，共抓那了" + chinese_number(k) + "个残余魔兵，与我回天庭复命。"
    );
}

//清理过期的data                
void check_player_data(string dd) {
  int i;
  string tmp, *temp;
  mapping data;
  restore();
  if (!dd)
    return;
  tmp = sprintf("%d日%d时", localtime(time())[3], localtime(time())[2]);
  data = query(dd);
  if (data && mapp(data)) {
    temp = keys(data);
    for (i = 0; i < sizeof(temp); i++) {
      if (data[temp[i]] && temp[i] != tmp)
        delete(dd + "/" + temp[i]);
    }
    save();
  }
}

mixed check_job(object who) {
  int k;
  string tmp;
  mapping data;
  restore();
  if (!who)
    return 0;
  //清理以前的data                
  check_player_data("guai");
  check_player_data("初始化");
  check_player_data("guai_max");

  tmp = sprintf("%d日%d时/%s", localtime(time())[3], localtime(time())[2], who->query("id"));
  if (query("guai/" + tmp) <= 0)  //当日任务数为0
  {
    if (!query("初始化/" + tmp))  //本日本时未初始化过
    {
      k = 10 + random(15);  //每人每小时增加武学80000-200000
      set("guai/" + tmp, k);
      set("guai_max/" + tmp, k);
      set("初始化/" + tmp, 1);
      save();
      return k;
    } else return "已完成";
  }
  return query("guai/" + tmp);
}

void init() {
  add_action("do_jie", "jie");
  ::init();
}

void auto_post(string str) {
  mapping note, *notes;
  if (sizeof(query("notes")) > 100) {
    delete("notes");
    save();
  }
  note = allocate_mapping(5);
  note["title"] = HIR "除魔记录" NOR;
  note["sx"] = "◆";
  note["author"] = "李靖";
  note["time"] = time();
  note["ip"] = "天庭";
  note["msg"] = str;
  notes = query("notes");
  if (!pointerp(notes) || !sizeof(notes))
    notes = ({ note });
  else notes += ({ note });
  set("notes", notes);
  save();
}

int err_msg(string arg) {
  write(arg);
  return 1;
}

int do_post(string arg) {
  if (userp(this_player()) && !wizardp(this_player()))
    return err_msg("一旁转出值班天曹，喝道：天宫焉是汝胡乱涂塌之地！\n");
  return ::do_post(arg);
}

int do_jie(string arg) {
  int i, exp;
  mapping data, note, *notes;
  string str, tmp;
  object *temp, guai, env, me = this_player();
  if (!arg)
    return err_msg("你要揭榜？请输入 jie bang 。\n");
  /*任务标识
        data :
                last_lost INT   上次失败时间
                last_succ INT   上次成功时间
                start     INT   上次任务获得时间
                target    OBJ   任务怪
                job_msg   STRING任务信息
                num       INT   总任务数量
                succ_num  INT   成功数量
                lost_num  INT   失败数量
                reward    INT   奖励点 |在升级装备50+时损耗
                job       INT   1 已经领取任务                  
        */
  data = me->query("新任务/魔界先锋");
  //刚刚失败过的，五分钟之内不能领取任务
  if (data && data["last_lost"]) {
    if (time() < data["last_lost"] + 300)
      return err_msg("你刚刚失败过，还是休息一下再来吧。\n");
  }
  //已领了任务的  
  if (data && data["job"]) {
    if (time() < data["start"] + 120)  //刚接任务2分钟之类不能取消
      return err_msg(data["job_msg"] ? data["job_msg"] : "你不是刚刚要过任务吗？\n");
    else if (me->query_temp("cancel_mojie"))  //真正想要放弃任务的
    {
      write(data["job_msg"] ? data["job_msg"] : "你刚刚要过了任务。\n");
      write(HIY "你决定放弃当前所做的任务。\n" NOR);
      //清理地图残余怪物
      temp = children(__DIR__ "yaoguai.lpc");
      for (i = 0; i < sizeof(temp); i++) {
        if (temp[i] && temp[i]->query("owner_id") == me->query("owner_id")) {
          temp[i]->delete_temp("last_damage_from");
          temp[i]->remove_all_killer();
          if (environment(temp[i])) {
            all_inventory(environment(temp[i]))->remove_killer(temp[i]);
            tell_room(environment(temp[i]), temp[i]->name() + "哈哈大笑：终于探得大唐些许信息，回去说与主尊知，也好得些奖赏。\n");
            tell_room(environment(temp[i]), temp[i]->name() + "急急忙忙的离开了。\n");
            destruct(temp[i]);
          }
        }
      }
      data["last_lost"] = time();
      data["start"] = 0;
      data["target"] = 0;
      data["job_msg"] = 0;
      data["num"]++;
      data["succ_num"] += 0;
      data["lost_num"]++;
      data["reward"]--;
      data["job"] = 0;
      write("你的天庭功勋减少了一点。\n");
      me->set("新任务/魔界先锋", ([
        "last_lost": time(),
        "start": 0,
        "target": 0,
        "job_msg": 0,
        "num": me->query("新任务/魔界先锋/num") + 1,
        "succ_num": me->query("新任务/魔界先锋/succ_num"),
        "lost_num": me->query("新任务/魔界先锋/lost_num") + 1,
        "reward": me->query("新任务/魔界先锋/reward") - 1,
        "job": 0,
      ]));
      me->delete_temp("cancel_mojie");
      me->save();
      tmp = sprintf("%d日%d时/%s", localtime(time())[3], localtime(time())[2], me->query("id"));
      add("guai/" + tmp, -1);
      str = sprintf(
        "%s %s(%s)放过了一名入侵魔兵。\n",
        ctime(time()),
        me->name(1),
        capitalize(me->query("id"))
      );
      auto_post(str);
      return 1;
    } else {
      me->set_temp("cancel_mojie", 1);
      write(data["job_msg"] ? data["job_msg"] : "你刚刚要过了任务。\n");
      return err_msg("你决定" HIR "放弃" NOR "当前的任务，如果确定，请再揭一次榜以放弃当前任务。\n");
    }
  }
  //领取任务
  //检查今日怪物数
  if (check_job(me) == "已完成")
    return err_msg("你今日今时的入侵魔兵业已除净。\n");
  exp = me->query("combat_exp") / 10000;
  if (exp < 450)
    return err_msg("以你现在的修为，现在去也是送死。\n");
  guai = new(__DIR__ "npc/yaoguai.lpc");
  if (!guai || !guai->information(me)) {
    if (guai) destruct(guai);
    return err_msg("目前没有可杀的魔兵。\n");
  }
  env = environment(guai);
  if (!env) {
    if (guai) destruct(guai);
    return err_msg("目前没有可杀的魔兵。\n");
  }
  str = sprintf("今有魔兵%s化身%s，在%s一带打听大唐近况，速速前往灭之！\n",
    guai->name(1),
    SDS_D->random_msg(guai->name(), 1),
    SDS_D->random_msg(MISC_D->find_place(env), 1),
  );
  me->set("新任务/魔界先锋", ([
    "last_lost": 0,
    "start": time(),
    "target": guai,
    "job_msg": str,
    "num": me->query("新任务/魔界先锋/num"),
    "succ_num": me->query("新任务/魔界先锋/succ_num"),
    "lost_num": me->query("新任务/魔界先锋/lost_num"),
    "reward": me->query("新任务/魔界先锋/reward"),
    "job": 1,
  ]));
  me->save();
  guai->set("board", this_object());
  tmp = sprintf("%d日%d时/%s", localtime(time())[3], localtime(time())[2], me->query("id"));
  add("guai/" + tmp, -1);
  save();
  exp = me->query("combat_exp") / 10000;
  if (exp < 800)
    message_vision("$N推开围观的行人，走到近前,微微睁开眼睛，冷冷瞥了一眼告示，随手揭了下来揣进了怀中。\n", me);
  else if (exp <= 3600)
    message_vision("$N壮了壮胆，费力拔开行人，来到近前深深吸了口气，竭力镇定一下紧张的心情，四下看了看，悄悄把文书揭了下来。\n", me);
  else message_vision("$N分开行人来到近前，目光淡淡的扫视了几眼告示，嘴角微微一翘，神态自如的把文书揭了下来。\n", me);
  write("你定睛观瞧，只见榜上写着：\n");
  write(str);
  return 1;
}

string long() {
  int MAX, NOW;
  mapping notes;
  string tmp, str = ::long();
  notes = query("notes");
  if (pointerp(notes) && sizeof(notes))
    str = query("long");
  str += HIY "\n你现在的天庭功勋是" HIR + this_player()->query("新任务/魔界先锋/reward") + HIY "。\n" NOR;
  if (check_job(this_player()) == "已完成")
    str = HIY "\n你今日这一小时任务已全部完成。\n" NOR;
  else {
    tmp = sprintf(
      "%d日%d时/%s",
      localtime(time())[3],
      localtime(time())[2],
      this_player()->query("id")
    );
    MAX = query("guai_max/" + tmp);
    NOW = query("guai/" + tmp);
    str += sprintf(HIY "\n目前(%s)已完成任务数：%d/%d(" HIR "%d%%" HIY ")\n" NOR,
      tmp,
      (MAX - NOW),
      MAX,
      (MAX - NOW) * 100 / MAX,
    );
  }
  str += "\n上面现在的信息是：\n";
  str += ::long();
  return str;
}
