void clean_bian()
{
        delete_temp("spellslevel");
        delete_temp("apply/name");
        delete_temp("apply/id");
        delete_temp("apply/short");
        delete_temp("apply/long");
        delete_temp("gender");
        delete_temp("age");
        delete_temp("race");
}
        
void check_equip()
{
        int i;
        object tmp;
        mapping ar;
        string w,*id,*ty,*armor = ({
                "armor","cloth","pifeng","kui","shoes",
        });
        ar = query_temp("guai_armor");
        if( !ar || !mapp(ar) )
        {
                ar = ([]);
                for(i=0;i<sizeof(armor);i++)
                {
                        tmp = new("/d/city/npc/obj/"+armor[i]);
                        tmp->move(this_object());
                        ar[armor[i]] = tmp;
                }
                set_temp("guai_armor",ar);
        }
        ty = keys(ar);
        for(i=0;i<sizeof(ty);i++)
        {
                tmp = ar[ty[i]];
                if( !tmp || !present(tmp,this_object()) )
                {
                        if( tmp )  destruct(tmp);
                        tmp = new("/d/city/npc/obj/"+ty[i]);
                        tmp->set("no_steal",1);
                        id = ({"yao jia","jia"});
                        tmp->set_name(HIB"妖甲"HIR+sprintf("%s",nick[random(sizeof(nick))][0..5])+NOR,id);
                        tmp->set("no_get",1);
                        tmp->set("no_drop",1);
                        tmp->set("no_put",1);
                        tmp->set("no_sell",1);                                          
                        tmp->setup();
                        tmp->move(this_object());
                        set_temp("guai_armor/"+ty[i],tmp);
                }
                tmp->wear();
        }       
        w = query("weapon_file");
        tmp = query("weapon");
        if( !tmp || !present(tmp,this_object()) )
        {
                if( tmp )  destruct(tmp);
                if( w && stringp(w) )
                {
                        tmp = new(w);
                        id = ({"yao qi","qi"});
                        tmp->set_name(HIB"妖器"HIR+sprintf("%s",nick[random(sizeof(nick))][0..5])+NOR,id);
                        tmp->set("no_get",1);
                        tmp->set("no_drop",1);
                        tmp->set("no_put",1);
                        tmp->set("no_sell",1);                  
                        tmp->setup();
                        tmp->move(this_object());
                        set("weapon",tmp);
                }
        }
        tmp->wield();   
        return;
}

void create()
{
        int i;
        string wf,*sk,sk1,sk2;
        mapping skill;
        yuanx = NAME_D->random_name("yaoguai");
        set_name(yuanx["name"],yuanx["id"]);
        set("gender","男性");
        set("per",5);
        set("str",60);
        set("int",60);
        set("spi",60);
        set("cps",60);
        set("con",60);
        set("public",1);
        set("long","魔界进攻南瞻部洲的先锋士兵。");
        switch(random(4))
        {
                case 1 :
                        set("faith", 10000);
                        skill = ([
                                "stealing"      : 0,
                                "force"         : "huntian-qigong",
                                "unarmed"       : "yinfeng-zhua",
                                "dodge"         : "lingfu-steps",
                                "spells"        : "yaofa",
                                "sword"         : "qixiu-jian",
                                "parry"         : "qixiu-jian",
                                "blade"         : "kugu-blade",
                                "literate"      : 0,
                        ]);
                        create_family("陷空山无底洞", 1, "弟子");
                        switch(random(4))
                        {
                                case 0 : wf = "/d/city/npc/obj/blade";break; 
                                default: wf = "/d/city/npc/obj/sword";break; 
                        }
                        break;
                case 2 :
                        skill = ([
                                "spells"        : "dengxian-dafa",
                                "force"         : "ningxie-force",
                                "unarmed"       : "cuixin-zhang",
                                "sword"         : "bainiao-jian",
                                "parry"         : "bainiao-jian",
                                "blade"         : "bingpo-blade",
                                "throwing"      : 0,
                                "literate"      : 0,
                                "dodge"         : "xiaoyaoyou",
                        ]);
                        create_family("大雪山", 1, "弟子");
                        switch(random(3))
                        {
                                case 0 : wf = "/d/obj/weapon/blade/iceblade";break; 
                                default: wf = "/d/obj/weapon/sword/fenghuangqin";break; 
                        }
                        break;                                  
                default :
                        skill = ([
                                "literate"      : 0,
                                "spells"        : "tianmo",
                                "unarmed"       : "tigerfight",
                                "dodge"         : "dimo-steps",
                                "force"         : "evil-force",
                                "blade"         : "tianmo-blade",
                                "parry"         : "tianmo-blade",
                                "sword"         : "shengling-sword",
                        ]);
                        create_family("魔教", 1, "教主");
                        switch(random(3))
                        {
                                case 0 : wf = "/d/city/npc/obj/blade";break; 
                                default: wf = "/d/city/npc/obj/sword";break; 
                        }
                        break;                                  
        }
        sk = keys(skill);
        for(i=0;i<sizeof(sk);i++)
        {
                sk1 = sk[i];
		sk2 = skill[sk[i]];
                set_skill(sk1,600);
                if( sk2 )
                {
                        set_skill(sk2,600);
                        map_skill(sk1,sk2);
                }
        }        
        setup();        
        set("nickname",HIM+nick[random(sizeof(nick))]+NOR);
        set("title",HIR"魔界"HIY" 先锋将"NOR);
        set("weapon_file",wf);
}

void die()
{
        int wx,pot,dx,gx;
        mapping note,*notes;    
        string str;
        object board,owner,me = this_object(),who = query_temp("last_damage_from");
        owner = query("owner");
        board = query("board");
        if( query("force")>500 ) 
        {
                 SDS_D->addEffKee(me);
                 SDS_D->addKee(me);
                 SDS_D->addEffSen(me);
                 SDS_D->addSen(me);
                 return;
        }
        if( query_temp("spellslevel") )
                message_vision("$N「啪」的一声倒在地上，挣扎着抽动了几下就死了。\n一道黑气冲天而去，$N现出了原形，原来是一只"+name(1)+"。\n",this_object());
        if( !who || !present(who,environment()) || ( owner && who!=owner ) )
        {
                if( owner )
                        tell_object(owner,"你要杀的魔兵被"+who->name()+"杀死了，你什么也没得到。\n");
                if( board )
                {
                        str = sprintf("%s %s一名入侵魔兵被%s(%s)所杀。\n",
                                ctime(time()),
                                owner?owner->name(1):"",
                                who?who->name(1):"大唐游侠",
                                who?capitalize(who->query("id")):"You xia",
                                );
                        board->auto_post(str);
                }                       
                destruct(this_object());
                return;
        }
        wx = 8000;
        wx = wx/3*2+random(wx/5);
        dx = wx/2;
        pot = wx/4;
        gx = 1+random(10);
        who->add("combat_exp",wx);
        who->add("daoxing",dx);
        who->add("potential",pot);      

        who->set("新任务/魔界先锋",([
                "last_lost"     : 0,
                "start"         : 0,
                "target"        : 0,
                "job_msg"       : 0,
                "num"           : who->query("新任务/魔界先锋/num")+1,
                "succ_num"      : who->query("新任务/魔界先锋/succ_num")+1,
                "lost_num"      : who->query("新任务/魔界先锋/lost_num"),
                "reward"        : who->query("新任务/魔界先锋/reward")+gx,
                "job"           : 0,
        ]));
        who->save();
        if( board )
        {
                str = sprintf("%s %s杀死一名入侵魔兵得到了%d武学经验\n%s道行和%d点\n潜能以及%d天庭功勋，目前功勋%d\n",
                                ctime(time()),
                                who->name()+"("+capitalize(who->query("id"))+")",
                                wx,
                                COMBAT_D->chinese_daoxing(dx),
                                pot,
                                gx,
                                who->query("新任务/魔界先锋/reward"),
                        );
                board->auto_post(str);                        
        }                       
        tell_object(who,HIY"你杀死一名入侵魔兵，得到了"+wx+"点武学经验、"+COMBAT_D->chinese_daoxing(dx)+"道行、\n"+pot+"点潜能以及"+gx+"点天庭功勋的奖励。\n你现在的天庭功勋为"+who->query("新任务/魔界先锋/reward")+"。\n"NOR);
        message_vision(HIB"\n\n$N"HIB"化作一道黑气直奔北俱芦洲而去！\n"NOR"$n见状不由暗自皱眉：莫非这与北方那个魔国有关？！\n",this_object(),who);
        destruct(this_object());
}

void heart_beat()
{
        string wf;
        object owner,weapon,me = this_object();
        if( !environment() )  return;
        owner = query("owner");
        if( !owner )
        {
                delete_temp("last_damage_from");
                die();
                return;
        }
        if( !living(owner) )
        {
                remove_all_killer();
                all_inventory(environment())->remove_killer(this_object());
                tell_room(environment(),name()+"哈哈大笑：终于探得大唐些许信息，回去说与主尊知，也好得些奖赏。\n");
                tell_room(environment(),name()+"急急忙忙的离开了。\n");
                destruct(this_object());
                return;
        }
        if( query("force")<500 )
        {
                if( query("kee")<=0 || query("eff_kee")<=0 )
                {
                        die();
                        return;
                }
                if( query("sen")<0 || query("eff_sen")<=0 )
                {
                        unconcious();
                        return;
                }
        }
        check_equip();
        if( me->is_busy() )   
        {
                if( query_temp("busy_time")>2 )
                {
                        me->start_busy(1,10000);
                        me->interrupt_me(me,"不动"); 
                        me->reset_action(); 
                        delete_temp("busy_time");
                }
                else    add_temp("busy_time",1);
        }
        if( query("eff_kee") < query("max_kee") )
                SDS_D->addEffKee(me);
        if( query("kee") < query("eff_kee") )
                SDS_D->addKee(me);
        if( query("sen") < query("eff_sen") )
                SDS_D->addSen(me);
        if( query("eff_sen") < query("max_sen") )
                SDS_D->addEffSen(me);
        if( me->is_fighting() && !me->is_busy() )
        {
                if( weapon && present(weapon,me) )  
                        weapon->wield();                
                command("wear all");                    
                this_object()->clean_up_enemy();
                switch(random(10))
                {
                        case 0 :
                        case 4 : SDS_D->randomCast(me);break;
                        case 1 :
                        case 5 : SDS_D->randomExert(me);break;
                        default : SDS_D->randomPfm(me);break;                   
                }
        }
        ::heart_beat();
}

int is_job(){return 1;}

varargs int receive_damage(string type, int damage, object who)
{
if( !who || who==this_object() )
        damage = 0;
else    {
        if( !userp(who) 
         || !this_object()->is_fighting(who) 
         || who!=query("owner") )
         {
                remove_killer(who);
                who->remove_killer(this_object());
                tell_object(who,name()+"不想和你较量。\n");
                damage = 0;
                return 0;
        }
        if( damage>2000 ) 
                damage = 2000;                
        }
return ::receive_damage(type,damage,who);
}

varargs int receive_wound(string type, int damage, object who)
{
if( !who || who==this_object() )
        damage = 0;
else    {
        if( !userp(who) 
         || !this_object()->is_fighting(who) 
         || who!=query("owner") )
         {
                remove_killer(who);
                who->remove_killer(this_object());
                tell_object(who,name()+"不想和你较量。\n");
                damage = 0;
                return 0;
        }
        if( damage>1000 ) 
                damage = 1000;                                
        }
return ::receive_wound(type,damage,who);
}

void kill_ob(object who)
{
        if( !who )
                return;
        if( who!=query("owner") )
        {
                remove_killer(who);
                who->remove_killer(this_object());
                return;
        }               
        if( !this_object()->is_fighting()
          && query_temp("spellslevel") 
          && random(10)>6 )
        {               
                message_vision(HIR"$N"HIR"吐出一阵黑烟，烟雾散去，$N现出了原形，原来是一只"+name(1)+"。\n",this_object());
                clean_bian();
        }
        this_object()->set_leader(who);
        ::kill_ob(who);
}       

int information(object who)
{
        int level,wx,dx,kee,force,sk,i;
        string *skills,file;
        object ob,where;
        mapping skill;
        
        if( !who || !living(who) )
                return 0;
        ob = SDS_D->random_npc();
        if( !ob || !living(ob) )
                return 0;               
        where = SDS_D->random_place();
        if( !where || where->query("no_fight") 
         || where->query("no_magic") )
                return 0;
        level = who->query("level");
        if( level<1 ) level = 1;
        wx = who->query("combat_exp");
        dx = who->query("combat_exp");
        kee = who->query("max_kee");
        force = who->query("max_force");
        
        skill = who->query_skills();
        skills = keys(skill);   
        sk = 0;
        for(i=0;i<sizeof(skills);i++)
        {
                if( who->query_skill(skills[i],1)>350 )
                        sk+= who->query_skill(skills[i],1);
                else    sk+= 350;
        }
        sk/= sizeof(skills);
        //变身
        set_temp("spellslevel",100000);
        set_temp("apply/name",({ob->name(1)}));
        set_temp("apply/id",ob->parse_command_id_list());
        set_temp("apply/short", ({ob->short()}));
        set_temp("apply/long", ({ob->long()}));
        set_temp("gender",ob->query("gender"));
        set_temp("age",ob->query("age"));
        set_temp("race",ob->query("race"));
        set_temp("family",ob->query("family"));
        //复制数据
        level+= random(30);
        wx+= wx/1000;
        dx+= dx/1000;
        kee+= kee/10;
        force+= force/100;
        set("level",level);
        set("combat_exp",wx);
        set("daoxing",dx);
        set("max_kee",kee);
        set("max_sen",kee);
        set("max_force",force);
        set("max_mana",force);
        SDS_D->powerup(this_object());
        command("zhenshens changeup");
        //技能
        skill = query_skills();
        skills = keys(skill);
        for(i=0;i<sizeof(skills);i++)
                set_skill(skills[i],sk);
        this_object()->reset_action();
        if( !this_object()->move(where) )
                return 0;
        set("owner",who);
        set("owner_id",who->query("id"));               
        return 1;
}
