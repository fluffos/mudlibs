#include <ansi.h>
inherit ROOM;

nosave int MAX = 10;
nosave void start_game(int t,int level);

void create()
{
        set("short", "战场");
        set("channel_id","尉迟恭(Yuchi gong)");
        set("long", @LONG


        守护！守护！一切为了帝国的荣耀！

LONG);
}

mapping Zuob = ([
        "甲"    : 8,
        "乙"    : 7,
        "丙"    : 6,
        "丁"    : 5,
        "戊"    : 4,
        "己"    : 3,
        "庚"    : 2,
        "辛"    : 1,
        "壬"    : 0,
]);     

object query_owner()
{
        return query("owner");
}

void remove_map()
{
        if( clonep(this_object()) )
                destruct(this_object());
}

void chubing(int level,int num)
{
        int t,j;
        string title;
        object bing,owner;
        owner = query_owner();
        if( !owner )
        {
                call_out("remove_map",1+random(2));
                return;
        }
        remove_call_out("chubing");
        if( level>MAX )
        {
                tell_room(this_object(),HIY"【边塞保卫】恭喜！守卫成功，国家的强盛还需要你的支持！\n"NOR);
                CHANNEL_D->do_channel(this_object(),"chat",owner->query("name")+"成功打退叛军的进攻，天佑吾皇！"NOR);
                set("channel_id","唐太宗(Tang taizong)");
                CHANNEL_D->do_channel(this_object(),"chat",owner->query("name")+"保卫边疆有功，朕特赐之"HIY"护国大将军"HIC"的成为称谓！"NOR);
                set("channel_id","尉迟恭(Yuchi gong)");
                owner->set("rank_info/respect","保家卫国的大将军");
                owner->set("rank_info/rude","臭军爷");
                owner->set("rank_info/self","本将军");
                owner->set("rank_info/self_rude","你家将军我");
                delete("owner");
                owner->set_temp("TD/last_succ",time());
                owner->move(sprintf("/d/shoucheng/broadway%d",1+random(6)));
                message_vision("\n$N打退了敌人的进攻，高高兴兴的得胜还朝。\n",owner);
                title = owner->query("title");
                if( !title )  title = "";
                title = HIY"护国大将军 "NOR+title;
                if( strsrch(title,"护国大将军")==-1 )
                       title = HIY"护国大将军 "NOR+title;
                owner->set_temp("apply/title",({title}));
                if( !owner->query_temp("TD_BUFF") )  {
                         owner->set_temp("TD_BUFF",1);
                         owner->add_temp("apply/damage",150);
                         owner->add_temp("apply/armor",200);
                         owner->add_temp("apply/attack",200);
                         owner->add_temp("apply/dodge",200);
                         tell_object(owner,HIC"你的属性得到了加强。\n"NOR);
                }
                return;
        }
        if( num<=0 )
        {
                level++;
                tell_room(this_object(),HIY"【边塞保卫】恭喜！你成功守住了叛军本轮的进攻！\n"NOR);     
                tell_room(this_object(),HIY"【边塞保卫】叛军将在60秒后再次进攻，趁着空闲的时间赶紧加紧防御工事的建设吧。\n"NOR);
                j = 10+level*2;
                owner->add_temp("TD/G",j);
                tell_room(this_object(),HIY"【边塞保卫】得到了"+j+"金的朝廷奖励。\n"NOR);
                owner->command("look");
                call_out("start_game",50,10,level);
                return;
        }
        bing = new(__DIR__"bing");
        bing->set("level",level);
        bing->set("num",10-num);
        bing->set_temp("TD",([
                "HP"    : (100+5*level),
                "armor" : 1+level,
        ]));    
        tell_room(this_object(),HIY"【边塞保卫】敌袭！有一个单位的"+bing->query("name")+"(+"+level+")前来进攻！"HIR"("+num+"/10)\n"NOR);
        bing->move(this_object());
        t = MAX-level;
        num--;
        call_out("chubing",t,level,num);
}

void start_game(int t,int level)
{
        remove_call_out("start_game");
        if( !clonep() || !query_owner() )
        {
                call_out("remove_map",1+random(2));
                return;
        }
        if( t>0 )
        {
                if( t<10 && level<=10 )
                        tell_room(this_object(),HIY"【边塞保卫】"+t+"秒钟后将有叛兵来袭！请做好准备！\n"NOR);
                t-= 5;
                call_out("start_game",0,t,level);
        }
        else
        {
                if( level<=10 )
                        tell_room(this_object(),HIY"【边塞保卫】第"+chinese_number(level)+"波叛兵来袭！\n"NOR);
                call_out("chubing",0,level,10);
        }
}

void begin()
{
        tell_room(this_object(),HIY"【边塞保卫】10秒钟后将有叛兵来袭！请做好准备！\n"NOR);
        start_game(10,1);
}

string Map = @LONG
 
            甲      乙      丙      丁      戊      己      庚      辛      壬
        ┌───┬───┬───┬───┬───┬───┬───┬───┬───┐
        │      │      │      │      │      │      │      │      │      │
        │ &8&0 │ &7&0 │ &6&0 │ &5&0 │ &4&0 │ &3&0 │ &2&0 │ &1&0 │ 城墙 │
        │      │      │      │      │      │      │      │      │      │
        ├───┼───┼───┼───┼───┼───┼───┼───┼───┤
        │      │      │      │      │      │      │      │      │      │
    $11$   &8&1    &7&1    &6&1    &5&1    &4&1    &3&1    &2&1    &1&1    &0&1    $22$
        │      │      │      │      │      │      │      │      │      │
        ├───┼───┼───┼───┼───┼───┼───┼───┼───┤
        │      │      │      │      │      │      │      │      │      │
        │ &8&2 │ &7&2 │ &6&2 │ &5&2 │ &4&2 │ &3&2 │ &2&2 │ &1&2 │ &0&2 │
        │      │      │      │      │      │      │      │      │      │
        └───┴───┴───┴───┴───┴───┴───┴───┴───┘

建造命令 build <坐标:甲、乙、丙、丁、戊、己、庚、辛、壬>        

LONG;

void init()
{
        object me = this_player();
        if( !clonep() )
                return;
        if( !query_owner() )
        {
                reset();
                return;
        }
        if( !userp(me) && me->is_td_evl() )
        {
                if( !me->query("x") && !me->query("y") )
                {
                        if( query("outs")=="west" ) //地图入口在右，怪物往左走
                        {
                                me->set("x",0);
                                me->set("y",1);
                        }       
                        else
                        {
                                me->set("x",8);
                                me->set("y",1);
                        }
                }       
        }               
        add_action("do_go","go");
        add_action("do_build","build");
        add_action("do_look","look");
        add_action("do_sheng","shengji");
        add_action("do_start","start");
}

int err_msg(string arg)
{
        write(arg);
        return 1;
}

int do_start()
{
        object me = this_player();
        if( !query_owner() || me!=query_owner() )
                return err_msg("不是你的地图。\n");
        if( query("start") )
                return err_msg("游戏已经开始了，加油加油。\n");
        CHANNEL_D->do_channel(this_object(),"chat",me->query("name")+"在边疆囤积精兵，开始抵御西域叛兵的攻击。");
        set("start",1);
        write("游戏开始，加油加油。\n");
        begin();
        me->command("look");
        return 1;
}                               

int check_zb(int x,int y)
{
        object *inv;
        int i;
        
        inv = all_inventory();
        for(i=0;i<sizeof(inv);i++)
        {
                if( inv[i]->query("x")==x 
                 && inv[i]->query("y")==y )
                        return 0;
        }
        return 1;
}                                 

int do_build(string arg)
{
        int x,y;
        string temp;
        object towner;
        if( !clonep() || !query("owner") || query("owner")!=this_player() )
                return 0;
        if( !arg )
                return err_msg("你要建造什么？\n");
        if( sscanf(arg,"%s",temp)!=1 )
                return err_msg("建造命令 build <坐标:甲、乙、丙、丁、戊、己、庚、辛、壬>\n");
        if( member_array(temp,keys(Zuob))==-1 )
                return err_msg("建造命令 build <坐标:甲、乙、丙、丁、戊、己、庚、辛、壬>\n");  
        x = Zuob[temp];         
        y = 0;          

        if( this_player()->query_temp("TD/G")<1 )  return err_msg("你没有足够的钱。\n");
        if( !check_zb(x,y) )
                return err_msg("这个坐标上已经有建筑物了。\n");
        towner = new(__DIR__"obj/towner");
        if( !towner )
                return err_msg("没有这种规格的塔。\n");
        towner->set("x",x);
        towner->set("y",y);
        towner->set("owner_id",this_player()->query("id"));
        towner->move(this_object());
        this_player()->add_temp("TD/G",-1);
        write(HIY"你建造了1级的"+towner->query("name")+"。你可以通过 look <坐标:甲、乙、丙、丁、戊、己、庚、辛、壬> 的命令来查看它。\n"NOR);
        this_player()->command("look");
        return 1;
}                       

int do_go(string arg)
{
        object owner,me = this_player();
        if( !clonep() )
                return 0;
        if( !owner=query_owner() )
        {
                reset();
                return 1;
        }
        if( userp(me) || !arg )
                return 0;
        if( !me->is_td_evl() )
                return 0;               
        if( query("outs")=="west" 
         && me->query("x")==8
         && me->query("y")==1 
         && arg=="west" )
        {
                message_vision("$N嗷嗷的吃药，终于冲破重重包围，冲进了中军帐中！\n"NOR,me);
                owner->add_temp("TD/HP",-1);
                me->leave();
                tell_room(this_object(),HIR"【边塞保卫】本军方阵收到了敌军的攻击"HIR"("+owner->query_temp("TD/HP")+HIR"！\n"NOR);
                if( owner->query_temp("TD/HP")<=0 )
                {
                        CHANNEL_D->do_channel(this_object(),"chat",owner->query("name")+"防守不力，致使"HIR"边疆失守"HIC"，真是气煞本将军！"NOR);
                        delete("owner");
                        owner->set_temp("TD/last_fail",time());
                        owner->move(sprintf("/d/shoucheng/broadway%d",1+random(6)));
                        message_vision("\n$N丢失了边疆一个防守点，灰溜溜的逃回了关内。\n",owner);
                        return 1;
                }
                return 1;
        }
        if( query("outs")=="east" 
         && me->query("x")==0
         && me->query("y")==1 
         && arg=="east" )
        {
                owner->add_temp("TD/HP",-1);
                me->leave();
                tell_room(this_object(),HIR"【边塞保卫】有1个单位的叛军杀进了中军帐"HIR"("+owner->query_temp("TD/HP")+")。\n"NOR);
                if( owner->query_temp("TD/HP")<=0 )
                {
                        CHANNEL_D->do_channel(this_object(),"chat",owner->query("name")+"防守不力，致使"HIR"边疆失守"HIC"，真是气煞本将军！"NOR);
                        delete("owner");
                        owner->set_temp("TD/last_fail",time());
                        owner->move(sprintf("/d/shoucheng/broadway%d",1+random(6)));
                        message_vision("\n$N丢失了边疆一个防守点，灰溜溜的逃回了关内。\n",owner);
                        call_out("remove_map",1+random(3));
                        return 1;
                }
                return 1;
        }
        switch(arg)
        {
                case "east" :
                        me->add("x",-1);break;
                case "west" :
                        me->add("x",1);break;
                default : return 0;
        }
        return 1;
}

int is_td_map(){ return 1; }

void reset()
{
        int i;
        object *inv,who;
        
        if( !clonep() )
        {
                ::reset();
                return;
        }
        
        who = query_owner();
        
        if( !who || !environment(who) || !environment(who)->is_td_map() )
        {
                inv = all_inventory();
                for(i=0;i<sizeof(inv);i++)
                {
                        if( !inv[i] )  continue;
                        if( !inv[i]->is_character() )
                                destruct(inv[i]);
                        if( !userp(inv[i]) )
                        {
                                inv[i]->remove_all_killer();
                                all_inventory()->remove_killer(inv[i]);
                                destruct(inv[i]);
                        }
                }
                remove_map();
                return;
        }
}

object query_zb(int x,int y)
{
        object *inv;
        int i;
        
        inv = all_inventory();
        for(i=0;i<sizeof(inv);i++)
        {
                if( inv[i]->query("x")==x 
                 && inv[i]->query("y")==y )
                        return inv[i];
        }
        return 0;
}
                        
int do_look(string arg)
{
        string str,msg,clr;
        object ta,*inv;
        int i,x,y;
        
        if( !clonep() || !query_owner() )
                return 0;
        if( arg && strsrch(arg,"ta")!=-1 )
                return err_msg("你要查看哪个塔？请用命令look <坐标:甲、乙、丙、丁、戊、己、庚、辛、壬>\n");
        if( arg )
        {
                if( member_array(arg,keys(Zuob))!=-1 )
                {
                        x = Zuob[arg];
                        y = 0;
                        ta = query_zb(x,y);
                        if( ta )
                        {
                                write(ta->long());
                                return 1;
                        }
                }
                return 0;               
        }

        msg = Map;              
        if( query("outs")=="west" )
        {
                msg = replace_string(msg,"$22$","入口");
                msg = replace_string(msg,"$11$","出口");
        }
        else
        {
                msg = replace_string(msg,"$11$","入口");
                msg = replace_string(msg,"$22$","出口");
        }
        
        inv = all_inventory();
        for(i=0;i<sizeof(inv);i++)
        {
                if( inv[i]->is_td_towner() )
                {
                        x = inv[i]->query("x");
                        y = inv[i]->query("y");
                        str = sprintf("&%d&%d",x,y);
                        switch(inv[i]->query("level"))
                        {
                                case 1 : clr = BLU"";break;
                                case 2 : clr = CYN"";break;
                                case 3 : clr = YEL"";break;
                                case 4 : clr = WHT"";break;
                                case 5 : clr = HIB"";break;
                                case 6 : clr = HIM"";break;
                                case 7 : clr = HIG"";break;
                                case 8 : clr = HIW"";break;
                                case 9 : clr = HIC"";break;
                                default : clr = HIY"";break;
                        }
                        msg = replace_string(msg,str,clr+inv[i]->query("name")+NOR);
                }
                else if( inv[i]->is_td_evl() )
                {
                        x = inv[i]->query("x");
                        y = inv[i]->query("y");
                        str = sprintf("&%d&%d",x,y);
                        msg = replace_string(msg,str,HIR"叛兵"NOR);
                }
        }
        
        for(i=0;i<=8;i++)
        {
                str = sprintf("&%d&0",i);
                msg = replace_string(msg,str,"空地");
                str = sprintf("&%d&2",i);
                msg = replace_string(msg,str,"城墙");
                str = sprintf("&%d&1",i);
                msg = replace_string(msg,str,"    ");
        }

        msg = "\n\t"NOR+YEL"空地"NOR+"表示为可建造的空地\n\t目前防守方有金钱"HIY+query_owner()->query_temp("TD/G")+"金"NOR+" 中军帐持久为:"HIY+query_owner()->query_temp("TD/HP")+NOR" "+msg;
        msg+= "注："NOR REV BLU" "NOR"1级 "NOR REV CYN" "NOR"2级 "NOR REV YEL" "NOR"3级 "NOR REV WHT" "NOR"4级 "NOR REV HIB" "NOR"5级 "NOR REV HIM" "NOR"6级 "NOR REV HIG" "NOR"7级 "NOR REV HIW" "NOR"8级 "NOR REV HIC" "NOR"9级 "NOR REV HIY" "NOR"10级及以上\n";
        this_player()->start_more(msg);
        return 1;
}


void finish_towner(object who,object towner)
{
        if( !who || !towner || environment(towner)!=environment(who) )
                return;
        towner->add("level",1);         //等级
        towner->add("damage",15);       //攻击力
        towner->add("attack",-1);       //攻击频率
        if( towner->query("attack")<=1 )
                towner->set("attack",1);
        towner->delete("build");        
        message_vision(HIG"$N"HIG"升级完成。\n"NOR,towner);
        return;
}    

int do_sheng(string arg)
{
        int i,g,t,x;
        object *inv,towner,me = this_player();
        if( !arg )
        {
                write("你要升级哪个塔？<坐标:甲、乙、丙、丁、戊、己、庚、辛>\n");
                return 1;
        }       
        if( member_array(arg,keys(Zuob))==-1 )
        {
                write("你要升级哪个塔？<坐标:甲、乙、丙、丁、戊、己、庚、辛>\n");
                return 1;
        }       
        x = Zuob[arg];
        
        inv = all_inventory();
        for(i=0;i<sizeof(inv);i++)
        {
                if( inv[i]->query("x")==x 
                 && inv[i]->query("y")==0 )
                {
                        towner = inv[i];
                        break;
                }                       
        }       
        
        if( !towner )
                return 0;       
        if( towner->query("build")=="doing" )
        {
                write(towner->query("name")+"正在升级中。\n");
                return 1;
        }
        g = towner->query("level")*10+5;
        if( me->query_temp("TD/G")<g )
        {
                write("你的钱不够。\n");
                return 1;
        }
        me->add_temp("TD/G",-g);
        write(towner->query("name")+"周身闪动光芒。。。\n");
        towner->set("build","doing");
        t = (towner->query("level")*3+5);
        call_out("finish_towner",t,me,towner);
        return 1;       
}
