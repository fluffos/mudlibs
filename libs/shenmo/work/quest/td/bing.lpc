#include <ansi.h>
inherit NPC;

void create() {
  set_name("叛兵", ({ "pan bing", "bing" }));
  set("age", 20 + random(20));
  set("per", 10 + random(10));
  set("combat_exp", 10000);
  set("daoxing", 5000);
  set("no_sleep", 1);
  set("level", 1);
  setup();
}

int is_td_evl() { return 1; }

varargs int receive_damage(string type, int damage, object who) {
  remove_all_killer();
  all_inventory(environment())->remove_killer(this_object());
  return ::receive_damage(type, 0, who);
}

varargs int receive_wound(string type, int damage, object who) {
  return ::receive_damage(type, 0, who);
}

void die() {
  powerup();
}

void unconcious() {
  die();
}

void leave() {
  set_heart_beat(0);
  destruct(this_object());
}

void heart_beat() {
  object who;
  string dir;
  int t;

  ::heart_beat();

  if (!environment())
    return;
  if (!environment()->is_td_map()) {
    message_vision("$N急急忙忙的离开了。\n", this_object());
    leave();
    return;
  }
  who = environment()->query("owner");
  if (!who || !present(who, environment())) {
    message_vision("$N急急忙忙的离开了。\n", this_object());
    leave();
    return;
  }

  if (time() < query_temp("TD/no_move")) {
    return;
  }

  if (query_temp("TD/HP") <= 0) {
    message_vision("$N惨叫一声“兄弟们，我完了~~\n", this_object());
    t = query("level") * 2 / 3 + 1;
    who->add_temp("TD/G", t);
    tell_object(who, HIY "【边塞保卫】你击退一单位的叛军，得到了" + chinese_number(t) + "金的奖励。\n" NOR);
    leave();
    return;
  }

  if (query("no_move"))
    delete("no_move");
  if (this_object()->is_busy()) {
    this_object()->start_busy(1, 10);
    this_object()->interrupt_me(this_object(), "免疫");
    this_object()->reset_action();
  }

  t = query("level");
  if (t < 1) t = 1;
  if (t > 10) t = 10;

  t = 10 - t + 1;
  t /= 2;

  if (time() >= query_temp("last_go") + t) {
    dir = environment()->query("outs");
    if (!dir) dir = "west";
    if (command("go " + dir)) {
      set_temp("last_go", time() + random(3));
      //                        message_vision("$N兴奋的高举大棒，狠命的朝前冲。。。。\n",this_object());       
    }
  }
}

string name() {
  int i;
  string str = ::name();
  i = query("num");
  if (i <= 0) i = 1;
  str = str + i + "(" HIR + query_temp("TD/HP") + NOR ")";
  return str;
}
