#include <ansi.h>
inherit NPC;

mapping Zuob = ([
        8 : "甲",
        7 : "乙",
        6 : "丙",
        5 : "丁",
        4 : "戊",
        3 : "己",
        2 : "庚",
        1 : "辛",
        0 : "壬",
]);

void create()
{
        set_name("箭塔", ({"jian ta","ta","towner"}));
        set_weight(100000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "箭塔。\n");
                set("unit", "个");
                set("level",1);         //等级
                set("damage",30);       //攻击力
                set("range",1);         //攻击距离
                set("target",1);        //攻击对象数                    
                set("attack",10);       //攻击频率
        }
        setup();
}

varargs int receive_damage(string type, int damage, object who)
{
        remove_all_killer();
        all_inventory(environment())->remove_killer(this_object());
        return ::receive_damage(type,0,who);
}

varargs int receive_wound(string type, int damage, object who)
{
        return ::receive_damage(type,0,who);
}

void die()
{
        powerup();
}

void unconcious()
{
        die();
}

void leave()
{
        set_heart_beat(0);
        destruct(this_object());
}

int check_range(object who)
{
        int v;
        if( !who || userp(who) || !who->is_td_evl() )
                return 0;
        v = query("x")-who->query("x");
        if( v<0 )
                v = -v;
        v+= 1;
        if( v>query("range") )
                return 0;
        return 1;
}               

void towner_attack(object who)
{
        string str;
        int damage;
        if( !who )
                return;
        if( who->query_temp("TD/HP")<=0 )
                return; 
        if( query("build")=="doing" )
                return;                 
        damage = query("damage");
        damage-= who->query_temp("TD/armor");
        if( damage<1 )
                damage = 1;
        str = name()+WHT"攻击"+who->name()+NOR WHT"，造成"NOR HIR+damage+NOR WHT"伤害。\n"NOR;
        tell_room(environment(),NOR WHT"【边塞保卫】"+str);
        who->add_temp("TD/HP",-damage);
        set_temp("last_attack",time());
}

void heart_beat()
{
        object *inv;
        int i;
        if( !environment() )
                return;
        if( !environment()->is_td_map() )
        {
                message_vision("$N慢慢消失了。\n",this_object());
                leave();
                return;
        }
        if( time()>=query_temp("last_attack")+query("attack") ) 
        {
                inv = all_inventory(environment());
                for(i=0;i<sizeof(inv);i++)
                {
                        if( inv[i] && !userp(inv[i])
                         && inv[i]->is_td_evl() 
                         && check_range(inv[i]) )
                                towner_attack(inv[i]);
                }
        }
        ::heart_beat();                         
}                                       

int is_td_towner(){ return 1;}          

int is_pet(){ return 1;}

string name()
{
        string tmp,str = ::name();
        int x = query("x");
        tmp = Zuob[x];
        str = "["+tmp+"]"+str+"(+"+query("level")+")";
         return str;
}

string long()
{
        string str = short();
        if( query("build")=="doing" ) str+= HIR"<升级中>"NOR;
        str+= "\n";
        str+= "\t等级 "+query("level")+"\n";
        str+= "\t攻击 "+query("damage")+"\n";
        str+= "\t距离 "+query("range")+"\n";
        str+= "\t对象 "+query("target")+"\n";
        str+= "\t速度 "+query("attack")+"\n";
        str+= "\t下次升级(shengji)需要"+(query("level")*10+5)+"金，"+(query("level")*3+5)+"秒\n";
        return str;
}

