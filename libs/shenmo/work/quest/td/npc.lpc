#include <ansi.h>
inherit NPC;

string check_player();

void create() {
  set_name("边塞将军", ({ "jiang jun", "jun" }));
  set("long", @LONG
守护边塞的一位将军，他们是最可爱的人。。。。
LONG);
  set("gender", "男性");
  set("nickname", "马革裹尸还");
  set("age", 45);
  set("combat_exp", 8000000);
  set_skill("blade", 800);
  set_skill("dodge", 800);
  set_skill("parry", 800);
  set_skill("wuhu-blade", 600);
  map_skill("blade", "wuhu-blade");
  set("max_sen", 200000);
  set("max_kee", 300000);
  set("inquiry", ([
    "守卫边疆": (: check_player :),
  ]));
  setup();
  carry_object("/d/obj/weapon/blade/blade")->wield();
  carry_object("/d/obj/cloth/bingfu")->wear();
}

string check_player() {
  int i;
  object *maps, me, newmap;

  me = this_player();

  if (time() < me->query_temp("TD/last_fail") + 900)
    return "你刚刚丢失了一个据点，还是先去学习学习用兵之道再说！";


  maps = children("/quest/td/map.lpc");
  for (i = 0; i < sizeof(maps); i++) {
    if (maps[i]->query("owner") == me)
      return "你是不是做了逃兵？！";
  }

  say(query("name") + "点了点头“我很欣慰。。。”\n");
  newmap = clone_object("/quest/td/map.lpc");
  if (random(2))
    newmap->set("outs", "west");
  else newmap->set("outs", "east");
  newmap->set("owner", me);
  message_vision("$N冲出兵营，头也不回的杀往边关而去。\n\n", me);
  me->set_temp("TD", ([
    "HP": 15,
    "G": 10,
  ]));
  me->move(newmap);
  tell_object(me, HIY "努力建造箭塔，待准备完毕后，输入" HIR "start" HIY "开始游戏。\n" NOR);
  return "边疆的日子不好过啊。";
}
