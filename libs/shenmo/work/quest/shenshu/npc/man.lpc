void create()
{
	mapping npc;
	string weapon;
	npc=data[random(sizeof(data))];
	weapon=npc["weapon"];

	set_name(npc["name"],({ npc["id"] }));
	set("age",20+random(30));
        set("combat_exp",200000+random(1000000));
	if( weapon)	set_skill("blade",20);
	set_skill("unarmed",20);
        set("tasknpc",1);
        set("任务",1);
        set("no_get",1);
	set_skill("sword",20);
	set_skill("whip",20);
	set_skill("throwing",20);
        set_skill("parry",800);
set("kee",40000+random(40000));
set("sen",40000+random(40000));
set("max_kee",40000+random(40000));
set("max_sen",40000+random(40000));
set("max_force",1000+random(2000));
set("max_mana",1000+random(2000));
set("mana",4000);
set("force",4000);
        set_skill("dodge",800);
        set_skill("force",800);
        set_skill("spells",800);
        set_skill("unarmed",800);
        set_skill("parry",800);
        set("chat_chance", 20);
        set("chat_msg", ({
                (: do_walk :),
                (: random_move :),
        }) );
        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
           (: random_move :),
           (: random_move :),
           (: random_move :),
        }) );

        set_temp("apply/attack", 200);
        set_temp("apply/defense", 200);
        set_temp("apply/armor", 200);
        set_temp("apply/damage", 200);

        setup();
        set("check_time", time());
        carry_object("/obj/cloth")->wear();
}
       
int do_walk()
{
        string start_room;
 string name,weapon;
        object room;
        object ob;
        mapping obmap;
        int n;
        int i;
	object *inv;
        if (! environment())
                return 0;
        name = color_title[random(sizeof(color_title))]+first_name[random(sizeof(first_name))];
        name += name_words[random(sizeof(name_words))]; 
//1800
//        if (time() - query("check_time") > 3600)
      if (time() - query("check_time") > 900 && random(100)>90 || !query_heart_beat(this_object()))
        {
       set_name((order[random(13)])+name, ({ "killer", "shashou", "sha shou" }));
       set("gender", "男性");
       set("class", "yao");
       set("title", color_title[random(sizeof(color_title))]);
        n = 0;
	inv = all_inventory(this_object());

	for (i = 0; i < sizeof(inv); i++)
        {
                if (inv[i]->query("dynamic_quest"))  {
name = inv[i]->query("name");
name = SDS_D->no_color_msg(name);
name = HIC+name+HIC;
name+= "我已经拿到手了。。。撤!!  \n"NOR;
name = SDS_D->color_msg(name);
CHANNEL_D->do_channel(this_object(),"chat",name,0,0);
     }
        }

                        message_vision("$N笑了笑说：东西已经到手，任务完成，撤了！\n"NOR, this_object());
                        destruct(this_object());
                        return 0;
        }

        n = 0;
        foreach (ob in all_inventory(environment()))
        {
                if (!ob)  continue;
                if (!ob->query("dynamic_quest"))
                        continue;
        command ("get all");
                n++;
        }

                        
//        random_move();
        return 1;
}

int accept_fight(object ob)
{
				command("say " + RANK_D->query_self(this_object())
					+ "怎么可能是" + RANK_D->query_respect(ob)
					+ "的对手？\n");
		  return 0;
}

int kill_ob(object ob)
{
    if( !ob || !environment() )  return 0;
		  command("fear");
		  command("say 不好，我被识破了!!");
if (random(3)==1)
{
command("say 逃啊!!");
if (random(2)==1)
{
command("go south");
command("go west");
}
else
{
command("go north");
command("go east");
}
}
if (ob->query("combat_exp") > 1500000)
{
set("kee",40000);
set("sen",40000);
set("max_kee",40000);
set("max_sen",40000);
}
		  return 1;
}



void init() 
{
       add_action("do_none","cast"); 
       add_action("do_none","ji"); 
}
int do_none() 
{
       object me = this_object(); 
        message_vision("这个对我没用，哈哈！\n",me); 
        return 1;
}
