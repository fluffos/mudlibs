#include <ansi.h>
inherit ITEM;
void create() {
  set_name("传奇系列" NOR, ({ "book" }));
  set("no_put", 1);
  set("value", 0);
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {

    set("unit", "本");
    set("material", "paper");
    set("long", "一本由神书合并成的卷册，你可以用(chayue)来查阅它。\n");
  }

  setup();
}
void init() {
  add_action("do_cha", "chayue");
}
int do_cha() {
  object me;
  int exp, pot, score;
  me = this_player();
  exp = 7500 + random(7500);
  pot = exp / 6;
  score = 7500 + random(7500);
  me->add("combat_exp", exp);
  me->add("potential", pot);
  me->add("daoxing", score);
  me->add("shen", 60);
  message_vision("$N仔细地查阅了一遍" + this_object()->query("name") + "。\n", me);
  tell_object(me, "你被奖励了：\n" +
    chinese_number(60) + "点神\n" +
    chinese_number(exp) + "点实战经验\n" +
    chinese_number(pot) + "点潜能\n" +
    chinese_number(score) + "天道行\n");
  destruct(this_object());
  return 1;
}
