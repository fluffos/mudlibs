
#include <ansi.h>
inherit ITEM;
void create()
{
    set_name(HIY"古龙精选集"NOR, ({ "gulong book" }) );
            set("no_put", 1);
            set("shenshu", 1);
            set("value", 0);
    set_weight(1);
    if( clonep() )
            set_default_object(__FILE__);
    else {
            set("unit", "本");
            set("material", "paper");
            set("long", "一本由神书合并成的卷册，你可以用(chayue)来查阅它。\n");
          }
    setup();
}
void init()
{
   add_action("do_cha","chayue");
}
int do_cha(string arg)
{
	object me,ob;
	int exp,pot,score,i;
	me =this_player();
 	if (!id(arg))
	return notify_fail("你要查什么？\n");
        ob=new(__DIR__"sdan");
        ob->move(me);
        ob=new(__DIR__"sdan");
        ob->move(me);
        ob=new(__DIR__"sdan");
        ob->move(me);
message("channel:rumor", HIM"【千里眼】某人：听说"+me->query("name")+HIM"得到三颗"+ob->query("name")+HIM"啦！\n"NOR,users() );
        if(random(100)>98 && me->query("wuhu_ask")==1 && me->query("wuhu_agree")==0) 
        {
        me->set("wuhu_ask",0);tell_object(me,HIM"你似乎从古龙精选集中悟出了关于五虎断门刀的一些窍门。\n"NOR);
message("channel:rumor",HIM"【顺风耳】某人：听说"+me->query("name")+HIM"从古龙精选集之中似乎对"HIR"五虎断门刀"HIM"若有所悟！\n",users() );
        }
        if(random(100)>98 && me->query("chshjue_ask")==1 && me->query("chshjue_agree")==0) 
        {
        me->set("chshjue_ask",0);tell_object(me,HIM"你似乎从古龙精选集中悟出了关于长生诀的一些窍门。\n"NOR);
message("channel:rumor",HIM"【顺风耳】某人：听说"+me->query("name")+HIM"从古龙精选集之中似乎对"HIW"长生诀"HIM"若有所悟！\n",users() );
        }
	destruct(this_object());
return 1;
}
