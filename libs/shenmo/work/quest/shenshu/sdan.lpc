#include <ansi.h>
inherit ITEM;

void setup()
{}

void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name(HIY"九转金丹"NOR, ({"jin dan", "jindan"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                set("long", "一颗金灿灿的九转金丹，相传为孙悟空大闹天宫时打翻了丹炉而掉落凡间的。\n");
                set("value", 50000);
set("no_pawn",1);
        }
        setup();
}

int do_eat(string arg)
{
        int exp,pot,score;
        object me = this_player();
        object ob = new("/obj/money/jinbi");
        ob->set_amount(1+random(2));
        if (!id(arg))
        return notify_fail("你要吃什么？\n");

        exp = 50000+random(30000);
                     pot = exp/3;
        score = 50000+random(30000);
             me->add("combat_exp",exp);
             me->add("potential",pot);
             me->add("daoxing",score);
             me->add("shen",200);
tell_object(me,HIY"你被奖励了：\n" +
             chinese_number(200) + "点神\n"+
             chinese_number(exp) + "点实战经验\n"+
             chinese_number(pot) + "点潜能\n" +
            chinese_number(score)+"天道行\n"NOR);
/*
             if (random(100)>80 && me->query("level")<999)
                {
                me->add("level", 1);
                tell_object(me,HIY"另外，你的等级也得到了提升！\n"NOR);
message("channel:rumor",HIG+"\n【"+HIR" 神书传说 "NOR+HIG"】某人："+me->query("name")+"通过"+HIY"九转金丹"NOR+HIG"提升了自己的等级！\n"+NOR,users() );
                }
*/
        ob->move(this_player());
tell_object(me,HIY"你被奖励了一些金币。\n" NOR);
        message_vision(HIG "$N吃下一颗九转金丹，只觉得浑身四肢百骸舒泰无比，好像变了一个人似的!\n" NOR, me);

        
        destruct(this_object());
        return 1;
}

