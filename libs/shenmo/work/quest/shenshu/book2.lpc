#include <ansi.h>
inherit ITEM;
void create()
{
    set_name(RED"书剑恩仇录"NOR, ({ "sjec" }) );
            set("no_put", 1);
            set("value", 0);
    set_weight(1);
            set("dynamic_quest", 1);
    if( clonep() )
            set_default_object(__FILE__);
    else {
	        
            set("unit", "本");
            set("material", "paper");
            set("long", "神书之一。记载了清朝乾隆年间红花会的故事。\n");
          }

    setup();
}


