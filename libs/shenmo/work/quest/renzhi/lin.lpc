//creat by wsw 2005.11.2
//迷宫

#include <ansi.h>
inherit __DIR__ "vrm_server";


void create() {
  // 迷宫房间所继承的物件的档案名称。
  set_inherit_room(ROOM);

  //迷宫的单边长
  set_maze_long(5);

  //入口方向(出口在对面)
  set_entry_dir("south");

  //入口与区域的连接方向
  set_link_entry_dir("south");

  //入口与区域的连接档案名
  set_link_entry_room(__DIR__ "linentry");

  //出口与区域的连接方向
  set_link_exit_dir("north");

  //出口与区域的连接档案名
  set_link_exit_room(__DIR__ "linexit");

  //入口房间短描述
  set_entry_short("入口");

  //入口房间描述
  set_entry_desc(@LONG
穿过一条小路，你又进入了一片更加茂密的树林，林中白雾迷漫，
让人分不清东南西北。
LONG
  );

  //出口房间短描述
  set_exit_short("出口");

  //出口房间描述
  set_exit_desc(@LONG
出口房间长描述。
LONG
  );

  //迷宫房间的短描述
  set_maze_room_short("密林");

  //迷宫房间的描述，如果有多条描述，制造每个房
  //间的时候会从中随机选择一个。
  set_maze_room_desc(@LONG
迷宫房间的长描述(可以多个)。
LONG
  );

  remove_call_out("reset");
  call_out("reset", 600);

}

void reset() {
  string msg, *files;

  //不更新的ＮＰＣ列表
  files = ({
    __DIR__ "npc/renzhi",
    __DIR__ "npc/yg-putuo",
    __DIR__ "npc/yg-moon",
    __DIR__ "npc/yg-wzg",
    __DIR__ "npc/yg-shushan",
    __DIR__ "npc/yg-hyd",
    __DIR__ "npc/yg-fangcun",
    __DIR__ "npc/yg-hell",
    __DIR__ "npc/yg-jjf",
    __DIR__ "npc/yg-pansi",
    __DIR__ "npc/yg-kunlun",
    __DIR__ "npc/yg-dragon",
    __DIR__ "npc/yg-xueshan",
    __DIR__ "npc/yg-sanxian",
    __DIR__ "npc/yg-wudidong",
  });


  msg = HIW "    突然一阵浓雾升起，铺天盖地的从远处涌来，一切都被遮蔽了，\n雾散处，一切都变了样。\n" NOR;
  ::reset(files, msg);
  remove_call_out("reset");
  call_out("reset", 600);
}
