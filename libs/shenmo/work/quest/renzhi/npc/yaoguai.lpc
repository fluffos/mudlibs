int random_place(object me, string *dirs);

void setname() {
  mapping name;
  string title, temp_title;
  int i;
  i = random(100);
  if (i > 68) {
    name = NAME_D->random_name("male");
    temp_title = TITLE_D->random_title("male");
  } else if (i > 35) {
    name = NAME_D->random_name("female");
    temp_title = TITLE_D->random_title("female");
  } else if (i > 4) {
    name = NAME_D->random_name("yaoguai");
    temp_title = TITLE_D->random_title("yaoguai");
  } else {
    name = NAME_D->random_name("japan");
    temp_title = TITLE_D->random_title("japan");
  }
  set_name(name["name"], name["id"]);
  title = COLOR_D->random_color(
    ((random(10) > 5) ? 3 : 4),
    ((random(10) < 8) ? 0 : 1)
  ) + temp_title + NOR;
  set("title", title);
}



void create() {
  setname();
  set("age", 14 + random(10));
  set("gender", random(2) ? "男性" : "女性");
  set("attitude", "heroism");
  set("per", 40);
  set("str", 30);
  set("cor", 40);
  set("con", 40);
  set("int", 40);
  set("spi", 40);
  set("cps", 40);
  set("kar", 40);
  set("max_gin", 1000);
  set("food", 10000);
  set("water", 10000);
  set_weight(30000);
  set("no_steal", 1);
  set("faith", 1000);
  set_temp("apply/courage", 100);
  set("chat_chance", 5);
  set("env/wimpy", 0);
  setup();
}

int random_place(object me, string *dirs) {
  int i, j, k;
  object newob;
  mixed *file, exit;
  string files = "/quest/renzhi/lin";

  newob = load_object(files);
  if (!newob) return 1;

  newob = load_object(sprintf("%s/%d/%d", files, random(5), random(5)));
  if (!newob) return 1;
  if (me->move(newob)) {
    message_vision("$N一帮人拖着人质走了过来。\n", me);
    return 1;
  }
  return 0;

  if (!sizeof(dirs)) return 1;

  i = random(sizeof(dirs));    // pick up one directory

  file = get_dir(dirs[i] + "/*.lpc", -1);
  if (!sizeof(file)) return 1;

  for (k = 0; k < 30; k++) {  // try 20 times
    j = random(sizeof(file));
    if (file[j][1] > 0) {
      newob = load_object(dirs[i] + "/" + file[j][0]);
      if (newob) {
        if (newob->query("no_fight") ||
          newob->query("no_magic") ||
          newob->query("no_mieyao") ||
          !(exit = newob->query("exits")) ||
          sizeof(exit) < 1)
          continue;

        if (me->move(newob)) {
          message_vision("$N一帮人拖着人质走了过来。\n", me);
          return 1;
        }
      }
    }
  }

  return 0;
}


string invocation(object who, int level) {
  object guai, env;
  string *dirs, where;

  dirs = dirs1;
  guai = this_object();

  set("owner_id", who->query("id"));
  set("owner", who);

  if (!random_place(guai, dirs)) return "没妖怪。";

  env = environment(guai);
  where = guai->query("name");
  copy_status(this_object(), who, level);
  return where;

}

void copy_status(object me, object ob, int lv) {
  int i, k, *level, max_level, skill_force;
  int max_kee, max_sen, force, maximum_mana, daoxing, exp;
  mapping ob_skills;

  ob_skills = ob->query_skills();
  i = sizeof(ob_skills);
  max_level = 1;
  if (i > 0) {
    level = values(ob_skills);
    while (i--) {
      if (level[i] > max_level) max_level = level[i];
    }
  }

  set_skills(max_level + max_level * (lv - 3) / 10, lv);

  if (lv < 1) lv = 1;
  max_kee = ob->query("max_kee");
  max_sen = ob->query("max_sen");
  skill_force = query_skill("force");
  maximum_mana = ob->query("maximum_mana");
  if (maximum_mana < ob->query("maximum_force"))
    maximum_mana = ob->query("maximum_force");
  exp = ob->query("combat_exp");
  daoxing = ob->query("daoxing");

  set("max_force", skill_force * 10);
  set("force", skill_force * 20);
  set("force_factor", skill_force / 2);
  set("mana_factor", query_skill("spells", 1));

  set("max_kee", max_kee + max_kee * (lv - 1) / 2);
  set("eff_kee", max_kee + max_kee * (lv - 1) / 2);
  set("max_sen", max_sen + max_sen * (lv - 1) / 2);
  set("eff_sen", max_sen + max_sen * (lv - 1) / 2);
  set("sen", max_sen + max_sen * (lv - 1) / 2);
  set("kee", max_kee + max_kee * (lv - 1) / 2);
  set("max_mana", maximum_mana + maximum_mana * (lv - 1) / 2);
  set("mana", maximum_mana + maximum_mana * (lv - 1));
  set("combat_exp", exp + exp * (lv - 3) / 10);
  set("daoxing", daoxing + daoxing * (lv - 3) / 10);
  set_temp("apply/armor", 400 + 300 * (lv - 3) / 10);
  set_temp("apply/damage", 180 + 300 * (lv - 3) / 10);

}

int accept_fight(object ob) {
  command("say " + RANK_D->query_self(this_object())
    + "怎么可能是" + RANK_D->query_respect(ob)
    + "的对手？\n");
  return 0;
}


void init() {
  int i, level, steps, times;
  object me, who, bangxiong, weapon;
  string martial, skill;
  me = this_object();
  who = this_player();

  if (!me->query("owner_id")) {
    destruct(me);
    return;
  }
  if (me->query("owner_id") != who->query("id")) {
    add_action("do_kill", "team kill");
    add_action("do_kill", "kill");
    add_action("do_kill", "hit");
    add_action("do_kill", "fight");
    add_action("do_kill", "touxi");
    add_action("do_kill", "steal");
    add_action("do_kill", "beg");
    add_action("do_kill", "persuade");
    add_action("do_kill", "apprentice");
    add_action("do_kill", "recruit");
    return;
  }

  if (base_name(environment(me)) == VOID_OB)
    return;

  if (me->query("boss")) {  //喽罗直接杀
    me->kill_ob(who);
    return;
  }

  //steps 1,刚领任务，2，照过面不知道门派，3，知道门派后未照面，
  //4，知道门派后已照面,5,任务完成
  steps = who->query_temp("renzhi/steps");
  switch (steps) {
    case 1:
    case 2:
      me->fight_ob(who);
      who->fight_ob(me);
      //下面应改为三种攻击模式：普通攻击、pfm、cast
      weapon = me->query_temp("weapon");
      COMBAT_D->do_attack(me, who, me->query_temp("weapon"), 0);
      me->command("halt");

      message_vision(HIB "$n一看到$N, 不由分说，抄出家伙给你一记后，立马溜之大吉！\n" NOR, who, me);
      //message_vision(HIB"$n的门派是:"+me->query("family/family_name")
      //	+"。武器是"+weapon->query("name")+",技能类型："+weapon->query("skill_type")+"！\n"NOR,who,me); 
      random_place(me, dirs1);
      who->set_temp("renzhi/steps", 2);
      break;
    case 3:
      level = who->query_temp("renzhi/level");
      message_vision(HIB "$n一看到$N，冷笑了一声: “又一个活得不耐烦的家伙，自寻死路！” \n" NOR, who, me);

      //根据等级产生帮凶
      if (level > 1) message_vision(HIB "$n高声叫道：大家并肩子上啊！” \n" NOR, who, me);
      i = 1;
      while (i < level) {
        bangxiong = new(__DIR__ + list[random(sizeof(list))]);
        bangxiong->invocation(who, i);
        bangxiong->set("boss", me->query("id"));  //头目还是应该有的
        bangxiong->set("title", HIR + me->query("name") + "的喽罗" NOR);
        bangxiong->move(environment(me));
        message_vision(HIW + bangxiong->query("name") + "跳了出了，叫道：你活得不奈烦了！” \n" NOR, who, me);
        bangxiong->kill_ob(who);
        bangxiong->set_leader(me);
        bangxiong->command("protect " + me->query("id"));
        //定义消失时间，与头目同步
        times = me->query_temp("leave_time") - time();
        if (times < 1) times = 1;
        bangxiong->leave(who, times);
        i++;
      }
      //产生人质
      bangxiong = new(__DIR__ "renzhi");
      bangxiong->set("waiting", who->query("id"));
      bangxiong->set("title", HIC + who->query("name") + "搭救的人质");
      bangxiong->move(environment(me));
      me->set_leader(bangxiong);
      me->set("renzhi", bangxiong);
      bangxiong->set_leader(me);
      //定义消失时间，与头目同步
      times = me->query_temp("leave_time") - time();
      if (times < 1) times = 1;
      bangxiong->leave(who, times);

      who->set_temp("renzhi/steps", 4);
    case 4:
      who->kill_ob(me);
      me->kill_ob(who);
    default:
      return;
  }
}


int do_kill(string arg) {
  string what, who;
  if (!arg) return 0;
  if (this_object()->id(arg)) {
    write("江湖人士，还是少惹为妙。\n");
    return 1;
  } else if (sscanf(arg, "%s from %s", what, who) == 2 && this_object()->id(who)) {
    write("还是到别处去施展你的本事吧。\n");
    return 1;
  }
  return 0;
}
void leave(object who, int times) {
  remove_call_out("_leave");
  call_out("_leave", times, this_object(), who);
  //如果是头目，定义消失时间，让喽罗同步消失
  if (!query("boss")) set_temp("leave_time", time() + times);
}
void _leave(object me, object who) {
  if (!me) return;
  if (!environment(me)) {
    destruct(me);
    return;
  }
  if (me->query("boss")) {  //喽罗直接消失
    destruct(me);
    return;
  }
  message_vision("$N狞笑了几声：“今天又绑了一票，大赚了一笔，撤了，说罢，不知去向。\n", me);
  tell_object(who, HIC "绑匪" + me->query("name") + "挟持人质逃走了，任务失败。\n" NOR);
  //remove_call_out("kill_baixing");  
  destruct(me);
}

void die() {
  int i, exp_r, dx_r, pot_r, count, lvl;
  object boss, me, renzhi, *bangxiong, who;
  string *dir, file, msg;
  object equip;
  // string msg;

  me = this_object();

  //如果有喽罗在，喽罗救头目
  if (me->query("boss")) {
    message_vision(HIC "$N惨嚎一声，口喷鲜血，到在地上死了。\n" NOR, me);
    destruct(me);
    return;
  } else {
    bangxiong = all_inventory(environment(me));
    for (i = 0; i < sizeof(bangxiong); i++) {
      if (bangxiong[i]->query("boss") == me->query("id")) {
        message_vision(HIC "$N不顾一切地冲上来挡住了对" + me->query("name") + "的致命一击。\n"
          + "$n趁机回复了体力，重新加入战斗。\n" NOR, bangxiong[i], me);
        me->set("kee", me->query("max_kee"));
        me->set("sen", me->query("max_sen"));
        me->set("max_kee", me->query("max_kee"));
        me->set("max_sen", me->query("max_sen"));
        me->set("eff_kee", me->query("max_kee"));
        me->set("eff_sen", me->query("max_sen"));
        return;
      }
    }
  }

  who = me->query_temp("last_damage_from");
  message_vision(HIC "$N惨嚎一声，口喷鲜血，到在地上死了。\n" NOR, me);
  if (objectp(renzhi = query("renzhi"))) destruct(renzhi);
  if (!who) return;
  if (me->query("owner_id") != who->query("id"))
    return;

  count = 1000;
  lvl = who->query_temp("renzhi/level");
  if (lvl < 1) lvl = 1;
  i = 1;
  while (--lvl) i *= 2;  //成倍增长
  if (i > 32) i = 32;  //暂时限制
  count *= i;

  msg = HIY "由于你的卓越表现，成功的解救了人质！\n" NOR;
  who->set_temp("renzhi/steps", 5);

  tell_object(who, msg);
  exp_r = count;
  dx_r = count;
  pot_r = count / 3;
  who->add("combat_exp", exp_r);
  who->add("daoxing", dx_r);
  who->add("potential", pot_r);
  msg = CHINESE_D->chinese_number(exp_r) + "点『武学』"
    +COMBAT_D->chinese_daoxing(dx_r) + "『道行』" +
    CHINESE_D->chinese_number(pot_r) + "点『潜能』！\n";
  tell_object(who, HIW + "你获得了" + msg + NOR);
  MONITOR_D->report_system_object_msg(
    who,
    "[搭救人质]" + exp_r + " exp " + dx_r + " dx " + pot_r + " pot."
  );
  CHANNEL_D->do_channel(who, "rumor", who->query("name") + "完成了搭救人质任务，得到了" + msg);

  destruct(me);
  return;
}


void heart_beat() {
  object ob = this_object();
  object me = ob->query("owner_ob");
  int i, k, myexp;
  int j = 0;

  ::heart_beat();

  //tell_object(me,HIM"***************(1)************\n");
  if (!is_fighting()
    && query("eff_kee") >= query("max_kee") / 2
    && query("eff_kee") < query("max_kee")) {
    if (!query_skill("zixia-shengong", 1))
      command("exert heal");
    else command("exert ningshen");
  }
  //tell_object(me,HIM"***************(2)************\n");
  if (query("kee") < query("eff_kee") - 10 && random(2) == 0)
    command("exert recover");
  if (query("sen") < query("eff_sen") - 10 && random(2) == 0)
    command("exert refresh");
  if (query("force") < query("max_force") && random(3) == 0)
    command("cast transfer");
  //tell_object(me,HIM"***************(3)************\n");

  if (!living(ob)) return;
  if (!me)
    me = offensive_target(ob);
  if (!me) return;
  if (!is_fighting()) return;
  myexp = ((int)me->query("combat_exp", 1) + (int)me->query("daoxing", 1)) / 2;
  if (myexp < 4000000) i = 2;
  else i = to_int(myexp / 4000000) + 2;
  if (i > 5) i = 5;
  //tell_object(me,HIM"***************(4)************\n");
  if (tick--) return;
  else tick = 3 + random(2);
  //tell_object(me,HIM"***************(5)************\n");

  k = random(i + j);
  if (wizardp(me) && me->query("env/combat") == "verbose")
    tell_object(me, sprintf(HIM + BLINK + "i: %d  k: %d\n" NOR, i, k));
  //tell_object(me,HIM"***************(6)************"+k+"\n");

  switch (query("family/family_name")) {
    case "方寸山三星洞":
      if (!ob->query_temp("jldl") && me->query_skill("force") > 249) command("exert jldl");
      if (k > 6) k = 6;
      switch (k) {
        case 0:
          command("perform pili on " + me->query("id"));
          command("perform pili"); break;
        case 1:
          command("perform qiankun on " + me->query("id"));
          command("perform qiankun"); break;
        case 2:
          command("perform wu on " + me->query("id"));
          command("perform wu"); break;
        case 3:
          command("perform qizhi on " + me->query("id"));
          command("perform qizhi"); break;
        case 4:
          command("perform panlong on " + me->query("id"));
          command("perform panlong"); break;
        case 5:
          command("perform stick on " + me->query("id"));
          command("perform stick"); break;
        case 6:
          command("perform yin on " + me->query("id"));
          command("perform yin"); break;
        default: return 0;
      }
      break;

    case "阎罗地府":
      if (!ob->query_temp("ldlh") && me->query_skill("force") > 249) command("perform ldlh");
      if (k > 6) k = 6;
      switch (k) {
        case 0:
          command("perform cmwl on " + me->query("id"));
          command("perform cmwl"); break;
        case 1:
          command("perform three on " + me->query("id"));
          command("perform three"); break;
        case 2:
          command("perform lianyu on " + me->query("id"));
          command("perform lianyu"); break;
        case 3:
          command("perform xingyun on " + me->query("id"));
          command("perform xingyun"); break;
        case 4:
          command("perform yanluo on " + me->query("id"));
          command("perform yanluo"); break;
        case 5:
          command("perform ymqt on " + me->query("id"));
          command("perform ymqt"); break;
        case 6:
          command("perform zhua on " + me->query("id"));
          command("perform zhua"); break;
        default: return 0;
      }
      break;

    case "火云洞":
      if (!ob->query_temp("ldlh") && me->query_skill("force") > 249) command("perform shenli");
      if (k > 6) k = 6;
      switch (k) {
        case 0:
          command("perform zhangxinlei on " + me->query("id"));
          command("perform zhangxinlei"); break;
        case 1:
          command("perform baiyun on " + me->query("id"));
          command("perform baiyun"); break;
        case 2:
          map_skill("spear", "huoyun-qiang");
          command("perform lihuo on " + me->query("id"));
          command("perform lihuo"); break;
        case 3:
          map_skill("spear", "wuyue-spear");
          command("perform buhui on " + me->query("id"));
          command("perform buhui"); break;
        case 4:
          map_skill("spear", "wuyue-spear");
          command("perform fengchan on " + me->query("id"));
          command("perform fengchan"); break;
        case 5:
          command("perform mantian on " + me->query("id"));
          command("perform mantian"); break;
        case 6:
          map_skill("spear", "huoyun-qiang");
          command("perform dian on " + me->query("id"));
          command("perform dian"); break;
        default: return 0;
      }
      break;

    case "将军府":
      if (!ob->query_temp("powerup") && me->query_skill("force") > 149) command("exert jingxin");
      if (!ob->query_temp("bawang") && me->query_skill("bawang-qiang") > 199) command("perform ba");
      if (k > 7) k = 7;
      switch (k) {
        case 0:
          map_skill("mace", "wusi-mace");
          command("perform andu on " + me->query("id"));
          command("perform andu"); break;
        case 1:
          command("perform meihua on " + me->query("id"));
          command("perform meihua"); break;
        case 2:
          command("perform huima on " + me->query("id"));
          command("perform huima"); break;
        case 3:
          command("perform sanban on " + me->query("id"));
          command("perform sanban"); break;
        case 4:
          command("perform zhuiming on " + me->query("id"));
          command("perform zhuiming"); break;
        case 5:
          map_skill("mace", "jinglei-mace");
          command("perform jueming on " + me->query("id"));
          command("perform jueming"); break;
        case 6:
          map_skill("mace", "jinglei-mace");
          command("perform tian on " + me->query("id"));
          command("perform tian"); break;
        case 7:
          command("perform zhiqi on " + me->query("id"));
          command("perform zhiqi"); break;
