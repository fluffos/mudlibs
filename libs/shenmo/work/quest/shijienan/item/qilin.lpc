#include <ansi.h>
#include <armor.h>
#include <dbase.h> 
inherit BOOTS; 
inherit F_AUTOLOAD;
inherit F_SAVE;
inherit F_BACKUP;
void create()
{
seteuid(0);
set_name(HIY "麒麟飞靴" NOR, ({"qilin feixue", "feixue"}));
set_weight(2000);
if( clonep() ) 
set_default_object(__FILE__);
else
{
set("long", HIY"灵兽麒麟幻化成的一件圣物。\n"NOR);
set("material", "leather"); 
set("unit", "双");
set("value_c", 20); 
set("no_get", 1);
set("no_give", 1);
set("no_drop", 1);
set("no_put", 1);
set("wear_msg",HIY"从上方的天际传来一声兽吼，$N足底一片金芒闪烁。\n"NOR);  
set("unequip_msg",HIY"$N足底金芒渐淡，$n"HIY"踪迹皆无。\n"NOR);
set("no_break", 1);
set ("armor_prop/dodge", 200);
set("armor_prop/armor", 250);
}
setup();
}
int save()
{
return ::save();
}
void setup()
{
::setup();
}
int query_unique()  { return 1; }
int query_autoload() { return 1; }
