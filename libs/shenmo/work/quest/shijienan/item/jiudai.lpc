
inherit ITEM;
#include <ansi.h>
int do_fu(string arg);
void create()
{
   set_name(HIR"毒酒"NOR, ({ "du jiudai","jiudai" }));
   set_weight(100);
   set("unit", "袋");
   set("long","这是含有剧毒的酒袋，喝下它(drink jiudai)真的会死人哦！\n");
   set("value", 500000);
  
   set("no_save",1);
}

void init()
{
	add_action("do_fu","drink");
}
int do_fu(string arg)
{
	object me,ob;int i;
	ob=this_object();me=this_player();
	if(!arg||(arg!="jiudai"&&arg!="酒袋"))
		return notify_fail("你要喝什么?\n");
	message_vision("$N喝下了一袋[毒酒].\n",me);
if(random(10)>8)
{
message_vision("$N竟然生龙活虎，活蹦乱跳。\n",me);
me->add("max_force",10);
}else{
me->die();
	destruct(ob);
	return 1;
}
}