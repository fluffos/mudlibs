#include <ansi.h>
inherit ITEM;
void create() {
  set_name(HIW "正气丹" NOR, ({ "zq dan", "dan" }));
  set("unit", "粒");
  set("long", "增加正气值的丹药(eat)。\n");
  set_weight(3000);
  set("value_c", 20);
  set("no_sell", 1);
  set("no_put", 1);
  set("no_give", 1);
  set("no_steal", 1);
  setup();
}
void init() {
  add_action("do_eat", "eat");
  add_action("do_give", "give");
}
int err_msg(string arg) {
  write(arg);
  return 0;
}
int do_eat(string arg) {
  object me;
  int my_zqd;
  int sub_zqd;
  me = this_player();
  if (!present(this_object(), me)) return 0;  //这个必须有，不然不get就可以用了
  if (me->is_busy()) return notify_fail("你正忙着呢。\n");  //不加的话就是第二个凤凰琴了
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  my_zqd = me->query("tianlongzhan/zhengqi_point");
  sub_zqd = sub_zqd + 2;
  me = this_player();

  message("channel:rumor", HIM "【顺风耳】某人：听说" + me->name() + HIM "增加了2点正气值\n" NOR, users());
  me->set("tianlongzhan/zhengqi_point", my_zqd + 2);
  me->start_busy(1 + random(3));
  me->save();
  destruct(this_object());
  return 1;
}
