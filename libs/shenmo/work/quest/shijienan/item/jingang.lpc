
inherit ITEM;
#include <ansi.h>

int do_fu(string arg);
void create()
{
   set_name(HIG"金刚丸"NOR, ({ "jin gang","wan" }));
   set_weight(100);
   set("unit", "粒");
   set("long","传说这是由四大金刚合力练成的丹药,服用(fu wan)它能让你瞬间坚如钢铁.\n");
   set("value", 5000000);
   set("no_give",1);
   set("no_drop",1);
   set("no_sell",1);
   
}

void init()
{
	add_action("do_fu","fu");
}
int do_fu(string arg)
{
	object me,ob;int i;
	ob=this_object();me=this_player();
	if(!arg||(arg!="wan"&&arg!="丸"))
		return notify_fail("你要服用什么?\n");
if(me->query("jingang_temp")>0)
return notify_fail("吃太多会爆体而亡的!\n");
              me->add_temp("apply/parry",200);
              me->set("jingang_temp",1);
 message_vision("$N服下了一粒[金刚丸]，感觉到身体坚如钢铁，刀砍不破，枪刺不穿。\n",me);	
call_out("dodel",10,me);
destruct(ob);
	return 1;
}

void dodel( )
{
object me;
me=this_player();
message_vision("$N感觉到金刚丸的效果消失了！\n",me);
 me->add_temp("apply/parry",-200);
me->set("jingang_temp");

return;
}
