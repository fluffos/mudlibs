#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob;
  string rep, str;

  seteuid(getuid(me));

  if (!arg)
    ob = me;
  else if (wizardp(me)) {
    ob = present(arg, environment(me));
    if (!ob) ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) return notify_fail("你要察看谁的状态？\n");
  } else
    return notify_fail("只有巫师能察看别人的状态。\n");

  rep = "\n";
  rep += "欢迎光临西游记--神魔传说 218.65.213.22 6666\n";
  rep += "┌──────────────────────┬─────────┐\n";
  rep += sprintf("│生产技能总表                                │相应技能经验值    │\n");
  rep += "├──────────────────────┴─────────┤\n";
  rep += sprintf("│矿石挖掘技术                                │" + ob->query("work/wakuang") + "\n");
  rep += "├──────────────────────┴─────────┤\n";
  rep += sprintf("│造剑技术                                    │" + ob->query("work/zhujian") + "\n");
  rep += "├──────────────────────┴─────────┤\n";
  rep += sprintf("│造刀技术                                    │" + ob->query("work/zhublade") + "\n");
  rep += "├──────────────────────┴─────────┤\n";
  rep += sprintf("│造枪技术                                    │" + ob->query("work/zhuspear") + "\n");
  rep += "├──────────────────────┴─────────┤\n";
  rep += sprintf("│造棒技术                                    │" + ob->query("work/zhustick") + "\n");
  rep += "├──────────────────────┴─────────┤\n";
  rep += sprintf("│造叉技术                                    │" + ob->query("work/zhufork") + "\n");
  rep += "├──────────────────────┴─────────┤\n";
  rep += sprintf("│造杖技术                                    │" + ob->query("work/zhustaff") + "\n");
  rep += "├──────────────────────┴─────────┤\n";
  rep += sprintf("│造鞭技术                                    │" + ob->query("work/zhuwhip") + "\n");
  rep += "└────────────────────────────────┘\n\n";
  rep += "欢迎光临西游记--神魔传说 218.65.213.22 6666\n";
  write(rep);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : skills1
           skills1 <对象名称>                   (巫师专用)
这个指令用来查看你在西游记--神魔传说上的攻击武器制造技能列表 

HELP
  );
  return 1;
}
