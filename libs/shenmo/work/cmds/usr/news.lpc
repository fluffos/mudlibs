// news.c 
// snowtu修改已读数目出错的bug
#include <ansi.h>; 
inherit BULLETIN_BOARD; 
        
void create() 
{ 
set_name("新闻系统",({ "news board","board"}) );
set("name_color","HIR");
set("location", "/d/wiz/newroom");  
set("board_id", "news_b");
setup(); 
set("capacity", 500); 
} 

// 这个部份是用来在login时调用的。 
int check_news(object me) 
{ 
int num,i,last_time_read; 
mapping *notes, last_read_time; 
string myid,msg=""; 
notes = query("notes"); 
if ( !me || !userp(me) )
        return 0;
//  last_read_time =me->query("board_last_read"+(string)query("board_id")); 
last_read_time = me->query("board_last_read");
myid = query("board_id"); 
if ( !pointerp(notes) || !sizeof(notes) ) 
        return 1; 
i = sizeof(notes)-query("lastread/"+me->query("id"));
if (i < 6 && i > 0) // 小于6条新闻才显示标题，不然会FLOOD 
        { 
        msg =CYN"\n≡"YEL"────西游记--神魔传说最新新闻──────────────────────────"CYN"≡\n"NOR; 
        if ( !mapp(last_read_time) || undefinedp(last_read_time[myid]) ) 
                num = 1; 
        else    
                for(num = 1; num<=sizeof(notes); num++) 
                        if( notes[num-1]["time"] > last_read_time[myid] ) 
                                break; 
        if (mapp(last_read_time)) 
                last_time_read = last_read_time[myid]; 
        for(i=sizeof(notes)-1 ; i>num-2 ; i--) 
                { 
                msg += sprintf(YEL"【"NOR+HIW"%3d"YEL"】"NOR,i+1); 
                msg += sprintf("     %-=25s %18s (%s)\n", notes[i]["title"], notes[i]["author"], 
                                RTIME_D->chinese_time(5, ctime(notes[i]["time"]))); 
                } 
        msg += CYN"≡"YEL"────────────────────────────西游记--神魔传说──────"CYN"≡"NOR; 
        me->start_more(msg); 
        } 
i = sizeof(notes)-query("lastread/"+me->query("id"));
if ( i<0 ) i = 0;
write(BRED YEL"【精灵】告诉您：从您上次看新闻到现在"+((i==0)? "没有任何":"共有"+WHT+chinese_number(i)+YEL"条")+"新闻！\n"NOR); 
if(i>10) write("你可以Help news 来查看【西游记--神魔传说新闻】的查看方法。\n"); // 提醒不知道有NEWS系统的玩家使用news 
return 1;
} 

int main(object me, string arg) 
{ 
int num,i,last_time_read; 
mapping *notes, last_read_time; 
string myid,msg; 
       
last_read_time = me->query("board_last_read"); 
myid = query("board_id"); 
notes = query("notes"); 
i = sizeof(notes)-query("lastread/"+me->query("id"));
if ( i<0 ) i = 0;
if( !pointerp(notes) || !sizeof(notes) ) 
        return notify_fail(WHT"【精灵】告诉您：对不起，「西游记--神魔传说」目前没有任何新闻。\n"NOR); 
if( !arg )  
        { 
        if(i>10) write("你可以 Help news 来查看西游记--神魔传说新闻系统的使用方法。\n");  
        write(WHT"【精灵】"NOR"告诉您：「西游记--神魔传说」目前共有"+WHT+chinese_number(sizeof(notes))+NOR"条新闻"+((i==0)? "。":"，您有"+YEL+chinese_number(i)+NOR"条尚未收听。")+"\n");
        return 1; 
        } 
if( arg=="all") // 显示所有新闻 
        { 
        msg = CYN"\n≡"YEL"────西游记--神魔传说所有新闻──────────────────────────"CYN"≡\n"NOR; 
        notes = query("notes"); 
        if (mapp(last_read_time)) last_time_read = last_read_time[myid]; 
        for(i=sizeof(notes)-1 ; i>-1 ; i--) 
                { 
                msg += sprintf("%s"WHT"【"NOR+HIW"%3d"WHT"】" NOR, 
                                notes[i]["time"] > last_time_read ? YEL: "", i+1); 
                msg += sprintf("     %-=25s %18s (%s)\n", 
                                notes[i]["title"], notes[i]["author"], 
                                RTIME_D->chinese_time(5, ctime(notes[i]["time"]))); 
                } 
        msg += CYN"≡"YEL"────────────────────────────西游记--神魔传说──────"CYN"≡"NOR; 
        me->start_more(msg); 
        return 1; 
        } 
else if ( sscanf(arg,"post %s",arg)==1 )   
        return do_post(arg);
else if ( arg=="new" )  // 显示最新新闻 
        { 
        if( !mapp(last_read_time) || undefinedp(last_read_time[myid]) ) 
                num = 1; 
        else    
                for(num = 1; num<=sizeof(notes); num++) 
                        if( notes[num-1]["time"] > last_read_time[myid] ) break; 
        } 
else if( !sscanf(arg, "%d", num) ) 
        return notify_fail("你到底要看第几条新闻呀？\n"); 
if( num < 1 || num > sizeof(notes) ) 
        return notify_fail("看清楚点，好像没有这条新闻耶。\n"); 
num--; 
me->start_more(sprintf("\n\n%s\n"RED"新闻主题："YEL"%s\n"WHT"新闻巫师："NOR"%s\n"GRN"新闻时间：%s\n"CYN 
             "≡"YEL"────西游记--神魔传说新闻发布──────────────────────"CYN"≡\n"NOR, 
                  CYN"这是「西游记--神魔传说」总站的第"+chinese_number(num + 1)+"条新闻。"NOR, 
                     notes[num]["title"], notes[num]["author"],  
                     "/cmds/usr/ttime"->chinese_time(5, ctime(notes[num]["time"]))) 
                     + notes[num]["msg"]+ 
             CYN"≡"YEL"────────────────────────西游记--神魔传说──────"CYN"≡"NOR, ); 
      
if( !mapp(last_read_time) ) 
        me->set("board_last_read", ([ myid: notes[num]["time"] ]) ); 
else    if( undefinedp(last_read_time[myid]) || notes[num]["time"] > last_read_time[myid] ) 
        last_read_time[myid] = notes[num]["time"]; 
if ( query("lastread/"+me->query("id"))<(num+1) )
	set("lastread/"+me->query("id"),num+1);
save();
return 1; 
}
    
//当新闻被删除时，自动将玩家已阅读数减少 snowtu
void update_read()
{
int i;
string *ids;    
mapping data = query("lastread");
if ( !data || !mapp(data) )
        return;
ids = keys(data);
if ( !ids || !arrayp(ids) )
        return;
for(i=0;i<sizeof(ids);i++)
        {
        if ( ids[i] && stringp(ids[i]) )
                add("lastread/"+ids[i],-1);
        }
save();
return;
}                                       
      
void init() 
{ 
object me=this_player(); 
if (wizardp(me) &&  wiz_level(me) > wiz_level("(apprentice)") ) 
        { 
        add_action("do_post", "post"); 
        add_action("do_discard", "discard"); 
        add_action("do_demit","demit"); 
        add_action("do_appoint","appoint");
        }
}

int do_discard(string arg)
{
if ( !arg )
        return 0;
if ( ::do_discard(arg) )
        {
        update_read();
        return 1;
        }
}

int do_appoint(string arg) 
{ 
object me = this_player(); 
      
if( (string)SECURITY_D->get_status(this_player(1)) != "(admin)" 
 && (string)SECURITY_D->get_status(this_player(1)) !="(arch)" 
 && (string)SECURITY_D->get_status(this_player(1)) !="(wizard)" ) 
        return notify_fail("你没有任免版主的权利!\n"); 
          
if( !arg) 
        return notify_fail("你要任免谁为本版版主？\n"); 
if( !present(arg,environment(me) ) ) 
        return notify_fail("你要任命的玩家不在这个地方！\n"); 
if(this_object()->query("master") ) 
        return notify_fail("这个版已经有版主了！\n"); 
this_object()->set("master",arg); 
set("channel_id",HIR"罢免公告"HIC);
message("channel:chat",HIC"【"HIR"巫师界"HIC"】"HIR"罢免系统"HIC"：今任命"+arg+"为"+name()+HIC"板主!\n"NOR,users());
set("channel_id",HIR"新闻系统"HIC);
save();       
return 1; 
} 
      
int do_demit() 
{ 
object me = this_player(); 
      
if( (string)SECURITY_D->get_status(this_player(1)) != "(admin)" 
 && (string)SECURITY_D->get_status(this_player(1)) !="(arch)" 
 && (string)SECURITY_D->get_status(this_player(1)) !="(wizard)" ) 
        return notify_fail("你没有任免版主的权利!\n"); 
if(!this_object()->query("master") ) 
        return notify_fail("这个版本来就没有版主！\n"); 
set("channel_id",HIR"罢免公告"HIC);
message("channel:chat",HIC"【"HIR"巫师界"HIC"】"HIR"罢免系统"HIC"：今罢免"+name()+HIC"板主"+query("master")+"!\n"NOR,users());
set("channel_id",HIR"新闻系统"HIC);
this_object()->delete("master"); 
save(); 
return 1; 
} 

void done_post(object me, mapping note, string text) 
{ 
mapping *notes; 
if( !text )  text = " ";
text = SDS_D->color_msg(text); 
note["time"] = time(); 
note["msg"] = text; 
notes = query("notes"); 
if( !pointerp(notes) || !sizeof(notes) ) 
        notes = ({ note }); 
else    notes += ({ note }); 
if( sizeof(notes) > query("capacity")) 
        notes = notes[query("capacity")/2 .. query("capacity")]; 
set("notes", notes); 
save(); 
restore(); 
// 使用channel显示提示有了最新新闻 
message("channel:chat",HIC"【"HIR"巫师界"HIC"】新闻系统：西游记--神魔传说有了最新更新新闻，请用"HIR"news"HIC" 查看！\n"NOR,users());
tell_object(me, "新闻发表完毕。\n"); 
return; 
}

int help(object me)
{
    write(@HELP
「西游记--神魔传说」新闻系统指令  
      
指令格式 : 
news                    查看共有的和最新发布的新闻。 
news all                模拟华附新闻一览。  
news new                阅读最新的新闻。  
news <新闻编号>         查看此编号新闻的详细内容。 
post <新闻主题>         巫师发布主题新闻。 
discard <编号>          删除指定编号的新闻。（巫师专用） 
appoint <id>            任命某人为板主 <巫师专用> 
demit                   罢免某人板主资格 <巫师专用>
HELP
    );
    return 1;
}
