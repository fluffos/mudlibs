//在线时间奖励 每个心跳加1，每分钟奖励30点经验和15点潜能 累积上限12小时 铜钱奖励会员60个 非会员30个
//签到必给突破丹 还有一些其他的 也给经验和潜能
//东方使者的离线奖励——历练 只有会员才有奖励 继续保留

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  string str;
  int online_time;
  int i, last, times, pot = 0;

  online_time = me->query("sign/online");

  //if (!wizardp(me))
  //	return notify_fail("测试中！！！。\n");

  if (!arg) {
    //	str = ZJOBLONG"请输入奖励类型。\n";
    //	str += ZJOBACTS2+ZJMENUF(3,3,10,30);
    //	str += "在线奖励:online -online"ZJSEP"每日签到:online -daysign";
    message("vision", str + "\n", me);
  } else if (arg == "-online") {
    write("即将开放在线奖励机制！\n");
    return 1;
    write("你累计在线" + CHINESE_D->chinese_time(me->query("sign/online")) + "。\n");
    if (online_time < 60 * 5)
      return notify_fail("你在线时间不足五分钟，不能领取在线奖励。\n");
    if (online_time > 60 * 60 * 12)
      online_time = 60 * 60 * 12;
    me->add("combat_exp", online_time / 2);
    me->add("potential", online_time / 4);
    write("你获得了" + online_time * 9 + "点经验。\n");
    write("你获得了" + online_time * 10 + "点潜能。\n");

    if (me->query("registered") >= 3 && me->query("age") >= 16) {
      me->add("balance", online_time);
      write("你获得了" + MONEY_D->money_str(online_time) + "。\n");
    } else {
      write("会员的在线奖励更丰富哦！\n");
    }
    me->set("sign/online", 0);
  } else if (arg == "-daysign") {
    string *list, file;
    string *gifts;
    object ob;
    int m;
    gifts = ({

      "/u/shulele/sc/4/qinglong",
      "/u/shulele/sc/4/qilin",
      "/u/shulele/sc/4/xuanwu",
      "/u/shulele/sc/4/zhuque",
      "/u/shulele/obj/flag",
      "/u/shulele/obj/hongbao",
      "/u/shulele/obj/yadan",
      "/d/wizz/fangz/obj/100xyd",



    });


    last = me->query("sign/time");
    times = me->query("sign/days");
    if (localtime(last)[7] == localtime(time())[7])
      return notify_fail("今天你已经签到了！！！！！\n");



    if (localtime(time())[7] - localtime(last)[7] > 1) {
      //tell_object(me,"你没有昨天的签到记录，连续记录从今天开始。\n");
      times = 0;
    }
    if (!me->query("sign/time")) {
      times = 6;
    }

    me->set("sign/time", time());
    times += 1;

    me->set("sign/days", times);
    if (times > 7)
      times = 7;
    pot = 500 + times * 500;
    me->add("potential", pot);
    me->add("combat_exp", pot);

    me->set("putaonum", 0);
    me->set("baolingdan", 0);
    me->set("feijiantimes", 0);




    if (me->query("zjvip/times")) {
      tell_object(me, "会员福利！！！！！！\n");
      me->add("potential", pot);
      me->add("combat_exp", pot);
      m = random(8);
      ob = new(gifts[m]);
      tell_object(me, "你获得了一个" + ob->short() + "。\n");
      ob->move(me);
    } else {
      return notify_fail("会员的签到奖励更丰富哦，更有机会道具奖励！\n");
    }


    /*if (!me->query("zjvip/times"))
			return notify_fail("会员的签到奖励更丰富哦！\n");*/

    /*	if (times*5 > random(40))
		{
			ob=new("/clone/money/bgold");
			i=1+random(5);
			ob->set_amount(i);
			tell_object(me,"你获得了"+ob->short()+"。\n");
			ob->move(me);
		}*/

    /*	list = keys(gifts);
		for(i=0;i<sizeof(list);i++)
		{
			file = list[i];

			if((gifts[file]+times*5) > random(100))
			{
				ob = new(file);
				tell_object(me,"你获得了"+ob->short()+"。\n");
				ob->move(me);
			}
		}*/

  }



  return 1;
}

int help(object me) {
  write(@HELP
指令格式: online -

这个指令让你获得各种福利。

HELP
  );
  return 1;
}
