#include <action.h>
#include <ansi.h>

string powercol(int level) {
  if (level == 1)
    return HIC "X 级力量" NOR;
  else if (level == 2)
    return HIC "Z 级力量" NOR;
  else if (level == 3)
    return HIC "V 级力量" NOR;
  else if (level == 4)
    return HIW "白 鬭 气" NOR;
  else if (level == 5)
    return HIY "黄 鬭 气" NOR;
  else if (level == 6)
    return HIG "绿 鬭 气" NOR;
  else if (level == 7)
    return HIR "红 鬭 气" NOR;
  else if (level == 8)
    return HIB "蓝 鬭 气" NOR;
  else if (level == 9)
    return HIM "紫 鬭 气" NOR;
  else
    return BLK "黑 鬭 气" NOR;
}

int full(object me) {
  int jin, qi, neili, fali, shiwu, yinshui;
  jin = me->query("max_sen");
  qi = me->query("max_kee");
  fali = me->query("max_mana");
  neili = me->query("max_force");
  shiwu = me->max_food_capacity();
  yinshui = me->max_water_capacity();
  me->set("eff_sen", jin);
  me->set("eff_kee", qi);
  me->set("sen", jin);
  me->set("kee", qi);
  me->set("mana", fali * 2);
  me->set("force", neili * 2);
  me->set("food", shiwu);
  me->set("water", yinshui);
  return 1;
}


int main(object me, string arg) {
  int powerlvl = (int)me->query("power_lvl");
  string powercol = powercol(powerlvl);
  int myint, mykar, xinfa, all, i;

  if (!me->query("ssbx_can_learn")) return 0;

  if (me->query("ssbx") != "done") {
    if (me->query_skill("yuanwu-xinfa", 1) < 300) return notify_fail("你元武门心法不够，无法领悟此招。\n");
    if (me->is_busy()) return notify_fail("你现在正忙着呢。\n");

    message_vision("$N盘膝静坐，开始领悟元武门绝学最后一式。\n", me);
    tell_object(me, "波動拳,乃是将全身功力聚于一处，而后击出攻击对手，谓为：化劲为气，以劲御气。\n");
    tell_object(me, "昇龍拳，乃是将全身内气聚于拳上，借此大幅提升力道以攻击对手，谓为：化气为劲，以气御劲。\n");
    me->start_busy(5);
    myint = me->query("int") + me->query_skill("literate", 1) / 10 - 2;
    mykar = me->query("kar");
    xinfa = me->query_skill("yuanwu-xinfa", 1);
    all = xinfa / 10 + mykar / 2 + myint / 2;
    all /= 10;
    i = random(5);
    if (all < random(15) || i != 0) return notify_fail("你冥思苦想了良久，却始终无法顿悟，只好作罢。\n");
    tell_object(me, "脑海中，波動拳与昇龍拳的心法不住来回盘旋。\n");
    tell_object(me, "突然脑中灵光一闪：以气御劲，以劲御气，若是气劲互御，不就意味着生生不息？\n");
    tell_object(me, "你心中雀跃不休，我明白了，生生不息，元武门绝学这最后一式果然厉害。\n");
    me->set("ssbx", "done");
    return 1;
  }

  if (me->query_skill_mapped("unarmed") != "yuanwu-kungfu") return notify_fail("你现在并没使用元武门绝学。\n");
  if (!me->query("ssbx_num")) return notify_fail("你体内元气未复，无法使用『生生不息』。\n");

  if (arg == "busy") {
    if (!me->is_busy() || !me->is_fighting()) return notify_fail("你现在不需要使用『生生不息』。\n");
    if (me->query("ssbx_num") < 2) return notify_fail("你体内的元气不足于使出『生生不息』。\n");
    message_vision(
      HIC "$N一声怒喝，猛运起 " + powercol + HIC " 颠峰力量，使出元武门最高秘诀---『生生不息』,\n$N动作顿时变得连贯一致，毫无破绽。\n" NOR,
      me
    );
    me->add("ssbx_num", -2);
    me->start_busy(10, 100);
    me->interrupt_me(me);
    return 1;
  }

  if (arg == "life") {
    message_vision(HIM "$N将 " + powercol + HIM " 运贯全身，默使元武门最高秘诀---『生生不息』,顿时通体舒泰。\n" NOR, me);
    me->add("ssbx_num", -1);
    full(me);
    return 1;
  }

  return notify_fail("你要使用『生生不息』哪一法诀？\n");

}

int help(object me) {
  write(@HELP
指令格式 : ssbx busy

此法诀可使你的招式连贯，变得毫无破绽,需消耗2点元气。

指令格式 : ssbx life

此法诀可使你将自身状态提至顶峰，需消耗1点元气。

HELP
  );
  return 1;
}
