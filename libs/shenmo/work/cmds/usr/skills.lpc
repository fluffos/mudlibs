//skills.c
#include <ansi.h>
inherit F_CLEAN_UP;

string *base_sk = ({"literate","force","unarmed","blade",
                   "sword","spear","mace","axe",
                    "halberd","umbrella","needle", 
                   "spells","throwing","parry", 
                   "whip","stick","archery", 
                   "rake","dodge","hammer", 
                   "fork","dagger","qin"}); 
int main(object me, string arg)
{
object ob;
mapping skl, lrn, map;
string *sname, *mapped,str;
int i,j,cent;

seteuid(getuid());

if ( !arg )
        ob = me;
else    {
        ob = present(arg, environment(me));
        if ( !ob ) 
                ob = find_player(arg);
        if ( !ob ) 
                ob = find_living(arg);
        if ( !ob ) 
                return notify_fail("你要察看谁的技能？\n");        }
        if ( ob!=me && ob->query("env/invisibility")&&!wizardp(me) )
                return notify_fail("你要察看谁的技能？\n");
        if( ob!=me && !wizardp(me) 
        && !ob->is_apprentice_of(me) 
        && !me->is_apprentice_of(ob) 
        && getuid(ob)!=me->query("bonze/dadangid")
        && getuid(ob)!=me->query("couple/id"))
                return notify_fail("只有巫师或有师徒关系的人能察看他人的技能。\n");

        skl = ob->query_skills();
        if ( !sizeof(skl) ) 
                {
                write( (ob==me ? "你" : ob->name()) + "目前并没有学会任何技能。\n");
                return 1;
                }
        write((ob==me ? "你" : ob->name()) +"目前共学过"+HIR+chinese_number(sizeof(skl))+NOR+"种技能：\n");
        
printf(NOR HIW"┏━━━━━━━━━━━━━━"HIR"神  魔  传  说" HIW"━━━━━━━━━━━━━━┓\n"NOR,);
printf(NOR HIW"┃"NOR YEL" 所学技能"NOR YEL"  姓 名："NOR HIW"%-12s  "NOR YEL" 性别："NOR HIW"%-10s  "NOR YEL"I D："NOR HIW"%-13s "NOR HIW"┃\n"NOR,ob->name(),ob->query("gender"),"["+capitalize(ob->query("id"))+"]");
printf(NOR HIW"┣━━━━━━━━━━━━━━━━━━┯━━━━┯━━┯━━━━━━━━┫\n"NOR);
printf(NOR HIW"┃"NOR YEL"        名             称           "NOR HIW"┃ "NOR YEL"描  述"NOR HIW" ┃"NOR YEL"等级"NOR HIW"┃"NOR YEL"  经 验 点 数   "NOR HIW"┃\n"NOR,);
 sname  = sort_array( keys(skl), (: strcmp :) );        map = ob->query_skill_map();
        if( mapp(map) ) mapped = values(map);
        if( !mapped ) mapped = ({});

        lrn = ob->query_learned();
        if( !mapp(lrn) ) lrn = ([]);
        j=0;
        for(i=0; i<sizeof(skl); i++) {
       if(member_array(sname[i],base_sk)!=-1) {
                j=j+1;}
       }
        if(j>0) { printf(NOR HIW"┣"HBGRN"%15s     "NOR HIW"━━━━━━━━╋━━━━╋━━╋━━━━━━━━┫\n", chinese_number(j)+"项基本功夫");}
for(i=0; i<sizeof(skl); i++) {
       if(member_array(sname[i],base_sk)!=-1) {
printf(NOR HIW"┃"NOR"%s%s%-34s" NOR HIW"┃"NOR"%-8s"NOR HIW"┃"NOR"%4d"NOR HIW"┃"NOR"%7d - ["CYN"%3d%%"NOR"]"HIW"┃"NOR"\n", 
                        (lrn[sname[i]] >= (skl[sname[i]]+1) * (skl[sname[i]]+1)) ? HIR : "",
                        (member_array(sname[i], mapped)==-1? "  ": HIG"□"HIC),
                                      to_chinese(sname[i]) + " (" + sname[i] + ")",
                        SKILL_D(sname[i])->level_description(skl[sname[i]]),
                        ob->query_skill(sname[i],1), (int)lrn[sname[i]], cent);}
}
j=0;
        for(i=0; i<sizeof(skl); i++) {
      if(member_array(sname[i],base_sk)==-1) {
                j=j+1;}
        }
        if(j>0) { printf(NOR HIW"┣"HBGRN"%15s     "NOR HIW"━━━━━━━━╋━━━━╋━━╋━━━━━━━━┫\n", chinese_number(j)+"项特殊功夫");}
        for(i=0; i<sizeof(skl); i++) {
      if(member_array(sname[i],base_sk)==-1) {
cent = lrn[sname[i]]*100/((skl[sname[i]]+1)*(skl[sname[i]]+1));
printf(NOR HIW"┃"NOR"%s%s%-34s" NOR HIW"┃"NOR"%-8s"NOR HIW"┃"NOR"%4d"NOR HIW"┃"NOR"%7d - ["CYN"%3d%%"NOR"]"HIW"┃"NOR"\n", 
                        (lrn[sname[i]] >= (skl[sname[i]]+1) * (skl[sname[i]]+1)) ? HIR : "",
                        (member_array(sname[i], mapped)==-1? "  ": HIR"★"HIY),
                                      to_chinese(sname[i]) + " (" + sname[i] + ")",
                        SKILL_D(sname[i])->level_description(skl[sname[i]]),
                        ob->query_skill(sname[i],1), (int)lrn[sname[i]], cent);}
}
printf(NOR HIW"┗━━━━━━━━━━━━━━━━━━┻━━━━┻━━┻━━━━━━━━┛\n\n"NOR);
return 1;
}
int help(object me){
        write(@HELP
指令格式 : skills|jineng [<某人>]

这个指令可以让你查询所学过的技能。

你也可以指定一个和你有师徒关系的对象，用 skills 可以查知对方的技能状况。

巫师可以查询任何人或 NPC 的技能状况。

HELP
    );
    return 1;
}
