// CMDS /cmds/usr/wizlist.c
// by djx 2003-7-25

#include <ansi.h>
#include <mudlib.h>

inherit F_CLEAN_UP;
#define RENWU "/adm/etc/renwu"
string query_timec(int time);
int level(mixed, mixed);

void create() { seteuid( getuid() ); }

int main(object me, string arg)
{
       string *list, hood = "", scr, str1;
       string msg, time_msg,quest,wiz;
       int i, inv=0, adm_n, arc_n, wiz_n, apr_n, imm_n, eld_n, j, k,number;
       object ob, body;

       mapping quests=([ ]);

        if (file_size(RENWU))
                foreach (string str in explode(read_file(RENWU),"\n")){
                if( str[0]=='#' || sscanf(str, "%s %s", wiz, quest)!=2 ) continue;
                quests+=([ wiz : quest ]);
            }

       list = sort_array(SECURITY_D->query_wizlist(), (: level :));
       str1 =HIR"★"+HIY+""+MUD_NAME +""HIR"★"HIG"巫师列表：\n"NOR;
str1 +=HIR"★"HIW"≡≡"HIB"────────────────────────────────────────"HIW"≡≡"HIR"★\n"NOR;
str1 +=HIB"  【"HIW"系统级别"HIB"】       【"HIW"英文名"HIB"】【"HIW"中文名"HIB"】 【"HIW"状态"HIB"】   【"HIW"时间"HIB"】     【"HIW"  目 前 任 务  "HIB"】\n"NOR;
str1 +=HIR"★"HIW"≡≡"HIB"────────────────────────────────────────"HIW"≡≡"HIR"★\n"NOR;
        for(i=0; i<sizeof(list); i++) {
                        switch (wizhood(list[i])) { 
                                case "(admin)":         adm_n++; break;
                                case "(arch)":          arc_n++; break;
                                case "(wizard)":        wiz_n++; break;
                                case "(apprentice)":    apr_n++; break;
                                case "(immortal)":      imm_n++; break;
                                case "(elder)":         eld_n++; break;
                        }
        }

        for(i=0; i<sizeof(list); i++) {
        if (hood != wizhood(list[i])) {
                hood = wizhood(list[i]);
                        switch (hood) {
                                case "(admin)":         msg =GRN"『 主管天神 』"NOR;k=adm_n;break;
                                case "(arch)":          msg =GRN"『 天界大神 』"NOR;k=arc_n;break;
                                case "(wizard)":        msg =GRN"『 神界仙人 』"NOR;k=wiz_n ;break;
                                case "(apprentice)":    msg =GRN"『 天界散仙 』"NOR;k=apr_n;break;
                                case "(immortal)":      msg =GRN"『 天界灵官 』"NOR;k=imm_n;break;
                                case "(elder)":         msg =GRN"『 荣誉巫师 』"NOR;k=eld_n;break;
                        }
                        j=1;
                } else {
                        msg="";
                        j++;
                }
                if ( k == 1) scr="━━━━";
                else scr="━━┳━";

                if ( k!=j && k!=1 && j!=1 ) scr="  ┣━";
                if ( k==j && k!=1 && j!=1 )     scr="  ┗━";

              inv=0;
              ob=new(LOGIN_OB);
              ob->set("id", list[i]);
              ob->restore();

     if(objectp(body=find_player(list[i])) && !body->query("env/invisibility")) {
           number++;
                 if(interactive(body) && (query_idle(body)) > 300 )
                     time_msg=sprintf(HIM"在线：已发呆%5d 秒钟  "NOR,query_idle(body));
                     else
                        if (!interactive(body)) time_msg=HIR"在线：断线中．．．      "NOR;
                     else
                        if (this_player()->visible(body)) 
        time_msg="连线："+query_timec(body->query_temp("login_time")); 
                str1 +=sprintf(" %-16s%s "YEL"%-9s%-10s"HIG"%-24s"NOR"  %s\n", msg,scr,list[i],body->name(1), 
                        time_msg,undefinedp(quests[list[i]])?CYN"「尚未分配」"NOR:quests[list[i]]);
                        inv=1;
      } else {
                        time_msg="离线："+query_timec(ob->query("last_on"));
                str1 +=sprintf(" %-16s%s "YEL"%-9s%-10s"NOR"%-24s  %s\n", msg,scr,list[i],ob->query("name"), 
                        time_msg,undefinedp(quests[list[i]])?CYN"「尚未分配」"NOR:quests[list[i]]);
                destruct(ob);
                inv=0;}
        }
str1 +=HIR"\n★"HIW"≡≡"HIB"──────────────────────────────"HIG"T·S·R·J"HIB"─────"HIW"≡≡"HIR"★\n"NOR;
    str1 +=sprintf(HIR"★"+HIY+MUD_NAME+HIG"目前共有:"HIR" %s"NOR HIG"个巫师。\n"NOR,chinese_number(sizeof(list)) );
        str1 +=sprintf(HIR"★"+HIY+MUD_NAME+HIG"的巫师守则请看:"+HIY"help wiz_rules "+NOR+"。\n");
   str1 +=sprintf(HIR"★"+HIY+MUD_NAME+HIG"现有："BLINK HIR"%s"NOR HIG"位管理员在线上。"NOR,chinese_number(number));
        me->start_more(str1);
        return 1;
}

int level(mixed ob1, mixed ob2)
{
        if (wiz_level(ob1) != wiz_level(ob2))
                return wiz_level(ob2) - wiz_level(ob1);
        return ob1 < ob2?-1:1;
}

string query_timec(int time)
{
        string msg;
        int day, hour, min;
        
        time=time()-time;
        
        msg="";
        day=time/86400;
        hour=time%86400/3600;
        min=time/60%60;
        if(min<1)
                min=1;
        if(day)
                msg+=sprintf("%s天", chinese_number(day));
        if(day<10 && hour)
                msg+=sprintf("%s小时", chinese_number(hour));
        if(!day && hour<20 && min)
                msg+=sprintf("%s分钟", chinese_number(min));
        return msg;
}

int help(object me)
{
write(@HELP

指令格式 : wizlist

用途 : 本指令用来查看目前总共有多少个巫师。

HELP
     );
     return 1;
}
