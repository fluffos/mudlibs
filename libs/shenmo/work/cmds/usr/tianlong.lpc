
#include <ansi.h>
#include <combat.h>

inherit F_CLEAN_UP;
int main(object me, string arg)
{
        object target, guard_ob;
        string *killer, callname,str;
        int eff_qi,max_qi,qi_pcg;

         if(me->query("/sds3/tianlong")!="done")
               return notify_fail("没有童虎的传授,你如何会用天龙?\n");

        if( !arg )
                return notify_fail("你想对谁用天龙？\n");


        if(!objectp(target = present(arg, environment(me))))
                return notify_fail("这里没有这个人。\n");


	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("你不在战斗中。\n");


/*
        if (arg!="shura")
                return notify_fail("你刚想发出天龙，突然想起童虎教授此招时说过此招是用来克制山羊座圣斗士的。\n");
*/
        if (target->query("id")!="shura")
                return notify_fail("你刚想发出天龙，突然想起童虎教授此招时说过此招是用来克制山羊座圣斗士的。\n");


       eff_qi=me->query("eff_kee");
       max_qi=me->query("max_kee");
       qi_pcg=eff_qi*100/max_qi;

       if (qi_pcg>50) 
           return notify_fail("你刚想发出天龙，突然想起童虎教授此招时千万叮咛的一句话：不到最危险的时候切忌乱用。\n");

             me->set("/sds3/tianlong",0);

              message_vision(HIC"$N已经危在旦夕，突然想起童虎传授的绝技---天龙。\n"NOR,me);

		message_vision(HIY"\n$N猛的爆发出小宇宙极限力量，只见$N身背后浮现出一条巨龙伸出龙爪紧紧抓住$n,冲向天际!\n\n"NOR,me,target); 

             message("chat",HIY+"【黄道十二宫】突然从山羊宫爆发两股强大的小宇宙,直冲九天,就像一颗流星缓缓消失在天际!。\n"NOR,users()); 

             message_vision(HIR"\n过了许久，突然有一个人从半空中跌落下来，将地面轰出了一个大坑。\n"NOR,me);

if ( target )  { target->set_temp("last_damage_from",me); target->unconcious(); }

        return 1;
}


int help(object me)
{
        write(@HELP
指令格式 : tianlong <人物>
 
天龙,是黄金圣斗士元老,天秤座童虎的绝招,在通过黄金十二宫时可以用来完成'天龙架山羊'。
童虎教授此招时，曾经说过：不到最危险的时候切忌乱用。
HELP
    );
  return 1;
}
