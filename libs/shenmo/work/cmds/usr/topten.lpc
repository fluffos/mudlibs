
// toptenadd.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string str,*astr;
	int i;
	seteuid(geteuid(me));
	if (!arg||arg=="")
	return notify_fail(TOPTEN_D->query_type());
	str=TOPTEN_D->topten_query(arg);
	write(str+"\n");
	return 1;
}

int help(object me)
{
write(@HELP
指令格式 : topten <类型> 
           单独输入 topten 可以查看西游记--神魔传说目前有哪些已开放的排行榜。
HELP
    );
    return 1;
}

