#include <ansi.h>
int main(object me, string str) {
  string output;
  if (me->is_busy())
    return notify_fail("你现在正忙。\n");

  me->add("sen", -20);
  me->start_busy(2);

  output = HIR "★ " HIW "西游记--神魔传说" HIR " ★" HIG " 任务榜\n" NOR;
  output += "" HIW "─────────────────────────────────────\n" NOR "";
  output += TASK_D->dyn_quest_list();
  output += "" HIW "────────────────────────────" HIG " 西游记--神魔传说" HIW " ────\n\n" NOR "";

  me->start_more(output);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式: task
相关文件: help tasks

这个指令是用来得知目前的所有神书.

HELP
  );
  return 1;
}
