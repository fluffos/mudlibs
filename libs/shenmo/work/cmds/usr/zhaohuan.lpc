// 幻兽

#include <ansi.h>
inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg) {
  object ob;
  string hs_id;
  string *id_list, *t_list;

  if ((me->query("combat_exp") + me->query("daoxing")) < 4000000
    || (me->query("max_force") + me->query("max_mana")) < 3000)
    return notify_fail("你现在并没有养幻兽的资格，具体条件请参照help zhaohuan。\n");

  if (!me->query("hs/hs_id") || !me->query("huanshou"))
    return notify_fail("你现在并没有养幻兽。\n");

  if (environment(me)->query("short") == "擂台")
    return notify_fail("擂台上怎么能叫魔宠帮忙。\n");

  hs_id = me->query("hs/hs_id");
  id_list = ({ hs_id });
  t_list = explode(hs_id, " ");
  if (sizeof(t_list) > 1) {
    id_list += t_list;
  }
  ob = find_player(hs_id);
  if (!ob) ob = find_living(hs_id);
  if (!ob) ob = LOGIN_D->find_body(hs_id);

  if (!ob) {
    ob = new("/d/diablo/obj/dream/npc/pet");
    ob->set("owner", getuid(me));
    if (!ob->restore()) {
      destruct(ob);
      return notify_fail("你的宠物出了问题，请和巫师联系!");
    }
    ob->set_name(ob->query("name"), id_list);
    ob->setup();
  } else if (ob->query("owner") != me->query("id"))
    return notify_fail("好象你的宠物不肯听你的话了，你还是自已去找找吧！\n");
  ob->move(environment(me));
  message_vision("$N念动与古老精灵之间的契约之词，$n在一片光芒中出现在$N的面前。\n", me, ob);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式： zhaohuan

这个指令让你可以召唤回你饲养的魔宠

条件：武学与道行之和大于四十万，法力内力最大值的和大于三千

HELP
  );
  return 1;
}
