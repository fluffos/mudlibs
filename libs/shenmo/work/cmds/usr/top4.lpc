// last modified by alone
#include <ansi.h>
#include <mudlib.h>

inherit F_CLEAN_UP;
int top_list(object ob1,object ob2);
int get_score(object ob);
int main(object me, string arg)
{
        
        object *list,*ob;
        int i;
        string msg;

if(me->query_temp("last_top_time") && !wizardp(me) && (me->query_temp("last_top_time")+10)>time())
                return notify_fail("等等,系统喘气中......\n");    
me->set_temp("last_top_time",time()); 
      ob = filter_array(objects(), (: userp($1) && !wizardp($1) :));
        list = sort_array(ob, (: top_list :));
  msg =  "\n              ┏━ "+BLINK HIW+"天上"+HIC+"*"+HIR+"人间"+HIW+"在线转世综合排行榜 "NOR" ━┓\n";
      msg += "┏━━━━━┯┻━━━━━━━━━━━┯━━━━━┻┯━━━━┓\n";
 msg += "┃"+BCYN HIW+"  名 次  "NOR+" │"+BCYN HIW+"      高        手      "NOR+"│"+BCYN HIW+"  轮回转世  "NOR+"│"+BCYN HIW+" 评  价 "NOR+"┃\n";
       msg += "┠━──━─┴────────────┴──────┴────┨\n";
        for (i = 0 ;i < 20 ; i++) {
        if( i >= sizeof(list)) msg += "┃暂时空缺。 \n";
                else {
                if(list[i] == me) msg += BBLU HIY;
if (list[i]->query("zhuanshi")==4)
             msg += sprintf("┃"+HIR+"  %-7s"NOR+" ┃"+HIC+" %-12s"NOR+HIC+" %-10s"NOR+"┃   "+HIW+"%-9s"NOR+"┃"+HIY+" %6d"NOR+" ┃\n",chinese_number(i+1),list[i]->query("name"),"["+
      list[i]->query("id")+"]","无量世",
        get_score(list[i])-1000000*list[i]->query("zhuanshi"));
else if (list[i]->query("zhuanshi")==3)
             msg += sprintf("┃"+HIR+"  %-7s"NOR+" ┃"+HIC+" %-12s"NOR+HIC+" %-10s"NOR+"┃   "+HIW+"%-9s"NOR+"┃"+HIY+" %6d"NOR+" ┃\n",chinese_number(i+1),list[i]->query("name"),"["+
      list[i]->query("id")+"]","极乐世",
        get_score(list[i])-1000000*list[i]->query("zhuanshi"));
else if (list[i]->query("zhuanshi")==2)
             msg += sprintf("┃"+HIR+"  %-7s"NOR+" ┃"+HIC+" %-12s"NOR+HIC+" %-10s"NOR+"┃   "+HIC+"%-9s"NOR+"┃"+HIY+" %6d"NOR+" ┃\n",chinese_number(i+1),list[i]->query("name"),"["+
      list[i]->query("id")+"]","梵天世",
        get_score(list[i])-1000000*list[i]->query("zhuanshi"));
else if (list[i]->query("zhuanshi")==1)
             msg += sprintf("┃"+HIR+"  %-7s"NOR+" ┃"+HIC+" %-12s"NOR+HIC+" %-10s"NOR+"┃   "+HIB+"%-9s"NOR+"┃"+HIY+" %6d"NOR+" ┃\n",chinese_number(i+1),list[i]->query("name"),"["+
      list[i]->query("id")+"]","修罗世",
        get_score(list[i])-1000000*list[i]->query("zhuanshi"));
else
             msg += sprintf("┃"+HIR+"  %-7s"NOR+" ┃"+HIC+" %-12s"NOR+HIC+" %-10s"NOR+"┃   "+HIY+"%-9s"NOR+"┃"+HIY+" %6d"NOR+" ┃\n",chinese_number(i+1),list[i]->query("name"),"["+
      list[i]->query("id")+"]","众生世",
        get_score(list[i])-1000000*list[i]->query("zhuanshi"));
                }
                         }
        msg += "┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\n";
      msg += HBBLU"你现在的综合评价为："+(get_score(me)-1000000*me->query("zhuanshi"))+"\n"NOR;
if (me->query("zhuanshi")==4)
      msg += HBBLU"你现在正处于第五世："HIW"无量世\n\n\n"NOR;
else if (me->query("zhuanshi")==3)
      msg += HBBLU"你现在正处于第四世："HIW"极乐世\n\n\n"NOR;
else if (me->query("zhuanshi")==2)
      msg += HBBLU"你现在正处于第三世："HIC"梵天世\n\n\n"NOR;
else if (me->query("zhuanshi")==1)
      msg += HBBLU"你现在正处于第二世："HIB"修罗世\n\n\n"NOR;
else
      msg += HBBLU"你现在正处于第一世："HIY"众生世\n\n\n"NOR;
            msg += "                    " +BCYN HIW+ NATURE_D->game_time() + "记\n"NOR;
        write(msg);
        return 1;

}
int top_list(object ob1, object ob2)
{
      int score1,score2;

        score1 = get_score(ob1);
        score2 = get_score(ob2);
     return score2 - score1;
}

int get_score(object ob)
{
        int tlvl,i,score;
        string *ski;
        mapping skills;

      reset_eval_cost();
        skills = ob->query_skills();
        if (!sizeof(skills)) return 1; 
        ski  = keys(skills);
          for(i = 0; i<sizeof(ski); i++) {
            if( (string)ob->query("id")=="dmss" ) return 1;     
                        tlvl += skills[ski[i]];
                        }  // count total skill levels
        score = tlvl/10;
        score += ob->query("max_force")/10;
        score += ob->query("max_mana")/10;
//        score += ob->query_str() + ob->query_int() + ob->query_dex() + ob->query_con();
       score += (int)ob->query("combat_exp")/5000;
       score += (int)ob->query("daoxing")/5000;
       if (ob->query("zhuanshi")>0)
               score += 1000000;
       if (ob->query("zhuanshi")>1)
               score += 1000000;
       if (ob->query("zhuanshi")>2)
               score += 1000000;
       if (ob->query("zhuanshi")>3)
               score += 1000000;
        if (ob->query("env/recluse"))
                score = 0;

        return score;
}
int help(object me)
{
write(@HELP
指令格式 : top  top2  top3  top4 ... ...
 
这个指令可以让你知道在线高手是哪些，别去惹他们。 
目前共开设了四榜：
top ：西游记--神魔传说在线二十高手排行榜
top2：西游记--神魔传说在线武功潜质排行榜
top3：西游记--神魔传说在线二十快手排行榜
top4：西游记--神魔传说在线转世综合排行榜
 
HELP
    );
    return 1;
}

