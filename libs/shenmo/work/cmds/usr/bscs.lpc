#include <action.h>
#include <ansi.h>

string *skill = ({ "changshengjue", "busi-force" });

int main(object me, string arg) {
  int powerlvl;
  string fc;

  fc = me->query_skill_mapped("force");
  if (member_array(
    fc,
    skill
  ) == -1 && !wizardp(me)) return notify_fail("你现在并没使用" + to_chinese("changshengjue") + "或者" + to_chinese("busi-force") + "。\n");
  // fang 2013.08.16 取消ssbx的限制
  //   if( me->query("ssbx")=="done") return notify_fail("会生生不息，就不能使用『不死长生』。\n");
  if (me->query_skill(
    fc,
    1
  ) < 820 && !wizardp(me)) return notify_fail("你的" + to_chinese(fc) + "等级太低，无法使用『不死长生』。\n");

  if (arg == "busy") {
    if (time() < (me->query("bscs_time") + 10) && !wizardp(me)) return notify_fail("绝招用多了就不灵了。\n");
    if (!me->is_busy() || !me->is_fighting()) return notify_fail("你现在不需要使用『不死长生』。\n");
    if (me->query("bscs_num") < 4) return notify_fail("你体内的真元不足以使出『不死长生』。\n");
    message_vision(
      HIW "$N默念道:“仙人抚我顶，结发授长生！”\n" + HIW "使出" + HIY + to_chinese(fc) + HIW "最高秘诀---『不死长生』,\n$N顿时动作变得连贯一致，毫无破绽。\n" NOR,
      me
    );
    me->add("bscs_num", -2);
    me->start_busy(10, 100);
    me->interrupt_me(me);
    me->set("bscs_time", time());
    return 1;
  }

  if (arg == "add") {
    if (me->is_busy()) return notify_fail("你正忙着呢！\n");
    tell_object(me, HIW "你将 " + HIY + to_chinese(fc) + HIW " 运贯全身，吸取着天地元气，将其转化为自身真元\n" NOR);
    powerlvl = me->query_skill(fc, 1);
    powerlvl /= 40;
    if (powerlvl < 40) powerlvl = 13;  //修改成13，wuxin 2012.11
    if (powerlvl > 100) powerlvl = 100;
    me->add("bscs_num", 1);
    tell_object(me, "你体内的真元增加了！\n");
    if (me->query("bscs_num") >= powerlvl) {
      me->set("bscs_num", powerlvl);  //原来为jiayi_num，wuxin 2012.11
      tell_object(me, "你所能容纳的真元已经到达极限。\n");
    }
    me->start_busy(5);

    return 1;
  }

  return notify_fail("你要使用『不死长生』哪一法诀？\n");

}

int help(object me) {
  write(@HELP
指令格式 : bscs busy

此法诀可使你的招式连贯，变得毫无破绽,需消耗2点真元。

指令格式 : bscs add

此法诀可使你将吸收天地间的元气，增加1点真元。

HELP
  );
  return 1;
}
