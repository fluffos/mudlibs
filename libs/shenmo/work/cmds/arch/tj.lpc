#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string str) {
  object *users;
  int count, i, j;

  users = users();

  if (wiz_level(me) < 4)
    return 0;

  if (!str)
    return notify_fail("你要统计什么？\n");
  if (str != "shoucheng" && str != "dajiu")
    return notify_fail("你要统计什么？\n");

  count = sizeof(users);

  j = 0;

  for (i = 0; i < count; i++) {
    if (users[i]->query_temp(str, 1)) j++;

  }
  write(HIW "\n总共 " HIR + count + HIW " 位玩家, " HIR + j + HIW " 位玩家在" + str + "。\n" NOR);

  return 1;

}
