#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string str) {
  object *users;
  int count, i, j, t;
  users = filter_array(users(), (: userp($1) && !wizardp($1) :));

  count = sizeof(users);

  j = 0;
  str = sprintf(HIW "\n以下为本MUD中的在线玩家的time如下：\n" NOR);
  str += sprintf(HIY "-------------------------------------------------------------------------\n" NOR);
  for (i = 0; i < count; i++) {
    t = (int)SDS_D->pptime(users[i]);
    if (t > 4500)
      str += sprintf(HIR + " %-25s" + "%-15s" + "%-15s" + "%-25s" + NOR + " \n", users[i]->name() + "(" + users[i]->query("id") + ")",
        "time：" + t, "年龄：" + users[i]->query("age"), "所属门派：" + users[i]->query("family/family_name"));
    else
      str += sprintf(HIC + " %-25s" + "%-15s" + "%-15s" + "%-25s" + NOR + " \n", users[i]->name() + "(" + users[i]->query("id") + ")",
        "time：" + t, "年龄：" + users[i]->query("age"), "所属门派：" + users[i]->query("family/family_name"));
    j++;

  }
  str += sprintf(HIW "\n总共 " HIR + j + HIW " 位玩家的time数据\n" NOR);
  str += sprintf(HIY "-------------------------------------------------------------------------\n" NOR);
  me->start_more(str);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : timetj

次指令用于统计在线玩家的time情况。

HELP
  );
  return 1;
}
