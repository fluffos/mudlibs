#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string str)
{
        object* users;
        int count, i, j;
     users = users();

        if (wiz_level(me) < 4)
                return 0;

        count = sizeof(users);

        j = 0;
        str = sprintf(HIW "\n以下为本MUD中的在线玩家的time如下：\n" NOR);
        str+= sprintf(HIY "-------------------------------------------------------------------------\n" NOR);
        for (i = 0; i < count; i ++)
        {
                    if (users[i]->query("kk_time")>4500)
                    	{     str+= sprintf(HIR + users[i]->name() + "(" + users[i]->query("id") + ") \t\t" NOR);
                            str+= sprintf(HIR "年龄：" + users[i]->query("age") + "\t" NOR);            
                            str+= sprintf(HIR "所属门派：" + users[i]->query("family/family_name") + "\t" NOR);
                            str+= sprintf(HIR "抢得红包：" + users[i]->query("wuxin/2016/hongbao") + "\t" NOR);
                            str+= sprintf(HIR "time：" + users[i]->query("kk_time", 1) + "\n" NOR);}
                    else {	

                  str+= sprintf(HIC + users[i]->name() + "(" + users[i]->query("id") + ") \t\t" NOR);
                  str+= sprintf(HIC "年龄：" + users[i]->query("age") + "\t" NOR);
                  str+= sprintf(HIC "所属门派：" + users[i]->query("family/family_name") + "\t" NOR);
                  str+= sprintf(HIC "抢得红包：" + users[i]->query("wuxin/2016/hongbao") + "\t" NOR);
                  str+= sprintf(HIC "time：" + users[i]->query("kk_time", 1) + "\n" NOR);}
                  j ++;

        }
        str+= sprintf(HIW "\n总共 " HIR + j + HIW " 位玩家的time数据\n" NOR);
        str+= sprintf(HIY "-------------------------------------------------------------------------\n" NOR);
        me->start_more(str);
        return 1;
}

int help(object me)
{
write(@HELP
指令格式 : tongji <time>

次指令用于统计在线玩家的time情况。

HELP
    );
    return 1;
}
