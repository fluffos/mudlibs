#include <skill.h>
inherit F_CLEAN_UP;
void create() { seteuid(getuid()); }
int main(object me, string arg) {
  int sen_cost;
  int my_skill;
  int pot, i, z;
  int amount, qlearned, qskill;
  int bimprove = 1;

  if (me->is_fighting())
    return notify_fail("在战斗中搞研究？\n");

  if (!arg) return notify_fail("指令格式: research <技能>\n");

  if (!(int)my_skill = me->query_skill(arg, 1))
    return notify_fail("你对此项技能一无所知，如何搞研究？\n");

  if (my_skill < 100)
    return notify_fail("你这门武功这么差劲，搞什么研究！\n"); if (environment(me)->query("no_fight") || environment(me)->query("no_magic"))
      return notify_fail("安全区内禁止学习。\n");



  if (!SKILL_D(arg)->valid_learn(me)) return 0;
  if (me->query("class") == "saint" && me->query_skill(
    arg,
    1
  ) > me->query("faith") / 20 && me->query_skill(
    arg,
    1
  ) > 350) return notify_fail("你需要为门派多做贡献，才能成长。\n");

  pot = (int)me->query("potential") - (int)me->query("learned_points");

  if (pot > 50) pot = 50;
  if (pot <= 0) return notify_fail("你的潜能已经发挥到极限了，没有办法再成长了。\n");

  sen_cost = 150 * pot / (int)me->query_int();
  if ((int)me->query("sen") < sen_cost) {
    me->set("sen", 0);
    return notify_fail("你现在太累了，结果什麽也没有研究出来。\n");
  }

  z = (int)me->query("zhuanshi");
  if ((string)SKILL_D(arg)->type() == "martial"
    && my_skill / 10 * my_skill / 10 * my_skill / 10 > (int)me->query("combat_exp") / 100 * (z + 1))
    return notify_fail("也许是武学不够，结果什麽也没有研究出来。\n");

  if ((string)SKILL_D(arg)->type() == "magic"
    && my_skill / 10 * my_skill / 10 * my_skill / 10 > (int)me->query("daoxing") / 100 * (z + 1))
    return notify_fail("也许是道行不够，结果什麽也没有研究出来。\n");

  amount = 0;
  for (i = 0; i < pot; i++)
    amount += random(me->query_int()) + 1;
  if (amount / 200) amount += amount / 200 * my_skill;
  else amount += amount * my_skill / 200;
  qlearned = me->query_learned()[arg] + amount;
  qskill = (my_skill + 1) * (my_skill + 1);
  me->add("learned_points", 4 * pot);
  me->receive_damage("sen", sen_cost);
  if (qlearned > 2 * qskill && random(me->query_int()) > 32) bimprove = 0;
  if (qlearned > 2 * qskill && me->query_int() < 34 && !random(40))
    bimprove = 0;
  me->improve_skill(arg, amount);
  //me->improve_skill(arg, amount,bimprove);
  write("你对" + to_chinese(arg) + "作了一番彻底的研究！\n");
  return 1;
}
int help(object me) {
  write(@HELP
指令格式: research <技能>

这一指令让你用至多50点潜能对某项技能作深入的研究。
注: skills 要求 100 潜能需要2倍潜能！
HELP
  );
  return 1;
}
