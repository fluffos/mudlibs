#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
    object room1;

    /*
    if ( !wizardp(me) )
    {
        return notify_fail("暂时只对巫师开放！\n");
    }
    */

        if( me->query("level") > 1000 )  
    {
        return notify_fail("你的等级超过1000级，还有更艰巨的任务需要你去完成！\n"); 
    }

    if ( !JAPAN_D->can_join() )
    {
        room1 = find_object("/d/maze/japisland/island");
        if ( !room1 )
        {
            room1 = load_object("/d/maze/japisland/island");
        }

        me->move(room1);

        return 1;
    }

    if ( me->is_ghost() )
    {
        return notify_fail("做了鬼了，就老实点吧！\n");
    }

    if ( me->is_fighting() )
    {
        return notify_fail("战斗中不能接受公开邀请。\n");
    }

    if ( me->is_busy() )
    {
        return notify_fail("你很忙，不能接受公开邀请。\n");
    }

    room1 = find_object("/d/sunrise/jiangjuntang");
    if ( !room1 )
    {
        room1 = load_object("/d/sunrise/jiangjuntang");
    }

    me->move(room1);

    return 1;
}

int help(object me)
{
write(@HELP
指令格式 : wokou

战时，进入日出城，抵抗倭寇入侵。
闲时，进入东瀛小岛，攻击倭寇大本营。

HELP
    );
    return 1;
}

