//Cracked by Snowtu
// perform.c
#include <ansi.h>
#include <skill.h>
#include "/cmds/std/valid_kill.h";
inherit F_CLEAN_UP;

int valid_perform(object me,string skill,string arg)
{
string dir,jifa;
if ( !me || !me->query_skill(skill,1) )
        return 0;
jifa = me->query_skill_mapped(skill);
if ( !jifa || !stringp(jifa) )
        return 0;
dir = SKILL_D(jifa)->perform_action_file("");
if ( file_size(dir+arg+".lpc")<=0 )
        return 0;
return 1;
}       

int main(object me, string arg)
{
object weapon, target;
string martial, skill, perf,msg;
seteuid(getuid());

if ( me->is_busy() )
        return notify_fail("( 你上一个动作还没有完成，不能施用外功。)\n");

if ( !arg ) 
        return notify_fail("你要用外功做什么？\n");

if ( time()<(me->query_temp("no_perform/start")+me->query_temp("no_perform/time")) )
        {
        if ( stringp(msg=me->query_temp("no_perform/msg")) )
                return notify_fail(msg+"\n"NOR);
        }
        
if ( !wizardp(me) && environment(me)->query("no_fight")) 
        return notify_fail("这里不能施用外功。\n");

if ( sscanf(arg, "%s on %s", perf, arg)==2 ) 
        {
        target = present(arg, environment(me));
        if ( !target ) target = present(arg, me);
        if ( !target ) return notify_fail("这里没有 " + arg + "。\n");
        if (!valid_kill(me,target,0) ) 
                return notify_fail("你目前不能对"+target->name()+"施展外功。\n");
        if ( userp(target) && !environment(me)->query("alternative_die") )
                {
                if ( me->query("combat_exp")<250000 
                  || me->query("daoxing")<200000 
                  || target->query("age")<17 
                  || target->query_temp("netdead") )
                        return notify_fail("本站对PK有一定的限制或对方处于断线受保护状态。\n");
                }
        set_to_killer(me,target);
        arg=perf;
        } 
else if(sscanf(arg, "%s %s", perf, arg)==2 ) 
        arg=perf;

notify_fail("你所使用的外功中没有这种功能。\n");
if ( weapon = me->query_temp("weapon") )
        {
        martial = weapon->query("skill_type");
        if ( !valid_perform(me,martial,arg) )
                {
                if ( weapon = me->query_temp("secondary_weapon") )
                        martial = weapon->query("skill_type");
                if ( !valid_perform(me,martial,arg) )   
                        martial = "dodge";      
                if ( !valid_perform(me,martial,arg) )
                        return 0;
                }
        }
else if ( weapon = me->query_temp("secondary_weapon") )
        {
        martial = weapon->query("skill_type");
        if ( !valid_perform(me,martial,arg) )
                martial = "dodge";      
        if ( !valid_perform(me,martial,arg) )
                return 0;
        }
else    {
        martial = "unarmed";
        if ( !valid_perform(me,martial,arg) )
                martial = "dodge";      
        if ( !valid_perform(me,martial,arg) )
                return 0;
        }       

if( stringp(skill = me->query_skill_mapped(martial)) ) 
        {
        notify_fail("你所使用的外功中没有这种功能。\n");
        if( SKILL_D(skill)->perform_action(me, arg) ) 
                {
                if( random(120) < (int)me->query_skill(skill) )
                        me->improve_skill(skill, 1, 1);
                target = ("/std/sserver.lpc")->offensive_target(me);
                if ( target && target->reply_perform() )
                        target->reply_perform();                           
                if ( !target && wizardp(me) )
                        tell_object(me,"Reply_perform No target\n");
                if ( !target->reply_perform() && wizardp(me) )
                        tell_object(me,"Reply_perform No FUNc\n");
                return 1;
                } 
        else if( SKILL_D(martial)->perform_action(me, arg) ) 
                {
                if( random(120) < (int)me->query_skill(martial, 1) )
                        me->improve_skill(martial, 1, 1);
                target = ("/std/sserver.lpc")->offensive_target(me);
                if ( target && target->reply_perform() )
                        target->reply_perform();                           
                if ( !target && wizardp(me) )
                        tell_object(me,"Reply_perform No target\n");
                if ( !target->reply_perform() && wizardp(me) )
                        tell_object(me,"Reply_perform No FUNc\n");
                return 1;
                }
        return 0;
        }
return notify_fail("你请先用 enable 指令选择你要使用的外功。\n");
}

int help (object me)
{
        write(@HELP
指令格式：perfrom [<武功种类>.]<招式名称> [<施用对象>]

如果你所学的外功(拳脚、剑法、刀法....)有一些特殊的攻击方式或招式，可以
用这个指令来使用，你必须先用 enable 指令指定你使用的武功，不指定武功种
类时，空手的外功是指你的拳脚功夫，使用武器时则是兵刃的武功。


换句话说，只要是 enable 中的武功有特殊招式的，都可以用这个指令使用。
HELP
        );
        return 1;
}

