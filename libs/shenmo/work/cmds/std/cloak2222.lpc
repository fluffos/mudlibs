#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object room1;

  /*
    if ( !wizardp(me) )
    {
        return notify_fail("暂时只对巫师开放！\n");
    }
    */

  if (!present("water light cloak", me))
    return notify_fail("你身上没有水瑟天光。\n");

  if (me->is_ghost()) {
    return notify_fail("做了鬼了，就老实点吧！\n");
  }

  if (me->is_fighting()) {
    return notify_fail("战斗中不能接受公开邀请。\n");
  }

  if (me->is_busy()) {
    return notify_fail("你很忙，不能接受公开邀请。\n");
  }

  room1 = find_object("/d/xingji/chanfang");
  if (!room1) {
    room1 = load_object("/d/xingji/chanfang");
  }

  me->move(room1);

  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : cloak


HELP
  );
  return 1;
}
