//cglaem...12/17/96.

#include <ansi.h>

int main(object me, string arg)
{
string loc,msg,fam,str;
int mana_cost;
object ridee, map;
string ridemsg;
seteuid(getuid());

if ( !wizardp(me) && environment(me)->query("hs_world") )
	{
	message_vision(HIY"$N奋力望上一跳，似乎想飞起来。结果离地不到三尺就一个倒栽葱摔了下来。\n"NOR, me);
	return notify_fail("在魔幻世界，你的灵力还难以驾御风云。\n");
	}	

if( me->is_fighting() )
	return notify_fail("你正在战斗，飞不开。\n");
if( me->is_busy() || me->query_temp("pending/exercising"))
	return notify_fail("你正忙着呢，没工夫腾云驾雾。\n");
if( !wizardp(me) && !environment(me)->query("outdoors") )
	return notify_fail("周围没有一片云，没办法腾云驾雾。\n");
if( me->is_ghost() )
	return notify_fail("做了鬼了，就老实点吧！\n");
if( !arg )
	return notify_fail("你要飞到哪里去？\n");
if( me->query_temp("no_move") )
	return notify_fail("你被定住了，哪里飞得起来！\n");

if( RANK_D->grade_dx( RANK_D->describe_dx( (int)me->query("daoxing") ) ) 
	< RANK_D->grade_dx(BLU "初领妙道" NOR) )
	{
	message_vision(HIY"$N奋力望上一跳，似乎想飞起来。结果离地不到三尺就一个倒栽葱摔了下来。\n"NOR, me);
	return notify_fail("你现在还初领妙道都谈不上，哪里飞得起来。\n");
	}

if( RANK_D->grade_fali( RANK_D->describe_fali( (int)me->query("max_mana") ) ) 
	< RANK_D->grade_fali(HIB "腾云驾雾" NOR) )
	{
	message_vision(HIY"$N奋力望上一跳，似乎想飞起来。结果离地不到三尺就一个倒栽葱摔了下来。\n"NOR, me);
	return notify_fail("看来以你的法力修为还不能腾云驾雾。\n");
	}

if( (int)me->query("mana") < 200 )
	{
	message_vision(HIY"$N奋力望上一跳，似乎想飞起来。结果离地不到三尺就一个倒栽葱摔了下来。\n"NOR, me);
	return notify_fail("你目前法力不够充盈。\n");
	}

if( (int)me->query("sen") * 100 / (int)me->query("max_sen") < 50 )
	return notify_fail("你现在头脑不太清醒，当心掉下来摔死。\n");

if( (int)me->query("kee") * 100 / (int)me->query("max_kee") < 50 )
	return notify_fail("你想飞起来，可是体力似乎有点不支。\n");

mana_cost=-(100-(int)me->query_skill("spells"))/4-40;
if(mana_cost > 0) mana_cost=0;
fam = (string)me->query("family/family_name");
switch(fam)
	{
	case "三界山" :
		msg = HIR"$N"HIR"真气一提，大叫一声：我去耶！！！\n只见$N"HIR"纵身一跳，越上云宵，飞驰而去......\n\n"NOR;
		break;
	case "魔界" :
		msg = HIC"$N"HIC"两指轻弹，千里传音召唤黑莲。\n只见$N"HIC"冉冉升起，突然黑光闪动，$N"HIC"消失了。\n\n"NOR;
		break;
	case "明教" :
		msg = HIR"$N"HIR"默默念起一段梵文，ぬねののはひなさ。\n只见$N"HIR"施展乾坤大挪移心法，腾空而起。\n\n"NOR;
		break;
	case "三界散仙" :
		msg = HIB"$N"HIB"双目紧闭，两指轻弹。\n只见$N"HIB"幽冥鬼舞般升起，消失在一片茫茫人海了。\n\n"NOR;
		break;
	case "陷空山无底洞" :
		msg = HIW"只见平地里忽然刮起一阵阴风，将$N"HIW"紧紧裹住，\n顷刻间$N"HIW"随风而去，消失得无影无踪。 \n\n"NOR;
		break;
	case "天蓬元帅府" :
		msg = HIW"只见$N"HIW"一声仰天狮吼,忽然星云影动,狂风四起。\n顷刻间$N"HIW"随风而去，消失得无影无踪。 \n\n"NOR;
		break;
	case "将军府" :
		msg = HIY"$N"HIY"用手轻轻一指，只见天上降下一朵五彩祥云，\n$N"HIY"纵身跃上，乘祥云飘摇而去......\n\n"NOR;
		break;
	case "阎罗地府" :
		msg = BLU"$N"BLU"往黑暗处一指，只见所指之处仿佛出现一扇门，\n$N"BLU"大步走入，门也随之消失。 \n\n"NOR;
		break;
	case "方寸山三星洞" :
		msg = HIG"$N"HIG"捻个口诀，口中念动真言，大叫一声：“筋斗云！”，\n只见天上降下一朵七色云彩，$N"HIG"纵身跃上，飞驰而去......\n\n"NOR;
		break;
	case "月宫" :
		msg = HIM"$N"HIM"妩媚一笑，欣然起舞，随着一阵花香，已消失在月光中。\n"NOR;
		break;
	case "五庄观" :
		msg = HIB"$N"HIB"大袖一摆，只见风起云涌，人已借风云之势在空中大步迈去。\n"NOR;
		break;
	case "天空界" :
		msg = HIW"$N"HIW"扔出一片羽毛,纵身一跃，顷刻间$N"HIW"已踏上羽毛，腾空而去。\n"NOR;
		break;
	case "大雪山" :
		msg = HIW"$N"HIW"随手一挥，只见一团雪雾裹住真身，旋转而去。 \n"NOR;
		break;
	case "南海普陀山" :
		msg = HIY"$N"HIY"口中念着佛号，脚下升起祥云，缓缓离地飞去。  \n"NOR;
		break;
	case "东海龙宫" :
		msg = HIG"$N"HIG"口摇身一变，现出原形，正是一条神龙，随即穿云而去。 \n"NOR;
		break;
	case "火云洞" :
		msg = RED"$N"RED"口捻个口诀，口中念动真言,突然“轰”地冒起一团红雾,$N"RED"随即隐入红雾中。\n"NOR;
		break;
	case "蜀山剑派" :
		msg = HIC"$N"HIC"口捻个口诀，扔出一把宝剑，一招「御剑飞行」向远方飞去。。。。\n"NOR;
		break;
	case "盘丝洞" :
		msg = MAG"$N"MAG"皓腕轻抖，但见一道彩虹落了下来,$N"MAG"纤腰轻摆飘然而上,霞光一闪,\n彩虹消失的无影无踪。\n"NOR;
		break;
	case "剑客联盟" :
		msg = MAG"$N"MAG"结起手印，念动“六字真言”。\n只听嘣的一声，一片烟雾弥漫后，$N"MAG"早已消失得无影无踪了。\n"NOR;
		break;
        case "武圣门" :
		msg = HIY"$N"HIY"双臂交叉，默念几句咒语，一道光柱从天而降，$N"HIY"已消失在光柱中。\n"NOR;
		break;
	case "江湖浪子" :
		msg = HIW"$N"HIW"一声长啸腾空而起，运起"NOR HIR"血海飘香"NOR HIW"轻功，刹那间消失在众人眼前…… \n\n"NOR;
		break;
	case "少林寺" :
		msg = HIY"$N"HIY"默念一声“禅法无量”，身形化作一道金光而去…… \n\n"NOR;
		break;
	case "峨嵋派" :
		msg = HIM"$N"HIM"一声长鸣，脚下一团祥云出现，$N"HIM"脚踏祥云缓缓而去……\n"NOR;
		break;
	case "昆仑山玉虚洞" :
		msg = HIW"$N"HIW"伸手一招，一朵莲花平地而起,$N"HIW"坐上莲台，转眼而去……\n"NOR;
		break;
	default :
		{
		fam = (string)me->query("class");
		switch ( fam )
			{
			case "sfighter" :
				msg = HIG"$N"HIG"两眼紧闭，默运精神力量。\n突然强光一闪，$N"HIG"不见了。\n\n"NOR;
				break;
			case "wudang" :
				msg = HIY"$N"HIY"默运太极神功，身体腾空而起。\n"NOR;
				break;
			default :
				msg = HIY"$N"HIY"念动咒文，脚下祥云四溢。\n$N"HIY"大喝一声“疾”，一阵狂风过后，人已消失不见。\n\n"NOR;
				break;
			}	
              }
	}
message_vision(msg,me);
me->add("mana", mana_cost);

switch ( arg )
	{
	case "stone"		:	loc="/d/dntg/hgs/entrance";break;
	case "sanjie"		:	loc="/d/sanjie/sanjiedao";break;
	case "tianpeng"	:	loc="/d/leox/tianpeng/meng";break;
	case "kaifeng" 	:	loc="/d/kaifeng/tieta";break;
	case "moon" 		:	loc="/d/moon/ontop2";break;
	case "lingtai" 	:	loc="/d/lingtai/gate";break;
	case "village" 	:	loc="/d/qujing/village/cunkou";break;
	case "putuo" 		:	loc="/d/nanhai/gate";break;
	case "changan" 	:	loc="/d/city/center";break;
	case "sky" 		:	loc="/d/dntg/sky/nantian";break;
	case "wuzhuang" 	:	loc="/d/qujing/wuzhuang/gate";break;
	case "huangfeng" 	: 	loc="/d/qujing/huangfeng/huangfeng1";break;
	case "meishan" 	: 	loc="/d/meishan/erlangwai";	break;
	case "wudang" 	:	loc="/d/xkx/wudang/guangchang";break;
	case "wusheng"	:	loc="/d/wusheng/guangchang";break;
	case "wanmei"		:	loc="/d/youxia/wanmei";break;
	case "shaolin"	:	loc="/d/shaolin/gate";break;
	case "emei"		:	loc="/d/emei/huayanding";break;
	case "kunlun"		:	loc="/d/kunlun/xiaolu";break;
	case "japan"		:	loc="/d/swordman/gate";break;
	case "shushan"	:	loc="/d/shushan/road1";break;
	case  "baoxiang"	:	loc = "/d/qujing/baoxiang/bei1.c";
					loc[strlen(loc)-3] = '1'+random(4);
					break;
	case "pingding"	:	loc = "/d/qujing/pingding/ping1.c";
					loc[strlen(loc)-3] = '1'+random(4);
					break;
	case	"yalong"	:	loc = "/d/qujing/pingding/yalong1.c";
					loc[strlen(loc)-3] = '1'+random(3);
					break;
	case "wuji"		:	loc = "/d/qujing/wuji/square.c";break;
	case "chechi"		:	loc = "/d/qujing/chechi/jieshi1.c";
					loc[strlen(loc)-3] = '1'+random(9);
					break;
	case "tongtian"	:	loc = "/d/qujing/tongtian/hedong1.c";
					loc[strlen(loc)-3] = '1'+random(6);
					break;
	case "jindou"		:	loc = "/d/qujing/jindou/jindou1.c";
					loc[strlen(loc)-3] = '1'+random(4);
					break;
	case "nuerguo"	:	loc = "/d/qujing/nuerguo/towna1.c";
					loc[strlen(loc)-4] = 'a'+random(3);
					loc[strlen(loc)-3] = '1'+random(3);
					break;
	case "dudi"		:	loc = "/d/qujing/dudi/dudi1.c";
					loc[strlen(loc)-3] = '1'+random(4);
					break;
	case "firemount"	:	loc = "/d/qujing/firemount/cuiyun1.c";
					loc[strlen(loc)-3] = '1'+random(5);
					break;
	case "jilei"		:	loc = "/d/qujing/jilei/jilei1.c";
					loc[strlen(loc)-3] = '1'+random(3);
					break;
	case "jisaiguo"	:	loc = "/d/qujing/jisaiguo/east1.c";
					loc[strlen(loc)-3] = '1'+random(4);
					break;
	case "jingjiling"	:	loc = "/d/qujing/jingjiling/jingji1.c";
					break;
	case "xiaoxitian"	:	loc = "/d/qujing/xiaoxitian/simen.c";
					break;
	case "zhuzi"		:	loc = "/d/qujing/zhuzi/zhuzi1.c";
					loc[strlen(loc)-3] = '1'+random(5);
					break;
	case "qilin"		:	loc = "/d/qujing/qilin/yutai.c";
					break;
	case "pansi"		:	loc = "/d/qujing/pansi/ling1.c";
					loc[strlen(loc)-3] = '1'+random(6);
					break;
	case "biqiu"		:	loc = "/d/qujing/biqiu/jie1.c";
					loc[strlen(loc)-3] = '1'+random(9);
					break;
	case "qinghua"	:	loc = "/d/qujing/biqiu/zhuang.c";
					break;
	case "wudidong"	:	loc = "/d/qujing/wudidong/firemount-wudidong3.c";
					loc[strlen(loc)-3] = '1'+random(3);
					break;
	case "qinfa"		:	loc = "/d/qujing/qinfa/jiedao1.c";
					loc[strlen(loc)-3] = '1'+random(8);
					break;
	case "yinwu"		:	loc = "/d/qujing/yinwu/huangye1.c";
					break;
	case "fengxian"	:	loc = "/d/qujing/fengxian/jiedao1.c";
					loc[strlen(loc)-3] = '1'+random(9);
					break;
	case "yuhua"		:	loc = "/d/qujing/yuhua/xiaojie1.c";
					loc[strlen(loc)-3] = '1'+random(9);
					break;
	case "baotou"		:	loc = "/d/qujing/baotou/shanlu1.c";
					loc[strlen(loc)-3] = '1'+random(9);
					break;
	case "zhujie"		:	loc = "/d/qujing/zhujie/shanlu11.c";
					loc[strlen(loc)-3] = '1'+random(8);
					break;
	case "jinping"	:	loc = "/d/qujing/jinping/xiaojie1.c";
					loc[strlen(loc)-3] = '1'+random(7);
					break;
	case "qinglong"	:	loc = "/d/qujing/qinglong/shanjian.c";
					break;
	case "tianzhu"	:	loc = "/d/qujing/tianzhu/jiedao11.c";
					loc[strlen(loc)-3] = '1'+random(8);
					break;
	case "maoying"	:	loc = "/d/qujing/maoying/shanpo1.c";
					loc[strlen(loc)-3] = '1'+random(9);
					break;
	case "lingshan"	:	loc = "/d/qujing/lingshan/dalu1.c";
					loc[strlen(loc)-3] = '1'+random(3);
					break;
     	case "penglai"	:	
		if(!(map=present("eastsea map", me)) && !wizardp(me)) 
			{
			write("你在天上转了半天也不知该往那边飞。。。\n");
			message_vision("\n$N失望地从云上跳了下来！\n", me);
			return 1;
			}
		if( !wizardp(me)&&(string)map->query("unit")!="张" )
			{
			write("你在天上转了半天也不知该往那边飞。。。\n");
			message_vision("\n$N失望地从云上跳了下来！\n", me);
			return 1;
			}
		loc="/d/penglai/penglai";break;	
    	case "xueshan"	:
		if( (!(map=present("xueshan map", me)) 
		||  (string)map->query("unit")!="张") 
		&&  (string)me->query("family/family_name")!="大雪山" 
		&&  !wizardp(me)) 
			{ 
			write("你在天上转了半天也不知该往那边飞...\n"); 
			message_vision("\n$N失望地从云上跳了下来！\n", me);
			return 1; 
			} 
		loc="/d/xueshan/binggu";break;
/*
	case "lanling"	:	loc = "/d/lanling/兰陵城心.c";
					loc[strlen(loc)-3] = '1'+random(3);
					break;
*/
	default		:	write("\n\n到了！你按下云头跳了下来。\n");
					write("咦？．．．怎么还在原来的地方？\n");
					return 1;
        }
if ( !loc )
	return 1;
                
if( MISC_D->random_capture(me,0,1) ) 
	return 1;

if ( ridee = me->ride() ) 
	{
	ridemsg = ridee->query("ride/msg")+"着"+ridee->name();
	ridee->move(loc);
	}  
else	ridemsg = "";
me->move(loc);
write("\n\n到了！你按下云头跳了下来。\n");

str = (string)me->query("family/family_name");
switch( str )
	{
	case "陷空山无底洞"	:	msg = HIW"\n忽然间刮起一阵阴风，风尽处，$N"HIW"走了出来。\n"NOR;
					break;
	case "将军府"		:	msg = HIY"\n只见空中飘落一朵五彩祥云，$N"HIY"拨开云端走了出来。\n"NOR;
					break;
	case "魔界"		:	msg = HIC"\n只见黑莲突然一顿，$N"HIC"从黑莲中走了出来。\n"NOR;
					break;
	case "明教"		:	msg = HBMAG"\n乾坤大挪移心法运转一周，$N"HBMAG"来到了另一个地方。\n"NOR;
					break;
	case "天空界"		:	msg = HIW"\n一道白光闪过，$N"HIW"从羽毛上跳了下来。\n"NOR;
					break;
	case "三界散仙"	:	msg = HIB"\n只看天色变暗，$N"HIB"的鬼影走了出来。\n"NOR;
					break;
	case "阎罗地府"	:	msg = BLU"\n阴影中吹起一阵冷风，伴随着冷森森的笑声，$N"BLU+ridemsg+"如魑魅般从黑暗中出现。\n"NOR;
					break;
	case "方寸山三星洞"	:	msg = HIG"\n只听见天上传来一声：“俺来也！”，人随声到，$N"HIG+ridemsg+"从筋斗云中冉冉落下。\n"NOR;
					break;
	case "火云洞"		:	msg = RED"\n一团红色的烟雾涌了过来,$N"RED+ridemsg+"突然从里面蹦了出来.\n"NOR;
					break;
	case "蜀山"		:	msg = HIC"\n一道蓝光闪过,$N"HIC+ridemsg+"从剑上跳了下来。\n"NOR;
					break;
	case "盘丝洞"		:	msg = MAG"\n但见一道彩虹从天空划过，$N"MAG+ridemsg+"随彩虹飘然而至。\n"NOR;
					break;
	case "武圣门"		:	msg = HIY"\n只听空中一声清啸，$N"HIY+ridemsg+"随一朵祥云飘然而至。\n"NOR;
					break;
	case "江湖浪子"	:	msg = HIW"\n空气中飘过一丝清香，$N"HIW+ridemsg+"身怀"NOR HIR"血海飘香"NOR HIW"轻功,出现在众人眼前。\n"NOR;
					break;
	case "少林寺"		:	msg = HIY"\n远远传来“禅法无量”，$N"HIY+ridemsg+"已从一片金光中出现。\n"NOR;
					break;
	case "峨嵋派"		:	msg = HIM"\n远处一道彩虹飘然而至，$N"HIM+ridemsg+"从缓缓的团团祥云中走了下来。\n"NOR;
					break;
	case "昆仑山玉虚洞"	:	msg = HIM"\n忽然一朵莲花降下，$N"HIM+ridemsg+"走了出来。\n"NOR;
					break;
	case "武当派"		:	msg = HIY"\n忽然天空出现一道铁八卦，$N"HIY+ridemsg+"走了出来。\n"NOR;
					break;
	case "天蓬元帅府"	:	msg = HIG"\n只听见远出狂风呼来,声势浩大,$N"HIG+ridemsg+"在一片狂风中现出身形。\n"NOR;
					break;
	case "剑客联盟"	:	msg = MAG"\n只见一团烟雾散去，$N"MAG"现出了身影。\n"NOR;
					break;
	case "月宫"		:	msg = HIM"\n只见一道月光洒在你面前，柔柔的，冷冷的，$N"HIM+ridemsg+"从中飘然而至。\n"NOR;
					break;
	case "五庄观"		:	msg = HIB"\n一阵清风吹来，$N"HIB+ridemsg+"从空中降落。\n"NOR;
					break;
	case "大雪山"		:	msg = HIW"\n霎时间，大雪纷飞，$N"HIW+ridemsg+"亦如晶莹剔透的雪花随风飘下。 \n"NOR;
					break;
	case "南海普陀山"	:	msg = HIY"\n一声洪亮的“南无阿弥陀佛”，$N"HIY+ridemsg+"从佛光中，祥云里走出。\n"NOR;
					break;
	case "东海龙宫"	:	msg = HIG"\n半空中仿佛冲出一条水柱，$N"HIG+ridemsg+"从水柱上稳稳跳落地下。\n"NOR;
					break;
	default		:
		{
		str = (string)me->query("class");
		switch ( str )
			{
			case "sanjie"		:	msg = HIR"\n天上一道光影闪过，$N"HIR"不知道什么时候已经站在面前。\n"NOR;
							break;
			case "sfighter"	:	msg = HIG"\n突然强光一闪，$N"HIG+ridemsg+"从半空中缓缓降落。\n"NOR;
							break;
			default		:	msg = HIY"一阵狂风刮过，$N"HIY"从半空中落将下来。\n\n"NOR;
							break;
			}
		}
	}
message_vision(msg,me);
return 1;
}

int help(object me)
{
        write(@HELP
指令格式 : fly|fei [目的地]
当你的道行和法力高强时，你可以腾云驾雾。

目前你可以飞到的地方：
changan         ->长安城                 kaifeng        ->开封城
stone           ->花果山仙石             sky            ->南天门
moon            ->昆仑山月宫             penglai        ->蓬莱仙岛
lingtai         ->灵台方寸山             putuo          ->南海普陀山
xueshan         ->大雪山寒冰谷           meishan        ->梅山灌江口
wuzhuang        ->万寿山五庄观

baoxiang        ->宝象国                 pingding       ->平顶山
yalong          ->压龙山                 wuji           ->乌鸡国
chechi          ->车迟国                 tongtian       ->通天河
jindou          ->金兜山                 nuerguo        ->女儿国
dudi            ->毒敌山                 firemount      ->火焰山
jilei           ->积雷山                 jisaiguo       ->祭赛国
jingjiling      ->荆棘岭                 xiaoxitian     ->小西天
zhuzi           ->朱紫国                 qilin          ->麒麟山
pansi           ->盘丝岭                 biqiu          ->比丘国 
qinghua         ->清华庄                 wudidong       ->无底洞
qinfa           ->钦法国                 fengxian       ->凤仙郡 
yinwu           ->隐雾山                 yuhua          ->玉华县 
baotou          ->豹头山                 zhujie         ->竹节山
jinping         ->金平府                 qinglong       ->青龙山 
tianzhu         ->天竺国                 maoying        ->毛颖山 
lingshan        ->灵山                   sanjie         ->三界岛
lanling         ->兰陵城                 tianpeng       ->天蓬府
huangfeng       ->黄风岭                 village        ->小村子 
wusheng         ->武圣门                 wudang         ->武当山
emei            ->仙山峨嵋               shaolin        ->少林寺
wanmei          ->万梅山庄

HELP
        );
        return 1;
}
