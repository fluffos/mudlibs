// perform.c
//snowtu
#include <skill.h>
#include "/cmds/std/valid_kill.h";
inherit F_CLEAN_UP;

string query_cmd_type()
{
return "skill";
}

int main(object me, string arg)
{
object weapon, target;
string martial, skill, perf,id;
mapping temp;

if( me->is_busy() )
        return notify_fail("( 你上一个动作还没有完成，不能施用外功。)\n");
if( !arg ) return notify_fail("你要用外功做什么？\n");
        
temp = me->query_temp("no_perform");
if ( temp && mapp(temp) )
        {
        if ( time()<temp["start"]+temp["time"] )
                {
                if ( temp["msg"] && stringp(temp["msg"]) )
                        return notify_fail(temp["msg"]);
                else    return notify_fail("绝招用多就不灵了。\n");
                }
        }       
if( sscanf(arg, "%s on %s", perf, id)==2 ) 
        target = present(id, environment(me));
else    {
        target = me->select_opponent();
        if ( target ) id = target->query("id");
        else    target = me;
        perf = arg;
        }
if ( !target ) 
        return notify_fail("这里没有 " + id + "。\n");
if( me!=target && !valid_kill(me,target,0) ) 
        return notify_fail(target->name()+"不是可战的对象\n");
if ( me->query("combat_exp")<250000 && userp(target) )
        return notify_fail("自己功夫没练好就想杀人？\n");
if ( me->query("daoxing")<200000 && userp(target) )
        return notify_fail("自己功夫没练好就想杀人？\n");  
if ( userp(target) && target->query("age")<17 )
        return notify_fail("本站暂时保护新手。\n");
if ( userp(me) && userp(target) && target->query_temp("netdead") )
        return notify_fail("对方正在断线中，不能对其施用外功。\n");
        
set_to_killer(me,target);

if( weapon = me->query_temp("weapon") )
        martial = weapon->query("skill_type");
else    martial = "unarmed";
write("你目前的首要基本技能是"+to_chinese(martial)+"\n");
skill = me->query_skill_mapped(martial);
if ( skill && stringp(skill) )
        write("你目前的首要特殊技能是"+to_chinese(skill)+"\n");
else    write("你目前的首要特殊技能  暂无\n");  
if( !skill || !stringp(skill) )
        {
        weapon = me->query_temp("secondary_weapon");
        if ( !weapon || !objectp(weapon) )
                martial = "dodge";
        else    martial = weapon->query("skill_type");
        write("你目前的次要基本技能是"+to_chinese(martial)+"\n");
        skill = me->query_skill_mapped(martial);
        if ( skill && stringp(skill) )
                write("你目前的次要特殊技能是"+to_chinese(skill)+"\n");
        else    write("你目前的次要特殊技能  暂无\n");          
        if( !skill || !stringp(skill) )
                return notify_fail("你请先用 enable 指令选择你要使用的外功。\n");
        }

if ( SKILL_D(skill)->perform_action(me, arg) ) 
        {
        write("你使用了"+to_chinese(skill)+"的外功.\n");       
        if( random(120)<(int)me->query_skill(skill) )
                me->improve_skill(skill, 1, 1);
        return 1;
        } 
else if( SKILL_D(martial)->perform_action(me, arg) ) 
        {
        write("你使用了"+to_chinese(martial)+"的外功.\n");       
        if( random(120) < (int)me->query_skill(martial, 1) )
                me->improve_skill(martial, 1, 1);
        return 1;
        }
else    {
        weapon = me->query_temp("secondary_weapon");
        if ( !weapon || !objectp(weapon) )
                martial = "dodge";
        else    martial = weapon->query("skill_type");
        write("你目前副手的基本技能是"+to_chinese(martial)+"\n");
        skill = me->query_skill_mapped(martial);        
        if ( skill && stringp(skill) )     write("你目前副手的特殊技能是"+to_chinese(skill)+"\n");
        else     write("你目前副手的特殊技能  暂无\n");
        if( !skill || !stringp(skill) )
                {
                martial = "dodge";
                skill = me->query_skill_mapped(martial);        
                if( !skill || !stringp(skill) )
                        return notify_fail("你请先用 enable 指令选择你要使用的外功。\n");
                }
        if ( SKILL_D(skill)->perform_action(me, arg) ) 
                {
                write("你使用了"+to_chinese(skill)+"的外功.\n"); 
                if( random(120)<(int)me->query_skill(skill) )
                        me->improve_skill(skill, 1, 1);
                return 1;
                } 
        else if( SKILL_D(martial)->perform_action(me, arg) ) 
                {
                write("你使用了"+to_chinese(martial)+"的外功.\n");                
                if( random(120) < (int)me->query_skill(martial, 1) )
                        me->improve_skill(martial, 1, 1);
                return 1;
                }
//        else    return notify_fail("你请先用 enable 指令选择你要使用的外功。\n");
        else    {
                martial = "dodge";
                write("你目前副手的基本技能是"+to_chinese(martial)+"\n");
                skill = me->query_skill_mapped(martial);        
                if ( skill && stringp(skill) )     
                        write("你目前轻功的特殊技能是"+to_chinese(skill)+"\n");
                else    write("你目前轻功的特殊技能  暂无\n");
                if( !skill || !stringp(skill) )
                        return notify_fail("你请先用 enable 指令选择你要使用的外功。\n");
                if ( SKILL_D(skill)->perform_action(me, arg) ) 
                        {
                        write("你使用了"+to_chinese(skill)+"的外功.\n"); 
                        if( random(120)<(int)me->query_skill(skill) )
                                me->improve_skill(skill, 1, 1);
                        return 1;
                        } 
                else if( SKILL_D(martial)->perform_action(me, arg) ) 
                        {
                        write("你使用了"+to_chinese(martial)+"的外功.\n");                
                        if( random(120) < (int)me->query_skill(martial, 1) )
                                me->improve_skill(martial, 1, 1);
                        return 1;
                        }
                }
        }
return 0;        
}

int help (object me)
{
        write(@HELP
指令格式：perfrom [<武功种类>.]<招式名称> [<施用对象>]

如果你所学的外功(拳脚、剑法、刀法....)有一些特殊的攻击方式或招式，可以
用这个指令来使用，你必须先用 enable 指令指定你使用的武功，不指定武功种
类时，空手的外功是指你的拳脚功夫，使用武器时则是兵刃的武功。


换句话说，只要是 enable 中的武功有特殊招式的，都可以用这个指令使用。
HELP
        );
        return 1;
}

