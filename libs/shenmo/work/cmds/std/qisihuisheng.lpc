#include "/doc/help.h"
#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  int force, mana, lvl;
  me = this_player();
  lvl = (int)me->query_skill("medical", 1);
  force = (int)me->query("max_force");
  mana = (int)me->query("max_mana");

  if (arg) return notify_fail("你的起死回生之术只能及己，难以及人。\n");
  if ((lvl < 1000 && me->query("spskkk") != 10) || lvl < 900)
    return notify_fail("以你的医术修为恐怕还难以施展起死回生。\n");
  if (time() - me->query_temp("qshs_end") < 2)
    return notify_fail("你精力耗费甚巨，难以连续施展起死回生。\n");

  me->set("eff_kee", me->query("max_kee"));
  me->set("kee", me->query("max_kee"));
  me->set("eff_sen", me->query("max_sen"));
  me->set("sen", me->query("max_sen"));
  me->set("force", force);
  me->set("mana", mana);
  me->clear_condition();
  me->set_temp("qshs_end", time());
  message_vision("$N" WHT "神游太虚" NOR "，施展" WHT "起死回生" NOR "之术，身体顿时恢复如初。\n", me);
  return 1;
}
