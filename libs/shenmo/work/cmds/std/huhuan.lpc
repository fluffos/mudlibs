// Created By snowtu
#include <ansi.h>
inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg)
{
object ob;
string pet_id, w_name, name, item;
string *id_list, *t_list;       
int t, color, w_lv;

if ( !me->query("weapon/make") )
        return notify_fail("你现在没有自制武器。\n");
item = me->query("weapon/id");
if ( objectp(ob = present(item, me)) && base_name(ob)=="/obj/weapon" )
        return notify_fail("不是在你身上吗?\n");
if ( t=(int)me->query_temp("soar/time_start") ) 
        {
        if ( t<=time() && time()< t+10 ) 
                return notify_fail("你的武器坏了，看来一时来不了。\n");
        }
pet_id=me->query("weapon/id");
id_list = ({ pet_id });
        ob = new("/obj/weapon");
if ( !ob )
        return notify_fail("======== 自制武器错误:缺少武器文件 ========\n");
if ( !ob->check_owner(me) )
        return notify_fail("自制武器召唤失败。\n");     
if ( ob->move(me) )
        message_vision(HIY"\n    只听半空中一声龙吟，$n"HIY"从天而降,落入$N"NOR HIY"的怀中。\n\n"NOR,me,ob);
me->set_temp("soar/time_start", time());     
me->delete("weapon/lv");
me->delete("weapon/change");
return 1;
}

int help(object me)
{
        write(@HELP
指令格式： huhuan

这个指令让你可以召回你的武器。
HELP
 );
        return 1;
}

