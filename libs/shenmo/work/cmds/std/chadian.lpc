#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
    /*
    if ( !wizardp(me) )
    {
        return notify_fail("暂时只对巫师开放！\n");
    }
    */



    if ( me->is_ghost() )
    {
        return notify_fail("做了鬼了，就老实点吧！\n");
    }

    if ( me->is_fighting() )
    {
        return notify_fail("战斗中不能查询。\n");
    }

    if ( me->is_busy() )
    {
        return notify_fail("你很忙，不能查询。\n");
    }

        me->add("renwuka",0);
	me->add("tianlongzhan/zhengqi_point",0);
tell_object(
this_player(),
		sprintf("大神告诉你的正气点是%d。\n",this_player()->query("tianlongzhan/zhengqi_point"))
		);
tell_object(
this_player(),
                   sprintf("大神告诉你的任务点是%d。\n",this_player()->query("renwuka"))
		);

    return 1;
}

int help(object me)
{
write(@HELP
指令格式 : chadian


HELP
    );
    return 1;
}

