#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object room1;

  if ((int)me->query("renwuka") < 1) {
    command("say 你你任务点不够了！");
    return 1;
  }

  if (me->is_ghost()) {
    return notify_fail("做了鬼了，就老实点吧！\n");
  }

  if (me->is_fighting()) {
    return notify_fail("战斗中不能接受公开邀请。\n");
  }

  if (me->is_busy()) {
    return notify_fail("你很忙，不能接受公开邀请。\n");
  }

  room1 = find_object("/d/xingji/kongjian");
  if (!room1) {
    room1 = load_object("/d/xingji/kongjian");
  }

  me->move(room1);
  me->add("renwuka", -1);
  tell_object(
    this_player(),
    sprintf("大神告诉你的任务点是%d。\n", this_player()->query("renwuka"))
  );

  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : kongjian


HELP
  );
  return 1;
}
