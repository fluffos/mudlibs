// 医术得治疗功能
//by windy 2006/4/1

#include <ansi.h>
inherit F_CLEAN_UP;



int main(object me, object target)
{
        
        object obj, who;
        int lv;
        lv=me->query_skill("medical",1);
        if(this_player()->is_busy())
           return notify_fail("你正忙着呢．．．\n");
                                 

        if((int)me->query_skill("medical",1)<1)
                return notify_fail("你似乎对医术一窍不通。\n");
        if(!me->update_condition()) 
                return notify_fail("你又没中毒。\n");
        if((int)me->query("force")<50) 
                return notify_fail("你的真气不够，难以驱毒。\n");
	if((int)me->query("sen")<=50)
		return notify_fail("你现在太累了，休息休息吧！\n");
        if((int)me->is_fighting() && ( lv < 900 ))
                return notify_fail("战斗中驱毒？能行吗？\n");
        
               tell_object(me,"你屏气凝神，全身笼起一层"HIW"白雾"NOR"，"HIY"黄豆"NOR"大的汗珠从额头流了下来。\n");
       me->add("force", -100);
        me->set("force_factor", 0);
me->start_busy(random(2));
//        if( ( lv < 800 ) || ( random(100) > 80 ) || me->query_condition("xiangsi") || me->query_condition("feng") || ! me->update_condition())
        if( (lv<800 && me->query("spskkk")!=10) || lv<100 || random(100) > 80 || me->query_condition("xiangsi") || me->query_condition("feng"))
                return notify_fail("也不知是医术不精还是毒性太强，你感觉方才的努力无济于事！\n");
        if (me->query_condition("double_ice_poison"))
                me->apply_condition("double_ice_poison",0);
        if (me->query_condition("ice_poison"))
                me->apply_condition("ice_poison",0);
        if (me->query_condition("wudu"))
                me->apply_condition("wudu",0);
        if (me->query_condition("hell_zhua"))
                me->apply_condition("hell_zhua",0);
        if (me->query_condition("eyeill"))
                me->apply_condition("eyeill",0);
        if (me->query_condition("ice_fire_poison"))
                me->apply_condition("ice_fire_poison",0);
        if (me->query_condition("moon_poison"))
                me->apply_condition("moon_poison",0);
        if (me->query_condition("xiangsi"))
                me->apply_condition("xiangsi",0);
        if (me->query_condition("snake_poison"))
                me->apply_condition("snake_poison",0);
        if (me->query_condition("qishang_poison"))
                me->apply_condition("qishang_poison",0);
        if (me->query_condition("ziwuliuzhu_poison"))
                me->apply_condition("ziwuliuzhu_poison",0);
write("良久,你吐出几口黑血,终于成功驱除了体内的毒质！\n");
       me->add("force", -500);
        me->improve_skill("medical", 1); 
       
     return 1;    
}


int help(object me)
{	
	write(@HELP
指令格式 : qudu 

驱毒:可以驱除自身体内的毒质。
     （暂时只开放给自己治疗的功能。）

HELP
    );
    return 1;
}
