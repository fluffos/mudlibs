// score.c
/*从新修改的SCORE,这里的右边框中间部分暂时还是不要合拢了，防止出错。因为涉及到
  颜色字符串取值问题，编辑起来太麻烦，等以后有新内容的时候在一并编辑。
  by koker 01.10.2016
*/
#include <ansi.h>
#include <combat.h>
#include <mudlib.h>

inherit F_CLEAN_UP;
int color_len(string str);  //增加的颜色字符串变量取值
string display_attr(int gift, int value);
string status_color(int current, int max);
string date_string(int date);
string tribar_graph(int val, int eff, int max, string bcolor, string fcolor, string dcolor);

void create() { seteuid(ROOT_UID); }

int main(object me, string arg) {
  object ob;
  mapping my;
  string line, str, skill_type, *marks;
  object weapon;
  int i, attack_points, dodge_points, parry_points, obstacles, dntg, gong, ct, rsg;
  int len = 0;
  seteuid(getuid(me));
  if (!arg) ob = me;
  else if (wizardp(me)) {
    ob = present(arg, environment(me));
    if (!ob) ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) return notify_fail("你要察看谁的状态？\n");
  } else
    return notify_fail("只有巫师能察看别人的状态。\n");

  my = ob->query_entire_dbase();
  line = sprintf("        \n");
  line += sprintf(YEL "┏━━━━━━━━━━━━━━━━" HIG "个" NOR "" YEL "≡≡" HIG "人" NOR "" YEL "≡≡" HIG "资" NOR "" YEL "≡≡" HIG "料" NOR "" YEL "━━━━━━━━━━━━━━━━━┓\n" NOR);
  len = color_len(RANK_D->query_rank(ob));
  line += sprintf(
    YEL "┃" NOR "你现在的仙称：" NOR "%" + sprintf("%d", (72 + len)) + "-s" NOR YEL "┃\n",
    RANK_D->query_rank(ob)
  );
  len = color_len(ob->short(1));
  line += sprintf(
    YEL "┃" NOR "你现在的职称：" NOR "%" + sprintf("%d", (72 + len)) + "-s" NOR YEL "┃\n",
    ob->short(1)
  );
  line += sprintf(YEL "┣━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┫\n" NOR);
  str = "";
  if (mapp(my["family"])) {
    if (my["family"]["master_name"]) str = my["family"]["family_name"] + HIC + my["family"]["master_name"];
  }
  if (mapp(my["marks"])) {
    marks = keys(my["marks"]);
    for (i = 0; i < sizeof(marks); i++) {
      if (str != "") str += "、";
      str += marks[i];
    }
  }

  line += sprintf(YEL "┃" NOR "【年龄】%s%-78s%s" YEL "┃\n" NOR,
    HIC, chinese_number(ob->query("age")) + "岁", NOR);
  line += sprintf(YEL "┃" NOR "【性别】%s%-78s%s" YEL "┃\n" NOR,
    HIC, ob->query("gender"), NOR);
  line += sprintf(YEL "┃" NOR "【体重】%s%-78s%s" YEL "┃\n" NOR,
    HIC, chinese_number((int)ob->query_weight() / 1000) + "公斤", NOR);
  line += sprintf(YEL "┃" NOR "【生日】%s%-78s%s" YEL "┃\n" NOR,
    HIC, CHINESE_D->chinese_date(((int)ob->query("birthday") - 14 * 365 * 24 * 60) * 60), NOR);
  line += sprintf(YEL "┃" NOR "【帮会】%s%-78s%s" YEL "┃\n" NOR,
    HIC, ob->query("club") ? ob->query("club") : "未入江湖", NOR);

  if (ob->query("couple/name") != 0)
    line += sprintf(
      YEL "┃" NOR "【婚姻】" HIG "%-78s" YEL "┃\n" NOR,
      "【伴侣】" + ob->query("couple/name")
    );
  else
    line += sprintf(YEL "┃" NOR "【婚姻】" MAG "%-78s" YEL "┃\n" NOR, "[未婚]");

  if (str != "")

    line += sprintf(YEL "┃" NOR "%-93s" YEL "┃\n", "【师承】" + str, NOR);
  else
    line += sprintf(YEL "┃" NOR "【师承】%-78s" YEL "┃\n" NOR, "[还未曾拜师学艺] ");

  line += sprintf(YEL "┃" NOR "%-86s" YEL "┃\n" NOR, "【官职】" + (int)ob->query("office_number"));

  if (ob->query("degree"))
    line += sprintf(YEL "┃" NOR "【" WHT "官拜" NOR "】%-93s " YEL "┃\n" NOR, ob->query("degree"));

  else
    line += sprintf(YEL "┃" NOR "【官拜】%-93s " YEL "┃\n" NOR, "[" HIC "无" NOR "]");

  if (objectp(weapon = ob->query_temp("weapon")))
    skill_type = weapon->query("skill_type");
  else
    attack_points = COMBAT_D->skill_power(ob, skill_type, SKILL_USAGE_ATTACK);
  parry_points = COMBAT_D->skill_power(ob, skill_type, SKILL_USAGE_DEFENSE);
  dodge_points = COMBAT_D->skill_power(ob, "dodge", SKILL_USAGE_DEFENSE);

  /*******属性开始**************************************************************/
  line += sprintf(YEL "┃" NOR HIY "【体格】" NOR HIW "[%s %4s %s]  " NOR,
    NOR, display_attr(my["str"], ob->query_str()), NOR);
  if (my["eff_gin"] < my["max_gin"]) str = HIR + "生病";
  else if (my["gin"] * 100 / my["max_gin"] >= 70) str = HIG + "饱满";
  else if (my["gin"] * 100 / my["max_gin"] >= 40) str = HIR + "疲倦";
  else str = HIB + "很累";
  line += "〖" HIR "精神" NOR "〗  " + tribar_graph(
    my["gin"],
    my["eff_gin"],
    my["max_gin"],
    NOR,
    HIR,
    HIW
  ) + sprintf(HIW "  [%4s%s]\n" NOR, str, NOR);
  line += sprintf(YEL "┃" NOR HIY "【根骨】" NOR HIW "[%s %4s %s]  " NOR,
    NOR, display_attr(my["con"], ob->query_con()), NOR);
  if (my["eff_kee"] < my["max_kee"]) str = HIR + "伤残";
  else if (my["kee"] * 100 / my["max_kee"] >= 70) str = HIG + "充沛";
  else if (my["kee"] * 100 / my["max_kee"] >= 40) str = HIR + "受伤";
  else str = HIB + "重伤";
  line += "〖" HIR "气血" NOR "〗  " + tribar_graph(
    my["kee"],
    my["eff_kee"],
    my["max_kee"],
    NOR,
    HIR,
    HIW
  ) + sprintf("  [%4s%s]\n", str, NOR);

  if (my["food"] * 100 / ob->max_food_capacity() >= 80) str = HIG + "很饱";
  else if (my["food"] * 100 / ob->max_food_capacity() >= 50) str = HIC + "正常";
  else if (my["food"] * 100 / ob->max_food_capacity() >= 20) str = HIR + "缺食";
  else str = HIB + "饥饿";

  if (my["water"] * 100 / ob->max_water_capacity() > 60) str = HIG + "正常";
  else if (my["water"] * 100 / ob->max_water_capacity() > 30) str = HIR + "缺水";
  else str = HIB + "饥渴";
  line += sprintf(YEL "┃" NOR HIY "【悟性】" NOR HIW "[%s %4s %s]  " NOR,
    NOR, display_attr(my["int"], ob->query_int()), NOR);
  line += "〖" HIC "食物" NOR "〗：" + tribar_graph(my["food"], ob->max_food_capacity(),
    ob->max_food_capacity(), NOR, HIC, HIR) + sprintf("  [%4s%s]\n", str, NOR);
  if (wizardp(me) || ob->query("age") >= 14)
    line += sprintf(YEL "┃" NOR HIY "【灵性】" NOR HIW "[%s %4s %s]  " NOR,
      NOR, display_attr(my["spi"], ob->query_spi()), NOR);
  else
    line += YEL "┃" NOR "【灵性】[ 隐藏 ]  ";
  line += "〖" HIC "饮水" NOR "〗：" + tribar_graph(my["water"], ob->max_water_capacity(),
    ob->max_water_capacity(), NOR, HIC, HIR) + sprintf("  [%4s%s]\n", str, NOR);

  if (wizardp(me) || ob->query("age") >= 14)
    line += sprintf(YEL "┃" NOR HIY "【容貌】" NOR HIW "[%s %4s %s]  " NOR,
      NOR, display_attr(my["per"], ob->query_per()), NOR);
  else
    line += YEL "┃" NOR HIY "【容貌】" NOR HIW " [ 隐藏 ]  " NOR;

  line += "〖" HIW "死亡" NOR "〗："
    +sprintf("杀害玩家：%s%d%s 位,杀死敌人：%s%d%s 名,被杀害：%s%d%s 次\n", HIR, my["PKS"], NOR,
      HIW, my["MKS"], NOR, HIR, my["DIE"], NOR,);


  if (wizardp(me) || ob->query("age") >= 14)
    line += sprintf(YEL "┃" NOR HIY "【福缘】" NOR HIW "[%s %4s %s]  " NOR,
      NOR, display_attr(my["kar"], ob->query_kar()), NOR);
  else
    line += YEL "┃" NOR HIY "【福缘】" NOR HIW "[ 隐藏 ]  " NOR;

  if ((int)ob->query("balance"))
    line += "〖" HIY "存款" NOR "〗：" + "/adm/daemons/moneyd.lpc"->money_str((int)ob->query("balance")) + "\n";
  else
    line += "〖" HIY "存款" NOR "〗：" + HIW "空空如也" NOR + "\n";

  if (wizardp(me) || ob->query("age") >= 14)
    line += sprintf(YEL "┃" NOR HIY "【定力】" NOR HIW "[%s %4s %s]  " NOR,
      NOR, display_attr(my["cps"], ob->query_kar()), NOR);
  else
    line += YEL "┃" NOR HIY "【定力】" NOR HIW "[ 隐藏 ]  " NOR;

  if (ob->query("quest/number"))
    line += "〖" HIG "解迷" NOR "〗：你已经解了" HIR + chinese_number(ob->query("quest/number")) + NOR "个迷\n";
  else
    line += "〖" HIG "解迷" NOR "〗：" + HIR "你还没有解迷" NOR + "\n";

  if (wizardp(me) || ob->query("age") >= 14)
    line += sprintf(YEL "┃" NOR HIY "【胆识】" NOR HIW "[%s %4s %s]  " NOR,
      NOR, display_attr(my["cor"], ob->query_cor()), NOR);
  else
    line += YEL "┃" NOR HIY "【胆识】" NOR HIW "[ 隐藏 ]  " NOR;

  if (wizardp(me) || ob->query("age") >= 25)
    line += "〖" HIG "阳寿" NOR "〗：[  " RED + (int)ob->query("life/life_time") + NOR + "  ]   \n";
  else
    line += "〖" HIG "阳寿" NOR "〗：[ 隐藏 ]   \n";
  line += sprintf(YEL "┃                                                                                       \n" NOR);
  if (wizardp(this_player()))
    line += sprintf(YEL "┃" NOR "战斗攻击力 " HIW "%d (+%d)" NOR "\t\t战斗防御力 " HIW "%d (+%d)\n" NOR,
      attack_points / 100 + 1, ob->query_temp("apply/damage"),
      (dodge_points + (weapon ? parry_points :
        (parry_points / 10))) / 100 + 1, ob->query_temp("apply/armor"));
  else
    line += sprintf(" 兵器伤害力： [" HIR "%d" NOR "]" NOR "\t\t盔甲保护力： [" HIG "%d" NOR "]\n" NOR,
      ob->query_temp("apply/damage"),
      ob->query_temp("apply/armor"));
  line += sprintf(YEL "┃" NOR "生死之交：[%s%-4s%s]        ",
    HIC, ob->query("sszj") ? ob->query("sszj") : "没有拜把子", NOR);

  line += sprintf(MAG "你的死敌： " WHT "%4s(%s)      " NOR,
    my["KILLERNAME"], my["KILLER"]);

  if (wizardp(me) || ob->query("age") > 25)
    line += " 人参果：[  " HIR + (int)ob->query("rsg_eaten") + NOR + "  ]\n";
  else line += " 人参果：[ 隐藏 ]\n";
  line += sprintf(YEL "┃                                                                                      ┃\n" NOR);
  line += sprintf(
    YEL "┃" NOR "%-86s" YEL "┃\n" NOR,
    "潜 能 银 行：你现存有潜能点数为" + chinese_number(ob->query("qn_balance"))
  );

  obstacles = ob->query("obstacle/number");
  if (obstacles)
    line += sprintf(
      YEL "┃" NOR "%-86s" YEL "┃\n" NOR,
      "西 天 取 经：你已经历了" + chinese_number(obstacles) + "道劫难。"
    );
  else
    line += sprintf(YEL "┃" NOR "%-86s" YEL "┃\n" NOR, "西 天 取 经：你还未曾踏上取经之路");

  dntg = ob->query("dntg/number");
  gong = ob->query("sds3/number");
  if (gong > 12) gong = 12;
  if (dntg == 0) line += sprintf(YEL "┃" NOR "%-86s" YEL "┃\n" NOR, "大 闹 天 宫：你还未曾大闹天宫");
  else
    line += sprintf(
      YEL "┃" NOR "%-86s" YEL "┃\n" NOR,
      "大 闹 天 宫：你大闹天宫已过" + chinese_number(dntg) + "关。"
    );

  if (gong == 0) line += sprintf(YEL "┃" NOR "%-86s" YEL "┃\n" NOR, "闯 十 二 宫：你还未曾闯过黄金十二宫");
  else
    line += sprintf(
      YEL "┃" NOR "%-86s" YEL "┃\n" NOR,
      "闯 十 二 宫：你黄金十二宫已经闯过了" + chinese_number(gong) + "宫。"
    );

  ct = ob->query("9sky/number");
  if (ct == 0)
    line += sprintf(YEL "┃" NOR "%-86s" YEL "┃\n" NOR, "破 九 重 天：你还没破过九重天。");
  else
    line += sprintf(
      YEL "┃" NOR "%-86s" YEL "┃\n" NOR,
      "破 九 重 天：你已经破过了" + chinese_number(ct) + "重天。"
    );

  if (ob->query("life/live_forever"))
    line += sprintf(
      YEL "┃" NOR "%-86s" YEL "┃\n" NOR,
      "生 死 大 限：" + "已达不堕轮回的境界，从此跳出三界外，不在五行中，永无生死大限。"
    );

  if (ob->query("kill/pkgain")) {
    line += sprintf(
      YEL "┃" NOR "%-86s" YEL "┃\n" NOR,
      "ＰＫ道行增加：" + COMBAT_D->chinese_daoxing(ob->query("kill/pkgain"))
    );
    if (!ob->query("kill/pklose") && !ob->query("kill/nkgain")) line += "\n";
  }
  if (ob->query("kill/nkgain")) {
    line += sprintf(
      YEL "┃" NOR "%-86s" YEL "┃\n" NOR,
      "ＮＫ道行增加：" + COMBAT_D->chinese_daoxing(ob->query("kill/nkgain"))
    );
  }
  line += YEL "┣━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┫\n" NOR;
  line += sprintf(
    YEL "┃" NOR "〖" HIC "门派威望" NOR "〗：" HIR "%-18d" NOR "            ",
    (int)ob->query("weiwang")
  );
  line += sprintf("〖" HIC "门派忠诚" NOR "〗：" HIR "%-28d" YEL "┃\n" NOR, (int)ob->query("faith"));
  line += sprintf(
    YEL "┃" NOR "〖" HIC "钟馗捉鬼" NOR "〗：" HIR "%-18s" NOR "            ",
    chinese_number((int)ob->query("zhongkui"))
  );
  line += sprintf(
    "〖" HIC "花仙搭救" NOR "〗：" HIR "%-28s" YEL "┃\n" NOR,
    chinese_number((int)ob->query("baohuhuaxian"))
  );
  line += sprintf(YEL "┃                                                                                      ┃\n" NOR);
  line += sprintf(
    YEL "┃" NOR "〖" HIC "杀    气" NOR "〗：" HIR "%-18d" NOR "            ",
    ob->query("bellicosity")
  );
  line += sprintf("〖" HIC "神    数" NOR "〗：" HIM "%-28d" YEL "┃\n" NOR, ob->query("shen"));
  line += sprintf(
    YEL "┃" NOR "〖" HIC "潜    能" NOR "〗：" HIY "%-18d" NOR "            ",
    (int)ob->query("potential") - (int)ob->query("learned_points")
  );
  line += sprintf("〖" HIC "评    价" NOR "〗：" HIC "%-28d" YEL "┃\n" NOR, ob->query("score"));
  line += YEL "┣━━━━━━━━━━┳━━━━━━━━━━┳━━━━━━━━━━┳━━━━━━━━━━┫\n" NOR;
  line += sprintf(YEL "┃" NOR "〖道行境界〗%s" YEL "┃" NOR "〖武学境界〗%s" YEL "┃" NOR "〖法力修为〗%s" YEL "┃" NOR "〖内力修为〗%s\n",
    RANK_D->describe_dx(ob->query("daoxing")), RANK_D->describe_exp(ob->query("combat_exp")),
    RANK_D->describe_fali(ob->query("max_mana")), RANK_D->describe_neili(ob->query("max_force")));
  line += YEL "┗━━━━━━━━━━┻━━━━━━━━━━┻━━━━━━━━━━┻━━━━" HIG "魔神" HIY "·" HIG "传说" NOR YEL "━┛\n" NOR;
  line += sprintf(
    WHT + " 为求取真经%s已经历了" HIR "%s" NOR "的岁月。\n" + NOR,
    ob == me ? "你" : ob->name(1),
    FINGER_D->age_string((int)ob->query("mud_age"))
  );
  if (ob->query("zhuanshi") == 4)
    line += sprintf(
      WHT + " 六道轮回%s已处于第%s世" NOR "----------------------" HIM "无量世" NOR "。\n" + NOR,
      ob == me ? "你" : ob->name(1),
      chinese_number((int)ob->query("zhuanshi") + 1)
    );
  else if (ob->query("zhuanshi") == 3)
    line += sprintf(
      WHT + " 六道轮回%s已处于第%s世" NOR "----------------------" HIW "极乐世" NOR "。\n" + NOR,
      ob == me ? "你" : ob->name(1),
      chinese_number((int)ob->query("zhuanshi") + 1)
    );
  else if (ob->query("zhuanshi") == 2)
    line += sprintf(
      WHT + " 六道轮回%s尚处于第%s世" NOR "----------------------" HIC "梵天世" NOR "。\n" + NOR,
      ob == me ? "你" : ob->name(1),
      chinese_number((int)ob->query("zhuanshi") + 1)
    );
  else if (ob->query("zhuanshi") == 1)
    line += sprintf(
      WHT + " 六道轮回%s尚处于第%s世" NOR "----------------------" HIB "修罗世" NOR "。\n" + NOR,
      ob == me ? "你" : ob->name(1),
      chinese_number((int)ob->query("zhuanshi") + 1)
    );
  else
    line += sprintf(
      WHT + " 六道轮回%s尚处于第%s世" NOR "----------------------" HIY "众生世" NOR "。\n" + NOR,
      ob == me ? "你" : ob->name(1),
      chinese_number((int)ob->query("zhuanshi") + 1)
    );
  if (ob->query("zhuanshi") > 3)
    line += sprintf(
      WHT + " 在" HIW "极乐世" NOR "" WHT "里%s曾经历了" HIR "%s" NOR "的岁月。\n" + NOR,
      ob == me ? "你" : ob->name(1),
      FINGER_D->age_string((int)ob->query("mud_age3"))
    );
  line += sprintf(
    WHT + " 在" HIC "梵天世" NOR "" WHT "里%s曾经历了" HIR "%s" NOR "的岁月。\n" + NOR,
    ob == me ? "你" : ob->name(1),
    FINGER_D->age_string((int)ob->query("mud_age2"))
  );
  if (ob->query("zhuanshi") > 1)
    line += sprintf(
      WHT + " 在" HIB "修罗世" NOR "" WHT "里%s曾经历了" HIR "%s" NOR "的岁月。\n" + NOR,
      ob == me ? "你" : ob->name(1),
      FINGER_D->age_string((int)ob->query("mud_age1"))
    );
  if (ob->query("zhuanshi") > 0)
    line += sprintf(
      WHT + " 在" HIY "众生世" NOR "" WHT "里%s曾经历了" HIR "%s" NOR "的岁月。\n" + NOR,
      ob == me ? "你" : ob->name(1),
      FINGER_D->age_string((int)ob->query("mud_age0"))
    );

  write(line + BBLK);
  return 1;
}
//颜色字符串变量取值，可以做到底层文件里，暂时放着。
int color_len(string str) {
  int i;
  int extra;

  extra = 0;
  for (i = 0; i < strlen(str); i++) {
    if (str[i] == ESC[0]) {
      while ((extra++, str[i] < 'A'
        || str[i] > 'z'
        || str[i] > 'Z'
        && str[i] < 'a')
        && i < strlen(str))
        i++;
    }
  }

  return extra;
}

string display_attr(int gift, int value) {
  if (value > gift) return sprintf("%3d/" HIY "%5d" NOR, gift, value);
  else if (value < gift) return sprintf("%3d/" CYN "%5d" NOR, gift, value);
  else return sprintf("%3d/%5d", gift, value);
}

string status_color(int current, int max) {
  int percent;

  if (max) percent = current * 100 / max;
  else percent = 100;

  if (percent > 100) return HIC;
  if (percent >= 90) return HIG;
  if (percent >= 60) return HIY;
  if (percent >= 30) return YEL;
  if (percent >= 10) return HIR;
  return RED;
}

string tribar_graph(int val, int eff, int max, string bcolor, string fcolor, string dcolor) {
  string ret;
  int i, n, eff_n, max_n = 12;

  if (max == 0) max = 1;
  n = val * 100 / max / 10;
  eff_n = eff * 100 / max / 10;

  if (n < 0) n = 0;
  if (eff_n < 0) eff_n = 0;
  if (n > max_n) n = max_n;
  if (eff_n > max_n) eff_n = max_n;

  ret = NOR + bcolor + fcolor;
  for (i = 0; i < max_n; i++) {
    if (i > eff_n) ret += dcolor;
    if (i < n) ret += "━";
    else ret += HIW "━" NOR;
  }
  ret += fcolor + NOR;
  return ret;
}
int help(object me) {
  write(@HELP
指令格式：score
          score <对象名称>      （巫师专用）

显示自己或者指定对象（含怪物）的基本资料。此指令可以“sc”代替。

相关讯息：hp
HELP
  );

  return 1;
}
