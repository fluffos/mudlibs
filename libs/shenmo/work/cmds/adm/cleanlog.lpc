//snowtu 清理日志的命令
//鉴于服务器很慢,所以不加定时清理的设定....

#include <ansi.h>
inherit F_CLEAN_UP;
inherit F_DBASE;

#define MAX_SIZE 5120   //超过5k的即清除

int main(object me)
{
string msg,*str,file,tmp;
int i,k,flag=0; 
mapping data = ([
        "allcont"       : "登陆失败日志",
        "autoload"      : "自动加载出错日志",
        "backup"        : "系统定期备份日志",
        "banned_approve": "？",
        "bobing"        : "博饼日志",
        "change_rank"   : "称呼更改日志",
        "changepw.log"  : "密码更改日志",
        "changesuper_password.log"      : "超级密码更改日志",
        "condition.err" : "中毒出错日志",
        "death"         : "死亡日志",
        "debug.log"     : "系统错误日志",
        "destruct"      : "强制dest日志",
        "dns_fake"      : "DNS日志",
        "dns_master"    : "LIB互连日志",
        "dntg"          : "大闹天宫日志",
        "files"         : "非互动性存盘日志",
        "force_player"  : "强制命令日志",
        "ftpd"          : "FTP连接日志",
//      "huanggong.results"     : "状元日志*",
        "jiuyang-shengong-bonus"        : "金庸书籍日志",
        "kickout"       : "踢出日志",   
        "log"           : "NPC出错日志?",
        "map_error"     : "区域连接出错日志",
        "money_reset"   : "货币重置日志",
        "monitord"      : "秦陵日志",
        "move.bug"      : "物件移动出错日志",
        "ningxie-force-bonus" : "ningxie-force相关日志",
        "notice"        : "系统公告",
        "npc_kill"      : "NK日志",
        "npc_save"      : "NPC读档出错日志",
        "obstacle"      : "取经日志",
//      "pantaohui.results"     : "封神日志",
        "qiujin"        : "拔舌日志",
        "recover"       : "毫毛使用日志",
        "sanhua"        : "?",
        "setskill"      : "技能调整日志",
        "shop_log"      : "商店利润日志",
        "snoop_player"  : "监视日志",
        "taskdeath"     : "任务死亡日志",
        "taskreward"    : "任务奖励日志",
        "to_jail"       : "坐监日志",
        "usage"         : "登陆日志",
        "wiz_put"       : "巫师放入日志",
        "wizlogin"      : "巫师登陆日志",
        "yl.rc"         : "婚姻日志",
]);

if ( !wizardp(me) )
        return 0;
        
msg = "系统冗余日志清理开始，"; 
str = keys(data);
for(i=0;i<sizeof(str);i++)
        {
        file = "/log/"+str[i];
        k = file_size(file);
        if ( !k || k<=MAX_SIZE )
                continue;               
        tmp = "";
        if ( write_file(file,tmp,1) )
                {
                flag++; 
                msg+= data[str[i]]+" ";
                }
        }
if ( flag>0 )
        {
        msg+= "文件长度大于5K，自动清除。\n";
        message("shout",HIR"【系统公告】"+msg+NOR,users());
        }
write("ok\n");
return 1;
}

int help(object me)
{
write(@HELP
指令格式 : clearlog

用于将日志缩减，大于5K的强制清除，请小心使用
HELP
  );
return 1;
}                                               
