#include <ansi.h>
inherit F_CLEAN_UP;
inherit F_DBASE;

string ip2add(string);
int strnotlast(string, string);
void search_dir(string *dir,string address,object me);

int main(object me,string arg)
{
object who, ob;
int i, j, count;
string *dir,*ppls,name,address;
if ( !wizardp(me) )
        return notify_fail("你没有权力使用这个指令。\n");
if ( !arg )
        return notify_fail("指令格式：scc <使用者姓名> | <IP 地址>\n");
count = strlen(arg);
while(count--)
if ( arg[count] == '.' ) 
        {
        name=arg;
        break;
    }
seteuid(getuid());

if ( name!=arg ) 
        {
        name=arg;
        if ( file_size(DATA_DIR+"login/"+name[0..0]+"/"+name+__SAVE_EXTENSION__)<0 )
                return notify_fail("没有这位使用者。\n");
        who = FINGER_D->acquire_login_ob(name);
        if ( !who )
                return notify_fail("这位使用者不在线，并且档案出错。\n");
        write(who->query("name")+"上次从 "+who->query("last_from")+" 上线。\n");
        if ( !who->query("last_from"))
                return notify_fail("OK\n");
        address = ip2add(who->query("last_from"));
        }       
else    address = arg;
write("寻找从 "+address+" 上线的使用者：\n");
dir = get_dir(DATA_DIR + "login/");
if ( name && !environment(who) && !find_player(name) )
        {
        tell_object(me,sprintf(HIC BLK"系统：地址查询 清除临时虚拟玩家[%s%s]物件%O\n",who->query("name"),who->query("id"),who));     
        destruct(who);
        }
search_dir(dir,address,me);
return 1;
}

string ip2add(string ip)
{
int domaincout;
string s1,s2,s3;

domaincout = sscanf(ip,"%s.%s",s1,ip);
if ( domaincout==2 ) 
        domaincout = sscanf(ip,"%s.%s",s2,ip);
else    return (s1);
if ( domaincout==2 ) 
        domaincout = sscanf(ip,"%s.%s",s3,ip);
else    return (s1+"."+ip);
while ( domaincout==2 ) 
        {
        s1=s2; 
        s2=s3;
        domaincout = sscanf(ip, "%s.%s", s3,ip);
    }
return (s1+"."+s2+"."+ip);
}

void search_dir(string *dir,string address,object me)
{
object ob;
int i,j,k;
string *ppls,name,str,adr,s1,s2,s3,s4;
string info;

i = sizeof(dir);
k = 0;
while(i--)
        {               
        ppls = get_dir(DATA_DIR + "login/" + dir[i] + "/");
        for(j=0; j<sizeof(ppls); j++) 
                {
                reset_eval_cost();
                if ( sscanf(ppls[j], "%s.o", str)==1 ) 
                        {
                        ob = new(LOGIN_OB);
                        ob->set("id", str);
                        if ( !ob->restore() ) 
                                {
                                destruct(ob);
                                continue;
                                }
                        if ( !ob->query("last_from") ) 
                                {
                                destruct(ob);
                                continue;
                                }
                        adr = ob->query("last_from");
                        if (strsrch(adr, address)==-1) 
                                {
                                destruct(ob);
                                continue;
                                }
                        info = sprintf("%-10s%-14s%-11s%-6s%s", 
                                        ob->query("id"),
                                        ob->query("name"),
                                        ctime(ob->query("last_on"))[0..10],
                                        ctime(ob->query("last_on"))[20..24],
                                        ob->query("last_from"));
                        tell_object(me,sprintf(HIC BLK"系统：地址查询 %s \n",info));     
                        if ( !query("ID/"+ob->query("id")) )
                                {
                                k++;
                                set("ID/"+ob->query("id"),1);
                                }
                        destruct(ob);
                        }
                }
        }
tell_object(me,sprintf(HIC BLK"系统：地址查询 共有"+to_chinese(k)+"位使用者从这个地址登陆过。\n",info));     
delete("ID");
}

int help(object me)
{
write(@HELP
指令格式： sameip <使用者姓名> | <IP 地址>
              scc <使用者姓名> | <IP 地址>
查找所有与使用者用同一地址上线的使用者。
HELP
  );
    return 1;
}

