//checkbank.c
//by fang

#include <ansi.h>
inherit F_CLEAN_UP;

string do_check(object ob);

string money_str(int amount);
int main(object me, string arg) {
  int i, flag = 0;
  object ob;
  string mission, wname, wmin, file;
  string *wmission;
  if (me != this_player(1)) return 0;
  if (!arg || sscanf(arg, "%s", arg) != 1)
    return notify_fail("指令格式：checkbank <player> \n");

  ob = find_player(arg);
  if (!ob) {
    ob = new(USER_OB);
    ob->set("id", arg);
    if (!ob->restore())
      return notify_fail("没有这个玩家。\n");
    else {
      do_check(ob);
      destruct(ob);
      return 1;
    }
  } else
    do_check(ob);


  return 1;
}

string do_check(object ob) {

  int credit = (int)ob->query("c_balance_credit");
  int newcredit = (int)ob->query("c_balance_newcredit");
  int total = (int)ob->query("c_balance");

  write(ob->name() + HIY "货殖卡" NOR "中目前还有" + money_str(total) + "余额。\n");
  write(ob->name() + HIY "货殖卡" NOR "中目前还有" + chinese_number(newcredit) + "个" HIY "黄金" NOR "信用点。\n");
  write(ob->name() + HIY "货殖卡" NOR "中目前还有" + chinese_number(credit) + "个" HIY "黄金" NOR "捐献点。\n");

  total = (int)ob->query("c_potential");
  credit = (int)ob->query("c_potential_credit");
  write(ob->name() + HIY "货殖卡" NOR "中目前还有" + chinese_number(total) + "点" CYN "潜能" NOR "余额。\n");
  write(ob->name() + HIY "货殖卡" NOR "中目前还有" + chinese_number(credit) + "个" CYN "潜能" NOR "信用点。\n");

}

int help(object me) {
  write(@HELP
指令格式 : checkbank <player>

用来检查用户的货币卡。
HELP
  );
  return 1;
}

string money_str(int amount) {
  string output;
  if (amount / 10000) {
    output = chinese_number(amount / 10000) + "两" HIY "黄金" NOR;
    amount %= 10000;
  } else
    output = "";
  if (amount / 100) {
    output = output + chinese_number(amount / 100) + "两" HIW "白银" NOR;
    amount %= 100;
  }
  if (amount || sizeof(output) < 2)
    return output + chinese_number(amount) + "文" YEL "铜板" NOR;
  return output;
}
