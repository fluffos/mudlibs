#include "/doc/help.h"

inherit F_CLEAN_UP;
int main(object me, string arg)
{
        object obj;
        if (!arg) return notify_fail("指令格式: hunmi <living>\n");
        if( !objectp(obj = present(arg, environment(me)))) 
             return notify_fail("找不到这个玩家。\n");

        if( !obj->is_character() || obj->is_corpse() ) 
              return notify_fail("看清楚一点，那并不是活物。\n"); 

        if(wizardp(obj) && wiz_level(me) < wiz_level(obj)) 
           return notify_fail("上司哟，这样做不太合适吧！\n"); 
        message_vision("$N伸出一只大手将$n拍到在地！！\n",me,obj);
       obj -> save();
       obj->remove_call_out("unconcious"); 
       obj->unconcious(); 
        return 1;
}

int help(object me)
{
   write(@HELP
指令格式: hunmi <玩家> 或 hunmi <living>

使某个生物昏迷。

HELP
);
   return 1;
}

