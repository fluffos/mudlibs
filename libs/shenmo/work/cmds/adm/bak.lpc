#include <ansi.h>
inherit F_CLEAN_UP;

void create() {
  seteuid(getuid());
}

int main(object me, string arg) {
  string sbak, sdak;
  string from, to;
  if (!arg)
    return notify_fail("你的要恢复谁。\n");
  if (me->query("id") != "fang" && me->query("id") != "wuxin")
    return notify_fail("你不是fang,暂时不能使用恢复命令。\n");
  if (FINGER_D->finger_user(arg) != "没有这个玩家。\n")
    return notify_fail("这个id不能使用bak命令。\n");
  sdak = sprintf("/%c/%s", arg[0], arg);
  sbak = "/backup/2012_backup1";
  from = sbak + "/login" + sdak + ".o";
  to = "/data/login" + sdak + ".o";
  if (file_size(from) == -1)
    return notify_fail("这要复制的id,不存在。\n");
  cp(from, to);
  write("" + from + " ---> " + to + "...ok.\n");
  from = sbak + "/user" + sdak + ".o";
  to = "/data/user" + sdak + ".o";
  if (file_size(from) == -1)
    return notify_fail("这要复制的id,不存在。\n");
  cp(from, to);
  write("" + from + " ---> " + to + "...ok.\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式：  bak
           bak [使用者英文代号]
           bak [使用者英文代号]@Mudname
 
这个指令，如果没有指定使用者姓名，会显示出所有正在线上玩家
的连线资料。反之，则可显示有关某个玩家的连线，权限等资料。
 
see also : who, mudlist
HELP
  );
  return 1;
}
