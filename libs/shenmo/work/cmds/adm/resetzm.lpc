#include <ansi.h>
inherit F_CLEAN_UP;

int help(object me);

// value of call parameter
int main(object me, string arg) {
  object who, *inv;
  int i, have = 0;
  if (me != this_player(1) || !wizardp(me))
    return 0;
  seteuid(geteuid(me));
  inv = all_inventory(environment(me));
  i = sizeof(inv);
  while (i--) {
    if (inv[i] && !userp(inv[i])
      && inv[i]->query("current_player")
      && inv[i]->query("current_master_base_name")
      && inv[i]->query("current_master")) {
      have++;
      who = inv[i];
    }
  }
  if (have != 1 || !who)
    return notify_fail("这里没有掌门或是数量不对。\n");
  who->reset_me(who);
  who->save();
  environment(me)->reset();
  message(
    "channel:rumor",
    HIM "【千里眼】某人：听说" + me->name() + "将" + environment(me)->query("short") + HIM "的掌门初始了。\n" NOR,
    users()
  );
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : resetzm
 
这个指令可以将当前房间的掌门数据初始化
HELP
  );
  return 1;
}
