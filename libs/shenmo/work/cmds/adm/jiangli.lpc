// jiangli.c

inherit F_CLEAN_UP;
#include <ansi.h>

int main(object me, string what) {
  object ob, who;
  int i;
  string str, id, reson;

  if (!what)
    return notify_fail("指令格式 jiangli <ID> <物品路径> for <原因>\n");

  if (sscanf(what, "%s %s for %s", id, what, reson) != 3)
    return notify_fail("路径不合法，无法找到物品。\n");

  if (file_size(what) < 0)
    return notify_fail("没有这个档案(" + what + ")。\n");

  seteuid(getuid());

  who = find_player(id);
  if (!who || !living(who))
    return notify_fail("没有" + id + "这个玩家，或该玩家现在不清醒。\n");
  ob = new(what);
  ob->set("no_put", 1);
  ob->set("no_sell", 1);
  ob->set("no_give", 1);
  ob->set("no_steal", 1);
  ob->set("value", 0);
  if (ob->move(who)) {
    tell_object(who, HIG "天上突然掉下了什么东西到你的口袋里，你最好检查一下。\n" NOR);
    message("shout", sprintf(HIR "【系统奖励】%s 奖励 %s %s 〖理由 %s〗。\n" NOR,
      me->query("id"),
      who->query("id"),
      (ob->query("unit") ? ("一" + ob->query("unit")) : "") + ob->name(),
      reson), users());
    write_file("/c/奖励", sprintf("%s 奖励 %s %s 理由 %s。\n" NOR,
      me->query("id"),
      who->query("id"),
      ob->name(),
      reson));
  }
  return 1;
}

int help(object me) {
  write(@HELP
指令格式：jiangli <id> <物品路径> for <原因>

给在线的玩家奖励一件物品。
HELP
  );
  return 1;
}
