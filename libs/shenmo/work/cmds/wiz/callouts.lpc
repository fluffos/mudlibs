// callouts.c
//snowtu
#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  mixed *info;
  int i, k, f, flag = 0;
  string output;

  output = sprintf("%-20s %-6s %s\n", "函数", "延迟", "物件");

  if (!arg)
    info = call_out_info();
  else if (sscanf(arg, "-d %s", arg) != 1)
    info = filter_array(call_out_info(), (: $1[1] == $2 :), arg);
  else {
    if (arg == "all")
      info = call_out_info();
    else info = filter_array(call_out_info(), (: $1[1] == $2 :), arg);
    flag = 1;
  }
  write(sprintf("arg=%s(%d)\n", arg, flag));

  if (flag == 1 && arg = "all") {
    k = 0;
    f = 0;
    reset_eval_cost();
    for (i = 0; i < sizeof(info); i++) {
      if (info[i][2] < 0) {
        if (userp(info[i][0]))
          tell_object(info[i][0], BLINK + HIR "你的外部呼叫出现了严重的错误，请重新登录试试。\n" NOR);
      }
      /*                      
                                continue;
                        if( remove_call_out(info[i][1]) )
                                k++;    
                        else    f++;    
*/
    }
    //              message("shout",HIC"【巫师界】系统(MudOS)："+me->query("id")+"手动清除了 "+k+" 个延迟为负的外部呼叫，同时还有 "+f+" 个延迟为负的外部呼叫无法清除。\n"NOR,users());
    return 1;
  }

  for (i = 0; i < sizeof(info); i++) {
    reset_eval_cost();
    if (flag && info[i][1] == arg) {
      output += sprintf("%O 清除 %s函数 调用成功。\n", info[i][0], arg);
      if (userp(info[i][0]))
        info[i][0]->set_heart_beat(1);
      else {
        if (info[i][0]->query("equipped"))
          info[i][0]->unequip();
        destruct(info[i][0]);
      }
    } else {
      if (sizeof(info[i]) == 4)
        output += sprintf("%-20s %-6d %O %O\n", info[i][1], info[i][2], info[i][0], info[i][3]);
      else output += sprintf("%-20s %-6d %O\n", info[i][1], info[i][2], info[i][0]);
    }
  }
  me->start_more(output);
  return 1;
}

int help() {
  write(@LONG
指令格式：callouts [-d] [<函数名称>]
          callouts [-d] [all]   
查询或删除暂存的呼叫函数
LONG
  );
  return 1;
}
