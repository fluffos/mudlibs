#include "/doc/help.h"

inherit F_CLEAN_UP;
int main(object me, string arg)
{
        object obj;
        if (!arg) return notify_fail("指令格式: xing <living>\n");
        if( !objectp(obj = present(arg, environment(me)))) 
             return notify_fail("找不到这个玩家。\n");

        if( !obj->is_character() || obj->is_corpse() ) 
              return notify_fail("看清楚一点，那并不是活物。\n"); 

        if(wizardp(obj) && wiz_level(me) < wiz_level(obj)) 
           return notify_fail("上司哟，这样做不太合适吧！\n"); 

        message_vision("$N默念了几句咒语，$n“嗖“地噌了起来！！\n",me,obj);

       obj -> save();
       obj->remove_call_out("revive"); 
       obj->revive(); 
       obj->reincarnate(); 
        return 1;
}

int help(object me)
{
   write(@HELP
指令格式: xing <玩家> 或 xing <living>

使某个生物从昏迷状态苏醒。

HELP
);
   return 1;
}

