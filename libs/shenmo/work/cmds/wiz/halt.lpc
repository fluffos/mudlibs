// halt.c

#include "/doc/help.h"
inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob;

  if (arg && wizardp(me))
    ob = present(arg, environment(me));
  if (!ob) return notify_fail("没有这个生物。\n");
  if (!ob->is_fighting()) return notify_fail(ob->name() + "现在不忙。\n");
  if (!me->is_fighting())
    return notify_fail("你现在并没有在战斗。\n");
  me->remove_all_killer();
  me->remove_all_enemy();
  ob->remove_all_killer();
  ob->remove_all_enemy();
  message_vision("$N用巫师的神力停止了这场打斗。\n", me);
  write("Ok.\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式: halt

可以停止所有与你有关的战斗。
HELP
  );
  return 1;
}
