#include <ansi.h> 

inherit BULLETIN_BOARD;

void create()
{
        set_name("留言板", ({ "board" }) );
        set("location", "/u/djx/workroom.lpc");
        set("board_id", "gslxz_b");
        set("long",     "由于本人比较忙，所以大家有什么事请在此给我留言。:)\n" );
        setup();
        set("capacity", 200);
        replace_program(BULLETIN_BOARD);
}


