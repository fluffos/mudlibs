#include <armor.h>
#include <ansi.h>
inherit ARMOR;

void check_owner();
void destroy(object ob);

void create() {
  set_name(HIY "黄金圣衣" NOR, ({ "huangjin shengyi", "shengyi", "armor" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("no_sell", 1);
    set("value", 0);
    set("material", "steel");
    set("armor_prop/armor", 360);
    set("armor_prop/spells", 100);
    set("armor_prop/dodge", 40);
    set("armor_prop/parry", 40);
    set(" no_get", 1);
    set(" no_give", 1);
    set(" no_put", 1);
  }
  setup();
}

void init() {
  check_owner();
}


void check_owner() {
  object ob = this_object();
  object me = environment(ob);
  if (!me->query("sds3/all"))
    destroy(ob);
}

void destroy(object ob) {
  write(ob->query("name") + HIC "化作一道流星消失在天际！ \n" NOR);
  destruct(ob);
  return;
}

