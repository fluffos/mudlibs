inherit NPC;

string *names = ({
  "青云马",
  "蓝风雕",
  "紫雷龙",
  "白水龟",
  "红土蚤",
  "黑冥犬",
  "金乾豹",
  "黄坤虎",
});

void create()
{
  set_name(names[random(sizeof(names))], ({"guai shou", "shou"}));
  set("race", "野兽");
  set("age", 10);

  set_skill("dodge", 120);
  set("combat_exp", 10000);
  set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }) );
  set("verbs", ({ "bite"}));

  set("chat_chance", 1);

  set("ride/msg", "骑");
  set("ride/dodge", 10+random(6));
  set_temp("apply/attack", 10);
  set_temp("apply/armor", 20);

  setup();
}
