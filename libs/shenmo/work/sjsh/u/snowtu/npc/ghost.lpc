// pet.c writted by Beeby. 07/28/2000

inherit NPC;
inherit F_SAVE;

private string SAVE_NAME="pet_save";
private nosave int can_save=1;

//void try_move();

void create()
{	
seteuid(getuid());	
set_name("式神", ({"ghost"}) );
set("gender", "女性");
set("race","野兽");
set("age", 1);
set("base_name","兔");
set("attitude", "friendly");
set("long","式神。\n");
set("combat_exp", 1);
set("str",3);
set_skill("unarmed",10);
set_temp("apply/attack", 80);
set_temp("apply/armor", 80);
setup();
}

void reset()
{
if( !environment() )
        {
                destruct(this_object());
                return;
        }
}

void die()
{
	message_vision("远处传来一呼哨，$N一下子就窜得没影了。\n",this_object());
	destruct(this_object());
}

void unconcious()
{
	return die();
}

string query_save_file()
{
        string id;
        id = query("owner");
        if( !id ) return 0;
        return sprintf(DATA_DIR"ghost/%c/%s", id[0], id);
}


