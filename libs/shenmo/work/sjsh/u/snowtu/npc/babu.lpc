#include <ansi.h>
#include <combat.h>
inherit NPC;   
#include "place.h"
void kill_ob(object ob); 
void auto_full(object who); 

void create()
{   
	int i,k,m,n;  
	string name,*id;   
	i=(random(sizeof(name1)/2))*2;   
	k=(random(sizeof(name2)/2))*2;   
	m=(random(sizeof(title1)));   
	n=(random(sizeof(title2)));   
	name=name1[i]+name2[k];  
	id=({name1[i+1]+" "+name2[k+1],name2[k+1]});   
	set_name(name, id);   
	set("title", HIC+title1[m]+title2[n]+NOR);   
	set("long", HIC"大乘经传道者，为湿婆麾下八部众之一。\n"NOR);   
	set("gender",((random(2)==1)?"男性":"女性"));   
	set("max_sen",6000);   
	set("eff_sen",6000);   
	set("sen",6000);   
	set("max_kee",6000);   
	set("eff_kee",6000);   
	set("kee",4000);   
	set("combat_exp", random(300000));   
        set("bellicosity", 100+random(900));   
	set("daoxing",random(3000000));   
        set("chat_chance", 50);
        set("chat_msg", ({ 
             (: random_move :) ,
        }) );
	setup( ); 
	create_family("南海普陀山",2, "密宗"); 
	set_skill("unarmed", 200);   
	set_skill("dodge", 200);   
	set_skill("staff", 200);   
	set_skill("parry", 200);   
	set_skill("force", 200);  
	set_skill("lotusforce", 200);  
	set_skill("jienan-zhi", 200);  
	set_skill("lotusmove", 200);  
	set_skill("lunhui-zhang", 200);  
	set_skill("buddhism", 200);  
	map_skill("unarmed","jienan-zhi");   
	map_skill("dodge","lotusmove");   
	map_skill("staff","lunhui-zhang");   
	map_skill("parry","lunhui-zhang");   
	map_skill("force","lotusforce");   
	map_skill("spells","buddhism");   
} 
       
void init() 
{   
	remove_killer(this_player());   
	remove_enemy(this_player()); 
	add_action("do_none","cast");   
	add_action("do_none","ji");   
	add_action("do_none","apply");   
	add_action("do_none","fight");  
	::init();   
} 
       
string accept_kill(object ob)
{
if ( !userp(ob) )
	return "小猫小狗的也来凑什么热闹？！";
}

void kill_ob (object ob)
{   
	object who = this_object();   
	if (who->is_fighting() || !living(who) )   
	{  
	command ("chat "+ob->query("name")+"居然乘人之危，唉，看来人间道真的是没好孩子了！");     
	message_vision ("$N叫嚷“想不到$n的人品这么差，真是叫人失望.....”\n",who,ob);     
	destruct(who);  
	}   
	auto_full(who);
	set_temp("my_killer",ob);   
	call_out("kicks",2+random(3)); 
	::kill_ob(ob);     
} 
       
int do_none() 
{  
	object ob = this_object();   
	object me = this_player();   
	message_vision("\n$N对着$n摇了摇头。\n\n",ob,me);   
	return 1;   
} 
       
void die() 
{  
string name,ob_name,id;
object armor = new(gift[random(sizeof(gift))]);
object me = query_temp("my_killer");  
object ob = this_object();  
object where ;  
object obj = new ("/d/nanhai/npc/babu");  
if (!me)
  	{ 
	ob->delete_temp("my_killer");  
	return 0; 
	} 
armor->move(me);  
message("channel:rumor",HIM"【"+HIC+"般若摩诃"+HIM+"】某人："HIW+me->query("name")+"("+me->query("id")+")"+HIM"夺到了密宗"+HIY"宝物:"+armor->query("name")+HIM"！\n"NOR,users());   
destruct(this_object());  
where=place[random(sizeof(place))];
name=where->query("short");
obj->move(where);
ob_name=obj->query("name");
id=obj->query("id");
message("channel:rumor",HIM"【"+HIC+"般若摩诃"+HIM+"】湿婆(Shi po)：麾下八部众"NOR+HIY+ob_name+HIY"("+id+HIY")"NOR+HIM"已经云游至"+HIY+name+HIM"！\n"NOR,users());    
if( environment() || ob->query("kee")<10 || ob->query("sen")<10 )
	{
	die();
	}
} 
      
 void auto_full(object who) 
 { 
object sth; 
object ob=this_player(); 

if ( (int)ob->query("combat_exp")>5000000 )  
	set("combat_exp",ob->query("combat_exp"));
else set("combat_exp",5000000);    

set("daoxing",ob->query("daoxing"));    

if( (int)ob->query_skill("dodge",1)>200) 
	set_skill("dodge", (int)ob->query_skill("dodge",1) ); 
else set_skill("dodge",200);  

if( (int)ob->query_skill("force",1)>200) 
	set_skill("force", (int)ob->query_skill("force",1) ); 
else set_skill("force",200);  

if( (int)ob->query_skill("spells",1)>200) 
	set_skill("spells", (int)ob->query_skill("spells",1) ); 
else set_skill("spells",200);  

if( (int)ob->query_skill("parry",1)>200) 
	set_skill("parry", (int)ob->query_skill("parry",1) ); 
else set_skill("parry",200);  

if( (int)ob->query_skill("force",1)>200) 
	set_skill("unarmed", (int)ob->query_skill("force",1) ); 
else set_skill("unarmed",200);  

if( (int)ob->query_skill("dodge",1)>200) 
	set_skill("lotusmove", (int)ob->query_skill("dodge",1) ); 
else set_skill("lotusmove",200);  

if( (int)ob->query_skill("force",1)>200) 
	set_skill("lotusforce", (int)ob->query_skill("force",1) ); 
else set_skill("lotusforce",200);  

if( (int)ob->query_skill("spells",1)>200) 
	set_skill("buddhism", (int)ob->query_skill("spells",1) ); 
else set_skill("buddhism",200);  

if( (int)ob->query_skill("force",1)>200) 
	set_skill("staff", (int)ob->query_skill("force",1) ); 
else set_skill("staff",200);  

if( (int)ob->query_skill("force",1)>200) 
	set_skill("lunhui-zhang", (int)ob->query_skill("force",1) ); 
else set_skill("lunhui-zhang",200);  

if( (int)ob->query_skill("force",1)>200) 
	set_skill("jienan-zhi",  (int)ob->query_skill("force",1) ); 
else set_skill("jienan-zhi",200);  

map_skill("unarmed","jienan-zhi");   
map_skill("dodge","lotusmove");   
map_skill("staff","lunhui-zhang");   
map_skill("parry","lunhui-zhang");   
map_skill("force","lotusforce");   
map_skill("spells","buddhism");   

if (ob->query("max_sen")>3000)  
	set("max_sen",(int)ob->query("max_sen")); 
else set("max_sen",3000);   

if (ob->query("max_kee")>3000)  
	set("max_kee",(int)ob->query("max_kee")); 
else set("max_kee",3000);    

if (ob->query("max_sen")>3000)  
	set("eff_sen",(int)ob->query("max_sen")); 
else set("eff_sen",3000);     

if (ob->query("max_kee")>3000)  
	set("eff_kee",(int)ob->query("max_kee")); 
else set("eff_kee",3000);     

if (ob->query("max_sen")>3000)  
	set("sen",(int)ob->query("max_sen")); 
else set("eff_sen",3000);     

if (ob->query("max_kee")>3000)  
	set("kee",(int)ob->query("max_kee")); 
else set("eff_kee",3000);     

if (ob->query("max_force")>3000)  
	set("max_force",(int)ob->query("max_force")); 
else set("max_force",3000);    

if (ob->query("max_force")>3000)  
	set("force",(int)ob->query("max_force")*2); 
else set("force",6000);    

if (ob->query("max_mana")>3000)    
	set("mana",(int)ob->query("max_mana")*2); 
else  set("mana",6000);    

if (ob->query("max_mana")>3000)  
	set("max_mana",(int)ob->query("max_mana")); 
else set("max_mana",3000);    

set("force_factory",(int)query_skill("force")/2);    
set("mana_factory",(int)query_skill("spells")/2);    

	sth=new("/d/city/npc/obj/armor");sth->move(who);    
	sth=new("/d/city/npc/obj/shoes");sth->move(who);    
	sth=new("/d/city/npc/obj/pifeng");sth->move(who);    
	sth=new("/d/city/npc/obj/shield");sth->move(who);    
	sth=new("/d/city/npc/obj/kui");sth->move(who);    
	sth=new("/d/obj/weapon/staff/budd_staff");sth->move(who);    

message_vision(YEL"\n$N怜惜的看着$n摇了摇头“自作孽，不可活，我来送你一程！”\n"NOR,who,ob);  
command("remove all");   
command("wield all");   
command("wear all");   
return ; 
} 
      
void kicks( )   
{  
object ob=this_object();  
object me=query_temp("my_killer");  
if( ! me ) return; 
if(! present(me,environment()) )  
	{  
	ob->delete_temp("my_killer");  
	remove_call_out("kicks");  
	return;  
	} 
if (ob->is_fighting() && living(ob)  )   
{
if ( ob->query_temp("weapon") )
	{
	set("chat_chance_combat", 80);   
	set("chat_msg_combat", ({  
		(: cast_spell, "jingang" :),  
		(: cast_spell, "lianhua" :),  
		(: perform_action, "staff", "fire" :),  
		}) );   
	}
	else      {
	set("chat_chance_combat", 80);   
	set("chat_msg_combat", ({  
		(: cast_spell, "jingang" :),  
		(: cast_spell, "lianhua" :),  
		(: perform_action, "unarmed", "lingxi" :),  
		(: perform_action, "unarmed", "rulai" :),  
		}) );   
	}

switch(random(3)) 
	{
		case 0:
		{
		message_vision(HIY"$N念动五字真言，双手捏『静心诀』，对着$n大喝一声“定”！\n",ob,me);  
		if(random(2)==0)  
			{  
			message_vision(HIY"$N心神一颤，已挨了$n一下重击！\n"NOR,me,ob);  
			me->add("eff_kee",-query("max_kee")/20);  
			me->add("eff_sen",-query("max_sen")/20);  
			}  
		else  message_vision(HIW"$N咬破舌尖，对着$n喷了一口鲜血“妖术惑众”$n不由法术回震，心神恍惚，不知自己身在何方。\n"NOR,me,ob);  
		}
     		break;

		case 1:
		{
		message_vision(HIW+msgs[random(sizeof(msgs))]+NOR,ob);  
		if( random(2)==0 )  
			{         
			message_vision(HIC"$N闻此经文,不禁心神恍惚,不知身在何处。\n"NOR,me);  
			me->start_busy(5); 
			me->move("/d/changan/zhongnan");
			message_vision(HIC"$N慢慢清醒了过来。\n"NOR,me);  
			}  
		else 	message_vision(HIW"$N大喝一声“我就是佛，佛就是我，佛又为何?”$n不由浑身一震，心神恍惚。\n"NOR,me,ob);  
		} 
		break;

		case 2:
		{
		if ( ob->query_temp("weapon") )
			{
			set("chat_chance_combat", 80);   
			set("chat_msg_combat", ({  
              		(: cast_spell, "jingang" :),  
	              	(: cast_spell, "lianhua" :),  
		              (: perform_action, "staff", "fire" :),  
       		        }) );   
			}
		else      {
			set("chat_chance_combat", 80);   
			set("chat_msg_combat", ({  
              		(: cast_spell, "jingang" :),  
	              	(: cast_spell, "lianhua" :),  
		              (: perform_action, "unarmed", "lingxi" :),  
		              (: perform_action, "unarmed", "rulai" :),  
       		        }) );   
			}
		}
		break;
		default:
		{
              message_vision(HIC+msgs[random(sizeof(msgs))]+"\n"NOR,ob);  
		ob->set("sen",query("max_sen"));  
		ob->set("kee",query("max_kee"));  
		ob->set("eff_sen",query("max_sen"));  
		ob->set("eff_kee",query("max_kee"));  
		break;
		}
     	}
remove_call_out("kicks");  
call_out("kicks",2+random(3));  
 }
} 
      
