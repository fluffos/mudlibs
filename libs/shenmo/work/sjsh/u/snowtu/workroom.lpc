//眠兔工作室
#include <ansi.h>
inherit ROOM;

void create ()
{
        set ("short", HIC"郁"+HIY"桂"+HIB"冷"+HIM"蟬"+HIC"宮"+HIG"·"+HIW"兔窝"NOR);
        set ("long", @LONG
□ 巫师指令
[档案处理]:cd,more,ls,rm,cat,edit,mv,rmdir,cp,mkdir,tail
[物件处理]:call,dest,localcmds,update,clone,ilist
[查询指令]:config,mudlist,cost,whoami,ff,info,qload,mem,status,where,pwd,ulist
[系统管理]:dump,profile,purge,shutdown,callouts,chinese,cleanup,possess
[系统管理]:rehash,reclaim,reboot,promote,wizlock,edemote,snoop
[其他]:goto,halt,summon,smash

□ 巫师环境变数
1.immortal <anything>       设定自己成为不死之身，当状态达到昏迷或死亡时数值
2.invisibility <number>     设定隐形的程度。 0 - 10
3.msg_home <anything>       设定当自己打 home 回家时显示的讯息。
4.msg_min <anything>        设定当使用 goto 到达某处时, 别人所看到的讯息。
5.msg_mout <anything>       设定当使用 goto 离开时, 原来房间里的人所看到的讯息。
6.msg_clone <anything>      设定当 clone NPC 或 OBJ 时所显示的讯息。
7.msg_dest <anything>       设定当 dest NPC 或 OBJ 时所显示的讯息。但如果该 OBJ
LONG);

set("exits",([
	"kz" : "/d/city/kezhan",
	"+" : "/d/city/center",
	"wiz" : "/d/wiz/wizroom",
	"kzu" : "/d/wiz/system",
]));

set("objects", ([
    "/u/snowtu/npc/fighter" : 1,
//    "/d/dntg/sky/npc/moli-qing" : 1,
//    "/u/snowtu/npc/anong" : 1,
    "/clone/money/jinbi" : 20,
    "/newworld/city/npc/npc" : 1,
]));
set("valid_startroom", 1);
set("no_time",1);
set("no_upgrade_age",1);
set("freeze",1);
set("chat_room",1);
setup();
}

void init()
{
object me = this_player();
if ( me->query("id")!="snowtu" ) return;
add_action("do_dig","dig");
add_action("do_bed","bed");
}

int do_bed()
{
object me = this_player();
message_vision(HIY"\n$N掀开纱帐，准备上床了。\n\n" NOR, me); 
me->move(__DIR__"bed");
message_vision(HIY"\n沙帐轻轻一动，$N钻了进来。\n" NOR, me); 
return 1;
}

int do_dig(string arg)
{
object obj;
object me = this_player();
if (!arg || !me )
	return notify_fail("你想挖什么？\n");
if ( arg=="stone" )
	{
	obj=new("/d/snowtu/obj/weapon/wuxian");
	obj->move(me);
	message_vision(HIY"$N在地上摸索了半天，终于从草丛里翻出了个"+obj->query("name")+HIY"。\n"NOR,me);
	}
if ( arg=="mao" )
	{
	obj=new("/u/snowtu/obj/mao");
	obj->move(me);
	message_vision(HIY"$N在地上摸索了半天，终于从草丛里翻出了个"+obj->query("name")+HIY"。\n"NOR,me);
	}
if ( arg=="zhua" )
	{
	obj=new("/d/snowtu/obj/weapon/zhua");
	obj->move(me);
	message_vision(HIY"$N在地上摸索了半天，终于从草丛里翻出了个"+obj->query("name")+HIY"。\n"NOR,me);
	}
if ( arg=="jinbi" )
	{
	obj=new("/clone/money/jinbi");
	obj->move(me);
	message_vision(HIY"$N在地上摸索了半天，终于从草丛里翻出了个"+obj->query("name")+HIY"。\n"NOR,me);
	}
return 1;
}


