#include <ansi.h>
inherit ROOM;

void create()
{
set("short",HIC"空中"NOR);
set("long",@LONG
云烟缭绕，风在耳边呼呼的掠过，前面雾气弥漫，看不到尽头。
LONG);
set("water",1);
setup();
}

void init()
{
object toy;
object me = this_player();
if ( (me->query_temp("ridee"))->query("name")!="腾蛇" )
   {
	message_vision(HIG"一股寒风吹过,$N来不及反应,已给掉进弱水中!\n",me);
	me->die();
	}
	
else   {
/*
	remove_call_out("going");
	call_out("going",5, me);
*/
	}
}

