// 昆仑仙境路上·腾蛇snake.c

#include <ansi.h>
inherit NPC;


void create() {
  set_name(HIY "腾蛇" NOR, ({ "teng she", "she" }));
  set("long", HIW "一只修行万年的怪蛇，额头上镶着一块闪闪发光的" + HIR "红宝石" NOR + HIY "。\n" NOR);
  set("race", "野兽");
  set("age", 10);

  set("combat_exp", 10000);
  set("max_kee", 1000);
  set("kee", 1000);
  set("eff_kee", 1000);
  set("max_sen", 1000);
  set("sen", 1000);
  set("eff_sen", 1000);

  set("limbs", ({ "头部", "身体", "尾巴" }));
  setup();
}

void init() {
  add_action("do_mount", "mount");
  add_action("do_wei", "wei");
  add_action("do_dismount", "dismount");
}

int do_dismount() {
  return notify_fail(HIR "脚下便是弱水，想死你早说啊！\n" NOR);
}

int do_mount(string arg) {
  object rider;
  object ridee;
  object me = this_object();
  object who = this_player();
  object where = environment(who);

  ridee = who->query_temp("ridee");
  if (ridee && environment(ridee) != environment(who))
    ridee = 0;

  if (ridee)
    return notify_fail("你已经在" + ridee->name() + "上了！\n");

  message_vision("$N小心翼翼的跨在$n的背上！\n", who, me);
  me->set_temp("no_return", 1);
  me->set_temp("rider", who);
  who->set_temp("ridee", me);
  me->move(where);
  who->set_temp("ride/dodge", me->query("ride/dodge"));
  who->add_temp("apply/dodge", me->query("ride/dodge"));
  return 1;
}
