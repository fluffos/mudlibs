#include <armor.h>
#include <ansi.h>
#include <combat.h>

inherit SHIELD;
//inherit F_UNIQUE;
void jia_condition(object me, object ob);
void check_owner();
void destroy(object ob);

string *names = ({
  HIB "巴尔安" NOR, HIW "海马座" NOR,
  HIC "斯基拉" NOR, HIB "六头怪座" NOR,
  HIY "克修拉" NOR, HIY "海皇子座" NOR,
  HIB "隆耐狄斯" NOR, HIB "水怪座" NOR,
  HIW "艾尔扎克" NOR, HIW "古拉基座" NOR,
  HIM "苏兰特" NOR, HIM "海魔女座" NOR,
  HIY "加隆" NOR, HIC "海龙座" NOR,
});
int j = (random(sizeof(names) / 2)) * 2;
string name = names[j];
string title = names[j + 1];

void create() {
  set_name(HIY "海皇の盾" NOR, ({ "sea dun", "dun", "shield" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "wood");
    set("armor_prop/armor", 100);
    set("armor_prop/dodge", -5);
  }
  setup();
}

int init() {
  check_owner();
  add_action("do_wear", "wear");
  add_action("do_remove", "remove");
}

void check_owner() {
  object ob = this_object();
  object me = environment(ob);
  if (me->query("sds4/king") != "done" && !wizardp(me))
    destroy(ob);
}

void destroy(object ob) {
  message_vision(HIY "天空中伸出一只大手,一把抓起$N" HIY "！\n" NOR, ob);
  destruct(ob);
  return;
}

int query_autoload() {
  object ob = this_object();
  object me = environment(ob);
  if (me->query("sds4/king") != "done" && !wizardp(me))
    return 0;
  else
    return 1;
}

int do_wear(string arg) {
  object me = this_player();
  object jia = this_object();
  string name = jia->query("name");
  string id = jia->query("id");
  string msg;

  if (arg != "all" && arg != id)
    return notify_fail("你要穿什么？\n");

  msg = HIG "$n" HIG "从虚无中“呼”的出现在$N" HIG "的身上。\n" NOR;
  jia->set("wear_msg", msg);
  remove_call_out("jia_condition");
  call_out("jia_condition", 1, me, jia);
  return 0;
}

int do_remove(string arg) {
  object me = this_player();
  object jia = this_object();
  string name = jia->query("name");
  string id = jia->query("id");
  string msg;

  if (arg != "all" && arg != id)
    return notify_fail("你要脱什么？\n");

  msg = HIG "$n" HIG "呼的从$N" HIG "身上消失了。\n" NOR;
  jia->set("remove_msg", msg);
  remove_call_out("jia_condition");
  return 0;
}

void jia_condition(object me, object ob) {
  int invocation_time;
  object soldier;

  invocation_time = 30 + random((2000 - (int)me->query_skill("spells")));
  if (invocation_time < 30) invocation_time = 30;
  if ((time() - me->query("last_invocation")) < invocation_time) {
    message("vision", name() + HIR "上闪了几闪毫光......\n" NOR, environment(), ob);
    return;
  }

  if (!me->is_fighting()) {
    message("vision", name() + HIG "上闪了几闪毫光......\n" NOR, environment(), ob);
    return;
  }

  message("vision", name() + HIG "上忽然闪出一道毫光!\n" NOR, environment(), ob);
  me->set("last_invocation", time());
  call_out("hufa", 1, me);
}

void hufa(object me) {
  int i;
  object target, *enemy;
  enemy = me->query_enemy();
  message_vision(
    HIG "毫光一闪," + title + name + HIG "出现在众人面前。\n" + name + HIG "说道：受海皇之命，特来相助！\n" NOR,
    me
  );

  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      target = enemy[i];
      remove_call_out("hufa");
      call_out("hufa2", 1, me, target);
    }
  }
}

int hufa2(object me, object target) {
  int i, k, damage;
  string *limbs;
  object weapon;


  if (!target || !living(target)) {
    message_vision(name + HIG "说道：某受海皇之命，特来救助，现机缘已尽，就此告辞！\n"
      +name + HIG "脚下升起一潭春水,整个人隐没不见。\n" NOR, me, target);
    remove_call_out("hufa2");
    return 0;
  }

  switch (random(8)) {
    case 1:
      {
        damage = 5000 + random(500);
        limbs = target->query("limbs");
        k = random(60);
        //************************************************
        if (k < 10) {
          if (target->is_busy())
            return 0;
          message_vision(
            name + HIB "大喝一声：魔鹰之喙。$n眼前一花，" + name + HIB "一跃腾空，仿若恶魔之鹰，往$n眼睛啄击而来。\n" NOR,
            me,
            target
          );
          if (random(3) < 2) {
            message_vision(HIR "$n一个躲闪不及，只觉得眼睛一阵剧痛，什么也看不见了。\n" NOR, me, target);
            target->start_busy(2 + random(2));
          } else {
            message_vision(HIG "$n急忙飞身而退，避过夺眼之险。\n" NOR, me, target);
          }
        }
        //************************************************
        else if (k < 20) {
          message_vision(
            name + BLU "大喝一声：恶狼之牙。$n只觉得杀气扑面，" + name + BLU "已化做一头巨大恶狼，张着血盆大口往$n猛噬过来。\n" NOR,
            me,
            target
          );
          if (random(3) < 3) {
            message_vision(HIR "$n一不疏忽，被恶狼一口咬住咽喉，顿时血流而注，赶忙运劲招架，险被咬破喉咙。\n" NOR, me, target);
            damage = 200 + random(300);
            target->receive_damage("kee", damage);
            target->receive_wound("kee", damage / 2);
            COMBAT_D->report_status(target);
          } else {
            message_vision(HIG "$n急忙抽身而退，避过此招。\n" NOR, me, target);
          }
        }
        //*************************************************
        else if (k < 30) {
          message_vision(
            name + HIY "大喝一声：女王峰之刺。右手戟指往$n" + HIW + limbs[random(sizeof(limbs))] + HIY "猛刺而来。\n" NOR,
            me,
            target
          );
          if (random(3) < 2) {
            message_vision(HIC "$n一个躲闪不及，被刺个正着,身上多了个针孔般的小伤口，伤处不痛不痒。\n" NOR, me, target);
            target->apply_condition("fengdu", 2 + random(3));
          } else {
            message_vision(HIG "$n深知此招厉害，左躲右闪总算避过了这招。\n" NOR, me, target);
          }
        }
        //************************************************
        else if (k < 40) {
          if (!weapon = target->query_temp("weapon")) return 0;
          message_vision(name + HIB "大喝一声：巨蟒之牙，右手成蛇状，迅疾往$n猛攻而来。\n" NOR, me, target);
          if (random(3) < 2) {
            message_vision(
              HIR "$n急忙用手中" + weapon->query("name") + HIR "攻去，只见" + name + HIR "右手随着" + weapon->query("name") + HIR "来势，一把将其打脱下来。\n" NOR,
              me,
              target
            );
            weapon->unequip();
            weapon->move(target);
            target->reset_action();
          } else {
            message_vision(HIG "$n深知打蛇随棍上的道理，与" + name + HIG "互拼一掌，化去此招。\n" NOR, me, target);
          }
        }
        //************************************************
        else if (k < 50) {
          message_vision(name + HIB "大喝一声：吸血蝙蝠之牙,双手成爪，往$n的脖颈抓来。\n" NOR, me, target);
          if (random(3) < 2) {
            message_vision(
              HIR "$n急忙闪身，" + name + HIR "却不知道什么时候来到了身后，对准$n的脖子就是一爪。\n" NOR,
              me,
              target
            );
            target->add("kee", -500);
            me->add("kee", 500);
            if (me->query("kee") > me->query("max_kee")) me->set("kee", me->query("max_kee"));
          } else {
            message_vision(HIG "$n急忙一跃，凌空一个翻身，闪过此招。\n" NOR, me, target);
          }
        }
        //***********************************************
        else {
          message_vision(
            name + HIW "大喝一声，北极熊之爪。$n眼前一花，眼前似乎出现了一头巨大的北极熊，猛的一爪打了过来。\n" NOR,
            me,
            target
          );
          if (random(3) < 2) {
            message_vision(HIR "$n一个躲闪不及，被打了个正着，顿时鲜血狂喷。\n" NOR, me, target);
            damage = 300 + random(500);
            target->receive_damage("kee", damage);
            target->receive_wound("kee", damage / 2);
            COMBAT_D->report_status(target);
          } else {
            message_vision(HIG "$n急忙运劲招架，硬是架住了这一击。\n" NOR, me, target);
          }
        }
      }
      break;

    case 2:
      {
        damage = 100 + random(500);
        message_vision(name + HIY "右手虚空一握，手中豁然出现了一把金光闪闪的黄金枪。\n" NOR, me, target);
        message_vision(name + HIY "大喝一声将手中黄金枪脱手掷出，在空中高低左右回旋。\n", me, target);
        if (random(3) < 2) {
          target->receive_damage("kee", damage);
          target->receive_wound("kee", damage / 2);
          COMBAT_D->report_status(target);
        } else {
          message_vision(HIG "$N看得分明，身形一让，避过了这招！\n" NOR, target);
        }
      }
      break;

    case 3:
      {
        damage = 100 + random(500);
        message_vision(name + HIC "身体急旋，四周气劲激荡，已然化作一猛烈飓风，卷起千层巨浪，直冲云霄。\n" NOR, me, target);
        message_vision(
          HIW "\n$n正暗叹此招威势无匹，飓风突散，" + name + HIW "身形已定，宛若天外飞瀑，携着奔流往$n直击而来。\n",
          me,
          target
        );
        if (random(3) < 2) {
          message_vision(HIR "$n已被此威势所摄，心神大骇下，被轰个正着。\n\n" NOR, me, target);
          target->receive_damage("kee", damage);
          target->receive_wound("kee", damage / 2);
          COMBAT_D->report_status(target);
        } else {
          message_vision(HIG "$n面对滔天巨浪，不知如何躲闪，只得使个懒驴打滚，狼狈不堪，却险险躲过此招。\n" NOR, me, target);
        }
      }
      break;

    case 4:
      {
        message_vision(name + HIG "一声大吼，付于$N身，对$n发起一阵攻击！\n" NOR, me, target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
      }
      break;

    case 5:
      {
        message_vision(
          name + HIW "右拳不断晃圈，速度越来越快，只见内劲缓缓聚集在" + name + HIW "右拳之上,形成了一道旋风。\n" NOR,
          me,
          target
        );
        message_vision(name + HIC "大喝一声：旋风真空拳，右拳猛的击出。\n" NOR, me, target);
        if (random(3) > 2 || target->is_busy()) {
          message_vision(HIG "$n乘着风势在旋风之中起起落落，毫发无伤。\n" NOR, me, target);
        } else {
          message_vision(HIR "$n一个失神，已被袭来的旋风卷中，身形失控。\n" NOR, me, target);
          target->start_busy(2 + random(2));
        }
      }
      break;

    default:
      {
        message_vision(HIC "\n随着" + name + HIC "一声怒喝，$n顿觉天色转暗，仿佛置身于宇宙之中，星光闪闪。\n" NOR, me, target);
        i = random(20);
        if (target->is_busy()) i = 5;
        if (i < 10) {
          message_vision(HIW "\n突然之间，万星陨落，化做万千陨石望$n扑天盖地袭来。\n" NOR, me, target);
          if (random(3) < 2) {
            message_vision(HIR "$n一时手忙脚乱，不知所措，被撞得鲜血狂喷。\n" NOR, me, target);
            target->receive_damage("kee", damage);
            target->receive_wound("kee", damage / 2);
            COMBAT_D->report_status(target);
          } else {
            message_vision(HIG "$n心神剧骇，赶忙运气凝神，一声大吼，重重幻象顿时消去。\n\n" NOR, me, target);
          }
        } else {
          message_vision(HIW "\n忽然眼前出现一个巨大黑洞，巨大的吸力将点点万星全部吞噬，$n亦不由自主被吸扯过去。\n" NOR, me, target);
          if (random(3) < 2) {
            message_vision(HIR "$n急忙运劲相抗，堪堪稳住身形，却已无法动弹。\n\n" NOR, target, target);
            target->start_busy(2 + random(2));
          } else {
            message_vision(HIG "$n心神剧骇，赶忙运气凝神，一声大吼，重重幻象顿时消去。\n\n" NOR, me, target);
          }
        }
      }
      break;
  }
  remove_call_out("hufa2");
  call_out("hufa2", 3 + random(4), me, target);
  return 1;
}
