//by djx
inherit ITEM;
#include <ansi.h>

void drinked(object obj);
string *order = ({
	HBRED"威士忌"NOR, 
	HBWHT"香摈"NOR, 
	HBMAG"长城"+HIR"干红"NOR, 
	HBMAG"长城"+HIR"干白"NOR, 
	HBCYN"青岛啤酒"NOR, 
	HBBLU"解百纳"NOR, 
	HBWHT"二锅头"NOR, 
	HIB"鸡"HIW"尾"HIC"酒"NOR, 
	HBYEL+HIW"五粮液"NOR, 
});

void init()
{
        add_action("do_drink", "drink");
}

void create()
{
set_name( (order[random(sizeof(order))]), ({ "jiu" }) );
set_weight(80);
if( clonep() )
	set_default_object(__FILE__);
else {
	set("long", HIC"一  瓶  美  酒  。 \n"NOR);
	set("unit", "瓶");
       set("count",8);
	}
}


int do_drink(string arg)
{
        object me = this_player();
        object obj = this_object();

        if(environment(obj) != me || !arg || arg!="jiu" )
                return notify_fail("瘾上来了？\n");

        add("count",-1);
        me->add("water", 50);
        me->add("food", 50);
        switch(query("count")) {
                case 1: message_vision("$N仰头将$n中的酒一干而尽，哈哈狂笑，把$n砸的粉碎，摔在地上！\n", me,obj);
			      break; 	
                case 2: message_vision("$N醉眼迷离的打了个饱嗝，摇了摇$n“酒来，酒来......”\n", me,obj);
                        break;
                case 3: message_vision("$N摇头晃脑，又抿了一口$n，一股酒气扑面而来！\n", me, obj);
                        break;
                case 4: message_vision("$N脸涨的通红，看来$n是喝多了点。\n", me, obj);
                        break;
                case 5: message_vision("$N喝了一口$n，摇头晃脑地说道：“独自一个人流泪～～～到天亮......”\n", me, obj );
                        break;
                case 6: message_vision("$N抬头猛灌了一口$n，自言自语道：“酒能买醉，今夕何夕？”\n", me, obj);
                        break;
                case 7: set("master", me->query("id"));
                        message_vision("$N从口袋里掏出一瓶$n，拿"BLINK HIW"牙"+NOR"咬开瓶盖，美滋滋地喝了起来。\n", me, obj);
                        break;
                default:
                        break;
        }        
        if(query("count") > 1) call_out("do_drink", 5);
        else {
		obj->set_name(HIB+me->query("name")+"砸碎的酒瓶"NOR,({"sui jiu ping"}));
		obj->set("long",HIC"被"+me->query("name")+"砸碎的酒瓶"NOR);
		obj->set("no_get",1);
		obj->unequip();
		obj->move(environment(me));
		call_out("drinked",random(60),obj);
		}
        return 1;
}

void drinked(object obj)
{
  if(obj && environment(obj)) {
    tell_object(environment(obj),
      "一阵微风吹过，"+obj->name()+"化为片片尘土，消失不见了。\n");
    destruct(obj);
  }
}


