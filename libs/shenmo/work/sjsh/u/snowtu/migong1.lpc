#include <ansi.h>
inherit ROOM;
void create() {
  set("short", HBRED "天地绝杀迷宫" NOR);
  set("long", BLINK + HBRED + @LONG

天   杀   地   杀   ，   杀   尽   天   地   一   切

LONG + NOR);

  setup();
}

void init() {
  add_action("do_none", "move");
  add_action("do_none", "cast");
  add_action("do_none", "perform");
  add_action("do_none", "kill");
  add_action("do_none", "fight");
}

int do_none() {
  object me = this_object();
  message_vision(BYEL + HIW "四周一片萧杀之气，你胆战心惊，失去了方向！\n");
  return 1;
}
