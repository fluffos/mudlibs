//by aiai
inherit NPC;
#include <ansi.h>
string *msg = ({
"欢迎光临『西游记--神魔传说』，IP:211.148.206.132 port:6666 \n",
"经过两个星期的服务器调整，「西游记--神魔传说」对玩家继续开放，请大家帮我们多多做宣传哦！\n",
"请多看看help里面有关于MUD的最新变化！\n",
"请玩家在客栈二楼多提宝贵意见。\n",
});
void create()
{
set_name("新闻发布员", ({"newman"}));
set("gender", "男性" );
set("age", 30);
set("title", HIM"西游记--神魔传说"NOR);
set("long", "一个相貌俊朗的大汉，负责西游记--神魔传说的新闻发布。\n");
set("combat_exp", 20000);
set("attitude", "friendly");
set_skill("dodge", 30);
set("per", 25);
set("max_kee", 100000);
set("kee",100000);
set("sen",100000);
set("max_sen", 100000);
setup();
remove_call_out("msg");
call_out("msg",180);
}
void msg()
{
        command_function("chat  "+NOR+HBMAG+msg[random(sizeof(msg))]+NOR);
        remove_call_out("msg");
call_out("msg",180);

}


