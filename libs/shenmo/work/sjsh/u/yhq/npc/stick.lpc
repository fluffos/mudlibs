#include <ansi.h>
#include <weapon.h>

inherit STICK;

void create()
{
        set_name(HIG "玉竹杖" NOR, ({ "yuzhu","gun", "bang" }) );
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("value", 5000);
                set("material", "steel");
                set("long", "一根浑身碧绿的玉杖。\n");
                set("wield_msg", "$N拿起一根$n，顺手舞了个棍花。\n");
                set("unwield_msg", "$N哼了一声，将$n插回后腰。\n");
        }
        init_stick(120);
        setup();
}

