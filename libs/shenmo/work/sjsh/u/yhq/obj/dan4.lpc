// 《仙侣情缘*三界神话》

// aoyundan.c 奥运大补丸
// koker  13/07/2001

#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();

void init() {
  if (!wizardp(this_player())) {
    set("no_get", "嘿嘿，做梦吧! \n");
    set("no_sell", "嘿嘿，做梦吧! \n");
    //     set("no_give", "嘿嘿，做梦吧! \n");
    set("no_drop", "这么珍贵的机会，哪能舍弃？! \n");
  }
  add_action("do_eat", "eat");
}

void create() {
  set_name(YEL "假冠军奖励丸" NOR, ({ "guanjun wan", "dan" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "大补丸。上面刻有：“西游记--神魔传说冠军奖励”六个字。\n");
    set("drug_type", "补品");
  }
  set("is_monitored", 1);  //监控精灵
  setup();
}

int do_eat(string arg) {
  object me = this_player();

  if (!id(arg)) {
    return notify_fail("你要吃什么？\n");
  } else {
    me->set("food", (int)me->max_food_capacity());
    me->add("potential", 95000);
    me->add("daoxing", 290000);
    message_vision(HIC "$N吃下一颗冠军奖励丸，只觉体内冉冉升起一道道热爱西游记--神魔传说的激流！ \n" NOR, me);
    destruct(this_object());  //毁灭这个物品
    return 1;
  }
}
