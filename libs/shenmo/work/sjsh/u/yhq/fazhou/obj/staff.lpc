#include <ansi.h>
#include <weapon.h>

inherit STAFF;

void create() {
  set_name(HIR "金刚降魔杵" NOR, ({ "xiangmo staff", "staff" }));
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 150000);
    set("material", "steel");
    set("long", "这是一根通体发红的拐杖。\n");
    set("wield_msg", "一道紫光闪过，$N手中已多了根$n。\n");
    set("unequip_msg", "$N放下手中的$n。\n");
  }
  init_staff(220);
  setup();
}
