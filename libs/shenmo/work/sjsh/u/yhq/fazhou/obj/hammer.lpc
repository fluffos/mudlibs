
#include <ansi.h>
#include <weapon.h>

inherit HAMMER;

void create()
{
        set_name(MAG "紫金锤"NOR, ({ "zijin chui", "hammer" }) );
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("value", 150000);
                set("material", "steel");
                set("long", "这是玉帝赐予东海龙王的神锤。\n");
                set("wield_msg", "一道紫光闪过，$N手中已多了柄$n。\n");
                set("unequip_msg", "$N放下手中的$n。\n");
        }
        init_hammer(220);
        setup();
}
