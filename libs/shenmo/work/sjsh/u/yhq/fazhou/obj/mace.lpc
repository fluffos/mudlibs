
#include <ansi.h>
#include <weapon.h>

inherit MACE;

void create()
{
        set_name(HIG "银装锏"NOR, ({ "yinzhuang jian", "mace" }) );
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("value", 150000);
                set("material", "steel");
                set("long", "这是白发老人曾经用过的神锏。\n");
                set("wield_msg", "一道紫光闪过，$N手中已多了把$n。\n");
                set("unequip_msg", "$N放下手中的$n。\n");
        }
        init_mace(220);
        setup();
}
