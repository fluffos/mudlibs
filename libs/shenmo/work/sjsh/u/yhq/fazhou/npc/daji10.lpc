// by yhq
 
#include <ansi.h>;
inherit NPC;
#include "star.h"


void create()
{
        set_name("妲 己", ({ "da ji", "da" }) );
        set("gender", "女性" );
        set("long",
                "颠覆大商罪魁祸首----万狐之祖苏妲己\n"
        );
  set("str", 20);
  set("per", 130);
 set("age", 86);
  set("cor", 30);
  set("cps", 75);
  set("kar", 100);
  set("int", 40);
  set("con", 40);
  set("spi", 40);
  set("title", HIM "万狐之祖" NOR);
  set("combat_exp", 4000000);
  set("daoxing", 4000000);
  set("max_sen", 6000);
  set("max_kee", 6000);
  set("force", 6000); 
  set("max_force", 6000);
  set("force_factor", 40);
  set("family/family_name","盱眙山");

  set("max_mana", 6000);
  set("mana", 6000);
  set("mana_factor", 50);
        
        set_skill("unarmed", 350);
        set_skill("dodge", 350);
        set_skill("parry", 350);
        set_skill("spells", 350);  
        set_skill("dodge", 350);  
        set_skill("force", 350); 
        set_skill("literate", 350);
        set_skill("guiyuanforce", 350);
        set_skill("sword", 350);  
        set_skill("qixi-sword", 350);
        set_skill("tianwei-shi", 350);  
        set_skill("lianhuan-tui", 350);

        map_skill("spells", "fumozhou");
        map_skill("unarmed", "lianhuan-tui");
        map_skill("force", "guiyuanforce");
        map_skill("sword", "qixi-sword");
        map_skill("parry", "qixi-sword");
        map_skill("dodge", "tianwei-shi");
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
        (: cast_spell, "feixian" :),
                (: perform_action, "sword","quewu" :),

        }) );


        setup();
   carry_object("/d/obj/weapon/sword/qingfeng")->wield();
   carry_object("/d/obj/armor/jinjia")->wear();
}


void init()
{
        add_action("do_none","perform");
        add_action("do_none","cast");
        add_action("do_none","ji");
}
int do_none()
{
        object me = this_object();
        message_vision("伐纣大业，岂容你乱来？\n",me);
        return 1;
} 


void die()
{

        object ob = query_temp("my_killer");

        if((ob&&ob->query("kunlun1/jiu")=="done") && (ob&&ob->query("kunlun1/shi")!="done"))
        {
        ob->start_busy(3);
        message("chat",HIY+"【武王伐纣】姬发(Ji fa):"+ob->name()+
        "闯入了大商皇宫.\n"NOR,users());
        ob->set("kunlun1/shi","done");
        ob->add("kunlun1/number",1);
         ob->add("daoxing", 10000);
           ob->save();
         tell_object(ob,"你赢得了十年道行");

        }
message_vision(HIY"$N死了....(伐纣大业成功的向前迈进了一大步) \n"NOR,this_object() );
       ::die();
}

