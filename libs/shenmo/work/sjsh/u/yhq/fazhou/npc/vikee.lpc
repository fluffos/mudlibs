#include <ansi.h>

inherit NPC;

void create()
{
            set_name(""HIC"☆风琴☆"NOR"", ({"npc yhq", "npc"}));
        set("long", "他是发送装备的天后☆风琴☆你可以(list)查看想要的东西。\n");
        set("gender", "女性");
	set("age", 20);
	set("per", 40);
        set("title",""HIG"☆天后☆");
	set_skill("literate", 141);
	set("chat_chance",20);
//    set("chat_msg", ({
  //        "☆风琴☆轻声告诉你：你可以用list指令列出想要的东西！\n",
//        "☆风琴☆轻声告诉你：你可以用yao指令向魔术师我索取装备。\n",
//        "☆风琴☆轻声告诉你：你可以用yao指令向魔术师我索取装备。\n",
//        }));
	setup();
	carry_object("/d/obj/cloth/magua")->wear();
}

void init()
{
	::init();
  add_action("do_fight", "fight");
  add_action("do_kill", "kill");
  add_action("do_steal", "steal");
  add_action("do_cast", "cast");
  add_action("do_ji","ji");
  add_action("do_throw","throw");
  add_action("do_list","list");
  add_action("do_yao","yao");
}

void die()
{
 return;
}

int do_fight(string arg)
{
  object who = this_player();
  object me = this_object();

  if (arg && present(arg,environment(who))==me)
  {
        message_vision("$N看样子想打架，但☆风琴☆很有涵养,不和$N动粗。\n",who,me);
     return 1;
  }
  return 0;
}

int do_kill(string arg)
{
  object who = this_player();
  object me = this_object();

  if (arg && present(arg,environment(who))==me)
  {
message_vision("$N看样子想杀死☆风琴☆，但☆小宁宁☆是文化人,没跟$N一般见识。\n",who,me);

    return 1;
  }
  return 0;
}

int do_cast(string arg)
{
  object who = this_player();
  object me = this_object();

    message_vision("$N对着☆风琴☆结结巴巴的念了几句咒语，自己都感觉难听死了。\n",who,me);

  return 1;
}


int do_steal(string arg)
{
  object who = this_player();
  object me = this_object();

  message_vision("$N想偷东西，但总是有贼心没贼胆。\n",who,me);

  return 1;
}


int do_ji(string arg)
{
  object who = this_player();
  object me = this_object();

  message_vision("$N想对魔术师祭法宝，前思后想，还是没敢。\n",who,me);

  return 1;
}

int do_throw(string arg)
{
  object who = this_player();
  object me = this_object();

  message_vision("$N掏出暗器，看了看☆风琴☆，信心不足，又把暗器收了起来。\n",who,me);

  return 1;
}

int do_list(string arg)
{
	object who = this_player();
	object me = this_object();
  message("vision",""HIG"\n─────────────────────────────────────
          \n"HIY"盔甲："HIC"
          1.精魂甲(armor)     2. 冷狐披风(pifeng)   3. 嗜血神盾(shield)
          4.黄金战盔(kui)     5. 金禅丝袍(cloth)    6.泰山神靴(shoes)
          \n"HIY"兵器："HIC" 
          1.鸳鸯棒(stick)   2. 轩辕剑 (sword)  3.打神鞭(whip)
          4.寒意刀(blade)   5. 冥王爪(zhua)    6.金刚降魔杵(staff)
          7.玄天巨斧(axe)   8. 凤舞叉(fork)    9.紫金锤(hammer)
          10.霸王枪(spear)  11.银装锏(mace)    12.凤凰翎 (feiyu)
          "HIG"\n─────────────────────────────────────\n"NOR"",who,me);

  return 1;
}

int do_yao(string arg)
{
	string type;
	object ob;
	object who=this_player();
	object me=this_object();
       // if (who->query("combat_exp")>2000000)
       //        return notify_fail("凭您超越200万武学的功夫，还是自己去打装备吧! :P\n");
    if (!arg)
		return notify_fail("你想要什么？兵器？还是盔甲？(比如:yao sword)\n");
	else 
	{
		sscanf(arg,"%s",type);
			switch(type)
