#include <ansi.h>

inherit NPC;
void create()
{
       set_name("姜子牙", ({"jiang ziya","jiang","ziya"}));
       set("long","这是个白发苍苍的老人家．整天嘻嘻哈哈的在直钩钓鱼\n");
       set("gender", "男性");
