}
int accept_object(object who,object ob)
{
          
           if (ob->query("id")=="qinglong baoyu") 
             {
              
                command("say "+who->query("name")+"愿意请我出山?");
                command("follow "+who->query("id"));
                return 1;
                }
               else
 return 1;
}
