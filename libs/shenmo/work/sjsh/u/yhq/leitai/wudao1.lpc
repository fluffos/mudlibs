//2003.7.1//党的生日//haha
#include <ansi.h>
inherit ROOM;
string look_gaoshi();
string look_pai();
// int  clear_title(string arg);
string clear_title(string arg);
void add_title(object me, string arg);
void create() {
  set("short", "武道场");
  set("long", @LONG
这里是比武大会巫师席，高据擂台之上，雕梁琉瓦，花木游栏。四望青山
迎爽，向下看擂台周围人头攒动。桌上放着一块小木牌 (pai)，后壁上贴着一
张红纸告示(gaoshi)。
LONG);
  set("outdoors", "city");
  set("item_desc", ([
    "gaoshi": (: look_gaoshi :),
    "pai": (: look_pai :),
  ]));
  set("exits", ([
    "down": __DIR__ "under7",
    "up": "/u/yhq/leitai/under",
  ]));
  set("no_clean_up", 0);
  set("no_fight", "1");
  set("no_steal", "1");
  set("no_beg", "1");
  setup();
  //	replace_program(ROOM);
}
string look_pai() {
  return "\n
" HIR "start                  " HIY "----  擂台上之玩家开始比武。
" HIR "allow    <player id>   " HIY "----  设定允许上擂台之玩家。
" HIR "deny     <player id>   " HIY "----  取消玩家上台资格。
" HIR "load     <player id>   " HIY "----  拉玩家上擂台。
" HIR "kick     <player id>   " HIY "----  踢玩家下擂台。
//" HIR "heal     <player id>   " HIY "----  给擂台上玩家九花玉露丸。
//" HIR "life     <player id>   " HIY "----  送被杀玩家上天堂恢复。

" HIG "titles  <player id> 01 " HIY "----  赠玩家幼年天下第一 。
" HIG "titles  <player id> 02 " HIY "----  赠玩家幼年天下第二 。
" HIG "titles  <player id> 11 " HIY "----  赠玩家少年天下第一 。
" HIG "titles  <player id> 12 " HIY "----  赠玩家少年天下第二 。
" HIG "titles  <player id> 21 " HIY "----  赠玩家天下第一侠少 。
" HIG "titles  <player id> 22 " HIY "----  赠玩家天下第二侠少 。
" HIG "titles  <player id> 31 " HIY "----  赠玩家天下第一侠客 。
" HIG "titles  <player id> 32 " HIY "----  赠玩家天下第二侠客 。
" HIG "titles  <player id> 41 " HIY "----  赠玩家天下第一大侠 。
" HIG "titles  <player id> 42 " HIY "----  赠玩家天下第二大侠 。

\n" NOR;
}
string look_gaoshi() {
  return HIR "\n\n                           
                 西游记--神魔传说的比武大会
\n" HIY "
第一、每周一晚上二十时三十分举行比武大会。地点在长安比武场。
第二、比赛按分组评比，每组设天下第一，第二称号。分组如下：
      未成年组 十四到十五岁 16岁以上分为,100w一下组,
      100w - 300 w组, 300w - 500 w组, 500w - 800 w组,
      800w - 1000 w组, 1000 w以上暂定为一组，以后看情况调整
      如果在一组内只有两人，他就直接获得该组第一、二名。
第三、比武实行淘汰制。预先分组淘汰。每轮实行三局两胜制，分别比
      赛第一兵器，拳脚和第二兵器，先胜两局者进入下一轮。幼儿组
      和少年组除了决赛外每轮只赛一场。
第四、为使天下第一名实相符，允许使用现行所有武功，允许perform，
      powerup，enforce，poison等。但roar由于严重影响比武秩序，
      因此谢绝使用。违者停赛。
第五、比赛时所用兵器和防具请在擂台上的兵器架上自行拿取，经研究，
      禁止使用自造兵器。
第六、比赛时请注意言行，犯众怒者、违反现场巫师安排者，取消一年
      比赛资格。

" HIG "                                      西游记--神魔传说  敬启
\n" NOR;
}
void init() {

  add_action("do_titles", "titles");
}


int do_titles(string arg) {
  object obj, me = this_player();
  string dest, topic;

  if (!arg || sscanf(arg, "%s %s", dest, topic) != 2)
    return notify_fail("你要封谁什么称号？\n");
  obj = find_player(dest);
  if (!obj || !me->visible(obj)) return notify_fail("没有这个人....。\n");
  switch (topic) {
    case "01": add_title(obj, "风 之 琴 ·"); break;
    case "02": add_title(obj, "雪 之 鱼 ·"); break;
    case "11": add_title(obj, "天 上 龙 ·"); break;
    case "12": add_title(obj, "人 中 凤 ·"); break;
    case "21": add_title(obj, "天 诸 神 ·"); break;
    case "22": add_title(obj, "人 才 俊 ·"); break;
    case "31": add_title(obj, "天 异 灵 ·"); break;
    case "32": add_title(obj, "人 英 杰 ·"); break;
    case "41": add_title(obj, "天 可 汗 ·"); break;
    case "42": add_title(obj, "人 间 王 ·"); break;
    default: break;
  }
  message_vision(HIG "$N授" + obj->name() + "封号。\n" NOR, me);
  return 1;
}
void add_title(object me, string arg) {
  string title;
  title = arg + clear_title(me->query("title"));
  me->set("title", title);
}
string clear_title(string arg) {
  if ((strsrch(arg, "风 之 琴 ·") >= 0) ||
    (strsrch(arg, "雪 之 鱼 ·") >= 0) ||
    (strsrch(arg, "天 上 龙 ·") >= 0) ||
    (strsrch(arg, "人 中 凤 ·") >= 0) ||
    (strsrch(arg, "天 诸 神 ·") >= 0) ||
    (strsrch(arg, "人 才 俊 ·") >= 0) ||
    (strsrch(arg, "天 异 灵 ·") >= 0) ||
    (strsrch(arg, "人 英 杰 ·") >= 0) ||
    (strsrch(arg, "天 可 汗 ·") >= 0) ||
    (strsrch(arg, "人 间 王 ·") >= 0)) {
    arg = replace_string(arg, "风 之 琴 ·", "");
    arg = replace_string(arg, "雪 之 鱼 ·", "");
    arg = replace_string(arg, "天 上 龙 ·", "");
    arg = replace_string(arg, "人 中 凤 ·", "");
    arg = replace_string(arg, "天 诸 神 ·", "");
    arg = replace_string(arg, "人 才 俊 ·", "");
    arg = replace_string(arg, "天 异 灵 ·", "");
    arg = replace_string(arg, "人 英 杰 ·", "");
    arg = replace_string(arg, "天 可 汗 ·", "");
    arg = replace_string(arg, "人 间 王 ·", "");
  }
  return arg;
}
