// shoes.c

#include <armor.h>
#include <ansi.h>

inherit BOOTS;


void create()
{
    set_name(HIY "仙人鞋" NOR, ({ "shoes" }) );
	set_weight(900);
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("long", "一双鞋。  \n");
		set("material", "cloth");
		set("unit", "双");
//		set("value", 300);
        set("armor_prop/armor", 50 );
        set("armor_prop/dodge", 50 );
	}
	setup();
}
//int query_autoload() { return 1; }

