#include <ansi.h>

inherit NPC;
#include "hs.h"

string ask_jianding();
 
void create()
{
          set_name("鉴定师", ({ "jianding shi" }) );
        set("gender", "男性" );
        set("title",HIY"幻兽之卵"NOR);
        set("age",50);
        set("attitude", "heroism");
        set("str",40);
        set("int",50);
        set("per",20);
        set("max_kee",4100);
        set("kee",4100);
        set("max_sen",3100);
        set("sen",3100);
        set("combat_exp",100000);
        set("daoxing",10000);
        set("force",400);
        set("max_force",400);
        set("mana",400);
        set("max_mana",400);
        set("force_factor", 0);
        set("mana_factor",0);
        set_skill("unarmed",100);
        set_skill("parry",100);
        set_skill("literate",200);
        set_skill("dodge",100);
        set_skill("force",100);
        set_skill("spells", 500);
        set("inquiry", ([
                "name" : "世界上有各种各样的幻兽之卵，以我所学可以帮助你鉴定它们的属性。",
                        ]) );
        set("inquiry", ([
                "幻兽之卵" : (: ask_jianding :),
                "鉴定" : (: ask_jianding :),
                ]) );
              setup();
}

string ask_jianding()
{
   return "鉴定幻兽之卵的价格为10 gold/个。\n";

}

int accept_object(object me,object ob)
{


   if (ob->query("money_id") && ob->value() >= 100000) 
       {
         me->set_temp("hs/can_jd",1);
         message_vision("$n对$N说道：没错，把要鉴定的卵交给我看看。\n",me,this_object());
         return 1;
       }

    if (me->query_temp("hs/can_jd")&&ob->query("name")==HIY"幻兽之卵"NOR){
        if (ob->query("hs/name")!="未鉴定") {return notify_fail("该幻兽之卵已经鉴定过了!\n");}
        call_out("jianding2",1,me,ob->query("hs/max_lvl"));
        call_out("dest",3,ob);
        return 1;
       }

        command("pei");
        command("say 我忙着呢,别来消遣我。\n");
        return 0;
}

int jianding2(object me,int hslvl)
{
      object egg;
      object jds=this_object();
      int shuxing;
      string hssx;


        egg=new("/u/run/egg2");

///////////////////////////////////////////// 确定name /////////////////////////
        egg->set("hs/max_lvl",hslvl);
        egg->set("power",hslvl);

        egg->set("hs/name",hsname(me,hslvl));

///////////////////////////////////////////// 确定属性 ////////////////////////////

        if (hslvl<8) shuxing=11;
        if (hslvl>7) shuxing=15;
     
        switch (random(shuxing)) {
                                  case 0 : hssx=HIC"风"NOR;break;
                                  case 1 : hssx=HIY"地"NOR;break;
                                  case 2 : hssx=HIB"水"NOR;break;
                                  case 3 : hssx=HIR"火"NOR;break;
                                  case 4 : hssx=HIC"风"NOR;break;
                                  case 5 : hssx=HIY"地"NOR;break;
                                  case 6 : hssx=HIB"水"NOR;break;
                                  case 7 : hssx=HIR"火"NOR;break;
                                  case 8 : hssx=HIC"风"NOR;break;
                                  case 9 : hssx=HIY"地"NOR;break;
                                  case 10 : hssx=HIB"水"NOR;break;
                                  case 11 : hssx=HIR"火"NOR;break;
                                  case 12 : hssx=HIW"光"NOR;break;
                                  case 13 : hssx=BLK"暗"NOR;break;
                                  case 14 : hssx=HIW"光"NOR;break;
                                  case 15 : hssx=BLK"暗"NOR;break;
                                 }
        if(egg->query("hs/name")=="光之虎") hssx=HIW"光"NOR;
        if(egg->query("hs/name")=="烈火雄狮") hssx=HIR"火"NOR;
        if(egg->query("hs/name")=="碧水蓝鹰") hssx=HIB"水"NOR;
        if(egg->query("hs/name")=="大地之熊") hssx=HIY"地"NOR;
        if(egg->query("hs/name")=="疾风之狐") hssx=HIC"风"NOR;
        if(egg->query("hs/name")=="邪狼") hssx=BLK"暗"NOR;

        egg->set("hs/shuxing",hssx);

///////////////////////////////////////////////////////////////////////////////////
           
        message_vision("$n接过卵仔细研究了一阵，抬起头来，肯定的对$N说道：“这是"+hssx+"属性"+HIG+egg->query("hs/name")+NOR"系的幻兽之卵。”\n",me,jds);
        egg->set("long","   "+egg->query("hs/shuxing")+"属性"+HIG+egg->query("hs/name")+NOR"系的幻兽之卵。\n");
        me->delete_temp("hs/can_jd");
        egg->move(me);
        return 1;
      

}

void dest(object ob)
{
  destruct(ob);
}
