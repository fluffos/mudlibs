#include <ansi.h>
#include <dbase.h>

inherit F_AUTOLOAD;  
inherit ITEM;


void create()

{
     set_name(HIY"幻兽之卵"NOR, ({"egg" }) );
     set_weight(100);
     set("value", 10000);
     set("material", "steel");
     set("no_sell", "这么难得的宝物还是留着吧。\n");
     set("unit", "颗");
     set("hs/name","未鉴定");
     set("hs/shuxing","未知");
     set("long",query("hs/shuxing")+"属性"+query("hs/name")+"的幻兽之卵。\n");
	setup();

}

void init() 
{
  add_action("do_guanzhu", "guanzhu");
}


int do_guanzhu()
{
    object me=this_player(); 
    object egg=this_object();

   if(me->query("max_force")<10)
             return notify_fail("你自身能量不足，怎么将能量灌注给幻兽之卵。\n");

  if(me->is_fighting())
     return notify_fail("还是专心打你的架\n");
  if (query("hs/name")=="未鉴定")
     return notify_fail("先去鉴定一下你的幻兽之卵吧。\n");

       message_vision(HIW"$N浑身发出白光，越来越强烈，然后全身的光芒集中于双掌之间及$N的眉间。\n"NOR,me);
       if (egg->query("power")>0){
           message_vision(HIW"$N手中的卵随着发出阵阵白光。片刻之后，白光才慢慢消失。\n"NOR,me);
           egg->add("power",-1);
           me->start_busy(3);
           }
       else {
           message_vision(HIC"$N手中的幻兽卵却传来一阵异样，合在掌中的幻兽卵温度异常的升高，升到几乎烫手的高温，而且里面隐隐有东西活动的感觉。\n"NOR,me);
           message_vision(HIY"在$N满心期待中，原本光华的外壳开是出现裂痕，然后裂痕加大，一股奇特，说不上香或臭的味道开始散出，充斥整间屋子，有\n点像铁的锈味，只是很淡。\n"NOR,me);
           message_vision(HIY"接着，一颗龙眼大小的头伸了出来，没多久，整个身子全露了出来，看来只有巴掌不到的大小。\n"NOR,me);
           message_vision(HIM""+egg->query("hs/name")+HIM"诞生了，现在处于幼生期阶段。\n"NOR,me);
            }
       return 1;
}
