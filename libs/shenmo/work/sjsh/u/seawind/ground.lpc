#include <ansi.h>
inherit ROOM;
void finish(int);
void fullup(object);

void create() {
  set("short", HIW "西游记--神魔传说" HIW " 擂台" NOR);
  set("long", "\n\t       八  仙  过  海         各  显  神  通\n\n");
  set("exits", ([]));
  set("broadcast", 1);
  set("alternative_die", 1);
  set("no_kill", 1);
  set("busy", 0);
  setup();
}

void init() {
  add_action("do_quit", "quit");
  add_action("do_quit", "move");
  add_action("do_quit", "mark");
  add_action("do_quit", "fly");
  add_action("do_quit", "cast chuqiao");
  add_action("do_cast", ({ "cast", "perform", "exert" }));
  call_out("finish", 300, 0);
}

int do_quit(string arg) {
  write("你不能在这里用这条命令。\n");
  if (wizardp(this_player())) write("巫师请参阅同一路径内的banned.h文档。\n");
  return 1;
}

int do_cast(string arg) {
  if (!arg) return 0;
  while (sscanf(arg, "%s %*s", arg) == 2);
  write("擂台上请勿使用" + arg + ",多谢合作。\n");
  this_object()->set_temp("time", time());
  if (this_object()->query_temp("time") > 5)
    write("比武时间尚早，待会再用" + arg + ",多谢合作。\n");
  return 1;
}

void alternative_die(object who) {
  object where, ob;
  where = environment(who);
  ob = who->query_temp("my_killer");

  if (!where) return;

  if (!userp(who)) {
    message_vision("$N死了。\n", who);
    destruct(who);
    return;
  }

  who->delete_temp("last_fainted_from");
  /*
if (p1==p2) 
	{
	message_vision(HIG"$N$n大战三百回合，不分胜败，各自离场，改日再战！\n"NOR,p1,p2);
	fullup(p1);
	fullup(p2);
	p1->move(__DIR__"under");
	p2->move(__DIR__"under");
	message_vision(HIG"$N$n携手跳下擂台，相对一笑，大有英雄惜惜之觉！\n"NOR,p1,p2);
	}
*/
  message_vision(HIG "$N把$n打翻在地，飞起一脚，将$n踢下了擂台。\n" NOR, ob, who);
  fullup(who);
  fullup(ob);
  ob->move(__DIR__ "under");
  who->move(__DIR__ "under");
  message_vision(HIG "$N对$n拱手作揖，“佩服佩服”\n" NOR, who, ob);
}

void die(object who) {
  alternative_die(who);
}

void fullup(object obj) {
  string *conditions;
  int *condition_values;

  if (!obj) return;
  obj->set("kee", (int)obj->query_temp("leitai/kee"));
  obj->set("eff_kee", (int)obj->query_temp("leitai/eff_kee"));
  obj->set("sen", (int)obj->query_temp("leitai/sen"));
  obj->set("eff_sen", (int)obj->query_temp("leitai/eff_sen"));
  obj->set("force", (int)obj->query_temp("leitai/force"));
  obj->set("mana", (int)obj->query_temp("leitai/mana"));

  obj->clear_condition();
  if (conditions = obj->query_temp("leitai/conditions")) {
    condition_values = obj->query_temp("leitai/condition_values");
    for (int i = 0; i < sizeof(conditions); i++)
      obj->apply_condition(conditions[i], condition_values[i]);
  }
}


void broadcast_room(object room, string str) {
  string prefix = HIR "【西游记--神魔传说·比武】" NOR;
  string s1 = str, s2 = "", s3;
  int i;

  reset_eval_cost();

  // remove extra trailing NOR. mon 7/13/99
  s1 = replace_string(s1, "\n" NOR, "\n");

  while (strsrch(s1, "\n\n") != -1)
    s1 = replace_string(s1, "\n\n", "\n");

  while (sizeof(s1) > 1 && s1[sizeof(s1) - 1] == '\n') {
    s1 = s1[0..(sizeof(s1) - 2)];
    s2 = "\n";
  }
  if (sizeof(s1) <= 1)
    return;

  s1 = replace_string(s1, "\n", "\n" + prefix);
  if (room) {
    tell_room(room, prefix + s1 + NOR + "\n");
  }
}

void broadcast(string msg) {
  object room = load_object(__DIR__ "under");
  if (room) broadcast_room(room, msg);
}
