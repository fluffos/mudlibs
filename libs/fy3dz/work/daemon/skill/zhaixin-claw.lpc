#include <ansi.h>

inherit SKILL;

mapping *action = ({
  ([ "action":
    "$N身形微晃，一招「万骨同枯」，十指如戟，插向$n的双肩锁骨",
    "dodge": -30,
    "parry": -10,
    "force": 100,
    "damage_type": "抓伤"
  ]),
  ([ "action":
    "$N出手如风，十指微微抖动，一招「鬼影憧憧」抓向$n的前胸",
    "dodge": -10,
    "parry": -20,
    "force": 170,
    "damage_type": "抓伤"
  ]),
  ([ "action":
    "$N使出摘心手中的「小鬼摘心」，如鬼魅般欺至$n身前，一爪勾向$n的$l",
    "dodge": 30,
    "force": 250,
    "damage_type": "抓伤"
  ]),
  ([ "action":
    "$N双臂一错，使出「饿鬼讨羹」，对准$n的$l连续抓出",
    "dodge": -50,
    "parry": -20,
    "force": 200,
    "damage_type": "抓伤"
  ]),
});

int valid_learn(object me) {

  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练摘心手必须空手。\n");
  if ((string)me->query_skill_mapped("force") != "huashanforce")
    return notify_fail("摘心手必须配合华山派内功才能练。\n");
  if ((int)me->query_skill("huashanforce", 1) < 20)
    return notify_fail("你的华山心法火候不足，无法练摘心手。\n");
  if ((int)me->query("max_force") < 300)
    return notify_fail("你的内力太弱，无法练摘心手。\n");
  return 1;
}

int valid_enable(string usage) { return usage == "unarmed"; }
int effective_level() { return 17; }

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30)
    return notify_fail("你的体力不够了，休息一下再练吧。\n");
  if ((int)me->query("force") < 5)
    return notify_fail("你的内力不够了，休息一下再练吧。\n");
  me->receive_damage("kee", 30);
  me->add("force", -5);
  me->add("bellicosity", random(2));
  message_vision(RED "$N脸色灰绿，五指成爪状反复凌空虚探。\n" NOR, me);
  return 1;
}

string perform_action_file(string action) {
  return CLASS_D("huashan") + "/zhaixin-claw/" + action;
}



string *parry_msg = ({
  "$n伸出两指，一招「金石为开」，将$N的$w牢牢的夹在指中！\n",
  "$n后退一步，双手向下连抓，$N手中的$w似乎突然沉重起来，几乎连拿都拿不稳。\n",

});

string *unarmed_parry_msg = ({

  "$n中指微弹，一招「无孔不入」，一股阴森森的指风直刺$N的面门。\n",

});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int learn_bonus() {
  return -50;
}
int practice_bonus() {
  return -50;
}
int black_white_ness() {
  return 0;
}
