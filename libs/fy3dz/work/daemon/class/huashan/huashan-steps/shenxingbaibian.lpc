// tie@fengyun
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra;
  object weapon;
  extra = me->query_skill("huashan-steps", 1);
  if (extra < 50) return notify_fail("你的［华山步法］还不够纯熟！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［神行百变］只能对战斗中的对手使用。\n");
  if (target->is_busy())
    return notify_fail(target->name() + "已经手忙脚乱了！\n");

  message_vision(HIR "$N的身形突然变快，犹如一缕青烟将$n围在其中！\n" NOR, me, target);
  if (random((int)target->query("combat_exp")) < (int)me->query("combat_exp") / 3) {
    message_vision(HIW "结果$N目眩神弛，惊慌失措！\n" NOR, target);
    target->start_busy(3);
  } else {
    message_vision("结果$N并不慌张！\n", target);
    me->start_busy(2);
  }
  return 1;
}
