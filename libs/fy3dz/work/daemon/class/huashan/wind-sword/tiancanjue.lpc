// tie@fengyun

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string attack_skill, mapped_skill, msg;
  int extra, afp, dfp, new_skill, new_skill_mapped, lost_skill;
  object yourweapon;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［天残诀］只能对战斗中的对手使用。\n");
  yourweapon = target->query_temp("weapon");
  extra = me->query_skill("wind-sword", 1);
  if (extra < 180) return notify_fail("你的［清风十三式］还不够精熟！\n");
  if (me->query("force") < 1000)
    return notify_fail("你的内力不够，无法使出［天残诀］！\n");

  if (objectp(yourweapon)) attack_skill = yourweapon->query("skill_type");
  else attack_skill = "unarmed";

  mapped_skill = target->query_skill_mapped(attack_skill);
  new_skill = target->query_skill(attack_skill, 1);
  new_skill_mapped = target->query_skill(mapped_skill, 1);

  if (new_skill < 10 && new_skill_mapped < 10)
    return notify_fail("得饶人处且饶人吧！\n");

  msg = HIB "\n$N无声无息地闪近$n身前，从完全不可能的方位攻出了一招！" NOR;
  me->start_busy(3);
  me->set("force", 0);
  me->improve_skill("wind-sword", 1, 1);

  afp = me->query_skill("force") / 2 + me->query_skill("sword") / 2;
  dfp = target->query_skill("force");

  lost_skill = (afp - dfp) / 20;

  afp = (afp / 10 * afp / 10 * afp) / 5 + me->query("combat_exp") / 25;
  dfp = (dfp / 10 * dfp / 10 * dfp) / 5 + target->query("combat_exp") / 25;

  if (random(afp + dfp) < dfp) {
    msg += HIC "\n$n早有准备，不慌不忙地躲过了$N的致命一击。\n" NOR;
  } else {
    msg += HIW "\n只听“波”地一声响，$n已知不妙！\n" NOR;
    if (lost_skill < 1) lost_skill = 1;
    if (lost_skill > 3) lost_skill = 1 + random(3);
    if (new_skill >= 10) {
      new_skill -= lost_skill;
      target->set_skill(attack_skill, new_skill);
    }
    if (random(2)) {
      if (new_skill_mapped >= 10) {
        new_skill_mapped -= lost_skill;
        target->set_skill(mapped_skill, new_skill_mapped);
      }
    }

  }
  message_vision(msg, me, target);
  return 1;
}
