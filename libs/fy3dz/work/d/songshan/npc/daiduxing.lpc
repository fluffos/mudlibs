// TIE@FY3
// daiduxing.c

inherit NPC;
inherit F_MASTER;
#include <ansi.h>
int teach_perform();
void learn_perform(object me, object ob, int utter);
string *teach_msg = ({
  "\n戴独行说道：能不能学会需得看你资质。\n\n" NOR,
  "戴独行说道：「亢龙有悔」的精髓就在个“悔”字，好好看着！\n\n" NOR,
  HIY "戴独行左手划了个半弧，右手石破天惊地拍出一掌，只听见「轰」的一声巨响！\n\n" NOR,
});

void create() {
  set_name("戴独行", ({ "dai duxing", "dai", "duxing" }));
  set("gender", "男性");
  set("nickname", HIC "万里独行" NOR);
  set("age", 75);
  set("str", 700);
  set("per", 10);
  set("apprentice_available", 1);
  set("long",
    "这位神威禀禀的老人本是横行两河的独行盗，叁十岁後，方改邪归
正，投入丐帮。他先年曾得“丐帮铁掌”朱明的真传，其后又得奇
遇，习得降龙十八掌的失传绝技，再加上一身绝顶轻功，现已是丐帮中
的第一人。\n"
  );
  create_family("丐帮", 5, "长老");
  set("no_clean_up", 1);
  set("max_gin", 99999);
  set("max_kee", 99999);
  set("max_sen", 99999);
  set("eff_gin", 99999);
  set("eff_kee", 99999);
  set("eff_sen", 99999);
  set("gin", 99999);
  set("kee", 99999);
  set("sen", 99999);
  set("max_force", 30000);
  set("force", 30000);
  set("force_factor", 300);
  set("cor", 200);
  set("combat_exp", 99999999);
  set_skill("staff", 100);
  set_skill("begging", 150);
  set_skill("inquiry", 120);
  set_skill("force", 150);
  set_skill("huntunforce", 200);
  set_skill("parry", 100);
  set_skill("unarmed", 300);
  set_skill("dragonstrike", 150);
  set_skill("dagou-stick", 150);
  set_skill("doggiesteps", 150);
  //     set_skill("literate", 10);
  set_skill("dodge", 150);
  set_skill("move", 280);
  set("agi", 50);
  set("chat_chance", 2);
  set("chat_msg", ({
    "戴独行啃了口手里香喷喷的“叫化鸡”，大笑道：好味道！好味道！\n",
    "戴独行伸了伸懒腰道：可有好久没出来活动了。\n",
    (: random_move :),

  }));
  map_skill("staff", "dagou-stick");
  map_skill("force", "huntunforce");
  map_skill("unarmed", "dragonstrike");
  map_skill("dodge", "doggiesteps");
  map_skill("move", "doggiesteps");
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed.kanglongyouhui" :),
  }));


  set("inquiry", ([
    "亢龙有悔": (: teach_perform :),
    "绝技": (: teach_perform :),
    "失传绝技": (: teach_perform :),
    "kanglongyouhui": (: teach_perform :),

  ]));


  setup();
  carry_object("/obj/cloth")->wear();
  //       carry_object(__DIR__"obj/stick")->wield();
}
void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {

    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object me) {
  if (!me || environment(me) != environment()) return;
  if ((int)me->query("combat_exp") > 5000000 && me->query("age") < 20) {
    message_vision("$N对$n浩然长叹道：这位" + RANK_D->query_respect(me) + "当真是英雄出少年啊！\n", this_object(), me);
  } else {
    switch (random(3)) {
      case 0:
        say("戴独行眨眼道：这位" + RANK_D->query_respect(me)
          + "，可有见过楚香帅？\n");
        break;
      case 1:
        say("戴独行笑呵呵地说道：" + RANK_D->query_respect(me)
          + "可有听到什么江湖的新鲜事？\n");
        break;
      case 2:
        say("戴独行说道：" + RANK_D->query_respect(me)
          + "可想尝尝老夫亲手做的“叫化鸡”？\n");
        break;
    }
  }

}

void attempt_apprentice(object ob) {
  if (query("apprentice_available")) {
    if (find_call_out("do_recruit") != -1)
      command("say 慢著，一个一个来。");
    else
      call_out("do_recruit", 2, ob);
  } else {
    command("say 我今天已经收了三个弟子，不想再收徒了。");
  }
}
void do_recruit(object ob) {
  ob = this_player();
  if (random(80)) {
    command("say 老叫化云游四海，哪有功夫带徒弟。");
    return;
  } else {
    command("pat " + ob->query("id"));
    command("say 唉，这降龙十八掌总不能就此失传。");
    command("recruit " + ob->query("id"));
  }
}

void recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "beggar");
}

int teach_perform() {
  object me;
  me = this_player();
  if ((string)me->query("class") != "beggar") {
    command("say 见笑了，老叫化哪会什么绝技？\n");
    return 1;
  }
  if ((int)me->query("potential", 1) < 80000 || (int)me->query("str", 1) < 40) {
    command("hmm");
    command("say 你现在还领悟不了。");
    return 1;
  }
  if (me->query("marks/亢龙有悔")) {
    command("say 你怎么这么快又忘了？");
    return 1;
  }
  if ((int)me->query_temp("learn_perform")) return 1;
  me->add("potential", -80000);
  command("say 好，很好。");
  me->set_temp("learn_perform", 1);
  me->start_busy(12);
  call_out("learn_perform", 2, this_player(), this_object(), 0);


  return 1;
}
void learn_perform(object me, object ob, int utter) {
  message_vision(teach_msg[utter], ob, me);
  if (++utter < sizeof(teach_msg)) {
    call_out("learn_perform", 2, this_player(), this_object(), utter);
    return;
  } else {
    cat("/doc/help/k1");
  }
  me->delete_temp("learn_perform");
  tell_object(me, HIY "\n你把戴独行刚才所使的绝招在脑海里默默地演练了几遍，记在了心中。\n" NOR);
  me->set("marks/亢龙有悔", 1);
  return;

}
void re_rank(object student) {
  int exp;
  exp = (int)student->query("combat_exp");
  if (exp <= 32000) {
    student->set("title", "丐帮堂外弟子");
    return;
  } else if (exp <= 64000) {
    student->set("title", "丐帮一袋弟子");
    return;
  } else if (exp <= 128000) {
    student->set("title", "丐帮两袋弟子");
    return;
  } else if (exp <= 256000) {
    student->set("title", "丐帮三袋弟子");
    return;
  } else if (exp <= 512000) {
    student->set("title", "丐帮四袋弟子");
    return;
  } else if (exp <= 1024000) {
    student->set("title", "丐帮五袋弟子");
    return;
  } else if (exp <= 1536000) {
    student->set("title", "丐帮六袋弟子");
    return;
  } else if (exp <= 2304000) {
    student->set("title", "丐帮七袋弟子");
    return;
  } else if (exp <= 3456000) {
    student->set("title", "丐帮八袋弟子");
    return;
  } else if (exp <= 5187000) {
    student->set("title", "丐帮九袋弟子");
    return;
  } else {
    student->set("title", "丐帮长老");
    return;
  }

}
