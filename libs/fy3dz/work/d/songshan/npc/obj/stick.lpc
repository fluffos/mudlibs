// staff.c : Gun zi

#include <weapon.h>
#include <ansi.h>
inherit STAFF;

void create() {
  set_name("竹棍", ({ "stick" }));
  set_weight(20000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("value", 3000);
    set("material", "steel");
  }
  init_staff(50, TWO_HANDED);
  setup();
}
