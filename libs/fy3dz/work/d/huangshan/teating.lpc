inherit ROOM;
#include <room.h>
void create() {
  set("short", "茶亭");
  set("long", @LONG
原木搭成的一个小亭。青瓦铺成的亭盖下挂着块黑底的横匾，上
面书着：“茶即禅”。亭内摆着张石桌和些石凳，桌上是个沏茶用的
白泥凉炉，凉炉飘出阵阵茶香，茶杯小巧别致。整座茶亭包括茶具在
内都用料平常，但却给人一种素雅、清幽的感觉。
LONG);
  set("exits", ([
    "southwest": __DIR__ "annei",
  ]));
  set("objects", ([
    __DIR__ "npc/master": 1,
    __DIR__ "obj/lianglu": 1,
  ]));
  set("coor/x", -640);
  set("coor/y", -520);
  set("coor/z", 30);
  setup();
}
