inherit NPC;
void create()
{
	set_name("杨铁心",({"yang tiexin","yang"}));
   set("gender","男性");
   set("mingwang",5000);
   set("combat_exp",60000);
   
set("age",45);
   set("qi",600);
   set("max_qi",600);
set("food",250);
set("water",250);
   set("neili",500);
   set("max_neili",500);
   set("force_factor",10);

   set_skill("dodge",40);
   set_skill("force",40);
   set_skill("parry",40);
   set_skill("unarmed",40);
   set_skill("club",100);

   setup();
   add_money("silver",10);
carry_object(__DIR__"obj/cloth")->wear();
carry_object(__DIR__"obj/tiespear")->wield();
}
