#include <ansi.h>

inherit F_CLEAN_UP;
string replace_color(string,int);
int help(object);
int wiz_set(string,string,string,int);

int main(object me, string arg)
{
	string dest;
	if( !arg ) return help(me);	
if (strlen(arg) > 12)
return help(me);	
	me->set("family/family_name",arg);

	write("Ok.\n");
	return 1;
}

int help(object me)
{
	write(@HELP
指令格式 : 
family <门派名>
By JackyBoy @ CCTX 98/12/12
HELP
	);
	return 1;
}
