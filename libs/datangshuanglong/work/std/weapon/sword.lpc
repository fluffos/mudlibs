#include "weaponsave.h"

varargs void init_sword(int damage, int strong,int max_strong)
{
	if( clonep(this_object()) ) return;
	set("damage",damage);
    set("strong",strong);
	set("max_strong",max_strong);
	set("flag",0);
	set("weapon_prop/damage", damage);
	set("org_name","");
	set("user","");
	set("user_skill",1);
	set("temp_skill",1);
	set("skill_type", "sword");
	set("defence",({"架","挡"}));
	set("verbs",({"削","刺"}));
}


  

