string chinese_number(int i) {
  return CHINESE_D->chinese_number(i);
}

string to_chinese(string str) {
  return CHINESE_D->chinese(str);
}

int is_chinese(string str) {
  // AGENTS.md §15h: this used to be a GBK lead/trail-byte range check
  // (str[0]/str[1] as raw bytes 0-255). On this driver, string indexing
  // returns a full Unicode codepoint, not a byte, so the old byte-range
  // comparison silently never matches real Chinese text anymore. Fixed
  // to check the CJK Unified Ideographs codepoint range directly.
  if (strlen(str) < 1) return 0;
  if (str[0] < 0x4e00 || str[0] > 0x9fff) return 0;
  return 1;
}
