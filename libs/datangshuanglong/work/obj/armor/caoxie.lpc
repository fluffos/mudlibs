
#include <armor.h>
#include <ansi.h>
inherit BOOTS;

void create()
{
   set_name(YEL"草鞋"NOR, ({ "cao xie","xie"}) );
   set_weight(100);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("long","这是一双草鞋。\n");
     set("material", "草");
     set("unit", "双");
     set("value",80);
     set("armor_prop/dodge",20);
   }
   setup();
}
