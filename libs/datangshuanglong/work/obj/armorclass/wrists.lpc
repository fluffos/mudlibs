#include <armor.h>

inherit WRISTS;
#include "armorsave.h"

void create() {
  set_name("护腕类型", ({ "wrists" }));
  set_weight(800);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "铁");
    set("unit", "双");
    set("armor_prop/armor", 2);
  }
  setup();
}
