
inherit "/std/guard.lpc";

void create()
{
   set_name("侍卫",({ "shi wei","shiwei","wei" }) );
   set("gender", "男性" );
   set("age", 32);
   set("long", "这是守卫皇宫的侍卫。\n");
       
   set("combat_exp",800000);
   set("attitude", "peaceful");
   set("guard","xucheng");
   
   set_this_skills("high");
   set_all_skill(this_object(),180);
   
   setup();
  
  
}
