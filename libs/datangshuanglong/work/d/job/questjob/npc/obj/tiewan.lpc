
#include <armor.h>

inherit WRISTS;

void create()
{
   set_name("铁护腕", ({ "hu wan","wan"}) );
   set_weight(800);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("material", "铁");
     set("unit", "副");
     set("value",100);
     set("armor_prop/armor",2);
   }
   setup();
}
