#include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "火山口");
        set("long", @LONG
这里是一个火山口。只见地上冒着阵阵白气，形成阵阵白雾飘向了
空中。有些地方不时涌处阵阵红色岩浆，向山下流淌而去。这里非常炎
热，你觉得有些迷糊了。
LONG
);
        set("exits",([
	"northwest" : __DIR__"dmjob_6_11",
        ]));
set("outdoors","dmjob");
        setup();
//        replace_program(ROOM);
}
