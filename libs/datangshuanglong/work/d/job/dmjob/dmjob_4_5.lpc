#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "清风谷");
  set("long", @LONG
这里是屏风山的清风谷了。据说有道人曾经在这里修道，而使这里
气候温暖，四季如春。一阵清风吹来，带来了阵阵的花草香气。
LONG
  );
  set("exits", ([
    "westup": __DIR__ "dmjob_4_3",
    "southwest": __DIR__ "dmjob_6_3",
    "eastup": __DIR__ "dmjob_4_7",
  ]));
  set("outdoors", "dmjob");
  setup();
  //        replace_program(ROOM);
}
