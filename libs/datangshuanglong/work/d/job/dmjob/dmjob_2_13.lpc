#include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "碎石路");
        set("long", @LONG
这里是一条碎石路。北边是屏风山的山口。这里风景秀丽，山水如
画，空气清新。地上有很多漂亮的野花、蒲公英等植物。东边隐约可以
看到一座山峰。
LONG
);
        set("exits",([
	"westup" : __DIR__"dmjob_2_11",
	"north" : __DIR__"dmjob_0_13",
	"eastup" : __DIR__"dmjob_2_15",
        ]));
set("outdoors","dmjob");
        setup();
//        replace_program(ROOM);
}
