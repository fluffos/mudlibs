#include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "悬崖");
        set("long", @LONG
这里是一个悬崖。西边是屏风山的飞天岭了。悬崖下边深不见底，
甚至有清云从你的脚下缓缓飘过。悬崖边立着一棵老松树，在清风的吹
拂下不住地晃动着。
LONG
);
        set("exits",([
	"west" : __DIR__"dmjob_0_17",
        ]));
set("outdoors","dmjob");
