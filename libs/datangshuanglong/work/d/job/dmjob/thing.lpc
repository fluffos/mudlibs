
inherit ITEM;
mapping name=([
"玉观音":"yu guanyin","白珊瑚":"bai shanhu","夜明珠":"ye mingzhu",
"翡翠":"fei cui","猫眼":"mao yan","玉雕白马":"yudiao baima",
"千年人参":"ren shen","琥珀":"hu po","金娃娃":"jin wawa",
]);
void create()
{
   string *myname;
   int i;
   
   myname=keys(name);
   i=random(sizeof(myname));
   set_name(myname[i], ({ name[myname[i]]}) );
   set_weight(5000);
   if( clonep() )
     set_default_object(__FILE__);
   else {   
     set("unit", "个");
     set("dm_find_job",1);
   }
   setup();
}
