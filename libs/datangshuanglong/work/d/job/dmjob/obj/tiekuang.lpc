

inherit COMBINED_ITEM;
void create()
{
   set_name("铁矿", ({ "tie kuang","tie","kuang"}) );
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("material", "iron");
     set("unit", "些");
     set("no_drop",1);
     set("no_get",1);
     set("base_unit","块");
	 set("weapon",([
		 "damage":70,
		 "strong":70,
		 ]));
    
   }
   set_amount(1);
  // setup();
}
