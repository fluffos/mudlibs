nslate# internet names to numbers (and vice versa).  select an unused port.address server ip : 202.98.123.126address server port : 8000 # absolute pathname of mudlibmudlib directory : /home/yhonline/mud # absolute pathname of driver/config dirbinary directory : /home/yhonline/bin # debug.log and author/domain stats are stored herelog directory : /log# the directories which are searched by #include <...># for multiple dirs, separate each path with a ':'include directories : /include # Directory to save binaries in.  (if BINARIES is defined)save binaries directory : /binaries # the file which defines the master objectmaster file : /adm/single/master# The global include file is included automatically. global include file : <globals.h># the file where all global simulated efuns are defined.simulated efun file : /adm/single/simul_efun # file to swap out objects; not used if time to swap is 0swap file : /adm/tmp/swapfile # alternate debug.log file name (assumed to be in specified 'log directory')debug log file : debug.log# if an object is left alone for a certain time, then the# function clean_up will be called. This function can do anything,# like destructing the object. If the function isn't defined by the# object, then nothing will happen.# This time should be substantially longer than the swapping time.time to clean up : 600 # How long time until an unused object is swapped out.# Machine with too many players and too little memory: 900 (15 minutes)# Machine with few players and lot of memory: 10000# Machine with infinite memory: 0 (never swap).#time to swap : 120time to swap : 300# How many seconds until an object is reset again.time to reset : 900 # Maximum number of bits in a bit field. They are stored in printable# strings, 6 bits per byte.maximum bits in a bitfield : 1200 # Max number of local variables in a function.#maximum local variables : 30maximum local variables : 90 # Maximum amount of \"eval cost\" per thread - execution is halted when # it is exceeded.# Because of the heavy load on the Power PC, made it larger to pass the# bad time. (By Annihilator)#maximum evaluation cost : 200000maximum evaluation cost  : 100000000000000 # This is the maximum array size allowed for one single array.maximum array size : 30000# This is the maximum allowed size of a variable of type 'buffer'.#maximum buffer size : 400000maximum buffer size : 40000# Max size for a mappingmaximum mapping size : 15000 # Max inherit chain sizeinherit chain size : 30 # maximum length of a string variablemaximum string length : 200000 # Max size of a file allowed to be read by 'read_file()'.maximum read file size : 200000 # max number of bytes you allow to be read and written with read_bytes # and write_bytesmaximum byte transfer : 10000 # Reserve an extra memory area from malloc(), to free when we run out# of memory; so begins Armageddon.# If this value is 0, no area will be reserved.reserved size : 100 # Define the size of the shared string hash table.  This number should# a prime, probably between 1000 and 30000; if you set it to about 1/5# of the number of distinct strings you have, you will get a hit ratio# (number of comparisons to find a string) very close to 1, as found strings# are automatically moved to the head of a hash chain.  You will never# need more, and you will still get good results with a smaller table.#hash table size : 7001hash table size : 7001 # Object hash table size.# Define this like you did with the strings; probably set to about 1/4 of# the number of objects in a game, as the distribution of accesses to# objects is somewhat more uniform than that of strings.#object table size : 1501object table size : 1501 # default no-matching-action messagedefault fail message : 什麽？# default message when error() occurs (optional)default error message : 你发现事情不大对了，但是又说不上来。################################################################################          The following aren't currently used or implemented (yet)           ################################################################################# maximum number of users in the game.maximum users : 500# Define the maximum stack size of the stack machine. This stack will also# contain all local variables and arguments.  (unused currently)#evaluator stack size : 1000evaluator stack size : 1000 # Define the size of the compiler stack. This defines how complex# expressions the compiler can parse.  (unused currently)#compiler stack size : 200compiler stack size : 200 # Define the maximum call depth for functions. (unused currently)#maximum call depth : 30maximum call depth : 30# There is a hash table for living objects, used by find_living().# (unused currently)living hash table size : 100[1;37m有问题与我联系 Email:[1;35mprowolf@etang.com [2;37;0m[2;37;0m",]),(["author":"望天涯-rcwiz","title":"config","time":1049377629,"msg":"[1;37m有问题与我联系 Email:[1;35mprowolf@etang.com [2;37;0m[2;37;0m",]),(["author":"望天涯-rcwiz","title":"config","time":1049377709,"msg":"################################################################################              Customizable runtime config file for MudOS 0.9.20              ################################################################################# NOTE: All paths specified here are relative to the mudlib directory except  ##       for mudlib directory, and binary directory.                           ## Lines beginning with a # or a newline are ignored.                          ################################################################################ # name of this mudname :炎黄英雄史# port number to accept users onport number : 3000 # the address server is an external program that lets the mud translate# internet names to numbers (and vice versa).  select an unused port.address server ip : 202.98.123.126address server port : 8000 # absolute pathname of mudlibmudlib directory : /home/yhonline/mud # absolute pathname of driver/config dirbinary directory : /home/yhonline/bin # debug.log and author/domain stats are stored herelog directory : /log# the directories which are searched by #include <...># for multiple dirs, separate each path with a ':'include directories : /include # Directory to save binaries in.  (if BINARIES is defined)save binaries directory : /binaries # the file which defines the master objectmaster file : /adm/single/master# The global include file is included automatically. global include file : <globals.h># the file where all global simulated efuns are defined.simulated efun file : /adm/single/simul_efun # file to swap out objects; not used if time to swap is 0swap file : /adm/tmp/swapfile # alternate debug.log file name (assumed to be in specified 'log directory')debug log file : debug.log# if an object is left alone for a certain time, then the# function clean_up will be called. This function can do anything,# like destructing the object. If the function isn't defined by the# object, then nothing will happen.# This time should be substantially longer than the swapping time.time to clean up : 600 # How long time until an unused object is swapped out.# Machine with too many players and too little memory: 900 (15 minutes)# Machine with few players and lot of memory: 10000# Machine with infinite memory: 0 (never swap).#time to swap : 120time to swap : 300# How many seconds until an object is reset again.time to reset : 900 # Maximum number of bits in a bit field. They are stored in printable# strings, 6 bits per byte.maximum bits in a bitfield : 1200 # Max number of local variables in a function.#maximum local variables : 30maximum local variables : 90 # Maximum amount of \"eval cost\" per thread - execution is halted when # it is exceeded.# Because of the heavy load on the Power PC, made it larger to pass the# bad time. (By Annihilator)#maximum evaluation cost : 200000maximum evaluation cost  : 800000 # This is the maximum array size allowed for one single array.maximum array size : 30000# This is the maximum allowed size of a variable of type 'buffer'.#maximum buffer size : 400000maximum buffer size : 400000# Max size for a mapping#maximum mapping size : 15000maximum mapping size : 30000 # Max inherit chain sizeinherit chain size : 30 # maximum length of a string variable#maximum string length : 200000maximum string length : 400000 # Max size of a file allowed to be read by 'read_file()'.maximum read file size : 200000 # max number of bytes you allow to be read and written with read_bytes # and write_bytesmaximum byte transfer : 10000 # Reserve an extra memory area from malloc(), to free when we run out# of memory; so begins Armageddon.# If this value is 0, no area will be reserved.reserved size : 100 # Define the size of the shared string hash table.  This number should# a prime, probably between 1000 and 30000; if you set it to about 1/5# of the number of distinct strings you have, you will get a hit ratio# (number of comparisons to find a string) very close to 1, as found strings# are automatically moved to the head of a hash chain.  You will never# need more, and you will still get good results with a smaller table.#hash table size : 7001hash table size : 7001 # Object hash table size.# Define this like you did with the strings; probably set to about 1/4 of# the number of objects in a game, as the distribution of accesses to# objects is somewhat more uniform than that of strings.#object table size : 1501object table size : 1501 # default no-matching-action messagedefault fail message : 什麽？# default message when error() occurs (optional)default error message : 你发现事情不大对了，但是又说不上来。################################################################################          The following aren't currently used or implemented (yet)           ################################################################################# maximum number of users in the game.maximum users : 500# Define the maximum stack size of the stack machine. This stack will also# contain all local variables and arguments.  (unused currently)#evaluator stack size : 1000evaluator stack size : 1000 # Define the size of the compiler stack. This defines how complex# expressions the compiler can parse.  (unused currently)#compiler stack size : 200compiler stack size : 200 # Define the maximum call depth for functions. (unused currently)#maximum call depth : 30maximum call depth : 30# There is a hash table for living objects, used by find_living().# (unused currently)living hash table size : 100[1;37m有问题与我联系 Email:[1;35mprowolf@etang.com [2;37;0m[2;37;0m",]),(["author":"望天涯-rcwiz","title":"to lonely about 错误出来了","time":1049418309,"msg":"object /adm/single/master: eval_cost too big 800000执行时段错误：*Too long evaluation. Execution aborted.程式：adm/single/master.c 第 430 行物件：/adm/single/master呼叫来自：feature/command.c 的 command_hook() 第 75 行，物件： clone/user/user#23716 (\"信号中断\")呼叫来自：cmds/wiz/ls.c 的 main() 第 82 行，物件： cmds/wiz/ls呼叫来自：adm/single/master.c 的 valid_write() 第 430 行，物件： adm/single/masterobject /adm/single/master: eval_cost too big 800000执行时段错误：*Too long evaluation. Execution aborted.程式：adm/single/master.c 第 430 行物件：/adm/single/master呼叫来自：feature/command.c 的 command_hook() 第 75 行，物件： clone/user/user#23716 (\"信号中断\")呼叫来自：cmds/wiz/ls.c 的 main() 第 82 行，物件： cmds/wiz/ls呼叫来自：adm/single/master.c 的 valid_write() 第 430 行，物件： adm/single/master执行时段错误：*(s)printf(): BUFF_SIZE overflowed... (arg: 0)[1;37m有问题与我联系 Email:[1;35mprowolf@etang.com [2;37;0m[2;37;0m",]),(["author":"望天涯-rcwiz","title":"继续","time":1049418373,"msg":"执行时段错误：*Bad argument 1 to call_other()Expected: string or array or object Got: 0.程式：d/city/duchang3.c 第 132 行物件：/d/city/duchang3呼叫来自：d/city/duchang3.c 的 gamble_prepare() 第 132 行，