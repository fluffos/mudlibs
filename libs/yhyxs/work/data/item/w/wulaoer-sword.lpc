#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m九韶[1;36m定音[1;37m剑[2;37;0m", ({ "sword" }));
  set_weight(6750);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[2;37;0m[1;31m雷火寒晶[2;37;0m炼制而成的一柄剑。
[1;37m剑长四尺二寸，在剑脊一边沿锋口开出九个比尾指尖略捆的小孔，通体[1;36m青光莹莹[1;37m，锋快至令人难以相信。[2;37;0m
剑柄上刻着一行小字：乌老二(wulaoer)
");
  set("value", 2100000);
  set("point", 301);
  set("material", "stone");
  set(
    "wield_msg",
    "[1;37m$N左手以指化剑，在胸前七寸之处画出一个[1;33m六芒星[1;37m，紧接着右手前探，从[1;33m六芒星[1;37m中慢慢祭出一把$n。[2;37;0m\n"
  );
  set("unwield_msg", "$n[1;37m在$N手上颤动起来，起始时啸吟似有若无，转眼化作如龙行天际、低潜渊海，飘忽虚渺至极点的剑啸破空而去。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
