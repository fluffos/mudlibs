#include <ansi.h>
#include <armor.h>

inherit ARMOR;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[36m原罪[2;37;0m", ({ "yuanzui" }));
  set_weight(1800);
  set("item_make", 1);
  set("unit", "张");
  set("long", "这是由[2;37;0m[1;31m阎罗绸[2;37;0m炼制而成的一张护甲。
[33m这是上古神器之一。不知道是什么材料铸造的连身甲，宝刀利剑都不能伤其分毫。[2;37;0m
护甲缘上刻着一行小字：月影岚(gaowei)
");
  set("value", 2000000);
  set("point", 93);
  set("material", "stone");
  set(
    "wear_msg",
    "$N念起召唤咒语：\n[33m大地的精灵呀，你掌管着最终的防御和恢复。\n[33m把你的力量借给我，你忠实的信仰者。\n[1;34m刹那间光华大作，$N身上多了一剑古拙的连身保甲。[2;37;0m\n"
  );
  set("remove_msg", "[33m$N忽然陷入地面中，当他再次陷身的时候，身上的连身护佳已经消失不见了。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/parry", apply_armor() / 15 + 1);
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
