#include <ansi.h>
#include <armor.h>

inherit HEAD;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[35m混沌[2;37;0m", ({ "hundun" }));
  set_weight(2550);
  set("item_make", 1);
  set("unit", "顶");
  set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一顶头盔。
[35m这是上古神器之一，闪烁着阵阵紫光的头巾，不知由何物所铸，宝刀利剑也不能伤它分毫。[2;37;0m
头盔缘上刻着一行小字：月影岚(gaowei)
");
  set("value", 2000000);
  set("point", 58);
  set("material", "stone");
  set("wear_msg", "[35m$N周身突然被一团混混沉沉的烟雾所包围，当烟雾消失的时候，他头上已经带着一条隐隐流露出紫光的头巾。[2;37;0m\n");
  set("remove_msg", "[1;36m一道青光划过，$N头上的头巾似乎溶入空气消失不见了。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
