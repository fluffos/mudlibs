#include <ansi.h>
#include <armor.h>

inherit WAIST;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;32m饶月太虚[2;37;0m", ({ "dai" }));
  set_weight(960);
  set("item_make", 1);
  set("unit", "条");
  set("long", "这是由[2;37;0m[1;31m阎罗绸[2;37;0m炼制而成的一条腰带。
[1;33m这是上古神器之一，闪烁着阵阵紫光的腰带，不知由何物所织，坚韧有如玄铁。[2;37;0m
腰带缘上刻着一行小字：月影岚(gaowei)
");
  set("value", 2000000);
  set("point", 46);
  set("material", "stone");
  set(
    "wear_msg",
    "[1;31m$N微一凝神，运起九阳神功，将真气凝聚在丹田之中，沿奇经八脉遍布全身！\n[1;31m$N默念九阳神功的口诀：他强由他强，清风拂山冈。他横任他横，明月照大江……\n[1;31m刹那间只见$N全身顿时浮现出一层刚猛的劲气。[2;37;0m\n"
  );
  set("remove_msg", "[1;33m一道金光划过，$N腰上的长带，溶入空气消失不见。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
