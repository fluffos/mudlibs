#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m灭神斩[2;37;0m", ({ "zhi" }));
  set_weight(1190);
  set("item_make", 1);
  set("unit", "套");
  set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一套指套。
[1;31m安萧然微一凝神，运起九阳神功，将真气凝聚在丹田之中，沿奇经八脉遍布全身！[2;37;0m
指套缘上刻着一行小字：安萧然(jiao)
");
  set("value", 2000000);
  set("point", 171);
  set("material", "stone");
  set("wear_msg", "[1;31m$N默念九阳神功的口诀：他强由他强，清风拂山冈。他横任他横，明月照大江……[2;37;0m\n");
  set("remove_msg", "[1;31m刹那间只见你全身顿时浮现出一层刚猛的劲气，将你全全笼罩。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/finger", 10);
  set("armor_prop/claw", 10);
  set("armor_prop/armor", 10);

  setup();
}

string long() { return query("long") + item_long(); }
