#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;32m三清剑[2;37;0m", ({ "sanqing" }));
  set_weight(5100);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一柄剑。
剑柄上刻着一行小字：镜中花(jzh)
");
  set("value", 2000000);
  set("point", 135);
  set("material", "stone");
  set("wield_msg", "[1;34m只见一声轻啸，从背后抽出一把流光四射的利剑，瞬间浩然正气布满你全身[2;37;0m\n");
  set("unwield_msg", "[37m还剑入鞘，浩然正气慢慢消退[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
