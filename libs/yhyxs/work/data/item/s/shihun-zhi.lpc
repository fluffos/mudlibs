#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[37m指套[2;37;0m", ({ "zhi" }));
  set_weight(1190);
  set("item_make", 1);
  set("unit", "套");
  set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一套指套。
[36m一个毫不起眼的[2;37;0m[37m指套[2;37;0m[36m。[2;37;0m
指套缘上刻着一行小字：失魂引(shihun)
");
  set("value", 2000000);
  set("point", 138);
  set("material", "stone");
  set("wear_msg", "$n[36m嘟囔着：“该我了么？”[2;37;0m\n");
  set("remove_msg", "$n[36m真是舍不得走呀，可是．．．呜呜呜呜呜呜呜呜[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/finger", 10);
  set("armor_prop/armor", 10);
  set("armor_prop/claw", 10);
  set("armor_prop/unarmed_damage", apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
