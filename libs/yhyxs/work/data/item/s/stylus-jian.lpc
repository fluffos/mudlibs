#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m疾风魔狼剑[2;37;0m", ({ "jian" }));
  set_weight(30000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[2;37;0m[36m天山玄铁[2;37;0m炼制而成的一柄剑。
[1;33m这是夜叉王黑木凯的贴身佩剑。[2;37;0m
剑柄上刻着一行小字：妙沁(stylus)
");
  set("value", 2200000);
  set("point", 126);
  set("material", "stone");
  set("wield_msg", "[1;31m$N[1;31m一声长啸，手中幻出一把通身黝黑的长剑。\n[1;32m天际中出现临兵斗者皆阵列在前几个大字。[2;37;0m\n");
  set("unwield_msg", "[1;33m$N背过身去微微一笑，$n[1;33m飘散不见了。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
