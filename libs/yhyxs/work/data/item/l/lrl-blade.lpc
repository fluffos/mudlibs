#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;36m冷月宝刀[2;37;0m", ({ "blade" }));
  set_weight(30000);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[2;37;0m[36m天山玄铁[2;37;0m炼制而成的一把刀。
[1;36m这是一柄形如冷月的宝刀，整个刀身冷气森森，锐利无比。[2;37;0m
刀柄上刻着一行小字：胡映雪(lrl)
");
  set("value", 2200000);
  set("point", 120);
  set("material", "stone");
  set("wield_msg", "[1;36m$N抽出柄形如冷月的长刀，顿时只觉寒气逼人，刀光如水，流转不定。[2;37;0m\n");
  set("unwield_msg", "[1;36m$N弹刀清啸，心中感慨，将冷月宝刀插回刀鞘。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_blade(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
