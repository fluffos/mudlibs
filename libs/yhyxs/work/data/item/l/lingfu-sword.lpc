#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("长剑[2;37;0m", ({ "sword" }));
  set_weight(30000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[2;37;0m[36m天山玄铁[2;37;0m炼制而成的一柄剑。
剑柄上刻着一行小字：灵福(lingfu)
");
  set("value", 2200000);
  set("point", 136);
  set("material", "stone");
  set("wield_msg", "$N「唰」的一声抽出一柄长剑握在手中。[2;37;0m\n");
  set("unwield_msg", "$N将手中的长剑插回剑鞘。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
