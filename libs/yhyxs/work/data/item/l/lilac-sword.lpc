#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[34m尘封[35m四季[1;32m泪[2;37;0m", ({ "sword" }));
  set_weight(5100);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一柄剑。
[1;36m我的爱人　曾含泪
[1;36m将我埋藏
[1;36m用珠玉　用乳香
[1;36m将我光滑的身躯包裹
[1;36m再用颤抖的手　将鸟羽
[1;36m插在我如缎的发上[2;37;0m
剑柄上刻着一行小字：子陵(lilac)
");
  set("value", 2000000);
  set("point", 121);
  set("material", "stone");
  set("wield_msg", "[35m我已无诗\n[35m世间也再无飞花　无细雨\n[35m尘封的四季啊\n[35m请别哭泣[2;37;0m\n");
  set(
    "unwield_msg",
    "[34m万般　万般的无奈\n[34m爱的余烬已熄\n[34m重回人间\n[34m猛然醒觉那千条万条　都是\n[34m已知的路　已了然的轨迹[2;37;0m\n"
  );
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
