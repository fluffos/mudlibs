#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m帝者神剑[2;37;0m", ({ "sword" }));
  set_weight(5100);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一柄剑。
[1;33m这柄[1;37m帝者神剑[1;33m威胜轩辕却显为人知，乃黄帝为后世真命天子所铸，
内蕴龙脉，具有某种神奇的力量。[2;37;0m
剑柄上刻着一行小字：段良(lhl)
");
  set("value", 2000000);
  set("point", 119);
  set("material", "stone");
  set(
    "wield_msg",
    "[1;37m帝者神剑[1;33m飞龙般窜入$N手中，龙吟之声随之响彻天地，四周金光万丈。\n众人只觉手中兵刃在不住的上下摆动，竟似在对这柄[1;35m神兵[1;33m叩拜行礼。[2;37;0m\n"
  );
  set("unwield_msg", "[1;34m$N手抚剑身，口中轻叹。[1;37m帝者神剑[1;34m又飞龙般腾空而去，龙吟之声渐退，众人这才松了口气。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
