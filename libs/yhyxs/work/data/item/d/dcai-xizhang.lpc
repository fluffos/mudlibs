#include <ansi.h>
#include <weapon.h>

inherit STAFF;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m九环锡杖[2;37;0m", ({ "xizhang" }));
  set_weight(5100);
  set("item_make", 1);
  set("unit", "根");
  set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一根杖。
[1;37m这是一根通体漆黑的锡杖，入手极为沉重，非常坚韧，乃少林寺历代相传的圣物。有云：铜镶铁造九连环，九节仙藤永驻颜。[2;37;0m
杖柄上刻着一行小字：段尘埃(dcai)
");
  set("value", 2000000);
  set("point", 126);
  set("material", "stone");
  set("wield_msg", "[1;37m$N取出九环锡杖握于手中，霎时金波荡漾，有若七佛随身。[2;37;0m\n");
  set("unwield_msg", "[1;37m$N微微一笑，将手中的九环锡杖放回包囊。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_staff(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
