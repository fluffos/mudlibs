#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;32m刮胡子刀[2;37;0m", ({ "sword" }));
  set_weight(6750);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[2;37;0m[1;31m雷火寒晶[2;37;0m炼制而成的一柄剑。
剑柄上刻着一行小字：刀霸(bang)
");
  set("value", 1600000);
  set("point", 91);
  set("material", "stone");
  set("wield_msg", "[1;36m“刷”[1;37m的一声，一把[1;31m利刃[1;37m向你迎面袭来，你只觉的下巴一凉，保存许久的胡子不见了。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
