#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;32m水[1;36m月[2;37;0m", ({ "happyyue" }));
  set_weight(5100);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一柄剑。
[1;32m有天有地胸怀坦荡，有茶有酒情浓意深，风流倜傥谁尊长？无忧无愁歌欢语畅，无恼无恨笑看沧桑，云过烟散还有我！　[2;37;0m
剑柄上刻着一行小字：天羽(flylove)
");
  set("value", 2000000);
  set("point", 120);
  set("material", "stone");
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一柄[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
