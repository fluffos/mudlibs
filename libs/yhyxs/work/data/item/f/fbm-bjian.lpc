#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;34m冰冷[31m魔[34m剑[2;37;0m", ({ "bjian" }));
  set_weight(30000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[2;37;0m[36m天山玄铁[2;37;0m炼制而成的一柄剑。
[1;34m这是一把从天山童老他妈身上偷到的邪剑，一看剑上有好大的[31m妖[1;34m气。[2;37;0m
剑柄上刻着一行小字：绝情剑魔(fbm)
");
  set("value", 2200000);
  set("point", 130);
  set("material", "stone");
  set("wield_msg", "[1;34m宝剑突然一下子在你身前出先。。。哇呀。。吓死人了。。。[31m妖气。。。。。。[2;37;0m\n");
  set("unwield_msg", "[32m突然一下子有一大堆毒气出先。。。剑和[31m妖气[32m全没了。。。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
