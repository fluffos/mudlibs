#include <ansi.h>
#include <armor.h>

inherit ARMOR;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[37m软猬甲[2;37;0m", ({ "jia" }));
  set_weight(1800);
  set("item_make", 1);
  set("unit", "张");
  set("long", "这是由[2;37;0m[1;31m阎罗绸[2;37;0m炼制而成的一张护甲。
[37m相传为昔日黄药师护身软甲，刀枪不入，百毒不侵。[2;37;0m
护甲缘上刻着一行小字：纳兰容情(rongqing)
");
  set("value", 2000000);
  set("point", 111);
  set("material", "stone");
  set("wear_msg", "[33m$N[33m装备[2;37;0m[37m软猬甲[2;37;0m[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[2;37;0m[37m软猬甲[2;37;0m[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/parry", apply_armor() / 15 + 1);
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
