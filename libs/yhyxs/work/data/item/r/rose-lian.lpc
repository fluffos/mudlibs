#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m清香白莲[2;37;0m", ({ "lian" }));
  set_weight(1350);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;32m乾[1;37m坤[1;33m石[2;37;0m炼制而成的一双铁掌。
[1;37m一朵小小的白色的莲花，含苞待放，散发出淡淡的清香。[2;37;0m
铁掌缘上刻着一行小字：玉玲珑(rose)
");
  set("value", 2200000);
  set("point", 147);
  set("material", "stone");
  set(
    "wear_msg",
    "[37m修五百年同舟，修千年共枕。\n[1;36m$N[1;37m两手交错，形若莲花，口中念道：“盛开吧，莲花。”白莲灿烂的绽放着，悠然在青雾中。[2;37;0m\n"
  );
  set("remove_msg", "[1;36m$N[1;37m爱怜的叹息着，把手伸向莲蓬。一滴如眼泪的莲子落入$N的掌中，玲珑剔透，光华烁然，凝成一粒佛珠。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/hand", 10);
  set("armor_prop/strike", 10);
  set("armor_prop/armor", 10);
  set("armor_prop/unarmed_damage", apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
