#include <ansi.h>
#include <armor.h>

inherit ARMOR;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;36m逍[1;37m遥[1;32m甲[2;37;0m", ({ "clothc" }));
  set_weight(1800);
  set("item_make", 1);
  set("unit", "张");
  set("long", "这是由[2;37;0m[1;31m阎罗绸[2;37;0m炼制而成的一张护甲。
护甲缘上刻着一行小字：剡狨(yanrong)
");
  set("value", 2000000);
  set("point", 108);
  set("material", "stone");
  set("wear_msg", "$N穿上一件[1;36m逍[1;37m遥[1;32m甲[2;37;0m。[2;37;0m\n");
  set("remove_msg", "$N将[1;36m逍[1;37m遥[1;32m甲[2;37;0m脱了下来。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/parry", apply_armor() / 15 + 1);
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
