#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m忘情[2;37;0m", ({ "love" }));
  set_weight(1530);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一双铁掌。
[1;37m这是逍遥子送给他弟子蕴秋的礼物，好象很厉害的哦。[2;37;0m
铁掌缘上刻着一行小字：蕴秋(yunqiu)
");
  set("value", 2000000);
  set("point", 120);
  set("material", "stone");
  set("wear_msg", "[1;32m此情可待成追忆\n\n[35m只是当时已惘然[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[1;37m忘情[2;37;0m[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/armor", 10);
  set("armor_prop/strike", 10);
  set("armor_prop/hand", 10);

  setup();
}

string long() { return query("long") + item_long(); }
