#include <ansi.h>
#include <weapon.h>

inherit XSWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("结婚戒指[2;37;0m", ({ "jiezhi" }));
  set_weight(1350);
  set("item_make", 1);
  set("unit", "支");
  set("long", "这是由[2;37;0m[1;31m雷火寒晶[2;37;0m炼制而成的一支箫。
这是小瓜送给孙君的定情信物。[2;37;0m
箫柄上刻着一行小字：小瓜(abc)
");
  set("value", 1600000);
  set("point", 97);
  set("material", "stone");
  set("wield_msg", "孙君戴上了一枚结婚戒指。[2;37;0m\n");
  set("unwield_msg", "孙君脱下了一枚结婚戒指。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_xsword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
