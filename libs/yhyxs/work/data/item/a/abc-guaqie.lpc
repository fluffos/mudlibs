#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("瓜切[2;37;0m", ({ "guaqie" }));
  set_weight(2700);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[2;37;0m[33m乌金矿[2;37;0m炼制而成的一柄剑。
此剑一看异常锋利，是把切瓜的好剑。[2;37;0m
剑柄上刻着一行小字：小瓜(abc)
");
  set("value", 1200000);
  set("point", 68);
  set("material", "stone");
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一柄[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
