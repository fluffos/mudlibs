#include <ansi.h>
#include <armor.h>

inherit BOOTS;
inherit F_ITEMMAKE;

void create() {
  set_name("战靴[2;37;0m", ({ "zhanxue" }));
  set_weight(720);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[2;37;0m[1;31m阎罗绸[2;37;0m炼制而成的一双靴子。
靴子缘上刻着一行小字：希望(xiwang)
");
  set("value", 2000000);
  set("point", 36);
  set("material", "stone");
  set("wear_msg", "[33m$N[33m装备战靴[2;37;0m[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了战靴[2;37;0m[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/dodge", apply_armor() / 10 + 1);
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
