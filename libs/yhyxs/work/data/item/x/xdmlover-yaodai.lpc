#include <ansi.h>
#include <armor.h>

inherit WAIST;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m阎罗腰带[2;37;0m", ({ "yaodai" }));
  set_weight(960);
  set("item_make", 1);
  set("unit", "条");
  set("long", "这是由[2;37;0m[1;31m阎罗绸[2;37;0m炼制而成的一条腰带。
腰带缘上刻着一行小字：鬼烧(xdmlover)
");
  set("value", 2000000);
  set("point", 69);
  set("material", "stone");
  set("wear_msg", "[33m$N[33m装备[1;31m阎罗腰带[2;37;0m[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[1;31m阎罗腰带[2;37;0m[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
