#include <ansi.h>
#include <armor.h>

inherit HANDS;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;36m破天掌[2;37;0m", ({ "ptz" }));
  set_weight(1350);
  set("item_make", 1);
  set("unit", "双");
  set("long", "这是由[1;32m乾[1;37m坤[1;33m石[2;37;0m炼制而成的一双铁掌。
[1;36m这是一块晶莹剔透的石掌，石面光华流转，便似活物一般。[2;37;0m
铁掌缘上刻着一行小字：纳兰(mong)
");
  set("value", 2200000);
  set("point", 194);
  set("material", "stone");
  set("wear_msg", "$N面露拈花之意，祭起决式，霎时碧波流转，华光万丈，说不尽的祥和。\n[1;36m破天掌[2;37;0m出现在$N手中。[2;37;0m\n");
  set("remove_msg", "[1;36m破天掌[2;37;0m一声轻响，从$N掌上消失不见。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/unarmed_damage", apply_damage());
  set("armor_prop/strike", 10);
  set("armor_prop/armor", 10);
  set("armor_prop/hand", 10);

  setup();
}

string long() { return query("long") + item_long(); }
