#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;36m淡烟秀才装[2;37;0m", ({ "mcloth" }));
  set_weight(2400);
  set("item_make", 1);
  set("unit", "件");
  set("long", "这是由[2;37;0m[1;31m阎罗绸[2;37;0m炼制而成的一件战衣。
这是一件天青色战衣，柔软的表面射出耀眼的光泽。这是传说中的至宝：[1;36m淡烟秀才装[2;37;0m。[2;37;0m
战衣缘上刻着一行小字：纳兰(mong)
");
  set("value", 2000000);
  set("point", 169);
  set("material", "stone");
  set("wear_msg", "$N利索的穿上[1;36m淡烟秀才装[2;37;0m。[2;37;0m\n");
  set("remove_msg", "$N利索的脱下[1;36m淡烟秀才装[2;37;0m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
