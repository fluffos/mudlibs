#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;33m腾龙剑[2;37;0m", ({ "tlj" }));
  set_weight(5100);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一柄剑。
[1;33m一柄锋利的长剑，剑身宛如流水，隐隐漾着青光。[2;37;0m
剑柄上刻着一行小字：苗灵(miaomiao)
");
  set("value", 2000000);
  set("point", 386);
  set("material", "stone");
  set("wield_msg", "[1;33m$N唰的抽出一柄利剑握在手中，剑身青光荡漾，寒气逼人。[2;37;0m\n");
  set("unwield_msg", "[1;33m$N空舞了数个剑花，将腾龙宝剑插回腰间。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
