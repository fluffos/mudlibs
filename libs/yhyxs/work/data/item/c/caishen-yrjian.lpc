#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[37m白虹剑[2;37;0m", ({ "yrjian" }));
  set_weight(5100);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一柄剑。
[1;37m这是一口削铁如泥的宝剑。[2;37;0m
剑柄上刻着一行小字：静财(caishen)
");
  set("value", 2000000);
  set("point", 122);
  set("material", "stone");
  set("wield_msg", "[1;32m$N[1;31m一声清啸，将手中$n[1;31m由右手交到左手，简单的划了道弧线，但其中杀气却让你几乎喘不过气来。[2;37;0m\n");
  set("unwield_msg", "[1;32m$N将手中$n[1;32m缓缓放了下来，你却还是能感到四散的杀气。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
