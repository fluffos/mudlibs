#include <ansi.h>
#include <weapon.h>

inherit BLADE;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[30m魔刀[2;37;0m", ({ "bladea" }));
  set_weight(6750);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[2;37;0m[1;31m雷火寒晶[2;37;0m炼制而成的一把刀。
刀柄上刻着一行小字：诸葛晓鄢(ccbzjcon)
");
  set("value", 1600000);
  set("point", 91);
  set("material", "stone");
  set("wield_msg", "$N抽出一把[1;33m魔域[30m魔刀[2;37;0m握在手中。[2;37;0m\n");
  set("unwield_msg", "$N放下手中的[1;33m魔域[30m魔刀[2;37;0m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_blade(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
