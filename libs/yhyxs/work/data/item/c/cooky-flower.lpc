#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m筱舞[2;37;0m", ({ "flower" }));
  set_weight(2400);
  set("item_make", 1);
  set("unit", "件");
  set("long", "这是由[2;37;0m[1;31m阎罗绸[2;37;0m炼制而成的一件战衣。
[1;37m香靥凝羞一笑开。柳腰如醉暖相挨。日长春困下楼台。
[1;37m照水有情聊整鬓，倚阑无绪更兜鞋。眼边牵系懒归来。[2;37;0m
战衣缘上刻着一行小字：甜饼(cooky)
");
  set("value", 2000000);
  set("point", 90);
  set("material", "stone");
  set(
    "wear_msg",
    "[1;37m寻寻觅觅，冷冷清清，凄凄惨惨戚戚。\n[1;37m乍暖还寒时候，最难将息。三杯两盏淡酒，怎敌他、晚来风急。\n[1;37m雁过也，正伤心，却是旧时相识。[2;37;0m\n"
  );
  set("remove_msg", "[33m$N[33m脱下了[1;37m筱舞[2;37;0m[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
