#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[37m筱舞[2;37;0m", ({ "mao" }));
  set_weight(30000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[2;37;0m[36m天山玄铁[2;37;0m炼制而成的一柄剑。
[37m绝代有佳人，幽居在空谷。但见新人笑，那闻旧人哭。[2;37;0m
剑柄上刻着一行小字：甜饼(cooky)
");
  set("value", 2200000);
  set("point", 188);
  set("material", "stone");
  set("wield_msg", "[37m燕鸿过后莺归去，细算浮生千万绪。长于春梦几多时，散似秋云无觅处。[2;37;0m\n");
  set("unwield_msg", "[37m闻琴解佩神仙侣，挽断罗衣留不住。劝君莫作独醒人，烂醉花间应有数。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
