#include <ansi.h>
#include <armor.h>

inherit CLOTH;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;37m孔雀羽衣[2;37;0m", ({ "yuyi" }));
  set_weight(2400);
  set("item_make", 1);
  set("unit", "件");
  set("long", "这是由[2;37;0m[1;31m阎罗绸[2;37;0m炼制而成的一件战衣。
[1;37m这是一件出自天宫织女妙手神裁的羽纱轻衣。款式新颖别致轻柔飘逸的。放在手中简直轻若无物，真是一件服饰极品。[2;37;0m
战衣缘上刻着一行小字：灭财(caishen)
");
  set("value", 2000000);
  set("point", 157);
  set("material", "stone");
  set("wear_msg", "[33m$N[33m装备[1;37m孔雀羽衣[2;37;0m[33m。[2;37;0m\n");
  set("remove_msg", "[33m$N[33m脱下了[1;37m孔雀羽衣[2;37;0m[33m。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());

  setup();
}

string long() { return query("long") + item_long(); }
