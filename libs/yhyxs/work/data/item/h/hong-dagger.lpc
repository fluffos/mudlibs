#include <ansi.h>
#include <weapon.h>

inherit DAGGER;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;36m练习匕首[2;37;0m", ({ "dagger" }));
  set_weight(1350);
  set("item_make", 1);
  set("unit", "支");
  set("long", "这是由[37m精铁[2;37;0m炼制而成的一支短兵。
短兵柄上刻着一行小字：红孩儿(hong)
");
  set("value", 800000);
  set("point", 30);
  set("material", "iron");
  set("wield_msg", "[1;36m$N[1;36m一声清啸，抖出一支[1;36m$n[1;36m。[2;37;0m\n");
  set("unwield_msg", "$N随手一抹，收起了$n。\n");
  if (!check_clone()) return;
  restore();
  init_dagger(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
