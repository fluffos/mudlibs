#include <ansi.h>
#include <armor.h>

inherit ARMOR;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;31m防火墙[2;37;0m", ({ "qiang" }));
  set_weight(1800);
  set("item_make", 1);
  set("unit", "张");
  set("long", "这是由[2;37;0m[1;31m阎罗绸[2;37;0m炼制而成的一张护甲。
[1;31m这是峰峰的随身护甲，咋一看竟然是堵高墙？？不可思议！也许墙壁才是最好的防具吧！！[2;37;0m
护甲缘上刻着一行小字：峰峰(hjshzq)
");
  set("value", 2000000);
  set("point", 105);
  set("material", "stone");
  set("wear_msg", "[1;31m突然只见$N在自己周围垒起了一堵高墙．看来是$N的防护之术吧！[2;37;0m\n");
  set("remove_msg", "[1;31m$N看见周围一切都安全了，就马上把防火墙撤了！[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  set("armor_prop/armor", apply_armor());
  set("armor_prop/parry", apply_armor() / 15 + 1);

  setup();
}

string long() { return query("long") + item_long(); }
