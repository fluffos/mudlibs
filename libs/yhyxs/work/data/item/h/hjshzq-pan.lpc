#include <ansi.h>
#include <weapon.h>

inherit HAMMER;
inherit F_ITEMMAKE;

void create() {
  set_name("[1;36m游戏光盘[2;37;0m", ({ "pan" }));
  set_weight(11900);
  set("item_make", 1);
  set("unit", "把");
  set("long", "这是由[1;36m离[1;31m火[1;36m玄[1;37m冰[1;36m玉[2;37;0m炼制而成的一把锤。
[1;32m这是一张市面上看不到的游戏光盘．盘面上晶莹剔透，镶有南非钻石．光盘周围有锋利的锯齿，上面涂有灭害灵．使人见了不寒而栗．[2;37;0m
锤柄上刻着一行小字：峰峰(hjshzq)
");
  set("value", 2000000);
  set("point", 135);
  set("material", "stone");
  set(
    "wield_msg",
    "[35m只听“哐当”一声，$N手中已多出一物，只见$N目中精光四射，威风凛凛，宛若天神．手中之物，嗡嗡之声大作．众人只觉得气血上涌，压抑难当，纷纷坐下运功调息．[2;37;0m\n"
  );
  set("unwield_msg", "[1;32m只听“锵锵”一声，$N一声上叹，将游戏光盘收回腰间，嗡嗡几声仍是余响不绝．[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_hammer(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
