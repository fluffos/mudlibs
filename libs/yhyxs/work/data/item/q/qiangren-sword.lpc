#include <ansi.h>
#include <weapon.h>

inherit SWORD;
inherit F_ITEMMAKE;

void create() {
  set_name("[2;37;0m[36m傲气冲天剑[2;37;0m", ({ "sword" }));
  set_weight(30000);
  set("item_make", 1);
  set("unit", "柄");
  set("long", "这是由[2;37;0m[36m天山玄铁[2;37;0m炼制而成的一柄剑。
[1;36m剑长三尺，集天地之灵气，由剑师干将所铸。剑脊刻有古文，剑锋青光荡漾，锋利无比。[2;37;0m
剑柄上刻着一行小字：胡行(qiangren)
");
  set("value", 2200000);
  set("point", 207);
  set("material", "stone");
  set("wield_msg", "[1;36m$N一声清啸，从腰间抽出一柄傲气冲天剑，剑光如水，寒气扑面而至。[2;37;0m\n");
  set("unwield_msg", "[1;36m$N悠悠一声长叹，轻轻拭去傲气冲天剑剑锋上的血迹，反手插入剑鞘。[2;37;0m\n");
  if (!check_clone()) return;
  restore();
  init_sword(apply_damage());

  setup();
}

string long() { return query("long") + item_long(); }
