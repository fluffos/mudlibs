string chinese_number(int i) {
  return CHINESE_D->chinese_number(i);
}

string to_chinese(string str) {
  return CHINESE_D->chinese(str);
}

// AGENTS.md §15h: this driver indexes strings by UTF-8 codepoint, not raw
// GBK byte -- str[i] used to be a GBK lead/trail byte pair (176-247 /
// 161-254), now it's one full Chinese character's Unicode codepoint.
// Rewritten as a CJK Unified Ideographs range check, one character per
// index, no more even-length/byte-pair assumption.
int is_chinese(string str) {
  int i;

  if (strlen(str) < 1) return 0;

  for (i = 0; i < strlen(str); i++) {
    if (str[i] < 0x4e00 || str[i] > 0x9fff) return 0;
  }

  return 1;
}
