// file.c

void assure_file(string file);

void cat(string file) {
  write(read_file(file));
}

void log_file(string file, string text) {
  // FIX (AGENTS.md §7.11-class): file may include a subdirectory under
  // LOG_DIR (e.g. "nosave/CRASHES", "nosave/PURGE", "nosave/SUICIDE")
  // that doesn't exist in a fresh work/ tree -- write_file() throws
  // uncaught in that case. Registration/login itself only logs to
  // top-level files (USAGE, ATTEMPT_LOGIN) that already exist, so this
  // doesn't block the core playtest path, but every nosave/* admin path
  // (suicide, crash log, purge, promotion) would hit it on first use.
  assure_file(LOG_DIR + file);
  write_file(LOG_DIR + file, text);
}

void assure_file(string file) {
  string path, *dir;
  int i;

  if (file_size(file) != -1) return;

  seteuid(ROOT_UID);
  dir = explode(file, "/");
  dir = dir[0..sizeof(dir) - 2];
  path = "/";
  for (i = 0; i < sizeof(dir); i++) {
    path += dir[i];
    mkdir(path);
    path += "/";
  }
}

string base_name(object ob) {
  string file;

  if (sscanf(file_name(ob), "%s#%*d", file) == 2)
    return file;
  else
    return file_name(ob);
}
