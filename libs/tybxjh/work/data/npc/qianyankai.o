dbase (["per":28,"chat_chance":2,"actions":,"jiali":10,"chat_msg":({"钱眼开骄傲的说道：本银号已经有上百年的历史，在江南可以说是第一家。","钱眼开说道：昨天我亲自看到一个杀手帮的人来取钱，看来杀手帮重出江湖了。钱眼开笑着说道：杀手帮重出江湖对本银号来说，真是求之不的呀！。钱眼开笑着说道：当年雾中楼在本银号存的钱可以说是最多的了。","钱眼开笑着说道：在本店存钱无利息，取钱收百分之一的手续费，客官您看着办吧。","钱眼开微微一笑，说道：本店还办理不同面额货币的兑换业务，是免费的。",}),"title":"钱庄老板","jing":200,"kaifa":40,"default_actions":,"qi":233,"jizhi":55,"race":"人类","name":"钱眼开","gender":"男性","eff_qi":233,"shen":0,"eff_jing":200,"max_jing":200,"id":"qian yankai","attitude":"friendly","combat_exp":12500,"area_id":"yzqianzhuang","str":100,"startroom":"/d/city/qianzhuang","env":(["wimpy":50,]),"max_qi":233,"nickname":"铁公鸡","neili":200,"int":24,"age":34,"area_name":"扬州钱庄","food":1150,"max_neili":100,"pighead":0,"area_file":"/d/city/npc/qian.c","shen_type":1,"ziyuan":"黄金","con":18,"water":1150,"dex":18,"no_put":1,"kar":21,])
