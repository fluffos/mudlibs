dbase (["eff_qi":268,"water":46,"per":15,"pighead":0,"eff_jing":40000,"long":"顾先生被称为当世第一大文学家，肚子里的墨水比海还要深。","id":"gu yanwu","qi":268,"zhengzhao":1,"shen":40000,"age":65,"max_qi":268,"chat_chance":3,"food":46,"neili":0,"combat_exp":400000,"shen_type":1,"chat_msg":({"顾炎武说道：普天之下，莫非王土；率土之滨，莫非王臣。","顾炎武说道：出家人，小过损益焉；无妄大过，未济咸困之。","顾炎武说道：大学之道，在明明德。在亲民，在止于至善。 ","顾炎武说道：格物致知，诚意正心，修身齐家，治国平天下。",}),"jingli":40000,"jing":40000,"str":12,"int":17,"actions":,"last_save":1134848803,"max_jingli":40000,"startroom":"/d/city2/shuyuan","no_suck":1,"max_jing":40000,"default_actions":,"name":"顾炎武","con":28,"gender":"男性","dex":28,"race":"人类","kar":30,])
