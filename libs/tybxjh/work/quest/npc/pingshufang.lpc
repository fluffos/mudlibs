#include <ansi.h>
inherit ROOM;

void create()
{
        set("short",HIY"评书房"NOR);

        set("long",@LONG
这里是扬州城内的评书房，里面挤满了从四周赶来听书的人，一张木桌
摆在靠窗的位置，边上坐着一位须发皆白的说书老者，每说到精彩之处，众
人无不高声叫好,几名小二在人群中穿梭，端茶倒水，忙的不亦乐忽。
LONG);
        set("exits",([ /* sizeof() == 1 */
                "south": __DIR__"wumiao"]));
        set("objects",([
                "/quest/npc/yelao": 1
                       ]));

        set("no_fight",1);
        set("valid_startroom", 1);
        setup();
}
