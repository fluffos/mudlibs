inherit NPC;
#include <ansi.h>
int big_blowing();
void create() {
  set_name(HIR "烈火孽龙" NOR, ({ "dragon" }));
  set("race", "野兽");
  set("gender", "雄性");
  set("age", 200);
  set("long",
    "这是一条全身赤红，吸天地之间的火气而长大的孽龙！
它全身散发着赤红色的火焰。\n");

  set("str", 1580);
  set("con", 2152);
  set("dex", 1222);

  set("dodge", 5100);
  set("zjb_dj/dj", 30);
  set("no_suck", 1);
  set("no_get", 1);
  set("force", 5100);
  set("unarmed", 5100);
  set("parry", 5100);
  set("max_qi", 9999999);
  set("max_jing", 9999999);
  set("max_neili", 901000);
  set("neili", 9001000);
  set("jiali", 3000);
  set("attitude", "aggressive");
  set("limbs", ({ "头部", "身体", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));
  set("chat_chance_combat", random(30) + 10);
  set("chat_msg_combat", ({
    (: big_blowing :)
  }));

  set("combat_exp", 90000000 + random(11110000));
  set("bellicosity", 30000);

  set_temp("apply/attack", 1560 + random(400));
  set_temp("apply/damage", 1500 + random(400));
  set_temp("apply/armor", 1500 + random(400));

  setup();
}
int big_blowing() {
  remove_call_out("hurting");
  message_vision(HIR "\n\n烈火孽龙深深地吸入一口气，全身转为鲜红的火色，整个龙腹胀大了几倍！！\n\n" NOR,
    this_object());
  call_out("hurting", random(1) + 1);


  return 1;
}

int hurting() {
  int i;
  int dam;
  object *inv;
  message_vision(HIR "\n\n烈火孽龙吐出一股炽可焚金的火焰．．整个天地似乎都被燃烧着！！！\n\n", this_object());
  inv = all_inventory(environment(this_object()));
  for (i = sizeof(inv) - 1; i >= 0; i--)
    if (living(inv[i]))
      if (inv[i] != this_object()) {
        dam = random(1000) + 100;
        if (dam < 0) dam = 0;
        inv[i]->receive_wound("qi", dam);
        COMBAT_D->report_status(inv[i], 1);
      }
  return 1;
}
void die() {
  object obj;
  object killer;
  int exp, userexp;
  if (objectp(killer = this_object()->query_temp("last_damage_from"))) {
    userexp = killer->query("zjb_dj/dj");
    exp = ((int)killer->query_skill("literate", 1) * 20) + random(10000);
    /*
        obj = new("/quest/tulong/obj/drug");
        obj->move(environment(this_object()));
        obj = new("/quest/tulong/obj/drug");
        obj->move(environment(this_object())); 
*/

    if (killer->query("m_success/wait") < time()) {
      obj = new("/quest/tulong/obj/drug");
      obj->move(environment(this_object()));
      obj = new("/quest/tulong/obj/drug");
      obj->move(environment(this_object()));
      killer->set_temp("m_success/孽龙", 1);
      killer->add("combat_exp", exp);
      killer->add("potential", 50000);
      killer->set("m_success/wait", time() + 6600);
      message(
        "channel:rumor",
        HBMAG "【精灵神界】" + killer->query("name") + "成功地杀死了恶龙，解开了封印!得到" + chinese_number(exp) + "经验和五万潜能!\n" NOR,
        users()
      );
    }
    tell_object(killer, HIR "\n\n一团火焰猛地升腾，一个声音说道：谢谢你解开了第四个封印，这两颗龙元就作为谢礼吧！！！\n" NOR);
  }
  message_vision("$N化作一缕清风而去。\n", this_object());
  destruct(this_object());
  //        ::die();
}
