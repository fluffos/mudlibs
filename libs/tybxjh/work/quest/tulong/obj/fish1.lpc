inherit NPC;

void create() {
  set_name("鱼怪", ({ "fish monster", "fish" }));
  set("race", "野兽");
  set("age", 300);
  set("long", "这是一只身形很大，已成精怪的鱼，浑身覆满绚丽的鳞片，\n"
    "一口锋利的牙齿，正虎视耽耽的看着你\n");
  set("attitude", "aggressive");

  set("max_qi", 20000000);
  set("max_jing", 20000000);
  set("jing", 20000000);
  set("qi", 20000000);
  set("max_neili", 10000);
  set("neili", 20000000);
  set("str", 2600);
  set("zjb_dj/dj", 25);
  set("dex", 500);
  set("cor", 30);
  set_skill("dodge", 3000);
  set_skill("unarmed", 3000);
  set("limbs", ({ "头部", "身体", "腹部", "尾巴" }));

  set("verbs", ({ "bite" }));

  set("combat_exp", 500000);

  set_temp("apply/attack", 300);
  set_temp("apply/damage", 300);
  setup();
}

void die() {
  object obj;
  object killer;
  int exp, userexp;
  if (objectp(killer = this_object()->query_temp("last_damage_from"))) {
    userexp = killer->query("zjb_dj/dj");
    exp = ((int)killer->query_skill("force", 1) * 10) + random(10000) + 40000 + (userexp * 150);
    obj = new("/quest/tulong/obj/neidan");
    obj->set("zhuren", killer->query("id"));
    obj->move(environment(this_object()));

    if (!killer->query_temp("m_success/孽龙") && killer->query("m_success/wait") < time()) {
      killer->set_temp("m_success/孽龙", 1);
      killer->set("m_success/wait", time() + 3600);
      killer->add("combat_exp", exp);
      killer->add("potential", 15000);
      message(
        "channel:rumor",
        HBMAG "【精灵神界】" + killer->query("name") + "成功地杀死了鱼怪，解开了封印!得到" + chinese_number(exp) + "经验和十五万潜能!\n" NOR,
        users()
      );
    }

  }
  message_vision("$N口中吐出一粒内丹，肚皮往上一翻，$N死了。\n", this_object());

  destruct(this_object());
}
