
#include <armor.h>
inherit FINGER;
void create()
{
         set_name(HIW"百"HIM"年"HIC"好"HIW"合"NOR, ({ "gold ring", "ring" }));
        set("weight", 400);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", HIY"这枚戒指是专门为zhuwu's wife设计的，世间仅有一枚！。\n"NOR); 
                set("unit", "个");
                set("value", 2000);
                set("material", "gold");
                set("armor_prop/armor", 1);
        }
        setup();
}       

