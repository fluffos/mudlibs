inherit NPC;
#include <ansi.h>

int ask_me();
int get_gift();
int a = random(5);
int b = random(5);

void create()
{
        set_name("傻蛋超人", ({"super man", "super", "man"}));
        set("gender", "男性");
        set("nickname", HIR"傻蛋超人"HIW"(ask man about 傻蛋)"NOR);
set("doing",1);
        set("age", 30000);
        set("inquiry", ([
                         "傻蛋" : (: ask_me :),
         ]) );

       setup();
        carry_object("/clone/cloth/cloth")->wear();
}

int do_get_gift(string arg, object me)
{ 
   int exp, c, dj = me->query("zjb_dj/dj");  
 
   if( !arg ) {
   tell_object(me,HIC"    您可以使用 A B C D 来选择你想得到的礼物\n"NOR);
        input_to((:do_get_gift:), me);
   return 1;
    }

    c = arg;
  if( c == a+b) 
{

   tell_object(me,HIC"您拿到了十分之一内力最大值的礼物!\n"NOR);
       return 1;    
}  
   write(HIC"    您可以使用 A B C D 来选择你想得到的礼物\n"NOR);
        input_to((:do_get_gift:), me);
   return 1;
  
}
int ask_me()
{
        object me = this_player();
        

        {
                tell_object(me, HIR "oo"+ a +"加上"+ b +"=多少！。\n" NOR);
         input_to((:do_get_gift:), me);    
              return 1;
        }
}







