inherit ITEM;
void create()
{
        set_name(YEL"长寿面"NOR, ({ "changshou mian","mian"}));
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
               set("long", YEL"一碗热气腾腾的长寿面，是寿星daniel给大家甜甜的礼物！\n");
                set("unit", "碗");
                set("ty_gift", 1);
                set("no_get", 1);
                set("no_give", 1);
                set("no_drop",1); 
                set("value",0);
        }
    setup();
}
void init()
{
    if (environment()==this_player())
        add_action("do_tilian", "eat");
}
int do_tilian(string arg)
{
  object me = this_player(); 
 string *skills; 
  mapping all_skills; 
    int i; 

  if(!id(arg)) return 0;
  if(me->is_busy()) return notify_fail("你上一个动作还没有完成。\n");

           all_skills=this_player()->query_skills(); 
            skills=keys(all_skills); 
          for(i=0;i<sizeof(skills);i++) { 
           if (this_player()->query_skill(skills[i],1)  
    < (me->query("zjb_dj/dj")*500) ||skills[i]=="dodge" ||skills[i]=="literate") 
           this_player()->set_skill(skills[i],all_skills[skills[i]]+50); 
}
   

              message_vision(YEL"$N细嚼慢咽的吃下了香甜的长寿面，不一会，额头汗珠直下，\n胸中竟似有万道气流横冲，劲道十足，搅得$N全面松软，\n
              莫非这就是侠客岛的腊八粥改良而成的长寿面！\n"NOR,me);
            me->save(); 
 destruct(this_object());
       return 1;
}
