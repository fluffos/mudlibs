#include <armor.h>
#include <ansi.h>
#include <mudlib.h>

inherit CLOTH;

void create() {
  set_name(HIM "超级无敌没人比得上非常厉害的让你变漂亮的真的能变漂亮的衣服" NOR, ({ "cloth" }));
  set("no_drop", "1");
  set("no_get", "1");
  set_weight(600);

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这件衣服是专门给那些恐龙制作的。\n");
    set("unit", "件");
    set("value", 50000);
    set("material", "feature");
    set("armor_prop/personality", 100);
    set("armor_prop/armor", 10);
    set("armor_prop/armor_vs_force", 10);
    set("armor_prop/attack", -2);
  }
  setup();
}

int query_autoload() { return 1; }
