#include <ansi.h>
inherit NPC;
string ask_me();

void create() {
  set_name(HIR "节日使者" NOR, ({ "tianya shizhe", "shizhe" }));
  set("nickname", HIY "天涯欢迎您的到来" NOR);
  set("gender", "男性");
  set("age", 18);
  set("long", YEL "这位是〖天涯〗的使者，向他打听“端午节”，会有意想不到的惊喜!\n" NOR);
  set("shen_type", 1);
  set("combat_exp", 999999999);
  set("str", 300);
  set("dex", 300);
  set("con", 300);
  set("int", 30);
  set("per", 30);
  set("doing", 1);
  set("attitude", "friendly");
  set("max_qi", 100000);
  set("neili", 100000);
  set("jingli", 21000000);
  set("score", 100000);
  set("no_suck", 1);

  set("inquiry", ([
    "端午节": (: ask_me :),
  ]));
  setup();
}

void init() {
  object ob;
  ob = this_player();
  ::init();
  if (interactive(ob) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  command("whisper " + ob->query("id") + " " HIW "欢迎光临〖天涯〗" + HIR + "(ask shizhe about 端午节)\n" + NOR + HIW + "，．" NOR);
  call_out("greeting", 2);

}

string ask_me() {
  object obj;
  object me = this_player();
  mapping fam;

  if ((int)me->query("tygift/20050611") || (int)me->query_skill("literate") < 301)
    return "丢7你，再ask我干掉你，哼哼！！";
  else {
    me->set("tygift/20050611", 1);
    me->add("potential", 5000000);
    me->add("food", 10000);
    me->add("water", 10000);
    me->add("combat_exp", 50000000);
    me->add("kar", 1);
    me->add("dex", 1);
    me->add("str", 1);
    me->add("per", 1);
    me->add("con", 1);
    me->add("int", 1);
    obj = new("/u/zjb/weapon/jue");
    obj->move(me);

    return "你得到了5000万经验，500万潜能，各种属性增加1点，还有一块终极矿的\奖励！拿过礼物就别再ask了，不然偶丢7你！" NOR;
  }
}
