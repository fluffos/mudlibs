inherit NPC;
inherit F_SAVE;
inherit F_MASTER;


#include <ansi.h>

string ask_form();

void create() {
  seteuid(getuid());

  set_name("嫦娥", ({ "chang e", "chang", "e" }));
  set("gender", "女性");
  set("nickname", HIG "中秋快乐" NOR);
  set("age", 1000);
  set("long",
    "他是来自月宫的仙女。\n"
    "他是给大家送月饼来了。\n");

  set("inquiry", ([
    "中秋节快乐": (: ask_form :),
  ]));
  setup();

  carry_object("/clone/cloth/cloth")->wear();

}

void init() {
  object ob;
  ob = this_player();
  ::init();
  if (interactive(ob) && !is_fighting()) {
    remove_call_out("ty_zhongqiu");
    call_out("ty_zhongqiu", 1, ob);
  }
  add_action("do_toupiao", "choose");
}

void ty_zhongqiu(object ob) {
  if (!ob || environment(ob) != environment()) return;
  command("whisper " + ob->query("id") + " " HIW "你可以使用" + HIR + "(ask chang about 中秋节快乐)" HIW "来取得月饼!\n" NOR);

}

string ask_form() {
  object me;
  object ob;

  me = this_player();

  if (!me->query_temp("diaocha")) {
    tell_object(me,
      "\n\n    一年一度的中秋节又到了!仙女嫦娥奉王母娘娘的法旨,下凡给\n"
      "大家派发月饼,这可不是普通的月饼,它是用仙桃制成,吃了有说不出的\n"
      "妙处,大家可要珍惜!\n\n"
      "月饼种类繁多,嫦娥提供了几种味道供大家选择,现在请你输入:\n\n"
      "choose <序号>来选择你想要的味道!!\n\n"


      "<1> 莲蓉口味:吃了你所拥有的合成武器增加500点攻击力,读书写字提高\n"
      "100级!!\n\n"

      "<2> 豆沙双黄:吃了你将会增加实战经验100万点,潜能50万点,内力精力各5000点!\n\n"

      "<3> 水果口味:吃了得到福缘一点,获得金钱星空币2500!\n\n"

      "以上所有选择只适合年龄高于15或等于15的玩家!!!\n\n"

      "你可以使用choose 1或者choose 2 或者choose 3来决定\n\n"
    );
    me->set("ty_20030911start", 1);
    return "输入" HIR " choose " NOR + CYN "指令来选择。";
  }
}

int do_toupiao(string arg) {

  object me = this_player();
  object ob, ob2, ob3;

  if (!arg)
    return notify_fail("您只能按 choose 1或者choose 2 或者choose 3 !\n");

  if (me->query("mud_age") < 86400)
    return notify_fail("对不起，您的年龄未达到15!\n");

  if (!me->query("ty_20030911start"))
    return notify_fail("请您先ask tian about 问题，来了解 情况!\n");

  if (me->query("ty_20030911"))
    return notify_fail("您已经拿过了!\n");

  if (arg == "1") {

    ob = new(__DIR__ "obj/yuebing1");
    ob->move(me);
    me->set("ty_20030911", 1);


    tell_object(me, HIC "您成功的得到了莲蓉口味的月饼!\n" NOR);
    return 1;
  }
  if (arg == "2") {
    ob = new(__DIR__ "obj/yuebing2");
    ob->move(me);
    me->set("ty_20030911", 1);

    tell_object(me, HIC "您成功的得到了豆沙双黄的月饼!\n" NOR);
    return 1;
  }

  if (arg == "3") {
    ob = new(__DIR__ "obj/yuebing3");
    ob->move(me);
    me->set("ty_20030911", 1);

    tell_object(me, HIC "您成功的得到了水果口味的月饼!\n" NOR);
    return 1;
  }

}
