#include <ansi.h>
inherit NPC;
string ask_me();

void create() {
  set_name(HIR "天涯礼物使者" NOR, ({ "tianya shizhe", "shizhe" }));
  set("nickname", HIY "天涯欢迎您的到来" NOR);
  set("gender", "男性");
  set("age", 18);
  set("long", YEL "这位是〖天涯〗的使者，向他打听“新年快乐”，你会有意想不到的惊喜……。\n" NOR);
  set("shen_type", 1);
  set("combat_exp", 999999999);
  set("str", 300);
  set("dex", 300);
  set("con", 300);
  set("int", 30);
  set("per", 30);
  set("doing", 1);
  set("attitude", "friendly");
  set("max_qi", 100000);
  set("neili", 100000);
  set("jingli", 21000000);
  set("score", 100000);
  set("no_suck", 1);

  set("inquiry", ([
    "新年快乐": (: ask_me :),
  ]));
  setup();
}

void init() {
  object ob;
  ob = this_player();
  ::init();
  if (interactive(ob) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  command("whisper " + ob->query("id") + " " HIW "欢迎光临〖天涯〗" + HIR + "(ask shizhe about 新年快乐)\n" + NOR + HIW + "，．" NOR);
  call_out("greeting", 2);

}

string ask_me() {
  object me = this_player();
  object obj1;
  mapping fam;

  if ((int)me->query("tygift/20050101") || me->query("age") < 16)
    return "呵呵～这就是您的不是了！小的已经对您施过法力了！";
  else {
    me->set("tygift/20050101", 1);
    me->add("potential", 1000000);
    me->add("food", 10000);
    me->add("water", 10000);
    me->add("combat_exp", 50000000);
    me->add("str", 1);
    me->add("con", 1);
    me->add("int", 1);
    me->add("kar", 1);
    me->add("zjb_money", 500);
    obj1 = new("/u/zjb/weapon/jue");
    obj1->move(me);
    tell_object(me, HIR "天涯恭祝：新年快乐！。\n" NOR);
    tell_object(me, HIY "你觉得似乎自己臂力更强了一些。\n" NOR);
    tell_object(me, HIB "你觉得似乎自己根骨更强了一些。\n" NOR);
    tell_object(me, HIM "你觉得似乎自己悟性更强了一些。\n" NOR);
    tell_object(me, HIC "你觉得似乎自己福缘更强了一些。\n" NOR);
    tell_object(me, HIG "你觉得似乎自己经验增加了50000000。\n" NOR);
    tell_object(me, HIM "你觉得似乎自己潜能增加了1000000。\n" NOR);
    tell_object(me, HIW "恭喜你，你得到天涯罕见的终极金属一块。\n" NOR);


    return "天涯巫师组" NOR + HIR "〖恭祝您〗" NOR ":新年快乐！\n" NOR; ;
  }
}
