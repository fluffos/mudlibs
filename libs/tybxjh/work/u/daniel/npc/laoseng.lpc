inherit NPC;

string suanming(object me);
string suan_fuyuan(object me);
string suan_rsg(object me);

void create() {
  set_name("白眉老僧", ({ "baimei laoseng", "laoseng", "seng" }));
  set("title", "游方僧人");
  set("gender", "男性");
  set("age", 55);
  set("class", "bonze");
  set("long",
    "他是一位须发花白的老僧，身穿一袭金边黑布袈裟。他身材瘦高，\n"
    "太阳穴高高鼓起，似乎身怀绝世武功。\n"
  );
  set("no_get", 1);
  set("combat_exp", 3800000);
  set("attitude", "peaceful");
  set("no_suck", 1);

  set_skill("unarmed", 400);
  set_skill("dodge", 200);
  set_skill("parry", 600);
  set_skill("literate", 400);
  set_skill("force", 200);
  set_skill("hunyuan-yiqi", 200);
  set_skill("shaolin-shenfa", 125);
  set_skill("sword", 400);

  set_skill("damo-jian", 600);
  set_skill("buddhism", 505);
  set_skill("longzhua-gong", 400);

  map_skill("force", "hunyuan-yiqi");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("sword", "damo-jian");
  map_skill("parry", "damo-jian");
  map_skill("unarmed", "longzhua-gong");

  set("per", 26);
  set("max_neili", 35000);
  set("neili", 35000);
  set("str", 25);
  set("int", 25);
  set("con", 25);
  set("dex", 15);
  set("max_qi", 1000);
  set("max_jing", 1000);
  set("jiali", 200);
  set("score", 5000);
  set("chat_msg_combat", ({
    (: perform_action, "sword.sanjue" :),
    (: exert_function, "recover" :),
  }));
  setup();
  carry_object("/d/shaolin/obj/changjian")->wield();
  carry_object("/d/shaolin/obj/cheng-cloth")->wear();
}

void init() {
  object ob;

  ::init();
  set("chat_chance", 10);
  set("inquiry", ([
    "name": "贫僧法名道剑．．．嘿嘿，游方至此。\n",
    "here": "你没来过川界？这地方可是天下灵气所聚之所。\n",
    "福缘": (: suan_fuyuan :),
    "fuyuan": (: suan_fuyuan :),
    "道剑": "唉，别提了，我现在都“巫”了。没当年的豪气了。\n",
  ]));

  // 等ＭＵＤ发展的后期时开放这下面的代码。
  // taoism for JHFYII.SD 2001-9-21
  //        set("chat_msg", ({
  //                (: random_move :)
  //        }) );
}


string suan_fuyuan(object me) {
  int my_level;

  string *levels = ({
    "霉气冲天，恕在下直言，血光之灾不远矣！\n",
    "印堂发暗，这个这个．．．\n",
    "运道尚可。\n",
    "今生福缘不浅呀！。\n",
    "定是多福多寿之人。\n",
    "今生必有奇缘，恭喜，恭喜！\n",
    "真是福如东海，寿比南山呀！\n",
  });

  me = this_player();
  my_level = me->query("kar");
  if (my_level > 28) my_level = 6;
  else if (my_level > 25) my_level = 5;
  else if (my_level > 22) my_level = 4;
  else if (my_level > 19) my_level = 3;
  else if (my_level > 16) my_level = 2;
  else if (my_level > 13) my_level = 1;
  else my_level = 0;
  if (!me->query_temp("suanming/paid")) {
    if (me->query_temp("suanming/asked")) {
      message_vision("白眉老僧闭上眼睛，不理$N了。\n", me);
      return "老僧这条命也得吃饭啊，不知"
        +RANK_D->query_respect(me) + "能否随意给个几十两黄金让我吃点东西。\n";
    } else {
      me->set_temp("suanming/asked", 1);
      message_vision("白眉老僧拖长声音干咳了几声。\n", me);
      return "这个．．．天机不可泄露啊。\n";
    }
  } else {
    me->delete_temp("suanming");
    message_vision("白眉老僧对$N道：你算是找对人了！说罢瞑目细思量起来。\n", me);
    if (my_level < 0)
      return "奇怪！" + RANK_D->query_respect(me) + "运数十分怪异，在下修为不够，算不出来．．．\n";
    else
      return RANK_D->query_respect(me) + levels[my_level];
  }
}

int accept_object(object me, object ob) {

  if (ob->value() >= 200000) {
    message_vision("白眉老僧满面堆欢地对$N道：多谢" + RANK_D->query_respect(me) + "，在下正需要这个，有什么问题您尽管问！\n", me);
    me->set_temp("suanming/paid", 1);
    return 1;
  } else {
    command("kao " + me->query("id"));
    command("say 不敢当．．．您也太客气了。拿回去给您老婆孩子用吧，您也困难。");
    return 0;
  }
}
