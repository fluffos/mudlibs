#include <ansi.h>
#include <net/dns.h>
inherit ITEM;
#define IDLE 600
void init()
{
       add_action("do_gift","gift");
}
void create()
{
         set_name( HIC"zhuwu的魔法棒", ({ "falling" }) );
        set_weight(1000);
                set("unit", "个");
        
        setup();
}
int do_gift(string arg)
{
    int count;
    object me,ob; 
    string target,gift_file;
    me = this_player();
    if(!arg)  return notify_fail("gift 派礼物给在线玩家，命令格式： gift </路径/../目标文件名> <数量>\n\n");
    if (sscanf(arg, "%s %d", target, count) != 2 ) target = arg;  
    gift_file = target + ".lpc";
    if (file_size(gift_file) == -1) return notify_fail("找不到文件"+gift_file+"。\n");
    foreach (object player in users()) {
     if (!environment(player) || base_name(environment(player)) == "/d/jianyu" ) continue;
         ob=new(target);
         if (count > 1 && ob->query("base_unit")) ob->set_amount(count);
          ob->move(player);
         tell_object(player,HIW + "\n在一阵悦耳的结婚进行曲的music中，" + me->query("name") + "伴着他的另一半缓缓步入教堂！\n\n" + NOR + "圣诞老公公也为这对金童玉女的结合撒下了超支的礼物——" + ob->name() + NOR + "！\n\n");
    }
    return 1;
}

