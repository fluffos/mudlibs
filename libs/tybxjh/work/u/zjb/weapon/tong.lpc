// By zjb@ty

inherit ITEM; 
int zjb = random(5);
mapping *weapon= ({
([     "name":     "青铜",
       "id":  "qing tong",
       "yanse":       HIC,
       "int":           2,
]),
([     "name":     "黄铜",
       "id": "huang tong",
       "yanse":       HIY,
       "str":           2,
]),
([     "name":     "白铜",
       "id":   "bai tong",
       "yanse":       HIW,
       "dex":           2,
]),
([     "name":     "绿铜",
       "id":    "lv tong",
       "yanse":       HIG,
       "con":           2,
]),
([     "name":     "紫铜",
       "id":    "zi tong",
       "yanse":       MAG,
       "damage":       50,
]),
});
void create()
{
    string name,id;

    name = weapon[zjb]["name"];

    set_name(weapon[zjb]["yanse"]+name+NOR,({weapon[zjb]["id"]}) );  
    set_weight(100);
    if( clonep() )
    set_default_object(__FILE__);
    else {
         set("unit", "个");                        
        }

   set("ty_weapon",1);
   set("no_get",1);
   set("no_put",1);
   set("value",5000000);
   if (weapon[zjb]["str"])
   set("str",weapon[zjb]["str"]);
   if (weapon[zjb]["con"])
   set("con",weapon[zjb]["con"]);
   if (weapon[zjb]["dex"])
   set("dex",weapon[zjb]["dex"]);
   if (weapon[zjb]["int"])
   set("int",weapon[zjb]["int"]);
   if (weapon[zjb]["damage"])
   set("damage",weapon[zjb]["damage"]);
   set("long", "这是一个铜级的金属，可以用来合成兵器!(help hecheng)\n");
   
   setup();
  }

