// By zjb@ty  投票系统，给玩家一个选择的机会
inherit NPC;
inherit F_SAVE;
inherit F_MASTER;


#include <ansi.h>

string ask_form();
int piao_form();

string query_save_file() {
  return DATA_DIR + "toupiao";
}

void create() {
  seteuid(getuid());
  if (!restore()) {
    set_name("天涯", ({ "tian ya", "tian", "ya" }));
    set("gender", "男性");
    set("nickname", HIG "星空的使者" NOR);
    set("age", 1000);
    set("long",
      "他是来自神界的使者。\n"
      "他是星空给MUD玩家投票用的NPC。\n");

    set("inquiry", ([
      "问题": (: ask_form :),
      "票数": (: piao_form :),
    ]));
    setup();
  } else {
    set_name("天涯", ({ "tian ya", "tian", "ya" }));
    set("gender", "男性");
    set("nickname", HIG "星空的使者" NOR);
    set("age", 1000);
    set("long",
      "他是来自神界的使者。\n"
      "他是星空给MUD玩家投票用的NPC。\n");

    set("inquiry", ([
      "问题": (: ask_form :),
      "票数": (: piao_form :),
    ]));

    setup();
    carry_object("/clone/cloth/cloth")->wear();
  }
}

void init() {
  object ob;
  ob = this_player();
  ::init();
  if (interactive(ob) && !is_fighting()) {
    remove_call_out("zjb_tz2");
    call_out("zjb_tz2", 1, ob);
  }
  add_action("do_toupiao", "toupiao");
}

void zjb_tz2(object ob) {
  if (!ob || environment(ob) != environment()) return;
  command("whisper " + ob->query("id") + " " HIW "你可以使用" + HIR + "(ask tian about问题)" HIW "来参加投票，可以拿到一点先天福缘的哟!\n" NOR);
  command("whisper " + ob->query("id") + " " HIW "你可以" + HIR + "(ask tian about 票数)" HIW "来查看现在的投票趋向!\n" NOR);

}

string ask_form() {
  object me;
  object ob;

  me = this_player();

  if (!me->query_temp("diaocha")) {
    tell_object(me,
      "\n\n    前几天，星空发现了一个导致天涯cpu狂高，也是导致江湖风云\n"
      "版本为什么cpu狂高，系统负担重的原因，其实就是因为for()这个函\n"
      "数调用，比如说pixie-jian,一个自动连30招，那么本来出一招的时\n"
      "间，可以出30招，而这30招是怎么出的呢？是连续30次调用了战斗系\n"
      "统的中心文件combatd.c而出来的，也就是说本来出1招，只要计算1\n"
      "次就可以了，jhfy的skill就要计算30次，而且是反复的计算，如果\n"
      "同时1秒内，有100个玩家在使用pixie-jian类别或者taiji-jian类别\n"
      "的skill来做任务或者打木人的话，那么就是同时计算战斗系统3000\n"
      "次，而战斗系统的计算本来就是很复杂的，本来就已经占cpu够多了，\n"
      "如果再这么算的话，那么也就是说jhfy版本的系统负担比西游记和侠\n"
      "客行那几种版本多上30倍，那么江湖风云版本100个人上线比的上侠\n"
      "客行上线1000个的cpu,所以江湖风云版本的站大多都是1天当一次机\n"
      "而侠客行版本呢，有时候可以1个月不当，如果修改了这个问题以后\n"
      "估计天涯的速度可以提高一倍，而且可以3-5天当一次机是没问题的！\n\n"

      "    如果你已经明白里上面写的东西了的话，你现在可以投票了，星\n"
      "空经过仔细反复的想，如果天涯想要发展成为一个大型MUD,必须要摆\n"
      "脱这个skill的问题，而如果随便改的话，玩家反应肯定强，所以我想\n"
      "和玩家们商量一下，把这种自动连的pfm或者taiji-jian的那种pfm,改\n"
      "降龙十八掌的pfm jingtian那种类型的，或者一个pfm只出5招左右，但\n"
      "是攻击力可以提高十几倍  成现在，当然如果改成那样的话，所以任务\n"
      "npc的整体实力都要下降一倍多，而且fight奖励也会增加，为了天涯更\n"
      "好的发展，大家请慎重的投这一票!\n\n"

      "<A> 改成降龙十八掌的pfm jingtian那种类型的，或者一个pfm只出5招左\n"
      "右，但是攻击力可以提高十几倍的那种类型，这样可以防止底经验杀高经验!\n\n"

      "<B> 无所谓，随便改，反正我继续玩!\n\n"

      "<C> 不同意，要求保留原样!\n\n"

      "<D> 可以稍做修改，但是不要改的太厉害!\n\n"

      "你可以使用toupiao A 或者toupiao B 或者toupiao C 或者toupiao D来决定\n"
    );
    me->set("zjb_toupiao", 1);
    return "输入" HIR " toupiao " NOR + CYN "指令来投票。";
  }
}

int do_toupiao(string arg) {

  object me = this_player();

  if (!arg)
    return notify_fail("您只能按 toupiao A 或者 toupiao B 或者 toupiao C 或者 toupiao D !\n");

  if (me->query("combat_exp") < 3000000 && me->query("zjb_dj/dj") < 2)
    return notify_fail("对不起，您的经验值太少!\n");

  if (!me->query("zjb_toupiao"))
    return notify_fail("请您先ask tian about 问题，来了解 情况!\n");

  if (me->query("zjb_toupiao2"))
    return notify_fail("您已经投过票了!\n");

  if (arg == "A") {
    this_object()->add("A", 1);
    this_object()->save();
    me->set("zjb_toupiao2", 1);
    me->add("kar", 1);

    tell_object(me, HIC "您成功的投了A一票，得到了1点富源的奖励!\n" NOR);
    return 1;
  }
  if (arg == "B") {
    this_object()->add("B", 1);
    this_object()->save();
    me->set("zjb_toupiao2", 1);
    me->add("kar", 1);

    tell_object(me, HIC "您成功的投了B一票，得到了1点富源的奖励!\n" NOR);
    return 1;
  }

  if (arg == "C") {
    this_object()->add("C", 1);
    this_object()->save(); me->set("zjb_toupiao2", 1);
    me->add("kar", 1);

    tell_object(me, HIC "您成功的投了C一票，得到了1点富源的奖励!\n" NOR);
    return 1;
  }

  if (arg == "D") {
    this_object()->add("D", 1);
    this_object()->save();
    me->set("zjb_toupiao2", 1);
    me->add("kar", 1);

    tell_object(me, HIC "您成功的投了D一票，得到了1点富源的奖励!\n" NOR);
    return 1;
  }

}

int piao_form() {
  object ob;
  object me = this_player();

  ob = this_object();

  tell_object(me, HIC "当前票数情况如下\n" NOR
    HIR "投A票的有" + ob->query("A") + "人!\n" NOR
    HIW "投B票的有" + ob->query("B") + "人!\n" NOR
    HIG "投C票的有" + ob->query("C") + "人!\n" NOR
    HIM "投D票的有" + ob->query("D") + "人!\n" NOR);

  return 1;
}
