//yuxiao-jianfa  by: pipip  
#include <ansi.h>

inherit SKILL;

string *action_msg = ({  
        "$N怀抱$w，跨前一步身形微沉左膝略曲，剑势如匹的攻向$n，正是一招「"+RED+"百鸟朝凰"+NOR+"」。",
        "$N横过$w一式「"+CYN+"垄玉吹萧"+NOR+"」横切$n的颈部，攻势奇幻之极。",
        "$N脚下踏着八卦方位，$w以一式「"+YEL+"清羽之音"+NOR+"」中宫直进，势如破竹攻向$n胸口。",
        "$N手中$w去势弱有若无般挑向$n右肩，却是一招「"+BLK+"一音奚奚"+NOR+"」。",
        "$N手中$w一抖正是一式「"+GRN+"昆岗凤鸣"+NOR+"」，只见那剑势忽高忽低，愈变愈奇刺向$n。",
        "只见$N身形一晃$w使出「"+BLU+"萧史乘龙"+NOR+"」如形随影的攻向$n后背。",
        "$N使出「"+MAG+"巴山夜雨"+NOR+"」迅速的抖动手中$w幻化出无数个光点，剑势如同暴风骤雨般的攻向$n。",        });

int valid_learn(object me)
{
        object ob;
                
        if (! objectp(ob = me->query_temp("weapon"))
        ||  (string)ob->query("skill_type") != "sword")
                return notify_fail("你必须先找一把剑才能练玉萧剑法。\n");

        return 1;
}

int valid_enable(string usage)
{
        return usage == "sword" || usage == "parry";
}

mapping query_action(object me, object weapon)
{ 
        int i, level;
        level   = (int) me->query_skill("yuxiao-jianfa", 1);
        
        if (random(me->query_skill("sword")) > 199 
        &&  me->query_skill("force") > 299   
        &&  me->query_skill("bibo-shengong",1) > 199
        &&  me->query_skill("yuxiao-jianfa",1) > 199
        &&  me->query("neili") > 500 
        &&  objectp(weapon = me->query_temp("weapon")) 
        &&  (string)weapon->query("id") == "yu xiao") 
        {
                me->add("neili", -20);
                return ([
                        "action": HIC"$N一声长叹使出「"+RED+"曲终人散"+NOR+HIC+"」，长袖一挥只见$w"HIC"从重重袖影中飞出，点向$n"HIC"的咽喉要害，随及身形飘然离去。"NOR,
                        "damage": 200,
                        "dodge" : 200,
                        "parry" : 200,
                        "attack": 200,
                        "damage_type": "刺伤"
                ]);
        }
        return ([
                "action": action_msg[random(sizeof(action_msg))],
                "damage": 120 + random(20),
                "attack": 70 - random(20),
                "dodge" : 70 - random(20),
                "parry" : 70 - random(20),
                "damage_type" : random(5)?"刺伤":"割伤",
        ]);
}

int practice_skill(object me)
{
        if ((int)me->query("qi") < 50
        ||  (int)me->query("neili") < 10)
                return notify_fail("你的气力不够了，手软得无法练习玉萧剑法。\n");
                
        me->receive_damage("qi", 30);
        me->add("neili", -5);
        
        return 1;
}

int query_effect_parry(object attacker, object me) 
{
        int lvl;
        if (! objectp(me->query_temp("weapon")))
                return 0;

        lvl = me->query_skill("yuxiao-jianfa", 1);
        if (lvl < 10) return 0;
        if (lvl < 20) return 50;
        if (lvl < 40) return 80;
        if (lvl < 80) return 100;
        return 120;
}
 

mixed hit_ob(object me, object victim, int damage)
{
        mixed result;
        if (damage < 50) return 0;
        if (damage > random(victim->query_str())) 
        { 
                result = ([ "damage" : damage ]);
                result += ([ "msg" : HIR"剑气纵横，"HIB"$N"HIR"手中剑器"HIR"发出阵阵龙吟，"HIB"$n"HIR"只觉心口一疼，顿时喷出一口鲜血!!!\n" NOR ]);
        return result;
        }
}

