void init() {
  add_action("do_study", "study");
  //   add_action("do_pick", "pick"); 
}
int do_study() {
  message_vision(HIR "$N，未经过主人的同意，请不要乱动这里的东西。\n" NOR, this_player());
  return 1;
}

int do_pick(string arg) {
  object sword, me = this_player();

  if (!arg || arg == "") return 0;
  if (me->query("id") != "pipip") return 0;

  if (arg == "西门无剑") {
    if (query_temp("nasword")) {
      message_vision("$N想去拿星空币,发现已经被人拿了\n", this_player());
      return 1;
    }
    message_vision(
      HIY "$N在箱子里拿出星空币!\n" NOR, this_player());
    set_temp("nasword", 100);
    me->set_temp("pipip_money", 1);
    message(
      "channel:chat",
      HBRED HIG "〖江湖通缉令〗" + me->query("name") + "在〖小P之家〗盗取了大量的星空币，各路好汉请协作擒拿此贼！\n" NOR,
      users()
    );
    return 1;
  }
  return 1;
}

int valid_leave(object me, string dir) {
  if (dir != "tree" && !wizardp(me) && this_player()->query("id") != "pipip")
    return notify_fail("没经过小P的同意不许到处乱跑！！\n");
  return ::valid_leave(me, dir);
}
