#include <weapon.h>
#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
         set("short","木桥");
         set ("long",@long
这是通往湖中小亭的木桥，从这望去湖面碧波荡漾，景色宜人。木桥的
扶手上雕刻着一尊尊小木头狮子，让人爱不释手。木桥往西面走能够看
到一座湖中小亭。
long);
         set("outdoors","mr");
         set("exits",([
             "east" : __DIR__"houyuan1",
             "west" : __DIR__"bishuiting",
]));
         setup(); 
}
void init()
{
        add_action("do_lingwu", "lingwu");
}

int do_lingwu()
{
   object ob;
   int c_exp,c_skill;
   ob = this_player();

   c_skill=(int)ob->query_skill("literate", 1);  
   if((string)this_player()->query("family/family_name")!="姑苏慕容")
   {
      message_vision("$N不是慕容世家的人，不要在这里烦碍人家练功。\n",ob);
      return 1; 
   }
   if (c_skill <1500)
   {
      message_vision("$N的领悟力不够强，在这里领悟只会浪费时间。\n",ob);
      return 1; 
   }

   if (ob->query("jing")<6000)
   {
      message_vision("$N太累了，再也领悟不出任何东西了。\n",ob);
      return 1; 
   }  
   if (this_player()->is_busy()) 
   {
      message_vision("$N正忙着呢，领悟个屁。\n",ob);
      return 1; 
   }     if ((int) ob->query("guiyi")) 
   {
      message_vision("$N不是已经领悟到神元归一了吗？难道又忘了？\n",ob);
      return 1; 
   } 
   if ((int) ob->query("lingwu") > 100) 
    {
      ob->set("guiyi", 1);  
      ob->delete_temp("lingwu");
      message_vision(HIY"$N眼中突然闪过灵光，心中一阵感动，竟然领悟到了元神功之精华。\n",ob);
      return 1; 
   } 
   message_vision(HIY"$N凝视着碧绿的湖面，心中一遍又一遍的回忆着神元功的口诀。\n"NOR,ob);
   ob->improve_skill("shenyuan-gong", (int)ob->query_skill("shenyuan-gong", 1));
   ob->add("jing",-5000); 
   ob->add("lingwu",1);   ob->start_busy(5);
   return 1;
}
