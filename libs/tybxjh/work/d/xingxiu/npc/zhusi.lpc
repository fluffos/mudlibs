//Cracked by Roath
//  poison: shachongke.c
// Jay 3/17/96

// more work needed to use this object to make poison

#include <ansi.h>
inherit ITEM;

void init() {
  add_action("do_eat", "eat");
  add_action("do_make", "make");
}

void create() {
  set_name("毒蛛丝", ({ "Du zhusi", "zhusi", "silk" }));
  set("unit", "团");
  set("long", "这是一团一只毒蜘蛛死後吐出的丝，是制备毒药的原料。\n");
  set("value", 200);
  set("medicine", 1);
  //        setup();
}

int do_eat(string arg) {
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  return notify_fail("你找死啊。\n");
}
//bright add
int do_make(string arg) {
  object ob, me = this_player();
  mapping myfam;

  if (!arg || arg != "bilin zhen")
    return notify_fail("你要做甚么？\n");

  if ((!(myfam = me->query("family")) || myfam["family_name"] != "星宿派"))
    return notify_fail("只有星宿弟子利用本门秘传方法才能做成碧磷针。\n");

  if (me->query_skill("poison", 1) < 150)
    return notify_fail("你的基本毒技不够,无法做成！\n");

  ob = new("/d/xingxiu/obj/blzhen");
  ob->move(me);
  write(HIW "你暗运内劲将毒蛛丝夹在两掌之间,随即分开! \n" NOR);
  write(RED "你做成了几根碧磷针! \n" NOR);
  destruct(this_object());
  return 1;
}
