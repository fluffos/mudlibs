#include <ansi.h>
inherit NPC;
string ask_me();

void create() {
  set_name(HIR "圣诞老狼" NOR, ({ "xmas wolf", "wolf" }));
  set("nickname", HIY "西门无剑的宠物" NOR);
  set("gender", "雄性");
  set("age", 13);
  set("long", YEL "西门无剑家里养的狼，具有神奇的魔力，今年西门无剑派它来给大家发礼物。\n" NOR);
  set("shen_type", 1);
  set("combat_exp", 999999999);
  set("str", 300);
  set("dex", 300);
  set("con", 300);
  set("int", 30);
  set("per", 30);
  set("attitude", "friendly");
  set("max_qi", 100000);
  set("neili", 100000);
  set("jingli", 21000000);
  set("score", 100000);
  set("no_suck", 1);
  set("inquiry", ([
    "圣诞快乐": (: ask_me :),
  ]));
  setup();
}



string ask_me() {
  object ob;
  mapping fam;

  if ((int)this_player()->query("xmas1"))
    return "你已经拿过礼物了，滚开！";
  else {
    this_player()->set("xmas1", 1);
    this_player()->add("int", random(3));
    this_player()->add("str", random(3));
    this_player()->add("dex", random(3));
    this_player()->add("con", random(3));
    //               return "这是主人给你的礼物，拿好啦，掉了别再回头找我！"NOR;
    return "西门无剑祝你圣诞快乐！！" NOR;
  }
}
