inherit ROOM;
#include <ansi.h>;

void create() {
  set("short", HBGRN + WHT "商业街北区" NOR);
  set("long",
    "绕过小湖，眼前一亮，青砖路面笔直通向前方，两旁雕
梁画栋的商业铺面让你眼前一亮，这里行人熙来攘往，甚是
繁华，串串灯笼高挂，隐隐还能听到算盘噼噼啦啦的拨打声
和伙计的迎客送客的唱诺，真是好不热闹。

                   [1;33m十[2;37;0m          [1;33m两[2;37;0m                               
                   [1;33m省[2;37;0m          [1;33m江[2;37;0m
                   [1;33m通[2;37;0m          [1;33m名[2;37;0m
                   [1;33m衢[2;37;0m          [1;33m地[2;37;0m
                   [1;33m人[2;37;0m          [1;33m俗[2;37;0m
                   [1;33m辏[2;37;0m          [1;33m繁[2;37;0m
                   [1;33m集[2;37;0m          [1;33m华[2;37;0m

"
  );
  set("outdoors", "player");
  set("no_fight", 1);
  set("exits", ([
    "south": "/d/wizard/fightroom5",
    "north": __DIR__ "bei1",
  ]));
  set("objects", ([
  ]));
  setup();
  replace_program(ROOM);
}

void init() {
  object me = this_player();
  tell_object(me, WHT "\n欢迎光临扬州商业街，想知道如何操作"
    "请(" HIY "help trade & help cmdtrade" NOR + WHT ")，祝你"
    "购物愉快。\n\n" NOR);

}
