// write Zjb@TY

inherit ROOM;
void create() {
  set("short", HIY "第一楼楼顶");
  set("long", @LONG
这里就是天涯第一楼之顶，在这里可以很好的观看天涯第一
楼的景色，往外看，有个很大的汉白玉窗台，上面足可站一个人
，很多帮内兄弟正纷纷往外跳(tiao lou)，据说这样可以增加自
己的轻功修为。
LONG
  );
  set("exits", ([
    "down": "/d/tybang/tylou6",
  ]));

  setup();
}
int init() {
  add_action("do_nocmds", "home");
  add_action("do_nocmds", "conjure");
  add_action("do_nocmds", "qigong");
  add_action("do_out", "tiao");
}
int do_nocmds(string arg) {
  write("对不起，天涯第一城禁止使用该指令！\n");
  return 1;
}

int do_out(string arg) {
  object me;
  int i, j;
  me = this_player();

  if (!arg || arg != "lou") {
    tell_room(environment(me), me->name() + "想不开想跳楼，可是双腿却不听使唤，瑟瑟发抖!\n", ({ me }));
    write("你高兴得跳得老高，不知道出了什么毛病\n");
    return 1;
  }

  if ((int)me->query_temp("tylou") >= 2000) {
    if (random((int)me->query("kar")) > 20) {
      me->set_skill("dodge", (int)me->query_skill("dodge", 1) + 1);
      write(HIR "你的轻功增加了!\n");
      CHANNEL_D->do_channel(this_object(), "rumor",
        sprintf(HIR "由于%s在天涯第一楼坚持不懈的跳楼,轻功技能取得了长足的进展。\n" NOR, me->name(1)));
    }
    me->delete_temp("tylou");
    return 1;
  }

  if ((int)me->query_skill("dodge", 1) < 100) {
    me->move("/d/tybang/tylou1");
    me->unconcious();
  } else if ((int)me->query("neili") < 2000) {
    message_vision("$N爬上窗户，一个纵身，跳了出去。\n", me);
    me->move("/d/tybang/tylou1");
    message_vision("只听『砰』地一声$N摔了个半死。\n", me);
    me->unconcious();
  } else {
    message_vision("$N爬上窗户，一个纵身，跳了出去。\n", me);
    me->move("/d/tybang/tylou1");

    message_vision("只听『砰』地一声$N从楼上跳了下来。\n", me);
    tell_object(me, "你感觉到自己的轻功又有进境了！\n");
    if (me->query_skill("dodge", 1) < 1500)
      me->improve_skill("dodge", (int)me->query_skill("dodge", 1) * 30);
    else if (me->query_skill("dodge", 1) < 3000)
      me->improve_skill("dodge", (int)me->query_skill("dodge", 1) * 20);
    else
      me->improve_skill("dodge", (int)me->query_skill("dodge", 1) * 10);

    me->start_busy(1);
    me->add_temp("tylou", 1);
    me->receive_damage("jing", 100);
    me->receive_damage("qi", 100);
    me->set_temp("die_for", "从天涯第一楼上跳下来摔");
    me->delete_temp("last_damage_from");
  }
  return 1;
}
