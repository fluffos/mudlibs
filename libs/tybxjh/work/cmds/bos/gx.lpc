#include <combat.h>

int main(object me, string arg) {
  object obj, zjb;

  if (!arg) return notify_fail("你要更新哪个物件??\n");

  if (sscanf(arg, "%s", zjb)) {

    if (!objectp(obj = present(zjb, me)))
      return notify_fail("你身上没有这样东西。\n");

    if (!obj->query("zhuren"))
      return notify_fail("该物件不可被更新!\n");

    obj->set("zhuren", "" + me->query("id") + "");
    write(HIC "你把" + obj->name() + HIC "更新完毕，可以吃了!\n");
  } else
    return notify_fail("你要更新哪个物件??\n");

  return 1;
}
