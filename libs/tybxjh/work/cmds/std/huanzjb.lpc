#include <combat.h>
int help(object me);

int main(object me, string arg) {
  int money, zjb;
  if (!arg) return notify_fail("你要换多少星空币!\n");
  else if (!sscanf(arg, "%d", money)) return help(me);
  if (money < 1) return notify_fail("你没有这么多星空币来换!\n");
  if (money > 4) return notify_fail("最多只能换4枚星空币!\n");
  if (me->query("zjb_money", 1) < 1)
    return notify_fail("你没有这么多星空币来换!\n");
  if (money > me->query("zjb_money", 1))
    return notify_fail("你没有这么多星空币来换!\n");

  if ((100000 * money) + me->query("money", 1) / 1000 > 2100000)
    return notify_fail("你不能换那么多，再换就暴了！\n");
  me->add("zjb_money", -money);
  me->add("money", money * 100000000);
  write("你把" + money + "枚星空币换成了黄金，存到钱庄中!\n");

  return 1;
}

int help(object me) {
  write(@HELP
指令格式 :huanzjb <几枚星空币>

      把星空币转换成存款。

HELP
  );
  return 1;
}
