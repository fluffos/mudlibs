#include <ansi.h>

inherit F_SSERVER;
int exert(object me, object target) {
  int sp, dp;

  if (target == me)
    target = offensive_target(me);

  if (environment(me)->query("no_fight"))
    return notify_fail("这里不能攻击别人! \n");

  if (me->query("shayi-xinfa/2") != 1)
    return notify_fail("你还没有领悟到杀意，无法使用。\n");

  if (!objectp(target) || target->query("id") == "mu ren")
    return notify_fail("你要攻击谁？\n");

  if ((int)me->query_skill("shayi-xinfa", 1) < 100)
    return notify_fail("你的杀意心法不够，不能用杀意攻击对方！\n");

  if ((int)me->query("neili", 1) < 150)
    return notify_fail("你的内力不够，不能使用杀意心法。\n");

  message_vision(HIW "$N脸上杀气越来越浓，空气中无形的压力逼向" + target->name() + "。\n" NOR, me);

  if (living(target))
    if (!target->is_killing(me))
      target->kill_ob(me);

  sp = me->query_skill("force") + me->query_skill("shayi") + me->query_skill("shayi-xinfa", 1) / 2;
  dp = target->query_skill("force");

  if ((random(sp) > random(dp)) || !living(target)) {
    tell_object(target, HIW " 你心口一紧，身体莫名其妙的不能动了！\n" NOR);
    tell_object(me, HIB "你看到" + target->name() + "被你的眼神吓的一动也不敢动了。\n" NOR);

    target->receive_damage("jing", 50 + random((int)me->query_skill("shayi-xinfa", 1)));

    if (target->query("combat_exp") >= me->query("combat_exp"))
      if ((int)me->query("potential") - (int)me->query("learned_points") < 100)
        me->add("potential", 1);

    me->start_busy(2);
    target->start_busy(random(3));
    me->add("neili", -150);

  } else {
    message_vision(HIY "$p面无表情的向$P看了一眼，似乎一点也感觉不到$P的杀意!\n" NOR, me);
    me->start_busy(3);
  }

  return 1;
}
