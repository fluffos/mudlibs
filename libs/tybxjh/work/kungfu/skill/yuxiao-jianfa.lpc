// yuxiao-jianfa
// by pipip 5/13/02
inherit SKILL;
string type() { return "zhongji"; }
int tydamage = this_player()->query("tydamage/sword") ? this_player()->query("tydamage/sword") : this_player()->query_skill("zuixin-sword");

mapping *action = ({
  ([ "action": "$N怀抱$w，跨前一步身形微沉左膝略曲，剑势如匹的攻向$n，正是一招「百鸟朝凰」。",
    "force": 560,
    "dodge": 280,
    "parry": 240,
    "damage": tydamage,
    "lvl": 0,
    "skill_name": "百鸟朝凰",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N横过$w一式「" HIB "垄玉吹萧" NOR "」横切$n的颈部，攻势奇幻之极。",
    "force": 560,
    "dodge": 280,
    "parry": 240,
    "damage": tydamage,
    "lvl": 9,
    "skill_name": "垄玉吹萧",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N脚下踏着八卦方位，$w以一式「" HIC "清羽之音" NOR "」中宫直进，势如破竹攻向$n胸口。",
    "force": 560,
    "dodge": 280,
    "parry": 240,
    "damage": tydamage,
    "lvl": 120,
    "skill_name": "清羽之音",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N手中$w去势弱有若无般挑向$n右肩，却是一招「" + HIC + "一音奚奚" + NOR + "」。",
    "force": 560,
    "dodge": 280,
    "parry": 240,
    "damage": tydamage,
    "lvl": 170,
    "skill_name": "一音奚奚",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N手中$w一抖正是一式「" + HIC + "昆岗凤鸣" + NOR + "」，只见那剑势忽高忽低，愈变愈奇刺向$n。" NOR,
    "force": 560,
    "dodge": 280,
    "parry": 240,
    "damage": tydamage,
    "lvl": 230,
    "skill_name": "昆岗凤鸣",
    "damage_type": "刺伤"
  ]),
  ([ "action": "只见$N身形一晃$w" HIB "使出「" HIG "萧史乘龙" NOR HIB "」如形随影的攻向$n后背。" NOR,
    "force": 560,
    "dodge": 280,
    "parry": 240,
    "damage": tydamage,
    "lvl": 1001,
    "skill_name": "萧史乘龙",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N使出「" HIC "巴山夜雨" NOR RED "」迅速的抖动手中$w" NOR "幻化出无数个光点，剑势如同暴风骤雨般的攻向$n。" NOR,
    "force": 560,
    "dodge": 280,
    "parry": 240,
    "damage": tydamage,
    "lvl": 1100,
    "skill_name": "巴山夜雨",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N一声长叹使出「" HIB "曲终人散" NOR WHT "」，长袖一挥只见$w" NOR "从重重袖影中飞出，点向$n的咽喉要害，随及身形飘然离去。" NOR,
    "force": 560,
    "dodge": 280,
    "parry": 240,
    "damage": tydamage,
    "lvl": 1200,
    "skill_name": "曲终人散",
    "damage_type": "刺伤"
  ]),
});
int valid_enable(string usage) {
  return (usage == "sword") || (usage == "parry");
}
int valid_learn(object me) {
  if (me->query("family/master_id") != "huang yaoshi")
    return notify_fail("玉萧剑法乃是黄药师的成名武功，你只能找他学习。\n");
  if ((int)me->query_skill("yuxiao-jianfa", 1) > 500)
    return notify_fail("黄药师说道: 玉箫剑法，只付有缘。你与此剑法缘尽于此，以后就看你自己的造化了。\n");

  if (((int)me->query("max_neili") < 20000) ||
    ((int)me->query_skill("bibo-shengong", 1) < 700)
  )
    return notify_fail("黄药师说道: 玉箫剑法，只付有缘。你不是性情中人。\n");
  return 1;
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("yuxiao-jianfa", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  if (damage_bonus < 110) return 0;
  if (me->query("neili") < 50000) return 0;
  if (random(10) < 2) return 0;

  //  第六等级的伤气
  if (me->query_skill("yuxiao-jianfa", 1) > 4000
    && me->query("zjb_dj/dj") >= 25) {
    victim->receive_damage("qi", (damage_bonus) * 2, me);
    return WHT "$N剑带箫音，玉箫剑法的精髓在无形中表露无遗，登时$n全身血液顿时沸腾！！！\n" NOR;
  }

  //  第五等级的伤气
  if (me->query_skill("yuxiao-jianfa", 1) > 3000
    && me->query("zjb_dj/dj") >= 15) {
    victim->receive_damage("qi", damage_bonus, me);
    return YEL "$N的玉箫剑法已经达到人剑合一的境界，随手数道剑气分刺$n数处大穴！！！\n" NOR;
  }
  //  第四等级的伤气
  if (me->query_skill("yuxiao-jianfa", 1) > 2000
    && me->query("zjb_dj/dj") >= 10) {
    victim->receive_damage("qi", (damage_bonus - 100), me);
    return MAG "$N灵台光闪，瞬间领悟到玉箫剑法髓，随手一剑妙到毫颠！！！\n" NOR;
  }

  //  第三等级的伤气
  if (me->query_skill("yuxiao-jianfa", 1) > 1000
    && me->query("zjb_dj/dj") >= 4) {
    victim->receive_damage("qi", (damage_bonus - 100) / 3, me);
    return CYN "$N的玉箫剑法已有小成，剑剑皆带出一道如有实形的剑气攻向$n！！！\n" NOR;
  }
  // 第二等级的伤气
  if (me->query_skill("yuxiao-jianfa", 1) > 400
    && me->query("zjb_dj/dj") >= 2) {
    victim->receive_damage("qi", (damage_bonus - 100) / 8, me);
    return RED "只见白光一闪，一道剑气隐由$N发出，旋即射入$n的体内！！！\n" NOR;
  }


  return 1;
}

int practice_skill(object me) {
  object weapon;
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if (me->query("family/master_id") != "huang yaoshi")
    return notify_fail("玉萧剑法只能由黄药师门下才能练习的武功。\n");

  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力不够练玉箫剑法。\n");
  me->receive_damage("qi", 30);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "yuxiao-jianfa/" + action;
}
