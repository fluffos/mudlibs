int valid_enable(string usage) { return usage == "sword" || usage == "staff" || usage == "parry"; }
int practice_level() { return 100; }
int valid_learn(object me) {
  object weapon;
  if (!me->query("learnhong"))
    return notify_fail("蛇岛奇功只能向洪安通请教？\n");
  if (objectp(weapon = me->query_temp("weapon")))
    if ((string)weapon->query("skill_type") != "staff" && (string)weapon->query("skill_type") != "sword")
      if (objectp(weapon = me->query_temp("secondary_weapon")))
        if ((string)weapon->query("skill_type") != "staff" && (string)weapon->query("skill_type") != "sword")
          return notify_fail("你使用的武器不对。\n");
  if (me->query_skill("sword", 1) <= me->query_skill("shedao-qigong", 1)
  )
    return notify_fail("你的基础不够，无法领会更高深的技巧。\n");
  if ((int)me->query_skill("shenlong-xinfa", 1) < 50)
    return notify_fail("你的神龙心法火候不够，无法学蛇岛奇功.\n");
  if ((int)me->query_skill("force", 1) < 50)
    return notify_fail("你的基本内功火候不够，无法学蛇岛奇功。\n");
  if ((int)me->query_skill("shenlong-bashi", 1) < 50)
    return notify_fail("你的神龙八式火候不够，无法学蛇岛奇功。\n");
  if ((int)me->query_skill("shenlong-xinfa", 1) < (int)me->query_skill("shedao-qigong", 1))
    return notify_fail("你的神龙心法火候不够，无法继续学蛇岛奇功。\n");
  if ((int)me->query("max_neili") < 20000)
    return notify_fail("你的内力不够20000");
  if ((int)me->query_skill("shedao-qigong", 1) > 120)
    return notify_fail("这套剑法我就教到这儿，以后就要靠你自己练了。\n");
  return 1;
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("shedao-qigong", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}
int practice_skill(object me) {
  object weapon;
  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 30)
    return notify_fail("你的内力不够练蛇岛奇功。\n");
  me->receive_damage("qi", 30);
  me->add("neili", -10);
  return 1;
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  if (damage_bonus < 110) return 0;

  //  第六等级的伤气
  if (me->query_skill("shedao-qigong", 1) > 4000
    && (me->query("neili") * 6) > victim->query("max_neili")) {
    victim->receive_damage("qi", damage_bonus * 2, me);
    return HIR "$N咬破舌尖，剑气犹如有万条金龙在$n眼前舞动！！！\n" NOR;
  }

  //  第五等级的伤气
  if (me->query_skill("shedao-qigong", 1) > 3000
    && (me->query("neili") * 5) > victim->query("max_neili")) {
    victim->receive_damage("qi", damage_bonus, me);
    return HIR "$N的蛇岛奇功已入化境，随手数道剑气分刺$n数处大穴！！！\n" NOR;
  }
  //  第四等级的伤气
  if (me->query_skill("shedao-qigong", 1) > 2000
    && (me->query("neili") * 4) > victim->query("max_neili")) {
    victim->receive_damage("qi", damage_bonus / 2, me);
    return HIR "$N杀得兴起，剑气如涛天巨浪蜂拥而去，煞时间$n全身血液沸腾！！！\n" NOR;
  }


  // 第二等级的伤气
  if (me->query_skill("shedao-qigong", 1) > 400
    && me->query_skill("shedao-qigong", 1) < 1001
    && (me->query("neili") * 3) > victim->query("max_neili")) {
    victim->receive_damage("qi", (damage_bonus - 100) / 5, me);
    return HIW "$N咬破舌尖，一口热血喷出，竟化为无数剑直射$n！！！\n" NOR;
  }

  //  第三等级的伤气
  if (me->query_skill("shedao-qigong", 1) > 1000
    && me->query("zjb_dj/dj") >= 10
    && (me->query("neili") * 3) > victim->query("max_neili")) {
    victim->receive_damage("qi", (damage_bonus - 100) / 3, me);
    return HIR "$N的蛇岛奇功已有小成，剑剑皆带出一道如有实形的剑气攻向$n！！！\n" NOR;
  }


  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "shedao-qigong/" + action;
}
