// shedao-qigong  蛇岛奇功
inherit SKILL;
string type() { return "zhongji"; }
int tydamage = this_player()->query("tydamage/sword") ? this_player()->query("tydamage/sword") : this_player()->query_skill("shedao-qigong");

mapping *action = ({
  ([ "action": "$N使一招「" + HIC + "仙鹤梳翎" + NOR + "」手中$w一提，插向$n的$l",
    "force": 560,
    "dodge": 280,
    "parry": 240,
    "damage": tydamage,
    "lvl": 10,
    "damage_type": "挫伤",
    "skill_name": HIC "仙鹤梳翎" NOR,
  ]),
  ([ "action": "$N使出「" + HIY + "灵蛇出洞" + NOR + "」，身形微弓,手中$w倏的向$n的$l戳去",
    "force": 560,
    "dodge": 280,
    "parry": 240,
    "damage": tydamage,
    "lvl": 60,
    "damage_type": "刺伤",
    "skill_name": HIY "灵蛇出洞" NOR,
  ]),
