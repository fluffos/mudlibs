// tanzhi.c 弹指神通
inherit SKILL;
mapping *action = ({
([  "action" : "$N右指划了个半圈，一式「划天裂地」自上而下划向$n的全身",
    "force" : 350,
    "dodge" : -5,
    "damage": 35,
    "lvl" : 20,
    "skill_name" : "划天裂地",
        "damage_type" : "刺伤"
]),
([  "action" : "$N左掌护胸，一招「我心悠悠」，右指欲举无力指向$n的额头",
    "force" : 380,
    "dodge" : 20,
    "lvl" : 10,
    "skill_name" : "我心悠悠",
    "damage_type" : "刺伤"
]),
([  "action" : "$N双手齐出，一式「千夫所指」，疾指向$n的$l",
    "force" : 400,
    "dodge" : 15,
    "lvl" : 30,
    "skill_name" : "千夫所指",
    "damage_type" : "刺伤"
]),
});

mapping *action2 = ({
([  "action" : "$N仰天一叹，一招「"BLINK HIW"弹指人生"NOR"」，双手幻出重重指影，点向$n的$l",
        "force" : 690,
        "dodge" : 730,
        "parry" : 790,
        "damage" : 400,
        "lvl" : 700,

    "skill_name" : "弹指人生",
    "damage_type" : "刺伤"
]),
([  "action" : "$N一式「"BLINK HIY"笑指天南"NOR"」，左掌蓄式，右指弹出一缕指风点向$n的$l",
        "force" : 800,
        "dodge" : 800,
        "parry" : 800,
        "damage" : 400,
        "lvl" : 850,

    "skill_name" : "笑指天南",
    "damage_type" : "刺伤"
]),
([  "action" : "$N用出「"BLINK HIC"擎天一指"NOR"」，蓄集全身力气，一指点向$n的$l",
        "force" : 715,
        "dodge" : 740,
        "parry" : 710,
        "damage" : 350,
        "lvl" : 1000,

    "skill_name" : "擎天一指",
    "damage_type" : "刺伤"
]),
});
int valid_enable(string usage) { return usage=="parry" || usage=="unarmed"; }
int valid_learn(object me)
{
        if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
        return notify_fail("练弹指神通必须空手。\n");
    if ((int)me->query_skill("bibo-shengong", 1) < 20)
        return notify_fail("你的碧波神功火候不够，无法学弹指神通。\n");
        if ((int)me->query("max_neili") < 100)
        return notify_fail("你的内力太弱，无法练弹指神通。\n");
        return 1;
}
string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}
mapping query_action(object me, object weapon)
{
        int i, level;
          mapping a_action;
        level   = (int) me->query_skill("tanzhi-shentong",1);
          me = this_player();
        if (me->query_skill("tanzhi-shentong",1)<501)  
    return action[random(sizeof(action))];
 
        if (me->query_skill("tanzhi-shentong",1)>500
        && me->query("zjb_dj/dj")>=2)
  return action2[random(sizeof(action2))];

        if (me->query_skill("tanzhi-shentong",1)>500
          && me->query("zjb_dj/dj")<2)
 return action[random(sizeof(action))];


}

mixed hit_ob(object me, object victim, int damage_bonus)
{
    if( damage_bonus < 150 ) return 0;

        if( me->query_skill("tanzhi-shentong",1)>500
       && me->query("zjb_dj/dj")>=2
&& (me->query("neili")*3) > victim->query("max_neili") ) {
                victim->receive_wound("qi", (damage_bonus - 100) / 6 , me);
return HIM "$N弹指间又发出一股"HIR"浑浊内劲"HIM"震向$n！！！\n" NOR;
  }
}

int practice_skill(object me)
{
        if ((int)me->query("qi") < 30)
        return notify_fail("你的体力不够，休息一下再练吧。\n");
        if ((int)me->query("neili") < 20)
        return notify_fail("你的内力不够练弹指神通。\n");
    me->receive_damage("qi", 30);
        me->add("neili", -10);
        return 1;
}
string perform_action_file(string action)
{
        return __DIR__"tanzhi-shentong/" + action;
}

