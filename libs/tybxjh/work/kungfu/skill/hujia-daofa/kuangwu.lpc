#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target) {
  int i;
  object weapon, ob;
  string msg;
  me = this_player();
  me->clean_up_enemy();
  ob = me->select_opponent();
  if (me->is_fighting()) {
    if (environment(me) != environment(ob))
      return notify_fail("对方已经不在了。\n");
  }

  if (!me->is_fighting())
    return notify_fail("「［雪狐狂舞］」只能在战斗中使用。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query_skill("blade", 1) < 200)
    return notify_fail("你的基本刀法的火候还不到家, 不能使用这一绝技 !\n");
  if ((int)me->query_skill("hujia-daofa", 1) < 200)
    return notify_fail("你的胡家刀法的火候还不到家, 不能使用这一绝技 !\n");
  if ((int)me->query("neili") < 5000)
    return notify_fail("你的真气不够！\n");
  if ((int)me->query("max_neili") < 5000)
    return notify_fail("你的内力修为不够！\n");
  msg = HIM "\n$N使出胡家刀法中的绝招［雪狐狂舞］，一招连环几刀，手中的武器讯速击出！\n" NOR;
  message_vision(msg, me);
  for (i = 0; i < 4; i++)
    COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 1);
  me->add("neili", -500);
  me->start_busy(2);
  return 1;
}
