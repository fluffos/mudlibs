#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target) {
  int neili, damage, damage2;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("七弦无形音只能在战斗中使用。\n");
  if ((int)me->query_skill("wuxing-jianfa", 1) < 300)
    return notify_fail("你的七弦无形剑不够娴熟，不会使用七弦无形音。\n");
  if (!me->visible(target)) return notify_fail("你看不到" + target->name() + "。\n");
  if (environment(me)->query("no_fight"))
    return notify_fail("在这里不能攻击他人。\n");
  if ((int)me->query("neili") < 5000)
    return notify_fail("你的内力不够了。\n");
  me->delete_temp("chang");
  neili = me->query("max_neili");
  me->add("neili", -(300 + random(200)));
  me->receive_damage("qi", 10);
  me->start_busy(random(5));
  message_vision(
    HIC "$N运用自身的内力激荡出刺耳破空之声！\n" NOR, me);
  if (neili / 2 + random(neili / 2) < (int)target->query("neili") / 3)
    return notify_fail("对方的内力比你高出太多,伤不了！\n");

  damage = (neili - (int)target->query("max_neili")) / 30;
  if (damage > 0) {
    target->receive_damage("jing", 20);
    if (damage < target->query("max_qi") / 2) damage2 = damage;
    else
      damage2 = (me->query("max_neili") / target->query("max_neili")) * target->query("max_qi");
    target->receive_damage("qi", damage2, me);
    target->receive_wound("qi", random(damage2), me);
    message_vision(
      RED "$N只觉心跳加剧,似乎已然全身经脉俱断。\n" NOR, target);
  } else {
    message_vision(
      HIY "拍拍数响，似是断了好几根琴弦。\n" NOR, target);
    target->receive_damage("jing", 10, me);
    target->receive_damage("qi", 10, me);
    target->receive_wound("qi", 10, me);
  }
  if (!target->is_killing(me)) target->kill_ob(me);
  if (!me->is_killing(target->query("id"))) me->fight_ob(target);
  return 1;
}
