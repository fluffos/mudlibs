#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target) {
  object weapon;
  object ob;
  string msg;
  int i, attack_time;

  me->clean_up_enemy();
  ob = me->select_opponent();
  if (me->is_fighting()) {
    if (environment(me) != environment(ob))
      return notify_fail("对方已经不在了。\n");
  }

  if (!target) target = offensive_target(me);

  if (!me->is_fighting())
    return notify_fail("九死一生只能在战斗中使用。\n");


  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对。\n");


  if (me->query_temp("perform") > time()) return notify_fail("你上一招未使完！\n");

  if ((int)me->query("neili") < 500)
    return notify_fail("你的真气不够！\n");

  msg = BLINK HIR "\n$N眼中神光爆起，刀锋寒气冲天，一回手，魔功" HIG "「九死一生」" HIR "重现人间。\n" NOR;


  message_vision(msg, me);
  me->clean_up_enemy();
  ob = me->select_opponent();
  me->add("neili", -150);
  me->set_temp("perform", time() + 3);
  me->set_temp("perform_duan", 1);
  for (i = 0; i < 9; i++)
    if (me->is_fighting(ob) && ob->is_fighting(me) && ob->query("eff_qi") > 0) {
      me->set_temp("action_msg", HIY "刀光如雪，刀势如雷、、、\n" NOR);
      if (!weapon->query("equipped")) break;
      COMBAT_D->do_attack(me, ob, weapon, 0);
    } else break;
  me->delete_temp("perform_duan");
  me->delete_temp("secondly_weapon");
  return 1;
}
