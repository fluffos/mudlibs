// mie.c  回风拂柳剑法「灭剑」

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target) {
  int damage, damage2;
  string msg;
  object weapon;

  if ((string)me->query("family/family_name") != "华山派")
    return notify_fail("只有华山弟子才能使用该PFM。\n");


  if (!target) target = offensive_target(me);
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail(RED "开什么玩笑，没装备剑就想使「一剑西来」？\n" NOR);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「一剑西来」只能对战斗中的对手使用。\n");
  if ((int)me->query_skill("dugu-jiujian", 1) < 800)
    return notify_fail(WHT "你的独孤九剑不够娴熟，还使不出「一剑西来」。\n" NOR);
  if ((int)me->query_skill("sword", 1) < 850)
    return notify_fail(WHT "你连剑都拿不来，还妄想使出「一剑西来」？\n" NOR);
  if ((int)me->query_skill("force", 1) < 1500)
    return notify_fail(RED "你的内功基础不够，耍不出「一剑西来」。\n" NOR);
  if ((int)me->query_skill("dodge", 1) < 1500)
    return notify_fail(RED "你的身法不够灵活不够，领悟不到「一剑西来」。\n" NOR);
  if ((int)me->query("max_neili") < 50000)
    return notify_fail(RED "你的内力修为不足，无法运足「一剑西来」的内力。\n" NOR);
  if ((int)me->query("neili") < 200) {
    return notify_fail(HIC "你现在内力不够，没能将「一剑西来」使完！\n" NOR);
  }
  msg = HIR "$N深深吸了一口气，缓缓将长剑平举至齐肩，猛然间剑光乱舞\n" NOR;
  msg += HIR "竟然形成数道剑网将$n笼罩在内，$n连忙抽身后跃，想要退出\n" NOR;
  msg += HIR "剑光包围，忽然剑光消失，$n只觉得剑已刺入自己胸口！\n" NOR;
  if (random(me->query_skill("force")) > target->query_skill("force") / 2) {
    me->start_busy(2);
    target->start_busy(random(3));
    damage = (int)me->query_skill("dugu-jiujian", 1) * 5 + (int)me->query_skill("force", 1) * 2;
    damage = damage + random(damage);
    if (damage < target->query(
      "max_qi",
      1
    ) / 8 && me->query(
      "max_neili",
      1
    ) > target->query("max_neili", 1) / 2) damage = random(target->query("max_qi", 1) / 6);
    if (damage > target->query("max_qi", 1) / 3) damage = random(target->query("max_qi", 1) / 4);


    damage2 = (int)me->query_skill("dugu-jiujian", 1) * 5 + (int)me->query_skill("force", 1) * 2;
    damage2 = damage2 + random(damage2);
    target->receive_damage("qi", damage / 2);
    target->receive_wound("qi", damage);
    msg += HIC "$n根本没法躲避，被$N的长剑正正的刺在胸口，顿时血流入注！\n" NOR;
    msg += HIC "$N缓缓抽回长剑道：这就是无招胜有招的「一剑西来剑意」！\n" NOR;
    me->add("neili", -2000);
  } else {
    me->start_busy(random(3));
    msg += HIY "可是$p轻轻一笑，侧身右转，伸出两指，正弹在$P的剑上，长\n" NOR;
    msg += HIY "剑在$p身侧划过，毫发无伤。\n" NOR;
    me->add("neili", -200);
  }
  message_vision(msg, me, target);
  if (!target->is_fighting(me)) target->fight_ob(me);
  //      if(userp(target)) target->fight_ob(me);
  //      else if( !target->is_killing(me) ) target->kill_ob(me);
  return 1;
}
