#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration) {
  if (duration < 1) return 0;
  if (me->query_temp("nopoison")) return 0;
  if (!living(me)) {
    message("vision", me->name() + "痛苦地哼了一声。\n", environment(me), me);
  } else {
    tell_object(me, HIB "忽然一阵刺骨的奇寒袭来，你中的九阴白骨爪毒发作了！\n" NOR);
    message("vision", me->name() + HIB "突然全身一阵抽动，脸色白的像纸一样！\n" NOR,
      environment(me), me);
  }
  me->receive_wound("qi", 10 + random(40));
  me->receive_wound("jing", 50 + random(100));
  me->apply_condition("jy_poison", duration - 1);

  if (duration < 1) return 0;
  return CND_CONTINUE;
}
