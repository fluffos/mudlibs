inherit BULLETIN_BOARD;

void create()
{
        set_name("六翼風鈴", ({ "byron's board","board" }) );
        set("location", "/u/b/byron/workroom.lpc");
        set("board_id", "byron");
        set("board_owner","byron");
        setup();
        set("capacity", 100);
        replace_program(BULLETIN_BOARD);
}
