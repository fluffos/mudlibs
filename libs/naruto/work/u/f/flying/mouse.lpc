#include <npc.h>
#include <ansi.h>

void create()
{
    set_name(HIK"突變鼠王"NOR, ({ "the king of mouse", "mouse", "king" }) );
    set_race("beast");
    set_level(70);

    set("title", "二次突變壞老鼠");
    set("long", "一隻髒兮兮的突變巨大老鼠，看起來與別的老鼠不同。\n");

    set("limbs", ({ "鼠頭", "身體", "腹部", "鼠腿", "尾巴" }) );
    set("verbs", ({ "bite" }) );

    set("attitude", "aggressive");         // 主動攻擊

    set("set_drop", ({
        ([ "type":"obj", "id":12, "amount":1, "p1":80, "p2":100 ]),   // 鼠目
        ([ "type":"obj", "id":13, "amount":1, "p1":80, "p2":100 ]),   // 鼠腳
        ([ "type":"obj", "id":14, "amount":1, "p1":80, "p2":100 ]),   // 鼠尾
        ([ "type":"eq", "id":53, "amount":1, "p1":80, "p2":100 ]),   // 鼠頭
        ([ "type":"eq", "id":54, "amount":1, "p1":3, "p2":100 ]),   // 大暴牙
    }) );

    setup();

    set_skill("combat", 200);
    set_skill("dodge", 200);
    set_skill("parry", 200);
    set_skill("savage hit", 200);
    set_skill("heavy hit", 200);
    set_skill("continual hit", 200);
    set_temp("apply/attack", 20);
}


