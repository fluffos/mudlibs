
inherit BULLETIN_BOARD;

void create()
{
        set_name("對羊彈琴", ({ "music board","board" }) );
        set("location", "/u/a/savior/workroom");
        set("board_id", "savior");
        set("board_owner","savior");
        setup();
        set("capacity", 100);
        replace_program(BULLETIN_BOARD);
}
