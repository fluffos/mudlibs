#include <ansi.h>
#include <armor.h>

inherit F_LEG_EQ;

void create()
{
    set_name(BRED+HIW"染血蠍腳"NOR, ({ "bloody leg","leg" }) );

    set_weight(1670);
    setup_leg_eq();

    if( !clonep() ) {
        set("unit", "個");
        set("value", 19500);
        set("long", "斑斑血紅血跡染在蠍腳上。\n");
        set("wear_as", "leg_eq");
        set("apply_armor/leg_eq", ([
            "armor": 5,
            "con": 2,
            "str": 2,
            "dex": -2,
            "int": -2,
            "combat" : 10,
        ]));
    }

    setup();
}


