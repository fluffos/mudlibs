#include <npc.h>

void create()
{
    set_name("吸血蝙蝠", ({ "bite bat", "bat" }) );
    set_race("beast");
    set_level(6);

    set("long", "比較大隻的蝙蝠，平常喜歡吸食血液。\n");

    set("limbs", ({ "蝠頭", "蝠身", "蝠翼", "蝠耳" }) );
    set("verbs", ({ "bite" }) );

    set("attitude", "aggressive");         // 主動攻擊

    set("set_drop", ({
    //  ([ "type":"eq", "id":??, "amount":1, "p1":20, "p2":100 ]),     // 輻翼
    }) );

    setup();
}
