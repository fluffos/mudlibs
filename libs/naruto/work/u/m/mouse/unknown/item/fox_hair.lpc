#include <ansi.h>

inherit COMBINED_ITEM;

void create()
{
    set_name(YEL"狐毛"NOR, ({ "fox hair", "hair", "_FOX_HAIR_" }) );

    if( !clonep() ) {
        set("base_unit", "根");
        set("unit", "根");
        set("base_value", 30);
        set("base_weight", 400);
        set("long", "一根棕色的狐熊毛。\n");
    }
    setup();
}
