#include <npc.h>

void create()
{
    set_name("小蝙蝠", ({ "bat" }) );
    set_race("beast");
    set_level(3);

    set("long", "普通的蝙蝠，如果侵占牠的巢穴可是會被攻擊的。\n");

    set("limbs", ({ "蝠頭", "蝠身", "蝠翼", "蝠耳" }) );
    set("verbs", ({ "bite" }) );

    set("attitude", "aggressive");         // 主動攻擊

    set("set_drop", ({
    //  ([ "type":"eq", "id":??, "amount":1, "p1":10, "p2":100 ]),     // 輻翼
    }) );

    setup();
}
