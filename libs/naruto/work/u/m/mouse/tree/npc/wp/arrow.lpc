#include <ansi.h>
#include <weapon.h>

inherit F_WEAPON;

void create()
{
    set_name("箭", ({ "arrow" }));
    set_weight(1000);
    setup_weapon(10, 15, 150, 1);
    
    if( !clonep() ) {
        set("wield_as", ({ "lefthand" }) );
        set("unit", "根");
        set("value", 1212);
        set("long", "弓所用的箭羽。\n" );
    }
    setup();
}
