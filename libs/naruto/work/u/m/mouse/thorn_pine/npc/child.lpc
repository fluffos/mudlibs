#include <npc.h>
#include <ansi.h>

inherit F_FIGHTER;

void create()
{
    set_name("豹人小孩", ({ "bow child", "child" }));
    set_race("human");
    set_level(25);
    set("age", 5+random(15));
    set("limbs", ({ "頭部", "身體", "腹部", "腿部", "尾巴", "耳朵", "肩部", "背部" }));
    set("long", "豹村的小孩子，正在村中玩耍。\n");
    set("chat_chance", 5);
    set("chat_msg", ({
        (: random_move :),
        (: command, "say 你好！外地人！" :),
        CYN"豹人小孩快樂的到處亂跑。\n"NOR,
    }));
    set("set_drop", ({
        ([ "type":"wp", "id":45, "amount":1, "p1":10, "p2":100 ]),  // 木劍
        ([ "type":"wp", "id":33, "amount":1, "p1":5, "p2":100 ]),   // 大木棒
        ([ "type":"wp", "id":41, "amount":1, "p1":5, "p2":100 ]),   // 刺木刀
    }) );
    setup();
}
int accept_fight(object ob)
{
    if( this_player()->query_temp("quest/villpk") < 1) {
        do_chat(({
           (: command, "sorry" :),
           (: command, "say 族長有令，平時一律不準打架" :),
        }));
        return 0;
    }
    return ::accept_fight(ob);
}
