#include <ansi.h>

inherit COMBINED_ITEM;

void create()
{
    set_name(HIG"綠色樹液"NOR, ({ "green water", "water", "_HIG_WATER_" }));
    if( !clonep() ) {
        set("base_unit", "瓶");
        set("unit", "瓶");
        set("base_value", 20);
        set("base_weight", 10);
        set("long", "一瓶綠色的樹液。");
    }
    setup();
}
