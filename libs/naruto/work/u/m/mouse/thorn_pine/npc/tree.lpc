#include <npc.h>
#include <ansi.h>

int i;

string *name1 = ({ "刺樹", "刺枝", "刺木", "刺葉", "刺根", "刺莖",
                   "松樹", "松枝", "松木", "松葉", "松根", "松莖" });

string *name2 = ({ "魔", "妖", "怪", "精" });

string report_status(object ob)
{
    int ratio;
    if( !ob->query_stat_maximum("hp") ) return "\n";
    ratio = (int)ob->query_stat("hp")*100/(int)ob->query_stat_maximum("hp");
    if( ratio > 80 ) return HIK"["HIG"$n" + HIG + ratio + "%" + HIK"]\n"NOR;
    else if( ratio > 30 ) return HIK"["HIY"$n" + HIY + ratio + "%" + HIK"]\n"NOR;
    else return HIK"["HIR"$n" + HIR + ratio + "%" + HIK"]\n"NOR;
}
void do_fight()
{
    int damage;
    object enemy;
    string msg;
    // 沒有敵人
    enemy = this_object()->query_opponent();
    if( !enemy ) return;
    // 敵人在不同位置
    if( environment(this_object())->is_area() ) {
        if( !area_environment(this_object(), enemy) ) return;
    } else {
        if( environment(enemy) != environment(this_object()) ) return;
    }
    message_vision("$N"HIG"枝葉一張，如同旋風般的快速朝"NOR"$n"HIG"掃去！\n"NOR, this_object(), enemy);
    damage = 10+random(11);
    if( random(5) > 2) {
        message_vision("        $n蹲低身子閃過了攻擊！(0)"+report_status(enemy)+"", this_object(), enemy);
        this_object()->start_busy(2);
        return;
    }
    enemy->damage_stat("hp", damage, enemy);
    message_vision("        $n「啪！」地一聲被打翻在地上。("+damage+")"+report_status(enemy)+"", this_object(), enemy);
    return;
}
void create()
{
    set_name( name1[random(sizeof(name1))] + name2[random(sizeof(name2))], ({ "thorn tree", "tree" }));
    set_race("beast");
    set_level(25+random(6));
    set("long", "刺松林中的樹族，會自動攻擊外來者。\n");
    set("limbs", ({ "葉片", "樹幹", "樹根", "樹莖", "樹皮", "樹梢", "枝頭" }) );
    set("verbs", ({ "bite" }) );
    set("attitude", "aggressive");         // 主動攻擊
    // 隨機移動
    set("chat_chance", 10);
    set("chat_msg", ({
        (: random_move :),
    }));
    set("chat_chance_combat", 15);
    set("chat_msg_combat", ({
        (: do_fight :),
    }) );
    i = random(101);
    if( i <= 15 ) {
        set("set_drop", ({
            ([ "type":"obj", "id":66, "amount":1, "p1":50, "p2":100 ]),  // 樹根
            ([ "type":"obj", "id":61, "amount":1, "p1":35, "p2":100 ]),  // 樹皮
            ([ "type":"obj", "id":70, "amount":1, "p1":20, "p2":100 ]),  // 樹脂
            ([ "type":"obj", "id":73, "amount":1, "p1":100, "p2":100 ]), // 紅色樹液
        }) );
    } else
    if( i >= 16 && i <= 34 ) {
        set("set_drop", ({
            ([ "type":"obj", "id":66, "amount":1, "p1":50, "p2":100 ]),  // 樹根
            ([ "type":"obj", "id":61, "amount":1, "p1":35, "p2":100 ]),  // 樹皮
            ([ "type":"obj", "id":70, "amount":1, "p1":20, "p2":100 ]),  // 樹脂
            ([ "type":"obj", "id":72, "amount":1, "p1":100, "p2":100 ]), // 紫色樹液
        }) );
    } else
    if( i >= 35 && i <= 94 ) {
        set("set_drop", ({
            ([ "type":"obj", "id":66, "amount":1, "p1":50, "p2":100 ]),  // 樹根
            ([ "type":"obj", "id":61, "amount":1, "p1":35, "p2":100 ]),  // 樹皮
            ([ "type":"obj", "id":70, "amount":1, "p1":20, "p2":100 ]),  // 樹脂
            ([ "type":"obj", "id":71, "amount":1, "p1":100, "p2":100 ]), // 綠色樹液
        }) );
    } else {
        set("set_drop", ({
            ([ "type":"obj", "id":66, "amount":1, "p1":50, "p2":100 ]),  // 樹根
            ([ "type":"obj", "id":61, "amount":1, "p1":35, "p2":100 ]),  // 樹皮
            ([ "type":"obj", "id":70, "amount":1, "p1":20, "p2":100 ]),  // 樹脂
            ([ "type":"obj", "id":74, "amount":1, "p1":100, "p2":100 ]), // 黃金樹液
        }) );
    }
    setup();
}
