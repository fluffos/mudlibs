#include <ansi.h>

inherit COMBINED_ITEM;

void create()
{
    set_name("梟羽", ({ "owl plume", "plume", "_OWL_PLUME_" }));
    if( !clonep() ) {
        set("base_unit", "根");
        set("base_value", 1000);
        set("base_weight", 50);
        set("long", "蒼之梟的羽毛，比一般羽毛更加柔順。\n");
    }
    setup();
}
