#include <npc.h>

void create()
{
    set_name("胖地鼠", ({ "large earth mouse", "mouse" }) );
    set_race("beast");
    set_level(6);
    set("long", "一隻肥肥胖胖，耳朵特別大的巨型地鼠。\n");
    set("limbs", ({ "鼠頭", "身體", "腹部", "鼠腿", "尾巴" }) );
    set("verbs", ({ "bite" }) );
    set("attitude", "aggressive");         // 主動攻擊
    set("chat_chance", 5);
    set("chat_msg", ({
        (: random_move :),
    }));
    set("set_drop", ({
        ([ "type":"food", "id":35, "amount":1, "p1":80, "p2":100 ]),   // 鼠目
        ([ "type":"food", "id":36, "amount":1, "p1":80, "p2":100 ]),   // 鼠腳
        ([ "type":"food", "id":37, "amount":1, "p1":80, "p2":100 ]),   // 鼠尾
        ([ "type":"food", "id":56, "amount":1, "p1":10, "p2":100 ]),   // 鼠腦
    }) );
    setup();
}
