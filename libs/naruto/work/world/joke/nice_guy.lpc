#include <ansi.h>

inherit COMBINED_ITEM;

void create()
{
    set_name(HIW"好人卡"NOR, ({ "nice guy card", "card" }));

    set_weight(1);

    if( !clonep() ) {
        set("base_unit", "張");
        set("base_value", 78);
        set("base_weight", 1);
        set("long", 
@LONG
 ╭──┬───────┬──╮
 │０４│  好人的宣判  │F-99│
 ├──┴───────┴──┤
 │╔═══════════╗│
 │║ 好人!         好人!  ║│
 │║         好人!        ║│
 │║    好人!  ///   好人!║│
 │║       ___OTZ___      ║│
 │╚═══════════╝│
 ├─────────────┤
 │ "對不起，你真是一個好人" │
 ╰─────────────╯
LONG);
    }
    setup();

}
