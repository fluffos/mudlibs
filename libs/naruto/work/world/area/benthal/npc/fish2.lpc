#include <npc.h>

void create()
{
    set_name("梧柏魚", ({ "fish" }) );
    set_race("beast");
    set_level(8);
    set("long", "棲息在樹根附近的特有魚種。\n");
    set("limbs", ({ "魚頭", "身體", "腹部", "魚尾", "魚鰭" }) );
    set("verbs", ({ "bite" }) );
    set("chat_chance", 5);
    set("chat_msg", ({
        (: random_move :),
    }));
    set("set_drop", ({
        ([ "type":"food", "id":68, "amount":1, "p1":30, "p2":100 ]),   // 魚肉
        ([ "type":"food", "id":69, "amount":1, "p1":80, "p2":100 ]),   // 魚肚肉
        ([ "type":"food", "id":70, "amount":1, "p1":30, "p2":100 ]),   // 魚背肉
        ([ "type":"food", "id":71, "amount":1, "p1":30, "p2":100 ]),   // 魚尾肉
    }) );
    setup();
}
