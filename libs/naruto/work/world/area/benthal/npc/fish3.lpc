#include <npc.h>

void create()
{
    set_name("禿魚", ({ "fish" }) );
    set_race("beast");
    set_level(10);
    set("long", "全身光禿禿的魚類，連魚鱗都非常稀少。\n");
    set("limbs", ({ "魚頭", "身體", "腹部", "魚尾", "魚鰭" }) );
    set("verbs", ({ "bite" }) );
    set("chat_chance", 5);
    set("chat_msg", ({
        (: random_move :),
    }));
    set("set_drop", ({
        ([ "type":"food", "id":68, "amount":1, "p1":30, "p2":100 ]),   // 魚肉
        ([ "type":"food", "id":69, "amount":1, "p1":30, "p2":100 ]),   // 魚肚肉
        ([ "type":"food", "id":70, "amount":1, "p1":80, "p2":100 ]),   // 魚背肉
        ([ "type":"food", "id":71, "amount":1, "p1":30, "p2":100 ]),   // 魚尾肉
        ([ "type":"food", "id":73, "amount":1, "p1":5, "p2":100 ]),    // 魚肝油
    }) );
    setup();
}
