#include <ansi.h>

inherit COMBINED_ITEM;

void create()
{
    set_name(HIW"蜘蛛黏液"NOR, ({ "spider mucus", "mucus","_SPIDER_MUCUS_" }));
    if( !clonep() ) {
        set("base_unit", "沱");
        set("base_value", 60);
        set("base_weight", 100);
        set("long", "一團黏黏的蜘蛛液體。\n");
    }
    setup();
}
