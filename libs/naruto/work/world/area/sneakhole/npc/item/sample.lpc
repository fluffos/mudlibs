#include <ansi.h>

inherit COMBINED_ITEM;

void create()
{
    set_name(HIG"蛇毒"NOR, ({ "snake venom", "venom" }));
    if( !clonep() ) {
        set("base_unit", "瓶");
        set("unit", "瓶");
        set("base_value", 500);
        set("base_weight", 100);
        set("long", "一瓶蛇的毒液。\n");
    }
    setup();
}
