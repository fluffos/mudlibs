#include <ansi.h>
inherit F_FOOD;

void create()
{
    set_name(HIR"紅蘿蔔"NOR, ({ "beet", "_KARE_A_" }));
    if( !clonep() ) {
        set("unit", "根");
        set("base_unit", "根");
        set("base_value", 15);
        set("base_weight", 10);
        set("food_stuff", 20);
        set("no_sell", 1);
        set("long", "紅色蔬菜，含有豐富胡蘿蔔素。\n");
    }
    setup();
}
