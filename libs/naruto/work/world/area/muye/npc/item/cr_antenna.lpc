#include <ansi.h>

inherit COMBINED_ITEM;

void create()
{
    set_name(HIK"蟑螂觸角"NOR, ({ "cockroach's antenna", "antenna" }));
    if( !clonep() ) {
        set("base_unit", "根");
        set("base_value", 4);
        set("base_weight", 100);
        set("long", "一支惡臭的蟑螂觸角。\n");
    }
    setup();
}