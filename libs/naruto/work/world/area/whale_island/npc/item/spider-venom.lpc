#include <ansi.h>

inherit COMBINED_ITEM;

void create()
{
    set_name(HIM"蜘蛛毒液"NOR, ({ "spider venom", "venom","__QUEST_D_2__" }));
    if( !clonep() ) {
        set("base_unit", "瓶 ");
        set("base_value", 45);
        set("base_weight", 100);
        set("long", "一瓶剛採集來的蜘蛛毒液。\n");
    }
    setup();
}

