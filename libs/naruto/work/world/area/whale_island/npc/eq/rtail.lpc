#include <ansi.h>
#include <armor.h>

inherit F_PANTS;

void create()
{
    set_name(HIW"兔尾巴"NOR, ({ "rabbit tail", "tail" }) );

    set_weight(1000);
    setup_pants();

    if( !clonep() ) {
        set("unit", "件");
        set("value", 1200);
        set("long", "一顆雪白圓滾滾的兔尾巴。");
        set("wear_as", "pants");
        set("apply_armor/pants", ([
            "armor": 5,
            "dex": 1,
        ]));
    }

    setup();
}

