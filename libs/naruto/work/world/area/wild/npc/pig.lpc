#include <npc.h>
#include <ansi.h>

void create()
{
    set_name(HIK"黑豬"NOR, ({ "black pig", "pig" }) );
    set_race("beast");
    set_level(7);

    set("long", "一隻肥滋滋的黑豬，一副兇狠的樣子。\n");

    set("limbs", ({ "豬頭", "身體", "腹部", "豬腿", "尾巴" }) );
    set("verbs", ({ "bite" }) );

    set("attitude", "aggressive");         // 主動攻擊

    set("set_drop", ({
        ([ "type":"food", "id":31, "amount":1, "p1":80, "p2":100 ]),   // 豬腸
        ([ "type":"eq", "id":55, "amount":1, "p1":50, "p2":100 ]),   // 黑豬皮
        ([ "type":"eq", "id":56, "amount":1, "p1":40, "p2":100 ]),   // 黑豬頭
    }) );

    setup();
}