#include <ansi.h>
#include <armor.h>

inherit F_WRIST_EQ;

void create()
{
    set_name(CYN"青銅護腕"NOR, ({ "bronze wrist", "wrist" }) );
    set_weight(100);
    setup_wrist_eq();

    if( !clonep() ) {
        set("unit", "個");
        set("value", 5900);
        set("long", "一個堅硬的護腕\n");
        set("wear_as", "wrist_eq");
        set("apply_armor/wrist_eq", ([
            "dex": 1,
            "str": 1,
            "int": 1,
            "armor": 4,
        ]));
    }

    setup();
}
