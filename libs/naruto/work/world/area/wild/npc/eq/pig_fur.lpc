#include <armor.h>
#include <ansi.h>

inherit F_CLOTH;

void create()
{
    set_name(HIK"黑豬皮"NOR, ({ "pig's fur", "fur" }));
    set_weight(1000);
    setup_cloth();

    if( !clonep() ) {
        set("unit", "張");
        set("value", 200);
        set("long", "一張黝黑粗糙的黑豬皮。\n");
        set("wear_as", "cloth");
        set("apply_armor/cloth", ([
            "armor": 2,
        ]));
    }

    setup();
}