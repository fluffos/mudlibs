#include <npc.h>

void create()
{
    set_name("小蛇", ({ "small snake", "snake" }) );
    set_race("beast");
    set_level(5);

    set("long", "一隻半長不短的小蛇。\n");

    set("limbs", ({ "蛇頭", "蛇尾", "腹部" }) );
    set("verbs", ({ "bite" }) );

    set("attitude", "aggressive");         // 主動攻擊

    set("set_drop", ({
        ([ "type":"food", "id":29, "amount":1, "p1":20, "p2":100 ]),   // 蛇蛋
        ([ "type":"food", "id":30, "amount":1, "p1":10, "p2":100 ]),   // 蛇膽
        ([ "type":"obj", "id":24, "amount":1, "p1":10, "p2":100 ]),   // 蛇皮
        ([ "type":"wp", "id":14, "amount":1, "p1":3, "p2":100 ]),   // 蛇牙
    }) );

    setup();
}
