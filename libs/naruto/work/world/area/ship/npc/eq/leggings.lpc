#include <ansi.h>
#include <armor.h>

inherit F_LEG_EQ;

void create()
{
    set_name(YEL"猿猴"HIW"護腿"NOR, ({ "pongo leggings", "leggings" }) );

    set_weight(2000);
    setup_leg_eq();

    if( !clonep() ) {
        set("unit", "雙");
        set("value", 22000);
        set("long", "人猿所穿的護腿，毛絨絨的似乎還很保暖。\n");
        set("wear_as", "leg_eq");
        set("apply_armor/leg_eq", ([
            "armor": 10,
            "evade": 10,
        ]));
    }
    setup();
}
