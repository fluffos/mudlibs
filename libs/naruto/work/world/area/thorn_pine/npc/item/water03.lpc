#include <ansi.h>

inherit COMBINED_ITEM;

void create()
{
    set_name(HIR"紅色樹液"NOR, ({ "red water", "water", "_HIR_WATER_" }));
    if( !clonep() ) {
        set("base_unit", "瓶");
        set("unit", "瓶");
        set("no_box", 1);
        set("base_value", 20);
        set("base_weight", 10);
        set("long", "一瓶紅色的樹液。");
    }
    setup();
}
