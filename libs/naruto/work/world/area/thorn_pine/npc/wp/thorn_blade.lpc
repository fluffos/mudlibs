#include <ansi.h>
#include <weapon.h>
inherit F_WEAPON;

void create()
{
    set_name("刺木刀", ({ "thorn blade", "blade" }));
    set_weight(1000);
    setup_weapon(15, 15, 100, 1);
    if( !clonep() ) {
        set("wield_as", ({ "righthand" }) );
        set("unit", "把");
        set("value", 1515);
        set("long", "有刺木尖刺的木刀。\n" );
    }
    setup();
}
