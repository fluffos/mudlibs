#include <npc.h>
#include <ansi.h>

string *name1 = ({ "刺樹", "刺枝", "刺木", "刺葉", "刺根", "刺莖",
                   "松樹", "松枝", "松木", "松葉", "松根", "松莖",
                   "柏樹", "柏枝", "柏木", "柏葉", "柏根", "柏莖",
                   "鐵樹", "鐵枝", "鐵木", "鐵葉", "鐵根", "鐵莖", });

string *name2 = ({ "魔", "妖", "怪", "精", "鬼", "仙", "蟲" });

void do_fight()
{
    int damage, raiseDamage;
    object enemy;

    enemy = this_object()->query_opponent();

    if( !enemy ) return;
    if( environment(this_object())->is_area() ) {
        if( !area_environment(this_object(), enemy) ) return;
    } else {
        if( environment(enemy) != environment(this_object()) ) return;
    }
    // 等級太低不放 perform, 已經被定就不放 perform
    if( enemy->query_level() < 5 ) return;
    if( enemy->is_busy() ) return;

    message_vision("\n$N"HIG"枝葉一張，如同旋風般的快速朝"NOR"$n"HIG"掃去！\n"NOR, this_object(), enemy);
    if( random(5) > 2) {
        message_vision("$n蹲低身子閃過了攻擊！\n\n", this_object(), enemy);
        this_object()->start_busy(1);
        return;
    }
    damage = 100;

    add_temp("apply/attack", raiseDamage); 
    damage = COMBAT_D->isDamage(this_object(), enemy, 0);
    add_temp("apply/attack", -raiseDamage);

    // 傷害盾吸收
    damage = COMBAT_D->receive_damage(enemy, this_object(), damage);
    enemy->damage_stat("hp", damage, this_object());
    message_vision( sprintf("$n「啪！」地一聲被打翻在地上(%d) %s\n\n", damage, COMBAT_D->report_status(enemy) ), this_object(), enemy);
    enemy->start_busy(3);
    return;
}
void create()
{
    set_name( name1[random(sizeof(name1))] + name2[random(sizeof(name2))], ({ "thorn tree", "tree" }));
    set_race("beast");
    set_level(25+random(6));
    set("long", "刺松林中的樹族，會自動攻擊外來者。\n");
    set("limbs", ({ "葉片", "樹幹", "樹根", "樹莖", "樹皮", "樹梢", "枝頭" }) );
    set("verbs", ({ "bite" }) );
    set("attitude", "aggressive");         // 主動攻擊
    // 隨機移動
    set("chat_chance", 10);
    set("chat_msg", ({
        (: random_move :),
    }));
    set("chat_chance_combat", 30);
    set("chat_msg_combat", ({
        (: do_fight :),
    }) );
    switch( random(101) ) {
        case 0..15:
            set("set_drop", ({
                ([ "type":"obj", "id":60, "amount":1, "p1":50, "p2":100 ]),  // 樹根
                ([ "type":"obj", "id":61, "amount":1, "p1":35, "p2":100 ]),  // 樹皮
                ([ "type":"obj", "id":70, "amount":1, "p1":20, "p2":100 ]),  // 樹脂
                ([ "type":"obj", "id":73, "amount":1, "p1":60, "p2":100 ]),  // 紅色樹液
            }) );
            break;
        case 16..34:
            set("set_drop", ({
                ([ "type":"obj", "id":60, "amount":1, "p1":50, "p2":100 ]),  // 樹根
                ([ "type":"obj", "id":61, "amount":1, "p1":35, "p2":100 ]),  // 樹皮
                ([ "type":"obj", "id":70, "amount":1, "p1":20, "p2":100 ]),  // 樹脂
                ([ "type":"obj", "id":72, "amount":1, "p1":60, "p2":100 ]),  // 紫色樹液
            }) );
            break;
        case 35..94:
            set("set_drop", ({
                ([ "type":"obj", "id":60, "amount":1, "p1":50, "p2":100 ]),  // 樹根
                ([ "type":"obj", "id":61, "amount":1, "p1":35, "p2":100 ]),  // 樹皮
                ([ "type":"obj", "id":70, "amount":1, "p1":20, "p2":100 ]),  // 樹脂
                ([ "type":"obj", "id":71, "amount":1, "p1":60, "p2":100 ]),  // 綠色樹液
            }) );
            break;
        default:
            set("set_drop", ({
                ([ "type":"obj", "id":60, "amount":1, "p1":50, "p2":100 ]),  // 樹根
                ([ "type":"obj", "id":61, "amount":1, "p1":35, "p2":100 ]),  // 樹皮
                ([ "type":"obj", "id":70, "amount":1, "p1":20, "p2":100 ]),  // 樹脂
                ([ "type":"obj", "id":74, "amount":1, "p1":60, "p2":100 ]),  // 黃金樹液
            }) );
            break;
    }
    setup();
}