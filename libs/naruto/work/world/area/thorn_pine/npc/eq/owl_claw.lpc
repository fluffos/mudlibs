#include <ansi.h>
#include <armor.h>
inherit F_HAND_EQ;

void create()
{
    set_name(HIW"巨梟"NOR"爪", ({ "owl claw","claw" }) );

    set_weight(1500);
    setup_hand_eq();

    if( !clonep() ) {
        set("unit", "雙");
        set("value", 15750);
        set("long", "蒼之梟的鳥爪，爪子尖銳且堅硬無比。\n");
        set("wear_as", "hand_eq");
        set("apply_armor/hand_eq", ([
            "armor" : 5,
            "attack" : 5,
            "intimidate" : 5,
        ]));
    }
    setup();
}
