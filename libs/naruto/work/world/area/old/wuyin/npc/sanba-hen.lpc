#include <npc.h>
#include <ansi.h>

void create()
{
    set_name("森巴雞", ({ "sanba hen","hen"  }) );
    set_race("beast");
    set_level(10);

    set("long", "一附驕傲的母雞，但怎麼有雞冠？。\n");

    set("limbs", ({ "雞冠", "雞毛", "雞腿", "雞屁股", "雞胸" }) );
    set("verbs", ({ "bite" }) );
 
    setup();

    carry_money("silver", 1);
    if( random(100) > 60 ) carry_object("/world/area/wuyin/obj/jelly.lpc");
    if( random(100) > 85 ) carry_object("/world/area/wuyin/eq/cockscomb.lpc")->wear();


}
