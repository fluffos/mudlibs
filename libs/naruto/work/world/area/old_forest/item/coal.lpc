#include <ansi.h>
inherit COMBINED_ITEM;

void create()
{
    set_name(HIK"煤礦"NOR, ({ "coal", "_COAL_" }));
    if( !clonep() ) {
        set("base_unit", "顆");
        set("unit", "顆");
        set("base_value", -1);
        set("base_weight", 10);
        set("long", "黑黑的煤碳，適合用來燒火加溫。");
    }
    setup();
}
