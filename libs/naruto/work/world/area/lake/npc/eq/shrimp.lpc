#include <ansi.h>
#include <armor.h>
inherit F_ARMOR;

void create()
{
    set_name(HIR"蝦殼"NOR, ({ "shrimp shell", "shell" }) );
    set_weight(1000);
    setup_armor();
    if( !clonep() ) {
        set("unit", "個");
        set("value", 300);
        set("long", "龍蝦的外殼，蠻堅硬的。\n");
        set("wear_as", "armor");
        set("apply_armor/armor", ([
            "armor": 3,
        ]));
    }
    setup();
}
