#include <ansi.h>
inherit COMBINED_ITEM;

void create()
{
    set_name(HIG"煙燻綠豆"NOR, ({ "Smoke mung", "mung" }));
    if( !clonep() ) {
        set("base_unit", "簍");
        set("base_value", -1);
        set("unit", "簍");
        set("base_weight", 500);
        set("long", "鯨魚島老婆婆耗費心血製作的傳奇綠豆。\n");
    }
    setup();
}
