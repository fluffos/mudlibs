#include <ansi.h>
inherit COMBINED_ITEM;

void create()
{
    set_name(HIW"桂圓乾"NOR, ({ "Longan", "longan" }));
    if( !clonep() ) {
        set("base_unit", "袋");
        set("base_value", -1);
        set("unit", "袋");
        set("base_weight", 500);
        set("long", "堂秋所贈送的一袋桂圓乾，又被稱為龍眼。\n");
    }
    setup();
}
