// emei_poison.c 峨眉毒


#include <condition.h>

inherit F_CLEAN_UP;
inherit POISON;

// 定义毒素名称
string name() { return "emei_poison"; }
string chinese_name() { return "峨眉毒"; }

// 毒发作时的消息
string update_msg_others()
{
    return HIG "$N" HIG "脸色微微一变，似乎有些不适。\n" NOR;
}

string update_msg_self()
{
    return HIB "你感到一阵眩晕，体内仿佛有无数蚂蚁在啃噬你的身体。\n" NOR;
}

int jing_damage(object me, mapping cnd)
{
    return cnd["level"] / 6;
}

int qi_damage(object me, mapping cnd)
{
    return cnd["level"] / 3;
}

int dispel(object me, object ob, int duration)
{
    if (me != ob)
    {
        tell_object(me, "你试图帮助" + ob->name() + "化解峨眉毒，但发现此毒异常诡异，难以化解。\n");
        return -1;
    }
    else
    {
        tell_object(me, "你运功试图化解体内的峨眉毒，但感到毒性难以消除。\n");
        return -1;
    }
}