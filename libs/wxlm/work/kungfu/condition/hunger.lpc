// hunger.c

#include <condition.h>


int dispel() { return 0; }

int update_condition(object me, int duration)
{
	object *inv;
	int i;
	if (me->query("food") > 0 && me->query("water") > 0)
		return 0;

	if (me->query("zjvip/times") > 0)
		{
			tell_object(me, HIY "你腹中空空,正自烦恼之际,忽见一道金光闪过,江湖使者送来了仙家玉露与琼浆,你细细品尝,顿觉神清气爽..."NOR"\n");
			me->set("food", me->max_food_capacity());
			me->set("water", me->max_food_capacity());
			return 0;
		}

	if (! interactive(me) || ! environment(me) || environment(me)->is_chat_room())
		return CND_CONTINUE;

	if (duration == 4)
	{
		if (me->query("food") <= 0 && me->query("water") <= 0)
		{
			tell_object(me, HIY "你腹中饥渴难耐,眼前一阵发黑,看来得寻些酒食充饥了。"NOR"\n");
		}
		else if (me->query("food") <= 0)
		{
			tell_object(me, HIY "你腹中饥饿难忍,四肢无力,需得寻些食物果腹。"NOR"\n");
		}
		else if (me->query("water") <= 0)
		{
			tell_object(me, HIY "你口干舌燥,喉头火烧火燎,需得寻些清水解渴。"NOR"\n");
		}
	}
	else
	if (duration == 7)
	{
		if (me->query("food") <= 0 && me->query("water") <= 0)
			tell_object(me, HIR "你饥渴交加,眼前一阵阵发黑,只觉天旋地转。"NOR"\n");
		else
		if (me->query("food") <= 0)
			tell_object(me, HIR "你饥肠辘辘,腹中空空如也,几欲昏厥。"NOR"\n");
		else
		if (me->query("water") <= 0)
			tell_object(me, HIR "你口干舌燥,喉如火烧,几欲昏厥。"NOR"\n");
	}
	else
	if (duration >= 13)
	{
		if (me->query("age") < 18)
		{
			tell_object(me, HIY "你正自危难之际,忽见天降异象,一盘香喷喷的烤鸭和一壶醇香美酒飘然而至,你狼吞虎咽,顿觉精神焕发。"NOR"\n");
			me->set("food", me->max_food_capacity());
			me->set("water", me->max_food_capacity());
			return 0;
		}

		if (me->query("food") <= 0 && me->query("water") == 0)
			tell_object(me, HIR "你饥渴交迫,眼前一片漆黑,只觉随时都要倒地不起。"NOR"\n");
		else
		if (me->query("food") <= 0)
			tell_object(me, HIR "你饥饿难耐,眼前一片漆黑,只觉随时都要倒地不起。"NOR"\n");
		else
		if (me->query("water") <= 0)
			tell_object(me, HIR "你口干舌燥,眼前一片漆黑,只觉随时都要倒地不起。"NOR"\n");
		if(me->query("qi")>5)
			me->receive_damage("qi", 5);
		if(me->query("eff_qi")>5)
			me->receive_wound("qi", 5);
		return 0;
	}

	if (duration >= 2)
	{
		inv = all_inventory(me);
		for(i=0;i<sizeof(inv);i++)
		{
			if(!inv[i]->is_cutable()&&me->query("food")<=0&&inv[i]->query("food_remaining"))
			{
				"/cmds/std/eat"->main(me,inv[i]->query("id"));
				break;
			}
			if(me->query("water")<=0&&inv[i]->query("liquid/remaining")>0)
			{
				"/cmds/std/drink"->main(me,inv[i]->query("id"));
				break;
			}
		}
	}

	me->apply_condition("hunger", duration + 1);
	return CND_CONTINUE;
}
