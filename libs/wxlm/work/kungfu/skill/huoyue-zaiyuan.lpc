// dragon-strike.c 镇岳锁龙劲 或跃在渊
// modified by Venus Oct.1997
// modified by Doing 1999

inherit SKILL;

mapping *action = ({
([      "action" : "$N使出「或跃在渊」，向$n的$l连拍数掌",
	"dodge"  : 20,
	"parry"  : 15,
	"force"  : 210,
	"damage" : 80,
	"damage_type": "震伤"
]),
});

string main_skill() { return "dragon-strike"; }

int valid_enable(string usage) { return usage=="strike" ||  usage=="parry"; }  

int valid_learn(object me)
{
	if (me->query_skill("dragon_strike", 1) > 0)
		return notify_fail("你已经学全十八掌了，不必再单独学习。\n");

	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练镇岳锁龙劲必须空手。\n");

	if ((int)me->query("str") < 30)
		return notify_fail("就你这身子骨还练镇岳锁龙劲？小心弄折了胳膊。\n");

	if ((int)me->query_skill("force") < 90)
		return notify_fail("你的内功火候不够无法学习镇岳锁龙劲。\n");

	if ((int)me->query("max_neili") < 600)
		return notify_fail("你的内力太差无法学习镇岳锁龙劲。\n");

	if ((int)me->query_skill("strike", 1) < 30)
		return notify_fail("你的基本掌法火候不够，无法学习镇岳锁龙劲。\n");

	if ((int)me->query_skill("strike", 1) < (int)me->query_skill("huoyue-zaiyuan", 1))
		return notify_fail("你的基本掌法水平有限，无法领会更高深的镇岳锁龙劲。\n");

	return 1;
}

mapping query_action(object me, object weapon)
{
    return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 120)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 50)
		return notify_fail("你的内力不够练镇岳锁龙劲。\n");

	me->receive_damage("qi", 100);
	me->add("neili", -40);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"huoyue-zaiyuan/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【镇岳锁龙劲】" ZJBR NOR;
    msg += "降龙十八掌中的一式，亦称或跃在渊。此招刚猛异常，威力巨大。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  不能已学会完整的降龙十八掌 (dragon-strike)。" ZJBR;
    msg += "  必须空手。" ZJBR;
    msg += "  先天臂力需达到 " HIY "30" NOR " 点。" ZJBR;
    msg += "  基本内功等级需达到 " HIY "90" NOR " 级。" ZJBR;
    msg += "  最大内力需达到 " HIB "600" NOR " 点。" ZJBR;
    msg += "  基本掌法等级需达到 " HIY "30" NOR " 级。" ZJBR;
    msg += "  基本掌法等级不可低于镇岳锁龙劲等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  掌法（strike）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "120" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "100" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "40" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  暂无。" ZJBR;

    return msg;
}
