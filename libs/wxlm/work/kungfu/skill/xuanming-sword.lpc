/**
 * @brief 检查演练准备条件
 * @param object me 玩家对象
 * @return int 1表示可以开始演练，0表示不可以
 */
int get_ready(object me)
{
	return 1;
}

/**
 * @brief 检查演练完成条件
 * @param object me 玩家对象
 * @return int 1表示成功融合，0表示失败
 */
int get_finish(object me)
{
	if (!me->query_temp("weapon") ||
	    me->query_temp("weapon")->query("skill_type") != "sword")
	{
		tell_object(me, "你忽然发现玄命剑典必须用剑才能施展，没有剑怎么行呢？\n");
		return 0;
	}

	if (me->query("int") < 35)
	{
		tell_object(me, "你演练完毕，觉得两套剑法精妙异常，但始终无法将其融会贯通。\n");
		return 0;
	}

	if (me->query("con") < 30)
	{
		tell_object(me, "你演练完毕，就觉得体力不支，无法承受两套绝世剑法的融合。\n");
		return 0;
	}

	if ((int)me->query("max_neili") < 100000)
	{
		tell_object(me, "你觉得内力不足，无法融会贯通两套绝世剑法。\n");
		return 0;
	}

	if (me->query_skill("force", 1) < 700)
	{
		tell_object(me, "你发现自己的内功修为不够，无法驾驭玄命剑典的威力。\n");
		return 0;
	}

	if (me->query_skill("sword", 1) < 700)
	{
		tell_object(me, "你觉得自己的基本剑法还不够纯熟，无法掌握玄命剑典。\n");
		return 0;
	}

	if (random(10) < 6)
	{
		tell_object(me, "你觉得若有所悟，两套剑法似乎有了一丝融合的征象，或许再演练一次就能成功。\n");
		return 0;
	}

	tell_object(me, HIY "突然间，你心中豁然开朗，玄铁剑法的刚猛与独孤九剑的灵动在你心中完美融合，\n"
		        "一套前所未有的绝世剑典——玄命剑典终于被你领悟！" NOR "\n");
	return 1;
}

/**
 * @brief 返回子技能映射
 * @return mapping 子技能映射
 */
mapping query_sub_skills()
{
	return sub_skills;
}

/**
 * @brief 有效激发类型
 */
int valid_enable(string usage)
{
	return usage == "sword" || usage == "parry";
}

/**
 * @brief 连击功能
 */
int double_attack() { return 1; }

/**
 * @brief 学习条件检查
 */
int valid_learn(object me)
{
	if (!me->query_temp("weapon") ||
	    me->query_temp("weapon")->query("skill_type") != "sword")
		return notify_fail("练玄命剑典必须使用剑。\n");

	if (me->query("int") < 35)
		return notify_fail("你的天资不足，无法理解玄命剑典的精妙。\n");

	if ((int)me->query("max_neili") < 4000)
		return notify_fail("你的内力太弱，无法学玄命剑典。\n");

	if (me->query_skill("sword", 1) < me->query_skill("xuanming-sword", 1))
		return notify_fail("你的基本剑法水平有限，无法领会更高深的玄命剑典。\n");

	if (me->query_skill("force", 1) < me->query_skill("xuanming-sword", 1))
		return notify_fail("你的内功底子还不够，无法领会更高深的玄命剑典。\n");

	return 1;
}

/**
 * @brief 练习条件检查
 */
int practice_skill(object me)
{
	int cost;
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon")) ||
	    weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 150)
		return notify_fail("你的体力不够练玄命剑典。\n");

	cost = me->query_skill("xuanming-sword", 1) / 2 + 100;
	if ((int)me->query("neili") < cost)
		return notify_fail("你的内力不够练玄命剑典。\n");

	me->receive_damage("qi", 120);
	me->add("neili", -cost);
	return 1;
}

/**
 * @brief 攻击命中特效
 */
mixed hit_ob(object me, object victim, int damage_bonus)
{
	int lvl, i;

	lvl = me->query_skill("xuanming-sword", 1);
	i = random(lvl);

	if (i < 100) return;

	if (i < 200)
	{
		victim->receive_wound("qi", damage_bonus / 3);
		return HIR "只见$N" HIR "剑心通明，剑气如虹，玄铁之劲透剑而出，$n" HIR "顿时内府受创！" NOR "\n";
	}
	else if (i < 300)
	{
		victim->receive_wound("qi", damage_bonus / 2);
		victim->add("neili", -damage_bonus);
		return HIC "$N" HIC "剑心澄澈，独孤剑意洞察先机，剑法飘忽不定，$n" HIC "真气紊乱！" NOR "\n";
	}
	else
	{
		victim->receive_wound("qi", damage_bonus);
		victim->start_busy(1);
		return HIY "$N" HIY "剑心通明，神凝一体，玄冥合一之下剑典神威大显，$n" HIY "在无穷剑意下难以招架！" NOR "\n";
	}
}

/**
 * @brief 防御特效
 */
mixed valid_damage(object ob, object me, int damage, object weapon)
{
	mapping result;
	int ap, dp, cost;

	if ((int)me->query_skill("xuanming-sword", 1) < 180
	   || me->query_skill_mapped("parry") != "xuanming-sword"
	   || (int)me->query("neili") < 300
	   || !living(me))
		return;

	cost = damage / 3;
	if (cost > 150) cost = 150;

	ap = ob->query_skill("force") * 12 + ob->query("max_neili");
	dp = me->query_skill("force") * 12 + me->query("max_neili");

	if (ap / 2 + random(ap) < dp)
	{
		me->add("neili", -cost);
		result = ([ "damage": -(damage * 2 / 3) ]);

		switch (random(3))
		{
		case 0:
			result += (["msg" : HIR "$n" HIR "玄命剑典护体，剑气如盾，$N" HIR "攻势被轻松化解！\n" NOR]);
			break;
		case 1:
			result += (["msg" : HIC "$n" HIC "剑意通神，无招胜有招，$N" HIC "的招式破绽尽显！\n" NOR]);
			break;
		default:
			result += (["msg" : HIY "$n" HIY "玄冥合一，刚柔并济，$N" HIY "的攻击如泥牛入海！\n" NOR]);
			break;
		}
		return result;
	}
}

/**
 * @brief 查询动作
 */
mapping query_action(object me, object weapon)
{
	int level;
	level = (int) me->query_skill("xuanming-sword", 1);

	// 高等级时有特殊攻击
	if (random(10) == 7 && level > 250)
	{
		me->add("neili", -300);
		return ([
			"action": HIM "$N" HIM "忽然神色大变，玄命剑典终极奥义施展而出，剑气冲天而起，\n"
			         HIM "玄铁的刚猛与独孤的灵动完美融合，$n" HIM "在无穷剑意面前瑟瑟发抖！" NOR,
			"attack": 250,
			"dodge" : 180,
			"parry" : 200,
			"damage": 350,
			"force" : 700,
			"damage_type": "刺伤"
		]);
	}

	return action[random(sizeof(action))];
}

/**
 * @brief 技能提升时清理子技能
 */
void skill_improved(object me)
{
	int i;
	string *sub_skillnames;
	sub_skillnames = keys(sub_skills);
	for (i = 0; i < sizeof(sub_skillnames); i++)
		me->delete_skill(sub_skillnames[i]);
}

/**
 * @brief 招架特效消息
 */
string query_parry_msg(object victim_weapon)
{
	switch (random(4))
	{
	case 0:
		return "$n玄命剑典运转，剑气纵横，$N的攻势瞬间被化解。\n";
	case 1:
		return "$n剑法飘忽，玄冥合一，$N只觉攻击如击空气。\n";
	case 2:
		return "$n长剑一横，刚柔并济，将$N的攻势尽数挡下。\n";
	default:
		return "$n剑意如虹，无形有形并用，$N难以近身分毫。\n";
	}
}

/**
 * @brief 特殊招式文件路径
 */
string perform_action_file(string action)
{
	return __DIR__"xuanming-sword/" + action;
}

/**
 * @brief 技能难度等级
 */
int difficult_level()
{
	return 1000;
}

/**
 * @brief 返回玄命剑典的详细描述信息
 * @return string 包含技能介绍、学习要求、特殊招式详细说明的字符串
 * @details 提供玄命剑典的完整技能说明，包括所有特殊招式的具体伤害计算公式和双重意境机制
 */
string query_description()
{
    string msg;

    msg = HIY "【玄命剑典】" ZJBR NOR;
    msg += WHT "融合玄铁剑法之刚猛与独孤九剑之灵动而成的绝世剑典，刚柔并济，威力无穷。" ZJBR;
    msg += WHT "此剑法既有玄铁重剑的大开大合，又有独孤九剑的变化无穷，实为剑中极品。" ZJBR ZJBR;

    msg += HIY "〖演练要求〗" ZJBR NOR;
    msg += "  玄铁剑法等级不低于 " HIY "700" NOR " 级。" ZJBR;
    msg += "  独孤九剑等级不低于 " HIY "700" NOR " 级。" ZJBR;
    msg += "  先天悟性不低于 " HIM "35" NOR " 点。" ZJBR;
    msg += "  先天根骨不低于 " HIR "30" NOR " 点。" ZJBR;
    msg += "  最大内力不低于 " HIB "100000" NOR " 点。" ZJBR;
    msg += "  内功等级不低于 " HIY "700" NOR " 级。" ZJBR;
    msg += "  基本剑法等级不低于 " HIY "700" NOR " 级。" ZJBR;

     msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  剑法 (sword)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须装备剑类武器。" ZJBR;
    msg += "  气血不低于 " HIR "150" NOR " 点。" ZJBR;
    msg += "  内力不低于 " HIB "(玄命剑典等级 / 2 + 100)" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "120" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "(玄命剑典等级 / 2 + 100)" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  激发剑法时，被动增加一次攻击机会（连击）。" ZJBR;
    msg += "  普通攻击命中时，根据等级有不同几率（random(玄命剑典等级)）触发特效：" ZJBR;
    msg += "    - 100-199级：造成 (伤害奖励 / 3) 的额外气血伤害。" ZJBR;
    msg += "    - 200-299级：造成 (伤害奖励 / 2) 的气血伤害并减少对方内力。" ZJBR;
    msg += "    - 300级以上：造成 (伤害奖励) 的大量气血伤害。" ZJBR;

    msg += "  防御特效（180级以上，激发招架时触发）：" ZJBR;
    msg += "    - 触发判定：(攻击方内功*12 + 最大内力) vs (防御方内功*12 + 最大内力)" ZJBR;
    msg += "    - 成功时减少66%受到的伤害。" ZJBR;
    msg += "    - 消耗内力：受到伤害 / 3（最多150点）" ZJBR ZJBR;

    msg += HIY "〖特殊招式详解〗" ZJBR NOR;

    msg += HIC "  玄命剑意 (yi)  【刚柔并济型单体攻击】" ZJBR NOR;
    msg += "    " HIY "使用要求：" NOR ZJBR;
    msg += "      玄命剑典技能基本等级 " HIY "100" NOR " 级 | 基本内功基本等级 " HIY "120" NOR " 级 | 当前内力 " HIB "400" NOR " 点" ZJBR;
    msg += "      必须持有剑类武器 | 激发剑法为玄命剑典" ZJBR;
    msg += "    " HIY "伤害机制：" NOR ZJBR;
    msg += "      " HIC "攻击类型：" NOR "单体高爆发攻击，融合两种剑法精髓。" ZJBR;
    msg += "      " HIC "攻击力计算：" NOR "激发剑法等级 + 激发内功等级" ZJBR;
    msg += "      " HIC "防御力计算：" NOR "目标激发招架等级 + 目标激发内功等级" ZJBR;
    msg += "      " HIC "基础伤害：" NOR "攻击力 * 2 + 随机(攻击力)" ZJBR;
    msg += "      " HIC "PVE加成：" NOR "对NPC时攻击力提升25%。" ZJBR;
    msg += "      " HIC "双重意境效果：" NOR ZJBR;
    msg += "        ·苍松之劲：伤害 += 苍松等级 * 激发剑法等级 / 3" ZJBR;
    msg += "        ·黯然隐雾：伤害 += 黯然等级 * 伤害 / 10，致命一击几率 = 黯然等级 * 3%（触发时额外+50%伤害）" ZJBR;
    msg += "      " HIC "伤害类型：" NOR "普通do_damage单招伤害，伤害系数380%" ZJBR;
    msg += "    " HIY "消耗代价：" NOR "内力 " HIB "250" NOR " 点 | 自身忙乱 " HIR "1" NOR " 秒" ZJBR ZJBR;

    msg += HIC "  破势连环 (lian)  【控制型连击攻击】" ZJBR NOR;
    msg += "    " HIY "使用要求：" NOR ZJBR;
    msg += "      玄命剑典技能基本等级 " HIY "120" NOR " 级 | 基本内功基本等级 " HIY "150" NOR " 级 | 当前内力 " HIB "500" NOR " 点" ZJBR;
    msg += "      必须持有剑类武器 | 激发剑法为玄命剑典" ZJBR;
    msg += "    " HIY "伤害机制：" NOR ZJBR;
    msg += "      " HIC "攻击特性：" NOR "多段连击配合强力控制效果。" ZJBR;
    msg += "      " HIC "攻击力计算：" NOR "激发剑法等级" ZJBR;
    msg += "      " HIC "防御力计算：" NOR "目标激发轻功等级" ZJBR;
    msg += "      " HIC "忙乱时间：" NOR "基础(激发剑法等级/40 + 2)秒，双重意境可延长控制时间" ZJBR;
    msg += "        ·苍松之劲：忙乱时间 += 苍松等级 / 5，忙乱上限 +5" ZJBR;
    msg += "        ·黯然隐雾：忙乱时间 += 黯然等级 / 8，忙乱上限 +3" ZJBR;
    msg += "      " HIC "连击次数：" NOR "使用COMBAT_D->query_base_attack_number()标准连击数函数" ZJBR;
    msg += "      " HIC "PVE加成：" NOR "对NPC时连击次数 +2。" ZJBR;
    msg += "    " HIY "消耗代价：" NOR "内力 " HIB "350" NOR " 点 | 自身忙乱 " HIR "2" NOR " 秒" ZJBR ZJBR;

    msg += HIC "  重剑破空 (kong)  【终极奥义多段攻击】" ZJBR NOR;
    msg += "    " HIY "使用要求：" NOR ZJBR;
    msg += "      玄命剑典技能基本等级 " HIY "200" NOR " 级 | 基本内功基本等级 " HIY "220" NOR " 级 | 当前内力 " HIB "1200" NOR " 点" ZJBR;
    msg += "      必须持有剑类武器 | 激发剑法为玄命剑典" ZJBR;
    msg += "    " HIY "三阶段攻击机制：" NOR ZJBR;
    msg += "      " HIC "第一阶段 - 兵器击落：" NOR ZJBR;
    msg += "        ·攻击力计算：激发剑法等级 + 武学修养基本等级" ZJBR;
    msg += "        ·防御力计算：目标激发招架等级" ZJBR;
    msg += "        ·特殊克制：辟邪/葵花系攻击力+20%，六脉系攻击力-20%" ZJBR;
    msg += "        ·重剑加成：武器重量>10000时，攻击力+=(重量-10000)/80" ZJBR;
    msg += "        ·击落判定：(通用命中公式 && 随机(4)==1) 或 (攻击力/2 > 防御力)" ZJBR;
    msg += "      " HIC "第二阶段 - 主伤害攻击：" NOR ZJBR;
