	"action": "$N神色凝重，剑法忽然变得飘忽不定，一式「" HIC "独孤玄冥" NOR "」，似有招似无招，$w化作漫天剑影笼罩$n",
	"force" : 480,
	"attack": 190,
	"dodge" : 120,
	"parry" : 140,
	"damage": 220,
	"damage_type": "刺伤"
