    msg += "        ·重剑加成：武器重量>10000时，伤害+=(重量-10000)/60" ZJBR;
    msg += "        ·双重意境：苍松之劲+等级*激发剑法等级/3，黯然隐雾+等级*伤害/10" ZJBR;
    msg += "        ·致命一击：黯然隐雾3%几率触发额外80%伤害+忙乱2秒" ZJBR;
    msg += "        ·伤害类型：普通do_damage单招伤害，系数(350+玄命剑典技能基本等级/8)%" ZJBR;
    msg += "        ·PVE加成：对NPC时攻击力+50%，伤害+50%" ZJBR;
    msg += "        ·额外攻击：2/3几率触发第二次攻击，伤害为主伤害的50%" ZJBR;
    msg += "      " HIC "第三阶段 - 斩杀判定：" NOR ZJBR;
    msg += "        ·条件：目标当前气血<最大气血10%" ZJBR;
    msg += "        ·效果：直接秒杀目标" ZJBR;
    msg += "    " HIY "消耗代价：" NOR ZJBR;
    msg += "      击落阶段：内力 " HIB "300" NOR " 点" ZJBR;
    msg += "      命中主攻击：额外内力 " HIB "700" NOR " 点，自身忙乱 " HIR "2" NOR " 秒" ZJBR;
    msg += "      未命中主攻击：额外内力 " HIB "600" NOR " 点，自身忙乱 " HIR "3" NOR " 秒" ZJBR ZJBR;

    msg += HIC "  乱海狂涛 (tao)  【终极奥义真实伤害】" ZJBR NOR;
    msg += "    " HIY "使用要求：" NOR ZJBR;
    msg += "      玄命剑典技能基本等级 " HIY "280" NOR " 级 | 基本内功基本等级 " HIY "280" NOR " 级 | 武学修养基本等级 " HIY "150" NOR " 级" ZJBR;
    msg += "      最大内力 " HIB "4000" NOR " 点 | 当前内力 " HIB "800" NOR " 点" ZJBR;
    msg += "      必须持有剑类武器 | 激发剑法为玄命剑典" ZJBR;
    msg += "    " HIY "四阶段复合攻击机制：" NOR ZJBR;
    msg += "      " HIC "第一阶段 - 武学修养判定：" NOR ZJBR;
    msg += "        ·攻击加成：(自身武学修养基本等级-目标武学修养基本等级)/3，上限50点" ZJBR;
    msg += "        ·效果分级：<-10无效果，<30镇定应对，≥30眼前剑网密布" ZJBR;
    msg += "      " HIC "第二阶段 - 连击攻击：" NOR ZJBR;
    msg += "        ·连击次数：使用COMBAT_D->query_base_attack_number()标准连击数函数" ZJBR;
    msg += "        ·攻击加成：临时添加武学修养计算的攻击加成" ZJBR;
    msg += "      " HIC "第三阶段 - 真实伤害判定：" NOR ZJBR;
    msg += "        ·攻击力计算：(激发剑法等级+激发内功等级)/2" ZJBR;
    msg += "        ·防御力计算：目标激发轻功等级" ZJBR;
    msg += "        ·基础伤害：激发剑法等级*2+激发内功等级*2+加力+伤害/500*后天膂力+最大内力/20" ZJBR;
    msg += "        ·双重意境强化：" ZJBR;
    msg += "          苍松之劲：伤害+=苍松等级*伤害/8，攻击力+=苍松等级*3" ZJBR;
    msg += "          黯然隐雾：伤害+=黯然等级*伤害/10" ZJBR;
    msg += "        ·奥义加成：伤害+=伤害/2（终极奥义50%基础提升）" ZJBR;
    msg += "        ·致命一击：黯然隐雾等级*3%几率，触发时伤害+80%，目标忙乱2秒" ZJBR;
    msg += "        ·真实伤害：COMBAT_D->real_damage()，最终伤害=计算伤害*75%" ZJBR;
    msg += "      " HIC "第四阶段 - 多重附加判定：" NOR ZJBR;
    msg += "        ·智力判定：自身先天悟性>随机(目标先天悟性*2)时，目标忙乱3秒" ZJBR;
    msg += "        ·力量判定：自身后天膂力>随机(目标后天膂力*2)时，削减目标内力(目标最大内力/15)" ZJBR;
    msg += "    " HIY "消耗代价：" NOR "内力 " HIB "600" NOR " 点 | 自身忙乱 2+随机(3) 秒" ZJBR ZJBR;

    return msg;
}
