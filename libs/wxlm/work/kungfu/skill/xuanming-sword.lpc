// xuanming-sword.c 玄命剑典

inherit SKILL;

/**
 * @brief 主技能标识函数
 * @return string 主技能名称
 * @details 标识此技能为主技能
 */
string main_skill() { return "xuanming-sword"; }

/**
 * @brief 定义子技能映射
 * @details 玄铁剑法和独孤九剑需要达到一定等级才能融合
 */
mapping sub_skills = ([
	"xuantie-jian"  : 700,    // 玄铁剑法需要200级
	"lonely-sword"  : 700,    // 独孤九剑需要200级
]);

