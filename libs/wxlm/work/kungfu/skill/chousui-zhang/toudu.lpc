// 弹射碧焰



inherit F_SSERVER;

string query_name() { return "投放毒药"; }

int perform(object me, object target)
{
	object du;
	int damage;
	int ap;
	int lvl;

	if (! playerp(target) &&!wizardp(me))
		return notify_fail("你只能对江湖高手投放毒药。\n");

	if ((int)me->query_skill("chousui-zhang", 1) < 150)
		return notify_fail("你的炼髓掌火候不够。\n");

	if ((int)me->query_skill("poison", 1) < 180)
		return notify_fail("你的基本毒技火候不够。\n");

	if ((int)me->query_skill("huagong-dafa", 1) < 150)
		return notify_fail("你的化灵大法火候不够。\n");

	if ((int)me->query("max_neili") < 1500)
		return notify_fail("你的内力修为不足，无法用内力弹射碧焰。\n");

	if ((int)me->query("neili") < 800)
		return notify_fail("你现在内息不足，无法用内力弹射碧焰。\n");

	//非战斗地区无法投毒
	if (!wizardp(me) && !environment(me)->query("no_fight"))
		return notify_fail("非战斗地区无法投毒。\n");


	if (! objectp(du = me->query_temp("handing")) && userp(me))
	{

		du = new("/u/new_du.lpc");
		du->set_amount(1);
		du->set("poison/level", me->query_skill("force") / 2);
		me->add("neili", -100);
		message_combatd(HIW "$N" HIW "运起寒冰真气，周身顿时被一层薄薄的白雾笼罩。只见$N" HIW "从身上抠下一些臭气难闻的毒丸，放在掌心，随着内力的注入，泥丸逐渐变得晶莹剔透，散发出阵阵寒气。" NOR "\n", me);

	}

	if (objectp(du) && ! mapp(du->query("poison")))
		return notify_fail(du->name() + "又不是毒药，无法投放？\n");

	if (! living(target))
		return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

	// 如果对方投毒时间孩子还未结束，那么不能再次投毒
	if (target->query_temp("last_toudu_time") > time())
		return notify_fail("对方刚刚才被你投放过毒药，还是等一会儿再投吧。\n");

	//对方经验低于450w的不投毒
	if (target->query("combat_exp") < 4500000)
		return notify_fail("对方经验太低，不值得你浪费毒药。\n");

	me->start_busy(2);
	me->add("neili", -300);

	lvl = me->query_skill("chousui-zhang", 1);
	// 如果是巫师 伤害*10
	if (wizardp(me))
		lvl = lvl * 10;

	damage = 500 + random(lvl);
	damage += COMBAT_D->get_skill_aoyi_level(me,"天罡星辰") * 100;

	{
		ap = me->query_skill("poison", 1) / 2 +  me->query_skill("force");
		if (ap / 2 + random(ap) > target->query_skill("dodge"))
		{
			target->affect_by("fire_poison",
				       ([ "level" :lvl + random(lvl),
					  "id"    : me->query("id"),
					  "duration" : lvl / 20 + random(lvl / 5) ]));
			target->set_temp("last_toudu_time", lvl / 20 + random(lvl / 5)  + time());
			COMBAT_D->real_damage(me, target, damage);
			target->receive_damage("jing", damage / 2, me);
			if (random(100) > COMBAT_D->get_skill_aoyi_level(me,"天罡星辰") * 10)
				//概率显示公屏xx给xx投毒
				CHANNEL_D->do_channel(this_object(), "rumor", me->name() + "给" + target->name() + "投放了毒药!\n");
			
			// 告诉当前地图上的所有人，xxx感觉有点不太对劲，但说不上来
			tell_object(environment(me), target->name() + "感觉有点不太对劲，但说不上来。\n");

		}
	}

	if (objectp(du))
	{
		//如果是可叠加的毒药，那么数量减1否则销毁
		if (du->query_amount() > 1)
			du->add_amount(-1);
		else
			destruct(du);
	}

	return 1;
}
