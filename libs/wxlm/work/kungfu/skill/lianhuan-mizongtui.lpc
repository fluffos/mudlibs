int valid_enable(string usage) { return usage=="unarmed" ||  usage=="parry" ||  usage=="dodge"; } 

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("学习连环迷踪腿必须空手。\n");

	if ((int)me->query_skill("force") < 140)
		return notify_fail("你的内功火候不够，无法学连环迷踪腿。\n");

	if ((int)me->query("max_neili") < 800)
		return notify_fail("你的内力太弱，无法练连环迷踪腿。\n");

	if ((int)me->query_skill("unarmed", 1) < (int)me->query_skill("lianhuan-mizongtui", 1))
		return notify_fail("你的基本拳脚水平有限，无法领会更高深的连环迷踪腿。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
	    if(level >= action[i]["lvl"])
	       return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int)me->query_skill("lianhuan-mizongtui", 1);
	for(i = sizeof(action); i > 0; i--)
	    if(level > action[i-1]["lvl"])
		return action[NewRandom(i, 20, level/5)];
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 100)
	       return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 80)
	       return notify_fail("你的内力不够练连环迷踪腿。\n");

	me->receive_damage("qi", 80);
	me->add("neili", -60);

	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"lianhuan-mizongtui/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【连环迷踪腿】" ZJBR NOR;
    msg += WHT "一门极为高深的腿法，其特点在于步法迷踪不定，出腿连环迅猛，虚实结合，令对手难以捉摸。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  必须空手。" ZJBR;
    msg += "  基本内功 (`force`) 等级不低于 " HIY "140" NOR " 级。" ZJBR;
    msg += "  最大内力 (`max_neili`) 不低于 " HIB "800" NOR " 点。" ZJBR;
    msg += "  基本拳脚 (`unarmed`) 等级需大于等于连环迷踪腿等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  拳脚 (`unarmed`)。" ZJBR;
    msg += "  招架 (`parry`)。" ZJBR;
    msg += "  轻功 (`dodge`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血 (`qi`) 不低于 " HIR "100" NOR " 点。" ZJBR;
    msg += "  内力 (`neili`) 不低于 " HIB "80" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血 " HIR "80" NOR " 点，内力 " HIB "60" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  " HIM "轻功闪避 (query_dodge_msg)" NOR ":" ZJBR;
    msg += "    效果：作为轻功激发时，提供独特的闪避描述信息。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (Perform)〗" ZJBR NOR;
    msg += "  （暂未发现明确定义的特殊招式 perform 文件，或未在本修订范围内提供）" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 练习和使用连环迷踪腿必须空手。" ZJBR;
    msg += "2. 此技能可以同时激发为拳脚、招架和轻功，具有良好的通用性。" ZJBR;
    msg += "3. 高等级的连环迷踪腿在闪避和攻击方面都有不俗的表现。" ZJBR;

    return msg;
}
