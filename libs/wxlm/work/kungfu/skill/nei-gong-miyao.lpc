inherit SKILL;
// string type() { return "knowledge"; }

mixed query_fuzhu()  { return "force";}

int valid_learn(object me)
{

        return 1;
}

int difficult_level()
{
        return 200;
}

string query_description()
{
    string msg;

    msg = HIY "【内功秘要】" ZJBR NOR;
    msg += "记载内功修炼关键要点的知识性技能，掌握后可能有助于提升内功类武学的效果或修炼速度。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  该技能通常没有特殊学习限制。" ZJBR ZJBR; // valid_learn 返回 1

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  该技能无法被激发为任何常规战斗类型。" ZJBR ZJBR; // 无 valid_enable

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  该技能通常只能通过学习 (`learn`) 或研究提升，无法练习 (`practice`)。" ZJBR ZJBR; // 无 practice_skill

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // query_fuzhu
    msg += "  作为内功 (`force`) 类技能的 " HIC "辅助技能"  ZJBR;
    msg += "  其具体效果（如是否提升内功威力、修炼效率等）取决于游戏系统的具体实现，该文件未明确定义。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform/exert
    msg += "  该技能没有定义特殊的主动招式。" ZJBR;

    return msg;
}
