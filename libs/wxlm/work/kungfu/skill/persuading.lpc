// persuading.c

inherit SKILL;

string type() { return "knowledge"; }

void skill_improved(object me)
{}

int valid_learn(object me)
{
	return notify_fail("渡世济人要在实践中提高。\n");
}

string query_description()
{
    string msg;

    msg = HIY "【渡世济人】" ZJBR NOR;
    msg += "一项知识类技能，代表着说服、感化他人的能力。" ZJBR;
    msg += "该技能的提升主要依赖于在游戏世界中的实际行为与交互，而非简单的学习或练习。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  无法通过常规学习 (`learn`) 提升，需要在实践中提高。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  知识类技能，无法被激发为战斗或其他常规类型。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  无法练习。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  具体效果（如影响 NPC 态度、解锁特定对话或任务）取决于游戏系统的具体实现，该文件未明确定义。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR;

    return msg;
}
