// 玄武护体


#include <combat.h>

inherit F_SSERVER;

string query_name() { return "玄武护体"; }
// string *pfm_type() { return ({ "force", }); }

int perform(object me, object target)
{
    string msg;
    int skill;

    if ((int)me->query_skill("xuanwu-zhenshen", 1) < 100)
        return notify_fail("你的玄武真身不够娴熟，不会使用「玄武护体」。\n");

    if ((int)me->query_skill("sixiang-shengong", 1) < 100)
        return notify_fail("你的四象神功不够高，不能使用「玄武护体」。\n");

    if ((int)me->query("neili") < 200)
        return notify_fail("你的真气不够，无法使用「玄武护体」。\n");

    if (me->query_skill_mapped("parry") != "xuanwu-zhenshen")
        return notify_fail("你没有激发玄武真身，无法使用「玄武护体」。\n");

    if (me->query_temp("xuanwu_huti"))
        return notify_fail("你已经在使用「玄武护体」了。\n");

    skill = me->query_skill("xuanwu-zhenshen", 1);

    msg = HIB "$N" HIB "运转玄武真身，周身真气流转，形成一道无形的防护罩！\n" NOR;

    message_combatd(msg, me);

    me->add_temp("apply/armor", skill / 2);
    me->set_temp("xuanwu_huti", 1);
    me->add("neili", -100);

    me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill / 2 :), skill);

    if (me->is_fighting())
        me->start_busy(2);

    return 1;
}

void remove_effect(object me, int amount)
{
    if (me->query_temp("xuanwu_huti"))
    {
        me->add_temp("apply/armor", -amount);
        me->delete_temp("xuanwu_huti");
        tell_object(me, "你的「玄武护体」运行完毕，将内力收回丹田。\n");
    }
}
