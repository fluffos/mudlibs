inherit SKILL;

string query_description()
{
    string msg;

    msg = HIY "【道听途说】" ZJBR NOR;
    msg += "一项基础的生活技能，用于打听江湖传闻和消息。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  无法练习。" ZJBR ZJBR;

    msg += HIY "〖特殊效果〗" ZJBR NOR;
    msg += "  提升此技能等级可能有助于从NPC处获取更多信息。" ZJBR ZJBR; // 推测效果，代码未明确

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR;

    return msg;
}
