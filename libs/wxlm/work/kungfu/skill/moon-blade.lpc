int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

int valid_learn(object me)
{
        object weapon;

        if ((int)me->query("con") < 28)
                return notify_fail("你研究了半天，只觉得根骨有些差，始终无法理解其中的真谛。\n");

        if ((int)me->query("int") < 15)
                return notify_fail("你研究了半天，只觉得悟性有些差，始终无法理解其中的真谛。\n");

        if ((int)me->query("str") < 30)
                return notify_fail("你研究了半天，感觉膂力有些低，始终无法随意施展。\n");

        if ((int)me->query("dex") < 20)
                return notify_fail("你研究了半天，只觉依自己的身法灵动性，根本无法修习这门武功。\n");

        if ((int)me->query("max_neili") < 3000)
                return notify_fail("你的内力不够。\n");

        if ((int)me->query_skill("force") < 500)
                return notify_fail("你的内功火候太浅。\n");

        weapon = me->query_temp("weapon");
        if (me->query_skill("moon-blade", 1) < 500 &&
            (! objectp(weapon) || weapon->query("id") != "moon blade"))
                return notify_fail("你的圆月刀法大成之前必须有圆月弯刀配合才能学习。\n");

        return 1;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
        int i, level;
        level   = (int) me->query_skill("moon-blade", 1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
        object weapon;

        return notify_fail("圆月刀法博大精深，无法靠着普通的练习提升。\n");
        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "blade")
                return notify_fail("你使用的武器不对。\n");

        if ((int)me->query("qi") < 70)
                return notify_fail("你的体力不够，练不了圆月弯刀。\n");

        if ((int)me->query("neili") < 70)
                return notify_fail("你的内力不够，练不了圆月弯刀。\n");

        if (! present("moon blade", me) && me->query_skill("moon-blade") < 400)
                return notify_fail("你的圆月刀法大成之前必须有圆月弯刀配合才能练习。\n");

        me->receive_damage("qi", 55);
        me->add("neili", -61);
        return 1;
}

mixed hit_ob(object me, object victim, int damage)
{
        mixed result;
        if (damage < 100) return 0;

        if (random(damage) > victim->query_str() / 10)
        {
                result = ([ "damage" : damage ]);
                result += ([ "msg" : HIW "$N" HIW "仰天一啸，刀劲迸发，满天具是雪亮的刀光，犹如满月的月光般美丽，\n"
                                     "但却让人感到落入森罗地狱般，全身止不住的战抖，\n"
                                     HIR "霎时一股冰寒的刀气掠过$n" HIR "全身，$n" HIR "全身顿时鲜血淋漓，摇摇欲倒。\n" NOR ]);

                return result;
        }
}

string perform_action_file(string action)
{
        return __DIR__"moon-blade/" + action;
}

int difficult_level()
{
	return 500;
}

string query_description()
{
    string msg;

    msg = HIY "【圆月弯刀】" ZJBR NOR;
    msg += WHT "魔教镇教神功之一，刀法取圆月之意，招式圆转如意，变化莫测。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  先天根骨 (`con`) ≥ " HIY "28" NOR " 点。" ZJBR;
    msg += "  先天悟性 (`int`) ≥ " HIY "15" NOR " 点。" ZJBR;
    msg += "  先天臂力 (`str`) ≥ " HIY "30" NOR " 点。" ZJBR;
    msg += "  先天身法 (`dex`) ≥ " HIY "20" NOR " 点。" ZJBR;
    msg += "  最大内力 (`max_neili`) ≥ " HIB "3000" NOR " 点。" ZJBR;
    msg += "  基本内功 (`force`) 等级 ≥ " HIY "500" NOR " 级。" ZJBR;
    msg += "  若圆月弯刀等级 < 500 级，必须装备 圆月弯刀 (`moon blade`) 才能学习。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  刀法 (`blade`)。" ZJBR;
    msg += "  招架 (`parry`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  " HIR "无法练习" NOR "，只能通过学习 (`learn`) 或其他方式提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  攻击命中时，若本次伤害 > 100，且 随机(伤害值) > 目标先天臂力 / 10，则：" ZJBR;
    msg += "    追加 [(伤害值)] 点额外伤害。" ZJBR;
    msg += "    附带特殊攻击描述，造成流血效果。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;

    msg += HIC "  万劫一瞬斩 (dao)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      仅限魔教弟子。" ZJBR;
    msg += "      圆月弯刀等级 ≥ " HIY "150" NOR " 级。" ZJBR;
    msg += "      基本内功 (`force`) 等级 ≥ " HIY "150" NOR " 级。" ZJBR;
    msg += "      最大内力 (`max_neili`) ≥ " HIB "4000" NOR " 点。" ZJBR;
    msg += "      当前内力 (`neili`) ≥ " HIB "1000" NOR " 点。" ZJBR;
    msg += "      必须装备刀类武器，且激发刀法为圆月弯刀。" ZJBR;
    msg += "      需先触发【神刀化血】（`huaxue_pfm`），否则无法施展。" ZJBR;
    msg += "      仅能对战斗中的目标使用。" ZJBR;
    msg += "    判定流程：" ZJBR;
    msg += "      首段：若目标持有武器，先判定能否使其脱手（以自身刀法对比目标招架，命中则目标武器脱手，否则无效）。" ZJBR;
    msg += "      中段：以自身刀法激发等级对比目标轻功激发等级，命中则造成高额伤害，且根据【魔血染刀】奥义和自身伤势提升伤害。" ZJBR;
    msg += "        - 伤害基础值=(刀法激发等级 + 内功激发等级 + 最大内力的10% + 加力值)x2" ZJBR;
    msg += "        - 魔血染刀奥义每级提升10%伤害。" ZJBR;
    msg += "        - 神刀化血期间，伤势越重伤害越高（按气血损失百分比提升，没损失1%气血提升1%最终伤害）。" ZJBR;
    msg += "        - NPC目标命中率和伤害均提升（命中×1.5，伤害×1.5）。" ZJBR;
    msg += "      末段：再次以刀法对比目标招架，命中则大幅提升自身攻击与伤害，连续发动多次攻击。（连招类型）" ZJBR;
    msg += "        - 每次攻击均有高额伤害加成。" ZJBR;
    msg += "    特殊效果：" ZJBR;
    msg += "      命中后目标进入【虚弱】状态，持续5秒，期间防御力下降。" ZJBR;
    msg += "      施展后自身进入短暂忙乱状态（3~6秒）。" ZJBR;
    msg += "      附属效果1：招式施展后：若目标被击败，则自身气血全满（恢复所有气血）。" ZJBR;
    msg += "      附属效果2：招式施展后：根据根本法魔血染刀等级，每级有1%概率自身气血全满（恢复所有气血）。" ZJBR;

    msg += "    消耗与代价：" ZJBR;
    msg += "      总计消耗内力 " HIB "2000+" NOR " 点（随发动次数浮动）。" ZJBR;
    msg += "      施展后额外扣除 " HIB "400~1000" NOR " 点内力。" ZJBR;
    msg += "      期间若未击败目标，则无气血恢复。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      以极致刀意爆发，刀气如万劫齐至，连续斩击目标，若目标被击败则自身气血全满。" ZJBR;
    msg += "      该招式为魔教圆月弯刀的终极绝学，极具爆发力与收割能力。" ZJBR ZJBR;

    msg += HIC "  小楼一夜听春雨 (ting)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      圆月弯刀等级 ≥ " HIY "200" NOR " 级。" ZJBR;
    msg += "      基本内功 (`force`) 等级 ≥ " HIY "160" NOR " 级。" ZJBR;
    msg += "      当前内力 (`neili`) ≥ " HIB "200" NOR " 点。" ZJBR;
    msg += "      激发刀法为圆月弯刀。" ZJBR;
    msg += "      必须装备刀类武器。" ZJBR;
    msg += "      仅能对战斗中的目标使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      施展绝世刀法，刀光如月，妖异迷人。" ZJBR;
    msg += "      命中判定：自身刀法等级 对比 目标轻功等级。" ZJBR;
    msg += "      若命中且自身刀法激发等级 > 目标轻功激发等级以及招架等级 且目标不是武圣（如果你同样是武圣则该效果保留）：" ZJBR;
    msg += "        造成真实伤害：刀法等级 × 5。" ZJBR;
    msg += "        消耗内力 " HIB "100" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      若命中但不满足秒杀条件：" ZJBR;
    msg += "        造成普通伤害：(刀法等级 + 内功等级) × 5。" ZJBR;
    msg += "        若拥有【魔血染刀】奥义，每级提升 5% 伤害。" ZJBR;
    msg += "        消耗内力 " HIB "600" NOR " 点，自身忙乱 " HIR "4" NOR " 秒。" ZJBR;
    msg += "      若未命中：" ZJBR;
    msg += "        消耗内力 " HIB "300" NOR " 点，自身忙乱 " HIR "5" NOR " 秒。" ZJBR;
    msg += "    特殊效果：" ZJBR;
    msg += "      此招式具有秒杀潜力，对内功较弱的目标威胁极大。" ZJBR;
    msg += "      刀光妖异，具有强烈的视觉震撼效果。" ZJBR ZJBR;

    msg += HIC "  当时明月在 (yue)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      圆月弯刀等级 ≥ " HIY "120" NOR " 级。" ZJBR;
    msg += "      基本内功 (`force`) 等级 ≥ " HIY "160" NOR " 级。" ZJBR;
    msg += "      当前内力 (`neili`) ≥ " HIB "200" NOR " 点。" ZJBR;
    msg += "      激发刀法为圆月弯刀。" ZJBR;
    msg += "      必须装备刀类武器。" ZJBR;
    msg += "      仅能对战斗中的目标使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      连环七刀，刀刀针对目标身形变化，朴实古拙中蕴含明月当空之意。" ZJBR;
    msg += "      命中判定：(自身内功等级 + 刀法等级) 对比 (目标轻功等级 + 内功等级)。" ZJBR;
    msg += "      若命中：" ZJBR;
    msg += "        将基础值：(刀法等级 + 内功等级) × 2 x 1.5的交由单招接口处理伤害。" ZJBR;
    msg += "        消耗内力 " HIB "150" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "        若二次判定成功，目标额外忙乱 (攻击力 / 100 + 3) 秒。" ZJBR;
    msg += "      若未命中：" ZJBR;
    msg += "        消耗内力 " HIB "50" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;
    msg += "    特殊效果：" ZJBR;
    msg += "      刀气横空，刀光烁闪，具有控制效果。" ZJBR;
    msg += "      每刀均能令对手全神应付，展现圆月弯刀的精妙。" ZJBR ZJBR;

    return msg;
}
