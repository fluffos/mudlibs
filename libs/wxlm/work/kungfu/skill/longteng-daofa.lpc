// This program is a part of NITAN MudLIB
// longteng-daofa.c (龙腾刀法)
inherit SKILL;

mapping *action = ({
([      "action" : "$N身行晃动,猛地一招[龙战四方]砍向$n的$l！",
        "force"  : 120,
        "attack" : 40,
        "dodge"  : 30,
        "parry"  : 15,
        "lvl"    : 0,
        "damage" : 40,
        "damage_type" : "割伤",
        "skill_name"  : "龙战四方",
]),
([      "action" : "$N身行猛地向前一冲,脚下虚晃一扫,举刀一招[龙腾四海]向$n的$l砍去！",
        "force"  : 150,
        "attack" : 45,
        "dodge"  : 40,
        "parry"  : 20,
        "lvl"    : 40,
        "damage" : 60,
        "damage_type" : "割伤",
        "skill_name"  : "龙腾四海",
]),
([      "action" : "$N腾空越起,挥刀凌空砍下,正是一招[索命一刀]！",
        "force"  : 180,
        "attack" : 51,
        "dodge"  : 45,
        "parry"  : 25,
        "lvl"    : 60,
        "damage" : 80,
        "damage_type" : "割伤",
        "skill_name"  : "索命一刀",
]),
([      "action" : "$N大喝一声,一招[龙飞九天]连环朝$n的$l砍去！",
        "force"  : 220,
        "attack" : 55,
        "dodge"  : 50,
        "parry"  : 30,
        "lvl"    : 80,
        "damage" : 95,
        "damage_type" : "割伤",
        "skill_name"  : "龙飞九天",
]),
});

int valid_enable(string usage){ return usage == "blade" || usage == "parry";}

int valid_learn(object me)
{     
        if ((int)me->query("max_neili") < 800)
                return notify_fail("你的内力不够。\n");

        if ((int)me->query_skill("force") < 150)
                return notify_fail("你的内功火候太浅。\n");

        if ((int)me->query_skill("blade", 1) < 120)
                return notify_fail("你的基本刀法不够，难以修炼龙腾刀法。\n");

        if ((int)me->query_skill("blade", 1) < (int)me->query_skill("longteng-daofa", 1))
                return notify_fail("你的基本刀法水平有限，无法领会更高深的龙腾刀法。\n");

        return 1;
}

string query_skill_name(int level)
{
        int i;
        for (i = sizeof(action) - 1; i >= 0; i--)
                if (level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

int practice_skill(object me)
{
        object weapon;

        if (! objectp(weapon = me->query_temp("weapon"))|| (string)weapon->query("skill_type") != "blade")
                return notify_fail("你使用的武器不对。\n");

        if ((int)me->query("qi") < 80)
                return notify_fail("你的体力不够，练不了龙腾刀法。\n");

        if ((int)me->query("neili") < 120)
                return notify_fail("你的内力不够，练不了龙腾刀法。\n");

        me->receive_damage("qi", 64);
        me->add("neili", -84);
        return 1;
}

mapping query_action(object me, object weapon)
{
        int i, level;
        level = (int) me->query_skill("longteng-daofa", 1);
        for (i = sizeof(action); i > 0; i--)
                if (level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];
}

string perform_action_file(string action)
{
        return __DIR__"longteng-daofa/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【龙腾刀法】" ZJBR NOR;
    msg += WHT "此刀法大开大阖，气势磅礴，招式之间隐有龙腾之势，威力惊人。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力 (`max_neili`) 不低于 " HIB "800" NOR " 点。" ZJBR;
    msg += "  基本内功 (`force`) 等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "  基本刀法 (`blade`) 等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "  基本刀法 (`blade`) 等级需大于等于龙腾刀法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  刀法 (`blade`)。" ZJBR;
    msg += "  招架 (`parry`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须装备刀类武器。" ZJBR;
    msg += "  气血 (`qi`) 不低于 " HIR "80" NOR " 点。" ZJBR;
    msg += "  内力 (`neili`) 不低于 " HIB "120" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血 " HIR "64" NOR " 点，内力 " HIB "84" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;

    msg += HIC "  龙腾九天 (teng)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      龙腾刀法 (`longteng-daofa`) 等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      基本内功 (`force`) 等级不低于 " HIY "180" NOR " 级。" ZJBR;
    msg += "      当前内力 (`neili`) 不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "      必须装备刀类武器且激发为刀法。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：(自身刀法激发等级 / 2 + 随机(自身刀法激发等级)) 与 目标招架激发等级 进行比较。" ZJBR;
    msg += "      命中效果：对目标造成较大伤害，基础伤害约为 `龙腾刀法等级 + 随机(龙腾刀法等级 / 2)`，并附加等同于基础伤害三分之一的额外伤害。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 " HIB "200" NOR " 点，自身忙乱 " HIR "2-3" NOR " 秒。" ZJBR; // 随机忙乱
    msg += "      未命中：消耗内力 " HIB "100" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 练习和使用龙腾刀法必须装备刀类武器。" ZJBR;
    msg += "2. 该刀法威力依赖于基本刀法、龙腾刀法等级以及内功修为。" ZJBR;

    return msg;
}
