// cooking.c

inherit SKILL;

string type() { return "knowledge"; }

void skill_improved(object me)
{}

int valid_learn(object me)
{
    return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【烹饪技巧】" ZJBR NOR;
    msg += "一门生活技能，掌握后可以制作各种食物。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  无特殊要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable (知识技能)
    msg += "  知识（knowledge）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill (知识技能无练习)
    msg += "  无法练习，需要通过阅读相关书籍或实践提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // hit_ob, valid_damage, skill_improved etc.
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform/exert
    msg += "  无。" ZJBR;

    return msg;
}
