int valid_enable(string usage) { return usage == "whip" || usage == "parry"; }

int valid_learn(object me)
{
     object weapon;

     if (! objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "whip")
         return notify_fail("你必须先找一条鞭子才能练鞭法。\n");

     if ((int)me->query_skill("riyue-xinfa", 1) < 120)
         return notify_fail("你的内功心法火候太浅，不能学流水鞭法。\n");

     if ((int)me->query_skill("whip", 1) < 120)
         return notify_fail("你的基本鞭法火候不够。\n");

     if ((int)me->query("max_neili") < 500)
         return notify_fail("你的内力太低，无法学流水鞭法。\n");

     if ((int)me->query_skill("whip", 1) < (int)me->query_skill("liushui-bian", 1))
         return notify_fail("你的基本鞭法水平有限，无法领会更高深的流水鞭法。\n");

     return 1;
}

string query_skill_name(int level)
{
     int i;
     for(i = sizeof(action)-1; i >= 0; i--)
     if(level >= action[i]["lvl"])
            return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
     int i, level;
     level = (int) me->query_skill("liushui-bian", 1);
     for(i = sizeof(action); i > 0; i--)
         if(level > action[i-1]["lvl"])
              return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
     object weapon;

     if (! objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "whip")
         return notify_fail("你必须先找一条鞭子才能练鞭法。\n");

     if ((int)me->query("qi") < 110)
            return notify_fail("你的体力不够练流水鞭法。\n");

     if ((int)me->query("neili") < 115)
            return notify_fail("你的内力不够练流水鞭法。\n");

     me->receive_damage("qi", 12);
     me->add("neili", -18);
     return 1;
}

string perform_action_file(string action)
{
     return __DIR__"liushui-bian/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【流水鞭法】" ZJBR NOR;
    msg += WHT "日月神教的独特鞭法，招式灵动飘逸，如行云流水，连绵不绝，变幻莫测。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  必须装备鞭类武器。" ZJBR;
    msg += "  日月心法 (`riyue-xinfa`) 等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "  基本鞭法 (`whip`) 等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "  最大内力 (`max_neili`) 不低于 " HIB "500" NOR " 点。" ZJBR;
    msg += "  基本鞭法 (`whip`) 等级需大于等于流水鞭法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  鞭法 (`whip`)。" ZJBR;
    msg += "  招架 (`parry`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须装备鞭类武器。" ZJBR;
    msg += "  气血 (`qi`) 不低于 " HIR "110" NOR " 点。" ZJBR;
    msg += "  内力 (`neili`) 不低于 " HIB "115" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血 " HIR "12" NOR " 点，内力 " HIB "18" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;

    msg += HIC "  流星赶月 (liuxing)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      流水鞭法 (`liushui-bian`) 等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      日月心法 (`riyue-xinfa`) 等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      最大内力 (`max_neili`) 不低于 " HIB "2000" NOR " 点。" ZJBR;
    msg += "      当前内力 (`neili`) 不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "      必须装备鞭类武器且激发为鞭法。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：自身基本鞭法激发等级与目标招架激发等级进行随机比较 (`随机(自身鞭法激发) > 目标招架激发 / 2`)。" ZJBR;
    msg += "      命中效果：对目标造成较大伤害，基础伤害约为 `自身基本鞭法等级 + 随机(自身基本鞭法等级 / 2)`，并附加等同于基础伤害一半的额外伤害。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 " HIB "200" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：消耗内力 " HIB "100" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  天罗地网 (wang)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      流水鞭法 (`liushui-bian`) 等级不低于 " HIY "180" NOR " 级。" ZJBR;
    msg += "      日月心法 (`riyue-xinfa`) 等级不低于 " HIY "180" NOR " 级。" ZJBR;
    msg += "      最大内力 (`max_neili`) 不低于 " HIB "2500" NOR " 点。" ZJBR;
    msg += "      当前内力 (`neili`) 不低于 " HIB "400" NOR " 点。" ZJBR;
    msg += "      必须装备鞭类武器且激发为鞭法。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：自身基本鞭法激发等级与目标招架激发等级进行随机比较 (`随机(自身鞭法激发) > 目标招架激发 / 2`)。" ZJBR;
    msg += "      命中效果：对目标造成大量伤害，基础伤害约为 `流水鞭法等级 / 2 + 随机(流水鞭法等级 / 3)`，并附加等同于基础伤害的额外伤害。" ZJBR;
    msg += "      附加效果：若目标未处于忙乱状态，则会使其忙乱 `(流水鞭法等级 / 50 + 2)` 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 " HIB "300" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：消耗内力 " HIB "150" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 练习和使用流水鞭法必须装备鞭类武器。" ZJBR;
    msg += "2. 流水鞭法的威力依赖于基本鞭法、流水鞭法等级以及日月心法的支持。" ZJBR;
    msg += "3. 特殊招式消耗较大，需注意内力控制。" ZJBR;

    return msg;
}
