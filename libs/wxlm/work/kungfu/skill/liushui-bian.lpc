([      "action":"只见$N身形疾转，手腕轻抖，一式「天地双飞」，$w在身畔化作两道飞虹。",
        "force" :60,
        "dodge" :1,
        "attack":3,
        "damage":12,
        "lvl"   :0,
        "skill_name" :"天地双飞",
        "damage_type":"割伤"
]),
([      "action":"$N一式「荒烟平楚」，手中$w吞吐不定，仿佛一层轻烟薄雾飘上$n肩头，若即若离。",
        "force" :110,
        "dodge" :10,
        "attack":13,
        "damage":30,
        "lvl"   :10,
        "skill_name" :"荒烟平楚",
        "damage_type":"割伤"
]),
([      "action":"$N力贯$w，一招「芦花飘香」点点鞭影飘浮不定地点向$n的$l。",
        "force" :140,
        "dodge" :20,
        "attack":55,
        "damage":60,
