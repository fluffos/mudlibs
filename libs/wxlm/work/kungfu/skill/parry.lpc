// parry.c
// modified by Venus Oct.1997
inherit SKILL;

string *parry_msg = ({
    "只听见「锵」一声，被$p格开了。\n",
    "结果「当」地一声被$p挡开了。\n",
    "但是被$n用手中兵刃架开。\n",
    "但是$n身子一侧，用手中兵刃格开。\n",
});

string *unarmed_parry_msg = ({
    "但是被$p格开了。\n",
    "结果被$p挡开了。\n",
});

string query_parry_msg(object weapon)
{
    if( weapon )
	return parry_msg[random(sizeof(parry_msg))];
    else
	return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_description()
{
    string msg;

    msg = HIY "【基本招架】" ZJBR NOR;
    msg += "所有武功的基础防御技能，用于格挡或卸开对手的攻击。" ZJBR;
    msg += "其效果通常由激发的基本武功决定，此文件仅定义通用的招架提示信息。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  无需学习，所有角色天生拥有。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  招架 (parry)。通常需要激发一种具体的武功来获得实际招架效果。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  无法练习。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  基础招架本身不提供特效，实际效果依赖于激发的具体武功。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR;

    return msg;
}
 
