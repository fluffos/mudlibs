// yi.c 独孤剑意

#include <combat.h>

inherit F_SSERVER;

string query_name() { return "独孤"ZJBR"剑意"; }

int perform(object me, object target)
{
    string msg;
    int ap, dp, damage;

    if (! target) target = offensive_target(me);

    if (! target || ! me->is_fighting(target))
        return notify_fail("「独孤剑意」只能对战斗中的对手使用。\n");

    if (me->query_skill("lonely-sword", 1) < 80)
        return notify_fail("你的独孤九剑不够娴熟，无法施展「独孤剑意」。\n");

    if( !objectp(me->query_temp("weapon")) || me->query_temp("weapon")->query("skill_type") != "sword" )
        return notify_fail("你必须持剑才能使用「独孤剑意」！\n");

    if (me->query("neili") < 300)
        return notify_fail("你现在真气不足，无法使用「独孤剑意」。\n");

    msg = HIY "$N" HIY "凝神聚气，手中" + me->query_temp("weapon")->name() + HIY "微微一颤，剑锋直指$n，剑意如虹！\n" NOR;

    ap = me->query_skill("sword") + me->query_skill("force");
    dp = target->query_skill("parry") + target->query_skill("force");

    me->start_busy(1);
    me->add("neili", -200);

    // pve额外加成20%
    if (!userp(target))
    {
        ap += ap / 5;
    }

    if (COMBAT_D->hit_determination(me,target,ap,dp))
    {
        damage = ap * 3 / 2 + random(ap);
        msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 70,
                   HIR "$n" HIR "只觉得眼前剑光一闪，胸口一凉，已被$N" HIR "一剑穿心！\n" NOR);
    }
    else
    {
        msg += CYN "$n" CYN "凝神应对，终于看破了$N" CYN "的剑路，险险地避过这一招！\n" NOR;
    }

    message_combatd(msg, me, target);

    return 1;
}
