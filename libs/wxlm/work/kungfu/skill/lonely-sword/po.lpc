// po.c 破气式

#include <combat.h>

inherit F_SSERVER;

string query_name() { return "破气式"; }

int perform(object me, object target)
{
    string msg;
    int i, attack_time;

    if (! target) target = offensive_target(me);
    if (! target || ! me->is_fighting(target))
        return notify_fail("「破气式」只能对战斗中的对手使用。\n");

    if (me->query_skill("lonely-sword", 1) < 80)
        return notify_fail("你的独孤九剑修为不足，无法施展「破气式」。\n");

    if( me->query("neili") < 400 )
        return notify_fail("你的内力不足以施展「破气式」。\n");

    if( !objectp(me->query_temp("weapon")) || me->query_temp("weapon")->query("skill_type") != "sword" )
        return notify_fail("你必须持剑才能使用「破气式」！\n");

    msg = HIW "$N" HIW "施展出独孤九剑之「破气式」，手中" + me->query_temp("weapon")->name() + HIW "连连刺出，剑势如风，直袭$n！\n" NOR;
    message_combatd(msg, me, target);

    me->add("neili", -300);
    me->start_busy(2);

    attack_time = COMBAT_D->query_base_attack_number(me,query_name());

    // pve额外加成2次
    if (!userp(target))
    {
        attack_time += 2;
    }

    for (i = 0; i < attack_time; i++)
    {
        if (! me->is_fighting(target))
            break;

        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
    }

    return 1;
}
