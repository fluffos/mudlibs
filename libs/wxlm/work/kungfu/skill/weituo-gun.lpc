int valid_enable(string usage) { return usage == "club" || usage == "parry"; }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 250)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("force") < 50)
		return notify_fail("你的内功火候太浅。\n");

	if ((int)me->query_skill("club", 1) < (int)me->query_skill("weituo-gun", 1))
		return notify_fail("你的基本棍法水平有限，无法领会更高深的韦陀棍法。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("weituo-gun", 1);
	for(i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "club")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力不够练韦陀棍。\n");

	if ((int)me->query("neili") < 70)
		return notify_fail("你的体力不够练韦陀棍。\n");

	me->receive_damage("qi", 62);
	me->add("neili", -61);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"weituo-gun/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【韦陀棍】" ZJBR NOR;
    msg += "少林寺的棍法绝学，招式灵活多变，以攻守兼备著称。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力不低于 " HIB "250" NOR " 点。" ZJBR;
    msg += "  基本内功等级不低于 " HIY "50" NOR " 级。" ZJBR;
    msg += "  基本长兵等级需大于等于韦陀棍等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  长兵（club）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  装备类型为长兵（club）的武器。" ZJBR;
    msg += "  气血不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "62" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "61" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  韦驮伏魔 (fumo)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      韦陀棍等级 " HIY "135" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "200" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "800" NOR " 点。" ZJBR;
    msg += "      正气值 " HIW "10000" NOR " 点。" ZJBR;
    msg += "      激发长兵为韦陀棍。" ZJBR;
    msg += "      必须在战斗中使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      使用者脸色柔和，手中武器轻旋，恍惚中显出佛家韦陀神像，神光四射。" ZJBR;
    msg += "      对于邪恶目标（正气值为负），命中率和伤害显著提高。" ZJBR;
    msg += "      命中判定：" ZJBR;
    msg += "        先计算攻击力加成：" ZJBR;
    msg += "        - 若目标为邪恶，则基础攻击力为(正气值/1000)，但有上限：" ZJBR;
    msg += "          * 100~200之间的部分每4点折算1点" ZJBR;
    msg += "          * 200~300之间的部分每4点折算1点" ZJBR;
    msg += "          * 300~500之间的部分每4点折算1点" ZJBR;
    msg += "          * 最高不超过500点" ZJBR;
    msg += "        - 若目标不是邪恶，则无额外攻击力加成" ZJBR;
    msg += "        - 最终攻击力 = 攻击力加成 + 使用者长兵技能等级" ZJBR;
    msg += "        - 防御力 = 目标内功等级" ZJBR;
    msg += "        - 通过 COMBAT_D->hit_determination 判定命中" ZJBR;
    msg += "      伤害计算：" ZJBR;
    msg += "        - 伤害值 = 攻击力 + 随机(攻击力)" ZJBR;
    msg += "        - 对目标造成65%伤害系数的伤害" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力 " HIB "300" NOR " 点，忙乱 " HIR "1" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "60" NOR " 点，忙乱 " HIR "2" NOR " 秒。" ZJBR;

    return msg;
}
