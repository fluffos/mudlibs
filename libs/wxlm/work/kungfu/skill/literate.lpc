// literate.c

inherit SKILL;

string type() { return "knowledge"; }

int valid_learn(object me)
{
	return 1;
}


void skill_improved(object me)
{
    int s;
    s = me->query_skill("literate", 1);

    if (s%10==0){
	tell_object(me, HIW "由於你的勤学苦读，你的"+HIY"【后天悟性】"+NOR+"提高了。\n");
    }

}

string query_description()
{
    string msg;

    msg = HIY "【读书写字】" ZJBR NOR;
    msg += WHT "学习和掌握知识的基础技能，提升个人修养。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  无特殊要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  知识类技能，不可用于战斗激发。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  无法通过 `practice` 指令练习，需通过读书 (`read`) 等方式提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  每提升 " HIY "10" NOR " 级，" HIC "后天悟性" NOR " 会获得提升。" ZJBR ZJBR; // skill_improved 效果

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 读书写字是学习很多进阶知识和技能的基础。" ZJBR;
    msg += "2. 提升此技能有助于提高后天悟性。" ZJBR;

    return msg;
}
