// 寂寞心法

inherit FORCE;

int valid_enable(string usage)
{
    return usage == "force";
}

int valid_learn(object me)
{
    if ((int)me->query_skill("force", 1) < 100)
        return notify_fail("你的基本内功火候还不够。\n");
        
    return 1;
}

int practice_skill(object me)
{
    return notify_fail("寂寞心法只能用学(learn)的来增加熟练度。\n");
}

void skill_improved(object me)
{
    int skill = me->query_skill("lonely-force", 1);
    
    if (skill >= 150 && !me->query("lonely_force/powerup"))
    {
        tell_object(me, HIW "\n你感觉内力在体内流转，寂寞心法的修为更上一层楼。\n" NOR);
        me->set("lonely_force/powerup", 1);
    }
}

int exert_function(object me, string arg)
{
    return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【寂寞心法】" ZJBR NOR;
    msg += WHT "一种独特的内功心法，似乎蕴含着某种孤寂的力量。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功 (`force`) 等级不低于 " HIY "100" NOR " 级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功 (`force`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  无法通过 `practice` 指令练习，只能通过学习 (`learn`) 提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  当寂寞心法等级达到 " HIY "150" NOR " 级时，会触发一次提示，表明修为进入新境界 (设置 `lonely_force/powerup` 标记)。" ZJBR;
    msg += "  (该标记的具体效果可能影响其他技能或战斗表现，需在游戏中体验或查阅相关代码)" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (Exert)〗" ZJBR NOR;
    msg += "  目前未发现明确定义的特殊内功运用 (`exert`)。" ZJBR ZJBR; // exert_function() 存在但无实际内容

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 寂寞心法无法直接练习，提升较为困难。" ZJBR;
    msg += "2. 达到 150 级时心法会有所提升，具体效果未知。" ZJBR;

    return msg;
}
