inherit SKILL;

string *dodge_msg = ({
	"$n身形急转，避过了$N的攻势。\n",
	"可是$n拔地而起，躲过了$N这一招。\n",
	"$n作闪右避，总算躲过了$N这一招。\n",
});

int valid_enable(string usage) { return (usage == "dodge") || (usage == "move"); }

int valid_learn(object me) { return 1; }

string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
        if( (int)me->query("qi") < 50 )
                return notify_fail("你的体力太差了，无法练习圣火步法。\n");

        me->receive_damage("qi", 40);
        return 1;
}
string query_description()
{
    string msg;

    msg = HIY "【圣火步法】" ZJBR ZJBR NOR;
    msg += WHT "明教的基础轻功步法，虽然不如乾坤大挪移精妙，但也颇为实用，步法灵动。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  无特殊要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  轻功 (dodge)。" ZJBR;
    msg += "  身法 (move)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "40" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  主要提升闪避能力和移动速度。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无特殊招式。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 练习会消耗气血，请注意补充。" ZJBR;
    msg += "2. 作为基础轻功，是学习更高级身法的前置。\n";

    return msg;
}
