int valid_enable(string usage) { return usage == "blade" || usage == "parry"; } 

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 1000)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("force") < 150)
		return notify_fail("你的内功火候太浅。\n");

	if ((int)me->query_skill("blade", 1) < 80)
		return notify_fail("你的基本刀法火候不够。\n");

	if ((int)me->query_skill("blade", 1) < (int)me->query_skill("longcheng-shendao", 1))
		return notify_fail("你的刀法水平有限，无法领会更高深的龙城神刀。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("longcheng-shendao",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "blade")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力不够练龙城神刀。\n");

	if ((int)me->query("neili") < 80)
		return notify_fail("你的内力不够练龙城神刀。\n");

	me->receive_damage("qi", 65);
	me->add("neili", -68);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"longcheng-shendao/" + action;
}
string query_description()
{
    string msg;

    msg = HIY "【龙城神刀】" ZJBR NOR;
    msg += "一门威力强大、招式凌厉霸道的刀法。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力不低于 " HIB "1000" NOR " 点。" ZJBR;
    msg += "  基本内功 (force) 等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "  基本刀法 (blade) 等级不低于 " HIY "80" NOR " 级。" ZJBR;
    msg += "  基本刀法 (blade) 等级需大于等于龙城神刀等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  刀法（blade）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须装备刀类武器。" ZJBR;
    msg += "  气血不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力不低于 " HIB "80" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "65" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "68" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖招式列表〗" ZJBR NOR;
    msg += "  冬去春来 (0级)" ZJBR;
    msg += "  月上西楼 (30级)" ZJBR;
    msg += "  推窗望月 (60级)" ZJBR;
    msg += "  梦断巫山 (90级)" ZJBR;
    msg += "  似是而非 (120级)" ZJBR;
    msg += "  月挂中天 (150级)" ZJBR;
    msg += "  日月交辉 (180级)" ZJBR;
    msg += ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;

    msg += HIC "  风雨交加 (fengyu)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      需要持有刀类武器。" ZJBR;
    msg += "      当前内力不低于 " HIB "270" NOR " 点。" ZJBR;
    msg += "      基本内功等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      龙城神刀等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标发动连续攻击，攻击次数取决于使用者普通攻击次数 (`COMBAT_D->query_base_attack_number`)。" ZJBR;
    msg += "      命中判定（临时增益）：若 (龙城神刀等级 / 2 + 随机(龙城神刀等级)) > (目标招架激发等级 * 2 / 3)，则临时增加 (龙城神刀等级 / 5) 的攻击等级。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "120" NOR " 点。" ZJBR;
    msg += "      忙乱 (1 + 随机(5)) 秒。" ZJBR;

    return msg;
}
