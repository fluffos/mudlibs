int valid_enable(string usage) { return usage == "cuff" || usage == "parry"; }

int valid_learn(object me)
{
    if (me->query("family/family_name"))
        return notify_fail("梁山霸拳只有无门派的人才能学习。\n");

    if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
        return notify_fail("练习梁山霸拳必须空手。\n");

    if ((int)me->query_skill("force") < 150)
        return notify_fail("你的内功火候不够，无法练习梁山霸拳。\n");

    if ((int)me->query("max_neili") < 1000)
        return notify_fail("你的内力太弱，无法练习梁山霸拳。\n");

    if ((int)me->query_skill("cuff", 1) < 100)
        return notify_fail("你的基本拳法火候不够，无法练习梁山霸拳。\n");

    if ((int)me->query_skill("cuff", 1) < (int)me->query_skill("liangshan_boxing", 1))
        return notify_fail("你的基本拳法水平有限，无法领会更高深的梁山霸拳。\n");

    return 1;
}

string query_skill_name(int level)
{
    int i;
    for (i = sizeof(action) - 1; i >= 0; i--)
        if (level >= action[i]["lvl"])
            return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    int i, level;
    level = (int) me->query_skill("liangshan_boxing", 1);
    for (i = sizeof(action); i > 0; i--)
        if (level > action[i-1]["lvl"])
            return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    if ((int)me->query("qi") < 70)
        return notify_fail("你的体力太低了。\n");

    if ((int)me->query("neili") < 70)
        return notify_fail("你的内力不够练梁山霸拳。\n");

    me->receive_damage("qi", 60);
    me->add("neili", -65);
    return 1;
}

string perform_action_file(string action)
{
    return __DIR__"liangshan_boxing/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【梁山霸拳】" NOR ZJBR ZJBR;
    msg += WHT "相传为水泊梁山众好汉集百家之长所创的拳法，招式大开大阖，刚猛霸道，蕴含着替天行道的凛然正气和无畏气概。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  必须为 " HIY "无门派" NOR " 人士。" ZJBR;
    msg += "  基本内功 (`force`) 等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "  最大内力 (`max_neili`) 不低于 " HIB "1000" NOR " 点。" ZJBR;
    msg += "  基本拳法 (`cuff`) 等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "  基本拳法 (`cuff`) 等级需大于等于梁山霸拳等级。" ZJBR;
    msg += "  学习时必须空手。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  拳法 (`cuff`)。" ZJBR;
    msg += "  招架 (`parry`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  当前气血 (`qi`) 不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  当前内力 (`neili`) 不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血 " HIR "60" NOR " 点，内力 " HIB "65" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  " HIW "霸气拳劲 (hit_ob)" NOR ":" ZJBR;
    msg += "    触发条件：普通攻击命中时，随机(梁山霸拳等级) >= 50。" ZJBR;
    msg += "    效果：对目标造成额外的气血伤害 (`wound`)。" ZJBR;
    msg += "      随机值 50-99： 造成 伤害增益 / 4 的额外伤害。" ZJBR;
    msg += "      随机值 100-149：造成 伤害增益 / 3 的额外伤害。" ZJBR;
    msg += "      随机值 >= 150： 造成 伤害增益 / 2 的额外伤害。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (Perform)〗" ZJBR NOR; // perform_action_file

    msg += HIC "  山崩地裂 (shanbeng)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      梁山霸拳等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      基本内功等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      打出石破天惊的一拳，对目标造成巨大伤害。" ZJBR;
    msg += "      伤害计算：造成 (" RED "梁山霸拳等级 + 随机(梁山霸拳等级)" NOR ") 点伤害。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      自身忙乱 (`busy`) " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  怒龙出海 (nulong)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      梁山霸拳等级不低于 " HIY "80" NOR " 级。" ZJBR;
    msg += "      基本内功等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      拳出如龙，对目标造成伤害，并附加「怒龙」状态，可能持续造成内伤或其他负面效果。" ZJBR;
    msg += "      伤害计算：造成 (" RED "梁山霸拳等级 + 随机(梁山霸拳等级 / 2)" NOR ") 点伤害。" ZJBR;
    msg += "      附加状态：给予目标「" HIR "liangshan_nulong" NOR "」状态，持续 (" CYN "梁山霸拳等级 / 40 + 随机(梁山霸拳等级 / 40)" NOR ") 秒，状态强度为 (" CYN "梁山霸拳等级 / 20" NOR ")。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "      自身忙乱 (`busy`) " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  霸王举鼎 (bawang)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      梁山霸拳等级不低于 " HIY "160" NOR " 级。" ZJBR;
    msg += "      基本内功等级不低于 " HIY "200" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "500" NOR " 点。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      凝聚全身力量，发出石破天惊、力能扛鼎的一击，造成毁灭性伤害。" ZJBR;
    msg += "      伤害计算：造成 (" RED "(梁山霸拳等级 + 后天膂力 * 2) + 随机((梁山霸拳等级 + 后天膂力 * 2) / 2)" NOR ") 点伤害。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      自身忙乱 (`busy`) " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 梁山霸拳威力巨大，但消耗亦不小，需注意内力控制。" ZJBR;
    msg += "2. 仅限无门派人士学习，叛师可能导致武功遗忘。" ZJBR;
    msg += "3. 「怒龙出海」附加的状态具体效果需在游戏中体验。" ZJBR;

    return msg;
}

// 添加特殊效果
mixed hit_ob(object me, object victim, int damage_bonus)
{
    int lvl;
    int i;

    lvl = me->query_skill("liangshan_boxing", 1);
    i = random(lvl);

    if (i < 50)
        return 0;

    if (i < 100)
    {
        victim->receive_wound("qi", damage_bonus / 4);
        return HIR "$N" HIR "这一拳势大力沉,震得$n" HIR "气血翻涌,难以喘息！"NOR"\n";
    }
    else if (i < 150)
    {
        victim->receive_wound("qi", damage_bonus / 3);
        return HIM "$N" HIM "拳势如山,气势如虹,一拳轰出,$n" HIM "顿觉胸口剧痛！"NOR"\n";
    }
    else
    {
        victim->receive_wound("qi", damage_bonus / 2);
        return HIW "$N" HIW "霸气外露,拳劲四射,$n" HIW "被这排山倒海的气势所慑,连连后退！"NOR"\n";
    }
}

int learn_bonus() { return 20; }
int practice_bonus() { return 10; }
int success() { return 15; }
int power_point(object me) { return 1.0; }