// kurong-changong.c 枯荣禅功

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_force(string force)
{
    return force == "duanshi-xinfa";
}

int query_neili_improve(object me)
{
    int lvl;

    lvl = (int)me->query_skill("kurong-changong", 1);
    return lvl * lvl * 15 * 15 / 100 / 200;
}

int valid_learn(object me)
{
    if ( me->query("gender") == "无性")
    	return notify_fail("你无根无性，阴阳不调，难以领会枯荣禅功。\n");

    return ::valid_learn(me);
}

int practice_skill(object me)
{
	return notify_fail("枯荣禅功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"kurong-changong/" + func;
}


string query_description()
{
    string msg;

    msg = HIY "【枯荣禅功】" ZJBR ZJBR NOR;
    msg += WHT "天南段氏家传绝学，亦是天龙寺镇寺之宝。此功法以人体一枯一荣为根基，讲究阴阳互济，运功时一半海水一半火焰，威力极为强劲。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  性别不能为 " HIR "无性" NOR "。" ZJBR;
    msg += "  需要满足其他基本内功学习条件（如内力、等级等，具体参考 FORCE 基类）。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功 (`force`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  枯荣禅功无法通过简单的练习 (`practice`) 来提升，只能通过学习 (`learn`)。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  " HIW "内力增长 (query_neili_improve)" NOR ":" ZJBR;
    msg += "    效果：提升最大内力上限，提升值为 (" HIG "枯荣禅功等级" NOR ") * (" HIG "枯荣禅功等级" NOR ") * " HIC "15 * 15 / (100 * 200)" NOR "。" ZJBR;
    msg += "  " HIW "功法兼容 (valid_force)" NOR ":" ZJBR;
    msg += "    效果：可与 " HIG "段氏心法 (duanshi-xinfa)" NOR " 兼容共存。" ZJBR ZJBR;

    msg += HIY "〖内功运用 (Exert)〗" ZJBR NOR;
    msg += HIB "  枯荣心法 (powerup)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      枯荣禅功等级不低于 " HIY "40" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      运转枯荣禅功，提升自身战力。" ZJBR;
    msg += "      效果：增加临时攻击力 (`apply/attack`) (" HIW "枯荣禅功等级 / 3" NOR ") 点。" ZJBR;
    msg += "      持续时间：(" HIG "枯荣禅功等级 / 3" NOR ") 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "100" NOR " 点。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 该内功无法练习，提升较为缓慢。" ZJBR;
    msg += "2. 枯荣禅功强调阴阳调和，修炼需循序渐进。" ZJBR;

    return msg;
}
