int valid_enable(string usage) { return usage == "claw" ||  usage == "parry"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练虎抓绝户手必须空手。\n");

	if ((int)me->query_skill("force") < 50)
		return notify_fail("你的内功火候不够，无法学虎抓绝户手。\n");

	if ((int)me->query("max_neili") < 250)
		return notify_fail("你的内力太弱，无法练虎抓绝户手。\n");

	if ((int)me->query_skill("claw", 1) < (int)me->query_skill("huzhua-shou", 1))
		return notify_fail("你的基本抓法火候水平有限，无法领会更高深的虎抓绝户手。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action); i > 0; i--)
		if (level >= action[i-1]["lvl"])
			return action[i-1]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("huzhua-shou",1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];

}

int practice_skill(object me)
{
	if (me->query_temp("weapon") ||
	    me->query_temp("secondary_weapon"))
		return notify_fail("你必须空手练习！\n");

	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 80)
		return notify_fail("你的内力不够练虎抓绝户手。\n");

	me->receive_damage("qi", 60);
	me->add("neili", -69);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"huzhua-shou/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【虎抓绝户手】" ZJBR NOR;
    msg += "一门凶猛狠辣的爪法，模仿猛虎扑食之势，出手迅猛凌厉，直击要害。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  必须空手。" ZJBR;
    msg += "  基本内功等级需达到 " HIY "50" NOR " 级。" ZJBR;
    msg += "  最大内力需达到 " HIB "250" NOR " 点。" ZJBR;
    msg += "  基本爪法等级不可低于虎抓绝户手等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  爪法（claw）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须空手。" ZJBR;
    msg += "  气血：不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "80" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "69" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  绝户手 (juehu)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      需经过师门指点开启 (userp(me) && ! me->query(\"can_perform/huzhua-shou/juehu\"))。" ZJBR;
    msg += "      虎抓绝户手等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      正气需高于 " HIC "10000" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标发动猛烈攻击。" ZJBR;
    msg += "      命中判定：随机(自身激发爪法等级) > 目标激发招架等级 / 2。" ZJBR;
    msg += "      命中后造成巨大伤害，伤害值约为（虎抓绝户手等级 * 4 + 随机（虎抓绝户手等级 * 10）），并有 25% 伤害加成。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      使用后降低正气 " HIR "8000" NOR " 点 (无论是否命中)。" ZJBR;
    msg += "      命中：消耗内力 " HIB "200" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;
    msg += "      未命中：消耗内力 " HIB "120" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;

    return msg;
}