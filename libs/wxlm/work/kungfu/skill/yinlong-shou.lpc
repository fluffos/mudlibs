// This program is a part of NITAN MudLIB
// yinlong-shou.c 银龙手

inherit SKILL;

mapping *action = ({
([      "action" : "$N的身行飘忽不定，如同幻影一般，闪到了$n的身后，一招「无影无踪」拍向$n的$l",
        "force" : 130,
        "dodge" : 20,
        "damage" : 10,
        "lvl" : 0,
        "skill_name" : "无影无踪",
        "damage_type" : "内伤"
]),
([      "action" : "$N双掌如同龙神一般，绽放开来，正是一招「龙神探影」，击向$n的$l",
        "force" : 150,
        "dodge" : 10,
        "damage" : 30,
        "lvl" : 20,
        "skill_name" : "龙神探影",
        "damage_type" : "内伤"
]),
([      "action" : "$N身行绕着$n急速转动，忽然出掌，正是一招「飞天幻掌」打向$n的$l",
        "force" : 150,
        "dodge" : 30,
        "damage" : 35,
        "lvl" : 30,
        "skill_name" : "飞天幻掌",
        "damage_type" : "内伤"
]),
([      "action" : "$N双掌上下番飞，如同化成了千万个手掌，正是一招「九天千幻」拍向$n的$l处",
        "force" : 250,
        "dodge" : 20,
        "damage" : 10,
        "lvl" : 40,
        "skill_name" : "九天千幻",
        "damage_type" : "内伤"
]),
});

int valid_enable(string usage) { return usage=="strike" || usage=="parry"; }

int valid_learn(object me)
{

if ((int)me->query_str() < 50)
                return notify_fail("你研究了半天，只觉得力量有些差，始终无法理解其中的真谛。\n");                

        if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
                return notify_fail("练银龙手必须空手。\n");
        if ((int)me->query("max_neili") < 50)
                return notify_fail("你的内力太弱，无法练银龙手。\n");
        return 1;
}

mapping query_action(object me, object weapon)
{
        int i, level;
        level = (int) me->query_skill("yinlong-shou",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
        if ((int)me->query("qi") < 30)
                return notify_fail("你的体力太低了。\n");
        if ((int)me->query("neili") < 20)
                return notify_fail("你的内力不够练银龙手。\n");
        me->receive_damage("qi", 25);
        me->add("neili", -10);
        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"yinlong-shou/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【银龙手】" ZJBR NOR;
    msg += WHT "银龙手是一门威力强大的掌法，融合了灵活多变的招式和强大的内劲。" ZJBR;
    msg += WHT "此功法源自古老的龙形拳法，讲究招式轻灵飘忽，又不失刚猛有力。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  后天臂力：" HIY "50" NOR " 点" ZJBR;
    msg += "  当前内力：" HIY "50" NOR " 点" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  掌法 (strike)" ZJBR;
    msg += "  招架 (parry)" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血消耗：" HIR "25" NOR " 点" ZJBR;
    msg += "  内力消耗：" HIB "10" NOR " 点" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  夺命 (duo)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      银龙手 " HIY "160" NOR " 级" ZJBR;
    msg += "      当前内力 " HIB "300" NOR " 点" ZJBR;
    msg += "      银龙手已激发为掌法并准备" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      汇聚全身内力于双手，发出强大气流攻击敌人心脏" ZJBR;
    msg += "      攻击力(AP)计算：掌法有效激发等级" ZJBR;
    msg += "      防御力(DP)计算：目标内功有效激发等级" ZJBR;
    msg += "      命中判定：AP > DP时判定成功" ZJBR;
    msg += "      特殊效果：若目标气血低于5000点，可直接击杀目标" ZJBR;
    msg += "                若目标气血高于5000点，造成掌法等级点伤害" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      基础内力消耗：" HIB "60" NOR " 点" ZJBR;
    msg += "      击中后额外消耗：" HIB "140-200" NOR " 点" ZJBR;
    msg += "      自身忙乱：" HIR "1-3" NOR " 秒" ZJBR ZJBR;

    msg += HIR "〖注意事项〗" ZJBR NOR;
    msg += "  银龙手招式轻灵但内劲大开大合，使用时需注意内力控制" ZJBR;
    msg += "  特殊招式「夺命」威力极大，可对气血较低的敌人一击毙命" ZJBR;
    msg += "  练习此功需有强健的臂力支撑，否则难以发挥其真正威力" ZJBR;

    return msg;
}

