	"lvl"    : 120,
	"skill_name" : "北斗生采",
	"damage_type" : "瘀伤"
]),
});

int valid_enable(string usage) { return usage == "cuff" || usage == "parry"; }

int valid_combine(string combo) { return combo == "canhe-zhi"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练七星拳法必须空手。\n");

	if ((int)me->query_skill("force") < 30)
		return notify_fail("你的内功火候不够，无法练七星拳法。\n");

	if ((int)me->query("max_neili") < 120)
		return notify_fail("你的内力太弱，无法练七星拳法。\n");

	if (me->query_skill("cuff", 1) < me->query_skill("qixing-quan", 1))
		return notify_fail("你的基本拳法造诣有限，无法领会更高深的七星拳法。\n");

	return 1;
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("qixing-quan", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i - 1]["lvl"])
			return action[NewRandom(i, 20, level  /5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 30)
		return notify_fail("你的内力不够练七星拳法。\n");

	me->receive_damage("qi", 36);
	me->add("neili", -18);
	return 1;
}
string query_description()
{
    string msg;

    msg = HIY "【七星拳法】" ZJBR NOR;
    msg += "慕容世家拳法之一，模仿北斗七星方位，拳法灵动，虚实结合，变化多端。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  必须空手。" ZJBR;
    msg += "  基本内功 (force) 等级不低于 " HIY "30" NOR " 级。" ZJBR;
    msg += "  最大内力 (max_neili) 不低于 " HIB "120" NOR " 点。" ZJBR;
    msg += "  基本拳法 (cuff) 等级需大于等于七星拳法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  拳法 (cuff)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血 (qi)：不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  内力 (neili)：不低于 " HIB "30" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "36" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "18" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖组合武学〗" ZJBR NOR;
    msg += "  可与 参合指 (canhe-zhi) 互备。" ZJBR;

    return msg;
}
