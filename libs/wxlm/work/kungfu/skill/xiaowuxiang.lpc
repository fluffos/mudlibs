// xiaowuxiang.c 無相玄功
// by secret
// 1997-1-16
//

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_force(string force)
{
	return force == "xiaoyao-xinfa" ||
	       force == "beiming-shengong" ||
	       force == "mizong-neigong" ||
	       force == "longxiang";
}

int query_neili_improve(object me)
{
    	int lvl;

    	lvl = (int)me->query_skill("xiaowuxiang", 1);
    	return lvl * lvl * 15 * 11 / 100 / 200;
}

int valid_learn(object me)
{
	if ((int)me->query_skill("force", 1) < 80)
		return notify_fail("你的基本内功火候不足，不能学無相玄功。\n");

	if (me->query("gender") == "无性" &&
	(int)me->query_skill("xiaowuxiang", 1) > 49)
		return notify_fail("你无根无性，阴阳不调，难以领会高深的無相玄功。\n");

	return ::valid_learn(me);
}

int practice_skill(object me)
{
	return notify_fail("無相玄功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"xiaowuxiang/" + func;
}

int difficult_level()
{
	object me;
	int lvl;

	if (me = this_player())
	{
		// 有龙象般若功？难以学习。
		if (lvl = me->query_skill("longxiang", 1))
			return 3000;

	}

	return 100;
}

string query_description()
{
    string msg;

    msg = HIY "【小无相功】" ZJBR NOR;
    msg += WHT "此内功为逍遥派镇派神功之一，其主旨不着形相，无迹可寻，" ZJBR;
    msg += WHT "若非自己说明，别人很难看出来修炼的是何种武功。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功等级不低于 " HIY "80" NOR " 级。" ZJBR;
    msg += "  无性之人 (性别为无性) 在小无相功达到 " HIY "50" NOR " 级后，阴阳不调，难以继续提升。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功（force）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  小无相功只能通过学习（learn）提升，无法通过练习（practice）。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  内力上限提升：等级越高，提升内力上限越多，计算方式为：(等级 * 等级 * 15 * 11 / 100 / 200)。" ZJBR;
    msg += "  可配合 `逍遥心法`、`北冥神功`、`密宗内功` 或 `龙象般若功` 使用。" ZJBR;
    msg += "  学习难度：若已学习 `龙象般若功`，学习难度将大幅提升。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;

    msg += HIC "  无相护体 (shield)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      小无相功等级 " HIY "40" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      运起护体真气，提升自身防御力。" ZJBR;
    msg += "      防御力提升量 = (小无相功等级 / 2) 点。" ZJBR;
    msg += "      效果持续时间 = (小无相功等级) 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      若已处于护体状态，再次使用会额外忙乱 " HIR "3" NOR " 秒，否则忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  无相真气 (powerup)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      当前内力不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升战斗力，增加攻击力、招架率和闪避率。" ZJBR;
    msg += "      攻击力/招架率/闪避率提升量 = (小无相功等级 / 3) 点。" ZJBR;
    msg += "      效果持续时间 = (小无相功等级 / 2) 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      若已处于力强状态，再次使用会额外忙乱 " HIR "3" NOR " 秒，否则忙乱 " HIR "2" NOR " 秒。" ZJBR;

    return msg;
}