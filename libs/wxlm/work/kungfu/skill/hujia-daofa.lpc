int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 300)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("force") < 50)
		return notify_fail("你的内功火候太浅。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level   = (int) me->query_skill("hujia-daofa", 1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "blade")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力不够，练不了飞狐刀法。\n");

	if ((int)me->query("neili") < 70)
		return notify_fail("你的内力不够，练不了飞狐刀法。\n");

	me->receive_damage("qi", 55);
	me->add("neili", -61);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"hujia-daofa/" + action;
}

/**
 * @brief 返回胡家刀法的详细描述信息
 * @return string 包含技能介绍、学习要求、特殊招式详细说明的字符串
 * @details 提供胡家刀法的完整技能说明，包括所有特殊招式的具体伤害计算公式和多段攻击机制
 */
string query_description()
{
    string msg;

    msg = HIY "【胡家刀法】" ZJBR NOR;
    msg += "边疆胡家世代相传的武学，刀法刚猛凌厉，以速度见长，刀势迅猛，曾与苗家剑法齐名。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力需达到 " HIY "300" NOR " 点。" ZJBR;
    msg += "  基本内功等级需达到 " HIY "50" NOR " 级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  刀法（blade）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须持有刀类武器。" ZJBR;
    msg += "  气血：不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "55" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "61" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖核心机制：刀气系统〗" ZJBR NOR;
    msg += "  " HIC "刀气获得：" NOR "使用【破字诀】、【狂风卷地】、【开天辟地】、【雪山飞狐】命中时可获得1缕刀气。" ZJBR;
    msg += "  " HIC "刀气上限：" NOR "基础8缕，【胡马嘶风】奥义等级可提升上限至(8+奥义等级)缕。" ZJBR;
    msg += "  " HIC "额外刀气机制：" NOR "命中获得基础刀气后，若随机(10)+1 < 胡马嘶风奥义等级，则额外获得1缕刀气。" ZJBR;
    msg += "  " HIC "额外刀气概率：" NOR "奥义1级=10%，奥义5级=50%，奥义10级=100%，奥义等级越高概率越大。" ZJBR;
    msg += "  " HIC "溢出奥义加成：" NOR "当胡马嘶风奥义等级>10时，每溢出1级为所有胡家刀法招式增加5%最终伤害。" ZJBR;
    msg += "  " HIC "藏气转化：" NOR "使用【八方藏刀式】可将所有刀气转化为藏气。" ZJBR;
    msg += "  " HIC "藏气释放：" NOR "下次使用【破字诀】、【狂风卷地】、【开天辟地】、【雪山飞狐】时，每缕藏气提升最终伤害25%。" ZJBR ZJBR;

    msg += HIY "〖特殊招式详解〗" ZJBR NOR;

    msg += HIC "  八方藏刀式 (bafang)" ZJBR NOR;
    msg += "    " HIY "使用要求：" NOR ZJBR;
    msg += "      胡家刀法等级 " HIY "100" NOR " 级 | 基本内功等级 " HIY "100" NOR " 级 | 当前内力 " HIB "200" NOR " 点" ZJBR;
    msg += "      必须持有刀类武器 | 激发刀法为胡家刀法" ZJBR;
    msg += "    " HIY "伤害机制：" NOR ZJBR;
    msg += "      " HIC "连续攻击：" NOR "发动多次普通武器攻击。" ZJBR;
    msg += "      " HIC "攻击加成：" NOR "若随机(激发刀法等级) > 目标激发招架等级/2，临时攻击力增加 胡家刀法等级/6。" ZJBR;
    msg += "      " HIC "忙乱效果：" NOR "每次攻击有1/3几率使目标忙乱1秒。" ZJBR;
    msg += "      " HIC "刀气转化：" NOR "将当前所有刀气(hujia_daoqi)转化为藏气(hujia_cangqi)，用于强化后续绝招。" ZJBR;
    msg += "    " HIY "消耗代价：" NOR "内力 " HIB "150" NOR " 点 | 自身忙乱 1+随机(6) 秒" ZJBR ZJBR;

    msg += HIC "  破字诀 (po)" ZJBR NOR;
    msg += "    " HIY "使用要求：" NOR ZJBR;
    msg += "      胡家刀法等级 " HIY "90" NOR " 级 | 基本内功等级 " HIY "150" NOR " 级 | 当前内力 " HIB "300" NOR " 点" ZJBR;
    msg += "      必须持有刀类武器 | 激发刀法为胡家刀法" ZJBR;
    msg += "    " HIY "伤害机制：" NOR ZJBR;
    msg += "      " HIC "攻击类型：" NOR "远程攻击，发出无形刀气。" ZJBR;
    msg += "      " HIC "命中判定：" NOR "((激发刀法等级 + 激发内功等级)/4 + 随机((激发刀法等级 + 激发内功等级)/3)) vs 目标激发内功等级" ZJBR;
    msg += "      " HIC "伤害计算：" NOR "(激发刀法等级 + 激发内功等级) * 5 + 随机((激发刀法等级 + 激发内功等级) * 3)" ZJBR;
    msg += "      " HIC "最终伤害：" NOR "计算伤害的100%生效。" ZJBR;
    msg += "      " HIC "刀气效果：" NOR "命中后获得1缕刀气；胡马嘶风奥义触发时额外获得1缕（概率=奥义等级*10%）。" ZJBR;
    msg += "      " HIC "藏气增伤：" NOR "消耗所有藏气，每缕增加25%最终伤害。" ZJBR;
    msg += "    " HIY "消耗代价：" NOR "命中时内力 " HIB "150" NOR " 点 | 未命中时内力 " HIB "50" NOR " 点 | 自身忙乱 " HIR "2" NOR " 秒" ZJBR ZJBR;

    msg += HIC "  狂风卷地 (kuangfeng)" ZJBR NOR;
    msg += "    " HIY "使用要求：" NOR ZJBR;
    msg += "      胡家刀法等级 " HIY "150" NOR " 级 | 基本内功等级 " HIY "200" NOR " 级 | 当前内力 " HIB "500" NOR " 点" ZJBR;
    msg += "      必须持有刀类武器 | 激发刀法为胡家刀法" ZJBR;
    msg += "    " HIY "伤害机制：" NOR ZJBR;
    msg += "      " HIC "命中判定：" NOR "(激发刀法等级 + 先天膂力*10) vs (目标激发招架等级 + 目标先天身法*10)" ZJBR;
    msg += "      " HIC "基础伤害：" NOR "(激发刀法等级 + 先天膂力*10) + 随机((激发刀法等级 + 先天膂力*10)/2)" ZJBR;
    msg += "      " HIC "最终伤害：" NOR "计算伤害的120%生效。" ZJBR;
    msg += "      " HIC "PVE加成：" NOR "对NPC时命中判定+50%，伤害翻倍。" ZJBR;
    msg += "      " HIC "刀气效果：" NOR "命中后获得1缕刀气；胡马嘶风奥义触发时额外获得1缕（概率=奥义等级*10%）。" ZJBR;
    msg += "      " HIC "藏气增伤：" NOR "消耗所有藏气，每缕增加25%最终伤害。" ZJBR;
    msg += "    " HIY "消耗代价：" NOR "内力 " HIB "400" NOR " 点 | 自身忙乱 " HIR "2" NOR " 秒" ZJBR ZJBR;

    msg += HIC "  开天辟地 (pi)" ZJBR NOR;
    msg += "    " HIY "使用要求：" NOR ZJBR;
    msg += "      需师门指点开启 | 胡家刀法等级 " HIY "150" NOR " 级 | 基本内功等级 " HIY "150" NOR " 级 | 当前内力 " HIB "800" NOR " 点" ZJBR;
    msg += "      必须持有刀类武器 | 激发刀法为胡家刀法" ZJBR;
    msg += "    " HIY "复杂伤害机制：" NOR ZJBR;
    msg += "      " HIC "命中判定：" NOR "(激发刀法等级 + 先天膂力*10) vs (目标激发内功等级 + 目标先天膂力*10)" ZJBR;
    msg += "      " HIC "基础伤害：" NOR "(激发刀法等级 + 先天膂力*10) * 3 + 随机(自身最大内力/5) + 自身加力" ZJBR;
    msg += "      " HIC "PVE加成：" NOR "对NPC时命中判定+50%，伤害+50%。" ZJBR;
    msg += "      " HIC "内力削减：" NOR "削减目标内力：胡马嘶风奥义等级 * 目标内力/100 + 100。" ZJBR;
    msg += "      " HIC "武器破坏多段伤害：" NOR ZJBR;
    msg += "        ·无武器：造成基础伤害的100%生效" ZJBR;
    msg += "        ·高品质武器(自制/伤害>180/锤类)：震落武器，造成基础伤害的100%生效" ZJBR;
    msg += "        ·普通武器：震碎武器(基础伤害70%生效)→碎片多段伤害(2-4次，每次基础伤害/7)→余势伤害(基础伤害/2)" ZJBR;
    msg += "      " HIC "冷月神功加成：" NOR "若目标处于冻结状态，额外造成基础伤害的33%-45%生效。" ZJBR;
    msg += "      " HIC "刀气效果：" NOR "命中后获得1缕刀气；胡马嘶风奥义触发时额外获得1缕（概率=奥义等级*10%）。" ZJBR;
    msg += "      " HIC "藏气增伤：" NOR "消耗所有藏气，每缕增加25%最终伤害。" ZJBR;
    msg += "    " HIY "消耗代价：" NOR "命中时内力 " HIB "300" NOR " 点 | 未命中时内力 " HIB "100" NOR " 点 | 自身忙乱 " HIR "3" NOR " 秒 | 目标忙乱1+随机(2)秒" ZJBR ZJBR;

    msg += HIC "  雪山飞狐 (xueshan)" ZJBR NOR;
    msg += "    " HIY "使用要求：" NOR ZJBR;
    msg += "      胡家刀法等级 " HIY "150" NOR " 级 | 基本内功等级 " HIY "250" NOR " 级 | 当前内力 " HIB "800" NOR " 点" ZJBR;
    msg += "      必须持有刀类武器 | 激发刀法为胡家刀法" ZJBR;
    msg += "    " HIY "伤害机制：" NOR ZJBR;
    msg += "      " HIC "攻击特性：" NOR "胡家刀法终极绝学，疾速强力的单次攻击。" ZJBR;
    msg += "      " HIC "命中判定：" NOR "(激发刀法等级 + 激发内功等级 + 先天天膂力*10) vs (目标激发轻功等级 + 目标激发内功等级 + 目标先天身法*10)" ZJBR;
    msg += "      " HIC "伤害计算：" NOR "(激发刀法等级 + 激发内功等级 + 先天膂力*10) * 3 + 随机(激发刀法等级 + 激发内功等级 + 先天膂力*10)" ZJBR;
    msg += "      " HIC "最终伤害：" NOR "计算伤害的150%生效。" ZJBR;
    msg += "      " HIC "PVE加成：" NOR "对NPC时命中判定+50%，伤害+50%。" ZJBR;
    msg += "      " HIC "刀气效果：" NOR "命中后获得1缕刀气；胡马嘶风奥义触发时额外获得1缕（概率=奥义等级*10%）。" ZJBR;
    msg += "      " HIC "藏气增伤：" NOR "消耗所有藏气，每缕增加25%最终伤害。" ZJBR;
    msg += "    " HIY "消耗代价：" NOR "内力 " HIB "600" NOR " 点 | 自身忙乱 " HIR "3" NOR " 秒" ZJBR;

    return msg;
}

