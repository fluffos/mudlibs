// lingboweibu.c 洛神步法



inherit SKILL;

string *dodge_msg = ({
	"可是$n侧身一让，$N这一招扑了个空。\n",
	"却见$n足不点地，往旁窜开数尺，躲了开去。\n",
	"$n身形微晃，有惊无险地避开了$N这一招。\n",
	"$n跨出几步，落点怪异莫测，让$N这一招没有发挥任何作用。\n",
	"$n自顾自的走出几步，浑然不理$N出招攻向何处。\n",
	"$N这一招眼看就要击中，可是$n往旁边一让，去点之妙，实在是匪夷所思。\n",
	"$n往前一迈，忽然后退，恰恰避开$N这一招，有惊无险。\n",
});

int valid_enable(string usage) 
{ 
	return usage == "dodge";
}

int valid_learn(object me)
{
	int lvl;

	lvl = me->query_skill("lingbo-weibu", 1);

	if (me->query("max_neili") < 3000 + lvl * 10)
		return notify_fail("你试着走了两步，顿觉胸口烦恶之极，看来是内力不济。\n");
	return 1;
}

string query_txt()
{
	return "要求：内力(3000+等级*10)"ZJBR
	"特效：轻功化解伤害，对比自身(轻功激发)和攻击者轻功激发，同激发等级1/2概率触发，受阴阳八卦克制";
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

mixed valid_damage(object ob, object me, int damage, object weapon)
{
	mixed result;
	int ap, dp, mp;
	int yjlevel = COMBAT_D->get_skill_aoyi_level(me,"自由自在");
	if ((int)me->query_skill("lingbo-weibu", 1) < 100 ||
	    ! living(me))
		return;

	mp = ob->query_skill("count",1);
	ap = ob->query_skill("dodge") + mp;
	dp = me->query_skill("dodge");

	//一层意境添加1%的概率
	if ((ap / 2 ) + random(ap) < dp + dp / 100 * yjlevel)
	{
		result = ([ "damage": -(damage * 3 / 4) ]);

		switch (random(4))
		{
		case 0:
			result += (["msg" : HIW "只见$n" HIW "微微一笑，身子轻轻晃动，$N"
					    HIW "眼前顿时出现了无数个$n" HIW "的幻影，令$N"
					    HIW "完全无法辨出虚实。"NOR"\n"]);
			break;
		case 1:
			result += (["msg" : HIW "$n" HIW "往旁边歪歪斜斜的迈出一步，却恰"
					    "好令$N" HIW "的攻击失之毫厘。"NOR"\n"]);
			break;
		case 2:
			result += (["msg" : HIW "$N" HIW "这一招来的好快，然后$n"
					    HIW "一闪，似乎不费半点力气，却将$N"
					    HIW "这一招刚好避开。"NOR"\n"]);
			break;
		default:
			result += (["msg" : HIW "但见$n" HIW "轻轻一跃，已不见了踪影，$N"
					    HIW "心中大骇，却又见$n" HIW "擦肩奔过，步法"
					    "之奇巧，当真令人思索菲仪。"NOR"\n"]);
			break;
		}
		return result;
	} else
	if (mp >= 100)
	{
		switch (random(4))
		{
		case 0:
			result = HIY "只见$n" HIY "微微一笑，身子轻轻晃动，"
				 "顿时出现了无数个$n" HIY "的幻影，可是$N"
				 HIY "精通易理，将其中虚实辨得清清楚楚。"NOR"\n";
			break;
		case 1:
			result = HIY "$n" HIY "往旁边歪歪斜斜的迈出一步，然而$N"
				 HIY "错步跟随，方位毫厘不差。"NOR"\n";
			break;
		case 2:
			result = HIY "$n" HIY "一闪，似乎不费半点力气，却将$N"
				 HIY "这一招刚好避开，可是$N"
				 HIY "招中有招，进攻却是不止。"NOR"\n";
			break;
		default:
			result = HIY "但见$n" HIY "轻轻一跃，已不见了踪影，$N"
				 HIY "不假思索，反身出招，更是巧妙无方。"NOR"\n";
			break;
		}
		COMBAT_D->set_bhinfo(result);
	}
}

int query_effect_dodge(object attacker, object me)
{
	int lvl;

	lvl = me->query_skill("lingbo-weibu", 1);
	if (lvl < 50)  return 0;
	if (lvl < 100) return 30;
	if (lvl < 150) return 50;
	if (lvl < 200) return 80;
	if (lvl < 250) return 100;
	if (lvl < 300) return 120;
	if (lvl < 350) return 140;
	return 150;
}

int practice_skill(object me)
{
	int cost;

	cost = me->query_skill("lingbo-weibu", 1) / 2 + 120;
	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力太差了，难以练习洛神步法。\n");

	if ((int)me->query("neili") < cost)
		return notify_fail("你的内力不够了，无法练习洛神步法。\n");

	me->receive_damage("qi", 50);
	me->add("neili", -cost);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"lingbo-weibu/" + action;
}
string query_description()
{
    string msg;

    msg = HIY "【凌波微步】" ZJBR NOR;
    msg += WHT "逍遥派的独门轻功绝学，步法取自《易经》六十四卦，极为精妙，动无常则，若危若安，进止难期，若往若还。" ZJBR;
    msg += WHT "习练者如同洛神再生，体迅飞凫，飘忽若神，令对手难以捉摸。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  最大内力 (`max_neili`) 不低于 " HIB "(3000 + 凌波微步等级 * 10)" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  轻功 (`dodge`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  气血 (`qi`) 不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力 (`neili`) 不低于 " HIB "(凌波微步等级 / 2 + 120)" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血 " HIR "50" NOR " 点，内力 " HIB "(凌波微步等级 / 2 + 120)" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  " HIM "特殊闪避 (valid_damage)" NOR ":" ZJBR;
    msg += "    触发条件：凌波微步等级不低于100级。" ZJBR;
    msg += "    效果：几率完全闪避一次攻击并免疫伤害，成功时有多种飘逸描述。" ZJBR;
    msg += "    判定：综合比较自身轻功激发、攻击者轻功激发 和 攻击者 易经算术 (`count`) 等级。" ZJBR;
    msg += "          受自身意境 " HIW "『自由自在』" NOR " 加成 (每层意境提升约 1% 闪避成功率)。" ZJBR;
    msg += "          会被高深的 易经算术 (`count` >= 100) 克制，即使闪避失败也会有特殊提示。" ZJBR;
    msg += "  " HIM "轻功效果 (query_effect_dodge)" NOR ":" ZJBR;
    msg += "    效果：提升基础的轻功有效等级，加成值随凌波微步等级提升（50级+30，100级+50 ... 350级+150）。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (Perform)〗" ZJBR NOR;
    msg += HIC "  洛神凌波 (lingbo)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      凌波微步等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "      北冥神功 (`beiming-shengong`) 等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "      最大内力 (`max_neili`) 不低于 " HIB "1500" NOR " 点。" ZJBR;
    msg += "      当前内力不低于 " HIB "400" NOR " 点。" ZJBR;
    msg += "      只能对战斗中且未被忙乱的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      施展凌波微步精髓，以奇异步法迷惑对手，使其陷入忙乱 (`busy`) 状态。" ZJBR;
    msg += "      命中判定：若 `随机(自身凌波微步等级) > (目标轻功激发等级 / 2)` 则命中。" ZJBR;
    msg += "      成功后目标忙乱时间：`(凌波微步等级 / 16)` 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      未命中：消耗内力 " HIB "50" NOR " 点，自身忙乱 " HIR "0-1" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 凌波微步对内力要求极高，练习和学习时需关注内力上限。" ZJBR;
    msg += "2. 其特殊闪避效果 (`valid_damage`) 是核心防御手段，但会被高等级易经算术克制。" ZJBR;
    msg += "3. 特殊招式「洛神凌波」需要北冥神功支持，是控制对手的有效手段。" ZJBR;
    msg += "4. 意境「自由自在」能有效提升特殊闪避的成功率。" ZJBR;

    return msg;
}