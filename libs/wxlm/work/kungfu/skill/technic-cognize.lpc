// 技能修养

inherit SKILL;

int valid_learn(object me)
{
	return notify_fail("技能修养是你工艺技能方面的体会，无法"
			   "通过简单学习获得提升。\n");
}

int valid_research(object me)
{
	return notify_fail("技能修养来自你对工艺技术精髓的熟悉"
			   "运用，无法通过研究提升。\n");
}

string query_description()
{
    string msg;

    msg = HIY "【技能修养】" ZJBR NOR;
    msg += "技能修养是衡量一个人在工艺技能方面造诣的指标。" ZJBR ZJBR;

    msg += HIY "〖学习与修炼〗" ZJBR NOR;
    msg += "  此项技能无法通过学习（learn）或研究（research）来提升。" ZJBR;
    msg += "  它只能通过长期实践和对工艺技术精髓的熟悉运用来积累。" ZJBR ZJBR;

    msg += HIY "〖技能效果〗" ZJBR NOR;
    msg += "  技能修养的提高将有助于提升各种工艺技能的效果。" ZJBR;
    msg += "  此技能不可激发（enable），也不能练习（practice）。" ZJBR;

    return msg;
}

