int valid_enable(string usage) {return (usage== "sword") || (usage== "parry"); }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 200)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("force") < 30)
		return notify_fail("你的内功火候太浅。\n");

	return 1;
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level   = (int) me->query_skill("liangyi-jian",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
		       return action[NewRandom(i, 20, level/5)];

}

int practice_skill(object me)
{
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力不够练两仪剑法。\n");

	if ((int)me->query("neili") < 30)
		return notify_fail("你的体力不够练两仪剑法。\n");

	me->receive_damage("qi", 40);
	me->add("neili", -25);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"liangyi-jian/" + action;
}


string query_description()
{
    string msg;

    msg = HIY "【两仪剑法】" ZJBR NOR;
    msg += WHT "武当派剑法，脱胎于太极拳理，讲究阴阳相济、刚柔互换，剑势圆转，变化莫测。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力 (`max_neili`) 不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "  基本内功 (`force`) 等级不低于 " HIY "30" NOR " 级。" ZJBR;
    msg += "  基本剑法 (`sword`) 等级需大于等于两仪剑法等级（游戏中可能隐含）。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  剑法 (`sword`)。" ZJBR;
    msg += "  招架 (`parry`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须装备剑类武器。" ZJBR;
    msg += "  气血 (`qi`) 不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  内力 (`neili`) 不低于 " HIB "30" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血 " HIR "40" NOR " 点，内力 " HIB "25" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (Perform)〗" ZJBR NOR;
    msg += HIC "  天地同仁 (ren)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      两仪剑法等级不低于 " HIY "60" NOR " 级。" ZJBR;
    msg += "      太极神功 (`taiji-shengong`) 等级不低于 " HIY "90" NOR " 级。" ZJBR;
    msg += "      最大内力 (`max_neili`) 不低于 " HIB "400" NOR " 点。" ZJBR;
    msg += "      当前内力不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "      必须装备剑类武器。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      运起太极剑意，剑光暴长，对目标造成一次伤害。" ZJBR;
    msg += "      伤害计算：基础伤害约为 `剑法激发等级 / 2 + 随机(剑法激发等级 / 2)`，受内力加成等其他因素影响。" ZJBR;
    msg += "      命中判定由系统标准攻防计算判定。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "180" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 练习和使用两仪剑法需要装备剑类武器。" ZJBR;
    msg += "2. 「天地同仁」需激发太极神功才能发挥威力，且仅能在战斗中使用。" ZJBR;
    msg += "3. 使用「天地同仁」后会自身忙乱一段时间。" ZJBR;

    return msg;
}