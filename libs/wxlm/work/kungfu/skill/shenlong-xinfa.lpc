// shenlong-xinfa.c 神龙心法

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int query_neili_improve(object me)
{
	int lvl;

	lvl = (int)me->query_skill("shenlong-xinfa", 1);
	return lvl * lvl * 15 * 15 / 100 / 200;
}

int valid_force(string force)
{
	return force == "shedao-neigong";
}

int valid_learn(object me)
{
	/*if (me->query("gender") == "无性" &&
	    me->query_skill("shenlong-xinfa", 1) > 49)
		return notify_fail("你无根无性，阴阳不调，难以领会高深的神龙心法。\n");
*/
	return ::valid_learn(me);
}

int practice_skill(object me)
{
	return notify_fail("神龙心法只能通过学或是从运用(exert)中增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"shenlong-xinfa/" + func;
}
string query_description()
{
    string msg;

    msg = HIY "【神龙心法】" ZJBR ZJBR NOR;
    msg += WHT "神龙教的基础内功心法，据传与蛇岛内功同源，修炼后可提升内力修为。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  遵循基本内功学习规则。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功 (force)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  无法通过练习 (`practice`) 提升，只能通过学习 (`learn`) 或运用 (`exert`) 提升熟练度。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  提升内力上限：提升值 = `(等级 * 等级 * 225) / 20000`。" ZJBR; 
    msg += "  可被 " HIG "蛇岛内功 (shedao-neigong)" NOR " 作为有效内功基础。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += CYN "  神龙心法 (powerup)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      神龙心法等级 " HIY "60" NOR " 级。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升自身攻击力和内功有效等级，提升数值约为 (`神龙心法等级 / 2`)。" ZJBR;
    msg += "      效果持续时间为 (`神龙心法等级 / 3`) 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 作为神龙教的基础内功，是学习其他神龙教武学的根基。" ZJBR;
    msg += "2. 提升熟练度的方式较为特殊，无法直接练习。\n";

    return msg;
}
