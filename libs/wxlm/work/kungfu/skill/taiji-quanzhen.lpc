// taiji-quanzhen.c 先天无极决
// 融合太极拳、太极剑法和全真剑法的绝世武学

inherit SKILL;

/**
 * @brief 主技能标识函数
 * @return string 主技能名称
 * @details 标识此技能为主技能
 */
