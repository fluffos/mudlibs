/**
 * @brief 检查演练准备条件
 * @param object me 玩家对象
 * @return int 1表示可以开始演练，0表示不可以
 */
int get_ready(object me)
{
    return 1;
}

/**
 * @brief 检查演练完成条件
 * @param object me 玩家对象
 * @return int 1表示成功融合，0表示失败
 * @details 检查三门武学融合的各项严格条件
 */
int get_finish(object me)
{
    if (me->query("int") < 35)
    {
        tell_object(me, "你演练完毕，觉得三门武学精妙异常，但始终无法将其融会贯通。\n");
        return 0;
    }

    if (me->query("con") < 30)
    {
        tell_object(me, "你演练完毕，就觉得体力不支，无法承受三门武学的融合。\n");
        return 0;
    }

    if ((int)me->query("max_neili") < 100000)
    {
        tell_object(me, "你觉得内力不足，无法融会贯通三门武学的精髓。\n");
        return 0;
    }

    if (me->query_skill("force", 1) < 700)
    {
        tell_object(me, "你发现自己的内功修为不够，无法驾驭先天无极决的威力。\n");
        return 0;
    }

    if (me->query_skill("unarmed", 1) < 700)
    {
        tell_object(me, "你觉得自己的基本拳脚还不够纯熟，无法掌握先天无极决的拳法精髓。\n");
        return 0;
    }

    if (me->query_skill("sword", 1) < 700)
    {
        tell_object(me, "你觉得自己的基本剑法还不够纯熟，无法掌握先天无极决的剑法精髓。\n");
        return 0;
    }

    // 检查子技能等级
    if (me->query_skill("taiji-quan", 1) < 700)
    {
        tell_object(me, "你的太极拳修为不足，无法进行三门武学的融合。\n");
        return 0;
    }

    if (me->query_skill("taiji-jian", 1) < 700)
    {
        tell_object(me, "你的太极剑法修为不足，无法进行三门武学的融合。\n");
        return 0;
    }

    if (me->query_skill("quanzhen-jian", 1) < 700)
    {
        tell_object(me, "你的全真剑法修为不足，无法进行三门武学的融合。\n");
        return 0;
    }

    // 60%失败率的随机机制
    if (random(10) < 6)
    {
        tell_object(me, "你觉得若有所悟，三门武学似乎有了一丝融合的征象，或许再演练一次就能成功。\n");
        return 0;
    }

    tell_object(me, HIY "突然间，你心中豁然开朗，太极拳的圆融、太极剑的灵动与全真剑的正大在你心中完美融合，\n"
                    "一套前所未有的绝世武学——先天无极决终于被你领悟！" NOR "\n");
    return 1;
}

/**
 * @brief 返回子技能映射
 * @return mapping 子技能映射
 */
mapping query_sub_skills()
{
    return sub_skills;
}

/**
 * @brief 有效激发类型
 * @param string usage 激发类型
 * @return int 是否可以激发
 * @details 支持空手、剑法和招架激发
 */
int valid_enable(string usage)
{
    return usage == "unarmed" || usage == "sword" || usage == "parry";
}

/**
 * @brief 连击功能
 * @return int 是否支持连击
 */
int double_attack() { return 1; }

/**
 * @brief 学习条件检查
 * @param object me 玩家对象
 * @return int 1表示可以学习，0表示不可以
 */
int valid_learn(object me)
{
    if (me->query("int") < 35)
        return notify_fail("你的天资不足，无法理解先天无极决的精妙。\n");

    if ((int)me->query("max_neili") < 8000)
        return notify_fail("你的内力太弱，无法学先天无极决。\n");

    if (me->query_skill("force", 1) < me->query_skill("taiji-quanzhen", 1))
        return notify_fail("你的内功底子还不够，无法领会更高深的先天无极决。\n");

    if (me->query_skill("unarmed", 1) < me->query_skill("taiji-quanzhen", 1))
        return notify_fail("你的基本拳脚水平有限，无法领会更高深的先天无极决。\n");

    if (me->query_skill("sword", 1) < me->query_skill("taiji-quanzhen", 1))
        return notify_fail("你的基本剑法水平有限，无法领会更高深的先天无极决。\n");

    return 1;
}

/**
 * @brief 练习条件检查
 * @param object me 玩家对象
 * @return int 1表示可以练习，0表示不可以
 */
int practice_skill(object me)
{
    int cost;

    if ((int)me->query("qi") < 200)
        return notify_fail("你的体力不够练先天无极决。\n");

    cost = me->query_skill("taiji-quanzhen", 1) / 2 + 150;
    if ((int)me->query("neili") < cost)
        return notify_fail("你的内力不够练先天无极决。\n");

    me->receive_damage("qi", 150);
    me->add("neili", -cost);
    return 1;
}

/**
 * @brief 查询动作
 * @param object me 玩家对象
 * @param object weapon 武器对象
 * @return mapping 动作映射
 * @details 根据是否持剑返回不同的招式
 */
mapping query_action(object me, object weapon)
{
    int level;
    mapping *current_action;

    level = (int) me->query_skill("taiji-quanzhen", 1);

    // 根据武器状态选择招式数组
    if (weapon && weapon->query("skill_type") == "sword")
    {
        current_action = sword_action;
    }
    else
    {
        current_action = unarmed_action;
    }

    // 高等级时有特殊攻击
    if (random(8) == 5 && level > 200)
    {
        me->add("neili", -400);
        if (weapon && weapon->query("skill_type") == "sword")
        {
            return ([
                "action": HIM "$N" HIM "忽然神色大变，先天无极决剑法奥义施展而出，剑光冲天而起，\n"
                         HIM "太极之柔、全真之刚完美融合，$n" HIM "在无穷剑意面前瑟瑟发抖！" NOR,
                "attack": 280,
                "dodge" : 200,
                "parry" : 250,
                "damage": 400,
                "force" : 800,
                "damage_type": "刺伤"
            ]);
        }
        else
        {
            return ([
                "action": HIM "$N" HIM "忽然神色大变，先天无极决拳法奥义施展而出，拳劲浩荡如天地初开，\n"
                         HIM "三门武学精华完美融合，$n" HIM "在无穷拳意面前难以抵挡！" NOR,
                "attack": 270,
                "dodge" : 220,
                "parry" : 240,
                "damage": 380,
                "force" : 800,
                "damage_type": "瘀伤"
            ]);
        }
    }

    return current_action[random(sizeof(current_action))];
}

/**
 * @brief 技能提升时清理子技能
 * @param object me 玩家对象
 * @details 技能等级提升时删除原有的子技能
 */
void skill_improved(object me)
{
    int i;
    string *sub_skillnames;
    sub_skillnames = keys(sub_skills);
    for (i = 0; i < sizeof(sub_skillnames); i++)
        me->delete_skill(sub_skillnames[i]);
}

/**
 * @brief 招架特效消息
 * @param object victim_weapon 攻击方武器
 * @return string 招架消息
 */
string query_parry_msg(object victim_weapon)
{
    switch (random(4))
    {
    case 0:
        return "$n先天无极决运转，拳剑合一，$N的攻势瞬间被化解。\n";
    case 1:
        return "$n身法飘逸，三门武学融会贯通，$N只觉攻击如击虚无。\n";
    case 2:
        return "$n太极剑意流转，全真正气护体，将$N的攻势尽数挡下。\n";
    default:
        return "$n先天之气浩荡，无极之意通神，$N难以近身分毫。\n";
    }
}

/**
 * @brief 攻击命中特效
 * @param object me 攻击者
 * @param object victim 被攻击者
 * @param int damage_bonus 伤害奖励
 * @return mixed 攻击特效信息
 * @details 根据等级和武器状态提供不同的攻击特效
 */
mixed hit_ob(object me, object victim, int damage_bonus)
{
    int lvl, i, wujidaoxin_lvl, jindanmiyao_lvl;
    object weapon;
    string msg;

    lvl = me->query_skill("taiji-quanzhen", 1);
    i = random(lvl);

    if (i < 100) return;

    // 获取意境等级
    wujidaoxin_lvl = COMBAT_D->get_skill_aoyi_level(me, "无极道心");
    jindanmiyao_lvl = COMBAT_D->get_skill_aoyi_level(me, "金丹秘要");

    weapon = me->query_temp("weapon");

    if (i < 150)
    {
        COMBAT_D->real_damage(me, victim, damage_bonus / 4);

        // 意境加成
        if (wujidaoxin_lvl > 0)
        {
            COMBAT_D->real_damage(me, victim, damage_bonus * wujidaoxin_lvl / 40);
        }

        if (weapon && weapon->query("skill_type") == "sword")
        {
            msg = HIC "$N" HIC "剑意通神，先天无极决剑法精髓显现，剑气如虹，$n" HIC "顿时内府受创！" NOR "\n";
        }
        else
        {
            msg = HIR "$N" HIC "拳心通明，太极真意流转全身，拳劲透体而入，$n" HIC "顿时内府受创！" NOR "\n";
        }
        return msg;
    }
    else if (i < 200)
    {
        COMBAT_D->real_damage(me, victim, damage_bonus / 3);
        victim->add("neili", -damage_bonus / 2);

        // 意境加成
        if (wujidaoxin_lvl > 0)
        {
            victim->add("neili", -damage_bonus * wujidaoxin_lvl / 20);
        }
        if (jindanmiyao_lvl > 0)
        {
            COMBAT_D->real_damage(me, victim, damage_bonus * jindanmiyao_lvl / 30);
        }

        if (weapon && weapon->query("skill_type") == "sword")
        {
            msg = HIY "$N" HIY "剑随心转，全真道法与太极剑意合一，$n" HIY "真气紊乱，剑伤更深！" NOR "\n";
        }
        else
        {
            msg = HIY "$N" HIY "拳法圆融，三门武学精华汇聚一击，$n" HIY "真气紊乱，内息不调！" NOR "\n";
        }
        return msg;
    }
    else if (i < 280)
    {
        COMBAT_D->real_damage(me, victim, damage_bonus / 2);
        victim->add("neili", -damage_bonus);

        // 意境加成
        if (wujidaoxin_lvl > 0)
        {
            victim->add("neili", -damage_bonus * wujidaoxin_lvl / 15);
        }
        if (jindanmiyao_lvl > 0)
        {
            COMBAT_D->real_damage(me, victim, damage_bonus * jindanmiyao_lvl / 25);
        }

        if (weapon && weapon->query("skill_type") == "sword")
        {
            msg = HIM "$N" HIM "三清合一，剑法登峰造极，剑气纵横交错，$n" HIM "在无穷剑意下难以招架！" NOR "\n";
        }
        else
        {
            msg = HIM "$N" HIM "太极无极，拳意通神，刚柔相济之下，$n" HIM "在浩荡拳劲下站立不稳！" NOR "\n";
        }
        return msg;
    }
    else
    {
        COMBAT_D->real_damage(me, victim, damage_bonus);
        victim->add("neili", -damage_bonus * 3 / 2);

        // 高级意境加成
        if (wujidaoxin_lvl > 0)
        {
            victim->add("neili", -damage_bonus * wujidaoxin_lvl / 10);
            victim->receive_damage("jing", damage_bonus * wujidaoxin_lvl / 20, me);
        }
        if (jindanmiyao_lvl > 0)
        {
            COMBAT_D->real_damage(me, victim, damage_bonus * jindanmiyao_lvl / 20);
            if (jindanmiyao_lvl > 5)
            {
                victim->add("neili", -damage_bonus / 2);
            }
        }

        if (weapon && weapon->query("skill_type") == "sword")
        {
            msg = HIR "$N" HIR "先天无极决终极奥义！剑光冲天而起，天地为之变色，$n" HIR "在绝世剑意下瑟瑟发抖！" NOR "\n";
        }
        else
        {
            msg = HIR "$N" HIR "先天无极决终极奥义！拳劲浩荡如天地初开，$n" HIR "在无穷拳意下魂飞魄散！" NOR "\n";
        }
        return msg;
    }
}

/**
 * @brief 防御特效
 * @param object ob 攻击者
 * @param object me 防御者
 * @param int damage 伤害值
 * @param object weapon 攻击方武器
 * @return mixed 防御特效结果
 * @details 实现武器适应性防御特效，支持意境加成
 */
mixed valid_damage(object ob, object me, int damage, object weapon)
{
    mapping result;
    int ap, dp, cost, wujidaoxin_lvl, jindanmiyao_lvl;
    object my_weapon;
    string msg;

    if ((int)me->query_skill("taiji-quanzhen", 1) < 150
       || me->query_skill_mapped("parry") != "taiji-quanzhen"
       || (int)me->query("neili") < 300
       || !living(me))
        return;

    // 获取意境等级
    wujidaoxin_lvl = COMBAT_D->get_skill_aoyi_level(me, "无极道心");
    jindanmiyao_lvl = COMBAT_D->get_skill_aoyi_level(me, "金丹秘要");

    cost = damage / 3;
    if (cost > 200) cost = 200;

    // 意境影响内力消耗
    if (wujidaoxin_lvl > 0)
    {
        cost = cost * (10 - wujidaoxin_lvl / 2) / 10;
        if (cost < 50) cost = 50;
    }

    ap = ob->query_skill("force") * 12 + ob->query("max_neili");
    dp = me->query_skill("force") * 12 + me->query("max_neili");

    // 意境加成防御力
    if (wujidaoxin_lvl > 0)
    {
        dp += wujidaoxin_lvl * me->query_skill("taiji-quanzhen", 1) / 5;
    }
    if (jindanmiyao_lvl > 0)
    {
        dp += jindanmiyao_lvl * me->query_skill("taiji-quanzhen", 1) / 8;
    }

    my_weapon = me->query_temp("weapon");

    if (ap / 2 + random(ap) < dp)
    {
        int damage_reduction = damage * 2 / 3;
        me->add("neili", -cost);

        // 基础伤害减免

        // 意境增强伤害减免
        if (wujidaoxin_lvl > 0)
        {
            damage_reduction += damage * wujidaoxin_lvl / 20;
        }
        if (jindanmiyao_lvl > 0)
        {
            damage_reduction += damage * jindanmiyao_lvl / 30;
        }

        // 最大减免不超过90%
        if (damage_reduction > damage * 9 / 10)
        {
            damage_reduction = damage * 9 / 10;
        }

        result = ([ "damage": -damage_reduction ]);

        // 根据武器状态和意境等级选择防御消息
        if (my_weapon && my_weapon->query("skill_type") == "sword")
        {
            switch (random(4))
            {
            case 0:
                msg = HIC "$n" HIC "剑意通神，先天无极决剑法护体，$w" HIC "划出完美弧线，$N" HIC "攻势被轻松化解！" NOR "\n";
                break;
            case 1:
                msg = HIY "$n" HIY "太极剑意流转，全真道法护身，剑气如盾，$N" HIY "的攻击如泥牛入海！" NOR "\n";
                break;
            case 2:
                msg = HIM "$n" HIM "三清合一，剑法圆融无碍，$N" HIM "的招式破绽尽显无遗！" NOR "\n";
                break;
            default:
                msg = HIR "$n" HIR "先天剑罡护体，无极剑意通天，$N" HIR "的攻势瞬间瓦解！" NOR "\n";
                break;
            }
        }
        else
        {
            switch (random(4))
            {
            case 0:
                msg = HIC "$n" HIC "拳心通明，先天无极决拳法护体，双手划圆，$N" HIC "攻势被化解于无形！" NOR "\n";
                break;
            case 1:
                msg = HIY "$n" HIY "太极真意流转，以柔克刚，$N" HIY "的攻击被四两拨千斤！" NOR "\n";
                break;
            case 2:
                msg = HIM "$n" HIM "三门武学融会贯通，拳意如海，$N" HIM "的招式完全落空！" NOR "\n";
                break;
            default:
                msg = HIR "$n" HIR "先天之气护体，无极拳意通神，$N" HIR "攻势如击棉花！" NOR "\n";
                break;
            }
        }

        // 意境特殊效果
        if (wujidaoxin_lvl > 3 && random(3) == 0)
        {
            msg += HIW "$n" HIW "无极道心深藏不露，一股玄妙气息让$N" HIW "心神不宁！" NOR "\n";
            ob->add("neili", -100 - wujidaoxin_lvl * 20);
            ob->receive_damage("jing", wujidaoxin_lvl * 10, me);
        }

        if (jindanmiyao_lvl > 3 && random(4) == 0)
        {
            msg += HIB "$n" HIB "金丹秘要运转，真气如虹，反震之力让$N" HIB "内息翻腾！" NOR "\n";
            COMBAT_D->real_damage(me, ob, jindanmiyao_lvl * 15);
            ob->add("neili", -jindanmiyao_lvl * 25);
        }

        result += (["msg" : msg]);
        return result;
    }
    else
    {
        // 防御失败的特殊处理
        if (wujidaoxin_lvl > 5 || jindanmiyao_lvl > 5)
        {
            if (my_weapon && my_weapon->query("skill_type") == "sword")
            {
                msg = HIY "$n" HIY "剑法变幻莫测，虽未能完全化解$N" HIY "的攻势，但剑意犹存，伤势减轻不少。" NOR "\n";
            }
            else
            {
                msg = HIY "$n" HIY "拳法圆转如意，虽未能完全化解$N" HIY "的攻势，但拳意犹存，伤势减轻不少。" NOR "\n";
            }

            result = ([ "damage": -(damage / 4) ]);
            result += (["msg" : msg]);
            me->add("neili", -cost / 2);
            return result;
        }
    }
}

/**
 * @brief 特殊招式文件路径
 * @param string action 招式名称
 * @return string 文件路径
 */
string perform_action_file(string action)
{
    return __DIR__"taiji-quanzhen/" + action;
}

/**
 * @brief 技能难度等级
 * @return int 难度等级
 */
int difficult_level()
{
    return 1200;
}

/**
 * @brief 返回先天无极决的详细描述信息
 * @return string 包含技能介绍、学习要求、特殊招式详细说明的字符串
 * @details 提供先天无极决的完整技能说明，包括武器适应性、意境支持和绝技详解
 */
string query_description()
{
    string msg;

    msg = HIY "【先天无极决】" ZJBR NOR;
    msg += WHT "融合太极拳、太极剑法与全真剑法而成的绝世武学，集三家之精华，刚柔并济，威力无穷。" ZJBR;
    msg += WHT "此武学既有太极拳的圆融无碍，又有太极剑法的灵动飘逸，更有全真剑法的中正大气，" ZJBR;
    msg += WHT "实为武学中的极品。拳脚为主，剑法为辅，可空手可持剑，适应性极强。" ZJBR ZJBR;

    msg += HIY "〖演练要求〗" ZJBR NOR;
    msg += "  太极拳等级不低于 " HIY "700" NOR " 级。" ZJBR;
    msg += "  太极剑法等级不低于 " HIY "700" NOR " 级。" ZJBR;
    msg += "  全真剑法等级不低于 " HIY "700" NOR " 级。" ZJBR;
    msg += "  先天悟性不低于 " HIM "35" NOR " 点。" ZJBR;
    msg += "  先天根骨不低于 " HIR "30" NOR " 点。" ZJBR;
    msg += "  最大内力不低于 " HIB "100000" NOR " 点。" ZJBR;
    msg += "  内功等级不低于 " HIY "700" NOR " 级。" ZJBR;
    msg += "  基本拳脚等级不低于 " HIY "700" NOR " 级。" ZJBR;
    msg += "  基本剑法等级不低于 " HIY "700" NOR " 级。" ZJBR;
    msg += "  " HIR "注意：演练失败率60%，需要多次尝试。" NOR ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  拳脚 (unarmed) - 空手时使用。" ZJBR;
    msg += "  剑法 (sword) - 持剑时使用。" ZJBR;
    msg += "  招架 (parry) - 防御时使用。" ZJBR ZJBR;

    msg += HIY "〖武器适应性〗" ZJBR NOR;
    msg += "  " HIC "空手状态：" NOR "体现太极拳特色，招式名称包含「先天太极」「全真化劲」「无极道心」「三清合一」。" ZJBR;
    msg += "  " HIC "持剑状态：" NOR "融合剑法特色，招式名称包含「太极剑意」「全真剑气」「先天剑罡」「无极归真」。" ZJBR;
    msg += "  威力表现：空手时注重灵活变化，持剑时攻击力更强。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血不低于 " HIR "200" NOR " 点。" ZJBR;
    msg += "  内力不低于 " HIB "(先天无极决等级 / 2 + 150)" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "150" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "(先天无极决等级 / 2 + 150)" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  激发拳脚或剑法时，被动增加一次攻击机会（连击）。" ZJBR;
    msg += "  普通攻击命中时，根据等级有不同几率（random(先天无极决等级)）触发特效：" ZJBR;
    msg += "    - 100-149级：造成 (伤害奖励 / 4) 的额外气血伤害。" ZJBR;
    msg += "    - 150-199级：造成 (伤害奖励 / 3) 的气血伤害并减少对方内力。" ZJBR;
    msg += "    - 200-279级：造成 (伤害奖励 / 2) 的气血伤害、减少内力。" ZJBR;
    msg += "    - 280级以上：造成 (伤害奖励) 的大量气血伤害、大量内力损失。" ZJBR;

    msg += "  防御特效（150级以上，激发招架时触发）：" ZJBR;
    msg += "    - 触发判定：(攻击方内功*12 + 最大内力) vs (防御方内功*12 + 最大内力)" ZJBR;
    msg += "    - 成功时减少66%-90%受到的伤害（基于意境等级）。" ZJBR;
    msg += "    - 消耗内力：受到伤害 / 3（最多200点，受无极道心影响）" ZJBR ZJBR;

    msg += HIY "〖意境支持〗" ZJBR NOR;
    msg += "  " HIW "无极道心：" NOR "来自太极拳体系，增强攻防效果，减少内力消耗，增加致命一击几率。" ZJBR;
    msg += "  " HIB "金丹秘要：" NOR "来自全真剑法体系，增加伤害输出，提供额外控制效果。" ZJBR;
    msg += "  两种意境可同时生效，威力叠加。" ZJBR ZJBR;

    msg += HIY "〖特殊招式详解〗" ZJBR NOR;

    msg += HIC "  太极化劲 (taijihualin)  【防御控制型绝技】" ZJBR NOR;
    msg += "    " HIY "使用要求：" NOR ZJBR;
    msg += "      先天无极决技能基本等级 " HIY "100" NOR " 级 | 基本内功基本等级 " HIY "120" NOR " 级 | 当前内力 " HIB "250" NOR " 点" ZJBR;
    msg += "      激发招架为先天无极决" ZJBR;
    msg += "    " HIY "机制详解：" NOR ZJBR;
    msg += "      " HIC "攻击类型：" NOR "防御反震型，体现太极拳以柔克刚特性。" ZJBR;
    msg += "      " HIC "AP计算：" NOR "目标(激发招架+激发内功)" ZJBR;
    msg += "      " HIC "DP计算：" NOR "我方(激发剑法+激发拳脚)+意境加成" ZJBR;
    msg += "      " HIC "反震伤害：" NOR "激发剑法+激发拳脚+激发内功+最大精神值/2+随机((激发剑法+激发拳脚)/2)" ZJBR;
    msg += "      " HIC "内力消耗：" NOR "基础250点，无极道心减少(10-等级/3)/10，最少150点" ZJBR;
    msg += "      " HIC "意境加成：" NOR "无极道心DP+等级*(激发剑法+激发拳脚)/8，伤害+等级*(激发剑法+激发拳脚)/10" ZJBR;
    msg += "      " HIC "　　　　　　" NOR "金丹秘要DP+等级*(激发剑法+激发拳脚)/12，伤害+等级*(激发剑法+激发拳脚)/15" ZJBR;
    msg += "      " HIC "伤害类型：" NOR "real_damage真实气血伤害+内力伤害+精神伤害" ZJBR;
    msg += "    " HIY "消耗代价：" NOR "内力 " HIB "250" NOR " 点（受意境影响）| 成功时忙乱 " HIR "1" NOR " 秒，失败时忙乱 " HIR "2" NOR " 秒" ZJBR ZJBR;

    msg += HIC "  剑拳合一 (jianquanheyi)  【武器适应型攻击绝技】" ZJBR NOR;
    msg += "    " HIY "使用要求：" NOR ZJBR;
    msg += "      先天无极决技能基本等级 " HIY "150" NOR " 级 | 基本内功基本等级 " HIY "150" NOR " 级 | 当前内力 " HIB "300" NOR " 点" ZJBR;
    msg += "      空手时需激发拳脚，持剑时需激发剑法为先天无极决" ZJBR;
    msg += "    " HIY "机制详解：" NOR ZJBR;
    msg += "      " HIC "攻击特性：" NOR "武器适应性攻击，空手和持剑威力不同。" ZJBR;
    msg += "      " HIC "持剑AP：" NOR "激发剑法+先天无极决技能基本等级+激发拳脚/2+激发内功" ZJBR;
    msg += "      " HIC "空手AP：" NOR "激发拳脚+先天无极决技能基本等级+激发剑法/3+激发内功" ZJBR;
    msg += "      " HIC "DP计算：" NOR "目标激发招架+激发内功" ZJBR;
    msg += "      " HIC "持剑伤害：" NOR "AP*2+随机(AP)+技能基本等级，忙乱2秒" ZJBR;
    msg += "      " HIC "空手伤害：" NOR "AP*3/2+随机(AP*2/3)+技能基本等级，忙乱1秒" ZJBR;
    msg += "      " HIC "内力消耗：" NOR "基础300点，无极道心减少(10-等级/4)/10，最少200点" ZJBR;
    msg += "      " HIC "意境加成：" NOR "无极道心AP+等级*技能基本等级/12，伤害+等级*技能基本等级/8" ZJBR;
    msg += "      " HIC "　　　　　　" NOR "金丹秘要AP+等级*技能基本等级/15，伤害+等级*技能基本等级/10" ZJBR;
    msg += "      " HIC "额外攻击：" NOR "1/3几率触发额外攻击机会" ZJBR;
    msg += "      " HIC "伤害类型：" NOR "real_damage真实气血伤害+内力伤害+精神伤害" ZJBR;
    msg += "    " HIY "消耗代价：" NOR "内力 " HIB "300" NOR " 点（受意境影响）| 成功时忙乱 " HIR "1" NOR " 秒，失败时忙乱 " HIR "2" NOR " 秒" ZJBR ZJBR;

    msg += HIC "  全真太极阵 (quanzhentaijizheng)  【群体攻击型绝技】" ZJBR NOR;
    msg += "    " HIY "使用要求：" NOR ZJBR;
    msg += "      先天无极决技能基本等级 " HIY "200" NOR " 级 | 基本内功基本等级 " HIY "200" NOR " 级 | 当前内力 " HIB "400" NOR " 点" ZJBR;
    msg += "    " HIY "机制详解：" NOR ZJBR;
    msg += "      " HIC "攻击范围：" NOR "对战斗中所有敌人进行攻击。" ZJBR;
    msg += "      " HIC "持剑AP：" NOR "激发剑法+先天无极决技能基本等级+激发内功" ZJBR;
    msg += "      " HIC "空手AP：" NOR "激发拳脚+先天无极决技能基本等级+激发内功" ZJBR;
    msg += "      " HIC "DP计算：" NOR "目标激发招架+激发内功" ZJBR;
    msg += "      " HIC "持剑伤害：" NOR "AP+随机(AP/2)+技能基本等级/2，忙乱2秒" ZJBR;
    msg += "      " HIC "空手伤害：" NOR "AP*4/5+随机(AP/3)+技能基本等级/2，忙乱2秒" ZJBR;
    msg += "      " HIC "内力消耗：" NOR "基础400点，无极道心减少(10-等级/5)/10，最少250点" ZJBR;
    msg += "      " HIC "意境加成：" NOR "无极道心AP+等级*技能基本等级/10，伤害+等级*技能基本等级/12" ZJBR;
    msg += "      " HIC "　　　　　　" NOR "金丹秘要AP+等级*技能基本等级/12，伤害+等级*技能基本等级/15" ZJBR;
    msg += "      " HIC "未命中效果：" NOR "仍消耗150点内力" ZJBR;
    msg += "      " HIC "伤害类型：" NOR "real_damage真实气血伤害+内力伤害+精神伤害" ZJBR;
    msg += "    " HIY "消耗代价：" NOR "内力 " HIB "400" NOR " 点（受意境影响）| 自身忙乱 " HIR "3" NOR " 秒" ZJBR ZJBR;

    msg += HIC "  无极归一 (wujiguiyi)  【终极奥义单体攻击】" ZJBR NOR;
    msg += "    " HIY "使用要求：" NOR ZJBR;
    msg += "      先天无极决技能基本等级 " HIY "280" NOR " 级 | 基本内功基本等级 " HIY "280" NOR " 级" ZJBR;
    msg += "      最大内力 " HIB "5000" NOR " 点 | 当前内力 " HIB "800" NOR " 点" ZJBR;
    msg += "    " HIY "机制详解：" NOR ZJBR;
    msg += "      " HIC "多阶段攻击：" NOR "分三阶段展现，每阶段都有华丽特效。" ZJBR;
    msg += "      " HIC "持剑AP：" NOR "激发剑法+激发拳脚/2+技能基本等级+内功基本等级" ZJBR;
    msg += "      " HIC "空手AP：" NOR "激发拳脚+激发剑法/2+技能基本等级+内功基本等级" ZJBR;
    msg += "      " HIC "DP计算：" NOR "目标激发招架+激发内功" ZJBR;
    msg += "      " HIC "完全命中伤害：" NOR "AP*3+随机(AP)+技能基本等级*2+内功基本等级" ZJBR;
    msg += "      " HIC "部分命中伤害：" NOR "AP*2+随机(AP/2)+技能基本等级+内功基本等级/2" ZJBR;
    msg += "      " HIC "致命一击：" NOR "无极道心6级以上有(等级-3)/10几率触发1.5倍伤害" ZJBR;
    msg += "      " HIC "内力消耗：" NOR "基础800点，无极道心减少(10-等级/8)/10，最少500点" ZJBR;
    msg += "      " HIC "意境加成：" NOR "无极道心AP+等级*技能基本等级/6" ZJBR;
    msg += "      " HIC "　　　　　　" NOR "金丹秘要AP+等级*技能基本等级/8，6级以上额外+等级*20" ZJBR;
    msg += "      " HIC "多重损失：" NOR "气血伤害+内力损失(等于伤害)+精神损失(伤害基础值/3 + 最大精神值/3)+忙乱2-3秒" ZJBR;
    msg += "      " HIC "伤害类型：" NOR "real_damage真实气血伤害+大量内力伤害+精神伤害" ZJBR;
    msg += "    " HIY "消耗代价：" NOR ZJBR;
    msg += "      基础内力 " HIB "800" NOR " 点 + 额外内力 " HIB "200" NOR " 点" ZJBR;
    msg += "      精神消耗 " HIC "100" NOR " 点 | 自身忙乱 " HIR "3+随机(2)" NOR " 秒" ZJBR ZJBR;

    msg += HIY "〖武学特色〗" ZJBR NOR;
    msg += "  1. " HIC "三门融合：" NOR "完美融合太极拳、太极剑法、全真剑法的精华。" ZJBR;
    msg += "  2. " HIC "武器适应：" NOR "空手持剑皆可，招式特效随武器状态变化。" ZJBR;
    msg += "  3. " HIC "意境支持：" NOR "支持无极道心和金丹秘要两大意境体系。" ZJBR;
    msg += "  4. " HIC "绝技丰富：" NOR "四种绝技涵盖防御、攻击、群攻、终极等各种类型。" ZJBR;
    msg += "  5. " HIC "平衡设计：" NOR "强大威力的同时保持合理的使用条件和消耗。" ZJBR;

    return msg;
}