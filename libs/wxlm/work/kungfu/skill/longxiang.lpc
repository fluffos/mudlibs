//
// longxiang.c 龙象般若功
//



inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_force(string force)
{
	return force == "mizong-neigong" || force == "xiaowuxiang";
}

void skill_improved(object me)
{
	int lvl;

	lvl = me->query_skill("longxiang", 1);
	if (lvl > 360)
		return;

	if (lvl % 30)
		write(HIY "你修炼成了第" + chinese_number(lvl / 30 + 1) +
		      "层龙象般若功！"NOR"\n");
	else
		write(HIR "你的第" + chinese_number(lvl / 30 + 1) +
		      "层龙象般若功又增进了一层。"NOR"\n");
}

int query_neili_improve(object me)
{
	int lvl;
	// 意境等级
	int aoyi_level = COMBAT_D->get_skill_aoyi_level(me,"雪域圣光");
	lvl = (int)me->query_skill("longxiang", 1);
    if (lvl>=300) 
			  
              return lvl * lvl * 15 * 25 / 100 / 200 * (100 + aoyi_level * 6) / 100;
	else 
              return lvl * lvl * 15 * 15 / 100 / 200 * (100 + aoyi_level * 6) / 100;
}

int valid_learn(object me)
{
	if ((int)me->query_skill("force", 1) < 70)
		return notify_fail("你的基本内功火候还不够。\n");

	if (me->query("gender") == "无性" && (int)me->query_skill("longxiang", 1) > 49)
		return notify_fail("你无根无性，阴阳不调，难以领会高深的龙象般若功。\n");

	if (me->query("str") < 24)
		return notify_fail("你先天膂力不足，无法学习刚猛的龙象般若功。\n");

	if (me->query("con") < 30)
		return notify_fail("龙象般若功修行的深处需要足够的先天根骨才能发挥出强大威力，你这点根骨还是别浪费时间了。\n");

	return ::valid_learn(me);
}

mixed valid_fdamage(object ob, object me, int damage, object weapon)
{
	mixed result;
	int ap, dp;

	if (random(3)==1 || (int) me->query("con") < 31 || (int) me->query_skill("longxiang", 1) < 100 || ! living(me))
		return;

	ap = ob->query_skill("force");
	dp = me->query_skill("force");

	if (ap / 2 + random(ap) < dp)
	{
		result = HIC "$N" HIC "一招击中$n" HIC "，却感觉$n" HIC "体内一股极其强烈的内劲忽然爆发出来。\n"+
				COMBAT_D->do_respond(me, ob, damage, (me->query("con")-28)*6, HIR "$P只觉一股暗劲反击而来，顿时一阵气血翻涌！"NOR"\n");
		return result;
	}
}

int practice_skill(object me)
{
	return notify_fail("龙象般若功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"longxiang/" + func;
}

int difficult_level()
{
	object me;
	int lvl;

	if (me = this_player())
	{
		// 有無相玄功？难以学习。
		if (lvl = me->query_skill("xiaowuxiang", 1))
			return 3000;

		// 有紫阳神功？较难学习。
		if (lvl = me->query_skill("jiuyang-shengong", 1))
			return 500;
	}

	return 100;
}
string query_description()
{
    string msg;

    msg = HIY "【龙象般若功】" ZJBR NOR;
    msg += WHT "密宗至高无上护法神功，分十三层，功力层层递增。功法刚猛霸道，" ZJBR;
    msg += WHT "修炼大成时据说能力敌千军，有十龙十象之力。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功 (`force`) 等级不低于 " HIY "70" NOR " 级。" ZJBR;
    msg += "  先天膂力 (`str`) 不低于 " HIC "24" NOR " 点。" ZJBR;
    msg += "  先天根骨 (`con`) 不低于 " HIC "30" NOR " 点。" ZJBR;
    msg += "  太监身份无法学习超过 " HIY "49" NOR " 级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功 (`force`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  龙象般若功无法通过练习 (`practice`) 提升，只能通过学习 (`learn`) 或研究 (`research`) 来增加熟练度。" ZJBR ZJBR;

    msg += HIY "〖兼容内功〗" ZJBR NOR;
    msg += "  密宗内功 (`mizong-neigong`)。" ZJBR;
    msg += "  小无相功 (`xiaowuxiang`)。" ZJBR ZJBR;

    msg += HIY "〖学习难度〗" ZJBR NOR;
    msg += "  基础难度系数：" HIC "100" NOR "。" ZJBR;
    msg += "  若学习了九阳神功 (`jiuyang-shengong`)，难度系数提升至：" HIR "500" NOR "。" ZJBR;
    msg += "  若学习了小无相功 (`xiaowuxiang`)，难度系数提升至：" RED "3000" NOR "。" ZJBR ZJBR;

    msg += HIY "〖内力成长〗" ZJBR NOR;
    msg += "  内力最大值提升受龙象般若功等级影响，计算公式复杂。" ZJBR;
    msg += "  300级后成长速度加快。" ZJBR;
    msg += "  奥义「雪域圣光」等级可进一步提升内力成长效率，每级提升 " HIY "6%" NOR "。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  龙象护体：等级达到 " HIY "100" NOR " 级且先天根骨 (`con`) 大于 " HIC "31" NOR " 点后，受击时有约 33% 几率触发反震。" ZJBR;
    msg += "    反震判定：若 `攻击方内功激发等级 / 2 + 随机(攻击方内功激发等级) < 自身内功激发等级` 则成功反震。" ZJBR;
    msg += "    反震效果：反弹部分伤害给攻击方，伤害量约为 `(自身先天根骨 - 28) * 6`。" ZJBR ZJBR;

    msg += HIY "〖特殊运用 (Exert)〗" ZJBR NOR;

    msg += HIC "  龙象加力 (powerup)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      龙象般若功等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "1000" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升自身攻击力（`attack`）和防御力（`defense`），提升数值约为 `龙象般若功等级 / 2`。" ZJBR;
    msg += "      效果持续时间约为 `龙象般若功等级 / 4` 秒。" ZJBR;
    msg += "      奥义「龙象加力」等级可提升效果，每级提升 " HIY "5%" NOR "。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "500" NOR " 点。" ZJBR;
    msg += "    冷却时间：" HIM "10" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  龙啸九天 (roar)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      龙象般若功等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      基本内功 (`force`) 等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "1500" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      发出震天龙吟，对周围所有敌人造成范围伤害。" ZJBR;
    msg += "      命中判定：基于双方龙象般若功、基本内功、气血上限等综合计算 (`(自身龙象等级 + 自身内功激发等级) / 2` 对比 `目标内功激发等级 + 目标最大气血 / 100`)。" ZJBR;
    msg += "      命中后对目标造成气血和精神伤害。" ZJBR;
    msg += "      有几率使未命中的目标或伤害较低的目标陷入忙乱。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "800" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "3" NOR " 秒。" ZJBR;
    msg += "    冷却时间：" HIM "15" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  龙象护体 (shield)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      龙象般若功等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "500" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      凝聚内力形成护体气劲，提升自身防御。" ZJBR;
    msg += "      效果持续时间约为 `龙象般若功等级 / 2` 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "    冷却时间：" HIM "8" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 龙象般若功每提升一层（约30级）均有提示，是循序渐进的强力内功。" ZJBR;
    msg += "2. 修炼此功法对先天属性（膂力、根骨）有较高要求。" ZJBR;
    msg += "3. 与小无相功、九阳神功同时修炼会大幅增加学习难度。" ZJBR;
    msg += "4. 被动反震效果依赖高等级和高根骨支持。" ZJBR;

    return msg;
}