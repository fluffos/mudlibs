int valid_enable(string usage) { return usage=="finger" || usage=="parry"; }


int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练玄阴指法必须空手。\n");

	if ((int)me->query_skill("force") < 200)
		return notify_fail("你的内功火候不够，无法学玄阴指法。\n");

	if ((int)me->query("max_neili") < 800)
		return notify_fail("你的内力太弱，无法练玄阴指法。\n");

	if ((int)me->query_skill("finger", 1) < (int)me->query_skill("huanyin-zhi", 1))
		return notify_fail("你的基本指法水平有限，无法领会更高深的玄阴指法。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("huanyin-zhi",1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 80)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 75)
		return notify_fail("你的内力不够练玄阴指法。\n");

	me->receive_damage("qi", 72);
	me->add("neili", -69);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"huanyin-zhi/" + action;
}

/**
 * @brief 查询幻阴指的详细信息
 * @return string 技能描述信息
 * @details 返回幻阴指的详细介绍，包括基本介绍、学习要求、激发类型、练习要求、被动效果和特殊招式。
 */
string query_description()
{
    string msg;

    msg = HIY "【幻阴指】" ZJBR NOR;
    msg += WHT "幻阴指是一门极为阴寒狠毒的指法，指力所到处，寒气刺骨。" ZJBR;
    msg += "此指法以纯阴内力催动，无形无质，专伤敌人经脉脏腑。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  基本内功等级 " HIY "200" NOR " 级。" ZJBR; // line 75
    msg += "  最大内力 " HIB "800" NOR " 点。" ZJBR; // line 78
    msg += "  基本指法等级须大于等于幻阴指等级。" ZJBR; // line 81
    msg += "  空手状态。" ZJBR ZJBR; // line 72

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  指法（finger）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  气血：不低于 " HIR "80" NOR " 点。" ZJBR; // line 104
    msg += "  内力：不低于 " HIB "75" NOR " 点。" ZJBR; // line 107
    msg += "  每次练习消耗气血：" HIR "72" NOR " 点。" ZJBR; // line 110
    msg += "  每次练习消耗内力：" HIB "69" NOR " 点。" ZJBR ZJBR; // line 111

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR; // 未发现 hit_ob, valid_damage 等函数

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform_action_file & huanyin.c
    msg += HIC "  幻阴一指 (huanyin)" ZJBR NOR; // huanyin.c query_name, Renamed from "幻阴一指"
    msg += "    使用要求：" ZJBR;
    msg += "      幻阴指等级 " HIY "150" NOR " 级。" ZJBR; // huanyin.c line 30
    msg += "      基本内功等级 " HIY "300" NOR " 级。" ZJBR; // huanyin.c line 27
    msg += "      当前内力 " HIB "400" NOR " 点。" ZJBR; // huanyin.c line 36
    msg += "      激发指法为幻阴指。" ZJBR; // huanyin.c line 33
    msg += "      战斗中使用。" ZJBR; // huanyin.c line 18
    msg += "    效果描述：" ZJBR;
    msg += "      以阴寒指力攻击目标。" ZJBR;
    msg += "      命中判定：((基本指法等级 / 2 + 幻阴指等级) / 2 + 随机(判定值)) > 目标内功激发等级。" ZJBR; // huanyin.c line 49
    msg += "      命中后伤害：造成 (基本指法等级 / 2 + 幻阴指等级 + 随机(上一项 / 2)) 的伤害。" ZJBR; // huanyin.c line 52, 53
    msg += "      命中后附加效果：100% 使目标中 幻阴寒毒 (`huanyin_poison`)。" ZJBR; // huanyin.c line 57
    msg += "          中毒时间：((基本指法等级 / 2 + 幻阴指等级) / 40 + 随机((基本指法等级 / 2 + 幻阴指等级) / 18)) 秒。" ZJBR; // huanyin.c line 61
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 " HIB "320" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR; // huanyin.c line 62, 63
    msg += "      未命中：消耗内力 " HIB "80" NOR " 点，自身忙乱 " HIR "4" NOR " 秒。" ZJBR; // huanyin.c line 68, 69
    msg += "      会主动攻击目标。" ZJBR ZJBR; // huanyin.c line 71, 72

    // 原文档中的 幻阴连环(lianhua) 招式及被动效果在代码中未找到，已移除
    // 原文档中的 【注意事项】 非标准格式，已移除

    return msg;
}