// houquan.c 猴拳

inherit SKILL;

mapping *action = ({
([      "action" : "$N单腿微曲，忽的向前扑出，一式「仙猴摘桃」，二爪直出，抓向$n的双眼",
	"force" : 180,
	"dodge" : 5,
	"damage": 10,
	"damage_type" : "抓伤",
	"lvl" : 0,
	"skill_name" : "横空出世"
]),
([      "action" : "$N左手虚晃，一式「灵猴攀枝」，右手直击，反扣$n的肩井大穴",
	"force" : 200,
	"dodge" : 10,
	"damage": 20,
	"lvl" : 30,
	"skill_name" : "灵猴攀枝",
	"damage_type" : "瘀伤"
]),
([      "action" : "$N一臂前伸，一臂后指，一式「猿臂轻舒」，攻向$n的两肋",
	"force" : 230,
	"dodge" : 10,
	"damage": 25,
	"lvl" : 40,
	"skill_name" : "猿臂轻舒",
	"damage_type" : "瘀伤"
]),
([      "action" : "$N忽然缩成一团，使一式「八方幻影」，双掌无形无定，一爪抓向$n的胸口",
	"force" : 230,
	"dodge" : 25,
	"damage": 20,
	"lvl" : 50,
	"skill_name" : "八方幻影",
	"damage_type" : "内伤"
]),
([      "action" : "$N猛吸一口气，一弯腰，使一式「水中揽月」，双爪疾扣向$n的小腹",
	"force" : 220,
	"dodge" : 15,
	"damage": 10,
	"damage_type" : "瘀伤",
	"lvl" : 60,
	"skill_name" : "水中揽月"
]),
([      "action" : "$N猛的向上高高跃起，一式「落地摘星」，居高临下，一爪罩向$n的头骨",
	"force" : 240,
	"dodge" : 20,
	"damage": 20,
	"damage_type" : "抓伤",
	"lvl" : 70,
	"skill_name" : "落地摘星"
]),
});

int valid_enable(string usage) { return usage=="unarmed" ||  usage=="parry"|| usage=="hand"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练猴拳必须空手。\n");

	if ((int)me->query_skill("force", 1) < 30)
		return notify_fail("你的基本内功火候不够，无法学猴拳。\n");

	if ((int)me->query("max_neili") < 200)
		return notify_fail("你的内力太弱，无法练猴拳。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int)me->query_skill("houquan", 1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 40)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 20)
		return notify_fail("你的内力不够练猴拳。\n");

	me->receive_damage("qi", 25);
	me->add("neili", -18);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"houquan/" + action;
}


/**
 * @brief 查询猴拳的详细信息
 * @return string 技能描述信息
 * @details 返回猴拳的详细介绍，包括基本介绍、学习要求、激发类型、练习要求、被动效果和特殊招式。
 */
string query_description()
{
    string msg;

    msg = HIY "【猴拳】" ZJBR NOR;
    msg += WHT "猴拳是一种模仿猴子动作的拳法，以其灵活多变和诡异难测而著称。" ZJBR;
    msg += "此拳法讲究敏捷和灵活，招式变化莫测，令对手难以防范。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功等级 " HIY "30" NOR " 级。" ZJBR;
    msg += "  最大内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "  空手状态。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  拳法（unarmed）。" ZJBR;
    msg += "  手法（hand）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "40" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "20" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "25" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "18" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  震字诀 (zhen)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      猴拳等级 " HIY "50" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      空手状态。" ZJBR;
    msg += "      战斗中使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      尝试以自身内功震伤对手。" ZJBR;
    msg += "      命中判定：自身 (内功激发等级) 与 目标 (内功激发等级 / 2) 进行随机比较。" ZJBR;
    msg += "      命中后伤害：造成 ((内功激发等级 / 3) + 随机(内功激发等级 / 3)) 的内伤伤害。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "80" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    return msg;
}
