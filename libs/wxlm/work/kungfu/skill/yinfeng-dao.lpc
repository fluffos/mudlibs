inherit SKILL;

mapping *action = ({
([      "action" : "$N身形急晃，一跃而至$n跟前，右掌带着切骨寒气砍向$n的$l",
	"force" : 160,
	"attack": 25,
	"dodge" : 15,
	"parry" : 15,
	"damage": 10,
	"lvl"   : 0,
	"skill_name" : "切骨寒气",
	"damage_type" : "割伤"
]),
([      "action" : "$N飞身跃起，双掌至上而下斜砍而出，顿时万千道阴风寒劲从四面八方席卷$n",
	"force" : 220,
	"attack": 40,
	"dodge" : 20,
	"parry" : 15,
	"damage": 20,
	"lvl"   : 30,
	"skill_name" : "阴风寒劲",
	"damage_type" : "割伤"
]),
([      "action" : "$N平掌为刀，斜斜砍出，掌劲幻出一片片切骨寒气如飓风般裹向$n的全身",
	"force" : 280,
	"attack": 50,
	"dodge" : 20,
	"parry" : 25,
	"damage": 28,
	"lvl"   : 60,
	"skill_name" : "切骨寒气",
	"damage_type" : "割伤"
]),
([      "action" : "$N反转右掌对准自己护住全身，突然一个筋斗翻至$n面前，左掌横向$n拦腰砍去",
	"force" : 360,
	"attack": 60,
	"dodge" : 80,
	"parry" : 60,
	"damage": 35,
	"lvl"   : 80,
	"skill_name" : "反转右掌",
	"damage_type" : "割伤"
]),
([      "action" : "$N右掌后撤，手腕一翻，猛地挥掌砍出，幻出一道寒芒直斩向$n的$l",
	"force" : 420,
	"attack": 110,
	"dodge" : 45,
	"parry" : 40,
	"damage": 50,
	"lvl"   : 100,
	"skill_name" : "寒芒直斩",
	"damage_type" : "割伤"
]),
});

int valid_enable(string usage) { return usage=="strike" || usage=="parry"; }

int valid_combine(string combo) { return combo=="tougu-zhen"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练阴风刀必须空手。\n");

	if ((int)me->query_skill("force") < 200)
		return notify_fail("你的内功火候不够，无法练习阴风刀。\n");

	if ((int)me->query("max_neili") < 1400)
		return notify_fail("你的内力太弱，无法练习阴风刀。\n");

	if ((int)me->query_skill("strike", 1) < 100)
		return notify_fail("你的基本掌法火候不够，无法练习阴风刀。\n");

	if ((int)me->query_skill("strike", 1) < (int)me->query_skill("yinfeng-dao", 1))
		return notify_fail("你的基本掌法水平有限，无法领会更高深的阴风刀。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level   = (int) me->query_skill("yinfeng-dao",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 100)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 100)
		return notify_fail("你的内力不够练阴风刀。\n");

	me->receive_damage("qi", 80);
	me->add("neili", -80);
	return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int lvl;
	int flvl;

	lvl  = me->query_skill("yinfeng-dao", 1);
	flvl = me->query("jiali");
	if (lvl < 80 || flvl < 10 || ! damage_bonus)
		return;

	if (flvl * 2 + random(lvl) > victim->query_skill("force") &&
	    victim->affect_by("yinfeng_dao",
			      ([ "level" : flvl + random(flvl),
				 "id"    : me->query("id"),
				 "duration" : lvl / 100 + random(lvl / 10) ])))
	{
		return "$n只感一阵刮骨之痛，看来是受了对方阴风刀内劲的干扰。\n";
	}
}

string perform_action_file(string action)
{
	return __DIR__"yinfeng-dao/" + action;
}


string query_description()
{
    string msg;

    msg = HIY "【阴风刀】" ZJBR NOR;
    msg += WHT "阴风刀是一门以阴寒内劲著称的高级掌法。" ZJBR;
    msg += WHT "此掌法招式凌厉狠辣，如切骨寒风，威力强大，令人难以抵挡。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本掌法等级：" HIY "100" NOR " 级" ZJBR;
    msg += "  基本内功等级：" HIY "200" NOR " 级" ZJBR;
    msg += "  最大内力：" HIY "1400" NOR " 点" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  掌法（strike）" ZJBR;
    msg += "  招架（parry）" ZJBR ZJBR;

    msg += HIY "〖可互备招式〗" ZJBR NOR;
    msg += "  透骨针（tougu-zhen）" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血消耗：" HIR "80" NOR " 点" ZJBR;
    msg += "  内力消耗：" HIY "80" NOR " 点" ZJBR ZJBR;

    msg += HIY "〖攻防特效〗" ZJBR NOR;
    msg += "  当阴风刀等级达到 " HIY "80" NOR " 级，且加力值不低于 " HIY "10" NOR " 点时：" ZJBR;
    msg += "  攻击时有几率使目标受到阴风刀内劲干扰，造成持续性伤害" ZJBR;
    msg += "  触发几率：加力值 * 2 + 随机(阴风刀等级) > 目标内功有效激发等级" ZJBR;
    msg += "  内伤程度：加力值 + 随机(加力值)" ZJBR;
    msg += "  持续时间：阴风刀等级 / 100 + 随机(阴风刀等级 / 10) 秒" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  阴风绝杀（jue）" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      阴风刀等级不低于 " HIY "100" NOR " 级" ZJBR;
    msg += "      内功有效激发等级不低于 " HIY "160" NOR " 级" ZJBR;
    msg += "      最大内力不低于 " HIY "1000" NOR " 点" ZJBR;
    msg += "      当前内力不低于 " HIY "500" NOR " 点" ZJBR;
    msg += "      必须激发阴风刀为掌法" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      掌劲幻出一片片切骨寒气如飓风般裹向敌人全身" ZJBR;
    msg += "      攻击力(AP)计算：掌法有效激发等级 + 内功有效激发等级" ZJBR;
    msg += "      防御力(DP)计算：目标招架有效激发等级 + 目标轻功有效激发等级" ZJBR;
    msg += "      命中判定：系统内部判定函数hit_determination决定" ZJBR;
    msg += "      成功则造成伤害：AP / 3 + 随机(AP / 4) 点" ZJBR;
    msg += "      并使目标受到阴风刀内劲干扰，造成持续性伤害" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中消耗内力 " HIY "250" NOR " 点，未命中消耗 " HIY "50" NOR " 点" ZJBR;
    msg += "      命中后自身忙乱 " HIR "1" NOR " 秒，未命中则忙乱 " HIR "3" NOR " 秒" ZJBR ZJBR;

    msg += HIR "〖注意事项〗" ZJBR NOR;
    msg += "  1. 阴风刀需要强大的内功支持，练习时需注意提高内功修为" ZJBR;
    msg += "  2. 在实战中，善用阴风刀的阴寒特性可削弱敌人战斗力" ZJBR;
    msg += "  3. 特殊招式威力强大，但消耗巨大，使用需谨慎" ZJBR;
    msg += "  4. 阴风刀可与透骨针互备，提高攻击的多样性";

    return msg;
}
