int valid_enable(string usage) { return usage == "strike" ||  usage == "parry"; }

int valid_combine(string combo) { return combo=="shenghuo-quan"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
                return notify_fail("练光明神掌必须空手。\n");

        if ((int)me->query_skill("strike", 1) < 10)
                return notify_fail("你的基本掌法火候不够，无法练光明神掌。\n");


        if ((int)me->query_skill("strike", 1) < (int)me->query_skill("guangming-zhang", 1))
                return notify_fail("你的基本掌法水平有限，无法领会更高深的光明神掌。\n");

	return 1;
}

string query_skill_name(int level)
{
        int i;
        for (i = sizeof(action)-1; i >= 0; i--)
                if (level >= action[i-1]["lvl"])
                        return action[i-1]["skill_name"];
}

mapping query_action(object me, object weapon)
{
        int i, level;
        level = (int)me->query_skill("guangming-zhang", 1);
        for (i = sizeof(action); i > 0; i--)
                if (level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 60)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 70)
                return notify_fail("你的内力不够了。\n");

	me->receive_damage("qi", 20);
	me->add("neili", -30);
	return 1;
}

string perform_action_file(string action)
{
      return __DIR__"guangming-zhang/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【光明神掌】" ZJBR NOR;
    msg += "光明神掌乃明教高深掌法，招式繁复，变化万千，以刚猛凌厉著称。" ZJBR;
    msg += "此掌法通过运转内力于双掌，发出耀眼光芒攻向敌人，威力强大。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  必须空手状态。" ZJBR;
    msg += "  基本掌法 (strike) 等级不低于 " HIY "10" NOR " 级。" ZJBR;
    msg += "  基本掌法 (strike) 等级不低于光明神掌等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  掌法（strike）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  当前气血不低于 " HIR "60" NOR " 点。" ZJBR;
    msg += "  当前内力不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "20" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "30" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  可与圣火拳 (shenghuo-quan) 组合施展。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIW "  圣火普照 (puzhao)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      光明神掌 (guangming-zhang) 等级不低于 " HIY "80" NOR " 级。" ZJBR;
    msg += "      激发内功 (force) 等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "      激发掌法为光明神掌。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：攻击力(AP) = (自身基本掌法等级 + 激发内功等级)，防御力(DP) = (目标招架等级 + 目标激发内功等级)。若 (AP / 2 + 随机(AP)) > DP 则命中。" ZJBR;
    msg += "      命中后对目标造成远程伤害，伤害值约为 (光明神掌等级 + 自身加力值 + 随机(光明神掌等级 / 2))。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "      忙乱 " HIR "2" NOR " 秒。" ZJBR;

    return msg;
}