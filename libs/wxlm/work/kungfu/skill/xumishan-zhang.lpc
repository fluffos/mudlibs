int valid_enable(string usage) { return usage == "strike" ||  usage == "parry"; }

int valid_combine(string combo) { return combo == "jingang-zhi"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练须弥山掌必须空手。\n");

	if ((int)me->query_skill("force", 1) < 300)
		return notify_fail("你的基本内功火候不够，无法学须弥山掌。\n");

	if ((int)me->query("max_neili") < 2000)
		return notify_fail("你的内力太弱，无法练须弥山掌。\n");

	if ((int)me->query_skill("strike", 1) < (int)me->query_skill("xumishan-zhang", 1))
		return notify_fail("你的基本掌法水平有限，无法领会更高深的须弥山掌。\n"); 

	return 1;
}

string query_skill_name(int level)
{
	int i;

	for (i = sizeof(action) - 1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;

	level = (int)me->query_skill("xumishan-zhang", 1);

	for (i = sizeof(action); i > 0; i--)
		if (level > action[i - 1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 90)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 120)
		return notify_fail("你的内力不够练须弥山掌。\n");

	me->receive_damage("qi", 80);
	me->add("neili", -110);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"xumishan-zhang/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【须弥山掌】" ZJBR NOR;
    msg += WHT "须弥山掌是少林派的高级掌法，以刚猛有力著称。" ZJBR;
    msg += "此掌法招式大开大合，如山岳般厚重，攻击力强大。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本掌法等级：" HIY "须弥山掌等级" NOR " 级" ZJBR;
    msg += "  基本内功等级：" HIY "300" NOR " 级" ZJBR;
    msg += "  最大内力：" HIY "2000" NOR " 点" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  掌法(strike)" ZJBR;
    msg += "  招架(parry)" ZJBR ZJBR;

    msg += HIY "〖可互备武功〗" ZJBR NOR;
    msg += "  金刚指(jingang-zhi)" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血消耗：" HIR "80" NOR " 点" ZJBR;
    msg += "  内力消耗：" HIR "110" NOR " 点" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  群山叠影(ying)" NOR ZJBR;
    msg += "  使用要求：" ZJBR;
    msg += "    须弥山掌等级 " HIY "150" NOR " 级" ZJBR;
    msg += "    当前内力 " HIY "500" NOR " 点" ZJBR;
    msg += "    空手状态" ZJBR;
    msg += "    须弥山掌激发为掌法" ZJBR;
    msg += "    战斗状态中" ZJBR;
    msg += "  效果描述：" ZJBR;
    msg += "    向对手连续发动多次攻击" ZJBR;
    msg += "    判定成功：当随机值((内功有效激发 + 掌法有效激发) > 对方内功有效激发)时" ZJBR;
    msg += "    命中后增加自身攻击力：须弥山掌等级 / 5" ZJBR;
    msg += "    未命中则无攻击力提升" ZJBR;
    msg += "  消耗与代价：" ZJBR;
    msg += "    总计内力消耗：" HIR "300" NOR " 点(成功命中时为" HIR "300" NOR "点)" ZJBR;
    msg += "    自身忙乱：" HIR "1-5" NOR " 秒" ZJBR ZJBR;

    msg += HIR "〖注意事项〗" ZJBR NOR;
    msg += "1. 须弥山掌需要强大的内功支持，练习时需注意提高内功修为。" ZJBR;
    msg += "2. 在实战中，要善于利用掌法的刚猛特性，以力破巧。" ZJBR;
    msg += "3. 特殊招式「群山叠影」威力强大，但也较为耗费内力，使用需谨慎。" ZJBR;
    msg += "4. 可以与金刚指互备，增加攻击的多样性。\n";

    return msg;
}
