string *usage_skills = ({ "sword", "blade", "dagger","staff", "hammer", "club", "whip","dodge", "parry", "force", "throwing" });

int valid_enable(string usage)
{
	return (member_array(usage, usage_skills) != -1);
}

int valid_combo(string combo)
{
	return combo == "never-defeated";
}

int valid_force(string force) { return 1; }

int double_attack() { return 1; }

mapping query_action(object me, object weapon)
{
	switch (weapon ? weapon->query("skill_type") : "default")
	{
	case "whip":
		return action_whip[random(sizeof(action_whip))];
	default:
		return action_default[random(sizeof(action_default))];
	}
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int valid_learn(object me)
{
	int level;
 

	if ((int)me->query("combat_exp") < 3000000 && !me->query("relife/zhuanshi") )
		return notify_fail("你觉得不败神功深奥之极，"
				   "凭自己的战斗经验一时间难以领会。\n");

	if ((int)me->query_skill("martial-cognize", 1) < 50)
		return notify_fail("你觉得不败神功过于深奥，以"
				   "自己的武学修养全然无法明白。\n");

	if (me->query("character") != "狡黠多变")
		return notify_fail("你学了半天，发现不败神功古怪的"
				   "紧，不合常理，根本无法领会。");

	if (me->query("int") < 22)
		return notify_fail("你觉得不败神功过于深奥，绝"
				   "非自己的智力所能理解。\n");

	if (me->query("gender") == "无性" &&
	    (int)me->query_skill("never-defeated", 1) > 239)
		return notify_fail("你无根无性，阴阳不调，难以领会高深的不败神功。\n");

	level = me->query_skill("never-defeated", 1);

	if ((int)me->query_skill("martial-cognize", 1) < 300 &&
	    (int)me->query_skill("martial-cognize", 1) < level)
		return notify_fail("你觉得自己的武学修养有限，难以领会更高深的不败神功。\n");

	if (me->query_skill("force", 1) < level)
		return notify_fail("你对基本内功的理解还不够，无法继续"
				   "领会更高深的不败神功。\n");

	if (me->query_skill("parry", 1) < level)
		return notify_fail("你对基本招架的理解还不够，无法继续"
				   "领会更高深的不败神功。\n");

	if (me->query_skill("dodge", 1) < level)
		return notify_fail("你对基本轻功的理解还不够，无法继续"
				   "领会更高深的不败神功。\n");

	if (me->query_skill("sword", 1) < level)
		return notify_fail("你对基本剑法的理解还不够，无法继续"
				   "领会更高深的不败神功。\n");

	if (me->query_skill("blade", 1) < level)
		return notify_fail("你对基本刀法的理解还不够，无法继续"
				   "领会更高深的不败神功。\n");

	if (me->query_skill("whip", 1) < level)
		return notify_fail("你对基本鞭法的理解还不够，无法继续"
				   "领会更高深的不败神功。\n");

	if (me->query_skill("throwing", 1) < level)
		return notify_fail("你对基本暗器的理解还不够，无法继续"
				   "领会更高深的不败神功。\n");

	return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	int lvl;
	int i;
	object weapon;

	lvl = me->query_skill("martial-cognize", 1);
	i = random(lvl);
	
	if (objectp(weapon = me->query_temp("weapon")) &&
	    (string)weapon->query("skill_type") == "sword" &&
	    i > 60 && random(2) == 0)
	{
		if (i < 120)
		{
			victim->receive_wound("qi", damage_bonus / 6);
			return HIC "只见$N" HIC "这招已然刺伤$n" HIC
			       "，怎知$N" HIC "内劲吞吐，剑气直侵$n" HIC "体内！"NOR"\n";
		}
		if (i < 180)
		{
			victim->receive_wound("qi", damage_bonus / 4);
			return HIG "但见$N" HIG "微微一笑，全身劲气贯于" NOR + 
			       weapon->name() + HIG "中，剑气源源不断扑向$n" 
			       HIG "！"NOR"\n";
		}
		if (i < 240)
		{
			victim->receive_wound("qi", damage_bonus / 3);
			return HIW "但见$N" HIW "凝神聚气，运转手中" NOR + 
			       weapon->name() + HIW"，刹那间犹如狂风骤起，"
			       "剑气猛地卷向$n" HIW "！"NOR"\n";
		}
		else
		{
			victim->receive_wound("qi", damage_bonus / 2);
			return HIM "$N" HIM "默运内劲在" NOR + weapon->name() +
			       HIM "上攻出一招，霎时间只见剑气层层叠叠如波浪般"
			       "汹涌而起杀向$n" HIM "！"NOR"\n";
		}
	}
}

int practice_skill(object me)
{
	return notify_fail("不败神功博大精深，无法简单的通过练习进步。\n");
}

int difficult_level()
{
	return 500;
}

string perform_action_file(string action)
{
	return __DIR__"never-defeated/perform/" + action;
}

string exert_function_file(string action)
{
	return __DIR__"never-defeated/exert/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【不败神功】" ZJBR NOR;
    msg += "    一门集多种兵器、拳脚、身法、内功于一体的综合武学，招式变化莫测，兼具攻击与防御。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "    性格：" WHT "狡黠多变" NOR "。" ZJBR;
    msg += "    先天悟性：" HIY "22" NOR " 点。" ZJBR;
    msg += "    经验：" HIM "3,000,000" NOR " 点（转世后无此限制）。" ZJBR;
    msg += "    武学修养：" HIC "50" NOR " 级。" ZJBR;
    msg += "    " HIC "太监（无性）" NOR "：最高只能学到 " HIY "240" NOR " 级。" ZJBR;
    msg += "    若 " HIR "武学修养 < 300" NOR " 级，则需 " HIR "武学修养 ≥ 不败神功等级" NOR "。" ZJBR;
    msg += "    以下基础技能等级需不低于不败神功等级：" ZJBR;
    msg += "      基本内功 (force)" ZJBR;
    msg += "      基本招架 (parry)" ZJBR;
    msg += "      基本轻功 (dodge)" ZJBR;
    msg += "      基本剑法 (sword)" ZJBR;
    msg += "      基本刀法 (blade)" ZJBR;
    msg += "      基本鞭法 (whip)" ZJBR;
    msg += "      基本暗器 (throwing)" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "    内功 (force)" ZJBR;
    msg += "    轻功 (dodge)" ZJBR;
    msg += "    招架 (parry)" ZJBR;
    msg += "    剑法 (sword)" ZJBR;
    msg += "    刀法 (blade)" ZJBR;
    msg += "    匕首 (dagger)" ZJBR;
    msg += "    杖法 (staff)" ZJBR;
    msg += "    锤法 (hammer)" ZJBR;
    msg += "    棍法 (club)" ZJBR;
    msg += "    鞭法 (whip)" ZJBR;
    msg += "    暗器 (throwing)" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "    该技能无法通过练习 (`practice`) 提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // query_neili_improve, hit_ob, double_attack
    msg += "    提升内力上限：等级^2 * 20 * 15 / 100 / 200。" ZJBR;
    msg += "    攻击命中特效 (`hit_ob`)：" ZJBR;
    msg += "      当使用剑 (`sword`) 时，有几率（受武学修养影响）对目标造成额外气血伤害（伤害量受 `damage_bonus` 和武学修养影响）。" ZJBR;
    msg += "    连击 (`double_attack`)：可能触发连击效果。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (exert)〗" ZJBR NOR; // exert files

    msg += CYN "  不败战意 (powerup)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      当前内力 ≥ " HIB "100" NOR " 点。" ZJBR;
    msg += "      不在战意状态下。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升自身攻击力（增加 不败神功等级 * 2 / 5）。" ZJBR;
    msg += "      提升自身防御力（增加 不败神功等级 * 2 / 5）。" ZJBR;
    msg += "      效果持续时间等于不败神功等级。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力：" HIB "100" NOR " 点。" ZJBR;
    msg += "      战斗中施展：忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += CYN "  天地长吟 (roar)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      当前内力 ≥ " HIB "100" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对周围所有角色进行范围攻击。" ZJBR;
    msg += "      伤害判定：(自身不败神功等级 * 2 / 2 + 随机(自身不败神功等级 * 2 / 2)) < 目标后天根骨 * 2 则无效。" ZJBR;
    msg += "      基础气血伤害：自身不败神功等级 * 2。" ZJBR;
    msg += "      若目标内力 < 自身不败神功等级 * 2 * 2，则追加一次气血伤害。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力：" HIB "100" NOR " 点。" ZJBR;
    msg += "      气血：" HIR "10" NOR " 点。" ZJBR;
    msg += "      忙乱：" HIR "5" NOR " 秒。" ZJBR ZJBR;

    msg += CYN "  金刚不坏 (shield)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      当前内力 ≥ " HIB "100" NOR " 点。" ZJBR;
    msg += "      不在护体状态下。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升自身招架力（增加 不败神功等级 / 2）。" ZJBR;
    msg += "      提升自身轻功（增加 不败神功等级 / 2）。" ZJBR;
    msg += "      效果持续时间等于不败神功等级。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力：" HIB "100" NOR " 点。" ZJBR;
    msg += "      战斗中施展：忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (perform)〗" ZJBR NOR; // perform files

    msg += HIC "  破字诀 (po)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      不败神功 ≥ " HIY "100" NOR " 级。" ZJBR;
    msg += "      基本兵器掌握 ≥ " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力 ≥ " HIB "150" NOR " 点。" ZJBR;
    msg += "      装备兵器。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      连续攻击目标数次。" ZJBR;
    msg += "      命中判定：(自身不败神功等级 * 3 / 2 + 自身武学修养 * 3 / 2) > 目标 (招架技能等级 * 3 / 2 + 目标武学修养)。" ZJBR;
    msg += "      命中后有几率打落目标武器，几率受双方兵器技能、不败神功、膂力、内力影响。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力：" HIB "100" NOR " 点。" ZJBR;
    msg += "      忙乱：" HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  御策器决 (yuce)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      不败神功 ≥ " HIY "100" NOR " 级。" ZJBR;
    msg += "      基本暗器 ≥ " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 ≥ " HIB "150" NOR " 点。" ZJBR;
    msg += "      装备可投掷暗器。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      投掷暗器攻击目标。" ZJBR;
    msg += "      命中判定：自身暗器技能 > 目标招架技能等级 * 2 / 3。" ZJBR;
    msg += "      伤害计算：基础伤害 = 不败神功等级 / 2 + 随机(不败神功等级 / 3)。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力：" HIB "120" NOR " 点。" ZJBR;
    msg += "      忙乱：" HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  天地绝灭 (juemie)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      不败神功 ≥ " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 ≥ " HIB "200" NOR " 点。" ZJBR;
    msg += "      装备兵器。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标造成一次强力攻击。" ZJBR;
    msg += "      命中判定：(自身不败神功等级 * 2 + 自身先天悟性 * 20 + 自身武学修养) > 目标 (轻功技能等级 * 3 / 2 + 目标后天身法 * 20 + 目标武学修养)。" ZJBR;
    msg += "      伤害计算：基础伤害 = 不败神功等级 + 随机(不败神功等级 / 3)。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力：" HIB "120" NOR " 点。" ZJBR;
    msg += "      忙乱：" HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  天打雷劈 (lei)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      不败神功 ≥ " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力 ≥ " HIB "300" NOR " 点。" ZJBR;
    msg += "      装备兵器。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标造成一次基于内力和技能等级的伤害，有几率直接击杀目标。" ZJBR;
    msg += "      伤害计算：基础伤害 = (内力 / 10) + 随机(不败神功等级)。" ZJBR;
    msg += "      致命判定：随机(自身不败神功等级) > (目标经验 / 10000)。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力：" HIB "60" NOR " 点。" ZJBR;
    msg += "      忙乱：" HIR "4" NOR " 秒。" ZJBR ZJBR;

    // Wanli 和 Tianhua 的信息需要读取文件确认
    // 假设已读取 wanli.c 和 tianhua.c
    msg += HIC "  万里黄沙 (wanli)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      不败神功 ≥ " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力 ≥ " HIB "200" NOR " 点。" ZJBR;
    msg += "      装备兵器。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标造成范围攻击，并附加忙乱状态。" ZJBR;
    msg += "      伤害计算：基础伤害 = 不败神功等级 + 随机(不败神功等级)。" ZJBR;
    msg += "      命中及附加状态判定：(自身不败神功等级 / 3 + 随机(自身不败神功等级 / 3) * 2) > 目标轻功技能等级。" ZJBR;
    msg += "      附加忙乱时间：2 + 随机(2) 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力：" HIB "100" NOR " 点。" ZJBR;
    msg += "      忙乱：" HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  天花乱坠 (tianhua)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      不败神功 ≥ " HIY "100" NOR " 级。" ZJBR;
    msg += "      基本暗器 ≥ " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 ≥ " HIB "100" NOR " 点。" ZJBR;
    msg += "      装备暗器。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对范围内所有敌人投掷暗器。" ZJBR;
    msg += "      命中判定：(自身暗器技能 + 自身不败神功等级) > 目标轻功技能等级。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力：" HIB "100" NOR " 点。" ZJBR;
    msg += "      忙乱：" HIR "3" NOR " 秒。" ZJBR;


    return msg;
}