// never-defeated.c 不败神功



inherit FORCE;
string type() { return "force"; }

string *dodge_msg = ({
	"$n移开数步，恰好躲过了$N的攻击。\n",
	"$n忽然反击，直指$N的破绽，逼得$N只能回守。\n",
	"$n轻身闪避，将$N的实招全部躲过。\n",
	"$n脚下一个跄踉，似乎无意，却刚好躲过$N这一击。\n",
});

int query_neili_improve(object me)
{
	int lvl;

	lvl = (int)me->query_skill("never-defeated", 1);
	return lvl * lvl * 20 * 15 / 100 / 200;
}
string query_txt()
{
	return "说明：要求狡黠多变性格，经验300万，武学修养50（武学修养300后不再限制不败神功等级），先天悟性22，太监只能学到240级。";
}

