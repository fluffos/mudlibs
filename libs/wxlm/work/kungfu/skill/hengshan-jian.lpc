// hengshan-jian.c 恒山剑法
// Modified by Java Sep.1998


inherit SKILL;

mapping *action = ({
([      "action" : "$N提起$w，划了个半圈，斜斜向$n$l刺去",
	"force"  : 120,
	"dodge"  : 40,
	"damage" : 20,
	"lvl"    : 0,
	"damage_type" : "刺伤",
]),

([      "action" : "$N突然间将$w交左手，反手刺出",
	"force"  : 140,
	"dodge"  : 35,
	"damage" : 25,
	"lvl"    : 30,
	"damage_type" : "刺伤",
]),
});


int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 150)
		return notify_fail(HIC"你的内力不够。"NOR"\n");

	if ((int)me->query_skill("force") < 30)
		return notify_fail(HIC"你的内功火候不够。"NOR"\n");

	return 1;
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("hengshan-jian", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i - 1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 40)
		return notify_fail("你的体力不够练恒山剑法。\n");

	if ((int)me->query("neili") < 40)
		return notify_fail("你的体力不够练恒山剑法。\n");

	me->receive_damage("qi", 25);
	me->add("neili", -14);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"hengshan-jian/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【恒山剑法】" ZJBR NOR;
    msg += WHT "恒山剑法是恒山派的独门剑法，以轻灵飘逸著称。" ZJBR;
    msg += "此剑法讲究以柔克刚，招式灵动多变，如行云流水般令人难以捉摸。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "  内功激发等级 " HIY "30" NOR " 级。" ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  剑法（sword）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  需装备剑类武器。" ZJBR;
    msg += "  气血：不低于 " HIR "40" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "40" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "25" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "14" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无特殊攻防特效或被动效果。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  暂无特殊招式。" ZJBR ZJBR;

    return msg;
}
