string *usage_skills = ({ "sword", "dodge","parry", "force" });

int valid_enable(string usage)
{
	return (member_array(usage, usage_skills) != -1) ||
	       usage == "unarmed" || usage == "unarmed";
}

int valid_combo(string combo)
{
	return combo == "kuihua-mogong";
}

int valid_force(string force) { return 1; }

int double_attack() { return 1; }

mapping query_action(object me, object weapon)
{
	return weapon ? actionw[random(sizeof(actionw))] :
			actionf[random(sizeof(actionw))];
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int valid_learn(object me)
{
	int level;
	int i;

	if ((int)me->query("combat_exp") < 3000000 && !me->query("relife/zhuanshi"))
		return notify_fail("你觉得葵花魔功深奥之极，"
				   "凭自己的战斗经验一时间难以领会。\n");

	if ((int)me->query_skill("martial-cognize", 1) < 50)
		return notify_fail("你觉得葵花魔功过于深奥之极，以"
				   "自己的武学修养全然无法明白。\n");

	if (me->query("character") != "阴险奸诈")
		return notify_fail("你看了葵花魔功这些阴险毒辣的武功，不"
				   "由的心惊肉跳，难以领会。\n");

	if (me->query("dex") < 22 && me->query_dex() < 61)
		return notify_fail("你觉得自己的身法不行，不可能掌握这么飘缈"
				   "玄奇的葵花魔功。\n");

	level = me->query_skill("kuihua-mogong", 1);

	if ((int)me->query_skill("martial-cognize", 1) < 300 &&
	    (int)me->query_skill("martial-cognize", 1) < level)
		return notify_fail("你觉得自己的武学修养有限，难以领会更高深的葵花魔功。\n");

	for (i = 0; i < sizeof(usage_skills); i++)
		if (me->query_skill(usage_skills[i], 1) < level)
			return notify_fail("你对" + to_chinese(usage_skills[i]) +
					   "的理解还不够，无法继续领会更高深的葵花魔功。\n");

	if (me->query_skill("finger", 1) < level &&
	    me->query_skill("unarmed", 1) < level)
		return notify_fail("你需要领会更高境界的指法和拳脚功夫才能继续研究葵花魔功。\n");

	return 1;
}

int practice_skill(object me)
{
	return notify_fail("葵花魔功博大精深，无法简单的通过练习进步。\n");
}

int difficult_level()
{
	object me; 
	int lv;
	me = this_player(); 
	lv = me->query_skill("pixie-jian", 1) - 180; 
	if (lv > 100) lv = 100; 
	 
	if (! me->query("special_skill/ghost"))
		return 1000;
	else
		return 500 - lv;
}

string perform_action_file(string action)
{
	return __DIR__"kuihua-mogong/perform/" + action;
}

string exert_function_file(string action)
{
	return __DIR__"kuihua-mogong/exert/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【葵花魔功】" NOR ZJBR ZJBR;
    msg += WHT "源自《葵花宝典》残篇的绝世武学，以身法诡异、出手毒辣著称。此功要求修炼者心性与常人迥异，修炼过程凶险异常，但练成后威力惊世骇俗。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  性格需为 " HIR "阴险奸诈" NOR "。" ZJBR;
    msg += "  先天身法 (`dex`) 不低于 " HIY "22" NOR " 点 或 后天身法 (`query_dex()`) 不低于 " HIY "61" NOR " 点。" ZJBR;
    msg += "  战斗经验 (`combat_exp`) 不低于 " HIM "3,000,000" NOR " 点（转世后无此限制）。" ZJBR;
    msg += "  武学修养 (`martial-cognize`) 等级不低于 " HIY "50" NOR " 级。" ZJBR;
    msg += "  若武学修养低于 " HIY "300" NOR " 级，则武学修养等级必须大于等于葵花魔功等级。" ZJBR;
    msg += "  以下技能的基本等级 (`skill`,1) 需大于等于葵花魔功等级：" ZJBR;
    msg += "    基本剑法 (`sword`), 基本轻功 (`dodge`), 基本招架 (`parry`), 基本内功 (`force`)" ZJBR;
    msg += "    基本指法 (`finger`), 基本拳脚 (`unarmed`)" ZJBR;
    msg += HIM "  江湖传闻：欲练此功，必先自宫。" NOR ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功 (`force`)。" ZJBR;
    msg += "  轻功 (`dodge`)。" ZJBR;
    msg += "  招架 (`parry`)。" ZJBR;
    msg += "  剑法 (`sword`)。" ZJBR;
    msg += "  拳脚 (`unarmed`) / 指法 (`finger`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  葵花魔功无法通过简单的练习 (`practice`) 来提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  " HIW "内力增长 (query_neili_improve)" NOR ":" ZJBR;
    msg += "    效果：提升最大内力上限，提升值为 (" HIG "葵花魔功等级" NOR ") * (" HIG "葵花魔功等级" NOR ") * " HIC "3 / 200" NOR "。" ZJBR;
    msg += "  " HIW "双重攻击 (double_attack)" NOR ":" ZJBR;
    msg += "    效果：激发为拳脚或兵器时，有几率发动连续两次攻击。" ZJBR;
    msg += "  " HIW "鬼魅身法 (query_dodge_msg)" NOR ":" ZJBR;
    msg += "    效果：激发为轻功时，拥有独特的闪避描述。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (Perform)〗" ZJBR NOR;

    msg += HIC "  鬼影迷踪 (gui)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      葵花魔功等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      以鬼魅身法扰乱敌人心神，成功命中后可使目标陷入忙乱状态。" ZJBR;
    msg += "      命中判定：" ZJBR;
    msg += "        攻击力(AP) = (" HIG "自身葵花魔功等级" NOR ") * 2 + (" HIG "自身武学修养等级" NOR ")" ZJBR;
    msg += "        防御力(DP) = (" HIG "目标招架技能等级" NOR ") * 2 + (" HIG "目标武学修养等级" NOR ")" ZJBR;
    msg += "        若 (" CYN "AP / 2 + 随机(AP)" NOR ") > (" CYN "DP" NOR ") 则命中。" ZJBR;
    msg += "      忙乱时间：命中后目标忙乱 (" HIR "AP / 45 + 2" NOR ") 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "50" NOR " 点。" ZJBR;
    msg += "      自身忙乱 (`busy`) " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  幽冥一击 (you)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      葵花魔功等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      凝聚魔功精髓，对目标发动迅猛绝伦的致命攻击，造成大量气血伤害（内伤）。" ZJBR;
    msg += "      命中判定：" ZJBR;
    msg += "        攻击力(AP) = (" HIG "自身葵花魔功等级" NOR ") * 2 + (" HIG "自身后天身法" NOR ") * 20 + (" HIG "自身武学修养等级" NOR ")" ZJBR;
    msg += "        防御力(DP) = (" HIG "目标招架技能等级" NOR ") * 2 + (" HIG "目标后天身法" NOR ") * 20 + (" HIG "目标武学修养等级" NOR ")" ZJBR;
    msg += "        若 (" CYN "AP / 2 + 随机(AP)" NOR ") > (" CYN "DP" NOR ") 则命中。" ZJBR;
    msg += "      伤害计算：命中后造成 (" RED "AP / 3 + 随机(AP / 3)" NOR ") 点气血伤害。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力 " HIB "100" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "40" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  幽冥神指 (zhi)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      葵花魔功等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      将全身功力聚于一指，无声无息地点向目标要害。若目标经验尚浅，有几率直接击杀；否则造成大量气血伤害。" ZJBR;
    msg += "      特殊击杀判定：" ZJBR;
    msg += "        攻击力(AP) = (" HIG "自身葵花魔功等级" NOR ")" ZJBR;
    msg += "        防御力(DP) = (" HIG "目标战斗经验" NOR ") / 10000" ZJBR;
    msg += "        若目标战斗经验 < " HIM "1,000,000" NOR " 且 (" CYN "随机(AP)" NOR ") > (" CYN "DP" NOR ")，则直接判定目标死亡。" ZJBR;
    msg += "      伤害计算（若未触发击杀）：命中后造成 (" RED "AP / 2 + 随机(AP / 2)" NOR ") 点气血伤害。（无论是否触发击杀，只要命中都会造成此伤害）" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "120" NOR " 点。" ZJBR;
    msg += "      自身忙乱 (`busy`) " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  群魔乱舞 (wu)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      葵花魔功等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      身形化作无数幻影，对目标发动疾风骤雨般的连续攻击，期间临时提升自身攻击力。" ZJBR;
    msg += "      攻击次数：基础 " HIY "5" NOR " 次。若 (" CYN "(葵花魔功等级 / 2) + 随机(葵花魔功等级 / 2)" NOR ") > (" CYN "目标轻功等级" NOR ")，则额外增加 (" HIM "1 + 随机(5)" NOR ") 次攻击。" ZJBR;
    msg += "      临时增益：招式发动期间，临时提升自身攻击力 (`apply/attack`) (" HIW "葵花魔功等级 / 7" NOR ") 点。" ZJBR;
    msg += "      命中判定：每次攻击独立进行命中判定。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力：每次攻击消耗 " HIB "20" NOR " 点内力。" ZJBR;
    msg += "      自身忙乱 (`busy`)：" HIR "3 + 随机(攻击总次数)" NOR " 秒。" ZJBR ZJBR;

    msg += HIY "〖内功运用 (Exert)〗" ZJBR NOR;

    msg += HIB "  葵花心法 (kuihua)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      葵花魔功等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "1000" NOR " 点。" ZJBR;
    msg += "      当前气血不低于 " HIR "500" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      运转独门心法，短时间内大幅提升身法，但攻击速度减半。" ZJBR;
    msg += "      效果：后天身法 (`dex`) 翻倍，攻击速度 (`attack_speed`) 减半。" ZJBR;
    msg += "      持续时间：(" HIG "葵花魔功等级 / 20" NOR ") 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "500" NOR " 点，气血 " HIR "300" NOR " 点。" ZJBR;
    msg += "      自身忙乱 (`busy`) " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIB "  战气 (powerup)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      葵花魔功等级不低于 " HIY "50" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升战斗气势，增加攻击伤害。" ZJBR;
    msg += "      效果：增加临时攻击力 (`apply/attack`) (" HIW "葵花魔功等级 / 3" NOR ") 点。" ZJBR;
    msg += "      持续时间：(" HIG "葵花魔功等级 / 30" NOR ") 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "100" NOR " 点。" ZJBR ZJBR;

    msg += HIB "  魔啸 (roar)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      葵花魔功等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "500" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      发出震慑心魄的啸声，对周围所有内功修为低于自身的敌人造成精神伤害。" ZJBR;
    msg += "      伤害判定：仅对 (" CYN "目标基本内功等级" NOR ") < (" CYN "自身葵花魔功等级 * 2" NOR ") 的目标生效。" ZJBR;
    msg += "      伤害计算：造成 (" RED "自身葵花魔功等级 + 随机(自身葵花魔功等级 / 2)" NOR ") * 2 点精神伤害 (`jing`)。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      自身忙乱 (`busy`) " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIB "  护体 (shield)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      葵花魔功等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      凝聚内力形成护体气劲，提升防御能力。" ZJBR;
    msg += "      效果：增加临时招架 (`apply/parry`) 和防御 (`apply/armor`) 各 (" HIW "葵花魔功等级 / 2" NOR ") 点。" ZJBR;
    msg += "      持续时间：(" HIG "葵花魔功等级 / 20" NOR ") 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "200" NOR " 点。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 葵花魔功的学习和施展条件苛刻，请务必满足所有要求。" ZJBR;
    msg += "2. 大部分特殊招式和内功运用仅能在战斗中使用，且消耗巨大，需谨慎规划。" ZJBR;
    msg += "3. 「幽冥神指」虽有秒杀可能，但失败风险并存，请评估使用时机。" ZJBR;
    msg += "4. 「葵花心法」会降低攻击速度，请注意权衡利弊。" ZJBR;
    msg += "5. 务必关注自身内力与气血状态，避免力竭。\n";

    return msg;
}