// wuxing-jueji.c 五行绝技



inherit SKILL;

int valid_enable(string usage) { return usage == "throwing"; }

int valid_learn(object me)
{
        if ((int)me->query_skill("force") < 60)
                return notify_fail("你的内功心法火候不够，无法学五行绝技。\n");

        if ((int)me->query_skill("dodge") < 80)
                return notify_fail("你的轻功火候不够，无法领悟五行绝技。\n");

        if ((int)me->query_dex() < 26)
                return notify_fail("你的身法不够灵巧，无法领悟五行绝技。\n");

        if ((int)me->query_skill("throwing", 1) < (int)me->query_skill("wuxing-jueji", 1))
                return notify_fail("你的基本暗器水平有限，难以领会更高深的五行绝技。\n");

        return 1;
}

int practice_skill(object me)
{
        

        if ((int)me->query("qi") < 60)
                return notify_fail("你的体力太低了。\n");

        if ((int)me->query("neili") < 60)
                return notify_fail("你的内力不够练五行绝技。\n");

        me->receive_damage("qi", 52);
        me->add("neili", -35);
        return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【五行绝技】" ZJBR NOR;
    msg += "一门精妙的暗器手法，暗合五行生克之理，出手迅捷，变化多端。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  基本内功等级需达到 " HIY "60" NOR " 级。" ZJBR;
    msg += "  基本轻功等级需达到 " HIY "80" NOR " 级。" ZJBR;
    msg += "  先天身法需达到 " HIY "26" NOR " 点。" ZJBR;
    msg += "  基本暗器等级需大于等于五行绝技等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  暗器（throwing）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  气血：不低于 " HIR "60" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "52" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "35" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR;

    return msg;
}

