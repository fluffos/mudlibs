inherit SKILL;

mapping *action = ({
([      "action": "$N使出一招「力拔山河」，左掌虚晃一下，右手带起阵阵掌风拍向$n的$l",
	"force" : 100,
	"attack": 18,
	"dodge" : 30,
	"parry" : 15,
	"damage": 40,
	"lvl"   : 0,
	"damage_type": "瘀伤"
]),
([      "action": "$N纵身跃起，一式「开碑断石」，双掌自上而下拍向$n的$l",
	"force" : 200,
	"attack": 25,
	"dodge" : 40,
	"parry" : 30,
	"damage": 45,
	"lvl"   : 30,
	"damage_type": "瘀伤"
]),
([      "action": "$N双掌呼地拍出，一招「风雨欲来」，带起阵阵飞沙走石，直击向$n的$l",
	"force" : 250,
	"attack": 35,
	"dodge" : 50,
	"parry" : 55,
	"damage": 45,
	"lvl"   : 60,
	"damage_type": "瘀伤"
]),
([      "action": "$N双掌齐出，幻做掌影重重，一招「地老天荒」拍向$n$l",
	"force" : 290,
	"attack": 42,
	"dodge" : 70,
	"parry" : 75,
	"damage": 43,
	"lvl"   : 120,
	"damage_type": "瘀伤"
]),
});

int valid_enable(string usage) { return usage == "strike" || usage == "parry"; }

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int)me->query_skill("zhenshan-zhang", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练震山掌必须空手。\n");

	if ((int)me->query_skill("force") < 100)
		return notify_fail("你的内功火候不够，无法练震山掌。\n");

	if ((int)me->query("max_neili") < 450)
		return notify_fail("你的内力太弱，无法练震山掌。\n");

	if (me->query_skill("strike", 1) < me->query_skill("zhenshan-zhang", 1))
		return notify_fail("你的基本掌法水平有限，无法领会更高深的震山掌。\n");

	return 1;
}


int practice_skill(object me)
{
	if ((int)me->query("qi") < 60)
		return notify_fail("你的体力太低了，先休息一下吧。\n");

	if ((int)me->query("neili") < 60)
		return notify_fail("你的内力不够练震山掌。\n");

	if (me->query_skill("zhenshan-zhang", 1) < 50)
		me->receive_damage("qi", 30);
	else
		me->receive_damage("qi", 50);

	me->add("neili", -54);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"zhenshan-zhang/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【震山掌】" ZJBR NOR;
    msg += WHT "震山掌是一门威力强大的掌法，以刚猛著称，共有四式攻击招式：" ZJBR;
    msg += WHT "力拔山河、开碑断石、风雨欲来、地老天荒。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功 等级：" HIY "100" NOR " 级。" ZJBR;
    msg += "  最大内力 上限：" HIB "450" NOR " 点。" ZJBR;
    msg += "  基本掌法 等级需高于或等于 基本震山掌 等级。" ZJBR;
    msg += "  练习需空手，不可持武器。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  掌法 (strike)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  当前气血 不低于 " HIR "60" NOR " 点。" ZJBR;
    msg += "  当前内力 不低于 " HIB "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗 内力 " HIB "54" NOR " 点。" ZJBR;
    msg += "  每次练习消耗 气血：若 基本震山掌 < 50，消耗 " HIR "30" NOR " 点；否则消耗 " HIR "50" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  震山打 (da)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      有效震山掌 等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "      基本内功 等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      攻击强度判定值 = (有效掌法等级 + 有效内功等级 / 2 + 后天臂力 * 10)" ZJBR;
    msg += "      防御强度判定值 = (目标有效招架等级 + 目标有效轻功等级 / 2 + 目标后天身法 * 10)" ZJBR;
    msg += "      命中判定：若 (攻击强度判定值 / 2 + 随机(攻击强度判定值 / 2)) >= 防御强度判定值，则命中。" ZJBR;
    msg += "      命中后效果：" ZJBR;
    msg += "        伤害值 = (有效掌法等级 / 2 + 随机(有效掌法等级 / 2) + 加力值)" ZJBR;
    msg += "        额外效果：减少目标内力 (伤害值 / 3) 点；并有几率使目标忙乱 (掌法伤害能力 / 30) 秒（最多 3 秒）。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      消耗气血 " HIR "50" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "2" NOR " 秒。" ZJBR;

    return msg;
}

