// ding-force.c 小丁气功

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_learn(object me)
{
	return ::valid_learn(me);
}

int practice_skill(object me)
{
	return notify_fail("小丁气功只能跟小丁学来增加熟练度。\n");
}


string query_description()
{
    string msg;

    msg = HIY "【小丁气功】" ZJBR NOR;
    msg += "一种非常基础的内功心法，简单易学。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  遵循基本内功（force）的学习要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  内功（force）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  无法通过练习提升，只能向特定NPC学习。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // hit_ob, valid_damage, skill_improved etc.
    msg += "  提供基础的内力上限和恢复。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // exert
    msg += "  无。" ZJBR;

    return msg;
}
