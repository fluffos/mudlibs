// sword-cognize.c
// 剑道修养

inherit SKILL;

int valid_learn(object me)
{
	return notify_fail("剑道修养是你武学方面的领悟，无法"
			   "通过简单学习获得提升。\n");
}

int valid_research(object me)
{
	return notify_fail("剑道修养来自你对实战体会的汲取吸"
			   "收，无法通过研究提升。\n");
}

string query_description()
{
    string msg;

    msg = HIY "【剑道修养】" ZJBR NOR;
    msg += "一种特殊的技能，代表了武者对剑术的领悟和理解，无法直接学习或研究。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  无法通过学习提升。" ZJBR ZJBR;

    // msg += HIY "〖研究要求〗" ZJBR NOR; // valid_research (模板无此项，根据规则省略)
    // msg += "  无法通过研究提升。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  特殊技能，无法激发。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  无法通过练习提升，需要在实战中汲取经验领悟。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  提升此技能可能对使用剑类武器时的表现产生积极影响（具体效果由系统其他部分决定）。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR;

    return msg;
}

