// yunv-xinfa.c 玉女心法

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int query_neili_improve(object me)
{
	int lvl;

	lvl = (int)me->query_skill("yunv-xinfa", 1);
	return lvl * lvl * 15 * 6 / 100 / 200;
}

int valid_force(string force)
{
    return (force == "yunv-xinjing");
}

int valid_learn(object me)
{
	/*if ( me->query("gender") == "无性")
		return notify_fail("你无根无性，阴阳难调，不能修习玉女心法。\n");
*/
	if ((int)me->query_skill("force", 1) < 30)
		return notify_fail("你的基本内功火候还不够。\n");

	return ::valid_learn(me);
}

int practice_skill(object me)
{
	return notify_fail("玉女心法只能用学(learn)来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"yunv-xinfa/" + func;
}

string query_description()
{
    string msg;

    msg = HIY "【玉女心法】" ZJBR NOR;
    msg += WHT "玉女心法是古墓派的入门内功心法，以柔和、绵密著称。" ZJBR;
    msg += WHT "修炼此心法可提升内力，并为学习更高深的古墓武学打下基础。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功 等级：" HIY "30" NOR " 级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功 (force)" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  玉女心法只能通过学习 (learn) 或研究 (research) 提升，无法练习 (practice)。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  提升最大内力：( 基本玉女心法等级 * 基本玉女心法等级 * 90 / 20000 ) 点。" ZJBR ZJBR; // 15*6=90, 100*200=20000

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  玉女真气 (powerup)" ZJBR NOR; // query_name in powerup.c is 玉女真气, not 神光离合
    msg += "    使用要求：" ZJBR;
    msg += "      基本玉女心法 等级：" HIY "20" NOR " 级。" ZJBR;
    msg += "      当前内力 不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      临时提升角色战斗力。" ZJBR;
    msg += "      提升效果：增加 ( 有效内功等级 / 3 ) 点攻击力。" ZJBR;
    msg += "                增加 ( 有效内功等级 / 3 ) 点防御力。" ZJBR;
    msg += "      持续时间：( 有效内功等级 / 2 ) 秒。" ZJBR; // Duration is skill/2 in powerup.c
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "3" NOR " 秒。" ZJBR;

    return msg;
}