// tiannan-step.c 三分步法

inherit SKILL;

string *dodge_msg = ({
    "只见$n一招「旱地拔葱」，身体向上笔直地纵起丈余，躲过了$N这一招。\n",
    "$n一个「雨燕归巢」，向后纵出数丈之远，避开了$N的凌厉攻势。\n",
    "$n使出「破土而出」，向一旁飘然纵出，轻轻着地。\n"
    "但是$n身形飘忽，一招「无中生有」轻轻一纵，早已避开。\n",
    "$n身随意转，一招「乘风而去」倏地往一旁挪开了三尺，避过了这一招。\n",
    "可是$n侧身一让，一招「鲧化大鹏」$N这一招扑了个空。\n",
    "却见$n足不点地，一招「青云直上」往旁窜开数尺，躲了开去。\n",
    "$n身形微晃，一招「凤翔九天」有惊无险地避开了$N这一招。\n"
});

int valid_enable(string usage) { return (usage == "dodge") || (usage == "move");}

int valid_learn(object me)
  { 
     if (me->query_skill("dodge",1) <= me->query_skill("sanfen-bufa",1) )
	return notify_fail("你的基本轻功基础不够，无法领会更高深的三分步法。\n");
    else    return 1;
  }

string query_dodge_msg(string limb)
{
    return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
    if( (int)me->query("qi") < 50 )
       return notify_fail("你的体力太差了，不能练三分身法。\n");

    me->receive_damage("qi", 40);
    return 1;
}
string query_description()
{
    string msg;

    msg = HIY "【三分步法】" ZJBR ZJBR NOR;
    msg += WHT "三分步法是一门轻盈灵动的身法，讲究身随意动，趋退若神。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本轻功等级必须高于三分步法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  轻功 (dodge)。" ZJBR;
    msg += "  身法 (move)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "40" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无特殊效果。主要提升闪避能力和移动速度。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无特殊招式。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 三分步法的学习受限于基本轻功等级。" ZJBR;
    msg += "2. 练习消耗气血，注意保持状态。\n";

    return msg;
}
