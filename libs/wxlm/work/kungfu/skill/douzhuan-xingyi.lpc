// douzhuan-xingyi 移星换斗



inherit SKILL;

string *parry_msg = ({
	"只听见「锵」一声，$n用兵刃轻轻一架，改变了$N这一击的方向。\n",
	"但是被$n用手中兵刃引开。\n",
	"但是$n身子一侧，随手转动手中的兵刃，让$N感觉到有力难施。\n",
});

string *unarmed_parry_msg = ({
	"但是被$p双掌一推，$N的攻势顿时变了方向。\n",
	"$n身形一转，$N只觉得的所有的力道全部都击向自己。\n",
	"但是$N感觉像打到棉花上一样，说不出的怪异。\n",
});

string query_parry_msg(object weapon)
{
	if( weapon )
		return parry_msg[random(sizeof(parry_msg))];
	else
		return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int valid_enable(string usage) { return usage == "parry"; }

int valid_learn(object me)
{
	if ((int)me->query_skill("parry", 1) < 100)
		return notify_fail("你的基本招架技巧掌握的还不够熟练，无法学习移星换斗。\n");

	if ((int)me->query_skill("parry", 1) < (int)me->query_skill("douzhuan-xingyi", 1)) 
		return notify_fail("你的基本招架水平有限，无法学习更高深的移星换斗。\n");

	return 1;
}

int practice_skill(object me)
{
	return notify_fail("移星换斗只能用学(learn)的来增加熟练度。\n");
}

string query_txt()
{
	return "要求：基本招架100"ZJBR
	"特效：化解伤害并对攻击者造成1/2反击伤害，对比自身(招架激发/2+技能等级)和攻击者内功激发，同激发等级1/2概率触发或者和敌方进行角力，如果角力成功也触发。触发时如果敌方没有兵器格挡自身受到额外一秒忙乱。受阴阳八卦克制";
}

mixed valid_damage(object ob, object me, int damage, object weapon)
{
	mixed result;
	int ap, dp, mp;

	if ((int) me->query_skill("douzhuan-xingyi", 1) < 100 ||
	    ! living(me))
		return;

	mp = ob->query_skill("count");
	ap = ob->query_skill("force") + mp;
	dp = me->query_skill("parry")/2 + me->query_skill("douzhuan-xingyi", 1);

	if (ap / 2 + random(ap) < dp|| COMBAT_D->judge_power(me,ob))
	{
		result = ([ "damage" : -(damage * 3 / 4) ]);

		// 如果没有兵器，让敌方受到1秒忙乱
		if (! objectp(weapon))
		{
			ob->start_busy(1);
			result += ([ "msg" : HIY "$n" HIY "只觉得$N" HIY "的招式变幻莫测，不由得心生畏惧，手足无措。\n" NOR ]);
		}

		switch (random(3))
		{
		case 0:
			result += ([ "msg" : HIC "$n" HIC "使出姑苏慕容的独门绝技“移星换斗”，把$N"
						HIC "的劲道尽数反击回去。"NOR"\n"+
						COMBAT_D->do_respond(me, ob, damage, 50, HIR "$P只觉一股暗劲翻涌而来，身不由己的击向自己！"NOR"\n")]);
			break;
		case 1:
			result += ([ "msg" : HIC "$n" HIC "使出姑苏慕容的独门绝技“移星换斗”，把$N"
						HIC "的劲道尽数反击回去。"NOR"\n"+
						COMBAT_D->do_respond(me, ob, damage, 50, HIR "$P只觉一股暗劲翻涌而来，身不由己的击向自己！"NOR"\n")]);
			break;

		default:
			result += ([ "msg" : HIC "$N" HIC "一招眼看击中了$n" HIC "，然而$n" HIC "轻轻一接，"
					     "将$N" HIC "的攻击悉数反击回去。"NOR"\n"+
						COMBAT_D->do_respond(me, ob, damage, 50, HIR "$P只觉一股暗劲反击而来，顿时一阵气血翻涌！"NOR"\n")]);
			break;
		}
		return result;
	} else
	if (mp >= 100)
	{
		switch (random(3))
		{
		case 0:
			result = HIY "$n" HIY "身形忽然转个不停，然而$N"
				 HIY "早已看穿其中奥妙，丝毫不受影响，挥招直入。"NOR"\n";
			break;

		case 1:
			result = HIY "$n" HIY "单掌一托，$N"
				 HIY "忽感拿捏不准力道，蓦然警醒，登时变化招式。"NOR"\n";
			break;

		default:
			result = HIY "$n" HIY "轻轻一卸力，但是$N"
				 HIY "已然看出其中四两拨千斤的变化，左右腾挪，让$n"
				 HIY "如意算盘就此落空。"NOR"\n";
			break;
		}
		COMBAT_D->set_bhinfo(result);
	}
}

string perform_action_file(string action)
{
	return __DIR__"douzhuan-xingyi/" + action;
}

int diffcult_level() { return 200; }

string query_description()
{
    string msg;

    msg = HIY "【斗转星移】" ZJBR NOR;
    msg += "姑苏慕容家传绝学，以彼之道，还施彼身，精于招架与反击。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  基本招架 (parry) 等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "  基本招架 (parry) 等级需不低于斗转星移等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  无法通过练习提升，只能通过学习提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // valid_damage
    msg += "  触发条件：斗转星移等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "  判定方式：比较 (攻击者内功激发 + 攻击者奇门遁甲等级) 与 (自身招架激发 / 2 + 自身斗转星移等级)。" ZJBR;
    msg += "            或进行角力判定 (`COMBAT_D->judge_power`)。" ZJBR;
    msg += "  成功效果：" ZJBR;
    msg += "    1. 完全化解受到的伤害。" ZJBR;
    msg += "    2. 对攻击者造成相当于所化解伤害 " HIR "50%" NOR " 的反震伤害。" ZJBR;
    msg += "    3. 若攻击者未使用兵器，额外使其忙乱 " HIR "1" NOR " 秒。" ZJBR;
    msg += "  失败条件：若判定失败且攻击者奇门遁甲等级不低于 " HIY "100" NOR " 级，则显示被看破的提示。" ZJBR;
    msg += "  克制：受阴阳八卦 (count) 技能克制。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform_action_file

    msg += HIC "  移星换斗 (yi)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      斗转星移等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "60" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：比较 (自身招架激发 / 2 + 自身内功激发 / 2)[若对手使用针，则降低20%] vs (目标内功激发 / 2 + 目标招架激发 / 2)。对NPC判定值提升50%。" ZJBR;
    msg += "      命中效果：" ZJBR;
    msg += "        1. 对目标造成徒手伤害，基础伤害为 (自身最大气血 / 16)。" ZJBR;
    msg += "        2. 若拥有奥义 " HIW "紫燕穿云" NOR "，附加伤害 (自身最大精神 / 50 * 奥义等级)。" ZJBR;
    msg += "        3. 对NPC最终伤害提升100%。" ZJBR;
    msg += "        4. 强制目标对自己进行数次攻击（次数同普通攻击），并可能使目标忙乱 1 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "50" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;

    return msg;
}