// sword.c
// modified by Venus Oct.1997
inherit SKILL;

string query_description()
{
    string msg;

    msg = HIY "【基本剑法】" ZJBR NOR;
    msg += "所有剑类武功的基础，掌握后可提升剑类武器的使用技巧和威力。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  无特殊要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  剑法（sword）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  该技能为基础技能，无法通过练习提升，需要通过学习其他剑法来提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR;

    return msg;
}

