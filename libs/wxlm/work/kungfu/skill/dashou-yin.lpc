int valid_enable(string usage) { return usage == "hand" || usage == "parry"; }

int valid_combine(string combo)
{
	return combo=="yujiamu-quan" ||
	       combo=="huoyan-dao";
}

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练密宗大手印必须空手。\n");

	if ((int)me->query("max_neili") < 350)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("force") < 50)
		return notify_fail("你的内功火候太浅。\n");

	if ((int)me->query_skill("lamaism", 1) < 20)
		return notify_fail("你对密宗心法的知识了解太少，无法理解密宗大手印。\n");

	if ((int)me->query_skill("lamaism", 1) < (int)me->query_skill("dashou-yin",1) &&
	    (int)me->query_skill("lamaism", 1) < 200)
		return notify_fail("你受密宗心法知识的知识所限，难以进一步领悟大手印。\n");

	if ((int)me->query_skill("hand", 1) < (int)me->query_skill("dashou-yin",1))
		return notify_fail("你的基本手法水平有限，无法领会更高深的密宗大手印。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
		  level   = (int) me->query_skill("dashou-yin",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
 

	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练「密宗大手印」必须空手。\n");

	if ((int)me->query("qi") < 60)
		return notify_fail("你的体力不够，练不了密宗大手印。\n");

	if ((int)me->query("neili") < 70)
		return notify_fail("你的内力不够，练不了密宗大手印。\n");

	me->receive_damage("qi", 50);
	me->add("neili", -61);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"dashou-yin/" + action;
}

// 新的 query_description 函数
string query_description()
{
	string msg;

	msg = HIY "【密宗大手印】" ZJBR NOR;
	msg += "密宗绝学，一种威力强大的掌法，注重内外兼修，印法变幻莫测。" ZJBR ZJBR; // 基本介绍

	msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
	msg += "  空手状态。" ZJBR;
	msg += "  最大内力不低于 " HIB "350" NOR " 点。" ZJBR;
	msg += "  基本内功等级不低于 " HIY "50" NOR " 级。" ZJBR;
	msg += "  密宗心法等级不低于 " HIY "20" NOR " 级。" ZJBR;
	msg += "  当密宗心法低于 200 级时，其等级需不低于密宗大手印等级。" ZJBR;
	msg += "  基本手法等级需大于等于密宗大手印等级。" ZJBR ZJBR;

	msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
	msg += "  手法（hand）。" ZJBR;
	msg += "  招架（parry）。" ZJBR ZJBR;

	msg += HIY "〖可合击技能〗" ZJBR NOR; // valid_combine
	msg += "  莲花六式（yujiamu-quan）。" ZJBR;
	msg += "  火焰刀（huoyan-dao）。" ZJBR ZJBR;

	msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
	msg += "  空手状态。" ZJBR;
	msg += "  气血：不低于 " HIR "60" NOR " 点。" ZJBR;
	msg += "  内力：不低于 " HIB "70" NOR " 点。" ZJBR;
	msg += "  每次练习消耗气血：" HIR "50" NOR " 点。" ZJBR;
	msg += "  每次练习消耗内力：" HIB "61" NOR " 点。" ZJBR ZJBR;

	msg += HIY "〖攻防特效/被动效果〗" + ZJBR + NOR; // hit_ob, valid_damage, skill_improved etc.
	msg += "  无。" + ZJBR + ZJBR;

	msg += HIY "〖特殊招式〗" + ZJBR + NOR; // perform_action_file

	msg += HIC "  金刚印 (jingang)" + ZJBR NOR;
	msg += "    使用要求：" + ZJBR;
	msg += "      密宗大手印等级 " HIY "100" NOR " 级。" + ZJBR;
	msg += "      当前内力不低于 " HIB "150" NOR " 点。" + ZJBR;
	msg += "      战斗中使用。" + ZJBR;
	msg += "    效果描述：" + ZJBR;
	msg += "      命中判定：由 (自身激发手法等级 + 自身根骨 * 10) 与 目标招架激发等级 及其他因素决定。" + ZJBR;
	msg += "      命中后造成徒手伤害：" + ZJBR;
	msg += "        基础伤害值约为 (自身激发手法等级 + 根骨 * 10) + 随机((自身激发手法等级 + 根骨 * 10) / 2)。" + ZJBR;
	msg += "        最终伤害有 40% 加成，并受目标防御、护甲、内功等影响。" + ZJBR;
	msg += "    消耗与代价：" + ZJBR;
	msg += "      命中：内力 " HIB "100" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" + ZJBR;
	msg += "      未命中：内力 " HIB "40" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" + ZJBR;

	return msg;
}
