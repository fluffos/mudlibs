 
// fengxue.c 寒冰封穴


#include <combat.h>

inherit F_SSERVER;

string query_name() { return "寒冰封穴"; }

int perform(object me, object target)
{
    object weapon;
    string msg;
    int ap, dp;
    int damage;

    if (! target) target = offensive_target(me);

    if (! objectp(weapon = me->query_temp("weapon")) ||
        weapon->query("skill_type") != "staff")
        return notify_fail("你使用的武器不对，无法施展「寒冰封穴」。\n");

    if (! me->is_fighting(target))
        return notify_fail("「寒冰封穴」只能对战斗中的对手使用。\n");

    if ((int)me->query_skill("tianshan-zhang", 1) < 150)
        return notify_fail("你的天山杖法不够娴熟，无法施展「寒冰封穴」。\n");

    if (me->query("neili") < 400)
        return notify_fail("你的内力不足，无法施展「寒冰封穴」。\n");

    if (me->query_skill_mapped("staff") != "tianshan-zhang")
        return notify_fail("你没有激发天山杖法，无法施展「寒冰封穴」。\n");

    if (! living(target))
        return notify_fail("对方已经这样了，不需要这么费力吧？\n");

    msg = HIW "$N" HIW "高举" + weapon->name() + HIW "，猛然挥出，一股刺骨的寒风直袭$n！\n" NOR;
    message_combatd(msg, me, target);

    ap = me->query_skill("staff") + me->query_skill("force");
    dp = target->query_skill("dodge") + target->query_skill("parry");

    me->add("neili", -300);
    me->start_busy(2);

    if (COMBAT_D->hit_determination(me,target,ap,dp))
    {
        damage = ap + random(ap / 2);
        msg = HIR "$n" HIR "被$N" HIR "的寒气所侵，浑身一颤，动作变得迟缓！\n" NOR;
        target->start_busy(2);
        COMBAT_D->real_damage(me, target, damage);
    }
    else
    {
        msg = CYN "$n" CYN "急忙后退，终于避开了$N" CYN "的致命一击！\n" NOR;
    }

    message_combatd(msg, me, target);
    return 1;
}