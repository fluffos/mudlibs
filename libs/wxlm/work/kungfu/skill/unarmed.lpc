// unarmed.c
inherit SKILL;
void skill_improved(object me)
{
	if (me->query_skill("unarmed",1)%30==0) {
		tell_object(me, HIW "由於你勤练武艺，你的"+HIY"【后天膂力】"+NOR+"提高了。"NOR"\n");
	}
}

string query_description()
{
    string msg;

    msg = HIY "【基本拳脚】" ZJBR NOR;
    msg += "基本拳脚是最基本的空手搏击技能，是所有拳脚类武功的根基。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  无特殊要求，所有人都可以学习。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  此为基本技能，不可直接激发。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  作为基础技能，通常通过学习来提高。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  每提高 " HIY "30" NOR " 级，人物的后天膂力属性会自动得到提升。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  作为基础技能，基本拳脚不包含特殊绝技。" ZJBR;
    msg += "  建议在学习其他高级空手武功之前，先将此技能提升到一定水平。" ZJBR;

    return msg;
}

