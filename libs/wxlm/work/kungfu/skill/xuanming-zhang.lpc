int valid_enable(string usage)
{
	return usage=="strike" || usage=="parry";
}

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练天幽神掌必须空手。\n");

	if ((int)me->query_skill("force") < 200)
		return notify_fail("你的内功火候不够，无法练习天幽神掌。\n");

	if ((int)me->query("max_neili") < 2000)
		return notify_fail("你的内力太弱，无法练习天幽神掌。\n");

	if ((int)me->query_skill("strike", 1) < 180)
		return notify_fail("你的基本掌法火候不够，无法练天幽神掌。\n");

	if ((int)me->query_skill("strike", 1) < (int)me->query_skill("xuanming-zhang", 1))
		return notify_fail("你的基本掌法水平有限，无法领会更高深的天幽神掌。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action)-1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("xuanming-zhang",1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i - 1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 100)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 100)
		return notify_fail("你的内力不够练天幽神掌。\n");

	me->receive_damage("qi", 80);
	me->add("neili", -99);
	return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int lvl;
	int flvl;

	lvl  = me->query_skill("xuanming-zhang", 1);
	flvl = me->query("jiali");
	if (lvl < 80 || flvl < 10 || ! damage_bonus)
		return;

	if (flvl * 2 + random(lvl) > victim->query_skill("force") &&
	    victim->affect_by("xuanming_poison",
			      ([ "level" : flvl + random(flvl),
				 "id"    : me->query("id"),
				 "duration" : lvl / 50 + random(lvl / 20) ])))
	{
		return "$n忽然感到一股莫名的恶心，阴寒的冷气攻心，全身瘫软，嘴皮乌紫。\n";
	}
}

string perform_action_file(string action)
{
	return __DIR__"xuanming-zhang/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【天幽神掌】" ZJBR NOR;
    msg += WHT "天幽神掌是一门阴寒无比的邪派掌法，掌风中蕴含刺骨寒气。" ZJBR;
    msg += "修炼者双掌会变得乌黑，寻常治疗手段难以奏效。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  必须空手。" ZJBR;
    msg += "  内功有效激发等级 (" HIG "force" NOR ")：不低于 " HIY "200" NOR " 级。" ZJBR;
    msg += "  最大内力 (" HIG "max_neili" NOR ")：不低于 " HIB "2000" NOR " 点。" ZJBR;
    msg += "  基本掌法等级 (" HIG "strike" NOR ")：不低于 " HIY "180" NOR " 级。" ZJBR;
    msg += "  基本掌法等级必须大于等于当前天幽神掌等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  掌法 (" HIG "strike" NOR ")。" ZJBR;
    msg += "  招架 (" HIG "parry" NOR ")。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血 (" HIG "qi" NOR ")：不低于 " HIR "100" NOR " 点。" ZJBR;
    msg += "  内力 (" HIG "neili" NOR ")：不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "80" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "99" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += HIC "  玄冥寒毒：" ZJBR NOR;
    msg += "    当 天幽神掌 等级不低于 " HIY "80" NOR " 级，且 加力 (" HIG "jiali" NOR ") 不低于 " HIY "10" NOR " 时，攻击命中目标有几率触发。" ZJBR;
    msg += "    触发判定：" HIC "(自身加力 * 2 + 随机(自身天幽神掌等级)) > 目标内功有效激发等级" NOR "。" ZJBR;
    msg += "    效果：使目标中 玄冥寒毒 (" HIG "xuanming_poison" NOR ") 状态。" ZJBR;
    msg += "      状态等级：自身加力 + 随机(自身加力)。" ZJBR;
    msg += "      持续时间：(自身天幽神掌等级 / 50) + 随机(自身天幽神掌等级 / 20) 秒。" ZJBR;
    msg += "    描述：目标会感到阴寒之气攻心，全身瘫软，嘴唇发紫。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  玄冥无极 (wuji)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      天幽神掌等级 (" HIG "xuanming-zhang" NOR ")：不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      内功有效激发等级 (" HIG "force" NOR ")：不低于 " HIY "200" NOR " 级。" ZJBR;
    msg += "      当前内力 (" HIG "neili" NOR ")：不低于 " HIB "400" NOR " 点。" ZJBR;
    msg += "      必须激发 天幽神掌 为掌法。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      此招将对目标进行一次强力攻击，并附加玄冥寒毒。" ZJBR;
    msg += "      攻击力计算：" HIC "AP = 自身掌法有效激发等级  + 自身后天臂力 * 10" NOR "。" ZJBR;
    msg += "      防御力计算：" HIC "DP = 目标轻功有效激发等级  + 目标后天身法 * 10" NOR "。" ZJBR;
    msg += "      基础伤害：(AP / 2) + 随机(AP / 2)。" ZJBR;
    msg += "      命中判定由 `COMBAT_D` 根据双方攻防、状态等综合判定。" ZJBR;
    msg += "      若命中，则对目标施加 玄冥寒毒 (" HIG "xuanming_poison" NOR ") 状态。" ZJBR;
    msg += "        毒素等级叠加：本次附加等级 = (之前 `hit_ob` 触发的等级) + (目标当前已中的玄冥寒毒等级)。" ZJBR;
    msg += "        持续时间：(自身天幽神掌等级 / 40) + 随机(自身天幽神掌等级 / 40) 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力消耗：" HIB "400" NOR " 点。" ZJBR;
    msg += "      忙乱状态 (" HIG "busy" NOR ")：" HIR "4" NOR " 秒。" ZJBR;

    return msg;
}