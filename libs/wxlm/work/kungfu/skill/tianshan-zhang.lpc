mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int valid_enable(string usage) { return (usage == "staff") || (usage == "parry"); }

int valid_learn(object me)
{
	if (me->query_skill("force") < 30)
		return notify_fail("你的内功火候不够，不能学习天山杖法。\n");

	if (me->query("max_neili") < 100)
		return notify_fail("你的内力不够，不能学习天山杖法。\n");

	if ((int)me->query_skill("staff", 1) < (int)me->query_skill("tianshan-zhang", 1))
		return notify_fail("你的基本杖法水平有限，无法领会更高深的天山杖法。\n");

	return 1;
}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "staff")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力不够练天山杖法。\n");

	if ((int)me->query("neili") < 40)
		return notify_fail("你的体力不够练天山杖法。\n");

	me->receive_damage("qi", 42);
	me->add("neili", -26);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"tianshan-zhang/" + action;
}

string query_description()
{
    string msg;

    msg = HIW "【天山杖法】" ZJBR NOR;
    msg += "星宿派独门杖法，招式凌厉刚猛，蕴含冰寒之气，可使敌人行动迟缓。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功等级需达到 " HIY "30" NOR " 级。" ZJBR;
    msg += "  内力最大值需不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "  基本杖法等级需大于等于天山杖法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  杖法（staff）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  需持杖类武器。" ZJBR;
    msg += "  气血不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  内力不低于 " HIB "40" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血 " HIR "42" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力 " HIB "26" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  天山杖法的攻击带有寒气，有 " HIB "20%" NOR " 的几率使敌人行动迟缓1秒。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  寒冰封穴 (fengxue)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      天山杖法等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      需激发杖法为天山杖法。" ZJBR;
    msg += "      当前内力 " HIB "400" NOR " 点。" ZJBR;
    msg += "      需持杖类武器且在战斗中对敌人使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：若攻击方(基本杖法等级 + 有效内功等级) > 防御方(基本轻功等级 + 基本招架等级)，则命中。" ZJBR;
    msg += "      命中效果：" ZJBR;
    msg += "        造成伤害：伤害值 = 攻击方(基本杖法等级 + 有效内功等级) + 随机(攻击方(基本杖法等级 + 有效内功等级)/2)。" ZJBR;
    msg += "        伤害分为气血伤害和气血内伤两部分，内伤为伤害值的一半。" ZJBR;
    msg += "        使目标忙乱2秒，行动迟缓。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  伏树剑阵 (fugu)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      天山杖法等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      需持杖类武器且在战斗中对敌人使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      使用后对敌人造成多次攻击，是一种爆发性攻击绝技。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "120" NOR " 点。" ZJBR;
    msg += "      消耗后可能导致自身忙乱。" ZJBR ZJBR;

    msg += HIC "  寒冰劲 (xue)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      天山杖法等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "      需持杖类武器且在战斗中对敌人使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      爆发性攻击招式，可对敌人造成冻伤效果。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      使用后可能导致自身忙乱。" ZJBR;

    return msg;
}

// 在 hit_ob 函数中增加冰冻效果
mixed hit_ob(object me, object victim, int damage_bonus)
{
    int chance = 20; // 冰冻概率20%

    if (random(100) < chance)
    {
		if (! victim->is_busy())
		{
			victim->start_busy(1);
		}
		
        return HIB "$n" HIB "只觉一股寒气透骨而入，动作竟然变得迟缓起来！\n" NOR;
    }
}
