int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me)
{
	if (me->query_skill("force") < 80)
		return notify_fail("你的内功火候不够，不能学习玉影流月剑。\n");

	if (me->query_skill("sword", 1) < 80)
		return notify_fail("你的基本剑法火候不够，不能学习玉影流月剑。\n");

	if (me->query("max_neili") < 800)
		return notify_fail("你的内力不够，不能学习玉影流月剑。\n");

	if ((int)me->query_skill("sword", 1) < (int)me->query_skill("liuyue-jian", 1))
		return notify_fail("你的基本剑法水平有限，无法领会更高深的玉影流月剑。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("liuyue-jian",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 80)
		return notify_fail("你的体力不够练玉影流月剑。\n");

	if ((int)me->query("neili") < 80)
		return notify_fail("你的内力不够练玉影流月剑。\n");

	me->receive_damage("qi", 60);
	me->add("neili", -60);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"liuyue-jian/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【玉影流月剑】" ZJBR NOR;
    msg += WHT "此剑法招式优雅灵动，轻盈飘逸，剑意如月光流转，变化莫测。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功 (`force`) 等级不低于 " HIY "80" NOR " 级。" ZJBR;
    msg += "  基本剑法 (`sword`) 等级不低于 " HIY "80" NOR " 级。" ZJBR;
    msg += "  最大内力 (`max_neili`) 不低于 " HIB "800" NOR " 点。" ZJBR;
    msg += "  基本剑法 (`sword`) 等级需大于等于玉影流月剑等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  剑法 (`sword`)。" ZJBR;
    msg += "  招架 (`parry`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须装备剑类武器。" ZJBR;
    msg += "  气血 (`qi`) 不低于 " HIR "80" NOR " 点。" ZJBR;
    msg += "  内力 (`neili`) 不低于 " HIB "80" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血 " HIR "60" NOR " 点，内力 " HIB "60" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;

    msg += HIC "  流字诀 (liu)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      玉影流月剑 (`liuyue-jian`) 等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "      基本内功 (`force`) 等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "      最大内力 (`max_neili`) 不低于 " HIB "1500" NOR " 点。" ZJBR;
    msg += "      当前内力 (`neili`) 不低于 " HIB "250" NOR " 点。" ZJBR;
    msg += "      必须装备剑类武器且激发为剑法。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：自身基本剑法激发等级与目标招架激发等级进行随机比较 (`随机(自身剑法激发) > 目标招架激发 / 3`)。" ZJBR;
    msg += "      命中效果：对目标造成较大伤害，基础伤害约为 `(自身剑法激发等级 / 2) + 随机(自身剑法激发等级 / 2)`，并附加等同于基础伤害一半的额外伤害。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 " HIB "200" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：消耗内力 " HIB "100" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  声字诀 (sheng)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      玉影流月剑 (`liuyue-jian`) 等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "      基本内功 (`force`) 等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "      最大内力 (`max_neili`) 不低于 " HIB "1500" NOR " 点。" ZJBR;
    msg += "      当前内力 (`neili`) 不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "      必须装备剑类武器且激发为剑法。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：自身基本剑法激发等级与目标轻功激发等级进行随机比较 (`随机(自身剑法激发) > 目标轻功激发 / 2`)。" ZJBR;
    msg += "      命中效果：对目标造成一定伤害，基础伤害约为 `(自身剑法激发等级 / 3) + 随机(自身剑法激发等级 / 3)`。" ZJBR;
    msg += "      附加效果：若目标未处于忙乱状态，则会使其忙乱 `(自身剑法激发等级 / 100 + 2)` 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 " HIB "150" NOR " 点，自身忙乱 " HIR "1-2" NOR " 秒。" ZJBR;
    msg += "      未命中：消耗内力 " HIB "100" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 练习和使用玉影流月剑必须装备剑类武器。" ZJBR;
    msg += "2. 该剑法威力依赖于基本剑法、玉影流月剑等级以及内功修为。" ZJBR;
    msg += "3. 「声字诀」命中判定依据目标的轻功等级，且可能造成目标忙乱。" ZJBR;

    return msg;
}
