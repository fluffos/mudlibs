    msg += "      基础消耗内力 " HIB "500" NOR " 点。" ZJBR;
    msg += "      根据实际解除的忙乱秒数消耗额外内力（见效果描述）。" ZJBR;
    msg += "      若在战斗中使用，忙乱 " HIR "2" NOR " 秒；否则忙乱 " HIR "1" NOR " 秒。" ZJBR;

    return msg;
}

string exert_function_file(string func)
{
    return __DIR__"linji-zhuang/" + func;
}

string perform_action_file(string action)
{
    return __DIR__"linji-zhuang/" + action;
}

int query_effect_parry(object attacker, object me)
{
    int skill;

    skill = me->query_skill("linji-zhuang", 1);

    if (skill < 100)
        return 0;
    else if (skill < 150)
        return 50;
    else if (skill < 200)
        return 80;
    else
        return 100;
}