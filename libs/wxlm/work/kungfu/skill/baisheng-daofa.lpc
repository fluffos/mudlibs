int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

int valid_learn(object me)
{
	if (me->query_skill("blade",1) <= me->query_skill("baisheng-daofa",1) )
	return notify_fail("你的基本刀法基础不够，无法领会更高深的百胜刀法。\n");

	if ((int)me->query("max_neili") < 600)
		return notify_fail("你的内力不够。\n");
	
	if ((int)me->query_skill("force") < 100)
		return notify_fail("你的内功火候太浅。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level   = (int) me->query_skill("baisheng-daofa",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "blade")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力不够，练不了百胜刀法。\n");

	if ((int)me->query("neili") < 70)
		return notify_fail("你的内力不够，练不了百胜刀法。\n");

	me->receive_damage("qi", 45);
	me->add("neili", -68);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"baisheng-daofa/" + action;
}

string query_description()
{
    string msg;

    msg = "";
    msg += HIY "【百胜刀法】" ZJBR ZJBR NOR;
    msg += WHT "百胜刀法是一门以攻击见长的刀法，以其凌厉凶猛、气势如虹而闻名。" ZJBR;
    msg += "此刀法讲究以快打慢，以刚克柔，招式看似简单直接，实则暗藏杀机。" ZJBR ZJBR;
    msg += HIY "【学习要求】" ZJBR NOR;
    msg += "  最大内力 600 点" ZJBR;
    msg += "  基本内功等级 100 级" ZJBR;
    msg += "  百胜刀法等级不能超过基本刀法等级" ZJBR ZJBR;
    msg += HIY "【练习消耗】" ZJBR NOR;
    msg += "  需要装备刀类武器" ZJBR;
    msg += "  每次练习消耗："ZJBR;
    msg += "    - 气血 45 点"ZJBR;
    msg += "    - 内力 68 点"ZJBR ZJBR;
    msg += HIY "【技能效果】" ZJBR NOR;
    msg += "  可激发为刀法（blade）" ZJBR;
    msg += "  可激发为招架（parry）" ZJBR ZJBR;
    msg += HIY "【特殊招式】" ZJBR NOR;
    msg += HIW "1. 百胜刀诀（baisheng）：" ZJBR NOR;
    msg += "  要求：百胜刀法120级，内功150级" ZJBR;
    msg += "  内力消耗：100点" ZJBR;
    msg += "  效果：连续攻击对手，造成多次伤害" ZJBR;
    msg += "  描述：使出百胜刀法的精髓，刀光闪烁，连环进击" ZJBR ZJBR;
    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 百胜刀法需要高超的身法配合，练习时需要注意提高基本身法。" ZJBR;
    msg += "2. 在实战中，要善于利用刀法的凌厉特点，快速压制对手。" ZJBR;
    msg += "3. 百胜刀诀作为绝技，使用时机很重要，应在关键时刻施展。\n";

    return msg;
}