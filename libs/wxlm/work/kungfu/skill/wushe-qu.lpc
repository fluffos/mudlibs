// wushe-qu.c 舞蛇曲



inherit SKILL;

string type() { return "knowledge"; }

int valid_enable(string usage) { return usage == "guzheng-jifa"; }

int valid_learn(object me)
{
	if (me->query_skill("guzheng-jifa", 1) < 100)
		return notify_fail("你的古筝技法水平不够，还是先练好再说吧！\n");

	if (me->query_skill("guzheng-jifa", 1) < me->query_skill("wushe-qu", 1))
		return notify_fail("你的古筝技法水平有限，无法领会更精妙的舞蛇曲。\n");

	return 1;
}

int practice_skill(object me)
{
	object ob;

	if (! objectp(ob = me->query_temp("handing")) ||
	    ! ob->valid_as_zheng())
		return notify_fail("不拿出筝来，你怎么练习？\n");

	if ((int)me->query("jing") < 80)
		return notify_fail("你的精神不够好，没法练习了。\n");

	if ((int)me->query("qi") < 30)
		return notify_fail("你现在实在是太疲惫了。\n");

	me->receive_damage("jing", 25);
	me->receive_damage("qi", 15);

	return 1;
}

void do_effect(object me)
{
	object env;
	int lvl;
	string *sn;
	object *obs;
	object ob;

	lvl = me->query_skill("guzheng-jifa", 1) / 2 +
	      me->query_skill("wushe-qu", 1);

	if ((env = environment(me))->query("no_fight"))
		return;

	if (lvl < 50)
	{
		write("你满头大汗的弹了半天，好像没有什么作用。\n");
		return;
	}

	if (me->query("neili") < 50)
	{
		me->set("neili", 0);
		write("你隐隐觉得内力有些不济。\n");
		return;
	}

	me->add("neili", -20 - random(10));

	if (! arrayp(sn = env->query("resource/snake")))
	{
		write("你弹了半天，但是没有一条蛇出来。\n");
		return;
	}

	obs = filter_array(all_inventory(env), (: $1->is_snake() :));
	if (sizeof(obs) > 12 || random(150 + lvl) < 150)
	{
		write("你弹了半天，但是似乎没有什么蛇出来。\n");
		return;
	}

	ob = new(sn[random(sizeof(sn))]);
	ob->add("snake_poison/level" + random(lvl / 5));
	ob->move(env);
	write("你弹了一曲，只听一阵嗤嗤做响，一条" + ob->name() +
	      "从草丛中窜了出来。\n");
}

string query_description()
{
    string msg;

    msg = HIY "【舞蛇曲】" ZJBR NOR;
    msg += "一种独特的古筝曲目，用以沟通和引诱蛇类。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  古筝技法 (" HIY "guzheng-jifa" NOR ") 等级需达到 " HIY "100" NOR " 级。" ZJBR;
    msg += "  古筝技法 (" HIY "guzheng-jifa" NOR ") 等级需大于等于舞蛇曲等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  古筝技法（guzheng-jifa）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  需装备（手持）筝类物品。" ZJBR;
    msg += "  精神 (" CYN "jing" NOR ")：不低于 " CYN "80" NOR " 点。" ZJBR;
    msg += "  气血 (" HIR "qi" NOR ")：不低于 " HIR "30" NOR " 点。" ZJBR;
    msg += "  每次练习消耗精神：" CYN "25" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "15" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖特殊效果 (do_effect)〗" ZJBR NOR;
    msg += "  使用要求：" ZJBR;
    msg += "    综合等级 (古筝技法 / 2 + 舞蛇曲) 需达到 " HIY "50" NOR " 级。" ZJBR;
    msg += "    当前内力 (" HIB "neili" NOR ") 需达到 " HIB "50" NOR " 点。" ZJBR;
    msg += "    当前环境不能是禁止战斗区域。" ZJBR;
    msg += "    当前环境必须有蛇类资源 (定义在 `env->query(\"resource/snake\")`)。" ZJBR;
    msg += "    当前环境存在的蛇数量不能超过 12 条。" ZJBR;
    msg += "  效果描述：" ZJBR;
    msg += "    有几率从环境中召唤一条蛇。成功率与综合等级相关（等级越高越容易成功，但存在随机性）。" ZJBR;
    msg += "    召唤出的蛇会附加额外的毒性，毒性等级随机增加 (综合等级 / 5)。" ZJBR;
    msg += "  消耗与代价：" ZJBR;
    msg += "    每次尝试消耗内力 " HIB "20 至 29" NOR " 点。" ZJBR;

    return msg;
}
