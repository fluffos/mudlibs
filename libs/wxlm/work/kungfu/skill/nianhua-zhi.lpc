int valid_enable(string usage) { return usage == "finger" || usage == "parry"; }

int valid_combine(string combo) { return combo == "sanhua-zhang"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练拈花指必须空手。\n");

	if ((int)me->query_skill("force") < 60)
		return notify_fail("你的内功火候不够，无法学拈花指。\n");

	if ((int)me->query("max_neili") < 300)
		return notify_fail("你的内力太弱，无法练拈花指。\n");

	if ((int)me->query_skill("finger", 1) < (int)me->query_skill("nianhua-zhi", 1))
		return notify_fail("你的基本指法水平有限，无法领会更高深的拈花指。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action)-1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("nianhua-zhi",1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	if (me->query_temp("weapon") ||
	    me->query_temp("secondary_weapon"))
		return notify_fail("你必须空手练习！\n");

	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 70)
		return notify_fail("你的内力不够练拈花指。\n");

	me->receive_damage("qi", 50);
	me->add("neili", -64);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"nianhua-zhi/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【拈花指】" ZJBR NOR;
    msg += "少林七十二绝技之一，相传为佛祖拈花一笑之意境所化，讲究\"指过处，有花香\"。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  必须空手。" ZJBR;
    msg += "  基本内功等级 " HIY "60" NOR " 级。" ZJBR;
    msg += "  最大内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "  基本指法等级不低于拈花指等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  指法（finger）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须空手。" ZJBR;
    msg += "  气血：不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "64" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  拈花拂穴 (fuxue)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      拈花指等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      激发指法为拈花指。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：由 `通用命中公式` 函数根据双方指法和轻功等级计算。" ZJBR;
    msg += "      命中后使目标忙乱 " HIR "((自身拈花指等级 / 45) + 2)" NOR " 秒。" ZJBR;
    msg += "      此招式无直接伤害。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      未命中：内力 " HIB "30" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    return msg;
}