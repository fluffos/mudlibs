// 武学修养

inherit SKILL;

int valid_learn(object me)
{
	return notify_fail("武学修养是你武学方面的领悟，无法通过简单学习获得提升。\n");
}

int valid_research(object me)
{
	return notify_fail("武学修养来自你对实战体会的汲取吸收，无法通过研究提升。\n");
}

string query_description()
{
    string msg;

    msg = HIY "【武学修养】" ZJBR NOR;
    msg += WHT "武学修养代表着你对武学至理的深刻领悟和融会贯通的能力。" ZJBR;
    msg += WHT "它并非具体的招式或内功，而是综合武学见识和实战经验的体现。" ZJBR ZJBR;

    msg += HIY "〖技能性质〗" ZJBR NOR;
    msg += "  辅助技能。" ZJBR ZJBR;

    msg += HIY "〖学习与提升〗" ZJBR NOR;
    msg += "  无法通过常规的学习 (`learn`) 或研究 (`research`) 指令来提升。" ZJBR;
    msg += "  武学修养通常通过实战、历练、阅读高级武学典籍或完成特定任务等方式，" ZJBR;
    msg += "  从点滴积累中获得提升，反映了武者境界的成长。" ZJBR ZJBR;

    msg += HIY "〖主要作用〗" ZJBR NOR;
    msg += "  影响战斗中的攻防效果判定，尤其是在施展和抵御精妙招式时。" ZJBR;
    msg += "  可能影响某些高深武功的学习或领悟效率。" ZJBR;
    msg += "  是衡量一个武者综合武学境界的重要指标之一。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 武学修养的提升是一个潜移默化的过程，无法一蹴而就。" ZJBR;
    msg += "2. 高深的武学修养对于发挥武功的真正威力至关重要。" ZJBR;

    return msg;
}
