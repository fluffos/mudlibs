// beimin-shengong.c 青冥神功
// by doing



inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_force(string force)
{
	return force == "xiaoyao-xinfa" ||
	       force == "xiaowuxiang";
}

int query_neili_improve(object me)
{
	int lvl;

	lvl = (int)me->query_skill("beiming-shengong", 1);
	return lvl * lvl * 15 * 18 / 100 / 200;
}

int valid_learn(object me)
{
	int lvl = (int)me->query_skill("beiming-shengong", 1);

	if (me->query("gender") == "无性" && lvl > 49)
		return notify_fail("你无根无性，阴阳不调，难以领会高深的青冥神功。\n");

	if (me->query("int") < 32)
		return notify_fail("你觉得青冥神功艰深无比，难以领会。\n");

	if (me->query("con") < 24)
		return notify_fail("你试着运转了一下内力，眼前登时一黑！\n");

	return ::valid_learn(me);
}

string query_txt()
{
	return "要求：悟性32，根骨24，太监不能学习"ZJBR
	"特效：化解攻击者内力加力伤害将对手加力转化为自身内力，对比自身内功激发和攻击者内功激发，同激发等级1/2概率触发，不受其他特殊技能克制";
}

mixed valid_damage(object ob, object me, int damage, object weapon)
{
	mapping result;
	int ap, dp;
	int jiali;

	if ((int) me->query_skill("beiming-shengong", 1) < 70 ||
	    ! living(me))
		return;

	if ((jiali = ob->query("jiali")) < 1)
		return;

	ap = ob->query_skill("force");
	dp = me->query_skill("force");
	if (ap / 2 + random(ap) < dp)
	{
		if (me->query("neili") < me->query("max_neili") * 2)
			me->add("neili", jiali);

		result = ([ "damage" : -(damage * 3 / 4) ]);

		switch (random(4))
		{
		case 0:
			result += ([ "msg" : HIM "$N" HIM "只觉得内力源源而泄"
					     "，不由得大吃一惊。"NOR"\n" ]);
			break;
		case 1:
			result += ([ "msg" : HIM "$N" HIM "只觉得发出的内力犹"
					     "如石沉大海，不知所踪。"NOR"\n" ]);
			break;
		case 2:
			result += ([ "msg" : HIM "$N" HIM "只觉得发出的内力犹"
					     "无影无踪，浑然不知着落。"NOR"\n" ]);
			break;
		default:
			result += ([ "msg" : HIM "$N" HIM "不住催动内力，但是"
					     "只觉得$n" HIM "竟似毫不费力。"NOR"\n" ]);
			break;
		}
		return result;
	}
}

int practice_skill(object me)
{
    return notify_fail("青冥神功只能通过学习，或是从运用(exert)中增加熟练度。\n");
}

string exert_function_file(string func)
{
    return __DIR__"beiming-shengong/" + func;
}

string query_description()
{
    string msg;

    msg = "";
    msg += HIY "【北冥神功】" ZJBR ZJBR NOR;
    msg += WHT "北冥神功是一门高深的内功心法，以其吸收他人内力为己用而闻名。" ZJBR;
    msg += "此功法讲究以柔克刚，以弱胜强，能化解对手的攻击并转化为自身力量。" ZJBR ZJBR;
    msg += HIY "【学习要求】" ZJBR NOR;
    msg += "  性别：非无性" ZJBR;
    msg += "  先天悟性 32 点" ZJBR;
    msg += "  先天根骨 24 点" ZJBR;
    msg += "  无性者等级不能超过 49 级" ZJBR ZJBR;
    msg += HIY "【练习要求】" ZJBR NOR;
    msg += "  无法通过练习（practice）提高，可通过学习（learn）或运用（exert）提升" ZJBR ZJBR;
    msg += HIY "【技能效果】" ZJBR NOR;
    msg += "  可激发为内功（force）" ZJBR;
    msg += "  可与逍遥心法（xiaoyao-xinfa）、小无相功（xiaowuxiang）互备" ZJBR;
    msg += "  根据技能等级提升内力上限，等级越高，提升幅度越大" ZJBR;
    msg += HIY "【防御特效（化功）】" ZJBR NOR;
    msg += "  触发条件：" ZJBR;
    msg += "    - 北冥神功等级 70 级以上" ZJBR;
    msg += "    - 自身存活" ZJBR;
    msg += "    - 攻击者使用内力加力（jiali > 0）" ZJBR;
    msg += "    - 判定：(攻击者内功激发 / 2 + random(攻击者内功激发)) < 自身内功激发" ZJBR;
    msg += "  触发效果：" ZJBR;
    msg += "    - 完全抵消本次攻击的内力加力伤害" ZJBR;
    msg += "    - 吸收攻击者的加力值，补充自身内力（不超过内力上限2倍）" ZJBR ZJBR;
    msg += HIY "【特殊招式】" ZJBR NOR;
    msg += HIW "1. 北冥护体（shield）：" ZJBR NOR;
    msg += "  要求：北冥神功 50 级，当前内力 100 点" ZJBR;
    msg += "  内力消耗：100点" ZJBR;
    msg += "  效果：提高自身防御力" ZJBR;
    msg += "  数值：防御力提升 (基本内功等级 / 2)" ZJBR;
    msg += "  持续时间：(基本内功等级 / 10) 秒" ZJBR;
    msg += "  描述：运起北冥神功，全身笼罩在护体真气之中" ZJBR ZJBR;
    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 北冥神功需要高悟性和根骨，且无法练习，提升较为困难。" ZJBR;
    msg += "2. 化功效果需自身内功激发高于对手才有机会触发，等级越高越稳定。" ZJBR;
    msg += "3. 北冥护体是基础防御招式，应熟练运用。\n";

    return msg;
}