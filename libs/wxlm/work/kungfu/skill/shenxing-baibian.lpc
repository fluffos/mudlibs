// shenxing-baibian.c 神行千变

// written by That

inherit SKILL;

string *dodge_msg = ({
     "$n一式「行云流水」，身不倾，脚不移，身体如行云流水般直滑出丈余。\n",
     "$n一式「潜音夜行」，忽然一弯腰，全身贴地而行，顿时闪过了$N的凌厉攻势。\n",
     "$n一式「移步换形」，足不动，手不抬，一转眼间便绕到了$N的身后。\n",
     "$n一式「分身化影」，一转身间，四面八方飘动着无数个$n的身影，令$N手足无措。\n",
     "$n一式「洛神步法」，左踏巽，右转乾，身行一晃，便到几丈远的地方。\n",
     "$n一式「更上层楼」，身在空中，左脚在右足上一点，从$N头顶腾空而过。\n",
     "$n一式「仙子出水」，长袖一拂，全身化为一道白影，幽幽地从$N头顶飘落。\n",
     "$n一式「峰回路转」，身体如陀螺般急转，登时一股气流涌出，令$N难以动弹。\n",
     "$n一式「临行秋波」，身行倏的从$N的眼前直绕到身后，$N瞪大了两眼，不明所以。\n",
     "$n一式「浪子回头」，身行倏的从$N的眼前飘过，长发一甩，潇洒之极。\n",
});

int valid_enable(string usage) { return (usage == "dodge") || (usage == "move"); }

int valid_learn(object me) { return 1; }

string query_dodge_msg(string limb)
{
    return dodge_msg[random(sizeof(dodge_msg))];
}

int query_effect_dodge(object attacker, object me)
{
	int lvl;

	lvl = me->query_skill("shenxing-baibian", 1);
	if (lvl < 50)  return 0;
	if (lvl < 100) return 20;
	if (lvl < 150) return 30;
	if (lvl < 200) return 40;
	if (lvl < 250) return 50;
	if (lvl < 300) return 60;
	if (lvl < 350) return 70;
	return 80;
}

int practice_skill(object me)
{
      if((int)me->query("qi") < 50 )
	   return notify_fail("你的体力太差了，不能练神行千变。\n");

      if((int)me->query("neili") < 30 )
	   return notify_fail("你的内力太差了，不能练神行千变。\n");

      me->receive_damage("qi", 40);
      me->add("neill", -14);
      return 1;
}
string query_description()
{
    string msg;

    msg = HIY "【神行百变】" ZJBR ZJBR NOR;
    msg += WHT "铁剑门木桑道人所创的绝顶轻功，步法巧妙，变幻无方，旨在闪避腾挪，非用于直接攻击。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  无特殊要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  轻功 (dodge)。" ZJBR;
    msg += "  身法 (move)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  内力不低于 " HIB "30" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "40" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "14" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  提供额外的闪避几率加成，加成值随等级提升而增加：" ZJBR;
    msg += "    50-99 级：+20" ZJBR;
    msg += "    100-149 级：+30" ZJBR;
    msg += "    150-199 级：+40" ZJBR;
    msg += "    200-249 级：+50" ZJBR;
    msg += "    250-299 级：+60" ZJBR;
    msg += "    300-349 级：+70" ZJBR;
    msg += "    350 级及以上：+80" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无主动特殊招式。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 神行百变的被动闪避加成效果非常显著，等级越高效果越强。" ZJBR;
    msg += "2. 练习消耗较低，但仍需注意气血和内力。" ZJBR;
    msg += "3. 代码中内力消耗变量存在拼写错误 (`neill`)，实际消耗按 14 计算。\n";

    return msg;
}
