int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me)
{
     object weapon;
        
     if (me->query("gender") == "无性")
		return notify_fail("天魔剑法根本不是你这种无根无性的人所能理解的。\n");
     
	if (me->query("family/family_name") != "日月神教" || me->query("family/master_name") != "任横行")
		return notify_fail("你不是日月神教任横行弟子，无法理解天魔剑法的要领。\n");
        
     if (! objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "sword")
         return notify_fail("你必须装备剑才能学习剑法。\n");

     if ((int)me->query_skill("xixing-dafa", 1) < 150)
         return notify_fail("你的吸功大法还未大成，不能学习天魔剑法。\n");

     if ((int)me->query_skill("sword", 1) < 130)
         return notify_fail("你的基本剑法火候不够。\n");

     if ((int)me->query_skill("sword", 1) < (int)me->query_skill("tianmo-jian", 1))
         return notify_fail("你的基本剑法水平有限，无法领会更高深的天魔剑法。\n");

     return 1;
}

string query_skill_name(int level)
{
     int i;
     for(i = sizeof(action)-1; i >= 0; i--)
     if(level >= action[i]["lvl"])
            return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
     int i, level;
     level = (int) me->query_skill("tianmo-jian", 1);
     for(i = sizeof(action); i > 0; i--)
         if(level > action[i-1]["lvl"])
              return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
     object weapon;
     int cost;
        
     if (me->query("gender") == "无性")
		return notify_fail("天魔剑法根本不是你这种无根无性的人所能理解的。\n");
     
	if (me->query("family/family_name") != "日月神教" || me->query("family/master_name") != "任横行")
		return notify_fail("你不是日月神教任横行弟子，无法理解天魔剑法的要领。\n");
     
     if (! objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "sword")
         return notify_fail("你必须装备剑才能练剑法。\n");

     if ((int)me->query("qi") < 160)
         return notify_fail("你的体力太低了。\n");

     cost = me->query_skill("tianmo-jian", 1) / 2 + 100;
     if ((int)me->query("neili") < cost)
         return notify_fail("你的内力不够练「天魔剑法」。\n");

     me->receive_damage("qi", 130);
     me->add("neili", -cost);
     return 1;
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        if (victim->query("gender") == "无性" && damage_bonus > 5) {
                victim->receive_wound("qi", damage_bonus / 5);
                return HIR "你听到「哧~哧~」数声轻响，竟是有鲜血四处飞溅！"NOR"\n";
        }
}

string perform_action_file(string action)
{
     return __DIR__"tianmo-jian/" + action;
}

string query_description()
{
    string msg;

    msg = HIR "【天魔剑法】" ZJBR NOR;
    msg += "日月神教任横行的独门剑法，剑招凌厉狠辣，招式奇诡难测。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  需为日月神教任横行弟子。" ZJBR;
    msg += "  性别不能为无性。" ZJBR;
    msg += "  需持剑器。" ZJBR;
    msg += "  吸功大法等级需达到 " HIY "150" NOR " 级。" ZJBR;
    msg += "  基本剑法等级需达到 " HIY "130" NOR " 级。" ZJBR;
    msg += "  基本剑法等级需大于等于天魔剑法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  剑法（sword）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  需为日月神教任横行弟子。" ZJBR;
    msg += "  性别不能为无性。" ZJBR;
    msg += "  需持剑器。" ZJBR;
    msg += "  气血不低于 " HIR "160" NOR " 点。" ZJBR;
    msg += "  内力不低于 " HIB "天魔剑法等级 / 2 + 100" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血 " HIR "130" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力 " HIB "天魔剑法等级 / 2 + 100" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  天魔剑法对无性人物具有额外伤害效果。" ZJBR;
    msg += "  当攻击无性人物时，会造成额外的伤害：目标额外受到伤害值的1/5的气血伤害。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  天魔缠身 (chan)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      天魔剑法等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "80" NOR " 点。" ZJBR;
    msg += "      需持剑器且在战斗中对敌人使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：若随机(天魔剑法等级) > 目标基本招架等级的一半，则命中。" ZJBR;
    msg += "      命中后效果：使目标忙乱，忙乱时间为天魔剑法等级 / 20秒（最多8秒）。" ZJBR;
    msg += "      未命中则无效果。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      发动消耗：内力 " HIB "60" NOR " 点。" ZJBR;
    msg += "      命中后：自身忙乱 " HIR "1" NOR " 秒。" ZJBR;
    msg += "      未命中：自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  魔笑 (moxiao)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      天魔剑法等级 " HIY "80" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      需持剑器且在战斗中对敌人使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      发动后临时提升自身攻击力 天魔剑法等级 / 2 点。" ZJBR;
    msg += "      随后对敌人进行连续攻击，次数等同于基础攻击次数（约4-6次）。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "2-4" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  一剑穿心 (chuanxin)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      天魔剑法等级 " HIY "200" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      需持剑器且在战斗中对敌人使用。" ZJBR;
    msg += "      需解锁此绝技（可能需要特定任务或师傅传授）。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：若 天魔剑法等级/2 + 随机(天魔剑法等级) > 目标基本内功等级，则命中。" ZJBR;
    msg += "      命中效果：" ZJBR;
    msg += "        造成伤害：伤害值 = 天魔剑法等级 + 吸功大法等级，最终伤害为该值的一半加上该值一半的随机值。" ZJBR;
    msg += "        秒杀效果：若自身经验值是目标经验值的3倍以上，且命中，则直接致命。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力消耗 " HIB "220" NOR " 点，自身忙乱 " HIR "2-4" NOR " 秒。" ZJBR;
    msg += "      未命中：内力消耗 " HIB "60" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;

    return msg;
}

