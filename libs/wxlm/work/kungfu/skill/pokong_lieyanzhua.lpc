int valid_enable(string usage) { return usage == "cuff" || usage == "parry"; }

int valid_learn(object me)
{
    if (me->query("family/family_name"))
        return notify_fail("破空烈焰拳只有无门派的人才能学习。\n");

    if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
        return notify_fail("练习破空烈焰拳必须空手。\n");

    if ((int)me->query_skill("force") < 150)
        return notify_fail("你的内功火候不够，无法练习破空烈焰拳。\n");

    if ((int)me->query("max_neili") < 1000)
        return notify_fail("你的内力太弱，无法练习破空烈焰拳。\n");

    if ((int)me->query_skill("cuff", 1) < 100)
        return notify_fail("你的基本拳法火候不够，无法练习破空烈焰拳。\n");

    if ((int)me->query_skill("cuff", 1) < (int)me->query_skill("pokong_lieyanzhua", 1))
        return notify_fail("你的基本拳法水平有限，无法领会更高深的破空烈焰拳。\n");

    return 1;
}

string query_skill_name(int level)
{
    int i;
    for (i = sizeof(action) - 1; i >= 0; i--)
        if (level >= action[i]["lvl"])
            return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    int i, level;
    level = (int) me->query_skill("pokong_lieyanzhua", 1);
    for (i = sizeof(action); i > 0; i--)
        if (level > action[i-1]["lvl"])
            return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    if ((int)me->query("qi") < 70)
        return notify_fail("你的体力太低了。\n");

    if ((int)me->query("neili") < 70)
        return notify_fail("你的内力不够练破空烈焰拳。\n");

    me->receive_damage("qi", 60);
    me->add("neili", -65);
    return 1;
}

string perform_action_file(string action)
{
    return __DIR__"pokong_lieyanzhua/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
    int lvl;
    int i;

    lvl = me->query_skill("pokong_lieyanzhua", 1);
    i = random(lvl);

    if (i < 50)
        return 0;

    if (i < 100)
    {
        victim->receive_wound("qi", damage_bonus / 4);
        return HIR "$N" HIR "这一拳裹挟着炽热的气流,灼伤了$n" HIR "的皮肤！"NOR"\n";
    }
    else if (i < 150)
    {
        victim->receive_wound("qi", damage_bonus / 3);
        return HIY "$N" HIY "拳势如烈日当空,$n" HIY "顿觉全身灼痛,仿佛要被烤焦！"NOR"\n";
    }
    else
    {
        victim->receive_wound("qi", damage_bonus / 2);
        return HIW "$N" HIW "一拳轰出,破空烈焰之威尽显,$n" HIW "被这排山倒海的气势所慑,连连后退！"NOR"\n";
    }
}

string query_description()
{
    string msg;

    msg = HIR "【破空烈焰拳】" ZJBR NOR;
    msg += "传说中火神所创的绝世拳法，蕴含天火之力，刚猛无俦，有焚天煮海之威。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  必须为 无门派 人士。" ZJBR;
    msg += "  必须空手。" ZJBR;
    msg += "  基本内功 (force) 等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "  最大内力 (max_neili) 不低于 " HIB "1000" NOR " 点。" ZJBR;
    msg += "  基本拳法 (cuff) 等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "  基本拳法等级需大于等于破空烈焰拳等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  拳脚 (cuff)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  气血 (qi)：不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力 (neili)：不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "65" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // hit_ob
    msg += HIR "  [烈焰灼伤]" NOR "：普通攻击命中时，有几率对目标造成额外的气血伤害（灼伤效果）。" ZJBR;
    msg += "    触发概率：与自身破空烈焰拳等级相关（随机值小于等级时触发）。" ZJBR;
    msg += "    额外伤害：伤害量基于当次攻击的基础伤害和自身破空烈焰拳等级。" ZJBR;
    msg += "      - 等级 50-99 级：约附加基础伤害的 1/4。" ZJBR;
    msg += "      - 等级 100-149 级：约附加基础伤害的 1/3。" ZJBR;
    msg += "      - 等级 150 级及以上：约附加基础伤害的 1/2。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform_action_file

    msg += HIC "  焚天煮海 (fentian)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      破空烈焰拳等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      激发拳脚为破空烈焰拳。" ZJBR;
    msg += "      对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      发动连续攻击，攻击次数 = (基础攻击次数 + (拳法激发等级 + 内功激发等级) / 10)，最多额外增加 5 次攻击。" ZJBR;
    msg += "      暂时提升自身攻击命中等级 (" HIG "attack" NOR ")，提升值等于额外攻击次数。" ZJBR;
    msg += "      每次攻击有 1/3 几率使未忙乱的目标忙乱 " HIR "1" NOR " 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "200" NOR " 点。" ZJBR; // 注意：实际消耗比需求低
    msg += "      自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "  破空灭世 (pokongjue)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      破空烈焰拳等级 " HIY "140" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "400" NOR " 点。" ZJBR;
    msg += "      激发拳脚为破空烈焰拳。" ZJBR;
    msg += "      对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      发动毁天灭地的一击。" ZJBR;
    msg += "      命中判定：基于双方的 (拳法激发等级 + 内功激发等级) 与 (对方招架激发等级 + 对方轻功激发等级) 的对比。" ZJBR;
    msg += "      命中伤害：造成 (拳法激发等级 + 内功激发等级 + 随机((拳法激发等级 + 内功激发等级) / 2)) 的伤害，附加 " HIY "70" NOR " 点破甲效果。" ZJBR;
    msg += "      命中特效：若命中且 (自身ap / 3 + 随机(自身ap)) > 对方dp (ap和dp定义见命中判定)，且对方未忙乱，则使目标忙乱 (" HIR "(ap / 100) + 2" NOR ") 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 " HIB "300" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;
    msg += "      未命中：消耗内力 " HIB "100" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;

    return msg;
}