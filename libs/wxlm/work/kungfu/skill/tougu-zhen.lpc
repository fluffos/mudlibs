int valid_enable(string usage) { return usage=="finger" || usage=="parry"; }

int valid_combine(string combo) { return combo=="yinfeng-dao"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练透骨针必须空手。\n");

	if ((int)me->query_skill("force") < 200)
		return notify_fail("你的内功火候不够，无法练习透骨针。\n");

	if ((int)me->query("max_neili") < 1400)
		return notify_fail("你的内力太弱，无法练习透骨针。\n");

	if ((int)me->query_skill("finger", 1) < 100)
		return notify_fail("你的基本指法火候不够，无法练习透骨针。\n");

	if ((int)me->query_skill("finger", 1) < (int)me->query_skill("tougu-zhen", 1))
		return notify_fail("你的基本指法水平有限，无法领会更高深的透骨针。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level   = (int) me->query_skill("tougu-zhen",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 100)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 100)
		return notify_fail("你的内力不够练透骨针。\n");

	me->receive_damage("qi", 80);
	me->add("neili", -80);
	return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int lvl;
	int flvl;

	lvl  = me->query_skill("tougu-zhen", 1);
	flvl = me->query("jiali");
	if (lvl < 80 || flvl < 10 || ! damage_bonus)
		return;

	if (flvl * 2 + random(lvl) > victim->query_skill("force") &&
	    victim->affect_by("tougu_zhen",
			      ([ "level" : flvl + random(flvl),
				 "id"    : me->query("id"),
				 "duration" : lvl / 100 + random(lvl / 10) ])))
	{
		return "$n只感到从伤口处传来一阵切骨之痛，看来是受了对方透骨针内劲的干扰。\n";
	}
}

string perform_action_file(string action)
{
	return __DIR__"tougu-zhen/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【透骨针】" ZJBR NOR;
    msg += "透骨针是一门以阴寒内劲为主的高深指法武功，指力阴寒刚猛，直透骨髓。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功等级 " HIY "200" NOR " 级以上。" ZJBR;
    msg += "  内力最大值 " HIB "1400" NOR " 点以上。" ZJBR;
    msg += "  基本指法等级 " HIY "100" NOR " 级以上。" ZJBR;
    msg += "  基本指法等级不能低于透骨针等级。" ZJBR;
    msg += "  练习时必须空手。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  指法（finger）。" ZJBR;
    msg += "  招架（parry）。" ZJBR;
    msg += "  可与阴风刀（yinfeng-dao）互备。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "100" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "80" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "80" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  当透骨针等级达到 " HIY "80" NOR " 级，加力大于 " HIY "10" NOR " 点时，" ZJBR;
    msg += "  攻击有几率使对方受到透骨针内劲的影响，造成持续伤害。" ZJBR;
    msg += "  影响持续时间：透骨针等级 / 100 + 随机(透骨针等级 / 10) 秒。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  透骨封杀 (feng)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      透骨针等级 " HIY "100" NOR " 级以上。" ZJBR;
    msg += "      基本内功等级 " HIY "160" NOR " 级以上。" ZJBR;
    msg += "      内力最大值 " HIB "1000" NOR " 点以上。" ZJBR;
    msg += "      当前内力 " HIB "500" NOR " 点以上。" ZJBR;
    msg += "      激发指法为透骨针。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      手指挥舞，幻出漫天寒星，携带阴寒之劲封锁对方要穴。" ZJBR;
    msg += "      命中判定：" ZJBR; 
    msg += "        (指法有效激发 + 内功有效激发) / 2 + 随机(指法有效激发 + 内功有效激发) VS" ZJBR; 
    msg += "        (对方招架有效激发 + 对方轻功有效激发)" ZJBR;
    msg += "      伤害计算：" ZJBR;
    msg += "        (指法有效激发 + 内功有效激发) / 3 + 随机((指法有效激发 + 内功有效激发) / 4)" ZJBR;
    msg += "      附加效果：使对方受到透骨针内劲的影响，造成持续伤害" ZJBR;
    msg += "        持续时间：透骨针等级 / 50 + 随机(透骨针等级 / 20) 秒" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力 " HIB "250" NOR " 点，忙乱 " HIR "1" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "50" NOR " 点，忙乱 " HIR "3" NOR " 秒。" ZJBR;

    return msg;
}

