int valid_enable(string usage) { return usage == "finger" || usage == "parry"; } 
     
int valid_combine(string combo) { return combo == "xumishan-zhang"; } 
      
int valid_learn(object me) 
{ 
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon")) 
		return notify_fail("练大力金刚指必须空手。\n"); 
      
	if ((int)me->query_skill("force") < 60) 
		return notify_fail("你的内功火候不够，无法学大力金刚指。\n"); 
     
	if ((int)me->query("max_neili") < 300) 
		return notify_fail("你的内力太弱，无法练大力金刚指。\n"); 
      
	if ((int)me->query_skill("finger", 1) < (int)me->query_skill("jingang-zhi", 1))
		return notify_fail("你的基本指法水平有限，无法领会更高深的大力金刚指。\n"); 
      
	return 1; 
} 
      
string query_skill_name(int level) 
{ 
	int i; 
	for (i = sizeof(action) - 1; i >= 0; i--) 
		if (level >= action[i]["lvl"]) 
			return action[i]["skill_name"]; 
} 
      
mapping query_action(object me, object weapon) 
{ 
	int i, level; 
	level = (int) me->query_skill("jingang-zhi", 1); 
	for (i = sizeof(action); i > 0; i--) 
		if (level > action[i-1]["lvl"]) 
			return action[NewRandom(i, 20, level/5)]; 
} 
      
int practice_skill(object me) 
{ 
	if ((int)me->query("qi") < 70) 
		return notify_fail("你的体力太低了。\n"); 
      
	if ((int)me->query("neili") < 70) 
		return notify_fail("你的内力不够练大力金刚指。\n"); 
      
	me->receive_damage("qi", 60); 
	me->add("neili", -64); 
	return 1; 
} 
      
string perform_action_file(string action) 
{ 
	return __DIR__"jingang-zhi/" + action; 
} 

string query_description()
{
    string msg;

    msg = HIY "【大力金刚指】" ZJBR NOR;
    msg += "少林七十二绝技之一，指力刚猛，穿金破石。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  空手状态。" ZJBR;
    msg += "  基本内功等级不低于 " HIY "60" NOR " 级。" ZJBR;
    msg += "  最大内力不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "  基本指法等级需大于等于大力金刚指等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  指法（finger）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖可合并技能〗" ZJBR NOR;
    msg += "  可与 须弥山掌 (xumishan-zhang) 互备。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "64" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  暂无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  金刚伏魔决 (fumo)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      战斗中使用。" ZJBR;
    msg += "      空手状态。" ZJBR;
    msg += "      基本内功等级不低于 " HIY "200" NOR " 级。" ZJBR;
    msg += "      大力金刚指等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "400" NOR " 点。" ZJBR;
    msg += "      激发指法为大力金刚指。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      远程指力攻击。" ZJBR;
    msg += "      命中判定：基于双方（指法激发等级 + 内功激发等级）与（轻功激发等级 + 招架激发等级）的比较。" ZJBR;
    msg += "      伤害计算：命中后造成伤害，伤害值约为 ((指法激发等级 + 内功激发等级) / 2) + 随机((指法激发等级 + 内功激发等级) / 4)，附加55%伤害。" ZJBR;
    msg += "      命中特效：造成目标气血倒流，吐血不止。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 " HIB "200" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：消耗内力 " HIB "100" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;

    return msg;
}