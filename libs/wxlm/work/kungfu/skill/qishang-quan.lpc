int valid_enable(string usage) { return  usage=="cuff" || usage=="parry"; }

int valid_learn(object me)
{
	if ((int)me->query("str") < 10)
		return notify_fail("你这小身板练七丧拳，恐怕打不倒别人自己先倒下了吧！\n");

	if ((int)me->query("con") < 10)
		return notify_fail("你先天根骨不足，七丧拳恐怕伤己大过伤敌，别强学了。\n");

	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练七丧拳必须空手。\n");

	if ((int)me->query_skill("force") < 120)
		return notify_fail("你的基本内功不足120级，无法学七丧拳。\n");

	if ((int)me->query("max_neili") < 700)
		return notify_fail("你的最大内力不足700点，无法练七丧拳。\n");

	if ((int)me->query_skill("cuff", 1) < 100)
		return notify_fail("你的基本拳法不足100级，无法练七丧拳。\n");

	if ((int)me->query_skill("cuff", 1) < (int)me->query_skill("qishang-quan", 1))
		return notify_fail("你的基本拳法水平还不够，无法领会更高深的七丧拳法。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level   = (int) me->query_skill("qishang-quan",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 70)
		return notify_fail("你的内力不够练七丧拳。\n");

	me->receive_damage("qi", 55);
	me->add("neili", -61);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"qishang-quan/" + action;
}

string query_description()
{
    string msg;

    msg = HIR "【七伤拳】" ZJBR NOR;
    msg += "崆峒派镇山绝学，内含七种不同劲力，或刚猛、或阴柔、或刚中有柔、或柔中有刚，七股不同劲力，伤人脏腑，拳力复杂，吞吐闪烁。" ZJBR;
    msg += "拳谚云：『五行之气调阴阳，损心伤肺摧肝肠。藏离精失意恍惚，三焦齐逆兮魂魄飞扬。』" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  必须空手。" ZJBR;
    msg += "  先天臂力 (str) 不低于 " HIY "10" NOR " 点。" ZJBR;
    msg += "  先天根骨 (con) 不低于 " HIY "10" NOR " 点。" ZJBR;
    msg += "  基本内功 (force) 等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "  最大内力 (max_neili) 不低于 " HIB "700" NOR " 点。" ZJBR;
    msg += "  基本拳法 (cuff) 等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "  基本拳法等级需大于等于七伤拳等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  拳法 (cuff)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  气血 (qi)：不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力 (neili)：不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "55" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "61" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform_action_file

    msg += HIY "  七脉皆伤 (qimai)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      七伤拳等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "300" NOR " 级。" ZJBR;
    msg += "      最大内力 " HIB "2000" NOR " 点。" ZJBR;
    msg += "      当前内力 " HIB "500" NOR " 点。" ZJBR;
    msg += "      当前气血 " HIR "300" NOR " 点。" ZJBR;
    msg += "      激发拳法为七伤拳。" ZJBR;
    msg += "      对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      发动连环快拳攻击。" ZJBR;
    msg += "      命中判定：基于双方 (拳法激发等级 + 后天根骨 * 6) vs (对方内功激发等级 + 对方后天根骨 * 6)。" ZJBR;
    msg += "      命中效果：暂时提升自身攻击命中等级，提升量约为 (自身AP / 9)；暂时提升空手伤害 " HIB "50" NOR " 点。" ZJBR;
    msg += "      未命中效果：暂时提升自身攻击命中等级，提升量约为 (自身AP / 15)；暂时提升空手伤害 " HIB "50" NOR " 点。" ZJBR;
    msg += "      攻击次数：(基础攻击次数)。" ZJBR; // i < COMBAT_D->query_base_attack_number(me,query_name())
    msg += "      每次攻击有 2/5 几率使未忙乱的目标忙乱 " HIR "1" NOR " 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      消耗气血 " HIR "150" NOR " 点。" ZJBR;
    msg += "      自身忙乱 1 至 5 秒。" ZJBR ZJBR;

    msg += HIW "  伤字诀 (shang)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      七伤拳等级 " HIY "180" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "180" NOR " 级。" ZJBR;
    msg += "      最大内力 " HIB "1000" NOR " 点。" ZJBR;
    msg += "      当前内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      当前气血大于 (自身拳法激发等级 + 自身后天根骨 * 6) * 2 点。（提示：伤敌先伤己）" ZJBR;
    msg += "      激发拳法为七伤拳。" ZJBR;
    msg += "      对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      凝聚全身功力发出至猛一拳。" ZJBR;
    msg += "      命中判定：基于双方 (拳法激发等级 + 后天根骨 * 6) vs (对方内功激发等级 + 对方后天根骨 * 6)。对非玩家目标命中提高50%。" ZJBR;
    msg += "      命中伤害：造成 (自身AP + 随机(自身AP / 2)) 的伤害，附加 " HIY "60" NOR " 点破甲效果。对非玩家目标伤害翻倍。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      若命中：消耗内力 " HIB "200" NOR " 点，消耗气血 " HIR "(自身AP)" NOR " 点。" ZJBR;
    msg += "      若未命中：无额外消耗。" ZJBR;

    return msg;
}