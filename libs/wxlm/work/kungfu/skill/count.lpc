// count.c

inherit SKILL;

string type() { return "knowledge"; }

void skill_improved(object me)
{
}

int valid_learn(object me)
{
 

	if (me->query("family/family_name") != "桃花岛")
		return notify_fail("桃花岛的弟子才能学习该技能。\n");
	if ((int)me->query_skill("mathematics", 1) < 50)
		return notify_fail("你的算术知识太差，无法理解阴阳八卦的奥妙。\n");
	if ((int)me->query_skill("mathematics", 1) < (int)me->query_skill("count", 1))
		return notify_fail("你的算术知识有限，无法理解更深奥的阴阳八卦。\n");
	if ((int)me->query_skill("count", 1) > (int)me->query("int")*10)
		return notify_fail("你的先天悟性不够，无法理解更深奥的阴阳八卦。\n");

	return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【阴阳八卦】" ZJBR NOR;
    msg += "桃花岛独特的知识技能，融合了易经、数学和武学的精髓。" ZJBR;
    msg += "此技能能够帮助修炼者洞察天地阴阳变化，提升相关武学效果。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  需为桃花岛弟子。" ZJBR;
    msg += "  基本算术等级 " HIY "50" NOR " 级。" ZJBR;
    msg += "  基本算术等级需大于等于阴阳八卦等级。" ZJBR;
    msg += "  阴阳八卦有效等级上限：先天悟性 * 10。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  知识（knowledge）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  无法练习，需要通过阅读相关书籍或实践提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无直接攻防或被动效果，主要影响其他桃花岛武学或技能。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "无。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 阴阳八卦的学习需要扎实的算术基础，请先提高算术技能。" ZJBR;
    msg += "2. 该技能的提升受先天悟性限制，请合理分配技能点。" ZJBR;
    msg += "3. 具体效果请参照受其影响的其他桃花岛技能说明。\n";

    return msg;
}
