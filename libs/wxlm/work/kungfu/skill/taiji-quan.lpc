int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }

int valid_combine(string combo)
{
	return combo == "wudang-zhang" || combo == "paiyun-shou";
}

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练太极拳必须空手。\n");

	if ((int)me->query_skill("force") < 180)
		return notify_fail("你的内功火候不够，无法学太极拳。\n");

	if ((int)me->query("max_neili") < 1000)
		return notify_fail("你的内力太弱，无法练太极拳。\n");

	if ((int)me->query_skill("unarmed", 1) < 100)
		return notify_fail("你的基本拳脚火候不够，无法学太极拳。\n");

	if ((int)me->query_skill("unarmed", 1) < (int)me->query_skill("taiji-quan", 1))
		return notify_fail("你的基本拳脚水平有限，无法领会更高深的太极拳。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action) - 1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("taiji-quan", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i - 1]["lvl"])
			return action[NewRandom(i, 5, level / 5)];
}

string query_txt()
{
	return "学习要求：空手，内力1000，内功激发180，基本拳脚100，技能等级不能高于基本拳脚"ZJBR
	"特效：招架化解对手的空手攻击，对比自身(招架激发/4+技能等级)和攻击者内功激发，同等级1/3概率触发，受阴阳八卦克制";
}

mixed valid_damage(object ob, object me, int damage, object weapon)
{
	mixed result;
	int ap, dp, mp;

	if ((int)me->query_skill("taiji-quan", 1) < 100 ||
	    ! living(me))
		return;

	mp = ob->query_skill("count", 1);
	ap = ob->query_skill("force") + mp;
	dp = me->query_skill("parry") / 2 + me->query_skill("taiji-quan", 1);


	// 如果我是npc并且不是zhang sanfeng,dp 减少一半
	if (!playerp(me) && me->query("id") != "zhang sanfeng")
	{
		dp = dp / 2;
	}

	if (ap / 2 + random(ap) < dp)
	{
		result = ([ "damage": -(damage * 3 / 4) ]);

		switch (random(3))
		{
		case 0:
			result += (["msg" : HIC "$n" HIC "面含微笑，双手齐出，划出了"
					    "一个圆圈，竟然让$N" +
					    HIC "的攻击全不着力。"NOR"\n"]);
			break;

		case 1:
			result += (["msg" : HIC "$n" HIC "左右格档，使出四两拨千斤的手法，"
					    "化解$N" HIC "的攻势于无形。"NOR"\n"]);
			break;

		default:
			result += (["msg" : HIC "$n" HIC "慢慢出拳"
					    HIC "，动作虽然缓慢，却让$N"
					    HIC "感到浑身粘滞，甚不舒畅。"NOR"\n"]);
			break;
		}
		return result;
	} else
	if (mp >= 100)
	{
		switch (random(3))
		{
		case 0:
			result = HIY "$n" HIY "面含微笑，双手齐出，划出了"
				 "一个圆圈，然而$N" +
				 HIY "理也不理，随手挥招直入，进袭$n"
				 HIY "！"NOR"\n";
			break;

		case 1:
			result = HIY "$n" HIY "左右格档，使出四两拨千斤的手法，"
				 "可是$N" HIY "攻势却是变化无方，不遵循常理。"NOR"\n";
			break;

		default:
			result = HIY "$n" HIY "慢慢出拳"
				 HIY "，动作缓慢却让$N"
				 HIY "感到粘滞，可是$N"
				 HIY "立刻变化节奏，出奇招快速进击$n"
				 HIY "！"NOR"\n";
			break;
		}
		COMBAT_D->set_bhinfo(result);
	}
}

int query_effect_parry(object attacker, object me)
{
	int lvl;

	if (me->query_temp("weapon"))
		return 0;

	lvl = me->query_skill("taiji-quan", 1);
	if (lvl < 80)  return 0;
	if (lvl < 200) return 50;
	if (lvl < 280) return 80;
	if (lvl < 350) return 100;
	return 120;
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 100)
		return notify_fail("你的内力不够练太极拳。\n");

	me->receive_damage("qi", 40);
	me->add("neili", -80);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"taiji-quan/" + action;
}
//等级提升，是否学会新的招式
string query_skill_up(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
	 {
		if(level == action[i]["lvl"])
		 {
		     return action[i]["skill_name"];
		 }
	 }
	  return "no";
}

string query_description()
{
	string msg;

	msg = HIY "【太极拳】" ZJBR NOR;
	msg += "武当派镇派绝学之一，讲究以柔克刚，借力打力，变化万千。" ZJBR ZJBR; // 基本介绍

	msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
	msg += "  空手状态。" ZJBR;
	msg += "  基本内功等级不低于 " HIY "180" NOR " 级。" ZJBR;
	msg += "  最大内力不低于 " HIB "1000" NOR " 点。" ZJBR;
	msg += "  基本拳脚等级不低于 " HIY "100" NOR " 级。" ZJBR;
	msg += "  太极拳等级不能超过基本拳脚等级。" ZJBR ZJBR;

	msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
	msg += "  拳脚 (unarmed)。" ZJBR;
	msg += "  招架 (parry)。" ZJBR ZJBR;

	msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
	msg += "  气血不低于 " HIR "70" NOR " 点。" ZJBR;
	msg += "  内力不低于 " HIB "100" NOR " 点。" ZJBR;
	msg += "  每次练习消耗气血：" HIR "40" NOR " 点。" ZJBR;
	msg += "  每次练习消耗内力：" HIB "80" NOR " 点。" ZJBR ZJBR;

	msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // valid_damage, query_effect_parry
	msg += "  " HIW "招架化解" NOR "：" ZJBR;
	msg += "    招架时有几率完全化解敌人的攻击伤害。" ZJBR;
	msg += "    触发条件：空手状态，太极拳等级不低于 " HIY "100" NOR " 级。" ZJBR;
	msg += "    判定：比较自身 (招架激发等级 / 2 + 太极拳等级) 与攻击者 (内功激发等级 + 阴阳八卦等级)。防御判定值越高，化解几率越大。" ZJBR;
	msg += "    此效果受特殊技能 " HIY "阴阳八卦" NOR " 克制。" ZJBR;
	msg += "  " HIW "招架加成" NOR "：" ZJBR;
	msg += "    提升招架的防御效果，数值随太极拳等级提升（80级开始生效，最高增加 " HIY "120" NOR " 点效果）。" ZJBR ZJBR;

	msg += HIY "〖特殊招式〗" ZJBR NOR; // perform_action_file
	msg += HIC "  震字诀 (zhen)" ZJBR NOR;
	msg += "    使用要求：" ZJBR;
	msg += "      太极拳等级 " HIY "50" NOR " 级。" ZJBR;
	msg += "      基本内功等级 " HIY "80" NOR " 级。" ZJBR;
	msg += "      当前内力 " HIB "100" NOR " 点。" ZJBR;
	msg += "    效果描述：" ZJBR;
	msg += "      以太极拳劲力震伤单一目标。" ZJBR;
	msg += "      命中判定：比较双方 (内功等级 + 太极拳等级)，自身判定值高则命中。" ZJBR;
	msg += "      命中后对目标造成内伤，伤害值约为 (自身内功等级 + 随机(自身内功等级 / 3))。" ZJBR;
	msg += "    消耗与代价：" ZJBR;
	msg += "      内力 " HIB "100" NOR " 点。" ZJBR;
	msg += "      自身忙乱 " HIR "1" NOR " 秒。" ZJBR ZJBR;

	msg += HIC "  太极图 (tu)" ZJBR NOR;
	msg += "    使用要求：" ZJBR;
	msg += "      太极拳等级 " HIY "150" NOR " 级。" ZJBR;
	msg += "      太极神功等级 " HIY "150" NOR " 级。" ZJBR;
	msg += "      道学心法等级 " HIY "150" NOR " 级。" ZJBR;
	msg += "      当前精力 " HIC "300" NOR " 点。" ZJBR;
	msg += "      当前内力 " HIB "1000" NOR " 点。" ZJBR;
	msg += "      激发内功为太极神功。" ZJBR;
	msg += "    效果描述：" ZJBR;
	msg += "      画出太极图攻击范围内所有敌人。" ZJBR;
	msg += "      命中判定(对每个敌人)：通用命中判定（拳脚 vs 招架）。" ZJBR;
	msg += "      伤害计算：造成与自身太极拳、太极神功等级相关的显著伤害。" ZJBR;
	msg += "      附加效果(对命中敌人)：" ZJBR;
	msg += "        造成 " HIR "2" NOR " 秒忙乱。" ZJBR;
	msg += "        削减内力 " HIB "500" NOR " 点。" ZJBR;
	msg += "      武当派特效(若使用者为武当派弟子且具备相应武学)：" ZJBR;
	msg += "        短时提升自身攻击和轻功。" ZJBR;
	msg += "        可能触发武当心法或无极神通相关奥义（如挤字诀、缠字诀等），造成额外伤害或特殊效果。" ZJBR;
	msg += "        可能获得额外的普通攻击次数。" ZJBR;
	msg += "    消耗与代价：" ZJBR;
	msg += "      精力 " HIC "300" NOR " 点。" ZJBR;
	msg += "      内力 " HIB "1000" NOR " 点。" ZJBR;
	msg += "      自身忙乱 " HIR "2" NOR " 秒。" ZJBR;

	return msg;
}
