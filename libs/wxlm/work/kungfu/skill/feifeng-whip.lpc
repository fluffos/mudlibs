// feifeng-whip.c 飞凤鞭法



inherit SKILL;

mapping *action = ({
([	"action": "$N向上跃起，一招「凤凰展翅」，手中$w自下而上，击向$n的脸颊",
	"force" : 100,
	"dodge" : 0,
	"damage": 20,
	"lvl"   : 15,
	"skill_name" : "凤凰展翅",
	"damage_type":	"刮伤"
]),
([	"action": "$N一招「彩凤栖梧」，手中$w直绕向$n的$l",
	"force" : 110,
	"dodge" : -10,
	"damage": 30,
	"lvl"   : 20,
	"skill_name" : "彩凤栖梧",
	"damage_type":	"内伤"
]),
([      "action": "$N一招「鸾凤和鸣」，手中$w腾空一卷，一声脆响入磬，猛地向$n劈头打下",
	"force" : 120,
	"dodge" : -15,
	"damage": 40,
	"lvl"   : 40,
	"skill_name" : "鸾凤和鸣",
	"damage_type":	"劈伤"
]),
([      "action": "$N踏上一步，冲着$n轻佻一笑，手中$w却毫不停留，一招「游龙戏凤」，"
		  "扫向$n的$l",
	"force" : 130,
	"dodge" : -30,
	"damage": 60,
	"lvl"   : 50,
	"skill_name" : "游龙戏凤",
	"damage_type":	"刺伤"
]),
([      "action": "$N跃在半空，一招「龙飞凤舞」，手中$w如游龙洗空，长凤戏羽，"
		  "乱雨倾盆般分点$n左右",
	"force" : 150,
	"dodge" : -35,
	"damage": 70,
	"lvl"   : 60,
	"skill_name" : "龙飞凤舞",
	"damage_type":	"刺伤"
]),
([      "action": "$N向前急进，手中$w圈转如虹，一招「龙凤呈祥」，罩向$n前胸",
	"force" : 170,
	"dodge" : -40,
	"damage": 85,
	"lvl"   : 75,
	"skill_name" : "龙凤呈祥",
	"damage_type":	"内伤"
])
});

int valid_enable(string usage) { return usage == "whip" || usage == "parry"; }

int valid_learn(object me)
{
	object weapon;

	if ((int)me->query_skill("force") < 30)
		return notify_fail("你的内功火候太浅。\n");

	if (me->query("gender") != "女性")
		return notify_fail("大老爷们学这飞凤鞭？天资不足吧。\n");

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "whip")
		return notify_fail("你必须先找一条长鞭才能练鞭法。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action) - 1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;

	level = (int) me->query_skill("feifeng-whip", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i - 1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "whip")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 60)
		return notify_fail("你的体力不够练飞凤鞭法。\n");

	if ((int)me->query("neili") < 20)
		return notify_fail("你的内力不够练飞凤鞭法。\n");

	me->receive_damage("qi", 20);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"feifeng-whip/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【飞凤鞭法】" ZJBR NOR;
    msg += WHT "一门轻灵飘逸的鞭法，招式多变，适合女性修炼。" ZJBR;
    msg += "据传模仿凤凰飞舞之姿所创。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功等级不低于 " HIY "30" NOR " 级。" ZJBR;
    msg += "  性别必须为 " HIY "女性" NOR "。" ZJBR;
    msg += "  必须装备鞭类武器。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  鞭法（whip）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "60" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "20" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "20" NOR " 点。" ZJBR;
    msg += "  （练习不消耗内力）。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  飞凤翔舞 (wu)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      飞凤鞭法等级 " HIY "60" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      激发鞭法为飞凤鞭法，并装备鞭类武器。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标发动攻击，命中判定受自身鞭法技能等级与目标内功激发等级影响。" ZJBR;
    msg += "      命中判定公式：随机(自身鞭法技能等级) > 目标内功激发等级 / 2" ZJBR;
    msg += "      命中后，首先造成一次伤害，伤害值约为 (自身内功激发等级 + 自身鞭法技能等级) / 8，并附加随机伤害。" ZJBR;
    msg += "      之后追加相当于自身攻击次数 (`COMBAT_D->query_base_attack_number`) 的额外普通攻击。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力 " HIB "50" NOR " 点，忙乱 " HIR "1~3" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "70" NOR " 点，忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 飞凤鞭法需要灵活的身法和精准的控制，练习时需要注意提高这两项属性。" ZJBR;
    msg += "2. 在实战中，要善于利用鞭法的灵活性，进行快速连击。" ZJBR;
    msg += "3. 特殊招式「飞凤翔舞」命中后可追加多次攻击，威力不俗。" ZJBR;

    return msg;
}