// guixi-gong.c

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_force(string force)
{
    return force == "huagong-dafa";
}

int valid_learn(object me)
{
	return 1;
}

int practice_skill(object me)
{
	return notify_fail("龟息功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
    return __DIR__"guixi-gong/" + func;
}

string query_description()
{
    string msg;

    msg = HIY "【龟息功】" ZJBR NOR;
    msg += "基础内功。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  无特殊要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功（force）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  无法通过练习 (practice) 提升，只能通过学习 (learn) 提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  可作为 化功大法 (huagong-dafa) 的基础内功。" ZJBR;
    msg += "  暂无其他已知攻防特效或被动效果。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  暂无特殊内功运用。" ZJBR;

    return msg;
}