int valid_enable(string usage) {return usage == "sword" || usage == "parry";}

int valid_learn(object me)
{
        if (me->query("int") < 30)
                return notify_fail("你先天悟性不足，无法领悟逍遥剑法。\n");
 
        if ((int)me->query("max_neili") < 2500)
                return notify_fail("你的内力修为不够，无法学习逍遥剑法。\n");

        if ((int)me->query_skill("force", 1) < 120)
                return notify_fail("你的基本内功火候太浅，无法学习逍遥剑法。\n");

        if ((int)me->query_skill("dodge", 1) < 120)
                return notify_fail("你的基本内功火候太浅，无法学习逍遥剑法。\n");

        if ((int)me->query_skill("sword", 1) < 120)
                return notify_fail("你的基本剑法火候不够，无法学习逍遥剑法。\n");

        if ((int)me->query_skill("sword", 1) < (int)me->query_skill("xiaoyao-jian", 1))
                return notify_fail("你的基本剑法水平有限，无法领会更高深的逍遥剑法。\n");

        return 1;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
        object weapon;

        int lvl = me->query_skill("xiaoyao-jian", 1);
        weapon = me->query_temp("weapon");      

        if (lvl < 130 || lvl / 2 + random(lvl) < (int)victim->query_skill("dodge", 1) ||
            me->query("neili") < 150 ||
            me->query_skill("dodge", 1) < 180 ||
            me->query_skill("force", 1) < 150 ||             
            victim->is_busy() )
                 return 0;

        message_vision(HIW "\n$N" HIW "右手" + weapon->name() + HIW "猛然旋转，剑光突"
                       "现，刹那间已将$n" HIW "退路全部封死。\n" NOR, me, victim); 

        me->add("neili", -80);
        victim->start_busy(2 + random(lvl / 30));

        return 1;                         
}

mapping query_action(object me, object weapon)
{
        int i, level;
        level   = (int) me->query_skill("xiaoyao-jian",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
        object weapon;

        if (!objectp(weapon = me->query_temp("weapon")) ||
            (string)weapon->query("skill_type") != "sword")
                return notify_fail("你使用的武器不对。\n");

        if ((int)me->query("qi") < 60)
                return notify_fail("你的体力目前没有办法练习逍遥剑法。\n");

        if ((int)me->query("neili") < 90)
                return notify_fail("你的内力不够，无法练习逍遥剑法。\n");
        
        me->add("qi", -50);
        me->add("neili", -82);
        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"xiaoyao-jian/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【逍遥剑法】" ZJBR NOR;
    msg += "逍遥剑法是一套灵动飘逸的剑法。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  先天悟性：不低于 " HIY "30" NOR " 点。" ZJBR;
    msg += "  最大内力：不低于 " HIY "2500" NOR " 点。" ZJBR;
    msg += "  基本内功等级：不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "  基本轻功等级：不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "  基本剑法等级：不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "  基本剑法等级不能低于逍遥剑法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  剑法（sword）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  需装备剑类武器。" ZJBR;
    msg += "  气血：不低于 " HIR "60" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "90" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "82" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += HIC "  剑光封路" ZJBR NOR;
    msg += "    逍遥剑法等级达到 " HIY "130" NOR " 级后，在普通攻击命中时有几率触发。" ZJBR;
    msg += "    触发时消耗 " HIB "80" NOR " 点内力，使目标忙乱一段时间，忙乱时间受逍遥剑法等级影响。" ZJBR;
    msg += "    命中判定与自身逍遥剑法等级、基本轻功等级、基本内功等级以及目标的躲闪能力有关。目标处于忙乱状态时不会触发此效果。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  飞剑诀 (fei)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      逍遥剑法等级 " HIY "60" NOR " 级。" ZJBR;
    msg += "      需装备剑类武器。" ZJBR;
    msg += "      当前内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      激发剑法为逍遥剑法。" ZJBR;
    msg += "      轻功有效激发等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      目标不在忙乱状态。" ZJBR;
    msg += "      目标为活物且在战斗中。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      快速身法使剑犹如脱手飞旋，笼罩目标周身。" ZJBR;
    msg += "      命中判定：受自身剑法有效激发等级和目标的躲闪能力影响。判定成功则使目标进入忙乱状态 " HIR "4" NOR " 秒加上随机时间（受自身剑法有效激发等级影响）。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 " HIB "120" NOR " 点，自身忙乱 " HIR "0-1" NOR " 秒（随机）。" ZJBR;
    msg += "      未命中：自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  快剑诀 (kuai)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      逍遥剑法等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      需装备剑类武器。" ZJBR;
    msg += "      当前内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      激发剑法为逍遥剑法。" ZJBR;
    msg += "      目标为活物且在战斗中。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      施展连续的快速剑招攻击目标。" ZJBR;
    msg += "      攻击次数：基础次数为 " HIY "4" NOR " 次，加上自身剑法有效激发等级/40 的随机次数，最多总共 " HIY "9" NOR " 次，再加上自身基础攻击次数。" ZJBR;
    msg += "      每次攻击有几率使目标忙乱 " HIR "1" NOR " 秒（目标未忙乱时）。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力：每次攻击消耗 " HIB "30" NOR " 点内力，总消耗为 (总攻击次数) * 30 点。" ZJBR;
    msg += "      自身代价：自身忙乱 " HIR "1" NOR " 秒加上随机时间（受总攻击次数影响）。攻击过程中会临时提升自身 " HIY "20" NOR " 点攻击力。" ZJBR ZJBR;

    msg += HIC "  奇剑诀 (qi)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      逍遥剑法等级 " HIY "160" NOR " 级。" ZJBR;
    msg += "      需装备剑类武器。" ZJBR;
    msg += "      基本内功等级 " HIY "160" NOR " 级。" ZJBR;
    msg += "      最大内力 " HIB "2200" NOR " 点。" ZJBR;
    msg += "      当前内力 " HIB "350" NOR " 点。" ZJBR;
    msg += "      激发剑法为逍遥剑法。" ZJBR;
    msg += "      目标为活物且在战斗中。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      将剑斜指长空，飞身跃起，剑光飘忽不定直指目标咽喉。" ZJBR;
    msg += "      命中判定：受自身剑法有效激发等级和轻功有效激发等级之和，与目标的招架有效激发等级和躲闪能力之和影响。" ZJBR;
    msg += "      命中伤害：造成武器伤害类型（刺伤）的伤害，伤害值为 (自身剑法有效激发等级 + 轻功有效激发等级) + 随机((自身剑法有效激发等级 + 轻功有效激发等级) / 4)，并附加 " HIR "78%" NOR " 的伤害系数。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 " HIB "300" NOR " 点，自身忙乱 " HIR "2" NOR " 秒加上随机时间（0-3秒）。" ZJBR;
    msg += "      未命中：消耗内力 " HIB "200" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    return msg;
}

