inherit SKILL;

string type() { return "knowledge"; }

void skill_improved(object me)
{}

int valid_learn(object me)
{
    return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【工艺学识】" ZJBR NOR;
    msg += "关于各种工艺制作的知识，影响相关物品的制作能力。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  无特殊要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // type()
    msg += "  知识（knowledge）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill (知识技能无练习)
    msg += "  无法练习，需要通过阅读相关书籍或实践提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // skill_improved (空)
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform/exert
    msg += "  无。" ZJBR;

    return msg;
}

