// chuancai-jiyi.c

inherit SKILL;

string type() { return "knowledge"; }

int valid_enable(string usage) { return usage == "cooking"; }

int valid_learn(object me)
{
    return 1;
}

mapping query_menu(object me)
{
	return ([ "香酥花生"   : ({ "xiangshu huasheng" }),
		  "麻辣手撕鸡" : ({ "mala ji" }),
		  "手撕鸡"     : ({ "shousi ji" }),
		  "三黄鸡"     : ({ "sanhuang ji" }),
		  "干煸尤鱼"   : ({ "ganbian youyu" }),
		  "鱼香肉丝"   : ({ "yuxiang rousi" }),
		  "宫宝鸡丁"   : ({ "gongbao jiding" }),
		  "红油肚片"   : ({ "hongyou dupian" }),
		  "麻婆豆腐"   : ({ "mapo doufu" }),
		  "夫妻肺片"   : ({ "fuqi feipian" }),
		  "毛血旺"     : ({ "maoxue wang" }),
		  "粉蒸肉"     : ({ "fenzheng rou" }) ]);
}

int practice_skill(object me)
{
	object cailiao;

	if (! objectp(cailiao = present("cai liao", me)) ||
	    cailiao->query_amount() < 1)
		return notify_fail("你身上没有菜料了。\n");

	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力不够了，无法锻炼手艺。\n");

	if ((int)me->query("jing") < 50)
		return notify_fail("你的精神不济，无法锻炼手艺。\n");

	me->receive_damage("qi", 40);
	me->receive_jing("jing", 40);
	cailiao->add_amount(-1);

	return 1;
}

string query_description()
{
    string msg;

    msg = "";
    msg += HIY "【川菜技艺】" ZJBR ZJBR NOR;
    msg += WHT "川菜技艺是一门源自四川的烹饪技巧,以其麻辣鲜香著称。" ZJBR;
    msg += "此技艺讲究火候掌控、调味精准,菜品口味浓郁、层次丰富。" ZJBR ZJBR;
    msg += HIY "【技能要求】" ZJBR NOR;
    msg += "  基本烹饪等级：30级" ZJBR ZJBR;
    msg += HIY "【技能效果】" ZJBR NOR;
    msg += "  可激发为烹饪（cooking）" ZJBR;
    msg += "  烹饪成功率：80%加上川菜技艺等级的三分之一" ZJBR;
    msg += "  有效等级上限：基本烹饪等级的两倍" ZJBR ZJBR;
    msg += HIY "【菜品列表】" ZJBR NOR;
    msg += "  1. 香酥花生" ZJBR;
    msg += "  2. 麻辣手撕鸡" ZJBR;
    msg += "  3. 手撕鸡" ZJBR;
    msg += "  4. 三黄鸡" ZJBR;
    msg += "  5. 干煸尤鱼" ZJBR;
    msg += "  6. 鱼香肉丝" ZJBR;
    msg += "  7. 宫保鸡丁" ZJBR;
    msg += "  8. 红油肚片" ZJBR;
    msg += "  9. 麻婆豆腐" ZJBR;
    msg += "  10. 夫妻肺片" ZJBR;
    msg += "  11. 毛血旺" ZJBR;
    msg += "  12. 粉蒸肉" ZJBR ZJBR;
    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 川菜技艺需要高超的烹饪修为,练习时需要注意提高基本烹饪技巧。" ZJBR;
    msg += "2. 在烹饪时,要注意火候的掌控和调味的精准,以确保菜品口味正宗。" ZJBR;
    msg += "3. 不同菜品有不同的制作难度,需要根据自身技艺水平选择合适的菜品。\n";

    return msg;
}
