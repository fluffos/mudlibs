// shield.c 护体神功
//



inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

string query_name() { return "邪气"ZJBR"护体"; }
string *pfm_type() { return ({ "force", }); }

int exert(object me, object target)
{
	int skill;

	if (target != me)
		return notify_fail("你只能用辟邪剑法来提升自己的防御力。\n");

	if ((int)me->query("neili") < 100)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("pixie-jian", 1) < 50)
		return notify_fail("你的辟邪剑法修为不够。\n");

	if ((int)me->query_temp("shield"))
		return notify_fail("你已经在运功中了。\n");

	skill = me->query_skill("force");
	me->add("neili", -100);
	me->receive_damage("qi", 0);

	message_combatd(HIW "$N" HIW "身子忽前忽后，忽左忽右，一"
			"层层气浪跌宕翻涌，护住全身！"NOR"\n", me);

	me->add_temp("apply/armor", skill *2 / 2);
	me->add_temp("apply/armor1", skill *1 / 2);
	me->set_temp("shield", 1);

	me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill * 2 / 2 :), skill);

	if (me->is_fighting()) me->start_busy(2);

	return 1;
}

void remove_effect(object me, int amount)
{
        if (!me) return;

	me->add_temp("apply/armor", -amount);
	me->add_temp("apply/armor1", -amount/2);
	me->delete_temp("shield");
	tell_object(me, "你的辟邪剑法运行完毕，将内力收回丹田。\n");
}
string query_txt()
{
	return @DESC
招式简介：
「邪气护体」是辟邪剑法中的一种防御技巧，通过消耗大量真气，在短时间内形成强大的护体气墙，显著增强施术者的防御能力。施展此招，施术者周身将涌现层层气浪，宛如坚不可摧的屏障。

施展条件：

施术者必须为自身，即此招式不可对他人使用。
施术者真气值需达到100点以上。
施术者辟邪剑法的基本技能等级至少为50级。
施术者当前未处于「邪气护体」的效果状态中。
施展流程：

施术者消耗100点真气。
施术者将遭受轻微的气血损伤，代表内力的过度损耗。
施术者身体四周气浪翻涌，形成护体气墙。
施术者防御力临时增加，数值为其内功技能等级的两倍后除以2。
施术者进入「邪气护体」的状态，该状态将在一段时间后自动解除，解除时防御力恢复原状。
若施术者当前正在战斗中，则进入2回合的忙乱状态。
效果说明：

施术者在「邪气护体」状态下，防御力大幅提升，但此状态并非永久，持续时间等于施术者内功技能等级。
状态解除后，施术者将内力收回丹田，恢复正常状态。
DESC;
}
