// kuihua.c 「葵花心法」



inherit F_SSERVER;

string query_name() { return "葵花"ZJBR"心法"; }
string *pfm_type() { return ({ "force", }); }

int exert(object me, object target)
{
	string msg;
	int skill, jing_cost;
	int improve;

	skill = me->query_skill("pixie-jian", 1);
	jing_cost = 45 - (int)me->query("int");
	if (jing_cost < 5) jing_cost = 5;

	if (environment(me)->query("no_fight"))
		return notify_fail("这里太嘈杂，你不能静下心来运习。\n");

	if (me->is_fighting())
		return notify_fail("「葵花心法」不能在战斗中运习。\n");

	if (! skill || skill < 80)
		return notify_fail("你的辟邪剑法等级不够, 不能运习「葵花心法」！\n");

	if (me->query("neili") < 30)
		return notify_fail("你的内力不够，无法运习「葵花心法」！\n");

	if (me->query("jing") < jing_cost)
		return notify_fail("你现在太累了，无法集中精神运习「葵花心法」！\n");

	if (! me->can_improve_skill("dodge"))
		return notify_fail("你的实战经验不够，无法体会「葵花心法」！\n");

	if (me->query("dodge", 1) >= me->query_skill("pixie-jian", 1))
		return notify_fail("你的辟邪剑法修为有限，无法领会更高深的「葵花心法」！\n");

	msg = HIM "$N" HIM "盘膝默坐，暗自运习葵花心法，只觉得身子越来越轻。"NOR"\n";
	message_combatd(msg, me);

	me->add("neili", -20 - random(10));
	me->receive_damage("jing", jing_cost);

	improve = 1 + random(me->query("int"));

	tell_object(me, MAG "你的「基本轻功」进步了！"NOR"\n");
	me->improve_skill("dodge", improve);
	me->start_busy(random(3));
	return 1;
}

string query_txt()
{
	return @DESC
招式简介：
修炼此心法可以极大地提升施术者的内力及轻功能力，使身体变得如同无物般轻盈，提高闪避与速度。
施展条件：
施术者辟邪剑法的基本技能等级至少为80级。
施术者当前处于非战斗状态。
施术者周围环境允许静心运功，即所在场景不禁止战斗。
施术者内力值需达到30点以上。
施术者精力值（精）需达到特定要求，具体数值为45减去悟性属性，但最低不得低于5点。
施术者实战经验足够，能够继续提升基本轻功技能。
施术者辟邪剑法的技能等级必须高于其当前基本轻功技能等级。
施展流程：
施术者盘膝而坐，默运葵花心法，逐渐感到身体变得异常轻盈。施展过程中，施术者将消耗内力与精力，同时进入忙乱状态。
效果说明：
施术者的基本轻功技能将获得提升，提升量为1加上悟性属性的随机值。
施术者进入忙乱状态，持续回合数为随机数（最高3回合）。
注意事项：
「葵花心法」只能在非战斗状态下运习，且对辟邪剑法技能等级有较高要求。
DESC;
}
