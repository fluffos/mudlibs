// powerup.c



inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

string query_name() { return "邪气"ZJBR"冲天"; }
string *pfm_type() { return ({ "force", }); }

int exert(object me, object target)
{
	int skill;

	if (target != me)
		return notify_fail("你只能用辟邪剑法提升自己的战斗力。\n");

	if ((int)me->query("neili") < 100)
		return notify_fail("你的真气不够！\n");

	if (me->query_skill("pixie-jian", 1) < 120)
		return notify_fail("你的辟邪剑法修行不够，难以运功。\n");

	if ((int)me->query_temp("powerup"))
		return notify_fail("你已经在运功中了。\n");

	skill = me->query_skill("force");

	me->add("neili", -100);
	me->receive_damage("qi", 0);

	message_combatd(HIR "$N" HIR "身形忽然变得诡秘异常，进退"
			"之间飘忽不定，令人无从捉摸。"NOR"\n", me);

	me->add_temp("apply/attack", skill / 3);
	me->add_temp("apply/dodge", skill * 2 / 5);
	me->set_temp("powerup", 1);

	me->start_call_out((: call_other, __FILE__, "remove_effect",
			   me, skill :), skill);

	if (me->is_fighting()) me->start_busy(3);

	return 1;
}

void remove_effect(object me, int level)
{
	if ((int)me->query_temp("powerup"))
	{
		me->add_temp("apply/attack", -(level / 3));
		me->add_temp("apply/dodge", -(level * 2 / 5));
		me->delete_temp("powerup");
		tell_object(me, "你的辟邪剑法运行完毕，将内力收回丹田。\n");
	}
}

string query_txt()
{
	return @DESC
「邪气冲天」是辟邪剑法中的一种特殊技巧，通过短暂牺牲大量真气，短时间内极大提升自身的攻击与闪避能力。施展此招，施术者会散发出诡异的气息，行动变得难以捉摸。

施展条件：

施术者必须为自身，即此招式不可对他人使用。
施术者真气值需达到100点以上。
施术者辟邪剑法的基本技能等级至少为120级。
施术者当前未处于「邪气冲天」的效果状态中。
施展流程：

施术者消耗100点真气。
施术者将遭受轻微的气血损伤，代表内力的过度损耗。
施术者的身体变得诡秘异常，行动飘忽不定。
施术者攻击力临时增加，数值为其内功技能等级的三分之一。
施术者闪避能力临时增加，数值为其内功技能等级的二分之二。
施术者进入「邪气冲天」的状态，该状态将在一段时间后自动解除，解除时攻击力与闪避力恢复原状。
若施术者当前正在战斗中，则进入3回合的忙乱状态。
DESC;
}

