// gui.c 鬼魅身法



inherit F_SSERVER;

string query_name() { return "鬼魅"ZJBR"身法"; }

int perform(object me, object target)
{
	string msg;
	int ap, dp;

	if (! target) target = offensive_target(me);

	if (! target || ! me->is_fighting(target))
		return notify_fail("鬼魅身法只能对战斗中的对手使用。\n");

	if (target->is_busy())
		return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧！\n");
		
	if ((int)me->query_skill("pixie-jian", 1) < 100)
		return notify_fail("你的辟邪剑法火候不够，不会使用鬼魅身法。\n");

       if (! living(target))
	      return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

	msg = HIR "$N" HIR "身子忽进忽退，身形诡秘异常，在$n"
	      HIR "身边飘忽不定。"NOR"\n";

	ap = me->query_skill("pixie-jian", 1) * 2;
	dp = target->query_skill("parry");

	if (COMBAT_D->hit_determination(me,target,ap,dp))
	{
		msg += HIR "结果$p" HIR "只能紧守门户，不敢妄自出击！"NOR"\n";
		target->start_busy(ap / 45 + 2);
	} else
	{
		msg += CYN "可是$p" CYN "看破了$P" CYN "的身法，并没"
		       "有受到任何影响。"NOR"\n";
		me->start_busy(1);
	}
	message_combatd(msg, me, target);

	return 1;
}

string query_txt()
{
	return @DESC
招式简介：
“鬼魅身法”是辟邪剑法配套的一种高级闪避技巧，施术者能在战斗中以难以捉摸的方式移动，使对手难以预测其行动轨迹。此招式要求施术者具备高深的辟邪剑法修为。

施展条件：

施术者辟邪剑法的基本技能等级至少为100级。
施术者当前真气（内力）无需额外消耗，但必须处于战斗状态。
目标必须是活着的，并且正在与施术者交战。
施展流程：
施术者身形忽进忽退，以诡异的身法在对手身边飘忽不定，试图让对手陷入被动防守的状态。

命中判定：

攻击力（AP）计算：施术者辟邪剑法技能等级的两倍。
防御力（DP）计算：目标的格挡技能等级。
若AP的一半加上随机AP值大于DP，则招式生效。
若招式生效：

目标被迫进入防守状态，无法主动进攻，进入忙乱状态的时间为施术者辟邪剑法技能等级除以45加上2回合。
施术者可以继续利用身法优势进行下一步动作。
若招式未生效：

目标看破施术者的身法，没有受到影响。
施术者进入1回合的忙乱状态，暂时无法再次使用此身法。
DESC;
}
