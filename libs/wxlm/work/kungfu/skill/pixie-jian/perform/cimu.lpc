// cimu.c  辟邪剑法「刺目」



inherit F_SSERVER;
string query_name() { return "葵花"ZJBR"刺目"; }
int perform(object me, object target)
{
	int damage;
	string msg;
	object weapon;
	int lvl;

	if (! target) target = offensive_target(me);

	if (! target || ! me->is_fighting(target))
		return notify_fail("「刺目」只能对战斗中的对手使用。\n");

	if (target->query_temp("block_msg/all"))
		return notify_fail("对方现在什么也看不见，你放心的继续攻击吧！\n");

	if ((int)me->query_skill("pixie-jian", 1) < 80 )
		return notify_fail("你辟邪剑法不够娴熟，使不出「刺目」。\n");

	if ((int)me->query("max_neili")<400)
		return notify_fail("你内力修为不足，无法运足内力。\n");

	if ((int)me->query("neili")<200)
		return notify_fail(HIC"你现在真气不够，没能将「刺目」使完！"NOR"\n");

       if (! living(target))
	      return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "sword")
		msg = HIC "$N" HIC "左手两指并拢，手臂暴长，迅捷异常分刺$n"
		      HIC "双目，"NOR"\n";
	else
		msg = HIC "$N" HIC "手中" + weapon->name() +
		      HIC "一振，剑尖一点暴长，分刺$n"
		      HIC "左右双目，"NOR"\n";
	if (random(me->query_skill("force")) > target->query_skill("force") / 2)
	{
		me->start_busy(2);
		lvl = (int)me->query_skill("pixie-jian", 1);
		damage = lvl + (int)me->query_skill("sword", 1) / 2;
		damage = damage / 2 + random(damage / 2);
		COMBAT_D->real_damage(me, target, damage);
		msg += HIC "$n" HIC "只看到寒尖一点，双目一阵剧痛，眼前一"
		       "黑，就什么也看不见了，顿时长声痛极而呼！"NOR"\n";
		message_combatd(msg, me, target);
		me->add("neili", -damage / 5);
		target->set_temp("block_msg/all", 1);
		call_out("cimu_end", (int) 2 + random(lvl / 25), me, target);
	} else
	{
		me->start_busy(2);
		msg += HIY "$p" HIY "情急智生，抬手也向$P"
		       HIY "的右眼刺去，迫得$P" HIY "回剑跃开。"NOR"\n";
		message_combatd(msg, me, target);
	}
	return 1;
}

void cimu_end(object me, object target)
{
	if (target && living(target) &&
	    target->query_temp("block_msg/all"))
	{
		message_combatd("$N抹了抹流着" HIR "鲜血" NOR
				"，终于能看见了。\n", target);
		target->set_temp("block_msg/all", 0);
		tell_object(target, HIR "你终于抹掉了眼前的鲜"
			    "血，能看见了。"NOR"\n");
	}

	return;
}

string query_txt()
{
	return @DESC
招式简介：
“葵花刺目”是辟邪剑法中的一种独特攻击技巧，其目的在于通过精准的剑尖刺击，使得对手双目暂时失明，从而丧失反击能力。此招式需要施术者具备高超的辟邪剑法技巧以及深厚的内力修为。

施展条件：

施术者辟邪剑法的基本技能等级至少为80级。
施术者内力修为至少为400级。
施术者当前真气（内力）值需达到200点以上。
施术者当前激活的剑法技能必须是辟邪剑法。
目标必须是活着的，并且正在与施术者交战。
施展流程：
施术者运用内力，使得剑尖暴长，迅速刺向对手双目。如果施术者的力量超过目标的一半，招式将生效。

命中判定：

若施术者内力修为的随机数大于目标内力修为的一半，则招式命中。
若招式命中：

施术者消耗相当于伤害值的1/5的真气。
目标双目遭受剧痛，暂时失明，受到内伤。
目标收到的伤害量为施术者辟邪剑法技能等级加上剑法技能等级一半的总和，然后除以2，再加上该数值的随机数部分。
目标处于失明状态，持续时间为2回合加上辟邪剑法技能等级除以25的随机数回合。
若招式未命中：

施术者进入2回合的忙乱状态。
目标成功防御，并迫使施术者回剑跃开。
后续效果：

失明状态结束后，目标能够重新恢复视力。
DESC;
}
