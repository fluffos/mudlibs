// pi.c 群邪辟易



inherit F_SSERVER;

string query_name() { return "群邪辟易"; }

int perform(object me, object target)
{
	string msg;
	object weapon;
	int i;
	int skill;
	int count;
	int isGhost;

	if (! target)
	{
		me->clean_up_enemy();
		target = me->select_opponent();
	}

	if (! me->is_fighting(target))
		return notify_fail("「群邪辟易」只能对战斗中的对手使用。\n");

	skill = me->query_skill("pixie-jian", 1);

	if (skill < 120)
		return notify_fail("你的辟邪剑法修为有限，现在不能使用「群邪辟易」！\n");

	if (me->query("neili") < 100)
		return notify_fail("你的真气不够，无法运用「群邪辟易」！\n");

	weapon = me->query_temp("weapon");

	if (weapon && weapon->query("skill_type") != "sword" &&
	    weapon->query("skill_type") != "pin")
		return notify_fail("你不能使用这种兵器施展「群邪辟易」！\n");

	if (! weapon &&
	    sizeof(me->query_skill_prepare()) &&
	    me->query_skill_prepared("unarmed") != "pixie-jian")
		return notify_fail("你没有准备使用辟邪剑法，不能施展「群邪辟易」！\n");

       if (! living(target))
	      return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

	if (weapon)
	{
		msg = HIR "$N" HIR "身形忽然变快，蓦的冲向$n"
		      HIR "，手中的" + weapon->name() + HIR "指指点点，如同"
		      HIR "寒夜晨星一般，点点光芒刺向$p" HIR "。"NOR"\n";
	} else
	{
		msg = HIR "$N" HIR "忽然冲向$n" HIR "，身法快得"
		      HIR "不可思议，几近鬼魅，伸手就是数掌拍向$n" HIR "！"NOR"\n";
	}

	message_combatd(msg, me, target);
	count = skill / 8;
	isGhost = me->query("special_skill/ghost");

	if (isGhost && random(2))
		count *= 4;

	me->add_temp("apply/attack", count);

	for (i = 0; i < COMBAT_D->query_base_attack_number(me,query_name()); i++)
	{
		if (! me->is_fighting(target))
			break;
		if ((random(3) == 0 || (isGhost && random(2))) && ! target->is_busy())
			target->start_busy(1);
		COMBAT_D->do_attack(me, target, weapon, 0);
	}

	if (me->query("special_skill/ghost") && random(2))
		me->start_busy(1 + random(4));
	else
		me->start_busy(1 + random(7));

	me->add_temp("apply/attack", -count);

	return 1;
}

string query_txt()
{
	return @DESC
招式简介：
「群邪辟易」是辟邪剑法中的一门群体攻击技能，以高速连续攻击敌人，令其难以招架。施展此招需要施术者具备一定的辟邪剑法修为及充足的内力。

施展条件：
施术者辟邪剑法的基本技能等级至少为120级。
施术者当前真气（内力）值需达到100点以上。
施术者当前激活的剑法技能必须是辟邪剑法。
目标必须是活着的，并且正在与施术者交战。
如果施术者持有武器，该武器必须为剑类或暗器类。
如果施术者空手，必须已经准备使用辟邪剑法。
施展流程：
施术者加速接近目标，手持剑类或暗器类武器时，以快速连续的点刺攻击目标；空手时，则以急速掌法拍向目标。
施术者根据自身辟邪剑法的技能等级增加命中，如果拥有特殊技能「阴身」，50%概率在该命中加成上加4倍。
施术者连续进行7次攻击，每次攻击都有机会使目标陷入忙乱状态。
施术完成后，施术者根据是否拥有「阴身」特殊技能及其随机判定，进入忙乱状态，持续时间1至4回合或1至7回合不等。
施术者移除临时增加的攻击力。
效果：
目标可能因连续的攻击陷入忙乱状态，导致其无法做出有效反击。
施术者在施展招式期间消耗大量内力。
施术者在招式结束后进入忙乱状态，持续时间取决于是否有「阴身」特殊天赋，如果有50%概率只进入1-4秒忙乱，否则进入1-7点忙乱。
DESC;
}

