// xiyang-neigong 西洋内功

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int query_neili_improve(object me)
{
	int lvl;

	lvl = (int)me->query_skill("xiyang-shengong", 1);
	return lvl * lvl * 15 * 4 / 100 / 200;
}

int valid_learn(object me)
{
	if ((int)me->query_skill("force", 1) < 40)
		return notify_fail("你的基本内功火候还不够，还不能学习西洋内功。\n");

	return ::valid_learn(me);
}

int practice_skill(object me)
{
	return notify_fail("西洋内功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"xiyang-neigong/" + func;
}

string query_description()
{
    string msg;

    msg = HIY "【西洋内功】" ZJBR NOR; // 基本介绍
    msg += WHT "源自西方的一种内功心法。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  基本内功等级不低于 " HIY "40" NOR " 级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  内功（force）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  西洋内功无法练习，只能通过学习(learn)提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // query_neili_improve
    msg += "  提升内力上限：效果受 " HIY "xiyang-shengong" NOR " 等级影响。" ZJBR ZJBR; // 注意：代码中使用的是 xiyang-shengong

    msg += HIY "〖特殊招式〗" ZJBR NOR; // exert_function_file
    msg += HIC "  西洋战气 (powerup)" ZJBR NOR; // powerup.c
    msg += "    使用要求：" ZJBR;
    msg += "      内功有效激发等级不低于 " HIY "50" NOR " 级。" ZJBR;
    msg += "      当前 " HIB "neili" NOR " 不低于 " HIB "100" NOR " 点。" ZJBR; // neili 查询失败，保留英文
    msg += "      未处于力场效果下。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升临时攻击力，数值为 内功有效激发等级 / 3。" ZJBR;
    msg += "      提升临时防御力，数值为 内功有效激发等级 / 3。" ZJBR;
    msg += "      状态持续时间：内功有效激发等级 / 2 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗 " HIB "neili " HIB "90" NOR " 点。" ZJBR; // neili 查询失败，保留英文
    msg += "      自身忙乱 " HIR "1" NOR " 秒。" ZJBR;

    return msg;
}