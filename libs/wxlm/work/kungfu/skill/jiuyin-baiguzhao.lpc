int valid_enable(string usage) { return usage == "claw" || usage == "parry"; }

int valid_combine(string combo) { return combo == "cuixin-zhang"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练玄阴炼骨爪必须空手。\n");

	if ((int)me->query("max_neili") < 800)
		return notify_fail("你的内力太弱，无法练玄阴炼骨爪。\n");

	if ((int)me->query_str() < 30)
		return notify_fail("你现在膂力孱弱，还无法练玄阴炼骨爪。\n");

	if ((int)me->query_skill("force") < 90)
		return notify_fail("你的内功太差，无法练玄阴炼骨爪。\n");

	if ((int)me->query_skill("claw", 1) < 60)
		return notify_fail("你的基本爪法太差，无法领会玄阴炼骨爪。\n");

	if ((int)me->query_skill("claw", 1) < (int)me->query_skill("jiuyin-baiguzhao", 1))
		return notify_fail("你的基本爪法火候不够，无法领会更高深的玄阴炼骨爪。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action); i > 0; i--)
		if (level >= action[i - 1]["lvl"])
			return action[i - 1]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("jiuyin-baiguzhao",1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i - 1]["lvl"])
			return action[NewRandom(i, 5, level / 5)];
}

int practice_skill(object me)
{
 
	object *obs;
 int  skill;

	skill = me->query_skill("jiuyin-baiguzhao", 1);
	if ((int)me->query("qi") < 100)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 500)
		return notify_fail("你的内力不够练玄阴炼骨爪。\n");

	if (skill < 200)
	{
		obs = filter_array(all_inventory(environment(me)),
				   (: (base_name($1) == CORPSE_OB &&
				       ! $1->query("been_cut/head") ||
				       base_name($1) == "/clone/misc/head") &&
				      ! $1->query_temp("clawed_by_jiuyin") :));
		if (sizeof(obs) < 1)
			return notify_fail("练九阴白骨抓需有尸体或是完好的头盖骨。\n");

		me->add("neili", -450);
	}

	me->receive_damage("qi", 80);
	me->add("neili", -40);
	if (skill < 200)
	{
		message_vision(HIB "只见$N" HIB "左手上圈下钩、左旋右转，连变了"
			       "七八般花样，蓦地里右手一伸，噗的一响，五根手指直"
			       "插入\n头骨的脑门。随后五根手指" HIR "血淋淋"
			       HIB "的提将起来。"NOR"\n", me);

		if (base_name(obs[0]) == "/clone/misc/head")
			obs[0]->set("long", obs[0]->query("long") +
				    "上面赫然有五个小洞，伸手一探，刚好可以插入。\n");

		obs[0]->set_temp("clawed_by_jiuyin", 1);
		me->improve_skill("jiuyin-baiguzhao", 100 + skill * 5 + random(500));
	}

	return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	if (damage_bonus < 100) return 0;

	if (damage_bonus / 5 > victim->query_str())
	{
		victim->receive_wound("qi", (damage_bonus - 100) / 2);
		return HIR "你听到「咔嚓」一声脆响，竟像是骨骼碎裂的声音！"NOR"\n";
	}
}

string perform_action_file(string action)
{
	return __DIR__"jiuyin-baiguzhao/" + action;
}

string query_description()
{
    string msg;

    msg = HIC "【九阴白骨爪】" NOR ZJBR ZJBR;
    msg += WHT "此爪法源自《九阴真经》下卷，后被梅超风、陈玄风错解，练成至阴至毒、狠辣无比的邪功，又名「玄阴炼骨爪」。其爪法刁钻诡异，专攻敌人要害，威力惊人。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力不低于 " HIB "800" NOR " 点。" ZJBR;
    msg += "  后天膂力不低于 " HIY "30" NOR " 点。" ZJBR;
    msg += "  基本内功等级不低于 " HIY "90" NOR " 级。" ZJBR;
    msg += "  基本爪法等级不低于 " HIY "60" NOR " 级。" ZJBR;
    msg += "  基本爪法等级需大于等于九阴白骨爪等级。" ZJBR;
    msg += "  必须空手状态。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  爪法（claw）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖特殊配合〗" ZJBR NOR;
    msg += "  可与「催心掌」配合使用。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血不低于 " HIR "100" NOR " 点。" ZJBR;
    msg += "  内力不低于 " HIB "500" NOR " 点。" ZJBR;
    msg += "  " HIR "特殊练习" NOR "：九阴白骨爪等级低于 " HIY "200" NOR " 级时，必须寻找" HIW "尸体" NOR "或完好的" HIW "头盖骨" NOR "进行练习（每次练习需消耗额外内力 " HIB "450" NOR " 点，并在尸体/头骨上留下爪印），此法可大幅提升技能熟练度。" ZJBR;
    msg += "  普通练习：每次消耗气血 " HIR "80" NOR " 点，内力 " HIB "40" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  " HIR "碎骨" NOR "：" ZJBR;
    msg += "    触发条件：" ZJBR;
    msg += "      普通攻击伤害增益（damage_bonus）不低于 " HIY "100" NOR " 点。" ZJBR;
    msg += "      (伤害增益 / 5) > 目标后天膂力。" ZJBR;
    msg += "    效果：对目标造成额外气血伤害，伤害值约为 (伤害增益 - 100) / 2，并伴有骨骼碎裂的音效提示。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (Perform)〗" ZJBR NOR;
    msg += HIC "  九阴神抓 (zhua)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      九阴白骨爪等级不低于 " HIY "80" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "      激发爪法为九阴白骨爪。" ZJBR;
    msg += "      空手状态。" ZJBR;
    msg += "      必须在战斗中对敌人使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对单一目标发动一次威力巨大的爪击，直取头顶。" ZJBR;
    msg += "      命中判定：((自身爪法激发等级 * 2) / 2 + 随机((自身爪法激发等级 * 2) * 2 / 3)) > 目标轻功激发等级。" ZJBR;
    msg += "      伤害计算：" ZJBR;
    msg += "        - " HIR "致命一击" NOR "：若自身最大内力 > 目标最大内力 * 2，且自身内功激发等级 > 目标内功激发等级 * 3 / 2，造成极高伤害 (爪法激发等级 * 2 * 5 + 内功激发等级)，威力系数 " HIY "120%" NOR "，可能直接击杀对手。" ZJBR;
    msg += "        - 普通伤害：否则，造成伤害 (爪法激发等级 * 2 + 内功激发等级)，伤害值在 1/2 到全额之间随机浮动，威力系数 " HIY "66%" NOR "。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      基础消耗：内力 " HIB "20" NOR " 点。" ZJBR;
    msg += "      命中消耗：额外内力 " HIB "180" NOR " 点 (若触发致命一击)，或随机计算伤害后消耗（普通伤害）。" ZJBR;
    msg += "      自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      强制与目标进入厮杀状态。" ZJBR ZJBR;

    msg += HIC "  夺命连环 (duo)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      九阴白骨爪等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "      激发爪法为九阴白骨爪。" ZJBR;
    msg += "      空手状态。" ZJBR;
    msg += "      必须在战斗中对敌人使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对单一目标发动快速连环爪击。" ZJBR;
    msg += "      首次攻击命中判定：由 `通用命中公式` 决定（比较自身爪法激发等级 与 目标招架激发等级 + 武学修养等级）。" ZJBR;
    msg += "      若首次未命中，会追加一次攻击，命中判定：由 `通用命中公式` 决定（比较自身爪法激发等级 与 目标轻功激发等级 + 武学修养等级）。" ZJBR;
    msg += "      伤害计算（每次命中）：(自身爪法激发等级 + 自身内功激发等级) / 3 + 随机(自身爪法激发等级 / 3)，威力系数 " HIY "55%" NOR "。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      基础消耗：内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      若首次攻击未命中且追加攻击也未命中，额外消耗内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "      自身忙乱：首次命中 " HIR "2" NOR " 秒；首次未命中 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 九阴白骨爪练习方法特殊，低等级时需利用尸体或头骨辅助修炼。" ZJBR;
    msg += "2. 「九阴神抓」在特定条件下拥有秒杀对手的潜力，威力极强。" ZJBR;
    msg += "3. 「夺命连环」的攻击逻辑包含追加攻击判定。" ZJBR;
    msg += "4. 所有特殊招式都需要空手施展，且只能在战斗中使用。\n";

    return msg;
}