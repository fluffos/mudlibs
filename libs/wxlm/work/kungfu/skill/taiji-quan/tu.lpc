// tu.c 太极图

inherit F_SSERVER;

//函数定义
int calculate_damage(object me, object target, string type);
void apply_aoyi_damage(object me, object target, int j, string aoyi, string type);
string query_name() { return "太极图"; }

int perform(object me)
{
    object *obs;
    string msg;
    int damage;
    int flag = 0;
    int i, j, z;
    object weapon, weapon2;

    if (userp(me) && me->query("can_perform/taiji-quan/tu") < 10)
        return notify_fail("你还不会运用「太极图」。\n");

    if (environment(me)->query("no_fight"))
        return notify_fail("这里不能打架。\n");

    me->clean_up_enemy();
    if (! me->is_fighting())
        return notify_fail("「太极图」只能对战斗中的对手使用。\n");

    if (me->query_skill("taiji-quan", 1) < 150)
        return notify_fail("你的太极拳不够娴熟，不会使用「太极图」。\n");

    if (me->query_skill("taiji-shengong", 1) < 150)
        return notify_fail("你的太极神功修为还不够高，难以运用「太极图」。\n");

    if (me->query_skill("taoism", 1) < 150)
        return notify_fail("你的道学心法修为还不够高，难以运用「太极图」。\n");

    if (me->query("jingli") < 500)
        return notify_fail("你现在精力不够，无法使用「太极图」。\n");


    if (me->query("neili", 1) < 1000)
        return notify_fail("你现在真气不够，无法使用「太极图」。\n");

    if (objectp(weapon = me->query_temp("weapon")) || objectp(weapon2 = me->query_temp("weapon2")))
    {
        if (me->query_skill_mapped("sword") != "taiji-jian")
            return notify_fail("使用拳剑如意的方式必须要激发剑法为太极剑。\n");

        if (me->query_skill("taiji-quan", 1) != me->query_skill("taiji-jian", 1))
            return notify_fail("使用拳剑如意的方式必须要太极拳和太极剑的等级相同。\n");

        if (me->query_skill("baoshouyinyang") < 100)
            return notify_fail("你的抱守阴阳内功还没有达到100级。\n");
    }

    msg = HIM "$N" HIM "淡然一笑，双手轻轻划了数个圈子，顿时四周的气流波动，源源不断的被牵引进来。" NOR "\n";
    message_combatd(msg, me);
    me->add("neili", -1000);
    me->add("jing", -500);
    me->start_busy(5);

    obs = me->query_enemy();

    for (i = 0; i < sizeof(obs); i++)
    {
        j = COMBAT_D->get_skill_aoyi_level(me, "无极道心");

        if (COMBAT_D->hit_determination(me,obs[i],me->query_skill("unarmed"),obs[i]->query_skill("parry")))
        {
            switch (random(3))
            {
            case 0:
                tell_object(obs[i], HIY "恍惚之间你似乎回到了过去的世界，竟然再无法控制自我，忽然眼前的一切又全然不见，你心头一乱，浑身一阵剧痛，内力紊乱难以控制！" NOR "\n");
                break;
            case 1:
                tell_object(obs[i], HIW "你眼前一切渐渐的模糊起来，好像是到了仙境，然而你却觉得内息越来越乱，四肢一阵酸痛，几乎要站立不住。" NOR "\n");
                break;
            default:
                tell_object(obs[i], HIR "你耳边忽然响起一个霹雳，眼见雷神挥舞电锤向你打来，你不禁大吃一惊，浑身上下都不听使唤，只有高声呼救。" NOR "\n");
                break;
            }

            damage = calculate_damage(me, obs[i], "qi");


            obs[i]->receive_damage("qi", damage, me);
            obs[i]->receive_wound("qi", damage / 2, me);
            tell_object(me, "你对" + obs[i]->name() + "施展了太极图，结果" + obs[i]->name() + "受到了" + damage + "点气血损伤！\n");

            damage = calculate_damage(me, obs[i], "jing");

            obs[i]->receive_damage("jing", damage, me);
            obs[i]->receive_wound("jing", damage / 3, me);
            tell_object(me, "你对" + obs[i]->name() + "施展了太极图，结果" + obs[i]->name() + "受到了" + damage + "点精神损伤！\n");

            if (j > 0)
                apply_aoyi_damage(me, obs[i], j, "挤字诀", "qi");

            if (j > 2)
                apply_aoyi_damage(me, obs[i], j, "缠字诀", "jing");

            if (j > 4)
                apply_aoyi_damage(me, obs[i], j, "定字诀", "jing");

            if (j > 6)
                apply_aoyi_damage(me, obs[i], j, "狂字诀", "jing");

            if (j > 8)
                apply_aoyi_damage(me, obs[i], j, "天字诀", "jing");

            switch (random(3))
            {
            case 0:
                msg = HIM "只见" + obs[i]->name() + HIM "手舞足蹈，忘乎所以，忽然大叫一声，吐血不止！" NOR "\n";
                break;
            case 1:
                msg = HIR "却见" + obs[i]->name() + HIR "容貌哀戚，似乎想起了什么伤心之事，身子一晃，呕出数口鲜血！" NOR "\n";
                break;
            default:
                msg = HIW + obs[i]->name() + HIW "呆立当场，一动不动，有如中邪，七窍都迸出鲜血来。" NOR "\n";
                break;
            }
            if (!obs[i]->is_busy())
            {
                obs[i]->start_busy(2);
            }
            message("vision", msg, environment(me), ({ obs[i] }));
            // obs[i]->add("neili", -500);
            flag = 1;
        }
        else
        {
            tell_object(obs[i], HIG "你发现眼前的景物似幻似真，连忙默运内功，不受困扰。" NOR "\n");
            obs[i]->add("neili", -200);
        }

        if (obs[i]->query("neili") < 0)
            obs[i]->set("neili", 0);

        j = random(j) + 1;
        for (z = 0; z < j; z++)
        {
            if (! me->is_fighting(obs[i]))
                break;
            COMBAT_D->do_attack(me, obs[i], weapon, 0);
        }
    }

    if (! flag)
        message_vision(HIM "然而没有任何人受了$N" HIM "的影响。" NOR "\n", me, 0, obs);

    return 1;
}

int calculate_damage(object me, object target, string type)
{
    int damage = me->query("max_" + type);
    if (type == "qi" && damage > 10000)
        damage = 10000 + (damage - 10000) / 2;
    else if (type == "jing" && damage > 3000)
        damage = 3000 + (damage - 3000) / 2;
	if (type == "qi")
		damage = damage * (15 + random(6)) / 100;
	else
	damage = damage * (18 + random(6)) / 100;


    damage -= target->query_temp("apply/armor") / 5;

    if (damage < 0)
        damage = 1;

    return damage;
}

void apply_aoyi_damage(object me, object target, int j, string aoyi, string type)
{
	int damage = (me->query_str() - me->query("str")) * 15;
    damage = damage / 2 + random(damage);
    if (damage > 1000)
    {
		int add_damage;
		int jiali;

        damage = damage / 2 + 600;
        add_damage += (me->query("max_jing") - 20000) / 100 * j * 15 / 10;

		if (add_damage > 0)
		damage += add_damage;

		jiali = me->query("jiali");

		if (me->query("neili") < jiali)
			jiali = me->query("neili");

		damage += jiali;
		// me->add("neili",jiali);
    }

    damage -= target->query_temp("apply/armor") / 5;

    if (damage < 0)
        damage = 1;

    target->receive_damage(type, damage, me);
    target->receive_wound(type, damage / 2, me);
    tell_object(me, "你对" + target->name() + "施展了太极图【" + aoyi + "】，结果" + target->name() + "受到了" + damage + "点" + (type == "qi" ? "气血" : "精神") + "损伤！\n");
}