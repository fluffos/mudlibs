int valid_enable(string usage) { return usage == "club" || usage == "parry"; }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 250)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("force") < 50)
		return notify_fail("你的内功火候太浅。\n");

	if ((int)me->query_skill("club", 1) < (int)me->query_skill("zui-gun", 1))
		return notify_fail("你的基本棍法水平有限，无法领会更高深的醉棍。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action) - 1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("zui-gun", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "club")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 65)
		return notify_fail("你的体力不够练少林醉棍。\n");

	if ((int)me->query("neili") < 65)
		return notify_fail("你的内力不够练少林醉棍。\n");

	me->receive_damage("qi", 58);
	me->add("neili", -54);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"zui-gun/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【少林醉棍】" ZJBR NOR;
    msg += WHT "少林派独门棍法，模仿八仙醉态，共有八式，招式奇特，令人防不胜防。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力 不低于 " HIB "250" NOR " 点。" ZJBR;
    msg += "  有效内功 等级不低于 " HIY "50" NOR " 级。" ZJBR;
    msg += "  基本棍法 等级不低于 基本醉棍 等级。" ZJBR;
    msg += "  (需为少林弟子 - 由继承文件限定)" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  棍法 (club)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  须装备棍类武器。" ZJBR;
    msg += "  当前气血 不低于 " HIR "65" NOR " 点。" ZJBR;
    msg += "  当前内力 不低于 " HIB "65" NOR " 点。" ZJBR;
    msg += "  每次练习消耗 气血 " HIR "58" NOR " 点，消耗 内力 " HIB "54" NOR " 点。" ZJBR ZJBR;

    // msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // 无明显被动

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  八仙醉打 (zuida)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      醉棍 已激发为棍法。" ZJBR;
    msg += "      当前内力 不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "      基本醉棍 等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "      有效内功 等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      必须装备武器。" ZJBR;
    msg += "      必须处于因饮酒获得的微醺或更高状态（获得临时增益）。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      临时提升自身 攻击等级 和 轻功等级，提升值为 (基本醉棍等级 / 3)。" ZJBR;
    msg += "      对目标发动连续八次攻击。" ZJBR;
    msg += "      攻击时的描述会根据自身的 醉意程度 变化。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "2 + 随机(2)" NOR " 秒。" ZJBR;
    msg += "      冷却时间 " HIG "5" NOR " 秒。" ZJBR;

    return msg;
}