// poison.c 基本毒技
// Modified by Java Mar.1998
inherit SKILL;

void create() { seteuid(getuid()); }
string type() { return "poison"; }

int valid_learn(object me)
{
	if (me->query("family/family_name") != "星宿派"
		&& me->query("family/family_name") != "欧阳世家"
		&& me->query("family/family_name") != "关外胡家")
		return notify_fail("只有关外胡家、星宿派、欧阳世家的弟子才能学习该技能。\n");
	
	if (me->query("character") == "光明磊落")
		return notify_fail("你心中暗想：我行事光明磊落，学什么毒技！\n");

	return 1;
}

string query_description()
{
    string msg;

    msg = HIG "【基本毒技】" ZJBR NOR; // 基本介绍
    msg += "配置和运用各种毒药的基础技能。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  必须是 星宿派 或 欧阳世家 或 关外胡家 弟子。" ZJBR;
    msg += "  人物性格不能是 光明磊落。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  毒技 (poison)。" ZJBR ZJBR; // 根据 type() 函数

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  无法练习，只能通过学习提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // hit_ob, valid_damage, skill_improved etc.
    msg += "  无直接攻防效果，影响其他用毒相关技能的效果。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform/exert
    msg += "  无。" ZJBR;

    return msg;
}
