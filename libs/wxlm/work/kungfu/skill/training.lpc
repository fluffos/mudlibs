inherit SKILL;

string query_description()
{
    string msg;

    msg = HIY "【基础训练】" ZJBR NOR;
    msg += "基础训练是一项辅助技能，用于训练人物的基本能力。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  无特殊要求，任何人都可以学习。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  此技能不可激发。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  此技能不可练习，只能通过学习提高。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无特殊效果，纯粹是基础训练。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  此技能没有特殊招式。" ZJBR;

    return msg;
}

