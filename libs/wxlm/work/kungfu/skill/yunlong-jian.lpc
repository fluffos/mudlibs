int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 900)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("force") < 100)
		return notify_fail("你的内功火候太浅。\n");

	if ((int)me->query_skill("sword", 1) < 100)
		return notify_fail("你的基本剑法火候太浅。\n");

	if ((int)me->query_skill("sword", 1) < (int)me->query_skill("yunlong-jian", 1))
		return notify_fail("你的基本剑法水平有限，无法领会更高深的云龙剑法。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level   = (int) me->query_skill("yunlong-jian",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力不够练云龙剑法。\n");

	if ((int)me->query("neili") < 80)
		return notify_fail("你的内力不够练云龙剑法。\n");

	me->receive_damage("qi", 55);
	me->add("neili", -67);
	return 1;
}
string perform_action_file(string action)
{
	return __DIR__"yunlong-jian/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【云龙剑法】" ZJBR NOR;
    msg += WHT "云龙剑法是一门以灵动飘逸著称的高级剑法，招式变化多端，" ZJBR;
    msg += WHT "剑光如龙，迅猛而又灵活，令人防不胜防。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力 (" HIW "max_neili" NOR ") 不低于 " HIC "900" NOR " 点。" ZJBR;
    msg += "  内功有效激发 (" HIW "force" NOR ") 等级不低于 " HIC "100" NOR " 级。" ZJBR;
    msg += "  基本剑法 (" HIW "sword" NOR ") 等级不低于 " HIC "100" NOR " 级。" ZJBR;
    msg += "  基本剑法等级须不低于云龙剑法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  剑法 (sword)" ZJBR;
    msg += "  招架 (parry)" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  需装备剑类武器。" ZJBR;
    msg += "  每次练习消耗气血 " HIR "55" NOR " 点，消耗内力 " HIR "67" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  云龙三现 (xian)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      云龙剑 等级不低于 " HIC "50" NOR " 级。" ZJBR;
    msg += "      内功有效激发 等级不低于 " HIC "120" NOR " 级。" ZJBR;
    msg += "      当前内力 不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      攻击力：(内功有效激发 / 2 + 随机(内功有效激发 / 2))" ZJBR;
    msg += "      防御力：(目标内功有效激发 / 2)" ZJBR;
    msg += "      命中判定：随机(攻击力) > 防御力" ZJBR;
    msg += "      伤害值：(攻击力 + 随机(攻击力))" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "180" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "2" NOR " 秒。" ZJBR;

    return msg;
}