// club.c

inherit SKILL;

string query_description()
{
    string msg;

    msg = HIY "【基本棍法】" ZJBR NOR;
    msg += "所有棍类武功的基础，提升棍法的伤害和命中率。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn (默认)
    msg += "  无特殊要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable (默认)
    msg += "  棍法（club）。" ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill (默认基础技能)
    msg += "  参照各门派内功或江湖内功的练习要求。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // hit_ob, valid_damage, skill_improved etc.
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform/exert
    msg += "  无。" ZJBR;

    return msg;
}
