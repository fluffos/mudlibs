// yufeng-zhen.c 玉蜂针



inherit SKILL;

int valid_enable(string usage) { return usage == "throwing"; }

int valid_learn(object me)
{
	if ((int)me->query_skill("force") < 60)
		return notify_fail("你的内功心法火候不够，无法学玉蜂针。\n");

	if ((int)me->query_skill("dodge") < 80)
		return notify_fail("你的轻功火候不够，无法领悟玉蜂针。\n");

	if ((int)me->query_dex() < 26)
		return notify_fail("你的身法不够灵巧，无法领悟玉蜂针。\n");

	if ((int)me->query_skill("throwing", 1) < (int)me->query_skill("mantian-xing", 1))
		return notify_fail("你的基本暗器水平有限，难以领会更高深的玉蜂针。\n");

	return 1;
}

int practice_skill(object me)
{
 

	if ((int)me->query("qi") < 60)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 60)
		return notify_fail("你的内力不够练玉蜂针。\n");

	me->receive_damage("qi", 52);
	me->add("neili", -35);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"yufeng-zhen/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【玉蜂针】" ZJBR NOR;
    msg += WHT "古墓派独门暗器手法，以特制的玉蜂针为武器，发射时迅疾如风，细微难辨。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  有效内功 等级：" HIY "60" NOR " 级。" ZJBR;
    msg += "  有效轻功 等级：" HIY "80" NOR " 级。" ZJBR;
    msg += "  先天身法 属性：" HIY "26" NOR " 点。" ZJBR;
    msg += "  基本暗器 等级：" HIY "不低于" NOR " 基本漫天星雨 等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  暗器 (throwing)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  需要当前 气血 " HIC "60" NOR " 点以上，当前 内力 " HIB "60" NOR " 点以上。" ZJBR;
    msg += "  消耗 气血：" HIR "52" NOR " 点。" ZJBR;
    msg += "  消耗 内力：" HIB "35" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  无影针 (wuying)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      装备了 玉蜂针 (yufeng zhen)。" ZJBR;
    msg += "      基本玉蜂针 等级：" HIY "100" NOR " 级。" ZJBR;
    msg += "      当前 内力 不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      快速投掷多枚玉蜂针攻击敌人。" ZJBR;
    msg += "      命中判定：随机(自身有效暗器等级) > 目标有效轻功等级。" ZJBR;
    msg += "      基础伤害：(自身有效暗器等级 + 随机(自身有效暗器等级 / 2)) 点。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗 内力 " HIB "80" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "2" NOR " 秒。" ZJBR;

    return msg;
}