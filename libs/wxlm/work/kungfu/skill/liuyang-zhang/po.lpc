// This program is a part of NITAN MudLIB


#include <combat.h>

string name() { return HIR "破神诀" NOR; }
string query_name() { return "破神决"; }
string *pfm_type() { return ({ "strike", }); }
inherit F_SSERVER;

int perform(object me, object target)
{
        int damage;
        string msg;
        int ap, dp,aoyi;
        int aoyi_level;

        if (! target)
        {
                me->clean_up_enemy();
                target = me->select_opponent();
        }
        if (! target || ! me->is_fighting(target))
                return notify_fail(name() + "只能对战斗中的对手使用。\n");

        if( query_temp("weapon", me) || query_temp("secondary_weapon", me) )
                return notify_fail(name() + "只能空手施展。\n");

        if ((int)me->query_skill("bahuang-gong", 1) < 220
                && (int)me->query_skill("beiming-shengong", 1) < 220)
                return notify_fail("你的本门火候不够，难以施展" + name() + "。\n");

        if ((int)me->query_skill("liuyang-zhang", 1) < 220)
                return notify_fail("你的天山六阳掌不够娴熟，难以施展" + name() + "。\n");

        if( query("max_neili", me)<3500 )
                return notify_fail("你的内力修为不足，难以施展" + name() + "。\n");

        // if ( me->query_skill_mapped("force") != "beiming-shengong")
                // return notify_fail("你没有激发本门内功，难以施展" + name() + "。\n");

        if( query("neili", me)<800 )
                return notify_fail("你现在真气不足，难以施展" + name() + "。\n");

        if (! living(target))
                return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

        // 获取意境等级
        aoyi_level = COMBAT_D->get_skill_aoyi_level(me, "灵鹫飞羽");

        msg = HIR "$N" HIR "将内功提运至极限，全身真气迸发，呼的一掌"
              "向$n" HIR "头顶猛然贯落。\n" NOR;

        addn("neili", -500, me);
        ap = attack_power(me, "strike") + me->query_skill("force") + (aoyi_level * 5);
        dp = defense_power(target, "parry") + target->query_skill("force");

        if (target->is_good()) ap += ap / 10;

        //pve命中x1.5
        if (!playerp(target))
        {
                ap = ap * 3 /2;
        }

        if (COMBAT_D->hit_determination(me,target,ap,dp))
        {
                damage = 0;
                if( !playerp(target) && query("max_neili", me)>query("max_neili", target)*2 )
                {
                        msg += HIR "顿时只听“噗”的一声，$N" HIR "一掌将$n"
                               HIR "头骨拍得粉碎，脑浆四溅，当即瘫了下去。\n"
                               NOR "( $n" RED "受伤过重，已经有如风中残烛，"
                               "随时都可能断气。" NOR ")\n";
                        damage = -1;
                } else
                {
                        damage = damage_power(me, "strike") / 2;
                        damage += me->query("jiali");

                        if (aoyi_level)
                        {
                                damage += damage_power(me, "strike") / 6 * aoyi_level;
                                msg += HIY "$N" HIY "身形如灵鹫展翅，掌势迅猛无比，一股凌厉的气劲如同飞羽般穿透空气，直袭$n" HIY "要害！\n" NOR;
                        }
                        // 获取 自由自在aoyi 意境 
                        aoyi = me->query("skill/aoyi/自由自在", 1);
                        // 如果有 自由自在aoyi 意境 伤害 增加
                        if (aoyi > 0)
                        {
                               // 伤害增加 随机得  aoyi等级 * 伤害得百分之10
                               damage += damage / 20 * aoyi;
                               
                        }
                        msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 85,
                                                   HIR "$n" HIR "慌忙抵挡，可已然不及，$N"
                                                   HIR "掌劲如洪水般涌入体内，接连震断数根"
                                                   "肋骨。\n:内伤@?");
                }
                me->start_busy(2);
        } else
        {
                msg += CYN "$p" CYN "见$P" CYN "掌劲澎湃，决计抵挡不"
                       "住，当即身子向后横丈许，躲闪开来。\n" NOR;
                me->start_busy(3);
        }
        message_combatd(msg, me, target);

        if (damage < 0)
                target->die(me);

        return 1;
}
