int valid_enable(string usage) { return usage=="unarmed" ||  usage=="parry"; } 

int valid_combine(string combo) { return combo=="xiaoyaoyou"; }

int valid_learn(object me)
{
    	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("学习绝命腿必须空手。\n");

    	if ((int)me->query_skill("force") < 80)
		return notify_fail("你的内功火候不够，无法学绝命腿。\n");

    	if ((int)me->query("max_neili") < 500)
		return notify_fail("你的内力太弱，无法练绝命腿。\n");

	if ((int)me->query_skill("unarmed", 1) < (int)me->query_skill("jueming-tui", 1))
		return notify_fail("你的基本拳脚火候不够，无法领会更高深的绝命腿法。\n");

    	return 1;
}

string query_skill_name(int level)
{
    	int i;
    	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    	int i, level;

    	level = (int)me->query_skill("jueming-tui", 1);
    	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    	if ((int)me->query("qi") < 70)
       		return notify_fail("你的体力太低了。\n");

    	if ((int)me->query("neili") < 70)
       		return notify_fail("你的内力不够练绝命腿。\n");

    	me->receive_damage("qi", 60);
    	me->add("neili", -51);

    	return 1;
}

string perform_action_file(string action)
{
    	return __DIR__"jueming-tui/" + action;
}

string query_description()
{
    string msg;

    msg = HIC "【绝命腿】" NOR ZJBR ZJBR;
    msg += WHT "绝命腿是一门刚猛霸道的腿法，以凌厉的踢技著称，施展时势大力沉，令对手难以招架。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  必须空手状态。" ZJBR;
    msg += "  基本内功 (force) 不低于 " HIY "80" NOR " 级。" ZJBR;
    msg += "  最大内力 (max_neili) 不低于 " HIB "500" NOR " 点。" ZJBR;
    msg += "  基本拳脚 (unarmed) 等级需大于等于绝命腿等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  拳脚 (unarmed)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖武功组合〗" ZJBR NOR;
    msg += "  可与 逍遥游 (xiaoyaoyou) 组合。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血 (qi) 不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力 (neili) 不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "51" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (Perform)〗" ZJBR NOR;
    msg += HIC "  绝命一踢 (jue)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      绝命腿等级不低于 " HIY "80" NOR " 级。" ZJBR;
    msg += "      激发拳脚为绝命腿。" ZJBR;
    msg += "      后天膂力 (me->query_str()) 不低于 " HIY "35" NOR " 点。" ZJBR;
    msg += "      当前内力不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "      必须在战斗中对敌人使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对单个目标发动一次强力踢击。" ZJBR;
    msg += "      命中判定：" ZJBR;
    msg += "        攻击力 (AP) = 自身拳脚激发等级 + 自身后天膂力 * 10。" ZJBR;
    msg += "        招架判定 (DP) = 目标招架激发等级 + 目标后天膂力 * 10。" ZJBR;
    msg += "        躲闪判定 (DP1) = 目标轻功激发等级 + 目标后天身法 * 10。" ZJBR;
    msg += "        招架检定：若 (攻击力 * 70% + 随机(攻击力)) < 招架判定，则被招架。" ZJBR;
    msg += "        躲闪检定：若 (攻击力 * 70% + 随机(攻击力)) < 躲闪判定，则被躲闪。" ZJBR;
    msg += "        若未被招架或躲闪，则命中目标。" ZJBR;
    msg += "      伤害计算（命中时）：" ZJBR;
    msg += "        基础伤害值 = 攻击力 / 3 + 随机(攻击力 / 3)。" ZJBR;
    msg += "        对目标造成气血伤害，伤害量 = 基础伤害值。" ZJBR;
    msg += "        对目标造成气血伤势，伤害量 = 基础伤害值 / 2。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 " HIB "120" NOR " 点 (初始50 + 命中后70)。" ZJBR;
    msg += "      未命中：消耗内力 " HIB "50" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 特殊招式只能在战斗中对敌人使用。" ZJBR;
    msg += "2. 需要空手才能使用特殊招式。" ZJBR;
    msg += "3. 使用特殊招式后会有短暂的忙乱状态。\n";

    return msg;
}