// yueying-wubu.c  月影舞步
inherit SKILL;

string *dodge_msg = ({
	"$n身形一晃，纤腰一扭，一招「星河鹭起」，弹地而起。\n",
	"$n一招「歌尽桃花扇底风」，$N只觉眼前一花，不见了$n的身影。\n",
	"$n一招「扫尽浮云风不定」，身形微晃，有惊无险地避开了$N这一招。\n",
	"只见$n身子向后一翻，一招「缥渺孤鸿影」，后荡而起，掠向一旁。\n" ,
	"$n一招「起舞弄清影」，长袖翻飞，躲过$N这一招。\n",
	"却见$n「万顷江田一鹭飞」，冲天而起，一波三折，端是美观。\n",
	"可是$n一个「流水落花春去也」，侧身一让，$N这一招扑了个空。\n",
	"只见$n一招「月轮穿沼水无痕」，倒掠身形，凌空两个翻转，退出两丈开外。\n",
	"$n息气上升，意存玉枕，一招「月在青天影在波」，身子飘然而起。\n",
	"$n使出一招「" HIC "月迷津渡" NOR "」，身影如水中月影，朦胧不定，避开了$N的攻击。\n",
	"$n身形一转，施展「" HIW "镜花水月" NOR "」，仿佛化作一阵清风，令$N无法捉摸。\n",
});

int valid_enable(string usage) { return (usage == "dodge") || (usage == "move"); }

int valid_learn(object me) { return 1; }

string query_dodge_msg(string limb)
{

	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力太差了，不能练月影舞步。\n");

	me->receive_damage("qi", 40);
	return 1;
}
string query_description()
{
    string msg;

    msg = HIY "【月影舞步】" ZJBR NOR;
    msg += WHT "月影舞步是一门以轻盈飘逸著称的高级身法。" ZJBR;
    msg += "此身法借鉴月光流转之形，招式优雅灵动，变化多端，令人难以捉摸。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  无特殊要求" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  轻功(dodge)" ZJBR;
    msg += "  步法(move)" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血消耗：40点" ZJBR ZJBR;

    msg += HIY "〖招式特点〗" ZJBR NOR;
    msg += "1. 星河鹭起：弹地而起，避开对手攻击" ZJBR;
    msg += "2. 歌尽桃花扇底风：身形闪烁，令人难以捕捉" ZJBR;
    msg += "3. 扫尽浮云风不定：身形微晃，灵活闪避" ZJBR;
    msg += "4. 缥渺孤鸿影：后荡而起，远离险境" ZJBR;
    msg += "5. 起舞弄清影：长袖翻飞，轻盈避让" ZJBR;
    msg += "6. 万顷江田一鹭飞：冲天而起，转折优美" ZJBR;
    msg += "7. 流水落花春去也：侧身让步，巧妙避让" ZJBR;
    msg += "8. 月轮穿沼水无痕：倒掠腾空，退避自如" ZJBR;
    msg += "9. 月在青天影在波：息气上升，飘然腾跃" ZJBR;
    msg += "10. 月迷津渡：如水中月影，朦胧难辨" ZJBR;
    msg += "11. 镜花水月：化为清风，令人难以捉摸" ZJBR ZJBR;

    msg += HIR "〖注意事项〗" ZJBR NOR;
    msg += "1. 月影舞步注重灵活度与速度，修炼时应着重提高身法。" ZJBR;
    msg += "2. 在实战中，应善于利用身法的灵动性，进行快速闪避。" ZJBR;
    msg += "3. 配合其他武功使用，可以发挥出更强的威力。" ZJBR;
    msg += "4. 练习时需要保持足够的气血。\n";

    return msg;
}

