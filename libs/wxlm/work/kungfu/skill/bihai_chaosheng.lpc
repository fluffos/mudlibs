inherit SKILL;

mapping *action = ({
([  "action" : "$N剑势如潮,一招「" HIB "碧海潮生" NOR "」,手中$w化作一道蓝光刺向$n的$l",
    "force" : 180,
    "attack": 60,
    "dodge" : 65,
    "parry" : 55,
    "damage": 80,
    "lvl"   : 0,
    "skill_name" : "碧海潮生",
    "damage_type" : "刺伤"
]),
([  "action" : "$N使出「" HIC "浪涌银滩" NOR "」,身形如浪花翻卷,$w划出一道银光斩向$n",
    "force" : 220,
    "attack": 70,
    "dodge" : 75,
    "parry" : 65,
    "damage": 100,
    "lvl"   : 30,
    "skill_name" : "浪涌银滩",
    "damage_type" : "割伤"
]),
([  "action" : "$N一式「" HIW "沧海横流" NOR "」,$w剑芒暴涨,如怒涛般席卷向$n全身",
    "force" : 260,
    "attack": 80,
    "dodge" : 85,
    "parry" : 75,
    "damage": 120,
    "lvl"   : 60,
    "skill_name" : "沧海横流",
    "damage_type" : "割伤"
]),
([  "action" : "$N轻吟剑诀,一招「" HIG "碧波万顷" NOR "」,$w化作万千剑影,如碧波般向$n涌去",
    "force" : 300,
    "attack": 90,
    "dodge" : 95,
    "parry" : 85,
    "damage": 140,
    "lvl"   : 90,
    "skill_name" : "碧波万顷",
    "damage_type" : "刺伤"
]),
});

int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me)
{
    if ((int)me->query("max_neili") < 600)
        return notify_fail("你的内力不够。\n");

    if ((int)me->query_skill("force") < 80)
        return notify_fail("你的内功火候不够。\n");

    if ((int)me->query_skill("sword", 1) < 50)
        return notify_fail("你的基本剑法火候不够。\n");

    if ((int)me->query_skill("sword", 1) < (int)me->query_skill("bihai_chaosheng", 1))
        return notify_fail("你的基本剑法水平有限，无法领会更高深的碧海潮生剑法。\n");

    return 1;
}

string query_skill_name(int level)
{
    int i;
    for (i = sizeof(action) - 1; i >= 0; i--)
        if (level >= action[i]["lvl"])
            return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    int i, level;
    level = (int) me->query_skill("bihai_chaosheng", 1);
    for (i = sizeof(action); i > 0; i--)
        if (level > action[i-1]["lvl"])
            return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    object weapon;

    if (!objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对。\n");

    if ((int)me->query("qi") < 45)
        return notify_fail("你的体力不够练碧海潮生剑法。\n");

    if ((int)me->query("neili") < 45)
        return notify_fail("你的内力不够练碧海潮生剑法。\n");

    me->receive_damage("qi", 40);
    me->add("neili", -43);
    return 1;
}

string perform_action_file(string action)
{
    return __DIR__"bihai_chaosheng/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
    int lvl;
    lvl = me->query_skill("bihai_chaosheng", 1);

    if (damage_bonus < 70 || lvl < 70) return 0;

    if (random(lvl) > victim->query_skill("force", 1)/2)
    {
        victim->receive_wound("qi", (damage_bonus - 60) / 3);
        return HIB "$N" HIB "碧海潮生剑法的剑气如潮水般涌来，$n" HIB "只觉得胸口一阵冰凉！\n" NOR;
    }
}

string query_description()
{
    string msg;

    msg = "";
    msg += HIY "【碧海潮生剑法】" ZJBR ZJBR NOR;
    msg += WHT "碧海潮生剑法乃是一门以海洋潮汐为意境的剑法，剑势如潮水般绵绵不绝，连绵起伏，令敌人难以抵挡。" ZJBR ZJBR;

    msg += HIY "【学习要求】" ZJBR NOR;
    msg += "  最大内力 600 点" ZJBR;
    msg += "  基本内功等级 80 级" ZJBR;
    msg += "  基本剑法等级 50 级" ZJBR;
    msg += "  碧海潮生剑法等级不能超过基本剑法等级" ZJBR ZJBR;

    msg += HIY "【练习消耗】" ZJBR NOR;
    msg += "  需要装备剑类武器" ZJBR;
    msg += "  每次练习消耗："ZJBR;
    msg += "    - 气血 40 点"ZJBR;
    msg += "    - 内力 43 点"ZJBR ZJBR;

    msg += HIY "【技能效果】" ZJBR NOR;
    msg += "  可激发为剑法（sword）和招架（parry）" ZJBR ZJBR;

    msg += HIY "【被动效果（剑气）】" ZJBR NOR;
    msg += "  触发条件：" ZJBR;
    msg += "    - 碧海潮生剑法等级 70 级以上" ZJBR;
    msg += "    - 本次攻击伤害加成（damage_bonus） >= 70" ZJBR;
    msg += "    - 判定：random(自身碧海潮生剑法等级) > 目标基本内功等级 / 2" ZJBR;
    msg += "  触发效果：" ZJBR;
    msg += "    - 目标受到额外气血伤口（wound）：(伤害加成 - 60) / 3 点" ZJBR ZJBR;

    // 注：perform招式信息需要分析对应目录下的文件，此处暂略
    // msg += HIY "【特殊招式】" ZJBR NOR;
    // msg += HIW "1. [招式名称]（[perform ID]）：" ZJBR NOR;
    // msg += "  要求：..." ZJBR;
    // msg += "  消耗：..." ZJBR;
    // msg += "  效果：..." ZJBR;
    // msg += "  描述：..." ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 此剑法注重连绵不绝的攻势，内力消耗相对平稳。" ZJBR;
    msg += "2. 70级后攻击时有几率触发剑气伤敌效果，等级越高、伤害越高，触发几率越大。" ZJBR;
    msg += "3. 配合高等级内功可以更好地发挥剑法威力。\n";

    return msg;
}