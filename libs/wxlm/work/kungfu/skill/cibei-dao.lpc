int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 100)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("force") < 30)
		return notify_fail("你的内功火候不够。\n");

	if ((int)me->query_skill("blade", 1) < (int)me->query_skill("cibei-dao", 1))
		return notify_fail("你的基本刀法水平有限，无法领会更高深的慈悲刀法。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("cibei-dao",1);
	for(i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "blade")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 60)
		return notify_fail("你的体力不够练慈悲刀。\n");

	if ((int)me->query("neili") < 60)
		return notify_fail("你的内力不够练慈悲刀。\n");

	me->receive_damage("qi", 55);
	me->add("neili", -58);

	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"cibei-dao/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【慈悲刀】" ZJBR NOR;
    msg += "慈悲刀是少林寺的一门刀法绝技，蕴含佛家慈悲之意，却又威力强大。" ZJBR;
    msg += "刀法以平和之姿行杀伐之事，招式看似寻常，实则暗藏 deadly 杀机。" ZJBR;
    msg += "慈悲刀法融合了佛法与武学，既有佛门之庄严慈悲，亦不失武林之杀伐果断。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  · 最大内力： 100点" ZJBR;
    msg += "  · 内功激发等级：30级" ZJBR;
    msg += "  · 基本刀法等级 ≥ 慈悲刀法等级" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  此技能可以用于" YEL "刀法" NOR "(blade) 和 " YEL "招架" NOR "(parry) 两种技能。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  · 气血：≥ 60点" ZJBR;
    msg += "  · 内力：≥ 60点" ZJBR;
    msg += "  · 每次练习消耗：" ZJBR;
    msg += "    - 气血：55点" ZJBR;
    msg += "    - 内力：58点" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIW "1. 舍身喂鹰 (sheshen)：" ZJBR NOR;
    msg += "   * 招式效果：" ZJBR;
    msg += "     - 施展后，自身攻击力 (attack) 提升，提升数值与技能等级相关。" ZJBR;
    msg += "     - 同时，自身闪避能力 (dodge) 降低，降低数值与技能等级相关。" ZJBR;
    msg += "   * 学习要求：" ZJBR;
    msg += "     - 慈悲刀法等级：60级" ZJBR;
    msg += "     - 最大内力：200点" ZJBR;
    msg += "   * 内力消耗：100点" ZJBR;
    msg += "   * 持续时间：慈悲刀法等级 / 4 秒" ZJBR;
    msg += "   * 招式描述：运起全身功力，以舍身之姿，瞬间爆发强大的攻击力，但自身防御有所降低。" ZJBR ZJBR;

    msg += HIR "〖注意事项〗" ZJBR NOR;
    msg += "  · 慈悲刀法需要扎实的基本刀法为基础，练习时应同步提升基本刀法等级。" ZJBR;
    msg += "  · 实战中，需灵活运用慈悲刀法刚柔并济的特点，方能出奇制胜。" ZJBR;
    msg += "  · 施展「舍身喂鹰」时会降低自身防御，请务必谨慎选择时机。\n";

    return msg;
}