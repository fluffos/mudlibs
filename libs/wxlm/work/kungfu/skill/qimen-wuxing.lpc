// qimen-wuxing

inherit SKILL;

void create() { seteuid(getuid()); }

string type() { return "knowledge"; }

int practice_skill(object me)
{	
	return notify_fail("奇门五行只能靠学(learn)来提高。\n");
}
int valid_learn(object me)
{
	if (me->query("family/family_name") != "桃花岛")
		return notify_fail("桃花岛的弟子才能学习该技能。\n");
	return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【奇门五行】" ZJBR NOR;
    msg += WHT "桃花岛独门知识，包含算术、韬略、五行八卦等，是学习桃花岛武学和阵法的基础。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  必须是桃花岛弟子。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // type()
    msg += "  知识类技能 (knowledge)" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  无法通过练习 (practice) 提高，只能通过学习 (learn) 来提升等级。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  作为学习桃花岛其他高深武学或阵法的前置条件。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    return msg;
}