// songshan-xinfa 嵩山心法

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_learn(object me)
{
	return ::valid_learn(me);
}

int practice_skill(object me)
{
	return notify_fail("嵩山心法只能用学(learn)的来增加熟练度。\n");
}

string query_description()
{
    string msg;

    msg = HIY "【嵩山心法】" ZJBR NOR; // 基本介绍
    msg += WHT "嵩山心法是嵩山派的基础内功心法。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  无特殊学习要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  内功 (force)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  嵩山心法只能通过学习 (learn) 来提升熟练度。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // hit_ob, valid_damage, skill_improved etc.
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform/exert
    msg += "  暂无特殊招式。" ZJBR ZJBR;

    return msg;
}

