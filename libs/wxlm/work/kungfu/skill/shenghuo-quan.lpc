int valid_enable(string usage) { return usage == "cuff" ||  usage == "parry"; }

int valid_combine(string combo) { return combo=="guangming-zhang"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
                return notify_fail("练圣火拳必须空手。\n");

        if ((int)me->query_skill("cuff", 1) < 10)
                return notify_fail("你的基本拳法火候不够，无法练圣火拳。\n");


        if ((int)me->query_skill("cuff", 1) < (int)me->query_skill("shenghuo-quan", 1))
                return notify_fail("你的基本拳法水平有限，无法领会更高深的圣火拳。\n");

	return 1;
}

string query_skill_name(int level)
{
        int i;
        for (i = sizeof(action)-1; i >= 0; i--)
                if (level >= action[i-1]["lvl"])
                        return action[i-1]["skill_name"];
}

mapping query_action(object me, object weapon)
{
        int i, level;
        level = (int)me->query_skill("shenghuo-quan", 1);
        for (i = sizeof(action); i > 0; i--)
                if (level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 60)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 70)
                return notify_fail("你的内力不够了。\n");

	me->receive_damage("qi", 20);
	me->add("neili", -30);
	return 1;
}

string perform_action_file(string action)
{
      return __DIR__"shenghuo-quan/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【圣火拳】" ZJBR NOR;
    msg += WHT "圣火拳是明教的基础拳法,以其刚猛有力、气势如虹而闻名。此拳法融合了明教圣火的特性,招式中蕴含炙热内力。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  必须空手。" ZJBR;
    msg += "  基本拳法等级不低于 " HIY "10" NOR " 级。" ZJBR;
    msg += "  基本拳法等级不低于圣火拳等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  拳法 (cuff)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR;
    msg += "  可与 " HIC "光明掌" NOR " 互备。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "60" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "20" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "30" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  圣火焚驱 (shenghuo)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      基本圣火拳 " HIY "60" NOR " 级。" ZJBR;
    msg += "      最大内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      当前内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      必须激发圣火拳为拳法并备圣火拳。" ZJBR;
    msg += "      只能空手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：比较 (自身激发拳法等级 + 激发内功等级 + 后天膂力*10 + 随机(自身判定值/2)) 与 (目标激发轻功等级 + 激发内功等级 + 后天身法*10 + 随机(目标判定值/2)) 的大小。" ZJBR;
    msg += "      命中效果：" ZJBR;
    msg += "        对目标造成气血伤害，伤害值约为 (圣火拳等级 + 随机(圣火拳等级/2))。" ZJBR;
    msg += "        对目标造成气血上限伤害，伤害值约为 随机(气血伤害/2)。" ZJBR;
    msg += "        目标忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中效果：无特殊效果。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "50" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "1-2" NOR " 秒 (随机)。" ZJBR;

    return msg;
}