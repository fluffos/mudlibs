// wudang-jian.c 武当剑法

inherit SKILL;

mapping *action = ({
([      "action" : "$N身体左转，左手剑指，两腿屈膝，右前臂内旋，剑尖前端一寸处短促抖腕发"
		   "力，一招「飞燕入林」，手中$w轻轻颤动，一剑自上而下扎向$n的$l",
	"force"  : 120,
	"dodge"  : 20,
	"damage" : 25,
	"lvl"    : 0,
	"skill_name" : "飞燕入林",
	"damage_type": "刺伤"
]),
([      "action" : "$N身形不动，右前臂外旋，剑刃上崩，立马左腿左弓步，一招「青龙吐水」，手"
		   "中$w向前下反刺，一剑指向$n的$l",
	"force"  : 120,
	"dodge"  : 20,
	"damage" : 20,
	"lvl"    : 10,
	"skill_name" : "青龙吐水",
	"damage_type": "刺伤"
]),
([      "action" : "$N左脚向前一步，蹬地跳起，身体腾空疾速左转，右手$w先向前刺，随转体变"
		   "向，使出一式「凤凰挚窝」，剑光如匹练般泄向$n的$l",
	"force"  : 140,
	"dodge"  : 15,
	"damage" : 25,
	"lvl"    : 20,
	"skill_name" : "凤凰挚窝",
	"damage_type": "刺伤"
]),
([      "action" : "$N碎步急进，提剑沿剑身方向疾速上崩，一招「白蛇吐信」直取$n的$l",
	"force"  : 150,
	"dodge"  : 15,
	"damage" : 35,
	"lvl"    : 30,
	"skill_name" : "白蛇吐信",
	"damage_type": "刺伤"
]),
([      "action" : "$N平剑斜洗，臂圆剑直，双脚交替弧形迈进，右手$w使出一式「玉女穿梭」，"
		   "剑锋往来运转如梭，连绵不绝刺向$n的$l",
	"force"  : 130,
	"dodge"  : 25,
	"damage" : 25,
	"lvl"    : 40,
	"skill_name" : "玉女穿梭",
	"damage_type": "刺伤"
]),
([      "action" : "$N屈腕抬臂，剑由前向后上方抽带，挺起中平剑奋勇向前，右手$w使出一式"
		   "「仙人指路」刺向$n的$l",
	"force"  : 120,
	"dodge"  : 25,
	"damage" : 25,
	"lvl"    : 50,
	"skill_name" : "仙人指路",
	"damage_type": "刺伤"
]),
([      "action" : "$N左撤步，抱剑当胸，挥剑做圆环形，正反搅动，右手$w一式「怀中抱月」，"
		   "剑意圆润，刺向$n的$l",
	"force" : 110,
	"dodge" : 15,
	"lvl"   : 60,
	"skill_name" : "怀中抱月",
	"damage_type": "刺伤"
]),
([      "action" : "$N侧身退步，左手剑指划转，腰部一扭，上体后仰，右手$w一记「反身朝阳」"
		   "自下上撩指向$n的$l",
	"force"  : 150,
	"dodge"  : 35,
	"damage" : 40,
	"lvl"    : 70,
	"skill_name" : "反身朝阳",
	"damage_type": "刺伤"
]),
});


int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 100)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("force") < 20)
		return notify_fail("你的内功火候太浅。\n");

	if ((int)me->query_skill("sword", 1) < (int)me->query_skill("wudang-jian", 1))
		return notify_fail("你的基本剑法水平有限，无法领会更高深的武当剑法。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action) - 1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("wudang-jian", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];

}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 40)
		return notify_fail("你的体力不够练武当剑法。\n");

	if ((int)me->query("neili") < 10)
		return notify_fail("你的内力不够练武当剑法。\n");

	me->receive_damage("qi", 25);
	me->add("neili", -1);

	return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【武当剑法】" ZJBR NOR;
    msg += "武当剑法是武当派的镇派剑法，以轻灵飘逸见长，招式刚柔并济，攻防兼备。剑法中蕴含了武当派太极之道的精髓，讲究以柔克刚、以静制动。" ZJBR ZJBR;
    
    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  内力最大值：不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "  基本内功等级：不低于 " HIY "20" NOR " 级。" ZJBR;
    msg += "  基本剑法等级不能低于武当剑法等级。" ZJBR ZJBR;
    
    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  剑法（sword）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;
    
    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  手持剑类武器。" ZJBR;
    msg += "  气血：不低于 " HIR "40" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "10" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "25" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "1" NOR " 点。" ZJBR ZJBR;
    
    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无特殊被动效果。" ZJBR ZJBR;
    
    msg += HIY "〖招式列表〗" ZJBR NOR;
    msg += "  武当剑法共有八式：" ZJBR;
    msg += "  「飞燕入林」 - 自上而下刺向目标，等级要求0级。" ZJBR;
    msg += "  「青龙吐水」 - 向前下方反刺，等级要求10级。" ZJBR;
    msg += "  「凤凰挚窝」 - 腾空转体刺击，剑光如匹练，等级要求20级。" ZJBR;
    msg += "  「白蛇吐信」 - 疾速上崩直取要害，等级要求30级。" ZJBR;
    msg += "  「玉女穿梭」 - 剑锋往来运转如梭，连绵不绝，等级要求40级。" ZJBR;
    msg += "  「仙人指路」 - 中平剑奋勇向前，等级要求50级。" ZJBR;
    msg += "  「怀中抱月」 - 圆环形搅动，剑意圆润，等级要求60级。" ZJBR;
    msg += "  「反身朝阳」 - 上体后仰，自下上撩，等级要求70级。" ZJBR ZJBR;
    
    msg += HIY "〖特殊说明〗" ZJBR NOR;
    msg += "  武当剑法招式灵动多变，攻守兼备，是一门极为实用的剑法。" ZJBR;
    msg += "  此剑法没有特殊绝技（perform）。" ZJBR;
    
    return msg;
}

