int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

int valid_learn(object me)
{
     object weapon;

     if (! objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "blade")
         return notify_fail("你必须手里拿着刀才能练刀法。\n");

     if ((int)me->query_skill("riyue-xinfa", 1) < 100)
         return notify_fail("你的内功心法火候太浅，不能学天魔刀法。\n");

     if ((int)me->query_skill("blade", 1) < 100)
         return notify_fail("你的基本刀法火候不够。\n");

     if ((int)me->query("max_neili") < 350)
         return notify_fail("你的内力太低，无法学天魔刀法。\n");

     if ((int)me->query_skill("blade", 1) < (int)me->query_skill("tianmo-dao", 1))
         return notify_fail("你的基本刀法水平有限，无法领会更高深的天魔刀法。\n");

     return 1;
}

string query_skill_name(int level)
{
     int i;
     for(i = sizeof(action)-1; i >= 0; i--)
     if(level >= action[i]["lvl"])
            return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
     int i, level;
     level = (int) me->query_skill("tianmo-dao", 1);
     for(i = sizeof(action); i > 0; i--)
         if(level > action[i-1]["lvl"])
              return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
     object weapon;

     if (! objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "blade")
         return notify_fail("你必须手里拿着刀才能练天魔刀法。\n");

     if ((int)me->query("qi") < 100)
            return notify_fail("你的体力不够练天魔刀法。\n");

     if ((int)me->query("neili") < 90)
            return notify_fail("你的内力不够练天魔刀法。\n");

     me->receive_damage("qi", 70);
     me->add("neili", -75);
     return 1;
}

string perform_action_file(string action)
{
     return __DIR__"tianmo-dao/" + action;
}

string query_description()
{
    string msg;

    msg = HIR "【天魔刀法】" ZJBR NOR;
    msg += "一门霸道凌厉的刀法，刀势狂猛，杀气逼人，威力不俗。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  必须手持刀类武器。" ZJBR;
    msg += "  日月心法 " HIY "100" NOR " 级以上。" ZJBR;
    msg += "  基本刀法 " HIY "100" NOR " 级以上。" ZJBR;
    msg += "  内力最大值 " HIB "350" NOR " 点以上。" ZJBR;
    msg += "  基本刀法等级不能低于天魔刀法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  刀法（blade）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  必须手持刀类武器。" ZJBR;
    msg += "  气血：不低于 " HIR "100" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "90" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "75" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // hit_ob, valid_damage, skill_improved etc.
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform/exert
    msg += HIC "  惊天一击 (jing)" ZJBR NOR; // 招式名称
    msg += "    使用要求：" ZJBR; // 招式使用要求
    msg += "      天魔刀法等级 " HIY "120" NOR " 级以上。" ZJBR;
    msg += "      当前内力 " HIB "120" NOR " 点以上。" ZJBR;
    msg += "      必须手持刀类武器且在战斗中对敌人使用。" ZJBR;
    msg += "    效果描述：" ZJBR; // 招式效果描述
    msg += "      手中刀呤呤作响，如闪电般向敌人猛砍，威力巨大。" ZJBR;
    msg += "      命中判定：攻击方命中值（天魔刀法等级 / 2 + 随机(天魔刀法等级)） > 防御方闪避值（对方基本内功等级）。" ZJBR;
    msg += "      伤害计算：伤害值 = 天魔刀法等级 + 基本内功等级 + 随机(伤害值 / 2)，提高40%的伤害效果。" ZJBR;
    msg += "    消耗与代价：" ZJBR; // 消耗与代价
    msg += "      命中：内力 " HIB "80" NOR " 点，自身忙乱 " HIR "1-3" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "30" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;

    return msg;
}

