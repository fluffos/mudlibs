//zhongping-qiang.c 中平枪法



inherit SKILL;

mapping *action = ({
([	"action": "$N双手一别，尽力前伸，使出一招「中平无敌」，手中$w平平直出，刺向$n的$l",
	"force" : 80,
	"dodge": -3,
	"damage": 30,
	"skill_name" : "中平无敌",
	"damage_type": "刺伤"
]),
([	"action": "$N手中$w盘旋回转，风响阵阵，屈身下蹲，反手一招「夜叉探海」自下向$n的$l刺去",
	"force" : 100,
	"dodge": -5,
	"damage": 40,
	"skill_name" : "夜叉探海",
	"damage_type": "刺伤"
]),
([	"action": "$N举起$w，抖出一朵枪花，一招「灵蛇出洞」向$n分心扎去",
	"force" : 110,
	"dodge": -10,
	"damage": 44,
	"skill_name" : "灵蛇出洞",
	"damage_type": "刺伤"
]),
([	"action": "$N一招「反身拿枪」，手中$w划个小圈消去$n的后招，而后$w微抬，指向$n的$l",
	"force" : 120,
	"dodge": -5,
	"damage": 50,
	"skill_name" : "反身拿枪",
	"damage_type": "刺伤"
]),
});

int valid_enable(string usage) { return usage=="club" ||  usage=="parry"; }

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 70)
		return notify_fail("你的内力不够。\n");
	return 1;
}

int practice_skill(object me)
{
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "club")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 80)
		return notify_fail("你的体力不够练中平枪法。\n");

	me->receive_damage("qi", 60);
	return 1;
}


string query_description()
{
    string msg;

    msg = HIY "【中平枪法】" ZJBR NOR;
    msg += WHT "中平枪法是一门入门枪棒类武学，以招式平稳扎实、攻守兼备著称。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力 不低于 " HIY "70" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  枪棒类武学 (club)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须装备 枪棒类 武器。" ZJBR;
    msg += "  当前气血 不低于 " HIY "80" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖练习消耗〗" ZJBR NOR;
    msg += "  每次练习消耗 气血 " HIR "60" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖普通招式〗" ZJBR NOR;
    msg += "  中平枪法包含四式普通攻击招式，随使用者激发施展：" ZJBR;
    msg += "  「中平无敌」、「夜叉探海」、「灵蛇出洞」、「反身拿枪」。" ZJBR;
    msg += "  伤害类型：刺伤。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无特殊招式。" ZJBR;

    return msg;
}