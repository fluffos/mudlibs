int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me)
{
        if ((int)me->query_skill("force") < 50)
                return notify_fail("你的内功火候不到，无法学习烈火剑法。\n");

        if (me->query_skill("force", 1) < me->query_skill("liehuo-jian", 1))
                return notify_fail("你的内功底子还不够，无法领会更高深的烈火剑法。\n");

        if (me->query_skill("sword", 1) < me->query_skill("liehuo-jian", 1))
                return notify_fail("你的基本剑法水平有限，无法领会更高深的烈火剑法。\n");

        return 1;
}

mapping query_action(object me, object weapon)
{
        int i, level;
        level = (int) me->query_skill("liehuo-jian", 1);
        for (i = sizeof(action); i > 0; i--)
                if (level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
        object weapon;

        if (!objectp(weapon = me->query_temp("weapon")) || 
            (string)weapon->query("skill_type") != "sword")
                return notify_fail("你使用的武器不对。\n");

        if ((int)me->query("qi") < 80)
                return notify_fail("你的体力不够练烈火剑法。\n");

        if ((int)me->query("neili") < 80)
                return notify_fail("你的内力不够练烈火剑法。\n");

        me->receive_damage("qi", 30);
        me->add("neili", -20);

        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"liehuo-jian/" + action;
}


string query_description()
{
    string msg;

    msg = HIY "【烈火剑法】" ZJBR NOR;
    msg += WHT "一门至阳至刚的剑法，剑招凌厉，出剑时夹带炙热之气。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功 (`force`) 等级不低于 " HIY "50" NOR " 级。" ZJBR;
    msg += "  基本内功 (`force`) 等级需高于或等于烈火剑法等级。" ZJBR;
    msg += "  基本剑法 (`sword`) 等级需高于或等于烈火剑法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  剑法 (`sword`)。" ZJBR;
    msg += "  招架 (`parry`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须装备剑类武器。" ZJBR;
    msg += "  气血 (`qi`) 不低于 " HIR "80" NOR " 点。" ZJBR;
    msg += "  内力 (`neili`) 不低于 " HIB "80" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血 " HIR "30" NOR " 点，内力 " HIB "20" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (Perform)〗" ZJBR NOR;

    msg += HIC "  烈火三绝剑 (jue)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      基本剑法 (`sword`) 等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 (`neili`) 不低于 " HIB "500" NOR " 点。" ZJBR;
    msg += "      必须装备剑类武器且激发为烈火剑法。" ZJBR;
    msg += "      只能在战斗中使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对当前对手发动连续攻击，攻击次数等于 `COMBAT_D->query_base_attack_number(me,query_name())` 返回的基础攻击次数。" ZJBR;
    msg += "      每次攻击使用标准 `COMBAT_D->do_attack()` 进行判定。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      自身忙乱 (`busy`) 1 到 2 秒 (1 + random(2))。" ZJBR ZJBR;

    msg += HIC "  烈焰滔天 (taotian)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      烈火剑法等级不低于 " HIY "70" NOR " 级。" ZJBR;
    msg += "      基本内功 (`force`) 等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 (`neili`) 不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "      必须装备剑类武器且激发为烈火剑法。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：比较 随机(自身内功激发等级) 与 (目标内功激发等级 / 3)。" ZJBR;
    msg += "      命中效果：" ZJBR;
    msg += "        - 对目标造成兵器伤害，伤害值约为 (自身内功激发等级 + 自身基本剑法等级) / 2 + 随机(自身内功激发等级 + 自身基本剑法等级)，并附加固定伤害 60 点。" ZJBR;
    msg += "        - 自身受到气血上限伤害 (`wound`)，数值约为 随机(造成伤害 / 5)。" ZJBR;
    msg += "      未命中效果：无特殊效果。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 " HIB "200" NOR " 点，自身忙乱 (`busy`) " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：消耗内力 " HIB "100" NOR " 点，自身忙乱 (`busy`) " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 「烈火三绝剑」和「烈焰滔天」均为战斗专用招式。" ZJBR;
    msg += "2. 使用「烈焰滔天」命中后自身会受到一定的气血上限伤害。" ZJBR;
    msg += "3. 注意各招式的使用条件和内力消耗。" ZJBR;

    return msg;
}
