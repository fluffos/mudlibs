([      "action": "$N飞起一剑，手中$w颤动不已，直向$n席卷而去，攻势凌厉",
        "force" : 50,
        "attack": 70,
        "dodge" : 30,
        "damage": 30,
        "parry" : 70,
        "lvl"   : 0,
        "damage_type": "割伤"
]),
([      "action": "突然之间，$N凝神而立，$w凭空挑出一个火焰形状，猛然向$n身上划去",
        "force" : 70,
        "attack": 80,
        "dodge" : 33,
        "parry" : 79,
        "damage": 38,
        "lvl"   : 40,
        "damage_type": "割伤"
]),
([      "action": "$N欺身直进，左手持$w向$n飞刺过去，剑身红光隐隐，热气蒸腾",
        "force" : 90,
        "attack": 90,
        "dodge" : 41,
        "parry" : 85,
        "damage": 52,
