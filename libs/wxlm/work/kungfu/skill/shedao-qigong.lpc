int valid_enable(string usage)
{
	return usage == "unarmed" ||
	       usage == "sword"||
	       usage == "staff"||
	       usage == "parry";
}

int valid_learn(object me)
{
	if ((int)me->query_skill("force") < 150)
		return notify_fail("你的内功火候不够，无法学蛇岛奇功.\n");

	if ((int)me->query_skill("shenlong-bashi", 1) < 100)
		return notify_fail("你的神龙八式火候不够，无法学蛇岛奇功。\n");

	if ((int)me->query("max_neili") < 1000)
		return notify_fail("你的内力太弱，无法学蛇岛奇功。\n");

	if ((int)me->query_skill("shenlong-bashi", 1) < (int)me->query_skill("shedao-qigong", 1))
		return notify_fail("你的神龙八式水平有限，无法继续学蛇岛奇功。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action) - 1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;

	level = (int) me->query_skill("shedao-qigong", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i - 1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 70)
		return notify_fail("你的内力不够练蛇岛奇功。\n");

	me->receive_damage("qi", 55);
	me->add("neili", -67);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"shedao-qigong/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【蛇岛奇功】" ZJBR NOR;
    msg += WHT "神龙教镇教绝学，融合杖法、剑法、拳脚为一体，招式诡异，变化多端，暗合五行八卦之道。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功 (`force`) 等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "  神龙八式 (`shenlong-bashi`) 等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "  最大内力 (`max_neili`) 不低于 " HIB "1000" NOR " 点。" ZJBR;
    msg += "  神龙八式等级不能低于蛇岛奇功等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  拳脚（unarmed）。" ZJBR;
    msg += "  剑法（sword）。" ZJBR;
    msg += "  杖法（staff）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "55" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "67" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;

    msg += HIC "  神龙低吟 (chang1)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      蛇岛奇功等级 " HIY "60" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      战斗状态中。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升自身状态：增加 1 点空手伤害 (`unarmed_damage`)，10 点护甲 (`armor`)，1 点防御 (`defense`),最高低吟次数（蛇岛奇功等级）非神龙教低吟次数只能低吟一半，神龙教为主门派时额外提交5%低吟次数。" ZJBR;



    msg += "      可重复使用叠加效果，最大叠加次数等于蛇岛奇功等级 (受 `temp/chang` 标记限制)。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "200" NOR " 点。" ZJBR ZJBR;

    msg += HIC "  唱仙回内 (chang2)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      蛇岛奇功等级 " HIY "80" NOR " 级。" ZJBR;
    msg += "      战斗状态中。" ZJBR;
    msg += "      受 `temp/chang` 标记限制 (需大于 -20)。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      恢复自身内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      临时降低自身 1 点攻击 (`attack`)、1 点闪避 (`dodge`)、1 点防御 (`defense`)。" ZJBR;
    msg += "      降低 `temp/chang` 标记值 1。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      无明确内力消耗，但会降低攻防属性。" ZJBR ZJBR;

    msg += HIC "  吼字诀 (chang3)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      蛇岛奇功等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "500" NOR " 点。" ZJBR;
    msg += "      战斗状态中。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对当前目标造成精神和气血伤害及创伤。" ZJBR;
    msg += "      判定条件：比较 （自身最大内力/2 + 随机(自身最大内力/2)） 与 （目标最大内力）。" ZJBR;
    msg += "      伤害计算：若判定成功，伤害值与双方最大内力差相关 （(自身内力 - 目标内力) / 10）。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "300-500" NOR " 点。" ZJBR;
    msg += "      气血 " HIR "10" NOR " 点。" ZJBR;
    msg += "      忙乱 " HIR "1-5" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  蛇岛飞仙 (fei)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      蛇岛奇功等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "      需装备剑或杖。" ZJBR;
    msg += "      战斗状态中。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标发动多次攻击（次数取决于 `COMBAT_D` 判定）。" ZJBR;
    msg += "      临时提升自身攻击力，提升幅度为 （蛇岛奇功等级 / 6）。" ZJBR;
    msg += "      每次攻击有 " HIW "1/3" NOR " 概率使未忙乱的目标忙乱 1 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      忙乱 " HIR "1-5" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  摧心断肠 (cui)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      蛇岛奇功等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "250" NOR " 点。" ZJBR;
    msg += "      需激发蛇岛奇功（拳脚/剑/杖）。" ZJBR;
    msg += "      战斗状态中。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标发动强力单体攻击。" ZJBR;
    msg += "      命中判定：第一重判定 （（激发技能等级 / 2） + 随机（激发技能等级）） 对比 （目标内功激发等级）；第二重判定 （（激发技能等级 / 2） + 随机（激发技能等级）） 对比 （目标轻功激发等级）。" ZJBR;
    msg += "      命中效果（通过两重判定）：造成伤害，伤害值约为 （50 + 激发技能等级 + 随机（激发技能等级）），附加 60 点固定气血伤害。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力 " HIB "220" NOR " 点，忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      被内力抵抗：内力 " HIB "200" NOR " 点，忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      被闪避：内力 " HIB "50" NOR " 点，忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  神龙再现 (xian)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      蛇岛奇功等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      需激发蛇岛奇功（拳脚/剑/杖）。" ZJBR;
    msg += "      战斗状态中。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标发动精妙的单体攻击。" ZJBR;
    msg += "      命中判定：第一重判定 （（激发技能等级 / 2） + 随机（激发技能等级）） 对比 （目标招架激发等级）；第二重判定 （（激发技能等级 / 3） + 随机（激发技能等级）） 对比 （目标轻功激发等级）。" ZJBR;
    msg += "      命中效果（通过任一判定）：造成伤害，伤害值约为 （（激发技能等级 / 2） + 随机（激发技能等级 / 2）），附加 50 或 55 点固定气血伤害。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      招架命中：内力 " HIB "150" NOR " 点，忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      闪避命中：内力 " HIB "180" NOR " 点，忙乱 " HIR "3" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "100" NOR " 点，忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 此功法招式繁多，兼具攻击、辅助、恢复能力。" ZJBR;
    msg += "2. 部分招式 (`fei`, `cui`, `xian`) 对兵器或激发状态有要求。" ZJBR;
    msg += "3. `chang` 系列招式可能存在相互影响 (`temp/chang` 标记)。" ZJBR;

    return msg;
}