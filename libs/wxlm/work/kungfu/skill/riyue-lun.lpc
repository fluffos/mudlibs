int valid_enable(string usage) { return usage == "hammer" || usage == "parry"; }

/**
 * @brief 判断是否可以学习日月轮法
 * @param me 学习者对象
 * @return int 1-可以学习，0-不可以
 */
int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 1500)
		return notify_fail("你的内力修为不够，无法驾驭日月轮法的浩然力量。\n");

	if ((int)me->query_skill("force") < 180)
		return notify_fail("你的内功基础太薄弱，还不足以控制日月轮法的阴阳之力。\n");

	if ((int)me->query_skill("hammer", 1) < (int)me->query_skill("riyue-lun", 1))
		return notify_fail("你的基本锤法水平有限，无法领会更高深的日月轮法。\n");

	if (me->query_str() < 40)
		return notify_fail("你的臂力不足，无法使用如此沉重的锤法。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action) - 1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

/**
 * @brief 获取攻击动作
 * @param me 使用者
 * @param weapon 武器
 * @return mapping 攻击动作信息
 */
mapping query_action(object me, object weapon)
{
	int i, level;
	mapping act;
	
	level = (int) me->query_skill("riyue-lun",1);
	
	// 高等级时使用特殊描述
	if (level > 250) {
		return ([
			"action": HIY + replace_string(replace_string(super_msg[random(sizeof(super_msg))], "$w", "$w"), "$w", "$w" HIY) + NOR,
			"dodge": random(35) + 10,
			"parry": random(40) + 15,
			"force": 400 + random(300),
			"damage": 180 + random(150),
			"damage_type": random(2) ? "挫伤" : "内伤",
		]);
	}
	
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"]) {
			act = copy(action[NewRandom(i, 20, level / 5)]);
			// 根据等级增强属性
			act["damage"] += level / 8;
			act["force"] += level / 4;
			return act;
		}
}

/**
 * @brief 练习技能
 * @param me 练习者
 * @return int 1-成功，0-失败
 */
int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "hammer")
		return notify_fail("练习日月轮法必须使用锤类武器。\n");

	if ((int)me->query("qi") < 80)
		return notify_fail("你的体力不够，无法承受日月轮法的高强度训练。\n");

	if ((int)me->query("neili") < 85)
		return notify_fail("你的内力不足，无法推动沉重的日月轮。\n");

	me->receive_damage("qi", 75);
	me->add("neili", -80);
	return 1;
}


string perform_action_file(string action)
{
	return __DIR__"riyue-lun/" + action;
}

/**
 * @brief 获取技能描述
 * @return string 技能详细描述
 */
string query_description()
{
    string msg;

    msg = HIY "【日月轮法】" ZJBR ZJBR NOR;
    msg += WHT "日月轮法是一门威力强大的锤法，融合日之阳刚与月之阴柔，变化莫测。" ZJBR;
    msg += WHT "此锤法招式大开大合，气势磅礴，兼具刚猛与灵巧，乃锤法中的绝顶武学。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力 (" HIW "max_neili" NOR ") 不低于 " HIB "1500" NOR " 点。" ZJBR;
    msg += "  基本内功 (" HIW "force" NOR ") 等级不低于 " HIY "180" NOR " 级。" ZJBR;
    msg += "  先天臂力 (" HIW "str" NOR ") 不低于 " HIR "40" NOR " 点。" ZJBR;
    msg += "  基本锤法 (" HIW "hammer" NOR ") 等级不低于日月轮法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  锤法 (hammer)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  需要装备锤 (hammer) 类武器。" ZJBR;
    msg += "  气血 (" HIW "qi" NOR ") 不低于 " HIR "80" NOR " 点。" ZJBR;
    msg += "  内力 (" HIW "neili" NOR ") 不低于 " HIB "85" NOR " 点。" ZJBR;
    msg += "  每次练习消耗：" ZJBR;
    msg += "    气血：" HIR "75" NOR " 点。" ZJBR;
	msg += "    内力：" HIB "80" NOR " 点。" ZJBR ZJBR;
	
	msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
	msg += "  日月真力：高等级时（250级以上），攻击动作随机选择特殊描述文本，威力大幅提升。" ZJBR;
	msg += "  刚猛特性：所有招式威力随激发锤法等级逐步增强，体现锤法的厚重威力。" ZJBR ZJBR;
	
	msg += HIY "〖招式列表〗" ZJBR NOR;
    msg += "  破晓日出 (0级)   ：日之阳刚，破开重重阻挡。" ZJBR;
    msg += "  月隐云中 (30级)  ：月之阴柔，攻击飘忽难测。" ZJBR;
    msg += "  烈日当空 (60级)  ：烈火骄阳，威力强猛。" ZJBR;
    msg += "  银月如钩 (90级)  ：弯月掠空，攻击诡异多变。" ZJBR;
    msg += "  日月交辉 (120级) ：阴阳并济，连环轰击。" ZJBR;
    msg += "  天日昭昭 (150级) ：天威如雷，从天而降。" ZJBR;
    msg += "  月满西楼 (180级) ：满月当空，月华笼罩。" ZJBR;
    msg += "  日月轮回 (200级) ：轮回转世，无穷无尽。" ZJBR ZJBR;
	
	msg += HIY "〖特殊招式〗" ZJBR NOR;

    msg += HIC "  破而后立 (poli)" ZJBR NOR;
	msg += "    使用要求：" ZJBR;
	msg += "      日月轮法基本等级 " HIY "120" NOR " 级。" ZJBR;
	msg += "      基本内功等级 " HIY "180" NOR " 级。" ZJBR;
	msg += "      当前内力 " HIB "400" NOR " 点。" ZJBR;
	msg += "      激发锤法为日月轮法。" ZJBR;
    msg += "      装备锤类武器。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      破而后立，蓄势一击，带着破天之势向敌人砸下。" ZJBR;
    msg += "      命中判定：锤法激发等级 + 内功激发等级 + (后天臂力+后天根骨) * 8 vs 敌人招架技能 + 内功技能 + 后天身法 * 16。" ZJBR;
    msg += "      基础伤害：锤法激发等级 + 内功激发等级 + 后天臂力 * 15 + 随机（内功激发）。" ZJBR;
	msg += "      雪域圣光奥义加成：每级增加最终伤害 " HIY "10%" NOR "。" ZJBR;
    msg += "      对非玩家目标命中提升 " HIY "50%" NOR "，伤害翻倍。" ZJBR;
    msg += "      有 " HIY "33%" NOR " 概率触发破甲效果，降低敌人护甲值8-15秒。" ZJBR;
	msg += "      单招最终系数伤害：180%。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 " HIB "300" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：消耗内力 " HIB "150" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  五轮连砸 (wulun)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      日月轮法基本等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "      激发锤法为日月轮法。" ZJBR;
    msg += "      装备锤类武器。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标发动连续攻击，锤影如轮，连环不绝。" ZJBR;
    msg += "      攻击次数：基础攻击次数 + 雪域圣光奥义等级。" ZJBR;
    msg += "      攻击力加成：锤法激发等级/9。" ZJBR;
    msg += "      每次攻击获得后天根骨 * 2 的伤害加成。" ZJBR;
    msg += "      雪域圣光奥义可能触发额外伤害（后天根骨/3 * 5）。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "1~5" NOR " 秒（随机）。" ZJBR ZJBR;

    msg += HIM "  一锤定音 (yichui)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      锤法激发等级 " HIY "250" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "280" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "1500" NOR " 点。" ZJBR;
    msg += "      当前气血 " HIR "200" NOR " 点。" ZJBR;
    msg += "      激发锤法为日月轮法。" ZJBR;
    msg += "      装备锤类武器。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      终极绝招，以巨大代价换取毁天灭地的一击。" ZJBR;
    msg += "      命中判定：锤法激发等级 + 内功激发等级 + 先天臂力 * 10 vs 敌人轻功激发等级 + 内功激发等级 + 先天身法 * 10。" ZJBR;
    msg += "      基础伤害：锤法激发等级 * 2 + 内功激发等级 + 后天臂力 * 25 + 随机加成。" ZJBR;
    msg += "      雪域圣光奥义加成：每级增加最终伤害 " HIY "10%" NOR "。" ZJBR;
    msg += "      对血量低于 " HIR "40%" NOR " 的目标伤害翻倍。" ZJBR;
    msg += "      对血量低于 " HIR "20%" NOR " 的目标直接终结（设置生命值为1）。" ZJBR;
    msg += "      命中后降低目标攻击、闪避、招架能力10-20秒。" ZJBR;
	msg += "      单招最终系数伤害：180%。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      固定消耗内力 " HIB "5000" NOR " 点，最大气血的 " HIR "25%" NOR " 点。" ZJBR;
    msg += "      命中后自身忙乱 " HIR "3~6" NOR " 秒。" ZJBR;
    msg += "      未命中后自身忙乱 " HIR "4~6" NOR " 秒。" ZJBR;
    msg += "      冷却时间 " HIY "5" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 日月轮法需要强大的先天臂力支持，创建角色时需注意臂力分配。" ZJBR;
    msg += "2. 高等级时威力巨大，但消耗也相应增加，需合理分配内力。" ZJBR;
    msg += "3. 锤法以攻为守，威猛刚劲，适合正面强攻的战斗风格。" ZJBR;
    msg += "4. 一锤定音乃终极绝招，使用需谨慎，代价巨大但威力惊人。" ZJBR;
    msg += "5. 配合雪域圣光等奥义可发挥出更强威力。" ZJBR;
    msg += "6. 五轮连砸实际显示名称为「日月连砸」。\n";

