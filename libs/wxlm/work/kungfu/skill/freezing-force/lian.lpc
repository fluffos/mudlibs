// powerup.c 冰蚕寒功加力



inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

string query_name() { return "寒冰炼毒"; }
string *pfm_type() { return ({ "force", }); }

int exert(object me, object target)
{
	int skill,amount;
	object obj;
	if (target != me)
		return notify_fail("你只能自己炼毒。\n");

	if ((int)me->query("neili") < 200)
		return notify_fail("你的真气不够。\n");

	skill = me->query_skill("freezing-force", 1) + me->query_skill("poison", 1) / 2;

	skill = skill / 20 * COMBAT_D->get_skill_aoyi_level(me, "天罡星辰") + skill;

	message_combatd(HIW "$N" HIW "运起寒冰真气，周身顿时被一层薄薄的白雾笼罩。只见$N" HIW "从身上抠下一些臭气难闻的毒丸，放在掌心，随着内力的注入，泥丸逐渐变得晶莹剔透，散发出阵阵寒气。" NOR "\n", me);

	//数量等于最大内除以100
	amount = me->query("neili")/100;

	me->set("neili", 0);

	obj = new("/u/new_du.lpc");
	obj->set_amount(amount);
	obj->set("poison/level", skill);

	obj->move(me);

	return 1;
}

