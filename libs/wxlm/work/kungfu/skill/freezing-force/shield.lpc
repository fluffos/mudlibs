// shield.c 冰蚕寒功



inherit F_CLEAN_UP;

void remove_effect(object me, int a_amount);

string query_name() { return "蛊命借种"; }
string *pfm_type() { return ({ "force", }); }

int exert(object me, object target)
{
	int skill;
	string msg;

	if ((int)me->query_skill("freezing-force", 1) < 100)
		return notify_fail("你的冰蚕寒功不够深厚，不能使用蛊命借种。\n");

	if ((int)me->query("neili") < 200) 
		return notify_fail("你现在的真气不够。\n");

	//可以一次性汲取蛊虫的气血和内力
	if ((int)me->query_temp("shield"))
	{
		int guchong_qi = me->query_temp("guchong_qi");
		int guchong_neili = me->query_temp("guchong_neili");


		if (guchong_qi > 0)
		{
			me->add("qi", guchong_qi);
			me->add("eff_qi", guchong_qi);
			me->add("jing", guchong_qi);
			me->add("eff_jing", guchong_qi);
		}

		if (guchong_neili > 0)
		{
			me->add("neili", guchong_neili);
		}

		if (me->query("qi") >= me->query("max_qi"))
		{
			me->set("qi", me->query("max_qi"));
			me->set("eff_qi", me->query("max_qi"));
		}

		if (me->query("neili") >= me->query("max_neili"))
		{
			me->set("neili", me->query("max_neili"));
		}

		if (me->query("jing") >= me->query("max_jing"))
		{
			me->set("jing", me->query("max_jing"));
			me->set("eff_jing", me->query("max_jing"));
		}

		me->delete_temp("guchong_qi");
		me->delete_temp("guchong_neili");

		tell_object(me, "你将冰蚕寒功运转过一个周天，吸取蛊虫的气血和内力，将内力收回丹田，气血载入体内。\n");
	}


	skill = me->query_skill("force");
	msg = HIY "$N" HIY "缓提一口真气，慢慢凝聚成一只蛊虫，吐出一股股寒冰之气开始慢慢包裹在$N的全身。"NOR"\n";
	message_combatd(msg, me);

	me->add_temp("apply/armor", skill *2 / 5 );
	me->set_temp("shield", 1);

	//蛊虫可以获得skill x 5的气血和内力
	me->add_temp("guchong_qi", skill * 10);
	me->add_temp("guchong_neili", skill * 10);

	me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill *2 / 5 :), 15);

	me->add("neili", -100);
	if (me->is_fighting()) me->start_busy(2);

	return 1;
}

void remove_effect(object me, int amount)
{
	if (me->query_temp("shield"))
	{
		me->add_temp("apply/armor", -amount);
		me->delete_temp("guchong_qi");
		me->delete_temp("guchong_neili");
		me->delete_temp("shield");
		tell_object(me, "你将冰蚕寒功运转过一个周天，将内力收回丹田。\n");
	}
}

