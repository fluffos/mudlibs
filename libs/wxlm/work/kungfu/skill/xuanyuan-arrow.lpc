// xuanyuan-arrow.c



inherit SKILL;

int valid_learn(object me)
{
 
  
	if (me->query_skill("throwing", 1) < 20)
		return notify_fail("你的暗器技能不够娴熟，怎能在激战中上箭开弓射敌？\n");

	if ((int)me->query_skill("throwing", 1) < (int)me->query_skill("xuanyuan-arrow", 1))
		return notify_fail("你的基本暗器水平有限，难以领会更精妙的射箭之术。\n");

	return 1;
}

int valid_enable(string usage)
{
	return usage == "throwing";
}

int practice_skill(object me)
{
 

	if ((int)me->query("qi") < 80)
		return notify_fail("你的体力不足，拉不开弓！\n");

	me->receive_damage("qi", 70);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"xuanyuan-arrow/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【轩辕箭法】" ZJBR ZJBR NOR;
    msg += WHT "轩辕箭法是一门以精准和威力著称的高级箭术。" ZJBR;
    msg += "此箭法源自上古传说中的轩辕氏,讲究以柔克刚,以巧制胜。" ZJBR ZJBR;

    msg += HIY "【技能要求】" ZJBR NOR;
    msg += "  基本暗器等级：20级" ZJBR;
    msg += "  基本暗器等级必须≥轩辕箭法等级" ZJBR;
    msg += "  当前气血：80点" ZJBR ZJBR;

    msg += HIY "【技能类型】" ZJBR NOR;
    msg += "  可激发为暗器（throwing）" ZJBR ZJBR;

    msg += HIY "【特殊效果】" ZJBR NOR;
    msg += "1. 精准制导：箭矢命中率高" ZJBR;
    msg += "2. 势如破竹：箭矢穿透力强" ZJBR;
    msg += "3. 以柔克刚：可破除敌人防御" ZJBR ZJBR;

    msg += HIY "【特殊招式】" ZJBR NOR;
    msg += "百步穿杨（baibu）：" ZJBR;
    msg += "  要求：轩辕箭法100级，内力100点，手持箭矢至少1支" ZJBR;
    msg += "  效果：远距离射出一支箭矢攻击敌人面门" ZJBR;
    msg += "  判定：暗器有效激发 / 2 + 随机(暗器有效激发) VS 对方轻功有效激发" ZJBR;
    msg += "  伤害：轩辕箭法等级 / 3 + 随机(轩辕箭法等级 / 3) + 加力值 + 120点" ZJBR;
    msg += "  消耗：内力80点，1支箭矢，自身忙碌2秒" ZJBR ZJBR;

    msg += HIR "【练习消耗】" ZJBR NOR;
    msg += "  气血消耗：70点" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 轩辕箭法需要精湛的暗器基础,练习时需要注意提高基本暗器水平。" ZJBR;
    msg += "2. 在实战中,要善于利用箭法的精准性,进行远程攻击。" ZJBR;
    msg += "3. 使用轩辕箭法时,需要确保有足够的气血,否则无法拉开弓。" ZJBR;
    msg += "4. 使用特殊招式时,需要手持箭矢,并确保有足够的内力。" ZJBR;
    msg += "5. 配合其他武功使用,可以发挥出更强的威力。\n";

    return msg;
}