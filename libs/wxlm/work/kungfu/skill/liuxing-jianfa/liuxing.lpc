// liuxing.c 天外流星
// 流星剑法的绝技招式

#include <combat.h>

inherit F_SSERVER;

/**
 * @brief 查询技能名称
 * @return string 返回技能名称"天外流星"
 */
string query_name()
{
	return "天外流星";
}

/**
 * @brief 执行天外流星技能
 * @param object me 施展技能的玩家对象
 * @param object target 目标对象
 * @return int 返回1表示成功，0表示失败
 * @details 天外流星是流星剑法的特殊招式，需要内功120级以上
 */
int perform(object me, object target)
{
	object weapon;
	string msg;
	int ap, dp, damage;

	if (!target)
		target = offensive_target(me);

	if (!target || !me->is_fighting(target))
		return notify_fail("「天外流星」只能在战斗中对敌手使用。\n");

	if (!objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对，难以施展「天外流星」。\n");

	if (me->query_skill("force") < 120)
		return notify_fail("你的内功修为不够，难以施展「天外流星」。\n");

	if (me->query_skill("liuxing-jianfa", 1) < 120)
		return notify_fail("你的流星剑法修为不够，难以施展「天外流星」。\n");

	if (me->query("neili") < 250)
		return notify_fail("你的真气不足，难以施展「天外流星」。\n");

	if (me->query_skill_mapped("sword") != "liuxing-jianfa")
		return notify_fail("你没有激发流星剑法，难以施展「天外流星」。\n");

	if (!living(target))
		return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

	msg = HIY "$N" HIY "忽然剑势一变，手中" + weapon->name() + HIY "光芒大盛，" NOR
	      HIC "§" HIY "天外流星" HIC "§" NOR HIY "瞬息而至！" NOR "\n";
	msg += HIW "只见剑光如流星划破夜空，璀璨夺目，以迅雷不及掩耳之势直刺$n！" NOR "\n";

	ap = me->query_skill("sword");
	dp = target->query_skill("parry");

	if (COMBAT_D->hit_determination(me, target, ap, dp))
	{
		damage = me->query_skill("sword");
		me->add("neili", -150);

		msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 55,
		                           HIR "$n" HIR "尚未反应过来，已被$N" HIR "手中" + weapon->name() +
		                           HIR "如流星般刺中要害，鲜血飞溅！" NOR "\n");
		me->start_busy(2);
	}
	else
	{
		me->add("neili", -60);

		msg += CYN "可是$p" CYN "眼疾手快，及时收敛心神，轻巧地格挡开$P"
		       CYN "的凌厉剑招。" NOR "\n";
		me->start_busy(3);
	}

	message_combatd(msg, me, target);
	return 1;
}