// /kungfu/skill/gaoshan-liushui.c


inherit SKILL;

mapping *action = ({
    ([  "action" : "$N指法轻柔，弹奏出「" HIC "高山幽泉" NOR "」，琴音如山间清泉，令$n心神宁静",
        "force" : 100,
        "attack": 30,
        "dodge" : 40,
        "parry" : 40,
        "damage": 30,
        "lvl"   : 0,
        "skill_name" : "高山幽泉",
        "damage_type" : "内伤"
    ]),
    ([  "action" : "$N运指如飞，使出「" HIG "流水行云" NOR "」，琴声绵延不绝，扰乱$n的心绪",
        "force" : 130,
        "attack": 40,
        "dodge" : 50,
        "parry" : 50,
        "damage": 40,
        "lvl"   : 40,
        "skill_name" : "流水行云",
        "damage_type" : "内伤"
    ]),
    ([  "action" : "$N双手交错，奏响「" HIW "天地和鸣" NOR "」，一股祥和之气随琴声涌向$n",
        "force" : 160,
        "attack": 50,
        "dodge" : 60,
        "parry" : 60,
        "damage": 50,
        "lvl"   : 80,
        "skill_name" : "天地和鸣",
        "damage_type" : "内伤"
    ]),
});

int valid_enable(string usage) { return usage == "qin" || usage == "parry"; }

int valid_learn(object me)
{
    if (me->query("family/family_name") != "白帝城")
        return notify_fail("高山流水只有白帝城的弟子才能学习。\n");

    if ((int)me->query_skill("force") < 120)
        return notify_fail("你的内功火候不够，无法学习高山流水。\n");

    if ((int)me->query("max_neili") < 1000)
        return notify_fail("你的内力修为不足，无法学习高山流水。\n");

    if ((int)me->query_skill("qin", 1) < 80)
        return notify_fail("你的基本琴法火候不够，无法学习高山流水。\n");

    if ((int)me->query_skill("yinlv", 1) < 80)
        return notify_fail("你的音律修养不足，无法学习高山流水。\n");

    if ((int)me->query_skill("qin", 1) < (int)me->query_skill("gaoshan-liushui", 1))
        return notify_fail("你的基本琴法水平有限，无法领会更高深的高山流水。\n");

    return 1;
}

string query_skill_name(int level)
{
    int i;
    for (i = sizeof(action) - 1; i >= 0; i--)
        if (level >= action[i]["lvl"])
            return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    int i, level;
    level = (int) me->query_skill("gaoshan-liushui", 1);
    for (i = sizeof(action); i > 0; i--)
        if (level > action[i-1]["lvl"])
            return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    object weapon;

    if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "qin")
        return notify_fail("你必须先装备琴才能练习高山流水。\n");

    if ((int)me->query("qi") < 60)
        return notify_fail("你的体力不够练习高山流水。\n");

    if ((int)me->query("neili") < 60)
        return notify_fail("你的内力不够练习高山流水。\n");

    me->receive_damage("qi", 50);
    me->add("neili", -55);
    return 1;
}

string perform_action_file(string action)
{
    return __DIR__"gaoshan-liushui/" + action;
}

int help(object me)
{
    write(@HELP
高山流水

    高山流水是白帝城的一门高深琴法，擅长控制和辅助。
    此琴法不仅能弹奏出动人心弦的乐曲，还能在战斗中发挥奇效。

    学习要求：
        白帝城弟子
        基本琴法 80 级
        音律修养 80 级
        内功修为 120 级
        内力 1000 点

HELP
    );
    return 1;
}


string query_description()
{
    string msg;

    msg = HIY "【高山流水琴法】" ZJBR NOR;
    msg += WHT "高山流水是白帝城独有的一门高深琴法，以其优美动听的琴音著称。" ZJBR;
    msg += WHT "此琴法不仅能弹奏出动人心弦的乐曲，还能在战斗中发挥奇效，扰乱敌人心神。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  须为白帝城弟子。" ZJBR;
    msg += "  基本内功等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "  最大内力不低于 " HIB "1000" NOR " 点。" ZJBR;
    msg += "  基本琴法等级不低于 " HIY "80" NOR " 级。" ZJBR;
    msg += "  音律修养等级不低于 " HIY "80" NOR " 级。" ZJBR;
    msg += "  基本琴法等级不低于高山流水等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  琴法（qin）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须装备琴类武器。" ZJBR;
    msg += "  气血不低于 " HIR "60" NOR " 点。" ZJBR;
    msg += "  内力不低于 " HIB "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "55" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  暂无明显的被动攻防特效。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (琴法绝招 perform)〗" ZJBR NOR;
    msg += HIC "  清心静气 (qingxin)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      高山流水等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      基本内功等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      音律修养等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "      必须装备琴类武器。" ZJBR;
    msg += "      目标必须处于战斗状态且非自身。" ZJBR;
    msg += "      目标未受清心静气效果影响。" ZJBR;
    msg += "      不在技能冷却时间内 (`gaoshan_liushui_qingxin`)。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中率计算：" ZJBR;
    msg += "        基础命中率: 50%。" ZJBR;
    msg += "        最终命中率 = (50 + ( (使用者高山流水等级 + 使用者琴法激发等级) - (目标轻功激发等级 + 目标招架激发等级) ) / 20) %。" ZJBR;
    msg += "        命中率范围限制在 10% 到 90% 之间。" ZJBR;
    msg += "      命中效果：目标进入忙乱状态 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中效果：自身损失内力 " HIB "50" NOR " 点。" ZJBR;
    msg += "      音符获取 (无论命中与否)：" ZJBR;
    msg += "        基础获取概率: 35%。" ZJBR;
    msg += "        受奥义【有我神像】加成：最终概率 = (35 + 意境等级 * 5)% (最高 100%)。" ZJBR;
    msg += "        若成功获取，则 50% 概率获得火音符，50% 概率获得冰音符。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "    冷却时间：(8 - 奥义【清心静气】等级) 秒 (最少 1 秒)。" ZJBR;

    return msg;
}