int valid_enable(string usage) { return usage == "whip" || usage == "parry"; }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 1000)
		return notify_fail("你的内力不足，没有办法练日月鞭法，多练些内力再来吧。\n");

	if ((int)me->query_skill("force") < 150)
		return notify_fail("你的内功火候太浅，没有办法练日月鞭法。\n");

	if ((int)me->query_skill("whip", 1) < 100)
		return notify_fail("你的基本鞭法火候太浅，没有办法练日月鞭法。\n");

	if ((int)me->query_skill("whip", 1) < (int)me->query_skill("riyue-bian", 1))
		return notify_fail("你的基本鞭法水平还不够，无法领会更高深的日月鞭法。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action) - 1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("riyue-bian", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "whip")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 80)
		return notify_fail("你的体力不够练日月鞭法。\n");

	if ((int)me->query("neili") < 90)
		return notify_fail("你的内力不够练日月鞭法。\n");

	me->receive_damage("qi", 75);
	me->add("neili", -85);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"riyue-bian/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【日月鞭法】" ZJBR ZJBR NOR;
    msg += WHT "日月神教的独门鞭法，以其刚柔并济、变化多端的特点著称。此鞭法招式灵活多变,攻守兼备,可谓攻可摧山、守可绝地。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力 (" HIW "max_neili" NOR ") 不低于 " HIB "1000" NOR " 点。" ZJBR;
    msg += "  基本内功 (" HIW "force" NOR ") 等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "  基本鞭法 (" HIW "whip" NOR ") 等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "  基本鞭法 (" HIW "whip" NOR ") 等级不低于日月鞭法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  鞭法 (whip)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须装备 鞭 (whip) 类武器。" ZJBR;
    msg += "  气血 (" HIW "qi" NOR ")：不低于 " HIR "80" NOR " 点。" ZJBR;
    msg += "  内力 (" HIW "neili" NOR ")：不低于 " HIB "90" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "75" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "85" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  缠字诀 (chan)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      日月鞭法等级 " HIY "60" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "80" NOR " 点。" ZJBR;
    msg += "      装备鞭类武器。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定基于：(自身基本鞭法等级 / 2 + 随机(自身基本鞭法等级)) > 目标招架等级。" ZJBR;
    msg += "      命中后使目标忙乱 (" HIY "(基本鞭法等级 / 20 + 2)" NOR ") 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "80" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "1-2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  伤字诀 (shang)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      日月鞭法等级 " HIY "180" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "300" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "400" NOR " 点。" ZJBR;
    msg += "      装备鞭类武器。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定基于：((自身基本鞭法等级 + 自身基本内功等级) / 2 + 随机(自身基本鞭法等级 + 自身基本内功等级)) > (目标基本内功等级 + 目标招架等级)。" ZJBR;
    msg += "      命中后对目标造成伤害，伤害值约为 (攻击判定值 / 3 + 随机(攻击判定值 / 3))，并附加一半的气血伤口。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "2-3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  合字诀 (he)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      日月鞭法等级 " HIY "250" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "400" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "600" NOR " 点。" ZJBR;
    msg += "      装备鞭类武器。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      此招包含「缠」和「伤」两段攻击判定：" ZJBR;
    msg += "      1. 缠判定：命中判定基于：((自身基本鞭法等级 + 自身基本内功等级) / 2 + 随机(自身基本鞭法等级 + 自身基本内功等级)) > (目标基本内功等级 + 目标招架等级)。" ZJBR;
    msg += "         命中则使目标忙乱 (" HIY "(基本鞭法等级 / 20 + 2)" NOR ") 秒。" ZJBR;
    msg += "      2. 伤判定：命中判定同上。" ZJBR;
    msg += "         命中则对目标造成伤害，伤害值约为 (攻击判定值 / 2 + 随机(攻击判定值 / 2))，并附加一半的气血伤口。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "500" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "3-5" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 日月鞭法需要使用鞭类武器才能发挥威力。" ZJBR;
    msg += "2. 招式均会造成自身忙乱。" ZJBR;
    msg += "3. 练习时需注意控制内力运转,以免走火入魔。\n";

    return msg;
}