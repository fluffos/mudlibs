int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 250)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("force") < 50)
		return notify_fail("你的内功火候太浅。\n");

	if ((int)me->query_skill("sword", 1) < (int)me->query_skill("fumo-jian", 1))
		return notify_fail("你的基本剑法水平有限，无法领会更高深的伏摩剑法。\n");

    return 1;
}

string query_skill_name(int level)
{
	int i;

	for(i = sizeof(action) - 1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;

	level = (int) me->query_skill("fumo-jian", 1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "sword")
		return notify_fail("你必须有把剑才能够练习伏摩剑。\n");

	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力不够练伏魔剑。\n");

	if ((int)me->query("neili") < 70)
		return notify_fail("你的内力不够练伏魔剑。\n");

	me->receive_damage("qi", 65);
	me->add("neili", -62);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"fumo-jian/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【伏魔剑法】" ZJBR NOR;
    msg += WHT "少林七十二绝技之一，与大金刚掌、般若掌等齐名。剑法厚重古拙，大开大阖，以纯阳正气克制邪魔。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力不低于 " HIB "250" NOR " 点。" ZJBR;
    msg += "  内功等级不低于 " HIY "50" NOR " 级。" ZJBR;
    msg += "  基本剑法等级需大于等于伏魔剑法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  剑法（sword）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须装备剑类武器。" ZJBR;
    msg += "  气血不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "65" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "62" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  随技能等级提升普通攻击的伤害和命中率。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  佛心剑 (foxin)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      伏魔剑法等级 " HIY "135" NOR " 级。" ZJBR;
    msg += "      内功等级 " HIY "200" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "250" NOR " 点。" ZJBR;
    msg += "      必须装备剑类武器。" ZJBR;
    msg += "      激发剑法为伏魔剑法。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：使用标准命中判定 (`通用命中公式`)，比较双方 剑法(sword) 和 招架(parry) 等级。" ZJBR;
    msg += "      命中效果：" ZJBR;
    msg += "        造成伤害，伤害值约为 (激发剑法等级 / 2 + 随机(激发剑法等级))，伤害附加比例 30%。" ZJBR;
    msg += "        附带内息紊乱描述。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力 " HIB "150" NOR " 点，自身忙乱 " HIR "1" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "60" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;

    return msg;
}