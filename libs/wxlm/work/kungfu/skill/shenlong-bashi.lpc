([	"action": "$N深吸一口气，身体涨成球状，猛然流星赶月般直撞向$n",
	"force" : 400,
	"attack": 52,
	"dodge" : 80,
	"parry" : 15,
	"damage": 70,
	"lvl"   : 200,
