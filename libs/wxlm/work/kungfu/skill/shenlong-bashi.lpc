int valid_enable(string usage) { return usage=="hand" || usage=="parry"; }

int valid_combine(string combo) { return combo == "huagu-mianzhang"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练神龙八式必须空手。\n");

	if ((int)me->query_skill("force") < 120)
		return notify_fail("你的内功火候不够，无法学神龙八式.\n");

	if ((int)me->query("max_neili") < 750)
		return notify_fail("你的内力太弱，无法练神龙八式。\n");

	if ((int)me->query_skill("hand", 1) < 80)
		return notify_fail("你的基本手法火候不够，无法学习神龙八式。\n");

	if ((int)me->query_skill("hand", 1) < (int)me->query_skill("shenlong-bashi", 1))
		return notify_fail("你的基本手法水平有限，无法学习更高深的神龙八式。\n");

	return 1;
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 70)
		return notify_fail("你的内力不够练神龙八式。\n");

	me->receive_damage("qi", 61);
	me->add("neili", -62);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"shenlong-bashi/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【神龙八式】" ZJBR NOR;
    msg += WHT "神龙教的基础手法，招式看似简单，实则变化莫测，诡异难防。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  必须空手。" ZJBR;
    msg += "  基本内功 (`force`) 等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "  最大内力 (`max_neili`) 不低于 " HIB "750" NOR " 点。" ZJBR;
    msg += "  基本手法 (`hand`) 等级不低于 " HIY "80" NOR " 级。" ZJBR;
    msg += "  基本手法等级不能低于神龙八式等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  手法（hand）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "61" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "62" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;

    msg += HIC "  神龙初现 (xian)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      神龙八式等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "80" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "      激发手法为神龙八式。" ZJBR;
    msg += "      战斗状态中。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标发动单体攻击。" ZJBR;
    msg += "      命中判定：随机(自身神龙八式等级) 对比 (目标招架激发等级 / 2)。" ZJBR;
    msg += "      命中效果：造成伤害，伤害值约为 （（基本内功等级 / 2） + 随机（基本内功等级 / 2）），附加 35 点固定气血伤害。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力 " HIB "125" NOR " 点，忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "30" NOR " 点，忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  小怜横陈 (hengchen)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      神龙八式等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "400" NOR " 点。" ZJBR;
    msg += "      激发手法为神龙八式。" ZJBR;
    msg += "      战斗状态中。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标发动单体攻击。" ZJBR;
    msg += "      命中判定：随机(自身神龙八式等级) 对比 (目标轻功激发等级 / 2)。" ZJBR;
    msg += "      命中效果：造成伤害，伤害值约为 （（神龙八式等级 + 基本内功等级）/ 2 + 随机（神龙八式等级 + 基本内功等级）），附加 35 点固定气血伤害。若使用者为玩家且目标为NPC，伤害翻倍。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力 " HIB "210" NOR " 点，忙乱 " HIR "1-4" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "80" NOR " 点，忙乱 " HIR "1-4" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  贵妃回眸 (huimou)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      神龙八式等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      激发手法为神龙八式。" ZJBR;
    msg += "      战斗状态中。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标发动单体攻击。" ZJBR;
    msg += "      命中判定：随机(自身神龙八式等级) 对比 (目标招架激发等级 / 2)。" ZJBR;
    msg += "      命中效果：造成伤害，伤害值约为 （（基本内功等级 * 3 / 4） + 随机（基本内功等级）），附加 35 点固定气血伤害。若使用者为玩家且目标为NPC，伤害翻倍。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力 " HIB "180" NOR " 点，忙乱 " HIR "2-3" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "70" NOR " 点，忙乱 " HIR "2-3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  飞燕回翔 (huixiang)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      神龙八式等级 " HIY "160" NOR " 级。" ZJBR;
    msg += "      最大内力 " HIB "1500" NOR " 点。" ZJBR;
    msg += "      当前内力 " HIB "500" NOR " 点。" ZJBR;
    msg += "      目标需装备兵器。" ZJBR;
    msg += "      战斗状态中。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      尝试卸除目标兵器并发动攻击。" ZJBR;
    msg += "      卸除判定：随机（（自身基本手法 / 2） + 随机（自身基本手法）） 对比 （目标招架激发等级）。" ZJBR;
    msg += "      命中判定（卸除成功后）：（（自身轻功激发等级 / 3） + 神龙八式等级） 对比 （目标轻功激发等级）。" ZJBR;
    msg += "      命中效果（卸除且命中成功）：卸除目标兵器，并造成气血伤害及创伤。伤害值约为 （（轻功激发等级 / 3） + 神龙八式等级） + 随机（（轻功激发等级 / 3） + 神龙八式等级），创伤约为伤害值一半。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      卸除命中成功：内力 " HIB "300" NOR " 点，忙乱 " HIR "2-5" NOR " 秒。" ZJBR;
    msg += "      卸除成功未命中：内力 " HIB "100" NOR " 点，忙乱 " HIR "3" NOR " 秒。" ZJBR;
    msg += "      卸除失败：内力 " HIB "80" NOR " 点，忙乱 " HIR "1-2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  神龙九变 (jiubian)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      神龙八式等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      武学修养等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "80" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "      激发手法为神龙八式。" ZJBR;
    msg += "      战斗状态中。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标发动多段攻击（最多九变）。" ZJBR;
    msg += "      初始命中判定：随机(自身神龙八式等级) 对比 (目标招架激发等级 / 2) （对NPC命中翻倍）。" ZJBR;
