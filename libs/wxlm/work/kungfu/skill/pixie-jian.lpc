int valid_enable(string usage)
{
    	return usage == "sword" ||
	       usage == "dodge" ||
	       usage == "parry" ||
	       usage == "force" ||
	       usage == "unarmed";
}

int valid_force(string force)
{
	return force == "kuihua-mogong";
}

int double_attack() { return 1; }

int query_neili_improve(object me)
{
	int lvl;

	lvl = (int)me->query_skill("pixie-jian", 1);
	if (me->query("special_skill/ghost"))
		return lvl * lvl * 20 * 15 / 100 / 200;
	else
		return lvl * lvl * 17 * 15 / 100 / 200;
}

string query_skill_name(int level)
{
    	int i;
    	for (i = sizeof(weapon_action) - 1; i >= 0; i--)
    		if (level >= weapon_action[i]["lvl"])
       			return weapon_action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level, index, lv_kuihua;
	mapping *action;

	if (objectp(weapon))
		action = weapon_action;
	else
		action = unarmed_action;

	level = (int) me->query_skill("pixie-jian", 1);
	lv_kuihua = (int) me->query_skill("kuihua-mogong", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
		{
			index = NewRandom(i, 20, level/5);
			break;
		}

	if (! me->query("special_skill/ghost"))
		return action[index];

	return ([  "action"  : action[index]["action"],
		   "force"   : action[index]["force"] +  lv_kuihua / 4,
		   "attack"  : action[index]["attack"] + lv_kuihua / 6,
		   "parry"   : action[index]["parry"] +  lv_kuihua / 7,
		   "dodge"   : action[index]["dodge"] +  lv_kuihua / 7,
		   "damage"  : action[index]["damage"] + lv_kuihua / 4,
		   "skill_name"   : action[index]["skill_name"],
		   "damage_type"  : action[index]["damage_type"],
	       ]);	    
}

string query_dodge_msg(string limb)
{
    	return dodge_msg[random(sizeof(dodge_msg))];
}

int valid_learn(object me)
{
	if (me->query("gender") == "女性")
		return notify_fail("自古以来没听说过女人可以修习葵花宝典。\n");

	if (me->query("gender") == "男性")
		return notify_fail("你觉得内息忽然大乱，几欲焚身。\n");

	return 1;
}

mixed valid_damage(object ob, object me, int damage, object weapon) 
{ 
	mixed result; 
	int ap, dp, mp, ratio; 
       
	if ((int)me->query_skill("pixie-jian", 1) < 100 || 
	    ! me->query("special_skill/ghost") ||
	    ! me->query_temp("dodge_valid_damage") ||
	    me->query_skill_mapped("force") != "pixie-jian" ||
	    me->query_skill_mapped("parry") != "pixie-jian" ||
	    me->query_skill_mapped("dodge") != "pixie-jian" ||
	    ! living(me)) 
		return; 
	
	mp = ob->query_skill("count", 1);
	if (sizeof(ob->query_skill_prepare()) 
          && ob->query_skill_prepared("unarmed") == "taixuan-gong"
          && !me->query_temp("weapon")
          && ob->query_skill_mapped("unarmed") == "taixuan-gong") 
                 mp += ob->query_skill("taixuan-gong", 1)/2;
	ap = ob->query_skill("dodge", 1) * 3 / 2 + mp; 
	dp = me->query_skill("dodge", 1) / 2 + 
	     me->query_skill("pixie-jian", 1); 
	     
	// 比率，自己先天 dex 高、str 低，对方先天 str 高，dex 低，则增强     
	ratio = me->query("dex") - ob->query("dex");
		
	dp = dp * (100 + ratio + 10) / 100;
	       
	if (ap / 2 + random(ap) < dp)
	{
		result = ([ "damage": -(damage * 3 / 4) ]);

		switch (random(6))
		{
		case 0:
			result += (["msg" : HIR "$N" HIR "眼睛一花，$n" HIR "已没了踪"
					    "影。突然$n" HIR "从身后拍了一下$N" HIR "的"
					    "头，轻轻跃开。"NOR"\n"]);
			break;
		case 1:
			result += (["msg" : HIR "$N" HIR "眼前一花，似乎见到$n" HIR "身"
					    "形一晃，但随即又见$n" HIR "回到原地，却似"
					    "从未离开。"NOR"\n"]);
			break;
		case 2:
			result += (["msg" : HIR "$n" HIR "身形飘忽，有如鬼魅，转了几转"
					    "，移步到$N" HIR "的身后，躲过了$N" HIR "这"
					    "一招。"NOR"\n"]);
			break;
		case 3:
			result += (["msg" : HIR "$n" HIR "嫣然一笑，诡异之极，$N" 
					    HIR "竟不知如何是好，停住了攻击。"NOR"\n"]);
			break;
		case 4:
			result += (["msg" : HIR "$n" HIR "右手伸出，在$N" HIR "手腕上"
					    "迅速无比的一按，顺势跳到一旁。"NOR"\n"]);
			break;			
		default:
			result += (["msg" : HIR "突然之间白影急晃，$n" HIR "向后滑出丈"
					    "余，立时又回到了原地，躲过了$N" HIR "这一"
					    "招。"NOR"\n"]);
			break;
		}
		return result;
	} else
	if (mp >= 100)
	{
		switch (random(4))
		{
		case 0:
			result = HIY "$N" HIY "眼睛一花，$n" HIY "已没了踪影"
				 "。可是$N" HIY "精通易理，丝毫不为所乱，尽自"
				 "出招。"NOR"\n";
			break;
		case 1:
			result = HIY "$N" HIY "眼前一花，似乎见到$n" HIY "身"
				 "形一晃。$N" HIY "一声冷笑，已瞬间看破招中虚"
				 "实。"NOR"\n";
			break;
		case 2:
			result = HIY "$n" HIY "身形飘忽，有如鬼魅，转了几转，"
				 "可是$N" HIY "理也不理，连续数招径直攻出。"NOR"\n";
			break;
		default:
			result = HIY "突然间白影急晃，$n" HIY "向后滑出丈余，"
				 "可是$N" HIY "不假思索，追身攻上，更是巧妙无"
				 "方。"NOR"\n";
			break;
		}
		COMBAT_D->set_bhinfo(result);
	} 
} 

int query_effect_dodge(object attacker, object me)
{
	int lvl;
	
	if (! me->query("special_skill/ghost"))
		return 0;

	lvl = me->query_skill("pixie-jian", 1);
	if (lvl < 50)  return 0;
	if (lvl < 100) return 30;
	if (lvl < 150) return 40;
	if (lvl < 200) return 60;
	if (lvl < 250) return 80;
	if (lvl < 300) return 100;
	if (lvl < 350) return 120;
	return 130;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	if (random(10) >= 5  && me->query("special_skill/ghost"))
	{
		if (random(3))
		{
			victim->receive_wound("qi", damage_bonus / 4, me);
			return HIR "只见" + victim->name() +
			       HIR "不寒而栗，身上数处地方渗出血丝！"NOR"\n";
		}
		else
		{
			victim->receive_wound("qi", damage_bonus / 3, me);
			victim->receive_wound("jing", damage_bonus / 4, me);
			return HIR "只见" + victim->name() +
			       HIR "神情恍惚，鲜血从身上数个穴位渗出！"NOR"\n";
		}
	}
}

int practice_skill(object me)
{
    	return notify_fail("辟邪剑法只能通过研习《辟邪剑谱》或《葵花"
			   "宝典》来学习。\n");
}

string perform_action_file(string action)
{
    	return __DIR__"pixie-jian/perform/" + action;
}

int difficult_level()
{
     object me; 
     int lv;
     me = this_player(); 
     lv = me->query_skill("pixie-jian", 1) - 180; 
     if (lv > 200) lv = 200; 
     
     if (! me->query("special_skill/ghost"))
	return 1000;
     else
	return 500 - lv;

}

string exert_function_file(string action)
{
	return __DIR__"pixie-jian/exert/" + action;
}


string query_description()
{
    string msg;

    msg = HIY "【辟邪剑法】" ZJBR ZJBR NOR;
    msg += WHT "源自《葵花宝典》的奇门剑法，以快、准、狠著称。招式诡异绝伦，身法迅捷如鬼魅。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  必须为 无性之人。" ZJBR;
    msg += "  此限制无法通过常规途径绕过。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功 (force)。" ZJBR;
    msg += "  剑法 (sword)。" ZJBR;
    msg += "  拳脚 (unarmed)。" ZJBR;
    msg += "  轻功 (dodge)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  无法通过练习 (practice) 或学习 (learn) 提升。" ZJBR;
    msg += "  只能通过研习《辟邪剑谱》或《葵花宝典》提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  " HIW "内力提升：" NOR "基于辟邪剑法等级提升内力上限，" HIR "领悟鬼脉" NOR "后效果增强 (" HIW "`query_neili_improve`" NOR ")。" ZJBR;
    msg += "  " HIW "鬼魅身法：" NOR HIR "领悟鬼脉" NOR "后，提升轻功有效等级 (" HIW "`query_effect_dodge`" NOR ")，辟邪剑法等级越高，提升越多。" ZJBR;
    msg += "  " HIW "完全闪避：" NOR "当辟邪剑法等级超过 " HIY "100" NOR " 级，激发内功、轻功、招架均为辟邪剑法，且拥有" HIR "领悟鬼脉" NOR "天赋时，有较高几率完全闪避敌人的物理攻击 (" HIW "`valid_damage`" NOR ")。" ZJBR;
    msg += "    - 闪避几率基于双方 (轻功激发等级 + 算术) vs (自身轻功激发等级 / 2 + 辟邪剑法等级)，并受双方先天身法差值修正。" ZJBR;
    msg += "  " HIW "阴损攻击：" NOR HIR "领悟鬼脉" NOR "后，普通攻击命中时有 " HIY "50%" NOR " 几率附加额外效果 (" HIW "`hit_ob`" NOR ")：" ZJBR;
    msg += "    - 随机造成目标气血损伤 (伤害奖励 / 4) 或 气血+精神损伤 (伤害奖励 / 3 + 伤害奖励 / 4)。" ZJBR;
    msg += "  " HIW "双重攻击：" NOR "可能触发双重攻击效果 (" HIW "`double_attack`" NOR ")，具体机制由战斗核心决定。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (perform)〗" ZJBR NOR;
    msg += HIC "  葵花三式 (kuihua)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      辟邪剑法等级 " HIY "200" NOR " 级。" ZJBR;
    msg += "      必须" HIR "领悟鬼脉" NOR " (`special_skill/ghost`)。" ZJBR;
    msg += "      激发内功为辟邪剑法。" ZJBR;
    msg += "      最大内力 " HIB "2500" NOR " 点。" ZJBR;
    msg += "      当前内力 " HIB "1000" NOR " 点。" ZJBR;
    msg += "    效果描述：复合型多段攻击，包含以下阶段，效果依次判定：" ZJBR;
    msg += "      1. " HIC "刺目：" NOR "判定基于双方内功激发等级。成功则造成伤害 (辟邪剑法等级 + 剑法激发等级 / 2，再取半值 + 随机半值)，附加气血损伤 (伤害 / 2)，使目标" HIR "失明" NOR " (持续 5 + 随机(辟邪剑法等级 / 25) 秒)。" ZJBR;
    msg += "      2. " HIM "缴械：" NOR "若目标持有武器且随机判定 (33%) 成功，判定基于 (使用者内功等级 / 3 + 随机(使用者内功等级)) vs 目标内功激发等级。成功则打落目标武器。" ZJBR;
    msg += "      3. " HIR "忙乱：" NOR "若目标未忙乱且随机判定 (50%) 成功，判定基于双方内功激发等级。成功则使目标" HIR "忙乱" NOR " (持续 使用者内功等级 / 22 + 2 秒)。" ZJBR;
    msg += "      4. " HIG "背刺：" NOR "判定基于双方内功激发等级。成功则造成空手伤害 (使用者内功等级 / 2 + 随机(使用者内功等级))，附加 60% 额外伤害。" ZJBR;
    msg += "      5. " CYN "破防/破功/散功：" NOR "判定基于 (使用者内功等级 / 4 + 随机(使用者内功等级)) vs 目标内功激发等级，且随机判定 (50%) 成功。尝试按顺序施加一种效果：降低目标有效护甲 (若有 `shield`)，降低目标攻防 (若有 `powerup`)，或吸取目标内力 (使用者内功等级 * 2) 并可能附加数秒内无法运功 (`no_exert`) 的状态。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      初始消耗内力 " HIB "100" NOR " 点，每个成功阶段额外消耗 " HIB "100-150" NOR " 点内力。" ZJBR;
    msg += "      自身" HIR "忙乱" NOR " 1 秒，每个成功阶段增加 1 秒，每个失败阶段增加 随机(3) 秒。" ZJBR ZJBR;

    msg += HIC "  鬼魅身法 (gui)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      辟邪剑法等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      判定基于 (使用者辟邪剑法等级 * 2) vs 目标招架激发等级。" ZJBR;
    msg += "      成功则使目标" HIR "忙乱" NOR " (持续 使用者辟邪剑法等级 / 45 + 2 秒)。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      无内力消耗。" ZJBR;
    msg += "      若失败，自身" HIR "忙乱" NOR " 1 秒。" ZJBR ZJBR;

    msg += HIC "  群邪辟易 (pi)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      辟邪剑法等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      装备剑/针类武器，或空手激发辟邪剑法。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      临时提升攻击力 (辟邪剑法等级 / 8，若" HIR "领悟鬼脉" NOR "且随机判定 (50%) 成功则再 * 4)。" ZJBR;
    msg += "      发动多次 (`COMBAT_D->query_base_attack_number`) 攻击。" ZJBR;
    msg += "      每次攻击有几率 (33%，若" HIR "领悟鬼脉" NOR "且随机判定 (50%) 成功则为 100%) 使目标" HIR "忙乱" NOR " 1 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      自身" HIR "忙乱" NOR " (若" HIR "领悟鬼脉" NOR "且随机判定 (50%) 成功则为 1 + 随机(4) 秒，否则为 1 + 随机(7) 秒)。" ZJBR ZJBR;

    msg += HIC "  葵花刺目 (cimu)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      辟邪剑法等级 " HIY "80" NOR " 级。" ZJBR;
    msg += "      最大内力 " HIB "400" NOR " 点。" ZJBR;
    msg += "      当前内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      判定基于 随机(使用者内功激发等级) vs (目标内功激发等级 / 2)。" ZJBR;
    msg += "      成功则造成伤害 (辟邪剑法等级 + 剑法激发等级 / 2，再取半值 + 随机半值)，附加气血损伤 (伤害 / 2)，使目标" HIR "失明" NOR " (持续 2 + 随机(辟邪剑法等级 / 25) 秒)。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      若成功，消耗内力 (伤害 / 5) 点。" ZJBR;
    msg += "      自身" HIR "忙乱" NOR " 2 秒。" ZJBR ZJBR;


    msg += HIY "〖特殊运用 (exert)〗" ZJBR NOR;
    msg += HIC "  葵花心法 (kuihua)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      辟邪剑法等级 " HIY "80" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "30" NOR " 点。" ZJBR;
    msg += "      当前精力 大于 (45 - 先天悟性，最低 5) 点。" ZJBR;
    msg += "      非战斗状态，且不在禁战区域。" ZJBR;
    msg += "      实战经验允许提升基本轻功。" ZJBR;
    msg += "      基本轻功等级低于辟邪剑法等级。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升 基本轻功 (dodge) 熟练度 (1 + 随机(先天悟性))。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 (20 + 随机(10)) 点，消耗精力 (45 - 先天悟性，最低 5) 点。" ZJBR;
    msg += "      自身" HIR "忙乱" NOR " 随机(3) 秒。" ZJBR ZJBR;

    msg += HIC "  邪气冲天 (powerup)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      辟邪剑法等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      未处于运功 (`powerup`) 状态。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升自身攻击力 (内功激发等级 / 3) 和 轻功有效等级 (内功激发等级 * 2 / 5)。" ZJBR;
    msg += "      效果持续 (内功激发等级) 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      若在战斗中使用，自身" HIR "忙乱" NOR " 3 秒。" ZJBR ZJBR;

    msg += HIC "  邪气护体 (shield)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      辟邪剑法等级 " HIY "50" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      未处于护体 (`shield`) 状态。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升自身有效护甲 (内功激发等级) 点。" ZJBR; //  `apply/armor` + `apply/armor1` (skill/2)
    msg += "      效果持续 (内功激发等级) 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      若在战斗中使用，自身" HIR "忙乱" NOR " 2 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 辟邪剑法许多特效和招式依赖特殊天赋" HIR "【领悟鬼脉】" NOR "才能发挥最大威力。" ZJBR;
    msg += "2. 学习和使用辟邪剑法具有极高的风险和苛刻的条件。" ZJBR;

    return msg;
}