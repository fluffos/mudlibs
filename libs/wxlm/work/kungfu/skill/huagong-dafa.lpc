// huagong-dafa.c 化灵大法
// by yucao
// Modified by Venus Oct.1997



inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_force(string force)
{
	return 1;
}

int query_neili_improve(object me)
{
	int lvl;

	lvl = (int)me->query_skill("huagong-dafa", 1);
	return lvl * lvl * 15 * 10 / 100 / 200;
}

int valid_learn(object me)
{
	if (me->query("character") == "光明磊落")
		return notify_fail("你心中暗想：我为人光明磊落，岂能学习这种害人武功？\n");

	if (me->query("character") == "狡黠多变")
		return notify_fail("你心中暗想：我虽然不是谦谦君子，但这种损人不利己的武功学来何用？\n");

	if ((int)me->query_skill("force", 1) < 80)
		return notify_fail("你的基本内功火候不足，不能学化灵大法。\n");

	if ((int)me->query_skill("poison", 1) < 40)
		return notify_fail("你的基本毒技火候不足，不能学化灵大法。\n");

	if (me->query("gender") == "无性" && (int)me->query_skill("huagong-dafa", 1) > 99)
		return notify_fail("你无根无性，阴阳不调，难以领会高深的化灵大法。\n");

	if ((int)me->query_skill("poison", 1) < 300 &&
	    (int)me->query_skill("poison", 1) < (int)me->query_skill("huagong-dafa", 1))
		return notify_fail("你的基本毒技水平有限，不能领会更高深的化灵大法。\n");

	if ((int)me->query_skill("force", 1) < (int)me->query_skill("huagong-dafa", 1))
		return notify_fail("你的基本内功水平有限，不能领会更高深的化灵大法。\n");

	return ::valid_learn(me);
}

string query_txt()
{
	return "要求：基本毒功40，基本内功80，基本毒功300之前化工大法不能高于毒功，光明磊落和狡黠多变性格不能学习"ZJBR
	"特效：化解攻击者内力加力伤害，对比自身内功激发和攻击者内功激发，同激发等级1/2概率触发，不受其他特殊技能克制";
}

mixed valid_damage(object ob, object me, int damage, object weapon)
{
	mapping result;
	int ap, dp;
	int jiali;
	int chance;

	if ((int) me->query_skill("huagong-dafa", 1) < 80 ||
	    ! living(me))
		return;

	if ((jiali = ob->query("jiali")) < 1)
		return;

	ap = ob->query_skill("force");
	dp = me->query_skill("force");
	if (ap / 2 + random(ap) < dp)
	{
		result = ([ "damage" : -(damage * 3 / 4) ]);

		switch (random(3))
		{
		case 0:
			result += ([ "msg" : HIM "$N" HIM "只觉得内力源源而泄"
					     "，不由得大吃一惊。"NOR"\n" ]);
			break;
		case 1:
			result += ([ "msg" : HIM "$N" HIM "只觉得发出的内力犹"
					     "如石沉大海，不知所踪。"NOR"\n" ]);
			break;

		default:
			result += ([ "msg" : HIM "$N" HIM "不住催动内力，但是"
					     "只觉得$n" HIM "竟似毫不费力。"NOR"\n" ]);
			break;
		}
		return result;
	}

	// 增加毒性反噬效果
	chance = me->query_skill("huagong-dafa", 1) / 2;
	if (random(100) < chance)
	{
		result = ([ "damage" : -damage ]);
		result += ([ "msg" : HIG "$N" HIG "只觉手上一麻，似乎被什么东西刺了一下，浑身顿感不适！\n" NOR ]);
		ob->affect_by("huagong_poison", ([
			"level" : me->query_skill("poison", 1),
			"id": me->query("id"),
			"duration" : me->query_skill("huagong-dafa", 1) / 20
		]));
		return result;
	}
}

int practice_skill(object me)
{
	return notify_fail("化灵大法只能用学(learn)或练毒的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"huagong-dafa/" + func;
}


/**
 * @brief 查询化功大法的详细信息
 * @return string 技能描述信息
 * @details 返回化功大法的详细介绍，包括基本介绍、学习要求、激发类型、练习要求、被动效果和特殊招式。
 */
string query_description()
{
    string msg;

    msg = HIY "【化功大法】" ZJBR NOR;
    msg += WHT "化功大法乃星宿派的独门阴毒内功，能吸取他人内力，化解攻击，并能施放奇毒。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  性格不可为光明磊落或狡黠多变。" ZJBR; // line 30, 33
    msg += "  基本内功等级 " HIY "80" NOR " 级。" ZJBR; // line 36
    msg += "  基本毒技等级 " HIY "40" NOR " 级。" ZJBR; // line 39
    msg += "  太监无法领悟 100 级以上化功大法。" ZJBR; // line 42
    msg += "  基本毒技等级 300 级前，化功大法等级不能超过基本毒技等级。" ZJBR; // line 45
    msg += "  化功大法等级不能超过基本内功等级。" ZJBR ZJBR; // line 50

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  内功（force）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  化功大法无法通过练习提升，需通过 `learn` 或练习毒技提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  提升内力上限：效果随化功大法等级提升。公式：(等级 * 等级 * 15 * 10 / 100 / 200)" ZJBR; // query_neili_improve
    msg += "  化解加力伤害 (valid_damage)：" ZJBR;
    msg += "    触发条件：化功大法等级 80 级以上，自身存活，攻击者有加力。" ZJBR; // line 67, 68
    msg += "    判定：攻击者 (内功激发等级 / 2 + 随机(内功激发等级)) < 自身 (内功激发等级) 时触发。" ZJBR; // line 74
    msg += "    效果：完全化解该次攻击的伤害。" ZJBR; // line 76
    msg += "  毒性反噬 (valid_damage)：" ZJBR;
    msg += "    触发条件：化解加力伤害判定未通过时。" ZJBR; // line 89
    msg += "    判定：(随机(100) < 化功大法等级 / 2) 时触发。" ZJBR; // line 90
    msg += "    效果：完全化解该次攻击的伤害，并使攻击者中 化功毒 (`huagong_poison`)。" ZJBR; // line 92, 94
    msg += "          中毒时间：(化功大法等级 / 20) 秒。" ZJBR ZJBR; // line 98

    msg += HIY "〖特殊招式 (exert)〗" ZJBR NOR; // exert_function_file
    msg += HIC "  提升功力 (powerup)" ZJBR NOR; // powerup.c
    msg += "    使用要求：" ZJBR;
    msg += "      化功大法等级 " HIY "60" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升自身攻击力 (`apply/attack`)，数值为 (化功大法等级 / 3)。" ZJBR;
    msg += "      效果持续时间为 (化功大法等级 / 50) 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR ZJBR;

    msg += HIC "  吸取内力 (hua)" ZJBR NOR; // hua.c
    msg += "    使用要求：" ZJBR;
    msg += "      化功大法等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      空手状态。" ZJBR;
    msg += "      战斗中使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      尝试吸取目标内力。" ZJBR;
    msg += "      成功率判定受双方化功大法与内功等级影响。" ZJBR;
    msg += "      成功吸取内力量：(自身化功大法等级 + 自身内功激发等级) / 10 + 随机(50)。目标减少等量内力，但不超过其现有内力。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点，精神 " HIM "10" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  化功毒砂 (dusha)" ZJBR NOR; // dusha.c
    msg += "    使用要求：" ZJBR;
    msg += "      化功大法等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "400" NOR " 点。" ZJBR;
    msg += "      空手状态。" ZJBR;
    msg += "      战斗中使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标造成毒性伤害。" ZJBR;
    msg += "      命中判定：自身 (内功激发等级 / 2 + 随机(内功激发等级)) > 目标 (内功激发等级)。" ZJBR;
    msg += "      命中后伤害：造成 (自身内功激发等级 + 自身基本毒技等级) 的内伤。" ZJBR;
    msg += "      命中后附加状态：目标中 化功毒 (`huagong_poison`)，持续时间 (化功大法等级 / 10) 秒；目标内力减少 (伤害值 / 2)。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "2 - 4" NOR " 秒 (随机)。" ZJBR ZJBR;

    msg += HIC "  弹射毒药 (tan)" ZJBR NOR; // tan.c
    msg += "    使用要求：" ZJBR;
    msg += "      化功大法等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      基本毒技等级 " HIY "80" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "500" NOR " 点。" ZJBR;
    msg += "      手中需持有 (`hand`) 毒药。" ZJBR;
    msg += "      非比武场景。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      将手中持有的毒药弹射向目标。" ZJBR;
    msg += "      初步判定：自身 (内力 / 2 + 随机(内力)) < 目标 (内力 * 5 / 4) (对NPC减半) 则失败。" ZJBR;
    msg += "      躲闪判定：(自身基本毒技等级 / 2 + 自身内功激发等级) / 2 + 随机(判定值) < 目标 (轻功激发等级 * 3 / 2) (对NPC减半) 则被闪避。" ZJBR;
    msg += "      命中效果：目标中该毒药的毒 (`affect_by(毒药类型, 毒药效果)`)。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      消耗持有的毒药。" ZJBR;
    msg += "      自身忙乱 " HIR "2 - 4" NOR " 秒 (随机)。" ZJBR;
    msg += "      会主动攻击目标。" ZJBR ZJBR;

    // 原文档中的【注意事项】非标准格式，已移除

    return msg;
}

