// 无名刀法

inherit SKILL;

mapping *action = ({
([      "action" : "$N手中$w一抖，一招「无名斩」直劈$n的$l",
        "force" : 120,
        "attack": 40,
        "dodge" : 30,
        "parry" : 25,
        "damage": 60,
        "lvl"   : 0,
        "skill_name" : "无名斩",
        "damage_type" : "割伤"
]),
([      "action" : "$N身形一转，一式「匿影藏刃」，$w无声无息地斩向$n的$l",
        "force" : 140,
        "attack": 50,
        "dodge" : 35,
        "parry" : 30,
        "damage": 80,
        "lvl"   : 40,
        "skill_name" : "匿影藏刃",
        "damage_type" : "割伤"
]),
([      "action" : "$N猛然跃起，一招「天外飞刃」，$w带着呼啸声从天而降，直取$n",
        "force" : 180,
        "attack": 60,
        "dodge" : 40,
        "parry" : 35,
        "damage": 100,
        "lvl"   : 80,
        "skill_name" : "天外飞刃",
        "damage_type" : "割伤"
]),
});

int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

int valid_learn(object me)
{
    if (me->query("family/family_name"))
        return notify_fail("无名刀法只有无门无派的人才能学习。\n");
        
    if ((int)me->query("max_neili") < 100)
        return notify_fail("你的内力不够。\n");

    if ((int)me->query_skill("force") < 30)
        return notify_fail("你的内功火候太浅。\n");

    if ((int)me->query_skill("blade", 1) < (int)me->query_skill("wuming-blade", 1))
        return notify_fail("你的基本刀法水平有限，无法领会更高深的无名刀法。\n");

    return 1;
}

string query_skill_name(int level)
{
    int i;
    for (i = sizeof(action) - 1; i >= 0; i--)
        if (level >= action[i]["lvl"])
            return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    int i, level;
    level = (int) me->query_skill("wuming-blade", 1);
    for (i = sizeof(action); i > 0; i--)
        if (level > action[i-1]["lvl"])
            return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
    object weapon;

    if (me->query("family/family_name"))
        return notify_fail("无名刀法只有无门无派的人才能练习。\n");

    if (!objectp(weapon = me->query_temp("weapon")) || 
        (string)weapon->query("skill_type") != "blade")
        return notify_fail("你使用的武器不对。\n");

    if ((int)me->query("qi") < 50)
        return notify_fail("你的体力不够练无名刀法。\n");

    if ((int)me->query("neili") < 50)
        return notify_fail("你的内力不够练无名刀法。\n");

    me->receive_damage("qi", 45);
    me->add("neili", -40);
    return 1;
}

string perform_action_file(string action)
{
    return __DIR__"wuming-blade/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【无名刀法】" ZJBR NOR;
    msg += "一门神秘的刀法，据说由隐世高人所创，招式奇诡难测。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  无门无派。" ZJBR;
    msg += "  最大内力 (" HIB "max_neili" NOR ") 需达到 " HIB "100" NOR " 点。" ZJBR;
    msg += "  内功有效激发 (" HIY "force" NOR ") 等级需达到 " HIY "30" NOR " 级。" ZJBR;
    msg += "  基本刀法 (" HIY "blade" NOR ") 等级需大于等于无名刀法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  刀法（blade）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  无门无派。" ZJBR;
    msg += "  必须装备刀类武器。" ZJBR;
    msg += "  气血 (" HIR "qi" NOR ")：不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  内力 (" HIB "neili" NOR ")：不低于 " HIB "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "45" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "40" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform

    msg += HIC "  无名斩 (wuming)" ZJBR NOR;
    msg += "    冷却时间：8秒。" ZJBR;
    msg += "    使用要求：" ZJBR;
    msg += "      无名刀法等级 " HIY "50" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      激发刀法为无名刀法，且装备刀。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：若随机（自身刀法激发等级）> 对方轻功就覅等级 / 2 则命中。" ZJBR;
    msg += "      命中后对目标造成伤害，伤害值约为 无名刀法等级 + 随机(无名刀法等级)。" ZJBR;
    msg += "      并附加 (伤害值 / 3) 的气血伤势。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力 " HIB "100" NOR " 点，忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "50" NOR " 点，忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  匿影藏刃 (niying)" ZJBR NOR;
    msg += "    冷却时间：10秒。" ZJBR;
    msg += "    使用要求：" ZJBR;
    msg += "      无名刀法等级 " HIY "80" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "      激发刀法为无名刀法，且装备刀。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：使用 `通用命中公式` 判定，比较双方刀法激发等级。" ZJBR;
    msg += "      若命中，暂时提升自身攻击力，提升值为 (刀法激发等级 / 10)，效果持续本次连击。" ZJBR;
    msg += "      对目标发动多次普通攻击，攻击次数由 `COMBAT_D->query_base_attack_number()` 决定。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "      使用后忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  天外飞刃 (tianwai)" ZJBR NOR;
    msg += "    冷却时间：12秒。" ZJBR;
    msg += "    使用要求：" ZJBR;
    msg += "      无名刀法等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      激发刀法为无名刀法，且装备刀。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：使用 `通用命中公式` 判定，比较 自身(刀法激发等级+内功有效激发等级) 与 对方(轻功激发等级+招架激发等级)。" ZJBR;
    msg += "      命中后对目标造成伤害，伤害值约为 自身(刀法激发等级+内功有效激发等级) + 随机(自身(刀法激发等级+内功有效激发等级) / 2)。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力 " HIB "200" NOR " 点，忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "100" NOR " 点，忙乱 " HIR "3" NOR " 秒。" ZJBR;

    return msg;
}