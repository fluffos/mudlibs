
#include <combat.h>

#define CHAOSHENG "「" HIB "潮生潮灭" NOR "」"

inherit F_SSERVER;

string query_name() { return "潮生"ZJBR"潮灭"; }

int perform(object me, object target)
{
    object weapon;
    int damage;
    string msg;
    int ap, dp;

    if (! target) target = offensive_target(me);

    if (! target || ! me->is_fighting(target))
        return notify_fail(CHAOSHENG "只能对战斗中的对手使用。\n");

    if (! objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对，难以施展" CHAOSHENG "。\n");

    if ((int)me->query_skill("bihai_chaosheng", 1) < 80)
        return notify_fail("你的碧海潮生剑法不够娴熟，难以施展" CHAOSHENG "。\n");

    if (me->query_skill_mapped("sword") != "bihai_chaosheng")
        return notify_fail("你没有激发碧海潮生剑法，难以施展" CHAOSHENG "。\n");

    if ((int)me->query("neili") < 150)
        return notify_fail("你现在的真气不够，难以施展" CHAOSHENG "。\n");

    if (! living(target))
        return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

    msg = HIB "$N" HIB "轻吟剑诀，施展出「潮生潮灭」，手中" + weapon->name() + HIB "如潮水般汹涌而出，连绵不绝地攻向$n" HIB "！\n" NOR;

    ap = me->query_skill("sword") + me->query_skill("force");
    dp = target->query_skill("dodge") + target->query_skill("parry");

    if (COMBAT_D->hit_determination(me,target,ap,dp))
    {
        damage = ap + random(ap / 2);
        me->add("neili", -100);
        msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 50,
                                   HIB "$n" HIB "只觉得四面八方都是剑影，"
                                   "如同身处汪洋大海，被$N" HIB "的剑势所淹没，连连中招！\n" NOR);
        me->start_busy(2);
        if (ap / 3 + random(ap) > dp && ! target->is_busy())
            target->start_busy(ap / 200 + 2);
    } else
    {
        me->add("neili", -50);
        msg += CYN "可是$n" CYN "看破了$N" CYN "的剑路，巧妙地一个转身，堪堪避过。\n" NOR;
        me->start_busy(3);
    }
    message_combatd(msg, me, target);
    return 1;
}
