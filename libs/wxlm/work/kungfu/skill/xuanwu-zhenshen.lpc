// 玄武真身

inherit SKILL;

int valid_enable(string usage) { return usage == "parry"; }

int valid_learn(object me)
{
    if ((int)me->query("con") < 26)
        return notify_fail("你的根骨太差，无法领会玄武真身的奥妙。\n");

    if ((int)me->query("int") < 26)
        return notify_fail("你的悟性不足，难以理解玄武真身的精髓。\n");

    if ((int)me->query_skill("force") < 150)
        return notify_fail("你的内功火候不够，难以修习玄武真身。\n");

    if ((int)me->query("max_neili") < 1500)
        return notify_fail("你的内力还不足以修习玄武真身。\n");

    if ((int)me->query_skill("sixiang-shengong", 1) < 100)
        return notify_fail("你的四象神功火候不够，无法修习玄武真身。\n");

    return 1;
}

mixed valid_damage(object ob, object me, int damage, object weapon)
{
    int ap, dp;
    int recover;
    
    if ((int)me->query_skill("xuanwu-zhenshen", 1) < 100 || 
        ! living(me))
        return;
    
    ap = ob->query_skill("parry");
    dp = me->query_skill("parry");
    
    if (dp > ap)
    {
        recover = damage / 5;  // 恢复受到伤害的20%
        me->add("neili", recover);
        if (me->query("neili") > me->query("max_neili"))
            me->set("neili", me->query("max_neili"));
        
        tell_object(me, HIB "你的玄武真身发动，吸收了部分攻击，转化为内力！\n" NOR);
        tell_object(ob, HIB "只见" + me->name() + "似乎吸收了你的攻击，转化为内力！\n" NOR);
    }
    
    return;
}

int query_effect_parry(object attacker, object me)
{
    int lvl;

    lvl = me->query_skill("xuanwu-zhenshen", 1);
    if (lvl < 100) return 0;
    if (lvl < 150) return 50;
    if (lvl < 200) return 60;
    if (lvl < 250) return 70;
    if (lvl < 300) return 80;
    if (lvl < 350) return 90;
    if (lvl < 400) return 100;
    return 120;
}

int practice_skill(object me)
{
    if (me->query_skill("xuanwu-zhenshen", 1) < 100)
        return notify_fail("你对玄武真身的了解还不够，还不足以自行锻炼。\n");

    if ((int)me->query("qi") < 70)
        return notify_fail("你的体力太低了。\n");

    if ((int)me->query("neili") < 100)
        return notify_fail("你的内力不够练玄武真身。\n");

    me->receive_damage("qi", 60);
    me->add("neili", -85);
    return 1;
}

string perform_action_file(string action)
{
    return __DIR__"xuanwu-zhenshen/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【玄武真身】" ZJBR NOR;
    msg += WHT "玄武真身是四象门的镇派防御心法，以坚韧不拔著称。修炼者能将敌人的攻击化为己用，吸收部分伤害并转化为内力，是一门极其精妙的防御功法。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  后天根骨：不低于 " HIR "26" NOR " 点。" ZJBR;
    msg += "  后天悟性：不低于 " HIR "26" NOR " 点。" ZJBR;
    msg += "  内功有效激发等级：不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "  最大内力：不低于 " HIB "1500" NOR " 点。" ZJBR;
    msg += "  四象神功等级：不低于 " HIY "100" NOR " 级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  玄武真身等级：不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "  气血：不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "85" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  招架伤害转化：当玄武真身等级不低于100级，且自身招架等级高于攻击者时触发。" ZJBR;
    msg += "  触发判定：自身基本招架等级 > 攻击者基本招架等级。" ZJBR;
    msg += "  效果：将受到伤害的20%（伤害值 / 5）转化为内力。" ZJBR;
    msg += "  注意：转化的内力不会超过最大内力上限。" ZJBR ZJBR;

    msg += "  招架效果加成：根据玄武真身等级提供不同的招架效果加成。" ZJBR;
    msg += "    玄武真身100-149级：加成 " HIY "50" NOR " 点。" ZJBR;
    msg += "    玄武真身150-199级：加成 " HIY "60" NOR " 点。" ZJBR;
    msg += "    玄武真身200-249级：加成 " HIY "70" NOR " 点。" ZJBR;
    msg += "    玄武真身250-299级：加成 " HIY "80" NOR " 点。" ZJBR;
    msg += "    玄武真身300-349级：加成 " HIY "90" NOR " 点。" ZJBR;
    msg += "    玄武真身350-399级：加成 " HIY "100" NOR " 点。" ZJBR;
    msg += "    玄武真身400级以上：加成 " HIY "120" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  玄武护体 (huti)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      玄武真身等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      四象神功等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      激发招架为玄武真身。" ZJBR;
    msg += "      未处于玄武护体状态。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      运转玄武真身，周身真气流转，形成一道无形的防护罩，提升防御力。" ZJBR;
    msg += "      防御加成：玄武真身等级 / 2 点护甲值。" ZJBR;
    msg += "      持续时间：等同于玄武真身等级（秒）。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      若处于战斗中，使用后自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 玄武真身只能用于招架，不可用于攻击。" ZJBR;
    msg += "2. 需达到100级以上才能自行练习。" ZJBR;
    msg += "3. 玄武护体同一时间只能使用一次，需等前一次效果结束后才能再次使用。" ZJBR;
    msg += "4. 修炼此功法与四象神功配合使用效果最佳。\n";

    return msg;
}
