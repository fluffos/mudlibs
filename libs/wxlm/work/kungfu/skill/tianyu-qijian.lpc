int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me)
{
	if (me->query_skill("force") < 40)
		return notify_fail("你的内功火候不够，不能学习天羽奇剑。\n");

	if (me->query("max_neili") < 200)
		return notify_fail("你的内力不够，不能学习天羽奇剑。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("tianyu-qijian",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力不够练天羽奇剑。\n");

	if ((int)me->query("neili") < 40)
		return notify_fail("你的内力不够练天羽奇剑。\n");

	me->receive_damage("qi", 40);
	me->add("neili", -25);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"tianyu-qijian/" + action;
}

string query_description()
{
    string msg;

    msg = HIC "【天羽奇剑】" ZJBR NOR;
    msg += "天羽奇剑是一门威力强大，变化灵动的剑法，剑势如流星闪电，迅捷无比。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  有效内功激发 " HIY "40" NOR " 级以上。" ZJBR;
    msg += "  最大内力 " HIB "200" NOR " 点以上。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  剑法（sword）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  需持剑。" ZJBR;
    msg += "  气血：不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "40" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "40" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "25" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // hit_ob, valid_damage, skill_improved etc.
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform/exert

    msg += HIC "  闪剑诀 (jue)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      天羽奇剑等级 " HIY "60" NOR " 级以上。" ZJBR;
    msg += "      有效内功等级 " HIY "90" NOR " 级以上。" ZJBR;
    msg += "      当前内力 " HIB "300" NOR " 点以上。" ZJBR;
    msg += "      激发剑法为天羽奇剑。" ZJBR;
    msg += "      必须手持兵器且在战斗中对敌人使用。" ZJBR;
    msg += "      对方未处于忙乱状态。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      手腕一探，使出一道疾电般的剑光攻向对手，令其忙乱。" ZJBR;
    msg += "      命中判定：使用 COMBAT_D->hit_determination 进行命中判定，" ZJBR;
    msg += "                以自身基本剑法等级 对抗 目标基本招架等级。" ZJBR;
    msg += "      效果判定：若命中，使对方忙乱（天羽奇剑等级 / 23 + 1）秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      发动消耗：内力 " HIB "70" NOR " 点。" ZJBR;
    msg += "      命中时：无额外消耗。" ZJBR;
    msg += "      未命中：额外消耗内力 " HIB "100" NOR " 点，自身忙乱 " HIR "1" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  清思剑 (qing)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      天羽奇剑等级 " HIY "70" NOR " 级以上。" ZJBR;
    msg += "      有效内功等级 " HIY "100" NOR " 级以上。" ZJBR;
    msg += "      当前内力 " HIB "300" NOR " 点以上。" ZJBR;
    msg += "      激发剑法为天羽奇剑。" ZJBR;
    msg += "      必须手持兵器且在战斗中对敌人使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      手腕轻抖，使剑化作彩虹，凝聚剑气刺向敌人要害。" ZJBR;
    msg += "      命中判定：随机值(自身有效内功等级) > 目标有效内功等级的一半。" ZJBR;
    msg += "      伤害计算：基本伤害 = 基本剑法等级的一半 + 随机(基本剑法等级的一半)。" ZJBR;
    msg += "                最终伤害由 COMBAT_D->do_damage 函数计算，伤害系数为35%。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力 " HIB "120" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "100" NOR " 点，自身忙乱 " HIR "4" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  天女散花 (san)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      天羽奇剑等级 " HIY "100" NOR " 级以上。" ZJBR;
    msg += "      有效内功等级 " HIY "100" NOR " 级以上。" ZJBR;
    msg += "      当前内力 " HIB "300" NOR " 点以上。" ZJBR;
    msg += "      激发剑法为天羽奇剑。" ZJBR;
    msg += "      必须手持兵器且在战斗中对敌人使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      凝神息气，手腕疾抖，挽出千万个剑花连续攻击对手。" ZJBR;
    msg += "      此招会对目标进行多次连续攻击，攻击次数由 COMBAT_D->query_base_attack_number 决定。" ZJBR;
    msg += "      每次攻击为普通攻击，伤害随命中次数叠加。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      发动消耗：内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      使用后自身忙乱 " HIR "1-5" NOR " 秒。" ZJBR;

    return msg;
}

