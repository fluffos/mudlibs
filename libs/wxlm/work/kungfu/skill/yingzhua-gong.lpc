int valid_enable(string usage) { return usage == "claw" || usage == "parry"; }

int valid_combine(string combo) { return combo == "fengyun-shou"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练鹰爪功必须空手。\n");

	if ((int)me->query_skill("force") < 50)
		return notify_fail("你的内功火候不够，无法学鹰爪功。\n");

	if ((int)me->query("max_neili") < 250)
		return notify_fail("你的内力太弱，无法练鹰爪功。\n");

	if ((int)me->query_skill("claw", 1) < (int)me->query_skill("yingzhua-gong", 1))
		return notify_fail("你的基本抓法火候水平有限，无法领会更高深的鹰爪功。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("yingzhua-gong",1);
	for(i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	if (me->query_temp("weapon") ||
	    me->query_temp("secondary_weapon"))
		return notify_fail("你必须空手练习！\n");

	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 70)
		return notify_fail("你的内力不够练鹰爪功。\n");

	me->receive_damage("qi", 60);
	me->add("neili", -67);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"yingzhua-gong/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【鹰爪功】" ZJBR NOR;
    msg += WHT "鹰爪功是一门以快速、凌厉著称的高级爪法，源自少林派。" ZJBR;
    msg += WHT "此功模仿苍鹰捕食动作，招式迅猛凶狠，攻击强劲有力。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功等级：" HIY "50" NOR " 级" ZJBR;
    msg += "  内力上限：" HIY "250" NOR " 点" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  爪法 (claw)" ZJBR;
    msg += "  招架 (parry)" ZJBR ZJBR;

    msg += HIY "〖配合武功〗" ZJBR NOR;
    msg += "  可与风云手互备增强攻击效果" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血消耗：" HIR "60" NOR " 点" ZJBR;
    msg += "  内力消耗：" HIB "67" NOR " 点" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  荡妖除魔 (chumo)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      鹰爪功 " HIY "135" NOR " 级" ZJBR;
    msg += "      当前内力 " HIB "250" NOR " 点" ZJBR;
    msg += "      鹰爪功已激发为爪法" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      看似平平无奇的一抓，却蕴含极强杀伤力" ZJBR;
    msg += "      攻击力(AP)计算：内功有效激发等级 + 爪法有效激发等级" ZJBR;
    msg += "      防御力(DP)计算：目标招架有效激发等级 + 目标轻功有效激发等级" ZJBR;
    msg += "      命中判定：AP > DP时判定成功" ZJBR;
    msg += "      伤害计算：damage = AP / 2 + random(AP / 4)" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中内力消耗：" HIB "200" NOR " 点" ZJBR;
    msg += "      未命中内力消耗：" HIB "40" NOR " 点" ZJBR;
    msg += "      命中后自身忙乱：" HIR "2" NOR " 秒" ZJBR;
    msg += "      未命中自身忙乱：" HIR "3" NOR " 秒" ZJBR ZJBR;

    msg += HIR "〖注意事项〗" ZJBR NOR;
    msg += "  鹰爪功需要灵活的手指和强健的臂力，练习时需重点锻炼这两方面" ZJBR;
    msg += "  实战中应善用鹰爪功迅猛特性，抢先制敌，避免缠斗" ZJBR;
    msg += "  特殊招式「荡妖除魔」威力虽大，但若未命中，自身会有较长忙乱时间" ZJBR;

    return msg;
}