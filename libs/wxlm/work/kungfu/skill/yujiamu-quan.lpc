int valid_enable(string usage) { return usage == "cuff" || usage == "parry"; }

int valid_combine(string combo)
{
	return combo=="dashou-yin" ||
	       combo=="huoyan-dao";
}

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练金刚瑜迦母拳必须空手。\n");

	if ((int)me->query("max_neili") < 600)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("force") < 100)
		return notify_fail("你的内功火候不够。\n");

	if ((int)me->query_skill("cuff", 1) < (int)me->query_skill("yujiamu-quan",1))
		return notify_fail("你的基本拳法水平有限，无法领会更高深的金刚瑜迦母拳。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level   = (int) me->query_skill("yujiamu-quan",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
 

	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练金刚瑜迦母拳必须空手。\n");

	if ((int)me->query("qi") < 60)
		return notify_fail("你的体力不够，练不了金刚瑜迦母拳。\n");

	if ((int)me->query("neili") < 70)
		return notify_fail("你的内力不够，练不了金刚瑜迦母拳。\n");

	me->receive_damage("qi", 50);
	me->add("neili", -61);
	return 1;
}

string perform_action_file(string action)
{
       return __DIR__"yujiamu-quan/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【金刚瑜迦母拳】" ZJBR NOR;
    msg += WHT "密宗绝学，为护法金刚瑜迦母所创的无上拳法。" ZJBR;
    msg += WHT "拳力威猛，招式蕴含佛门真意，变化万千。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  有效内功 等级：" HIY "100" NOR " 级。" ZJBR;
    msg += "  最大内力 上限：" HIB "600" NOR " 点。" ZJBR;
    msg += "  基本拳法 等级：" HIY "不低于" NOR " 基本金刚瑜迦母拳 等级。" ZJBR;
    msg += "  必须空手。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  拳法 (cuff)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖组合武功〗" ZJBR NOR;
    msg += "  可与 " HIC "大手印 (dashou-yin)" NOR " 或 " HIR "火焰刀 (huoyan-dao)" NOR " 互备。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须空手。" ZJBR;
    msg += "  需要当前 气血 " HIC "60" NOR " 点以上，当前 内力 " HIB "70" NOR " 点以上。" ZJBR;
    msg += "  消耗 气血：" HIR "50" NOR " 点。" ZJBR;
    msg += "  消耗 内力：" HIB "61" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  佛嗔 (chen)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      基本金刚瑜迦母拳 等级：" HIY "100" NOR " 级。" ZJBR;
    msg += "      当前 内力 不低于 " HIB "180" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      发出一声怒喝，以蕴含无上忿怒之意的拳劲猛击对手。" ZJBR;
    msg += "      攻击力 ≈ (基本拳法等级 + 先天根骨 * 10)" ZJBR;
    msg += "      防御力 ≈ 目标有效轻功等级" ZJBR;
    msg += "      命中判定：随机(攻击力 * 1.5) > 防御力。" ZJBR;
    msg += "      基础伤害：(攻击力 + 随机(基本金刚瑜迦母拳等级)) 点。" ZJBR;
    msg += "      附加效果：若自身当前 气血 低于 最大气血 上限的一半，则最终伤害提升 50%。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗 内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      冷却时间 " HIR "2" NOR " 秒。" ZJBR;

    return msg;
}

