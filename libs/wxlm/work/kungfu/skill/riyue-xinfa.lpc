// riyue-xinfa.c 日月心法

inherit FORCE;

int valid_enable(string usage)
{
            return usage == "force";
}

int valid_force(string force)
{
        return force == "tianhuan-shenjue" ||
               force == "xixing-dafa" ||
               force == "yijinjing" ||
               force == "kuihua-mogong";
}

int valid_learn(object me)
{
            return ::valid_learn(me);
}

int practice_skill(object me)
{
            return notify_fail("日月心法只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
            return __DIR__"riyue-xinfa/" + func;
}
string query_description()
{
    string msg;

    msg = HIY "【日月心法】" ZJBR ZJBR NOR;
    msg += WHT "日月心法是日月神教的基础内功心法，以其阴阳调和、刚柔并济的特点著称。此功法讲究吸纳天地日月之精华，是修炼更高深内功的基础。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  无特殊要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功 (force)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  日月心法只能通过学习 (learn) 来提升等级。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  当前版本暂无特殊内功运用 (exert)。" ZJBR ZJBR;

    msg += HIY "〖其他信息〗" ZJBR NOR;
    msg += "  可兼容的内功：" ZJBR;
    msg += "    天寰神诀 (tianhuan-shenjue)" ZJBR;
    msg += "    吸星大法 (xixing-dafa)" ZJBR;
    msg += "    易筋经 (yijinjing)" ZJBR;
    msg += "    葵花魔功 (kuihua-mogong)" ZJBR;
    msg += "  练习时需谨慎控制内力运转，以免走火入魔。" ZJBR;

    return msg;
}
