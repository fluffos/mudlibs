// yaowang-mishu.c

inherit SKILL;

string type() { return "knowledge"; }

int valid_enable(string usage) { return usage == "medical"; }

int valid_learn(object me)
{
	if (me->query("family/family_name") != "关外胡家")
		return notify_fail("关外胡家的弟子才能学习该技能。\n");
	
	if ((int)me->query_skill("medical", 1) < 100)
		return notify_fail("你的基本医术造诣太浅，无"
				   "法领会深奥的药王妙术。\n");

	if ((int)me->query_skill("medical", 1) < (int)me->query_skill("yaowang-miaoshu", 1))
		return notify_fail("你的基本医术水平有限，无"
				   "法掌握更深奥的药王妙术。\n");

	return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【药王妙术】" ZJBR NOR;
    msg += WHT "药王妙术是关外胡家独门的医术绝学，集合了诊断、用药、针灸等多种医疗技巧。" ZJBR;
    msg += WHT "此医术精妙绝伦，能够治疗各种疑难杂症，被誉为'起死回生'的神技。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本医术等级：100级以上" ZJBR;
    msg += "  门派：关外胡家弟子" ZJBR;
    msg += "  特殊条件：基本医术等级须不低于药王妙术等级" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  医术 (medical)" ZJBR ZJBR;

    msg += HIY "〖技能类型〗" ZJBR NOR;
    msg += "  知识类技能 (knowledge)" ZJBR ZJBR;

    msg += HIY "〖医术特点〗" ZJBR NOR;
    msg += "  药王妙术集诊断、用药、针灸等多种医术于一身" ZJBR;
    msg += "  在治疗时，药王妙术的等级将影响治疗效果" ZJBR;
    msg += "  精通药王妙术者可医治常人难以治愈的奇难杂症" ZJBR ZJBR;

    msg += HIY "〖应用方向〗" ZJBR NOR;
    msg += "  治疗伤势" ZJBR;
    msg += "  解除毒素" ZJBR;
    msg += "  调理气息" ZJBR;

    msg += HIR "【练习消耗】" ZJBR NOR;
    msg += "每次练习需要消耗10点精力和10点内力" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 药王妙术需要深厚的医学理论基础,学习时需要不断提高基础医术水平。" ZJBR;
    msg += "2. 在实战中,药王妙术可以用来快速恢复自身或队友的状态。" ZJBR;
    msg += "3. 精通药王妙术的医者,在江湖中地位崇高,受人尊敬。" ZJBR;
    msg += "4. 药王妙术虽然效果显著,但也要注意因材施治,不可滥用。\n";

    return msg;
}