int valid_enable(string usage) { return usage=="parry" || usage=="strike"; }

int valid_combine(string combo) { return combo=="zhemei-shou"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练天山乾阳掌必须空手。\n");

	if ((int)me->query_skill("force") < 50)
		return notify_fail("你的内功火候不够，无法练六阳掌。\n");

	if ((int)me->query("max_neili") < 200)
		return notify_fail("你的内力太弱，无法练六阳掌。\n");

	if ((int)me->query_skill("strike", 1) < (int)me->query_skill("liuyang-zhang", 1))
		return notify_fail("你的基本掌法水平有限，无法领会更高深的天山乾阳掌。\n");

	return 1;
}

mapping query_action(object me, object weapon)
{
	int i, level;
	mapping act;

	level = me->query_skill("liuyang-zhang",1);

	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
		{
			act = copy(action[NewRandom(i, 20, level/5)]);
			return act;
		}
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力太低了。\n");
	if ((int)me->query("neili") < 70)
		return notify_fail("你的内力不够练天山乾阳掌。\n");

	me->receive_damage("qi", 61);
	me->add("neili", -57);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"liuyang-zhang/" + action;
}
string query_description()
{
    string msg;

    msg = HIY "【天山六阳掌】" ZJBR NOR;
    msg += "逍遥派高级掌法，此掌法威力极大，且招式中蕴含阴阳变化，极难防备。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  必须为空手状态。" ZJBR;
    msg += "  基本内功 (force) 等级不低于 " HIY "50" NOR " 级。" ZJBR;
    msg += "  最大内力不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "  基本掌法 (strike) 等级需大于等于天山六阳掌等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  掌法（strike）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖可组合武学〗" ZJBR NOR;
    msg += "  逍遥折梅手（zhemei-shou）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "61" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "57" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖招式列表〗" ZJBR NOR;
    msg += "  落日熔金 (0级)   ：造成瘀伤。" ZJBR;
    msg += "  安禅制毒龙 (20级) ：造成内伤。" ZJBR;
    msg += "  日斜归路晚霞明 (30级) ：造成瘀伤。" ZJBR;
    msg += "  阳关三叠 (40级)   ：造成瘀伤。" ZJBR;
    msg += "  阳春一曲和皆难 (60级) ：造成瘀伤。" ZJBR;
    msg += "  云霞出海曙 (80级)   ：造成瘀伤。" ZJBR;
    msg += "  白日参辰现 (100级) ：造成内伤。" ZJBR;
    msg += "  云霞出薛帷 (120级) ：造成瘀伤。" ZJBR;
    msg += "  青阳带岁除 (140级) ：造成瘀伤。" ZJBR;
    msg += "  阳歌天钧 (160级)   ：造成瘀伤。" ZJBR;
    msg += "  幻阳照雪 (200级) ：造成内伤。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;

    msg += HIR "  破神诀 (po)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      空手状态。" ZJBR;
    msg += "      八荒六合唯我独尊功 (bahuang-gong) 或 北冥神功 (beiming-shengong) 等级不低于 " HIY "220" NOR " 级。" ZJBR;
    msg += "      天山六阳掌等级不低于 " HIY "220" NOR " 级。" ZJBR;
    msg += "      最大内力不低于 " HIB "3500" NOR " 点。" ZJBR;
    msg += "      当前内力不低于 " HIB "800" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：攻击力 = (基本掌法攻击力 + 内功激发等级 + 「灵鹫飞羽」奥义等级 * 5)，防御力 = (目标招架防御力 + 目标内功激发等级)。" ZJBR;
    msg += "      命中判定：对善良阵营目标攻击力提升 " HIY "10%" NOR "。" ZJBR;
    msg += "      命中判定：对非玩家目标攻击力提升 " HIY "50%" NOR "。" ZJBR;
    msg += "      伤害计算：基础伤害 = (基本掌法伤害力 / 2) + (自身加力值)。" ZJBR;
    msg += "      伤害计算：每级「灵鹫飞羽」奥义额外增加 (基本掌法伤害力 / 6) 的伤害。" ZJBR;
    msg += "      伤害计算：每级「自由自在」奥义额外增加 (最终伤害 / 20) 的伤害。" ZJBR;
    msg += "      特殊效果：若使用者最大内力超过目标最大内力的2倍且目标非玩家，有几率直接秒杀目标。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "500" NOR " 点。" ZJBR;
    msg += "      命中则忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中则忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  九天式 (jiutian)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      天山六阳掌等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "      基本内功等级不低于 " HIY "250" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "      激发掌法为天山六阳掌。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：攻击力 = (内功激发等级)，防御力 = (目标内功激发等级)。对非玩家目标攻击力提升 " HIY "100%" NOR "。" ZJBR;
    msg += "      伤害计算：基础伤害 = (掌法激发等级 + 内功激发等级 - 目标内功激发等级)。" ZJBR;
    msg += "      伤害计算：额外伤害 = 随机(基础伤害 / 2)。" ZJBR;
    msg += "      伤害计算：最终伤害 = (基础伤害 + 额外伤害) * (100 + 先天悟性 + 后天悟性) / 100。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 " HIB "200" NOR " 点，忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：消耗内力 " HIB "80" NOR " 点，忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "  灰飞湮灭 (hui)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      空手状态。" ZJBR;
    msg += "      必须准备天山六阳掌为掌法，逍遥折梅手为手法。" ZJBR;
    msg += "      激发轻功为凌波微步 (lingbo-weibu) 或 激发内功为八荒六合唯我独尊功。" ZJBR;
    msg += "      当前内力不低于 (最大内力 / 35)。" ZJBR;
    msg += "      需要逍遥派或灵鹫宫门派身份，或转生前曾属该门派，否则威力减半。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：攻击力 = (掌法激发 + 招架激发等级)，防御力 = (目标招架激发 + 目标拳脚激发等级)。" ZJBR;
    msg += "      命中判定：对非玩家目标攻击力提升 " HIY "50%" NOR "。" ZJBR;
    msg += "      伤害计算：基础伤害 = (基本掌法伤害力 + 自身加力值)。" ZJBR;
    msg += "      伤害计算：伤害额外受后天膂力加成，公式：最终伤害 += (原伤害 / 400 * 后天膂力)。" ZJBR;
    msg += "      伤害计算：若激发内功为八荒六合唯我独尊功，伤害增加 " HIY "30%" NOR "。" ZJBR;
    msg += "      伤害计算：「自由自在」或「灵鹫飞羽」奥义等级中取较高者，每级提升最终伤害 " HIY "1%" NOR "。" ZJBR;
    msg += "      北冥特效（激发北冥神功或八荒功时判定）：" ZJBR;
    msg += "         有 ( 50 + 根本法等级 * 3.5，pvp中内功激发判定弱于敌方时减半)% 几率触发内力迸发，临时增加大量附加伤害（200%，离派减半）。" ZJBR;
    msg += "         命中后吸取目标内力，数值为 (北冥神功等级 - 目标护甲 / 10)。若目标内力不足，则扣除气血 (北冥神功等级 - 目标护甲 / 4)。" ZJBR;
    msg += "      忙乱规避：凌波微步等级达到 " HIY "500" NOR " 级时，有 " HIY "15%" NOR " 几率施展后不进入忙乱状态。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 (最大内力 / 40)。" ZJBR;
    msg += "      未命中：消耗内力 " HIB "1500" NOR " 点。" ZJBR;
    msg += "      命中则忙乱 " HIR "2" NOR " 秒（可能被凌波微步规避）。" ZJBR;
    msg += "      未命中则忙乱 " HIR "3" NOR " 秒（可能被凌波微步规避）。" ZJBR ZJBR;

    msg += CYN "  种生死符 (zhong)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      基本内功等级不低于 " HIY "200" NOR " 级。" ZJBR;
    msg += "      天山六阳掌等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      激发掌法为天山六阳掌。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：攻击力 = (掌法激发等级)，防御力 = (目标内功激发等级)。" ZJBR;
    msg += "      命中后对目标造成伤害，伤害值约为 (掌法激发等级 / 2 + 随机(掌法激发等级 / 2))。" ZJBR;
    msg += "      命中后给目标种上生死符 (ss_poison) 状态。" ZJBR;
    msg += "      状态强度：(自身加力值 + 随机(自身加力值))。" ZJBR;
    msg += "      状态持续时间：(掌法激发等级 / 70 + 随机(掌法激发等级 / 30)) 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中则忙乱 (1 + 随机(4)) 秒。" ZJBR;
    msg += "      未命中则忙乱 " HIR "3" NOR " 秒。" ZJBR;

    return msg;
}
