int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me)
{
	if ((int)me->query_skill("force") < 60)
		return notify_fail("你的内功火候不到，无法学习玄霄十三剑。\n");

	if ((int)me->query("neili") < 300)
		return notify_fail("你的内力太差，无法学习玄霄十三剑。\n");

	if (me->query_skill("sword", 1) < me->query_skill("shenmen-jian", 1))
		return notify_fail("你的基本剑法水平有限，无法领会更高深的玄霄十三剑。\n");

	return 1;
}

mapping query_action(object me, object weapon)
{
	int i, level;  
	level = (int) me->query_skill("shenmen-jian", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];

}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 65)
		return notify_fail("你的体力不够练玄霄十三剑。\n");

	if ((int)me->query("neili") < 65)
		return notify_fail("你的内力不足以练玄霄十三剑。\n");

	me->receive_damage("qi", 52);
	me->add("neili", -58);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"shenmen-jian/" + action;
}


string query_description()
{
    string msg;

    msg = HIY "【神门十三剑】" ZJBR ZJBR NOR;
    msg += WHT "一门专攻敌人手腕神门要穴的奇特剑法，招式精妙，旨在以巧破力，制敌机先。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  内功激发等级不低于 " HIY "60" NOR " 级。" ZJBR;
    msg += "  当前内力不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "  基本剑法等级不得低于神门十三剑等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  剑法 (sword)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须装备剑类武器。" ZJBR;
    msg += "  气血不低于 " HIR "65" NOR " 点。" ZJBR;
    msg += "  内力不低于 " HIB "65" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "52" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "58" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无特殊被动效果。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += CYN "  神门刺 (ci)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      神门十三剑等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      内功激发等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标造成伤害，伤害值约为 (`神门十三剑等级 + 随机(神门十三剑等级)`)。" ZJBR;
    msg += "      命中后对目标造成特殊内伤 (`shenmen_damage`)，内伤值约为 (伤害 / 3)。" ZJBR;
    msg += "      该内伤可能导致目标暂时性降低内力最大值，降低量约为 (内伤值 / 2)。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "2-3" NOR " 回合。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 需要装备剑类武器方可施展。" ZJBR;
    msg += "2. '神门刺' 招式能造成特殊内伤并可能削减对手内力上限，效果独特。" ZJBR;
    msg += "3. 练习消耗内力和气血，请注意保持状态。\n";

    return msg;
}