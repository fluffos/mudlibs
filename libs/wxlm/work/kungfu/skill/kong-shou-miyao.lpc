inherit SKILL;
// string type() { return "knowledge"; }

mixed query_fuzhu()  { return "kong-shou";}

int valid_learn(object me)
{

        return 1;
}

int difficult_level()
{
        return 200;
}

string query_description()
{
    string msg;

    msg = HIG "【空手秘要】" NOR ZJBR ZJBR;
    msg += WHT "这是一门辅助知识类技能，用于增强空手类武功的某些效果。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  无特殊要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  无。 (知识类技能)" ZJBR ZJBR;

    msg += HIY "〖辅助对象〗" ZJBR NOR; // query_fuzhu
    msg += "  空手 (kong-shou) 类技能。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  无法通过练习提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // hit_ob, valid_damage, skill_improved etc.
    msg += "  具体效果需查看引用此技能的代码逻辑。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (Perform/Exert)〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 此技能为辅助技能，本身不提供直接的攻防能力。
";

    return msg;
}
