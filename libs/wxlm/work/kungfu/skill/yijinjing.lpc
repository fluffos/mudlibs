// yijinjing.c 少林 易筋经神功
// Feb.21 1998 by Java

inherit FORCE;

int is_shaolin_skill() { return 1; }

int valid_enable(string usage)
{
	return usage == "force";
}

int valid_force(string force)
{
	return force == "hunyuan-yiqi" ||
	       force == "taiji-shengong" ||
	       force == "wudang-xinfa" ||
	       force == "shaolin-xinfa";
}

int query_neili_improve(object me)
{
	int lvl;

	lvl = (int)me->query_skill("yijinjing", 1);
	return lvl * lvl * 15 * 19 / 100 / 200;
}

int valid_learn(object me)
{
	if (me->query_skill("force", 1) < 100)
		return notify_fail("你的基本内功火候不够，无法学习易筋经神功！\n");

	if (me->query_skill("freezing-force", 1)) 
		return notify_fail("你已经将易筋经神功和冰蚕寒毒合炼成了一门新内功了。\n");

	if (me->query_skill("force", 1) < me->query_skill("yijinjing", 1))
		return notify_fail("你的基本内功水平不够，难以领悟更高深的易筋经神功！\n");

	if (me->query("gender") != "男性" && me->query("gender") != "女性")
		return notify_fail("你不男不女，无法练习易筋经神功。\n");

	return ::valid_learn(me);
}


int practice_skill(object me)
{
	return notify_fail("易筋经神功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"yijinjing/" + func;
}

string query_description()
{
    string msg;

    msg = HIY "【易筋经神功】" ZJBR NOR;
    msg += WHT "易筋经神功是少林寺镇寺之宝，乃是达摩祖师所创的绝世内功。" ZJBR;
    msg += WHT "此功法以易筋洗髓为根本，能强身健体，提升内力。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功等级：" HIY "100" NOR " 级" ZJBR;
    msg += "  性别要求：必须为男性或女性" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功（force）" ZJBR ZJBR;

    msg += HIY "〖可相容内功〗" ZJBR NOR;
    msg += "  混元一气功、太极神功、武当心法、少林心法" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  易筋经神功只能通过学习(learn)来提升熟练度，无法自行练习(practice)" ZJBR ZJBR;

    msg += HIY "〖能力提升〗" ZJBR NOR;
    msg += "  内力上限增加：每级提升 " HIY + "易筋经神功等级 * 易筋经神功等级 * 15 * 19 / 100 / 200" NOR " 点" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  易筋真身（powerup）" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      当前内力不低于 " HIY "200" NOR " 点" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      运转易筋经真气，全身笼罩白雾，提升自身战斗力" ZJBR;
    msg += "      普攻命中提升：内功有效激发等级 / 2" ZJBR;
    msg += "      普攻闪避提升：内功有效激发等级 / 2" ZJBR;
    msg += "      兵器伤害提升：内功有效激发等级 / 2" ZJBR;
    msg += "      空手伤害提升：内功有效激发等级 / 2" ZJBR;
    msg += "      持续时间：内功有效激发等级秒" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIY "100" NOR " 点" ZJBR;
    msg += "      战斗中使用会导致自身" HIR "忙乱3秒" NOR ZJBR ZJBR;

    msg += HIC "  佛门狮子吼（roar）" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      当前内力不低于 " HIY "600" NOR " 点" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      发出惊天动地的佛门狮子吼，震慑周围敌人" ZJBR;
    msg += "      判定几率：(内功有效激发等级 / 2 + 随机(内功有效激发等级 / 2)) > 目标根骨 * 2 时，判定成功" ZJBR;
    msg += "      精神伤害：(内功有效激发等级 - (目标最大内力 / 10)) * 2 点" ZJBR;
    msg += "      若目标当前内力低于 (内功有效激发等级 * 2)，则额外受到精神损伤" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIY "150" NOR " 点" ZJBR;
    msg += "      自身忙乱 " HIR "5秒" NOR ZJBR ZJBR;

    msg += HIR "〖注意事项〗" ZJBR NOR;
    msg += "  1. 易筋经神功为少林寺镇寺之宝，习得不易" ZJBR;
    msg += "  2. 此功法只能通过学习提升，无法自行练习" ZJBR;
    msg += "  3. 易筋经神功可以显著提升内力上限" ZJBR;
    msg += "  4. 佛门狮子吼为群体攻击技能，使用时需谨慎" ZJBR;
    msg += "  5. 易筋经神功与冰蚕寒毒合炼后会形成新的内功，无法再单独使用";

    return msg;
}