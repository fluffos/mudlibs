//kuangfeng-jian 连风快剑



inherit SKILL;

mapping *action = ({
([      "action" : "$N纵身跃起手中$w轻挥，斩向$n后颈",
	"force"  : 80,
	"attack" : 35,
	"parry"  : 10,
	"dodge"  : 30,
	"damage" : 75,
	"lvl"    : 0,
	"skill_name" : "风平浪静",
	"damage_type" : "刺伤"
]),
([      "action" : "$N手中$w连话三个弧形，向$n的右臂齐肩斩落",
	"force"  : 100,
	"attack" : 45,
	"parry"  : 22,
	"dodge"  : 45,
	"damage" : 88,
	"lvl"    : 30,
	"skill_name" : "风起云涌",
	"damage_type" : "刺伤"
]),
([      "action" : "$N轻吁一声，刷刷刷刷四剑，向$n胸，腹，腰，肩四处连刺",
	"force"  : 120,
	"attack" : 51,
	"parry"  : 18,
	"dodge"  : 53,
	"damage" : 95,
	"lvl"    : 60,
	"skill_name" : "风卷残云",
	"damage_type" : "刺伤"
]),
([      "action" : "$N仰天一声清啸，斜行向前，$w横削直击，迅捷无比，击向$n的$l",
	"force"  : 150,
	"attack" : 58,
	"parry"  : 20,
	"dodge"  : 52,
	"damage" : 110,
	"lvl"    : 90,
	"skill_name" : "风流云散",
	"damage_type" : "割伤"
]),
});

int valid_enable(string usage) { return usage == "sword" || usage == "parry"; } 

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 200)
		return notify_fail("你的内力不够，无法修习连风快剑。\n");

	if ((int)me->query_skill("dodge") < 90)
		return notify_fail("你的轻功火候太浅，无法修习连风快剑。\n");

	if ((int)me->query_dex() < 25)
		return notify_fail("你的身法还不够灵活，无法修习连风快剑。\n");

	if ((int)me->query_skill("sword", 1) < (int)me->query_skill("kuangfeng-jian", 1))
		return notify_fail("你的基本剑法水平有限，无法领会更高深的连风快剑。\n");

	return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	int lvl;
	int i;

	lvl = me->query_skill("martial-cognize", 1);
	i = random(lvl);

	if (me->query("family/family_name") == "华山剑宗" &&
	    i > 40 && random(2) == 0)
	{
		if (i < 100)
		{
			victim->receive_wound("qi", damage_bonus / 6);
			return HIC "只见$N" HIC "身形一探，剑芒陡涨，正中$n！"NOR"\n";
		}
		if (i < 200)
		{
			victim->receive_wound("qi", damage_bonus / 4);
			return HIY "只看$N" HIY "一声清啸，剑气横飞，$n" HIY "连连中招！"NOR"\n";
		} else
		{
			victim->receive_wound("qi", damage_bonus / 2);
			return HIW "但见$N" HIW "微微一笑，缓缓移动长剑，$n" HIW "已然中招！"NOR"\n";
		}
	}
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action) - 1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	int j;

	level = (int) me->query_skill("kuangfeng-jian",1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i - 1]["lvl"])
		{
			j = me->query_skill("martial-cognize", 1);

			if (me->query("family/family_name") == "华山剑宗" && 
    			    random(j) > 180 &&
    			    random(level) > 180 && random(3) == 0)
			{
				return ([ "action" : WHT "$N" WHT "双目忽地精光四射，一招「" HIY 
    						     "狂风骤雨" NOR WHT "」势不可挡地攻向$n",
					  "force"  : (j - 50),
					  "attack" : j / 5,
					  "parry"  : (level / 2 + 50),
					  "dodge"  : (level / 2),
					  "damage" : j / 2,
					  "skill_name" : "狂风骤雨",
					  "damage_type" : "割伤",
					]);
			}
			else return action[NewRandom(i, 20, level / 5)];
		}
}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 65)
		return notify_fail("你的体力不够练连风快剑。\n");

	if ((int)me->query("neili") < 20)
		return notify_fail("你的内力不够练连风快剑。\n");

	me->receive_damage("qi", 60);
	me->add("neili", -16);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"kuangfeng-jian/" + action;
}

// 在文件中添加以下函数实现
string query_description()
{
    string msg;

    msg = HIY "【狂风剑法】" ZJBR NOR;
    msg += WHT "华山剑宗的快剑剑法，招式迅捷凌厉，剑势如狂风骤雨般连绵不绝，注重以快打慢，攻敌不备。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  最大内力 (`max_neili`) 不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "  基本轻功 (`dodge`) 等级不低于 " HIY "90" NOR " 级。" ZJBR;
    msg += "  后天身法 (`dex`) 不低于 " HIY "25" NOR " 点。" ZJBR;
    msg += "  基本剑法 (`sword`) 等级需大于等于狂风剑法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  剑法 (`sword`)。" ZJBR;
    msg += "  招架 (`parry`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  必须装备剑类武器。" ZJBR;
    msg += "  气血 (`qi`) 不低于 " HIR "65" NOR " 点。" ZJBR;
    msg += "  内力 (`neili`) 不低于 " HIB "20" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血 " HIR "60" NOR " 点，内力 " HIB "16" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  " HIW "剑宗心法 (hit_ob)" NOR ":" ZJBR;
    msg += "    触发条件：" ZJBR;
    msg += "      门派为 " HIY "华山剑宗" NOR "。" ZJBR;
    msg += "      随机(武学修养等级) > 40 且 随机(2) == 0。" ZJBR;
    msg += "    效果：命中时有几率对目标造成额外气血伤害 (`wound`)，伤害量根据武学修养等级提升（<100级: 伤害增益/6, 100-199级: 伤害增益/4, >=200级: 伤害增益/2）。" ZJBR;
    msg += "  " HIW "狂风骤雨 (query_action)" NOR ":" ZJBR;
    msg += "    触发条件：" ZJBR;
    msg += "      门派为 " HIY "华山剑宗" NOR "。" ZJBR;
    msg += "      随机(武学修养等级) > 180 且 随机(狂风剑法等级) > 180 且 随机(3) == 0。" ZJBR;
    msg += "    效果：普通攻击时，有极低概率触发特殊攻击招式 " HIY "狂风骤雨" NOR "，该招式拥有更高的攻击力、招架、躲闪和伤害加成。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (Perform)〗" ZJBR NOR;
    msg += HIC "  狂风剑 (kuang)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      狂风剑法等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "150" NOR " 点。" ZJBR;
    msg += "      必须装备剑类武器。" ZJBR;
    msg += "      不能处于运功 (`powerup`) 状态。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      临时提升自身攻击力，提升值等于 (自身基本剑法激发等级 / 2)。" ZJBR;
    msg += "      对目标发动多次连续攻击，攻击次数等于 `COMBAT_D->query_base_attack_number(me,query_name())`。" ZJBR;
    msg += "      攻击结束后移除临时攻击力提升。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "      自身忙乱 (`busy`) 1 到 6 秒 (1 + random(6))。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 绝大部分特殊招式 (`perform`) 仅能在战斗中使用。" ZJBR;
    msg += "2. 「狂风剑」需要装备剑类武器且不能在运功状态下使用。" ZJBR;
    msg += "3. 使用特殊招式后通常会伴随一定时间的忙乱状态 (`busy`)。" ZJBR;
    msg += "4. 被动效果「剑宗心法」和「狂风骤雨」仅限华山剑宗弟子触发。" ZJBR;

    return msg;
}