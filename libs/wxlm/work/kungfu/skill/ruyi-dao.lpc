int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 350)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("force") < 40)
		return notify_fail("你的内功火候太浅。\n");

	if (me->query_skill("blade", 1) < me->query_skill("ruyi-dao", 1))
		return notify_fail("你的基本刀法火候太浅，难以领会更高深的如意刀法。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level   = (int) me->query_skill("ruyi-dao",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "blade")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力不够练如意刀。\n");

	if ((int)me->query("neili") < 70)
		return notify_fail("你的内力不够练如意刀。\n");

	me->receive_damage("qi", 65);
	me->add("neili", -53);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"ruyi-dao/" + action;
}
string query_description()
{
    string msg;

    msg = HIY "【如意刀法】" ZJBR NOR;
    msg += WHT "如意刀法是一门灵活多变的刀法,以其变化多端、出其不意的特点著称。此刀法讲究以意驭刀,随心所欲,变化无穷。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力不低于 " HIB "350" NOR " 点。" ZJBR;
    msg += "  基本内功等级不低于 " HIY "40" NOR " 级。" ZJBR;
    msg += "  基本刀法等级不低于如意刀法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  刀法 (blade)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须装备 " HIW "刀类" NOR " 武器。" ZJBR;
    msg += "  气血：不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "65" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "53" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  如意六刀 (ruyi)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      基本如意刀法 " HIY "135" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "145" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "250" NOR " 点。" ZJBR;
    msg += "      激发刀法为如意刀法。" ZJBR;
    msg += "      装备刀类武器。" ZJBR;
    msg += "      对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      连续攻击目标数次，攻击次数由 `COMBAT_D->query_base_attack_number` 决定（可能受自身状态影响）。" ZJBR;
    msg += "      每次攻击的命中和伤害由 `COMBAT_D->do_attack` 函数判定，可能受双方攻防、技能等级、属性、武器锋利度等多种因素影响。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "120" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "1" NOR " 至 " HIR "6" NOR " 秒 (随机)。" ZJBR;

    return msg;
}