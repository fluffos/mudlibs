//kuangfeng-blade 狂风刀法
// Made by deaner

inherit SKILL;

mapping *action = ({
([      "action" : "$N手中$w狂风般呼啸而出,一招「狂风骤雨」劈向$n的$l",
        "force" : 110,
        "attack": 40,
        "dodge" : 25,
        "parry" : 20,
        "damage": 55,
        "lvl"   : 0,
        "skill_name" : "狂风骤雨",
        "damage_type" : "割伤"
]),
});

int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

int valid_learn(object me)
{
    if ((int)me->query("max_neili") < 90)
        return notify_fail("你的内力不够。\n");

    if ((int)me->query_skill("force") < 25)
        return notify_fail("你的内功火候太浅。\n");

    if ((int)me->query_skill("blade", 1) < (int)me->query_skill("kuangfeng-blade", 1))
        return notify_fail("你的基本刀法水平有限，无法领会更高深的狂风刀法。\n");

    return 1;
}

string query_skill_name(int level)
{
    return action[0]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    return action[0];
}

int practice_skill(object me)
{
    object weapon;

    if (!objectp(weapon = me->query_temp("weapon")) || 
        (string)weapon->query("skill_type") != "blade")
        return notify_fail("你使用的武器不对。\n");

    if ((int)me->query("qi") < 45)
        return notify_fail("你的体力不够练狂风刀法。\n");

    if ((int)me->query("neili") < 45)
        return notify_fail("你的内力不够练狂风刀法。\n");

    me->receive_damage("qi", 40);
    me->add("neili", -40);
    return 1;
}

string perform_action_file(string action)
{
    return __DIR__"kuangfeng-blade/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【狂风刀法】" ZJBR NOR; // 基本介绍
    msg += WHT "此刀法走轻灵迅猛的路子，以快打慢，招式如狂风般骤雨连绵，让敌人应接不暇。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  最大内力不低于 " HIB "90" NOR " 点。" ZJBR;
    msg += "  基本内功 (`force`) 等级不低于 " HIY "25" NOR " 级。" ZJBR;
    msg += "  基本刀法 (`blade`) 等级需大于等于狂风刀法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  刀法 (blade)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  需要装备刀类武器。" ZJBR;
    msg += "  气血不低于 " HIR "45" NOR " 点。" ZJBR;
    msg += "  内力不低于 " HIB "45" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "40" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "40" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无特殊被动效果。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (Perform)〗" ZJBR NOR;
    msg += HIC "  狂风二十一式 (kuang)" ZJBR NOR; // perform/kuang.c (招式名根据代码描述意译)
    msg += "    使用要求：" ZJBR;
    msg += "      狂风刀法等级不低于 " HIY "70" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：由 `通用命中公式` 决定，主要依据 ap = (自身基本刀法激发等级) 与 dp = (目标招架激发等级) 的比较。" ZJBR;
    msg += "      伤害计算 (命中后)：伤害 = (ap / 2 + 随机(ap / 2))，伤害系数 " HIY "40%" NOR "。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      发动消耗内力 " HIB "60" NOR " 点。" ZJBR;
    msg += "      命中：自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：自身忙乱 " HIR "1" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  狂风骤雨 (kuangfeng)" ZJBR NOR; // perform/kuangfeng.c
    msg += "    使用要求：" ZJBR;
    msg += "      狂风刀法等级不低于 " HIY "40" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "90" NOR " 点。" ZJBR;
    msg += "      需要装备刀类武器。" ZJBR;
    msg += "      激发刀法为狂风刀法。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：若 随机(自身基本刀法激发等级) > (目标招架激发等级 / 3) 则命中。" ZJBR;
    msg += "      伤害计算 (命中后)：基础伤害 damage = (自身狂风刀法基本等级)，最终伤害 = (damage + 随机(damage / 2))，伤害系数 " HIY "25%" NOR "。" ZJBR;
    msg += "      额外效果 (命中后)：对目标造成相当于最终伤害 1/3 的气血伤口。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 " HIB "90" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：消耗内力 " HIB "45" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;
    msg += "    冷却时间：" HIY "7" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 特殊招式仅能在战斗中使用。" ZJBR;
    msg += "2. 使用特殊招式后通常会伴随一定时间的忙乱状态 (`busy`)。" ZJBR;
    msg += "3. 『狂风骤雨』有 " HIY "7" NOR " 秒的冷却时间。\n";

    return msg;
}