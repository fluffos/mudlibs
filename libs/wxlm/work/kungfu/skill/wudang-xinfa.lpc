// wudang-xinfa.c 武当心法

inherit FORCE;

int valid_enable(string usage)
{
	    return usage == "force";
}

int valid_force(string force)
{
	return force == "yijinjing" ||
	       force == "taiji-shengong" ||
	       force == "shaolin-xinfa" ||
	       force == "hunyuan-yiqi";
}

int valid_learn(object me)
{
	    return ::valid_learn(me);
}

int practice_skill(object me)
{
	    return notify_fail("武当心法只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	    return __DIR__"wudang-xinfa/" + func;
}

string query_description()
{
    string msg;

    msg = HIY "【武当心法】" ZJBR NOR;
    msg += "武当心法是武当派的基础内功心法，讲究天人合一、阴阳平衡，为武当派其他功法的根基。通过修炼武当心法，可以增强内力修为，为习练武当派的绝学奠定基础。" ZJBR ZJBR;
    
    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  无特殊要求。" ZJBR ZJBR;
    
    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功（force）。" ZJBR ZJBR;
    
    msg += HIY "〖兼容内功〗" ZJBR NOR;
    msg += "  易筋经（yijinjing）。" ZJBR;
    msg += "  太极神功（taiji-shengong）。" ZJBR;
    msg += "  少林心法（shaolin-xinfa）。" ZJBR;
    msg += "  混元一气功（hunyuan-yiqi）。" ZJBR ZJBR;
    
    msg += HIY "〖练习方式〗" ZJBR NOR;
    msg += "  武当心法只能通过学习（learn）来提高熟练度，不能练习（practice）。" ZJBR ZJBR;
    
    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无特殊被动效果。" ZJBR ZJBR;
    
    if (file_size(__DIR__"wudang-xinfa") == -1)
    {
        msg += HIY "〖特殊招式〗" ZJBR NOR;
        msg += "  武当心法暂无已开放的特殊招式。" ZJBR;
    }
    else
    {
        msg += HIY "〖特殊招式〗" ZJBR NOR;
        msg += "  注意：请查看具体招式文件了解详情。" ZJBR;
    }
    
    return msg;
}

