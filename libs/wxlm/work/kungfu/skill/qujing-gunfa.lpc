int valid_enable(string usage) { return  (usage =="parry")|| (usage =="club"); }

int valid_learn(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "club")
		return notify_fail("你必须先找一根棍子才能练取经棍法。\n");

	if ((int)me->query("max_neili") < 1000)
		return notify_fail("你的内力不足，没有办法练取经棍法，多练些内力再来吧。\n");

	if ((int)me->query_skill("force") < 150)
		return notify_fail("你的内功火候太浅，没有办法练取经棍法。\n");

	if ((int)me->query_skill("club", 1) < 100)
		return notify_fail("你的基本棍法火候太浅，没有办法练取经棍法。\n");

	if ((int)me->query_skill("club", 1) < (int)me->query_skill("qujing-gunfa", 1))
		return notify_fail("你的基本棍法水平还不够，无法领会更高深的取经棍法。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action) - 1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("qujing-gunfa", 1);
	if (!objectp(weapon)) weapon = me->query_temp("weapon");

	if (random(me->query_skill("qujing-gunfa", 1)) > 120 &&
	     me->query_skill("force") > 100 &&
	     me->query("neili") > 1000 &&
	     random(10) > 6)
	{
		me->add("neili", -100);
		return ([
		"action": HIY "$N" HIY "将手中" + (objectp(weapon) ? weapon->query("name") : "长棍")
			  + HIY "迎风一挥，使出必杀绝技「" NOR + HIR "金猴奋起千钧棒 "
			  "玉宇澄清万里埃" NOR + HIY "」。"
			  + (objectp(weapon) ? weapon->query("name") : "长棍") + HIY "登时幻出"
			  "万千虚\n影，对准$n的脑门直劈而下。这一下要是打中，恐怕连大"
			  "罗金仙也难逃一命" NOR,
		"force" : 630,
		"attack": 138,
		"damage": 231,
		"dodge" : -10,
		"damage_type": "砸伤"]);
	}

	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "club")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 80)
		return notify_fail("你的体力不够练取经棍法。\n");

	if ((int)me->query("neili") < 90)
		return notify_fail("你的内力不够练取经棍法。\n");

	me->receive_damage("qi", 75);
	me->add("neili", -85);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"qujing-gunfa/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【取经棍法】" ZJBR NOR;
    msg += "少林派高深棍法，相传由西天取经之路上的磨难化出，招式大开大合，威力惊人。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  需持有棍类武器。" ZJBR;
    msg += "  最大内力不低于 " HIB "1000" NOR " 点。" ZJBR;
    msg += "  基本内功等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "  基本棍法等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "  基本棍法等级需大于等于取经棍法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  棍法（club）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  需持有棍类武器。" ZJBR;
    msg += "  气血：不低于 " HIR "80" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "90" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "75" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "85" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += HIM "  金猴奋起千钧棒 玉宇澄清万里埃 (随机触发)" ZJBR NOR; // query_action special
    msg += "    触发条件：" ZJBR;
    msg += "      取经棍法等级 > 120 级 (随机判定)。" ZJBR;
    msg += "      基本内功等级 > 100 级。" ZJBR;
    msg += "      当前内力 > 1000 点。" ZJBR;
    msg += "      随机判定 (random(10) > 6)。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      发动一次强力攻击，造成大量伤害。" ZJBR;
    msg += "      伤害加成 " HIY "231" NOR " 点，攻击加成 " HIY "138" NOR " 点。" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      自身躲闪降低 " HIY "10" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform/exert
    msg += HIC "  震雷乾坤 (zhenlei)" ZJBR NOR; // zhenlei.c
    msg += "    使用要求：" ZJBR;
    msg += "      需持有棍类武器。" ZJBR;
    msg += "      激发棍法为取经棍法。" ZJBR;
    msg += "      取经棍法等级 " HIY "160" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "200" NOR " 级。" ZJBR;
    msg += "      最大内力 " HIB "1800" NOR " 点。" ZJBR;
    msg += "      当前内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标发动连续攻击。" ZJBR;
    msg += "      攻击次数受自身基础攻击次数 (`COMBAT_D->query_base_attack_number`) 影响。" ZJBR;
    msg += "      命中判定：(自身基本棍法 / 2 + 随机(自身基本棍法 * 2)) > 目标基本招架。" ZJBR;
    msg += "      若命中判定成功：临时提升自身攻击力 (基本棍法 / 10)，额外增加攻击次数 (随机(基本棍法 / 45))。" ZJBR;
    msg += "      最大攻击次数为 " HIY "10" NOR " 次。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力：每次攻击消耗 " HIB "20" NOR " 点。" ZJBR;
    msg += "      忙乱：1 + 随机(攻击次数) 秒。" ZJBR;

    return msg;
}

