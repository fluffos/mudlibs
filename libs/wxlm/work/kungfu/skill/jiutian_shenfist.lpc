int valid_enable(string usage) { return usage == "cuff" || usage == "parry"; }

int valid_learn(object me)
{
    if (me->query("family/family_name"))
        return notify_fail("九天神拳只有无门派的人才能学习。\n");

    if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
        return notify_fail("练习九天神拳必须空手。\n");

    if ((int)me->query_skill("force") < 150)
        return notify_fail("你的内功火候不够，无法练习九天神拳。\n");

    if ((int)me->query("max_neili") < 1000)
        return notify_fail("你的内力太弱，无法练习九天神拳。\n");

    if ((int)me->query_skill("cuff", 1) < 100)
        return notify_fail("你的基本拳法火候不够，无法练习九天神拳。\n");

    if ((int)me->query_skill("cuff", 1) < (int)me->query_skill("jiutian_shenfist", 1))
        return notify_fail("你的基本拳法水平有限，无法领会更高深的九天神拳。\n");

    return 1;
}

string query_skill_name(int level)
{
    int i;
    for (i = sizeof(action) - 1; i >= 0; i--)
        if (level >= action[i]["lvl"])
            return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    int i, level;
    level = (int) me->query_skill("jiutian_shenfist", 1);
    for (i = sizeof(action); i > 0; i--)
        if (level > action[i-1]["lvl"])
            return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    if ((int)me->query("qi") < 70)
        return notify_fail("你的体力太低了。\n");

    if ((int)me->query("neili") < 70)
        return notify_fail("你的内力不够练九天神拳。\n");

    me->receive_damage("qi", 60);
    me->add("neili", -65);
    return 1;
}

string perform_action_file(string action)
{
    return __DIR__"jiutian_shenfist/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
    int lvl;
    int i;

    lvl = me->query_skill("jiutian_shenfist", 1);
    i = random(lvl);

    if (i < 50)
        return 0;

    if (i < 100)
    {
        victim->receive_wound("qi", damage_bonus / 4);
        return HIY "$N" HIY "这一拳裹挟着九天神力,震得$n" HIY "气血翻涌,难以喘息！"NOR"\n";
    }
    else if (i < 150)
    {
        victim->receive_wound("qi", damage_bonus / 3);
        return HIC "$N" HIC "拳势如天河倒泻,$n" HIC "顿觉全身剧痛,仿佛被星辰撞击！"NOR"\n";
    }
    else
    {
        victim->receive_wound("qi", damage_bonus / 2);
        return HIR "$N" HIR "一拳轰出,九天神威尽显,$n" HIR "被这排山倒海的气势所慑,连连后退！"NOR"\n";
    }
}

string query_description()
{
    string msg;

    msg = HIY "【九天神拳】" ZJBR ZJBR NOR;
    msg += WHT "传说中的仙人所创，融合天地之力的绝世拳法。气势磅礴，威力无穷。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  仅限" HIR "无门派" NOR "人士学习。" ZJBR;
    msg += "  必须空手。" ZJBR;
    msg += "  基本内功 (force) 等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "  最大内力 " HIB "1000" NOR " 点。" ZJBR;
    msg += "  基本拳法 (cuff) 等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "  基本拳法 (cuff) 等级不低于九天神拳等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  拳法 (cuff)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "65" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  普通攻击命中时 (`hit_ob`)：" ZJBR;
    msg += "    根据随机值和技能等级，可能对目标造成额外气血创伤：" ZJBR;
    msg += "      - 低概率 (50-99): 造成 伤害附加 / 4 的气血创伤。" ZJBR;
    msg += "      - 中概率 (100-149): 造成 伤害附加 / 3 的气血创伤。" ZJBR;
    msg += "      - 高概率 (150+): 造成 伤害附加 / 2 的气血创伤。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;

    msg += HIC "  九天神龙诀 (shenlong)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      九天神拳等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      必须激发九天神拳为拳法，且在战斗中使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标发动一次强力攻击。" ZJBR;
    msg += "      命中判定：基于双方的拳法/内功激发等级和轻功/招架激发等级 (`通用命中公式`)。" ZJBR;
    msg += "      命中效果：造成 ((拳法激发+内功激发)/2 + 随机((拳法激发+内功激发)/2)) 的伤害，附加 55 点固定伤害。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力 " HIB "150" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "50" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  星河璀璨击 (xinghe)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      九天神拳等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      必须激发九天神拳为拳法，且在战斗中使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标发动连续攻击。" ZJBR;
    msg += "      攻击次数 = ((拳法激发+内功激发)/10，最多5次) + 基础攻击次数。" ZJBR;
    msg += "      暂时提升自身攻击命中等级（`apply/attack`），提升值为攻击次数。" ZJBR;
    msg += "      每次攻击独立计算伤害，并有 1/3 几率使目标忙乱 1 秒（如果未忙乱）。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "200" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  九天神罚 (shenfa)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      九天神拳等级 " HIY "140" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "400" NOR " 点。" ZJBR;
    msg += "      必须激发九天神拳为拳法，且在战斗中使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标发动毁灭性一击。" ZJBR;
    msg += "      命中判定：基于双方的拳法/内功激发等级和轻功/招架激发等级 (`通用命中公式`)。" ZJBR;
    msg += "      命中效果：造成 ((拳法激发+内功激发) + 随机((拳法激发+内功激发)/2)) 的伤害，附加 70 点固定伤害。" ZJBR;
    msg += "      若 (自身ap / 3 + 随机(自身ap)) > 目标dp 且目标未忙乱，则额外使目标忙乱 ((自身ap / 100) + 2) 秒 (ap=拳法激发+内功激发, dp=轻功激发+招架激发)。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力 " HIB "300" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "100" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 学习此技能会限制加入其他门派。" ZJBR;
    msg += "2. 招式效果和伤害受多种因素影响，以实际战斗为准。
";

    return msg;
}