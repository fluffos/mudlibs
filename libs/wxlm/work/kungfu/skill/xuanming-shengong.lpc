inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int query_neili_improve(object me)
{
	int lvl;

	lvl = (int)me->query_skill("xuanming-shengong", 1);
	return lvl * lvl * 15 * 14 / 100 / 200;
}

int valid_learn(object me)
{

	if ((int)me->query_skill("force", 1) < 100)
		return notify_fail("你的基本内功火候还不够，还不能学习玄冥神功。\n");

	return ::valid_learn(me);
}

int practice_skill(object me)
{
	return notify_fail("玄冥神功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"xuanming-shengong/" + func;
}

string query_description()
{
    string msg;

    msg = HIY "【玄冥神功】" ZJBR NOR;
    msg += "百损道人所创的阴毒内功，以至阴至寒的内力伤人。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功 等级不低于 " HIY "100" NOR " 级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功 (force)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  玄冥神功只能通过学习（learn）提升，无法自行练习（practice）。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  提升内力上限：每级提升 " HIW "等级 * 等级 * 15 * 14 / 100 / 200" NOR " 点内力上限。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  玄冥战气 (powerup)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      玄冥神功 等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "      未处于 玄冥战气 状态。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      临时提升自身的攻击力和防御力。" ZJBR;
    msg += "      攻击力提升量 = 玄冥神功等级 / 3" ZJBR;
    msg += "      防御力提升量 = 玄冥神功等级 / 3" ZJBR;
    msg += "      效果持续时间 = 玄冥神功等级 秒" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      无忙乱时间。" ZJBR;

    return msg;
}