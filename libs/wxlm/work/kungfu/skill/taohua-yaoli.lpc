// taohua-yaoli.c

inherit SKILL;

string type() { return "knowledge"; }

int valid_enable(string usage) { return usage == "medical"; }

int valid_learn(object me)
{
	if (me->query("family/family_name") != "桃花岛")
		return notify_fail("桃花岛的弟子才能学习该技能。\n");
	
	if ((int)me->query_skill("medical", 1) < 100)
		return notify_fail("你的基本医术造诣太浅，无"
				   "法领会深奥的桃花药理。\n");

	if ((int)me->query_skill("medical", 1) < (int)me->query_skill("taohua-yaoli", 1))
		return notify_fail("你的基本医术水平有限，无"
				   "法掌握更深奥的桃花药理。\n");

	return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【桃花药理】" ZJBR NOR;
    msg += "桃花药理是桃花岛独门医术，融合了桃花岛独特的药理知识。精通此技能可以更好地理解和运用各种药物，提高治疗效果。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  必须是桃花岛弟子。" ZJBR;
    msg += "  基本医术（medical）等级 " HIY "100" NOR " 级以上。" ZJBR;
    msg += "  基本医术等级不低于桃花药理等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  医术（medical）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  该技能无法通过练习提升，只能通过学习增加熟练度。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR;

    return msg;
}

