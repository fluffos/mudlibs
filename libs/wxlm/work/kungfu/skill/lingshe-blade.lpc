// 灵蛇刀法

inherit SKILL;

mapping *action = ({
([      "action" : "$N手中$w如灵蛇吐信,一招「灵蛇出洞」诡异地刺向$n的$l",
        "force" : 95,
        "attack": 35,
        "dodge" : 35,
        "parry" : 30,
        "damage": 45,
        "lvl"   : 0,
        "skill_name" : "灵蛇出洞",
        "damage_type" : "刺伤"
]),
});

int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

int valid_learn(object me)
{
    if ((int)me->query("max_neili") < 85)
        return notify_fail("你的内力不够。\n");

    if ((int)me->query_skill("force") < 20)
        return notify_fail("你的内功火候太浅。\n");

    if ((int)me->query_skill("blade", 1) < (int)me->query_skill("lingshe-blade", 1))
        return notify_fail("你的基本刀法水平有限，无法领会更高深的灵蛇刀法。\n");

    return 1;
}

string query_skill_name(int level)
{
    return action[0]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    return action[0];
}

int practice_skill(object me)
{
    object weapon;

    if (!objectp(weapon = me->query_temp("weapon")) || 
        (string)weapon->query("skill_type") != "blade")
        return notify_fail("你使用的武器不对。\n");

    if ((int)me->query("qi") < 40)
        return notify_fail("你的体力不够练灵蛇刀法。\n");

    if ((int)me->query("neili") < 40)
        return notify_fail("你的内力不够练灵蛇刀法。\n");

    me->receive_damage("qi", 35);
    me->add("neili", -35);
    return 1;
}

string perform_action_file(string action)
{
    return __DIR__"lingshe-blade/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【灵蛇刀法】" NOR ZJBR ZJBR;
    msg += WHT "据传源自西域，模仿灵蛇扑击之姿而创的诡异刀法。其招式变幻莫测，角度刁钻，刀锋如蛇信吞吐不定，令人防不胜防，更带有异毒。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  最大内力 (`max_neili`) 不低于 " HIB "85" NOR " 点。" ZJBR;
    msg += "  基本内功 (`force`) 等级不低于 " HIY "20" NOR " 级。" ZJBR;
    msg += "  基本刀法 (`blade`) 等级需大于等于灵蛇刀法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  刀法 (`blade`)。" ZJBR;
    msg += "  招架 (`parry`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  必须装备刀类武器。" ZJBR;
    msg += "  当前气血 (`qi`) 不低于 " HIR "40" NOR " 点。" ZJBR;
    msg += "  当前内力 (`neili`) 不低于 " HIB "40" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血 " HIR "35" NOR " 点，内力 " HIB "35" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  " WHT "暂无明显的被动攻防特效。" NOR ZJBR ZJBR; // No hit_ob, valid_damage etc.

    msg += HIY "〖特殊招式 (Perform)〗" ZJBR NOR; // perform_action_file
    msg += HIC "  灵蛇缠身 (lingshe)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      灵蛇刀法等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      基本内功等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "      必须装备刀类武器。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      刀招如同毒蛇缠绕，对目标造成伤害的同时附加「灵蛇」之毒。" ZJBR;
    msg += "      伤害计算：造成 (" RED "灵蛇刀法等级 + 随机(灵蛇刀法等级)" NOR ") 点伤害。" ZJBR;
    msg += "      附加状态：使目标中「" GRN "lingshe" NOR "」毒。" ZJBR;
    msg += "        毒性强度：(" CYN "自身基本毒技等级 / 2" NOR ")。" ZJBR;
    msg += "        持续时间：(" CYN "灵蛇刀法等级 / 40 + 随机(灵蛇刀法等级 / 40)" NOR ") 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "      自身忙乱 (`busy`) " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 灵蛇刀法较为基础，但其特殊招式「灵蛇缠身」的威力与使用者的毒技水平息息相关。" ZJBR;
    msg += "2. 提升基本毒技可以显著增强「灵蛇缠身」的中毒效果。" ZJBR;

    return msg;
}