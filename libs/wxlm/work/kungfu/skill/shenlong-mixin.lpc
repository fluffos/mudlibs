// shenlong-mixin.c

inherit SKILL;

string type() { return "knowledge"; }

int valid_enable(string usage) { return usage == "medical"; }

int valid_learn(object me)
{
	if ((int)me->query_skill("medical", 1) < 100)
		return notify_fail("你的基本医术造诣太浅，无"
				   "法领会深奥的神龙秘辛。\n");

	if ((int)me->query_skill("medical", 1) < (int)me->query_skill("shenlong-mixin", 1))
		return notify_fail("你的基本医术水平有限，无"
				   "法掌握更深奥的神龙秘辛。\n");

	return 1;
}
string query_description()
{
    string msg;

    msg = HIY "【神龙秘辛】" ZJBR NOR;
    msg += WHT "神龙教独特的医术知识，包含毒药配方和治疗奇术，涉及许多江湖秘闻。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本医术 (`medical`) 等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "  基本医术等级不能低于神龙秘辛等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  基本医术（medical）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  无法练习，只能通过学习 (`learn`) 提升等级。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  作为知识技能，主要影响制药、解毒等非战斗能力。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 提升此技能有助于掌握神龙教的用毒和解毒之法。" ZJBR;

    return msg;
}
