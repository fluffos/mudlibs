int valid_enable(string usage) { return usage == "hand" ||  usage == "parry"; }

int valid_combine(string combo)
{
	return combo == "taiji-quan" || combo == "wudang-zhang";
}

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练排云手必须空手。\n");

	if ((int)me->query_skill("force") < 40)
		return notify_fail("你的内功火候不够，无法学排云手。\n");

	if ((int)me->query("max_neili") < 250)
		return notify_fail("你的内力太弱，无法练排云手。\n");

	if (me->query_skill("hand", 1) < me->query_skill("paiyun-shou", 1))
		return notify_fail("你的基本手法水平有限，无法领会更高深的排云手法。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action); i > 0; i--)
		if (level >= action[i - 1]["lvl"])
			return action[i - 1]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;

	level = (int) me->query_skill("paiyun-shou", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i - 1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}


int practice_skill(object me)
{
	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 40)
		return notify_fail("你的内力不够练排云手。\n");

	me->receive_damage("qi", 37);
	me->add("neili", -25);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"paiyun-shou/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【排云手】" ZJBR NOR;
    msg += "武当派手法绝技，招式虚实结合，变化多端，能有效干扰对手。" ZJBR ZJBR; // 基本介绍 (基于名称和游戏背景的通用描述)

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  空手状态。" ZJBR;
    msg += "  基本内功等级不低于 " HIY "40" NOR " 级。" ZJBR;
    msg += "  最大内力不低于 " HIB "250" NOR " 点。" ZJBR;
    msg += "  基本手法等级需大于等于排云手等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  手法 (hand)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  气血：不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "40" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "37" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "25" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖武功组合〗" ZJBR NOR; // valid_combine
    msg += "  可与 太极拳 (taiji-quan) 或 武当掌法 (wudang-zhang) 组合使用。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // hit_ob, valid_damage, skill_improved etc.
    msg += "  无。" ZJBR ZJBR; // 根据现有代码，未发现

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform/exert
    msg += "  该技能存在特殊招式接口，但未在 `kungfu/skill/paiyun-shou/` 目录下发现具体招式文件。" ZJBR; // 目录不存在

    return msg;
}
