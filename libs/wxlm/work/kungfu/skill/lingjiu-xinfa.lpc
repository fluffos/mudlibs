// lingjiu-xinfa.c 灵鹫心法

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_force(string force) { return force == "bahuang-gong"; }

int valid_learn(object me)
{
	return ::valid_learn(me);
}

int practice_skill(object me)
{
	return notify_fail("灵鹫心法只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"lingjiu-xinfa/" + func;
}
string query_description()
{
    string msg;

    msg = HIY "【灵鹫心法】" ZJBR ZJBR NOR;
    msg += WHT "逍遥派灵鹫宫一脉的基础内功心法，为修炼更高深的《八荒六合唯我独尊功》奠定根基。此心法注重内息调和，循序渐进。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  通常需要逍遥派或灵鹫宫弟子身份。" ZJBR;
    msg += "  需要满足基本内功学习条件（具体参考 FORCE 基类）。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功 (`force`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  灵鹫心法无法通过简单的练习 (`practice`) 来提升，只能通过学习 (`learn`)。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  " HIW "功法兼容 (valid_force)" NOR ":" ZJBR;
    msg += "    效果：可与 " HIG "八荒六合唯我独尊功 (bahuang-gong)" NOR " 兼容共存（互备）。" ZJBR ZJBR;

    msg += HIY "〖内功运用 (Exert)〗" ZJBR NOR;
    msg += "  " WHT "暂无特殊内功运用。" NOR ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 作为基础内功，主要作用是为学习更高阶内功打好基础。" ZJBR;
    msg += "2. 无法练习，提升速度相对较慢。" ZJBR;

    return msg;
}
