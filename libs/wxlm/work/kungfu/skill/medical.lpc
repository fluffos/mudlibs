// literate.c

inherit SKILL;

string type() { return "knowledge"; }

int valid_learn(object me)
{
	return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【基本医术】" ZJBR NOR;
    msg += WHT "基本医术是关于医疗、伤病护理的基础知识技能，" ZJBR;
    msg += WHT "掌握它可以进行简单的伤势处理和药理识别。" ZJBR ZJBR;

    msg += HIY "〖技能性质〗" ZJBR NOR;
    msg += "  知识类技能 (`knowledge`)。" ZJBR ZJBR;

    msg += HIY "〖学习与提升〗" ZJBR NOR;
    msg += "  可以通过学习 (`learn`) 指令向医师请教或阅读医书来提升。" ZJBR;
    msg += "  也可以通过研究 (`research`) 自行钻研医理来提升。" ZJBR ZJBR;

    msg += HIY "〖主要作用〗" ZJBR NOR;
    msg += "  进行基本的诊断和治疗 (`heal`)。" ZJBR;
    msg += "  识别草药 (`identify`)。" ZJBR;
    msg += "  可能是学习更高级医疗技能（如本草术、金针术、炼药术等）的前提。" ZJBR;
    msg += "  在处理中毒、内伤等状态时可能发挥作用。" ZJBR ZJBR; // (具体应用视MUD实现)

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 基本医术是行走江湖必备的辅助技能之一。" ZJBR;
    msg += "2. 提高医术水平可以更有效地救治伤病。" ZJBR;
    msg += "3. 高深的医术往往需要配合相应的药材或工具才能发挥最大效果。" ZJBR;

    return msg;
}