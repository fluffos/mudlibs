int valid_enable(string usage) { return usage == "claw" ||  usage == "parry"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练锁喉功必须空手。\n");

	if ((int)me->query_skill("force") < 60)
		return notify_fail("你的内功火候不够，无法学锁喉功。\n");

	if ((int)me->query("max_neili") < 400)
		return notify_fail("你的内力太弱，无法练锁喉功。\n");

	if ((int)me->query_skill("claw", 1) < (int)me->query_skill("suohou-gong", 1))
		return notify_fail("你的基本爪法火候水平有限，无法领会更高深的锁喉功。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action); i > 0; i--)
		if (level >= action[i-1]["lvl"])
			return action[i-1]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("suohou-gong",1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];

}

int practice_skill(object me)
{
	if (me->query_temp("weapon") ||
	    me->query_temp("secondary_weapon"))
		return notify_fail("锁喉功必须空手练习！\n");

	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 80)
		return notify_fail("你的内力不够练锁喉功。\n");

	me->receive_damage("qi", 60);
	me->add("neili", -69);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"suohou-gong/" + action;
}

string query_description()
{
    string msg;

    msg = HIR "【锁喉功】" ZJBR NOR;
    msg += "一门凶狠毒辣的爪法，专攻敌人要害。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  空手状态。" ZJBR;
    msg += "  基本内功需达到 " HIY "60" NOR " 级。" ZJBR;
    msg += "  最大内力需达到 " HIB "400" NOR " 点。" ZJBR;
    msg += "  基本爪法等级需大于等于锁喉功等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  爪法（claw）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  气血：不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "80" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "69" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // hit_ob, valid_damage, skill_improved etc.
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform
    msg += HIC "  锁喉 (suo)" ZJBR NOR; // 招式名称
    msg += "    使用要求：" ZJBR; // 招式使用要求
    msg += "      锁喉功等级 " HIY "140" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      必须空手且在战斗中对敌人使用。" ZJBR;
    msg += "    效果描述：" ZJBR; // 招式效果描述
    msg += "      命中判定：攻击方命中值（基本爪法等级 / 2 + 随机(爪法激发等级 / 2)） > 防御方闪避值（轻功就覅等级）。" ZJBR;
    msg += "      命中后效果判定：" ZJBR;
    msg += "        致命一击：若攻击方最大内力 > 目标最大内力 * 2，则直接秒杀目标。" ZJBR;
    msg += "        造成伤害：若未能致命，则造成伤害。伤害值约等于 (爪法激发等级 + 随机(爪法激发等级 / 2))，伤害部位随机。" ZJBR;
    msg += "      若未命中，则无伤害效果。" ZJBR;
    msg += "    消耗与代价：" ZJBR; // 消耗与代价
    msg += "      发动消耗：内力 " HIB "20" NOR " 点。" ZJBR;
    msg += "      命中：追加消耗内力 " HIB "180" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：自身忙乱 " HIR "2" NOR " 秒。" ZJBR;

    return msg;
}

