// mantian-xing.c 满天星
// modified by Venus Oct.1997



inherit SKILL;

int valid_enable(string usage) { return usage == "throwing"; }

int valid_learn(object me)
{
	if ((int)me->query_skill("force") < 60)
		return notify_fail("你的内功心法火候不够，无法学满天星。\n");

	if ((int)me->query_skill("dodge") < 60)
		return notify_fail("你的轻功火候不够，无法领悟满天星。\n");

	if ((int)me->query_dex() < 25)
		return notify_fail("你的身法不够灵巧，无法领悟满天星。\n");

	if ((int)me->query_skill("throwing", 1) < (int)me->query_skill("mantian-xing", 1))
		return notify_fail("你的基本暗器水平有限，难以领会更高深的满天星。\n");

	return 1;
}

int practice_skill(object me)
{
 

	if ((int)me->query("qi") < 60)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 60)
		return notify_fail("你的内力不够练满天星。\n");

	me->receive_damage("qi", 45);
	me->add("neili", -35);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"mantian-xing/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【满天星】" ZJBR NOR;
    msg += WHT "星宿派独门暗器手法，出手迅疾，角度刁钻，如夜空中繁星闪烁，令人难以捉摸。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功 (`force`) 等级不低于 " HIY "60" NOR " 级。" ZJBR;
    msg += "  基本轻功 (`dodge`) 等级不低于 " HIY "60" NOR " 级。" ZJBR;
    msg += "  后天身法 (`dex`) 不低于 " HIY "25" NOR " 点。" ZJBR; // query_dex() 对应后天身法
    msg += "  基本暗器 (`throwing`) 等级需大于等于满天星等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  暗器 (`throwing`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血 (`qi`) 不低于 " HIR "60" NOR " 点。" ZJBR;
    msg += "  内力 (`neili`) 不低于 " HIB "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血 " HIR "45" NOR " 点，内力 " HIB "35" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;

    msg += HIC "  流星电闪 (shan)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      满天星 (`mantian-xing`) 等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      化功大法 (`huagong-dafa`) 等级不低于 " HIY "100" NOR " 级。" ZJBR; // 需要化功大法
    msg += "      当前内力 (`neili`) 不低于 " HIB "150" NOR " 点。" ZJBR;
    msg += "      必须装备暗器且数量至少为 1。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：(自身暗器激发等级 / 2 + 随机(自身暗器激发等级 / 2)) 与 目标轻功激发等级 进行比较。" ZJBR;
    msg += "      命中效果：对目标造成一次伤害，基础伤害约为 `暗器激发等级 / 3 + 随机(暗器激发等级 / 3)`。" ZJBR;
    msg += "      消耗暗器 1 枚。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 " HIB "100" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：消耗内力 " HIB "50" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  星光满天 (xing)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      满天星 (`mantian-xing`) 等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "      化功大法 (`huagong-dafa`) 等级不低于 " HIY "120" NOR " 级。" ZJBR; // 需要化功大法
    msg += "      基本暗器 (`throwing`) 等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 (`neili`) 不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "      必须装备暗器且数量至少为 15。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：(自身暗器激发等级 / 2 + 随机(自身暗器激发等级)) 与 (目标招架激发等级 + 目标轻功激发等级) 进行比较。" ZJBR;
    msg += "      命中效果：对目标造成 3 到 5 次连续伤害，每次基础伤害约为 `(暗器激发等级 / 4) + 随机(暗器激发等级 / 4)`。" ZJBR;
    msg += "      每次命中消耗若干暗器。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 " HIB "200" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：消耗内力 " HIB "100" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 满天星手法需要配合星宿派内功「化功大法」才能发挥特殊招式威力。" ZJBR;
    msg += "2. 「星光满天」需要较多暗器才能施展，且消耗较大。" ZJBR;

    return msg;
}