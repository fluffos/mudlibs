string main_skill() { return "yongzhao-shanhe"; }

int get_ready(object me)
{
        return 1;
}

int valid_enable(string usage)
{
        mixed me;

        //是否存在this_player()，如果不存在则返回
        if (!this_player())
        {
                return usage == "force" || usage == "unarmed" || usage =="parry";
        }

        me = this_player();
        
        // 如果不是明教弟子，只能激发为内功
        if (me->query("family/family_name") != "明教")
                return usage == "force";
                
        // 如果没有特殊技能标记，只能激发为内功
        if (! me->query("can_skill/jiuyang-shengong"))
                return usage == "force";
                
        return usage == "force" || usage == "unarmed" || usage =="parry";
}

int valid_force(string force) { return 1; }

int double_attack() { return 1; }

mapping query_action(object me, object weapon)
{
        return weapon ? actionw[random(sizeof(actionw))] :
                        actionf[random(sizeof(actionw))];
}

int valid_learn(object me)
{
        int level;
        
/*
        if ((int)me->query_skill("yinyang-shiertian", 1))
                return notify_fail("你已将紫阳神功融汇贯通，合成了普天之下最"
                                   "强的武功，不必再分开学习了。\n");
*/
	
    //    if( (!me->query("family/family_name") ||
    //            me->query("family/family_name") != "明教") && me->query("reborn/family_name") != "明教" )
    //            return notify_fail("你没有经过张教主的指点，难以理解。\n");

	if (me->query("gender") == "无性" && (int)me->query_skill("jiuyang-shengong", 1) > 49)
		return notify_fail("你无根无性，阴阳不调，难以领会高深的紫阳神功。\n");

	if (me->query("int") < 25)
		return notify_fail("你觉得紫阳神功过于艰深，难以理解。\n");

	if (me->query("con") < 29)
		return notify_fail("你的根骨不好，难以运转紫阳神功。\n");

        if ((int)me->query("max_neili") < 3500)
            return notify_fail("你的内力修为太浅，无法运转紫阳神功。\n");

        level = me->query_skill("jiuyang-shengong", 1);

        if ((int)me->query_skill("martial-cognize", 1) < 100)
                return notify_fail("你觉得紫阳神功过于深奥，以自己的武学修养"
                                   "全然无法明白。\n");

        if ((int)me->query_skill("force", 1) < 100)
                return notify_fail("你的基本内功修为不足，难以运转紫阳神功。\n");

        if (me->query_skill("force", 1) < level)
                return notify_fail("你对基本内功的理解还不够，无法继续领会更"
                                   "高深的紫阳神功。\n");

        if (me->query_skill("unarmed", 1) < level)
                return notify_fail("你对基本拳脚的理解还不够，无法继续领会更"
                                   "高深的紫阳神功。\n");
/*
        if (me->query("can_learn/jiuyang-shengong/enable_weapon") &&
            me->query_skill("sword", 1) < level &&
            me->query_skill("blade", 1) < level)
                return notify_fail("你对刀剑功夫的理解还不够，无法继续领会更"
                                   "高深的紫阳神功。\n");

        if (! me->query("can_learn/jiuyang-shengong/enable_weapon"))
        {
                write(HIG "你学会了利用紫阳神功驾御兵器！\n");
                me->set("can_learn/jiuyang-shengong/enable_weapon", 1);
        }
*/
        return 1;
}

mixed valid_damage(object ob, object me, int damage, object weapon)
{
        mapping result;
        int ap, dp;
        int cost;

        if ((int)me->query_skill("jiuyang-shengong", 1) < 150
           || me->query_skill_mapped("parry") != "jiuyang-shengong"
           || me->query_skill_mapped("force") != "jiuyang-shengong"
           || me->query_skill_mapped("unarmed") != "jiuyang-shengong"
           || (int)me->query("neili") < 500
           || ob->query_temp("weapon")
           || ! living(me))
                return;

        cost = damage / 5;

        ap = ob->query_skill("force") * 12 + ob->query("max_neili") + ob->query_skill("count", 1) * 6;
        dp = me->query_skill("force") * 12 + me->query("neili");

        if (ap / 2 + random(ap) < dp)
        {
                me->add("neili", -cost);
                result = ([ "damage": -(damage * 3 / 4) ]);

                switch (random(2))
                {
                case 0:
                        result += (["msg" : HIR "$n" HIR "默念紫阳神功总诀，收敛"
                                            "内劲，承下$N" + HIR "这一招，$N" HIR
                                            "只觉犹如石沉大海，丝毫不起作用。\n"
                                            NOR]);
                        break;
                case 1:
                        result += (["msg" : HIR "$N" HIR "一招击中$n" HIR "上身"
                                            "，可却犹如击在棉花上一般，力道顿时"
                                            "消失得无影无踪。\n" NOR]);
                        break;
                default:
                        result += (["msg" : HIR "但见$n" HIR "微微一笑，浑若无事"
                                            "的接下了$N" HIR "这一招，却没有受到"
                                            "半点伤害。\n" NOR]);
                        break;
                }
                return result;
        }
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
        int lvl;

        lvl = me->query_skill("jiuyang-shengong", 1);

        if (damage_bonus < 150
           || lvl < 150
           || me->query("neili") < 300
           || me->query_skill_mapped("force") != "jiuyang-shengong"
           || me->query_skill_mapped("unarmed") != "jiuyang-shengong"
           || me->query_skill_prepared("unarmed") != "jiuyang-shengong")
		return 0;
        
        if (userp(me) && (! me->query("can_skill/jiuyang-shengong") || me->query("family/family_name") != "明教")) {
                if (damage_bonus > 300)
                        damage_bonus = 300;
        }

        if (damage_bonus / 5 > victim->query_con())
        {
                int new_damage;

                new_damage = (damage_bonus - 150) / 2;
                
                new_damage -= victim->query_temp("apply/armor")/10;

                if (new_damage < 1)
                {
                         new_damage = 1;
                }

	        me->add("neili", -50);
                victim->receive_wound("qi", new_damage, me);
                return random(2) ? HIR "只见$N" HIR "九阳内劲自体内迸发，真气随招式"
                                   "而荡漾，摧毁了$n" HIR "的真元！\n" NOR:

                                   HIR "$N" HIR "紫阳神功的潜力发挥了出来，突然间$n"
                                   HIR "只感喉咙一甜，喷出一口鲜血！\n" NOR;
        }
}

int query_effect_parry(object attacker, object me)
{
        int lvl;

        lvl = me->query_skill("jiuyang-shengong", 1);
        if (lvl < 150) return 0;
        if (lvl < 200) return 50;
        if (lvl < 250) return 60;
        if (lvl < 300) return 70;
        if (lvl < 350) return 80;
        if (lvl < 400) return 90;
        return 100;
}

int practice_skill(object me)
{
        return notify_fail("紫阳神功只能通过读书或研究来增加熟练度。\n");
}

int difficult_level()
{
        return 700;
}

string perform_action_file(string action)
{
        return __DIR__"jiuyang-shengong/perform/" + action;
}

string exert_function_file(string action)
{
        return __DIR__"jiuyang-shengong/exert/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【紫阳神功】" ZJBR NOR;
    msg += WHT "紫阳神功乃天下间一等一的内功心法，以其雄浑刚猛的特性著称。练成此功者，内力源源不绝，刚柔并济，更能以无匹内劲催动拳脚，威力惊人。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  先天悟性不低于 " HIY "25" NOR " 点。" ZJBR;
    msg += "  先天根骨不低于 " HIY "29" NOR " 点。" ZJBR;
    msg += "  最大内力不低于 " HIB "3500" NOR " 点。" ZJBR;
    msg += "  武学修养等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "  基本内功等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "  基本内功等级需大于等于紫阳神功等级。" ZJBR;
    msg += "  基本拳脚等级需大于等于紫阳神功等级。" ZJBR;
    msg += "  性别要求：男性。无性者等级超过 " HIY "49" NOR " 级后无法继续提升。" ZJBR ZJBR;
    // msg += "  门派要求：明教弟子或经张教主指点（非明教弟子学习有功能限制）。" ZJBR ZJBR; // 这段注释掉了，根据实际情况判断是否保留

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  内功（force）。" ZJBR;
    msg += "  拳脚（unarmed）（需明教弟子身份或特殊标记 `can_skill/jiuyang-shengong`）。" ZJBR;
    msg += "  招架（parry）（需明教弟子身份或特殊标记 `can_skill/jiuyang-shengong`）。" ZJBR ZJBR;
    // 兵器激发部分被注释掉了，如果需要，应解除注释并完善 valid_learn 中的相关判断逻辑
    // msg += "  兵器（需要 `can_learn/jiuyang-shengong/enable_weapon` 标记，支持 sword, blade 等）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  无法通过练习提升，只能通过读书或研究提升熟练度。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // hit_ob, valid_damage, query_effect_parry, query_neili_improve, double_attack
    msg += "  " HIW "九阳内劲提升" NOR "：" ZJBR; // query_neili_improve
    msg += "    每提升10级紫阳神功，额外增加内力上限，提升幅度随等级提高而增加。" ZJBR;
    msg += "    计算公式：(等级 / 10) * (等级 / 10) * 15 * 28 / 10 / 20。" ZJBR;
    msg += "  " HIW "九阳无极劲" NOR "：" ZJBR; // hit_ob
    msg += "    触发条件：" ZJBR;
    msg += "      紫阳神功等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      激发内功、拳脚、准备拳脚均为紫阳神功。" ZJBR;
    msg += "      当前内力不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "      普通攻击伤害增益（damage_bonus）不低于 " HIY "150" NOR " 点。" ZJBR;
    msg += "      (伤害增益 / 5) > 目标后天根骨。" ZJBR;
    msg += "    效果：消耗内力 " HIB "50" NOR " 点，对目标造成额外气血伤害，伤害值为 (伤害增益 - 150) / 2 （扣除目标护甲减免，最低为1）。" ZJBR;
    msg += "    限制：非明教弟子且无特殊标记 `can_skill/jiuyang-shengong` 时，伤害增益上限为 " HIY "300" NOR "。" ZJBR;
    msg += "  " HIW "九阳护体" NOR "：" ZJBR; // valid_damage
    msg += "    触发条件：" ZJBR;
    msg += "      紫阳神功等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      激发招架、内功、拳脚均为紫阳神功。" ZJBR;
    msg += "      当前内力不低于 " HIB "500" NOR " 点。" ZJBR;
    msg += "      受到空手攻击。" ZJBR;
    msg += "      (攻击者内功激发等级 * 12 + 攻击者最大内力 + 攻击者阴阳八卦等级 * 6) / 2 + 随机(攻击者攻击力) < (防御者内功激发等级 * 12 + 防御者当前内力)。" ZJBR; // 此处ap/dp逻辑较复杂，简化描述
    msg += "    效果：消耗内力 (伤害值 / 5)，化解本次伤害。" ZJBR;
    msg += "  " HIW "招架增效" NOR "：" ZJBR; // query_effect_parry
    msg += "    紫阳神功等级越高，招架效果越强，最高可达 " HIY "100%" NOR " (400级时)。" ZJBR;
    msg += "  " HIW "双倍攻击" NOR "：" ZJBR; // double_attack
    msg += "    激发紫阳神功时，所有普通攻击均有双倍攻击次数效果。" ZJBR ZJBR;

    msg += HIY "〖内功运用 (Exert)〗" ZJBR NOR;
    msg += HIC "  紫阳战气 (powerup)" ZJBR NOR; // exert/powerup.c
    msg += "    使用要求：" ZJBR;
    msg += "      当前内力不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升自身攻击力 (内功激发等级 * 2 / 5)，提升招架和轻功等级 (内功激发等级 / 3)。" ZJBR;
    msg += "      效果持续时间等于内功激发等级秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      若在战斗中使用，忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  紫阳护罡 (shield)" ZJBR NOR; // exert/shield.c
    msg += "    使用要求：" ZJBR;
    msg += "      紫阳神功等级不低于 " HIY "40" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升自身防御力 (内功激发等级 / 2)。" ZJBR;
    msg += "      效果持续时间等于内功激发等级秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      若在战斗中使用，忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  阳啸空吟 (roar)" ZJBR NOR; // exert/roar.c
    msg += "    使用要求：" ZJBR;
    msg += "      当前内力不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "      不在安全区内。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对周围所有生物进行一次音波攻击。" ZJBR;
    msg += "      命中判定：(自身内功激发等级 / 2 + 随机(自身内功激发等级 / 2)) >= (目标后天根骨 * 2)。" ZJBR;
    msg += "      命中后造成气血伤害，伤害值约为 (自身内功激发等级 - (目标最大内力 / 10)) * 3。" ZJBR;
    msg += "      若目标当前内力低于自身内功激发等级 * 2，额外造成精神伤害，伤害值约为 (自身内功激发等级 - (目标最大内力 / 10)) * 2。" ZJBR;
    msg += "      强制与命中的目标进入战斗状态。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "100" NOR " 点，气血 " HIR "10" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "5" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  真阳疗伤 (lifeheal)" ZJBR NOR; // exert/lifeheal.c
    msg += "    使用要求：" ZJBR;
    msg += "      最大内力不低于 " HIB "1500" NOR " 点。" ZJBR;
    msg += "      当前内力不低于 " HIB "1000" NOR " 点。" ZJBR;
    msg += "      不能对自己使用。" ZJBR;
    msg += "      双方均不能在战斗中。" ZJBR;
    msg += "      目标处于受伤状态 (气血或精神未满)。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      为他人疗伤，恢复目标气血和精神。" ZJBR;
    msg += "      气血恢复量：100 + 自身内功激发等级 + (自身紫阳神功等级 * 3)。" ZJBR;
    msg += "      精神恢复量：100 + (自身内功激发等级 / 3) + 自身紫阳神功等级。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      自身内力 " HIB "800" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "10" NOR " 秒。" ZJBR;
    msg += "      目标忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (Perform)〗" ZJBR NOR;
    msg += HIC "  混沌一阳 (hun)" ZJBR NOR; // perform/hun.c
    msg += "    使用要求：" ZJBR;
    msg += "      紫阳神功等级不低于 " HIY "180" NOR " 级。" ZJBR;
    msg += "      激发拳脚、内功为紫阳神功。" ZJBR;
    msg += "      准备拳脚为紫阳神功。" ZJBR;
    msg += "      空手状态。" ZJBR;
    msg += "      当前内力不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：((自身内功激发等级 + 自身后天根骨) / 2 + 随机(自身攻击力)) >= (目标内功激发等级 + 目标后天根骨)。对NPC命中率提升。" ZJBR;
    msg += "      命中后造成基于内功激发等级的伤害，对NPC伤害提升。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力 " HIB "250" NOR " 点 (50 + 200)，忙乱 " HIR "1" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "50" NOR " 点，忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  金阳破岭 (po)" ZJBR NOR; // perform/po.c  (文件名为 po.c，但招式名是金阳破岭)
    msg += "    使用要求：" ZJBR;
    msg += "      紫阳神功等级不低于 " HIY "220" NOR " 级。" ZJBR;
    msg += "      基本内功等级不低于 " HIY "260" NOR " 级。" ZJBR;
    msg += "      最大内力不低于 " HIB "5500" NOR " 点。" ZJBR;
    msg += "      当前内力不低于 " HIB "400" NOR " 点。" ZJBR;
    msg += "      激发拳脚、内功为紫阳神功。" ZJBR;
    msg += "      准备拳脚为紫阳神功。" ZJBR;
    msg += "      空手状态。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：由 `通用命中公式` 决定（涉及攻防双方拳脚、内功等级等）。对NPC命中率提升。" ZJBR;
    msg += "      命中后造成基于拳脚等级的伤害，对NPC伤害提升。" ZJBR;
    msg += "      命中后额外削减目标内力，削减量约为 (伤害值 / 4) + (伤害值 / 8)。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力 " HIB "350" NOR " 点 (150 + 200)。" ZJBR;
    msg += "      未命中：内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "2-3" NOR " 秒 (2 + random(2))。" ZJBR ZJBR;

    msg += HIC "  骄阳劈天 (pi)" ZJBR NOR; // perform/pi.c
    msg += "    使用要求：" ZJBR;
    msg += "      紫阳神功等级不低于 " HIY "220" NOR " 级。" ZJBR;
    msg += "      基本内功等级不低于 " HIY "260" NOR " 级。" ZJBR;
    msg += "      最大内力不低于 " HIB "5500" NOR " 点。" ZJBR;
    msg += "      当前内力不低于 " HIB "400" NOR " 点。" ZJBR;
    msg += "      激发拳脚、内功为紫阳神功。" ZJBR;
    msg += "      准备拳脚为紫阳神功。" ZJBR;
    msg += "      空手状态。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：由 `通用命中公式` 决定（涉及攻防双方拳脚、内功等级等）。对NPC命中率提升。" ZJBR;
    msg += "      命中后造成基于拳脚等级的伤害，对NPC伤害提升。" ZJBR;
    msg += "      命中后额外削减目标内力，削减量约为 (伤害值 / 4) + (伤害值 / 8)。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力 " HIB "350" NOR " 点 (150 + 200)。" ZJBR;
    msg += "      未命中：内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "2-3" NOR " 秒 (2 + random(2))。" ZJBR ZJBR;

    msg += HIC "  九曦混阳 (jiu)" ZJBR NOR; // perform/jiu.c
    msg += "    使用要求：" ZJBR;
    msg += "      紫阳神功等级不低于 " HIY "200" NOR " 级。" ZJBR;
    msg += "      最大内力不低于 " HIB "6000" NOR " 点。" ZJBR;
    msg += "      当前内力不低于 " HIB "500" NOR " 点。" ZJBR;
    msg += "      激发拳脚、内功为紫阳神功。" ZJBR;
    msg += "      准备拳脚为紫阳神功。" ZJBR;
    msg += "      空手状态。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：由 `通用命中公式` 决定（涉及攻防双方拳脚、招架等级等）。对NPC命中率提升。" ZJBR;
    msg += "      若命中，临时提升自身攻击力 (拳脚激发等级 * 3 / 2)，临时提升空手伤害 (临时攻击力 / 4)。对NPC提升效果翻倍。" ZJBR;
    msg += "      进行多次额外攻击，次数等于 `COMBAT_D->query_base_attack_number`。" ZJBR;
    msg += "      每次额外攻击有几率使目标忙乱 1 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "1-8" NOR " 秒 (1 + random(8))。" ZJBR ZJBR;

    msg += HIC "  魔光日无极 (ri)" ZJBR NOR; // perform/ri.c
    msg += "    使用要求：" ZJBR;
    msg += "      紫阳神功等级不低于 " HIY "250" NOR " 级。" ZJBR;
    msg += "      最大内力不低于 " HIB "8000" NOR " 点。" ZJBR;
    msg += "      当前内力不低于 " HIB "2000" NOR " 点。" ZJBR;
    msg += "      激发拳脚、内功为紫阳神功。" ZJBR;
    msg += "      准备拳脚为紫阳神功。" ZJBR;
    msg += "      空手状态。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对自身周围所有敌人发动范围攻击。" ZJBR;
    msg += "      命中判定：由 `通用命中公式` 决定（涉及攻防双方拳脚/根骨和招架/根骨）。对NPC命中率提升。" ZJBR;
    msg += "      基础伤害：(自身内功激发等级 + 自身拳脚激发等级) * 2。" ZJBR;
    msg += "      伤害加成：" ZJBR;
    msg += "        紫阳神功等级达到 " HIY "300" NOR " 级，额外增加 " HIY "50%" NOR " 伤害。" ZJBR;
    msg += "        每层「光明圣火」意境增加 " HIY "10%" NOR " 伤害。" ZJBR;
    msg += "        若只有一个敌人，额外增加 " HIY "50%" NOR " 伤害。" ZJBR;
    msg += "        对NPC伤害提升。" ZJBR;
    msg += "      命中后对目标造成气血和精神伤害，扣除目标护甲减免。" ZJBR;
    msg += "      气血伤害量等于计算出的总伤害值。" ZJBR;
    msg += "      精神伤害量等于总伤害值的 1/6。" ZJBR;
    msg += "      额外削减目标内力 " HIB "500" NOR " 点。" ZJBR;
    msg += "      命中后目标忙乱 " HIR "1" NOR " 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "1000" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "5" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 绝大部分特殊招式 (`perform`/`exert`) 仅能在战斗中使用。" ZJBR;
    msg += "2. 绝大部分攻击性特殊招式 (`perform`) 需要空手才能施展。" ZJBR;
    msg += "3. 使用特殊招式后通常会伴随一定时间的忙乱状态 (`busy`)。" ZJBR;
    msg += "4. 紫阳神功攻防兼备，威力强大，但对使用者各项资质要求极高。\n";

    return msg;
}