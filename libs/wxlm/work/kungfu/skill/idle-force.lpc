// idle-force.c 发呆神功

inherit SKILL;

string type() { return "knowledge"; }

void skill_improved(object me)
{
}

int valid_learn(object me)
{
	return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【发呆神功】" ZJBR NOR;
    msg += "这是一门非常奇特的知识类技能，似乎与发呆、冥思或放空有关。" ZJBR;
    msg += "其具体作用和用途尚不明确，可能与其他特殊系统或效果相关。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  无特殊要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // type()
    msg += "  知识（knowledge）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // no practice_skill
    msg += "  无法练习。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // no hit_ob, skill_improved is empty
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // no perform/exert
    msg += "  无。" ZJBR;

    return msg;
}
