// zhaixinggong.c 摘星功  based on xiaoyaoyou.c
// modified by Venus Oct.1997
// by yucao

inherit SKILL;

string *dodge_msg = ({
    "$n一个「天外摘星」，跃起数尺，躲过了$N这一招。\n",
    "$n身形向后一纵，使出一招「飘然出尘」，避过了$N的攻击。\n",
    "$n使出「天狼涉水」，恰好躲过了$N的攻势。\n",
    "$n一招「织女穿梭」，姿态美妙地躲了开去。\n"
});

int valid_enable(string usage)
{
    return (usage == "dodge") || (usage == "move");
}

int valid_learn(object me) { return 1; }

string query_dodge_msg(string limb)
{
    return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
    if( (int)me->query("qi") < 50 )
	return notify_fail("你的体力太差了，不能练摘星功。\n");

    me->receive_damage("qi", 40);
    return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【摘星功】" ZJBR NOR;
    msg += WHT "摘星功是星宿派的高级轻功身法，动作轻盈飘逸，共有四式闪避身法：" ZJBR;
    msg += WHT "天外摘星、飘然出尘、天狼涉水、织女穿梭。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  无特殊学习要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  轻功 (dodge)。" ZJBR;
    msg += "  身法 (move)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  当前气血 不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗 气血 " HIR "40" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  流星赶月 (ganyue)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      有效摘星功 等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "      自身未处于『轻功提升』状态 (dodgeup)。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升自身 后天身法，提升值为 (基本摘星功 / 3) 点。" ZJBR;
    msg += "      获得『轻功提升』状态 (dodgeup)，持续时间为 (有效摘星功 / 40 + 2) 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗 内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "1" NOR " 秒。" ZJBR;

    return msg;
}

string perform_action_file(string action)
{
        return __DIR__"zhaixinggong/" + action;
}
