// bafang.c 八方藏刀式
// Lu dexiang

inherit F_SSERVER;
 
string query_name() { return "八方藏刀"; }

int perform(object me, object target)
{
	object weapon;
	string msg;
	int count;
	int i;
	int dao_qi;  // 当前刀气数量
 
	if (! target)
	{
		me->clean_up_enemy();
		target = me->select_opponent();
	}

	if (! target || ! me->is_fighting(target))
		return notify_fail("「八方藏刀式」只能对战斗中的对手使用。\n");
 
	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "blade")
		return notify_fail("手中没刀还使什么「八方藏刀式」！\n");

	if ((int)me->query("neili") < 200)
		return notify_fail("你的真气不够！\n");

	if ((int)me->query_skill("force") < 100)
		return notify_fail("你的内功火候不够！\n");

	if ((int)me->query_skill("hujia-daofa", 1) < 100)
		return notify_fail("你的飞狐刀法还不到家，无法使用「八方藏刀式」！\n");

	if (me->query_skill_mapped("blade") != "hujia-daofa")
		return notify_fail("你没有激发飞狐刀法，无法使用「八方藏刀式」！\n");

    if (! living(target))
	      return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

	msg = HIW "$N" HIW "轻舒猿臂，手中的" + weapon->name() +
	      HIW "吞吞吐吐，变化莫测，笼罩了$n" HIW "周身要害！"NOR"\n";

	dao_qi = me->query_temp("hujia_daoqi", 0);
	
	if (dao_qi > 0)
	{
		msg += HIY "$N" HIY "将体内积蓄的" + chinese_number(dao_qi) + 
		       "缕刀气尽数注入刀中，刀势更显凌厉！"NOR"\n";
		me->set_temp("hujia_cangqi", dao_qi);  // 设置藏气数量
		me->delete_temp("hujia_daoqi");  // 清空刀气
	}

	if (random(me->query_skill("blade")) > target->query_skill("parry") / 2)
	{
		msg += HIY "$n" HIY "见来招实在是变幻莫测，不由得心"
		       "生惧意，招式登时出了破绽！"NOR"\n";
		count = me->query_skill("hujia-daofa", 1) / 6;
	} else
	{
		msg += HIC "$n" HIC "心底微微一惊，打起精神小心接招。"NOR"\n";
		count = 0;
	}
		
	message_combatd(msg, me, target);
	me->add("neili", -150);
	me->add_temp("apply/attack", count);

	for (i = 0; i < COMBAT_D->query_base_attack_number(me,query_name()); i++)
		{
			if (! me->is_fighting(target))
				break;
		if (random(3) == 1 && ! target->is_busy())
			target->start_busy(1);
			COMBAT_D->do_attack(me, target, weapon, 0);
		}

	me->add_temp("apply/attack", -count);
	me->start_busy(1 + random(6));
	return 1;
}
