// pi.c 开天辟地


#include <combat.h>

inherit F_SSERVER;

string query_name() { return "开天"ZJBR"辟地"; }

int perform(object me, object target)
{
	object weapon, weapon2;
	int damage, i, n;
 string msg;
	int ap, dp;

	if (! target)
	{
		me->clean_up_enemy();
		target = me->select_opponent();
	}
	if (! target || ! me->is_fighting(target))
		return notify_fail("「开天辟地」只能对战斗中的对手使用。\n");
 
	if (! objectp(weapon = me->query_temp("weapon")) ||
	    weapon->query("skill_type") != "blade")
		return notify_fail("运用「开天劈地」手中必须有刀！\n");

	if (me->query_skill("hujia-daofa", 1) < 150)
		return notify_fail("你的飞狐刀法不够娴熟，不会使用「开天辟地」。\n");

	if (me->query_skill("force") < 150)
		return notify_fail("你的内功修为不够高。\n");
			
	if (me->query("neili") < 800)
		return notify_fail("你现在内力太弱，不能使用「开天劈地」。\n");

	if (userp(me) && ! me->query("can_perform/hujia-daofa/pi"))
		return notify_fail("你还不会使用「开天辟地」这一绝技。\n");

    if (! living(target))
	      return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

	msg = HIC "$N" HIC "一声长笑，中宫直进，双手紧握" + weapon->name() +
	      HIC "刀柄，长吸一口气，全力向$n" HIC "迅猛劈去！"NOR"\n";

	if (target->query_temp("lengyue-shengong_freeze"))
	{
		msg += HIW + weapon->name() +
		HIW "寒气逼人，刀身撕裂空气，片片雪花飘落，刀未至气先及，$n" HIW
		"眉毛都蒙上了薄薄白霜！"NOR"\n";
	}

	ap = me->query_skill("blade")+me->query("str")*10;
	dp = target->query_skill("force")+target->query("str")*10;

	//pve命中 * 50%
	if (!playerp(target))
	{
		ap = ap * 15 / 10;
	}

	if (COMBAT_D->hit_determination(me,target,ap,dp))
	{
		int aoyi_level, overflow_bonus;
		damage = ap * 3 + random(me->query("max_neili") / 5);
		damage += me->query("jiali");

		me->add("neili", -300);

		aoyi_level = COMBAT_D->get_skill_aoyi_level(me, "胡马嘶风");

		if (playerp(me))
		{
			if (target->query("neili") > aoyi_level * target->query("neili") / 100 + 100)
			{
				target->add("neili", -(aoyi_level * target->query("neili") / 100 + 100));
			} else
			{
				target->set("neili", 0);
			}
		}

		//pve伤害x1.5
		if (!playerp(target))
		{
			damage = damage * 15 / 10;
		}

		//溢出奥义等级伤害加成
		if (aoyi_level > 10)
		{
			overflow_bonus = (aoyi_level - 10) * 5;
			damage += damage * overflow_bonus / 100;
			msg += HIY "$N" HIY "的胡马嘶风奥义登峰造极，溢出的" + chinese_number(aoyi_level - 10) +
				   "级奥义为此招增加了" + overflow_bonus + "%的伤害！"NOR"\n";
		}

		//获得一缕刀气
		if (me->query_temp("hujia_daoqi") < 8 + aoyi_level)
		{
			me->add_temp("hujia_daoqi", 1);

			msg += HIC "$N" HIC "的刀势凝聚出一缕刀气[" +sprintf("%d/8", me->query_temp("hujia_daoqi")) + "]！"NOR"\n";

            if ((random(10) + 1) < aoyi_level)
            {
                msg += HIC "由于$N对胡马嘶风意境感悟颇深,多获得了1缕刀气，$N" HIC "的刀势再次凝聚出一缕刀气[" +sprintf("%d/8", me->query_temp("hujia_daoqi")) + "]！"NOR"\n";
                me->add_temp("hujia_daoqi", 1);
            }
		}

		//如果藏气，每一缕藏入刀中的刀气增加25%伤害
		if (me->query_temp("hujia_cangqi") > 0)
		{
			damage += damage * me->query_temp("hujia_cangqi") * 25 / 100;
			msg += HIC "$N" HIC "逼出藏在刀中的" + chinese_number(me->query_temp("hujia_cangqi")) + "缕刀气，刀势更显凌厉，伤害系数增加" + (me->query_temp("hujia_cangqi") * 15) + "%！"NOR"\n";
			me->delete_temp("hujia_cangqi");
		}
		
		if (! objectp(weapon2 = target->query_temp("weapon")))
		{       
			msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 100,
						       HIR "只见$n" HIR "一声惨叫，胸口给"
						       "劈开一个巨大的口子，鲜血汹涌喷出！"NOR"\n");

			if (target->query_temp("lengyue-shengong_freeze"))
				msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 33,
							   HIB "\n$n" HIB "身形摇晃间，感觉到"
							   + weapon->name() + HIB + 
							   "上一阵刺骨的寒气侵入体内，复又喷出"
							   "一口鲜血！"NOR"\n");
		} else
		{
			if (weapon2->is_item_make() || weapon2->query("damage") > 180 || weapon2->query("skill_type") == "hammer" )
			{
				msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 100,
							   HIG "$p" HIG "横过" + weapon2->name() + HIG "试图招架，"
							   HIG "怎奈这刀气如此犀利，透过" + weapon2->name() +
							   HIG "直震得$p" HIG "狂吐鲜血，五脏六腑都要翻转过来，已经把握不住兵器！"NOR"\n");
				if (playerp(me))
					weapon2->move(environment(target));
			}
			else
			{
				msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 70,
							   HIR "$n" HIR "见状不妙，连忙举起" + 
							   weapon2->name() + HIR + "抵挡，在$N" HIR
							   "这霸气无双的一招下，" + weapon2->name() +
							   HIR "给震成碎片！"NOR"\n");
				n = 2 + random(3);
				for (i = 0; i < n; i++)
				{
					msg += (random(2) ? HIB : HIC) + "碎片四散飞溅，射入了$n的身体！"NOR"\n";
					COMBAT_D->real_damage(me, target, damage / 7);
					//输出伤害
					msg += HIC "$n" HIC "受到碎片伤害为" + HIR + chinese_number(damage / 7) + HIR "！"NOR"\n";
				}

				msg += "\n" + HIY + weapon->name() + HIY "余势未尽，又劈入了$n" + HIY + 
					"的胸口，$n遭此重创，鲜血狂喷而出！"NOR"\n";

				weapon2->set_name("碎裂的" + weapon2->query("name"));
				weapon2->move(environment(target));
				weapon2->set("value", 0);
				weapon2->set("weapon_prop", 0);
			}

			target->reset_action();
			COMBAT_D->real_damage(me, target, damage / 2);

			if (target->query_temp("lengyue-shengong_freeze"))
				msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 45,
							   HIB "\n$n" HIB "身形摇晃间，感觉到"
							   + weapon->name() + HIB + 
							   "上一阵刺骨的寒气侵入体内，复又喷出"
							   "一口鲜血！"NOR"\n");
		}
		me->start_busy(3);
		target->start_busy(1 + random(2));
	} else 
	{
		msg += HIY "$n" HIY "见势不妙，抽身急退，险险避过$N"
		       HIY "的这记开天辟地，尘土飞扬中，地上裂开了一道大口子！"NOR"\n";
		me->add("neili", -100);
		me->start_busy(3);
	}
	
	message_sort(msg, me, target);

	return 1;
}