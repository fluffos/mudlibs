inherit SKILL;
// string type() { return "knowledge"; }

mixed query_fuzhu()  { return "dodge";}

int valid_learn(object me)
{

        return 1;
}

int difficult_level()
{
        return 200;
}

string query_description()
{
    string msg;

    msg = HIY "【轻功秘要】" ZJBR NOR;
    msg += WHT "记载了高深轻功原理和技巧的秘籍，研读后可以辅助提升轻功 (dodge) 类技能的效果。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  无特定限制。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  辅助技能 (fuzhu)，辅助 轻功 (dodge)。" ZJBR ZJBR; // query_fuzhu()

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  无法通过练习 (practice) 提高，可能需要通过研读 (learn) 或其他方式提升等级。" ZJBR ZJBR; // 无 practice_skill

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  提升已学习的轻功类技能的效率或效果。" ZJBR;
    msg += "  学习难度较高 (" + difficult_level() + ")。" ZJBR ZJBR; // difficult_level()

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    return msg;
}
