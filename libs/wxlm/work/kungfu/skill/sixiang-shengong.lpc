// 四象神功

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_learn(object me)
{
    if ((int)me->query("max_neili") < 100)
        return notify_fail("你的内力太弱，无法练习四象神功。\n");
    return 1;
}

int practice_skill(object me)
{
    return notify_fail("四象神功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
    return __DIR__"sixiang-shengong/" + func;
}

int valid_force(string force)
{
    return force == "sixiang-shengong" || force == "huntian-qigong";
}

int difficult_level()
{
    return 200;
}

int query_neili_improve(object me)
{
        int lvl;

        lvl = (int)me->query_skill("sixiang-shengong", 1);
        return lvl / 10 * lvl / 10 * 15 * 25 / 10 / 20;
}

string query_description()
{
    string msg;

    msg = HIY "【四象神功】" ZJBR NOR;
    msg += WHT "四象门镇派内功，融合青龙、白虎、朱雀、玄武四象之力，内力精纯浑厚。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力不低于 " HIB "100" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功 (force)。" ZJBR;
    msg += "  可作为 " HIW "混天功 (huntian-qigong)" NOR " 的前置内功。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  四象神功只能通过学习 (learn) 来提升熟练度。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  内力上限提升：" ZJBR;
    msg += "    提升值约为 ((四象神功等级 / 10) * (四象神功等级 / 10) * 15 * 25 / 10 / 20)。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (内功运用 exert)〗" ZJBR NOR;
    msg += HIC "  四象归元 (guiyuan)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      基本四象神功 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "500" NOR " 点。" ZJBR;
    msg += "      有效气血 或 内力 未满。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      恢复自身有效气血 (`eff_qi`)，恢复量为 激发内功等级x2 点 (不超过最大气血)。" ZJBR;
    msg += "      恢复自身内力 (`neili`)，恢复量为 (激发内功等级) 点 (不超过最大内力)。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      忙乱 " HIR "0" NOR " 秒。" ZJBR;
    msg += "      进入四象归元封闭状态，无法使用四象归元。" ZJBR;

    msg += HIC "  四象真罡 (shield)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      四象神功 " HIY "40" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      在一段时间内，提升自身护甲、招架等级和轻功等级，提升值为激发内功等级的 1/3 。" ZJBR;
    msg += "      持续时间为 激发内功等级 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      若在战斗中使用，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;

    return msg;
}
