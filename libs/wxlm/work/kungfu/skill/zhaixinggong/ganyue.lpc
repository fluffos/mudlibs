 
// ganyue.c 流星赶月


#include <combat.h>

inherit F_SSERVER;

string query_name() { return "流星赶月"; }

int perform(object me, object target)
{
    string msg;
    int skill;

    if (me->query_skill("zhaixinggong", 1) < 120)
        return notify_fail("你的摘星功不够娴熟，无法施展「流星赶月」。\n");

    if (me->query("neili") < 200)
        return notify_fail("你的内力不足，无法施展「流星赶月」。\n");

    if (me->query_temp("zhaixing_ganyue"))
        return notify_fail("你已经在运功中了。\n");

    msg = HIY "$N" HIY "身形一展，施展出「流星赶月」，速度骤然提升！\n" NOR;
    message_combatd(msg, me);

    skill = me->query_skill("zhaixinggong", 1) / 2;
    me->add_temp("apply/dodge", skill);
    me->set_temp("zhaixing_ganyue", 1);
    me->add("neili", -150);

    me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill :), skill / 10);

    me->start_busy(1);
    return 1;
}

void remove_effect(object me, int amount)
{
    if ((int)me->query_temp("zhaixing_ganyue"))
    {
        me->add_temp("apply/dodge", -amount);
        me->delete_temp("zhaixing_ganyue");
        tell_object(me, "你的「流星赶月」运行完毕，身形速度恢复正常。\n");
    }
}