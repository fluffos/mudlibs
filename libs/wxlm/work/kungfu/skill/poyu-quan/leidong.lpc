// leidong 雷动九天
// by winder 98.12



inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

string query_name() { return "雷动"ZJBR"九天"; }

int perform(object me)
{
	int skill, count;

	if ((int)me->query_temp("leidong"))
		return notify_fail("你已经在运功中了。\n");

	if ((int)me->query("neili") < 500)
		return notify_fail("你现在的真气不够。\n");

	skill = me->query_skill("poyu-quan", 1);
	if (skill < 135)
		return notify_fail("你的破玉拳修为还不够。\n");

	me->add("neili", -400);
	message_combatd(HIM "$N" HIM "深深吸了一口气，脸上顿时"
			"紫气大盛，出手越来越重！"NOR"\n", me);

	count = skill / 10;

	if (me->is_fighting())
		me->start_busy(2);

	me->add_temp("str_po", count);
	me->add_temp("dex", count);
	me->set_temp("leidong", 1);
	me->start_call_out((: call_other,  __FILE__, "remove_effect", me, count :), skill / 3);

	return 1;
}

void remove_effect(object me, int amount)
{
	if ((int)me->query_temp("leidong"))
	{
		me->add_temp("str_po", -amount);
		me->add_temp("dex", -amount);
		me->delete_temp("leidong");
		tell_object(me, CYN "你的雷动九天运行完毕，将内力收回丹田。"NOR"\n");
	}
}

string query_txt()
{
	return @DESC
“雷动九天”是一种以内力为基础，增强自身物理属性的特殊技能。施展此技能时，施术者将调动体内真气，短时间内显著提升自己的膂力（str）与身法（dex）。此技能适用于战斗中需要爆发力或敏捷度的情况，可以有效提高攻击与闪避能力。
施展条件：
施术者当前真气（内力）值需高于500点。
破玉拳技能的基本等级至少为135级。
施术者不能已在运功状态中。
施展效果：
施术者消耗400点真气。
施术者膂力与身法临时增加，增加量为破玉拳技能等级除以10（向下取整）。
效果持续时间为破玉拳技能等级除以3的回合数。
若施术者正在战斗中，将进入2回合的忙乱状态，无法进行其他行动。
技能结束后，施术者膂力与身法回归原状，同时收到技能结束的提示信息。
DESC;
}