// poshi.c 破石一击


#include <combat.h>

inherit F_SSERVER;

string query_name() { return "破石"ZJBR"一击"; }
string *pfm_type() { return ({ "cuff", }); }

int perform(object me, object target)
{
 
	int damage;
	string msg;
	int ap, dp;

	if (! target)
	{
		me->clean_up_enemy();
		target = me->select_opponent();
	}
	if (! target || ! me->is_fighting(target))
		return notify_fail("「破石一击」只能对战斗中的对手使用。\n");

	if ((int)me->query_skill("poyu-quan", 1) < 120)
		return notify_fail("你的破玉拳不够娴熟，不会使用「破石一击」。\n");
				
	if ((int)me->query_skill("force") < 150)
		return notify_fail("你的内功修为还不够高，难以运用「破石一击」。\n");
			
	if ((int)me->query("neili") < 300)
		return notify_fail("你现在真气不够，不能使用「破石一击」。\n");

	if (me->query_skill_mapped("cuff") != "poyu-quan")
		return notify_fail("你没有激发破玉拳，不能使用「破石一击」。\n");

       if (! living(target))
	      return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

	msg = HIY "$N" HIY "大喝一声，拳头如闪电一般重重的击向$n" HIY "。"NOR"\n";

	ap = me->query_skill("force") + me->query_str() * 10;
	dp = target->query_skill("force") + target->query_str() * 10;
	if (COMBAT_D->hit_determination(me,target,ap,dp))
	{
		damage = ap + (int)me->query_skill("cuff");
		damage = damage / 5;
		damage += random(damage);

		me->add("neili", -200);
		msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 40,
					   HIR "只见$P" HIR "这一拳把$p" HIR
					   "打飞了出去，重重的摔在地上，吐血不止！"NOR"\n");
		me->start_busy(2);
	} else 
	{
		msg += HIC "可是$p" HIC "奋力招架，硬生生的挡开了$P"
		       HIC "这一招。"NOR"\n";
		me->add("neili", -100);
		me->start_busy(3);
	}
	message_combatd(msg, me, target);

	return 1;
}

string query_txt()
{
	return @DESC
招式简介：
“破石一击”是破玉拳法中的一种强力攻击招式，旨在通过集中全身力量于一点，产生巨大的破坏力，从而击溃对手。此招式要求施术者具备深厚的内功修为与足够的膂力支撑。
施展条件：
施术者破玉拳法的基本技能等级至少为120级。
施术者内功修为至少为150级。
施术者当前真气（内力）值需达到300点以上。
施术者当前激活的拳法技能必须是破玉拳。
目标必须是活着的，并且正在与施术者交战。
施展流程：
施术者发出震耳欲聋的大喝，拳头以迅雷不及掩耳之势击向目标。
攻击力（AP）计算：施术者内功修为加上膂力属性乘以10。
防御力（DP）计算：目标的内功修为加上膂力属性乘以10。
命中判定：若AP除以2加上随机AP值大于DP，则招式命中。
若招式命中：
施术者消耗200点真气。
伤害计算：基于施术者拳法技能等级与膂力的总和，然后除以5，再加随机数，最终伤害系数为40%。
目标被击飞并摔在地上，受到严重伤害。
施术者进入2回合的忙乱状态。
若招式未命中：
施术者消耗100点真气。
目标成功防御，施术者进入3回合的忙乱状态。
DESC;
}