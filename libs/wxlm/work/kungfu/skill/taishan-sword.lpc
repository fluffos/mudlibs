inherit SKILL;

mapping *action = ({
([      "skill_name":    "朗月无云",
	"action":  "$N手中$w一晃，向右滑出三步，一招“朗月无云”，转过身来，身"
		   "子微矮，$w向$n斜斜刺去",
	"force" : 80,
	"dodge" : 20,
	"damage": 12,
	"lvl"   : 0,
	"damage_type":  "刺伤"
]),
([      "skill_name":    "峻岭横空",
	"action": "$N手中$w圈转，一招「峻岭横空」去势奇疾，无数剑光刺向$n的$l",
	"force" : 100,
	"dodge" : 30,
	"damage": 15,
	"lvl"   : 30,
	"damage_type":  "刺伤"
]),
([      "skill_name":    "泰山十八盘",
	"action": "$N展开剑势，身随剑走，左边一拐，右边一弯，越转越急。猛地"
		  "$w剑光暴长，一招「泰山十八盘」往$n$l刺去",
	"force" : 120,
	"dodge" : 40,
	"damage": 20,
	"lvl"   : 60,
	"damage_type":  "刺伤"
]),
([      "skill_name":    "五大夫剑",
	"action": "$N手中$w倏地刺出，一连五剑，每一剑的剑招皆苍然有古意。招数"
		  "古朴，内藏奇变，正是「五大夫剑」",
	"force" : 140,
	"dodge" : 45,
	"damage": 30,
	"lvl"   : 90,
	"damage_type":  "刺伤"
]),
([      "skill_name":    "岱宗如何",
	"action": "$N右手$w斜指而下，左手五指正在屈指而数，从一数到五，握而成拳，又"
		  "将拇指伸出，次而食指，终至五指全展，跟着又屈拇指而屈食指，再屈中"
		  "指，然后手中$w剑光暴长，向$n的$l刺去",
	"force" : 220,
	"attack": 100,
	"dodge" : 80,
	"damage": 80,
	"lvl"   : 180,
	"damage_type":  "刺伤"
]),
});

int valid_learn(object me)
{
    object ob;
    if( (int)me->query("max_neili") < 150 )
	return notify_fail("你的内力不够，没有办法练泰山剑法。\n");

    if( (int)me->query_skill("force") < 30 )
	return notify_fail("你的内力不够，没有办法练泰山剑法。\n");

    if( !(ob = me->query_temp("weapon"))
    ||      (string)ob->query("skill_type") != "sword" )
	return notify_fail("你必须先找一把剑才能练剑法。\n");

    return 1;
}

int valid_enable(string usage)
{
    return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
    return action[random(sizeof(action))];
}

int practice_skill(object me)
{
    if ((int)me->query("qi") < 40)
	return notify_fail("你的内力或气不够，没有办法练习泰山剑法。\n");

    if ((int)me->query("neili") < 35)
	return notify_fail("你的内力或气不够，没有办法练习泰山剑法。\n");

    me->receive_damage("qi", 30);
    me->add("neili", -11);
    return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【泰山剑法】" ZJBR NOR;
    msg += "泰山剑法源自泰山派，以泰山地势特点而创，招式古朴而内涵丰富，刚猛直接。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力：" HIB "150" NOR " 点。" ZJBR;
    msg += "  基本内功等级：" HIY "30" NOR " 级。" ZJBR;
    msg += "  需持剑器。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  剑法（sword）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "40" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "35" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "30" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "11" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖招式组成〗" ZJBR NOR;
    msg += HIC "  朗月无云" NOR "（1级可用）" ZJBR;
    msg += "    命中修正：" HIY "+20" NOR "，伤害修正：" HIR "+12" NOR "，内力消耗：" HIB "80" NOR " 点。" ZJBR;
    msg += "    $N手中兵器一晃，向右滑出三步，转过身来，身子微矮，兵器向$n斜斜刺去。" ZJBR ZJBR;

    msg += HIC "  峻岭横空" NOR "（30级可用）" ZJBR;
    msg += "    命中修正：" HIY "+30" NOR "，伤害修正：" HIR "+15" NOR "，内力消耗：" HIB "100" NOR " 点。" ZJBR;
    msg += "    $N手中兵器圈转，无数剑光疾速刺向$n的要害。" ZJBR ZJBR;

    msg += HIC "  泰山十八盘" NOR "（60级可用）" ZJBR;
    msg += "    命中修正：" HIY "+40" NOR "，伤害修正：" HIR "+20" NOR "，内力消耗：" HIB "120" NOR " 点。" ZJBR;
    msg += "    $N展开剑势，身随剑走，左边一拐，右边一弯，越转越急，猛地剑光暴长刺向$n。" ZJBR ZJBR;

    msg += HIC "  五大夫剑" NOR "（90级可用）" ZJBR;
    msg += "    命中修正：" HIY "+45" NOR "，伤害修正：" HIR "+30" NOR "，内力消耗：" HIB "140" NOR " 点。" ZJBR;
    msg += "    $N手中兵器倏地刺出，一连五剑，招数古朴，内藏奇变。" ZJBR ZJBR;

    msg += HIC "  岱宗如何" NOR "（180级可用）" ZJBR;
    msg += "    攻击修正：" HIY "+100" NOR "，命中修正：" HIY "+80" NOR "，伤害修正：" HIR "+80" NOR "，内力消耗：" HIB "220" NOR " 点。" ZJBR;
    msg += "    $N右手兵器斜指而下，左手五指正在屈指而数，展现特殊指法，然后兵器剑光暴长刺向$n。" ZJBR;

    return msg;
}

