// 钓鱼技巧

inherit SKILL;

void create() { seteuid(getuid()); }

string type() { return "knowledge"; }

int practice_skill(object me)
{	
	return notify_fail("钓鱼技巧只能通过磨练钓鱼技巧来提升。\n");
}
int valid_learn(object me)
{
	return notify_fail("钓鱼技巧只能通过磨练钓鱼技巧来提升。\n");
}

string query_description()
{
    string msg;

    msg = HIY "【钓鱼技巧】" ZJBR NOR;
    msg += WHT "钓鱼技巧是一种通过钓鱼来提升钓鱼水平的技能。" ZJBR ZJBR; // 基础介绍

    msg += HIY "〖技能类型〗" ZJBR NOR;
    msg += "  知识类技能" ZJBR ZJBR;

    msg += HIY "〖特殊效果〗" ZJBR NOR;
    msg += "  越高的钓鱼技巧水平提高的钓鱼收益就越多" ZJBR ZJBR;

    return msg;
}