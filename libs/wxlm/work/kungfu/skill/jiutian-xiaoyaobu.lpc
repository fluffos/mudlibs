// This program is a part of NITAN MudLIB



inherit SKILL;

string *dodge_msg = ({
        "$n身形左闪右晃，姿势潇洒之极，一招[飞升九天]轻巧地躲开$N的进攻。\n",
        "$n宛如一屡青烟，飘忽不定，令人琢磨不定，一招[魔神无形]闪到了$N的身后。\n",
        "$n姿态幽雅之极，躲闪之中丝毫不显狼狈之态，一招[上天入地]避开了$N的攻击。\n",
        "$n身形突然连晃数下，宛如云雾中的幻灵，一招[洞彻九幽]躲开了$N的攻击。\n",
});

int valid_enable(string usage)
{
        return usage == "dodge";
}

int valid_learn(object me)
{
        int lvl;

        lvl = me->query_skill("jiutian-xiaoyaobu", 1);
        if (lvl > 300) lvl = 300;

        if (me->query("max_neili") < 2000)
                return notify_fail("你试着走了两步，顿觉胸"
                                   "口烦恶之极，看来是内力不济。\n");
        return 1;
}

string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

mixed valid_damage(object ob, object me, int damage, object weapon)
{
        mixed result;
        int ap, dp, mp;

        if ((int)me->query_skill("jiutian-xiaoyaobu", 1) < 100 ||
            ob->query("family/family_name") == "少林派" ||
            ! living(me))
                return;

        mp = ob->query_skill("count", 1);
        ap = ob->query_skill("dodge") + mp;
        dp = me->query_skill("dodge", 1) * 3/5 +
             me->query_skill("jiutian-xiaoyaobu", 1);

        if (ap / 2 + random(ap) < dp)
        {
                result = ([ "damage": -(damage * 3 / 4) ]);

                result += (["msg" : HIW "$n" HIW "身形如同鬼魅般地晃动了几下，如流星一般躲开了$N"
                                    HIW "的攻击。\n" NOR]);

                return result;
        } else
        if (mp >= 100)
        {
                result = HIY "$n" HIY "身形如同鬼魅般地晃动了几下，可是$N"
                         HIY "反应奇快，身形一闪，拦住了$n" HIY "的去路\n" NOR;

                COMBAT_D->set_bhinfo(result);
        }
}

int query_effect_dodge(object attacker, object me)
{
        int lvl;

        lvl = me->query_skill("jiutian-xiaoyaobu", 1);
        if (lvl < 50)  return 0;
        if (lvl < 100) return 30;
        if (lvl < 150) return 50;
        if (lvl < 200) return 80;
        if (lvl < 250) return 100;
        if (lvl < 300) return 120;
        if (lvl < 350) return 140;
        return 150;
}

int practice_skill(object me)
{
        if ((int)me->query("qi") < 70)
                return notify_fail("你的体力太差了，难以练习九天逍遥步。\n");

        if ((int)me->query("neili") < 70)
                return notify_fail("你的内力不够了，无法练习九天逍遥步。\n");

        me->receive_damage("qi", 65);
        me->add("neili", -65);
        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"jiutian-xiaoyaobu/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【九天逍遥步】" ZJBR ZJBR NOR;
    msg += WHT "极为精妙的轻功步法，身形飘忽不定，宛如鬼魅。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力 " HIB "2000" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  轻功 (dodge)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "65" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "65" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  被动提升轻功有效等级 (`query_effect_dodge`)：" ZJBR;
    msg += "    50-99 级：+30" ZJBR;
    msg += "    100-149 级：+50" ZJBR;
    msg += "    150-199 级：+80" ZJBR;
    msg += "    200-249 级：+100" ZJBR;
    msg += "    250-299 级：+120" ZJBR;
    msg += "    300-349 级：+140" ZJBR;
    msg += "    350+ 级：+150" ZJBR;
    msg += "  受攻击时概率性完全闪避 (`valid_damage`)：" ZJBR;
    msg += "    触发条件：" ZJBR;
    msg += "      自身九天逍遥步等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      攻击者非少林派。" ZJBR;
    msg += "      自身存活。" ZJBR;
    msg += "    判定方式：(攻击者轻功激发+攻击者阴阳八卦等级)/2 + 随机(攻击者轻功激发+攻击者机关术等级) < (自身轻功激发*3/5 + 自身九天逍遥步等级)。" ZJBR;
    msg += "    判定成功：完全闪避该次攻击，伤害为 0。" ZJBR;
    msg += "    判定失败（且攻击者阴阳八卦等级 >= 100）：可能给出特殊提示信息。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  可能存在但未提供相关文件。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. `valid_damage` 的闪避效果对少林派无效。" ZJBR;
    msg += "2. 阴阳八卦（count）会影响 `valid_damage` 的判定。\n";

    return msg;
}
