#define CN_NAME "君子剑法"
inherit SKILL;

mapping *action = ({
([ 	"action": "$N使一招「君子求偶」，手中的$w在一弹指间已向$n的$l连刺数剑",
	"force" : 300,
	"attack": 85,
	"dodge" : 10,
	"parry" : 5,
	"damage": 100,
	"lvl"   : 0,
	"skill_name" : "君子剑法",
	"damage_type":  "瘀伤"
]),
([  	"action": "$N使一招「取财有道」，手中$w狂风骤雨般地向$n的$l连攻数剑",
	"force" : 350,
	"attack": 25,
	"dodge" : 15,
	"parry" : 10,
	"damage": 610,
	"lvl"   : 30,
	"skill_name" : "君子剑法",
	"damage_type":  "瘀伤"
]),
});

string query_txt()
{
	return "要求：基本剑法 150级";
}

int valid_learn(object me)
{
	if ((int)me->query_skill("sword", 1) < 150)
		return notify_fail("你的剑法根基有限，无法学习君子剑法。\n");
	return 1;
}

int valid_enable(string usage)
{
	return usage == "sword" ;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action)-1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int)me->query_skill("junzi-jian", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i - 1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 60)
		return notify_fail("你现在手足酸软，休息一下再练吧。\n");

	if ((int)me->query("neili") < 80)
		return notify_fail("你的内力不够了。\n");

	me->receive_damage("qi", 50);
	me->add("neili", -60);

	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"long-hu-jin/" + action;
}

string query_description()
{
    string msg;

    msg = HIM "【君子剑法】" NOR ZJBR ZJBR;
    msg += WHT "君子剑法据传为华山派宿儒所创，剑招大开大阖，端正大气，颇有君子之风。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  基本剑法 (sword) 不低于 " HIY "150" NOR " 级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  剑法 (sword)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  气血 (qi) 不低于 " HIR "60" NOR " 点。" ZJBR;
    msg += "  内力 (neili) 不低于 " HIB "80" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "60" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // hit_ob, valid_damage, skill_improved etc.
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (Perform)〗" ZJBR NOR;
    // perform_action_file 指向了错误的目录 (long-hu-jin)，且没有找到 junzi-jian 的特殊招式目录。
    // 暂时假设无特殊招式。
    msg += "  暂无特殊招式。" ZJBR ZJBR;


    return msg;
}