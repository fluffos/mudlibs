// zihui-xinfa 紫徽心法

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int query_neili_improve(object me)
{
	int lvl;

	lvl = (int)me->query_skill("zihui-xinfa", 1);
	return lvl * lvl * 15 * 7 / 100 / 200;
}

int valid_learn(object me)
{
	/*if (me->query("gender") == "无性" && (int)me->query_skill("zihui-xinfa", 1) > 49)
		return notify_fail("你无根无性，阴阳不调，难以领会更高深的紫徽心法。\n");
*/
	if ((int)me->query_skill("force", 1) < 20)
		return notify_fail("你的基本内功火候还不够，还不能学习紫徽心法。\n");

	return ::valid_learn(me);
}

int practice_skill(object me)
{
	return notify_fail("紫徽心法只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"zihui-xinfa/" + func;
}


string query_description()
{
    string msg;

    msg = HIM "【紫徽心法】" ZJBR NOR;
    msg += WHT "紫徽心法是一门高深的内功心法，注重内外兼修。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功 等级：" HIY "20" NOR " 级。" ZJBR ZJBR;
    // msg += "  性别要求：非 无性 (紫徽心法 50 级以上时)。" ZJBR ZJBR; // 已注释掉

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功 (force)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  紫徽心法只能通过学习 (learn) 提升，无法练习 (practice)。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  提升最大内力：提升值为 (紫徽心法等级 * 紫徽心法等级 * 15 * 7 / 100 / 200) 点。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  紫薇真气 (powerup)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      当前内力 不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      临时提升自身的攻击和轻功有效激发。" ZJBR;
    msg += "      提升数值：(内功有效激发 / 3) 点。" ZJBR;
    msg += "      持续时间：(内功有效激发) 秒。" ZJBR;
    msg += "      发动时按北斗方位连踏七步。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "3" NOR " 秒 (如果在战斗中)。" ZJBR;

    return msg;
}