// canhezhi.c 参星指

inherit SKILL;

mapping *action = ({
([      "action": "$N双指并拢，一式「三心焚净」，一指戳向$n的胸腹间",
	"force" : 340,
	"attack": 85,
	"dodge" : 75,
	"parry" : 70,
	"damage": 72,
	"skill_name" : "三心焚净",
	"damage_type" : "刺伤"
]),
([      "action": "$N左掌护胸，一式「顿心自瞭」，右手中指前后划了个半弧，猛地一甩，疾点$n的$l",
	"force" : 370,
	"attack": 65,
	"dodge" : 80,
	"parry" : 85,
	"damage": 65,
	"skill_name" : "顿心自瞭",
	"damage_type" : "刺伤"
]),
([      "action": "$N身形闪动，一式「青叶荷莲」，双手十指同时"
		  "按向$n的全身要穴",
	"force" : 360,
	"attack": 85,
	"dodge" : 70,
	"parry" : 75,
	"damage": 90,
	"skill_name" : "青叶荷莲",
	"damage_type" : "刺伤"
]),
([      "action": "$N一式「清心悟明」，左手握拳托肘，右手拇指直立，遥"
		  "遥对着$n一捺",
	"force" : 380,
	"attack": 95,
	"dodge" : 75,
	"parry" : 85,
	"damage": 70,
	"skill_name" : "清心悟明",
	"damage_type" : "刺伤"
])
});

int valid_enable(string usage) { return usage == "finger" || usage == "parry"; }

int valid_combine(string combo) { return combo == "qixing-quan"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练参星指必须空手。\n");

	if ((int)me->query_skill("force") < 100)
		return notify_fail("你的内功火候不够，无法学参星指。\n");

	if ((int)me->query("max_neili") < 500)
		return notify_fail("你的内力太弱，无法练参星指。\n");

	if ((int)me->query_skill("finger", 1) < (int)me->query_skill("canhe-zhi", 1))
		return notify_fail("你的基本指法水平有限，无法领会更高深的参星指。\n");

	return 1;
}

string query_skill_name(int level)
{
	return action[random(sizeof(action))]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 80)
		return notify_fail("你的内力不够练参星指。\n");

	me->receive_damage("qi", 62);
	me->add("neili", -70);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"canhe-zhi/" + action;
}
string query_description()
{
    string msg;

    msg = "";
    msg += HIY "【参合指】" ZJBR ZJBR NOR;
    msg += WHT "参合指是一门精妙绝伦的指法武功，源自少林派。此功法以其变化多端、指力刚柔并济而闻名。" ZJBR;
    msg += "参合指讲究以巧破力，以快打慢，招式看似平平无奇，实则暗藏杀机。" ZJBR;
    msg += "修炼者需要极高的悟性和灵活的手指，方能领会其中奥妙。" ZJBR ZJBR;

    msg += HIY "【学习要求】" ZJBR NOR;
    msg += "  最大内力 500 点" ZJBR;
    msg += "  基本内功等级 100 级" ZJBR;
    msg += "  参合指等级不能超过基本指法等级" ZJBR ZJBR;

    msg += HIY "【练习要求】" ZJBR NOR;
    msg += "  需要空手" ZJBR;
    msg += "  气血不少于 70 点" ZJBR;
    msg += "  内力不少于 80 点" ZJBR;
    msg += "  每次练习消耗：" ZJBR;
    msg += "    - 气血：62 点" ZJBR;
    msg += "    - 内力：70 点" ZJBR ZJBR;

    msg += HIY "【技能效果】" ZJBR NOR;
    msg += "  可激发为指法（finger）或招架（parry）" ZJBR;
    msg += "  可与七星拳（qixing-quan）互备" ZJBR ZJBR;

    msg += HIY "【特殊招式】" ZJBR NOR;
    msg += HIW "1. 参合破玉（poyu）：" ZJBR NOR;
    msg += "  要求：参合指180级，内功300级，内力3000点" ZJBR;
    msg += "  内力消耗：300点" ZJBR;
    msg += "  效果：对敌人造成巨大伤害" ZJBR;
    msg += "  描述：运转真气于指尖,凝聚成一股锐利无比的指力,直取敌人要害" ZJBR ZJBR;
    msg += HIW "2. 参合连环（lian）：" ZJBR NOR;
    msg += "  要求：参合指150级，内力1000点" ZJBR;
    msg += "  内力消耗：100点" ZJBR;
    msg += "  效果：连续攻击对手多次" ZJBR;
    msg += "  描述：指力连绵不绝,如滔滔江水,连环攻向对手" ZJBR ZJBR;
    msg += HIW "3. 参合无形（wuxing）：" ZJBR NOR;
    msg += "  要求：参合指200级，内功300级，内力3000点" ZJBR;
    msg += "  内力消耗：500点" ZJBR;
    msg += "  效果：使出无形无相的一指,令对手难以防御" ZJBR;
    msg += "  描述：运转真气于全身,使出无形无相的一指,令对手难以捉摸" ZJBR ZJBR;
    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 参合指需要高超的指法修为,练习时需要注意提高基本指法。" ZJBR;
    msg += "2. 在实战中,要善于利用指法的精妙变化,出其不意地攻击对手。" ZJBR;
    msg += "3. 各种特殊招式都有其适用场景,需要灵活运用。\n";

    return msg;
}