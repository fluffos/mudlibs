// sixiang-bufa.c
// created by doing

inherit SKILL;

string *dodge_msg = ({
    "只见$n脚步左移右移，于须毫之间避开了$N这一招。\n",
    "$n身子慕然向后一仰，避开了$N的凌厉攻势。\n",
    "$n身子微微一侧，跨前两步，让$N这一招扑了个空。\n",
    "但是$n身形飘忽，轻轻一纵，早已避开$N。\n",
    "$n忽前忽后，身随意转，将$N所有的后招全难落空。\n",
});

int valid_enable(string usage)
{
	return usage == "dodge";
}

int valid_learn(object me)
{
	if (me->query_skill("dodge", 1) < 180)
		return notify_fail("你基本轻功水平不足，难以领悟四象步法。\n");

	return 1;
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int query_effect_dodge(object attacker, object me)
{
	int lvl;

	lvl = me->query_skill("sixiang-bufa", 1);
	if (lvl < 50)  return 0;
	if (lvl < 100) return 20;
	if (lvl < 150) return 30;
	if (lvl < 200) return 40;
	if (lvl < 250) return 60;
	if (lvl < 300) return 70;
	if (lvl < 350) return 80;
	return 90;
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 60)
		return notify_fail("你的体力太差了，不能练四象步法。\n");

	me->receive_damage("qi", 55);
	return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【四象步法】" ZJBR ZJBR NOR;
    msg += WHT "一种精妙的轻功步法，依循四象八卦方位变化，步法灵动，变幻莫测。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  基本轻功等级不低于 " HIY "180" NOR " 级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  轻功 (dodge)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  气血不低于 " HIR "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "55" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // query_effect_dodge
    msg += "  提供额外的闪避几率加成，加成值随等级提升而增加：" ZJBR;
    msg += "    50-99 级：+20" ZJBR;
    msg += "    100-149 级：+30" ZJBR;
    msg += "    150-199 级：+40" ZJBR;
    msg += "    200-249 级：+60" ZJBR;
    msg += "    250-299 级：+70" ZJBR;
    msg += "    300-349 级：+80" ZJBR;
    msg += "    350 级及以上：+90" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform_action_file
    msg += CYN "  幻影无形 (huanying)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      四象步法等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      内功激发等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      短时间内提升自身的轻功有效等级，提升数值约为 (`四象步法等级 / 3`)。" ZJBR;
    msg += "      效果持续时间为 (`四象步法等级 / 3`) 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "150" NOR " 点，精力 " HIG "50" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "2" NOR " 回合。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 四象步法提供非常高的被动闪避加成。" ZJBR;
    msg += "2. '幻影无形' 可以进一步临时提升闪避能力。" ZJBR;
    msg += "3. 练习消耗气血，注意保持。\n";

    return msg;
}

string perform_action_file(string action)
{
    return __DIR__"sixiang-bufa/" + action;
}
