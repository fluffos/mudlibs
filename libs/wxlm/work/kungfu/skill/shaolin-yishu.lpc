// shaolin-yishu.c

inherit SKILL;

string type() { return "knowledge"; }

int valid_enable(string usage) { return usage == "medical"; }

int valid_learn(object me)
{
	if ((int)me->query_skill("medical", 1) < 100)
		return notify_fail("你的基本医术造诣太浅，无"
				   "法领会深奥的少林医术。\n");

	if ((int)me->query_skill("medical", 1) < (int)me->query_skill("shaolin-yishu", 1))
		return notify_fail("你的基本医术水平有限，无"
				   "法掌握更深奥的少林医术。\n");

	return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【少林医术】" ZJBR NOR;
    msg += WHT "少林派独特的医学知识体系，结合佛法与医理，擅长治疗内外伤患。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  基本医术等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "  基本医术等级不能低于少林医术等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  基本医术（medical）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // 无 practice_skill
    msg += "  通常无法直接练习，需通过学习或特定途径提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // 无
    msg += "  无战斗相关效果。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // 无 perform/exert
    msg += "  无。" ZJBR ZJBR;

    return msg;
}
