// taohua-yaoli.c

inherit SKILL;

string type() { return "knowledge"; }

int valid_enable(string usage) { return usage == "medical"; }

int valid_learn(object me)
{
	if ((int)me->query_skill("medical", 1) < 100)
		return notify_fail("你的基本医术造诣太浅，无"
				   "法领会深奥的白驼秘传。\n");

	if ((int)me->query_skill("medical", 1) < (int)me->query_skill("baituo-michuan", 1))
		return notify_fail("你的基本医术水平有限，无"
				   "法掌握更深奥的白驼秘传。\n");

	return 1;
}
string query_description()
{
    string msg;

    msg = "";
    msg += HIY "【白驼秘传】" ZJBR ZJBR NOR;
    msg += WHT "白驼秘传是白驼山独门的医术和毒术，以其精妙绝伦、神秘莫测而闻名。" ZJBR;
    msg += "此秘传融合了医毒双修的精髓，既可救人，也可害人，实为一门深奥的绝学。" ZJBR ZJBR;
    msg += HIY "【学习要求】" ZJBR NOR;
    msg += "  基本医术等级 100 级" ZJBR;
    
    msg += HIY "【技能效果】" ZJBR NOR;
    msg += "  可激发为医术（medical）" ZJBR ZJBR;
    msg += HIY "【特殊功能】" ZJBR NOR;
    msg += HIW "1. 解毒（jiedu）：" ZJBR NOR;
    msg += "  要求：白驼秘传120级，基本内功100级" ZJBR;
    msg += "  内力消耗：100点" ZJBR;
    msg += "  效果：解除目标身上的毒素，效果与白驼秘传等级相关" ZJBR;
    msg += "  描述：运用白驼秘传的独特手法，为目标解毒" ZJBR ZJBR;
    msg += HIW "2. 施毒（shidu）：" ZJBR NOR;
    msg += "  要求：白驼秘传150级，基本内功120级" ZJBR;
    msg += "  内力消耗：150点" ZJBR;
    msg += "  效果：对目标施加毒素，毒性与白驼秘传等级相关" ZJBR;
    msg += "  描述：运用白驼秘传的独门手法，悄无声息地对目标下毒" ZJBR ZJBR;
    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 白驼秘传需要高超的医术基础，练习时需要不断提高基本医术水平。" ZJBR;
    msg += "2. 在使用时，要谨慎考虑解毒和施毒的后果，不可滥用。" ZJBR;
    msg += "3. 白驼秘传作为白驼山的不传之秘，使用时应当谨慎，不可外传。\n";

    return msg;
}
