int valid_enable(string usage) { return usage == "strike" ||  usage == "parry"; }

int valid_combine(string combo) { return combo == "tiangang-zhi"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练金佛绵掌必须空手。\n");

	if (me->query_skill("force") < 50)
		return notify_fail("你的内功火候不够，不能练金佛绵掌。\n");

	if (me->query("max_neili") < 150)
		return notify_fail("你的内力太弱，无法练金佛绵掌。\n");

	if (me->query_skill("strike", 1) < me->query_skill("jinding-zhang", 1))
		return notify_fail("你的基本掌法太差，无法领会更高深的金佛绵掌。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i-1]["lvl"])
			return action[i-1]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level   = (int)me->query_skill("jinding-zhang",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 60)
		return notify_fail("你的内力不够练习金佛绵掌。\n");

	if (me->query_skill("jinding-zhang", 1) < 100)
		me->receive_damage("qi", 30);
	else
		me->receive_damage("qi", 45);

	me->add("neili", -48);
	return 1;
}
string perform_action_file(string action)
{
	return __DIR__"jinding-zhang/"+ action;
}
string query_description()
{
    string msg;

    msg = HIY "【金顶绵掌】" ZJBR NOR;
    msg += "峨眉派掌法，招式圆转，刚柔并济。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  空手状态。" ZJBR;
    msg += "  基本内功等级不低于 " HIY "50" NOR " 级。" ZJBR;
    msg += "  最大内力不低于 " HIB "150" NOR " 点。" ZJBR;
    msg += "  基本掌法等级需大于等于金顶绵掌等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  掌法（strike）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖可合并技能〗" ZJBR NOR;
    msg += "  可与 天罡指穴法 (tiangang-zhi) 互备。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "48" NOR " 点。" ZJBR;
    msg += "  等级低于100级时，每次练习消耗气血：" HIR "30" NOR " 点。" ZJBR;
    msg += "  等级达到100级后，每次练习消耗气血：" HIR "45" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  暂无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  八式合一 (bashi)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      战斗中使用。" ZJBR;
    msg += "      内力不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "      基本内功等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      金顶绵掌等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      激发掌法为金顶绵掌。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：基于使用者掌法与目标轻功等级。" ZJBR;
    msg += "      伤害计算：命中后造成伤害，伤害值约为 ((临济庄等级 + 金顶绵掌等级) / 3) + 随机((临济庄等级 + 金顶绵掌等级) / 3)，附加30%伤害。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 " HIB "100" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：无内力消耗，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;

    return msg;
}