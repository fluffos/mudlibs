//sanyin-wugongzhao.c 三阴蜈蚣抓

inherit SKILL;

mapping *action = ({
([  "action" : "$N爪现青白，骨结隆起，自上而下撕扯$n的$l",
    "force" : 120,
    "dodge" : 10,
    "damage": 30,
    "damage_type" : "抓伤"
]),
([  "action" : "$N双手忽隐忽现，爪爪鬼魅般抓向$n的$l",
    "force" : 150,
    "dodge" : 20,
    "damage": 45,
    "lvl"   : 30,
    "damage_type" : "抓伤"
]),
([  "action" : "$N身形围$n一转，爪影纵横毫不留情对着$n的$l抓下",
    "force" : 180,
    "dodge" : 30,
    "damage": 55,
    "lvl"   : 60,
    "damage_type" : "抓伤"
]),
([  "action" : "$N一声怪叫，一爪横出直击$n的$l",
    "force" : 240,
    "dodge" : 50,
    "damage": 60,
    "lvl"   : 90,
    "skill_name" : "唯我独尊" ,
    "damage_type" : "抓伤"
]),
([  "action" : "$N两眼邪光闪动，身子飘飘忽忽，抽身探出一爪猛然击向$n的$l",
    "force" : 270,
    "dodge" : 60,
    "damage": 90,
    "lvl"   : 120,
    "skill_name" : "唯我独尊" ,
    "damage_type" : "抓伤"
]),
});

int valid_enable(string usage) { return usage == "claw" ||  usage == "parry"; }

int valid_combine(string combo) { return combo == "chousui-zhang"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
	    return notify_fail("练六阴蜈蚣爪必须空手。\n");

	if ((int)me->query("max_neili") < 200)
	    return notify_fail("你的内力太弱，无法练六阴蜈蚣爪。\n");

	if ((int)me->query_skill("claw", 1) < (int)me->query_skill("sanyin-wugongzhao", 1))
	    return notify_fail("你的基本爪法水平有限，无法领会更高深的六阴蜈蚣爪法。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action); i > 0; i--)
		if (level >= action[i - 1]["lvl"])
			return action[i - 1]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("sanyin-wugongzhao", 1);
	for(i = sizeof(action); i > 0; i--)
		if (level > action[i - 1]["lvl"])
		{
			// 增加一个随机事件，攻击时有概率使目标中毒
			if (random(100) < 30) // 30%概率
			{
				me->set_temp("sanyin_poison", 1);
			}
			else
			{
				me->delete_temp("sanyin_poison");
			}
			return action[NewRandom(i, 20, level / 5)];
		}
}

int practice_skill(object me)
{
 
 int skill;

	skill = me->query_skill("jiuyin-baiguzhao", 1);
	if ((int)me->query("qi") < 40)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 40)
		return notify_fail("你的内力不够练六阴蜈蚣爪。\n");

	me->receive_damage("qi", 30);
	me->add("neili", -31);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"sanyin-wugongzhao/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【三阴蜈蚣爪】" ZJBR NOR;
    msg += WHT "星宿派的独门爪法，招式阴毒狠辣，爪带剧毒，令人防不胜防。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  必须空手。" ZJBR;
    msg += "  最大内力不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "  基本爪法等级不低于三阴蜈蚣爪等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  爪法（claw）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  气血：不低于 " HIR "40" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "40" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "30" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "31" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // hit_ob, query_action
    msg += "  普通攻击时有 " HIW "30%" NOR " 概率触发毒性 (`sanyin_poison` 标记)。" ZJBR;
    msg += "  当 `sanyin_poison` 标记存在时，下一次普通攻击命中目标会使其感染「三阴」剧毒。" ZJBR;
    msg += "    中毒效果：等级取决于 （施展者基本毒技等级 + 随机(施展者基本毒技等级)），持续时间取决于 （施展者三阴蜈蚣爪等级 / 20 + 随机(施展者三阴蜈蚣爪等级 / 20)）秒。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform_action_file

    msg += HIC "  三阴毒爪 (zhua)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      三阴蜈蚣爪等级 " HIY "80" NOR " 级。" ZJBR;
    msg += "      激发爪法为三阴蜈蚣爪。" ZJBR;
    msg += "      战斗状态中。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：比较 （自身激发爪法等级 + 自身基本毒技等级） 与 （目标激发招架等级 + 目标基本毒技等级）。" ZJBR;
    msg += "      命中效果：对目标造成伤害，伤害值约为 （（激发爪法等级 / 2） + 随机（激发爪法等级 / 2）），并附加 50 点固定气血伤害。" ZJBR;
    msg += "      命中效果：使目标中「三阴」剧毒。中毒等级取决于 （自身加力值 + 随机(自身加力值)），持续时间取决于 （激发爪法等级 / 40 + 随机(激发爪法等级 / 40)）秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      成功或失败：忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  蜈蚣毒影 (duying)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      三阴蜈蚣爪等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "400" NOR " 点。" ZJBR;
    msg += "      必须空手。" ZJBR;
    msg += "      战斗状态中。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      连续对目标发动多次快速攻击（次数取决于 `COMBAT_D` 判定）。" ZJBR;
    msg += "      每次攻击独立计算命中和伤害，且每次攻击均有可能触发普通攻击的 " HIW "30%" NOR " 中毒效果。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIY "〖可合击技能〗" ZJBR NOR; // valid_combine
    msg += "  抽髓掌（chousui-zhang）。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 此爪法威力与基本爪法、基本毒技等级相关。" ZJBR;
    msg += "2. 「三阴毒爪」的毒性效果与加力值有关。" ZJBR;

    return msg;
}

// 在 hit_ob 函数中实现中毒效果
mixed hit_ob(object me, object victim, int damage_bonus)
{
    if (me->query_temp("sanyin_poison"))
    {
        victim->affect_by("sanyin",
            ([ "level" : me->query_skill("poison", 1) + random(me->query_skill("poison", 1)),
               "id"    : me->query("id"),
               "duration" : me->query_skill("sanyin-wugongzhao", 1) / 20 + random(me->query_skill("sanyin-wugongzhao", 1) / 20) ]));
        me->delete_temp("sanyin_poison");
        return HIR "$n" HIR "只感到伤口一阵灼痛，似乎中了剧毒！\n" NOR;
    }
}
