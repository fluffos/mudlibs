// /kungfu/skill/bainiao-chaofeng.c


inherit SKILL;

mapping *action = ({
    ([  "action" : "$N指法轻快，弹奏出「" HIY "金凤来仪" NOR "」，琴音如凤鸣，震慑$n心神",
        "force" : 120,
        "attack": 40,
        "dodge" : 30,
        "parry" : 40,
        "damage": 60,
        "lvl"   : 0,
        "skill_name" : "金凤来仪",
        "damage_type" : "内伤"
    ]),
    ([  "action" : "$N运指如飞，使出「" HIM "百鸟和鸣" NOR "」，琴声此起彼伏，令$n眼花缭乱",
        "force" : 150,
        "attack": 50,
        "dodge" : 40,
        "parry" : 50,
        "damage": 80,
        "lvl"   : 40,
        "skill_name" : "百鸟和鸣",
        "damage_type" : "内伤"
    ]),
    ([  "action" : "$N双手交错，奏响「" HIR "凤凰涅槃" NOR "」，一股炽热气息随琴声涌向$n",
        "force" : 180,
        "attack": 60,
        "dodge" : 50,
        "parry" : 60,
        "damage": 100,
        "lvl"   : 80,
        "skill_name" : "凤凰涅槃",
        "damage_type" : "内伤"
    ]),
});

int valid_enable(string usage) { return usage == "qin" || usage == "parry"; }

int valid_learn(object me)
{
    if (me->query("family/family_name") != "白帝城")
        return notify_fail("百鸟朝凤只有白帝城的弟子才能学习。\n");

    if ((int)me->query_skill("force") < 150)
        return notify_fail("你的内功火候不够，无法学习百鸟朝凤。\n");

    if ((int)me->query("max_neili") < 1500)
        return notify_fail("你的内力修为不足，无法学习百鸟朝凤。\n");

    if ((int)me->query_skill("qin", 1) < 100)
        return notify_fail("你的基本琴法火候不够，无法学习百鸟朝凤。\n");

    if ((int)me->query_skill("yinlv", 1) < 100)
        return notify_fail("你的音律修养不足，无法学习百鸟朝凤。\n");

    if ((int)me->query_skill("qin", 1) < (int)me->query_skill("bainiao-chaofeng", 1))
        return notify_fail("你的基本琴法水平有限，无法领会更高深的百鸟朝凤。\n");

    return 1;
}

string query_skill_name(int level)
{
    int i;
    for (i = sizeof(action) - 1; i >= 0; i--)
        if (level >= action[i]["lvl"])
            return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    int i, level;
    level = (int) me->query_skill("bainiao-chaofeng", 1);
    for (i = sizeof(action); i > 0; i--)
        if (level > action[i-1]["lvl"])
            return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    object weapon;

    if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "qin")
        return notify_fail("你必须先装备琴才能练习百鸟朝凤。\n");

    if ((int)me->query("qi") < 70)
        return notify_fail("你的体力不够练习百鸟朝凤。\n");

    if ((int)me->query("neili") < 70)
        return notify_fail("你的内力不够练习百鸟朝凤。\n");

    me->receive_damage("qi", 60);
    me->add("neili", -65);
    return 1;
}

string perform_action_file(string action)
{
    return __DIR__"bainiao-chaofeng/" + action;
}

int help(object me)
{
    write(@HELP
百鸟朝凤

    百鸟朝凤是白帝城高深的琴法，融合了音律与内功的精髓。
    此琴法不仅能弹奏出动人心弦的乐曲，还能在战斗中发挥强大威力。

    学习要求：
        白帝城弟子
        基本琴法 100 级
        音律修养 100 级
        内功修为 150 级
        内力 1500 点

HELP
    );
    return 1;
}

string query_description()
{
    string msg;

    msg = "";
    msg += HIY "【百鸟朝凤琴法】" ZJBR ZJBR NOR;
    msg += WHT "百鸟朝凤琴法是一门高深的琴法，以其音律变化多端、气势恢宏而闻名。" ZJBR;
    msg += "此琴法融合了百鸟鸣啼之音，招式看似柔美，实则暗藏杀机。" ZJBR ZJBR;

    msg += HIY "【学习要求】" ZJBR NOR;
    msg += "  白帝城弟子" ZJBR;
    msg += "  最大内力 1500 点" ZJBR;
    msg += "  基本内功等级 150 级" ZJBR;
    msg += "  基本琴法等级 100 级" ZJBR;
    msg += "  音律修养等级 100 级" ZJBR;
    msg += "  百鸟朝凤等级不能超过基本琴法等级" ZJBR ZJBR;
    msg += HIY "【练习消耗】" ZJBR NOR;
    msg += "  需要装备琴类武器" ZJBR;
    msg += "  每次练习消耗："ZJBR;
    msg += "    - 气血 60 点"ZJBR;
    msg += "    - 内力 65 点"ZJBR ZJBR;
    msg += HIY "【技能效果】" ZJBR NOR;
    msg += "  可激发为琴法（qin）" ZJBR;
    msg += "  可激发为招架（parry）" ZJBR ZJBR;

    msg += HIY "【特殊招式】" ZJBR NOR;
    msg += HIW "1. 百鸟朝凤（chaofeng）：" ZJBR NOR;
    msg += "    " HIY "发动条件：" NOR ZJBR;
    msg += "      必须装备琴类武器" ZJBR;
    msg += "      百鸟朝凤技能等级达到120级" ZJBR;
    msg += "      内功修为达到180级" ZJBR;
    msg += "      音律修养达到120级" ZJBR;
    msg += "      消耗300点内力" ZJBR;
    msg += "      技能冷却时间10秒" ZJBR;
    msg += "    " HIY "效果：" NOR ZJBR;
    msg += "      对周围最多3个敌人发动攻击" ZJBR;
    msg += "      若目标不在敌对列表中，则将其加入攻击列表" ZJBR;
    msg += "      攻击范围为使用者所在环境内的所有生物" ZJBR;
    msg += "    " HIY "伤害计算：" NOR ZJBR;
    msg += "      " HIY "命中判定：" NOR ZJBR;
    msg += "        攻击方技能值：skill = 百鸟朝凤技能等级 + 琴法激发等级" ZJBR;
    msg += "        防御方技能值：hit_chance = 目标内功激发等级 + 目标基本招架等级" ZJBR;
    msg += "        若 skill / 2 + random(skill) > hit_chance，则命中" ZJBR;
    msg += "      " HIY "伤害计算：" NOR ZJBR;
    msg += "        基础伤害：damage = skill + 音律技能等级 * 2" ZJBR;
    msg += "        若目标为非玩家，则伤害翻倍：damage *= 2" ZJBR;
    msg += "        伤害类型： 内伤" ZJBR;
    msg += "    " HIY "附加效果：" NOR ZJBR;
    msg += "      若命中，有50%的概率触发以下效果之一：" ZJBR;
    msg += "        50%概率获得1个火音符" ZJBR;
    msg += "        50%概率获得1个冰音符" ZJBR;
    msg += "    " HIY "其他：" NOR ZJBR;
    msg += "      若周围没有可攻击目标，则提示" ZJBR;
    msg += "      每次使用消耗300点内力" ZJBR;
    msg += "      技能冷却时间为10秒" ZJBR;
    msg += "    " HIY "描述：" NOR ZJBR;
    msg += "      奏响百鸟朝凤，琴音如百鸟齐鸣，化作无形剑气席卷四周" ZJBR ZJBR;
    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 百鸟朝凤琴法需要高超的音律修养，练习时需要充分发挥想象力。" ZJBR;
    msg += "2. 在实战中，要善于利用琴音的变化来迷惑对手，出其不意。" ZJBR;
    msg += "3. 百鸟朝凤作为绝技，使用时机很重要，应在关键时刻施展。\n";

    return msg;
}