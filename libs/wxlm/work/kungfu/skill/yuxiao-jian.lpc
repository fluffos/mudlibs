int valid_enable(string usage)
{
	return (usage == "sword") || (usage == "parry");
}

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 900)
		return notify_fail("你的内力不够，无法学习玉萧剑法。\n");

	if ((int)me->query_skill("force") < 100)
		return notify_fail("你的内功火候不够，无法学习玉萧剑法。\n");

	if ((int)me->query_skill("sword", 1) < 100)
		return notify_fail("你的基本剑法火候不够，无法学习玉萧剑法。\n");

	if ((int)me->query_skill("sword", 1) < (int)me->query_skill("yuxiao-jian", 1))
		return notify_fail("你的基本剑法水平有限，无法领会更高深的玉萧剑法。\n");

    return 1;
}

int query_effect_parry(object attacker, object me)
{
	int lvl;

	lvl = me->query_skill("tanzhi-shentong", 1);
	if (lvl < 100) return 0;
	if (lvl < 150) return 40;
	if (lvl < 200) return 50;
	if (lvl < 250) return 60;
	if (lvl < 300) return 70;
	if (lvl < 350) return 80;
	if (lvl < 400) return 90;
	if (lvl < 450) return 100;
	return 110;
}


mapping query_action(object me, object weapon)
{
	int i, level;

	level = (int) me->query_skill("yuxiao-jian", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 60)
		return notify_fail("你的体力不够练云箫剑法。\n");

	if ((int)me->query("neili") < 70)
		return notify_fail("你的体力不够练云箫剑法。\n");

	me->receive_damage("qi", 45);
	me->add("neili", -66);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"yuxiao-jian/" + action;
}

/**
    * @brief 查询技能描述信息
    * @return string 返回云箫剑法的详细描述
    * @details 包含学习要求、激发类型、练习要求、被动效果和特殊招式等信息
    */
string query_description()
{
    string msg;

    msg = HIY "【云箫剑法】" ZJBR NOR;
    msg += WHT "云箫剑法乃桃花岛嫡传剑法，招式潇洒，音韵相合，灵动飘逸。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力 不低于 " HIB "900" NOR " 点。" ZJBR;
    msg += "  内功激发等级：" HIY "100" NOR " 级。" ZJBR;
    msg += "  剑法基本等级：" HIY "100" NOR " 级。" ZJBR;
    msg += "  剑法基本等级不低于云箫剑法基本等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  剑法 (sword)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  需装备剑类武器。" ZJBR;
    msg += "  当前气血 不低于 " HIR "60" NOR " 点。" ZJBR;
    msg += "  当前内力 不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗 气血 " HIR "45" NOR " 点，内力 " HIB "66" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖被动招架效果〗" ZJBR NOR;
    msg += "  激发招架时，根据自身 弹指神通基本等级 提供额外招架效果：" ZJBR;
    msg += "    100-149 级：40 点" ZJBR;
    msg += "    150-199 级：50 点" ZJBR;
    msg += "    200-249 级：60 点" ZJBR;
    msg += "    250-299 级：70 点" ZJBR;
    msg += "    300-349 级：80 点" ZJBR;
    msg += "    350-399 级：90 点" ZJBR;
    msg += "    400-449 级：100 点" ZJBR;
    msg += "    450 级以上：110 点" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;

    msg += HIC "  天外清音 (tianwai)" ZJBR NOR;
    msg += "    招式名称：" HIW "天外清音" NOR ZJBR;
    msg += "    使用要求：" ZJBR;
    msg += "      云箫剑法基本等级：" HIY "100" NOR " 级。" ZJBR;
    msg += "      碧波神功基本等级：" HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "      需装备剑类武器。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      剑发琴音，剑影如夜幕扑向敌人。" ZJBR;
    msg += "      " HIY "命中判定：" NOR "使用通用公式进行判定。" ZJBR;
    msg += "        己方命中值 = 剑法激发等级 + 吹箫技法基本等级。" ZJBR;
    msg += "        目标防御值 = 目标内功激发等级 + 目标武学修养基本等级。" ZJBR;
    msg += "      " HIR "伤害计算：" NOR "剑法激发等级 + 碧波神功基本等级，伤害为计算值的 2/3 + 随机(计算值的 1/3)。" ZJBR;
    msg += "      " HIG "特殊效果：" NOR "命中后对目标造成额外气血损伤（伤害值的一半）。" ZJBR;
    msg += "      " HIM "状态影响：" NOR "临时降低目标身法和招架 (降低值=吹箫技法基本等级/2)，持续6秒。" ZJBR;
    msg += "      " HIR "重复限制：" NOR "目标处于状态影响期间，无法再次对其使用此技能。" ZJBR;
    msg += "      " HIB "连续攻击：" NOR "连续进行基础攻击次数的攻击。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      成功消耗内力 " HIB "180" NOR " 点，失败消耗 " HIB "70" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "1-3" NOR " 秒（成功）或 " HIR "2" NOR " 秒（失败）。" ZJBR ZJBR;

    msg += HIC "  抚箫叹情 (qing)" ZJBR NOR;
    msg += "    招式名称：" HIW "抚箫叹情" NOR ZJBR;
    msg += "    使用要求：" ZJBR;
    msg += "      云箫剑法基本等级：" HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 不低于 " HIB "1000" NOR " 点。" ZJBR;
    msg += "      已激发云箫剑法为剑法。" ZJBR;
    msg += "      目标内力不低于 300 点。" ZJBR;
    msg += "      需要学会此绝技（can_perform/yuxiao-jian/qing）。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      轻抚剑身，剑意如丝如缕，萦绕不散，使敌人沉浸在深深的离愁别绪中。" ZJBR;
    msg += "      " HIY "命中判定：" NOR "随机性增强判定。" ZJBR;
    msg += "        判定：命中值/2 + 随机(命中值) > 防御值。" ZJBR;
    msg += "      " HIR "效果-消耗敌方内力：" NOR "基础消耗 500 + 命中值 * 1.5 + 自身当前内力(不超过自身最大内力取值)/8。" ZJBR;
    msg += "      " HIM "意境加成：" NOR "若拥有「飞花落叶」意境，消耗 = 基础消耗 * (1 + 意境等级/20)。" ZJBR;
    msg += "      " HIG "特殊限制：" NOR "目标内力不足时，消耗其全部内力。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      成功消耗内力 " HIB "500" NOR " 点 + 自身内力当前/10，失败消耗 " HIB "120" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "1-3" NOR " 秒（成功）或 " HIR "2" NOR " 秒（失败）。" ZJBR ZJBR;

    msg += HIC "  潮起潮落 (bihai)" ZJBR NOR;
    msg += "    招式名称：" HIW "潮起潮落" NOR ZJBR;
    msg += "    使用要求：" ZJBR;
    msg += "      云箫剑法基本等级：" HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力 不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "      手持可作为萧使用的武器（handing 或 weapon）。" ZJBR;
    msg += "      目标气血不能过高（不超过最大精神*3，仅对NPC）。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      手按玉箫，脚踏八卦方位，奏出箫声如潮起潮落，共四段精神攻击。" ZJBR;
    msg += "      " HIY "第一段「箫声初起」：" NOR "如远山含黛，海天一色。" ZJBR;
    msg += "        命中判定：使用 hit_determination 函数。" ZJBR;
    msg += "          己方命中值 = 内功激发等级 + 剑法激发等级。" ZJBR;
    msg += "          目标防御值 = 目标内功激发等级 + 目标轻功激发等级。" ZJBR;
    msg += "        精神伤害：基础伤害 + 基础伤害/2（损伤）。" ZJBR;
    msg += "      " HIY "第二段「箫声渐起」：" NOR "如春潮初涌，轻柔缓缓。" ZJBR;
    msg += "        命中判定：削弱版随机判定。" ZJBR;
    msg += "          己方命中值 = (内功激发等级 + 剑法激发等级)/3 + 随机(内功激发等级 + 剑法激发等级)。" ZJBR;
    msg += "          目标防御值 = 目标内功激发等级 + 目标轻功激发等级。" ZJBR;
    msg += "        精神伤害：基础伤害/2 + 基础伤害/4（损伤）。" ZJBR;
    msg += "      " HIY "第三段「箫声骤变」：" NOR "如大潮汹涌，惊涛拍岸。" ZJBR;
    msg += "        命中判定：进一步削弱的随机判定。" ZJBR;
    msg += "          己方命中值 = (内功激发等级 + 剑法激发等级)/4 + 随机(内功激发等级 + 剑法激发等级)。" ZJBR;
    msg += "          目标防御值 = 目标内功激发等级 + 目标轻功激发等级。" ZJBR;
    msg += "        精神伤害：基础伤害/3 + 基础伤害/6（损伤）。" ZJBR;
    msg += "      " HIY "第四段「箫声渐弱」：" NOR "如潮水退去，余韵悠长。" ZJBR;
    msg += "        命中判定：最弱的随机判定。" ZJBR;
    msg += "          己方命中值 = (内功激发等级 + 剑法激发等级)/5 + 随机((内功激发等级 + 剑法激发等级)/4)。" ZJBR;
    msg += "          目标防御值 = 目标内功激发等级 + 目标轻功激发等级。" ZJBR;
    msg += "        精神伤害：基础伤害/2 + 基础伤害/4（损伤）。" ZJBR;
    msg += "      " HIR "伤害计算：" NOR "基础伤害 = 当前精神/10 + 剑法激发等级 + 吹箫技法基本等级 + 奇门五行基本等级。" ZJBR;
    msg += "      " HIM "意境加成：" NOR "若拥有「飞花落叶」意境，伤害 += 基础伤害 * 意境等级/20。" ZJBR;
    msg += "      " HIG "PVE加成：" NOR "对NPC目标命中值和伤害各提升 50%。" ZJBR;
