    msg += "      消耗内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "1-2" NOR " 秒（第四段成功）或 " HIR "2-3" NOR " 秒（失败）。" ZJBR ZJBR;

    msg += HIC "  桃源剑域 (jianzhi)" ZJBR NOR;
    msg += "    招式名称：" HIW "桃源剑域" NOR ZJBR;
    msg += "    使用要求：" ZJBR;
    msg += "      云箫剑法基本等级：" HIY "120" NOR " 级。" ZJBR;
    msg += "      弹指神通基本等级：" HIY "120" NOR " 级。" ZJBR;
    msg += "      碧波神功基本等级：" HIY "120" NOR " 级。" ZJBR;
    msg += "      已激发云箫剑法为剑法。" ZJBR;
    msg += "      已激发碧波神功为内功。" ZJBR;
    msg += "      已激发弹指神通为指法。" ZJBR;
    msg += "      已准备弹指神通。" ZJBR;
    msg += "      最大内力 不低于 " HIB "1200" NOR " 点。" ZJBR;
    msg += "      当前内力 不低于 " HIB "400" NOR " 点。" ZJBR;
    msg += "      当前精神 不低于 " HIM "400" NOR " 点。" ZJBR;
    msg += "      自身不处于「剑芒」状态。" ZJBR;
    msg += "      自身不处于「桃源剑域」状态。" ZJBR;
    msg += "      自身不能手握短兵。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      " HIW "发动阶段：" NOR "连续进行 3 次攻击，第二攻击附加 伤害基数/3 攻击力。" ZJBR;
    msg += "      " HIW "剑域状态：" NOR "获得持续 (剑法激发等级+指法激发等级)/10 秒的剑域状态（最多20秒）。" ZJBR;
    msg += "      " HIY "持续攻击：" NOR "状态期间每秒自动攻击目标一次。" ZJBR;
    msg += "      " HIY "命中判定：" NOR "带随机性的技能判定。" ZJBR;
    msg += "        己方命中值 = 随机(剑法激发等级) + 指法激发等级。" ZJBR;
    msg += "        目标防御值 = 目标轻功激发等级。" ZJBR;
    msg += "      " HIR "伤害计算：" NOR "基础伤害 = 剑法激发等级 + 弹指神通基本等级。" ZJBR;
    msg += "      " HIG "PVE加成：" NOR "对NPC目标伤害翻倍。" ZJBR;
    msg += "      " HIM "意境加成：" NOR "若拥有「飞花落叶」意境：" ZJBR;
    msg += "        额外伤害 += (剑法激发等级/6) * 意境等级 x (100% + 桃源破体比率)。" ZJBR;
