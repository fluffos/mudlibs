    msg += "        提升奇门五行熟练度（剑法激发等级点）。" ZJBR;
    msg += "      " HIB "武器伤害：" NOR "每次命中后造成 66% 武器攻击伤害。" ZJBR;
    msg += "      " HIR "控制效果：" NOR "命中后 50% 概率使目标忙乱 1 秒。" ZJBR;
    msg += "      " HIG "恢复效果：" NOR "每次运转：" ZJBR;
    msg += "        恢复气血 (奇门五行基本等级 + 100) * 2 点。" ZJBR;
    msg += "        提升奇门五行熟练度（自身+目标奇门五行基本等级之和）。" ZJBR;
    msg += "      " HIY "状态维持条件：" NOR "需保持内力≥500、精神≥500。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      发动时消耗内力 " HIB "250" NOR " 点，精神 " HIM "100" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "2-3" NOR " 秒。" ZJBR;
    msg += "      状态期间每秒消耗内力 " HIB "250" NOR " 点，精神 " HIM "100" NOR " 点。" ZJBR ZJBR;

    return msg;
}