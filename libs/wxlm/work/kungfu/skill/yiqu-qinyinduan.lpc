// /kungfu/skill/yiqu-qinyinduan.c


inherit SKILL;

mapping *action = ({
    ([  "action" : "$N指法轻柔，弹奏出「" HIC "高山流水" NOR "」，琴音如山间清泉，令$n心神宁静",
        "force" : 120,
        "attack": 40,
        "dodge" : 40,
        "parry" : 40,
        "damage": 40,
        "lvl"   : 0,
        "skill_name" : "高山流水",
        "damage_type" : "内伤"
    ]),
    ([  "action" : "$N运指如飞，使出「" HIY "百鸟朝凤" NOR "」，琴声激昂，如百鸟齐鸣，扰乱$n的心绪",
        "force" : 150,
        "attack": 50,
        "dodge" : 45,
        "parry" : 45,
        "damage": 60,
        "lvl"   : 40,
        "skill_name" : "百鸟朝凤",
        "damage_type" : "内伤"
    ]),
    ([  "action" : "$N双手交错，奏响「" HIG "玉泉清心" NOR "」，一股祥和之气随琴声涌向$n",
        "force" : 180,
        "attack": 60,
        "dodge" : 50,
        "parry" : 50,
        "damage": 80,
        "lvl"   : 80,
        "skill_name" : "玉泉清心",
        "damage_type" : "内伤"
    ]),
    ([  "action" : "$N指法变幻，弹奏「" HIR "肝胆琴心" NOR "」，琴音激烈，如怒涛般冲击$n的心神",
        "force" : 220,
        "attack": 70,
        "dodge" : 60,
        "parry" : 60,
        "damage": 100,
        "lvl"   : 120,
        "skill_name" : "肝胆琴心",
        "damage_type" : "内伤"
    ]),
});

int valid_enable(string usage) { return usage == "qin" || usage == "parry"; }

int valid_learn(object me)
{
    if (me->query("family/family_name") != "白帝城")
        return notify_fail("一曲琴音断只有白帝城的弟子才能学习。\n");

    if ((int)me->query_skill("force") < 150)
        return notify_fail("你的内功火候不够，无法学习一曲琴音断。\n");

    if ((int)me->query("max_neili") < 1500)
        return notify_fail("你的内力修为不足，无法学习一曲琴音断。\n");

    if ((int)me->query_skill("qin", 1) < 100)
        return notify_fail("你的基本琴法火候不够，无法学习一曲琴音断。\n");

    if ((int)me->query_skill("yinlv", 1) < 100)
        return notify_fail("你的音律修养不足，无法学习一曲琴音断。\n");

    if ((int)me->query_skill("qin", 1) < (int)me->query_skill("yiqu-qinyinduan", 1))
        return notify_fail("你的基本琴法水平有限，无法领会更高深的一曲琴音断。\n");

    return 1;
}

string query_skill_name(int level)
{
    int i;
    for (i = sizeof(action) - 1; i >= 0; i--)
        if (level >= action[i]["lvl"])
            return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    int i, level;
    level = (int) me->query_skill("yiqu-qinyinduan", 1);
    for (i = sizeof(action); i > 0; i--)
        if (level > action[i-1]["lvl"])
            return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    object weapon;

    if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "qin")
        return notify_fail("你必须先装备琴才能练习一曲琴音断。\n");

    if ((int)me->query("qi") < 70)
        return notify_fail("你的体力不够练习一曲琴音断。\n");

    if ((int)me->query("neili") < 70)
        return notify_fail("你的内力不够练习一曲琴音断。\n");

    me->receive_damage("qi", 60);
    me->add("neili", -65);
    return 1;
}

string perform_action_file(string action)
{
    return __DIR__"yiqu-qinyinduan/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【一曲琴音断】" ZJBR NOR;
    msg += WHT "一曲琴音断是白帝城独门琴法，以琴音伤敌，内外兼修的高深武学。" ZJBR;
    msg += "此琴法以音律入武，琴音飘渺，变化多端，可攻可守，令人防不胜防。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本琴法等级：" HIY "100" NOR " 级" ZJBR;
    msg += "  基本内功等级：" HIY "150" NOR " 级" ZJBR;
    msg += "  音律修养等级：" HIY "100" NOR " 级" ZJBR;
    msg += "  内力修为：" HIY "1500" NOR " 点" ZJBR;
    msg += "  门派限制：白帝城弟子专属" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  琴法 (qin)" ZJBR;
    msg += "  招架 (parry)" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血消耗：" HIR "60" NOR " 点" ZJBR;
    msg += "  内力消耗：" HIR "65" NOR " 点" ZJBR;
    msg += "  需装备琴器" ZJBR ZJBR;

    msg += HIY "〖特殊效果〗" ZJBR NOR;
    msg += "1. 音律入武：以琴音伤敌，攻击方式独特" ZJBR;
    msg += "2. 内外兼修：既可远程攻击，又可近身格斗" ZJBR;
    msg += "3. 变化多端：招式灵活多变，难以预测" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    
    msg += HIC "  平沙落雁 (pingsha)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      基本内功等级：" HIY "150" NOR " 级" ZJBR;
    msg += "      音律修养等级：" HIY "100" NOR " 级" ZJBR;
    msg += "      当前内力：" HIB "200" NOR " 点以上" ZJBR;
    msg += "      需装备琴器" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      弹奏平沙落雁曲，对单一目标造成伤害" ZJBR;
    msg += "      伤害值基于琴法等级和音律修养计算" ZJBR;
    msg += "      有几率获得火音符或冰音符" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "220" NOR " 点" ZJBR;
    msg += "      冷却时间：" HIR "4" NOR " 秒" ZJBR ZJBR;
    
    msg += HIC "  百鸟朝凤 (bainiao)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      基本内功等级：" HIY "180" NOR " 级" ZJBR;
    msg += "      音律修养等级：" HIY "120" NOR " 级" ZJBR;
    msg += "      当前内力：" HIB "300" NOR " 点以上" ZJBR;
    msg += "      需装备琴器" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      弹奏百鸟朝凤曲，琴音化为剑气攻击最多三名敌人" ZJBR;
    msg += "      音律等级达到150级以上时，单一目标可获得多次攻击" ZJBR;
    msg += "      音律等级达到200级以上时，单一目标可获得三次攻击" ZJBR;
    msg += "      有几率获得火音符或冰音符" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "300" NOR " 点" ZJBR;
    msg += "      冷却时间：" HIR "10" NOR " 秒" ZJBR ZJBR;
    
    msg += HIC "  清心静气 (liushui)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      基本内功等级：" HIY "150" NOR " 级" ZJBR;
    msg += "      音律修养等级：" HIY "100" NOR " 级" ZJBR;
    msg += "      当前内力：" HIB "200" NOR " 点以上" ZJBR;
    msg += "      需装备琴器" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      弹奏清心静气曲，使敌人陷入忙乱状态" ZJBR;
    msg += "      若有" HIG "有我神像" NOR "意境，获得音符的几率大幅提高" ZJBR;
    msg += "      有几率获得火音符或冰音符" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "50" NOR " 点" ZJBR;
    msg += "      冷却时间：" HIR "8" NOR " 秒" ZJBR ZJBR;

    msg += HIR "〖注意事项〗" ZJBR NOR;
    msg += "1. 一曲琴音断需要深厚的内功修为和精湛的琴艺，练习时需同时提高这两项能力。" ZJBR;
    msg += "2. 在实战中，要善于利用琴音的特性，扰乱敌人心神。" ZJBR;
    msg += "3. 特殊招式各有特点，需要根据战斗情况灵活运用。" ZJBR;
    msg += "4. 练习时必须装备琴器。" ZJBR;
    msg += "5. 音符系统：使用招式有几率获得火音符或冰音符，可用于其他组合技。\n";

    return msg;
}