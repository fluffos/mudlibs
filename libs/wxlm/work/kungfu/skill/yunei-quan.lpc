#define CN_NAME "御内拳法"
inherit SKILL;

mapping *action = ({
([      "action": "$N单手上抬，一招御内拳法的［皇室龙拳］，对准$n的$l猛击下去",
	"force" : 300,
	"attack": 85,
	"dodge" : 10,
	"parry" : 5,
	"damage": 100,
	"lvl"   : 0,
	"skill_name" : "御内拳法",
	"damage_type":  "瘀伤"
]),
([      "action": "$N一招御内拳法的［皇族天拳］，身子已向左转成弓箭步，两臂向后成钩手，呼\n"
		  "的一声轻响，反击$n$l",
	"force" : 350,
	"attack": 25,
	"dodge" : 15,
	"parry" : 10,
	"damage": 610,
	"lvl"   : 30,
	"skill_name" : "御内拳法",
	"damage_type":  "瘀伤"
]),
});

string query_txt()
{
	return "要求：基本拳法 150级";
}

int valid_learn(object me)
{
	if ((int)me->query_skill("cuff", 1) < 150)
		return notify_fail("你的拳法根基有限，无法学习御内拳法。\n");
	return 1;
}

int valid_enable(string usage)
{
	return usage == "cuff" ;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action)-1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int)me->query_skill("yunei-quan", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i - 1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 60)
		return notify_fail("你现在手足酸软，休息一下再练吧。\n");

	if ((int)me->query("neili") < 80)
		return notify_fail("你的内力不够了。\n");

	me->receive_damage("qi", 50);
	me->add("neili", -60);

	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"long-hu-jin/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【御内拳法】" ZJBR NOR;
    msg += WHT "御内拳法是一门以皇室秘传著称的高级拳法，招式威猛，气势磅礴。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本拳法 等级：" HIY "150" NOR " 级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  拳法 (cuff)" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血 消耗：" HIR "50" NOR " 点。" ZJBR;
    msg += "  内力 消耗：" HIR "60" NOR " 点。" ZJBR ZJBR;

    // msg += HIY "〖特殊招式〗" ZJBR NOR; // 暂无特殊招式或路径错误

    msg += HIR "〖注意事项〗" ZJBR NOR;
    msg += "1. 修炼此拳法需要扎实的拳法基础。" ZJBR;

    return msg;
}


