// qingfu-shenfa.c 青蝠身法
// pal 1997.05.26

inherit SKILL;

string *dodge_msg = ({
	"只见$n一招「福满乾坤」，身形陡然纵起，躲过了$N这一招。\n",
	"$n一式「五蝠献寿」，身形晃动，向一旁飘出，避开了$N这一招。。\n"
	"$n使出「洞天福地」，一个空心筋斗向后翻出，避开了$N的凌厉攻势。\n",
	"$n一招「云龙百蝠」，身随意转，$N只觉眼前一花，$n已绕至$N的身后。\n",
});

int valid_enable(string usage)
{
	return (usage == "dodge") || (usage == "move");
}

int valid_learn(object me)
{
	return 1;
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
	if( (int)me->query("qi") < 50 )
		return notify_fail("你的体力太低了，不能练青蝠身法。\n");

	if( (int)me->query("neili") < 40 )
		return notify_fail("你的内力不够练青蝠身法。\n");

	me->receive_damage("qi", 40);
	me->add("neili", -15);
	return 1;
}
string query_description()
{
    string msg;

    msg = HIY "【青蝠身法】" ZJBR NOR;
    msg += WHT "明教青翼蝠王韦一笑的独门轻功，身法诡异迅捷，如同蝙蝠飞行般难以捉摸。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  无特殊限制。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  轻功 (dodge)" ZJBR;
    msg += "  基本身法 (move)" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血 ≥ " HIR "50" NOR " 点。" ZJBR;
    msg += "  内力 ≥ " HIB "40" NOR " 点。" ZJBR;
    msg += "  每次练习消耗：" ZJBR;
    msg += "    气血：" HIR "40" NOR " 点。" ZJBR;
    msg += "    内力：" HIB "15" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  提升闪避能力和移动速度。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    return msg;
}
