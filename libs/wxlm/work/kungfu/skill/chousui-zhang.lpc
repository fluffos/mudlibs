// chousui-duzhang.c  炼髓掌, based on xianglong-zhang.c
inherit SKILL;

mapping *action = ({
([      "action": "$N脸上露出诡异的笑容，隐隐泛出绿色的双掌扫向$n的$l",
	"force" : 180,
	"attack": 49,
	"dodge" : -30,
	"parry" : -37,
	"dmage" : 32,
	"damage_type": "瘀伤"
]),
([      "action": "$N突然身形旋转起来扑向$n，双掌飞舞着拍向$n的$l",
	"force" : 230,
	"attack": 56,
	"dodge" : -22,
	"parry" : -34,
	"dmage" : 47,
	"damage_type": "瘀伤"
]),
([      "action": "$N将毒质运至右手，一招「腐尸毒」阴毒无比地抓向$n的$l",
	"force" : 260,
	"attack": 61,
	"dodge" : -20,
	"parry" : 10,
	"dmage" : 60,
	"damage_type": "瘀伤"
]),
([      "action": "$N双掌挟着一股腥臭之气拍向$n的$l",
	"force" : 380,
	"attack": 79,
	"dodge" : 17,
	"parry" : 36,
	"dmage" : 65,
	"damage_type": "瘀伤"
]),
([      "action": "$N咬破舌尖，口中喷血，聚集全身的力量击向$n",
	"force" : 420,
	"attack": 81,
	"dodge" : 27,
	"parry" : 21,
	"dmage" : 75,
	"damage_type": "瘀伤"
]),
});

int valid_enable(string usage) { return usage == "strike" || usage == "parry"; }

int valid_combine(string combo) { return combo == "sanyin-wugongzhao"; }

int valid_learn(object me)
{
	if ((int)me->query_skill("poison", 1) < 20)
		return notify_fail("你的毒功太差，无法练炼髓掌。\n");

	if ((int)me->query_skill("force") < 30)
		return notify_fail("你的内功火候不够，无法练炼髓掌。\n");

	if ((int)me->query("max_neili") < 100)
		return notify_fail("你的内力太弱，无法练炼髓掌。");

	if ((int)me->query_skill("strike", 1) < (int)me->query_skill("choushui-zhang", 1))
		return notify_fail("你的基本掌法水平有限，无法领会更高深的炼髓掌法。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;

	level = (int) me->query_skill("chousui-zhang", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i - 1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 40)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 30)
		return notify_fail("你的内力不够练炼髓掌。\n");

	if (me->query_skill("chousui-zhang", 1) < 50)
		me->receive_damage("qi", 20);
	else
		me->receive_damage("qi", 35);

	me->add("neili", -32);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"chousui-zhang/" + action;
}
string query_description()
{
    string msg;

    msg = HIY "【抽髓掌】" ZJBR NOR;
    msg += WHT "星宿派的独门掌法，手法诡异，含有剧毒，阴狠毒辣。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本毒技 20 级以上。" ZJBR;
    msg += "  基本内功 30 级以上。" ZJBR;
    msg += "  最大内力 100 点以上。" ZJBR;
    msg += "  基本掌法等级不低于抽髓掌等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  掌法 (strike)，招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖可合并技能〗" ZJBR NOR;
    msg += "  三阴蜈蚣爪 (sanyin-wugongzhao)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血不少于 40 点。" ZJBR;
    msg += "  内力不少于 30 点。" ZJBR;
    msg += "  每次练习消耗：" ZJBR;
    msg += "    内力：32 点。" ZJBR;
    msg += "    气血：抽髓掌 50 级以下消耗 20 点，50 级及以上消耗 35 点。" ZJBR ZJBR;

    msg += HIY "〖攻击特效〗" ZJBR NOR;
    msg += "  特殊招式附加毒性伤害或状态。" ZJBR ZJBR;

    msg += HIY "〖防御特效〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖普通招式〗" ZJBR NOR;
    msg += "  包含「腐尸毒」等招式。" ZJBR ZJBR; // 代码中定义的基础攻击招式之一

    msg += HIY "〖特殊招式〗" ZJBR NOR;

    msg += RED "  『弹射火焰』(huoyan)" NOR ZJBR;
    msg += "    要求：抽髓掌 80级，基本毒技 80级，化灵大法 80级，最大内力 500，内力 300。" ZJBR;
    msg += "          可选用持有的毒药增强威力。" ZJBR;
    msg += "    消耗：内力 120 点（若无毒药额外消耗 100 点生成），忙乱 2 秒。" ZJBR;
    msg += "    效果：弹射红色火焰攻击敌人，造成较低伤害，并附加碧火毒。" ZJBR;
    msg += "          毒性等级和持续时间受加力、掌法等级影响。可能被高内力对手化解部分威力。" ZJBR ZJBR;

    msg += MAG "  『弹射火球』(huoqiu)" NOR ZJBR;
    msg += "    要求：抽髓掌 120级，基本毒技 120级，化灵大法 120级，最大内力 800，内力 500。" ZJBR;
    msg += "          可选用持有的毒药增强威力。" ZJBR;
    msg += "    消耗：内力 200 点（若无毒药额外消耗 100 点生成），忙乱 2-3 秒。" ZJBR;
    msg += "    效果：弹射殷红火球攻击敌人，造成中等伤害，并附加碧火毒。" ZJBR;
    msg += "          毒性等级和持续时间受加力、掌法等级影响。可能被高内力对手化解部分威力。" ZJBR ZJBR;

    msg += HIG "  『弹射碧焰』(biyan)" NOR ZJBR;
    msg += "    要求：抽髓掌 150级，基本毒技 180级，化灵大法 150级，最大内力 1500，内力 800。" ZJBR;
    msg += "          可选用持有的毒药增强威力。" ZJBR;
    msg += "    消耗：内力 300 点（若无毒药额外消耗 100 点生成），忙乱 2 秒。" ZJBR;
    msg += "    效果：弹射碧绿毒焰攻击敌人，造成较高伤害，并附加碧火毒。" ZJBR;
    msg += "          毒性等级和持续时间受加力、掌法等级影响。可能被高内力对手化解部分威力。" ZJBR ZJBR;

    msg += HIR "  『火浪掌』(huolang)" NOR ZJBR;
    msg += "    要求：抽髓掌 220级，基本毒技 250级，化灵大法 220级，最大内力 3000，内力 3000。" ZJBR;
    msg += "          需要激发某种增益状态（如 化灵大法 的 powerup）。" ZJBR;
    msg += "    消耗：全部内力，忙乱 3-6 秒。" ZJBR;
    msg += "    效果：喷出奇毒火墙攻击敌人，造成巨量伤害，并附加高等级碧火毒及忙乱。" ZJBR;
    msg += "          毒性等级和持续时间受内功、掌法等级、奥义影响。" ZJBR;
    msg += "          威力巨大，但消耗极高，且有一定几率被更高内力对手反噬。" ZJBR ZJBR;

    msg += CYN "  『投放毒药』(toudu)" NOR ZJBR;
    msg += "    要求：抽髓掌 150级，基本毒技 180级，化灵大法 150级，最大内力 1500，内力 800。" ZJBR;
    msg += "          仅能在非战斗区域对高经验玩家使用，有冷却时间。" ZJBR;
    msg += "          可选用持有的毒药增强威力。" ZJBR;
    msg += "    消耗：内力 300 点（若无毒药额外消耗 100 点生成），忙乱 2 秒。" ZJBR;
    msg += "    效果：暗中对玩家下毒，造成一定伤害，并附加碧火毒。有几率全服通告。" ZJBR ZJBR;

    msg += WHT "  『毒掌抽髓』(throw)" NOR ZJBR;
    msg += "    要求：抽髓掌 40级，化灵大法 40级。需在战斗区域。" ZJBR;
    msg += "          需要附近或身上有尸体，或内力 1000 点以上。" ZJBR;
    msg += "    消耗：若无尸体则消耗 1000 点内力。命中忙乱 2 秒，闪避忙乱 4 秒。" ZJBR;
    msg += "    效果：将带毒尸体（或内力凝练的毒质）掷向敌人。命中则造成伤害、气血精神损伤，并附加星宿毒。" ZJBR;
    msg += "          毒性等级和持续时间受加力、掌法等级影响。" ZJBR;


    return msg;
}