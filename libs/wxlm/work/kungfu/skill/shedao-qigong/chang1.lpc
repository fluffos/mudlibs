
string query_name() { return "神龙"ZJBR"低吟"; }

int perform(object me)
{
	int skill;
	int max_count = 0;
	if (! me->is_fighting())
		return notify_fail("神龙低吟只能在战斗中使用。\n");

	if ((int)me->query_skill("shedao-qigong", 1) < 60)
		return notify_fail("你的蛇岛奇功不够娴熟，不会使用神龙低吟。\n");

	if ((int)me->query("neili") < 300)
		return notify_fail("你已经唱得精疲力竭，内力不够了。\n");


	max_count = me->query_skill("shedao-qigong", 1);


	//如果门派不是神龙教，只能低吟一半
	if (me->query("family/family_name") != "神龙教")
	{
		max_count /= 2;
	}
	else
	{
		max_count += max_count / 20;
	}

	if ((int)me->query_temp("chang") >= max_count)
		return notify_fail("你已经低吟得太久了，不能再低吟了。\n");

	skill = me->query_skill("force");

	me->add("neili", -200);

	message_combatd(HIR "只听$N" HIR "口中发出低沉的龙吟之声，如同神龙低吟，"
			"顷刻之间气势大涨，武功大进！"NOR"\n", me);

	//增加空手伤害和防御
	me->add_temp("apply/unarmed_damage", 1);
	me->add_temp("apply/armor", 10);
	me->add_temp("apply/defense", 1);
	me->add_temp("chang", 1);

	return 1;
}