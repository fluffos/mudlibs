
#include <combat.h>

inherit F_SSERVER;

string query_name() { return "流水" ZJBR "行云"; }
int query_cd() { return 6; }

int perform(object me, object target)
{
    object weapon;
    int damage;
    string msg;

    if (! target) target = offensive_target(me);
    if (! target || ! me->is_fighting(target))
        return notify_fail("「流水行云」只能对战斗中的对手使用。\n");

    if (! objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "blade")
        return notify_fail("你使用的武器不对。\n");

    if ((int)me->query_skill("liushui-blade", 1) < 40)
        return notify_fail("你的流水刀法不够娴熟，不会使用「流水行云」。\n");

    if ((int)me->query("neili") < 80)
        return notify_fail("你的内力不够。\n");

    if (me->query_skill_mapped("blade") != "liushui-blade")
        return notify_fail("你没有激发流水刀法，不能使用「流水行云」。\n");

    msg = HIC "$N" HIC "使出流水刀法的绝技「流水行云」，手中" + weapon->name() +
          HIC "如行云流水般划出一道优美的弧线，斩向$n" HIC "！" NOR "\n";

    if (random(me->query_skill("blade")) > target->query_skill("dodge") / 3)
    {
        damage = (int)me->query_skill("liushui-blade", 1);
        damage = damage + random(damage / 2);

        me->add("neili", -80);
        COMBAT_D->real_damage(me, target, damage);

        msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 20,
                                   HIR "$n" HIR "躲闪不及，被$N" HIR
                                   "这一刀划出一道长长的伤口！" NOR "\n");
        me->start_busy(2);
    } else
    {
        msg += CYN "可是$p" CYN "看破了$P" CYN
               "的企图，轻轻一跃，躲开了这一刀。" NOR "\n";
        me->add("neili", -40);
        me->start_busy(3);
    }
    message_combatd(msg, me, target);
    return 1;
}