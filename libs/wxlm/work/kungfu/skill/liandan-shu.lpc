// liandan-shu.c

inherit SKILL;

string type() { return "knowledge"; }

int valid_enable(string usage) { return usage == "medical"; }

int valid_learn(object me)
{
	if ((int)me->query_skill("medical", 1) < 100)
		return notify_fail("你的基本医术造诣太浅，无"
				   "法领会深奥的炼丹术。\n");

	if ((int)me->query_skill("medical", 1) < (int)me->query_skill("liandan-shu", 1))
		return notify_fail("你的基本医术水平有限，无"
				   "法掌握更深奥的炼丹术。\n");

	return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【炼丹术】" ZJBR ZJBR NOR;
    msg += WHT "江湖中流传的炼制丹药的技艺，属于医术范畴。掌握炼丹术可以利用各种药材和器具，炼制出具有各种奇效的丹药，是行走江湖、疗伤解毒的重要辅助技能。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本医术 (`medical`) 等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "  基本医术 (`medical`) 等级需大于等于炼丹术等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  医术 (`medical`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  可以进行常规练习 (`practice`) 来提升，具体消耗参考基本技能。" ZJBR ZJBR;

    msg += HIY "〖主要用途〗" ZJBR NOR;
    msg += "  用于炼制各种丹药 (`liandan` 命令)。" ZJBR;
    msg += "  技能等级影响炼丹的成功率、丹药的品质和效果强度。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 炼丹需要消耗药材、精力，并可能需要特定的炼丹炉。" ZJBR;
    msg += "2. 炼丹失败可能导致药材损毁。" ZJBR;
    msg += "3. 高级丹药的炼制通常需要更高的炼丹术等级和更稀有的药材。" ZJBR;

    return msg;
}
