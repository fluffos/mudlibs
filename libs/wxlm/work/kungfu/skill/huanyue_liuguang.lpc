#include <combat.h>

inherit SKILL;

mapping *action = ({
([  "action" : "$N剑势如风,一招「" HIC "月光流转" NOR "」,手中$w化作一道流光刺向$n的$l",
    "force" : 220,
    "attack": 75,
    "dodge" : 80,
    "parry" : 70,
    "damage": 110,
    "lvl"   : 0,
    "skill_name" : "月光流转",
    "damage_type" : "刺伤"
]),
([  "action" : "$N使出「" HIW "幻影迷踪" NOR "」,身形突然变得飘忽不定,$w化作点点寒星射向$n",
    "force" : 260,
    "attack": 85,
    "dodge" : 90,
    "parry" : 80,
    "damage": 130,
    "lvl"   : 30,
    "skill_name" : "幻影迷踪",
    "damage_type" : "刺伤"
]),
([  "action" : "$N一式「" HIY "月华如水" NOR "」,$w剑芒吞吐,宛如水中月影,忽近忽远地刺向$n",
    "force" : 300,
    "attack": 95,
    "dodge" : 100,
    "parry" : 90,
    "damage": 150,
    "lvl"   : 60,
    "skill_name" : "月华如水",
    "damage_type" : "刺伤"
]),
([  "action" : "$N轻吟剑诀,一招「" HIM "流光溢彩" NOR "」,$w化作万千光点,将$n笼罩在其中",
    "force" : 340,
    "attack": 105,
    "dodge" : 110,
    "parry" : 100,
    "damage": 170,
    "lvl"   : 90,
    "skill_name" : "流光溢彩",
    "damage_type" : "刺伤"
]),
});

int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me)
{
    if ((int)me->query("max_neili") < 800)
        return notify_fail("你的内力不够。\n");

    if ((int)me->query_skill("force") < 120)
        return notify_fail("你的内功火候不够。\n");

    if ((int)me->query_skill("sword", 1) < 80)
        return notify_fail("你的基本剑法火候不够。\n");

    if ((int)me->query_skill("sword", 1) < (int)me->query_skill("huanyue_liuguang", 1))
        return notify_fail("你的基本剑法水平有限，无法领会更高深的幻月流光剑法。\n");

    return 1;
}

string query_skill_name(int level)
{
    int i;
    for (i = sizeof(action) - 1; i >= 0; i--)
        if (level >= action[i]["lvl"])
            return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    int i, level;
    level = (int) me->query_skill("huanyue_liuguang", 1);
    for (i = sizeof(action); i > 0; i--)
        if (level > action[i-1]["lvl"])
            return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    object weapon;

    if (!objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对。\n");

    if ((int)me->query("qi") < 60)
        return notify_fail("你的体力不够练幻月流光剑法。\n");

    if ((int)me->query("neili") < 60)
        return notify_fail("你的内力不够练幻月流光剑法。\n");

    me->receive_damage("qi", 55);
    me->add("neili", -58);
    return 1;
}

string perform_action_file(string action)
{
    return __DIR__"huanyue_liuguang/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
    int lvl;
    lvl = me->query_skill("huanyue_liuguang", 1);

    if (damage_bonus < 120 || lvl < 120) return 0;

    if (random(lvl) > victim->query_skill("dodge", 1)/2)
    {
        victim->receive_wound("qi", (damage_bonus - 100) / 3);
        return HIW "$N" HIW "幻月流光剑法的剑气如月光般流转，$n" HIW "只觉得浑身一阵刺痛！\n" NOR;
    }
}

string query_description()
{
    string msg;

    msg = HIY "【幻月流光剑法】" ZJBR NOR;
    msg += "一门讲究速度和幻影的高深剑法，以迅疾如风的剑势配合如幻似真的身法，令敌人难以捉摸。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  最大内力需达到 " HIY "800" NOR " 点。" ZJBR;
    msg += "  基本内功等级需达到 " HIY "120" NOR " 级。" ZJBR;
    msg += "  基本剑法等级需达到 " HIY "80" NOR " 级。" ZJBR;
    msg += "  基本剑法等级不可低于幻月流光剑法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  剑法（sword）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  必须持有剑类武器。" ZJBR;
    msg += "  气血：不低于 " HIR "60" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "55" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "58" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // hit_ob
    msg += "  命中时特效：" ZJBR;
    msg += "    当造成伤害值（`damage_bonus`）不低于 " HIR "120" NOR " 点且幻月流光剑法等级不低于 " HIY "120" NOR " 级时，" ZJBR;
    msg += "    有一定几率（比较自身剑法等级与目标基本轻功等级）对目标造成额外气血伤害。" ZJBR;
    msg += "    额外气血伤害 = ( 造成伤害值 - 100 ) / 3。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform/exert (huanyue.c)
    msg += HIC "  幻月无痕 (huanyue)" ZJBR NOR; // 招式名称
    msg += "    使用要求：" ZJBR; // 招式使用要求
    msg += "      幻月流光剑法等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      必须持有剑类武器。" ZJBR;
    msg += "      激发剑法为幻月流光剑法。" ZJBR;
    msg += "    效果描述：" ZJBR; // 招式效果描述
    msg += "      命中判定综合比较双方的（基本剑法等级 + 基本轻功等级）与（基本轻功等级 + 基本招架等级）。" ZJBR;
    msg += "      命中后对目标造成伤害，伤害值约为（（基本剑法等级 + 基本轻功等级）+ 随机（（基本剑法等级 + 基本轻功等级）/ 2））。" ZJBR;
    msg += "      命中后有几率（比较（自身剑法等级 + 自身轻功等级）与目标（轻功等级 + 招架等级））使目标陷入忙乱状态。" ZJBR;
    msg += "      忙乱时间约为 (自身剑法等级 + 自身轻功等级) / 200 + 2 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR; // 消耗与代价
    msg += "      命中：内力 " HIB "150" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "50" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;

    return msg;
}