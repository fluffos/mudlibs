int valid_enable(string usage) { return usage == "club" || usage == "parry"; }

int valid_learn(object me)
{

     if ((int)me->query_skill("riyue-xinfa", 1) < 80)
         return notify_fail("你的内功心法火候太浅，不能学日月天魔棍。\n");

     if ((int)me->query_skill("club", 1) < 80)
         return notify_fail("你的基本棍法火候不够。\n");

     if ((int)me->query("max_neili") < 350)
         return notify_fail("你的内力太低，无法学日月天魔棍。\n");

     if ((int)me->query_skill("club", 1) < (int)me->query_skill("tianmo-gun", 1))
         return notify_fail("你的基本棍法水平有限，无法领会更高深的日月天魔棍。\n");

     return 1;
}

string query_skill_name(int level)
{
     int i;
     for(i = sizeof(action)-1; i >= 0; i--)
     if(level >= action[i]["lvl"])
            return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
     int i, level;
     level = (int) me->query_skill("tianmo-gun", 1);
     for(i = sizeof(action); i > 0; i--)
         if(level > action[i-1]["lvl"])
              return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
     object weapon;

     if (! objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "club")
            return notify_fail("你使用的武器不对。\n");

     if ((int)me->query("qi") < 70)
            return notify_fail("你的体力不够练日月天魔棍。\n");

     if ((int)me->query("neili") < 80)
            return notify_fail("你的内力不够练日月天魔棍。\n");

     me->receive_damage("qi", 65);
     me->add("neili", -68);
     return 1;
}

string perform_action_file(string action)
{
     return __DIR__"tianmo-gun/" + action;
}

string query_description()
{
    string msg;

    msg = HIM "【日月天魔棍】" ZJBR NOR;
    msg += "一门气势磅礴的棍法，招式凌厉狠辣，变化多端，威力巨大。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  日月心法 " HIY "80" NOR " 级以上。" ZJBR;
    msg += "  基本长兵 " HIY "80" NOR " 级以上。" ZJBR;
    msg += "  内力最大值 " HIB "350" NOR " 点以上。" ZJBR;
    msg += "  基本长兵等级不能低于日月天魔棍等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  棍法（club）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  必须手持棍类武器。" ZJBR;
    msg += "  气血：不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "80" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "65" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "68" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // hit_ob, valid_damage, skill_improved etc.
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform/exert
    msg += HIC "  天旋地转 (tian)" ZJBR NOR; // 招式名称
    msg += "    使用要求：" ZJBR; // 招式使用要求
    msg += "      日月天魔棍等级 " HIY "100" NOR " 级以上。" ZJBR;
    msg += "      当前内力 " HIB "150" NOR " 点以上。" ZJBR;
    msg += "      需要领悟此招式（can_perform/tianmo-gun/tian）。" ZJBR;
    msg += "      必须手持棍类武器且在战斗中对敌人使用。" ZJBR;
    msg += "    效果描述：" ZJBR; // 招式效果描述
    msg += "      运转真元，手中棍法灵动如蛇，连续进行多次攻击。" ZJBR;
    msg += "      攻击次数：与角色基础攻击次数相同。" ZJBR;
    msg += "      攻击力提升：提高（日月天魔棍等级 / 3）点攻击力。" ZJBR;
    msg += "      伤害提升：提高（日月天魔棍等级 / 6）点伤害。" ZJBR;
    msg += "    消耗与代价：" ZJBR; // 消耗与代价
    msg += "      发动消耗：内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "      使用后：自身忙乱 " HIR "2-4" NOR " 秒。" ZJBR;

    return msg;
}


