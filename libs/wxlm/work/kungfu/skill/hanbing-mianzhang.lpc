int valid_enable(string usage)
{
	return usage=="strike" || usage=="parry";
}

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练寒冰绵掌必须空手。\n");

	if ((int)me->query_skill("force") < 120)
		return notify_fail("你的内功火候不够，无法练寒冰绵掌。\n");

	if ((int)me->query("max_neili") < 900)
		return notify_fail("你的内力太弱，无法练寒冰绵掌。\n");

	if ((int)me->query_skill("strike", 1) < 80)
		return notify_fail("你的基本掌法火候不够，无法练寒冰绵掌。\n");

	if ((int)me->query_skill("strike", 1) < 80)
		return notify_fail("你的基本掌法水平有限，无法领会更高深的寒冰绵掌。\n");

	if ((int)me->query_skill("strike", 1) < (int)me->query_skill("hanbing-mianzhang", 1))
		return notify_fail("你的基本掌法水平有限，无法领会更高深的寒冰绵掌。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level   = (int) me->query_skill("hanbing-mianzhang",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 60)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 60)
		return notify_fail("你的内力不够练寒冰绵掌。\n");

	me->receive_damage("qi", 50);
	me->add("neili", -54);
	return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int lvl;
	int flvl;

	lvl  = me->query_skill("hanbing-mianzhang", 1);
	flvl = me->query("jiali");
	if (lvl < 80 || flvl < 10 || ! damage_bonus || random(4))
		return;

    	if (flvl * 2 + random(lvl) > victim->query_skill("force") &&
	    victim->affect_by("ice_poison",
			      ([ "level" : flvl + random(flvl),
				 "id"    : me->query("id"),
				 "duration" : lvl / 20 + random(lvl / 3) ])))
	{
		return "$n忽然神色大变，一个寒战，退了几步。\n";
    	}
}

string perform_action_file(string action)
{
	return __DIR__"hanbing-mianzhang/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【寒冰绵掌】" ZJBR NOR;
    msg += WHT "寒冰绵掌是一门阴柔诡异的掌法，以其寒毒和绵密掌力著称。" ZJBR;
    msg += "此掌法讲究以柔克刚，掌力绵密如棉，却又寒毒刺骨，令人防不胜防。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  空手状态。" ZJBR;
    msg += "  内功激发等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "  最大内力 " HIB "900" NOR " 点。" ZJBR;
    msg += "  基本掌法等级 " HIY "80" NOR " 级。" ZJBR;
    msg += "  基本掌法等级须大于等于寒冰绵掌等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  掌法（strike）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "60" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "54" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += WHT "  寒毒侵体：" ZJBR NOR;
    msg += "    触发条件：" ZJBR;
    msg += "      寒冰绵掌等级 " HIY "80" NOR " 级以上。" ZJBR;
    msg += "      当前加力 " HIB "10" NOR " 点以上。" ZJBR;
    msg += "      普通攻击命中目标。" ZJBR;
    msg += "      通过随机判定 (75% 概率)。" ZJBR;
    msg += "      自身 (加力 * 2 + 随机(寒冰绵掌等级)) 大于 目标内功激发等级。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      使目标中寒毒 (`ice_poison`)。" ZJBR;
    msg += "      寒毒等级 = 加力 + 随机(加力)。" ZJBR;
    msg += "      寒毒持续时间 = (寒冰绵掌等级 / 20) + 随机(寒冰绵掌等级 / 3) 秒。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  青蝠吸血 (xixueqingfu)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      战斗中对敌人使用。" ZJBR;
    msg += "      空手状态。" ZJBR;
    msg += "      寒冰绵掌等级 " HIY "60" NOR " 级。" ZJBR;
    msg += "      基本轻功等级 " HIY "200" NOR " 级。" ZJBR;
    msg += "      激发掌法为寒冰绵掌。" ZJBR;
    msg += "      当前内力 " HIB "300" NOR " 点以上。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：比较双方的有效轻功 (基本轻功等级 + 后天身法 * 10)。" ZJBR;
    msg += "      自身 (有效轻功 / 4 + 随机(有效轻功 / 2)) 大于 目标 (有效轻功 / 2) 则第一次判定命中。" ZJBR;
    msg += "      若第一次判定命中：对目标造成伤害，伤害值约为 (寒冰绵掌等级 * 5 + 随机(寒冰绵掌等级))。" ZJBR;
    msg += "      若第一次判定未命中，进行第二次命中判定(使用COMBAT_D->hit_determination)：" ZJBR;
    msg += "      若第二次判定命中：对目标造成伤害，伤害值约为 (寒冰绵掌等级 + 随机(寒冰绵掌等级))。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      第一次判定命中：消耗内力 " HIB "300" NOR " 点，自身忙乱 " HIR "4" NOR " 秒。" ZJBR;
    msg += "      第二次判定命中：消耗内力 " HIB "200" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;
    msg += "      完全未命中：消耗内力 " HIB "50" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 寒冰绵掌需要空手施展，不可持武器。" ZJBR;
    msg += "2. 寒毒侵体的成功率与自身加力、寒冰绵掌等级以及目标内功等级有关。" ZJBR;
    msg += "3. 青蝠吸血招式极耗内力，且命中判定复杂，使用需谨慎。" ZJBR;

    return msg;
}