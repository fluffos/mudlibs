// hammer.c 基本锤法
// Modified by Venus Oct.1997

inherit SKILL;

string query_description()
{
    string msg;

    msg = HIY "【基本锤法】" ZJBR NOR;
    msg += "挥舞锤类兵器的基础技巧。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  无特殊要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // Can be inferred it enables 'hammer'
    msg += "  锤法（hammer）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR; // Added parry based on valid_enable

    msg += HIY "〖练习要求〗" ZJBR NOR; // Based on added practice_skill
    msg += "  需装备锤类武器。" ZJBR;
    msg += "  当前气血不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  当前内力不低于 " HIB "15" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "30" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "5" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  提升使用锤类武器时的攻击效果。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无特殊招式。" ZJBR;

    return msg;
}

// Add other basic skill functions if needed, e.g., valid_enable
int valid_enable(string usage) { return usage == "hammer" || usage == "parry"; }

int valid_learn(object me)
{
    // Add potential basic requirements if necessary, e.g., minimum str
    return 1;
}

int practice_skill(object me)
{
    object weapon;

    if (!objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "hammer")
        return notify_fail("你使用的武器不对。\n");

    if ((int)me->query("qi") < 50)
        return notify_fail("你的体力不够练基本锤法。\n");

    if ((int)me->query("neili") < 15)
        return notify_fail("你的内力不够练基本锤法。\n");

    me->receive_damage("qi", 30);
    me->add("neili", -5);
    return 1;
}

