
#include <combat.h>

#define JIUTIAN "「" HIY "九天揽月" NOR "」"

inherit F_SSERVER;

string query_name() { return "九天"ZJBR"揽月"; }

int perform(object me, object target)
{
    object weapon;
    int damage;
    string msg;
    int ap, dp;

    if (! target) target = offensive_target(me);

    if (! target || ! me->is_fighting(target))
        return notify_fail(JIUTIAN "只能对战斗中的对手使用。\n");

    if (! objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对，难以施展" JIUTIAN "。\n");

    if ((int)me->query_skill("tianwai_feixian", 1) < 140)
        return notify_fail("你的天外飞仙剑法不够娴熟，难以施展" JIUTIAN "。\n");

    if (me->query_skill_mapped("sword") != "tianwai_feixian")
        return notify_fail("你没有激发天外飞仙剑法，难以施展" JIUTIAN "。\n");

    if ((int)me->query("neili") < 250)
        return notify_fail("你现在的真气不够，难以施展" JIUTIAN "。\n");

    if (! living(target))
        return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

    msg = HIY "$N" HIY "轻声吟道：'九天揽月照沧海'，手中" + weapon->name() + HIY "剑芒暴涨，如天外飞仙般自上而下斩向$n" HIY "！\n" NOR;

    ap = me->query_skill("sword") + me->query_skill("force");
    dp = target->query_skill("dodge") + target->query_skill("parry");

    if (COMBAT_D->hit_determination(me,target,ap,dp))
    {
        damage = ap + random(ap / 2);
        me->add("neili", -200);
        msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 70,
                                   HIR "$n" HIR "只觉一股寒意自头顶笼罩全身，$N" HIR "的剑气如皓月当空，"
                                   "根本无处可避，被这一剑结结实实命中，顿时鲜血狂涌！\n" NOR);
        me->start_busy(2);
        if (ap / 3 + random(ap) > dp && ! target->is_busy())
            target->start_busy(ap / 200 + 2);
    } else
    {
        me->add("neili", -100);
        msg += CYN "可是$n" CYN "看破了$N" CYN "的剑势，纵身一跃，堪堪避过。\n" NOR;
        me->start_busy(3);
    }
    message_combatd(msg, me, target);
    return 1;
}
