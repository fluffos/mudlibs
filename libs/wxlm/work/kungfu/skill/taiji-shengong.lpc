// taiji-shengong.c 太极神功
// By Xiang
// Modified by Hop

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_force(string force)
{
	return force == "hunyuan-yiqi" ||
	       force == "yijinjing" ||
	       force == "wudang-xinfa" ||
	       force == "shaolin-xinfa";
}

int query_neili_improve(object me)
{
	int lvl;

	lvl = (int)me->query_skill("taiji-shengong", 1);
	return lvl * lvl * 15 * 18 / 100 / 200;
}

int valid_learn(object me)
{
	if (me->query("gender") == "无性" && (int)me->query_skill("taiji-shengon", 1) > 19)
		return notify_fail("你无根无性，阴阳不调，难以领会高深的太极神功。\n");

	if ((int)me->query_skill("force", 1) < 100)
		return notify_fail("你的基本内功火候还不够。\n");

	if ((int)me->query_skill("taoism", 1) < 100)
		return notify_fail("你对道家心法领悟的太浅，无法理解太极神功。\n");

	if ((int)me->query_skill("taoism", 1) < 500 &&
	    (int)me->query_skill("taoism", 1) <(int)me->query_skill("taiji-shengong", 1))
		return notify_fail("你对道家心法领悟的有限，无法理解更高深太极神功。\n");

	return ::valid_learn(me);
}

int practice_skill(object me)
{
	return notify_fail("太极神功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"taiji-shengong/" + func;
}

string query_description()
{
	string msg;
	
	msg = HIY "【太极神功】" ZJBR NOR;
	msg += "太极神功乃武当派镇派绝学，源自道家阴阳太极之理，讲究以柔克刚、以静制动，在调和阴阳的基础上发挥内力。" ZJBR ZJBR;
	
	msg += HIY "〖学习要求〗" ZJBR NOR;
	msg += "  基本内功等级：" HIY "100" NOR " 级。" ZJBR;
	msg += "  道学心法等级：" HIY "100" NOR " 级。" ZJBR;
	msg += "  性别要求：非无性（无性者最多只能学到19级）。" ZJBR;
	msg += "  太极神功等级不能超过道学心法等级（除非道学心法达到500级以上）。" ZJBR ZJBR;
	
	msg += HIY "〖激发类型〗" ZJBR NOR;
	msg += "  内功（force）。" ZJBR ZJBR;
	
	msg += HIY "〖可融合内功〗" ZJBR NOR;
	msg += "  混元一气功（hunyuan-yiqi）。" ZJBR;
	msg += "  易筋经神功（yijinjing）。" ZJBR;
	msg += "  武当心法（wudang-xinfa）。" ZJBR;
	msg += "  少林心法（shaolin-xinfa）。" ZJBR ZJBR;
	
	msg += HIY "〖练习要求〗" ZJBR NOR;
	msg += "  太极神功只能通过学习（learn）来提升熟练度。" ZJBR ZJBR;
	
	msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
	msg += "  内力最大值提升：习练者的内力最大值增加（每级提升 " HIB + "lvl * lvl * 15 * 18 / 100 / 200" NOR " 点）。" ZJBR ZJBR;
	
	msg += HIY "〖特殊招式〗" ZJBR NOR;
	
	msg += HIC "  太极战意 (powerup)" ZJBR NOR;
	msg += "    使用要求：" ZJBR;
	msg += "      当前内力：" HIB "150" NOR " 点。" ZJBR;
	msg += "    效果描述：" ZJBR;
	msg += "      运行太极神功，全身灌满真气，提升自身战斗力。" ZJBR;
	msg += "      持续时间等于内功等级秒。" ZJBR;
	msg += "      提升攻击力：" HIY "内功等级 / 3" NOR " 点。" ZJBR;
	msg += "      提升招架力：" HIY "内功等级 / 3" NOR " 点。" ZJBR;
	msg += "    消耗与代价：" ZJBR;
	msg += "      内力：" HIB "100" NOR " 点。" ZJBR;
	msg += "      战斗中使用会造成忙碌 " HIR "3" NOR " 秒。" ZJBR ZJBR;
	
	msg += HIC "  太极护体 (shield)" ZJBR NOR;
	msg += "    使用要求：" ZJBR;
	msg += "      太极神功等级：" HIY "50" NOR " 级。" ZJBR;
	msg += "      当前内力：" HIB "100" NOR " 点。" ZJBR;
	msg += "    效果描述：" ZJBR;
	msg += "      运行太极神功护体，增强防御力。" ZJBR;
	msg += "      持续时间等于内功等级秒。" ZJBR;
	msg += "      提升防御力：" HIY "内功等级 / 2" NOR " 点。" ZJBR;
	msg += "    消耗与代价：" ZJBR;
	msg += "      内力：" HIB "100" NOR " 点。" ZJBR;
	msg += "      战斗中使用会造成忙碌 " HIR "2" NOR " 秒。" ZJBR ZJBR;
	
	msg += HIC "  太极疗伤 (dian)" ZJBR NOR;
	msg += "    使用要求：" ZJBR;
	msg += "      最大内力：" HIB "1500" NOR " 点。" ZJBR;
	msg += "      当前内力：" HIB "1000" NOR " 点。" ZJBR;
	msg += "    效果描述：" ZJBR;
	msg += "      使用鹤嘴劲点龙跃窍为他人治疗伤势。" ZJBR;
	msg += "      治疗气血伤害：" HIY "100 + 内功等级 + 太极神功等级 * 3" NOR " 点。" ZJBR;
	msg += "      治疗精神伤害：" HIY "100 + 内功等级 / 3 + 太极神功等级" NOR " 点。" ZJBR;
	msg += "    使用条件：" ZJBR;
	msg += "      不能在战斗中使用。" ZJBR;
	msg += "      不能为自己疗伤，只能为他人疗伤。" ZJBR;
	msg += "      对方必须有伤势才能使用。" ZJBR;
	msg += "    消耗与代价：" ZJBR;
	msg += "      内力：" HIB "800" NOR " 点。" ZJBR;
	msg += "      气血：" HIR "100" NOR " 点。" ZJBR;
	msg += "      精神：" HIR "50" NOR " 点。" ZJBR;
	msg += "      使用后会进入忙碌状态 " HIR "10" NOR " 秒。" ZJBR;
	msg += "      治疗对象会进入忙碌状态 " HIR "2" NOR " 秒。" ZJBR;
	
	return msg;
}
