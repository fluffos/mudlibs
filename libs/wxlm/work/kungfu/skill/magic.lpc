// magic.c 基本法术
// Modified by venus Oct.1997

inherit SKILL;

string type() {return "knowledge"; }

string query_description()
{
    string msg;

    msg = HIY "【基本法术】" ZJBR NOR;
    msg += "学习和施展各种法术的基础技能，本身不提供任何直接的法术效果。" ZJBR;
    msg += "提高基本法术等级是学习更高级法术的前提。" ZJBR ZJBR; // 基本介绍 & type

    msg += HIY "〖学习要求〗" ZJBR NOR; // 无 valid_learn
    msg += "  无特殊要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // 知识类技能
    msg += "  知识类技能，无法激发。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // 无 practice_skill
    msg += "  通常通过向师傅学习（learn）或阅读相关书籍提升。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // 无 perform/exert
    msg += "  无。" ZJBR;

    return msg;
}
