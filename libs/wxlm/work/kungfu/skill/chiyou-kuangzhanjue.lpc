// This program is a part of NITAN MudLIB

inherit FORCE;

int valid_enable(string usage)
{
            return usage == "force";
}

int valid_force(string force)
{
        return 1;
}

int valid_learn(object me)
{
            return ::valid_learn(me);
}

int practice_skill(object me)
{
            return notify_fail("蚩尤狂战决只能用学(learn)的来增加熟练度。\n");
}

string main_skill() { return "yongzhao-shanhe"; }

string exert_function_file(string func)
{
            return __DIR__"chiyou-kuangzhanjue/" + func;
}

string query_description()
{
    string msg;

    msg = HIY "【蚩尤狂战决】" ZJBR NOR;
    msg += "上古战神蚩尤所创内功心法，霸道绝伦，愈战愈狂。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  学习要求遵循内功基本要求。" ZJBR ZJBR; // ::valid_learn(me) 表示遵循通用学习规则

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功 (force)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  无法练习，只能通过学习 (learn) 提升。" ZJBR ZJBR;

    msg += HIY "〖攻击特效〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR; // 代码中未定义 hit_ob

    msg += HIY "〖防御特效〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR; // 代码中未定义 valid_damage

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  『神刀化血』(huaxue)" NOR ZJBR;
    msg += "    要求：装备刀类武器，蚩尤狂战决 150 级，内力 200 点，战斗中。" ZJBR;
    msg += "    消耗：内力 150 点。" ZJBR;
    msg += "    效果：以自身一半气血为代价，大幅提升攻击力和刀法伤害。" ZJBR;
    msg += "          提升的数值为 (蚩尤狂战决基本等级 / 5)。" ZJBR;
    msg += "          效果持续时间与奥义「魔血染刀」等级相关，等级越高持续时间越长（基础 1 秒 + 奥义等级 秒）。" ZJBR;
    msg += "    冷却：5 秒。" ZJBR ZJBR; // query_cd() 返回 5

    msg += HIC "  『蚩尤罡气』(shield)" NOR ZJBR;
    msg += "    要求：蚩尤狂战决 50 级，内力 100 点。" ZJBR;
    msg += "    消耗：内力 100 点。" ZJBR;
    msg += "    效果：提升自身防御力 (armor)，提升数值为 (内功激发等级 / 5)。" ZJBR;
    msg += "          效果持续时间与提升的防御数值相同（秒）。" ZJBR;
    msg += "    特殊：运功时自身会忙乱 2 秒。" ZJBR ZJBR;

    msg += HIR "  『蚩尤战意』(powerup)" NOR ZJBR;
    msg += "    要求：内力 150 点。" ZJBR;
    msg += "    消耗：内力 100 点。" ZJBR;
    msg += "    效果：提升自身攻击力和防御力。" ZJBR;
    msg += "          提升的数值为 (内功激发等级 / 10)。" ZJBR;
    msg += "          效果持续时间与提升的攻防数值相同（秒）。" ZJBR;
    msg += "    特殊：运功时自身会忙乱 3 秒。" ZJBR;

    return msg;
}
