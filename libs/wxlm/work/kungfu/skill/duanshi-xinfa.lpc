// duanshi-xinfa.c 段氏御龙心经
inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_force(string force)
{
	return force == "xiantian-qigong" ||
	       force == "quanzhen-xinfa"  ||
	       force == "kurong-changong";
}

int query_neili_improve(object me)
{
    int lvl;

    lvl = (int)me->query_skill("duanshi-xinfa", 1);
    return lvl * lvl * 15 * 18 / 100 / 200;
}

int valid_learn(object me)
{
    	if (me->query("gender") == "无性" &&
	    (int)me->query_skill("duanshi-xinfa") > 49)
    		    return notify_fail("你无根无性，阴阳不调，难以领会高深的段氏御龙心经。\n");

	return ::valid_learn(me);
}

int practice_skill(object me)
{
	return notify_fail("段氏御龙心经只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"duanshi-xinfa/" + func;
}

string query_description()
{
    string msg;

    msg = HIY "【段氏御龙心经】" ZJBR NOR;
    msg += "大理段氏独门内功心法，气息绵长，内劲浑厚。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  遵循基本内功（force）的学习要求。" ZJBR;
    msg += "  无性者等级不能超过 " HIY "49" NOR " 级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  内功（force）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  无法通过练习提升，只能通过学习提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  提升内力上限：效果随等级提升（参考 `query_neili_improve`）。" ZJBR;
    msg += "  兼容内功：可兼容 先天奇功 (xiantian-qigong), 全真心法 (quanzhen-xinfa), 枯荣禅功 (kurong-changong)。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // exert_function_file

    msg += HIC "  御龙帝威 (powerup)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      只能对自己使用。" ZJBR;
    msg += "      当前内力不低于 " HIB "150" NOR " 点。" ZJBR;
    msg += "      不能重复使用（需效果结束后才能再用）。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升 攻击命中、空手伤害、护甲，提升值均为 (内功激发等级 / 3)。" ZJBR;
    msg += "      效果持续时间为 (内功激发等级) 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "50" NOR " 点。战斗中使用则自身忙乱 " HIR "3" NOR " 秒。" ZJBR;

    return msg;
}