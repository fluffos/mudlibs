// necromancy.c 降伏法
// by Java

inherit SKILL;

int valid_learn(object me)
{
    if( (int)me->query_skill("longxiang",1) <
	(int)me->query_skill("necromancy",1) )
      return notify_fail("你的龙相般若功太低了，无法修炼更高深的降伏法。\n");

    return 1;
}

int practice_skill(object me)
{
    return notify_fail("降伏法只能靠学(learn)来提高。\n");
}

string query_description()
{
    string msg;

    msg = HIY "【降伏法】" ZJBR NOR;
    msg += "一门源自密宗的神秘法术，用于降服特定的妖魔鬼怪。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  龙相般若功 (`longxiang`) 等级需大于等于降伏法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  该技能无法被激发为任何常规战斗类型。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  降伏法无法通过练习 (`practice`) 提升，只能通过学习 (`learn`) 或研究提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  主要效果体现为降服特定NPC或触发特定事件，具体效果视游戏内容而定。" ZJBR;
    msg += "  该技能本身未定义常规的攻防特效或属性成长。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  该技能目前没有定义特殊的主动招式。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 降伏法的效果和威力与使用者的龙相般若功修为密切相关。" ZJBR;
    msg += "2. 使用时需谨慎，具体可降服的对象和成功率受多种因素影响。" ZJBR;

    return msg;
}
