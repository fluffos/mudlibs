// zhuifeng-steps.c  追风步
// modified by Venus Oct.1997
// by jacki

inherit SKILL;

string *dodge_msg = ({
    "$n一个「随风而舞」，身形飘忽不定，躲过了$N这一招。\n",
    "$n身形飘飘，使出一招「身随意转」，避过了$N的攻击。\n",
    "$n使出「移步换形」，在千钧一发间躲过了$N的攻势。\n",
    "$n衣袂飘飘，一招「事了拂衣去」，潇洒地避了开去。\n"
});

int valid_enable(string usage)
{
    return (usage == "dodge") || (usage == "move");
}

int valid_learn(object me) { return 1; }

string query_dodge_msg(string limb)
{
    return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
    if( (int)me->query("qi") < 50 )
	return notify_fail("你的体力太差了，不能练追风步。\n");

    me->receive_damage("qi", 40);
    return 1;
}
string query_description()
{
    string msg;

    msg = HIY "【追风步】" ZJBR NOR;
    msg += WHT "追风步是一门基础轻功身法，以动作轻灵飘逸、迅捷如风著称。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  无特殊学习要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  轻功 (dodge)。" ZJBR;
    msg += "  身法 (move)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  当前气血 不低于 " HIY "50" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖练习消耗〗" ZJBR NOR;
    msg += "  每次练习消耗 气血 " HIR "40" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖闪避招式〗" ZJBR NOR;
    msg += "  激发追风步为轻功时，战斗中可随机施展以下闪避招式：" ZJBR;
    msg += "  「随风而舞」、「身随意转」、「移步换形」、「事了拂衣去」。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无特殊招式。" ZJBR;

    return msg;
}

