int valid_enable(string usage) { return usage == "finger" || usage == "parry"; } 
      
int valid_learn(object me) 
{ 
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon")) 
		return notify_fail("练一气指必须空手。\n"); 
      
	if ((int)me->query_skill("force") < 150) 
		return notify_fail("你的内功火候不够，无法学习一气指。\n"); 
     
	if ((int)me->query("max_neili") < 2000) 
		return notify_fail("你的内力太弱，无法练一气指。\n"); 
      
	if ((int)me->query_skill("finger", 1) < (int)me->query_skill("yiqi-zhi", 1))
		return notify_fail("你的基本指法水平有限，无法领会更高深的一气指。\n"); 
      
	return 1; 
} 
      
string query_skill_name(int level) 
{ 
	int i; 
	for (i = sizeof(action) - 1; i >= 0; i--) 
		if (level >= action[i]["lvl"]) 
			return action[i]["skill_name"]; 
} 
      
mapping query_action(object me, object weapon) 
{ 
	int i, level; 
	level = (int) me->query_skill("duoluoye-zhi", 1); 
	for (i = sizeof(action); i > 0; i--) 
		if (level > action[i-1]["lvl"]) 
			return action[NewRandom(i, 20, level/5)]; 
} 
      
int practice_skill(object me) 
{ 
	if (me->query_temp("weapon") || 
	    me->query_temp("secondary_weapon")) 
		return notify_fail("你必须空手练习！\n"); 
      
	if ((int)me->query("qi") < 130) 
		return notify_fail("你的体力太低了。\n"); 
      
	if ((int)me->query("neili") < 110) 
		return notify_fail("你的内力不够练一气指。\n");
      
	me->receive_damage("qi", 110);
	me->add("neili", -100); 
	return 1; 
} 
string query_description()
{
    string msg;

    msg = HIY "【一气指】" ZJBR NOR;
    msg += WHT "一气指是一门以内力凝聚于指尖的高深指法，" ZJBR;
    msg += "讲究以一气贯通，指力凌厉，可破敌人护体真气，是一门极为霸道的武功。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本指法等级：需不低于一气指等级" ZJBR;
    msg += "  基本内功等级：150级" ZJBR;
    msg += "  最大内力：2000点" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  指法 (finger)" ZJBR;
    msg += "  招架 (parry)" ZJBR ZJBR;

    msg += HIY "〖招式精要〗" ZJBR NOR;
    msg += "1. 右指弹出一屡劲风，飘渺无形（初级）" ZJBR;
    msg += "2. 手捏不动手印，双手回旋，将敌人笼罩在指风之中（40级）" ZJBR;
    msg += "3. 右指长驱直入，弛点敌人大穴，两败俱伤的打法（80级）" ZJBR;
    msg += "4. 纵身跃起，居高临下，双手分别点向敌人各大要穴（120级）" ZJBR;
    msg += "5. 内力灌注于指间，一指戳出，勇不可挡，硬破入敌人的招数中（160级）" ZJBR;
    msg += "6. 连环三指击出，一气呵成，射出三屡指风（200级）" ZJBR;
    msg += "7. 右手食指点出，缓缓按向敌人，似乎毫不着力（240级）" ZJBR;
    msg += "8. 尽起全身功力，双指弹出数道指风，将敌人完全笼罩在攻势之下（280级）" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血消耗：110点" ZJBR;
    msg += "  内力消耗：100点" ZJBR ZJBR;

    msg += HIR "〖注意事项〗" ZJBR NOR;
    msg += "1. 一气指需要深厚的内功修为，修炼时需注意提高内功等级。" ZJBR;
    msg += "2. 在实战中，应善于利用指法特性，破解敌人防御。" ZJBR;
    msg += "3. 练习时必须空手。" ZJBR;
    msg += "4. 配合其他武功使用，可以发挥出更强的威力。\n";

    return msg;
}
