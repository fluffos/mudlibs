#define CN_NAME "淑女剑法"
inherit SKILL;

mapping *action = ({
([ 	"action": "$N使一招「淑女玉兰」，手中的$w在一弹指间已向$n的$l连刺数剑",
	"force" : 300,
	"attack": 85,
	"dodge" : 10,
	"parry" : 5,
	"damage": 100,
	"lvl"   : 0,
	"skill_name" : "淑女剑法",
	"damage_type":  "瘀伤"
]),
([  	"action": "$N使一招「有君好逑」，手中$w狂风骤雨般地向$n的$l连攻数剑",
	"force" : 350,
	"attack": 25,
	"dodge" : 15,
	"parry" : 10,
	"damage": 610,
	"lvl"   : 30,
	"skill_name" : "淑女剑法",
	"damage_type":  "瘀伤"
]),
});

string query_txt()
{
	return "要求：基本剑法 150级";
}

int valid_learn(object me)
{
	if ((int)me->query_skill("sword", 1) < 150)
		return notify_fail("你的剑法根基有限，无法学习淑女剑法。\n");
	return 1;
}

int valid_enable(string usage)
{
	return usage == "sword" ;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action)-1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int)me->query_skill("shunv-jian", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i - 1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 60)
		return notify_fail("你现在手足酸软，休息一下再练吧。\n");

	if ((int)me->query("neili") < 80)
		return notify_fail("你的内力不够了。\n");

	me->receive_damage("qi", 50);
	me->add("neili", -60);

	return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【淑女剑法】" ZJBR NOR;
    msg += WHT "古墓派剑法之一，剑式轻柔婉转，姿态娴雅，暗藏锋芒。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  基本剑法 (`sword`) 等级不低于 " HIY "150" NOR " 级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  剑法（sword）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  气血：不低于 " HIR "60" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "80" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "60" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // 无
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // 无 perform/exert
    msg += "  无。" ZJBR ZJBR;

    return msg;
}

