// xuantian-shengong.c 玄天神功
// modified by Venus Oct.1997

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_learn(object me)
{
    if ( (int)me->query_skill("force", 1) < 120 )
	return notify_fail("你的基本内功火候还不够。\n");

    if (me->query("gender") == "无性" &&
	(int)me->query_skill("xuantian-shengong", 1) > 49)
    	    return notify_fail("你无根无性，阴阳不调，难以领会高深的玄天神功。\n");

    return 1;
}

int query_neili_improve(object me)
{
	int lvl;

	lvl = (int)me->query_skill("xuantian-shengong", 1);
	return lvl * lvl * 15 * 10 / 100 / 200;
}

int practice_skill(object me)
{
    return notify_fail("玄天神功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
    return __DIR__"xuantian-force/" + func;
}
string query_description()
{
    string msg;

    msg = HIY "【玄天神功】" ZJBR NOR;
    msg += WHT "玄天神功乃源自北方玄天一脉的高深内功心法，讲究阴阳调和，" ZJBR;
    msg += WHT "修炼此功可大幅增长内力修为，平衡阴阳，增强体质。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功 等级：" HIY "120" NOR " 级。" ZJBR;
    msg += "  性别要求：非 无性 (玄天神功 50 级以上时)。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功 (force)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  玄天神功只能通过学习 (learn) 提升，无法练习 (practice)。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  提升内力上限：提升值为 (玄天神功等级 * 玄天神功等级 * 3 / 400) 点。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  玄天吼 (roar)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      玄天神功 已激发为内功。" ZJBR;
    msg += "      当前内力 不低于 " HIB "100 + 玄天神功等级 * 2" NOR " 点。" ZJBR;
    msg += "      当前气血 不低于 最大气血 的一半。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对周围所有生物（除自己外）造成影响。" ZJBR;
    msg += "      判定几率：(内功激发等级 / 2 + 随机(内功激发等级 / 2)) >= 目标先天根骨 * 2 时，判定成功。" ZJBR;
    msg += "      判定成功后，对目标造成精神伤害和损伤：" ZJBR;
    msg += "        伤害基数 = 内功激发等级 - (目标最大内力 / 10) （伤害基数须大于0）" ZJBR;
    msg += "        精神伤害：(伤害基数 * 2) 点。" ZJBR;
    msg += "        精神损伤：若目标当前内力低于 (内功激发等级 * 2)，则额外受到 (伤害基数) 点精神损伤。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100 + 内功激发等级 * 2" NOR " 点。" ZJBR;
    msg += "      消耗气血 " HIR "10" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "5" NOR " 秒。" ZJBR;

    return msg;
}

