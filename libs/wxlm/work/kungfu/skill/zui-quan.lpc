int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }

int valid_learn(object me)
{
	if (me->query("family/family_name") != "少林派")
		return notify_fail("少林派的弟子才能学习醉拳。\n");
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练" + CN_NAME + "必须空手。\n");

	if ((int)me->query("max_neili") < 500)
		return notify_fail("你的内力太弱，无法练" + CN_NAME + "。\n");

	if (me->query_skill("unarmed", 1) < me->query_skill("zui-quan", 1))
		return notify_fail("你的基本拳脚水平有限，无法领悟更高深的" + CN_NAME + "。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action) - 1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("zui-quan", 1);
	for (i = sizeof(action); i > 0; i--)
		if(level > action[i - 1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	if (me->query("family/family_name") != "少林派")
		return notify_fail("少林派的弟子才能练习醉拳。\n");
	if ((int)me->query("qi") < 60)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 60)
		return notify_fail("你的内力不够练" + CN_NAME + "。\n");

	me->receive_damage("qi", 55);
	me->add("neili", -48);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"zui-quan/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【" + CN_NAME + "】" ZJBR NOR;
    msg += WHT "醉拳为少林派独门拳法，模仿醉汉形态，拳法飘忽不定，以醉态迷惑对手，实则招式精妙。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  门派要求：必须为 少林派 弟子。" ZJBR;
    msg += "  状态要求：必须空手，不能装备任何武器。" ZJBR;
    msg += "  最大内力 不低于 " HIB "500" NOR " 点。" ZJBR;
    msg += "  基本拳脚 等级不可低于 " + CN_NAME + " 等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  徒手 (unarmed)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  门派要求：必须为 少林派 弟子。" ZJBR;
    msg += "  当前气血 不低于 " HIR "60" NOR " 点。" ZJBR;
    msg += "  当前内力 不低于 " HIB "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗 气血 " HIR "55" NOR " 点，消耗 内力 " HIB "48" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  罗汉醉酒 (zui)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      基本" + CN_NAME + " 等级不低于 " HIY "80" NOR " 级。" ZJBR;
    msg += "      当前内力 不低于 " HIB "150" NOR " 点。" ZJBR;
    msg += "      未处于 罗汉醉酒 临时状态中。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      临时提升自身 后天身法 " HIG "3 + 随机(5)" NOR " 点。" ZJBR;
    msg += "      效果持续时间为 (基本" + CN_NAME + " 等级 / 3) 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;

    return msg;
}
