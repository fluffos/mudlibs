// finger.c

inherit SKILL;
int valid_selflearn(object me) {
	return 1;
}

int selflearn_skill(object me) { 
	if ((int)me->query("jing")<10) return 0;
	me->add("jing",-10);
	me->add("eff_jing",-10);
	return 1;
}

void skill_improved(object me)
{
    if (me->query_skill("finger",1)%30==0) {
	tell_object(me, HIW "由於你勤练武艺，你的"+HIY"【后天膂力】"+NOR+"提高了。"NOR"\n");
    }
}

string query_description()
{
    string msg;

    msg = HIY "【基本指法】" ZJBR NOR;
    msg += WHT "所有指法的基础，练习可提升运用指法的能力。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  无特殊要求。" ZJBR;
    msg += "  可自学 (`valid_selflearn` 返回 1)。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  无，为其他指法的基础。" ZJBR ZJBR;

    msg += HIY "〖练习/自学要求〗" ZJBR NOR; // selflearn_skill
    msg += "  自学：" ZJBR;
    msg += "    精不低于 " HIG "10" NOR " 点。" ZJBR;
    msg += "    每次自学消耗精：" HIG "10" NOR " 点。" ZJBR;
    msg += "    每次自学消耗有效精：" HIG "10" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // skill_improved
    msg += "  每提升 30 级，增加后天膂力。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    return msg;
}
