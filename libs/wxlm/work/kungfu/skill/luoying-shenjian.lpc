int valid_learn(object me)
{
	object ob;

	if ((int)me->query_skill("force") < 45)
		return notify_fail("你的内功火候还不够。\n");

	if ((int)me->query("max_neili") < 250)
		return notify_fail("你的内力不够，不能练落英神剑。\n");

	if (! objectp(ob = me->query_temp("weapon")) ||
	    (string)ob->query("skill_type") != "sword")
		return notify_fail("你必须先找一把剑才能学习剑法。\n");
	 if (me->query_skill("sword",1) <= me->query_skill("luoying-shenjian",1) )
	return notify_fail("你的基本剑法不够，无法领会更高深的落英神剑。\n");

	return 1;
}

int valid_enable(string usage)
{
	return usage == "sword" || usage == "parry";
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action) - 1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;

	level = (int)me->query_skill("luoying-shenjian", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i - 1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}
//等级提升，是否学会新的招式
string query_skill_up(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
	 {
		if(level == action[i]["lvl"])
		 {
		     return action[i]["skill_name"];
		 }
	 }
	  return "no";
}

int practice_skill(object me)
{
	object ob;

	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力太低，没有办法练习落英神剑。\n");

	if ((int)me->query("neili") < 35)
		return notify_fail("你的内力不够，没有办法练习落英神剑。\n");

	if (! objectp(ob = me->query_temp("weapon")) ||
	    (string)ob->query("skill_type") != "sword")
		return notify_fail("你必须先找一把剑才能习练剑法。\n");

	me->receive_damage("qi", 45);
	me->add("force", -41);
	return 1;
}


string query_description()
{
    string msg;

    msg = HIY "【落英神剑】" ZJBR NOR;
    msg += "桃花岛独门剑法，剑法招式如同落英缤纷，轻灵飘逸，变化无方。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功 (force) 等级不低于 " HIY "45" NOR " 级。" ZJBR;
    msg += "  最大内力不低于 " HIB "250" NOR " 点。" ZJBR;
    msg += "  必须装备剑类武器。" ZJBR;
    msg += "  基本剑法 (sword) 等级需大于等于落英神剑等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  剑法（sword）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须装备剑类武器。" ZJBR;
    msg += "  气血不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  内力不低于 " HIB "35" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "45" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "41" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖招式列表〗" ZJBR NOR;
    msg += "  " HIB "落英缤纷" NOR " (0级)   ：刺伤。" ZJBR;
    msg += "  " HIM "人面桃花" NOR " (20级) ：刺伤。" ZJBR;
    msg += "  " HIR "急风骤雨" NOR " (40级) ：割伤。" ZJBR;
    msg += "  " GRN "江城飞花" NOR " (60级) ：刺伤。" ZJBR;
    msg += "  " MAG "万花齐落" NOR " (80级) ：刺伤。" ZJBR;
    msg += "  " CYN "漫天花雨" NOR " (100级)：刺伤。" ZJBR;
    msg += "  " HIY "落花无意" NOR " (120级)：刺伤。" ZJBR;
    msg += ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR;

    return msg;
}
