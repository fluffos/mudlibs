// 铁山刀法

inherit SKILL;

mapping *action = ({
([      "action" : "$N手中$w沉重如山,一招「铁山压顶」自上而下猛劈向$n的$l",
        "force" : 120,
        "attack": 30,
        "dodge" : 20,
        "parry" : 35,
        "damage": 60,
        "lvl"   : 0,
        "skill_name" : "铁山压顶",
        "damage_type" : "劈伤"
]),
});

int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

int valid_learn(object me)
{
    if ((int)me->query("max_neili") < 100)
        return notify_fail("你的内力不够。\n");

    if ((int)me->query_skill("force") < 30)
        return notify_fail("你的内功火候太浅。\n");

    if ((int)me->query_skill("blade", 1) < (int)me->query_skill("tieshan-blade", 1))
        return notify_fail("你的基本刀法水平有限，无法领会更高深的铁山刀法。\n");

    return 1;
}

string query_skill_name(int level)
{
    return action[0]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    return action[0];
}

int practice_skill(object me)
{
    object weapon;

    if (!objectp(weapon = me->query_temp("weapon")) || 
        (string)weapon->query("skill_type") != "blade")
        return notify_fail("你使用的武器不对。\n");

    if ((int)me->query("qi") < 50)
        return notify_fail("你的体力不够练铁山刀法。\n");

    if ((int)me->query("neili") < 50)
        return notify_fail("你的内力不够练铁山刀法。\n");

    me->receive_damage("qi", 45);
    me->add("neili", -45);
    return 1;
}

string perform_action_file(string action)
{
    return __DIR__"tieshan-blade/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【铁山刀法】" ZJBR NOR;
    msg += "铁山刀法以力取胜，刀法沉重如山，威力巨大但不够灵活。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  最大内力 " HIB "100" NOR " 点以上。" ZJBR;
    msg += "  有效内功激发 " HIY "30" NOR " 级以上。" ZJBR;
    msg += "  基本刀法等级不能低于铁山刀法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  刀法（blade）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  需持刀。" ZJBR;
    msg += "  气血：不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "45" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "45" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // hit_ob, valid_damage, skill_improved etc.
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform/exert
    msg += HIC "  铁山压顶 (tieshan)" ZJBR NOR; // 招式名称
    msg += "    使用要求：" ZJBR; // 招式使用要求
    msg += "      铁山刀法等级 " HIY "40" NOR " 级以上。" ZJBR;
    msg += "      当前内力 " HIB "100" NOR " 点以上。" ZJBR;
    msg += "      激发刀法为铁山刀法。" ZJBR;
    msg += "      必须手持兵器且在战斗中对敌人使用。" ZJBR;
    msg += "    效果描述：" ZJBR; // 招式效果描述
    msg += "      使出铁山刀法的绝技，劈出一道沉重如山的刀气攻向对手。" ZJBR;
    msg += "      命中判定：随机值(自身铁山刀法等级) > 目标基本招架等级的三分之一。" ZJBR;
    msg += "      伤害计算：基本伤害 = 铁山刀法等级 + 随机(铁山刀法等级 / 2)。" ZJBR;
    msg += "                气血伤害 = 基本伤害，内伤伤害 = 基本伤害的一半。" ZJBR;
    msg += "                最终伤害由 COMBAT_D->do_damage 函数计算，伤害系数为30%。" ZJBR;
    msg += "      冷却时间：" HIR "8" NOR " 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR; // 消耗与代价
    msg += "      命中：内力 " HIB "100" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "50" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;

    return msg;
}