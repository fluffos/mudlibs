// 艺术修养

inherit SKILL;

string type() { return "art"; }

int valid_learn(object me)
{
	return notify_fail("艺术修养是你艺术方面的领悟，无法"
			   "通过简单学习获得提升。\n");
}

int valid_research(object me)
{
	return notify_fail("艺术修养是你艺术方面的领悟，无法"
			   "通过简单研究获得提升。\n");
}
string query_description()
{
    string msg;
    msg = "艺术修养" ZJBR;
   
    msg += "  艺术修养是武侠世界中的一项重要技能，代表了一个人在艺术方面的造诣和领悟。\n";
    msg += "  高深的艺术修养不仅能陶冶性情，还能提升个人气质，在江湖中获得更多尊重。\n";
    msg += "  艺术修养包括琴棋书画等多个方面，需要长期积累和感悟才能提高。\n";
    msg += "  这项技能无法通过简单的学习或研究来提升，而是要在生活中不断体验和感悟。\n";
    
    return msg;
}
