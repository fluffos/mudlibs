inherit SKILL;

mapping *action = ({
([      "action": "$N抡起$w，一招「灵蛇出洞」，手中$w抖得笔直，朝$n的$l直直刺去",
        "force" : 60,
        "attack": 20,
        "dodge" : 20,
        "damage": 20,
        "lvl"   : 0,
        "skill_name" : "灵蛇出洞",
        "damage_type": "刺伤"
]),
([      "action": "$N手中$w一翻，一招「虎尾鞭身」，手中$w如同矫捷的长虫般窜向$n的$l",
        "force" : 80,
        "attack": 25,
        "dodge" : 25,
        "damage": 25,
        "lvl"   : 10,
        "skill_name" : "虎尾鞭身",
        "damage_type": "抽伤"
]),
([      "action": "$N一声清啸，手中$w一式「苍龙摆尾」，矫若游龙般地袭向$n的$l",
        "force" : 100,
        "attack": 30,
        "dodge" : 30,
        "damage": 30,
        "lvl"   : 20,
        "skill_name" : "苍龙摆尾",
        "damage_type": "抽伤"
]),
([      "action": "$N手中$w轻轻一抖，一式「雷鸣万钧」，手中$w化作一道闪电钻向$n的$l",
        "force" : 120,
        "attack": 35,
        "dodge" : 35,
        "damage": 35,
        "lvl"   : 30,
        "skill_name" : "雷鸣万钧",
        "damage_type": "刺伤"
]),
([      "action": "$N一式「金蛇狂舞」，$w宛如活物，上下翻飞着鞭向$n的$l",
        "force" : 140,
        "attack": 40,
        "dodge" : 40,
        "damage": 40,
        "lvl"   : 40,
        "skill_name" : "金蛇狂舞",
        "damage_type": "抽伤"
]),
});

int valid_enable(string usage) { return usage == "whip" || usage == "parry"; }

int valid_learn(object me)
{
    if ((int)me->query("max_neili") < 100)
        return notify_fail("你的内力不够，无法学习基本鞭法。\n");

    if ((int)me->query_skill("force") < 30)
        return notify_fail("你的内功火候太浅，无法学习基本鞭法。\n");

    // if ((int)me->query_skill("whip", 1) < 1)
        // return notify_fail("你需要先学习一些基本鞭法技巧。\n");

    if ((int)me->query_dex() < 18)
        return notify_fail("你的身法太差，无法学习灵活的鞭法。\n");

    return 1;
}

string query_skill_name(int level)
{
    int i;
    for (i = sizeof(action) - 1; i >= 0; i--)
        if (level >= action[i]["lvl"])
            return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    int i, level;
    level = (int)me->query_skill("whip", 1);
    for (i = sizeof(action); i > 0; i--)
        if (level > action[i-1]["lvl"])
            return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    object weapon;

    if (!objectp(weapon = me->query_temp("weapon")) || 
        (string)weapon->query("skill_type") != "whip")
        return notify_fail("你必须先找一把鞭子才能练习鞭法。\n");

    if ((int)me->query("qi") < 30)
        return notify_fail("你的体力太低了。\n");

    if ((int)me->query("neili") < 20)
        return notify_fail("你的内力不够练习基本鞭法。\n");

    me->receive_damage("qi", 25);
    me->add("neili", -5);
    return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【基本鞭法】" ZJBR NOR;
    msg += "武林中常见的基本鞭法技巧，讲究灵活多变，招式以抽打为主。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "  基本内功等级不低于 " HIY "30" NOR " 级。" ZJBR;
    msg += "  身法不低于 " HIG "18" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  鞭法（whip）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  装备类型为鞭（whip）的武器。" ZJBR;
    msg += "  气血不低于 " HIR "30" NOR " 点。" ZJBR;
    msg += "  内力不低于 " HIB "20" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "25" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "5" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖基础招式〗" ZJBR NOR;
    msg += "  灵蛇出洞、虎尾鞭身、苍龙摆尾、雷鸣万钧、金蛇狂舞。" ZJBR;

    return msg;
}

