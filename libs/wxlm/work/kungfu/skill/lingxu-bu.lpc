// lingxu-bu 凌虚步

inherit SKILL;

string *dodge_msg = ({
    "$n一式「雪地莲花」，身子掣忽一转，$N只觉的眼前一花，失去了目标。\n",
    "$n一式「一狐冲天」，双脚点地，身子突然拔高了丈许，缓缓飘落在$N身后。\n",
    "$n一式「移行幻影」，身行一晃，顿时无数条身影一下子出现在$N的面前。\n",
    "$n一式「狡兔三窟」，飘然向后一退，躲开$N的凌厉攻势。\n",
    "$n一式「烟雨飘渺」，身体急转，化为一道白光，虚幻不定的出现在$N的周围。\n",
});

int valid_enable(string usage)
{
	return usage == "dodge" || usage == "move";
}

int valid_learn(object me)
{
	return 1;
}

string query_dodge_msg(string limb)
{
    return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
    if( (int)me->query("qi") < 50 )
	return notify_fail("你的体力太差了，不能练凌虚步。\n");

    me->receive_damage("qi", 40);
    return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【凌虚步】" ZJBR NOR;
    msg += WHT "一种轻功身法，以其飘逸灵动、虚实难辨的特点而闻名。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  无特殊要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  轻功 (`dodge`)。" ZJBR;
    msg += "  身法 (`move`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血 (`qi`) 不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血 " HIR "40" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  主要提供闪避能力，具体的闪避描述见招式列表。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (Perform/Exert)〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖闪避描述 (Dodge Messages)〗" ZJBR NOR;
    msg += "  雪地莲花：身子掣忽一转，令对手失去目标。" ZJBR;
    msg += "  一狐冲天：拔高身形，飘落至对手身后。" ZJBR;
    msg += "  移行幻影：晃动间产生无数身影迷惑对手。" ZJBR;
    msg += "  狡兔三窟：飘然后退躲避攻击。" ZJBR;
    msg += "  烟雨飘渺：身体急转，化为白光环绕对手。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 凌虚步是基础的轻功身法，用于提高闪避和移动能力。" ZJBR;
    msg += "2. 练习消耗气血，注意保持体力。" ZJBR;

    return msg;
}
