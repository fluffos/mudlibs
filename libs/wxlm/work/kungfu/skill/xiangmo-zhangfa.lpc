int valid_enable(string usage) { return usage=="staff" ||  usage=="parry"; }

int valid_learn(object me)
{
		object ob;

	if ((int)me->query("max_neili") < 2500)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("force") < 200)
		return notify_fail("你的内功火候太浅。\n");

	if ((int)me->query_skill("staff", 1) < 120)
		return notify_fail("你的基本杖法火候太浅。\n");

	if( !(ob = me->query_temp("weapon")) || 
			(string)ob->query("skill_type") != "staff" )
		return notify_fail("你必须先找一根钢杖才能学降魔杖法。\n");

	if ((int)me->query_skill("staff", 1) < (int)me->query_skill("xiangmo-zhangfa", 1))
		return notify_fail("你的基本杖法水平有限，无法领会更高深的降魔杖法。\n");

	return 1;
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "staff")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力不够练的降魔杖法。\n");

	if ((int)me->query("neili") < 80)
		return notify_fail("你的内力不够练降魔杖法。\n");

	me->receive_damage("qi", 60);
	me->add("neili", -70);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"xiangmo-zhangfa/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【降魔杖法】" NOR ZJBR;
    msg += "一门以刚猛著称的高级杖法。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" NOR ZJBR;
    msg += "  最大内力 不低于 " HIB "2500" NOR " 点。" ZJBR;
    msg += "  基本内功等级 不低于 " HIY "200" NOR " 级。" ZJBR;
    msg += "  基本杖法等级 不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "  必须装备 杖类 武器。" ZJBR;
    msg += "  基本杖法等级 不低于 降魔杖法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" NOR ZJBR;
    msg += "  杖法 (staff)" ZJBR;
    msg += "  招架 (parry)" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" NOR ZJBR;
    msg += "  必须装备 杖类 武器。" ZJBR;
    msg += "  气血：不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "80" NOR " 点。" ZJBR;
    msg += "  每次练习消耗 气血：" HIR "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗 内力：" HIB "70" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" NOR ZJBR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" NOR ZJBR;
    msg += HIC "  炼狱 (diyu)" NOR ZJBR;
    msg += "    使用要求：" ZJBR;
    msg += "      降魔杖法等级 不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "      基本内功等级 不低于 " HIY "200" NOR " 级。" ZJBR;
    msg += "      当前内力 不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标发动 " HIW "5" NOR " 次连续攻击。" ZJBR;
    msg += "      攻击力(AP)判定：自身 [降魔杖法等级]。" ZJBR;
    msg += "      防御力(DP)判定：目标 [基本招架等级] / 2。" ZJBR;
    msg += "      命中判定：若 随机(AP) > DP 则命中。" ZJBR;
    msg += "      命中伤害：(AP / 2 + 随机(AP / 2)) 点气血伤害。" ZJBR;
    msg += "      命中附加：造成相当于 伤害值 / 3 的气血内伤。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      使用者忙乱 " HIR "3 + 随机(命中次数)" NOR " 秒 (最多 " HIR "8" NOR " 秒)。" ZJBR;

    return msg;
}

