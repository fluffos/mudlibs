// bihai-chaosheng.c 碧海潮生曲



inherit SKILL;

string type() { return "knowledge"; }

int valid_enable(string usage) { return usage == "chuixiao-jifa"; }

int valid_learn(object me)
{
	if (me->query_skill("chuixiao-jifa", 1) < 100)
		return notify_fail("你的吹萧技法水平不够，还是先练好再说吧！\n");

	if (me->query_skill("chuixiao-jifa", 1) < me->query_skill("bihai-chaosheng", 1))
		return notify_fail("你的吹萧技法水平有限，无法领会更精妙的碧海潮生曲。\n");

	return 1;
}

int practice_skill(object me)
{
	object ob;

	if (! objectp(ob = me->query_temp("handing")) ||
	    ! ob->valid_as_xiao())
		return notify_fail("不拿根箫在手上，你怎么练习？\n");

	if ((int)me->query("jing") < 80)
		return notify_fail("你的精神不够好，没法练习了。\n");

	if ((int)me->query("qi") < 30)
		return notify_fail("你现在口干舌燥，实在是太累了。\n");

	me->receive_damage("jing", 45);
	me->receive_damage("qi", 20);

	return 1;
}

void do_effect(object me)
{
	object *obs;
	int lvl;
	int i;
	int damage;

	lvl = me->query_skill("chuixiao-jifa", 1) / 2 +
	      me->query_skill("bihai-chaosheng", 1);

	if (environment(me)->query("no_fight") ||
	    environment(me)->query("no_roar") || lvl < 150)
		return;

	lvl = lvl / 5 + me->query_skill("force");
	lvl /= 2;

	// special effort
	obs = all_inventory(environment(me));
	for (i = 0; i < sizeof(obs); i++)
	{
		if (! obs[i]->is_character() || obs[i] == me || ! living(obs[i]))
			continue;

		if (me->query_skill("bihai-chaosheng") * 2 / 3 <
		    obs[i]->query_skill("bihai-chaosheng"))
			continue;

		if (lvl + random(lvl) < obs[i]->query_skill("force"))
		{
			tell_object(obs[i], HIM "你听了心中不禁微微一动，发现这曲子颇有奥妙之处。"NOR"\n");
			continue;
		}

		damage = me->query("max_neili") - obs[i]->query("max_neili");
		if (damage < 500)
		{
			tell_object(obs[i], HIM "你忽然觉得一阵迷乱，连忙运了一口气，才清醒过来。"NOR"\n");
			continue;
		}

		damage /= 10;
		me->want_kill(obs[i]);
		me->fight_ob(obs[i]);
		obs[i]->kill_ob(me);
		obs[i]->receive_damage("jing", damage, me);
		obs[i]->receive_wound("jing", damage / 3, me);
		
		tell_object(obs[i], HIM "你只觉得心迷神乱，忍不住要翩翩起舞..."NOR"\n");
	}
}

string query_description()
{
    string msg;

    msg = "";
    msg += HIY "【碧海潮生曲】" ZJBR ZJBR NOR;
    msg += WHT "碧海潮生曲是桃花岛独门的音律武功，以其奇妙绝伦、变幻莫测而闻名。" ZJBR;
    msg += "此曲法融合了音律、内功和精神力量，能够影响敌人的心神，是一门极为高深的武学。" ZJBR ZJBR;
    msg += HIY "【学习要求】" ZJBR NOR;
    msg += "  基本吹箫技法（chuixiao-jifa）等级 100 级" ZJBR;
    msg += "  碧海潮生曲等级不能超过基本吹箫技法等级" ZJBR ZJBR;

    msg += HIY "【练习要求】" ZJBR NOR;
    msg += "  需要手持箫类物品" ZJBR;
    msg += "  每次练习消耗：" ZJBR;
    msg += "    - 精力：45 点" ZJBR;
    msg += "    - 气血：20 点" ZJBR ZJBR;

    msg += HIY "【技能效果】" ZJBR NOR;
    msg += "  技能类型：知识类（knowledge），但用于提高演奏效果" ZJBR;
    msg += "  可激发于：吹箫技法（chuixiao-jifa）、弹琴技法（tanqin-jifa）、古筝技法（guzheng-jifa）" ZJBR ZJBR;

    msg += HIY "【演奏效果（play命令触发）】" ZJBR NOR;
    msg += HIW "1. 群体精神攻击：" ZJBR NOR;
    msg += "  触发条件：" ZJBR;
    msg += "    - 碧海潮生曲等级 150 级以上" ZJBR;
    msg += "    - 环境允许战斗或喧哗" ZJBR;
    msg += "  作用范围：环境内所有其他活物（非自身）" ZJBR;
    msg += "  目标判定：" ZJBR;
    msg += "    - 豁免：若目标碧海潮生曲等级较高（> 自身等级 * 2/3），则免疫" ZJBR;
    msg += "    - 抵抗：若(有效音律等级 + random(有效音律等级)) < 目标内功激发等级，则抵抗" ZJBR;
    msg += "            （有效音律等级 = (吹箫技法激发/2 + 碧海潮生曲)/5 + 自身内功激发）" ZJBR;
    msg += "    - 伤害判定：若(自身最大内力 - 目标最大内力) < 500，则抵抗" ZJBR;
    msg += "  命中效果：" ZJBR;
    msg += "    - 造成精神伤害：(自身最大内力 - 目标最大内力) / 10 点" ZJBR;
    msg += "    - 造成精神创伤：伤害 / 3 点" ZJBR;
    msg += "    - 强制双方进入战斗状态" ZJBR;
    msg += "  描述：奏响碧海潮生曲，以音律干扰范围内的敌人心神。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 碧海潮生曲需要高超的吹箫技法作为基础。" ZJBR;
    msg += "2. 演奏效果受双方技能等级、内功、最大内力等多方面因素影响。" ZJBR;
    msg += "3. 演奏会消耗精力和气血，并可能引发战斗。" ZJBR;
    msg += "4. 在禁止战斗或禁止喧哗的地方无法施展演奏效果。\n";

    return msg;
}
