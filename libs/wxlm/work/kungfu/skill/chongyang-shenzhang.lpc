int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练重阳神掌必须空手。\n");

	if ((int)me->query("max_neili") < 600)
		return notify_fail("你的内力不足，无法练重阳神掌。\n");

	if ((int)me->query_skill("force") < 80)
		return notify_fail("你的内功火候不够，无法练重阳神掌。\n");

	return 1;
}

int valid_enable(string usage) { return usage == "strike" || usage == "parry"; }

int valid_combine(string combo) { return combo == "zhongnan-zhi"; }

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("chongyang-shenzhang", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i - 1]["lvl"])
			return action[NewRandom(i, 5, level / 5)];

}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力不够了，休息一下再练吧。\n");

	if ((int)me->query("neili") < 65)
		return notify_fail("你的内力不够了，休息一下再练吧。\n");

	me->receive_damage("qi", 60);
	me->add("force", -55);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"chongyang-shenzhang/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【重阳神掌】" ZJBR NOR;
    msg += "全真教嫡传掌法，讲究以柔克刚，绵里藏针。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  需空手，最大内力 600 以上，基本内功 80 级以上。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  掌法 (strike)，招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖可合并技能〗" ZJBR NOR;
    msg += "  终南指法 (zhongnan-zhi)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  每次练习消耗 70 点气和 65 点内力。" ZJBR ZJBR;

    msg += HIY "〖攻击特效〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR; // 代码中未定义 hit_ob

    msg += HIY "〖防御特效〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR; // 代码中未定义 valid_damage


    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  『连环掌』(lianhuan)" NOR ZJBR;
    msg += "    要求：空手，重阳神掌 100 级，基本内功 120 级，内力 80 点。" ZJBR;
    msg += "    消耗：内力 80 点。" ZJBR;
    msg += "    效果：对敌人连续发动数次掌法攻击，攻击次数受人物攻击速度影响。" ZJBR;
    msg += "    特殊：自身会忙乱 1 到 4 秒。" ZJBR;

    return msg;
}

