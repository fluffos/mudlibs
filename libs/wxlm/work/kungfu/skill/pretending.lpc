// yirong.c 易容术

inherit SKILL;

void create() { seteuid(getuid()); }

string type() { return "knowledge"; }

int valid_learn(object me)
{
	return 1;
}

int practice_skill(object me)
{
	return notify_fail("易容术只能靠学(learn)来提高。\n");
}

string query_description()
{
    string msg;

    msg = HIY "【易容术】" ZJBR ZJBR NOR;
    msg += WHT "一门改变自身容貌的技艺，可以用来伪装身份。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  无特殊要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // type()
    msg += "  知识类技能 (knowledge)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  无法通过练习 (practice) 提升，只能通过学习 (learn) 提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊运用〗" ZJBR NOR;
    msg += "  通常需要配合特定指令 (如 `pretend`, `disguise`, `易容` 等，请在游戏中探索) 来使用。" ZJBR;
    msg += "  效果和成功率可能受易容术等级、可用材料等因素影响。" ZJBR;

    return msg;
}


