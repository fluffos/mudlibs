// xinfa.c

inherit SKILL;

string query_description()
{
    string msg;

    msg = HIY "【心法】" ZJBR ZJBR NOR;
    msg += WHT "这是一个基础技能或技能的基类，不包含具体的武学特性。" ZJBR;
    msg += "其具体效果和使用方式取决于继承它的其他技能文件。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  无（具体要求取决于继承此心法的子技能）。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  无（具体类型取决于继承此心法的子技能）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  无法直接练习（具体练习方式取决于继承此心法的子技能）。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无（具体效果取决于继承此心法的子技能）。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无（具体招式取决于继承此心法的子技能）。" ZJBR ZJBR;

    return msg;
}
