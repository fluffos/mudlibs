// 阴阳大法

inherit SKILL;

/**
 * @brief 创建技能对象
 * @details 设置技能的基本属性
 */
void create() { seteuid(getuid()); }

/**
 * @brief 返回技能类型
 * @return string 技能类型为知识类
 */
string type() { return "knowledge"; }

/**
 * @brief 练习技能
 * @param object me 练习者
 * @return int 返回失败提示
 * @details 阴阳大法只能通过阴阳共修来提升
 */
int practice_skill(object me)
{
	return notify_fail("阴阳大法只能通过阴阳共修来提升。\n");
}

/**
 * @brief 学习技能验证
 * @param object me 学习者
 * @return int 返回失败提示
 * @details 阴阳大法只能通过阴阳共修来提升
 */
int valid_learn(object me)
{
	return notify_fail("阴阳大法只能通过阴阳共修来提升。\n");
}

/**
 * @brief 计算阴阳共修经验加成
 * @param object me 修炼者
 * @return int 返回经验加成值
 * @details 每10级阴阳大法增加1点阴阳共修经验
 */
int query_yinyang_exp_bonus(object me)
{
	int level;
	int bonus;
	
	if (!me) return 0;
	
	level = me->query_skill("yinyang-dafa", 1);
	bonus = level / 10;
	
	return bonus;
}

/**
 * @brief 技能描述
 * @return string 返回技能的详细描述
 * @details 显示阴阳大法的介绍和效果
 */
string query_description()
{
    string msg;

    msg = HIY "【阴阳大法】" ZJBR NOR;
    msg += WHT "阴阳大法是一种通过阴阳共修来提升修为的高深法门。" ZJBR ZJBR; // 基础介绍

    msg += HIY "〖技能类型〗" ZJBR NOR;
    msg += "  知识类技能" ZJBR ZJBR;

    msg += HIY "〖特殊效果〗" ZJBR NOR;
    msg += "  每10级阴阳大法可在阴阳共修时额外获得1点经验" ZJBR;
    msg += "  阴阳大法等级越高，阴阳共修的收益就越大" ZJBR ZJBR;

    msg += HIY "〖修炼方法〗" ZJBR NOR;
    msg += "  只能通过阴阳共修来提升此技能" ZJBR ZJBR;

    return msg;
}