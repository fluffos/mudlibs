// 铁山压顶


#include <combat.h>

inherit F_SSERVER;

string query_name() { return "铁山" ZJBR "压顶"; }
int query_cd() { return 8; }

int perform(object me, object target)
{
    object weapon;
    int damage;
    string msg;

    if (! target) target = offensive_target(me);
    if (! target || ! me->is_fighting(target))
        return notify_fail("「铁山压顶」只能对战斗中的对手使用。\n");

    if (! objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "blade")
        return notify_fail("你使用的武器不对。\n");

    if ((int)me->query_skill("tieshan-blade", 1) < 40)
        return notify_fail("你的铁山刀法不够娴熟，不会使用「铁山压顶」。\n");

    if ((int)me->query("neili") < 100)
        return notify_fail("你的内力不够。\n");

    if (me->query_skill_mapped("blade") != "tieshan-blade")
        return notify_fail("你没有激发铁山刀法，不能使用「铁山压顶」。\n");

    msg = HIY "$N" HIY "使出铁山刀法的绝技「铁山压顶」，手中" + weapon->name() +
          HIY "沉重如山，自上而下猛劈向$n" HIY "！" NOR "\n";

    if (random(me->query_skill("blade")) > target->query_skill("parry") / 3)
    {
        damage = (int)me->query_skill("tieshan-blade", 1);
        damage = damage + random(damage / 2);

        me->add("neili", -100);
        
        COMBAT_D->real_damage(me, target, damage);

        msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 30,
                                   HIR "$n" HIR "躲闪不及，被$N" HIR
                                   "这势大力沉的一刀劈中，顿时血肉模糊！" NOR "\n");
        me->start_busy(3);
    } else
    {
        msg += CYN "$n" CYN "看出$N" CYN "这一刀的来势，连忙侧身避开。" NOR "\n";
        me->add("neili", -50);
        me->start_busy(3);
    }
    message_combatd(msg, me, target);
    return 1;
}