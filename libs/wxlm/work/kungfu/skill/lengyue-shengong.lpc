// lengyue-shengong 冷月神功

inherit FORCE;

int valid_enable(string usage) { return usage=="force"; }

int query_neili_improve(object me)
{
    int lvl;

    lvl = (int)me->query_skill("lengyue-shengong", 1);
    // 提高内力提升系数，从15提高到20
    return lvl * lvl * 20 * 15 / 100 / 200;
}

int valid_learn(object me)
{
    int lvl = (int)me->query_skill("lengyue-shengong", 1);

    if ( me->query("gender") == "无性" && lvl > 49)
        return notify_fail("你无根无性，阴阳不调，难以领会高深的冷月神功。\n");
    if (me->query_skill("force",1) <= me->query_skill("lengyue-shengong",1) )
        return notify_fail("你的基本内功基础不够，无法领会更高深的冷月神功。\n");
    // 增加学习条件，需要一定的悟性
    if (me->query("int") < 25)
        return notify_fail("你的悟性不足，无法领会冷月神功的精髓。\n");
    return ::valid_learn(me);
}

int practice_skill(object me)
{
    return notify_fail("冷月神功只能用学的，或是从运用(exert)中增加熟练度。\n");
}

string exert_function_file(string func)
{
    return __DIR__"lengyue-shengong/" + func;
}

string query_description()
{
    string msg;

    msg = HIY "【冷月神功】" ZJBR NOR;
    msg += WHT "一门至阴至寒的内功心法，修炼者真气阴寒无比。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  基本内功 (`force`) 等级需高于或等于冷月神功等级。" ZJBR;
    msg += "  先天悟性 (`int`) 不低于 " HIY "25" NOR " 点。" ZJBR;
    msg += "  性别非无性，或冷月神功等级不超过 " HIY "49" NOR " 级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  内功 (`force`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  冷月神功无法通过练习 (`practice`) 提升，只能通过学习 (`learn`) 或运用 (`exert`) 提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  提升内力上限 (`query_neili_improve`)：数值约为 (冷月神功等级 * 冷月神功等级 * 20 * 15 / 100 / 200)。" ZJBR;
    msg += "  提升防御力 (`query_effect_defense`)：防御效果增加 (冷月神功等级 / 2) 点。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (Exert)〗" ZJBR NOR; // exert_function_file

    msg += HIC "  冷月刺骨 (freeze)" ZJBR NOR; // 招式名称
    msg += "    使用要求：" ZJBR; // 招式使用要求
    msg += "      冷月神功等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力 (`neili`) 不低于 " HIB "1000" NOR " 点。" ZJBR; // 代码要求1000
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR; // 招式效果描述
    msg += "      命中判定：基于双方内功激发等级 (`force`) 进行判定 (`COMBAT_D->hit_determination()`)。" ZJBR;
    msg += "      命中效果：" ZJBR;
    msg += "        - 对目标造成气血伤害和等量气血上限伤害 (`wound`)，伤害值约为 (自身内功激发等级 + 随机(自身内功激发等级 / 3))。" ZJBR;
    msg += "        - 降低目标内力，数值等于造成的伤害值。" ZJBR;
    msg += "        - 使目标忙乱 (`busy`) " HIR "1" NOR " 秒。" ZJBR;
    msg += "        - 自身获得临时伤害加成 (`apply/damage`)，数值约为 ((1 + 随机(2)) * 自身内功激发等级 / 10)，持续 (冷月神功等级 / 5) 秒。" ZJBR;
    msg += "        - 目标被附加「冷月刺骨」状态 (`lengyue-shengong_freeze`)，持续 (冷月神功等级 / 5) 秒。" ZJBR;
    msg += "      未命中效果：无特殊效果。" ZJBR;
    msg += "    消耗与代价：" ZJBR; // 消耗与代价
    msg += "      自身忙乱 (`busy`) " HIR "2" NOR " 秒。" ZJBR;
    msg += "      (注意：代码中未明确指出此招式的内力或精力消耗)" ZJBR ZJBR;

    msg += HIC "  寒冰护体 (hanshou)" ZJBR NOR; // 招式名称
    msg += "    使用要求：" ZJBR; // 招式使用要求
    msg += "      当前内力 (`neili`) 不低于 " HIB "500" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR; // 招式效果描述
    msg += "      提升自身临时护甲 (`apply/armor`)，提升数值等于 (冷月神功等级)。" ZJBR;
    msg += "      效果持续 (冷月神功等级 / 2) 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR; // 消耗与代价
    msg += "      消耗内力 " HIB "400" NOR " 点。" ZJBR;
    msg += "      自身忙乱 (`busy`) " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  冷月战气 (powerup)" ZJBR NOR; // 招式名称
    msg += "    使用要求：" ZJBR; // 招式使用要求
    msg += "      当前内力 (`neili`) 不低于 " HIB "300" NOR " 点。" ZJBR; // 代码检查要求neili < 300失败，故要求>=300
    msg += "    效果描述：" ZJBR; // 招式效果描述
    msg += "      提升自身攻击力 (`apply/attack`) 与防御力 (`apply/defense`)。" ZJBR;
    msg += "      提升数值均为 (自身内功激发等级 (`force`) / 3)。" ZJBR;
    msg += "      效果持续 (冷月神功等级) 秒。" ZJBR; // 代码是skill，即lengyue-shengong等级
    msg += "    消耗与代价：" ZJBR; // 消耗与代价
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      自身忙乱 (`busy`) " HIR "3" NOR " 秒。" ZJBR ZJBR; // 代码是3秒

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 冷月神功无法通过练习提升等级。" ZJBR;
    msg += "2. 「冷月刺骨」为战斗专用招式，且代码未明确其内力消耗。" ZJBR;
    msg += "3. 「寒冰护体」和「冷月战气」使用后会使自身忙乱一段时间。" ZJBR;
    msg += "4. 注意各内功运用 (`exert`) 的内力要求和消耗。" ZJBR;

    return msg;
}

// 增加被动技能，提高防御力
int query_effect_defense(object attacker, object me)
{
    int lvl;

    lvl = me->query_skill("lengyue-shengong", 1);
    return lvl / 2;
}
