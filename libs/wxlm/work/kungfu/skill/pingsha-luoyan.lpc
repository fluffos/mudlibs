// /kungfu/skill/pingsha-luoyan.c


inherit SKILL;

mapping *action = ({
    ([  "action" : "$N抚动$w琴弦，一招「" HIR "火凤临朝" NOR "」，指尖迸发出炽热的" HIR "火焰" NOR "，直袭$n",
        "force" : 120,
        "attack": 40,
        "dodge" : 30,
        "parry" : 40,
        "damage": 50,
        "lvl"   : 0,
        "skill_name" : "火凤临朝",
        "damage_type" : "火焰伤害"
    ]),
    ([  "action" : "$N轻抚$w，使出「" HIR "烈焰惊鸿" NOR "」，一道" HIR "赤红琴音" NOR "如利剑般刺向$n",
        "force" : 150,
        "attack": 50,
        "dodge" : 35,
        "parry" : 45,
        "damage": 60,
        "lvl"   : 40,
        "skill_name" : "烈焰惊鸿",
        "damage_type" : "火焰伤害"
    ]),
    ([  "action" : "$N弹奏$w，一式「" HIR "火云飞扬" NOR "」，无数" HIR "火星" NOR "伴随着音波向$n笼罩而去",
        "force" : 180,
        "attack": 60,
        "dodge" : 40,
        "parry" : 50,
        "damage": 80,
        "lvl"   : 80,
        "skill_name" : "火云飞扬",
        "damage_type" : "内伤"
    ]),
    ([  "action" : "$N轻抚$w，使出「" HIC "平沙落雁" NOR "」，一阵清越的琴音在空中回荡，$n只觉得心神恍惚",
        "force" : 200,
        "attack": 70,
        "dodge" : 50,
        "parry" : 60,
        "damage": 80,
        "lvl"   : 100,
        "skill_name" : "平沙落雁",
        "damage_type" : "内伤"
    ]),
    // 可以继续添加更多招式
});

int valid_enable(string usage) { return usage == "qin" || usage == "parry"; }

int valid_learn(object me)
{
    if (me->query("family/family_name") != "白帝城")
        return notify_fail("平沙落雁只有白帝城的弟子才能学习。\n");

    if ((int)me->query_skill("force") < 100)
        return notify_fail("你的内功火候不够，需要100级的内功才能学习平沙落雁。\n");

    if ((int)me->query("max_neili") < 800)
        return notify_fail("你的内力修为不足，需要800点内力才能学习平沙落雁。\n");

    if ((int)me->query_skill("qin", 1) < 80)
        return notify_fail("你的基本琴法火候不够，需要80级的基本琴法才能学习平沙落雁。\n");

    if ((int)me->query_skill("yinlv", 1) < 60)
        return notify_fail("你的音律修养不足，需要60级的音律才能学习平沙落雁。\n");

    if ((int)me->query_skill("qin", 1) < (int)me->query_skill("pingsha-luoyan", 1))
        return notify_fail("你的基本琴法水平有限，无法领会更高深的平沙落雁。\n");

    return 1;
}

string query_skill_name(int level)
{
    int i;
    for (i = sizeof(action) - 1; i >= 0; i--)
        if (level >= action[i]["lvl"])
            return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    int i, level;
    level = (int) me->query_skill("pingsha-luoyan", 1);
    for (i = sizeof(action); i > 0; i--)
        if (level > action[i-1]["lvl"])
            return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    object weapon;

    if (me->query("family/family_name") != "白帝城")
        return notify_fail("平沙落雁只有白帝城的弟子才能练习。\n");

    if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "qin")
        return notify_fail("你必须先装备琴才能练习平沙落雁。\n");

    if ((int)me->query("qi") < 70)
        return notify_fail("你的体力不足，无法练习平沙落雁。\n");

    if ((int)me->query("neili") < 70)
        return notify_fail("你的内力不够，无法练习平沙落雁。\n");

    me->receive_damage("qi", 60);
    me->add("neili", -65);
    return 1;
}

int learn_bonus() { return 20; }
int practice_bonus() { return 10; }
int success_bonus() { return 10; }
int power_bonus() { return 0; }

string perform_action_file(string action)
{
    return __DIR__"pingsha-luoyan/" + action;
}

int help(object me)
{
    write(@HELP
平沙落雁

    平沙落雁是白帝城独特的琴法，融合了音律与内功的奥妙。
    此琴法不仅能弹奏出动人心弦的乐曲，还能在战斗中发挥奇效。

    学习要求：
        白帝城弟子
        基本琴法 80 级
        音律修养 60 级
        内功修为 100 级
        内力 800 点

HELP
    );
    return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【平沙落雁】" ZJBR NOR;
    msg += "白帝城独门琴法绝技，将内力与音律完美结合，既可伤敌，亦可扰乱心神。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  必须是 白帝城 (baidicheng) 弟子。" ZJBR;
    msg += "  基本琴法 (qin) 等级不低于 " HIY "80" NOR " 级。" ZJBR;
    msg += "  音律 (yinlv) 等级不低于 " HIY "60" NOR " 级。" ZJBR;
    msg += "  基本内功 (force) 等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "  最大内力 (max_neili) 不低于 " HIB "800" NOR " 点。" ZJBR;
    msg += "  基本琴法等级需大于等于平沙落雁等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  琴法 (qin)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须是 白帝城 (baidicheng) 弟子。" ZJBR;
    msg += "  必须装备 琴 (qin) 类武器。" ZJBR;
    msg += "  气血 (qi)：不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力 (neili)：不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "65" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  平沙落雁 (pingsha)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      平沙落雁等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      音律等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      装备琴类武器，且对战斗中的对手使用。" ZJBR;
    msg += "      不在 " HIR "4" NOR " 秒的冷却时间内。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      发动琴音攻击。" ZJBR;
    msg += "      命中率基于双方 (平沙落雁+琴法) 与 (内功+招架) 的差值，并受自身 音律 等级加成（对非玩家目标有额外加成），最终限制在10%-90%之间。" ZJBR;
    msg += "      命中后造成伤害，伤害值约等于 ((平沙落雁等级 + 琴法激发等级) * 1.5 + 音律等级 * 3)，对非玩家目标伤害翻倍。" ZJBR;
    msg += "      命中后有几率获得 火音符 或 冰音符 (临时状态)，获取基础概率为 (30 + 音律等级 / 4)%，最高80%。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "220" NOR " 点。" ZJBR;
    msg += "      使用后进入 " HIR "4" NOR " 秒冷却时间。" ZJBR;

    return msg;
}