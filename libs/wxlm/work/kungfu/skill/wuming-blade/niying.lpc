// 匿影藏刃


#include <combat.h>

inherit F_SSERVER;

string query_name() { return "匿影藏刃"; }
int query_cd() { return 10; }

int perform(object me, object target)
{
    object weapon;
    string msg;
    int ap, dp;
    int count;
    int i;

    if (! target) target = offensive_target(me);

    if (! target || ! me->is_fighting(target))
        return notify_fail("「匿影藏刃」只能在战斗中对对手使用。\n");

    if (! objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "blade")
        return notify_fail("你使用的武器不对。\n");

    if ((int)me->query_skill("wuming-blade", 1) < 80)
        return notify_fail("你的无名刀法不够娴熟，不会使用「匿影藏刃」。\n");

    if ((int)me->query("neili") < 150)
        return notify_fail("你的内力不够。\n");

    if (me->query_skill_mapped("blade") != "wuming-blade")
        return notify_fail("你没有激发无名刀法，不能使用「匿影藏刃」。\n");

    if (! living(target))
        return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

    ap = me->query_skill("blade");
    dp = target->query_skill("dodge");

    msg = HIC "$N" HIC "使出无名刀法的绝技「匿影藏刃」，身形忽隐忽现，" + weapon->name() +
          HIC "化作无数道刀影，齐齐斩向$n" HIC "！" NOR "\n";

    if (COMBAT_D->hit_determination(me,target,ap,dp))
    {
        msg += HIR "$n" HIR "只觉得眼前一花，完全分不清哪个是真哪个是假！" NOR "\n";
        count = ap / 10;
        me->add_temp("apply/attack", count);
    } else
    {
        msg += HIC "$n" HIC "凝神应对，勉强分辨出$N" HIC "的方位。" NOR "\n";
        count = 0;
    }
    
    message_combatd(msg, me, target);

    for (i = 0; i < COMBAT_D->query_base_attack_number(me,query_name());  i++)
    {
        if (! me->is_fighting(target))
            break;
        COMBAT_D->do_attack(me, target, weapon, 0);
    }

    me->add_temp("apply/attack", -count);
    me->add("neili", -150);
    me->start_busy(2);
    return 1;
}