// 无名斩


#include <combat.h>

inherit F_SSERVER;

string query_name() { return "无名" ZJBR "斩"; }
int query_cd() { return 8; }

int perform(object me, object target)
{
    object weapon;
    int damage;
    string msg;

    if (! target) target = offensive_target(me);
    if (! target || ! me->is_fighting(target))
        return notify_fail("「无名斩」只能对战斗中的对手使用。\n");

    if (! objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "blade")
        return notify_fail("你使用的武器不对。\n");

    if ((int)me->query_skill("wuming-blade", 1) < 50)
        return notify_fail("你的无名刀法不够娴熟，不会使用「无名斩」。\n");

    if ((int)me->query("neili") < 100)
        return notify_fail("你的内力不够。\n");

    if (me->query_skill_mapped("blade") != "wuming-blade")
        return notify_fail("你没有激发无名刀法，不能使用「无名斩」。\n");

    if (! living(target))
        return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

    msg = HIW "$N" HIW "使出无名刀法的绝技「无名斩」，手中" + weapon->name() +
          HIW "划出一道白光，直劈$n" HIW "！" NOR "\n";

    if (random(me->query_skill("blade")) > target->query_skill("dodge") / 2)
    {
        damage = (int)me->query_skill("wuming-blade", 1);
        damage = damage + random(damage);

        me->add("neili", -100);

        COMBAT_D->real_damage(me, target, damage);

        msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 30,
                                   HIR "只见$n" HIR "躲闪不及，被$N" HIR
                                   "这一刀劈中肩膀，顿时鲜血直流！" NOR "\n");
        me->start_busy(2);
    } else
    {
        msg += CYN "可是$p" CYN "看破了$P" CYN
               "的企图，轻轻一跃，躲开了这一刀。" NOR "\n";
        me->add("neili", -50);
        me->start_busy(3);
    }
    message_combatd(msg, me, target);
    return 1;
}