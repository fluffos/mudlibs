// 天外飞刃


#include <combat.h>

inherit F_SSERVER;

string query_name() { return "天外" ZJBR "飞刃"; }
int query_cd() { return 12; }

int perform(object me, object target)
{
    object weapon;
    string msg;
    int ap, dp;
    int damage;

    if (! target) target = offensive_target(me);

    if (! target || ! me->is_fighting(target))
        return notify_fail("「天外飞刃」只能对战斗中的对手使用。\n");

    if (! objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "blade")
        return notify_fail("你使用的武器不对。\n");

    if ((int)me->query_skill("wuming-blade", 1) < 100)
        return notify_fail("你的无名刀法不够娴熟，不会使用「天外飞刃」。\n");

    if ((int)me->query("neili") < 200)
        return notify_fail("你的内力不够。\n");

    if (me->query_skill_mapped("blade") != "wuming-blade")
        return notify_fail("你没有激发无名刀法，不能使用「天外飞刃」。\n");

    if (! living(target))
        return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

    ap = me->query_skill("blade") + me->query_skill("force");
    dp = target->query_skill("dodge") + target->query_skill("parry");

    msg = HIY "$N" HIY "使出无名刀法的绝技「天外飞刃」，猛然跃起，" + weapon->name() +
          HIY "化作一道金光，从天而降直劈$n" HIY "！" NOR "\n";

    if (COMBAT_D->hit_determination(me,target,ap,dp))
    {
        damage = ap + random(ap / 2);
        me->add("neili", -200);
        msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 60,
                                   HIR "$n" HIR "躲闪不及，被$N" HIR "这一刀劈中头顶，"
                                   "鲜血顿时狂涌而出！" NOR "\n");
        me->start_busy(2);
    } else
    {
        msg += CYN "可是$n" CYN "看破了$N"
               CYN "的企图，巧妙地躲过了这一刀。" NOR "\n";
        me->add("neili", -100);
        me->start_busy(3);
    }
    message_combatd(msg, me, target);

    return 1;
}