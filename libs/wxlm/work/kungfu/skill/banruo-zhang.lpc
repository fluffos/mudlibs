int valid_enable(string usage) { return usage == "strike" ||  usage == "parry"; }

int valid_combine(string combo) { return combo == "yizhi-chan"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练般若掌必须空手。\n");

	if ((int)me->query_skill("force") < 30)
		return notify_fail("你的内功火候不够，无法练般若掌。\n");

	if ((int)me->query("max_neili") < 100)
		return notify_fail("你的内力太弱，无法练般若掌。\n");

	if ((int)me->query_skill("strike", 1) < (int)me->query_skill("banruo-zhang", 1))
		return notify_fail("你的基本掌法火候水平有限，无法领会更高深的般若功。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action)-1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int)me->query_skill("banruo-zhang", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	if (me->query_temp("weapon") ||
	    me->query_temp("secondary_weapon"))
		return notify_fail("你必须空手练习！\n");

	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 70)
		return notify_fail("你的内力不够练般若掌。\n");

	me->receive_damage("qi", 65);
	me->add("neili", -64);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"banruo-zhang/" + action;
}

string query_description()
{
    string msg;

    msg = "";
    msg += HIY "【般若掌】" ZJBR ZJBR NOR;
    msg += WHT "般若掌是一门以防守反击见长的掌法，以其刚柔并济、虚实相生而闻名。" ZJBR;
    msg += "此掌法讲究以柔克刚，以静制动，招式看似平和，实则暗藏杀机。" ZJBR ZJBR;
    msg += HIY "【学习要求】" ZJBR NOR;
    msg += "  最大内力 100 点" ZJBR;
    msg += "  基本内功等级 30 级" ZJBR;
    msg += "  般若掌等级不能超过基本掌法等级" ZJBR ZJBR;
    msg += HIY "【练习消耗】" ZJBR NOR;
    msg += "  需要空手" ZJBR;
    msg += "  每次练习消耗："ZJBR;
    msg += "    - 气血 65 点"ZJBR;
    msg += "    - 内力 64 点"ZJBR ZJBR;
    msg += HIY "【技能效果】" ZJBR NOR;
    msg += "  可激发为掌法（strike）和招架（parry）" ZJBR;
    msg += "  可与一指禅（yizhi-chan）互备" ZJBR;
    msg += "  攻击效果提升：命中率增加 (般若掌等级 / 3)" ZJBR;
    msg += "  有效等级上限受基本内功等级限制" ZJBR ZJBR;
    msg += HIY "【特殊招式】" ZJBR NOR;
    msg += HIW "1. 封魔诀（feng）：" ZJBR NOR;
    msg += "  要求：般若掌 60 级，当前内力 200 点" ZJBR;
    msg += "  内力消耗：100点" ZJBR;
    msg += "  效果：提高自身防御力，降低攻击力" ZJBR;
    msg += "  持续时间：(般若掌等级 / 10) 秒" ZJBR;
    msg += "  描述：使出般若掌「封魔」式，双掌翻飞将周身护住" ZJBR ZJBR;
    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 般若掌需要高超的内功修为，练习时需要注意提高基本内功。" ZJBR;
    msg += "2. 在实战中，要善于利用掌法的防守特点，以守为攻。" ZJBR;
    msg += "3. 封魔诀作为防守招式，使用时机很重要，应在关键时刻施展。\n";

    return msg;
}