// certosina.c

inherit SKILL;

string type() { return "technic"; }

int valid_learn(object me)
{
    return 1;
}
string query_description()
{
    string msg;

    msg = "";
    msg += HIY "【镶嵌技艺】" ZJBR ZJBR NOR;
    msg += WHT "镶嵌技艺是一门精细的工艺技能，用于在武器或防具上镶嵌宝石，提升其属性。" ZJBR;
    msg += "此技艺要求极高的耐心和手巧，能大幅提升装备的威力。" ZJBR ZJBR;
    msg += HIY "【技能类型】" ZJBR NOR;
    msg += "  工艺类技能（technic）" ZJBR ZJBR;
    msg += HIY "【学习要求】" ZJBR NOR;
    msg += "  无特殊要求" ZJBR ZJBR;
    msg += HIY "【技能效果】" ZJBR NOR;
    msg += "  可用于镶嵌宝石，提升装备属性" ZJBR;
    msg += "  镶嵌成功率与技能等级相关" ZJBR;
    msg += "  镶嵌效果与技能等级和宝石品质相关" ZJBR ZJBR;
    msg += HIY "【学习条件】" ZJBR NOR;
    msg += "  无特殊限制，任何人都可学习" ZJBR ZJBR;
    msg += HIY "【练习方式】" ZJBR NOR;
    msg += "  通过实际镶嵌操作来提高技能" ZJBR ZJBR;
    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 镶嵌时要小心谨慎，失败可能会损坏宝石或装备。" ZJBR;
    msg += "2. 高品质的宝石需要较高的镶嵌技艺才能成功。" ZJBR;
    msg += "3. 同一件装备可以镶嵌多颗宝石，但要注意平衡。\n";

    return msg;
}


