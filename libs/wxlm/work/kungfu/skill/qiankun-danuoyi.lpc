// qiankun-danuoyi.c 乾坤大挪移
// by King 97.05

inherit SKILL;



string *parry_msg = ({
	"$N一招击在$n身上，却被$n暗运乾坤大挪移，将内力尽数移入地下。\n",
	"$n轻轻一带，$N发现自己招数回击过来，吓得往后倒退几步。\n",
	"$n手臂回转，在$N手肘下轻轻一推，$N招数落空。\n",
	"$n右手伸出，在$N手腕上轻轻一拉，$N收势不住，直往前扑去。\n",
	"$n身形不动，$N一招击下，有如石沉大海，不觉呆住了。\n",
	"$n左牵右引，$N如身处漩流，连续转了好几个圈子。\n",
	"$n双手回圈，$N只觉得前面好象有一堵墙，再也攻不进去。\n",
	"$n轻轻一转，$N一招击在地上，只打得尘土飞扬。\n",
});

string *dodge_msg = ({
	"$N一招击在$n身上，却被$n暗运乾坤大挪移，将内力尽数移入地下。\n",
	"$n轻轻一带，$N发现自己招数回击过来，吓得往后倒退几步。\n",
	"$n手臂回转，在$N手肘下轻轻一推，$N招数落空。\n",
	"$n右手伸出，在$N手腕上轻轻一拉，$N收势不住，直往前扑去。\n",
	"$n身形不动，$N一招击下，有如石沉大海，不觉呆住了。\n",
	"$n左牵右引，$N如身处漩流，连续转了好几个圈。\n",
	"$n双手回圈，$N只觉得前面好象有一堵墙，再也攻不进去。\n",
	"$n轻轻一转，$N一招击在地上，只打得尘土飞扬。\n",
});

string *pfail_msg = ({
	"$n暗运乾坤大挪移，试图将内力尽数移入地下，然而$N早已勘破其中奥妙，内力变化莫测。\n",
	"$n轻轻一带，$N发现自己招数回击过来，急忙变招，身转如意，反让$n防不胜防。\n",
	"$n手臂回转，在$N手肘下轻轻一推，然而$N招数忽的一变，并未落空。\n",
	"$n右手伸出，在$N手腕上轻轻一拉，$N收势不住，顺势变招扑前直击。\n",
	"$n左牵右引，$N如身处漩流，顺势变招，圆转如意，随心所欲。\n",
	"$n双手回圈，$N只觉得前面好象有一堵墙，猛然警醒，聚力于一点，力攻对方。\n",
});

int valid_enable(string usage) 
{ 
	return usage == "parry" ;
}

string query_parry_msg(string limb)
{
	return parry_msg[random(sizeof(parry_msg))];
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int valid_learn(object me)
{
	int layer;
	
	if (me->query("family/family_name") !="明教")
		return notify_fail("你不是明教中人，无法体会乾坤大挪移的精髓。\n");

	if (me->query("gender") == "无性" &&
	    me->query_skill("qiankun-danuoyi", 1) >= 50)
		return notify_fail("你试图按照心法修炼大挪移，却觉得心中一阵迷茫，难以继续。\n");

	if (me->query_condition("qiankun-except"))
		return notify_fail("你现在体内若冰、四肢皆寒、面赤如火，无法继续修炼神功。\n");

	layer = (int)me->query_skill("qiankun-danuoyi", 1) / 50;
	if (layer > 13) layer = 13;

	if (me->query("int") < 22 + layer)
		return notify_fail("你觉得第" + chinese_number(layer) +
				   "层乾坤大挪移实在是深奥无比，全然无法理解。\n");

	if ((int)me->query("max_neili") < 2000)
		return notify_fail("你的内力太差，无法修炼乾坤大挪移。\n");
	
	if ((int)me->query_skill("force") < 300)
		return notify_fail("你的内功火候不够，无法勉强修炼乾坤大挪移。\n");

	if ((int)me->query_skill("parry", 1) < (int)me->query_skill("qiankun-danuoyi", 1))
		return notify_fail("你的基本招架火候有限，无法体会更高深的乾坤大挪移。\n");

	if ((int)me->query_skill("dodge", 1) < (int)me->query_skill("qiankun-danuoyi", 1))
		return notify_fail("你的基本轻功火候有限，无法体会更高深的乾坤大挪移。\n");

	if ((int)me->query_skill("force", 1) < (int)me->query_skill("qiankun-danuoyi", 1))
		return notify_fail("你的基本内功火候有限，无法体会更高深的乾坤大挪移。\n");

	return 1;
}

string query_txt()
{
	return "要求：内里2000，内攻激发300，悟性22起步，每高一点悟性可以多升级50级，35悟性不限等级"ZJBR
	"特效：招架化解伤害，对比自身(招架激发/2+技能等级)和攻击者内功激发，同激发等级1/2概率触发或者和敌方进行角力，如果角力成功也触发，触发时如果敌方使用了兵器，那么造成一半的伤害返还。受阴阳八卦克制";
}

mixed valid_damage(object ob, object me, int damage, object weapon)
{
	mapping result;
	string msg;
	int ap, dp, mp;

	if ((int)me->query_skill("qiankun-danuoyi", 1) < 100 ||
		!living(me))
		return;

	mp = ob->query_skill("count", 1);
	ap = ob->query_skill("force") + mp;
	dp = me->query_skill("parry") / 2 + me->query_skill("qiankun-danuoyi", 1);

	if (COMBAT_D->judge_power(me, ob))
	{
		if (ap / 2 + random(ap) < dp|| COMBAT_D->judge_power(me, ob))
		{
			msg = parry_msg[random(sizeof(parry_msg))];
			msg = replace_string(msg, "$N", "$N" HIG);
			msg = replace_string(msg, "$n", "$n" HIG);
			msg = HIG + msg + NOR;

			// 如果敌方携带了兵器，让敌方受到一半的伤害
			if (objectp(weapon))
			{
				// 反弹的伤害受到1/4的护甲影响
				int new_damage = damage / 2 - ob->query_temp("apply/armor") / 4;
				if (new_damage < 0) new_damage = 0;

				ob->receive_damage("qi", new_damage, me);
				ob->receive_wound("qi", new_damage, me);

				msg += "$n在角力之中大获全胜，乾坤大挪移强运$N的" + weapon->name() + "，一股巨大的吸力顿时另其矛头转向，$N自身受到了兵器反伤:" + (damage / 2) + "点。\n";
			}

			result = (["damage": -(damage * 3 / 4),
				   "msg"   : msg]);
			return result;
		}
		else if (mp >= 100)
		{
			msg = pfail_msg[random(sizeof(pfail_msg))];
			msg = replace_string(msg, "$N", "$N" HIY);
			msg = replace_string(msg, "$n", "$n" HIY);
			msg = HIY + msg + NOR;
			COMBAT_D->set_bhinfo(msg);
		}
	}
	else
	{
		if ((random(ap) < dp / 3 && ap / 2 < dp) || COMBAT_D->judge_power(me, ob))
		{
			msg = parry_msg[random(sizeof(parry_msg))];
			msg = replace_string(msg, "$N", "$N" HIG);
			msg = replace_string(msg, "$n", "$n" HIG);
			msg = HIG + msg + NOR;
			result = (["damage": -(damage * 3 / 4),
				   "msg"   : msg]);
			return result;
		}
		else if (mp >= 100)
		{
			msg = pfail_msg[random(sizeof(pfail_msg))];
			msg = replace_string(msg, "$N", "$N" HIY);
			msg = replace_string(msg, "$n", "$n" HIY);
			msg = HIY + msg + NOR;
			COMBAT_D->set_bhinfo(msg);
		}
	}
}

int practice_skill(object me)
{
	return notify_fail("乾坤大挪移只能通过学习或研读乾坤大挪移心法提高。\n");
}

string perform_action_file(string func)
{
	return __DIR__"qiankun-danuoyi/" + func;
}

void skill_improved(object me)
{
	int lvl;
	int layer;

	lvl = me->query_skill("qiankun-danuoyi", 1);
	layer = lvl / 50;
	if (layer > 13) layer = 13;

	if (! layer)
	{
		tell_object(me, HIM "你潜心修炼乾坤大挪"
			    "移心法，若有所悟。"NOR"\n");
	} else
	if ((lvl % 50) == 0)
	{
		tell_object(me, HIM "你修炼成了第" + chinese_number(layer) +
			    "层的乾坤大挪移心法。"NOR"\n");
	} else
		tell_object(me, HIM "你对第" + chinese_number(layer) +
			    "层的乾坤大挪移心法又加深了一层了解。"NOR"\n");

	if (lvl > me->query_skill("force") * 2 / 3)
	{
		if (lvl < me->query_skill("force") * 2 / 3 + 10)
		{
			tell_object(me, HIG "你觉得内息一阵紊乱，丹田时冷时热，不由得大吃一惊。\n"
			      "心想莫非是走火入魔？忽然你觉得丹田越来越是寒冷，极为难受。"NOR"\n");
			message("vision", HIG + me->name() + HIG "的脸色忽红忽"
				"绿，变得不停，只是浑身颤抖，似乎十分痛苦。"NOR"\n",
				environment(me), ({ me }));
			return;
		}

		tell_object(me, HIB "你忽然觉得丹田腾起一阵寒意，霎时间四肢"
		      "百赅一起变得寒冷无比，忍不住大声呻吟。"NOR"\n");
		message("vision", HIB + me->name() + HIB "忽然一"
			"抖，脸色忽然变得惨白，隐然笼罩了一股绿气，呻吟不止。"NOR"\n",
			environment(me), ({ me }));
	} else
	if (lvl < 350 && (lvl * 20 + 400) > me->query("max_neili"))
	{
		if ((lvl * 20 + 400) < me->query("max_neili") + 200)
		{
			tell_object(me, HIR "你试着运转了一下内息，一时觉得内"
			      "力不济，看来还是不要贸然修炼大挪移神功。"NOR"\n");
			return;
		}

		tell_object(me, HIR "你试着运转了一下内息，忽然觉得一口气"
		      "竟然转不过来，顿时心中绞痛，接连吐了几口鲜血。"NOR"\n");
		message("vision", HIR + me->name() + HIR "脸色忽然"
			"一变，呕出几口鲜血，触目惊心。"NOR"\n",
			environment(me), ({ me }));
	} else
		return;

	me->apply_condition("qiankun-except", lvl + (int)me->query_condition("qiankun-except"));
}

int diffcult_level() { return 300; }

string query_description()
{
    string msg;

    msg = HIM "【乾坤大挪移】" ZJBR NOR;
    msg += "明教镇教心法，运劲巧妙，牵引挪移敌方力道，乃武学中至高无上的法门。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  必须为 明教 (mingjiao) 弟子。" ZJBR;
    msg += "  性别不能为 无性 (50级后限制)。" ZJBR;
    msg += "  不能处于 走火入魔 (qiankun-except) 状态。" ZJBR;
    msg += "  后天悟性 (int) 不低于 (22 + 乾坤大挪移等级 / 50)，最高需要 35 点悟性。" ZJBR;
    msg += "  最大内力 (max_neili) 不低于 " HIB "2000" NOR " 点。" ZJBR;
    msg += "  基本内功 (force) 等级不低于 " HIY "300" NOR " 级。" ZJBR;
    msg += "  基本招架 (parry) 等级需大于等于乾坤大挪移等级。" ZJBR;
    msg += "  基本轻功 (dodge) 等级需大于等于乾坤大挪移等级。" ZJBR;
    msg += "  基本内功 (force) 等级需大于等于乾坤大挪移等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  无法练习，只能通过学习或研读心法提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += HIM "  [挪移力道]" NOR "：受攻击时，若自身乾坤大挪移等级不低于 100 级，则有几率触发挪移效果，化解或反弹部分伤害。" ZJBR;
    msg += "    触发判定：与双方 (内功激发 + 阴阳八卦) vs (自身招架激发/2 + 乾坤大挪移等级) 以及双方 悟性 和 角力结果 相关。" ZJBR;
    msg += "      - 若自身 悟性 较高或 角力 占优：成功率基于 (对方ap / 2 + 随机(对方ap)) < 自身dp。" ZJBR;
    msg += "      - 若自身 悟性 较低且 角力 不占优：成功率基于 (随机(对方ap) < 自身dp / 3 且 对方ap / 2 < 自身dp) 或 角力占优。" ZJBR;
    msg += "    成功效果：完全化解该次攻击伤害 (" HIR "-damage" NOR ")。" ZJBR;
    msg += "    反震效果：若成功化解，且自身 悟性 较高或 角力 占优，并且攻击者使用了兵器，则会反震部分伤害给攻击者。" ZJBR;
    msg += "      - 反震伤害 = (攻击伤害 / 2) - (攻击者护甲 / 4)，最低为 0。" ZJBR;
    msg += "    特殊克制：阴阳八卦 (count) 等级较高时，可以降低挪移成功的几率。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIM "  大挪移 (nuoyi)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      乾坤大挪移等级 " HIY "50" NOR " 级 (第二层)。" ZJBR;
    msg += "      基本内功等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "400" NOR " 点。" ZJBR;
    msg += "      对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      试图牵引挪移对方的力道，使其攻击失控。" ZJBR;
    msg += "      判定属性：自身AP = (乾坤大挪移等级 + 内功激发等级)；对方DP = (对方内功激发等级 + 对方轻功激发等级)。" ZJBR;
    msg += "        - 若自身乾坤大挪移等级 >= 300，自身AP额外增加 乾坤大挪移等级。" ZJBR;
    msg += "        - 若对方为高级NPC，对方DP额外增加 武学修养等级。" ZJBR;
    msg += "      挪移效果判定：" ZJBR;
    msg += "        1. " HIR "[自伤]" NOR " (成功率最高)：若 (自身AP / 3 + 随机(自身AP / 3)) > 对方DP，则使目标攻击自身要害，受到相当于自身最大气血一半的伤害和创伤。" ZJBR;
    msg += "        2. " HIG "[转攻他人]" NOR " (成功率中等)：若条件1不满足，但 (自身AP / 3 + 随机(自身AP)) > 对方DP，且战场有其他敌人，则使目标随机攻击另一名敌人 2-4 次，并可能使被攻击者忙乱。" ZJBR;
    msg += "        3. " HIC "[攻击落空]" NOR " (成功率较低)：若条件1、2不满足，但 (自身AP / 4 + 随机(自身AP / 4)) > 对方DP，或战场无其他敌人，则目标攻击落空。" ZJBR;
    msg += "        4. " CYN "[抵抗]" NOR " (失败)：若以上条件都不满足，则目标成功抵抗挪移。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "350" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIY "〖修炼风险〗" ZJBR NOR;
    msg += "  修炼时若 基本内功 等级不足 (低于 乾坤大挪移等级 * 1.5)，或 最大内力 不足 (低于 乾坤大挪移等级 * 20 + 400，350级前有效)，则可能走火入魔，陷入 内息紊乱 或 吐血 状态，并附加 走火入魔 (qiankun-except) 负面状态。" ZJBR;

    return msg;
}