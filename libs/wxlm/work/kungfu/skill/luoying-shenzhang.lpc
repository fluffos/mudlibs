int valid_enable(string usage) { return usage=="strike" ||  usage=="parry"; } 

int valid_combine(string combo) { return combo=="xuanfeng-leg"; }

int valid_learn(object me)
{
    	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练落红凝剑掌必须空手。\n");

    	if ((int)me->query_skill("force") < 80)
		return notify_fail("你的内功火候不够，无法学落红凝剑掌。\n");

    	if ((int)me->query("max_neili") < 400)
		return notify_fail("你的内力太弱，无法练落红凝剑掌。\n");

    	if ((int)me->query_skill("strike", 1) < (int)me->query_skill("luoying-shenzhang", 1))
		return notify_fail("你的基本掌法水平有限，无法领会更高深的落红凝剑掌。\n");

    	return 1;
}

string query_skill_name(int level)
{
    	int i;
    	for (i = sizeof(action)-1; i >= 0; i--)
		if (level >= action[i]["lvl"])
	    		return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    	int i, level;
    	level = (int)me->query_skill("luoying-shenzhang", 1);
    	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
	    		return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    	if ((int)me->query("qi") < 60)
		return notify_fail("你的体力太低了。\n");

    	if ((int)me->query("neili") < 50)
		return notify_fail("你的内力不够练落红凝剑掌。\n");

    	me->receive_damage("qi", 45);
    	me->add("neili", -40);
    	return 1;
}
//等级提升，是否学会新的招式
string query_skill_up(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
	 {
		if(level == action[i]["lvl"])
		 {
		     return action[i]["skill_name"];
		 }
	 }
	  return "no";
}

string perform_action_file(string action)
{
    	return __DIR__"luoying-shenzhang/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【落英神剑掌】" ZJBR NOR;
    msg += WHT "桃花岛独门绝技，掌法之中蕴含剑意，招式繁复，虚实不定，"ZJBR;
    msg += WHT "如漫天花瓣飘落，令人防不胜防。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  必须空手。" ZJBR;
    msg += "  基本内功 (`force`) 等级不低于 " HIY "80" NOR " 级。" ZJBR;
    msg += "  最大内力 (`max_neili`) 不低于 " HIB "400" NOR " 点。" ZJBR;
    msg += "  基本掌法 (`strike`) 等级需大于等于落英神剑掌等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  掌法 (`strike`)。" ZJBR;
    msg += "  招架 (`parry`)。" ZJBR ZJBR;

    msg += HIY "〖可组合武学〗" ZJBR NOR;
    msg += "  旋风扫叶腿 (`xuanfeng-leg`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血 (`qi`) 不低于 " HIR "60" NOR " 点。" ZJBR;
    msg += "  内力 (`neili`) 不低于 " HIB "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血 " HIR "45" NOR " 点，内力 " HIB "40" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;

    msg += HIC "  奇门五转 (qimen)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      落英神剑掌 (`luoying-shenzhang`) 等级不低于 " HIY "140" NOR " 级。" ZJBR;
    msg += "      碧海神功 (`bihai-shengong`) 等级不低于 " HIY "140" NOR " 级。" ZJBR; // 需要碧海神功
    msg += "      最大内力 (`max_neili`) 不低于 " HIB "1500" NOR " 点。" ZJBR;
    msg += "      当前内力 (`neili`) 不低于 " HIB "250" NOR " 点。" ZJBR;
    msg += "      必须空手且激发为掌法。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：综合比较双方的掌法/招架与内功等级 (`随机(自身[掌法+内功]) > 对方[招架+内功] / 2`)。" ZJBR;
    msg += "      命中效果：对目标造成较大伤害，基础伤害约为 `自身掌法激发等级 + 随机(自身掌法激发等级)`，并附加等同于基础伤害一半的额外伤害。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 " HIB "200" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：消耗内力 " HIB "100" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 练习和使用落英神剑掌必须空手。" ZJBR;
    msg += "2. 特殊招式「奇门五转」需要桃花岛内功「碧海神功」配合才能施展。" ZJBR;
    msg += "3. 本武学可与「旋风扫叶腿」进行组合 (combine)。" ZJBR;

    return msg;
}