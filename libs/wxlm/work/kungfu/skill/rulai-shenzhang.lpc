string query_description()
{
    string msg;

    msg = HIY "【如来神掌】" ZJBR NOR; // 基本介绍
    msg += WHT "传说中佛祖所创的至高无上掌法，威力无穷，变幻莫测。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  仅限 " HIM "巫师" NOR " 学习。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  剑法 (sword)。" ZJBR;
    msg += "  轻功 (dodge)。" ZJBR;
    msg += "  拳脚 (unarmed)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR;
    msg += "  掌法 (strike)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  无法练习。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // hit_ob, valid_damage, skill_improved etc.
    msg += "  无（原代码中相关函数已被注释）。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform/exert
    msg += HIC "  我佛慈悲 (wofo)" ZJBR NOR; // 招式名称
    msg += "    使用要求：" ZJBR; // 招式使用要求
    msg += "      对战斗中的对手使用。" ZJBR;
    msg += "      目标存活且气血大于 " HIR "10" NOR " 点。" ZJBR;
    msg += "      (代码中缺少对如来神掌或相关技能等级的要求校验)。" ZJBR;
    msg += "    效果描述：" ZJBR; // 招式效果描述
    msg += "      命中判定：比较 (自身激发掌法等级 + 随机(自身激发掌法等级)) 与 (目标激发内功等级 / 100) 的大小。" ZJBR;
    msg += "      命中效果：" ZJBR;
    msg += "        令目标忙乱，持续时间为 (基本如来神掌等级 / 10 + 2) 秒。" ZJBR;
    msg += "        对目标造成近乎秒杀的气血伤害 (扣减至1点气血)。" ZJBR;
    msg += "        对目标造成相当于其最大气血 " HIR "20%" NOR " 的气血上限永久伤害。" ZJBR;
    msg += "      未命中效果：" ZJBR;
    msg += "        自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR; // 消耗与代价
    msg += "      内力 " HIB "60" NOR " 点。" ZJBR;

    return msg;
}