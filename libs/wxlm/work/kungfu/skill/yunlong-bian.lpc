int valid_enable(string usage) { return (usage == "whip") || (usage == "parry"); }

int valid_learn(object me)
{
	object weapon;

	if ( !objectp(weapon = me->query_temp("weapon"))
	|| ( string)weapon->query("skill_type") != "whip" )
		return notify_fail("你必须先找一条鞭子才能练鞭法。\n");

	if( (int)me->query("max_neili") < 600 )
		return notify_fail("你的内力不足，没有办法练云龙鞭法。\n");

	if ((int)me->query_skill("force") < 80)
		return notify_fail("你的内功火候太浅。\n");

	if ((int)me->query_skill("whip", 1) < 80)
		return notify_fail("你的基本鞭法火候太浅。\n");

	if ((int)me->query_skill("whip", 1) < (int)me->query_skill("yunlong-bian", 1))
		return notify_fail("你的基本鞭法水平有限，无法领会更高深的云龙鞭法。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level   = (int) me->query_skill("yunlong-bian",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "whip")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 60)
		return notify_fail("你的体力不够练云龙鞭法。\n");

	if ((int)me->query("neili") < 60)
		return notify_fail("你的内力不够练云龙鞭法。\n");

	me->receive_damage("qi", 45);
	me->add("neili", -48);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"yunlong-bian/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【云龙鞭法】" ZJBR NOR;
    msg += WHT "云龙鞭法是一门以灵活多变著称的高级鞭法，招式如龙腾云起，变幻莫测。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  需装备鞭类武器。" ZJBR;
    msg += "  最大内力 >= " HIY "600" NOR " 点。" ZJBR;
    msg += "  基本内功 等级 >= " HIY "80" NOR " 级。" ZJBR;
    msg += "  基本鞭法 等级 >= " HIY "80" NOR " 级。" ZJBR;
    msg += "  基本鞭法 等级 >= 云龙鞭法 等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  鞭法 (whip)" ZJBR;
    msg += "  招架 (parry)" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  需装备鞭类武器。" ZJBR;
    msg += "  气血 消耗：" HIR "45" NOR " 点。" ZJBR;
    msg += "  内力 消耗：" HIR "48" NOR " 点。" ZJBR ZJBR;

    // msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // 暂无明显被动

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  缠字诀 (chan)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      云龙鞭法 等级 >= " HIY "50" NOR " 级。" ZJBR;
    msg += "      有效内功 等级 >= " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前 内力 >= " HIB "100" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      判定几率：若 (" HIW "自身有效鞭法等级 + 自身有效内功等级 / 2" NOR ") > (" HIW "目标有效招架等级 + 目标有效轻功等级 / 2" NOR ")，判定成功。" ZJBR;
    msg += "      判定成功后，目标陷入 忙乱 状态。" ZJBR;
    msg += "      忙乱 持续时间：(" HIW "有效鞭法等级 / 30 + 2" NOR ") 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗 内力 " HIB "50" NOR " 点。" ZJBR;
    msg += "      自身 忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      冷却时间：" HIR "8" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "〖注意事项〗" ZJBR NOR;
    msg += "1. 云龙鞭法需要良好的内功基础和鞭法技巧。" ZJBR;
    msg += "2. 实战中灵活运用『缠字诀』可以有效牵制对手。" ZJBR;

    return msg;
}