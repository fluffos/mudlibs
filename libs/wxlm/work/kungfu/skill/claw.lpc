// staff.c

inherit SKILL;

void skill_improved(object me)
{
    if (me->query_skill("claw",1)%30==0) {
	tell_object(me, HIW "由於你勤练武艺，你的"+HIY"【后天膂力】"+NOR+"提高了。"NOR"\n");
    }
}

string query_description()
{
    string msg;

    msg = HIY "【基本爪法】" ZJBR NOR;
    msg += "所有爪类武功的基础，提升爪法的伤害和命中率。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn (默认)
    msg += "  无特殊要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable (默认)
    msg += "  爪法（claw）。" ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill (默认基础技能)
    msg += "  参照各门派内功或江湖内功的练习要求。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // skill_improved
    msg += "  每提升 30 级，提升后天膂力。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform/exert
    msg += "  无。" ZJBR;

    return msg;
}

