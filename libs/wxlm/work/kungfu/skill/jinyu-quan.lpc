int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练金玉拳必须空手。\n");

	if ((int)me->query_skill("force") < 100)
		return notify_fail("你的内功火候不够，无法练金玉拳。\n");

	if ((int)me->query("max_neili") < 500)
		return notify_fail("你的内力太弱，无法练金玉拳。\n");

	if ((int)me->query_skill("cuff") < 20)
		return notify_fail("你的基本拳法等级太低，无法练金玉拳。\n");

	if ((int)me->query_skill("cuff", 1) < (int)me->query_skill("jinyu-quan", 1))
		return notify_fail("你的基本拳法火候水平有限，无法领会更高深的金玉拳。\n");

	return 1;
}

int valid_enable(string usage)
{
	return usage == "cuff" || usage == "parry";
}

int valid_combine(string combo)
{
	return combo == "wuluo-zhang";
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("jinyu-quan",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 30)
		return notify_fail("你的内力不够练金玉拳。\n");

	me->receive_damage("qi", 35);
	me->add("neili", -21);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"jinyu-quan/" + action;
}
string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}
//等级提升，是否学会新的招式
string query_skill_up(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
	 {
		if(level == action[i]["lvl"])
		 {
		     return action[i]["skill_name"];
		 }
	 }
	  return "no";
}
string query_description()
{
    string msg;

    msg = HIY "【金玉拳】" ZJBR ZJBR NOR;
    msg += WHT "华山派拳法之一，招式巧妙，有金玉之贵，威力不俗。" ZJBR;
    msg += WHT "可与" HIW "五罗掌" NOR WHT "互备。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  必须空手。" ZJBR;
    msg += "  基本内功 (force) 等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "  最大内力 " HIB "500" NOR " 点。" ZJBR;
    msg += "  基本拳法 (cuff) 等级 " HIY "20" NOR " 级。" ZJBR;
    msg += "  基本拳法 (cuff) 等级不低于金玉拳等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  拳法 (cuff)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "30" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "35" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "21" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  金玉满堂 (man)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      金玉拳等级 " HIY "80" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      必须空手，且激发并备好金玉拳。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标发动一次攻击。" ZJBR;
    msg += "      命中判定：随机(你的拳法激发等级) > (目标的轻功激发等级 / 2)。" ZJBR;
    msg += "      命中效果：造成 (拳法激发等级 / 2 + 随机(拳法激发等级 / 2)) 的伤害，附加 45 点固定伤害。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力 " HIB "150" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "50" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 该技能必须空手才能练习和使用。
";

    return msg;
}
