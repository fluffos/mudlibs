// fly.c

inherit SKILL;

string type() { return "fly"; }

int valid_learn(object me)
{
    return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【飞行之术】" ZJBR NOR;
    msg += WHT "御风而行的基础法门，为各种高深飞行技能的基石。" ZJBR;
    msg += "本身无特殊效果，用于标记飞行类技能。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  无特殊要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  无，为飞行类技能的基础标记。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  无法练习。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    return msg;
}
