// feed-power.c

inherit SKILL;

string type() { return "knowledge"; }

void skill_improved(object me)
{
}

int valid_learn(object me)
{
	if (me->query_skill("feed-power", 1) < 500)
		return 1;

	return 0;
}

string query_description()
{
    string msg;

    msg = HIY "【灵力之源】" ZJBR NOR; // 根据文件名 feed-power 自行意译，可调整
    msg += WHT "一种特殊的知识类技能，代表着对某种力量源泉的理解或掌控。" ZJBR;
    msg += "具体效果可能与其他系统或设定相关联。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  无特殊要求，但等级上限为 " HIY "500" NOR " 级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  知识（knowledge）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  该技能无法通过练习（practice）提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  `skill_improved` 函数为空，暂无直接的被动效果。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    return msg;
}

