int valid_enable(string usage) { return usage == "cuff" || usage == "parry"; }

int valid_combine(string combo) { return combo == "hunyuan-zhang"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练劈石破玉拳必须空手。\n");

	if ((int)me->query_skill("force") < 90)
		return notify_fail("你的内功火候不够，无法学劈石破玉拳。\n");

	if ((int)me->query("max_neili") < 450)
		return notify_fail("你的内力太弱，无法练劈石破玉拳。\n");

	if (me->query_skill("cuff", 1) < me->query_skill("poyu-quan", 1))
		return notify_fail("你的基本拳法水平有限，无法领会更高深的劈石破玉拳。");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action) - 1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("poyu-quan", 1);
	for (i = sizeof(action); i > 0; i--)
		if(level > action[i - 1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 60)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 70)
		return notify_fail("你的内力不够练「劈石破玉拳」。\n");

	me->receive_damage("qi", 45);
	me->add("neili", -56);

	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"poyu-quan/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【劈石破玉拳】" ZJBR NOR;
    msg += WHT "华山派拳法，招式沉猛，大开大阖，威力不俗。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  空手状态。" ZJBR;
    msg += "  内功激发等级 ≥ " HIC "90" NOR " 级。" ZJBR;
    msg += "  最大内力 ≥ " HIB "450" NOR " 点。" ZJBR;
    msg += "  基本拳法等级 ≥ 劈石破玉拳等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  拳法 (cuff)" ZJBR;
    msg += "  招架 (parry)" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血 ≥ " HIR "60" NOR " 点。" ZJBR;
    msg += "  内力 ≥ " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗：" ZJBR;
    msg += "    气血：" HIR "45" NOR " 点。" ZJBR;
    msg += "    内力：" HIB "56" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (perform)〗" ZJBR NOR;

    msg += HIC "  破石一击 (poshi)" ZJBR NOR;
    msg += "    学习要求：" ZJBR;
    msg += "      劈石破玉拳等级 ≥ " HIY "120" NOR " 级。" ZJBR;
    msg += "      内功激发等级 ≥ " HIC "150" NOR " 级。" ZJBR;
    msg += "    使用要求：" ZJBR;
    msg += "      当前内力 ≥ " HIB "300" NOR " 点。" ZJBR;
    msg += "      激发拳法为劈石破玉拳。" ZJBR;
    msg += "      准备拳法为劈石破玉拳。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标发动一次强力攻击。" ZJBR;
    msg += "      基础伤害值约为：(自身内功激发等级 + 自身先天臂力 * 10 + 自身基本拳法等级)。" ZJBR;
    msg += "      命中后可能对目标造成气血伤害，伤害值为 (基础伤害值 / 3)。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力 " HIB "200" NOR " 点，忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "100" NOR " 点，忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  雷动九天 (leidong)" ZJBR NOR;
    msg += "    学习要求：" ZJBR;
    msg += "      劈石破玉拳等级 ≥ " HIY "135" NOR " 级。" ZJBR;
    msg += "    使用要求：" ZJBR;
    msg += "      当前内力 ≥ " HIB "500" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      临时提升自身战斗力。" ZJBR;
    msg += "      提升效果：增加 (劈石破玉拳等级 / 10) 点后天臂力与后天身法。" ZJBR;
    msg += "      持续时间：(劈石破玉拳等级 / 3) 秒。" ZJBR;
    msg += "      特殊说明：效果受角色其他状态（雷动九天意境）影响而增强。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "400" NOR " 点。" ZJBR;
    msg += "      忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  封闭手 (feng)" ZJBR NOR;
    msg += "    学习要求：" ZJBR;
    msg += "      劈石破玉拳等级 ≥ " HIY "120" NOR " 级。" ZJBR;
    msg += "    使用要求：" ZJBR;
    msg += "      当前内力 ≥ " HIB "500" NOR " 点。" ZJBR;
    msg += "      激发拳法为劈石破玉拳。" ZJBR;
    msg += "      准备拳法为劈石破玉拳。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      尝试使目标陷入忙乱状态。" ZJBR;
    msg += "      成功判定：随机(自身劈石破玉拳等级) > (目标招架激发等级 / 2)。" ZJBR;
    msg += "      成功效果：使目标忙乱，持续时间为 (随机(劈石破玉拳等级 / 20) + 2) 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "30" NOR " 点。" ZJBR;
    msg += "      自身忙乱 (1 + 随机(2)) 秒。" ZJBR ZJBR;

    return msg;
}