// five-avoid.c 五行遁

inherit SKILL;

mapping *action = ({
([  "action" : "可是$n微微一笑，$N眼前水雾弥漫，$n已使出"+HIC"『水遁』"NOR+"借水而逝。\n",
    "dodge"  : 60
]),
([  "action" : "却见$n抛下手中兵刃，扑向路边的一棵大树，转眼和枝叶混为一体，"
	       "$N茫然四顾，不知$n已经靠"+HIG"『木遁』"NOR+"躲开攻击。\n",
    "dodge"  : 70
]),
([  "action" : "$n原地一转，立时钻入土中。$N这一招落到了空处，惊道"+HIY"『土"
	      "遁』"NOR+"！\n",
    "dodge"  : 80
]),
([  "action" : "$n随手打出一团火球，喝道"+HIR"『火遁』"NOR+"！ 整个人消失在?火球中。\n",
    "dodge"  : 90
]),
([  "action" : "$n哈哈一笑，把手中的兵刃交错一击，喝道"HIY"『金遁』"NOR+"，突然精光耀眼，$N眼前一花，这一招不知落到了何处。\n",
    "dodge"  : 100
]),
});

mapping query_action(object me, object weapon)
{
    int zhaoshu, level;

    zhaoshu = sizeof(action);
    level   = (int) me->query_skill("five-avoid",1);

    if (level < 200 )
       zhaoshu--;
    if (level < 150 )
       zhaoshu--;
    if (level < 100 )
       zhaoshu--;
    if (level < 70 )
       zhaoshu--;
    return action[random(zhaoshu)];
}
int valid_enable(string usage)
{
    return (usage=="dodge") || (usage=="move");
}

int valid_learn(object me)
{
    return 1;
}
string query_dodge_msg(string limb)
{
    object me, ob;
    mapping action;

    if (!objectp(ob = query_temp("weapon"))
       || (string)ob->query("skill_type") != "throwing")
       return "但是$n没有手中暗器，$N的招式落空。\n";

    me = this_player();
    action = query_action(me, ob);

    return action["action"];
}

int practice_skill(object me)
{
    if( (int)me->query("qi") < 70 )
	return notify_fail("你的气力不够,不能修炼五行遁.\n");

    me->receive_damage("qi", 65);
    return 1;
}
string perform_action_file(string action)
{
    return __DIR__"five-avoid/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【五行遁】" ZJBR NOR;
    msg += WHT "奇门遁甲之术，依金木水火土五行之理而创的轻功身法。" ZJBR;
    msg += "练成后可借助五行之力迅速移动或隐匿身形。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  无特殊要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  轻功（dodge）。" ZJBR;
    msg += "  身法（move）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "65" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  闪避时：若装备暗器（throwing），则根据技能等级随机触发五行遁描述 (`query_dodge_msg`)，否则为默认描述。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  五遁绝杀 (break)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      当前气血不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "      内功等级不低于 " HIY "200" NOR " 级。" ZJBR;
    msg += "      当前内力不低于最大内力的一半。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      施展身法围绕目标进行多次攻击。" ZJBR;
    msg += "      攻击次数：(五行遁等级 / 30 + 2) 次，最高 5 次。" ZJBR;
    msg += "      每次攻击独立进行判定和伤害计算 (`COMBAT_D->fight`)。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      每次攻击消耗气血 " HIR "10" NOR " 点，内力 " HIB "10" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "1" NOR " 秒。" ZJBR;

    return msg;
}
