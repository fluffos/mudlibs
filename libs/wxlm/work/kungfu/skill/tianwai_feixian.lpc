int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me)
{
    if ((int)me->query("max_neili") < 1000)
        return notify_fail("你的内力不够。\n");

    if ((int)me->query_skill("force") < 150)
        return notify_fail("你的内功火候不够。\n");

    if ((int)me->query_skill("sword", 1) < 100)
        return notify_fail("你的基本剑法火候不够。\n");

    if ((int)me->query_skill("sword", 1) < (int)me->query_skill("tianwai_feixian", 1))
        return notify_fail("你的基本剑法水平有限，无法领会更高深的天外飞仙剑法。\n");

    return 1;
}

string query_skill_name(int level)
{
    int i;
    for (i = sizeof(action) - 1; i >= 0; i--)
        if (level >= action[i]["lvl"])
            return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    int i, level;
    level = (int) me->query_skill("tianwai_feixian", 1);
    for (i = sizeof(action); i > 0; i--)
        if (level > action[i-1]["lvl"])
            return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    object weapon;

    if (!objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对。\n");

    if ((int)me->query("qi") < 70)
        return notify_fail("你的体力不够练天外飞仙剑法。\n");

    if ((int)me->query("neili") < 70)
        return notify_fail("你的内力不够练天外飞仙剑法。\n");

    me->receive_damage("qi", 65);
    me->add("neili", -68);
    return 1;
}

string perform_action_file(string action)
{
    return __DIR__"tianwai_feixian/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
    int lvl;
    lvl = me->query_skill("tianwai_feixian", 1);

    if (damage_bonus < 150 || lvl < 150) return 0;

    if (random(lvl) > victim->query_skill("force", 1)/2)
    {
        victim->receive_wound("qi", (damage_bonus - 100) / 2);
        return HIW "$N" HIW "天外飞仙剑法的剑气透体而入，$n" HIW "只感内息紊乱，气血翻涌！\n" NOR;
    }
}

string query_description()
{
    string msg;

    msg = HIC "【天外飞仙剑法】" ZJBR NOR;
    msg += "传说中的仙人所创剑法，飘逸灵动，剑随意走，变化莫测，有飞仙遗世之姿。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  内力最大值需不低于 " HIB "1000" NOR " 点。" ZJBR;
    msg += "  有效内功等级需达到 " HIY "150" NOR " 级。" ZJBR;
    msg += "  基本剑法等级需达到 " HIY "100" NOR " 级。" ZJBR;
    msg += "  基本剑法等级需大于等于天外飞仙剑法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  剑法（sword）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  需持剑器。" ZJBR;
    msg += "  气血不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血 " HIR "65" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力 " HIB "68" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  当天外飞仙剑法等级达到 " HIY "150" NOR " 级并且伤害值大于 " HIR "150" NOR " 时，" ZJBR;
    msg += "  攻击有几率触发内伤效果：若随机(天外飞仙剑法等级) > 目标有效内功等级的一半，" ZJBR;
    msg += "  则额外造成 (伤害值 - 100) / 2 的气血内伤，并使目标内息紊乱。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  御剑飞仙 (yujian)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      天外飞仙剑法等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      需激发剑法为天外飞仙剑法。" ZJBR;
    msg += "      当前内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      需持剑器且在战斗中对敌人使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：若攻击方(基本剑法等级 + 基本轻功等级) > 防御方(基本轻功等级 + 基本招架等级)，则命中。" ZJBR;
    msg += "      命中效果：" ZJBR;
    msg += "        造成伤害：伤害值 = 攻击方(基本剑法等级 + 基本轻功等级) + 随机(该值/2)。" ZJBR;
    msg += "        若命中值高，可使目标忙乱约2秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中时消耗内力 " HIB "150" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中时消耗内力 " HIB "50" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  九天揽月 (jiutian)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      天外飞仙剑法等级 " HIY "140" NOR " 级。" ZJBR;
    msg += "      需激发剑法为天外飞仙剑法。" ZJBR;
    msg += "      当前内力 " HIB "250" NOR " 点。" ZJBR;
    msg += "      需持剑器且在战斗中对敌人使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：若攻击方(基本剑法等级 + 有效内功等级) > 防御方(基本轻功等级 + 基本招架等级)，则命中。" ZJBR;
    msg += "      命中效果：" ZJBR;
    msg += "        造成伤害：伤害值 = 攻击方(基本剑法等级 + 有效内功等级) + 随机(该值/2)。" ZJBR;
    msg += "        若命中值高，可使目标忙乱约2秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中时消耗内力 " HIB "200" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中时消耗内力 " HIB "100" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;

    return msg;
}