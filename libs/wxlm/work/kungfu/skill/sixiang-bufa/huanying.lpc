// huanying.c 灵狐幻影

#include <combat.h>

inherit F_SSERVER;

string query_name() { return "灵狐"ZJBR"幻影"; }

int perform(object me, object target)
{
    string msg;
    int skill, dodge_increase, duration;

    if (! target) target = offensive_target(me);

    if (! target || ! me->is_fighting(target))
        return notify_fail("「灵狐幻影」只能在战斗中使用。\n");

    if ((int)me->query_skill("sixiang-bufa", 1) < 120)
        return notify_fail("你的胡家身法不够娴熟，无法施展「灵狐幻影」。\n");

    if ((int)me->query("neili") < 300)
        return notify_fail("你的内力不够！\n");

    if (me->query_temp("huanying"))
        return notify_fail("你已经在施展「灵狐幻影」状态中了。\n");


    msg = HIY "$N" HIY "身形一晃，施展出胡家身法中的「灵狐幻影」，身体化作数道残影，令人难以捉摸！" NOR "\n";

    skill = me->query_skill("sixiang-bufa", 1);
    dodge_increase = skill / 2;
    duration = skill / 2;


    me->add_temp("apply/dodge", dodge_increase);
    me->add_temp("apply/defense", dodge_increase / 2);
    me->set_temp("huanying", 1);
    me->add("neili", -200);
    me->start_call_out((: call_other, __FILE__, "remove_effect", me, dodge_increase :), duration);
    me->start_busy(1);

    message_combatd(msg, me, target);
    return 1;
}

void remove_effect(object me, int amount)
{
    if ((int)me->query_temp("huanying"))
    {
        me->add_temp("apply/dodge", -amount);
        me->add_temp("apply/defense", -amount / 2);
        me->delete_temp("huanying");
        tell_object(me, "你的「灵狐幻影」施展完毕，身形恢复正常。\n");
    }
}
