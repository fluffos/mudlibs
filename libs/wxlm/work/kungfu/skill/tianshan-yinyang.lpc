// tianshan-yinyang.c 我自逍遥决
// 融合天山六阳掌与天山折梅手的绝世武学

inherit SKILL;

/**
 * @brief 主技能标识函数
 * @return string 主技能名称
 * @details 标识此技能为主技能
 */
string main_skill() { return "tianshan-yinyang"; }

/**
 * @brief 定义子技能映射
 * @details 天山六阳掌和天山折梅手需要达到700级才能融合
 */
