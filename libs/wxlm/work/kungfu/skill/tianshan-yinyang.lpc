/**
 * @brief 检查演练准备条件
 * @param object me 玩家对象
 * @return int 1表示可以开始演练，0表示不可以
 */
int get_ready(object me)
{
	return 1;
}

/**
 * @brief 检查演练完成条件和融合随机机制
 * @param object me 玩家对象
 * @return int 1表示成功融合，0表示失败
 * @details 实现严格的演练条件检查和60%失败率机制
 */
int get_finish(object me)
{
	// 检查是否空手状态
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
	{
		tell_object(me, "你忽然发现我自逍遥决必须空手才能施展，有武器怎能领悟天山武学的精髓？\n");
		return 0;
	}

	// 检查悟性要求
	if (me->query("int") < 35)
	{
		tell_object(me, "你演练完毕，觉得两套武学精妙异常，但悟性不足，始终无法将掌法与手法融会贯通。\n");
		return 0;
	}

	// 检查根骨要求
	if (me->query("con") < 30)
	{
		tell_object(me, "你演练完毕，就觉得根骨不足，无法承受阴阳两极武学的同时运转。\n");
		return 0;
	}

	// 检查内力要求
	if ((int)me->query("max_neili") < 100000)
	{
		tell_object(me, "你觉得内力不足，无法同时驾驭刚猛的六阳掌劲和阴柔的折梅手法。\n");
		return 0;
	}

	// 检查内功等级要求
	if (me->query_skill("force", 1) < 700)
	{
		tell_object(me, "你发现自己的内功修为不够，无法融合两套天山绝学的精髓。\n");
		return 0;
	}

	// 检查基本掌法等级要求
	if (me->query_skill("strike", 1) < 700)
	{
		tell_object(me, "你觉得自己的基本掌法还不够纯熟，无法掌握掌法为主的融合武学。\n");
		return 0;
	}

	// 检查基本手法等级要求
	if (me->query_skill("hand", 1) < 700)
	{
		tell_object(me, "你觉得自己的基本手法还不够精妙，无法领悟手法为辅的精髓所在。\n");
		return 0;
	}

	// 60%失败率机制
	if (random(10) < 6)
	{
		tell_object(me, "你觉得若有所悟，六阳掌的刚猛与折梅手的阴柔似乎有了一丝融合的征象，或许再演练一次就能成功。\n");
		return 0;
	}

	// 成功融合
	tell_object(me, HIY "突然间，你心中豁然开朗，天山六阳掌的阳刚与天山折梅手的阴柔在你心中完美融合，\n"
		        "一套前所未有的绝世武学——我自逍遥决终于被你领悟！掌法为主，手法为辅，\n"
		        "阴阳调和，刚柔并济，这正是天山派武学的最高境界！" NOR "\n");
	return 1;
}

/**
 * @brief 返回子技能映射
 * @return mapping 子技能映射
 */
mapping query_sub_skills()
{
	return sub_skills;
}

/**
 * @brief 有效激发类型 - 体现掌法为主、手法为辅
 * @param string usage 激发类型
 * @return int 1表示有效，0表示无效
 */
int valid_enable(string usage)
{
	return usage == "strike" || usage == "hand" || usage == "parry";
}

/**
 * @brief 连击功能 - 融合武学的特殊能力
 * @return int 1表示支持连击
 */
int double_attack() { return 1; }

/**
 * @brief 学习条件检查
 * @param object me 玩家对象
 * @return int 1表示可以学习，0表示不可以
 */
int valid_learn(object me)
{
	// 必须空手
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练我自逍遥决必须空手，方能领悟掌法与手法的完美融合。\n");

	// 悟性要求
	if (me->query("int") < 35)
		return notify_fail("你的天资不足，无法理解我自逍遥决的阴阳精妙。\n");

	// 内力要求
	if ((int)me->query("max_neili") < 5000)
		return notify_fail("你的内力太弱，无法学我自逍遥决。\n");

	// 基本掌法要求
	if (me->query_skill("strike", 1) < me->query_skill("tianshan-yinyang", 1))
		return notify_fail("你的基本掌法水平有限，无法领会更高深的我自逍遥决。\n");

	// 基本手法要求
	if (me->query_skill("hand", 1) < me->query_skill("tianshan-yinyang", 1))
		return notify_fail("你的基本手法水平有限，无法领会更高深的我自逍遥决。\n");

	// 内功要求
	if (me->query_skill("force", 1) < me->query_skill("tianshan-yinyang", 1))
		return notify_fail("你的内功底子还不够，无法领会更高深的我自逍遥决。\n");

	return 1;
}

/**
 * @brief 练习条件检查
 * @param object me 玩家对象
 * @return int 1表示可以练习，0表示不可以
 */
int practice_skill(object me)
{
	int cost;

	// 必须空手
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练习我自逍遥决必须空手。\n");

	// 体力要求
	if ((int)me->query("qi") < 200)
		return notify_fail("你的体力不够练我自逍遥决。\n");

	// 内力消耗计算
	cost = me->query_skill("tianshan-yinyang", 1) / 2 + 150;
	if ((int)me->query("neili") < cost)
		return notify_fail("你的内力不够练我自逍遥决。\n");

	// 消耗体力和内力
	me->receive_damage("qi", 180);
	me->add("neili", -cost);
	return 1;
}

/**
 * @brief 查询招式动作
 * @param object me 玩家对象
 * @param object weapon 武器对象
 * @return mapping 招式动作映射
 */
mapping query_action(object me, object weapon)
{
	int level;
	level = (int) me->query_skill("tianshan-yinyang", 1);

	// 高等级时有特殊攻击
	if (random(10) == 7 && level > 280)
	{
		me->add("neili", -400);
		return ([
			"action": HIM "$N" HIM "忽然神色大变，我自逍遥决终极奥义施展而出，掌风如龙，手影如凤，\n"
			         HIM "六阳掌劲与折梅手法完美融合，天地为之变色，$n" HIM "在无穷威势面前瑟瑟发抖！" NOR,
			"attack": 280,
			"dodge" : 200,
			"parry" : 220,
			"damage": 400,
			"force" : 800,
			"damage_type": "内伤"
		]);
	}

	return action[random(sizeof(action))];
}

/**
 * @brief 攻击命中特效 - 体现融合武学的战斗特色
 * @param object me 攻击者
 * @param object victim 被攻击者
 * @param int damage_bonus 伤害奖励
 * @return mixed 特效描述或空
 * @details 根据等级触发不同特效，体现掌法为主手法为辅的融合特色
 */
mixed hit_ob(object me, object victim, int damage_bonus)
{
	int lvl, i, extra_damage;
	int aoyi_lingjiu, aoyi_ziyou;
	string msg;

	lvl = me->query_skill("tianshan-yinyang", 1);
	i = random(lvl);

	if (i < 120) return;

	// 获取意境等级
	aoyi_lingjiu = COMBAT_D->get_skill_aoyi_level(me, "灵鹫飞羽");
	aoyi_ziyou = COMBAT_D->get_skill_aoyi_level(me, "自由自在");

	extra_damage = 0;

	if (i < 200)
	{
		// 掌劲特效 - 体现六阳掌的刚猛特色
		extra_damage = damage_bonus / 3;
		msg = HIR "只见$N" HIR "掌劲如烈日当空，六阳之力透掌而出，$n" HIR "顿时被炽热掌风所伤！" NOR "\n";
	}
	else if (i < 280)
	{
		// 手法特效 - 体现折梅手的阴柔控制
		extra_damage = damage_bonus / 2;
		victim->add("neili", -damage_bonus);
		msg = HIC "$N" HIC "手法如梅枝虬折，折梅之劲暗渡陈仓，$n" HIC "真气紊乱，内息不稳！" NOR "\n";
	}
	else if (i < 350)
	{
		// 掌手配合特效 - 体现融合武学的威力
		extra_damage = damage_bonus * 2 / 3;
		msg = HIY "$N" HIY "掌法刚猛，手法阴柔，阴阳并济之下掌手合璧，$n" HIY "在刚柔并济的攻势下难以招架！" NOR "\n";
	}
	else
	{
		// 终极融合特效 - 最强威力体现
		extra_damage = damage_bonus;
		victim->add("neili", -damage_bonus * 2);
		msg = HIM "$N" HIM "我自逍遥决大成境界显现，掌劲如天阳普照，手法似梅花纷飞，\n"
		      HIM "阴阳交融之下威力无穷，$n" HIM "在无上武学之力下瑟瑟发抖！" NOR "\n";
	}

	// 灵鹫飞羽意境加成 - 每级增加10%伤害
	if (aoyi_lingjiu > 0)
	{
		extra_damage += extra_damage / 10 * aoyi_lingjiu;  // 每级10%伤害加成
		msg += HIW "$N" HIW "身如灵鹫展翅，掌势迅猛如飞羽穿云，意境加持下威力更增！" NOR "\n";
	}

	// 自由自在意境加成 - 每级增加10%伤害
	if (aoyi_ziyou > 0)
	{
		extra_damage += extra_damage / 10 * aoyi_ziyou;  // 每级10%伤害加成
		msg += HIB "$N" HIB "心境自由自在，掌手配合天衣无缝，如行云流水般自然！" NOR "\n";
	}

	// 造成最终伤害
	COMBAT_D->real_damage(me, victim, extra_damage);

	return msg;
}

/**
 * @brief 防御特效 - 招架反震效果
 * @param object ob 攻击者
 * @param object me 防御者
 * @param int damage 受到的伤害
 * @param object weapon 攻击武器
 * @return mapping 防御结果或空
 * @details 激发招架时触发，体现融合武学的防御特色
 */
mixed valid_damage(object ob, object me, int damage, object weapon)
{
	mapping result;
	int ap, dp, cost, damage_reduction;
	int aoyi_lingjiu, aoyi_ziyou;
	string msg;

	// 基本触发条件检查
	if ((int)me->query_skill("tianshan-yinyang", 1) < 200
	   || me->query_skill_mapped("parry") != "tianshan-yinyang"
	   || (int)me->query("neili") < 400
	   || !living(me))
		return;

	// 获取意境等级
	aoyi_lingjiu = COMBAT_D->get_skill_aoyi_level(me, "灵鹫飞羽");
	aoyi_ziyou = COMBAT_D->get_skill_aoyi_level(me, "自由自在");

	// 内力消耗计算
	cost = damage / 3;
	if (cost > 200) cost = 200;

	// 能力对比计算 - 意境提升防御能力
	ap = ob->query_skill("force") * 12 + ob->query("max_neili");
	dp = me->query_skill("force") * 12 + me->query("max_neili");

	// 灵鹫飞羽意境提升防御判定
	if (aoyi_lingjiu > 0)
		dp += aoyi_lingjiu * me->query_skill("tianshan-yinyang", 1) / 3;

	// 防御成功判定
	if (ap / 2 + random(ap) < dp)
	{
		me->add("neili", -cost);

		// 基础伤害减免
		damage_reduction = damage * 2 / 3;

		// 自由自在意境增强防御效果
		if (aoyi_ziyou > 0)
		{
			damage_reduction += damage / 10 * aoyi_ziyou / 10;
			if (damage_reduction > damage * 4 / 5)
				damage_reduction = damage * 4 / 5;  // 最多减免80%
		}

		result = ([ "damage": -damage_reduction ]);

		// 防御特效消息 - 根据意境情况选择
		if (aoyi_lingjiu > 0 && aoyi_ziyou > 0)
		{
			msg = HIM "$n" HIM "双重意境护体，身如灵鹫展翅，心境自由自在，掌手合璧防御如神技天成，\n"
			      HIM "$N" HIM "的攻势在阴阳交融的无上武学面前化为无形！" NOR "\n";
		}
		else if (aoyi_lingjiu > 0)
		{
			msg = HIW "$n" HIW "灵鹫飞羽意境加持，身形飘逸如仙鹤翱翔，$N" HIW "的攻击被灵动的防御尽数化解！" NOR "\n";
		}
		else if (aoyi_ziyou > 0)
		{
			msg = HIB "$n" HIB "自由自在意境显现，心如止水，招式自然，$N" HIB "的攻势在从容防御下不攻自破！" NOR "\n";
		}
		else
		{
			// 随机防御特效消息 - 体现掌手融合的防御特色
			switch (random(4))
			{
			case 0:
				msg = HIY "$n" HIY "运起我自逍遥决护体，左掌如阳光普照，右手似梅花飞舞，阴阳调和之下$N" HIY "攻势被轻松化解！\n" NOR;
				break;
			case 1:
				msg = HIC "$n" HIC "掌法刚猛，手法阴柔，刚柔并济的防御如铜墙铁壁，$N" HIC "的杀招如泥牛入海！\n" NOR;
				break;
			case 2:
				msg = HIR "$n" HIR "施展掌手合璧防御，六阳掌劲护身，折梅手法卸力，$N" HIR "攻击尽被阴阳之力消融！\n" NOR;
				break;
			default:
				msg = HIM "$n" HIM "我自逍遥决大成，掌如烈日当空，手似梅花纷飞，天衣无缝的防御令$N" HIM "无从下手！\n" NOR;
				break;
			}
		}

		result += (["msg" : msg]);
		return result;
	}
}

/**
 * @brief 技能提升时清理子技能
 * @param object me 玩家对象
 * @details 融合成功后删除子技能
 */
void skill_improved(object me)
{
	int i;
	string *sub_skillnames;
	sub_skillnames = keys(sub_skills);
	for (i = 0; i < sizeof(sub_skillnames); i++)
		me->delete_skill(sub_skillnames[i]);
}

/**
 * @brief 招架特效消息
 * @param object victim_weapon 对方武器对象
 * @return string 招架消息
 */
string query_parry_msg(object victim_weapon)
{
	switch (random(4))
	{
	case 0:
		return "$n我自逍遥决运转，掌法刚猛，手法阴柔，$N的攻势瞬间被阴阳之力化解。\n";
	case 1:
		return "$n掌如烈阳，手似梅花，刚柔并济之下，$N只觉攻击如击棉絮。\n";
	case 2:
		return "$n左掌右手齐出，阴阳调和，将$N的攻势尽数挡下。\n";
	default:
		return "$n我自逍遥决精妙无比，掌手配合天衣无缝，$N难以近身分毫。\n";
	}
}

/**
 * @brief 特殊招式文件路径
 * @param string action 招式名称
 * @return string 招式文件路径
 */
string perform_action_file(string action)
{
	return __DIR__"tianshan-yinyang/" + action;
}

/**
 * @brief 技能难度等级
 * @return int 难度等级
 */
int difficult_level()
{
	return 1200;
}

/**
 * @brief 返回我自逍遥决的详细描述信息
 * @return string 包含技能介绍、学习要求、特殊招式详细说明的字符串
 * @details 提供我自逍遥决的完整技能说明，包括所有绝技的具体效果和意境机制
 */
string query_description()
{
    string msg;

    msg = HIY "【我自逍遥决】" ZJBR NOR;
    msg += WHT "融合天山六阳掌之刚猛与天山折梅手之阴柔而成的绝世武学，掌法为主，手法为辅。" ZJBR;
    msg += WHT "此武学既有六阳掌的大开大合，又有折梅手的精妙变化，阴阳调和，刚柔并济，" ZJBR;
    msg += WHT "实为天山派武学之集大成者，逍遥派武学之巅峰境界。" ZJBR ZJBR;

    msg += HIY "〖演练要求〗" ZJBR NOR;
    msg += "  天山六阳掌等级不低于 " HIY "700" NOR " 级。" ZJBR;
    msg += "  天山折梅手等级不低于 " HIY "700" NOR " 级。" ZJBR;
    msg += "  先天悟性不低于 " HIM "35" NOR " 点。" ZJBR;
    msg += "  先天根骨不低于 " HIR "30" NOR " 点。" ZJBR;
    msg += "  最大内力不低于 " HIB "100000" NOR " 点。" ZJBR;
    msg += "  内功等级不低于 " HIY "700" NOR " 级。" ZJBR;
    msg += "  基本掌法等级不低于 " HIY "700" NOR " 级。" ZJBR;
    msg += "  基本手法等级不低于 " HIY "700" NOR " 级。" ZJBR;
    msg += "  演练成功率：" HIR "40%" NOR "（60%失败率）。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  掌法 (strike) - 主修激发类型。" ZJBR;
    msg += "  手法 (hand) - 辅助激发类型。" ZJBR;
    msg += "  招架 (parry) - 防御激发类型。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须空手状态。" ZJBR;
    msg += "  气血不低于 " HIR "200" NOR " 点。" ZJBR;
    msg += "  内力不低于 " HIB "(我自逍遥决等级 / 2 + 150)" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "180" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "(我自逍遥决等级 / 2 + 150)" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  激发掌法或手法时，被动增加一次攻击机会（连击）。" ZJBR;
    msg += "  普通攻击命中时，根据等级有不同几率（random(我自逍遥决等级)）触发特效：" ZJBR;
    msg += "    - 120-199级：掌劲特效，造成 (伤害奖励 / 3) 的额外气血伤害。" ZJBR;
    msg += "    - 200-279级：手法特效，造成 (伤害奖励 / 2) 的气血伤害并减少对方内力。" ZJBR;
    msg += "    - 280-349级：掌手合璧，造成 (伤害奖励 * 2 / 3) 的气血伤害。" ZJBR;
    msg += "    - 350级以上：终极融合，造成 (伤害奖励) 的大量气血伤害、内力损失。" ZJBR;

    msg += "  防御特效（200级以上，激发招架时触发）：" ZJBR;
    msg += "    - 触发判定：(攻击方内功*12 + 最大内力) vs (防御方内功*12 + 最大内力 + 意境加成)" ZJBR;
    msg += "    - 成功时减少66%受到的伤害（意境可提升至80%）。" ZJBR;
    msg += "    - 消耗内力：受到伤害 / 3（最多200点）" ZJBR ZJBR;

    msg += HIY "〖意境支持〗" ZJBR NOR;
    msg += "  " HIC "灵鹫飞羽意境：" NOR ZJBR;
    msg += "    - 攻击特效：额外伤害 += 伤害奖励 / 8 * 意境等级" ZJBR;
    msg += "    - 防御特效：防御判定力 += 意境等级 * 技能等级 / 3" ZJBR;
    msg += "    - 绝技加成：攻击力和伤害都有显著提升" ZJBR;
    msg += "  " HIB "自由自在意境：" NOR ZJBR;
    msg += "    - 攻击特效：额外伤害 += 额外伤害 / 15 * 意境等级" ZJBR;
    msg += "    - 防御特效：伤害减免 += 伤害 / 10 * 意境等级 / 10" ZJBR;
    msg += "    - 绝技加成：伤害和控制效果都有提升" ZJBR ZJBR;

    msg += HIY "〖绝技招式详解〗" ZJBR NOR;

    msg += HIC "  掌手合璧 (zhangshouzhenbi)  【单体高伤害攻击】" ZJBR NOR;
    msg += "    " HIY "使用要求：" NOR ZJBR;
    msg += "      我自逍遥决基本等级 " HIY "100" NOR " 级 | 基本内功基本等级 " HIY "120" NOR " 级 | 当前内力 " HIB "250" NOR " 点" ZJBR;
    msg += "      必须空手状态 | 激发掌法或手法为我自逍遥决" ZJBR;
    msg += "    " HIY "伤害机制：" NOR ZJBR;
    msg += "      " HIC "攻击特性：" NOR "体现掌法为主手法为辅的单体高伤害。" ZJBR;
    msg += "      " HIC "AP计算：" NOR "激发掌法*3/2 + 激发手法 + 激发内功，灵鹫飞羽+3*等级，PVE*5/4" ZJBR;
    msg += "      " HIC "DP计算：" NOR "激发招架 + 激发内功 + 激发轻功" ZJBR;
    msg += "      " HIC "基础伤害：" NOR "我自逍遥决基本等级*5 + 激发掌法*4 + 激发手法*3 + 加力*3" ZJBR;
    msg += "      " HIC "意境加成：" NOR "灵鹫飞羽增加伤害/20*等级，自由自在增加伤害/30*等级" ZJBR;
    msg += "      " HIC "伤害类型：" NOR "普通do_damage单招伤害，伤害系数190%" ZJBR;
    msg += "    " HIY "消耗代价：" NOR "内力 " HIB "250" NOR " 点 | 成功忙乱 " HIR "1" NOR " 秒 | 失败忙乱 " HIR "2" NOR " 秒" ZJBR ZJBR;

    msg += HIC "  阴阳交融 (yinyangjiaorang)  【控制型攻击】" ZJBR NOR;
    msg += "    " HIY "使用要求：" NOR ZJBR;
    msg += "      我自逍遥决基本等级 " HIY "150" NOR " 级 | 基本内功基本等级 " HIY "150" NOR " 级 | 当前内力 " HIB "300" NOR " 点" ZJBR;
    msg += "      必须空手状态 | 激发掌法或手法为我自逍遥决" ZJBR;
    msg += "    " HIY "控制机制：" NOR ZJBR;
    msg += "      " HIC "攻击特性：" NOR "刚柔并济的控制型攻击，兼具伤害和控制。" ZJBR;
    msg += "      " HIC "AP计算：" NOR "我自逍遥决技能基本等级 + 激发内功，灵鹫飞羽+4*等级，PVE*6/5" ZJBR;
    msg += "      " HIC "DP计算：" NOR "激发轻功 + 激发内功/2" ZJBR;
    msg += "      " HIC "控制时间：" NOR "基础(我自逍遥决技能基本等级/40 + 2)秒，灵鹫飞羽+等级/12秒，自由自在+等级/15秒，最高8秒,触发概率50%" ZJBR;
    msg += "      " HIC "基础伤害：" NOR "我自逍遥决技能基本等级*6 + 激发掌法*3 + 激发手法*3 + 加力*2" ZJBR;
    msg += "      " HIC "意境加成：" NOR "灵鹫飞羽增加伤害/25*等级，自由自在增加伤害/30*等级" ZJBR;
    msg += "      " HIC "伤害类型：" NOR "普通do_damage单招伤害，伤害系数175%" ZJBR;
    msg += "    " HIY "消耗代价：" NOR "内力 " HIB "300" NOR " 点 | 成功忙乱 " HIR "2" NOR " 秒 | 失败忙乱 " HIR "3" NOR " 秒" ZJBR ZJBR;

    msg += HIC "  梅花六绝 (meihualiujue)  【六次连击攻击】" ZJBR NOR;
    msg += "    " HIY "使用要求：" NOR ZJBR;
    msg += "      我自逍遥决基本等级 " HIY "200" NOR " 级 | 基本内功基本等级 " HIY "200" NOR " 级 | 当前内力 " HIB "400" NOR " 点" ZJBR;
    msg += "      必须空手状态 | 激发掌法或手法为我自逍遥决" ZJBR;
    msg += "    " HIY "连击机制：" NOR ZJBR;
    msg += "      " HIC "攻击特性：" NOR "六次连续攻击，前三次体现六阳掌特色，后三次体现折梅手特色。" ZJBR;
    msg += "      " HIC "前三式AP：" NOR "激发掌法*5/4 + 我自逍遥决技能基本等级/3，灵鹫飞羽+2*等级，PVE*5/4" ZJBR;
    msg += "      " HIC "后三式AP：" NOR "激发手法*5/4 + 我自逍遥决技能基本等级/3，灵鹫飞羽+2*等级，PVE*5/4" ZJBR;
    msg += "      " HIC "DP计算：" NOR "激发轻功 + 激发招架/2" ZJBR;
    msg += "      " HIC "单次伤害：" NOR "我自逍遥决技能基本等级*2 + 对应激发技能*2 + 加力" ZJBR;
    msg += "      " HIC "保底机制：" NOR "若命中少于3次，触发余劲攻击：我自逍遥决技能基本等级 + 激发掌法 + 激发手法 + 加力/2" ZJBR;
    msg += "      " HIC "意境加成：" NOR "灵鹫飞羽伤害/20*等级，自由自在伤害/25*等级，保底伤害更低" ZJBR;
    msg += "      " HIC "伤害类型：" NOR "普通do_damage单招伤害，正常攻击系数260%，保底攻击系数40%" ZJBR;
    msg += "    " HIY "消耗代价：" NOR "内力 " HIB "400" NOR " 点 | 施招忙乱 " HIR "3" NOR " 秒" ZJBR ZJBR;

    msg += HIC "  天山绝境 (tianshanjuejing)  【终极奥义攻击】" ZJBR NOR;
    msg += "    " HIY "使用要求：" NOR ZJBR;
    msg += "      我自逍遥决基本等级 " HIY "280" NOR " 级 | 基本内功基本等级 " HIY "280" NOR " 级" ZJBR;
    msg += "      最大内力 " HIB "5000" NOR " 点 | 当前内力 " HIB "800" NOR " 点" ZJBR;
    msg += "      必须空手状态 | 激发掌法或手法为我自逍遥决" ZJBR;
    msg += "    " HIY "终极威力机制：" NOR ZJBR;
    msg += "      " HIC "攻击特性：" NOR "以六阳掌威力为主导，配合折梅手精妙控制的最强攻击。" ZJBR;
    msg += "      " HIC "AP计算：" NOR "我自逍遥决技能基本等级*3/2+激发掌法*6/5+激发手法*4/5+激发内功+最大内力/20" ZJBR;
    msg += "      " HIC "意境AP加成：" NOR "灵鹫飞羽+5*等级，自由自在+4*等级，PVE*3/2" ZJBR;
    msg += "      " HIC "DP计算：" NOR "激发招架+激发轻功+激发内功+最大内力/20+先天力量" ZJBR;
    msg += "      " HIC "基础伤害：" NOR "我自逍遥决技能基本等级*10+激发掌法*6+激发手法*5+加力*5+最大内力/8" ZJBR;
    msg += "      " HIC "终极加成：" NOR "最终伤害=基础伤害*(120+我自逍遥决技能基本等级/10)%" ZJBR;
    msg += "      " HIC "意境伤害：" NOR "灵鹫飞羽增加伤害/25*等级，自由自在增加伤害/30*等级" ZJBR;
    msg += "      " HIC "控制效果：" NOR "3+我自逍遥决技能基本等级/60秒，灵鹫飞羽+等级/8，自由自在+等级/10，最大12秒,触发概率50%" ZJBR;
    msg += "      " HIC "特殊效果：" NOR "350级以上30%几率对残血(1/3)NPC秒杀(-1伤害)，削减目标最大内力/5" ZJBR;
    msg += "      " HIC "伤害类型：" NOR "普通do_damage单招伤害，伤害系数95%，秒杀无视系数" ZJBR;
    msg += "    " HIY "消耗代价：" NOR "内力 " HIB "800" NOR " 点 | 忙乱 2+随机(3) 秒" ZJBR ZJBR;

    return msg;
}