int valid_enable(string usage) { return usage == "unarmed" ||  usage == "parry"; }

int valid_learn(object me)
{
	if (me->query("family/family_name") != "全真教" && me->query("family/family_name") != "古墓派")
		return notify_fail("学习空灵拳必须是全真或古墓弟子。\n");
	
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练空灵拳必须空手。\n");

	if ((int)me->query("max_neili") < 1000)
		return notify_fail("你的内力不到1000，无法练空灵拳。\n");

	if ((int)me->query_skill("force") < 150)
		return notify_fail("你的内功火候不够，无法练空灵拳。\n");

	if ((int)me->query_skill("unarmed", 1) < 120)
		return notify_fail("你的基本拳脚火候不够，无法练空灵拳。\n");

	if ((int)me->query_skill("unarmed", 1) < (int)me->query_skill("kongming-quan", 1))
		return notify_fail("你的基本拳脚水平有限，无法领会更高深的空灵拳。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action) - 1; i >= 0; i--)
		if (level >= action[i - 1]["lvl"])
			return action[i - 1]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int)me->query_skill("kongming-quan", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

string query_txt()
{
	return "要求：全真或古墓弟子，空手，内力1000，内功激发150，基本拳脚120，技能等级不能高于基本拳脚"ZJBR
	"特效：招架化解对手的空手攻击，对比自身(拳脚激发/2+技能等级)和攻击者内功激发，同等级1/4概率触发，不受特殊技能克制";
}

mixed valid_damage(object ob, object me, int damage, object weapon)
{
	mapping result;
	int ap, dp;

	if ((int)me->query_skill("kongming-quan", 1) < 100 ||
	    ! living(me) || me->query_temp("weapon") /*||
	    ob->query_temp("weapon")*/)
		return;
	
	if (me->query("family/family_name") != "全真教" && me->query("family/family_name") != "古墓派")
		return;
	
	ap = ob->query_skill("force");
	dp = me->query_skill("unarmed") / 2 +
	     me->query_skill("kongming-quan", 1);

	if (ap / 2 + random(ap) < dp && random(2))
	{
		result = ([ "damage": -(damage * 3 / 4) ]);

		switch (random(3))
		{
		case 0:
			result += (["msg" : HIM "$n" HIM "双臂一格，$N" +
					    HIM "登时觉得自己的力道全然落空。"NOR"\n"]);
			break;
		case 1:
			result += (["msg" : HIM "$n" HIM "随意格挡，让$N" +
					    HIM "只觉得自己全然捕捉不到$n" HIM "的力道。"NOR"\n"]);
			break;
		default:
			result += (["msg" : HIM "$n" HIM "慢慢出拳"
					    "左挡右格，让$N"
					    HIM "只觉得力道无处可使，说不出的难受。"NOR"\n"]);
			break;
		}
		return result;
	}
}

int query_effect_parry(object attacker, object me)
{
	int lvl;

	if (me->query_temp("weapon"))
		return 0;
	
	if (me->query("family/family_name") != "全真教")
		return 0;
	
	lvl = me->query_skill("kongming-quan", 1);
	if (lvl < 80)  return 0;
	if (lvl < 200) return 60;
	if (lvl < 280) return 90;
	if (lvl < 350) return 100;
	return 120;
}

int practice_skill(object me)
{
	if (me->query("family/family_name") != "全真教" && me->query("family/family_name") != "古墓派")
		return notify_fail("练空灵拳必须是全真或古墓弟子。\n");
	
	if ((int)me->query("qi") < 60)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 70)
		return notify_fail("你的内力不够了。\n");

	me->receive_damage("qi", 50);
	me->add("neili", -60);
	return 1;
}
//等级提升，是否学会新的招式
string query_skill_up(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
	 {
		if(level == action[i]["lvl"])
		 {
		     return action[i]["skill_name"];
		 }
	 }
	  return "no";
}

string perform_action_file(string action)
{
	return __DIR__"kongming-quan/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【空明拳】" ZJBR NOR;
    msg += WHT "周伯通所创的绝学，全真教与古墓派的精妙拳法。其拳理以空而明，招式圆转不断，劲力似有若无，柔中带刚，变化莫测。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  门派要求：" HIY "全真教" NOR " 或 " HIR "古墓派" NOR " 弟子。" ZJBR;
    msg += "  空手状态。" ZJBR;
    msg += "  最大内力 (`max_neili`) 不低于 " HIB "1000" NOR " 点。" ZJBR;
    msg += "  基本内功 (`force`) 等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "  基本拳脚 (`unarmed`) 等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "  基本拳脚 (`unarmed`) 等级需大于等于空明拳等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  拳脚 (`unarmed`)。" ZJBR;
    msg += "  招架 (`parry`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  门派要求：" HIY "全真教" NOR " 或 " HIR "古墓派" NOR " 弟子。" ZJBR;
    msg += "  气血 (`qi`) 不低于 " HIR "60" NOR " 点。" ZJBR;
    msg += "  内力 (`neili`) 不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血 " HIR "50" NOR " 点，内力 " HIB "60" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  " HIW "空明卸劲 (valid_damage)" NOR ":" ZJBR;
    msg += "    触发条件：" ZJBR;
    msg += "      空明拳等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      空手状态，自身存活，属于全真教或古墓派。" ZJBR;
    msg += "      受到攻击。" ZJBR;
    msg += "      判定条件：(攻击者内功激发等级 / 2 + 随机(攻击者内功激发等级)) < (自身基本拳脚激发等级 / 2 + 自身空明拳等级) 且 随机(2) == 1 (约 " HIY "1/4" NOR " 触发概率)。" ZJBR;
    msg += "    效果：" HIW "完全化解" NOR " 本次受到的伤害。" ZJBR;
    msg += "  " HIW "招架增效 (query_effect_parry)" NOR ":" ZJBR;
    msg += "    触发条件：" ZJBR;
    msg += "      空手状态。" ZJBR;
    msg += "      门派为 " HIY "全真教" NOR "。" ZJBR;
    msg += "    效果：提升招架效果，随空明拳等级提升，最高可达 " HIY "120%" NOR " (350级时)。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (Perform)〗" ZJBR NOR;
    msg += HIC "  空空如也 (kong)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      空明拳等级不低于 " HIY "125" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "150" NOR " 点。" ZJBR;
    msg += "      空手状态。" ZJBR;
    msg += "      激发拳脚为空明拳。" ZJBR;
    msg += "      门派为 " HIY "全真教" NOR " 或 " HIR "古墓派" NOR "。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：由 `通用命中公式` 根据双方 (拳脚激发等级 + 内功激发等级) 和 (招架激发等级 + 内功激发等级) 决定。" ZJBR;
    msg += "      命中后对目标造成伤害，伤害值约为 (自身拳脚激发等级 + 自身内功激发等级) / 2 + 随机((自身拳脚激发等级 + 自身内功激发等级) / 2)，伤害系数 " HIY "48%" NOR "。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "80" NOR " 点。" ZJBR;
    msg += "      命中：自身忙乱 " HIR "3" NOR " 秒。" ZJBR;
    msg += "      未命中：自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  空明若玄 (ruo)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      空明拳等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "      空手状态。" ZJBR;
    msg += "      激发拳脚为空明拳。" ZJBR;
    msg += "      准备拳脚为空明拳。" ZJBR;
    msg += "      门派为 " HIY "全真教" NOR " 或 " HIR "古墓派" NOR "。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      成功率判定：随机(自身空明拳等级) > (目标招架激发等级 / 2)。" ZJBR;
    msg += "      成功后使目标忙乱 (`busy`)，忙乱时间约为 (自身空明拳等级 / 50 + 2) 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "50" NOR " 点。" ZJBR;
    msg += "      成功：无额外忙乱。" ZJBR;
    msg += "      失败：自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 绝大部分特殊招式 (`perform`) 仅能在战斗中使用。" ZJBR;
    msg += "2. 所有空明拳特殊招式 (`perform`) 需要空手才能施展。" ZJBR;
    msg += "3. 使用特殊招式后通常会伴随一定时间的忙乱状态 (`busy`)。" ZJBR;
    msg += "4. 被动效果「空明卸劲」需要空手且属于全真/古墓才能触发，而「招架增效」仅限全真弟子触发。" ZJBR;

    return msg;
}