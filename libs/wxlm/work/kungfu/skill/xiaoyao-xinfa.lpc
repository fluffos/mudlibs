// xiaoyao-xinfa.c 逍遥心法

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_force(string force)
{
	return force == "beiming-shengong" ||
	       force == "xiaowuxiang";
}

int valid_learn(object me)
{
	return ::valid_learn(me);
}

int practice_skill(object me)
{
	return notify_fail("逍遥心法只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"xiaoyao-xinfa/" + func;
}

string query_description()
{
    string msg;

    msg = HIY "【逍遥心法】" ZJBR ZJBR NOR;
    msg += WHT "逍遥心法是逍遥派的独门内功心法，以养心安神、逍遥自在为宗旨。" ZJBR;
    msg += "此心法讲究心神合一，达到物我两忘的境界，从而提升内力修为。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  无特殊学习要求（遵循基础内功学习规则）。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功（force）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  无法直接练习（只能通过学习提升熟练度）。" ZJBR ZJBR;


    return msg;
}