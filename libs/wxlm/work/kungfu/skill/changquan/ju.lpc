// ju.c 三花聚顶


#include <combat.h>

inherit F_SSERVER;

string query_name() { return "猛虎出笼"; }
string *pfm_type() { return ({ "unarmed", }); }

int perform(object me, object target)
{
 
	int damage;
	string msg;

	if (! target) target = offensive_target(me);

	if (! target || ! me->is_fighting(target))
		return notify_fail("猛虎出笼只能对战斗中的对手使用。\n");

	if ((int)me->query_skill("changquan", 1) < 60)
		return notify_fail("你的太祖长拳不够娴熟，不会使用猛虎出笼。\n");

	if ((int)me->query_skill("force") < 100)
		return notify_fail("你的内功修为不够，难以施展猛虎出笼。\n");

	if (me->query_skill_mapped("unarmed") != "changquan")
		return notify_fail("你现在没有激发太祖长拳，无法使用猛虎出笼。\n");

       if (! living(target))
	      return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

	msg = HIC "$N" HIC "大喝一声，合身向$n" HIC "扑上，双拳"
	      "同时击出，正是一招「猛虎出笼」。"NOR"\n";

	if (random(me->query_skill("force")) > target->query_skill("force") / 2)
	{
		me->start_busy(2);
		damage = me->query_skill("unarmed");

		if (me->query("level") < 200)
		{
			damage *= 5;
			//提示玩家等级小于200，新手阶段获得5倍伤害奖励
			tell_object(me, HIY"注意：你当前等级为" + me->query("level") + "，"
			            "等级低于200，新手阶段获得5倍伤害奖励。"NOR"\n");
		}

		msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 100,
					   HIR "结果$p" HIR "被$P" HIR "的气势所"
					   "摄，慌忙后退，结果被$P" HIR "一掌击"
					   "了个正中，吐血不止！！"NOR"\n");
		for (int i = 0; i < COMBAT_D->query_base_attack_number(me,query_name()); i++)
		{
			COMBAT_D->do_attack(me, target, 0, 0);
		}
	} else
	{
		me->start_busy(3);
		msg += CYN "可是$p" CYN "识破了$P"
		       CYN "这一招，斜斜一跃避开。"NOR"\n";
	}
	message_combatd(msg, me, target);

	return 1;
}