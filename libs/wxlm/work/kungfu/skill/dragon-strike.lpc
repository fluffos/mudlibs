int get_ready(object me)
{
	return 1;
}

int get_finish(object me)
{
	if (me->query("family/family_name") !="丐帮")
	{
		write("镇岳锁龙劲乃是我丐帮绝学，不外传。\n");
		return 0;
	}
	if (me->query("str") < 30 || me->query_str() < 36)
	{
		tell_object(me, "你演练完毕，手臂又酸又软，几乎抬不起来（要求先天臂力30点，后天臂力36点）。\n");
		return 0;
	}

	if (me->query("con") < 22 || me->query_con() < 30)
	{
		tell_object(me, "你演练完毕，就觉得眼前金星乱冒，太阳穴突突的跳（要求先天根骨22点，后天根骨30点）。\n");
		return 0;
	}

	if ((int)me->query_skill("force") < 150)
	{
		tell_object(me, "你演练完毕，几乎虚脱，自己的内功水平看来还有待提高（要求内功激发等级150级）。\n");
		return 0;
	}

	if ((int)me->query("max_neili") < 500)
	{
		tell_object(me, "你演练完毕，丹田提不起半点力来，看来应该继续锻炼内力（要求最大内力500点）。\n");
		return 0;
	}

	if (random(10) < 5)
	{
		tell_object(me, "你对十八掌的奥妙颇有领悟，或许再演练一次就能够融会贯通。\n");
		return 0;
	}

	tell_object(me, HIY "你一气呵成，将十八掌从头到尾演练了一变，心中顿悟，通\n"
			    "晓了镇岳锁龙劲的奥妙精髓，融会贯通了掌法的精微之处，\n"
			    "再也非拆开使用那么那么简单。"NOR"\n");
	return 1;
}

mapping query_sub_skills()
{
	return sub_skills;
}

int valid_enable(string usage) { return usage=="strike" ||  usage=="parry"; }  

int valid_learn(object me)
{
	if (me->query("family/family_name") !="丐帮")
	{
		write("镇岳锁龙劲乃是我丐帮绝学，不外传。\n");
		return 1;
	}
	if ((int)me->query("str") < 31)
		return notify_fail("就你这身子骨还练镇岳锁龙劲？小心弄折了胳膊。\n");

	if ((int)me->query("con") < 24)
		return notify_fail("算了吧，你先天根骨不好，别强学了。\n");

	if ((int)me->query_skill("force") < 150)
		return notify_fail("你的内功火候不够，无法学习镇岳锁龙劲。\n");

	if ((int)me->query("max_neili") < 1500)
		return notify_fail("你的内力这么差，怎能融会贯通镇岳锁龙劲？\n");

	if ((int)me->query_skill("strike", 1) < 30)
		return notify_fail("你的基本掌法火候不够，无法学习镇岳锁龙劲。\n");

	if ((int)me->query_skill("strike", 1) < (int)me->query_skill("dragon-strike", 1))
		return notify_fail("你的基本掌法水平有限，无法领会更高深的镇岳锁龙劲。\n");

	return 1;
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	int cost;

	if (me->query("family/family_name") !="丐帮")
	{
		write("镇岳锁龙劲乃是我丐帮绝学，不外传。\n");
		return 1;
	}
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练镇岳锁龙劲必须空手。\n");

	if ((int)me->query("qi") < 150)
		return notify_fail("你的体力太低了。\n");

	cost = me->query_skill("dragon-strike", 1) / 3 + 50;
	if ((int)me->query("neili") < cost)
		return notify_fail("你的内力不够练镇岳锁龙劲。\n");

	me->receive_damage("qi", 120);
	me->add("neili", -cost);
	return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	if (random(10) >= 5)
	{
		victim->receive_wound("qi", damage_bonus / 4);
		return HIR "你听到「喀啦」数声轻响，竟似骨骼碎裂的声音！"NOR"\n";
	}
}

string perform_action_file(string action)
{
	return __DIR__"dragon-strike/" + action;
}

void skill_improved(object me)
{
	int i;
	string *sub_skillnames;

	sub_skillnames = keys(sub_skills);
	for (i = 0; i < sizeof(sub_skillnames); i++)
		me->delete_skill(sub_skillnames[i]);
}

string query_description()
{
    string msg;

    msg = HIY "【镇岳锁龙劲】" ZJBR NOR;
    msg += "丐帮镇帮神功，天下阳刚第一，掌力刚猛无俦，无坚不摧。" ZJBR;
    msg += "此功法需融会贯通十八路掌法方可大成。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  须为 " HIW "丐帮" NOR " 弟子。" ZJBR;
    msg += "  先天臂力 (str) 不低于 " HIY "31" NOR " 点。" ZJBR;
    msg += "  先天根骨 (con) 不低于 " HIY "24" NOR " 点。" ZJBR;
    msg += "  基本内功 (force) 等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "  最大内力 (max_neili) 不低于 " HIB "1500" NOR " 点。" ZJBR;
    msg += "  基本掌法 (strike) 等级不低于 " HIY "30" NOR " 级。" ZJBR;
    msg += "  基本掌法 (strike) 等级需不低于镇岳锁龙劲等级。" ZJBR ZJBR;

    msg += HIY "〖融会贯通〗" ZJBR NOR; // get_finish
    msg += "  条件：" ZJBR;
    msg += "    丐帮弟子。" ZJBR;
    msg += "    演练完所有 " HIY "18" NOR " 路掌法至 " HIY "80" NOR " 级。" ZJBR;
    msg += "    先天臂力 (str) 不低于 " HIY "30" NOR " 点，后天臂力不低于 " HIY "36" NOR " 点。" ZJBR;
    msg += "    先天根骨 (con) 不低于 " HIY "22" NOR " 点，后天根骨不低于 " HIY "30" NOR " 点。" ZJBR;
    msg += "    内功激发等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "    最大内力不低于 " HIB "500" NOR " 点。" ZJBR;
    msg += "  效果：成功后掌握完整镇岳锁龙劲，并移除单独的掌法技能。成功有一定几率。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  掌法（strike）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  空手状态。" ZJBR;
    msg += "  气血：不低于 " HIR "150" NOR " 点。" ZJBR;
    msg += "  内力：不低于 (镇岳锁龙劲等级 / 3 + 50) 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "120" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：(镇岳锁龙劲等级 / 3 + 50) 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // hit_ob
    msg += "  攻击命中时，有 " HIY "50%" NOR " 几率造成额外气血伤害（约等于伤害附加值的1/4），并伴有骨骼碎裂提示。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform_action_file

    msg += HIC "  降龙有悔 (hui)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      镇岳锁龙劲等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      最大内力不低于 " HIB "5000" NOR " 点。" ZJBR;
    msg += "      当前内力不低于 " HIB "1000" NOR " 点。" ZJBR;
    msg += "      空手，激发并备镇岳锁龙劲，战斗中使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      连续发动三次强力攻击，掌力层层叠加。" ZJBR;
    msg += "      命中判定：综合考虑双方掌法/招架激发、臂力、身法、悟性、根骨等。若自身后天膂力高于目标或角力成功，命中提升20%。对NPC命中提升10%。" ZJBR;
    msg += "      伤害计算：基础伤害受掌法激发、加力影响。若拥有奥义 " HIW "龙战于野" NOR "，附加伤害 ((掌法激发 / 6 + 后天臂力) * 奥义等级)。对NPC伤害提升20%。三次攻击伤害系数递增（75%, 85%, 95%）。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "400-1000" NOR " 点 (随机)，自身忙乱 " HIR "2-3" NOR " 秒 (随机)。" ZJBR ZJBR;

    msg += HIC "  雷霆一击 (leiting)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      须为 " HIW "丐帮" NOR " 弟子。" ZJBR;
    msg += "      镇岳锁龙劲等级 " HIY "170" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "250" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "500" NOR " 点。" ZJBR;
    msg += "      空手，激发镇岳锁龙劲，战斗中使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      发动一次旋转式强力攻击。" ZJBR;
    msg += "      命中判定：比较 (自身掌法激发 + 自身后天臂力 * 10) vs (目标轻功激发 + 目标后天臂力 * 10)。" ZJBR;
    msg += "      伤害计算：命中后造成伤害，基础伤害约为命中判定的攻击力值至其1.5倍之间，伤害系数 80%。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "400" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  排山倒海 (pai)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      须为 " HIW "丐帮" NOR " 弟子。" ZJBR;
    msg += "      镇岳锁龙劲等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "      空手，激发镇岳锁龙劲，战斗中使用，目标未被忙乱。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：比较 自身掌法激发 vs 目标内功激发。" ZJBR;
    msg += "      命中效果：使目标陷入忙乱，持续时间约为 (镇岳锁龙劲等级 / 21 + 2) 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "60" NOR " 点。命中则自身不忙乱，未命中则自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  龙翔九天 (xiang)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      须为 " HIW "丐帮" NOR " 弟子。" ZJBR;
    msg += "      镇岳锁龙劲等级 " HIY "80" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      最大内力不低于 " HIB "1000" NOR " 点。" ZJBR;
    msg += "      当前内力不低于 " HIB "500" NOR " 点。" ZJBR;
    msg += "      当前气血不低于 " HIR "300" NOR " 点。" ZJBR;
    msg += "      空手，激发并备镇岳锁龙劲，战斗中使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      发动 (普通攻击次数) 次连续攻击。" ZJBR;
    msg += "      判定成功（比较自身掌法激发+臂力 vs 目标招架激发+身法）可临时提升自身攻击力，对NPC效果提升20%。" ZJBR;
    msg += "      每次攻击有 " HIY "40%" NOR " 几率使未忙乱的目标陷入 " HIR "1" NOR " 秒忙乱。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "300" NOR " 点，气血 " HIR "100" NOR " 点。自身忙乱 " HIR "1-5" NOR " 秒 (随机)。" ZJBR;

    return msg;
}