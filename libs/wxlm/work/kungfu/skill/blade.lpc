// blade.c 基本刀法
// Modified by Venus Oct.1997

inherit SKILL;
string query_description()
{
    string msg;

    msg = "";
    msg += HIY "【基本刀法】" ZJBR ZJBR NOR;
    msg += WHT "基本刀法是武学中最基础的刀法技能，是进阶高深刀法的基础。" ZJBR;
    msg += "此刀法以力量和速度见长，招式大开大合，气势雄浑。" ZJBR ZJBR;
    msg += HIY "【技能要求】" ZJBR NOR;
    msg += "  无特殊要求 \n" ;
  

    return msg;
}
