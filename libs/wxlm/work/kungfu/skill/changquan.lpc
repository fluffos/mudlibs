int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练长拳必须空手。\n");
	if (me->query_skill("unarmed",1) <= me->query_skill("changquan",1))
		return notify_fail("你的基本拳脚不够，无法领会更高深的太祖长拳。\n");

	return 1;
}

int valid_enable(string usage)
{
	return usage == "unarmed" || usage == "parry";
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}
//等级提升，是否学会新的招式
string query_skill_up(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
	 {
		if(level == action[i]["lvl"])
		 {
		     return action[i]["skill_name"];
		 }
	 }
	  return "no";
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 40)
		return notify_fail("你现在手足酸软，休息一下再练吧。\n");

	if ((int)me->query("neili") < 10)
		return notify_fail("你的内力不够了。\n");

	me->receive_damage("qi", 35);
	me->add("neili", -1);

	return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【太祖长拳】" ZJBR NOR;
    msg += "宋太祖赵匡胤所创的基础拳法，招式刚猛，大开大合。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  空手状态。" ZJBR;
    msg += "  基本拳脚等级需大于等于太祖长拳等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  拳脚（unarmed）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "40" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "10" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "35" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "1" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻击特效〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖防御特效〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  猛虎出笼 (ju)" ZJBR NOR;
    msg += "    要求：" ZJBR;
    msg += "      太祖长拳等级 " HIY "60" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "      激发拳脚为太祖长拳。" ZJBR;
    msg += "    效果：" ZJBR;
    msg += "      命中判定基于双方内功等级。" ZJBR;
    msg += "      命中后对目标造成伤害，伤害值约为 (基本拳脚 / 3 + 随机(基本拳脚 / 3))。" ZJBR;
    msg += "      命中后追加基于 `COMBAT_D->query_base_attack_number` 次数的普通攻击。" ZJBR;
    msg += "    消耗：" ZJBR;
    msg += "      命中：内力 " HIB "110" NOR " 点，忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "60" NOR " 点，忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIY "〖其他信息〗" ZJBR NOR;
    msg += "  普通攻击招式列表：" ZJBR;
    msg += "    冲天炮、拔草寻蛇、叶底偷桃、黑虎掏心、双风贯耳、" ZJBR;
    msg += "    龙虎相交、如封似闭、阳关三叠、老树盘根、独劈华山、苍鹰捕鼠。" ZJBR;

    return msg;
}

string perform_action_file(string action)
{
	return __DIR__"changquan/" + action;
}

