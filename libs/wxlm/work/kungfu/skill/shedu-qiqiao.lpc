([      "action" : "$N一式「待机而行」，左掌掌心向外，右指蓄势点向$n的$l",
	"force" : 180,
	"dodge" : 15,
	"damage": 80,
	"lvl" : 60,
	"skill_name" : "待机而行",
	"damage_type" : "刺伤"
