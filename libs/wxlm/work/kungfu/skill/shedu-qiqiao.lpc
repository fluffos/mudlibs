([      "action" : "$N左指挥出，一式「青蛇挺身」，削向$n的掌缘",
	"force" : 80,
	"dodge" : 5,
	"lvl" : 0,
	"skill_name" : "青蛇挺身",
	"damage_type" : "刺伤"
]),
([      "action" : "$N全身之力聚于一指，一式「银蛇吐信」，指向$n的胸前",
	"force" : 100,
	"dodge" : 5,
	"lvl" : 15,
	"damage" : 25,
	"skill_name" : "银蛇吐信",
	"damage_type" : "刺伤"
]),
([      "action" : "$N左掌贴于神道穴，右手一式「金蛇摆尾」，向$n的$l划过",
	"force" : 120,
	"dodge" : 8,
	"lvl" : 25,
	"damage" : 55,
	"skill_name" : "金蛇摆尾",
	"damage_type" : "刺伤"
]),
([      "action" : "$N双目怒视，一式「蝮蛇捕食」，双指拂向$n的额、颈、肩、臂、胸、背",
	"force" : 150,
	"dodge" : 5,
	"damage": 65,
	"lvl" : 45,
	"skill_name" : "蝮蛇捕食",
	"damage_type" : "刺伤"
