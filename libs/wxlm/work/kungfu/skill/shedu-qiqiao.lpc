]),
});

int valid_enable(string usage) { return usage=="finger" || usage=="poison"; }

int valid_combine(string combo) { return combo == "lingshe-quan"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练蛇毒奇巧必须空手。\n");

	if ((int)me->query_skill("force") < 80)
		return notify_fail("你的内功火候不够，无法学蛇毒奇巧。\n");

	if ((int)me->query("max_neili") < 350)
		return notify_fail("你的内力太弱，无法练蛇毒奇巧。\n");

	if ((int)me->query_skill("poison", 1) < 30)
		return notify_fail("你的基本毒技火候不够，无法学蛇毒奇巧。\n");

	if ((int)me->query_skill("poison", 1) < (int)me->query_skill("shedu-qiqiao", 1))
		return notify_fail("你的基本毒技水平有限，无法领会更高深的蛇毒奇巧。\n");

	if ((int)me->query_skill("finger", 1) < (int)me->query_skill("shedu-qiqiao", 1))
		return notify_fail("你的基本指法水平有限，无法领会更高深的蛇毒奇巧。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action)-1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("shedu-qiqiao",1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 55)
		return notify_fail("你的内力不够练蛇毒奇巧。\n");

	me->receive_damage("qi", 52);
	me->add("neili", -44);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"shedu-qiqiao/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【蛇毒奇巧】" ZJBR ZJBR NOR;
    msg += WHT "白驼山庄嫡传武学，糅合了指法与毒技，招式模仿蛇类动作，狠辣异常，且常附带剧毒。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  必须空手。" ZJBR;
    msg += "  内功激发等级不低于 " HIY "80" NOR " 级。" ZJBR;
    msg += "  最大内力不低于 " HIB "350" NOR " 点。" ZJBR;
    msg += "  基本毒技等级不低于 " HIM "30" NOR " 级。" ZJBR;
    msg += "  基本毒技等级不得低于蛇毒奇巧等级。" ZJBR;
    msg += "  基本指法等级不得低于蛇毒奇巧等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  指法 (finger)。" ZJBR;
    msg += "  基本毒技 (poison)。" ZJBR ZJBR;

    msg += HIY "〖互备要求〗" ZJBR NOR;
    msg += "  可与 " HIG "灵蛇拳法 (lingshe-quan)" NOR " 互备。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力不低于 " HIB "55" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "52" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "44" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  激发毒技时，攻击可能附带蛇毒。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += CYN "  打蛇打七寸 (da)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      蛇毒奇巧等级 " HIY "20" NOR " 级。" ZJBR;
    msg += "      内功激发等级 " HIY "30" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      仅能对蛇类 NPC 使用。" ZJBR;
    msg += "      命中判定基于 `(自身蛇毒奇巧等级 + 轻功激发等级) ^ 2` 与 `目标经验值` 的比较。" ZJBR;
    msg += "      若判定成功，则对目标造成相当于其当前气血值的巨大伤害，并有几率使其忙乱 (`随机(技能等级 / 10)` 回合)。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "50" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "2" NOR " 回合。" ZJBR ZJBR;

    msg += CYN "  炼毒 (liandu)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      蛇毒奇巧等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      蛤蟆功等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "500" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      获得 '炼毒' 状态，持续 (`蛇毒奇巧等级 / 2`) 秒。" ZJBR;
    msg += "      状态期间，最多可触发 " HIW "10" NOR " 次淬毒攻击。" ZJBR;
    msg += "      每次普通攻击命中时，有几率消耗一次计数，并对目标施加 '蛇毒 (snake_poison)'。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "300" NOR " 点，精力 " HIG "100" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "3" NOR " 回合。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 练习和施展均需空手。" ZJBR;
    msg += "2. '打蛇打七寸' 为特殊用途招式，仅克制蛇类。" ZJBR;
    msg += "3. '炼毒' 招式依赖蛤蟆功，可在一段时间内持续淬毒。" ZJBR;
    msg += "4. 可与灵蛇拳法互备。\n";

    return msg;
}