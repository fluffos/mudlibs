int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me)
{
	if ((int)me->query_skill("force") < 200)
		return notify_fail("你的内功火候不到，无法学习补天剑诀。\n");

	if (me->query("max_neili") < 2000)
		return notify_fail("你的内力太差，无法学习补天剑诀。\n");

	if (me->query_str() < 45)
		return notify_fail("你现在膂力太差，无法学习补天剑诀。\n");

	if (me->query_skill("force", 1) < me->query_skill("xuantie-jian", 1))
		return notify_fail("你的内功底子还不够，无法领会更高深的补天剑诀。\n");

	if (me->query_skill("sword", 1) < me->query_skill("xuantie-jian", 1))
		return notify_fail("你的基本剑法水平有限，无法领会更高深的补天剑诀。\n");

	return 1;
}

mixed valid_damage(object ob, object me, int damage, object weapon)
{
        mapping result;
        int ap, dp;
        int cost;  

        cost = damage * 35 / 100;

        if ( (int)me->query("neili") < cost
           || ! living(me)
        )
                return;

        ap = ob->query_str();
        dp = me->query_str();


        if (ap / 2 + random(ap) < dp)
        {


                me->add("neili", -cost);
                result = ([ "damage": -(damage * 3 / 4) ]);

                switch (random(2))
                {
                case 0:
                        result += (["msg" : HIR "$n" HIR "运起心法，激荡全身，$N" HIR "重击在$n" HIR "的剑身上，竟似劈中万钧玄铁，反震得虎口发麻！\n"NOR]);
                        break;
                case 1:
                        result += (["msg" : HIR "$N" HIR "攻势撞上$n" HIR "横亘胸前的剑身，金铁交鸣声中火星四溅，刚猛劲道竟被重剑尽数化去！\n" NOR]);
                        break;
                default:
                        result += (["msg" : HIR "但见$n" HIR "重剑抡转如盾，剑气凝成铁幕，$N" HIR "杀招击在剑幕之上如泥牛入海！\n" NOR]);
                        break;
                }

                return result;
        }
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("xuantie-jian", 1);


	if( level > 250 )
		return ([
			"action": CYN+replace_string(replace_string(msg[random(sizeof(msg))], "$w", "$w"), "$w", "$w"CYN)+NOR,
			"dodge": random(30),
			"parry": random(30),
			"force": 350 + random(250),
			"damage": 140 + random(130),
			"damage_type": "割伤",
		]);


	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon")) || 
	    (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 80)
		return notify_fail("你的体力不够练补天剑诀。\n");

	if ((int)me->query("neili") < 80)
		return notify_fail("你的内力不够练补天剑诀。\n");

	me->receive_damage("qi", 65);
	me->add("neili", -70);

	return 1;
}

/**
 * @brief 返回主技能名称
 * @return string 主技能名称
 * @details 用于演练系统，指明此技能属于哪个主技能
 */
string main_skill() { return "xuanming-sword"; }

string perform_action_file(string action)
{
	return __DIR__"xuantie-jian/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【玄铁剑法】" ZJBR NOR;
    msg += WHT "玄铁剑法是一门以刚猛霸道著称的高级剑法。此剑法招式大开大合，气势如虹，威力无穷。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  内功有效激发等级：不低于 " HIY "200" NOR " 级。" ZJBR;
    msg += "  最大内力：不低于 " HIB "2000" NOR " 点。" ZJBR;
    msg += "  后天膂力：不低于 " HIR "45" NOR " 点。" ZJBR;
    msg += "  基本内功等级：需大于等于玄铁剑法等级。" ZJBR;
    msg += "  基本剑法等级：需大于等于玄铁剑法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  剑法（sword）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  需装备剑类武器。" ZJBR;
    msg += "  气血：不低于 " HIR "80" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "80" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "65" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "70" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // valid_damage
    msg += "  招架反震：当被攻击且内力充足时，有几率触发招架反震效果，大幅度减少受到的伤害。" ZJBR;
    msg += "    触发判定：攻击者的后天膂力 / 2 + 随机(攻击者的后天膂力) < 自身后天膂力" ZJBR;
    msg += "    消耗：当前内力，消耗量为受到伤害值的 35%。" ZJBR;
    msg += "    效果：本次受到的伤害减少为原伤害的 0 点。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform/exert
    msg += HIC "  风卷残云 (juan)" ZJBR NOR; // 招式名称
    msg += "    使用要求：" ZJBR; // 招式使用要求
    msg += "      玄铁剑法等级 " HIY "70" NOR " 级。" ZJBR;
    msg += "      内功有效激发等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      未处于忙乱状态。" ZJBR;
    msg += "      激发剑法为玄铁剑法。" ZJBR;
    msg += "    效果描述：" ZJBR; // 招式效果描述
    msg += "      命中判定受双方剑法有效激发等级和目标轻功有效激发等级影响。" ZJBR;
    msg += "      命中判定：自身剑法有效激发等级 + 随机(自身剑法有效激发等级 / 2) > 目标轻功有效激发等级。" ZJBR;
    msg += "      命中后使目标进入忙乱状态。" ZJBR;
    msg += "      忙乱时间：自身剑法有效激发等级 / 30 + 2 回合,内力高于对方时：控制时间最多25回合,低于则最多20回合。" ZJBR;
    msg += "    消耗与代价：" ZJBR; // 消耗与代价
    msg += "      命中：消耗内力 " HIB "50" NOR " 点。" ZJBR;
    msg += "      未命中：消耗内力 " HIB "25" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "    冷却时间：" HIR "6" NOR " 秒。" ZJBR;
    msg += "    描述：剑势如卷，令敌人无暇反击。" ZJBR ZJBR;

    msg += HIC "  乱字诀 (luan)" ZJBR NOR; // 招式名称
    msg += "    使用要求：" ZJBR; // 招式使用要求
    msg += "      玄铁剑法等级 " HIY "250" NOR " 级。" ZJBR;
    msg += "      怒海狂涛内功等级 " HIY "250" NOR " 级。" ZJBR;
    msg += "      武学修养有效激发等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "500" NOR " 点。" ZJBR;
    msg += "      激发剑法为玄铁剑法。" ZJBR;
    msg += "    效果描述：" ZJBR; // 招式效果描述
    msg += "      对目标进行多次连续攻击，攻击次数与自身基础攻击次数一致。" ZJBR;
    msg += "      每次攻击附加攻击加成，加成数值取决于双方武学修养差值。" ZJBR;
    msg += "      攻击加成：(自身武学修养等级 - 目标武学修养等级) / 3，最高附加 " HIR "50" NOR " 点攻击力。" ZJBR;
    msg += "    消耗与代价：" ZJBR; // 消耗与代价
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "1" NOR " 秒 + 随机(5) 秒。" ZJBR;
    msg += "    冷却时间：" HIR "6" NOR " 秒。" ZJBR;
    msg += "    描述：剑招纷乱，如海浪涛涛，连环攻击。" ZJBR ZJBR;

    msg += HIC "  大江东去 (dongqu)" ZJBR NOR; // 招式名称
    msg += "    使用要求：" ZJBR; // 招式使用要求
    msg += "      玄铁剑法等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      内功有效激发等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      激发剑法为玄铁剑法。" ZJBR;
    msg += "    效果描述：" ZJBR; // 招式效果描述
    msg += "      命中判定受自身剑法有效激发等级、武器重量以及目标内功有效激发等级、后天膂力、后天身法影响。" ZJBR;
    msg += "      自身攻击强度 (AP) = 自身剑法有效激发等级 + (武器重量 - 10000) / 100。" ZJBR;
    msg += "      目标防御强度 (PP) = 目标内功有效激发等级 + 目标后天膂力 * 5。" ZJBR;
    msg += "      目标闪避强度 (DP) = 目标内功有效激发等级 + 目标后天身法 * 5。" ZJBR;
    msg += "      命中判定：AP / 2 + 随机(AP) > PP 且 AP / 2 + 随机(AP) > DP。" ZJBR;
    msg += "      若自身性格为光明磊落，AP额外增加 AP / 10。" ZJBR;
    msg += "      命中后对目标造成巨大伤害，伤害值约为 AP / 2 + 随机(AP)。" ZJBR;
    msg += "      命中后减少目标内力，减少量为武器重量的 25%。" ZJBR;
    msg += "    消耗与代价：" ZJBR; // 消耗与代价
    msg += "      命中：消耗内力 " HIB "200" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中（被内功招架）：消耗内力 " HIB "100" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中（被轻功闪避）：自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "    冷却时间：" HIR "6" NOR " 秒。" ZJBR;
    msg += "    描述：剑势如大江东去，势不可挡。" ZJBR ZJBR;

    msg += HIC "  狂海之势 (ji)" ZJBR NOR; // 招式名称
    msg += "    使用要求：" ZJBR; // 招式使用要求
    msg += "      玄铁剑法等级 " HIY "300" NOR " 级。" ZJBR;
    msg += "      内功有效激发等级 " HIY "300" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "3000" NOR " 点。" ZJBR;
    msg += "      激发剑法为玄铁剑法。" ZJBR;
    msg += "    效果描述：" ZJBR; // 招式效果描述
    msg += "      命中判定受自身攻击强度（剑法）和目标防御强度（轻功）影响。" ZJBR;
    msg += "      自身攻击强度 (AP) = attack_power(自身, 剑法)。" ZJBR;
    msg += "      目标防御强度 (DP) = defense_power(目标, 轻功)。" ZJBR;
    msg += "      命中判定：AP / 2 + 随机(AP) > DP。" ZJBR;
    msg += "      命中后对目标造成巨大伤害。" ZJBR;
    msg += "      伤害值计算：damage_power(自身, 剑法) + 自身加力值 + (基础伤害值 / 500 * 自身后天膂力)。" ZJBR;
    msg += "      命中后可能使敌人进入忙乱状态（忙乱时间：随机 2-3 秒）。" ZJBR;
    msg += "      命中后可能削减目标内力（削减量：目标当前内力 / 5）。" ZJBR;
    msg += "    消耗与代价：" ZJBR; // 消耗与代价
    msg += "      消耗内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "1" NOR " 秒 + 随机(5) 秒。" ZJBR;
    msg += "    冷却时间：" HIR "6" NOR " 秒。" ZJBR;
    msg += "    描述：剑势如狂涛骇浪，势不可挡，可重创敌人并扰乱其内力及招式。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 玄铁剑法需要强大的内力支持，练习时需注意提高内功修为。" ZJBR;
    msg += "2. 此剑法招式刚猛，使用时需注意控制力道，以免伤及自身。" ZJBR;
    msg += "3. 特殊招式威力强大，但也容易暴露破绽，使用需谨慎。" ZJBR;
    msg += "4. 配合怒海狂涛内功使用，可以发挥出更强的威力。\n";


    return msg;
}