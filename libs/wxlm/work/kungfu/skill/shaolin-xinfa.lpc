// shaolin-xinfa.c 少林心法

inherit FORCE;

int valid_enable(string usage)
{
	    return usage == "force";
}

int valid_force(string force)
{
	return force == "yijinjing" ||
	       force == "taiji-shengong" ||
	       force == "wudang-xinfa" ||
	       force == "hunyuan-yiqi";
}

int valid_learn(object me)
{
	    return ::valid_learn(me);
}

int practice_skill(object me)
{
	    return notify_fail("少林心法只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	    return __DIR__"shaolin-xinfa/" + func;
}

string query_description()
{
    string msg;

    msg = HIY "【少林心法】" ZJBR NOR;
    msg += WHT "少林派的基础内功心法，乃修习更高深内功的基石，讲究固本培元。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn (继承FORCE)
    msg += "  通常需满足基本内功 (`force`) 的学习条件。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  内功（force）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  无法练习，只能通过学习 (`learn`) 提升等级。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // 继承FORCE
    msg += "  作为基础内功，提供基本的内力上限和恢复加成。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // exert_function_file
    msg += "  （相关目录不存在或无法访问，无法分析具体的 `exert` 招式）" ZJBR ZJBR;

    msg += HIY "〖可互备技能〗" ZJBR NOR; // valid_force
    msg += "  易筋经 (`yijinjing`)。" ZJBR;
    msg += "  太极神功 (`taiji-shengong`)。" ZJBR;
    msg += "  武当心法 (`wudang-xinfa`)。" ZJBR;
    msg += "  混元一气功 (`hunyuan-yiqi`)。" ZJBR ZJBR;

    return msg;
}
