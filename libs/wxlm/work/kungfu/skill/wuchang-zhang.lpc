int valid_enable(string usage) { return usage == "staff" || usage == "parry"; }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 500)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("force") < 80)
		return notify_fail("你的内功火候太浅。\n");

	if ((int)me->query_skill("staff", 1) < (int)(int)me->query_skill("wuchang-zhang", 1))
		return notify_fail("你的基本杖法水平有限，无法领会更高深的无常杖法。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action)-1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("wuchang-zhang",1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "staff")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 80)
		return notify_fail("你的体力不够练无常杖法。\n");

	if ((int)me->query("neili") < 75)
		return notify_fail("你的内力不够练无常杖法。\n");

	me->receive_damage("qi", 70);
	me->add("neili", -69);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"wuchang-zhang/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【无常杖法】" ZJBR NOR;
    msg += "一门高深的杖法，招式诡异奇幻，看似笨拙实则凌厉无比，常以狂怒劲风威摄敌手。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力不低于 " HIB "500" NOR " 点。" ZJBR;
    msg += "  基本内功等级不低于 " HIY "80" NOR " 级。" ZJBR;
    msg += "  基本杖法等级需大于等于无常杖法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  杖法（staff）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  装备类型为杖（staff）的武器。" ZJBR;
    msg += "  气血不低于 " HIR "80" NOR " 点。" ZJBR;
    msg += "  内力不低于 " HIB "75" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "69" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  无常五化 (wuhua)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      无常杖法等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "200" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      激发杖法为无常杖法。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      连续攻击对手五次，每次攻击有50%几率使对手忙乱1秒。" ZJBR;
    msg += "      攻击伤害与无常杖法等级相关。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力消耗与攻击伤害相关。" ZJBR;
    msg += "      冷却时间1-5秒。" ZJBR;

    return msg;
}

