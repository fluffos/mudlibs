int valid_enable(string usage) { return usage == "claw" || usage == "parry"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
	    return notify_fail("练败血神爪必须空手。\n");

	if ((int)me->query("max_neili") < 800)
	    return notify_fail("你的内力太弱，无法练败血神爪。\n");

	if ((int)me->query_str() < 40)
	    return notify_fail("你现在膂力孱弱，还无法练败血神爪。\n");

	if ((int)me->query_dex() < 40)
	    return notify_fail("你现在身法欠佳，还无法练败血神爪。\n");

	if ((int)me->query_skill("force") < 200)
	    return notify_fail("你的内功太差，无法练败血神爪。\n");

	if ((int)me->query_skill("claw", 1) < 180)
	    return notify_fail("你的基本爪法太差，无法领会败血神爪。\n");

	if ((int)me->query_skill("claw", 1) < (int)me->query_skill("ningxue-shenzhao", 1))
	    return notify_fail("你的基本爪法火候不够，无法领会更高深的败血神爪。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action); i > 0; i--)
		if (level >= action[i-1]["lvl"])
			return action[i-1]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("ningxue-shenzhao",1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 5, level/5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 120)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 350)
		return notify_fail("你的内力不够练败血神爪。\n");

	me->receive_damage("qi", 100);
	me->add("neili", -300);
	return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int lvl;
	int flvl;

	lvl  = me->query_skill("ningxue-shenzhao", 1);
	flvl = me->query("jiali");
	if (lvl < 80 || flvl < 10 || ! damage_bonus)
		return;

	if (flvl * 2 + random(lvl) > victim->query_skill("force") &&
	    victim->affect_by("ningxue_shenzhao",
			      ([ "level" : flvl + random(flvl),
				 "id"    : me->query("id"),
				 "duration" : lvl / 100 + random(lvl / 10) ])))
	{
		return HIR "只听$n" HIR "一声惨嚎，看来受到了败血神爪毒劲的干扰！"NOR"\n";
	}
}

string perform_action_file(string action)
{
	return __DIR__"ningxue-shenzhao/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【凝血神爪】" ZJBR NOR;
    msg += "一门极其阴毒狠辣的爪法，爪带剧毒，中者血液凝固，故名凝血神爪。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  必须空手。" ZJBR;
    msg += "  最大内力 " HIB "800" NOR " 点。" ZJBR;
    msg += "  基本内功等级 " HIY "200" NOR " 级。" ZJBR;
    msg += "  基本爪法等级 " HIY "180" NOR " 级。" ZJBR;
    msg += "  先天膂力 " HIY "40" NOR " 点。" ZJBR;
    msg += "  先天身法 " HIY "40" NOR " 点。" ZJBR;
    msg += "  基本爪法等级不低于凝血神爪等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  爪法（claw）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "120" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "350" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "100" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "300" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  攻击命中时，若自身凝血神爪等级不低于 " HIY "80" NOR " 级、加力不低于 " HIY "10" NOR " 点，且满足以下条件：" ZJBR;
    msg += "  (自身加力 * 2 + 随机(自身凝血神爪等级)) > 对方基本内功等级，则：" ZJBR;
    msg += "  使对方中【凝血神爪】之毒(" HIC "ningxue_shenzhao" NOR ")。" ZJBR;
    msg += "  中毒效果强度 = (自身加力 + 随机(自身加力))。" ZJBR;
    msg += "  中毒持续时间 = (自身凝血神爪等级 / 100 + 随机(自身凝血神爪等级 / 10)) 秒。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  疾电 (ji) / 急电一抓" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      凝血神爪等级 " HIY "250" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "200" NOR " 级。" ZJBR;
    msg += "      最大内力 " HIB "1000" NOR " 点。" ZJBR;
    msg += "      当前内力 " HIB "500" NOR " 点。" ZJBR;
    msg += "      必须空手。" ZJBR;
    msg += "      激发爪法为凝血神爪。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      施展时暂时提升目标招架和轻功等级 " HIY "10" NOR " 点（`delta` 值）。" ZJBR;
    msg += "      连续对目标进行数次攻击（次数由 `COMBAT_D->query_base_attack_number` 决定）。" ZJBR;
    msg += "      每次攻击独立计算命中和伤害，并可能触发凝血神爪的 `hit_ob` 中毒效果。" ZJBR;
    msg += "      每次攻击有 " HIY "1/3" NOR " 的几率使未忙乱的目标忙乱 " HIR "1" NOR " 秒。" ZJBR;
    msg += "      攻击结束后移除目标的临时招架和轻功提升。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "1" NOR " 至 " HIR "5" NOR " 秒 (1 + 随机(5))。" ZJBR ZJBR;

    return msg;
}