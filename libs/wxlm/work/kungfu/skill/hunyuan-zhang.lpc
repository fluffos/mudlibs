int valid_enable(string usage) { return usage == "parry" || usage == "strike"; }

int valid_combine(string combo) { return combo == "poyu-quan"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练混元掌必须空手。\n");

	if ((int)me->query_skill("force") < 30)
		return notify_fail("你的内功火候不够，无法学混元掌。\n");

	if ((int)me->query("max_neili") < 150)
		return notify_fail("你的内力太弱，无法练混元掌。\n");

	if (me->query_skill("strike", 1) < me->query_skill("hunyuan-zhang", 1))
		return notify_fail("你的基本掌法水平有限，无法领会更高深的混元掌。");

	return 1;
}

string query_skill_name(int level)
{
	int i;

	for (i = sizeof(action) - 1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;

	level = (int) me->query_skill("hunyuan-zhang",1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i - 1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 60)
		return notify_fail("你的内力不够练混元掌。\n");

	me->receive_damage("qi", 40);
	me->add("neili", -53);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"hunyuan-zhang/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【混元掌】" ZJBR ZJBR NOR;
    msg += WHT "混元掌是华山派绝学之一，招式古朴，内劲浑厚，由混元功内劲驱动。" ZJBR ZJBR;
    msg += HIY "【学习要求】" ZJBR NOR;
    msg += "  内力最大值 150 点" ZJBR;
    msg += "  内功等级 30 级" ZJBR;
    msg += "  基本掌法等级不低于混元掌等级" ZJBR ZJBR;

    msg += HIY "【特殊效果】" ZJBR NOR;
    msg += "  可激发为掌法（strike）或招架（parry）" ZJBR;
    msg += "  可与华山派破玉拳互备" ZJBR ZJBR;

    msg += HIY "【练习要求】" ZJBR NOR;
    msg += "  气血不少于 50 点" ZJBR;
    msg += "  内力不少于 60 点" ZJBR;
    msg += "  每次练习消耗：" ZJBR;
    msg += "    气血：40 点" ZJBR;
    msg += "    内力：53 点" ZJBR ZJBR;
    msg += HIY "【特殊招式】" ZJBR NOR;
    msg += HIW "1. 混元无极（wuji）：" ZJBR NOR;
    msg += "  要求：混元掌 60 级，内力 150 点" ZJBR;
    msg += "  效果：对敌人造成较高的伤害，命中取决于自身掌法和对方内功" ZJBR;
    msg += "  伤害：基础伤害 100 点，附加 0 到混元掌等级的随机伤害，有较高的伤害加成" ZJBR;
    msg += "  消耗：命中消耗 140 点内力，未命中消耗 30 点内力" ZJBR;
    msg += "  限制：只能在战斗中使用，且需激发混元掌为掌法" ZJBR;
    msg += "  忙乱：命中后自身忙乱 1-2 秒，未命中忙乱 3 秒" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 混元无极的命中率与自身掌法等级和对方内功等级相关，请谨慎使用。" ZJBR;
    msg += "2. 使用后会产生忙乱，注意战斗节奏。\\n";

    return msg;
}