int valid_enable(string usage) { return usage == "whip" || usage == "parry"; }

int valid_learn(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "whip" )
		return notify_fail("你必须先找一条鞭子才能练习缠魂索。\n");

	if ((int)me->query("max_neili") < 400)
		return notify_fail("你的内力不足，没有办法练习缠魂索。\n");

	if ((int)me->query_skill("force") < 80)
		return notify_fail("你的内功火候太浅。\n");

	if ((int)me->query_skill("whip", 1) < 60)
		return notify_fail("你的基本鞭法火候太浅。\n");

	if ((int)me->query_skill("whip", 1) < (int)me->query_skill("chanhun-suo", 1))
		return notify_fail("你的基本鞭法水平有限，无法领会更高深的缠魂索。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action) - 1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("chanhun-suo", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i - 1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "whip")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 60)
		return notify_fail("你的体力不够练缠魂索。\n");

	if ((int)me->query("neili") < 60)
		return notify_fail("你的内力不够练缠魂索。\n");

	me->receive_damage("qi", 50);
	me->add("neili", -50);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"chanhun-suo/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【缠魂索】" ZJBR NOR;
    msg += "星宿派独门鞭法，招式诡异，变幻莫测，擅长以鞭索缠魂夺魄。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  须装备鞭类武器。" ZJBR;
    msg += "  最大内力不低于 " HIB "400" NOR " 点。" ZJBR;
    msg += "  基本内功等级不低于 " HIY "80" NOR " 级。" ZJBR;
    msg += "  基本鞭法等级不低于 " HIY "60" NOR " 级。" ZJBR;
    msg += "  基本鞭法等级需大于等于缠魂索等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  鞭法（whip）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "60" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "50" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻击特效〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖防御特效〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;

    msg += HIW "  缠魂夺魄 (duopo)" ZJBR NOR;
    msg += "    要求：" ZJBR;
    msg += "      缠魂索等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "500" NOR " 点。" ZJBR;
    msg += "      装备鞭类武器且激发为缠魂索。" ZJBR;
    msg += "    效果：" ZJBR;
    msg += "      命中判定基于 (自身鞭法+内功) vs (目标轻功+招架)。" ZJBR;
    msg += "      命中后对目标造成伤害，伤害值约为 (鞭法+内功)/2 + 随机((鞭法+内功)/2)。" ZJBR;
    msg += "      同时对目标造成气血伤害和气血上限伤害。" ZJBR;
    msg += "      使目标忙乱 " HIR "2 + 随机(2)" NOR " 秒。" ZJBR;
    msg += "    消耗：" ZJBR;
    msg += "      内力 " HIB "400" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIY "  夺魂鞭 (duo)" ZJBR NOR;
    msg += "    要求：" ZJBR;
    msg += "      缠魂索等级 " HIY "80" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      装备鞭类武器且激发为缠魂索。" ZJBR;
    msg += "    效果：" ZJBR;
    msg += "      命中判定基于 (自身鞭法+内功) vs (目标内功+招架)。" ZJBR;
    msg += "      命中后对目标造成伤害，伤害值约为 (鞭法+内功)/3 + 随机((鞭法+内功)/3)。" ZJBR;
    msg += "    消耗：" ZJBR;
    msg += "      内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      命中：自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "  琐魂鞭 (suo)" ZJBR NOR;
    msg += "    要求：" ZJBR;
    msg += "      缠魂索等级 " HIY "50" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      装备鞭类武器且激发为缠魂索。" ZJBR;
    msg += "      目标未处于忙乱状态。" ZJBR;
    msg += "    效果：" ZJBR;
    msg += "      命中判定基于 自身鞭法 vs 目标轻功。" ZJBR;
    msg += "      命中后使目标忙乱，时间约为 (自身鞭法 / 22 + 1) 秒。" ZJBR;
    msg += "    消耗：" ZJBR;
    msg += "      命中：自身忙乱 " HIR "1 + 随机(2)" NOR " 秒。" ZJBR;
    msg += "      未命中：自身忙乱 " HIR "4" NOR " 秒。" ZJBR ZJBR; // 注意：代码中未显示内力消耗

    msg += HIY "〖其他信息〗" ZJBR NOR;
    msg += "  普通攻击招式列表：" ZJBR;
    msg += "    虐目、伤肝、损心、催胆、摄魄、收魂。" ZJBR;

    return msg;
}
