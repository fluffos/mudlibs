	"dodge" : 12,
	"parry" : 10,
	"damage": 5,
	"lvl"   : 0,
	"skill_name" : "虐目",
	"damage_type": "刺伤"
]),
([      "action": "$N力贯鞭梢，一招「伤肝」，手中$w舞出满天鞭影，横扫$n腰间",
	"force" : 130,
	"dodge" : 17,
	"parry" : 15,
	"damage": 10,
	"lvl"   : 20,
	"skill_name" : "伤肝",
	"damage_type": "劈伤"
]),
([      "action": "$N运气于腕，一招「损心」，手中$w向一根铜棍般直击$n胸部",
	"force" : 150,
	"dodge" : 21,
