 
// duopo.c 缠魂夺魄


#include <combat.h>

inherit F_SSERVER;

string query_name() { return "缠魂夺魄"; }

int perform(object me, object target)
{
    object weapon;
    string msg;
    int ap, dp;
    int damage;

    if (! target) target = offensive_target(me);

    if (! objectp(weapon = me->query_temp("weapon")) ||
        weapon->query("skill_type") != "whip")
        return notify_fail("你使用的武器不对，无法施展「缠魂夺魄」。\n");

    if (! me->is_fighting(target))
        return notify_fail("「缠魂夺魄」只能对战斗中的对手使用。\n");

    if ((int)me->query_skill("chanhun-suo", 1) < 150)
        return notify_fail("你的缠魂索功力不够，无法施展「缠魂夺魄」。\n");

    if (me->query("neili") < 500)
        return notify_fail("你的内力不足，无法施展「缠魂夺魄」。\n");

    if (me->query_skill_mapped("whip") != "chanhun-suo")
        return notify_fail("你没有激发缠魂索，无法施展「缠魂夺魄」。\n");

    if (! living(target))
        return notify_fail("对方已经这样了，不需要这么费力吧？\n");

    msg = HIW "$N" HIW "手中" + weapon->name() + HIW "宛如灵蛇，瞬间缠绕向$n" HIW "的四肢！\n" NOR;
    message_combatd(msg, me, target);

    ap = me->query_skill("whip") + me->query_skill("force");
    dp = target->query_skill("dodge") + target->query_skill("parry");

    me->add("neili", -400);
    me->start_busy(2);

    if (COMBAT_D->hit_determination(me,target,ap,dp))
    {
        damage = ap / 2 + random(ap / 2);
        msg = HIR "$n" HIR "只觉得全身一紧，被$N" HIR "的" + weapon->name() + HIR "牢牢缠住，动弹不得！\n" NOR;
        target->start_busy(2 + random(2));
        COMBAT_D->real_damage(me, target, damage);
    }
    else
    {
        msg = CYN "$n" CYN "眼明手快，急忙闪身，避开了$N" CYN "的" + weapon->name() + CYN "！\n" NOR;
    }

    message_combatd(msg, me, target);
    return 1;
}