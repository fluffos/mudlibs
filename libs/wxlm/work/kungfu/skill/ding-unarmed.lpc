// ding-unarmed.c 一横一勾拳
inherit SKILL;

mapping *action = ({
([	"action" : "$N左手轻轻一抹，向$n的$l拍去",
	"force"  : 180,
	"damage" : 80,
	"damage_type" : "瘀伤"
]),
([	"action" : "$N右手一提，插向$n的$l",
	"force"  : 230,
	"damage" : 100,
	"damage_type" : "瘀伤"
])
});

int valid_enable(string usage) { return usage=="unarmed" || usage=="parry"; }

int valid_learn(object me)
{
	return 1;
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 40)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 40)
		return notify_fail("你的内力不够练一横一勾拳。\n");

	me->receive_damage("qi", 35);
	me->add("neili", -32);

	return 1;
}
string query_description()
{
    string msg;

    msg = HIY "【一横一勾拳】" ZJBR NOR;
    msg += "一种非常基础的拳脚功夫，动作简洁有力。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  无特殊要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  拳脚（unarmed）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "40" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "40" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "35" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "32" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  攻击时随机使用 `一抹` 或 `一提` 招式。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR;

    return msg;
}
