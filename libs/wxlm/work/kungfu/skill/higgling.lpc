// higgling.c

inherit SKILL;

string type() { return "knowledge"; }

void skill_improved(object me)
{
}

int valid_learn(object me)
{
	return 1;
}

string query_description()
{
	string msg;

	msg = HIY "【讨价还价】" ZJBR NOR;
	msg += WHT "这是一门在交易中争取更优惠价格的知识类技能。" ZJBR;
	msg += "掌握此技能可以帮助你在买卖物品时获得更好的交易条件。" ZJBR ZJBR;

	msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
	msg += "  无特殊要求。" ZJBR ZJBR;

	msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable (N/A)
	msg += "  无法激发。" ZJBR ZJBR;

	msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill (N/A)
	msg += "  无法练习。" ZJBR ZJBR;

	msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // skill_improved is empty
	msg += "  无特殊攻防特效或被动效果。" ZJBR ZJBR; // (实际效果可能体现在其他系统，但技能本身无定义)

	msg += HIY "〖特殊招式〗" ZJBR NOR; // perform_action_file (N/A)
	msg += "  无特殊招式。" ZJBR ZJBR;

	return msg;
}
