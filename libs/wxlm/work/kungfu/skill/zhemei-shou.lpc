int valid_enable(string usage) { return usage=="parry"|| usage=="hand"; }

int valid_combine(string combo) { return combo=="liuyang-zhang"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练天山落梅手必须空手。\n");

	if ((int)me->query("max_neili") < 900)
		return notify_fail("你的内力太弱，无法练天山落梅手。\n");

	if ((int)me->query_skill("force") < 120)
		return notify_fail("你的内功火候不够，无法练天山落梅手。\n");

	if ((int)me->query_skill("hand", 1) < 100)
		return notify_fail("你的基本手法火候不够，无法练天山落梅手。\n");

	if ((int)me->query_skill("hand", 1) < (int)me->query_skill("zhemei-shou", 1))
		return notify_fail("你的基本手法水平有限，无法领会更高深的天山落梅手。\n");

	return 1;
}

mixed valid_damage(object ob, object me, int damage, object weapon)
{
        mapping result;
        int ap, dp;
        int cost;  

        cost = damage / 5;

        if ( (int)me->query("neili") < cost
           || ! living(me) ||(me->query("family/family_name") != "灵鹫宫")
        )
                return;

        ap = ob->query_skill("force");
        dp = me->query_skill("parry");


        if (ap / 2 + random(ap) < dp)
        {


                me->add("neili", -cost);
                result = ([ "damage": -(damage * 3 / 4) ]);

                switch (random(2))
                {
                case 0:
                        result += (["msg" : HIR "$n" HIR "运起天山折梅收，双掌如梅枝虬结，$N" HIR "的攻势竟似撞上铜墙铁壁，反震得$N" HIR "双臂酸麻！\n"NOR]);
                        break;
                case 1:
                        result += (["msg" : HIR "$N" HIR "凌厉攻势触及$n" HIR "掌影，霎时如雪落梅枝，刚猛劲道被精妙擒拿手法尽数化去！\n" NOR]);
                        break;
                default:
                        result += (["msg" : HIR "但见$n" HIR "双掌翻飞似雪梅纷落，掌风激荡间$N" HIR "的杀招如泥牛入海，消弭无形！\n" NOR]);
                        break;
                }

                return result;
        }
}

mapping query_action(object me, object weapon)
{
	int i, level;
	mapping act;

	level = me->query_skill("zhemei-shou",1);

	// 只有灵鹫宫弟子才能使用新招式
	if (me->query("family/family_name") == "灵鹫宫")
	{
		for(i = sizeof(action); i > 0; i--)
			if(level > action[i-1]["lvl"])
			{
				act = copy(action[NewRandom(i, 20, level/5)]);
				return act;
			}
	}
	else
	{
		// 非灵鹫宫弟子无法使用新招式
		for(i = sizeof(action) - 2; i > 0; i--)
			if(level > action[i-1]["lvl"])
			{
				act = copy(action[NewRandom(i, 20, level/5)]);
				return act;
			}
	}
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 70)
		return notify_fail("你的内力不够练天山落梅手。\n");

	me->receive_damage("qi", 65);
	me->add("neili", -62);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"zhemei-shou/" + action;
}
string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}
//等级提升，是否学会新的招式
string query_skill_up(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
	 {
		if(level == action[i]["lvl"])
		 {
		     return action[i]["skill_name"];
		 }
	 }
	  return "no";
}


string query_description()
{
    string msg;

    msg = HIY "【天山折梅手】" ZJBR NOR;
    msg += WHT "天山折梅手是灵鹫宫的绝顶手法，手法之中包含了诸般拳法、掌法、抓法、擒拿法、点穴法等功夫，" ZJBR;
    msg += WHT "变化繁复，精微奥妙，讲究以巧破力，料敌机先。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  须空手。" ZJBR;
    msg += "  最大内力 不低于 " HIB "900" NOR " 点。" ZJBR;
    msg += "  基本内功 等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "  基本手法 等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "  基本手法 等级不低于 基本折梅手 等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  手法 (hand)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR;
    msg += "  可与 天山六阳掌 (liuyang-zhang) 互备。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  当前气血 不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  当前内力 不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗 气血 " HIR "65" NOR " 点，内力 " HIB "62" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  招架卸力 (仅限灵鹫宫弟子)：" ZJBR;
    msg += "    触发条件：当前内力 不低于 (受到伤害 / 5) 点。" ZJBR;
    msg += "    判定几率：(对方内功有效激发 / 2 + 随机(对方内功有效激发)) < 自身招架有效激发 时判定成功。" ZJBR;
    msg += "    判定成功效果：消耗 内力 (受到伤害 / 5) 点，完全抵消本次受到的伤害。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;

    msg += HIC "  折梅式 (zhe)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      有效折梅手 等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      基本内功 等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：(自身手法有效激发 / 2 + 随机(自身手法有效激发)) > 对方招架有效激发 时命中。" ZJBR;
    msg += "      命中效果：使目标『忙乱』。" ZJBR;
    msg += "      忙乱时间：(自身手法有效激发 / 30 + 2) 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "70" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "1" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  夺兵式 (duo)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      有效折梅手 等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      基本内功 等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "      目标必须持有武器。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      成功判定：(自身手法有效激发 / 2 + 随机(自身手法有效激发)) > (对方招架有效激发 * 3 / 2) 时成功。" ZJBR;
    msg += "      成功效果：夺取目标手中的武器。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  九部式 (jiubu)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      有效折梅手 等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "      基本内功 等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 不低于 " HIB "150" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      连续对目标攻击 7 次。" ZJBR;
    msg += "      单次命中判定：(自身手法有效激发 / 2 + 随机(自身手法有效激发)) > (对方轻功有效激发 / 2 + 随机(对方轻功有效激发 / 2)) 时命中。" ZJBR;
    msg += "      单次命中伤害：(有效折梅手等级 * (100 + 自身后天膂力 + 自身后天膂力 / 2 - 20) / 100) 点。" ZJBR;
    msg += "      附加效果：若目标 当前气血 < 最大气血 / 5，且 随机(自身手法有效激发) > 对方经验 / 1000，可能打掉目标兵器。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  风华绝代 (fenghua)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      有效折梅手 等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      基本内功 等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力 不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标造成伤害 (有效折梅手等级 * 2) 点。" ZJBR;
    msg += "      附加效果：若目标 当前气血 < 有效气血 / 2 且未中『冰冻』状态，则使目标陷入『冰冻』状态。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  落英缤纷 (luoying)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      有效折梅手 等级不低于 " HIY "160" NOR " 级。" ZJBR;
    msg += "      基本内功 等级不低于 " HIY "160" NOR " 级。" ZJBR;
    msg += "      当前内力 不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标造成伤害 (有效折梅手等级 * 3) 点。" ZJBR;
    msg += "      附加效果：若目标未处于『忙乱』状态，则使目标陷入『忙乱』状态。" ZJBR;
    msg += "      忙乱时间：(有效折梅手等级 / 40) 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "3" NOR " 秒。" ZJBR;

    return msg;
}

