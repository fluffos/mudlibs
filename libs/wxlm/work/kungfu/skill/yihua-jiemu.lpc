inherit SKILL;

string *parry_msg = ({
	"$N一招击在$n身上，却被$n暗运移花接木，将内力尽数移入地下。\n",
	"$n轻轻一带，$N发现自己招数回击过来，吓得往后倒退几步。\n",
        "$n手臂回转，在$N手肘下轻轻一推，$N招数落空。\n",
        "$n右手伸出，在$N手腕上轻轻一拉，$N收势不住，直往前扑去。\n",
        "$n身形不动，$N一招击下，有如石沉大海，不觉呆住了。\n",
	"$n左牵右引，$N如身处漩流，连续转了好几个圈。\n",
	"$n双手回圈，$N只觉得前面好象有一堵墙，再也攻不进去。\n",
	"$n轻轻一转，$N一招击在地上，只打得尘土飞扬。\n",
});

string *dodge_msg = ({
	"$N一招击在$n身上，却被$n暗运移花接木，将内力尽数移入地下。\n",
	"$n轻轻一带，$N发现自己招数回击过来，吓得往后倒退几步。\n",
        "$n手臂回转，在$N手肘下轻轻一推，$N招数落空。\n",
        "$n右手伸出，在$N手腕上轻轻一拉，$N收势不住，直往前扑去。\n",
        "$n身形不动，$N一招击下，有如石沉大海，不觉呆住了。\n",
	"$n左牵右引，$N如身处漩流，连续转了好几个圈。\n",
	"$n双手回圈，$N只觉得前面好象有一堵墙，再也攻不进去。\n",
	"$n轻轻一转，$N一招击在地上，只打得尘土飞扬。\n",
});

int valid_enable(string usage) 
{ 
    return (usage == "parry") || (usage == "dodge");
}

string query_parry_msg(string limb)
{
       return parry_msg[random(sizeof(parry_msg))];
}

string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

int valid_teach(object me)
{
         if ((int)me->query_skill("yihua-jiemu", 1) > 1)
                return notify_fail("移花接木乃移花宫宫主所创,向来不传男子。\n");
return 1;
 }



int valid_learn(object me)
{
        int lvl = (int)me->query_skill("yihua-jimu", 1);

        if ( !wizardp(this_player()) && (me->query("family/family_name") != "移花宫"))
                return notify_fail("你不是移花宫弟子不能使用冥雨神功.\n
                                    移花接木博大精深, 非移花宫弟子不传, 真不知道你是怎么学会的!\n
                                    要是让两位宫主知道了你可惨了.\n");



        if ( me->query("gender") != "女性")
            return notify_fail("移花接木乃移花宫宫主所创,向来不传男子。\n");

		if ((int)me->query_skill("mingyu-shengong", 1) < 120)
            return notify_fail("你的冥雨神功还不到家怎么能学移花接木呢？\n");

		if ((int)me->query_skill("force", 1) < 100)
            return notify_fail("就这么点基本内功还想学移花接木？\n");
		
		if ((int)me->query_skill("parry", 1) < (int)me->query_skill("yihua-jiemu", 1))
            return notify_fail("招架等级小于移花接木，无法继续学习。\n");
		
		if ((int)me->query_skill("dodge", 1) < (int)me->query_skill("yihua-jiemu", 1))
            return notify_fail("轻功等级小于移花接木，无法继续学习。\n");

		if ((int)me->query("max_neili", 1) < 550)
			return notify_fail("就这么点内力还想学移花接木？\n");

        if ((int)me->query_skill("force", 1) < lvl)
            return notify_fail("你的基本内功火候还不够，小心走火入魔！\n");

        return 1;
}

/**
 * @brief 移花接木伤害化解函数
 * @param object ob 攻击者
 * @param object me 防御者
 * @param int damage 伤害值
 * @param object weapon 武器对象
 * @return mixed 返回化解结果
 * @details 移花接木的精髓在于借力打力，将敌人的攻击力量化解或反弹
 */
mixed valid_damage(object ob, object me, int damage, object weapon)
{
	mixed result;
	int ap, dp, mp;

	if ((int)me->query_skill("yihua-jiemu", 1) < 100 ||
	    ! living(me))
		return;

	mp = ob->query_skill("count", 1);
	ap = ob->query_skill("force") + mp;
	dp = me->query_skill("parry") / 2 + me->query_skill("yihua-jiemu", 1);


	// 如果我是npc并且不是移花宫宫主,dp 减少一半
	if (!playerp(me) && me->query("id") != "yaoyue" && me->query("id") != "lianxing")
	{
		dp = dp / 2;
	}

	if (ap / 2 + random(ap) < dp)
	{
		result = ([ "damage": -(damage * 3 / 4) ]);

		switch (random(3))
		{
		case 0:
			result += (["msg" : HIC "$n" HIC "轻舒玉手，暗运移花接木，"
					    "将$N" HIC "的攻击力量尽数导入地下。"NOR"\n"]);
			break;

		case 1:
			result += (["msg" : HIC "$n" HIC "身形微动，巧妙地引导$N"
					    HIC "的攻势，化解于无形之中。"NOR"\n"]);
			break;

		default:
			result += (["msg" : HIC "$n" HIC "施展移花接木绝技，"
					    HIC "$N的招式如石沉大海，再无威力。"NOR"\n"]);
			break;
		}
		return result;
	} else
	if (mp >= 100)
	{
		switch (random(3))
		{
		case 0:
			result = HIY "$n" HIY "施展移花接木，试图引导$N的攻势，"
				 "然而$N" HIY "攻势凌厉，直接破解了$n"
				 HIY "的卸力手法！"NOR"\n";
			break;

		case 1:
			result = HIY "$n" HIY "暗运移花接木心法，欲将攻击化解，"
				 "可是$N" HIY "招式变化莫测，不按常理出招。"NOR"\n";
			break;

		default:
			result = HIY "$n" HIY "轻舒玉手，试图借力打力，"
				 HIY "但$N" HIY "立刻察觉，"
				 HIY "变招疾攻，破解了$n"
				 HIY "的移花接木！"NOR"\n";
			break;
		}
		COMBAT_D->set_bhinfo(result);
	}
}

string query_description()
{
    string msg;

    msg = HIY "【移花接木】" ZJBR NOR;
    msg += WHT "移花接木乃移花宫不传之密，是一种奇妙无比的轻功身法与卸力招架之术。" ZJBR;
    msg += WHT "此功夫讲究以柔克刚，以巧取胜，善于借力打力、引敌自毙。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  门派限制：移花宫弟子专属" ZJBR;
    msg += "  性别要求：女性" ZJBR;
    msg += "  基本内功等级：" HIY "100" NOR " 级" ZJBR;
    msg += "  冥雨神功等级：" HIY "120" NOR " 级" ZJBR;
    msg += "  基本招架等级：不低于移花接木等级" ZJBR;
    msg += "  基本轻功等级：不低于移花接木等级" ZJBR;
    msg += "  最大内力上限：" HIY "550" NOR " 点" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  招架 (parry)" ZJBR;
    msg += "  轻功 (dodge)" ZJBR ZJBR;

    msg += HIY "〖绝技特点〗" ZJBR NOR;
    msg += "  移花接木擅长引导对手的攻击力量，将其化解或反弹。" ZJBR;
    msg += "  战斗中能够巧妙地避开攻击，或将敌人的内力导入地下。" ZJBR;
    msg += "  能够使攻击者的招式反击向自己，迷惑敌人的进攻路线。" ZJBR;
    msg += "  当移花接木等级达到100级时，可发挥伤害化解功能。" ZJBR;
    msg += "  通过借力打力的精妙手法，能够化解大部分攻击伤害。" ZJBR ZJBR;

    msg += HIY "〖防御特效机制〗" ZJBR NOR;
    msg += "  触发条件：移花接木等级 ≥ 100级 且 处于存活状态" ZJBR;
    msg += "  判定公式：当 (攻击力/2 + 随机值) < 防御力 时，防御成功" ZJBR;
    msg += "  攻击力计算：内功激发等级 + 阴阳八卦技能等级" ZJBR;
    msg += "  防御力计算：招架激发等级/2+ 移花接木等级" ZJBR;
    msg += "  成功效果：化解 " HIY "75%" NOR " 的攻击伤害" ZJBR;
    msg += "  失败条件：当攻击者计数技能 ≥ 100级时，可能破解防御" ZJBR;
    msg += "  NPC调整：普通NPC防御力减半，移花宫宫主保持完整防御力" ZJBR ZJBR;

    msg += HIY "〖注意事项〗" ZJBR NOR;
    msg += "  1. 此技能为移花宫独传绝技，只传授给女弟子。" ZJBR;
    msg += "  2. 须熟练掌握冥雨神功才能修炼此技能。" ZJBR;
    msg += "  3. 学习时基本内功等级必须不低于移花接木等级，否则有走火入魔的危险。" ZJBR;
    msg += "  4. 防御特效具有随机性，实力相近时胜负难料。" ZJBR;
    msg += "  5. 高等级的计数技能可以破解移花接木的防御。" ZJBR;

    return msg;
}
