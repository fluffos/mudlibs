// staff.c
// modified by Venus Oct.1997
inherit SKILL;

string query_description()
{
    string msg;

    msg = HIY "【基本杖法】" ZJBR NOR;
    msg += "所有杖法的总称，为学习更高级杖法的基础。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  无特殊要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  杖法（staff）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  通常通过练习高级杖法或请教来提升。" ZJBR ZJBR; // 基础技能一般不直接练习

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR;

    return msg;
}

