int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 350)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("force") < 50)
		return notify_fail("你的基本内功火候太浅。\n");

	if ((int)me->query_skill("blade", 1) < (int)me->query_skill("wuhu-duanmendao", 1))
		return notify_fail("你的基本刀法火候有限，无法领会更高深的五虎断门刀法。\n");

	return 1;
}

string query_skill_name(int level)
{
    	int i;
    	for (i = sizeof(action) - 1; i >= 0; i--)
		if (level >= action[i]["lvl"])
	    		return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    	int i, level;
    	level = (int) me->query_skill("wuhu-duanmendao", 1);
    	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
	    		return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "blade")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力不够练五虎断门刀法。\n");

	if ((int)me->query("neili") < 30)
		return notify_fail("你的体力不够练五虎断门刀法。\n");

	me->receive_damage("qi", 30);
	me->add("neili", -18);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"wuhu-duanmendao/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【五虎断门刀】" ZJBR NOR;
    msg += "五虎断门刀是一门威力强大的刀法，招式大开大合，以快速凌厉著称。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本刀法等级需大于等于五虎断门刀等级。" ZJBR;
    msg += "  基本内功等级需达到 " HIY "50" NOR " 级。" ZJBR;
    msg += "  内力修为需达到 " HIB "350" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  刀法（blade）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  持刀。" ZJBR;
    msg += "  气血：不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "30" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "30" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "18" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖招式详解〗" ZJBR NOR;
    msg += "  五虎断门刀共有十一式，依次为：" ZJBR;
    msg += "  直来直去（入门）、壁上挂画（10级）、推窗望月（20级）、" ZJBR;
    msg += "  力劈华山（30级）、临溪观鱼（40级）、张弓望的（50级）、" ZJBR;
    msg += "  风送轻舟（60级）、川流不息（70级）、壮士断腕（80级）、" ZJBR;
    msg += "  人头落地（90级）、断子绝孙（100级）。" ZJBR ZJBR;
    
    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  断字诀 (duan)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      五虎断门刀等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      持刀。" ZJBR;
    msg += "      激发刀法为五虎断门刀。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      使用者伏地前滚，快速连续发起三次攻击。" ZJBR;
    msg += "      攻击次数与使用者基础攻击数量相同，由COMBAT_D->query_base_attack_number()决定。" ZJBR;
    msg += "      每次攻击的命中率与使用者的常规攻击相同。" ZJBR;
    msg += "      每次攻击的伤害与使用者的常规攻击相同。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力消耗 " HIB "150" NOR " 点。" ZJBR;
    msg += "      使用后忙乱 " HIR "1-3" NOR " 秒。" ZJBR;

    return msg;
}

