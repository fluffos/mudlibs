// This program is a part of NITAN MudLIB

inherit SKILL;

string *dodge_msg = ({
        "$n一声长笑，冲天而起，竟能凌空旋，堪堪避过$N的攻击，往另一个方向投去！\n",
        "$N攻向$N时，$n看似要凌空迎战，岂知竟像蝙蝠般旋避开，予人吻合天地大道的感觉。\n",
        "$n身躯后仰，险险避开$N的攻击，再斜飞而起，往远处投去，姿态美至极点。\n",
        "$n好像化成一缕没有重量的轻烟，随呼呼吹来的轻风飘移晃动，每一刻都不断变换位置。\n",
});

int valid_enable(string usage) { return usage == "dodge"; }

int valid_learn(object me) { return 1; }

string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
        if ((int)me->query("qi") < 50)
                return notify_fail("你的体力太差了，不能练魔神步法。\n");
        if ((int)me->query("neili") < 50)
                return notify_fail("你的内力不够。\n");
        me->receive_damage("qi", 40);
        me->add("neili", -40);
        return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【魔神步法】" ZJBR NOR;
    msg += "一种极为灵动飘逸的身法，变幻莫测，难以捉摸。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  无特殊要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  轻功 (`dodge`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  气血不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  内力不低于 " HIB "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "40" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "40" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR;

    return msg;
}



