inherit SKILL;

string query_description()
{
    string msg;

    msg = HIY "【妙手空空】" ZJBR NOR;
    msg += "偷窃他人财物的基本技能，影响偷窃成功率和所能偷窃物品的价值。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  无特殊要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  轻功（dodge）或 特殊（special）。（具体取决于游戏设定）" ZJBR ZJBR; // 偷窃技能激发类型不固定

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  通常通过实际偷窃或特殊任务提升。" ZJBR ZJBR; // 基础技能一般不直接练习

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR;

    return msg;
}

