// zixia-shengong.c 紫霞神功
// By Hop

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_force(string force) { return force == "huashan-xinfa"; }

int query_neili_improve(object me)
{
	int lvl;

	lvl = (int)me->query_skill("zixia-shengong", 1);
	return lvl * lvl * 15 * 15 / 100 / 200;
}

int valid_learn(object me)
{
	if (me->query("gender") == "无性" &&
	    (int)me->query_skill("zixia-shengong", 1) > 49)
		return notify_fail("你无根无性，阴阳不调，难以领会高深的紫霞神功。\n");

	if ((int)me->query_skill("force", 1) < 60)
		return notify_fail("你的基本内功火候还不够，还不能学习紫霞神功。\n");

	return ::valid_learn(me);
}

int practice_skill(object me)
{
	return notify_fail("紫霞神功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"zixia-shengong/" + func;
}

string query_description()
{
    string msg;

    msg = HIM "【紫霞神功】" ZJBR NOR;
    msg += WHT "紫霞神功乃华山派镇派内功心法，以正大光明、气势恢宏著称。" ZJBR;
    msg += WHT "修炼此功能够大幅提升内力上限，并可运起紫霞真气护体。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功 等级不低于 " HIY "60" NOR " 级。" ZJBR;
    msg += "  性别要求：非 无性 (当 紫霞神功 等级 > 49 时)。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功 (force)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  紫霞神功 只能通过学习 (learn) 提升，无法练习 (practice)。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  提升内力上限：提升值为 (" HIM "紫霞神功等级" NOR " * " HIM "紫霞神功等级" NOR " * 15 * 15 / 100 / 200) 点。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIM "  紫霞真气 (powerup)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      紫霞神功 已激发为内功。" ZJBR;
    msg += "      当前内力 不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      临时增加自身 攻击力 (" HIM "有效紫霞神功等级 / 3" NOR ") 点。" ZJBR;
    msg += "      临时增加自身 防御力 (" HIM "有效紫霞神功等级 / 3" NOR ") 点。" ZJBR;
    msg += "      获得「" HIM "紫霞真气" NOR "」状态，持续 " HIY "有效紫霞神功等级 / 2" NOR " 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "3" NOR " 秒。" ZJBR;

    return msg;
}