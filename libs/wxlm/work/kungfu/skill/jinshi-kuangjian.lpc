// This program is a part of NITAN MudLIB

inherit SKILL;

mapping *action = ({
([      "action": "$N身行不住的飘动，手中$w幻起道道寒光，一招「狮啸苍天」刺向$n",
        "force" : 126,
        "parry" : 3,
        "dodge" : 5,
        "damage": 21,
        "lvl"   : 0,
        "skill_name" : "狮啸苍天",
        "damage_type":  "刺伤"
]),
([      "action": "$N身行突然变了数个变化，手中$w也随之变化，一招「金狮裂地」刺向$n的$l",
        "force" : 149,
        "parry" : 13,
        "dodge" : 10,
        "damage": 25,
        "lvl"   : 30,
        "skill_name" : "金狮裂地",
        "damage_type":  "割伤"
]),
([      "action": "$N抽身后退，一招「王者无情」,$w向波浪般的刺向$n的致命之处",
        "force" : 167,
        "parry" : 12,
        "dodge" : 15,
        "damage": 31,
        "lvl"   : 50,
        "skill_name" : "王者无情",
        "damage_type":  "刺伤"
]),
([      "action": "$N身行忽坐忽右，手中$w忽上忽下，一招「狮王怒吼」攻向$n的$l",
        "force" : 187,
        "parry" : 23,
        "dodge" : 19,
        "damage": 45,
        "lvl"   : 70,
        "skill_name" : "狮王怒吼",
        "damage_type":  "割伤"
]),
});

int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me)
{
        if ((int)me->query("int") < 50)
                return notify_fail("你研究了半天，只觉得悟性有些差，始终无法理解其中的真谛。\n");

        if (me->query_skill("force") < 120)
                return notify_fail("你的内功火候不够，不能学习金狮狂剑。\n");

        if (me->query_skill("sword", 1) < 80)
                return notify_fail("你的基本剑法火候不够，不能学习金狮狂剑。\n");

        if (me->query("max_neili") < 1000)
                return notify_fail("你的内力不够，不能学习金狮狂剑。\n");

        if ((int)me->query_skill("sword", 1) < (int)me->query_skill("jinshi-kuangjian", 1))
                return notify_fail("你的基本剑法水平有限，无法领会更高深的金狮狂剑。\n");

        return 1;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
        int i, level;
        level = (int) me->query_skill("jinshi-kuangjian",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
        object weapon;

        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
                return notify_fail("你使用的武器不对。\n");

        if ((int)me->query("qi") < 80)
                return notify_fail("你的体力不够练金狮狂剑。\n");

        if ((int)me->query("neili") < 80)
                return notify_fail("你的内力不够练金狮狂剑。\n");

        me->receive_damage("qi", 60);
        me->add("neili", -60);
        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"jinshi-kuangjian/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【金狮狂剑】" ZJBR ZJBR NOR;
    msg += WHT "一套威猛霸道的剑法，招式大开大阖，剑势狂放不羁。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  先天悟性 (int) " HIY "50" NOR " 点。" ZJBR;
    msg += "  基本内功 (force) 等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "  基本剑法 (sword) 等级 " HIY "80" NOR " 级。" ZJBR;
    msg += "  最大内力 " HIB "1000" NOR " 点。" ZJBR;
    msg += "  基本剑法 (sword) 等级不低于金狮狂剑等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  剑法 (sword)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须装备剑类武器。" ZJBR;
    msg += "  气血：不低于 " HIR "80" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "80" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "60" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  狂剑 (kuang)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      金狮狂剑等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "250" NOR " 点。" ZJBR;
    msg += "      必须装备剑类武器，且激发金狮狂剑为剑法。" ZJBR;
    msg += "      必须在战斗中使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标发动一次强力攻击。" ZJBR;
    msg += "      命中判定：基于双方的剑法激发等级和招架激发等级 (`通用命中公式`)。" ZJBR;
    msg += "      命中效果：造成基于自身剑法激发等级的伤害，附加固定 65 点伤害。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力 " HIB "150" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "60" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 招式伤害和命中受双方攻防技能影响。
";

    return msg;
}

