// 函数声明
mixed hit_ob(object me, object victim, int damage_bonus);

// 判断技能是否可用
int valid_enable(string usage)
{
    return usage == "sword" || usage == "parry";
}

// 判断技能是否可学
int valid_learn(object me)
{
    // 变量声明
    mapping skills;
    string *skill_names;
    int sword_count = 0;
    int i;

    if (me->query("level") < 100)
    {
        tell_object(me, HIR "你的等级不足，无法领悟「百步飞剑」的奥秘。" NOR "\n");
        return 0;
    }

    skills = me->query_skills();
    if (!mapp(skills))
    {
        tell_object(me, HIR "你还没有学会任何技能，无法领悟「百步飞剑」。" NOR "\n");
        return 0;
    }

    skill_names = keys(skills);
    for (i = 0; i < sizeof(skill_names); i++)
    {
        if (SKILL_D(skill_names[i])->valid_enable("sword") && skills[skill_names[i]] >= 400)
        {
            sword_count++;
        }
    }

    if (sword_count < 6)
    {
        tell_object(me, HIR "你需要精通（400级）至少六门剑法，才能领悟「百步飞剑」的精髓。" NOR "\n");
        return 0;
    }

    return 1;
}

// 练习技能
int practice_skill(object me)
{
    // 变量声明
    object weapon;
    int cost;
    mapping skills;
    string *skill_names;
    int sword_count = 0;
    int i;

    if (!objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "sword")
    {
        tell_object(me, HIR "你需要持剑才能练习「百步飞剑」。" NOR "\n");
        return 0;
    }

    if ((int)me->query("qi") < 300)
    {
        tell_object(me, HIR "你的气血不足，无法练习「百步飞剑」。" NOR "\n");
        return 0;
    }

    cost = me->query_skill("genie_baibufeijian", 1) + 100;
    if ((int)me->query("neili") < cost)
    {
        tell_object(me, HIR "你的内力不足，无法练习「百步飞剑」。" NOR "\n");
        return 0;
    }

    skills = me->query_skills();
    skill_names = keys(skills);
    for (i = 0; i < sizeof(skill_names); i++)
    {
        if (SKILL_D(skill_names[i])->valid_enable("sword") && skills[skill_names[i]] >= 400)
        {
            sword_count++;
        }
    }

    if (sword_count < 6)
    {
        tell_object(me, HIR "你需要精通（400级）至少六门剑法，才能练习「百步飞剑」。" NOR "\n");
        return 0;
    }

    tell_object(me, HIC "你凝神静气，手中" + weapon->name() + HIC "化作千万道流光，剑气纵横天地，练习着「百步飞剑」的奥义。" NOR "\n");

    me->receive_damage("qi", 250);
    me->add("neili", -cost);

    return 1;
}

// 战斗中特效函数
mixed hit_ob(object me, object victim, int damage_bonus)
{
    // 变量声明
    int lvl;
    int extra_damage;
    string msg;

    // 变量初始化
    lvl = me->query_skill("genie_baibufeijian", 1);
    extra_damage = lvl + random(lvl);

    if (random(100) < 40)
    {
        victim->receive_wound("qi", extra_damage, me);
        msg = HIW "$N" HIW "剑势如虹，低吟" HIG "「剑气纵横三万里」" HIW "，" HIC "「百步飞剑」" HIW "瞬息而至，$n" HIW "只觉全身一阵剧痛，" HIR "鲜血飞溅" HIW "！" NOR "\n";
        return msg;
    }
    else if (random(100) < 30)
    {
        if (! victim->is_busy())
        {
            victim->start_busy(2 + random(2));
        }
        msg = HIM "$N" HIM "轻吟" HIG "「凤舞九天银河倾」" HIM "，施展「百步飞剑」，" HIW "剑影重重" HIM "，$n" HIM "目眩神迷，一时间竟不知如何应对！" NOR "\n";
        return msg;
    }
    else if (random(100) < 20)
    {
        msg = HIY "$N" HIY "长啸" HIG "「剑在手兮问苍天」" HIY "，气贯长虹，剑锋所至，" HIR "天地失色" HIY "，$n" HIY "被其气势所摄，攻势大减！" NOR "\n";
        victim->add_temp("apply/attack", -lvl / 5);
        victim->add_temp("apply/defense", -lvl / 5);
        call_out("remove_effect", 10, victim, lvl / 5);
        return msg;
    }

    return;
}

// 移除效果
void remove_effect(object victim, int amount)
{
    if (victim)
    {
        victim->add_temp("apply/attack", amount);
        victim->add_temp("apply/defense", amount);
        tell_object(victim, HIG "你感觉周身一轻，剑气的压制终于消散了。" NOR "\n");
    }
}

// 技能的使用文件路径
string perform_action_file(string action)
{
    return __DIR__"genie_baibufeijian/" + action;
}

// 查询技能名称
string query_skill_name(int level)
{
    int i;
    for (i = sizeof(action) - 1; i >= 0; i--)
        if (level >= action[i]["lvl"])
            return action[i]["skill_name"];
}

// 查询技能动作
mapping query_action(object me, object weapon)
{
    int i, level;
    level = (int)me->query_skill("genie_baibufeijian", 1);
    for (i = sizeof(action); i > 0; i--)
        if (level > action[i-1]["lvl"])
            return action[NewRandom(i, 20, level/5)];
}

// 技能描述
string query_description()
{
    string msg;

    msg = HIY "【百步飞剑】" ZJBR NOR; // 基本介绍
    msg += WHT "盖聂绝世剑技，身怀「百步飞剑」，剑气纵横，百步之内，取敌首级如探囊取物。" ZJBR;
    msg += WHT "此剑法讲究速度与气势，剑随心动，变化莫测，令人防不胜防。" ZJBR;
    msg += WHT "更有诗词吟诵，剑法与文采并重，尽显绝世风采。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  人物等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "  精通（基本等级 " HIY "400" NOR " 级以上）至少 " HIY "六" NOR " 门剑法类技能。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  剑法（sword）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  必须装备剑类武器。" ZJBR;
    msg += "  气血不低于 " HIR "300" NOR " 点。" ZJBR;
    msg += "  内力不低于 (百步飞剑基本等级 + " HIB "100" NOR ") 点。" ZJBR;
    msg += "  精通（基本等级 " HIY "400" NOR " 级以上）至少 " HIY "六" NOR " 门剑法类技能。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "250" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：(百步飞剑基本等级 + " HIB "100" NOR ") 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // hit_ob
    msg += "  攻击命中时概率触发以下效果：" ZJBR;
    msg += "    效果一 (40% 概率)：" HIG "「剑气纵横三万里」" NOR ZJBR;
    msg += "      对目标造成额外气血内伤，伤害值约为 (百步飞剑基本等级 + 随机(百步飞剑基本等级))。" ZJBR;
    msg += "    效果二 (触发效果一失败后 30% 概率)：" HIM "「凤舞九天银河倾」" NOR ZJBR;
    msg += "      使目标进入忙乱状态，持续时间为 (2 + 随机(2)) 秒。" ZJBR;
    msg += "    效果三 (触发效果一、二失败后 20% 概率)：" HIY "「剑在手兮问苍天」" NOR ZJBR;
    msg += "      降低目标攻击力和防御力，降低值约为 (百步飞剑基本等级 / 5)，持续 " HIY "10" NOR " 秒。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (剑法绝招 perform)〗" ZJBR NOR;
    msg += HIC "  九天剑歌 (jiutian_jiange)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      百步飞剑基本等级不低于 " HIY "220" NOR " 级。" ZJBR;
    msg += "      基本内功等级不低于 " HIY "220" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "400" NOR " 点。" ZJBR;
    msg += "      必须装备剑类武器。" ZJBR;
    msg += "      自身不处于忙乱状态。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标造成一次强力伤害。" ZJBR;
    msg += "      伤害计算：基础伤害约为 ((剑法激发等级 + 内功激发等级) + 随机((剑法激发等级 + 内功激发等级) / 2))。" ZJBR;
    msg += "      命中后使目标进入忙乱状态 " HIR "4" NOR " 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIM "  千里追魂 (qianli_zhuihun)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      百步飞剑基本等级不低于 " HIY "200" NOR " 级。" ZJBR;
    msg += "      基本轻功等级不低于 " HIY "200" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "      必须装备剑类武器。" ZJBR;
    msg += "      自身不处于忙乱状态。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标发动连续攻击 (5 至 7 次)。" ZJBR;
    msg += "      每次攻击伤害计算：基础伤害约为 ((剑法激发等级 + 轻功激发等级) + 随机((剑法激发等级 + 轻功激发等级) / 2))。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "  绝世神剑 (jueshi_shenjian)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      百步飞剑基本等级不低于 " HIY "250" NOR " 级。" ZJBR;
    msg += "      基本内功等级不低于 " HIY "250" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "800" NOR " 点。" ZJBR;
    msg += "      必须装备剑类武器。" ZJBR;
    msg += "      自身不处于忙乱状态。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标发动毁灭性的连续攻击 (5 至 9 次)。" ZJBR;
    msg += "      每次攻击伤害计算：基础伤害约为 ((剑法激发等级 + 内功激发等级) + 随机((剑法激发等级 + 内功激发等级) / 2))。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "400" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "4" NOR " 秒。" ZJBR;

    return msg;
}
