// hanshou.c 寒冰护体

inherit F_CLEAN_UP;

void remove_effect(object me);

string query_name() { return "寒冰"ZJBR"护体"; }
string *pfm_type() { return ({ "force", }); }

int exert(object me, object target)
{
    int skill;

    if (target != me)
        return notify_fail("你只能用冷月神功来提升自己的防御力。\n");

    if ((int)me->query("neili") < 500)
        return notify_fail("你的内力不够！\n");

    if ((int)me->query_temp("hanshou"))
        return notify_fail("你已经在运功中了。\n");

    skill = me->query_skill("lengyue-shengong");

    me->add("neili", -400);
    me->receive_damage("qi", 0);

    message_combatd(HIB "$N" HIB "运起冷月神功，全身被一层寒冰所覆盖，看起来异常坚固！"NOR"\n", me);

    me->add_temp("apply/armor", skill);
    me->set_temp("hanshou", 1);

    me->start_call_out((: call_other, __FILE__, "remove_effect", me :), skill / 2);

    if (me->is_fighting()) me->start_busy(2);
    return 1;
}

void remove_effect(object me)
{
    int skill;

    skill = me->query_skill("lengyue-shengong");
    if ((int)me->query_temp("hanshou"))
    {
        me->add_temp("apply/armor", -skill);
        me->delete_temp("hanshou");
        tell_object(me, "你的寒冰护体运行完毕，身体恢复正常。\n");
    }
}
