// begging.c 丐帮绝技
// Modified by Venus Oct.1997

inherit SKILL;

string query_description()
{
    string msg;

    msg = "";
    msg += HIY "【丐帮乞讨绝技】" ZJBR ZJBR NOR;
    msg += WHT "丐帮乞讨绝技是丐帮独门的生存技能，以其巧妙多变、令人捉摸不透而闻名。" ZJBR;
    msg += "此技能融合了察言观色、言语技巧和身法灵活等多方面的精髓，是丐帮弟子的必修之术。" ZJBR ZJBR;
    msg += HIY "【技能要求】" ZJBR NOR;
    msg += "  无特殊要求，丐帮弟子均可学习" ZJBR ZJBR;
    msg += HIY "【技能效果】" ZJBR NOR;
    msg += "  可用于乞讨获取金钱和食物" ZJBR;
    msg += "  提高在城镇中的生存能力" ZJBR ZJBR;
    msg += HIY "【特殊功能】" ZJBR NOR;
    msg += HIW "1. 乞讨（beg）：" ZJBR NOR;
    msg += "  要求：乞讨技能20级" ZJBR;
    msg += "  效果：向NPC乞讨金钱或食物，成功率与乞讨技能等级相关" ZJBR;
    msg += "  描述：运用丐帮独特的乞讨手法，令人不忍拒绝" ZJBR ZJBR;
    msg += HIW "2. 装可怜（pitiful）：" ZJBR NOR;
    msg += "  要求：乞讨技能50级" ZJBR;
    msg += "  效果：增加乞讨成功率，但可能引起部分NPC反感" ZJBR;
    msg += "  描述：摆出楚楚可怜的姿态，激发他人同情心" ZJBR ZJBR;
    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 乞讨技能虽然可以获取资源，但过度使用可能影响江湖声誉。" ZJBR;
    msg += "2. 在不同的场合使用不同的乞讨方式，可以提高成功率。" ZJBR;
    msg += "3. 乞讨技能是丐帮弟子的标志之一，使用时要谨记丐帮规矩。\n";

    return msg;
}
