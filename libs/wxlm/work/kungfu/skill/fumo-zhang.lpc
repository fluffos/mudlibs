int valid_enable(string usage) { return usage == "staff" || usage == "parry"; }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 300)
		return notify_fail("你的内力不够，无法学习二十四路伏魔杖。\n");

	if ((int)me->query_skill("force") < 60)
		return notify_fail("你的内功火候太浅，无法学习二十四路伏魔杖。\n");

	if ((int)me->query_skill("staff", 1) < (int)me->query_skill("fumo-zhang", 1))
		return notify_fail("你的基本杖法水平有限，无法领会更高深的二十四路伏魔杖。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action)-1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("fumo-zhang",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "staff")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力不够练二十四路伏魔杖。\n");

	if ((int)me->query("neili") < 70)
		return notify_fail("你的内力不够练二十四路伏魔杖。\n");

	me->receive_damage("qi", 65);
	me->add("neili", -68);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"fumo-zhang/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【二十四路伏魔杖】" ZJBR NOR;
    msg += WHT "少林寺的杖法，招式凌厉多变，攻势威猛。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "  基本内功等级不低于 " HIY "60" NOR " 级。" ZJBR;
    msg += "  基本杖法等级需大于等于二十四路伏魔杖等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  杖法（staff）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  装备类型为杖（staff）的武器。" ZJBR;
    msg += "  气血不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "65" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "68" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (杖法绝招 perform)〗" ZJBR NOR;
    msg += HIC "  风火轮 (lun)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      二十四路伏魔杖基本等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      基本内功等级不低于 " HIY "200" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "      激发杖法为二十四路伏魔杖。" ZJBR;
    msg += "      需要习得此招 (\"can_perform/fumo-zhang/lun\")。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：使用 `通用命中公式`。" ZJBR;
    msg += "        攻击力(AP) 取决于使用者杖法激发等级。" ZJBR;
    msg += "        防御力(DP) 取决于目标招架激发等级。" ZJBR;
    msg += "      命中后对目标造成伤害。" ZJBR;
    msg += "        伤害值约为：(杖法激发等级 + 随机(杖法激发等级 / 2))。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力 " HIB "200" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "80" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;

    return msg;
}