// /kungfu/skill/yinlv.c

inherit SKILL;


int help(object me)
{
    write(@HELP
音律

音律是一种基础知识技能，是学习和精通各种琴法的基础。
精通音律可以提高你在使用琴法时的效果，并且是学习高深
琴法的必要条件。

学习要求：
    悟性 24 点

特殊说明：
    音律只能通过学习来提高，无法通过练习增长。
    音律等级上限为你当前悟性的八倍。

HELP
    );
    return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【音律】" ZJBR NOR;
    msg += WHT "对音乐韵律的理解和掌握能力，是学习和施展各种琴法类武学的基础。" ZJBR ZJBR; // 基本介绍

    // 学习要求来自 help() 函数内容推断
    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  先天悟性 ≥ " HIY "24" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  知识类技能 (knowledge)" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  无法通过练习 (practice) 提高，只能通过学习 (learn) 来提升等级。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    // 效果来自 help() 函数内容推断
    msg += "  提高琴法类武学的效果。" ZJBR;
    msg += "  是学习高深琴法的必要条件。" ZJBR;
    msg += "  音律等级上限受先天悟性限制（上限为 先天悟性 * 8）。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    return msg;
}