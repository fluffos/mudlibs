// wuyun-jianfa.c
inherit SKILL;

mapping *action = ({
([      "action" : "$N左小指轻弹，一招「宫韵」悄然划向$n的后心",
	"force" : 100,
	"dodge" : 20,
	"damage" : 20,
	"lvl" : 0,
	"damage_type" : "刺伤"
]),
([      "action" : "$N右手无名指若有若无的一划，将琴弦并做一处，[商韵]已将$n笼罩",
	"force" : 120,
	"dodge" : 15,
	"damage" : 30,
	"lvl" : 20,
	"damage_type" : "刺伤"
]),
([      "action" : "$N五指疾挥，一式[角韵]无形的刺向$n的左肋",
	"force" : 150,
	"dodge" : 15,
	"damage" : 40,
	"lvl" : 40,
	"damage_type" : "刺伤"
]),
([      "action" : "$N将手中剑横扫，同时左右手如琵琶似的疾弹，正是一招[支韵]",
	"force" : 180,
	"dodge" : 10,
	"damage" : 50,
	"lvl" : 60,
	"damage_type" : "刺伤"
]),
([      "action" : "$N使出「羽韵」，将剑提至唇边，如同清音出箫，剑掌齐出，划向$n的$l",
	"force" : 210,
	"dodge" : 10,
	"damage" : 60,
	"lvl" : 80,
	"damage_type" : "刺伤"
]),
});


int valid_enable(string usage) { return (usage == "sword") || (usage == "parry")
; }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 400)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("force") < 80)
		return notify_fail("你的内功火候不够。\n");

	return 1;
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("wuyun-jianfa",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力不够练五韵七弦剑。\n");

	if ((int)me->query("neili") < 50)
		return notify_fail("你的体力不够练五韵七弦剑。\n");

	me->receive_damage("qi", 40);
	me->add("neili", -38);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"wuyun-jianfa/" + action;
}

string query_description()
{
	string msg;

	msg = HIY "【五韵七弦剑】" ZJBR NOR;
	msg += "这是一门以音律入剑的奇特剑法，招式暗合宫商角徵羽五音。" ZJBR ZJBR;

	msg += HIY "〖学习要求〗" ZJBR NOR;
	msg += "  最大内力：" HIB "400" NOR " 点。" ZJBR;
	msg += "  内功有效激发等级：" HIY "80" NOR " 级。" ZJBR ZJBR;

	msg += HIY "〖激发类型〗" ZJBR NOR;
	msg += "  剑法（sword）。" ZJBR;
	msg += "  招架（parry）。" ZJBR ZJBR;

	msg += HIY "〖练习要求〗" ZJBR NOR;
	msg += "  需要装备剑类武器。" ZJBR;
	msg += "  气血：不低于 " HIR "50" NOR " 点。" ZJBR;
	msg += "  内力：不低于 " HIB "50" NOR " 点。" ZJBR;
	msg += "  每次练习消耗气血：" HIR "40" NOR " 点。" ZJBR;
	msg += "  每次练习消耗内力：" HIB "38" NOR " 点。" ZJBR ZJBR;

	msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
	msg += "  根据技能等级施展不同威力的普通攻击招式。" ZJBR ZJBR;

	msg += HIY "〖特殊招式〗" ZJBR NOR;
	msg += "  暂无已实现的特殊招式。" ZJBR ZJBR;

	return msg;
}

