// xian.c 神龙九变


#include <combat.h>

inherit F_SSERVER;

string query_name() { return "神龙"ZJBR"九变"; }
string *pfm_type() { return ({ "hand", }); }

int perform(object me, object target)
{
	int damage,i = 0;
	int hit_rate = 0;
	string msg;
	int final_damage = 0;

// 	1.增伤 200
// 2.增伤 205
// 3.增伤 210
// 4.增伤 215
// 5.增伤 220
// 6.增伤 225
// 7.增伤 230
// 8.增伤 235
// 9.增伤 240
	int *damage_bonus = ({ 200, 205, 210, 215, 220, 225, 230, 235, 240 });

	if (! target) target = offensive_target(me);

	if (! target || ! me->is_fighting(target))
		return notify_fail("神龙九变只能对战斗中的对手使用。\n");

	if ((int)me->query_skill("shenlong-bashi", 1) < 150)
		return notify_fail("你的神龙八式手法还不够娴熟，不能使用神龙九变。\n");

	if (me->query_skill("martial-cognize", 1) < 150)
		return notify_fail("你的武学修养不够，不能使用神龙九变。\n");

	if ((int)me->query_skill("force") < 80)
		return notify_fail("你的内功火候不够，不能使用神龙九变。\n");

	if ((int)me->query("neili") < 150)
		return notify_fail("你现在真气不够，不能使用神龙九变。\n");

	if (me->query_skill_mapped("hand") != "shenlong-bashi")
		return notify_fail("你没有激发神龙八式手法，不能使用神龙九变。\n");

       if (! living(target))
	      return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

	msg = HIG "$N" HIG "赤目而立，冲天而起。"NOR"\n";

	me->start_busy(2);
	// 如果对手是npc 命中翻倍  

	if (!playerp(target))
	{
		hit_rate = 2;
	}else{
		hit_rate = 1;
	}

	if (random(me->query_skill("hand")) > target->query_skill("parry") / 2 / hit_rate)
	{
		string *desc_name = ({
			"龙翔", "龙威", "龙爪", "龙鳞", "龙息", "龙卷", "龙雷", "龙舞", "龙神之怒"
		});

		//修正敌我双方的实际变量名
		string *desc_list = (
			{
				"$N模仿神龙翱翔天际的姿态，身形灵动，快速穿梭在敌人之间，连续发出迅猛的打击。$N的掌风如同龙翔一般，令$n无法捉摸，$N的攻击力在短时间内得到提升",
				"$N效仿神龙的威严之态，内力凝聚于全身，散发出强大的气势。$N的目光如同龙眼一般，令$n感到心灵的震撼，$N的攻击力在短时间内得到提升",
				"$N模拟神龙的利爪破空之形，掌法犀利无比。$N的每一击都带有龙爪的威力，能够轻易破开$n的防御，对其造成高额伤害，$N的攻击力在短时间内得到提升",
				"$N学习神龙的坚不可摧之鳞，强化自身的防御能力。$N的身体在短时间内变得坚硬如铁，减少受到的伤害，$N的抗击打能力得到提升",
				"$N以内力模拟神龙的吐息，发出一道强烈的气劲。$N的气劲如同龙息一般,令$n感到灼热的痛苦,$N的攻击力在短时间内得到提升",
				"$N如神龙卷起风云，身形旋转形成强劲的气旋。$N的气旋如同龙卷一般，将$n卷入其中，无法自拔,$N的攻击力在短时间内得到提升",
				"$N凝聚内力，以掌化雷。掌风如同龙雷一般，$N的攻击力在短时间内得到提升",
				"$N模仿神龙翻云覆雨之舞，动作优美而威力巨大。$N的每一次攻击都如同龙舞一般，短暂提升自身的攻击力",
				"$N汇聚全身之力，模拟龙神的愤怒。$N的攻击力如同龙神之怒一般，对$n造成巨大的单体伤害，令$n痛苦不堪"
			}
		);

		//基础伤害值
		damage = (int)me->query_skill("hand") + me->query_skill("martial-cognize", 1) + (me->query_str() * 2);
		damage += damage / 2 + random(damage);

		foreach (int damage_single in damage_bonus)
		{
			int per = 30;
			int diyin;

			diyin += me->query_temp("chang", 1) / 10;

			if (diyin > 10)
			{
				diyin = 10;
			} 

			// 每一变的触发的初始概率为30%，每层意境额外为每次触发概率提升4%。
			if (random(100) < per + COMBAT_D->get_skill_aoyi_level(me, "神龙降世") * 4 + diyin)
			{

				// 触发第3变额外恢复气血15%。
				// 触发第6变额外恢复精神15%。
				// 触发第9变额外恢复内力15%。

				if (i == 2)
				{
					me->receive_curing("qi", me->query("max_qi") * 15 / 100);
					me->receive_heal("qi", me->query("max_qi") * 15 / 100);
					tell_object(me, HIG "你恢复了" + chinese_number(me->query("max_qi") * 15 / 100) + "点气血。"NOR"\n");
				}
				else if (i == 5)
				{
					me->receive_heal("jing", me->query("max_jing") * 15 / 100);
					me->receive_curing("jing", me->query("max_jing") * 15 / 100);
					tell_object(me, HIG "你恢复了" + chinese_number(me->query("max_jing") * 15 / 100) + "点精神。"NOR"\n");
				}
				else if (i == 8)
				{
					me->add("neili", me->query("max_neili") * 15 / 100);
					tell_object(me, HIG "你恢复了" + chinese_number(me->query("max_neili") * 15 / 100) + "点内力。"NOR"\n");

					if (me->query("neili") > me->query("max_neili") * 2)
					{
						me->set("neili", me->query("max_neili") * 2);
					}
				}

				damage += damage_single + me->query_temp("chang") / 10;

				final_damage = damage;

				if (me->query("family/family_name") == "神龙教" && COMBAT_D->get_skill_aoyi_level(me, "神龙降世"))

				{
					//每层意境增加5%的伤害。
					final_damage += damage * COMBAT_D->get_skill_aoyi_level(me, "神龙降世") / 20;
				}


				msg += "$N使出了神龙九变之" + desc_name[i] + "，" + desc_list[i] + "。\n";
				msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, final_damage, 35,
					HIR "$p" HIR "瞬间被笼罩在恐惧之中，却没能挡住$P" HIR "滔天之"
					"向下压来，$P" HIR "重重的击中，哇的吐了一口鲜血。"NOR"\n");
			}
			i++;
		}


		me->add("neili", -125);
		msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 35,
					   HIR "$p" HIR "瞬间被笼罩在恐惧之中，却没能挡住$P" HIR "滔天之"
					   "向下压来，$P" HIR "重重的击中，哇的吐了一口鲜血。"NOR"\n");
	} else
	{
		msg += CYN "可是$p" CYN "看破了$P" CYN "的企图，巧妙的挡住了$P"
		       CYN "的进攻。"NOR"\n";
		me->add("neili", -30);
	}
	message_combatd(msg, me, target);

	return 1;
}
