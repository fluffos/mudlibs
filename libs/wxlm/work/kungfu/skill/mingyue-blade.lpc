// This program is a part of NITAN MudLIB
// mingyue-blade.c (天涯明月刀)

inherit SKILL;

mapping *action = ({
([      "action" : "$N身形沉稳，手中$w猛的一转，施展出单刀的刀法，一招「举杯邀明月」朝$n的$l处砍去！",
        "force"  : 120,
        "attack" : 35,
        "dodge"  : 30,
        "parry"  : 12,
        "lvl"    : 0,
        "damage" : 40,
        "damage_type" : "割伤",
        "skill_name"  : "举杯邀明月",
]),
([      "action" : "$N刀锋一转，划过一道圆弧，突然又于其上施展出挑、刺的招数，正是一招「对影成三人」！",
        "force"  : 160,
        "attack" : 42,
        "dodge"  : 40,
        "parry"  : 15,
        "lvl"    : 40,
        "damage" : 50,
        "damage_type" : "割伤",
        "skill_name"  : "对影成三人",
]),
([      "action" : "$N刀法突然凌厉，专走险路，赫然竟是马刀的路数，只见一招「天涯共此时」朝$n的$l砍去！",
        "force"  : 185,
        "attack" : 51,
        "dodge"  : 45,
        "parry"  : 17,
        "lvl"    : 60,
        "damage" : 60,
        "damage_type" : "割伤",
        "skill_name"  : "天涯共此时",
]),
([      "action" : "$N体内的真气在不断变化，不断游移，突然一招「海角若比邻」斩向$n的$l!",
        "force"  : 220,
        "attack" : 55,
        "dodge"  : 55,
        "parry"  : 21,
        "lvl"    : 80,
        "damage" : 70,
        "damage_type" : "割伤",
        "skill_name"  : "海角若比邻",
]),
});

int valid_enable(string usage){ return usage == "blade" || usage == "parry";}

int valid_learn(object me)
{    
        if ((int)me->query("max_neili") < 2000)
                return notify_fail("你的内力不够。\n");

        if ((int)me->query_skill("force") < 180)
                return notify_fail("你的内功火候太浅。\n");

        if ((int)me->query_skill("blade", 1) < 140)
                return notify_fail("你的基本刀法不够，难以修炼天涯明月刀。\n");

        if ((int)me->query_skill("blade", 1) < (int)me->query_skill("mingyue-blade", 1))
                return notify_fail("你的基本刀法水平有限，无法领会更高深的天涯明月刀。\n");

        return 1;
}

string query_skill_name(int level)
{
        int i;
        for (i = sizeof(action) - 1; i >= 0; i--)
                if (level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
        int i, level;
        level   = (int) me->query_skill("mingyue-blade", 1);
        if (random(me->query_skill("blade")) > 240 
        &&  me->query_skill("force") > 300 
        &&  me->query("neili") > 5000       
        &&  objectp(weapon = me->query_temp("weapon")))  
        {
                me->add("neili", -300);
                return ([
                        "action": "$N使出一招" HIM "「天涯明月相思泪」" NOR "，$w霍地射出寒光点点，犹如冬夜寒雨般铺天盖地扫向$n",
                        "damage": 300,
                        "dodge" : 100,
                        "parry" : 150,
                        "attack": 150,
                        "damage_type": "割伤"
                ]);
        }        
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
        object weapon;

        if (! objectp(weapon = me->query_temp("weapon"))|| (string)weapon->query("skill_type") != "blade")
                return notify_fail("你使用的武器不对。\n");

        if ((int)me->query("qi") < 80)
                return notify_fail("你的体力不够，练不了天涯明月刀。\n");

        if ((int)me->query("neili") < 120)
                return notify_fail("你的内力不够，练不了天涯明月刀。\n");

        me->receive_damage("qi", 64);
        me->add("neili", -84);
        return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
        object weapon;
        int lvl = me->query_skill("mingyue-blade", 1);
        weapon = me->query_temp("weapon");      

        if (lvl < 180 || lvl / 2 + random(lvl) < (int)victim->query_skill("dodge", 1) ||
            me->query("neili") < 1500 ||
            me->query_skill("dodge", 1) < 180 ||
            me->query_skill("force", 1) < 150 ||             
            victim->is_busy() )
                 return 0;
        message_vision(HIW "\n$N" HIW "右手" + weapon->name() + HIW "猛然旋转，刀光突"
                       "现，刹那间已将$n" HIW "逼的退无可退。\n" NOR, me, victim); 
        me->add("neili", -80);
        victim->start_busy(2 + random(lvl / 60));
        return 1;                         
}

string perform_action_file(string action)
{
        return __DIR__"mingyue-blade/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【天涯明月刀】" ZJBR NOR;
    msg += "一门凌厉绝伦的刀法，刀光如月，意境深远，变幻莫测。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  最大内力不低于 " HIB "2000" NOR " 点。" ZJBR;
    msg += "  内功激发等级 (`force`) 不低于 " HIY "180" NOR " 级。" ZJBR;
    msg += "  基本刀法 (`blade`) 等级不低于 " HIY "140" NOR " 级。" ZJBR;
    msg += "  基本刀法 (`blade`) 等级不低于天涯明月刀激发等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  刀法 (`blade`)。" ZJBR;
    msg += "  招架 (`parry`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  需装备刀类武器。" ZJBR;
    msg += "  气血不低于 " HIR "80" NOR " 点。" ZJBR;
    msg += "  内力不低于 " HIB "120" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "64" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "84" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // query_action, hit_ob
    msg += HIM "  天涯明月相思泪" NOR "：" ZJBR;
    msg += "    触发条件：普通攻击中有几率触发 (需 基本刀法 > 240, 内功激发 > 300, 当前内力 > 5000, 装备武器)。" ZJBR;
    msg += "    效果：发动一次极高伤害 (基础伤害 " HIR "300" NOR "), 高攻击 (+" HIR "150" NOR "), 高闪避 (+" HIW "100" NOR "), 高招架 (+" HIG "150" NOR ") 的强力攻击。" ZJBR;
    msg += "    消耗：内力 " HIB "300" NOR " 点。" ZJBR ZJBR;
    msg += HIW "  刀光压制" NOR "：" ZJBR;
    msg += "    触发条件：普通攻击命中时，满足特定条件 (天涯明月刀激发等级 >= 180, 自身内力 >= 1500, 轻功激发 >= 180, 内功激发 >= 150, 且命中检定通过 (自身等级/2 + 随机(自身等级/2) > 目标轻功), 目标未被忙乱)。" ZJBR;
    msg += "    效果：使目标陷入忙乱状态，持续时间为 (2 + 随机(天涯明月刀激发等级 / 60)) 秒。" ZJBR;
    msg += "    消耗：内力 " HIB "80" NOR " 点。" ZJBR ZJBR;


    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform/exert

    msg += HIC "  天涯明月 (tianya)" ZJBR NOR; // 招式名称
    msg += "    使用要求：" ZJBR; // 招式使用要求
    msg += "      天涯明月刀激发等级 " HIY "180" NOR " 级。" ZJBR;
    msg += "      基本刀法 (`blade`) 等级 " HIY "180" NOR " 级。" ZJBR;
    msg += "      内功激发等级 (`force`) " HIY "200" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "500" NOR " 点。" ZJBR;
    msg += "      激发刀法为天涯明月刀。" ZJBR;
    msg += "      装备刀类武器。" ZJBR;
    msg += "    效果描述：" ZJBR; // 招式效果描述
    msg += "      对目标发动一次强力攻击 (使用 `COMBAT_D->do_attack` 进行判定)。" ZJBR;
    msg += "      伤害计算：伤害 ≈ (天涯明月刀激发等级 + 随机(天涯明月刀激发等级) + 内功激发等级 / 2)。" ZJBR;
    msg += "    消耗与代价：" ZJBR; // 消耗与代价
    msg += "      消耗内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  斩 (zhan)" ZJBR NOR; // 招式名称
    msg += "    使用要求：" ZJBR; // 招式使用要求
    msg += "      天涯明月刀激发等级 " HIY "220" NOR " 级。" ZJBR;
    msg += "      基本刀法 (`blade`) 等级 " HIY "220" NOR " 级。" ZJBR;
    msg += "      内功激发等级 (`force`) " HIY "220" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "600" NOR " 点。" ZJBR;
    msg += "      激发刀法为天涯明月刀。" ZJBR;
    msg += "      装备刀类武器。" ZJBR;
    msg += "    效果描述：" ZJBR; // 招式效果描述
    msg += "      发动时临时提升自身攻击力 (天涯明月刀激发等级 / 3) 点，提升自身伤害 (天涯明月刀激发等级 / 3) 点。" ZJBR;
    msg += "      以提升后的状态对目标发动一次强力攻击 (使用 `COMBAT_D->do_attack` 进行判定)。" ZJBR;
    msg += "      伤害计算：基础伤害 ≈ (天涯明月刀激发等级 + 随机(天涯明月刀激发等级) + 内功激发等级 / 2)，并附加临时提升的伤害。" ZJBR;
    msg += "    消耗与代价：" ZJBR; // 消耗与代价
    msg += "      消耗内力 " HIB "400" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "4" NOR " 秒。" ZJBR;

    return msg;
}
