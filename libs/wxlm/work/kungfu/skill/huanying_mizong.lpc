#include <combat.h>

inherit SKILL;

mapping *action = ({
([  "action" : "$N身形一晃,使出" HIM "幻影迷踪" NOR ",双拳如鬼魅般向$n的$l攻去",
    "force" : 200,
    "attack": 70,
    "dodge" : 50,
    "parry" : 50,
    "damage": 100,
    "lvl"   : 0,
    "skill_name" : "幻影迷踪",
    "damage_type" : "瘀伤"
]),
([  "action" : "$N施展" HIB "虚实难辨" NOR ",身形忽左忽右,令$n难以捉摸",
    "force" : 220,
    "attack": 80,
    "dodge" : 60,
    "parry" : 55,
    "damage": 110,
    "lvl"   : 30,
    "skill_name" : "虚实难辨",
    "damage_type" : "内伤"
]),
([  "action" : "$N一式" HIW "镜花水月" NOR ",拳影重重叠叠,虚虚实实笼罩$n全身",
    "force" : 240,
    "attack": 90,
    "dodge" : 70,
    "parry" : 60,
    "damage": 120,
    "lvl"   : 60,
    "skill_name" : "镜花水月",
    "damage_type" : "内伤"
]),
([  "action" : "$N使出" HIC "千变万化" NOR ",身法诡异,拳势变幻莫测,令$n无所适从",
    "force" : 280,
    "attack": 100,
    "dodge" : 80,
    "parry" : 70,
    "damage": 140,
    "lvl"   : 90,
    "skill_name" : "千变万化",
    "damage_type" : "瘀伤"
]),
});

int valid_enable(string usage) { return usage == "cuff" || usage == "parry"; }

int valid_learn(object me)
{
    if (me->query("family/family_name"))
        return notify_fail("幻影迷踪拳只有无门派的人才能学习。\n");

    if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
        return notify_fail("练习幻影迷踪拳必须空手。\n");

    if ((int)me->query_skill("force") < 100)
        return notify_fail("你的内功火候不够，无法练习幻影迷踪拳。\n");

    if ((int)me->query("max_neili") < 800)
        return notify_fail("你的内力太弱，无法练习幻影迷踪拳。\n");

    if ((int)me->query_skill("cuff", 1) < 80)
        return notify_fail("你的基本拳法火候不够，无法练习幻影迷踪拳。\n");

    if ((int)me->query_skill("cuff", 1) < (int)me->query_skill("huanying_mizong", 1))
        return notify_fail("你的基本拳法水平有限，无法领会更高深的幻影迷踪拳。\n");

    return 1;
}

string query_skill_name(int level)
{
    int i;
    for (i = sizeof(action) - 1; i >= 0; i--)
        if (level >= action[i]["lvl"])
            return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    int i, level;
    level = (int) me->query_skill("huanying_mizong", 1);
    for (i = sizeof(action); i > 0; i--)
        if (level > action[i-1]["lvl"])
            return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    if ((int)me->query("qi") < 60)
        return notify_fail("你的体力太低了。\n");

    if ((int)me->query("neili") < 60)
        return notify_fail("你的内力不够练幻影迷踪拳。\n");

    me->receive_damage("qi", 50);
    me->add("neili", -55);
    return 1;
}

string perform_action_file(string action)
{
    return __DIR__"huanying_mizong/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
    int lvl;
    int i;

    lvl = me->query_skill("huanying_mizong", 1);
    i = random(lvl);

    if (i < 50)
        return 0;

    if (i < 100)
    {
        victim->receive_wound("qi", damage_bonus / 6);
        return HIM "$N" HIM "拳影飘忽不定,令$n" HIM "难以招架,受了些许内伤！"NOR"\n";
    }
    else
    {
        victim->receive_wound("qi", damage_bonus / 4);
        return HIW "$N" HIW "身形飘忽,拳势诡异,$n" HIW "只觉得眼花缭乱,不知如何抵挡！"NOR"\n";
    }
}

string query_description()
{
    string msg;

    msg = HIM "【幻影迷踪拳】" ZJBR NOR;
    msg += WHT "幻影迷踪拳是一门以速度和幻影迷惑对手的拳法，身形飘忽不定，拳影虚实难辨，令敌人难以招架。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  非门派弟子。" ZJBR;
    msg += "  必须空手。" ZJBR;
    msg += "  基本内功等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "  最大内力 " HIB "800" NOR " 点。" ZJBR;
    msg += "  基本拳法等级 " HIY "80" NOR " 级。" ZJBR;
    msg += "  幻影迷踪拳等级不能超过基本拳法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  拳法 (cuff)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "60" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "55" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  幻影迷踪：" ZJBR;
    msg += "    触发几率受幻影迷踪拳等级影响。" ZJBR;
    msg += "    较高几率：造成 (伤害值 / 6) 的气血伤害。效果：" HIM "$N拳影飘忽不定,令$n难以招架,受了些许内伤！" NOR ZJBR;
    msg += "    较低几率：造成 (伤害值 / 4) 的气血伤害。效果：" HIW "$N身形飘忽,拳势诡异,$n只觉得眼花缭乱,不知如何抵挡！" NOR ZJBR ZJBR;

    return msg;
}