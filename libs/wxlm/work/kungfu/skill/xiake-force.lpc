// xiake-force.c 侠客岛内功

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_learn(object me)
{
	return ::valid_learn(me);
}

int practice_skill(object me)
{
	return notify_fail("侠客岛内功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"xiake-force/" + func;
}

string query_description()
{
	string msg;

	msg = HIY "【侠客岛内功】" ZJBR NOR;
	msg += "源自侠客岛的神秘内功心法，具体来历不详。" ZJBR ZJBR; // 基本介绍

	msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
	msg += "  继承自基础内功（FORCE），具体学习要求请参照基础内功。" ZJBR ZJBR;

	msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
	msg += "  内功（force）。" ZJBR ZJBR;

	msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
	msg += "  无法练习，只能通过学习（learn）提升。" ZJBR ZJBR;

	msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
	msg += "  暂无明确的被动效果。" ZJBR ZJBR;

	msg += HIY "〖特殊招式〗" ZJBR NOR; // exert_function_file (but directory seems missing)
	msg += "  暂无已实现的特殊招式。" ZJBR ZJBR; // 虽然有exert_function_file，但目录不存在

	return msg;
}