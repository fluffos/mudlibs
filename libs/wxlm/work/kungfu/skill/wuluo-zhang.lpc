int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练绫罗青烟掌必须空手。\n");

	if ((int)me->query_skill("force") < 20)
		return notify_fail("你的内功火候不够，无法学绫罗青烟掌。\n");

	if ((int)me->query("max_neili") < 100)
		return notify_fail("你的内力修为太弱，无法练绫罗青烟掌。\n");

	if ((int)me->query_skill("strike", 1) < (int)me->query_skill("wuluo-zhang", 1))
		return notify_fail("你的基本掌法火候有限，无法领会更高深的绫罗青烟掌。\n");

	return 1;
}

int valid_enable(string usage)
{
	return usage == "strike" || usage == "parry";
}

int valid_combine(string combo)
{
	return combo == "jinyu-quan";
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("wuluo-zhang", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力太差了，不能练绫罗青烟掌。\n");

	if ((int)me->query("neili") < 30)
		return notify_fail("你的内力太差了，不能练绫罗青烟掌。\n");

	me->receive_damage("qi", 40);
	me->add("neili", -13);

	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"wuluo-zhang/" + action;
}
string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}
//等级提升，是否学会新的招式
string query_skill_up(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
	 {
		if(level == action[i]["lvl"])
		 {
		     return action[i]["skill_name"];
		 }
	 }
	  return "no";
}

string query_description()
{
    string msg;

    msg = HIY "【绫罗青烟掌】" ZJBR NOR;
    msg += "绫罗青烟掌是一种轻灵飘逸的掌法，以其优雅柔和的招式著称，如行云流水般连绵不绝。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  空手状态。" ZJBR;
    msg += "  基本掌法等级需大于等于绫罗青烟掌等级。" ZJBR;
    msg += "  基本内功等级需达到 " HIY "20" NOR " 级。" ZJBR;
    msg += "  内力修为需达到 " HIB "100" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  掌法（strike）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖特殊配合〗" ZJBR NOR;
    msg += "  可与金玉拳互备。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "30" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "40" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "13" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖招式详解〗" ZJBR NOR;
    msg += "  绫罗青烟掌共有七式，依次为：" ZJBR;
    msg += "  " BLU "清风斜雨" NOR "（入门）、" HIB "垂钓江畔" NOR "（10级）、" MAG "落叶雅意" NOR "（20级）、" ZJBR;
    msg += "  " RED "归路未晓" NOR "（34级）、" HIC "春风拂柳" NOR "（45级）、" YEL "逍遥世间" NOR "（59级）、" ZJBR;
    msg += "  " HIG "我心犹怜" NOR "（80级）。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  风云变幻 (bian)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      绫罗青烟掌等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      空手。" ZJBR;
    msg += "      激发掌法为绫罗青烟掌。" ZJBR;
    msg += "      准备绫罗青烟掌。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      单掌轻轻一抖，化出五道掌影攻击敌人。" ZJBR;
    msg += "      命中判定：若随机（自身内功有效激发等级 + 掌法有效激发等级）> 对方内功有效激发等级，" ZJBR;
    msg += "                则获得额外攻击加成，加成值为绫罗青烟掌等级的十分之一。" ZJBR;
    msg += "      攻击次数与使用者基础攻击数量相同，由COMBAT_D->query_base_attack_number()决定。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力消耗 " HIB "50" NOR " 点。" ZJBR;
    msg += "      使用后忙乱 " HIR "1-5" NOR " 秒。" ZJBR;

    return msg;
}

