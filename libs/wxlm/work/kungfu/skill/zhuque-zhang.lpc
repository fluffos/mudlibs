// 朱雀烈焰掌

inherit SKILL;

mapping *action = ({
    ([  "action": "$N一式「朱雀展翅」，双掌如翼般扇向$n的$l",
        "force" : 120,
        "dodge" : 20,
        "damage": 25,
        "lvl"   : 0,
        "skill_name" : "朱雀展翅",
        "damage_type": "瘀伤"
    ]),
    ([  "action": "$N使出「凤凰涅槃」，掌心烈焰升腾，击向$n的$l",
        "force" : 150,
        "dodge" : 15,
        "damage": 35,
        "lvl"   : 30,
        "skill_name" : "凤凰涅槃",
        "damage_type": "灼伤"
    ]),
    ([  "action": "$N一招「烈焰焚天」，双掌齐出，炽热掌风扫向$n的全身",
        "force" : 180,
        "dodge" : 25,
        "damage": 45,
        "lvl"   : 60,
        "skill_name" : "烈焰焚天",
        "damage_type": "灼伤"
    ]),
    ([  "action": "$N使出「朱雀啼鸣」，全身真气外放，形成火焰光环，扑向$n",
        "force" : 220,
        "dodge" : 30,
        "damage": 55,
        "lvl"   : 90,
        "skill_name" : "朱雀啼鸣",
        "damage_type": "内伤"
    ]),
});

int valid_enable(string usage) { return usage == "strike" || usage == "parry"; }

int valid_learn(object me)
{
    if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
        return notify_fail("练朱雀烈焰掌必须空手。\n");
    if ((int)me->query("max_neili") < 100)
        return notify_fail("你的内力不够，无法练习朱雀烈焰掌。\n");
    if ((int)me->query_skill("sixiang-shengong", 1) < 20)
        return notify_fail("你的四象神功火候不够，无法练习朱雀烈焰掌。\n");
    return 1;
}

string query_skill_name(int level)
{
    int i;
    for(i = sizeof(action)-1; i >= 0; i--)
        if(level >= action[i]["lvl"])
            return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    int i, level;
    level = (int)me->query_skill("zhuque-zhang", 1);
    for(i = sizeof(action); i > 0; i--)
        if(level > action[i-1]["lvl"])
            return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    if ((int)me->query("qi") < 30)
        return notify_fail("你的体力太低了。\n");
    if ((int)me->query("neili") < 20)
        return notify_fail("你的内力不够练朱雀烈焰掌。\n");
    me->receive_damage("qi", 25);
    me->add("neili", -5);
    return 1;
}

// 在 zhuque-zhang 目录下创建 fenghuang-niepan.c 文件

string perform_action_file(string action)
{
    return __DIR__"zhuque-zhang/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【朱雀烈焰掌】" ZJBR NOR;
    msg += WHT "朱雀烈焰掌乃四象门绝学，掌法刚猛，蕴含炽热真气，可对敌造成灼伤。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力 不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "  基本四象神功 等级：" HIY "20" NOR " 级。" ZJBR;
    msg += "  练习需空手，不可持武器。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  掌法 (strike)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  当前气血 不低于 " HIR "30" NOR " 点。" ZJBR;
    msg += "  当前内力 不低于 " HIB "20" NOR " 点。" ZJBR;
    msg += "  每次练习消耗 气血 " HIR "25" NOR " 点，消耗 内力 " HIB "5" NOR " 点。" ZJBR ZJBR;

    // msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // 基础文件中未发现明显被动效果
    // msg += "  ..." ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  凤凰涅槃 (fenghuang-niepan)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      有效朱雀烈焰掌 等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      有效四象神功 等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "      必须空手。" ZJBR;
    msg += "      朱雀烈焰掌 需激发为 掌法。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：攻击力 = (有效掌法等级 + 有效内功等级)；防御力 = (目标有效轻功等级 + 目标有效招架等级)。若 攻击力 + 随机(攻击力) > 防御力，则命中。" ZJBR; // Adjusted based on COMBAT_D->hit_determination logic which typically uses random(ap)
    msg += "      命中后伤害：造成 (攻击力 / 2 + 随机(攻击力 / 2)) 点 灼伤 伤害。" ZJBR; // damage = ap / 2 + random(ap / 2) // fenghuang-niepan.c uses COMBAT_D->do_damage with damage/busy 60, which often implies busy time related to damage dealt. No explicit random(3) found.
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中消耗 内力 " HIB "150" NOR " 点，未命中消耗 内力 " HIB "50" NOR " 点。" ZJBR;
    msg += "      命中后自身忙乱 " HIR "2" NOR " 秒，未命中后自身忙乱 " HIR "3" NOR " 秒。" ZJBR; // Corrected busy times from fenghuang-niepan.c

    return msg;
}
