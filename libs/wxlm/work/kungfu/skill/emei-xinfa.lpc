// emei-xinfa.c 峨嵋心法

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_force(string force)
{
	return force == "linji-zhuang";
}

int valid_learn(object me)
{
	    return ::valid_learn(me);
}

int practice_skill(object me)
{
	return notify_fail("峨嵋心法只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"emei-xinfa/" + func;
}

string query_description()
{
    string msg;

    msg = HIY "【峨嵋心法】" ZJBR NOR;
    msg += "峨嵋派的独门内功心法，以柔和绵长、气息悠远著称。" ZJBR;
    msg += "此心法讲究以柔克刚，以静制动，内力绵绵不绝。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  基本内功等级要求，具体参考内功(FORCE)基础设定。" ZJBR ZJBR; // 实际检查在 inherit FORCE 中

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  内功（force）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  峨嵋心法无法通过练习提升，只能通过学习(learn)提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // inherit FORCE
    msg += "  继承内功(FORCE)标准效果，如提高内力上限、加快内力/精力恢复速度等。" ZJBR ZJBR; // 具体数值参考 FORCE

    msg += HIY "〖特殊招式〗" ZJBR NOR; // exert_function_file
    msg += "  无。" ZJBR ZJBR; // exert 目录不存在

    msg += HIY "〖其他信息〗" ZJBR NOR;
    msg += "  可与临济十二庄内功 (`linji-zhuang`) 相互配合。" ZJBR; // valid_force

    return msg;
}