int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 1200)
		return notify_fail("你的内力修为尚浅，无法练习紫金八卦刀。\n");

	if ((int)me->query_skill("force") < 150)
		return notify_fail("你的内功火候太浅。\n");

	if ((int)me->query_skill("blade", 1) < 120 )
		return notify_fail("你的基本刀法水平有限，无法练习紫金八卦刀。\n");

	if ((int)me->query_skill("blade", 1) < (int)me->query_skill("zijinbagua-dao", 1))
		return notify_fail("你的基本刀法水平有限，无法领会更高深的紫金八卦刀。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level   = (int) me->query_skill("zijinbagua-dao", 1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "blade")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 90)
		return notify_fail("你的体力不够，练不了紫金八卦刀。\n");

	if ((int)me->query("neili") < 150)
		return notify_fail("你的内力不够，练不了紫金八卦刀。\n");

	me->receive_damage("qi", 85);
	me->add("neili", -100);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"zijinbagua-dao/" + action;
}


string query_description()
{
    string msg;

    msg = MAG "【紫金八卦刀】" ZJBR NOR;
    msg += WHT "紫金八卦刀是一门高深的刀法，以八卦方位变化为基础，招式精妙绝伦。" ZJBR;
    msg += WHT "共有八式攻击招式，随等级提升解锁。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力 不低于 " HIB "1200" NOR " 点。" ZJBR;
    msg += "  基本内功 等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "  基本刀法 等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "  基本刀法 等级不可低于 紫金八卦刀 等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  刀法 (blade)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  须装备刀类武器。" ZJBR;
    msg += "  当前气血 不低于 " HIR "90" NOR " 点。" ZJBR;
    msg += "  当前内力 不低于 " HIB "150" NOR " 点。" ZJBR;
    msg += "  每次练习消耗 气血 " HIR "85" NOR " 点，消耗 内力 " HIB "100" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  八卦阵芒 (bagua)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      紫金八卦刀 已激发为刀法。" ZJBR;
    msg += "      最大内力 不低于 " HIB "2000" NOR " 点。" ZJBR;
    msg += "      当前内力 不低于 " HIB "400" NOR " 点。" ZJBR;
    msg += "      基本内功 等级不低于 " HIY "220" NOR " 级。" ZJBR;
    msg += "      紫金八卦刀 等级不低于 " HIY "200" NOR " 级。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标发动连续攻击。" ZJBR;
    msg += "      攻击次数由 `COMBAT_D` 的 `query_base_attack_number` 决定。" ZJBR;
    msg += "      命中判定：若 随机(有效刀法激发) > (目标有效招架激发 / 2)，则：" ZJBR;
    msg += "        临时增加自身攻击 (apply/attack)：增加值为 (紫金八卦刀等级 / 6)。" ZJBR;
    msg += "      攻击时有 1/3 的几率使目标忙乱 1 秒（如果目标当前不忙乱）。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "1 + 随机(6)" NOR " 秒。" ZJBR;

    return msg;
}