// 青龙天罡枪法

inherit SKILL;

mapping *action = ({
    ([  "action": "$N使出「青龙出水」，$w如蛟龙般自下而上扑向$n的$l",
        "force" : 120,
        "dodge" : 20,
        "damage": 30,
        "lvl"   : 0,
        "skill_name" : "青龙出水",
        "damage_type": "挫伤"
    ]),
    ([  "action": "$N一式「苍龙盘绕」，$w绕身疾转，击向$n的$l",
        "force" : 150,
        "dodge" : 15,
        "damage": 40,
        "lvl"   : 30,
        "skill_name" : "苍龙盘绕",
        "damage_type": "刺伤"
    ]),
    ([  "action": "$N使出「龙腾九天」，$w高高举起，以泰山压顶之势向$n当头砸下",
        "force" : 180,
        "dodge" : 15,
        "damage": 50,
        "lvl"   : 60,
        "skill_name" : "龙腾九天",
        "damage_type": "挫伤"
    ]),
    ([  "action": "$N一招「青龙摆尾」，$w横扫$n下盘，气势如虹",
        "force" : 200,
        "dodge" : 25,
        "damage": 60,
        "lvl"   : 90,
        "skill_name" : "青龙摆尾",
        "damage_type": "挫伤"
    ]),
});

int valid_enable(string usage) { return usage == "club" || usage == "parry"; }

int valid_learn(object me)
{
    if ((int)me->query("max_neili") < 100)
        return notify_fail("你的内力不够，无法练习青龙天罡枪法。\n");
    if ((int)me->query_skill("sixiang-shengong", 1) < 20)
        return notify_fail("你的四象神功火候不够，无法练习青龙天罡枪法。\n");
    return 1;
}

string query_skill_name(int level)
{
    int i;
    for(i = sizeof(action)-1; i >= 0; i--)
        if(level >= action[i]["lvl"])
            return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    int i, level;
    level = (int)me->query_skill("qinglong-jian", 1);
    for(i = sizeof(action); i > 0; i--)
        if(level > action[i-1]["lvl"])
            return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    object weapon;
    if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "club")
        return notify_fail("你使用的武器不对。\n");
    if ((int)me->query("qi") < 50)
        return notify_fail("你的体力不够练青龙天罡枪法。\n");
    me->receive_damage("qi", 30);
    return 1;
}

// 在 qinglong-jian 目录下创建 qinglong-chuhai.c 文件

string perform_action_file(string action)
{
    return __DIR__"qinglong-jian/" + action;
}

int difficult_level() 
{
    return 300;
}

string query_description()
{
    string msg;

    // 注意：文件名 qinglong-jian.c 与技能类型 club (棍法) 不符，文档以棍法为准。
    msg = HIY "【青龙天罡枪法】" ZJBR ZJBR NOR;
    msg += WHT "四象门镇派枪法之一 (文件名为-jian.c，实为枪/棍法)。以灵动迅捷著称，招式如青龙腾跃，气势磅礴。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  最大内力 (" HIW "max_neili" NOR ") 不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "  四象神功 (" HIW "sixiang-shengong" NOR ") 等级不低于 " HIY "20" NOR " 级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  棍法 (club)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  必须装备 棍 (club) 类武器。" ZJBR;
    msg += "  气血 (" HIW "qi" NOR ")：不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "30" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform_action_file
    msg += HIC "  青龙出海 (qinglong-chuhai)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      青龙天罡枪法等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      四象神功等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      激发棍法为青龙天罡枪法。" ZJBR;
    msg += "      装备棍类武器。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定基于双方 (棍法激发等级 + 内功激发等级) vs (轻功激发等级 + 招架激发等级)，对非玩家目标命中率提升50%。" ZJBR;
    msg += "      命中后造成伤害，伤害值约为 (棍法激发等级 + 内功激发等级) 的 " HIY "3" NOR " 倍，对非玩家目标伤害翻倍。" ZJBR;
    msg += "      伤害受 " HIW "青龙吐雾" NOR " 奥义等级加成，每级提升 " HIY "10%" NOR " 伤害。" ZJBR;
    msg += "      命中后附加 " HIY "100" NOR " 点破防效果。" ZJBR;
    msg += "      命中后清除四象归元状态，可以重新使用四象归元。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 " HIB "150" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：消耗内力 " HIB "50" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  狂纵枪舞 (kuangzong)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      青龙天罡枪法等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      四象神功等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "500" NOR " 点。" ZJBR;
    msg += "      激发棍法为青龙天罡枪法。" ZJBR;
    msg += "      装备棍类武器。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      先进行一次命中判定，基于双方 (四象神功等级 + 棍法激发等级) vs (内功激发等级 + 招架激发等级)。" ZJBR;
    msg += "      若命中，则造成初始伤害 (判定AP / 2 + 随机(判定AP / 2))，附加 " HIY "66" NOR " 点破防效果，自身忙乱 3 秒，目标忙乱 1 秒 (若不忙乱)。" ZJBR;
    msg += "      随后临时提升攻击力 (四象神功等级 / 5)，并进行连续攻击。" ZJBR;
    msg += "      攻击次数 = 基础攻击次数 + (当前内力 / 500)，但总次数受限于不超过使用者 (内力 * 30%) 支持的次数。" ZJBR;
    msg += "      每次连续攻击消耗内力 " HIB "500" NOR " 点，并有 10% 几率使目标忙乱 1 秒 (若不忙乱)。" ZJBR;
    msg += "      所有攻击结束后，有 25% (对玩家) 或 40% (对非玩家) 几率根据青龙吐雾奥义等级额外增加目标忙乱时间。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      初始判定未命中：自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      命中后：根据攻击次数消耗大量内力，自身忙乱 " HIR "3" NOR " 秒起。" ZJBR;

    return msg;
}
