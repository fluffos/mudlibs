int valid_enable(string usage) { return usage == "staff" || usage == "parry"; }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 300)
		return notify_fail("你的内力不够，无法学习普渡杖法。\n");

	if ((int)me->query_skill("force") < 60)
		return notify_fail("你的内功火候太浅，无法学习普渡杖法。\n");

	if ((int)me->query_skill("staff", 1) < (int)me->query_skill("pudu-zhang", 1))
		return notify_fail("你的基本杖法水平有限，无法领会更高深的普渡杖法。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action)-1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("pudu-zhang",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "staff")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力不够练普渡杖法。\n");

	if ((int)me->query("neili") < 70)
		return notify_fail("你的内力不够练普渡杖法。\n");

	me->receive_damage("qi", 65);
	me->add("neili", -68);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"pudu-zhang/" + action;
}


string query_description()
{
    string msg;

    msg = HIY "【普渡杖法】" ZJBR ZJBR NOR;
    msg += WHT "少林七十二绝技之一。杖法注重实战，招式沉猛，大开大阖，兼具刚柔之力。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力 (" HIW "max_neili" NOR ") 不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "  基本内功 (" HIW "force" NOR ") 等级不低于 " HIY "60" NOR " 级。" ZJBR;
    msg += "  基本杖法 (" HIW "staff" NOR ") 等级需大于等于普渡杖法等级。" ZJBR;
    msg += "  可能需要少林弟子身份 (继承自 SHAOLIN_SKILL)。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  杖法 (staff)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须装备 杖 (staff) 类武器。" ZJBR;
    msg += "  气血 (" HIW "qi" NOR ")：不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力 (" HIW "neili" NOR ")：不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "65" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "68" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  佛光普照 (zhao)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      普渡杖法等级 " HIY "135" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "200" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "1000" NOR " 点。" ZJBR;
    msg += "      激发杖法为普渡杖法。" ZJBR;
    msg += "      装备杖类武器。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定基于双方 (杖法激发等级 + 最大内力 / 10) vs (内功激发等级 + 最大内力 / 10)。" ZJBR;
    msg += "      命中后造成伤害，伤害值约为 ((使用者最大内力 - 目标最大内力) / 5 + 杖法激发等级 / 3)，附加随机伤害(最终伤害 / 3)。" ZJBR;
    msg += "      命中后附加 " HIY "50" NOR " 点破防效果，并将目标击倒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 " HIB "250" NOR " 点，自身忙乱 " HIR "1" NOR " 秒。" ZJBR;
    msg += "      未命中：消耗内力 " HIB "60" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;

    return msg;
}