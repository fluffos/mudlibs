// This program is a part of NT MudLIB
// sougu.c 搜骨鹰爪功


inherit SKILL;
string type() { return "martial"; }
string martialtype() { return "skill"; }

mapping *action = ({
([        "action" : "$N双臂一拢，左爪直攻$n下盘，右爪却挟风雷之势推向$n腰间，一虚一实，正是一招"HIM"「推爪式」"NOR"",
        "lvl"    : 0,
        "skill_name" : "推爪式"
]),
([        "action" : "$N身形陡起，如雄鹰击日般“倏”地从$n头顶越过，使一招"HIR"「盖爪式」"NOR"双爪疾向$n脑后击下",
        "lvl"    : 5,
        "skill_name" : "盖爪式"
]),
([        "action" : "$N就地一滚，突然到了$n身前，使一招"HIB"「掏爪式」"NOR"，右爪直奔$n小腹",
        "lvl"    : 10,
        "skill_name" : "掏爪式"
]),
([        "action" : "\n$N左爪护胸，右爪凝劲后发，一招"HIC"「托爪式」"NOR"，缓缓托向$n的$l",
        "lvl"    : 20,
        "skill_name" : "托爪式"
]),
([        "action" : "\n$N身形诡异，疾速前扑，使一招"HIG"「撩爪式」"NOR"，直撩$n裆部",
        "lvl"    : 35,
        "skill_name" : "撩爪式"
]),
([        "action" : "\n$N身形飘忽，陡然转到$n身后，一招"HIW"「锁爪式」"NOR"，双爪直向$n咽喉插下",
        "lvl"    : 60,
        "skill_name" : "锁爪式"
]),
([        "action" : "\n$N一声厉啸，身形拔起，使出"HIC"「千爪式」"NOR"，由半空盘旋下击，$n顿觉漫天爪影，罩向全身死穴",
        "lvl"    : 85,
        "skill_name" : "千爪式"
])
});

int valid_enable(string usage) { return usage=="claw" || usage=="parry"; }
int valid_learn(object me)
{
        if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
                return notify_fail("练搜骨鹰爪功必须空手。\n");

        if ((int)me->query_skill("force") < 100)
                return notify_fail("你的内功火候不够，无法学搜骨鹰爪功。\n");

        if ((int)me->query("max_neili") < 600)
                return notify_fail("你的内力太弱，无法学搜骨鹰爪功。\n");

        if ((int)me->query_str() < 33)
                return notify_fail("你现在的膂力太差，还无法学搜骨鹰爪功。\n");

        return 1;
}

int practice_skill(object me)
{
        if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
                return notify_fail("你的必须空手才能练习。\n");
        if ((int)me->query("qi") < 40)
                return notify_fail("你的体力太低了。\n");
        if ((int)me->query("neili") < 40)
                return notify_fail("你的内力不够练鹰爪功。\n");
        me->receive_damage("qi", 30);
        me->add("neili", -30);
        return 1;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action); i > 0; i--)
                if(level >= action[i-1]["lvl"])
                        return action[i-1]["skill_name"];
}
mapping query_action(object me, object weapon)
{
/* d_e=dodge_effect p_e=parry_effect f_e=force_effect m_e=damage_effect */
        int d_e1 = 40;
        int d_e2 = 20;
        int p_e1 = -10;
        int p_e2 = -40;
        int f_e1 = 250;
        int f_e2 = 300;
        int i, lvl, seq, ttl = sizeof(action);

        lvl = (int)me->query_skill("sougu", 1);
        for(i = ttl; i > 0; i--)
                if(lvl > action[i-1]["lvl"])
                {
                        seq = i; /* 获得招数序号上限 */
                        break;
                }
        seq = random(seq);       /* 选择出手招数序号 */
        return ([
                "action"      : action[seq]["action"],
                "dodge"       : d_e1 + (d_e2 - d_e1) * seq / ttl,
                "parry"       : p_e1 + (p_e2 - p_e1) * seq / ttl,
                "force"       : f_e1 + (f_e2 - f_e1) * seq / ttl,
                "damage_type" : random(2) ? "抓伤" : "内伤",
        ]);
}

int learn_bonus() { return 15; }
int practice_bonus() { return 10; }
int success() { return 10; }
int power_point(object me) { return 1; }

string perform_action_file(string action)
{
        return __DIR__"sougu-yingzhua/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【搜骨鹰爪功】" ZJBR NOR;
    msg += "搜骨鹰爪功是一门高深的爪法，招式奇诡，难以捉摸，擅长连续攻击和制敌要害。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  空手状态。" ZJBR;
    msg += "  基本内功等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "  最大内力不低于 " HIB "600" NOR " 点。" ZJBR;
    msg += "  后天膂力不低于 " HIG "33" NOR " 点。" ZJBR;
    msg += "  无其他前置技能等级要求。（请注意：与搜骨鹰爪功(sougu.c)在基本爪法要求上存在差异，请以实际代码为准。）" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  爪法（claw）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "40" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "40" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "30" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "30" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;

    // 连环飞鹰抓 (lianhuan)
    msg += HIC "  连环飞鹰抓 (lianhuan)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      当前处于非连环飞鹰抓效果状态。" ZJBR;
    msg += "      空手状态。" ZJBR;
    msg += "      基本内功等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      基本爪法等级不低于 " HIY "140" NOR " 级。" ZJBR;
    msg += "      搜骨鹰爪功等级不低于 " HIY "140" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "      当前精力不低于 " HIG "200" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对敌人发动一次性连续多段攻击。" ZJBR;
    msg += "      连击次数基础值：(搜骨鹰爪功等级 / 100) * 2。实际攻击次数在此基础上增加玩家的基础攻击次数，且总次数最少4次，最多8次。" ZJBR;
    msg += "      在连击过程中，攻击方的攻击力和非兵器伤害临时提高，提高数值为搜骨鹰爪功等级的五分之一。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力：(最终攻击次数 * 20 - 20) 点。" ZJBR;
    msg += "      消耗精力：最终攻击次数 * 5 点。" ZJBR;
    msg += "      使用后自身进入忙乱状态，持续 1 + 随机(1) 回合。" ZJBR ZJBR;

    // 赤血爪 (xue)
    msg += HIC "  赤血爪 (xue)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      空手状态。" ZJBR;
    msg += "      搜骨鹰爪功等级不低于 " HIY "60" NOR " 级。" ZJBR;
    msg += "      基本内功等级不低于 " HIY "80" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "220" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对敌人发动一次高伤害的单体攻击。" ZJBR;
    msg += "      命中判定：比较攻击方的爪法技能等级与防御方的招架技能等级（使用 COMBAT_D->hit_determination）。" ZJBR;
    msg += "      伤害计算：若命中，伤害值约为 攻击方爪法技能等级 * 65%。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力：若命中，消耗 " HIB "200" NOR " 点；若未命中，消耗 " HIB "100" NOR " 点。" ZJBR;
    msg += "      若命中，自身进入忙乱状态 3 回合；若未命中，自身进入忙乱状态 4 回合。" ZJBR ZJBR;

    // 牧野鹰扬 (yingyang)
    msg += HIC "  牧野鹰扬 (yingyang)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      当前处于非忙乱状态。" ZJBR;
    msg += "      空手状态。（代码中未体现此限制，请根据实际情况确认）" ZJBR;
    msg += "      后天膂力不低于 " HIG "30" NOR " 点。" ZJBR;
    msg += "      搜骨鹰爪功等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "800" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      攻击命中时，有几率制住敌人，使其无法动弹（忙乱）。" ZJBR;
    msg += "      成功率计算：比较 (攻击方经验值 / 10000 * 攻击方搜骨鹰爪功等级) 与 (防御方经验值 / 20000 * 防御方躲闪技能等级)。" ZJBR;
    msg += "      成功制住敌人后，敌人忙乱的回合数约为搜骨鹰爪功等级除以 30，最多持续 10 回合。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      使用消耗内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "      若未能成功制住敌人，自身将进入忙乱状态 2 回合。" ZJBR;

    return msg;
}
