// shedao-neigong 蛇岛内功

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_force(string force)
{
	return force=="shenlong-xinfa";
}

int valid_learn(object me)
{
	return ::valid_learn(me);
}

int practice_skill(object me)
{
    return notify_fail("蛇岛内功只能通过学或是从运用(exert)中增加熟练度。\n");
}

string exert_function_file(string func)
{
    return __DIR__"shedao-neigong/" + func;
}
string query_description()
{
    string msg;

    msg = HIY "【蛇岛内功】" ZJBR NOR;
    msg += WHT "神龙教的特殊内功心法，据传源自蛇岛，气息诡异，与中原武学迥异。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  通常需满足基本内功 (`force`) 的学习条件。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功（force）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  无法练习，只能通过学习 (`learn`) 或运用 (`exert`) 提升等级。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  作为基础内功，提供基本的内力上限和恢复加成。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  （相关目录不存在或无法访问，无法分析具体的 `exert` 招式）" ZJBR ZJBR;

    msg += HIY "〖可互备技能〗" ZJBR NOR;
    msg += "  神龙心法 (`shenlong-xinfa`)。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 此内功只能与神龙心法互备。" ZJBR;

    return msg;
}
