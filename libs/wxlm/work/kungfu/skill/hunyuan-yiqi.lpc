// hunyuan-yiqi.c 少林 混元一气功
// dts@xkx, cleansword@xkx

inherit FORCE;

int valid_enable(string usage)
{
	return usage == "force";
}

int query_neili_improve(object me)
{
	int lvl;

	if (me->query("sex"))
		return 0;

	lvl = (int)me->query_skill("hunyuan-yiqi", 1);
	return lvl * lvl * 15 * 20 / 100 / 200;
}

int valid_force(string force)
{
	return force == "yijinjing" ||
	       force == "taiji-shengong" ||
	       force == "wudang-xinfa" ||
	       force == "shaolin-xinfa";
}

int valid_learn(object me)
{
 int  nb, nf, nh, ns;
	nb = (int)me->query_skill("buddhism", 1);
	nf = (int)me->query_skill("force", 1);
	nh = (int)me->query_skill("hunyuan-yiqi", 1);
	ns = (int)me->query("guilty");

	if (me->query("sex"))
		return notify_fail("你已经破了色戒，无法再学习混元一气功！\n");

	if (me->query("gender") != "男性")
		return notify_fail("你非童男之体，不能练习混元一气功。\n");

	if (nb < nh && nb < 200)
		return notify_fail("你的禅宗心法修为不够，无法领会更高深的混元一气功。\n");

	if (nf < 30)
		return notify_fail("你的基本内功火候还不够，无法学习混元一气功。\n");

	if (nf < nh)
		return notify_fail("你的基本内功火候还不够，无法领会更高深的混元一气功。\n");

	if (ns > 0)
		return notify_fail("你屡犯僧家数戒，无法领会更高深的混元一气功。\n");

	return ::valid_learn(me);
}

int practice_skill(object me)
{
	return notify_fail("混元一气功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"hunyuan-yiqi/" + func;
}

string query_description()
{
    string msg;

    msg = HIY "【混元一气功】" ZJBR NOR;
    msg += "华山派上乘内功心法，由岳不群所创。此功法需保持童子之身方可修炼。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  须为男性。" ZJBR;
    msg += "  须为童子身（sex == 0）。" ZJBR;
    msg += "  基本内功等级需达到 " HIY "30" NOR " 级。" ZJBR;
    msg += "  禅宗心法等级不能低于混元一气功等级（若禅宗心法低于 " HIY "200" NOR " 级）。" ZJBR;
    msg += "  基本内功等级需高于或等于混元一气功等级。" ZJBR;
    msg += "  不能有罪恶 (guilty == 0)。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功（force）。" ZJBR ZJBR;

    msg += HIY "〖可互备内功〗" ZJBR NOR;
    msg += "  可与 易筋经 (yijinjing), 太极神功 (taiji-shengong), 武当心法 (wudang-xinfa), 少林心法 (shaolin-xinfa) 配合。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  无法练习，只能通过学习 (learn) 提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  修炼者每提升一级混元一气功，最大内力上限提升 (仅限童子身)。" ZJBR;
    msg += "  具体公式：等级 * 等级 * 15 * 20 / 100 / 200" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;

    msg += HIC "  混元战气 (powerup)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      当前内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升自身攻击力和防御力。" ZJBR;
    msg += "      提升数值 = 激发内功等级 / 3。" ZJBR;
    msg += "      持续时间 = 激发内功等级 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      若在战斗中使用，自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  长啸震岳 (roar)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      当前内力 " HIB "600" NOR " 点。" ZJBR;
    msg += "      非安全区。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对环境内所有生物进行一次精神攻击判定。" ZJBR;
    msg += "      成功率判定：比较（自身激发内功等级 / 2 + 随机（自身激发内功等级 / 2））与 目标后天根骨 * 2。" ZJBR;
    msg += "      判定成功后对目标造成精神伤害，伤害值 = 自身激发内功等级 - (目标最大内力 / 10)。" ZJBR;
    msg += "      若目标内力低于（自身激发内功等级 * 2），则会额外受到精神损伤（等同于伤害值）。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "150" NOR " 点，气血 " HIR "10" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "5" NOR " 秒。" ZJBR;
    msg += "      会对所有受到影响的生物结仇。" ZJBR;

    return msg;
}