
#include <combat.h>

#define BINGFENG HIW "冰封绝杀" NOR

inherit F_SSERVER;

string query_name() { return "冰封"ZJBR"绝杀"; }

int perform(object me, object target)
{
    int damage;
    string msg;
    int ap, dp;

    if (! target) target = offensive_target(me);

    if (! target || ! me->is_fighting(target))
        return notify_fail(BINGFENG "只能对战斗中的对手使用。\n");

    if (me->query_skill("xuanbing_hanshuang", 1) < 100)
        return notify_fail("你的玄冰寒霜拳还不够娴熟，无法施展" BINGFENG "。\n");

    if (me->query("neili") < 200)
        return notify_fail("你的真气不够，无法施展" BINGFENG "。\n");

    if (me->query_skill_mapped("cuff") != "xuanbing_hanshuang")
        return notify_fail("你没有激发玄冰寒霜拳，无法使用" BINGFENG "。\n");

    if (! living(target))
        return notify_fail("对方都已经这样了，用不着这么狠吧。\n");

    msg = HIW "$N" HIW "双拳凝聚寒气，施展出「冰封绝杀」，周身温度骤降，朝$n" HIW "猛然击出！\n" NOR;

    ap = me->query_skill("cuff") + me->query_skill("force");
    dp = target->query_skill("dodge") + target->query_skill("parry");

    if (COMBAT_D->hit_determination(me,target,ap,dp))
    {
        damage = ap / 2 + random(ap / 2);
        me->add("neili", -150);
        msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 60,
                                   HIW "$n" HIW "只觉一股寒流袭来，全身瞬间被冰霜覆盖，"
                                   "动弹不得，$N" HIW "的重拳正中$n" HIW "胸口！\n" NOR);
        me->start_busy(2);
        if (ap / 3 + random(ap) > dp)
        {
            target->start_busy(ap / 100 + 2);
            target->apply_condition("ice_poison", random(ap / 10) + (me->query("jiali") / 5));
        }
    } else
    {
        me->add("neili", -50);
        msg += CYN "可是$n" CYN "看破了$N" CYN "的招式，巧妙地避开了这致命一击。\n" NOR;
        me->start_busy(3);
    }
    message_combatd(msg, me, target);
    return 1;
}
