int valid_enable(string usage) {return usage == "sword" || usage == "parry";}

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 1000)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("force") < 120)
		return notify_fail("你的内功火候太浅。\n");

	if ((int)me->query_skill("sword", 1) < 120)
		return notify_fail("你的基本剑法火候不够，无法学习追魂夺命剑。\n");

	if ((int)me->query_skill("sword", 1) < (int)me->query_skill("zhuihun-jian", 1))
		return notify_fail("你的基本剑法水平有限，无法领会更高深的追魂夺命剑。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level   = (int) me->query_skill("zhuihun-jian",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 60)
		return notify_fail("你的体力目前没有办法练习追魂夺命剑。\n");

	if ((int)me->query("neili") < 90)
		return notify_fail("你的内力不够，无法练习追魂夺命剑。\n");
	
	me->add("qi", -50);
	me->add("neili", -82);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"zhuihun-jian/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【追魂夺命剑】" ZJBR NOR;
    msg += WHT "这是一门迅捷凌厉的高深剑法，招式变幻莫测。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力 不低于 " HIY "1000" NOR " 点。" ZJBR;
    msg += "  内功有效激发 等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "  基本剑法 等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "  基本剑法 等级必须不低于 基本追魂夺命剑 等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  剑法 (sword)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须装备剑类武器。" ZJBR;
    msg += "  当前 气血 不低于 " HIY "60" NOR " 点。" ZJBR;
    msg += "  当前 内力 不低于 " HIY "90" NOR " 点。" ZJBR;
    msg += "  每次练习消耗 气血 " HIR "50" NOR " 点，消耗 内力 " HIR "82" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  该技能暂无被动效果。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  诛天弑神 (zhu)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      基本追魂夺命剑 等级不低于 " HIB "160" NOR " 级。" ZJBR;
    msg += "      追魂夺命剑 已激发为剑法。" ZJBR;
    msg += "      已激发内功。" ZJBR;
    msg += "      当前 内力 不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      使用 COMBAT_D 进行攻击判定。" ZJBR;
    msg += "      基础伤害值：(剑法有效激发 等级 + 基本追魂夺命剑 等级)" ZJBR;
    msg += "      实际伤害：基础伤害值 / 2 + 随机(基础伤害值)。 COMBAT_D 内部可能再次调整，约等于 基础伤害 * 2。" ZJBR;
    msg += "      命中判定: (剑法有效激发 等级 / 2) 与 目标招架有效激发 等级进行随机比较。" ZJBR;
    msg += "      若命中判定成功，则有几率使目标陷入 忙乱 状态 1-3 秒。" ZJBR;
    msg += "      有几率震飞目标武器：自身 臂力 > 目标 臂力 / 2 时，几率触发。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗 内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      自身 忙乱 " HIR "1" NOR " 秒。" ZJBR;

    return msg;
}

