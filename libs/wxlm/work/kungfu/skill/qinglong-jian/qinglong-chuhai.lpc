// 青龙出海


#include <combat.h>

inherit F_SSERVER;

string query_name() { return "青龙出海"; }
string *pfm_type() { return ({ "club", }); }

int perform(object me, object target)
{
    string msg;
    int ap, dp, damage;
    object weapon = me->query_temp("weapon");

    if (! target) target = offensive_target(me);

    if (! target || ! me->is_fighting(target))
        return notify_fail("「青龙出海」只能对战斗中的对手使用。\n");

    if (! objectp(weapon) || weapon->query("skill_type") != "club")
        return notify_fail("你使用的武器不对。\n");

    if ((int)me->query_skill("qinglong-jian", 1) < 100)
        return notify_fail("你的青龙天罡枪法不够娴熟，不会使用「青龙出海」。\n");

    if ((int)me->query_skill("sixiang-shengong", 1) < 100)
        return notify_fail("你的四象神功不够高，不能使用「青龙出海」。\n");

    if ((int)me->query("neili") < 200)
        return notify_fail("你的真气不够，无法使用「青龙出海」。\n");

    if (me->query_skill_mapped("club") != "qinglong-jian")
        return notify_fail("你没有激发青龙天罡枪法，无法使用「青龙出海」。\n");

    if (! living(target))
        return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

    msg = HIC "$N" HIC "使出青龙天罡枪法的绝技「青龙出海」，手中" + weapon->name() +
          HIC "如蛟龙出水，带着呼啸声向$n" HIC "扑去！\n" NOR;

    ap = me->query_skill("club") + me->query_skill("force");
    dp = target->query_skill("dodge") + target->query_skill("parry");

    //pve命中增加50%
    if (!playerp(target))
    {
        ap = ap * 15 / 10;
    }

    if (COMBAT_D->hit_determination(me,target,ap,dp))
    {
        damage = ap * 3;

        // 青龙吐雾奥义增加伤害
        damage += damage * COMBAT_D->get_skill_aoyi_level(me, "青龙吐雾") / 10;

        //pve伤害x2
        if (!playerp(target))
        {
            damage = damage * 2;
        }

        me->add("neili", -150);
        msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 100,
                                   HIR "$n" HIR "躲闪不及，被$N" HIR
                                   "这一枪击中，顿时鲜血直流！\n" NOR);

        // 清除四象归元状态，可以重新使用四象归元
        me->delete_temp("sixiang_guiyuan");
        me->start_busy(2);
    } else
    {
        msg += CYN "可是$n" CYN "看破了$N"
               CYN "的企图，巧妙地避开了这一枪。\n" NOR;
        me->add("neili", -50);
        me->start_busy(3);
    }
    message_combatd(msg, me, target);

    return 1;
}
