
#include <combat.h>

#define SHANBENG "「" HIY "山崩地裂" NOR "」"

inherit F_SSERVER;

string query_name() { return "山崩"ZJBR"地裂"; }

int perform(object me, object target)
{
    int damage;
    string msg;
    int ap, dp;

    if (! target) target = offensive_target(me);

    if (! target || ! me->is_fighting(target))
        return notify_fail(SHANBENG "只能对战斗中的对手使用。\n");

    if (me->query_skill("liangshan_boxing", 1) < 100)
        return notify_fail("你的梁山霸拳还不够娴熟，无法施展" SHANBENG "。\n");

    if (me->query("neili") < 200)
        return notify_fail("你的真气不够，无法施展" SHANBENG "。\n");

    if (me->query_skill_mapped("cuff") != "liangshan_boxing")
        return notify_fail("你没有激发梁山霸拳，无法使用" SHANBENG "。\n");

    if (! living(target))
        return notify_fail("对方都已经这样了，用不着这么狠吧。\n");

    msg = HIY "$N" HIY "怒喝一声，双拳齐出，一招「山崩地裂」轰向$n" HIY "！\n" NOR;

    ap = me->query_skill("cuff") + me->query_skill("force");
    dp = target->query_skill("dodge") + target->query_skill("parry");

    if (COMBAT_D->hit_determination(me,target,ap,dp))
    {
        damage = ap / 2 + random(ap / 2);
        me->add("neili", -150);
        msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 55,
                                   HIR "只听「轰」的一声巨响，$n" HIR "被$N" HIR
                                   "这排山倒海的一击轰中，口吐鲜血，连退数步！\n" NOR);
        me->start_busy(3);
    } else
    {
        me->add("neili", -50);
        msg += CYN "可是$n" CYN "看破了$N" CYN "的企图，轻轻一跃，躲开了这雷霆一击。\n" NOR;
        me->start_busy(3);
    }
    message_combatd(msg, me, target);
    return 1;
}
