
#include <combat.h>

#define BAWANG "「" HIW "霸王举鼎" NOR "」"

inherit F_SSERVER;

string query_name() { return "霸王举鼎"; }

int perform(object me, object target)
{
    int damage;
    string msg;
    int ap, dp;

    if (! target) target = offensive_target(me);

    if (! target || ! me->is_fighting(target))
        return notify_fail(BAWANG "只能对战斗中的对手使用。\n");

    if (me->query_skill("liangshan_boxing", 1) < 140)
        return notify_fail("你的梁山霸拳还不够娴熟，无法施展" BAWANG "。\n");

    if (me->query("neili") < 400)
        return notify_fail("你的真气不够，无法施展" BAWANG "。\n");

    if (me->query_skill_mapped("cuff") != "liangshan_boxing")
        return notify_fail("你没有激发梁山霸拳，无法使用" BAWANG "。\n");

    if (! living(target))
        return notify_fail("对方都已经这样了，用不着这么狠吧。\n");

    msg = HIW "$N" HIW "气沉丹田，双臂暴涨，施展出「霸王举鼎」，双拳携排山倒海之势轰向$n" HIW "！\n" NOR;

    ap = me->query_skill("cuff") + me->query_skill("force");
    dp = target->query_skill("dodge") + target->query_skill("parry");

    if (COMBAT_D->hit_determination(me,target,ap,dp))
    {
        damage = ap + random(ap / 2);
        me->add("neili", -300);
        msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 70,
                                   HIR "$n" HIR "只觉得一股巨力袭来，'砰'的一声被击中胸口，"
                                   "如遭雷击，口吐鲜血，连连后退！\n" NOR);
        me->start_busy(3);
        if (ap / 3 + random(ap) > dp && ! target->is_busy())
            target->start_busy(ap / 100 + 2);
    } else
    {
        me->add("neili", -100);
        msg += CYN "可是$n" CYN "看破了$N" CYN "的企图，飞身一跃，躲开了这雷霆一击。\n" NOR;
        me->start_busy(3);
    }
    message_combatd(msg, me, target);
    return 1;
}
