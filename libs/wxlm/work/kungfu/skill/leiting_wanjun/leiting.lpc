
#include <combat.h>

#define LEITING HIY "雷霆万钧" NOR

inherit F_SSERVER;

string query_name() { return "雷霆"ZJBR"万钧"; }

int perform(object me, object target)
{
    int damage;
    string msg;
    int ap, dp;

    if (! target) target = offensive_target(me);

    if (! target || ! me->is_fighting(target))
        return notify_fail(LEITING "只能对战斗中的对手使用。\n");

    if (me->query_skill("leiting_wanjun", 1) < 100)
        return notify_fail("你的雷霆万钧拳还不够娴熟，无法施展" LEITING "。\n");

    if (me->query("neili") < 200)
        return notify_fail("你的真气不够，无法施展" LEITING "。\n");

    if (me->query_skill_mapped("cuff") != "leiting_wanjun")
        return notify_fail("你没有激发雷霆万钧拳，无法使用" LEITING "。\n");

    if (! living(target))
        return notify_fail("对方都已经这样了，用不着这么狠吧。\n");

    msg = HIY "$N" HIY "双拳带着雷霆万钧之势，施展出「雷霆万钧」，周身电光闪烁，朝$n" HIY "猛然轰去！\n" NOR;

    ap = me->query_skill("cuff") + me->query_skill("force");
    dp = target->query_skill("dodge") + target->query_skill("parry");

    if (COMBAT_D->hit_determination(me,target,ap,dp))
    {
        damage = ap / 2 + random(ap / 2);
        me->add("neili", -150);
        msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 60,
                                   HIY "$n" HIY "只觉一股强大的力量袭来，全身如遭雷击，"
                                   "顿时麻痹不已，$N" HIY "的雷霆一击正中$n" HIY "胸口！\n" NOR);
        me->start_busy(2);
        if (ap / 3 + random(ap) > dp)
        {
            target->start_busy(ap / 100 + 2);
            target->apply_condition("thunder_poison", random(ap / 10) + (me->query("jiali") / 5));
        }
    } else
    {
        me->add("neili", -50);
        msg += CYN "可是$n" CYN "看破了$N" CYN "的招式，巧妙地避开了这雷霆一击。\n" NOR;
        me->start_busy(3);
    }
    message_combatd(msg, me, target);
    return 1;
}
