int valid_enable(string usage)
{
	return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
    int level;
    level = (int) me->query_skill("lonely-sword", 1);

    if( level >= 180 )
        return action[sizeof(action)-1];
    else if( level >= 175 )
        return action[sizeof(action)-2];
    else if( level >= 168 )
        return action[sizeof(action)-3];
    else if( level >= 161 )
        return action[sizeof(action)-4];
    else if( level > 350 )
        return ([
            "action": HIC + replace_string(feiyue_msg[random(sizeof(feiyue_msg))], "$w", "$w" HIC) + NOR,
            "dodge": 200 + random(50),
            "parry": 200 + random(50),
            "force": 200 + random(100),
            "attack": 300,
            "damage": 100 + random(20),
            "damage_type": "刺伤",
        ]);
    else
        return action[random(sizeof(action))];
}

int valid_learn(object me)
{
	object ob;

	if( !(ob = me->query_temp("weapon"))
	||   (string)ob->query("skill_type") != "sword" )
		return notify_fail("你必须先找一把剑才能练剑法。\n");

	if (me->query("family/family_name") != "华山派" &&
	    me->query("family/family_name") != "华山剑宗")
		return notify_fail("你不是华山弟子，无法理解九剑归一的要领。\n");
	
	if (me->query("int") < 34)
		return notify_fail("你的天资不足，无法理解九剑归一的剑意。\n");

	if (me->query("character") == "心狠手辣")
		return notify_fail("你一心想杀尽敌人，没能理解九剑归一的的真正含义。\n");

	if (me->query("character") == "阴险奸诈")
		return notify_fail("你一心想怎么学好剑法去害人，结果没能理解九剑归一。\n");

	if (me->query("character") == "光明磊落")
		return notify_fail("你心中暗道：什么九剑归一，乱七八糟的，没有半点气势。\n");

	if (me->query_skill("sword", 1) < me->query_skill("lonely-sword", 1))
		return notify_fail("你的基本剑法造诣有限，无法理解更高深的九剑归一。\n");

	return 1;
}

/**
 * @brief 九剑归一防御技能，通过剑意化解攻击
 * @param object ob 攻击者
 * @param object me 防御者
 * @param int damage 伤害值
 * @param object weapon 武器对象
 * @return mixed 返回防御结果映射或空值
 * @details 当满足条件时，可以通过独孤九剑的剑意化解部分攻击伤害
 */
mixed valid_damage(object ob, object me, int damage, object weapon)
{
        mapping result;
        int ap, dp;
        int cost;

        if ((int)me->query_skill("lonely-sword", 1) < 150
           || me->query_skill_mapped("parry") != "lonely-sword"
           || (int)me->query("neili") < 500
           || !ob->query_temp("weapon")
           || ! living(me))
                return;

        cost = damage / 2;
        if (cost > 100) cost = 100;

        ap = ob->query_skill("force") * 12 + ob->query("max_neili") + ob->query_skill("count", 1) * 6;
        dp = me->query_skill("force") * 12 + me->query("neili");

        if (ap / 2 + random(ap) < dp)
        {
                me->add("neili", -cost);
                result = ([ "damage": -(damage * 3 / 4) ]);

                switch (random(2))
                {
                case 0:
                        result += (["msg" : HIY "$n" HIY "心领神会独孤九剑精髓，剑意"
                                            "如虹，轻松化解$N" + HIY "这一招的攻势，"
                                            "$N" HIY "只觉攻击如泥牛入海。\n"
                                            NOR]);
                        break;
                case 1:
                        result += (["msg" : HIY "$n" HIY "剑法通神，以无招胜有招，"
                                            "$N" HIY "的攻击在$n" HIY "面前显得破绽"
                                            "百出，轻易被化解。\n" NOR]);
                        break;
                default:
                        result += (["msg" : HIY "但见$n" HIY "剑意凌然，九剑归一，"
                                            "$N" HIY "的招式在$n" HIY "眼中如同儿戏，"
                                            "轻描淡写便化解于无形。\n" NOR]);
                        break;
                }
                return result;
        }
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
    int lvl;
    int i;

    lvl = me->query_skill("lonely-sword", 1);
    i = random(lvl);

    if (i < 50) return;

    if (i < 150)
    {
        victim->receive_wound("qi", damage_bonus / 2);
        return HIR "只见$N" HIR "剑势如虹，一剑刺中$n" HIR "要害，剑气直逼内府！" NOR "\n";
    }
    else if (i < 250)
    {
        victim->receive_wound("qi", damage_bonus);
        return HIG "$N" HIG "长啸一声，剑光闪烁，$n" HIG "只觉一阵剧痛，鲜血如注！" NOR "\n";
    }
    else
    {
        victim->receive_wound("qi", damage_bonus * 1.5);
        victim->start_busy(1);
        return HIM "$N" HIM "身形一晃，手中" + me->query_temp("weapon")->name() + HIM "已穿透$n" HIM "身体，剑气四溢，令$n难以招架！" NOR "\n";
    }
}

int practice_skill(object me)
{
	object weapon;
	int cost;
	if (!objectp(weapon = me->query_temp("weapon")) || 
	    (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");

	if (me->query("family/family_name") != "华山派" &&
	    me->query("family/family_name") != "华山剑宗")
		return notify_fail("你不是华山弟子，无法演练九剑归一总诀式。\n");
	
	
	if ((int)me->query("qi") < 150)
		return notify_fail("你的体力不够练九剑归一。\n");

	cost = me->query_skill("lonely-sword", 1) / 3 + 50;
	if ((int)me->query("neili") < cost)
		return notify_fail("你的内力不够练九剑归一。\n");

	tell_object(me, HIG "你心中默念九剑归一之「总诀式」，将手中" + weapon->name() + HIG "随意挥舞击刺。"NOR"\n");

	me->receive_damage("qi", 120);
	me->add("neili", -cost);

	return 1;
}

/**
 * @brief 返回主技能名称
 * @return string 主技能名称
 * @details 用于演练系统，指明此技能属于哪个主技能
 */
string main_skill() { return "xuanming-sword"; }

string perform_action_file(string action)
{
	return __DIR__"lonely-sword/" + action;
}

int difficult_level()
{
	return 400;
}

string query_description()
{
    string msg;

    msg = HIY "【独孤九剑】" ZJBR NOR;
    msg += WHT "剑魔独孤求败所创绝世剑法，号称破尽天下武学。讲究「无招胜有招」，以意驭剑，" ZJBR;
    msg += WHT "剑随意动，后发先至，料敌机先，攻敌之不得不守。其精髓在于「总诀式」统领下的破剑、破刀、" ZJBR;
    msg += WHT "破枪、破鞭、破索、破掌、破箭、破气各式，应变无穷。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  必须装备剑类武器。" ZJBR;
    msg += "  必须是「华山派」或「华山剑宗」弟子。" ZJBR;
    msg += "  先天 " HIY "悟性" NOR " 不低于 " HIC "34" NOR " 点。" ZJBR;
    msg += "  性格不能为「心狠手辣」、「阴险奸诈」或「光明磊落」。" ZJBR;
    msg += "  " HIY "基本剑法" NOR " 等级需大于等于 " HIY "独孤九剑" NOR " 等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  剑法 (`sword`)。" ZJBR;
    msg += "  招架 (`parry`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  必须装备剑类武器。" ZJBR;
    msg += "  必须是「华山派」或「华山剑宗」弟子。" ZJBR;
    msg += "  当前 " HIR "气血" NOR " 不低于 " HIR "150" NOR " 点。" ZJBR;
    msg += "  当前 " HIB "内力" NOR " 不低于 " HIB "(独孤九剑等级 / 3) + 50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血 " HIR "120" NOR " 点，消耗内力 " HIB "(独孤九剑等级 / 3) + 50" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // hit_ob
    msg += "  普通攻击命中时，有几率触发额外特效（基于 " HIY "独孤九剑等级" NOR " 随机判定）：" ZJBR;
    msg += "    - 低几率 (50 <= 随机数 < 150)：造成额外 " HIR "气血" NOR " 伤害，伤害量约为 `本次基础伤害 / 2`。" ZJBR;
    msg += "    - 中几率 (150 <= 随机数 < 250)：造成额外 " HIR "气血" NOR " 伤害，伤害量约为 `本次基础伤害`。" ZJBR;
    msg += "    - 高几率 (随机数 >= 250)：造成大量额外 " HIR "气血" NOR " 伤害，伤害量约为 `本次基础伤害 * 1.5`，并使目标忙乱 " HIR "1" NOR " 秒。" ZJBR ZJBR;
    msg += "  当受到攻击时，满足以下条件可触发九剑归一防御特效：" ZJBR;
    msg += "    - " HIY "独孤九剑" NOR " 等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "    - 激发招架为 " HIY "独孤九剑" NOR "。" ZJBR;
    msg += "    - 当前 " HIB "内力" NOR " 不低于 " HIB "500" NOR " 点。" ZJBR;
    msg += "    - 攻击者必须持有武器。" ZJBR;
    msg += "  防御判定：" ZJBR;
    msg += "    - 攻击方 AP = 内功等级 * 12 + 最大内力 + 阴阳八卦 * 6" ZJBR;
    msg += "    - 防御方 DP = 内功等级 * 12 + 当前内力" ZJBR;
    msg += "    - 判定条件：`(AP / 2 + 随机(AP) < DP)`" ZJBR;
    msg += "  成功效果：" ZJBR;
    msg += "    - 减免 " HIY "75%" NOR " 的攻击伤害。" ZJBR;
    msg += "    - 消耗内力：`伤害值 / 2`（最多100点）。" ZJBR;
    msg += "    - 随机显示九剑归一的防御描述信息。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (Perform)〗" ZJBR NOR; // perform_action_file

    msg += HIC "  破气式 (po)" ZJBR NOR; // 注意：代码中为 po.c (破气式)
    msg += "    使用要求：" ZJBR;
    msg += "      " HIY "独孤九剑" NOR " 等级不低于 " HIY "80" NOR " 级。" ZJBR; // 代码要求为 80
    msg += "      当前 " HIB "内力" NOR " 不低于 " HIB "400" NOR " 点。" ZJBR; // 代码要求为 400
    // msg += "      激发剑法为 \" HIY \"独孤九剑\" NOR \"。\" ZJBR; // 代码中未检查激发
    msg += "      必须装备剑类武器。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      发动多次连续攻击，基础攻击次数由参照连招表，对 NPC 额外增加 2 次。" ZJBR;
    msg += "      命中判定：每次攻击均使用标准 `普攻` 判定流程，" HIY "此招式不附加额外 AP 或 DP 修正" NOR "。" ZJBR;
    msg += "      伤害计算：每次命中均使用标准 `普攻` 伤害流程，" HIY "此招式不附加额外伤害" NOR "。" ZJBR;
    msg += "      附加效果：无。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗 " HIB "内力" NOR HIB " 300" NOR " 点。" ZJBR; // 代码消耗为 300
    msg += "      自身忙乱 " HIR "2" NOR " 秒。" ZJBR;

    msg += HIC "  独孤剑意 (yi)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      " HIY "独孤九剑" NOR " 等级不低于 " HIY "80" NOR " 级。" ZJBR; // 代码要求为 80
    msg += "      " HIY "内功有效激发" NOR " 等级不低于 " HIY "(未明确要求)" NOR " 级。" ZJBR; // yi.c 未检查 force 等级
    msg += "      当前 " HIB "内力" NOR " 不低于 " HIB "300" NOR " 点。" ZJBR; // 代码要求为 300
    // msg += "      激发剑法为 \" HIY \"独孤九剑\" NOR \"。\" ZJBR; // 代码中未检查激发
    msg += "      必须装备剑类武器。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      以无招胜有招之剑意攻击对手。" ZJBR;
    msg += "      命中判定：" HIY "使用特殊 AP/DP 计算：" NOR ZJBR;
    msg += "        攻击方 AP = 有效剑法等级 + 有效内功等级" ZJBR;
    msg += "        防御方 DP = 有效招架等级 + 有效内功等级" ZJBR;
    msg += "        对 NPC 时，攻击方 AP 额外提升 20%。" ZJBR;
    msg += "        调用 `通用命中接口` 进行命中判定。" ZJBR;
    msg += "      伤害计算：" HIY "若命中，使用特殊伤害公式：" NOR ZJBR;
    msg += "        基础伤害 Damage = (上述 AP * 3 / 2) + 随机(上述 AP)" ZJBR;
    msg += "        调用 `通用伤害接口` 造成伤害，伤害系数为 70。" ZJBR;
    msg += "      附加效果：无。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗 " HIB "内力" NOR HIB " 200" NOR " 点。" ZJBR; // 代码消耗 200
    msg += "      自身忙乱 " HIR "1" NOR " 秒。" ZJBR; // 代码忙乱 1 秒

    msg += HIC "  剑破长空 (xiao)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      " HIY "独孤九剑" NOR " 等级不低于 " HIY "200" NOR " 级。" ZJBR;
    msg += "      " HIY "内功有效激发" NOR " 等级不低于 " HIY "200" NOR " 级。" ZJBR; // 代码要求为 200
    msg += "      当前 " HIB "内力" NOR " 不低于 " HIB "1000" NOR " 点。" ZJBR;
    msg += "      激发剑法为 " HIY "独孤九剑" NOR "。" ZJBR;
    msg += "      必须装备剑类武器。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      独孤九剑终极奥义，含多段效果。" ZJBR;
    msg += "      " HIY "阶段一：兵器击落判定" NOR ZJBR;
    msg += "        AP 计算：基础 `剑法激发等级` + `武学修养`。" ZJBR;
    msg += "        DP 计算：基础 `招架激发等级` + `武学修养`。" ZJBR;
    msg += "        特殊修正：若目标用 辟邪/葵花，我方 AP 提升 20%；若目标用 六脉，我方 AP 降低 20%。对 NPC 时 AP 提升 20%。" ZJBR;
    msg += "        判定条件：`(AP / 2 + 随机(AP) > DP 且 随机(4)==1)` 或 `(AP / 2 > DP)`。" ZJBR;
    msg += "        成功效果：打落目标兵器。" ZJBR;
    msg += "      " HIY "阶段二：主伤害判定" NOR ZJBR;
    msg += "        命中判定：使用阶段一修正后的 AP/DP，判定条件为 `(AP / 2 + 随机(AP) > DP)`。" ZJBR;
    msg += "        伤害计算 (若命中)：" ZJBR;
    msg += "          基础 Damage = `剑法激发等级 * 2` + `武学修养 + 最大内力2%`。" ZJBR;
    msg += "          臂力加成：`Damage += Damage / 500 * 后天臂力`。" ZJBR;
    msg += "          奥义加成：若有「苍松之劲」，`Damage += 奥义等级 * 有效剑法等级 / 3`。" ZJBR;
    msg += "          技能加成：`Damage += 独孤九剑基础等级`。" ZJBR;
    msg += "          PVE 加成：对 NPC 时，`Damage` 额外增加 50%。" ZJBR;
    msg += "        额外伤害 (若命中且 random(3)<2)：" HIY "有 2/3 几率触发" NOR "，造成 `(Damage - 目标防御/4) / 2` 的额外伤害和气血损伤。" ZJBR;
    msg += "        附加效果 (若命中)：目标忙乱 " HIR "1" NOR " 秒。" ZJBR;
    msg += "        附加效果 (若未命中)：目标忙乱 " HIR "1" NOR " 秒。" ZJBR;
    msg += "      " HIY "阶段三：斩杀判定" NOR ZJBR;
    msg += "        条件：主伤害结算后，目标当前气血低于其最大气血的 10%。" ZJBR;
    msg += "        效果：直接秒杀目标。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      阶段一消耗 " HIB "内力" NOR HIB " 200" NOR " 点。" ZJBR;
    msg += "      命中主伤害：额外消耗 " HIB "内力" NOR HIB " 600" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中主伤害：额外消耗 " HIB "内力" NOR HIB " 500" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 独孤九剑威力极大，但对悟性、内力、气血及相关技能要求甚高。" ZJBR;
    msg += "2. 练习和施展独孤九剑必须使用剑类武器。" ZJBR;
    msg += "3. 熟练掌握各项基本功（剑法、内功、轻功、招架）及武学修养对发挥九剑威力至关重要。" ZJBR;
    msg += "4. 特殊招式的具体冷却时间请以游戏内实际为准。" ZJBR;

    return msg;
}

