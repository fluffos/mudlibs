#define CN_NAME "龙虎劲"
inherit SKILL;

mapping *action = ({
([      "action": "$N单手上抬，一招龙虎劲的［虎啸山林］，对准$n的$l猛击下去",
	"force" : 300,
	"attack": 85,
	"dodge" : 10,
	"parry" : 5,
	"damage": 100,
	"lvl"   : 0,
	"skill_name" : "龙虎劲",
	"damage_type":  "瘀伤"
]),
([      "action": "$N一招龙虎劲的［龙腾虎跃］，身子已向左转成弓箭步，两臂向后成钩手，呼\n"
		  "的一声轻响，反击$n$l",
	"force" : 350,
	"attack": 25,
	"dodge" : 15,
	"parry" : 10,
	"damage": 610,
	"lvl"   : 30,
	"skill_name" : "龙虎劲",
	"damage_type":  "瘀伤"
]),
});

string query_txt()
{
	return "要求：基本拳脚 150级";
}

int valid_learn(object me)
{
	if ((int)me->query_skill("unarmed", 1) < 150)
		return notify_fail("你的拳脚根基有限，无法学习龙虎劲。\n");
	return 1;
}

int valid_enable(string usage)
{
	return usage == "unarmed" ;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action)-1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int)me->query_skill("longhujin", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i - 1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 60)
		return notify_fail("你现在手足酸软，休息一下再练吧。\n");

	if ((int)me->query("neili") < 80)
		return notify_fail("你的内力不够了。\n");

	me->receive_damage("qi", 50);
	me->add("neili", -60);

	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"long-hu-jin/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【龙虎劲】" ZJBR NOR;
    msg += "一门基础拳脚功夫，招式刚猛，蕴含龙腾虎跃之势。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  基本拳脚 (unarmed) 等级不低于 " HIY "150" NOR " 级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  拳脚（unarmed）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  气血不低于 " HIR "60" NOR " 点。" ZJBR;
    msg += "  内力不低于 " HIB "80" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "60" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖招式列表〗" ZJBR NOR; // action mapping
    msg += "  虎啸山林 (0级)" ZJBR;
    msg += "  龙腾虎跃 (30级)" ZJBR;
    // (所有招式均为瘀伤，具体攻击、防御、伤害系数等请参考源码action数组)
    msg += ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform/exert
    msg += "  无。" ZJBR; // 目录不存在，无特殊招式

    return msg;
}