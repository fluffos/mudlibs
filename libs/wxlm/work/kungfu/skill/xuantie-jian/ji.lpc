

inherit F_SSERVER;

string name() { return "狂海之势"; }
string query_name() { return "狂海之势"; }
string *pfm_type() { return ({ "sword", }); }
int perform(object me, object target)
{
        object weapon;
        int damage;
        string msg;
        mixed ap,dp;
        int status_flag=0;

        if( !target ) target = offensive_target(me);
        if( !target || !target->is_character() || !me->is_fighting(target) )
                return notify_fail("狂海之势只能对战斗中的对手使用。\n");

        if( !objectp(weapon=query_temp("weapon", me)) )
                return notify_fail("你未持武器，不能使用狂海之势！\n");

        if( me->query_skill("force") < 300 )
                return notify_fail("你的内功火候未到，无法施展狂海之势！\n");

        if( me->query_skill("sword") < 300 )
                return notify_fail("你的剑法火候未到，无法施展狂海之势！\n");

        if( query("max_neili", me) <= 3000 )
                return notify_fail("你的内力不够施展狂海之势！\n");
                                
        if( me->query_skill_mapped("sword") != "xuantie-jian")
                return notify_fail("你必须激发玄铁剑法作为剑法才能够使用狂海之势。\n");
                                
        if( me->query_skill_mapped("force") != "surge-force")
                return notify_fail("你必须激发怒海狂涛作为内功才能够使用狂海之势。\n");
                                
        if( query("neili", me) <= query("max_neili", me)/10 )
                return notify_fail("你的内力不够施展狂海之势！\n");

                
        msg=HIW"\n$N轻起后腰，左手抽出背负的"+query("name", weapon)+NOR+HIW"，跨步挺兵击出一招「狂海之势」，空中的风像海浪汹涌入潮搬撕开!\n"NOR;
        
        ap=attack_power(me, "sword") / 2 + attack_power(me, "force") / 2;
        dp=defense_power(target, "dodge");
        damage = damage_power(me, "sword");
        damage+= query("jiali", me);
        damage+= damage / 500 * me->query_str();
        damage += COMBAT_D->get_skill_aoyi_level(me, "黯然隐雾") * damage / 10;//每层意境
        damage += damage / 3;

        if ( ap/2 + random(ap) > dp )
        {
                msg+=HIC"$N力道使得极猛,挺剑送出。$n"NOR+HIC"早有提防，却万想不到来势竟是如海浪入岸般迅猛，力眼见闪避不及，拼命招架，但泰山压顶的巨力冲其袭来,只得连退了五六步，才勉强拿椿站定，登时脸如金纸。\n"NOR;
                if(random(100) > 100 -  (COMBAT_D->get_skill_aoyi_level(me, "黯然隐雾") * 3))
                {
                    damage += damage * 8 / 10;
                    msg+= HIY"$N"HIY"触发致命一击，对$n"HIY"造成「80%」的伤害！\n";
                    target->start_busy(2);
                } 

                damage = damage * 3 / 4;

                if (damage < 0)
                 damage = 1;


                COMBAT_D->real_damage(me, target, damage);

                addn("neili", -query("max_neili", me)/20, me);
                me->start_busy(2+random(2));
                status_flag=1;
        }

        else if( query("int", me)>random(query("int", target)*2) )
        {
                msg+=HIC"$N一剑犹如千均之力击出，而右手长袖顺势拂去，$n"NOR+HIC"顷刻间只感五脏六腑都似翻转了，站在当地，既不敢运气，\n"
                        "也不敢移动半步，便如僵了一般。\n"NOR;
                if (! target->is_busy())
                   target->start_busy(2);
                me->start_busy(2);
                status_flag=1;
        }
        else if (query("str", me)>random(query("str", target)*2) )
        {
                msg+=HIC"$N只觉对方冲撞而来的劲力绵绵不绝，越来越强,运出所有内力振臂一击。\n" NOR;
                addn("neili", -query("max_neili", me)/40, me);
                addn("neili", -query("max_neili", target)/20, target);

                //你对xxx造成了xxx点内力削减
                tell_object(me, HIR"你对"+target->name()+"造成了"+query("max_neili", target)/20+"点内力削减。\n"NOR);
                me->start_busy(1+random(2));
                status_flag=1;
        }
        else
        {
                msg += HIG"$n凌空飞跃，身形疾闪，使出本门轻功，身子往回轻轻一侧，$N的发招数尽数落空。\n"NOR;
                me->start_busy(2+random(2));
        }
        addn("neili", -200, me);
        
        if(query("neili", me) < 0) set("neili",0,me);
        if(query("neili", target) < 0) set("neili",0,target);
        

        message_combatd(sort_msg(msg)+"\n", me, target);
        if (status_flag==1) COMBAT_D->report_status(target);
        return 1;
}

