int valid_enable(string usage) { return usage=="finger" || usage=="parry"; }

int valid_combine(string combo) { return combo=="haotian-zhang"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练玄阳指必须空手。\n");

	if (me->query("gender") != "男性")
		return notify_fail("你阳气不足，无法学玄阳指。\n");

	if ((int)me->query("max_neili") < 1000)
		return notify_fail("你的内力太弱，无法练玄阳指。\n");

	if ((int)me->query_skill("force") < 150)
		return notify_fail("你的内功火候不够，无法学玄阳指。\n");

	if ((int)me->query_skill("finger", 1) < 100)
		return notify_fail("你的基本指法火候不够，无法学玄阳指。\n");

	if ((int)me->query_skill("finger", 1) < (int)me->query_skill("tanzhi-shentong", 1))
		return notify_fail("你的基本指法水平有限，无法领会更高深的玄阳指。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 70)
		return notify_fail("你的内力不够练玄阳指!\n");

	me->receive_damage("qi", 55);
	me->add("neili", -65);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"sun-finger/" + action;
}
//等级提升，是否学会新的招式
string query_skill_up(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
	 {
		if(level == action[i]["lvl"])
		 {
		     return action[i]["skill_name"];
		 }
	 }
	  return "no";
}

string query_description()
{
    string msg;

    msg = HIY "【玄阳指】" ZJBR NOR;
    msg += "玄阳指是一门以阳刚之气凝聚指尖的高深指法武功，招式奇绝，指力刚猛。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  需空手修炼。" ZJBR;
    msg += "  仅限男性学习（需阳刚之气）。" ZJBR;
    msg += "  最大内力不低于 " HIB "1000" NOR " 点。" ZJBR;
    msg += "  内功等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "  基本指法等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "  基本指法等级需大于玄阳指等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  指法（finger）。" ZJBR;
    msg += "  招架（parry）。" ZJBR;
    msg += "  可与「浩天掌」（haotian-zhang）互备。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  气血：不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "55" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "65" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // hit_ob, valid_damage, skill_improved etc.
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform/exert

    msg += HIC "  神指点穴 (dian)" ZJBR NOR; // 招式名称
    msg += "    使用要求：" ZJBR; // 招式使用要求
    msg += "      玄阳指等级 " HIY "80" NOR " 级。" ZJBR;
    msg += "      激发指法为玄阳指。" ZJBR;
    msg += "      战斗中使用。" ZJBR;
    msg += "    效果描述：" ZJBR; // 招式效果描述
    msg += "      命中判定：系统计算命中率 = 自身基本指法等级与对方基本招架等级比较。" ZJBR;
    msg += "      命中公式：COMBAT_D->hit_determination(me, target, 指法等级, 对方招架等级)。" ZJBR;
    msg += "      效果：使目标陷入忙乱状态，无法反击。" ZJBR;
    msg += "      目标忙乱回合数 = 指法等级/26 + 2。" ZJBR;
    msg += "    消耗与代价：" ZJBR; // 消耗与代价
    msg += "      命中：无特殊消耗。" ZJBR;
    msg += "      未命中：自身忙乱 " HIR "1" NOR " 回合。" ZJBR ZJBR;

    msg += HIC "  一指乾坤 (qiankun)" ZJBR NOR; // 招式名称
    msg += "    使用要求：" ZJBR; // 招式使用要求
    msg += "      玄阳指等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "160" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "500" NOR " 点。" ZJBR;
    msg += "      激发指法为玄阳指。" ZJBR;
    msg += "      战斗中使用。" ZJBR;
    msg += "    效果描述：" ZJBR; // 招式效果描述
    msg += "      命中判定：自身(指法等级+内功等级)与对方(招架等级+内功等级)比较。" ZJBR;
    msg += "      命中公式：COMBAT_D->hit_determination(me, target, 指法等级+内功等级, 对方招架等级+对方内功等级)。" ZJBR;
    msg += "      对非玩家目标命中率提高50%。" ZJBR;
    msg += "      伤害计算：基础伤害 = (指法等级+内功等级)/3 + 随机(0至(指法等级+内功等级)/4)。" ZJBR;
    msg += "      对非玩家目标伤害翻倍。" ZJBR;
    msg += "      最终伤害穿透率为66%（COMBAT_D->do_damage的第五个参数）。" ZJBR;
    msg += "    消耗与代价：" ZJBR; // 消耗与代价
    msg += "      命中：内力 " HIB "200" NOR " 点，忙乱 " HIR "1" NOR " 回合。" ZJBR;
    msg += "      未命中：内力 " HIB "50" NOR " 点，忙乱 " HIR "3" NOR " 回合。" ZJBR ZJBR;

    msg += HIC "  一阳疗伤 (heal)" ZJBR NOR; // 招式名称
    msg += "    使用要求：" ZJBR; // 招式使用要求
    msg += "      最大内力 " HIB "1500" NOR " 点。" ZJBR;
    msg += "      当前内力 " HIB "1000" NOR " 点。" ZJBR;
    msg += "      当前气血 " HIR "200" NOR " 点。" ZJBR;
    msg += "      当前精神 " HIR "100" NOR " 点。" ZJBR;
    msg += "      必须激发某种内功。" ZJBR;
    msg += "      非战斗状态下使用。" ZJBR;
    msg += "      只能为他人疗伤，不能自疗。" ZJBR;
    msg += "    效果描述：" ZJBR; // 招式效果描述
    msg += "      恢复目标的气血和精神伤害。" ZJBR;
    msg += "      恢复气血值 = 100 + 内功等级 + 玄阳指等级 * 3。" ZJBR;
    msg += "      恢复精神值 = 100 + 内功等级/3 + 玄阳指等级。" ZJBR;
    msg += "      若目标气血或精神小于等于0，则设置为1。" ZJBR;
    msg += "    消耗与代价：" ZJBR; // 消耗与代价
    msg += "      内力消耗 " HIB "1000" NOR " 点。" ZJBR;
    msg += "      气血消耗 " HIR "150" NOR " 点。" ZJBR;
    msg += "      精神消耗 " HIR "80" NOR " 点。" ZJBR;
    msg += "      使用后目标忙乱 " HIR "2" NOR " 回合。" ZJBR;
    msg += "      使用后自身忙乱 " HIR "10" NOR " 回合。" ZJBR;

    return msg;
}
