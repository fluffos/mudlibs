// luoying.c 落英缤纷

#include <combat.h>

inherit F_SSERVER;

string query_name() { return "落英缤纷"; }
string *pfm_type() { return ({ "hand", }); }

int perform(object me, object target)
{
    string msg;
    int ap, dp;
    int damage, count;

    if (! target)
    {
        me->clean_up_enemy();
        target = me->select_opponent();
    }

    if (! target || ! me->is_fighting(target))
        return notify_fail("「落英缤纷」只能对战斗中的对手使用。\n");

    if (me->query("family/family_name") != "灵鹫宫")
        return notify_fail("你不是灵鹫宫弟子，无法施展「落英缤纷」。\n");

    if ((int)me->query_skill("zhemei-shou", 1) < 180)
        return notify_fail("你的折梅手不够娴熟，不会使用「落英缤纷」。\n");

    if ((int)me->query_skill("force") < 220)
        return notify_fail("你的内功修为不够高，难以运用「落英缤纷」。\n");

    if ((int)me->query("neili") < 300)
        return notify_fail("你现在真气不足，不能使用「落英缤纷」。\n");

    if (me->query_skill_mapped("hand") != "zhemei-shou")
        return notify_fail("你没有激发折梅手，无法施展「落英缤纷」。\n");

    if (! living(target))
        return notify_fail("对方已经无法战斗，无需使用如此强力的招式。\n");

    msg = HIY "$N" HIY "纤手轻扬，使出折梅手绝技「落英缤纷」，顿时漫天掌影，如同无数花瓣飘向$n" HIY "！\n" NOR;


    ap = me->query_skill("hand") + me->query("int") * 10;
    dp = target->query_skill("dodge") + target->query_skill("parry");

    me->add("neili", -200);

    if (COMBAT_D->hit_determination(me,target,ap,dp))
    {
        damage = me->query_skill("zhemei-shou", 1) / 2;
        msg += HIM "$n" HIM "被$N" HIM "的掌影所迷惑，无法分辨真伪，被连续击中数下，受伤不轻！\n" NOR;

        // 额外攻击次数，受到玩家悟性的影响
        count = me->query("int") / 5;
        if (count < 2) count = 2;
        if (count > 5) count = 5;

        count = COMBAT_D->query_base_attack_number(me,query_name()) + count;


        for (int i = 0; i < count; i++)
        {
            if (! me->is_fighting(target)) break;
            COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
        }


        me->start_busy(2);
    }
    else
    {
        msg += CYN "$n" CYN "冷静应对，将$P" CYN "的招式一一化解，没有受到伤害。\n" NOR;
        me->start_busy(3);
    }

    message_combatd(msg, me, target);

    return 1;
}
