// fenghua.c 风华绝代

#include <combat.h>

inherit F_SSERVER;

string query_name() { return "风华"ZJBR"绝代"; }
string *pfm_type() { return ({ "hand", }); }

int perform(object me, object target)
{
    string msg;
    int ap, dp, damage;

    if (! target)
    {
        me->clean_up_enemy();
        target = me->select_opponent();
    }

    if (! target || ! me->is_fighting(target))
        return notify_fail("「风华绝代」只能对战斗中的对手使用。\n");

    if (me->query("family/family_name") != "灵鹫宫")
        return notify_fail("你不是灵鹫宫弟子，无法施展「风华绝代」。\n");

    if ((int)me->query_skill("zhemei-shou", 1) < 150)
        return notify_fail("你的折梅手不够娴熟，不会使用「风华绝代」。\n");

    if ((int)me->query_skill("force") < 200)
        return notify_fail("你的内功修为不够高，难以运用「风华绝代」。\n");

    if ((int)me->query("neili") < 200)
        return notify_fail("你现在真气不够，不能使用「风华绝代」。\n");

    if (me->query_skill_mapped("hand") != "zhemei-shou")
        return notify_fail("你没有激发折梅手，无法施展「风华绝代」。\n");

    if (! living(target))
        return notify_fail("对方已经无法战斗，无需使用如此强力的招式。\n");

    msg = HIM "$N" HIM "身姿曼妙，如同凌波仙子，施展出绝世之技「风华绝代」，双手如翩跹起舞，攻向$n" HIM "！\n" NOR;


    ap = me->query_skill("hand") + me->query("kar") * 10;
    dp = target->query_skill("parry") + target->query_skill("dodge");

    me->add("neili", -150);

    if (COMBAT_D->hit_determination(me,target,ap,dp))
    {
        damage = me->query_skill("zhemei-shou", 1);
        damage += random(damage / 2);

        msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 70,
            HIM "$n" HIM "被$N" HIM "优雅却凌厉的攻势所震撼，无法躲避，受到重创！\n" NOR);

        me->start_busy(2);
    }
    else
    {
        msg += CYN "$n" CYN "见$P" CYN "招式华美，但暗藏杀机，小心应对，成功躲避了这一击。\n" NOR;
        me->start_busy(3);
    }

    message_combatd(msg, me, target);

    return 1;
}
