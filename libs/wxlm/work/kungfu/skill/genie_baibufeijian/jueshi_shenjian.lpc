
#include <combat.h>

#define JUESHI "「" HIY "绝世神剑" NOR "」"

inherit F_SSERVER;

string query_name() { return "绝世神剑"; }

int perform(object me, object target)
{
    object weapon;
    int damage, ap, dp, attack_time, i;
    string msg;

    if (! target) target = offensive_target(me);

    if (! target || ! me->is_fighting(target))
        return notify_fail(JUESHI "只能对战斗中的对手使用。\n");

    if (! objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对，难以施展" JUESHI "。\n");

    if ((int)me->query_skill("genie_baibufeijian", 1) < 250)
        return notify_fail("你的百步飞剑不够娴熟，难以施展" JUESHI "。\n");

    if (me->query_skill_mapped("sword") != "genie_baibufeijian")
        return notify_fail("你没有激发百步飞剑，难以施展" JUESHI "。\n");

    if ((int)me->query("neili") < 800)
        return notify_fail("你现在的真气不足，难以施展" JUESHI "。\n");

    if (! living(target))
        return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

    ap = me->query_skill("sword") + me->query_skill("force") + me->query_skill("dodge");
    dp = target->query_skill("dodge") + target->query_skill("parry") + target->query_skill("force");

    msg = HIY "$N" HIY "凝神静气，手中" + weapon->name() + HIY "剑芒暴涨，吟诵道：" NOR "\n";
    msg += HIC "「剑气纵横三万里，一剑光寒十九洲」" NOR "\n";
    msg += HIW "$N" HIW "身形一闪，" JUESHI "已然施展！" NOR "\n";

    if (COMBAT_D->hit_determination(me,target,ap,dp))
    {
        damage = ap * 2 + random(ap);
        me->add("neili", -800);
        attack_time = COMBAT_D->query_base_attack_number(me,query_name());
        msg += HIR "$n" HIR "只觉得眼前剑光闪烁，$N" HIR "的身影已经消失不见，四面八方都是刺来的剑！" NOR "\n";
        message_combatd(msg, me, target);

        for(i = 0; i < attack_time; i++)
        {
            if (! me->is_fighting(target))
                break;
            COMBAT_D->do_attack(me, target, weapon, 0);
        }

        msg = HIY "\n$N" HIY "长剑一收，" JUESHI "的威力犹如排山倒海，$n" HIY "已经被打得体无完肤。" NOR "\n";
        me->start_busy(2);
        COMBAT_D->real_damage(me, target, damage);
    } else
    {
        me->add("neili", -400);
        msg += HIG "可是$n" HIG "看破了$N" HIG "的剑招，凭借着高超的武艺，堪堪躲过了这致命的一击。" NOR "\n";
        me->start_busy(4);
    }
    message_combatd(msg, me, target);
    return 1;
}
