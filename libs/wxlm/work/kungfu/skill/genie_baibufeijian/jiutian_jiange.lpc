
#include <combat.h>

#define JIUTIAN "「" HIM "九天剑歌" NOR "」"

inherit F_SSERVER;

string query_name() { return "九天"ZJBR"剑歌"; }

int perform(object me, object target)
{
    object weapon;
    int damage, ap, dp;
    string msg, pmsg;

    if (! target) target = offensive_target(me);

    if (! target || ! me->is_fighting(target))
        return notify_fail(JIUTIAN "只能对战斗中的对手使用。\n");

    if (! objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对，难以施展" JIUTIAN "。\n");

    if ((int)me->query_skill("genie_baibufeijian", 1) < 220)
        return notify_fail("你的百步飞剑不够娴熟，难以施展" JIUTIAN "。\n");

    if (me->query_skill_mapped("sword") != "genie_baibufeijian")
        return notify_fail("你没有激发百步飞剑，难以施展" JIUTIAN "。\n");

    if ((int)me->query("neili") < 400)
        return notify_fail("你现在的真气不足，难以施展" JIUTIAN "。\n");

    if (! living(target))
        return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

    ap = me->query_skill("sword") + me->query_skill("force");
    dp = target->query_skill("dodge") + target->query_skill("parry");

    msg = HIM "$N" HIM "长啸一声，手中" + weapon->name() + HIM "化作九道剑光，吟诵道：\n" NOR;
    msg += HIW "    「一剑光寒十九洲」\n" NOR;
    msg += HIR "    「二剑化为百丈虹」\n" NOR;
    msg += HIG "    「三剑落霞与孤鹜」\n" NOR;
    msg += HIY "    「四剑飞渡黄河水」\n" NOR;
    msg += HIC "    「五剑北斗耀紫薇」\n" NOR;
    msg += HIM "    「六剑凤舞九天外」\n" NOR;
    msg += HIB "    「七剑横扫天山雪」\n" NOR;
    msg += HIW "    「八剑倚天射白虹」\n" NOR;
    msg += HIY "    「九剑荡尽天下魔」\n" NOR;

    if (COMBAT_D->hit_determination(me,target,ap,dp))
    {
        damage = ap + random(ap / 2);
        me->add("neili", -400);
        pmsg = HIR "$n" HIR "被$N" HIR "的" JIUTIAN "所摄，只觉得眼花缭乱，全身上下都是破绽。" NOR "\n";
        msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 100, pmsg);
        target->start_busy(4);
        me->start_busy(2);
    } else
    {
        me->add("neili", -200);
        msg += HIG "可是$n" HIG "看破了$N" HIG "的剑招，巧妙地躲过了这九剑。" NOR "\n";
        me->start_busy(3);
    }
    message_combatd(msg, me, target);
    return 1;
}
