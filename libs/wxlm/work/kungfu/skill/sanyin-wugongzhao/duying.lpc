 
// duying.c 蜈蚣毒影


#include <combat.h>

inherit F_SSERVER;

string query_name() { return "蜈蚣毒影"; }

int perform(object me, object target)
{
    string msg;
    int i, attack_time;

    if (!target) target = offensive_target(me);

    if (!me->is_fighting(target))
        return notify_fail("「蜈蚣毒影」只能对战斗中的对手使用。\n");

    if ((int)me->query_skill("sanyin-wugongzhao", 1) < 120)
        return notify_fail("你的三阴蜈蚣爪不够娴熟，无法施展「蜈蚣毒影」。\n");

    if (me->query("neili") < 400)
        return notify_fail("你的内力不足，无法施展「蜈蚣毒影」。\n");

    if (me->query_temp("weapon"))
        return notify_fail("你必须空手才能使用「蜈蚣毒影」！\n");

    if (!living(target))
        return notify_fail("对方已经这样了，不需要这么费力吧？\n");

    msg = HIR "$N" HIR "怪笑一声，双爪连挥，幻化出无数蜈蚣残影，逼向$n！\n" NOR;
    message_combatd(msg, me, target);

    me->add("neili", -300);
    me->start_busy(2);

    attack_time = COMBAT_D->query_base_attack_number(me,query_name());

    for (i = 0; i < attack_time; i++)
    {
        if (! me->is_fighting(target))
            break;

        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
    }

    return 1;
}