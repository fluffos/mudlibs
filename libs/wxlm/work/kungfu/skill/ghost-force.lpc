// 鬼谷内功 ghost-force

inherit FORCE;

// 函数声明
int valid_enable(string usage);
int valid_learn(object me);
int practice_skill(object me);
string exert_function_file(string func);

int valid_force(string force);

int query_neili_improve(object me);
int difficult_level();
int practice_limit();

// 函数定义

// 该内功可以用于特殊技能
int valid_enable(string usage)
{
    return usage == "force";
}

// 判断是否可以学习
int valid_learn(object me)
{
    if (me->query("gender") == "无性" && me->query("ghost-force", 1) > 49)
        return notify_fail("你无法继续提升鬼谷内功的修为。\n");

    if ((int)me->query_skill("force", 1) < 100)
        return notify_fail("你的基本内功火候不够，无法领悟鬼谷内功。\n");

    if (me->query_skill("force", 1) < me->query_skill("ghost-force", 1))
        return notify_fail("你的基本内功水平有限，无法领悟更高深的鬼谷内功。\n");

    return 1;
}

// 内功特殊功能文件路径
string exert_function_file(string func)
{
    return __DIR__"ghost-force/" + func;
}

// 内力提升效果
int query_neili_improve(object me)
{
    int lvl;

    lvl = (int)me->query_skill("ghost-force", 1);
    return lvl * 15 * 15 / 100 / 200;
}

// 修炼难度
int difficult_level()
{
    return 300;
}

// 练习限制
int practice_limit()
{
    return 200;
}

// 不能通过练习提升
int practice_skill(object me)
{
    return notify_fail("鬼谷内功只能通过学习或锻炼提升。\n");
}

// 判断内功兼容性
int valid_force(string force)
{
    return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【鬼谷内功】" ZJBR NOR; // 基本介绍
    msg += WHT "鬼谷派世代相传的内功心法，据说蕴含天地至理，变幻莫测。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  基本内功等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "  基本内功等级不低于鬼谷内功等级。" ZJBR;
    msg += "  非无性之人方可学习超过 50 级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  内功（force）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  无法通过练习 (practice) 提升，只能通过学习 (learn) 或研究 (research) 提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // query_neili_improve
    msg += "  提升内力上限：效果随等级提升 (公式: `基本等级 * 基本等级 * 0.01125`)。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (内功运用 exert)〗" ZJBR NOR; // exert_function_file
    msg += "  包含多种内功运用，具体效果请参照 `ghost-force/` 目录下的文件。" ZJBR;
    // 注：由于无法访问 ghost-force/ 目录，此处仅作通用说明。

    return msg;
}