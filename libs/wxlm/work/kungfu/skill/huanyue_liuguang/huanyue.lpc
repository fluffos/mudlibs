
#include <combat.h>

#define HUANYUE "「" HIM "幻月无痕" NOR "」"

inherit F_SSERVER;

string query_name() { return "幻月"ZJBR"无痕"; }

int perform(object me, object target)
{
    object weapon;
    int damage;
    string msg;
    int ap, dp;

    if (! target) target = offensive_target(me);

    if (! target || ! me->is_fighting(target))
        return notify_fail(HUANYUE "只能对战斗中的对手使用。\n");

    if (! objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对，难以施展" HUANYUE "。\n");

    if ((int)me->query_skill("huanyue_liuguang", 1) < 100)
        return notify_fail("你的幻月流光剑法不够娴熟，难以施展" HUANYUE "。\n");

    if (me->query_skill_mapped("sword") != "huanyue_liuguang")
        return notify_fail("你没有激发幻月流光剑法，难以施展" HUANYUE "。\n");

    if ((int)me->query("neili") < 200)
        return notify_fail("你现在的真气不够，难以施展" HUANYUE "。\n");

    if (! living(target))
        return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

    msg = HIM "$N" HIM "轻吟剑诀，施展出「幻月无痕」，身形突然变得飘忽不定，" + weapon->name() + HIM "化作点点月光向$n" HIM "笼罩而去！\n" NOR;

    ap = me->query_skill("sword") + me->query_skill("dodge");
    dp = target->query_skill("dodge") + target->query_skill("parry");

    if (COMBAT_D->hit_determination(me,target,ap,dp))
    {
        damage = ap + random(ap / 2);
        me->add("neili", -150);
        msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 55,
                                   HIW "$n" HIW "只觉眼前月光闪烁，$N" HIW "的身影已然消失，紧接着全身传来阵阵刺痛，"
                                   "竟是被$N" HIW "的剑气所伤！\n" NOR);
        me->start_busy(2);
        if (ap / 3 + random(ap) > dp && ! target->is_busy())
            target->start_busy(ap / 200 + 2);
    } else
    {
        me->add("neili", -50);
        msg += CYN "可是$n" CYN "看破了$N" CYN "的身法，巧妙地一个转身，避开了这致命一击。\n" NOR;
        me->start_busy(3);
    }
    message_combatd(msg, me, target);
    return 1;
}
