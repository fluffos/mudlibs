// xiyang-boji.c 西洋搏击术

inherit SKILL;

string *dodge_msg = ({
	"$n身子一扭，恰好躲过了$N这一招。\n",
	"可是$n突然飞身后退，敏捷的躲过了$N这一招。\n",
	"$n奋力横移，闪开了$N的追击。\n",
	"$n身随$N转动，忽快忽慢，让$N无法捕捉到$n的踪影。\n",
	"$n嗔目大喝，气势异样恢弘，$N手一软，招数全然落空。\n",
});

int valid_enable(string usage) { return usage == "dodge"; }

int valid_learn(object me) { return 1; }

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
	if( (int)me->query("qi") < 50 )
		return notify_fail("你的体力太差了，无法练习西洋搏击术。\n");

	me->receive_damage("qi", 40);
	return 1;
}
string query_description()
{
    string msg;

    msg = HIY "【西洋搏击术】" ZJBR NOR;
    msg += "西洋搏击术是一门源自西方的格斗技巧，以灵活多变的闪避动作为主。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  无特殊要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  轻功（dodge）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "40" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  此技能无攻防特效或被动效果，主要用于闪避时提供不同的描述信息 (`query_dodge_msg`)。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无特殊招式。" ZJBR;

    return msg;
}