//mahayana.c  大乘涅磐功
inherit SKILL;

string type() { return "knowledge"; }

int valid_learn(object me)
{
    if ((int)me->query("shen") < 0 )
       return notify_fail("你的邪气太重，无法修炼大乘涅磐功。\n");

    return 1;
}

void skill_improved(object me)
{
}

string query_description()
{
    string msg;

    msg = HIY "【大乘涅磐功】" ZJBR NOR;
    msg += "佛门弟子修炼的一种高深学问，代表对佛法和人生境界的理解。" ZJBR;
    msg += "通常作为学习某些高级佛门武功或知识的前提条件。" ZJBR ZJBR; // 基本介绍 & type

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  人物神圣值 (shen) 不得为负。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // 知识类技能
    msg += "  知识类技能，无法激发。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // 无 practice_skill
    msg += "  通常通过向师傅学习（learn）或阅读相关典籍提升。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // 无 perform/exert
    msg += "  无。" ZJBR;

    return msg;
}
