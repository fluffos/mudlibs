// 函数定义
void create()
{
    // 初始化 action_msg
    action_msg = ({
        HIB "$N" HIB "冷笑一声，手中$w" HIB "挥舞如风，一式" HIW "「暗影鬼斩」" HIB "，刀光若隐若现，直斩$n" HIB "！" NOR,
        HIW "$N" HIW "身形一闪，施展" HIG "「幻影连击」" HIW "，$w" HIW "化作漫天刀影，将$n" HIW "团团包围！" NOR,
        HIC "$N" HIC "目露凶光，手中$w" HIC "猛然斩下，一招" HIY "「流光瞬杀」" HIC "，刀芒划破长空，直取$n" HIC "要害！" NOR,
        HIM "$N" HIM "身随刀走，刀随心动，使出" HIR "「瞬步斩」" HIM "，$w" HIM "犹如鬼魅般袭向$n" HIM "！" NOR,
        HIY "$N" HIY "大喝一声：" HIW "「鬼影迷踪」" HIY "，$w" HIY "化作一道闪电，迅疾无比地斩向$n" HIY "！" NOR,
        HIR "$N" HIR "催动内力，$w" HIR "上罩起一层血红刀芒，一式" HIG "「血刃夺魂」" HIR "，刀气逼人，令$n" HIR "心神俱裂！" NOR,
        HIG "$N" HIG "身影闪烁，$w" HIG "舞动如风，施展" HIM "「诡步迷心」" HIG "，令$n" HIG "分不清虚实，无从招架！" NOR,
        HIY "$N" HIY "深吸一口气，手中$w" HIY "发出嗡嗡刀鸣，猛然一式" HIC "「鸣刀斩空」" HIY "，刀气直冲$n" HIY "！" NOR,
        HIC "$N" HIC "面无表情，$w" HIC "轻描淡写地划出一道弧线，一招" HIW "「虚无缥缈」" HIC "，令人无法捉摸！" NOR,
        HIM "$N" HIM "嘴角露出一丝冷笑，骤然使出" HIR "「鬼影重重」" HIM "，$w" HIM "化作无数虚影，齐齐攻向$n" HIM "！" NOR,
    });
}

// 判断技能是否可用
int valid_enable(string usage)
{
    return usage == "blade" || usage == "parry";
}

// 判断技能是否可学
int valid_learn(object me)
{
    // 变量声明
    mapping skills;
    string *skill_names;
    int blade_count = 0;
    int i;

    // 等级检查
    if (me->query("level") < 100)
    {
        tell_object(me, HIR "你的等级不足，无法领悟「鲨齿鬼刀」的奥秘。" NOR "\n");
        return 0;
    }

    // 技能检查
    skills = me->query_skills();
    if (!mapp(skills))
    {
        tell_object(me, HIR "你还没有学会任何技能，无法领悟「鲨齿鬼刀」。" NOR "\n");
        return 0;
    }

    skill_names = keys(skills);
    for (i = 0; i < sizeof(skill_names); i++)
    {
        if (SKILL_D(skill_names[i])->valid_enable("blade") && skills[skill_names[i]] >= 400)
        {
            blade_count++;
        }
    }

    if (blade_count < 6)
    {
        tell_object(me, HIR "你需要精通（400级）至少六门刀法，才能领悟「鲨齿鬼刀」的精髓。" NOR "\n");
        return 0;
    }

    return 1;
}

// 练习技能
int practice_skill(object me)
{
    // 变量声明
    object weapon;
    int cost;
    mapping skills;
    string *skill_names;
    int blade_count = 0;
    int i;

    // 武器检查
    weapon = me->query_temp("weapon");
    if (!objectp(weapon) || weapon->query("skill_type") != "blade")
    {
        tell_object(me, HIR "你需要持刀才能练习「鲨齿鬼刀」。" NOR "\n");
        return 0;
    }

    // 气血检查
    if (me->query("qi") < 300)
    {
        tell_object(me, HIR "你的气血不足，无法练习「鲨齿鬼刀」。" NOR "\n");
        return 0;
    }

    // 内力消耗计算
    cost = me->query_skill("weizhuang_guidao", 1) + 100;
    if (me->query("neili") < cost)
    {
        tell_object(me, HIR "你的内力不足，无法练习「鲨齿鬼刀」。" NOR "\n");
        return 0;
    }

    // 技能检查
    skills = me->query_skills();
    skill_names = keys(skills);
    for (i = 0; i < sizeof(skill_names); i++)
    {
        if (SKILL_D(skill_names[i])->valid_enable("blade") && skills[skill_names[i]] >= 400)
        {
            blade_count++;
        }
    }

    if (blade_count < 6)
    {
        tell_object(me, HIR "你需要精通（400级）至少六门刀法，才能练习「鲨齿鬼刀」。" NOR "\n");
        return 0;
    }

    // 练习信息
    tell_object(me, HIC "你凝神静气，手中" + weapon->name() + HIC "闪烁着诡异的光芒，练习着「鲨齿鬼刀」的奥义。" NOR "\n");

    // 消耗
    me->receive_damage("qi", 250);
    me->add("neili", -cost);

    return 1;
}

// 战斗中特效函数
mixed hit_ob(object me, object victim, int damage_bonus)
{
    // 变量声明
    int lvl;
    int extra_damage;
    string msg;

    // 变量初始化
    lvl = me->query_skill("weizhuang_guidao", 1);
    extra_damage = lvl + random(lvl);

    // 触发特效
    if (random(100) < 40)
    {
        victim->receive_wound("qi", extra_damage, me);
        msg = HIB "$N" HIB "使出" HIW "「暗影鬼斩」" HIB "，刀光如鬼魅般穿透$n" HIB "的防御，$n" HIB "只觉一阵剧痛，" HIR "鲜血直流" HIB "！" NOR "\n";
        return msg;
    }
    else if (random(100) < 30)
    {
        victim->start_busy(2 + random(2));
        msg = HIM "$N" HIM "骤然施展" HIR "「鬼影重重」" HIM "，$n" HIM "被无数刀影所迷惑，一时间竟不知如何应对！" NOR "\n";
        return msg;
    }
    else if (random(100) < 20)
    {
        msg = HIR "$N" HIR "冷笑一声，手中$w" HIR "发出刺耳的刀鸣，一式" HIG "「血刃夺魂」" HIR "，$n" HIR "只觉心神剧震，攻势大减！" NOR "\n";
        victim->add_temp("apply/attack", -lvl / 5);
        victim->add_temp("apply/defense", -lvl / 5);
        call_out("remove_effect", 10, victim, lvl / 5);
        return msg;
    }

    return;
}

// 移除效果
void remove_effect(object victim, int amount)
{
    if (victim)
    {
        victim->add_temp("apply/attack", amount);
        victim->add_temp("apply/defense", amount);
        tell_object(victim, HIG "你感觉周身一轻，刀气的压制终于消散了。" NOR "\n");
    }
}

// 技能的使用文件路径
string perform_action_file(string action)
{
    return __DIR__"weizhuang_guidao/" + action;
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("weizhuang_guidao", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];

}

// 技能描述
string query_description()
{
    string msg;

    msg = HIY "【鲨齿鬼刀】" ZJBR NOR;
    msg += HIW "卫庄的绝世刀法，招式诡异莫测，出手如鬼魅般迅疾致命。" ZJBR;
    msg += "此刀法融合多种刀法精髓，讲究诡诈与速度，令人防不胜防。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  人物等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "  精通（400级）至少六门刀法。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  刀法（blade）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  装备类型为刀（blade）的武器。" ZJBR;
    msg += "  气血不低于 " HIR "300" NOR " 点。" ZJBR;
    msg += "  内力不低于 " HIB "鲨齿鬼刀等级 + 100" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "250" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "鲨齿鬼刀等级 + 100" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  战斗中有以下随机特效触发几率：" ZJBR;
    msg += "  1. 暗影鬼斩（40%几率）：" ZJBR;
    msg += "     造成额外伤害 = 鲨齿鬼刀等级 + 随机(鲨齿鬼刀等级)" ZJBR;
    msg += "  2. 鬼影重重（30%几率）：" ZJBR;
    msg += "     使目标忙乱2-3秒" ZJBR;
    msg += "  3. 血刃夺魂（20%几率）：" ZJBR;
    msg += "     降低目标攻防 = 鲨齿鬼刀等级/5，持续10秒" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;

    // 血刃狂舞
    msg += HIC "  血刃狂舞 (xueren_kuangwu)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      鲨齿鬼刀等级 " HIY "200" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "800" NOR " 点。" ZJBR;
    msg += "      装备刀类武器。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      施展连续多次攻击，攻击次数为3-5次。" ZJBR;
    msg += "      命中判定：" ZJBR;
    msg += "        每次攻击命中率 = 随机(使用者基本刀法等级) > 目标基本招架等级/2" ZJBR;
    msg += "      伤害计算：" ZJBR;
    msg += "        每次命中伤害 = 鲨齿鬼刀等级/2 + 随机(鲨齿鬼刀等级/2)" ZJBR;
    msg += "        伤害系数为40-50%" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "500" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    // 鬼影闪
    msg += HIC "  鬼影闪 (guiying_shan)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      鲨齿鬼刀等级 " HIY "180" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "600" NOR " 点。" ZJBR;
    msg += "      装备刀类武器。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      身形诡异闪烁，以迅雷不及掩耳之势斩向目标。" ZJBR;
    msg += "      命中判定：" ZJBR;
    msg += "        命中率 = 随机(使用者基本刀法等级) > 目标基本轻功等级/2" ZJBR;
    msg += "      伤害计算：" ZJBR;
    msg += "        伤害 = 鲨齿鬼刀等级 * 1.5 + 随机(鲨齿鬼刀等级/2)" ZJBR;
    msg += "        伤害系数为60%" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "400" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    // 终极鬼斩
    msg += HIC "  终极鬼斩 (zhongji_guizhan)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      鲨齿鬼刀等级 " HIY "220" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "1000" NOR " 点。" ZJBR;
    msg += "      装备刀类武器。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      聚集全身力量，爆发血红色刀芒，威力巨大的终极一击。" ZJBR;
    msg += "      命中判定：" ZJBR;
    msg += "        命中率 = 随机(使用者基本刀法等级) > 目标基本轻功等级/3" ZJBR;
    msg += "      伤害计算：" ZJBR;
    msg += "        伤害 = 鲨齿鬼刀等级 * 2 + 随机(鲨齿鬼刀等级 * 2)" ZJBR;
    msg += "        伤害系数为70%" ZJBR;
    msg += "      额外效果：" ZJBR;
    msg += "        未命中时对自己造成气血伤害，为最大气血的10-15%" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "700" NOR " 点，自身忙乱 " HIR "4" NOR " 秒。" ZJBR;

    return msg;
}