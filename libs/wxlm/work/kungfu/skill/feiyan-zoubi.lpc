// feiyan-zhoubi 飞檐走壁

inherit SKILL;

string *dodge_msg = ({
	"$n身形急转，避过了$N的攻势。\n",
	"可是$n拔地而起，躲过了$N这一招。\n",
	"$n作闪右避，总算躲过了$N这一招。\n",
});

int valid_enable(string usage) { return (usage == "dodge") || (usage == "move"); }

int valid_learn(object me) { return 1; }

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
	if( (int)me->query("qi") < 50 )
		return notify_fail("你的体力太差了，迈不开丁字步。");

	me->receive_damage("qi", 40);
	return 1;
}
string query_description()
{
    string msg;

    msg = HIY "【飞檐走壁】" ZJBR NOR;
    msg += WHT "基础轻功之一，练习后可身轻如燕，行走于屋檐墙壁之上。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  无特殊要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  轻功（dodge）。" ZJBR;
    msg += "  移动（move）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "40" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  提供简单的闪避描述（`query_dodge_msg`）。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR; // 代码中未发现 perform_action_file 或 exert_function_file

    return msg;
}
