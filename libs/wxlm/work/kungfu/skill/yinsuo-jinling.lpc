int valid_enable(string usage) { return usage == "whip" || usage == "parry"; }

int valid_learn(object me)
{
	object weapon;

	if (me->query("gender") != "女性")
		return notify_fail("金玲银索只有女性能练。\n");

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "whip")
		return notify_fail("你必须先找一条鞭子才能练金玲银索。\n");

	if ((int)me->query("max_neili") < 500)
		return notify_fail("你的内力不足，没有办法练金玲银索，多练些内力再来吧。\n");

	if ((int)me->query_skill("force") < 100)
		return notify_fail("你的内功火候太浅，没有办法练金玲银索。\n");

	if ((int)me->query_skill("whip", 1) < 20)
		return notify_fail("你的基本鞭法火候太浅，没有办法练金玲银索。\n");

	if ((int)me->query_skill("whip", 1) < (int)me->query_skill("yinsuo-jinling", 1))
		return notify_fail("你的基本鞭法水平还不够，无法领会更高深的金玲银索。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("yinsuo-jinling", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "whip")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力不够练金玲银索。\n");

	if ((int)me->query("neili") < 60)
		return notify_fail("你的内力不够练金玲银索。\n");

	me->receive_damage("qi", 45);
	me->add("neili", -55);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"yinsuo-jinling/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【金玲银索】" ZJBR NOR;
    msg += WHT "金玲银索是一门以灵巧多变著称的高级鞭法。" ZJBR;
    msg += "此鞭法招式轻盈飘逸，如银索飞舞，变化多端，令人防不胜防。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  性别要求：女性" ZJBR;
    msg += "  基本鞭法等级：20级" ZJBR;
    msg += "  基本内功等级：100级" ZJBR;
    msg += "  最大内力：500点" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  鞭法 (whip)" ZJBR;
    msg += "  招架 (parry)" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血消耗：45点" ZJBR;
    msg += "  内力消耗：55点" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  风神诀 (feng)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      金玲银索 等级：130级" ZJBR;
    msg += "      基本内功 等级：200级" ZJBR;
    msg += "      当前内力：400点" ZJBR;
    msg += "      需激发为鞭法" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      连续攻击敌人三次，每次都可能造成伤害" ZJBR;
    msg += "      第一次攻击：命中率取决于使用者鞭法有效激发与目标招架有效激发的比较" ZJBR;
    msg += "      第二次攻击：命中率取决于使用者鞭法有效激发与目标轻功有效激发的比较" ZJBR;
    msg += "      第三次攻击：有机会击落对方武器，成功率取决于使用者鞭法有效激发与目标内功有效激发的比较" ZJBR;
    msg += "      伤害计算：伤害 = 鞭法有效激发等级 / 2 + 随机(鞭法有效激发等级 / 2)" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力：300点" ZJBR;
    msg += "      自身忙乱：2-5秒" ZJBR ZJBR;

    msg += HIC "  银索点穴 (dian)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      金玲银索 等级：50级" ZJBR;
    msg += "      当前内力：50点" ZJBR;
    msg += "      需激发为鞭法" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      使用金玲银索点中敌人穴道，使其暂时无法行动" ZJBR;
    msg += "      命中率取决于使用者鞭法有效激发与目标招架有效激发的比较" ZJBR;
    msg += "      成功后使敌人忙乱 金玲银索等级/20 + 2 秒" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力：50点（未明确标出，但推测如此）" ZJBR;
    msg += "      失败后自身忙乱：2秒" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 金玲银索只有女性可以学习" ZJBR;
    msg += "2. 基本鞭法的等级不能低于金玲银索的等级" ZJBR;
    msg += "3. 练习时必须手持鞭类武器\n";

    return msg;
}

