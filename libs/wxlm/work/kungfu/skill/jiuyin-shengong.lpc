string *usage_skills = ({ "finger", "strike","claw", "cuff", "dodge","parry", "force" });

int valid_enable(string usage)
{
	return (member_array(usage, usage_skills) != -1);
}

int valid_force(string force) { return 1; }

int double_attack() { return 1; }

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int valid_learn(object me)
{
	int level;
	int i;

	if ((int)me->query("combat_exp") < 3000000 && !me->query("relife/zhuanshi"))
		return notify_fail("你觉得九阴神功深奥之极，凭自己的战斗经验一时间难以领会。\n");

	if ((int)me->query_skill("martial-cognize", 1) < 50)
		return notify_fail("你觉得九阴神功过于深奥，以自己的武学修养全然无法明白。\n");

	if (me->query("character") != "光明磊落")
		return notify_fail("九阴神功正大恢弘，气度俨然，你怎么也学不得神似。\n");

	if (me->query("str") < 22 && me->query_str() < 63)
		return notify_fail("你发现自己的膂力不足，无法将九阴神功运用自如。\n");

	if (me->query("gender") == "无性" &&
	    (int)me->query_skill("jiuyin-shengong", 1) > 199)
		return notify_fail("你无根无性，阴阳不调，难以领会高深的九阴神功。\n");

	level = me->query_skill("jiuyin-shengong", 1);

	if ((int)me->query_skill("martial-cognize", 1) < 300 && (int)me->query_skill("martial-cognize", 1) < level && !me->query("relife/zhuanshi"))
		return notify_fail("你觉得自己的武学修养有限，难以领会更高深的九阴神功。\n");

	if (me->query_skill("never-defeated", 1))
		return notify_fail("宗师心法有各自的专攻方向，只能掌握一种宗师心法。\n");

	if (me->query_skill("bluesea-force", 1))
		return notify_fail("宗师心法有各自的专攻方向，只能掌握一种宗师心法。\n");

	if (me->query_skill("kuihua-mogong", 1))
		return notify_fail("宗师心法有各自的专攻方向，只能掌握一种宗师心法。\n");

	level = me->query_skill("jiuyin-shengong", 1);

	if ((int)me->query_skill("martial-cognize", 1) < 300 &&
	    (int)me->query_skill("martial-cognize", 1) < level)
		return notify_fail("你觉得自己的武学修养有限，难以领会更高深的九阴神功。\n");

	for (i = 0; i < sizeof(usage_skills); i++)
		if (me->query_skill(usage_skills[i], 1) < level)
			return notify_fail("你对" + to_chinese(usage_skills[i]) +
					   "的理解还不够，无法继续领会更高深的九阴神功。\n");

	return 1;
}

int practice_skill(object me)
{
	return notify_fail("九阴神功博大精深，无法简单的通过练习进步。\n");
}

int difficult_level()
{
	return 500;
}

string main_skill() { return "yongzhao-shanhe"; }

string perform_action_file(string action)
{
	return __DIR__"jiuyin-shengong/perform/" + action;
}

string exert_function_file(string action)
{
	return __DIR__"jiuyin-shengong/exert/" + action;
}
string query_description()
{
    string msg;

    msg = HIY "【九阴神功】" NOR ZJBR ZJBR;
    msg += WHT "相传为北宋年间黄裳所创，乃天下武学总纲之一，博大精深，威力无穷。" ZJBR;
    msg += "此功正大光明，沛然宏伟，可激发为多种拳脚、兵刃乃至轻功运用，变幻随心。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  战斗经验不低于 " HIY "3,000,000" NOR " 点 (转世后无此限制)。" ZJBR;
    msg += "  武学修养等级不低于 " HIY "50" NOR " 级。" ZJBR;
    msg += "  人物性格需为「" HIM "光明磊落" NOR "」。" ZJBR;
    msg += "  先天臂力不低于 " HIY "22" NOR " 点 或 后天臂力不低于 " HIC "63" NOR " 点。" ZJBR;
    msg += "  性别要求：男性或女性。无性者等级超过 " HIY "199" NOR " 级后无法继续提升。" ZJBR;
    msg += "  武学修养低于 " HIY "300" NOR " 级时，九阴神功等级不能超过武学修养等级 (转世后无此限制)。" ZJBR;
    msg += "  不能学习其他指定宗师心法 (如：不败神功、碧海潮生功、葵花魔功)。" ZJBR;
    msg += "  以下技能的基本等级均需大于等于九阴神功等级：" ZJBR;
    msg += "    指法 (`finger`), 掌法 (`strike`), 爪法 (`claw`), 拳法 (`cuff`), " ZJBR;
    msg += "    轻功 (`dodge`), 招架 (`parry`), 内功 (`force`)。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功 (force)。" ZJBR;
    msg += "  指法 (finger)。" ZJBR;
    msg += "  掌法 (strike)。" ZJBR;
    msg += "  爪法 (claw)。" ZJBR;
    msg += "  拳法 (cuff)。" ZJBR;
    msg += "  轻功 (dodge)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  无法通过练习 (`practice`) 提升，只能通过读书或研究提升熟练度。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  " HIW "内力上限提升" NOR "：" ZJBR;
    msg += "    提升内力上限，提升值 = (等级 * 等级 * 22 * 15 / 100 / 200)。" ZJBR;
    msg += "  " HIW "双倍攻击" NOR "：" ZJBR;
    msg += "    激发九阴神功时，普通攻击均有双倍攻击次数效果。" ZJBR;
    msg += "  " HIW "特殊闪避" NOR "：" ZJBR;
    msg += "    作为轻功激发时，提供独特的闪避描述信息。" ZJBR ZJBR;

    msg += HIY "〖内功运用 (Exert)〗" ZJBR NOR;
    msg += HIC "  九阴战气 (powerup)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      当前内力不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升自身攻击力，数值 = (九阴神功激发等级 * 2 / 5)。" ZJBR;
    msg += "      提升自身防御力，数值 = (九阴神功激发等级 * 2 / 5)。" ZJBR;
    msg += "      效果持续时间 = 九阴神功激发等级 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      若在战斗中使用，忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  九阴护体 (shield)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      九阴神功等级不低于 " HIY "50" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升自身防御力 (护甲)，提升值 = (九阴神功激发等级 / 2)。" ZJBR;
    msg += "      效果持续时间 = 九阴神功激发等级 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      若在战斗中使用，忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  天外神音 (roar)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      当前内力不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "      不在安全区 (`no_fight` 区域)。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对周围所有非同伴生物进行范围音波攻击。" ZJBR;
    msg += "      命中判定：(自身九阴神功激发等级 / 2 + 随机(自身九阴神功激发等级 / 2)) >= (目标后天根骨 * 2)。" ZJBR;
    msg += "      命中后造成气血伤害，伤害值约为 (自身九阴神功激发等级 * 2 - (目标最大内力 / 10)) （需伤害值 > 0）。" ZJBR;
    msg += "      若目标当前内力低于 (自身九阴神功激发等级 * 2)，则额外受到相当于伤害值一半的内伤。" ZJBR;
    msg += "      强制与所有命中的目标进入战斗状态。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "100" NOR " 点，气血 " HIR "10" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "5" NOR " 秒。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (Perform)〗" ZJBR NOR;
    msg += HIC "  九阴神抓 (zhua)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      九阴神功等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：ap = (自身九阴神功基本等级 * 2 + 自身武学修养)，dp = (目标招架激发等级 * 2 + 目标武学修养)。若 (ap / 2 + 随机(ap * 2)) > dp 则命中。" ZJBR;
    msg += "      伤害计算 (命中后)：" ZJBR;
    msg += "        若 自身最大内力 > 目标最大内力 * 2：伤害 = (ap * 5 + 自身内功激发等级 * 2)，伤害系数 " HIY "120%" NOR "。" ZJBR;
    msg += "        否则：基础伤害 = (ap + 自身内功激发等级 * 2)，最终伤害 = (基础伤害 / 2 + 随机(基础伤害 / 2))，伤害系数 " HIY "70%" NOR "。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      发动消耗内力 " HIB "20" NOR " 点。" ZJBR;
    msg += "      命中：额外消耗内力 " HIB "180" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  九阴神拳 (quan)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      九阴神功等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：ap = (自身九阴神功激发等级 * 2 + 自身后天臂力 * 20 + 自身武学修养)，dp = (目标轻功激发等级 * 2 + 目标后天臂力 * 20 + 目标武学修养)。若 (ap / 2 + 随机(ap)) < dp 则未命中。" ZJBR;
    msg += "      伤害计算 (命中后)：伤害 = (ap + 随机(ap))，伤害系数 " HIY "90%" NOR "。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      发动消耗内力 " HIB "50" NOR " 点。" ZJBR;
    msg += "      命中：额外消耗内力 " HIB "75" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  九阴神掌 (zhang)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      九阴神功等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      目标未处于忙乱状态。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      成功判定：由 `通用命中公式` 决定，主要依据 ap = (自身九阴神功激发等级 * 2 + 自身武学修养) 与 dp = (目标招架激发等级 * 2 + 目标武学修养) 的比较。" ZJBR;
    msg += "      成功效果：使目标忙乱，持续时间 = (ap / 90 + 2) 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      无内力消耗。" ZJBR;
    msg += "      成功：无自身忙乱。" ZJBR;
    msg += "      失败：自身忙乱 " HIR "1" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  九阴神指 (zhi)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      九阴神功等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "150" NOR " 点。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定 (阶段一)：ap = (自身九阴神功基本等级 * 2 + 自身武学修养)，dp = (目标招架激发等级 * 2 + 目标武学修养)。若 (ap / 2 + 随机(ap * 2)) > dp 则命中。" ZJBR;
    msg += "      若命中 (阶段一)，进行后续判定：" ZJBR;
    msg += "        判定 (阶段二)：若 (ap / 2 + 随机(ap)) > dp 或 目标已忙乱，则视为命中阶段二。" ZJBR;
    msg += "        效果 (命中阶段二)：进行 n = (`COMBAT_D->query_base_attack_number`) 次额外攻击，每次攻击有 " HIY "50%" NOR " 几率使目标忙乱 " HIR "1" NOR " 秒。额外攻击后进行判定 (阶段三)：若 (随机(ap) / 2) > dp 且目标持有非暗器武器，则打落目标武器。" ZJBR;
    msg += "        效果 (未命中阶段二)：使目标忙乱，持续时间 = (4 + 随机(自身九阴神功基本等级 / 30)) 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      发动消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      若命中 (阶段一)：" ZJBR;
    msg += "        且命中 (阶段二)：自身忙乱 " HIR "(1 + 随机(n))" NOR " 秒。" ZJBR;
    msg += "        且未命中 (阶段二)：自身忙乱 " HIR "1" NOR " 秒。" ZJBR;
    msg += "      若未命中 (阶段一)：自身忙乱 " HIR "(3 + 随机(2))" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 大部分特殊招式 (`perform`/`exert`) 仅能在战斗中使用。" ZJBR;
    msg += "2. `九阴神抓`、`九阴神拳`、`九阴神指`、`九阴神掌` 需要空手施展。" ZJBR;
    msg += "3. 使用特殊招式后通常会伴随一定时间的忙乱状态 (`busy`)。" ZJBR;
    msg += "4. 九阴神功作为宗师级武学，对学习者资质、经验和相关技能要求较高。\n";

    return msg;
}