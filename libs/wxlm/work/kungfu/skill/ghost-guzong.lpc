// 鬼谷身法 ghost-guzong

inherit SKILL;

// 函数声明
int valid_enable(string usage);
int valid_learn(object me);
string query_dodge_msg(string limb);
int practice_skill(object me);

string *dodge_msg = ({
    HIB "$n" HIB "身形一晃，犹如鬼魅般避开了$N" HIB "的攻击。\n" NOR,
    HIB "$n" HIB "脚下轻点，身影瞬间消失在$N" HIB "的视线中。\n" NOR,
    HIB "$n" HIB "腰身一扭，速度快得令人难以捉摸，躲过了$N" HIB "的攻势。\n" NOR,
    HIB "$n" HIB "身形如风，飘忽不定，令$N" HIB "的攻击落空。\n" NOR,
    HIB "$n" HIB "脚步诡异，一转眼就避开了$N" HIB "的攻击范围。\n" NOR,
});

// 可用于轻功和躲闪
int valid_enable(string usage)
{
    return usage == "dodge";
}

// 判断是否可以学习
int valid_learn(object me)
{
    if ((int)me->query_skill("dodge", 1) < 100)
        return notify_fail("你的基本轻功火候不够，无法领悟鬼谷身法。\n");

    if (me->query_skill("dodge", 1) < me->query_skill("ghost-guzong", 1))
        return notify_fail("你的基本轻功水平有限，无法领悟更高深的鬼谷身法。\n");

    return 1;
}

// 躲闪信息
string query_dodge_msg(string limb)
{
    return dodge_msg[random(sizeof(dodge_msg))];
}

// 不能通过练习提升
int practice_skill(object me)
{
    return notify_fail("鬼谷身法只能通过学习或锻炼提升。\n");
}

string query_description()
{
    string msg;

    msg = HIY "【鬼谷身法】" ZJBR NOR; // 基本介绍
    msg += WHT "鬼谷派独门轻功绝学，身法飘忽不定，宛如鬼魅，难以捉摸。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  基本轻功等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "  基本轻功等级不低于鬼谷身法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  轻功（dodge）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  无法通过练习 (practice) 提升，只能通过学习 (learn) 或研究 (research) 提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // query_dodge_msg
    msg += "  提升闪避能力，战斗中随机显示不同的闪避描述信息。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  暂无特殊招式。" ZJBR; // (根据当前文件代码，未发现 perform_action_file 或 exert_function_file)

    return msg;
}