// fushang-neigong 扶桑内功
// By Hop

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int query_neili_improve(object me)
{
	int lvl;

	lvl = (int)me->query_skill("fushang-shengong", 1);
	return lvl * lvl * 15 * 4 / 100 / 200;
}

int valid_learn(object me)
{
	if ((int)me->query_skill("force", 1) < 50)
		return notify_fail("你的基本内功火候还不够，还不能学习扶桑内功。\n");

	return ::valid_learn(me);
}

int practice_skill(object me)
{
	return notify_fail("扶桑内功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"fushang-neigong/" + func;
}

string query_description()
{
    string msg;

    msg = HIY "【扶桑内功】" ZJBR NOR;
    msg += WHT "源自东瀛的内功心法，可通过某种方式提升战力。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功等级不低于 " HIY "50" NOR " 级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功（force）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  无法通过练习提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  提升内力上限：效果随等级提升 (公式: `基本等级 * 基本等级 * 0.003`)。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (内功运用 exert)〗" ZJBR NOR;
    msg += HIC "  扶桑战气 (powerup)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      当前内力不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "      未处于 `powerup` 状态。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升自身攻击力，数值为 (内功激发等级 / 3)。" ZJBR;
    msg += "      提升自身防御力，数值为 (内功激发等级 / 3)。" ZJBR;
    msg += "      效果持续时间为 (内功激发等级) 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "90" NOR " 点。" ZJBR;
    msg += "      若在战斗中，自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    return msg;
}