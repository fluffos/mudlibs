// beidou-xianzong.c

inherit SKILL;

string *dodge_msg = ({
    "只见$n一招「仙踪缈去」，身体飘然后退，躲过了$N这一招。\n",
    "$n一个「星宿易位」，向后纵出数丈之远，避开了$N的凌厉攻势。\n",
    "$n使出「奇星而出」，向一旁飘然纵出，轻轻着地。\n",
    "但是$n一招「无中生有」，身形飘忽，早已避开。\n",
    "$n身随意转，一招「化身金虹」倏的不见踪影。\n",
    "可是$n身形不断闪动，一招「流星破空」$N这一招扑了个空。\n",
    "却见$n足不点地，一招「群星送客」往旁窜开数尺，躲了开去。\n",
    "$n身形微晃，一招「仙过九天」有惊无险地避开了$N这一招。\n",
});

int valid_enable(string usage) { return (usage == "dodge") || (usage == "move");}

int valid_learn(object me) { return 1; }

string query_dodge_msg(string limb)
{
    return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
    if( (int)me->query("qi") < 50 )
       return notify_fail("你的体力太差了，不能练北斗仙踪步法。\n");

    me->receive_damage("qi", 40);
    return 1;
}

string query_description()
{
    string msg;

    msg = "";
    msg += HIY "【北斗仙踪】" ZJBR ZJBR NOR;
    msg += WHT "北斗仙踪是一门以轻灵飘逸著称的身法，传说源自天上北斗七星的运行轨迹。" ZJBR;
    msg += "此身法讲究步伐变幻莫测，如同仙人踪迹，令人难以捉摸。" ZJBR ZJBR;
    msg += HIY "【学习要求】" ZJBR NOR;
    msg += "  无特殊要求" ZJBR ZJBR;
    msg += HIY "【练习消耗】" ZJBR NOR;
    msg += "  每次练习消耗："ZJBR;
    msg += "    - 气血 40 点"ZJBR ZJBR;
    msg += HIY "【技能效果】" ZJBR NOR;
    msg += "  可激发为轻功（dodge）和身法（move）" ZJBR;
    msg += "  提高闪避能力和移动速度" ZJBR ZJBR;
    msg += HIY "【闪避招式描述】" ZJBR NOR;
    msg += HIW "1. 仙踪缈去：" ZJBR NOR;
    msg += "  身体飘然后退，躲避攻击" ZJBR ZJBR;
    msg += HIW "2. 星宿易位：" ZJBR NOR;
    msg += "  向后纵出数丈，快速拉开距离" ZJBR ZJBR;
    msg += HIW "3. 奇星而出：" ZJBR NOR;
    msg += "  向侧方飘然移动，轻盈落地" ZJBR ZJBR;
    msg += HIW "4. 无中生有：" ZJBR NOR;
    msg += "  身形飘忽不定，难以捉摸" ZJBR ZJBR;
    msg += HIW "5. 化身金虹：" ZJBR NOR;
    msg += "  瞬间消失，如同化作虹光" ZJBR ZJBR;
    msg += HIW "6. 流星破空：" ZJBR NOR;
    msg += "  身形快速闪动，避开攻击" ZJBR ZJBR;
    msg += HIW "7. 群星送客：" ZJBR NOR;
    msg += "  迅速窜开数尺，拉开距离" ZJBR ZJBR;
    msg += HIW "8. 仙过九天：" ZJBR NOR;
    msg += "  身形微晃，轻松避开攻击" ZJBR ZJBR;
    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 北斗仙踪步法需要长期练习才能掌握其精髓。" ZJBR;
    msg += "2. 在实战中，要善于利用身法的轻盈特点，灵活躲避攻击。" ZJBR;
    msg += "3. 此身法虽然防守性强，但也可配合其他武功，增强攻防能力。\n";

    return msg;
}
