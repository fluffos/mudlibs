// /kungfu/skill/yinlv.c

inherit SKILL;

string type() { return "knowledge"; }


int valid_learn(object me)
{
    if (me->query("int") < 24)
        return notify_fail("你的悟性不够，需要24点悟性才能领会音律的精妙之处。\n");

    if (me->query_skill("yinlv", 1) >= me->query_int() * 8)
        return notify_fail("你的音律修养已经达到了悟性的八倍极限，无法继续提高。\n");

    return 1;
}

int practice_skill(object me)
{
    return notify_fail("音律只能通过学习来提高，无法通过练习增长。\n");
}

void skill_improved(object me)
{
    tell_object(me, "你对音律的理解加深了，感觉自己的琴艺也有所提升。\n");
}
string query_description()
{
    string msg;

    msg = HIY "【音律】" ZJBR NOR;
    msg += WHT "音律是一门研究音乐理论和技巧的学问，属于知识类技能。" ZJBR;
    msg += "精通音律可以提高演奏技巧，增强音乐感染力。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  悟性：24点" ZJBR ZJBR;

    msg += HIY "〖技能类型〗" ZJBR NOR;
    msg += "  知识技能 (knowledge)" ZJBR ZJBR;

    msg += HIY "〖学习限制〗" ZJBR NOR;
    msg += "  音律等级上限为悟性的八倍" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  音律只能通过学习来提高，无法通过练习增长" ZJBR ZJBR;

    msg += HIY "〖特殊效果〗" ZJBR NOR;
    msg += "  随着音律技能的提升，琴艺也会相应提高" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 音律需要较高的悟性，建议提高悟性后再学习" ZJBR;
    msg += "2. 音律等级上限受悟性限制，最高为悟性的八倍\n";

    return msg;
}

