// mantianhuayu-zhen.c 满天花雨掷金针
// modified by Venus Oct.1997



inherit SKILL;

int valid_enable(string usage) { return usage == "throwing"; }

int valid_learn(object me)
{
	if ((int)me->query_skill("force") < 60)
		return notify_fail("你的内功心法火候不够，无法学满天花雨掷金针。\n");

	if ((int)me->query_skill("dodge") < 60)
		return notify_fail("你的轻功火候不够，无法领悟满天花雨掷金针。\n");

	if ((int)me->query_dex() < 25)
		return notify_fail("你的身法不够灵巧，无法领悟满天花雨掷金针。\n");

	if ((int)me->query_skill("throwing", 1) < (int)me->query_skill("mantianhuayu-zhen", 1))
		return notify_fail("你的基本暗器水平有限，难以领会更高深的满天花雨掷金针。\n");

	return 1;
}

int practice_skill(object me)
{
 

	if ((int)me->query("qi") < 60)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 60)
		return notify_fail("你的内力不够练满天花雨掷金针。\n");

	me->receive_damage("qi", 45);
	me->add("neili", -45);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"mantianhuayu-zhen/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【满天花雨掷金针】" ZJBR NOR;
    msg += WHT "一种极为精妙的暗器手法，出手时金针如漫天花雨般洒出，覆盖范围广，难以闪避。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功 (`force`) 等级不低于 " HIY "60" NOR " 级。" ZJBR;
    msg += "  基本轻功 (`dodge`) 等级不低于 " HIY "60" NOR " 级。" ZJBR;
    msg += "  后天身法 (`dex`) 不低于 " HIY "25" NOR " 点。" ZJBR; // query_dex() 对应后天身法
    msg += "  基本暗器 (`throwing`) 等级需大于等于满天花雨掷金针等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  暗器 (`throwing`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血 (`qi`) 不低于 " HIR "60" NOR " 点。" ZJBR;
    msg += "  内力 (`neili`) 不低于 " HIB "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血 " HIR "45" NOR " 点，内力 " HIB "45" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;

    msg += HIC "  花雨金针 (zheng)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      满天花雨掷金针 (`mantianhuayu-zhen`) 等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      基本内功 (`force`) 等级不低于 " HIY "150" NOR " 级。" ZJBR; // 基础内功要求较高
    msg += "      当前内力 (`neili`) 不低于 " HIB "150" NOR " 点。" ZJBR;
    msg += "      必须装备暗器且数量至少为 20。" ZJBR; // 需要较多暗器
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：自身暗器激发等级 与 (目标轻功激发等级 / 2) 进行比较。" ZJBR; // 目标轻功效果减半
    msg += "      命中效果：对目标造成 1 到 8 次连续的气血伤害，每次基础伤害约为 `(满天花雨掷金针等级 / 4) + 随机(满天花雨掷金针等级 / 4)`。" ZJBR;
    msg += "      总共消耗 10 枚暗器。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 " HIB "100" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：消耗内力 " HIB "100" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR; // 未命中忙乱更长

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 施展「花雨金针」需要准备足够数量的暗器。" ZJBR;
    msg += "2. 该招式命中判定的防御方只计算一半的轻功等级，相对容易命中。" ZJBR;
    msg += "3. 无论是否命中，内力消耗相同，但未命中时自身忙乱时间更长。" ZJBR;

    return msg;
}