#define CN_NAME "太祖掌法"
inherit SKILL;

mapping *action = ({
([      "action": "$N单手上抬，一招太祖掌法的［太祖飞叶］，对准$n的$l猛击下去",
	"force" : 300,
	"attack": 85,
	"dodge" : 10,
	"parry" : 5,
	"damage": 100,
	"lvl"   : 0,
	"skill_name" : "太祖掌法",
	"damage_type":  "瘀伤"
]),
([      "action": "$N一招太祖掌法的［太祖云手］，身子已向左转成弓箭步，两臂向后成钩手，呼\n"
		  "的一声轻响，反击$n$l",
	"force" : 350,
	"attack": 25,
	"dodge" : 15,
	"parry" : 10,
	"damage": 610,
	"lvl"   : 30,
	"skill_name" : "太祖掌法",
	"damage_type":  "瘀伤"
]),
});

string query_txt()
{
	return "要求：基本掌法 150级";
}

int valid_learn(object me)
{
	if ((int)me->query_skill("strike", 1) < 150)
		return notify_fail("你的掌法根基有限，无法学习太祖掌法。\n");
	return 1;
}

int valid_enable(string usage)
{
	return usage == "strike" ;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action)-1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int)me->query_skill("taizu-zhang", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i - 1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 60)
		return notify_fail("你现在手足酸软，休息一下再练吧。\n");

	if ((int)me->query("neili") < 80)
		return notify_fail("你的内力不够了。\n");

	me->receive_damage("qi", 50);
	me->add("neili", -60);

	return 1;
}

string query_description()
{
    string msg;
    
    msg = HIY "【太祖掌法】" ZJBR NOR;
    msg += "太祖掌法是北宋太祖赵匡胤所创掌法，招式刚猛开阔，大开大合，具有强劲威力。" ZJBR ZJBR;
    
    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本掌法等级 150 级。" ZJBR ZJBR;
    
    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  掌法（strike）。" ZJBR ZJBR;
    
    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 60 点。" ZJBR;
    msg += "  内力：不低于 80 点。" ZJBR;
    msg += "  每次练习消耗气血：50 点。" ZJBR;
    msg += "  每次练习消耗内力：60 点。" ZJBR ZJBR;
    
    msg += HIY "〖基本招式〗" ZJBR NOR;
    msg += HIC "  太祖飞叶" ZJBR NOR;
    msg += "    等级要求：0级" ZJBR;
    msg += "    攻击力加成：85" ZJBR;
    msg += "    招架加成：5" ZJBR;
    msg += "    躲闪加成：10" ZJBR;
    msg += "    伤害类型：瘀伤" ZJBR;
    msg += "    伤害力：100" ZJBR ZJBR;
    
    msg += HIC "  太祖云手" ZJBR NOR;
    msg += "    等级要求：30级" ZJBR;
    msg += "    攻击力加成：25" ZJBR;
    msg += "    招架加成：10" ZJBR;
    msg += "    躲闪加成：15" ZJBR;
    msg += "    伤害类型：瘀伤" ZJBR;
    msg += "    伤害力：610" ZJBR ZJBR;
    
    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无特殊招式。" ZJBR;
    
    return msg;
}
