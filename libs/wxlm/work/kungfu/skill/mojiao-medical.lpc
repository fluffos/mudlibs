// mojiao-medical.c

inherit SKILL;

string type() { return "knowledge"; }

int valid_enable(string usage) { return usage == "medical"; }

int valid_learn(object me)
{
        if ((int)me->query_skill("medical", 1) < 100)
                return notify_fail("你的基本医术造诣太浅，无"
                                   "法领会深奥的魔教医术。\n");

        if ((int)me->query_skill("medical", 1) < (int)me->query_skill("mojiao-medical", 1))
                return notify_fail("你的基本医术水平有限，无"
                                   "法掌握更深奥的魔教医术。\n");

        return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【魔教医术】" ZJBR NOR;
    msg += WHT "日月神教独特的医疗技能，或许包含一些奇异的治疗或制药方法。" ZJBR ZJBR; // Basic Description (speculative based on name)

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  基本医术 (`medical`) 等级 ≥ " HIY "100" NOR " 级。" ZJBR;
    msg += "  基本医术 (`medical`) 等级 ≥ 魔教医术等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  医术 (`medical`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  " HIR "无法练习" NOR "，只能通过学习 (`learn`) 提升。" ZJBR ZJBR; // No practice_skill defined

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR; // No specific effects defined in the snippet

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR; // No perform/exert defined

    return msg;
}
