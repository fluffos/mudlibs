// dagou-bang.c 神丐棒法
// Modified by Venus Oct.1997
// write by Xiang

 // 确保包含了颜色定义

inherit SKILL;

mapping *action = ({
([      "action": "$N使出一招「棒打双犬」，手中$w化作两道青光砸向$n的$l",
	"force" : 280,
	"attack": 98,
	"dodge" : 120,
	"parry" : 100,
	"damage": 80,
	"damage_type": "挫伤"
]),
([      "action": "$N手中$w左右晃动，一招「拨草寻蛇」向$n的$l攻去",
	"force" : 300,
	"attack": 100,
	"dodge":  100,
	"parry" : 120,
	"damage": 100,
	"damage_type": "挫伤"
]),
([      "action": "$N举起$w，居高临下使一招「打草惊蛇」敲向$n的$l",
	"force" : 290,
	"attack": 99,
	"dodge":  120,
	"parry" : 100,
	"damage": 70,
	"damage_type": "挫伤"
]),
([      "action": "$N施出「拨狗朝天」，$w由下往上向$n撩去",
	"force" : 310,
	"attack": 105,
	"dodge" : 80,
	"parry" : 140,
	"damage": 90,
	"damage_type": "挫伤"
]),
});

int valid_enable(string usage) { return (usage == "staff") || (usage == "parry"); }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 500)
		return notify_fail("你的内力不够，无法学习神丐棒法。\n");

	if ((int)me->query_int() < 30)
		return notify_fail("你现在悟性不够，难以领会神丐棒法。\n");

	if ((int)me->query_skill("staff", 1) < 100)
		return notify_fail("你的基本杖法火候不够，无法学习神丐棒法。\n");

	if ((int)me->query_skill("staff", 1) < (int)me->query_skill("dagou-bang", 1))
		return notify_fail("你的基本杖法水平有限，无法领会更高深的神丐棒法。\n");

	return 1;
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "staff")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力不够练神丐棒法。\n");

	if ((int)me->query("neili") < 80)
		return notify_fail("你的内力不够练神丐棒法。\n");

	me->receive_damage("qi", 64);
	me->add("neili", -71);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"dagou-bang/" + action;
}

string query_description()
{
	string msg;

	msg = HIY "【打狗棒法】" + ZJBR + NOR;
	msg += "丐帮镇帮绝技，棒法精妙绝伦，共有三十六路，变化万方。" + ZJBR + ZJBR; // 基本介绍

	msg += HIY "〖学习要求〗" + ZJBR + NOR; // valid_learn
	msg += "  最大内力不低于 " HIB "500" NOR " 点。" + ZJBR;
	msg += "  先天悟性不低于 " HIY "30" NOR " 点。" + ZJBR;
	msg += "  基本杖法等级不低于 " HIY "100" NOR " 级。" + ZJBR;
	msg += "  基本杖法等级需大于等于打狗棒法等级。" + ZJBR + ZJBR;

	msg += HIY "〖激发类型〗" + ZJBR + NOR; // valid_enable
	msg += "  杖法（staff）。" + ZJBR;
	msg += "  招架（parry）。" + ZJBR + ZJBR;

	msg += HIY "〖练习要求〗" + ZJBR + NOR; // practice_skill
	msg += "  装备武器为杖。" + ZJBR;
	msg += "  气血：不低于 " HIR "70" NOR " 点。" + ZJBR;
	msg += "  内力：不低于 " HIB "80" NOR " 点。" + ZJBR;
	msg += "  每次练习消耗气血：" HIR "64" NOR " 点。" + ZJBR;
	msg += "  每次练习消耗内力：" HIB "71" NOR " 点。" + ZJBR + ZJBR;

	msg += HIY "〖攻防特效/被动效果〗" + ZJBR + NOR; // hit_ob, valid_damage, skill_improved etc.
	msg += "  无。" + ZJBR + ZJBR;

	msg += HIY "〖特殊招式〗" + ZJBR + NOR; // perform_action_file

	msg += HIC "  缠字诀 (chan)" + ZJBR + NOR;
	msg += "    使用要求：" + ZJBR;
	msg += "      打狗棒法等级 " HIY "70" NOR " 级。" + ZJBR;
	msg += "      基本内功等级 " HIY "100" NOR " 级。" + ZJBR;
	msg += "      当前内力不低于 " HIB "100" NOR " 点。" + ZJBR;
	msg += "      装备杖类武器。" + ZJBR;
	msg += "      激发杖法为打狗棒法。" + ZJBR;
	msg += "      目标未被忙乱。" + ZJBR;
	msg += "      战斗中对敌人使用。" + ZJBR;
	msg += "    效果描述：" + ZJBR;
	msg += "      命中判定由双方杖法和招架激发等级及其他因素决定。" + ZJBR;
	msg += "      命中后使目标忙乱，持续时间约为 ((打狗棒法等级 / 20) + 2) 秒。" + ZJBR;
	msg += "    消耗与代价：" + ZJBR;
	msg += "      内力 " HIB "50" NOR " 点。" + ZJBR;
	msg += "      未命中则自身忙乱 " HIR "2" NOR " 秒。" + ZJBR + ZJBR;

	msg += HIC "  绊字诀 (ban)" + ZJBR + NOR;
	msg += "    使用要求：" + ZJBR;
	msg += "      打狗棒法等级 " HIY "100" NOR " 级。" + ZJBR;
	msg += "      基本内功等级 " HIY "100" NOR " 级。" + ZJBR;
	msg += "      当前内力不低于 " HIB "100" NOR " 点。" + ZJBR;
	msg += "      装备杖类武器。" + ZJBR;
	msg += "      激发杖法为打狗棒法。" + ZJBR;
	msg += "      战斗中对敌人使用。" + ZJBR;
	msg += "    效果描述：" + ZJBR;
	msg += "      临时提升自身攻击力 (数值为 自身悟性 * 3)。" + ZJBR;
	msg += "      发动多次攻击 (次数由系统决定)，每次攻击有 50% 几率使未忙乱的目标忙乱 1 秒。" + ZJBR;
	msg += "      攻击结束后，解除目标 1 秒忙乱状态。" + ZJBR;
	msg += "    消耗与代价：" + ZJBR;
	msg += "      内力 " HIB "180" NOR " 点。" + ZJBR;
	msg += "      自身忙乱 " HIR "1 ~ 4" NOR " 秒。" + ZJBR + ZJBR;

	msg += HIC "  天下无狗 (wugou)" + ZJBR + NOR;
	msg += "    使用要求：" + ZJBR;
	msg += "      需要习得此招。" + ZJBR;
	msg += "      打狗棒法等级 " HIY "150" NOR " 级。" + ZJBR;
	msg += "      基本内功等级 " HIY "220" NOR " 级。" + ZJBR;
	msg += "      当前内力不低于 " HIB "500" NOR " 点。" + ZJBR;
	msg += "      装备杖类武器。" + ZJBR;
	msg += "      激发杖法为打狗棒法。" + ZJBR;
	msg += "      战斗中对敌人使用。" + ZJBR;
	msg += "    效果描述：" + ZJBR;
	msg += "      临时提升自身攻击力 (数值为 自身悟性 * 5，对非玩家目标翻倍)。" + ZJBR;
	msg += "      临时提升自身伤害 (数值为 打狗棒法等级 / 4)。" + ZJBR;
	msg += "      发动多次攻击 (次数由系统决定)，伤害受临时增益影响。" + ZJBR;
	msg += "    消耗与代价：" + ZJBR;
	msg += "      内力 " HIB "500" NOR " 点。" + ZJBR;
	msg += "      自身忙乱 " HIR "1 ~ 5" NOR " 秒。" + ZJBR;
	msg += "    冷却时间：" + ZJBR;
	msg += "      4 秒。" + ZJBR;


	return msg;
}
