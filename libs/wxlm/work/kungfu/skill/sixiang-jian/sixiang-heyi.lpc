
#include <combat.h>

inherit F_SSERVER;

string query_name() { return "四象合一"; }
string *pfm_type() { return ({ "sword", }); }

int perform(object me, object target)
{
    string msg;
    int ap, dp, damage;
    object weapon;

    if (! target) target = offensive_target(me);

    if (! target || ! me->is_fighting(target))
        return notify_fail("「四象合一」只能对战斗中的对手使用。\n");

    if (! objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对。\n");

    if ((int)me->query_skill("sixiang-jian", 1) < 100)
        return notify_fail("你的四象剑法不够娴熟，不会使用「四象合一」。\n");

    if ((int)me->query_skill("sixiang-shengong", 1) < 100)
        return notify_fail("你的四象神功不够高，不能使用「四象合一」。\n");

    if ((int)me->query("neili") < 200)
        return notify_fail("你的真气不够，无法使用「四象合一」。\n");

    if (me->query_skill_mapped("sword") != "sixiang-jian")
        return notify_fail("你没有激发四象剑法，无法使用「四象合一」。\n");

    if (! living(target))
        return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

    msg = HIY "$N" HIY "使出四象剑法的绝技「四象合一」，手中" + weapon->name() +
          HIY "剑芒暴涨，四象之力在剑身上不断流转！\n" NOR;

    ap = me->query_skill("sword") + me->query_skill("force");
    dp = target->query_skill("dodge") + target->query_skill("parry");

    if (COMBAT_D->hit_determination(me,target,ap,dp))
    {
        damage = ap / 2 + random(ap / 2);
        me->add("neili", -150);
        msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 60,
                                   HIR "只见$n" HIR "躲闪不及，被$N" HIR
                                   "这一剑击中，顿时鲜血直流！\n" NOR);
        me->start_busy(2);
    } else
    {
        msg += CYN "可是$n" CYN "看破了$N"
               CYN "的企图，巧妙地避开了这一剑。\n" NOR;
        me->add("neili", -50);
        me->start_busy(3);
    }
    message_combatd(msg, me, target);

    return 1;
}
