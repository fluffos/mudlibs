int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 500)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("force") < 100)
		return notify_fail("你的内功火候太浅。\n");

	if ((int)me->query_skill("blade", 1) < 80)
		return notify_fail("你的基本刀法火候不够，无法修习血河神刀。\n");

	if ((int)me->query_skill("blade", 1) < (int)me->query_skill("xue-dao", 1))
		return notify_fail("你的基本刀法水平有限，无法修习更加高深的血河神刀。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("xue-dao",1);
	for(i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "blade")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力不够，练不了血河神刀。\n");

	if ((int)me->query("neili") < 70)
		return notify_fail("你的内力不够，练不了血河神刀。\n");

	me->receive_damage("qi", 60);
	me->add("neili", -63);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"xue-dao/" + action;
}
string query_description()
{
    string msg;

    msg = HIR "【血河神刀】" ZJBR NOR;
    msg += WHT "血刀门赖以成名的刀法，刀法怪异，专攻下盘，凶狠异常。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力：" HIY "500" NOR " 点。" ZJBR;
    msg += "  基本内功 等级：" HIB "100" NOR " 级。" ZJBR;
    msg += "  基本刀法 等级：" HIB "80" NOR " 级。" ZJBR;
    msg += "  基本刀法 等级必须 ≥ 血河神刀 基础等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  刀法 (blade)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须装备武器类型为 刀 (blade)。" ZJBR;
    msg += "  当前 气血 不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  当前 内力 不低于 " HIB "70" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;

    msg += CYN "  祭血神刀 (shendao)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      血河神刀 基础等级：" HIY "100" NOR " 级。" ZJBR;
    // 假设 longshen-xiang 为 龙象般若功
    msg += "      龙象般若功 有效等级：" HIY "100" NOR " 级。" ZJBR;
    msg += "      最大内力 不低于 " HIB "1200" NOR " 点。" ZJBR;
    msg += "      当前 内力 不低于 " HIB "400" NOR " 点。" ZJBR;
    msg += "      当前 气血 不低于 " HIR "100" NOR " 点。" ZJBR;
    msg += "      邪气 不低于 " HIM "1000" NOR " 点。" ZJBR; // shen < -1000
    msg += "    效果描述：" ZJBR;
    msg += "      右手持刀向左肩一勒，一阵血珠溅满刀面，紧接着右臂抡出，一片血光裹住刀影向敌人当头劈落。" ZJBR;
    // 假设 apply/attack 和 apply/damage 为临时命中和伤害
    msg += "      临时提升自身 命中 和 伤害，提升值等于 刀法有效激发 等级。" ZJBR;
    msg += "      持续时间约为 刀法有效激发 / 40 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗 内力 " HIB "350" NOR " 点。" ZJBR;
    msg += "      消耗 气血 " HIR "50" NOR " 点。" ZJBR;
    msg += "      自身 忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += CYN "  刀影无踪 (shi)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      血河神刀 有效等级：" HIY "180" NOR " 级。" ZJBR;
    msg += "      内功有效激发 等级：" HIB "250" NOR " 级。" ZJBR;
    msg += "      当前 内力 不低于 " HIB "500" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      陡然施出「刀影无踪」，手中兵刃腾起无边杀意，携着风雷之势向敌人劈斩而去。" ZJBR;
    msg += "      根据自身 血河神刀 有效等级 和 内功有效激发，对敌人进行数次攻击。" ZJBR;
    msg += "      攻击次数 = 5 + (血河神刀有效等级 / 80) + (内功有效激发 / 80)，最多 15 次。" ZJBR;
    msg += "      每次攻击伤害约等于 (damage_power(me, \"blade\") + 加力值)，具体伤害随机浮动。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗 内力 " HIB "200 + (内功有效激发 / 2)" NOR " 点。" ZJBR;
    msg += "      自身 忙乱 " HIR "1 + 随机(3)" NOR " 秒。" ZJBR ZJBR; // 实际为 1 + random(level / 100)，简化为 1-3 秒

    msg += CYN "  血刀幻影 (huan)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      血河神刀 有效等级：" HIY "80" NOR " 级。" ZJBR;
    msg += "      当前 内力 不低于 " HIB "60" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      把手中的兵刃舞得飞快，幻起层层刀影逼向敌人。" ZJBR;
    msg += "      若 (自身 血河神刀 有效等级 + 随机(自身 血河神刀 有效等级)) > 对方 轻功有效激发，则使对方 忙乱。" ZJBR;
    msg += "      忙乱时间 = (血河神刀 有效等级 / 30) + 随机(血河神刀 有效等级 / 30) 秒。" ZJBR; // 简化表示
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗 内力 " HIB "50" NOR " 点。" ZJBR;
    msg += "      自身 忙乱 " HIR "1" NOR " 秒。" ZJBR ZJBR;

    msg += CYN "  血雨 (xueyu)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      血河神刀 有效等级：" HIY "70" NOR " 级。" ZJBR;
    msg += "      内功有效激发 等级：" HIB "120" NOR " 级。" ZJBR;
    msg += "      当前 内力 不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      嗔目大喝，手腕一抖，兵刃如闪电一般砍向敌人。" ZJBR;
    msg += "      根据自身 血河神刀 有效等级 和 内功有效激发，对敌人进行数次攻击。" ZJBR;
    msg += "      攻击次数 = 3 + (血河神刀有效等级 / 80) + (内功有效激发 / 80)，最多 9 次。" ZJBR;
    msg += "      每次攻击伤害约等于 (刀法激发等级 * 2)，具体伤害随机浮动。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗 内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      自身 忙乱 " HIR "1 + 随机(5)" NOR " 秒。" ZJBR ZJBR; // 实际为 1 + random(level / 40)，简化为 1-5 秒

    msg += HIR "〖练习消耗〗" ZJBR NOR;
    msg += "  消耗 气血：" HIR "60" NOR " 点。" ZJBR;
    msg += "  消耗 内力：" HIB "63" NOR " 点。" ZJBR ZJBR;

    return msg;
}