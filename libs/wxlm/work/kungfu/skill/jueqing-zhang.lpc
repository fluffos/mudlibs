int valid_enable(string usage)
{
        return usage == "strike" || usage == "parry";
}

int valid_learn(object me)
{
        if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
                return notify_fail("练绝情掌必须空手。\n");

        if ((int)me->query_skill("force") < 120)
                return notify_fail("你的内功火候不够，无法学绝情掌。\n");

        if( me->query("max_neili")<600 )
                return notify_fail("你的内力太弱，无法练绝情掌。\n");

        if ((int)me->query_skill("strike", 1) < 80)
                return notify_fail("你的基本掌法火候太浅。\n");

        if ((int)me->query_skill("strike", 1) < (int)me->query_skill("jueqing-zhang", 1))
                return notify_fail("你的基本掌法水平有限，无法领会更高深的绝情掌。\n");

        return 1;
}

string query_skill_name(int level)
{
        int i;
        for (i = sizeof(action) - 1; i >= 0; i--)
            if (level >= action[i]["lvl"])
                return action[i]["skill_name"];
}

mapping *query_action_all()
{
	return action;
}
mapping query_action(object me, object weapon)
{
        int i, level;
        level = (int) me->query_skill("jueqing-zhang", 1);
        for (i = sizeof(action); i > 0; i--)
            if (level > action[i-1]["lvl"])
                return action[NewRandom(i, 5, level / 5)];
}

int practice_skill(object me)
{
        if( me->query("qi")<80 )
                return notify_fail("你的体力太低了。\n");

        if( me->query("neili")<70 )
                return notify_fail("你的内力不够练绝情掌。\n");

        me->receive_damage("qi", 65);
        me->add("neili", -60);

        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"jueqing-zhang/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【绝情掌】" ZJBR NOR;
    msg += "绝情谷的独门掌法，招式之中隐含有情伤之意。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  空手状态。" ZJBR;
    msg += "  基本内功 (`force`) 等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "  最大内力 (`max_neili`) 不低于 " HIB "600" NOR " 点。" ZJBR;
    msg += "  基本掌法 (`strike`) 等级不低于 " HIY "80" NOR " 级。" ZJBR;
    msg += "  基本掌法 (`strike`) 等级需大于等于绝情掌等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  掌法 (`strike`)。" ZJBR;
    msg += "  招架 (`parry`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  气血 (`qi`) 不低于 " HIR "80" NOR " 点。" ZJBR;
    msg += "  内力 (`neili`) 不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血 " HIR "65" NOR " 点，内力 " HIB "60" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // hit_ob, valid_damage, skill_improved etc.
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (Perform)〗" ZJBR NOR; // perform/exert
    msg += HIC "  万念俱灰 (wan)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      绝情掌等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      激发掌法为绝情掌。" ZJBR;
    msg += "      准备掌法为绝情掌。" ZJBR;
    msg += "      轻功激发等级 (`dodge`) 不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "      空手状态。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：由 `通用命中公式` 根据双方的绝情掌等级、轻功激发等级和闪避激发等级 (`dodge`) 决定。" ZJBR;
    msg += "      命中后使目标忙乱 (`busy`)，忙乱时间约为 (自身绝情掌等级 + 自身轻功激发等级 / 2) / 40 + 1 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力 " HIB "80" NOR " 点，自身忙乱 " HIR "1" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "30" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  魂飞魄散 (hun)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      绝情掌等级不低于 " HIY "140" NOR " 级。" ZJBR;
    msg += "      激发掌法为绝情掌。" ZJBR;
    msg += "      准备掌法为绝情掌。" ZJBR;
    msg += "      基本内功 (`force`) 等级不低于 " HIY "180" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "      空手状态。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：由 `通用命中公式` 根据双方的掌法激发等级 (`strike`) 和招架激发等级 (`parry`) 决定。" ZJBR;
    msg += "      命中后对目标造成伤害，伤害值约为 (绝情掌等级 + 随机(绝情掌等级))，附带 " HIY "60" NOR " 点固定伤害。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力 " HIB "200" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "100" NOR " 点，自身忙乱 " HIR "4" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  迷魂 (mihun)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      绝情掌等级不低于 " HIY "40" NOR " 级。" ZJBR;
    msg += "      空手状态。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "      (非巫师玩家) 门派必须是 " HIM "移花宫" NOR "。" ZJBR; // 注意：此招式有严格的门派限制
    msg += "    效果描述：" ZJBR;
    msg += "      成功率判定：随机(自身后天身法 * 2) > 目标后天身法。" ZJBR;
    msg += "      成功后使目标忙乱 (`busy`)，忙乱时间约为 (绝情掌等级 / 30) 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      自身忙乱 " HIR "1" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 绝大部分特殊招式 (`perform`) 仅能在战斗中使用。" ZJBR;
    msg += "2. 所有绝情掌特殊招式 (`perform`) 需要空手才能施展。" ZJBR;
    msg += "3. 使用特殊招式后通常会伴随一定时间的忙乱状态 (`busy`)。" ZJBR;
    msg += "4. 「迷魂」招式对非移花宫弟子有严格限制。" ZJBR;

    return msg;
}