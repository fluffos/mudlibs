inherit SKILL;

mapping *action = ({
([  "action" : "$N剑势凌厉,一招「" HIW "九霄惊鸿" NOR "」,手中$w如白鹤展翅,自上而下劈向$n",
    "force" : 200,
    "attack": 65,
    "dodge" : 70,
    "parry" : 60,
    "damage": 90,
    "lvl"   : 0,
    "skill_name" : "九霄惊鸿",
    "damage_type" : "割伤"
]),
([  "action" : "$N使出「" HIC "云端揽月" NOR "」,身形飘逸,$w划出一道优美弧线斩向$n的$l",
    "force" : 240,
    "attack": 75,
    "dodge" : 80,
    "parry" : 70,
    "damage": 110,
    "lvl"   : 30,
    "skill_name" : "云端揽月",
    "damage_type" : "割伤"
]),
([  "action" : "$N一式「" HIY "鹤舞长空" NOR "」,$w化作千百道剑光,宛如白鹤翩翩起舞,笼罩$n全身",
    "force" : 280,
    "attack": 85,
    "dodge" : 90,
    "parry" : 80,
    "damage": 130,
    "lvl"   : 60,
    "skill_name" : "鹤舞长空",
    "damage_type" : "刺伤"
]),
([  "action" : "$N轻吟剑诀,一招「" HIM "九天银河" NOR "」,$w剑芒暴涨,如银河倒泻般直射$n的$l",
    "force" : 320,
    "attack": 95,
    "dodge" : 100,
    "parry" : 90,
    "damage": 150,
    "lvl"   : 90,
    "skill_name" : "九天银河",
    "damage_type" : "刺伤"
]),
});

int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me)
{
    if ((int)me->query("max_neili") < 700)
        return notify_fail("你的内力不够。\n");

    if ((int)me->query_skill("force") < 100)
        return notify_fail("你的内功火候不够。\n");

    if ((int)me->query_skill("sword", 1) < 60)
        return notify_fail("你的基本剑法火候不够。\n");

    if ((int)me->query_skill("sword", 1) < (int)me->query_skill("jiuxiao_jinghong", 1))
        return notify_fail("你的基本剑法水平有限，无法领会更高深的九霄惊鸿剑法。\n");

    return 1;
}

string query_skill_name(int level)
{
    int i;
    for (i = sizeof(action) - 1; i >= 0; i--)
        if (level >= action[i]["lvl"])
            return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    int i, level;
    level = (int) me->query_skill("jiuxiao_jinghong", 1);
    for (i = sizeof(action); i > 0; i--)
        if (level > action[i-1]["lvl"])
            return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    object weapon;

    if (!objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对。\n");

    if ((int)me->query("qi") < 50)
        return notify_fail("你的体力不够练九霄惊鸿剑法。\n");

    if ((int)me->query("neili") < 50)
        return notify_fail("你的内力不够练九霄惊鸿剑法。\n");

    me->receive_damage("qi", 45);
    me->add("neili", -48);
    return 1;
}

string perform_action_file(string action)
{
    return __DIR__"jiuxiao_jinghong/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
    int lvl;
    lvl = me->query_skill("jiuxiao_jinghong", 1);

    if (damage_bonus < 80 || lvl < 80) return 0;

    if (random(lvl) > victim->query_skill("dodge", 1)/2)
    {
        victim->receive_wound("qi", (damage_bonus - 70) / 3);
        return HIW "$N" HIW "九霄惊鸿剑法的剑气如白鹤展翅，$n" HIW "躲闪不及，被剑气所伤！\n" NOR;
    }
}

string query_description()
{
    string msg;

    msg = HIY "【九霄惊鸿剑法】" ZJBR NOR;
    msg += "一门讲究高远和迅捷的上乘剑法。此剑法以白鹤为意象，剑势高远灵动，如鹤舞长空，招式迅捷，令敌人难以抵挡。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  最大内力不低于 " HIB "700" NOR " 点。" ZJBR;
    msg += "  基本内功等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "  基本剑法等级不低于 " HIY "60" NOR " 级。" ZJBR;
    msg += "  基本剑法等级需大于等于九霄惊鸿剑法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  剑法（sword）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  必须装备剑类武器。" ZJBR;
    msg += "  气血不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  内力不低于 " HIB "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "45" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "48" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // hit_ob
    msg += "  " HIW "白鹤剑气" NOR ":" ZJBR;
    msg += "    触发条件：" ZJBR;
    msg += "      九霄惊鸿剑法等级不低于 " HIY "80" NOR " 级。" ZJBR;
    msg += "      普通攻击伤害增益（damage_bonus）不低于 " HIY "80" NOR " 点。" ZJBR;
    msg += "      随机(九霄惊鸿剑法等级) > (目标基本轻功等级 / 2)。" ZJBR;
    msg += "    效果：对目标造成额外气血伤害，伤害值约为 (伤害增益 - 70) / 3。" ZJBR ZJBR;


    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform/exert
    msg += "  暂无明确的特殊招式文件。`perform_action_file` 函数存在，可能指向后续添加的招式。" ZJBR;
    //  如果未来添加了特殊招式文件，需要在这里补充描述。

    return msg;
}