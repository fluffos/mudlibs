int valid_enable(string usage) { return usage == "strike" || usage == "parry"; }

int valid_combine(string combo)
{
	return combo == "dashou-yin" ||
	       combo == "yujiamu-quan";
}

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练烈焰刀必须空手。\n");

	if ((int)me->query("max_neili") < 1200)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("force") < 150)
		return notify_fail("你的内功火候太浅。\n");

	if (me->query_skill("strike", 1) < me->query_skill("huoyan-dao", 1))
		return notify_fail("你的基本掌法火候有限，无法领会更高深的烈焰刀法。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("huoyan-dao",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
 

	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练烈焰刀必须空手。\n");

	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力不够，练不了烈焰刀。\n");

	if ((int)me->query("neili") < 70)
		return notify_fail("你的内力不够，练不了烈焰刀。\n");

	me->receive_damage("qi", 55);
	me->add("neili", -62);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"huoyan-dao/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【烈焰刀】" ZJBR NOR;
    msg += "密宗绝学，源自鸠摩智。此掌法需以深厚内力催动，掌风炽热，威力惊人。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  必须空手。" ZJBR;
    msg += "  最大内力需达到 " HIY "1200" NOR " 点。" ZJBR;
    msg += "  基本内功等级需达到 " HIY "150" NOR " 级。" ZJBR;
    msg += "  基本掌法等级不可低于烈焰刀等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  掌法（strike）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖可备技能〗" ZJBR NOR; // valid_combine
    msg += "  可与 密宗大手印 (dashou-yin) 或 金刚瑜迦母拳 (yujiamu-quan) 互备。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  必须空手。" ZJBR;
    msg += "  气血：不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "55" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "62" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform_action_file

    msg += HIC "  烈焰焚身 (fen)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      需经过师门指点开启。" ZJBR; // userp(me) && ! me->query("can_perform/huoyan-dao/fen")
    msg += "      烈焰刀等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "400" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      发出无形刀气远程攻击目标。" ZJBR;
    msg += "      命中判定：比较（自身激发内功等级 + 自身后天根骨 * 10）与（目标激发内功等级 + 目标后天根骨 * 10）。" ZJBR;
    msg += "      命中后造成伤害，伤害值约为（（激发内功等级 + 后天根骨*10）+ 随机（（激发内功等级 + 后天根骨*10）/ 2）），并有 70% 伤害加成。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 " HIB "300" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：消耗内力 " HIB "150" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  天寰神炎 (yan)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      烈焰刀等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "200" NOR " 级。" ZJBR;
    msg += "      最大内力 " HIB "2000" NOR " 点，当前内力 " HIB "600" NOR " 点。" ZJBR;
    msg += "      必须空手，激发掌法为烈焰刀，且未准备烈焰刀。" ZJBR; // 互备检查
    msg += "      不能与密宗大手印互备。" ZJBR; // 明确的互备冲突
    msg += "    效果描述：" ZJBR;
    msg += "      连续发动多次攻击（次数取决于 `COMBAT_D->query_base_attack_number` 函数）。" ZJBR;
    msg += "      每次攻击增加相当于（自身后天根骨 * 5）的临时攻击力。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "500" NOR " 点。" ZJBR;
    msg += "      自身忙乱 3 + 随机(2) 秒。" ZJBR;

    return msg;
}