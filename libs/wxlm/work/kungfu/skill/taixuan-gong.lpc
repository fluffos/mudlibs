int valid_enable(string usage)
{ 
        object me = this_player();

        if (!me)
        {
                return 0;
        }
       // if (me->query_skill("taixuan-gong", 1)<180 && me->query_skill("literate", 1))
        if ( !me->query("special_skill/da_zhi_ru_yu") && me->query_skill("literate", 1))//改为不可以有读书技能除非转生 by luoyun 2018.5.12
                return usage == 0;

        //如果query_talnet_level(me,da_zhi_ru_yu)小于 读书写字等级 / 50
        if (TALNET_MASTER->query_talnet_level(me, "da_zhi_ru_yu") < me->query_skill("literate", 1) / 50)
                return usage == 0;

        if (! me->query("can_learned/taixuan-gong/enable_weapon"))
                return usage == "force" || usage == "unarmed" || usage == "dodge" || usage == "parry";
        else
        if (me->query_skill("sword", 1) < me->query_skill("taixuan-gong", 1)
            && me->query_skill("blade", 1) < me->query_skill("taixuan-gong", 1))
                return usage == "force" || usage == "unarmed" || usage == "dodge" || usage == "parry";
 
        else 
        if (me->query_skill("sword", 1) < me->query_skill("taixuan-gong", 1)
            && me->query_skill("blade", 1) > me->query_skill("taixuan-gong", 1))
                return usage == "force" || usage == "unarmed" || usage == "dodge" || usage =="blade" || usage == "parry";

        else
        if (me->query_skill("sword", 1) > me->query_skill("taixuan-gong", 1)
            && me->query_skill("blade", 1) < me->query_skill("taixuan-gong", 1))
                return usage == "force" || usage == "unarmed" || usage == "dodge" || usage =="sword" || usage == "parry";

        else        
            return usage == "force" || usage == "unarmed" || usage == "dodge" || usage =="blade" || usage == "parry" || usage == "sword";
       
}

mapping query_action(object me, object weapon)
{
        if ( !me->query("relife/zhuanshi") && me->query_skill("literate", 1))//改为不可以有读书技能除非转生 by luoyun 2018.5.12
               return actionbad[0];

        return weapon ? actionw[random(sizeof(actionw))] :
                        actionf[random(sizeof(actionw))];
}

string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

mixed valid_damage(object ob, object me, int damage, object weapon)
{
        mapping result;
        int ap, dp;
        int cost;  


        // tell_object(me, "valid_damage: " + damage + "\n");

        if ( !me->query("relife/zhuanshi") && me->query_skill("literate", 1))//改为不可以有读书技能除非转生 by luoyun 2018.5.12
               return;

        cost = damage / 4;
        if ((int)me->query_skill("taixuan-gong", 1) < 150
		//    || !me->query_temp("parry_valid_damage")
           || me->query_skill_mapped("parry") != "taixuan-gong"
           || me->query_skill_mapped("force") != "taixuan-gong"
           || me->query_skill_mapped("unarmed") != "taixuan-gong"
           || (int)me->query("neili") < (int)me->query("max_neili")/3
           || (int)me->query("neili") < cost
           || ! living(me)
        )
                return;

        ap = ob->query_skill("force") * 12 + ob->query("max_neili");
        dp = me->query_skill("force") * 12 + me->query("neili");


        if (ap / 2 + random(ap) < dp)
        {


                me->add("neili", -cost);
                result = ([ "damage": -(damage * 3 / 4) ]);

                // tell_object(me, "成功防御\n");

                switch (random(2))
                {
                case 0:
                        result += (["msg" : HIR "$n" HIR "默念太玄功口诀，太玄内"
                                            "劲齐聚于全身，$N" HIR "只觉这招攻在"
                                            "$n" HIR "身上，犹如碰到铜墙铁壁一般，"
                                            "丝毫不起作用。\n"NOR]);
                        break;
                case 1:
                        result += (["msg" : HIR "$N" HIR "一招击中$n" HIR "上身"
                                            "，可却犹如击在铜墙铁壁上一般，力道顿时"
                                            "消失得无影无踪。\n" NOR]);
                        break;
                default:
                        result += (["msg" : HIR "但见$n" HIR "一声轻啸，浑若无事"
                                            "的接下了$N" HIR "这一招，却没有受到"
                                            "半点伤害。\n" NOR]);
                        break;
                }

                // tell_object(me, "防御信息: " + result["msg"] + "\n");
                return result;
        }
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
        mixed result;
        string msg;
        int lvl;
        object weapon = me->query_temp("weapon");

        lvl = me->query_skill("taixuan-gong", 1);

        if (!me->query("special_skill/da_zhi_ru_yu") && me->query_skill("literate", 1))//改为不可以有读书技能除非转生 by luoyun 2018.5.12
               return 0;

        if (damage_bonus < 150
           || lvl < 140
           || me->query("neili") < 300
           || me->query_skill_mapped("force") != "taixuan-gong")
                return 0;

        // 未学会驾御兵器
        if (! me->query("can_learned/taixuan-gong/enable_weapon"))
        {
             if (me->query_skill_prepared("unarmed") != "taixuan-gong")
                      return 0;
        }

        // 已经会驾御兵器
        if (me->query("can_learned/taixuan-gong/enable_weapon"))
        {             
             if (! objectp(weapon))
                  if (me->query_skill_prepared("unarmed") != "taixuan-gong")           
                         return 0;

             if (objectp(weapon) && weapon->query("skill_type") != "sword" 
                 && weapon->query("skill_type") != "blade")
                         return 0;
           
             if (objectp(weapon) && weapon->query("skill_type") == "sword"
                 && me->query_skill_mapped("sword") != "taixuan-gong")
                         return 0;
            
             if (objectp(weapon) && weapon->query("skill_type") == "blade"
                 && me->query_skill_mapped("blade") != "taixuan-gong")
                         return 0;                                   
        }

        if (random(damage_bonus) / 2 > victim->query_con() && random(2))
        {
                me->add("neili", -100);
                result = ([ "damage" : (damage_bonus - 80)/3 ]);

                if (me->query("can_learned/taixuan-gong/enable_weapon") && objectp(weapon))
                {
                        msg = random(2) ? HIM "$N" HIM "一招攻出，竟卷起千层气浪，太玄内劲"
                                           "顿时源源不绝透过" + weapon->name() + HIM "涌入$n" HIM "体"
                                           "内！\n" NOR:
                                           HIM "$N" HIM "太玄内劲迸发，$n" HIM "只感全身一震，登时一"
                                           "股灼热之气透胸而过，" + weapon->name() + HIM "鲜血淋漓！\n" NOR;
                } else
                {
                        msg = random(2) ? HIW "$N" HIW "一招攻出，竟卷起千层气浪，太玄内劲"
                                           "顿时源源不绝涌入$n" HIW "体内！\n" NOR:
                                           HIW "$N" HIW "太玄内劲迸发，$n" HIW "只感全身一"
                                           "震，登时“喀喀喀”断了数根肋骨！\n" NOR;
                }
                result += ([ "msg" : msg ]);
                return result;
        }
}

int practice_skill(object me)
{
        return notify_fail("太玄功只能用学(learn)的来增加熟练度。\n");
}

int valid_learn(object me)
{
        int level;
 
        //拥有大智若愚技能的人可以学习读书技能
        if ( !me->query("special_skill/da_zhi_ru_yu") && me->query_skill("literate", 1))
                return notify_fail("你觉得太玄神功深奥之极，一时间难以领会。\n");

        if (me->query("gender") == "无性")
                return notify_fail("你无根无性，阴阳不调，难以领会高深的太玄功。\n");

        if ((int)me->query("int") < 18)
                return notify_fail("你若有所悟，然而总是有点不明白。\n");

        if ((int)me->query("dex") < 25)
                return notify_fail("你研究了半天，只觉招式始终无法随意施展。\n");
        
        if ((int)me->query("con") < 25)
                return notify_fail("你研究了半天，只觉得根骨有些差，招式始终无法随意施展。\n");
        
        if ((int)me->query("str") < 25)
                return notify_fail("你研究了半天，感觉膂力有些低，始终无法随意施展。\n");

        level = me->query_skill("taixuan-gong", 1);

        if (me->query_skill("force", 1) < level)
                return notify_fail("你对基本内功的理解还不够，无法继续领会更"
                                   "高深的太玄功。\n");

        if (me->query_skill("unarmed", 1) < level)
                return notify_fail("你对基本拳脚的理解还不够，无法继续领会更"
                                   "高深的太玄功。\n");

        if (me->query("special_skill/da_zhi_ru_yu"))
        {
        int dzry_level = TALNET_MASTER->query_talnet_level(me, "da_zhi_ru_yu");
        if (me->query_skill("literate", 1) > 50 * dzry_level)
                return notify_fail("你觉得太玄神功深奥之极，一时间难以领会。\n");
        }

        return ::valid_learn(me);
}

int get_ready(object me)
{
        return 1;
}

int difficult_level()
{
        return 200;
}

string perform_action_file(string action)
{
        return __DIR__"taixuan-gong/perform/" + action;
}

string exert_function_file(string action)
{
        return __DIR__"taixuan-gong/exert/" + action;
}

string query_description()
{
    string msg;
    
    msg = HIY "【太玄功】" ZJBR NOR;
    msg += "太玄功是侠客岛石壁上所记载的绝世武功，乃天下武学的精髓，博大精深，包罗万象，集天下武学之大成。" ZJBR ZJBR;
    
    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  不可有读书写字技能，除非拥有大智若愚特技或已经转世。" ZJBR;
    msg += "  先天悟性18以上。" ZJBR;
    msg += "  先天身法25以上。" ZJBR;
    msg += "  先天根骨25以上。" ZJBR;
    msg += "  先天臂力25以上。" ZJBR;
    msg += "  基本内功等级不低于太玄功等级。" ZJBR;
    msg += "  基本拳脚等级不低于太玄功等级。" ZJBR ZJBR;
    
    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功（force）。" ZJBR;
    msg += "  拳脚（unarmed）。" ZJBR;
    msg += "  招架（parry）。" ZJBR;
    msg += "  轻功（dodge）。" ZJBR;
    msg += "  学会驾御兵器后可激发为：" ZJBR;
    msg += "  剑法（sword）。" ZJBR;
    msg += "  刀法（blade）。" ZJBR ZJBR;
    
    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  太玄功只能通过学习（learn）来提升熟练度。" ZJBR ZJBR;
    
    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  1. 太玄功可提升内力上限，提升值为：太玄功等级 × 太玄功等级 × 20 × 15 ÷ 100 ÷ 200。" ZJBR;
    msg += "  2. 太玄功可作为轻功使用，可躲避攻击。" ZJBR;
    msg += "  3. 防御特效：在满足以下条件时，可以抵消伤害：" ZJBR;
    msg += "     · 太玄功等级不低于150级；" ZJBR;
    msg += "     · 招架激发为太玄功；" ZJBR;
    msg += "     · 内功激发为太玄功；" ZJBR;
    msg += "     · 拳脚激发为太玄功；" ZJBR;
    msg += "     · 内力不低于最大内力的三分之一；" ZJBR;
    msg += "     命中判定：(对方内功等级×12+对方最大内力) 与 (自身内功等级×12+自身当前内力) 比较。" ZJBR;
    msg += "     如果 [对方实力÷2+随机(对方实力)] < 自身实力，则防御成功。" ZJBR;
    msg += "     每次成功防御消耗内力为伤害值的四分之一。" ZJBR;
    msg += "  4. 攻击特效：在满足以下条件时，有几率造成额外伤害：" ZJBR;
    msg += "     · 伤害值大于150；" ZJBR;
    msg += "     · 太玄功等级不低于140级；" ZJBR;
    msg += "     · 内力不低于300点；" ZJBR;
    msg += "     · 内功激发为太玄功；" ZJBR;
    msg += "     · 若未学会驾御兵器，则拳脚准备为太玄功；" ZJBR;
    msg += "     · 若已学会驾御兵器，则需要激发对应的兵器技能为太玄功；" ZJBR;
    msg += "     额外伤害计算：当伤害值的一半大于目标的先天根骨且随机数为偶数时，" ZJBR;
    msg += "     造成 (伤害值-80)÷3 的额外伤害，同时消耗100点内力。" ZJBR ZJBR;
    
    msg += HIY "〖特殊招式〗" ZJBR NOR;
    
    msg += HIC "  太玄护体 (shield)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      太玄功等级 40 级。" ZJBR;
    msg += "      当前内力 100 点。" ZJBR;
    msg += "      内功激发为太玄功。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升防御力、招架和轻功，提升值为基本内功等级的三分之一。" ZJBR;
    msg += "      若已打通任督二脉，则效果翻倍。" ZJBR;
    msg += "      持续时间等于太玄功等级（单位：秒）。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 100 点。" ZJBR;
    msg += "      使用后会忙碌 2 秒。" ZJBR ZJBR;
    
    msg += HIC "  太玄战气 (powerup)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      当前内力 100 点。" ZJBR;
    msg += "      内功激发为太玄功。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升攻击力和拳脚伤害，攻击力提升值为基本内功等级的三分之一，拳脚伤害提升值为基本内功等级的六分之一。" ZJBR;
    msg += "      若已打通任督二脉，则效果提升为基本内功等级的三分之二和四分之一。" ZJBR;
    msg += "      持续时间等于基本内功等级（单位：秒）。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 100 点。" ZJBR;
    msg += "      使用后会忙碌 3 秒。" ZJBR ZJBR;
    
    msg += HIC "  白首玄音 (roar)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      太玄功等级 50 级。" ZJBR;
    msg += "      当前内力 600 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      发出惊天动地的巨吼，攻击周围所有敌人。" ZJBR;
    msg += "      命中判定：自身技能值的一半+随机(自身技能值的一半) > 对方基本内功等级÷5。" ZJBR;
    msg += "      技能值 = 基本内功等级÷4 + 太玄功等级。" ZJBR;
    msg += "      伤害计算：对精神造成[技能值-对方最大内力÷10]点伤害。" ZJBR;
    msg += "      如果对方当前内力少于技能值的两倍，还会造成精神内伤。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 150 点。" ZJBR;
    msg += "      气血 10 点。" ZJBR;
    msg += "      使用后会忙碌 5 秒。" ZJBR ZJBR;
    
    msg += HIC "  混天一气 (hun)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      太玄功等级 120 级。" ZJBR;
    msg += "      当前内力 600 点。" ZJBR;
    msg += "      拳脚激发为太玄功。" ZJBR;
    msg += "      内功激发为太玄功。" ZJBR;
    msg += "      拳脚准备为太玄功。" ZJBR;
    msg += "      空手状态。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      双手推出强劲气流攻击敌人。" ZJBR;
