int valid_enable(string usage) { return usage=="cuff" || usage=="strike" || usage=="parry"; }

int valid_combine(string combo) { return combo=="shedu-qiqiao"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练灵蛇拳必须空手。\n");

	if ((int)me->query_skill("hamagong", 1) < 30)
		return notify_fail("你的蛤蟆功火候不够，无法学灵蛇拳。\n");

	if ((int)me->query("max_neili") < 500)
		return notify_fail("你的内力太弱，无法练灵蛇拳。\n");

	if ((int)me->query_skill("cuff", 1) < (int)me->query_skill("lingshe-quan", 1))
		return notify_fail("你的基本拳法水平有限，无法领会更高深的灵蛇拳法。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level   = (int) me->query_skill("lingshe-quan", 1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 60)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 60)
		return notify_fail("你的内力不够练灵蛇拳。\n");

	me->receive_damage("qi", 55);
	me->add("neili", -55);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"lingshe-quan/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【灵蛇拳】" ZJBR NOR;
    msg += WHT "白驼山嫡传拳法，模仿灵蛇动态，招式怪诞，出手刁钻狠辣，曲折如意，匪夷所思。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  必须空手。" ZJBR;
    msg += "  蛤蟆功 (`hamagong`) 等级不低于 " HIY "30" NOR " 级。" ZJBR;
    msg += "  最大内力 (`max_neili`) 不低于 " HIB "500" NOR " 点。" ZJBR;
    msg += "  基本拳法 (`cuff`) 等级需大于等于灵蛇拳等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  拳法 (`cuff`)。" ZJBR;
    msg += "  掌法 (`strike`)。" ZJBR;
    msg += "  招架 (`parry`)。" ZJBR ZJBR;

    msg += HIY "〖可组合武学〗" ZJBR NOR;
    msg += "  蛇毒奇巧 (`shedu-qiqiao`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血 (`qi`) 不低于 " HIR "60" NOR " 点。" ZJBR;
    msg += "  内力 (`neili`) 不低于 " HIB "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血 " HIR "55" NOR " 点，内力 " HIB "55" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (Perform)〗" ZJBR NOR;
    msg += HIC "  柔字诀 (rou)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      灵蛇拳等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      蛤蟆功 (`hamagong`) 等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      激发拳法为灵蛇拳。" ZJBR;
    msg += "      激发招架为灵蛇拳。" ZJBR;
    msg += "      当前内力不低于 " HIB "150" NOR " 点。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      施展灵蛇拳「柔」字诀，化解对手攻势，并有机会反击。" ZJBR;
    msg += "      化解判定：若 `(自身招架激发等级 + 随机(自身招架激发等级)) > 目标攻击激发等级` 则成功化解。" ZJBR;
    msg += "      反击判定 (化解成功时)：若 `自身蛤蟆功等级 > (目标内功激发等级 / 2)` 则触发反击。" ZJBR;
    msg += "      反击效果：模仿对手招式进行反击，造成一次伤害，伤害计算基于系统标准攻防。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 练习和使用灵蛇拳必须空手。" ZJBR;
    msg += "2. 灵蛇拳可以激发为拳法、掌法或招架，具有一定的通用性。" ZJBR;
    msg += "3. 特殊招式「柔字诀」是防御反击型招式，依赖于招架等级和蛤蟆功等级。" ZJBR;
    msg += "4. 配合蛤蟆功及组合武学蛇毒奇巧能发挥更大威力。" ZJBR;

    return msg;
}
