int valid_enable(string usage) { return (usage == "blade") || (usage == "parry"); }

int valid_learn(object me)
{
    if ((int)me->query("max_neili") < 500)
	return notify_fail("你的内力修为不够。\n");

    if ((int)me->query_skill("force") < 100)
	return notify_fail("你的内功火候太浅。\n");

    if ((int)me->query_skill("blade", 1) < (int)me->query_skill("xuanxu-dao", 1))
	return notify_fail("你的基本刀法水平有限，无法领会更高深的玄虚刀法。\n");

    return 1;
}
string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action)-1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}
mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("xuanxu-dao", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}
int practice_skill(object me)
{
    object weapon;

    if (! objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
	return notify_fail("你使用的武器不对。\n");

    if ((int)me->query("qi") < 60)
	return notify_fail("你的体力不够练玄虚刀法。\n");

    if ((int)me->query("neili") < 60)
	return notify_fail("你的内力不够练玄虚刀法。\n");

    me->receive_damage("qi", 45);
    me->add("neili", -43);
    return 1;
}
string perform_action_file(string action)
{
	return __DIR__"xuanxu-dao/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【玄虚刀法】" NOR ZJBR;
    msg += "此刀法招式变幻莫测，虚实难辨，以巧劲伤敌。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" NOR ZJBR;
    msg += "  最大内力 (max_neili) 不低于 " HIB "500" NOR " 点。" ZJBR;
    msg += "  基本内功 (force) 不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "  基本刀法 (blade) 等级不低于 玄虚刀法 等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" NOR ZJBR;
    msg += "  刀法 (blade)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" NOR ZJBR;
    msg += "  必须装备刀类武器。" ZJBR;
    msg += "  气血 (qi) 不低于 " HIR "60" NOR " 点。" ZJBR;
    msg += "  内力 (neili) 不低于 " HIB "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗 气血：" HIR "45" NOR " 点。" ZJBR;
    msg += "  每次练习消耗 内力：" HIB "43" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" NOR ZJBR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" NOR ZJBR;
    msg += HIC "  乱环诀 (huan)" NOR ZJBR;
    msg += "    使用要求：" ZJBR;
    msg += "      基本玄虚刀法 (xuanxu-dao) 不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      基本内功 (force) 不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力 (neili) 不低于 " HIB "250" NOR " 点。" ZJBR;
    msg += "      激发刀法 (blade) 为玄虚刀法。" ZJBR;
    msg += "      自身非忙乱 (busy) 状态。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      刀出成环，连续攻击敌人 " HIY "2" NOR " 至 " HIY "5" NOR " 次（次数由有效刀法等级决定）。" ZJBR;
    msg += "      攻击力 (AP) 取决于自身有效刀法等级。" ZJBR;
    msg += "      防御力 (DP) 取决于目标有效招架等级。" ZJBR;
    msg += "      命中判定：(攻击力(AP) / 2 + 随机(攻击力(AP))) > 防御力(DP)。" ZJBR;
    msg += "      命中后造成伤害，伤害值约为 (攻击力(AP) / 2 + 随机(攻击力(AP) / 2))。" ZJBR;
    msg += "      每次命中会额外给对手造成气血伤势。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      首次命中：消耗内力 " HIB "180" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      首次未命中：消耗内力 " HIB "210" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;

    return msg;
}