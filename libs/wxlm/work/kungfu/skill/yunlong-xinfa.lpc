// yunlong-xinfa.c 云龙心法

inherit SKILL;

void create() { seteuid(getuid()); }

string type() { return "knowledge"; }

int practice_skill(object me)
{	
	return notify_fail("云龙心法只能靠学(learn)来提高。\n");
}

string query_description()
{
	string msg;

	msg = HIY "【云龙心法】" ZJBR NOR;
	msg += WHT "云龙心法是天地会总舵主陈近南的独门心法，乃云龙门的基础。" ZJBR ZJBR;

	msg += HIY "〖学习要求〗" ZJBR NOR;
	msg += "  无特殊要求。" ZJBR ZJBR;

	msg += HIY "〖激发类型〗" ZJBR NOR;
	msg += "  知识类技能，无法激发。" ZJBR ZJBR;

	msg += HIY "〖练习要求〗" ZJBR NOR;
	msg += "  云龙心法只能通过学习 (learn) 提升，无法练习 (practice)。" ZJBR ZJBR;

	msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
	msg += "  暂无。" ZJBR ZJBR;

	msg += HIY "〖特殊招式〗" ZJBR NOR;
	msg += "  暂无。" ZJBR;

	return msg;
}