    msg += "      当前内力 " HIB "500" NOR " 点。" ZJBR;
    msg += "      只能在战斗中对对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标造成一次随机类型（黑青掌印、击飞、流血、气剑穿透）的攻击。" ZJBR;
    msg += "      造成 (明玉功等级 / 2 + 随机(明玉功等级 / 2)) 点精力伤害。" ZJBR;
    msg += "      临时降低目标精力抗性 (10 + (明玉功等级 - 180) / 2) 点（最多降低40点）。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗当前内力的四分之一。" ZJBR;
    msg += "      使用后忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  琼楼玉宇 (qiong)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      明玉功等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      基本拳脚 (`unarmed`) 等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      最大内力 " HIB "1000" NOR " 点。" ZJBR;
    msg += "      当前内力 " HIB "400" NOR " 点。" ZJBR;
    msg += "      加力 (`jiali`) 需大于 0。" ZJBR;
    msg += "      性别为 " HIM "女性" NOR "。" ZJBR;
    msg += "      激发内功、招架、拳脚、轻功均为明玉功。" ZJBR;
    msg += "      空手状态。" ZJBR;
    msg += "      只能在战斗中对对手使用。" ZJBR;
    msg += "      有冷却时间。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升自身状态，增加攻击、伤害、防御。" ZJBR;
    msg += "        增幅 = (明玉功等级 / 30) + (基本拳脚等级 / 30) + (基本内功等级 / 35)" ZJBR;
    msg += "        提升攻击力：增幅" ZJBR;
    msg += "        提升伤害：增幅" ZJBR;
    msg += "        提升防御力：增幅 * 2" ZJBR;
    msg += "      持续时间：增幅 / 4 秒。" ZJBR;
    msg += "      期间每次空手攻击命中时，额外追击4次（触发 `hit_ob` 逻辑）。" ZJBR; // 通过hit_ob实现
    msg += "    消耗与代价：" ZJBR;
    msg += "      发动时消耗内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      期间每次触发追击消耗内力 " HIB "40" NOR " 点。" ZJBR; // hit_ob qiong 追击消耗
    msg += "      效果结束后忙乱 " HIR "3" NOR " 秒（如果在战斗中）。" ZJBR;
    msg += "      结束后进入冷却状态，持续 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  魔气血杀 (moqi)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      明玉功等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      基本内功 (`force`) 等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "1000" NOR " 点。" ZJBR;
    msg += "      激发内功为明玉功。" ZJBR;
    msg += "      只能在战斗中对对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      自残气血，发动强力一击。判定基于双方内功等级 (`通用命中公式`)。" ZJBR;
    msg += "      对PVE目标增加50%命中率。" ZJBR;
    msg += "      判定成功（最终杀招「魔血气杀」）：" ZJBR;
    msg += "        基础伤害 = (内功激发等级 + 剑法激发等级 + 拳脚激发等级) * 4" ZJBR;

    msg += "        每层星屑化域奥义增加5%最终伤害" ZJBR;
    msg += "        造成远程伤害（单招类型），最终伤害系数比例为基础伤害x(150-200%)" ZJBR;
    msg += "        对目标造成 (基础伤害 / 4) 点精神伤害" ZJBR;
    msg += "        使目标忙乱 3-4 秒" ZJBR;
    msg += "        自身损失当前气血的 10%" ZJBR;
    msg += "        消耗内力 " HIB "500" NOR " 点" ZJBR;
    msg += "      判定失败（随机情况1）：" ZJBR;
    msg += "        无伤害效果" ZJBR;
    msg += "        自身损失当前气血的 1%" ZJBR;
    msg += "        消耗内力 " HIB "200" NOR " 点" ZJBR;
    msg += "      判定失败（随机情况2）：" ZJBR;
    msg += "        对目标造成 (明玉功等级) 点真实伤害" ZJBR;
    msg += "        使目标忙乱 3 秒" ZJBR;
    msg += "        自身损失当前气血的 5%" ZJBR;
    msg += "        消耗内力 " HIB "300" NOR " 点" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      根据判定结果消耗不同的气血和内力（见上）" ZJBR;
    msg += "      使用后忙乱 4-5 秒" ZJBR ZJBR;

    msg += HIC "  星屑旋转 (zhuan)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      明玉功等级 " HIY "150" NOR " 级（第九重）。" ZJBR;
    msg += "      当前内力 " HIB "1500" NOR " 点（明玉功低于10重时）。" ZJBR;
    msg += "      只能在战斗中使用。" ZJBR;
    msg += "      有冷却时间 (8秒)。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      生成真气漩涡，对区域内所有敌人施加持续影响。" ZJBR;
    msg += "      影响强度 (`count`) = (自身内功激发等级 - 敌方内功激发等级) / 50 （最低为4）。" ZJBR;
    msg += "      每 2 秒对范围内的敌人进行一次判定：" ZJBR;
    msg += "        随机效果1（举步维艰）：" ZJBR;
    msg += "          若自身明玉功等级 >= 200，使敌人高级忙乱 2-3 秒。" ZJBR;
    msg += "          否则，使敌人普通忙乱 2-3 秒。" ZJBR;
    msg += "        随机效果2（功力流失）：" ZJBR;
    msg += "          吸取敌人最大内力的 1/15 补充自身（不超过自身最大内力）。" ZJBR;
    msg += "          若自身掌握奥义「星屑化域」，额外造成 (自身最大气血 * 奥义等级 / 100) 点气血伤害。" ZJBR;
    msg += "      效果持续 `count` * 2 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      发动时无内力消耗。" ZJBR; // 消耗在后续效果中体现
    msg += "      发动后忙乱 " HIR "2" NOR " 秒。" ZJBR;

    return msg;
}
