// shield.c 九阳护体神功



inherit F_CLEAN_UP;

void remove_effect(object me, int amount);
string query_name() { return "四象"ZJBR"真罡"; }
int exert(object me, object target)
{
        int skill;

        if (target != me)
                return notify_fail("你只能用四象神功来提升自己的防御力。\n");

        if ((int)me->query("neili") < 100)
                return notify_fail("你的真气不够。\n");

        if ((int)me->query_skill("sixiang-shengong", 1) < 40)
                return notify_fail("你的四象神功等级不够。\n");

        if ((int)me->query_temp("shield"))
                return notify_fail("你已经在运功中了。\n");

        skill = me->query_skill("force");
        me->add("neili", -100);
        me->receive_damage("qi", 0);

        message_combatd(HIR "$N" HIR "默念四象神功的口诀：青龙"
                            "居东，朱雀飞南，白虎镇西，玄武守北，"
                            "四象相生，天地之势……\n刹那间只见$N" 
                        HIR "全身顿时浮现出一层四色流转的护体真罡，将$P"
                        HIR "全全笼罩。\n" NOR, me);

        me->add_temp("apply/armor", skill / 3);
        me->add_temp("apply/parry", skill / 3);
        me->add_temp("apply/dodge", skill / 3);
        me->set_temp("shield", 1);

        me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill :), skill);

        if (me->is_fighting()) me->start_busy(2);

        return 1;
}

void remove_effect(object me, int amount)
{
        if (me->query_temp("shield"))
        {
                me->add_temp("apply/armor", -amount / 3);
                me->delete_temp("shield");
                me->add_temp("apply/parry", - (amount / 3));
                me->add_temp("apply/dodge", - (amount / 3));
                tell_object(me, "你的四象神功运行完毕，将内力收回丹田。\n");
        }
}

