// 四象归元


#include <combat.h>

inherit F_SSERVER;

string query_name() { return "四象归元"; }
// string *pfm_type() { return ({ "force", }); }

int exert(object me, object target)
{
    int skill, recover, recover_neili;
    
    if ((int)me->query_skill("sixiang-shengong", 1) < 100)
        return notify_fail("你的四象神功修为不够，还不能使用「四象归元」。\n");

    if ((int)me->query("neili") < 500)
        return notify_fail("你的内力不够。\n");

    if (me->query_temp("sixiang_guiyuan"))
        return notify_fail("你已经使用过「四象归元」了，请等待下一回合再使用。\n");

    if ((int)me->query("eff_qi") == (int)me->query("max_qi") &&
        (int)me->query("neili") == (int)me->query("max_neili"))
        return notify_fail("你现在气血充盈，内力充沛。\n");

    skill = me->query_skill("force") * 2;
    recover = skill;
    recover_neili = skill / 2;

    message_vision(HIW "$N" HIW "运转四象神功，四象之力在体内流转，气血和内力渐渐恢复。\n" NOR, me);

    me->receive_heal("qi", recover);
    me->add("neili", recover_neili);
    
    if (me->query("neili") > me->query("max_neili"))
        me->set("neili", me->query("max_neili"));

    me->add("neili", -200);
    me->set_temp("sixiang_guiyuan", 1);

    return 1;
}
