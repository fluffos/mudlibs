/**
 * @brief 查询子技能映射（用于演练系统）
 * @return mapping 子技能映射
 * @details 返回演练所需的四门武功及其最低等级要求
 */
mapping query_sub_skills()
{
    return ([
        "jiuyang-shengong"     : 700,   // 九阳神功
        "jiuyin-shengong"      : 700,   // 九阴神功
        "shenzhaojing"         : 700,   // 神照经
        "chiyou-kuangzhanjue"  : 700,   // 蚩尤狂战决
    ]);
}

/**
 * @brief 演练准备检查
 * @param object me 演练者
 * @return int 是否可以开始演练
 * @details 检查演练者是否满足所有演练条件
 */
int get_ready(object me)
{
    // 检查最大内力
    if ((int)me->query("max_neili") < 100000)
    {
        write("你的最大内力不足十万，无法融合四门神功。\n");
        return 0;
    }

    // 检查武学修养
    if ((int)me->query_skill("martial-cognize", 1) < 700)
    {
        write("你的武学修养不足700级，无法理解永照山河经的融合之道。\n");
        return 0;
    }

    // 检查先天属性
    if (me->query("str") < 25)
    {
        write("你的先天臂力不足25，无法承受演练时的巨大压力。\n");
        return 0;
    }

    if (me->query("int") < 30)
    {
        write("你的先天悟性不足30，无法领悟永照山河经的精髓。\n");
        return 0;
    }

    if (me->query("con") < 30)
    {
        write("你的先天根骨不足30，无法承受四门武功融合时的冲击。\n");
        return 0;
    }

    write(HIY "\n你深吸一口气，开始演练永照山河经。\n\n" NOR);
    write(HIG "九阳神功的纯阳之气开始在你体内流转...\n" NOR);
    write(HIC "九阴神功的至阴之力与之呼应...\n" NOR);
    write(HIY "神照经的霸道内劲横贯经脉...\n" NOR);
    write(HIR "蚩尤狂战决的战意在心中升腾...\n\n" NOR);
    write(HIM "四门神功开始在你体内激烈碰撞，寻求融合之道！\n\n" NOR);

    return 1;
}

/**
 * @brief 演练完成处理
 * @param object me 演练者
 * @return int 是否演练成功
 * @details 演练成功后融合四门武功为永照山河经
 */
int get_finish(object me)
{

    if ((int)me->query("max_neili") < 100000)
        return 0;

    if ((int)me->query_skill("martial-cognize", 1) < 700)
        return 0;

    if (me->query("str") < 25 || me->query("int") < 30 || me->query("con") < 30)
        return 0;


    write(HIM "\n突然间，你福至心灵，四门武功的精髓在你心中融为一体！\n" NOR);
    write(HIW "阴阳相济，刚柔并存，狂猛霸道，正大光明！\n" NOR);
    write(HIY "山河为证，日月同辉，你终于领悟了永照山河经的真谛！\n\n" NOR);
    write(HIG "恭喜你成功演练出永照山河经！\n" NOR);

    return 1;
}