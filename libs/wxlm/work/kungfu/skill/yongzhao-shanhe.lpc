// 可激发的武功类型
string *usage_skills = ({ "force", "unarmed", "sword", "blade", "dodge", "parry" });

/**
 * @brief 判断武功可激发类型
 * @param string usage 激发类型
 * @return int 是否可激发
 */
int valid_enable(string usage)
{
    return (member_array(usage, usage_skills) != -1);
}

/**
 * @brief 内功兼容性检查
 * @param string force 内功名称
 * @return int 是否兼容
 */
int valid_force(string force)
{
    return 1;
}

/**
 * @brief 双倍攻击特效
 * @return int 返回1表示有双倍攻击
 */
int double_attack()
{
    return 1;
}

/**
 * @brief 计算内力上限提升值
 * @param object me 角色对象
 * @return int 内力提升值
 */
int query_neili_improve(object me)
{
    int lvl;

    lvl = (int)me->query_skill("yongzhao-shanhe", 1);
    // 融合四门神功，内力提升更加强大
        return lvl / 10 * lvl / 10 * 15 * 28 / 10 / 20;
}

/**
 * @brief 获取招式动作
 * @param object me 使用者
 * @param object weapon 武器对象
 * @return mapping 招式映射
 */
mapping query_action(object me, object weapon)
{
    return weapon ? actionw[random(sizeof(actionw))] :
                    actionf[random(sizeof(actionf))];
}

/**
 * @brief 获取轻功闪避描述
 * @param string limb 攻击部位
 * @return string 闪避描述
 */
string query_dodge_msg(string limb)
{
    return dodge_msg[random(sizeof(dodge_msg))];
}

/**
 * @brief 学习条件检查
 * @param object me 学习者
 * @return int 是否可学习
 */
int valid_learn(object me)
{
    // 永照山河经只能通过演练获得，无法直接学习
    if (me->query_skill("yongzhao-shanhe", 1) < 1)
        return notify_fail("永照山河经只能通过演练获得，无法直接学习。\n");

    // 已经通过演练获得，可以继续提升
    return 1;
}

/**
 * @brief 防御特效
 * @param object ob 攻击者
 * @param object me 防御者
 * @param int damage 伤害值
 * @param object weapon 武器
 * @return mixed 防御结果
 */
mixed valid_damage(object ob, object me, int damage, object weapon)
{
    mapping result;
    int ap, dp;
    int cost;
    int lvl;

    lvl = me->query_skill("yongzhao-shanhe", 1);

    if (lvl < 200
       || me->query_skill_mapped("parry") != "yongzhao-shanhe"
       || me->query_skill_mapped("force") != "yongzhao-shanhe"
       || (int)me->query("neili") < 1000
       || ! living(me))
        return;

    cost = damage / 3;

    ap = ob->query_skill("force") * 15 + ob->query("max_neili") + ob->query_skill("martial-cognize", 1) * 10;
    dp = me->query_skill("force") * 15 + me->query("max_neili") + me->query_skill("martial-cognize", 1) * 10;

    // 永照山河录防御更强
    if (ap / 2 + random(ap) < dp)
    {
        int guang_level, mo_level;
        int reduce_busy_chance, reduce_busy;
        string msg;

        me->add("neili", -cost);
        result = ([ "damage": -(damage * 4 / 5) ]);

        // 获取意境等级
        guang_level = COMBAT_D->get_skill_aoyi_level(me, "光明圣火");
        mo_level = COMBAT_D->get_skill_aoyi_level(me, "魔血染刀");

        // 计算减少忙乱的概率和数值
        reduce_busy_chance = (guang_level + mo_level) * 2;
        reduce_busy = 2 + random(2); // 2-3点忙乱

        // 判断是否触发减少忙乱效果
        if (reduce_busy_chance > 0 && random(100) < reduce_busy_chance && me->is_busy())
        {
            me->interrupt_me(me, reduce_busy);
            msg = HIW "$n" HIW "四门神功护体，意境之力运转，身形重新变得灵活！\n" NOR;
        }

        switch (random(4))
        {
        case 0:
            result += ([
                "msg" : HIW "$n" HIW "运起永照山河录，阴阳二气护体，将$N"
                        HIW "的攻击尽数化解。\n" NOR + (msg ? msg : "")
            ]);
            break;
        case 1:
            result += ([
                "msg" : HIY "$n" HIY "神照金光护体，$N" HIY "的攻击"
                        "如泥牛入海，消失无踪。\n" NOR + (msg ? msg : "")
            ]);
            break;
        case 2:
            result += ([
                "msg" : HIR "$n" HIR "狂战之意爆发，以攻为守，竟将$N"
                        HIR "震退数步。\n" NOR + (msg ? msg : "")
            ]);
            break;
        default:
            result += ([
                "msg" : HIM "$n" HIM "山河永照，日月同辉，$N" HIM
                        "的攻击被无形之力尽数挡下。\n" NOR + (msg ? msg : "")
            ]);
            break;
        }
        return result;
    }
}

/**
 * @brief 攻击特效
 * @param object me 攻击者
 * @param object victim 受害者
 * @param int damage_bonus 伤害加成
 * @return mixed 特效描述
 */
mixed hit_ob(object me, object victim, int damage_bonus)
{
    int lvl;
    int new_damage;

    lvl = me->query_skill("yongzhao-shanhe", 1);

    if (damage_bonus < 200
       || lvl < 200
       || me->query("neili") < 500
       || me->query_skill_mapped("force") != "yongzhao-shanhe")
        return 0;

    // 根据伤害等级触发不同特效
    if (damage_bonus / 4 > victim->query_con())
    {
        // 神照断骨效果
        if (random(4) == 0)
        {
            new_damage = (damage_bonus - 150) / 2;
            new_damage -= victim->query_temp("apply/armor") / 10;

            if (new_damage < 1)
                new_damage = 1;

            me->add("neili", -100);
            COMBAT_D->real_damage(me, victim, new_damage);

            // 添加神照内劲状态
            victim->affect_by("shenzhao",
                ([ "level" : me->query("jiali") + random(me->query("jiali")),
                   "id"    : me->query("id"),
                   "duration" : lvl / 100 + random(lvl / 50) ]));

            return HIR "只见$N" HIR "永照神功发动，神照经内劲透体而出，"
                   "$n" HIR "一声惨嚎，骨骼爆响不绝！\n" NOR;
        }

        // 阴阳合击效果
        if (random(3) == 0)
        {
            new_damage = damage_bonus / 3;
            new_damage -= victim->query_temp("apply/armor") / 15;

            if (new_damage < 1)
                new_damage = 1;

            me->add("neili", -80);
            COMBAT_D->real_damage(me, victim, new_damage);

            return random(2) ?
                HIW "只见$N" HIW "阴阳二气齐发，九阴九阳之力同时爆发，"
                "$n" HIW "被震得口吐鲜血！\n" NOR :
                HIM "$N" HIM "山河永照，日月同辉，恐怖的内劲贯穿$n"
                HIM "全身经脉！\n" NOR;
        }

        // 狂战爆发效果
        if (random(4) == 0 && me->query("qi") > me->query("max_qi") / 2)
        {
            new_damage = damage_bonus / 2;

            // 狂战决的以伤换伤特性
            me->receive_damage("qi", new_damage / 5);
            me->add("neili", -150);

            COMBAT_D->real_damage(me, victim, new_damage);

            return HIR "$N" HIR "战意冲天，蚩尤狂战决爆发，不惜自损也要重创$n"
                   HIR "！\n" NOR;
        }
    }

    // 普通内劲伤害
    if (damage_bonus / 5 > victim->query_con())
    {
        new_damage = (damage_bonus - 180) / 3;
        new_damage -= victim->query_temp("apply/armor") / 12;

        if (new_damage < 1)
            new_damage = 1;

        me->add("neili", -60);
        COMBAT_D->real_damage(me, victim, new_damage);

        return random(2) ?
            HIY "$N" HIY "永照神功的内劲如山河奔涌，摧毁了$n"
            HIY "的护体真气！\n" NOR :
            HIC "$N" HIC "阴阳调和，刚柔并济，内劲悄然侵入$n"
            HIC "体内！\n" NOR;
    }
}

/**
 * @brief 查询招架效果加成
 * @param object attacker 攻击者
 * @param object me 防御者
 * @return int 招架加成百分比
 */
int query_effect_parry(object attacker, object me)
{
    int lvl;

    lvl = me->query_skill("yongzhao-shanhe", 1);
    if (lvl < 200) return 0;
    if (lvl < 250) return 80;
    if (lvl < 300) return 100;
    if (lvl < 350) return 120;
    if (lvl < 400) return 140;
    if (lvl < 450) return 160;
    return 180;
}

/**
 * @brief 练习技能
 * @param object me 练习者
 * @return int 是否可练习
 */
int practice_skill(object me)
{
    return notify_fail("永照山河经乃融合四门绝学而成，只能通过领悟(research)来提升。\n");
}

/**
 * @brief 获取难度等级
 * @return int 难度值
 */
int difficult_level()
{
    return 2000;
}

/**
 * @brief 获取perform招式文件路径
 * @param string action 招式名称
 * @return string 文件路径
 */
string perform_action_file(string action)
{
    return __DIR__"yongzhao-shanhe/perform/" + action;
}

/**
 * @brief 获取exert内功文件路径
 * @param string action 内功名称
 * @return string 文件路径
 */
string exert_function_file(string action)
{
    return __DIR__"yongzhao-shanhe/exert/" + action;
}

/**
 * @brief 获取武功描述
 * @return string 描述文本
 */
string query_description()
{
    string msg;

    msg = HIM "【永照山河经】" NOR + ZJBR + ZJBR;
    msg += WHT "永照山河经乃融合九阳神功、九阴神功、神照经、蚩尤狂战决四门绝学而成的宗师级武学。" ZJBR;
    msg += "此功阴阳并济，刚柔相济，既有九阳之刚猛，又具九阴之博大，" ZJBR;
    msg += "更兼神照经之霸道与蚩尤狂战决之凶猛，实为武学之巅峰。" ZJBR;
    msg += "修炼此功者，内力如山河奔涌，招式如日月经天，攻防一体，变化无穷。" ZJBR + ZJBR;

    msg += HIR "〖获得方式〗" ZJBR NOR;
    msg += "  永照山河经只能通过演练获得" ZJBR;
    msg += "  演练成功后四门武功将融合为永照山河经，原武功消失" ZJBR + ZJBR;

    msg += HIY "〖演练要求〗" ZJBR NOR;
    msg += "  九阳神功基本等级不低于 " HIY "700" NOR " 级。" ZJBR;
    msg += "  九阴神功基本等级不低于 " HIY "700" NOR " 级。" ZJBR;
    msg += "  神照经基本等级不低于 " HIY "700" NOR " 级。" ZJBR;
    msg += "  蚩尤狂战决基本等级不低于 " HIY "700" NOR " 级。" ZJBR;
    msg += "  最大内力不低于 " HIB "10,0000" NOR " 点。" ZJBR;
    msg += "  武学修养等级不低于 " HIY "700" NOR " 级。" ZJBR;
    msg += "  先天臂力不低于 " HIY "25" NOR " 点。" ZJBR;
    msg += "  先天悟性不低于 " HIY "30" NOR " 点。" ZJBR;
    msg += "  先天根骨不低于 " HIY "30" NOR " 点。" ZJBR + ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功 (force)。" ZJBR;
    msg += "  拳脚 (unarmed)。" ZJBR;
    msg += "  剑法 (sword)。" ZJBR;
    msg += "  刀法 (blade)。" ZJBR;
    msg += "  轻功 (dodge)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR + ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  无法通过练习提升，只能通过研究提升熟练度。" ZJBR + ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  " HIW "内力上限提升" NOR "：" ZJBR;
    msg += "    提升值 = 等级/10 * 等级/10 * 15 * 28 / 10 / 20。" ZJBR;
    msg += "  " HIW "双倍攻击" NOR "：" ZJBR;
    msg += "    激发永照山河经时，普通攻击均有双倍攻击次数效果。" ZJBR;
    msg += "  " HIW "山河永照护体" NOR "：" ZJBR;
    msg += "    永照山河经等级不低于 " HIY "200" NOR " 级。" ZJBR;
    msg += "    激发招架、内功为永照山河经。" ZJBR;
    msg += "    当前内力不低于 " HIB "1000" NOR " 点。" ZJBR;
    msg += "    有几率化解 " HIY "80%" NOR " 伤害。" ZJBR;
    msg += "    减少忙乱：触发几率 = (光明圣火+魔血染刀)奥义等级 * " HIY "2%" NOR ZJBR;
    msg += "    减少忙乱数值：" HIY "2-3" NOR " 点，接口：me->interrupt_me(me, reduce_busy)" ZJBR;
    msg += "  " HIW "永照内劲" NOR "：" ZJBR;
    msg += "    永照山河经等级不低于 " HIY "200" NOR " 级。" ZJBR;
    msg += "    造成的伤害加成不低于 " HIR "200" NOR " 点。" ZJBR;
    msg += "    触发多种内劲特效：神照断骨、阴阳合击、狂战爆发。" ZJBR;
    msg += "  " HIW "普攻招架增效" NOR "：" ZJBR;
    msg += "    永照山河经等级越高，普攻招架效果越强，最高可达 " HIY "180%" NOR " (450级时)。" ZJBR + ZJBR;

    msg += HIY "〖内功绝技 (Exert)〗" ZJBR NOR;
    msg += "  " HIW "阴阳调和 (yinyang)" NOR " - 增益技能" ZJBR;
    msg += "    等级要求：永照山河经" HIR "基本等级" NOR "≥" HIY "200" NOR " 级" ZJBR;
    msg += "    内力消耗：" HIB "200" NOR " 点" ZJBR;
    msg += "    效果提升：攻击+伤害 = 内功" HIR "激发等级" NOR " * 2/5" ZJBR;
    msg += "    意境加成：光明圣火(攻击+" HIY "激发等级*5" NOR "/层)，魔血染刀(伤害+" HIY "激发等级*8" NOR "/层)" ZJBR;
    msg += "    持续时间：内功" HIR "激发等级" NOR " + 光明圣火*2 + 魔血染刀*3 回合" ZJBR + ZJBR;

    msg += "  " HIY "日照山河 (rizhao)" NOR " - 防护技能" ZJBR;
    msg += "    等级要求：永照山河经" HIR "基本等级" NOR "≥" HIY "220" NOR " 级" ZJBR;
    msg += "    内力消耗：" HIB "300" NOR " 点" ZJBR;
    msg += "    效果提升：护甲+内功" HIR "激发等级" NOR "*3/5，招架+内功" HIR "激发等级" NOR "/5，轻功+内功" HIR "激发等级" NOR "/6" ZJBR;
