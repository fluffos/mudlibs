int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

int valid_learn(object me)
{
     object weapon;

     if (! objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "blade")
         return notify_fail("你必须手里拿着刀才能练刀法。\n");

     if ((int)me->query_skill("riyue-xinfa", 1) < 100)
         return notify_fail("你的内功心法火候太浅，不能学霹雳刀法。\n");

     if ((int)me->query_skill("blade", 1) < 80)
         return notify_fail("你的基本刀法火候不够。\n");

     if ((int)me->query("max_neili") < 300)
         return notify_fail("你的内力太低，无法学霹雳刀法。\n");

     if ((int)me->query_skill("blade", 1) < (int)me->query_skill("pili-daofa", 1))
         return notify_fail("你的刀法水平有限，无法领会更高深的霹雳刀法。\n");

     return 1;
}

string query_skill_name(int level)
{
     int i;
     for(i = sizeof(action)-1; i >= 0; i--)
     if(level >= action[i]["lvl"])
            return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
     int i, level;
     level = (int) me->query_skill("pili-daofa",1);
     for(i = sizeof(action); i > 0; i--)
         if(level > action[i-1]["lvl"])
              return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
     object weapon;

     if (! objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "blade")
            return notify_fail("你使用的武器不对。\n");

     if ((int)me->query("qi") < 70)
            return notify_fail("你的体力不够练霹雳刀法。\n");

     if ((int)me->query("neili") < 80)
            return notify_fail("你的内力不够练霹雳刀法。\n");

     me->receive_damage("qi", 65);
     me->add("neili", -68);
     return 1;
}

string perform_action_file(string action)
{
     return __DIR__"pili-daofa/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【霹雳刀法】" ZJBR NOR;
    msg += "一门强大的刀法，招式迅猛凌厉，势如霹雳。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  必须装备刀类武器。" ZJBR;
    msg += "  日月心法等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "  基本刀法等级 " HIY "80" NOR " 级。" ZJBR;
    msg += "  最大内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "  基本刀法等级不低于霹雳刀法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  刀法（blade）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须装备刀类武器。" ZJBR;
    msg += "  气血：不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "80" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "65" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "68" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  刀影重重 (ying)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      霹雳刀法等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "120" NOR " 点。" ZJBR;
    msg += "      必须装备刀类武器。" ZJBR;
    msg += "      激发刀法为霹雳刀法。" ZJBR;
    msg += "      必须在战斗中对指定对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：((基本刀法等级 / 2 + 霹雳刀法等级) / 2 + 随机(基本刀法等级 / 2 + 霹雳刀法等级)) > (对方轻功等级 / 2 + 对方招架等级)。" ZJBR;
    msg += "      命中后，临时提升自身攻击力 (判定成功的攻击力 / 攻击次数) 点，然后发动多次攻击。" ZJBR;
    msg += "      攻击次数由 `COMBAT_D->query_base_attack_number` 决定。" ZJBR;
    msg += "      每次攻击独立计算命中和伤害。" ZJBR;
    msg += "      未命中则不发动后续攻击。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      施展成功后，消耗内力值未在代码中明确体现。" ZJBR;
    msg += "      施展后自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    return msg;
}