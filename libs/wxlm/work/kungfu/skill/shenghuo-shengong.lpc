inherit FORCE;


int valid_enable(string usage) { return usage == "force"; }

int query_neili_improve(object me)
{
        int lvl;

        lvl = (int)me->query_skill("shenghuo-shengong", 1);
        return lvl * lvl * 15 * 16 / 100 / 200;
}

int valid_force(string force)
{
    return (force == "shenghuo-xinfa");
}

int valid_learn(object me)
{
        if (me->query("int") < 32)
                return notify_fail("你先天悟性不够，无法领悟圣火神功。\n");

        if ((int)me->query_skill("force", 1) < 180)
                return notify_fail("你的基本内功火候还不够，还不能学习圣火神功。\n");

        return ::valid_learn(me);
}

int practice_skill(object me)
{
        return notify_fail("圣火神功只能用学(learn)的来增加熟练度。\n");
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
        int lvl, i;
        int flvl, attack_time;
        object weapon;

        lvl  = me->query_skill("shenghuo-shengong", 1);
        flvl = me->query_skill("shenghuo-ling");

        if (lvl < 140 || ! damage_bonus ||
            me->query_skill_mapped("force") != "shenghuo-shengong" ||
            me->query_skill_mapped("sword") != "shenghuo-ling" ||
            ! objectp(weapon = me->query_temp("weapon")) ||
            (string)weapon->query("skill_type") != "sword" ||
            flvl < 140 ||
            me->query_temp("shenghuo-ling/hit") ||
            me->query("neili") < 200)
                return 0;

        attack_time = (int)(me->query_skill("shenghuo-ling", 1) / 40);

        if (attack_time > 8)
                attack_time = 8;


        if (lvl / 2 + random(lvl) > victim->query_skill("force", 1) &&
            ! me->query_temp("shenghuo-ling/max_hit") )
        {
                 message_vision(HIR "\n刹那间$N" HIR "身法陡然加快，剑招连绵而出，招式诡异无比"
                                "，令$n" HIR "难以琢磨。\n" NOR, me, victim);

                    
                 me->start_busy(1+ random(attack_time));
                 me->add("neili", -attack_time * 20);
                 me->add_temp("shenghuo-ling/hit", 1);
                 for (i = 0; i < attack_time; i++)
                 {
                       if (! me->is_fighting(victim))
                                 break;

                       COMBAT_D->do_attack(me, victim, weapon, 0);
                 }
                 me->delete_temp("shenghuo-ling/hit");
               
                 return 1;                
        }            
 
}

string exert_function_file(string func)
{
        return __DIR__"shenghuo-shengong/" + func;
}

string query_description()
{
    string msg;

    msg = HIY "【圣火神功】" ZJBR NOR;
    msg += WHT "圣火神功是明教的镇教神功，以其刚猛霸道的特性著称。是更高深的内功心法。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  先天悟性 " HIC "32" NOR " 以上。" ZJBR;
    msg += "  基本内功等级不低于 " HIY "180" NOR " 级。" ZJBR;
    msg += "  必须先学会 " HIC "圣火心法" NOR " (作为前置内功)。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功 (force)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  圣火神功只能通过学习 (learn) 来提升熟练度。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += HIC "  圣火令连击 (被动)" ZJBR NOR;
    msg += "    触发条件：" ZJBR;
    msg += "      装备武器为 " HIW "剑(sword)" NOR " 类型。" ZJBR;
    msg += "      激发内功为圣火神功，且等级不低于 " HIY "140" NOR " 级。" ZJBR;
    msg += "      激发剑法为 " HIC "圣火令法(shenghuo-ling)" NOR "，且等级不低于 " HIY "140" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "      普通攻击命中且造成伤害 (`damage_bonus > 0`)。" ZJBR;
    msg += "      未处于圣火令连击临时状态 (`shenghuo-ling/hit`) 或最大连击状态 (`shenghuo-ling/max_hit`)。" ZJBR;
    msg += "    效果判定：" ZJBR;
    msg += "      比较 (自身圣火神功等级 / 2 + 随机(自身圣火神功等级)) 与 目标激发内功等级 的大小。" ZJBR;
    msg += "    触发效果：" ZJBR;
    msg += "      如果判定成功，则追加数次普通攻击，攻击次数为 (圣火令法等级 / 40)，最多 " HIR "8" NOR " 次。" ZJBR;
    msg += "      每次追加攻击独立计算命中和伤害 (`COMBAT_D->do_attack`)。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      每次触发消耗内力，总量为 (攻击次数 * " HIB "20" NOR ") 点。" ZJBR;
    msg += "      自身忙乱，持续时间为 (1 + 随机(攻击次数)) 秒。" ZJBR ZJBR;
    msg += "  内力上限提升：" ZJBR;
    msg += "    提升值约为 (圣火神功等级 * 圣火神功等级 * 15 * 16 / 100 / 200)。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  暂无发现独立的主动招式文件 (未找到 `shenghuo-shengong` 目录)。" ZJBR ZJBR;

    return msg;
}
