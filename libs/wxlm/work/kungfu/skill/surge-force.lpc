// surge-force.c 怒海狂涛

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_force(string force) { return 1; }

int query_neili_improve(object me)
{
	int lvl;

	lvl = (int)me->query_skill("surge-force", 1);
	return lvl * lvl * 15 * 19 / 100 / 200;
}

int valid_learn(object me)
{
	if (me->query("gender") == "女性")
		return notify_fail("你不具有男性的阳刚之气，无法修习怒海狂涛。\n");

	if ((int)me->query_skill("force", 1) < 150)
		return notify_fail("你的基本内功火候还不够，还不能修炼怒海狂涛。\n");

	if (me->query_str() < 45)
		return notify_fail("你的膂力不足，难以修习怒海狂涛。\n");


	return ::valid_learn(me);
}

int practice_skill(object me)
{
	return notify_fail("怒海狂涛只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"surge-force/" + func;
}

string query_description()
{
    string msg;

    msg = HIM "【怒海狂涛】" ZJBR NOR;
    msg += "一门至阳至刚的内功心法，修炼者需有强大的膂力支撑，运功时如怒海狂涛，势不可挡。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  限男性角色。" ZJBR;
    msg += "  基本内功等级需达到 " HIY "150" NOR " 级。" ZJBR;
    msg += "  后天膂力需达到 " HIY "45" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  内功（force）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  无法通过练习（practice）提升，只能通过学习（learn）提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // query_neili_improve
    msg += "  提升内力上限：每级提升 " HIB "(怒海狂涛等级 * 怒海狂涛等级 * 15 * 19 / 100 / 200)" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖特殊招式（内功运用）〗" ZJBR NOR; // exert

    msg += HIC "  怒涛潮涌 (powerup)" ZJBR NOR; // 招式名称
    msg += "    使用要求：" ZJBR; // 招式使用要求
    msg += "      当前内力 " HIB "500" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR; // 招式效果描述
    msg += "      提升自身战斗力，效果持续 " HIY "(内功激发等级)" NOR " 秒。" ZJBR;
    msg += "      提升攻击力：" HIY "(内功激发等级 * 2 / 5)" NOR " 点。" ZJBR;
    msg += "      提升防御力：" HIY "(内功激发等级 * 2 / 5)" NOR " 点。" ZJBR;
    msg += "      提升物理伤害：" HIR "(内功激发等级 / 4)" NOR " 点。" ZJBR;
    msg += "      提升空手伤害：" HIR "(内功激发等级 / 4)" NOR " 点。" ZJBR;
    msg += "    消耗与代价：" ZJBR; // 消耗与代价
    msg += "      消耗内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      若在战斗中使用，自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  海纳百川 (shield)" ZJBR NOR; // 招式名称
    msg += "    使用要求：" ZJBR; // 招式使用要求
    msg += "      怒海狂涛等级 " HIY "50" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR; // 招式效果描述
    msg += "      提升自身防御能力和剑法威力，效果持续 " HIY "(内功激发等级)" NOR " 秒。" ZJBR;
    msg += "      提升护甲值：" HIY "(内功激发等级 / 2)" NOR " 点。" ZJBR;
    msg += "      提升剑法激发效果等级：" HIY "(内功激发等级 / 5)" NOR " 级。" ZJBR;
    msg += "      (注：效果可能受其他状态如 'sea-force_enhance' 影响，具体请自行探索)" ZJBR; // 提示潜在的增强效果
    msg += "    消耗与代价：" ZJBR; // 消耗与代价
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      若在战斗中使用，自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  黯然吟 (roar)" ZJBR NOR; // 招式名称
    msg += "    使用要求：" ZJBR; // 招式使用要求
    msg += "      怒海狂涛等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      不能在禁止战斗的房间使用。" ZJBR;
    msg += "    效果描述：" ZJBR; // 招式效果描述
    msg += "      发出长啸，对同房间内除自身外的所有生物进行精神攻击。" ZJBR;
    msg += "      攻击判定：若 攻击方 (内功激发等级 / 2 + 随机(内功激发等级 / 2)) > 目标 (后天根骨 * 2)，则攻击有效。" ZJBR;
    msg += "      伤害计算：若攻击有效，造成精神伤害。基础精神伤害值 = (内功激发等级 - 目标最大内力 / 10) * 2。" ZJBR;
    msg += "      附加效果：若目标当前内力 < 攻击方内功激发等级 * 2，则追加精神创伤，创伤值 = 基础精神伤害值 / 2。" ZJBR;
    msg += "      （玩家间有死亡保护机制）" ZJBR;
    msg += "    消耗与代价：" ZJBR; // 消耗与代价
    msg += "      消耗内力 " HIB "100" NOR " 点，气血 " HIR "10" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "5" NOR " 秒。" ZJBR;

    return msg;
}

