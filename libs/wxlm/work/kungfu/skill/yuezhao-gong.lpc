int valid_enable(string usage) { return usage == "claw" ||  usage == "parry"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练越爪功必须空手。\n");

	if ((int)me->query_skill("force") < 50)
		return notify_fail("你的内功火候不够，无法学越爪功。\n");

	if ((int)me->query("max_neili") < 400)
		return notify_fail("你的内力修为太弱，无法练越爪功。\n");

	if ((int)me->query_skill("claw") < 30)
		return notify_fail("你的基本爪法等级太低，无法学越爪功。\n");

	if ((int)me->query_skill("claw", 1) < (int)me->query_skill("yuezhao-gong", 1))
		return notify_fail("你的基本爪法火候水平有限，无法领会更高深的越爪功。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action); i > 0; i--)
		if (level >= action[i-1]["lvl"])
			return action[i-1]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("yuezhao-gong",1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];

}

int practice_skill(object me)
{
	if (me->query_temp("weapon") ||
	    me->query_temp("secondary_weapon"))
		return notify_fail("越爪功必须空手练习！\n");

	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 80)
		return notify_fail("你的内力不够练越爪功。\n");

	me->receive_damage("qi", 60);
	me->add("neili", -69);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"yuezhao-gong/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【越爪功】" ZJBR NOR;
    msg += WHT "越爪功是一门以快速、凶猛著称的高级爪法，出手迅捷凌厉，如鹰隼扑食，" ZJBR;
    msg += "攻势凶猛，令敌难以招架。招式包括越爪手、追云手、蟠龙手等一系列精妙变化。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本爪法等级：30级" ZJBR;
    msg += "  基本内功等级：50级" ZJBR;
    msg += "  内力修为：400点" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  爪法(claw)" ZJBR;
    msg += "  招架(parry)" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血消耗：60点" ZJBR;
    msg += "  内力消耗：69点" ZJBR ZJBR;

    msg += HIY "〖招式精要〗" ZJBR NOR;
    msg += "1. 越爪手：双手如钩如戢，插向敌手" ZJBR;
    msg += "2. 追云手：跃身费神扑上，直抓要害" ZJBR;
    msg += "3. 蟠龙手：十指抖动，以爪带风袭敌" ZJBR;
    msg += "4. 追风逐电：悄无声息游走，奋力出击" ZJBR;
    msg += "5. 单刀赴会：一手护面，一手突袭敌手" ZJBR;
    msg += "6. 双龙开破：双爪前后夹击，破敌防御" ZJBR;
    msg += "7. 三顾茅庐：上取敌目，下勾敌裆，全面进攻" ZJBR;
    msg += "8. 卧薪尝胆：爪风如骤雨，连续出击令敌难防" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  弑元诀(shi)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      越爪功 130级" ZJBR;
    msg += "      基本内功 200级" ZJBR;
    msg += "      当前内力 300点" ZJBR;
    msg += "      需要空手状态" ZJBR;
    msg += "    功效描述：" ZJBR;
    msg += "      直取敌人破绽，造成严重伤害并破坏其气门" ZJBR;
    msg += "      命中判定：随机(爪法有效激发) + 爪法有效激发 / 2 > 目标轻功有效激发" ZJBR;
    msg += "      伤害计算：伤害 = 越爪功等级 + 随机(越爪功等级)" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力消耗：150点" ZJBR;
    msg += "      自身忙乱：2秒" ZJBR ZJBR;

    msg += HIR "〖注意事项〗" ZJBR NOR;
    msg += "1. 越爪功需要快速的反应和精准的控制，修炼时需注重提高这两项属性。" ZJBR;
    msg += "2. 在实战中，应善于利用爪法的迅捷特性，快速突袭敌手要害。" ZJBR;
    msg += "3. 弑元诀威力虽大，但也易暴露破绽，使用需谨慎。" ZJBR;
    msg += "4. 配合轻功使用，可发挥出更强威力。" ZJBR;
    msg += "5. 练习时必须空手，不能持有武器。\n";

    return msg;
}