// 明教 guangming-jing
inherit SKILL;
string type() { return "knowledge"; }

int is_fmsk() { return 1; }
string family_name() { return "明教"; }

int valid_learn(object me)
{
        if (me->query_skill("jiuyang-shengong", 1) < 120)
                return notify_fail("你紫阳神功火候不足，无法研习大云光明经。\n");

        if( me->query("family/family_name") != family_name() )
                return notify_fail("大云光明经只能明教弟子方可研习。\n");

        if (me->query_skill("qiankun-danuoyi", 1) < 150)
                return notify_fail("你乾坤大挪移修为不足，无法继续研习大云光明经。\n");

        return 1;
}

int difficult_level()
{
        return 2000;
}
string query_description()
{
    string msg;

    msg = HIY "【大云光明经】" ZJBR NOR;
    msg += WHT "大云光明经乃明教护教经典，记载着深奥的武学至理与内功心法。" ZJBR;
    msg += WHT "研习此经可加深对明教武学的理解，并可能与其他明教功法产生玄妙的联系。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  须为明教 (" HIY "family_name() == \"明教\"" NOR ") 弟子。" ZJBR;
    msg += "  紫阳神功 (" HIY "jiuyang-shengong" NOR ") 基本等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "  乾坤大挪移 (" HIY "qiankun-danuoyi" NOR ") 基本等级不低于 " HIY "150" NOR " 级。" ZJBR ZJBR;

    msg += HIY "〖技能类型〗" ZJBR NOR;
    msg += "  知识类技能 (knowledge)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  通常无法通过练习 (practice) 提升，依赖于研读 (study) 或其他方式领悟。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  作为知识类技能，主要提升对相关武学体系的理解，具体效果可能体现在其他技能的学习或威力上。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  暂无直接的特殊招式。" ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 大云光明经需要深厚的内功修为和对佛法的领悟。" ZJBR;
    msg += "2. 此功法能够全面提升实力,但也容易引起他人觊觎。" ZJBR;
    msg += "3. 光明普照虽然效果强大,但也会消耗大量内力,使用需谨慎。" ZJBR;
    msg += "4. 修炼此功法需要保持心境平和,不可有邪念。\n";

    return msg;
}
