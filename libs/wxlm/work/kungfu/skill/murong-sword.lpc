int valid_enable(string usage)
{
	return (usage == "sword") || (usage == "parry");
}

int valid_learn(object me)
{
    if ((int)me->query("max_neili") < 150)
	return notify_fail("你的内力不够。\n");

    return 1;
}

mapping query_action(object me, object weapon)
{
    int i, level;
    level   = (int) me->query_skill("murong-sword",1);
    for(i = sizeof(action); i > 0; i--)
	if(level > action[i-1]["lvl"])
	    return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    object weapon;

    if (!objectp(weapon = me->query_temp("weapon"))
       || (string)weapon->query("skill_type") != "sword")
	return notify_fail("你使用的武器不对。\n");

    if ((int)me->query("qi") < 50)
	return notify_fail("你的体力不够练慕容剑法。\n");

    if ((int)me->query("neili") < 50)
	return notify_fail("你的内力不够练慕容剑法。\n");

    me->receive_damage("qi", 38);
    me->add("neili", -33);
    return 1;
}

string perform_action_file(string action)
{
    return __DIR__"murong-sword/" + action;
}
string query_description()
{
    string msg;

    msg = HIY "【慕容剑法】" ZJBR NOR;
    msg += "慕容世家的独门剑法，招式精妙，变化万千，以彼之道还施彼身闻名。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力不低于 " HIB "150" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  剑法 (`sword`)。" ZJBR;
    msg += "  招架 (`parry`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  需装备剑类武器。" ZJBR;
    msg += "  气血不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  内力不低于 " HIB "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "38" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "33" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;

    msg += HIC "  剑气虹光 (hong)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      慕容剑法激发等级 " HIY "140" NOR " 级。" ZJBR;
    msg += "      招架激发等级 (`parry`) " HIY "140" NOR " 级。" ZJBR;
    msg += "      神元功 (`shenyuan-gong`) 等级 " HIY "140" NOR " 级。" ZJBR;
    msg += "      最大内力 " HIB "1200" NOR " 点。" ZJBR;
    msg += "      当前内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      当前精力 " HIG "200" NOR " 点。" ZJBR;
    msg += "      激发剑法为慕容剑法。" ZJBR;
    msg += "      装备剑类武器。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      发动时临时提升自身攻击力 (慕容剑法激发等级 / 3) 点。" ZJBR;
    msg += "      发动时临时提升自身伤害 (慕容剑法激发等级 / 3) 点。" ZJBR;
    msg += "      以提升后的状态对目标发动一次攻击 (使用 `COMBAT_D->do_attack` 进行判定)。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "250" NOR " 点。" ZJBR;
    msg += "      消耗精力 " HIG "100" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "2-3" NOR " 秒 (随机)。" ZJBR ZJBR;

    msg += HIC "  七星连环 (qixing)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      慕容剑法激发等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      招架激发等级 (`parry`) " HIY "150" NOR " 级。" ZJBR;
    msg += "      神元功 (`shenyuan-gong`) 等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      最大内力 " HIB "2000" NOR " 点。" ZJBR;
    msg += "      当前内力 " HIB "500" NOR " 点。" ZJBR;
    msg += "      当前精力 " HIG "300" NOR " 点。" ZJBR;
    msg += "      激发剑法为慕容剑法。" ZJBR;
    msg += "      装备剑类武器。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      连续对目标发动七次攻击 (使用 `COMBAT_D->do_attack` 进行判定)。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "400" NOR " 点。" ZJBR;
    msg += "      消耗精力 " HIG "150" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "3-5" NOR " 秒 (随机)。" ZJBR;

    return msg;
}
