int valid_enable(string usage) { return  (usage =="parry")|| (usage =="blade"); }

int valid_learn(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "blade")
		return notify_fail("你必须先找一把刀才能练冷焰刀法。\n");

	if ((int)me->query("max_neili") < 1000)
		return notify_fail("你的内力不足，没有办法练冷焰刀法，多练些内力再来吧。\n");

	if ((int)me->query_skill("force") < 150)
		return notify_fail("你的内功火候太浅，没有办法练冷焰刀法。\n");

	if ((int)me->query_skill("blade", 1) < 100)
		return notify_fail("你的基本刀法火候太浅，没有办法练冷焰刀法。\n");

	if ((int)me->query_skill("blade", 1) < (int)me->query_skill("ranmu-daofa", 1))
		return notify_fail("你的基本刀法水平还不够，无法领会更高深的冷焰刀法。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action) - 1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("ranmu-daofa", 1);

	if (random(me->query_skill("ranmu-daofa", 1)) > 120 &&
	     me->query_skill("force") > 100 &&
	     me->query("neili") > 1000 &&
	     random(10) > 6)
	{
		me->add("neili", -100);
		return ([
		"action": HIR "$N" HIR "忽然高宣一声佛号，身体急速"
			  "旋转，遍体通红，袈裟鼓起。刹那间手中" + 
			  me->query_temp("weapon")->query("name")
			  + HIR "一道火光闪过，迸\n出一股灼热的气流，"
			  "袭向$n" HIR "！" NOR,
		"dodge" : 11,
		"attack": 34,
		"force" : 302,
		"damage": 289,
		"parry" : 7,
		"damage_type": "割伤"]);
	}

	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "blade")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 80)
		return notify_fail("你的体力不够练冷焰刀法。\n");

	if ((int)me->query("neili") < 90)
		return notify_fail("你的内力不够练冷焰刀法。\n");

	me->receive_damage("qi", 75);
	me->add("neili", -85);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"ranmu-daofa/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【冷焰刀法】(又名燃木刀法)" ZJBR NOR;
    msg += WHT "少林七十二绝技之一，刀法凌厉，出招时带有灼热之气，故名冷焰。此刀法招式看似平平无奇,实则暗藏杀机,刀锋所指之处,犹如冷焰燃烧,令人不寒而栗。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  需持有刀类武器。" ZJBR;
    msg += "  最大内力不低于 " HIB "1000" NOR " 点。" ZJBR;
    msg += "  基本内功等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "  基本刀法等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "  基本刀法等级需大于等于冷焰刀法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  刀法（blade）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  需持有刀类武器。" ZJBR;
    msg += "  气血：不低于 " HIR "80" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "90" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "75" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "85" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += HIM "  佛光普照 (随机触发)" ZJBR NOR;
    msg += "    触发条件：" ZJBR;
    msg += "      冷焰刀法等级 > 120 级 (随机判定)。" ZJBR;
    msg += "      基本内功等级 > 100 级。" ZJBR;
    msg += "      当前内力 > 1000 点。" ZJBR;
    msg += "      随机判定 (random(10) > 6)。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      发动一次强力攻击，附带灼热效果，造成大量伤害。" ZJBR;
    msg += "      伤害加成 " HIY "289" NOR " 点，攻击加成 " HIY "34" NOR " 点。" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  火麟蚀月 (huo)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      需持有刀类武器。" ZJBR;
    msg += "      激发刀法为冷焰刀法。" ZJBR;
    msg += "      冷焰刀法等级 " HIY "180" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "250" NOR " 级。" ZJBR;
    msg += "      最大内力 " HIB "3000" NOR " 点。" ZJBR;
    msg += "      当前内力 " HIB "600" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：(自身冷焰刀法等级 + 自身基本内功等级) > (目标基本招架等级 + 目标基本内功等级)，采用 `通用命中公式`。" ZJBR;
    msg += "      若命中：造成伤害。伤害值约为 ((冷焰刀法等级 + 基本内功等级) / 3) + 随机((冷焰刀法等级 + 基本内功等级) / 3)。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力 " HIB "400" NOR " 点，忙乱 2 + 随机(2) 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "200" NOR " 点，忙乱 2 + 随机(2) 秒。" ZJBR;

    return msg;
}