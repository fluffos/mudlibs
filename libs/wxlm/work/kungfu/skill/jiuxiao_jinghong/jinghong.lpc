
#include <combat.h>

#define JINGHONG "「" HIW "惊鸿一剑" NOR "」"

inherit F_SSERVER;

string query_name() { return "惊鸿"ZJBR"一剑"; }

int perform(object me, object target)
{
    object weapon;
    int damage;
    string msg;
    int ap, dp;

    if (! target) target = offensive_target(me);

    if (! target || ! me->is_fighting(target))
        return notify_fail(JINGHONG "只能对战斗中的对手使用。\n");

    if (! objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对，难以施展" JINGHONG "。\n");

    if ((int)me->query_skill("jiuxiao_jinghong", 1) < 100)
        return notify_fail("你的九霄惊鸿剑法不够娴熟，难以施展" JINGHONG "。\n");

    if (me->query_skill_mapped("sword") != "jiuxiao_jinghong")
        return notify_fail("你没有激发九霄惊鸿剑法，难以施展" JINGHONG "。\n");

    if ((int)me->query("neili") < 200)
        return notify_fail("你现在的真气不够，难以施展" JINGHONG "。\n");

    if (! living(target))
        return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

    msg = HIW "$N" HIW "轻吟剑诀，施展出「惊鸿一剑」，手中" + weapon->name() + HIW "化作一道白光，如白鹤展翅般自上而下劈向$n" HIW "！\n" NOR;

    ap = me->query_skill("sword") + me->query_skill("dodge");
    dp = target->query_skill("dodge") + target->query_skill("parry");

    if (COMBAT_D->hit_determination(me,target,ap,dp))
    {
        damage = ap + random(ap / 2);
        me->add("neili", -150);
        msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 55,
                                   HIR "$n" HIR "只觉眼前白光一闪，$N" HIR "的剑招来得极快，"
                                   "躲闪不及，被这一剑结结实实劈中，顿时鲜血狂涌！\n" NOR);
        me->start_busy(2);
        if (ap / 3 + random(ap) > dp && ! target->is_busy())
            target->start_busy(ap / 200 + 2);
    } else
    {
        me->add("neili", -50);
        msg += CYN "可是$n" CYN "看破了$N" CYN "的剑路，纵身一跃，堪堪避过。\n" NOR;
        me->start_busy(3);
    }
    message_combatd(msg, me, target);
    return 1;
}
