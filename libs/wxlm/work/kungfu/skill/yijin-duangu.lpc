inherit FORCE;

int valid_enable(string usage)
{
	return usage == "force";
}

int query_neili_improve(object me)
{
	int lvl;

	lvl = (int)me->query_skill("yijin-duangu", 1);
	return lvl * lvl * 15 * 18 / 100 / 200;
}

int valid_force(string force)
{
	return 1;
}

int valid_learn(object me)
{
	if (me->query("gender") == "无性" && (int)me->query_skill("yijin-duangu", 1) > 49)
		return notify_fail("你无根无性，阴阳不调，难以领会高深的易筋锻骨内功。\n");

	if (me->query("character") == "狡黠多变" && (int)me->query("yijin-duangu", 1) > 199)
		return notify_fail("这玄阴真经中所记载的易筋锻骨正大恢弘，气度俨然，依照"
				   "你狡黠多变的天性似乎只能学到这种程度。\n");

	if (me->query("character") == "心狠手辣" && (int)me->query("yijin-duangu", 1) > 169)
		return notify_fail("这玄阴真经中所记载的易筋锻骨正大恢弘，气度俨然，依照"
				   "你心狠手辣的天性似乎只能学到这种程度。\n");

	if (me->query("character") == "阴险奸诈" && (int)me->query("yijin-duangu", 1) > 139)
		return notify_fail("这玄阴真经中所记载的易筋锻骨正大恢弘，气度俨然，依照"
				   "你阴险奸诈的天性似乎只能学到这种程度。\n");
	if (me->query("int") < 26)
		return notify_fail("你觉得易筋锻骨深奥无比，一时难以领会。\n");

	if ((int)me->query_skill("force", 1) < 100)
		return notify_fail("你的基本内功火候还不够，还不能学习易筋锻骨内功。\n");

	return ::valid_learn(me);
}

int practice_skill(object me)
{
	return notify_fail("易筋锻骨内功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"yijin-duangu/" + func;
}


string query_description()
{
    string msg;

    msg = HIY "【易筋锻骨内功】" ZJBR NOR;
    msg += WHT "易筋锻骨内功是一门高深莫测的内功心法，源自少林寺的易筋经。" ZJBR;
    msg += WHT "此内功讲究以柔克刚，化劲为力，能大幅提升修炼者的内力和战斗力。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功等级：" HIY "100" NOR " 级" ZJBR;
    msg += "  悟性要求：" HIY "26" NOR " 点" ZJBR;
    msg += "  性别限制：无性人士在50级后无法继续学习" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功 (force)" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  易筋锻骨内功只能通过学习(learn)来提升熟练度，无法自行练习(practice)" ZJBR ZJBR;

    msg += HIY "〖能力提升〗" ZJBR NOR;
    msg += "  内力上限增加：每级提升 " HIY + "易筋锻骨等级 * 易筋锻骨等级 * 15 * 18 / 100 / 200" NOR " 点" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  易筋锻骨 (powerup)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      当前内力不低于 " HIY "100" NOR " 点" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      运转九阴真气，全身笼罩白雾，提升自身战斗力" ZJBR;
    msg += "      攻击提升：内功等级 / 3" ZJBR;
    msg += "      持续时间：内功等级秒" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIY "100" NOR " 点" ZJBR;
    msg += "      战斗中使用会导致自身" HIR "忙乱3秒" NOR ZJBR ZJBR;

    msg += HIY "〖学习限制〗" ZJBR NOR;
    msg += "  性格限制：" ZJBR;
    msg += "    狡黠多变：学习上限为 " HIY "199" NOR " 级" ZJBR;
    msg += "    心狠手辣：学习上限为 " HIY "169" NOR " 级" ZJBR;
    msg += "    阴险奸诈：学习上限为 " HIY "139" NOR " 级" ZJBR;
    msg += "  性别限制：无性人士在50级后无法继续学习" ZJBR ZJBR;

    msg += HIR "〖注意事项〗" ZJBR NOR;
    msg += "  此内功正大恢弘，要求修炼者具备高尚的品格和坚定的意志" ZJBR;
    msg += "  不同性格会限制技能学习上限" ZJBR;

    return msg;
}