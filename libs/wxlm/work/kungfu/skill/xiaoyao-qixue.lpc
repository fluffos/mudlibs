// xiaoyao-qixue.c

inherit SKILL;

string type() { return "knowledge"; }

int valid_enable(string usage) { return usage == "medical"; }

int valid_learn(object me)
{
	if (me->query("family/family_name") != "逍遥派")
		return notify_fail("逍遥派的弟子才能学习该技能。\n");
	
	if ((int)me->query_skill("medical", 1) < 100)
		return notify_fail("你的基本医术造诣太浅，无"
				   "法领会深奥的逍遥奇学。\n");

	if ((int)me->query_skill("medical", 1) < (int)me->query_skill("xiaoyao-qixue", 1))
		return notify_fail("你的基本医术水平有限，无"
				   "法掌握更深奥的逍遥奇学。\n");

	return 1;
}


string query_description()
{
    string msg;

    msg = HIY "【逍遥奇学】" ZJBR ZJBR NOR;
    msg += WHT "逍遥奇学是逍遥派独门的医术绝学，融合了道家养生之法与医家治病之术。" ZJBR;
    msg += "此学问博大精深，包含了诊脉、针灸、药理等多方面的知识。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  逍遥派弟子。" ZJBR;
    msg += "  基本医术等级：不低于逍遥奇学等级。" ZJBR;
    msg += "  基本医术等级：不低于 " HIY "100" NOR " 级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  医术（medical）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  无法直接练习（只能通过学习提升熟练度）。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    return msg;
}