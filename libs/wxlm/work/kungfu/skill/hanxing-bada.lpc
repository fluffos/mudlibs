//hanxing-bada.c 寒星八打

inherit SKILL;

int valid_learn(object me)
{
 

	if ((int)me->query("max_neili") < 200)
		return notify_fail("你的内力不够，没有办法练寒星八打。\n");

	if ((int)me->query_skill("throwing", 1) < 180)
		return notify_fail("你的基本暗器水平有限，无法领悟寒星八打术。\n");

	if ((int)me->query_skill("throwing", 1) < (int)me->query_skill("hanxing-bada", 1))
		return notify_fail("你的基本暗器水平有限，无法领悟更高深的寒星八打术。\n");

	return 1;
}

int valid_enable(string usage)
{
	return usage == "throwing";
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力不足，无法练习寒星八打。\n");

	if ((int)me->query("neili") < 50)
		return notify_fail("你的内力不够，没有办法练习寒星八打。\n");

	me->receive_damage("qi", 40);
	me->add("neili", -45);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"hanxing-bada/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【寒星八打】" ZJBR NOR;
    msg += WHT "寒星八打是一门以快打慢、以奇制胜的暗器手法。" ZJBR;
    msg += "此手法讲究出其不意，招式诡异多变，如夜空寒星般令人难以捉摸。" ZJBR;
    msg += "使用者能够以迅捷的手法投掷暗器，令敌人防不胜防。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "  基本暗器等级 " HIY "180" NOR " 级。" ZJBR;
    msg += "  基本暗器等级须大于等于寒星八打等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  暗器（throwing）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "40" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "45" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无特殊攻防特效或被动效果。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  孤注一掷 (lastrisk)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      战斗中对敌人使用。" ZJBR;
    msg += "      手持暗器（至少1枚）。" ZJBR;
    msg += "      寒星八打等级 " HIY "60" NOR " 级。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      将手中所有暗器一次性掷出攻击目标。" ZJBR;
    msg += "      命中判定：使用 COMBAT_D->hit_determination，比较双方基本暗器和基本轻功。" ZJBR;
    msg += "      命中后：对目标造成气血伤害，伤害值约为 (寒星八打等级 / 2 + 随机(寒星八打等级 / 2))。" ZJBR;
    msg += "             追加随机次数（1 到 5 次，最多不超过暗器数量）的暗器攻击，每次攻击附加 (加力 + 120) 的伤害。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      无论是否命中，消耗所有持有的暗器。" ZJBR;
    msg += "      自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    return msg;
}