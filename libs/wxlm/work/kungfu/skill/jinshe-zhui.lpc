// jinshe-zhui.c

inherit SKILL;

int valid_learn(object me)
{
 

	if ((int)me->query("max_neili") < 500)
		return notify_fail("你的内力不够，没有办法练腾蛇锥法。\n");

	if ((int)me->query_skill("force") < 80)
		return notify_fail("你的内功火候不够，没有办法练腾蛇锥法。\n");

	if ((int)me->query_skill("throwing", 1) < (int)me->query_skill("jinshe-zhui", 1))
		return notify_fail("你的基本暗器水平有限，无法领会更高深的腾蛇锥法。\n");

	return 1;
}

int valid_enable(string usage)
{
	return usage == "throwing";
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 40)
		return notify_fail("你的气不够，没有办法练习腾蛇锥法。\n");

	if ((int)me->query("neili") < 50)
		return notify_fail("你的内力不够，没有办法练习腾蛇锥法。\n");

	me->receive_damage("qi", 35);
	me->add("neili", -48);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"jinshe-zhui/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【腾蛇锥法】" ZJBR ZJBR NOR;
    msg += WHT "夏雪宜以金蛇剑配合使用的暗器手法，发射特制的腾蛇锥。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功 (force) 等级 " HIY "80" NOR " 级。" ZJBR;
    msg += "  最大内力 " HIB "500" NOR " 点。" ZJBR;
    msg += "  基本暗器 (throwing) 等级不低于腾蛇锥法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  暗器 (throwing)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "40" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "35" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "48" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  金蛇吐雾 (tuwu)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      腾蛇锥法等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      手持 " HIG "腾蛇锥 (jinshe zhui)" NOR " 且数量大于 0。" ZJBR;
    msg += "      不在金蛇吐雾状态冷却中（由 `jinshe/tuwu` 临时状态标记）。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      消耗一枚腾蛇锥。" ZJBR;
    msg += "      命中判定：(腾蛇锥法等级 / 2 + 随机(腾蛇锥法等级)) > 目标的轻功激发等级。" ZJBR;
    msg += "      命中效果：" ZJBR;
    msg += "        造成气血伤害：(腾蛇锥法等级 / 3)。" ZJBR;
    msg += "        造成气血创伤：(腾蛇锥法等级 / 3)。" ZJBR;
    msg += "        使目标失明（无法视物）：持续 (腾蛇锥法等级 / 30) 秒。" ZJBR;
    msg += "        自身进入金蛇吐雾冷却状态，持续 (腾蛇锥法等级 / 30) 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      未命中：无额外内力消耗。" ZJBR;
    msg += "      无论命中与否，均消耗一枚腾蛇锥。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 金蛇吐雾只能在战斗中对敌人使用。" ZJBR;
    msg += "2. 需要持有特殊暗器腾蛇锥。" ZJBR;
    msg += "3. 使用后会进入冷却状态，无法立刻再次使用。\n";

    return msg;
}