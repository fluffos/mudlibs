string *usage_skills = ({ "dodge", "parry", "unarmed", "force" });

int valid_enable(string usage)
{
	return (member_array(usage, usage_skills) != -1);
}

int valid_force(string force) { return 1; }

int valid_combo(string combo)
{
	return combo == "bluesea-force" ||
	       combo == "tanzhi-shentong";
}

int double_attack() { return 1; }

mapping query_action(object me, object weapon)
{
	return weapon ? actionw[random(sizeof(actionw))] :
			actionf[random(sizeof(actionw))];
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int valid_learn(object me)
{
	int level;
	int i;

	if ((int)me->query("combat_exp") < 3000000 && !me->query("relife/zhuanshi"))
		return notify_fail("你觉得南海玄功深奥之极，"
				   "凭自己的战斗经验一时间难以领会。\n");

	if ((int)me->query_skill("martial-cognize", 1) < 50)
		return notify_fail("你觉得南海玄功过于深奥之极，以"
				   "自己的武学修养全然无法明白。\n");

	if (me->query("character") != "心狠手辣")
		return notify_fail("你发觉南海神功招招狠、式式险，舍"
				   "生忘死，自己实在领会不了。\n");

	if (me->query("con") < 22 && me->query_con() < 63)
		return notify_fail("你试图运用真力修炼南海玄功，却突"
				   "然觉得眼前一黑，看来是根骨不好，"
				   "不能勉强修行。\n");

	if (me->query("gender") == "无性" &&
	    (int)me->query_skill("bluesea-force", 1) > 219)
		return notify_fail("你无根无性，阴阳不调，难以领会高深的南海玄功。\n");

	level = me->query_skill("bluesea-force", 1);

	if ((int)me->query_skill("martial-cognize", 1) < 300 &&
	    (int)me->query_skill("martial-cognize", 1) < level)
		return notify_fail("你觉得自己的武学修养有限，难以领会更高深的南海玄功。\n");

	for (i = 0; i < sizeof(usage_skills); i++)
		if (me->query_skill(usage_skills[i], 1) < level)
			return notify_fail("你对" + to_chinese(usage_skills[i]) +
					   "的理解还不够，无法继续领会更高深的南海玄功。\n");

	return 1;
}

int practice_skill(object me)
{
	return notify_fail("南海玄功博大精深，无法简单的通过练习进步。\n");
}

int difficult_level()
{
	return 500;
}

string perform_action_file(string action)
{
	return __DIR__"bluesea-force/perform/" + action;
}

string exert_function_file(string action)
{
	return __DIR__"bluesea-force/exert/" + action;
}

string query_description()
{
    string msg;

    msg = "";
    msg += HIY "【南海玄功】" ZJBR ZJBR NOR;
    msg += WHT "南海玄功是一门综合性的上乘武学，集内功、拳脚、轻功、招架于一体。" ZJBR;
    msg += "此功法源自南海，招式大开大合，威力惊人，同时步法变幻莫测，守御亦是极强。" ZJBR ZJBR;

    msg += HIY "【学习要求】" ZJBR NOR;
    msg += "  战斗经验：3,000,000 点（转世后无此限制）" ZJBR;
    msg += "  武学修养：50 级（300级以上无等级限制）" ZJBR;
    msg += "  人物性格：心狠手辣" ZJBR;
    msg += "  先天根骨：22 点 或 后天根骨 63 点" ZJBR;
    msg += "  性别限制：无性者最多学到 220 级" ZJBR;
    msg += "  基础要求：所有激发的基本技能等级不能低于南海玄功等级" ZJBR ZJBR;

    msg += HIY "【练习要求】" ZJBR NOR;
    msg += "  无法通过练习（practice）提高" ZJBR ZJBR;

    msg += HIY "【学习难度】" ZJBR NOR;
    msg += "  难度系数：500 (极高)" ZJBR ZJBR;

    msg += HIY "【技能效果】" ZJBR NOR;
    msg += "  可激发为：内功（force）、招架（parry）、拳脚（unarmed）、轻功（dodge）" ZJBR;
    msg += "  提升最大内力：根据技能等级提升，等级越高，提升幅度越大" ZJBR;
    msg += "  特殊攻击：可实现连击（double_attack）" ZJBR;
    msg += "  互备：可与 南海玄功 或 弹指神通（tanzhi-shentong）互备（指法/拳脚）" ZJBR;
    msg += "        作为内功时，可与任意内功互备（valid_force 返回 1）" ZJBR ZJBR;

    msg += HIY "【特殊招式】" ZJBR NOR;
    msg += HIW "1. 南玄护体（shield）：" ZJBR NOR;
    msg += "  要求：南海玄功 50 级，当前内力 100 点" ZJBR;
    msg += "  消耗：内力 100 点" ZJBR;
    msg += "  效果：提升自身防御力" ZJBR;
    msg += "  数值：防御力提升 (南海玄功等级 / 2)" ZJBR;
    msg += "  持续时间：(南海玄功等级 / 10) 秒" ZJBR;
    msg += "  描述：运起南海玄功，全身笼罩在罡气之中" ZJBR ZJBR;
    msg += HIW "2. 碧海清波（bo）：" ZJBR NOR;
    msg += "  要求：南海玄功 100 级" ZJBR;
    msg += "  效果：几率使对手忙乱（busy）" ZJBR;
    msg += "  描述：掌力忽左忽右，形成一个个气旋，如波浪一般接连向对手逼去" ZJBR ZJBR;
    msg += HIW "3. 玄黄连环（xuan）：" ZJBR NOR;
    msg += "  要求：南海玄功 150 级，当前内力 200 点" ZJBR;
    msg += "  消耗：内力 100-200 点" ZJBR;
    msg += "  效果：连续攻击对手" ZJBR;
    msg += "  描述：身形忽然变快，合数招为一击攻向对手" ZJBR ZJBR;
    msg += HIW "4. 无影神杖（nan）：" ZJBR NOR;
    msg += "  要求：南海玄功 150 级，当前内力 200 点，需要装备杖类武器" ZJBR;
    msg += "  消耗：内力 100-200 点" ZJBR;
    msg += "  效果：使用杖法连续攻击对手" ZJBR;
    msg += "  描述：将杖舞成一团光芒，进退间身形忽然变快，霎时合数招为一击" ZJBR ZJBR;
    msg += HIW "5. 诛仙诀（zhu）：" ZJBR NOR;
    msg += "  要求：南海玄功 120 级，当前内力 200 点" ZJBR;
    msg += "  消耗：内力 125-150 点" ZJBR;
    msg += "  效果：对敌人造成大量伤害" ZJBR;
    msg += "  描述：随手拍出一掌，疾若奔马，如箭一般飞向对手" ZJBR ZJBR;
    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 南海玄功要求苛刻，学习难度极高，且无法练习。" ZJBR;
    msg += "2. 此功法全面，攻防兼备，并具备连击能力。" ZJBR;
    msg += "3. 各种特殊招式威力强大，但消耗亦不低，需谨慎使用。\n";

    return msg;
}