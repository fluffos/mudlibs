int valid_enable(string usage) { return usage == "blade" || usage == "parry"; } 

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 100)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("force") < 30)
		return notify_fail("你的内功火候不够。\n");

	if ((int)me->query_skill("blade", 1) < (int)me->query_skill("dongyang-dao", 1))
		return notify_fail("你的基本刀法水平有限，无法领会更高深的东洋刀法。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action)-1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("dongyang-dao",1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "blade")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 75)
		return notify_fail("你的体力不够练东洋刀法。\n");

	if ((int)me->query("neili") < 55)
		return notify_fail("你的内力不够练东洋刀法。\n");

	me->receive_damage("qi", 60);
	me->add("neili", -42);

	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"dongyang-dao/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【东洋刀法】" ZJBR NOR;
    msg += "源自东瀛的刀法，特点是迅猛凌厉，招式大开大合。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力 (max_neili) 不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "  基本内功 (force) 等级不低于 " HIY "30" NOR " 级。" ZJBR;
    msg += "  基本刀法 (blade) 等级需不低于东洋刀法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  刀法（blade）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  需装备刀类武器。" ZJBR;
    msg += "  气血：不低于 " HIR "75" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "55" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "42" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无特定被动效果。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;

    msg += HIC "  迎风一刀斩 (zhan)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      东洋刀法等级 " HIY "70" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "      战斗中使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定基于 自身基础刀法 与 目标基础内功。" ZJBR;
    msg += "      命中后造成伤害，基础伤害值约为 (自身基础刀法等级 / 2) 至 (自身基础刀法等级 * 1.5) 之间，有 55% 的伤害加成。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力 " HIB "100" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "50" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  乱刀诀 (luan)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      东洋刀法等级 " HIY "80" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "      战斗中使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      连续发动相当于普通攻击次数的攻击。" ZJBR;
    msg += "      每次攻击有 50% 的几率使未忙乱的目标陷入 " HIR "1" NOR " 秒忙乱状态。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "100" NOR " 点，自身忙乱 " HIR "1-5" NOR " 秒 (随机)。" ZJBR;

    return msg;
}