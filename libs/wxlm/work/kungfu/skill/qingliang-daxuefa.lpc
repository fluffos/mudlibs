int valid_enable(string usage)
{
	return usage == "dagger" || usage == "parry";
}

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 500)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("force") < 100)
		return notify_fail("你的内功火候太浅。\n");

	if ((int)me->query_skill("dagger", 1) < 10)
		return notify_fail("你的基本短兵火候太浅。\n");

	if ((int)me->query_skill("dagger", 1) < (int)me->query_skill("qingliang-daxuefa", 1))
		return notify_fail("你的基本短兵水平有限，无法领会更高深的清凉打穴法。\n");

    return 1;
}

string query_skill_name(int level)
{
	int i;

	for(i = sizeof(action) - 1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;

	level = (int) me->query_skill("qingliang-daxuefa", 1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "dagger")
		return notify_fail("你所持的武器无法练习清凉打穴法。\n");

	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力不够练清凉打穴法。\n");

	if ((int)me->query("neili") < 70)
		return notify_fail("你的内力不够练清凉打穴法。\n");

	me->receive_damage("qi", 65);
	me->add("neili", -62);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"qingliang-daxuefa/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【清凉打穴法】" ZJBR ZJBR NOR;
    msg += WHT "一门精妙的短兵器法门，以其快速准确的点穴技巧著称。此功法讲究以巧破力，攻敌要害。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力 (" HIW "max_neili" NOR ") 不低于 " HIB "500" NOR " 点。" ZJBR;
    msg += "  基本内功 (" HIW "force" NOR ") 等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "  基本短兵 (" HIW "dagger" NOR ") 等级不低于 " HIY "10" NOR " 级。" ZJBR;
    msg += "  基本短兵等级需大于等于清凉打穴法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  短兵 (dagger)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须装备 短兵 (dagger) 类武器。" ZJBR;
    msg += "  气血 (" HIW "qi" NOR ")：不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力 (" HIW "neili" NOR ")：不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "65" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "62" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  透骨钉 (ding)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      清凉打穴法等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "500" NOR " 点。" ZJBR;
    msg += "      激发短兵为清凉打穴法。" ZJBR;
    msg += "      装备短兵器。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定基于双方 (短兵激发等级) vs (招架激发等级)。" ZJBR;
    msg += "      命中后造成伤害，伤害值约为 (100 + 短兵激发等级 / 3 + 随机(短兵激发等级 / 3))。" ZJBR;
    msg += "      命中后附加 " HIY "50" NOR " 点破防效果。" ZJBR;
    msg += "      命中后若 (短兵激发等级 / 3 + 随机(短兵激发等级)) > 目标招架激发等级 且目标未忙乱，则使目标" HIR "忙乱" NOR " (持续 短兵激发等级 / 25 + 1 秒)。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 " HIB "200" NOR " 点，自身忙乱 " HIR "1" NOR " 秒。" ZJBR;
    msg += "      未命中：消耗内力 " HIB "50" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;

    return msg;
}