// qing.c 抚箫叹情



inherit F_SSERVER;

string query_name() { return "抚箫叹情"; }
string *pfm_type() { return ({ "sword", }); }

int perform(object me)
{
	string msg;
	object weapon, target;
	int skill, ap, dp;
	int cost;

	if (! me->query("can_perform/yuxiao-jian/qing"))
		return notify_fail("你还不会使用「抚箫叹情」这一绝技。\n");

	if (! target)
	{
		me->clean_up_enemy();
		target = me->select_opponent();
	}

	if (! target || ! me->is_fighting(target))
		return notify_fail("「抚箫叹情」只能对战斗中的对手使用。\n");

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");

	if (me->query_skill_mapped("sword") != "yuxiao-jian")
		return notify_fail("你没有激发玉萧剑法，不能"
				   "使用「抚箫叹情」这一绝技。\n");

	if (target->query("neili") < 300)
		return notify_fail("看上去对方真气现在并不充沛，你"
				   "无需运用「抚箫叹情」。\n");

	skill = me->query_skill("yuxiao-jian",1);

	if (skill < 120)
		return notify_fail("你的云箫剑法等级不够, 不能"
				   "使用「抚箫叹情」！\n");

	if (me->query("neili") < 1000)
		return notify_fail("你的真气不够，难以运用「抚箫叹情」！\n");

       if (! living(target))
	      return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

	msg = HIC "$N" HIC "轻抚" + weapon->name() + HIC "，剑身微颤，" NOR
	      HIW "§" HIC "抚箫叹情" HIW "§" NOR HIC "悠然而起......" NOR "\n";
	msg += HIW "\n剑如箫音，低回婉转，似有无尽哀思从剑尖流淌而出。"
	       "如泣如诉，如怨如慕，那缠绵悱恻的剑意如丝如缕，" NOR "\n";
	msg += HIW "萦绕不散，令人不由自主地沉浸在这深深的离愁别绪之中。" NOR "\n";
	message_combatd(msg, me, target);

	ap = me->query_skill("force") + me->query_skill("sword");
	dp = target->query_skill("force") + target->query_skill("dodge");

	if (ap / 2 + random(ap) > dp)
	{
		me->add("neili", -500);

		msg = HIM "$p" HIM "只觉心中涌起阵阵离愁别绪，仿佛听到远方"
		      "传来的箫声呜咽，那哀怨缠绵的剑意如潮水般涌来，" NOR "\n";
		msg += HIM "$p" HIM "不由自主地调动内力抵御这股深入骨髓的哀伤之意！" NOR "\n";

		cost = 500 + ap * 3 / 2;
		cost += COMBAT_D->get_skill_aoyi_level(me, "飞花落叶") * cost / 20;

		cost += (me->query("neili") > me->query("max_neili") ? me->query("max_neili") : me->query("neili")) / 8;

		if (cost > target->query("neili"))
		{
			cost = target->query("neili");
		}

		me->add("neili",-me->query("neili") / 10);
		target->add("neili", -cost);
		me->start_busy(1 + random(3));
	} else
	{
		me->add("neili", -120);
		msg = HIG "可是$p" HIG "心如止水，对这缠绵哀怨的剑意丝毫不为所动。"NOR"\n";
		me->start_busy(2);
	}
	message_combatd(msg, me, target);
	return 1;
}
