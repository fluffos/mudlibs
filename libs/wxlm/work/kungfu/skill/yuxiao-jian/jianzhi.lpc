
// jianzhi.c 桃源剑域攻击
// 玉箫剑法与弹指功夫均以攻敌穴道为主，桃源剑域，精微奥妙
// 此招源自桃花岛绝学，意境取自陶渊明《桃花源记》，营造世外桃源之境



#include <combat.h>
inherit F_SSERVER;

string name() { return "桃源剑域"; }
string query_name() { return "桃源剑域"; }
void remove_effect(object me);

int perform(object me, object target)
{
        object weapon;
        int speed, damage, sword;

        weapon=query_temp("weapon", me);

        if( !target && me->is_fighting() ) target = offensive_target(me);

        if( !target
        ||  !target->is_character()
        ||  !me->is_fighting(target) )
                return notify_fail("桃源剑域只能对战斗中的对手使用。\n");

        if( !objectp(weapon) || query("skill_type", weapon) != "sword" )
                return notify_fail("你手中无剑，如何谈得上「桃源剑域」？\n");

        if( query_temp("secondary_weapon", me) )
                return notify_fail("你正握着短兵，没有手能空出来「桃源剑域」了。\n");

        if( query_temp("th_jianmang", me) )
                return notify_fail("你正凝神使动「剑芒」，不能再分心了！\n");

        if( query_temp("th_jianzhi", me) )
                return notify_fail("你正在运用桃源剑域的攻势！\n");

        if( me->query_skill("yuxiao-jian",1) < 120 )
                return notify_fail("你的玉箫剑法修为未到，不能施展桃源剑域！\n");

        if( me->query_skill("tanzhi-shentong",1) < 120 )
                return notify_fail("你的弹指神通修为未到，不能施展桃源剑域！\n");

        if( me->query_skill("bibo-shengong", 1) < 120 )
                return notify_fail("你的碧波神功修为不足，强使桃源剑域，徒然分散功力！\n");

        if( me->query_skill_mapped("sword") != "yuxiao-jian")
                return notify_fail("你并没有使用玉箫剑法！\n");

        if( me->query_skill_mapped("force") != "bibo-shengong")
                return notify_fail("你所运使的内功无法与桃源剑域之心法协调！\n");

        if( me->query_skill_mapped("finger") != "tanzhi-shentong")
                return notify_fail("你所施展的指法并非弹指神通！\n");

        if( me->query_skill_prepared("finger") != "tanzhi-shentong")
                return notify_fail("你还没有准备好施展弹指神通！\n");

        if( query("max_neili", me) <= 1200 )
                return notify_fail("你的内力修为不足，倘若施展桃源剑域，反而会有力分则弱的凶险！\n");

        if( query("neili", me) <= 400 )
                return notify_fail("你的内力不足，不足以施展桃源剑域！\n");

        if( query("jing", me) <= 400 )
                return notify_fail("你的精神不足，不足以施展桃源剑域！\n");

        // if (me->query_temp("th_jianzhi"))
        //         return notify_fail("你正在使用惊雷剑域中！\n");
                
        damage = me->query_skill("sword") + me->query_skill("tanzhi-shentong",1);

        //pve伤害x2
        if (!playerp(target))
        {
            damage = damage * 2;
        }

        sword = (me->query_skill("sword") + me->query_skill("finger") );
        addn("neili", -250, me);
        addn("jing", -100, me);

        COMBAT_D->do_attack(me,target,query_temp("weapon", me));

        message_combatd(HIW"$N"HIW"手中"+weapon->name()+HIW"轻舞，"NOR HIY"§"HIW"桃源剑域"HIY"§"NOR HIW"悠然展开......\n"NOR, me,target);
        message_combatd(HIW"忽见桃花片片飞舞，剑光如流水潺潺，恍若置身世外桃源，\n"
                       "剑势绵延不绝，如春风化雨，润物无声。"NOR, me,target);

        //第二剑稍快
        addn_temp("apply/attack", damage/3, me);
        COMBAT_D->do_attack(me,target,query_temp("weapon", me));
        addn_temp("apply/attack", -damage/3, me);

        if(me->is_fighting(target) ){
                message_combatd(HIW"$N剑势未止，左手指力已蕴劲弹出，点向$n各路穴道，\n"
                               "桃源剑域中"+HIY"「玉箫剑法」"NOR+HIW"与"+HIY"「弹指神通」"NOR+HIW"相得益彰，\n"
                               "如桃花源中渔人所见，奇景纷呈，变化无穷！"NOR, me,target);

                if (playerp(target))
                {
                    weapon->unequip();
                    COMBAT_D->do_attack(me,target,query_temp("weapon", me));
                    weapon->wield();
                }
        }
        set_temp("th_jianzhi", sword/10, me);//设置多少轮攻击

        if( query_temp("th_jianzhi", me)>20 )
        {
                set_temp("th_jianzhi", 20, me);
        }

        speed = 0;

        call_out("checking", 1, me, weapon,damage,target);
        me->start_busy(2+random(2));
        return 1;
}

void checking(object me, object weapon, int damage, object target)
{
        string msg;

        if (!me) return;



        if( !living(me) || me->is_ghost() )
        {
                remove_effect(me);
                return ;
        }

        if (!objectp(target) || !me->is_fighting(target))
        {
                remove_effect(me);
                return ;
        }

        //必须在同一地图
        if (environment(me) != environment(target))
        {
                remove_effect(me);
                return ;
        }

        if( !me->is_fighting() )
        {
                message_combatd("\n$N见战局已毕，便即收起了桃源剑域的功法。\n", me);
                remove_effect(me);
                return ;
        }
        else if(!objectp(weapon) || !environment(weapon) || environment(weapon) != me || weapon != query_temp("weapon", me) )
        {
                message_combatd("\n$N手中兵器已失，当下收回了桃源剑域的攻势。\n", me);
                remove_effect(me);
                return ;
        }
        else if( me->query_skill_mapped("sword") != "yuxiao-jian"
        || me->query_skill_mapped("finger") != "tanzhi-shentong"
        || me->query_skill_prepared("finger") != "tanzhi-shentong" )
        {
                remove_effect(me);
                message_combatd(HIG"\n$N一挥"+weapon->name()+HIG"，骤然变换招数，不再是玉箫剑法与弹指神通的搭配进击！\n", me);
                return ;
        }
        else if( query("neili", me)<500 || query("jing", me)<500 )
        {
                tell_object(me, HIW "\n你惊觉内息渐弱，再如此快攻恐怕後继乏力，当下不动声色，暗暗收了左手「弹指神通」攻势。\n" );
                remove_effect(me);
                return ;
        }
        else if( query_temp("th_jianzhi", me) <= 1 )
        {
                remove_effect(me);
                message_combatd(HIG"\n$N一挥"+weapon->name()+HIG"，左手食中二指捏起剑诀，心无旁骛地使动「玉箫剑法」！\n", me);
                return;
        }
        else
        {
                int extra_damage;

                if (!target || !me->is_fighting(target))
                {
                        remove_effect(me);
                        message_combatd("\n$N见战局已毕，便即收起了桃源剑域的功法。\n", me);
                        return;
                }

                if (random(me->query_skill("sword")) + me->query_skill("finger") >  target->query_skill("dodge"))
                {
                        switch (random(3))
                        {
                                case 0:
                                        msg = HIW "桃源剑域中剑意自生，剑光如" HIY "落英缤纷" HIW "，飘然而至，直取$n要害！\n"NOR;
                                        break;
                                case 1:
                                        msg = HIW "世外桃源，" HIW "桃源剑域" HIW "自成一界，剑气如春风化雨，润物无声，寻敌而至，令群邪辟易！"NOR"\n";
                                        break;
                                case 2:
                                        msg = HIW "桃源剑域" HIW "挥洒自如，剑心通明，自动索敌，如" HIY "桃花片片" HIW "，飘然斩敌！"NOR"\n";
                                        break;
                        }

                        {
                                
                                // 获取飞花落叶意境等级
                                int aoyi_level = COMBAT_D->get_skill_aoyi_level(me, "飞花落叶");

                                // 如果有飞花落叶意境，增加额外伤害
                                if (aoyi_level)
                                {
                                        // 计算额外伤害：剑法激发等级 / 6 * 根本法等级
                                        int sword_level = me->query_skill("sword");

                                        // 计算额外伤害：剑法激发等级 / 6 * 根本法等级
                                        extra_damage = (sword_level / 6) * aoyi_level;
                                        
                                        //桃源破体:当敌方的当前内力 < 最大内力时，计算敌方的内力损失百分比，增加额外伤害
                                        if (target->query("neili") < target->query("max_neili"))
                                        {
                                                int neili_loss = target->query("max_neili") - target->query("neili");
                                                int neili_loss_percent = neili_loss * 100 / target->query("max_neili");
                                                extra_damage += neili_loss_percent * extra_damage / 100;
                                        }
                                        

                                        // 将额外伤害加入总伤害
                                        damage += extra_damage;
                                        
                                        // 显示飞花落叶效果信息
                                        msg += HIW "桃源剑域中" HIY "落英缤纷" HIW "，意境悠远如陶公笔下桃花源，\n"
                                               "$n恍若置身其中，心神为之迷醉，气血为之一滞！"NOR;
                                        me->improve_skill("qimen-wuxing", me->query_skill("sword"));
                                }
                        }

                        {
                                int qi_heal = me->query_skill("qimen-wuxing", 1) + 100;

                                qi_heal = qi_heal * 2;
                                // me->receive_damage("qi", qi_heal);
                                me->receive_heal("qi", qi_heal);
                                me->receive_curing("qi", qi_heal);
                                msg += HIC "$N" HIC "足踏奇门方位，借阵法流转之势恢复气血，自己顶住压力继续催动剑域！"NOR"\n" +
                                       HIC "只见剑域内五行之气流转不息，为$N" HIC "补充了" + chinese_number(qi_heal) + "点气血！"NOR"\n";
                                me->improve_skill("qimen-wuxing", target->query_skill("qimen-wuxing", 1) + me->query_skill("qimen-wuxing", 1));
                        }




                        msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 66,
                        HIR "$n" HIR "继续受到桃源剑域的势不可挡的攻势，恍若置身桃花飞舞之中，猛的吐出一口淤血！"NOR"\n");

                        if (extra_damage)
                        {
                                damage = damage - extra_damage;
                        }
                        
                        if (random(2))
                        {
                                target->start_busy(1);
                        }
                        else
                        {
                                damage += me->query_skill("sword");
                        }
                }
                else
                {
                        msg = HIG "可是$p" HIG "心神安定，没有收到半天困惑。"NOR"\n";
                }

                message_combatd(msg, me, target);
                addn("neili", -250, me);
                addn("jing", -100, me);
                addn_temp("th_jianzhi", -1, me);

                call_out("checking", 1, me, weapon,damage,target);
        }
        return;
}

void remove_effect(object me)
{
        if (!me) return;
        delete_temp("th_jianzhi", me);
}
