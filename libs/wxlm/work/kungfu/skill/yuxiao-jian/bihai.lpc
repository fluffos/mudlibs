
#include <combat.h>

inherit F_SSERVER;

string query_name() { return "潮起潮落"; }

int perform(object me, object target)
{
	string msg;
	int ap, dp;
	int jing, skill;
	object ob;

	if (! target)
	{
		me->clean_up_enemy();
		target = me->select_opponent();
	}

	if (! target || ! me->is_fighting(target))
		return notify_fail(HIW "潮起潮落按玉箫" NOR
				   "只能对战斗中的对手使用。\n");

	if (! objectp(ob = me->query_temp("handing")) || ! ob->valid_as_xiao())
	{
		// 手里没有握萧，察看兵器
		if (! objectp(ob = me->query_temp("weapon")) ||
		    ! ob->valid_as_xiao())
		{
			// 手里的兵器也不能作为萧使用
			return notify_fail("你手里没有拿萧，无法使出这个绝招！\n");
		}
	}

	skill = me->query_skill("yuxiao-jian", 1);

	if (skill < 150)
		return notify_fail("你的云箫剑法等级不够, 不能使用"
				   HIW "潮起潮落按玉箫" NOR "。\n");

	if (me->query("neili") < 300)
		return notify_fail("你的内力不够，无法运用"
				   HIW "潮起潮落按玉箫" NOR "。\n");

        if (target->query("qi")>target->query("max_jing")*3 && !userp(target))
	      return notify_fail("对方气血充盈，" HIW "潮起潮落按玉箫" NOR "无法影响。\n");

       if (! living(target))
	      return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

	ap = me->query_skill("force") + me->query_skill("sword");
	dp = target->query_skill("force") + target->query_skill("dodge");

	jing = (int) me->query("jing") / 10;
	jing += me->query_skill("sword") + me->query_skill("chuixiao-jifa") + me->query_skill("qimen-wuxing");

	jing += COMBAT_D->get_skill_aoyi_level(me, "飞花落叶") * jing / 20;
	
	msg = HIC "$N" HIC "手按" + ob->name() + HIC "，脚踏八卦方位，奏出" NOR
	      HIW "§" HIC "潮起潮落按玉箫" HIW "§" NOR
	      HIC "............"NOR"\n";
	msg += HIW "\n箫声初起，如远山含黛，海天一色，万籁俱寂。"
		   "渐渐地，似有微风拂过海面，波光粼粼，箫音悠远而深邃。"NOR"\n";

	//pve命中x1.5
	if (!playerp(target))
	{
		ap = ap * 3 / 2;
	}

	//伤害x1.5
	if (!playerp(target))
	{
		jing = jing * 3 / 2;
	}

	if (COMBAT_D->hit_determination(me,target,ap,dp))
	{
		msg += HIR "$n" HIR "心头一荡，脸上不自禁的露出微笑！"NOR"\n";
		target->receive_damage("jing", jing, me);
		target->receive_wound("jing", jing, me);
		message_combatd(msg, me, target);
	} else
	{
		msg += HIY "$n" HIY "暗暗凝神守一，对这箫声自是应付裕如！"NOR"\n";
		message_vision(msg, me, target);
	}

	msg = HIW "箫声渐起，如春潮初涌，轻柔缓缓。远处似有潮声隐约，"
		  "时而低吟浅唱，时而婉转悠扬，恰似海风轻抚，\n"
		  "波澜不兴却暗藏玄机。"NOR"\n";

	if (ap / 3 + random(ap) > dp)
	{
		msg+= HIR "$n只觉心神摇曳，仿佛置身潮头，随波起伏！"NOR"\n";
		target->receive_damage("jing", jing / 2, me);
		target->receive_wound("jing", jing / 2, me);
		message_combatd(msg, me, target);
	} else
	{
		msg += HIY "$n" HIY "暗暗凝神守一，对这箫声自是应付裕如！"NOR"\n";
		message_vision(msg, me, target);
	}

	msg = HIW  "箫声骤变，如大潮汹涌而至！初时远山如黛，海平如镜，忽然间潮头涌起，\n"
		   "一浪高过一浪。箫音激昂澎湃，恰似千军万马奔腾，白浪滔天，\n"
		   "惊涛拍岸，卷起千堆雪，气势磅礴，震撼心魄！"NOR"\n";

	if (ap / 4 + random(ap) > dp)
	{
		msg+= HIR "$n" HIR "只觉胸中如有怒潮翻滚，气血激荡难平！"NOR"\n";
		target->receive_damage("jing", jing / 3, me);
		target->receive_wound("jing", jing / 3, me);
		message_combatd(msg, me, target);
	} else
	{
		msg += HIY "$n" HIY "暗暗凝神守一，对这箫声自是应付裕如！"NOR"\n";
		message_vision(msg, me, target);
	}

	msg = HIW "箫声渐弱渐细，如潮水退去，归于宁静。海面重现平镜，"
		  "唯有深海之中暗流涌动，余韵悠长，意境深远。"NOR"\n";

	if (ap / 5 + random(ap / 4) > dp)
	{
		msg+= HIR "$n" HIR "心神已被这潮起潮落之韵牢牢摄住，难以自拔！"NOR"\n";
		target->receive_damage("jing", jing / 2, me);
		target->receive_wound("jing", jing / 2, me);
		me->start_busy(1 + random(2));
		me->add("neili", -200);
		message_combatd(msg, me, target);
		return 1;
	} else
	{
		msg+= HIY "$n" HIY "暗暗凝神守一，对这箫声自是应付裕如！"NOR"\n";
		me->start_busy(2 + random(3));
		me->add("neili", -200);
		message_vision(msg, me, target);
		return 1;
	}

	message_combatd(msg, me, target);

	return 1;
}
