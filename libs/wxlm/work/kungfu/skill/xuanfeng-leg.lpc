int valid_enable(string usage) { return usage == "unarmed" ||  usage == "parry"; }

int valid_combine(string combo) { return combo == "luoying-shenzhang"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("学习旋风扫叶腿必须空手。\n");

	if ((int)me->query_skill("force") < 80)
		return notify_fail("你的内功火候不够，无法学旋风扫叶腿。\n");

	if ((int)me->query("max_neili") < 400)
		return notify_fail("你的内力太弱，无法练旋风扫叶腿。\n");

	if ((int)me->query_skill("unarmed", 1) < (int)me->query_skill("xuanfeng-leg", 1))
		return notify_fail("你的基本拳脚水平有限，无法领会更高深的旋风扫叶腿。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action) - 1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int)me->query_skill("xuanfeng-leg", 1);
	for (i = sizeof(action); i > 0; i--)
		if(level > action[i - 1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 60)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 60)
		return notify_fail("你的内力不够练旋风扫叶腿。\n");

	me->receive_damage("qi", 45);
	me->add("neili", -51);

	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"xuanfeng-leg/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【旋风扫叶腿】" ZJBR NOR;
    msg += "桃花岛主黄药师所创绝技，腿法如旋风扫落叶，以快伤敌。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  必须空手。" ZJBR;
    msg += "  内功激发等级 (force) 不低于 " HIY "80" NOR " 级。" ZJBR;
    msg += "  最大内力 (max_neili) 不低于 " HIB "400" NOR " 点。" ZJBR;
    msg += "  基本拳脚 (unarmed) 等级不低于 旋风扫叶腿 等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  拳脚 (unarmed)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR;
    msg += "  可与 落英神剑掌 互备。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血 (qi) 不低于 " HIR "60" NOR " 点。" ZJBR;
    msg += "  内力 (neili) 不低于 " HIB "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "45" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "51" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  狂风绝技 (kuangfeng)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      旋风扫叶腿等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      落英神剑掌等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      内功激发等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "150" NOR " 点。" ZJBR;
    msg += "      必须在战斗中，且自身非忙乱状态。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      身法陡然加快，双腿犹如狂风般连续" HIR "六次" NOR "踢向对手。" ZJBR;
    msg += "      命中判定：由战斗核心 (`COMBAT_D`) 根据双方的技能等级、属性、状态等因素进行判定。" ZJBR;
    msg += "      伤害计算：由战斗核心 (`COMBAT_D`) 计算基础伤害，受双方攻防属性、技能等级影响。" ZJBR;
    msg += "      临时增益：在六次攻击期间，临时提升 攻击加成 (" HIY "旋风扫叶腿等级 / 2" NOR ") 和 伤害加成 (" HIY "旋风扫叶腿等级 / 3" NOR ")。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      使用后自身忙乱 " HIR "1" NOR " 至 " HIR "6" NOR " 秒（随机）。" ZJBR;

    return msg;
}