int valid_enable(string usage)
{
	return usage == "finger" ||
	       usage == "parry" ||
	       usage == "throwing";
}

int valid_combine(string combo) { return combo == "lanhua-shou"; }

int valid_learn(object me)
{
	if ((int)me->query_skill("force") < 150)
		return notify_fail("你的内功火候不够，无法学弹指惊雷。\n");

	if ((int)me->query("max_neili") < 1000)
		return notify_fail("你的内力太弱，无法练弹指惊雷。\n");

	if ((int)me->query_skill("finger", 1) < 100)
		return notify_fail("你的基本指法火候不够，无法学弹指惊雷。\n");

	if ((int)me->query_skill("finger", 1) < (int)me->query_skill("tanzhi-shentong", 1))
		return notify_fail("你的基本指法水平有限，无法领会更高深的弹指惊雷。\n");

	return 1;
}

string query_skill_name(int level)
{
	return action_finger[random(sizeof(action_finger))]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	return action_finger[random(sizeof(action_finger))];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 80)
		return notify_fail("你的体力不够，休息一下再练吧。\n");

	if ((int)me->query("neili") < 80)
		return notify_fail("你的内力不够练弹指惊雷。\n");

	me->receive_damage("qi", 68);
	me->add("neili", -67);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"tanzhi-shentong/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【弹指惊雷】" ZJBR NOR;
    msg += "弹指惊雷是一门高深的指法技能，以指力凝聚内劲，指风犀利，能伤人于无形。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  内功等级 " HIB "150" NOR " 级以上。" ZJBR;
    msg += "  内力最大值 " HIB "1000" NOR " 以上。" ZJBR;
    msg += "  基本指法等级 " HIY "100" NOR " 级以上。" ZJBR;
    msg += "  基本指法等级不低于弹指惊雷等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  指法（finger）。" ZJBR;
    msg += "  招架（parry）。" ZJBR;
    msg += "  暗器（throwing）。" ZJBR;
    msg += "  可与兰花手互备。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "80" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "80" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "68" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "67" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  弹指惊雷 (jinglei)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      弹指惊雷等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "250" NOR " 点。" ZJBR;
    msg += "      激发指法为弹指惊雷。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：自身指法技能 + 内功技能 VS 目标内功技能 + 招架技能。" ZJBR;
    msg += "      伤害计算：(自身指法技能 + 内功技能) / 3 + 随机(0 ~ (自身指法技能 + 内功技能) / 2)。" ZJBR;
    msg += "      命中后对目标造成精神伤害，同时有几率使目标手中的武器脱手。" ZJBR;
    msg += "      对非玩家目标命中率提高50%，伤害翻倍。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力 " HIB "200" NOR " 点，忙乱 " HIR "3" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "50" NOR " 点，忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  弹指神功 (tanzhi)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      弹指惊雷等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      手持暗器。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：自身指法技能 VS 目标轻功技能 * 2 / 3。" ZJBR;
    msg += "      对非玩家目标轻功提高50%，降低命中率。" ZJBR;
    msg += "      伤害计算：弹指惊雷等级 / 2 + 随机(0 ~ 弹指惊雷等级 / 2) + 加力效果 + 150。" ZJBR;
    msg += "      使用暗器攻击敌人，消耗一个暗器，造成大量伤害。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "90" NOR " 点，忙乱 " HIR "2" NOR " 秒。" ZJBR;

    return msg;
}
