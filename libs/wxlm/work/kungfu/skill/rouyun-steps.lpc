// rouyun-steps.c  柔云步法
// modified by Venus Oct.1997
// Made by deaner

inherit SKILL;

string *dodge_msg = ({
      "$n使一式"+HIW"『云中贺影』"NOR+"，身形纵离地面数尺，躲过了$N这一招。\n",
      "$n身形飘飘，使出一式"+MAG"『云彩飘忽』"NOR+"，避过了$N的攻击。\n",
      "$n使出一式"+HIB"『云雾缭绕』"NOR+"，$N眼前已没了$n的踪影。\n",
      "$n施展出一式"+HIG"『云雨不定』"NOR+"，身影急幌，在千钧一发间躲过了$N的攻势。\n",
      "$n衣袂飘飘，一式"+HIY"『云蒸霞蔚』"NOR+"，轻灵地避了开去。\n",
      "$n立即使出一式"+YEL"『云海浮沉』"NOR+"，沉肩滑步，微晃身影，避开了$N的攻击。\n",
      "$n立刻使一式"+BLU"『云影万千』"NOR+"，身形忽进忽退，忽左忽右，$N的攻击已然无效。\n",
});

int valid_enable(string usage)
{
    return (usage == "dodge") || (usage == "move");
}

int valid_learn(object me)
{
    if ((int)me->query_dex() <= 30)
	return notify_fail("你的身法不够，难以领会柔云步法。");

    return 1;
}

string query_dodge_msg()
{
    return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
    if( (int)me->query("qi") < 50 )
	return notify_fail(HIC"你的体力太差了，不能练柔云步法。"NOR"\n");

    if( (int)me->query("neili") < 50 )
	return notify_fail(HIC"你的内力太差了，不能练柔云步法。"NOR"\n");

    me->receive_damage("qi", 45);
    me->add("neili", -20);
    return 1;
}

string perform_action_file(string action)
{
    return __DIR__"rouyun-steps/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【柔云步法】" ZJBR NOR;
    msg += WHT "柔云步法是一门轻灵飘逸的身法,以其轻盈如云、变化多端的特点著称。此步法讲究身形轻盈,动作飘忽,如行云流水般自然流畅。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  先天身法 " HIC "30" NOR " 以上。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  轻功 (dodge)。" ZJBR;
    msg += "  步法 (move)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "45" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "20" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  柔云纵 (zong)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      基本柔云步法 " HIY "50" NOR " 级。" ZJBR;
    msg += "      当前精力 " HIG "50" NOR " 点。" ZJBR;
    msg += "      战斗状态中。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      立即脱离当前战斗，并随机移动到以下地点之一：武庙、客店、测试房间(/u/deaner/test1)。" ZJBR;
    msg += "      设置临时状态，短时间内阻止他人跟随 (`no_follow`)。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      精力 " HIG "10" NOR " 点。" ZJBR;
    msg += "      精力上限 " HIG "20" NOR " 点。" ZJBR;

    return msg;
}