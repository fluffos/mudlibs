// 云龙神功

inherit FORCE;

int valid_enable(string usage)
{
	return usage == "force";
}

int valid_learn(object me)
{
	if (me->query("gender") == "无性" &&
	    (int)me->query_skill("yunlong-shengong", 1) > 49)
		return notify_fail("你无根无性，阴阳不调，难以领会高深的云龙神功。\n");

	if ((int)me->query_skill("force", 1) < 30)
		return notify_fail("你的基本内功火候还不够，无法领会云龙神功。\n");

	return ::valid_learn(me);
}


int practice_skill(object me)
{
	return notify_fail("云龙内功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"yunlong-shengong/" + func;
}

string query_description()
{
    string msg;

    msg = HIY "【云龙神功】" ZJBR NOR;
    msg += WHT "云龙神功是一门以内力深厚和灵活多变著称的高级内功心法。" ZJBR;
    msg += WHT "修炼此功法能提升战斗中的各项能力。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功 (" HIW "force" NOR ", 1) 等级不低于 " HIC "30" NOR " 级。" ZJBR;
    msg += "  性别要求：非 无性 (当 云龙神功 等级超过 49 级时)。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功 (force)" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  云龙神功只能通过学习 (learn) 提升，无法练习 (practice)。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  云龙战意 (powerup)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      内功有效激发 等级不低于 " HIC "30" NOR " 级。" ZJBR;
    msg += "      当前内力 不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "      不可重复运功。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      临时提升 攻击力 (" HIW "apply/attack" NOR ")，提升值为 (内功有效激发 / 3)。" ZJBR;
    msg += "      临时提升 躲闪 (" HIW "apply/dodge" NOR ")，提升值为 (内功有效激发 / 3)。" ZJBR;
    msg += "      效果持续时间为 (内功有效激发 / 3) 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;

    return msg;
}