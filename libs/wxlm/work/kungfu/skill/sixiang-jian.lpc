// 四象剑法

inherit SKILL;

mapping *action = ({
    ([  "action" : "$N使出「青龙探爪」，手中$w化为一道青光，直刺$n的$l",
        "force" : 120,
        "dodge" : 20,
        "damage": 25,
        "lvl" : 0,
        "skill_name" : "青龙探爪",
        "damage_type" : "刺伤"
    ]),
    ([  "action" : "$N一式「白虎噬天」，$w挟着雷霆万钧之势扫向$n的$l",
        "force" : 140,
        "dodge" : 15,
        "damage": 30,
        "lvl" : 30,
        "skill_name" : "白虎噬天",
        "damage_type" : "割伤"
    ]),
    ([  "action" : "$N运转「朱雀焚天」，$w上下翻飞，散发出炽热的剑气击向$n",
        "force" : 160,
        "dodge" : 25,
        "damage": 35,
        "lvl" : 60,
        "skill_name" : "朱雀焚天",
        "damage_type" : "刺伤"
    ]),
    ([  "action" : "$N使出「玄武守一」，$w化作一道水幕，将$n笼罩其中",
        "force" : 180,
        "dodge" : 30,
        "damage": 40,
        "lvl" : 90,
        "skill_name" : "玄武守一",
        "damage_type" : "割伤"
    ]),
});

int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me)
{
    if ((int)me->query("max_neili") < 100)
        return notify_fail("你的内力不够，无法练习四象剑法。\n");
    if ((int)me->query_skill("sixiang-shengong", 1) < 20)
        return notify_fail("你的四象神功火候不够，无法练习四象剑法。\n");
    return 1;
}

string query_skill_name(int level)
{
    int i;
    for(i = sizeof(action)-1; i >= 0; i--)
        if(level >= action[i]["lvl"])
            return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    int i, level;
    level = (int)me->query_skill("sixiang-jian", 1);
    for(i = sizeof(action); i > 0; i--)
        if(level > action[i-1]["lvl"])
            return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    object weapon;
    if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对。\n");
    if ((int)me->query("qi") < 50)
        return notify_fail("你的体力不够练四象剑法。\n");
    if ((int)me->query("neili") < 30)
        return notify_fail("你的内力不够练四象剑法。\n");
    me->receive_damage("qi", 30);
    me->add("neili", -20);
    return 1;
}

string perform_action_file(string action)
{
    return __DIR__"sixiang-jian/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【四象剑法】" ZJBR NOR;
    msg += WHT "四象剑法是四象门的基础剑法，融合青龙、白虎、朱雀、玄武四象之意，招式变化多端。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "  基本四象神功等级不低于 " HIY "20" NOR " 级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  剑法 (sword)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须装备 " HIW "剑类" NOR " 武器。" ZJBR;
    msg += "  气血：不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "30" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "30" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "20" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  四象合一 (sixiang-heyi)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      基本四象剑法 " HIY "100" NOR " 级。" ZJBR;
    msg += "      基本四象神功 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      必须装备剑类武器。" ZJBR;
    msg += "      必须激发四象剑法为剑法。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：比较 (自身激发剑法等级 + 激发内功等级) 与 (目标激发轻功等级 + 激发招架等级)。" ZJBR;
    msg += "      命中效果：对目标造成伤害 (`COMBAT_D->do_damage`)，伤害值约为 ((自身激发剑法等级 + 激发内功等级) / 2 + 随机((自身激发剑法等级 + 激发内功等级) / 2))，伤害加成60。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力 " HIB "150" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "50" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;

    return msg;
}
