// buddhism.c 禅宗心法
// Modified by Venus Oct.1997

inherit SKILL;
void create() { seteuid(getuid()); }

string type() { return "knowledge"; }

int valid_learn(object me)
{
	if (me->query("family/family_name") != "少林派" && me->query("family/family_name") != "段氏皇族") {
		if (me->query_skill("buddhism", 1) >= 1800)
			return notify_fail("非少林派或段氏皇族的弟子才能只能学习该技能到1800级。\n");
	}
	if( (int)me->query("guilty") > 0 )
		return notify_fail("你屡犯僧家数戒，尘俗之心太重，无法修炼禅宗心法。\n");

	return 1;
}

int practice_skill(object me)
{
    return notify_fail("禅宗心法只能靠学(learn)来提高。\n");
}

string query_description()
{
    string msg;

    msg = "";
    msg += HIY "【禅宗心法】" ZJBR ZJBR NOR;
    msg += WHT "禅宗心法是少林派和段氏皇族的核心内功心法，以其深奥玄妙而闻名。" ZJBR;
    msg += "此心法讲究明心见性、参悟佛理，能提升修炼者的悟性和内力。" ZJBR ZJBR;
    msg += HIY "【技能要求】" ZJBR NOR;
    msg += "  无特殊要求" ZJBR ZJBR;
    msg += HIY "【技能效果】" ZJBR NOR;
    msg += "  可激发为知识技能（knowledge）" ZJBR;
   
    msg += HIY "【学习条件】" ZJBR NOR;
    msg += "  少林派或段氏皇族弟子可学习到任意等级" ZJBR;
    msg += "  其他门派弟子最多学习到180级" ZJBR;
    msg += "  不能有罪孽（guilty）" ZJBR ZJBR;
    msg += HIY "【练习方式】" ZJBR NOR;
    msg += "  只能通过学习(learn)来提高，无法练习(practice)" ZJBR ZJBR;
    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 禅宗心法需要长期潜心修炼，不可急于求成。" ZJBR;
    msg += "2. 修炼过程中要保持内心清净，不可有罪孽。" ZJBR;
    msg += "3. 非少林派或段氏皇族弟子要注意180级的限制。\n";

    return msg;
}
