int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me)
{
	if ((int)me->query_skill("force") < 30)
		return notify_fail("你的内功火候不到，无法学习全真剑法。\n");

	if (me->query("neili") < 200)
		return notify_fail("你的内力太差，无法学习全真剑法。\n");

	if (me->query_skill("sword", 1) < me->query_skill("quanzhen-jian", 1))
		return notify_fail("你的基本剑法水平有限，无法领会更高深的全真剑法。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action) - 1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}
//等级提升，是否学会新的招式
string query_skill_up(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
	 {
		if(level == action[i]["lvl"])
		 {
		     return action[i]["skill_name"];
		 }
	 }
	  return "no";
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("quanzhen-jian",1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 60)
		return notify_fail("你的体力不够练全真剑法。\n");

	if ((int)me->query("neili") < 60)
		return notify_fail("你的内力不够练全真剑法。\n");

	me->receive_damage("qi", 55);
	me->add("neili", -53);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"quanzhen-jian/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【全真剑法】" ZJBR NOR;
    msg += WHT "全真教基础剑法，剑式平和，中正大气，看似简单实则蕴含全真教武学至理。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  需装备剑类武器。" ZJBR;
    msg += "  内功激发等级 ≥ " HIC "30" NOR " 级。" ZJBR;
    msg += "  当前内力 ≥ " HIB "200" NOR " 点。" ZJBR; // MUD中通常指当前值
    msg += "  基本剑法等级 ≥ 全真剑法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  剑法 (sword)" ZJBR;
    msg += "  招架 (parry)" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  需装备剑类武器。" ZJBR;
    msg += "  气血 ≥ " HIR "60" NOR " 点。" ZJBR;
    msg += "  内力 ≥ " HIB "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗：" ZJBR;
    msg += "    气血：" HIR "55" NOR " 点。" ZJBR;
    msg += "    内力：" HIB "53" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (perform)〗" ZJBR NOR; // perform_action_file

    msg += HIC "  定阳针 (ding)" ZJBR NOR;
    msg += "    学习要求：" ZJBR;
    msg += "      全真剑法等级 ≥ " HIY "100" NOR " 级。" ZJBR;
    msg += "      先天功等级 ≥ " HIC "100" NOR " 级。" ZJBR; // 假设指先天功
    msg += "      最大内力 ≥ " HIB "500 + (先天功等级 * 2)" NOR " 点。" ZJBR; // 简化代码中的复杂判断
    msg += "    使用要求：" ZJBR;
    msg += "      当前内力 ≥ " HIB "300" NOR " 点。" ZJBR;
    msg += "      激发剑法为全真剑法。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      发出一道剑气攻击目标。" ZJBR;
    msg += "      基础伤害值约为：(先天功等级 + 全真剑法等级) / 2 + 随机((先天功等级 + 全真剑法等级) / 2)。" ZJBR; // 简化 level 计算
    msg += "      命中后，若 随机(自身内功激发等级) > (目标内功激发等级 / 2)，则附加 (基础伤害值 * 2) 点内力伤害。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      忙乱 " HIR "1" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  缠字诀 (chan)" ZJBR NOR;
    msg += "    学习要求：" ZJBR;
    msg += "      全真剑法等级 ≥ " HIY "80" NOR " 级。" ZJBR;
    msg += "    使用要求：" ZJBR;
    msg += "      当前内力 ≥ " HIB "60" NOR " 点。" ZJBR;
    msg += "      激发剑法为全真剑法。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      尝试用剑芒缠绕目标，使其忙乱。" ZJBR;
    msg += "      成功判定：攻击力 AP = 自身基本剑法等级，防御力 DP = 目标内功激发等级。成功条件：(AP / 2 + 随机(AP)) > DP。" ZJBR;
    msg += "      成功效果：使目标忙乱，持续时间为 (全真剑法等级 / 28 + 2) 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "45" NOR " 点。" ZJBR;
    msg += "      若成功：自身无忙乱。" ZJBR;
    msg += "      若失败：自身忙乱 " HIR "1" NOR " 秒。" ZJBR;
    msg += "      冷却时间：" HIB "6" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  化剑为气 (hua)" ZJBR NOR;
    msg += "    学习要求：" ZJBR;
    msg += "      全真剑法等级 ≥ " HIY "120" NOR " 级。" ZJBR;
    msg += "      先天功等级 ≥ " HIC "120" NOR " 级。" ZJBR; // 假设指先天功
    msg += "    使用要求：" ZJBR;
    msg += "      当前内力 ≥ " HIB "300" NOR " 点。" ZJBR;
    msg += "      激发剑法为全真剑法。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      化剑为无形气劲，对目标进行多次攻击。" ZJBR;
    msg += "      攻击次数：(先天功等级 / 40 + 3) 次，最少 3 次。" ZJBR;
    msg += "      命中判定（每次）：攻击力 AP = (自身内功激发等级 + 自身基本剑法等级)，防御力 DP = (目标内功激发等级 + 目标招架激发等级)。命中条件：(AP / 2 + 随机(AP)) > DP。" ZJBR;
    msg += "      伤害计算（每次命中）：基础伤害约为 (AP / 2 + 随机(AP / 2))。" ZJBR;
    msg += "      连击判定（每次命中后）：(AP + 随机(AP)) > DP。若失败则停止后续攻击。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      忙乱 " HIR "3" NOR " 秒。" ZJBR;
    msg += "      冷却时间：" HIB "8" NOR " 秒。" ZJBR ZJBR;

    return msg;
}