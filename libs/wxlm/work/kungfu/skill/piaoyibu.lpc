// piaoyibu.c
inherit SKILL;

string *dodge_msg = ({
	"$n一个「银鹭渡海」，跃起数尺，躲过了$N这一招。\n",
	"$n身形向后一纵，使出一招「玉兔落尘」，避过了$N的攻击。\n",
	"$n使出「锦鲤穿沙」，恰好躲过了$N的攻势。\n",
	"$n一招「灵狐幻遁」，姿态美妙地躲了开去。\n"
});

int valid_enable(string usage)
{
	return (usage == "dodge") || (usage == "move");
}

int valid_learn(object me) { return 1; }

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
	if( (int)me->query("qi") < 50 )
		return notify_fail("你的体力太差了，不能练飘逸步法。\n");

	me->receive_damage("qi", 40);
	return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【飘逸步法】" ZJBR NOR;
    msg += WHT "飘逸步法是一门轻盈灵动的身法，以其飘逸潇洒的姿态著称。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "    无特殊要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "    轻功 (dodge)" ZJBR;
    msg += "    身法 (move)" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "    气血 ≥ " HIR "50" NOR " 点。" ZJBR;
    msg += "    每次练习消耗气血：" HIR "40" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "    无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "    无。" ZJBR;

    return msg;
}
