// qufeng.c 驱蜂之术
// By Lgg,1998.9

inherit SKILL;

void create() { seteuid(getuid()); }

string type() { return "knowledge"; }

int valid_learn(object me)
{
	if ((int)me->query_skill("yunv-xinfa", 1) < 30)
		return notify_fail("你的玉女心法火候不够，无法学驱蜂之术。\n");

	if ((int)me->query("max_neili") < 300)
		return notify_fail("你的内力太弱，无法学习驱蜂之术。\n");

	return 1;
}
int practice_skill(object me)
{
	return notify_fail("驱蜂之术只能靠学习来提高。\n");
}
string query_description()
{
    string msg;

    msg = HIY "【驱蜂之术】" ZJBR NOR;
    msg += WHT "古墓派驱使玉蜂的独特技巧，通过内力声音控制玉蜂攻击或辅助。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  玉女心法 ≥ " HIC "30" NOR " 级。" ZJBR;
    msg += "  最大内力 ≥ " HIB "300" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  知识类技能 (knowledge)" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  无法通过练习 (practice) 提高，只能通过学习 (learn) 来提升等级。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  掌握后可运用玉蜂进行各种活动（具体效果需参考相关指令或设定）。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 驱蜂之术是一种知识类技能，不能直接用于战斗。" ZJBR;
    msg += "2. 使用驱蜂之术时需要注意周围环境，以免伤及无辜。" ZJBR;
    msg += "3. 熟练掌握驱蜂之术可以增强对蜜蜂的控制能力。\n";

    return msg;
}
