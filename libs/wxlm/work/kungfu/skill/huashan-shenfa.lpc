// huashan-shenfa.c 华山身法

inherit SKILL;

string *dodge_msg = ({
	"$n一式「巨鹏亮翅」，两臂鹏举如翼，在剌剌风声中，从$N头顶横跃而过。\n",
	"$n一式「风送紫霞」，如一阵清风，舒缓地闪过了$N的凌厉攻势。\n",
	"$n一式「燕回朝阳」，轻盈地一跃，一转眼间便绕到了$N的身后。\n",
	"$n一式「却别苍松」，一转身间，向后飘出近一丈远\n",
	"$n一式「旭日初升」，全身笔直，拔地而起，在半空中一转，已落到几丈远的地方。\n",
	"$n一式「金雁横空」，身体如一只金雁般行云流水地滑出丈余。\n",
	"$n一式「晚月朗星」，双脚点地，全身化为一道白影，急速绕着$N打了几转。\n",
	"$n一式「幻眼云湮」，身形陡地变得飘忽不定，令$N无法看清。\n",
	"$n一式「苍龙盘岭」，宛若一条矫矢苍龙，围着$N急速地盘旋了几圈。\n",
});

int valid_enable(string usage)
{
	return usage == "dodge" || usage == "move";
}

int valid_learn(object me)
{
	return 1;
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
	if( (int)me->query("qi") < 50 )
		return notify_fail("你的体力太差了，不能练华山身法。\n");

	me->receive_damage("qi", 40);
	return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【华山身法】" ZJBR NOR;
    msg += "华山派的基础轻功身法，以轻盈灵活著称，讲究借力打力，动作飘逸潇洒。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  无特殊要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  轻功（dodge）。" ZJBR;
    msg += "  移动（move）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "40" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  暂无。" ZJBR;

    return msg;
}
