inherit SKILL;

mapping *action = ({
([  "action" : "$N剑势如繁星,一招「" HIW "星河璀璨" NOR "」,手中$w化作点点星光刺向$n的$l",
    "force" : 210,
    "attack": 70,
    "dodge" : 75,
    "parry" : 65,
    "damage": 100,
    "lvl"   : 0,
    "skill_name" : "星河璀璨",
    "damage_type" : "刺伤"
]),
([  "action" : "$N使出「" HIC "北斗七星" NOR "」,剑尖划出七道星芒,$w如流星般射向$n",
    "force" : 250,
    "attack": 80,
    "dodge" : 85,
    "parry" : 75,
    "damage": 120,
    "lvl"   : 30,
    "skill_name" : "北斗七星",
    "damage_type" : "刺伤"
]),
([  "action" : "$N一式「" HIY "银河倒挂" NOR "」,$w剑芒暴涨,如银河倒悬,自上而下劈向$n",
    "force" : 290,
    "attack": 90,
    "dodge" : 95,
    "parry" : 85,
    "damage": 140,
    "lvl"   : 60,
    "skill_name" : "银河倒挂",
    "damage_type" : "割伤"
]),
([  "action" : "$N轻吟剑诀,一招「" HIM "紫薇星耀" NOR "」,$w剑光暴涨,如紫薇星光般笼罩$n全身",
    "force" : 330,
    "attack": 100,
    "dodge" : 105,
    "parry" : 95,
    "damage": 160,
    "lvl"   : 90,
    "skill_name" : "紫薇星耀",
    "damage_type" : "刺伤"
]),
});

int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me)
{
    if ((int)me->query("max_neili") < 750)
        return notify_fail("你的内力不够。\n");

    if ((int)me->query_skill("force") < 110)
        return notify_fail("你的内功火候不够。\n");

    if ((int)me->query_skill("sword", 1) < 70)
        return notify_fail("你的基本剑法火候不够。\n");

    if ((int)me->query_skill("sword", 1) < (int)me->query_skill("xinghe_cuican", 1))
        return notify_fail("你的基本剑法水平有限，无法领会更高深的星河璀璨剑法。\n");

    return 1;
}

string query_skill_name(int level)
{
    int i;
    for (i = sizeof(action) - 1; i >= 0; i--)
        if (level >= action[i]["lvl"])
            return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    int i, level;
    level = (int) me->query_skill("xinghe_cuican", 1);
    for (i = sizeof(action); i > 0; i--)
        if (level > action[i-1]["lvl"])
            return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    object weapon;

    if (!objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对。\n");

    if ((int)me->query("qi") < 55)
        return notify_fail("你的体力不够练星河璀璨剑法。\n");

    if ((int)me->query("neili") < 55)
        return notify_fail("你的内力不够练星河璀璨剑法。\n");

    me->receive_damage("qi", 50);
    me->add("neili", -53);
    return 1;
}

string perform_action_file(string action)
{
    return __DIR__"xinghe_cuican/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
    int lvl;
    lvl = me->query_skill("xinghe_cuican", 1);

    if (damage_bonus < 100 || lvl < 100) return 0;

    if (random(lvl) > victim->query_skill("force", 1)/2)
    {
        victim->receive_wound("qi", (damage_bonus - 80) / 3);
        return HIW "$N" HIW "星河璀璨剑法的剑气如繁星般闪烁，$n" HIW "只觉得全身被无数细小的剑气所伤！\n" NOR;
    }
}

string query_description()
{
    string msg;

    msg = HIY "【星河璀璨剑法】" ZJBR NOR;
    msg += "这是一门以星光为主题的高深剑法，讲究剑势如繁星，剑光似银河，招式变幻莫测。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  最大内力：" HIB "750" NOR " 点。" ZJBR;
    msg += "  内功有效激发等级：" HIY "110" NOR " 级。" ZJBR;
    msg += "  基本剑法等级：" HIY "70" NOR " 级。" ZJBR;
    msg += "  基本剑法等级需大于等于星河璀璨剑法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  剑法（sword）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  需装备剑类武器。" ZJBR;
    msg += "  气血：不低于 " HIR "55" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "55" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "53" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // hit_ob, valid_damage, skill_improved etc.
    msg += HIC "  剑气闪烁 (hit_ob)" ZJBR NOR;
    msg += "    触发条件：普通攻击命中，且伤害加成不低于 " HIY "100" NOR " 点，星河璀璨剑法等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "    判定条件：随机(星河璀璨剑法等级) > 目标基本内功等级 / 2。" ZJBR;
    msg += "    效果：对目标造成 (伤害加成 - 80) / 3 的气血伤害。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform/exert
    msg += HIC "  星河倒悬 (xinghe)" ZJBR NOR; // 招式名称
    msg += "    使用要求：" ZJBR; // 招式使用要求
    msg += "      星河璀璨剑法等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      激发剑法为星河璀璨剑法。" ZJBR;
    msg += "      当前内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      装备剑类武器。" ZJBR;
    msg += "      战斗中使用。" ZJBR;
    msg += "    效果描述：" ZJBR; // 招式效果描述
    msg += "      命中判定：比较 (自身剑法有效激发 + 内功有效激发) 与 (目标轻功有效激发 + 招架有效激发)。" ZJBR;
    msg += "      伤害计算：命中后造成伤害，伤害值约为 (自身剑法有效激发 + 内功有效激发) + 随机((自身剑法有效激发 + 内功有效激发) / 2)。" ZJBR; // 公式示例
    msg += "      附加效果：命中时，若 (自身剑法有效激发 + 内功有效激发) / 3 + 随机(自身剑法有效激发 + 内功有效激发) > (目标轻功有效激发 + 招架有效激发)，则使目标忙乱 (自身剑法有效激发 + 内功有效激发) / 200 + 2 秒。" ZJBR; // 特殊机制
    msg += "    消耗与代价：" ZJBR; // 消耗与代价
    msg += "      命中：内力 " HIB "150" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "50" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;

    return msg;
}