// anying-fuxiang.c  暗影浮香

inherit SKILL;

string *dodge_msg = ({
    "$n一个「月上柳梢头」，随着$N的攻势飘起，从容躲过这一招。\n",
    "$n使出一招「大漠孤烟直」，猛然纵起丈余，结果$N扑了个空。\n",
    "$n身形一摇，幻出几个人影，一招「碎影舞斜阳」躲过了$N的攻势。\n",
    "$n一招「燕子三抄水」纵身跃起，倏忽已落至$N身后。\n",
    "$n左一摇，右一晃，一招「云深不知处」已轻松闪过。\n",
    "$n双足一点，斜斜飞起，使出「斜日杏花飞」已闪到$N身侧。\n",
});

int valid_enable(string usage) 
{ 
    return usage == "dodge" || usage == "move";
}

int valid_learn(object me)
  { 
     if (me->query_skill("dodge",1) <= me->query_skill("anying-fuxiang",1) )
	return notify_fail("你的基本轻功基础不够，无法领会更高深的暗影浮香。\n");
    else    return 1;
  }

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 50)
	    return notify_fail("你的体力太差了，不能练暗影浮香。\n");

	if (me->query_skill("anying-fuxiang", 1) < 30)
		me->receive_damage("qi", 10);
	else
	if (me->query_skill("anying-fuxiang", 1) < 50)
		me->receive_damage("qi", 25);
	else
		me->receive_damage("qi", 40);

	return 1;
}

string query_description()
{
    string msg;
    //msg = ZJOBLONG"暗影浮香" ZJBR ;
    msg = "暗影浮香" ZJBR ;
    msg += "  这是一门神秘莫测的轻功身法，据传源自江湖中一位神秘女子所创。"ZJBR;
    msg += "  其特点在于动作轻盈飘逸，如同浮香般难以捉摸，又似暗影般神出鬼没。"ZJBR;
   
    msg += HIY "  学习要求：" NOR ZJBR;
    msg += "  1. 基础轻功等级必须高于暗影浮香等级"ZJBR;

    msg += HIY "  修炼方法：" NOR ZJBR;
    msg += "  1. 每次练习消耗气血，随等级提升消耗量增加："ZJBR;
    msg += "     - 30级以下：每次消耗10点气血"ZJBR;
    msg += "     - 30-49级：每次消耗25点气血"ZJBR;
    msg += "     - 50级及以上：每次消耗40点气血"ZJBR;
    msg += "  2. 练习时需保持至少50点气血"ZJBR;

    msg += HIY "  使用效果：" NOR ZJBR;
    msg += "  1. 可作为dodge（闪避）和move（移动）技能使用"ZJBR;
    msg += "  2. 使用时随机展现六种不同身法招式"ZJBR;
   
    msg += HIY "  招式名称：" NOR ZJBR;
    msg += "  1. 月上柳梢头    2. 大漠孤烟直    3. 碎影舞斜阳"ZJBR;
    msg += "  4. 燕子三抄水    5. 云深不知处    6. 斜日杏花飞"ZJBR;

    msg += HIY "  特殊说明：" NOR ZJBR;
    msg += "  暗影浮香蕴含深奥意境，不仅提升身法灵活性，更能领悟自然与身心和谐之道。"ZJBR;
    msg += "  随修为提升，使用者将如暗影难捉摸，又如浮香飘逸脱俗，战斗中占据极大优势。"ZJBR;

    msg += HIY "  注意事项：" NOR ZJBR;
    msg += "  修炼需极高悟性和持续苦练。初学者进展可能缓慢，但坚持不懈终会有所成就。"ZJBR;
    msg += "  切记不可急于求成，以免走火入魔。\n";
	
	
    
    return msg;
}
