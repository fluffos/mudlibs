// huanmo-longtianwu.c 幻魔胧天舞

inherit SKILL;

mapping *action = ({
([      "action":"$N左掌微分，右手一伸，扣向$n的$l。",
        "force" :10,
        "dodge" :10,
        "damage":20,
        "lvl"   :0,
        "damage_type" :"瘀伤"
]),
([      "action":"$N倏地一个转身，双手一翻，直掼$n下颌。",
        "force" :20,
        "dodge" :15,
        "damage":40,
        "lvl"   :10,
        "damage_type" :"瘀伤"
]),
([      "action":"$N身子一纵，双手滑溜异常对准$n的后心抓去。",
        "force" :35,
        "dodge" :30,
        "damage":50,
        "lvl"   :25,
        "damage_type" :"瘀伤"
]),
([      "action":"$N左手虚晃，右手飘飘，拍向$n$l",
        "force" :50,
        "dodge" :40,
        "damage":60,
        "lvl"   :40,
        "damage_type" :"瘀伤"
]),
([      "action":"$N身形微动，晃至$n身后，双手变爪，直袭$n后脑。",
        "force" :70,
        "dodge" :60,
        "damage":80,
        "lvl"   :60,
        "damage_type" :"瘀伤"
])
});

int valid_enable(string usage) { return usage=="hand" || usage=="parry"; }

int valid_combine(string combo) { return combo=="xuwu-piaomiao"; }

int valid_learn(object me)
{ 
    if (me->query_temp("weapon") || me->query_temp("secondary_weapon")) 
        return notify_fail("练幻魔胧天舞必须空手。\n"); 

    if ((int)me->query_skill("force", 1) < 60)
        return notify_fail("你的内功火候不够，无法学幻魔胧天舞。\n"); 

    if ((int)me->query("max_neili") < 250) 
        return notify_fail("你的内力太弱，无法练幻魔胧天舞。\n"); 

    if ((int)me->query_skill("hand", 1) < (int)me->query_skill("huanmo-longtianwu", 1)) 
        return notify_fail("你的基本手法火候不够，无法领会更高深的幻魔胧天舞。\n"); 

    return 1;
}

mapping query_action(object me, object weapon) 
{ 
    int i, level; 
    level = (int)me->query_skill("huanmo-longtianwu", 1);
    for(i = sizeof(action); i > 0; i--) 
        if(level > action[i-1]["lvl"]) 
             return action[NewRandom(i, 20, level/5)]; 
} 

int practice_skill(object me) 
{ 
    if ((int)me->query("qi") < 45) 
         return notify_fail("你的体力太低了。\n"); 

    if ((int)me->query("neili") < 35) 
         return notify_fail("你的内力不够练「幻魔胧天舞」。\n"); 

    me->receive_damage("qi", 28); 
    me->add("neili", -20); 

    return 1; 
}

/**
 * @brief 查询幻魔胧天舞的详细信息
 * @return string 技能描述信息
 * @details 返回幻魔胧天舞的详细介绍，包括基本介绍、学习要求、激发类型、练习要求和被动效果。
 */
string query_description()
{
    string msg;

    msg = HIY "【幻魔胧天舞】" ZJBR NOR;
    msg += WHT "幻魔胧天舞是一门诡异莫测的手法，以虚实结合，动作飘忽不定著称。" ZJBR;
    msg += "其招式变幻莫测，如梦似幻，令对手难以捉摸。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功等级 " HIY "60" NOR " 级。" ZJBR;
    msg += "  最大内力 " HIB "250" NOR " 点。" ZJBR;
    msg += "  基本手法等级须大于等于幻魔胧天舞等级。" ZJBR;
    msg += "  空手状态。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  手法（hand）。" ZJBR;
    msg += "  招架（parry）。" ZJBR;
    msg += "  可与虚无缥缈互备。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "45" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "35" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "28" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "20" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  暂无特殊招式。" ZJBR ZJBR;

    return msg;
}
