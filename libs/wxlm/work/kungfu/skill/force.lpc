// force.c



inherit SKILL;

int valid_learn(object me) {return 1;}

string exert_function_file(string func)
{
	return "/kungfu/skill/force/" + func;
}

void skill_improved(object me)
{     
	int s;
	s = me->query_skill("force", 1);
    if (s%10==0) 
       {
		tell_object(me, HIW
"由於你的内功修炼有成，你的"+HIY"【后天根骨】"+NOR+"改善了。\n");
	}
}

string query_description()
{
    string msg;

    msg = HIY "【基本内功】" ZJBR NOR;
    msg += WHT "所有内功的基础，练习可提升内力修为和身体根骨。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  无特殊要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功（force）。(通常不直接激发，而是激发具体内功)" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  通常无法直接练习，需练习具体内功。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // skill_improved
    msg += "  每提升 10 级，增加后天根骨。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (通用内功运用 exert)〗" ZJBR NOR; // exert_function_file
    msg += "  疗伤 (heal)：消耗内力恢复气血。" ZJBR;
    msg += "  疗精 (lifeheal)：消耗内力恢复精。" ZJBR;
    msg += "  战气 (inspire)：消耗内力暂时提升战斗力（攻击和防御）。" ZJBR;
    msg += "  驱散 (dispel)：消耗内力尝试解除负面状态。" ZJBR;
    msg += "  再生 (regenerate)：消耗内力恢复气血和精（比 heal/lifeheal 慢但效率可能更高）。" ZJBR;
    msg += "  恢复 (recover)：消耗内力恢复气血（效率通常低于 heal）。" ZJBR ZJBR; // 根据 force/ 目录下文件列出

    return msg;
}
