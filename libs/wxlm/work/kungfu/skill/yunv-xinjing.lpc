// yunv-xinfa.c 玉女心经

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int query_neili_improve(object me)
{
	int lvl;

	lvl = (int)me->query_skill("yunv-xinjing", 1);
	return lvl * lvl * 15 * 15 / 100 / 200;
}

int valid_force(string force)
{
    return (force == "yunv-xinfa");
}

int valid_learn(object me)
{
	if ( me->query("gender") == "无性")
		return notify_fail("你无根无性，阴阳难调，不能修习玉女心经。\n");

	if ((int)me->query_skill("force", 1) < 100)
		return notify_fail("你的基本内功火候还不够。\n");

	if ((int)me->query_skill("yunv-xinfa", 1) < 180)
		return notify_fail("你的玉女心法火候还不够。\n");

	//if ( me->query("gender") == "男性")
	//	return notify_fail("你阳气太盛，恐不能修习玉女心经。\n");

	return ::valid_learn(me);
}

int practice_skill(object me)
{
	return notify_fail("玉女心经只能用学(learn)来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"yunv-xinjing/" + func;
}

string query_description()
{
    string msg;

    msg = HIY "【玉女心经】" ZJBR NOR;
    msg += WHT "玉女心经乃古墓派镇派内功心法，讲究阴阳调和，内外兼修。" ZJBR;
    msg += WHT "修炼此功可大幅提升内力修为。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  性别要求：非 无性。" ZJBR;
    msg += "  基本内功 等级：" HIY "100" NOR " 级。" ZJBR;
    // 注意：此处代码要求为「玉女心法」等级，而非「玉女心经」，可能存在命名不一致。
    msg += "  玉女心法 等级：" HIY "180" NOR " 级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功 (force)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  玉女心经只能通过学习 (learn) 提升，无法练习 (practice)。" ZJBR ZJBR;

    msg += HIY "〖内力提升〗" ZJBR NOR;
    msg += "  提升内力上限效果，具体数值公式请参照游戏内说明或代码实现" ZJBR; // 具体公式 lvl * lvl * 15 * 15 / 100 / 200 较为复杂，暂不直接展示给玩家
    msg += "  (提升值与 基本玉女心经 等级相关)。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  玉女心经 (xinjing)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      基本玉女心经 等级：" HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "      未处于 powerup 状态。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      临时提升后天攻击、后天轻功、后天招架。" ZJBR;
    msg += "      提升数值 = 内功有效激发等级 / 4。" ZJBR;
    msg += "      持续时间 = 内功有效激发等级 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      若在战斗中使用，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;

    return msg;
}
