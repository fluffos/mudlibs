// xiyu-tiezheng.c 西域铁筝音



inherit SKILL;

string type() { return "knowledge"; }

int valid_enable(string usage) { return usage == "guzheng-jifa"; }

int valid_learn(object me)
{
	if (me->query_skill("guzheng-jifa", 1) < 100)
		return notify_fail("你的古筝技法水平不够，还是先练好再说吧！\n");

	if (me->query_skill("guzheng-jifa", 1) < me->query_skill("xiyu-tiezheng", 1))
		return notify_fail("你的古筝技法水平有限，无法领会更精妙的西域铁筝音。\n");

	return 1;
}

int practice_skill(object me)
{
	object ob;

	if (! objectp(ob = me->query_temp("handing")) ||
	    ! ob->valid_as_zheng())
		return notify_fail("不拿出筝来，你怎么练习？\n");

	if ((int)me->query("jing") < 80)
		return notify_fail("你的精神不够好，没法练习了。\n");

	if ((int)me->query("qi") < 30)
		return notify_fail("你现在实在是太疲惫了。\n");

	me->receive_damage("jing", 45);
	me->receive_damage("qi", 20);

	return 1;
}

void do_effect(object me)
{
	object *obs;
	int lvl;
	int i;
	int damage;

	lvl = me->query_skill("guzheng-jifa", 1) / 2 +
	      me->query_skill("xiyu-tiezheng", 1);

	if (environment(me)->query("no_fight") || lvl < 150)
		return;

	lvl = lvl / 5 + me->query_skill("force");
	lvl /= 2;

	// special effort
	obs = all_inventory(environment(me));
	for (i = 0; i < sizeof(obs); i++)
	{
		if (! obs[i]->is_character() || obs[i] == me || ! living(obs[i]))
			continue;

		if (me->query_skill("xiyu-tiezheng") * 2 / 3 <
		    obs[i]->query_skill("xiyu-tiezheng"))
			continue;

		if (lvl + random(lvl) < obs[i]->query_skill("force"))
		{
			tell_object(obs[i], HIM "你听了心中不禁微微一动，发现这曲子颇有奥妙之处。"NOR"\n");
			continue;
		}

		damage = me->query("max_neili") - obs[i]->query("max_neili");
		if (damage < 500)
		{
			tell_object(obs[i], HIB "你忽然觉得一阵难受，连忙运了一口气，才清醒过来。"NOR"\n");
			continue;
		}

		damage /= 10;
		me->want_kill(obs[i]);
		me->fight_ob(obs[i]);
		obs[i]->kill_ob(me);
		obs[i]->receive_damage("jing", damage, me);
		obs[i]->receive_wound("jing", damage / 3, me);
		
		tell_object(obs[i], HIB "你听了这阵鬼哭狼嚎的声音，不由得心浮气躁..."NOR"\n");
	}
}

string query_description()
{
    string msg;

    msg = HIY "【西域铁筝音】" ZJBR NOR;
    msg += "一门奇特的武学，可通过弹奏铁筝发出音律伤敌心神。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本古筝技法 等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "  基本古筝技法 等级不低于 西域铁筝音 等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  古筝技法 (guzheng-jifa)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  需手持古筝类物品进行练习。" ZJBR;
    msg += "  精力：不低于 " HIG "80" NOR " 点。" ZJBR;
    msg += "  气血：不低于 " HIR "30" NOR " 点。" ZJBR;
    msg += "  每次练习消耗精力：" HIG "45" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "20" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += HIC "  铁筝魔音 (持续效果)" ZJBR NOR;
    msg += "    触发条件：" ZJBR;
    msg += "      西域铁筝音总有效等级 (基本古筝技法 / 2 + 西域铁筝音) 不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      不在安全区 (`no_fight`) 环境。" ZJBR;
    msg += "    效果范围：" ZJBR;
    msg += "      周围环境内所有非自身的生物。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      持续弹奏时自动以内力催动魔音攻击范围内的目标。" ZJBR;
    msg += "      " HIW "抵抗判定1 (技能抵抗)" NOR "：若目标的 西域铁筝音 等级 > 施展者 西域铁筝音 等级 * 2 / 3，则完全免疫。" ZJBR;
    msg += "      " HIW "抵抗判定2 (内力抵抗)" NOR "：计算施展者的有效攻击等级 " HIC "AP = ((基本古筝技法 / 2 + 西域铁筝音) / 5 + 内功有效激发) / 2" NOR "。若目标的 内功有效激发 等级 > (AP + 随机(AP))，则可运功抵抗，不受伤害。" ZJBR;
    msg += "      " HIW "抵抗判定3 (内力差抵抗)" NOR "：若施展者 最大内力 - 目标 最大内力 <= 500，则目标可运功抵抗，不受伤害。" ZJBR;
    msg += "      " HIR "精神伤害" NOR "：若目标未能通过以上抵抗判定，则受到精神伤害与精神创伤。" ZJBR;
    msg += "        伤害值 = (施展者 最大内力 - 目标 最大内力) / 10" ZJBR;
    msg += "        创伤值 = 伤害值 / 3" ZJBR;
    msg += "      强制战斗：对成功造成伤害的目标自动触发战斗状态。" ZJBR ZJBR;


    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR;

    return msg;
}