// zhange.c 肝胆战歌



inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

/**
 * @brief 查询招式名称
 * @return string 招式名称
 */
string query_name() { return HIR "肝胆" HIY "战歌" NOR; }

/**
 * @brief 查询招式类型
 * @return string* 招式类型数组
 */
string *pfm_type() { return ({ "force", }); }

/**
 * @brief 执行肝胆战歌招式
 * @param object me 施展者
 * @param object target 目标
 * @return int 成功返回1，失败返回0
 * @details 运用肝胆琴心内功，奏响激昂战歌，全面提升战斗能力
 */
int exert(object me, object target)
{
	int skill;
	int combat_bonus;

	if (target != me)
		return notify_fail("你只能用肝胆战歌来提升自己的战斗力。\n");

	if ((int)me->query_skill("gandanqinxin", 1) < 100)
		return notify_fail("你的肝胆琴心不够深厚，不能使用肝胆战歌。\n");

	if ((int)me->query("neili") < 200)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_temp("powerup"))
		return notify_fail("你已经在运行肝胆战歌中了。\n");
	
	skill = me->query_skill("force");
	combat_bonus = skill * 2 / 5;

	me->add("neili", -150);
	message_combatd(HIR "$N" HIR "深吸一口气，开始弹奏激昂的战歌，"
			"琴音如雷鸣般响彻四方，战意冲天！" NOR "\n", me);
	
	me->add_temp("apply/attack", combat_bonus);
	me->add_temp("apply/dodge", combat_bonus);
	me->add_temp("apply/parry", combat_bonus);
	me->set_temp("powerup", 1);

	me->start_call_out((:call_other, __FILE__, "remove_effect", me, combat_bonus :), skill);
	if (me->is_fighting()) me->start_busy(3);
	return 1;
}

/**
 * @brief 移除肝胆战歌效果
 * @param object me 施展者
 * @param int amount 战斗加成数值
 * @details 肝胆战歌效果结束时调用
 */
void remove_effect(object me, int amount)
{
	if (me->query_temp("powerup"))
	{
		me->add_temp("apply/attack", -amount);
		me->add_temp("apply/dodge", -amount);
		me->add_temp("apply/parry", -amount);
		me->delete_temp("powerup");
		tell_object(me, "你的肝胆战歌演奏完毕，激昂的琴音渐渐平息。\n");
	}
}

/**
 * @brief 显示帮助信息
 * @param object me 查看帮助的玩家
 * @return int 总是返回1
 */
int help(object me)
{
	write(@HELP
肝胆战歌：

运用肝胆琴心内功，奏响激昂的战歌，激发内在潜能，
全面提升攻击、闪避和招架能力。需要肝胆琴心100级以上。

指令格式：exert zhange

HELP
	);
	return 1;
}