// qinxin.c 肝胆琴心护体



inherit F_CLEAN_UP;

void remove_effect(object me, int a_amount);

/**
 * @brief 查询招式名称
 * @return string 招式名称
 */
string query_name() { return HIB "琴心" ZJBR "护体" NOR; }

/**
 * @brief 查询招式类型
 * @return string* 招式类型数组
 */
string *pfm_type() { return ({ "force", }); }

/**
 * @brief 执行琴心护体招式
 * @param object me 施展者
 * @param object target 目标
 * @return int 成功返回1，失败返回0
 * @details 运用肝胆琴心内功，以琴音护体，提升防御力
 */
int exert(object me, object target)
{
	int skill;
	int yijing_level;
	int armor_bonus;
	string msg;

	if ((int)me->query_skill("gandanqinxin", 1) < 80)
		return notify_fail("你的肝胆琴心不够深厚，不能使用琴心护体。\n");

	if ((int)me->query("neili") < 150) 
		return notify_fail("你现在的真气不够。\n");

	if ((int)me->query_temp("shield"))
		return notify_fail("你已经在运行琴心护体中了。\n");

	// 获取意境等级
	yijing_level = me->query("skill_aoyi/有我神像");
	
	skill = me->query_skill("force");
	armor_bonus = skill / 2;
	
	// 根据意境等级增加护体效果
	if (yijing_level)
	{
		armor_bonus += armor_bonus * yijing_level * 8 / 100; // 每级意境增加8%
	}

	msg = HIB "$N" HIB "轻抚无形琴弦，悠扬的琴音在周身环绕，"
	      "形成一层淡蓝色的音波护罩。" NOR "\n";
	message_combatd(msg, me);

	me->add_temp("apply/armor", armor_bonus);
	me->set_temp("shield", 1);

	me->start_call_out((: call_other, __FILE__, "remove_effect", me, armor_bonus :), skill);

	me->add("neili", -120);
	if (me->is_fighting()) me->start_busy(2);

	return 1;
}

/**
 * @brief 移除琴心护体效果
 * @param object me 施展者
 * @param int amount 护甲加成数值
 * @details 琴心护体效果结束时调用
 */
void remove_effect(object me, int amount)
{
	if (me->query_temp("shield"))
	{
		me->add_temp("apply/armor", -amount);
		me->delete_temp("shield");
		tell_object(me, "你的琴心护体运转完毕，音波护罩渐渐消散。\n");
	}
}

/**
 * @brief 显示帮助信息
 * @param object me 查看帮助的玩家
 * @return int 总是返回1
 */
int help(object me)
{
	write(@HELP
琴心护体：

运用肝胆琴心内功，以琴音护体，在身周形成音波护罩，
大幅提升防御力。需要肝胆琴心80级以上。

指令格式：exert qinxin

HELP
	);
	return 1;
}