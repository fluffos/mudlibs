// /kungfu/skill/gandanqinxin/guanglangsan.c



inherit F_CLEAN_UP;

string query_name() { return HIR "广" HIG "陵" HIY "散" NOR; }

void remove_effect(object me, int amount);

int exert(object me, object target)
{
    int skill;
    int yijing_level;
    int bonus;

    // 获取意境等级
    yijing_level = me->query("skill_aoyi/有我神像");

    if (target != me)
        return notify_fail("你只能用" + query_name() + "来提升自己的元素伤害。\n");

    if ((int)me->query("neili") < 100)
        return notify_fail("你的内力不够。\n");

    if ((int)me->query_temp("guanglangsan"))
        return notify_fail("你已经在运行" + query_name() + "中了。\n");

    skill = me->query_skill("force");
    me->add("neili", -100);
    me->receive_damage("qi", 0);

    // 计算基础伤害加成
    bonus = skill / 3;

    // 根据意境等级增加伤害加成
    if (yijing_level)
    {
        bonus += bonus * yijing_level * 10 / 100; // 每级意境增加10%
    }

    message_vision(
        HIY "$N深吸一口气，双手轻抚琴弦，开始弹奏" + query_name() + "，周身泛起淡淡的金光。\n" NOR, me);

    me->add_temp("apply/damage", bonus);
    me->set_temp("guanglangsan", 1);

    me->start_call_out((:call_other, __FILE__, "remove_effect", me, bonus:), skill);

    if (me->is_fighting()) me->start_busy(2);

    return 1;
}

void remove_effect(object me, int amount)
{
    if (me->query_temp("guanglangsan"))
    {
        me->add_temp("apply/damage", -amount);
        me->delete_temp("guanglangsan");
        tell_object(me, "你的" + query_name() + "运行完毕，周身金光渐渐消散。\n");
    }
}

int help(object me)
{
    write(@HELP
本功能用来提高自己的元素伤害。

指令格式：exert guanglangsan
HELP
    );
    return 1;
}