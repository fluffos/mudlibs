// bahuang-gong.c 九天十地唯我至尊功

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_force(string force) { return force == "lingjiu-xinfa"; }

int query_neili_improve(object me)
{
    int lvl;
    int improve;

    lvl = me->query_skill("bahuang-gong", 1);
    improve = lvl * lvl * 15 * 15 / 100 / 200;

    return improve;
}

int valid_learn(object me)
{
	if ((int)me->query_skill("force", 1) < 80)
		return notify_fail("你的基本内功火候还不够。\n");

	// 若为灵鹫宫弟子，允许无性别限制学习更高等级
	if (me->query("family/family_name") != "灵鹫宫")
	{
		if (me->query("gender") == "无性" &&
		(int)me->query_skill("bahuang-gong", 1) > 49)
			return notify_fail("你无根无性，难以领会高深的八荒功。\n");
	}

    	return ::valid_learn(me);
}

int practice_skill(object me)
{
	return notify_fail("九天十地唯我至尊功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"bahuang-gong/" + func;
}


string query_description()
{
    string msg;

    msg = "";
    msg += HIY "【九天十地唯我至尊功】" ZJBR ZJBR NOR;
    msg += WHT "九天十地唯我至尊功乃是一门霸道绝伦的内功心法，传说源自上古时期的" ZJBR;
    msg += "绝世高人。此功法以刚猛霸道著称，修炼者需要极强的意志力和坚韧不拔的毅" ZJBR;
    msg += "力方能有所成就。" ZJBR ZJBR;
    msg += HIY "【技能要求】" ZJBR NOR;
    msg += "  基本内功等级：80级" ZJBR;
    msg += "  无性者（无性别）最多只能学到49级（灵鹫宫弟子除外）" ZJBR ZJBR;
    msg += HIY "【技能效果】" ZJBR NOR;
    msg += "  根据技能等级提升内力上限，等级越高，提升幅度越大。" ZJBR;
    msg += "  可激发为内功（force）" ZJBR;
    msg += "  可与灵鹫心法（lingjiu-xinfa）互备" ZJBR ZJBR;
    msg += HIY "【特殊招式】" ZJBR NOR;
    msg += HIW "1. 八荒战气（powerup）：" ZJBR NOR;
    msg += "  要求：无特殊要求" ZJBR;
    msg += "  内力消耗：100点" ZJBR;
    msg += "  效果持续时间：等同于内功等级的秒数" ZJBR;
    msg += "  效果：" ZJBR;
    msg += "    - 提升攻击力：内功等级 / 3" ZJBR;
    msg += "    - 提升防御力：内功等级 / 3" ZJBR;
    msg += "    - 提升有效轻功：内功等级 / 3" ZJBR;
    msg += "    - 提升有效招架：内功等级 / 3" ZJBR;
    msg += "    - 提升武器伤害：内功等级 / 6" ZJBR;
    msg += "    - 提升空手伤害：内功等级 / 6" ZJBR;
    msg += "  使用限制：战斗中使用会有2秒的忙乱（busy）时间" ZJBR ZJBR;
    msg += HIW "2. 八荒护体（shield）：" ZJBR NOR;
    msg += "  要求：九天十地唯我至尊功等级 50 级" ZJBR;
    msg += "  内力消耗：100点" ZJBR;
    msg += "  效果持续时间：等同于内功等级的秒数" ZJBR;
    msg += "  效果：" ZJBR;
    msg += "    - 提升防御力：内功等级 / 2" ZJBR;
    msg += "  使用限制：战斗中使用会有2秒的忙乱（busy）时间" ZJBR ZJBR;
    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 此功法只能通过学习（learn）来提升熟练度，无法通过练习（practice）来增加。" ZJBR;
    msg += "2. 使用招式时会消耗一定的内力，请务必注意自身状态。" ZJBR;
    msg += "3. 在战斗中灵活运用战气提升和护体神功，可以极大地增强自身实力。\n";

    return msg;
}
