// riyue-guanghua.c 日月光华
// By haiyan

#include <combat.h> 
inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_force(string force)
{
        return 1;
        return force == "riyue-xinfa" || force == "pixie-jian";
}

int query_neili_improve(object me)
{
    int lvl;
    lvl = (int)me->query_skill("riyue-guanghua", 1);
    return lvl * lvl * 22 * 15 / 100 / 200;
}

int valid_learn(object me)
{
    if ( (string)me->query("gender") == "男性" &&
         (int)me->query_skill("riyue-guanghua", 1) > 49 )
            return notify_fail("你六根未净，难以领会更高深的「日月光华」。\n");

    if ( me->query("gender") == "女性" )
            return notify_fail("你无法领会「日月光华」这门绝学。\n");

    if ((string)me->query("character") == "光明磊落")
            return notify_fail("你心中暗想：我为人光明磊落，这种邪教功夫学来做甚。\n");

    if ( (int)me->query_skill("xixing-dafa", 1) > 0 )
            return notify_fail("你已学了吸功大法，不能修炼日月光华。\n");

    if (me->query("dex") < 25)
            return notify_fail("你的身手不够灵活，无法领会日月光华的秘要。\n");

    if ((int)me->query_skill("riyue-xinfa", 1) < 100)
            return notify_fail("你的日月心法火候还不够，难以领会日月光华。\n");

    if ((int)me->query_skill("force", 1) < (int)me->query_skill("riyue-guanghua", 1))
            return notify_fail("你的基本内功水平有限，不能领会更高深的日月光华。\n");

    return ::valid_learn(me);
}

int practice_skill(object me)
{
    return notify_fail("日月光华只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
    mapping sk;
    string *skname;
    int i, k=0;

    if (mapp(this_player()->query("tianmo_jieti")))
        return __DIR__"riyue-guanghua/" + func;

    sk=this_player()->query_skills();
    skname=sort_array( keys(sk), (: strcmp :) );

    for(i=0; i < sizeof(sk); i++)
    {
        if (SKILL_D(skname[i])->valid_enable("force"))  k++;
    }

    if ( k >=4 )
    {
        tell_object(this_player(), "你体内不同内力互相冲撞，难以施展日月光华。\n");
        return 0;
    }

    return __DIR__"riyue-guanghua/" + func;
}

string query_description()
{
    string msg;
    int lvl = this_player() ? (int)this_player()->query_skill("riyue-guanghua", 1) : 0;
    int neili_improve = lvl * lvl * 22 * 15 / 100 / 200;

    msg = HIY "【日月光华】" ZJBR ZJBR NOR;
    msg += WHT "日月光华是日月神教的独门内功心法，以其刚柔并济、阴阳调和的特点著称。此功法讲究吸纳天地日月之精华，练至高深处可吞吐日月之光。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  性别要求：非女性；男性等级超过 49 级需已自宫。" ZJBR;
    msg += "  性格要求：不能是 光明磊落。" ZJBR;
    msg += "  后天身法 (" HIW "dex" NOR ") 不低于 " HIG "25" NOR " 点。" ZJBR;
    msg += "  日月心法 (" HIW "riyue-xinfa" NOR ") 等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "  基本内功 (" HIW "force" NOR ") 等级不低于日月光华等级。" ZJBR;
    msg += "  前置冲突：不能学习 吸星大法 (" HIW "xixing-dafa" NOR ")。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功 (force)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  日月光华只能通过学习 (learn) 来提升等级。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  提升最大内力上限：每级提升 " HIB + neili_improve + NOR " 点 (基于公式：等级 * 等级 * 22 * 15 / 100 / 200)。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  当前版本暂无特殊内功运用 (exert)。" ZJBR;
    msg += "  (注意：若同时激发超过 4 门内功类武学，可能导致内力冲突而无法施展本门内功)。" ZJBR ZJBR;

    msg += HIY "〖其他信息〗" ZJBR NOR;
    msg += "  可作为 辟邪剑法 (pixie-jian) 的基础内功。" ZJBR;
    msg += "  此功法威力强大，但也容易引起正派人士的敌视。" ZJBR;

    return msg;
}
