// yinyangjiaorang.c 阴阳交融
// 我自逍遥决第二绝技 - 控制型攻击

#include <combat.h>

/**
 * @brief 绝技名称显示
 * @return string 带颜色的绝技名称
 */
string name() { return HIC "阴阳交融" NOR; }

/**
 * @brief 绝技名称查询
 * @return string 绝技名称
 */
string query_name() { return "阴阳交融"; }

/**
 * @brief 绝技激发类型
 * @return string* 激发类型数组
 */
string *pfm_type() { return ({ "strike", "hand" }); }

inherit F_SSERVER;

/**
 * @brief 绝技执行函数
 * @param object me 施招者
 * @param object target 目标
 * @return int 1成功，0失败
 * @details 控制型绝技，兼具伤害和控制效果
 */
int perform(object me, object target)
{
	int damage, ap, dp, busy_time;
	int aoyi_lingjiu, aoyi_ziyou;
	string msg;

	// 选择目标
	if (! target)
	{
		me->clean_up_enemy();
		target = me->select_opponent();
	}
	if (! target || ! me->is_fighting(target))
		return notify_fail(name() + "只能对战斗中的对手使用。\n");

	// 检查武器状态
	if( query_temp("weapon", me) || query_temp("secondary_weapon", me) )
		return notify_fail(name() + "只能空手施展。\n");

	// 检查技能等级
	if ((int)me->query_skill("tianshan-yinyang", 1) < 150)
		return notify_fail("你的我自逍遥决不够娴熟，难以施展" + name() + "。\n");

	// 检查基本内功等级
	if ((int)me->query_skill("force", 1) < 150)
		return notify_fail("你的内功修为不足，难以施展" + name() + "。\n");

	// 检查内力
	if( query("neili", me) < 300 )
		return notify_fail("你现在真气不足，难以施展" + name() + "。\n");

	// 检查目标状态
	if (! living(target))
		return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

	// 获取意境等级
	aoyi_lingjiu = COMBAT_D->get_skill_aoyi_level(me, "灵鹫飞羽");
	aoyi_ziyou = COMBAT_D->get_skill_aoyi_level(me, "自由自在");

	// 施招消息
	msg = HIC "$N" HIC "神色凝重，运起我自逍遥决心法，左掌阳刚如烈日，右手阴柔似流水，\n"
	      HIC "「阴阳交融」刚柔并济，阴阳互补，一招蕴含天地造化之妙！" NOR "\n";

	// 消耗内力
	addn("neili", -300, me);

	// 计算攻击力 - 刚柔并济，攻守兼备
	ap = me->query_skill("tianshan-yinyang", 1) + me->query_skill("force");
	dp = target->query_skill("dodge") + target->query_skill("force") / 2;

	// 意境加成攻击力
	if (aoyi_lingjiu > 0)
		ap += aoyi_lingjiu * 4;

	// PVE加成
	if (!playerp(target))
		ap = ap * 6 / 5;

	// 控制判定
	if (COMBAT_D->hit_determination(me, target, ap, dp))
	{
		// 基础伤害计算 - 大幅提升基础威力
		damage = me->query_skill("tianshan-yinyang", 1) * 6;  
		damage += me->query_skill("strike") * 3 + me->query_skill("hand") * 3;  
		damage += me->query("jiali") * 2; 

		// 控制时间计算 - 体现刚柔并济的控制特色
		busy_time = me->query_skill("tianshan-yinyang", 1) / 40 + 2;
		if (busy_time > 6) busy_time = 6;

		// 意境加成（大幅降低依赖）
		if (aoyi_lingjiu > 0)
		{
			damage += damage / 25 * aoyi_lingjiu;
			busy_time += aoyi_lingjiu / 12; 
			if (busy_time > 8) busy_time = 8;
			msg += HIW "$N" HIW "灵鹫飞羽意境加持，身形飘逸，攻势如行云流水！" NOR "\n";
		}

		if (aoyi_ziyou > 0)
		{
			damage += damage / 30 * aoyi_ziyou; 
			busy_time += aoyi_ziyou / 15;
			if (busy_time > 7) busy_time = 7;
			msg += HIB "$N" HIB "自由自在意境显现，招式自然天成，控制之妙登峰造极！" NOR "\n";
		}

		// 应用伤害
		msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 175,
		                          HIY "$n" HIY "被阴阳交融的劲力所伤，刚猛与阴柔同时作用，"
		                          HIY "身体一时难以适应！\n" NOR ":瘀伤@?");

		// 控制效果 - 阴阳交融的独特控制
		if (!target->is_busy() && random(2))
		{
			target->start_busy(busy_time);
			msg += HIR "$n" HIR "被阴阳二气缠绕，真气逆转，动弹不得！" NOR "\n";
		}

		// 成功施招忙乱
		me->start_busy(2);
	}
	else
	{
		// 未命中
		msg += CYN "$n" CYN "凭借敏捷的身手避开了$N" CYN "这招阴阳交融的控制。" NOR "\n";
		me->start_busy(3);
	}

	message_vision(msg, me, target);
	return 1;
}