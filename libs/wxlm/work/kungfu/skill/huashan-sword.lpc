int valid_learn(object me)
{
	object ob;
	
	if ((int)me->query("max_neili") < 100)
		return notify_fail("你的内力不够，没有办法练华山剑法。\n");
	
	if (! (ob = me->query_temp("weapon"))
	||  (string)ob->query("skill_type") != "sword" )
		return notify_fail("你必须先找一把剑才能学习剑法。\n");
	
	if (me->query_skill("sword", 1) < me->query_skill("huashan-sword", 1))
		return notify_fail("你的基本剑法火候有限，无法领会更高深的华山剑法。\n");
	
	return 1;
}

int valid_enable(string usage)
{
	return usage=="sword" || usage=="parry";
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action)-1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("huashan-sword", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    if ((int)me->query("qi") < 60)
	return notify_fail("你的体力太低，没有办法练习华山剑法。\n");
		
    if ((int)me->query("neili") < 40)
	return notify_fail("你的内力不够，没有办法练习华山剑法。\n");

    me->receive_damage("qi", 50);
    me->add("neili", -31);
    return 1;
}

int valid_effect(object me, object weapon, string name, int skill)
{
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	int lvl;
	int i;

	lvl = me->query_skill("martial-cognize", 1);
	i = random(lvl);

	if (me->query("family/family_name") == "华山剑宗" &&
	    i > 30 && random(2) == 0)
	{
		if (i < 80)
		{
			victim->receive_wound("qi", damage_bonus / 7);
			return HIG "只见$N" HIG "内劲吞吐，剑气直逼$n" HIG
			       "而去！"NOR"\n";
		}
		if (i < 160)
		{
			victim->receive_wound("qi", damage_bonus / 5);
			return HIM "但见$N" HIM "面上紫气大盛，全身劲气贯于"
			       "剑中，剑气源源不断扑向$n" HIM "！"NOR"\n";
		} else
		{
			victim->receive_wound("qi", damage_bonus / 2);
			return HIW "$N" HIW "默运内功，手中长剑暗含紫芒攻向"
			       "$n" HIW "！"NOR"\n";
		}
	}
}

string perform_action_file(string action)
{
	return __DIR__"huashan-sword/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【华山剑法】" ZJBR NOR;
    msg += "华山派的镇派剑法，以轻灵飘逸、变化多端著称，讲究以快打慢，以巧破力。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力需达到 " HIY "100" NOR " 点。" ZJBR;
    msg += "  必须持有剑类武器。" ZJBR;
    msg += "  基本剑法等级不可低于华山剑法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  剑法（sword）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "60" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "40" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "31" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  华山剑宗弟子命中时特效：" ZJBR;
    msg += "    当武学修养等级（martial-cognize）较高（随机值大于30）时，有50%几率触发。" ZJBR;
    msg += "    根据武学修养等级，对目标造成额外的气血伤害（伤害加值的 1/7 到 1/2 不等）。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;

    msg += HIC "  天外飞龙 (feilong)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      华山剑法等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "400" NOR " 点。" ZJBR;
    msg += "      必须持有剑类武器。" ZJBR;
    msg += "      激发剑法为华山剑法。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      掷出武器攻击目标。" ZJBR;
    msg += "      命中判定：自身剑法等级大于目标轻功等级的1.5倍，且（自身剑法等级/2 + 随机（自身剑法等级））大于目标轻功等级。" ZJBR;
    msg += "      命中后造成巨大伤害，伤害值约为（自身最大气血 / 4 + 自身剑法等级）+ 随机（（自身最大气血 / 4 + 自身剑法等级）/ 4）。" ZJBR;
    msg += "      命中后附加 50% 的额外伤害效果。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "400" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "3" NOR " 秒。" ZJBR;
    msg += "      使用后失去武器。" ZJBR ZJBR;

    msg += HIC "  截手式 (jie)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      华山剑法等级 " HIY "60" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "80" NOR " 点。" ZJBR;
    msg += "      必须持有剑类武器。" ZJBR;
    msg += "      目标不处于忙乱状态。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：随机（自身华山剑法等级）大于（目标招架等级 / 2）。" ZJBR;
    msg += "      命中后使目标陷入忙乱状态。" ZJBR;
    msg += "      忙乱时间约为 (自身华山剑法等级 / 22) + 2 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "50" NOR " 点。" ZJBR;
    msg += "      命中：目标忙乱，自身无忙乱。" ZJBR;
    msg += "      未命中：自身忙乱 " HIR "1" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  剑掌连环 (jianzhang)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      华山剑法等级 " HIY "50" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      必须持有剑类武器。" ZJBR;
    msg += "      激发剑法为华山剑法。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      临时提升攻击力（提升值为 激发剑法等级 / 10）。" ZJBR;
    msg += "      对目标连续发动数次攻击（次数取决于COMBAT_D->query_base_attack_number函数）。" ZJBR;
    msg += "      每次攻击独立判定命中和伤害。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      自身忙乱 1 + 随机(5) 秒。" ZJBR ZJBR;

    msg += HIC "  三仙夺命 (sanxian)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      华山剑法等级 " HIY "135" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      必须持有剑类武器。" ZJBR;
    msg += "      激发剑法为华山剑法。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      连续发动三招强力攻击。" ZJBR;
    msg += "      第一击命中判定：(自身激发剑法等级 / 2 + 随机(自身激发剑法等级)) 是否小于 目标轻功等级 + 目标武学修养等级。" ZJBR;
    msg += "      第二击命中判定：(自身激发剑法等级 / 2 + 随机(自身激发剑法等级)) 是否小于 目标招架等级 + 目标武学修养等级。" ZJBR;
    msg += "      第三击命中判定：(自身激发剑法等级 / 2 + 随机(自身激发剑法等级)) 是否小于 目标招架等级 + 目标武学修养等级。" ZJBR;
    msg += "      第一击伤害：自身激发剑法等级 / 2 + 随机(自身激发剑法等级 / 2)，附加 40% 额外伤害效果。" ZJBR;
    msg += "      第二击伤害：自身激发剑法等级 + 随机(自身激发剑法等级 / 2)，附加 55% 额外伤害效果。" ZJBR;
    msg += "      第三击伤害：自身激发剑法等级 + 随机(自身激发剑法等级 / 2)，附加 66% 额外伤害效果。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "3" NOR " 秒。" ZJBR;

    return msg;
}