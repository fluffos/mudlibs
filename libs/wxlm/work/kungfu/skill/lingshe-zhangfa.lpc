string query_skill_name(int level)
{
	return action[random(sizeof(action))]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int valid_enable(string usage) { return (usage == "staff") || (usage == "parry"); }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 1000)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("force") < 150)
		return notify_fail("你的内功火候不够。\n");

	if ((int)me->query_skill("staff", 1) < 100)
		return notify_fail("你的基本杖法还不到家，不能学习灵蛇杖法。\n");

	if ((int)me->query_skill("staff", 1) < me->query_skill("lingshe-zhangfa", 1))
		return notify_fail("你的基本杖法水平不够，无法领会更高深的灵蛇杖法。\n");

	return 1;
}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "staff")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力不够练灵蛇杖法。\n");

	if ((int)me->query("neili") < 80)
		return notify_fail("你的内力不够练灵蛇杖法。\n");

	me->receive_damage("qi", 60);
	me->add("neili", -69);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"lingshe-zhangfa/" + action;
}
string query_description()
{
    string msg;

    msg = HIY "【灵蛇杖法】" ZJBR NOR;
    msg += WHT "西域白驼山嫡传杖法，招式诡异，杖法灵动如蛇，变化多端，令人难以捉摸。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  最大内力 (`max_neili`) 不低于 " HIB "1000" NOR " 点。" ZJBR;
    msg += "  基本内功 (`force`) 等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "  基本杖法 (`staff`) 等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "  基本杖法 (`staff`) 等级需高于或等于灵蛇杖法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  杖法 (`staff`)。" ZJBR;
    msg += "  招架 (`parry`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  必须装备杖类武器。" ZJBR;
    msg += "  气血 (`qi`) 不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力 (`neili`) 不低于 " HIB "80" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血 " HIR "60" NOR " 点，内力 " HIB "69" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // hit_ob, valid_damage, etc.
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (Perform)〗" ZJBR NOR; // perform_action_file

    msg += HIC "  灵蛇缠身 (chan)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      基本内功 (`force`) 等级不低于 " HIY "80" NOR " 级。" ZJBR;
    msg += "      基本杖法 (`staff`) 等级不低于 " HIY "80" NOR " 级。" ZJBR;
    msg += "      必须装备杖类武器。" ZJBR;
    msg += "      只能对战斗中且未忙乱的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：基于 自身基本杖法等级 与 目标基本轻功等级 (`dodge`) 进行判定 (`COMBAT_D->hit_determination()`)。" ZJBR;
    msg += "      命中效果：使目标忙乱 (`busy`)，持续时间约为 (基本杖法等级 / 45 + 2) 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      未命中：自身忙乱 (`busy`) " HIR "2" NOR " 秒。" ZJBR;
    msg += "      (注意：此招式不消耗内力或精力)" ZJBR ZJBR;

    msg += HIC "  横行无忌 (wuji)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      基本内功 (`force`) 等级不低于 " HIY "200" NOR " 级。" ZJBR;
    msg += "      灵蛇杖法等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力 (`neili`) 不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "      必须装备杖类武器且激发为灵蛇杖法。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：基于 自身基本杖法等级 与 目标招架等级 (`parry`) 进行判定 (`COMBAT_D->hit_determination()`)。" ZJBR;
    msg += "      命中效果：对目标造成兵器伤害，伤害值约为 (基本杖法等级 + 随机(基本杖法等级))，并附加固定伤害 55 点。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      未命中：消耗内力 " HIB "80" NOR " 点。" ZJBR;
    msg += "      自身忙乱 (`busy`) " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  千蛇出动 (qianshe)" ZJBR NOR; // 使用 query_name
    msg += "    使用要求：" ZJBR;
    msg += "      基本内功 (`force`) 等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      灵蛇杖法等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 (`neili`) 不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "      必须装备杖类武器且激发为灵蛇杖法。" ZJBR;
    msg += "      (可能需要特殊条件解锁: `can_perform/lingshe-zhangfa/qianshe`)" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      发动连续攻击，攻击次数等于 `COMBAT_D->query_base_attack_number(me,query_name())` 返回的基础攻击次数。" ZJBR;
    msg += "      发动前进行一次判定（(灵蛇杖法等级/2 + 随机(灵蛇杖法等级)) 对比 (目标招架等级*2/3)），成功则在连击期间临时增加自身攻击力 (`apply/attack`)，数值为 (灵蛇杖法等级 / 6)。" ZJBR;
    msg += "      连击中每次攻击有 50% 几率使未忙乱的目标忙乱 (`busy`) 1 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      自身忙乱 (`busy`) 1 到 5 秒 (1 + random(5))。" ZJBR ZJBR;

    msg += HIC "  千蛇万噬 (wanshi)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      灵蛇杖法等级不低于 " HIY "160" NOR " 级。" ZJBR;
    msg += "      当前内力 (`neili`) 不低于 " HIB "400" NOR " 点。" ZJBR;
    msg += "      必须装备杖类武器且激发为灵蛇杖法。" ZJBR;
    msg += "      (可能需要特殊条件解锁: `can_perform/lingshe-zhangfa/wanshi`)" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：基于 自身基本杖法等级 与 目标招架等级 (`parry`) 进行判定 ((自身杖法等级/3 + 随机(自身杖法等级)) 对比 目标招架等级)。对正派目标命中率有加成。" ZJBR;
    msg += "      命中效果：" ZJBR;
    msg += "        - 对目标造成兵器伤害，伤害值约为 (基本杖法等级 + 随机(基本杖法等级 / 5))，并附加固定伤害 50 点。" ZJBR;
    msg += "        - 对目标造成额外精神伤害 (`jing`)，数值约为 (造成伤害 / 4)，并造成精神损伤 (`jing_wound`)，数值约为 (造成伤害 / 8)。" ZJBR;
    msg += "        - 若使用特定武器「灵蛇杖」(`/clone/weapon/lingshe`) 且该武器具有毒素 (`du` > 0)，则对目标附加蛇毒状态 (`snake_poison`)，强度约为 (基本杖法等级 / 2)，并消耗武器 1 点毒素。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 " HIB "350" NOR " 点。" ZJBR;
    msg += "      未命中：消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      自身忙乱 (`busy`) 2 到 7 秒 (2 + random(6))。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 「灵蛇缠身」只对未忙乱的敌人有效，且不消耗内力。" ZJBR;
    msg += "2. 「横行无忌」、「千蛇出动」、「千蛇万噬」均为战斗专用招式，使用后会使自身忙乱。" ZJBR;
    msg += "3. 「千蛇出动」和「千蛇万噬」可能需要通过特定方式解锁才能使用。" ZJBR;
    msg += "4. 「千蛇万噬」的附加蛇毒效果需要持有特定武器「灵蛇杖」且该杖有毒素。" ZJBR;

    return msg;
}