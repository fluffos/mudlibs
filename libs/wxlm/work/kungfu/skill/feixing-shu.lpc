// feixing-shu.c 飞星术


inherit SKILL;

string *dodge_msg = ({
	"$n左一点右一晃，随即回到原地，轻巧地躲过了$N这一招。\n",
	"$n腾身跃起一个空翻，并顺势闪到一边。\n",
	"$n轻轻往旁边一纵，就已离$N有了相当的距离，$N这一招自然失效。\n",
	"$n揉身而上，轻灵地跃过$N，闪到了$N的背后。\n",
	"$n身形急闪，斜向前一步，竟然已经躲开了$N的这一招。\n",
	"$N眼前一花，却见$n竟然已离自己有数丈之远，却没见$n如何躲过自己的攻击的?�n",
	"$N一个不留神，$n已没了踪影。$N急转身，却见$n在那儿向自己招手。\n",
	"$N一招攻出，$n已然不见，$N茫然四顾，却不见$n的影子！\n",
});

int valid_enable(string usage)
{
	return usage == "throwing" ||
	       usage == "dodge";
}

int valid_learn(object me)
{
	if ((int)me->query_skill("force") < 50)
		return notify_fail("你的内功心法火候不够，无法学飞星术。\n");

	if ((int)me->query_skill("dodge") < 40)
		return notify_fail("你的轻功火候不够，无法学习飞星术。\n");

	if ((int)me->query_skill("poison", 1) < 30)
		return notify_fail("你的毒功火候不够，无法领悟飞星术。\n");

	if ((int)me->query_dex() < 25)
		return notify_fail("你的身法不够灵巧，无法学习飞星术。\n");

	if ((int)me->query_skill("poison", 1) < (int)me->query_skill("feixing-shu", 1))
		return notify_fail("你的毒功水平有限，无法领悟更高深的飞星术。\n");

	if ((int)me->query_skill("throwing", 1) < (int)me->query_skill("feixing-shu", 1))
		return notify_fail("你的基本暗器水平有限，无法领悟更高深的飞星术。\n");

	return 1;
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
 

	if ((int)me->query("qi") < 60)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 60)
		return notify_fail("你的内力不够练飞星术。\n");

	me->receive_damage("qi", 50);
	me->add("neili", -48);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"feixing-shu/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【飞星术】" ZJBR NOR;
    msg += WHT "一门结合轻功、毒功和暗器的独特武学，手法奇诡，暗器发射迅捷难测。" ZJBR;
    msg += "可同时作为暗器和轻功激发。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功等级不低于 " HIY "50" NOR " 级。" ZJBR;
    msg += "  基本轻功等级不低于 " HIY "40" NOR " 级。" ZJBR;
    msg += "  基本毒功等级不低于 " HIY "30" NOR " 级。" ZJBR;
    msg += "  先天身法不低于 " HIY "25" NOR " 点。" ZJBR;
    msg += "  基本毒功等级需大于等于飞星术等级。" ZJBR;
    msg += "  基本暗器等级需大于等于飞星术等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  暗器（throwing）。" ZJBR;
    msg += "  轻功（dodge）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "60" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "48" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  作为轻功激发时，提供多种闪避描述（`query_dodge_msg`）。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  漫天花雨 (huayu)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      飞星术等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "      手中需持有至少 " HIY "10" NOR " 枚可投掷的暗器。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      消耗 " HIY "10" NOR " 枚暗器，向目标发射一阵暗器雨。" ZJBR;
    msg += "      命中判定受自身基本暗器等级和目标基本轻功等级影响。" ZJBR;
    msg += "      命中后，目标将受到 " HIC "1~10" NOR " 次暗器打击（具体次数受双方技能等级对比及随机影响）。" ZJBR;
    msg += "      每次暗器打击会造成基于暗器本身的伤害，并附加额外的固定伤害和随机伤害。" ZJBR;
    msg += "      目标气血将受到额外创伤，伤害值为 (飞星术等级 / 3 + 随机(飞星术等级 / 3))。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "100" NOR " 点，忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      消耗手中 " HIY "10" NOR " 枚暗器。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 飞星术结合了多种技能，练习时需注意平衡发展。" ZJBR;
    msg += "2. 漫天花雨是主要的输出手段，注意保持充足的暗器数量和内力。" ZJBR;
    msg += "3. 作为轻功使用时，闪避效果尚可。" ZJBR;

    return msg;
}