// 舞剑术

inherit SKILL;

string type() { return "art"; }

int valid_learn(object me)
{
	if (me->query_skill("art-cognize", 1) < 30)
		return notify_fail("你艺术造诣太浅，难以掌握舞剑术。\n");

	if (me->query_skill("wujian-shu", 1) > me->query_skill("art-cognize", 1))
		return notify_fail("你艺术造诣有限，不足以掌握更高深的舞剑术。\n");

	return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【舞剑术】" ZJBR NOR;
    msg += "舞剑术是一门艺术类技能，主要用于表演和娱乐。通过舞剑能展现剑法的优美韵律与意境。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  艺术造诣(art-cognize)等级需达到 " HIY "30" NOR " 级。" ZJBR;
    msg += "  舞剑术等级不能超过艺术造诣等级。" ZJBR ZJBR;

    msg += HIY "〖技能类型〗" ZJBR NOR;
    msg += "  艺术类技能（art）。" ZJBR ZJBR;

    msg += HIY "〖练习条件〗" ZJBR NOR;
    msg += "  此技能不可练习，只能通过学习提高。" ZJBR ZJBR;

    msg += HIY "〖特殊效果〗" ZJBR NOR;
    msg += "  提高使用者的魅力值。" ZJBR;
    msg += "  提升表演技巧。" ZJBR;
    msg += "  在某些特定场合可以用来吸引观众，获得额外奖励。" ZJBR;
    msg += "  与某些剑法结合，可能触发特殊效果。" ZJBR ZJBR;

    msg += HIY "〖技能互动〗" ZJBR NOR;
    msg += "  此技能主要用于表演和社交互动，不可用于实战。" ZJBR;
    msg += "  在某些NPC面前表演，可能会获得特殊反应或奖励。" ZJBR;

    return msg;
}


