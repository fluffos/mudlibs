// /kungfu/skill/lingboweibu.c


inherit SKILL;

string *parry_msg = ({
    HIW "$n" HIW "施展「" HIC "凌波微步" HIW "」，身形" HIY "飘忽不定" HIW "，" HIM "瞬息万变" HIW "，$N" HIW "的攻击" HIR "尽数落空" HIW "。\n" NOR,
    HIW "$n" HIW "运转「" HIC "凌波微步" HIW "」，" HIY "身姿灵动" HIW "，" HIM "如梦似幻" HIW "，轻松化解$N" HIW "的" HIR "凌厉攻势" HIW "。\n" NOR,
    HIW "$n" HIW "以「" HIC "凌波微步" HIW "」精妙身法，" HIY "飘逸若仙" HIW "，" HIM "身形变幻莫测" HIW "，$N" HIW "攻击" HIR "无从着力" HIW "。\n" NOR,
    HIW "$n" HIW "展现「" HIC "凌波微步" HIW "」绝学，" HIY "身法玄妙" HIW "，" HIM "如幽灵般" HIW "闪现，$N" HIW "的攻击" HIR "尽数落空" HIW "。\n" NOR,
    HIW "$n" HIW "使出「" HIC "凌波微步" HIW "」，" HIY "身形缥缈" HIW "，" HIM "若隐若现" HIW "，$N" HIW "的攻击" HIR "如击败革" HIW "。\n" NOR,
});

string *dodge_msg = ({
    HIW "$n" HIW "施展「" HIC "凌波微步" HIW "」，" HIY "身形轻盈" HIW "，" HIM "如蜻蜓点水" HIW "，巧妙避过$N" HIW "的" HIR "凌厉攻势" HIW "。\n" NOR,
    HIW "$n" HIW "运转「" HIC "凌波微步" HIW "」，" HIY "身法灵动" HIW "，" HIM "如鱼游水" HIW "，轻松闪过$N" HIW "的" HIR "猛烈攻击" HIW "。\n" NOR,
    HIW "$n" HIW "以「" HIC "凌波微步" HIW "」绝妙身法，" HIY "飘逸若仙" HIW "，" HIM "身形恍若鬼魅" HIW "，$N" HIW "攻击" HIR "尽数落空" HIW "。\n" NOR,
    HIW "$n" HIW "展现「" HIC "凌波微步" HIW "」神技，" HIY "身形飘忽" HIW "，" HIM "如云似雾" HIW "，$N" HIW "的攻击" HIR "无从着力" HIW "。\n" NOR,
    HIW "$n" HIW "使出「" HIC "凌波微步" HIW "」，" HIY "身法玄妙" HIW "，" HIM "如幻如真" HIW "，$N" HIW "的攻击" HIR "尽数落空" HIW "。\n" NOR,
});

int valid_enable(string usage) 
{ 
    return usage == "parry" || usage == "dodge";
}

string query_parry_msg(string limb)
{
    return parry_msg[random(sizeof(parry_msg))];
}

string query_dodge_msg(string limb)
{
    return dodge_msg[random(sizeof(dodge_msg))];
}

int valid_learn(object me)
{
    if (me->query("family/family_name") != "白帝城")
        return notify_fail("凌波微步只有白帝城的弟子才能学习。\n");

    if ((int)me->query_skill("force") < 100)
        return notify_fail("你的内功火候不够，需要100级的内功才能学习凌波微步。\n");

    if ((int)me->query("max_neili") < 500)
        return notify_fail("你的内力太弱，需要至少500点最大内力才能练习凌波微步。\n");

    if ((int)me->query_skill("dodge", 1) < 80)
        return notify_fail("你的基本轻功火候不够，需要80级的基本轻功才能学习凌波微步。\n");

    if ((int)me->query_skill("dodge", 1) < (int)me->query_skill("lingboweibu", 1))
        return notify_fail("你的基本轻功水平有限，无法领会更高深的凌波微步。\n需要提高你的基本轻功到" + (string)(me->query_skill("lingboweibu", 1) + 1) + "级才能继续学习。\n");

    return 1;
}

int practice_skill(object me)
{
    if (me->query("family/family_name") != "白帝城")
        return notify_fail("凌波微步只有白帝城的弟子才能练习。\n");

    if ((int)me->query("qi") < 70)
        return notify_fail("你的体力不足70点，太低了，无法练习凌波微步。\n");

    if ((int)me->query("neili") < 60)
        return notify_fail("你的内力不足60点，不够练习凌波微步。\n");

    me->receive_damage("qi", 55);
    me->add("neili", -48);
    return 1;
}

// 这是轻功系数
int query_effect_dodge(object attacker, object me)
{
	int lvl;

	lvl = me->query_skill("lingbo-weibu", 1);
	if (lvl < 50)  return 0;
	if (lvl < 100) return 30;
	if (lvl < 150) return 50;
	if (lvl < 200) return 80;
	if (lvl < 250) return 100;
	if (lvl < 300) return 120;
	if (lvl < 350) return 140;
	return 150;
}

string perform_action_file(string action)
{
    return __DIR__"lingboweibu/" + action;
}
int diffcult_level() { return 300; }

string query_description()
{
    string msg;

    msg = HIY "【凌波微步】" ZJBR ZJBR NOR;
    msg += WHT "源自《洛神赋》，取“体迅飞凫，飘忽若神。凌波微步，罗袜生尘”之意。此步法按伏羲六十四卦方位演化而成，精妙异常，习者可凭此于万军从中任意穿梭，宛若洛神御风而行。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  门派必须为 " HIY "白帝城" NOR "。" ZJBR;
    msg += "  基本内功 (`force`) 等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "  最大内力 (`max_neili`) 不低于 " HIB "500" NOR " 点。" ZJBR;
    msg += "  基本轻功 (`dodge`) 等级不低于 " HIY "80" NOR " 级。" ZJBR;
    msg += "  基本轻功 (`dodge`) 等级需大于等于凌波微步等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  轻功 (`dodge`)。" ZJBR;
    msg += "  招架 (`parry`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  门派必须为 " HIY "白帝城" NOR "。" ZJBR;
    msg += "  当前气血 (`qi`) 不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  当前内力 (`neili`) 不低于 " HIB "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血 " HIR "55" NOR " 点，内力 " HIB "48" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  " HIW "轻功加成 (query_effect_dodge)" NOR ":" ZJBR;
    msg += "    效果：提升有效轻功等级，随技能等级提升而增加，最高可达 " HIG "+150" NOR " 点。" ZJBR;
    msg += "      50-99 级: +30" ZJBR;
    msg += "      100-149 级: +50" ZJBR;
    msg += "      150-199 级: +80" ZJBR;
    msg += "      200-249 级: +100" ZJBR;
    msg += "      250-299 级: +120" ZJBR;
    msg += "      300-349 级: +140" ZJBR;
    msg += "      350+ 级: +150" ZJBR;
    msg += "  " HIW "独特闪避/招架描述 (query_dodge_msg/query_parry_msg)" NOR ":" ZJBR;
    msg += "    效果：激发为轻功或招架时，具有独特的描述信息。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (Perform)〗" ZJBR NOR;
    msg += HIC "  无影遁 (wuying)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      凌波微步等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "      只能在战斗中使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      施展凌波微步绝技，瞬间脱离战斗，移动到相邻的随机房间。" ZJBR;
    msg += "      若当前房间无出口或移动失败，则无效。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "      使用后自身获得「" HIR "凌波无影忙乱" NOR "」状态，" HIR "10" NOR " 秒内无法再次使用。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 学习难度系数为 " HIY "300" NOR "，属于较难学习的技能。" ZJBR;
    msg += "2. 「无影遁」是重要的保命和脱战手段，但有冷却时间限制。" ZJBR;
    msg += "3. 依赖高等级的轻功基础和内力支持。" ZJBR;

    return msg;
}