int valid_enable(string usage) { return usage == "blade" || usage == "parry"; } 

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 100)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("force") < 30)
		return notify_fail("你的内功火候不够。\n");

	if ((int)me->query_skill("sword", 1) < (int)me->query_skill("xiyang-jian", 1))
		return notify_fail("你的基本剑法水平有限，无法领会更高深的西洋剑术。\n");

	if ((int)me->query_skill("sword", 1) < (int)me->query_skill("xiyang-jian", 1))
		return notify_fail("你的基本剑法水平有限，无法领会更高深的西洋剑术。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action) - 1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("xiyang-jian", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 80)
		return notify_fail("你的体力不够练西洋剑术。\n");

	if ((int)me->query("neili") < 50)
		return notify_fail("你的内力不够练西洋剑术。\n");

	me->receive_damage("qi", 70);
	me->add("neili", -40);

	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"xiyang-jian/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【西洋剑术】" ZJBR NOR;
    msg += "源自西洋的剑术，特点是出剑快速、准确、灵活，讲究技巧和时机。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力：不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "  内功有效激发等级：不低于 " HIY "30" NOR " 级。" ZJBR;
    msg += "  基本剑法等级：不能低于西洋剑术等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  剑法（sword）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须装备剑类武器。" ZJBR;
    msg += "  气血：不低于 " HIR "80" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "40" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  西洋刺剑 (ci)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      西洋剑术等级 " HIY "70" NOR " 级。" ZJBR;
    msg += "      内功有效激发等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      激发剑法为西洋剑术。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      临时提升自身命中等级（提升值为 西洋剑术等级 / 3），然后向对手发动一次快速的刺击。" ZJBR;
    msg += "      伤害由标准战斗公式计算。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "70" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  西洋连刺 (lian)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      西洋剑术等级 " HIY "80" NOR " 级。" ZJBR;
    msg += "      内功有效激发等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      激发剑法为西洋剑术。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      临时提升自身命中等级（提升值为 西洋剑术等级 / 3）和伤害（提升值为 (西洋剑术等级 / 3) / 2）。" ZJBR;
    msg += "      随后向对手发动 5 次连续攻击。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "1" NOR " 至 " HIR "5" NOR " 秒（随机）。" ZJBR;

    return msg;
}
