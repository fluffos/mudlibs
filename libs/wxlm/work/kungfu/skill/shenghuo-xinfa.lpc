inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int query_neili_improve(object me)
{
	int lvl;

	lvl = (int)me->query_skill("shenghuo-xinfa", 1);
	return lvl * lvl * 15 * 12 / 100 / 200;
}

int valid_learn(object me)
{

	if ((int)me->query_skill("force", 1) < 50)
		return notify_fail("你的基本内功火候还不够，还不能学习圣火心法。\n");

	return ::valid_learn(me);
}

int practice_skill(object me)
{
	return notify_fail("圣火心法只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"shenghuo-xinfa/" + func;
}

string query_description()
{
    string msg;

    msg = HIY "【圣火心法】" ZJBR NOR;
    msg += WHT "圣火心法是一门独特的内功心法，源自波斯明教，以其强大的内力运转和火属性特征著称。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功等级不低于 " HIY "50" NOR " 级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功 (force)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  圣火心法只能通过学习 (learn) 来提升熟练度。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  内力上限提升：" ZJBR;
    msg += "    提升值约为 (圣火心法等级 * 圣火心法等级 * 15 * 12 / 100 / 200)。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  圣火战意 (powerup)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      当前内力不低于 " HIB "150" NOR " 点。" ZJBR;
    msg += "      未处于运功状态 (`powerup` 状态)。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升自身 攻击有效等级 (`apply/attack`)、轻功有效等级 (`apply/dodge`)、招架有效等级 (`apply/parry`)。" ZJBR;
    msg += "      提升数值均为 (激发内功等级 * 2 / 5)。" ZJBR;
    msg += "      效果持续时间为 激发内功等级 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "      如果在战斗中使用，自身会忙乱 " HIR "3" NOR " 秒。" ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 圣火心法是一种内功心法，主要用于提升内力上限和内力恢复速度。" ZJBR;
    msg += "2. 该心法可能与其他武功配合使用，发挥更强大的威力。" ZJBR;
    msg += "3. 修炼圣火心法可能会影响人物的其他属性或技能，具体效果请参考相关说明。\n";

    return msg;
}
