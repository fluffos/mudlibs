int valid_enable(string usage){return usage=="sword" || usage=="parry";}

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 900)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("force") < 120)
		return notify_fail("你的内功火候太浅。\n");

	if ((int)me->query_skill("sword", 1) < 100)
		return notify_fail("你的基本剑法火候不够，无法学习痴心情长剑。\n");

	if ((int)me->query_skill("sword", 1) < (int)me->query_skill("chixin-jian", 1))
		return notify_fail("你的基本剑法水平有限，无法领会更高深的痴心情长剑。\n");

	return 1;
}

string query_skill_name(int level)
{
    int i;
    for(i = sizeof(action)-1; i >= 0; i--)
	if(level >= action[i]["lvl"])
	    return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    int i, level;
    level   = (int) me->query_skill("chixin-jian",1);
    for(i = sizeof(action); i > 0; i--)
	if(level > action[i-1]["lvl"])
	    return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    object weapon;

    if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
	return notify_fail("你使用的武器不对。\n");

    if( (int)me->query("qi") < 50)
	return notify_fail("你的体力目前没有办法练习痴心情长剑。\n");

    if( (int)me->query("neili") < 60)
	return notify_fail("你的内力不够，无法练习痴心情长剑。\n");
	
    me->receive_damage("qi", 40);
    me->add("neili", -55);
    return 1;
}

string perform_action_file(string action)
{
    return __DIR__"chixin-jian/" + action;
}

string query_description()
{
    string msg;

    msg = "";
    msg += HIY "【痴心情长剑】" ZJBR ZJBR NOR;
    msg += WHT "痴心情长剑是一门以情入剑的武功，以其剑招柔中带刚、情意绵长而闻名。" ZJBR;
    msg += "此剑法讲究以情驭剑，剑随心动，招式看似轻柔，实则暗藏杀机。" ZJBR;
    msg += "剑法中蕴含着深厚的情感，每一招每一式都仿佛在诉说一段刻骨铭心的爱情故事。" ZJBR ZJBR;

    msg += HIY "【学习要求】" ZJBR NOR;
    msg += "  内力最大值 900 点" ZJBR;
    msg += "  内功等级 120 级" ZJBR;
    msg += "  基本剑法等级 100 级" ZJBR ZJBR;

    msg += HIY "【特殊效果】" ZJBR NOR;
    msg += "  可激发为剑法（sword）或招架（parry）" ZJBR ZJBR;

    msg += HIY "【练习要求】" ZJBR NOR;
    msg += "  气血不少于 50 点" ZJBR;
    msg += "  内力不少于 60 点" ZJBR;
    msg += "  每次练习消耗：" ZJBR;
    msg += "    气血：40 点" ZJBR;
    msg += "    内力：55 点" ZJBR ZJBR;
    msg += HIY "【特殊招式】" ZJBR NOR;
    msg += HIW "1. 情意绵绵（qingyi）：" ZJBR NOR;
    msg += "  要求：痴心情长剑100级，内力200点" ZJBR;
    msg += "  内力消耗：100点" ZJBR;
    msg += "  效果：连续攻击对手多次" ZJBR;
    msg += "  描述：剑招绵绵不绝,如情意绵长,连环攻向对手" ZJBR ZJBR;
    msg += HIW "2. 痴心一剑（chixin）：" ZJBR NOR;
    msg += "  要求：痴心情长剑120级，内功120级，内力300点" ZJBR;
    msg += "  内力消耗：150点" ZJBR;
    msg += "  效果：对敌人造成巨大伤害" ZJBR;
    msg += "  描述：凝聚全身功力于剑尖,使出痴心情长剑的绝招" ZJBR ZJBR;
    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 痴心情长剑需要高超的剑法修为,练习时需要注意提高基本剑法。" ZJBR;
    msg += "2. 在实战中,要善于利用剑法的柔中带刚特点,出其不意地攻击对手。" ZJBR;
    msg += "3. 各种特殊招式都有其适用场景,需要灵活运用。\n";

    return msg;
}