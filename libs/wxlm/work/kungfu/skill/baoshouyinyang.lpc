// baoshouyinyang.c 抱守阴阳
// modified by Venus Oct.1997

inherit SKILL;

void create() { seteuid(getuid()); }

string type() { return "knowledge"; }

int valid_learn(object me)
{
	int lvl;

	lvl = (int)me->query_skill("baoshouyinyang", 1);

	if(me->query("gender") == "无性" && lvl > 19)
		return notify_fail("你刚听一会儿，便觉心智迷糊，原来你没有阳刚之\n"
				   "气，无法领会里面的阴阳变化之道。\n");

	return 1;
}

int practice_skill(object me)
{
	return notify_fail("抱守阴阳无法通过练习来提高。\n");
}
string query_description()
{
    string msg;

    msg = "";
    msg += HIY "【抱守阴阳】" ZJBR ZJBR NOR;
    msg += WHT "抱守阴阳是一门深奥的知识类技能，讲究阴阳调和、内外兼修。" ZJBR;
    msg += "此功法源自道家典籍，强调通过领悟达到阴阳平衡，提升对内功的理解。" ZJBR ZJBR;
    msg += HIY "【学习要求】" ZJBR NOR;
    msg += "  性别：非无性" ZJBR;
    msg += "  无性者等级不能超过 19 级" ZJBR ZJBR;
    msg += HIY "【练习要求】" ZJBR NOR;
    msg += "  无法通过练习（practice）提高" ZJBR ZJBR;
    msg += HIY "【特殊功能】" ZJBR NOR;
    msg += HIW "1. 阴阳调和（tiaohe）：" ZJBR NOR;
    msg += "  要求：抱守阴阳 100 级，当前内力 1000 点" ZJBR;
    msg += "  内力消耗：200点" ZJBR;
    msg += "  效果：调和自身阴阳二气，恢复部分气血和内力（效果待确认）" ZJBR ZJBR;
    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 抱守阴阳需要通过研读（study）或领悟（comprehend）提升。" ZJBR;
    msg += "2. 无性者难以领会高深的阴阳变化之道。" ZJBR;
    msg += "3. 在使用阴阳调和时，要注意把握时机，以发挥最大效果。\n";

    return msg;
}
