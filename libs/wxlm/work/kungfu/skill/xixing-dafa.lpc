// xixing-dafa.c 吸功大法
// by doing



inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_force(string force)
{
	return 1;
}

int query_neili_improve(object me)
{
	int lvl;

	lvl = (int)me->query_skill("xixing-dafa", 1);
	
	if (lvl >= 300 && me->query("family/family_name") == "日月神教")
		return lvl * lvl * 17 * 16 / 100 / 200;
	else
		return lvl * lvl * 15 * 16 / 100 / 200;
}

int valid_learn(object me)
{
	int lvl = (int)me->query_skill("xixing-dafa", 1);

	if (me->query("character") == "光明磊落")
		return notify_fail("你心中暗道：这种害人武功，我学它作甚？\n");

	if (me->query("con") < 20)
		return notify_fail("你试着按照法门运转了一下内息，忽然"
				   "觉得脸热心跳，丹田却是一阵冰凉！\n");

	if (lvl >= 10 && lvl < 50 && me->query("max_neili") > 101)
		return notify_fail("你没有按照吸功大法的诀窍将内"
				   "力散去（至多保留101点内力），现在还不敢妄自继续修行大法。\n");

	return ::valid_learn(me);
}

mixed valid_damage(object ob, object me, int damage, object weapon)
{
	mapping result;
	int ap, dp;
	int jiali;

	if ((int) me->query_skill("xixing-dafa", 1) < 80 ||
	    ! living(me))
		return;

	if ((jiali = ob->query("jiali")) < 1)
		return;

	ap = ob->query_skill("force");
	dp = me->query_skill("force");
	if (ap / 2 + random(ap) < dp)
	{
		if (me->query("neili") < me->query("max_neili") * 15 / 10)
			me->add("neili", jiali);

		result = ([ "damage" : -(damage * 3 / 4) ]);

		switch (random(4))
		{
		case 0:
			result += ([ "msg" : HIM "$N" HIM "只觉得内力源源而泄"
					     "，不由得大吃一惊。"NOR"\n" ]);
			break;
		case 1:
			result += ([ "msg" : HIM "$N" HIM "只觉得发出的内力犹"
					     "如石沉大海，不知所踪。"NOR"\n" ]);
			break;
		case 2:
			result += ([ "msg" : HIM "$N" HIM "只觉得发出的内力犹"
					     "无影无踪，浑然不知着落。"NOR"\n" ]);
			break;
		default:
			result += ([ "msg" : HIM "$N" HIM "不住催动内力，但是"
					     "只觉得$n" HIM "竟似毫不费力。"NOR"\n" ]);
			break;
		}
		return result;
	}
}

int practice_skill(object me)
{
	return notify_fail("吸功大法只能用学的，或是从运用(exert)中增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"xixing-dafa/" + func;
}

void check_count(object me)
{
	if (me->query("max_neili") >= 3000 &&
	    me->query("exception/xixing-count") > 1000)
	{
		me->apply_condition("xixing-fanshi",
			me->query_condition("xixing-fanshi") +
			me->query("exception/xixing-count") / 10);
		me->delete("exception/xixing-count");
	}
}

void skill_improved(object me)
{
	this_player()->add("exception/xixing-count",
			   (int)this_player()->query_skill("xixing-dafa", 1) + 1);
	check_count(this_player());
}

string query_description()
{
    string msg;

    msg = HIY "【吸功大法】" ZJBR ZJBR NOR;
    msg += WHT "吸功大法是一门邪派内功心法,以吸取他人内力为修炼之道。" ZJBR;
    msg += "此功法霸道异常,可快速提升内力,但也有走火入魔之险。" ZJBR ZJBR;

    msg += HIY "【技能要求】" ZJBR NOR;
    msg += "  基础内功等级：80级" ZJBR;
    msg += "  先天根骨：20" ZJBR ZJBR;

    msg += HIY "【技能类型】" ZJBR NOR;
    msg += "  可激发为内功（force）" ZJBR ZJBR;

    msg += HIY "【特殊效果】" ZJBR NOR;
    msg += "1. 吸收攻击：有几率吸收敌人的攻击并转化为自身内力" ZJBR;
    msg += "2. 内力增幅：提高内力上限" ZJBR;
    msg += "3. 散功：可主动散去内力" ZJBR ZJBR;

    msg += HIY "【特殊招式】" ZJBR NOR;
    msg += HIW "1. 吸取真气（suck）：" ZJBR NOR;
    msg += "  要求：吸功大法200级，当前内力100点" ZJBR;
    msg += "  内力消耗：10点" ZJBR;
    msg += "  冷却时间：20秒" ZJBR;
    msg += "  效果：吸取对手的内力上限并增加自身内力上限" ZJBR;
    msg += "  攻击力(AP)计算：自身内功等级" ZJBR;
    msg += "  防御力(DP)计算：目标内功等级" ZJBR;
    msg += "  命中判定：AP + random(AP) > DP + random(DP)" ZJBR;
    msg += "  吸取数值：1 + (自身吸功大法等级 - 120) / 10" ZJBR;
    msg += "  描述：探手拍向对手胸口,吸取对方丹元为己用" ZJBR ZJBR;

    msg += HIW "2. 真气加力（powerup）：" ZJBR NOR;
    msg += "  要求：当前内力100点" ZJBR;
    msg += "  内力消耗：100点" ZJBR;
    msg += "  冷却时间：无" ZJBR;
    msg += "  效果：临时提升自身攻防" ZJBR;
    msg += "  加成数值：内功等级 / 3" ZJBR;
    msg += "  持续时间：内功等级秒" ZJBR;
    msg += "  描述：运转内力,提升战斗力" ZJBR ZJBR;

    msg += HIW "3. 仰天长啸（roar）：" ZJBR NOR;
    msg += "  要求：当前内力600点" ZJBR;
    msg += "  内力消耗：150点" ZJBR;
    msg += "  冷却时间：无" ZJBR;
    msg += "  效果：对周围敌人造成精神伤害" ZJBR;
    msg += "  伤害计算：内功等级 - (目标最大内力 / 10)" ZJBR;
    msg += "  描述：发出震天长啸,震伤敌人心神" ZJBR ZJBR;

    msg += HIR "【练习消耗】" ZJBR NOR;
    msg += "  每次练习需要10点精力和30点内力" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 吸功大法修炼有走火入魔的风险,需谨慎修炼。" ZJBR;
    msg += "2. 吸取他人内力会增加异常值,累积过高会受到反噬。" ZJBR;
    msg += "3. 光明磊落的人无法修炼此功法。" ZJBR;
    msg += "4. 初学者需将内力散去至101点以下才可继续修炼。\n";

    return msg;
}