// qingxin-pushan.c 清心普善咒



inherit SKILL;

string type() { return "knowledge"; }

int valid_enable(string usage) { return usage == "tanqin-jifa"; }

int valid_learn(object me)
{
	if (me->query_skill("tanqin-jifa", 1) < 50)
		return notify_fail("你的弹琴技法水平太差，还是先练好再说吧！\n");

	if (me->query_skill("tanqin-jifa", 1) < me->query_skill("qingxin-pushan", 1))
		return notify_fail("你的弹琴技法所有有限，无法领会更精妙的清心普善咒。\n");

	return 1;
}

int practice_skill(object me)
{
	object ob;

	if (! objectp(ob = me->query_temp("handing")) ||
	    ! ob->valid_as_qin())
		return notify_fail("你不拿琴在手上，怎么练习？\n");

	if ((int)me->query("jing") < 80)
		return notify_fail("你的精神不够好，没法练习了。\n");

	if ((int)me->query("qi") < 30)
		return notify_fail("你现在口干舌燥，实在是太累了。\n");

	me->receive_damage("jing", 25);
	me->receive_damage("qi", 10);

	return 1;
}

void do_effect(object me)
{
	object *obs;
	int lvl;

	lvl = me->query_skill("tanqin-jifa", 1) / 2 +
	      me->query_skill("qingxin-pushan", 1);

	if (lvl < 100)
		return;

	// special effort
	obs = all_inventory(environment(me)) - ({ me });
	obs->receive_heal("jing", random(lvl / 10) + 10);
	message("vision", HIG "你听了" + me->name() +
		HIG "的曲子，觉得神情气爽，精神也好多了。"NOR"\n",
		obs);
}


string query_description()
{
    string msg;

    msg = HIY "【清心普善咒】" ZJBR ZJBR NOR;
    msg += WHT "一种独特的琴曲知识，弹奏此曲可静心凝神，具有安抚人心、恢复精力的效果。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本琴法 (" HIW "tanqin-jifa" NOR ") 等级不低于 " HIY "50" NOR " 级。" ZJBR;
    msg += "  基本琴法等级需大于等于清心普善咒等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  知识类技能 (knowledge)。" ZJBR;
    msg += "  可作为 琴法 (tanqin-jifa) 激发使用。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须手持 琴 类物品。" ZJBR;
    msg += "  精力 (" HIW "jing" NOR ")：不低于 " HIG "80" NOR " 点。" ZJBR;
    msg += "  气血 (" HIW "qi" NOR ")：不低于 " HIR "30" NOR " 点。" ZJBR;
    msg += "  每次练习消耗精力：" HIG "25" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "10" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  当弹奏此曲时 (" HIW "play" NOR " 指令等)，若满足条件，可为环境内他人恢复精力：" ZJBR;
    msg += "    触发条件：(弹琴技法等级 / 2 + 清心普善咒等级) >= " HIY "100" NOR "。" ZJBR;
    msg += "    恢复数值：为范围内他人恢复 (随机(触发条件值 / 10) + 10) 点精力。" ZJBR;
    msg += "    影响范围：同场景内除弹奏者外的所有生物。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR;

    return msg;
}
