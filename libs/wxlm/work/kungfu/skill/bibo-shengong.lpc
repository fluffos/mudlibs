// bibo-shengong.c 碧波神功
// By Jungu

inherit FORCE;

int valid_enable(string usage) { return usage=="force"; }

int query_neili_improve(object me)
{
    int lvl;

    lvl = (int)me->query_skill("bibo-shengong", 1);
    return lvl * lvl * 15 * 10 / 100 / 200;
}

int valid_force(string force)
{
    return (force == "luoying-xinfa");
}

int valid_learn(object me)
{
	int lvl = (int)me->query_skill("bibo-shengong", 1);

	if (me->query("gender") == "无性" && lvl > 49)
		return notify_fail("你无根无性，阴阳不调，难"
				   "以领会高深的碧波神功。\n");

	if (me->query_skill("chuixiao-jifa", 1) < 100)
		return notify_fail("你没有精通吹箫技法，无法"
				   "领会碧波神功的奥秘。\n");
       if (me->query_skill("force",1) <= me->query_skill("bibo-shengong",1) )
	return notify_fail("你的基本内功不够，无法领会更高深的碧波神功。\n");

	return ::valid_learn(me);
}

int practice_skill(object me)
{
    return notify_fail("碧波神功只能用学的，或是从运用(exert)中增加熟练度。\n");
}

string exert_function_file(string func)
{
    return __DIR__"bibo-shengong/" + func;
}

string query_description()
{
    string msg;

    msg = "";
    msg += HIY "【碧波神功】" ZJBR ZJBR NOR;
    msg += WHT "碧波神功是一门以水性柔和为特点的内功心法，以其绵绵不绝、生生不息而闻名。" ZJBR;
    msg += "此功法讲究以柔克刚，以静制动，能化解对手的攻击并借力打力。" ZJBR ZJBR;
    msg += HIY "【学习要求】" ZJBR NOR;
    msg += "  吹箫技法（chuixiao-jifa）等级 100 级" ZJBR;
    msg += "  碧波神功等级不能超过基本内功等级" ZJBR;
    msg += "  性别：非无性" ZJBR;
    msg += "  无性者等级不能超过 49 级" ZJBR ZJBR;
    msg += HIY "【练习要求】" ZJBR NOR;
    msg += "  无法通过练习（practice）提高，可通过学习（learn）或运用（exert）提升" ZJBR ZJBR;
    msg += HIY "【技能效果】" ZJBR NOR;
    msg += "  可激发为内功（force）" ZJBR;
    msg += "  可与落英心法（luoying-xinfa）互备" ZJBR;
    msg += "  根据技能等级提升内力上限，等级越高，提升幅度越大" ZJBR ZJBR;
    msg += HIY "【特殊招式】" ZJBR NOR;
    msg += HIW "1. 碧波战气（powerup）：" ZJBR NOR;
    msg += "  要求：碧波神功 30 级，当前内力 500 点" ZJBR;
    msg += "  内力消耗：100点" ZJBR;
    msg += "  效果：提高自身攻击力和防御力" ZJBR;
    msg += "  数值：提升效果与基本内功等级相关" ZJBR;
    msg += "  持续时间：与基本内功等级相关" ZJBR;
    msg += "  描述：运起碧波神功，全身衣袍如巨涛般向四面扩涨" ZJBR ZJBR;
    msg += HIW "2. 奇门迷魂阵（maze）：" ZJBR NOR;
    msg += "  要求：碧波神功 150 级，奇门五行（qimen-wuxing）150 级，当前内力 1000 点，当前精力 200 点" ZJBR;
    msg += "  消耗：内力 200-500 点" ZJBR;
    msg += "  效果：布置迷阵困住对手，降低对手攻击力和防御力，提升自身防御力" ZJBR;
    msg += "  持续时间：20秒" ZJBR;
    msg += "  描述：使用奇门八卦之易理，在身旁以碧海潮生之内劲迅速排列树枝、土石等物布下迷阵" ZJBR ZJBR;
    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 碧波神功与吹箫技法关联紧密，且无法练习。" ZJBR;
    msg += "2. 在实战中，要善于利用水性柔和的特点，以守为攻。" ZJBR;
    msg += "3. 奇门迷魂阵作为强大的控制技能，能有效削弱对手、保护自身。\n";

    return msg;
}