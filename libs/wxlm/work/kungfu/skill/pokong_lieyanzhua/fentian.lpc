
#include <combat.h>

#define FENTIAN HIC "焚天煮海" NOR

inherit F_SSERVER;

string query_name() { return "焚天煮海"; }

int perform(object me, object target)
{
    string msg;
    int ap, dp;
    int count;
    int i;

    if (! target) target = offensive_target(me);

    if (! target || ! me->is_fighting(target))
        return notify_fail(FENTIAN "只能对战斗中的对手使用。\n");

    if (me->query_skill("pokong_lieyanzhua", 1) < 120)
        return notify_fail("你的破空烈焰拳还不够娴熟，无法施展" FENTIAN "。\n");

    if (me->query("neili") < 300)
        return notify_fail("你的真气不够，无法施展" FENTIAN "。\n");

    if (me->query_skill_mapped("cuff") != "pokong_lieyanzhua")
        return notify_fail("你没有激发破空烈焰拳，无法使用" FENTIAN "。\n");

    if (! living(target))
        return notify_fail("对方都已经这样了，用不着这么狠吧。\n");

    ap = me->query_skill("cuff") + me->query_skill("force");
    dp = target->query_skill("dodge") + target->query_skill("parry");

    msg = HIC "$N" HIC "双拳挥舞，施展出焚天煮海，无数拳影如沸腾的海洋，向$n" HIC "汹涌而去！\n" NOR;
    message_combatd(msg, me, target);

    count = ap / 10;
    if (count > 5) count = 5;

    count += COMBAT_D->query_base_attack_number(me,query_name());

    me->add_temp("apply/attack", count);

    for (i = 0; i < count; i++)
    {
        if (! me->is_fighting(target))
            break;
        if (random(3) == 1 && ! target->is_busy())
            target->start_busy(1);

        COMBAT_D->do_attack(me, target, 0, 0);
    }

    me->add_temp("apply/attack", -count);
    me->add("neili", -200);
    me->start_busy(2);
    return 1;
}
