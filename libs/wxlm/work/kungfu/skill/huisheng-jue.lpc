inherit SKILL; 
string type() { return "knowledge"; } 

string query_description()
{
    string msg;

    msg = HIY "【回生诀】" ZJBR NOR;
    msg += "这是一门关于起死回生之术的知识性技艺，本身无实战效果。" ZJBR;
    msg += "提升此技能可能有助于理解或施展某些与救治相关的特殊能力。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  无特殊要求，通常通过特定途径研习。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  知识（knowledge）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  无法练习。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无直接战斗效果。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR;

    return msg;
}

