int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 200)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("force") < 40)
		return notify_fail("你的内功火候太浅。\n");

	if (me->query_skill("sword", 1) < me->query_skill("huifeng-jian", 1))
		return notify_fail("你的基本剑法水平有限，无法领会更高深的回风剑。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action)-1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;

	level = (int) me->query_skill("huifeng-jian", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
		       return action[NewRandom(i, 20, level/5)];

}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 60)
		return notify_fail("你的体力不够练回风拂柳剑。\n");

	if ((int)me->query("neili") < 60)
		return notify_fail("你的内力不够练回风拂柳剑。\n");

	me->receive_damage("qi", 45);
	me->add("neili", -58);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"huifeng-jian/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【回风拂柳剑】" ZJBR NOR;
    msg += "一门轻灵飘逸的剑法，以回旋飘逸为特色，讲究以巧破力，剑招变化多端，如清风拂柳般轻盈。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力需达到 " HIY "200" NOR " 点。" ZJBR;
    msg += "  基本内功等级需达到 " HIY "40" NOR " 级。" ZJBR;
    msg += "  基本剑法等级不可低于回风拂柳剑等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  剑法（sword）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须持有剑类武器。" ZJBR;
    msg += "  气血：不低于 " HIR "60" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "45" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "58" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;

    msg += HIC "  回风拂柳 (hui)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      需经过师门指点开启。" ZJBR;
    msg += "      回风拂柳剑等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "200" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "500" NOR " 点。" ZJBR;
    msg += "      必须持有剑类武器。" ZJBR;
    msg += "      激发剑法为回风拂柳剑。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      连续发动五次攻击。" ZJBR;
    msg += "      第一击命中判定：比较双方后天膂力（STR）。" ZJBR;
    msg += "      第二击命中判定：比较双方后天悟性（INT）。" ZJBR;
    msg += "      第三击命中判定：比较双方后天根骨（CON）。" ZJBR;
    msg += "      第四击命中判定：比较双方后天身法（DEX）。" ZJBR;
    msg += "      第五击命中判定：比较自身激发剑法等级与目标激发招架等级。" ZJBR;
    msg += "      每次命中造成伤害，伤害值约为（激发剑法等级 + 随机（激发剑法等级 / 2））。" ZJBR;
    msg += "      若拥有【青莲剑意】奥义，可提升伤害（每层提升10%）。" ZJBR;
    msg += "      PVE时命中判定属性翻倍，伤害翻倍。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "500" NOR " 点。" ZJBR;
    msg += "      自身忙乱 3 + 随机(4) 秒。" ZJBR ZJBR;

    msg += HIC "  寂灭剑 (mie)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      回风拂柳剑等级 " HIY "60" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      必须持有剑类武器。" ZJBR;
    msg += "      激发剑法为回风拂柳剑。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：比较（自身激发内功等级 + 自身激发剑法等级）与（目标激发内功等级 + 目标激发招架等级）。" ZJBR;
    msg += "      命中后造成伤害，伤害值约为（激发剑法等级 + 随机（激发剑法等级））。" ZJBR;
    msg += "      命中后使目标陷入忙乱状态。" ZJBR;
    msg += "      忙乱时间约为 1 + 随机(4) 秒。" ZJBR;
    msg += "      PVE时命中判定攻击方数值翻倍，伤害翻倍。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 " HIB "150" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：消耗内力 " HIB "60" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;

    return msg;
}