]),
([      "action": "$N使出「千旋转」，将$w舞得如纺车一般，忽然一剑刺向$n的$l  ",
	"skill_name" : "千旋转",
	"force" : 220,
	"dodge" : 10,
	"lvl"   : 70,
	"damage": 48,
	"damage_type" : "刺伤",
]),
([      "action": "$N使出一招「降魔舞」，全身劲气贯于$w中，剑气直指$n的$l  ",
	"skill_name" : "降魔舞",
	"force" : 250,
	"dodge" : 10,
