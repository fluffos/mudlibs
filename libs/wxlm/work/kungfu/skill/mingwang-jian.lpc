([      "action": "$N怒目圆睁，使出一招「不动」，手中$w一抖，直刺$n的$l  ",
	"skill_name" : "不动",
	"force" : 100,
	"dodge" : -10,
	"lvl"   : 0,
	"damage": 30,
	"damage_type" : "刺伤",
]),
([      "action": "$N使出一式「起手出剑」，足下一滑，剑芒闪向$n的$l  ",
	"skill_name" : "起手出剑",
	"force" : 140,
	"dodge" : 5,
	"lvl"   : 30,
	"damage": 30,
	"damage_type" : "刺伤",
]),
([      "action": "$N使出一招「山崩」，纵身跃入半空，$w如山崩般劈向$n的$l  ",
	"skill_name" : "山崩",
	"force" : 180,
	"dodge" : -10,
	"lvl"   : 50,
