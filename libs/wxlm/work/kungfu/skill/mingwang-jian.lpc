	"damage_type" : "刺伤",
]),
});


int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 400)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("force") < 70)
		return notify_fail("你的内功火候太浅。\n");

	if (me->query_skill("sword", 1) < me->query_skill("mingwang-jian", 1))
		return notify_fail("你的基本剑法火候有限，无法领会更高深的不动明王剑法。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level   = (int) me->query_skill("mingwang-jian",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 60)
		return notify_fail("你的体力不够，练不了不动明王剑。\n");

	if ((int)me->query("neili") < 70)
		return notify_fail("你的内力不够，练不了不动明王剑。\n");

	me->receive_damage("qi", 50);
	me->add("neili", -58);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"mingwang-jian/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【不动明王剑】" ZJBR NOR;
    msg += "源自密宗的高深剑法，招式沉稳，威力惊人，蕴含佛门不动明王之意。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力不低于 " HIB "400" NOR " 点。" ZJBR;
    msg += "  内功激发等级 (`force`) 不低于 " HIY "70" NOR " 级。" ZJBR;
    msg += "  基本剑法 (`sword`) 等级不低于不动明王剑等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  剑法 (`sword`)。" ZJBR;
    msg += "  招架 (`parry`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  需装备剑类武器。" ZJBR;
    msg += "  气血不低于 " HIR "60" NOR " 点。" ZJBR;
    msg += "  内力不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "58" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;

    msg += HIC "  明王怒 (nu)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      不动明王剑激发等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      内功激发等级 (`force`) " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      激发剑法为不动明王剑。" ZJBR;
    msg += "      装备剑类武器。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      发动时临时提升自身攻击力 (不动明王剑激发等级 / 3) 点。" ZJBR;
    msg += "      发动时临时提升自身伤害 ((内功激发等级 + 剑法激发等级) / 4) 点。" ZJBR;
    msg += "      以提升后的状态连续对目标发动四次攻击 (使用 `COMBAT_D->do_attack` 进行判定)。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  若悲 (bei)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      不动明王剑激发等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      内功激发等级 (`force`) " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      激发剑法为不动明王剑。" ZJBR;
    msg += "      装备剑类武器。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：(自身剑法激发等级 / 2) + 随机(自身剑法激发等级 / 2) > 目标招架激发等级。" ZJBR;
    msg += "      若命中，则使目标陷入忙乱状态，持续时间为 (自身不动明王剑激发等级 / 20 + 2) 秒。" ZJBR;
    msg += "      此招式不造成直接伤害。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      若命中，自身忙乱 " HIR "1" NOR " 秒。" ZJBR;
    msg += "      若未命中，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;

    return msg;
}