int valid_enable(string usage) { return usage == "finger" || usage == "parry"; } 
     
int valid_combine(string combo) { return combo == "xuni-zhang"; } 
      
int valid_learn(object me) 
{ 
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon")) 
		return notify_fail("练无相指必须空手。\n"); 
      
	if ((int)me->query_skill("force") < 60) 
		return notify_fail("你的内功火候不够，无法学无相指。\n"); 
     
	if ((int)me->query("max_neili") < 300) 
		return notify_fail("你的内力太弱，无法练无相指。\n"); 
      
	if ((int)me->query_skill("finger", 1) < (int)me->query_skill("wuxiang-zhi", 1))
		return notify_fail("你的基本指法水平有限，无法领会更高深的无相指。\n"); 
      
	return 1; 
} 
      
string query_skill_name(int level) 
{ 
	int i; 
	for (i = sizeof(action) - 1; i >= 0; i--) 
		if (level >= action[i]["lvl"]) 
			return action[i]["skill_name"]; 
} 
      
mapping query_action(object me, object weapon) 
{ 
	int i, level; 
	level = (int) me->query_skill("wuxiang-zhi", 1); 
	for (i = sizeof(action); i > 0; i--) 
		if (level > action[i-1]["lvl"]) 
			return action[NewRandom(i, 20, level/5)]; 
} 
      
int practice_skill(object me) 
{ 
	if (me->query_temp("weapon") || 
	    me->query_temp("secondary_weapon")) 
		return notify_fail("你必须空手练习！\n"); 
      
	if ((int)me->query("qi") < 70) 
		return notify_fail("你的体力太低了。\n"); 
      
	if ((int)me->query("neili") < 70) 
		return notify_fail("你的内力不够练无相指。\n"); 
      
	me->receive_damage("qi", 50); 
	me->add("neili", -30); 
	return 1; 
} 
      
string perform_action_file(string action) 
{ 
	return __DIR__"wuxiang-zhi/" + action; 
} 

string query_description()
{
    string msg;

    msg = HIY "【无相指法】" ZJBR NOR;
    msg += "少林七十二绝技之一，指法精妙，蕴含禅机，无形无相，伤人于无形。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  空手状态。" ZJBR;
    msg += "  基本内功等级需达到 " HIY "60" NOR " 级。" ZJBR;
    msg += "  最大内力需达到 " HIB "300" NOR " 点。" ZJBR;
    msg += "  基本指法等级需大于等于无相指法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  指法（finger）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖特殊配合〗" ZJBR NOR; // valid_combine
    msg += "  可与须弥掌互备。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  空手状态。" ZJBR;
    msg += "  气血：不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "30" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform_action_file
    msg += HIC "  无色无相 (wuse)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      必须为少林派弟子。" ZJBR;
    msg += "      无相指法等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "100" NOR " 级。" ZJBR; // 假设对应内功为hunyuan-yiqi，等级要求来自wuse.c
    msg += "      当前内力 " HIB "400" NOR " 点。" ZJBR;
    msg += "      激发指法为无相指法。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      凝聚全身内力于一指，射出无色劲气攻击对手。" ZJBR;
    msg += "      命中判定：随机(自身无相指法等级 + 自身混元一气功等级 + 自身先天臂力 * 10) > (对方基本轻功等级 + 对方基本招架等级 + 对方先天身法 * 10) / 2。" ZJBR; // wuse.c中的命中逻辑
    msg += "      命中后对目标造成气血伤害和创伤。" ZJBR;
    msg += "      伤害计算：约为 (无相指法等级 + 混元一气功等级) / 3 + 随机(无相指法等级 / 2)。" ZJBR; // wuse.c中的伤害逻辑
    msg += "      若无相指法等级 > 200，命中后有几率使目标短时间内无法运功（施加 " HIG "no_exert" NOR " 状态，持续1-3秒）。" ZJBR; // wuse.c中的附加效果
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力消耗 " HIB "400" NOR " 点。" ZJBR;
    msg += "      命中：忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：忙乱 " HIR "3" NOR " 秒。" ZJBR;

    return msg;
}
