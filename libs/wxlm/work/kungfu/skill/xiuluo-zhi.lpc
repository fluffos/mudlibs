int valid_enable(string usage) { return usage == "finger" || usage == "parry"; } 
      
int valid_learn(object me) 
{ 
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon")) 
		return notify_fail("练修罗指必须空手。\n"); 
      
	if ((int)me->query_skill("force") < 200) 
		return notify_fail("你的内功火候不够，无法学修罗指。\n"); 
     
	if ((int)me->query("max_neili") < 800) 
		return notify_fail("你的内力太弱，无法练修罗指。\n"); 
      
	if ((int)me->query_skill("finger", 1) < (int)me->query_skill("xiuluo-zhi", 1))
		return notify_fail("你的基本指法水平有限，无法领会更高深的修罗指。\n"); 
      
	return 1; 
} 
      
string query_skill_name(int level) 
{ 
	int i; 
	for (i = sizeof(action) - 1; i >= 0; i--) 
		if (level >= action[i]["lvl"]) 
			return action[i]["skill_name"]; 
} 
      
mapping query_action(object me, object weapon) 
{ 
	int i, level; 
	level = (int) me->query_skill("xiuluo-zhi", 1); 
	for (i = sizeof(action); i > 0; i--) 
		if (level > action[i-1]["lvl"]) 
			return action[NewRandom(i, 20, level/5)]; 
} 
      
int practice_skill(object me) 
{ 
	if (me->query_temp("weapon") || 
	    me->query_temp("secondary_weapon")) 
		return notify_fail("你必须空手练习！\n"); 
      
	if ((int)me->query("qi") < 70) 
		return notify_fail("你的体力太低了。\n"); 
      
	if ((int)me->query("neili") < 70) 
		return notify_fail("你的内力不够练修罗指。\n"); 
      
	me->receive_damage("qi", 80); 
	me->add("neili", -60); 
	return 1; 
} 
      
string perform_action_file(string action) 
{ 
	return __DIR__"xiuluo-zhi/" + action; 
} 

string query_description()
{
    string msg;

    msg = HIY "【修罗指】" ZJBR NOR;
    msg += "少林七十二绝技之一，是一门招式凶狠毒辣的高级指法。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  必须空手。" ZJBR;
    msg += "  内功有效激发等级：不低于 " HIY "200" NOR " 级。" ZJBR; // force:0
    msg += "  最大内力：不低于 " HIB "800" NOR " 点。" ZJBR;
    msg += "  基本指法等级：不能低于修罗指等级。" ZJBR ZJBR; // finger:1

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  指法（finger）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  必须空手。" ZJBR;
    msg += "  气血：不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "80" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "60" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // hit_ob, valid_damage, skill_improved etc.
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform/exert
    msg += HIC "  修罗绝命指 (jueming)" ZJBR NOR; // 招式名称
    msg += "    使用要求：" ZJBR; // 招式使用要求
    msg += "      修罗指等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      内功有效激发等级 " HIY "250" NOR " 级。" ZJBR; // force:0
    msg += "      当前内力 " HIB "500" NOR " 点。" ZJBR;
    msg += "      激发指法为修罗指。" ZJBR;
    msg += "    效果描述：" ZJBR; // 招式效果描述
    msg += "      瞬间爆发强大的指力，给予敌人致命一击。" ZJBR;
    msg += "      命中判定：自身攻击力 (AP) = (指法有效激发等级 + 内功有效激发等级)，目标防御力 (DP) = (目标轻功有效激发等级 + 目标招架有效激发等级)。若 random(AP) > DP / 2 则命中。" ZJBR; // 命中计算
    msg += "      命中伤害：造成点穴伤害，伤害值约为 (AP / 4) + random(AP / 3)。" ZJBR; // 伤害计算
    msg += "    消耗与代价：" ZJBR; // 消耗与代价
    msg += "      命中：消耗内力 " HIB "350" NOR " 点，自身忙乱 " HIR "1" NOR " 秒。" ZJBR;
    msg += "      未命中：消耗内力 " HIB "150" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;

    return msg;
}
