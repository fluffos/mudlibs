// xiaoyao.c 逍遥无情


#include <combat.h>

inherit F_SSERVER;

string query_name() { return "逍遥"ZJBR"无情"; }

int perform(object me, object target)
{
    object weapon;
    string msg;
    int ap, dp, damage;

    if (! target) target = offensive_target(me);

    if (! target || ! me->is_fighting(target))
        return notify_fail("「逍遥无情」只能对战斗中的对手使用。\n");

    if (! objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "throwing")
        return notify_fail("你使用的武器不对。\n");

    if ((int)me->query_skill("xiaoli-feidao", 1) < 140)
        return notify_fail("你的小李飞刀不够娴熟，不会使用「逍遥无情」。\n");

    if ((int)me->query_skill("force") < 200)
        return notify_fail("你的内功修为不够，不能使用「逍遥无情」。\n");

    if ((int)me->query("neili") < 200)
        return notify_fail("你现在真气不够，不能使用「逍遥无情」。\n");

    if (! me->query_temp("can_throw"))
        return notify_fail("你现在无法施展「逍遥无情」。\n");

    if (me->query_skill_mapped("throwing") != "xiaoli-feidao")
        return notify_fail("你没有激发小李飞刀，无法使用「逍遥无情」。\n");

    msg = HIY "$N" HIY "神色淡然，手中" + weapon->name() + HIY "犹如天外飞仙，携着"
          "无可匹敌的气势射向$n" HIY "！\n" NOR;

    ap = me->query_skill("throwing") + me->query_skill("force") + 
         me->query_skill("dodge");
    dp = target->query_skill("force") + target->query_skill("parry") +
         target->query_skill("dodge");

    me->start_busy(3);
    me->add("neili", -150);
    
    if (COMBAT_D->hit_determination(me,target,ap,dp))
    {
        damage = ap + random(ap / 2);
        msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 75,
                                 HIR "$n" HIR "只觉一股无可抵御的力量袭来，" + 
                                 weapon->name() + HIR "已然射中要害，鲜血狂涌！\n" NOR);
        if (! target->is_busy())
            target->start_busy(2);
    } else
    {
        msg += CYN "$n" CYN "见势不妙，全力防守，终于挡住了这一击。\n" NOR;
    }

    message_combatd(msg, me, target);
    me->reset_action();
    return 1;
}
