// fengliu.c 风流快意


#include <combat.h>

inherit F_SSERVER;

string query_name() { return "风流"ZJBR"快意"; }

int perform(object me, object target)
{
    object weapon;
    string msg;
    int ap, dp, damage;

    if (! target) target = offensive_target(me);

    if (! target || ! me->is_fighting(target))
        return notify_fail("「风流快意」只能对战斗中的对手使用。\n");

    if (! objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "throwing")
        return notify_fail("你使用的武器不对。\n");

    if ((int)me->query_skill("xiaoli-feidao", 1) < 100)
        return notify_fail("你的小李飞刀不够娴熟，不会使用「风流快意」。\n");

    if ((int)me->query_skill("force") < 150)
        return notify_fail("你的内功修为不够，不能使用「风流快意」。\n");

    if ((int)me->query("neili") < 100)
        return notify_fail("你现在真气不够，不能使用「风流快意」。\n");

    if (! me->query_temp("can_throw"))
        return notify_fail("你现在无法施展「风流快意」。\n");

    if (target->is_busy())
        return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧。\n");

    if (me->query_skill_mapped("throwing") != "xiaoli-feidao")
        return notify_fail("你没有激发小李飞刀，无法使用「风流快意」。\n");

    msg = HIY "$N" HIY "一声轻笑，手中" + weapon->name() + HIY "闪电般飞出，直奔$n" 
          HIY "而去！\n" NOR;

    ap = me->query_skill("throwing") + me->query_skill("force");
    dp = target->query_skill("dodge") + target->query_skill("force");

    me->start_busy(2);
    me->add("neili", -80);
    
    if (COMBAT_D->hit_determination(me,target,ap,dp))
    {
        damage = ap / 2 + random(ap / 2);
        msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 55,
                                 HIR "结果$n" HIR "一个闪避不及，被" + weapon->name() +
                                 HIR "射中要害，鲜血飞溅！\n" NOR);
        target->start_busy(2);
    } else
    {
        msg += CYN "可是$n" CYN "早有防备，轻轻一闪，躲过这致命一击。\n" NOR;
    }

    message_combatd(msg, me, target);
    me->reset_action();
    return 1;
}
