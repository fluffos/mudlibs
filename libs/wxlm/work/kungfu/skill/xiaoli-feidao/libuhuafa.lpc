// libuhuafa.c 例不虚发


#include <combat.h>

inherit F_SSERVER;

string query_name() { return "例不虚发"; }

int perform(object me, object target)
{
    object weapon;
    string msg;
    int ap, dp;
    int count;
    int i;

    if (! target) target = offensive_target(me);

    if (! target || ! me->is_fighting(target))
        return notify_fail("「例不虚发」只能对战斗中的对手使用。\n");

    if (! objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "throwing")
        return notify_fail("你使用的武器不对。\n");

    if ((int)me->query_skill("xiaoli-feidao", 1) < 120)
        return notify_fail("你的小李飞刀不够娴熟，不会使用「例不虚发」。\n");

    if ((int)me->query_skill("force") < 180)
        return notify_fail("你的内功修为不够，不能使用「例不虚发」。\n");

    if ((int)me->query("neili") < 150)
        return notify_fail("你现在真气不够，不能使用「例不虚发」。\n");

    if (! me->query_temp("can_throw"))
        return notify_fail("你现在无法施展「例不虚发」。\n");

    if (me->query_skill_mapped("throwing") != "xiaoli-feidao")
        return notify_fail("你没有激发小李飞刀，无法使用「例不虚发」。\n");

    msg = HIW "$N" HIW "长叹一声，手中" + weapon->name() + HIW "接连飞出，宛如流星般射向$n" 
          HIW "！\n" NOR;

    ap = me->query_skill("throwing") + me->query_skill("force");
    dp = target->query_skill("parry") + target->query_skill("dodge");
    
    if (COMBAT_D->hit_determination(me,target,ap,dp))
    {
        msg += HIR "$n" HIR "见来势汹涌，一时难以招架，连连后退！\n" NOR;
        count = ap / 10;
        me->add_temp("apply/attack", count);
    } else
    {
        msg += HIC "$n" HIC "见$N" HIC "来势凶猛，急忙凝神聚气，小心应对。\n" NOR;
        count = 0;
    }

    message_combatd(msg, me, target);
    me->add("neili", -100);

    for (i = 0; i < COMBAT_D->query_base_attack_number(me,query_name()); i++)
    {
        if (! me->is_fighting(target))
            break;

        if (! target->is_busy() && random(3) == 1)
            target->start_busy(1);

        COMBAT_D->do_attack(me, target, weapon, 0);
    }

    me->add_temp("apply/attack", -count);
    me->start_busy(2);
    return 1;
}
