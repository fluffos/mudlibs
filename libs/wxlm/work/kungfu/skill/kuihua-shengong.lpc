int query_effect_dodge(object attacker, object me)
{
	int lvl;
	
	if (! me->query("special_skill/ghost"))
		return 0;

	lvl = me->query_skill("kuihua-shengong", 1);
	if (lvl < 50)  return 0;
	if (lvl < 100) return 30;
	if (lvl < 150) return 40;
	if (lvl < 200) return 60;
	if (lvl < 250) return 80;
	if (lvl < 300) return 100;
	if (lvl < 350) return 120;
	return 130;
}

int valid_learn(object me)
{
        object weapon;
                
        if ((int)me->query_skill("kuihua-shengong", 1) < 180)
                return notify_fail("葵花神功太低了，你只能通过研读《葵阳宝录》来学习。\n"); 
        if ((int)me->query_skill("tianmo-jian", 1) > 0)
                return notify_fail("你不散去天魔剑法如何能研习《葵阳宝录》？。\n");
        if ((int)me->query_skill("pixie-jian", 1) > 0)
                return notify_fail("你不散去胜邪剑法如何能研习《葵阳宝录》？。\n");
        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "pin" )
                return notify_fail("你使用的武器不对。\n");

        if (me->query_skill("force", 1) < me->query_skill("kuihua-shengong", 1))
                return notify_fail("你对基本内功的理解还不够。\n");
        return 1;
}
int difficult_level()
{
     object me; 
     int lv;
     me = this_player(); 
     lv = me->query_skill("kuihua-shengong", 1) - 180; 
     if (lv > 200) lv = 200; 
     
     if (! me->query("special_skill/ghost"))
	return 1000;
     else
	return 600 - lv;

}

mixed hit_ob(object me, object target)
{
    int skill_level, attack_count, i;
    object weapon;

    me = this_player();
    weapon = me->query_temp("weapon");

    if (!target) target = me->select_opponent();
    if (!weapon) return;

    skill_level = me->query_skill("kuihua-shengong", 1);
    attack_count = to_int(skill_level / 150);

    if (me->query_temp("auto_hit", 1)) {
        me->add_temp("auto_hit", -1);
        return;
    }

    if (skill_level >= 200 && me->query_skill_mapped("sword") == "kuihua-shengong" && weapon->query("skill_type") == "pin") 
    {
        me->set_temp("auto_hit", attack_count);

        for (i = 0; i < attack_count; i++) {
            me->set_temp("action_flag", 1);

            if (random(3) == 1) //3分之一的概率直接触发平a效果
            {
                COMBAT_D->do_attack(me, target, weapon);
            }
            else if (COMBAT_D->get_skill_aoyi_level(me,"日月无光")) //3分之二的概率进入日月无光判定，叠加等同于意境层数 * 20的命中。
            {
                int attack_add;

                attack_add = COMBAT_D->get_skill_aoyi_level(me,"日月无光") * 50;
                me->add_temp("apply/attack", attack_add);
                me->add_temp("kuihua_attack", attack_add);
                target->add_temp("apply/armor", -attack_add);
            }

            me->set_temp("action_flag", 0);
        }

        if (COMBAT_D->get_skill_aoyi_level(me,"日月无光"))
        {
                me->add_temp("apply/attack", -me->query_temp("kuihua_attack"));
                target->add_temp("apply/armor", me->query_temp("kuihua_attack"));
                me->delete_temp("kuihua_attack");
        }

        me->delete_temp("auto_hit", 1);
        return 1;
    }
}

int valid_force(string force)
{
	return force == "xixing-dafa" ||
	       force == "guixi-gong" ||
	       force == "riyue-xinfa" ||
	       force == "jiaohua-neigong" ||
	       force == "luoying-xinfa" ||
	       force == "kuihua-xinfa";
}

string perform_action_file(string action)
{
        return __DIR__"kuihua-shengong/perform/" + action;
}

//int double_attack(object me){ return 1;}
string exert_function_file(string func)
{
       return __DIR__"kuihua-shengong/exert/" + func;
}

string query_description()
{
    string msg;

    msg = HIY "【葵花神功】" NOR ZJBR ZJBR;
    msg += WHT "源自《葵阳宝录》的绝世武学，融合内功、剑法、招架、轻功于一体，以迅捷诡异、凌厉狠辣著称。" ZJBR;
    msg += WHT "此功修炼艰深，非心志坚定、放下俗念者不可成。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  前 180 级：通过研读《葵阳宝录》学习。" ZJBR;
    msg += "  180 级以上：" ZJBR;
    msg += "    未修炼 天魔剑法 (`tianmo-jian`) 或 辟邪剑法 (`pixie-jian`)。" ZJBR;
    msg += "    装备 针 (`pin`) 类武器。" ZJBR;
    msg += "    基本内功 (`force`) 等级不低于葵花神功等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  内功 (`force`)。" ZJBR;
    msg += "  剑法 (`sword`)。" ZJBR;
    msg += "  招架 (`parry`)。" ZJBR;
    msg += "  轻功 (`dodge`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  无法通过练习 (`practice`) 提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  " HIM "内力提升 (query_neili_improve)" NOR ":" ZJBR;
    msg += "    效果：提升内力上限。拥有 鬼脉 (`ghost`) 天赋者效果更佳。" ZJBR;
    msg += "    公式：`等级 * 等级 * 系数 * 15 / 100 / 200` (系数：无天赋15，有天赋21)。" ZJBR;
    msg += "  " HIM "轻功闪避 (query_effect_dodge)" NOR ":" ZJBR;
    msg += "    触发条件：拥有 鬼脉 (`ghost`) 天赋。" ZJBR;
    msg += "    效果：提升轻功的闪避效果，加成值随葵花神功等级提升 (50级+30，100级+40 ... 350级+130)。" ZJBR;
    msg += "  " HIM "特殊闪避 (valid_damage)" NOR ":" ZJBR;
    msg += "    触发条件：葵花神功等级不低于100，拥有 鬼脉 (`ghost`) 天赋，激发相关技能，处于特定闪避状态。" ZJBR;
    msg += "    效果：几率完全闪避一次攻击并免疫伤害。" ZJBR;
    msg += "    判定：综合比较双方 轻功激发等级、葵花神功等级、先天身法 和 易经算术 (`count`) 等级。" ZJBR;
    msg += "          自身先天身法高于对手越多，闪避成功率越高。" ZJBR;
    msg += "          会被高深的 易经算术 (`count` >= 100) 克制。" ZJBR;
    msg += "  " HIM "日月无光 (hit_ob)" NOR ":" ZJBR;
    msg += "    触发条件：葵花神功等级不低于200，激发剑法为葵花神功，装备针类武器。" ZJBR;
    msg += "    效果：普通攻击命中时，发动 `等级 / 150` 次额外攻击。" ZJBR;
    msg += "          每次额外攻击有 1/3 概率为普通攻击，2/3 概率判定意境 日月无光。" ZJBR;
    msg += "          拥有 日月无光 意境时，临时提升自身攻击力并降低目标防御力 (数值 = 意境层数 * 50)，然后发动攻击。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (Perform / Exert)〗" ZJBR NOR;

    msg += HIC "  绝目 (juemu) [Perform]" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      葵花神功等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "      激发剑法为葵花神功，且装备武器。" ZJBR;
    msg += "      仅限战斗中使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      发动一次强力攻击，临时提升自身攻击力 (提升值 = 葵花神功等级 / 2)。" ZJBR;
    msg += "      命中判定：综合比较双方 剑法激发等级 和 后天身法 (`AP = 自身剑法激发 + 身法*20`, `DP = 目标招架激发 + 身法*20`, `AP/2 + random(AP) > DP` 则命中)。" ZJBR;
    msg += "      伤害计算：命中后造成 `自身剑法激发等级 / 2 + 随机(自身剑法激发等级 / 2)` 的伤害。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 " HIB "100" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;
    msg += "      未命中：消耗内力 " HIB "40" NOR " 点，自身忙乱 " HIR "4" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  群魔乱舞 (luanwu) [Perform]" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      葵花神功等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "      激发剑法为葵花神功，且装备武器。" ZJBR;
    msg += "      仅限战斗中使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标发动多次连续攻击 (基础5次，额外增加 `1 + 随机(先天身法/10)` 次)。" ZJBR;
    msg += "      临时提升自身攻击力与伤害 (提升值 = 葵花神功等级 / 7)。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      自身忙乱 `(攻击次数 / 4) + 2` 秒。" ZJBR ZJBR;

    msg += HIC "  战气 (powerup) [Exert]" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      葵花神功等级不低于 " HIY "60" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升自身攻击力 (`apply/attack`) 和招架 (`apply/parry`)，数值约为 `葵花神功等级 / 3`。" ZJBR;
    msg += "      效果持续 `葵花神功等级 / 25` 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR ZJBR;

    msg += HIC "  护体 (shield) [Exert]" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      葵花神功等级不低于 " HIY "60" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升自身防御力 (`apply/armor`)，数值约为 `葵花神功等级 / 3`。" ZJBR;
    msg += "      效果持续 `葵花神功等级 / 25` 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "200" NOR " 点。" ZJBR ZJBR;

    msg += HIC "  天地潜行 (tian) [Exert]" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      葵花神功等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      先天身法 (`dex`) 不低于 " HIY "35" NOR " 点。" ZJBR;
    msg += "      当前内力不低于 " HIB "200" NOR " 点，精力不低于 " HIG "100" NOR " 点。" ZJBR;
    msg += "      激发轻功为葵花神功，不在运功 (`powerup`) 状态。" ZJBR;
    msg += "      仅限非战斗中使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升自身躲闪 (`apply/dodge`) 和攻击速度 (`apply/attack`)，持续 `葵花神功等级 / 20` 秒。" ZJBR;
    msg += "      提升数值与葵花神功等级、先天及后天身法相关。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "200" NOR " 点，精力 " HIG "100" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "1" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  鬼魅身法 (guimei) [Exert]" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      葵花神功等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "150" NOR " 点。" ZJBR;
    msg += "      激发招架为葵花神功。" ZJBR;
    msg += "      仅限战斗中使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标施加忙乱 (`busy`) 状态。" ZJBR;
    msg += "      命中判定：综合比较双方 招架激发等级 和 后天身法 (`AP = 自身招架激发 + 身法*10`, `DP = 目标招架激发 + 身法*10`, `AP/2 + random(AP) > DP` 则命中)。" ZJBR;
    msg += "      成功后目标忙乱 `(葵花神功等级 / 50) + 2` 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 葵花神功的学习和使用条件较为苛刻，特别是高级阶段需要特定武器和避免修炼冲突武学。" ZJBR;
    msg += "2. 被动效果中的 特殊闪避 和 日月无光 对天赋、等级、装备和意境有要求。" ZJBR;
    msg += "3. Perform 和部分 Exert 招式仅能在战斗中使用，注意区分。" ZJBR;
    msg += "4. 天地潜行 仅能在非战斗中使用，用于提升短期内的战斗能力。" ZJBR;
    msg += "5. 熟练运用各种 Exert 辅助招式和 Perform 主动攻击招式是发挥葵花神功威力的关键。" ZJBR;

    return msg;
}