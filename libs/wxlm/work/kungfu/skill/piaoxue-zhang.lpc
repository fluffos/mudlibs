int valid_enable(string usage) { return usage == "strike" ||  usage == "parry"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练寒雪断云掌必须空手。\n");

	if (me->query("con") < 23 || me->query_con() < 50)
		return notify_fail("你的根骨欠佳，不能练寒雪断云掌。\n");

	if (me->query("str") < 24 || me->query_str() < 52)
		return notify_fail("你的臂力孱弱，不能练寒雪断云掌。\n");

	if (me->query_skill("force") < 200)
		return notify_fail("你的内功火候不够，不能练寒雪断云掌。\n");

	if (me->query_skill("strike", 1) < 100)
		return notify_fail("你的掌法根基不够，不能练寒雪断云掌。\n");

	if (me->query("max_neili") < 2200)
		return notify_fail("你的内力修为太浅，无法练寒雪断云掌。\n");

	if (me->query_skill("strike", 1) < me->query_skill("sixiang-zhang", 1))
		return notify_fail("你的基本掌法太差，无法领会更高深的寒雪断云掌。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i-1]["lvl"])
			return action[i-1]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level   = (int)me->query_skill("piaoxue-zhang",1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 100)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 120)
		return notify_fail("你的内力不够练习寒雪断云掌。\n");

	if (me->query_skill("sixiang-zhang", 1) < 100)
	{
		me->receive_damage("qi", 60);
		me->add("neili", -80);
	} else
	{
		me->receive_damage("qi", 80);
		me->add("neili", -100);
	}
	return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	int lvl;

	lvl = me->query_skill("piaoxue-zhang", 1);

	if (damage_bonus < 180 || lvl < 160) return 0;

	if (damage_bonus / 6 > victim->query_con() && random(4) == 0)
	{
		victim->receive_wound("qi", (damage_bonus - 140) / 3, me);
			return HIR "只听$n" HIR "前胸“喀嚓”一声闷响，竟"
			       "似折断了一跟肋骨。"NOR"\n";
	}
}

string perform_action_file(string action)
{
	return __DIR__"piaoxue-zhang/"+ action;
}

string query_description()
{
    string msg;

    msg = HIY "【寒雪断云掌】" ZJBR NOR;
    msg += WHT "寒雪断云掌是一门威力强大的掌法，以其迅猛凌厉的招式著称。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "    空手状态。" ZJBR;
    msg += "    先天根骨 ≥ " HIY "23" NOR " 点。" ZJBR;
    msg += "    后天根骨 ≥ " HIY "50" NOR " 点。" ZJBR;
    msg += "    先天臂力 ≥ " HIY "24" NOR " 点。" ZJBR;
    msg += "    后天臂力 ≥ " HIY "52" NOR " 点。" ZJBR;
    msg += "    内功激发等级 ≥ " HIC "200" NOR " 级。" ZJBR;
    msg += "    基本掌法等级 ≥ " HIC "100" NOR " 级。" ZJBR;
    msg += "    最大内力 ≥ " HIB "2200" NOR " 点。" ZJBR;
    msg += "    基本掌法等级 ≥ 寒雪断云掌等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "    掌法 (strike)" ZJBR;
    msg += "    招架 (parry)" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "    气血 ≥ " HIR "100" NOR " 点。" ZJBR;
    msg += "    内力 ≥ " HIB "120" NOR " 点。" ZJBR;
    msg += "    每次练习消耗：" ZJBR;
    msg += "      若寒雪断云掌 < 100 级：气血 " HIR "60" NOR " 点，内力 " HIB "80" NOR " 点。" ZJBR;
    msg += "      若寒雪断云掌 ≥ 100 级：气血 " HIR "80" NOR " 点，内力 " HIB "100" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "    攻击命中特效 (`hit_ob`)：" ZJBR;
    msg += "      当寒雪断云掌 ≥ " HIY "160" NOR " 级且单次伤害加成 ≥ " HIY "180" NOR " 时：" ZJBR;
    msg += "        有 " HIC "25%" NOR " 几率对后天根骨低于 (伤害加成 / 6) 的目标造成额外气血伤害。" ZJBR;
    msg += "        额外气血伤害 = (伤害加成 - 140) / 3。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (perform)〗" ZJBR NOR;

    msg += HIC "  佛光普照 (zhao)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      寒雪断云掌 ≥ " HIY "180" NOR " 级。" ZJBR;
    msg += "      内功激发等级 ≥ " HIC "300" NOR " 级。" ZJBR;
    msg += "      最大内力 ≥ " HIB "3500" NOR " 点。" ZJBR;
    msg += "      当前内力 ≥ " HIB "1000" NOR " 点。" ZJBR;
    msg += "      激发掌法为寒雪断云掌。" ZJBR;
    msg += "      空手状态。" ZJBR;
    msg += "      不在 `powerup` 状态下。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标发动一次强力攻击。" ZJBR;
    msg += "      命中判定：(自身寒雪断云掌等级 + 自身内功激发等级 + 自身后天臂力 * 5) > (对方轻功激发等级 + 对方内功激发等级 + 对方后天根骨 * 5)。" ZJBR;
    msg += "      伤害计算：基础威力值 = (寒雪断云掌等级 + 内功激发等级 + 后天臂力 * 10) / 3。最终伤害约为 随机(威力值 / 2) + 威力值 / 2。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力 " HIB "800" NOR " 点，忙乱 " HIR "3" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "500" NOR " 点，忙乱 " HIR "5" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  云海明灯 (yun)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      寒雪断云掌 ≥ " HIY "150" NOR " 级。" ZJBR;
    msg += "      内功激发等级 ≥ " HIC "200" NOR " 级。" ZJBR;
    msg += "      最大内力 ≥ " HIB "2000" NOR " 点。" ZJBR;
    msg += "      当前内力 ≥ " HIB "200" NOR " 点。" ZJBR;
    msg += "      激发掌法为寒雪断云掌。" ZJBR;
    msg += "      空手状态。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      连续攻击目标 " HIC "3" NOR " 次。" ZJBR;
    msg += "      每次攻击临时提升攻击力：第 1 次 +30，第 2 次 +90，第 3 次 +150。" ZJBR;
    msg += "      命中及伤害依赖常规战斗判定。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力：" HIB "100" NOR " 点。" ZJBR;
    msg += "      忙乱：" HIR "3" NOR " 秒。" ZJBR ZJBR;

    return msg;
}