// throwing.c
// modified by Venus Oct.1997
inherit SKILL;

string query_description()
{
    string msg;

    msg = HIY "【基本暗器】" ZJBR NOR;
    msg += "基本暗器是各类暗器技能的根基，掌握了它才能学习更为高深的暗器技能。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  无特殊要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  暗器（throwing）。" ZJBR ZJBR;

    msg += HIY "〖技能效果〗" ZJBR NOR;
    msg += "  提高暗器的命中率和伤害。" ZJBR;
    msg += "  为各类高级暗器技能提供基础。" ZJBR;

    return msg;
}

