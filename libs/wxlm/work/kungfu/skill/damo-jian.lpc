	msg += "                 与 (目标激发内功等级 * 2)。" + ZJBR;
	msg += "      命中后暂时移除目标身上由 `powerup` 带来的临时攻击力和防御力加成。" + ZJBR;
	msg += "      效果持续时间约为 (自身激发剑法等级 + 内功等级) / 20 秒。" + ZJBR;
	msg += "    消耗与代价：" + ZJBR;
	msg += "      内力 " HIB "200" NOR " 点。" + ZJBR;
	msg += "      自身忙乱 " HIR "2" NOR " 秒。" + ZJBR + ZJBR;

	msg += HIC "  伤神剑 (shang)" + ZJBR NOR;
	msg += "    使用要求：" + ZJBR;
	msg += "      需要习得此招。" + ZJBR;
	msg += "      达摩剑法等级 " HIY "200" NOR " 级。" + ZJBR;
	msg += "      当前内力不低于 " HIB "300" NOR " 点。" + ZJBR;
	msg += "      装备剑类武器，激发剑法为达摩剑法。" + ZJBR;
	msg += "      战斗中使用。" + ZJBR;
	msg += "    效果描述：" + ZJBR;
	msg += "      命中判定：比较 ((自身激发剑法等级 + 内功等级) / 3 + 随机(自身激发剑法等级 + 内功等级))" + ZJBR;
	msg += "                 与 (目标激发内功等级 * 2)。" + ZJBR;
	msg += "      命中后：" + ZJBR;
	msg += "        造成精神伤害：伤害值约为 ((自身激发剑法等级 + 内功等级) / 40)，并造成减半的精神损伤。" + ZJBR;
	msg += "        附加「伤神」状态：等级与(自身激发剑法等级 + 内功等级)相关，" + ZJBR;
	msg += "                          持续时间与(自身激发剑法等级 + 内功等级)相关（通常影响精神或导致晕眩）。" + ZJBR;
	msg += "    消耗与代价：" + ZJBR;
	msg += "      内力 " HIB "200" NOR " 点。" + ZJBR;
	msg += "      命中：自身忙乱 " HIR "2" NOR " 秒。" + ZJBR;
	msg += "      未命中：自身忙乱 " HIR "1" NOR " 秒。" + ZJBR + ZJBR;

	msg += HIC "  折元剑 (zhe)" + ZJBR NOR;
	msg += "    使用要求：" + ZJBR;
	msg += "      需要习得此招。" + ZJBR;
	msg += "      达摩剑法等级 " HIY "200" NOR " 级。" + ZJBR;
	msg += "      当前内力不低于 " HIB "300" NOR " 点。" + ZJBR;
	msg += "      装备剑类武器，激发剑法为达摩剑法。" + ZJBR;
	msg += "      战斗中使用。" + ZJBR;
	msg += "    效果描述：" + ZJBR;
	msg += "      命中判定：比较 ((自身激发剑法等级 + 内功等级) / 3 + 随机(自身激发剑法等级 + 内功等级))" + ZJBR;
	msg += "                 与 (目标激发内功等级 * 2)。" + ZJBR;
	msg += "      命中后：" + ZJBR;
	msg += "        造成气血和精神伤害：基础伤害值约为 ((自身激发剑法等级 + 内功等级) / 40)。" + ZJBR;
