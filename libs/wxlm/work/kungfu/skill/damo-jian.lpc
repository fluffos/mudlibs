int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 300)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("force") < 60)
		return notify_fail("你的内功火候太浅。\n");

	if ((int)me->query_skill("sword", 1) < (int)me->query_skill("damo-jian", 1))
		return notify_fail("你的基本剑法水平有限，无法领会更高深的达摩剑法。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action) - 1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("damo-jian", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon")) ||	
	    (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力不够练达摩剑。\n");

	if ((int)me->query("neili") < 70)
		return notify_fail("你的内力不够练达摩剑。\n");

	me->receive_damage("qi", 62);
	me->add("neili", -69);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"damo-jian/" + action;
}

string query_description()
{
	string msg;

	msg = HIY "【达摩剑法】" ZJBR NOR;
	msg += "少林七十二绝技之一，传说为达摩祖师所创。剑法禅意深邃，" ZJBR;
	msg += "招式古朴，看似平平无奇，实则蕴含无穷变化，乃少林派高级剑法。" ZJBR ZJBR; // 基本介绍

	msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
	msg += "  最大内力不低于 " HIB "300" NOR " 点。" ZJBR;
	msg += "  基本内功等级不低于 " HIY "60" NOR " 级。" ZJBR;
	// msg += "  需要少林派弟子身份或特殊许可。" ZJBR; // SHAOLIN_SKILL 继承处理
	msg += "  基本剑法等级需大于等于达摩剑法等级。" ZJBR ZJBR;

	msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
	msg += "  剑法（sword）。" ZJBR;
	msg += "  招架（parry）。" ZJBR ZJBR;

	msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
	msg += "  装备武器为剑。" ZJBR;
	msg += "  气血：不低于 " HIR "70" NOR " 点。" ZJBR;
	msg += "  内力：不低于 " HIB "70" NOR " 点。" ZJBR;
	msg += "  每次练习消耗气血：" HIR "62" NOR " 点。" ZJBR;
	msg += "  每次练习消耗内力：" HIB "69" NOR " 点。" ZJBR + ZJBR;

	msg += HIY "〖攻防特效/被动效果〗" + ZJBR + NOR; // hit_ob, valid_damage, skill_improved etc.
	msg += "  无。" + ZJBR + ZJBR;

	msg += HIY "〖特殊招式〗" + ZJBR + NOR; // perform_action_file

	msg += HIC "  达摩三绝剑 (sanjue)" + ZJBR NOR;
	msg += "    使用要求：" + ZJBR;
	msg += "      基本剑法 " HIY "200" NOR " 级，基本轻功 " HIY "200" NOR " 级，基本内功 " HIY "200" NOR " 级。" + ZJBR;
	msg += "      先天身法不低于 " HIY "30" NOR " 点。" + ZJBR;
	msg += "      当前内力不低于 " HIB "150" NOR " 点。" + ZJBR;
	msg += "      装备剑类武器，激发剑法为达摩剑法。" + ZJBR;
	msg += "      战斗中使用。" + ZJBR;
	msg += "    效果描述：" + ZJBR;
	msg += "      发动多次攻击（次数由系统判定），第二、三次攻击临时增加攻击力 40 点。" + ZJBR;
	msg += "      每次攻击进行独立命中和伤害判定：" + ZJBR;
	msg += "        命中算法：综合判定双方攻防等级、临时状态、身法、福缘等因素。" + ZJBR;
	msg += "        伤害算法：根据双方状态、装备、技能等级计算基础武器伤害，受临时攻击力加成，" + ZJBR;
	msg += "                 并受目标防御、护甲、内功减伤等因素影响。" + ZJBR;
	msg += "    消耗与代价：" + ZJBR;
	msg += "      内力 " HIB "75" NOR " 点。" + ZJBR;
	msg += "      自身忙乱 " HIR "1 ~ 3" NOR " 秒。" + ZJBR + ZJBR;

	msg += HIC "  乱气剑 (luan)" + ZJBR NOR;
	msg += "    使用要求：" + ZJBR;
	msg += "      需要习得此招。" + ZJBR;
	msg += "      达摩剑法等级 " HIY "200" NOR " 级。" + ZJBR;
	msg += "      当前内力不低于 " HIB "300" NOR " 点。" + ZJBR;
	msg += "      装备剑类武器，激发剑法为达摩剑法。" + ZJBR;
	msg += "      战斗中使用。" + ZJBR;
	msg += "    效果描述：" + ZJBR;
