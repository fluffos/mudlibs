([  "action" : "$N双拳覆盖寒霜,使出" HIW "冰封万里" NOR ",朝$n的$l猛然击出",
    "force" : 220,
    "attack": 75,
    "dodge" : 45,
    "parry" : 45,
    "damage": 110,
    "lvl"   : 0,
    "skill_name" : "冰封万里",
    "damage_type" : "瘀伤"
]),
([  "action" : "$N一式" HIC "寒冰绝手" NOR ",双掌宛如冰刃,劈向$n的$l",
    "force" : 260,
    "attack": 85,
    "dodge" : 50,
    "parry" : 50,
    "damage": 130,
    "lvl"   : 30,
    "skill_name" : "寒冰绝手",
    "damage_type" : "割伤"
]),
([  "action" : "$N使出" HIB "玄冰幻影" NOR ",身形幻化出数道残影,齐齐向$n攻去",
    "force" : 300,
    "attack": 95,
    "dodge" : 55,
    "parry" : 55,
