    "lvl"   : 90,
    "skill_name" : "冰雪风暴",
    "damage_type" : "内伤"
]),
});

int valid_enable(string usage) { return usage == "cuff" || usage == "parry"; }

int valid_learn(object me)
{
    if (me->query("family/family_name"))
        return notify_fail("玄冰寒霜拳只有无门派的人才能学习。\n");

    if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
        return notify_fail("练习玄冰寒霜拳必须空手。\n");

    if ((int)me->query_skill("force") < 120)
        return notify_fail("你的内功火候不够，无法练习玄冰寒霜拳。\n");

    if ((int)me->query("max_neili") < 900)
        return notify_fail("你的内力太弱，无法练习玄冰寒霜拳。\n");

    if ((int)me->query_skill("cuff", 1) < 90)
        return notify_fail("你的基本拳法火候不够，无法练习玄冰寒霜拳。\n");

    if ((int)me->query_skill("cuff", 1) < (int)me->query_skill("xuanbing_hanshuang", 1))
        return notify_fail("你的基本拳法水平有限，无法领会更高深的玄冰寒霜拳。\n");

    return 1;
}

string query_skill_name(int level)
{
    int i;
    for (i = sizeof(action) - 1; i >= 0; i--)
        if (level >= action[i]["lvl"])
            return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    int i, level;
    level = (int) me->query_skill("xuanbing_hanshuang", 1);
    for (i = sizeof(action); i > 0; i--)
        if (level > action[i-1]["lvl"])
            return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    if ((int)me->query("qi") < 65)
        return notify_fail("你的体力太低了。\n");

    if ((int)me->query("neili") < 65)
        return notify_fail("你的内力不够练玄冰寒霜拳。\n");

    me->receive_damage("qi", 55);
    me->add("neili", -60);
    return 1;
}

string perform_action_file(string action)
{
    return __DIR__"xuanbing_hanshuang/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
    int lvl;
    int i;

    lvl = me->query_skill("xuanbing_hanshuang", 1);
    i = random(lvl);

    if (i < 50)
        return 0;

    if (i < 100)
    {
        victim->receive_wound("qi", damage_bonus / 5);
        return HIW "$N" HIW "拳劲裹挟着寒气,令$n" HIW "感到一阵刺骨冰凉！"NOR"\n";
    }
    else if (i < 150)
    {
        victim->receive_wound("qi", damage_bonus / 4);
        victim->apply_condition("ice_poison", random(lvl / 5) + (me->query("jiali") / 10));
        return HIC "$N" HIC "拳势凌厉,$n" HIC "被击中后只觉得伤处寒气入骨,难以驱散！"NOR"\n";
    }
    else
    {
        victim->receive_wound("qi", damage_bonus / 3);
        victim->apply_condition("ice_poison", random(lvl / 3) + (me->query("jiali") / 8));
        return HIB "$N" HIB "玄冰寒霜拳劲力爆发,$n" HIB "被重创的同时全身都被寒气所侵,几欲冻僵！"NOR"\n";
    }
}

string query_description()
{
    string msg;

    msg = HIW "【玄冰寒霜拳】" ZJBR NOR;
    msg += "一门以寒冰内劲伤敌的奇特拳法，招式蕴含极寒之气。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  必须为无门派人士。" ZJBR;
    msg += "  必须空手才能学习。" ZJBR;
    msg += "  内功有效激发等级需大于等于 " HIY "120" NOR " 级。" ZJBR;
    msg += "  最大内力需大于等于 " HIB "900" NOR " 点。" ZJBR;
    msg += "  基本拳法等级需大于等于 " HIY "90" NOR " 级。" ZJBR;
    msg += "  基本拳法等级不得低于玄冰寒霜拳等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  拳法（cuff）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  气血：不低于 " HIR "65" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "65" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "55" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "60" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // hit_ob
    msg += "  普通攻击命中目标时，有几率触发寒气入体效果（触发几率受玄冰寒霜拳等级影响）：" ZJBR;
    msg += "  1. 造成额外气血创伤 (伤害加成 / 5)，并提示刺骨冰凉。" ZJBR;
    msg += "  2. 造成更高额外气血创伤 (伤害加成 / 4)，附加「" HIC "寒冰毒" NOR "」状态 (强度: 随机(玄冰寒霜拳等级 / 5) + 加力值 / 10)。" ZJBR;
    msg += "  3. 造成最高额外气血创伤 (伤害加成 / 3)，附加更强「" HIB "寒冰毒" NOR "」状态 (强度: 随机(玄冰寒霜拳等级 / 3) + 加力值 / 8)。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform_action_file -> bingfeng.c
    msg += HIC "  冰封天下 (bingfeng)" ZJBR NOR; // 招式名称
    msg += "    使用要求：" ZJBR; // 招式使用要求
    msg += "      玄冰寒霜拳等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      内功有效激发等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      激发拳法为玄冰寒霜拳。" ZJBR;
    msg += "    效果描述：" ZJBR; // 招式效果描述
    msg += "      提升自身攻击力（提升值：玄冰寒霜拳等级 / 3）和伤害（提升值：玄冰寒霜拳等级 / 2 + 内功有效激发等级 / 5），持续一段时间（持续时间：玄冰寒霜拳等级 / 40 秒）。" ZJBR;
    msg += "      对目标发动一次强力攻击，并附加「" HIM "寒冰毒" NOR "」状态（强度: 玄冰寒霜拳等级 / 20 + 加力值 / 10）。" ZJBR;
    msg += "    消耗与代价：" ZJBR; // 消耗与代价
    msg += "      内力 " HIB "250" NOR " 点。" ZJBR;
    msg += "      忙乱 " HIR "2" NOR " 秒。" ZJBR;

    return msg;
}