([      "action": "$N踏上一步，忽地在地上一坐，已抱住了$n小腿。十指扣向$n小腿上的中都和"
		  "筑宾两穴",
	"force" : 180,
	"attack": 70,
	"dodge" : 30,
	"damage": 30,
	"parry" : 70,
	"lvl"   : 0,
	"damage_type": "割伤"
]),
([      "action": "突然之间，$N身形晃动，同时欺近，手中$w往$n身上划去。脚下不知如何移动，"
		  "\n身形却已早变。右手同时抓向$n的后领",
	"force" : 240,
	"attack": 80,
	"dodge" : 33,
