	"parry" : 99,
	"damage": 72,
	"lvl"   : 160,
	"damage_type": "割伤"
]),
([      "action": "$N忽然低头，一个头锤向$n撞来，$n不动声色，向旁又是一让，突觉胸口一麻，"
		  "\n$N手中$w急挥横扫，突然连翻三个空心筋斗，$w已到$n右肩",
	"force" : 360,
	"attack": 100,
	"dodge" : 50,
	"parry" : 100,
	"damage": 100,
	"lvl"   : 180,
	"damage_type": "割伤"
])
});

int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me)
{
	if ((int)me->query_skill("force") < 200)
		return notify_fail("你的内功火候不到，无法学习圣火令法。\n");

	if (me->query("max_neili") < 1200)
		return notify_fail("你的内功修为不足，无法学习圣火令法。\n");

	if (me->query_int() < 35)
		return notify_fail("你现在无法领悟圣火令法的要诣。\n");

	if (me->query_dex() < 25)
		return notify_fail("你现在身法太差，无法学习圣火令法。\n");

	if (me->query_skill("sword", 1) < me->query_skill("shenghuo-ling", 1))
		return notify_fail("你的基本剑法水平有限，无法领会更高深的圣火令法。\n");

	return 1;
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("shenghuo-ling", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon")) || 
	    (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");

	if (me->query_skill("shenghuo-ling", 1) < 180)
		return notify_fail("你还没有掌握圣火令法中所有的奥妙，无法通过锻炼获得提升。\n");

	if ((int)me->query("qi") < 80)
		return notify_fail("你的体力不够练圣火令法。\n");

	if ((int)me->query("neili") < 80)
		return notify_fail("你的内力不够练圣火令法。\n");

	me->receive_damage("qi", 50);
	me->add("neili", -70);

	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"shenghuo-ling/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【圣火令法】" ZJBR ZJBR NOR;
    msg += WHT "源自波斯明教的镇教武功，记载于圣火令之上。招式诡异绝伦，变化繁复，与中土武学迥异。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  内功激发等级不低于 " HIY "200" NOR " 级。" ZJBR;
    msg += "  最大内力不低于 " HIB "1200" NOR " 点。" ZJBR;
    msg += "  先天悟性不低于 " HIM "35" NOR " 点。" ZJBR;
    msg += "  先天身法不低于 " HIG "25" NOR " 点。" ZJBR;
    msg += "  基本剑法等级不得低于圣火令法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  剑法 (sword)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须装备剑类武器。" ZJBR;
    msg += "  圣火令法等级达到 " HIY "180" NOR " 级后方可通过练习提升。" ZJBR;
    msg += "  气血不低于 " HIR "80" NOR " 点。" ZJBR;
    msg += "  内力不低于 " HIB "80" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "70" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无特殊被动效果。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += CYN "  吸焰令 (xiyan)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      圣火令法等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      内功激发等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      吸取目标内力，吸取量约为 (`圣火令法等级 + 随机(圣火令法等级)`)，上限为目标当前内力。" ZJBR;
    msg += "      吸取的内力将补充自身内力，但不超过自身内力上限。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "2" NOR " 回合。" ZJBR ZJBR;

    msg += CYN "  圣火连心 (lianxin)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      圣火令法等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      内功激发等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标发动连续攻击，最多可攻击 " HIW "5" NOR " 次，每次命中消耗一次攻击计数。" ZJBR;
    msg += "      命中及伤害与圣火令法等级相关。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "3" NOR " 回合。" ZJBR ZJBR;

    msg += CYN "  圣火辉煌 (guanghua)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      圣火令法等级 " HIY "200" NOR " 级。" ZJBR;
    msg += "      内功激发等级 " HIY "200" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "500" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升自身攻击力和伤害，提升数值约为 (`圣火令法等级 / 3`)。" ZJBR;
    msg += "      效果持续时间为 (`圣火令法等级 / 2`) 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "3" NOR " 回合。" ZJBR ZJBR;

    msg += CYN "  残血令 (canxue)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      圣火令法等级 " HIY "250" NOR " 级。" ZJBR;
    msg += "      内功激发等级 " HIY "200" NOR " 级。" ZJBR;
    msg += "      最大内力 " HIB "1500" NOR " 点。" ZJBR;
    msg += "      当前内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标发动 " HIW "6" NOR " 次急速攻击。" ZJBR;
    msg += "      每次攻击的伤害与双方状态及最大伤害限制 (`max_hit_damage`) 相关。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "120" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "1-6" NOR " 回合（随机）。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 需装备剑类武器方可施展。圣火令本身也可作为剑类武器。" ZJBR;
    msg += "2. 圣火令法等级达到 180 级后才能通过练习提升。" ZJBR;
    msg += "3. 招式繁多，效果各异，涵盖吸内、连击、强化、爆发等多种类型。" ZJBR;
    msg += "4. '残血令' 威力巨大，但自身忙乱时间随机，使用需谨慎。\n";

    return msg;
}