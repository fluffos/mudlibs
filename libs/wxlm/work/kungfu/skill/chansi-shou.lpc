int valid_enable(string usage) { return usage == "hand" || usage == "parry"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练缠丝擒拿手必须空手。\n");

	if ((int)me->query_skill("force") < 40)
		return notify_fail("你的内功火候不够，无法学缠丝擒拿手。\n");

	if ((int)me->query("max_neili") < 200)
		return notify_fail("你的内力太弱，无法练缠丝擒拿手。\n");

	if ((int)me->query_skill("hand", 1) < (int)me->query_skill("chansi-shou", 1))
		return notify_fail("你的基本手法水平有限，无法领会更高深的缠丝擒拿手。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action)-1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("chansi-shou",1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	if (me->query_temp("weapon") ||
	    me->query_temp("secondary_weapon"))
		return notify_fail("你必须空手练习！\n");

	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 80)
		return notify_fail("你的内力不够练缠丝擒拿手。\n");

	me->receive_damage("qi", 65);
	me->add("neili", -69);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"chansi-shou/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【缠丝擒拿手】" ZJBR NOR;
    msg += "一门以柔克刚、以巧破力的擒拿手法，招式灵活多变，缠绕不休。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  空手状态。" ZJBR;
    msg += "  基本内功等级不低于 " HIY "40" NOR " 级。" ZJBR;
    msg += "  最大内力不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "  基本手法等级需大于等于缠丝擒拿手等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  手法（hand）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "80" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "65" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "69" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻击特效〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖防御特效〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  擒拿手 (qinna)" ZJBR NOR;
    msg += "    要求：" ZJBR;
    msg += "      缠丝擒拿手等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      激发手法为缠丝擒拿手。" ZJBR;
    msg += "    效果：" ZJBR;
    msg += "      命中判定基于 自身手法 vs 目标招架。" ZJBR;
    msg += "      命中后对目标造成伤害，伤害值约为 " HIY "40 + (手法等级 / 6) + 随机(手法等级 / 6)" NOR "。" ZJBR;
    msg += "      命中后有几率使目标忙乱：二次判定（(手法等级/3 + 随机(手法等级)) > 目标招架），成功则目标忙乱 (手法等级 / 25 + 2) 秒。" ZJBR;
    msg += "    消耗：" ZJBR;
    msg += "      命中：内力 " HIB "80" NOR " 点，自身忙乱 " HIR "1" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "20" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIY "〖其他信息〗" ZJBR NOR;
    msg += "  无。" ZJBR; // 普通招式已在文件头部 action 数组中定义

    return msg;
}

