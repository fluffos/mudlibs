int valid_enable(string usage) { return  usage == "cuff" || usage == "parry"; }

int valid_learn(object me)
{
	// if (me->query("family/family_name") != "少林派")
		// return notify_fail("少林派的弟子才能学习大金刚拳。\n");
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("学大金刚拳必须空手。\n");

	if ((int)me->query_skill("force") < 30)
		return notify_fail("你的内功火候不够，无法学大金刚拳。\n");

	if ((int)me->query("max_neili") < 100)
		return notify_fail("你的内力太弱，无法练大金刚拳。\n");

	if ((int)me->query_skill("cuff", 1) < (int)me->query_skill("jingang-quan", 1))
		return notify_fail("你的基本拳法水平有限，无法领会更高深的大金刚拳。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action)-1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("jingang-quan",1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[random(i)];
}

int practice_skill(object me)
{
	if (me->query("family/family_name") != "少林派")
		return notify_fail("少林派的弟子才能练习大金刚拳。\n");
	if (me->query_temp("weapon") ||
	    me->query_temp("secondary_weapon"))
		return notify_fail("你必须空手练习！\n");

	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 70)
		return notify_fail("你的内力不够练大金刚拳。\n");

	me->receive_damage("qi", 59);
	me->add("neili", -58);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"jingang-quan/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【大金刚拳】" ZJBR NOR;
    msg += "少林七十二绝技之一，拳势威猛，无坚不摧。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  须为少林派弟子。" ZJBR;
    msg += "  空手状态。" ZJBR;
    msg += "  基本内功等级不低于 " HIY "30" NOR " 级。" ZJBR;
    msg += "  最大内力不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "  基本拳法等级需大于等于大金刚拳等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  拳法（cuff）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  须为少林派弟子。" ZJBR;
    msg += "  空手状态。" ZJBR;
    msg += "  气血：不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "59" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "58" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  暂无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform_action_file
    msg += HIC "  大金刚神通 (jingang)" ZJBR NOR; // 招式名称
    msg += "    使用要求：" ZJBR; // 招式使用要求
    msg += "      战斗中使用。" ZJBR;
    msg += "      当前内力不低于 " HIB "500" NOR " 点。" ZJBR;
    msg += "      基本内功等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      大金刚拳等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      激发拳法为大金刚拳。" ZJBR;
    msg += "      未处于大金刚神通状态。" ZJBR;
    msg += "    效果描述（基于当前气血）：" ZJBR; // 招式效果描述
    msg += "      正常状态 (气血 > 最大气血 * 40%)：" ZJBR;
    msg += "        提升后天膂力：增加 (金刚拳等级 / 3) 点。" ZJBR; // (skill / 3 / 2) * 2 = skill / 3
    msg += "        降低后天身法：减少 (后天身法 / 2) 点。" ZJBR;
    msg += "        持续时间：(金刚拳等级 / 3) 秒。" ZJBR;
    msg += "        消耗内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "      濒死状态 (气血 <= 最大气血 * 40%)：" ZJBR;
    msg += "        提升后天膂力：增加 (金刚拳等级 / 3 * 5) 点。" ZJBR; // (skill / 3 / 2) * 10 = skill / 3 * 5
    msg += "        发动一次额外攻击。" ZJBR;
    msg += "        持续时间：" HIR "2" NOR " 秒。" ZJBR;
    msg += "        消耗全部内力，永久减少最大内力 " HIB "10" NOR " 点。" ZJBR;
    msg += "        使用者陷入昏迷。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 大金刚神通效果不能重复使用。" ZJBR;
    msg += "2. 效果结束后会自动恢复原有属性。" ZJBR;
    msg += "3. 濒死状态下使用虽然威力巨大，但代价高昂，使用者会陷入昏迷并永久损失内力上限。" ZJBR;

    return msg;
}