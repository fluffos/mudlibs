// bati.c 蚩尤霸体



inherit F_SSERVER;
string query_name() { return "蚩尤"ZJBR"霸体"; }
int query_cd() { return 1; }

int exert(object me, object target)
{
        int skill, jing_cost, reduce_busy;

        if (! target) target = me;

        if (me->is_fighting())
                return notify_fail("战斗中无法施展「蚩尤霸体」。\n");

        if ((int)me->query("neili") < 500)
                return notify_fail("你的内力不够，无法施展「蚩尤霸体」。\n");

        skill = me->query_skill("chiyou-kuangzhanjue", 1);

        if (skill < 100)
                return notify_fail("你的蚩尤狂战诀等级不够，无法施展「蚩尤霸体」。\n");

        jing_cost = me->query("max_jing") / 10;

        if ((int)me->query("jing") < jing_cost)
                return notify_fail("你的精神不足，无法施展「蚩尤霸体」。\n");
        
        reduce_busy = (me->query("max_jing") / 3000) * 2;

        if (reduce_busy <= 0)
                return notify_fail("你的精神属性太低，施展「蚩尤霸体」没有效果。\n");

        message_combatd(HIR "$N" HIR "仰天发出一声长啸，身体周围的空气似乎都凝固了，一股霸道的气息从$N" HIR "身上散发出来！\n" NOR, me);

        me->add("neili", -300);
        me->receive_damage("jing", jing_cost);
        
        if (me->is_busy())
        {
                me->interrupt_me(me, reduce_busy);
        }

        return 1;
}
