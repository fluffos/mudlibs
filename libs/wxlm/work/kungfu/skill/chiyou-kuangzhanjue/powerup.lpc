// powerup.c 



inherit F_CLEAN_UP;

/**
 * @brief 查询技能名称
 * @return string 返回技能名称
 */
string query_name() { return "蚩尤"ZJBR"战意"; }

/**
 * @brief 移除战意效果
 * @param object me 玩家对象
 * @param int amount 技能等级数值
 * @param int force_bonus 内功激发数值
 */
void remove_effect(object me, int amount, int force_bonus);

/**
 * @brief 蚩尤狂战决战意激发
 * @param object me 施展者
 * @param object target 目标对象
 * @return int 成功返回1，失败返回0
 * @details 激发战意，提升攻击防御和内功激发
 */
int exert(object me, object target)
{
        int skill, force_bonus;

        if (target != me)
                return notify_fail("你只能用蚩尤狂战决来提升自己的战斗力。\n");

        if ((int)me->query("neili") < 150)
                return notify_fail("你的内力不够。\n");

        if ((int)me->query_temp("powerup"))
                return notify_fail("你已经在运功中了。\n");

        skill = me->query_skill("force") / 10;
        force_bonus = me->query_skill("chiyou-kuangzhanjue") / 2;
        me->add("neili", -100);
        me->receive_damage("qi", 0);
        
        message_combatd(HIY "$N" HIY "深吸一口气，待到呼出之时，双目已经射出赤红的光芒，周围的空气中弥漫着阵阵的战意！\n" NOR, me);
        me->add_temp("apply/attack", skill);
        me->add_temp("apply/defense", skill);
        me->add_temp("apply/force", force_bonus);
        me->set_temp("powerup", 1);

        me->start_call_out((:call_other, __FILE__, "remove_effect", me,
                           skill, force_bonus:), skill);
        if (me->is_fighting()) me->start_busy(3);
        return 1;
}

/**
 * @brief 移除蚩尤狂战决战意效果
 * @param object me 玩家对象
 * @param int amount 攻击防御加成数值
 * @param int force_bonus 内功激发加成数值
 * @details 移除所有临时加成效果
 */
void remove_effect(object me, int amount, int force_bonus)
{
        if (me->query_temp("powerup"))
        {
                me->add_temp("apply/attack", -amount);
                me->add_temp("apply/defense", -amount);
                me->add_temp("apply/force", -force_bonus);
                me->delete_temp("powerup");
                tell_object(me, "你的蚩尤狂战决运行完毕，将内力收回丹田。\n");
        }
}


