inherit SKILL;
// string type() { return "knowledge"; }

mixed query_fuzhu()  { return "bing-qi";}

int valid_learn(object me)
{

        return 1;
}

int difficult_level()
{
        return 200;
}

string query_description()
{
    string msg;

    msg = "";
    msg += HIY "【冰雾秘要】" ZJBR ZJBR NOR;
    msg += WHT "冰雾秘要是一门神秘莫测的武学知识技能，以操控冰雾为特色。" ZJBR;
    msg += "此功法能够凝聚周围水汽，形成寒冷刺骨的冰雾，既可攻击敌人，又可防御自身。" ZJBR ZJBR;

    msg += HIY "【技能类型】" ZJBR NOR;
    msg += "  知识类技能（推测）" ZJBR;
    msg += "  辅助兵器效果：冰器（bing-qi）" ZJBR ZJBR; // 来源于 query_fuzhu

    msg += HIY "【学习要求】" ZJBR NOR;
    msg += "  无明确要求（但学习难度较高）" ZJBR ZJBR;

    msg += HIY "【学习难度】" ZJBR NOR;
    msg += "  难度系数：200" ZJBR ZJBR; // 来源于 difficult_level

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 此技能主要提供理论基础，具体效果可能需要配合其他武功或特殊兵器发挥。" ZJBR;
    msg += "2. 学习难度较高，需要较高的悟性或特定条件。\n";

    return msg;
}
