// 小李飞刀

inherit SKILL;

mapping *action = ({
    ([  "action": "$N手腕一抖，一招「例不虚发」，$w化作一道寒光射向$n的$l",
        "force" : 450,
        "attack": 150,
        "dodge" : 75,
        "parry" : 75,
        "damage": 180,
        "lvl"   : 0,
        "damage_type": "刺伤"
    ]),
    ([  "action": "$N左手一扬，一式「醉里乾坤」，$w带着呼啸之声直取$n的$l",
        "force" : 480,
        "attack": 160,
        "dodge" : 85,
        "parry" : 85,
        "damage": 200,
        "lvl"   : 40,
        "damage_type": "刺伤"
    ]),
    ([  "action": "$N身形一转，使出「飞刀绝技」，手中$w如电光般射向$n的$l",
        "force" : 510,
        "attack": 170,
        "dodge" : 95,
        "parry" : 95,
        "damage": 220,
        "lvl"   : 80,
        "damage_type": "刺伤"
    ]),
});

int valid_learn(object me)
{
    if ((int)me->query_skill("throwing", 1) < 100)
        return notify_fail("你的暗器技能太差，无法学习小李飞刀。\n");
        
    if ((int)me->query_skill("force") < 150)
        return notify_fail("你的内功修为不够，无法学习小李飞刀。\n");
        
    if ((int)me->query_dex() < 30)
        return notify_fail("你的身法太差，无法掌握小李飞刀的精妙之处。\n");
        
    return 1;
}

int valid_enable(string usage)
{
    return usage == "throwing" || usage == "parry";
}

mapping query_action(object me, object weapon)
{
    int i, level;
    level = (int)me->query_skill("xiaoli-feidao", 1);
    for(i = sizeof(action); i > 0; i--)
        if(level > action[i-1]["lvl"])
            return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{

    if ((int)me->query("qi") < 70)
        return notify_fail("你的体力太低了。\n");
        
    if ((int)me->query("neili") < 70)
        return notify_fail("你的内力不够练小李飞刀。\n");
        
    me->receive_damage("qi", 60);
    me->add("neili", -60);
    return 1;
}

// 小李飞刀特殊攻击：风流快意
int perform_action(object me, string arg)
{
    return notify_fail("目前小李飞刀暂时还没有特殊攻击。\n");
}

string perform_action_file(string action)
{
    return __DIR__"xiaoli-feidao/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【小李飞刀】" ZJBR NOR;
    msg += WHT "江湖上赫赫有名的暗器绝学，相传为小李探花李寻欢所创，以其例不虚发闻名天下。" ZJBR;
    msg += "此刀法讲究以快打慢，以巧胜力，一出手便是夺命的杀招。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本暗器等级：100 级。" ZJBR;
    msg += "  基本内功等级：150 级。" ZJBR;
    msg += "  先天身法：30 点。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  暗器（throwing）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 70 点。" ZJBR;
    msg += "  内力：不低于 70 点。" ZJBR;
    msg += "  每次练习消耗气血：60 点。" ZJBR;
    msg += "  每次练习消耗内力：60 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;

    msg += HIC "  风流快意 (fengliu)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      小李飞刀等级 100 级。" ZJBR;
    msg += "      基本内功等级 150 级。" ZJBR;
    msg += "      当前内力 100 点。" ZJBR;
    msg += "      装备暗器类武器并激发小李飞刀为暗器。" ZJBR;
    msg += "      目标未处于忙乱状态。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：(自身暗器有效激发 + 自身内功有效激发) 对比 (目标轻功有效激发 + 目标内功有效激发)，由 `通用命中公式` 判定。" ZJBR;
    msg += "      命中效果：对目标造成伤害，伤害值约为 (自身暗器有效激发 / 2 + 随机(自身暗器有效激发 / 2))，并使目标忙乱 2 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 80 点。" ZJBR;
    msg += "      自身忙乱 2 秒。" ZJBR ZJBR;

    msg += HIC "  例不虚发 (libuhuafa)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      小李飞刀等级 120 级。" ZJBR;
    msg += "      基本内功等级 180 级。" ZJBR;
    msg += "      当前内力 150 点。" ZJBR;
    msg += "      装备暗器类武器并激发小李飞刀为暗器。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：(自身暗器有效激发 + 自身内功有效激发) 对比 (目标招架有效激发 + 目标轻功有效激发)，由 `通用命中公式` 判定。" ZJBR;
    msg += "      命中效果：临时提升自身攻击力 (提升值 = 暗器有效激发 / 10)，提升效果持续 (暗器有效激发 / 20) 秒。并追加多次普通攻击（次数由 `COMBAT_D->query_base_attack_number` 决定），每次普通攻击有 1/3 几率使未忙乱的目标忙乱 1 秒。" ZJBR;
    msg += "      未命中效果：无特殊效果。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 100 点。" ZJBR;
    msg += "      自身忙乱 2 秒。" ZJBR ZJBR;

    msg += HIC "  逍遥无情 (xiaoyao)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      小李飞刀等级 140 级。" ZJBR;
    msg += "      基本内功等级 200 级。" ZJBR;
    msg += "      当前内力 200 点。" ZJBR;
    msg += "      装备暗器类武器并激发小李飞刀为暗器。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：(自身暗器有效激发 + 自身内功有效激发 + 自身轻功有效激发) 对比 (目标内功有效激发 + 目标招架有效激发 + 目标轻功有效激发)，由 `通用命中公式` 判定。" ZJBR;
    msg += "      命中效果：对目标造成大量伤害，伤害值约为 (自身暗器有效激发 + 自身内功有效激发 + 自身轻功有效激发 + 随机(自身暗器有效激发 + 自身内功有效激发 + 自身轻功有效激发) / 2)，并使未忙乱的目标忙乱 2 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 150 点。" ZJBR;
    msg += "      自身忙乱 3 秒。" ZJBR;

    return msg;
}
