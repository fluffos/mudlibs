int valid_enable(string usage) { return usage == "blade" ||  usage=="parry"; }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 100)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("force") < 50)
		return notify_fail("你的内功火候不够。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;

	for(i = sizeof(action)-1; i >= 0; i--)
		if(level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;

	level = (int)me->query_skill("yanxing-dao", 1);
	for(i = sizeof(action); i > 0; i--)
		if(level > action[i-1]["lvl"])
		return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "blade")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 60)
		return notify_fail("你的体力不够练雁行刀。\n");

	if ((int)me->query("neili") < 60)
		return notify_fail("你的内力不够练雁行刀。\n");

	me->receive_damage("qi", 53);
	me->add("neili", -51);
	return 1;
}

string perform_action_file(string action)
{
    return __DIR__"yanxing-dao/" + action;
}
string query_description()
{
    string msg;

    msg = HIY "【雁行刀法】" ZJBR NOR;
    msg += WHT "雁行刀法是一门以灵活多变著称的高级刀法，招式如雁群排列，灵活多变。" ZJBR;
    msg += "此刀法共有十种招式，从「让字诀」到「错字诀」，每一招都有独特的特点，变化莫测。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  内力上限：" HIY "100" NOR " 点" ZJBR;
    msg += "  基本内功等级：" HIY "50" NOR " 级" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  刀法(blade)" ZJBR;
    msg += "  招架(parry)" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血消耗：" HIR "53" NOR " 点" ZJBR;
    msg += "  内力消耗：" HIR "51" NOR " 点" ZJBR;
    msg += "  最低气血要求：" HIR "60" NOR " 点" ZJBR;
    msg += "  最低内力要求：" HIR "60" NOR " 点" ZJBR ZJBR;

    msg += HIY "〖招式特点〗" ZJBR NOR;
    msg += "  该武功共有十个招式，按等级依次解锁：" ZJBR;
    msg += "  「让字诀」 - 初始招式，上身侧过，刀斜砍" ZJBR;
    msg += "  「打字诀」 - 10级解锁，左手护顶，刀直劈" ZJBR;
    msg += "  「顶字诀」 - 20级解锁，招架结合攻击" ZJBR;
    msg += "  「引字诀」 - 30级解锁，侧身闪现，攻击力强" ZJBR;
    msg += "  「套字诀」 - 40级解锁，缠手施展刀光" ZJBR;
    msg += "  「陈字诀」 - 50级解锁，身法轻灵，出其不意" ZJBR;
    msg += "  「探字诀」 - 60级解锁，急转直刺，伤害较高" ZJBR;
    msg += "  「逼字诀」 - 70级解锁，布下刀网，困敌攻击" ZJBR;
    msg += "  「藏字诀」 - 80级解锁，诱敌出招，势大力沉" ZJBR;
    msg += "  「错字诀」 - 90级解锁，双手交叉，刀光难辨" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  无形幻影 (huanying)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      雁行刀法已激发为刀法" ZJBR;
    msg += "      雁行刀法等级不低于 " HIY "60" NOR " 级" ZJBR;
    msg += "      基本内功等级不低于 " HIY "120" NOR " 级" ZJBR;
    msg += "      当前内力不低于 " HIB "80" NOR " 点" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      使用者化作数团身影，漫天刀光席卷而来" ZJBR;
    msg += "      连续进行多次攻击，每次攻击都可能造成伤害" ZJBR;
    msg += "      攻击次数随使用者基础攻击次数增加而增加" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力：" HIB "80" NOR " 点" ZJBR;
    msg += "      自身忙乱：" HIR "1-4" NOR " 秒" ZJBR ZJBR;

    return msg;
}