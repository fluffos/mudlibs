// huashan-xinfa.c 华山心法

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_force(string force)
{
    return (force == "zixia-shengong");
}

int valid_learn(object me)
{
    return ::valid_learn(me);
}

int practice_skill(object me)
{
    return notify_fail("华山心法只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
    return SKILL_D(__DIR__"huashan-xinfa/") + func;
}
string query_description()
{
    string msg;

    msg = HIY "【华山心法】" ZJBR NOR;
    msg += "华山派的基础内功心法，以静养为主，讲究内外兼修，能够增强内力修为，提升气血运行速度。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  遵循基本内功学习要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功（force）。" ZJBR ZJBR;

    msg += HIY "〖可互备内功〗" ZJBR NOR;
    msg += "  可与 紫霞神功 (zixia-shengong) 配合。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  无法练习，只能通过学习 (learn) 提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  暂无。" ZJBR;

    return msg;
}
