int valid_enable(string usage) { return usage == "cuff" || usage == "parry"; }

int valid_learn(object me)
{
    if (me->query("family/family_name"))
        return notify_fail("雷霆万钧拳只有无门派的人才能学习。\n");

    if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
        return notify_fail("练习雷霆万钧拳必须空手。\n");

    if ((int)me->query_skill("force") < 130)
        return notify_fail("你的内功火候不够，无法练习雷霆万钧拳。\n");

    if ((int)me->query("max_neili") < 1000)
        return notify_fail("你的内力太弱，无法练习雷霆万钧拳。\n");

    if ((int)me->query_skill("cuff", 1) < 100)
        return notify_fail("你的基本拳法火候不够，无法练习雷霆万钧拳。\n");

    if ((int)me->query_skill("cuff", 1) < (int)me->query_skill("leiting_wanjun", 1))
        return notify_fail("你的基本拳法水平有限，无法领会更高深的雷霆万钧拳。\n");

    return 1;
}

string query_skill_name(int level)
{
    int i;
    for (i = sizeof(action) - 1; i >= 0; i--)
        if (level >= action[i]["lvl"])
            return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    int i, level;
    level = (int) me->query_skill("leiting_wanjun", 1);
    for (i = sizeof(action); i > 0; i--)
        if (level > action[i-1]["lvl"])
            return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    if ((int)me->query("qi") < 70)
        return notify_fail("你的体力太低了。\n");

    if ((int)me->query("neili") < 70)
        return notify_fail("你的内力不够练雷霆万钧拳。\n");

    me->receive_damage("qi", 60);
    me->add("neili", -65);
    return 1;
}

string perform_action_file(string action)
{
    return __DIR__"leiting_wanjun/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
    int lvl;
    int i;

    lvl = me->query_skill("leiting_wanjun", 1);
    i = random(lvl);

    if (i < 50)
        return 0;

    if (i < 100)
    {
        victim->receive_wound("qi", damage_bonus / 5);
        return HIY "$N" HIY "的拳劲中夹带着丝丝雷电,令$n" HIY "感到一阵酥麻！"NOR"\n";
    }
    else if (i < 150)
    {
        victim->receive_wound("qi", damage_bonus / 4);
        victim->apply_condition("thunder_poison", random(lvl / 5) + (me->query("jiali") / 10));
        return HIC "$N" HIC "雷霆万钧拳势凌厉,$n" HIC "被击中后全身发麻,难以动弹！"NOR"\n";
    }
    else
    {
        victim->receive_wound("qi", damage_bonus / 3);
        victim->apply_condition("thunder_poison", random(lvl / 3) + (me->query("jiali") / 8));
        return HIB "$N" HIB "雷霆万钧拳劲爆发,$n" HIB "被雷霆之力击中,全身麻痹,几欲瘫倒！"NOR"\n";
    }
}

string query_description()
{
    string msg;

    msg = HIY "【雷霆万钧拳】" ZJBR NOR;
    msg += WHT "一门至刚至猛的拳法，蕴含雷霆之力，出拳带有风雷之声，威力惊人，且能麻痹对手。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  必须为 无门派 人士。" ZJBR;
    msg += "  必须空手。" ZJBR;
    msg += "  基本内功 (`force`) 等级不低于 " HIY "130" NOR " 级。" ZJBR;
    msg += "  最大内力 (`max_neili`) 不低于 " HIB "1000" NOR " 点。" ZJBR;
    msg += "  基本拳法 (`cuff`) 等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "  基本拳法 (`cuff`) 等级需大于等于雷霆万钧拳等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  拳法 (`cuff`)。" ZJBR;
    msg += "  招架 (`parry`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  气血 (`qi`) 不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力 (`neili`) 不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血 " HIR "60" NOR " 点，内力 " HIB "65" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // hit_ob
    msg += "  " HIM "雷劲伤敌 (hit_ob)" NOR ":" ZJBR;
    msg += "    触发条件：命中时，`随机(雷霆万钧拳等级) >= 50`。" ZJBR;
    msg += "    效果：" ZJBR;
    msg += "      - 低级 (`随机数 < 100`)：造成额外 `伤害增益 / 5` 的气血伤害 (`wound`)，目标感到酥麻。" ZJBR;
    msg += "      - 中级 (`100 <= 随机数 < 150`)：造成额外 `伤害增益 / 4` 的气血伤害 (`wound`)，并附加 雷霆剧毒 (`thunder_poison`) 状态 (持续时间 `随机(等级/5) + 加力/10` 秒)，目标全身发麻。" ZJBR;
    msg += "      - 高级 (`随机数 >= 150`)：造成额外 `伤害增益 / 3` 的气血伤害 (`wound`)，并附加更强的 雷霆剧毒 (`thunder_poison`) 状态 (持续时间 `随机(等级/3) + 加力/8` 秒)，目标全身麻痹。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (Perform)〗" ZJBR NOR;
    msg += HIC "  雷霆一击 (leiting)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      雷霆万钧拳等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "      基本内功 (`force`) 等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      发动一次强力攻击，附加额外伤害，伤害值等于 `基本拳法激发等级 + 基本内功激发等级`。" ZJBR;
    msg += "      有几率使目标陷入忙乱 (`busy`) 状态。" ZJBR;
    msg += "      麻痹判定：若 `随机(自身基本拳法激发等级) > (目标基本内功激发等级 / 2)` 则成功。" ZJBR;
    msg += "      成功后目标忙乱时间：`(雷霆万钧拳等级 / 25)` 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 学习此拳法限定无门派人士。" ZJBR;
    msg += "2. 练习和使用雷霆万钧拳必须空手。" ZJBR;
    msg += "3. 被动效果「雷劲伤敌」能在普通攻击时附加伤害和麻痹状态，效果随等级提升。" ZJBR;
    msg += "4. 特殊招式「雷霆一击」威力巨大，并有较高概率麻痹对手，但消耗和自身忙乱也较大。" ZJBR;

    return msg;
}