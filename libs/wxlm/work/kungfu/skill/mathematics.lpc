// mathematics

inherit SKILL;

string type() { return "knowledge"; }

void skill_improved(object me)
{
}

int valid_learn(object me)
{
    return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【算术】" ZJBR NOR;
    msg += WHT "算术是一门基础的知识类技能，代表着你进行计算和理解数理逻辑的能力。" ZJBR ZJBR;

    msg += HIY "〖技能性质〗" ZJBR NOR;
    msg += "  知识类技能 (`knowledge`)。" ZJBR ZJBR;

    msg += HIY "〖学习与提升〗" ZJBR NOR;
    msg += "  可以通过学习 (`learn`) 指令向合适的师傅或通过阅读相关书籍来提升。" ZJBR;
    msg += "  也可以通过研究 (`research`) 来自行钻研提升。" ZJBR ZJBR;

    msg += HIY "〖主要作用〗" ZJBR NOR;
    msg += "  可能是学习某些需要数理基础的技艺（如机关术、阵法、商业等）的前提条件。" ZJBR;
    msg += "  在某些任务或解谜过程中可能需要运用算术知识。" ZJBR;
    msg += "  提升算术能力有助于更好地理解一些涉及计算的复杂事物。" ZJBR ZJBR; // (用途根据MUD设计可能有所不同)

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 作为知识类技能，算术本身不提供直接的战斗能力。" ZJBR;
    msg += "2. 算术的实际应用范围取决于游戏世界的具体设定。" ZJBR;

    return msg;
}
