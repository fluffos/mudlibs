// strike.c
inherit SKILL;

// 函数声明
string query_description();

void skill_improved(object me)
{
	if (me->query_skill("strike",1)%30==0) {
		tell_object(me, HIW "由於你勤练武艺，你的"+HIY"【后天膂力】"+NOR+"提高了。\n");
	}
}

string query_description()
{
	string msg;

	msg = HIY "【基本掌法】" ZJBR NOR;
	msg += "所有掌法的总称，为学习更高级掌法的基础。" ZJBR ZJBR; // 基本介绍

	msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
	msg += "  无特殊要求。" ZJBR ZJBR;

	msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
	msg += "  掌法（strike）。" ZJBR ZJBR;

	msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
	msg += "  通常通过练习高级掌法或请教来提升。" ZJBR ZJBR; // 基础技能一般不直接练习

	msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // skill_improved
	msg += "  等级提升：每提升 " HIY "30" NOR " 级，提升一次后天膂力。" ZJBR ZJBR;

	msg += HIY "〖特殊招式〗" ZJBR NOR; // perform/exert
	msg += "  无。" ZJBR;

	return msg;
}

