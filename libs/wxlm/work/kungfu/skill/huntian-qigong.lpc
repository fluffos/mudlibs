// huntian-qigong.c   混天气功

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_force(string force)
{
	return force == "jiaohua-neigong";
}

int query_neili_improve(object me)
{
	int lvl;

	lvl = (int)me->query_skill("huntian-qigong", 1);
	return lvl * lvl * 15 * 9 / 100 / 200;
}

int valid_learn(object me)
{
	if (me->query_skill("force", 1) < 30)
		return notify_fail("你的基本内功火候不够，无法学习混天气功。\n");
	if (me->query_skill("force",1) <= me->query_skill("huntian-qigong",1) )
	return notify_fail("你的基本内功基础不够，无法领会更高深的混天气功。\n");

	    return 1;
}

int practice_skill(object me)
{
	    return notify_fail("混天气功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"huntian-qigong/" + func;
}

string query_description()
{
    string msg;

    msg = HIY "【混天气功】" ZJBR NOR;
    msg += "丐帮镇帮内功心法，刚猛浑厚，练成后内力生生不息。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功等级需达到 " HIY "30" NOR " 级。" ZJBR;
    msg += "  基本内功等级需高于混天气功等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功（force）。" ZJBR ZJBR;

    msg += HIY "〖可互备内功〗" ZJBR NOR;
    msg += "  可与 叫化内功 (jiaohua-neigong) 配合。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  无法练习，只能通过学习 (learn) 提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  每提升一级混天气功，最大内力上限提升。" ZJBR;
    msg += "  具体公式：等级 * 等级 * 15 * 9 / 100 / 200" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;

    msg += HIC "  混天战气 (powerup)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      当前内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升自身攻击力和防御力。" ZJBR;
    msg += "      提升数值 = 激发内功等级 / 3。" ZJBR;
    msg += "      持续时间 = 激发内功等级 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      若在战斗中使用，自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  混天神罡 (shengang)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      基本内功等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      仅能在战斗中使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升自身兵器伤害力和空手伤害力。" ZJBR;
    msg += "      提升数值 = 混天气功等级 / 2。" ZJBR;
    msg += "      持续时间 = 混天气功等级 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "      使用后无忙乱。" ZJBR;
    msg += "    注意：「混天战气」与「混天神罡」效果冲突，后发动者会覆盖前者。" ZJBR ZJBR;

    msg += HIC "  纵声长啸 (roar)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      当前内力 " HIB "600" NOR " 点。" ZJBR;
    msg += "      非安全区。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对环境内所有生物进行一次精神攻击判定。" ZJBR;
    msg += "      成功率判定：比较（自身激发内功等级 / 2 + 随机（自身激发内功等级 / 2））与 目标后天根骨 * 2。" ZJBR;
    msg += "      判定成功后对目标造成精神伤害，伤害值 = 自身激发内功等级 - (目标最大内力 / 10)。" ZJBR;
    msg += "      若目标内力低于（自身激发内功等级 * 2），则会额外受到精神损伤（等同于伤害值）。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "150" NOR " 点，气血 " HIR "10" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "5" NOR " 秒。" ZJBR;
    msg += "      会对所有受到影响的生物结仇。" ZJBR;

    return msg;
}