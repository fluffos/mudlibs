int valid_enable(string usage) { return usage == "staff" || usage == "parry"; }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 600)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("force") < 90)
		return notify_fail("你的内功火候太浅。\n");

	if ((int)me->query_skill("staff", 1) < (int)me->query_skill("xiangmo-chu", 1))
		return notify_fail("你的基本杖法水平有限，无法领会更高深的降魔杵法。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action) - 1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("xiangmo-chu",1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) || 
	    (string)weapon->query("skill_type") != "staff")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力不够，练不了金刚降魔杵。\n");

	if ((int)me->query("neili") < 70)
		return notify_fail("你的内力不够，练不了金刚降魔杵。\n");

	me->receive_damage("qi", 42);
	me->add("neili", -54);

	return 1;
}

string perform_action_file(string action)
{
       return __DIR__"xiangmo-chu/" + action;
}

string query_description()
{
	string msg;

	msg = HIY "【金刚降魔杵】" ZJBR NOR;
	msg += "少林七十二绝技之一，是一门以刚猛著称的高级杖法。招式大开大阖，威力万钧。" ZJBR ZJBR;

	msg += HIY "〖学习要求〗" ZJBR NOR;
	msg += "  最大内力：" HIB "600" NOR " 点。" ZJBR;
	msg += "  内功有效激发等级：" HIY "90" NOR " 级。" ZJBR;
	msg += "  基本杖法等级需大于等于金刚降魔杵等级。" ZJBR ZJBR;

	msg += HIY "〖激发类型〗" ZJBR NOR;
	msg += "  杖法（staff）。" ZJBR;
	msg += "  招架（parry）。" ZJBR ZJBR;

	msg += HIY "〖练习要求〗" ZJBR NOR;
	msg += "  需要装备杖类武器。" ZJBR;
	msg += "  气血：不低于 " HIR "50" NOR " 点。" ZJBR;
	msg += "  内力：不低于 " HIB "70" NOR " 点。" ZJBR;
	msg += "  每次练习消耗气血：" HIR "42" NOR " 点。" ZJBR;
	msg += "  每次练习消耗内力：" HIB "54" NOR " 点。" ZJBR ZJBR;

	msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
	msg += "  根据技能等级施展不同威力(\"damage\")和附加力道(\"force\")的普通攻击招式。" ZJBR ZJBR;

	msg += HIY "〖特殊招式〗" ZJBR NOR;
	msg += HIC "  降魔一杵 (xiang)" ZJBR NOR;
	msg += "    使用要求：" ZJBR;
	msg += "      金刚降魔杵等级：" HIY "80" NOR " 级。" ZJBR;
	msg += "      内功有效激发等级：" HIY "100" NOR " 级。" ZJBR;
	msg += "      当前内力：" HIB "80" NOR " 点。" ZJBR;
	msg += "      激发杖法为金刚降魔杵，且持有杖类武器。" ZJBR;
	msg += "      只能对战斗中的对手使用。" ZJBR;
	msg += "    效果描述：" ZJBR;
	msg += "      对目标发动多次（通常为 " HIY "4" NOR " 次）攻击。" ZJBR;
	msg += "      每次攻击的命中和伤害由 `COMBAT_D` 根据双方状态、技能、装备等综合计算。" ZJBR;
	msg += "    消耗与代价：" ZJBR;
	msg += "      内力：" HIB "80" NOR " 点。" ZJBR;
	msg += "      忙乱：" HIR "1 - 4" NOR " 秒。" ZJBR;

	return msg;
}