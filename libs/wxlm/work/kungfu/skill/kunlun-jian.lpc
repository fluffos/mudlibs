int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 300)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("force") < 60)
		return notify_fail("你的内功火候太浅。\n");

	if ((int)me->query_skill("sword", 1) < (int)me->query_skill("kunlun-jian", 1))
		return notify_fail("你的基本剑法水平有限，无法领会更高深的昆仑剑法。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action) - 1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("kunlun-jian", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon")) ||	
	    (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 70)
		return notify_fail("你的体力不够练昆仑剑法。\n");

	if ((int)me->query("neili") < 70)
		return notify_fail("你的内力不够练昆仑剑法。\n");

	me->receive_damage("qi", 50);
	me->add("neili", -50);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"kunlun-jian/" + action;
}


string query_description()
{
    string msg;

    msg = HIY "【昆仑剑法】" ZJBR NOR;
    msg += WHT "昆仑派的剑法绝学，剑法飘逸灵动，出招精妙，常蕴含乐理。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力 (`max_neili`) 不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "  基本内功 (`force`) 等级不低于 " HIY "60" NOR " 级。" ZJBR;
    msg += "  基本剑法 (`sword`) 等级需大于等于昆仑剑法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  剑法 (`sword`)。" ZJBR;
    msg += "  招架 (`parry`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须装备剑类武器。" ZJBR;
    msg += "  气血 (`qi`) 不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力 (`neili`) 不低于 " HIB "70" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血 " HIR "50" NOR " 点，内力 " HIB "50" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (Perform)〗" ZJBR NOR;
    msg += HIC "  域外梵音 (fanyin)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      昆仑剑法 (`kunlun-jian`) 等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "      弹琴技法 (`tanqin-jifa`) 等级不低于 " HIY "120" NOR " 级。" ZJBR;
    msg += "      最大内力 (`max_neili`) 不低于 " HIB "800" NOR " 点。" ZJBR;
    msg += "      当前内力 (`neili`) 不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "      必须装备剑类武器。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：由 `COMBAT_D->hit_determination()` 根据 自身基本剑法等级 (`sword`) 与 目标内功激发等级 (`force`) 进行判定。" ZJBR;
    msg += "      命中效果：对目标造成兵器伤害，伤害值约为 (自身基本剑法等级 + 自身基本弹琴技法等级) / 2 + 随机((自身基本剑法等级 + 自身基本弹琴技法等级) / 2)，并附加固定伤害 66 点。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 " HIB "200" NOR " 点，自身忙乱 (`busy`) 2 到 3 秒 (2 + random(2))。" ZJBR;
    msg += "      未命中：消耗内力 " HIB "50" NOR " 点，自身忙乱 (`busy`) 3 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 特殊招式「域外梵音」仅能在战斗中使用。" ZJBR;
    msg += "2. 「域外梵音」的伤害与基本剑法和弹琴技法等级相关。" ZJBR;
    msg += "3. 使用特殊招式后会伴随一定时间的忙乱状态。" ZJBR;

    return msg;
}