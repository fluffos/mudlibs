// 血刃狂舞


#include <combat.h>

inherit F_SSERVER;

// 函数声明
string query_name() { return "血刃" ZJBR "狂舞"; }
int query_cd() { return 15; }

// 技能施展
int perform(object me, object target)
{
    // 变量声明
    int damage, count, i;
    string msg;
    object weapon;
    string *attack_msg;



    // 判断目标
    if (! target) target = offensive_target(me);

    if (! target || ! me->is_fighting(target))
        return notify_fail("「血刃狂舞」只能对战斗中的对手使用。\n");

    // 武器检查
    weapon = me->query_temp("weapon");
    if (! objectp(weapon) || weapon->query("skill_type") != "blade")
        return notify_fail("你需要持刀才能施展「血刃狂舞」。\n");


    attack_msg = ({
            HIR "$N" HIR "挥动手中" + weapon->name() + HIR "，刀光如狂风暴雨般斩向$n" HIR "！" NOR,
            HIR "$N" HIR "身形旋转，手中" + weapon->name() + HIR "化作一道血光，疯狂地劈向$n" HIR "！" NOR,
            HIR "$N" HIR "大喝一声，$w" HIR "化作无数刀影，将$n" HIR "笼罩其中！" NOR,
        });

    // 技能等级检查
    if (me->query_skill("weizhuang_guidao", 1) < 200)
        return notify_fail("你的「鲨齿鬼刀」不够娴熟，无法施展「血刃狂舞」。\n");

    // 内力检查
    if (me->query("neili") < 800)
        return notify_fail("你的内力不足，无法施展「血刃狂舞」。\n");

    // 招式描述
    msg = HIR "$N" HIR "眼中闪过一丝狠厉，猛然施展出「血刃狂舞」，$w" HIR "顿时化作漫天刀影，席卷$n" HIR "！" NOR "\n";

    // 消耗与忙乱
    me->add("neili", -500);
    me->start_busy(3);

    // 连续攻击次数，取决于技能等级
    count = 3 + random(3);

    // 连续攻击
    for (i = 0; i < count; i++)
    {
        if (! me->is_fighting(target)) break;

        msg += attack_msg[random(sizeof(attack_msg))] + "\n";

        if (random(me->query_skill("blade")) > target->query_skill("parry") / 2)
        {
            damage = me->query_skill("weizhuang_guidao", 1) / 2;
            damage = damage + random(damage);
            msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 40 + random(10),
                                       RED "$n" RED "没能招架住$N" RED "的攻击，被斩中要害，鲜血飞溅！" NOR "\n");
        }
        else
        {
            msg += CYN "$n" CYN "全力防守，勉强挡住了$N" CYN "的攻击！" NOR "\n";
        }
    }

    // 显示信息
    message_combatd(msg, me, target);
    return 1;
}