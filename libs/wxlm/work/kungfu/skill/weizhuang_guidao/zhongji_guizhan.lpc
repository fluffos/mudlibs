// 终极鬼斩


#include <combat.h>

inherit F_SSERVER;

// 函数声明
string query_name() { return "终极" ZJBR "鬼斩"; }
int query_cd() { return 20; }

// 技能施展
int perform(object me, object target)
{
    // 变量声明
    int damage;
    string msg;
    object weapon;

    // 判断目标
    if (! target) target = offensive_target(me);

    if (! target || ! me->is_fighting(target))
        return notify_fail("「终极鬼斩」只能对战斗中的对手使用。\n");

    // 武器检查
    weapon = me->query_temp("weapon");
    if (! objectp(weapon) || weapon->query("skill_type") != "blade")
        return notify_fail("你需要持刀才能施展「终极鬼斩」。\n");

    // 技能等级检查
    if (me->query_skill("weizhuang_guidao", 1) < 220)
        return notify_fail("你的「鲨齿鬼刀」不够娴熟，无法施展「终极鬼斩」。\n");

    // 内力检查
    if (me->query("neili") < 1000)
        return notify_fail("你的内力不足，无法施展「终极鬼斩」。\n");

    // 招式描述
    msg = HIR "$N" HIR "冷哼一声，聚集全身力量，手中" + weapon->name() + HIR "爆发出骇人的血红色刀芒，一式「终极鬼斩」斩向$n" HIR "！" NOR "\n";

    // 消耗与忙乱
    me->add("neili", -700);
    me->start_busy(4);

    // 命中判断
    if (random(me->query_skill("blade")) > target->query_skill("dodge") / 3)
    {
        damage = me->query_skill("weizhuang_guidao", 1) * 2;
        damage = damage + random(damage);
        msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 70,
                                   HIR "$n" HIR "完全无法躲避，被这一刀正中，要害部位被劈开，鲜血狂喷！" NOR "\n");
    }
    else
    {
        msg += CYN "$n" CYN "情急之下，全力一挡，堪堪避过了致命一击，但仍被震得气血翻涌！" NOR "\n";
        me->receive_damage("qi", me->query("max_qi") / 10);
        me->receive_wound("qi", me->query("max_qi") / 20);
    }

    // 显示信息
    message_combatd(msg, me, target);
    return 1;
}