// 鬼影闪


#include <combat.h>

inherit F_SSERVER;

// 函数声明
string query_name() { return "鬼影" ZJBR "闪"; }
int query_cd() { return 12; }

// 技能施展
int perform(object me, object target)
{
    // 变量声明
    int damage;
    string msg;
    object weapon;

    // 判断目标
    if (! target) target = offensive_target(me);

    if (! target || ! me->is_fighting(target))
        return notify_fail("「鬼影闪」只能对战斗中的对手使用。\n");

    // 武器检查
    weapon = me->query_temp("weapon");
    if (! objectp(weapon) || weapon->query("skill_type") != "blade")
        return notify_fail("你需要持刀才能施展「鬼影闪」。\n");

    // 技能等级检查
    if (me->query_skill("weizhuang_guidao", 1) < 180)
        return notify_fail("你的「鲨齿鬼刀」不够娴熟，无法施展「鬼影闪」。\n");

    // 内力检查
    if (me->query("neili") < 600)
        return notify_fail("你的内力不足，无法施展「鬼影闪」。\n");

    // 招式描述
    msg = HIB "$N" HIB "身形诡异地闪烁，手中" + weapon->name() + HIB "化作一道黑色闪电，瞬间斩向$n" HIB "！" NOR "\n";

    // 消耗与忙乱
    me->add("neili", -400);
    me->start_busy(2);

    // 命中判断
    if (random(me->query_skill("blade")) > target->query_skill("dodge") / 2)
    {
        damage = to_int(me->query_skill("weizhuang_guidao", 1) * 1.5);
        damage = damage + random(damage / 2);
        msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 60,
                                   HIR "$n" HIR "未能察觉$N" HIR "的身影，被这一刀斩中要害，血流如注！" NOR "\n");
    }
    else
    {
        msg += CYN "$n" CYN "及时警觉，急忙后退，险险避过了这一刀！" NOR "\n";
    }

    // 显示信息
    message_combatd(msg, me, target);
    return 1;
}