// freezing-force.c 少林 冰蚕寒功
// Feb.21 1998 by Java



inherit FORCE;

int valid_enable(string usage)
{
	return usage == "force";
}

int valid_force(string force)
{
	return force == "guixi-gong";
}

int query_neili_improve(object me)
{
	int lvl;

	lvl = (int)me->query_skill("freezing-force", 1);
	return lvl * lvl * 15 * 18 / 100 / 200;
}

int valid_learn(object me)
{
    	if (me->query_skill("force", 1) < 50)
		return notify_fail("你的基本内功火候不够，难以锻炼冰蚕寒功！\n");

	if (me->query_skill("yijinjing", 1))
		me->delete_skill("yijinjing");

	if (me->query_skill("force", 1) < me->query_skill("freezing-force", 1))
		return notify_fail("你的基本内功水平不够，难以锻炼更深厚的冰蚕寒功！\n");

	return ::valid_learn(me);
}

int practice_skill(object me)
{
	return notify_fail("冰蚕寒功无法通过简单的练习来增加熟练度。\n");
}

// hit effect called by combatd
mixed force_hit_ob(object me, object victim, int damage_bonus, int factor)
{
	mixed result;
	int lvl;
	int flvl;

	result = ::force_hit_ob(me, victim, damage_bonus, factor);
	if (intp(result) && result > 0)
	{
		lvl  = me->query_skill("freezing-force", 1);
		flvl = me->query("jiali");
		if (lvl < 80 || flvl < 10)
			return;

	    	if (flvl * 2 + random(lvl) > victim->query_skill("force") &&
		    victim->affect_by("freezing",
				      ([ "level" : flvl * 3 / 2 + random(flvl / 2),
					 "id"    : me->query("id"),
					 "duration" : lvl / 40 + random(lvl / 20) ])))
		{
			result += COMBAT_D->get_skill_aoyi_level(me,"天罡星辰") * result / 10;
			return ([ "damage" : result,
				  "msg" : HIW "$n" HIW "只觉得寒风袭体，一时说不出的难受。"NOR"\n" ]);
	    }
	}

	return result;
}

string exert_function_file(string func)
{
	return __DIR__"freezing-force/" + func;
}

int diffcult_level() { return 200; }

string query_description()
{
    string msg;

    msg = HIY "【冰蚕寒功】" ZJBR NOR;
    msg += WHT "乃是一种至阴至寒的内功，修炼时需忍受极大的痛苦，练成后威力惊人。" ZJBR;
    msg += "内力附带刺骨寒气，攻击时可对敌人造成额外寒冷效果。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功等级不低于 " HIY "50" NOR " 级。" ZJBR;
    msg += "  基本内功等级需大于等于冰蚕寒功等级。" ZJBR;
    msg += "  (学习此功会遗忘易筋经)" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功（force）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  无法通过练习提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  提升内力上限：效果随等级提升 (公式: `基本等级 * 基本等级 * 0.0135`)。" ZJBR;
    msg += "  攻击附加寒冷：" ZJBR;
    msg += "    条件：自身冰蚕寒功基本等级不低于 " HIY "80" NOR " 级，加力 (`jiali`) 不低于 " HIY "10" NOR "。" ZJBR;
    msg += "    效果：命中时有几率对目标附加 寒冷 (`freezing`) 状态。" ZJBR;
    msg += "      状态强度受加力影响 (强度: `加力 * 1.5 + 随机(加力 / 2)`)。" ZJBR;
    msg += "      持续时间受冰蚕寒功基本等级影响 (持续时间: `基本等级 / 40 + 随机(基本等级 / 20)`)。" ZJBR;
    msg += "      判定条件：(`加力 * 2 + 随机(冰蚕寒功基本等级)`) > 目标内功激发等级。" ZJBR;
    msg += "      触发寒冷状态时，根据奥义【天罡星辰】等级，额外增加伤害比例 (伤害增加: `原伤害 * 奥义等级 / 10`)。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (内功运用 exert)〗" ZJBR NOR;
    msg += HIC "  寒冰战气 (powerup)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      冰蚕寒功激发等级。" ZJBR;
    msg += "      当前内力不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "      未处于 `powerup` 状态。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升自身攻击力，数值为 (冰蚕寒功激发等级 / 3)。" ZJBR;
    msg += "      提升自身防御力，数值为 (冰蚕寒功激发等级 / 3)。" ZJBR;
    msg += "      效果持续时间为 (冰蚕寒功激发等级) 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  蛊命借种 (shield)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      冰蚕寒功基本等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升自身护甲值，数值为 (内功激发等级 * 2 / 5)。" ZJBR;
    msg += "      效果持续 " HIY "15" NOR " 秒。" ZJBR;
    msg += "      期间储存临时气血和内力（`guchong_qi` 和 `guchong_neili`），数值均为 (内功激发等级 * 10)。" ZJBR;
    msg += "      再次施展该招式时，可一次性将储存的气血和内力补充自身 (恢复气血、有效气血、精气、有效精气和内力)。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      若在战斗中，自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  寒冰炼毒 (lian)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      冰蚕寒功基本等级。" ZJBR;
    msg += "      基本毒技基本等级。" ZJBR;
    msg += "      当前内力不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      将自身所有内力炼制成寒毒物品 (`/u/new_du.c`)。" ZJBR;
    msg += "      毒药数量：等于 (消耗的内力 / 100)。" ZJBR;
    msg += "      毒药等级：受冰蚕寒功基本等级、基本毒技基本等级和奥义【天罡星辰】等级影响。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      当前所有内力。" ZJBR ZJBR;

    return msg;
}