// mizong-neigong

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_force(string force)
{
	return force == "longxiang" ||
	       force == "xiaowuxiang" ||
	       force == "xuehai-mogong";
}

int valid_learn(object me)
{
	return ::valid_learn(me);
}

int practice_skill(object me)
{
	return notify_fail("密宗内功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"mizong-neigong/" + func;
}

string query_description()
{
    string msg;

    msg = HIY "【密宗内功】" ZJBR NOR;
    msg += WHT "密宗基础内功心法，为修炼更高深密宗武学打下根基。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  遵循基本内功 (`force`) 的学习要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功 (`force`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  " HIR "无法练习" NOR "，只能通过学习 (`learn`) 提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  可作为 龙象般若功 (`longxiang`)、小无相功 (`xiaowuxiang`)、血海魔功 (`xuehai-mogong`) 的基础。" ZJBR;
    msg += "  提升角色气血和内力上限（遵循基本内功效果）。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    return msg;
}
