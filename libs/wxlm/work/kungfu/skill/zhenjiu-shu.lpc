inherit SKILL;

string type() { return "knowledge"; }

int valid_enable(string usage) { return usage == "medical"; }

int valid_learn(object me)
{
	if ((int)me->query_skill("medical", 1) < 50)
		return notify_fail("你的基本医术造诣太浅，无"
				   "法领会针灸术。\n");

	if ((int)me->query_skill("medical", 1) < (int)me->query_skill("zhenjiu-shu", 1))
		return notify_fail("你的基本医术水平有限，无"
				   "法掌握更深奥的针灸术。\n");

	return 1;
}
string query_description()
{
    return "针灸术是一门高深的医术，通过刺激人体穴位来治疗疾病。\n\n"
           "技能要求:\n"
           "1. 基本医术等级不低于50级\n"
           "2. 基本医术等级不低于针灸术等级\n\n"
           "针灸术讲究精准和深入，是一门需要长期钻研的高深医术。\n"
           "熟练掌握针灸术不仅可以治病救人，还能辅助武功修炼。";
}

