// 灵蛇出洞


#include <combat.h>

inherit F_SSERVER;

string query_name() { return "灵蛇" ZJBR "出洞"; }
int query_cd() { return 6; }

int perform(object me, object target)
{
    object weapon;
    int damage;
    string msg;

    if (! target) target = offensive_target(me);
    if (! target || ! me->is_fighting(target))
        return notify_fail("「灵蛇出洞」只能对战斗中的对手使用。\n");

    if (! objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "blade")
        return notify_fail("你使用的武器不对。\n");

    if ((int)me->query_skill("lingshe-blade", 1) < 40)
        return notify_fail("你的灵蛇刀法不够娴熟，不会使用「灵蛇出洞」。\n");

    if ((int)me->query("neili") < 85)
        return notify_fail("你的内力不够。\n");

    if (me->query_skill_mapped("blade") != "lingshe-blade")
        return notify_fail("你没有激发灵蛇刀法，不能使用「灵蛇出洞」。\n");

    msg = HIG "$N" HIG "使出灵蛇刀法的绝技「灵蛇出洞」，手中" + weapon->name() +
          HIG "如灵蛇吐信般诡异地刺向$n" HIG "！" NOR "\n";

    if (random(me->query_skill("blade")) > target->query_skill("dodge") / 3)
    {
        damage = (int)me->query_skill("lingshe-blade", 1);
        damage = damage + random(damage / 2);

        me->add("neili", -85);
        COMBAT_D->real_damage(me, target, damage);

        msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 20,
                                   HIR "$n" HIR "躲闪不及，被$N" HIR
                                   "这诡异的一刀刺中要害！" NOR "\n");
        me->start_busy(2);
    } else
    {
        msg += CYN "$n" CYN "看破了$N" CYN "的攻势，连忙后退避开。" NOR "\n";
        me->add("neili", -40);
        me->start_busy(3);
    }
    message_combatd(msg, me, target);
    return 1;
}