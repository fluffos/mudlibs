inherit SKILL;

string type() { return "knowledge"; }

void skill_improved(object me)
{}

int valid_learn(object me)
{
	if ((int)me->query_skill("literate", 1) < 100)
		return notify_fail("你连读书写字都没学好，怎么学习梵文？\n");

	if ((int)me->query_skill("literate", 1) < (int)me->query_skill("sanscrit", 1))
		return notify_fail("你的读书写字水平有限，无法掌握更深奥的梵文。\n");

	return 1;

}

string query_description()
{
    string msg;

    msg = HIY "【梵文】" ZJBR ZJBR NOR; // 基本介绍
    msg += WHT "一门古老而深奥的文字，记载着许多佛学经典。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  读书写字等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "  读书写字等级不能低于梵文等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // type()
    msg += "  知识技能（knowledge）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill (无)
    msg += "  无法练习。" ZJBR ZJBR; // 无法练习

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // skill_improved (空)
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // 无 perform/exert
    msg += "  无。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 学习梵文需要较高的读书写字基础。" ZJBR;

    return msg;
}

