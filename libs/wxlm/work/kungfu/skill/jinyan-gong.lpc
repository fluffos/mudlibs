// jinyan-gong.c 金雁功
// By Lgg,1998.10

inherit SKILL;

string *dodge_msg = ({
	"$n足尖在地面一点，身形拔地而起，躲开了这一招。\n",
	"却不料$n身形一转，突然转到了$N的身后。\n",
	"$n随着$N攻来的招式飘了起来，就如一片微风中的柳絮一般。\n",
	"$n身形左一晃、右一闪，不知怎么的，从攻击的间隙中钻了出来。\n",
	"$n足不点地地围绕$N连绕三个大圈，把$N这一招避了开去。\n",
	"$n连旋数个大圈，跟着又是一个大圈，身形高高地拔了起来。\n",
});

int valid_enable(string usage)
{
	return (usage == "dodge") || (usage == "move");
}

int valid_learn(object me)
  { 
     if (me->query_skill("dodge",1) <= me->query_skill("jinyan-gong",1) )
	return notify_fail("你的基本轻功基础不够，无法领会更高深的金雁功。\n");
    else    return 1;
  }

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
	if( (int)me->query("qi") < 50 )
		return notify_fail("你的体力太差了，不能练习金雁功。\n");

	me->receive_damage("qi", 40);
	return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【金雁功】" ZJBR ZJBR NOR;
    msg += WHT "全真教闻名天下的轻功绝技，步法轻盈迅捷，犹如金雁横空。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本轻功 (dodge) 等级不低于金雁功等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  轻功 (dodge)。" ZJBR;
    msg += "  身法 (move)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "40" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 主要提升闪避和移动能力。\n";

    return msg;
}
