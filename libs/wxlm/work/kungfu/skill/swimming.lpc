// swimming.c (Simba 16 OCT 97)
// modified by Venus Oct.1997
inherit SKILL;

string query_description()
{
    string msg;

    msg = HIY "【基本轻功·游泳】" ZJBR NOR;
    msg += "一项基础的轻身功夫，掌握后可提升移动和闪避能力，并可在水域中移动。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  无特殊要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  轻功（dodge）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  该技能无法通过练习提升，需要通过其他方式学习。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR;

    return msg;
}

