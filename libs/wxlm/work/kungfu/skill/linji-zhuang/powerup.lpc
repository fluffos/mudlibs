// powerup.c 临济桩功



inherit F_CLEAN_UP;

void remove_effect(object me, int amount, int di);

string query_name() { return "临济桩功"; }
string *pfm_type() { return ({ "force", }); }

int exert(object me, object target)
{
    int skill;
    int di;
    object weapon;

    if (target != me)
        return notify_fail("你只能用「临济桩功」提升自己的战斗力。\n");

    if ((int)me->query("neili") < 200)
        return notify_fail("你的内力不足，无法运转「临济桩功」。\n");

    if ((int)me->query_temp("powerup"))
        return notify_fail("你已经在运功中了。\n");

    skill = me->query_skill("force");

    me->add("neili", -200);
    me->receive_damage("qi", 0);

    if (me->query("gender") == "女性")
        di = skill / 2;
    else
        di = skill / 3;
    if (di > 150) di = 150;

    message_combatd(HIM "$N" HIM "凝神聚气，运转「临济桩功」，顿时气势如虹，仿佛天神下凡。\n"
                    "周围空气骤然凝结，令人感到一阵窒息的压迫感。\n" NOR, me);

    if (objectp(weapon = me->query_temp("weapon")))
    {
        if (di >= 140)
            message_combatd(HIR "$N" HIR "手中" + weapon->name() + HIR "绽放出耀眼的光芒，映照得天地一片赤红，\n"
                            "杀气弥漫，令人望而生畏。\n" NOR, me);
        else if (di >= 100)
            message_combatd(HIR "$N" HIR "手中" + weapon->name() + HIR "发出阵阵龙吟之声，气势恢宏，令人心神震颤。\n" NOR, me);
        else if (di >= 50)
            message_combatd(HIR "$N" HIR "手中" + weapon->name() + HIR "微微颤动，散发出淡淡的光芒，暗藏无尽威力。\n" NOR, me);
    }

    me->add_temp("apply/attack", skill / 2);
    me->add_temp("apply/dodge", skill);
    me->add_temp("apply/damage", di);
    me->set_temp("powerup", 1);
    me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill / 2, di :), skill / 2);

    if (me->is_fighting()) me->start_busy(2);

    return 1;
}

void remove_effect(object me, int amount, int di)
{
    if (me->query_temp("powerup"))
    {
        me->add_temp("apply/attack", -amount);
        me->add_temp("apply/dodge", -amount * 2);
        me->add_temp("apply/damage", -di);
        me->delete_temp("powerup");
        tell_object(me, HIC "你感到内力渐渐平息，将「临济桩功」收回丹田。\n" NOR);
    }
}
