// 流水刀法

inherit SKILL;

mapping *action = ({
([      "action" : "$N手中$w如流水般划出一道优美的弧线,一招「流水行云」斩向$n的$l",
        "force" : 100,
        "attack": 35,
        "dodge" : 30,
        "parry" : 25,
        "damage": 50,
        "lvl"   : 0,
        "skill_name" : "流水行云",
        "damage_type" : "割伤"
]),
});

int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

int valid_learn(object me)
{
    if ((int)me->query("max_neili") < 80)
        return notify_fail("你的内力不够。\n");

    if ((int)me->query_skill("force") < 20)
        return notify_fail("你的内功火候太浅。\n");

    if ((int)me->query_skill("blade", 1) < (int)me->query_skill("liushui-blade", 1))
        return notify_fail("你的基本刀法水平有限，无法领会更高深的流水刀法。\n");

    return 1;
}

string query_skill_name(int level)
{
    return action[0]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    return action[0];
}

int practice_skill(object me)
{
    object weapon;

    if (!objectp(weapon = me->query_temp("weapon")) || 
        (string)weapon->query("skill_type") != "blade")
        return notify_fail("你使用的武器不对。\n");

    if ((int)me->query("qi") < 40)
        return notify_fail("你的体力不够练流水刀法。\n");

    if ((int)me->query("neili") < 40)
        return notify_fail("你的内力不够练流水刀法。\n");

    me->receive_damage("qi", 35);
    me->add("neili", -35);
    return 1;
}

string perform_action_file(string action)
{
    return __DIR__"liushui-blade/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【流水刀法】" ZJBR NOR;
    msg += "基础刀法，讲究以柔克刚，刀法如行云流水般连绵不绝。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力 (`max_neili`) 不低于 " HIB "80" NOR " 点。" ZJBR;
    msg += "  基本内功 (`force`) 等级不低于 " HIY "20" NOR " 级。" ZJBR;
    msg += "  基本刀法 (`blade`) 等级需大于等于流水刀法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  刀法 (`blade`)。" ZJBR;
    msg += "  招架 (`parry`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  必须装备刀类武器。" ZJBR;
    msg += "  气血 (`qi`) 不低于 " HIR "40" NOR " 点。" ZJBR;
    msg += "  内力 (`neili`) 不低于 " HIB "40" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血 " HIR "35" NOR " 点，内力 " HIB "35" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (Perform)〗" ZJBR NOR;
    msg += HIC "  流水行云 (liushui)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      流水刀法等级不低于 " HIY "40" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "80" NOR " 点。" ZJBR;
    msg += "      激发刀法为流水刀法。" ZJBR;
    msg += "      必须装备刀类武器。" ZJBR;
    msg += "      只能对战斗中的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：若 `随机(自身刀法激发等级) > 目标轻功激发等级 / 3` 则命中。" ZJBR;
    msg += "      命中后对目标造成伤害，基础伤害约为 `(流水刀法等级 + 随机(流水刀法等级 / 2))`，并造成气血损伤。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：消耗内力 " HIB "80" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：消耗内力 " HIB "40" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;
    msg += "    冷却时间：" HIM "6" NOR " 秒。" ZJBR;

    return msg;
}