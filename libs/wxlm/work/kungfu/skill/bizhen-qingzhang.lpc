int valid_enable(string usage) { return usage=="strike" || usage=="parry"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练清荷针掌必须空手。\n");

	if ((int)me->query_skill("force") < 250)
		return notify_fail("你的内功火候不够，无法练习清荷针掌。\n");

	if ((int)me->query("max_neili") < 2500)
		return notify_fail("你的内力太弱，无法练习清荷针掌。\n");

	if ((int)me->query_skill("strike", 1) < 180)
		return notify_fail("你的基本掌法火候不够，无法练习清荷针掌。\n");

	if ((int)me->query_skill("strike", 1) < (int)me->query_skill("bizhen-qingzhang", 1))
		return notify_fail("你的基本掌法水平有限，无法领会更高深的清荷针掌。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action) - 1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("bizhen-qingzhang",1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i - 1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 100)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 100)
		return notify_fail("你的内力不够练清荷针掌。\n");

	me->receive_damage("qi", 80);
	me->add("neili", -80);
	return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	if (damage_bonus < 100) return 0;

	if (random(me->query_skill("force")) > victim->query_skill("force") / 2)
	{
		victim->receive_wound("qi", (damage_bonus - 100) / 2);
		return HIR "只听" + victim->name() +
		       HIR "前胸“喀嚓”一声，竟像是肋骨碎断的声音！"NOR"\n";
	}
}

string perform_action_file(string action)
{
	return __DIR__"bizhen-qingzhang/" + action;
}

string query_description()
{
    string msg;

    msg = "";
    msg += HIY "【碧针清掌】" ZJBR ZJBR NOR;
    msg += WHT "碧针清掌是一门以轻灵快速见长的掌法，以其精妙绝伦、变化多端而闻名。" ZJBR;
    msg += "此掌法讲究以快打慢，以巧胜力，招式看似轻柔，实则暗藏杀机。" ZJBR ZJBR;
    msg += HIY "【学习要求】" ZJBR NOR;
    msg += "  内力最大值 2500 点" ZJBR;
    msg += "  内功等级 250 级" ZJBR;
    msg += "  基本掌法等级 180 级" ZJBR ZJBR;

    msg += HIY "【特殊效果】" ZJBR NOR;
    msg += "  可激发为掌法（strike）或招架（parry）" ZJBR ZJBR;

    msg += HIY "【练习要求】" ZJBR NOR;
    msg += "  气血不少于 100 点" ZJBR;
    msg += "  内力不少于 100 点" ZJBR;
    msg += "  每次练习消耗：" ZJBR;
    msg += "    气血：80 点" ZJBR;
    msg += "    内力：80 点" ZJBR ZJBR;

    msg += HIY "【伤害效果】" ZJBR NOR;
    msg += "  当伤害大于 100 点时，有几率造成额外伤害" ZJBR;
    msg += "  额外伤害 = (伤害值 - 100) / 2" ZJBR;
    msg += "  触发条件：自身内功等级 > 对方内功等级 / 2" ZJBR ZJBR;
    msg += HIY "【特殊招式】" ZJBR NOR;
    msg += HIW "1. 清影澎湃（pengpai）：" ZJBR NOR;
    msg += "  要求：碧针清掌180级，内功300级，内力3000点" ZJBR;
    msg += "  内力消耗：300点" ZJBR;
    msg += "  效果：对敌人造成巨大伤害" ZJBR;
    msg += "  描述：双掌挥舞出一个大圈，横推而出，顿时一股汹涌澎湃的劲气如波浪一般向对手涌来" ZJBR ZJBR;
    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 碧针清掌需要高超的内功修为，练习时需要注意提高基本内功。" ZJBR;
    msg += "2. 在实战中，要善于利用掌法的轻灵特点，快速压制对手。" ZJBR;
    msg += "3. 清影澎湃作为强大的攻击招式，使用时机很重要，应在关键时刻施展。\n";

    return msg;
}