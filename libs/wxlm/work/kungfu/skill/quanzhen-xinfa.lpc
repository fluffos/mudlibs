// quanzhen-xinfa 全真心法

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_force(string force)
{
	return force == "xiantian-gong" ||
	       force == "duanshi-xinfa";
}

int valid_learn(object me)
{
       if (me->query_skill("force",1) <= me->query_skill("quanzhen-xinfa",1) )
	return notify_fail("你的基本内功基础不够，无法领会更高深的全真心法。\n");
	   else    return 1;
}

int practice_skill(object me)
{
	return notify_fail("全真心法只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"quanzhen-xinfa/" + func;
}
string query_description()
{
    string msg;

    msg = HIY "【全真心法】" ZJBR NOR;
    msg += WHT "全真教基础内功，乃玄门正宗内功，练习可增强内力修为。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功等级 ≥ 全真心法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功 (force)" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  无法通过练习 (practice) 提高，只能通过学习 (learn) 来提升等级。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  可与 先天功 (xiantian-gong) 或 段氏心法 (duanshi-xinfa) 相互配合。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (exert)〗" ZJBR NOR;
    msg += "  包含一些内功运用 (exert) 功能（具体效果需参考对应目录下的文件）。" ZJBR ZJBR;

    return msg;
}
