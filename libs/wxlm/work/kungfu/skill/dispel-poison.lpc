// shedu-qiqiao.c

inherit SKILL;

int valid_enable(string usage) { return usage == "medical"; }

int valid_learn(object me)
{
	if (me->query("family/family_name") != "关外胡家")
		return notify_fail("关外胡家的弟子才能学习该技能。\n");
	
	if ((int)me->query_skill("force") < 80)
		return notify_fail("你的内功火候不够，无法学习妙手驱毒。\n");

	if ((int)me->query("max_neili") < 350)
		return notify_fail("你的内力太弱，无法学习妙手驱毒。\n");

	if ((int)me->query_skill("medical", 1) < 30)
		return notify_fail("你的基本医术火候不够，无法学妙手驱毒。\n");

	if ((int)me->query_skill("medical", 1) < (int)me->query_skill("dispel-poison", 1))
		return notify_fail("你的基本医术水平有限，无法领会更高深的妙手驱毒。\n");

	return 1;
}

int practice_skill(object me)
{
	return notify_fail("妙手驱毒只能通过学习获得长进。\n");
}

string query_description()
{
    string msg;

    msg = HIY "【妙手驱毒】" ZJBR NOR;
    msg += "关外胡家独门医术，擅长解除各种毒素。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  须为 " HIW "关外胡家" NOR " 弟子。" ZJBR;
    msg += "  基本内功 (force) 等级不低于 " HIY "80" NOR " 级。" ZJBR;
    msg += "  最大内力 (max_neili) 不低于 " HIB "350" NOR " 点。" ZJBR;
    msg += "  基本医术 (medical) 等级不低于 " HIY "30" NOR " 级。" ZJBR;
    msg += "  基本医术 (medical) 等级需不低于妙手驱毒等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  医术（medical）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  无法通过练习提升，只能通过学习提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  提升解除中毒状态的效果。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR;

    return msg;
}
