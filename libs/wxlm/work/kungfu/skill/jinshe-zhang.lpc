int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon")) 
		return notify_fail("练习腾蛇游身掌必须空手。\n"); 

	if ((int)me->query("max_neili") < 500)
		return notify_fail("你的内力不足，无法练腾蛇游身掌。\n");

	if ((int)me->query_skill("force") < 80)
		return notify_fail("你的内功火候不够，无法练腾蛇游身掌。\n");

	if ((int)me->query_skill("strike", 1) < (int)me->query_skill("jinshe-zhang", 1))
		return notify_fail("你的基本掌法水平有限，无法领会更高深的腾蛇游身掌。\n");

	return 1;
}

int valid_enable(string usage) { return usage=="strike" || usage=="parry"; }

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int practice_skill(object me)
{
	if( (int)me->query("qi") < 70 )
		return notify_fail("你的体力不够了，休息一下再练吧。\n");

	if( (int)me->query("neili") < 55 )
		return notify_fail("你的内力不够了，休息一下再练吧。\n");

	me->receive_damage("qi", 55);
	me->add("neili", -53);
	return 1;
}

int effective_level() { return 10;}
 
string *parry_msg = ({
	"$n使出「粘」字诀，双掌一划，引偏了$N的$w。\n",
});

string *unarmed_parry_msg = ({
	"$n施展出腾蛇游身掌，轻描淡写的化解了$N的攻势。\n",
});

string query_parry_msg(object weapon)
{
	if (weapon)
		return parry_msg[random(sizeof(parry_msg))];
	else
		return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string perform_action_file(string action)
{
	return __DIR__"jinshe-zhang/" + action;
}
string query_description()
{
    string msg;

    msg = HIY "【腾蛇游身掌】" ZJBR ZJBR NOR;
    msg += WHT "传自上古的异种武学，招式怪异，变幻无方，配合毒技威力更大。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  必须空手。" ZJBR;
    msg += "  基本内功 (force) 等级 " HIY "80" NOR " 级。" ZJBR;
    msg += "  最大内力 " HIB "500" NOR " 点。" ZJBR;
    msg += "  基本掌法 (strike) 等级不低于腾蛇游身掌等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  掌法 (strike)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血：不低于 " HIR "70" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "55" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "55" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "53" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  空手招架时有特殊描述。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  附骨缠身 (fugu)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      腾蛇游身掌等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      必须空手，且激发并备好腾蛇游身掌。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      判定条件：若目标正忙乱，或 随机(你的掌法激发等级) > (目标的招架激发等级 / 2)。" ZJBR;
    msg += "      判定成功：使目标忙乱 1 秒（如果未忙乱），并立即进行数次普通攻击（次数由 `COMBAT_D->query_base_attack_number` 决定）。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      判定成功：内力 " HIB "150" NOR " 点，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      判定失败：无内力消耗，自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 该技能必须空手才能练习和使用。" ZJBR;
    msg += "2. 附骨缠身招式的普通攻击伤害受自身属性和装备影响。
";

    return msg;
}