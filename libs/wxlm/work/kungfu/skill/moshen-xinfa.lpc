// This program is a part of NITAN MudLIB

inherit FORCE;

int valid_enable(string usage)
{
            return usage == "force";
}

int valid_force(string force)
{
        return 1;
}

int valid_learn(object me)
{
            return ::valid_learn(me);
}

int practice_skill(object me)
{
            return notify_fail("魔神心法只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
            return __DIR__"moshen-xinfa/" + func;
}

string query_description()
{
    string msg;

    msg = HIY "【魔神心法】" ZJBR NOR;
    msg += "一种基础内功心法，具体来源不明，注重激发战斗潜能和防御能力。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  学习要求继承自通用学习函数 (`::valid_learn(me)`)，通常无特殊限制。" ZJBR ZJBR; // 假设没有特殊限制，因为代码未明确指出

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  内功 (`force`)" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  魔神心法无法通过练习 (`practice`) 提升，只能通过学习 (`learn`) 或研究提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // hit_ob, valid_damage, skill_improved etc.
    msg += "  该心法本身未定义特殊的攻击命中、伤害化解或属性成长效果。" ZJBR ZJBR; // 代码中未定义

    msg += HIY "〖特殊招式 (内功运用 exert)〗" ZJBR NOR;
    msg += HIC "  魔神战气 (powerup)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      当前内力 " HIB "150" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升自身攻击力 (内功激发等级 / 3) 和防御力 (内功激发等级 / 3)。" ZJBR;
    msg += "      添加临时状态 `powerup`。" ZJBR;
    msg += "      效果持续时间等于基本内功等级。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      使用后忙乱 " HIR "3" NOR " 秒（如果在战斗中）。" ZJBR ZJBR;

    msg += HIC "  魔神护体 (shield)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      魔神心法等级 " HIY "50" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升自身护甲值 (`apply/armor`) (内功激发等级 / 2)。" ZJBR;
    msg += "      添加临时状态 `shield`。" ZJBR;
    msg += "      效果持续时间等于基本内功等级。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      使用后忙乱 " HIR "2" NOR " 秒（如果在战斗中）。" ZJBR;

    return msg;
}
