// /kungfu/skill/gandanqinxin.c


inherit FORCE;

int valid_enable(string usage) { return usage == "force" || usage == "parry"; }

int valid_learn(object me)
{
    if ((int)me->query_skill("force", 1) < 50)
        return notify_fail("你的基本内功火候还不够。\n");
    return 1;
}

int query_neili_improve(object me)
{
	int lvl;

	lvl = (int)me->query_skill("gandanqinxin", 1);
	return lvl * lvl * 15 * 19 / 100 / 200;
}

int practice_skill(object me)
{
    return notify_fail("肝胆琴心只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string action)
{
        return __DIR__"gandanqinxin/exert/" + action;
}
string perform_action_file(string action)
{
    return __DIR__"gandanqinxin/perform/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【肝胆琴心】" ZJBR NOR;
    msg += WHT "以琴音操控元素的特殊内功，攻防兼备。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功等级不低于 " HIY "50" NOR " 级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功（force）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  无法通过练习提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  提升内力上限：效果随等级提升 (公式: `基本等级 * 基本等级 * 0.01425`)。" ZJBR;
    msg += "  琴音招架：" ZJBR;
    msg += "    条件：肝胆琴心基本等级不低于 " HIY "100" NOR " 级，且存活。" ZJBR;
    msg += "    效果：" ZJBR;
    msg += "      判定条件：(攻击者内功激发等级 / 2 + 随机(攻击者内功激发等级)) < 防御力(DP)。" ZJBR;
    msg += "      防御力(DP) = ((招架激发等级 / 2) + 肝胆琴心基本等级 + 琴法等级 / 3 + 音律等级 / 3) * 效果比率。" ZJBR;
    msg += "      效果比率：在100-1000级之间从 50% 线性提升至 100%。" ZJBR;
    msg += "      成功招架时：化解本次伤害，并显示招架信息。" ZJBR;
    msg += "        若攻击者使用兵器，则对其造成反震伤害。" ZJBR;
    msg += "        反震伤害 = (原伤害 / 3 * 效果比率) - (攻击者护甲 / 4) (最低为 0)。" ZJBR;
    msg += "      失败时：显示招架失败信息。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (内功运用 exert)〗" ZJBR NOR;
    msg += HIC "  广陵散 (guanglangsan)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      当前内力不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "      未处于 `guanglangsan` 状态。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      提升自身造成的最终伤害。" ZJBR;
    msg += "        基础伤害加成 = (内功激发等级 / 3)。" ZJBR;
    msg += "        受奥义【有我神像】加成：最终加成 = 基础加成 + (基础加成 * 意境等级 * 10%)。" ZJBR;
    msg += "      效果持续时间为 (内功激发等级) 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      若在战斗中，自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (琴法绝招 perform)〗" ZJBR NOR;
    msg += HIC "  肝胆琴心 (baozou)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      肝胆琴心基本等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      基本内功等级不低于 " HIY "200" NOR " 级。" ZJBR;
    msg += "      基本音律等级不低于 " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "      装备类型为琴（qin）的武器。" ZJBR;
    msg += "      已积累火音符 (`huoyin_count`) 或冰音符 (`bingyin_count`)。" ZJBR;
    msg += "      不在冷却时间内 (`gandanqinxin_baozou`)。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：使用 `通用命中公式`。" ZJBR;
    msg += "        攻击力(AP) = (肝胆琴心激发等级 + 音律激发等级 + 琴法激发等级)。" ZJBR;
    msg += "        受奥义【有我神像】加成：最终 AP = AP + (AP * 意境等级 * 10%)。" ZJBR;
    msg += "        防御力(DP) = (目标内功激发等级 + 目标招架激发等级)。" ZJBR;
    msg += "      命中后效果 (消耗所有音符，保留 1/3)：" ZJBR;
    msg += "        若 火音符 >= 冰音符：" ZJBR;
    msg += "          造成气血伤害和气血内伤。" ZJBR;
    msg += "          基础伤害 = (AP * 2) + (火音符数量 * 50)。" ZJBR;
    msg += "          受奥义【有我神像】加成：最终伤害 = 基础伤害 + (基础伤害 * 意境等级 * 10%)。" ZJBR;
    msg += "        若 冰音符 > 火音符：" ZJBR;
    msg += "          对目标附加忙乱状态和负面效果（降低攻击、躲闪）。" ZJBR;
    msg += "          基础减益值 = (肝胆琴心基本等级 / 2)。" ZJBR;
    msg += "          受奥义【有我神像】加成：最终减益值 = 基础减益值 + (基础减益值 * 意境等级 * 10%)。" ZJBR;
    msg += "          控制/负面效果持续时间 = (3 + 冰音符数量) 秒 (忙乱最高 15 秒)。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "250" NOR " 点。" ZJBR;
    msg += "      冷却时间：(15 - 奥义【有我神像】等级) 秒 (最少 1 秒)。" ZJBR;

    return msg;
}

// 添加招架信息
string *parry_msg = ({
    "$N的攻击被$n的琴音所化解，内力消散于无形。\n",
    "$n指尖轻拨琴弦，$N只觉得招式被一股柔和的力量卸去。\n",
    "$n琴音回荡，$N的攻势如泥牛入海，毫无着力之处。\n",
    "$n手抚琴弦，发出一缕清音，$N的攻击竟被音波荡开。\n",
    "$n以琴为盾，$N的攻击落在琴身上却诡异地偏转开来。\n",
    "$n指法轻灵，弹出一串音符，$N的攻势被音波层层化解。\n",
});

string *pfail_msg = ({
    "$n试图以琴音化解攻势，却被$N的内力所破，琴音顿时紊乱。\n",
    "$n指尖拨动琴弦，却未能阻挡$N势大力沉的一击。\n",
    "$n琴音未绝，$N已看破其中虚实，招式丝毫不受影响。\n",
    "$n手中琴音虽妙，却难敌$N精妙绝伦的攻势。\n",
});

// 添加招架效果
mixed valid_damage(object ob, object me, int damage, object weapon)
{
    mapping result;
    string msg;
    int ap, dp, skill;
    float effect_rate;

    if ((int)me->query_skill("gandanqinxin", 1) < 100 || ! living(me))
        return;
    
    // 计算琴法和音律的影响
    skill = me->query_skill("gandanqinxin", 1);
    
    // 计算效果比率（100-1000级逐渐提升到100%）
    effect_rate = 0.5 + (skill - 100) * 0.5 / 900.0;
    if (effect_rate > 1.0) effect_rate = 1.0;
    
    // 计算攻防值
    ap = ob->query_skill("force");
    dp = me->query_skill("parry") / 2 + 
         me->query_skill("gandanqinxin", 1) +
         me->query_skill("qin", 1) / 3 +    // 琴法影响
         me->query_skill("yinlv", 1) / 3;   // 音律影响
    
    
    // 根据效果比率调整防御值
    dp = to_int(dp * effect_rate);

    if (ap / 2 + random(ap) < dp)
    {
        msg = parry_msg[random(sizeof(parry_msg))];
        msg = replace_string(msg, "$N", "$N" HIG);
        msg = replace_string(msg, "$n", "$n" HIG);
        msg = HIG + msg + NOR;

        // 如果敌方携带了兵器，造成反伤
        if (objectp(weapon))
        {
            int reflect_damage = to_int(damage / 3 * effect_rate);  // 反伤比例随等级提升
            reflect_damage -= ob->query_temp("apply/armor") / 4;
            if (reflect_damage < 0) reflect_damage = 0;

            ob->receive_damage("qi", reflect_damage, me);
            ob->receive_wound("qi", reflect_damage, me);

            msg += "$n的琴音与$N的" + weapon->name() + "产生共鸣，反震伤害：" + 
                   reflect_damage + "点。\n";
        }

        result = ([ "damage": -(damage * 3 / 4),
                   "msg" : msg ]);
        return result;
    }
    else
    {
        msg = pfail_msg[random(sizeof(pfail_msg))];
        msg = replace_string(msg, "$N", "$N" HIY);
        msg = replace_string(msg, "$n", "$n" HIY);
        msg = HIY + msg + NOR;
        COMBAT_D->set_bhinfo(msg);
    }
}