
#include <combat.h>

#define HUANYING "「" HIW "幻影迷踪" NOR "」"

inherit F_SSERVER;

string query_name() { return "幻影"ZJBR"迷踪"; }

int perform(object me, object target)
{
    int damage;
    string msg;
    int ap, dp;

    if (! target) target = offensive_target(me);

    if (! target || ! me->is_fighting(target))
        return notify_fail(HUANYING "只能对战斗中的对手使用。\n");

    if (me->query_skill("huanying_mizong", 1) < 80)
        return notify_fail("你的幻影迷踪拳还不够娴熟，无法施展" HUANYING "。\n");

    if (me->query("neili") < 150)
        return notify_fail("你的真气不够，无法施展" HUANYING "。\n");

    if (me->query_skill_mapped("cuff") != "huanying_mizong")
        return notify_fail("你没有激发幻影迷踪拳，无法使用" HUANYING "。\n");

    if (! living(target))
        return notify_fail("对方都已经这样了，用不着这么狠吧。\n");

    msg = HIM "$N" HIM "身形突然变得飘忽不定，幻影迷踪拳施展开来，令$n" HIM "眼花缭乱！\n" NOR;

    ap = me->query_skill("cuff") + me->query_skill("dodge");
    dp = target->query_skill("dodge") + target->query_skill("parry");

    if (COMBAT_D->hit_determination(me,target,ap,dp))
    {
        damage = ap / 3 + random(ap / 3);
        me->add("neili", -100);
        msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 40,
                                   HIR "$n" HIR "只觉得眼前一花，$N" HIR "的拳影已然笼罩全身，"
                                   "一时不知如何招架，被重重击中！\n" NOR);
        me->start_busy(2);
        if (ap / 3 + random(ap) > dp && ! target->is_busy())
            target->start_busy(2);
    } else
    {
        me->add("neili", -50);
        msg += CYN "可是$n" CYN "看破了$N" CYN "的身法，巧妙地避开了这次攻击。\n" NOR;
        me->start_busy(3);
    }
    message_combatd(msg, me, target);
    return 1;
}
