inherit SKILL;

string *dodge_msg = ({
	"只见$n清啸一声，身体向上笔直地纵起丈余，躲过了$N这一招。\n",
	"只见$n身行随意转，如同一条游鱼，倏地往一旁挪开了三尺，避过了这一招。\n",
	"$n陡然扭身闪开，如一条游鱼般地躲过了$N的攻势。\n",
	"$n身子一拔数丈，接着向後一个转折，$N招数便全数落空。\n",
	"$N即将击中$n，不知道怎么$n突然消失，出现在$N後方！\n",
	"$n突然身子如鬼魅般向後滑行，倏忽已在五丈开外。\n",
});

int valid_enable(string usage) 
{ 
	return (usage == "dodge") || (usage == "move"); 
}

int valid_learn(object me) { return 1; }

string query_txt()
{
	return "要求：无"ZJBR
	"特效：轻功化解对手的攻击，对比自身(轻功激发)和攻击者轻功激发，同激发等级1/4概率触发，不受特殊技能克制";
}

mixed valid_damage(object ob, object me, int damage, object weapon)
{
	mixed result;
	int ap, dp;

	if ((int)me->query_skill("shexing-lifan", 1) < 100 || ! living(me))
		return;

	ap = ob->query_skill("dodge");
	dp = me->query_skill("dodge");

	if (random(ap*4) < dp)
	{
		result = ([ "damage": -(damage * 3 / 4) ]);

		switch (random(4))
		{
		case 0:
		case 1:
		default:
			result += (["msg" : HIM "但见$n" HIM "忽然步伐一变，闪出几个幻影，$N"
					    HIM "一时间所有攻击全落在了空处。"NOR"\n"]);
			break;
		}
		return result;
	} else
	{
		switch (random(4))
		{
		case 0:
		case 1:
		default:
			result = HIY "只见$n" HIY "微微一笑，身子轻轻晃动，"
				 "顿时出现了无数个$n" HIY "的幻影，可是$N"
				 HIY "不为所动，将其中虚实辨得清清楚楚。"NOR"\n";
			break;
		}
		COMBAT_D->set_bhinfo(result);
	}
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

string perform_action_file(string action)
{
	return __DIR__"shexing-lifan/" + action;
}

int practice_skill(object me)
{
	return notify_fail("幻阴步只能通过研究来提高。\n");
}

string query_description()
{
    string msg;

    msg = HIY "【幻阴步】" ZJBR NOR;
    msg += WHT "九阴真经所载轻功身法，步法诡异，幻化无形，令人难以捉摸。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  无特殊要求。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  轻功（dodge）。" ZJBR;
    msg += "  步法（move）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  无法练习，只能通过研究 (`research`) 提升等级。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // valid_damage, query_dodge_msg
    msg += "  被动闪避：幻阴步等级不低于 " HIY "100" NOR " 级时，" ZJBR;
    msg += "            受到攻击时有概率完全化解伤害。" ZJBR;
    msg += "            触发概率取决于双方轻功激发等级对比，若等级相当，概率约为 " HIW "1/4" NOR "。" ZJBR;
    msg += "  提供多种闪避描述。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform_action_file

    msg += HIC "  九阴归元 (guiyuan)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      幻阴步等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      先天身法 " HIY "30" NOR " 点。" ZJBR;
    msg += "      基本内功等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      基本轻功等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      最大内力 " HIB "1000" NOR " 点。" ZJBR;
    msg += "      当前内力 " HIB "250" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      短时间内提升后天身法，提升值等于 （幻阴步等级 / 30）。" ZJBR;
    msg += "      持续时间等于 （幻阴步等级 / 2） 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "200" NOR " 点。" ZJBR;
    msg += "      若在战斗中使用，忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    return msg;
}

int difficult_level()
{
        return 500;
}