
#include <combat.h>

inherit F_SSERVER;

string query_name() { return "狂风" ZJBR "骤雨"; }
int query_cd() { return 7; }

int perform(object me, object target)
{
    object weapon;
    int damage;
    string msg;

    if (! target) target = offensive_target(me);
    if (! target || ! me->is_fighting(target))
        return notify_fail("「狂风骤雨」只能对战斗中的对手使用。\n");

    if (! objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "blade")
        return notify_fail("你使用的武器不对。\n");

    if ((int)me->query_skill("kuangfeng-blade", 1) < 40)
        return notify_fail("你的狂风刀法不够娴熟，不会使用「狂风骤雨」。\n");

    if ((int)me->query("neili") < 90)
        return notify_fail("你的内力不够。\n");

    if (me->query_skill_mapped("blade") != "kuangfeng-blade")
        return notify_fail("你没有激发狂风刀法，不能使用「狂风骤雨」。\n");

    msg = HIY "$N" HIY "使出狂风刀法的绝技「狂风骤雨」，手中" + weapon->name() +
          HIY "如狂风骤雨般向$n" HIY "劈去！" NOR "\n";

    if (random(me->query_skill("blade")) > target->query_skill("parry") / 3)
    {
        damage = (int)me->query_skill("kuangfeng-blade", 1);
        damage = damage + random(damage / 2);

        me->add("neili", -90);
        COMBAT_D->real_damage(me, target, damage);

        msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 25,
                                   HIR "$n" HIR "躲闪不及，被$N" HIR
                                   "这一连串快刀劈中，鲜血飞溅！" NOR "\n");
        me->start_busy(2);
    } else
    {
        msg += CYN "$n" CYN "看破了$N" CYN "的攻势，连忙后退避开。" NOR "\n";
        me->add("neili", -45);
        me->start_busy(3);
    }
    message_combatd(msg, me, target);
    return 1;
}