// hujia-shenfa.c 胡家身法

inherit SKILL;

string *dodge_msg = ({
    "$n一式「灵狐幻影」，身形飘忽，轻轻一跃，躲过了$N的攻击。\n",
    "$n使出「雪地飞踪」，足尖一点，瞬间移位，避开了$N的招式。\n",
    "$n身形微晃，宛如幻影般消失在$N的视线中，让$N的攻击扑了个空。\n",
    "$n施展出「狐踪无迹」，身形疾退，避开了$N的攻势。\n",
});

int valid_enable(string usage) { return (usage == "dodge"); }

int valid_learn(object me)
{
    if (me->query("dex") < 25)
        return notify_fail("你的身法不够灵巧，无法学习胡家身法。\n");

    if (me->query_skill("dodge", 1) < 100)
        return notify_fail("你的基本轻功不够，无法学习胡家身法。\n");

    return 1;
}

string query_dodge_msg(string limb)
{
    return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
    if ((int)me->query("qi") < 60)
        return notify_fail("你的体力太差了，不能练胡家身法。\n");

    me->receive_damage("qi", 50);
    return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【胡家身法】" ZJBR NOR;
    msg += "胡家的基础轻功身法，以灵动迅捷、飘忽不定著称，宛如灵狐幻影，雪地难寻其踪。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  后天身法（DEX）需达到 " HIY "25" NOR " 点。" ZJBR;
    msg += "  基本轻功等级需达到 " HIY "100" NOR " 级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  轻功（dodge）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  气血：不低于 " HIR "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "50" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  暂无。" ZJBR;

    return msg;
}

