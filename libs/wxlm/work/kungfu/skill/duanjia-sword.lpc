int valid_enable(string usage)
{
	return (usage == "sword") ||
	       (usage == "staff") ||
	       (usage == "parry");
}

int valid_learn(object me)
{
    if ((int)me->query("max_neili") < 100)
	return notify_fail("你的内力不够。\n");

    if ((int)me->query_skill("duanshi-xinfa", 1) < 20)
	return notify_fail("你的段氏心法火候太浅。\n");

    if ((int)me->query_skill("sword", 1) < (int)me->query_skill("duanjia-sword", 1))
	return notify_fail("你的基本剑法火候不够，无法领会更高深的段家剑法。\n");

    return 1;
}

mapping query_action(object me, object weapon)
{
    int i, level;
    level = (int) me->query_skill("duanjia-sword",1);
    for (i = sizeof(action); i > 0; i--)
	if (level > action[i-1]["lvl"])
	    return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    object weapon;

    if (! objectp(weapon = me->query_temp("weapon")) ||
	(string)weapon->query("skill_type") != "sword")
	return notify_fail("你使用的武器不对。\n");

    if ((int)me->query("qi") < 50)
	return notify_fail("你的体力不够练段家剑。\n");

    if ((int)me->query("neili") < 40)
	return notify_fail("你的内力不够练段家剑。\n");

    me->receive_damage("qi", 45);
    me->add("neili", -36);
    return 1;
}

string perform_action_file(string action)
{
    return __DIR__"duanjia-sword/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【段家剑法】" ZJBR NOR;
    msg += "大理段氏家传剑法，招式精妙，灵动飘逸。可配合剑或杖施展。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  最大内力 (max_neili) 不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "  段氏心法 (duanshi-xinfa) 等级不低于 " HIY "20" NOR " 级。" ZJBR;
    msg += "  基本剑法 (sword) 等级需不低于段家剑法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  剑法（sword）。" ZJBR;
    msg += "  杖法（staff）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  需装备剑类武器。" ZJBR;
    msg += "  气血：不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "40" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "45" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "36" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无特定被动效果。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform_action_file

    msg += HIC "  五绝剑 (jue)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      需掌握此招 (`can_perform/duanjia-sword/jue`)。" ZJBR;
    msg += "      段家剑法等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "150" NOR " 点。" ZJBR;
    msg += "      需装备剑或杖类武器，战斗中使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      连续发动相当于普通攻击次数的攻击。" ZJBR;
    msg += "      每次攻击有 " HIY "20%" NOR " 的几率使未忙乱的目标陷入 " HIR "1" NOR " 秒忙乱状态。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "100" NOR " 点，自身忙乱 " HIR "1-5" NOR " 秒 (随机)。" ZJBR ZJBR;

    msg += HIC "  惊天一击 (jing)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      段家剑法等级 " HIY "70" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "120" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "      需装备剑类武器，激发段家剑法，战斗中使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      发动一次强力攻击。" ZJBR;
    msg += "      命中判定：比较 随机(自身内功激发) vs (目标内功激发 / 2)。" ZJBR;
    msg += "      伤害计算：命中后造成伤害，基础伤害约为 ((内功激发+基础剑法)/5) 至其两倍之间，有 50% 伤害加成。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力消耗等于造成的伤害值，自身忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "100" NOR " 点，自身忙乱 " HIR "3" NOR " 秒。" ZJBR;

    return msg;
}