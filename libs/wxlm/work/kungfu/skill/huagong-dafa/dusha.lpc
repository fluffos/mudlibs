 
// dusha.c 化功毒煞


#include <combat.h>

inherit F_SSERVER;

string query_name() { return "化功毒煞"; }

int exert(object me, object target)
{
    string msg;
    int ap, dp;
    int damage;
    int neili_absorb;

    //是否在战斗
    if (!me->is_fighting())
        return notify_fail("你不是在战斗中，无法施展化功毒煞。\n");

    if (!target) target = offensive_target(me);


	if (target == me) target = offensive_target(me);

    if ((int)me->query_skill("huagong-dafa", 1) < 150)
        return notify_fail("你的化功大法不够娴熟，无法施展化功毒煞。\n");

    if (me->query("neili") < 500)
        return notify_fail("你的内力不足，无法施展化功毒煞。\n");

    if (me->query_temp("weapon"))
        return notify_fail("你必须空手才能使用化功毒煞！\n");

    if (!living(target))
        return notify_fail("对方已经这样了，不需要这么费力吧？\n");

    msg = HIY "$N" HIY "怪笑一声，双掌忽红忽白，猛然抓向$n！\n" NOR;
    message_combatd(msg, me, target);

    ap = me->query_skill("force") + me->query_skill("poison", 1);
    dp = target->query_skill("force") + target->query_skill("dodge");

    // 如果对手是npc 命中翻倍
    if (!playerp(target)){
    	ap = ap * 2;
    }

    // 如果对手是npc 伤害翻3倍
    if (!playerp(target)){
    	damage = damage * 3;
    }

    me->add("neili", -400);
    me->start_busy(2);

    if (COMBAT_D->hit_determination(me,target,ap,dp))
    {
        damage = ap + random(ap / 2);
        neili_absorb = damage / 3;
        if (neili_absorb > target->query("neili"))
            neili_absorb = target->query("neili") / 2;

        msg = COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 70,
            HIR "$n" HIR "躲闪不及，被$N" HIR "双掌击中，只觉一股阴寒之气直侵心肺，鲜血狂喷！\n" NOR);

        me->add("neili", neili_absorb);
        target->add("neili", -neili_absorb);

        target->affect_by("huagong_poison", ([
            "level" : me->query_skill("poison", 1),
            "id": me->query("id"),
            "duration" : me->query_skill("huagong-dafa", 1) / 10
        ]));
    }
    else
    {
        msg = CYN "$n" CYN "见势不妙，急忙后退，终于躲过了$N" CYN "的毒掌！\n" NOR;
    }

    message_combatd(msg, me, target);
    return 1;
}