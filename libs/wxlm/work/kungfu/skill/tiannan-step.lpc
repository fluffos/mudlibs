// tiannan-step.c 天南步法

inherit SKILL;

string *dodge_msg = ({
    "只见$n一招「旱地拔葱」，身体向上笔直地纵起丈余，躲过了$N这一招。\n",
    "$n一个「雨燕归巢」，向后纵出数丈之远，避开了$N的凌厉攻势。\n",
    "$n使出「破土而出」，向一旁飘然纵出，轻轻着地。\n"
    "但是$n身形飘忽，一招「无中生有」轻轻一纵，早已避开。\n",
    "$n身随意转，一招「乘风而去」倏地往一旁挪开了三尺，避过了这一招。\n",
    "可是$n侧身一让，一招「鲧化大鹏」$N这一招扑了个空。\n",
    "却见$n足不点地，一招「青云直上」往旁窜开数尺，躲了开去。\n",
    "$n身形微晃，一招「凤翔九天」有惊无险地避开了$N这一招。\n"
});

int valid_enable(string usage) { return (usage == "dodge") || (usage == "move");}

int valid_learn(object me)
  { 
     if (me->query_skill("dodge",1) <= me->query_skill("tiannan-step",1) )
	return notify_fail("你的基本轻功基础不够，无法领会更高深的天南步法。\n");
    else    return 1;
  }

string query_dodge_msg(string limb)
{
    return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
    if( (int)me->query("qi") < 50 )
       return notify_fail("你的体力太差了，不能练天南身法。\n");

    me->receive_damage("qi", 40);
    return 1;
}

string query_description()
{
    string msg;

    msg = HIW "【天南步法】" ZJBR NOR;
    msg += "一种高超的轻功身法，步法迅捷飘逸，避敌攻击如游龙戏水。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本轻功等级需高于天南步法等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  轻功（dodge）。" ZJBR;
    msg += "  移动（move）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血 " HIR "40" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖特殊闪避招式〗" ZJBR NOR;
    msg += "  天南步法包含多种闪避招式，如「旱地拔葱」、「雨燕归巢」、「破土而出」等，" ZJBR;
    msg += "  这些招式能帮助使用者灵活躲避敌人的攻击。闪避招式包括：" ZJBR;
    msg += "    · 旱地拔葱：身体向上笔直纵起丈余" ZJBR;
    msg += "    · 雨燕归巢：向后纵出数丈之远" ZJBR;
    msg += "    · 破土而出：向一旁飘然纵出" ZJBR;
    msg += "    · 无中生有：身形飘忽，轻轻一纵" ZJBR;
    msg += "    · 乘风而去：身随意转，倏地挪开三尺" ZJBR;
    msg += "    · 鲧化大鹏：侧身一让，避开攻击" ZJBR;
    msg += "    · 青云直上：足不点地，往旁窜开数尺" ZJBR;
    msg += "    · 凤翔九天：身形微晃，有惊无险避开攻击" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += "  无。" ZJBR;

    return msg;
}

