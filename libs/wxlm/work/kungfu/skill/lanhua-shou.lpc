int valid_enable(string usage) { return usage == "hand" ||  usage == "parry"; }

int valid_combine(string combo) { return combo == "tanzhi-shentong"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail(HIC"练幽兰拂穴手必须空手。"NOR"\n");

	if ((int)me->query_skill("force") < 60)
		return notify_fail("你的内功火候不够，无法学幽兰拂穴手。\n");

	if ((int)me->query("max_neili") < 450)
		return notify_fail("你的内力太弱，无法练幽兰拂穴手。\n");

	if ((int)me->query_skill("hand", 1) < 50)
		return notify_fail("你的基本手法太差，无法学习幽兰拂穴手。\n");

	if ((int)me->query_skill("hand", 1) < (int)me->query_skill("lanhua-shou", 1))
		return notify_fail("你的基本手法火候不够，无法领会更高深的幽兰拂穴手。\n");

	return 1;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action) - 1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int)me->query_skill("lanhua-shou", 1);
	for (i = sizeof(action); i > 0; i--)
		if(level > action[i - 1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 60)
		return notify_fail("你的体力太低了，无法练幽兰拂穴手。\n");

	if ((int)me->query("neili") < 60)
		return notify_fail("你的体力太低了，无法练幽兰拂穴手。\n");

	me->receive_damage("qi", 50);
	me->add("neili", -53);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"lanhua-shou/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【幽兰拂穴手】" ZJBR NOR;
    msg += WHT "桃花岛独门绝技，手法轻灵飘逸，招式雅致，专点敌人周身大穴。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  必须空手。" ZJBR;
    msg += "  基本内功 (`force`) 等级不低于 " HIY "60" NOR " 级。" ZJBR;
    msg += "  最大内力 (`max_neili`) 不低于 " HIB "450" NOR " 点。" ZJBR;
    msg += "  基本手法 (`hand`) 等级不低于 " HIY "50" NOR " 级。" ZJBR;
    msg += "  基本手法 (`hand`) 等级需大于等于幽兰拂穴手等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  手法 (`hand`)。" ZJBR;
    msg += "  招架 (`parry`)。" ZJBR ZJBR;

    msg += HIY "〖可组合武学〗" ZJBR NOR;
    msg += "  弹指神通 (`tanzhi-shentong`)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  气血 (`qi`) 不低于 " HIR "60" NOR " 点。" ZJBR;
    msg += "  内力 (`neili`) 不低于 " HIB "60" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血 " HIR "50" NOR " 点，内力 " HIB "53" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式 (Perform)〗" ZJBR NOR;
    msg += HIC "  兰花拂穴 (fuxue)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      幽兰拂穴手等级不低于 " HIY "140" NOR " 级。" ZJBR;
    msg += "      基本内功 (`force`) 等级不低于 " HIY "140" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "500" NOR " 点。" ZJBR;
    msg += "      只能对战斗中且未被忙乱的对手使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      对目标施加忙乱 (`busy`) 状态，使其暂时无法行动。" ZJBR;
    msg += "      命中判定：攻击力 `AP = (手法激发等级 / 2) + (轻功激发等级 / 2) + 兰花手等级`，防御力 `DP = 目标招架激发等级 + 目标轻功激发等级`。" ZJBR;
    msg += "                若 `AP / 2 + 随机(AP) > DP` 则命中。" ZJBR;
    msg += "      成功后目标忙乱时间：`(兰花手等级 / 45) + 2` 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      若未命中，自身忙乱 " HIR "2" NOR " 秒。" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 练习和使用幽兰拂穴手必须空手。" ZJBR;
    msg += "2. 「兰花拂穴」只能在战斗中使用，且不能对已经忙乱的敌人使用。" ZJBR;
    msg += "3. 使用「兰花拂穴」需要较高的内功、手法和轻功底子。" ZJBR;

    return msg;
}