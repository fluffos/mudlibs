	"damage_type" : "瘀伤"
]), 
});

int valid_enable(string usage) { return usage == "strike" || usage == "parry"; }

int valid_combine(string combo) { return combo == "meinv-quan"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("你必须空手方能练习天罗地网势。\n");

	if ((int)me->query_skill("force") < 80)
		return notify_fail("你的内功基础不够，无法修习天罗地网势。\n");

	if ((int)me->query_skill("strike", 1) < 30)
		return notify_fail("你的基本掌法水平太低，无法研习天罗地网势。\n");

	if ((int)me->query_skill("strike", 1) < me->query_skill("tianluo-diwang", 1))
		return notify_fail("你的基本掌法水平水平有限，无法研习更高深的天罗地网势。\n");

	return 1;
}

mapping query_action(object me, object weapon)
{
	int i, level;

	level = (int)me->query_skill("tianluo-diwang", 1);

	for (i = sizeof(action); i > 0; i--)
		if (level > action[i - 1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 40)
		return notify_fail("你的内力不够了。\n");

	me->receive_damage("qi", 40);
	me->add("neili", -25);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"tianluo-diwang/" + action;
}

string query_description()
{
    string msg;

    msg = HIG "【天罗地网势】" ZJBR NOR;
    msg += "一门变化多端的掌法，掌势如天罗地网，密不透风，令敌难以脱身。" ZJBR ZJBR; // 基本介绍

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "  空手状态。" ZJBR;
    msg += "  有效内功激发 " HIY "80" NOR " 级以上。" ZJBR;
    msg += "  基本掌法 " HIY "30" NOR " 级以上。" ZJBR;
    msg += "  基本掌法等级不能低于天罗地网势等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "  掌法（strike）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖可互备武功〗" ZJBR NOR; // valid_combine
    msg += "  美女拳法（meinv-quan）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "  气血：不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "40" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "40" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "25" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR; // hit_ob, valid_damage, skill_improved etc.
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform/exert
    msg += HIC "  天罗地网 (wang)" ZJBR NOR; // 招式名称
    msg += "    使用要求：" ZJBR; // 招式使用要求
    msg += "      天罗地网势等级 " HIY "60" NOR " 级以上。" ZJBR;
    msg += "      当前内力 " HIB "60" NOR " 点以上。" ZJBR;
    msg += "      激发掌法为天罗地网势。" ZJBR;
    msg += "      必须空手且在战斗中对敌人使用。" ZJBR;
    msg += "      对方未处于忙乱状态。" ZJBR;
    msg += "    效果描述：" ZJBR; // 招式效果描述
    msg += "      双掌齐出，幻化出无数掌影，将对手团团围住，使其无法反击。" ZJBR;
    msg += "      命中判定：随机(天罗地网势等级) > 目标基本轻功等级的一半。" ZJBR;
    msg += "      效果判定：若命中，使对方忙乱（天罗地网势等级 / 16 + 2）秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR; // 消耗与代价
    msg += "      发动消耗：内力 " HIB "35" NOR " 点。" ZJBR;
    msg += "      未命中：自身忙乱 " HIR "1" NOR " 秒。" ZJBR;

    return msg;
}
