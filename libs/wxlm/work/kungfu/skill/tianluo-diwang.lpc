]),
([      "action" : "$N长袖挥处，两股袖风扑出，$n只觉得密不透风，周身都是掌印，怎么也闪躲不开",
	"force"  : 340,
	"attack" : 50,
	"parry"  : 35,
	"dodge"  : 35, 
	"damage" : 35,
