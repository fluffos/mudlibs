int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 100)
		return notify_fail("你的内力不够。\n");

	if ((int)me->query_skill("force") < 20)
		return notify_fail("你的内功火候太浅。\n");

	if ((int)me->query_skill("sword", 1) < (int)me->query_skill("raozhi-roujian", 1))
		return notify_fail("你的基本剑法水平有限，无法领会更高深的绕指柔剑。\n");

	return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【绕指柔剑】" ZJBR NOR;
    msg += WHT "武当派独门剑法，以轻灵飘逸、变化多端著称。讲究以柔克刚，以静制动，剑招看似轻柔实则暗藏杀机。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  最大内力不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "  基本内功等级不低于 " HIY "20" NOR " 级。" ZJBR;
    msg += "  基本剑法等级需大于等于绕指柔剑等级。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  剑法（sword）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  需持有剑类武器。" ZJBR;
    msg += "  气血：不低于 " HIR "40" NOR " 点。" ZJBR;
    msg += "  内力：不低于 " HIB "40" NOR " 点。" ZJBR;
    msg += "  每次练习消耗气血：" HIR "35" NOR " 点。" ZJBR;
    msg += "  每次练习消耗内力：" HIB "30" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  柔月穿空 (chuan)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      需持有剑类武器。" ZJBR;
    msg += "      绕指柔剑等级 " HIY "90" NOR " 级。" ZJBR;
    msg += "      基本内功等级 " HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力 " HIB "250" NOR " 点。" ZJBR;
    msg += "      需拥有该招式使用许可 (can_perform/raozhi-roujian/chuankong)。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：(自身基本剑法) > (目标基本招架)，采用 `通用命中公式`。" ZJBR;
    msg += "      若命中：造成伤害。伤害值约为 (基本剑法 / 2) + 随机(基本剑法)。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      命中：内力 " HIB "150" NOR " 点，忙乱 " HIR "2" NOR " 秒。" ZJBR;
    msg += "      未命中：内力 " HIB "60" NOR " 点，忙乱 " HIR "3" NOR " 秒。" ZJBR;

    return msg;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action) - 1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("raozhi-roujian", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i-1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];

}

int practice_skill(object me)
{
	object weapon;

	if (! objectp(weapon = me->query_temp("weapon")) ||
	    (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");

	if ((int)me->query("qi") < 40)
		return notify_fail("你的体力不够练绕指柔剑。\n");

	if ((int)me->query("neili") < 40)
		return notify_fail("你的内力不够练绕指柔剑。\n");

	me->receive_damage("qi", 35);
	me->add("neili", -30);

	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"raozhi-roujian/" + action;
}
