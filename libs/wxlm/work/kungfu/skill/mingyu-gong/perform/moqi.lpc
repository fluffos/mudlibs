// moqi.c - 明玉功魔气血杀技能
// 魔气血杀：明玉功的高级招式，以自残换取强大的杀伤力

#include <combat.h>
inherit F_SSERVER;

// 常量定义
#define SKILL_NAME "魔气血杀"                // 技能名称
#define MIN_SKILL_LEVEL 150                 // 最低明玉功等级要求
#define MIN_FORCE_LEVEL 150                 // 最低内功等级要求
#define MIN_NEILI 1000                      // 最低内力要求
#define NEILI_COST_SUCCESS 500              // 成功时内力消耗
#define NEILI_COST_FAIL 200                 // 失败时内力消耗
#define NEILI_COST_PARTIAL 300              // 部分成功时内力消耗
#define BUSY_TIME_MIN 4                     // 最小忙碌时间
#define BUSY_TIME_RANDOM 2                  // 随机忙碌时间
#define TARGET_BUSY_TIME 3                  // 目标忙碌时间
#define SELF_DAMAGE_RATE_FAIL 1             // 失败时自伤比例（1/100）
#define SELF_DAMAGE_RATE_PARTIAL 5          // 部分成功时自伤比例（5/100）
#define SELF_DAMAGE_RATE_SUCCESS 1          // 成功时自伤比例（1/10）

/**
 * @brief 查询技能名称
 * @return string 返回技能名称"魔气血杀"
 */
string query_name() 
{ 
    return SKILL_NAME; 
}

/**
 * @brief 执行魔气血杀技能
 * @param object me 施展技能的玩家对象
 * @param object target 目标对象
 * @return int 成功返回1，失败返回0
 * @details 魔气血杀是明玉功的高级招式，通过自残来换取强大的杀伤力
 */
int perform(object me, object target)
{
    string attack_msg;
    int skill_value, max_level;
    int attack_power, defense_power, damage;
    int success_flag;
    
    skill_value = random(me->query_skill("mingyu-gong", 1));
    max_level = me->query_skill("mingyu-gong", 1);
    success_flag = 0;

    // 检查目标
    if (!target) 
        target = offensive_target(me);
    
    if (!target || !target->is_character() || !me->is_fighting(target))
        return notify_fail("『" + SKILL_NAME + "』只能对战斗中的对手使用。\n");
  
    // 检查明玉功等级
    if (me->query_skill("mingyu-gong", 1) < MIN_SKILL_LEVEL)
        return notify_fail("你的明玉功功力不足。\n");

    // 检查内功等级
    if (me->query_skill("force", 1) < MIN_FORCE_LEVEL)
        return notify_fail("你的内功不够好。\n");
        
    // 检查内力
    if (me->query("neili") < MIN_NEILI)
        return notify_fail("你的内力不够。\n");
        
    // 检查内功激发
    if (me->query_skill_mapped("force") != "mingyu-gong") 
        return notify_fail("你现在没有激发明玉功为内功，难以施展『" + SKILL_NAME + "』。\n"); 
   
    // 技能施展消息
    attack_msg = HIY "$N自残己身，以血气转换成杀气。\n" +
                "……$N身上发出一股强大的杀气……\n" +
                "■$N身上杀气逐渐地聚集在双手，在双手上形成两团魔气■\n" +
                "$N倏地大喝一声－－魔 气 血 杀－－\n\n" NOR;

    attack_power = me->query_skill("force"); 
    defense_power = target->query_skill("force");

    //pve增加50%命中
    if (!playerp(target))
        attack_power = attack_power * 150 / 100;
        
    // 判断攻击是否命中
    if (COMBAT_D->hit_determination(me, target, attack_power, defense_power))  
    {
        // 攻击成功
        attack_msg += HIR BLINK "$N突然喉头一动～～　只见$N口中喷出一道血柱往$n射去～～\n" +
                     "此乃 Buffy杀之最终杀招 『魔 血 气 杀』\n\n" +
                     "$n遭到前所未有的打击，但$N也受伤不轻。\n" NOR;

        //基础值为内功激发等级 + 剑法激发等级 + 拳脚激发等级
        damage = me->query_skill("force") + me->query_skill("sword") + me->query_skill("unarmed");

        damage *= 4;

        //每层星屑化域根本法增加5%的最终伤害
        damage += damage * COMBAT_D->get_skill_aoyi_level(me, "星屑化域") / 20;
                
        if (!target->is_busy())
            target->start_busy(TARGET_BUSY_TIME + random(BUSY_TIME_RANDOM));
        
        // 造成精神伤害数值为25%
        target->receive_wound("jing", damage / 4, me);
        // 造成气血伤害，单招类型，数值为150-200%。
        attack_msg += COMBAT_D->do_damage(me, target, REMOTE_ATTACK, damage, 150 + random(51), attack_msg); 
        //自伤
        me->receive_wound("qi", me->query("qi") * SELF_DAMAGE_RATE_SUCCESS / 10);
        me->add("neili", -NEILI_COST_SUCCESS); 
                 
        success_flag = 1;
    }
    else if (random(4) > 2)
    {
        // 攻击完全失败
        attack_msg += HIR BLINK "$N真气所转换的杀气不够大，对敌人毫无影响。\n" NOR;
        me->receive_wound("qi", me->query("qi") * SELF_DAMAGE_RATE_FAIL / 100);
        me->add("neili", -NEILI_COST_FAIL);  
    }
    else
    {
        // 攻击部分成功
        attack_msg += HIR BLINK "$n受到强大的杀气伤害，动弹不得。\n" NOR;
        me->receive_wound("qi", me->query("qi") * SELF_DAMAGE_RATE_PARTIAL / 100);
        COMBAT_D->real_damage(me, target, (int)me->query_skill("mingyu-gong", 1));
        
        if (!target->is_busy())
            target->start_busy(TARGET_BUSY_TIME);
        
        me->add("neili", -NEILI_COST_PARTIAL);
    }
                
    message_combatd(attack_msg, me, target);
    
    if (success_flag)
        COMBAT_D->report_status(target);
    
    me->start_busy(BUSY_TIME_MIN + random(BUSY_TIME_RANDOM));
    return 1;
}

