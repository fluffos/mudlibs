#define CN_NAME "飘云掌"
inherit SKILL;

mapping *action = ({
([      "action": "$N单手上抬，一招飘云掌的［飘云飞叶］，对准$n的$l猛击下去",
	"force" : 300,
	"attack": 85,
	"dodge" : 10,
	"parry" : 5,
	"damage": 100,
	"lvl"   : 0,
	"skill_name" : "飘云掌",
	"damage_type":  "瘀伤"
]),
([      "action": "$N一招飘云掌的［飘雨云手］，身子已向左转成弓箭步，两臂向后成钩手，呼\n"
		  "的一声轻响，反击$n$l",
	"force" : 350,
	"attack": 25,
	"dodge" : 15,
	"parry" : 10,
	"damage": 610,
	"lvl"   : 30,
	"skill_name" : "飘云掌",
	"damage_type":  "瘀伤"
]),
});

string query_txt()
{
	return "要求：基本掌法 150级";
}

int valid_learn(object me)
{
	if ((int)me->query_skill("strike", 1) < 150)
		return notify_fail("你的掌法根基有限，无法学习飘云掌。\n");
	return 1;
}

int valid_enable(string usage)
{
	return usage == "strike" ;
}

string query_skill_name(int level)
{
	int i;
	for (i = sizeof(action)-1; i >= 0; i--)
		if (level >= action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int)me->query_skill("piaoyunzhang", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i - 1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 60)
		return notify_fail("你现在手足酸软，休息一下再练吧。\n");

	if ((int)me->query("neili") < 80)
		return notify_fail("你的内力不够了。\n");

	me->receive_damage("qi", 50);
	me->add("neili", -60);

	return 1;
}

string query_description()
{
    string msg;

    msg = HIY "【飘云掌】" ZJBR NOR;
    msg += WHT "名字带有飘云二字，招式灵动。" ZJBR ZJBR; // Basic description

    msg += HIY "〖学习要求〗" ZJBR NOR; // valid_learn
    msg += "    基本掌法等级 ≥ " HIC "150" NOR " 级。" ZJBR ZJBR; // strike, 1

    msg += HIY "〖激发类型〗" ZJBR NOR; // valid_enable
    msg += "    掌法 (strike)" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR; // practice_skill
    msg += "    气血 ≥ " HIR "60" NOR " 点。" ZJBR;
    msg += "    内力 ≥ " HIB "80" NOR " 点。" ZJBR;
    msg += "    每次练习消耗：气血 " HIR "50" NOR " 点，内力 " HIB "60" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "    无。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR; // perform/exert
    msg += "    无。" ZJBR; // No performs found, ignoring the incorrect perform_action_file function below

    return msg;
}

