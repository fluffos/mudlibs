});

int valid_enable(string usage) { return usage == "finger" || usage == "parry"; }

int valid_combine(string combo)
{
	return combo == "haotian-zhang" ||
	       combo == "chongyang-shenzhang";
}

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练终南指法必须空手。\n");

	if ((int)me->query("neili") < 250)
		return notify_fail("你的内力不够，无法学终南指法。\n");

	if ((int)me->query_skill("force") < 40)
		return notify_fail("你的内功火候不够，无法学终南指法。\n");

	return 1;
}

mapping query_action(object me, object weapon)
{
	int i, level;
	level = (int) me->query_skill("zhongnan-zhi", 1);
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i - 1]["lvl"])
			return action[NewRandom(i, 5, level / 5)];

}

int practice_skill(object me)
{
	if ((int)me->query("qi") < 50)
		return notify_fail("你的体力太低了。\n");

	if ((int)me->query("neili") < 20)
		return notify_fail("你的内力不够练习终南指法。\n");

	me->receive_damage("qi", 35);
	me->add("neili", -11);
	return 1;
}

string perform_action_file(string action)
{
	return __DIR__"zhongnan-zhi/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【终南指法】" ZJBR NOR;
    msg += WHT "终南指法乃是全真派的独门指法，讲究以指代剑，灵活多变。" ZJBR;
    msg += WHT "共有七式攻击招式：剑指南山、天荒地老、海枯石烂、大江东去、乌雀南飞、冰冻千里、寿比南山。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功 等级：" HIY "40" NOR " 级。" ZJBR;
    msg += "  当前内力 不低于 " HIB "250" NOR " 点。" ZJBR;
    msg += "  练习需空手，不可持武器。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  指法 (finger)。" ZJBR;
    msg += "  招架 (parry)。" ZJBR ZJBR;

    msg += HIY "〖互备要求〗" ZJBR NOR;
    msg += "  可与 昊天掌 (haotian-zhang) 或 重阳神掌 (chongyang-shenzhang) 互备。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  当前气血 不低于 " HIR "50" NOR " 点。" ZJBR;
    msg += "  当前内力 不低于 " HIB "20" NOR " 点。" ZJBR;
    msg += "  每次练习消耗 气血 " HIR "35" NOR " 点，消耗 内力 " HIB "11" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;
    msg += HIC "  终南一指 (zhongnan)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      有效终南指法 等级不低于 " HIY "35" NOR " 级。" ZJBR;
    msg += "      基本内功 等级不低于 " HIY "50" NOR " 级。" ZJBR;
    msg += "      当前内力 不低于 " HIB "60" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      命中判定：若 随机(有效指法等级) > (目标有效招架等级 / 2)，则命中。" ZJBR;
    msg += "      命中后伤害：造成 (40 + 有效指法等级 / 4 + 随机(有效指法等级 / 5)) 点伤害。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "60" NOR " 点。" ZJBR;

    return msg;
}