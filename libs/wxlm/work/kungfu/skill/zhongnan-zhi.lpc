([      "action" : "$N一招「剑指南山」，右手拇指直刺$n的$l",
	"force" : 30,
	"dodge" : 10,
	"damage": 5,
	"skill_name" : "剑指南山",
	"lvl" : 0,
	"damage_type" : "刺伤"
]),
([      "action" : "$N使一招「天荒地老」，左手轻轻一挥，右手刺向$n的檀中大穴",
	"force" : 60,
	"dodge" : 18,
	"damage": 10,
	"skill_name" : "天荒地老",
	"lvl" : 20,
	"damage_type" : "刺伤"
]),
([      "action" : "$N双掌翻飞，一招「海枯石烂」，暗藏玄机，中指戳向$n的$l",
	"force" : 110,
	"dodge" : 16,
	"damage": 12,
	"skill_name" : "海枯石烂",
	"lvl" : 40,
	"damage_type" : "刺伤"
]),
([      "action" : "$N一声大喝，一式「大江东去」，双指齐出，攻向$n的胸口和$l",
	"force" : 150,
	"dodge" : 14,
	"damage": 15,
	"skill_name" : "大江东去",
	"lvl" : 60,
	"damage_type" : "刺伤"
