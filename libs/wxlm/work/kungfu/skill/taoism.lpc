// taoism.c 道学心法
// modified by Venus Oct.1997

inherit SKILL;

void create() { seteuid(getuid()); }

string type() { return "knowledge"; }

int valid_learn(object me)
{
    int lvl;

    lvl = (int)me->query_skill("taoism", 1);

    if(me->query("gender") == "无性" && lvl > 19)
	return notify_fail("你刚听一会儿，便觉心智迷糊，原来你没有阳刚之\n"
			   "气，无法领会里面的阴阳变化之道。\n");

    return 1;
}

int practice_skill(object me)
{
    return notify_fail("天师正道只能靠学习来提高。\n");
}

string query_description()
{
    string msg;

    msg = HIY "【道学心法】" ZJBR NOR;
    msg += "道学心法是一种知识类技能，主要用于提升修道者的道学修为。作为道家心法，此技能可能会影响其他相关道家武功的效果。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  无性人物在技能等级达到 " HIY "19" NOR " 级以后将无法继续学习，" ZJBR;
    msg += "  因缺乏阳刚之气，无法领会其中的阴阳变化之道。" ZJBR ZJBR;

    msg += HIY "〖技能类型〗" ZJBR NOR;
    msg += "  知识类（knowledge）技能。" ZJBR ZJBR;

    msg += HIY "〖练习方式〗" ZJBR NOR;
    msg += "  该技能不能通过练习提高，只能通过学习来提升。" ZJBR;

    return msg;
}
