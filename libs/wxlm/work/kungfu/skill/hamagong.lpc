// hamagong.c 蛤蟆功


inherit FORCE;

mapping *action = ({
([      "action" : "$N忽而倒竖，一手撑地，身子横挺，只以一掌向$n的$l拍出",
	"dodge"  : 0,
	"force"  : 310,
	"attack" : 103,
	"parry"  : 21,
	"damage" : 66,
	"lvl"    : 0,
	"damage_type": "震伤" 
]), 
([      "action" : "$N丝毫不动声色，双腿微曲，右掌平伸，左掌运起蛤蟆功的"
		   "劲力，呼的一声推向$n",
	"dodge"  : 0,
	"force"  : 332,
	"attack" : 112,
	"parry"  : 37,
	"damage" : 77,
	"lvl"    : 250,
	"damage_type": "震伤"
]), 
([      "action" : "$N闭眼逼住呼吸，过了片刻，猛跃而起，眼睛也不及睁开，双"
		   "掌便向$n的方向推了出去",
	"dodge"  : 0,
	"force"  : 360,
	"attack" : 122,
	"parry"  : 53,
	"damage" : 85,
	"lvl"    : 260,
	"damage_type": "震伤"
]),
([      "action" : "$N脚步摇摇幌幌，忽然双腿一弯、一登，口中阁的一声叫喝，"
		   "手掌向$n猛然推出",
	"dodge"  : 5,
	"force"  : 410,
	"attack" : 143,
	"parry"  : 67,
	"damage" : 91,
	"lvl"    : 270,
	"damage_type": "震伤"
]), 
});

int valid_enable(string usage, object me)
{ 
	return usage == "force" || usage == "unarmed" || usage == "parry";
}

int query_neili_improve(object me)
{
	int lvl;

	lvl = (int)me->query_skill("hamagong", 1);
	return lvl * lvl * 15 * 12 / 100 / 200;
}

int valid_learn(object me)
{
	if ( me->query("gender") == "无性" && me->query("hamagong", 1) > 49)
		return notify_fail("你无根无性，阴阳不调，难以领会高深的蛤蟆功。\n");

	if ((int)me->query_skill("force", 1) < 30)
		return notify_fail("你的基本内功火候不足，不能学蛤蟆功。\n");

	return ::valid_learn(me);
}

string query_skill_name(int level)
{
	int i = sizeof(action);

	while (i--)
		if(level > action[i]["lvl"])
			return action[i]["skill_name"];
}

mapping query_action(object me)
{
	int i, level;
	
	level = (int) me->query_skill("hamagong", 1);
	if (random(me->query_str()) > 35
	  && random(level) > 120
	  && me->query("max_neili") > 3000
	  && me->query("neili") > 1300)
	{
		me->add("neili", -100);
		return ([
		"action": HIC "$N蹲低身子，两眼微闭，口中咕咕咕的叫了三声，双"
			  "掌向$n" HIC "缓缓推出！激得灰泥弥漫，尘土飞扬" NOR,
		"force"  : 738,
		"attack" : 152,
		"parry"  : 112,
		"dodge"  : 33,
		"damage" : 147,
		"damage_type": "瘀伤"]);
	}
	
	for (i = sizeof(action); i > 0; i--)
		if (level > action[i - 1]["lvl"])
			return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
	return notify_fail("蛤蟆功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"hamagong/" + func;
}

string query_description()
{
    string msg;

    msg = HIY "【蛤蟆功】" ZJBR NOR;
    msg += WHT "西域白驼山嫡传神功，模仿蛤蟆之态，练就浑厚内劲，刚猛无比，亦含毒性。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    msg += "  基本内功 (force) 等级不低于 " HIY "30" NOR " 级。" ZJBR;
    msg += "  非无性之人 (太监等级超过 " HIY "49" NOR " 级后无法学习)。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功（force）。" ZJBR;
    msg += "  拳脚（unarmed）。" ZJBR;
    msg += "  招架（parry）。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  无法通过练习 (practice) 提升，只能通过学习 (learn) 提升。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  提升内力上限：提升值约为 (蛤蟆功等级 ^ 2 * 15 * 12 / 100 / 200)。" ZJBR;
    msg += "  特殊拳脚攻击：当 后天膂力较高 (随机(后天膂力) > 35)，蛤蟆功等级超过 " HIY "120" NOR " 级，最大内力超过 " HIB "3000" NOR " 点，当前内力超过 " HIB "1300" NOR " 点时，普通攻击有几率触发强力攻击，额外消耗内力 " HIB "100" NOR " 点。" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;

    msg += HIC "  逆运经脉 (reserve)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      蛤蟆功等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      临时提升闪避、招架、护甲和化解毒素的能力。" ZJBR;
    msg += "      提升幅度：闪避/招架增加 (蛤蟆功等级 / 4)，护甲/化解毒素增加 (蛤蟆功等级 / 2)。" ZJBR;
    msg += "      效果持续存在，直到使用「蛤蟆功回息」解除。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      忙乱 " HIR "1" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  蛤蟆功回息 (hui)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      必须处于「逆运经脉」状态下。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      解除「逆运经脉」状态，恢复正常状态。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      当前内力清零。" ZJBR ZJBR;

    msg += HIC "  吞天战气 (powerup)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      当前内力不低于 " HIB "100" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      临时提升攻击力和防御力。" ZJBR;
    msg += "      提升幅度：攻击/防御增加 (蛤蟆功等级 / 3)。" ZJBR;
    msg += "      效果持续时间：" HIY "(蛤蟆功等级 / 3)" NOR " 秒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "100" NOR " 点。" ZJBR ZJBR;

    msg += HIC "  推天一掌 (tui)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      蛤蟆功等级不低于 " HIY "240" NOR " 级。" ZJBR;
    msg += "      最大内力不低于 " HIB "4000" NOR " 点。" ZJBR;
    msg += "      当前内力不低于 " HIB "1000" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      攻击力(AP) = (自身激发内功等级 * 15 + 最大内力)，防御力(DP) = (目标激发内功等级 * 15 + 目标最大内力 + 目标一阳指等级 * 20)。" ZJBR;
    msg += "      命中判定：若 (AP > DP + 随机(DP) / 2) 则命中。" ZJBR;
    msg += "      命中后对目标造成伤害，伤害值约为 ((AP - DP) / 10 + 随机(激发内功等级 * 1.5 + 最大内力 / 10))。" ZJBR;
    msg += "      若目标精通一阳指 (yiyang-zhi)，则此招威力可能被大幅削弱或化解。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "500-1000" NOR " 点 (随机)。" ZJBR;
    msg += "      忙乱 " HIR "3" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  天蟾山海势 (shan)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      蛤蟆功等级不低于 " HIY "240" NOR " 级。" ZJBR;
    msg += "      当前激发内功为蛤蟆功。" ZJBR;
    msg += "      最大内力不低于 " HIB "4000" NOR " 点。" ZJBR;
    msg += "      当前内力不低于 " HIB "1000" NOR " 点。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      蓄力 " HIR "2" NOR " 秒后，对目标发动一次强力攻击。" ZJBR;
    msg += "      攻击伤害及命中判定遵循常规战斗规则 (`COMBAT_D->do_attack`)。" ZJBR;
    msg += "      若目标正在施展六脉神剑的「六脉齐发」，则此招会被破解。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "800" NOR " 点。" ZJBR;
    msg += "      共忙乱 " HIR "4" NOR " 秒 (蓄力2秒 + 攻击后2秒)。" ZJBR ZJBR;

    msg += HIC "  弹射毒药 (tan)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      蛤蟆功等级不低于 " HIY "100" NOR " 级。" ZJBR;
    msg += "      基本毒技 (poison) 等级不低于 " HIY "80" NOR " 级。" ZJBR;
    msg += "      当前内力不低于 " HIB "500" NOR " 点。" ZJBR;
    msg += "      物品栏中需有毒药类物品。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      消耗一份毒药，将其弹射向目标。" ZJBR;
    msg += "      攻击力(AP) = (基本毒技等级 / 2 + 激发内功等级)。" ZJBR;
    msg += "      命中判定：若 (AP > 随机(目标激发轻功等级 * 2)) 则命中。" ZJBR;
    msg += "      命中后使目标中指定毒药之毒。" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      内力 " HIB "300" NOR " 点。" ZJBR;
    msg += "      消耗使用的毒药一份。" ZJBR;
    msg += "      忙乱 " HIR "2" NOR " 秒。" ZJBR;

    return msg;
}