// xuehai-mogong

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_force(string force)
{
	return force == "mizong-neigong";
}

int query_neili_improve(object me)
{
	int lvl;

	lvl = (int)me->query_skill("xuehai-mogong", 1);
	return lvl * lvl * 15 * 13 / 100 / 200;
}

int valid_learn(object me)
{
	return ::valid_learn(me);
}

int practice_skill(object me)
{
	return notify_fail("血海魔功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
	return __DIR__"xuehai-mogong/" + func;
}
string query_description()
{
    string msg;

    msg = HIR "【血海魔功】" ZJBR NOR;
    msg += WHT "血海魔功乃源自西域血刀老祖的邪派内功，以阴狠毒辣、吸人精血著称，" ZJBR;
    msg += WHT "修炼此功可大幅提升内力修为，亦能增强攻击之威力。" ZJBR ZJBR;

    msg += HIY "〖学习要求〗" ZJBR NOR;
    // 以下要求可能继承自 FORCE 类，需实际验证
    msg += "  基本内功 等级：" HIY "100" NOR " 级。" ZJBR;
    msg += "  最大内力 不低于 " HIB "200" NOR " 点。" ZJBR;
    msg += "  兼容内功：需要 " HIG "密宗内功" NOR " 支持。" ZJBR ZJBR;

    msg += HIY "〖激发类型〗" ZJBR NOR;
    msg += "  内功 (force)。" ZJBR ZJBR;

    msg += HIY "〖练习要求〗" ZJBR NOR;
    msg += "  血海魔功只能通过学习 (learn) 提升，无法练习 (practice)。" ZJBR ZJBR;

    msg += HIY "〖攻防特效/被动效果〗" ZJBR NOR;
    msg += "  提升内力上限：提升值为 (基础血海魔功等级 * 基础血海魔功等级 * 195 / 20000) 点。" ZJBR;
    msg += "                (即 基础血海魔功等级 ^ 2 * 0.00975)" ZJBR ZJBR;

    msg += HIY "〖特殊招式〗" ZJBR NOR;

    msg += HIC "  血海战气 (powerup)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      有效内功 等级：" HIY "100" NOR " 级。" ZJBR;
    msg += "      当前内力 不低于 " HIB "150" NOR " 点。" ZJBR;
    msg += "      未处于 powerup 状态。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      临时提升自身的 攻击等级 和 防御等级。" ZJBR;
    msg += "      提升数值 = 有效内功等级 / 3" ZJBR;
    msg += "      持续时间 = (有效内功等级 / 3) 秒" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "100" NOR " 点。" ZJBR;
    msg += "      自身忙乱 " HIR "(有效内功等级 / 3)" NOR " 秒。" ZJBR ZJBR;

    msg += HIC "  祭血大法 (jixue)" ZJBR NOR;
    msg += "    使用要求：" ZJBR;
    msg += "      基础血海魔功 等级：" HIY "150" NOR " 级。" ZJBR;
    msg += "      当前内力 不低于 " HIB "300" NOR " 点。" ZJBR;
    msg += "      必须在战斗中使用。" ZJBR;
    msg += "    效果描述：" ZJBR;
    msg += "      临时提升自身的 伤害力。" ZJBR;
    msg += "      提升数值 = 基础血海魔功等级" ZJBR;
    msg += "      持续时间 = (5 + 基础血海魔功等级 / 50) 秒" ZJBR;
    msg += "    消耗与代价：" ZJBR;
    msg += "      消耗内力 " HIB "250" NOR " 点。" ZJBR;
    msg += "      消耗气血 " HIR "(最大气血 * 50%)" NOR " 点。" ZJBR;
    msg += "      (注：气血消耗可能受其他奥义影响，代码未体现)" ZJBR;
    msg += "    冷却时间：" HIR "(5 + 基础血海魔功等级 / 50)" NOR " 秒。" ZJBR;

    return msg;
}