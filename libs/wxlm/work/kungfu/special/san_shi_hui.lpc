// san_shi_hui.c 散石灰
// Created by [一壶茶叶] [2024.8.16]

inherit F_CLEAN_UP;

string name() { return "散石灰"; }

int perform(object me, string skill)
{
    int  busy_time, exp_diff, success_rate;
    int *successRateList = ({5, 10, 15, 20, 25, 30, 35, 40, 45, 50});
    int level = TALNET_MASTER->query_talnet_level(me, "san_shi_hui");
    object target;
    if (time() - me->query_temp("special_skill_time/san_shi_hui") < 30)
        return notify_fail("你刚刚施展过散石灰，还需要等一会儿。\n");
    
    // 只有战斗中可用
    if (!me->is_fighting())
        return notify_fail("散石灰只能在战斗中使用。\n");
    
    me->clean_up_enemy();
    //随机选择一个敌人
    target = me->select_opponent();

    exp_diff = me->query("combat_exp") - target->query("combat_exp");
    success_rate = (exp_diff < 0) ? (-exp_diff * successRateList[level - 1] / target->query("combat_exp"))  : 0;
    success_rate = (success_rate > 40) ? 40 : success_rate;

    if (random(100) < success_rate)
    {
        busy_time = random(5) + 1;
        target->start_busy(busy_time);

        if (random(100) < 5)
        {
            target->start_busy(10);
            target->receive_damage("qi", 5000, me);
            message_vision(HIR "$N" HIR "被散石灰击中，陷入了长时间的忙乱！\n" NOR, target);
        }
        else
        {
            message_vision(HIW "$N" HIW "被散石灰击中，陷入了短暂的忙乱！\n" NOR, target);
        }
    }
    else
    {
        message_vision(HIW "$N" HIW "使用散石灰，但没有击中目标。\n" NOR, me);
    }

    me->set_temp("special_skill_time/san_shi_hui", time());
    return 1;
}

string explain()
{
    return "散石灰可以使对方陷入忙乱状态，命中率取决于双方经验差距，最高命中率为40%。命中后有5%概率造成暴击效果，造成10秒忙乱和5000点真伤。冷却时间为30秒。";
}