// ciwei_shen.c 刺猬身
// Created by 一壶茶叶

inherit F_CLEAN_UP;

string name() { return "刺猬身"; }

int perform(object me, string skill)
{
    return notify_fail("这项技能是被动技能，不需要主动运用。\n");
}

string explain()
{
    return "刺猬身是一项被动技能，被攻击击中时，有天赋系数%的概率对对手造成伤害，伤害值为（我方后天臂力+后天根骨+后天悟性-对方后天臂力+后天根骨+后天悟性）*天赋系数/2，该伤害必定命中。每次生效后CD3秒。";
}