// gang_jin_tie_gu.c 刚劲铁骨
// Created by [一壶茶叶] [2024.8.16]

inherit F_CLEAN_UP;

string name() { return "刚劲铁骨"; }

int perform(object me, string skill)
{
    int level = TALNET_MASTER->query_talnet_level(me, "gang_jin_tie_gu");
    int duration = level; // 持续时间为天赋等级
    int reduce_damage = level * 5; // 伤害减免百分比
    int reduce_parry_dodge = level * 5; // 招架闪避降低百分比

    if (me->query("neili") < me->query("max_neili") * 0.2)
        return notify_fail("你的内力不足，无法使用刚劲铁骨。\n");

    me->add("neili", -me->query("max_neili") * 0.2);

    me->set_temp("special_skill_time/gang_jin_tie_gu", time());
    me->set_temp("reduce_damage", reduce_damage);
    me->set_temp("reduce_parry_dodge", reduce_parry_dodge);

    call_out("remove_effect", duration, me);

    message_vision(HIW "$N" HIW "运起刚劲铁骨，浑身散发出一股强大的气势！\n" NOR, me);

    return 1;
}

void remove_effect(object me)
{
    me->delete_temp("reduce_damage");
    me->delete_temp("reduce_parry_dodge");
    tell_object(me, "你的刚劲铁骨效果消失了。\n");
}

string explain()
{
    return "刚劲铁骨可以在一定时间内降低受到的所有伤害，降低招架和闪避的激发效果。消耗20%内力，内力低于20%不可使用。冷却时间为200秒。";
}