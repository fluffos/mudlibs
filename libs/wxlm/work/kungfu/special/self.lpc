
inherit F_CLEAN_UP;

string name() { return "小周天运转"; }

// 主动使用，非战斗中，消耗80精神，回复天赋等级系数%的气血、内力上限。自busy1到5秒。
int perform(object me, string skill)
{
	int heal;
	int qi_heal,neili_heal;
	int *heal_list= ({5,10,15,20,25,30,35,40,45,50});

	if (me->query("jing") < 80)
		return notify_fail("你的精气不够，现在还不能施展小周天运转。\n");

	if (me->is_fighting())
		return notify_fail("你正在打架，无法使用小周天运转。\n");

	if (me->query("qi") >= me->query("eff_qi"))
		return notify_fail("你的体力很好，没有必要使用小周天运转。\n");

	message_vision(HIC "$N" HIC "双手平举，深深吐出了一"
		       "口气，脸色变得圆润多了。"NOR"\n", me);
	tell_object(me, HIG "你感觉到你的气力恢复了。"NOR"\n");

	me->receive_damage("jing", 80);

	heal = heal_list[TALNET_MASTER->query_talnet_level(me,"self") - 1];

	qi_heal = heal * me->query("max_qi") / 100;
	neili_heal = heal * me->query("max_neili") / 100;
	//同时对应的恢复内力，当然不能超过上限制，当然也有一种情况是玩家的内力已经满了并且超过了最大内力，这时候就不需要恢复了
	//如果触发了恢复，那么就恢复内力，如果恢复后的内力超过了最大内力，那么就设置为最大内力
	if (me->query("neili") < me->query("max_neili"))
	{
		me->add("neili", neili_heal);
		if (me->query("neili") > me->query("max_neili"))
			me->set("neili", me->query("max_neili"));
	}

	me->receive_heal("qi", qi_heal);
	me->start_busy(1 + random(5));
	return 1;
}

string explain()
{
	return "小周天运转是一种内功心法，可以恢复自身的气血。";
}