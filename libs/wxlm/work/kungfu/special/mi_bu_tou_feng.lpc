// mi_bu_tou_feng.c 密不透风
// Created by [一壶茶叶] [2024.8.16]

inherit F_CLEAN_UP;

string name() { return "密不透风"; }

int perform(object me, string skill)
{
    int level = TALNET_MASTER->query_talnet_level(me, "mi_bu_tou_feng");
    int duration = ({60, 70, 80, 90, 100, 120, 140, 160, 180, 200})[level - 1]; // 持续时间
    int parry_bonus;
    string character = me->query("character");

    if (me->query("qi") < me->query("max_qi") / 10)
        return notify_fail("你的气血不足，无法使用密不透风。\n");

    //冷却时间
    if (time() - me->query_temp("special_skill_time/mi_bu_tou_feng") < 200)
        return notify_fail("你刚刚使用过密不透风，现在还不能再次使用。\n");

    me->add("qi", -me->query("max_qi") / 10);

    switch (character)
    {
        case "光明磊落":
            parry_bonus = 25 * level;
            break;
        case "心狠手辣":
            parry_bonus = 30 * level;
            break;
        case "狡黠多变":
            parry_bonus = 15 * level;
            break;
        case "阴险奸诈":
            parry_bonus = 20 * level;
            break;
        default:
            parry_bonus = 0;
            break;
    }

    me->set_temp("special_skill_time/mi_bu_tou_feng", time());
    me->add_temp("apply/parry", parry_bonus);

    call_out("remove_effect", duration, me, parry_bonus);

    message_vision(HIW "$N" HIW "运起密不透风，整个人如同铜墙铁壁一般！\n" NOR, me);

    return 1;
}

void remove_effect(object me, int parry_bonus)
{
    me->add_temp("apply/parry", -parry_bonus);
    tell_object(me, "你的密不透风效果消失了。\n");
}

string explain()
{
    return "密不透风可以在一定时间内根据性格增加招架激发。消耗10%的气血，冷却时间为200秒。";
}