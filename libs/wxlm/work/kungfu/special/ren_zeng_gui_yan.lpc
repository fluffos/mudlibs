// Created by 一壶茶叶

inherit F_CLEAN_UP;

string name() { return "人憎鬼厌"; }

int perform(object me, string skill)
{
    return notify_fail("这项技能能够提升你的战斗能力，不需要主动运用。\n");
}

string explain()
{
    return "人憎鬼厌是一项被动技能，容貌可低于0，战斗时对所有人每5秒造成天赋等级系数+（低于零的容貌数）*50的固定伤害，不可被闪避招架，被魅惑概率提升一倍（最高40%）。";
}
