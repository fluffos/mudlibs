// ouyangke.c - 欧阳轲，白驼山少庄主，玉面蛇心，好色之徒


#include "ouyang.h"

inherit F_MASTER;
inherit NPC;

void greeting(object ob);
int  accept_object(object who, object ob);
void do_back();
mixed ask_shenshe();

void create()
{
	seteuid(getuid());
	set_name("欧阳轲", ({ "ouyang ke", "ouyang", "ke" }));
	set("long", "他身着一袭雪白长衫，手持一柄玉骨折扇，风流倜傥，潇洒俊雅。\n"
		    "举手投足间尽显世家公子的优雅气度，只是那双眼睛深处隐藏着一丝阴毒。\n");
	set("title", "白驼山少庄主");
	set("nickname", HIM "玉面蛇心" NOR);
	set("gender", "男性");
	set("age", 27);
	set("attitude", "friendly");
	set("shen_type", -1);

	set("str", 25);
	set("int", 29);
	set("con", 25);
	set("dex", 26);

	set("qi", 1700);
	set("max_qi", 1700);
	set("jing", 800);
	set("max_jing", 800);
	set("neili", 3000);
	set("max_neili", 3000);
	set("jiali", 50);

	set("combat_exp", 500000);

	set_skill("cuff",  150);
	set_skill("dodge", 150);
	set_skill("parry", 150);
	set_skill("force", 150);
	set_skill("staff", 150);
	set_skill("training", 80);
	set_skill("hamagong",150);
	set_skill("chanchu-bufa", 150);
	set_skill("lingshe-quan", 150);
	set_skill("baibian-daxue", 150);
	set_skill("poison", 120);
	set_skill("finger", 100);
	set_skill("shedu-qiqiao", 150);
	set_skill("guzheng-jifa", 125);
	set_skill("wushe-qu", 125);
	set_skill("medical", 150);
	set_skill("baituo-michuan", 150);
	set_skill("literate", 100);

	map_skill("force", "hamagong");
	map_skill("dodge", "chanchu-bufa");
	map_skill("cuff",  "lingshe-quan");
	map_skill("parry", "baibian-daxue");
	map_skill("staff", "baibian-daxue");
	map_skill("shedu-qiqiao", "shedu-qiqiao");
	map_skill("finger", "shedu-qiqiao");

	prepare_skill("finger", "shedu-qiqiao");
	prepare_skill("cuff", "lingshe-quan");

	create_family("欧阳世家", 6, "传人");

	set("chat_chance", 2);
	set("chat_msg", ({
		"欧阳轲轻摇折扇，吟道：「红颜佳人芳心寄，只恨相逢太匆匆。」\n",
		"欧阳轲眼含秋波，含情脉脉地看着过往的女子。\n",
		"欧阳轲展开玉骨扇，深情地吟诵：「天涯何处觅知音，佳人难得几回寻。」\n",
	}) );

	set("inquiry", ([
		"引路神蛇" : (: ask_shenshe :),
	]));

	set_temp("shenshe_count", 5);

	setup();
	carry_object("/d/baituo/obj/baipao")->wear();
	add_money("silver",10);
}

void init()
{
	object ob;

	::init();

	if( interactive(ob = this_player()) && !is_fighting() ) 
	{
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
}

void greeting(object ob)
{
	if (!ob || environment(ob) != environment()) return;

	if (check_family(ob, "欧阳世家"))
	{
		command("nod " + ob->query("id"));
		return;
	}

	if ((string)ob->query("gender")=="女性")
	{
		if (ob->query("per") < 22)
			return;

		if (ob->query("sex/欧阳轲"))
		{
			command("kiss " + ob->query("id"));
			command("say 佳人再临，良宵难得啊... 嘿嘿。");
		} else
		switch(random(3))
		{
		case 0: command("rose "+(string)ob->query("id"));break;
		case 1: command("kiss "+(string)ob->query("id"));break;
		case 2: command("love "+(string)ob->query("id"));break;
		}
     
	}
	else
	   say("欧阳轲轻叹一声道：这位"+RANK_D->query_respect(ob)+
	       "，若能为我引荐一位佳人，必有重谢。\n");
	return;
}

void attempt_apprentice(object ob)
{
	if ((string)ob->query("gender") == "女性" &&
	    (string)ob->query("born_family") != "欧阳世家")
	{
		message_vision("欧阳轲含情脉脉地说道：这位" + RANK_D->query_respect(ob) +
		"乃是我命中红颜，\n只可惜家规所限，不能收你为徒，不如随我双宿双飞如何？（要求男性）\n",ob);
		return;
	}

	if (! permit_recruit(ob))
		return;

	message_vision("$N含笑点头道：好... 甚好！\n", this_object());
	command("recruit " + ob->query("id"));
	if (! ob->query("special/shenshe"))
	{
		command("say 引路神蛇乃我白驼山不传之秘，今日我就传你口诀，切记勿忘！");
		command("whisper " + ob->query("id") + " 口诀是：@#$%^&*，你"
			"携带引路神蛇至西域沙漠，神蛇自会为你指引归途！");
		ob->set("special/shenshe", 1);
	}
}

int accept_fight(object ob)
{
	if ((string)ob->query("gender") == "女性")
	{
		message_vision("欧阳轲摇头轻笑道：这位" +
			       RANK_D->query_respect(ob)+
			       "，在下岂能对佳人动粗？\n", ob);
		return 0;
	}

	return ::accept_fight(ob);
}
 
int accept_object(object who, object ob)
{
	object obn;
	int addition;

	if (! who || environment(who) != environment()) return 0;
	if (! objectp(ob)) return 0;
	
	if (! present(ob, who))
		return notify_fail("你没有这件东西。\n");

	if (! ob->is_character() || (string)ob->query("gender") != "女性")
	{
	      	command("say 在下对这等物件不感兴趣。");
		return 0;
	}

	if (ob->is_corpse())
	{
		command("slap " + who->query("id"));
		command("say 岂有此理！竟敢拿具尸体来戏弄于我？");
		return 0;
	}

	if ((string)ob->query("born_family") == "欧阳世家")
	{
		command("kick " + who->query("id"));
		command("slap " + who->query("id"));
		command("say 大胆狂徒！竟敢调戏我欧阳家的女眷？");
		return 1;
	}

	if (environment(this_object())->query("short") == "观乐楼")
	{
	       	command("say 良宵已有佳人相伴，他日再说吧。");
		return 0;
	}

	if ((int)ob->query("age") <18)
	{
		command("fear");
		command("say 这等未经人事的黄花闺女，我岂能玷污？");
		return 0;
	}

	if ((int)ob->query("age") > 29)
	{
		command("say 这等徐娘半老，还是留与阁下自己把玩吧！");
		return 0;
	}

	command("sigh");
	return 0;

	addition = 0;
	if (userp(ob))
	{
		// 5 + 2 :: because times & first will occupy two item
		if (sizeof(ob->query("sex")) > 4 + 2 )
		{
			command("say 哼！这等轻浮女子，我欧阳轲可看不上。");
			return 0;
		}

		if (ob->query("per") < 25)
		{
			command("shrug");
			command("say 这... 这等姿色实在不堪入目，还请另觅佳人。");
			return 0;
		}

		addition += ob->query("per");
		if ((int) ob->query("sex/times") == 0)
		{
			command("say 啊！竟是处子之身，这份情意我必当重谢！");
			addition += 30;
		}
	}

	if (ob->query("sex/欧阳轲") >= 3)
	{
		command("shake");
		command("say 此女我已尝遍滋味，阁下自便吧。");
		return 0;
	}

	obn=new("/clone/money/silver");
	obn->set_amount(20 + addition);
	obn->move(who);

	message_vision("$n将" + ob->name() + "引荐给了$N。\n",
		       this_object(), who);

	message_vision("$N轻轻将" + ob->name() + "揽入怀中，对$n道："
		       "这些银两聊表谢意，后会有期。\n说罢，便携着" +
		       ob->name() + "飘然而去，转眼便到了观乐楼...\n",
		       this_object(), who);

	ob->move("/d/city/lichunyuan");
	move("/d/city/lichunyuan");

	message_vision("$N搂着昏迷不醒的$n悄然步入。\n", this_object(), ob);

	ob->add("sex/欧阳轲", 1);
	ob->add("sex/times",  1);
	if (ob->query("sex/times") == 1)
		ob->set("sex/first", "欧阳轲");

	ob->revive();
	tell_object(ob, HIY "你幽幽转醒，却见一人正紧紧搂着你，不由得惊呼出声，几欲晕厥。"NOR"\n");
	command("kiss " + ob->query("id"));
	command("say 莫慌莫慌，是" + who->name() +
		"引荐于我的。");
	shout(sprintf(HIW "\n%s(%s)凄厉地喊道：救命啊... 饶... 饶命..."NOR"\n",
		      ob->name() + HIW, ob->query("id")));

	if (! userp(ob))
	{
		ob->set("chat_chance", 15);
		ob->set("chat_msg", ({
			ob->name() + "低声啜泣不已。\n",
			ob->name() + "呜咽道：" + this_object()->name() +
			"，你... 你... 你这个恶魔。\n",
			ob->name() + "哭喊道：不如让我一死了之！\n",
		}) );
	}

	remove_call_out("do_back");
	call_out("do_back", 10 + random(10));
	return -1;
}

void do_back()
{
	remove_call_out("do_back");
	if (base_name(environment()) == query("startroom"))
		return;

	if (! living(this_object()) ||
	    is_busy() || is_fighting())
	{
		call_out("do_back", 10 + random(10));
		return;
	}

	message_vision("$N轻摇玉扇，飘然而去。\n", this_object());
	move(query("startroom"));
	message_vision("$N手持玉扇，闲庭信步而来。\n", this_object());
}

mixed ask_shenshe()
{
	object me;
	object ob;

	me = this_player();
	if (me->query("family/family_name") != query("family/family_name"))
		return "呵呵，此乃我白驼山不传之秘，外人莫要多问。";

	if (time() - me->query_temp("ask_shenshe") < 900)
		return "方才不是刚给你一条神蛇？莫要贪得无厌。";

	if (query_temp("shenshe_count") < 1)
		return "神蛇已尽，还请改日再来。";

	me->set_temp("ask_shenshe", time());

	add_temp("shenshe_count", -1);
	ob = new("/d/baituo/obj/shenshe");
	message_vision("$N左右看看无人，悄悄取出一物交给$n。\n",
		       this_object(), me);
	ob->move(me, 1);
	return "此物乃我白驼山至宝，切勿轻易示人。";
}

void reset()
{
	set_temp("shenshe_count", 5);
}

void unconcious()
{
	die();
}

void die()
{
	string dest;
	object ob;
	mapping my;

	foreach (ob in query_enemy())
	{
		if (ob->query("combat_exp") > 2000000 && ob->query("score") > 50000)
		{
			::die();
			return;
		}
	}

	if (environment() == find_object(dest = "/d/city/beidajie1"))
		dest = "/d/city/lichunyuan";
	message_vision("$N大喝一声：不好！三十六计，走为上计！\n只见$N玉扇一挥，转瞬间便消失得无影无踪！\n",
		       this_object());
	remove_all_enemy(1);
	move(dest);
	my = query_entire_dbase();
	my["qi"] = my["eff_qi"] = my["max_qi"];
	my["jing"] = my["eff_jing"] = my["max_jing"];
	my["neili"] = my["max_neili"];
}
