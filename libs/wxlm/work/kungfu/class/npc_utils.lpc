// npc_utils.c
// 用于存放常用的NPC辅助函数



// 获取排名前N名玩家的平均技能等级
/**
 * 获取排名前N名玩家的平均技能等级
 * @param top_n 需要计算的玩家数量
 * @return int 平均技能等级
 */
int get_avg_skill_level(int top_n) {
    int i, total_level = 0;
    // 按经验值降序排列玩家
    object *top_players = sort_array(users(), (: $2->query("combat_exp") - $1->query("combat_exp") :));

    // 边界检查
    if(top_n < 1) return 0;
    if(sizeof(top_players) < top_n)
        top_n = sizeof(top_players);
    if(top_n < 1) return 0;

    // 计算前N名玩家的技能等级总和
    for(i = 0; i < top_n; i++) {
        // 获取基础内功等级和特殊内功等级的最大值
        int base = top_players[i]->query_skill("force", 1);
        string force = top_players[i]->query_skill_mapped("force");
        int special = force ? top_players[i]->query_skill(force, 1) : 0;
        total_level += (base > special ? base : special);
    }

    if (top_n == 0)
        return 0;

    return total_level / top_n;
}

// 获取某个门派中经验排名前N名玩家的平均技能等级
int get_avg_skill_level_in_clan(string clan, int top_n) {
    int i, total_level = 0;
    object *clan_players = filter_array(users(), (: $1->query("family/family_name") == $(clan) :));
    object *top_players = sort_array(clan_players, (: $2->query("combat_exp") - $1->query("combat_exp") :));

    if (sizeof(top_players) < top_n)
        top_n = sizeof(top_players);

    if (top_n == 0)
        return 0;

    for (i = 0; i < top_n; i++) {
        total_level += top_players[i]->query_skill("force", 1); // 这里以内功等级为例
    }

    return total_level / top_n;
}


// 获取排名前N名玩家的平均四维属性
mapping get_avg_attributes(int top_n) {
    int i;
    mapping avg_attr = ([ "str": 0, "dex": 0, "int": 0, "con": 0 ]);
    object *top_players = sort_array(users(), (: $2->query("combat_exp") - $1->query("combat_exp") :));

    if (sizeof(top_players) < top_n)
        top_n = sizeof(top_players);

    if (top_n == 0)
        return avg_attr;

    for (i = 0; i < top_n; i++) {
        avg_attr["str"] += top_players[i]->query("str");
        avg_attr["dex"] += top_players[i]->query("dex");
        avg_attr["int"] += top_players[i]->query("int");
        avg_attr["con"] += top_players[i]->query("con");
    }

    foreach (string attr in keys(avg_attr)) {
        avg_attr[attr] /= top_n;
    }

    return avg_attr;
}

// 设置基础技能等级
// 参数说明:
// ob: 要设置技能的对象
// level: 要设置的技能等级
void set_basic(object ob, int level)
{
        string *basic_skills = ({
                "literate", "strike", "cuff", "hand", "dodge", "sword",
                "finger", "force", "parry", "blade", "hammer", "club",
                "staff", "whip", "dagger", "claw", "unarmed"
        });
        
        foreach(string skill in basic_skills) {
                ob->set_skill(skill, level);
        }
}


