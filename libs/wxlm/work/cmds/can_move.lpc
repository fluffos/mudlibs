
int is_can_move(object me)
{

    if (me->is_ghost())
    {
        tell_object(me, "你还是等还了阳再说吧。\n");
        return 0;
    }
    if (me->is_busy())
    {
        tell_object(me, "你还是先停下手头里的事情再说吧！\n");
        return 0;
    }

    // if (environment(me)->is_chat_room())
    // {
    //     tell_object(me, "茶馆闲聊之地,不便施展轻功。\n");
    //     return 0;
    // }

    if (me->is_fighting())
    {
        tell_object(me, "你正在战斗中。\n");
        return 0;
    }

    if (!environment(me))
    {
        tell_object(me, "你站在空地上，无法移动。\n");
        return 0;
    }

    // if (sscanf(base_name(environment(me)), "/f/%*s"))
    // {
    //     tell_object(me, "此乃秘境之地,还是老老实实走路吧...\n");
    //     return 0;
    // }

    if (environment(me)->query("no_magic", 1))
    {
        tell_object(me, "这里无法使用这个功能。\n");
        return 0;
    }

    if (me->over_encumbranced()) 
    {
        tell_object(me, "你负重太重，难以腾空而起。\n"); 
        return 0;
    }

    if (me->query_encumbrance() < 0) 
    {
        tell_object(me, "你感觉身体状况异常，无法御风而行。\n"); 
        return 0;
    }

    if (me->query_temp("sleeped")) 
    {
        tell_object(me, "你正在酣睡之中，如何腾云驾雾？\n");
        return 0;
    }

    if (me->is_in_prison())   
    {
        tell_object(me, "铁窗之内，纵有绝世轻功也难以遁形！\n");
        return 0;
    }

    if (me->query("doing")) 
    {
        tell_object(me, "你正忙着其他事情，无暇分心御风而行。\n");
        return 0;
    }

    if (me->query_temp("is_flying")) 
    {
        tell_object(me, "你已经御风而行，正在云端之上！\n");
        return 0;
    }
    
    if (! environment(me)->query("outdoors")&& !wizardp(me) && environment(me)->query("short") != "客店茶房") 
    {
        tell_object(me, "室内空间狭小，施展不开轻功身法！\n");
        return 0;
    }
    
    if (environment(me)->query("no_magic") || environment(me)->query("no_fly"))
    {
        tell_object(me, "这里有一股奇特的力场，禁锢着你的轻功！\n");
        return 0;
    }

	return 1;
}
