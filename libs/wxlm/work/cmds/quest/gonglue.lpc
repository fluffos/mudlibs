/**
 * @file gonglue.c
 * @author Lu dexiang
 * @brief 秘籍攻略查询命令
 * @version 1.0
 * @date 2023-07-19
 * 
 * @details 本命令用于让玩家查看游戏中各种秘籍的获取方法和使用说明
 */



// 函数声明
int main(object me, string arg);
string help();
string usage();
string display_skill_category(string category);
string display_skill_detail(string category, string skill);
mapping get_skill_data();

// 主函数
int main(object me, string arg)
{
    string category, skill;

    if (!me)
        return 0;

    // 无参数，显示主菜单
    if (!arg || arg == "")
    {
        string msg = HIY "【游戏攻略】" NOR "秘籍获取指南：\n\n";
        string *buttons = ({
            "基础技能:gonglue basic",
            "门派武功:gonglue sectskill",
            "特殊技能:gonglue special",
            "绝世秘籍:gonglue unique",
            "特殊剧情:gonglue event"
        });
        msg += "请选择要查看的分类：\n";

        tell_object(me, popup_comb(msg, buttons));
        return 1;
    }

    // 解析参数
    if (sscanf(arg, "%s %s", category, skill) != 2)
    {
        category = arg;
        skill = "";
    }

    // 处理分类和具体技能
    if (skill == "")
    {
        tell_object(me, display_skill_category(category));
    }
    else
    {
        tell_object(me, display_skill_detail(category, skill));
    }

    return 1;
}

