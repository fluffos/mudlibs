// 显示技能分类
string display_skill_category(string category)
{
    mapping skill_data = get_skill_data();
    mapping category_data;
    string msg, *skill_names, *buttons;
    
    if (!category || undefinedp(skill_data[category]))
    {
        return msg299("攻略系统", "没有找到相关分类的攻略信息。");
    }
    
    category_data = skill_data[category];
    skill_names = keys(category_data);
    
    switch (category)
    {
        case "basic":
            msg = HIY "【基础技能】" NOR "攻略\n\n";
            break;
        case "sectskill":
            msg = HIY "【门派武功】" NOR "攻略\n\n";
            break;
        case "special":
            msg = HIY "【特殊技能】" NOR "攻略\n\n";
            break;
        case "unique":
            msg = HIY "【绝世秘籍】" NOR "攻略\n\n";
            break;
        case "event":
            msg = HIY "【特殊剧情】" NOR "攻略\n\n";
            break;
        default:
            msg = HIY "【游戏攻略】" NOR "秘籍指南\n\n";
    }
    
    msg += "请选择要查看的具体内容：\n";
    
    buttons = ({});
    foreach (string skill in skill_names)
    {
        buttons += ({ skill + ":gonglue " + category + " " + skill });
    }
    
    buttons += ({ "返回主菜单:gonglue" });
    
    return popup_comb(msg, buttons);
}

// 显示具体技能详情
string display_skill_detail(string category, string skill)
{
    mapping skill_data = get_skill_data();
    mapping category_data;
    string msg, content;
    
    if (!category || undefinedp(skill_data[category]))
    {
        return msg299("攻略系统", "没有找到相关分类的攻略信息。");
    }
    
    category_data = skill_data[category];
    
    if (!skill || undefinedp(category_data[skill]))
    {
        return msg299("攻略系统", "没有找到相关技能的攻略信息。");
    }
    
    content = category_data[skill];
    
    msg = HIY "【" + skill + "】" NOR "秘籍攻略\n\n";
    msg += content + "\n";
    
    return popup_comb(msg, ({ "返回上级:gonglue " + category, "返回主菜单:gonglue" }));
}

// 帮助信息
string help()
{
    return "指令格式：gonglue [分类] [技能名称]\n\n"
           "这个指令可以让你查询游戏中各种秘籍的获取方法和使用说明。\n"
           "直接输入 gonglue 可以查看所有分类。\n"
           "输入 gonglue 分类名 可以查看该分类下的所有技能。\n"
           "输入 gonglue 分类名 技能名 可以查看具体技能的详细攻略。\n";
}

// 使用方法
string usage()
{
    return "gonglue [分类] [技能名称]";
}
