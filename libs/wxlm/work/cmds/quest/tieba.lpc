/**
 * @file tieba.c
 * @author Lu dexiang
 * @brief 百度贴吧昵称绑定功能
 * @version 1.0
 * @date 2023-12-20
 */

int main(object me, string arg)
{
    string tieba_id;

    if (! me)
        return 0;

    if (arg)
    {
        // 直接输入昵称的处理方式
        if (strlen(arg) < 2)
        {
            write("贴吧昵称太短了。\n");
            return 1;
        }
        
        if (strlen(arg) > 20)
        {
            write("贴吧昵称太长了。\n");
            return 1;
        }

        me->set("tieba_id", arg);
        write(HIY "设置成功！你的贴吧昵称为：" + arg + "\n" NOR);
        return 1;
    }

    // 当前绑定状态
    tieba_id = me->query("tieba_id");
    if (tieba_id)
    {
        write("你当前绑定的贴吧昵称是：" + tieba_id + "\n");
        return notify_fail(popup_input("请输入新的贴吧昵称（直接回车取消修改）：", "tieba "));
    }

    // 使用popup_input获取输入
    return notify_fail(popup_input("请输入你的百度贴吧昵称：", "tieba "));
}
