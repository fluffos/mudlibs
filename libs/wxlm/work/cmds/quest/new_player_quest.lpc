/**
 * 检查指定任务是否完成
 * 
 * @param me 玩家对象
 * @param quest_id 任务ID
 * @return 1:任务完成 0:任务未完成
 */
public int check_quest_complete(object me, int quest_id)
{
    mapping condition;
    mixed value;
    string save_key;

    if (!objectp(me) || quest_id < 0 || quest_id >= MAX_QUEST_STAGE)
        return 0;

    save_key = "new_player_quest/completed/" + quest_id;
    
    // 检查是否已完成并保存
    if (me->query(save_key))
        return 1;

    // 检查前置任务
    if (quest_id > 0 && !me->query("new_player_quest/completed/" + (quest_id - 1)))
        return 0;

    condition = new_player_quest_condition[quest_id];
    if (!mapp(condition))
        return 0;

    foreach (string key, mixed requirement in condition)
    {
        // 处理函数指针类型的检查条件
        if (key == "function_check")
        {
            if (!functionp(requirement) || !evaluate(requirement, me))
                return 0;
            continue;
        }



        // 处理属性检查
        value = me->query(key);
        if (stringp(requirement) && requirement == "exist")
        {
            if (nullp(value) || value == "" || !value)
                return 0;

            if (key == "family/master_name" && value == "无")
                return 0;
        }
        else if (intp(requirement))
        {
            if (!intp(value) || value < requirement)
                return 0;
        }
    }

    return 1;
}

/**
 * 获取玩家当前需要完成的任务ID
 * 
 * @param me 玩家对象
 * @return 任务ID，-1表示所有任务都已完成
 */
private int get_current_quest_id(object me)
{
    int quest_id;

    if (!objectp(me))
        return -1;

    quest_id = me->query("new_player_quest/stage");

    // 初始化进度
    if (!intp(quest_id) || quest_id < 0)
    {
        quest_id = 0;
        me->set("new_player_quest/stage", quest_id);
        return quest_id;
    }

    // 防止进度超出范围
    if (quest_id >= MAX_QUEST_STAGE)
        return -1;

    // 如果当前任务未完成，继续当前任务
    if (!check_quest_complete(me, quest_id))
    {
        return quest_id;
    }
        
    // 如果当前任务已完成，检查是否有后续任务
    if (quest_id + 1 < MAX_QUEST_STAGE)
        return quest_id;

    return -1;  // 所有任务都完成
}

/**
 * 安全地添加玩家属性值
 * 
 * @param me 玩家对象
 * @param key 属性键名
 * @param value 要增加的值
 * @return void
 */
private void safe_add(object me, string key, int value)
{
    int current;
    
    if (!objectp(me) || !stringp(key) || value <= 0)
        return;
        
    current = me->query(key);
    if (!intp(current))
        current = 0;
        
    // 防止数值溢出
    if (current + value < current)
        return;
        
    // me->set(key, current + value);
    me->add(key, value);
}

/**
 * 任务阶段完成的回调函数
 * 处理奖励发放和提示信息
 * 
 * @param me 玩家对象
 * @param quest_id 完成的任务ID
 */
void on_quest_stage_complete(object me, int quest_id)
{
    mapping reward;
    string save_key;

    if (!objectp(me) || quest_id < 0 || quest_id >= MAX_QUEST_STAGE)
    {
        if (objectp(me))
            tell_object(me, "任务ID错误，请联系管理员\n");
        return;
    }

    save_key = "new_player_quest/completed/" + quest_id;
    
    // 检查是否已经领取过该阶段奖励
    if (me->query(save_key))
        return;

    reward = quest_rewards[quest_id];
    if (!mapp(reward))
    {
        log_file("quest_error", sprintf("Invalid reward data for quest_id %d\n", quest_id));
        return;
    }


    
    // 安全地发放奖励
    if (!nullp(reward["exp"]))
        safe_add(me, "combat_exp", reward["exp"]);
    
    if (!nullp(reward["pot"]))
        safe_add(me, "potential", reward["pot"]);
    
    if (!nullp(reward["score"]))
        safe_add(me, "score", reward["score"]);

    if (!nullp(reward["bind_yuanbao"]))
        safe_add(me, "bind_yuanbao", reward["bind_yuanbao"]);

    //发放物品奖励
    if (!nullp(reward["obj_list"]))
    {
        if (!arrayp(reward["obj_list"]) || !sizeof(reward["obj_list"]))
            return 0;

        foreach (mapping obj_data in reward["obj_list"])
        {
            object obj;

            if (!obj_data["path"] || !obj_data["amount"])
                return 0;

            obj = new_bind(obj_data["path"]);
            
            if (obj_data["amount"] > 1)
            {
                obj->set_amount(obj_data["amount"]);
            }

            tell_object(me, sprintf("你获得了%d个%s！\n", obj_data["amount"], obj->name()));
            obj->move(me);
    }
    }

    // 记录任务进度和完成状态
    me->set("new_player_quest/stage", quest_id + 1);
    me->set(save_key, 1);

    // 发送奖励提示
    if (stringp(reward["msg"]))
    {
        tell_object(me, popup_comb(reward["msg"], ({"查看下一任务:new_player_quest", "关闭:look"})));
    }

    // 如果是最后一个任务，设置完成标记并发送全服公告
    if (quest_id == MAX_QUEST_STAGE - 1)
    {
        me->set("new_player_quest_complete", 1);
        CHANNEL_D->do_channel(this_object(), "rumor", 
            sprintf(HIY"恭喜%s完成了所有新手指引任务，正式踏上江湖之路！"NOR, me->query("name")));

        //更新主页
        me->force_me("look");
    }

}

/**
 * 主函数入口
 * 显示当前任务进度和提示信息
 * 
 * @param me 玩家对象
 * @param arg 命令参数(未使用)
 * @return 1:成功 0:失败
 */
int main(object me, string arg)
{
    int quest_id;

    if (!objectp(me))
        return 0;

    if (arg == "start")
    {
        me->set("new_player_quest/is_start", 1);
        return 1;
    }

    if (arg == "start2")
    {
        me->set("new_player_quest/is_start", 2);
        return 1;
    }


    quest_id = get_current_quest_id(me);

    if (quest_id == -1)
    {
        write("新手指导任务已经全部完成。\n");
        return 1;
    }


    // 返回任务进度,json格式和客户端通信
    {

        mapping cmd_data = ([
            0: "new_player_quest start",
            2: "new_player_quest start2",
            3: "new_inventory_beibao",
        ]);

        mapping data = ([]);
        data["code"] = "new_player_quest";
        data["stage"] = sprintf("task-%d", quest_id);
        data["msg"] = new_player_msg_list[quest_id];
        data["option"] = new_player_quest_option_msg[quest_id];

        if (nullp(cmd_data[quest_id]))
            data["cmd"] = "";
        else
            data["cmd"] = cmd_data[quest_id];

        tell_object(me, json_encode(data) + "\n");
    }
    return 1;
}

