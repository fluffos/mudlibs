/**
 * 检查任务7的完成条件
 * @brief 检查玩家是否满足任务7的所有要求
 * @param me 玩家对象
 * @return int 1表示满足条件，0表示不满足
 * @details 检查基础技能等级和激发的特殊武功等级
 */
private int check_quest_7_condition(object me)
{
    string force_skill, dodge_skill, parry_skill;

    if (!objectp(me))
        return 0;

    // 检查基础技能等级
    if (me->query_skill("force", 1) < 50 ||
        me->query_skill("dodge", 1) < 50 ||
        me->query_skill("parry", 1) < 50)
        return 0;

    // 检查是否激发了特殊武功
    force_skill = me->query_skill_mapped("force");
    dodge_skill = me->query_skill_mapped("dodge");
    parry_skill = me->query_skill_mapped("parry");

    // 必须激发了特殊武功且等级达到50
    if (!stringp(force_skill) || me->query_skill(force_skill, 1) < 50)
        return 0;
    if (!stringp(dodge_skill) || me->query_skill(dodge_skill, 1) < 50)
        return 0;
    if (!stringp(parry_skill) || me->query_skill(parry_skill, 1) < 50)
        return 0;

    return 1;
}

