inherit F_CLEAN_UP;

int main(object me, string arg)
{
    object master, pop1;
    string msg;
    mapping score_info;

    master = load_object("/system/match_pk/pk_master");
        
    if (!master) {
        tell_object(me, "错误：无法加载PK系统。\n");
        return 1;
    }

    // 如果有参数，直接处理命令
    if (arg) {
        switch(arg) {
            case "join":
                return master->join_queue(me);
            case "leave":
                return master->leave_queue(me);
            case "score":
                return master->show_score(me);
            case "rank":
                return master->show_rank(me);
            default:
                tell_object(me, "未知的参数，请使用 match_pk 查看帮助。\n");
                return 1;
        }
    }

    // 创建弹窗界面
    pop1 = new(POP1);
    msg = "欢迎使用PK匹配系统！\n";
    msg += "系统开放时间：每天10点至23点30分\n";
    
    // 显示当前状态
    if (master->is_in_queue(me)) {
        msg += HIY "你当前正在匹配队列中等待对手...\n" NOR;
    }
    
    // 显示当前积分信息（如果有）
    score_info = master->get_player_data(me);
    if (score_info) {
        msg += sprintf("\n当前积分：%d\n"
                      "连胜次数：%d\n"
                      "最大连胜：%d\n"
                      "总胜/负：%d/%d\n",
                      score_info["score"],
                      score_info["win_streak"],
                      score_info["max_win_streak"],
                      score_info["total_wins"],
                      score_info["total_losses"]);
    } else {
        msg += "\n你还未参加过PK比赛\n";
    }
    
    pop1->basic(msg, 2);
    
    // 添加功能按钮
    if (!master->is_in_queue(me)) {
        pop1->add_button("加入匹配队列", "match_pk join");
    } else {
        pop1->add_button("离开匹配队列", "match_pk leave");
    }
    
    pop1->add_button("查看个人积分", "match_pk score");
    pop1->add_button("查看排行榜", "match_pk rank");
    
    write(pop1->result() + "\n");
    return 1;
}
