/**
 * @brief 主线任务命令
 * @details 用于玩家查看、提交和处理主线任务
 */
int main(object me, string arg)
{
    string cmd, param;
    
    if (!arg)
    {
        MAIN_TASK_MASTER->show_next_quest(me);
        return 1;
    }
    
    if (sscanf(arg, "%s %s", cmd, param) != 2)
        cmd = arg;
    
    if (cmd == "submit")
    {
        return MAIN_TASK_MASTER->submit_quest(me);
    }
    else if (cmd == "start_spar")
    {
        int quest_id = to_int(param);
        if (!quest_id)
        {
            tell_object(me, "无效的任务ID。\n");
            return 1;
        }
        
        return MAIN_TASK_MASTER->start_spar_quest(me, quest_id);
    }
    else if (cmd == "start_kill")
    {
        int quest_id = to_int(param);
        if (!quest_id)
        {
            tell_object(me, "无效的任务ID。\n");
            return 1;
        }
        
        return MAIN_TASK_MASTER->start_kill_quest(me, quest_id);
    }
    else if (cmd == "start")
    {
        int quest_id = to_int(param);
        if (!quest_id)
        {
            tell_object(me, "无效的任务ID。\n");
            return 1;
        }

        //上一个任务是否完成
        if(MAIN_TASK_MASTER->get_player_finished_quest(me) != quest_id - 1)
        {
            tell_object(me, msg299("主线任务","上一个任务未完成。"));
            return 1;
        }
        
        return MAIN_TASK_MASTER->start_quest(me, quest_id);
    }
    else if (cmd == "list_json")
    {
        string json_data;
        int page = 1;

        if (param && sscanf(param, "%d", page) == 1)
        {
            if (page < 1) page = 1;
        }
        
        json_data = MAIN_TASK_MASTER->get_task_list_json(me,page);

        tell_object(me, json_data + "\n");
        // log_file("main_task_list.log", sprintf("%s 获取任务列表第%d页\n%s\n", ctime(time()), page, json_data));
        return 1;
    }

    return 1;
}

int help(object me)
{
    write(@HELP
指令格式：main_task [参数]

这个指令用来查看和处理主线任务。

可用参数：
  无参数     - 显示当前任务信息
  submit     - 提交当前任务
  start_spar - 开始切磋任务
  start_kill - 开始击杀任务
  start      - 开始指定ID的新任务
  list_json  - 获取任务列表的JSON数据，可指定页码，每页10条

示例：
  main_task          - 查看当前任务
  main_task submit   - 提交当前任务
  main_task start_spar 30 - 开始ID为30的切磋任务
  main_task start_kill 10 - 开始ID为10的击杀任务
  main_task start 10 - 开始ID为10的新任务
  main_task list_json - 获取第1页任务列表的JSON数据
  main_task list_json 2 - 获取第2页任务列表的JSON数据
HELP
    );
    return 1;
}