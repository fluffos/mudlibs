// 押镖任务指令 - escort.c

inherit F_CLEAN_UP;



int main(object me, string arg)
{
    object biaoche;
    string *route;
    mapping escort_info;

    if (!arg)
    {
        tell_object(me, "你要做什么？押镖指令：escort start\n");
        return 1;
    }

    if (arg == "start")
    {
        // 检查是否已准备好押镖
        if (!me->query("escort_ready"))
        {
            tell_object(me, "你还没有领取押镖任务，请先找王镖头领取（escort）。\n");
            return 1;
        }

        // 初始化押镖路线
        route = ({
            
            "/d/changan/biaoju-damen",
            "/d/changan/qixiang5",
            "/d/changan/qixiang4",
            "d/changan/beian-daokou",
           
            "d/changan/baihu2",
            "d/changan/baihu3",
            "d/changan/fengxu1",
            "d/changan/fengxu2",
            "d/changan/fengxu3",
            "d/changan/dongan-dadao",
            "d/changan/dongan-daokou",
            "d/changan/dong-chengmen",
            "d/changan/road4",
            "d/changan/road3",
            "d/changan/zhongnan",
            "d/changan/road2",
            "d/changan/hanguguan",
            "d/changan/road1",
            "/d/city/ximenroad",
            "/d/city/ximen",
            
        });

        // 创建镖车
        biaoche = new("/clone/npc/biaoche",me);
        biaoche->set("owner", me->query("id"));
        biaoche->set("name", sprintf(HIR "%s的镖车" NOR, me->query("name")));
        biaoche->set("route", route);
        biaoche->move(environment(me));

        // 任务信息记录
        escort_info = ([
            "target" : "/d/city/ximen",
            "route"  : route,
        ]);
        me->set("escort_info", escort_info);
        me->set("escort_today", 1);
        me->delete("escort_ready");

        // 自动跟随镖车
        me->set_leader(biaoche);
        me->command("follow biao che");

        tell_object(me, HIY "你开始护送镖车，务必要小心路上的劫匪！\n" NOR);
    }
    else
    {
        tell_object(me, "押镖指令：escort start\n");
    }

    return 1;
}