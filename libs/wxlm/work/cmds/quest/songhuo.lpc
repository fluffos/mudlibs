/**
 * @brief 送货任务查询命令
 * @author Lu dexiang
 * @date 2023-8-30
 */



inherit F_CLEAN_UP;

int main(object me, string arg)
{
    object *quest_list;
    string msg, *buttons;
    mapping quest_info;
    int i, count = 0;

    quest_list = children("/clone/quest/deliver");

    if (sizeof(quest_list) == 0)
    {
        write(popup_comb("当前没有送货任务。", 
              ({"刷新列表:songhuo"})));
        return 1;
    }

    msg = HIY"当前可接取的送货任务：\n"NOR;
    buttons = ({});
    
    for (i = 0; i < sizeof(quest_list); i++)
    {

        if (!clonep(quest_list[i]))
        {
            continue;
        }

        if (!mapp(quest_info = quest_list[i]->get_quest_info()) || 
            !stringp(quest_info["任务名称"]))
        {
            tell_object(me, sprintf("任务：%O。\n", quest_list[i]->get_quest_info()));
            continue;
        }

        count++;
        
        msg += sprintf(HIW"%d. 任务名称：%s"NOR"\n"
                      "   取货地点："HIG"%s"NOR" 取货人："HIC"%s"NOR"\n"
                      "   送达地点："HIG"%s"NOR" 收货人："HIC"%s"NOR"\n\n", 
                      count, 
                      quest_info["任务名称"], 
                      quest_info["取货人地址"], 
                      quest_info["取货人名称"], 
                      quest_info["收货人地址"], 
                      quest_info["收货人名称"]);
    }
    
    // 添加刷新列表按钮
    buttons += ({ "刷新列表:songhuo" });

    write(popup_comb(msg, buttons));
    return 1;
}
