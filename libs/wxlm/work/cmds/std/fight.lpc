/**
 * @file fight.c
 * @brief 切磋比试命令实现
 * @details 实现玩家间的武学切磋，支持根据境界差异显示不同的挑战言辞
 */

// fight.c

inherit F_CLEAN_UP;

// 函数原型声明
string get_fight_message(object me, object obj);

/**
 * @brief 获取根据境界差异的切磋挑战言辞
 * @param object me 挑战者
 * @param object obj 被挑战者
 * @return string 切磋挑战文本
 * @details 根据挑战者与被挑战者的境界差异，返回不同的切磋言辞
 */
string get_fight_message(object me, object obj)
{
	int me_is_wuzun, me_is_zongshi, obj_is_wuzun, obj_is_zongshi;
	string *messages;
	string me_title, obj_title;
	
	// 判定境界
	me_is_wuzun = me->query("sanhua_done");
	me_is_zongshi = me->query("opinion/ultra");
	obj_is_wuzun = obj->query("sanhua_done");
	obj_is_zongshi = obj->query("opinion/ultra");
	
	// 获取称谓
	me_title = RANK_D->query_self(me);
	obj_title = RANK_D->query_respect(obj);
	
	// 武尊对武尊 - 高手论道
	if (me_is_wuzun && obj_is_wuzun) {
		messages = ({
			"\n$N微微一笑，淡然道：「" + me_title + me->name() + "，久闻" + obj_title + "大名，今日可否论道一二？」\n\n",
			"\n$N拱手作揖，温和地说：「" + me_title + me->name() + "，想与" + obj_title + "切磋一番，不知意下如何？」\n\n",
			"\n$N神色淡然，轻声道：「" + me_title + me->name() + "，与" + obj_title + "互相印证，如何？」\n\n"
		});
	}
	// 武尊对宗师/普通 - 高人指点
	else if (me_is_wuzun) {
		messages = ({
			"\n$N面带微笑，温声道：「" + me_title + me->name() + "，不才与" + obj_title + "切磋一二，请不要客气。」\n\n",
			"\n$N和颜悦色：「" + me_title + me->name() + "，与" + obj_title + "讨教一番，可否？」\n\n",
			"\n$N淡然一笑：「" + me_title + me->name() + "，愿与" + obj_title + "切磋武艺，请赐教。」\n\n"
		});
	}
	// 宗师/普通对武尊 - 请教高人
	else if (obj_is_wuzun) {
		messages = ({
			"\n$N恭敬地拱手作揖：「" + me_title + me->name() + "，恩蒙" + obj_title + "指点，实乃三生之幸！」\n\n",
			"\n$N肉身下拜：「" + me_title + me->name() + "，敖请" + obj_title + "不吐赐教！」\n\n",
			"\n$N满怀敬意：「" + me_title + me->name() + "，久仰" + obj_title + "大名，今日得见，实乃幸事！请指点一二！」\n\n"
		});
	}
	// 宗师对宗师 - 同道交流
	else if (me_is_zongshi && obj_is_zongshi) {
		messages = ({
			"\n$N拱手正色道：「" + me_title + me->name() + "，久闻" + obj_title + "武功精湛，今日可否交流一二？」\n\n",
			"\n$N真诚地说：「" + me_title + me->name() + "，与" + obj_title + "切磋，必有所得！」\n\n",
			"\n$N眼中满含战意：「" + me_title + me->name() + "，与" + obj_title + "互相切磋，如何？」\n\n"
		});
	}
	// 宗师对普通 - 高手指点
	else if (me_is_zongshi) {
		messages = ({
			"\n$N温声道：「" + me_title + me->name() + "，与" + obj_title + "切磋一番，希望对你有所裨益。」\n\n",
			"\n$N善意地说：「" + me_title + me->name() + "，与" + obj_title + "讨教一二，请多指教。」\n\n",
			"\n$N面带鼓励：「" + me_title + me->name() + "，与" + obj_title + "切磋，让我看看你的进步。」\n\n"
		});
	}
	// 普通对宗师 - 请教高手
	else if (obj_is_zongshi) {
		messages = ({
			"\n$N恭敬地拱手：「" + me_title + me->name() + "，敖请" + obj_title + "赐教高招！」\n\n",
			"\n$N满怀希望：「" + me_title + me->name() + "，模仰" + obj_title + "久矣，请务必指点一二！」\n\n",
			"\n$N说得诚恳：「" + me_title + me->name() + "，与" + obj_title + "切磋，定能受益匹浅！」\n\n"
		});
	}
	// 普通对普通 - 同道切磋
	else {
		messages = ({
			"\n$N拱手热情地说：「" + me_title + me->name() + "，与" + obj_title + "切磋一番，如何？」\n\n",
			"\n$N眼中闪烁着战意：「" + me_title + me->name() + "，来切磋一下吧！」\n\n",
			"\n$N不无说道：「" + me_title + me->name() + "，与" + obj_title + "比试，相互切磋！」\n\n",
			"\n$N真诚地邀请：「" + me_title + me->name() + "，我们来交手吧，" + obj_title + "！」\n\n"
		});
	}
	
	return messages[random(sizeof(messages))];
}

/**
 * @brief 切磋比试命令主函数
 * @param object me 发起挑战的玩家
 * @param string arg 目标对象的标识
 * @return int 返回1表示成功执行，0表示失败
 * @details 实现切磋比试逻辑，包含安全检查、境界判定和挑战言辞
 */
int main(object me, string arg)
{
	object obj, old_target;

	if (me->is_chatter())
		return 0;

	if (environment(me)->query("no_fight"))
		return notify_fail("此地乃清静之所，不宜切磋比试。\n");
      
	if (!arg || !objectp(obj = present(arg, environment(me))))
		return notify_fail("你想与谁切磋呢？\n");
   
	if (! obj->is_character())
		return notify_fail("切磋需要有灵性的对手，这个显然不是。\n");
	if (obj->query("owner") == me->query("id")) 
		return notify_fail("与自己的追随者切磋？这太没意义了。\n");
	if (obj->is_fighting(me))
		return notify_fail("切磋已经开始，何必再言？\n");

	if (! living(obj))
		return notify_fail(obj->name() + "已经无法切磋了，还是让Ta好好休息吧。\n"); 

	if (me->query("qi") < me->query("max_qi") * 3 / 10)
		return notify_fail("气息不定，还是先调息一下再切磋吧。\n");

	if (obj == me) 
		return notify_fail("与自己切磋？这个想法很有趣，但做不到。\n");
	
	if (obj->query("can_speak"))
	{
		string fight_msg;
		fight_msg = get_fight_message(me, obj);
		message_vision(fight_msg, me, obj);

		if( objectp(old_target = me->query_temp("pending/fight")) )
			tell_object(old_target, YEL + me->name() + "改变了比试的对象。"NOR"\n");
		me->set_temp("pending/fight", obj);

		notify_fail("看起来" + obj->name() + "对此次切磋并无兴趣。\n");
		switch (obj->accept_fight(me))
		{
		case 0:
			return userp(obj);
		case -1:
			return 1;
		default:
		}

		me->fight_ob(obj);
		obj->fight_ob(me);
	} else
	{
		message_vision("\n$N轻声道：「既然你不能言語，那就用拳脚来交流吧！」\n\n", me, obj);
		me->fight_ob(obj);
		obj->kill_ob(me);
	}

	return 1;
}
