
#define LIBAO_DATA "/u/libao_data.json"
#define LIBAO_DATA_666 "/u/666yuanbao.json"
inherit F_CLEAN_UP;

//预读礼包码数据
string libao_data_json_text = read_file(LIBAO_DATA);
string libao_data_666_json_text = read_file(LIBAO_DATA_666);

//解析礼包码数据为数组
string *libao_data = (libao_data_json_text == "") ? ({}) : json_decode(libao_data_json_text);
string *libao_data_666 = (libao_data_666_json_text == "") ? ({}) : json_decode(libao_data_666_json_text);

//8888,9999已经使用
int main(object me, string arg)
{
    object ob;
    ob = me;


    if (arg == "8888")
    {
        // 是否已经使用过
        if (ob->query("game_libao_duihuan/qun"))
        {
            return notify_fail("你已经使用过加群礼包了。\n");
        }

        ob->add("potential", 50000);
        ob->add("game_libao_duihuan/qun", 1);
        tell_object(ob, HIR "恭喜你获得加群礼包奖励：50000点潜能。"NOR"\n");
        return 1;
    }

    //检查礼包码是否是666
    if (member_array(arg, libao_data_666) != -1)
    {
      ob->add("yuanbao", 666);
      tell_object(ob, HIR "恭喜你获得666元宝礼包奖励。"NOR"\n");

      //删除礼包码
      libao_data_666 -= ({arg});

      //写回/u/666yuanbao.json
      write_file("/u/666yuanbao.json", json_encode(libao_data_666), 1);

      return 1;
    }


    if (!sizeof(libao_data))
    {
        return notify_fail("礼包码已用尽。\n");
    }

    if (!arg)
    {
      write(INPUTTXT("请输入礼包码","libao_duihuan $txt#")+"\n");
      return 1;
    }
    else
    {


      if (strlen(arg) < 32)
      {
        return notify_fail("没有这个礼包码（32）。\n");
      }

      // 是否有这个礼包码
      if (member_array(arg, libao_data) == -1)
      {
        return notify_fail("没有这个礼包码。\n");
      }

      // 是否已经使用过
      if (ob->query("game_libao_duihuan/taptap"))
      {
        return notify_fail("你已经使用过TAP大礼包了。\n");
      }

      {
        object obj;

        obj = new("/clone/new_gift/taptap_gift");
        ob->add("game_libao_duihuan/taptap",1);
        obj->move(ob);
        tell_object(ob, HIR "你获得了TAP大礼包奖励哦，祝您游戏愉快。"NOR"\n");
      }

      // 如果有这个礼包码，删除这个礼包码
      libao_data -= ({arg});

      // 写回/u/libao_data.json
      write_file("/u/libao_data.json", json_encode(libao_data), 1);

      return 1;

    }

    return notify_fail("你已经领过了啊。\n");
}