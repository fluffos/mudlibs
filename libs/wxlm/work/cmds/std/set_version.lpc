int main(object me,string arg)
{
    int i;

    if (!arg)
    {
        write("当前游戏版本：" + me->query("game_version") + "\n");
        return 1;
    }

    if (sscanf(arg, "%d", i) != 1)
    {
        write("游戏版本必须是一个数字。\n");
        return 1;
    }


    me->set("game_version", i);
    write("游戏版本设置为：" + i + "\n");
}