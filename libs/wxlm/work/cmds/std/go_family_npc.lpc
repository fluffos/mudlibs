#include "/d/rw.h"

int main(object me, string arg)
{
    object pop;
    mapping familyManList;
    string family_name;
    string msg;
    mapping family_data;
    mixed man_name;
    mapping man_data;

    // 参数检查
    if (!arg)
        return 1;

    // 检查目标位置是否存在
    if (undefinedp(where[arg])) {
        write(msg299("飞鹤", "该地点（或人物）位置特殊飞鹤无法定位，大侠还是自己找找吧。"));
        return 1;
    }

    // 获取门派人物列表
    familyManList = "/cmds/usr/new_family"->query_familyManList();
    family_name = me->query("family/family_name");
    msg = "";

    // 查找目标人物信息
    if (!undefinedp(familyManList[family_name])) {
        family_data = familyManList[family_name];
        
        foreach (man_name in family_data) {
            // 只处理mapping类型的数据
            if (!mapp(man_name))
                continue;
                
            man_data = man_name;
            if (man_data["name"] != arg)
                continue;
                
            // 构建人物信息
            msg = "师门人物:" + man_data["name"] + "\n";
            if (man_data["level"])
                msg += "师门辈分:" + chinese_number(man_data["level"]) + "阶\n";

            if (man_data["desc"]) 
            {
                if (man_data["no_revive"])
                    msg += "生袋条件:" + man_data["desc"] + "（不复活）\n";
                else
                    msg += "拜师条件:" + man_data["desc"] + "\n";
            }
            break;
        }
    }

    // 添加飞鹤提示信息
    msg += family_name + "信标为您服务，你要和" + arg + "沟通什么？";

    // 创建弹窗
    pop = new(POP1);
    pop->basic(msg, me, 2);
    pop->add_button("拜师", "apprentice " + arg);
    pop->add_button("学习武功", "new_skills " + arg);
    pop->add_button("前往所在地点", "walk " + arg);
    write(pop->result() + "\n");

    return 1;
}