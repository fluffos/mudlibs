#include <net/dns.h>
inherit F_CLEAN_UP;

// 函数声明
int help(object me);
private void create();
// private object find_player(string target);
private int check_tell_flood(object me);
private void record_tell_message(object me, object target, string msg);
string remote_tell(string cname, string from, string mud, string to, string msg);

// Debug相关
#define DEBUG "snowsot"
#ifdef DEBUG
private void debug(string x) {
    object monitor;
    
    if (!stringp(x) || !stringp(DEBUG)) return;
    monitor = find_player(DEBUG);
    if (monitor && monitor->query("env/debug")) {
        tell_object(monitor, x + "\n");
    }
}
#else
#define debug(x)
#endif

