// /cmds/std/exchange_gem.c



mapping valid_exchanges = BASE_HANDLE->get_gem_color_list();

int main(object me, string arg)
{
    object from_gem, new_gem;
    string from_color, to_type;
    string from_path, to_path;
    int amount = 1, i;
    int is_batch = 0;

    if (!arg || (sscanf(arg, "%s gem to %s batch", from_color, to_type) != 2 &&
                 sscanf(arg, "%s gem to %s", from_color, to_type) != 2))
        return notify_fail("格式：exchange <color> gem to [属性或技能类型] [batch]\n");

    if (sscanf(arg, "%s gem to %s batch", from_color, to_type) == 2)
        is_batch = 1;

    if (!valid_exchanges[from_color])
        return notify_fail("无效的宝石颜色。\n");

    if (member_array(to_type, valid_exchanges[from_color]) == -1)
        return notify_fail("无效的兑换类型。\n");

    from_path = sprintf("/clone/baoshi/%s_baoshi", from_color);
    from_gem = present(from_color + " gem", me);
    if (!from_gem)
        return notify_fail("你身上没有" + from_color + "色宝石。\n");

    to_path = sprintf("/clone/baoshi/%s_baoshi_1", to_type);

    if (is_batch)
        amount = from_gem->query_amount();

    for (i = 0; i < amount; i++)
    {
        new_gem = new(to_path);
        if (!new_gem)
        {
            if (i > 0)
                tell_object(me, "兑换了" + chinese_number(i) + "颗宝石后,兑换失败。\n");
            else
                tell_object(me, "兑换失败,目标宝石类型不存在。\n");
            return 1;
        }
        new_gem->move(me);
    }

    if (is_batch)
        message_vision("$N将所有的" + from_gem->name() + "共" + chinese_number(amount) + "颗全部兑换成了" + new_gem->name() + "。\n", me);
    else
        message_vision("$N将一颗" + from_gem->name() + "兑换成了一颗" + new_gem->name() + "。\n", me);
    if (from_gem->query_amount() > amount)
        from_gem->add_amount(-amount);
    else
        destruct(from_gem);

    return 1;
}