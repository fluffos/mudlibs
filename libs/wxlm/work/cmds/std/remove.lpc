/**
 * @brief 移除装备词条效果
 * @param object me 玩家对象
 * @param object ob 装备对象
 */
void remove_citiao_effects(object me, object ob)
{
    mapping *citiao_effects;
    mapping citiao;
    string attr_key;
    int i, value;
    
    // 获取已记录的词条效果
    citiao_effects = me->query_temp("citiao_effects/" + ob->query("id"));
    if (!citiao_effects || !sizeof(citiao_effects)) return;
    
    // 遍历所有词条并移除效果
    for (i = 0; i < sizeof(citiao_effects); i++) {
        citiao = citiao_effects[i];
        attr_key = citiao["key"];
        value = citiao["value"];
        
        switch(attr_key) {
            // 基础武功类词条
            case "force":
            case "dodge":
            case "parry":
            // 兵器类技能
            case "sword":
            case "blade":
            case "staff":
            case "hammer":
            case "club":
            case "whip":
            case "dagger":
            case "throwing":
            case "qin":
            // 空手类技能
            case "unarmed":
            case "cuff":
            case "strike":
            case "finger":
            case "claw":
            case "hand":
                me->add_temp("apply/" + attr_key, -value);
                break;
                
            // 四维属性类词条
            case "str":
            case "int":
            case "con":
            case "dex":
                me->add_temp("apply/" + attr_key, -value);
                break;
                
            // 状态属性类词条
            case "max_qi":
            case "max_jingli":
            case "max_neili":
                me->add_temp("apply/" + attr_key, -value);
                break;
        }
    }
    
    // 清除记录的词条效果
    me->delete_temp("citiao_effects/" + ob->query("id"));
    
    // 重新计算玩家属性
    if (sizeof(citiao_effects) > 0) {
        CHAR_D->setup_char(me);
        
        message_vision(sprintf(HIB "$N卸下%s，词条效果失效。" NOR "\n", 
            ob->name()), me);
    }
}

int help(object me)
{
    write(@HELP
指令格式 : remove all | <物品名称>

这个指令让你脱掉身上某件防具。

HELP );
    return 1;
}