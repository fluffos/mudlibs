// remove.c


inherit F_CLEAN_UP;

int do_remove(object me, object ob);
// void remove_gem_effects(object me, object ob);
void remove_citiao_effects(object me, object ob);

int main(object me, string arg)
{
    object ob, *inv;
    int count = 0;

    if (!arg) return notify_fail("你要脱掉什么？\n");

    if (arg == "all")
    {
        object weapon;
        inv = all_inventory(me);
        foreach (ob in inv)
        {
            count += do_remove(me, ob);
        }

        // 武器也要卸下
        if (objectp(weapon = me->query_temp("weapon"))) {
            me->force_me("unwield " + weapon->query("id"));
        }

        write(count ? "你脱完了。\n" : "你什么都没有脱下来。\n");
        return 1;
    }

    ob = present(arg, me);
    if (!ob) return notify_fail("你身上没有这样东西。\n");

    if (ob->query("equipped") != "worn")
    {
        inv = all_inventory(me);
        foreach (object item in inv)
        {
            if (item->id(arg) && item->query("equipped") == "worn")
            {
                ob = item;
                break;
            }
        }
        if (ob->query("equipped") != "worn")
            return notify_fail("你并没有装备这样东西。\n");
    }

    return do_remove(me, ob);
}

int do_remove(object me, object ob)
{
    string str;

    if (ob->query("equipped") != "worn")
        return notify_fail("你并没有装备这样东西。\n");

    switch (ob->unequip())
    {
    case -1:
        return 1;
    case 0:
        return 0;
    default:
        // remove_gem_effects(me, ob);
        remove_citiao_effects(me, ob);  // 移除词条效果
        str = ob->query("remove_msg");
        if (!stringp(str))
        {
            switch (ob->query("armor_type"))
            {
            case "cloth":
            case "armor":
            case "surcoat":
            case "boots":
                str = YEL "$N将$n" YEL "脱了下来。"NOR"\n";
                break;
            case "bandage":
                str = YEL "$N将$n" YEL "从伤口处拆了下来。"NOR"\n";
                break;
            default:
                str = YEL "$N卸除$n" YEL "的装备。"NOR"\n";
            }
        }
        if (ob->query_temp("no_wear"))
            str += "脱下" + ob->name() + "以后你觉得舒服多了。\n";
        message_vision(str, me, ob);
        me->delete("equipped_items/" + ob->query("armor_type"));
    }
    me->force_me("equip_group save " + me->query("equip_group_name"));
    me->force_me("equip_ui");
    return 1;
}

