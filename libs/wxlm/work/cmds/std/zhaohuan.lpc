int main(object me,string arg)
{
    object equip;

    if (!arg)
    {
        return notify_fail("你要召唤谁？\n");
    }

    if (arg == "none")
    {
        me->delete("can_shimen/zhaohuan");
        write("你成功取消了自动召唤物品。\n");
        return 1;
    }

    if (equip= present(arg,me))
    {


        if (!equip->is_item_make())
        {
            return notify_fail("这个物品不是由玩家制造的，无法召唤。\n");
        }

        if(equip->item_owner() != me->query("id"))
        return notify_fail(equip->name() + "不需要你来操心吧！\n");


        me->set("can_shimen/zhaohuan",equip->query("id"));
        write("你成功设置了"+equip->name()+"为你的师门任务自动召唤物品。\n");
        return 1;
    }



    return notify_fail("你身上没有这个物品。\n");
}