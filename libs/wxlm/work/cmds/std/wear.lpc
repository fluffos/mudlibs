/**
 * @brief 应用装备词条效果
 * @param object me 玩家对象
 * @param object ob 装备对象
 */
void apply_citiao_effects(object me, object ob)
{
    mapping *citiao_list;
    mapping citiao;
    string attr_key;
    int i, value;
    
    // 检查装备是否支持词条系统
    if (!ob->is_item_make()) return;
    
    citiao_list = ob->query_citiao_data();
    if (!sizeof(citiao_list)) return;
    
    // 遍历所有词条并应用效果
    for (i = 0; i < sizeof(citiao_list); i++) {
        citiao = citiao_list[i];
        attr_key = citiao["key"];
        value = citiao["value"];
        
        switch(attr_key) {
            // 基础武功类词条
            case "force":
            case "dodge":
            case "parry":
            // 兵器类技能
            case "sword":
            case "blade":
            case "staff":
            case "hammer":
            case "club":
            case "whip":
            case "dagger":
            case "throwing":
            case "qin":
            // 空手类技能
            case "unarmed":
            case "cuff":
            case "strike":
            case "finger":
            case "claw":
            case "hand":
                me->add_temp("apply/" + attr_key, value);
                break;
                
            // 四维属性类词条
            case "str":
            case "int":
            case "con":
            case "dex":
                me->add_temp("apply/" + attr_key, value);
                break;
                
            // 状态属性类词条
            case "max_qi":
            case "max_jingli":
            case "max_neili":
                me->add_temp("apply/" + attr_key, value);
                break;
        }
    }
    
    // 重新计算玩家属性
    if (sizeof(citiao_list) > 0) {
        CHAR_D->setup_char(me);
        
        // 记录已应用的词条效果
        me->set_temp("citiao_effects/" + ob->query("id"), citiao_list);
        
        message_vision(sprintf(HIB "$N装备%s，词条效果生效。" NOR "\n", 
            ob->name()), me);
    }
}

void record_equipped_item(object me, object ob)
{
    string armor_type = ob->query("armor_type");
    string item_id = ob->query("id");
    
    if (armor_type && item_id)
    {
        me->set("equipped_items/" + armor_type, item_id);
    }
}

int auto_wear(object me)
{
    mapping equipped_items = me->query("equipped_items");
    object ob;
    int count = 0;

    if (!equipped_items || !mapp(equipped_items))
    {
        return 0;
    }

    foreach (string armor_type, string item_id in equipped_items)
    {
        ob = present(item_id, me);

        if (!ob)
        {
            me->delete("equipped_items/" + armor_type);
            continue;
        }

        if (ob && !ob->query("equipped"))
        {
            if (do_wear(me, ob))
            {
                count++;
            }
        }
    }

    if (count > 0)
    {
        tell_object(me, "你自动穿戴了 " + count + " 件装备。\n");
    }
    else
    {
        tell_object(me, "没有可以自动穿戴的装备。\n");
    }

    return 1;
}

int help(object me)
{
    write(@HELP
指令格式：wear <装备名称>
          wear all
          wear auto

这个指令让你装备某件防具。
wear all    : 穿戴所有可以装备的物品
wear auto   : 自动穿戴之前记录的装备

HELP );
    return 1;
}