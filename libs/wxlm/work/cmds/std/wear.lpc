// wear.c

#include <command.h>


inherit F_CLEAN_UP;

int do_wear(object me, object ob);
// void apply_gem_effects(object me, object ob);
// string get_attr_name(string gem_type);
// varargs void apply_single_gem_effect(object me, object ob, string attr, int value);
string get_default_wear_msg(object ob);
void record_equipped_item(object me, object ob);
void apply_citiao_effects(object me, object ob);
int auto_wear(object me);

int main(object me, string arg)
{
    object ob, ob2, *inv;
    int i, count;

    if (!arg) return notify_fail("你要穿戴什么？\n");
    if (userp(me) && me->is_busy())
        return notify_fail("你正忙着呢。\n");

    if (arg == "all")
    {
        inv = all_inventory(me);
        for (count = 0, i = 0; i < sizeof(inv); i++)
        {
            if (inv[i]->query("equipped") || (inv[i]->is_item_make() && inv[i]->item_owner() != me->query("id")))
                continue;
            if (do_wear(me, inv[i])) count++;
        }
        write(count ? "你穿好了。\n" : "你什么都没有穿上。\n");
        return 1;
    }

    if (arg == "auto")
    {
        return auto_wear(me);
    }

    if (!(ob = present(arg, me)))
        return notify_fail("你身上没有这样东西。\n");

    if (ob->query("equipped"))
    {
        inv = all_inventory(me) - ({ob});
        for (count = 0, i = 0; i < sizeof(inv); i++)
        {
            if (inv[i]->id(arg) && !inv[i]->query("equipped") && do_wear(me, inv[i]))
            {
                count++;
                break;
            }
        }
        if (!count)
            return notify_fail("你已经装备着了。\n");
        return 1;
    }

    if (ob2 = me->query_temp("armor/" + ob->query("armor_type")))
        me->force_me("remove " + file_name(ob2));

    return do_wear(me, ob);
}

int do_wear(object me, object ob)
{
    string str, gender;
    mixed notice;

    if ((notice = ob->query_temp("no_wear")))
    {
        if (stringp(notice)) write(notice);
        return notify_fail("还是试试别的吧！\n");
    }

    gender = me->query("gender");
    if (ob->query("female_only") && gender == "男性")
        return notify_fail("这是女人的衣衫，你一个大男人也想穿，羞也不羞？\n");

    switch (ob->wear())
    {
        case 0:  return 0;
        case -1: return 1;
        default:
            str = ob->query("wear_msg") || get_default_wear_msg(ob);
            // tell_object(me, str);
            if (str != "")
                message_vision(str, me, ob);

            if (ob->query_temp("daub") && ob->query("armor_type") != "hands")
                DAUB_CMD->check_poison(me, ob);

            // apply_gem_effects(me, ob);
            apply_citiao_effects(me, ob);  // 应用词条效果
            record_equipped_item(me, ob);  // 记录已装备的物品
            me->force_me("equip_group save " + me->query("equip_group_name"));
            me->force_me("equip_ui");
            return 1;
    }



}

string get_default_wear_msg(object ob)
{
    string msg;
    switch (ob->query("armor_type"))
    {
        case "cloth":
        case "armor":
        case "boots":
        case "pants":
            msg = YEL "$N穿上一" + ob->query("unit") + "$n" YEL "。"NOR"\n";
            break;
        case "head":
        case "neck":
        case "wrists":
        case "hands":
            msg = YEL "$N戴上一" + ob->query("unit") + "$n" YEL "。"NOR"\n";
            break;
        case "waist":
            msg = YEL "$N将一" + ob->query("unit") + "$n" YEL "绑在腰间。"NOR"\n";
            break;
        default:
            msg = YEL "$N装备$n" YEL "。"NOR"\n";
    }
    return msg;
}

