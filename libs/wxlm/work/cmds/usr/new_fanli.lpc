                    return 1;
               }

               if (me->query("zjvip/all_pay") < vip_gongxian[choose_lvl - 1])
               {
                    me->delete_temp("is_claiming_vip_reward");
                    tell_object(me, "你的贡献不足以领取这个等级的礼包。\n");
                    return 1;
               }

               if (me->query("cxpay/fanli_lingqu/" + choose_lvl))
               {
                    me->delete_temp("is_claiming_vip_reward");
                    tell_object(me, "你已经领取过该等级的返利了。\n");
                    return 1;
               }

               if (vip_gitf[choose_lvl]["item"])
               {
                    lingqu_gift(vip_gitf[choose_lvl]["item"], me);    //发放物品奖励
               }

               if (vip_gitf[choose_lvl]["contribution_points"])
               {
                    me->add("contribution_points", vip_gitf[choose_lvl]["contribution_points"]);
                    tell_object(me, "你获得了" + vip_gitf[choose_lvl]["contribution_points"] + "点贡献积分。\n");
               }

               log_file("cxpay/vip", ctime(time()) + me->query("name") + "(" + me->query("id") + ")领取了" + choose_lvl + "级VIP返利。\n");
               me->set("cxpay/fanli_lingqu/" + choose_lvl, 1);
               
               me->delete_temp("is_claiming_vip_reward");

               return 1;
          }
          else if (sscanf(arg, "%*s %d", choose_lvl) == 2)
          {
               if (me->query("cxpay/fanli_lingqu/" + choose_lvl))
               {
                    tell_object(me, "你已经领取过该等级的返利了。\n");
                    return 1;
               }

               if (me->query("zjvip/all_pay") < vip_gongxian[choose_lvl - 1])
               {
                    tell_object(me, "你的贡献不足以领取这个等级的礼包。\n");
                    return 1;
               }

               tell_object(me, ZJOBLONG + "你确定兑换" + choose_lvl + "级VIP奖励吗？\n" + ZJOBACTS2 + "确定:new_fanli vip " + choose_lvl + " y\n");
               return 1;
          }
          else 
          {
               int total_contribution;

               if (0 == vip_level) 
               {
                    tell_object(me, ZJOBLONG + "你目前的VIP等级为0，无法兑换。\n");
                    return 1;
               }

               total_contribution = me->query("zjvip/all_pay");
               str += ZJOBLONG + "你目前可以兑换的VIP返利为：\n" + ZJOBACTS2;

               for (i = 1; i <= sizeof(vip_gongxian); i++)
               {
                    if (!me->query("cxpay/fanli_lingqu/" + i) && total_contribution >= vip_gongxian[i-1])
                    {
                        str += "等级" + chinese_number(i) + ":new_fanli vip " + i + ZJSEP;
                    }
               }

               tell_object(me, str + "\n");
               return 1;
          }
     }
     // else
     // {
     //      tell_object(me,arg[0..2] + "\n");
     // }

     return 1;
}


void lingqu_gift(mapping gift_list, object me)
{
     string temp;
     object gift;
     int i;

     if (!gift_list) return;  // 如果没有物品奖励,直接返回

     foreach (temp in keys(gift_list))
     {
          if (!objectp(gift = new_bind(temp)))
          {
               tell_object(me, "领取" + temp + "时出错。\n");
               continue;
          }

          if (gift->query_amount())
          {
               gift->set_amount(gift_list[temp]);
               tell_object(me, "你获得了" + gift_list[temp] + gift->query("base_unit") + gift->query("name") + "。\n");
               gift->move(me);
          }
          else
          {
               i = 0;
               do {
                    if (0 == i)
                    {
                         gift->move(me);
                         i++;
                         continue;
                    }

                    if (!objectp(gift = new_bind(temp)))
                    {
                         tell_object(me, "领取" + temp + "时出错。\n");
                         i++;
                         break;
                    }

                    gift->move(me);
                    i++;
               } while (i < gift_list[temp]);
               tell_object(me, "你获得了" + i + gift->query("unit") + gift->query("name") + "\n");
          }
     }
}

string get_accumulated_privileges(int level)
{
    string accumulated = "";
    for (int i = 1; i <= level; i++)
    {
        if (vip_privileges[i]["other"] != "无" && vip_privileges[i]["other"] != "")
        {
            if (accumulated != "") accumulated += "，";
            accumulated += vip_privileges[i]["other"];
        }
    }
    return accumulated == "" ? "无" : accumulated;
}

void show_vip_info(object me)
{
    string str = ZJOBLONG + "VIP系统说明：" ZJBR;
    str += HIC "≡" HIY "一一一一一一一一一一一一一一一一一一一一" HIC "≡"NOR + ZJBR;
    
    for (int i = 0; i < sizeof(vip_level_requirements); i++)
    {
        int level = i + 1;
        str += "VIP" + chinese_number(level) + "级：需要" + vip_level_requirements[i] + "贡献" ZJBR;
        str += "  特权：研究难度-" + vip_privileges[level]["research_speed"] + "%，练习速度+" + vip_privileges[level]["practice_speed"] + "%，神奇葡萄+" + vip_privileges[level]["weapon_power"] + "潜能" ZJBR;
        str += "  特殊权限：" + (vip_privileges[level]["other"] == "无" ? "无" : vip_privileges[level]["other"]) + ZJBR;
        str += HIC "≡" HIY "一一一一一一一一一一一一一一一一一一一一" HIC "≡"NOR + ZJBR;
    }

    str += "\n";
    str += ZJOBACTS2 + "返回:new_fanli\n";
    tell_object(me, str);
}

void show_point_shop(object me)
{
    string str = ZJOBLONG + "积分商城\n";
    str += "当前积分：" + me->query("contribution_points") + "\n";
    str += ZJOBACTS2 + 
           "1000积分技能:new_fanli shop_skill 1000" + ZJSEP +
           "500积分技能:new_fanli shop_skill 500" + ZJSEP +
           "1000积分宝物:new_fanli shop_item 1000" + ZJSEP +
           "返回:new_fanli\n";
    tell_object(me, str);
}

void show_skill_list(object me, int cost)
{
    string *skill_list;
    string str = ZJOBLONG + cost + "积分技能列表\n";
    
    if (cost == 1000)
        skill_list = get_skill_list(); 
    else
    {
        if (cost < 500)
        {
            tell_object(me, "你的积分不足以兑换技能。\n");
            return;
        }

        skill_list = get_skill_list_500();  
    }

    str += ZJOBACTS2;

    foreach (string skill in skill_list)
    {
        str +=   to_chinese(skill) + ":new_fanli buy_skill " + cost + " " + skill + ZJSEP ;
    }
   
    str += "返回:new_fanli point_shop\n";
    tell_object(me, str);
}

void show_item_list(object me, int cost)
{
    string str = ZJOBLONG + cost + "积分宝物列表\n" ;
    str += ZJOBACTS2;

    if (cost < 1000)
    {
          tell_object(me, "你的积分不足以兑换宝物。\n");
          return;
    }

    foreach (string item in gem_list)
    {
        str +=  item->query("name") + ":new_fanli buy_item " + cost + " " + item + ZJSEP;
    }
    
    str += "返回:new_fanli point_shop\n";
    tell_object(me, str);
}

void buy_skill(object me, int cost, string skill)
{
    if (me->query("contribution_points") < cost)
    {
        tell_object(me, "你的积分不足以购买这个技能。\n");
        return;
    }

    if (me->query_skill(skill, 1) > 0)
    {
        tell_object(me, ZJOBLONG + "你已经学会了" + to_chinese(skill) + "，确定要重新学习吗？\n" +
                    ZJOBACTS2 + "确认:new_fanli confirm_buy_skill " + cost + " " + skill + 
                    ZJSEP + "取消:new_fanli point_shop\n");
        return;
    }

    confirm_buy_skill(me, cost, skill);
}

void confirm_buy_skill(object me, int cost, string skill)
{
     string msg;
    me->add("contribution_points", -cost);
    me->set_skill(skill, 180);  // 设置技能等级为180级
    
    msg = ZJOBLONG + "兑换信息" + ZJBR + ZJBR;
    msg += "你成功学会了" + to_chinese(skill) + "，技能等级设置为180级。" + ZJBR;
    msg += "消耗积分：" + cost + ZJBR;
    msg += "剩余积分：" + me->query("contribution_points") + ZJBR + ZJBR + "\n";
    
    msg += ZJOBACTS2 + "返回:new_fanli point_shop\n";
    
    tell_object(me, msg);
}

void buy_item(object me, int cost, string item)
{
    object gem;
    string msg;
    if (me->query("contribution_points") < cost)
    {
        tell_object(me, ZJOBLONG + "你的积分不足以购买这个宝物。\n"  + 
                    ZJOBACTS2 + "返回:new_fanli point_shop\n");
        return;
    }
    gem = new(item);
    if (!gem)
    {
        tell_object(me, ZJOBLONG + "系统错误，无法创建宝物。\n"  + 
                    ZJOBACTS2 + "返回:new_fanli point_shop\n");
        return;
    }
    
    me->add("contribution_points", -cost);
    gem->move(me);

    msg = ZJOBLONG + "兑换信息" + ZJBR + ZJBR;
    msg += "你成功购买了" + gem->query("name") + "。" + ZJBR;
    msg += "消耗积分：" + cost + ZJBR;
    msg += "剩余积分：" + me->query("contribution_points") + ZJBR + ZJBR + "\n";
    
    msg += ZJOBACTS2 + "返回:new_fanli point_shop\n";
    
    tell_object(me, msg);
}

