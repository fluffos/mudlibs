// 获取vip定义的值
mapping get_vip_privileges(){
    return vip_privileges;
}

int calculate_vip_level(int total_contribution)
{
    int vip_level = 0;
    for (int i = 0; i < sizeof(vip_level_requirements); i++)
    {
        if (total_contribution >= vip_level_requirements[i])
            vip_level++;
        else
            break;
    }
    return vip_level;
}


int get_vip_level(object me)
{
    int total_contribution = me->query("zjvip/all_pay");
    return calculate_vip_level(total_contribution);
}

