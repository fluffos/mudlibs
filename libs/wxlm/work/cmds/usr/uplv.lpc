// time.c


inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string str;
	string attr;
	int remaining_points;
	
	remaining_points = (int)me->query("tianfu_point");

	if(!arg)
	{
		str = ZJOBLONG"请选择操作：\n";
		str += ZJOBACTS2+ZJMENUF(3,3,10,30);
		str += "角色升级:uplv -l"ZJSEP"技能升级:uplv -s"ZJSEP"升级天赋("HIY + remaining_points + "点"NOR"):uplv -t"ZJSEP"放弃经验:abandon exp"ZJSEP
		"建立家园:crroom"ZJSEP"扩建家园:crroom"ZJSEP"修改家园:edroom"ZJSEP"增加功能:edroom"ZJSEP"拆除场景:delroom"ZJSEP"家园开关:closeroom";
		message("vision", str+"\n", me);
	}
	else if (arg == "home")
	{
		str = ZJOBLONG"请选择操作：\n";
		str += ZJOBACTS2+ZJMENUF(3,3,10,30);
		str += "扩建家园:crroom"ZJSEP"修改家园:edroom"ZJSEP"增加功能:edroom"ZJSEP"拆除场景:delroom"ZJSEP"家园开关:closeroom"ZJSEP"设为回归点:re_home set"ZJSEP"取消回归点:re_home del";
		message("vision", str+"\n", me);
	}
	else if(arg=="-l")
		F_LEVEL->improve_level(me);
	else if(arg=="-s")
		F_LEVEL->up_skills(me);
	else if(arg=="-t")
	{
		str = ZJOBLONG"你当前有 " + HIY + remaining_points + NOR + " 点天赋点可以分配。\n请选择要提升的属性：\n";
		str += ZJOBACTS2+ZJMENUF(2,2,10,30);
		str += "臂力:uplv -t str"ZJSEP"悟性:uplv -t int"ZJSEP"根骨:uplv -t con"ZJSEP"身法:uplv -t dex"ZJSEP"随机提升:uplv -t random";
		message("vision", str+"\n", me);
	}
	else if(sscanf(arg, "-t %s", attr) == 1)
	{
		if(remaining_points <= 0)
		{
			write("你没有可用的天赋点了。\n");
			return 1;
		}

		if(attr == "random" || member_array(attr, ({"str", "int", "con", "dex"})) != -1)
			F_LEVEL->up_tianfu(me, attr == "random" ? 0 : attr);
		else
			write("无效的属性选择。请选择 str、int、con、dex 之一，或使用 random 随机提升。\n");
	}
	return 1;
}

int help(object me)
{
     write(@HELP
指令格式: uplv [-s]

这个指令让你消耗经验提升等级。

HELP
    );
    return 1;
}
