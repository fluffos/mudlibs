// 作者：Lu Dexiang
// 功能：装备界面系统
inherit F_CLEAN_UP;

// 装备类型映射表
mapping armNameMapEnlish = ([
    "weapon" : "主手",
    "head" : "头部",
    "armor" : "护甲",
    "cloth" : "衣服",
    "hands" : "手部",
    "waist" : "腰部",
    "wrists" : "护腕",
    // "leg" : "护腿",
    "pants" : "裤子",
    "finger" : "戒指",
    "feet" : "护靴",
    "boots" : "鞋子",
    "shield" : "盾牌",
    "neck" : "项链",
    "mount" : "坐骑",
]);

// 装备显示顺序
string *armNameMapList = ({
    "weapon",
    "head",
    "armor",
    "cloth",
    "hands",
    "waist",
    "wrists",
    // "leg",
    "pants",
    "finger",
    "feet",
    "boots",
    "shield",
    "neck",
    "mount"
});


// 生成基础UI结构
private mapping generate_base_ui() {
    mapping result;
    
    result = ([
        "code": "equip_ui",
        "data": ([
            "title": "",
            "choose_equip_buttons": ({}),
            "contronl_equip_actions": ({}),
            "equip_group": ({
                (["text":"套路一","cmd":"equip_group switch 套路一"]),
                (["text":"套路二","cmd":"equip_group switch 套路二"]),
                (["text":"套路三","cmd":"equip_group switch 套路三"]),
            }),
        ])
    ]);
    return result;
}

// 生成装备信息显示
private string generate_equipment_info(object ob) {
    string info;
    int attack, defense;

    attack = ob->query_temp("apply/damage") + ob->query_temp("apply/unarmed_damage");
    defense = ob->query_temp("apply/armor");
    info = sprintf("攻击力：%d  防御力：%d", attack, defense);
    return info;
}

// 生成装备界面JSON数据
string generate_equipment_ui(object ob) {
    mapping result;
    object obj;
    string type;
    
    result = generate_base_ui();
    
    result["data"]["title"] = sprintf("%s的%s"ZJBR, ob->query("name"),(ob->query("equip_group_name") ||"套路一") + "装备组合");
    result["data"]["is_title"] = "equip_group switch " + (ob->query("equip_group_name") || "套路一");
    result["data"]["info"] = generate_equipment_info(ob);

    result["data"]["contronl_equip_actions"] = ({(["cmd": "summon all", "text": "装备召唤"])});
    result["data"]["contronl_equip_actions"] += ({(["cmd": "wear all", "text": "穿戴所有"])});
    result["data"]["contronl_equip_actions"] += ({(["cmd": "remove all", "text": "卸下所有"])});
    
    foreach (type in armNameMapList) {
        obj = (type == "weapon") ? ob->query_temp("weapon") : ob->query_temp("armor/" + type);

        result["data"]["choose_equip_buttons"] += ({([
            "cmd": "wear_popup " + type,
            "unique_id": "wear_" + type,
            "text": armNameMapEnlish[type] + ZJBR + (obj ? (obj->query("name")) : "空"),
        ])});
    }
    
    return json_encode(result);
}

// 主函数
int main(object me, string arg) {
    string json_result;
    
    if (!me) return 0;

    // 如果装备界面被禁用，则不显示，no_equip_ui是在equip_group（切换套路）命令中设置的。
    if (me->query_temp("no_equip_ui")) {
        return 1;
    }
    
    json_result = generate_equipment_ui(me);
    tell_object(me, json_result + "\n");
    return 1;
}