// 函数原型声明
void show_main_shop(object me);
int exchange_item(object me, string item_id, int quantity);
mapping get_shop_items();

// 活动时间定义
#define ACTIVITY_START 1756629606  // 2025-09-01 00:00:00
#define ACTIVITY_END   1758098406  // 2025-09-16 23:59:59

/**
 * @brief 检查是否在活动期间
 * @return int 1-在活动期间，0-不在活动期间
 */
int is_in_activity_period()
{
    return (time() >= ACTIVITY_START && time() <= ACTIVITY_END);
    // return 1; // 测试期间可以打开此行
}

