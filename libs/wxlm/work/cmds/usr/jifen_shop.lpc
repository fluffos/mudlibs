/**
 * @brief 主函数入口
 * @param object me 玩家对象
 * @param string arg 参数
 * @return int 执行结果
 */
int main(object me, string arg)
{
    string item_id;
    int quantity = 1;
    
    if (!arg)
    {
        show_main_shop(me);
        return 1;
    }

    if (sscanf(arg, "%s %d", item_id, quantity) != 2)
    {
        item_id = arg;
        quantity = 1;
    }

    return exchange_item(me, item_id, quantity);
}

/**
 * @brief 显示商店主界面
 * @param object me 玩家对象
 */
void show_main_shop(object me)
{
    string msg;
    int current_jifen;
    string *buttons = ({});
    
    current_jifen = me->query("jiuyue_autumn_jifen");
    
    msg = HIY "【九月秋季限时积分商店】\n" NOR;
    msg += sprintf(HIC "当前限时积分：%d\n" NOR, current_jifen);
    
    if (is_in_activity_period())
    {
        msg += HIG "活动进行中，快来兑换心仪物品！\n" NOR;
    }
    else
    {
        msg += HIR "活动已结束，限时积分将转换为贡献积分\n" NOR;
    }
    
    msg += "──────────────────────────\n";
    
    // 1000积分物品
    msg += HIR "【1000积分物品】\n" NOR;
    msg += "五彩神石、意境卷轴、紫色真意自选宝箱\n\n";
    
    // 800积分物品  
    msg += HIY "【800积分物品】\n" NOR;
    msg += "黄色真意自选宝箱、防具材料自选宝箱×2\n";
    msg += "冲脉丹宝箱×10、炼体丹自选宝箱×5\n\n";
    
    // 500积分物品
    msg += HIM "【500积分物品】\n" NOR;
    msg += "冲脉丹宝箱×8、炼体丹自选宝箱×3\n";
    msg += "红色真意自选宝箱\n\n";
    
    // 50积分物品
    msg += HIC "【50积分物品】\n" NOR;
    msg += "雾雨灵茶×5、五藏归元丹×5、九转金丹×5\n";
    msg += "秘传自选宝箱×5\n\n";
    
    // 10积分物品
    msg += HIG "【10积分物品】\n" NOR;
    msg += "九转金丹(假)、菩提子×5、福寿膏×5\n";
    msg += "千年灵芝×5、四大属性丹、词符×10\n";
    
    msg += "──────────────────────────\n";

    // 构建按钮
    buttons = ({
        "1000积分:jifen_shop_category 1000",
        "800积分:jifen_shop_category 800", 
        "500积分:jifen_shop_category 500",
        "50积分:jifen_shop_category 50",
        "10积分:jifen_shop_category 10",
        "返回:limited_draw"
    });

    tell_object(me, popup_comb(msg, buttons));
}

/**
 * @brief 兑换物品
 * @param object me 玩家对象
 * @param string item_id 物品ID
 * @param int quantity 兑换数量
 * @return int 执行结果
 */
int exchange_item(object me, string item_id, int quantity)
{
    mapping item_info;
    object item;
    int current_jifen, total_cost, i;
    string msg;
    
    if (!shop_items[item_id])
    {
        write(popup_comb("无效的物品ID！", ({"返回:jifen_shop"})));
        return 1;
    }
    
    item_info = shop_items[item_id];
    current_jifen = me->query("jiuyue_autumn_jifen");
    total_cost = item_info["cost"] * quantity;
    
    if (current_jifen < total_cost)
    {
        msg = HIR "【兑换失败】\n" NOR;
        msg += sprintf("积分不足！需要%d积分，当前只有%d积分。\n", total_cost, current_jifen);
        write(popup_comb(msg, ({"返回:jifen_shop"})));
        return 1;
    }
    
    // 检查背包空间
    if (sizeof(all_inventory(me)) >= 390)
    {
        msg = HIR "【兑换失败】\n" NOR;
        msg += "背包空间不足，请先整理背包！\n";
        write(popup_comb(msg, ({"返回:jifen_shop"})));
        return 1;
    }
    
    // 扣除积分
    me->add("jiuyue_autumn_jifen", -total_cost);
    
    // 创建物品
    for (i = 0; i < quantity; i++)
    {
        item = new_bind(item_info["path"]);
        if (objectp(item))
        {
            // 处理数量
            int item_quantity = item_info["quantity"] || 1;
            if (item_quantity > 1 && item->query("base_unit"))
            {
                item->set_amount(item_quantity);
            }
            else if (item_quantity > 1)
            {
                // 不可叠加物品需要循环创建
                item->move(me);
                for (int j = 1; j < item_quantity; j++)
                {
                    object extra_item = new_bind(item_info["path"]);
                    if (extra_item) extra_item->move(me);
                }
                continue; // 跳过下面的move
            }
            
            item->move(me);
        }
    }
    
    msg = HIY "【兑换成功】\n" NOR;
    msg += sprintf("恭喜您兑换了%d个%s！\n", quantity, item_info["name"]);
    msg += sprintf("消耗%d限时积分\n", total_cost);
    msg += sprintf(HIC "当前剩余积分：%d\n" NOR, me->query("jiuyue_autumn_jifen"));
    
    write(popup_comb(msg, ({"继续兑换:jifen_shop", "返回抽奖:limited_draw"})));
    
    // 记录日志
    log_file("jifen_shop", sprintf("%s %s(%s) 兑换了%d个%s，消耗%d积分\n", 
        ctime(time()), me->name(), me->query("id"), quantity, item_info["name"], total_cost));
    
    return 1;
}

/**
 * @brief 获取商店物品配置
 * @return mapping 商店物品映射
 */
mapping get_shop_items()
{
    return shop_items;
}