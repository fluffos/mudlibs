int main(object me, string arg)
{
    object pop1;
    string msg;
    pop1 = new(POP1);


    if (!arg)
    {
        msg = "又是需要练功的一天，大侠你要干什么呢？\n";    

        pop1->basic(msg, 2);
        pop1->add_button("更新公告历史", "updates");
        //战斗设置
        pop1->add_button("战斗功能设置", "set combatd");
        //内功
        pop1->add_button("内功功能使用", "common_order force");
        //任务采集设置
        pop1->add_button("任务采集设置", "common_order auto");
        //玩家队伍设置
        pop1->add_button("玩家队伍设置", "team");



        //排行榜
        pop1->add_button("全服排行系统", "new_tops");

        //炼药系统
        pop1->add_button("丹药炼制系统", "make");
        //贴吧昵称绑定
        pop1->add_button("贴吧昵称绑定", "tieba");
        //贴吧签到
        pop1->add_button("贴吧奖励领取", "tieba_day");

        //PK匹配
        pop1->add_button("PK匹配系统", "match_pk");

        //游戏攻略
        pop1->add_button("游戏攻略", "gonglue");
        pop1->add_button("感悟刻字", "kezi");

        if(me->query("env/disturb") == 0)
        {
            pop1->add_button("勿扰模式", "set disturb 1");
        }
        else
        {
            pop1->add_button("取消勿扰", "set disturb 0");
        }

        write(pop1->result() + "\n");
    }

    if (arg == "auto")
    {
        
        msg = "自动捡钱是否开启：" + (me->query("env/money") ? "是" : "否") + "\n";
        msg += "自动捡卡是否开启：" + (me->query("env/lack") ? "是" : "否") + "\n";
        msg += "自动捡装备是否开启：" + (me->query("env/equip") ? "是" : "否") + "\n";
        msg += "自动钓鱼是否开启：" + (me->query("env/auto_fish") ? "是" : "否") + "\n";
        msg += "自动卖鱼是否开启：" + (me->query("env/auto_sell_fish") ? "是" : "否") + "\n";

        pop1->basic(msg, 2);
        //召唤武器
        pop1->add_button("召唤自制装备", "summon all");
        //自动捡钱env/money
        if(me->query("env/money") == 0)
        {
            pop1->add_button("开启自动捡钱", "set money 1");
        }
        else
        {
            pop1->add_button("关闭自动捡钱", "set money 0");
        }
        //自动捡卡env/lack
        if(me->query("env/lack") == 0)
        {
            pop1->add_button("开启自动捡卡", "set lack 1");
        }
        else
        {
            pop1->add_button("关闭自动捡卡", "set lack 0");
        }
        //自动捡装备env/equip
        if(me->query("env/equip") == 0)
        {
            pop1->add_button("开启自动捡装备", "set equip 1");
        }
        else
        {
            pop1->add_button("关闭自动捡装备", "set equip 0");
        }

        //自动钓鱼env/auto_fish
        if(me->query("env/auto_fish") == 0)
        {
            pop1->add_button("开启自动钓鱼", "set auto_fish 1");
        }
        else
        {
            pop1->add_button("关闭自动钓鱼", "set auto_fish 0");
        }

        //自动卖鱼env/auto_sell_fish
        if(me->query("env/auto_sell_fish") == 0)
        {
            pop1->add_button("开启自动卖鱼", "set auto_sell_fish 1");
        }
        else
        {
            pop1->add_button("关闭自动卖鱼", "set auto_sell_fish 0");
        }

        // 返回
        pop1->add_button("返回到主菜单", "common_order");

        write(pop1->result() + "\n");

        return 1;

    }

    if (arg == "force")
    {
        msg = "你要使用你的内功做什么？\n";    
        pop1->basic(msg, 2);
        pop1->add_button("打坐", "dazuo");
        pop1->add_button("吐纳", "tuna");
        pop1->add_button("恢复", "all_recover");
        pop1->add_button("疗疾", "exert dispel");

        write(pop1->result() + "\n");

        return 1;
    }



    return 1;
}