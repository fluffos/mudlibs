// wimpy.c

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg)
{
	// int wmp;

	// if( !arg ) {
	// 	write(INPUTTXT("你现在的当「气」低於 " + (int)me->query("env/wimpy") 
	// 		+ "% 时就会尝试自动吃药。","wimpy $txt#") + "\n");
	// 	return 1;
	// }


	// 设置自动回内，自动回精，自动回气的百分比
	// set auto_huijing 百分比
	// set auto_huiqi 百分比
	// set auto_huinei 百分比

	int wmp;
	string *buttons;
	string type;
	string msg;

	//如果没有参数，选择显示当前设置
	if (!arg)
	{
		msg = "你目前设定的自动吃药设置有：\n";
		msg += sprintf("自动回内：%d%%\n", me->query("env/auto_huinei"));
		msg += sprintf("自动回精：%d%%\n", me->query("env/auto_huijing"));
		msg += sprintf("自动回气：%d%%\n", me->query("env/auto_huiqi"));
		
		buttons = ({ "设置自动回内:set_auto_eat_yao auto_huinei","设置自动回精:set_auto_eat_yao auto_huijing","设置自动回气:set_auto_eat_yao auto_huiqi" });
		write(popup_comb(msg,buttons));
		return 1;
	}



	//如果有两个参数，设置自动吃药的百分比
	if (sscanf(arg, "%s %d", type, wmp) == 2) 
	{
		if (wmp < 0 || wmp > 100)
		{
			write("百分比必须在0到100之间。\n");
			return 1;
		}

		if (type == "auto_huinei")
		{
			me->set("env/auto_huinei", wmp);
			write("自动回内设置为：" + wmp + "%。\n");
		}
		else if (type == "auto_huijing")
		{
			me->set("env/auto_huijing", wmp);
			write("自动回精设置为：" + wmp + "%。\n");
		}
		else if (type == "auto_huiqi")
		{
			me->set("env/auto_huiqi", wmp);
			write("自动回气设置为：" + wmp + "%。\n");
		}
		else
		{
			write("你只能设置自动回内，自动回精，自动回气。\n");
			return 1;
		}
	}
	else
	if (sscanf(arg, "%s", type) == 1)
	{
		string *types = ({ "auto_huinei", "auto_huijing", "auto_huiqi" });
		mapping types_map = ([ "auto_huinei": "自动回内", "auto_huijing": "自动回精", "auto_huiqi": "自动回气" ]);
		if (member_array(type, types) == -1)
		{
			write("你只能设置自动回内，自动回精，自动回气。\n");
			return 1;
		}

		write(INPUTTXT("请输入要设置的" + types_map[type] +  "百分比：","set_auto_eat_yao " + type + " $txt#") + "\n");

		return 1;
	}

	return 1;
	// write(msg);

	


}


