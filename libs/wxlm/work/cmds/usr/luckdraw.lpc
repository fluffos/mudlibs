// luckdraw.c
// Design By Lude
#define PITY_GEM 100    // 珍贵物品保底次数
#define DAILY_LIMIT 50  // 每日抽奖次数限制

// 稀有度颜色
#define COLOR_GEM   HIR  // 最贵物品 (红色)
#define COLOR_SKILL HIY  // 技能 (黄色)
#define COLOR_OB    HIM  // 珍贵物品 (品红)
#define COLOR_PT    HIG  // 普通物品 (绿色)

// 函数原型
void show_main_ui(object me);
void show_prize_pool(object me);
mapping do_single_draw(object me);
int process_single_draw(object me, string currency_type);
int process_ten_draw(object me, string currency_type);
int process_combine_cards(object me);

// 检查每日抽奖次数限制
int check_daily_limit(object me)
{
    int last_draw_time = me->query("last_draw_time");
    int today_draws = me->query("today_draws");

    if (time() / 86400 != last_draw_time / 86400)
    {
        me->set("today_draws", 0);
        today_draws = 0;
    }

    if (today_draws >= DAILY_LIMIT)
        return 0;

    return 1;
}

// 物品类型及其对应的权重
mapping item_types = ([
    "gem_list": 2,
    "skill_list": 5,
    "ob_list": 8,
    "pt_list": 85,
]);

// 物品列表
mapping items = ([
    "gem_list": ({
        "/clone/aoyi_book/aoyi_book",
    }),
    "skill_list": ({
        "qishang-quan", "baihua-quan", "hanbing-mianzhang", "xuanming-zhang", "sougu",
        "zhuihun-jian", "yunlong-bian", "hanxing-bada", "bizhen-qingzhang", "huanyin-zhi",
        "ningxue-shenzhao", "sanfen-jianshu", "zijinbagua-dao",
    }),
    "pt_list": ({
        "/clone/vip/book_tianfu", "/clone/vip/book_wuliang",
        "/clone/vip/dan_qingxin", 
        // "/clone/vip/dan_zhengqi",
        "/clone/vip/fushougao", "/clone/vip/jinsha", "/clone/vip/lingzhi",
        "/clone/vip/lingzhi2", "/clone/vip/putao", "/clone/vip/tianxiang",
        "/clone/vip/yanzhi", "/clone/vip/yanzhi2",
        //  "/clone/vip/zyao1",
        "/clone/aoyi_book/aoyi_book_canye",
        "/clone/vip/yixun_tu", "/clone/vip/baijia_baoxia",
        "/system/wusheng/obj/dipi",
        "/system/wusheng/obj/longgan",
        "/system/wusheng/obj/tianfei",
        "/system/wusheng/obj/xianshen",
        "/system/wusheng/obj/xuecanguo",
        "/clone/vip/putao1",
    }),
    "ob_list": ({
        "/clone/vip/avipcard", "/clone/vip/bianxingdan", "/clone/vip/butian",
        "/clone/vip/card_name", "clone/vip/dan_bianxing", "/clone/vip/dan_chongsu",
        "/clone/vip/dan_wangyou",  "/clone/vip/jinpiao",
        "/clone/vip/tiancs", "/clone/vip/wujins",
        "/clone/vip/xidianka",
        "/clone/vip/dan_jiuzhuan",
        "/clone/vip/dan_wuyu",
        "/clone/vip/dan_guiyuan"
    }),
]);

int main(object me, string arg)
{
    if (!arg)
    {
        show_main_ui(me);
        return 1;
    }

    if (!check_daily_limit(me) && arg != "show_pool")
    {
        write(popup_comb("你今日的抽奖次数已达上限，请明天再来！", ({"确定:look"})));
        return 1;
    }

    switch(arg)
    {
        case "yuanbao":
        case "bind_yuanbao":
        case "one":
            return process_single_draw(me, arg);
        case "yuanbao_sl":
        case "bind_yuanbao_sl":
        case "ten":
            return process_ten_draw(me, arg);
        case "show_pool":
            show_prize_pool(me);
            return 1;
        case "combine":
            return process_combine_cards(me);
        default:
            write(popup_comb("参数错误。", ({"返回:luckdraw"})));
            return 1;
    }
    return 1;
}

void show_main_ui(object me)
{
    string msg;
    object one_card, ten_card;
    int one_card_amount = 0, ten_card_amount = 0;
    string* buttons;
    int jifen;
    
    one_card = present("one card", me);
    ten_card = present("ten card", me);

    if (objectp(one_card)) one_card_amount = one_card->query_amount();
    if (objectp(ten_card)) ten_card_amount = ten_card->query_amount();

    jifen = me->query("jiuyue_autumn_jifen");

    msg = HIR"【幸运抽奖】"NOR"\n";
    msg += "──────────────────────────\n";
    msg += "奖池当前有百分之二的几率抽到"HIR"意境卷轴"NOR"\n百分之五的概率抽到"HIY"技能"NOR"\n百分之八的概率抽到"HIM"珍贵物品"NOR"\n百分之八十五的概率抽到"HIG"普通物品"NOR"。\n";
    msg += "──────────────────────────\n";
    msg += "100元宝抽一次, 1000元宝十连。\n";
    msg += "建议经验足够技能提升到180级再进行抽奖！\n";
    msg += "否则抽到公共技能下线等级会掉！！\n";
    msg += "建议抽到技能后到铁匠处进行离线挂机防止掉线！！\n";
    msg += HIY"每次抽奖可获得限时积分！"NOR"\n";
    msg += "──────────────────────────\n";
    msg += sprintf("元宝: %-10d 绑定元宝: %d\n", me->query("yuanbao"), me->query("bind_yuanbao"));
    msg += sprintf("单抽卡: %-8d 十连抽卡: %d\n", one_card_amount, ten_card_amount);
    msg += sprintf("限时积分: %-6d 今日已抽: %d / %d 次\n", jifen, me->query("today_draws"), DAILY_LIMIT);
    msg += sprintf("保底累计: "HIY"%d"NOR" / %d 次\n", me->query("luckdraw_count"), PITY_GEM);
    msg += "──────────────────────────\n";

    buttons = ({
        "元宝单抽:luckdraw yuanbao", "元宝十连:luckdraw yuanbao_sl",
        "绑元单抽:luckdraw bind_yuanbao", "绑元十连:luckdraw bind_yuanbao_sl",
        "使用单抽卡:luckdraw one", "使用十连卡:luckdraw ten",
        "合成十连卡:luckdraw combine", "查看奖池:luckdraw show_pool",
        "积分商店:jifen_shop"
    });

    tell_object(me, popup_comb(msg, buttons));
}

/**
 * @brief 处理单次抽奖奖励生成
 * @param me 玩家对象，参与本次抽奖的参与者
 * @return prize 奖励映射，包含物品名称、类型、颜色等属性
 * @details 
 * 1. 根据玩家已抽奖次数判断是否触发保底机制（当达到PITY_GEM次数时强制获取 gem_list）
 * 2. 通过权重随机算法从item_types配置中选取当前抽奖类型（非保底状态）
 * 3. 针对技能类奖励（skill_list）实施防重复机制：
 *    - 首次获取时自动生成中文技能名（item_name = to_chinese(item_path)）
 *    - 后续获取时通过动态重选（item_path = item_list[random(...)]) 确保技能不重复
 * 4. 奖励属性包含：
 *    - name：物品/技能的中文名称
 *    - id：对应物品/技能的路径标识符
 *    - type：物品类型（gem_list/skill_list/ob_list）
 *    - color：对应类型的标准颜色值（通过switch语句动态赋值）
 * 5. 该机制确保每次抽奖结果既符合配置权重，又能通过保底和防重复设计提升玩家体验
 */
mapping do_single_draw(object me)
{
    string item_type, item_path, item_name, item_color;
    int total_weight = 0, current_weight = 0, random_num;
    mapping prize;
    string *item_list;
    me->add("luckdraw_count", 1);

    if (me->query("luckdraw_count") >= PITY_GEM)
    {
        item_type = "gem_list";
    }
    else
    {
        foreach (string type in keys(item_types))
            total_weight += item_types[type];

        random_num = random(total_weight);

        foreach (string type in keys(item_types))
        {
            current_weight += item_types[type];
            if (random_num < current_weight)
            {
                item_type = type;
                break;
            }
        }
    }

    item_list = items[item_type];
    item_path = item_list[random(sizeof(item_list))];

    switch(item_type)
    {
        case "gem_list": item_color = COLOR_GEM; break;
        case "skill_list": item_color = COLOR_SKILL; break;
        case "ob_list": item_color = COLOR_OB; break;
        default: item_color = COLOR_PT; break;
    }

    if (item_type == "skill_list")
    {
        mapping skills = me->query_skills();
        string *my_skills = ({});
        string *pool_skills = items["skill_list"];
        string *unowned_skills = ({});
        
        if (mapp(skills))
        {
            my_skills = keys(skills);
        }
        // 筛选出玩家未拥有的技能
        foreach (string skill in pool_skills)
        {
            if (member_array(skill, my_skills) == -1)
            {
                unowned_skills += ({ skill });
            }
        }

        // 如果玩家已经拥有奖池中的所有技能，则将奖励降级为普通物品
        if (sizeof(unowned_skills) == 0)
        {
            item_type = "pt_list";
            item_list = items[item_type];
            item_path = item_list[random(sizeof(item_list))];
            item_name = call_other(item_path, "query", "name");
            item_color = COLOR_PT; // 修正奖励颜色
        }
        else
        {
            // 从玩家未拥有的技能列表中随机抽取一个
            item_path = unowned_skills[random(sizeof(unowned_skills))];
            item_name = to_chinese(item_path);
        }
    }
    else
    {
        item_name = call_other(item_path, "query", "name");
    }

    prize = ([
        "name" : item_name,
        "id"   : item_path,
        "type" : item_type,
        "color": item_color
    ]);

    return prize;
}

/**
 * @brief 处理单次幸运抽奖流程
 * @param object me 当前操作者对象
 * @param string currency_type 抽奖所需货币类型（yuanbao/bind_yuanbao/one）
 * @return int 1（抽奖成功）或1（参数验证失败）
 * @details 
 * 本函数采用分层设计实现三个核心目标：
 * 1. 货币校验与消耗：通过switch-case实现不同货币类型的独立校验逻辑，避免耦合
 * 2. 抽奖次数控制：通过last_draw_time和today_draws实现每日1次+实时冷却的双重限制
 * 3. 成果差异化处理：根据prize类型区分技能习得和物品获得，其中：
 *    - 技能类：自动提升技能等级至满级（180），并触发全服广播
 *    - 物品类：创建绑定物品，根据类型（gem_list/ob_list）调整广播文案
 * 该设计确保：
 * 1. 货币体系扩展性：新增货币类型只需添加case分支
 * 2. 防沉迷机制：双时间戳校验避免重复抽奖
 * 3. 系统日志完整性：完整记录抽奖时间、用户ID和奖品信息
 * 4. 角色体验优化：通过 popup_comb 实现交互式消息提示
 */
int process_single_draw(object me, string currency_type)
{
    mapping prize;
    object ob;

    switch(currency_type)
    {
        case "yuanbao":
            if (me->query("yuanbao") < 100) {
                write(popup_comb("元宝不足！", ({"确定:luckdraw"})));
                return 1;
            }
            me->add("yuanbao", -100);
            break;
        case "bind_yuanbao":
            if (me->query("bind_yuanbao") < 200) {
                write(popup_comb("绑定元宝不足！", ({"确定:luckdraw"})));
                return 1;
            }
            me->add("bind_yuanbao", -200);
            break;
        case "one":
            ob = present("one card", me);
            if (!objectp(ob) || ob->query_amount() < 1) {
                write(popup_comb("单抽卡不足！", ({"确定:luckdraw"})));
                return 1;
            }
            ob->add_amount(-1);
            break;
    }

    me->set("last_draw_time", time());
    me->add("today_draws", 1);
    me->add("jiuyue_autumn_jifen", 1);  // 增加1点限时积分

    prize = do_single_draw(me);

    if (prize["type"] == "skill_list")
    {
        me->set_skill(prize["id"], 180);
        log_file("luckdraw", sprintf("%s %s(%s) 抽到技能 %s\n", ctime(time()), me->name(), me->query("id"), prize["name"]));
        CHANNEL_D->do_channel(this_object(), "rumor", me->name() + "在幸运抽奖中抽到了一个技能【" + prize["color"] + prize["name"] + NOR + "】!");
    }
    else
    {
        ob = new_bind(prize["id"]);
        if (objectp(ob))
        {
            ob->move(me);
            log_file("luckdraw", sprintf("%s %s(%s) 抽到物品 %s\n", ctime(time()), me->name(), me->query("id"), prize["name"]));
            if (prize["type"] == "gem_list" || prize["type"] == "ob_list")
            {
                CHANNEL_D->do_channel(this_object(), "rumor", me->name() + "在幸运抽奖中抽到了珍稀物品【" + prize["color"] + prize["name"] + NOR + "】!");
            }
        }
    }
    
    if (prize["type"] == "gem_list")
    {
        me->set("luckdraw_count", 0);
    }

    tell_object(me, popup_comb("恭喜您获得：\n\n" + prize["color"] + "【" + prize["name"] + "】" + NOR + "\n\n获得1点限时积分！", ({"确定:luckdraw"})));
    return 1;
}

/**
 * @brief 处理十连抽奖逻辑
 * @param object me 当前操作者对象
 * @param string currency_type 抽奖货币类型（yuanbao_sl/bind_yuanbao_sl/ten）
 * @return int 执行结果（1=成功）
 * @details 该设计采用分层处理机制实现以下核心目标：
 * 1. 资源消耗控制：通过不同货币类型设置差异化消耗（1000元宝/2000绑定元宝/消耗十连卡），平衡不同渠道的抽奖频率
 * 2. 抽奖次数验证：强制检查资源持有量，防止无效抽奖操作
 * 3. 奖励类型分离：区分技能和物品两种奖励类型，采用不同生成逻辑
 * 4. 奖励展示优化：通过结果列表和频道广播实现双渠道通知
 * 5. 系统追溯机制：记录抽奖日志并附加时间戳和玩家ID，便于后续审计
 * 6. 频率限制设计：每次十连抽自动重置当日抽奖次数，防止刷取
 * 7. 交互体验增强：使用 popup_comb 实现更友好的弹窗提示
 */
int process_ten_draw(object me, string currency_type)
{
    mapping prize;
    object ob;
    string* results = ({});
    string msg = "十连抽结果：\n\n";
    string log_msg = "";

    switch(currency_type)
    {
        case "yuanbao_sl":
            if (me->query("yuanbao") < 1000) {
                write(popup_comb("元宝不足！", ({"确定:luckdraw"})));
                return 1;
            }
            me->add("yuanbao", -1000);
            break;
        case "bind_yuanbao_sl":
            if (me->query("bind_yuanbao") < 2000) {
                write(popup_comb("绑定元宝不足！", ({"确定:luckdraw"})));
                return 1;
            }
            me->add("bind_yuanbao", -2000);
            break;
        case "ten":
            ob = present("ten card", me);
            if (!objectp(ob) || ob->query_amount() < 1) {
                write(popup_comb("十连抽卡不足！", ({"确定:luckdraw"})));
                return 1;
            }
            ob->add_amount(-1);
            break;
    }

    me->set("last_draw_time", time());
    me->add("today_draws", 10); // 假设十连算10次
    me->add("jiuyue_autumn_jifen", 10);  // 增加10点限时积分

    for (int i = 0; i < 10; i++)
    {
        prize = do_single_draw(me);

        if (prize["type"] == "skill_list")
        {
            me->set_skill(prize["id"], 180);
            log_msg += sprintf("%s %s(%s) 抽到技能 %s\n", ctime(time()), me->name(), me->query("id"), prize["name"]);
            CHANNEL_D->do_channel(this_object(), "rumor", me->name() + "在幸运抽奖中抽到了一个技能【" + prize["color"] + prize["name"] + NOR + "】!");
        }
        else
        {
            ob = new_bind(prize["id"]);
            if (objectp(ob))
            {
                ob->move(me);
                log_msg += sprintf("%s %s(%s) 抽到物品 %s\n", ctime(time()), me->name(), me->query("id"), prize["name"]);
                if (prize["type"] == "gem_list" || prize["type"] == "ob_list")
                {
                    CHANNEL_D->do_channel(this_object(), "rumor", me->name() + "在幸运抽奖中抽到了珍稀物品【" + prize["color"] + prize["name"] + NOR + "】!");
                }
            }
        }
        
        if (prize["type"] == "gem_list")
        {
            me->set("luckdraw_count", 0);
        }
        
        results += ({ prize["color"] + "【" + prize["name"] + "】" + NOR });
    }

    if(strlen(log_msg) > 0)
    {
        log_file("luckdraw", log_msg);
    }

    for(int i = 0; i < sizeof(results); i++)
    {
        msg += sprintf("%d. %s\n", i + 1, results[i]);
    }
    
    msg += "\n获得10点限时积分！";

    tell_object(me, popup_comb(msg, ({"确定:luckdraw"})));
    return 1;
}

void show_prize_pool(object me)
{
    string str = "          抽奖奖池"NOR"\n";
    str += "──────────────────────────\n";
    
    str += COLOR_GEM + "意境卷轴 (2%)\n" + NOR;
    foreach (string item in items["gem_list"])
        str += "  " + call_other(item, "query", "name") + "\n";
    
    str += COLOR_SKILL + "\n技能 (5%)\n" + NOR;
    foreach (string skill in items["skill_list"])
        str += "  " + to_chinese(skill) + "\n";
    
    str += COLOR_OB + "\n珍贵物品 (8%)\n" + NOR;
    foreach (string item in items["ob_list"])
        str += "  " + call_other(item, "query", "name") + "\n";
    
    str += COLOR_PT + "\n普通物品 (85%)\n" + NOR;
    foreach (string item in items["pt_list"])
        str += "  " + call_other(item, "query", "name") + "\n";

    str += "──────────────────────────\n";

    tell_object(me, popup_comb(str, "返回:luckdraw"));
}

/**
 * @brief 处理单抽卡合成十连抽卡功能
 * @param object me 当前操作者对象
 * @return int 1（合成成功或失败）
 * @details 
 * 该函数实现10张单抽卡合成1张十连抽卡的功能：
 * 1. 检查玩家是否拥有足够的单抽卡（至少10张）
 * 2. 消耗10张单抽卡
 * 3. 生成1张十连抽卡并添加到玩家背包
 * 4. 显示合成结果提示信息
 */
int process_combine_cards(object me)
{
    object one_card, ten_card;
    int one_card_amount;
    
    one_card = present("one card", me);
    
    if (!objectp(one_card))
    {
        write(popup_comb("你没有单抽卡！", ({"返回:luckdraw"})));
        return 1;
    }
    
    one_card_amount = one_card->query_amount();
    
    if (one_card_amount < 10)
    {
        write(popup_comb(sprintf("单抽卡数量不足！需要10张，你只有%d张。", one_card_amount), ({"返回:luckdraw"})));
        return 1;
    }
    
    // 消耗10张单抽卡
    one_card->add_amount(-10);
    
    // 生成1张十连抽卡
    ten_card = present("ten card", me);
    if (objectp(ten_card))
    {
        ten_card->add_amount(1);
    }
    else
    {
        ten_card = new_bind("/clone/baiyi/tencard");
        if (objectp(ten_card))
        {
            ten_card->move(me);
        }
    }
    
    write(popup_comb("合成成功！消耗10张单抽卡，获得1张十连抽卡。", ({"返回:luckdraw"})));
    log_file("luckdraw", sprintf("%s %s(%s) 合成了1张十连抽卡\n", ctime(time()), me->name(), me->query("id")));
    
    return 1;
}

// 外部函数调用
mapping query_items() { return items; }
string *get_skill_ids() { return items["skill_list"]; }