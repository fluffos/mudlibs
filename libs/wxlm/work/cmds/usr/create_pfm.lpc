}

// 新增：处理真实伤害出招描述
int handle_action_desc_real(object me, string arg)
{
    string pfm_id, action_msg;
    
    if (sscanf(arg, "%s %s", pfm_id, action_msg) != 2)
    {
        tell_object(me, popup_title("参数错误"));
        return 1;
    }
    
    me->set_temp("self_pfm/action_msg", action_msg);
    
    tell_object(me, popup_input("请输入击中描述，如：$N的真气直震$n，$n脸色一白\n支持颜色：$RED$红色$NOR$ $HIY$高亮黄$NOR$ $BLU$蓝色$NOR$ 等",
                              "create_pfm handle_hit_desc_and_start_damage_config_real " + pfm_id + " "));
    return 1;
}

// 新增：处理真实伤害击中描述并开始伤害配置
int handle_hit_desc_and_start_damage_config_real(object me, string arg)
{
    string pfm_id, hit_msg;
    
    if (sscanf(arg, "%s %s", pfm_id, hit_msg) != 2)
    {
        tell_object(me, popup_title("参数错误"));
        return 1;
    }
    
    me->set_temp("self_pfm/hit_msg", hit_msg);

    // 清除临时的伤害选择数据
    me->delete_temp("self_pfm/current_damage_skills");
    me->delete_temp("self_pfm/current_damage_attribute");
    me->delete_temp("self_pfm/damage_selection_count");

    return actual_select_damage_options_real(me, pfm_id);
}

// 新增：实际选择真实伤害的伤害判定选项
int actual_select_damage_options_real(object me, string arg)
{
    string pfm_id = arg;
    mapping pfm_detail, skill_pool, damage_pool;
    string msg, *options = ({});
    string *selected_skills, selected_attribute;
    int selection_count;
    string damage_type;

    pfm_detail = SKILL_MASTER->get_self_skill_detail(me->query("id"), pfm_id);
    if (!pfm_detail)
    {
        tell_object(me, popup_title("未找到指定的招式"));
        return 1;
    }

    skill_pool = SKILL_MASTER->get_skill_pool_attributes(pfm_detail["skill"]);
    if (!skill_pool || !skill_pool["damage"])
    {
        tell_object(me, popup_title("该武学没有定义伤害属性池。"));
        return 1;
    }
    damage_pool = skill_pool["damage"];
    damage_type = me->query_temp("self_pfm/damage_type"); // qi or shen

    selected_skills = me->query_temp("self_pfm/current_damage_skills") || ({});
    selected_attribute = me->query_temp("self_pfm/current_damage_attribute");
    selection_count = me->query_temp("self_pfm/damage_selection_count") || 0;

    msg = "为招式「" + pfm_detail["name"] + "」配置伤害判定（真实伤害 - " + (damage_type == "qi" ? "气血" : "精神") + "）\n";
    msg += "已选 " + selection_count + "/3 项。最多可选3项（技能不限，属性最多1项）。\n\n";
    msg += "请选择伤害判定条件：\n";

    if (damage_pool["skill"] && sizeof(damage_pool["skill"]) > 0)
    {
        foreach (string sk in damage_pool["skill"])
        {
            if (member_array(sk, selected_skills) == -1)
            {
                 options += ({replace_string(to_chinese(sk),"基本","") + "伤害" + ":create_pfm process_damage_selection_real " + pfm_id + " skill " + sk});
            }
        }
    }

    if (!selected_attribute && damage_pool["attribute"] && sizeof(damage_pool["attribute"]) > 0)
    {
        foreach (string attr in damage_pool["attribute"])
        {
            options += ({to_chinese(attr) + "伤害" + ":create_pfm process_damage_selection_real " + pfm_id + " attribute " + attr});
        }
    }

    if (selection_count > 0)
    {
        options += ({"完成伤害配置:create_pfm save_real " + pfm_id + " confirm_damage"});
    }
    options += ({"返回上一步:create_pfm real_type " + pfm_id + " " + damage_type }); // Back to damage type selection for real damage

    if(sizeof(options) == 2 && selection_count == 3) 
    {
        return save_real_action(me, pfm_id + " confirm_damage");
    }
    
    if(sizeof(options) == 2 && selection_count < 3 && member_array("完成伤害配置:create_pfm save_real " + pfm_id + " confirm_damage", options) != -1)
    {
        tell_object(me, popup_comb(msg + "\n已无更多可选伤害条件或已达属性上限。", options));
    }
    else if (sizeof(options) > 2 || (selection_count == 0 && sizeof(options) > 1) )
    {
        tell_object(me, popup_comb(msg, options));
    }
    else
    {
        if (selection_count > 0)
        {
            tell_object(me, popup_comb(msg + "\n已无更多可选伤害条件。", ({
                "完成伤害配置:create_pfm save_real " + pfm_id + " confirm_damage",
                "返回上一步:create_pfm real_type " + pfm_id + " " + damage_type
            })));
        }
        else
        {
            tell_object(me, popup_comb(msg + "\n当前武学没有可配置的伤害条件。将使用默认或无额外伤害设定。", ({
                "继续:create_pfm save_real " + pfm_id + " confirm_damage",
                "返回上一步:create_pfm real_type " + pfm_id + " " + damage_type
            })));
        }
    }
    return 1;
}

// 新增：处理真实伤害的伤害判定选择
int process_damage_selection_real(object me, string arg)
{
    string pfm_id, type, choice;
    string *selected_skills, selected_attribute;
    int selection_count;

    if (sscanf(arg, "%s %s %s", pfm_id, type, choice) != 3)
    {
        tell_object(me, popup_title("伤害选择参数错误"));
        return 1;
    }

    selected_skills = me->query_temp("self_pfm/current_damage_skills") || ({});
    selected_attribute = me->query_temp("self_pfm/current_damage_attribute");
    selection_count = me->query_temp("self_pfm/damage_selection_count") || 0;

    if (selection_count >= 3)
    {
        tell_object(me, popup_title("最多只能选择3个伤害判定条件。"));
        return actual_select_damage_options_real(me, pfm_id);
    }

    if (type == "skill")
    {
        if (member_array(choice, selected_skills) != -1)
        {
            tell_object(me, popup_title("该技能已经选择过了。"));
            return actual_select_damage_options_real(me, pfm_id);
        }
        selected_skills += ({ choice });
        me->set_temp("self_pfm/current_damage_skills", selected_skills);
    }
    else if (type == "attribute")
    {
        if (selected_attribute)
        {
            tell_object(me, popup_title("已经选择了一个属性作为伤害判定条件。"));
            return actual_select_damage_options_real(me, pfm_id);
        }
        me->set_temp("self_pfm/current_damage_attribute", choice);
    }
    else
    {
        tell_object(me, popup_title("未知的伤害判定类型。"));
        return actual_select_damage_options_real(me, pfm_id);
    }

    me->set_temp("self_pfm/damage_selection_count", selection_count + 1);
    return actual_select_damage_options_real(me, pfm_id);
}

// 保存真实伤害动作
int save_real_action(object me, string arg)
{
    string pfm_id, hit_msg_or_confirm; // Changed
    string first_skill, second_choice, second_type, damage_type, action_msg, hit_msg;
    mapping ap_settings, damage_settings, action, pfm_detail;
    string *damage_skills, damage_attribute; // New
    
    if (sscanf(arg, "%s %s", pfm_id, hit_msg_or_confirm) != 2)
    {
        tell_object(me, popup_title("参数错误 (save_real_action)"));
        return 1;
    }

    hit_msg = me->query_temp("self_pfm/hit_msg");
    if (!hit_msg && hit_msg_or_confirm != "confirm_damage") {
        hit_msg = hit_msg_or_confirm;
    } else if (!hit_msg && hit_msg_or_confirm == "confirm_damage") {
        tell_object(me, popup_title("内部错误：未找到击中描述。"));
        return 1;
    }
    if(!stringp(hit_msg) || hit_msg == "")
    {
        tell_object(me, popup_title("无效的击中描述。"));
        return 1;
    }
    
    pfm_detail = SKILL_MASTER->get_self_skill_detail(me->query("id"), pfm_id);
    if (!pfm_detail)
    {
        tell_object(me, popup_title("未找到指定的招式"));
        return 1;
    }
    
    first_skill = me->query_temp("self_pfm/first_skill");
    second_choice = me->query_temp("self_pfm/second_choice");
    second_type = me->query_temp("self_pfm/second_type");
    damage_type = me->query_temp("self_pfm/damage_type");
    action_msg = me->query_temp("self_pfm/action_msg");
    
    if (!first_skill || !second_choice || !second_type || !damage_type || !action_msg)
    {
        tell_object(me, popup_title("请先完成所有选择 (AP/Damage Type)"));
        return 1;
    }
    
    // 创建命中设置 (AP settings)
    ap_settings = ([
        "jiaoli": 1 // Default
    ]);
    ap_settings["skill"] = ({ first_skill });
    if (second_type == "skill")
    {
        ap_settings["skill"] += ({ second_choice });
    }
    else  // second_type == "attribute"
    {
        ap_settings["attribute"] = ({ second_choice });
    }
    
    // 创建伤害设置 (Damage settings) based on player's new choices
    damage_settings = (["jiaoli": 0 ]); // Default, real damage might not use jiaoli traditionally for its own effect part
    damage_skills = me->query_temp("self_pfm/current_damage_skills");
    damage_attribute = me->query_temp("self_pfm/current_damage_attribute");

    if (damage_skills && sizeof(damage_skills) > 0)
    {
        damage_settings["skill"] = damage_skills;
    }
    if (damage_attribute && damage_attribute != "")
    {
        damage_settings["attribute"] = ({ damage_attribute });
    }
    // Note: The `damage_type` (qi/shen) is passed separately to create_real_action

    action = SKILL_MASTER->create_real_action(pfm_detail["skill"], ap_settings, damage_settings, action_msg, damage_type, hit_msg);
    
    if (!action)
    {
        tell_object(me, popup_title("创建真实伤害动作失败"));
        return 1;
    }
    
    if (!SKILL_MASTER->add_action_to_skill(me, pfm_id, action))
    {
        tell_object(me, popup_title("添加动作失败"));
        return 1;
    }
    
    // 清除临时变量
    me->delete_temp("self_pfm/first_skill");
    me->delete_temp("self_pfm/second_choice");
    me->delete_temp("self_pfm/second_type");
    me->delete_temp("self_pfm/damage_type");
    me->delete_temp("self_pfm/action_msg");
    me->delete_temp("self_pfm/hit_msg");
    me->delete_temp("self_pfm/current_damage_skills");
    me->delete_temp("self_pfm/current_damage_attribute");
    me->delete_temp("self_pfm/damage_selection_count");
    
    tell_object(me, popup_comb("成功添加真实伤害动作！",
                             ({"查看招式:create_pfm view " + pfm_id,
                               "返回列表:create_pfm"})));
    return 1;
}

// 升级动作等级
int upgrade_action(object me, string arg)
{
    string pfm_id;
    int action_index;
    
    if (sscanf(arg, "%s %d", pfm_id, action_index) != 2)
    {
        tell_object(me, popup_title("参数错误"));
        return 1;
    }
    
    if (!SKILL_MASTER->upgrade_action_level(me, pfm_id, action_index))
    {
        tell_object(me, popup_title("升级动作失败"));
        return 1;
    }
    
    tell_object(me, popup_comb("成功提升动作等级！",
                             ({"查看招式:create_pfm view " + pfm_id,
                               "返回列表:create_pfm"})));
    return 1;
}

// 查看招式详情
int view_pfm_detail(object me, string pfm_id)
{
    mapping pfm_detail;
    string msg, *buttons = ({});
    int i;
    
    pfm_detail = SKILL_MASTER->get_self_skill_detail(me->query("id"), pfm_id);
    
    if (!pfm_detail)
    {
        tell_object(me, popup_title("未找到指定的招式"));
        return 1;
    }
    
    msg = "招式详情：" + pfm_detail["name"] + "\n";
    msg += "所属武学：" + to_chinese(pfm_detail["skill"]) + "\n";
    // msg += "创建时间：" + ctime(pfm_detail["create_time"]) + "\n\n";
    msg += "动作列表：\n";
    
    if (sizeof(pfm_detail["action"]) < 1)
    {
        msg += "  尚未添加任何动作\n";
    }
    else
    {
        for (i = 0; i < sizeof(pfm_detail["action"]); i++)
        {
            mapping action = pfm_detail["action"][i];
            string type_name;
            
            switch (action["pfm_type"])
            {
            case "single": type_name = "单招"; break;
            case "combo": type_name = "连招"; break;
            case "real": type_name = "真实伤害"; break;
            default: type_name = "未知类型"; break;
            }
            
            msg += sprintf("  %d. [%s] 等级：%d\n", 
                         i + 1, type_name, action["level"]);
            msg += "     出招描述：" + trans_color(action["msg"],2) + "\n";
            if (action["hit_msg"])
                msg += "     击中描述：" + trans_color(action["hit_msg"],2) + "\n";
                
            // 显示AP信息
            if (action["ap"])
            {
                mapping ap = action["ap"];
                msg += "     命中判定：";
                if (ap["skill"] && sizeof(ap["skill"]) > 0)
                {
                    string *skill_names = ({});
                    foreach (string sk in ap["skill"])
                        skill_names += ({ replace_string(to_chinese(sk), "基本", "") + "激发" });
                    msg += implode(skill_names, "、");
                }
                if (ap["attribute"] && sizeof(ap["attribute"]) > 0)
                {
                    string *attr_names = ({});
                    foreach (string attr in ap["attribute"])
                        attr_names += ({ to_chinese(attr) });
                    if (ap["skill"] && sizeof(ap["skill"]) > 0)
                        msg += "、";
                    msg += implode(attr_names, "、");
                }
                msg += "\n";
            }
            
            // 显示DP信息
            if (action["dp"])
            {
                mapping dp = action["dp"];
                msg += "     闪避对抗：";
                if (dp["skill"] && sizeof(dp["skill"]) > 0)
                {
                    string *skill_names = ({});
                    foreach (string sk in dp["skill"])
                        skill_names += ({ replace_string(to_chinese(sk), "基本", "") + "激发" });
                    msg += implode(skill_names, "、");
                }
                if (dp["attribute"] && sizeof(dp["attribute"]) > 0)
                {
                    string *attr_names = ({});
                    foreach (string attr in dp["attribute"])
                        attr_names += ({ to_chinese(attr) });
                    if (dp["skill"] && sizeof(dp["skill"]) > 0)
                        msg += "、";
                    msg += implode(attr_names, "、");
                }
                msg += "\n";
            }

            // 显示伤害配置信息
            if (action["damage"])
            {
                mapping damage_conf = action["damage"];
                int has_damage_skill = 0;
                msg += "     伤害配置：";
                if (damage_conf["skill"] && sizeof(damage_conf["skill"]) > 0)
                {
                    string *skill_names = ({});
                    foreach (string sk in damage_conf["skill"])
                        skill_names += ({ replace_string(to_chinese(sk), "基本", "") + "伤害" });
                    msg += implode(skill_names, "、");
                    has_damage_skill = 1;
                }
                if (damage_conf["attribute"] && sizeof(damage_conf["attribute"]) > 0)
                {
                    string *attr_names = ({});
                    foreach (string attr in damage_conf["attribute"])
                        attr_names += ({ to_chinese(attr) + "伤害" });
                    if (has_damage_skill)
                        msg += "、";
                    msg += implode(attr_names, "、");
                }
                // 如果 Jiaoli 存在且为特定值，也可以显示，但目前设计是0，可能不需显示
                // if (mapp(damage_conf) && !undefinedp(damage_conf["jiaoli"]))
                // {
                //     msg += " (内力影响：" + damage_conf["jiaoli"] + ")";
                // }
                msg += "\n";
            }
        }
    }
    
    buttons += ({"添加动作:create_pfm add " + pfm_id});
    
    if (sizeof(pfm_detail["action"]) > 0)
    {
        buttons += ({"提升第一动作等级:create_pfm upgrade " + pfm_id + " 0"});
    }
    
    buttons += ({"返回列表:create_pfm"});
    
    tell_object(me, popup_comb(msg, buttons));
    return 1;
}

// 帮助信息
int help(object me)
{
    string msg;
    
    msg = "自创招式系统使用说明：\n\n";
    msg += "create_pfm         - 查看已创建的招式列表\n";
    msg += "create_pfm new     - 创建新的自创招式\n";
    msg += "create_pfm add ID  - 为指定招式添加动作\n";
    msg += "create_pfm view ID - 查看招式详情\n";
    msg += "create_pfm help    - 显示此帮助\n\n";
    msg += "自创招式需要满足以下条件：\n";
    msg += "1. 达到三花聚顶境界\n";
    msg += "2. 积累足够的武圣真意\n";
    msg += "3. 所选武学在自创武学池中\n\n";
    msg += "动作类型说明：\n";
    msg += "• 单招：需要选择命中判定条件，系统自动生成对应的闪避对抗\n";
    msg += "• 连招：无需判定条件，直接生效\n";
    msg += "• 真实伤害：需要选择命中判定条件和伤害类型（气血/精神）\n\n";
    msg += "命中判定系统：\n";
    msg += "• 需要选择两个判定条件（武学激发或属性）\n";
    msg += "• 系统会自动为对手生成对应的闪避对抗条件\n";
    msg += "• 对抗规则基于武学相克和属性平衡原理\n\n";
    msg += "支持的颜色标记：\n";
    msg += "$RED$红色$NOR$ $GRN$绿色$NOR$ $YEL$黄色$NOR$ $BLU$蓝色$NOR$ $MAG$紫色$NOR$ $CYN$青色$NOR$ $WHT$白色$NOR$\n";
    msg += "$HIR$高亮红$NOR$ $HIG$高亮绿$NOR$ $HIY$高亮黄$NOR$ $HIB$高亮蓝$NOR$ $HIM$高亮紫$NOR$ $HIC$高亮青$NOR$ $HIW$高亮白$NOR$\n";
    msg += "$BOLD$粗体$NOR$ $BLINK$闪烁$NOR$ $U$下划线$NOR$ $NOR$恢复正常$NOR$\n\n";
    msg += "示例：$HIR$火焰掌$NOR$击向$n，$RED$烈火$NOR$缠绕！\n";
    
    tell_object(me, popup_title(trans_color(msg, 2)));
    return 1;
} 