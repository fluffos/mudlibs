// 自创招式命令文件
inherit F_CLEAN_UP;



#define SKILL_MASTER "/adm/special_ob/create_skill/self_skill_master"

// 函数前向声明
int help(object me);
int main(object me, string arg);
int create_new_pfm(object me, string arg);
int add_action_to_pfm(object me, string arg);
int view_pfm_detail(object me, string arg);
int list_self_pfms(object me);
int add_single_action(object me, string pfm_id);
int add_combo_action(object me, string pfm_id);
int add_real_action(object me, string pfm_id);
int save_combo_action(object me, string arg);
int save_single_action(object me, string arg);
int save_real_action(object me, string arg);
int select_skill(object me, string arg);
int select_attr(object me, string arg);
int select_real_type(object me, string arg);
int upgrade_action(object me, string arg);
int select_first_skill(object me, string arg);
int select_second_skill(object me, string arg);
int select_second_attr(object me, string arg);
int real_first_skill(object me, string arg);
int real_second_skill(object me, string arg);
int real_second_attr(object me, string arg);
int input_hit_msg_single(object me, string arg);
int input_hit_msg_combo(object me, string arg);
int input_hit_msg_real(object me, string arg);

// 新增函数声明
int handle_action_desc_single(object me, string arg);
int handle_hit_desc_and_start_damage_config_single(object me, string arg);
int actual_select_damage_options_single(object me, string arg);
int process_damage_selection_single(object me, string arg);

int handle_action_desc_combo(object me, string arg);
int handle_hit_desc_combo(object me, string arg);

int handle_action_desc_real(object me, string arg);
int handle_hit_desc_and_start_damage_config_real(object me, string arg);
int actual_select_damage_options_real(object me, string arg);
int process_damage_selection_real(object me, string arg);

int main(object me, string arg)
{
    string cmd, param;

    if (!arg || arg == "")
        return list_self_pfms(me);

    if (arg == "help")
        return help(me);

    if (sscanf(arg, "%s %s", cmd, param) != 2)
        cmd = arg;

    switch (cmd)
    {
    case "new":
        return create_new_pfm(me, param);
    case "add":
        return add_action_to_pfm(me, param);
    case "view":
        return view_pfm_detail(me, param);
    case "save_combo":
        return save_combo_action(me, param);
    case "save_single":
        return save_single_action(me, param);
    case "save_real":
        return save_real_action(me, param);
    case "select_first_skill":
        return select_first_skill(me, param);
    case "select_second_skill":
        return select_second_skill(me, param);
    case "select_second_attr":
        return select_second_attr(me, param);
    case "input_hit_msg_single":
        return input_hit_msg_single(me, param);
    case "input_hit_msg_combo":
        return input_hit_msg_combo(me, param);
    case "input_hit_msg_real":
        return input_hit_msg_real(me, param);
    case "real_first_skill":
        return real_first_skill(me, param);
    case "real_second_skill":
        return real_second_skill(me, param);
    case "real_second_attr":
        return real_second_attr(me, param);
    case "real_type":
        return select_real_type(me, param);
    case "upgrade":
        return upgrade_action(me, param);
    case "handle_action_desc_single":
        return handle_action_desc_single(me, param);
    case "handle_hit_desc_and_start_damage_config_single":
        return handle_hit_desc_and_start_damage_config_single(me, param);
    case "actual_select_damage_options_single":
        return actual_select_damage_options_single(me, param);
    case "process_damage_selection_single":
        return process_damage_selection_single(me, param);
    case "handle_action_desc_combo":
        return handle_action_desc_combo(me, param);
    case "handle_hit_desc_combo":
        return handle_hit_desc_combo(me, param);
    case "handle_action_desc_real":
        return handle_action_desc_real(me, param);
    case "handle_hit_desc_and_start_damage_config_real":
        return handle_hit_desc_and_start_damage_config_real(me, param);
    case "actual_select_damage_options_real":
        return actual_select_damage_options_real(me, param);
    case "process_damage_selection_real":
        return process_damage_selection_real(me, param);
    default:
        return help(me);
    }

    return 1;
}

// 列出玩家所有自创招式
int list_self_pfms(object me)
{
    mapping pfms;
    string msg, *pfm_ids, *buttons = ({});
    int i;

    pfms = SKILL_MASTER->get_all_self_skills(me->query("id"));
    if (!pfms || sizeof(pfms) < 1)
    {
        tell_object(me, popup_title("你尚未创建任何自创招式。"));
        return 1;
    }

    pfm_ids = keys(pfms);
    
    msg = "你已创建的自创招式如下：\n\n";

    for (i = 0; i < sizeof(pfm_ids); i++)
    {
        string pfm_id = pfm_ids[i];
        string pfm_name = pfms[pfm_id]["name"];
        string skill_name = pfms[pfm_id]["skill"];
        
        msg += sprintf("%d. %s（%s）\n", i + 1, pfm_name, to_chinese(skill_name));
        buttons += ({sprintf("查看%s:create_pfm view %s", pfm_name, pfm_id)});
    }

    buttons += ({"创建新招式:create_pfm new", "返回:help cmds"});
    
    tell_object(me, popup_comb(msg, buttons));
    return 1;
}

// 创建新的自创招式
int create_new_pfm(object me, string arg)
{
    string skill_name, pfm_name;
    string result;
    
    if (!arg)
    {
        tell_object(me, popup_title("请提供武学名称"));
        return 1;
    }
    
    if (sscanf(arg, "%s %s", skill_name, pfm_name) == 2)
    {
        // 如果已提供武学和招式名称，直接处理
    }
    else
    {
        // 如果只提供了武学名称，弹出输入框让玩家输入招式名称
        skill_name = arg;
        
        // 检查武学是否可用
        if (!SKILL_MASTER->check_skill_in_pool(skill_name))
        {
            tell_object(me, popup_title("该武学不在可自创招式的范围内。"));
            return 1;
        }
        
        tell_object(me, popup_input("请输入招式名称", "create_pfm new " + skill_name + " "));
        return 1;
    }
    
    // 检查条件
    if (!SKILL_MASTER->check_player_condition(me))
    {
        tell_object(me, popup_title("你不满足创建自创招式的条件，需达到三花聚顶境界并积累武圣真意。"));
        return 1;
    }
    
    // 检查武学是否可用
    if (!SKILL_MASTER->check_skill_in_pool(skill_name))
    {
        tell_object(me, popup_title("该武学不在可自创招式的范围内。"));
        return 1;
    }
    
    // 创建招式
    result = SKILL_MASTER->create_self_skill(me, skill_name, pfm_name);
    
    // 修复：检查是否为有效的招式ID
    if (!result || !stringp(result) || result == "保存自创招式数据失败。" || result == "该武学不在可自创招式的范围内。")
    {
        tell_object(me, popup_title("创建失败：" + (stringp(result) ? result : "未知错误")));
        return 1;
    }
    
    tell_object(me, popup_comb("成功创建自创招式「" + pfm_name + "」！\n\n"
                             + "现在可以为招式添加动作。每个招式最多可以有4个动作，\n"
                             + "动作可以是单招、连招或真实伤害类型。",
                             ({"添加动作:create_pfm add " + result, 
                               "返回列表:create_pfm"})));
    return 1;
}

// 为招式添加动作
int add_action_to_pfm(object me, string arg)
{
    string pfm_id, action_type;
    mapping pfm_detail;
    
    if (!arg)
    {
        tell_object(me, popup_title("请指定招式ID"));
        return 1;
    }
    
    if (sscanf(arg, "%s %s", pfm_id, action_type) != 2)
    {
        pfm_id = arg;
        // 显示动作类型选择
        pfm_detail = SKILL_MASTER->get_self_skill_detail(me->query("id"), pfm_id);
        
        if (!pfm_detail)
        {
            tell_object(me, popup_title("未找到指定的招式"));
            return 1;
        }
        
        tell_object(me, popup_comb("请选择要添加的动作类型：",
                                 ({"单招:create_pfm add " + pfm_id + " single",
                                   "连招:create_pfm add " + pfm_id + " combo",
                                   "真实伤害:create_pfm add " + pfm_id + " real",
                                   "返回:create_pfm"})));
        return 1;
    }
    
    // 处理不同动作类型
    switch (action_type)
    {
    case "single":
        return add_single_action(me, pfm_id);
    case "combo":
        return add_combo_action(me, pfm_id);
    case "real":
        return add_real_action(me, pfm_id);
    default:
        tell_object(me, popup_title("未知的动作类型"));
        return 1;
    }
    
    return 1;
}

// 添加单招动作
int add_single_action(object me, string pfm_id)
{
    mapping pfm_detail, skill_pool;
    string skill_name, msg;
    string *skill_options = ({});
    
    pfm_detail = SKILL_MASTER->get_self_skill_detail(me->query("id"), pfm_id);
    if (!pfm_detail)
    {
        tell_object(me, popup_title("未找到指定的招式"));
        return 1;
    }
    
    skill_name = pfm_detail["skill"];
    skill_pool = SKILL_MASTER->get_skill_pool_attributes(skill_name);
    
    if (!skill_pool || member_array("single", skill_pool["pfm_type"]) == -1)
    {
        tell_object(me, popup_title(to_chinese(skill_name) + "不支持单招动作类型"));
        return 1;
    }
    
    // 清除之前的临时数据
    me->delete_temp("self_pfm/first_skill");
    me->delete_temp("self_pfm/second_choice");
    
    // 生成第一次选择的武学列表
    foreach (string sk in skill_pool["ap"]["skill"])
    {
        skill_options += ({replace_string(to_chinese(sk),"基本","") + "激发" + ":create_pfm select_first_skill " + pfm_id + " " + sk});
    }
    
    msg = "为招式「" + pfm_detail["name"] + "」添加单招动作\n\n";
    msg += "命中判定需要选择两个条件：\n";
    msg += "请选择第一个判定条件（武学激发）：\n";
    
    tell_object(me, popup_comb(msg, skill_options + ({"返回:create_pfm add " + pfm_id})));
    return 1;
}

// 选择第一个技能（武学激发）
int select_first_skill(object me, string arg)
{
    string pfm_id, skill;
    mapping pfm_detail, skill_pool;
    string *options = ({}), msg;
    
    if (sscanf(arg, "%s %s", pfm_id, skill) != 2)
    {
        tell_object(me, popup_title("参数错误"));
        return 1;
    }
    
    pfm_detail = SKILL_MASTER->get_self_skill_detail(me->query("id"), pfm_id);
    if (!pfm_detail)
    {
        tell_object(me, popup_title("未找到指定的招式"));
        return 1;
    }
    
    skill_pool = SKILL_MASTER->get_skill_pool_attributes(pfm_detail["skill"]);
    
    // 存储第一次选择的技能
    me->set_temp("self_pfm/first_skill", skill);
    
    // 生成第二次选择的选项
    // 1. 其他武学激发（排除已选择的）
    foreach (string sk in skill_pool["ap"]["skill"])
    {
        if (sk != skill)  // 不能重复选择
        {
            options += ({replace_string(to_chinese(sk),"基本","") + "激发" + ":create_pfm select_second_skill " + pfm_id + " " + sk});
        }
    }
    
    // 2. 属性选择（如果有的话）
    if (skill_pool["ap"]["attribute"] && sizeof(skill_pool["ap"]["attribute"]) > 0)
    {
        foreach (string attr in skill_pool["ap"]["attribute"])
        {
            options += ({to_chinese(attr) + ":create_pfm select_second_attr " + pfm_id + " " + attr});
        }
    }
    
    msg = "已选择" + replace_string(to_chinese(skill),"基本","") + "激发作为第一个判定条件\n\n";
    msg += "请选择第二个判定条件：\n";
    
    tell_object(me, popup_comb(msg, options + ({"返回:create_pfm add " + pfm_id})));
    return 1;
}

// 选择第二个技能（武学激发）
int select_second_skill(object me, string arg)
{
    string pfm_id, skill;
    string first_skill;
    
    if (sscanf(arg, "%s %s", pfm_id, skill) != 2)
    {
        tell_object(me, popup_title("参数错误"));
        return 1;
    }
    
    first_skill = me->query_temp("self_pfm/first_skill");
    if (!first_skill)
    {
        tell_object(me, popup_title("请先选择第一个判定条件"));
        return 1;
    }
    
    // 存储第二次选择（武学）
    me->set_temp("self_pfm/second_choice", skill);
    me->set_temp("self_pfm/second_type", "skill");
    
    tell_object(me, popup_input("请输入出招描述，如：$N一掌击向$n的$l\n支持颜色：$RED$红色$NOR$ $HIY$高亮黄$NOR$ $BLU$蓝色$NOR$ 等",
                              "create_pfm handle_action_desc_single " + pfm_id + " "));
    return 1;
}

// 选择第二个属性
int select_second_attr(object me, string arg)
{
    string pfm_id, attr;
    string first_skill;
    
    if (sscanf(arg, "%s %s", pfm_id, attr) != 2)
    {
        tell_object(me, popup_title("参数错误"));
        return 1;
    }
    
    first_skill = me->query_temp("self_pfm/first_skill");
    if (!first_skill)
    {
        tell_object(me, popup_title("请先选择第一个判定条件"));
        return 1;
    }
    
    // 存储第二次选择（属性）
    me->set_temp("self_pfm/second_choice", attr);
    me->set_temp("self_pfm/second_type", "attribute");
    
    tell_object(me, popup_input("请输入出招描述，如：$N一掌击向$n\n支持颜色：$RED$红色$NOR$ $HIY$高亮黄$NOR$ $BLU$蓝色$NOR$ 等",
                              "create_pfm handle_action_desc_single " + pfm_id + " "));
    return 1;
}

// 输入单招出招描述 (替代 input_hit_msg_single 的第一步)
int handle_action_desc_single(object me, string arg)
{
    string pfm_id, action_msg;
    
    if (sscanf(arg, "%s %s", pfm_id, action_msg) != 2)
    {
        tell_object(me, popup_title("参数错误"));
        return 1;
    }
    
    // 存储出招描述
    me->set_temp("self_pfm/action_msg", action_msg);
    
    tell_object(me, popup_input("请输入击中描述，如：$N这一掌正中$n，$n闷哼一声\n支持颜色：$RED$红色$NOR$ $HIY$高亮黄$NOR$ $BLU$蓝色$NOR$ 等",
                              "create_pfm handle_hit_desc_and_start_damage_config_single " + pfm_id + " "));
    return 1;
}

// 输入单招击中描述并开始伤害配置 (替代 input_hit_msg_single 的第二步)
int handle_hit_desc_and_start_damage_config_single(object me, string arg)
{
    string pfm_id, hit_msg;
    
    if (sscanf(arg, "%s %s", pfm_id, hit_msg) != 2)
    {
        tell_object(me, popup_title("参数错误"));
        return 1;
    }
    
    // 存储击中描述
    me->set_temp("self_pfm/hit_msg", hit_msg);
    
    // 清除临时的伤害选择数据
    me->delete_temp("self_pfm/current_damage_skills");
    me->delete_temp("self_pfm/current_damage_attribute");
    me->delete_temp("self_pfm/damage_selection_count");

    // 跳转到伤害配置选择
    return actual_select_damage_options_single(me, pfm_id);
}

// 实际选择单招伤害判定的选项
int actual_select_damage_options_single(object me, string arg)
{
    string pfm_id = arg; // arg is pfm_id directly passed
    mapping pfm_detail, skill_pool, damage_pool;
    string msg, *options = ({});
    string *selected_skills, selected_attribute;
    int selection_count;

    pfm_detail = SKILL_MASTER->get_self_skill_detail(me->query("id"), pfm_id);
    if (!pfm_detail)
    {
        tell_object(me, popup_title("未找到指定的招式"));
        return 1;
    }

    skill_pool = SKILL_MASTER->get_skill_pool_attributes(pfm_detail["skill"]);
    if (!skill_pool || !skill_pool["damage"])
    {
        tell_object(me, popup_title("该武学没有定义伤害属性池。"));
        return 1;
    }
    damage_pool = skill_pool["damage"];

    selected_skills = me->query_temp("self_pfm/current_damage_skills") || ({});
    selected_attribute = me->query_temp("self_pfm/current_damage_attribute");
    selection_count = me->query_temp("self_pfm/damage_selection_count") || 0;

    msg = "为招式「" + pfm_detail["name"] + "」配置伤害判定（单招）\n";
    msg += "已选 " + selection_count + "/3 项。最多可选3项（技能不限，属性最多1项）。\n\n";
    msg += "请选择伤害判定条件：\n";

    // 添加技能选项
    if (damage_pool["skill"] && sizeof(damage_pool["skill"]) > 0)
    {
        foreach (string sk in damage_pool["skill"])
        {
            if (member_array(sk, selected_skills) == -1)
            {
                 options += ({replace_string(to_chinese(sk),"基本","") + "伤害" + ":create_pfm process_damage_selection_single " + pfm_id + " skill " + sk});
            }
        }
    }

    // 添加属性选项 (只有在尚未选择属性，且总数未满3个时)
    if (!selected_attribute && damage_pool["attribute"] && sizeof(damage_pool["attribute"]) > 0)
    {
        foreach (string attr in damage_pool["attribute"])
        {
            options += ({to_chinese(attr) + "伤害" + ":create_pfm process_damage_selection_single " + pfm_id + " attribute " + attr});
        }
    }

    if (selection_count > 0)
    {
        options += ({"完成伤害配置:create_pfm save_single " + pfm_id + " confirm_damage"}); // 使用特殊标记确认
    }
    options += ({"返回上一步:create_pfm add " + pfm_id + " single"}); // 返回到动作类型选择

    if(sizeof(options) == 2 && selection_count == 3) // 只有完成和返回选项，且已选满
    {
        // 直接进入保存
        return save_single_action(me, pfm_id + " confirm_damage");
    }
    
    if(sizeof(options) == 2 && selection_count < 3 && member_array("完成伤害配置:create_pfm save_single " + pfm_id + " confirm_damage", options) != -1)
    { // 没有可选的了，但没选满，只有完成和返回
        tell_object(me, popup_comb(msg + "\n已无更多可选伤害条件或已达属性上限。", options));
    }
    else if (sizeof(options) > 2 || (selection_count == 0 && sizeof(options) > 1) ) // 确保有有效选项或初始状态
    {
        tell_object(me, popup_comb(msg, options));
    }
    else
    {
        // 如果没有任何可选的了（比如技能和属性都被选完了，或者一开始就没有）
        if (selection_count > 0)
        {
             tell_object(me, popup_comb(msg + "\n已无更多可选伤害条件。", ({
                "完成伤害配置:create_pfm save_single " + pfm_id + " confirm_damage",
                "返回上一步:create_pfm add " + pfm_id + " single"
            })));
        }
        else
        {
            // 初始就没有可选，则直接尝试保存（相当于无额外伤害设定）
            tell_object(me, popup_comb(msg + "\n当前武学没有可配置的伤害条件。将使用默认或无额外伤害设定。", ({
                "继续:create_pfm save_single " + pfm_id + " confirm_damage",
                "返回上一步:create_pfm add " + pfm_id + " single"
            })));
        }
    }
    return 1;
}

// 处理单招伤害判定的选择
int process_damage_selection_single(object me, string arg)
{
    string pfm_id, type, choice;
    string *selected_skills, selected_attribute;
    int selection_count;

    if (sscanf(arg, "%s %s %s", pfm_id, type, choice) != 3)
    {
        tell_object(me, popup_title("伤害选择参数错误"));
        return 1;
    }

    selected_skills = me->query_temp("self_pfm/current_damage_skills") || ({});
    selected_attribute = me->query_temp("self_pfm/current_damage_attribute");
    selection_count = me->query_temp("self_pfm/damage_selection_count") || 0;

    if (selection_count >= 3)
    {
        tell_object(me, popup_title("最多只能选择3个伤害判定条件。"));
        return actual_select_damage_options_single(me, pfm_id); // 返回选择界面
    }

    if (type == "skill")
    {
        if (member_array(choice, selected_skills) != -1)
        {
            tell_object(me, popup_title("该技能已经选择过了。"));
            return actual_select_damage_options_single(me, pfm_id);
        }
        selected_skills += ({ choice });
        me->set_temp("self_pfm/current_damage_skills", selected_skills);
    }
    else if (type == "attribute")
    {
        if (selected_attribute)
        {
            tell_object(me, popup_title("已经选择了一个属性作为伤害判定条件。"));
            return actual_select_damage_options_single(me, pfm_id);
        }
        me->set_temp("self_pfm/current_damage_attribute", choice);
    }
    else
    {
        tell_object(me, popup_title("未知的伤害判定类型。"));
        return actual_select_damage_options_single(me, pfm_id);
    }

    me->set_temp("self_pfm/damage_selection_count", selection_count + 1);

    // 返回选择界面
    return actual_select_damage_options_single(me, pfm_id);
}

// 保存单招动作
int save_single_action(object me, string arg)
{
    string pfm_id, hit_msg_or_confirm; // Changed variable name
    string first_skill, second_choice, second_type, action_msg, hit_msg;
    mapping ap_settings, damage_settings, action, pfm_detail;
    string *damage_skills, damage_attribute; // New variables for damage settings
    
    // The argument might be pfm_id + " confirm_damage" or pfm_id + " actual_hit_msg"
    // We need to parse it carefully.
    if (sscanf(arg, "%s %s", pfm_id, hit_msg_or_confirm) != 2) 
    {
        // This case handles when arg is just pfm_id (e.g. from auto-save when no options)
        // However, the new flow expects "confirm_damage" to be explicitly passed if options were presented.
        // For safety, let's assume if only pfm_id is passed, it's an error or needs review.
        // For now, we assume hit_msg is always passed via a previous step and stored in temp.
        // The new flow has hit_msg stored in temp by handle_hit_desc_and_start_damage_config_single
        // And a confirm_damage flag is used if selection was done.

        // Let's check if it's the confirm_damage flow without a space (e.g. if it's just pfm_idconfirm_damage)
        // More robustly, we expect a space. If not, it's likely an issue.
        // The current call is "create_pfm save_single " + pfm_id + " confirm_damage"
        // or from popup_input: "create_pfm save_single " + pfm_id + " " + actual_hit_msg
        // The original code expected pfm_id and hit_msg. The new flow uses temp for hit_msg.

        tell_object(me, popup_title("参数错误 (save_single_action)"));
        return 1;
    }

    hit_msg = me->query_temp("self_pfm/hit_msg"); // Retrieve hit_msg from temp
    if (!hit_msg && hit_msg_or_confirm != "confirm_damage") {
        // If hit_msg is not in temp, AND the second part of arg is not "confirm_damage",
        // then it must be the actual hit_msg itself.
        hit_msg = hit_msg_or_confirm;
    } else if (!hit_msg && hit_msg_or_confirm == "confirm_damage") {
        // This means we expected a hit_msg in temp but it's not there, and we are confirming damage.
        // This is an inconsistent state.
        tell_object(me, popup_title("内部错误：未找到击中描述。"));
        return 1;
    }
    // If hit_msg_or_confirm is "confirm_damage", hit_msg should already be in temp.
    // If hit_msg was in temp and hit_msg_or_confirm was something else, it's also an error, but caught by !stringp(hit_msg)

    if(!stringp(hit_msg) || hit_msg == "")
    {
        tell_object(me, popup_title("无效的击中描述。"));
        return 1;
    }

    pfm_detail = SKILL_MASTER->get_self_skill_detail(me->query("id"), pfm_id);
    if (!pfm_detail)
    {
        tell_object(me, popup_title("未找到指定的招式"));
        return 1;
    }
    
    first_skill = me->query_temp("self_pfm/first_skill");
    second_choice = me->query_temp("self_pfm/second_choice");
    second_type = me->query_temp("self_pfm/second_type");
    action_msg = me->query_temp("self_pfm/action_msg");
    
    if (!first_skill || !second_choice || !second_type || !action_msg)
    {
        tell_object(me, popup_title("请先完成所有选择 (AP)"));
        return 1;
    }
    
    // 创建命中设置 (AP settings)
    ap_settings = ([
        "jiaoli": 1 // Default or make it configurable later if needed
    ]);
    ap_settings["skill"] = ({ first_skill });
    if (second_type == "skill")
    {
        ap_settings["skill"] += ({ second_choice });
    }
    else  // second_type == "attribute"
    {
        ap_settings["attribute"] = ({ second_choice });
    }
    
    // 创建伤害设置 (Damage settings) based on player's new choices
    damage_settings = (["jiaoli": 0 ]); // Default jiaoli for damage, can be changed if needed by design
    damage_skills = me->query_temp("self_pfm/current_damage_skills");
    damage_attribute = me->query_temp("self_pfm/current_damage_attribute");

    if (damage_skills && sizeof(damage_skills) > 0)
    {
        damage_settings["skill"] = damage_skills;
    }
    if (damage_attribute && damage_attribute != "")
    {
        damage_settings["attribute"] = ({ damage_attribute }); // Attributes are expected as an array
    }

    // If no damage settings were chosen, damage_settings will be effectively empty apart from jiaoli:0
    // SKILL_MASTER should handle this (e.g. by applying default damage or no extra damage modifier)

    action = SKILL_MASTER->create_single_action(pfm_detail["skill"], ap_settings, damage_settings, action_msg, hit_msg);
    
    if (!action)
    {
        tell_object(me, popup_title("创建单招动作失败"));
        return 1;
    }
    
    if (!SKILL_MASTER->add_action_to_skill(me, pfm_id, action))
    {
        tell_object(me, popup_title("添加动作失败"));
        return 1;
    }
    
    // 清除临时变量
    me->delete_temp("self_pfm/first_skill");
    me->delete_temp("self_pfm/second_choice");
    me->delete_temp("self_pfm/second_type");
    me->delete_temp("self_pfm/action_msg");
    me->delete_temp("self_pfm/hit_msg"); // Clear hit_msg
    me->delete_temp("self_pfm/current_damage_skills"); // Clear damage config
    me->delete_temp("self_pfm/current_damage_attribute");
    me->delete_temp("self_pfm/damage_selection_count");
    
    tell_object(me, popup_comb("成功添加单招动作！",
                             ({"查看招式:create_pfm view " + pfm_id,
                               "返回列表:create_pfm"})));
    return 1;
}

// 添加连招动作
int add_combo_action(object me, string pfm_id)
{
    mapping pfm_detail, skill_pool;
    string skill_name;
    
    pfm_detail = SKILL_MASTER->get_self_skill_detail(me->query("id"), pfm_id);
    if (!pfm_detail)
    {
        tell_object(me, popup_title("未找到指定的招式"));
        return 1;
    }
    
    skill_name = pfm_detail["skill"];
    skill_pool = SKILL_MASTER->get_skill_pool_attributes(skill_name);
    
    if (!skill_pool || member_array("combo", skill_pool["pfm_type"]) == -1)
    {
        tell_object(me, popup_title(to_chinese(skill_name) + "不支持连招动作类型"));
        return 1;
    }
    
    tell_object(me, popup_input("请输入连招出招描述，如：$N连环数掌击向$n\n支持颜色：$RED$红色$NOR$ $HIY$高亮黄$NOR$ $BLU$蓝色$NOR$ 等",
                              "create_pfm handle_action_desc_combo " + pfm_id + " "));
    return 1;
}

// 新增：处理连招出招描述
int handle_action_desc_combo(object me, string arg)
{
    string pfm_id, action_msg;
    
    if (sscanf(arg, "%s %s", pfm_id, action_msg) != 2)
    {
        tell_object(me, popup_title("参数错误"));
        return 1;
    }
    
    me->set_temp("self_pfm/action_msg", action_msg);
    
    tell_object(me, popup_input("请输入连招击中描述，如：$N连续击中$n数掌，$n连连后退\n支持颜色：$RED$红色$NOR$ $HIY$高亮黄$NOR$ $BLU$蓝色$NOR$ 等",
                              "create_pfm handle_hit_desc_combo " + pfm_id + " "));
    return 1;
}

// 新增：处理连招击中描述并直接保存（连招无额外伤害配置环节）
int handle_hit_desc_combo(object me, string arg)
{
    string pfm_id, hit_msg;

    if (sscanf(arg, "%s %s", pfm_id, hit_msg) != 2)
    {
        tell_object(me, popup_title("参数错误"));
        return 1;
    }

    // 连招直接进入保存，因为它没有独立的伤害配置环节
    // 将 hit_msg 暂存，save_combo_action 会读取它
    me->set_temp("self_pfm/hit_msg_combo", hit_msg);
    return save_combo_action(me, pfm_id + " " + hit_msg); // Pass hit_msg for save_combo_action
}

// 保存连招动作
int save_combo_action(object me, string arg)
{
    string pfm_id, hit_msg;
    string action_msg;
    mapping action, pfm_detail;
    
    if (sscanf(arg, "%s %s", pfm_id, hit_msg) != 2)
    {
        tell_object(me, popup_title("参数错误"));
        return 1;
    }
    
    pfm_detail = SKILL_MASTER->get_self_skill_detail(me->query("id"), pfm_id);
    if (!pfm_detail)
    {
        tell_object(me, popup_title("未找到指定的招式"));
        return 1;
    }
    
    action_msg = me->query_temp("self_pfm/action_msg");
    // For combo, hit_msg is passed directly or retrieved if changed flow later
    // hit_msg = me->query_temp("self_pfm/hit_msg_combo"); 

    if (!action_msg)
    {
        tell_object(me, popup_title("请先输入出招描述"));
        return 1;
    }
    
    action = SKILL_MASTER->create_combo_action(pfm_detail["skill"], action_msg, hit_msg);
    
    if (!action)
    {
        tell_object(me, popup_title("创建连招动作失败"));
        return 1;
    }
    
    if (!SKILL_MASTER->add_action_to_skill(me, pfm_id, action))
    {
        tell_object(me, popup_title("添加动作失败"));
        return 1;
    }
    
    // 清除临时变量
    me->delete_temp("self_pfm/action_msg");
    me->delete_temp("self_pfm/hit_msg_combo"); // Clear combo specific hit_msg if used
    
    tell_object(me, popup_comb("成功添加连招动作！",
                             ({"查看招式:create_pfm view " + pfm_id,
                               "返回列表:create_pfm"})));
    return 1;
}

// 添加真实伤害动作
int add_real_action(object me, string pfm_id)
{
    mapping pfm_detail, skill_pool;
    string skill_name, msg;
    
    pfm_detail = SKILL_MASTER->get_self_skill_detail(me->query("id"), pfm_id);
    if (!pfm_detail)
    {
        tell_object(me, popup_title("未找到指定的招式"));
        return 1;
    }
    
    skill_name = pfm_detail["skill"];
    skill_pool = SKILL_MASTER->get_skill_pool_attributes(skill_name);
    
    if (!skill_pool || member_array("real", skill_pool["pfm_type"]) == -1)
    {
        tell_object(me, popup_title(to_chinese(skill_name) + "不支持真实伤害动作类型"));
        return 1;
    }
    
    msg = "为招式「" + pfm_detail["name"] + "」添加真实伤害动作\n\n";
    msg += "请选择伤害类型：\n";
    
    tell_object(me, popup_comb(msg, 
                             ({"气血伤害:create_pfm real_type " + pfm_id + " qi",
                               "精神伤害:create_pfm real_type " + pfm_id + " shen",
                               "返回:create_pfm add " + pfm_id})));
    return 1;
}

// 选择真实伤害类型
int select_real_type(object me, string arg)
{
    string pfm_id, damage_type;
    mapping pfm_detail, skill_pool;
    string *skill_options = ({}), msg;
    
    if (sscanf(arg, "%s %s", pfm_id, damage_type) != 2)
    {
        tell_object(me, popup_title("参数错误"));
        return 1;
    }
    
    pfm_detail = SKILL_MASTER->get_self_skill_detail(me->query("id"), pfm_id);
    if (!pfm_detail)
    {
        tell_object(me, popup_title("未找到指定的招式"));
        return 1;
    }
    
    skill_pool = SKILL_MASTER->get_skill_pool_attributes(pfm_detail["skill"]);
    
    // 清除之前的临时数据
    me->delete_temp("self_pfm/first_skill");
    me->delete_temp("self_pfm/second_choice");
    me->delete_temp("self_pfm/second_type");
    
    // 存储选择的伤害类型到玩家临时变量
    me->set_temp("self_pfm/damage_type", damage_type);
    
    // 生成第一次选择的武学列表
    foreach (string sk in skill_pool["ap"]["skill"])
    {
        skill_options += ({replace_string(to_chinese(sk),"基本","") + "激发" + ":create_pfm real_first_skill " + pfm_id + " " + sk});
    }
    
    msg = "已选择" + (damage_type == "qi" ? "气血伤害" : "精神伤害") + "作为真实伤害类型\n\n";
    msg += "命中判定需要选择两个条件：\n";
    msg += "请选择第一个判定条件（武学激发）：\n";
    
    tell_object(me, popup_comb(msg, skill_options + ({"返回:create_pfm add " + pfm_id})));
    return 1;
}

// 选择真实伤害的第一个技能
int real_first_skill(object me, string arg)
{
    string pfm_id, skill;
    mapping pfm_detail, skill_pool;
    string *options = ({}), msg;
    
    if (sscanf(arg, "%s %s", pfm_id, skill) != 2)
    {
        tell_object(me, popup_title("参数错误"));
        return 1;
    }
    
    pfm_detail = SKILL_MASTER->get_self_skill_detail(me->query("id"), pfm_id);
    if (!pfm_detail)
    {
        tell_object(me, popup_title("未找到指定的招式"));
        return 1;
    }
    
    skill_pool = SKILL_MASTER->get_skill_pool_attributes(pfm_detail["skill"]);
    
    // 存储第一次选择的技能
    me->set_temp("self_pfm/first_skill", skill);
    
    // 生成第二次选择的选项
    // 1. 其他武学激发（排除已选择的）
    foreach (string sk in skill_pool["ap"]["skill"])
    {
        if (sk != skill)  // 不能重复选择
        {
            options += ({replace_string(to_chinese(sk),"基本","") + "激发" + ":create_pfm real_second_skill " + pfm_id + " " + sk});
        }
    }
    
    // 2. 属性选择（如果有的话）
    if (skill_pool["ap"]["attribute"] && sizeof(skill_pool["ap"]["attribute"]) > 0)
    {
        foreach (string attr in skill_pool["ap"]["attribute"])
        {
            options += ({to_chinese(attr) + ":create_pfm real_second_attr " + pfm_id + " " + attr});
        }
    }
    
    msg = "已选择" + replace_string(to_chinese(skill),"基本","") + "激发作为第一个判定条件\n\n";
    msg += "请选择第二个判定条件：\n";
    
    tell_object(me, popup_comb(msg, options + ({"返回:create_pfm add " + pfm_id})));
    return 1;
}

// 选择真实伤害的第二个技能
int real_second_skill(object me, string arg)
{
    string pfm_id, skill;
    string first_skill;
    
    if (sscanf(arg, "%s %s", pfm_id, skill) != 2)
    {
        tell_object(me, popup_title("参数错误"));
        return 1;
    }
    
    first_skill = me->query_temp("self_pfm/first_skill");
    if (!first_skill)
    {
        tell_object(me, popup_title("请先选择第一个判定条件"));
        return 1;
    }
    
    // 存储第二次选择（武学）
    me->set_temp("self_pfm/second_choice", skill);
    me->set_temp("self_pfm/second_type", "skill");
    
    tell_object(me, popup_input("请输入出招描述，如：$N真气汇聚，一掌震向$n\n支持颜色：$RED$红色$NOR$ $HIY$高亮黄$NOR$ $BLU$蓝色$NOR$ 等",
                              "create_pfm handle_action_desc_real " + pfm_id + " "));
    return 1;
}

