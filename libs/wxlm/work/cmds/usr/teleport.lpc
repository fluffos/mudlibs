inherit F_CLEAN_UP;

int main(object me, string arg)
{
    string *fields, str,*buttons = ({});
    
    if (!arg)
    {
        fields = me->query("fields_list");
        if (!fields || !sizeof(fields))
            return notify_fail(HIY"你还没有开垦任何耕地！！"NOR"\n");

        str = "请选择要传送到的耕地：";
        foreach (string field in fields)
        {
            // buttons += ({ ("/d/player_land/" + field[0] + "/" + field)->query("short") + ":teleport " + field });
            buttons += ({
                sprintf("/d/player_land/map/%c/%s/%s",field[0],me->query("id"),field)->query("short") + ":teleport " + field
            });
        }

        write(popup_comb(str, buttons));
        return 1;
    }

    //如果我身处耕地并且arg == wangchuan，则传送到忘川
    if (environment(me)->query("is_land") && arg == "wangchuan")
    {
        me->move("/data/hell/shui");
        tell_object(me, HIG"你传送到了忘川。"NOR"\n");
        return 1;
    }

    if (file_size(sprintf("/d/player_land/map/%c/%s/%s.lpc",arg[0],me->query("id"),arg)) <= 0)
        return notify_fail(HIY"该耕地不存在！！"NOR"\n");

    me->move(sprintf("/d/player_land/map/%c/%s/%s.lpc",arg[0],me->query("id"),arg));
    tell_object(me, HIG"你传送到了耕地。"NOR"\n");
    return 1;
}