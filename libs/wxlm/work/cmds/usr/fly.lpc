int main(object me, string arg)
{
	object  room;
	string msg,where,*citys,dir;
	int i;

	if (! arg) return help(me);  

	if (!CAN_MOVE->is_can_move(me)) {
		return 1;
	}

	if (arg == "home" && ! me->query("private_room/position")) 
		return notify_fail("你尚未置办住处，无处可归！\n");

	if (arg == "home" && stringp(me->query("private_room/position")) && file_size(me->query("private_room/position") + ".lpc") > 0)
		room = get_object(me->query("private_room/position"));
	else if(arg == "hell")
	{
		citys = list_dirs("/data/hell/");
		if (sizeof(citys)<1) {
			return notify_fail("目前空中之城是空城！\n");
		}
		msg = ZJOBLONG"请选择城市：\n"ZJOBACTS2+ZJMENUF(3,3,10,30);
		for(i=0;i<sizeof(citys);i++)
		{
			msg += city_name[citys[i]]+":fly hell "+citys[i];
			if(i<(sizeof(citys)-1)) msg += ZJSEP;
		}
		write(msg+"\n");
		return 1;
	}
	else if(sscanf(arg,"hell %s",dir)==1)
	{
		//if(!wizardp(me))
		//	return notify_fail("稍后开放。\n");
		if(file_size("/data/hell/"+dir)!=-2)
			return notify_fail("没有这个城市。\n");
		if(file_size("/data/hell/"+dir+"/guangchang.lpc")<0)
			return notify_fail("城市入口错误，请联系管理员。\n");
		room = get_object("/data/hell/"+dir+"/guangchang");
	}
	else
	{
		if (member_array(arg, keys(places)) == -1) 
			return notify_fail("此处太过遥远，非一般轻功所能及！\n");
		room = get_object(places[arg]);
	}
	if (! room) return notify_fail("那处所在似有古怪，不宜贸然前往。\n");

	where = room->query("short");
	message_vision(HIM"$N气沉丹田，运起"HIW"轻功"NOR+HIM"。"HIM"\n$N御风而去，直上云霄向"+where+""HIM"方向赶去。"NOR"\n"NOR"\n", me);
	me->move("/d/city/kongzhong");

	me->set_temp("is_flying",1);

	if (me->query("zjvip/times") >1) call_out("fly_fin",1,where,me,room);
        else call_out("fly_fin",3,where,me,room);
	return 1;
}
void fly_fin(string where,object me,object room)
{
	if (!me)
		return;
	me->move(room);

	tell_object(me, HIC"你踏雪无痕， 在崇山峻岭间飞跃，终于赶到了" + where + ""HIC"。"NOR"\n"NOR"\n");
        tell_room(environment(me),HIC""+me->name()+"如同一道"HIW"残影"HIC"从远处飞驰而来，徐徐落下。"NOR"\n",me);
	me->delete_temp("is_flying");

}
