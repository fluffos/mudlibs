

// 查看气血或精神加成明细
int main(object me, string arg)
{
    string msg, *buttons;
    mapping bonus;
    
    if (!arg)
    {
        msg = "请选择要查看的属性类型：\n";
        buttons = ({
            "气血加成:hp_race qi", 
            "精神加成:hp_race jing",
            "力量加成:hp_race str",
            "悟性加成:hp_race int",
            "根骨加成:hp_race con",
            "身法加成:hp_race dex",
            "容貌加成:hp_race per"
        });
        write(popup_comb(msg, buttons));
        return 1;
    }

    if (arg == "qi")
    {
        msg = HIY"≡" HIW "气血加成明细" HIY "≡\n"NOR;
        bonus = me->query_temp("race_human/qi");
        if (!mapp(bonus) || sizeof(bonus) < 1)
        {
            write("你目前没有任何气血加成记录。\n");
            return 1;
        }

        foreach (string key, int value in bonus)
        {
            if (value > 0)
                msg += sprintf(HIW"%-12s"NOR": %d\n", key, value);
            else if (value < 0)
                msg += sprintf(HIW"%-12s"NOR": "HIR"%d\n"NOR, key, value);
        }
        
        msg += sprintf("\n"HIY"当前气血上限："NOR"%d\n", me->query("max_qi"));
        buttons = ({"返回:hp_race", "关闭:close"});
        write(popup_comb(msg, buttons));
        return 1;
    }

    if (arg == "jing")
    {
        msg = HIY"≡" HIW "精神加成明细" HIY "≡\n"NOR;
        bonus = me->query_temp("race_human/jing");
        if (!mapp(bonus) || sizeof(bonus) < 1)
        {
            write("你目前没有任何精神加成记录。\n");
            return 1;
        }

        foreach (string key, int value in bonus)
        {
            if (value > 0)
                msg += sprintf(HIW"%-12s"NOR": %d\n", key, value);
            else if (value < 0)
                msg += sprintf(HIW"%-12s"NOR": "HIR"%d\n"NOR, key, value);
        }
        
        msg += sprintf("\n"HIY"当前精神上限："NOR"%d\n", me->query("max_jing"));
        buttons = ({"返回:hp_race", "关闭:close"});
        write(popup_comb(msg, buttons));
        return 1;
    }

    if (arg == "neili")
    {
        msg = HIY"≡" HIW "内力加成明细" HIY "≡\n"NOR;
        me->update_neili_details();
        bonus = me->query_temp("race_human/neili");
        if (!mapp(bonus) || sizeof(bonus) < 1)
        {
            write("你目前没有任何内力加成记录。\n");
            return 1;
        }

        foreach (string key, int value in bonus)
        {
            if (value > 0)
                msg += sprintf(HIW"%-12s"NOR": %d\n", key, value);
            else if (value < 0)
                msg += sprintf(HIW"%-12s"NOR": "HIR"%d\n"NOR, key, value);
        }

        msg += sprintf("\n"HIY"当前内力上限："NOR"%d\n", me->query("max_neili"));
        buttons = ({"返回:hp_race", "关闭:close"});
        write(popup_comb(msg, buttons));
        return 1;
    }

    if (arg == "str")
    {
        msg = HIY"≡" HIW "力量加成明细" HIY "≡\n"NOR;
        bonus = me->query_temp("race_human/str");
        if (!mapp(bonus) || sizeof(bonus) < 1)
        {
            write("你目前没有任何力量加成记录。\n");
            return 1;
        }

        foreach (string key, int value in bonus)
        {
            if (value > 0)
                msg += sprintf(HIW"%-12s"NOR": %d\n", key, value);
            else if (value < 0)
                msg += sprintf(HIW"%-12s"NOR": "HIR"%d\n"NOR, key, value);
        }
        
        msg += sprintf("\n"HIY"当前力量："NOR"%d\n", me->query_str());
        buttons = ({"返回:hp_race", "关闭:close"});
        write(popup_comb(msg, buttons));
        return 1;
    }

    if (arg == "int")
    {
        msg = HIY"≡" HIW "悟性加成明细" HIY "≡\n"NOR;
        bonus = me->query_temp("race_human/int");
        if (!mapp(bonus) || sizeof(bonus) < 1)
        {
            write("你目前没有任何悟性加成记录。\n");
            return 1;
        }

        foreach (string key, int value in bonus)
        {
            if (value > 0)
                msg += sprintf(HIW"%-12s"NOR": %d\n", key, value);
            else if (value < 0)
                msg += sprintf(HIW"%-12s"NOR": "HIR"%d\n"NOR, key, value);
        }
        
        msg += sprintf("\n"HIY"当前悟性："NOR"%d\n", me->query_int());
        buttons = ({"返回:hp_race", "关闭:close"});
        write(popup_comb(msg, buttons));
        return 1;
    }

    if (arg == "con")
    {
        msg = HIY"≡" HIW "根骨加成明细" HIY "≡\n"NOR;
        bonus = me->query_temp("race_human/con");
        if (!mapp(bonus) || sizeof(bonus) < 1)
        {
            write("你目前没有任何根骨加成记录。\n");
            return 1;
        }

        foreach (string key, int value in bonus)
        {
            if (value > 0)
                msg += sprintf(HIW"%-12s"NOR": %d\n", key, value);
            else if (value < 0)
                msg += sprintf(HIW"%-12s"NOR": "HIR"%d\n"NOR, key, value);
        }
        
        msg += sprintf("\n"HIY"当前根骨："NOR"%d\n", me->query_con());
        buttons = ({"返回:hp_race", "关闭:close"});
        write(popup_comb(msg, buttons));
        return 1;
    }

    if (arg == "dex")
    {
        msg = HIY"≡" HIW "身法加成明细" HIY "≡\n"NOR;
        bonus = me->query_temp("race_human/dex");
        if (!mapp(bonus) || sizeof(bonus) < 1)
        {
            write("你目前没有任何身法加成记录。\n");
            return 1;
        }

        foreach (string key, int value in bonus)
        {
            if (value > 0)
                msg += sprintf(HIW"%-12s"NOR": %d\n", key, value);
            else if (value < 0)
                msg += sprintf(HIW"%-12s"NOR": "HIR"%d\n"NOR, key, value);
        }
        
        msg += sprintf("\n"HIY"当前身法："NOR"%d\n", me->query_dex());
        buttons = ({"返回:hp_race", "关闭:close"});
        write(popup_comb(msg, buttons));
        return 1;
    }

    if (arg == "per")
    {
        msg = HIY"≡" HIW "容貌加成明细" HIY "≡\n"NOR;
        bonus = me->query_temp("race_human/per");
        if (!mapp(bonus) || sizeof(bonus) < 1)
        {
            write("你目前没有任何容貌加成记录。\n");
            return 1;
        }

        foreach (string key, int value in bonus)
        {
            if (value > 0)
                msg += sprintf(HIW"%-12s"NOR": %d\n", key, value);
            else if (value < 0)
                msg += sprintf(HIW"%-12s"NOR": "HIR"%d\n"NOR, key, value);
        }
        
        msg += sprintf("\n"HIY"当前容貌："NOR"%d\n", me->query_per());
        buttons = ({"返回:hp_race", "关闭:close"});
        write(popup_comb(msg, buttons));
        return 1;
    }

    return 1;
}
