inherit F_CLEAN_UP;
 
int main(object me, string arg)
{
    object env = environment(me);
    string place_name;

    if (!arg)
    {

        if (!CAN_MOVE->is_can_move(me)) {
            return 1;
        }

        if (!me->query("re_home_place"))
        {
            tell_object(me, "你还没有设置回家地点。\n");
            return 1;
        }

        me->move(load_object(me->query("re_home_place")));
        tell_object(me, "你已经回到" + environment(me)->query("short") + "。\n");
        return 1;
    }


    if (arg == "set")
    {
        place_name = file_name(env);
        me->set("re_home_place", place_name);
        tell_object(me, "你已经设置回家地点为" + env->query("short") + "。\n");
        return 1;
    }

    if (arg == "del")
    {
        me->delete("re_home_place");
        tell_object(me, "你已经取消回家地点。\n");
        return 1;
    }

    return notify_fail("参数错误，请联系巫师处理回家系统。\n");
}