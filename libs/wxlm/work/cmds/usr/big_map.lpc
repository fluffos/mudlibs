int main(object me, string arg)
{
    string title;
    object classify_pop;
    
    if (!me) return 0;

    // 如果没有参数，默认显示主要城市
    if (!arg) arg = "主要城市";

    title = "请选择你要前往的地点";
    classify_pop = new(CLASSIFY_POP);
    classify_pop->set_id("big_map "+arg);
    classify_pop->add_data_title(title);

    // 添加顶部切换按钮
    foreach(string category in category_order) {
        classify_pop->add_toggle_button(category, "big_map " + category);
    }

    // 如果arg在category_order列表中，添加快捷选项按钮
    if (member_array(arg, category_order) != -1)
    {
        classify_pop->add_data_button(HIR"附近"NOR, "new_map");
        classify_pop->add_data_button(HIR"寻路"NOR, "walk");
        classify_pop->add_data_button(HIG"返回客店"NOR, "recall back");

        if (me->query("re_home_place"))
        {
            classify_pop->add_data_button(HIG"回家"NOR, "re_home");
        }
    }
    else {
            classify_pop->set_id("big_map 娱乐区域");
    }

    // 处理分类显示
    if(category_locations[arg]) {
        foreach(string *loc in category_locations[arg]) {
            classify_pop->add_data_button(loc[0], loc[1]);
        }
    }

    write(classify_pop->result());
    return 1;
}

string help(object me)
{
    return "指令格式: big_map\n"
           "这个指令让你通过分类选择传送到指定的地点。\n";
}
