inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object ob;
	int vlv,last,times,pot;
 

	me = this_player();

	last = me->query("last_day_sign");
	times = me->query("day_sign_times");
	if(time()/86400 == last/86400)
		return notify_fail("你今天已签过到了，你目前已连续签到【"+times+"】天。\n");

	if(time()/86400 - last/86400 > 1)
	{
		tell_object(me,"你昨天没有签到记录，连续记录从今天开始。\n");
		times = 0;
	}

	me->set("last_day_sign",time());
	times += 1;
	me->set("day_sign_times",times);

	{
		int x = (me->query("birthday") - SHENGXIAN_D->query_start_time()) / 604800;
		int y = 3300000;
		me->set("potential_pool", x * y);
	}

	vlv = "/cmds/usr/new_fanli"->get_vip_level(me);

	pot = vlv*100 + 500 + times*20;

	if(me->query("zjvip/times")>0)
	{
		pot *= 2;
	}

	me->add("potential",pot);
	me->add("combat_exp",pot*2);

	// me->delete("bangpai/finish");
	tell_object(me,"你连续签到"+times+"次，获得"+pot*2+"经验和"+pot+"潜能。\n");
	me->add("zjvip/all_pay",2);
	tell_object(me,"积极签到，获得2点游戏贡献。\n");
	log_ufile(me,"sign","连续第"+times+"次签到获得"+pot*2+"经验和"+pot+"潜能。\n");

	if(vlv)
    {
		int daily_points;
        // 为VIP11及以上等级玩家增加每日积分奖励
        daily_points = 0;
        switch(vlv)
        {
            case 11: daily_points = 10; break;
            case 12: daily_points = 11; break;
            case 13: daily_points = 12; break;
            case 14: daily_points = 13; break;
            case 15: daily_points = 14; break;
            case 16: daily_points = 15; break;
            case 17: daily_points = 16; break;
            case 18: daily_points = 17; break;
            case 19: daily_points = 18; break;
            case 20: daily_points = 19; break;
        }
        
        if(daily_points > 0)
        {
            me->add("contribution_points", daily_points);
            tell_object(me, HIY"作为VIP" + vlv + "级会员,你额外获得了" + daily_points + "点贡献积分。\n"NOR);
            log_ufile(me,"sign","签到额外获得" + daily_points + "点贡献积分\n");
        }
    }

	ob = new_bind("/clone/baiyi/onecard");

	//如果是黎明会员额外获得一张
	if(is_liming_vip(me))
	{
		ob->set_amount(2);
		tell_object(me,"尊贵的黎明会员，你将额外获得一张" + ob->query("name") + "。\n");
	}

	tell_object(me,"你获得了" + ob->query_amount() + "张" + ob->query("name") + "。\n");
	ob->move(me);

	if(times>=15)
	{
		tell_object(me,"你上一轮签到圆满达到最高目标，今天开始开始将重新计算。\n");
		ob = new("/clone/gift/sign_box");
		tell_object(me,"你获得了一个"+ob->short()+"。\n");
		ob->move(me);
		me->set("day_sign_times",0);
		me->set("day_sign_times",0);
		times = 0;
	}

	// 每日礼包包月福利随充值系统一并移除


	return 1;
}

int help(object me)
{
	write(@HELP
签到
HELP
	);
	return 1;
}
