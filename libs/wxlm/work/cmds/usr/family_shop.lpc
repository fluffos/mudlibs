    ([
        "path":"/clone/vip/putao",
        "price":10,
        "level":1,
    ]),
    ([
        "path":"/clone/vip/book_tianfu",
        "price":10,
        "level":1,
    ]),
    ([
        "path":"/clone/vip/book_wuliang",
        "price":10,
        "level":1,
    ]),
    ([
        "path":"/clone/vip/jinsha",
        "price":10,
        "level":1,
    ]),
    ([
        "path":"/clone/vip/dan_chongmai1",
        "price":10,
        "level":3,
    ]),
    ([
        "path":"/clone/vip/dijibao_hufu",
        "price":10,
        "level":3,
    ]),
    ([
        "path":"/clone/vip/dan_chongmai2",
        "price":20,
        "level":4,
    ]),
    ([
        "path":"/clone/vip/zhongjibao_hufu",
        "price":30,
        "level":4,
    ]),
    ([
        "path":"/clone/vip/dan_chongmai3",
