// study_skills.c
// 查询留学门派技能学习记录

inherit F_CLEAN_UP;

int main(object me, string arg)
{
    object mgr, pop;
    mapping all_learned, family_skills;
    string family_name, skill_name, msg;
    
    mgr = load_object("/adm/special_ob/multi_family/multi_family_master");
    if (!mgr)
    {
        return notify_fail("系统错误：无法加载多门派管理器。\n");
    }
    
    all_learned = mgr->get_all_learned_skills(me);
    if (!all_learned["success"])
    {
        return notify_fail("无法获取技能学习记录。\n");
    }
    
    pop = new(POP1);
    
    msg = "【留学门派技能记录】\n\n";
    
    if (!mapp(all_learned["all_learned_skills"]) || !sizeof(all_learned["all_learned_skills"]))
    {
        msg += "暂无留学门派技能学习记录。\n";
        pop->basic(msg, 2);
        tell_object(me, pop->result() + "\n");
        return 1;
    }
    
    foreach (family_name, family_skills in all_learned["all_learned_skills"])
    {
        int priority = mgr->get_family_priority(me, family_name);
        
        msg += sprintf("🏛️ 【%s】（第%d门派，%d倍消耗）\n", family_name, priority, priority);
        
        if (mapp(family_skills) && sizeof(family_skills))
        {
            foreach (skill_name, mapping skill_info in family_skills)
            {
                if (mapp(skill_info))
                {
                    msg += sprintf("  📚 %s（%s）- 等级%d - 师父：%s\n",
                        skill_info["skill_chinese"] || to_chinese(skill_name),
                        skill_name,
                        skill_info["learned_level"],
                        skill_info["teacher_name"]);
                    msg += sprintf("    学习次数：%d次 - 首次学习：%s\n",
                        skill_info["learn_count"],
                        ctime(skill_info["learned_time"])[4..15]);
                }
            }
        }
        else
        {
            msg += "  暂无技能记录\n";
        }
        msg += "\n";
    }
    
    pop->basic(msg, 2);
    pop->add_button("返回", "look");
    tell_object(me, pop->result() + "\n");
    
    return 1;
}

int help(object me)
{
    write(@HELP
指令格式：study_skills

查看你从各个留学门派学习的技能记录，包括：
- 学习的技能名称和等级
- 指导师父的姓名  
- 学习时间和次数
- 门派优先级和潜能倍数

这有助于了解自己的技能来源，合理规划后续学习。

其他相关指令：multi_family, learn, research
HELP
    );
    return 1;
} 