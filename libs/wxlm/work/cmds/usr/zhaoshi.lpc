int main(object me,string arg)
{
    mapping data = ([]);
    string msg;

    if (!arg)
    {
        data["code"] = "招式";

        // data["data"] = "/adm/special_ob/combat_json_msg"->skill_pfm_cond(me);
        data["data"] = "/adm/special_ob/combat_json_msg"->skill_pfm_cond(me) + ({ "/adm/special_ob/combat_json_msg"->medicide_cond_array_auto(me) });

        msg = json_encode(data);
        write(msg + "\n");
    }
    else if (arg == "auto")
    {
        data["code"] = "自动招式";

        data["data"] = "/adm/special_ob/combat_json_msg"->skill_pfm_cond(me) + ({ "/adm/special_ob/combat_json_msg"->medicide_cond_array_auto(me) });
        // data["data_medicide"] = "/adm/special_ob/combat_json_msg"->medicide_cond_array(me);

        // write(sprintf("data:%O\n",data["data"]));

        msg = json_encode(data);
        write(msg + "\n");
    }

    return 1;
}
