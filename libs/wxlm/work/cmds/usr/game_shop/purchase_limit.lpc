//返回剩余的购买次数
int query_purchase_limit(string item_file,object player)
{
    int purchase_limit_day,player_already_purchase_day,day_number;

    //获取购买次数限制
    purchase_limit_day = item_file->query("day_limit_number");

    //获取从现在距离开服的天数
    day_number = ((time() - SHENGXIAN_D->query_start_time()) / 86400) + 1;

    //如果天数小于1，则设置为1
    day_number = day_number > 0 ? day_number : 1;

    //获取玩家已经购买次数
    player_already_purchase_day = player->query("shop_limit/" + item_file->query("name"));

    //计算可购买次数
    purchase_limit_day = purchase_limit_day * day_number;
    // tell_object(player, "购买次数：" + purchase_limit_day + " / " + item_file->query("day_limit_number") + "\n");

    return purchase_limit_day - player_already_purchase_day;
}
