// 商品分类定义
nosave mapping items_dict = ([
    "属性": ({ "洗髓丹", "火红仙丹", "醍醐仙丹", "神力丸", "九转金丹" }),
    "经脉": ({ "冲脉丹[下品]", "冲脉丹[中品]", "冲脉丹[上品]", "冲脉丹[极品]", "经脉重朔丹" }),
    "装备": ({ "金砂", "补天石", "冰蚕丝", "玄冰寒铁", "乌金丝", "装备保护符[低级]",
                   "装备保护符[中级]", "装备保护符[高级]", "装备保护符[极高级]", "强化石" }),
    "丹药": ({ "变性丹", "回春丹", "损命丹", "正气丹", "邪气丹", "千年灵芝", "小还丹",
                   "天香玉露", "福寿膏", "胭脂", "毁容丹", "天灵丹", "门客天灵丹", "洗心丹",
                   "清心丹", "无极仙丹" }),
    "其他": ({ "VIP月卡", "无量经书", "更名卡", "金票", "替身傀儡",
                   "葡萄", "神奇葡萄", "乾坤灵碑", "意境重塑稿", "初级宝箱", "通行令牌", "卧龙令" }),
    "礼包": ({ "经脉入门礼包","经脉进阶礼包","经脉大成礼包","经脉圆满礼包","九转金丹礼包",
                   "强化入门礼包","进阶强化礼包" }),
    "天赋": ({ "天赋技能书", "天赋感悟碎片" }),
    "种植": ({ "葡萄树种子", "悟心树种子","人参果树种子","肥料" }),
]);

// 门派商店物品列表
nosave mapping *family_items = ({
    (["path":"/clone/vip/putao", "price":10, "level":1]),
    (["path":"/clone/vip/book_tianfu", "price":10, "level":1]),
    (["path":"/clone/vip/book_wuliang", "price":10, "level":1]),
    (["path":"/clone/vip/jinsha", "price":10, "level":1]),
    (["path":"/clone/vip/dan_chongmai1", "price":10, "level":3]),
    (["path":"/clone/vip/dijibao_hufu", "price":10, "level":3]),
    (["path":"/clone/vip/dan_chongmai2", "price":20, "level":4]),
    (["path":"/clone/vip/zhongjibao_hufu", "price":30, "level":4]),
    (["path":"/clone/vip/dan_chongmai3", "price":30, "level":5]),
    (["path":"/clone/vip/jinpiao", "price":200, "level":6]),
    (["path":"/clone/vip/putao1", "price":200, "level":6]),
    (["path":"/clone/vip/dan_chongmai4", "price":50, "level":7]),
    (["path":"/clone/vip/gaojibao_hufu", "price":50, "level":7]),
    (["path":"/clone/vip/dan_jiuzhuan", "price":500, "level":9]),
});

// 每周礼包列表
nosave mapping week_gift_list = ([
    "经脉礼包类": ({
        "经脉入门礼包",
        "经脉进阶礼包",
        "经脉大成礼包",
        "经脉圆满礼包",
    }),
    "强化礼包类": ({
        "强化入门礼包",
        "进阶强化礼包",
    }),
    "九转礼包类":({
        "九转金丹礼包",
    })
]);

mapping query_items_dict() { return items_dict; }
mapping *query_family_items() { return family_items; }
mapping query_week_gift_list() { return week_gift_list; }

int help(object me)
{
    write(@HELP
统一商城系统

指令格式：
  game_shop [商城类型] [分类名称]  - 浏览商城
  game_shop look <商城类型> <物品路径>  - 查看物品详情
  game_shop buy <数量> <商城类型> <物品路径>  - 购买物品

商城类型:
  yuanbao  - 元宝商城
  bind     - 绑定元宝商城
  family   - 门派商城(需要加入门派)
  money    - 金钱商店

不带参数默认显示元宝商城

示例:
  game_shop yuanbao 装备相关    - 查看元宝商城装备分类
  game_shop look yuanbao /clone/vip/putao  - 查看葡萄详情
  game_shop buy 10 yuanbao /clone/vip/putao  - 购买10个葡萄
HELP
    );
    return 1;
}