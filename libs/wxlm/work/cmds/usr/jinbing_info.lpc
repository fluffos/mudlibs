

inherit F_CLEAN_UP;

int main(object me, string arg)
{
    mapping data;
    string msg;

    if (!JINBING_D->query_active())
    {
        return notify_fail("金兵入侵活动当前未开启。\n");
    }

    data = JINBING_D->query_player_data(me->query("id"));
    
    msg = HIY "【金兵入侵】活动信息：\n" NOR;
    msg += "你当前的积分：" + (data ? data["score"] : 0) + "\n";
    msg += "你当前的荣誉：" + (data ? data["honor"] : 0) + "\n\n";
    
    msg += "城门防御情况：\n";
    foreach (string gate in keys(JINBING_D->query_city_gates()))
    {
        msg += gate + "：" + JINBING_D->query_city_gates()[gate]["defense"] + "%\n";

    }

    tell_object(me,popup_title(msg));
    return 1;
}


int help(object me)
{
    write(@HELP
指令格式：jinbing_info

这个指令可以让你查看当前金兵入侵活动的相关信息,包括你的积分、荣誉以及各个城门的防御情况。

HELP );
    return 1;
}
