// daan.c 答题命令
// by ices-y 2024-07-25
#define KEJU_D "/adm/special_ob/keju/keju_d"

int main(object me, string arg)
{
    if (!arg || (arg != "A" && arg != "B" && arg != "C" && arg != "D"))
    {
        return notify_fail("你要回答哪个选项？请使用 daan <A/B/C/D> 的格式。
");
    }

    // 将答案交给科举主控处理
    KEJU_D->receive_answer(me, arg);

    return 1;
}

int help(object me)
{
    write(@HELP
指令格式 : daan <A|B|C|D>

这个指令让你在科举考试中回答问题。

HELP
    );
    return 1;
}
