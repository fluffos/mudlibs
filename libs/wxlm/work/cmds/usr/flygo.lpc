// miss 追寻物品



inherit F_CLEAN_UP;

string *anjian = ({
    "主线任务:maintask",
    "签到:daysign",
    "礼包兑换:libao_duihuan",
    "贡献奖励:new_fanli",
    "绑定商城:bind_shop",
    "抽奖:luckdraw",
    "木剑砺锋:flygo caoren",
    "幽冥幻境:flygo moku",
    "溯源之河:flygo qianchi_msg",
    "回师门:walk 师傅",
    "地图:new_map",
    "冲脉丹合成:cmhc",
    "新手指南:help newbie",
    "自制装备管理:summon all",
    "天下武道大会:flygo wudaodahui_msg",
    "藏经阁副本:start_fuben cangjingge",
    "大漠黑塔副本:start_fuben damo",
    "称号系统:querytitles",
    "宝石矿洞:start_fuben baoshi",
});

mapping where = ([
    "qiandao":"/d/city/wumiao",
    "lunjian":"/d/lunjian/enter",
    "qianchi" : "/d/fuben/qianchipu/qianchipu",
    "wudaodahui" : "/d/wudao/tianjige",
]);

void send_message(object me, string msg) {
    tell_object(me, msg);
}

string generate_msg(string title, string desc, string rewards, string enter_cmd) {
    string msg;
    msg = ZJOBLONG + title + ZJBR;
    msg += desc + ZJBR;
    msg += rewards + ZJBR;
    msg += "\n" + ZJOBACTS2 + ZJMENUF(4, 4, 8, 30);
    msg += "进入:" + enter_cmd + "\n";
    return msg;
}

int open_instance(object me, string path, string start_func) {
    object room;
    if (!objectp(room = new(path))) {
        write("副本开启失败。\n");
        return 0;
    }
    if (!call_other(room, start_func, me)) {
        destruct(room);
        return 0;
    }
    return 1;
}

int main(object me, string str) {

    if (!str) {
        string bynb, msg;
        msg = ZJOBLONG "萌新功能键，请选择\n" ZJOBACTS2 + ZJMENUF(4, 4, 8, 30);
        foreach (bynb in anjian) {
            msg += bynb + ZJSEP;
        }
        msg += "寻路:walk\n";
        send_message(me, msg);
        return 1;
    }
    switch (str) {
        case "moku":
            send_message(me, generate_msg(
                "幽冥幻境极其危险，建议血量高于5000，技能等级不低于200级进行挑战，幻境内会随机产生四种不同的怪物，每种怪物属性，专属技能都不一致，请务必当心。",
                "幽冥幻境奖励为：",
                "【基础奖励】：经验，潜能，银两，元宝。\n【通关奖励】:黄金，元宝。",
                "flygo moku_sure"
            ));
            return 1;

        case "caoren":
            send_message(me, generate_msg(
                "木剑砺锋为新手副本，建议技能等级100后进行挑战，危险程度低,怪物分为铁甲木人和机关木人，共十只。",
                "木剑砺锋奖励为：",
                "【基础奖励】：经验，潜能。\n【通关奖励】:分为"HIR"（无伤通关）"NOR"和"HIG"（限时通关）"NOR"，两个成就可以同时达成（大额奖励），全部未能达成无任何通关奖励。",
                "flygo caoren_sure"
            ));
            return 1;

        case "moku_sure":
            return open_instance(me, "/d/fuben_moku/moku", "start_fuben_moku");

        case "caoren_sure":
            return open_instance(me, "/d/fuben_caoren/shilianchang", "start_fuben_caoren");

        case "qianchi_msg":
            send_message(me, generate_msg(
                "溯源之河，乃是一处江湖传说之地，位于深山幽谷之中，鲜为人知。此河神秘异常，河水逆向而流，自下游蜿蜒而上，直至源头，与世间的河流截然不同。河水湍急，水质清澈，却蕴含着一种莫名的力量，能够锻炼人的身体和意志。",
                "溯源之河奖励为：",
                "【基础奖励】：经验，潜能，下品冲脉丹,天赋技能。\n【额外奖励】:通过激昂的激流锻炼气血。",
                "flygo qianchi"
            ));
            return 1;

        case "wudaodahui_msg":
            send_message(me, generate_msg(
                "天下武道大会，是一场武林盛事，每年一度，各大门派弟子齐聚一堂，切磋武艺，争夺排行榜的称号。",
                "请经验高于100w，技能等级不低于200级后前往。\n1.100万--200万经验（内功，轻功，招架有效等级不能小于400） 潜龙榜\n2.200万-400万经验（内功，轻功，招架有效等级不能小于600） 宗师榜\n3.400万经验往上（内功，轻功，招架有效等级不能小于700） 尊者榜\n5.比武逻辑，玩家先报名，报名以后自动分配对手。\n战胜获得3点评分，1万潜能。\n战败获得1点评分，7千潜能。\n5.随机匹配，只分配和经验范围内等同的对手。\n6.天机阁会在比武结束后分配榜单。\n7.报名时间每周一至周五：晚上十点开始到晚上十点十分。比武十轮。",
                "",
                "flygo wudaodahui"
            ));
            return 1;

        default:
            if (stringp(where[str])) {
                
                if (!CAN_MOVE->is_can_move(me)) {
                    return 1;
                }
                me->move(where[str]);
                send_message(me, "你飞身而起，朝着" + where[str]->short() + "奔去。\n");
                return 1;
            }
            return notify_fail("无效的指令。\n");
    }
}