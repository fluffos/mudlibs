// remove_gem.c



inherit F_CLEAN_UP;

int do_remove_gem(object me, object equip, int hole_number);
int show_gem_selection(object me, object equip);

int main(object me, string arg)
{
    object equip;
    int hole_number;
    
    if (!arg)
        return notify_fail("指令格式：remove_gem <装备ID> [<孔位编号>]\n");
    
    // remover = present("gem remover", me);
    // if (!remover)
        // return notify_fail("你需要一张宝石拆卸符来拆卸宝石。\n");
    
    if (sscanf(arg, "%s %d", arg, hole_number) == 2)
    {
        equip = present(arg, me);
        if (!equip)
            return notify_fail("你身上没有这件装备。\n");
        
        if (equip->query("equipped"))
            return notify_fail("你必须先卸下这件装备才能拆卸宝石。\n");
            
        if(equip->item_owner() != me->query("id"))
            return notify_fail(equip->name() + "不需要你来操心吧！\n");
        
        
        return do_remove_gem(me, equip, hole_number);
    }
    else
    {
        equip = present(arg, me);
        if (!equip)
            return notify_fail("你身上没有这件装备。\n");
        
        if (equip->query("equipped"))
            return notify_fail("你必须先卸下这件装备才能拆卸宝石。\n");
        
        return show_gem_selection(me, equip);
    }
}

int show_gem_selection(object me, object equip)
{
    mapping hole_info;
    string *buttons = ({});
    string str, gem_name;
    int i, holes;
    
    hole_info = equip->query("hole_info");
    if (!hole_info)
        return notify_fail("这件装备没有镶嵌任何宝石。\n");
    
    holes = hole_info["holes"] || 0;
    
    for (i = 1; i <= holes; i++)
    {
        gem_name = hole_info["gem_name_" + i];
        if (gem_name)
        {
            buttons += ({ gem_name + ":remove_gem " + equip->query("id") + " " + i });
        }
    }
    
    if (sizeof(buttons) == 0)
        return notify_fail("这件装备没有镶嵌任何宝石。\n");
    
    str = popup_comb("请选择要拆卸的宝石", buttons);
    tell_object(me, str);
    
    return 1;
}

int do_remove_gem(object me, object equip, int hole_number)
{
    mapping hole_info;
    string gem_type, gem_name, gem_color;
    int gem_level;
    object gem;
    mapping player_gem_count;

    // remover = present("gem remover", me);
    // if (!remover)
        // return notify_fail("你需要一张宝石拆卸符来拆卸宝石。\n");

    hole_info = equip->query("hole_info");
    if (!hole_info)
        return notify_fail("这件装备没有镶嵌任何宝石。\n");
    
    if (hole_number < 1 || hole_number > (hole_info["holes"] || 0))
        return notify_fail("无效的孔位编号。\n");
    
    gem_type = hole_info["gem_type_" + hole_number];
    gem_name = hole_info["gem_name_" + hole_number];
    gem_level = hole_info["gem_level_" + hole_number];
    
    if (!gem_type || !gem_name || !gem_level)
        return notify_fail("这个孔位没有镶嵌宝石。\n");
    
    gem_color = hole_info["gem" + hole_number];
    gem = new(sprintf("/clone/baoshi/%s_baoshi_%d", gem_type, gem_level));
    
    if (!objectp(gem))
        return notify_fail("无法创建宝石对象。\n");
    
    // 消耗一张宝石拆卸符
    // remover->add_amount(-1);
    
    // 从装备中移除宝石信息
    map_delete(hole_info, "gem" + hole_number);
    map_delete(hole_info, "gem_type_" + hole_number);
    map_delete(hole_info, "gem_level_" + hole_number);
    map_delete(hole_info, "gem_name_" + hole_number);
    equip->set("hole_info", hole_info);
    
    // 更新玩家的宝石镶嵌计数
    player_gem_count = me->query("gem_embed_count") || ([]);
    if (player_gem_count[gem_color] && player_gem_count[gem_color][gem_type])
        player_gem_count[gem_color][gem_type]--;
    me->set("gem_embed_count", player_gem_count);
    
    // 将宝石交给玩家
    if (gem->move(me))
    {
        message_vision("$N使用了一张宝石拆卸符,从" + equip->name() + "上小心翼翼地拆下了一颗" + gem->name() + "。\n", me);
        return 1;
    }
    else
    {
        destruct(gem);
        return notify_fail("无法将宝石给予玩家。\n");
    }
}

int help(object me)
{
    write(@HELP
指令格式：remove_gem <装备ID> [<孔位编号>]

这个指令让你从指定的装备上拆卸宝石。注意，你必须先卸下装备才能拆卸宝石。

如果不指定孔位编号，系统会显示一个选择界面让你选择要拆卸的宝石。

示例：
  remove_gem armor     - 从ID为armor的装备上选择要拆卸的宝石
  remove_gem armor 1   - 从ID为armor的装备的第1个孔位拆卸宝石

HELP );
    return 1;
}