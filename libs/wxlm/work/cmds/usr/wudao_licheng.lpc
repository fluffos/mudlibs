// 函数声明
string format_achievement_time(int age, int month);
string get_achievement_color(string achievement_type);

/**
 * @brief 格式化成就达成时间
 * @param int age 达成时的年龄
 * @param int month 达成时的月份
 * @return string 格式化后的时间字符串
 * @details 将年龄和月份格式化为易读的时间描述
 */
string format_achievement_time(int age, int month)
{
    string result;

    result = "";
    if (age > 0)
    {
        result += chinese_number(age) + "载";
        if (month > 0)
            result += chinese_number(month) + "月";
    }
    else
    {
        result = "未知时间";
    }

    return result;
}

/**
 * @brief 获取成就类型对应的颜色代码
 * @param string achievement_type 成就类型
 * @return string 颜色代码
 * @details 根据成就类型返回对应的ANSI颜色代码
 */
string get_achievement_color(string achievement_type)
{
    switch(achievement_type)
    {
        case "宗师":
            return HIY;
        case "武尊":
            return HIR;
        case "武圣":
            return HIM;
        default:
            return HIC;
    }
}

/**
 * @brief 显示玩家的武道历程成就记录
 * @param object me 玩家对象
 * @param string arg 命令参数（暂未使用）
 * @return int 总是返回1
 * @details 使用弹窗展示玩家在修炼过程中达成的重要成就及时间
 */
int main(object me, string arg)
{
    string msg, color, latest_achievement;
    int ultra_age, ultra_month, sanhua_age, sanhua_month;
    int zhuanshi_age, zhuanshi_month;
    int has_achievement;

    msg = HIM "【武道历程】" NOR + "\n\n";
    has_achievement = 0;
    latest_achievement = "";

    // 获取宗师成就信息
    if (me->query("opinion/ultra"))
    {
        ultra_age = me->query("opinion/ultra_age");
        ultra_month = me->query("opinion/ultra_month");

        color = get_achievement_color("宗师");
        latest_achievement = sprintf(color + "【宗师境界】" NOR + " - 于 " + HIG + "%s" + NOR + " 踏入宗师之境\n",
            format_achievement_time(ultra_age, ultra_month));
        has_achievement = 1;
    }

    // 获取武尊（三花聚顶）成就信息
    if (me->query("sanhua_done"))
    {
        sanhua_age = me->query("sanhua_age");
        sanhua_month = me->query("sanhua_month");

        color = get_achievement_color("武尊");
        latest_achievement = sprintf(color + "【三花聚顶】" NOR + " - 于 " + HIG + "%s" + NOR + " 成就武尊之位\n",
            format_achievement_time(sanhua_age, sanhua_month));
        has_achievement = 1;
    }

    // 获取武圣（五气朝元）成就信息（最高成就，会覆盖前面的）
    if (me->query("wuqi_done"))
    {
        zhuanshi_age = me->query("wusheng_age");
        zhuanshi_month = me->query("wusheng_month");

        color = get_achievement_color("武圣");
        latest_achievement = sprintf(color + "【五气朝元】" NOR + " - 于 " + HIG + "%s" + NOR + " 成就武圣之位\n",
            format_achievement_time(zhuanshi_age, zhuanshi_month));
        has_achievement = 1;
    }

    // 如果没有任何成就记录
    if (!has_achievement)
    {
        msg += HIW "尚无武道成就记录，继续努力修炼吧！" NOR;
    }
    else
    {
        msg += latest_achievement;
    }

    // 使用popup_title弹窗显示（只接受一个字符串参数）
    write(popup_title(msg));

    return 1;
}
