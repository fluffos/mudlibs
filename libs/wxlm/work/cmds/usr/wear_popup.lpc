inherit F_CLEAN_UP;


int wear_popup(object me,string type);

int main(object me,string arg)
{
    wear_popup(me,arg);
    return 1;
}

//装备更换函数
int wear_popup(object me,string type)
{
	object *inv,obj;
    string str,*buttons = ({});

	inv = all_inventory(me);
    

	foreach (obj in inv)
    {
	    if (obj->query("armor_type") == type || obj->query("material") == type)
	    {
            if (me->query_temp("armor/" + type) == obj)
                buttons += ({HIR"脱下" + obj->query("name") + ":" + "remove " + obj->query("id")});
                else
                buttons += ({obj->query("name") + ":" + "look " + obj->query("id")});
        }
        else if (obj->query("skill_type") && (obj->query("material") || obj->gongji())&& type == "weapon" )
        {
            if (me->query_temp("weapon") == obj)
                buttons += ({HIR"卸下" + obj->query("name") + ":" + "unwield " + obj->query("id")});
                else
                buttons += ({obj->query("name") + ":" + "look " + obj->query("id")});
        }
        else if (obj->query("second_weapon") && type == "second_weapon")
        {
            if (me->query_temp("second_weapon") == obj) 
                buttons += ({HIR"卸下" + obj->query("name") + ":" + "unwield " + obj->query("id")});

            else
                buttons += ({obj->query("name") + ":" + "look " + obj->query("id")});
        }

    }

    if (sizeof(buttons))
    {
        str = popup_comb("请选择装备",buttons);
    }
    else
    {
        str = popup_title("没有任何装备");
    }

    tell_object(me,str);
    return 1;
} 