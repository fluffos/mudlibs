    string msg, *buttons = ({});
    
    msg = HIY "≡ 武圣之躯系统帮助 ≡\n" NOR;
    msg += "\n" HIW "系统概述：\n" NOR;
    msg += "武圣之躯以人体五脏六腑为核心，通过特殊的炼体之法强化身体机能，\n";
    msg += "提升各项基础属性。每个脏器最高可修炼至100级。\n\n";
    
    msg += HIW "五脏功能及数值加成：\n" NOR;
    msg += RED "● 心脏（生命之源）\n" NOR;
    msg += "  主要加成：气血上限、气血恢复速度\n";
