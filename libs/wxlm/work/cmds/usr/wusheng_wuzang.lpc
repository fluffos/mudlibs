/**
 * @file wusheng_wuzang.c
 * @author AI Assistant
 * @brief 武圣之躯系统用户指令
 * @version 1.0
 * @date 2024
 */

#define WUSHENG_MASTER "/system/wusheng/wusheng_master"

inherit F_CLEAN_UP;
int show_wuzang_detail(object me, string organ);
int handle_upgrade(object me, string organ, int use_dan);
int confirm_upgrade(object me, string organ, int use_dan);
int show_help(object me);
int show_wuzang_overview(object me);
string get_material_name(string material);
string get_bonus_name(string bonus);
int get_player_item_amount(object me, string item_id);
int calculate_current_bonus(object me, string organ, string bonus_type, int level);
void create()
{
    seteuid(getuid());
}

void init()
{
    add_action("do_lianti", "lianti");
    add_action("do_lianti", "炼体");
}

/**
 * @brief 主命令处理函数
 * @param object me 玩家对象
 * @param string arg 命令参数
 * @return int 1表示成功处理
 */
int main(object me, string arg)
{
    string cmd, param;
    
    if (!me || !objectp(me))
        return 0;

    // 检查武圣系统开启条件
    if (!WUSHENG_MASTER->check_wusheng_condition(me))
    {
        tell_object(me, popup_title("你的等级不足100级，暂时无法开启武圣之躯系统。"));
        return 1;
    }

    if (!arg)
    {
        return show_wuzang_overview(me);
    }

    if (sscanf(arg, "%s %s", cmd, param) != 2)
    {
        cmd = arg;
        param = "";
    }

    switch (cmd)
    {
    case "overview":
    case "总览":
        return show_wuzang_overview(me);
        
    case "detail":
    case "详情":
        return show_wuzang_detail(me, param);
        
    case "upgrade":
    case "炼体":
        {
            string organ, use_dan_str;
            int use_dan;
            
            if (sscanf(param, "%s %s", organ, use_dan_str) == 2)
            {
                use_dan = atoi(use_dan_str);
                return handle_upgrade(me, organ, use_dan);
            }
            else
            {
                return handle_upgrade(me, param, 0); // 默认不使用炼体丹
            }
        }
        
    case "confirm":
    case "确认":
        {
            string organ, use_dan_str;
            int use_dan;
            
            if (sscanf(param, "%s %s", organ, use_dan_str) == 2)
            {
                use_dan = atoi(use_dan_str);
                return confirm_upgrade(me, organ, use_dan);
            }
            else
            {
                return confirm_upgrade(me, param, 0); // 默认不使用炼体丹
            }
        }
        
    case "help":
    case "帮助":
        return show_help(me);
        
    default:
        return show_wuzang_overview(me);
    }
}

/**
 * @brief 显示五脏炼体总览
 * @param object me 玩家对象
 * @return int 1表示成功
 */
int show_wuzang_overview(object me)
{
    mapping overview, info;
    string msg, *buttons = ({}), *organs = ({ "heart", "liver", "spleen", "lung", "kidney" }), color;
    
    overview = WUSHENG_MASTER->get_wuzang_overview(me);
    
    msg = HIY "≡" HIW " 武圣之躯 · 五脏炼体 " HIY "≡\n" NOR;
    msg += HIB "人体五脏六腑，乃生命之本，修炼之基。\n" NOR;
    msg += "通过特殊的炼体法门，可强化五脏机能，突破凡体桎梏。\n\n";
    
    // 显示五脏状态
    foreach (string organ in organs)
    {
        info = overview[organ];
        color = info["color"];
        
        msg += sprintf("%s%s%s %d级 (%s)\n",
                      color, info["name"], NOR,
                      info["level"], info["stage"]);
        
        buttons += ({ sprintf("%s详情:wusheng_wuzang detail %s", info["name"], organ) });
    }
    
    msg += "\n" HIY "说明：" NOR "每个脏器都可以独立炼体提升，不同脏器提供不同的属性加成。\n";
    
    buttons += ({ "系统帮助:wusheng_wuzang help" });
    
    tell_object(me, popup_comb(msg, buttons));
    return 1;
}

/**
 * @brief 显示指定五脏的详细信息
 * @param object me 玩家对象
 * @param string organ 脏器名称
 * @return int 1表示成功
 */
int show_wuzang_detail(object me, string organ)
{
    mapping detail;
    string msg, *buttons = ({}), color, *main_bonus, *sub_bonus;
    int current_level, player_material_amount;
    
    if (!organ)
    {
        tell_object(me, popup_title("请指定要查看的脏器。"));
        return 1;
    }
    
    detail = WUSHENG_MASTER->get_wuzang_detail(me, organ);
    if (!detail)
    {
        tell_object(me, popup_title("未找到指定的脏器信息。"));
        return 1;
    }
    
    color = detail["color"];
    msg = sprintf("%s≡ %s%s%s 详情 ≡\n", HIY, color, detail["name"], HIY) + NOR;
    msg += sprintf("%s\n\n", detail["desc"]);
    
    msg += sprintf("当前等级：%s%d级%s (%s)\n", 
                   HIW, detail["level"], NOR, detail["stage"]);
    
    // 显示属性加成
    msg += "\n" HIY "属性加成：\n" NOR;
    main_bonus = keys(detail["main_bonus"]);
    sub_bonus = keys(detail["sub_bonus"]);
    
    // 显示主要加成及当前数值
    msg += HIW "主要加成：" NOR;
    foreach (string bonus in main_bonus)
    {
        int current_bonus = calculate_current_bonus(me, organ, bonus, detail["level"]);
        if (current_bonus > 0)
        {
            msg += sprintf("%s(+%d) ", get_bonus_name(bonus), current_bonus);
        }
        else
        {
            msg += get_bonus_name(bonus) + " ";
        }
    }
    msg += "\n";
    
    // 显示次要加成及当前数值
    msg += HIB "次要加成：" NOR;
    foreach (string bonus in sub_bonus)
    {
        int current_bonus = calculate_current_bonus(me, organ, bonus, detail["level"]);
        if (current_bonus > 0)
        {
            msg += sprintf("%s(+%d) ", get_bonus_name(bonus), current_bonus);
        }
        else
        {
            msg += get_bonus_name(bonus) + " ";
        }
    }
    msg += "\n";
    
    // 显示升级信息
    if (detail["can_upgrade"])
    {
        mapping dan_info = detail["dan_info"];
        
        msg += sprintf("\n" HIY "下级升级需求：\n" NOR);
        msg += sprintf("需要经验：%s%d%s\n", HIR, detail["need_exp"], NOR);
        msg += sprintf("需要材料：%s %d个", 
                       get_material_name(detail["material"]), detail["need_materials"]);
        
        // 显示当前拥有的材料数量
        player_material_amount = get_player_item_amount(me, detail["material"]);
        if (player_material_amount >= detail["need_materials"])
        {
            msg += sprintf(" %s(拥有:%d)%s\n", HIG, player_material_amount, NOR);
        }
        else
        {
            msg += sprintf(" %s(拥有:%d,不足)%s\n", HIR, player_material_amount, NOR);
        }
        
        msg += sprintf("\n" HIY "炼体成功率：\n" NOR);
        msg += sprintf("基础成功率：%s10%%%s\n", HIW, NOR);
        
        if (dan_info["has_dan"])
        {
            msg += sprintf("使用%s：%s%d%%%s", 
                          dan_info["dan_name"], HIG, 
                          10 + dan_info["boost"], NOR);
            msg += sprintf(" %s(拥有:%d)%s\n", HIW, dan_info["total_amount"], NOR);
        }
        else
        {
            msg += HIB "无可用炼体丹\n" NOR;
        }
        
                 // 检查是否满足升级条件
         current_level = detail["level"];
         if (me->query("combat_exp") >= detail["need_exp"] && 
             WUSHENG_MASTER->check_material_enough(me, organ, current_level))
        {
            buttons += ({ sprintf("直接炼体(10%%):wusheng_wuzang upgrade %s 0", organ) });
            
            if (dan_info["has_dan"])
            {
                buttons += ({ sprintf("使用丹药炼体(%d%%):wusheng_wuzang upgrade %s 1", 
                                     10 + dan_info["boost"], organ) });
            }
        }
        else
        {
            msg += HIR "\n升级条件不足。\n" NOR;
        }
    }
    else
    {
        msg += HIR "\n该脏器已炼体至圆满境界。\n" NOR;
    }
    
    buttons += ({ "返回总览:wusheng_wuzang overview" });
    
    tell_object(me, popup_comb(msg, buttons));
    return 1;
}

/**
 * @brief 处理炼体升级请求
 * @param object me 玩家对象
 * @param string organ 脏器名称
 * @param int use_dan 是否使用炼体丹
 * @return int 1表示成功
 */
int handle_upgrade(object me, string organ, int use_dan)
{
    mapping detail;
    string msg, *buttons = ({}), next_stage, color;
    int current_level;
    
    if (!organ)
    {
        tell_object(me, popup_title("请指定要炼体的脏器。"));
        return 1;
    }
    
    detail = WUSHENG_MASTER->get_wuzang_detail(me, organ);
    if (!detail)
    {
        tell_object(me, popup_title("未找到指定的脏器信息。"));
        return 1;
    }
    
    if (!detail["can_upgrade"])
    {
        tell_object(me, popup_title(sprintf("%s已经炼体至圆满境界，无法继续提升。", 
                                           detail["name"])));
        return 1;
    }
    
    current_level = detail["level"];
    next_stage = WUSHENG_MASTER->get_level_stage(current_level + 1);
    
    // 检查升级条件
    if (me->query("combat_exp") < detail["need_exp"])
    {
        tell_object(me, popup_title(sprintf("经验不足，需要%d点经验。", 
                                           detail["need_exp"])));
        return 1;
    }
    
    if (!WUSHENG_MASTER->check_material_enough(me, organ, current_level))
    {
        tell_object(me, popup_title(sprintf("材料不足，需要%s %d个。", 
                                           get_material_name(detail["material"]), 
                                           detail["need_materials"])));
        return 1;
    }
    
    // 确认升级
    color = detail["color"];
    msg = sprintf("%s≡ 炼体确认 ≡\n", HIY) + NOR;
    msg += sprintf("准备对%s%s%s进行炼体提升\n\n", color, detail["name"], NOR);
    
    msg += sprintf("当前等级：%d级 (%s)\n", current_level, detail["stage"]);
    msg += sprintf("提升后：%d级 (%s)\n\n", current_level + 1, next_stage);
    
    msg += HIR "将消耗：\n" NOR;
    msg += sprintf("经验：%d点\n", detail["need_exp"]);
    msg += sprintf("材料：%s %d个\n", 
                   get_material_name(detail["material"]), detail["need_materials"]);
    
    if (use_dan)
    {
        mapping dan_info = detail["dan_info"];
        if (dan_info["has_dan"])
        {
            msg += sprintf("炼体丹：%s 1个\n", dan_info["dan_name"]);
            msg += sprintf("成功率：%s%d%%%s\n", HIG, (10 + dan_info["boost"] + me->query("wusheng/lianti_success_rate")), NOR);
        }
        else
        {
            tell_object(me, popup_title("没有可用的炼体丹。"));
            return 1;
        }
    }
    else
    {
        msg += sprintf("成功率：%s%d%%%s\n", HIW, (10 + me->query("wusheng/lianti_success_rate")), NOR);
    }
    
    msg += HIY "\n炼体过程不可逆转，失败将损失材料和经验！\n" NOR;
    
    buttons += ({ sprintf("确认炼体:wusheng_wuzang confirm %s %d", organ, use_dan) });
    buttons += ({ sprintf("返回详情:wusheng_wuzang detail %s", organ) });
    
    tell_object(me, popup_comb(msg, buttons));
    return 1;
}

/**
 * @brief 确认执行炼体升级
 * @param object me 玩家对象
 * @param string organ 脏器名称
 * @param int use_dan 是否使用炼体丹
 * @return int 1表示成功
 */
int confirm_upgrade(object me, string organ, int use_dan)
{
    mapping detail;
    string msg, *buttons = ({}), color, new_stage;
    int current_level, result;
    
    if (!organ)
    {
        tell_object(me, popup_title("参数错误。"));
        return 1;
    }
    
    detail = WUSHENG_MASTER->get_wuzang_detail(me, organ);
    if (!detail)
    {
        tell_object(me, popup_title("未找到指定的脏器信息。"));
        return 1;
    }
    
    // 再次检查条件（防止重复点击等情况）
    current_level = detail["level"];
    if (!detail["can_upgrade"] || 
        me->query("combat_exp") < detail["need_exp"] ||
        !WUSHENG_MASTER->check_material_enough(me, organ, current_level))
    {
        tell_object(me, popup_title("升级条件已不满足，炼体失败。"));
        return 1;
    }
    
    // 执行升级
    result = WUSHENG_MASTER->upgrade_wuzang(me, organ, use_dan);
    
    if (result == 1)
    {
        // 成功
        color = detail["color"];
        new_stage = WUSHENG_MASTER->get_level_stage(current_level + 1);
        
        msg = sprintf("%s≡ 炼体成功 ≡\n", HIY) + NOR;
        msg += sprintf("%s%s%s炼体成功！\n\n", color, detail["name"], NOR);
        msg += sprintf("等级提升：%d级 → %s%d级%s\n", 
                      current_level, HIW, current_level + 1, NOR);
        msg += sprintf("境界突破：%s → %s%s%s\n\n", 
                      detail["stage"], HIG, new_stage, NOR);
        
        msg += HIG "你感到体内一阵暖流涌动，" + detail["name"] + "机能得到显著增强！\n" NOR;
        
        buttons += ({ sprintf("查看详情:wusheng_wuzang detail %s", organ) });
        buttons += ({ "返回总览:wusheng_wuzang overview" });
        
        // 记录日志
        log_file("wusheng", sprintf("%s (%s) 炼体成功：%s %d级 → %d级 %s\n",
                                   me->name(), me->query("id"), 
                                   detail["name"], current_level, current_level + 1,
                                   use_dan ? "(使用炼体丹)" : "(无炼体丹)"));
    }
    else if (result == -1)
    {
        // 失败
        msg = sprintf("%s≡ 炼体失败 ≡\n", HIR) + NOR;
        msg += sprintf("%s%s%s炼体失败！\n\n", detail["color"], detail["name"], NOR);
        msg += HIR "虽然失败了，但经验和材料已经消耗。\n" NOR;
        msg += HIY "不要灰心，继续努力修炼吧！\n" NOR;
        
        buttons += ({ sprintf("返回详情:wusheng_wuzang detail %s", organ) });
        buttons += ({ "返回总览:wusheng_wuzang overview" });
        
        // 记录日志
        log_file("wusheng", sprintf("%s (%s) 炼体失败：%s %d级 %s\n",
                                   me->name(), me->query("id"), 
                                   detail["name"], current_level,
                                   use_dan ? "(使用炼体丹)" : "(无炼体丹)"));
    }
    else
    {
        // 条件不满足
        msg = HIR "炼体失败，条件不满足。\n" NOR;
        buttons += ({ sprintf("返回详情:wusheng_wuzang detail %s", organ) });
    }
    
    tell_object(me, popup_comb(msg, buttons));
    return 1;
}

