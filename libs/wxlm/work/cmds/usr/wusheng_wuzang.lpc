    msg += "高级炼体丹(大成期)：+10%成功率 = 20%\n";
    msg += "圣级炼体丹(圆满期)：+10%成功率 = 20%\n\n";
    
    msg += HIR "失败机制：\n" NOR;
    msg += "● 炼体失败时消耗经验和材料\n";
    msg += "● 炼体失败时" HIW "消耗" NOR "炼体丹\n";
    msg += "● 炼体失败时，叠加上一次炼体成功的概率\n\n";
    
    msg += HIY "≡ 使用说明 ≡\n" NOR;
    msg += "开启条件：需要达到100级\n";
    msg += "炼体材料：血参果(心)、龙肝草(肝)、地脾黄(脾)、天肺莲(肺)、仙肾石(肾)\n";
    msg += "获取途径：通过任务、商店或其他活动获得\n\n";
    
    msg += HIR "重要提醒：\n" NOR;
    msg += "1. 炼体有失败风险，请合理使用炼体丹提升成功率\n";
    msg += "2. 材料和经验珍贵，建议充分准备后再进行炼体\n";
    msg += "3. 不同阶段的材料需求递增，请提前规划\n";
    
    buttons += ({ "返回总览:wusheng_wuzang overview" });
    
    tell_object(me, popup_comb(msg, buttons));
    return 1;
}

/**
 * @brief 炼体动作命令处理
 * @param string arg 命令参数
 * @return int 1表示成功处理
 */
int do_lianti(string arg)
{
    object me = this_player();
    
    if (!me)
        return 0;
        
    if (!arg)
    {
        return main(me, "overview");
    }
    
    return main(me, "upgrade " + arg + " 0"); // 默认不使用炼体丹
}

/**
 * @brief 获取属性加成的中文名称
 * @param string bonus 属性加成标识
 * @return string 中文名称
 */
string get_bonus_name(string bonus)
{
    switch (bonus)
    {
    case "max_qi": return "气血上限";
    case "qi_recover": return "气血恢复";
    case "max_neili": return "内力上限";
    case "neili_recover": return "内力恢复";
    case "max_jingli": return "精力上限";
    case "int_bonus": return "悟性加成";
    case "dex_bonus": return "身法加成";
    case "con_bonus": return "根骨加成";
    case "force_level": return "内功等级";
    case "parry_level": return "招架等级";
    case "dodge_level": return "轻功等级";
    case "crit_damage": return "暴击伤害";
    default: return bonus;
    }
}

/**
 * @brief 获取材料的中文名称
 * @param string material 材料标识
 * @return string 中文名称
 */
string get_material_name(string material)
{
    switch (material)
    {
    case "xuecanguo": return "血参果";
    case "longgan": return "龙肝草";
    case "dipi": return "地脾黄";
    case "tianfei": return "天肺莲";
    case "xianshen": return "仙肾石";
    default: return material;
    }
}

/**
 * @brief 获取玩家拥有指定物品的总数量
 * @param object me 玩家对象
 * @param string item_id 物品ID
 * @return int 总数量
 */
int get_player_item_amount(object me, string item_id)
{
    object *obs;
    int total_amount;
    
    if (!me)
        return 0;
        
    obs = filter(all_inventory(me), (: $1->query("id") == $(item_id) :));
    
    total_amount = 0;
    foreach (object ob in obs)
    {
        total_amount += ob->query_amount();
    }
    
    return total_amount;
}

/**
 * @brief 计算当前等级提供的属性加成数值
 * @param object me 玩家对象
 * @param string organ 脏器名称
 * @param string bonus_type 加成类型
 * @param int level 当前等级
 * @return int 当前提供的加成数值
 */
int calculate_current_bonus(object me, string organ, string bonus_type, int level)
{
    mapping detail;
    mapping main_bonus, sub_bonus;
    int *bonus_array;
    int stage_index, bonus_value;
    string stage;
    
    if (!me || level <= 0)
        return 0;
    
    detail = WUSHENG_MASTER->get_wuzang_detail(me, organ);
    if (!detail)
        return 0;
    
    main_bonus = detail["main_bonus"];
    sub_bonus = detail["sub_bonus"];
    
    // 获取当前阶段索引
    stage = WUSHENG_MASTER->get_level_stage(level);
    
    // 根据阶段确定索引
    switch (stage)
    {
    case "初炼期": stage_index = 0; break;
    case "小成期": stage_index = 1; break;
    case "大成期": stage_index = 2; break;
    case "圆满期": stage_index = 3; break;
    default: return 0;
    }
    
    // 检查主要加成
    if (main_bonus[bonus_type])
    {
        bonus_array = main_bonus[bonus_type];
        if (sizeof(bonus_array) > stage_index)
        {
            // 特殊处理：每10级提升的属性
            if (bonus_type == "int_bonus" || bonus_type == "dex_bonus" || 
                bonus_type == "con_bonus" || bonus_type == "crit_damage")
            {
                bonus_value = (level / 10) * bonus_array[stage_index];
            }
            else
            {
                bonus_value = level * bonus_array[stage_index];
            }
            return bonus_value;
        }
    }
    
    // 检查次要加成
    if (sub_bonus[bonus_type])
    {
        bonus_array = sub_bonus[bonus_type];
        if (sizeof(bonus_array) > stage_index)
        {
            bonus_value = level * bonus_array[stage_index];
            return bonus_value;
        }
    }
    
    return 0;
}
