


//函数声明
mapping *myscore_attribute_man(object me);
mapping *myscore_attribute_yueli(object me);
mapping *myscore_status(object me);
mapping *myscore_bamai(object me);
mapping *myscore_function(object me);
string display_attr(int gift, int value);
string status_color(int current, int max);
string chinese_space(int count);
string number_space(int count);

/**
 * @brief 生成指定个数的等宽中文空格
 * @param int count 空格个数
 * @return string 返回等宽中文空格字符串
 * @details 使用\u3000字符，每个字符等于一个中文字符的宽度
 */
string chinese_space(int count)
{
    string result;
    int i;
    
    result = "";
    for (i = 0; i < count; i++)
    {
        result += "\u3000";
    }
    return result;
}

/**
 * @brief 生成指定个数的等宽数字空格
 * @param int count 空格个数
 * @return string 返回等宽数字空格字符串
 * @details 使用\u2007（等宽数字空格）来生成指定个数的等宽空格，用于数字对齐
 */
string number_space(int count)
{
    string result;
    int i;
    
    result = "";
    for (i = 0; i < count; i++) {
        result += "\u2007";
    }
    return result;
}

/**
 * @brief 将数字格式化为固定宽度的字符串
 * @param int num 要格式化的数字
 * @param int width 目标宽度（字符数）
 * @return string 返回固定宽度的数字字符串
 * @details 将数字转换为字符串，然后在后面添加等宽数字空格以达到指定宽度
 */
string format_number_width(int num, int width)
{
    string num_str;
    int num_len, spaces_needed;
    
    num_str = sprintf("%d", num);
    num_len = strlen(num_str);
    spaces_needed = width - num_len;
    
    if (spaces_needed > 0) {
        return num_str + number_space(spaces_needed);
    }
    return num_str;
}

/**
 * @brief 将中文字符串格式化为固定宽度
 * @param string str 要格式化的中文字符串
 * @param int width 目标宽度（中文字符数）
 * @return string 返回固定宽度的中文字符串
 * @details 计算中文字符串的显示宽度，然后在后面添加等宽中文空格以达到指定宽度
 */
string format_chinese_width(string str, int width)
{
    int str_width, spaces_needed;
    
    // 简单估算：假设每个中文字符占2个宽度，英文字符占1个宽度
    // 这里使用strlen作为近似计算，实际可能需要更精确的计算

    str_width = strlen(filter_color(str));
    spaces_needed = width - str_width;
    
    if (spaces_needed > 0) {
        return str + chinese_space(spaces_needed);
    }
    return str;
}

