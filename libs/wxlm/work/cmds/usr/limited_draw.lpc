#define DEBUGGER "no-one"
#define PITY_LIMIT 100    // 保底次数
#define DAILY_LIMIT 50   // 每日抽奖次数限制

// 稀有度颜色
#define COLOR_ULTIMATE  HIR  // 终极奖励 (红色)
#define COLOR_TREASURE  HIY  // 珍藏奖励 (黄色)
#define COLOR_EPIC      HIM  // 史诗奖励 (品红)  
#define COLOR_RARE      HIC  // 稀有奖励 (青色)
#define COLOR_COMMON    HIG  // 普通奖励 (绿色)

// 活动时间定义
#define ACTIVITY_START 1756629606  // 2025-09-01 00:00:00
#define ACTIVITY_END   1758098406  // 2025-09-16 23:59:59

// 函数原型声明
void show_main_ui(object me);
void show_prize_pool(object me);
mapping do_single_draw(object me);
int process_single_draw(object me, string currency_type);
int process_ten_draw(object me, string currency_type);
int check_daily_limit(object me);
int is_in_activity_period();

/**
 * @brief 检查是否在活动期间
 * @return int 1-在活动期间，0-不在活动期间
 */
int is_in_activity_period()
{
    return (time() >= ACTIVITY_START && time() <= ACTIVITY_END);
    // return 1; // 测试期间可以打开此行
}

/**
 * @brief 检查每日抽奖次数限制
 * @param object me 玩家对象
 * @return int 1-可以抽奖，0-已达限制
 */
int check_daily_limit(object me)
{
    int last_draw_time = me->query("limited_last_draw_time");
    int today_draws = me->query("limited_today_draws");

    if (time() / 86400 != last_draw_time / 86400)
    {
        me->set("limited_today_draws", 0);
        today_draws = 0;
    }

    if (today_draws >= DAILY_LIMIT)
        return 0;

    return 1;
}

