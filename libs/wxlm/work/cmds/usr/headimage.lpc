int main(object me, string arg)
{
    mapping data = HEAD_IMAGE_MASTER->get_all_head_image_data(me);
    string msg;
    object pop1;

    // 处理兑换操作
    if (arg && sscanf(arg, "exchange %s", arg) == 1)
    {
        pop1 = new(POP1);

        if (HEAD_IMAGE_MASTER->exchange_head_image(me, arg))
        {
            mapping attrs = HEAD_IMAGE_MASTER->query_head_image_attributes(arg);
            if (sizeof(attrs))
            {
                msg = "恭喜！成功兑换头像「" + HEAD_IMAGE_MASTER->query_head_image_name(arg) + "」。\n";
                msg += "请选择一项属性加成：\n";
                foreach (string attr, int value in attrs)
                {
                    msg += sprintf("%s：+%d\n", attr, value);
                }
                pop1->basic(msg, 2);
                
                // 添加属性选择按钮
                foreach (string attr, int value in attrs)
                {
                    pop1->add_button(attr, "headimage attr " + arg + " " + attr);
                }
            }
            else
            {
                msg = "恭喜！成功兑换头像「" + HEAD_IMAGE_MASTER->query_head_image_name(arg) + "」。\n";
                pop1->basic(msg, 2);
                pop1->add_button("返回", "headimage");
            }
            write(pop1->result() + "\n");
        }
        else
        {
            msg = "兑换失败，请确认是否有足够的兑换材料。\n";
            pop1->basic(msg, 2);
            pop1->add_button("返回", "headimage");
            write(pop1->result() + "\n");
        }
        return 1;
    }

    {
        string head_id,attr;

        // 处理属性选择
        if (arg && sscanf(arg, "attr %s %s", head_id, attr) == 2)
        {
            pop1 = new(POP1);
            
            if (HEAD_IMAGE_MASTER->set_head_image_attribute(me, head_id, attr))
            {
                msg = "成功设置头像属性加成！\n";
            }
            else
            {
                msg = "设置属性加成失败，请确认选择是否有效。\n";
            }
            
            pop1->basic(msg, 2);
            pop1->add_button("返回", "headimage");
            write(pop1->result() + "\n");
            return 1;
        }
    }

    // 处理属性选择界面
    if (arg && sscanf(arg, "attr_select %s", arg) == 1)
    {
        mapping attrs = HEAD_IMAGE_MASTER->query_head_image_attributes(arg);
        pop1 = new(POP1);
        
        if (sizeof(attrs))
        {
            msg = "请为头像「" + HEAD_IMAGE_MASTER->query_head_image_name(arg) + "」选择一项属性加成：\n";
            foreach (string attr, int value in attrs)
            {
                msg += sprintf("%s：+%d\n", attr, value);
            }
            pop1->basic(msg, 2);
            
            // 添加属性选择按钮
            foreach (string attr, int value in attrs)
            {
                pop1->add_button(to_chinese(attr), "headimage attr " + arg + " " + attr);
            }
        }
        else
        {
            msg = "该头像没有可选择的属性加成。\n";
            pop1->basic(msg, 2);
        }
        
        pop1->add_button("返回", "headimage exchange");
        write(pop1->result() + "\n");
        return 1;
    }

    // 原有的头像列表显示逻辑
    if (!arg)
    {
        msg = json_encode(data) + "\n";

        tell_object(me, msg);
    }

    if (arg)
    {
        // 检查是否需要选择属性加成
        if (HEAD_IMAGE_MASTER->need_select_attribute(me, arg))
        {
            mapping attrs = HEAD_IMAGE_MASTER->query_head_image_attributes(arg);
            pop1 = new(POP1);
            
            msg = "请先为头像「" + HEAD_IMAGE_MASTER->query_head_image_name(arg) + "」选择一项属性加成，再使用头像：\n";
            foreach (string attr, int value in attrs)
            {
                msg += sprintf("%s：+%d\n", to_chinese(attr), value);
            }
            pop1->basic(msg, 2);
            
            // 添加属性选择按钮
            foreach (string attr, int value in attrs)
            {
                pop1->add_button(to_chinese(attr), "headimage attr " + arg + " " + attr);
            }
            write(pop1->result() + "\n");
            return 1;
        }
        
        if (HEAD_IMAGE_MASTER->set_head_image_status(me, arg))
        {
            me->force_me("headimage");
        }
        else
        {
            pop1 = new(POP1);
            msg = "设置头像失败,请检查是否满足条件。\n";
            pop1->basic(msg, 2);
            pop1->add_button("返回", "headimage");
            write(pop1->result() + "\n");
        }
    }

    return 1;
}