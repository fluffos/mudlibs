/**
 * @file jifen_shop_category.c
 * @author 系统
 * @brief 九月秋季限时积分商店分类查看
 * @version 1.0
 * @date 2025-09-01
 */

/**
 * @brief 主函数入口
 * @param object me 玩家对象
 * @param string arg 积分档位参数
 * @return int 执行结果
 */
int main(object me, string arg)
{
    int category;
    string msg;
    string *buttons = ({});
    int current_jifen = me->query("jiuyue_autumn_jifen");
    
    if (!arg || sscanf(arg, "%d", category) != 1)
    {
        write(popup_comb("参数错误！", ({"返回:jifen_shop"})));
        return 1;
    }
    
    msg = sprintf(HIY "【%d积分物品详情】\n" NOR, category);
    msg += sprintf(HIC "当前限时积分：%d\n" NOR, current_jifen);
    msg += "──────────────────────────\n";
    
    switch(category)
    {
        case 1000:
            msg += HIR "1000积分物品：\n" NOR;
            msg += "• 五彩神石 - 1000积分\n";
            msg += "• 意境卷轴 - 1000积分\n";
            msg += "• 紫色真意自选宝箱 - 1000积分\n";
            
            buttons += ({ "兑换五彩神石:jifen_shop wucai_shenshi" });
            buttons += ({ "兑换意境卷轴:jifen_shop aoyi_book" });
            buttons += ({ "兑换紫色真意:jifen_shop purple_zhenyi" });
            break;
            
        case 800:
            msg += HIY "800积分物品：\n" NOR;
            msg += "• 黄色真意自选宝箱 - 800积分\n";
            msg += "• 防具材料自选宝箱×2 - 800积分\n";
            msg += "• 冲脉丹自选宝箱×10 - 800积分\n";
            msg += "• 炼体丹自选宝箱×5 - 800积分\n";
            
            buttons += ({ "兑换黄色真意:jifen_shop yellow_zhenyi" });
            buttons += ({ "兑换防具材料×2:jifen_shop fangju_material_2" });
            buttons += ({ "兑换冲脉丹×10:jifen_shop chongmai_10" });
            buttons += ({ "兑换炼体丹×5:jifen_shop lianti_5" });
            break;
            
        case 500:
            msg += HIM "500积分物品：\n" NOR;
            msg += "• 冲脉丹自选宝箱×8 - 500积分\n";
            msg += "• 炼体丹自选宝箱×3 - 500积分\n";
            msg += "• 红色真意自选宝箱 - 500积分\n";
            
            buttons += ({ "兑换冲脉丹×8:jifen_shop chongmai_8" });
            buttons += ({ "兑换炼体丹×3:jifen_shop lianti_3" });
            buttons += ({ "兑换红色真意:jifen_shop red_zhenyi" });
            break;
            
        case 50:
            msg += HIC "50积分物品：\n" NOR;
            msg += "• 雾雨灵茶×5 - 50积分\n";
            msg += "• 五藏归元丹×5 - 50积分\n";
            msg += "• 九转金丹×5 - 50积分\n";
            msg += "• 秘传自选宝箱×5 - 50积分\n";
            
            buttons += ({ "兑换雾雨灵茶×5:jifen_shop wuyu_5" });
            buttons += ({ "兑换归元丹×5:jifen_shop guiyuan_5" });
            buttons += ({ "兑换九转金丹×5:jifen_shop jiuzhuan_5" });
            buttons += ({ "兑换秘传宝箱×5:jifen_shop mizhuan_5" });
            break;
            
        case 10:
            msg += HIG "10积分物品：\n" NOR;
            msg += "• 九转金丹(假) - 10积分\n";
            msg += "• 菩提子×5 - 10积分\n";
            msg += "• 福寿膏×5 - 10积分\n";
            msg += "• 千年灵芝×5 - 10积分\n";
            msg += "• 火红仙丹 - 10积分\n";
            msg += "• 醍醐仙丹 - 10积分\n";
            msg += "• 神力丸 - 10积分\n";
            msg += "• 洗髓丹 - 10积分\n";
            msg += "• 词符×10 - 10积分\n";
            
            buttons += ({ "假九转金丹:jifen_shop fake_jiuzhuan" });
            buttons += ({ "菩提子×5:jifen_shop puti_5" });
            buttons += ({ "福寿膏×5:jifen_shop fushougao_5" });
            buttons += ({ "灵芝×5:jifen_shop lingzhi_5" });
            buttons += ({ "火红仙丹:jifen_shop dex_dan" });
            buttons += ({ "醍醐仙丹:jifen_shop int_dan" });
            buttons += ({ "神力丸:jifen_shop str_dan" });
            buttons += ({ "洗髓丹:jifen_shop con_dan" });
            buttons += ({ "词符×10:jifen_shop cifu_10" });
            break;
            
        default:
            msg += "无效的积分档位！\n";
            break;
    }
    
    msg += "──────────────────────────\n";
    
    buttons += ({ "返回商店:jifen_shop" });
    
    tell_object(me, popup_comb(msg, buttons));
    return 1;
}