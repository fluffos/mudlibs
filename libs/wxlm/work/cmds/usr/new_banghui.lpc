inherit F_CLEAN_UP;
#include "/cmds/usr/banghui/banghui.h"
int create_zhudi_room(string new_file_zhudi_path,string origin_file_zhudi_path,string banghui_name);
object create_liangong_room(string banghui_name,object me,string place);
int main(object me, string arg)
{
	int all,page,i,j, index;
	object *t,obj,env;
	string str,short,text,*list,*list2,*mb,*mb1,add,*zhudi,*items;
	mapping bhinfo,user,max_list=([]);
	mapping result = ([
		"title": "背包",
		"w": "330",
		"h": "100",
		"close": ({
		}),
		"toggle": ({
			([ "text" : "帮会列表", "cmd" : "new_banghui ls 1" ]),
			([ "text" : "成员列表", "cmd" : "new_banghui mb 1" ]),
			([ "text" : "查看申请", "cmd" : "new_banghui add 1" ]),
		}),
		"data": ([
			"title": "",
			"context": ({})
		]),
		"is_cmd":"new_banghui ls 1"
	]);

	env = environment(me);

	if (me->is_busy())
	{
		return notify_fail(msg299("帮会系统","你现在正忙着呢。"));
	}

	if( !arg )
	{

		if(!(short=me->query("banghui/name")))
		{
			// 跳转到帮会列表页面
			me->force_me("new_banghui ls 1");
			return 1;
		}
		else
		{
			mapping jsonData = ([]);
			
			jsonData["code"] = "帮会驻地";
			text = "名称："+short+"　　　";
			text += "帮主："+TOP_D->get_name(BANGHUI_D->query_banghui(short+"/bangzhu"));
			text += ZJBR"一一一一一一一一一一一一一一一一一一一一一一一";
			text += ZJBR"等级："+BANGHUI_D->query_banghui(short+"/level")+
					"【"+BANGHUI_D->query_banghui(short+"/exp")+"/"+
					({1000,4000,9000,16000,25000,36000,49000,64000,81000,0})[BANGHUI_D->query_banghui(short+"/level")-1]+"】";
			text += "　　储备："+BANGHUI_D->query_banghui(short+"/chubei");
			text += ZJBR"一一一一一一一一一一一一一一一一一一一一一一一"ZJBR"公告：";
			if(BANGHUI_D->query_banghui(short+"/txt"))
				text += BANGHUI_D->query_banghui(short+"/txt");
			else
				text += "暂无公告！";
			text += ZJBR"一一一一一一一一一一一一一一一一一一一一一一一";
			text += ZJBR"副帮主：";
			if(zhudi=BANGHUI_D->query_banghui(short+"/fubang"))
			{
				for(i=0;i<sizeof(zhudi);i++)
				text += TOP_D->get_name(zhudi[i])+"，";
			}
			else
				text += "无";
			text += ZJBR"成员数："+CHINESE_D->chinese_number(sizeof(BANGHUI_D->query_banghui(short+"/member")))+"位";

			jsonData["info"] = text;
			jsonData["buttons"] = ({});
			jsonData["buttons"] += ({ ([ "text" : "帮会列表", "cmd" : "new_banghui ls 1","close_pupop" : "0" ]) });
			jsonData["buttons"] += ({ ([ "text" : "成员列表", "cmd" : "new_banghui mb 1" ,"close_pupop" : "0"]) });
			jsonData["buttons"] += ({ ([ "text" : "退出帮会", "cmd" : "new_banghui quit" ,"close_pupop" : "0"]) });
			jsonData["buttons"] += ({ ([ "text" : "前往驻地", "cmd" : "new_banghui zhudi","close_pupop" : "1" ]) });

			if(me->query("banghui/zhiwei")=="帮主")
			{
				jsonData["buttons"] += ({ ([ "text" : "编辑公告", "cmd" : "new_banghui txt","close_pupop" : "0" ]) });
				jsonData["buttons"] += ({ ([ "text" : "查看申请", "cmd" : "new_banghui add 1","close_pupop" : "0" ]) });
				jsonData["buttons"] += ({ ([ "text" : "解散帮会", "cmd" : "new_banghui jiesan","close_pupop" : "0" ]) });
				jsonData["buttons"] += ({ ([ "text" : "升级帮会", "cmd" : "new_banghui lvup","close_pupop" : "0" ]) });
				if(!BANGHUI_D->query_banghui(short+"/liangong"))
					jsonData["buttons"] += ({ ([ "text" : "解锁练功区", "cmd" : "new_banghui unlock_liangong","close_pupop" : "0" ]) });
			}
			else if(me->query("banghui/zhiwei")=="副帮主")
			{
				jsonData["buttons"] += ({ ([ "text" : "查看申请", "cmd" : "new_banghui add 1","close_pupop" : "0" ]) });
				jsonData["buttons"] += ({ ([ "text" : "编辑公告", "cmd" : "new_banghui txt","close_pupop" : "0" ]) });
			}

			if (playerp(me)) 
			{
				jsonData["buttons"] += ({ ([ "text" : "帮贡捐赠", "cmd" : "new_banghui gx","close_pupop" : "0" ]) });
			}

			
			write(json_encode(jsonData) + "\n");
		}
	} 
	else if (arg=="zhudi")
	{

		if(!(short=me->query("banghui/name")))
		{
			return notify_fail(msg299("帮会系统","你没有帮会怎么回驻地！"));
		}

		me->move(BANGHUI_D->query_banghui(short+"/zhudi_room"));
		tell_object(me,"你运气轻功一波快马加鞭，嗖嗖嗖，你回到了帮派驻地\n你累的缓不过气来！你喊到：真累！\n");
		me->start_busy(1);

	}
	else if( sscanf(arg,"attack %s",text)==1 )
	{
		if(!(short=me->query("banghui/name")))
			return notify_fail(msg299("帮会系统","你没有帮会怎么发起帮会战！"));

		if(me->query("banghui/zhiwei")!="帮主"&&me->query("banghui/zhiwei")!="副帮主")
			return notify_fail(msg299("帮会系统","你没有发起帮会战的权限！"));

		if(!BANGHUI_D->query_banghui(text))
			return notify_fail(msg299("帮会系统","没有这个帮会！"));

		if(!BANGHUI_D->query_banghui(text+"/zhudi"))
			return notify_fail(msg299("帮会系统","对方连驻地都没有你要攻打他啥？"));

		if(BANGHUI_D->query_banghui(short+"/chubei")<10000)
			return notify_fail(msg299("帮会系统","帮会储备不足10000，请有足够实力再发起帮会战！"));

		if(!BANGHUI_D->query_banghui(short+"/attackby"))
			BANGHUI_D->set_banghui(text+"/attackby",({short}));
		else
			BANGHUI_D->set_banghui(text+"/attackby",BANGHUI_D->query_banghui(short+"/attackby")+({short}));
	}
	else if( sscanf(arg,"txt %s",text)==1 )
	{
		if(!(short=me->query("banghui/name")))
			return notify_fail(msg299("帮会系统","你没有帮会发什么公告！"));

		if(me->query("banghui/zhiwei")!="帮主"&&me->query("banghui/zhiwei")!="副帮主")
			return notify_fail(msg299("帮会系统","你没有发公告的权限！"));

		BANGHUI_D->set_banghui(short+"/txt",text);
		write(ZJFORCECMD("new_banghui"));
	}
	else if( sscanf(arg,"ls %d",page)==1 )
	{
		mapping jsonData = ([]);

		list2 = BANGHUI_D->query_names();
		list = ({});

		if(!sizeof(list2))
		{
			result["data"]["title"] = "暂时没有任何帮会，你可以创建一个！";
		}
		else
		{
			for(i=0;i<sizeof(list2);i++)
			{
				string name, command;
				int member_number,level;


				member_number = sizeof(BANGHUI_D->query_banghui(list2[i]+"/member"));
				name = list2[i];
				command = "new_banghui cha "+list2[i];
				level = BANGHUI_D->query_banghui(list2[i]+"/level");

				name = sprintf("%s(%d级)"ZJBR"成员数：%d人",name,level,member_number);
				result["data"]["context"] += ({ ([ "text" : name , "cmd" : command]) });
			}
		}

		all = sizeof(list)/10;

		if(sizeof(list)%10) 
		{
			all += 1;
		}

		if(page<1)
		{
			page = 1;
		}

		if(page>all) 
		{
			page = all;
		}

		j = (page-1)*10;
		i = page*10;

		if (i >= sizeof(list))
		{
			i = sizeof(list);
		}

		i--;


		if(all>1)
		{
			result["close"] = ({ ([ "cmd" : "new_banghui ls "+(page-1), "text" : "上一页" ]) });
			result["close"] += ({ ([ "cmd" : "new_banghui ls "+(page+1), "text" : "下一页" ]) });
		}

		if (me->query("banghui/name"))
		{
			result["close"] += ({ ([ "cmd" : "new_banghui", "text" : "关闭" ]) });
		}
		else
		{
			result["close"] += ({ ([ "cmd" : "look", "text" : "关闭" ]) });
		}
		jsonData["code"] = "导航弹窗";
		jsonData["data"] = result;
		write(json_encode(jsonData)+"\n");
	}
	else if( sscanf(arg,"add %d",page)==1 )
	{
		mapping jsonData = ([]);

		if(!(short=me->query("banghui/name")))
			return notify_fail(msg299("帮会系统","你还没有帮会呢！"));

		mb = BANGHUI_D->query_banghui(short+"/shenqing");

		if(!pointerp(mb)||mb==({}))
		{
			// return notify_fail(msg299("帮会系统","没有人申请入帮！"));
			result["data"]["title"] = "没有人申请入帮！";
		}
		else
		result["data"]["title"] = short+"帮会入帮申请列表：";

		list = ({});
		mb1 = ({});

		//修正为json格式
		for(i=0;i<sizeof(mb);i++)
		{
			user = TOP_D->query_user(mb[i]);

			if (!user)
				continue;

			if(find_player(mb[i]))
				result["data"]["context"] += ({ ([ "text" : sprintf(HIG"%s　　在线"NOR, user["name"]), "cmd" : "new_banghui look2 "+mb[i]]) });
			else
				result["data"]["context"] += ({ ([ "text" : sprintf(HIG"%s　　离线"NOR, user["name"]), "cmd" : "new_banghui look2 "+mb[i]]) });

		}


		//处理分页逻辑
		all = sizeof(result["data"]["context"])/10;
		if(sizeof(result["data"]["context"])%10) 
		{
			all += 1;
		}
		if(page<1)
		{
			page = 1;
		}
		if(page>all) 
		{
			page = all;
		}
		j = (page-1)*10;
		i = page*10;
		if (i >= sizeof(result["data"]["context"]))
		{
			i = sizeof(result["data"]["context"]);
		}
		i--;
		if(all>1)
		{
			result["close"] = ({ ([ "cmd" : "new_banghui add "+(page-1), "text" : "上一页" ]) });
			result["close"] += ({ ([ "cmd" : "new_banghui add "+(page+1), "text" : "下一页" ]) });
		}

		result["close"] += ({ ([ "cmd" : "new_banghui", "text" : "关闭" ]) });
		result["is_cmd"] = "new_banghui add 1";

		jsonData["code"] = "导航弹窗";
		jsonData["data"] = result;

		write(json_encode(jsonData)+"\n");

	}
	else if( sscanf(arg,"addyes %s",add)==1 )
	{
		if(!(short=me->query("banghui/name")))
			return notify_fail(msg299("帮会系统","你还没有帮会呢！"));
		mb1 = BANGHUI_D->query_banghui(short+"/fubang");
		if(!mb1) mb1 = ({});
		if((BANGHUI_D->query_banghui(short+"/bangzhu")!=me->query("id"))&&(member_array(me->query("id"),mb1)==-1))
			return notify_fail(msg299("帮会系统","你没有收人的权利！"));
		list = BANGHUI_D->query_banghui(short+"/shenqing");
		mb = BANGHUI_D->query_banghui(short+"/member");

		if(sizeof(mb)>=(BANGHUI_D->query_banghui(short+"/level")*5+10))
			return notify_fail(msg299("帮会系统","帮会人数已达到等级上限！"));
		if(!pointerp(list)||(member_array(add,list)==-1))
			return notify_fail(msg299("帮会系统","此人没有申请入帮！"));
		if(member_array(add,mb)!=-1)
			return notify_fail(msg299("帮会系统","此人已在帮会了！"));
		user = TOP_D->query_user(add);
		if(!user)
			return notify_fail(msg299("帮会系统","没有这个人！"));
		if(!(obj=UPDATE_D->global_find_player(add)))
			return notify_fail(msg299("帮会系统","没有这个人！"));

		if(obj->query("banghui"))
		{
			BANGHUI_D->set_banghui(short+"/shenqing",list-({add}));
			return notify_fail(msg299("帮会系统","收人失败，此人已经有帮派了！"));
		}
		obj->set("banghui/name",short);
		obj->set("banghui/zhiwei","帮众");
		obj->save();
		CHANNEL_D->do_channel( me,"party",sprintf("%s加入本帮会，大家欢迎！", obj->query("name")) );

		list -= ({add});
		BANGHUI_D->set_banghui(short+"/shenqing",list);
		BANGHUI_D->set_banghui(short+"/member",mb+({add}));

		if(list!=({}))
			// write(ZJFORCECMD("new_banghui add 1"));
			me->force_me("new_banghui add 1");
		else
			// write(ZJFORCECMD("new_banghui mb 1"));
			me->force_me("new_banghui mb 1");
	}
	else if( sscanf(arg,"addno %s",add)==1 )
	{
		if(!(short=me->query("banghui/name")))
			return notify_fail(msg299("帮会系统","你还没有帮会呢！"));
		list = BANGHUI_D->query_banghui(short+"/shenqing");
		if(!pointerp(list)||(member_array(add,list)==-1))
			return notify_fail(msg299("帮会系统","此人没有申请入帮！"));
		mb1 = BANGHUI_D->query_banghui(short+"/fubang");
		if(!mb1) mb1 = ({});
		if((BANGHUI_D->query_banghui(short+"/bangzhu")!=me->query("id"))&&(member_array(me->query("id"),mb1)==-1))
			return notify_fail(msg299("帮会系统","你没有拒绝人的权利！"));
		list -= ({add});
		BANGHUI_D->set_banghui(short+"/shenqing",list);
		if(list!=({}))
			me->force_me("new_banghui add 1");
		else
			me->force_me("new_banghui mb 1");
	}
	else if( sscanf(arg,"cha %s",short)==1 )
	{
		if(!BANGHUI_D->query_banghui(short))
		return notify_fail(ZJOBLONG"无此帮会！\n");

		text = ZJOBLONG"名称："+short+"　　　";
		text += "帮主："+TOP_D->get_name(BANGHUI_D->query_banghui(short+"/bangzhu"));
			text += ZJBR"一一一一一一一一一一一一一一一一一一一一一一一";
		text += ZJBR"等级："+BANGHUI_D->query_banghui(short+"/level")+"【"+BANGHUI_D->query_banghui(short+"/exp")+"/"+BANGHUI_D->query_banghui (short+"/level")*BANGHUI_D->query_banghui(short+"/level")*BANGHUI_D->query_banghui(short+"/level")*10000+"】";
		if(zhudi=BANGHUI_D->query_banghui(short+"/zhudi"))
			text += ZJBR"驻地："+implode(zhudi,",");
		else
			text += ZJBR"驻地：无";
		text += ZJBR"一一一一一一一一一一一一一一一一一一一一一一一"ZJBR"公告：";
		if(BANGHUI_D->query_banghui(short+"/txt"))
			text += BANGHUI_D->query_banghui(short+"/txt");
		else
			text += "暂无公告！";
		text += ZJBR"一一一一一一一一一一一一一一一一一一一一一一一";
		text += ZJBR"副帮主：";
		if(zhudi=BANGHUI_D->query_banghui(short+"/fubang"))
		{
			for(i=0;i<sizeof(zhudi);i++)
			text += TOP_D->get_name(zhudi[i])+"，";
		}
		else
			text += "无";
		text += ZJBR"成员数："+CHINESE_D->chinese_number(sizeof(BANGHUI_D->query_banghui(short+"/member")))+"位";
		text += "\n"ZJOBACTS2+ZJMENUF(3,3,10,30);
		text += "申请加入:new_banghui join "+short;
		text += ZJSEP"返回列表:new_banghui ls 1";
		write(text+"\n");
	}
	else if( sscanf(arg,"gx %d",page)== 1 )
	{
		if(!(short=me->query("banghui/name")))
			return notify_fail(msg299("帮会系统","你还没有帮会呢！"));
		
		if (page < 10000)
			return notify_fail(msg299("帮会系统","最少10000两黄金起捐！"));
		if (page > 100000)
			return notify_fail(msg299("帮会系统","最多10万两黄金！"));
		
		if (me->query("balance") < page * 10000)
			return notify_fail(msg299("帮会系统","钱庄存款不够"+MONEY_D->money_str(page*10000)+"！"));
		
		BANGHUI_D->set_banghui(short+"/gongxian/"+me->query("id"), BANGHUI_D->query_banghui(short+"/gongxian/"+me->query("id"))+page/10000);
		BANGHUI_D->set_banghui(short+"/exp", BANGHUI_D->query_banghui(short+"/exp")+page/10000);
		me->add("balance", -(page * 10000));
		write(msg299("帮会系统","你为帮派捐献了"+MONEY_D->money_str(page)+"黄金。"));
		me->force_me("new_banghui");
	}
	else if( sscanf(arg,"gx_yuanbao %d",page)== 1 )
	{
		if(!(short=me->query("banghui/name")))
			return notify_fail(msg299("帮会系统","你还没有帮会呢！"));
		
		if (page < 1)
			return notify_fail(msg299("帮会系统","最少1元宝起捐！"));
		if (page > 10000)
			return notify_fail(msg299("帮会系统","最多1万元宝！"));
		
		if (me->query("yuanbao") < page)
			return notify_fail(msg299("帮会系统","你的元宝不够"+page+"个！"));
		
		BANGHUI_D->set_banghui(short+"/gongxian/"+me->query("id"), BANGHUI_D->query_banghui(short+"/gongxian/"+me->query("id"))+page);
		BANGHUI_D->set_banghui(short+"/exp", BANGHUI_D->query_banghui(short+"/exp")+page);
		me->add("yuanbao", -page);
		write(msg299("帮会系统","你为帮派捐献了"+page+"个元宝。"));
		me->force_me("new_banghui");
	}
	else if( sscanf(arg,"gx_bind_yuanbao %d",page)== 1 )
	{
		if(!(short=me->query("banghui/name")))
			return notify_fail(msg299("帮会系统","你还没有帮会呢！"));
		
		if (page < 2)
			return notify_fail(msg299("帮会系统","最少2绑定元宝起捐！"));
		if (page > 10000)
			return notify_fail(msg299("帮会系统","最多1万绑定元宝！"));
		
		if (me->query("bind_yuanbao") < page)
			return notify_fail(msg299("帮会系统","你的绑定元宝不够"+page+"个！"));
		
		BANGHUI_D->set_banghui(short+"/gongxian/"+me->query("id"), BANGHUI_D->query_banghui(short+"/gongxian/"+me->query("id"))+page/2);
		BANGHUI_D->set_banghui(short+"/exp", BANGHUI_D->query_banghui(short+"/exp")+page/2);
		me->add("bind_yuanbao", -page);
		write(msg299("帮会系统","你为帮派捐献了"+page+"个绑定元宝。"));
		me->force_me("new_banghui");
	}
	else if( sscanf(arg,"dhlist %s", add)==1 ) 
	{
		if(!(short=me->query("banghui/name")))
			return notify_fail(msg299("帮会系统","你还没有帮会呢！"));
		
		max_list += lista;
		if (BANGHUI_D->query_banghui(short+"/level") > 1)
			max_list += listb;
		if (BANGHUI_D->query_banghui(short+"/level") > 2)
			max_list += listc;
		if (BANGHUI_D->query_banghui(short+"/level") > 3)
			max_list += listd;
		
		if (!max_list[add])
			return notify_fail(msg299("帮会系统","你无法兑换该物品！"));
		
		if(!BANGHUI_D->query_banghui (short+"/gongxian/"+me->query("id"))
			||BANGHUI_D->query_banghui (short+"/gongxian/"+me->query("id")) < max_list[add])
			return notify_fail(msg299("帮会系统","你的贡献度不足！"));

		obj = new(add);
		if (obj->move(me)) {
			BANGHUI_D->set_banghui(short+"/gongxian/"+me->query("id"), BANGHUI_D->query_banghui (short+"/gongxian/"+me->query("id"))-max_list[add]);
			return notify_fail("你用"+max_list[add]+"点贡献度兑换了一"+obj->query("unit")+obj->query("name")+"。\n");
		} else
			return notify_fail(msg299("帮会系统","兑换失败，请检查包裹空间。"));
	}
	else
	if (arg == "dhlist")
	{
		if(!(short=me->query("banghui/name")))
			return notify_fail(msg299("帮会系统","你还没有帮会呢！"));
		
		str = ZJOBLONG"你目前可用的贡献还有"+
						BANGHUI_D->query_banghui (short+"/gongxian/"+me->query("id"))
										+"点，请选择兑换物品：\n"ZJOBACTS2+ZJMENUF(2,2,9,30);
		max_list = lista;
		if (BANGHUI_D->query_banghui(short+"/level") > 1)
			max_list += listb;
		
		items = keys(max_list);
		
		for(i=0;i<sizeof(items);i++)
		{
			str += items[i]->query("name")+ZJBR"贡献度："+max_list[items[i]]+":new_banghui dhlist "+items[i]+ZJSEP;
		}
		tell_object(me, str+"\n");
	} else
	if (arg == "lvup")
	{
		int exp_need;
		
		if(!(short=me->query("banghui/name")))
			return notify_fail(msg299("帮会系统","你还没有帮会呢！"));

		if(me->query("banghui/zhiwei")!="帮主")
			return notify_fail(msg299("帮会系统","只有帮主才能提升帮会的等级！"));
		
		if (BANGHUI_D->query_banghui(short+"/level") >= 10)
			return notify_fail(msg299("帮会系统","目前帮会等级最高只能升到十级！"));
		
		// 计算升级所需经验
		switch(BANGHUI_D->query_banghui(short+"/level")) {
			case 1: exp_need = 1000; break;
			case 2: exp_need = 4000; break; 
			case 3: exp_need = 9000; break;
			case 4: exp_need = 16000; break;
			case 5: exp_need = 25000; break;
			case 6: exp_need = 36000; break;
			case 7: exp_need = 49000; break;
			case 8: exp_need = 64000; break;
			case 9: exp_need = 81000; break;
		}
		
		if (BANGHUI_D->query_banghui(short+"/exp") < exp_need)
			return notify_fail(msg299("帮会系统","帮会贡献度不够！"));
		
		if(!objectp(obj = present("kuojian ling", me)))
			return notify_fail(msg299("帮会系统","你身上没有扩建令！"));
		
		index = BANGHUI_D->query_banghui(short+"/level") * 2;
		
		if (BANGHUI_D->query_banghui(short+"/level")>=5)
			index = BANGHUI_D->query_banghui(short+"/level")*4;
		
		if (obj->query_amount() < index)
			return notify_fail(msg299("帮会系统","你身上的扩建令不够"+index+"块！"));
		
		obj->add_amount(-index);
		BANGHUI_D->set_banghui(short+"/level", BANGHUI_D->query_banghui(short+"/level") + 1);
		CHANNEL_D->do_channel( me,"party",sprintf("%s把本帮会等级提升了一级！", me->name()) );
	}

	else if( arg=="quityes" )
	{
		if(!(short=me->query("banghui/name")))
			return notify_fail(msg299("帮会系统","你没有帮会不用脱离！"));
		if(me->query("banghui/zhiwei")=="帮主")
			return notify_fail(msg299("帮会系统","帮主不能脱离帮会！"));
		mb = BANGHUI_D->query_banghui(short+"/member");
		BANGHUI_D->set_banghui(short+"/member",mb-({me->query("id")}));
		me->delete("banghui");
		write(ZJOBLONG"你脱离了帮会 "+short+"。\n");
	}
	else if (arg == "gx")
	{
		if(!(short=me->query("banghui/name")))
			return notify_fail(msg299("帮会系统","你没有帮会！"));

		str = ZJOBLONG"请选择捐献类型：\n"ZJOBACTS2+ZJMENUF(3,3,10,30);
		str += "捐献黄金:new_banghui gx_gold"ZJSEP;
		str += "捐献元宝:new_banghui gx_yuanbao"ZJSEP;
		str += "捐献绑定元宝:new_banghui gx_bind";
		write(str+"\n");
	}
	else if (arg == "gx_gold")
	{
		if(!(short=me->query("banghui/name")))
			return notify_fail(msg299("帮会系统","你没有帮会！"));
		return notify_fail(INPUTTXT("请输入要捐献的黄金数量("HIY"黄金/两"NOR")：","new_banghui gx $txt#")+"\n");
	}
	else if (arg == "gx_yuanbao")
	{
		if(!(short=me->query("banghui/name")))
			return notify_fail(msg299("帮会系统","你没有帮会！"));
		return notify_fail(INPUTTXT("请输入要捐献的元宝数量("HIY"1元宝=1经验"NOR")：","new_banghui gx_yuanbao $txt#")+"\n");
	}
	else if (arg == "gx_bind")
	{
		if(!(short=me->query("banghui/name")))
			return notify_fail(msg299("帮会系统","你没有帮会！"));
		return notify_fail(INPUTTXT("请输入要捐献的绑定元宝数量("HIY"2绑定元宝=1经验"NOR")：","new_banghui gx_bind_yuanbao $txt#")+"\n");
	}
	else if( arg=="quit" )
	{
		if(!(short=me->query("banghui/name")))
			return notify_fail(msg299("帮会系统","你没有帮会不用脱离！"));
		if(me->query("banghui/zhiwei")=="帮主")
			return notify_fail(msg299("帮会系统","帮主不能脱离帮会！"));
		write(ZJOBLONG"你确定要脱离帮会吗？\n"ZJOBACTS2+ZJMENUF(3,3,10,30)+"确定:new_banghui quityes\n");
	}
	else if( arg=="jiesan" )
	{
		if(!(short=me->query("banghui/name")))
			return notify_fail(msg299("帮会系统","你没有帮会解散什么？"));
		if(me->query("banghui/zhiwei")!="帮主")
			return notify_fail(msg299("帮会系统","只有帮主才能解散帮会！"));
		write(ZJOBLONG"你确定要解散帮会吗？\n"ZJOBACTS2+ZJMENUF(3,3,10,30)+"确定:new_banghui jiesanyes\n");
	}
	else if( arg=="jiesanyes" )
	{
		if(!(short=me->query("banghui/name")))
			return notify_fail(msg299("帮会系统","你没有帮会解散什么？"));
		if(me->query("banghui/zhiwei")!="帮主")
			return notify_fail(msg299("帮会系统","只有帮主才能解散帮会！"));
		mb = BANGHUI_D->query_banghui(short+"/member");
		if(sizeof(mb)>1)
			return notify_fail(msg299("帮会系统","帮会中尚有成员在，不能解散帮会！"));
		BANGHUI_D->delete_banghui(short);
		me->delete("banghui");
		CHANNEL_D->do_channel(me,"chat","今日众兄弟金盆洗手归隐山林，解散【"+short+"】！");
		me->move("/d/city/guangchang");
		{
		// 删除帮会驻地目录
		string zhudi_dir = "/data/bangpai/"+getuid(me)+"/map/";
		if (zhudi_dir && file_size(zhudi_dir) == -2) {
			// 删除驻地目录下的所有文件
			string *files = get_dir(zhudi_dir + "/*");
			foreach (string file in files) {
				rm(zhudi_dir + "/" + file);
			}
			// 删除驻地目录
			rmdir(zhudi_dir);
		}
		}
		write(ZJOBLONG"你解散了帮会 "+short+"。\n");
	}
	else if( sscanf(arg,"join %s",short)==1 )
	{
		if(!BANGHUI_D->query_banghui(short))
			return notify_fail(msg299("帮会系统","无此帮会！"));
		if(me->query("banghui"))
			return notify_fail(msg299("帮会系统","你已经有帮会了！"));
		list = BANGHUI_D->query_banghui(short+"/shenqing");
		mb = BANGHUI_D->query_banghui(short+"/member");
		if(member_array(me->query("id"),mb)!=-1)
			return notify_fail(msg299("帮会系统","你已是此帮会的人了！"));
		if(pointerp(list)&&(member_array(me->query("id"),list)!=-1))
			return notify_fail(msg299("帮会系统","你已经申请过加入此帮会了，请联系帮会管理员等待回应！"));
		if(!pointerp(list))
			BANGHUI_D->set_banghui(short+"/shenqing",({me->query("id")}));
		else
			BANGHUI_D->set_banghui(short+"/shenqing",list+({me->query("id")}));
		write(ZJOBLONG"已发出入帮申请，请等待管理员审核！\n");
	}
	else if( sscanf(arg,"look1 %s",add)==1 )
	{
		if(!(short=me->query("banghui/name")))
			return notify_fail(msg299("帮会系统","你还没有帮会呢！"));
		list = BANGHUI_D->query_banghui(short+"/member");
		if(!pointerp(list)) list = ({});
		if(member_array(add,list)==-1)
			return notify_fail(msg299("帮会系统","你的帮会成员中没有此人！"));
		user = TOP_D->query_user(add);
		if(!user)
			return notify_fail(msg299("帮会系统","没有这个人！"));
		str = ZJOBLONG+user["name"]+ZJBR;
		str += "一一一一一一一一一一一一一一一一一一一一一一一"ZJBR;
		str += "修为："+user["combat_exp"];
		str += "    杀气："+user["PKS"];
		str += "\n"ZJOBACTS2+ZJMENUF(3,3,10,30);
		str += "返回列表:new_banghui mb 1";
		if(me->query("banghui/zhiwei")=="帮主")
		{
			str += ZJSEP"帮会任命:new_banghui renming "+add;
			str += ZJSEP"踢出帮会:new_banghui tiren "+add;
		}
		write(str+"\n");
	}
	else if( sscanf(arg,"look2 %s",add)==1 )
	{
		if(!(short=me->query("banghui/name")))
			return notify_fail(msg299("帮会系统","你还没有帮会呢！"));
		list2 = BANGHUI_D->query_banghui(short+"/shenqing");
		if(!pointerp(list2)) list2 = ({});
		if(member_array(add,list2)==-1)
			return notify_fail(msg299("帮会系统","你的帮会申请列表中没有此人！"));
		user = TOP_D->query_user(add);
		if(!user)
			return notify_fail(ZJOBLONG"没有这个人！\n");
		str = ZJOBLONG+user["name"]+ZJBR;
		str += "一一一一一一一一一一一一一一一一一一一一一一一"ZJBR;
		str += "修为："+user["combat_exp"];
		str += "    杀气："+user["PKS"];
		str += "\n"ZJOBACTS2+ZJMENUF(3,3,10,30);
		str += "返回列表:new_banghui add 1";
		if(me->query("banghui/zhiwei")=="帮主"||me->query("banghui/zhiwei")=="副帮主")
		{
			str += ZJSEP"同意申请:new_banghui addyes "+add;
			str += ZJSEP"拒绝申请:new_banghui addno "+add;
		}
		write(str+"\n");
	}
	else if( sscanf(arg,"tiren %s",add)==1 )
	{
		if(!(short=me->query("banghui/name")))
			return notify_fail(msg299("帮会系统","你还没有帮会呢！"));
		list = BANGHUI_D->query_banghui(short+"/member");
		if(!pointerp(list)||(member_array(add,list)==-1))
			return notify_fail(msg299("帮会系统","你的帮会没有此人！"));
		if(BANGHUI_D->query_banghui(short+"/bangzhu")!=me->query("id"))
			return notify_fail(msg299("帮会系统","你没有踢人的权利！"));
		if(me->query("id")==add)
			return notify_fail(msg299("帮会系统","你要踢自己的屁股？"));
		user = TOP_D->query_user(add);
		if(!user)
			return notify_fail(msg299("帮会系统","没有这个人！"));
		if(!(obj=UPDATE_D->global_find_player(add)))
			return notify_fail(msg299("帮会系统","没有这个人！"));
		obj->delete("banghui");
		obj->save();
		CHANNEL_D->do_channel( me,"party",sprintf("%s被开出帮会！", obj->query("name")) );

		if(!obj->query_temp("temp_loaded"))
			tell_object(obj,msg299("帮会系统","你被开出帮会了！"));

		BANGHUI_D->set_banghui(short+"/member",list-({add}));
		if((mb=BANGHUI_D->query_banghui(short+"/fubang"))&&member_array(add,mb)!=-1)
			BANGHUI_D->set_banghui(short+"/fubang",mb-({add}));
		me->force_me("new_banghui mb 1");
	}
	else if( sscanf(arg,"renming %s",add)==1 )
	{
		if(!(short=me->query("banghui/name")))
			return notify_fail(ZJOBLONG"你还没有帮会呢！\n");

		if( sscanf(add,"%s %s",add,text)!=2 )
		{
			return notify_fail(INPUTTXT("你要任命"+TOP_D->get_name(add)+"为什么？","new_banghui "+arg+" $txt#")+"\n");
		}
		list = BANGHUI_D->query_banghui(short+"/member");
		if(!mb = BANGHUI_D->query_banghui(short+"/fubang")) mb = ({});
		if(!pointerp(list)||(member_array(add,list)==-1))
			return notify_fail(ZJOBLONG"你的帮会没有此人！\n");
		if(BANGHUI_D->query_banghui(short+"/bangzhu")!=me->query("id"))
			return notify_fail(ZJOBLONG"你没有任命的权利！\n");
		if(me->query("id")==add)
			return notify_fail(ZJOBLONG"你要任命自己？\n");
		if(pointerp(mb)&&(member_array(add,mb)!=-1)) mb -= ({add});
		if(text=="帮主")
		{
			me->set("banghui/zhiwei","长老");
			BANGHUI_D->set_banghui(short+"/bangzhu",add);
		}
		else if(text=="副帮主")
		{
			if(mb&&sizeof(mb)>=2)
				return notify_fail(msg299("帮会系统","副帮主人数已满！"));
			else
			{
				mb += ({add});
			}
		}
		BANGHUI_D->set_banghui(short+"/fubang",mb);
		user = TOP_D->query_user(add);
		if(!user)
			return notify_fail(msg299("帮会系统","没有这个人！"));
		if(!(obj=UPDATE_D->global_find_player(add)))
			return notify_fail(msg299("帮会系统","没有这个人！"));
		obj->set("banghui/zhiwei",text);
		obj->save();
		CHANNEL_D->do_channel( me,"party",sprintf("%s被任命为【%s】！", obj->query("name"),text) );

		tell_object(me,ZJOBLONG"任命成功！\n");
	}
	else if( sscanf(arg,"mb %d",page)==1 )
	{
		if(!(short=me->query("banghui/name")))
		{
			// tell_object(me,ZJOBLONG"你目前还没有帮会！你可以集结好友组队创建一个，或者选择加入一个别人创建的帮会。\n");
			tell_object(me,msg299("帮会系统","你目前还没有帮会！你可以集结好友组队创建一个，或者选择加入一个别人创建的帮会。"));
		}
		else
		{
			int last_on;
			mapping jsonData = ([]);
			mb = BANGHUI_D->query_banghui(short+"/member");
			list = ({});
			mb1 = ({});
			jsonData = result;
			jsonData["data"]["title"] = short + "帮会成员：";
			jsonData["data"]["context"] = ({});
			jsonData["h"] = "150";
			
			for (i = 0; i < sizeof(mb); i++) {
				user = TOP_D->query_user(mb[i]);
			
				if (!user)
					continue;
			
				if (find_player(mb[i])) {
					jsonData["data"]["context"] += ({
						([ "text" : sprintf(HIG"%s　　在线"NOR+ZJBR+HIY"贡献：%d"NOR, user["name"], BANGHUI_D->query_banghui(short+"/gongxian/"+mb[i])),
						   "cmd" : "new_banghui look1 " + mb[i] ])
					});
				} else {
					last_on = FINGER_D->get_last_on(mb[i]);
					jsonData["data"]["context"] += ({
						([ "text" : sprintf(HIG"%s　　离线"NOR+ZJBR+HIY"贡献：%d"ZJBR"上次登录：%s"NOR, user["name"], BANGHUI_D->query_banghui(short+"/gongxian/"+mb[i]), CHINESE_D->chinese_date(last_on, 2)),
						   "cmd" : "new_banghui look1 " + mb[i] ])
					});
				}
			}
			
			// 处理分页逻辑
			all = sizeof(jsonData["data"]["context"]) / 10;
			if (sizeof(jsonData["data"]["context"]) % 10) {
				all += 1;
			}
			if (page < 1) {
				page = 1;
			}
			if (page > all) {
				page = all;
			}
			j = (page - 1) * 10;
			i = page * 10;
			if (i >= sizeof(jsonData["data"]["context"])) {
				i = sizeof(jsonData["data"]["context"]);
			}
			i--;
			
			if (all > 1) 
			{
				jsonData["close"] = ({ ([ "cmd" : "new_banghui mb " + (page - 1), "text" : "上一页" ]) });
				jsonData["close"] += ({ ([ "cmd" : "new_banghui mb " + (page + 1), "text" : "下一页" ]) });
			}

			jsonData["close"] += ({ ([ "cmd" : "new_banghui", "text" : "关闭" ]) });

			jsonData["is_cmd"] = "new_banghui mb 1";
			
			jsonData = ([
				"code":"导航弹窗",
				"data":jsonData,
			]);


			write(json_encode(jsonData) + "\n");
		}
	}
	// 帮会公告
	else if( arg == "txt" )
	{
		if(!(short=me->query("banghui/name")))
			return notify_fail(msg299("帮会系统","你还没有帮会呢！"));

		return notify_fail(INPUTTXT("请输入帮会公告：","new_banghui txt $txt#")+"\n");
	}
	// 创建帮会页面
	else if( arg == "create" )
	{
		// mapping jsonData;
		// jsonData = ([]);

		// jsonData["code"] = "创建帮会";
		// jsonData["description"] = "帮会建立说明：帮会建立的需要200元宝的启动资金,至少需要两名成员，默认队长为帮会队长。";//帮会建立说明
		// jsonData["cmd"] = "new_banghui create (banghui_name)(banghui_notice)";//帮会建立命令 (帮会名称)(帮会旗帜)(帮会宣言，代表的就是帮会公告)

		// write(json_encode(jsonData) + "\n");
		// write(popup_input("帮会建立说明：帮会建立的需要200元宝的启动资金,至少需要两名成员，默认队长为帮会队长,请输入帮会名字。","new_banghui create ($txt#)(banghui_notice)") + "\n");
		write(INPUTTXT("请输入帮会名字：","new_banghui create ($txt#)(空)") + "\n");
		return 1;

	}
	// 创建帮会操作接口
	else if( sscanf(arg,"create %s",short)==1 )
	{
		string *zhudi_allroom,zhudi_room;
		string banghui_notice;
		string *no_create_room = ({ "liangong.lpc" });

		if (sscanf(short,"(%s)(%s)",short,banghui_notice)!=2)
			return notify_fail(msg299("帮会系统","请输入正确的格式：banghui create (帮会名称) (帮会公告)"));

		zhudi_allroom=list_dirs("/d/bangpai/map/");

		if(me->query("banghui"))
			return notify_fail(msg299("帮会系统","请先脱离现在的帮会！"));

		if( !pointerp(t = me->query_team()) || sizeof(t)<2)
			return notify_fail(msg299("帮会系统","你必须和至少1名队友组队一起才能创建帮会！"));

		if(BANGHUI_D->query_banghui(short))
			return notify_fail(msg299("帮会系统","帮会名称已存在！"));

		for(i=0;i<sizeof(t);i++)
		{
			if (environment(t[i]) != env)
				return notify_fail(msg299("帮会系统","现在你队伍中有人还没有到场呢。"));
			if(t[i]->query("banghui"))
				return notify_fail(msg299("帮会系统","请确认队友目前都没有参加帮会！"));
		}

		if( !me->is_team_leader() )
			return notify_fail(msg299("帮会系统","队长才能确认创建帮会！"));
		if(!LOGIN_D->check_legal_name(short,10))
		{
			write(short+"不是一个合法的帮会名字！\n");
			return notify_fail(msg299("帮会系统","帮会名字不符合要求，建立失败！"));
		}

		if( me->query("yuanbao")<200 )
			return notify_fail(msg299("帮会系统","创建帮会需要"HIY"200元宝"NOR"！"));
		

		// 帮会公告不能超过30个字
		if (strlen(banghui_notice) > 30)
			return notify_fail(msg299("帮会系统","帮会宣言不能超过30个字！"));
			
		
		bhinfo = ([]);		
		bhinfo["level"] = 1;

		//目录使用建立人的id，为什么？lpc的gbk不支持uf8输入文件，报错。
		bhinfo["zhudi_room"] = "/data/bangpai/"+getuid(me)+"/map/guangchang";
		bhinfo["id"] = me->query("id")+"-"+sprintf("%d",time());
		bhinfo["member"] = t->query("id");

		//复制驻地文件
		foreach(zhudi_room in zhudi_allroom)
		{

			//是否是不可创建的房间
			if (member_array(zhudi_room, no_create_room) != -1)
				continue;

			create_zhudi_room("/data/bangpai/"+getuid(me)+"/map/"+zhudi_room, "/d/bangpai/map/"+zhudi_room, short);

			if (file_size("/data/bangpai/"+getuid(me)+"/map/"+zhudi_room) == -1)
			{
				return notify_fail(msg299("帮会系统",file_size("/d/bangpai/map/"+zhudi_room)+"号帮会驻地创建出错，建立失败，请联系管理员！"));
			}
		}

		t->set("banghui/name",short);		
		t->set("banghui/zhiwei","元老");
		me->set("banghui/zhiwei","帮主");


		me->add("yuanbao",-200);		
		bhinfo["bangzhu"] = me->query("id");
		BANGHUI_D->add_banghui(short,bhinfo);

		// 帮会公告
		BANGHUI_D->set_banghui(short+"/txt", banghui_notice);

		CHANNEL_D->do_channel(me,"chat","今日众兄弟歃血为盟，建立【"+short+"】！");
		tell_object(me,ZJOBLONG"恭喜，帮会建立成功！\n");
		me->force_me("new_banghui");
		me->save();
	}

	// 添加解锁练功区的处理逻辑
	else if (arg == "unlock_liangong")
	{
		if(!(short=me->query("banghui/name")))
			return notify_fail(msg299("帮会系统","你还没有帮会呢！"));

		if(me->query("banghui/zhiwei")!="帮主")
			return notify_fail(msg299("帮会系统","只有帮主才能解锁练功区！"));

		//当前room是否是帮会驻地,也就是bangpai_room是否存在
		if (!environment(me)->query("bangpai_room"))
		{
			return notify_fail(msg299("帮会系统","当前房间不是帮会驻地！"));
		}
		// 检查帮会等级是否达到3级
		if (BANGHUI_D->query_banghui(short+"/level") < 3)
			return notify_fail(msg299("帮会系统","帮会等级达到3级才可以解锁练功区！"));

		if(me->query("yuanbao") < 500)
			return notify_fail(msg299("帮会系统","解锁练功区需要500元宝！"));

		// 弹出方向选择窗口
		str = ZJOBLONG"请选择练功区的方向：\n"ZJOBACTS2+ZJMENUF(3,3,10,30);
		str += "东边:new_banghui create_liangong east"ZJSEP;
		str += "西边:new_banghui create_liangong west"ZJSEP;
		str += "南边:new_banghui create_liangong south"ZJSEP;
		str += "北边:new_banghui create_liangong north";
		write(str+"\n");
	}
	else if (sscanf(arg, "create_liangong %s", text)==1)
	{
		object liangong_room;

		if(!(short=me->query("banghui/name")))
			return notify_fail(msg299("帮会系统","你还没有帮会呢！"));

		if(me->query("banghui/zhiwei")!="帮主")
			return notify_fail(msg299("帮会系统","只有帮主才能解锁练功区！"));

		//当前room是否是帮会驻地
		if (!environment(me)->query("bangpai_room"))
		{
			return notify_fail(msg299("帮会系统","当前房间不是帮会驻地！"));
		}

		if(me->query("yuanbao") < 500)
			return notify_fail(msg299("帮会系统","解锁练功区需要500元宝！"));

		// 检查选择的方向是否已经有出口
		if (environment(me)->query("exits/"+text))
			return notify_fail(msg299("帮会系统","这个方向已经有房间了！"));

		// 创建练功房间
		liangong_room = create_liangong_room(short, me, text);
		
		if (!objectp(liangong_room))
			return notify_fail(msg299("帮会系统","练功房间创建失败！"));

		me->add("yuanbao", -500);

		//增加练功区数量记录
		BANGHUI_D->set_banghui(short+"/liangong",BANGHUI_D->query_banghui(short+"/liangong")+1);

		CHANNEL_D->do_channel(me, "party", sprintf("%s解锁了帮会练功区！", me->name()));
		write(msg299("帮会系统","成功解锁练功区！"));
		me->force_me("look");
	}

	return 1;
}

//预留逻辑区,需要实现create_liangong_room逻辑
int create_zhudi_room(string new_file_zhudi_path,string origin_file_zhudi_path,string banghui_name)
{

	origin_file_zhudi_path = replace_string(origin_file_zhudi_path,".lpc","");

    if (file_size(new_file_zhudi_path) == -1)
    {
        string str;
        assure_file(new_file_zhudi_path);
        str = read_file("/d/bangpai/zhudi_moban.d");
        str = replace_string(str,"path",origin_file_zhudi_path);
		str = replace_string(str,"$banghui_name",banghui_name);
        write_file(new_file_zhudi_path,str,1);
    }

    return file_size(new_file_zhudi_path);
}

// 创建练功区
//参数：帮会名称，玩家，方向(东，西，南，北)
object create_liangong_room(string banghui_name,object me,string place)
{
    object obj,env;
	string origin_file_liangong_path;
	string new_file_liangong_path;
	
	mapping exits_list = ([
		"east" : "west",
		"west" : "east", 
		"south" : "north",
		"north" : "south",
	]);

	origin_file_liangong_path = "/d/bangpai/map/liangong.lpc";
	new_file_liangong_path = "/data/bangpai/"+getuid(me)+"/map/liangong_" + time() + ".lpc";

	env = environment(me);

	BANGHUI_D->set_banghui(banghui_name+"/new_exits/" + replace_string(new_file_liangong_path,".lpc","") + "/" + exits_list[place], replace_string(base_name(env),".lpc",""));
	BANGHUI_D->set_banghui(banghui_name+"/new_exits/" + base_name(env) + "/" + place,replace_string(new_file_liangong_path,".lpc",""));
	
	create_zhudi_room(new_file_liangong_path,origin_file_liangong_path,banghui_name);
	obj = load_object(new_file_liangong_path);

	if (objectp(obj))
	{
		obj->load_exits();
	}

	env->load_exits();

	return obj;
}

