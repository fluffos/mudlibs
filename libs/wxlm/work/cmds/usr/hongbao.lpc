/**
 * @file hongbao.c
 * @author Lu dexiang
 * @brief 抢红包命令
 * @version 1.0
 * @date 2024-01-20
 */



inherit F_CLEAN_UP;

#define HONGBAO_D  "/adm/daemons/hongbaod"

int main(object me, string arg)
{
    mixed result;
    
    if (!me || !userp(me))
        return 0;

    //1737302400后再才可以使用
    if (time() < 1737302400) {
        return notify_fail("2025-01-20后开放！\n");
    }
        
    if (me->is_busy())
        return notify_fail("你现在正忙着呢。\n");
        
    if (me->is_fighting())
        return notify_fail("战斗中不能抢红包！\n");
        
    result = HONGBAO_D->get_hongbao(me);
    
    if (stringp(result))
        return notify_fail(result + "\n");
        
    me->start_busy(1);
    return 1;
}

int help(object me)
{
    write(@HELP
指令格式: hongbao

在红包雨活动期间使用此命令参与抢红包。
每次活动每人只能抢到一个红包。

活动时间：每天12:00、18:00、21:00
活动持续时间：10分钟

HELP );
    return 1;
} 