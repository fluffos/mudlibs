/**
 * @brief 武圣真意系统用户指令
 * @author LPC开发者  
 * @date 2024
 */

inherit F_CLEAN_UP;

//包含了所有函数原型声明，我们把它放到首位，以便后续所有函数协调工作。避免出现上下文找不到函数的报错问题
#include "zhenyi/shengming.h"    // 函数声明
#include "zhenyi/bag.h"          // 背包管理
#include "zhenyi/synthesis.h"    // 合成功能  
#include "zhenyi/equip.h"        // 装备管理
#include "zhenyi/interface.h"    // 界面显示
#include "zhenyi/decompose.h"    // 分解功能
#include "zhenyi/exchange.h"     // 武蕴兑换功能
#include "zhenyi/scheme.h"       // 方案管理功能
void create()
{
    seteuid(getuid());
}

/**
 * @brief 武圣真意系统主指令
 * @param string arg 参数，格式：功能名 [附加参数]
 * @return int 成功返回1
 * @details 支持的功能：
 *          无参数或main - 主界面
 *          equip [槽位] [真意ID] - 装备真意
 *          unequip [槽位] - 卸下真意
 *          bag - 真意背包
 *          view [真意ID] - 查看真意详情
 *          bonus - 查看属性加成
 *          slots - 选择装备槽位
 *          select_equip [槽位] - 选择要装备的真意
 *          select_unequip - 选择要卸下的真意
 *          synthesis - 真意合成界面
 *          synthesis_quality [品质] - 选择指定品质真意进行合成
 *          synthesis_preview [真意ID列表] - 预览合成结果
 *          synthesis_execute [真意ID列表] - 执行合成操作
 *          decompose - 真意分解界面
 *          decompose_single [页码] - 单个分解选择界面
 *          decompose_quality [品质] [页码] - 按品质分解界面
 *          decompose_preview [真意ID列表] - 预览分解结果
 *          decompose_execute [真意ID列表] - 执行分解操作
 *          wuyun_status - 查看武蕴状态
 *          wuyun_exchange - 武蕴兑换界面
 *          exchange_material - 兑换五脏材料
 *          exchange_potential [数量] - 兑换潜能
 *          scheme_management - 方案管理界面
 *          scheme_list [页码] - 查看方案列表
 *          scheme_detail [方案名] - 查看方案详情
 *          save_scheme_input - 保存方案输入界面
 *          save_scheme_execute [方案名] - 执行保存方案
 *          load_scheme [方案名] - 切换到指定方案
 *          rename_scheme_input [原方案名] - 重命名方案输入界面
 *          rename_scheme_execute [原方案名] [新方案名] - 执行重命名方案
 *          delete_scheme - 进入方案删除选择界面
 *          delete_scheme_confirm [方案名] - 删除方案确认界面
 *          delete_scheme_execute [方案名] - 执行删除方案
 */
int main(object me,string arg)
{
    string param1, param2;
    int p1, p2;
    
    if (!me)
        return 0;
        
    if (!arg)
        return show_main_interface(me);
        
    if (sscanf(arg, "equip %s %s", param1, param2) == 2)
        return equip_zhenyi_action(me, to_int(param1), param2);
    if (sscanf(arg, "unequip %d", p1) == 1)
        return unequip_zhenyi_action(me, p1);
    if (sscanf(arg, "view %s", param1) == 1)
        return view_zhenyi_detail(me, param1);
    if (sscanf(arg, "select_equip %d %d", p1, p2) == 2)
        return show_bag_for_equip(me, p1, p2);
    if (sscanf(arg, "select_equip %d", p1) == 1)
        return show_bag_for_equip(me, p1, 1);
    if (sscanf(arg, "discard_confirm %s", param1) == 1)
        return discard_confirm_action(me, param1);
    if (sscanf(arg, "discard_execute %s", param1) == 1)
        return discard_execute_action(me, param1);
    if (sscanf(arg, "desc %s", param1) == 1)
        return show_effect_desc(me, param1);
    if (sscanf(arg, "select_slot %s", param1) == 1)
        return show_equip_slots_for_item(me, param1);
    if (sscanf(arg, "compare %s", param1) == 1)
        return compare_zhenyi_action(me, param1);
    if (sscanf(arg, "bag %d", p1) == 1)
        return manage_bag(me, p1);
    if (sscanf(arg, "synthesis_quality %s", param1) == 1)
        return show_zhenyi_selection_for_synthesis(me, param1, 1);
    if (sscanf(arg, "synthesis_select %s %s %d", param1, param2, p1) == 3)
        return show_zhenyi_selection_for_synthesis(me, param1, p1, param2);
    if (sscanf(arg, "synthesis_select %s %s", param1, param2) == 2)
        return show_zhenyi_selection_for_synthesis(me, param1, 1, param2);
    if (sscanf(arg, "synthesis_preview %s", param1) == 1)
        return show_synthesis_preview(me, param1);
    if (sscanf(arg, "synthesis_confirm %s", param1) == 1)
        return show_synthesis_confirmation(me, param1);
    if (sscanf(arg, "synthesis_execute %s", param1) == 1)
        return execute_synthesis_action(me, param1);
    if (sscanf(arg, "decompose_single %d", p1) == 1)
        return show_decompose_selection(me, p1);
    if (sscanf(arg, "decompose_quality %s %d", param1, p1) == 2)
        return show_decompose_by_quality(me, param1, p1);
    if (sscanf(arg, "decompose_quality %s", param1) == 1)
        return show_decompose_by_quality(me, param1, 1);
    if (sscanf(arg, "decompose_preview %s", param1) == 1)
        return show_decompose_preview(me, param1);
    if (sscanf(arg, "decompose_confirm %s", param1) == 1)
        return show_decompose_confirmation(me, param1);
    if (sscanf(arg, "decompose_execute %s", param1) == 1)
        return execute_decompose_action(me, param1);
    if (sscanf(arg, "exchange_potential %s", param1) == 1)
        return exchange_potential_action(me, param1);
    if (sscanf(arg, "exchange_potential_confirm %s", param1) == 1)
        return exchange_potential_confirm(me, param1);
    if (sscanf(arg, "scheme_list %d", p1) == 1)
        return show_scheme_list(me, p1);
    if (sscanf(arg, "scheme_detail %s", param1) == 1)
        return show_scheme_detail(me, param1);
    if (sscanf(arg, "save_scheme_execute %s", param1) == 1)
        return save_scheme_execute(me, param1);
    if (sscanf(arg, "load_scheme %s", param1) == 1)
        return load_scheme_action(me, param1);
    if (sscanf(arg, "rename_scheme_input %s", param1) == 1)
        return rename_scheme_input(me, param1);
    if (sscanf(arg, "rename_scheme_execute %s %s", param1, param2) == 2)
        return rename_scheme_execute(me, param1, param2);
    if (sscanf(arg, "delete_scheme_confirm %s", param1) == 1)
        return delete_scheme_confirm(me, param1);
    if (sscanf(arg, "delete_scheme_execute %s", param1) == 1)
        return delete_scheme_execute(me, param1);

    switch (arg)
    {
        case "main": return show_main_interface(me);
        case "bag": return manage_bag(me, 1);
        case "bonus": return view_bonus(me);
        case "slots": return show_equip_slots(me);
        case "select_unequip": return show_unequip_slots(me);
        case "synthesis": return show_synthesis_interface(me);
        case "decompose": return show_decompose_interface(me);
        case "decompose_single": return show_decompose_selection(me, 1);
        case "decompose_batch": return show_batch_decompose_interface(me);
        case "wuyun_status": return show_wuyun_status(me);
        case "wuyun_exchange": return show_wuyun_exchange_interface(me);
        case "exchange_material": return exchange_material_action(me);
        case "exchange_material_confirm": return exchange_material_confirm(me);
        case "exchange_potential_input": return exchange_potential_input(me);
        case "scheme_management": return show_scheme_management(me);
        case "scheme_list": return show_scheme_list(me, 1);
        case "save_scheme_input": return save_scheme_input(me);
        case "delete_scheme": return show_scheme_list(me, 1);
        default: return notify_fail("未知的指令参数。\n");
    }
    
    return 1;
}

string help(object me)
{
    return @TEXT
武圣真意系统指令帮助：

wusheng_zhenyi          - 打开武圣真意系统主界面
wusheng_zhenyi bag      - 管理真意背包
wusheng_zhenyi bonus    - 查看属性加成
wusheng_zhenyi scheme_management - 打开方案管理界面
wusheng_zhenyi delete_scheme - 进入方案删除选择界面
wusheng_zhenyi synthesis - 打开真意合成界面
wusheng_zhenyi decompose - 打开真意分解界面
wusheng_zhenyi wuyun_status - 查看武蕴状态
wusheng_zhenyi wuyun_exchange - 打开武蕴兑换界面

武圣真意是高级的属性提升系统，通过战斗、任务等方式获得不同品质的真意，
装备后可以获得强大的属性加成。

合成功能可以将3个相同品质的真意合成为1个新的同品质真意，
只有蓝色及以上品质的真意才能进行合成。

分解功能可以将真意分解为武蕴，武蕴获得量根据真意品质决定：
白色真意：1点武蕴    绿色真意：2点武蕴    蓝色真意：5点武蕴
红色真意：10点武蕴   金色真意：15点武蕴   紫色真意：20点武蕴

武蕴兑换功能可以消耗武蕴获得有用资源：
5点武蕴可兑换随机五脏材料（地脾黄、龙肝草、天肺莲、仙肾石、血参果）
1点武蕴可兑换1万潜能

方案管理功能可以保存和切换不同的真意装备配置：
- 保存当前装备配置为方案（最多保存10个方案）
- 快速切换到已保存的方案
- 对方案进行重命名和删除操作
- 方案会记录创建时间和最后使用时间

使用 wusheng_zhenyi 开启系统，通过弹窗界面进行操作。

TEXT;
}
