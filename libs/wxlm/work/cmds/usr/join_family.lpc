// time.c					  

inherit F_CLEAN_UP;

int join_fam(object me, string fam);

int main(object me, string arg)
{   

    if (!arg)
    return notify_fail("你要加入哪个门派？\n");
    
    join_fam(me,arg);
	return 1;
}


//这个函数用于使得玩家加入这个门派，参数是玩家，门派的中文名字
//前提条件:没有加入任何门派，fam_name数组中有这个门派的中文名字
//如果条件不满足应该使用popup_title封装的函数来提示玩家：write(popup_title(msg));不需要加入换行符，函数会自动加换行符
//返回值：1表示成功，0表示失败
int join_fam(object me, string fam)
{
    string *fam_name = ({
        "魔教", "慕容世家", "关外胡家", "欧阳世家", "灵鹫宫", "血刀门", "雪山寺", 
        "神龙教", "古墓派", "逍遥派", "桃花岛", "星宿派", "丐帮", "华山派", "峨嵋派", 
        "武当派", "段氏皇族", "少林派", "移花宫", "全真教", "魔教", "华山剑宗",
        "雪山寺", "白帝城", "四象门"
    });

    mapping join_need = ([
        "移花宫":([
            "gender":"女性",
        ]),
        "峨嵋派":([
            "gender":"女性",
        ]),
        "少林派":([
            "gender":"男性",
        ]),
        "雪山教":([
            "gender":"男性",
        ]),
    ]);


    //判断玩家是否有门派
    if (me->query("family/family_name"))
    {
        write(popup_title("你已经有门派了，不能再加入别的门派了！"));
        return 0;
    }


    //判断门派的中文名字是否在fam_name数组中,使用member_array函数
    if (member_array(fam, fam_name) == -1)
    {
        write(popup_title("门派名字错误！" + fam));
        return 0;
    }

    // 判断是否是萌新流派
    if (me->query("newbie_guide/family") && me->query("newbie_guide/family") != fam && me->query("level") < 100)
    {
        write(popup_title("您在注册角色时选择了" + me->query("newbie_guide/family") + "流派，为了保证您的游戏体验，请加入指定的门派（" + me->query("newbie_guide/family") + "）。"));
        return 0;
    }

    //判断玩家性别是否符合加入门派的条件
    if (!nullp(join_need[fam]))
    {
        if (join_need[fam]["gender"] && join_need[fam]["gender"] != me->query("gender"))
        {
            write(popup_title("你不是" + join_need[fam]["gender"] + "，不能加入" + fam + "。"));
            return 0;
        }
    }

    //加入门派
    me->set("family/family_name", fam);
    me->set("family/master_name", "无");
    me->set("family/generation", 50);
    me->set("family/title", fam+"-预备弟子");
    me->force_me("new_family");
    me->delete("newbie_guide/family");
    write(popup_title("恭喜你加入了" + fam + ",成为了预备弟子。"));
    return 1;
}
