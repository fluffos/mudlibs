mapping familyInfo = ([
    "少林派":"少林派是从唐朝嵩山少林寺发展出来的武术门派，少林派是中原武术中流传范围最广、历史最长、拳种最多的武术门派，因源自于中岳嵩山的少林寺故名。\n",
    "武当派":"武当派是道教名门正派，创始于张三丰真人，以内家拳术和太极剑法闻名天下，讲究以柔克刚、以静制动的武学理念。\n",
    "峨嵋派":"峨嵋派是由郭襄创立的以峨嵋金顶为根据地的佛门女侠门派，擅长临济十二庄和峨嵋剑法，讲究慈悲为怀。\n",
    "华山派":"华山派是五岳剑派之一，以气宗、剑宗分化而闻名江湖，华山剑法讲究轻灵飘逸，剑术精妙绝伦。\n",
    "华山剑宗":"华山剑宗是华山派分化出的独门剑派，以快剑为主，讲究一剑制敌，剑法凌厉霸道。\n",
    "丐帮":"丐帮是天下第一大帮，帮众遍布天下，分为污衣、净衣两派，以神丐棒法和镇岳锁龙劲称雄武林。\n",
    "桃花岛":"桃花岛是黄岛主所创立的门派，以奇门五行之术著称，桃花岛弟子需精通琴棋书画，武功讲究诡异多变。\n",
    "星宿派":"星宿派位于新疆天山星宿海，由古春秋创立，以毒功见长，门人众多却尽是邪魔外道。\n",
    "逍遥派":"逍遥派由逍遥子创立，讲究清静无为，武功博大精深，包含北冥神功、天山六阳掌等绝学。\n",
    "古墓派":"古墓派由林潮瑛创立于终南山古墓，传承玉女心经，以玉女剑法和补天剑诀闻名江湖。\n",
    "全真教":"全真教是道教重要门派，由王重阳创立，以全真剑法和先天功为主要武学，重视内功修为。\n",
    "神龙教":"神龙教是海外一派，教众行事诡秘，以蛇岛奇功和神龙八式称雄，教中高手隐于民间。\n",
    "雪山寺":"雪山寺位于西藏雪山之巅，以密宗武学为主，龙象般若功和日月轮法威力无穷。\n",
    "血刀门":"血刀门是藏边一派，以血刀老祖为尊，血刀刀法凶狠霸道，令江湖人闻风丧胆。\n",
    "灵鹫宫":"灵鹫宫建于天山之巅，由天山童姥创立，以天山六阳掌和凌波微步称雄江湖。\n",
    "欧阳世家":"欧阳世家是西域名门，以蛤蟆功和灵蛇杖法闻名，家传绝学诡异莫测。\n",
    "关外胡家":"关外胡家是塞外胡家刀法的传承，以胡家刀法闻名江湖，刀法凌厉迅猛。\n",
    "慕容世家":"慕容世家是姑苏慕容氏的传承，以以彼之道还施彼身的武学理念闻名，武功博大精深。\n",
    "段氏皇族":"段氏皇族是大理段氏的皇室传承，以玄阳指和六极神剑等绝学称雄江湖。\n",
    "明教":"明教是中原武林的正道门派，崇尚光明，以圣火令号令天下，教众遍布中原。明教武学刚猛霸道，以圣火神功、乾坤大挪移等绝学闻名于世。\n",
    "魔教":"魔教是明教的分支，以天涯明月刀纵横江湖，刀法凌厉无双，令人闻风丧胆。\n",
    "白帝城":"白帝城是长江上游的一派，以琴棋书画入武道，肝胆琴心之技独步天下。\n",
    "四象门":"四象门源于先秦时期，创始人四极真人，是一个以青龙、白虎、朱雀、玄武四象为核心的武学门派。\n",
    "移花宫":"移花宫是江湖上一个神秘的女子门派，由邀月阁主和涟星阁主姐妹二人掌管。宫中只收女弟子，以移花接木手法和移花剑法闻名天下。移花宫武功诡异多变，尤其擅长借力打力之术。宫中弟子需终身不得婚嫁，否则将被废去武功。移花宫的武功讲究阴柔诡异，令江湖人谈之色变。\n",
]);

mapping familyClassify = ([
    "evil":({ "逍遥派","灵鹫宫","古墓派","桃花岛","移花宫" }),
    "neutral":({ "星宿派","血刀门","神龙教","欧阳世家","魔教" }),
    "good":({ "少林派","武当派","峨嵋派","华山派","丐帮","全真教","雪山寺","关外胡家","慕容世家","段氏皇族","华山剑宗","白帝城","四象门","明教" }),
]);

string *familyNameList = ({
    "移花宫","白帝城","少林派","武当派","峨嵋派","华山派","丐帮","桃花岛","星宿派","逍遥派","古墓派","全真教","神龙教","雪山寺","血刀门","灵鹫宫","欧阳世家","关外胡家","慕容世家","段氏皇族","华山剑宗","四象门","明教","魔教"
});

//门派的建筑列表
string *family_builds()
{
    string *data = ({ "宗门大殿","藏经阁","竞技场","事务大厅","师门排行","绝义堂","意境观","修心阵","门派留学"});
    return data;
}

//TODO:查看门派建筑
int look_build(object me,string buildName)
{
    object pop;


    // 如果buildName中存在-，代表二级菜单
    if (strsrch(buildName,"-") != -1)
    {
        // 是否确定脱离门派
        if (buildName == "脱离门派-yes") 
        {
            return do_tuoli(me);
        }

        // 是否取消脱离门派
        if (buildName == "脱离门派-no") 
        {
            tell_object(me,msg299("门派建筑","你再三思量，决定不能背叛师门,生是师门的人，死是师门的鬼。"));
            return 1;
        }

        // 是否确定开启自动接取远程任务
        if (buildName == "事务大厅-yes") 
        {
            me->set("family_auto_quest_accept",1);
            tell_object(me,msg299("门派建筑","你决定开启自动接取远程任务。"));
            return 1;
        }

        // 是否取消开启自动接取远程任务
        if (buildName == "事务大厅-no") 
        {
            me->delete("family_auto_quest_accept");
            tell_object(me,msg299("门派建筑","你决定取消开启自动接取远程任务。"));
            return 1;
        }

        // 是否开启自动执行杀怪
        if (buildName == "事务大厅-yes-auto-kill")
        {
            me->set("family_auto_quest_kill",1);
            tell_object(me,msg299("门派建筑","你决定开启自动执行杀怪。"));
            return 1;
        }

        // 是否取消开启自动执行杀怪
        if (buildName == "事务大厅-no-auto-kill")
        {
            me->delete("family_auto_quest_kill");
            tell_object(me,msg299("门派建筑","你决定取消开启自动执行杀怪。"));
            return 1;
        }

    }

    if (buildName == "意境观")
    {
        me->force_me("yj_skill");
        return 1;
    } 

    if (buildName == "修心阵")
    {
        me->force_me("conversion_exp");
        return 1;
    }

    if (buildName == "师门排行")
    {
        string msg;
        object *classList;
        int i = 0;
        pop = new(POP1);
        msg = "师门排行榜可以查看师门的排行榜，经验高的排在前面。";
        pop->basic(msg,2);

        // 获取门派的所有玩家
        classList = filter_array(users(),(: $1->query("family/family_name") == $(me)->query("family/family_name") :));
        // 按照经验排序
        classList = sort_array(classList,(: $1->query("combat_exp") < $2->query("combat_exp") :));

        foreach (object member in classList)
        {
            // 只显示前20名
            i++;
            pop->add_button(i + "." + member->query("name"),"look " + member->query("id"));

            if (i >= 20)
            {
                break;
            }
        }

        tell_object(me,pop->result() + "\n");
        return 1;
    }

    if (buildName == "事务大厅")
    {
        string msg;
        pop = new(POP1);
        msg = "事务大厅处可以选择开启自动接取远程任务，你要开启吗？";
        msg += "\n";
        msg += sprintf("当前自动接取任务状态:%s",me->query("family_auto_quest_accept") ? "已开启" : "已关闭");
        msg += sprintf("\n当前自动执行杀怪状态:%s",me->query("family_auto_quest_kill") ? "已开启" : "已关闭");

        pop->basic(msg,2);

        pop->add_button("开启接取","new_family look_family_build 事务大厅-yes");
        pop->add_button("关闭接取","new_family look_family_build 事务大厅-no");
        pop->add_button("开启叫杀","new_family look_family_build 事务大厅-yes-auto-kill");
        pop->add_button("关闭叫杀","new_family look_family_build 事务大厅-no-auto-kill");


        tell_object(me,pop->result() + "\n");
        return 1;
    }

    if (buildName == "绝义堂")
    {
        string msg;
        msg = "绝义堂处可以进行脱离门派，脱离门派将会被废除所有武学，你确定要脱离门派吗？（至少100游戏贡献可以使用，1-5次会返还100%-60%逐次衰减的潜能，5-10次固定为50%，超过10次不再返还。）";

        pop = new(POP1);

        pop->basic(msg,2);
        pop->add_button("确定","new_family look_family_build 脱离门派-yes");
        pop->add_button("取消","new_family look_family_build 脱离门派-no");

        tell_object(me,pop->result() + "\n");
        return 1;
    }
    else if (buildName == "藏经阁")
    {
        string msg;
        string *skills_family;

        msg = "藏经阁处可以查看门派的武学列表，具体学习还需要请教师父。";
        pop = new(POP1);
        pop->basic(msg,2);

        skills_family = get_family_skills()[me->query("family/family_name")];

        // 检查元素个数
        if (sizeof(skills_family) == 0)
        {
            tell_object(me,msg299("门派建筑","暂无。"));
            return 1;
        }

        foreach (string skill in skills_family)
        {

            if (!load_object(SKILL_D(skill)))
            {
                continue;
            }

            pop->add_button(to_chinese(skill),"chaski " + skill);
        }

        tell_object(me,pop->result() + "\n");
        return 1;
    }
    else
    if (buildName == "竞技场")
    {
        string msg;
        msg = "每周日20:00-21:00可以进行竞技场进行报名，决出门派首席大弟子,首席大弟子可以获得更高的门派地位，每日可从掌门处获取的门派资源更高。";
        pop = new(POP1);
        pop->basic(msg,2);
        
        pop->add_button("前往","new_family look_family_build 竞技场-sign");

        tell_object(me,pop->result() + "\n");
        return 1;
    }
    else
    if (buildName == "竞技场-sign")
    {

        string path;
        
        if (!nullp(query_jjmlist()[me->query("family/family_name")]))
        {
            path = query_jjmlist()[me->query("family/family_name")];
        }

        //当前地图是否可以飞行
        if (! environment(me)->query("outdoors")&& !wizardp(me) ) 
            return notify_fail("在房间里不能乱跑！\n");

        if (!path)
        {
            tell_object(me,msg299("门派建筑","你还没有加入门派，无法进行报名。"));
            return 1;
        }

        if (!load_object(path))
        {
            tell_object(me,msg299("门派建筑","你还没有加入门派，无法进行报名（" + path + "）。"));
            return 1;
        }

        me->move(path);
        tell_object(me,msg299("门派建筑","你来到了"+me->query("family/family_name")+"的竞技场。"));
        return 1;
    }
    else if (buildName == "宗门大殿")
    {
        string msg;
        msg = "宗门大殿上悬挂着门派祖师的画像，当你成为外门弟子后，你可以在这里参拜祖师获取每日的门派资源，如果你认为你未曾经过祖师教导并且你的成就会超越祖师，不想参拜也可以前往掌门处向教导你的掌门请安领取每日资源。";
        msg += "\n";
        msg += sprintf("当前门派贡献：%d",me->query("gongxian"));
        msg += sprintf("\n当前门派地位：%s",FAMILY_D->query_family_player_title(me));

        pop = new(POP1);
        pop->basic(msg,2);
        
        pop->add_button("参拜祖师","add_daily_resources " + me->query("family/family_name"));
        pop->add_button("查看资源","new_family look_family_build 宗门大殿-resources");
        // 新增门派留学按钮
        pop->add_button("门派留学","new_family look_family_build 门派留学");
        tell_object(me,pop->result() + "\n");
        return 1;
    }
    else if (buildName == "宗门大殿-resources")
    {
        string msg;
        msg = "宗门大殿-资源处可以查看每日的门派资源，每日可以领取一次。";
        msg += "\n";
        msg += query_daily_resources_intro();
        tell_object(me,popup_title(msg));
        return 1;
    }
    else if (buildName == "门派留学")
    {
        return family_study(me);
    }
    
    else
    {
        tell_object(me,msg299("门派建筑","正在开发中，请期待。"));
    }

    return 1;
}


int family_layout(object me)
{
    mapping jsonData,data,*buildingsData,*peoplesData;
    string familyName;

    
    jsonData = ([]);
    data = ([]);
    buildingsData = ({});
    peoplesData = ({ });
    jsonData["code"] = "family_layout";

    familyName = me->query("family/family_name");

    foreach (string buildName in family_builds())
    {
        buildingsData += ({ ([
            "name":buildName,
            "type":"门派建筑",
            "command":"new_family look_family_build " + buildName,
        ]) });
    }


    if (!undefinedp(familyManList[familyName]))
    {
        foreach (mixed manName in familyManList[familyName])
        {
            if (mapp(manName))
            {
                // peoplesData += ({ ([ "name":manName["name"],"type":"门派人物","command":"go_family_npc " + manName["name"] ]) });

                string name;
                if (undefinedp(manName["no_revive"]))
                {
                    name = HIR + manName["name"] + "[收徒]"NOR;
                }
                else
                {
                    name = manName["name"];
                }

                if (manName["level"])
                {
                    name += "[" + manName["level"] + "]";
                }


                peoplesData += ({ ([ "name":name,"type":"门派人物","command":"go_family_npc " + manName["name"] ]) });
            }
            else
            {
                peoplesData += ({ ([ "name":manName,"type":"门派人物","command":"go_family_npc " + manName ]) });
            }
        }
    }
    
    //重新排序peoplesData，将名字后跟了[收徒]字的人放在最前面
    // peoplesData = sort_array(peoplesData,(: (strsrch($1["name"],"收徒") == -1)  :));

    data["name"] = familyName;
    data["buildings"] = buildingsData;
    data["people"] = peoplesData;

    jsonData["data"] = data;

    tell_object(me,json_encode(jsonData) + "\n");

    return 1;
    

}


int look_family(object me)
{

    mapping data = ([
        "evil" : ({ }),
        "good" : ({ }),
        "neutral" : ({ }),
    ]);

    mapping allData = ([]);

    if (!me->query("family"))
    allData["code"] = "all_family";
    else
    allData["code"] = "already_family";

    foreach (string classify in keys(familyClassify))
    {
        foreach (string family in familyClassify[classify])
        {
            mapping info = ([
                "name" : family,
                "intro" : familyInfo[family],
                "skill" : "",
            ]);

            //将技能名字用，连接起来
            foreach (string skill in keys(familySkillList[family]))
            {
                info["skill"] += skill + ZJBR;
            }

            data[classify] += ({ info });
        }
    }

    allData["data"] = data;

    tell_object(me,json_encode(allData) + "\n");
    
    return 1;
}

int join_fam(object me, string fam)
{
    string *fam_name = ({
        "慕容世家", "关外胡家", "欧阳世家", "灵鹫宫", "血刀门", "雪山寺", "神龙教", "古墓派", "逍遥派", "桃花岛", "星宿派", "丐帮", "华山派", "峨嵋派", "武当派", "段氏皇族", "少林派", "移花宫", "全真教","华山剑宗","白帝城","四象门","明教","魔教"
    });


    //判断玩家是否有门派
    if (me->query("family/family_name"))
    {
     //   write(popup_msg("你已经有门派了，不能再加入别的门派了！"));
        return 0;
    }


    //判断门派的中文名字是否在fam_name数组中,使用member_array函数
    if (member_array(fam, fam_name) == -1)
    {
      //  write(popup_msg("门派名字错误！"));
        return 0;
    }

    me->set("born_family", fam);
    //加入门派
    me->set("family/family_name", fam);
    me->set("family/master_name", "无");
    me->set("family/generation", 50);
    me->set("family/title", fam+"-预备弟子");
    //write(popup_msg("恭喜你加入了" + fam + ",成为了预备弟子。"));
    return 1;
}

int main(object me, string arg)
{

    mapping data = ([]);


    if (! arg)
    {
        if (!me->query("family/family_name"))
        {

            if (me->query("newbie_guide/family") && me->query("level") < 100)
            {
                object pop;
                string family_name = me->query("newbie_guide/family");
                string msg = "您在注册角色时选择了" + family_name + "流派，为了保证您的游戏体验，请加入指定的门派（" + family_name + "），你是否现在就加入该门派？";

                pop = new(POP1);
                pop->basic(msg, 2); // 假设2是合适的样式参数
                pop->add_button("加入门派", "join_family " + family_name);
                write(pop->result() + "\n");
                return 1; // 修改：之前是 return 0; 为了保持一致的流程，改为 return 1; 并且弹窗后结束当前执行。
            }

            look_family(me);
        }
        else
        {
            family_layout(me);
        }

        return 1;
    }


    if (arg)
    {

        string build_name;

        if (arg == "look_family_build")
        {
            look_build(me,arg);
            return 1;
        }

        // 如果arg的格式为 look_family_build 门派建筑名称
        if (sscanf(arg, "look_family_build %s", build_name) == 1)
        {
            look_build(me,build_name);
            return 1;
        }

        if (member_array(arg, familyNameList) == -1)
        {
            data["code"] = "405";
            data["msg"] = "门派名字错误！";
            tell_object(me,json_encode(data) + "\n");
            return 1;
        }

        if (join_fam(me, arg))
        {
            data["code"] = "200";
            data["msg"] = "加入门派成功！";
            tell_object(me,json_encode(data) + "\n");
            me->force_me("new_family");
            return 1;
        }
        else
        {
            data["code"] = "405";
            data["msg"] = "加入门派失败！";
            tell_object(me,json_encode(data) + "\n");
            return 1;
        }
        
    }
    
}


int do_tuoli(object me)
{
	string family,*skills;
	int i;
    mapping user_skills;
	if(!me->query("family"))
	{
        // 你还没有师门吧，无需脱离师门
        tell_object(me,pop_final("你还没有师门吧，无需脱离师门。"));
		return 0;
	}

    //贡献度不够，无法脱离师门（100）
    // if (me->query("zjvip/all_pay") < 100)
    // {
    //     tell_object(me,pop_final("你的贡献度不够，无法脱离师门。"));
    //     return 0;
    // }

    // 你脱离了某某门派，决定再次重闯江湖
    tell_object(me,msg299("脱离门派","你和"+me->query("family/family_name")+"恩断义绝，决定再次重闯江湖。"));

	family = me->query("family/family_name");
    
    // 清除所有留学门派信息
    {
        string *family_keys;
        mapping all_data, family_info;
        int num;
        
        family_keys = ({ });
        all_data = me->query_entire_dbase();
        
        // 查找所有 family_N 形式的键
        foreach (string key in keys(all_data))
        {
            if (sscanf(key, "family_%d", num) == 1 && num >= 2)
            {
                family_keys += ({ key });
            }
        }
        
        // 删除所有留学门派信息
        foreach (string key in family_keys)
        {
            family_info = me->query(key);
            if (family_info && family_info["family_name"])
            {
                tell_object(me,"你与留学门派"+family_info["family_name"]+"断绝了关系。\n");
            }
            me->delete(key);
        }
        
        if (sizeof(family_keys) > 0)
        {
            tell_object(me,"所有留学门派关系已清除。\n");
        }
    }
    
    // 清除技能学习记录
    {
        object multi_family_master;
        string record_file;
        
        multi_family_master = load_object("/adm/special_ob/multi_family/multi_family_master");
        
        if (multi_family_master)
        {
            // 调用多门派管理器的清除函数
            if (function_exists("clear_all_learning_records", multi_family_master))
            {
                multi_family_master->clear_all_learning_records(me);
                tell_object(me,"所有技能学习记录已清除。\n");
            }
            else
            {
                // 如果没有专门的清除函数，手动清除学习记录
                record_file = sprintf("multi_family_skill_record_%s", me->query("id"));
                if (file_size("/save/" + record_file + ".o") >= 0)
                {
                    rm("/save/" + record_file + ".o");
                    tell_object(me,"技能学习记录文件已删除。\n");
                }
            }
        }
    }
    
    user_skills = me->query_skills();
    if (user_skills && sizeof(user_skills) > 0)
    {
        skills = keys(user_skills);
        
        for(i=0;i<sizeof(skills);i++)
        {
            if (me->query_skill(skills[i],1) > 0)
            {
                // 检查是否为抽奖获得的武功
                if (member_array(skills[i], ("/cmds/usr/luckdraw"->get_skill_ids() + "/cmds/usr/new_fanli"->get_skill_list()) + "/cmds/usr/new_fanli"->get_skill_list_500()) != -1)
                {
                    // 保留抽奖获得的武功等级，但最高保留180级
                    int skill_level = me->query_skill(skills[i], 1);

                    if (skill_level > 180)
                    {
                        me->set_skill(skills[i], 180);
                    }

                    //如果是九阳神功并且贡献低于1000并且是明教弟子，那么一样废除
                    if (skills[i] == "jiuyang-shengong" && me->query("zjvip/all_pay") < 1000 && family == "明教")
                    {
                        me->delete_skill(skills[i]);
                        tell_object(me,"因为你脱离了师门，你的"+to_chinese(skills[i])+"一身修为被师门废掉了。\n");
                    }

                    COMBAT_D->check_element_level(me, skills[i]);

                    continue;
                }

                if (skills[i] == "martial-cognize")
                {
                    // 如果技能是武学修养，那么跳过
                    continue;
                }

                //如果是钓鱼技巧跳过
                if (skills[i] == "diaoyu-jiqiao")
                {
                    continue;
                }

                me->delete_skill(skills[i]);
                COMBAT_D->check_element_level(me, skills[i]);
                tell_object(me,"因为你脱离了师门，你的"+to_chinese(skills[i])+"一身修为被师门废掉了。\n");
            }
        }
    }

    //清除门派贡献
    // me->delete("gongxian");

    // 返还潜能，每次脱离记录次数，1-5次从100%衰减到60，6-10到50%。超过10次，潜能不返还
    //learned_points是我之前所有的已经使用的潜能
    //tuoli_times是我之前脱离门派的次数
    //也就是说我只需要按照百分比将已经使用的潜能扣除就可以了
    {
        int learned_points = me->query("learned_points");
        // 如果temp/tuoli_times小于3，则tuoli_times为0，否则为tuoli_times
        int tuoli_times = me->query("temp/tuoli_times") < 3 ? 0: me->query("tuoli_times");
        int return_points = 0;
        int return_percent = 0;

        if (tuoli_times < 5)
        {
            return_percent = 100 - tuoli_times * 10;
        }
        else if (tuoli_times < 10)
        {
            return_percent = 50;
        }
        else
        {
            return_percent = 0;
        }

        return_points = learned_points * return_percent / 100;

        // 返还潜能,减掉我已经使用的潜能就相当于返还了
        // me->add("learned_points",-return_points);
        me->add("potential",-(me->query("learned_points") - return_points));
        me->set("learned_points",0);

        if (me->query("temp/tuoli_times") < 3)
            me->add("temp/tuoli_times",1);
            else
            me->add("tuoli_times",1);
            
        tell_object(me,"你脱离门派，返还了"+return_points+"点潜能。\n");
    }


	CHANNEL_D->do_channel( this_object(), "rumor","据说"+me->query("name")+"叛离了" + me->query("family/family_name") + "，与其恩断义绝，决定再次重闯江湖。");
	me->delete("family");
	me->set("title","普通百姓");
	me->delete("class");
    me->delete("quest");
    me->force_me("look");
	return 1;
}


