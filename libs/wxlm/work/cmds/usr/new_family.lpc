        "移花宫" : "/d/yihua/jingji/enter.lpc",
	]);

	return jjmlist;
}

mapping query_familyManList()
{
    return familyManList;
}

string query_daily_resources_intro()
{
    return @DESC
门派位阶系统将玩家的门派贡献值划分为九个等级，每个等级对应不同的门派职位和每日资源奖励。具体如下：  
    1. **杂役弟子**
       - **门派贡献值**: 0 - 3499
       - **职位描述**: 杂役弟子是门派中最低的职位，主要负责一些杂务工作。
       - **每日资源**:
         - 潜能: 0
         - 门派点数: 0
    
    2. **外门弟子**
       - **门派贡献值**: 3500 - 6999
       - **职位描述**: 外门弟子是门派的初级成员，开始接受一些基础的门派任务。
       - **每日资源**:
         - 潜能: 5000
         - 门派点数: 50
    
    3. **内门弟子**
       - **门派贡献值**: 7000 - 10499
       - **职位描述**: 内门弟子是门派的核心成员，能够参与更多高级任务和活动。
       - **每日资源**:
         - 潜能: 10000
         - 门派点数: 100
    
    4. **真传弟子**
       - **门派贡献值**: 10500 - 17499
       - **职位描述**: 真传弟子是门派中备受重视的成员，拥有较高的地位和更多的资源。
       - **每日资源**:
         - 潜能: 20000
         - 门派点数: 150
    
    5. **执事**
       - **门派贡献值**: 17500 - 24499
       - **职位描述**: 执事负责管理门派的日常事务，具有一定的权力和责任。
       - **每日资源**:
         - 潜能: 40000
         - 门派点数: 200
    
    6. **长老**
       - **门派贡献值**: 24500 - 34999
       - **职位描述**: 长老是门派的高级成员，参与门派的决策和管理。
       - **每日资源**:
         - 潜能: 60000
         - 门派点数: 250
    
    7. **传功长老**
       - **门派贡献值**: 35000 - 45499
       - **职位描述**: 传功长老负责传授门派的高级武功和知识，地位崇高。
       - **每日资源**:
         - 潜能: 80000
         - 门派点数: 300
    
    8. **执法长老**
       - **门派贡献值**: 45500 - 59999
       - **职位描述**: 执法长老负责维护门派的纪律和规矩，拥有很高的权力。
       - **每日资源**:
         - 潜能: 100000
         - 门派点数: 400
    
    9. **副掌门**
       - **门派贡献值**: 60000 以上
       - **职位描述**: 副掌门是掌门的助手，协助掌门管理整个门派，地位仅次于掌门。
       - **每日资源**:
         - 潜能: 150000
         - 门派点数: 500
    
    每日资源领取
    
    玩家可以通过向门派的掌门或指定NPC请安来领取每日资源。每日资源包括潜能和门派点数，潜能可以用于提升玩家的技能，而门派点数则可以在门派中兑换各种奖励和特权。
    
    提升位阶
    
    玩家可以通过完成门派任务、参与门派活动等方式来提升自己的门派贡献值。当贡献值达到一定数值时，玩家的位阶将自动提升，享受更高的每日资源和更高的门派地位。
    
    门派首席弟子
    
    门派中还设有首席弟子一职,宗门大比中获得第一名的玩家将成为首席弟子，首席弟子不仅享有更高的每日资源，还可以获得额外的奖励和特权。
    
    通过门派位阶系统，玩家可以在游戏中体验到逐步提升地位和实力的乐趣，同时也能感受到门派内部的竞争和合作。
DESC;
}

// 新增门派留学功能函数实现
int family_study(object me)
{
    // 直接调用多门派管理指令
    return me->force_me("multi_family");
}