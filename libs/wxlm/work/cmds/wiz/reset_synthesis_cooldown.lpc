/**
 * @brief 重置玩家合成冷却时间的管理员命令
 * @author LPC开发者
 * @date 2024
 */

inherit F_CLEAN_UP;

void create()
{
    seteuid(getuid());
}

/**
 * @brief 重置合成冷却时间
 * @param string arg 玩家ID，不填则重置自己的冷却
 * @return int 成功返回1
 */
int main(object me, string arg)
{
    object target;
    
    if (!me)
        return 0;
    
    // 检查权限
    if (!wizardp(me))
    {
        tell_object(me, "你没有权限使用此命令。\n");
        return 1;
    }
    
    if (!arg)
    {
        target = me;
    }
    else
    {
        target = find_player(arg);
        if (!target)
        {
            tell_object(me, sprintf("找不到玩家 %s。\n", arg));
            return 1;
        }
    }
    
    if (ZHENYI_MASTER->admin_reset_synthesis_cooldown(target))
    {
        tell_object(me, sprintf("成功重置了 %s 的合成冷却时间。\n", target->query("name")));
        if (target != me)
        {
            tell_object(target, "你的武圣真意合成冷却时间已被管理员重置。\n");
        }
    }
    else
    {
        tell_object(me, "重置冷却时间失败。\n");
    }
    
    return 1;
}

string help(object me)
{
    return @TEXT
重置合成冷却时间命令：

reset_synthesis_cooldown [玩家ID]

参数：
  玩家ID - 要重置冷却的玩家ID，不填则重置自己的冷却

示例：
  reset_synthesis_cooldown        - 重置自己的冷却
  reset_synthesis_cooldown test   - 重置玩家test的冷却

注意：此命令仅限管理员使用。

TEXT;
}