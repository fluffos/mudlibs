/**
 * @brief IP地址查询命令
 * @author Lu dexiang
 * @date 2023-06-01
 * @details 此命令用于查询当前游戏中玩家的IP地址分布情况，用弹窗方式展示结果
 */

inherit F_CLEAN_UP;

#include <net/dns.h>

// 函数声明
int help(object me);
void create();
private string format_ip_info(string *ip_addr, int *count, mixed *multy, int s, int s1);
private int check_multilogin(object me);
int main(object me, string arg);

void create() { 
	seteuid(getuid());
}

int main(object me, string arg)
{
	if (!wizardp(me))
		return 0;
	if(arg)
		return help(me);
	return check_multilogin(me);
}

private int check_multilogin(object me)
{
	object *ob;
	string *ip_addr;
	string *temp;
	mixed *multy;
	int *count;
	string t, msg;
	int i, j, s, s1;
	
	ob = users();
	s = sizeof(ob);
	
	// 没有玩家在线
	if (s < 1) {
		tell_object(me, popup_title("当前没有玩家在线。"));
		return 1;
	}
	
	ip_addr = allocate(s);
	ip_addr[0] = query_ip_number(ob[0]);
	temp = allocate(1);
	
	// 收集所有不同的IP地址
	for (i = 0; i < s; i++) {
		if (!environment(ob[i])) continue;
		temp[0] = query_ip_number(ob[i]);
		ip_addr = ip_addr - temp;
		ip_addr = ip_addr + temp;
	}
	
	ip_addr = ip_addr - ({0});
	s1 = sizeof(ip_addr);
	
	count = allocate(s1);
	multy = allocate(s1);
	
	for (i = 0; i < s1; i++)
		multy[i] = allocate(s);
		
	// 统计每个IP地址对应的玩家ID
	for (i = 0; i < s; i++) {
		t = query_ip_number(ob[i]);
		for (j = 0; j < s1; j++)
			if (ip_addr[j] == t) {
				multy[j][count[j]] = ob[i]->query("id");
				count[j]++;
			}
	}
	
	for (i = 0; i < s1; i++)
		multy[i] = multy[i] - ({0});
	
	// 格式化数据为弹窗显示
	msg = format_ip_info(ip_addr, count, multy, s, s1);
	
	// 使用弹窗显示结果
	tell_object(me, popup_title(msg));
	
	return 1;
}

/**
 * @brief 格式化IP地址信息
 * @return string 格式化后的信息字符串
 */
private string format_ip_info(string *ip_addr, int *count, mixed *multy, int s, int s1)
{
	string msg = "";
	int i, j;
	
	msg += BBLU HIW "IP 地址\t\t人数    人物标识ID\t\t\t\t" NOR "\n";
	msg += "----------------------------------------------------------------\n";
	
	for (i = 0; i < s1; i++) {
		msg += sprintf("%s\t%d\t", ip_addr[i], count[i]);
		
		for (j = 0; j < sizeof(multy[i]); j++)
			msg += sprintf("%s ", multy[i][j]);
			
		msg += "\n";
	}
	
	msg += "----------------------------------------------------------------\n";
	msg += sprintf("现在共有" + HIC + "%s" + NOR + "个玩家，" + HIC + "%s" + NOR + "个不同的IP地址。\n",
		chinese_number(s), chinese_number(s1));
		
	return msg;
}

int help(object me)
{
	string help_msg = @TEXT

指令格式：ip

这个指令是让你检查目前游戏中共有多少个相同的IP，相关
指令：mcheck。

TEXT;

	tell_object(me, popup_title(help_msg));
	return 1;
}


