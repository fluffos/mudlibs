inherit F_CLEAN_UP;

int main(object me, string arg)
{
    if (!wizardp(me))
        return notify_fail("只有巫师才能使用此命令。\n");

    "adm/daemons/night_assassin_d.lpc"->do_spawn_assassin(me);
    return 1;
}

int help(object me)
{
    write(@HELP
指令格式：spawn_assassin

这个指令允许巫师手动生成夜间刺客，方便测试夜间刺客活动。

HELP
    );
    return 1;
}