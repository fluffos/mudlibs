/**
 * @brief 清理玩家合成锁定状态的管理员命令
 * @author LPC开发者
 * @date 2024
 */

inherit F_CLEAN_UP;

void create()
{
    seteuid(getuid());
}

/**
 * @brief 清理合成锁定状态
 * @param string arg 玩家ID，不填则清理自己的锁定
 * @return int 成功返回1
 */
int main(object me, string arg)
{
    object target;
    
    if (!me)
        return 0;
    
    // 检查权限
    if (!wizardp(me))
    {
        tell_object(me, "你没有权限使用此命令。\n");
        return 1;
    }
    
    if (!arg)
    {
        target = me;
    }
    else
    {
        target = find_player(arg);
        if (!target)
        {
            tell_object(me, sprintf("找不到玩家 %s。\n", arg));
            return 1;
        }
    }
    
    if (ZHENYI_MASTER->admin_clear_synthesis_locks(target))
    {
        tell_object(me, sprintf("成功清理了 %s 的合成锁定状态。\n", target->query("name")));
        if (target != me)
        {
            tell_object(target, "你的武圣真意合成锁定状态已被管理员清理。\n");
        }
    }
    else
    {
        tell_object(me, "清理锁定状态失败。\n");
    }
    
    return 1;
}

string help(object me)
{
    return @TEXT
清理合成锁定状态命令：

clear_synthesis_locks [玩家ID]

参数：
  玩家ID - 要清理锁定的玩家ID，不填则清理自己的锁定

示例：
  clear_synthesis_locks        - 清理自己的锁定
  clear_synthesis_locks test   - 清理玩家test的锁定

注意：此命令仅限管理员使用，用于处理合成过程中出现的异常锁定状态。

TEXT;
}