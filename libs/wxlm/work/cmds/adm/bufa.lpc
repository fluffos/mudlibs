int main(object me, string arg)
{

    object player;
    object onecard;


    if (/*! SECURITY_D->valid_grant(me, "(admin)") ||*/ !wizardp(me))
    return 0;

    if (!objectp(player = find_player(arg)))
    {
        write("没有这个玩家。\n");
        return 1;
    }

    onecard = new_bind("/clone/baiyi/onecard");
    onecard->set_amount(5);
    onecard->move(player);
    tell_object(player,pop_final("你获得了5张单抽卡。"));

    tell_object(me, "你给" + player->name() + "发放了5张单抽卡。\n");

    return 1;
}