// start_invasion.c
// 手动开启门派入侵（测试用）



inherit F_CLEAN_UP;

int main(object me, string arg)
{
    string invader, target;
    object invasiond;
    object factiond;
    string invader_name;
    string target_name;

    if (!wizardp(me))
        return notify_fail("只有巫师可以使用这个命令。\n");

    invasiond = find_object("/adm/daemons/invasiond");
    if (!invasiond)
        invasiond = load_object("/adm/daemons/invasiond");

    if (!arg || sscanf(arg, "%s %s", invader, target) != 2)
    {
        // 如果没有参数，则正常启动入侵系统
        invasiond->start_invasion();
        write("门派入侵活动已正常启动。\n");
        return 1;
    }

    // 检查输入的门派名是否有效
    if (!invasiond->get_faction_main_room(invader) || !invasiond->get_faction_main_room(target))
    {
        write("无效的门派名称。请使用有效的门派ID。\n");
        return 1;
    }

    factiond = load_object("/adm/special_ob/faction/factions.lpc");
    invader_name = factiond->get_faction_name(invader);
    target_name = factiond->get_faction_name(target);

    // 手动指定入侵者和目标
    invasiond->initiate_invasion(invader, target);
    write(sprintf("%s对%s的入侵已手动启动。\n", invader_name, target_name));

    return 1;
}

int help(object me)
{
    write(@HELP
指令格式：
    start_invasion            - 正常启动门派入侵活动
    start_invasion <入侵者> <目标>  - 手动指定入侵者和目标门派

这个指令可以让巫师手动启动门派入侵活动，用于测试目的。
如果不指定参数，将正常启动入侵系统。
如果指定入侵者和目标，将立即启动一次特定的入侵事件。

示例：
    start_invasion xingxiu shaolin  - 启动星宿派对少林派的入侵

注意：请使用门派的英文ID，如 shaolin, wudang, huashan 等。
HELP
    );
    return 1;
}