int main(object me, string arg)
{
    mapping jsonData;

    if (!arg)
    {
        return notify_fail("指令格式：tuisong <内容>\n");
    }

    jsonData = ([
        "code": "消息推送",
        "info": arg,
    ]);

    // 向所有在线玩家发送消息
    foreach (object ob in users())
    {
        tell_object(ob, json_encode(jsonData) + "\n");
    }
    return 1;

}