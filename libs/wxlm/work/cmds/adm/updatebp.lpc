

inherit F_CLEAN_UP;

int main(object me, string arg)
{
    string *zhudi_allroom, *all_bangpai, zhudi_room, bangpai;
    zhudi_allroom = list_dirs("/d/bangpai/map/");
    all_bangpai = list_dirs("/data/bangpai/");

    write(sprintf("共有%d个帮派，%d个驻地。\n", sizeof(all_bangpai), sizeof(zhudi_allroom)));

    foreach (zhudi_room in zhudi_allroom)
    {
		write(sprintf("正在导入%s...\n", zhudi_room));
        foreach (bangpai in all_bangpai)
        {
			string source_file = "/d/bangpai/map/" + zhudi_room;
            string dest_file = "/data/bangpai/" + bangpai + "/map/" + zhudi_room;

            // if (zhudi_room != "mijige" && zhudi_room != "mijige.lpc")
            //     continue;

			// write(sprintf("正在导入%s的%s...\n", bangpai, zhudi_room));
		
            if (!write_file(dest_file, read_file(source_file), 1))
                return notify_fail(bangpai + "的" + file_size(source_file) + "号帮会驻地创建出错，建立失败，请联系管理员！\n");

            // tell_object(me, bangpai + "的" + zhudi_room + "成功导入...\n");
            // "/cmds/wiz/update"->main(me, dest_file);
			me->force_me("update " + dest_file);
        }
    }
    return 1;
}