mapping fd_to_msg;
mapping fd_to_obj;

void on_read(int fd, string msg)
{
    fd_to_msg[fd] += sprintf("%s", msg);
}

void on_write(int fd)
{
    debug_message(sprintf("on_write: %d \n", fd));
}

void on_close(int fd)
{

    string msg = fd_to_msg[fd];

    //以msg行为拆分，只保留最后一个行的信息
    msg = explode(msg, "\n")[sizeof(explode(msg, "\n")) - 1];

    tell_object(fd_to_obj[fd], msg + "\n");
    map_delete(fd_to_msg, fd);
    map_delete(fd_to_obj, fd);
}

int main(object me, string arg)
{
    int fd;
    int CURL_CMD = 1;
    if(__ARCH__ == "Microsoft Windows") CURL_CMD = 1;

    if (!arg) arg = "";
    fd = external_start(CURL_CMD, arg, "on_read", "on_write", "on_close");

    if (!fd_to_msg)
    {
        fd_to_msg = ([ ]);
    }
    if (!fd_to_obj)
    {
        fd_to_obj = ([ ]);
    }

    fd_to_msg[fd] = "";
    fd_to_obj[fd] = me;

    return 1;
}