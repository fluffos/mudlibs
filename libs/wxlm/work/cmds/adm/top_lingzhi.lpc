/**
 * @file top_lingzhi.c
 * @author Gemini
 * @brief 管理员查看在线玩家灵芝使用次数排行命令
 * @details 输出排行当前在线所有玩家的 zjvip/lingzhi_num
 * @version 1.0.0
 * @date 2024-07-29
 */

inherit F_CLEAN_UP;



// 函数声明
int help(object me);
private string get_top_list(object *users);
private int sort_by_lingzhi(object ob1, object ob2);

/**
 * @brief 主函数，处理命令参数并显示排行榜
 * @param me 执行命令的玩家
 * @param arg 命令参数 (当前未使用)
 * @return int 命令执行结果
 */
int main(object me, string arg)
{
    object *users;
    string result;

    if (!wizardp(me)) {
        return notify_fail("只有巫师才能使用此命令。\n");
    }

    users = filter_array(users(), (: userp($1) && $1->query("zjvip/lingzhi_num") :));
    
    if (!sizeof(users)) {
        return notify_fail("当前没有玩家在线或没有玩家使用过灵芝。\n");
    }

    result = get_top_list(users);

    write(result);
    return 1;
}

/**
 * @brief 生成灵芝使用次数排行榜
 * @param users 玩家对象数组
 * @return string 格式化的排行榜字符串
 */
private string get_top_list(object *users)
{
    string title, result = "";
    int i;

    title = HIM "在线玩家灵芝使用次数排行榜" NOR;
    users = sort_array(users, (: sort_by_lingzhi :));

    result += title + "\n";
    result += "──────────────────────────────────────────────────────────────────────────\n";
    result += sprintf("%-6s %-15s %-20s %-5s\n", "排名", "玩家ID", "玩家名称", "灵芝使用次数");
    result += "──────────────────────────────────────────────────────────────────────────\n";

    for (i = 0; i < sizeof(users) && i < 50; i++) { // 最多显示前50名
        string value;
        
        value = "" + users[i]->query("zjvip/lingzhi_num");
        
        result += sprintf("%-6d %-15s %-20s %-5s\n", 
                         i + 1,
                         users[i]->query("id"),
                         users[i]->query("name"),
                         value);
    }
    
    result += "──────────────────────────────────────────────────────────────────────────\n";
    if (sizeof(users) > 50) {
        result += "（只显示前50名玩家）\n";
    }
    return result;
}

/**
 * @brief 按灵芝使用次数排序 (降序)
 */
private int sort_by_lingzhi(object ob1, object ob2)
{
    int num1, num2;

    num1 = ob1->query("zjvip/lingzhi_num");
    num2 = ob2->query("zjvip/lingzhi_num");

    return num2 - num1;
}

/**
 * @brief 帮助信息
 */
int help(object me)
{
    write(@HELP
指令格式：top_lingzhi

这个指令可以列出当前在线玩家的灵芝使用次数排行榜。
会显示使用过灵芝的玩家中，使用次数最多的前50名。

HELP);
    return 1;
} 