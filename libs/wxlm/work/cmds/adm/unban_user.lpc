// unban_user.c - 解封用户账号命令

inherit F_CLEAN_UP;

/**
 * @brief 创建命令对象
 * @details 设置命令的权限
 */
void create() 
{ 
    seteuid(getuid()); 
}

/**
 * @brief 主命令函数
 * @param object me 执行命令的玩家
 * @param string arg 命令参数
 * @return int 执行成功返回1，失败返回0
 * @details 解封用户账号，格式：unban_user 账号
 */
int main(object me, string arg)
{
    string user;
    mapping ban_info;
    
    // 检查权限
    if (!SECURITY_D->valid_grant(me, "(admin)"))
    {
        notify_fail("你没有权限使用这个命令。\n");
        return 0;
    }
    
    // 检查参数
    if (!arg || arg == "")
    {
        notify_fail("指令格式：unban_user <账号>\n");
        return 0;
    }
    
    user = lower_case(arg);
    
    // 检查用户是否被封禁
    if (!BAN_D->is_user_banned(user))
    {
        notify_fail("用户 " + user + " 没有被封禁。\n");
        return 0;
    }
    
    // 获取封禁信息
    ban_info = BAN_D->query_banned_user(user);
    
    // 执行解封
    BAN_D->unban_user(user);
    
    // 记录日志
    log_file("ban_user", sprintf("%s：%s 解封了用户 %s\n", 
        ctime(time()), me->query("id"), user));
    
    write(sprintf("成功解封用户 %s\n", user));
    
    // 通知其他管理员
    CHANNEL_D->do_channel(this_object(), "sys", 
        sprintf("%s 解封了用户 %s", me->query("id"), user));
    
    return 1;
}

/**
 * @brief 帮助信息
 * @param object me 查看帮助的玩家
 * @return int 总是返回1
 * @details 显示命令的使用帮助
 */
int help(object me)
{
    write(@HELP
指令格式：unban_user <账号>

这个命令用于解封被封禁的用户账号，解封后用户可以正常登录游戏。

参数说明：
  账号       - 要解封的用户账号（不区分大小写）

示例：
  unban_user testuser                    - 解封testuser账号

注意：
1. 只有管理员才能使用此命令
2. 只能解封已被封禁的用户
3. 解封操作会被记录到日志文件中

相关命令：ban_user（封禁用户）
HELP );
    return 1;
}