inherit F_CLEAN_UP;



int main(object me, string arg)
{
    object *users_list;
    mapping fam_counts;
    string fam_name;
    string msg;
    string *sorted_fams;
    int i;

    if (!wizardp(me))
        return notify_fail("只有巫师才能使用此命令。\n");

    users_list = users();
    if (!sizeof(users_list))
    {
        write("目前没有任何玩家在线。\n");
        return 1;
    }

    fam_counts = ([]);
    foreach (object user in users_list)
    {
        if (!userp(user) || !environment(user)) // 确保是真实在线玩家
            continue;

        fam_name = user->query("family/family_name");
        if (!fam_name || fam_name == "")
            fam_name = "无门无派";

        if (undefinedp(fam_counts[fam_name]))
            fam_counts[fam_name] = 1;
        else
            fam_counts[fam_name]++;
    }

    if (!sizeof(fam_counts))
    {
        write("目前在线玩家均无门派。\n");
        return 1;
    }

    msg = "当前在线玩家门派人数统计：\n";
    msg += "--------------------------------------------------\n";
    msg += sprintf("%-20s %5s\n", "门派", "人数");
    msg += "--------------------------------------------------\n";

    sorted_fams = sort_array(keys(fam_counts), 1);

    for (i = 0; i < sizeof(sorted_fams); i++)
    {
        fam_name = sorted_fams[i];
        msg += sprintf(CYN "%-20s" NOR " %5d\n", fam_name, fam_counts[fam_name]);
    }

    msg += "--------------------------------------------------\n";
    msg += sprintf("总计在线玩家：%d 人\n", sizeof(users_list));

    write(msg);
    return 1;
}

string help(object me)
{
    return @HELP
指令格式 : famcount

此指令用以统计当前在线玩家的门派人数分布情况。

HELP;
}