/**
 * @brief GM测试命令 - 发放700级紫色真意
 * @details 给指定玩家发放一个定制的700级真武真意
 */

inherit F_CLEAN_UP;

#define ZHENYI_MASTER "/system/wusheng/zhenyi_master"

/**
 * @brief 主函数
 * @param object me 执行命令的对象
 * @param string arg 玩家id
 * @return int 1表示成功
 */
int main(object me, string arg)
{
    object player;
    mapping zhenyi_data, effects, effect_names;
    string player_id, zhenyi_name, full_name;
    string *name_pool;
    int idx;

    if (!arg || arg == "")
    {
        write("用法：test <玩家id>\n");
        write("功能：给指定玩家发放一个定制的700级紫色真意\n");
        write("属性：血量、内力、精神、内功、轻功、招架、剑法、拳脚\n");
        write("数值：每个词条在最大值的90%-100%范围内随机\n");
        return 1;
    }

    player_id = arg;
    player = find_player(player_id);

    if (!player)
    {
        write("找不到玩家：" + player_id + "\n");
        return 1;
    }

    // 从真意名称池中随机选择一个名称
    name_pool = ZHENYI_MASTER->query_zhenyi_name_pool();
    if (!name_pool || sizeof(name_pool) == 0)
    {
        zhenyi_name = "破军"; // 默认名称
    }
    else
    {
        zhenyi_name = name_pool[random(sizeof(name_pool))];
    }

    full_name = sprintf("%s·真武真意", zhenyi_name);

    // 词条名称池（每种类型3个选项）
    effect_names = ([
        "max_qi": ({
            (["name": "气血之韧", "desc": "强健的体魄使得气血更加旺盛，生命力得到显著提升。"]),
            (["name": "血海深潜", "desc": "深入血海奥义，气血如潮水般绵绵不绝。"]),
            (["name": "生命精华", "desc": "凝聚生命精华，让每一滴血液都蕴含强大的生命力。"])
        }),
        "max_neili": ({
            (["name": "内力澎湃", "desc": "内力如江河般奔腾不息，修为更加深厚。"]),
            (["name": "真气凝聚", "desc": "凝聚体内真气，内力储备大幅增加。"]),
            (["name": "气海无涯", "desc": "打通任督二脉，气海浩瀚如无边海洋。"])
        }),
        "max_jing": ({
            (["name": "精神焕发", "desc": "精神力量得到升华，思维更加敏锐清晰。"]),
            (["name": "意志坚韧", "desc": "钢铁般的意志让精神力量坚不可摧。"]),
            (["name": "神思敏捷", "desc": "神思如电，精神力量运转更加迅速。"])
        }),
        "force": ({
            (["name": "内功精通", "desc": "对内功心法的理解更加深刻，修炼事半功倍。"]),
            (["name": "内功宗师", "desc": "达到内功宗师境界，内力运转如臂使指。"]),
            (["name": "真气护体", "desc": "真气环绕周身，内功修为显著提升。"])
        }),
        "dodge": ({
            (["name": "身轻如燕", "desc": "身法轻灵如燕，轻功造诣更上一层楼。"]),
            (["name": "瞬步千里", "desc": "步法玄妙，仿佛能在瞬间跨越千里之遥。"]),
            (["name": "风行水上", "desc": "轻功已臻化境，行走如风行水上般自然。"])
        }),
        "parry": ({
            (["name": "铜墙铁壁", "desc": "防御如铜墙铁壁般坚固，招架技巧炉火纯青。"]),
            (["name": "滴水不漏", "desc": "防守滴水不漏，任何攻击都难以突破。"]),
            (["name": "固若金汤", "desc": "防御固若金汤，招架水平达到新的高度。"])
        }),
        "sword": ({
            (["name": "剑心通明", "desc": "剑心澄澈如镜，剑法修为突飞猛进。"]),
            (["name": "剑意纵横", "desc": "剑意纵横天地间，剑法威力大幅提升。"]),
            (["name": "万剑归宗", "desc": "领悟万剑归宗之理，剑法达到宗师境界。"])
        }),
        "unarmed": ({
            (["name": "拳脚通神", "desc": "拳脚功夫出神入化，一招一式皆含至理。"]),
            (["name": "无影幻腿", "desc": "腿法快如幻影，令人防不胜防。"]),
            (["name": "铁臂铜腿", "desc": "拳脚功夫已入化境，双臂如铁，双腿如铜。"])
        }),
    ]);

    // 创建效果映射
    effects = ([]);

    // 根据文档，700级倍率为11
    // 1. 气血类 (max_qi: 22000-44000, 90%范围: 39600-44000)
    idx = random(3);
    effects["max_qi"] = ([
        "value": 39600 + random(4401),
        "name": effect_names["max_qi"][idx]["name"],
        "desc": effect_names["max_qi"][idx]["desc"]
    ]);

    // 2. 内力类 (max_neili: 16500-33000, 90%范围: 29700-33000)
    idx = random(3);
    effects["max_neili"] = ([
        "value": 29700 + random(3301),
        "name": effect_names["max_neili"][idx]["name"],
        "desc": effect_names["max_neili"][idx]["desc"]
    ]);

    // 3. 精神类 (max_jing: 11000-22000, 90%范围: 19800-22000)
    idx = random(3);
    effects["max_jing"] = ([
        "value": 19800 + random(2201),
        "name": effect_names["max_jing"][idx]["name"],
        "desc": effect_names["max_jing"][idx]["desc"]
    ]);

    // 4. 内功类 (force: 220-440, 90%范围: 396-440)
    idx = random(3);
    effects["force"] = ([
        "value": 396 + random(45),
        "name": effect_names["force"][idx]["name"],
        "desc": effect_names["force"][idx]["desc"]
    ]);

    // 5. 轻功类 (dodge: 220-440, 90%范围: 396-440)
    idx = random(3);
    effects["dodge"] = ([
        "value": 396 + random(45),
        "name": effect_names["dodge"][idx]["name"],
        "desc": effect_names["dodge"][idx]["desc"]
    ]);

    // 6. 招架类 (parry: 220-440, 90%范围: 396-440)
    idx = random(3);
    effects["parry"] = ([
        "value": 396 + random(45),
        "name": effect_names["parry"][idx]["name"],
        "desc": effect_names["parry"][idx]["desc"]
    ]);

    // 7. 剑法类 (sword: 220-440, 90%范围: 396-440)
    idx = random(3);
    effects["sword"] = ([
        "value": 396 + random(45),
        "name": effect_names["sword"][idx]["name"],
        "desc": effect_names["sword"][idx]["desc"]
    ]);

    // 8. 拳脚类 (unarmed: 220-440, 90%范围: 396-440)
    idx = random(3);
    effects["unarmed"] = ([
        "value": 396 + random(45),
        "name": effect_names["unarmed"][idx]["name"],
        "desc": effect_names["unarmed"][idx]["desc"]
    ]);

    // 创建真意数据
    zhenyi_data = ([
        "name": full_name,
        "base_name": zhenyi_name,
        "quality": "真武真意",
        "color": MAG,
        "level": 700,
        "effects": effects,
        "create_time": time(),
        "drop_source": "gm_custom",
    ]);

    // 添加到玩家背包
    if (ZHENYI_MASTER->add_zhenyi_to_bag(player, zhenyi_data))
    {
        tell_object(player, sprintf(
            HIC"【GM发放】"NOR"你获得了一道 %s%s%s（700级定制）！\n",
            MAG,
            full_name,
            NOR
        ));

        tell_object(player, HIC"真意属性详情："NOR"\n");
        tell_object(player, sprintf("  %s：+%d\n", effects["max_qi"]["name"], effects["max_qi"]["value"]));
        tell_object(player, sprintf("  %s：+%d\n", effects["max_neili"]["name"], effects["max_neili"]["value"]));
        tell_object(player, sprintf("  %s：+%d\n", effects["max_jing"]["name"], effects["max_jing"]["value"]));
        tell_object(player, sprintf("  %s：+%d\n", effects["force"]["name"], effects["force"]["value"]));
        tell_object(player, sprintf("  %s：+%d\n", effects["dodge"]["name"], effects["dodge"]["value"]));
        tell_object(player, sprintf("  %s：+%d\n", effects["parry"]["name"], effects["parry"]["value"]));
        tell_object(player, sprintf("  %s：+%d\n", effects["sword"]["name"], effects["sword"]["value"]));
        tell_object(player, sprintf("  %s：+%d\n", effects["unarmed"]["name"], effects["unarmed"]["value"]));

        write(sprintf(HIY"成功给 %s(%s) 发放了700级紫色真意！"NOR"\n",
            player->query("name"), player_id));
    }
    else
    {
        write(HIR"发放失败！可能是玩家背包已满。"NOR"\n");
    }

    return 1;
}