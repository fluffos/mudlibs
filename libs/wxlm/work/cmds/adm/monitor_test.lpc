

// 测试命令：monitor_test
// 用法：monitor_test <副本类型> [次数]
// 副本类型：caoren/moku/cangjingge/qiu/shitu/qianchi/all

private string generate_random_id()
{
    string *first_names = ({"zhang", "wang", "li", "zhao", "chen", "yang", "wu", "liu", "huang", "zhou"});
    string *second_names = ({"san", "si", "wu", "liu", "qi", "ba", "jiu", "shi", "yi", "er"});
    
    return first_names[random(sizeof(first_names))] + "_" + second_names[random(sizeof(second_names))];
}

// 执行单个副本的测试
private void do_single_test(string test_id, string type, int start_time)
{
    int exp, potential, level, team_size, i;
    string member_id;
    int end_time;
    end_time = start_time + random(600) + random(600);
    switch(type)
    {
        case "caoren":
            exp = 10000;
            potential = 5000;
            write(HIY "模拟草人副本奖励记录：\n" NOR);
            write(sprintf("玩家ID：%s\n", test_id));
            write(sprintf("经验：%d，潜能：%d\n", exp, potential));
            MONITOR_MASTER->monitor_fuben_log(test_id, "草人副本", start_time, end_time, potential, exp);
            break;

        case "moku":
            exp = 30000;
            potential = 15000;
            write(HIY "模拟幽冥秘境奖励记录：\n" NOR);
            write(sprintf("玩家ID：%s\n", test_id));
            write(sprintf("经验：%d，潜能：%d\n", exp, potential));
            MONITOR_MASTER->monitor_fuben_log(test_id, "幽冥秘境", start_time, end_time, potential, exp);
            break;

        case "cangjingge":
            exp = 30000;
            potential = 15000;
            write(HIY "模拟藏经阁奖励记录：\n" NOR);
            write(sprintf("玩家ID：%s\n", test_id));
            write(sprintf("经验：%d，潜能：%d\n", exp, potential));
            MONITOR_MASTER->monitor_fuben_log(test_id, "藏经阁副本", start_time, end_time, potential, exp);
            break;

        case "qiu":
            exp = 500000;
            potential = 1000000;
            write(HIY "模拟非不裘副本奖励记录：\n" NOR);
            write(sprintf("玩家ID：%s\n", test_id));
            write(sprintf("经验：%d，潜能：%d\n", exp, potential));
            MONITOR_MASTER->monitor_fuben_log(test_id, "非不裘副本", start_time, end_time, potential, exp);
            break;

        case "shitu":
            // 模拟师徒副本的团队奖励
            write(HIY "模拟师徒副本奖励记录：\n" NOR);
            write(sprintf("玩家ID：%s\n", test_id));
            
            // 队长奖励
            exp = 20000;
            potential = 20000;
            write(sprintf("队长奖励 - 经验：%d，潜能：%d\n", exp, potential));
            MONITOR_MASTER->monitor_fuben_log(test_id, "师徒副本", start_time, end_time, potential, exp);
            
            // 随机生成1-3个队员
            team_size = 1 + random(3);
            for(i = 0; i < team_size; i++)
            {
                member_id = generate_random_id();
                exp = 10000;
                potential = 10000;
                write(sprintf("队员(%s) - 经验：%d，潜能：%d\n", member_id, exp, potential));
                MONITOR_MASTER->monitor_fuben_log(member_id, "师徒副本", start_time, end_time, potential, exp);
            }
            break;

        case "qianchi":
            // 模拟不同等级的溯源之河奖励
            level = 5 + random(16); // 随机5-20级
            exp = level * 100;
            potential = level * 50;
            write(HIY "模拟溯源之河副本奖励记录：\n" NOR);
            write(sprintf("玩家ID：%s\n", test_id));
            write(sprintf("等级：%d\n", level));
            write(sprintf("经验：%d，潜能：%d\n", exp, potential));
            MONITOR_MASTER->monitor_fuben_log(test_id, "溯源之河副本", start_time, end_time, potential, exp);
            break;
    }
}

// 执行所有副本的测试
private void do_all_tests(string test_id, int start_time)
{
    string *all_types = ({"caoren", "moku", "cangjingge", "qiu", "shitu", "qianchi"});
    string type;
    
    write(HIY "开始测试所有副本类型...\n" NOR);
    foreach(type in all_types)
    {
        write(HIC "\n测试副本类型：" + type + "\n" NOR);
        do_single_test(test_id, type, start_time);
    }
    write(HIY "\n所有副本类型测试完成。\n" NOR);
}

int main(object me, string arg)
{
    string type, test_id;
    string *args;
    int times, i, start_time;

    if (!arg)
    {
        write("用法：monitor_test <副本类型> [次数]\n");
        write("可用的副本类型：\n");
        write("  caoren     - 草人副本\n");
        write("  moku       - 幽冥秘境\n");
        write("  cangjingge - 藏经阁\n");
        write("  qiu        - 非不裘\n");
        write("  shitu      - 师徒副本\n");
        write("  qianchi    - 溯源之河\n");
        write("  all        - 测试所有副本\n");
        write("\n次数默认为1次，最大100次\n");
        return 1;
    }

    // 解析参数
    args = explode(arg, " ");
    type = args[0];
    times = 1;
    
    if (sizeof(args) > 1)
        times = to_int(args[1]);
    
    if (times < 1)
        times = 1;
    if (times > 100)
        times = 100;

    // 检查副本类型是否有效
    if (type != "all" && member_array(type, 
        ({"caoren", "moku", "cangjingge", "qiu", "shitu", "qianchi"})) == -1)
    {
        write("错误的副本类型！\n");
        return 1;
    }

    write(HIY "开始执行测试，测试次数：" + times + "\n" NOR);

    for (i = 0; i < times; i++)
    {
        // 每次测试生成新的随机ID
        test_id = generate_random_id();
        
        // 每次测试的开始时间在一定范围内随机
        start_time = time() - (random(600) + random(600));
        
        if (times > 1)
            write(HIC "\n执行第 " + (i + 1) + " 次测试\n" NOR);

        if (type == "all")
            do_all_tests(test_id, start_time);
        else
            do_single_test(test_id, type, start_time);
    }

    write(HIG "\n测试记录已完成，请查看日志文件：/log/monitor/fuben.log\n" NOR);
    return 1;
}

int help(object me)
{
    write(@HELP
指令格式：monitor_test <副本类型> [次数]

这是一个用于测试副本奖励监控系统的管理员命令。
可以模拟各种副本的奖励记录情况，用于验证监控系统是否正常工作。

可用的副本类型：
  caoren     - 草人副本
  moku       - 幽冥秘境
  cangjingge - 藏经阁
  qiu        - 非不裘
  shitu      - 师徒副本
  qianchi    - 溯源之河
  all        - 测试所有副本

参数说明：
  副本类型   - 必填，指定要测试的副本类型
  次数      - 可选，指定测试次数，默认1次，最大100次

特点：
1. 每次测试使用随机生成的玩家ID
2. 师徒副本会随机生成1-3个队员
3. 溯源之河副本会随机生成5-20级的记录
4. 每次测试的时间会递减10分钟

示例：
  monitor_test caoren      - 测试草人副本一次
  monitor_test shitu 5     - 测试师徒副本5次
  monitor_test all         - 测试所有副本各一次
  monitor_test all 10      - 测试所有副本各10次

注意：
1. 本命令仅供管理员测试使用
2. 每次测试都会使用新的随机玩家ID
3. 测试记录会写入到/log/monitor/fuben.log文件中
HELP
    );
    return 1;
}
