int main(object me, string arg)
{

    if (arg)
    {

        if (!me->query_skill(arg,1))
        {
            write("你还没有学习该技能。\n");
            return 1;
        }

        //等级是否大于200
        if (me->query_skill(arg,1) < 200)
        {
            write("该技能等级不足，无法解锁周天元素。\n");
            return 1;
        }

        COMBAT_D->unlock_elements(me,arg);
    }

    return 1;
}