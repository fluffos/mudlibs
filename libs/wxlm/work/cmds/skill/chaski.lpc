// berserk.c
#define SKILL_TOP "/adm/special_ob/skill_top"

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string str,name,type,*pfms,zhaoshi;
	mapping pfm;
	int i;
	string *buttons = ({});
	if (!arg)
		return notify_fail("你想查看什么资料的详细资料？\n");


	//3个参数
	if (sscanf(arg, "%s %s %s", name, type ,zhaoshi) == 3)
	{
		if(mapp(pfm = SKILL_D(name)->query_pfm()))
		{
			pfms = keys(pfm);
		}
		else
		{
			return notify_fail("这个技能没有绝招。\n");
		}

		if (file_size(SKILL_D(name + "/" + type + "/" + zhaoshi + ".lpc")) <= 0)
			return notify_fail("系统中没有你要查的这种技能。\n");

		str = SKILL_D(name + "/" + type + "/" + zhaoshi)->query_name() + "\n";
		str += "一一一一一一一一一一一一一一一一一一一一";
		str += ZJBR + SKILL_D(name + "/" + type + "/" + zhaoshi)->query_txt();
		write(popup_comb(str,({ "返回:chaski " + name })));
		return 1;
	}
	else if (sscanf(arg, "%s %s", name, zhaoshi) == 2)
	{
		if (file_size(SKILL_D(name + "/" + zhaoshi + ".lpc")) <= 0)
			return notify_fail("系统中没有你要查的这种技能。\n");

		str = SKILL_D(name + "/" + zhaoshi)->query_name() + "\n";
		str += "一一一一一一一一一一一一一一一一一一一一";
		str += ZJBR + SKILL_D(name + "/" + zhaoshi)->query_txt();
		write(popup_comb(str,({ "返回:chaski " + name })));
	}
	

	if (file_size(SKILL_D(arg) + ".lpc") <= 0)
		return notify_fail("系统中没有你要查的这种技能。\n");
	str = "技能名字："+to_chinese(arg)+"["+arg+"]" +  HIR + "[" + SKILL_TOP->get_skill_level(arg) + "武学]" + NOR;
	if(SKILL_D(arg)->query_txt())
		str += ZJBR + SKILL_D(arg)->query_txt();
	if(SKILL_D(arg)->query_description())
		str += ZJBR + SKILL_D(arg)->query_description();	
	str += ZJBR"一一一一一一一一一一一一一一一一一一一一";
	str += ZJBR"绝技：";
	if(mapp(pfm = SKILL_D(arg)->query_pfm()))
		pfms = keys(pfm);
	for(i=0;i<sizeof(pfms);i++)
	{
		sscanf(pfm[pfms[i]],"%s:%s",name,type);
		str += ZJBR + replace_string(name,ZJBR,"") + "[" + pfms[i] + "]";
		if(file_size(SKILL_D(arg+"/perform/"+pfms[i])+".lpc")>0 && SKILL_D(arg+"/perform/"+pfms[i])->query_txt())
		{
			buttons += ({  name +  ":chaski " + arg + " perform " + pfms[i] });
		}
			// str += ZJBR + SKILL_D(arg+"/perform/"+pfms[i])->query_txt();
		else if(file_size(SKILL_D(arg+"/exert/"+pfms[i])+".lpc")>0 && SKILL_D(arg+"/exert/"+pfms[i])->query_txt())
		{
			buttons += ({  name +  ":chaski " + arg + " exert " + pfms[i] });
		}
			// str += ZJBR + SKILL_D(arg+"/exert/"+pfms[i])->query_txt();
		else if(file_size(SKILL_D(arg+"/"+pfms[i])+".lpc")>0 && SKILL_D(arg+"/"+pfms[i])->query_txt())
		{
			buttons += ({  name +  ":chaski " + arg + " " + pfms[i] });
		}
			// str += ZJBR + SKILL_D(arg+"/"+pfms[i])->query_txt();
	}
    //如果技能是内功，轻功，招架，则显示元素情况
    // if (basic == "force" || basic == "dodge" || basic == "parry")
	if (SKILL_D(arg)->valid_enable("force") || SKILL_D(arg)->valid_enable("dodge") || SKILL_D(arg)->valid_enable("parry"))
    {
        mapping elements = COMBAT_D->single_elements_count(me, arg);
        string element_str = "";
        string *element_sor = ({"金","木","水","火","土"});


        if (elements)
        {
            element_str += "\n"HIR"元素情况：\n";
            foreach (string element in element_sor)
            {
                    element_str += element + "[" + elements[element] + "] ";
            }
        }

        str += element_str;
		buttons += ({ "解锁元素:unlock_elements " + arg });
    }


	str = replace_string(str,"\n",ZJBR);


	if (wizardp(me))
	{
		// str += "\n" + popup_buton( ({ sprintf("掌握500级:call me->set_skill(%s,500)",arg) } ));
		buttons += ({ "掌握500级:call me->set_skill(" + arg + ",500)" });
	}

	if(!i)
	{
		str += "无";
	}

	buttons += ({ "返回:skills" });
	// write(str + "\n");
	write(popup_comb(str,buttons));

	return 1;
}

int help (object me)
{
	write(@HELP
指令格式: chaski
 
这个指令让你查看技能的详细资料。

HELP );
	return 1;
}
