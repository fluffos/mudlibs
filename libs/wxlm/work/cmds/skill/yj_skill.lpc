#define AOYID "/adm/daemons/aoyid"

int main(object me, string arg)
{
    int two_aoyi_number = 0;
    string from_type, to_type;
    string *yixun_list, *buttons;
    string msg;
    int amount;

    if (!arg)
    {
        write(AOYID->get_yi_info(me));
        return 1;
    }

    if (arg == "canye_list")
    {
        yixun_list = AOYID->get_yixun_list();
        msg = HIR"当前的先学遗训残页数量：\n"NOR;
        foreach (string yixun in yixun_list)
        {
            msg += sprintf("%s："HIG"%d"NOR"/"HIC"100"NOR"\n", yixun, me->query("aoyi_canye/" + yixun));
        }

        write(popup_comb(msg, ({"残页转换:yj_skill convert", "返回:yj_skill"})));

        return 1;
    }
    
    if (arg == "convert")
    {
        yixun_list = AOYID->get_yixun_list();
        buttons = ({});
        
        foreach (string yixun in yixun_list)
        {
            if (me->query("aoyi_canye/" + yixun) >= 2)
            {
                buttons += ({yixun + "(" + me->query("aoyi_canye/" + yixun) + "):yj_skill convert_from " + yixun});
            }
        }
        
        if (sizeof(buttons) < 1)
        {
            write(msg299("意境系统", "你没有足够的残页可以转换，需要至少2张同类型残页。"));
            return 1;
        }
        
        write(popup_comb(HIY"请选择要转换的残页类型(需要2张)："NOR, buttons + ({"返回:yj_skill canye_list"})));
        return 1;
    }
    
    if (sscanf(arg, "convert_from %s", from_type) == 1)
    {
        yixun_list = AOYID->get_yixun_list();
        buttons = ({});
        
        if (me->query("aoyi_canye/" + from_type) < 2)
        {
            write(msg299("意境系统", "你的" + from_type + "残页不足2张，无法进行转换。"));
            return 1;
        }
        
        foreach (string yixun in yixun_list)
        {
            if (yixun != from_type)
            {
                buttons += ({yixun + ":yj_skill do_convert " + from_type + " " + yixun});
            }
        }
        
        write(popup_comb(HIY"将2张" + from_type + "残页转换为1张："NOR, buttons + ({"返回:yj_skill convert"})));
        return 1;
    }
    
    if (sscanf(arg, "do_convert %s %s", from_type, to_type) == 2)
    {
        int max_convert;
        
        max_convert = me->query("aoyi_canye/" + from_type) / 2;
        
        if (max_convert < 1)
        {
            write(msg299("意境系统", "你的" + from_type + "残页不足2张，无法进行转换。"));
            return 1;
        }
        
        msg = HIY"你有" + me->query("aoyi_canye/" + from_type) + "张" + from_type + 
              "残页，可以转换最多" + max_convert + "次。"ZJBR + 
              "请输入要转换的次数（每次消耗2张" + from_type + "残页，获得1张" + to_type + "残页）："NOR;
        
        write(popup_input(msg, "yj_skill convert_amount " + from_type + " " + to_type + " "));
        
        return 1;
    }
    
    if (sscanf(arg, "convert_amount %s %s %d", from_type, to_type, amount) == 3)
    {
        int max_convert;
        int cost, gain;
        
        max_convert = me->query("aoyi_canye/" + from_type) / 2;
        
        if (amount < 1)
        {
            write(msg299("意境系统", "转换次数必须大于0。"));
            return 1;
        }
        
        if (amount > max_convert)
        {
            write(msg299("意境系统", "你的残页不足，最多只能转换" + max_convert + "次。"));
            return 1;
        }
        
        cost = amount * 2;
        gain = amount;
        
        me->add("aoyi_canye/" + from_type, -cost);
        me->add("aoyi_canye/" + to_type, gain);
        
        write(popup_comb(HIG"转换成功！消耗了" + cost + "张" + from_type + "残页，获得了" + gain + "张" + to_type + "残页。"NOR, 
            ({"继续转换:yj_skill convert", "查看残页:yj_skill canye_list", "返回:yj_skill"})));
        
        return 1;
    }

    if (sscanf(arg, "set %s", arg) == 1)
    {
        if (!me->query("skill_aoyi/" + arg))
        {
            return 1;
        }

        two_aoyi_number = me->query("aoyi_general_number");

        if (two_aoyi_number >= 3)
        {
            write(msg299("意境系统", "你已经装配了3个先学遗训，无法再装配新的先学遗训。\n"));
            return 1;
        }

        if (me->query("aoyi_general/" + arg))
        {
            write(msg299("意境系统", "你已经装配了该先学遗训。\n"));
            return 1;
        }

        me->set("aoyi_general/" + arg, 1);
        me->set("aoyi_general_number", two_aoyi_number + 1);

        me->force_me("yj_skill");
        return 1;
    }
    else if (sscanf(arg, "remove %s", arg) == 1)
    {
        if (!me->query("aoyi_general/" + arg))
        {
            write(msg299("意境系统", "你还没有装配该先学遗训。\n"));
            return 1;
        }

        me->delete("aoyi_general/" + arg);
        me->set("aoyi_general_number", two_aoyi_number - 1);

        if (two_aoyi_number <= 0)
        {
            me->delete("aoyi_general");
            me->delete("aoyi_general_number");
        }

        tell_object(me, "你卸载了" + arg + "先学遗训。\n");

        me->force_me("yj_skill");
        return 1;
    }

    return 1;
}