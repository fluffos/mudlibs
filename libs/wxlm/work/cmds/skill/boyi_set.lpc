

inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
    string msg;
    string *strategies = ({"识破", "击伐", "穷追", "逸劳"});
    string *options = ({});
    
    if (arg)
    {
        COMBAT_D->set_boyi_strategy(me, arg);
        return 1;
    }

    return 1;

    msg = "请选择你要使用的博弈策略：\n\n";
    msg += HIY"识破（避实击虚）："NOR"博弈成功时降低受到的30%伤害，使敌人忙乱3秒\n";
    msg += HIY"击伐（上兵伐谋）："NOR"博弈成功提高30%伤害，打断穷追，并使敌人忙乱3秒\n";
    msg += HIY"穷追（乘胜追击）："NOR"博弈成功时提高50%伤害\n";
    msg += HIY"逸劳（以逸待劳）："NOR"第一次博弈不受影响，第二次必须换策略否则伤害提高30%\n\n";
    msg += HIW"克制关系：避实击虚 -> 上兵伐谋 -> 乘胜追击 -> 避实击虚"NOR"\n";

    foreach (string strategy in strategies)
    {
        options += ({ strategy + ":boyi_set " + strategy });
    }

    write(popup_comb(msg, options));
    return 1;
}

int help(object me)
{
    write(@HELP
指令格式：boyi_set [<策略>]

设置你在战斗中使用的博弈策略。可用的策略有：
识破（避实击虚）：博弈成功时降低受到的30%伤害，使敌人忙乱3秒
击伐（上兵伐谋）：造成伤害时，进入博弈阶段，博弈成功提高30%伤害，打断穷追，并使敌人忙乱3秒
穷追（乘胜追击）：博弈成功时提高50%伤害
逸劳（以逸待劳）：第一次博弈时，不受任何博弈影响，第二次必须选择其他博弈否则受到伤害提高30%

克制关系：避实击虚 -> 上兵伐谋 -> 乘胜追击 -> 避实击虚

如果不输入参数，将会显示一个选择菜单。
HELP
    );
    return 1;
}
