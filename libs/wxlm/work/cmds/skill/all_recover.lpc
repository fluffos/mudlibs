
int recover(object me,int type);
int check_condition(object me);

int auto_recover(object me)
{
    int condition;

    condition = check_condition(me);

    if (!objectp(me))
    {
        return 1;
    }

    if (me->is_busy())
    {
        call_out("auto_recover",2,me);
        return 1;
    }

    if (condition == 0)
    {
        tell_object(me,"恢复完毕。\n");
        return 1;
    }

    if (recover(me,condition))
    {

        // 如果状态丢失了，证明玩家手动停止了
        if (me->query_temp("pending/all_recover"))
            call_out("auto_recover",2,me);
    }

    return 1;
}

//疗伤命令
int main(object me,string arg)
{
    int condition;

    condition = check_condition(me);

    if (condition == 0)
    {
        write("你没有受伤。\n");
        return 1;
    }

    if (me->is_busy())
    {
        write("你正忙着呢，无法疗伤。\n");
        return 1;
    }

    me->set_temp("pending/all_recover",1);
    auto_recover(me);
    return 1;

}

//各种损伤状态如何处理
int recover(object me,int type)
{
    string *force_cmd = ({"exert heal","exert inspire","dazuo","exert recover","exert regenerate"});

    if (!objectp(me))
    {
        return 0;
    }

    if (me->is_busy())
    {
        return 0;
    }

    foreach (string cmd in force_cmd)
    {
        // 对应下标是否正确
        if (member_array(cmd,force_cmd) != type - 1)
        {
            continue;
        }
        
        if (me->force_me(cmd))
        {
            return 1;
        }

    }


    return 0;//条件不满足的话返回0

}


//是否有损伤
int check_condition(object me)
{

    if (!objectp(me))
    {
        return 0;
    }

    if ((int)me->query("eff_qi") < ((int)me->query("max_qi")))
    {
        return 1;//返回1代表气血受损
    }

    if ((int)me->query("eff_jing") < ((int)me->query("max_jing") - 1))
    {
        return 2;//返回2代表精受损
    }
    

    if ((int)me->query("neili") < ((int)me->query("max_neili")))
    {
        return 3;//返回3代表内力受损
    }
    else if (me->query_temp("pending/exercise"))
    {
        // "cmds/skill/exercise"->halt_exercise(me);
        me->force_me("halt");
    }
    //气血没有满则返回4
    if ((int)me->query("qi") < (int)me->query("eff_qi"))
    {
        return 4;//返回4代表气血没有满
    }

    //精没有满则返回5
    if ((int)me->query("jing") < (int)me->query("eff_jing"))
    {
        return 5;//返回5代表精没有满
    }


    return 0;//返回0代表没有受损
}