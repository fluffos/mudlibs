// mizhuan.c - 查看秘传获得方式


#define MIZHUAN_MASTER "/adm/special_ob/mizhuan/mizhuan_master"

int main(object me, string arg)
{
    string obtain_info;

    if (!arg)
    {
        return 1;
    }

    // 调用 MIZHUAN_MASTER 获取获得途径说明
    obtain_info = MIZHUAN_MASTER->query_mizhuan_obtain_explain(arg);

    tell_object(me, popup_title(replace_string(obtain_info, "\n", ZJBR))); // 替换换行符以适应弹窗

    return 1;
}