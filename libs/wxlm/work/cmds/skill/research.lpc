// research.c
// 作者：Lu dexiang
// 说明：技能研究指令，支持研究到指定等级

#include <skill.h>
#include <command.h>

inherit F_CLEAN_UP;
inherit "/cmds/skill/research/special_add";
inherit "/cmds/skill/research/research_config";

private int *calculate_skill_bonus(object me, string skill, int is_force_skill, int is_parry_skill);
private int check_skill_family_multiplier(object me, string skill);

void create() { seteuid(getuid()); }

/**
 * @brief 计算所有相关技能对目标技能的加成效果
 * @param object me 玩家对象
 * @param string skill 目标技能
 * @param int is_force_skill 是否为内功技能
 * @param int is_parry_skill 是否为招架技能
 * @return int* 返回技能加成值数组
 */
private int *calculate_skill_bonus(object me, string skill, int is_force_skill, int is_parry_skill)
{
    string *ks;
    int *ls, add_improve;
    
    add_improve = 0;
    ls = ({});
    ks = keys(me->query_skills());
    
    foreach(string k in ks) {
        mapping action;
        int eff;

        if (k == skill || (SKILL_D(k)->main_skill() && SKILL_D(k)->main_skill() != k)) 
            continue;

        if (is_type_skill(skill, SKILL_D(k)->query_fuzhu())) {
            add_improve += me->query_skill(k, 1);
        }

        if (SKILL_D(skill)->valid_enable(k))
            ls += ({ me->query_skill(k, 1) });

        if (SKILL_D(k)->valid_enable(skill) || (is_force_skill && SKILL_D(k)->valid_enable("force"))) {
            action = SKILL_D(k)->query_action(me, 0);
            eff = (int)me->query_skill(k, 1);
            
            if (action) {
                eff += (action["force"] + action["damage"] + action["attack"] + 
                       action["parry"] + action["dodge"]) * eff / 1000;
            }
            ls += ({ eff });
        }
    }
    
    ls = sort_array(ls, -1);
    return ({ls, add_improve});
}

/**
 * @brief 检查技能是否来自留学门派，返回潜能消耗倍数
 * @param object me 玩家对象
 * @param string skill 技能名称
 * @return int 潜能消耗倍数
 */
private int check_skill_family_multiplier(object me, string skill)
{
    object mgr;
    mapping all_learned, family_skills;
    string family_name;
    int multiplier = 1; // 默认倍数为1
    
    // 加载多门派管理器
    mgr = load_object("/adm/special_ob/multi_family/multi_family_master");
    if (!mgr) return 1;
    
    // 获取所有留学门派的技能学习记录
    all_learned = mgr->get_all_learned_skills(me);
    if (!all_learned["success"] || !mapp(all_learned["all_learned_skills"])) 
        return 1;
    
    // 遍历所有留学门派，查找该技能
    foreach (family_name, family_skills in all_learned["all_learned_skills"])
    {
        if (mapp(family_skills) && family_skills[skill])
        {
            // 找到技能，获取门派优先级
            int priority = mgr->get_family_priority(me, family_name);
            if (priority > multiplier)
                multiplier = priority; // 使用最高的倍数
        }
    }
    
    return multiplier;
}

/**
 * @brief 主函数入口
 * @param object me 玩家对象
 * @param string arg 命令参数
 * @return int 执行结果
 */
int main(object me, string arg)
{
    object where;
    string skill, skill_name;
    int target_level;
    int is_force_skill, is_parry_skill;
    int intlv, lvl, improve, add_improve;
    int *ls, *scale;
    int i,total_pot = 0;
    int skill_multiplier; // 留学门派技能倍数
    mixed bonus_result;
    int t = time();

    where = environment(me);
    add_improve = 0;

    if (!check_environment(me, where, t)) {
        return 0;
    }

    if (!arg) {
        return notify_fail("research|yanjiu <技能> <目标等级>\n");
    }

    if (sscanf(arg, "%s %d", skill, target_level) != 2) {
        return 1;
    }

    // 状态检查
    if (me->is_fighting())
        return notify_fail("临阵磨枪？来不及啦。\n");

    // 技能检查
    if (!(lvl = me->query_skill(skill, 1)))
        return notify_fail("这项技能你还不会，研究什么？\n");

    if ((string)SKILL_D(skill)->type() == "knowledge")
        return notify_fail(to_chinese(skill) + "只能靠你学习才能提高的。\n");

    if (lvl < 180)
        return notify_fail("你对" + to_chinese(skill) + "的掌握程度还未到研究的程度。\n");

    // 技能有效性检查
    notify_fail("依你目前的能力，没有办法研究这种技能。\n");
    if (!SKILL_D(skill)->valid_learn(me) || !SKILL_D(skill)->valid_research(me))
        return 0;

    if (!XUE_CMD->can_learn(me, skill))
        return 0;

	target_level += lvl;
	
    // 目标等级检查
    if (target_level <= lvl)
        return notify_fail("目标等级(" + chinese_number(target_level) + ")必须高于当前" + to_chinese(skill) + "的等级(" + chinese_number(lvl) + ")。\n");

    write(HIG "你开始研究直到" + chinese_number(target_level) + "级的「" + to_chinese(skill) + "」的奥秘。"NOR"\n");
    message("vision", me->name() + "在冥神思索。\n", where, ({ me }));

    // 检查留学门派潜能倍数
    skill_multiplier = check_skill_family_multiplier(me, skill);
    if (skill_multiplier > 1) {
        write(sprintf(HIY "💡 注意：「%s」是从第%d个门派学习的技能，研究潜能消耗将为正常的%d倍！" NOR "\n", 
            to_chinese(skill), skill_multiplier, skill_multiplier));
    }

    // 计算悟性加成
    intlv = (lvl < 380) ? 
        me->query("int") + (me->query_int() - me->query("int")) / 11 :
        10 + me->query("int")*3/4 + (me->query_int() - me->query("int")) / 11;

    // 计算技能关联加成
    is_force_skill = SKILL_D(skill)->valid_enable("force");
    is_parry_skill = SKILL_D(skill)->valid_enable("parry") && (!is_force_skill);
    
    bonus_result = calculate_skill_bonus(me, skill, is_force_skill, is_parry_skill);
    ls = bonus_result[0];
    add_improve = bonus_result[1];

    // 计算最终提升效果
    scale = query_scale(skill);
    improve = 0;

    for (i = 0; i < sizeof(ls) && i < sizeof(scale); i++)
        improve += ls[i] * scale[i];

    if (add_improve)
        improve += improve * add_improve / 10000;

    improve = improve / 10 / (100 + SKILL_D(skill)->difficult_level() - 
        me->query("titlea/yanjiux") - special_add(me,skill)) + intlv / 2;
    improve += lvl / 30;
    improve += improve * where->query("research_improve") / 100;

    if (lvl > 500)
        improve /= lvl / 100 - 5 + 2;
    if (intlv > 23)
        improve += improve * (intlv-23) * 4 / 300;
    if (improve < 2)
        improve = 2;

    improve = ((improve - 1) / 2);

    me->set_temp("time/research", t);
    skill_name = SKILL_D(skill)->query_skill_name(lvl);

    while (me->query_skill(skill, 1) < target_level) 
    {
        int energy_cost;
        int need_exp = me->query_next_level_exp(skill);

        // 检查是否可以继续提升
        if (!me->can_improve_skill(skill)) {
            write("你感觉此项武功已经到了瓶颈，若想更进一步恐怕需要在实战中寻找突破之机。\n");
            break;
        }
        

        energy_cost = need_exp / improve;
        
        // 应用留学门派潜能倍数
        energy_cost *= skill_multiplier;
        
        if (me->query("potential") - me->query("learned_points") < energy_cost) {
            write("你的潜能不够继续研究了。\n");
            break;
        }
        
        need_exp++;
        me->improve_skill(skill, need_exp);
        me->add("learned_points", energy_cost);
		total_pot += energy_cost;
    }

    write(sprintf(HIM "经过潜心钻研，你已经将「%s」提升到了%d级,消耗潜能[%d]。"NOR"\n", 
        to_chinese(skill), me->query_skill(skill, 1),total_pot));

    // 显示留学门派潜能倍数信息
    if (skill_multiplier > 1 && total_pot > 0) {
        int normal_cost = total_pot / skill_multiplier;
        write(sprintf(HIY "💡 留学门派研究倍数：第%d门派技能消耗为正常的%d倍（正常消耗:%d，实际消耗:%d）" NOR "\n", 
            skill_multiplier, skill_multiplier, normal_cost, total_pot));
    }

    return 1;
}

