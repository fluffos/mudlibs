int special_add(object me,string skill)
{
	string *s1 = ({
		"unarmed",//基本拳脚
		"cuff",//基本拳法
		"strike",//基本掌法
		"finger",//基本指法
		"hand",//基本手法
		"claw",//基本爪法
		"sword",//基本剑法
		"blade",//基本刀法
		"staff",//基本丈法
		"hammer",//基本锤法
		"club",//基本棍法
		"whip",//基本鞭法
	});
	int vlp_num = 0;
	int d = 0;
    int vip_level = "/cmds/usr/new_fanli"->get_vip_level(me);
    mapping vip_privileges = "/cmds/usr/new_fanli"->get_vip_privileges();
    if (vip_level > 0 && vip_level <= sizeof(vip_privileges))
    {
        vlp_num += vip_privileges[vip_level]["research_speed"];
    }
	if (skill == "force" && me->query("special_skill/neili_chongying"))
	{
		int level = TALNET_MASTER->query_talnet_level(me,"neili_chongying");
		d += 5 * level;
	}

	if (skill == "dodge" && me->query("special_skill/tian_sheng_ling_qiao"))
    {
        int level = TALNET_MASTER->query_talnet_level(me, "tian_sheng_ling_qiao");
        d += 5 * level;
    }

    if (skill == "parry" && me->query("special_skill/zhao_jia_hao_shou"))
    {
        int level = TALNET_MASTER->query_talnet_level(me, "zhao_jia_hao_shou");
        d += 5 * level;
    }

	if (me->query("special_skill/da_zhi_ru_yu"))
    {
		return 0;
    }

	// 如果vlp_num 大于 d 就使用 vlp_num 否则使用 d
	if (vlp_num > d)
	{
		return vlp_num;
	}

	foreach (string skill_id in s1)
	{
		if (!SKILL_D(skill)->valid_enable(skill_id) && skill_id != skill)
			continue;

		if (TALNET_MASTER->query_talnet_level(me,"t" + skill_id))
		{
			return 3 * TALNET_MASTER->query_talnet_level(me,"t" + skill_id) + d;
		}
	}

	
    
   return d;
}