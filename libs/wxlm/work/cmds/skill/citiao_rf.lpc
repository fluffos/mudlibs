/**
 * @file citiao_rf.c
 * @author Lu dexiang
 * @brief 词条查看和刷新指令
 */
inherit F_CLEAN_UP;

private int do_refresh(object me, int slot);
private int do_set_target(object me, int slot, string target_type, int target_value);
private int do_input_target_value(object me, int slot, string target_type);
private int do_handle_input_value(object me, int slot, string target_type, string input_value);
private int do_auto_refresh(object me, int slot);
private int do_stop_refresh(object me, int slot);
private string build_citiao_msg(object me, int refreshed_slot, string ref *buttons);
private string build_target_selection_msg(object me, int slot, string ref *buttons);

string *citiao_name = ({
    "天蓬", "天芮", "天冲", "天辅", "天禽", "天心", "天柱", "天任", "天英", "天衡", "天后", "天皇",
    "天虚", "天危", "天室", "天玑", "天璇", "天权", "天枢", "天机", "天梁", "天同", "天相", "天魁",
    "天钺", "天府", "天破", "天巨", "天哭", "天暗", "天贵", "天马", "天空", "天罗", "天狱", "天姚"
});

int main(object me, string arg)
{
    int total_elements;
    int slot;
    string msg;
    string *buttons = ({});
    string cmd, target_type;
    string *args;

    if (!objectp(me))
        return 0;
    
    // 获取词条格子数量
    total_elements = CITIAO_MASTER->query_citiao_slots_count(me);
    
    if (total_elements < 1)
    {
        write(popup_comb("你还没有解锁任何元素，无法使用词条功能。", ({})));
        return 1;
    }
    
    // 如果有参数，解析不同的指令
    if (arg)
    {
        args = explode(arg, " ");
        cmd = args[0];
        
        // 设定目标词条：citiao_rf target <格子> <类型> [数值]
        if (cmd == "target")
        {
            int target_value;
            
            if (sizeof(args) < 3)
            {
                write(popup_comb(
                    "用法：citiao_rf target <格子编号> <词条类型>\n例如：citiao_rf target 1 根骨",
                    ({ "返回查看:citiao_rf" })
                ));
                return 1;
            }
            
            if (sscanf(args[1], "%d", slot) != 1 || slot < 1 || slot > total_elements)
            {
                write(popup_comb(
                    sprintf("请指定正确的词条格子编号(1-%d)。", total_elements),
                    ({ "返回查看:citiao_rf" })
                ));
                return 1;
            }
            
            target_type = args[2];
            
            // 如果提供了数值参数，直接设定
            if (sizeof(args) >= 4 && sscanf(args[3], "%d", target_value) == 1 && target_value > 0)
            {
                return do_set_target(me, slot, target_type, target_value);
            }
            else
            {
                // 否则弹出输入框让用户输入数值
                return do_input_target_value(me, slot, target_type);
            }
        }
        
        // 开始自动刷新：citiao_rf auto <格子>
        else if (cmd == "auto")
        {
            if (sizeof(args) < 2)
            {
                write(popup_comb(
                    "用法：citiao_rf auto <格子编号>",
                    ({ "返回查看:citiao_rf" })
                ));
                return 1;
            }
            
            if (sscanf(args[1], "%d", slot) != 1 || slot < 1 || slot > total_elements)
            {
                write(popup_comb(
                    sprintf("请指定正确的词条格子编号(1-%d)。", total_elements),
                    ({ "返回查看:citiao_rf" })
                ));
                return 1;
            }
            
            return do_auto_refresh(me, slot);
        }
        
        // 停止自动刷新：citiao_rf stop <格子>
        else if (cmd == "stop")
        {
            if (sizeof(args) < 2)
            {
                write(popup_comb(
                    "用法：citiao_rf stop <格子编号>",
                    ({ "返回查看:citiao_rf" })
                ));
                return 1;
            }
            
            if (sscanf(args[1], "%d", slot) != 1 || slot < 1 || slot > total_elements)
            {
                write(popup_comb(
                    sprintf("请指定正确的词条格子编号(1-%d)。", total_elements),
                    ({ "返回查看:citiao_rf" })
                ));
                return 1;
            }
            
            return do_stop_refresh(me, slot);
        }
        
        // 选择目标类型：citiao_rf select <格子>
        else if (cmd == "select")
        {
            if (sizeof(args) < 2)
            {
                write(popup_comb(
                    "用法：citiao_rf select <格子编号>",
                    ({ "返回查看:citiao_rf" })
                ));
                return 1;
            }
            
            if (sscanf(args[1], "%d", slot) != 1 || slot < 1 || slot > total_elements)
            {
                write(popup_comb(
                    sprintf("请指定正确的词条格子编号(1-%d)。", total_elements),
                    ({ "返回查看:citiao_rf" })
                ));
                return 1;
            }
            
            msg = build_target_selection_msg(me, slot, ref buttons);
            buttons += ({ "返回查看:citiao_rf" });
            write(popup_comb(msg, buttons));
            return 1;
        }
        
        // 处理输入的目标数值：citiao_rf input_value <格子> <类型> <数值>
        else if (cmd == "input_value")
        {
            if (sizeof(args) < 4)
            {
                write(popup_comb(
                    "参数错误。",
                    ({ "返回查看:citiao_rf" })
                ));
                return 1;
            }
            
            if (sscanf(args[1], "%d", slot) != 1 || slot < 1 || slot > total_elements)
            {
                write(popup_comb(
                    "格子编号错误。",
                    ({ "返回查看:citiao_rf" })
                ));
                return 1;
            }
            
            target_type = args[2];
            return do_handle_input_value(me, slot, target_type, args[3]);
        }
        
        // 原有的刷新功能（兼容性）
        else if (sscanf(arg, "%d", slot) == 1 && slot >= 1 && slot <= total_elements)
        {
            return do_refresh(me, slot);
        }
        
        // 无效参数
        else
        {
            write(popup_comb(
                "无效的操作。请返回主界面使用按钮进行操作。",
                ({ "返回查看:citiao_rf" })
            ));
            return 1;
        }
    }
    
    // 显示词条信息
    msg = build_citiao_msg(me, 0, ref buttons);
    buttons += ({
        "返回游戏:look"
    });

    //更新词条
    CITIAO_MASTER->apply_citiao_effects(me);
    write(popup_comb(msg, buttons));
    
    return 1;
}

/**
 * @brief 刷新指定词条格子
 * @private
 * @param object me 玩家对象
 * @param int slot 格子编号
 * @return int 是否成功
 */
private int do_refresh(object me, int slot)
{
    object cifu;
    string msg;
    string *buttons = ({});
    // 检查是否有词符
    cifu = present("chifu", me);
    if (!cifu)
    {
        write(popup_comb(
            "你需要词符才能刷新词条。",
            ({ "返回查看:citiao_rf" })
        ));
        return 1;
    }
    
    // 刷新词条
    if (CITIAO_MASTER->refresh_citiao(me, "slot" + slot))
    {
        // 消耗词符
        if (cifu->query_amount() > 1)
            cifu->add_amount(-1);
        else
            destruct(cifu);
            
        // 显示刷新后的词条信息
        msg = build_citiao_msg(me, slot, ref buttons);
        buttons += ({
            "继续刷新:citiao_rf " + slot,
            "返回查看:citiao_rf",
            "返回游戏:look"
        });
        write(popup_comb(msg, buttons));
        
        return 1;
    }
    
    write(popup_comb(
        "刷新词条失败。",
        ({ "返回查看:citiao_rf" })
    ));
    return 1;
}

/**
 * @brief 构建词条信息消息
 * @private
 * @param object me 玩家对象
 * @param int refreshed_slot 刚刷新的格子编号，0表示没有刷新
 * @return string 词条信息消息
 */
private string build_citiao_msg(object me, int refreshed_slot, string ref *buttons)
{
    int total_elements = CITIAO_MASTER->query_citiao_slots_count(me);
    string msg = sprintf("你当前解锁了%d个元素，拥有%d个词条：\n\n",
        total_elements, total_elements);
    mapping citiao;
    string target_type;
    int auto_status;
    string color;
    
    // 显示所有词条信息
    for (int i = 1; i <= total_elements; i++)
    {
        string slot_key = "slot" + i;
        int target_value;
        // 如果格子不存在词条，添加词条
        if (!CITIAO_MASTER->query_citiao(me, slot_key))
        {
            CITIAO_MASTER->add_citiao_slot(me, slot_key);
        }
        
        citiao = CITIAO_MASTER->query_citiao(me, slot_key);
        target_type = CITIAO_MASTER->query_target_citiao(me, slot_key);
        target_value = CITIAO_MASTER->query_target_value(me, slot_key);
        auto_status = CITIAO_MASTER->query_auto_refresh_status(me, slot_key);
        
        if (citiao)
        {
            msg += sprintf("%s%s词条%s：%s +%d",
                HIY, citiao_name[i-1], NOR,
                citiao["name"], citiao["value"]);
                
            if (i == refreshed_slot)
                msg += HIG" (已刷新)"NOR;
                
            if (target_type && target_value)
            {
                int is_match = (citiao["name"] == target_type && citiao["value"] >= target_value);
                string status_mark;  
                color = is_match ? HIG : HIR;
                status_mark = is_match ? " ✓" : " ✗";
                msg += sprintf(" [目标:%s%s +%d%s%s]", color, target_type, target_value, status_mark, NOR);
            }
                
            if (auto_status)
                msg += HIB" [自动刷新中...]"NOR;
                
            msg += "\n";
            
            // 为每个格子添加操作按钮
            if (auto_status)
            {
                buttons += ({ "停止" + citiao_name[i-1] + "自动刷新:citiao_rf stop " + i });
            }
            else
            {
                buttons += ({ "刷新" + citiao_name[i-1] + "词条:citiao_rf " + i });
                buttons += ({ "设定" + citiao_name[i-1] + "目标:citiao_rf select " + i });
                if (target_type && target_value)
                    buttons += ({ "自动刷新" + citiao_name[i-1] + ":citiao_rf auto " + i });
            }
        }
    }
    
    msg += "\n使用词符可以重复刷新指定格子的词条属性。\n";
    msg += "设定目标词条类型后可以开启自动刷新功能。";
    
    return msg;
}

int help(object me)
{
    string msg = "词条系统说明：\n\n";
    msg += "1. 每个元素对应一个词条格子\n";
    msg += "2. 词条属性包括：\n";
    msg += "   - 基础属性(气血/内力/精神 200-2000)\n";
    msg += "   - 技能激发(内功/轻功等 1-20)\n";
    msg += "   - 先天属性(臂力/根骨等 1-4)\n";
    msg += "3. 使用词符可以重复刷新词条，直到获得想要的属性\n";
    msg += "4. 可以设定目标词条类型和数值，开启自动刷新功能\n";
    msg += "5. 自动刷新每秒检查一次，达到或超过目标数值时停止\n";
    msg += "6. 词条效果会自动应用到角色属性上\n\n";
    msg += "操作方式：\n";
    msg += "• 在词条界面点击相应按钮进行操作\n";
    msg += "• 可以手动刷新、设定目标、开始/停止自动刷新\n\n";
    msg += "词条数值范围：\n";
    msg += "• 基础属性（气血/内力/精神）: 100-1000\n";
    msg += "• 技能激发（内功/轻功等）: 1-20\n";
    msg += "• 先天属性（臂力/根骨等）: 1-4\n";
    msg += "• 恢复类型（气血恢复/精神恢复）: 1-20\n";
    
    write(popup_comb(msg, ({
        "查看词条:citiao_rf",
        "返回游戏:look"
    })));
    
    return 1;
}

/**
 * @brief 设定目标词条
 * @private
 * @param object me 玩家对象
 * @param int slot 格子编号
 * @param string target_type 目标词条类型
 * @param int target_value 目标数值
 * @return int 是否成功
 */
private int do_set_target(object me, int slot, string target_type, int target_value)
{
    string slot_key;
    string msg;
    string *buttons;
    string *types;
    slot_key = "slot" + slot;
    buttons = ({});
    
    // 验证词条类型和数值范围
    types = CITIAO_MASTER->query_all_citiao_types();
    if (member_array(target_type, types) == -1)
    {
        int i;
        msg = sprintf("无效的词条类型：%s\n\n", target_type);
        msg += "可用的词条类型包括：\n";
        for (i = 0; i < sizeof(types); i++)
        {
            msg += types[i] + " ";
            if ((i + 1) % 6 == 0)
                msg += "\n";
        }
        
        buttons += ({ "返回查看:citiao_rf" });
        write(popup_comb(msg, buttons));
        return 1;
    }
    
    if (CITIAO_MASTER->set_target_with_value(me, slot_key, target_type, target_value))
    {
        msg = sprintf("成功设定%s(%s)格子的目标：%s +%d\n\n",
            citiao_name[slot-1], slot_key, target_type, target_value);
        msg += "现在可以使用自动刷新功能了！";
        
        buttons += ({
            "开始自动刷新:citiao_rf auto " + slot,
            "返回查看:citiao_rf"
        });
    }
    else
    {
        msg = "设定失败！请检查数值范围是否正确。\n\n";
        msg += sprintf("词条类型 %s 的数值范围请参考帮助信息。", target_type);
        
        buttons += ({
            "查看帮助:help citiao_rf",
            "返回查看:citiao_rf"
        });
    }
    
    write(popup_comb(msg, buttons));
    return 1;
}

/**
 * @brief 开始自动刷新
 * @private
 * @param object me 玩家对象
 * @param int slot 格子编号
 * @return int 是否成功
 */
private int do_auto_refresh(object me, int slot)
{
    string slot_key = "slot" + slot;
    string msg;
    string *buttons = ({});
    
    if (CITIAO_MASTER->start_auto_refresh(me, slot_key))
    {
        msg = sprintf("已开始自动刷新%s(%s)格子！\n\n",
            citiao_name[slot-1], slot_key);
        msg += "系统将每秒自动检查并刷新词条，直到达到目标类型。\n";
        msg += "请确保有足够的词符。";
        
        buttons += ({
            "停止自动刷新:citiao_rf stop " + slot,
            "返回查看:citiao_rf"
        });
    }
    else
    {
        msg = "启动自动刷新失败！\n\n";
        msg += "可能的原因：\n";
        msg += "1. 该格子已在自动刷新中\n";
        msg += "2. 未设定目标词条类型\n";
        msg += "3. 词符不足";
        
        buttons += ({
            "设定目标类型:citiao_rf select " + slot,
            "返回查看:citiao_rf"
        });
    }
    
    write(popup_comb(msg, buttons));
    return 1;
}

/**
 * @brief 停止自动刷新
 * @private
 * @param object me 玩家对象
 * @param int slot 格子编号
 * @return int 是否成功
 */
private int do_stop_refresh(object me, int slot)
{
    string slot_key = "slot" + slot;
    string msg;
    string *buttons = ({});
    
    if (CITIAO_MASTER->stop_auto_refresh(me, slot_key))
    {
        msg = sprintf("已停止%s(%s)格子的自动刷新。",
            citiao_name[slot-1], slot_key);
    }
    else
    {
        msg = "该格子未在自动刷新中。";
    }
    
    buttons += ({ "返回查看:citiao_rf" });
    write(popup_comb(msg, buttons));
    return 1;
}

/**
 * @brief 构建目标选择界面消息
 * @private
 * @param object me 玩家对象
 * @param int slot 格子编号
 * @param string ref *buttons 按钮数组引用
 * @return string 目标选择消息
 */
private string build_target_selection_msg(object me, int slot, string ref *buttons)
{
    string slot_key;
    string msg;
    string *types;
    string current_target;
    int current_target_value;
    mapping current_citiao;
    int i;
    string btn_text;
    
    slot_key = "slot" + slot;
    msg = sprintf("请为%s(%s)格子设定目标词条类型和数值：\n\n",
        citiao_name[slot-1], slot_key);
    
    types = CITIAO_MASTER->query_all_citiao_types();
    current_target = CITIAO_MASTER->query_target_citiao(me, slot_key);
    current_target_value = CITIAO_MASTER->query_target_value(me, slot_key);
    current_citiao = CITIAO_MASTER->query_citiao(me, slot_key);
    
    if (current_target && current_target_value)
        msg += sprintf("当前目标：%s +%d\n\n", current_target, current_target_value);
    if (current_citiao)
        msg += sprintf("当前词条：%s +%d\n\n", current_citiao["name"], current_citiao["value"]);
    
    msg += "词条类型及数值范围：\n";
    
    // 按类别分组显示，包含数值范围
    msg += HIY"基础属性（100-1000）："NOR" 气血 内力 精神\n";
    msg += HIY"技能激发（1-20）："NOR" 内功 轻功 招架 剑法 掌法 手法 刀法 拳脚 拳法 锤法 琴法 指法 长兵\n";
    msg += HIY"先天属性（1-4）："NOR" 臂力 根骨 身法 悟性\n";
    msg += HIY"恢复类型（1-20）："NOR" 气血恢复 精神恢复\n\n";
    
    // 为每种类型添加选择按钮
    msg += "请选择要设定目标的词条类型：\n";
    for (i = 0; i < sizeof(types); i++)
    {
        btn_text = types[i];
        if (current_target == types[i])
            btn_text = HIG + types[i] + "(当前)" + NOR;
        buttons += ({ btn_text + ":citiao_rf target " + slot + " " + types[i] });
    }
    
    return msg;
}

/**
 * @brief 弹出输入框让用户输入目标数值
 * @private
 * @param object me 玩家对象
 * @param int slot 格子编号
 * @param string target_type 目标词条类型
 * @return int 是否成功
 */
private int do_input_target_value(object me, int slot, string target_type)
{
    string slot_key;
    string msg;
    string cmd;
    string *types;
    mapping value_ranges;
    slot_key = "slot" + slot;
    
    // 验证词条类型
    types = CITIAO_MASTER->query_all_citiao_types();
    if (member_array(target_type, types) == -1)
    {
        write(popup_comb(
            sprintf("无效的词条类型：%s", target_type),
            ({ "返回查看:citiao_rf" })
        ));
        return 1;
    }
    
    // 获取该类型的数值范围信息
    value_ranges = ([
        "气血" : "100-1000", "内力" : "100-1000", "精神" : "100-1000",
        "内功" : "1-20", "轻功" : "1-20", "招架" : "1-20", "剑法" : "1-20", "掌法" : "1-20",
        "手法" : "1-20", "刀法" : "1-20", "拳脚" : "1-20", "拳法" : "1-20", "锤法" : "1-20",
        "琴法" : "1-20", "指法" : "1-20", "长兵" : "1-20",
        "臂力" : "1-4", "根骨" : "1-4", "身法" : "1-4", "悟性" : "1-4",
        "气血恢复" : "1-20", "精神恢复" : "1-20"
    ]);
    
    msg = sprintf("设定%s(%s)格子的目标数值\n\n",
        citiao_name[slot-1], slot_key);
    msg += sprintf("词条类型：%s\n", target_type);
    msg += sprintf("数值范围：%s\n\n", value_ranges[target_type]);
    msg += "请输入目标数值：";
    
    cmd = sprintf("citiao_rf input_value %d %s $txt#", slot, target_type);
    
    write(popup_input(msg, cmd));
    return 1;
}

/**
 * @brief 处理用户输入的目标数值
 * @private
 * @param object me 玩家对象
 * @param int slot 格子编号
 * @param string target_type 目标词条类型
 * @param string input_value 用户输入的数值字符串
 * @return int 是否成功
 */
private int do_handle_input_value(object me, int slot, string target_type, string input_value)
{
    int target_value;
    string msg;
    string *buttons;
    
    buttons = ({});
    
    // 验证输入的数值
    if (sscanf(input_value, "%d", target_value) != 1 || target_value < 1)
    {
        msg = sprintf("输入的数值无效：%s\n请输入正整数。", input_value);
        buttons += ({
            sprintf("重新输入:citiao_rf target %d %s", slot, target_type),
            "返回查看:citiao_rf"
        });
        write(popup_comb(msg, buttons));
        return 1;
    }
    
    // 调用设定目标的函数
    return do_set_target(me, slot, target_type, target_value);
}
