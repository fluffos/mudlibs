// get_practice_buff.c



inherit F_CLEAN_UP;

int main(object me, string arg)
{
    object ob;
    int level, last_time, now;
    mapping buff_info;

    if (!arg)
        return notify_fail("你要向谁领取练习速度增加的BUFF？\n");

    ob = present(arg, environment(me));
    if (!ob || !ob->is_quester())
        return notify_fail("这里没有这个人。\n");

    level = FAMILY_D->query_family_player_level(me);
    buff_info = FAMILY_D->get_practice_buff(level);

    if (buff_info["duration"] == 0)
        return notify_fail("你的门派地位不够，无法领取练习速度增加的BUFF。\n");

    last_time = me->query("last_practice_buff_time");
    now = time();

    if (is_same_day(last_time, now))
        return notify_fail("你今天已经领取过练习速度增加的BUFF了，请明天再来。\n");

    // 设置新的BUFF
    me->set("practice_buff/effect", buff_info["effect"]);
    me->set("practice_buff/end_time", now + buff_info["duration"] * 3600);
    me->set("last_practice_buff_time", now);

    tell_object(me, HIY "你从" + ob->name() + "处领取了练习速度增加" + 
                buff_info["effect"] + "%的BUFF，持续到" + 
                ctime(me->query("practice_buff/end_time")) + "。\n" NOR);

    return 1;
}

int help(object me)
{
    write(@HELP
指令格式: get_practice_buff <NPC ID>

这个指令让你从掌门处领取每日练习速度增加的BUFF。
HELP );
    return 1;
}