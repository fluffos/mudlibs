// ting.c



inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object ob;
	object *inv;

	seteuid(getuid());

	// 如果没有参数,则停止所有野兽的跟随
	if (!arg) {
		inv = filter_array(all_inventory(environment(me)), 
			(: $1->query_temp("owner_id") == $(me)->query("id") :));
		
		if (!sizeof(inv))
			return notify_fail("你没有任何野兽跟随!\n");
		
		foreach(object beast in inv) {
			if(beast->query_temp("following")) {
				message_vision("$N对着"+beast->name()+"做了个手势,示意它停止跟随。\n",me);
				beast->set_leader(0);
				beast->delete_temp("following");
			}
		}
		return 1;
	}

	// 指定某只野兽停止跟随
	if (!objectp(ob = present(arg, environment(me))))
		return notify_fail("这里没有这只野兽。\n");
	
	if (!ob->query_temp("owner") || 
		ob->query_temp("owner_id") != me->query("id"))
	{
		return notify_fail(ob->name() + "不是你驯服的野兽!\n");
	}

	if (!ob->query_temp("following"))
		return notify_fail(ob->name() + "本来就没有跟随你。\n");
	
	message_vision("$N对着"+ob->name()+"做了个手势,示意它停止跟随。\n",me);
	ob->set_leader(0);
	ob->delete_temp("following");
	
	return 1;
}

