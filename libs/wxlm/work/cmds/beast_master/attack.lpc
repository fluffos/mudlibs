// attack.c



inherit F_CLEAN_UP;

int main(object me, string arg)
{
    object ob;
    object *inv;
    int cost;

    seteuid(getuid());

    if (environment(me)->query("no_fight"))
        return notify_fail("这里不许打斗！\n");

    if (me->query_skill("training", 1) < 30)
        return notify_fail("你的驭兽术还不纯熟，无法让野兽帮你咬人！\n");

    cost = me->query("max_jing") / (me->query_skill("training", 1) / 10) - 10;
    if (me->query("jing") <= cost)
        return notify_fail("现在你太累了，无法让野兽帮你咬人。\n");

    if (!arg)
        return notify_fail("你要让什么野兽帮你咬谁？\n");

    if (!objectp(ob = present(arg, environment(me))))
        return notify_fail("这里没有这个东西吧？\n");

    inv = filter_array(all_inventory(environment(me)), (: $1->query_temp("owner_id") == $(me)->query("id") :));

    if (!sizeof(inv))
        return notify_fail("你没有任何受你控制的野兽!\n");

    if ((ob->query("age") < 16) && userp(ob))
        return notify_fail(ob->query("name") + "还是个小孩子，算了吧...！！\n");

    foreach (object beast in inv)
    {
        if (beast->is_fighting())
            continue;

        if (beast->is_busy())
            continue;

        message_vision("只见$N冲着" + beast->name() + "口中一声呼哨，它一窜就向$n扑了上去。\n", me, ob);
        me->receive_damage("jing", cost);
        beast->fight_ob(ob);
        // return 1;
    }

    return notify_fail("你的野兽们现在都在忙或战斗中!\n");
}
