// advance_dagger.c

inherit ITEM;

void create()
{
	set_name("少林辅助身法书", ({ "shaolin fuzhu shenfa book", "fuzhu shenfa book"}));
	set_weight(600);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long",
"封面上写著「少林辅助身法）」\n");
		set("value", 30000);
		set("material", "paper");
		set("skill", ([
			"name": 	"shaolin-fuzhu-shenfa",
			"exp_required":	1000,
			"jing_cost":	30,
			"difficulty":	25,
			"max_skill":    180,
			"min_skill":    0,
		]));
	}
}

int query_autoload() { return 1; }
