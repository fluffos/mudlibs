


inherit COMBINED_ITEM;

string query_autoload() { return query_amount() + ""; }

void autoload(string param)
{
	int amt;

	if (sscanf(param, "%d", amt) == 1)
		set_amount(amt);
}

void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
	set_name("TAP大礼包", ({"taptap_gift"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "感谢大家对游戏的支持，祝您游戏愉快！\n");
		set("base_unit", "个");
		set("base_weight", 1);
		set("base_value", 1000);
		set("no_put", 1);
		set("no_get", 1);
		set("no_give", 1);
		set("no_drop", 1);
		set("no_sell", 1);
		set("no_steal", 1);
		set("no_beg", 1);
		set("only_do_effect", 1);
	}
	setup();
}

/**
 * @brief 使用TAP大礼包的效果函数
 * @param me 使用礼包的玩家对象
 * @return 1表示使用成功,0表示使用失败
 */
int do_effect(object me)
{
    // 变量声明
    mapping gifts;
    string *list;
    object obj;
    
    // 检查玩家状态
    if (me->is_busy())
        return notify_fail("你正忙着呢。\n");
    
    if (me->is_fighting())
        return notify_fail("战斗中，不能使用"+ name() +"。\n");

    // 初始化礼包内容
    gifts = ([
        // "/clone/vip/huiling" : 999,
        "/clone/vip/lingzhi2" : 20,
        "/clone/vip/fushougao" : 20,
        "/clone/vip/hua5" : 20,
        "/clone/vip/zyao2" : 20,
        "/clone/vip/jingyao" : 20,
        "/clone/vip/xueyao" : 20,
    ]);
    list = keys(gifts);
    
    // 显示使用效果
    message_vision("$N打开了一" + query("base_unit") + name() + "。\n", me);
    
    // 添加奖励
    me->add("bind_yuanbao", 1000);
    me->add("newgift_taptap_times", 1);
    tell_object(me, HIR"你获得了1000绑定元宝。"NOR"\n");
    
    // 记录日志
    log_file("gift_all/newgift1", sprintf("%s(%s)第%d次打开了%s %s。\n",
        me->query("name"),
        me->query("id"),
        me->query("newgift_taptap_times"),
        this_object()->short(),
        ctime(time())
    ));

    // 发放物品奖励
    foreach(string item in list) {
        obj = new_bind(item);
        if(obj->query_amount()) {
            obj->set_amount(gifts[item]);
        }
        tell_object(me, HIR"你发现了"+NOR+obj->short()+NOR"。\n");
        obj->move(me);
    }

    // 减少礼包数量
    add_amount(-1);
    
    return 1;
}
