// citiao_suodingshi.c
// 词条锁定石 - 用于锁定装备词条的特殊道具

inherit COMBINED_ITEM;

/**
 * @brief 查询自动加载参数
 * @return string 返回数量字符串
 * @details 用于保存道具数量信息
 */
string query_autoload() { return query_amount() + ""; }

/**
 * @brief 自动加载函数
 * @param string param 加载参数
 * @details 从参数中解析并设置道具数量
 */
void autoload(string param)
{
	int amt;

	if (sscanf(param, "%d", amt) == 1)
		set_amount(amt);
}

/**
 * @brief 设置函数
 * @details 初始化道具数量并调用父类设置
 */
void setup()
{
	set_amount(1);
	::setup();
}

/**
 * @brief 创建函数
 * @details 设置词条锁定石的基本属性
 */
void create()
{
	set_name(HIC "词条锁定石" NOR, ({ "citiao suodingshi", "suodingshi" }));
	if (clonep())
		set_default_object(__FILE__);
	else {
		// 道具详细描述信息
		set("long", "一块蕴含着神秘力量的石头，可以锁定装备上的特定词条，防止在重铸时丢失。\n");
		// 道具计量单位
		set("base_unit", "块");
		// 道具基础价值（游戏币）
		set("base_value", 800);
		// 道具元宝价格
		set("yuanbao", 40);
		// 石头类型标识，用于系统识别道具种类
		set("stone_type", "lock");
		// 锁定力量值，表示可锁定的词条数量
		set("lock_power", 1);
		// 道具重量
		set("base_weight", 1);
		// 每日限购数量限制
		set("day_limit_number", 15);
	}
	setup();
}