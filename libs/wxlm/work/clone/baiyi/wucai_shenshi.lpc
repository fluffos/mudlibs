// wucai_shenshi.c
// 五彩神石 - 用于装备强化的特殊道具

inherit COMBINED_ITEM;

/**
 * @brief 查询自动加载参数
 * @return string 返回数量字符串
 * @details 用于保存道具数量信息
 */
string query_autoload() { return query_amount() + ""; }

/**
 * @brief 自动加载函数
 * @param string param 加载参数
 * @details 从参数中解析并设置道具数量
 */
void autoload(string param)
{
	int amt;

	if (sscanf(param, "%d", amt) == 1)
		set_amount(amt);
}

/**
 * @brief 设置函数
 * @details 初始化道具数量并调用父类设置
 */
void setup()
{
	set_amount(1);
	::setup();
}

/**
 * @brief 创建函数
 * @details 设置五彩神石的基本属性
 */
void create()
{
	set_name(HIY "五彩神石" NOR, ({ "wucai shenshi", "shenshi" }));
	if (clonep())
		set_default_object(__FILE__);
	else {
		// 道具详细描述信息
		set("long", "一块散发着五彩光芒的神秘石头，蕴含着强大的力量，可用解锁装备词条。\n");
		// 道具计量单位
		set("base_unit", "块");
		// 道具基础价值（游戏币）
		set("base_value", 1000);
		// 道具元宝价格
		set("yuanbao", 50);
		// 石头类型标识，用于系统识别道具种类
		set("stone_type", "wucai");
		// 道具重量
		set("base_weight", 1);
		// 每日限购数量限制
		set("day_limit_number", 10);
	}
	setup();
}