// gift_meridian_98.c
// 98元经脉进阶礼包


inherit ITEM;

void create()
{
    set_name(HIY "经脉进阶礼包" NOR, ({"meridian gift 98", "gift"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "这是一个980元宝的经脉进阶礼包。\n"
                   HIC "礼包说明：约可开启6-7个经脉穴位\n" 
                   HIY "礼包内容：\n"
                   "1. 中品冲脉丹 x 200 (价值4000元宝)\n"
                   "2. 下品冲脉丹 x 100 (价值1000元宝)\n"
                   "3. 无量经书 x 10 (价值70元宝)\n"
                   "4. VIP月卡 x 2 (价值400元宝)\n"
                   "5. 洗髓丹 x 1 (价值100元宝)\n" NOR
                   HIW "\n礼包总价值：5570元宝\n"
                   HIR "特惠价格：980元宝 (省4590元宝)\n" NOR
                   HIR "\n注意：礼包内所有物品均为绑定状态，每个礼包限购一次。\n" NOR);
        set("unit", "个");
        set("value", 1);
        set("no_bind_shop", 1);//绑定商城不能购买
        set("no_drop", 1);
        set("no_give", 1);
        set("no_sell", 1);
        set("yuanbao", 980);
        set("no_shop", 1);
        set("gift_desc", "约可开启6-7个经脉穴位");
        set("action_list", ([
            "打开礼包" : "open meridian gift 98",
        ]));
    }
    setup();
}

void init()
{
    add_action("do_open", "open");
}

int do_open(string arg)
{
    object me = this_player();
    object item;
    mapping gift_items = ([
        "/clone/vip/dan_chongmai2" : 200,  // 中品冲脉丹
        "/clone/vip/dan_chongmai1" : 100,  // 下品冲脉丹
        "/clone/vip/book_wuliang" : 10,    // 无量经书
        "/clone/vip/avipcard" : 2,         // VIP月卡
        "/clone/vip/dan_con" : 1,          // 洗髓丹
    ]);
    
    if (!id(arg))
        return 0;

    if (environment(this_object()) != me)
        return notify_fail("你不能在非自己身上打开礼包。\n");
        
        
    // 发放物品
    foreach(string file, int amount in gift_items) {
        item = new_bind(file);
        if (!item) continue;
        
        if (item->query_amount())
            item->set_amount(amount);
            
        if (!item->move(me))
            item->move(environment(me));
    }
    
    
    tell_object(me, HIY "恭喜你打开了经脉进阶礼包！\n" NOR);
    
    destruct(this_object());
    return 1;
}
