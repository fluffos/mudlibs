


inherit COMBINED_ITEM;

void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
	set_name(HIY "九转金丹" NOR, ({ "jiuzhuan jindan", "dan" }) );
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一颗金色的仙丹，传说是太上老君精心修炼的灵丹妙药。随机增加先天属性。\n");
		set("base_unit", "颗");
		set("base_unit", "颗");
		set("base_weight", 10);
		set("base_value", 50000);
		set("yuanbao", 500);
		set("no_sell", 1);
		set("no_shop", 1);
		set("suit_point", 300);
		set("only_do_effect", 1);
        set("day_limit_number", 10);
	}
	setup();
}

// 单次使用函数
int do_effect(object me)
{
	int effect;
	mapping my;

	log_file("nosave/using", sprintf("%s(%s) eat 九转金丹 at %s.\n",
		 me->name(1), me->query("id"), ctime(time())));

	effect = 0;
	message_vision("$N一仰脖，吞下了一" + query("unit") + name() + "。\n", me);
	if (me->query("gift/xiandan") < 4)
	{
		effect++;
		write(HIM "你觉得自己的头脑更清醒了。"NOR"\n");
		me->add("gift/xiandan", 1);
		me->add("int", 1);
		write("\n "+HIR+"恭喜你："+NOR+HIG+"服用九转金丹成功，《先天悟性》增加了！！！"NOR"\n");
	}

	if (me->query("gift/unknowdan") < 4)
	{
		effect++;
		write(HIR "你觉得自己的腿脚更灵活了。"NOR"\n");
		me->add("gift/unknowdan", 1);
		me->add("dex", 1);
		 write("\n "+HIR+"恭喜你："+NOR+HIG+"服用九转金丹成功，《先天身法》增加了！！！"NOR"\n");
	}

	if (me->query("gift/xisuidan") < 4)
	{
		effect++;
		write(HIC "你觉得自己的内息更通畅了。"NOR"\n");
		me->add("gift/xisuidan", 1);
		me->add("con", 1);
		 write("\n "+HIR+"恭喜你："+NOR+HIG+"服用九转金丹成功，《先天体质》增加了！！！"NOR"\n");
	}

	if (me->query("gift/shenliwan") < 4)
	{
		effect++;
		write(HIG "你觉得自己的膂力更强健了。"NOR"\n");
		me->add("gift/shenliwan", 1);
		me->add("str", 1);
		write("\n "+HIR+"恭喜你："+NOR+HIG+"服用九转金丹成功，《先天臂力》增加了！！！"NOR"\n");
	}
	write(HIM "冥冥中你有所感悟。只觉得灵台一片空明，纯净无比。"NOR"\n");
	me->add("magic_points", 1000 + random(1000));
	me->add("gift/jiuzhuan", 1);
	my = me->query_entire_dbase();
	my["eff_jing"] = my["max_jing"];
	my["jing"] = my["max_jing"];
	my["eff_qi"] = my["max_qi"];
	my["qi"] = my["max_qi"];
	if (my["jingli"] < my["max_jingli"])
		my["jingli"] = my["max_jingli"];
	if (my["neili"] < my["max_neili"])
		my["neili"] = my["max_neili"];
	write(HIY "一阵畅快之后，你觉得浑身是劲！"NOR"\n");

	add_amount(-1);
      return 1;
}

// 批量使用函数
int do_effect_more(object me, int amount)
{
	int i, total_magic;
	mapping my;
	int xiandan_add = 0, unknowdan_add = 0, xisuidan_add = 0, shenliwan_add = 0;

	if (amount <= 0) return 0;
	if (query_amount() < amount) {
		write("你没有足够的" + name() + "。\n");
		return 0;
	}

	log_file("nosave/using", sprintf("%s(%s) eat %d 九转金丹 at %s.\n",
		 me->name(1), me->query("id"), amount, ctime(time())));

	message_vision(sprintf("$N一口气吞下了%d%s%s。\n", amount, query("unit"), name()), me);

	// 计算各种属性的增加量
	for (i = 0; i < amount; i++) {
		if (me->query("gift/xiandan") + xiandan_add < 4) {
			xiandan_add++;
		}
		if (me->query("gift/unknowdan") + unknowdan_add < 4) {
			unknowdan_add++;
		}
		if (me->query("gift/xisuidan") + xisuidan_add < 4) {
			xisuidan_add++;
		}
		if (me->query("gift/shenliwan") + shenliwan_add < 4) {
			shenliwan_add++;
		}
	}

	// 应用属性增加
	if (xiandan_add > 0) {
		write(HIM "你觉得自己的头脑更清醒了。"NOR"\n");
		me->add("gift/xiandan", xiandan_add);
		me->add("int", xiandan_add);
		write(sprintf("\n "+HIR+"恭喜你："+NOR+HIG+"服用九转金丹成功，《先天悟性》增加了%d点！！！"NOR"\n", xiandan_add));
	}

	if (unknowdan_add > 0) {
		write(HIR "你觉得自己的腿脚更灵活了。"NOR"\n");
		me->add("gift/unknowdan", unknowdan_add);
		me->add("dex", unknowdan_add);
		write(sprintf("\n "+HIR+"恭喜你："+NOR+HIG+"服用九转金丹成功，《先天身法》增加了%d点！！！"NOR"\n", unknowdan_add));
	}

	if (xisuidan_add > 0) {
		write(HIC "你觉得自己的内息更通畅了。"NOR"\n");
		me->add("gift/xisuidan", xisuidan_add);
		me->add("con", xisuidan_add);
		write(sprintf("\n "+HIR+"恭喜你："+NOR+HIG+"服用九转金丹成功，《先天体质》增加了%d点！！！"NOR"\n", xisuidan_add));
	}

	if (shenliwan_add > 0) {
		write(HIG "你觉得自己的膂力更强健了。"NOR"\n");
		me->add("gift/shenliwan", shenliwan_add);
		me->add("str", shenliwan_add);
		write(sprintf("\n "+HIR+"恭喜你："+NOR+HIG+"服用九转金丹成功，《先天臂力》增加了%d点！！！"NOR"\n", shenliwan_add));
	}

	// 计算总魔法点数增加
	total_magic = 0;
	for (i = 0; i < amount; i++) {
		total_magic += 1000 + random(1000);
	}

	write(HIM "冥冥中你有所感悟。只觉得灵台一片空明，纯净无比。"NOR"\n");
	me->add("magic_points", total_magic);
	me->add("gift/jiuzhuan", amount);

	// 恢复状态
	my = me->query_entire_dbase();
	my["eff_jing"] = my["max_jing"];
	my["jing"] = my["max_jing"];
	my["eff_qi"] = my["max_qi"];
	my["qi"] = my["max_qi"];
	if (my["jingli"] < my["max_jingli"])
		my["jingli"] = my["max_jingli"];
	if (my["neili"] < my["max_neili"])
		my["neili"] = my["max_neili"];
	write(HIY "一阵畅快之后，你觉得浑身是劲！"NOR"\n");

	add_amount(-amount);
	return 1;
}

