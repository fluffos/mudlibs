inherit COMBINED_ITEM;


void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
	set_name(HIR"毁容丹"NOR, ({"huirong dan"}));
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("base_unit", "粒");
		set("base_weight", 10);
		set("base_value", 100000);
		set("yuanbao", 100);
		set("no_sell",1);
		set("long","这是一粒毁容丹，服下之后将有损容颜!\n");
		set("only_do_effect", 1); // 标识该物品可以使用
	}
	setup();
}

/**
 * @brief 批量使用毁容丹的效果函数
 * @param object me 使用物品的玩家对象
 * @param int amount 使用的数量
 * @return int 返回1表示使用成功，0表示使用失败
 * @details 处理批量毁容丹的使用逻辑，考虑容貌下限1的累积效果
 */
int do_effect_more(object me, int amount)
{
    int current_per, total_decrease;
    
    if (!me) return 0;
    
    // 显示使用动作
    message_vision("$N服下了" + amount + "粒毁容丹。\n", me);
    
    // 获取当前容貌值
    current_per = me->query("per");
    
    // 检查是否已经达到下限
    if (current_per < 1)
    {
        tell_object(me, "你的容貌已经极丑了。\n");
        return 1;
    }
    
    // 计算总的减少值，不能低于1
    total_decrease = amount;
    if (current_per - total_decrease < 1)
    {
        total_decrease = current_per - 1;
    }
    
    // 应用效果
    if (total_decrease > 0)
    {
        me->add("per", -total_decrease);
        tell_object(me, "你感觉容貌受损了" + total_decrease + "点。\n");
        tell_object(me, "你现在的容貌是：" + me->query("per") + "。\n");
    }
    else
    {
        tell_object(me, "你的容貌已经极丑了。\n");
        return 1;
    }
    
    add_amount(-amount);
    return 1;
}

/**
 * @brief 单次使用毁容丹的效果函数
 * @param object me 使用物品的玩家对象
 * @return int 返回1表示使用成功，0表示使用失败
 * @details 处理单个毁容丹的使用逻辑
 */
int do_effect(object me) {
    if (!me) return 0;
    if (me->query("per") < 1) return notify_fail("你的容貌已经极丑了。\n");
    me->add("per", -1);
    message_vision("$N服下了一粒毁容丹，感觉容貌受损。\n", me);
    add_amount(-1);
    return 1;
}
