inherit COMBINED_ITEM;

void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
	set_name(HIR"单招伤害增强丹"NOR, ({"pfm damage dan"}));
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("yuanbao", 10);
		set("long","这是一张单招伤害增强丹，使用之后增加单招伤害10%（持续30分钟）！\n");
        set("no_sell",1);
		set("base_unit", "张");
		set("base_value", 50000);
		set("base_weight", 1);
        set("only_do_effect", 1); // 标识该物品可以使用
	}
	setup();
}

int do_effect(object me) {
    int add_time;
    add_time = 30 * 60 + time();
    if (!me) return 0;
    write(YEL"你的单招伤害增加10%，持续30分钟！"NOR"\n");
    me->add("fight_buff/pfm_damage_dan", add_time);
    me->save();
    add_amount(-1);
    return 1;
}
