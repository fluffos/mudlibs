inherit COMBINED_ITEM;

void setup()
{
	set_amount(1);
	::setup();
}
void create()
{
	set_name(HIM"胭脂"NOR, ({"yan zhi"}));
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("base_unit", "份");
		set("base_weight", 10);
		set("base_value", 100000);
		set("yuanbao", 100);
		set("no_sell",1);
		set("base_weight", 1);
		set("long","这是一份胭脂，使用之后可以提升人物容貌！\n");
		set("only_do_effect", 1);
	}
	setup();
}


/**
 * @brief 批量使用胭脂的效果函数
 * @param object me 使用物品的玩家对象
 * @param int amount 使用的数量
 * @return int 返回1表示使用成功，0表示使用失败
 * @details 处理批量胭脂的使用逻辑，考虑容貌上限30的累积效果
 */
int do_effect_more(object me, int amount)
{
    int current_per, total_increase, i;
    
    // 显示使用动作
    message_vision("$N使用了" + amount + query("unit") + name() + "。\n", me);
    
    // 获取当前容貌值
    current_per = me->query("per");
    
    // 检查是否已经达到上限
    if (current_per > 29)
    {
        tell_object(me, "你的容貌已经极美了。\n");
        return 1;
    }
    
    // 批量使用，逐个计算效果
    total_increase = 0;
    for (i = 0; i < amount; i++)
    {
        if (current_per + total_increase > 29) break;
        total_increase += 1 + random(3);
        if (current_per + total_increase > 30)
        {
            total_increase = 30 - current_per;
            break;
        }
    }
    
    // 应用效果
    me->add("per", total_increase);
    if (me->query("per") > 30) me->set("per", 30);
    
    // 成功提示
    tell_object(me, YEL"你使用了" + amount + query("unit") + name() + YEL"，你的容貌增加了" + total_increase + "点！"NOR"\n你现在的容貌是：" + me->query("per") + "。"NOR"\n");
    CHANNEL_D->do_channel(this_object(), "rumor", "据说" + me->query("name") + "使用了" + amount + query("unit") + name() + HIM"，变得更加漂亮了！");
    
    me->save();
    add_amount(-amount);
    return 1;
}

/**
 * @brief 单次使用胭脂的效果函数
 * @param object me 使用物品的玩家对象
 * @return int 返回1表示使用成功，0表示使用失败
 * @details 处理单个胭脂的使用逻辑
 */
int do_effect(object me)
{
      if (me->query("per")>29) return notify_fail("你的容貌已经极美了。\n");

	me->add("per",1+random(3));

      if (me->query("per")>30) me->set("per",30);

	write(YEL"你使用了一"+ query("unit") + name() +YEL"，你的容貌增加了！"NOR"\n你现在的容貌是："+me->query("per")+"。"NOR"\n");
	CHANNEL_D->do_channel( this_object(), "rumor","据说"+me->query("name")+"使用了一"+ query("unit") + name() +HIM"，变得更加漂亮了！");
	me->save();
	add_amount(-1);
	return 1;
}

