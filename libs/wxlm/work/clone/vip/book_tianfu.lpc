// jinsha.c


inherit COMBINED_ITEM;
void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
	set_name(HIM "天赋技能书" NOR, ({ "tianfu jineng shu" }));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "用来重置天赋技能的道具，有几率获得两个天赋技能和三个天赋技能。\n");
		set("base_unit", "本");
		set("base_unit", "本");
		set("base_value", 500);
		set("yuanbao", 20);
        set("no_sell", 1);
		set("only_do_effect", 1);
		set("base_weight", 1);
	}
	setup();
}

