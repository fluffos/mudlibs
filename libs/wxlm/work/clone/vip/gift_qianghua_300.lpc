// gift_qianghua_1200.c
// 进阶强化礼包


inherit ITEM;

void create()
{
    set_name(HIY "进阶强化礼包" NOR, ({"advance qianghua gift", "gift"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "这是一个1200元宝的进阶强化礼包。\n"
                   HIC "礼包说明：适合进阶玩家提升装备品质\n" 
                   HIY "礼包内容：\n"
                   "1. 强化石 x 1000 (价值10000元宝)\n"
                   "2. 装备保护符[中级] x 25 (价值750元宝)\n"
                   "3. 装备保护符[高级] x 15 (价值750元宝)\n" NOR
                   HIW "\n礼包总价值：2500元宝\n"
                   HIR "特惠价格：3000元宝 (优惠11000元宝)\n" NOR
                   HIR "\n注意：礼包内所有物品均为绑定状态，每个礼包限购一次。\n" NOR);
        set("unit", "个");
        set("value", 1);
        set("no_drop", 1);
        set("no_give", 1);
        set("no_sell", 1);
        set("no_shop", 1);
        set("yuanbao", 3000);
        set("day_limit_number", 1);
        set("no_bind_shop", 1);
        set("gift_desc", "强化装备进阶必备礼包");
        set("action_list", ([
            "打开礼包" : "open advance qianghua gift",
        ]));
    }
    setup();
}

void init()
{
    add_action("do_open", "open");
}

int do_open(string arg)
{
    object me = this_player();
    object item;
    mapping gift_items = ([
        "/clone/vip/qianghua_shi" : 1000,       // 强化石
        "/clone/vip/zhongjibao_hufu" : 25,     // 中级保护符
        "/clone/vip/gaojibao_hufu" : 15,       // 高级保护符
    ]);
    
    if (!id(arg))
        return 0;

    if (environment(this_object()) != me)
        return notify_fail("你不能在非自己身上打开礼包。\n");
        
    // 发放物品
    foreach(string file, int amount in gift_items) {
        item = new_bind(file);
        if (!item) continue;
        
        if (item->query_amount())
            item->set_amount(amount);
            
        if (!item->move(me))
            item->move(environment(me));
    }
    
    tell_object(me, HIY "恭喜你打开了进阶强化礼包！\n" NOR);
    
    destruct(this_object());
    return 1;
}