

inherit COMBINED_ITEM;
void setup()
{
	set_amount(1);
	::setup();
}
void create()
{
	set_name(HIY"洗点卡"NOR, ({"xidian ka", "ka"}) );
	set_weight(1);
	if( clonep() )
		set_default_object(__FILE__);
	else
	{
		set("base_unit", "张");
		set("base_unit", "张");
		set("base_value", 1);
		set("base_weight", 1);
		set("base_value", 1);
		set("channel_id","系统");
		set("no_sell",1);
		set("no_steal",1);
		set("no_shop", 1);
		set("long","这是一"+query("base_unit") +name()+"，可以获得一次免费的洗点次数，使用后前往扬州集市进行洗点。"NOR"\n" );
		set("yuanbao", 1000);
	}
	set("action_list", ([
		"使用" : "usesxidian",
	]));
	set_amount(1); 
	setup();
}
void init()
{
	add_action("do_uses", "usesxidian");
}

varargs int do_uses(string arg)
{
	object me = this_player();
		
	// if (me->query("usesxidian", 1)) {
	// 	tell_object(me, "你已经使用过一次洗点卡了，不可以再使用。\n");
	// 	return 1;
	// }

	if (!me->query("xidian")) {
        tell_object(me, "你当前不需要使用洗点卡，你已经拥有了洗点次数，请前往扬州集市进行洗点吧。\n");
    }

	me->delete("xidian");
	me->set("usesxidian",time());
	add_amount(-1);
	return 1;
}	 
