// gift_qianghua.c
// 强化入门礼包


inherit ITEM;

void create()
{
    set_name(HIY "强化入门礼包" NOR, ({"qianghua gift", "gift"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "这是一个600元宝的强化入门礼包。\n"
                   HIC "礼包说明：适合初次尝试装备强化的玩家\n" 
                   HIY "礼包内容：\n"
                   "1. 强化石 x 300 (价值3000元宝)\n"
                   "2. 装备保护符[低级] x 20 (价值200元宝)\n"
                   "3. 装备保护符[中级] x 10 (价值300元宝)\n" NOR
                   HIW "\n礼包总价值：800元宝\n"
                   HIR "特惠价格：600元宝 (优惠2900元宝)\n" NOR
                   HIR "\n注意：礼包内所有物品均为绑定状态，每个礼包限购一次。\n" NOR);
        set("unit", "个");
        set("value", 1);
        set("no_drop", 1);
        set("no_give", 1);
        set("no_sell", 1);
        set("no_shop", 1);
        set("yuanbao", 600);
        set("day_limit_number", 1);
        set("no_bind_shop", 1);
        set("gift_desc", "强化装备入门必备礼包");
        set("action_list", ([
            "打开礼包" : "open qianghua gift",
        ]));
    }
    setup();
}

void init()
{
    add_action("do_open", "open");
}

int do_open(string arg)
{
    object me = this_player();
    object item;
    mapping gift_items = ([
        "/clone/vip/qianghua_shi" : 300,      // 强化石
        "/clone/vip/dijibao_hufu" : 20,      // 低级保护符
        "/clone/vip/zhongjibao_hufu" : 10,   // 中级保护符
    ]);
    
    if (!id(arg))
        return 0;

    if (environment(this_object()) != me)
        return notify_fail("你不能在非自己身上打开礼包。\n");
        
    // 发放物品
    foreach(string file, int amount in gift_items) {
        item = new_bind(file);
        if (!item) continue;
        
        if (item->query_amount())
            item->set_amount(amount);
            
        if (!item->move(me))
            item->move(environment(me));
    }
    
    tell_object(me, HIY "恭喜你打开了强化入门礼包！\n" NOR);
    
    destruct(this_object());
    return 1;
}