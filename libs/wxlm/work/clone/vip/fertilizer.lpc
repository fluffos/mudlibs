// 肥料物品
inherit COMBINED_ITEM;
void setup()
{
	set_amount(1);
	::setup();
}
void create()
{
    set_name(YEL "肥料" NOR, ({"fertilizer", "plant fertilizer"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "这是一袋用于种植的肥料，可以促进作物生长。\n");
        set("unit", "袋");
        set("base_unit", "袋");
        set("yuanbao",5);
        set("base_weight", 100);
        set("base_value", 50);
        set("no_sell", 1);
    }
    setup();
}

