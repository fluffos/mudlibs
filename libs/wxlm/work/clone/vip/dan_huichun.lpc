


inherit COMBINED_ITEM;

void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
	set_name(HIG"回春丹"NOR, ({"huichun dan"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "一颗神奇的药丸，据说能返老归童。\n");
		set("base_unit", "颗");
		set("base_unit", "颗");
		set("base_weight", 10);
		set("base_value", 10000);
		set("yuanbao", 10);
        set("no_sell", 1);
		set("only_do_effect", 1);
	}
	setup();
}

// 单次使用函数
int do_effect(object me)
{
    int var;

    if (me->is_busy())
            return notify_fail("你正忙着呢。\n");

	if (me->is_fighting())
		    return notify_fail("正在战斗中，不能使用"+ name() +"。\n");

    if (me->query("mud_age")<86400*18)
            return notify_fail("你目前无需使用"+ name() +"。\n");
    else {
        var=86400*3;
        me->add("mud_age",-var);
		me->add("dan/huichun",1);
        message_vision("$N小心服用了一" + query("unit") + name() + "，似乎年轻了一些。\n", me);
	    add_amount(-1);
        return 1;
    }

}

// 批量使用函数
int do_effect_more(object me, int amount)
{
    int var, can_use, current_age;

    if (amount <= 0) return 0;
    if (query_amount() < amount) {
        write("你没有足够的" + name() + "。\n");
        return 0;
    }

    if (me->is_busy())
        return notify_fail("你正忙着呢。\n");

    if (me->is_fighting())
        return notify_fail("正在战斗中，不能使用"+ name() +"。\n");

    current_age = me->query("mud_age");
    if (current_age < 86400*18)
        return notify_fail("你目前无需使用"+ name() +"。\n");

    // 计算可以使用的数量（基于年龄限制）
    can_use = (current_age - 86400*18) / (86400*3) + 1;
    if (can_use <= 0) {
        return notify_fail("你目前无需使用"+ name() +"。\n");
    }

    // 限制实际使用数量
    if (amount > can_use) {
        write(sprintf("以你目前的年龄，最多只能使用%d颗回春丹。\n", can_use));
        amount = can_use;
    }

    var = 86400 * 3 * amount;
    me->add("mud_age", -var);
    me->add("dan/huichun", amount);

    message_vision(sprintf("$N小心服用了%d%s%s，似乎年轻了许多。\n", amount, query("unit"), name()), me);

    add_amount(-amount);
    return 1;
}
