


inherit COMBINED_ITEM;

void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
	set_name("无量经书", ({"kungfu book"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "记载了武学心得的一页残卷。\n");
		set("base_unit", "页");
		set("base_unit", "页");
		set("base_weight", 10);
		set("base_value", 10000);
		set("yuanbao", 7);
        set("no_sell", 1);
		set("only_do_effect", 1);

		//每日限购20
		set("day_limit_number", 20);
	}
	setup();
}

// 单次使用函数
int do_effect(object me)
{
      int exp2;

      if (me->is_busy())
                return notify_fail("你正忙着呢。\n");

	if (me->is_fighting())
		    return notify_fail("正在战斗中，不能使用"+ name() +"。\n");

      if ((me->query("experience")-me->query("learned_experience"))>500000)
                return notify_fail("你的实战体会已达到一个瓶颈，目前不适合阅读"+ name() +"。\n");
      else {
                exp2=1400+random(201);
                me->add("experience",exp2);

                message_vision("$N仔细研读了一" + query("unit") + name() + "，只觉一阵醍醐灌顶，顿时豁然开朗。\n", me);
	          write(YEL"恭喜您：获得了"+exp2+"点实战体会。"NOR"\n");

	          add_amount(-1);
                return 1;
            }

}

// 批量使用函数
int do_effect_more(object me, int amount)
{
      int i, exp2, total_exp, can_use, current_gap;

      if (amount <= 0) return 0;
      if (query_amount() < amount) {
          write("你没有足够的" + name() + "。\n");
          return 0;
      }

      if (me->is_busy())
                return notify_fail("你正忙着呢。\n");

	if (me->is_fighting())
		    return notify_fail("正在战斗中，不能使用"+ name() +"。\n");

      current_gap = me->query("experience") - me->query("learned_experience");
      if (current_gap > 500000)
                return notify_fail("你的实战体会已达到一个瓶颈，目前不适合阅读"+ name() +"。\n");

      // 计算可以使用的数量（基于实战体会瓶颈）
      can_use = (500000 - current_gap) / 1400;  // 按最小经验值计算
      if (can_use <= 0)
                return notify_fail("你的实战体会已达到一个瓶颈，目前不适合阅读"+ name() +"。\n");

      // 限制实际使用数量
      if (amount > can_use) {
          write(sprintf("以你目前的实战体会，最多只能再阅读%d页无量经书。\n", can_use));
          amount = can_use;
      }

      // 计算总经验增加
      total_exp = 0;
      for (i = 0; i < amount; i++) {
          exp2 = 1400 + random(201);
          total_exp += exp2;
      }

      me->add("experience", total_exp);
      message_vision(sprintf("$N仔细研读了%d%s%s，只觉一阵醍醐灌顶，顿时豁然开朗。\n", amount, query("unit"), name()), me);
      write(YEL"恭喜您：获得了"+total_exp+"点实战体会。"NOR"\n");

      add_amount(-amount);
      return 1;
}
