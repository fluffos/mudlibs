// gift_meridian_30.c
// 30元经脉入门礼包


inherit ITEM;

void create()
{
    set_name(HIY "经脉入门礼包" NOR, ({"meridian gift 30", "gift"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "这是一个300元宝的经脉入门礼包。\n"
                   HIC "礼包说明：约可开启2个经脉穴位\n" 
                   HIY "礼包内容：\n"
                   "1. 下品冲脉丹 x 100 (价值1000元宝)\n"
                   "2. 无量经书 x 5 (价值35元宝)\n"
                   "3. VIP月卡 x 1 (价值200元宝)\n"
                   HIW "\n礼包总价值：1235元宝\n"
                   HIR "特惠价格：300元宝 (省935元宝)\n" NOR
                   HIR "\n注意：礼包内所有物品均为绑定状态，每个礼包限购一次。\n" NOR);
        set("unit", "个");
        set("value", 1);
        set("no_drop", 1);
        set("no_give", 1);
        set("no_sell", 1);
        set("no_shop", 1);
        set("yuanbao", 300);
        set("no_bind_shop", 1);
        set("gift_desc", "约可开启2个经脉穴位");
        set("action_list", ([
            "打开礼包" : "open meridian gift 30",
        ]));
    }
    setup();
}

void init()
{
    add_action("do_open", "open");
}

int do_open(string arg)
{
    object me = this_player();
    object item;
    mapping gift_items = ([
        "/clone/vip/dan_chongmai1" : 100,  // 下品冲脉丹
        "/clone/vip/book_wuliang" : 5,     // 无量经书
        "/clone/vip/avipcard" : 1,         // VIP月卡
    ]);
    
    if (!id(arg))
        return 0;
    
    // 我是否拥有这个礼包
    if (environment(this_object()) != me)
        return notify_fail("你不能在非自己身上打开礼包。\n");
    
        
    // 发放物品
    foreach(string file, int amount in gift_items) {
        item = new_bind(file);
        if (!item) continue;
        
        if (item->query_amount())
            item->set_amount(amount);
            
        if (!item->move(me))
            item->move(environment(me));
    }
    
    tell_object(me, HIY "恭喜你打开了经脉入门礼包！\n" NOR);
    destruct(this_object());
    return 1;
}
