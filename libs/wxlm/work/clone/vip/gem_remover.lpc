// gem_remover.c

inherit COMBINED_ITEM;

string query_autoload() { return query_amount() + ""; }

void autoload(string param)
{
    int amt;
    if (sscanf(param, "%d", amt) == 1)
        set_amount(amt);
}

void setup()
{
    set_amount(1);
    ::setup();
}

void create()
{
    set_name(HIY "宝石拆卸符" NOR, ({ "gem remover", "remover" }));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "用来拆卸装备上的宝石的道具。\n");
        set("base_unit", "张");
        set("base_value", 1000);
        set("yuanbao", 100);
        set("base_weight", 1);
    }
    setup();
}