// gift_jiuzhuan_20.c
// 九转金丹礼包


inherit ITEM;

void create()
{
    set_name(HIY "九转金丹礼包" NOR, ({"jiuzhuan jindan gift", "gift"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "这是一个20颗九转金丹的特惠礼包。\n"
                   HIC "礼包说明：适合提升先天属性的玩家\n" 
                   HIY "礼包内容：\n"
                   "1. 九转金丹 x 20 (价值10000元宝)\n"
                   "2. 随机增加先天悟性、臂力、身法、体质\n"
                   "3. 每次使用增加1000-2000点灵慧\n" NOR
                   HIW "\n礼包总价值：10000元宝\n"
                   HIR "特惠价格：2000元宝 (优惠8000元宝)\n" NOR
                   HIR "\n注意：礼包内所有物品均为绑定状态，每个礼包限购一次。\n" NOR);
        set("unit", "个");
        set("value", 1);
        set("no_drop", 1);
        set("no_give", 1);
        set("no_sell", 1);
        set("no_shop", 1);
        set("yuanbao", 2000);
        set("no_bind_shop", 1);
        set("day_limit_number", 1);
        set("gift_desc", "提升灵慧必备礼包");
        set("action_list", ([
            "打开礼包" : "open jiuzhuan jindan gift",
        ]));
    }
    setup();
}

void init()
{
    add_action("do_open", "open");
}

int do_open(string arg)
{
    object me = this_player();
    object item;
    mapping gift_items = ([
        "/clone/vip/dan_jiuzhuan" : 20,       // 九转金丹
    ]);
    
    if (!id(arg))
        return 0;     

    if (environment(this_object()) != me)
        return notify_fail("你不能在非自己身上打开礼包。\n");
        
    // 发放物品
    foreach(string file, int amount in gift_items) {
        item = new_bind(file);
        if (!item) continue;
        
        if (item->query_amount())
            item->set_amount(amount);
            
        if (!item->move(me))
            item->move(environment(me));
    }

    
    tell_object(me, HIY "恭喜你打开了九转金丹礼包！\n" NOR);
    
    destruct(this_object());
    return 1;
}
