inherit COMBINED_ITEM;

void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
	set_name(HIM"小还丹"NOR, ({"xiaohuan dan"}));
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("base_value", 100000);
		set("yuanbao", 20);
        set("no_sell",1);
		set("base_unit", "颗");
		set("long","这是一颗小还丹，服用之后能增加100点内力修为！注：可以连续服用，不能超出人物的内力上限。\n");
        set("only_do_effect", 1); // 标识该物品可以使用
	}
	setup();
}

// 单次使用函数
int do_effect(object me) {
    if (!me) return 0;
    if (me->query("max_neili") > me->query_neili_limit())
        return notify_fail("你已经不能使用小还丹来提升内力修为了。\n");
    me->add("max_neili", 100);
    message_vision("$N服用了一颗小还丹，感觉内力有所提升。\n", me);
    add_amount(-1);
    return 1;
}

// 批量使用函数
int do_effect_more(object me, int amount) {
    int can_use, neili_limit, current_neili;
    if (!me) return 0;
    if (amount <= 0) return 0;
    if (query_amount() < amount) {
        write("你没有足够的" + name() + "。\n");
        return 0;
    }

    neili_limit = me->query_neili_limit();
    current_neili = me->query("max_neili");
    
    if (current_neili >= neili_limit)
        return notify_fail("你已经不能使用小还丹来提升内力修为了。\n");

    // 计算可以使用的数量（基于内力上限）
    can_use = (neili_limit - current_neili) / 100;
    if (can_use <= 0)
        return notify_fail("你已经不能使用小还丹来提升内力修为了。\n");

    // 限制实际使用数量
    if (amount > can_use) {
        write(sprintf("以你目前的内力修为，最多只能再服用%d颗小还丹。\n", can_use));
        amount = can_use;
    }

    me->add("max_neili", 100 * amount);
    message_vision(sprintf("$N服用了%d颗小还丹，感觉内力有所提升。\n", amount), me);
    add_amount(-amount);
    return 1;
}
