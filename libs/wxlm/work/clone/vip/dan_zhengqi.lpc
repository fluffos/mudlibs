


inherit COMBINED_ITEM;

void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
	set_name(HIR"正气丹"NOR, ({"zhengqi dan"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "一颗神奇的药丸，据说可以提升人物的浩然正气。\n");
		set("base_unit", "颗");
		set("base_unit", "颗");
		set("base_weight", 10);
		set("base_value", 10000);
		set("yuanbao", 10);
        set("no_sell", 1);
		set("only_do_effect", 1);
	}
	setup();
}

// 单次使用函数
int do_effect(object me)
{
    int var;

    if (me->is_busy())
        return notify_fail("你正忙着呢。\n");

	if (me->is_fighting())
		return notify_fail("正在战斗中，不能使用"+ name() +"。\n");

	{
        var=10000;
        me->add("shen",var);

        message_vision("$N小心服用了一" + query("unit") + name() + "，一股浩然正气油然而生。\n", me);

	    add_amount(-1);
        return 1;
    }

}

// 批量使用函数
int do_effect_more(object me, int amount)
{
    int var;

    if (amount <= 0) return 0;
    if (query_amount() < amount) {
        write("你没有足够的" + name() + "。\n");
        return 0;
    }

    if (me->is_busy())
        return notify_fail("你正忙着呢。\n");

    if (me->is_fighting())
        return notify_fail("正在战斗中，不能使用"+ name() +"。\n");

    var = 10000 * amount;
    me->add("shen", var);

    message_vision(sprintf("$N小心服用了%d%s%s，一股浩然正气油然而生。\n", amount, query("unit"), name()), me);

    add_amount(-amount);
    return 1;
}
