inherit COMBINED_ITEM;
void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
	set_name(HIY"金票"NOR, ({"jin piao"}));
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("base_value", 10000000);
		set("yuanbao", 200);
                set("no_sell",1);
		set("base_unit", "张");
		set("no_bind_shop", 1);//绑定商城不能购买
		set("long","这是一张金票，兑换后可以获得一千两黄金！\n");
		set("spectxt", "兑换后获得一千两黄金。\n");
		set("only_do_effect", 1); // 标识该物品可以使用
		set("no_shop", 1); // 标识该物品不能在商城购买
	}
	setup();
}

/**
 * @brief 批量使用金票的效果函数
 * @param object me 使用物品的玩家对象
 * @param int amount 使用的数量
 * @return int 返回1表示使用成功，0表示使用失败
 * @details 处理批量金票的使用逻辑，累积增加钱庄账户余额
 */
int do_effect_more(object me, int amount)
{
    int total_money;
    
    if (!me) return 0;
    
    // 显示使用动作
    message_vision("$N兑换了" + amount + "张金票。\n", me);
    
    // 计算总金额
    total_money = 10000000 * amount;
    
    // 应用效果
    me->add("balance", total_money);
    
    // 成功提示
    tell_object(me, "你兑换了" + amount + "张金票，钱庄账户新增了" + (total_money/10000) + "两黄金。\n");
    
    add_amount(-amount);
    return 1;
}

/**
 * @brief 单次使用金票的效果函数
 * @param object me 使用物品的玩家对象
 * @return int 返回1表示使用成功，0表示使用失败
 * @details 处理单个金票的使用逻辑
 */
int do_effect(object me) {
    if (!me) return 0;
    me->add("balance", 10000000);
    message_vision("$N兑换了一张金票，钱庄账户新增了一千两黄金。\n", me);
    add_amount(-1);
    return 1;
}
