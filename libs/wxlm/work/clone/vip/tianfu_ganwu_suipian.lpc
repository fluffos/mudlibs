// jinsha.c


inherit COMBINED_ITEM;
string query_autoload() { return query_amount() + ""; }

void autoload(string param)
{
	int amt;

	if (sscanf(param, "%d", amt) == 1)
		set_amount(amt);
}

void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
	set_name(HIW "天赋感悟碎片" NOR, ({ "tianfuganwu suipian" }));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "用来升级天赋的天赋感悟碎片。\n");
		set("base_unit", "个");
		set("base_value", 500);
		set("yuanbao", 5);
		set("no_bind_shop", 1);//绑定商城不能购买
		set("base_weight", 1);
		//每日限购50
		// set("day_limit_number", 50);
	}
	setup();
}

