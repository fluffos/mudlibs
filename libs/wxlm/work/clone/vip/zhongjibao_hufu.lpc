inherit COMBINED_ITEM;

string query_autoload() { return query_amount() + ""; }

void autoload(string param)
{
    int amt;

    if (sscanf(param, "%d", amt) == 1)
        set_amount(amt);
}

void setup()
{
    set_amount(1);
    ::setup();
}

void create()
{
    set_name(HIW "装备保护符[中级]" NOR, ({ "zhongjibao hufu" }));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "用来品质强化装备的保护道具。\n");
        set("base_unit", "张");
        set("base_value", 1000);
        set("yuanbao", 30);
        set("base_weight", 1);
    }
    setup();
}