// jinsha.c
#define AOYID "/adm/daemons/aoyid"


inherit COMBINED_ITEM;
void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
	set_name(HIM "百家宝匣" NOR, ({ "baijia baoxia" }));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "这是一个古朴精致的宝匣，据传为华夏诸子百家遗留之物，内藏各派先学遗训残页。\n"
		            "宝匣似有灵性，唯有诸子现世之际方可开启，开启后可随机获得一张珍贵的先学遗训残页。\n"
		            "百家争鸣，道法自然，得此宝匣者可窥百家智慧，集诸子所长。\n");
		set("base_unit", "本");
		set("base_unit", "本");
		set("base_value", 500);
		set("yuanbao", 60);
        set("no_sell", 1);
		// set("no_shop", 1);
		set("only_do_effect", 1);
		set("base_weight", 1);
		set("only_do_effect", 1); // 标识该物品可以使用
	}
	setup();
}

int do_effect(object me) {
	string *yixun_list = AOYID->get_yixun_list();
    string yixun;

    yixun = yixun_list[random(sizeof(yixun_list))];
    me->add("aoyi_canye/" + yixun, 1);
	
    me->save();
    write(HIG"你从百家宝匣中获得了一张先学遗训残页：" + yixun + "。\n"NOR);
    add_amount(-1);
    return 1;
}

