// tianxiang.c 天香玉露



inherit COMBINED_ITEM;

void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
	set_name(HIW "福寿丹" NOR, ({"fushou gao", "fushou", "gao"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("base_unit", "颗");
		set("long", HIY "一块让人增加精神的丹药，来自于全真教。\n");
		set("base_value", 200000);
		set("yuanbao", 20);
		set("only_do_effect", 1);
	}
	setup();
}

// 单次使用函数
int do_effect(object me)
{

	message_vision(HIC"$N掏出一颗"
		       NOR HIW"福寿丹，"NOR HIC"吃了下去，精神力大增，脸上露出满足的表情。"NOR"\n",
		       me);
	if (me->improve_jingli(50 + random(40)))
		me->set("jingli", me->query("max_jingli"));
		add_amount(-1);
	return 1;
}

// 批量使用函数
int do_effect_more(object me, int amount)
{
	int i, total_jingli;

	if (amount <= 0) return 0;
	if (query_amount() < amount) {
		write("你没有足够的" + name() + "。\n");
		return 0;
	}

	message_vision(sprintf(HIC"$N掏出%d颗"NOR HIW"福寿丹，"NOR HIC"一口气吃了下去，精神力大增，脸上露出满足的表情。"NOR"\n", amount), me);

	// 计算总精神力增加
	total_jingli = 0;
	for (i = 0; i < amount; i++) {
		total_jingli += 50 + random(40);
	}

	if (me->improve_jingli(total_jingli))
		me->set("jingli", me->query("max_jingli"));

	add_amount(-amount);
	return 1;
}

