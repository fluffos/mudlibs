

inherit COMBINED_ITEM;

void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
    set_name(HIG"悟心树"NOR"种子", ({"wuxin seed", "enlightenment seed", "seed"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "这是一颗悟心树种子，可以用来种植悟心树。\n");
        set("base_unit", "颗");
        set("base_value", 200);
        set("base_weight", 1);
        set("yuanbao",20);
        set("crop_type", "悟心树");
        set("no_split", 1);
    }
    setup();
}