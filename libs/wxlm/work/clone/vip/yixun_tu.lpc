inherit COMBINED_ITEM;

#define AOYID "/adm/daemons/aoyid"

void setup()
{
    set_amount(1);
    ::setup();
}

string query_autoload() { return query_amount() + ""; }

void autoload(string param)
{
    int amt;

    if (sscanf(param, "%d", amt) == 1)
        set_amount(amt);
}

void create()
{
    set_name(HIY "先学遗训图谱" NOR, ({ "yixun tu", "yixun", "tu" }));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "这是一幅珍贵的先学遗训图谱，上面记载了各种先学遗训的奥秘。\n"
                    "使用此图谱可以选择获得一张特定的先学遗训残页。\n"
                    "先贤智慧，尽在其中，可助习武之人事半功倍。\n");
        set("base_unit", "幅");
        set("base_value", 1000);
        set("yuanbao", 90);
        set("no_sell", 1);
        set("base_weight", 1);
        set("no_drop", 1);
        set("no_get", 1);
        set("no_give", 1);
        set("no_bind_shop", 1);
        set("only_do_effect", 1);
        set("day_limit_number", 5);
    }
    setup();
}

void init()
{
    add_action("do_choose_yixun", "choose_yixun");
    add_action("do_chose_amount", "chose_amount");
}

int do_choose_yixun(string arg)
{
    object me = this_player();
    string *yixun_list = AOYID->get_yixun_list();
    string yixun;
    int amount = 1;
    
    if (!arg)
    {
        write("你要选择哪种先学遗训残页？指令格式：choose_yixun <遗训名称> [数量]\n");
        return 1;
    }
    
    if (sscanf(arg, "%s %d", yixun, amount) == 2)
    {
        arg = yixun;
    }
    
    if (member_array(arg, yixun_list) == -1)
    {
        write("没有这种先学遗训。\n");
        return 1;
    }
    
    if (amount < 1)
    {
        write("数量必须大于零。\n");
        return 1;
    }
    
    if (amount > query_amount())
    {
        write("你没有那么多的先学遗训图谱。\n");
        return 1;
    }
    
    me->add("aoyi_canye/" + arg, amount);
    me->save();
    
    write(HIG"你从先学遗训图谱中获得了" + chinese_number(amount) + "张先学遗训残页：" + arg + "。\n"NOR);
    add_amount(-amount);
    return 1;
}

int do_effect(object me)
{
    string *yixun_list = AOYID->get_yixun_list();
    string msg, *button_list = ({ });
    
    msg = HIY"可选择的先学遗训列表：\n"NOR;
    msg += "你目前拥有" + chinese_number(query_amount()) + "幅先学遗训图谱。\n";
    msg += "请选择要兑换的遗训类型：\n";

    foreach (string yixun in yixun_list)
    {
        button_list += ({sprintf("%s:chose_amount %s", yixun, yixun)});
    }
    
    tell_object(me, popup_comb(msg, button_list));
    return 1;
}

int do_chose_amount(string arg)
{
    object me = this_player();
    string *yixun_list = AOYID->get_yixun_list();
    
    if (!arg || member_array(arg, yixun_list) == -1)
    {
        write("没有这种先学遗训。\n");
        return 1;
    }
    
    tell_object(me, popup_input("请输入要兑换的数量：", "choose_yixun " + arg + " "));
    return 1;
}