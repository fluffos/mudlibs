// jinsha.c


inherit COMBINED_ITEM;
string query_autoload() { return query_amount() + ""; }

void autoload(string param)
{
	int amt;

	if (sscanf(param, "%d", amt) == 1)
		set_amount(amt);
}

void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
	set_name(HIG "天香玉露" NOR, ({"magic water", "yvlu", "lu"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("base_unit", "滴");
		set("base_unit", "滴");
		set("long", HIG "这是附着在灵芝上的一滴晶莹剔透的玉露，传说采自"
				"灵山，千年来以灵芝为母，不断的吸取着日精月华，具有着无比神奇的功效"
				"(随机加120-269最大内力，不可超出最大内力修为，同时基础内180级或者当前激发内功低于180级时可以增加4万熟练度)。\n");
		set("base_value", 100000);
		set("base_value", 100000);
		set("base_weight", 1);
		set("yuanbao", 30);
		set("only_do_effect", 1);
	}
	setup();
}

/**
 * @brief 批量使用天香玉露的效果函数
 * @param object me 使用物品的玩家对象
 * @param int amount 使用的数量
 * @return int 返回1表示使用成功
 * @details 批量使用天香玉露，增加内力和技能熟练度
 */
int do_effect_more(object me, int amount)
{
	string force;
	int i, neili_improved;

	message_vision(HIG "$N" HIG "小心翼翼的将" + amount + "滴玉露含在嘴中，登时觉得"
		       "灵台一阵空明，浑身上下飘飘欲仙，一时间竟有不在尘世的感觉。"NOR"\n",
		       me);

	// 批量增加内力
	neili_improved = 0;
	for (i = 0; i < amount; i++) {
		if (me->improve_neili(120 + random(150)))
			neili_improved = 1;
	}
	if (neili_improved)
		me->set("neili", me->query("max_neili"));

	// 批量增加技能熟练度
	force = me->query_skill_mapped("force");
	if (me->can_improve_skill("force") && me->query_skill("force",1) < 180)
		me->improve_skill("force", 40000 * amount);
	if (stringp(force) && me->can_improve_skill(force) && me->query_skill(force,1) < 180)
		me->improve_skill(force, 40000 * amount);

	me->start_busy(3);
	add_amount(-amount);
	return 1;
}

/**
 * @brief 单次使用天香玉露的效果函数
 * @param object me 使用物品的玩家对象
 * @return int 返回1表示使用成功
 * @details 单次使用天香玉露，增加内力和技能熟练度
 */
int do_effect(object me)
{
	string force;

	message_vision(HIG "$N" HIG "小心翼翼的将玉露含在嘴中，登时觉得"
		       "灵台一阵空明，浑身上下飘飘欲仙，一时间竟有不在尘世的感觉。"NOR"\n",
		       me);
	if (me->improve_neili(120 + random(150)))
		me->set("neili", me->query("max_neili"));

	force = me->query_skill_mapped("force");
	if (me->can_improve_skill("force")&&me->query_skill("force",1)<180)
		me->improve_skill("force", 40000);
	if (stringp(force) && me->can_improve_skill(force)&&me->query_skill(force,1)<180)
		me->improve_skill(force, 40000);

	me->start_busy(3);
	add_amount(-1);
	return 1;
}
