// gift_meridian_328.c
// 328元经脉大成礼包


inherit ITEM;

void create()
{
    set_name(HIY "经脉大成礼包" NOR, ({"meridian gift 328", "gift"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "这是一个3280元宝的经脉大成礼包。\n"
                   HIC "礼包说明：约可开启16-19个经脉穴位\n" 
                   HIY "礼包内容：\n"
                   "1. 极品冲脉丹 x 500 (价值25000元宝)\n"
                   "2. 上品冲脉丹 x 300 (价值9000元宝)\n"
                   "3. 经脉重塑丹 x 1 (价值500元宝)\n"
                   "4. 无量经书 x 30 (价值210元宝)\n"
                   "5. VIP月卡 x 5 (价值1000元宝)\n"
                   "6. 九转金丹 x 1 (价值500元宝)\n" NOR
                   HIW "\n礼包总价值：36210元宝\n"
                   HIR "特惠价格：3280元宝 (省32930元宝)\n" NOR
                   HIR "\n注意：礼包内所有物品均为绑定状态，每个礼包限购一次。\n" NOR);
        set("unit", "个");
        set("value", 1);
        set("no_drop", 1);
        set("no_give", 1);
        set("no_sell", 1);
        set("no_shop", 1);
        set("yuanbao", 3280);
        set("no_bind_shop", 1);//绑定商城不能购买
        set("gift_desc", "约可开启16-19个经脉穴位");
        set("action_list", ([
            "打开礼包" : "open meridian gift 328",
        ]));
    }
    setup();
}

void init()
{
    add_action("do_open", "open");
}

int do_open(string arg)
{
    object me = this_player();
    object item;
    mapping gift_items = ([
        "/clone/vip/dan_chongmai4" : 500,  // 极品冲脉丹
        "/clone/vip/dan_chongmai3" : 300,  // 上品冲脉丹
        "/clone/vip/dan_chongsu" : 1,      // 经脉重塑丹
        "/clone/vip/book_wuliang" : 30,    // 无量经书
        "/clone/vip/avipcard" : 5,         // VIP月卡
        "/clone/vip/dan_jiuzhuan" : 1,     // 九转金丹
    ]);
    
    if (!id(arg))
        return 0;
        
    if (environment(this_object()) != me)
        return notify_fail("你不能在非自己身上打开礼包。\n");
    // 发放物品
    foreach(string file, int amount in gift_items) {
        item = new_bind(file);
        if (!item) continue;
        
        if (item->query_amount())
            item->set_amount(amount);
            
        if (!item->move(me))
            item->move(environment(me));
    }
    
    tell_object(me, HIY "恭喜你打开了经脉大成礼包！\n" NOR);
    
    destruct(this_object());
    return 1;
}
