// wusheng_book.c - 武圣经义
// 功能：当玩家经验低于前十玩家经验平均数时，增加1万经验，否则不能使用
// 售价：20元宝

inherit COMBINED_ITEM;

void setup()
{
    set_amount(1);
    ::setup();
}

void create()
{
    set_name(HIY "武圣经义" NOR, ({ "wusheng jingyi", "wusheng", "jingyi", "book" }) );
    set_weight(200);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", HIY "这是一本由武学大家撰写的武学心法秘籍，据说阅读后可以顿悟武学精髓，提升经验。\n"
                  "只有武学修为不足的人才能从中获益（经验低于2亿）。\n" NOR);
        set("base_unit", "本");
        set("base_weight", 10);
        set("base_value", 10000);
        set("yuanbao", 35);
        set("no_sell", 1);
        set("only_do_effect", 1);
        set("day_limit_number", 30);
    }
    setup();
}

int do_effect_more(object me,int amount)
{
    int top_avg_exp, my_exp;
    
    message_vision("$N翻开" + query("name") + "，仔细研读其中的武学心法。\n", me);
    
    // 获取前十玩家的平均经验值
    top_avg_exp = TOP_D->query_top10_exp_average();
    
    // 获取玩家当前经验值
    my_exp = me->query("combat_exp");

    //经验大于2e无法使用
    if ((my_exp + 10000*amount) > 200000000)

    {
        tell_object(me, HIR "你的武道修为已经很高了，无法从这本书中获得更多领悟。\n" NOR);
        return 1;  // 使用失败，不消耗道具
    }
    
    // 判断玩家经验是否低于平均值
    if (my_exp < top_avg_exp)
    {
        // 增加1万经验
        me->add("combat_exp", 10000*amount);

        
        tell_object(me, HIG "你从武圣经义中领悟到了武学精髓，武道经验增加了！\n" NOR);
        tell_object(me, HIY "你获得了" + (10000*amount) + "点经验。\n" NOR);
        
        // 记录使用信息
        log_file("static/wusheng_book", 
                sprintf("%s(%s) 使用武圣经义获得%d经验 经验:%d 平均值:%d。\n",
                me->name(1), me->query("id"), 10000*amount, my_exp, top_avg_exp));
    }
    else
    {
        tell_object(me, HIR "你的武道修为已经很高了，无法从这本书中获得更多领悟。\n" NOR);
        return 1;  // 使用失败，不消耗道具
    }
    
    // 使用成功，消耗道具
    add_amount(-amount);
    return 1;
}

int do_effect(object me)
{
    int top_avg_exp, my_exp;
    
    message_vision("$N翻开" + query("name") + "，仔细研读其中的武学心法。\n", me);
    
    // 获取前十玩家的平均经验值
    top_avg_exp = TOP_D->query_top10_exp_average();
    
    // 获取玩家当前经验值
    my_exp = me->query("combat_exp");

    //经验大于2e无法使用
    if (my_exp > 200000000)
    {
        tell_object(me, HIR "你的武道修为已经很高了，无法从这本书中获得更多领悟。\n" NOR);
        return 1;  // 使用失败，不消耗道具
    }
    
    // 判断玩家经验是否低于平均值
    if (my_exp < top_avg_exp)
    {
        // 增加1万经验
        me->add("combat_exp", 10000);
        
        tell_object(me, HIG "你从武圣经义中领悟到了武学精髓，武道经验增加了！\n" NOR);
        tell_object(me, HIY "你获得了10000点经验。\n" NOR);
        
        // 记录使用信息
        log_file("static/wusheng_book", 
                sprintf("%s(%s) 使用武圣经义获得10000经验 经验:%d 平均值:%d。\n",
                me->name(1), me->query("id"), my_exp, top_avg_exp));
    }
    else
    {
        tell_object(me, HIR "你的武道修为已经很高了，无法从这本书中获得更多领悟。\n" NOR);
        return 1;  // 使用失败，不消耗道具
    }
    
    // 使用成功，消耗道具
    add_amount(-1);
    return 1;
}
