inherit COMBINED_ITEM;

void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
	set_name(HIR"仓库扩容卡"NOR, ({"cangku_add_book"}));
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("yuanbao", 100);
		set("long","这是一张仓库扩容卡，使用之后增加仓库容量1格!\n");
        set("no_sell",1);
		set("base_unit", "张");
		set("base_value", 50000);
		set("base_weight", 1);
        set("only_do_effect", 1); // 标识该物品可以使用
	}
	setup();
}

int do_effect(object me) {
    object cangku_master;
    int current_size;
    
    if (!objectp(me))
        return 0;
        
    // 获取仓库管理器对象
    cangku_master = load_object("/adm/special_ob/player/cangku/cangku_master");
        
    if (!objectp(cangku_master))
        return notify_fail("仓库系统出现故障，请联系管理员。\n");
        
    // 获取当前仓库容量
    current_size = cangku_master->query_cangku_max_size(me);
    
    // 设置新的仓库容量
    cangku_master->set_cangku_max_size(me, current_size + 1);
    
    tell_object(me, HIG "你的仓库容量增加了1格！\n" NOR);
    
    add_amount(-1);
    return 1;
}
