// /clone/baoshi/green_diaozhuofu.c


inherit COMBINED_ITEM;

void create()
{
    set_name(HIG "绿色宝石雕琢符" NOR, ({"green gem carving talisman", "green talisman", "talisman"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "这是一张神奇的符咒,可以将白色宝石雕琢成绿色宝石。\n");
        set("base_unit", "张");
        set("base_value", 5000);
        set("base_weight", 1);
        set("yuanbao", 5);
        set("no_bind_shop", 1);//绑定商城不能购买
        set("no_sell", 1);
        set("no_drop", 1);
        set("no_give", 1);
        set("action_list", ([
            "雕琢一个" : "carve_gem",
            "雕琢一批" : "carve_gem batch",
        ]));
    }
    set_amount(1);
    setup();
}

void init()
{
    add_action("do_carve_gem", "carve_gem");
}

int do_carve_gem(string arg)
{
    object me = this_player();
    object white_gem, green_gem;
    int i, convert_count, white_gem_count, talisman_count;
    
    if (arg && arg != "batch")
        return notify_fail("雕琢方法: carve_gem 或 carve_gem batch\n");
    
    white_gem = present("white gem", me);
    if (!white_gem)
        return notify_fail("你身上没有白色宝石。\n");
    
    if (!arg)
    {
        green_gem = new("/clone/baoshi/green_baoshi");
        green_gem->move(me);
        
        message_vision("$N小心翼翼地将" + name() + "贴在白色宝石上,只见一道绿光闪过,白色宝石变成了" + green_gem->name() + "。\n", me);
        
        if (white_gem->query_amount() > 1)
            white_gem->add_amount(-1);
        else
            destruct(white_gem);
        
        add_amount(-1);
    }
    else if (arg == "batch")
    {
        white_gem_count = white_gem->query_amount();
        talisman_count = query_amount();
        
        convert_count = (white_gem_count < talisman_count) ? white_gem_count : talisman_count;
        
        if (convert_count > 0)
        {
            for (i = 0; i < convert_count; i++)
            {
                green_gem = new("/clone/baoshi/green_baoshi");
                green_gem->move(me);
            }
            
            message_vision("$N拿出一叠" + name() + "，开始批量雕琢白色宝石。转眼间，" + 
                           chinese_number(convert_count) + "颗白色宝石变成了绿色宝石。\n", me);
            
            if (white_gem_count > convert_count)
                white_gem->add_amount(-convert_count);
            else
                destruct(white_gem);
            
            add_amount(-convert_count);
        }
        else
        {
            return notify_fail("雕琢失败,请检查你的白色宝石和雕琢符数量。\n");
        }
    }
    
    return 1;
}