inherit COMBINED_ITEM;

void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
	set_name(HIR"体验月卡"NOR, ({"month card"}));
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("yuanbao", 200);
		set("long","这是一张体验月卡，使用之后增加30天体验会员时间!\n");
        set("no_sell",1);
		set("base_unit", "张");
		set("base_value", 50000);
		set("base_weight", 1);
        set("only_do_effect", 1); // 标识该物品可以使用
	}
	setup();
}

int do_effect(object me) {
    int vip_time;
    vip_time = 30 * 24 * 3600;
    if (!me) return 0;
    write(YEL"你的体验会员时间增加30天！"NOR"\n");
    me->add("zjvip/times", vip_time);
    me->save();
    add_amount(-1);
    return 1;
}
