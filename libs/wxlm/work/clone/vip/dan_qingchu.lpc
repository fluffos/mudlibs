// dan_qingchu.c
inherit COMBINED_ITEM;
int select_skill(string skill_id);
void setup()
{
    set_amount(1);
    ::setup();
}

void create()
{
    set_name(HIC "元素清除丹" NOR, ({ "qingchu dan", "qingchu", "dan" }));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "一粒闪烁着五彩光芒的丹药，服用后可以清除一个武学的所有元素。\n");
        set("base_unit", "粒");
        set("base_value", 50000);
        set("yuanbao", 500);
        set("only_do_effect", 1);
        set("base_weight", 1);
    }
    setup();
}

void init()
{
    add_action("select_skill", "select_skill");
}

int do_effect(object me)
{
    string msg = "请选择要清除元素的武学：\n";
    string *options = ({});
    mapping skills = me->query_skills();
    mapping elements = me->query("wuxue_elements_wuxing");
    
    if (!me->query("wuxue_elements_wuxing"))
    {
        tell_object(me, "你还没有解锁任何元素，无需使用此丹药。\n");
        return 1;
    }
    if (!elements || !sizeof(elements))
    {
        tell_object(me, "你还没有解锁任何元素，无需使用此丹药。\n");
        return 1;
    }
    
    foreach (string skill in keys(elements))
    {
        if (skills[skill])
        {
            options += ({ to_chinese(skill) + ":select_skill " + skill });
        }
    }
    
    if (sizeof(options) == 0)
    {
        tell_object(me, "你没有可以清除元素的武学。\n");
        return 1;
    }
    
    write(popup_comb(msg, options));

    return 1;
}

int select_skill(string skill_id)
{
    mapping elements;
    object me = this_player();
    if (!me->query_skill(skill_id))
    {
        tell_object(me, "你没有学习过这个武学。\n");
        return 1;
    }

    elements = me->query("wuxue_elements_wuxing");
    if (!elements || !elements[skill_id])
    {
        tell_object(me, "这个武学没有解锁任何元素。\n");
        return 1;
    }

    // 清除该武学的所有元素
    map_delete(elements, skill_id);
    me->set("wuxue_elements_wuxing", elements);

    tell_object(me, HIC "你服下元素清除丹，感到一阵清凉流遍全身。\n" NOR);
    tell_object(me, HIY "你的" + to_chinese(skill_id) + "武学的所有元素已被清除。\n" NOR);

    add_amount(-1);
    return 1;
}

string query_autoload() { return query_amount() + ""; }
