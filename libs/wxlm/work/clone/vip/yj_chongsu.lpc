#define AOYI_D "/adm/daemons/aoyid"
inherit COMBINED_ITEM;

void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
	set_name(HIY "意境重塑稿" NOR, ({ "yijing_gao" }) );
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一份意境重塑稿，和意境卷轴属于统一材质，玩家可以将已经有的意境全部重塑成意境卷轴。\n");
		set("base_unit", "颗");
		set("base_unit", "颗");
		set("base_weight", 10);
		set("base_value", 10000);
		set("yuanbao", 1000);
		set("no_sell", 1);
		set("suit_point", 300);
		set("only_do_effect", 1);
	}
	setup();
}

int do_effect(object me)
{
	string *yjSkillNameList;
	int number = 0;
	object obj;

	if (!me->query("skill_aoyi"))
	{
		tell_object(me, "你还没有意境技能，无法使用意境重塑稿。\n");
		return 1;
	}

	yjSkillNameList = keys(me->query("skill_aoyi"));

	if (!sizeof(yjSkillNameList))
	{
		tell_object(me, "你还没有意境技能，无法使用意境重塑稿。\n");
		return 1;
	}

	// 重塑意境,foreach读取所有数量
	foreach (string yjSkillName in yjSkillNameList)
	{
		int add_number = 0;

		if (AOYI_D->is_general_aoyi(yjSkillName))
		{
			for(int i = 0; i < me->query("skill_aoyi/" + yjSkillName); i++)
			{
				add_number += i + 2;
			}
			me->add("aoyi_canye/" + yjSkillName, me->query("skill_aoyi/" + yjSkillName) *100);

			tell_object(me, "你获得了" + chinese_number(me->query("skill_aoyi/" + yjSkillName) *100) + "张" + yjSkillName + HIY "残页" NOR + "。\n");
		}
		else if (me->query("skill_aoyi/" + yjSkillName) > 9)
		{
			int i = 0;
			int j = me->query("skill_aoyi/" + yjSkillName) - 9;

			for(i = 0; i < j; i++)
			{
				add_number += i + 2;
			}

			add_number += 9;
		}
		else
		{
			add_number = me->query("skill_aoyi/" + yjSkillName);
		}

		number += add_number;

		me->delete("skill_aoyi/" + yjSkillName);
	}

	me->delete("skill_aoyi");

	obj = new_bind("/clone/aoyi_book/aoyi_book");
	obj->set_amount(number);
	message_vision("$N使用了一" + query("unit") + name() + "。\n", me);
	tell_object(me, "你的意境技能已经全部重塑成了意境卷轴。\n");
	tell_object(me, "你获得了" + number + "本" + obj->query("name") + "。\n");
	obj->move(me);

	add_amount(-1);
	return 1;
}

