// gift_base.c
// 礼包基类


inherit ITEM;

// 礼包内容配置(由继承者设置)
nosave mapping gift_items = ([]);
nosave string gift_name = "";
nosave string gift_desc = "";
nosave int gift_yuanbao = 0;

void create()
{
    set_name(HIY "未命名礼包" NOR, ({"unnamed gift"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "这是一个礼包。\n");
        set("unit", "个");
        set("value", 1);
        set("no_drop", 1);
        set("no_give", 1);
        set("no_sell", 1);
        set("no_shop", 1);  // 添加no_shop标记
    }
    setup();
}

void init()
{
    add_action("do_open", "open");
}

// 检查是否已购买过
int check_bought(object me)
{
    return me->query("gift/vip_gift/" + gift_yuanbao);
}

// 打开礼包
int do_open(string arg)
{
    object me = this_player();
    object item;
    
    if (!id(arg))
        return 0;
        
    if (check_bought(me))
        return notify_fail("你已经购买过这个礼包了。\n");
        
    // 发放物品
    foreach(string file, int amount in gift_items) {
        item = new_bind(file);  // 使用new_bind创建绑定物品
        if (!item) continue;
        
        if (item->query_amount())
            item->set_amount(amount);
            
        if (!item->move(me))
            item->move(environment(me));
    }
    
    // 记录购买
    me->set("gift/vip_gift/" + gift_yuanbao, 1);
    
    tell_object(me, sprintf(HIY "恭喜你打开了%s！\n" NOR, gift_name));
    
    destruct(this_object());
    return 1;
}
