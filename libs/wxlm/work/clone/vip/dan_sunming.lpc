


inherit COMBINED_ITEM;

void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
	set_name(HIG"损命丹"NOR, ({"sunming dan"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "一颗神奇的药丸，据说能损失寿命强行提升年龄。\n");
		set("base_unit", "颗");
		set("base_unit", "颗");
		set("base_weight", 10);
		set("base_value", 10000);
		set("yuanbao", 10);
        set("no_sell", 1);
		set("only_do_effect", 1);
	}
	setup();
}

int do_effect(object me)
{
    int var;

    if (me->is_busy())
            return notify_fail("你正忙着呢。\n");

	if (me->is_fighting())
		    return notify_fail("正在战斗中，不能使用"+ name() +"。\n");

    // if (me->query("mud_age")<86400*18)
    //         return notify_fail("你目前无需使用"+ name() +"。\n");
    else {
        var=86400 * 3;
        me->add("mud_age",var);
		me->add("dan/sunming",1);
        message_vision("$N小心服用了一" + query("unit") + name() + "，似乎寿命损失了一些。\n", me);
	    add_amount(-1);
        return 1;
    }

}
