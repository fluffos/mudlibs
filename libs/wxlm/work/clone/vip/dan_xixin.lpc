// jinsha.c



inherit COMBINED_ITEM;
void setup()
{
	set_amount(1);
	::setup();
}
void create()
{
	set_name(HIW "洗心丹" NOR, ({ "xixin dan" }));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "一粒晶莹剔透的丹药，服了之后使人强行散去本门武功，从而重新拜师学艺("HIR"注意：一旦使用将清除所有已经请教的绝学"NOR")。\n");
		set("base_unit", "粒");
		set("base_value", 50000);
		set("yuanbao", 1000);
		set("only_do_effect", 1);
		set("base_weight", 1);
	}
	setup();
}

int do_effect(object me)
{

	if(me->query("tuoli_times") > 0)
	{
		me->add("tuoli_times",-1);
		tell_object(me,"你服用了洗心丹，减少了一次绝义次数。\n");
	}
	else
	{
		tell_object(me,"你的总绝义次数低于1，无法使用洗心丹。\n");
		return 1;
	}

	// destruct(this_object());
	add_amount(-1);

	return 1;
}

string query_autoload() { return query_amount() + ""; }