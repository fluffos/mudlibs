inherit COMBINED_ITEM;

string query_autoload() { return query_amount() + ""; }

void autoload(string param)
{
    int amt;

    if (sscanf(param, "%d", amt) == 1)
        set_amount(amt);
}

void setup()
{
    set_amount(1);
    ::setup();
}

void create()
{
    set_name(HIW "装备保护符[高级]" NOR, ({ "gaojibao hufu" }));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "用来品质强化装备的保护道具。\n");
        set("base_unit", "张");
        set("base_value", 1500);
        set("yuanbao", 50);
        set("base_weight", 1);
    }
    setup();
}