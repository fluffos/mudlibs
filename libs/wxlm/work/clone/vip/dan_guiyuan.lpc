inherit COMBINED_ITEM;

void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
	set_name(HIR "五藏归元丹" NOR, ({ "wucang guiyuan dan" }) );
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一颗通体金黄的灵丹，表面流转着五色光华，隐隐有龙吟虎啸之声。\n"
			    "此乃上古仙人采集五行精华炼制而成，服用后可固本培元，大幅提升\n"
			    "人体气血运行，使服用者脱胎换骨，重获新生。(注：每次使用提升气血上限50，服用有上限，人物等级每提升1级可以服用一颗)\n");
		set("base_unit", "颗");
		set("base_weight", 10);
		set("base_value", 50000);
		set("yuanbao", 300);
		set("no_sell", 1);
		set("only_do_effect", 1);
        set("day_limit_number", 10);
	}
	setup();
}

// 单次使用函数
int do_effect(object me)
{

	log_file("nosave/using", sprintf("%s(%s) eat 五藏归元丹 at %s.\n",
		 me->name(1), me->query("id"), ctime(time())));
	message_vision("$N一仰脖，吞下了一" + query("unit") + name() + "。\n", me);

	tell_object(me, HIG "你只觉一股暖流自丹田升起，瞬间流遍全身奇经八脉。\n" 
		HIC "五脏六腑仿佛被洗涤一般，说不出的舒泰畅快。\n" 
		HIY "周身气血如江河奔涌，气血上限更上一层楼！\n" NOR);

	//只能吃到等级上限
	if (me->query("wucang/number") >= me->query("level"))
	{
		tell_object(me, HIY "你已经服用了太多五藏归元丹，再服用已经没有效果了。\n" NOR);
		return 1;
	}
	

	me->add("wucang/max_qi", 50);
	me->add("wucang/number", 1);

	add_amount(-1);
      return 1;
}

// 批量使用函数
int do_effect_more(object me, int amount)
{
	int can_use;

	if (amount <= 0) return 0;
	if (query_amount() < amount) {
		write("你没有足够的" + name() + "。\n");
		return 0;
	}

	log_file("nosave/using", sprintf("%s(%s) eat %d 五藏归元丹 at %s.\n",
		 me->name(1), me->query("id"), amount, ctime(time())));

	//只能吃到等级上限
	if (me->query("wucang/number") >= me->query("level"))
	{
		tell_object(me, HIY "你已经服用了太多五藏归元丹，再服用已经没有效果了。\n" NOR);
		return 1;
	}

	// 计算可以使用的数量（基于等级限制）
	can_use = me->query("level") - me->query("wucang/number");
	if (can_use <= 0)
	{
		tell_object(me, HIY "你已经服用了太多五藏归元丹，再服用已经没有效果了。\n" NOR);
		return 1;
	}

	// 限制实际使用数量
	if (amount > can_use) {
		write(sprintf("以你目前的等级，最多只能再服用%d颗五藏归元丹。\n", can_use));
		amount = can_use;
	}

	message_vision(sprintf("$N一口气吞下了%d%s%s。\n", amount, query("unit"), name()), me);

	tell_object(me, HIG "你只觉一股暖流自丹田升起，瞬间流遍全身奇经八脉。\n" 
		HIC "五脏六腑仿佛被洗涤一般，说不出的舒泰畅快。\n" 
		HIY "周身气血如江河奔涌，气血上限更上一层楼！\n" NOR);

	me->add("wucang/max_qi", 50 * amount);
	me->add("wucang/number", amount);

	add_amount(-amount);
	return 1;
}

