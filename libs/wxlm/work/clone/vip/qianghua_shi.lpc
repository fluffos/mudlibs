// qianghua_shi.c
inherit COMBINED_ITEM;

string query_autoload() { return query_amount() + ""; }

void autoload(string param)
{
    int amt;

    if (sscanf(param, "%d", amt) == 1)
        set_amount(amt);
}

void setup()
{
    set_amount(1);
    ::setup();
}

void create()
{
    set_name(HIW "强化石" NOR, ({ "qianghua shi" }));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "用来强化装备的石头。\n");
        set("base_unit", "块");
        set("base_value", 100);
        set("yuanbao", 10);
        set("base_weight", 1);
    }
    setup();
}