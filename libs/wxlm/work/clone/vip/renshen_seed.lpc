

inherit COMBINED_ITEM;

void create()
{
    set_name(HIY"人参果树"NOR"种子", ({"renshen seed", "ginseng seed", "seed"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "这是一颗人参果树种子，可以用来种植人参果树。\n");
        set("base_unit", "颗");
        set("base_value", 150);
        set("yuanbao",10);
        set("base_weight", 1);
        set("crop_type", "人参果树");
        set("no_split", 1);
    }
    set_amount(1);
    setup();
}