// build_ling.c


inherit COMBINED_ITEM;
void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
	set_name(HIC"帮会扩建令"NOR, ({"kuojian ling"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "这是一个可以扩建帮会的令牌。\n");
		set("base_unit", "个");
		set("base_value", 5000000);
		set("yuanbao",251);
		set("no_sell",1);
		set("base_weight", 1);
	}
	set_amount(1);
	setup();
}
