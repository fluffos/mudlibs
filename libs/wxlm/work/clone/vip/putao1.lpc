

inherit COMBINED_ITEM;

string query_autoload() { return query_amount() + ""; }

void autoload(string param)
{
	int amt;
	if (sscanf(param, "%d", amt) == 1)
		set_amount(amt);
}

void setup()
{
	set_amount(1);
	::setup();
}
void create()
{
	set_name(HIM"神奇葡萄"NOR, ({"super putao"}));
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("base_value", 10000);
		set("yuanbao", 10);
        set("no_bind_shop", 1);//绑定商城不能购买
        set("no_sell",1);
		set("base_unit", "串");
		set("base_unit", "串");
		set("base_weight", 10);
		set("base_value", 10000);
		set("long","这是一串由吐蕃传入中原的"HIM"神奇葡萄"NOR"，吃下它会发生奇怪的事情！(潜能+40000)\n");
		set("only_do_effect", 1);
	}
	setup();
}



int do_effect(object me)
{
    int vip_level, base_potential, extra_potential;

    if (me->is_busy())
        return notify_fail("你正忙着呢。\n");

    if (me->is_fighting())
        return notify_fail("正在战斗中，不能使用"+ name() +"。\n");

    vip_level = "/cmds/usr/new_fanli"->get_vip_level(me);
    base_potential = 40000;
    extra_potential = 0;

    if (vip_level > 0)
    {
        mapping vip_privileges = "/cmds/usr/new_fanli"->get_vip_privileges();
        if (vip_level <= sizeof(vip_privileges))
        {
            extra_potential = vip_privileges[vip_level]["weapon_power"];
        }
    }

    me->add("potential", base_potential + extra_potential);

    write(YEL"你吃下一串"HIM"神奇葡萄"YEL"发现自己的潜能大增!"NOR"\n");
    
    if (extra_potential > 0)
    {
        write(HIY"因为你是VIP" + vip_level + "级，额外增加了" + extra_potential + "点潜能！"NOR"\n");
    }

    if (random(50) == 1) {
        me->add("per", 1);
        message_vision(HIW"只见$N身上发出一道耀眼的白光，似乎发生了什么神奇的事情。"NOR"\n", me);
        write(HIM"恭喜：你的先天容貌提升了!"NOR"\n");
    }

    add_amount(-1);
    return 1;
}