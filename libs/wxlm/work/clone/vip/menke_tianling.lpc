

inherit COMBINED_ITEM;

string query_autoload() { return query_amount() + ""; }

void autoload(string param)
{
	int amt;

	if (sscanf(param, "%d", amt) == 1)
		set_amount(amt);
}

void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
	set_name(HIC"门客天灵丹"NOR, ({"tianling dan"}));
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("base_value", 10000);
		// set("no_shop", 1);
		set("yuanbao", 30);
        set("no_sell",1);
		set("base_unit", "颗");
		set("base_unit", "颗");
		set("base_weight", 10);
		set("base_value", 10000);
		set("long","这是一颗门客天灵丹，可以增加一小时的双倍时间(对师门任务、闭关室和练功房有效)。\n");
		set("only_do_effect", 1);
		set("no_shop",1);
	}
	setup();
}

int do_effect(object me)
{
	object menke;

	if (!objectp(menke = me->query("menke_system/summon")))
	{
		write("你没有召唤门客，无法使用天灵丹。\n");
		return 1;
	}

	menke->apply_condition("db_exp", 360+me->query_condition("db_exp"));

	write(YEL"你给你的门客送去了一颗"HIC"天灵丹"YEL"，他服下后顿觉神清气爽、思维敏捷!"NOR"\n");
	add_amount(-1);
	return 1;
}

