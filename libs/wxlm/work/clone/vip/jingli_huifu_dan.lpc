// jingli_huifu_dan.c 精力恢复丹

inherit COMBINED_ITEM;

void setup()
{
    set_amount(1);
    ::setup();
}

void create()
{
    set_name(HIC "精力恢复丹" NOR, ({ "jingli huifu dan", "dan" }));
    set_weight(50);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "一颗散发着淡淡清香的丹药，据说"ZJURL("cmds:eat jingli huifu dan")ZJSIZE(20)"服用"NOR"后可以瞬间恢复全部精力。\n");
        set("spectxt", "使用后立即恢复全部精力，并有一分钟的冷却时间。\n");
        set("base_value", 100000);
        // set("yuanbao", 10);
        // set("no_shop", 1);
        set("no_sell", 1);
        set("no_give", 1);
        set("no_drop", 1);
        set("no_get", 1);
        set("base_unit", "颗");
        set("only_do_effect", 1);
        set("cooldown", 60); // 冷却时间为60秒
        set("last_used", 0); // 上次使用时间
    }
    setup();
}

int do_effect(object me)
{
    int current_time = time();

    if (current_time - query("last_used") < query("cooldown"))
        return notify_fail("丹药正在冷却中，请稍后再使用。\n");

    message_vision("$N小心翼翼地取出一颗" + this_object()->name() + "，轻轻一仰脖，吞了下去。\n", me);
    me->set("jingli", me->query("max_jingli"));
    message_vision("$N只觉得一股暖流从丹田升起，瞬间充满了全身，精力充沛，仿佛可以一口气跑遍整个江湖！\n", me);

    // 更新上次使用时间
    set("last_used", current_time);

    // 销毁药品对象
    add_amount(-1);
    return 1;
}