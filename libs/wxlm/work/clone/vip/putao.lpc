

inherit COMBINED_ITEM;

string query_autoload() { return query_amount() + ""; }

void autoload(string param)
{
	int amt;

	if (sscanf(param, "%d", amt) == 1)
		set_amount(amt);
}

void setup()
{
	set_amount(1);
	::setup();
}
void create()
{
	set_name(HIG"葡萄"NOR, ({"putao"}));
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("base_value", 100);
		set("yuanbao", 10);
            set("no_sell",1);
		set("base_unit", "串");
		set("base_unit", "串");
		set("base_weight", 10);
		set("base_value", 100);
		set("long","这是一串由吐蕃传入中原的"HIG"葡萄"NOR"，吃下它会发生奇怪的事情！(潜能+2000)\n");
		set("only_do_effect", 1);
		//不售卖
		set("no_shop", 1);
	}
	setup();
}

/**
 * @brief 批量使用葡萄的效果函数
 * @param object me 使用物品的玩家对象
 * @param int amount 使用的数量
 * @return int 返回1表示使用成功，0表示使用失败
 * @details 处理批量葡萄的使用逻辑，包括VIP加成和随机容貌提升
 */
int do_effect_more(object me, int amount)
{
	int vip_level, pot, total_pot, per_bonus, i;
	
	if (me->is_busy())
		return notify_fail("你正忙着呢。\n");

	if (me->is_fighting())
		return notify_fail("正在战斗中，不能使用"+ name() +"。\n");

	// 显示使用动作
	message_vision("$N吃下了" + amount + "串葡萄。\n", me);

	// 计算基础潜能
	pot = 2000;
	vip_level = "/cmds/usr/new_fanli"->get_vip_level(me);
	if (vip_level > 0)
	{
		mapping vip_privileges = "/cmds/usr/new_fanli"->get_vip_privileges();
		if (vip_level <= sizeof(vip_privileges))
		{
			pot = pot + vip_privileges[vip_level]["weapon_power"] / 20;
		}
	}

	// 计算总潜能
	total_pot = pot * amount;
	me->add("potential", total_pot);

	// 成功提示
	tell_object(me, YEL"你吃下了" + amount + "串"HIG"葡萄"YEL"发现自己的潜能大增!"NOR"\n");
	tell_object(me, "你总共获得了" + total_pot + "点潜能！\n");
	
	if (vip_level > 0)
	{
		mapping vip_privileges = "/cmds/usr/new_fanli"->get_vip_privileges();
		if (vip_level <= sizeof(vip_privileges))
		{
			tell_object(me, HIY"因为你是VIP" + vip_level + "级，每串额外增加了" + (vip_privileges[vip_level]["weapon_power"] / 20) + "点潜能！"NOR"\n");
		}
	}

	// 随机容貌提升检查
	per_bonus = 0;
	for (i = 0; i < amount; i++)
	{
		if (random(1000) == 1)
		{
			per_bonus++;
		}
	}
	
	if (per_bonus > 0)
	{
		me->add("per", per_bonus);
		message_vision(HIW"只见$N身上发出一道耀眼的白光，似乎发生了什么神奇的事情。"NOR"\n", me);
		tell_object(me, HIM"恭喜：你的先天容貌提升了" + per_bonus + "点!"NOR"\n");
	}

	add_amount(-amount);
	return 1;
}

/**
 * @brief 单次使用葡萄的效果函数
 * @param object me 使用物品的玩家对象
 * @return int 返回1表示使用成功，0表示使用失败
 * @details 处理单个葡萄的使用逻辑
 */
int do_effect(object me)
{
	int vip_level;
	int pot = 2000;

      if (me->is_busy())
                return notify_fail("你正忙着呢。\n");

	if (me->is_fighting())
		    return notify_fail("正在战斗中，不能使用"+ name() +"。\n");

	vip_level = "/cmds/usr/new_fanli"->get_vip_level(me);
	if (vip_level > 0)
	{
        mapping vip_privileges = "/cmds/usr/new_fanli"->get_vip_privileges();
        if (vip_level <= sizeof(vip_privileges))
        {
            pot = pot + vip_privileges[vip_level]["weapon_power"] / 20;
			write(HIY"因为你是VIP" + vip_level + "级，额外增加了" + (vip_privileges[vip_level]["weapon_power"] / 20) + "点潜能！"NOR"\n");
        }
	}

	me->add("potential",pot);

	write(YEL"你吃下一串"HIG"葡萄"YEL"发现自己的潜能大增!"NOR"\n");

        if (random(1000)==1) {
            me->add("per",1);
            message_vision(HIW"只见$N身上发出一道耀眼的白光，似乎发生了什么神奇的事情。"NOR"\n", me);
            write(HIM"恭喜：你的先天容貌提升了!"NOR"\n");
            }
	add_amount(-1);
	return 1;
}