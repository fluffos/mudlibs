inherit COMBINED_ITEM;

void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
	set_name(HIC "雾雨灵茶" NOR, ({ "wuyu lingcha" }) );
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一杯散发着淡淡清香的灵茶，杯中茶水呈现翠绿色，表面漂浮着几片\n"
			    "晶莹剔透的茶叶，隐约可见氤氲水汽中有云雾缭绕。此茶采自云雾\n"
			    "缭绕的仙山之巅，饮用后可增长内力上限修为30。(注：服用有上限，人物等级每提升1级可以饮用一杯)\n");
		set("base_unit", "杯");
		set("base_weight", 10);
		set("base_value", 50000);
		set("no_bind_shop", 1);//绑定商城不能购买
		set("yuanbao", 300);
		set("no_sell", 1);
		set("only_do_effect", 1);
        set("day_limit_number", 10);
	}
	setup();
}

// 单次使用函数
int do_effect(object me)
{

	log_file("nosave/using", sprintf("%s(%s) drink 雾雨灵茶 at %s.\n",
		 me->name(1), me->query("id"), ctime(time())));
	message_vision("$N端起一" + query("unit") + name() + "，轻轻品尝起来。\n", me);

	tell_object(me, HIC "你只觉一股清凉之意自喉咙滑下，瞬间流向丹田气海。\n" 
		HIG "体内真气渐渐凝聚，越发纯净通透。\n" 
		HIB "一股内力源源不断在体内生成，内力上限提升了！\n" NOR);

	//只能喝到等级上限
	if (me->query("wuyu/number") >= me->query("level"))
	{
		tell_object(me, HIY "你已经饮用了太多雾雨灵茶，再饮用已经没有效果了。\n" NOR);
		return 1;
	}
	

	me->add("wuyu/max_neili", 30);
	me->add("wuyu/number", 1);

	add_amount(-1);
      return 1;
}

// 批量使用函数
int do_effect_more(object me, int amount)
{
	int can_use;

	if (amount <= 0) return 0;
	if (query_amount() < amount) {
		write("你没有足够的" + name() + "。\n");
		return 0;
	}

	log_file("nosave/using", sprintf("%s(%s) drink %d 雾雨灵茶 at %s.\n",
		 me->name(1), me->query("id"), amount, ctime(time())));

	//只能喝到等级上限
	if (me->query("wuyu/number") >= me->query("level"))
	{
		tell_object(me, HIY "你已经饮用了太多雾雨灵茶，再饮用已经没有效果了。\n" NOR);
		return 1;
	}

	// 计算可以使用的数量（基于等级限制）
	can_use = me->query("level") - me->query("wuyu/number");
	if (can_use <= 0)
	{
		tell_object(me, HIY "你已经饮用了太多雾雨灵茶，再饮用已经没有效果了。\n" NOR);
		return 1;
	}

	// 限制实际使用数量
	if (amount > can_use) {
		write(sprintf("以你目前的等级，最多只能再饮用%d杯雾雨灵茶。\n", can_use));
		amount = can_use;
	}

	message_vision(sprintf("$N端起%d%s%s，一口气饮用完毕。\n", amount, query("unit"), name()), me);

	tell_object(me, HIC "你只觉一股清凉之意自喉咙滑下，瞬间流向丹田气海。\n" 
		HIG "体内真气渐渐凝聚，越发纯净通透。\n" 
		HIB "一股内力源源不断在体内生成，内力上限提升了！\n" NOR);

	me->add("wuyu/max_neili", 30 * amount);
	me->add("wuyu/number", amount);

	add_amount(-amount);
	return 1;
}

