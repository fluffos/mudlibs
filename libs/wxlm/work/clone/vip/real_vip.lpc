inherit COMBINED_ITEM;

void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
	set_name(HIR"黎明月卡"NOR, ({"liming_month card"}));
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("yuanbao", 300);
		set("long","这是一张黎明月卡，使用之后增加30天黎明会员时间!\n");
        set("no_sell",1);
		set("base_unit", "张");
		set("base_value", 50000);
		set("base_weight", 1);
        set("only_do_effect", 1); // 标识该物品可以使用
        set("no_bind_shop", 1);//绑定商城不能购买
	}
	setup();
}

int do_effect(object me) {
    int vip_time;
    vip_time = 30 * 24 * 3600;
    if (!me) return 0;
    write(YEL"你的会员时间增加30天！"NOR"\n");

	if (me->query("real_vip/times") > time())
	{
		me->add("real_vip/times", vip_time);
	}
	else
	{
		me->set("real_vip/times", time() + vip_time);
	}
	
    me->save();
    add_amount(-1);
    return 1;
}
