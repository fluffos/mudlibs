// jinsha.c


inherit COMBINED_ITEM;
string query_autoload() { return query_amount() + ""; }

void autoload(string param)
{
	int amt;

	if (sscanf(param, "%d", amt) == 1)
		set_amount(amt);
}

void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
	set_name(HIW "词符" NOR, ({ "chifu" }));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "用于解锁和更换元素词条的道具。\n");
		set("base_unit", "张");
		set("base_value", 500);
		set("yuanbao", 10);
		set("base_weight", 1);
		//每日限购50
		set("day_limit_number", 50);
	}
	setup();
}

