inherit ITEM;

void create()
{
        set_name("出师礼盒", ({"master box"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "这是一个由檀木制成的出师礼盒，蕴含着一位师傅对徒弟殷切的关怀，"
                          ZJURL("cmds:open master box") + ZJSIZE(20) + HIY "打开" NOR "它能够获得很多珍贵的礼物。\n");
                set("unit", "个");
                set_weight(100);
                set("value", 10000);
                set("no_give", 1);
                set("no_drop", 1);
                set("no_get", 1);
                set("no_sell", 1);
                setup();
        }
}

void init()
{
        add_action("do_open", "open");
}

int do_open(string arg)
{
        object me = this_player();
        object ob;
        int i;
        string *dan_list = ({
                "/clone/vip/dan_dex",   // 火红仙丹
                "/clone/vip/dan_str",   // 神力丸
                "/clone/vip/dan_int",     // 醍醐仙丹
                "/clone/vip/dan_con",     // 洗髓丹
        });
        string *dan_name = ({
                HIR "火红仙丹" NOR,
                HIG "神力丸" NOR,
                HIY "醍醐仙丹" NOR,
                YEL "洗髓丹" NOR
        });

        if (!arg)
                return notify_fail("你要开什么？\n");

        if (arg != "master box")
                return notify_fail("你要开什么礼盒？\n");

        message_vision(HIY "$N打开了一个$n，\n" HIW
                      "$N获得了一串" HIG "葡萄" HIW "，\n"
                      "$N获得了一串" HIG "葡萄" HIW "，\n"
                      "$N获得了一串" HIG "葡萄" HIW "，\n"
                      "$N增加了72小时的会员时间" HIW "，\n"
                      "$N获得了一百两" HIY "黄金" HIW "，" NOR "\n",
                      me, this_object());

        // 发放葡萄
        for (i = 0; i < 3; i++) {
                ob = new("/clone/gift/putao");
                ob->move(me);
        }

        // 发放黄金
        ob = new_bind("/clone/money/gold");
        ob->set_amount(100);
        ob->move(me);

        // 增加会员时间
        me->add("zjvip/times", 259200);

        // 随机发放丹药
        i = random(100);
        i /= 25;

        ob = new(dan_list[i]);
        ob->move(me);
        message_vision(HIW "$N获得了一颗" + dan_name[i] + HIW "。" NOR "\n",
                      me, this_object());

        destruct(this_object());
        return 1;
}

int query_autoload() { return 1; }