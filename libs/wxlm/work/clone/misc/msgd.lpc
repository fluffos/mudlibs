 
 
inherit ITEM; 
inherit F_SAVE; 
 
#define MSGFILE "/data/msg/msgd.o" 
 
int do_addmsg(string arg); 
int do_listmsg(string arg); 
int do_delmsg(string arg); 
 
string *msg = ({ 
       "江湖中有一群德高望重的前辈带'导'字为号，虽无特权在身，却愿倾囊相授，指点后辈。", 
       "每日午时十二点至未时一点，古墓中会有江湖异士现身，带来各路奇珍异宝，有缘者可前去寻觅机缘。",
       "每日戌时二十点至二十一点，扬州武道场将举办武林大会，各路豪杰齐聚一堂，切磋武艺，以求精进。",
       "各位少侠，女侠，可移步江湖茶馆(qq群:2164039263),在设置页面点击江湖茶馆也可以快速进入茶馆哦，茶主为各位精心提供了茶点。（加群获取礼包码）。",
}); 
 
nosave int cnd; 
 
void create() 
{ 
        seteuid(getuid()); 
        set_weight(900000000); 
        set_name("新闻广播",({"msgd","msg"})); 
        set("channel_id","新闻使者"); 
        set("unit", "个"); 
        set("no_get", 1); 
        set("no_drop", 1); 
        set("no_give", 1); 
 
        setup(); 
        if (clonep()) 
                return; 
        CHANNEL_D->do_channel( this_object(), "sys", "新闻系统已经启动。\n");    
        call_out("on_time",10); 
} 
 
void init() 
{ 
        add_action("do_addmsg","addmsg"); 
        add_action("do_listmsg","listmsg"); 
        add_action("do_delmsg","delmsg"); 
} 
 
int valid_string(string arg) 
{ 
        return 1; 
} 
 
int valid_use() 
{ 
        object me=this_player(1); 
         
        if (wiz_level(me)<wiz_level("(arch)")) 
                return 0; 
        return 1; 
} 
string query_save_file() 
{ 
        return MSGFILE; 
} 
 
void on_time() 
{ 
        int i; 
         
        i=sizeof(msg); 
        if (i<=0){ 
                //CHANNEL_D->do_channel(this_object(),"chat", 
                //      "没有新闻\n"); 
                call_out("on_time",300); 
                return; 
                } 
         
        CHANNEL_D->do_channel(this_object(),"chat",msg[cnd]); 
        cnd++; 
        if((cnd+1)>=sizeof(msg)) cnd = 0; 
 
        call_out("on_time",300); 
} 
 
int do_addmsg(string arg) 
{ 
        object me=this_player(1);
        if (!wizardp(me))
                return 0;
        if (!arg||!valid_string(arg)) 
                return notify_fail("非法的信息\n"); 
        msg += ({arg}); 
        save(); 
        tell_object(me,"新闻增加完毕\n");                
        return 1; 
} 
 
int do_listmsg(string arg) 
{ 
        int i; 
        object me=this_player();
        
        if (!wizardp(me))
                return 0;
        for (i=0;i<sizeof(msg);i++) 
                printf("%4d    :    %s\n",i+1,msg[i]); 
        return 1;     
} 
      
int do_delmsg(string arg) 
{ 
        object me=this_player(1); 
        int i; 
        if (!wizardp(me))
                return 0;
        if (!arg || sscanf(arg, "%d", i)!=1) 
                return notify_fail("你要删除哪一条信息？\n"); 
        msg -= ({msg[i-1]}); 
        save(); 
        tell_object(me,"新闻删除完毕\n"); 
        return 1; 
} 
      
