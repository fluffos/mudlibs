// diaogan.c 钓竿
// 钓鱼系统物品，用于玩家在游戏中进行钓鱼活动

inherit ITEM;

/**
 * @brief 初始化钓竿对象
 * @details 当玩家获得钓竿时，添加钓鱼和拉杆的命令
 */
void init()
{
	if (interactive(this_player()) &&
	    environment() == this_player())
	{
		add_action("do_fish", "fish");
		add_action("do_draw", "draw");
	}
}

/**
 * @brief 创建钓竿对象
 * @details 设置钓竿的基本属性，如名称、描述和价值
 */
void create()
{
	set_name(HIG "钓竿" NOR, ({ "diao gan", "gan" }));
	if (clonep())
		set_default_object(__FILE__);
	else
	{
		set("unit", "根");
		set("long", "这是一根钓鱼者常用的钓竿$br#常用它来"ZJURL("cmds:fish")+ZJSIZE(15)"钓鱼"NOR"(fish)。\n");
		set("value", 2000);
	}

	setup();
}

/**
 * @brief 执行钓鱼动作
 * @return int 成功返回1，失败返回0
 * @details 检查环境是否可钓鱼，玩家是否有鱼饵，然后开始钓鱼过程
 */
int do_fish()
{
	object yr;
	object me = this_player();

	// 检查当前位置是否有鱼
	if (! arrayp(environment(me)->query("resource/fish")))
		return notify_fail("这里看不出有鱼的样子。\n");

	// 检查玩家是否有鱼饵
	if (! objectp(yr = present("yu er", me)) || yr->query_amount() < 1)
		return notify_fail("你身上没有鱼饵了。\n");

	// 检查玩家当前状态
	if (me->is_busy() || me->is_fighting())
		return notify_fail("你还是忙完手头上的事情再说吧。\n");

	// 开始钓鱼
	message_vision("$N掏出一点鱼饵，仔细的放在钓钩上，轻轻一甩杆，见到水面上荡起了一个个圆圈，中间只有一个白色的浮子在随着水波荡漾。\n", me);
	yr->add_amount(-1); // 消耗一个鱼饵
	
	// 设置玩家为忙碌状态，并注册回调函数
	me->start_busy((: call_other, __FILE__, "finishing" :),
		       (: call_other, __FILE__, "halt_finishing" :));
	
	// 设置相关临时变量
	set_temp("owner", me);
	me->set_temp("fishing", 0); // 初始钓鱼阶段为0
	me->set_temp("pending/auto_diao", 1); // 启用自动钓鱼
	me->set_temp("fishing_env", environment(me)); // 记录钓鱼环境
	
	return 1;
}

/**
 * @brief 钓鱼过程的持续处理函数
 * @param object me 钓鱼的玩家对象
 * @return int 继续钓鱼返回1，结束钓鱼返回0
 * @details 根据钓鱼阶段(stage)显示不同的钓鱼状态，并决定是否自动拉杆
 */
int finishing(object me)
{
	int stage;

	// 检查玩家是否还在原钓鱼地点
	if (environment(me) != me->query_temp("fishing_env"))
	{
		me->delete_temp("fishing");
		me->delete_temp("fishing_env");
		return 0;
	}

	// 获取当前钓鱼阶段
	switch (stage = me->query_temp("fishing"))
	{
	case 1: // 阶段1：鱼儿开始咬钩
		if (random(4))
		{
			message_vision("$N的浮子轻轻的震动，一上一下的摇晃个不停。\n", me);
			break;
		}

		message_vision("$N的浮子忽然剧烈的震荡起来。\n", me);
		stage++; // 进入阶段2
		break;

	case 2: // 阶段2：鱼儿正在咬钩
	case 3: // 阶段3：鱼儿即将脱钩
		message_vision(random(2) ? "$N的浮子忽左忽右摇摆个不停。\n"
					 : "$N的浮子猛然向下一窜，然后又跳出水面。\n",
			       me);
		stage++; // 进入下一阶段
		break;

	case 4: // 阶段4：鱼儿已脱钩
		message_vision(random(2) ? "一阵剧烈的摇摆过后，浮子安静下来，$N连忙拉起钓竿，一看钩上空空如也。\n"
					 : "浮子猛然的左右摆动，忽然又安静了下了，$N疑惑的拉起钓竿，除了闪亮的鱼钩，上面什么也没有。\n",
			       me);
		tell_object(me, CYN "看来是拉杆拉晚了，白白的赔了一个鱼饵！"NOR"\n");
		
		// 重置钓鱼状态
		me->delete_temp("fishing");
		delete_temp("owner");
		
		// 自动开始新一轮钓鱼
		me->force_me("fish");
		return 0;

	default: // 初始阶段或等待阶段
		if (random(5))
		{
			if (random(3)) return 1; // 继续等待
			
			// 显示等待信息
			tell_object(me, random(2) ? "水面波澜不惊，没有什么变化。\n"
						  : "微风轻轻的吹，水面荡起一层层细浪，就是没有鱼上钩。\n");
			break;
		}
		
		// 鱼儿开始接近
		message_vision("忽然$N的浮子震动了一下。\n", me);
		stage = 1; // 进入阶段1
		break;
	}

	// 更新钓鱼阶段
	me->set_temp("fishing", stage);
	
	// 自动拉杆判断：当阶段为2且随机成功时
	if(me->query_temp("pending/auto_diao") && stage == 2)
	{
		me->force_me("draw diao gan");
	}
	
	return 1;
}

/**
 * @brief 中断钓鱼过程
 * @param object me 钓鱼的玩家对象
 * @return int 始终返回1
 * @details 当玩家主动中断钓鱼或被其他事件打断时调用
 */
int halt_finishing(object me)
{
	delete_temp("owner");
	me->delete_temp("fishing");
	message_vision("$N收起钓竿，看样子是不想再钓了。\n", me);
	return 1;
}

/**
 * @brief 自动钓鱼函数
 * @param object me 钓鱼的玩家对象
 * @details 当玩家完成一次钓鱼后，自动开始下一次钓鱼
 */
void auto_fish(object me)
{
	// 检查玩家是否在线
	if(!interactive(me)) return;
	
	// 如果玩家忙碌中，延迟1秒后再次尝试
	if(me->is_busy())
		call_out("auto_fish", 1, me);
	else
		me->force_me("fish"); // 自动开始钓鱼
}

/**
 * @brief 执行拉杆动作
 * @param string arg 命令参数
 * @return int 成功返回1，失败返回0
 * @details 玩家拉杆尝试钓鱼，根据当前钓鱼阶段决定是否能钓到鱼
 */
int do_draw(string arg)
{
	string *fish;
	string *zhenxi_fish = ({
		"/clone/food/zhenxi/longlin_jinyu",
		"/clone/food/zhenxi/fengwei_yinyu",
		"/clone/food/zhenxi/linghui_caiyu",
		"/clone/food/zhenxi/hundun_shenyu",
		"/clone/food/zhenxi/shiguang_jinli",
	});
	object ob;
	object me;
	int stage;
	int exp;
	int pot;
	int chance;
	int no_sell = 0;

	// 检查参数是否正确
	if (! arg || ! id(arg))
		return notify_fail("你要拉什么？\n");

	me = this_player();

	// 检查是否是当前钓鱼者
	if (query_temp("owner") != me)
		return notify_fail("你又没在钓鱼，拉杆干什么？\n");

	// 检查是否在原钓鱼地点
	if (environment(me) != me->query_temp("fishing_env"))
		return 0;

	// 获取当前钓鱼阶段
	stage = me->query_temp("fishing");
	
	// 如果阶段小于2，表示鱼还没上钩
	if (stage < 2)
	{
		message_vision("$N连忙一拉钓竿，高高的举了起来，却见上面鱼饵依然，还是老样子，只好垂头丧气的重新把杆甩了出去。\n", me);
		me->set_temp("fishing", 0); // 重置钓鱼阶段
		return 1;
	}

	// 计算钓到珍稀鱼类的概率
	chance = 30 + (me->query_skill("diaoyu-jiqiao", 1) / 100) * 5; // 基础3%，每100级钓鱼技巧提升0.5%
	if (chance > 60) chance = 60; // 最高6%

	if (wizardp(me))
	{
		chance = 900;
	}

	if (random(1000) < chance)
	{
		// 钓到珍稀鱼类
		ob = new_bind(zhenxi_fish[random(sizeof(zhenxi_fish))]);
		message_vision(HIR "$N猛地一收钓竿，感觉到一股巨大的力量传来，经过一番搏斗，终于钓上来一" + ob->query("unit") + ob->name() + HIR "！\n" NOR, me);
		tell_object(me, HIG "恭喜你！你钓到了一条珍稀的" + ob->name() + HIG "！"NOR"\n");
		no_sell = 1;
	}
	else
	{
		// 钓到普通鱼类
		fish = environment(me)->query("resource/fish");
		if (sizeof(fish) < 1)
			log_file("log", sprintf("variable: resource/fish error in %s.\n",
					base_name(environment(me))));
		
		ob = new(fish[random(sizeof(fish))]);

		message_vision(random(2) ? "$N手急眼快，猛地一收钓竿，只见上面挂着一" +
				   ob->query("unit") + "扭来扭去的" +
				   ob->name() + "。\n"
				 : "$N顺势一拉杆，登时把一" + ob->query("unit") +
				   ob->name() + "钓了上来。\n", me);
		tell_object(me, HIG "你钓到了一" + ob->query("unit") +
				ob->name() + HIG + "。"NOR"\n");
	}
	
	// 将鱼放入玩家物品栏
	ob->move(me, 1);

	if (!no_sell && me->query("env/auto_sell_fish"))
	{
		me->force_me("sellob " + ob->query("id"));
	}

	// 重置钓鱼状态
	delete_temp("owner");
	me->delete_temp("fishing");
	me->delete_temp("fishing_env");

	// 计算经验和潜能奖励（仅适用于特定经验范围的玩家）
	exp = 50 + random(10 + (me->query_skill("diaoyu-jiqiao", 1) / 10));
	pot = exp / 4;
	
	// 增加玩家经验和潜能
	me->add("combat_exp", exp);
	if (me->query("potential") < me->query_potential_limit())
		me->add("potential", pot);

	me->improve_skill("diaoyu-jiqiao", 100 + random(10 + me->query_skill("diaoyu-jiqiao")));
	// 提示获得的经验潜能奖励
	tell_object(me, HIC "你获得了"NOR + exp + HIC "点经验，"NOR + pot + HIC "点潜能。"NOR"\n");
	
	// 提示武学理解加深
    tell_object(me, HIC "你心中微微一动，对武学的理解又深了一层。"NOR"\n");
    
    // 自动开始下一轮钓鱼
    if (me->query("env/auto_fish"))
        call_out("auto_fish", 1, me);
    return 1;
}

/**
 * @brief 钓竿移动处理函数
 * @param mixed dest 目标位置
 * @param int raw 是否为原始移动
 * @return int 移动结果
 * @details 当钓竿被移动时，中断当前钓鱼者的钓鱼状态
 */
int move(mixed dest, int raw)
{
	object me;

	// 如果有人正在使用此钓竿钓鱼，中断其动作
	if (me = query_temp("owner"))
		me->interrupt_me();

	return ::move(dest, raw);
}