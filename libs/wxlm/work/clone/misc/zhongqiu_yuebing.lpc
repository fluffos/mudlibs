/**
 * @brief 中秋月饼
 * @details 中秋节活动专属月饼，使用后增加潜能、经验和绑定元宝
 * @author LPC开发者
 * @date 2025
 */

inherit COMBINED_ITEM;

// 函数原型声明
string query_autoload();
void autoload(string param);
void setup();
void create();
int do_effect(object me);

/**
 * @brief 查询自动加载参数
 * @return string 自动加载参数
 */
string query_autoload()
{
    return query_amount() + "";
}

/**
 * @brief 自动加载函数
 * @param string param 参数字符串
 */
void autoload(string param)
{
    int amt;

    if (sscanf(param, "%d", amt) == 1)
        set_amount(amt);
}

/**
 * @brief 设置初始数量
 */
void setup()
{
    set_amount(1);
    ::setup();
}

/**
 * @brief 创建中秋月饼物品
 */
void create()
{
    set_name(HIY"中秋月饼"NOR, ({"zhongqiu yuebing", "yuebing"}));

    if (clonep())
        set_default_object(__FILE__);
    else {
        set("base_value", 5000);
        set("no_bind_shop", 1); // 绑定商城不能购买
        set("no_sell", 1);
        set("base_unit", "块");
        set("base_weight", 10);
        set("long", "这是一块"HIY"中秋月饼"NOR"，散发着诱人的香气。食用后可增加潜能、经验和绑定元宝。\n"
            HIY"效果：潜能+20000，经验+20000，绑定元宝+20"NOR"\n");
        set("only_do_effect", 1);
    }
    setup();
}

/**
 * @brief 月饼使用效果
 * @param object me 使用月饼的玩家
 * @return int 成功返回1，失败返回0
 */
int do_effect(object me)
{
    if (me->is_busy())
        return notify_fail("你正忙着呢。\n");

    if (me->is_fighting())
        return notify_fail("正在战斗中，不能使用" + name() + "。\n");

    // 增加潜能和经验
    me->add("potential", 20000);
    me->add("combat_exp", 20000);
    me->add("bind_yuanbao", 20);

    write(HIY"你吃下一块"HIY"中秋月饼"NOR HIY"，感觉自己的潜能和修为大增！"NOR"\n");
    write(HIY"你获得了：潜能+20000，经验+20000，绑定元宝+20"NOR"\n");

    message_vision(HIY"$N吃下一块中秋月饼，脸上露出满足的笑容。"NOR"\n", me);

    add_amount(-1);
    return 1;
}
