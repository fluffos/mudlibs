
inherit NPC;
object *get_top_players(int n);
int calculate_average_skill(object *players);
object *players;
int avg_skill;



void create()
{
    set_name("赤冥大盗", ({ "chiming dadao", "chiming", "dadao" }));
    set("long", "这是一个神出鬼没的赤冥大盗,实力强大,令人闻风丧胆。\n");
    set("gender", "男性");
    set("age", 30 + random(20));
    set("attitude", "aggressive");
    set("shen_type", -1);
    
    // 获取排行榜前20玩家的平均技能
    players = get_top_players(100);
    avg_skill = calculate_average_skill(players);
    
    // 设置赤冥大盗的技能
    set_skill("force", avg_skill);
    set_skill("dodge", avg_skill);
    set_skill("parry", avg_skill);
    set_skill("sword", avg_skill);
    set_skill("strike", avg_skill);
    set_skill("gandanqinxin", avg_skill);
    set_skill("qin", avg_skill);
    set_skill("bainiao-chaofeng", avg_skill);
    set_skill("pingsha-luoyan", avg_skill);
    set_skill("gaoshan-liushui", avg_skill);
    set_skill("yiqu-qinyinduan", avg_skill);
    set_skill("yinlv", avg_skill);
    set_skill("lingboweibu", avg_skill);
    map_skill("force", "gandanqinxin");
    map_skill("dodge", "lingboweibu");
    map_skill("parry", "lingboweibu");
    map_skill("qin", "yiqu-qinyinduan");

    set("chat_chance_combat", 100);
	set("chat_msg_combat", ({
		(: perform_action, "qin.chaofeng" :),
        (: perform_action, "qin.pingsha" :),
        (: perform_action, "qin.qingxin" :),
		(: exert_function, "recover" :),
	}) );

    set("max_qi", avg_skill * 500);
    set("eff_qi", query("max_qi"));
    set("qi", query("max_qi"));
    set("max_jing", avg_skill * 500);
    set("eff_jing", query("max_jing"));
    set("jing", query("max_jing"));
    set("max_neili", avg_skill * 30);
    set("neili", query("max_neili"));
    set("jiali", avg_skill / 10);
    set("combat_exp", avg_skill * 1000);

    setup();
    
    carry_object("/d/baidicheng/obj/qin1")->wield();
    carry_object("/clone/cloth/cloth")->wear();
}

// 获取排行榜前N名玩家
object *get_top_players(int n)
{
    object *players = filter_array(users(), (: $1->query("combat_exp") > 10000000 :));
    players = sort_array(players, (: $2->query("combat_exp") - $1->query("combat_exp") :));
    return players[0..n-1];
}

// 计算平均技能
int calculate_average_skill(object *players)
{
    int total_skill = 0;
    int count = 0;
    
    foreach (object player in players)
    {
        total_skill += player->query_skill("force");
        count++;
    }
    
    if (count > 0)
        return total_skill / count;
    else
        return 400; // 默认值
}

void init()
{
    object ob = this_player();
    ::init();
    if (interactive(ob) && !is_fighting())
    {
        remove_call_out("kill_ob");
        call_out("kill_ob", 1, ob);
    }
}

void die()
{
    object me = query_last_damage_from();
    int i, amount;
    string jiangli = "/d/fuben/baoshi/obj/mine_heap";
    object gem;

    if (objectp(me) && me->query("id") && me->inc_chiming_dadao_count())
    {
        amount = 1 + random(10);
        for (i = 0; i < amount; i++)
        {
            gem = new(jiangli->get_drop_by_type(3));
            gem->move(me);
        }
        tell_object(me, HIY "你击杀了赤冥大盗,获得了" + chinese_number(amount) + "颗宝石！\n" NOR);
    }
    else if (objectp(me))
    {
        tell_object(me, HIR "你本周已经击杀了6次赤冥大盗,无法获得更多奖励。\n" NOR);
    }

    ::die();
}