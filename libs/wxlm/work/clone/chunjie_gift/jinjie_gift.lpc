/**
 * @file jinjie_gift.c
 * @author Lu dexiang
 * @brief 进阶礼包
 * @version 1.0
 * @date 2024-01-20
 */

inherit COMBINED_ITEM;

string query_autoload() { return query_amount() + ""; }

void autoload(string param)
{
    int amt;
    if (sscanf(param, "%d", amt) == 1)
        set_amount(amt);
}

void setup()
{
    set_amount(1);
    ::setup();
}

void create()
{
    set_name("进阶礼", ({"jinjie gift"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "进阶礼包，包含450元宝和强化石等物品。\n");
        set("base_unit", "个");
        set("base_weight", 1);
        set("base_value", 3000);
        set("no_put", 1);
        set("no_get", 1);
        set("no_give", 1);
        set("no_drop", 1);
        set("no_sell", 1);
        set("no_steal", 1);
        set("no_beg", 1);
        set("only_do_effect", 1);
    }
    setup();
}

int do_effect(object me)
{
    mapping gifts;
    string *list;
    object obj;
    int i;

    gifts = ([
        "/clone/vip/qianghua_shi":45,        // 强化石45颗
        "/clone/vip/gaojibao_hufu.lpc":1,           // 高级保护符1张
    ]);

    list = keys(gifts);

    if (me->is_busy())
        return notify_fail("你正忙着呢。\n");

    if (me->is_fighting())
        return notify_fail("战斗中，不能使用"+ name() +"。\n");

    message_vision("$N打开了一" + query("base_unit") + name() + "。\n", me);
    
    // 增加元宝
    me->add("yuanbao", 450);
    me->add("sxlm_reward/number", -1);
    tell_object(me, "你获得了450元宝。\n");
    tell_object(me, "你获得了1次蛇形副本的奖励机会。\n");

    for(i = 0; i < sizeof(list); i++)
    {
        obj = new_bind(list[i]);
        if(obj->query_amount())
            obj->set_amount(gifts[list[i]]);
        tell_object(me, "你获得了" + obj->short() + "。\n");
        obj->move(me);
    }
    
    add_amount(-1);
    return 1;
}
