/**
 * @file longfeng_gift.c
 * @author Lu dexiang
 * @brief 龙凤呈祥礼包
 * @version 1.0
 * @date 2024-01-20
 */

inherit COMBINED_ITEM;

string query_autoload() { return query_amount() + ""; }

void autoload(string param)
{
    int amt;
    if (sscanf(param, "%d", amt) == 1)
        set_amount(amt);
}

void setup()
{
    set_amount(1);
    ::setup();
}

void create()
{
    set_name("龙凤呈祥礼", ({"longfeng gift"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "龙凤呈祥礼包，限定称号龙凤呈祥等物品。\n");
        set("base_unit", "个");
        set("base_weight", 1);
        set("base_value", 128800);
        set("no_put", 1);
        set("no_get", 1);
        set("no_give", 1);
        set("no_drop", 1);
        set("no_sell", 1);
        set("no_steal", 1);
        set("no_beg", 1);
        set("only_do_effect", 1);
    }
    setup();
}

int do_effect(object me)
{
    mapping gifts;
    string *list;
    object obj;
    int i;

    gifts = ([
        "/clone/vip/qianghua_shi":199,       // 强化石×199
        "/clone/vip/jinsha":199,             // 金砂×199
        "/clone/baiyi/onecard":28,          // 单抽卡片×28
        "/clone/vip/dan_chongmai4":99,       // 极品冲脉丹×13
        "/clone/vip/book_tianfu":66,              //天赋书×66
    ]);

    list = keys(gifts);

    if (me->is_busy())
        return notify_fail("你正忙着呢。\n");

    if (me->is_fighting())
        return notify_fail("战斗中，不能使用"+ name() +"。\n");

    message_vision("$N打开了一" + query("base_unit") + name() + "。\n", me);
    
    for(i = 0; i < sizeof(list); i++)
    {
        obj = new_bind(list[i]);
        if(obj->query_amount())
            obj->set_amount(gifts[list[i]]);
        tell_object(me, "你获得了" + obj->short() + "。\n");
        obj->move(me);
    }

    // 增加灵蛇珠（头像碎片）
    me->add("head_suipian", 99);
    tell_object(me, "你获得了99个灵蛇珠。\n");
    
    // 添加限定称号
    me->add("chunjie_gift/龙凤呈祥", 1);
    tell_object(me, "你获得了龙凤呈祥称号，请到称号界面兑换。\n");
    
    add_amount(-1);
    return 1;
} 