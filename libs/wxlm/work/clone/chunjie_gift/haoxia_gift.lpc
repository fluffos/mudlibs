/**
 * @file haoxia_gift.c
 * @author Lu dexiang
 * @brief 豪侠礼包
 * @version 1.0
 * @date 2024-01-20
 */

inherit COMBINED_ITEM;

string query_autoload() { return query_amount() + ""; }

void autoload(string param)
{
    int amt;
    if (sscanf(param, "%d", amt) == 1)
        set_amount(amt);
}

void setup()
{
    set_amount(1);
    ::setup();
}

void create()
{
    set_name("豪侠礼", ({"haoxia gift"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "豪侠礼包，包含1568元宝和各种神丹等物品。\n");
        set("base_unit", "个");
        set("base_weight", 1);
        set("base_value", 9800);
        set("no_put", 1);
        set("no_get", 1);
        set("no_give", 1);
        set("no_drop", 1);
        set("no_sell", 1);
        set("no_steal", 1);
        set("no_beg", 1);
        set("only_do_effect", 1);
    }
    setup();
}

int do_effect(object me)
{
    mapping gifts;
    string *list;
    object obj;
    int i;

    gifts = ([
        "/clone/vip/build_ling":2,           // 拓建令牌×2
        "/clone/vip/putao_seed":10,          // 葡萄树种子×10
        "/clone/vip/dan_chongmai1":50,         // 下品冲脉丹×50
        "/clone/vip/dan_chongmai2":50,         // 中品冲脉丹×50
        "/clone/vip/dan_chongmai3":50,         // 上品冲脉丹×50
        "/clone/vip/dan_chongmai4":50,         // 极品冲脉丹×50
    ]);

    list = keys(gifts);

    if (me->is_busy())
        return notify_fail("你正忙着呢。\n");

    if (me->is_fighting())
        return notify_fail("战斗中，不能使用"+ name() +"。\n");

    message_vision("$N打开了一" + query("base_unit") + name() + "。\n", me);
    
    // 增加元宝
    me->add("yuanbao", 1568);
    tell_object(me, "你获得了1568元宝。\n");
    
    for(i = 0; i < sizeof(list); i++)
    {
        obj = new_bind(list[i]);
        if(obj->query_amount())
            obj->set_amount(gifts[list[i]]);
        tell_object(me, "你获得了" + obj->short() + "。\n");
        obj->move(me);
    }
    
    //获得9灵蛇珠
    me->add("head_suipian", 9);
    tell_object(me,"你获得了9个灵蛇珠。\n");
    me->add("chunjie_gift/江湖新秀", 1);
    tell_object(me,"你获得了江湖新秀称号，请到称号界面兑换。\n");
    add_amount(-1);
    return 1;
}
