// wuyuntaxue.c 乌云踏雪坐骑

#include <armor.h>

inherit MOUNT;

/**
 * @brief 创建乌云踏雪坐骑
 * @details 设置坐骑的基本属性和特殊效果
 */
void create()
{
    set_name(HIB "乌云踏雪" NOR, ({ "wuyun taxue", "wuyun", "taxue" }));
    set_weight(1); // 坐骑通常较重
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", HIB "这是一匹神骏的乌云踏雪，通体乌黑如墨，四蹄雪白如霜。\n"
            "它昂首挺胸，目光炯炯有神，散发着不凡的灵性。\n"
            "骑乘它可以大幅提升武者的战斗能力。\n" NOR);
        set("unit", "匹");
        set("value", 1500000);
        set("material", "flesh");
        // 乌云踏雪的特殊属性加成
        set("armor_prop", ([
            "force"     : 100,      // 内功激发+100
            "parry"     : 100,      // 招架激发+100
            "dodge"     : 100,      // 轻功激发+100  
            "max_qi"    : 2000,     // 血量+2000
            "max_neili" : 2000,     // 内力+2000
            "max_jing"  : 2000,     // 精神+2000
        ]));
        set("no_sell", "这匹神骏的乌云踏雪太珍贵了，不能卖。");
        set("no_pawn", "这匹神骏的乌云踏雪太珍贵了，不能当。");
    }
    setup();
}

/**
 * @brief 坐骑被装备时的特殊效果
 * @return int 成功返回1，失败返回0
 * @details 骑乘乌云踏雪时显示特殊信息
 */
int wear()
{
    object owner;
    
    owner = environment();
    
    if (!owner || !userp(owner))
        return 0;
    
    if (::wear())
    {
        message_vision(HIB "$N翻身跃上乌云踏雪，顿时感到一股强大的力量涌入体内，\n"
            "招架、轻功、内功修为都得到了显著提升！" NOR "\n", owner);
        tell_object(owner, HIY "你感受到乌云踏雪的神异之力，气血、内力、精神都得到了增强！" NOR "\n");
        return 1;
    }
    
    return 0;
}

/**
 * @brief 坐骑被卸下时的处理
 * @param string euid 可选的用户ID
 * @return int 成功返回1，失败返回0
 * @details 下马时显示特殊信息
 */
varargs int remove(string euid)
{
    object owner;
    
    owner = environment();
    
    if (!owner || !userp(owner))
        return 0;
    
    if (::remove())
    {
        message_vision(HIB "$N从乌云踏雪身上跳下，那股神异的力量也随之消散。" NOR "\n", owner);
        tell_object(owner, HIY "你离开了乌云踏雪，感到那些增强的能力正在消退。" NOR "\n");
        return 1;
    }
    
    return 0;
}