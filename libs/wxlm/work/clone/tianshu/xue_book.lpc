// /clone/tianshu/xue_book.c


inherit ITEM;

void create()
{
    set_name(HIW "雪书" NOR, ({ "xue shu", "xue", "shu" }));
    set_weight(500);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("unit", "本");
        set("long", "这是一本天书，名为「雪书」，是门派挑战系统的收集品之一。\n");
        set("value", 1);
        set("material", "paper");
        set("no_sell", 1);
        set("no_drop", 1);
        set("no_give", 1);
    }
}