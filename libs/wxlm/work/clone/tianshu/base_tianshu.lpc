
inherit ITEM;

void create()
{
    set_name("天书", ({ "tian shu", "tianshu", "shu" }));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("unit", "本");
        set("long", "这是一本天书，是门派挑战系统的收集品。\n");
        set("value", 1);
        set("material", "paper");
        set("no_sell", 1);
        set("no_drop", 1);
        set("no_give", 1);
    }
}
