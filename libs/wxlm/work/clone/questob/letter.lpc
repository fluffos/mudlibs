// letter.c
// 师傅手谕



inherit ITEM;


void delay_accept(object me)
{
	me->force_me("accept_letter_quest quest");
}

void create()
{
	set_name("师门信件", ({ "letter", "quest letter" }));
	if (clonep())
		set_default_object(__FILE__);
	else
	{
		set("unit", "张");
		set("long", "这是一封师傅送来的亲笔信。\n");
		set("action_list",([
			"接受":"accept_letter_quest quest",
			"拒绝":"refuse_letter_quest quest",
		]));
		set("value", 0);
	}
	setup();
}

void init()
{
	// 接受
	add_action("do_accept", ({"accept_letter_quest", "accept"}));

	// 拒绝
	add_action("do_refuse", ({"refuse_letter_quest", "refuse"}));
}

// 查看时显示任务提示
string long()
{
	string msg;
	mapping quest;
	object me;

	//msg = query("long");
	msg = "你翻开信笺反面，发现师傅另有话说：\n";
	if (! mapp(quest = query("quest")))
	{
		msg += "“你还没有接受任何任务。”\n";
		return msg;
	}

	me = this_player();
	if (me->query("id") != query("quester"))
	{
		msg += "“你还没有接受任何任务。”\n";
		return msg;
	}
	// call_out 不一定很准时，所以这里要防止出现
	// “负一秒”这样的情况
	if (time() > query("dest_time"))
		return msg;

	//msg += "上面写着：\n";

	// 为其他类型的任务提供扩展余地
	switch (quest["type"])
	{
	case "kill" :
		// 寻找 master 太过麻烦，所以这里就根据本人的善恶
		// 判断消息
		msg += "\n“字谕弟子" + me->name() + "：";
		if (me->is_good())
		{
			msg += ("得闻恶贼" HIR + quest["name"] + NOR "（"+ quest["id"] +"）打家劫舍，无恶不作。近日他在" HIR +
				quest["place"] + NOR "出没，正是大好"
				"机会将他除去，你若愿意，便代我出手"
				"无妨，但务必须在" HIR + 
				CHINESE_D->chinese_monthday(quest["limit"]) +
				NOR "之前完成。否则回山复命即可。" +
				quest["master_name"] + "于" + 
				CHINESE_D->chinese_monthday(quest["time"]) + 
				"。”\n");
		} else
		if (me->is_bad())
		{
			msg += ("得闻所谓大侠" HIR + quest["name"] + NOR "（"+ quest["id"] +"）屡次和我派作对，近日他在" HIR +
				quest["place"] + NOR "出没，正是大好"
				"机会将他除去，你若愿意，便代我出手"
				"无妨，但务必须在" HIR + 
				CHINESE_D->chinese_monthday(quest["limit"]) +
				NOR "之前完成。否则回山复命即可。" +
				quest["master_name"] + "于" + 
				CHINESE_D->chinese_monthday(quest["time"]) + 
				"。”\n");
		} else {
			msg += ("武林人士" HIR + quest["name"] + NOR "（"+ quest["id"] +"）所为甚是讨厌，得闻近日他在" HIR +
				quest["place"] + NOR "出没，正是大好"
				"机会将他除去，你若愿意，便代我出手"
				"无妨，但务必须在" HIR + 
				CHINESE_D->chinese_monthday(quest["limit"]) +
				NOR "之前完成。否则回山复命即可。" +
				quest["master_name"] + "于" + 
				CHINESE_D->chinese_monthday(quest["time"]) + 
				"。”\n");
		}
		break; 
	}

	msg += "如果你愿意接受此任务，请在"+ chinese_number(query("dest_time") - time()) +"秒之内：";

	msg = replace_string(msg,"\n",ZJBR);

	if (stringp(msg))
	{
		object pop;

		pop = new(POP1);

		pop->basic(msg,2);
		pop->add_button("确认","accept_letter_quest quest");
		pop->add_button("拒绝","refuse_letter_quest quest");

		msg = pop->result();
	}
	
	return msg + "\n";
}

string long2(object me)
{
	string msg;
	mapping quest;

	msg = "你翻开信笺反面，发现师傅另有话说：\n";

	if (! mapp(quest = query("quest")))
	{
		msg += "“你还没有接受任何任务。(错误1，请联系巫师)”\n";
		return msg;
	}

	if (me->query("id") != query("quester"))
	{
		msg += "“你还没有接受任何任务。(错误2，请联系巫师)”\n";
		return msg;
	}

	// call_out 不一定很准时，所以这里要防止出现
	// “负一秒”这样的情况
	if (time() > query("dest_time"))
	{
		msg +=  "时间不匹配，你的任务已经过期了。(错误3，请联系巫师)\n";
		return msg;
	}
	

	// 为其他类型的任务提供扩展余地
	switch (quest["type"])
	{
	case "kill" :
		// 寻找 master 太过麻烦，所以这里就根据本人的善恶
		// 判断消息
		msg += "\n“字谕弟子" + me->name() + "：";
		if (me->is_good())
		{
			msg += ("得闻恶贼" HIR + quest["name"] + NOR "（"+ quest["id"] +"）打家劫舍，无恶不作。近日他在" HIR +
				quest["place"] + NOR "出没，正是大好"
				"机会将他除去，你若愿意，便代我出手"
				"无妨，但务必须在" HIR + 
				CHINESE_D->chinese_monthday(quest["limit"]) +
				NOR "之前完成。否则回山复命即可。" +
				quest["master_name"] + "于" + 
				CHINESE_D->chinese_monthday(quest["time"]) + 
				"。”\n");
		} else
		if (me->is_bad())
		{
			msg += ("得闻所谓大侠" HIR + quest["name"] + NOR "（"+ quest["id"] +"）屡次和我派作对，近日他在" HIR +
				quest["place"] + NOR "出没，正是大好"
				"机会将他除去，你若愿意，便代我出手"
				"无妨，但务必须在" HIR + 
				CHINESE_D->chinese_monthday(quest["limit"]) +
				NOR "之前完成。否则回山复命即可。" +
				quest["master_name"] + "于" + 
				CHINESE_D->chinese_monthday(quest["time"]) + 
				"。”\n");
		} else {
			msg += ("武林人士" HIR + quest["name"] + NOR "（"+ quest["id"] +"）所为甚是讨厌，得闻近日他在" HIR +
				quest["place"] + NOR "出没，正是大好"
				"机会将他除去，你若愿意，便代我出手"
				"无妨，但务必须在" HIR + 
				CHINESE_D->chinese_monthday(quest["limit"]) +
				NOR "之前完成。否则回山复命即可。" +
				quest["master_name"] + "于" + 
				CHINESE_D->chinese_monthday(quest["time"]) + 
				"。”\n");
		}
		break; 
	}

	// 想立即拒绝的话就输入 refuse，否则等 30 秒也没关系
	msg += "如果你愿意接受此任务，请在" + chinese_number(query("dest_time") - time()) +"秒之内：";
	msg = replace_string(msg,"\n",ZJBR);

	if (stringp(msg))
	{
		object pop;

		pop = new(POP1);

		pop->basic(msg,2);
		pop->add_button("确认","accept_letter_quest quest");
		pop->add_button("拒绝","refuse_letter_quest quest");

		msg = pop->result();
	}

	return msg + "\n";
}

private void eval_function(function fun) { evaluate(fun); }

// 自动取消
void start_auto_cancel(object who, int timeout)
{


	if (who->query("family_auto_quest_accept"))
	{
		// 延迟两秒接取任务
		tell_object(who,HIR"你开启了师门，自动接受了任务，两秒后自动处理"NOR"。\n");
		call_out("delay_accept", 2, who);
	}
	else
	{
		tell_object(who,long2(who));
	}
	
	call_out("refuse_quest", timeout, who);
}

// 接受任务
// 发放上一个任务的奖励，生成这一个任务的 npc
int do_accept(string arg)
{
	object head;
	object me;
	object menke;

	if (arg != "quest")
		return notify_fail("你要接受什么？\n");



	if (query_temp("obsolete"))
		return 0;
	
	me = this_player();

	if (menke = me->query("menke_system/summon"))
	{
		if (menke->query("doing_quest"))
		{
			return notify_fail("你的门客正在执行任务，不能再领取任务了。\n");
		}
	}
	
	if(me->is_ghost())
		return notify_fail("你先还阳再说。\n");
	
	// if (me->query("shimen/lun")>=15)
  	// {
    // if ("adm/daemons/questd"->check_shimen("yanzhen",me))
  	// return 1;
  	// }
	if (me->query("id") != query("quester"))
		return notify_fail("这信可不是寄给你的。\n");

	    if (!mapp(me->query("quest")))
	    {
		    if(QUEST_D->start_quest(me, query("quest")))
		    	message_sort(query("msg/accept"), me);

		    // Drop head
		    if (objectp(head = present("head", me)) && head->query("owner_id") == query("killed_id"))
		    {
			message_vision("$N看看手中的" + head->name() +
				       "，心道此物已然无用，顺手就往地上一扔。\n",
				      me);
			destruct(head);
		    } else
		    if (objectp(head = present("head", environment(me))) && head->query("owner_id") == query("killed_id"))
		    {
			message_vision("$N看看地上的" + head->name() +
				       "，心道此物已然无用，顺手就往边上一踢。\n",
				      me);
			destruct(head);
		    }
	    } else
		    write("你看了看信，似乎没啥重要的。\n");

	set_temp("obsolete", 1);
	call_out("dest_ob", 0, this_object());
	return 1;
}

// 析构函数
void dest_ob(object ob)
{
	destruct(ob);
}

// 拒绝
int do_refuse(string arg)
{
	object me;

	if (arg != "quest")
		return notify_fail("你要拒绝什么？\n");

	if (query_temp("obsolete"))
		return 0;

	me = this_player();
	if (me->query("id") != query("quester"))
		return notify_fail("这信可不是寄给你的。\n");

	message_sort(query("msg/refuse"), me);

	set_temp("obsolete", 1);
	call_out("dest_ob", 0, this_object());
	return 1;
}

// CLASS_D("generate") + "/killed" 延时调用的析构函数
void refuse_quest(object me)
{
	message_sort(query("msg/refuse"), me);

	remove_call_out("eval_function");
	call_out("dest_ob", 0, this_object());
}
