// 凤尾银鱼 - 珍稀鱼类，可增加经验

inherit COMBINED_ITEM;

/**
 * @brief 设置物品数量
 * @details 初始化物品数量为1
 */
void setup()
{
    set_amount(1);
    ::setup();
}

/**
 * @brief 创建凤尾银鱼物品
 * @details 设置物品的基本属性，包括名称、重量、描述等
 */
void create()
{
    set_name(HIW "凤尾银鱼" NOR, ({ "fengwei yinyu", "yinyu", "yu" }) );
    set_weight(120);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("long", "一条银光闪闪的珍稀鱼类，尾部如凤凰尾羽般美丽。传说食用后可以增加修炼经验。\n");
        set("base_unit", "条");
        set("base_weight", 1);
        set("base_value", 25000);
        set("no_sell", 1);
        set("no_shop", 1);
        set("only_do_effect", 1);
    }
    setup();
}

/**
 * @brief 批量食用凤尾银鱼的效果
 * @param me object 食用者对象
 * @param amount int 食用数量
 * @return int 返回1表示成功食用
 * @details 批量食用后增加经验，累积效果
 */
int do_effect_more(object me, int amount)
{
    int exp_add, total_exp;
    int i;

    log_file("nosave/using", sprintf("%s(%s) eat %d 凤尾银鱼 at %s.\n",
         me->name(1), me->query("id"), amount, ctime(time())));
    message_vision("$N一次性食用了" + amount + query("base_unit") + name() + "，鱼肉入口即化，香味无穷。\n", me);

    total_exp = 0;
    // 批量增加经验
    for(i = 0; i < amount; i++)
    {
        exp_add = 1000 + random(1000); // 1000-2000经验
        total_exp += exp_add;
    }
    me->add("combat_exp", total_exp);
    
    write(HIC "你感到阅历大增，对武学的理解更加深刻！"NOR"\n");
    write("\n "+HIR+"恭喜你："+NOR+HIG+"批量食用" + amount + "条凤尾银鱼成功，总共增加了" + total_exp + "点经验！！！"NOR"\n");
    
    write(HIY "多股清流在体内游走，你觉得神清气爽！"NOR"\n");

    add_amount(-amount);
    return 1;
}

/**
 * @brief 食用凤尾银鱼的效果
 * @param me object 食用者对象
 * @return int 返回1表示成功食用
 * @details 食用后增加经验，每日限制食用次数
 */
int do_effect(object me)
{
    int exp_add;

    log_file("nosave/using", sprintf("%s(%s) eat 凤尾银鱼 at %s.\n",
         me->name(1), me->query("id"), ctime(time())));
    message_vision("$N轻咬一口" + query("unit") + name() + "，鱼肉入口即化，香味无穷。\n", me);


    // 增加经验
    exp_add = 1000 + random(1000); // 1000-2000经验
    me->add("combat_exp", exp_add);
    
    write(HIC "你感到阅历大增，对武学的理解更加深刻！"NOR"\n");
    write("\n "+HIR+"恭喜你："+NOR+HIG+"食用凤尾银鱼成功，经验增加了" + exp_add + "点！！！"NOR"\n");
    
    write(HIY "一股清流在体内游走，你觉得神清气爽！"NOR"\n");

    add_amount(-1);
    return 1;
}