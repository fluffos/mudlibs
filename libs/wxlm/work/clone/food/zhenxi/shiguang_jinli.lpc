// 时光锦鲤 - 珍稀鱼类，可恢复状态并提供保护

inherit COMBINED_ITEM;

/**
 * @brief 设置物品数量
 * @details 初始化物品数量为1
 */
void setup()
{
    set_amount(1);
    ::setup();
}

/**
 * @brief 创建时光锦鲤物品
 * @details 设置物品的基本属性，包括名称、重量、描述等
 */
void create()
{
    set_name(HIC "时光锦鲤" NOR, ({ "shiguang jinli", "jinli", "yu" }) );
    set_weight(1);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("long", "一条美丽的锦鲤，身上的鳞片仿佛蕴含着时光的力量。传说食用后可以逆转时光，恢复青春活力。\n");
        set("base_unit", "条");
        set("base_weight", 1);
        set("base_value", 400);
        set("no_sell", 1);
        set("no_shop", 1);
        set("only_do_effect", 1);
    }
    setup();
}

/**
 * @brief 批量食用时光锦鲤的效果
 * @param me object 食用者对象
 * @param amount int 食用数量
 * @return int 返回1表示成功食用
 * @details 批量食用后恢复状态，效果相同但节省操作时间
 */
int do_effect_more(object me, int amount)
{
    int effect;
    mapping my;

    if (sizeof(filter_array(me->query_enemy(),(: userp :))))
		return notify_fail("正在和玩家对手战斗，不能使用"+ name() +"。\n");

    log_file("nosave/using", sprintf("%s(%s) eat %d 时光锦鲤 at %s.\n",
         me->name(1), me->query("id"), amount, ctime(time())));

    effect = 0;
    message_vision("$N轻抚着" + amount + query("unit") + name() + "，时光之力缓缓流淌。\n", me);

    // 恢复所有状态到最佳（批量使用效果相同）
    my = me->query_entire_dbase();
    my["eff_jing"] = my["max_jing"];
    my["jing"] = my["max_jing"];
    my["eff_qi"] = my["max_qi"];
    my["qi"] = my["max_qi"];
    if (my["neili"] < my["max_neili"])
        my["neili"] = my["max_neili"];
    
    write(HIC "时光之力环绕着你，你感到青春焕发！"NOR"\n");
    write(HIY "你一次性食用了" + amount + "条时光锦鲤，时光之力更加强烈！"NOR"\n");

    add_amount(-amount);
    return 1;
}

/**
 * @brief 食用时光锦鲤的效果
 * @param me object 食用者对象
 * @return int 返回1表示成功食用
 * @details 食用后恢复状态并获得时光保护，每日限制食用次数
 */
int do_effect(object me)
{
    int effect;
    mapping my;

    if (sizeof(filter_array(me->query_enemy(),(: userp :))))
		return notify_fail("正在和玩家对手战斗，不能使用"+ name() +"。\n");
        
    log_file("nosave/using", sprintf("%s(%s) eat 时光锦鲤 at %s.\n",
         me->name(1), me->query("id"), ctime(time())));

    effect = 0;
    message_vision("$N轻抚着一" + query("unit") + name() + "，时光之力缓缓流淌。\n", me);

    // 恢复所有状态到最佳
    my = me->query_entire_dbase();
    my["eff_jing"] = my["max_jing"];
    my["jing"] = my["max_jing"];
    my["eff_qi"] = my["max_qi"];
    my["qi"] = my["max_qi"];
    if (my["neili"] < my["max_neili"])
        my["neili"] = my["max_neili"];
    
    write(HIC "时光之力环绕着你，你感到青春焕发！"NOR"\n");

    add_amount(-1);
    return 1;
}