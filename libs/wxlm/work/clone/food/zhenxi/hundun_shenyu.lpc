// 混沌神鱼 - 珍稀鱼类，综合效果最强

inherit COMBINED_ITEM;

/**
 * @brief 设置物品数量
 * @details 初始化物品数量为1
 */
void setup()
{
    set_amount(1);
    ::setup();
}

/**
 * @brief 创建混沌神鱼物品
 * @details 设置物品的基本属性，包括名称、重量、描述等
 */
void create()
{
    set_name(HIR "混沌神鱼" NOR, ({ "hundun shenyu", "shenyu", "yu" }) );
    set_weight(1);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("long", "一条神秘莫测的珍稀鱼类，身体仿佛蕴含着混沌之力。传说是天地初开时的神物，食用后可获得全面提升。\n");
        set("base_unit", "条");
        set("base_weight", 1);
        set("base_value", 80);
        set("no_sell", 1);
        set("no_shop", 1);
        set("only_do_effect", 1);
    }
    setup();
}

/**
 * @brief 批量食用混沌神鱼的效果
 * @param me object 食用者对象
 * @param amount int 食用数量
 * @return int 返回1表示成功食用
 * @details 批量食用后获得全面提升，累积效果
 */
int do_effect_more(object me, int amount)
{
    int potential_add, exp_add, linghui_add;
    int total_potential, total_exp, total_linghui;
    int i;

    log_file("nosave/using", sprintf("%s(%s) eat %d 混沌神鱼 at %s.\n",
         me->name(1), me->query("id"), amount, ctime(time())));

    message_vision("$N怀着敬畏之心，一次性品尝了" + amount + query("base_unit") + name() + "，混沌之力在体内激荡。\n", me);

    total_potential = 0;
    total_exp = 0;
    total_linghui = 0;
    
    // 批量增加属性
    for(i = 0; i < amount; i++)
    {
        // 增加潜能
        potential_add = 1500 + random(500); // 1500-2000潜能
        total_potential += potential_add;
        
        // 增加经验
        exp_add = 1000 + random(2000);
        total_exp += exp_add;
        
        // 增加灵慧
        linghui_add = 30 + random(20); // 30-50灵慧
        total_linghui += linghui_add;
    }
    
    me->add("potential", total_potential);
    me->add("combat_exp", total_exp);
    me->add("magic_points", total_linghui);
    
    write(HIR "混沌之力在体内爆发，你感到前所未有的强大！"NOR"\n");
    write("\n "+HIR+"恭喜你："+NOR+HIG+"批量食用" + amount + "条混沌神鱼成功！"NOR"\n");
    write(HIG+"总共增加潜能" + total_potential + "点！"NOR"\n");
    write(HIC+"总共增加经验" + total_exp + "点！"NOR"\n");
    write(HIM+"总共增加灵慧" + total_linghui + "点！"NOR"\n");
    write(HIY "强大的混沌神力在体内流转，你觉得脱胎换骨，实力大增！"NOR"\n");

    add_amount(-amount);
    return 1;
}

/**
 * @brief 食用混沌神鱼的效果
 * @param me object 食用者对象
 * @return int 返回1表示成功食用
 * @details 食用后获得全面提升，每日只能食用一次
 */
int do_effect(object me)
{
    int potential_add, exp_add, linghui_add;

    log_file("nosave/using", sprintf("%s(%s) eat 混沌神鱼 at %s.\n",
         me->name(1), me->query("id"), ctime(time())));

    message_vision("$N怀着敬畏之心，慢慢品尝着一" + query("unit") + name() + "，混沌之力在体内激荡。\n", me);

    // 增加潜能
    potential_add = 1500 + random(500); // 1500-2000潜能
    me->add("potential", potential_add);
    
    // 增加经验
    exp_add = 1000 + random(2000);
    me->add("combat_exp", exp_add);
    
    // 增加灵慧
    linghui_add = 30 + random(20); // 30-50灵慧
    me->add("magic_points", linghui_add);
    
    
    write(HIR "混沌之力在体内爆发，你感到前所未有的强大！"NOR"\n");
    write("\n "+HIR+"恭喜你："+NOR+HIG+"食用混沌神鱼成功！"NOR"\n");
    write(HIG+"潜能增加了" + potential_add + "点！"NOR"\n");
    write(HIC+"经验增加了" + exp_add + "点！"NOR"\n");
    write(HIM+"灵慧增加了" + linghui_add + "点！"NOR"\n");
    write(HIY "混沌神力在体内流转，你觉得脱胎换骨，实力大增！"NOR"\n");

    add_amount(-1);
    return 1;
}