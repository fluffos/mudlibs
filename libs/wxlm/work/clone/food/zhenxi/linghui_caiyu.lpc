// 灵慧彩鱼 - 珍稀鱼类，可增加灵慧

inherit COMBINED_ITEM;

/**
 * @brief 设置物品数量
 * @details 初始化物品数量为1
 */
void setup()
{
    set_amount(1);
    ::setup();
}

/**
 * @brief 创建灵慧彩鱼物品
 * @details 设置物品的基本属性，包括名称、重量、描述等
 */
void create()
{
    set_name(HIM "灵慧彩鱼" NOR, ({ "linghui caiyu", "caiyu", "yu" }) );
    set_weight(1);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("long", "一条五彩斑斓的珍稀鱼类，身上散发着淡淡的灵光。传说食用后可以增加灵慧悟性。\n");
        set("base_unit", "条");
        set("base_weight", 1);
        set("base_value", 350);
        set("no_sell", 1);
        set("no_shop", 1);
        set("only_do_effect", 1);
        set("day_limit_number", 3);
    }
    setup();
}

/**
 * @brief 批量食用灵慧彩鱼的效果
 * @param me object 食用者对象
 * @param amount int 食用数量
 * @return int 返回1表示成功食用
 * @details 批量食用后增加灵慧，累积效果
 */
int do_effect_more(object me, int amount)
{
    int linghui_add, total_linghui;
    int i;

    log_file("nosave/using", sprintf("%s(%s) eat %d 灵慧彩鱼 at %s.\n",
         me->name(1), me->query("id"), amount, ctime(time())));

    message_vision("$N虔诚地一次性品尝了" + amount + query("unit") + name() + "，五彩光芒在口中绽放。\n", me);
    
    total_linghui = 0;
    // 批量增加灵慧
    for(i = 0; i < amount; i++)
    {
        linghui_add = 20 + random(10); // 20-30灵慧
        total_linghui += linghui_add;
    }
    me->add("magic_points", total_linghui);
    
    write("\n "+HIR+"恭喜你："+NOR+HIG+"批量食用" + amount + "条灵慧彩鱼成功，总共增加了" + total_linghui + "点灵慧！！！"NOR"\n");
    
    write(HIY "强烈的五彩灵光在体内流转，你觉得心境空明，法力充盈！"NOR"\n");

    add_amount(-amount);
    return 1;
}

/**
 * @brief 食用灵慧彩鱼的效果
 * @param me object 食用者对象
 * @return int 返回1表示成功食用
 * @details 食用后增加灵慧，每日限制食用次数
 */
int do_effect(object me)
{
    int linghui_add;

    log_file("nosave/using", sprintf("%s(%s) eat 灵慧彩鱼 at %s.\n",
         me->name(1), me->query("id"), ctime(time())));

    message_vision("$N虔诚地品尝着一" + query("unit") + name() + "，五彩光芒在口中绽放。\n", me);
    
    // 增加灵慧
    linghui_add = 20 + random(10); // 20-30灵慧
    me->add("magic_points", linghui_add);
    
    write("\n "+HIR+"恭喜你："+NOR+HIG+"食用灵慧彩鱼成功，灵慧增加了" + linghui_add + "点！！！"NOR"\n");
    
    write(HIY "五彩灵光在体内流转，你觉得心境空明，法力充盈！"NOR"\n");

    add_amount(-1);
    return 1;
}