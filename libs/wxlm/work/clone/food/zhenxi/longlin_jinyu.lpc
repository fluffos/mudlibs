// 龙鳞金鱼 - 珍稀鱼类，可增加潜能

inherit COMBINED_ITEM;

/**
 * @brief 设置物品数量
 * @details 初始化物品数量为1
 */
void setup()
{
    set_amount(1);
    ::setup();
}

/**
 * @brief 创建龙鳞金鱼物品
 * @details 设置物品的基本属性，包括名称、重量、描述等
 */
void create()
{
    set_name(HIY "龙鳞金鱼" NOR, ({ "longlin jinyu", "jinyu", "yu" }) );
    set_weight(1);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("long", "一条通体金黄的珍稀鱼类，鳞片如龙鳞般闪闪发光。传说食用后可以增加修炼潜能。\n");
        set("base_unit", "条");
        set("base_weight", 1);
        set("base_value", 300);
        set("no_sell", 1);
        set("no_shop", 1);
        set("only_do_effect", 1);
    }
    setup();
}

/**
 * @brief 批量食用龙鳞金鱼的效果
 * @param me object 食用者对象
 * @param amount int 食用数量
 * @return int 返回1表示成功食用
 * @details 批量食用后增加潜能，累积效果
 */
int do_effect_more(object me, int amount)
{
    int potential_add, total_potential;
    int i;

    log_file("nosave/using", sprintf("%s(%s) eat %d 龙鳞金鱼 at %s.\n",
         me->name(1), me->query("id"), amount, ctime(time())));

    message_vision("$N小心翼翼地一次性品尝了" + amount + query("unit") + name() + "，鱼肉鲜美无比。\n", me);

    total_potential = 0;
    // 批量增加潜能
    for(i = 0; i < amount; i++)
    {
        potential_add = 800 + random(400); // 800-1200潜能
        total_potential += potential_add;
    }
    me->add("potential", total_potential);
    
    write(HIG "你感到体内真气涌动，修炼潜能大增！"NOR"\n");
    write("\n "+HIR+"恭喜你："+NOR+HIG+"批量食用" + amount + "条龙鳞金鱼成功，总共增加了" + total_potential + "点潜能！！！"NOR"\n");
    
    write(HIY "阵阵清香在口中回味，你觉得精神焕发！"NOR"\n");

    add_amount(-amount);
    return 1;
}

/**
 * @brief 食用龙鳞金鱼的效果
 * @param me object 食用者对象
 * @return int 返回1表示成功食用
 * @details 食用后增加潜能，每日限制食用次数
 */
int do_effect(object me)
{
    int potential_add;

    log_file("nosave/using", sprintf("%s(%s) eat 龙鳞金鱼 at %s.\n",
         me->name(1), me->query("id"), ctime(time())));

    message_vision("$N小心翼翼地品尝着一" + query("unit") + name() + "，鱼肉鲜美无比。\n", me);

    // 增加潜能
    potential_add = 800 + random(400); // 800-1200潜能
    me->add("potential", potential_add);
    
    write(HIG "你感到体内真气涌动，修炼潜能大增！"NOR"\n");
    write("\n "+HIR+"恭喜你："+NOR+HIG+"食用龙鳞金鱼成功，潜能增加了" + potential_add + "点！！！"NOR"\n");
    
    write(HIY "一阵清香在口中回味，你觉得精神焕发！"NOR"\n");

    add_amount(-1);
    return 1;
}