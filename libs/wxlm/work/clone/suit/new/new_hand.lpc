#include <armor.h>

inherit HANDS;

void create()
{
        set_name(HIG "新丁掌套" NOR, ({ "new hand", "hand" }));
        set_weight(500);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "副");
                set("icon", "05036");
                set("long", "这是一副精工制成的" + this_object()->query("name") + "，是地狱家族特别为新手定做的！\n");
                set("value", 10);
                set("material", "steel");
                set("wield_msg", "$N将一副$n戴在手上。\n");
                set("unwield_msg", "$N将手上的$n脱了下来。\n");

                // 套装参数
                set("suit", HIG "新丁套装" NOR);    // 套装名称
                set("suit_lvl", 1);                 // 套装等级
                set("suit_count", 4);               // 套装部件数量

                // 套装各部件
                set("suit_mod/cloth", "新丁长衫");
                set("suit_mod/boots", "新丁快靴");
                set("suit_mod/pants", "新丁长裤");
                set("suit_mod/sword", "新丁剑");
                set("suit_mod/blade", "新丁刀");
                set("suit_mod/hand", "新丁掌套");

                // 套装全部附加天赋效果
                set("suit_eff/strength", 1);        // 两件
                set("suit_eff/intelligence", 1);    // 三件
                set("suit_eff/spirituality", 1);    // 一套
                set("suit_eff/constitution", 1);    // 三件

                // 套装全部附加技能效果
                set("suit_eff_skill/dodge", 10);
                set("suit_eff_skill/sword", 10);
                set("suit_eff_skill/blade", 10);
                set("suit_eff_skill/strike", 10);     // 新增掌法技能加成
                set("suit_eff_skill/unarmed", 10);  // 新增空手技能加成
                set("armor_prop/armor", 10);
                set("armor_prop/strike", 5);
                set("armor_prop/unarmed_damage", 20);
        }
        
        setup();
}

int query_autoload()
{
    return 1;
} 