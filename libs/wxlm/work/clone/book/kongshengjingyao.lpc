// mengzi.c



inherit ITEM;

void create()
{
	set_name(HIR "孔圣精要" NOR, ({ "konzi book", "kongzi shu" }));
	set_weight(300);

	if (clonep())
		set_default_object(__FILE__);
	else
	{
		set("unit", "本");
		set("long", "这本书记载了当年孔圣许多言行哲论，是儒家至高的秘典。\n");
		set("value", 100);
		set("no_sell", "这...这值什么钱？\n");
		set("material", "paper");
		set("skill", ([
			"name": "literate",    // name of the skill
			"jing_cost":   100,    // jing cost every time study this
			"difficulty":   38,    // the base int to learn this skill
			"max_skill":   500,    // the maximum level you can learn to
			"min_skill":   250,    // minimun level required
		]));
	}
}

int query_autoload() { return 1; }