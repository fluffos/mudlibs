/**
 * @file aoyi_book_canye.c
 * @author Lu dexiang
 * @brief 意境卷轴残页
 * @version 1.0
 * @date 2024-03-19
 */



inherit COMBINED_ITEM;

string query_autoload() { return query_amount() + ""; }

void autoload(string param)
{
    int amt;
    
    if (sscanf(param, "%d", amt) == 1)
        set_amount(amt);
}

void setup()
{
    set_amount(1);
    ::setup();
}

void create()
{
    set_name(HIY "意境卷轴残页" NOR, ({"aoyi canye", "canye"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "这是一张意境卷轴残页，集齐一百张可以兑换完整的意境卷轴。\n");
        set("base_unit", "张");
        set("no_shop", 1);
        set("base_value", 300);
        set("base_weight", 1);
        set("only_do_effect", 1);
    }
    setup();
}

int do_effect(object me)
{
    object ob,aoyi_book;
    int amount;
    

    
    // 创建意境卷轴
    // ob = new("/clone/aoyi_book/aoyi_book");
    ob = new(COMB_ENV_OBJ,"aoyi canye",me);

    if (! ob || !ob->query_amount())
    {
        tell_object(me, "意境卷轴生成失败。\n");
        return 1;
    }
    
    amount = ob->query_amount();

    if (amount < 100)
    {
        tell_object(me, "你的意境卷轴残页数量不足100张，目前有" + amount + "张，无法兑换完整的意境卷轴。\n");
        return 1;
    }

    aoyi_book = new_bind("/clone/aoyi_book/aoyi_book");

    // 扣除残页
    // 给予意境卷轴
    if (aoyi_book->move(me))
    {
        tell_object(me, HIG "你将一百张意境卷轴残页整理组合，获得了一卷完整的意境卷轴！\n" NOR);
        ob->deduct_amount(100);
    }

    return 1;
}
