/**
 * @brief 阴无极宝藏
 * @details 打开后有概率获得百家宝匣、先学遗训图谱、单抽卡等物品，有概率获得机缘领悟至阴生元秘传
 * @author LPC开发者
 * @date 2024
 */

inherit COMBINED_ITEM;

// 函数原型声明
void setup();
void create();
int do_effect(object me);

/**
 * @brief 设置初始数量
 */
void setup()
{
	set_amount(1);
	::setup();
}

/**
 * @brief 创建阴无极宝藏
 */
void create()
{
	set_name(HIC"阴无极宝藏"NOR, ({"yinwuji baozang", "yin baozang"}));
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("yuanbao", 200);
		set("long","这是一个阴无极宝藏，打开后有概率获得百家宝匣、先学遗训图谱、单抽卡等物品，有概率获得机缘领悟至阴生元秘传！\n");
        set("no_sell",1);
		set("base_unit", "个");
		set("base_value", 50000);
		set("base_weight", 1);
        set("only_do_effect", 1);
	}
	setup();
}

/**
 * @brief 阴无极宝藏使用效果函数
 * @param object me 使用者对象
 * @return int 返回1表示成功使用
 * @details 打开阴无极宝藏，有概率获得百家宝匣、先学遗训图谱、单抽卡等物品，有概率获得机缘领悟至阴生元秘传
 */
int do_effect(object me) {
    object baijia, yixun, onecard;

    tell_object(me, HIC "你打开了阴无极宝藏。\n" NOR);

    // 70%概率获得百家宝匣，否则获得先学遗训图谱
    if (random(100) < 70) {
        baijia = new_bind("/clone/vip/baijia_baoxia");
        if (baijia) {
            tell_object(me, HIG "你获得了一本百家宝匣。\n" NOR);
            baijia->move(me);
        }
    } else {
        yixun = new_bind("/clone/vip/yixun_tu");
        if (yixun) {
            tell_object(me, HIG "你获得了一幅先学遗训图谱。\n" NOR);
            yixun->move(me);
        }
    }

    // 50%概率获得单抽卡片
    if (random(100) < 50) {
        onecard = new_bind("/clone/baiyi/onecard");
        if (onecard) {
            tell_object(me, HIG "你获得了一张单抽卡片。\n" NOR);
            onecard->move(me);
        }
    }

    {
        // 1%概率直接获得秘传，或者机缘点达到100时必定获得
        if ((random(100) < 1 || me->query("mizhuan_jiyuan/至阴生元") >= 100) && !MIZHUAN_MASTER->has_mizhuan(me,"至阴生元") )
        {
                MIZHUAN_MASTER->add_mizhuan(me,"至阴生元");
                me->delete("mizhuan_jiyuan/至阴生元");
        }
        else
        {
                // 未获得秘传则增加机缘点
                if (!MIZHUAN_MASTER->has_mizhuan(me,"至阴生元") && me->query("mizhuan_jiyuan/至阴生元") < 100)
                {
                    me->add("mizhuan_jiyuan/至阴生元", 1);
                    tell_object(me, HIC "你感觉距离至阴生元的奥秘又近了一步(当前机缘:" + me->query("mizhuan_jiyuan/至阴生元") + "/100)。\n" NOR);
                }
        }
    }

    add_amount(-1);
    return 1;
}