inherit COMBINED_ITEM;

/**
 * @brief 设置物品数量
 * @details 初始化物品数量为1
 */
void setup()
{
	set_amount(1);
	::setup();
}

/**
 * @brief 创建太玄宝藏物品
 * @details 设置太玄宝藏的基本属性和描述
 */
void create()
{
	set_name(MAG"太玄宝藏"NOR, ({"taixuan baozang"}));
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("yuanbao", 200);
		set("long","这是一个太玄宝藏，打开后有概率获得百家宝匣、先学遗训图谱、单抽卡等物品!\n");
        set("no_sell",1);
		set("base_unit", "个");
		set("base_value", 50000);
		set("base_weight", 1);
        set("only_do_effect", 1);
	}
	setup();
}

/**
 * @brief 太玄宝藏的使用效果
 * @param object me 使用宝藏的玩家对象
 * @return int 返回1表示使用成功
 * @details 打开太玄宝藏后随机获得各种物品，但不包含秘传相关内容
 */
int do_effect(object me) {
    object baijia, yixun, onecard;

    tell_object(me, MAG "你打开了太玄宝藏。\n" NOR);

    if (random(100) < 70) {
        baijia = new_bind("/clone/vip/baijia_baoxia");
        if (baijia) {
            tell_object(me, HIG "你获得了一本百家宝匣。\n" NOR);
            baijia->move(me);
        }
    } else {
        yixun = new_bind("/clone/vip/yixun_tu");
        if (yixun) {
            tell_object(me, HIG "你获得了一幅先学遗训图谱。\n" NOR);
            yixun->move(me);
        }
    }

    if (random(100) < 50) {
        onecard = new_bind("/clone/baiyi/onecard");
        if (onecard) {
            tell_object(me, HIG "你获得了一张单抽卡片。\n" NOR);
            onecard->move(me);
        }
    }

    // 太玄宝藏不包含秘传相关功能，此处移除了葵花秘要的相关代码

    add_amount(-1);
    return 1;
}