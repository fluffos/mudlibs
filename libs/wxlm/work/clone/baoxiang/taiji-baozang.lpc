inherit COMBINED_ITEM;

void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
	set_name(YEL"太极宝藏"NOR, ({"taiji baozang"}));
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("yuanbao", 200);
		set("long","这是一个太极宝藏，打开后有概率获得百家宝匣、先学遗训图谱、单抽卡等物品，有概率获得机缘领悟太极真录!\n");
        set("no_sell",1);
		set("base_unit", "个");
		set("base_value", 50000);
		set("base_weight", 1);
        set("only_do_effect", 1);
	}
	setup();
}

/**
 * @brief 太极宝藏使用效果函数
 * @param object me 使用者对象
 * @return int 返回1表示成功使用
 * @details 打开太极宝藏，有概率获得百家宝匣、先学遗训图谱、单抽卡等物品，有概率获得机缘领悟太极真录
 */
int do_effect(object me) {
    object baijia, yixun, onecard;

    tell_object(me, YEL "你打开了太极宝藏。\n" NOR);

    if (random(100) < 70) {
        baijia = new_bind("/clone/vip/baijia_baoxia");
        if (baijia) {
            tell_object(me, HIG "你获得了一本百家宝匣。\n" NOR);
            baijia->move(me);
        }
    } else {
        yixun = new_bind("/clone/vip/yixun_tu");
        if (yixun) {
            tell_object(me, HIG "你获得了一幅先学遗训图谱。\n" NOR);
            yixun->move(me);
        }
    }

    if (random(100) < 50) {
        onecard = new_bind("/clone/baiyi/onecard");
        if (onecard) {
            tell_object(me, HIG "你获得了一张单抽卡片。\n" NOR);
            onecard->move(me);
        }
    }

    if (random(100) < 40)
    {
        if ((random(100) < 1 || me->query("mizhuan_jiyuan/太极真录") >= 100) && !MIZHUAN_MASTER->has_mizhuan(me,"太极真录") )
        {
                MIZHUAN_MASTER->add_mizhuan(me,"太极真录");
                me->delete("mizhuan_jiyuan/太极真录");
        }
        else
        {
                if (!MIZHUAN_MASTER->has_mizhuan(me,"太极真录") && me->query("mizhuan_jiyuan/太极真录") < 100)
                {
                    me->add("mizhuan_jiyuan/太极真录", 1);
                    tell_object(me, YEL "你感觉距离太极真录的奥秘又近了一步(当前机缘:" + me->query("mizhuan_jiyuan/太极真录") + "/100)。\n" NOR);
                }
        }
    }

    add_amount(-1);
    return 1;
}