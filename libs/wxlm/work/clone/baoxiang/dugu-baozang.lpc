inherit COMBINED_ITEM;

void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
	set_name(YEL"独孤宝藏"NOR, ({"dugu baozang"}));
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("yuanbao", 200);
		set("long","这是一个独孤宝藏，打开后有概率获得百家宝匣、先学遗训图谱、单抽卡等物品，有概率获得机缘领悟九曜剑枢!\n");
        set("no_sell",1);
		set("base_unit", "个");
		set("base_value", 50000);
		set("base_weight", 1);
        set("only_do_effect", 1);
	}
	setup();
}

int do_effect(object me) {
    object baijia, yixun, onecard;

    tell_object(me, YEL "你打开了独孤宝藏。\n" NOR);

    if (random(100) < 70) {
        baijia = new_bind("/clone/vip/baijia_baoxia");
        if (baijia) {
            tell_object(me, HIG "你获得了一本百家宝匣。\n" NOR);
            baijia->move(me);
        }
    } else {
        yixun = new_bind("/clone/vip/yixun_tu");
        if (yixun) {
            tell_object(me, HIG "你获得了一幅先学遗训图谱。\n" NOR);
            yixun->move(me);
        }
    }

    if (random(100) < 50) {
        onecard = new_bind("/clone/baiyi/onecard");
        if (onecard) {
            tell_object(me, HIG "你获得了一张单抽卡片。\n" NOR);
            onecard->move(me);
        }
    }

    if ((random(100) < 1 || me->query("mizhuan_jiyuan/九曜剑枢") >= 100) && !MIZHUAN_MASTER->has_mizhuan(me,"九曜剑枢") )
    {
            MIZHUAN_MASTER->add_mizhuan(me,"九曜剑枢");
            me->delete("mizhuan_jiyuan/九曜剑枢");
    }
    else
    {
            if (!MIZHUAN_MASTER->has_mizhuan(me,"九曜剑枢") && me->query("mizhuan_jiyuan/九曜剑枢") < 100)
            {
                me->add("mizhuan_jiyuan/九曜剑枢", 1);
                tell_object(me, YEL "你感觉距离九曜剑枢的奥秘又近了一步(当前机缘:" + me->query("mizhuan_jiyuan/九曜剑枢") + "/100)。\n" NOR);
            }
    }

    add_amount(-1);
    return 1;
}
