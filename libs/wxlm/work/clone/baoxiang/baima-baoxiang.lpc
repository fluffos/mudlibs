inherit COMBINED_ITEM;

void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
	set_name(HIG"白马宝箱"NOR, ({"baima baoxiang"}));
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("yuanbao", 200);
		set("long","这是一个白马宝箱，打开后有概率获得百家宝匣、先学遗训图谱、单抽卡等物品!\n");
        set("no_sell",1);
		set("base_unit", "个");
		set("base_value", 50000);
		set("base_weight", 1);
        set("only_do_effect", 1); // 标识该物品可以使用
	}
	setup();
}

int do_effect(object me) {
    object baijia, yixun, onecard;
    
    // 70%概率获得百家宝匣，30%概率获得遗训图谱
    if (random(100) < 70) {
        baijia = new_bind("/clone/vip/baijia_baoxia");
        if (baijia) {
            tell_object(me, HIG "你获得了一本百家宝匣。\n" NOR);
            baijia->move(me);
        }
    } else {
        yixun = new_bind("/clone/vip/yixun_tu");
        if (yixun) {
            tell_object(me, HIG "你获得了一幅先学遗训图谱。\n" NOR);
            yixun->move(me);
        }
    }
    
    // 单独判断，50%概率获得单抽卡
    if (random(100) < 50) {
        onecard = new_bind("/clone/baiyi/onecard");
        if (onecard) {
            tell_object(me, HIG "你获得了一张单抽卡片。\n" NOR);
            onecard->move(me);
        }
    }
    
    tell_object(me, HIG "你打开了白马宝箱。\n" NOR);
    add_amount(-1);
    return 1;
}
