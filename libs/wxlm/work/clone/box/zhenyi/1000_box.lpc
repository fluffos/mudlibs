/**
 * @brief 1000级稀有真意宝箱
 * @author LPC开发者
 * @date 2024
 */

inherit COMBINED_ITEM;

void setup()
{
    set_amount(1);
    ::setup();
}

void create()
{
    set_name(YEL"1000级稀有真意宝箱"NOR, ({"1000ji xiangzi", "xiangzi", "baoxiang"}));
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("yuanbao", 2500);
        set("long","这是一个1000级稀有真意宝箱，打开后必定获得一道武圣真意！\n"
            "掉落概率：60%灵犀真意，25%玄奥真意，13%无我真意，2%真武真意\n");
        set("no_sell",1);
        set("base_unit", "个");
        set("base_value", 500000);
        set("base_weight", 1);
        set("only_do_effect", 1);
    }
    setup();
}

/**
 * @brief 宝箱开启效果
 * @param object me 开启宝箱的玩家
 * @return int 成功返回1，失败返回0
 * @details 按照指定概率掉落不同品质的真意
 */
int do_effect(object me) 
{
    string quality;
    mapping zhenyi_data;
    int rand_val;
    
    if (!me || !objectp(me))
        return 0;
    
    tell_object(me, YEL "你小心翼翼地打开了1000级稀有真意宝箱...\n" NOR);
    
    // 检查玩家等级要求
    if (me->query("level") < 1000)
    {
        tell_object(me, HIR "你的等级不足1000级，无法领悟这道真意的奥秘！\n" NOR);
        return 0;
    }
    
    // 按概率决定品质
    rand_val = random(100);
    
    if (rand_val < 2) // 2%
        quality = "真武真意";
    else if (rand_val < 15) // 13%
        quality = "无我真意";
    else if (rand_val < 40) // 25%
        quality = "玄奥真意";
    else // 60%
        quality = "灵犀真意";
    
    // 掉落真意
    zhenyi_data = load_object("/system/wusheng/zhenyi_master")->drop_zhenyi_to_player(me, 1000, quality);
    
    if (mapp(zhenyi_data))
    {
        tell_object(me, sprintf(HIC"【宝箱开启】"NOR"真意的光芒从宝箱中涌出，你成功获得了一道 %s！\n", 
            zhenyi_data["name"]));
    }
    else
    {
        tell_object(me, HIR "宝箱中的真意似乎受到了某种干扰，获取失败！\n" NOR);
        return 0;
    }
    
    add_amount(-1);
    return 1;
} 