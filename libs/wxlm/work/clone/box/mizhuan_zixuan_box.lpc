/**
 * @brief 秘传自选宝箱
 * @details 可自选秘传箱子(独孤宝箱，太极宝箱，阴无极宝箱，阳无极宝箱，葵花宝箱)
 * @author LPC开发者
 * @date 2024
 */

inherit COMBINED_ITEM;

// 函数原型声明
void init();
int do_select_mizhuan(string arg);
int do_effect(object me);
void autoload(string param);
void setup();
void create();
mapping get_mizhuan_info(string type);

/**
 * @brief 自动加载函数
 * @param string param 参数字符串
 */
void autoload(string param)
{
    int amt;
    
    if (sscanf(param, "%d", amt) == 1)
        set_amount(amt);
}

/**
 * @brief 设置初始数量
 */
void setup()
{
    set_amount(1);
    ::setup();
}

/**
 * @brief 创建秘传自选宝箱
 */
void create()
{
    set_name(HIY"秘传自选宝箱"NOR, ({"mizhuan zixuan box", "mizhuan box", "zixuan box", "box"}));
    
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "这是一个秘传自选宝箱，可以从中选择指定类型的秘传宝箱：\n"
            "可选类型：独孤宝箱、太极宝箱、阴无极宝箱、阳无极宝箱、葵花宝箱、白马宝藏\n"
            HIY"注意：每种宝箱都有机会获得对应的秘传传承"NOR"\n");
        set("base_unit", "个");
        set("base_value", 80000);
        set("base_weight", 1);
        set("no_sell", 1);
        set("no_drop", 1);
        set("yuanbao", 100);
        set("only_do_effect", 1);
    }
    setup();
}

/**
 * @brief 初始化动作
 */
void init()
{
    add_action("do_select_mizhuan", "select_mizhuan");
}

/**
 * @brief 获取秘传宝箱信息
 * @param string type 秘传宝箱类型
 * @return mapping 返回宝箱信息映射
 * @details 返回指定类型秘传宝箱的详细信息
 */
mapping get_mizhuan_info(string type)
{
    mapping info;
    
    switch(type) {
        case "dugu":
            info = ([
                "name": YEL"独孤宝藏"NOR,
                "file": "/clone/baoxiang/dugu-baozang",
                "desc": "可获得九曜剑枢秘传传承，后天臂力+3、后天悟性+3、剑法激发+30、独孤九剑获得特殊效果",
                "color": YEL,
                "mizhuan": "九曜剑枢"
            ]);
            break;
            
        case "taiji":
            info = ([
                "name": YEL"太极宝藏"NOR,
                "file": "/clone/baoxiang/taiji-baozang",
                "desc": "可获得太极真录秘传传承，七曜级别秘传，阴阳轮转录分支",
                "color": YEL,
                "mizhuan": "太极真录"
            ]);
            break;
            
        case "yinwuji":
            info = ([
                "name": HIC"阴无极宝藏"NOR,
                "file": "/clone/baoxiang/yinwuji-baozang",
                "desc": "可获得至阴生元秘传传承，精神上限+2500、后天悟性+5",
                "color": HIC,
                "mizhuan": "至阴生元"
            ]);
            break;
            
        case "yangwuji":
            info = ([
                "name": HIY"阳无极宝藏"NOR,
                "file": "/clone/baoxiang/yangwuji-baozang",
                "desc": "可获得至阳生息秘传传承，内力上限+2500、后天根骨+5",
                "color": HIY,
                "mizhuan": "至阳生息"
            ]);
            break;
            
        case "kuihua":
            info = ([
                "name": MAG"葵花宝藏"NOR,
                "file": "/clone/baoxiang/kuihua-baozang",
                "desc": "可获得葵花秘要秘传传承，后天根骨+3、后天身法+3、剑法激发+30、身法激发+30",
                "color": MAG,
                "mizhuan": "葵花秘要"
            ]);
            break;
            
        case "baima":
            info = ([
                "name": HIG"白马宝藏"NOR,
                "file": "/clone/baoxiang/baima-baozang",
                "desc": "可获得墨家心元秘传传承，有概率获得百家宝匣、先学遗训图谱、单抽卡等物品",
                "color": HIG,
                "mizhuan": "墨家心元"
            ]);
            break;
            
        default:
            return 0;
    }
    
    return info;
}

/**
 * @brief 处理秘传宝箱选择
 * @param string arg 选择的宝箱类型
 * @return int 返回1表示成功处理
 * @details 根据玩家选择创建对应的秘传宝箱
 */
int do_select_mizhuan(string arg)
{
    object me, box_ob;
    mapping box_info;
    
    me = this_player();
    
    if (!me) {
        return 0;
    }
    
    if (!arg) {
        tell_object(me, "请指定要选择的秘传宝箱类型：\n"
            "select_mizhuan dugu     - 选择独孤宝藏\n"
            "select_mizhuan taiji    - 选择太极宝藏\n"
            "select_mizhuan yinwuji  - 选择阴无极宝藏\n"
            "select_mizhuan yangwuji - 选择阳无极宝藏\n"
            "select_mizhuan kuihua   - 选择葵花宝藏\n"
            "select_mizhuan baima    - 选择白马宝藏\n");
        return 1;
    }
    
    // 安全检查
    if (me->is_busy()) {
        tell_object(me, "你现在正忙着呢！\n");
        return 1;
    }
    
    if (me->is_fighting()) {
        tell_object(me, "战斗中无法使用宝箱！\n");
        return 1;
    }
    
    if (environment() != me) {
        tell_object(me, "你必须先拿着这个宝箱才能使用！\n");
        return 1;
    }
    
    // 检查宝箱数量
    if (query_amount() < 1) {
        tell_object(me, "你没有足够的秘传自选宝箱！\n");
        return 1;
    }
    
    // 检查玩家等级限制（可选，根据游戏需求）
    if (me->query("level") < 100) {
        tell_object(me, "你的等级不足100级，无法使用秘传自选宝箱！\n");
        return 1;
    }
    
    // 获取宝箱信息
    box_info = get_mizhuan_info(arg);
    if (!box_info) {
        tell_object(me, "无效的秘传宝箱类型！请选择：dugu、taiji、yinwuji、yangwuji、kuihua、baima\n");
        return 1;
    }
    
    // 检查负重
    if (me->query_encumbrance() > me->query_max_encumbrance() - 2) {
        tell_object(me, "你的负重不够，无法获得秘传宝箱！\n");
        return 1;
    }
    
    // 创建选择的秘传宝箱
    box_ob = new_bind(box_info["file"]);
    if (!box_ob) {
        tell_object(me, "创建秘传宝箱失败！\n");
        return 1;
    }
    
    box_ob->move(me);
    
    message_vision(HIY "$N从秘传自选宝箱中取出了一个" + box_info["name"] + "！" NOR "\n", me);
    tell_object(me, HIY "你获得了一个" + box_info["name"] + "！\n" NOR);
    tell_object(me, box_info["color"] + "提示：" + box_info["desc"] + "\n" NOR);
    
    // 消耗一个宝箱
    add_amount(-1);
    
    
    return 1;
}

/**
 * @brief 宝箱使用效果
 * @param object me 使用宝箱的玩家
 * @return int 返回1表示成功处理
 * @details 显示弹窗选择界面
 */
int do_effect(object me)
{
    string msg, *button_list, *box_keys;
    mapping box_info;
    int i;
    
    if (!me || !objectp(me)) {
        return 0;
    }
    
    // 安全检查
    if (me->is_busy()) {
        tell_object(me, "你现在正忙着呢！\n");
        return 1;
    }
    
    if (me->is_fighting()) {
        tell_object(me, "战斗中无法使用宝箱！\n");
        return 1;
    }
    
    // 构建弹窗消息
    msg = HIY"秘传自选宝箱"NOR"\n";
    msg += "你目前拥有" + chinese_number(query_amount()) + "个秘传自选宝箱。\n";
    msg += "请选择你想要的秘传宝箱：\n\n";
    
    // 构建按钮列表
    button_list = ({});
    box_keys = ({ "dugu", "taiji", "yinwuji", "yangwuji", "kuihua", "baima" });
    
    for (i = 0; i < sizeof(box_keys); i++) {
        box_info = get_mizhuan_info(box_keys[i]);
        if (box_info) {
            button_list += ({ sprintf("%s(%s):select_mizhuan %s", 
                box_info["name"], box_info["mizhuan"], box_keys[i]) });
        }
    }
    
    // 添加说明信息到消息中
    msg += HIR"注意：每种宝箱都有1%概率获得对应秘传传承，未获得则机缘点+1，100次保底必得！"NOR"\n";
    
    tell_object(me, popup_comb(msg, button_list));
    
    return 1;
}
