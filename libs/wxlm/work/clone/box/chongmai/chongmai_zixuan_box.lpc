/**
 * @brief 冲脉丹自选宝箱
 * @details 可自选下品冲脉丹×160，中品冲脉丹×80，上品冲脉丹×40，极品冲脉丹×20(四选一)
 * @author LPC开发者
 * @date 2024
 */

inherit COMBINED_ITEM;

// 函数原型声明
void init();
int do_select(string arg);
void autoload(string param);
void setup();
void create();

/**
 * @brief 自动加载函数
 * @param string param 参数字符串
 */
void autoload(string param)
{
    int amt;
    
    if (sscanf(param, "%d", amt) == 1)
        set_amount(amt);
}

/**
 * @brief 设置初始数量
 */
void setup()
{
    set_amount(1);
    ::setup();
}

/**
 * @brief 创建冲脉丹自选宝箱
 */
void create()
{
    set_name(HIY"冲脉丹自选宝箱"NOR, ({"chongmai zixuan box", "zixuan box", "box"}));
    
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "这是一个冲脉丹自选宝箱，可以从中选择一种冲脉丹：\n"
            HIW"1. 下品冲脉丹 × 160\n"
            HIG"2. 中品冲脉丹 × 80\n"
            HIR"3. 上品冲脉丹 × 40\n"
            HIY"4. 极品冲脉丹 × 20"NOR"\n");
        set("base_unit", "个");
        set("base_value", 10000);
        set("base_weight", 1);
        set("no_sell", 1);
        set("no_drop", 1);
        set("yuanbao", 2000);
        set("action_list", ([
            "选择下品" : "select_cm 1",
            "选择中品" : "select_cm 2", 
            "选择上品" : "select_cm 3",
            "选择极品" : "select_cm 4",
        ]));
    }
    setup();
}

/**
 * @brief 初始化动作
 */
void init()
{
    add_action("do_select", "select_cm");
}

/**
 * @brief 处理选择动作
 * @param string arg 选择参数
 * @return int 1表示成功，0表示失败
 */
int do_select(string arg)
{
    object me, dan;
    int choice;
    string dan_file;
    int dan_amount;
    string dan_name;
    
    me = this_player();
    
    if (!arg) {
        tell_object(me, "请选择要兑换的冲脉丹类型：\n"
            HIW"1. 下品冲脉丹 × 160\n"
            HIG"2. 中品冲脉丹 × 80\n"
            HIR"3. 上品冲脉丹 × 40\n"
            HIY"4. 极品冲脉丹 × 20\n"NOR
            "使用方法：select_cm 1|2|3|4\n");
        return 1;
    }
    
    if (environment(this_object()) != me) {
        tell_object(me, "你必须先拿起自选宝箱才能使用。\n");
        return 1;
    }
    
    if (me->is_busy()) {
        tell_object(me, "你正忙着呢，稍后再试。\n");
        return 1;
    }
    
    if (me->is_fighting()) {
        tell_object(me, "战斗中无法使用自选宝箱。\n");
        return 1;
    }
    
    choice = to_int(arg);
    
    switch(choice) {
        case 1:
            dan_file = "/clone/vip/dan_chongmai1";
            dan_amount = 160;
            dan_name = HIW"下品冲脉丹"NOR;
            break;
        case 2:
            dan_file = "/clone/vip/dan_chongmai2";
            dan_amount = 80;
            dan_name = HIG"中品冲脉丹"NOR;
            break;
        case 3:
            dan_file = "/clone/vip/dan_chongmai3";
            dan_amount = 40;
            dan_name = HIR"上品冲脉丹"NOR;
            break;
        case 4:
            dan_file = "/clone/vip/dan_chongmai4";
            dan_amount = 20;
            dan_name = HIY"极品冲脉丹"NOR;
            break;
        default:
            tell_object(me, "无效的选择，请输入1-4之间的数字。\n");
            return 1;
    }
    
    // 创建选择的冲脉丹
    dan = new_bind(dan_file);
    if (!dan) {
        tell_object(me, "系统错误，无法创建冲脉丹。\n");
        return 1;
    }
    
    // 设置数量
    dan->set_amount(dan_amount);
    
    // 移动到玩家身上
    dan->move(me);
    
    // 显示获得信息
    tell_object(me, HIY"*****************************************************\n"
        "恭喜：你从冲脉丹自选宝箱中获得了 " + dan_amount + " 颗 " + dan_name + "\n");
    
    // 减少自选宝箱数量
    add_amount(-1);
    
    
    return 1;
}