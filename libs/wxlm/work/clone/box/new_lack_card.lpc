// new_lack_card.c
inherit COMBINED_ITEM;

void setup()
{
    set_amount(1);
    ::setup();
}

void create()
{
    set_name(HIM "许愿卡" NOR, ({"lack card", "card"}));
    set_weight(200);
    if (clonep())
        set_default_object(__FILE__);
    else 
    {
        set("long", "珍贵的许愿卡，可以许愿获得各种宝箱。\n" + 
                    ZJURL("cmds:use lack card") ZJSIZE(15) "许个愿" NOR "试试吧!\n");
        set("base_unit", "张");
        set("base_weight", 10);
        set("base_value", 1);
        // set("yuanbao", 500);
        set("no_sell", 1);
        set("only_do_effect", 1);
    }
    setup();
}

int do_effect(object me)
{
    int i;
    object ob;

    if (me->is_busy())
    { 
        write("你上一个动作未完成！\n"); 
        return 1;
    }
    if (me->is_fighting())
    { 
        write("战斗中使用许愿卡？挨宰呀？\n"); 
        return 1;
    }

    message_vision("$N双手抓着" + name() + "，轻声念出了卡中浮现的文字！"NOR"\n", me);
    
    i = random(100);
    if (i > 0 && i <= 50)
    {
        ob = new("/clone/box/chuji_box"); 
    }
    else if (i > 50 && i <= 80)
    {
        ob = new("/clone/box/zhongji_box"); 
    }
    else if (i > 80 && i <= 90)
    {
        ob = new("/clone/box/gaoji_box"); 
    }
    else if (i > 90 && i <= 93)
    {
        ob = new("/clone/box/chaoji_box"); 
    }
    else if (i == 99)
    {
        ob = new("/clone/box/vip_box"); 
    }
    else
    {
        tell_object(me, ""HIR"<....>"NOR"：*许愿卡*化为..."WHT"一堆粉末"NOR"\n");
        add_amount(-1);
        return 1;
    }

    tell_object(me, ""HIM"*****************************************************\n");
    tell_object(me, ""HIR"恭喜"NOR"：[" + name() + "]化为..." + 
                chinese_number(1) + ob->query("unit") + HIG + "<< " + 
                ob->query("name") + HIG " >>" + NOR + "\n");
    tell_object(me, ""HIM"*****************************************************"NOR"\n");
    
    ob->move(me);
    add_amount(-1);
    return 1;
}
