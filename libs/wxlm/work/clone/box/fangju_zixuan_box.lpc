/**
 * @brief 防具材料自选宝箱
 * @details 可自选四种防具材料：补天石、冰蚕丝、玄铁木、雾隐砂
 * @author LPC开发者
 * @date 2024
 */

inherit COMBINED_ITEM;

// 函数原型声明
void init();
int do_select(string arg);
int do_effect(object me);
void autoload(string param);
void setup();
void create();

/**
 * @brief 自动加载函数
 * @param string param 参数字符串
 */
void autoload(string param)
{
    int amt;
    
    if (sscanf(param, "%d", amt) == 1)
        set_amount(amt);
}

/**
 * @brief 设置初始数量
 */
void setup()
{
    set_amount(1);
    ::setup();
}

/**
 * @brief 创建防具材料自选宝箱
 */
void create()
{
    set_name(HIY"防具材料自选宝箱"NOR, ({"fangju box", "material box", "fangju zixuan box", "box"}));
    
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "这是一个防具材料自选宝箱，可以从中选择需要的防具制作材料：\n"
            HIY"可选材料："NOR"\n"
            HIM"补天石"NOR"（神铁材料，可制作各类装备）\n"
            HIW"冰蚕丝"NOR"（丝绸材料，可制作鞭、护甲、战衣等）\n"
            HIB"玄铁木"NOR"（木质材料，坚硬如铁）\n"
            HIW"雾隐砂"NOR"（神秘细砂，制作高级披风材料）\n");
        set("base_unit", "个");
        set("base_value", 100000);
        set("base_weight", 1);
        set("no_sell", 1);
        set("no_drop", 1);
        set("yuanbao", 100);
        set("only_do_effect", 1);
    }
    setup();
}

/**
 * @brief 初始化动作
 */
void init()
{
    add_action("do_select", "select");
}

/**
 * @brief 获取材料信息映射
 * @return mapping 材料信息
 */
mapping get_material_info()
{
    return ([
        "butian": ([
            "name": HIM"补天石"NOR,
            "path": "/clone/vip/butian",
            "desc": "神铁材料，可制作各类装备",
            "type": "神铁"
        ]),
        "bingcan": ([
            "name": HIW"冰蚕丝"NOR,
            "path": "/d/item/obj/tiancs",
            "desc": "丝绸材料，可制作鞭、护甲、战衣等",
            "type": "丝绸"
        ]),
        "xuantie": ([
            "name": HIB"玄铁木"NOR,
            "path": "/d/item/obj/xuantie_mu",
            "desc": "木质材料，坚硬如铁，装备升阶材料材料",
            "type": "木材"
        ]),
        "wuyin": ([
            "name": HIW"雾隐砂"NOR,
            "path": "/d/item/obj/wuyin_sha",
            "desc": "神秘细砂，装备升阶材料材料",
            "type": "细砂"
        ])
    ]);
}

/**
 * @brief 处理材料选择动作
 * @param string arg 选择的材料类型
 * @return int 1表示成功，0表示失败
 */
int do_select(string arg)
{
    object me, material;
    mapping material_info, selected_info;
    string material_path;
    
    me = this_player();
    
    if (!arg) {
        tell_object(me, "请选择要获得的防具材料，使用方法：select <材料类型>\n"
            "可选材料：butian(补天石)、bingcan(冰蚕丝)、xuantie(玄铁木)、wuyin(雾隐砂)\n");
        return 1;
    }
    
    if (environment(this_object()) != me) {
        tell_object(me, "你必须先拿起自选宝箱才能使用。\n");
        return 1;
    }
    
    if (me->is_busy()) {
        tell_object(me, "你正忙着呢，稍后再试。\n");
        return 1;
    }
    
    if (me->is_fighting()) {
        tell_object(me, "战斗中无法使用自选宝箱。\n");
        return 1;
    }
    
    material_info = get_material_info();
    
    if (!material_info[arg]) {
        tell_object(me, "无效的材料选择。可选材料：butian、bingcan、xuantie、wuyin\n");
        return 1;
    }
    
    selected_info = material_info[arg];
    material_path = selected_info["path"];
    
    // 创建材料物品
    material = new_bind(material_path, me);
    if (!material) {
        tell_object(me, "创建材料失败，请联系管理员。\n");
        return 1;
    }
    
    // 每次只获得1个材料，无需设置数量
    
    // 移动到玩家身上
    if (!material->move(me)) {
        tell_object(me, "你的负重不够，无法获得材料。\n");
        destruct(material);
        return 1;
    }
    
    tell_object(me, HIY"*****************************************************\n"
        "恭喜：你从防具材料自选宝箱中获得了 " + selected_info["name"] + "！\n"
        "材料说明：" + selected_info["desc"] + "\n"
        "材料类型：" + selected_info["type"] + "\n"
        "*****************************************************"NOR"\n");
    
    // 减少自选宝箱数量
    add_amount(-1);
    
    
    return 1;
}

/**
 * @brief 宝箱开启效果
 * @param object me 开启宝箱的玩家
 * @return int 成功返回1，失败返回0
 */
int do_effect(object me)
{
    mapping material_info;
    string msg, *button_list, *material_keys;
    int i;
    
    if (!me || !objectp(me))
        return 0;
    
    material_info = get_material_info();
    material_keys = keys(material_info);
    
    msg = HIY"防具材料自选宝箱"NOR"\n";
    msg += "你目前拥有" + chinese_number(query_amount()) + "个防具材料自选宝箱。\n";
    msg += "请选择要获得的防具制作材料：\n\n";
    
    button_list = ({});
    
    for (i = 0; i < sizeof(material_keys); i++) {
        mapping info = material_info[material_keys[i]];
        button_list += ({ sprintf("%s(%s):select %s", info["name"], info["desc"], material_keys[i]) });
    }
    
    tell_object(me, popup_comb(msg, button_list));
    return 1;
}

/**
 * @brief 查询自动加载参数
 * @return string 自动加载参数
 */
string query_autoload()
{
    return query_amount() + "";
}