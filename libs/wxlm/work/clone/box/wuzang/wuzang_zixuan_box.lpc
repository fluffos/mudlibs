/**
 * @brief 五脏材料自选宝箱
 * @details 可自选五种五脏材料：血参果、龙肝草、地脾黄、天肺莲、仙肾石
 * @author LPC开发者
 * @date 2024
 */

inherit COMBINED_ITEM;

// 函数原型声明
void init();
int do_select(string arg);
int do_effect(object me);
void autoload(string param);
void setup();
void create();

/**
 * @brief 自动加载函数
 * @param string param 参数字符串
 */
void autoload(string param)
{
    int amt;
    
    if (sscanf(param, "%d", amt) == 1)
        set_amount(amt);
}

/**
 * @brief 设置初始数量
 */
void setup()
{
    set_amount(1);
    ::setup();
}

/**
 * @brief 创建五脏材料自选宝箱
 */
void create()
{
    set_name(HIY"五脏材料自选宝箱"NOR, ({"wuzang box", "material box", "wuzang zixuan box", "box"}));
    
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "这是一个五脏材料自选宝箱，可以从中选择需要的五脏炼体材料：\n"
            HIY"可选材料："NOR"\n"
            RED"血参果"NOR"（心脏炼体材料）\n"
            GRN"龙肝草"NOR"（肝脏炼体材料）\n"
            YEL"地脾黄"NOR"（脾脏炼体材料）\n"
            WHT"天肺莲"NOR"（肺脏炼体材料）\n"
            BLU"仙肾石"NOR"（肾脏炼体材料）\n");
        set("base_unit", "个");
        set("base_value", 100000);
        set("base_weight", 1);
        set("no_sell", 1);
        set("no_drop", 1);
        set("yuanbao", 3000);
        set("only_do_effect", 1);
    }
    setup();
}

/**
 * @brief 初始化动作
 */
void init()
{
    add_action("do_select", "select");
}

/**
 * @brief 获取材料信息映射
 * @return mapping 材料信息
 */
mapping get_material_info()
{
    return ([
        "xuecanguo": ([
            "name": RED"血参果"NOR,
            "path": "/system/wusheng/obj/xuecanguo",
            "desc": "心脏炼体材料",
            "organ": "心脏",
            "amount": 10
        ]),
        "longgan": ([
            "name": GRN"龙肝草"NOR,
            "path": "/system/wusheng/obj/longgan",
            "desc": "肝脏炼体材料",
            "organ": "肝脏",
            "amount": 10
        ]),
        "dipi": ([
            "name": YEL"地脾黄"NOR,
            "path": "/system/wusheng/obj/dipi",
            "desc": "脾脏炼体材料",
            "organ": "脾脏",
            "amount": 10
        ]),
        "tianfei": ([
            "name": WHT"天肺莲"NOR,
            "path": "/system/wusheng/obj/tianfei",
            "desc": "肺脏炼体材料",
            "organ": "肺脏",
            "amount": 10
        ]),
        "xianshen": ([
            "name": BLU"仙肾石"NOR,
            "path": "/system/wusheng/obj/xianshen",
            "desc": "肾脏炼体材料",
            "organ": "肾脏",
            "amount": 10
        ])
    ]);
}

/**
 * @brief 处理材料选择动作
 * @param string arg 选择的材料类型
 * @return int 1表示成功，0表示失败
 */
int do_select(string arg)
{
    object me, material;
    mapping material_info, selected_info;
    string material_path;
    int amount;
    
    me = this_player();
    
    if (!arg) {
        tell_object(me, "请选择要获得的五脏材料，使用方法：select <材料类型>\n"
            "可选材料：xuecanguo(血参果)、longgan(龙肝草)、dipi(地脾黄)、tianfei(天肺莲)、xianshen(仙肾石)\n");
        return 1;
    }
    
    if (environment(this_object()) != me) {
        tell_object(me, "你必须先拿起自选宝箱才能使用。\n");
        return 1;
    }
    
    if (me->is_busy()) {
        tell_object(me, "你正忙着呢，稍后再试。\n");
        return 1;
    }
    
    if (me->is_fighting()) {
        tell_object(me, "战斗中无法使用自选宝箱。\n");
        return 1;
    }
    
    material_info = get_material_info();
    
    if (!material_info[arg]) {
        tell_object(me, "无效的材料选择。可选材料：xuecanguo、longgan、dipi、tianfei、xianshen\n");
        return 1;
    }
    
    selected_info = material_info[arg];
    material_path = selected_info["path"];
    amount = selected_info["amount"];
    
    // 创建材料物品
    material = new_bind(material_path, me);
    if (!material) {
        tell_object(me, "创建材料失败，请联系管理员。\n");
        return 1;
    }
    
    // 设置数量
    if (material->query("base_unit")) {
        material->set_amount(amount);
    }
    
    // 移动到玩家身上
    if (!material->move(me)) {
        tell_object(me, "你的负重不够，无法获得材料。\n");
        destruct(material);
        return 1;
    }
    
    tell_object(me, HIY"*****************************************************\n"
        "恭喜：你从五脏材料自选宝箱中获得了 " + amount + " " + selected_info["name"] + "！\n"
        "材料说明：" + selected_info["desc"] + "\n"
        "适用脏器：" + selected_info["organ"] + "\n"
        "*****************************************************"NOR"\n");
    
    // 减少自选宝箱数量
    add_amount(-1);
    
    
    return 1;
}

/**
 * @brief 宝箱开启效果
 * @param object me 开启宝箱的玩家
 * @return int 成功返回1，失败返回0
 */
int do_effect(object me)
{
    mapping material_info;
    string msg, *button_list, *material_keys;
    int i;
    
    if (!me || !objectp(me))
        return 0;
    
    material_info = get_material_info();
    material_keys = keys(material_info);
    
    msg = HIY"五脏材料自选宝箱"NOR"\n";
    msg += "你目前拥有" + chinese_number(query_amount()) + "个五脏材料自选宝箱。\n";
    msg += "请选择要获得的五脏炼体材料（每次获得10个）：\n\n";
    
    button_list = ({});
    
    for (i = 0; i < sizeof(material_keys); i++) {
        mapping info = material_info[material_keys[i]];
        button_list += ({ sprintf("%s(%s):select %s", info["name"], info["desc"], material_keys[i]) });
    }
    
    tell_object(me, popup_comb(msg, button_list));
    return 1;
}

/**
 * @brief 查询自动加载参数
 * @return string 自动加载参数
 */
string query_autoload()
{
    return query_amount() + "";
}