// 葡萄树种子



inherit COMBINED_ITEM;

void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
    set_name(HIR"葡萄树"NOR"种子", ({"putao seed", "grape seed", "seed"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "这是一颗葡萄树种子，可以用来种植葡萄树。\n");
        set("base_unit", "颗");
        set("base_value", 100);
        set("base_weight", 1);
        set("yuanbao",5);
        set("crop_type", "葡萄树");
        set("no_split", 1);
    }
    setup();
}