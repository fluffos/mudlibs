
inherit COMBINED_ITEM;

void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
    set_name(HIY "人参果" NOR, ({"renshen fruit", "renshen", "fruit"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "这是一个散发着金光的人参果，传说食用后可以增加气血。\n");
        set("base_unit", "个");
        set("base_value", 15000);
        set("base_weight", 200);
        set("only_do_effect", 1);
    }
    setup();
}

int do_effect(object me)
{
    int last_eat;

    if (me->is_busy())
        return notify_fail("你正忙着呢。\n");

    if (me->is_fighting())
        return notify_fail("正在战斗中，不能使用"+ name() +"。\n");

    if (me->query("food") >= me->max_food_capacity())
        return notify_fail("你已经吃太饱了，再也塞不下任何东西了。\n");

    last_eat = me->query("last_eat_renshen");
    if (last_eat && is_same_day(last_eat, time()))
        return notify_fail("你今天已经吃过人参果了，需要等到明天才能再次食用。\n");

    me->add("food", 100);
    
    message_vision("$N小心翼翼地吃下一个" + name() + "。\n", me);
    
    me->add("renshen_effect", 100);
    me->set("last_eat_renshen", time());
    tell_object(me, HIY "你感觉到一股暖流流遍全身，气血上限提高了！\n" NOR);
    
    CHAR_D->setup_char(me);
    
    add_amount(-1);
    return 1;
}