
inherit COMBINED_ITEM;

void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
    set_name(HIG "悟心花" NOR, ({"wuxin flower", "wuxin", "flower"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "这是一朵散发着淡淡光芒的悟心花，据说食用后可以增进灵慧。\n");
        set("base_unit", "朵");
        set("base_value", 10000);
        set("base_weight", 100);
        set("only_do_effect", 1);
    }
    setup();
}

int do_effect(object me)
{
    int last_eat;

    if (me->is_busy())
        return notify_fail("你正忙着呢。\n");

    if (me->is_fighting())
        return notify_fail("正在战斗中，不能使用"+ name() +"。\n");

    if (me->query("food") >= me->max_food_capacity())
        return notify_fail("你已经吃太饱了，再也塞不下任何东西了。\n");

    last_eat = me->query("last_eat_wuxin");
    if (last_eat && is_same_day(last_eat, time()))
        return notify_fail("你今天已经吃过悟心花了，需要等到明天才能再次食用。\n");

    me->add("food", 50);
    
    message_vision("$N小心翼翼地吃下一朵" + name() + "。\n", me);
    
    me->add("magic_points", 500);
    me->set("last_eat_wuxin", time());
    tell_object(me, HIG "你感觉到一股清凉的气息流遍全身，灵慧提高了500点！\n" NOR);
    
    add_amount(-1);
    return 1;
}