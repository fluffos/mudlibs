// 作物种子



inherit ITEM;

void create()
{
    set_name("种子", ({"seed"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "这是一颗普通的种子，可以用来种植作物。\n");
        set("unit", "颗");
        set("base_value", 100);
        set("base_weight", 10);
    }
    setup();
}

void set_seed(string type)
{
    string name, *id;
    
    switch(type)
    {
        case "葡萄树":
            name = HIR"葡萄树"NOR"种子";
            id = ({"putao seed", "grape seed", "seed"});
            break;
        case "人参果树":
            name = HIY"人参果树"NOR"种子";
            id = ({"renshen seed", "ginseng seed", "seed"});
            break;
        case "悟心树":
            name = HIG"悟心树"NOR"种子";
            id = ({"wuxin seed", "enlightenment seed", "seed"});
            break;
        default:
            return;
    }
    
    set_name(name, id);
    set("long", "这是一颗" + name + "，可以用来种植" + type + "。\n");
    set("crop_type", type);
}