
inherit COMBINED_ITEM;

void create()
{
    set_name(HIW "白色宝石" NOR, ({"white gem", "gem", "baoshi"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", HIW "这是一颗普通的白色宝石,可以用来合成更高级的宝石。"NOR"\n");
        set("base_value", 1000);
        set("base_weight", 1);
        set("base_unit", "颗");
        set("level", 1);
        set("color", "white");
        set("no_sell", 1);
        set("only_do_effect", 1);
        // 不能丢弃
        set("no_drop", 1);
        // 不能卖
        set("no_sell", 1);
        // 不能给予
        set("no_give", 1);
     
    }
    set_amount(1);
    setup();
}

int do_effect(object me)
{
    message_vision("$N拿起一颗" + name() + "仔细端详，但是不知道该如何使用。\n", me);
    return 1;
}

 