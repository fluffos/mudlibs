// /clone/baoshi/color_baoshi.c


inherit COMBINED_ITEM;

mapping gem_effects = copy(BASE_HANDLE->get_gem_effects());

mapping gem_types = copy(BASE_HANDLE->get_gem_attr_names());

mapping color_types = copy(BASE_HANDLE->get_gem_color_list());

void create()
{
    set_name("宝石", ({"gem", "baoshi"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "这是一颗宝石，可以用来镶嵌在装备上。\n");
        set("base_value", 2000);
        set("base_weight", 1);
        set("base_unit", "颗");
        set("no_sell", 1);
        set("only_do_effect", 1);
        set("no_drop", 1);
        set("no_give", 1);
        set("gem_effects", gem_effects);
        set("gem_types", gem_types);
        set("color_types", color_types);
    }
    set_amount(1);
    setup();
}

void init()
{
    add_action("do_embed_gem", "embed_gem");
    add_action("do_embed", "effect");
}


void set_gem_info(string color, string cn_name, string en_name, string attr_name, int level)
{
    string full_name, id_name;
    mapping effects;

    effects = gem_effects;
    if (!effects || !effects[attr_name] || !effects[attr_name][level]) {
        log_file("baoshi_error", sprintf("Invalid gem_effects for %s level %d\n", attr_name, level));
        return;
    }

    full_name = color + cn_name + level + "级" + NOR;
    id_name = en_name + " gem " + level;
    
    set_name(full_name, ({id_name, "gem", "baoshi"}));
    set("long", sprintf("%s这是一颗%s级的%s，可以用来镶嵌在装备上提升%s。\n"
                        "当前等级：%d级\n%s：%d点\n", 
                        color, chinese_number(level), cn_name, attr_name, 
                        level, attr_name, effects[attr_name][level]));
    set("unit", "颗");
    set("base_unit", "颗");
    set("base_weight", 1);
    set("base_value", 1000 * level);
    set("level", level);
    set("gem_type", en_name);
    set("attr_name", attr_name);
}
int do_effect(object me)
{
    string msg;

    msg = ZJOBLONG"你可以选择以下操作：\n";
    msg += ZJOBACTS2+ZJMENUF(3,3,10,30);
    msg += "镶嵌宝石:embed_gem " + file_name(this_object()) + ZJSEP;
    if (query("level") < 10) {
        msg += "合成宝石:combine_gem " + query("id");
    }
    
    tell_object(me, msg + "\n");
    return 1;
}