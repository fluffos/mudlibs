// /clone/baoshi/yellow_baoshi.c


inherit COMBINED_ITEM;

void create()
{
    set_name(HIY "黄色宝石" NOR, ({"yellow gem", "gem", "baoshi"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", HIY "这是一颗闪耀着黄色光芒的宝石,蕴含着太阳的力量。"NOR"\n");
        set("base_value", 4000);
        set("base_weight", 1);
        set("base_unit", "颗");
        set("level", 4);
        set("color", "yellow");
        set("no_sell", 1);
        set("only_do_effect", 1);
        set("no_drop", 1);
        set("no_give", 1);
    }
    set_amount(1);
    setup();
}

int do_effect(object me)
{
    string msg = ZJOBLONG"你可以将黄色宝石兑换成以下属性宝石：\n";
    msg += ZJOBACTS2+ZJMENUF(3,3,10,30);
    msg += "吸血宝石:exchange_gem yellow gem to xixue" ZJSEP;
    msg += "批量兑换吸血宝石:exchange_gem yellow gem to xixue batch" ZJSEP;
    msg += "回内宝石:exchange_gem yellow gem to huinei" ZJSEP;
    msg += "批量兑换回内宝石:exchange_gem yellow gem to huinei batch" ZJSEP;
    msg += "破甲宝石:exchange_gem yellow gem to break_armor" ZJSEP;
    msg += "批量兑换破甲宝石:exchange_gem yellow gem to break_armor batch" ZJSEP;
    msg += "暴伤宝石:exchange_gem yellow gem to critical_damage" ZJSEP;
    msg += "批量兑换暴伤宝石:exchange_gem yellow gem to critical_damage batch" ZJSEP;
    msg += "暴击宝石:exchange_gem yellow gem to critical_hit" ZJSEP;
    msg += "批量兑换暴击宝石:exchange_gem yellow gem to critical_hit batch" ZJSEP;
    msg += "抗暴宝石:exchange_gem yellow gem to critical_resist" ZJSEP;
    msg += "批量兑换抗暴宝石:exchange_gem yellow gem to critical_resist batch" ZJSEP;
    msg += "增伤宝石:exchange_gem yellow gem to add_damage" ZJSEP;
    msg += "批量兑换增伤宝石:exchange_gem yellow gem to add_damage batch" ZJSEP;
    msg += "护体宝石:exchange_gem yellow gem to add_armor" ZJSEP;
    msg += "批量兑换护体宝石:exchange_gem yellow gem to add_armor batch" ZJSEP;
    msg += "抗毒宝石:exchange_gem yellow gem to anti_poison" ZJSEP;
    msg += "批量兑换抗毒宝石:exchange_gem yellow gem to anti_poison batch" ZJSEP;
    msg += "毒伤宝石:exchange_gem yellow gem to poison_damage" ZJSEP;
    msg += "批量兑换毒伤宝石:exchange_gem yellow gem to poison_damage batch";
    
    tell_object(me, msg + "\n");
    return 1;
}