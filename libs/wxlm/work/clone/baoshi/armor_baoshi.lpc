// /clone/baoshi/armor_baoshi.c


inherit "/clone/baoshi/color_baoshi";

void create()
{
    ::create();
    set("attr_name", "防御宝石");
    set("gem_effects", ([
        "防御宝石": ([1:30, 2:60, 3:120, 4:240, 5:360, 6:600, 7:900, 8:1500, 9:2100, 10:3000])
    ]));
    set("color", "blue");
}

void set_gem_info(string color, string cn_name, string en_name, string attr_name, int level)
{
    ::set_gem_info(color, cn_name, en_name, attr_name, level);
}