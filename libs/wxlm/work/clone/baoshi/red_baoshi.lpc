// /clone/baoshi/red_baoshi.c


inherit COMBINED_ITEM;

void create()
{
    set_name(HIR "红色宝石" NOR, ({"red gem", "gem", "baoshi"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", HIR "这是一颗闪耀着红色光芒的宝石,蕴含着火焰的力量。"NOR"\n");
        set("base_value", 5000);
        set("base_weight", 1);
        set("base_unit", "颗");
        set("level", 5);
        set("color", "red");
        set("no_sell", 1);
        set("only_do_effect", 1);
        set("no_drop", 1);
        set("no_give", 1);
    }
    set_amount(1);
    setup();
}

int do_effect(object me)
{
    string msg = ZJOBLONG"你可以将红色宝石兑换成以下属性宝石：\n";
    msg += ZJOBACTS2+ZJMENUF(3,3,10,30);
    msg += "连击宝石:exchange_gem red gem to combo" ZJSEP;
    msg += "批量兑换连击宝石:exchange_gem red gem to combo batch" ZJSEP;
    msg += "加力宝石:exchange_gem red gem to enforce" ZJSEP;
    msg += "批量兑换加力宝石:exchange_gem red gem to enforce batch" ZJSEP;
    msg += "特攻宝石:exchange_gem red gem to item_special_damage" ZJSEP;
    msg += "批量兑换特攻宝石:exchange_gem red gem to item_special_damage batch" ZJSEP;
    msg += "忙乱宝石:exchange_gem red gem to busy_block" ZJSEP;
    msg += "批量兑换忙乱宝石:exchange_gem red gem to busy_block batch" ZJSEP;
    msg += "减伤宝石:exchange_gem red gem to reduce_damage" ZJSEP;
    msg += "批量兑换减伤宝石:exchange_gem red gem to reduce_damage batch" ZJSEP;
    msg += "天赋宝石:exchange_gem red gem to talent_level" ZJSEP;
    msg += "批量兑换天赋宝石:exchange_gem red gem to talent_level batch" ZJSEP;
    msg += "意境宝石:exchange_gem red gem to skill_aoyi_up" ZJSEP;
    msg += "批量兑换意境宝石:exchange_gem red gem to skill_aoyi_up batch" ZJSEP;
    msg += "反击宝石:exchange_gem red gem to counter_damage" ZJSEP;
    msg += "批量兑换反击宝石:exchange_gem red gem to counter_damage batch" ZJSEP;
    msg += "伤内宝石:exchange_gem red gem to hurt_neili" ZJSEP;
    msg += "批量兑换伤内宝石:exchange_gem red gem to hurt_neili batch" ZJSEP;
    msg += "伤精宝石:exchange_gem red gem to hurt_jing" ZJSEP;
    msg += "批量兑换伤精宝石:exchange_gem red gem to hurt_jing batch";
    
    tell_object(me, msg + "\n");
    return 1;
}