// /clone/baoshi/blue_baoshi.c
inherit COMBINED_ITEM;

void create()
{
    set_name(HIB "蓝色宝石" NOR, ({"blue gem", "gem", "baoshi"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", HIB "这是一颗闪耀着蓝色光芒的宝石,可以用来兑换各种技能属性的宝石。"NOR"\n");
        set("base_value", 3000);
        set("base_weight", 1);
        set("base_unit", "颗");
        set("level", 1);
        set("color", "blue");
        set("no_sell", 1);
        set("only_do_effect", 1);
        set("no_drop", 1);
        set("no_give", 1);
    }
    set_amount(1);
    setup();
}

int do_effect(object me)
{
    string msg = ZJOBLONG"你可以将蓝色宝石兑换成以下属性宝石：\n";
    msg += ZJOBACTS2+ZJMENUF(3,3,10,30);
    msg += "内功宝石:exchange_gem blue gem to force" ZJSEP;
    msg += "轻功宝石:exchange_gem blue gem to dodge" ZJSEP;
    msg += "招架宝石:exchange_gem blue gem to parry" ZJSEP;
    msg += "拳法宝石:exchange_gem blue gem to cuff" ZJSEP;
    msg += "掌法宝石:exchange_gem blue gem to strike" ZJSEP;
    msg += "指法宝石:exchange_gem blue gem to finger" ZJSEP;
    msg += "爪法宝石:exchange_gem blue gem to claw" ZJSEP;
    msg += "手法宝石:exchange_gem blue gem to hand" ZJSEP;
    msg += "拳脚宝石:exchange_gem blue gem to unarmed" ZJSEP;
    msg += "剑法宝石:exchange_gem blue gem to sword" ZJSEP;
    msg += "刀法宝石:exchange_gem blue gem to blade" ZJSEP;
    msg += "暗器宝石:exchange_gem blue gem to throwing" ZJSEP;
    msg += "杖法宝石:exchange_gem blue gem to staff" ZJSEP;
    msg += "鞭法宝石:exchange_gem blue gem to whip" ZJSEP;
    msg += "长兵宝石:exchange_gem blue gem to club" ZJSEP;
    msg += "攻击宝石:exchange_gem blue gem to damage" ZJSEP;
    msg += "防御宝石:exchange_gem blue gem to armor" ZJSEP;
    msg += "锤法宝石:exchange_gem blue gem to hammer" ZJSEP;
    msg += "批量兑换内功宝石:exchange_gem blue gem to force batch" ZJSEP;
    msg += "批量兑换轻功宝石:exchange_gem blue gem to dodge batch" ZJSEP;
    msg += "批量兑换招架宝石:exchange_gem blue gem to parry batch" ZJSEP;
    msg += "批量兑换拳法宝石:exchange_gem blue gem to cuff batch" ZJSEP;
    msg += "批量兑换掌法宝石:exchange_gem blue gem to strike batch" ZJSEP;
    msg += "批量兑换指法宝石:exchange_gem blue gem to finger batch" ZJSEP;
    msg += "批量兑换爪法宝石:exchange_gem blue gem to claw batch" ZJSEP;
    msg += "批量兑换手法宝石:exchange_gem blue gem to hand batch" ZJSEP;
    msg += "批量兑换拳脚宝石:exchange_gem blue gem to unarmed batch" ZJSEP;
    msg += "批量兑换剑法宝石:exchange_gem blue gem to sword batch" ZJSEP;
    msg += "批量兑换刀法宝石:exchange_gem blue gem to blade batch" ZJSEP;
    msg += "批量兑换暗器宝石:exchange_gem blue gem to throwing batch" ZJSEP;
    msg += "批量兑换杖法宝石:exchange_gem blue gem to staff batch" ZJSEP;
    msg += "批量兑换锤法宝石:exchange_gem blue gem to hammer batch" ZJSEP;
    msg += "批量兑换鞭法宝石:exchange_gem blue gem to whip batch" ZJSEP;
    msg += "批量兑换长兵宝石:exchange_gem blue gem to club batch" ZJSEP;
    msg += "批量兑换攻击宝石:exchange_gem blue gem to damage batch" ZJSEP;
    msg += "批量兑换防御宝石:exchange_gem blue gem to armor batch";
    
    tell_object(me, msg + "\n");
    return 1;
}