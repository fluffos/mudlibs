// /clone/baoshi/red_diaozhuofu.c


inherit COMBINED_ITEM;

void create()
{
    set_name(HIR "红色宝石雕琢符" NOR, ({"red gem carving talisman", "red talisman", "talisman"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "这是一张神奇的符咒,可以将白色宝石雕琢成红色宝石。"ZJURL("cmds:use red talisman")ZJSIZE(20)"使用"NOR" 或者 "ZJURL("cmds:use red talisman batch")ZJSIZE(20)"批量使用"NOR"\n");
        set("base_unit", "张");
        set("base_value", 5000);
        set("base_weight", 1);
        set("no_sell", 1);
        set("no_drop", 1);
        set("no_give", 1);
    }
    set_amount(1);
    setup();
}

void init()
{
    add_action("do_use", "use");
}

int do_use(string arg)
{
    object me = this_player();
    object white_gem, red_gem;
    int i, convert_count, white_gem_count, talisman_count;
    
    if (!arg || (arg != "red talisman" && arg != "red talisman batch"))
        return notify_fail("使用方法: use red talisman 或 use red talisman batch\n");
    
    if (arg == "red talisman")
    {
        white_gem = present("white gem", me);
        if (!white_gem)
            return notify_fail("你身上没有白色宝石。\n");
        
        red_gem = new("/clone/baoshi/red_baoshi");
        red_gem->move(me);
        
        message_vision("$N小心翼翼地将" + name() + "贴在白色宝石上,只见一道红光闪过,白色宝石变成了" + red_gem->name() + "。\n", me);
        
        if (white_gem->query_amount() > 1)
            white_gem->add_amount(-1);
        else
            destruct(white_gem);
        
        add_amount(-1);
    }
    else if (arg == "red talisman batch")
    {
        white_gem = present("white gem", me);
        if (!white_gem)
            return notify_fail("你身上没有白色宝石。\n");
        
        white_gem_count = white_gem->query_amount();
        talisman_count = query_amount();
        
        if (white_gem_count < talisman_count)
            convert_count = white_gem_count;
        else
            convert_count = talisman_count;
        
        for (i = 0; i < convert_count; i++)
        {
            red_gem = new("/clone/baoshi/red_baoshi");
            red_gem->move(me);
        }
        
        if (convert_count > 0)
        {
            message_vision("$N拿出一叠" + name() + "，开始批量转换白色宝石。转眼间，" + 
                           chinese_number(convert_count) + "颗白色宝石变成了红色宝石。\n", me);
            
            if (white_gem_count > convert_count)
                white_gem->add_amount(-convert_count);
            else
                destruct(white_gem);
            
            add_amount(-convert_count);
        }
        else
        {
            return notify_fail("转换失败,请检查你的白色宝石和雕琢符数量。\n");
        }
    }
    
    return 1;
}