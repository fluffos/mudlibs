// /clone/baoshi/white_baoshi.c


inherit COMBINED_ITEM;

void create()
{
    set_name(HIW "白色宝石" NOR, ({"white gem", "gem", "baoshi"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", HIW "这是一颗普通的白色宝石，可以用来兑换各种属性的宝石。"NOR"\n");
        set("base_value", 1000);
        set("base_weight", 1);
        set("base_unit", "颗");
        set("level", 1);
        set("color", "white");
        set("no_sell", 1);
        set("only_do_effect", 1);
        set("no_drop", 1);
        set("no_give", 1);
    }
    set_amount(1);
    setup();
}

int do_effect(object me)
{
    string msg = ZJOBLONG"你可以将白色宝石兑换成以下属性宝石：\n";
    msg += ZJOBACTS2+ZJMENUF(3,3,10,30);
    msg += "气血宝石:exchange_gem white gem to qi" ZJSEP;
    msg += "内力宝石:exchange_gem white gem to neili" ZJSEP;
    msg += "精力宝石:exchange_gem white gem to jingli" ZJSEP;
    msg += "批量兑换气血宝石:exchange_gem white gem to qi batch" ZJSEP;
    msg += "批量兑换内力宝石:exchange_gem white gem to neili batch" ZJSEP;
    msg += "批量兑换精力宝石:exchange_gem white gem to jingli batch";
    
    tell_object(me, msg + "\n");
    return 1;
}