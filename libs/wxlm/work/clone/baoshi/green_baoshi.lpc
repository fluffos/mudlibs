// /clone/baoshi/green_baoshi.c


inherit COMBINED_ITEM;

void create()
{
    set_name(HIG "绿色宝石" NOR, ({"green gem", "gem", "baoshi"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", HIG "这是一颗普通的绿色宝石，可以用来兑换各种属性的宝石。"NOR"\n");
        set("base_value", 1000);
        set("base_weight", 1);
        set("base_unit", "颗");
        set("level", 1);
        set("color", "green");
        set("no_sell", 1);
        set("only_do_effect", 1);
        set("no_drop", 1);
        set("no_give", 1);
    }
    set_amount(1);
    setup();
}

int do_effect(object me)
{
    string msg = ZJOBLONG"你可以将绿色宝石兑换成以下属性宝石：\n";
    msg += ZJOBACTS2+ZJMENUF(3,3,10,30);
    msg += "臂力宝石:exchange_gem green gem to str" ZJSEP;
    msg += "根骨宝石:exchange_gem green gem to con" ZJSEP;
    msg += "身法宝石:exchange_gem green gem to dex" ZJSEP;
    msg += "悟性宝石:exchange_gem green gem to int" ZJSEP;
    msg += "批量兑换臂力宝石:exchange_gem green gem to str batch" ZJSEP;
    msg += "批量兑换根骨宝石:exchange_gem green gem to con batch" ZJSEP;
    msg += "批量兑换身法宝石:exchange_gem green gem to dex batch" ZJSEP;
    msg += "批量兑换悟性宝石:exchange_gem green gem to int batch";
    
    tell_object(me, msg + "\n");
    return 1;
}