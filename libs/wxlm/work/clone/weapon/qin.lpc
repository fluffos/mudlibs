
#include <weapon.h>
inherit QIN;

void create()
{
    set_name("凤琴", ({ "fengqin", "qin", "fengqin" }));
    set_weight(4800);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("unit", "张");
        set("long", "这张琴通体呈现淡淡的金色，琴头雕刻着一只展翅欲飞的凤凰，琴音婉转如凤鸣。\n");
        set("value", 0);  // 设置价值为0，防止出售
        set("material", "gold");
        set("wield_msg", "$N轻轻抚过$n琴头的凤凰雕刻，将琴置于膝前。\n");
        set("unwield_msg", "$N恋恋不舍地将$n收起。\n");
        set("no_drop", 1);     // 防止丢弃
        set("no_give", 1);     // 防止给予
        set("no_sell", 1);     // 防止出售
    }
    init_qin(5);
    setup();
}