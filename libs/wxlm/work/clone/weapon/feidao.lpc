// 飞刀

#include <weapon.h>

inherit THROWING;

void create()
{
    set_name("飞刀", ({ "fei dao", "dao" }));
    set_weight(100);
    
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("unit", "柄");
        set("base_unit", "柄");
        set("base_weight", 100);
        set("base_value", 1000);
        set("material", "steel");
        set("long", "这是一柄精钢打造的飞刀，刀刃锋利无比。\n");
        set("wield_msg", "$N从怀中摸出一柄$n。\n");
        set("unwield_msg", "$N将手中的$n收回怀中。\n");
    }
    
    set_amount(50);
    init_throwing(80);
    setup();
}
