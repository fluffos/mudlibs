// tianxiang.c 天香玉露



inherit ITEM;

void setup()
{
}

void create()
{
	set_name(HIW "福寿丹" NOR, ({"fushou gao", "fushou", "gao"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "块");
		set("long", HIY "一块让人增加精神的膏药，来自于全真教。。\n");
		set("value", 200000);
		set("yuanbao", 20);
		set("only_do_effect", 1);
	}
	setup();
}

int do_effect(object me)
{

	message_vision(HIC"$N掏出一块"
		       NOR HIW"福寿丹，"NOR HIC"吃了下去，精神力大增，脸上露出满足的表情。"NOR"\n",
		       me);
	if (me->improve_jingli(50 + random(50)))
		me->set("jingli", me->query("max_jingli"));
	destruct(this_object());
	return 1;
}

varargs int move(mixed dest, int raw)
{
    object obj;
    obj = new_bind("/clone/vip/fushougao");
    if (objectp(obj))
    {
        obj->set_amount(1);
        obj->move(dest);
        if (objectp(dest))
        {
            tell_object(dest, name() + "已经自动转换为可叠加状态。\n");
        }
    }
    else
    {
        ::move(dest, raw);
    }
    return 1;
}

int query_autoload() { return 1; }
