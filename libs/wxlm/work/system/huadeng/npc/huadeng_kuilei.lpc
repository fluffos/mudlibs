inherit NPC;

void create()
{
    set_name(HIY"花灯傀儡"NOR, ({"huadeng kuilei", "kuilei"}));
    set("long", @LONG
这是一个由花灯幻化而成的傀儡，通体散发着淡淡的光芒。它的动作
机械而僵硬，但却透露出一股诡异的气息。它的眼睛闪烁着幽幽的光
芒，似乎随时准备发动攻击。
LONG);
    
    set("gender", "男性");
    set("age", 100);
    set("attitude", "aggressive");
    
    // 设置基本属性
    set("max_qi", 12000);
    set("eff_qi", 12000);
    set("qi", 12000);
    set("max_jing", 12000);
    set("eff_jing", 12000);
    set("jing", 12000);
    set("max_neili", 15000);
    set("neili", 15000);
    set("jiali", 150);
    set("combat_exp", 5000000);
    
    // 设置技能等级
    set_skill("force", 200);
    set_skill("dodge", 200);
    set_skill("parry", 200);
    set_skill("unarmed", 200);
    set_skill("sword", 200);
    
    // 准备战斗
    setup();
    
    // 装备武器
    carry_object("/clone/weapon/changjian")->wield();
    carry_object("/clone/cloth/cloth")->wear();
}

void init()
{
    object ob = this_player();
    
    // 主动攻击玩家
    if(interactive(ob)) {
        remove_call_out("kill_ob");
        call_out("kill_ob", 1, ob);
    }
}

// 死亡掉落
void die()
{
    object ob, me;
    int amount;
    
    if(objectp(me = query_last_damage_from())) {
        // 掉落意境卷轴残页
        amount = 2 + random(2); // 2-3张
        for(int i = 0; i < amount; i++) {
            ob = new_bind("/clone/aoyi_book/aoyi_book_canye");
            if (objectp(ob))
            {
                ob->move(me);
            }
        }
        tell_object(me, HIY"花灯傀儡倒下后，掉落了" + chinese_number(amount) + 
            "张" + ob->query("name") + "！"NOR"\n");
        
        // 奖励绑定元宝
        me->add("yuanbao", 10);
        tell_object(me, HIY"你获得了10点绑定元宝！"NOR"\n");
    }
    
    ::die();
}


// 受伤时的反应
int receive_damage(string type, int damage, object who)
{
    // 受到重伤时增加攻击力
    if(query("qi") < query("max_qi") / 3) {
        add_temp("apply/attack", 50);
        add_temp("apply/damage", 50);
    }
    
    return ::receive_damage(type, damage, who);
} 