    "一个小娃娃，生在树枝上，身穿红衣裳，心儿是黑的。" : "樱桃",
    "一根小棍子，头上有颗珠，走起路来一摇一摆，专门帮人来写字。" : "毛笔",
    "小小一朵花，开在半空中，不是真的花，看完就不见。" : "烟花",
    "一个小东西，圆圆像月亮，能把时间记，滴答响不停。" : "钟表",
    "小小一块布，来回擦脸蛋，越擦越干净，越擦越舒坦。" : "毛巾"
]);

void create()
{
    set_name("灯谜童子", ({"dengmi tongzi", "tongzi"}));
    set("long", "这是一个天真可爱的小童子，正在这里考验过往的游客。\n");
    set("gender", "男性");
    set("age", 12);
    set("attitude", "friendly");

    // 设置气血和精神值为5000万
    set("max_qi", 50000000);
    set("eff_qi", 50000000); 
    set("qi", 50000000);
    set("max_jing", 50000000);
    set("eff_jing", 50000000);
    set("jing", 50000000);
    
    
    setup();
    
    // 设置对话
    set("inquiry", ([
        "灯谜" : (: ask_riddle :),
        "谜语" : (: ask_riddle :),
    ]));
}

void init()
{
    add_action("do_answer", "answer_huadeng");
}

// 当前谜语
private string current_riddle;

// 询问灯谜
int ask_riddle()
{
    object me = this_player();
    string *all_riddles;
    string msg;
    
    if(me->query("huadeng/riddle/" + this_object()->query("id")) >= 3) {
        msg = popup_comb("你今天已经回答过我的灯谜了，明天再来吧！", ({"返回:look"}));
        write(msg);
        return 1;
    }
    
    all_riddles = keys(riddles);
    current_riddle = all_riddles[random(sizeof(all_riddles))];
    
    msg = popup_comb("我这里有一个灯谜：\n" + current_riddle + "\n你要回答吗？", 
        ({"回答:answer_huadeng", "返回:look"}));
    write(msg);
    
    return 1;
}

// 回答灯谜
int do_answer(string arg)
{
    object me = this_player();
    object ob;
    int amount;
    if(!current_riddle)
        return notify_fail("你要回答什么？先问问灯谜童子有什么谜语吧。\n");
        
    if(!arg)
        return notify_fail(popup_input("你要回答什么？：", "answer_huadeng "));

    //是否是第二天，如果是，清除

        
    if(me->query("huadeng/riddle/" + this_object()->query("id")) >= 3)
        return notify_fail("你今天已经回答过我的灯谜超过3次了。\n");
        
    if(arg == riddles[current_riddle]) {
        // 记录已答题
        me->add("huadeng/riddle/" + this_object()->query("id"), 1);
        
        command("smile");
        command("say 回答正确！给你奖励！");
        
        // 奖励意境卷轴残页
        amount = 1 + random(2); // 1-2张
        for(int i = 0; i < amount; i++) {
            ob = new_bind("/clone/aoyi_book/aoyi_book_canye");
            ob->move(me);
        }
        tell_object(me, HIY"你获得了" + chinese_number(amount) + "张" + 
            ob->query("name") + "！"NOR"\n");
        
        // 奖励绑定元宝
        me->add("yuanbao", 10);
        tell_object(me, HIY"你获得了10点绑定元宝！"NOR"\n");
        
        current_riddle = 0;
        return 1;
    }
    
    command("shake");
    command("say 答错了，再想想看！");
    return 1;
}

// 重置玩家答题记录
void reset_riddle()
{
    object *users = users();
    foreach(object user in users) {
        user->delete("huadeng/riddle");
    }
} 