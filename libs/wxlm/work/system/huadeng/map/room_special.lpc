inherit "/system/huadeng/map/room_base";

// 宝箱状态
private int chest_opened = 0;

// 预先函数声明
private string look_chest();
private int do_open(string arg);

void create()
{
    ::create();
    
    // 修改房间描述
    set("long", @LONG
这里是一处极为特别的所在，四周悬挂着无数精美绝伦的花灯，将整个空间
映照得如同仙境一般。正中央放置着一个雕刻精美的宝箱，上面镶嵌着各色
宝石，在灯光的照耀下熠熠生辉。空气中弥漫着一股神秘的气息。
LONG);
    
    // 设置房间特有的物品描述
    set("item_desc", ([
        "花灯" : "这些花灯精美绝伦，每一盏都价值连城。\n",
        "灯" : "这些花灯精美绝伦，每一盏都价值连城。\n",
        "宝箱" : (: look_chest :),
    ]));
}

void init()
{
    ::init();
    add_action("do_open", "open");
}

// 查看宝箱
string look_chest()
{
    if(chest_opened)
        return popup_comb("宝箱已经被打开了，里面空空如也。", ({"返回:look"}));
    else
        return popup_comb("这是一个雕刻精美的宝箱，上面镶嵌着各色宝石。\n你要打开它吗？", 
            ({"打开:open 宝箱", "返回:look"}));
}

// 打开宝箱
int do_open(string arg)
{
    object me = this_player();
    object ob;
    int i, amount;
    
    if(!arg || (arg != "宝箱" && arg != "chest"))
        return 0;
        
    if(chest_opened)
        return notify_fail("宝箱已经被打开了。\n");
        
    // 打开宝箱
    chest_opened = 1;
    
    message_vision(HIY"$N小心翼翼地打开了宝箱。"NOR"\n", me);
    
    // 奖励意境卷轴残页
    amount = 3 + random(3); // 3-5张
    for(i = 0; i < amount; i++) {
        ob = new_bind("/clone/aoyi_book/aoyi_book_canye");
        ob->move(me);
    }
    tell_object(me, HIY"你获得了" + chinese_number(amount) + "张" + 
        ob->query("name") + "！"NOR"\n");
    
    // 额外奖励
    // 1. 绑定元宝
    me->add("yuanbao", 10);
    tell_object(me, HIY"你获得了10点绑定元宝！"NOR"\n");
    
    // 2. 随机特殊物品
    if(random(100) < 30) { // 30%概率获得特殊物品
        string *special_items = ({
            "/clone/vip/tianxiang",    // 天香玉露
            "/clone/aoyi_book/aoyi_book_canye"       // 意境卷轴残页
        });
        ob = new_bind(special_items[random(sizeof(special_items))]);
        ob->move(me);
        tell_object(me, HIY"你还获得了一" + ob->query("unit") + 
            ob->query("name") + "！"NOR"\n");
    }
    
    return 1;
}

// 重写搜索函数
int do_search(string arg)
{
    object me = this_player();
    
    if(!chest_opened) {
        tell_object(me, "这里有一个宝箱，也许应该先打开它。\n");
        return 1;
    }

    //检查是否已经被搜索过
    if(query("huadeng/search"))
    {
        return notify_fail("这里已经被搜索过了。\n");
    }
    
    if(random(100) < 30) { // 30%的概率获得意境卷轴残页
        object ob = new_bind("/clone/aoyi_book/aoyi_book_canye");
        ob->move(me);
        tell_object(me, HIY"你在花灯下发现了一张" + ob->query("name") + "！"NOR"\n");

        //设置已经被搜索过了
        set("huadeng/search", 1);
        return 1;
    }
    
    return ::do_search(arg);
} 