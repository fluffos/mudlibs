inherit "/system/huadeng/map/room_base";

void create()
{
    // 创建花灯傀儡
    object npc = new("/system/huadeng/npc/huadeng_kuilei");

    ::create();

    // 修改房间描述
    set("long", @LONG
这里的花灯忽明忽暗，散发着诡异的光芒。空气中弥漫着一丝紧张的气息，
似乎有什么东西在暗处窥视着。四周的花灯投射出奇异的影子，让人不由得
提高了警惕。
LONG);
    

    
    // 设置房间特有的物品描述
    set("item_desc", ([
        "花灯" : popup_title("这些花灯看起来有些诡异，似乎隐藏着某种危险。"),
        "灯" : popup_title("这些花灯看起来有些诡异，似乎隐藏着某种危险。"),
    ]));

    if(npc) npc->move(this_object());

    setup();

}

// 重写搜索函数，增加获得意境卷轴残页的概率
int do_search(string arg)
{
    object me = this_player();
    object *inv;
    //检查是否已经被搜索过
    if(query("huadeng/search"))
    {
        return notify_fail("这里已经被搜索过了。\n");
    }
    // 检查房间内是否还有花灯傀儡
    inv = all_inventory(this_object());
    foreach(object ob in inv) {
        if(ob->query("id") == "huadeng kuilei") {
            tell_object(me, "这里太危险了，还是先解决掉花灯傀儡再说吧！\n");
            return 1;
        }
    }
    
    if(random(100) < 15) { // 15%的概率获得意境卷轴残页
        object ob = new_bind("/clone/aoyi_book/aoyi_book_canye");
        ob->move(me);
        tell_object(me, HIY"你在花灯下发现了一张" + ob->query("name") + "！"NOR"\n");
        //设置已经被搜索过
        set("huadeng/search", 1);
        return 1;
    }
    
    return ::do_search(arg);
}

// 重写init函数，增加战斗相关的处理
void init()
{
    object me = this_player();
    object *inv;
    
    ::init();
    
    // 检查房间内的花灯傀儡
    inv = all_inventory(this_object());
    foreach(object ob in inv) {
        if(ob->query("id") == "huadeng kuilei" && living(ob)) {
            ob->kill_ob(me);
            break;
        }
    }
} 