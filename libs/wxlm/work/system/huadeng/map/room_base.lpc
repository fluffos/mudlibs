#include <room.h>


inherit ROOM;

// 房间描述列表
nosave string *descs = ({
    "这里张灯结彩，到处都是绚丽的花灯，空气中弥漫着喜庆的气息。",
    "各式各样的花灯将这里装点得如同人间仙境，令人目不暇接。",
    "一盏盏精美的花灯散发着柔和的光芒，将四周映照得如梦如幻。",
    "这里悬挂着众多造型独特的花灯，每一盏都诉说着不同的故事。",
    "五彩缤纷的花灯将夜空点缀得格外美丽，让人流连忘返。"
});

void create()
{
    set("short", HIW"花灯迷境"NOR);
    set("long", descs[random(sizeof(descs))]);
    
    set("no_clean_up", 1);
    set("no_sleep", 1);
    
    setup();
}

void init()
{
    // 进入房间后忙乱1秒
    this_player()->start_busy(1);
    
    add_action("do_search", "search");
}


int do_search(string arg)
{
    object me = this_player();
    
    if(random(100) < 10) { // 10%的概率获得奖励
        object ob = new("/clone/money/silver");
        ob->set_amount(1);
        ob->move(me);
        tell_object(me, "你在花灯下发现了一些" + ob->query("name") + "。\n");
        return 1;
    }
    
    tell_object(me, "你仔细搜索了一番，但是什么都没有发现。\n");
    return 1;
}

// 设置房间出口
void set_exits(mapping exits)
{
    set("exits", exits);
}

// 添加临时出口
void add_temp_exit(string dir, string dest)
{
    add_temp("exits", ([dir : dest]));
}

varargs void remove(string euid)
{
    // 所有当前地图的玩家传送到客店
    object *players = all_inventory(this_object());

    players  = filter_array(players, (: playerp($1) :));

    foreach(object player in players) {
        player->move("/d/city/kedian");
        tell_object(player, HIY"活动结束，你被传送到了客店。\n"NOR);
    }
}