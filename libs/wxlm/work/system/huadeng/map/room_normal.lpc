inherit "/system/huadeng/map/room_base";

void create()
{
    ::create();
    
    // 30%的概率出现灯谜童子

    if(random(100) < 30) {
        object npc = new("/system/huadeng/npc/dengmi_tongzi");

        if(npc)
        {
            npc->move(this_object());
        }
    }
    
    // 设置房间特有的物品描述
    set("item_desc", ([
    "花灯" : popup_title("这里的花灯造型各异，有的是传统的莲花灯，有的是栩栩如生的动物灯。"),
    "灯" : popup_title("这里的花灯造型各异，有的是传统的莲花灯，有的是栩栩如生的动物灯。"),
    ]));
}

// 重写搜索函数，增加获得意境卷轴残页的概率
int do_search(string arg)
{
    object me = this_player();
    //检查是否已经被搜索过
    if(query("huadeng/search"))
    {
        return notify_fail("这里已经被搜索过了。\n");
    }
    if(random(100) < 5) { // 5%的概率获得意境卷轴残页
        object ob = new_bind("/clone/aoyi_book/aoyi_book_canye");
        ob->move(me);
        tell_object(me, HIY"你在花灯下发现了一张" + ob->query("name") + "！"NOR"\n");
        //设置已经被搜索过
        set("huadeng/search", 1);
        return 1;
    }
    
    return ::do_search(arg);
}