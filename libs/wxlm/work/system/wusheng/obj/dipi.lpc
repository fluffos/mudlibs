// dipi.c 地脾黄

#include "herb.h"

void create()
{
	set_name(YEL "地脾黄" NOR, ({ "dipi", "herb_dipi", "di pi huang" }));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", YEL "这是一块黄澄澄的地脾黄，蕴含着大地的根基之力，" NOR
		           "是炼体强化脾脏的珍贵材料。\n");
		set("base_unit", "块");
		set("base_value", 50000);
		set("base_weight", 300);
		set("wusheng_material", "spleen");
	}
	setup();
} 