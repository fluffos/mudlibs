// chuji_lianti_dan.c 基础炼体丹

#include "medicine.h"

void create()
{
	set_name(HIW "基础炼体丹" NOR, ({"chuji lianti dan", "lianti dan", "dan"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "这是一颗白色的炼体丹，散发着淡淡的药香，" 
		           "可以提升武圣之躯炼体的成功率。\n");
		set("base_unit", "颗");
		set("base_value", 100000);
		set("no_sell", 1);
		set("base_weight", 50);
		set("wusheng_dan_type", "chuji");
		set("wusheng_dan_boost", 10); // 提升10%成功率
	}
	setup();
} 