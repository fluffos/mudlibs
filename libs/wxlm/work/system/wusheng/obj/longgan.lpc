// longgan.c 龙肝草

#include "herb.h"

void create()
{
	set_name(GRN "龙肝草" NOR, ({ "longgan", "herb_longgan", "long gan cao" }));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", GRN "这是一株翠绿的龙肝草，传说蕴含着龙族的力量精华，" NOR
		           "是炼体强化肝脏的珍贵材料。\n");
		set("base_unit", "株");
		set("base_value", 50000);
		set("base_weight", 150);
		set("wusheng_material", "liver");
	}
	setup();
} 