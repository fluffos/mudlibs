// zhongji_lianti_dan.c 中级炼体丹

#include "medicine.h"

void create()
{
	set_name(HIG "中级炼体丹" NOR, ({"zhongji lianti dan", "lianti dan", "dan"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "这是一颗绿色的炼体丹，散发着浓郁的药香，" 
		           "可以大幅提升武圣之躯炼体的成功率。\n");
		set("base_unit", "颗");
		set("base_value", 200000);
		set("no_sell", 1);
		set("base_weight", 50);
		set("wusheng_dan_type", "zhongji");
		set("wusheng_dan_boost", 10); // 提升10%成功率
	}
	setup();
} 