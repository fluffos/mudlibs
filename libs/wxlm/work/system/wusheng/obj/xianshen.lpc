// xianshen.c 仙肾石

#include "herb.h"

void create()
{
	set_name(BLU "仙肾石" NOR, ({ "xianshen", "herb_xianshen", "xian shen shi" }));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", BLU "这是一块蓝色的仙肾石，内蕴深邃的潜能之力，" NOR
		           "是炼体强化肾脏的珍贵材料。\n");
		set("base_unit", "块");
		set("base_value", 50000);
		set("base_weight", 250);
		set("wusheng_material", "kidney");
	}
	setup();
} 