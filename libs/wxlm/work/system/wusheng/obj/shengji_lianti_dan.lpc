// shengji_lianti_dan.c 圣级炼体丹

#include "medicine.h"

void create()
{
	set_name(HIR "圣级炼体丹" NOR, ({"shengji lianti dan", "lianti dan", "dan"}));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "这是一颗红色的炼体丹，散发着神圣的光芒，" 
		           "可以极大提升武圣之躯炼体的成功率。\n");
		set("base_unit", "颗");
		set("base_value", 1000000);
		set("no_sell", 1);
		set("base_weight", 50);
		set("wusheng_dan_type", "shengji");
		set("wusheng_dan_boost", 10); // 提升10%成功率
	}
	setup();
} 