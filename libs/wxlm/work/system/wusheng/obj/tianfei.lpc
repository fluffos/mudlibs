// tianfei.c 天肺莲

#include "herb.h"

void create()
{
	set_name(WHT "天肺莲" NOR, ({ "tianfei", "herb_tianfei", "tian fei lian" }));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", WHT "这是一朵洁白如雪的天肺莲，散发着清香的气息，" NOR
		           "是炼体强化肺脏的珍贵材料。\n");
		set("base_unit", "朵");
		set("base_value", 50000);
		set("base_weight", 100);
		set("wusheng_material", "lung");
	}
	setup();
} 