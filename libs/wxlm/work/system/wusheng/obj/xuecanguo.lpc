// xuecanguo.c 血参果

#include "herb.h"

void create()
{
	set_name(RED "血参果" NOR, ({ "xuecanguo", "herb_xuecanguo", "xue can guo" }));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", RED "这是一颗血红色的参果，蕴含着强大的生命精华，" NOR
		           "是炼体强化心脏的珍贵材料。\n");
		set("base_unit", "颗");
		set("base_value", 50000);
		set("base_weight", 200);
		set("wusheng_material", "heart");
	}
	setup();
} 