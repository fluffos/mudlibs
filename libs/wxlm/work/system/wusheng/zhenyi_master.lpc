#include "zhenyi/utils/zhenyi_helpers.h"    // 辅助工具

// 引入管理模块
#include "zhenyi/managers/wuyun_manager.h"  // 武蕴管理

// 引入原有功能模块
#include "zhenyi/zhenyi_config.h"           // 真意配置
#include "zhenyi/zhenyi_core.h"             // 核心功能模块
#include "zhenyi/zhenyi_generator.h"        // 真意生成器模块
#include "zhenyi/zhenyi_equipment.h"        // 装备管理模块
#include "zhenyi/zhenyi_bag.h"              // 背包管理模块
#include "zhenyi/zhenyi_bonus.h"            // 属性加成模块
#include "zhenyi/zhenyi_synthesis.h"        // 合成系统模块
#include "zhenyi/zhenyi_decomposition.h"    // 分解系统模块
#include "zhenyi/zhenyi_scheme.h"           // 方案管理模块
#include "zhenyi/zhenyi_utils.h"            // 工具函数模块（保留兼容）

/**
 * @brief 初始化函数
 * @details 设置系统权限
 */
void create()
{
    seteuid(getuid());
}

/**
 * @brief 模块化重构说明
 * @details 
 * 原始的 zhenyi_master.c 文件包含了武圣真意系统的所有功能，
 * 现已按功能模块进行拆分，提高代码的可维护性和可读性。
 * 
 * 架构设计原则：
 * 1. 单一入口：所有模块只在 zhenyi_master.c 中引入
 * 2. 函数原型预声明：避免模块间循环引用问题
 * 3. 按功能职责划分：每个模块负责特定的功能领域
 * 4. 保持模块间的低耦合，高内聚
 * 5. 统一的错误处理和日志记录机制
 * 
 * 模块说明：
 * - zhenyi_config.h: 系统配置和常量定义
 * - zhenyi_core.h: 核心功能（槽位计算、等级查询等）
 * - zhenyi_generator.h: 真意生成器（品质生成、效果生成等）
 * - zhenyi_equipment.h: 装备管理（装备、卸下、查询等）
 * - zhenyi_bag.h: 背包管理（添加、移除、筛选等）
 * - zhenyi_bonus.h: 属性加成（计算、应用、查询等）
 * - zhenyi_synthesis.h: 合成系统（验证、执行、历史等）
 * - zhenyi_utils.h: 工具函数（验证、日志、统计等）
 * 
 * 使用方式：
 * 外部系统可以直接调用 zhenyi_master.c 中的函数，
 * 函数实现会自动从相应的模块中加载。
 * 
 * 重构优势：
 * 1. 提升代码可维护性：功能模块化，便于定位和修改
 * 2. 增强可读性：每个模块职责明确，代码结构清晰
 * 3. 提高开发效率：可以并行开发不同模块
 * 4. 保持接口兼容性：外部调用方式不变
 * 5. 统一错误处理：集中的日志和错误管理
 */
