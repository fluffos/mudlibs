#include "/system/wusheng/zhenyi/zhenyi_config.h"
int query_zhenyi_level(object player);
int add_zhenyi_to_bag(object player, mapping zhenyi_data);
#include "/system/wusheng/zhenyi/zhenyi_generator.h"

int query_zhenyi_level(object player)
{
    return ZHENYI_MASTER->query_zhenyi_level(player);
}

int add_zhenyi_to_bag(object player, mapping zhenyi_data)
{
    return ZHENYI_MASTER->add_zhenyi_to_bag(player, zhenyi_data);
}

/**
 * @brief 测试保底机制
 * @param object player 测试玩家对象
 * @return void
 * @details 模拟连续掉落低品质真意，验证保底机制是否正常工作
 */
void test_baodi_mechanism(object player)
{
    string quality;
    int i, low_count, blue_above_count;
    
    if (!player || !objectp(player))
    {
        write("错误：需要有效的玩家对象进行测试。\n");
        return;
    }
    
    write("开始测试武圣真意保底机制...\n");
    write("测试玩家：" + player->query("name") + "\n\n");
    
    // 重置计数器
    player->set("zhenyi/low_quality_count", 0);
    low_count = 0;
    blue_above_count = 0;
    
    // 模拟50次掉落
    for (i = 1; i <= 50; i++)
    {
        quality = generate_random_quality(player);
        
        if (is_quality_below_blue(quality))
        {
            low_count++;
            write(sprintf("第%d次：%s（蓝色以下）- 当前连续低品质次数：%d\n", 
                i, quality, player->query("zhenyi/low_quality_count")));
        }
        else
        {
            blue_above_count++;
            write(sprintf("第%d次：%s（蓝色及以上）- 保底计数已重置\n", i, quality));
        }
        
        // 检查保底机制是否正常工作
        if (i % 30 == 0)
        {
            write(sprintf("--- 第%d次统计 ---\n", i));
            write(sprintf("蓝色以下品质总数：%d\n", low_count));
            write(sprintf("蓝色及以上品质总数：%d\n", blue_above_count));
            write(sprintf("当前连续低品质计数：%d\n\n", player->query("zhenyi/low_quality_count")));
        }
    }
    
    write("测试完成！\n");
    write(sprintf("总计：蓝色以下 %d 次，蓝色及以上 %d 次\n", low_count, blue_above_count));
}

/**
 * @brief 测试强制触发保底机制
 * @param object player 测试玩家对象
 * @return void
 * @details 直接设置计数为29，测试第30次是否必出蓝色以上
 */
void test_force_baodi(object player)
{
    string quality;
    int i;
    
    if (!player || !objectp(player))
    {
        write("错误：需要有效的玩家对象进行测试。\n");
        return;
    }
    
    write("开始测试强制触发保底机制...\n");
    write("测试玩家：" + player->query("name") + "\n\n");
    
    // 设置计数为29，下次必出蓝色以上
    player->set("zhenyi/low_quality_count", 29);
    write("已设置连续低品质计数为29次\n");
    
    // 测试接下来的5次掉落
    for (i = 1; i <= 5; i++)
    {
        quality = generate_random_quality(player);
        
        if (is_quality_below_blue(quality))
        {
            write(sprintf("第%d次：%s（蓝色以下）- 当前计数：%d\n", 
                i, quality, player->query("zhenyi/low_quality_count")));
        }
        else
        {
            write(sprintf("第%d次：%s（蓝色及以上）- 保底触发成功！计数已重置为：%d\n", 
                i, quality, player->query("zhenyi/low_quality_count")));
        }
    }
    
    write("强制保底测试完成！\n");
}