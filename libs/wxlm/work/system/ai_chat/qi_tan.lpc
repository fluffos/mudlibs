mapping fd_to_msg;

mapping mlist = ([
	"丐帮"     : CLASS_D("gaibang")  + "/hong.lpc",
	"全真教"   : CLASS_D("quanzhen") + "/ma.lpc",
	"峨嵋派"   : CLASS_D("emei")     + "/miejue.lpc",
	"古墓派"   : CLASS_D("gumu")     + "/longnv.lpc",
	"华山派"   : CLASS_D("huashan")  + "/yue-buqun.lpc",
	"灵鹫宫"   : CLASS_D("lingjiu")  + "/xuzhu.lpc",
	"少林派"   : CLASS_D("shaolin")  + "/xuan-ci.lpc",
	"神龙教"   : CLASS_D("shenlong") + "/hong.lpc",
	"桃花岛"   : CLASS_D("taohua")   + "/huang.lpc",
	"武当派"   : CLASS_D("wudang")   + "/zhang.lpc",
	"逍遥派"   : CLASS_D("xiaoyao")  + "/suxingh.lpc",
	"星宿派"   : CLASS_D("xingxiu")  + "/ding.lpc",
	"血刀门"   : CLASS_D("xuedao")   + "/laozu.lpc",
	"雪山寺"   : CLASS_D("xueshan")  + "/jiumozhi.lpc",
	"云龙门"   : CLASS_D("yunlong")  + "/chen.lpc",
	"段氏皇族" : CLASS_D("duan")     + "/duanzc.lpc",
	"慕容世家" : CLASS_D("murong")   + "/murongbo.lpc",
	"欧阳世家" : CLASS_D("ouyang")   + "/ouyangfeng.lpc",
	"关外胡家" : CLASS_D("hu")       + "/hufei.lpc",
	"华山剑宗" : CLASS_D("huashan")  + "/feng-buping.lpc",
	"明教" 		: CLASS_D("mingjiao")  + "/zhangwuji.lpc",
	"日月神教" : "/d/heimuya/npc/zhang1.lpc",
	"白帝城"   : "/d/baidicheng/npc/jikang.lpc",
	"魔教":CLASS_D("mojiao") + "/liuruosong.lpc",
	"四象门"   : "/d/sixiang_men/npc/wuji.lpc",
    "移花宫"   : CLASS_D("yihua") + "/yaoyue.lpc",
]);
void on_read(int fd, string msg)
{
    fd_to_msg[fd] += sprintf("%s", msg);
}

void on_write(int fd)
{
    debug_message(sprintf("on_write: %d \n", fd));
}

void on_close(int fd)
{

    string msg = fd_to_msg[fd];
    message("channel:rumor", HIR"【奇谈】"NOR +  msg + "\n", users());
    map_delete(fd_to_msg, fd);
}

int main()
{
    int fd;
    int CURL_CMD = 2;

    
    {
        string arg;
        string ob_path = random_element(values(mlist));

        // if (!arg) arg = "ai_role_simple.py 逍遥子" + " " + "眼前此人须眉皆白，看不出有多老。然而似乎身染重疾，行动不便。虽然如此，从眉宇仍然看得出此人当年必然是一位风流倜傥的美男子。想不到今天沦落到这地步，真是世事难料";
        arg = sprintf("ai_role_simple.py %s %s",ob_path->query("name"),ob_path->query("long"));

        // 将参数转换为GBK编码
        if (__ARCH__ == "Microsoft Windows") {
            buffer xxx = string_encode(arg,"gbk");
            arg = read_buffer(xxx);
        }

        fd = external_start(CURL_CMD,arg, "on_read", "on_write", "on_close");
    }

    if (!fd_to_msg)
    {
        fd_to_msg = ([ ]);
    }

    fd_to_msg[fd] = "";

    return 1;
}