/**
 * @brief 愚人节整蛊活动系统
 * @author Lu dexiang
 * @date 2023-04-01
 * @details 这是一个愚人节整蛊活动系统，每天16:00至21:00开放
 */



inherit F_DBASE;

// 整蛊道具列表
mapping fool_items = ([
    "huyan fu" : "胡言乱语符",
    "banana" : "大力香蕉",
    "dance fu" : "内功蹦迪符",
    "xue fu" : "点穴后遗症符",
    "fake wine" : "假酒",
    "yangsheng fu" : "老年养生操符",
    "plaza dance" : "广场舞",
]);

private void do_yangsheng_fu(object me, object target);
private void do_plaza_dance(object me, object target);
private void do_huyan_fu(object me, object target);
private void do_banana(object me, object target);
private void do_dance_fu(object me, object target);
private void do_xue_fu(object me, object target);
private void do_fake_wine(object me, object target);

// 是否活动时间
private int is_active_time()
{
    mixed *local;
    int hour;
    
    return 1;

    local = localtime(time());
    hour = local[2]; // 当前小时
    
    // return (hour >= 16 && hour < 21);
    return 1;
}

// 检查是否可以使用整蛊道具
public int can_use_fool_item(object me, object target, string item_id)
{
    // 检查活动时间
    if (!is_active_time())
    {
        tell_object(me, "愚人节整蛊活动只在每天16:00至21:00开放！\n");
        return 0;
    }
    
    // 检查道具是否存在
    if (member_array(item_id, keys(fool_items)) == -1)
    {
        tell_object(me, "没有这种整蛊道具！\n");
        return 0;
    }
    
    // 检查对象是否在线
    if (!target || !objectp(target))
    {
        tell_object(me, "没有这个人！\n");
        return 0;
    }

    //是否是玩家
    if (playerp(target) && !userp(target))
    {
        tell_object(me, "对方断线了，这样做不好！\n");
        return 0;
    }
    
    // 检查对象是否忙碌
    if (target->is_busy())
    {
        tell_object(me, "对方正忙着呢，不能整蛊！\n");
        return 0;
    }
    
    return 1;
}

// 获取整蛊道具列表
public mapping query_fool_items()
{
    return fool_items;
}

// 执行整蛊效果
public void do_fool(object me, object target, string item_id)
{
    int success;
    
    // 50%成功率
    success = random(2);
    
    if (!success)
    {
        // 整蛊失败
        tell_object(me, "你的整蛊失败了！\n");
        
        // 如果对方是玩家，通知对方
        if (userp(target))
        {
            tell_object(target, HIG + me->name() + "想要整蛊你，但是失败了！\n" + NOR);
        }
        return;
    }

    me->add("foolday_success", 1);
    
    // 根据不同道具执行不同效果
    switch (item_id)
    {
        case "huyan fu": // 胡言乱语符
            do_huyan_fu(me, target);
            break;
        case "banana": // 大力香蕉
            do_banana(me, target);
            break;
        case "dance fu": // 内功蹦迪符
            do_dance_fu(me, target);
            break;
        case "xue fu": // 点穴后遗症符
            do_xue_fu(me, target);
            break;
        case "fake wine": // 假酒
            do_fake_wine(me, target);
            break;
        case "yangsheng fu": // 老年养生操符
            do_yangsheng_fu(me, target);
            break;
        case "plaza dance": // 广场舞
            do_plaza_dance(me, target);
            break;
        default:
            tell_object(me, "未知的整蛊道具！\n");
            break;
    }
}

// 胡言乱语符效果
private void do_huyan_fu(object me, object target)
{
    string *msg = ({
        "我刚刚打了个喷嚏，把长城给吹倒了！",
        "我昨晚做梦梦到自己变成了龙，早上醒来发现尾巴还没收回去！",
        "我其实是隐藏版的武林至尊，只是懒得称霸江湖！",
        "刚才有条鲤鱼跳过龙门，变成龙后第一件事就是来找我借钱！",
        "我一掌拍死了一只蚊子，结果它临死前对我说：'大侠饶命'！",
        "我昨天用内力煮了壶开水，结果水喝完了杯子也被我煮化了！",
        "我其实修炼了千年，只是为了等到今天来告诉你这个秘密！",
        "我刚才不小心打了个喷嚏，把自己的内力都喷没了！",
        "刚才菩提老祖托梦给我，说我是他失散多年的亲传弟子！",
        "我其实会飞，只是怕吓到你们才一直走路的！",
        "我一个眼神就能让敌人武功尽失，只是我觉得太残忍了从不用！",
        "其实我掌握了能让人长生不老的九阴真经秘籍，只是忘记带出来了！",
        "我昨天不小心在树上睡着了，一觉醒来树已经长成了参天大树！",
        "刚才有位老者传授我太极拳，我一学就会，他非要拜我为师！",
        "我前天钓鱼时不小心钓到了东海龙王，他对我千恩万谢才放他回去！",
        "其实我的真实年龄已有五百岁，只是我用内功修炼保持年轻！",
        "我上次练功时不小心震断了昆仑山的一座山峰！",
        "其实我是张三丰的亲传弟子，只是我不想让别人知道！",
        "我上次用剑气削苹果，不小心把整棵苹果树都切成了丝！",
        "我练功走火入魔时，天上下起了七彩雨，方圆百里的花草都开了！",
        "我有一把能斩断一切的宝剑，只是太锋利了怕伤到自己从不用！",
        "昨晚我梦游时写了一部绝世武功秘籍，早上醒来发现全忘了！",
        "我的轻功这么好，前天从北京跑到西安只用了半个时辰！",
        "我不小心对着湖面打了个喷嚏，湖水都被我吹干了！",
        "我能听懂动物说话，刚才一只麻雀告诉我有人要害我！",
        "我曾经一拳打死过一头老虎，老虎临死前认我做大哥！",
        "我用内力做成的饭菜能让人增加百年功力，可惜我只做给自己吃！",
        "我的真气能让枯木逢春，昨天摸了一下枯树，今天就开花结果了！",
        "我一掌能拍死一头大象，只是我仁慈，不忍心下手！",
        "我曾徒手接住过从天而降的陨石，还用它打造了一把无敌的宝剑！"
    });
    
    // 互动类胡言乱语消息
    string *interaction_msg = ({
        "对$N深情地说：自从遇见你，我的内力每天都涨十年功力！",
        "对$N含情脉脉地说：我愿意用我的九阳神功为你挡下所有的危险！",
        "对$N单膝跪地说：我可以用一根手指托起五岳山脉，却托不起你在我心中的位置！",
        "对$N真诚地说：我已经把降龙十八掌改成了爱你十八掌！",
        "对$N深情告白：我的轻功能踏遍天下无敌手，却无法逃离对你的思念！",
        "对$N动情地说：我闭关千年就是为了等你这一世相遇！",
        "对$N羞涩地说：菩提老祖曾说，我这一生唯一的克星就是你！",
        "对$N认真地说：我上次打坐时遇到如来佛祖，他说你前世是我的有缘人！",
        "对$N深情款款地说：我宁愿放弃武林至尊的位置，也不愿错过与你的一面之缘！",
        "对$N严肃地说：其实你不知道，你的真实身份是失散多年的武林盟主！",
        "对$N大声喊道：我是你失散多年的儿子啊，爸爸你不记得了嘛！",
        "对$N神秘地说：其实你是武林中失踪已久的绝世高手，只是你自己不知道！",
        "对$N激动地说：我刚刚在梦中见到了你的前世，你是个盖世英雄！",
        "对$N惊讶地说：你知道吗？你其实是皇室的后裔，只是被遗落在民间！",
        "对$N认真地说：我刚刚用天眼通看到了你的未来，你将成为一代宗师！",
        "对$N兴奋地说：我刚刚发现了一本古籍，上面记载了你是千年一遇的奇才！",
        "对$N神秘兮兮地说：其实你是天选之人，肩负着拯救武林的重任！",
        "对$N感叹道：我刚刚在山顶修炼时，看到你的身影出现在云端，你是天神下凡！",
        "对$N惊呼：你知道吗？你其实是传说中的龙的传人，只是你自己还不知道！",
        "对$N激动地说：我刚刚在古墓中发现了一块石碑，上面刻着你的名字，你是古代大侠的后人！",
        "对$N惊呼，五体投地：陛下，奴才终于找到你了！",
        "对$N嘿嘿一笑：乖宝宝，你就从了本大爷吧！"
    });

    object *ob_list = users();
    object random_target;
    string output_msg;
    
    // 随机选择互动类消息或普通消息
    if (random(2) && sizeof(ob_list) > 1) // 50%概率使用互动消息，且确保在线玩家数大于1
    {
        // 随机选择一个不是使用者自己的玩家
        do {
            random_target = ob_list[random(sizeof(ob_list))];
        } while (random_target == me && sizeof(ob_list) > 1);
        
        // 替换消息中的$N为目标玩家名
        output_msg = interaction_msg[random(sizeof(interaction_msg))];
        output_msg = replace_string(output_msg, "$N", random_target->name());
        
        tell_object(me, HIY"你对" + target->name() + "甩出了一张闪闪发光的符咒，符咒变成一只金色蝴蝶，在空中飞舞后钻入了" + target->name() + "的脑门！\n"NOR);
        tell_object(target, HIY + me->name() + "对你扔出一张符咒，符咒化作金光钻入你的脑门，你感觉脑中像有千万只蚂蚁在爬，忍不住开始胡言乱语！\n" + NOR);
        tell_room(environment(me), HIY + me->name() + "对" + target->name() + "甩出一张闪闪发光的符咒，符咒在空中划出一道金色弧线后，变成一只蝴蝶钻入" 
            + target->name() + "的脑门，" + target->name() + "双眼冒出金星，舌头打结，开始说起胡话！\n" + NOR);
        
        // 被符咒影响的人会对随机玩家说胡言乱语
        target->force_me("chat " + target->name() + output_msg);
    }
    else
    {
        tell_object(me, HIY"你对" + target->name() + "甩出了一张闪闪发光的符咒，符咒变成一只金色蝴蝶，在空中飞舞后钻入了" + target->name() + "的脑门！\n"NOR);
        tell_object(target, HIY + me->name() + "对你扔出一张符咒，符咒化作金光钻入你的脑门，你感觉脑中像有千万只蚂蚁在爬，忍不住开始胡言乱语！\n" + NOR);
        tell_room(environment(me), HIY + me->name() + "对" + target->name() + "甩出一张闪闪发光的符咒，符咒在空中划出一道金色弧线后，变成一只蝴蝶钻入" 
            + target->name() + "的脑门，" + target->name() + "双眼冒出金星，舌头打结，开始说起胡话！\n" + NOR);
        
        // 使用普通胡言乱语
        target->force_me("chat " + msg[random(sizeof(msg))]);
    }
}

// 大力香蕉效果
private void do_banana(object me, object target)
{
    int busy_time;
    
    
    busy_time = 1 + random(5); // 1-5秒忙乱
    
    tell_object(me, HIY"你神秘地从怀中掏出一根闪着金光的大香蕉，悄悄地甩向" + target->name() + "的脚下！\n"NOR);
    tell_object(target, HIY + me->name() + "不知从哪儿变出一根金光闪闪的香蕉皮，你还没反应过来，脚下一滑，整个人腾空而起，在空中转了三圈半，然后砰地一声四脚朝天摔在地上，星星从眼前飘过！\n" + NOR);
    tell_room(environment(me), HIY + me->name() + "像变魔术一样从怀中掏出一根金光闪闪的大香蕉皮，悄悄地扔到" 
        + target->name() + "脚下，只见" + target->name() + "一脚踩上，整个人腾空而起，在空中划出一道优美的弧线，然后四脚朝天狠狠地摔在地上，周围响起一片哄笑声！\n" + NOR);
    
    // 减少气血
    if (target->query("qi") > 1000)
    {
        target->receive_damage("qi", 1 + random(500));
    }
    
    // 设置忙乱状态
    target->start_busy(busy_time);
}

// 内功蹦迪符效果
private void do_dance_fu(object me, object target)
{
    tell_object(me, HIY"你偷偷地将一张'内功蹦迪符'贴在" + target->name() + "的背上，只见符咒上的墨迹像蚂蚁一样爬入" + target->name() + "的体内！\n"NOR);
    tell_object(target, HIY + me->name() + "对你使用了内功蹦迪符，你突然感觉体内真气不受控制地奔涌，四肢开始不由自主地抽动，脚底像踩了弹簧一样不停地弹跳，身体开始随着一种奇怪的节奏疯狂摇摆！\n" + NOR);
    tell_room(environment(me), HIY + me->name() + "偷偷地将一张符咒贴在" + target->name() + "的背上，符咒瞬间融入衣服，" 
        + target->name() + "突然像被电击了一样跳了起来，双手乱舞，双脚乱蹬，整个人像个失控的陀螺一样疯狂旋转，跳出了一段史上最狂野的蹦迪舞步，引得周围人捧腹大笑！\n" + NOR);
    
    // 减少气血
    if (target->query("qi") > 1000)
    {
        target->receive_damage("qi", 200);
    }
    
    // 设置忙乱状态
    target->start_busy(2);
}

// 点穴后遗症符效果
private void do_xue_fu(object me, object target)
{
    int busy_time;
    
    
    busy_time = 1 + random(7); // 1-7秒忙乱
    
    tell_object(me, HIY"你装模作样地对" + target->name() + "使出一套花哨的点穴手法，最后啪地一声拍出一张'点穴后遗症符'！\n"NOR);
    tell_object(target, HIY + me->name() + "突然对你使出一套眼花缭乱的点穴手法，你的身体各处穴位被点中后，突然感到浑身上下所有肌肉都不受控制，开始做出各种诡异的动作，像是被一个拙劣的木偶师操控的木偶！\n" + NOR);
    tell_room(environment(me), HIY + me->name() + "对" + target->name() + "装模作样地使出一套花哨点穴手法，最后拍出一张符咒，" 
        + target->name() + "突然四肢僵硬，面部肌肉不受控制地抽搐，摆出一个接一个滑稽的表情，时而龇牙咧嘴，时而挤眉弄眼，时而鼓腮吐舌，引得周围人笑声不断！\n" + NOR);
    
    // 减少气血
    if (target->query("qi") > 1000)
    {
        target->receive_damage("qi", 1 + random(1000));
    }
    
    // 设置忙乱状态
    target->start_busy(busy_time);
}

// 假酒效果
private void do_fake_wine(object me, object target)
{
    
    tell_object(me, HIY"你神秘地从怀中掏出一个精致的酒壶，极力推荐" + target->name() + "品尝这'珍藏多年的佳酿'！\n"NOR);
    tell_object(target, HIY + me->name() + "热情地拿出一壶'珍藏佳酿'给你喝，你刚喝下一口，就感觉像吞了一团火，酒气直冲脑门，眼前出现五彩斑斓的幻象，整个世界都开始天旋地转！\n" + NOR);
    tell_room(environment(me), HIY + me->name() + "神秘兮兮地从怀中掏出一个精致的酒壶，极力推荐" + target->name() + "品尝这'珍藏多年的佳酿'，" 
        + target->name() + "刚喝下一口，脸色就由白变红，再由红变紫，最后变成了彩虹色，眼睛像蜗牛的触角一样凸了出来，嘴里吐出一连串酒嗝，每个酒嗝都形成一个彩色泡泡飘向空中！\n" + NOR);
    
    // 减少精神
    if (target->query("jing") > 1000)
    {
        target->receive_damage("jing", 200);
    }
    
    // 设置忙乱状态
    target->start_busy(2);
}

// 老年养生操符效果
private void do_yangsheng_fu(object me, object target)
{
    
    
    tell_object(me, HIY"你偷偷地将一张'老年养生操符'贴在" + target->name() + "的背上，符咒上的墨迹瞬间化作无数银丝钻入" + target->name() + "的体内！\n"NOR);
    tell_object(target, HIY + me->name() + "对你使用了老年养生操符，你突然感觉浑身力气被抽空，体内真气变得像缓慢流动的蜗牛，四肢像灌了铅一样沉重，不由自主地开始做起了极度缓慢的太极动作！\n" + NOR);
    tell_room(environment(me), HIY + me->name() + "偷偷地将一张符咒贴在" + target->name() + "的背上，符咒瞬间化作银光钻入体内，" 
        + target->name() + "的动作突然变得极度缓慢，像是被按下了0.1倍速播放键，开始一招一式地打起了太极拳，每个动作都慢得令人发指，一个简单的挥手都需要半天时间，脸上还带着诡异的'养生'微笑，让人忍俊不禁！\n" + NOR);
    
    // 减少内力
    if (target->query("neili") > 1000)
    {
        target->add("neili", -200);
    }
    
    // 设置忙乱状态
    target->start_busy(2);
}

// 广场舞效果
private void do_plaza_dance(object me, object target)
{
    
    
    tell_object(me, HIY"你神秘地掏出一个微型音响，放出欢快的广场舞音乐，同时向" + target->name() + "甩出一张符咒！\n"NOR);
    tell_object(target, HIY + me->name() + "对你使用了广场舞符咒，你的耳边突然响起魔性的广场舞音乐，身体不由自主地开始扭动，双手在胸前欢快地挥舞，双脚踩着妖娆的舞步，脸上还挂着诡异的微笑！\n" + NOR);
    tell_room(environment(me), HIY + me->name() + "神秘地掏出一个微型音响，放出欢快的广场舞音乐，同时向" + target->name() + "甩出一张符咒，" 
        + target->name() + "被符咒击中后，像是被施了魔法一般，表情瞬间变得欢快起来，双手在胸前欢快地挥舞，身体以一种令人震惊的灵活度开始扭动，跳起了一段极其夸张的广场舞，动作之浮夸，姿势之妖娆，简直让人不忍直视却又无法移开视线！\n" + NOR);
    
    // 减少气血
    if (target->query("qi") > 1000)
    {
        target->receive_damage("qi", 200);
    }
    
    // 设置忙乱状态
    target->start_busy(3);
}

// 获取愚人节活动状态信息
public string query_fool_day_status()
{
    string msg = "";
    
    msg += HIG "愚人节整蛊活动时间：每天16:00至21:00\n" NOR;
    
    if (is_active_time())
        msg += HIY "当前状态：活动进行中\n" NOR;
    else
        msg += HIR "当前状态：活动未开始\n" NOR;
    
    msg += "\n可用整蛊道具：\n";
    foreach (string item_id, string item_name in fool_items)
    {
        msg += sprintf("  %s：%s\n", item_id, item_name);
    }
    
    return msg;
}

// 检查当前是否在活动时间内的公共接口
public int query_is_active_time()
{
    return is_active_time();
}

// 在创建此对象时设置
void create()
{
    seteuid(getuid());
    set("name", "愚人节系统");
    set("id", "fool_day_system");
}

// 返回单例实例
object query_instance()
{
    return this_object();
}

// 随机生成一个整蛊道具
public object random_fool_item()
{
    string *item_ids, selected_id;
    object item;
    
    // 获取所有道具ID列表
    item_ids = list_dirs("/system/fool_day/daoju/*.lpc");


    
    // 随机选择一个道具ID
    selected_id = item_ids[random(sizeof(item_ids))];

    selected_id = "/system/fool_day/daoju/" + selected_id;

    selected_id = replace_string(selected_id, ".lpc", "");
    
    // 创建道具对象
    item = new(selected_id);
    
    if (!objectp(item)) {
        log_file("fool_day", sprintf("无法创建整蛊道具：%s，文件：%s\n", selected_id, selected_id));
        return 0;
    }
    
    
    return item;
}
