/**
 * @brief 点穴后遗症符
 * @author Lu dexiang
 * @date 2023-04-01
 * @details 愚人节整蛊道具，使目标浑身抽搐，忙乱1-7秒
 */



inherit COMBINED_ITEM;

void setup()
{
    set_amount(1);
    ::setup();
}

void create()
{
    set_name(HIY "点穴后遗症符" NOR, ({"xue fu", "xue", "dianxue fu"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("unit", "张");
        set("base_unit", "张");
        set("base_weight", 10);
        set("long", "这是一张符咒，使用后会让目标感觉自己被点了穴道，浑身不听使唤。\n");
        set("value", 10);
        set("no_sell", 1);
        set("no_drop", 1);
        set("fool_item", 1);
    }
    
    setup();
} 