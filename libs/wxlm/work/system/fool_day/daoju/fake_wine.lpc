/**
 * @brief 假酒
 * @author Lu dexiang
 * @date 2023-04-01
 * @details 愚人节整蛊道具，使目标减少精神并忙乱2秒
 */



inherit COMBINED_ITEM;

void setup()
{
    set_amount(1);
    ::setup();
}

void create()
{
    set_name(HIY "假酒" NOR, ({"fake wine", "wine", "jiu", "jiajiu"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("unit", "壶");
        set("base_unit", "壶");
        set("base_weight", 30);
        set("long", "这是一壶看起来普普通通的酒，但饮用后会让人精神恍惚，胡言乱语。\n");
        set("value", 10);
        set("no_sell", 1);
        set("no_drop", 1);
        set("fool_item", 1);
    }
    
    setup();
} 