/**
 * @brief 大力香蕉
 * @author Lu dexiang
 * @date 2023-04-01
 * @details 愚人节整蛊道具，使目标滑倒，忙乱1-5秒
 */



inherit COMBINED_ITEM;

void setup()
{
    set_amount(1);
    ::setup();
}

void create()
{
    set_name(HIY "大力香蕉" NOR, ({"banana", "xiangjiao"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("unit", "根");
        set("base_unit", "根");
        set("base_weight", 20);
        set("long", "这是一根看起来普通的香蕉，但实际上有特殊的整蛊功效。\n");
        set("value", 10);
        set("no_sell", 1);
        set("no_drop", 1);
        set("fool_item", 1);
    }
    
    setup();
} 