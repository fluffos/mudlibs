/**
 * @brief 胡言乱语符
 * @author Lu dexiang
 * @date 2023-04-01
 * @details 愚人节整蛊道具，使目标胡言乱语
 */



inherit COMBINED_ITEM;

void setup()
{
    set_amount(1);
    ::setup();
}

void create()
{
    set_name(HIY "胡言乱语符" NOR, ({"huyan fu", "huyan", "fu"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("unit", "张");
        set("base_unit", "张");
        set("base_weight", 10);
        set("long", "这是一张愚人节活动道具，可以使目标胡言乱语。\n");
        set("value", 10);
        set("no_sell", 1);
        set("no_drop", 1);
        set("fool_item", 1);
    }
    
    setup();
} 