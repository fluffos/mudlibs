/**
 * @brief 老年养生操符
 * @author Lu dexiang
 * @date 2023-04-01
 * @details 愚人节整蛊道具，使目标减少内力并忙乱2秒
 */



inherit COMBINED_ITEM;

void setup()
{
    set_amount(1);
    ::setup();
}

void create()
{
    set_name(HIY "老年养生操符" NOR, ({"yangsheng fu", "yangsheng", "laonian fu"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("unit", "张");
        set("base_unit", "张");
        set("base_weight", 10);
        set("long", "这是一张符咒，使用后会让目标不由自主地开始打太极拳，动作缓慢。\n");
        set("value", 10);
        set("no_sell", 1);
        set("no_drop", 1);
        set("fool_item", 1);
    }
    
    setup();
} 