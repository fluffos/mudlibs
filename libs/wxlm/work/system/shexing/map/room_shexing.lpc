inherit ROOM;

// 房间状态
nosave int room_status = 0;  // 0:正常 1:忙乱 2:中毒 3:容貌减少

// 房间效果持续时间
nosave int effect_time = 0;

// 房间编号
nosave int room_index = 0;

// 设置房间编号
void set_room_index(int index)
{
    room_index = index;
}

// 获取房间编号
int query_room_index()
{
    return room_index;
}

// 设置房间状态
void set_room_status(int status)
{
    room_status = status;
    
    switch(status) {
        case 1: // 忙乱
            effect_time = 10;
            break;
        case 2: // 中毒
            effect_time = 60;
            break;
        default:
            effect_time = 0;
    }
}

// 获取房间状态
int query_room_status()
{
    return room_status;
}

// 房间效果检查
void check_room_effect()
{
    object *obs;
    
    if(effect_time > 0) {
        effect_time--;
        
        if(room_status == 2) { // 中毒状态
            obs = all_inventory(this_object());

            if (!sizeof(obs))
                return;

            foreach(object ob in obs) {
                if(living(ob) && !ob->is_fighting())
                {
                    ob->receive_damage("qi", 100);
                    tell_object(ob, HIR"你突然感到一阵眩晕,原来是中毒了!\n"NOR);
                }
            }
        }

        if(effect_time <= 0) {
            room_status = 0; // 恢复正常
            tell_room(this_object(), HIY"房间的异常状态消失了。\n"NOR);
        }
        
        
        // call_out("check_room_effect", 1);
    }
    else {
        set_room_status(1 + random(2));
    }
}

void heart_beat()
{
    check_room_effect();
}

void init()
{
    object me = this_player();
    
    // 玩家进入时的忙乱效果
    if(living(me) && !me->is_fighting()) {
        me->start_busy(1);
        tell_object(me, HIR"你突然感到一阵眩晕!\n"NOR);
    }
}

void create()
{
    set("short", HIW"【蛇行狸翻】"NOR);
    set("long", @LONG
    这里是蛇行狸翻活动的迷宫房间,四周墙壁上画满了各种蛇形图案,
地面上铺着厚厚的兽皮,走在上面发出轻微的咯吱声。房间的角落里
点着几盏油灯,发出昏黄的光芒。

LONG);
    
    
    set("no_clean_up", 1);
    set_heart_beat(1);
    setup();
}

// 设置房间出口
void set_exits(mapping exits)
{
    set("exits", exits);
}

// 放置特殊物品
void place_special_items()
{
    // 随机放置九转金丹或大葡萄
    if(random(100) < 30) {
        if(random(2)) {
            new("/system/shexing/obj/fake_jiuzhuan")->move(this_object());
        } else {
            new("/system/shexing/obj/fake_putao")->move(this_object());  
        }
    }
}

// 放置NPC
void place_npc()
{
    object npc = new("/system/shexing/npc/sxlm");
    npc->move(this_object());
}
