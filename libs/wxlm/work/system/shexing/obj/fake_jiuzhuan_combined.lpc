/**
 * @file fake_jiuzhuan_combined.c
 * @author 系统
 * @brief 可叠加的假九转金丹
 * @version 1.0
 * @date 2025-09-01
 * 
 * @copyright Copyright (c) 2025
 * 
 */

inherit COMBINED_ITEM;

/**
 * @brief 设置物品数量
 */
void setup()
{
    set_amount(1);
    ::setup();
}

/**
 * @brief 创建物品
 */
void create()
{
    set_name(HIY"九转金丹[假]"NOR, ({"jiuzhuan jindan", "jindan", "dan"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "一颗金光闪闪的九转金丹，不知道是真是假。\n");
        set("base_unit", "颗");
        set("value", 0);
        set("food_remaining", 1);
        set("food_supply", 0);
        set("only_do_effect", 1); // 标识该物品可以使用
    }
    setup();
}

/**
 * @brief 单次使用函数
 * @param object me 使用者
 * @return int 使用结果
 */
int do_effect(object me)
{
    if (!me) return 0;
    
    message_vision("$N一口吞下了" + name() + "。\n", me);
    tell_object(me, HIR"你突然感到一阵剧痛，原来这是假的九转金丹!\n"NOR);
    message("vision", HIR + me->name() + "突然倒在地上，口吐白沫!\n"NOR, 
            environment(me), ({ me }));
    
    me->set("eff_qi", me->query("max_qi") / 2);
    me->set("qi", me->query("eff_qi"));
    
    add_amount(-1);
    return 1;
}

/**
 * @brief 批量使用函数
 * @param object me 使用者
 * @param int amount 使用数量
 * @return int 使用结果
 */
int do_effect_more(object me, int amount)
{
    
    if (!me) return 0;
    if (amount <= 0) return 0;
    if (query_amount() < amount) {
        write("你没有足够的" + name() + "。\n");
        return 0;
    }
    
    message_vision(sprintf("$N一口气吞下了%d颗" + name() + "。\n", amount), me);
    tell_object(me, HIR"你突然感到剧烈的痛苦，原来这些都是假的九转金丹!\n"NOR);
    message("vision", HIR + me->name() + "突然倒在地上，全身抽搐，口吐白沫!\n"NOR, 
            environment(me), ({ me }));
    
    // 根据使用数量加重伤害
    me->set("eff_qi", me->query("max_qi") / (2 + amount / 2));
    me->set("qi", me->query("eff_qi"));
    
    // 如果使用过多，可能会有更严重的后果
    if (amount >= 5) {
        tell_object(me, HIR"大量的假药让你的身体受到了严重损伤!\n"NOR);
        me->set("eff_jing", me->query("max_jing") / 2);
        me->set("jing", me->query("eff_jing"));
    }
    
    add_amount(-amount);
    return 1;
}

/**
 * @brief 不能清除
 * @return int 始终返回1
 */
int clean_up() 
{ 
    return 1; 
}