inherit ITEM;
// inherit F_FOOD;

void create()
{
    set_name(HIY"九转金丹[假]"NOR, ({"jiuzhuan jindan", "jindan", "dan"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "一颗金光闪闪的九转金丹,不知道是真是假。\n");
        set("unit", "颗");
        set("value", 0);
        set("food_remaining", 1);
        set("food_supply", 0);
        set("only_do_effect", 1);
    }
    setup();
}

int do_effect(object me)
{
    message_vision("$N一口吞下了" + name() + "。\n", me);
    tell_object(me, HIR"你突然感到一阵剧痛,原来这是假的九转金丹!\n"NOR);
    message("vision", HIR + me->name() + "突然倒在地上,口吐白沫!\n"NOR, 
            environment(me), ({ me }));
    me->set("eff_qi",me->query("max_qi") / 2);
    me->set("qi",me->query("eff_qi"));
    destruct(this_object());
    return 1;
}

//不能清除
int clean_up() { return 1; }

varargs int move(mixed dest, int raw)
{
    object obj;
    obj = new_bind("/system/shexing/obj/fake_jiuzhuan_combined");
    if (objectp(obj))
    {
        obj->set_amount(1);
        obj->move(dest);
        if (objectp(dest))
        {
            tell_object(dest, name() + "已经自动转换为可叠加状态。\n");
        }
    }
    else
    {
        ::move(dest, raw);
    }
    return 1;
}