inherit ITEM;
// inherit F_FOOD;

void create()
{
    set_name(HIG"大葡萄"NOR, ({"da putao", "putao", "grape"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "一颗晶莹剔透的大葡萄,看起来非常诱人。\n");
        set("unit", "颗");
        set("value", 0);
        set("food_remaining", 1);
        set("food_supply", 0);
        set("only_do_effect", 1);
    }
    setup();
}

int do_effect(object me)
{
    message_vision("$N将" + name() + "放入口中。\n", me);
    tell_object(me, HIR"你感觉喉咙一阵灼烧,原来这是假的大葡萄!\n"NOR);
    message("vision", HIR + me->name() + "脸色突然发青,倒地不起!\n"NOR,
            environment(me), ({ me }));
    me->set("eff_qi",me->query("max_qi") / 2);
    me->set("qi",me->query("eff_qi"));
    destruct(this_object());
    return 1;
}

//不能清除
int clean_up() { return 1; }
