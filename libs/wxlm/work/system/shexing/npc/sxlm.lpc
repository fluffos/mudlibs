inherit NPC;

void create()
{
    set_name("四象狸猫", ({"sixiang limao", "limao", "cat"}));
    set("long", "一只通体雪白的狸猫,身上隐约可见四象图案,看起来十分神异。\n");
    
    set("age", 3);
    set("str", 30);
    set("int", 30);
    set("con", 30);
    set("dex", 30);
    
    // 设置经验等级
    set("combat_exp", 500000);
    
    // 设置气血
    set("max_qi", 15000);
    set("eff_qi", 15000);
    set("qi", 15000);
    
    // 设置内力
    set("max_neili", 2000);
    set("neili", 2000);
    
    // 设置精力
    set("max_jing", 20000);
    set("jing", 20000);
    
    // 设置防御
    set("combat_def", 100);
    
    // 设置伤害
    set("combat_damage", 100);
    
    // 设置技能
    set_skill("force", 150);
    set_skill("dodge", 150);
    set_skill("parry", 150);
    set_skill("unarmed", 150);
    
    // 设置掉落物品
    set("drops", ([
        "/clone/vip/zyao2" : 10,   // 生生造化丹掉落概率,10%
        "/clone/vip/zyao1" : 10,   // 天王保命丹掉落概率,10%
        "/clone/vip/hua5" : 10,   // 翡翠兰掉落概率,10%
        "/clone/vip/dan_jiuzhuan" : 1,   // 九转金丹掉落概率,1%
        "/clone/vip/putao1" : 1,   // 葡萄掉落概率,1%
    ]));
    
    setup();
    
    // 携带金子
    carry_object("/clone/money/gold")->set_amount(10);
}

varargs void die(object killer)
{
    object ob;
    mapping drops;
    string *items;

    if (!objectp(killer)) {
        killer = this_object()->query_last_damage_from();
    }

    if (!objectp(killer)) {
        return;
    }

    //刷新奖励次数
    refresh_time(killer,"sxlm_reward");

    //是否超过了3次
    if(killer->query("sxlm_reward/number") >= 5)
    {
        tell_object(killer,"你已经获得了5次奖励，无法再获得奖励。\n");
        ::die();
        return;
    }

    // 处理掉落
    if(mapp(drops = query("drops"))) {
        items = keys(drops);
        foreach(string item in items) {
            if(random(100) < drops[item]) {
                ob = new_bind(item);
                ob->move(killer);
                tell_object(killer, sprintf("你获得了%s。\n", ob->query("name")));
            }
        }
    }

    // 处理奖励，获得1-2头像碎片
    {
        killer->add("head_suipian", 1);
        tell_object(killer,"你获得了1个灵蛇珠。\n");
        //获得10绑定元宝，1贡献
        killer->add("bind_yuanbao", 10);
        killer->add("zjvip/all_pay",1);
        tell_object(killer,"你获得了10绑定元宝。\n");
        tell_object(killer,"你获得了1点游戏贡献。\n");
    }

    //消耗一次奖励机会
    killer->add("sxlm_reward/number", 1);
    //记录奖励时间
    killer->set("sxlm_reward/last_time", time());

    message_vision(HIR"$N"HIR"发出一声凄厉的惨叫,化作一道白光消失了!\n"NOR, this_object());
    
    ::die();
}

void unconcious()
{
    die();
} 