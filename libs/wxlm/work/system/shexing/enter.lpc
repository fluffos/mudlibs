#include <room.h>

inherit ROOM;

void create()
{
    set("short", HIW"【蛇形狸翻】"NOR"入口");
    set("long", @LONG
这里是蛇形狸翻活动的入口,每天晚上8点到晚上10点,每隔半小时开启一次。
活动中将会随机传送到迷宫中的某个房间,小心提防四象狸猫的袭击。
    
LONG);
    
    set("no_fight", 1);
    set("no_magic", 1);
    set("item_desc", ([
        "法阵" : popup_comb("这是一个法阵,可以传送到蛇形狸翻的迷宫中。","进入:enter"),
        // "购买次数" : popup_comb("购买奖励次数,每次消耗200元宝，请在使用所有奖励次数后再购买。","购买:buy_reward"),
    ]));
    set("exits", ([
        "north" : "/d/city/jiaowai8",
    ]));
    setup();
}

void init()
{
    add_action("do_enter", "enter");
    add_action("do_enter", "进入");
    add_action("buy_reward_number", "buy_reward");
}

int do_enter(string arg)
{
    object me = this_player();
    object room;
    
    if(!"/system/shexing/daemons/shexingd"->query_activity_status()) {
        return notify_fail("活动还未开启。\n");
    }
    
    // 获取随机房间
    room = "/system/shexing/daemons/shexingd"->get_random_room();
    if(!room) {
        return notify_fail("无法找到可用的房间。\n");
    }
    
    message_vision("$N深吸一口气,踏入了迷宫之中。\n", me);
    me->move(room);
    message("vision", me->name() + "突然出现在房间中。\n",
            environment(me), ({ me }));
    
    return 1;
} 


//购买奖励次数,sxlm_reward/number
int buy_reward_number(string arg)
{
    object me = this_player();

    if (me->query("sxlm_reward/number") < 1) {
        return notify_fail("你已经有超过5次奖励次数，请先使用再购买。\n");
    }

    if (me->query("yuanbao") < 200) {
        return notify_fail("你元宝不足，无法购买奖励次数。\n");
    }

    me->add("sxlm_reward/number", -1);
    me->add("yuanbao", -200);
    tell_object(me,"你购买了1次奖励次数。\n");
    return 1;
}

