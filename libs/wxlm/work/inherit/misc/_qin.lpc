// qin.c 琴

int play_qin(string arg)
{
	string my_id;

	object me = this_player();
	if (! arg)
	{
		string msg,*button;
		string *skills;
		button = ({
		});

		skills = keys(me->query_skills());

		skills = filter_array(skills, (: SKILL_D($1)->valid_enable("tanqin-jifa") :));

		if (sizeof(skills) > 0)
		{
			msg = "你要弹什么曲子？\n";
			if (!sizeof(skills))
			{
				tell_object(me,"你现在还不会任何曲子。\n");
				return 0;
			}
			foreach (string skill in skills)
			{
				button += ({ sprintf("%s:play %s", to_chinese(skill), skill) });
			}
			tell_object(me, popup_comb(msg, button));
		}

		return 0;
	}

	if (arg && sscanf(arg, "%s with %s", arg, my_id) == 2 &&
	    ! this_object()->id(my_id))
		return 0;
	return SKILL_D("tanqin-jifa")->play(this_player(), this_object(), arg);
}

int valid_as_qin() { return 1; }
