#include <weapon.h>

#ifdef AS_FEATURE
#include <dbase.h>
#else
inherit EQUIP;
#endif

varargs void init_qin(int damage, int flag)
{
    if( clonep(this_object()) ) return;

    set("weapon_prop/damage", damage);
    set("flag", (int)flag | LONG);
    set("skill_type", "qin");
    if( !query("actions") ) {
        set("actions", (: call_other, WEAPON_D, "query_action" :) );
        set("verbs", ({ "strike", "bash", "crush" }) );
    }
}