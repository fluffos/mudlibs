// challenge.c


#include <command.h>

inherit NPC;

object with_ob = 0;

void set_lvl(int lvl)
{
	object me = this_object();
	mapping smap = me->query_skills();
	int i;
	string *skills;
        
	lvl=120;

	skills = keys(smap);
	for(i=0;i<sizeof(skills);i++)
	{
		me->set_skill(skills[i],lvl);
	}
	me->set("combat_exp",lvl*lvl*lvl/10+1000000);
	me->set("jiali",lvl);
	me->set("qi",lvl*20000);
	me->set("eff_qi",lvl*2000);
	me->set("max_qi",lvl*2000);
	/*
	me->set("jing",lvl*1000);
	me->set("eff_jing",lvl*1000);
	me->set("max_jing",lvl*1000);
	*/
	me->set("jing",999999999);
	me->set("eff_jing",999999999);
	me->set("max_jing",999999999);
	
	me->set("neili",lvl*100);
	me->set("max_neili",lvl*200);
	me->set("wg_boss",1);
}

varargs int receive_damage(string type, int damage, mixed who)
{
	object me = this_object();

	if(objectp(who))
	{
		if (type == "jing")
		{
			me->add("boss/"+who->query("id"),damage / 2);
		}
		else
		{
			me->add("boss/"+who->query("id"),damage);
		}
		
		me->add("all_recive_damage",damage);
	}

	return ::receive_damage(type,damage,who);
}

void die()
{
	object ob;
	object story;
	string msg;
	int expi, poti, weiwangi, scorei;
	int i;
	string *items,*killer;
	object obj;
	mapping boss,give;
	function f;

	if (! objectp(ob = query_last_damage_from()))
		return;

	if (! objectp(story = "/adm/daemons/bossd"->query_running_story()))
		return;

	story->stop_story();
	msg = query("chat_lost");
	if (! msg) msg = "哈哈！好一个" + ob->name() + "，今日败在你手，也是江湖之大幸！";
	command("chat " + msg);
	CHANNEL_D->do_channel(this_object(), "rumor", "江湖传闻" + ob->name() + "于" + NATURE_D->game_time() + "一战击败" + name() + "，威震武林，名扬四海。");

//最后一击
	expi = random(1000) + 1000;
	poti = random(1000) + 500;
	weiwangi = random(query("combat_exp") / 1000) + 10;
	scorei = random(query("combat_exp") / 1000) + 10;
      if (ob->query("combat_exp")>10000000) expi /= 2;
	ob->add("combat_exp", expi);
	ob->add("potential", poti);
	ob->add("weiwang", weiwangi);
	ob->add("score", scorei);

	tell_object(ob, sprintf(HIG "你获得了%s点经验、%s点潜能，并增加了%s点威望、%s点江湖阅历。"NOR"\n",
			chinese_number(expi),chinese_number(poti),
			chinese_number(weiwangi),chinese_number(scorei)));
	set("finished", 1);

//伤害统计
	killer = keys(boss=query("boss"));

	if(give = query("die_give2"))
	{
		items = keys(give);
	}

	// f = function(string ob_one, string ob_two)
	// {
	// 	if (boss[ob_one] > boss[ob_two]) return -1;
		
	// 	if (boss[ob_one] < boss[ob_two]) return 1;

	// 	return 0;
		
	// };

	//函数指针的变量必须使用$(变量名)
	f = (: $(boss)[$1] > $(boss)[$2] ? -1 : $(boss)[$1] < $(boss)[$2] ? 1 : 0 :); //逻辑取反，降序排列

	killer = sort_array(killer,f);

	for(i=0;i<sizeof(killer);i++)
	{
		if(objectp(ob=find_player(killer[i])))
		{
			int add_exp;

			message_vision("$N累计对boss造成"+ boss[killer[i]] +"点伤害。\n", ob);
			log_file("boss_give", sprintf("%s：对boss造成 %d      点伤害，ID="+ob->query("id")+"。\n",ctime(time()),boss[killer[i]]));
			ob->add("weiwang",boss[killer[i]]/100);

			if (ob->query("combat_exp")<1000000) 
			{
				add_exp = 2000 + random(1000);

			}
			else
			{
				add_exp = 2000 + random(2000);
			}

			ob->add("combat_exp",add_exp);

			if(give&&present(ob,environment(this_object())))
			{
				int j;
				
				for(j=0;j<sizeof(items);j++)
				{


					//参与即可获得奖励，10绑定元宝
					ob->add("bind_yuanbao",10);
					tell_object(ob,HIM"你获得了10绑定元宝。"NOR"\n");

					//前五名玩家都有25%的机会获得物品，超过五名的玩家break
					if (i >= 4)
					{
						break;
					}

					// 读取具体的下标位置，如果大于4或者==-1则break
					if (member_array(ob->query("id"), killer) > 4 || member_array(ob->query("id"), killer) == -1)
					{
						break;
					}

					// if(random(query("all_recive_damage"))<boss[killer[i]] && random(query("all_recive_damage"))<boss[killer[i]])
					if (random(20) > 5)
					{
						obj = new_bind(items[j]);
						obj->move(ob);
						tell_object(ob,HIM"你获得了"+obj->query("name")+"。"NOR"\n");
						CHANNEL_D->do_channel( this_object(), "ic",ob->query("name")+"凭借高强武功，夺走了我的"+obj->query("name")+"，好生了得！");
						log_file("boss_give", sprintf("%s："+ob->query("id")+"得到了%s/%d。\n",ctime(time()),obj->query("name"),query("all_recive_damage")));
					}

				}
			}
				tell_object(ob,HIM"你获得了"+add_exp+"点经验和"+boss[killer[i]]/100+"点威望。"NOR"\n");
		}
	}
//掉落物品
	if(give = query("die_give"))
	{
		items = keys(give);
		for(i=0;i<sizeof(items);i++)
		{
			if(random(give[items[i]])==0)
			{
				obj = new(items[i]);
				obj->move(environment(this_object()));
			}
		}
	}

	call_out("destruct", 0, this_object());
}

void win()
{
 
	object story;
	string msg;

	if (sizeof(query_enemy()))
		return;

	if (! objectp(story = "/adm/daemons/bossd"->query_running_story()))
		return;

	story->stop_story();
	command("chat* haha");
	msg = query("chat_win");
	if (! msg) msg = "中原武林，不堪一击！";
	command("chat " + msg);
	set("finished", 1);
	call_out("destruct", 0, this_object());
	::win();
}

void fight_ob(object ob)
{
    if (userp(ob))
    {
        if (ob->query("combat_exp") > 5000000)
        {
            tell_object(ob, HIR "你的经验太高,无法攻击这个对手。\n" NOR);
            ob->remove_all_killer();
			ob->remove_all_want(1);
            return;
        }
    }
    
    ::fight_ob(ob);
}