// mount.c 坐骑装备

#include <armor.h>

inherit EQUIP;

void setup()
{
    if (!clonep(this_object()))
        set("armor_type", TYPE_MOUNT);
    
    set("armor_buwei", "坐骑");
    
    // 坐骑默认属性：增加闪避和移动速度
    if (!query("armor_prop/dodge"))
        set("armor_prop/dodge", 10);
        
    if (!query("armor_prop/dex"))
        set("armor_prop/dex", 1);
    
    ::setup();
}

// 坐骑的特殊初始化
void init()
{
    add_action("do_ride", "ride");
    add_action("do_dismount", "dismount");
}

// 骑乘动作
int do_ride(string arg)
{
    object me = this_player();
    
    if (!id(arg))
        return notify_fail("你要骑什么？\n");
    
    if (query("equipped"))
        return notify_fail("你已经骑在" + name() + "上了。\n");
    
    if (me->query_temp("is_riding"))
        return notify_fail("你已经骑着坐骑了。\n");
    
    return wear();
}

// 下马动作
int do_dismount(string arg)
{
    if (query("equipped"))
        return remove();
        
    return notify_fail("你并没有骑在坐骑上。\n");
}

// 当坐骑被装备时
int wear()
{
    object owner = environment();
    
    if (!owner || !userp(owner))
        return 0;
    
    if (::wear())
    {
        message_vision("$N翻身骑上了" + name() + "。\n", owner);
        return 1;
    }
    
    return 0;
}

// 当坐骑被卸下时
varargs int remove(string euid)
{
    object owner = environment();
    
    if (!owner || !userp(owner))
        return 0;
    
    if (::remove())
    {
        message_vision("$N从" + name() + "上下来。\n", owner);
        return 1;
    }
    
    return 0;
} 