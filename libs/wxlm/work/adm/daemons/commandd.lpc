#pragma optimize

// 存储命令搜索路径和对应的命令列表
private mapping search = ([]);

// 重新加载指定目录下的命令
void rehash(string dir)
{
	string path;
	string *cmds;
	mapping cmdlist;

	// 检查目录是否为有效的命令路径
	if (! sscanf(dir, "/cmds/%s", path))
	{
		write("错误:路径(" + dir + ")不是有效的命令路径,操作失败。\n");
		return;
	}

	// 确保目录以/结尾
	if (dir[<1] != '/') dir += "/";

	// 获取目录下所有文件
	cmds = get_dir(dir);
	if (! sizeof(cmds)) return;

	cmdlist = ([]);

	// 处理.c文件命令
	foreach(string cmd in cmds)
	{
		string fname;
		if (sscanf(cmd, "%s.lpc", fname))
			cmdlist[fname] = dir + cmd;
	}

	// 处理.alias别名文件
	foreach(string cmd in cmds)
	{
		string fname, alias;
		if (sscanf(cmd, "%s.alias", fname))
		{
			alias = read_file(dir + cmd, 1, 1);
			if (! alias) continue;
			
			alias = replace_string(alias, "\n", "");
			alias = replace_string(alias, "\r", "");
			sscanf(alias, "%s.lpc", alias);
			
			if (member_array(alias + ".lpc", cmds) != -1)
				cmdlist[fname] = dir + alias + ".lpc";
		}
	}

	// 更新搜索映射
	if (sizeof(cmdlist))
		search[dir] = cmdlist;
}

// 测试函数,输出当前search映射内容
void test() 
{ 
	write(sprintf("%O\n", search)); 
}

// 在指定路径中查找命令
string find_command(string verb, string *path)
{
	if (! stringp(verb) || ! arrayp(path))
		return 0;

	foreach(string p in path)
	{
		mapping current = search[p];
		string file;

		if (! current)
		{
			rehash(p);
			current = search[p];
			if (! current) continue;
		}

		file = current[verb];
		if (stringp(file))
			return file;
	}
	
	return 0;
}
