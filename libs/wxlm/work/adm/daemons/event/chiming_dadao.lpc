

void create() { seteuid(getuid()); }

#define STATUS_START 1
#define STATUS_END   2

object get_random_taishan_room();

void create_event()
{

    return;

    EVENT_D->at_after(0, 0, 0, -21, STATUS_START);
}

void trigger_event(int status)
{
    object room;
    int i;
    object *players;
    int total_skill, avg_skill, count;

    switch (status)
    {
    case STATUS_START:
        players = filter_array(users(), (: $1->query("combat_exp") > 1000000 :));
        players = sort_array(players, (: $2->query("combat_exp") - $1->query("combat_exp") :));
        
        total_skill = 0;
        count = 0;
        for (i = 0; i < 20 && i < sizeof(players); i++)
        {
            total_skill += players[i]->query("max_neili") + players[i]->query("max_jingli");
            count++;
        }
        
        if (count > 0)
            avg_skill = total_skill / count;
        else
            avg_skill = 5000;

        for (i = 0; i < 20; i++)
        {
            room = get_random_taishan_room();
            if (objectp(room))
            {
                object dadao = new("/clone/npc/chiming_dadao");
                dadao->set_from_me(players[0], avg_skill * 100 / players[0]->query("max_neili"));
                dadao->move(room);
            }
        }
        
        CHANNEL_D->do_channel(this_object(), "rumor",
            "听说赤冥大盗已经出现在泰山一带,各位英雄请小心！");
        
        EVENT_D->at_after(0, 0, 2, 0, STATUS_END);
        break;

    case STATUS_END:
        foreach (object dadao in children("/clone/npc/chiming_dadao"))
        {
            if (objectp(dadao) && environment(dadao))
            {
                destruct(dadao);
            }
        }
        
        CHANNEL_D->do_channel(this_object(), "rumor",
            "赤冥大盗已经撤退,泰山一带恢复了平静。");
        
        create_event();
        break;
    }
}

object get_random_taishan_room()
{
    string *rooms = ({
        "/d/taishan/taishanjiao",
        "/d/taishan/yidao",
        "/d/taishan/yidao1",
        "/d/taishan/yidao2",
        "/d/taishan/yidao3",
        "/d/taishan/daizong",
        "/d/taishan/huima",
        "/d/taishan/baihe",
        "/d/taishan/shijin",
        "/d/taishan/doumo",
        "/d/taishan/tianjie",
        "/d/taishan/yuhuang",
        "/d/taishan/nantian",
        "/d/taishan/zhengqi",
        "/d/taishan/lianhua",
        "/d/taishan/jingshi",
        "/d/taishan/tanhai",
        "/d/taishan/riguan",
        "/d/taishan/yueguan",
        "/d/taishan/wudafu",
    });
    
    return get_object(rooms[random(sizeof(rooms))]);
}