/**
 * @brief 从指定目录随机加载房间对象
 * @param string file_dir 指定房间对象存储的根目录路径
 * @return object 加载成功的房间对象，失败时返回 0
 * @details 该函数采用概率化加载策略以提升场景多样性，通过以下机制实现：
 * 1. 自动补全目录结构：当传入空路径时自动关联到/binaries/子目录
 * 2. 随机文件选择：通过随机数生成器从目录中选取候选文件
 * 3. 双重加载机制：优先尝试直接加载对象实例，若失败则回退到原始对象加载
 * 4. 完整性校验：通过文件存在性检查和对象加载状态双重验证确保加载可靠性
 * 该设计在保证功能稳定性的同时，能有效避免重复加载相同房间对象导致的性能问题
 */
object load_room_place(string file_dir)
{
	string *file, bin_dir, path;
	int max, get_an;
	object room;

	bin_dir = file_dir;
		
	if (! bin_dir)
		bin_dir = "/binaries" + file_dir;

	if ( file_size(bin_dir) != -2 ) return 0;
	file = get_dir(bin_dir, -1);

	if ( !(max = sizeof(file)) ) return 0;

	get_an = random(max);
	path = bin_dir + file[get_an][0];
	if ( file_size(path) <= 0 ) return 0;

	if (room=find_object(path))
		return room;
	else if (strlen(path) > 4 && path[<4..<1] == ".lpc")
		return load_object(path[0..<5]);
	else
		return load_object(path);
}

int ok = 0;
int ok1 = 0;
string path_where=0;

void create()
{
	seteuid(getuid());
	set("channel_id", "飞贼系统");
	CHANNEL_D->do_channel( this_object(), "sys", "飞贼系统已经启动。"NOR);
	set_heart_beat(20);
}

int clean_up()
{
	return 1;
}

/**
 * @brief 随机选择一个符合条件的房间对象
 * @return object 符合条件的房间对象，如果找不到则递归调用直到找到为止
 * @details 该函数通过递归方式随机选择并验证房间，确保返回的房间具有简短描述、有效出口、户外属性且允许战斗。如果初始选择的房间不符合这些条件，函数会自动重新选择，直到找到符合条件的房间为止。
 */
object do_copy()
{
	string *locations = keys(room_place);
	int num_locations = sizeof(locations);
	string selected_location = locations[random(num_locations)];
	string dir = room_place[selected_location];
	object room = load_room_place(dir);
	path_where = selected_location;
	
	if (objectp(room))
	{
		mapping exits = room->query("exits");
		if (!room->query("short") || !mapp(exits) || !sizeof(exits) ||
			!room->query("outdoors") || room->query("no_fight"))
		{
			return do_copy();
		}
	} 

	return objectp(room) ? room : do_copy();
}

/**
 * @brief 清理所有环境中的特殊物品实例
 * @details 该函数设计用于在游戏维护或长时间不活跃后，确保所有特殊物品实例被安全销毁，防止环境残留异常物品影响游戏平衡。通过遍历special_list维护的容器，逐层销毁所有非环境空置的玩家持有物品，并在销毁时提供明确的游戏提示。
 */
void clear_special()
{
	int i,k;
	object *list,ob;

	for(i=0;i<sizeof(special_list);i++)
	{
		list = children(special_list[i]);
		if(!list||!sizeof(list)) continue;
		for(k=0;k<sizeof(list);k++)
		{
			if((ob=environment(list[k]))&&playerp(ob))
			{
				tell_object(ob,"系统特殊物品刷新，你身上的"+list[k]->short()+"消失了！\n");
				destruct(list[k]);
			}
		}
	}
}

/**
 * @brief 监控时间触发特殊事件
 * @details 该函数通过检测当前时间触发两种特定场景：
 * 1. 当分钟为50且未触发过飞贼事件时，自动生成飞贼并通知玩家
 * 2. 当整点18:00时自动清理特殊状态
 * 设计采用状态变量ok/ok1避免重复触发，通过call_out实现非实时移除飞贼对象
 * 时间解析逻辑确保精确到分钟级判断，避免时区差异导致的误判
 */
void check_time()
{
	int GMT = time();
	string times;
	int h, s;
	object room, ob;

	times = ctime(GMT);
	//Sun(星期日) Mon(星期一)  Tue(星期二)  Wed(星期三)  Thu(星期四)  Fri(星期五)  Sat(星期六)
	// d = times[0..2];//星期
	h = to_int(times[10..12]);//时
	s = to_int(times[14..15]);//分

	if ((s == 50) && !ok) {
		if (!room = do_copy())
			room = do_copy();
		else {
			ob = new("/clone/npc/feizei");
			if (ob->move(room)) {
				message("channel", HIR"【官府】:"HIY"听说有飞贼在"+HIG+path_where+HIY"一带出没，请留心自身财物安全！"NOR"\n", users());
				CHANNEL_D->do_channel( this_object(), "sys", "飞贼出现了。");
				ok = 1;
				call_out("remove_npc", 120, ob);
			} else
				CHANNEL_D->do_channel( this_object(), "sys", "飞贼生成失败。"NOR);
		}
	}

	if ((h == 18) && (s == 0) && !ok1) {
		clear_special();
		ok1 = 1;
	}

	if (s!=50) ok = 0;
	if (!(h==18&&s==0)) ok1 = 0;
}

void remove_npc(object ob)
{
	if (ob) {
		ob->force_me("say 这鬼地方真穷，没什么油水可捞，还是回家吧！\n");
		destruct(ob);
	}
}

protected void heart_beat()
{	
	check_time();
}