// human.c
#define BASE_WEIGHT 40000

inherit F_DBASE;
inherit F_SKILL;
#define DESC_MAN "/system/ai_chat/desc_man"

mapping *combat_action = ({
([      "action":	       "$N挥拳攻击$n的$l",
	"damage_type":  "瘀伤",
]),
([      "action":	       "$N往$n的$l一抓",
	"damage_type":  "抓伤",
]),
([      "action":	       "$N往$n的$l狠狠地踢了一脚",
	"damage_type":  "瘀伤",
]),
([      "action":	       "$N提起拳头往$n的$l捶去",
	"damage_type":  "瘀伤",
]),
([      "action":	       "$N对准$n的$l用力挥出一拳",
	"damage_type":  "瘀伤",
]),
});


void player_set_desc(object ob)
{
	ob->set("last_set_desc_time",time());
	// DESC_MAN->set_player_desc(ob);
}

void create()
{
	seteuid(getuid());
}

/**
 * @brief 初始化人类角色的基本属性和状态
 * @param object ob 需要初始化的人类角色对象
 * @details 该函数用于设置人类角色的各项基础属性，包括基本属性值、精神值、气血值、负重能力等。
 *          函数会根据角色的心法等级、年龄、境界、技能等多种因素计算角色的各项属性上限，
 *          确保角色在游戏世界中具有合理的属性基础。这些属性计算方式是为了平衡游戏体验，
 *          同时反映角色在武侠世界中的成长和修炼水平。
 */
void setup_human(object ob)
{
	mapping my;
	int xflv,level, level_old;
	string xinfa;

	if(xinfa = ob->query_skill_mapped("xinfa"))
		xflv = ob->query_skill(xinfa,1);
	else
		xflv = 0;

	my = ob->query_entire_dbase();

	ob->set_default_action(__FILE__, "query_action");
	if (! stringp(my["unit"])) my["unit"] = "位";
	if (! stringp(my["gender"])) my["gender"] = "男性";
	if (undefinedp(my["can_speak"])) my["can_speak"] = 1;
	if (! stringp(my["attitude"])) my["attitude"] = "peaceful";
	if (! pointerp(my["limbs"])) my["limbs"] = ({
		"头部", "颈部", "胸口", "后心", "左肩", "右肩", "左臂",
		"右臂", "左手", "右手", "腰间", "小腹", "左腿", "右腿",
		"左脚", "右脚"
	});

	if (undefinedp(my["age"])) my["age"] = 14;
	if (undefinedp(my["str"])) my["str"] = 10 + random(21);
	if (undefinedp(my["con"])) my["con"] = 10 + random(21);
	if (undefinedp(my["dex"])) my["dex"] = 10 + random(21);
	if (undefinedp(my["int"])) my["int"] = 10 + random(21);
	if (undefinedp(my["per"])) my["per"] = 10 + random(21);

	//如果是玩家重新分配精神
	if (userp(ob) || undefinedp(my["max_jing"]))
	{
		mapping jing_bonus = ([
			"基础"		: 200,
			"年龄"		: 0,
			"悟性"		: ob->query_int() * 30,
			"精力"		: ob->query("max_jingli") / 3,
			"通脉"		: my["breakup"] ? 3000 : 0,
			"感悟炼神"	: my["ganwu_lianshen"] * 50,
			"元婴"		: my["animaout"] ? 3500 : 0,
			"吐纳心法"	: xflv * 10,
			"抱守阴阳"	: ob->query_skill("baoshouyinyang", 1) * (ob->query("max_jingli") > 20000 ? 20 : (ob->query("max_jingli") / 1000)),
			"通十脉"	: my["shimai-tong"] ? 100000 : 0,
			"经脉"		: ob->query_gain_jing(),
			"增益"		: ob->query_temp("max_jing"),
			"三花聚顶"	: my["sanhua_done"] ? 15000 : 0,
			"境界增益"	: ob->query("level_max_jingli") / 3,
			"词条"		: ob->query("citiao_effects/jing"),
			"秘传加成"	: ob->query("mizhuan_power/attribute/max_jing"),
			"称号"		: ob->query("titlea/max_jing"),
			"武圣真意"	: ob->query("zhenyi_bonus/max_jing"),
			"五气朝元"	: ob->query("wuqi_done") ? 150000 : 0,
			"装备"		: ob->query_temp("apply/max_jing"),
		]);

		// 计算年龄加成
		if (!undefinedp(my["born"]))
		{
			if (my["age"] > 14 && my["age"] < 40)
				jing_bonus["年龄"] = (my["age"] - 14) * 10;
			else if (my["age"] >= 40)
				jing_bonus["年龄"] = 200;
		}

		// 初始化精神值
		my["max_jing"] = 0;

		// 记录各项加成并累加总值
		foreach(string key, int value in jing_bonus)
		{
			if (value > 0)
			{

				ob->set_temp("race_human/jing/" + key, value);
				my["max_jing"] += value;
			}
		}

		// 限制最大精神上限
		if(my["max_jing"] > 10000000)
			my["max_jing"] = 10000000;
	}

	if (userp(ob) || undefinedp(my["max_qi"]))
	{
		mapping qi_bonus = ([
			"基础"		: 600,
			"年龄"		: 0,
			"体质力量"	: (ob->query_con() + ob->query_str()) * 30,
			"道学心法"	: ob->query_skill("taoism", 1) * 15,
			"周天功"	: ob->query_skill("xiantian-gong", 1) * 15,
			"龙象般若功"	: ob->query_skill("longxiang", 1) * 15,
			"太极神功"	: ob->query_skill("taiji-shengong", 1) * 15,
			"通脉"		: my["breakup"] ? 5000 : 0,
			"通十脉"	: my["shimai-tong"] ? 100000 : 0,
			"逆流直上"	: !undefinedp(my["niliu_qi"]) ? (my["niliu_qi"] < 1000 ? my["niliu_qi"] * 5 : 5000 + my["niliu_qi"] * 5) : 0,
			"经脉"		: ob->query_gain_qi(),
			"人参果"	: !undefinedp(my["renshen_effect"]) ? my["renshen_effect"] : 0,
			"增益"		: ob->query_temp("max_qi"),
			"称号"		: ob->query("titlea/max_qi"),
			"经脉数量"	: MERIDIAN_D->query_meridian_count(ob) * 1000,
			"三花聚顶"	: my["sanhua_done"] ? 30000 : 0,
			"境界增益"	: ob->query("level_max_qi"),
			"词条"		: ob->query("citiao_effects/qi"),
			"冰蚕寒功" : ob->query_skill("freezing-force", 1) * 50,
			"秘传加成"	: ob->query("mizhuan_power/attribute/max_qi"),
			"五藏归元丹"	: ob->query("wucang/max_qi"),
			"武圣心脏"	: ob->query("wusheng_bonus/max_qi"),
			"武圣真意"	: ob->query("zhenyi_bonus/max_qi"),
			"装备"		: ob->query_temp("apply/max_qi"),
		]);

		//武尊
		if (ob->query("sanhua_done"))
		{
			qi_bonus["五藏归元丹"] = ob->query("wucang/max_qi") * 3;
		}
		//宗师
		else if (ob->query("opinion/ultra"))
		{
			qi_bonus["五藏归元丹"] = ob->query("wucang/max_qi") * 18 / 10;
		} 
		//其他入品武者
		else
		{
			qi_bonus["五藏归元丹"] = ob->query("wucang/max_qi");
		}



		// 计算年龄加成
		if (!undefinedp(my["born"]))
		{
			if (my["age"] > 14 && my["age"] < 40)
				qi_bonus["年龄"] = (my["age"] - 14) * 20;
			else if (my["age"] >= 40)
				qi_bonus["年龄"] = 400;
		}

		// 计算吐纳心法加成
		if (xflv > 180)
		{
			qi_bonus["吐纳心法"] = (xflv-180)*10;
			qi_bonus["吐纳加成"] = my["max_qi"]*((xflv-180)/5) / 100;
		}

		// 初始化气血值
		my["max_qi"] = 0;

		// 记录各项加成并累加总值
		foreach(string key, int value in qi_bonus)
		{
			if (value > 0)
			{

				ob->set_temp("race_human/qi/" + key, value);
				my["max_qi"] += value;
			}
		}

		// 身体强壮天赋增加气血
		if (ob->query("special_skill/strong_body"))
		{
			int strong_body_level = TALNET_MASTER->query_talnet_level(ob, "strong_body");
			int *strong_body_coefficients = ({20, 25, 30, 35, 40, 45, 50, 55, 60, 80});
			int bonus;

			if (strong_body_level > sizeof(strong_body_coefficients))
				strong_body_level = sizeof(strong_body_coefficients);

			bonus = ob->query_str() * strong_body_coefficients[strong_body_level - 1];
			ob->set_temp("race_human/qi/强体", bonus);
			my["max_qi"] += bonus;
		}

		// 阴身削弱气血
		if (ob->query("special_skill/ghost"))
		{
			int ghost_level = TALNET_MASTER->query_talnet_level(ob,"ghost");
			ob->set_temp("race_human/qi/阴身",- (my["max_qi"] * (100 + ghost_level - 70) / 100));

			my["max_qi"] = my["max_qi"] * (70 + ghost_level) / 100;
		}

		// 根据境界调整最终气血
		if (ob->query("wuqi_done"))  // 武圣（五气朝元）
		{
			int realm_bonus = my["max_qi"] * 350 / 100;  // 额外350%，总共450%
			ob->set_temp("race_human/qi/武圣境界", realm_bonus);
			my["max_qi"] = my["max_qi"] * 450 / 100;
		}
		else if (ob->query("sanhua_done"))  // 武尊
		{
			int realm_bonus = my["max_qi"] * 250 / 100;  // 额外250%，总共350%
			ob->set_temp("race_human/qi/武尊境界", realm_bonus);
			my["max_qi"] = my["max_qi"] * 350 / 100;
		}
		else if (ob->query("opinion/ultra"))  // 宗师
		{
			int realm_bonus = my["max_qi"] * 100 / 100;  // 额外100%，总共200%
			ob->set_temp("race_human/qi/宗师境界", realm_bonus);
			my["max_qi"] = my["max_qi"] * 2;
		}

		// 限制最大气血上限
		if(my["max_qi"] > 10000000)
			my["max_qi"] = 10000000;
	}

	// 为什么要乘以0.7？这是因为背人只需要70%的负重。
	if (! ob->query_weight())
	{
		ob->set_weight((BASE_WEIGHT + (my["str"] - 10) * 2000) * 7 / 10);
	}
	
	level_old = ob->query_temp("mark/hubo");

	if ((level = ob->query_skill("zuoyou-hubo", 1)) > 0 && level_old != level)
	{
		ob->set_temp("mark/hubo",level);
		ob->add_temp("apply/parry", -(level - level_old) / 4);
	}


	//  设定经脉最大负荷值
	{
		int max_jingmai_fuhe = 100; // 初始最大负荷值
		int temp_fuhe;

		// 打通任督二脉(breakup)增加10点
		if (my["breakup"])
		{
			temp_fuhe = 10;
			max_jingmai_fuhe += temp_fuhe;
			ob->set_temp("race_human/jingmai_fuhe/任督二脉", temp_fuhe);
		}

		// 其他经脉每条增加5点
		temp_fuhe = MERIDIAN_D->query_meridian_count(ob) * 5;
		max_jingmai_fuhe += temp_fuhe;
		ob->set_temp("race_human/jingmai_fuhe/奇经八脉", temp_fuhe);

		// 三花聚顶增加20点
		if (my["sanhua_done"])
		{
			temp_fuhe = 20;
			max_jingmai_fuhe += temp_fuhe;
			ob->set_temp("race_human/jingmai_fuhe/三花聚顶", temp_fuhe);
		}

		// 限制最大经脉负荷值
		if (max_jingmai_fuhe > 200)
			max_jingmai_fuhe = 200;

		ob->set("max_jingmai_fuhe", max_jingmai_fuhe);
	}

	if (!is_same_day(time(), ob->query("last_set_desc_time")) && playerp(ob) && !ob->query_temp("set_desc_doing"))
	{
		// int start_time = 20 + random(800);
		ob->set_temp("set_desc_doing", 1);
		// call_out((: player_set_desc :), start_time, ob);
	}
}

/**
 * @brief 随机获取一个战斗动作
 * @return mapping 返回从预定义战斗动作数组中随机选择的一个战斗动作映射
 * @details 该函数用于在战斗过程中随机选择一个动作，增加战斗的不可预测性和多样性。
 */
mapping query_action()
{
	return combat_action[random(sizeof(combat_action))];
}
