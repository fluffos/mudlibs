// yaomo.c
// 妖魔种族初始化文件

inherit F_DBASE;
inherit F_SKILL;

// 妖魔基础战斗动作
mapping *combat_action = ({
([
    "action": "$N挥爪攻向$n的$l",
    "damage_type": "抓伤",
]),
([
    "action": "$N发出一声嘶吼，猛地扑向$n",
    "damage_type": "瘀伤",
]),
([
    "action": "$N妖气大盛，一掌拍向$n的$l",
    "damage_type": "瘀伤",
]),
([
    "action": "$N双眼血红，疯狂地撕咬$n",
    "damage_type": "咬伤",
]),
([
    "action": "$N凝聚妖力，重击$n的要害",
    "damage_type": "内伤",
]),
([
    "action": "$N周身黑气缭绕，诡异攻向$n",
    "damage_type": "妖气伤",
]),
});

/**
 * @brief 初始化妖魔种族的基本属性和状态
 * @param object ob 需要初始化的妖魔对象
 * @details 该函数用于设置妖魔的各项基础属性，包括基本属性值、精神值、气血值等。
 *          妖魔作为特殊的种族，拥有比人类更强的战斗能力和更高的属性上限。
 */
void setup_yaomo(object ob)
{
    mapping my;

    if (!objectp(ob))
        return;

    my = ob->query_entire_dbase();

    // 设置默认action，这是解决战斗错误的关键
    ob->set_default_action(__FILE__, "query_action");

    // 设置妖魔的基本属性
    if (!stringp(my["unit"])) my["unit"] = "只";
    if (!stringp(my["gender"])) my["gender"] = "无性";
    if (!stringp(my["attitude"])) my["attitude"] = "aggressive";
    if (undefinedp(my["can_speak"])) my["can_speak"] = 1;

    // 设置妖魔的肢体结构
    if (!pointerp(my["limbs"])) my["limbs"] = ({
        "头部", "颈部", "胸口", "后心", "左肩", "右肩", "左臂",
        "右臂", "左爪", "右爪", "腰间", "小腹", "左腿", "右腿",
        "左脚", "右脚"
    });

    // 如果妖魔配置中没有设置年龄，则使用默认值
    if (undefinedp(my["age"])) my["age"] = random(2000) + 100;

    // 设置妖魔的基础属性（如果配置中没有设置的话）
    if (undefinedp(my["str"])) my["str"] = 20 + random(31);      // 20-50
    if (undefinedp(my["int"])) my["int"] = 15 + random(36);      // 15-50
    if (undefinedp(my["con"])) my["con"] = 20 + random(31);      // 20-50
    if (undefinedp(my["dex"])) my["dex"] = 15 + random(36);      // 15-50
    if (undefinedp(my["per"])) my["per"] = 10 + random(21);      // 10-30

    // 设置妖魔的精神值（如果配置中没有设置的话）
    if (userp(ob) || undefinedp(my["max_jing"]))
    {
        if (undefinedp(my["max_jing"]))
        {
            // 妖魔的精神值比人类更高
            my["max_jing"] = 300 + my["int"] * 50 + my["age"] / 10;

            // 确保最低精神值
            if (my["max_jing"] < 500)
                my["max_jing"] = 500;
        }
    }

    // 设置妖魔的气血值（如果配置中没有设置的话）
    if (userp(ob) || undefinedp(my["max_qi"]))
    {
        if (undefinedp(my["max_qi"]))
        {
            // 妖魔的气血值比人类高得多
            my["max_qi"] = 1000 + (my["con"] + my["str"]) * 80 + my["age"] / 5;

            // 确保最低气血值
            if (my["max_qi"] < 2000)
                my["max_qi"] = 2000;
        }
    }

    // 设置妖魔的体重（如果配置中没有设置的话）
    if (!ob->query_weight())
    {
        // 妖魔体重基于力量，比人类更重
        ob->set_weight(60000 + (my["str"] - 10) * 3000);
    }
}

/**
 * @brief 随机获取一个妖魔战斗动作
 * @return mapping 返回从预定义妖魔战斗动作数组中随机选择的一个战斗动作映射
 * @details 该函数用于在战斗过程中随机选择妖魔的动作，增加战斗的多样性和妖魔特色。
 */
mapping query_action()
{
    return combat_action[random(sizeof(combat_action))];
}