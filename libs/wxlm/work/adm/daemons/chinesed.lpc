// chinesed.c

#pragma optimize

#include <localtime.h>

#ifndef DATA_DIR
#define DATA_DIR 	"/data/"
#endif
#define E2C_DICTIONARY	DATA_DIR + "e2c_dict.json"

// inherit F_SAVE;
string query_save_file();

// Constants
nosave string *c_digit = ({ "零","一","二","三","四","五","六","七","八","九" });
nosave string *units = ({ "","十","百","千","万","亿","兆" });
nosave string *sym_tian = ({ "甲","乙","丙","丁","戊","己","庚","辛","壬","癸" });
nosave string *sym_di = ({ "子","丑","寅","卯","辰","巳","午","未","申","酉","戌","亥" });

mapping dict = ([]);

void save()
{
    assure_file(E2C_DICTIONARY);
	write_file(E2C_DICTIONARY, json_format(json_encode(dict)),1);
}


/**
 * 从文件中恢复字典数据
 * 如果文件存在则读取JSON数据并解析到dict中
 */
void restore()
{
    string content;
    
    if (file_size(E2C_DICTIONARY) <= 0)
        return;
        
    content = read_file(E2C_DICTIONARY);
    if (!content || content == "")
        return;
        
    dict = json_decode(content);

    if (!dict)
        dict = ([]);
}

void create()
{
	seteuid(getuid());
	restore();
}

string query_save_file()
{
	return E2C_DICTIONARY;
}
