inherit F_DBASE;
inherit F_SAVE;


int combat_exp = 1;//当天修为榜前20的修为平均值
int last_time = 0;//上次更新时间
// int start_time = 1719564279;//开服时间，先行服日期

nosave mapping time_data = ([
    "武侠黎明":1735646400
]);

int sort_exp(string user1, string user2) {
    return (int)TOP_D->query_user(user2 + "/combat_exp") - (int)TOP_D->query_user(user1 + "/combat_exp");
}

string query_save_file()
{
	return DATA_DIR "shengxiand";
}

void create()
{	
    seteuid(ROOT_UID);
    set("channel_id", "追赶系统");
    CHANNEL_D->do_channel( this_object(), "sys", "追赶系统已经启动。");
    restore();
    set_heart_beat(1);
}

void heart_beat()
{
    string *all_users;
    int avg = 0;
    int number = 20;

    // if (time() - last_time < 86400)
    // 是否是同一天
    if (time() / 86400 == last_time / 86400)
    {
        return;
    }

    all_users = TOP_D->all_users();

    if (!sizeof(all_users))
    {
        last_time = time();
        CHANNEL_D->do_channel(this_object(), "sys", "修为榜前20的修为平均值更新失败，没有找到任何玩家。");
        return;
    }

    //排序
    all_users = sort_array(all_users, (: sort_exp :));

    //计算前20的修为平均值
    for (int i = 0; i < number; i++)
    {

        if (i >= sizeof(all_users))
        {
            number = sizeof(all_users);
            break;
        }

        avg += TOP_D->query_user(all_users[i] + "/combat_exp");
    }

    avg = avg / number;
    
    
    last_time = time();
    combat_exp = avg;
    CHANNEL_D->do_channel(this_object(), "sys", "修为榜前20的修为平均值为" + avg + "点，当前已经更新。");
    save();
}

int clean_up()
{
	return 1;
}

// 返回修为榜前20的修为平均值
int query_combat_exp()
{
    return combat_exp;
}

// 返回开服时间
int query_start_time()
{
    // return start_time;
    return time_data[MUD_NAME];
}