void create() { seteuid(getuid()); }
void recalculate_title_effects(object me);
/**
 * @brief 计算玩家可用的副称号槽位数量
 * @param object me 玩家对象
 * @return int 可用副称号槽位数量
 * @details 从200级开始，每提升100级解锁一个副称号槽位
 */
int query_sub_title_slots(object me)
{
    int level;
    
    level = me->query("level");
    if (level < 200) {
        return 0;
    }
    
    return (level - 200) / 100 + 1;
}

/**
 * @brief 获取玩家当前已佩戴的副称号列表
 * @param object me 玩家对象
 * @return string* 已佩戴的副称号名称数组
 */
string *query_sub_titles(object me)
{
    string *sub_titles;
    
    sub_titles = me->query("sub_titles");
    if (!arrayp(sub_titles)) {
        return ({});
    }
    
    return sub_titles;
}

/**
 * @brief 佩戴副称号
 * @param object me 玩家对象
 * @param string title 要佩戴的副称号名称
 * @return int 1成功 0失败
 */
int use_sub_title(object me, string title)
{
    string *sub_titles;
    int max_slots, current_count;
    
    if (!titles[title]) {
        tell_object(me, "该称号不存在。\n");
        return 0;
    }
    
    if (!me->query("titles/" + title)) {
        tell_object(me, "你还没有获得该称号。\n");
        return 0;
    }
    
    max_slots = query_sub_title_slots(me);
    if (max_slots <= 0) {
        tell_object(me, "你的等级不足200级，无法佩戴副称号。\n");
        return 0;
    }
    
    sub_titles = query_sub_titles(me);
    
    // 检查是否已经佩戴了该称号
    if (member_array(title, sub_titles) != -1) {
        tell_object(me, "你已经佩戴了该副称号。\n");
        return 0;
    }
    
    // 检查是否为主称号
    if (me->query("chenghao") == title) {
        tell_object(me, "该称号已作为主称号佩戴，不能同时作为副称号。\n");
        return 0;
    }
    
    current_count = sizeof(sub_titles);
    if (current_count >= max_slots) {
        tell_object(me, "你的副称号槽位已满，无法佩戴更多副称号。\n");
        return 0;
    }
    
    sub_titles += ({ title });
    me->set("sub_titles", sub_titles);
    
    // 重新计算属性
    recalculate_title_effects(me);
    
    tell_object(me, HIR "你佩戴了副称号：" HIC + title + NOR + "\n");
    
    return 1;
}

/**
 * @brief 卸下副称号
 * @param object me 玩家对象
 * @param string title 要卸下的副称号名称
 * @return int 1成功 0失败
 */
int remove_sub_title(object me, string title)
{
    string *sub_titles;
    int index;
    
    sub_titles = query_sub_titles(me);
    index = member_array(title, sub_titles);
    
    if (index == -1) {
        tell_object(me, "你没有佩戴该副称号。\n");
        return 0;
    }
    
    sub_titles = sub_titles[0..index-1] + sub_titles[index+1..];
    me->set("sub_titles", sub_titles);
    
    // 重新计算属性
    recalculate_title_effects(me);
    
    tell_object(me, HIR "你卸下了副称号：" HIC + title + NOR + "\n");
    
    return 1;
}

/**
 * @brief 重新计算称号属性效果
 * @param object me 玩家对象
 * @details 主称号100%属性，副称号30%属性
 */
/**
 * @brief 重新计算称号效果
 * @param object me 玩家对象
 * @details 计算主称号、副称号和自动生效称号的属性加成并应用到角色身上
 */
void recalculate_title_effects(object me)
{
    string main_title, *sub_titles, *auto_titles;
    mapping total_attrs = ([]);
    string *att, at;
    mixed xg;
    
    // 清除现有的称号属性
    me->delete("titlea");
    
    main_title = me->query("chenghao");
    sub_titles = query_sub_titles(me);
    
    // 计算主称号100%属性
    if (main_title && titles[main_title]) {
        xg = titles[main_title];
        att = keys(xg);
        foreach (at in att) {
            if (intp(xg[at])) {
                if (!total_attrs[at]) {
                    total_attrs[at] = 0;
                }
                total_attrs[at] += xg[at];
            }
        }
    }
    
    // 计算副称号30%属性
    foreach (string sub_title in sub_titles) {
        if (titles[sub_title]) {
            xg = titles[sub_title];
            att = keys(xg);
            foreach (at in att) {
                if (intp(xg[at])) {
                    if (!total_attrs[at]) {
                        total_attrs[at] = 0;
                    }
                    total_attrs[at] += xg[at] * 30 / 100;
                }
            }
        }
    }
    
    // 计算无需佩戴即可生效的称号100%属性
    auto_titles = keys(auto_active_titles);
    foreach (string auto_title in auto_titles) {
        if (me->query("titles/" + auto_title) && titles[auto_title]) {
            xg = titles[auto_title];
            att = keys(xg);
            foreach (at in att) {
                if (intp(xg[at])) {
                    if (!total_attrs[at]) {
                        total_attrs[at] = 0;
                    }
                    total_attrs[at] += xg[at];
                }
            }
        }
    }
    
    // 应用所有计算出的属性
    att = keys(total_attrs);
    foreach (at in att) {
        me->set("titlea/" + at, total_attrs[at]);
    }
    
    // 重新计算角色属性以应用称号效果
    CHAR_D->setup_char(me);
}

/**
 * @brief 管理主称号佩戴
 * @param object me 当前佩戴者对象
 * @param string title 要激活的主称号名称
 * @return int 1成功激活 0激活失败
 * @details 新的主副称号系统：主称号100%属性，副称号30%属性
 */
int use_title(object me, string title)
{
    string *sub_titles;
    
    if (!titles[title]) {
        tell_object(me, "该称号不存在。\n");
        return 0;
    }
    
    if (!me->query("titles/" + title)) {
        tell_object(me, "你还没有获得该称号。\n");
        return 0;
    }
    
    // 检查是否已作为副称号佩戴
    sub_titles = query_sub_titles(me);
    if (member_array(title, sub_titles) != -1) {
        tell_object(me, "该称号已作为副称号佩戴，请先卸下副称号。\n");
        return 0;
    }
    
    // 设置当前佩戴的主称号
    me->set("chenghao", title);
    
    // 重新计算属性
    recalculate_title_effects(me);
    
    tell_object(me, HIR "你佩戴了主称号：" HIC + title + NOR + "\n");
    
    return 1;
}

/**
 * @brief 查询指定称号的详细信息
 * @param me 查询称号的主体对象
 * @param title 要查询的称号名称
 * @return 返回包含称号详细信息的字符串，包括获得方式和各种加成效果
 * @details 该函数从称号映射表中查找指定称号的信息，并格式化输出其获得方式和各项属性加成。
 */
string query_title(object me, string title)
{
   string msg, msgg;
   mixed xg = titles[title];
   if (xg)
   {
      msg = chinesename["obtain"] + ":" + xg["obtain"] + "\n";
      msg += HIC + NOR + ZJBR "==================称号加成==================\n";
      if (xg["sm"])
         msg += chinesename["sm"] + ":\n" + xg["sm"] + "\n";
      foreach (msgg in keys(xg))
         if (intp(xg[msgg]))
            msg += HIY "(" + chinesename[msgg] + ")" NOR + HIW ":" + xg[msgg] + NOR "\n";
   }
   else
      msg = "该称号无任何加成\n";
   return msg;
}

/**
 * @brief 查询当前称号效果
 * @param object me 玩家对象
 * @return string 称号效果描述
 * @details 显示主称号和副称号的详细属性加成
 */
string query_current_title_effects(object me) {
    string main_title, *sub_titles, *active_auto_titles, *auto_titles, *bonus_parts;
    string msg = "";
    string *att, at;
    mapping current_attrs, auto_attrs;
    int main_bonus, sub_bonus, total_bonus, auto_bonus;
    mixed xg;
    mapping main_attrs = ([]), sub_attrs = ([]);
    int max_slots, used_slots;
    
    main_title = me->query("chenghao");
    sub_titles = query_sub_titles(me);
    max_slots = query_sub_title_slots(me);
    used_slots = sizeof(sub_titles);
    
    msg += HIY "==================称号系统==================\n" NOR;
    
    // 显示主称号信息
    if (main_title) {
        msg += HIY "主称号：" HIC + main_title + NOR + "\n";
    } else {
        msg += HIY "主称号：" HIR "未佩戴" NOR + "\n";
    }
    
    // 显示副称号信息
    msg += HIY "副称号槽位：" HIW + used_slots + "/" + max_slots + NOR;
    if (max_slots <= 0) {
        msg += HIR " (需要200级解锁)" NOR;
    }
    msg += "\n";
    
    if (sizeof(sub_titles) > 0) {
        msg += HIY "已佩戴副称号：" NOR;
        foreach (string sub_title in sub_titles) {
            msg += HIC + sub_title + NOR + " ";
        }
        msg += "\n";
    }
    
    // 显示无需佩戴即可生效的称号
    active_auto_titles = ({});
    auto_titles = keys(auto_active_titles);
    foreach (string auto_title in auto_titles) {
        if (me->query("titles/" + auto_title)) {
            active_auto_titles += ({ auto_title });
        }
    }
    if (sizeof(active_auto_titles) > 0) {
        msg += HIY "自动生效称号：" NOR;
        foreach (string auto_title in active_auto_titles) {
            msg += HIR + auto_title + NOR + " ";
        }
        msg += "\n";
    }
    
    // 获取当前实际生效的属性
    current_attrs = me->query("titlea");
    if (!current_attrs || !sizeof(current_attrs)) {
        return msg + HIR "当前没有称号属性加成。\n" NOR;
    }
    
    msg += HIC "==================总属性加成==================\n" NOR;
    
    // 计算主称号属性
    if (main_title && titles[main_title]) {
        xg = titles[main_title];
        att = keys(xg);
        foreach (at in att) {
            if (intp(xg[at])) {
                main_attrs[at] = xg[at];
            }
        }
    }
    
    // 计算副称号属性
    foreach (string sub_title in sub_titles) {
        if (titles[sub_title]) {
            xg = titles[sub_title];
            att = keys(xg);
            foreach (at in att) {
                if (intp(xg[at])) {
                    if (!sub_attrs[at]) {
                        sub_attrs[at] = 0;
                    }
                    sub_attrs[at] += xg[at] * 30 / 100;
                }
            }
        }
    }
    
    // 计算无需佩戴即可生效的称号属性
    auto_attrs = ([]);
    auto_titles = keys(auto_active_titles);
    foreach (string auto_title in auto_titles) {
        if (me->query("titles/" + auto_title) && titles[auto_title]) {
            xg = titles[auto_title];
            att = keys(xg);
            foreach (at in att) {
                if (intp(xg[at])) {
                    if (!auto_attrs[at]) {
                        auto_attrs[at] = 0;
                    }
                    auto_attrs[at] += xg[at];
                }
            }
        }
    }
    
    att = keys(current_attrs);
    foreach (at in att) {
        if (intp(current_attrs[at])) {
            main_bonus = main_attrs[at] ? main_attrs[at] : 0;
            sub_bonus = sub_attrs[at] ? sub_attrs[at] : 0;
            auto_bonus = auto_attrs[at] ? auto_attrs[at] : 0;
            total_bonus = current_attrs[at];
            
            msg += HIY "(" + chinesename[at] + ")" NOR + HIW ": +" + total_bonus + NOR;
            msg += HIB " (";
            bonus_parts = ({});
            if (main_bonus > 0) {
                bonus_parts += ({ "主称号+" + main_bonus });
            }
            if (sub_bonus > 0) {
                bonus_parts += ({ "副称号+" + sub_bonus });
            }
            if (auto_bonus > 0) {
                bonus_parts += ({ "自动称号+" + auto_bonus });
            }
            msg += implode(bonus_parts, ", ");
            msg += ")" NOR + "\n";
        }
    }
    
    return msg;
}

/**
 * @brief 检查对象是否满足特定称号/职位的所有要求
 * @param me 需要检查的对象，通常是玩家或角色对象
 * @param title 要验证的称号、职位或技能名称
 * @return int 如果满足所有要求返回1，否则返回0
 * @details 该函数会依次检查三项要求：属性需求（如力量、敏捷等）、技能需求（如剑法、轻功等）和威望需求。任何一项不达标都会向对象发送提示信息并返回0。
 */
int check_requirements(object me, string title) {
    string *allatt;
    mapping attribute;

    // 检查属性需求
    if (need_attribute[title]) {
        allatt = keys(need_attribute[title]);
        attribute = need_attribute[title];
        foreach (string att in allatt) {
            if (me->query(att) < attribute[att]) {
                tell_object(me, "你的" + chinesename[att] + "未达标。\n");
                return 0;
            }
        }
    }

    // 检查技能需求
    if (need_skill[title]) {
        allatt = keys(need_skill[title]);
        attribute = need_skill[title];
        foreach (string att in allatt) {
            if (me->query_skill(att, 1) < attribute[att]) {
                tell_object(me, "你的" + to_chinese(att) + "低于" + chinese_number(attribute[att]) + "级，未达标。\n");
                return 0;
            }
        }
    }

    // 检查威望需求
    attribute = titles[title];
    if (me->query("weiwang") < attribute["weiwang"]) {
        tell_object(me, "你的威望不够。\n");
        return 0;
    }

    return 1;
}

/**
 * @brief 购买称号
 * @param object me 玩家对象
 * @param string title 要购买的称号名称
 * @return int 1成功 0失败
 */
int buy_title(object me, string title) {
    mapping attribute;

    if (me->query("titles/" + title)) {
        tell_object(me, "你已获得该称号。\n");
        return 1;
    }

    if (!check_requirements(me, title)) {
        return 1;
    }

    attribute = titles[title];
    me->add("potential", attribute["weiwang"] / 10);
    me->add("weiwang", -attribute["weiwang"]);
    me->set("titles/" + title, 1);

    if (titles[title]["sm"]) {
        message("channel:chat", HBYEL + HIR "［" + title + "］" NOR "：" + me->query("name") + "：" + replace_string(titles[title]["sm"], "\n", " ") + "\n" NOR, users());
    }

    tell_object(me, "恭喜你获得称号" + HIR + title + "\n" NOR);
    
    // 重新计算属性以包含新获得的称号
    recalculate_title_effects(me);
    tell_object(me, HIY "你的称号属性已更新！\n" NOR);
    
    return 1;
}

/**
 * @brief 卸下主称号
 * @param object me 玩家对象
 * @return int 1成功 0失败
 */
int remove_title(object me)
{
    string current_title = me->query("chenghao");

    if (!current_title)
    {
        tell_object(me, "你当前没有佩戴任何主称号。\n");
        return 0;
    }

    me->delete("chenghao");
    
    // 重新计算属性（保留副称号效果）
    recalculate_title_effects(me);

    tell_object(me, HIR "你卸下了主称号：" HIC + current_title + NOR + "\n");
    
    return 1;
}

mapping alltitles()
{
	return titles;
}

/**
 * @brief 获取中文属性名映射
 * @return mapping 返回属性英文名到中文名的映射
 */
mapping query_chinese_attr_names()
{
	return chinesename;
}

/**
 * @brief 获取无需佩戴即可生效的称号映射
 * @return mapping 返回无需佩戴即可生效的称号映射
 */
mapping query_auto_active_titles()
{
	return auto_active_titles;
}

/**
 * @brief 检查指定称号是否为无需佩戴即可生效的称号
 * @param string title 称号名称
 * @return int 1为自动生效称号 0为普通称号
 */
int is_auto_active_title(string title)
{
	return auto_active_titles[title] ? 1 : 0;
}

/**
 * @brief 设置玩家的展示称号
 * @param object me 玩家对象
 * @param string title 要设置的展示称号名称
 * @return int 1成功 0失败
 * @details 展示称号仅用于对外显示，不影响实际属性加成
 */
int set_display_title(object me, string title)
{
    if (!title || title == "") {
        me->delete("display_chenghao");
        tell_object(me, HIR "你取消了展示称号。" NOR "\n");
        return 1;
    }
    
    if (!titles[title]) {
        tell_object(me, "该称号不存在。\n");
        return 0;
    }
    
    if (!me->query("titles/" + title)) {
        tell_object(me, "你还没有获得该称号。\n");
        return 0;
    }
    
    me->set("display_chenghao", title);
    tell_object(me, HIR "你设置了展示称号：" HIC + title + NOR + "\n");
    
    return 1;
}

/**
 * @brief 获取玩家的展示称号
 * @param object me 玩家对象
 * @return string 展示称号名称，如果没有设置则返回0
 */
string query_display_title(object me)
{
    return me->query("display_chenghao");
}

/**
 * @brief 清除玩家的展示称号
 * @param object me 玩家对象
 * @return int 1成功
 */
int remove_display_title(object me)
{
    me->delete("display_chenghao");
    tell_object(me, HIR "你清除了展示称号。" NOR "\n");
    return 1;
}