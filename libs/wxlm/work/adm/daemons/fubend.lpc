		"time": 1800,
		"team": 1,
	]),
	"baoshi": ([
		"name": "宝石矿洞",
		"time": 1800,
		"team": 1,
	]),
	"qiu": ([
		"name": "非不裘副本",
		"time": 600,  // 10分钟
		"team": 6,    // 最多6人的组队副本
	]),
	"bamaguan": ([
		"name": "白马关",
		"time": 3600,
		"team": 1,
	]),
	"kuihua": ([
		"name": "葵花秘境",
		"time": 3600,
