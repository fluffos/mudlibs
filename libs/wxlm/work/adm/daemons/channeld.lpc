	"wiz":  ([      "msg_speak": HIY "【巫师】%s：%s"NOR"\n",
			"msg_emote": HIY "【巫师】%s" NOR"\n",
			"msg_color": HIY,
			"name"     : "巫师",
			"only"     : "wiz",
			"intermud" : GCHANNEL,
			"intermud_emote"   : 1,
			"intermud_channel" : "wiz",
