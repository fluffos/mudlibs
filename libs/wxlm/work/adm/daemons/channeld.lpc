		]),
	"rultra":([     "msg_speak": WHT "【塞外宗师】%s：%s"NOR"\n",
			"msg_emote": WHT "【塞外宗师】%s" NOR"\n",
			"msg_color": WHT,
			"name"     : "塞外宗师",
			"for_listen": 1,
		]),
	"jiaoyi":([	"msg_speak": HIW "【拍卖】%s：%s"NOR"\n",
			"msg_color": HIW,
			"name"     : "拍卖场",
		]),

	"wuzun":([	
			"msg_speak": HIR "【武尊】%s：%s"NOR"\n",
