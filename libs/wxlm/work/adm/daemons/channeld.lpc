			"anonymous": "某人",
		]),
	"sos":  ([      "msg_speak": HIG "【求助】%s：%s"NOR"\n",
			"msg_color": HIG,
			"name_raw" : 1,
			"name"     : "求助",
		]),
	"party":([      "msg_speak": HIG "【帮派】%s：%s"NOR"\n",
			"msg_emote": HIG "【帮派】%s" NOR"\n",
			"msg_color": HIG,
			"only"     : "party",
