// topd.c - 玩家排行数据管理守护进程
// 功能:
// 1. 保存和管理所有玩家的排行相关数据
// 2. 提供数据查询和更新接口
// 3. 定期清理过期数据
// 4. 每周一自动重置师门任务数据

#pragma optimize

inherit F_SAVE;
inherit F_DBASE;

// 标记是否已执行本周重置
nosave int ok = 0;

// 清理30天未更新的玩家数据
void clean_old() 
{
    string *ids;

    if (!dbase) return;
    
    ids = keys(dbase);
    foreach (string id in ids) {
        // 如果数据超过30天未更新则删除
        if (time() - dbase[id]["last"] > 86400 * 30) {
            delete(id);
        }
    }
}

// 守护进程创建
void create()
{
    seteuid(getuid());
    restore();
    set_heart_beat(5);
    //clean_old();
}

// 守护进程移除时保存数据
varargs void remove(string euid)
{
    save();
}

// MUD关闭时保存数据
void mud_shutdown()
{
    save();
}

// 计算经验排名前十的玩家平均经验值
public int query_top10_exp_average()
{
    string *ids;
    mapping user_exp = ([]);
    string *top_ids;
    int total_exp = 0;
    int count = 0;
    
    if (!mapp(dbase) || sizeof(dbase) < 1)
        return 0;
    
    // 获取所有玩家ID
    ids = keys(dbase);
    
    // 构建ID到经验值的映射
    foreach (string id in ids) {
        if (mapp(dbase[id]) && !undefinedp(dbase[id]["combat_exp"]))
            user_exp[id] = dbase[id]["combat_exp"];
    }
    
    // 按经验值排序获取前十名
    top_ids = sort_array(keys(user_exp), (: $(user_exp)[$2] - $(user_exp)[$1] :));
    
    // 计算前十名的总经验值
    for (int i = 0; i < sizeof(top_ids) && i < 10; i++) {
        total_exp += user_exp[top_ids[i]];
        count++;
    }
    
    // 返回平均值，如果没有玩家则返回0
    return (count > 0) ? total_exp / count : 0;
}

// 返回所有玩家ID列表
public string *all_users()
{
    if (!dbase)
        return 0;
    return keys(dbase);
}

// 更新玩家数据
public void map_user(object user)
{
    string name;
    mapping info;

    info = ([]);
    
    // 巫师和特殊账号处理
	{
        // 普通玩家数据记录
        name = user->query("id");
        info["balance"] = user->query("balance");           // 存款
        info["name"] = user->query("name");                 // 名字
        info["per"] = user->query("per");                   // 容貌
        info["all_pay"] = user->query("zjvip/all_pay");     // 充值总额
        info["yuanbao"] = user->query("yuanbao");           // 元宝
        info["PKS"] = user->query("combat/PKS");            // PK数
        info["daoshi_exp"] = user->query("zjvip/daoshi_exp");// 导师经验
        info["dizi_fanli"] = user->query("zjvip/dizi_fanli");// 弟子返利
        info["combat_exp"] = user->query("combat_exp");      // 武学经验
		info["fuben_finish_time"] = user->query("fuben_finish_time");// 副本通关时间
        info["gold"] = MONEY_D->player_carry(user);          // 随身现金
        info["combat_power"] = COMBAT_D->calc_role_combat_power(user); // 武力
        info["daoshi_exp"] = user->query("zjvip/daoshi_exp");// 授业值 （用于名师殿堂榜排行）
        info["last"] = time();                              // 最后更新时间
        
        // 师门任务数据处理
        info["s_last"] = user->query("shimen/last");
        if (!same_week(info["s_last"], info["last"]))
            user->set("shimen/today", 0);
        info["shimen"] = user->query("shimen/today") || 0;
    }
    
    set(name, info);
}

// 增加师门任务计数
public void add_shimen(object user)
{
    string name;
    mapping info;

    if (!mapp(dbase)) return;
    
    name = user->query("id");

    // 如果是门客,记到主人名下
    if (user->query("master_id")) {
        name = user->query("master_id");
    }

    if (undefinedp(dbase[name])) return;
    
    info = dbase[name];
    info["shimen"] = (info["shimen"] || 0) + 1;
    set(name, info);
}

// 清空所有玩家的师门任务计数
public void clear_shimen()
{
    string *names;
    int i;

    if (!mapp(dbase)) return;
    
    names = keys(dbase);
    for (i = 0; i < sizeof(names); i++) {
        set(names[i] + "/shimen", 0);
    }
}

// 设置玩家数据
mixed set_user(string prop, mixed data)
{
    if (!mapp(dbase)) dbase = ([]);

    if (strsrch(prop, '/') != -1)
        return _set(dbase, explode(prop, "/"), data);

    dbase[prop] = data;
    return 1;
}

// 查询玩家数据
mixed query_user(string prop)
{
    mixed data;

    if (!mapp(dbase)) return 0;

    if (undefinedp(dbase[prop]) && (strsrch(prop, '/') != -1))
        data = _query(dbase, explode(prop, "/")); 
    else
        data = dbase[prop];

    return data;
}

// 根据ID获取玩家名字
string get_name(string id)
{
    if (!mapp(dbase)) return 0;
    return undefinedp(dbase[id]) ? "无名氏" : dbase[id]["name"];
}

// 心跳事件处理
void heart_beat()
{
    mixed *local;
    int day, sec;

    local = localtime(time());
    day = local[6];  // 星期几(0-6)
    sec = local[0];  // 秒数(0-59)

    // 每周一重置师门任务数据
    if (day == 1 && !ok) {
        clear_shimen();
        ok = 1;
    } else if (day != 1) {
        ok = 0;
    }

    // 每30秒保存一次数据
    if (sec % 30 == 0) {
        save();
    }
}

// 存档文件路径
string query_save_file() { return DATA_DIR "topd"; }