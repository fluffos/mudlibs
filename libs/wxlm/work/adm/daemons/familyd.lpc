// familyd.c 保存所有的门派信息
// 重构版本，将功能分散到各个头文件中

#pragma optimize

inherit F_SAVE;
inherit F_DBASE;

// 包含各功能模块
#include "/adm/daemons/familyd/core.h"      // 核心功能
#include "/adm/daemons/familyd/fame.h"      // 门派声望相关
#include "/adm/daemons/familyd/hatred.h"    // 门派仇恨相关
#include "/adm/daemons/familyd/rank.h"      // 门派等级和奖励相关
#include "/adm/daemons/familyd/wujue.h"     // 五绝相关
#include "/adm/daemons/familyd/shouxi.h"    // 首席弟子相关
#include "/adm/daemons/familyd/tianjige.h"  // 天机阁相关
#include "/adm/daemons/familyd/man.h"       // 门派人物相关

// 初始化
void create()
{
    // query_lunjian_leader("中神通");
    seteuid(getuid());
    restore();
    
    // 初始化各模块数据
    init_core_data();
    init_shouxi_data();
    init_wujue_data();
    init_tianjige_data(); 
    
    set_heart_beat(1800);
}

// 保存数据
varargs void remove(string euid)
{
    save();
}

// 服务器关闭时保存数据
public void mud_shutdown()
{
    save();
}

// 心跳：维护门派的通常信息
private void heart_beat()
{
    int t = time();
    
    if ((t / 86400) != (last_check / 86400))
    {
        // 周日：清空五绝记录
        if(localtime(t)[6] == 0)
        {
            reset_wujue_data();
        }
        
        // 周六：清空首席弟子记录
        if(localtime(t)[6] == 6)
        {
            reset_shouxi_data();
        }

        // 更新门派声望缓存
        update_family_fame_cache();
        
        // 更新检查时间
        update_check_time();
    }

    // 保存门派的最新信息
    save();
} 