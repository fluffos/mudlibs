/**
    * @brief 获取玩家所有门派信息（主门派和留学门派）
    * @param object me 玩家对象
    * @return mapping 包含所有门派信息的mapping
    * @details 调用多门派管理器接口获取玩家的主门派和所有留学门派信息，包含完整的错误处理
    */
mapping get_player_all_families(object me)
{
    object multi_family_master;
    mapping family_info, result;
    string main_family;

    // 输入参数验证
    if (!me)
    {
        return ([ "error": "玩家对象无效", "families": ({}) ]);
    }

    if (!objectp(me))
    {
        return ([ "error": "传入的不是有效对象", "families": ({}) ]);
    }

    result = ([ "success": 1 ]);

    // 获取主门派信息，加强错误处理
    catch(main_family = me->query("family/family_name"));

    if (!main_family || main_family == "" || main_family == 0)
    {
        result["main_family"] = "";
        result["families"] = ({});
        result["warning"] = "玩家未加入任何门派";
    }
    else
    {
        result["main_family"] = main_family;
        result["families"] = ({ main_family });
    }

    // 尝试加载多门派管理器，使用更强的异常处理
    multi_family_master = 0;
    catch
    {
        multi_family_master = load_object("/adm/special_ob/multi_family/multi_family_master");
    };

    if (!multi_family_master)
    {
        // 多门派管理器不可用，记录警告但不影响基础功能
        result["warning"] = (result["warning"] || "") + "多门派管理器不可用，仅显示主门派信息。";
        return result;
    }

    // 多门派管理器已加载，继续调用其接口

    // 调用多门派管理器获取门派信息
    family_info = 0;
    catch
    {
        family_info = multi_family_master->get_family_info(me);
    };

    if (!family_info)
    {
        result["warning"] = (result["warning"] || "") + "无法调用多门派管理器接口。";
        return result;
    }

    if (!mapp(family_info) || family_info["error"])
    {
        // 获取门派信息失败，记录错误但不中断
        result["warning"] = (result["warning"] || "") +
            (family_info["error"] || "多门派管理器返回错误信息");
        return result;
    }

    // 安全处理留学门派信息
    if (mapp(family_info["family_info"]))
    {
        string *all_families;

        all_families = result["families"] || ({});

        catch
        {
            foreach (string key, mixed val in family_info["family_info"])
            {
                if (key == "family_1") continue; // 跳过主门派

                // 严格验证留学门派数据
                if (mapp(val) && val["family_name"] &&
                    stringp(val["family_name"]) && val["family_name"] != "")
                {
                    // 避免重复添加
                    if (member_array(val["family_name"], all_families) == -1)
                    {
                        all_families += ({ val["family_name"] });
                    }
                }
            }
        };

        result["families"] = all_families;
        result["family_info"] = family_info;
    }

    return result;
}

/**
    * @brief 获取玩家可用的根本法意境列表
    * @param object me 玩家对象
    * @return string* 可用的根本法意境名称数组
    * @details 基于玩家的所有门派（主门派和留学门派）返回可学习的根本法意境列表，包含错误处理
    */
string *get_available_genbenfa_list(object me)
{
    mapping all_families;
    string *families, *available_list;

    // 输入参数验证
    if (!me || !objectp(me))
    {
        return ({});
    }

    available_list = ({});

    // 获取玩家所有门派信息
    all_families = get_player_all_families(me);

    if (!mapp(all_families))
    {
        return ({});
    }

    families = all_families["families"];

    if (!arrayp(families))
    {
        return ({});
    }

    // 安全遍历每个门派，添加对应的根本法意境
    catch
    {
        foreach (string family_name in families)
        {
            // 严格验证门派名称
            if (!family_name || !stringp(family_name) || family_name == "")
                continue;

            // 验证门派是否在意境列表中存在
            if (!mapp(center_yi_name_list) || !center_yi_name_list[family_name])
                continue;

            // 验证意境列表是否为数组
            if (!arrayp(center_yi_name_list[family_name]))
                continue;

            // 安全添加门派意境
            foreach (string yi_name in center_yi_name_list[family_name])
            {
                if (stringp(yi_name) && yi_name != "")
                {
                    available_list += ({ yi_name });
                }
            }
        }
    };

    // 安全移除重复项
    catch
    {
        string *unique_list = ({});
        foreach (string item in available_list)
        {
            if (member_array(item, unique_list) == -1)
            {
                unique_list += ({ item });
            }
        }
        available_list = unique_list;
    };

    if (!arrayp(available_list))
    {
        available_list = ({});
    }

    // 安全添加通用意境（遗训）
    catch
    {
        if (mapp(center_yi_name_list_two))
        {
            string *yixun_keys;

            yixun_keys = keys(center_yi_name_list_two);
            if (arrayp(yixun_keys))
            {
                foreach (string yi_name in yixun_keys)
                {
                    if (stringp(yi_name) && yi_name != "")
                    {
                        available_list += ({ yi_name });
                    }
                }
            }
        }
    };

    // 最终安全检查，确保返回数组
    if (!arrayp(available_list))
    {
        return ({});
    }

    return available_list;
}

// 获取第二意境介绍
string get_second_aoyi_desc(string yi_name)
{
    string family_type, desc;

    if (!yi_name || !center_yi_name_list_two[yi_name])
    {
        family_type = HIR"根本法"NOR;
        desc = sprintf(HIC"%s"NOR" - %s意境\n", yi_name||"未知", family_type);
        desc += "门派根本法意境，用于增强门派主要武学的威力和赋能效果。\n";
    }
    else 
    {
        family_type = HIB"遗训"NOR;
        desc = sprintf(HIC"%s"NOR" - %s意境\n", yi_name, family_type);
        // 根据不同意境添加效果描述
        desc += center_yi_name_list_two[yi_name];
    }
    
    return popup_comb(desc, ({"领悟:choose_aoyi " + yi_name, "返回:use aoyi_book"}));
}


mixed lingwu(object me,string family_name,string yi_name)
{
    string *all_available_yi;
    string *yi_name_list, *available_families;
    mapping all_families;
    int max_level = (9 + ((me->query("level") - 100) / 100));
    int is_yixun = 0;
    int genbenfa_level = 0;
    int required_canye = 0;
    int success_rate;
    int family_valid = 0;

    if (!me)
    {
        return msg299("意境系统","玩家对象无效。");
    }

    // 获取玩家所有门派信息
    all_families = get_player_all_families(me);

    if (!mapp(all_families) || !arrayp(all_families["families"]) || !sizeof(all_families["families"]))
    {
        return msg299("意境系统","请先加入一个门派。");
    }

    available_families = all_families["families"];

    if (!family_name)
    {
        return msg299("意境系统","请先加入一个门派。");
    }

    // 验证指定门派是否为玩家的门派（主门派或留学门派）
    if (member_array(family_name, available_families) != -1)
    {
        family_valid = 1;
    }

    if (!family_valid)
    {
        return msg299("意境系统","你不是" + family_name + "的弟子，无法学习该门派的根本法意境。");
    }

    if (undefinedp(center_yi_name_list[family_name]))
    {
        return msg299("意境系统","出错,没有这个门派的核心意境,请反馈管理员。");
    }

    yi_name_list = center_yi_name_list[family_name];

    yi_name_list += keys(center_yi_name_list_two);

    if (!yi_name)
    {
        string msg = "请选择你要领悟的意境：\n";
        string *yi_name_list_button = ({});

        // 使用新函数获取完整的可用意境列表
        all_available_yi = get_available_genbenfa_list(me);

        foreach (string single_yi_name in all_available_yi)
        {
            string family_tag, yi_type;

            // 确定意境类型和门派归属
            if (center_yi_family_name_list[single_yi_name] == "通用")
            {
                yi_type = HIB"遗训"NOR;
                family_tag = "通用";
            }
            else
            {
                yi_type = HIR"根本法"NOR;
                family_tag = center_yi_family_name_list[single_yi_name];
            }

            yi_name_list_button += ({sprintf("%s[%s-%s]:choose_aoyi_query %s",
                single_yi_name, yi_type, family_tag, single_yi_name)});
        }

        return popup_comb(msg, yi_name_list_button);
    }

    // 验证意境是否可学习（基于玩家所有门派）

    all_available_yi = get_available_genbenfa_list(me);

    if (member_array(yi_name, all_available_yi) == -1)
    {
        return msg299("意境系统","你无法学习" + yi_name + "这个意境，可能因为不是对应门派的弟子。");
    }

    if (me->query("skill_aoyi/" + yi_name) >= max_level)
    {
        return msg299("意境系统","你的" + yi_name + "的境界已经领悟到极致了,以你修为目前只能领悟到" + max_level + "层。");
    }

    //如果已经存在一个意境，必须等宗师才能解锁第二个意境
    if (me->query("skill_aoyi") && !me->query("opinion/ultra") && sizeof(keys(me->query("skill_aoyi"))) > 0 && !me->query("skill_aoyi/" + yi_name))
    {
        return msg299("意境系统","你已经领悟了一种意境，必须成为宗师才能领悟第二种意境。");
    }

    // 判断是否为先学遗训
    is_yixun = (center_yi_family_name_list[yi_name] == "通用");

    if (is_yixun)
    {
        int max_yixun_level = 0;

        //是否有根本法
        if (!me->query("skill_aoyi"))
        {
            return msg299("意境系统","你还没有根本法，无法领悟先学遗训。");
        }

        // 计算所有根本法意境的最高等级
        foreach (string skill_name in keys(me->query("skill_aoyi")))
        {
            if (center_yi_family_name_list[skill_name] != "通用" && 
                me->query("skill_aoyi/" + skill_name) > genbenfa_level)
            {
                genbenfa_level = me->query("skill_aoyi/" + skill_name);
            }
        }

        // 先学遗训等级不能超过根本法等级的1/3
        max_yixun_level = genbenfa_level / 3 + 1;
        if (me->query("skill_aoyi/" + yi_name) >= max_yixun_level)
        {
            return msg299("意境系统","你的根本法意境等级不足，无法继续提升" + yi_name + "。需要根本法意境达到" + 
                        (me->query("skill_aoyi/" + yi_name) + 1) * 3 + "级才能继续提升。");
        }

        // 检查残页数量
        required_canye = 100;
        if (me->query("aoyi_canye/" + yi_name) < required_canye)
        {
            return msg299("意境系统","提升" + yi_name + "需要" + required_canye + "张对应的残页，你只有" + 
                        me->query("aoyi_canye/" + yi_name) + "张。");
        }
    }

    if (me->query("skill_aoyi/" + yi_name) < max_level)
    {
        // 计算成功率
        if (is_yixun)
        {
            //1层2张，2层3张依次类推
            success_rate = (me->query("skill_aoyi/" + yi_name)) + 2;
            me->add("yixun_lingwu/" + yi_name,1);

            if (me->query("yixun_lingwu/" +  yi_name) >= success_rate)
            {
                tell_object(me,popup_comb("你领悟了" + yi_name + "的核心意境，" + yi_name + "的境界提升了一层,当前" + yi_name + "的境界为" + (me->query("skill_aoyi/" + yi_name) + 1) + "层。",({"继续领悟:choose_aoyi " + yi_name,"返回:use aoyi_book"})));
                me->add("skill_aoyi/" + yi_name,1);
                me->delete("yixun_lingwu/" + yi_name);
                // 成功则消耗残页
                me->add("aoyi_canye/" + yi_name, -required_canye);
                return 1;
            }
            else
            {
                // 计算当前领悟进度
                int current_progress = me->query("yixun_lingwu/" + yi_name);
                int total_needed = success_rate;
                int progress_percent = current_progress * 100 / total_needed;
                
                // 提示玩家当前领悟进度
                tell_object(me, popup_comb(
                    "你尝试领悟" + yi_name + "的奥义，有所感悟但尚未完全突破。\n" +
                    "当前领悟进度：" + current_progress + "/" + total_needed + 
                    "（" + progress_percent + "%）",
                    ({"继续领悟:choose_aoyi " + yi_name, "返回:use aoyi_book"})
                ));

                return 1;
            }
        }
        else if (me->query("skill_aoyi/" + yi_name) >= 9)
        {
            // 根本法九级以后成功概率只有25%,逐渐递减5%，最低5%
            success_rate = 2 + (me->query("skill_aoyi/" + yi_name) - 9);
            me->add("benfa_lingwu/" + yi_name,1);

            if (me->query("benfa_lingwu/" + yi_name) < success_rate)
            {
                // 计算当前领悟进度
                int current_progress = me->query("benfa_lingwu/" + yi_name);
                int total_needed = success_rate;
                int progress_percent = current_progress * 100 / total_needed;
                
                // 提示玩家当前领悟进度
                tell_object(me, popup_comb(
                    "你尝试领悟" + yi_name + "的奥义，有所感悟但尚未完全突破。\n" +
                    "当前领悟进度：" + current_progress + "/" + total_needed + 
                    "（" + progress_percent + "%）",
                    ({"继续领悟:choose_aoyi " + yi_name, "返回:use aoyi_book"})
                ));
                return 1;
            }
            else
            {
                // 成功破限，给出破限描述
                tell_object(me, HIY "你突然心有所悟，对" + yi_name + "的理解有了质的飞跃！\n" NOR);
                tell_object(me, HIW "你感觉自己对" + yi_name + "的领悟已经突破了该意境的极限，你对该意境的理解以及超越了前人！\n" NOR);

                tell_object(me,popup_comb("你领悟了" + yi_name + "的核心意境，" + yi_name + "的境界提升了一层,当前" + yi_name + "的境界为" + (me->query("skill_aoyi/" + yi_name) + 1) + "层。",({"继续领悟:choose_aoyi " + yi_name,"返回:use aoyi_book"})));
                me->add("skill_aoyi/" + yi_name,1);
                me->delete("benfa_lingwu/" + yi_name);
                return 1;   
            }
        }

        tell_object(me,popup_comb("你领悟了" + yi_name + "的核心意境，" + yi_name + "的境界提升了一层,当前" + yi_name + "的境界为" + (me->query("skill_aoyi/" + yi_name) + 1) + "层。",({"继续领悟:choose_aoyi " + yi_name,"返回:use aoyi_book"})));
        me->add("skill_aoyi/" + yi_name,1);

        return 1;
    }
    else
    {
        return msg299("意境系统","等级达到已达上限，无法继续领悟。");
    }

    return msg299("意境系统","出错,请反馈管理员。");
}

//判定一个意境是否通用
int is_general_aoyi(string yi_name)
{
    return center_yi_family_name_list[yi_name] == "通用";
}

/**
    * @brief 获取意境与门派名称的映射关系
    * @return mapping 意境名称到门派名称的映射
    * @details 返回center_yi_family_name_list映射，供其他模块使用
    */
mapping get_center_yi_family_name_list()
{
    return center_yi_family_name_list;
}


/**
    * @brief 返回玩家所学意境信息，包含门派归属显示
    * @param object me 玩家对象
    * @return string 格式化的意境信息字符串
    * @details 更新后的函数会显示每个意境的门派归属，区分主门派和留学门派的意境
    */
string get_yi_info(object me)
{
    string msg;
    mapping yi_info, all_families;
    string *aoyi_general_list, *player_families, main_family;

    if (!me)
    {
        return popup_title("玩家对象无效。");
    }

    yi_info = me->query("skill_aoyi");
    aoyi_general_list = ({});

    if (!yi_info)
    {
        return popup_title("你还没有学会任何意境。");
    }

    // 获取玩家所有门派信息
    all_families = get_player_all_families(me);
    if (mapp(all_families))
    {
        player_families = all_families["families"] || ({});
        main_family = all_families["main_family"] || "";
    }
    else
    {
        player_families = ({});
        main_family = "";
    }

    msg = HIC"你目前学会的意境有：\n"NOR;

    if (sizeof(player_families) > 1)
    {
        msg += HIY"你的门派：" + implode(player_families, "、") + "\n"NOR;
        msg += HIY"主门派：" + (main_family ? main_family : "未知") + "\n\n"NOR;
    }

    foreach (string yi_name in keys(yi_info))
    {
        string aoyi_level, family_display, yi_type;

        aoyi_level = "零层";

        if (nullp(center_yi_family_name_list[yi_name]))
        {
            // 回退卷轴
            object aoyi_book;
            aoyi_book = new_bind("/clone/aoyi_book/aoyi_book");
            aoyi_book->set_amount(yi_info[yi_name]);

            tell_object(me, "你的" + yi_name + "意境已被系统回退，并返还了" + yi_info[yi_name] + "个卷轴。\n");
            aoyi_book->move(me);

            me->delete("skill_aoyi/" + yi_name);
            continue;
        }

        if (yi_info[yi_name] > 9)
        {
            aoyi_level = HIR"破限" + chinese_number(yi_info[yi_name] - 9) + "层" NOR;
        }
        else
        {
            aoyi_level = HIG + chinese_number(yi_info[yi_name]) + "层" NOR;
        }

        // 确定意境类型和门派归属显示
        if (is_general_aoyi(yi_name))
        {
            yi_type = HIC"先学遗训"NOR;
            family_display = HIB"通用"NOR;
        }
        else
        {
            yi_type = HIR"根本法"NOR;

            // 判断是主门派还是留学门派的意境
            if (center_yi_family_name_list[yi_name] == main_family)
            {
                family_display = HIG + center_yi_family_name_list[yi_name] + "(主门派)" + NOR;
            }
            else if (member_array(center_yi_family_name_list[yi_name], player_families) != -1)
            {
                family_display = HIY + center_yi_family_name_list[yi_name] + "(留学门派)" + NOR;
            }
            else
            {
                family_display = HIR + center_yi_family_name_list[yi_name] + "(已脱离)" + NOR;
            }
        }

        msg += sprintf("%s(%s)(%s-%s)\n", yi_name, aoyi_level, family_display, yi_type);

        if (!me->query("aoyi_general/" + yi_name) && me->query("aoyi_general_number") < 3 && is_general_aoyi(yi_name))
        {
            aoyi_general_list += ({"装配-" + yi_name + ":yj_skill set " + yi_name});
        }
    }

    if (me->query("aoyi_general"))
    {
        msg += HIB"你装配的先学遗训有：\n"NOR;

        foreach (string yi_name in keys(me->query("aoyi_general")))
        {
            msg += sprintf("%s(%s)\n", yi_name, center_yi_family_name_list[yi_name]);
            aoyi_general_list += ({"卸载-" + yi_name + ":yj_skill remove " + yi_name});
        }
    }

    return popup_comb(msg, aoyi_general_list + ({"残页进度:yj_skill canye_list","返回:new_family"}));
}


