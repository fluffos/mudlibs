#pragma optimize


inherit F_DBASE;

void create()
{
	seteuid(ROOT_UID);
	set("channel_id", "执法精灵");
	CHANNEL_D->do_channel( this_object(), "sys", "执法精灵已经启动。");
	remove_call_out("monitor");
	call_out("monitor", 1);
}

int clean_up() { return 1; }

void family_punish();

