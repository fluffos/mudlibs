// aliasd.c

#pragma optimize


mapping global_alias = ([
	"l":		"look",
	"n":		"go north",
	"e":		"go east",
	"w":		"go west",
	"s":		"go south",
	"nu":		"go northup",
	"eu":		"go eastup",
	"wu":		"go westup",
	"su":		"go southup",
	"nd":		"go northdown",
	"ed":		"go eastdown",
	"wd":		"go westdown",
	"sd":		"go southdown",
	"ne":		"go northeast",
	"se":		"go southeast",
	"nw":		"go northwest",
	"sw":		"go southwest",
	"u":		"go up",
	"d":		"go down",
	"i":		"inventory",
	"tt":		"team talk",
	"tt*":	"team emote",
]);

string process_global_alias(string arg)
{
    string *word;
    string command;

    // 处理以单引号开头的命令
    if (arg[0] == '\'')
    {
        command = "say " + arg[1..];
        return command;
    }
    // 处理以点号开头的命令
    else if (arg[0] == '.')
    {
        command = "skip " + arg[1..];
        return command;
    }

    // 拆分输入的命令
    word = explode(arg, " ");
    // 检查第一个单词是否在全局别名中
    if (sizeof(word) > 0 && undefinedp(global_alias[word[0]]) == 0)
    {
        word[0] = global_alias[word[0]];
        return implode(word, " ");
    }

    return arg;
}
