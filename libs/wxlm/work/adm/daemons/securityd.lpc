/**
 * @file securityd.c
 * @author Lu Dexiang
 * @brief MUD安全守护进程
 * @version 2.0
 * @date 2024-01-01
 *
 * @details
 * 本模块是MUD系统的核心安全模块,负责:
 * 1. 用户权限管理
 * 2. 文件读写权限控制
 * 3. 命令授权管理
 * 4. 站点特权管理
 * 5. 对象绑定验证
 *
 * @note
 * Version 2.0 重构说明:
 * - 将原1065行的单一文件拆分为9个功能模块
 * - 采用模块化设计,提高代码可读性和可维护性
 * - 保持100%向后兼容,所有公共接口保持不变
 */

#pragma optimize

#include <login.h>
#include <mudlib.h>
#include <localtime.h>
inherit F_SAVE;

//=============================================================================
// 模块引入
//=============================================================================

// 数据结构和常量定义模块
#include "/adm/daemons/security/security_data.h"

// 函数声明
mapping query_security(string para);
int     set_security(string para, mapping ruler);
mapping combine_rules(mapping def, mapping extend);
void    reset_security();
int     restore();
int     save();

// 初始化与数据持久化模块
#include "/adm/daemons/security/security_init.h"

// 安全规则管理模块
#include "/adm/daemons/security/security_rules.h"

// 巫师等级管理模块
#include "/adm/daemons/security/security_wizard.h"

// 文件权限验证模块(核心功能)
#include "/adm/daemons/security/security_permission.h"

// 对象安全验证模块
#include "/adm/daemons/security/security_object.h"

// 命令授权管理模块
#include "/adm/daemons/security/security_command.h"

// 站点特权管理模块
#include "/adm/daemons/security/security_site.h"

// 文件备份功能模块
#include "/adm/daemons/security/security_backup.h"
