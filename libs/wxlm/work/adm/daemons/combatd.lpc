// combatd.c

#pragma optimize

#define DEFAULT_MAX_PK_PERDAY	   3
#define DEFAULT_MAX_PK_PERMAN	   1
#define AOYI_D "/adm/daemons/aoyid"
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_DBASE;
// 经验底线(random(my_exp) > EXP_LIMIT，则不加经验)
#define	EXP_LIMIT	20000000

void create()
{
	int pd, pm;

	seteuid(getuid());
	set("channel_id", "战斗精灵");

	if (undefinedp(pd = CONFIG_D->query_int("max pk perday")))
		pd = DEFAULT_MAX_PK_PERDAY;

	if (undefinedp(pm = CONFIG_D->query_int("max pk perman")))
		pm = DEFAULT_MAX_PK_PERMAN;

	set("pk_perday", pd);
	set("pk_perman", pm);
}

//战斗状态消息的模块
#include "/adm/daemons/combat/combat_status_msg.h"

//技能威力处理模块
#include "/adm/daemons/combat/combat_skill_power.h"

//普通攻击模块
#include "/adm/daemons/combat/combat_do_attack.h"

//技能单招模块
#include "/adm/daemons/combat/combat_do_damage.h"

//战斗一些技能支持反震机制，这个就是用于处理战斗反震机制的模块。
#include "/adm/daemons/combat/combat_do_respond.h"

//处理是处理两个对象（me 和 victim）之间的战斗逻辑。
// 具体来说，这个模块的作用是根据不同的条件决定是否进行攻击、进行多少次攻击以及是否进行防御。
#include "/adm/daemons/combat/combat_auto_fight.h"

//处理玩家仇恨相关的模块代码
#include "/adm/daemons/combat/combat_hatred.h"

//处理一个可能玩家的逃脱到侠客岛的代码
#include "/adm/daemons/combat/combat_player_escape.h"

//用于处理战斗中可能出现的一些人物状态的模块的回调接口。如：人物死亡，人物昏迷，人物从昏迷中清醒后进行的处理
#include "/adm/daemons/combat/combat_announce.h"

//战斗中胜利者奖励代码
#include "/adm/daemons/combat/combat_killer_reward.h"

//战斗时护甲的影响效果以及不同战斗类型（pvp和pve）的额外处理
#include "/adm/daemons/combat/combat_calc_pk.h"

//战斗中其他特效的处理代码
#include "/adm/daemons/combat/combat_other_power.h"

//战斗中毒的处理代码
#include "/adm/daemons/combat/combat_poison.h"

//元素的处理代码
#include "/adm/daemons/combat/combat_elements.h"