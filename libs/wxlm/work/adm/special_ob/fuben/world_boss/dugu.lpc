
inherit NPC;
void destruct_me();
void create()
{
	set_name("青年-独孤求败", ({ "dugu qiubai", "dugu" }) );
	set("title", HIC "大宗师" NOR);
	set("gender", "男性");
	set("age", 48);
	set("long", "此人便是传说中的剑圣独孤求败，一生追求武学至高境界，无人能敌。\n"
		    "他身形挺拔如松，眉宇间透露着无尽的自信与傲气，手中长剑寒光凛冽。\n"
		    "据说他创出了「九剑归一」的绝世剑法，此刻已经领悟了最高真义，自创不败神功，天下兵武尽归其手，堪称当世第一人。\n");
	set("attitude", "peaceful");
	set("str", 38);
	set("int", 39);
	set("con", 32);
	set("dex", 33);

	set("max_qi", 24000000);
	set("max_jing", 15000000);
	
	set("neili", 50000);
	set("max_neili", 50000);
	set("jiali", 50);

	set("combat_exp", 500000000);

	set_skill("unarmed", 600);
	set_skill("sword", 600);
	set_skill("blade", 600);
	set_skill("staff", 600);
	set_skill("hammer", 600);
	set_skill("club", 600);
	set_skill("whip", 600);
	set_skill("dagger", 600);
	set_skill("throwing", 600);
	set_skill("parry", 600);
	set_skill("dodge", 600);
	set_skill("xinfa", 600);
	set_skill("force", 600);
	set_skill("never-defeated", 600);
	set_skill("martial-cognize", 600);

	map_skill("force", "never-defeated");
	map_skill("dodge", "never-defeated");
	map_skill("sword", "never-defeated");
	map_skill("parry", "never-defeated");


	set("opinion/ultra",  1);
	set("opinion/master", 1);

	set("chat_chance_combat", 120);
	set("chat_msg_combat", ({
		(: exert_function, "powerup" :),
		(: exert_function, "shield" :),
		(: perform_action, "sword.juemie" :),
		(: perform_action, "sword.lei" :),
		(: perform_action, "sword.po" :),
		(: perform_action, "sword.tianhua" :),
		(: perform_action, "sword.wanli" :),
		(: perform_action, "sword.juemie" :),
		(: perform_action, "sword.yuce" :),
	}) );

	set("rank_info/self", "在下");

	//增加伤害2000
	set_temp("apply/damage", 3000);
	//增加防御2000
	set_temp("apply/armor", 3000);

	setup();
	carry_object("/clone/cloth/cloth")->wear();
	carry_object("/clone/weapon/zhujian")->wield();

	// 20分钟后，自我销毁，并设定一个参数
	call_out("destruct_me", 2400);
}


//心跳函数，检查是否有兵器如果没有carry_object("/clone/weapon/zhujian")->wield();
void heart_beat()
{
	if (! objectp(query_temp("weapon")))
	{
		carry_object("/clone/weapon/zhujian")->wield();
	}

	//20的概率随机释放招式，对所有对手造成1w伤害
	if (random(5) == 0)
	{
		object *enemy;
		string msg;
		
		// 获取所有敌人
		enemy = query_enemy();
		
		// 过滤掉非玩家的敌人
		enemy = filter_array(enemy, (: userp($1) :));
		
		if (sizeof(enemy) > 0)
		{
			// 随机选择一种招式的描述
			switch (random(4))
			{
				case 0:
					msg = HIB "$N" HBRED "手中竹剑挥舞，一招「天花乱坠」，剑气纵横，笼罩四面八方！"NOR"\n";
					break;
				case 1:
					msg = HIC "$N" HBRED "怀抱竹剑，一招「晴空万里」，剑气如圈圈波纹向四周扩散！"NOR"\n";
					break;
				case 2:
					msg = HIY "$N" HBRED "手指一合一弹，一招「御策器决」，竹剑发出龙吟之声直刺而出！"NOR"\n";
					break;
				default:
					msg = HIW "$N" HBRED "一声长啸，不败神功发挥到极致，无形剑气席卷全场！"NOR"\n";
					break;
			}
			
			message_vision(msg, this_object());
			
			// 对所有敌人造成伤害
			foreach (object ob in enemy)
			{
				if (objectp(ob) && living(ob))
				{
					if (random(2) == 0)
					{
						ob->receive_damage("qi", 10000, this_object());
						ob->receive_wound("qi", 5000, this_object());
						tell_object(ob, HIR "你只觉一股凌厉无匹的剑气扑面而来，如同千万柄利剑同时穿透身体，五脏六腑仿佛被撕裂般剧痛"NOR"！\n"HIR"独孤求败的不败剑意已深入你的经脉，气血瞬间流失10000点！"NOR"\n");
					}
					else
					{
						ob->receive_damage("jing", 2000, this_object());
						ob->receive_wound("jing", 1000, this_object());
						tell_object(ob, HIB "你只觉一股无形剑意直冲脑海，神魂震荡，精神恍惚，仿佛置身于万剑归宗之境"NOR"！\n"HIB"独孤求败的剑道意境摧毁你的心神，精神瞬间流失2000点！"NOR"\n");
					}

					//等级低于300一次性攻击5w气血
					if (ob->query("level") < 300)
					{
						ob->receive_damage("qi", 50000, this_object());
						ob->receive_wound("qi", 25000, this_object());
						tell_object(ob, HIR "你只觉一股凌厉无匹的剑气扑面而来，如同千万柄利剑同时穿透身体，五脏六腑仿佛被撕裂般剧痛"NOR"！\n"HIR"独孤求败的不败剑意已深入你的经脉，气血瞬间流失50000点！"NOR"\n");
					}
				}
			}
		}
	}

	::heart_beat();
}

varargs void die(object me)
{
	object killer_list;
	object player;

	if (! objectp(me))
	{
		player = this_object()->query_last_damage_from();
	}
	else
	{
		player = me;
	}

	// 检查我死亡之前有那些敌人, 记录下来，检查当前地图上的所有玩家
	killer_list = this_object()->query_enemy();

	//过滤掉非玩家的敌人
	killer_list = filter_array(killer_list, (: userp($1) :));

	// 过滤掉和我不在同一地点的敌人
	killer_list = filter_array(killer_list, (: environment($1) == environment($2) :), this_object());

	if (sizeof(killer_list))
	{
		//遍历所有的敌人，给予奖励
		foreach (object killer in killer_list)
		{
			int exp, pot, yuanbao;
		
			
			if (!objectp(killer) || !killer->query("opinion/ultra") || killer->query("sanhua_done"))
			continue;

			exp = 10000 + random(10000); // 1-2万经验
			pot = 20000 + random(10000); // 2-3万潜能
			yuanbao = 20; // 20绑定元宝
			
			killer->add("combat_exp", exp);
			killer->add("potential", pot);
			killer->add("bind_yuanbao", yuanbao);

			{
				// 设定一个随机数，用于掉落物品判断
				int random_drop = random(100);
				
				// 30%概率掉落金砂
				if (random_drop < 30) {
					object jinsha = new_bind("/clone/vip/jinsha");
					jinsha->move(killer);
					tell_object(killer, HIY "你获得了一个金砂！\n" NOR);
				}
				// 20%概率掉落强化石
				else if (random_drop < 50) {
					object qianghua = new_bind("/clone/vip/qianghua_shi");
					qianghua->move(killer);
					tell_object(killer, HIY "你获得了一个强化石！\n" NOR);
				}
				// 10%概率掉落低级强化符
				else if (random_drop < 60) {
					object hufu = new_bind("/clone/vip/dijibao_hufu");
					hufu->move(killer);
					tell_object(killer, HIY "你获得了一个低级强化符！\n" NOR);
				}
				// 10%概率掉落中级强化符
				else if (random_drop < 70) {
					object hufu = new_bind("/clone/vip/zhongjibao_hufu");
					hufu->move(killer);
					tell_object(killer, HIY "你获得了一个中级强化符！\n" NOR);
				}
				// 10%概率掉落高级强化符
				else if (random_drop < 80) {
					object hufu = new_bind("/clone/vip/gaojibao_hufu");
					hufu->move(killer);
					tell_object(killer, HIY "你获得了一个高级强化符！\n" NOR);
				}
				//10%掉落九转金丹
				else if (random_drop < 90) {
					object jindan = new_bind("/clone/vip/dan_jiuzhuan");
					jindan->move(killer);
					tell_object(killer, HIY "你获得了一个九转金丹！\n" NOR);
				}
				//10%掉落词符
				else if (random_drop < 100) {
					object cufu = new_bind("/clone/vip/cifu");
					cufu->move(killer);
					tell_object(killer, HIY "你获得了一个词符！\n" NOR);
				}
				
				
				
			}
			
			tell_object(killer, HIG "你获得了" + exp + "点经验、" + pot + "点潜能和" + yuanbao + "点绑定元宝。\n" NOR);


			{
				if (!killer->query("dugu_baozang/number") || random(100) < 30)
				{
					object baozang = new_bind("/clone/baoxiang/dugu-baozang");
					baozang->move(killer);
					tell_object(killer, HIY "你获得了一个独孤宝藏！\n" NOR);
				}
			}

		}
	}

	message("vision", "\n"HIR + name() + "仰天长啸，胸口一震，喷出一道血箭，"
		"身形如秋风落叶般飘然而去，转瞬消失于天地之间。"NOR"\n", environment());
	command("chat 天下英雄如过江之鲫，独孤求败，今日败矣！");
	destruct_me();
}

void destruct_me()
{
	remove_call_out("destruct_me");
	destruct(this_object());
}