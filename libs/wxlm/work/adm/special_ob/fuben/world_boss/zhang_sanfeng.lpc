inherit NPC;
void destruct_me();

void distribute_items(object player);
void special_attack_phase3(object *enemy);
void special_attack_phase2(object *enemy);
void special_attack_phase1(object *enemy);
void create()
{
	set_name("武当祖师-张三丰", ({ "zhang sanfeng", "zhang", "sanfeng" }) );
	set("title", HIW "武圣" NOR);
	set("gender", "男性");
	set("age", 108);
	set("long", "此人便是武当派开山祖师张三丰，一代武学宗师，太极拳法的创始人。\n"
		    "他仙风道骨，须发皆白，但精神矍铄，眼中闪烁着智慧的光芒。\n"
		    "身着朴素道袍，手持拂尘，举手投足间蕴含着深不可测的武学真意。\n"
		    "传说他已达到「太极无极」的至高境界，武功深不可测，堪称当世武圣。\n");
	set("attitude", "peaceful");
	set("str", 45);
	set("int", 50);
	set("con", 48);
	set("dex", 46);

	set("max_qi", 45000000);
	set("max_jing", 24000000);
	
	set("neili", 80000);
	set("max_neili", 80000);
	set("jiali", 80);

	set("combat_exp", 800000000);

	set_skill("unarmed", 800);
	set_skill("sword", 800);
	set_skill("blade", 800);
	set_skill("staff", 800);
	set_skill("hammer", 800);
	set_skill("club", 800);
	set_skill("whip", 800);
	set_skill("dagger", 800);
	set_skill("throwing", 800);
	set_skill("parry", 800);
	set_skill("dodge", 800);
	set_skill("xinfa", 800);
	set_skill("force", 800);
	set_skill("taiji-quan", 800);
	set_skill("taiji-jian", 800);
	set_skill("wudang-xinfa", 800);
	set_skill("martial-cognize", 800);

	map_skill("force", "wudang-xinfa");
	map_skill("dodge", "wudang-xinfa");
	map_skill("unarmed", "taiji-quan");
	map_skill("sword", "taiji-jian");
	map_skill("parry", "taiji-jian");
	// map_skill("xinfa", "wudang-xinfa");

	set("opinion/ultra",  1);
	set("opinion/master", 1);

	set("rank_info/self", "贫道");

	//增加伤害4000
	set_temp("apply/damage", 4000);
	//增加防御4000
	set_temp("apply/armor", 4000);

	setup();
	carry_object("/clone/cloth/cloth")->wear();
	carry_object("/clone/weapon/changjian")->wield();

	set("chat_chance_combat", 120);
	set("chat_msg_combat", ({
		(: exert_function, "powerup" :),
		(: exert_function, "shield" :),
		(: perform_action, "unarmed.tu" :),
		(: perform_action, "sword.wuji" :),
		(: perform_action, "unarmed.yin" :),
		(: perform_action, "sword.chan" :),
		(: perform_action, "unarmed.zhen" :),
		(: perform_action, "sword.lian" :),
	}) );

	// 30分钟后，自我销毁
	call_out("destruct_me", 1800);
}

//心跳函数，检查武器状态并执行战斗逻辑
void heart_beat()
{
	object *enemy;
	int current_hp_percent;
	
	// 检查武器状态
	catch {
		if (! objectp(query_temp("weapon")))
		{
			carry_object("/clone/weapon/changjian")->wield();
		}
	};

	// 获取当前血量百分比
	current_hp_percent = query("qi") * 100 / query("max_qi");
	
	// 获取所有敌人
	enemy = query_enemy();
	enemy = filter_array(enemy, (: userp($1) :));
	
	if (sizeof(enemy) > 0)
	{
		// 根据血量阶段执行不同的战斗逻辑
		if (current_hp_percent > 70)
		{
			// 阶段1：正常战斗模式
			if (random(6) == 0)
			{
				special_attack_phase1(enemy);
			}
		}
		else if (current_hp_percent > 40)
		{
			// 阶段2：太极真意模式
			if (random(4) == 0)
			{
				special_attack_phase2(enemy);
			}
		}
		else
		{
			// 阶段3：无极境界模式
			if (random(3) == 0)
			{
				special_attack_phase3(enemy);
			}
		}
	}

	::heart_beat();
}

// 阶段1：正常战斗模式特殊攻击
void special_attack_phase1(object *enemy)
{
	string msg;
	
	catch {
		msg = HIB "$N" HBCYN "双手画圆，一招「太极推手」，阴阳二气缓缓推出！"NOR"\n";
		message_vision(msg, this_object());
		
		foreach (object ob in enemy)
		{
			if (objectp(ob) && living(ob))
			{
				ob->receive_damage("qi", 15000, this_object());
				ob->receive_wound("qi", 7500, this_object());
				tell_object(ob, HIB "你感到一股柔和却不可抗拒的力量袭来，气血瞬间流失15000点！"NOR"\n");
				
				// 600级以下玩家额外伤害
				if (ob->query("level") < 600)
				{
					ob->receive_damage("qi", 80000, this_object());
					ob->receive_wound("qi", 40000, this_object());
					tell_object(ob, HIR "张三丰的太极真意对你造成了巨大冲击，气血瞬间流失80000点！"NOR"\n");
				}
			}
		}
	};
}

// 阶段2：太极真意模式特殊攻击
void special_attack_phase2(object *enemy)
{
	string msg;
	
	catch {
		msg = HIC "$N" HBMAG "手中拂尘一挥，一招「无极生太极」，无形剑意弥漫全场！"NOR"\n";
		message_vision(msg, this_object());
		
		foreach (object ob in enemy)
		{
			if (objectp(ob) && living(ob))
			{
				if (random(2) == 0)
				{
					ob->receive_damage("qi", 25000, this_object());
					ob->receive_wound("qi", 12500, this_object());
					tell_object(ob, HIC "无极剑意穿透你的防御，气血瞬间流失25000点！"NOR"\n");
				}
				else
				{
					ob->receive_damage("jing", 8000, this_object());
					ob->receive_wound("jing", 4000, this_object());
					tell_object(ob, HIB "太极真意冲击你的心神，精神瞬间流失8000点！"NOR"\n");
				}
				
				// 600级以下玩家额外伤害
				if (ob->query("level") < 600)
				{
					ob->receive_damage("qi", 100000, this_object());
					ob->receive_wound("qi", 50000, this_object());
					tell_object(ob, HIR "张三丰的无极境界对你造成了毁灭性打击，气血瞬间流失100000点！"NOR"\n");
				}
			}
		}
	};
}

// 阶段3：无极境界模式特殊攻击
void special_attack_phase3(object *enemy)
{
	string msg;
	int heal_amount;
	
	catch {
		// 随机选择攻击类型
		if (random(3) == 0)
		{
			// 自我治疗
			msg = HIY "$N" HBGRN "盘膝而坐，运转「武当心法」，天地灵气汇聚而来！"NOR"\n";
			message_vision(msg, this_object());
			
			heal_amount = 500000 + random(500000);
			add("qi", heal_amount);
			add("eff_qi", heal_amount);
			add("jing", heal_amount/2);
			add("eff_jing", heal_amount/2);
			if (query("qi") > query("max_qi"))
				set("qi", query("max_qi"));
			if (query("jing") > query("max_jing"))
				set("jing", query("max_jing"));
			if (query("eff_qi") > query("max_qi"))
				set("eff_qi", query("max_qi"));
			if (query("eff_jing") > query("max_jing"))
				set("eff_jing", query("max_jing"));
				
			tell_room(environment(), sprintf(HIY "张三丰恢复了%d点气血！"NOR"\n", heal_amount));
		}
		else
		{
			// 狂暴攻击
			msg = HIR "$N" HBRED "仰天长啸，「天地同寿」神功爆发，武当真传尽显无遗！"NOR"\n";
			message_vision(msg, this_object());
			
			foreach (object ob in enemy)
			{
				if (objectp(ob) && living(ob))
				{
					ob->receive_damage("qi", 40000, this_object());
					ob->receive_wound("qi", 20000, this_object());
					ob->receive_damage("jing", 15000, this_object());
					ob->receive_wound("jing", 7500, this_object());
					tell_object(ob, HIR "张三丰的狂暴攻击让你气血精神同时受创！"NOR"\n");
					
					// 600级以下玩家额外伤害
					if (ob->query("level") < 600)
					{
						ob->receive_damage("qi", 150000, this_object());
						ob->receive_wound("qi", 75000, this_object());
						tell_object(ob, HIR "武圣的怒火对你造成了致命伤害，气血瞬间流失150000点！"NOR"\n");
					}
				}
			}
		}
	};
}

varargs void die(object me)
{
	object *killer_list;
	object player;

	if (! objectp(me))
	{
		player = this_object()->query_last_damage_from();
	}
	else
	{
		player = me;
	}

	// 检查死亡前的敌人列表
	killer_list = this_object()->query_enemy();
	
    killer_list -= ({ 0 });

	//过滤掉非玩家的敌人
	killer_list = filter_array(killer_list, (: userp($1) :));
	
	// 过滤掉和我不在同一地点的敌人
	killer_list = filter_array(killer_list, (: environment($1) == environment($2) :), this_object());

	if (sizeof(killer_list))
	{
		//遍历所有的敌人，给予奖励
		foreach (object killer in killer_list)
		{
			int exp, pot, yuanbao;
			

			if (!objectp(killer) || !killer->query("sanhua_done"))
			continue;
			
			exp = 50000 + random(30000); // 5-8万经验
			pot = 80000 + random(40000); // 8-12万潜能
			yuanbao = 20; // 20绑定元宝
			
			killer->add("combat_exp", exp);
			killer->add("potential", pot);
			killer->add("bind_yuanbao", yuanbao);

			// 物品掉落系统
			distribute_items(killer);
			
			// 15%概率掉落武圣真意
			if (random(100) < 15)
			{
				int zhenyi_level;
				
				// 真意等级范围：600-700级，不超过玩家等级
				zhenyi_level = 600 + random(101);
				if (zhenyi_level > killer->query("level"))
					zhenyi_level = killer->query("level");
					
				if (zhenyi_level >= 100)
				{
					tell_object(killer, HIR "张三丰的武学真意化作了武圣真意传承给了你！\n" NOR);
					// 调用武圣真意系统
					if (ZHENYI_MASTER)
						ZHENYI_MASTER->drop_zhenyi_with_boost(killer, zhenyi_level);
				}
			}
			
			tell_object(killer, HIG "你获得了" + exp + "点经验、" + pot + "点潜能和" + yuanbao + "点绑定元宝。\n" NOR);
		}
	}

	message("vision", "\n"HIW + name() + "缓缓闭上双眼，身形渐渐变得透明，"
		"最后化作点点星光消散在天地之间。"NOR"\n", environment());
	command("chat 太极无极，阴阳调和，贫道去也...");
	destruct_me();
}

/**
 * @brief 物品掉落分发函数
 * @param object player 获得物品的玩家对象
 * @details 根据概率分发不同的物品奖励，包括太极宝藏的特殊掉落
 */
void distribute_items(object player)
{
	int random_drop;
		
	random_drop = random(100);
	
	// 掉落太极宝藏
	{
		object taiji_baozang = new_bind("/clone/baoxiang/taiji-baozang");
		taiji_baozang->move(player);
		tell_object(player, HIR "你获得了一个太极宝藏！\n" NOR);
	}
	
	// 40%概率掉落金砂
	if (random_drop < 40) {
		object jinsha = new_bind("/clone/vip/jinsha");
		jinsha->move(player);
		tell_object(player, HIY "你获得了一个金砂！\n" NOR);
	}
	// 30%概率掉落强化石
	else if (random_drop < 70) {
		object qianghua = new_bind("/clone/vip/qianghua_shi");
		qianghua->move(player);
		tell_object(player, HIY "你获得了一个强化石！\n" NOR);
	}
	// 25%概率掉落高级强化保护符
	else if (random_drop < 95) {
		object hufu = new_bind("/clone/vip/gaojibao_hufu");
		hufu->move(player);
		tell_object(player, HIY "你获得了一个高级强化保护符！\n" NOR);
	}
	// 5%概率掉落九转金丹
	else {
		object jindan = new_bind("/clone/vip/dan_jiuzhuan");
		jindan->move(player);
		tell_object(player, HIY "你获得了一个九转金丹！\n" NOR);
	}
}

void destruct_me()
{
	remove_call_out("destruct_me");
	destruct(this_object());
}