mapping quest_describe = ([
    "每日签到":"江湖儿女，修行不辍。每日晨起，向天地叩首，以示虔诚。天道酬勤，自有厚报。",

    "木剑砺锋":"初入江湖的豪杰，需从基本功夫做起。此处设有十具木人，或持铁甲，或通机关，正适合武功初成者砺练。需得技艺达百级方可挑战，虽说危险不大，却也不可掉以轻心。",

    "幽冥幻境":"此处乃江湖禁地，幽冥之气缭绕，令人不寒而栗。传闻四种不同的妖魔盘踞其中，各有独特的邪功绝技。非血气充盈者（血量需过五千），技艺精湛者（技能需过二百级）莫要贸然闯入，否则性命堪忧。",

    "溯源之河":"相传天地初开之时，有一道神秘逆流，自下而上，违背常理。此河蕴含天地造化之力，能淬炼武者筋骨，增长功力。然而河中逆流者实力不俗，需得经验达八十万，技艺超一百五十级方可尝试。欲登彼岸者，需一路过关斩将，方能寻得机缘。",

    "天下武道大会":"武林盛事，英雄荟萃。分设潜龙、宗师、尊者三榜，各有门槛：" + ZJBR +
        "「潜龙榜」需经验十万至二十万，内功、轻功、招架皆需四百。" + ZJBR +
        "「宗师榜」需经验二十万至四十万，内功、轻功、招架皆需六百。" + ZJBR +
        "「尊者榜」需经验四十万以上，内功、轻功、招架皆需七百。" + ZJBR +
        "每逢周一至周五戌时（晚十点）开榜，持续一刻钟，共十轮较技。",

    "冲脉丹合成":"丹道之术，讲究三品九转。下品化中品，中品化上品，一经入炉，便不可逆转，需谨慎行事。",

    "炼体丹合成":"炼体之道，武圣之路。基础炼体丹二合一可化中级，中级二合一可化高级。一旦提交化为丹液，无法退回，请慎重考虑。",

    "抽奖":"天机阁秘藏诸多奇珍异宝，可用元宝或抽奖符换取机缘。中有绝世珍品，全凭天意。详细规则可查阅面板。",
    
    "限时抽奖":"九月秋季限时抽奖，活动时间：2025年9月1日至9月15日。" + ZJBR +
        "「抽奖方式」可使用单抽卡、十连抽卡、元宝或绑定元宝进行抽奖。" + ZJBR +
        "「奖池设置」五层奖励：终极(0.5%)、珍藏(2%)、史诗(4%)、稀有(10%)、普通(83.5%)。" + ZJBR +
        "「保底机制」累计抽取100次必定获得终极奖励中的一个物品。" + ZJBR +
        "「积分系统」每次抽奖可获得1点限时积分，可在积分商店兑换珍贵物品。" + ZJBR +
        "「每日限制」每日最多抽奖50次，防止过度消耗。",

    "新手任务":"初入江湖，需循序渐进。此为引路明灯，助你拜师学艺，习得武功，渐入佳境。",

    "藏经阁副本":"少林藏经阁，武学圣地。" + ZJBR +
        "「守卫僧人」武艺精湛，随缘施展。" + ZJBR +
        "「扫地僧」貌似寻常，实则深不可测。" + ZJBR +
        "入阁需过重重关卡，击败守卫方可入内；欲寻密藏，需胜扫地僧。",

    "师徒历练":"师徒同心，其利断金。每日限师父五入，徒儿一入。需二人起，六人止，皆需师徒名分。",

    "大漠黑塔":"黑塔耸立大漠，守卫实力不俗，约莫习武者七分至十分功力。",


    "非不裘副本":"江湖传说，非不裘乃当世绝顶高手，行踪诡秘。此副本需得二到六人结伴同行，方有胜算。其人武功诡异，善使分身之术，更有'霸天绝地'这等绝学。每七日方可一闯，需得众志成城，方可过关。",

    "白马关":"白马关是墨家建立的一座雄关，为单人爬塔副本，每层递增战力，每天可以进入一次。"ZJBR"【基础奖励】：每层击败守卫获得经验和潜能奖励，奖励随层数增加。"ZJBR"【特殊奖励】：极低概率掉落意境卷轴残页。"ZJBR"【通关奖励】：通关最终层获得额外经验和潜能奖励，并有更高概率获得意境卷轴残页。",

    "葵花秘境":"此乃昔日葵花老祖隐修之地，深藏于未知虚空。秘境深处由"HIR"葵花魔尊"NOR"镇守，其身法绝伦，武功诡异莫测。唯有达到宗师境界（等级300）方可窥探其秘。",

    "阴阳逆转之地":"传说乃太极之源，阴阳交汇之处，一方为至阳之地，光明璀璨；一方为至阴之地，幽暗深邃。入内者须择一路而行，另一路则封。"ZJBR"至阳之地由"HIY"阳无极"NOR"守护，精通九阳神功，刚猛无匹；至阴之地由"HIC"阴无极"NOR"镇守，深谙九阴真经，阴柔至极。"ZJBR"唯有大宗师才有资格领悟其秘传精要。每日限入一次，需技高身坚者（等级300）方可挑战。",

    "古圣之地":"传说中的古代武圣遗迹，蕴含着无数武学传承的神秘之地，每处都有一位武圣残魂镇守。"ZJBR"这些残魂保留着生前的武学造诣，实力从初窥门径到登峰造极不等。中心圣殿的守护者尤为强大，是整个遗迹的核心所在。"ZJBR"击败武圣残魂不仅能获得丰厚的经验潜能奖励，还有机会获得珍贵物品和武圣真意传承。每日限入一次，适合独行侠客探索。",

    "结义系统":"义结金兰，恩重如山。可开结义面板，查阅结义信息。",

    "群雄逐鹿":"群雄逐鹿为多人竞技活动，每天固定在中午14:30和晚上19:30开始。"ZJBR"【活动时间】：活动持续时间为20分钟。"ZJBR"【报名要求】：玩家需提前在报名处报名参加，报名截止时间为活动开始前5分钟。"ZJBR"【人数限制】：最少需要5人参与才能开始活动，最多允许30人同时参与。"ZJBR"【活动奖励】：根据表现获得经验、潜能及其他奖励。",
    "古墓挖宝":"限时活动：挖宝活动仅在每天下午12点到1点开放，其他时间无法参与。"ZJBR"挖宝过程：玩家开始挖宝后会经历一个逐步深入的过程，挖宝过程中会显示生动的描述，营造沉浸式体验，玩家需要等待一定时间才能完成一次挖宝。"ZJBR"挖宝地点：只能在古墓派户外区域进行挖宝活动。",

    "武道交流大会":"限时活动：武道交流大会仅在每天晚上8点到9点开放，其他时间无法参与。"ZJBR"活动地点：扬州武道场，侠客们可以在武道场与其他真实玩家进行武学交流。"ZJBR"交流方式：必须指定一名在场的玩家进行交流。"ZJBR"交流过程：交流过程有生动的描述，营造沉浸式体验。"ZJBR"冷却时间：每次交流后有60秒冷却时间。"ZJBR"自动交流：冷却结束后，如果双方仍在武道场，系统会自动触发下一次交流。",

    "送货任务":"江湖客商往来频繁，常有货物需要运送，却苦于山高路远、盗匪横行。"ZJBR"运送流程：先找到持有货物的商人，询问任务详情并接取物品，再将物品送至指定地点的收货人手中。"ZJBR"任务刷新：系统每隔约1分钟会自动刷新一个送货任务，同时最多可存在20个送货任务。"ZJBR"任务要求：需有一定江湖阅历(阅历需达1000)方可接取任务，且需预留足够的负重空间携带货物。"ZJBR"注意事项：任务有30分钟时限，超时未完成则任务失效。",

    "四大天王":"传说中四象守护者镇守武林四方，各自掌握着不同的武学精华，乃武林最强守护宗师。"ZJBR"「东方剑圣」修持华山剑法，青龙剑意加身，剑势如龙腾九霄。"ZJBR"「南方火尊」精通武当真传，朱雀神火环绕，太极阴阳运转如意。"ZJBR"「西方刀皇」修习少林绝学，白虎刀威护体，刀法武功并重。"ZJBR"「北方拳圣」掌握丐帮绝技，玄武拳力庇佑，刚柔并济威震四方。"ZJBR"每位守护者战力高达15000，气血2000万，精神500万。唯有真正的武林高手方能挑战成功，并有机缘领悟四象秘传的玄妙。"ZJBR"「炼体奖励」击败单个天王可获得基础炼体丹，击败全部四王额外获得中级炼体丹，助力武圣之躯修炼。",

    "挥剑求道":"传说中的剑道圣地，一处空旷的山谷中隐藏着剑道的终极奥秘。山壁上刻满了历代剑客留下的剑招痕迹，远处的练武台上则有一位神秘的"HIR"巅峰杨改之"NOR"在等待挑战者。"ZJBR"此乃杨改之达到武学巅峰后的终极形态，已经彻悟剑道真谛，一举一动都蕴含着无上剑意。血量高达500万，精神200万，技能等级达到1200的恐怖境界。"ZJBR"挑战成功者不仅能获得巨额经验潜能奖励，更能得到珍贵的五脏材料自选宝箱，助力武者踏上更高的武学之路。唯有真正的剑道宗师方能在此地证道成功。每日限入一次，适合独行剑客的终极试炼。",
]);

string quest_as_button_name(object me, string questName) {
    return quest_button_name[questName] || "没有这个任务";
}

string result(string questName) {
    return ZJBR + (quest_result[questName] || "没有这个任务");
}

string quest_command(object me, string questName) {
    return quest_command[questName] || "没有这个任务";
}

string quest_condition(object me, string questName) {
    return quest_condition[questName] || "没有这个任务";
}

string quest_describe(string questName) {
    return quest_describe[questName] || "没有这个任务";
}

mapping classify_act =
([
    "任务":({ "每日签到"/*,"新手任务" */, "送货任务" }),
    "副本":({ "木剑砺锋","幽冥幻境","溯源之河","藏经阁副本","师徒历练","大漠黑塔","非不裘副本","白马关", "葵花秘境", "阴阳逆转之地", "古圣之地", "四大天王", "挥剑求道" }),
    "功能":({ "冲脉丹合成","炼体丹合成","抽奖","限时抽奖",/*"扫荡系统",*/"结义系统" }),
    "活动":({ "天下武道大会", "群雄逐鹿", "古墓挖宝", "武道交流大会" })
]);

//排序
string *classify_act_sort  =
({
    "任务","副本","功能","活动"
});

mapping limit_active_larger_than = ([
    "白马关":([ "level":300,]),
    "非不裘副本":([ "level":300,]),
    "葵花秘境":([ "level":300,]),
    "四大天王":([ "level":300,]),
    "挥剑求道":([ "level":300,]),
]);

mapping limit_active_less_than = ([
    "木剑砺锋":([
        "level":300,
    ]),
]);


string quest_open(object me) {
    mapping jsonData = ([ ]);
    mapping *data_list = ({});
    mapping *classify_button = ({});

    // 按照分类顺序依次生成数据，保证页面顺序一致
    foreach (string category in classify_act_sort) {
        foreach (string questName in classify_act[category]) {
            mapping data;

            // 等级限制检测
            if (mapp(limit_active_larger_than[questName]) &&
                me->query("level") < limit_active_larger_than[questName]["level"]) {
                continue;
            }
            if (mapp(limit_active_less_than[questName]) &&
                me->query("level") >= limit_active_less_than[questName]["level"]) {
                continue;
            }

            data = ([
                "name"   : questName,
                "as_name": quest_as_button_name(me, questName),
                "msg"    : HIR"【任务描述】："NOR + ZJBR + quest_describe(questName) + ZJBR +
                            HIR"【功能类型】："NOR + ZJBR + quest_condition(me, questName) + ZJBR +
                            HIR"【注意事项】："NOR + result(questName) +
                            TRANSLATE->quest_other_result(me, questName),
                "command": quest_command(me, questName),
            ]);
            data_list += ({ data });
        }
    }

    // 分类按钮，便于前端快速切换
    foreach (string key in classify_act_sort) {
        classify_button += ({ ([
            "name"   : key,
            "command": "day_quest " + key,
        ]) });
    }

    jsonData["code"]   = "day_quest";
    jsonData["data"]   = data_list;
    jsonData["button"] = classify_button;

    tell_object(me, json_encode(jsonData) + "\n");
    return "";
}

string new_quest_open(object me,string classify_name) {
    mapping jsonData = ([ ]);
    mapping *data_list = ({});
    mapping *classify_button = ({});

    // 无效分类直接回到总览
    if (!arrayp(classify_act[classify_name])) {
        return quest_open(me);
    }

    foreach (string questName in classify_act[classify_name]) {
        mapping data;

        // 等级限制检测
        if (mapp(limit_active_larger_than[questName]) &&
            me->query("level") < limit_active_larger_than[questName]["level"]) {
            continue;
        }
        if (mapp(limit_active_less_than[questName]) &&
            me->query("level") >= limit_active_less_than[questName]["level"]) {
            continue;
        }

        data = ([
            "name"   : questName,
            "as_name": quest_as_button_name(me, questName),
            "msg"    : HIR"【任务描述】："NOR + ZJBR + quest_describe(questName) + ZJBR +
                        HIR"【功能类型】："NOR + ZJBR + quest_condition(me, questName) + ZJBR +
                        HIR"【注意事项】："NOR + result(questName) +
                        TRANSLATE->quest_other_result(me, questName),
            "command": quest_command(me, questName),
        ]);
        data_list += ({ data });
    }

    // 分类按钮（保持与总览一致）
    foreach (string key in classify_act_sort) {
        classify_button += ({ ([
            "name"   : key,
            "command": "day_quest " + key,
        ]) });
    }

    jsonData["code"]   = "day_quest";
    jsonData["data"]   = data_list;
    jsonData["button"] = classify_button;

    tell_object(me, json_encode(jsonData) + "\n");
    return "";
}

