// 日常任务外部信息处理

string quest_other_result(object me,string questName)
{
    string msg = "";

    if (questName == "师门任务")
    {
        //本周完成次数
        msg = sprintf("本周完成次数: %d/3000\n",me->query("all_shimen_number"));
        msg = ZJBR + msg;
    }

    if (questName == "套装兑换")
    {
        msg = sprintf("当前剩余天工匣子数量: %d/3000\n",me->query("tiangongxia"));
        msg = ZJBR + msg;
        msg += sprintf("今天通过boss获取的天工匣子数量: %d/10\n",me->query("now_time_fuben/tiangongxia"));
        msg = ZJBR + msg;
    }

    return msg;
}