

inherit NPC;

// 函数声明
void create();
void die();
void init();
void greeting(object ob);

// 函数实现
void create()
{
    set_name("金兵", ({ "jin bing", "bing" }));
    set("long", "这是一个来犯的金兵,看起来凶神恶煞。\n");
    set("gender", "男性");
    set("age", 30);
    set("combat_exp", 5000000000);
    set("shen", -1000);
    set("attitude", "aggressive");

    set("max_qi", 100000);
    set("eff_qi", 100000);
    set("qi", 100000);
    set("max_jing", 100000);
    set("jing", 100000);
    set("max_neili", 50000);
    set("neili", 50000);


    set_skill("dodge", 200);
    set_skill("unarmed", 200);
    set_skill("parry", 200);
    set_skill("blade", 200);

    setup();
    carry_object("/clone/weapon/blade")->wield();
    carry_object("/clone/cloth/cloth")->wear();
}

void die()
{
    object ob = query_last_damage_from();
    if (ob && userp(ob))
    {
        JINBING_D->defeat_jinbing(ob, "jinbing");
    }
    ::die();
}

void init()
{
    object ob;
    
    ob = this_player();
    
    ::init();
    if (interactive(ob) && !is_fighting())
    {
        remove_call_out("greeting");
        call_out("greeting", 1, ob);
    }
}

void greeting(object ob)
{
    if (!ob || environment(ob) != environment()) return;
    
    say("金兵喝道：大宋狗子，受死吧！\n");
    kill_ob(ob);
}

// ... 其他函数 ...
