

inherit NPC;

// 函数声明
void create();
void die();
int bai_zhan(object target);
void update_jinbing_count(int count);
void do_bai_zhan();
void init();
void greeting(object ob);

// 函数实现
void create()
{
    set_name("金兵将领", ({ "jinbing general", "general" }));
    set("long", "这是一位金兵的将领,看起来威风凛凛,身经百战。\n");
    set("gender", "男性");
    set("age", 45);
    set("combat_exp", 5000000);
    set("shen", -10000);
    set("attitude", "aggressive");

    set("max_qi", 2000000);
    set("eff_qi", 2000000);
    set("qi", 2000000);
    set("max_jing", 2000000);
    set("max_neili", 50000);
    set("neili", 50000);
    set("jing", 2000000);

    set_skill("dodge", 500);
    set_skill("unarmed", 500);
    set_skill("parry", 500);
    set_skill("blade", 500);
    set_skill("force", 500);

    set("jinbing_count", 20); // 初始战阵中的金兵数量

    set("chat_chance_combat", 30);
    set("chat_msg_combat", ({
        (: do_bai_zhan :),
    }));

    setup();
    carry_object("/clone/weapon/gangdao")->wield();
    carry_object("/clone/cloth/tiejia")->wear();
}

void die()
{
    object ob = query_last_damage_from();
    if (ob && userp(ob))
    {
        JINBING_D->defeat_jinbing(ob, "general");
    }
    ::die();
}

// 百战技能
int bai_zhan(object target)
{
    int damage, jinbing_count;

    if (!target) return 0;

    jinbing_count = query("jinbing_count");
    if (jinbing_count <= 0) jinbing_count = 1;

    damage = (this_object()->query_skill("blade") + this_object()->query("combat_exp") / 1000) * jinbing_count / 20;

    message_vision(HIR "$N大喝一声「百战」,率领金兵战阵向$n发起猛烈攻击!\n" NOR, this_object(), target);

    if (random(100) < 80) // 80%的命中率
    {
        target->receive_damage("qi", damage);
        target->receive_wound("qi", damage/2);
        message_vision(HIR "$N的攻击命中了$n,造成了" + damage + "点伤害!\n" NOR, this_object(), target);
    }
    else
    {
        message_vision(HIG "$n灵巧地躲过了$N的攻击!\n" NOR, this_object(), target);
    }

    return 1;
}

// 更新战阵中的金兵数量
void update_jinbing_count(int count)
{
    set("jinbing_count", count);
}

// 修改do_bai_zhan函数
void do_bai_zhan()
{
    object ob = select_opponent();
    if (ob && living(ob) && environment(ob) == environment(this_object()))
    {
        bai_zhan(ob);
    }
}

void init()
{
    object ob = this_player();
    
    ::init();
    if (interactive(ob) && !is_fighting())
    {
        remove_call_out("greeting");
        call_out("greeting", 1, ob);
    }
}

void greeting(object ob)
{
    if (!ob || environment(ob) != environment()) return;
    
    say("金兵将领大喝一声：大宋鼠辈，纳命来！\n");
    kill_ob(ob);
}