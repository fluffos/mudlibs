void apply_mizhuan_power(object me);

//函数，给一个对象增加一个秘传
int add_mizhuan(object me,string name)
{
    mapping data;
    mapping att;

    // 检查秘传名称是否存在
    if (!mapp(mizhuan_list) || !data = mizhuan_list[name])
    {
        tell_object(me, "没有找到 " + name + " 这种秘传！\n");
        return 0;
    }

    // 检查玩家是否已经拥有该秘传
    if (me->query("mizhuan/" + name))
    {
        tell_object(me, "你已经领悟了 " + name + " 的奥秘了！\n");
        return 0;
    }

    //如果领悟了阴阳轮转录，则至阴生元和至阳生息的秘传效果不能再领悟了
    if (me->query("mizhuan/阴阳轮转录"))
    {
        if (name == "至阴生元" || name == "至阳生息")
        {
            tell_object(me, "你已经领悟了阴阳轮转录，至阴生元和至阳生息的秘传效果不能再领悟了！\n");
            return 0;
        }
    }


    // 标记玩家已获得该秘传
    me->set("mizhuan/" + name, 1);

    // 发送成功提示
    tell_object(me, HIY "恭喜你！你成功领悟了「" + name + "」的奥秘！" NOR "\n");
    if (mapp(att) && stringp(att["desc"]))
    {
        tell_object(me, HIR "你获得了以下加成：" + att["desc"] + NOR "\n");
    }
    apply_mizhuan_power(me);

    return 1;
}

// 检查玩家是否拥有指定秘传
int has_mizhuan(object me, string name)
{
    if (!objectp(me) || !stringp(name))
        return 0;
        
    return me->query("mizhuan/" + name);
}


// 函数，解析人物身上的秘传，汇总加成并设置到人物身上
void apply_mizhuan_power(object me)
{
    mapping player_mizhuan;
    mapping mizhuan_data;
    mapping total_attributes = ([]);
    mapping total_skills = ([]);
    mapping current_attributes;
    mapping current_skills;
    string *mizhuan_names;
    string *attr_keys;
    string *skill_keys;
    string mizhuan_name;
    string key;
    int i, j;

    if (!objectp(me))
        return;

    player_mizhuan = me->query("mizhuan");

    // 如果玩家没有任何秘传，则清除旧的加成并返回
    if (!mapp(player_mizhuan) || !sizeof(player_mizhuan))
    {
        me->delete("mizhuan_power");
        return;
    }

    mizhuan_names = keys(player_mizhuan);

    // 遍历玩家拥有的所有秘传
    for (i = 0; i < sizeof(mizhuan_names); i++)
    {
        mizhuan_name = mizhuan_names[i];

        // 查找秘传数据
        if (!mapp(mizhuan_list) || !mizhuan_data = mizhuan_list[mizhuan_name])
            continue; // 跳过无效的秘传条目

        // 累加属性加成
        if (mapp(current_attributes = mizhuan_data["attribute"]))
        {
            attr_keys = keys(current_attributes);
            for (j = 0; j < sizeof(attr_keys); j++)
            {
                key = attr_keys[j];
                if (key == "desc") continue; // 跳过描述
                if (!intp(current_attributes[key])) continue; // 确保是整数值
                total_attributes[key] += current_attributes[key];
            }
        }

        // 累加技能加成
        if (mapp(current_skills = mizhuan_data["skill"]))
        {
            skill_keys = keys(current_skills);
            for (j = 0; j < sizeof(skill_keys); j++)
            {
                key = skill_keys[j];
                if (!intp(current_skills[key])) continue; // 确保是整数值
                total_skills[key] += current_skills[key];
            }
        }
    }

    // 清除旧的加成数据
    me->delete("mizhuan_power");

    // 设置新的总属性加成
    attr_keys = keys(total_attributes);
    for (i = 0; i < sizeof(attr_keys); i++)
    {
        key = attr_keys[i];
        me->set("mizhuan_power/attribute/" + key, total_attributes[key]);
    }

    // 设置新的总技能加成
    skill_keys = keys(total_skills);
    for (i = 0; i < sizeof(skill_keys); i++)
    {
        key = skill_keys[i];
        me->set("mizhuan_power/skill/" + key, total_skills[key]);
    }
}

// 函数：获取指定秘传的获得途径说明
string query_mizhuan_obtain_explain(string mizhuan_name)
{
    mapping mizhuan_data;

    if (!stringp(mizhuan_name) || !mapp(mizhuan_list) || !mapp(mizhuan_data = mizhuan_list[mizhuan_name]))
        return "未知的秘传或无法找到获得途径说明。";

    if (!stringp(mizhuan_data["obtain_explain"]))
        return HIY "【" + mizhuan_name + "】" NOR "暂无详细的获得途径说明。";

    return HIY "【" + mizhuan_name + "】" NOR "\n获得途径：\n" + mizhuan_data["obtain_explain"];
}

// 函数：获取玩家已领悟的秘传列表及其描述 (供 new_skills 调用)
mixed query_mizhuan_list(object me)
{
    mapping player_mizhuan;
    mapping mizhuan_data;
    string *mizhuan_names;
    mixed result = ({}); // 使用 mixed 类型以防未来扩展
    string name;
    string desc;
    string level_point;
    string progress;
    int i;

    if (!objectp(me))
        return ({}); // 返回空数组

    player_mizhuan = me->query("mizhuan");

    if (!mapp(player_mizhuan) || !sizeof(player_mizhuan))
    {
        return ({}); // 返回空数组
    }

    mizhuan_names = keys(player_mizhuan);

    for (i = 0; i < sizeof(mizhuan_names); i++)
    {
        name = mizhuan_names[i];
        // 确保 mizhuan_list 是有效的 mapping
        if (!mapp(mizhuan_list) || !mapp(mizhuan_data = mizhuan_list[name]))
        {
            desc = RED "(数据错误)" NOR;
            level_point = "未知";
            progress = "未知";
        }
        else
        {
            // 获取效果描述
            if (stringp(mizhuan_data["desc"]))
                desc = mizhuan_data["desc"];
            else
                desc = WHT "(暂无详细描述)" NOR;

            // 获取 level_point 和 progress (如果存在且为 string)
            level_point = stringp(mizhuan_data["level_point"]) ? mizhuan_data["level_point"] : "-";
            progress = stringp(mizhuan_data["progress"]) ? mizhuan_data["progress"] : "-";
        }
        // 组装成 new_skills 需要的格式
        result += ({ ([
            "text": HIY "【" + name + "】" NOR, // 秘传名称作为 text
            "level_point": level_point,       // 使用获取到的 level_point
            "progress": progress,           // 使用获取到的 progress
            "desc": "效果：" + desc,         // 效果描述作为 desc
            "button": ({ // 添加按钮
                ([ "cmd": "mizhuan " + name, "name": HIM "寻缘" NOR ]) // 查看获得方式
            })
        ]) });
    }

    return result;
}




