/**
 * @brief 幽冥寒渊 - 七品绝阴地
 * @details 玩家可以在此处消耗100精力上限汲取1缕七品绝阴气
 * @author Lu dexiang
 * @date 2024-12-19
 */
inherit ROOM;
int do_extract_jueyin_qi(object me, int count);
int sense_jueyin_qi(string arg);
int extract_jueyin_qi(string arg);
int input_extract_count(string arg);
int cancel_extract(string arg);

void create()
{
    set("short", HIB "幽冥寒渊" NOR);
    set("long", HIB "这里是一处极寒之地，四周弥漫着浓郁的阴寒之气。地面上覆盖着千年不化的玄冰，"
              "空气中仿佛有无数阴灵在游荡。寒气刺骨，让人不寒而栗。在这极阴之地，蕴含着天地间"
              "最纯净的绝阴之气，只有真正的修行者才能感知并汲取其中的力量。" NOR);
              
    set("outdoors", "mizhuan");
    set("light", 2);
    set("no_clean_up", 0);
    set("exits", ([
        "east" : "/adm/special_ob/mizhuan/map/yinyang-huiju-7",
    ]));
    
    set("listen_default", HIB "你听到阵阵阴风呼啸，仿佛有无数幽魂在低语。" NOR);
    set("smell_default", HIC "空气中弥漫着刺骨的寒意。" NOR);

    set("action_list", ([
        "汲取": "汲取",
        "感悟": "感悟",
    ]));
}

void init()
{
    add_action("extract_jueyin_qi", "extract");
    add_action("extract_jueyin_qi", "汲取");
    add_action("sense_jueyin_qi", "sense");
    add_action("sense_jueyin_qi", "感悟");
}

// 感悟绝阴气
int sense_jueyin_qi(string arg)
{
    object me = this_player();
    int current_qi;
    string msg;
    
    if (!me) return 0;
    
    current_qi = me->query("jueyin_qi");
    if (!current_qi) current_qi = 0;
    
    msg = HIB "你静心感悟着这极阴之地的寒气，体内的绝阴之气在缓缓流转。\n" NOR;
    msg += sprintf("当前你体内拥有 %s%d%s 缕七品绝阴气。\n", HIY, current_qi, NOR);
    msg += HIW "你可以通过「汲取」命令来汲取更多的绝阴气，每次需要消耗200点精力上限。" NOR;
    
    tell_object(me, popup_title(msg));
    return 1;
}

// 汲取绝阴气
int extract_jueyin_qi(string arg)
{
    object me = this_player();
    int max_jing, current_qi, extract_count;
    string msg, confirm_msg;
    string *buttons;
    
    if (!me) return 0;
    
    max_jing = me->query("max_jingli",1);
    current_qi = me->query("jueyin_qi");
    if (!current_qi) current_qi = 0;
    
    if (max_jing < 200)
    {
        msg = HIR "你的精力上限不足200点，无法汲取绝阴气。" NOR;
        tell_object(me, popup_title(msg));
        return 1;
    }
    
    extract_count = max_jing / 200;
    
    if (arg && sscanf(arg, "%d", extract_count) == 1)
    {
        if (extract_count <= 0)
        {
            tell_object(me, popup_title(HIR "汲取数量必须大于0。" NOR));
            return 1;
        }
        
        if (extract_count > max_jing / 200)
        {
            msg = sprintf(HIR "你的精力上限只有%d点，最多只能汲取%d缕绝阴气。" NOR, 
                         max_jing, max_jing / 200);
            tell_object(me, popup_title(msg));
            return 1;
        }
        
        return do_extract_jueyin_qi(me, extract_count);
    }
    
    confirm_msg = sprintf(HIB "你感受到周围浓郁的绝阴之气，准备进行汲取。\n" NOR
                         "当前精力上限：%s%d%s 点\n"
                         "当前绝阴气：%s%d%s 缕\n"
                         "最多可汲取：%s%d%s 缕（每缕消耗200点精力上限）\n\n"
                         HIM "请选择要汲取的数量：" NOR,
                         HIY, max_jing, NOR,
                         HIY, current_qi, NOR,  
                         HIY, extract_count, NOR);
    
    buttons = ({});
    if (extract_count >= 1) buttons += ({ "汲取1缕:汲取 1" });
    if (extract_count >= 5) buttons += ({ "汲取5缕:汲取 5" });
    if (extract_count >= 10) buttons += ({ "汲取10缕:汲取 10" });
    if (extract_count >= 50) buttons += ({ "汲取50缕:汲取 50" });
    if (extract_count >= 100) buttons += ({ "汲取100缕:汲取 100" });
    buttons += ({ "自定义:input_extract_count" });
    buttons += ({ "取消:cancel_extract" });
    
    tell_object(me, popup_comb(confirm_msg, buttons));
    return 1;
}

// 输入自定义汲取数量
int input_extract_count(string arg)
{
    object me = this_player();
    
    if (!me) return 0;
    
    tell_object(me, popup_input("请输入要汲取的绝阴气数量：", "汲取 "));
    return 1;
}

// 取消汲取
int cancel_extract(string arg)
{
    object me = this_player();
    
    if (!me) return 0;
    
    tell_object(me, popup_title("你放弃了汲取绝阴气。"));
    return 1;
}

// 执行汲取绝阴气的动作
int do_extract_jueyin_qi(object me, int count)
{
    int max_jing, current_qi, cost;
    string msg;
    
    if (!me) return 0;
    
    max_jing = me->query("max_jingli",1);
    current_qi = me->query("jueyin_qi");
    if (!current_qi) current_qi = 0;
    
    cost = count * 200;
    
    if (max_jing < cost)
    {
        msg = sprintf(HIR "你的精力上限不足%d点，无法汲取%d缕绝阴气。" NOR, cost, count);
        tell_object(me, popup_title(msg));
        return 1;
    }
    
    // 消耗精力上限
    me->add("max_jingli", -cost);
    
    // 增加绝阴气
    me->add("jueyin_qi", count);
    current_qi += count;
    
    msg = sprintf(HIY "你成功汲取了%d缕七品绝阴气！\n" NOR
                  "消耗了%d点精力上限，当前绝阴气总数：%s%d%s缕。\n"
                  HIB "极寒的绝阴之气在你体内流转，让你对阴阳之道有了更深的感悟。" NOR,
                  count, cost, HIY, current_qi, NOR);
    
    tell_object(me, popup_title(msg));
    
    // 向房间内其他人显示
    tell_room(this_object(), sprintf(HIB "%s盘膝而坐，身周涌动着浓郁的绝阴之气。" NOR, me->query("name")), ({ me }));
    
    return 1;
}
