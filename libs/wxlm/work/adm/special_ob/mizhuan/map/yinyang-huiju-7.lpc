/**
 * @brief 太极悟道台 - 七品阴阳汇聚地
 * @details 玩家可以在此处融合至阳生息和至阴生元秘传为阴阳轮转录
 * @author Lu dexiang
 * @date 2024-12-19
 */
inherit ROOM;
int do_fusion_mizhuan(object me);
int sense_yinyang(string arg);
int check_condition(string arg);
int fusion_mizhuan(string arg);
int cancel_fusion(string arg);

void create()
{
    set("short", HIM "太极悟道台" NOR);
    set("long", HIM "这里是一座神秘的八卦悟道台，台面上刻着巨大的太极图案，黑白两色"
              "相互环绕，形成完美的平衡。空气中同时弥漫着绝阴与绝阳两种截然不同的气息，"
              "却又奇异地融合在一起，形成一种玄妙的和谐状态。在这阴阳交汇之地，蕴含着"
              "天地间最深奥的阴阳变化之理，是领悟太极奥义的绝佳场所。" NOR);
              
    set("outdoors", "mizhuan");
    set("light", 2);
    set("no_clean_up", 0);
    set("exits", ([
        "west" : "/adm/special_ob/mizhuan/map/jueyin-7",
        "east" : "/adm/special_ob/mizhuan/map/jueyang-7",
    ]));
    
    set("listen_default", HIM "你听到阴阳二气交融的轻吟声，如天籁般优美。" NOR);
    set("smell_default", HIW "空气中阴阳二气平衡交融，给人一种玄妙的感觉。" NOR);

    set("action_list", ([
        "融合": "融合",
        "感悟": "感悟",
        // "查看": "查看",
    ]));
}

void init()
{
    add_action("fusion_mizhuan", "fusion");
    add_action("fusion_mizhuan", "融合");
    add_action("sense_yinyang", "sense");
    add_action("sense_yinyang", "感悟");
    // add_action("check_condition", "check");
    // add_action("check_condition", "查看");
}

// 感悟阴阳气息
int sense_yinyang(string arg)
{
    object me = this_player();
    int jueyin_qi, jueyang_qi;
    int has_zhiyang, has_zhiyin;
    string msg;
    
    if (!me) return 0;
    
    jueyin_qi = me->query("jueyin_qi");
    jueyang_qi = me->query("jueyang_qi");
    has_zhiyang = me->query("mizhuan/至阳生息");
    has_zhiyin = me->query("mizhuan/至阴生元");
    
    if (!jueyin_qi) jueyin_qi = 0;
    if (!jueyang_qi) jueyang_qi = 0;
    
    msg = HIM "你静心感悟着这阴阳交汇之地的玄妙气息。\n" NOR;
    msg += sprintf("你体内的绝阴气：%s%d%s 缕\n", HIB, jueyin_qi, NOR);
    msg += sprintf("你体内的绝阳气：%s%d%s 缕\n", HIR, jueyang_qi, NOR);
    msg += sprintf("至阳生息秘传：%s\n", has_zhiyang ? HIY "已领悟" NOR : HIC "未领悟" NOR);
    msg += sprintf("至阴生元秘传：%s\n", has_zhiyin ? HIY "已领悟" NOR : HIC "未领悟" NOR);
    
    if (has_zhiyang && has_zhiyin && jueyin_qi >= 100 && jueyang_qi >= 100)
    {
        msg += HIY "\n你已具备融合条件，可以使用「融合」命令将两个秘传融合为阴阳轮转录！" NOR;
    }
    else
    {
        msg += HIW "\n融合条件：拥有至阳生息和至阴生元秘传，以及各100缕七品绝阴气和绝阳气。" NOR;
    }
    
    tell_object(me, popup_title(msg));
    return 1;
}

// 查看融合条件
int check_condition(string arg)
{
    return sense_yinyang(arg);
}

// 融合秘传
int fusion_mizhuan(string arg)
{
    object me = this_player();
    int jueyin_qi, jueyang_qi;
    int has_zhiyang, has_zhiyin, has_yinyang;
    string msg, confirm_msg;
    string *buttons;
    
    if (!me) return 0;
    
    jueyin_qi = me->query("jueyin_qi");
    jueyang_qi = me->query("jueyang_qi");
    has_zhiyang = me->query("mizhuan/至阳生息");
    has_zhiyin = me->query("mizhuan/至阴生元");
    has_yinyang = me->query("mizhuan/阴阳轮转录");
    
    if (!jueyin_qi) jueyin_qi = 0;
    if (!jueyang_qi) jueyang_qi = 0;
    
    // 检查是否已经拥有阴阳轮转录
    if (has_yinyang)
    {
        msg = HIR "你已经领悟了阴阳轮转录，无需再次融合。" NOR;
        tell_object(me, popup_title(msg));
        return 1;
    }
    
    // 检查基础条件
    if (!has_zhiyang)
    {
        msg = HIR "你尚未领悟至阳生息秘传，无法进行融合。" NOR;
        tell_object(me, popup_title(msg));
        return 1;
    }
    
    if (!has_zhiyin)
    {
        msg = HIR "你尚未领悟至阴生元秘传，无法进行融合。" NOR;
        tell_object(me, popup_title(msg));
        return 1;
    }
    
    if (jueyin_qi < 100)
    {
        msg = sprintf(HIR "你的绝阴气不足100缕（当前%d缕），无法进行融合。" NOR, jueyin_qi);
        tell_object(me, popup_title(msg));
        return 1;
    }
    
    if (jueyang_qi < 100)
    {
        msg = sprintf(HIR "你的绝阳气不足100缕（当前%d缕），无法进行融合。" NOR, jueyang_qi);
        tell_object(me, popup_title(msg));
        return 1;
    }
    
    // 如果传入了确认参数，直接执行融合
    if (arg == "confirm")
    {
        return do_fusion_mizhuan(me);
    }
    
    confirm_msg = HIY "阴阳融合仪式即将开始！\n" NOR
                  HIM "此过程将消耗以下资源：\n" NOR
                  "• 至阳生息秘传\n"
                  "• 至阴生元秘传\n"
                  "• 100缕七品绝阴气\n"
                  "• 100缕七品绝阳气\n\n"
                  HIY "融合成功后，你将领悟七曜级秘传「阴阳轮转录」！\n"
                  "效果：内力上限+5000、精神上限+5000、后天悟性+10、后天根骨+10\n\n" NOR
                  HIR "注意：此过程不可逆转，是否确认融合？" NOR;
    
    buttons = ({
        HIY "确认融合"NOR":融合 confirm",
        "取消:cancel_fusion"
    });
    
    tell_object(me, popup_comb(confirm_msg, buttons));
    return 1;
}

// 取消融合
int cancel_fusion(string arg)
{
    object me = this_player();
    
    if (!me) return 0;
    
    tell_object(me, popup_title("你取消了秘传融合。"));
    return 1;
}

// 执行融合
int do_fusion_mizhuan(object me)
{
    string msg;
    
    if (!me) return 0;
    
    // 消耗资源
    me->delete("mizhuan/至阳生息");
    me->delete("mizhuan/至阴生元");
    me->add("jueyin_qi", -100);
    me->add("jueyang_qi", -100);
    
    // 添加新秘传
    if (!"/adm/special_ob/mizhuan/mizhuan_master"->add_mizhuan(me, "阴阳轮转录"))
    {
        // 如果添加失败，恢复资源
        me->set("mizhuan/至阳生息", 1);
        me->set("mizhuan/至阴生元", 1);
        me->add("jueyin_qi", 100);
        me->add("jueyang_qi", 100);
        
        tell_object(me, popup_title(HIR "融合过程中发生了未知错误，资源已恢复。" NOR));
        return 1;
    }
    
    msg = HIY "【阴阳融合成功】\n" NOR
          HIM "太极图案突然光芒大作，阴阳二气在你体内剧烈交融！\n"
          "至阳生息与至阴生元两种秘传在太极之力的引导下完美融合，\n"
          "化作更加强大的阴阳轮转录！\n\n" NOR
          HIY "你成功领悟了七曜级秘传「阴阳轮转录」！\n" NOR
          HIG "效果：内力上限+5000、精神上限+5000、后天悟性+10、后天根骨+10" NOR;
    
    tell_object(me, popup_title(msg));
    
    // 向房间内其他人显示
    tell_room(this_object(), sprintf(HIY "%s身周太极图案大放光明，阴阳二气剧烈交融，"
                                   "竟然领悟了传说中的阴阳轮转录！" NOR, me->query("name")), ({ me }));
    
    return 1;
}
