//首先先定义监控日志文件路径列表
mapping log_list = ([
    "shop": "/log/monitor/shop.log",
    "fuben": "/log/monitor/fuben.log",
    "fight": "/log/monitor/fight.log",
]);

//定义监控日志函数，将一个json格式的日志写入文件
/**
 * 将一个json格式的日志写入文件
 * @param {string} type - 日志类型
 * @param {Array|Object} data - 日志数据(数组或者mapping)
 */
void monitor_log(string type, mixed data)
{
    string log_path = log_list[type];
    string log = json_encode(data) + "\n";

    assure_file(log_path);
    write_file(log_path, log);
}

//商城监控日志接口
/**
 * 商城监控日志接口
 * 该接口用于记录和监控商城的日志数据。
 *
 * @param {object} player - 玩家对象
 * @param {string} item_name - 商品名称
 * @param {int} item_amount - 商品数量
 * @param {string} item_path - 商品路径
 * @param {int} item_total_price - 商品总价格
 * @param {int} item_price - 商品单价
 * @returns {void} 该函数不返回任何值，但会将日志数据记录到指定的存储中。
 * @throws {Error} 如果日志数据格式不正确，将抛出错误。
 *
 * @example
 * // 示例用法：
 * monitor_shop_log(player, "item_name", 10, "/path/to/item", 100, 10);
 */
void monitor_shop_log(object player, string item_name, int item_amount, string item_path,int item_total_price,int item_price)
{
    mapping data = ([]);

    data["player_id"] = player->query("id");
    data["player_name"] = player->query("name");
    data["item_name"] = item_name;
    data["item_amount"] = item_amount;
    data["item_path"] = item_path;
    data["item_total_price"] = item_total_price;
    data["item_price"] = item_price;

    monitor_log("shop", data);
}


//以下是标准的副本奖励接口需要的数据:1.玩家账号 2.奖励名称 3开始时间 4.结束时间 5.潜能 6.经验
//副本日志接口
void monitor_fuben_log(mixed player, string rewards_name, int start_time, int end_time, int potential, int exp)
{
    mapping data = ([]);

    if (objectp(player))
    {
        data["player_id"] = player->query("id");
    }
    else
    {
        data["player_id"] = player;
    }
    
    data["rewards_name"] = rewards_name;
    data["start_time"] = start_time;
    data["end_time"] = end_time;
    data["potential"] = potential;
    data["exp"] = exp;

    monitor_log("fuben", data);
}

//战斗日志接口，需的数据：1.玩家账号 2.战斗类型(pve/pvp) 3.玩家门派 4.输出伤害 5.单招还是普通攻击 6.攻击者的等级 7.攻击者使用的技能名称
varargs void monitor_fight_log(mixed player, string fight_type, string family_name, int damage, string attack_type, int attacker_level, string skill_name)
{
    mapping data = ([]);

    data["player_id"] = player->query("id");
    data["fight_type"] = fight_type;
    data["family_name"] = family_name;
    data["damage"] = damage;
    data["attack_type"] = attack_type;
    data["attacker_level"] = attacker_level;
    data["skill_name"] = skill_name;
    data["time"] = time();

    monitor_log("fight", data);
}

void create()
{
    set_heart_beat(10);
}

void heart_beat()
{
    // 变量声明
    string *log_files;
    string log_file;
    int file_size;
    
    // 获取所有日志文件
    log_files = get_dir("/log/monitor/*.log");
    
    if (arrayp(log_files))
    {
        // 遍历检查每个日志文件
        foreach(log_file in log_files)
        {
            // 获取文件大小(字节)
            file_size = file_size("/log/monitor/" + log_file);
            
            // 如果大于100MB则备份并创建新文件
            if (file_size > 104857600) // 100MB = 104857600 bytes
            {
                    rm("/log/monitor/" + log_file);
            }

        }
    }
}
