/**
 * @brief 切磋房间
 * @details 用于主线任务中的切磋任务，玩家需要在此房间中与NPC进行切磋
 */
inherit ROOM;

object initial_room;
object spar_npc;
object player;

varargs void create(object origin_room)
{
    if (origin_room)
    {
        set("short", origin_room->query("short") + "切磋场");
        set("long", origin_room->query("long") + "\n这里是一个临时开辟的切磋场地，四周围观者众多。\n");

        set("exits", origin_room->query("exits"));

        this_object()->set("initial_room", origin_room);
        initial_room = origin_room;
    }
    else
    {
        set("short", "切磋场");
        set("long", "这是用于主线任务切磋的场地，四周围观者众多。\n");
    }

    // 标记是一个切磋房间
    set("is_spar_room", 1);
    
    // 设置心跳
    set_heart_beat(1);

    setup();
}

/**
 * @brief 房间销毁时的处理
 */
varargs void remove(string euid)
{
    // 清空当前地点所有物品
    object *inv;
    inv = all_inventory(this_object());
    foreach (object ob in inv)
    {
        // 如果是玩家，移动到初始地点
        if (playerp(ob))
        {
            tell_object(ob, "切磋结束，你回到了原来的地点。\n");
            ob->move(initial_room);
        }
        else if (ob == spar_npc)
        {
            // 销毁NPC
            destruct(ob);
        }
    }
}

/**
 * @brief 销毁房间
 */
void destruct_me()
{
    destruct(this_object());
}

/**
 * @brief 处理玩家离开房间的情况
 */
int valid_leave(object me, string dir)
{
    if (me == player && objectp(spar_npc) && spar_npc->is_fighting(me))
    {
        tell_object(me, "你正在切磋中，不能离开！\n");
        return 0;
    }
    
    tell_object(me, "你离开了切磋场地。\n");
    return ::valid_leave(me, dir);
}

/**
 * @brief 开始切磋
 * @param object me 玩家对象
 * @param object npc 切磋NPC对象
 */
void start_spar(object me, object npc)
{
    if (!objectp(me) || !objectp(npc))
        return;
    
    player = me;
    spar_npc = npc;
    
    // 设置NPC和玩家的状态
    npc->set("jing", npc->query("max_jing"));
    npc->set("qi", npc->query("max_qi"));
    npc->set("neili", npc->query("max_neili"));
    
    me->set("jing", me->query("max_jing"));
    me->set("qi", me->query("max_qi"));
    me->set("neili", me->query("max_neili"));
    
    // 开始切磋
    tell_object(me, HIY "你与" + npc->name() + "开始切磋！\n" NOR);
    tell_room(this_object(), HIY + me->name() + "与" + npc->name() + "开始切磋！\n" NOR, ({ me }));
    
    // 互相切磋，使用fight_ob而不是kill_ob
    me->force_me("fight " + file_name(npc));
}

/**
 * @brief 心跳函数
 * @details 检查房间状态，如果没有玩家则销毁房间
 */
void heart_beat()
{
    object *inv = all_inventory(this_object());
    int player_count = 0;
    
    // 统计玩家数量
    foreach(object ob in inv)
    {
        if (playerp(ob))
            player_count++;
    }
    
    // 如果没有玩家，销毁房间
    if (player_count == 0)
    {
        destruct_me();
        return;
    }
    
    // 如果玩家和NPC都存在但不再战斗，可能是切磋结束
    if (objectp(player) && objectp(spar_npc) && !player->is_fighting(spar_npc) && !spar_npc->is_fighting(player))
    {
        // 延迟销毁房间，给玩家一些时间查看结果
        call_out("destruct_me", 5);
    }
} 