inherit ROOM;

object initial_room;

varargs void create(object origin_room)
{
	if (origin_room)
	{
		set("short", origin_room->query("short"));
		set("long", origin_room->query("long"));

		set("exits", origin_room->query("exits"));

		this_object()->set("initial_room", origin_room);

		initial_room = origin_room;
	}
	else
	{
		set("short", "战斗房间");
		set("long", "这是用于主线任务战斗的房间。");
	}

	//标记是一个战斗房间
	set("is_combat_room", 1);

	set_heart_beat(1);

	setup();
}

varargs void remove(string euid)
{
	//清空当前地点所有物品
	object *inv;
	inv = all_inventory(this_object());
	foreach (object ob in inv)
	{
		//如果是玩家，移动到初始地点。
		if (playerp(ob))
		{
			ob->move(initial_room);
		}
		else
		{
			destruct(ob);
		}
	}
	
}

void destruct_me()
{
	destruct(this_object());
}

int valid_leave(object me, string dir)
{
	tell_object(me, "你离开了战斗场所，任务目标已消失。\n");
	return ::valid_leave(me, dir);
}

//心跳函数，当前地点如果没有玩家或npc则销毁
void heart_beat()
{
	object *inv = all_inventory(this_object());
	int player_count = 0;
	int living_count = 0;

	// 统计玩家和生物数量
	foreach(object ob in inv)
	{
		if (playerp(ob))
			player_count++;
		if (living(ob))
			living_count++;
	}

	// 如果没有玩家或者生物数量少于2,销毁房间
	if (player_count == 0 || living_count < 2)
	{
		destruct_me();
		return;
	}
}

