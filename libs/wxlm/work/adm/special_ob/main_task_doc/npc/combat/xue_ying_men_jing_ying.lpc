inherit NPC;

void create()
{
	set_name("血影门精英", ({ "xueying jingying", "jingying", "xueying" }));
	set("gender", "男性");
	set("age", 35);
	set("long", "此人身着鲜红色劲装，面戴狰狞面具，只露出一双冷酷的眼睛。\n"
		"他腰间挂着一把精致的弯刀，刀身上刻有血影门特有的三道红色斜杠。\n"
		"举手投足间透露出高手的气息，身法轻盈如鬼魅，动作迅捷如闪电。\n"
		"他是血影门的精英成员，比普通门徒更加危险和狠辣。\n");
	
	setup();
} 