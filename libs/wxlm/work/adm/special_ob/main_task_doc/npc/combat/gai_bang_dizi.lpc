inherit NPC;

void create()
{
	set_name("丐帮弟子", ({ "gai bang dizi" }));
	set("gender", "男性");
	set("age", 25);
	set("long", "这是一名丐帮弟子，身着破旧但干净的衣衫，腰间挂着一个酒葫芦，背后背着一个布袋。\n"
		"他面容坚毅，眉宇间透着一股倔强之气，双眼炯炯有神，警惕地观察着四周。\n"
		"他手持一根打狗棒，棒身上有些磨损，显然经常用于实战。\n"
		"从他稳健的步伐和随时准备出手的姿态可以看出，此人武功不俗，绝非普通乞丐。\n");

	setup();
}
