inherit TASK_SPAR_NPC;

void create()
{
	set_name("阿秀", ({ "a xiu", "axiu", "xiu" }));
	set("gender", "女性");
	set("age", 22);
	set("long", "这是一位霸气邪魅的女子，身材高挑，削肩窄腰，线条修长舒展。\n"
		"她面白如玉润，五官端正立体又带着精致模样，兼具男性英气与女性柔美。\n"
		"眉形修长而锋利上扬，眼线微微上挑，眼神深邃冷峻如冰。\n"
		"她手持一把泛着幽幽蓝光的剑，舞动中显得格外妖异。\n"
		"说话时带着很重的西南一带口音。\n");
	
	setup();
} 