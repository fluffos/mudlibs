inherit NPC;

void create() {
}

int accept_fight(object ob)
{
	command("say " + "正有此意！");
    competition_with(ob);
	return 1;
}

void win()
{
	object ob;

	if (! objectp(ob = query_competitor()))
		return;

    if (this_object()->query("spar_can_lost"))
    {
        ob->add("new_main_task/target_num", 1);
        tell_object(ob, HIG "虽然你输了，但是你已经完成了切磋任务【本任务不强制要求击败对手】！\n" NOR);
    }
    else
    {
        command("say " + "看来，你还得练练啊。");
    }

	::win();
}

void lost()
{
    object ob;

	if (! objectp(ob = query_competitor()))
		return;

    if (ob && MAIN_TASK_MASTER->get_player_current_quest(ob))
    {
        // 获取当前任务ID
        int quest_id = MAIN_TASK_MASTER->get_player_current_quest(ob);
        
        // 检查是否是切磋任务
        if (MAIN_TASK_MASTER->is_spar_quest(quest_id))
        {
            // 增加任务完成计数
            ob->add("new_main_task/target_num", 1);
            
            tell_object(ob, HIG "恭喜你在切磋中获胜，完成了切磋任务！\n" NOR);
        }
    }

    command("say " + "真是好武艺！");

	::lost();
}

varargs void die(object killer)
{
    lost();
    return;
}
