inherit NPC;

void create()
{
	set_name("熊有脚", ({ "xiong you jiao", "xiongyoujiao" }));
	set("gender", "男性");
	set("age", 25);
	set("long", "熊有脚身材魁梧，身着打满补丁的灰色布衣，腰间挂着三个破旧的布袋，显示其丐帮三袋长老的身份。\n"
		"他面容阴沉，眉宇间透着一股傲慢之气，双眼如鹰隼般锐利，扫视四周时令人不寒而栗。\n"
		"他手持一根铁铸的打狗棒，棒身上有不少凹痕，显然经历过无数次搏杀。\n"
		"作为丐帮的三袋长老，他本应行侠仗义，却常常利用丐帮威名敲诈勒索，中饱私囊。\n"
		"从他沉稳的步伐和随时准备出手的姿态可以看出，此人武功不俗，绝非等闲之辈。\n");
	
	setup();
}