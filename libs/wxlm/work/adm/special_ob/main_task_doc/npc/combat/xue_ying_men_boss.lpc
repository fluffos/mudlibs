inherit TASK_SPAR_NPC;

void create()
{
	set_name("血影门黑衣人", ({ "xueying boss", "boss", "xueying" }));
	set("gender", "男性");
	set("age", 40);
	set("long", "此人身着黑色劲装，面戴黑色面具，额头中间有三道血红色斜杠。\n"
		"他个子不高也不胖，手持一把寒光闪闪的钢刀，刀身上刻有血影门特有的标记。\n"
		"他的眼神冰冷无情，透露出嗜血的杀意，举手投足间透着一股阴狠毒辣的气息。\n"
		"他应该是血影门的高层人物，身手不凡，实力远超普通门徒和精英。\n");
	set("spar_can_lost",1);
	setup();
} 