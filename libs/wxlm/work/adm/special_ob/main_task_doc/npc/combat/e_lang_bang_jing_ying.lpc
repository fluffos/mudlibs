inherit NPC;

void create()
{
	set_name("恶狼帮精英", ({ "e lang bang jing ying" }));
	set("gender", "男性");
	set("age", 25);
	set("long", "此人身着黑色劲装，腰间系着一条红色腰带，面容凶狠，眼神中透露出狠辣和傲慢。\n"
		"他手持一柄锃亮的钢刀，身上隐约可见几道伤疤，显然是经历过无数次生死搏杀的狠角色。\n"
		"恶狼帮精英在帮中地位颇高，手下管着一批喽啰，平日里横行霸道，无恶不作。\n"
		"看他站立的姿势和警惕的目光，应该有一定的武艺在身。\n");

	setup();
}
