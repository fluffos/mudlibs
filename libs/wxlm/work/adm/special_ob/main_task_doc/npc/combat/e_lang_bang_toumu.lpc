inherit NPC;

void create()
{
	set_name("恶狼帮头目", ({ "e lang bang tou mu" }));
	set("gender", "男性");
	set("age", 25);
	set("long", "此人身材魁梧，一身黑色劲装上绣着狼头图案，腰间系着两条红色腰带，显示其在恶狼帮中的高级地位。\n"
		"他面容阴鸷，眉宇间透着一股狠戾之气，双眼如鹰隼般锐利，扫视四周时令人不寒而栗。\n"
		"他双手各持一把弯刀，刀刃上隐约可见暗红色的血迹，显然常用来残害无辜。\n"
		"作为恶狼帮的头目，他指挥着一批心狠手辣的帮众，在扬州城外欺压百姓，无恶不作。\n"
		"从他沉稳的步伐和随时准备出手的姿态可以看出，此人武功不俗，绝非等闲之辈。\n");

	setup();
}
