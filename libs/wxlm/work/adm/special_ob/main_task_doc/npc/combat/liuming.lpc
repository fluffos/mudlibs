// 流民

inherit NPC;

void create()
{
	set_name("流民", ({ "liuming", "ming" }));
	set("gender", "男性");
	set("age", 25);
	set("long", "此人衣衫褴褛，面容憔悴，眼神中透露出无尽的疲惫和无奈。\n"
		"他身旁跟着一个年幼的孩子，眼神中充满了恐惧和无助。\n"
		"他们似乎是从远方逃难而来，希望能够找到一个安身之所。\n");
	
	set("combat_exp", 1000);
	set("shen_type", -1);

	set("attitude", "aggressive");
	
	set_skill("unarmed", 20);
	set_skill("dodge", 20);
	set_skill("blade", 20);
	set_temp("apply/attack", 10);
	set_temp("apply/defense", 10);

	//设置气血为 100
	set("max_qi",100);


	//可以被刷新
	set("is_refreshable", 1);

	setup();
	carry_object("/clone/misc/cloth")->wear();
}
