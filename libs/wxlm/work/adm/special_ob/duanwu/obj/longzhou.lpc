// longzhou.c 普通龙舟坐骑

#include <armor.h>

inherit MOUNT;

void create()
{
    set_name(YEL "龙舟" NOR, ({ "long zhou", "longzhou", "boat" }));
    set_weight(1);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", YEL "一艘标准的龙舟，船身饰以彩绘，龙头威武，适合在水上竞渡。
" NOR);
        set("unit", "艘");
        set("value", 500000);
        set("material", "wood");
        set("armor_prop/dodge", 60);  // 轻功激发 +60
        set("armor_prop/parry", 60);   // 招架激发 +60
    }
    setup();
} 