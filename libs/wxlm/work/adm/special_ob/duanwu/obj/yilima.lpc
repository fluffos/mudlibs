// yilima.c 伊犁马

#include <armor.h>

inherit MOUNT;

void create()
{
    set_name("伊犁马", ({ "yili ma", "yili", "ma" }));
    set_weight(1); // 马匹较重
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "这是一匹产自伊犁的良驹，体型匀称，奔跑起来耐力极佳。
");
        set("unit", "匹");
        set("value", 300000); // 设定一个合理的价格
        set("material", "leather"); 
        set("armor_prop/dodge", 30);  // 轻功激发 +30
        set("armor_prop/parry", 30);   // 招架激发 +30
        set("no_sell", "这等良驹岂能贩卖！");
        set("no_pawn", "这等良驹岂能典当！");
    }
    setup();
} 