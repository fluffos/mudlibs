// dilu_ma.c 的卢马

#include <armor.h>

inherit MOUNT;

void create()
{
    set_name(HIW "的卢马" NOR, ({ "dilu ma", "dilu", "ma" }));
    set_weight(1);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", HIW "此马眼下有泪槽，额边生白点，据说能妨主，但也曾救过刘备。
" NOR);
        set("unit", "匹");
        set("value", 1000000);
        set("material", "leather");
        set("armor_prop/dodge", 70);  // 轻功激发 +70
        set("armor_prop/parry", 70);   // 招架激发 +70
        set("no_sell", 1);
        set("no_pawn", 1);
    }
    setup();
} 