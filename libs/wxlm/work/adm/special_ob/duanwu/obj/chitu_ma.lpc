// chitu_ma.c 赤兔马

#include <armor.h>

inherit MOUNT;

void create()
{
    set_name(HIR "赤兔马" NOR, ({ "chitu ma", "chitu", "ma" }));
    set_weight(1); // 马匹较重
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", HIR "这是一匹传说中的宝马，浑身赤红如火，奔跑起来快如闪电，嘶鸣声响彻云霄。
" NOR);
        set("unit", "匹");
        set("value", 1500000);
        set("material", "leather"); 
        set("armor_prop/dodge", 80);  // 轻功激发 +80
        set("armor_prop/parry", 80);   // 招架激发 +80
        set("no_sell", "这等神驹岂能贩卖！");
        set("no_pawn", "这等神驹岂能典当！");
    }
    setup();
} 