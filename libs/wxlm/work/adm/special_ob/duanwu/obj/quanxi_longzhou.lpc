// quanxi_longzhou.c 全息龙舟

#include <armor.h>

inherit MOUNT;

void create()
{
    set_name(HIW "全息龙舟" NOR, ({ "quanxi longzhou", "longzhou", "boat" }));
    set_weight(1); // 坐骑通常较重
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", HIW "这是一艘由未来科技打造的全息龙舟，船身流光溢彩，仿佛由光影构成，散发着淡淡的科技气息。
" NOR);
        set("unit", "艘");
        set("value", 2000000);
        set("material", "unknown"); // 特殊材质
        set("armor_prop/dodge", 100);  // 轻功激发 +100
        set("armor_prop/parry", 100);   // 招架激发 +100
        set("no_sell", "这东西太珍贵了，不能卖。");
        set("no_pawn", "这东西太珍贵了，不能当。");
    }
    setup();
} 