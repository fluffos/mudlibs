
#include <room.h>

inherit ROOM;

void create()
{
    set("short", HIG "运河河道" NOR);
    set("long", @LONG
这里是运河的起始河道，水面开阔，两岸绿树成荫。阵阵微风吹过，河面
泛起微波。岸边挤满了前来观看龙舟竞渡的百姓，他们挥舞着彩旗，呐喊助威。
你所在的龙舟正在急速前进，船上的队员们齐心协力，奋力向前划去。前方约
200米处有一座石拱桥，那是第二赛段的开始。
LONG);

    set("exits", ([
        "north" : "/adm/special_ob/duanwu/map/yunhe_daqiao_hedao",
        "south" : "/adm/special_ob/duanwu/map/yunhe_wai",
    ]));
    set("longzhou",1);
    set("outdoors", "city");
    set("no_fight", 1);
    
    setup();
}

// 禁止所有出口
int valid_leave(object me, string dir)
{
    return notify_fail("比赛中，你不能自行离开赛道！\n");
}

void init()
{
    add_action("do_longzhou", "longzhou");
}

// 处理龙舟动作指令
int do_longzhou(string arg)
{
    object me = this_player();
    
    if (!me->query_temp("longzhou_racing"))
    {
        return notify_fail("你没有参加龙舟比赛！\n");
    }
    
    if (!arg)
    {
        return notify_fail("你要做什么动作？可选：划桨、鼓劲、蹬舟\n");
    }
    
    if (arg != "划桨" && arg != "鼓劲" && arg != "蹬舟")
    {
        return notify_fail("无效的动作！可选：划桨、鼓劲、蹬舟\n");
    }
    
    // 调用入口地图的处理函数
    return load_object("/adm/special_ob/duanwu/map/yunhe_wai")->handle_option_selection(me, arg);
}
