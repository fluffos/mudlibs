// 生成以下变量的set和get方法
string code = "弹窗1";
string title;
int number;
mapping *buttons = ({});
int basic(string noWtitle, int noWnumber);
int add_button(string name, string command);
string result();
void set_time(int time);
void remove_me();

void create() 
{
        set_time(2);//自动销毁当前对象
}

int basic(string noWtitle, int noWnumber)
{
        title = noWtitle;
        number = noWnumber;
        return 1;
}

int add_button(string name, string command)
{
        mapping button;

        // 过滤掉按钮的颜色和ZJBR
        name = filter_color(name);
        name = replace_string(name, ZJBR, "");

        button = ([
                "name" : name,
                "command" : command,
        ]);

        buttons += ({ button });

        return 1;
}

string result()
{
        string result;
        mapping jsonData = ([]);
        mapping Data = ([]);

        jsonData["code"] = code;

        Data["title"] = title;
        Data["number"] = number;
        Data["buttons"] = buttons;

        jsonData["data"] = Data;

        result = json_encode(jsonData);

        return result;

}

//定时器，自动销毁当前对象，参数为秒
void set_time(int time)
{
        call_out("remove_me",time);
}

//remove_me 方法 销毁自身
void remove_me()
{
        destruct(this_object());
}