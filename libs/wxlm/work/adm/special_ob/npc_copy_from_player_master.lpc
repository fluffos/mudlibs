// npc_copy_from_player_master.c
// Created by Lu dexiang
// 用于创建复制玩家技能和属性的NPC对象
inherit F_CLEAN_UP;

/**
 * 复制玩家的技能到目标对象
 * @param object me 目标对象
 * @param object ob 源玩家对象
 * @return int 成功返回1,失败返回0
 */
private int copy_skill(object me, object ob)
{
    mapping hp_status, skill_status, map_status, prepare_status;
    mapping my;
    string *sname, *mname, *pname;
    int i, temp;

    // 清除目标对象的所有技能
    if (mapp(skill_status = me->query_skills()))
    {
        skill_status = me->query_skills();
        sname = keys(skill_status);
        
        temp = sizeof(skill_status);
        for (i = 0; i < temp; i++)
            me->delete_skill(sname[i]);
    }

    // 复制技能
    if (mapp(skill_status = ob->query_skills()))
    {
        skill_status = ob->query_skills();
        sname = keys(skill_status);
        
        for (i = 0; i < sizeof(skill_status); i++)
            me->set_skill(sname[i], skill_status[sname[i]]);
    }
    
    // 清除目标对象的技能映射
    if (mapp(map_status = me->query_skill_map()))
    {
        mname = keys(map_status);
        
        temp = sizeof(map_status);
        for (i = 0; i < temp; i++)
            me->map_skill(mname[i]);
    }

    // 复制技能映射
    if (mapp(map_status = ob->query_skill_map()))
    {
        mname = keys(map_status);
        
        for(i = 0; i < sizeof(map_status); i++)
            me->map_skill(mname[i], map_status[mname[i]]);
    }

    // 清除目标对象的技能准备
    if (mapp(prepare_status = me->query_skill_prepare()))
    {
        pname = keys(prepare_status);
        
        temp = sizeof(prepare_status);
        for(i = 0; i < temp; i++)
            me->prepare_skill(pname[i]);
    }

    // 复制技能准备
    if (mapp(prepare_status = ob->query_skill_prepare()))
    {
        pname = keys(prepare_status);
        
        for(i = 0; i < sizeof(prepare_status); i++)
            me->prepare_skill(pname[i], prepare_status[pname[i]]);
    }

    // 复制属性
    hp_status = ob->query_entire_dbase();
    my = me->query_entire_dbase();

    my["str"] = hp_status["str"];
    my["int"] = hp_status["int"];
    my["con"] = hp_status["con"];
    my["dex"] = hp_status["dex"];

    my["max_qi"]     = hp_status["max_qi"];
    my["eff_qi"]     = hp_status["eff_qi"];
    my["qi"]         = hp_status["qi"];
    my["max_jing"]   = hp_status["max_jing"];
    my["eff_jing"]   = hp_status["eff_jing"];
    my["jing"]       = hp_status["jing"];
    my["max_neili"]  = hp_status["max_neili"];
    my["neili"]      = hp_status["neili"];
    my["jiali"]      = hp_status["jiali"];
    my["combat_exp"] = hp_status["combat_exp"];

    me->reset_action();
    return 1;
}

/**
 * 创建一个复制了玩家技能和属性的NPC对象
 * @param object player 要复制的玩家对象
 * @param string npc_file NPC对象文件路径,默认为继承NPC基类的对象
 * @return object 返回创建的NPC对象,失败返回0
 */
varargs public object create_npc(object player, string npc_file)
{
    object npc;
    
    if (!objectp(player))
        return 0;
        
    if (!stringp(npc_file) || npc_file == "")
        npc_file = NPC_COPY;
        
    // 创建NPC对象
    npc = new(npc_file);
    if (!objectp(npc))
        return 0;
        
    // 设置基本信息
    npc->set_name(player->query("name"), ({ player->query("id") + " copy" }));
    npc->set("title", player->query("title"));
    npc->set("gender", player->query("gender")); 
    npc->set("age", player->query("age"));
    npc->set("long", "这是" + player->query("family/family_name") + "的" + player->query("name") + "。");

    // 复制技能和属性
    if (!copy_skill(npc, player))
    {
        destruct(npc);
        return 0;
    }
    
    return npc;
}

// 测试接口
int main(object me, string arg)
{
    object player, npc;
    
    if (!wizardp(me))
        return 0;
        
    if (!arg)
        return notify_fail("指令格式: npc_copy <玩家id>\n");
        
    player = find_player(arg);
    if (!objectp(player))
        return notify_fail("没有找到这个玩家。\n");
        
    npc = create_npc(player, 0);
    if (!objectp(npc))
        return notify_fail("创建NPC失败。\n");
        
    npc->move(environment(me));
    message_vision("$N召唤出一个$n的复制人。\n", me, player);
    
    return 1;
}
