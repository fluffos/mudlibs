// kaochang.c 统一考场
// by ices-y 2024-07-25
#define KEJU_D "/adm/special_ob/keju/keju_d"
inherit ROOM;
int do_jixu();
void create()
{
    set("short", "考场");
    set("long", @LONG
这里就是科举的考场，四面一片寂静，只有几位巡考官在来回
走动。所有的考生都埋头于自己的座位上，奋笔疾书。你最好也
赶快坐下，开始答题吧。如果你不小心关闭了答题窗口，可以点击下方按钮继续答题。
LONG);

    set("no_fight", 1);
	set("action_list", ([
		HIC"继续答题"NOR : "jixu",
	]));
    set("no_fight", 1);
    setup();
}

void init()
{
    add_action("do_nothing", "exit");
    add_action("do_nothing", "go");
    add_action("do_nothing", "quit");
    add_action("do_jixu", "jixu");
}

int do_nothing(string arg)
{
    tell_object(this_player(), "考场纪律严明，不可随意离开！\n");
    return 1;
}

int do_jixu()
{
    KEJU_D->resume_exam(this_player());
    return 1;
}

