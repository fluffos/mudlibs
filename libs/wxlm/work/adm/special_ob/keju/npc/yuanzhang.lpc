// yuanzhang.c 院长
// by ices-y 2024-07-25

inherit NPC;
string handle_apply();
int do_apply(string arg);
string handle_start();
void create()
{
    set_name("学院院长", ({ "yuan zhang", "zhang" }));
    set("long", "他就是长安学院的院长，负责主持每年的院试。");
    set("gender", "男性");
    set("age", 65);

    set("inquiry", ([
        "报名": (: handle_apply :),
        "开始": (: handle_start :),
    ]));

    setup();
}

void init()
{
    add_action("do_apply", "apply");
    add_action("do_start", "start");
}

#define KEJU_D "/adm/special_ob/keju/keju_d"

// 处理报名询问，弹出确认窗口
string handle_apply()
{
    object me = this_player();
    string result = KEJU_D->can_apply(me, "yuan");

    if (result != "success")
    {
        return result;
    }

    return popup_comb("你确定要报名参加本次院试吗？", ({ "确认报名:apply yuan", "我再想想:" }));
}

// 执行报名
int do_apply(string arg)
{
    object me = this_player();
    if (arg == "yuan")
    {
        KEJU_D->do_apply(me, "yuan");
        return 1;
    }
    return 0;
}

// 处理开始考试
string handle_start()
{
    // TODO: 检查是否在考试时间
    return popup_comb("院试即将开始，你准备好了吗？", ({ "准备好了:start exam yuan", "我再等等:" }));
}

int do_start(string arg)
{
    if (arg == "exam yuan")
    {
        KEJU_D->start_exam(this_player(), "yuan");
        return 1;
    }
    return 0;
}
