// jiankaoguan.c 监考官
// by ices-y 2024-07-25

inherit NPC;
string handle_apply();
int do_apply(string arg);
string handle_start();

void create()
{
    set_name("监考官", ({ "jiankao guan", "guan" }));
    set("long", "他负责乡试的监考工作，眼神锐利，不放过任何一个可疑的举动。");
    set("gender", "男性");
    set("age", 45);

    set("inquiry", ([
        "报名": (: handle_apply :),
        "开始": (: handle_start :),
    ]));

    setup();
}

void init()
{
    add_action("do_apply", "apply");
    add_action("do_start", "start");
}

#define KEJU_D "/adm/special_ob/keju/keju_d"

// 处理报名询问
string handle_apply()
{
    object me = this_player();
    string result = KEJU_D->can_apply(me, "xiang");

    if (result != "success")
    {
        return result;
    }

    return popup_comb("你确定要报名参加本次乡试吗？\n（需要秀才身份）", ({ "确认报名:apply xiang", "我再想想:" }));
}

// 执行报名
int do_apply(string arg)
{
    object me = this_player();
    if (arg == "xiang")
    {
        KEJU_D->do_apply(me, "xiang");
        return 1;
    }
    return 0;
}

// 处理开始考试
string handle_start()
{
    return popup_comb("乡试即将开始，你准备好了吗？", ({ "准备好了:start exam xiang", "我再等等:" }));
}

int do_start(string arg)
{
    if (arg == "exam xiang")
    {
        KEJU_D->start_exam(this_player(), "xiang");
        return 1;
    }
    return 0;
}
