#define KEJU_D "/adm/special_ob/keju/keju_d"

inherit NPC;
string handle_apply();
int do_apply(string arg);
string handle_start();
void create()
{
    set_name("大正皇帝", ({ "emperor", "huangdi" }));
    set("long", "他就是当今圣上，大正皇帝。他亲自主持殿试，以示对人才的重视。");
    set("gender", "男性");
    set("age", 40);

    set("inquiry", ([
        "报名": (: handle_apply :),
        "开始": (: handle_start :),
    ]));

    setup();
}

void init()
{
    add_action("do_apply", "apply");
    add_action("do_start", "start");
}

// 处理报名询问
string handle_apply()
{
    object me = this_player();
    string result = KEJU_D->can_apply(me, "dian");

    if (result != "success")
    {
        return result;
    }

    return popup_comb("你确定要报名参加本次殿试吗？\n（需要贡士身份）", ({ "确认报名:apply dian", "我再想想:look" }));
}

// 执行报名
int do_apply(string arg)
{
    object me = this_player();

    if (arg == "dian")
    {
        KEJU_D->do_apply(me, "dian");
        return 1;
    }
    return 0;
}

// 处理开始考试
string handle_start()
{
    return popup_comb("殿试即将开始，你准备好了吗？", ({ "准备好了:start exam dian", "我再等等:" }));
}

int do_start(string arg)
{
    if (arg == "exam dian")
    {
        KEJU_D->start_exam(this_player(), "dian");
        return 1;
    }
    return 0;
}
