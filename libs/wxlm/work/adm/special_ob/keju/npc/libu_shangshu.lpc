// libu_shangshu.c 礼部尚书
// by ices-y 2024-07-25

inherit NPC;
string handle_apply();
int do_apply(string arg);
string handle_start();
void create()
{
    set_name("礼部尚书", ({ "libu shangshu", "shangshu" }));
    set("long", "他身为礼部尚书，负责主持会试，选拔国家栋梁之才。");
    set("gender", "男性");
    set("age", 55);

    set("inquiry", ([
        "报名": (: handle_apply :),
        "开始": (: handle_start :),
    ]));

    setup();
}

void init()
{
    add_action("do_apply", "apply");
    add_action("do_start", "start");
}

#define KEJU_D "/adm/special_ob/keju/keju_d"

// 处理报名询问
string handle_apply()
{
    object me = this_player();
    string result = KEJU_D->can_apply(me, "hui");

    if (result != "success")
    {
        return result;
    }

    return popup_comb("你确定要报名参加本次会试吗？\n（需要举人身份）", ({ "确认报名:apply hui", "我再想想:" }));
}

// 执行报名
int do_apply(string arg)
{
    object me = this_player();
    if (arg == "hui")
    {
        KEJU_D->do_apply(me, "hui");
        return 1;
    }
    return 0;
}

// 处理开始考试
string handle_start()
{
    return popup_comb("会试即将开始，你准备好了吗？", ({ "准备好了:start exam hui", "我再等等:" }));
}

int do_start(string arg)
{
    if (arg == "exam hui")
    {
        KEJU_D->start_exam(this_player(), "hui");
        return 1;
    }
    return 0;
}
