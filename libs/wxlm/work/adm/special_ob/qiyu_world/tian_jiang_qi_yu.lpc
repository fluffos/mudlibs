//ai模块
#define DESC_MAN "/system/ai_chat/desc_man"

mapping qiyu_obj = ([
    "pt_list": ({
        "/clone/vip/book_tianfu",
        "/clone/vip/book_wuliang",
        "/clone/vip/build_ling",
        "/clone/vip/dan_qingxin",
        "/clone/vip/dan_xieqi",
        "/clone/vip/dan_zhengqi",
        "/clone/vip/fushougao",
        "/clone/vip/jinsha",
        "/clone/vip/lingzhi",
        "/clone/vip/lingzhi2",
        "/clone/vip/putao",
        "/clone/vip/tianxiang",
        "/clone/vip/yanzhi",
        "/clone/vip/yanzhi2",
        "/clone/vip/zyao1",
        "/clone/aoyi_book/aoyi_book_canye"
    }),
]);


void create()
{
    set_heart_beat(1);
}

int trigger_qiyu(object me)
{
    string msg;
    string obj_path;

    msg = "man_desc.py 你现在是一个武侠mud游戏（以古代武侠为背景）的奇遇制作机，你需要根据用户提供的奇遇信息编写和构造一个完整的天降奇遇故事，即奇遇人经历了什么样的故事，获得了什么样的物品。一次性构造完整。";

    obj_path = random_element(qiyu_obj["pt_list"]);

    msg += sprintf("1.奇遇人名称:%s-",me->query("name"));
    msg += sprintf("2.奇遇物品名称:%s-",obj_path->query("name"));
    msg += sprintf("3.奇遇物品描述:%s-",obj_path->query("long"));
    msg += sprintf("4.奇遇触发地点名称:%s-",environment(me)->query("short"));
    msg += sprintf("5.奇遇触发地点描述:%s-",environment(me)->query("long"));

    msg += "故事约束:";
    msg += "1.不要公布你的思考过程，直接给出故事。";
    msg += "2.故事必须和奇遇信息先关联，对奇遇物品的作用不得胡编乱造";
    msg += "3.故事文笔使用金庸风格。";
    msg += "4.故事不得超过500字。";

    DESC_MAN->main(me,msg);

    return 1;
}
