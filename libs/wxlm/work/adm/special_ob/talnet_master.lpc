//获取一个天赋的等级
int query_talnet_level(object me,string basic_name)
{
	int level;
	
	level = 0;

	if (me->query("special_skill/" + basic_name))
	{
		level = 1;

		// 获取天赋宝石的加成
		level += me->query_temp("talent_level");
	}

	if (me->query("myspecial/"+basic_name+"/level"))
	{
		level += me->query("myspecial/"+basic_name+"/level");
	}

	if (level > 10)
		level = 10;

	return level;

}

//返回一个不带天赋宝石加成的天赋等级，这是一个准确的等级
int query_talnet_level_sure(object me,string basic_name)
{
	int level;
	
	level = 0;

	if (me->query("special_skill/" + basic_name))
	{
		level = 1;
	}

	if (me->query("myspecial/"+basic_name+"/level"))
	{
		level += me->query("myspecial/"+basic_name+"/level");
	}
	return level;
}

//根据天赋等级重新赋予名称
string level_name(object me,string basic_name)
{
	int level;
	int name_sub;
	mapping yellow = ([
		"绿色":HIG,
		"蓝色":HIB,
		"金色":HIY,
		"红色":HIR,
	]);

	if (name_map_list[basic_name] == 1)
		return yellow[talnet_quality[basic_name]] + SPECIAL_D(basic_name)->name() + NOR;
		// return SPECIAL_D(basic_name)->name();

	//每两级变换一次名称
	level = query_talnet_level(me,basic_name);
	name_sub = level <= 2 ? 0 : (level) / 2;
	// return name_map_list[basic_name][name_sub];
	//赋予颜色
	if (name_sub >= sizeof(name_map_list[basic_name]))
	{
		name_sub = sizeof(name_map_list[basic_name]) - 1;
	}

	return yellow[talnet_quality[basic_name]] + name_map_list[basic_name][name_sub] + NOR;

}

// 根据天赋等级重新赋予描述
string level_desc(object me, string basic_name)
{
    int level;
    int desc_value;
    mixed desc, *level_points;
    string level_points_str;

    // 如果描述为1，直接返回特殊描述
    if (desc_map_list[basic_name] == 1)
        return SPECIAL_D(basic_name)->desc();

    // 获取天赋等级
    level = query_talnet_level(me, basic_name);

    desc = desc_map_list[basic_name];

	//统一信息返回处理，当一个玩家查看一个天赋时应该正常按照1级显示描述。
	if (level == 0)
		level = 1;

	while (sizeof(pcre_extract(desc, "([0-9]+)\\+level")))
	{
		string *pcre_list;
		//匹配出来所有符合条件的字符串
		pcre_list = pcre_extract(desc, "([0-9]{1,3})\\+level");
		//循环替换
		foreach(string pcre_str in pcre_list)
		{
			//替换字符串
			desc = replace_string(desc, pcre_str + "+level", "" + (level + atoi(pcre_str)));
		}
	}


    // x法规则
    while (sizeof(pcre_extract(desc, "([0-9]+)xlevel")))
    {
		string *pcre_list;
		//匹配出来所有符合条件的字符串
		pcre_list = pcre_extract(desc, "([0-9]{1,3})xlevel");
		//循环替换
		foreach(string pcre_str in pcre_list)
		{
			//替换字符串
			desc = replace_string(desc, pcre_str + "xlevel", "" + (level * atoi(pcre_str)));
		}
    }



    // 多参数规则
    if (sscanf(desc, "%*s([%s])%*s", level_points_str))
    {
        level_points = explode(level_points_str, ",");
		
		if (level < 1)
			level = 1;

        desc_value = level_points[level - 1];
        desc = replace_string(desc, "([" + level_points_str + "])", desc_value + "点");
    }

    return desc;
}

// 返回一个天赋是属于什么品质的天赋
string query_talnet_quality(string basic_name)
{
	return talnet_quality[basic_name];
}

//主动释放的技能列表
