
mapping result = ([
    "title": "",
    "w": "330",
    "h": "100",
    "close": ({

    }),
    "toggle": ({

    }),
    "data": ([
        "title": "",
        "context": ({})
    ]),
    "is_cmd":""
]);

void set_title(string title)
{
    result["title"] = title;
}

// 设置窗口的宽度
void set_width(string w)
{
    result["w"] = w;
}

// 设置窗口的高度
void set_height(string h)
{
    result["h"] = h;
}

// 添加关闭按钮
void add_close_button(string text, string cmd)
{
    result["close"] += ({ (["cmd": cmd, "text": text]) });
}

// 添加分类按钮
void add_toggle_button(string text, string cmd)
{
    result["toggle"] += ({ (["cmd": cmd, "text": text]) });
}

// 添加data的title
void add_data_title(string title)
{
    result["data"]["title"] = title;
}

// 添加分类后的按钮
void add_data_button(string text, string cmd)
{
    result["data"]["context"] += ({ (["cmd": cmd, "text": text]) });
}

//清除分类后的按钮
void clear_data_button()
{
    result["data"]["context"] = ({});
}

// 返回结果
string result()
{
    result = ([
        "code": "导航弹窗",
        "data": result
    ]);

    return json_encode(result) + "\n";
}

//定时器，自动销毁当前对象，参数为秒
void set_time(int time)
{
        call_out("remove_me",time);
}

//remove_me 方法 销毁自身
void remove_me()
{
        destruct(this_object());
}

//设定命令id
void set_id(string cmd)
{
        result["is_cmd"] = cmd;
}

void create() 
{
        set_time(2);//自动销毁当前对象
}

