//自动进行日常任务的一些逻辑处理

mixed do_cmd(object me,string cmd)
{
    return me->force_me(cmd);
}

//可变参数，可以指定是否有指定的延迟时间
varargs int auto_cmd(object me,string cmd,int delayTime)
{
    int is_auto_fuben;
    int now_delay_time = 5; // 默认延迟时间
    is_auto_fuben = me->query("env/auto_fuben");

    if (!is_auto_fuben)
    {
        return 0;
    }

    if (!undefinedp(delayTime))
    {
        now_delay_time = delayTime;
    }

    tell_object(me, "你将在" + now_delay_time + "秒后继续自动执行日常任务。\n");
    //延迟时间执行一条命令
    call_out("do_cmd", now_delay_time, me, cmd);

    return 1;

}

//一个环境除了我自己是否还有其他不属于玩家的活物
mixed is_not_player(object me)
{
    object *inv;
    int i;
    inv = all_inventory(environment(me));
    for (i = 0; i < sizeof(inv); i++)
    {
        if (!playerp(inv[i]) && living(inv[i]) && inv[i] != me)
        {
            return inv[i];
        }
    }
    return 0;
}
