mapping base_equip_list = ([
    // 剑类武器
    "sword" : "clone/weapon/changjian",     // 长剑
    
    // 刀类武器
    "blade"     : "clone/weapon/mudao",         // 木刀
    
    "whip" : "clone/weapon/changbian",     // 长鞭
    
    // 杖类武器
    "staff"   : "clone/weapon/zhubang",       // 竹棒
    
    // 暗器类武器
    "throwing"    : "clone/weapon/feidao",        // 飞刀
    
    // 长兵器
    "club" : "clone/weapon/changqiang",    // 长枪
    
    //锤
    "hammer"    : "clone/weapon/hammer",        // 铁锤

    //短兵器
    "dagger"    : "clone/weapon/dagger",        // 匕首

    //琴
    "qin" : "clone/weapon/qin",        // 琴
]);


//获取武器类型列表
string *get_weapon_type_list()
{
    return keys(base_equip_list);
}

//获取一把武器，参数是武器类型
object get_weapon(string weapon_type)
{
    string weapon_path;
    object weapon_obj;
    
    if (!weapon_type || weapon_type == "")
        return 0;
        
    if (!mapp(base_equip_list) || undefinedp(base_equip_list[weapon_type]))
        return 0;
        
    weapon_path = base_equip_list[weapon_type];
    if (!weapon_path || weapon_path == "")
        return 0;
        
    weapon_obj = new(weapon_path);
    if (!objectp(weapon_obj))
        return 0;

    weapon_obj->set("no_limit_wield", 1);
        
    return weapon_obj;
}



