// 获取随机一本典籍的名称
string get_random_book()
{
    string *all_books = keys(baijia_books);
    
    if (!sizeof(all_books))
        return ""; // 如果没有典籍，返回空字符串
        
    return all_books[random(sizeof(all_books))];
}

