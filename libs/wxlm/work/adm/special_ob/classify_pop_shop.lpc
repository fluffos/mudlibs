private mapping ui_data = ([
    "title": "",
    "toggle": ({
    }),
    "data": ([
        "title": "",
        "context": ({}),
        "second_classify": ({}),
    ]),
    "is_cmd":"",
    // "close": ({}),
]);

// 数据验证函数
private int validate_text_cmd(string text, string cmd) 
{
    if (!text || !cmd || text == "" || cmd == "")
        return 0;
    return 1;
}

void set_title(string title)
{
    if (!title || title == "")
        return;
    ui_data["title"] = title;
}

// void add_close_button(string text, string cmd)
// {
//     if (!validate_text_cmd(text, cmd))
//         return;
//     ui_data["close"] += ({ (["cmd": cmd, "text": text]) });
// }

void add_toggle_button(string text, string cmd)
{
    if (!validate_text_cmd(text, cmd))
        return;
    ui_data["toggle"] += ({ (["cmd": cmd, "text": text]) });
}

void add_second_toggle_button(string text, string cmd)
{
    if (!validate_text_cmd(text, cmd))
        return;
    ui_data["data"]["second_classify"] += ({ (["cmd": cmd, "text": text]) });
}

void add_data_title(string title)
{
    if (!title || title == "")
        return;
    ui_data["data"]["title"] = title;
}

void add_data_button(string text, string cmd)
{
    if (!validate_text_cmd(text, cmd))
        return;
    ui_data["data"]["context"] += ({ (["cmd": cmd, "text": text]) });
}

void clear_data_button()
{
    ui_data["data"]["context"] = ({});
}

string get_json_result()
{
    mapping final_result = ([
        "code": "game_shop",
        "data": ui_data
    ]);

    return json_encode(final_result) + "\n";
}

void set_time(int time)
{
    if (time <= 0)
        time = 2;  // 默认2秒
    call_out("remove_me", time);
}

void remove_me()
{
    destruct(this_object());
}

void set_id(string cmd)
{
    if (!cmd || cmd == "")
        return;
    ui_data["is_cmd"] = cmd;
}

void create() 
{
    // 初始化数据结构
    ui_data = ([
        "title": "",
        "toggle": ({}),
        // "close": ({}),
        "data": ([
            "title": "",
            "context": ({}),
            "second_classify": ({}),
        ]),
        "is_cmd": ""
    ]);
    set_time(2);
}
