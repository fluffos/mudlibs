   void save()
   {
       save_object(DATA_DIR "faction/factions");
   }
   
   void restore()
   {
       restore_object(DATA_DIR "faction/factions");
   }
   
   string *query_all_faction_ids()
   {
       return keys(factions);
   }
   
   mapping query_faction(string id)
   {
       return factions[id];
   }
   
   int query_prestige(string id)
   {
       if (undefinedp(factions[id]))
           return 0;
       return factions[id]["prestige"];
   }
   
   void set_prestige(string id, int prestige)
   {
       if (undefinedp(factions[id]))
           return;
       factions[id]["prestige"] = prestige;
       save();
   }
   
   void add_prestige(string id, int amount)
   {
       if (undefinedp(factions[id]))
           return;
       factions[id]["prestige"] += amount;
       save();
   }
   
   void add_invasion_count(string id)
   {
       if (undefinedp(factions[id]))
           return;
       factions[id]["invasions"] += 1;
       save();
   }
   
   void add_defense_count(string id)
   {
       if (undefinedp(factions[id]))
           return;
       factions[id]["defenses"] += 1;
       save();
   }
   
   int query_invasion_count(string id)
   {
       if (undefinedp(factions[id]))
           return 0;
       return factions[id]["invasions"];
   }
   
   int query_defense_count(string id)
   {
       if (undefinedp(factions[id]))
           return 0;
       return factions[id]["defenses"];
   }
   
   string query_faction_type(string id)
   {
       if (undefinedp(factions[id]))
           return "";
       return factions[id]["type"];
   }
   
   // 确保数据目录存在
   void assure_save_dir(string dir)
   {
       string *dirs;
       string path;
       int i;
   
       dirs = explode(dir, "/");
       path = "/";
       for (i = 0; i < sizeof(dirs); i++)
       {
           path += dirs[i] + "/";
           if (file_size(path) == -1)
               mkdir(path);
       }
   }
   
   // 新增函数，用于获取所有门派的入侵次数
   mapping query_all_invasions()
   {
       mapping invasions = ([]);
       string *ids = keys(factions);
       foreach (string id in ids)
       {
           invasions[id] = factions[id]["invasions"];
       }
       return invasions;
   }
   
   // 新增函数，用于获取所有门派的防守次数
   mapping query_all_defenses()
   {
       mapping defenses = ([]);
       string *ids = keys(factions);
       foreach (string id in ids)
       {
           defenses[id] = factions[id]["defenses"];
       }
       return defenses;
   }
   
   // 新增函数，用于获取所有门派的威望
   mapping query_all_prestiges()
   {
       mapping prestiges = ([]);
       string *ids = keys(factions);
       foreach (string id in ids)
       {
           prestiges[id] = factions[id]["prestige"];
       }
       return prestiges;
   }
   
   string *get_evil_factions()
   {
       string *evil = ({});
       foreach (string id, mapping data in factions)
       {
           if (data["type"] == "邪派")
               evil += ({ id });
       }
       return evil;
   }

   string *get_neutral_factions()
   {
       string *neutral = ({});
       foreach (string id, mapping data in factions)
       {
           if (data["type"] == "中立")
               neutral += ({ id });
       }
       return neutral;
   }

   string *get_good_factions()
   {
       string *good = ({});
       foreach (string id, mapping data in factions)
       {
           if (data["type"] == "正派")
               good += ({ id });
       }
       return good;
   }

   // 在文件末尾添加这个新函数
   string get_faction_name(string id)
   {
       if (undefinedp(factions[id]))
           return id; // 如果找不到对应的门派，返回原始ID
       return factions[id]["name"];
   }