// 定义存储路径
#define SELF_SKILL_DIR "/data/self_skill/"

inherit F_DBASE;

// 函数前向声明
void create();
int check_player_condition(object me);
int check_skill_in_pool(string skill);
mapping get_skill_pool_attributes(string skill);
string create_self_skill(object me, string skill_name, string pfm_name);
int add_action_to_skill(object me, string skill_id, mapping action_data);
mapping create_single_action(string skill_name, mapping ap_settings, mapping damage_settings, string msg, string hit_msg);
mapping create_combo_action(string skill_name, string msg, string hit_msg);
mapping create_real_action(string skill_name, mapping ap_settings, mapping damage_settings, string msg, string damage_type, string hit_msg);
int save_self_skill(string user_id, mapping skill_data);
mapping load_self_skill(string user_id);
mapping get_all_self_skills(string user_id);
mapping get_self_skill_detail(string user_id, string skill_id);
int upgrade_action_level(object me, string skill_id, int action_index);
string query_dodge_msg();
mapping merge_skill_attributes(string main_skill, string sub_skill);

