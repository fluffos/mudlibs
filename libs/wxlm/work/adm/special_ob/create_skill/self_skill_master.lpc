        "name":"九阳神功",
        "ap":([
            "skill":({ "force","dodge","parry" }),//只有三个武学激发可选
            "attribute":({ }),//属性为空，只能选择武学激发
            "jiaoli":1,
        ]),
        "damage":([
            "skill":({ "force","spells" }),
            "attribute":({ }),
        ]),
        "pfm_type":({ "single","real" }),
        "ability":15,
    ]),
    "taiji-jian":([
        "name":"太极剑法",
        "ap":([
            "skill":({ "sword","parry","dodge" }),
            "attribute":({ "dex" }),//只有一个属性可选
            "jiaoli":1,
        ]),
        "damage":([
            "skill":({ "sword","parry" }),
            "attribute":({ "dex" }),
        ]),
        "pfm_type":({ "single","combo","real" }),
        "ability":14,
    ])
]);

//在计算ap命中时，该武学一个比较的武学,如果一个ap激发没用在如下列表中有对应的值，那么随机从dodge，parry，force中取值
mapping dp_comparison_skill = ([
    "dodge":({ "dodge","parry" }),
    "force":({ "force" }),
    "parry":({ "parry","dodge" }),
]);

//在计算dp命中时，该武学一个比较的武学,如果一个ap属性没用在如下列表中有对应的值，那么随机从dex，str，con中取值
mapping dp_comparison_attribute = ([
    "str":({ "dex","str" }),
    "dex":({ "dex","int" }),
    "con":({ "str","con" }),
    "int":({ "con","str" }),
]);

