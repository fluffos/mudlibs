// 战斗力配置参数
mapping power_config = ([
    "min_power" : 50,      // 最小战斗力
    "max_power" : 50000,   // 最大战斗力
    "exp_factor" : 1.0,    // 经验值调整因子
    "qi_factor" : 1.0,     // 气血调整因子
    "neili_factor" : 1.0,  // 内力调整因子
    "skill_factor" : 1.0,  // 技能调整因子
    "precision" : 2.0,     // 精确度系数，值越大，相邻战力差异越明显
    
    // 基础属性系数（用于直接计算，不再使用参考点）
    "base_exp" : 100000,   // 基础经验值（100战力时）
    "base_qi" : 1000,      // 基础气血（100战力时）
    "base_neili" : 500,    // 基础内力（100战力时）
    "base_skill" : 30,     // 基础技能等级（100战力时）
    
    // 属性增长系数
    "exp_growth" : 1.15,   // 经验值增长系数
    "qi_growth" : 1.08,    // 气血增长系数
    "neili_growth" : 1.1,  // 内力增长系数
    "skill_growth" : 0.4,  // 技能增长系数
    
    // 属性增长偏移量
    "skill_offset" : 0.0,  // 技能增长偏移量
    
    // 战力与技能等级的对应关系（用于微调）
    "power_skill_map" : ([
        1000 : 165,  // 1000战力对应165级技能
        2000 : 280,  // 2000战力对应280级技能
        3000 : 400,  // 3000战力对应400级技能
        3500 : 460,  // 3500战力对应460级技能
        4000 : 520,  // 4000战力对应520级技能
        4500 : 580,  // 4500战力对应580级技能
        5000 : 640,  // 5000战力对应640级技能
        7500 : 920,  // 7500战力对应920级技能
        10000 : 1200 // 10000战力对应1200级技能
    ])
]);


/**
 * @brief 计算指定战斗力对应的属性调整值
 * @param int power 战斗力值
 * @return mapping 包含各属性调整值的映射
 * @details 使用直接计算公式而非参考点插值，确保每个战力值都有精确对应的属性值
 */
mapping calculate_power_adjust(int power)
{
    mapping result = ([]);
    float precision;
    float power_ratio;
    float exp_growth;
    float base_exp;
    float exp_factor;
    float qi_growth;
    float base_qi;
    float qi_factor;
    float neili_growth;
    float base_neili;
    float neili_factor;
    float skill_growth;
    float base_skill;
    float skill_factor;
    float skill_offset;
    float base_skill_value;
    mapping power_skill_map;
    int *power_points;
    int lower_power = 0;
    int upper_power = 0;
    float precision_adjust;
    float cycle_adjust;
    float exp_precision_adjust;
    float exp_cycle_adjust;
    float qi_precision_adjust;
    float qi_cycle_adjust;
    float neili_precision_adjust;
    float neili_cycle_adjust;
    
    // 限制战斗力范围
    if (power < power_config["min_power"])
        power = power_config["min_power"];
    if (power > power_config["max_power"])
        power = power_config["max_power"];
    
    // 精确度系数，用于放大相邻战力值的差异
    precision = power_config["precision"];
    
    // 计算战力比率（相对于100点战力）
    power_ratio = (float)power / 100.0;
    
    // 计算经验值 - 使用指数增长公式
    exp_growth = power_config["exp_growth"];
    base_exp = power_config["base_exp"];
    exp_factor = power_config["exp_factor"];
    
    // 添加更精细的随机波动，确保相邻战力值有区别
    exp_precision_adjust = 1.0 + (power % 100) * 0.001 * precision;
    exp_cycle_adjust = 1.0 + sin((power % 1000) / 1000.0 * 3.14159) * 0.02 * precision;
    
    result["exp"] = to_int(base_exp * pow(power_ratio, exp_growth) * exp_factor * 
                          exp_precision_adjust * exp_cycle_adjust);
    
    // 计算气血值 - 使用指数增长公式
    qi_growth = power_config["qi_growth"];
    base_qi = power_config["base_qi"];
    qi_factor = power_config["qi_factor"];
    
    // 添加更精细的随机波动，确保相邻战力值有区别
    qi_precision_adjust = 1.0 + (power % 100) * 0.001 * precision;
    qi_cycle_adjust = 1.0 + cos((power % 1000) / 1000.0 * 3.14159) * 0.02 * precision;
    
    result["qi"] = to_int(base_qi * pow(power_ratio, qi_growth) * qi_factor * 
                         qi_precision_adjust * qi_cycle_adjust);
    
    // 计算内力值 - 使用指数增长公式
    neili_growth = power_config["neili_growth"];
    base_neili = power_config["base_neili"];
    neili_factor = power_config["neili_factor"];
    
    // 添加更精细的随机波动，确保相邻战力值有区别
    neili_precision_adjust = 1.0 + (power % 100) * 0.001 * precision;
    neili_cycle_adjust = 1.0 + sin((power % 1000) / 1000.0 * 6.28318) * 0.02 * precision;
    
    result["neili"] = to_int(base_neili * pow(power_ratio, neili_growth) * neili_factor * 
                            neili_precision_adjust * neili_cycle_adjust);
    
    // 计算技能等级 - 使用特殊公式，确保与指定的战力-技能对应关系匹配
    // 首先使用基础公式计算初步技能值
    skill_growth = power_config["skill_growth"];
    base_skill = power_config["base_skill"];
    skill_factor = power_config["skill_factor"];
    skill_offset = power_config["skill_offset"];
    
    // 基础计算公式：技能 = 基础技能 + (战力比率 ^ 技能增长系数) * 调整因子
    base_skill_value = base_skill + power_ratio * skill_growth * 100 + skill_offset;
    
    // 根据power_skill_map进行微调
    power_skill_map = power_config["power_skill_map"];
    power_points = sort_array(keys(power_skill_map), 1);
    
    // 找到最接近的两个参考点
    foreach (int point in power_points)
    {
        if (power <= point)
        {
            upper_power = point;
            break;
        }
        lower_power = point;
    }
    
    // 如果power小于最小参考点
    if (lower_power == 0 && upper_power > 0)
    {
        float target_skill = power_skill_map[upper_power];
        float ratio = (float)power / upper_power;
        // 使用非线性插值，确保更平滑的过渡
        base_skill_value = target_skill * pow(ratio, 1.05);
    }
    // 如果power大于最大参考点
    else if (upper_power == 0 && lower_power > 0)
    {
        float target_skill = power_skill_map[lower_power];
        float ratio = (float)power / lower_power;
        // 使用非线性插值，确保更平滑的过渡
        base_skill_value = target_skill * pow(ratio, 1.1);
    }
    // 在两个参考点之间进行插值
    else if (lower_power > 0 && upper_power > 0)
    {
        float fine_adjust;
        float lower_skill = power_skill_map[lower_power];
        float upper_skill = power_skill_map[upper_power];
        float ratio = (float)(power - lower_power) / (upper_power - lower_power);
        
        // 使用非线性插值计算技能值，确保更精细的变化
        // 使用幂函数调整插值曲线，使其更符合游戏平衡
        float curve_factor = 0.8 + 0.4 * sin(ratio * 3.14159);
        base_skill_value = lower_skill + (upper_skill - lower_skill) * pow(ratio, curve_factor);
        
        // 添加细微的波动，确保相邻战力值有区别
        // 使用战力值的个位、十位和百位数作为波动因子
        fine_adjust = 1.0 + (power % 10) * 0.002 * precision;
        fine_adjust += (power % 100) / 100.0 * 0.01 * precision;
        fine_adjust += (power % 1000) / 1000.0 * 0.02 * precision;
        
        base_skill_value *= fine_adjust;
    }
    
    // 添加精确度调整，确保相邻战力值有区别
    // 使用战力值的个位数和十位数作为微调因子
    precision_adjust = 1.0 + (power % 10) * 0.005 * precision;
    precision_adjust += ((power / 10) % 10) * 0.002 * precision;
    
    // 添加周期性调整，使用多个不同频率的正弦波叠加，确保更复杂的变化模式
    cycle_adjust = 1.0;
    cycle_adjust += sin((power % 100) / 100.0 * 3.14159) * 0.01 * precision;
    cycle_adjust += sin((power % 1000) / 1000.0 * 6.28318) * 0.015 * precision;
    cycle_adjust += cos((power % 500) / 500.0 * 3.14159) * 0.005 * precision;
    
    result["skill"] = to_int(base_skill_value * skill_factor * precision_adjust * cycle_adjust);
    
    // 确保所有属性值至少为1
    foreach (string attr in keys(result))
    {
        if (result[attr] < 1 && attr != "_power_hash")
            result[attr] = 1;
    }
    
    // 添加战力唯一性标记，确保每个战力值都有唯一的属性组合
    result["_power_hash"] = power;
    
    return result;
}

/**
 * @brief 设置战斗力配置参数
 * @param string param 参数名称
 * @param mixed value 参数值
 * @return int 1表示成功，0表示失败
 */
int set_power_config(string param, mixed value)
{
    if (!param || !stringp(param) || !value)
        return 0;
        
    if (member_array(param, keys(power_config)) == -1)
        return 0;
        
    power_config[param] = value;
    return 1;
}

/**
 * @brief 获取战斗力配置参数
 * @param string param 参数名称，如果为0则返回所有配置
 * @return mixed 参数值或所有配置
 */
mixed query_power_config(string param)
{
    if (!param || !stringp(param))
        return power_config;
        
    if (member_array(param, keys(power_config)) == -1)
        return 0;
        
    return power_config[param];
}

/**
 * @brief 创建一个指定门派和战斗力的NPC
 * @param string family 门派名称 如果为0，则随机一个门派
 * @param int power 战斗力数值
 * @param mixed template_path 可选参数，NPC模板路径或一个对象
 * @param mapping dynamic_adjustment 可选参数，动态调整参数
 * @details 其他细节补充：很灵活的方式，如果存在npc提前设定了npc_combat_tps_family，则使用npc_combat_tps_family的门派
 * @return object 创建的NPC对象
 */
varargs object create_family_npc(string family, int power, mixed template_path,mapping dynamic_adjustment)
{
    object npc, weapon, cloth, special_item;
    mapping skill_map, prepare_map, power_adjust;
    string *skill_names;
    int skill_level;
    string *exert_functions, *perform_actions;
    mixed *combat_msg = ({});

    // 如果family为0，则随机一个门派
    if (!family)
    {
        family = valid_family[random(sizeof(valid_family))];
    }

    // 检查门派是否有效
    if (member_array(family, valid_family) == -1)
    {
        write("无效的门派名称：" + family + "\n");
        return 0;
    }
    
    // 计算战斗力对应的属性调整
    power_adjust = calculate_power_adjust(power);
    

    
    // 如果提供了模板路径，则加载模板NPC
    if (template_path && stringp(template_path) && file_size(template_path + ".lpc") > 0)
    {
        npc = new(template_path);
    }
    else
    //如果是对象，则只设为根对象
    if (template_path && objectp(template_path))
    {
        npc = template_path;
    }
    else
    {
        // 创建默认NPC对象
        npc = new("/adm/special_ob/npc/npc_copy");
        // 没有提供模板，使用默认设置
        NPC_D->generate_cn_name(npc);
        npc->set("long", family_desc[family] + "\n");
    }

    //一种很灵活的方式，如果存在npc_combat_tps_family，则使用npc_combat_tps_family的门派
    if (npc->query("npc_combat_tps_family"))
    {
        family = npc->query("npc_combat_tps_family");
    }

    //存储战斗力备用
    npc->set("generate_combat_power", power);
    
    // 设置基本属性
    if (!npc->query("title"))
        npc->set("title", family + "高手");

    //如果不是模板，则随机性别
    if (!template_path || !stringp(template_path))
        npc->set("gender", random(2) ? "男性" : "女性");
    npc->set("age", 20 + random(30));
    npc->set("str", 20 + random(10));
    npc->set("int", 20 + random(10));
    npc->set("con", 20 + random(10));
    npc->set("dex", 20 + random(10));
    
    // 设置战斗相关属性
    npc->set("max_qi", power_adjust["qi"]);
    npc->set("eff_qi", power_adjust["qi"]);
    npc->set("qi", power_adjust["qi"]);
    npc->set("max_jing", power_adjust["qi"] / 2);
    npc->set("eff_jing", power_adjust["qi"] / 2);
    npc->set("jing", power_adjust["qi"] / 2);
    npc->set("max_neili", power_adjust["neili"]);
    npc->set("neili", power_adjust["neili"]);
    npc->set("jiali", power_adjust["skill"] / 4);
    npc->set("combat_exp", power_adjust["exp"]);

    if (dynamic_adjustment)
    {
        if (!nullp(dynamic_adjustment["qi_times"]))
        {
            npc->set("max_qi", npc->query("max_qi") * dynamic_adjustment["qi_times"]);
            npc->set("eff_qi", npc->query("eff_qi") * dynamic_adjustment["qi_times"]);
            npc->set("qi", npc->query("qi") * dynamic_adjustment["qi_times"]);
        }

        if (!nullp(dynamic_adjustment["jing_times"]))
        {
            npc->set("max_jing", npc->query("max_jing") * dynamic_adjustment["jing_times"]);
            npc->set("eff_jing", npc->query("eff_jing") * dynamic_adjustment["jing_times"]);
            npc->set("jing", npc->query("jing") * dynamic_adjustment["jing_times"]);
        }
        
        if (!nullp(dynamic_adjustment["neili_times"]))
        {
            npc->set("max_neili", npc->query("max_neili") * dynamic_adjustment["neili_times"]);
            npc->set("neili", npc->query("neili") * dynamic_adjustment["neili_times"]); 
        }

        if (!nullp(dynamic_adjustment["npc_set"]))
        {
            npc->set("npc_set", dynamic_adjustment["npc_set"]);
        }
    }
    
    // 设置门派信息
    npc->set("family/family_name", family);
    npc->set("family/generation", 20);
    
    // 设置职业
    if (family_skills[family]["class"])
        npc->set("class", family_skills[family]["class"]);
    
    // 设置技能
    skill_level = power_adjust["skill"];
    skill_map = family_skills[family];
    skill_names = keys(skill_map) - ({ "prepare", "perform_action", "exert_function", "class", "weapon", "cloth", "special" });
    
    foreach (string skill in skill_names)
    {
        if (stringp(skill_map[skill]))
        {
            npc->set_skill(skill, skill_level);
            npc->set_skill(skill_map[skill], skill_level);
            npc->map_skill(skill, skill_map[skill]);
        }
    }
    
    // 设置准备技能
    if (mapp(skill_map["prepare"]))
    {
        prepare_map = skill_map["prepare"];
        foreach (string skill, string mapped in prepare_map)
        {
            npc->prepare_skill(skill, mapped);
        }
    }
    
    // 设置战斗消息
    if (arrayp(skill_map["exert_function"]) || arrayp(skill_map["perform_action"]))
    {
        // 构建战斗消息数组
        if (arrayp(skill_map["exert_function"]))
        {
            exert_functions = skill_map["exert_function"];
            foreach (string func in exert_functions)
            {
                combat_msg += ({ (: call_other, npc, "exert_function", func :) });
            }
        }
        
        if (arrayp(skill_map["perform_action"]))
        {
            perform_actions = skill_map["perform_action"];
            foreach (string action in perform_actions)
            {
                combat_msg += ({ (: call_other, npc, "perform_action", action :) });
            }
        }
        
        npc->set("chat_chance_combat", 80);
        npc->set("chat_msg_combat", combat_msg);
    }
    
    // 装备武器
    if (stringp(skill_map["weapon"]))
    {
        weapon = new(skill_map["weapon"]);
        if (objectp(weapon))
        {
            weapon->move(npc);
            weapon->wield();
        }
    }
    
    // 装备衣服
    if (stringp(skill_map["cloth"]))
    {
        cloth = new(skill_map["cloth"]);
        if (objectp(cloth))
        {
            cloth->move(npc);
            cloth->wear();
        }
    }
    
    // 处理特殊物品
    if (mapp(skill_map["special"]))
    {
        if (stringp(skill_map["special"]["item"]))
        {
            special_item = new(skill_map["special"]["item"]);
            if (objectp(special_item))
            {
                if (skill_map["special"]["amount"])
                    special_item->set_amount(skill_map["special"]["amount"]);
                special_item->move(npc);
                npc->set_temp("handing", special_item);
            }
        }
    }
    
    npc->setup();
    return npc;
}

/**
 * @brief 创建一个随机门派的NPC
 * @param int power 战斗力数值
 * @param string template_path 可选参数，NPC模板路径
 * @return object 创建的NPC对象
 */
object create_random_npc(int power, string template_path)
{
    string family = valid_family[random(sizeof(valid_family))];
    return create_family_npc(family, power, template_path);
}

/**
 * @brief 获取有效的门派列表
 * @return string* 门派名称数组
 */
string* query_valid_family()
{
    return valid_family;
}

/**
 * @brief 查询指定战斗力对应的属性调整值
 * @param int power 战斗力值
 * @return mapping 包含各属性调整值的映射
 */
mapping query_power_adjust(int power)
{
    return calculate_power_adjust(power);
}
