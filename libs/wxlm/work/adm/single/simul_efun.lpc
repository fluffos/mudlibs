#include "/adm/simul_efun/message.lpc"

// This is the utilitis
#include "/adm/simul_efun/util.lpc"
#include "/adm/simul_efun/nt.lpc"


string *external_system_package = ({
#ifdef __PACKAGE_HTTP__
		"/external_system_package/http/controller/httpd"
#endif
});

/**
 * @brief 载入 external_system_package 中定义的模块
 * @return void
 * @details 遍历 `external_system_package`，尝试 `load_object` 并输出加载结果；失败的模块会被收集并列出
 */
void load_external_system_packages()
{
    int i;
    string path;
    object ob;
    string *failed;

    failed = ({});

    for (i = 0; i < sizeof(external_system_package); i++)
    {
        path = external_system_package[i];
        ob = load_object(path);

        if (!ob)
        {
            failed += ({ path });
            write(sprintf("加载 external 模块失败：%s\n", path));
        }
        else
        {
            write(sprintf("已加载 external 模块：%s\n", path));
        }
    }

    if (sizeof(failed))
    {
        write("以下 external 模块加载失败，请检查路径或编译：\n");
        foreach (path in failed)
        {
            write(" - " + path + "\n");
        }
    }
}

void create()
{
    seteuid(getuid());
    write("simul_efun loaded successfully.\n");
    // 在sefun后载入
    call_out("load_external_system_packages", 1);
}
