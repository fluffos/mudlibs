/**
 * @brief 检查并预加载守护进程 (Daemons)
 * @details 读取 preload 列表并尝试加载其中定义的所有守护进程。
 *          通常在游戏启动或需要重新加载守护进程时调用。
 */
void check_daemons()
{
	string *sp;
	int i;

	sp = epilog(0); // 获取 preload 列表
	if (! sp) return;

    // 遍历列表并预加载每个文件
	for (i = 0; i < sizeof(sp); i++)
		if (stringp(sp[i])) preload(sp[i]);
}

/**
 * @brief 验证 efun::bind() 的合法性
 * @details 控制一个对象是否可以将一个函数绑定到另一个对象上。
 *          实际的验证逻辑委托给 SECURITY_D 执行。
 * @param object binder 发起绑定的对象。
 * @param object old_owner 函数当前绑定的对象。
 * @param object new_owner 尝试将函数绑定到的新对象。
 * @return int 如果允许绑定返回 1，否则返回 0。
 */
int valid_bind(object binder, object old_owner, object new_owner)
{
	object ob;

	if (ob = find_object(SECURITY_D))
		return (int)ob->valid_bind(binder, old_owner, new_owner);

	return 1; // 默认允许 (如果 SECURITY_D 不存在)
}


/**
 * @brief 验证数据库操作的合法性
 * @details 控制数据库相关 efun (如 db_connect, db_close, db_exec 等) 的使用。
 *          特别地，当 func 为 "connect" 时，应返回数据库密码。
 * @param object caller 发起数据库操作的对象。
 * @param string func 被调用的数据库函数名称。
 * @param mixed *info 相关参数数组。
 * @return mixed 如果 func 是 "connect"，返回数据库密码 (string)；
 *               对于其他合法的数据库操作，返回 1 (int)；
 *               如果操作非法，返回 0 (int)。
 */
mixed valid_database(object caller, string func, mixed *info)
{
    if (func == "connect")
        return "Asd123___"; // 返回 mysql 数据库密码
    else
        return 1; // 允许其他数据库操作
}