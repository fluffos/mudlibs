/**
 * @brief 验证写文件权限
 * @details 控制 write_file(), rm(), rmdir(), mkdir(), save_object() 等
 *          涉及文件写入或修改的操作权限。
 *          实际的验证逻辑委托给 SECURITY_D 执行。
 * @param string file 目标文件路径。
 * @param mixed user 发起调用的对象或用户标识。
 * @param string func 调用函数名称 (如 "write_file")。
 * @return int 如果允许写入返回 1，否则返回 0。
 */
int valid_write(string file, mixed user, string func)
{
	object ob;

	if (ob = find_object(SECURITY_D))
		return (int)ob->valid_write(file, user, func);

	return 0; // 默认禁止 (如果 SECURITY_D 不存在)
}

/**
 * @brief 验证读文件权限
 * @details 控制 read_file(), file_size(), get_dir(), restore_object(),
 *          file_stat() 等涉及文件读取的操作权限。
 *          实际的验证逻辑委托给 SECURITY_D 执行。
 * @param string file 目标文件路径。
 * @param mixed user 发起调用的对象或用户标识。
 * @param string func 调用函数名称 (如 "read_file")。
 * @return int 如果允许读取返回 1，否则返回 0。
 */
int valid_read(string file, mixed user, string func)
{
	object ob;

	if (ob = find_object(SECURITY_D))
		return (int)ob->valid_read(file, user, func);

	return 1; // 默认允许 (如果 SECURITY_D 不存在)
}

/**
 * @brief 获取对象的名称 (如果对象存在)
 * @details 安全地获取对象的名称，避免因对象不存在而出错。
 * @param object ob 需要获取名称的对象。
 * @return string 如果对象存在，返回其名称；否则返回 0。
 */
string object_name(object ob)
{
	if (ob) return ob->name();
    // 如果 ob 为 0，隐式返回 0
}

