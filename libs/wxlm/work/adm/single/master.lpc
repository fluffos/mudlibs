/**
 * @brief master.c - 游戏核心主控对象
 * @details 这个文件定义了 MUD 驱动程序所需的核心接口和回调函数，
 *          负责处理连接、对象编译、错误处理、权限验证等关键功能。
 * @author MUDOS (基础结构), Lu dexiang (修改与注释)
 * @date YYYY-MM-DD (最后修改日期)
 */
#pragma optimize


#include <config.h>
#include <localtime.h>

/**
 * @brief 处理新的玩家连接
 * @details 当有新玩家连接到游戏时，驱动程序会调用此函数。
 *          它负责创建并返回一个新的登录对象 (LOGIN_OB)。
 * @return object 新创建的登录对象，如果创建失败则返回 0 并销毁自身。
 */
object connect()
{
	object login_ob;
	mixed err;
   
	err = catch(login_ob = new(LOGIN_OB));

	if (err)
	{
		write("现在有人正在修改使用者连线部份的程式，请待会再来。\n");
		write(err);
		destruct(this_object());
	}
	return login_ob;
}

/**
 * @brief 编译虚拟对象
 * @details 用于加载 MUDOS 的"虚拟"对象。
 *          驱动程序在尝试加载一个不存在的物理文件时调用此函数。
 *          本函数尝试通过 VIRTUAL_D 处理虚拟路径，并特殊处理 /clone/baoshi/ 路径下的对象。
 * @param string file 驱动程序尝试加载的文件路径。
 * @return object 如果 mudlib 希望将某个对象与文件名关联，则返回该对象；否则返回 0。
 */
mixed compile_object(string file)
{
	object daemon;

	// 特殊处理宝石对象，交由 base_handle 处理
	if (strsrch(file, "/clone/baoshi/") != -1)
    {
        return call_other("/clone/baoshi/base_handle", "get_gem_obj", file);
    }

    // 尝试通过 VIRTUAL_D 处理虚拟对象
	if (daemon = find_object(VIRTUAL_D))
		return daemon->compile_object(file);
	else
		return 0;
}

/**
 * @brief 处理驱动程序崩溃
 * @details 当驱动程序遇到段错误、总线错误等严重问题时调用此函数。
 *          它会记录崩溃信息，并尝试保存所有在线玩家的数据（如果开启了 INSTALL_CRASH_SAVE）。
 * @param string error 驱动程序报告的错误信息。
 * @param object command_giver 引发崩溃时正在执行命令的玩家对象 (可能为 0)。
 * @param object current_object 引发崩溃时正在执行代码的对象 (可能为 0)。
 * @note 此函数是 protected，只能被驱动程序或 master 对象自身调用。
 */
protected void crash(string error, object command_giver, object current_object)
{
#if INSTALL_CRASH_SAVE
	object ob;
	string dump_dir;
	string user;
	string flogin, fuser;
	mixed lt;
#endif

	efun::shout("系统核心发出一声惨叫：哇—哩—咧—\n");
	efun::shout("系统核心告诉你：要当机了，自己保重吧！\n");
	log_file("nosave/CRASHES", MUD_NAME + " crashed on: " + ctime(time()) +
		 ", error: " + error + "\n");
	if (command_giver)
		log_file("nosave/CRASHES",
			 sprintf( "this_player: %O\n", command_giver));
	if (current_object)
		log_file("nosave/CRASHES",
			 sprintf( "this_object: %O\n", current_object));

#if INSTALL_CRASH_SAVE
    // 获取当前时间并构造备份目录路径
	lt = localtime(time());
	lt[LT_MON]++;
	dump_dir = sprintf(DUMP_DIR "%d-%d-%d/", lt[LT_YEAR], lt[LT_MON], lt[LT_MDAY]);

    // 遍历所有在线玩家
	foreach (ob in users())
	{
		reset_eval_cost();

		// 获取玩家 ID
		user = geteuid(ob);
		if (! stringp(user))
			continue;

        // 构造玩家数据文件路径
		flogin = "login/" + user[0..0] + "/" + user + __SAVE_EXTENSION__;
		fuser  = "user/"  + user[0..0] + "/" + user + __SAVE_EXTENSION__;

        // 如果玩家数据文件存在，则备份到 dump 目录
		if (file_size(DATA_DIR + flogin) > 0 &&
		    file_size(DATA_DIR + fuser) > 0)
		{
			assure_file(dump_dir + flogin); // 确保备份目录存在
			assure_file(dump_dir + fuser);
			cp(DATA_DIR + flogin, dump_dir + flogin);
			cp(DATA_DIR + fuser,  dump_dir + fuser);
			log_file("nosave/dump",
				 sprintf("backup user(%s) to dump\n", user));
		}
        // 尝试保存玩家当前状态
		ob->save();
	}
#endif
}

/**
 * @brief 读取并更新配置文件列表
 * @details 读取指定的列表文件，忽略以 '#' 开头的行和空行。
 *          通常用于读取 preload 或 domains 等配置文件。
 * @param string file 要读取的文件路径。
 * @return string* 包含文件中有效行的字符串数组。
 * @note 此函数必须声明为 protected 以防止安全漏洞。
 */
protected string *update_file(string file)
{
	string *list;
	string str;
	int i;

	str = read_file(file);
	if (!str)
		return ({});

	list = explode(str, "\n");
	for (i = 0; i < sizeof(list); i++)
		if (list[i][0] == '#') // 忽略注释行
			list[i] = 0;

	list -= ({ 0 }); // 移除空元素
	return list;
}

/**
 * @brief MUD 启动时最后调用的函数
 * @details 驱动程序在加载完所有基本对象后调用此函数。
 *          它负责读取 preload 配置文件并返回需要预加载的对象列表。
 * @param int load_empty 驱动程序传递的标志，通常未使用。
 * @return string* 需要预加载的文件路径列表。
 */
string *epilog(int load_empty)
{
	string *items;

	items = update_file(CONFIG_DIR + "preload");
	return items;
}

/**
 * @brief 预加载指定的文件
 * @details 尝试加载一个对象到内存中，如果对象已加载或文件不存在则不执行任何操作。
 *          通常由 epilog 返回的列表驱动调用。
 * @param string file 需要预加载的文件路径 (不含 .c 后缀)。
 */
void preload(string file)
{
	if (objectp(find_object(file))) // 对象已加载
		return;

	if (file_size(file + ".lpc") == -1) // 源文件不存在
		return;

	catch(load_object(file)); // 尝试加载，忽略错误
}


/**
 * @brief 记录编译时错误或警告信息
 * @details 驱动程序在编译 LPC 代码时遇到错误或警告时调用此函数。
 *          将错误信息写入 log_error 文件，警告信息写入 log 文件。
 *          同时会调用 LINT_D 记录编译错误，并可能通知当前玩家。
 * @param string file 发生错误的文件路径。
 * @param string message 错误或警告的具体信息。
 */
void log_error(string file, string message)
{
    if (strsrch(message, "Warning") == -1) // 判断是错误还是警告
    {
        // 记录错误日志
        efun::write_file(LOG_DIR + "log_error", "-------------------------------------------------------------------\n" + message);

        // 如果是玩家触发的编译，则通知玩家
		if (this_player(1))
		{
			efun::write("-------------------------------------------------------------------\n" + "编译时段错误：" + replace_string(message, "\"", "“")+"\n");
		}

        // 调用 LINT_D 记录错误
		call_other(LINT_D, "set_err", file, replace_string(message, "\"", "“"));

    }
    else
    {
        // 记录警告日志 (如果需要)
        // efun::write_file(LOG_DIR + "log", message);
        // call_other(LINT_D, "set_err", file, replace_string(message, "\"", "“"));
    }
}


/**
 * @brief 保存玩家的 ed 编辑器设置
 * @details ed 编辑器调用此函数来保存指定玩家的个性化设置。
 *          设置保存在玩家家目录下的 .edrc 文件中。
 * @param object who 需要保存设置的玩家对象。
 * @param int code 代表编辑器设置的整数代码。
 * @return int 如果保存成功返回 1，否则返回 0。
 */
int save_ed_setup(object who, int code)
{
	string file;
  
	if (! intp(code))
		return 0;

	file = user_path(getuid(who)) + ".edrc";
	rm(file); // 先删除旧文件
	return write_file(file, code + "");
}

/**
 * @brief 读取玩家的 ed 编辑器设置
 * @details ed 编辑器调用此函数来读取指定玩家的个性化设置。
 * @param object who 需要读取设置的玩家对象。
 * @return int 返回代表编辑器设置的整数代码，如果文件不存在或读取失败则返回 0。
 */
int retrieve_ed_setup(object who)
{
	string file;
	    int code;
  
	file = user_path(getuid(who)) + ".edrc";
	if (file_size(file) <= 0)
		return 0;

	sscanf(read_file(file), "%d", code);
	return code;
}

/**
 * @brief 处理对象环境被销毁的情况
 * @details 当一个对象（通常是房间）被销毁时，驱动程序会对该环境中
 *          的每一个对象调用此函数。主要用于处理玩家所在环境消失的情况，
 *          将玩家移动到安全地点 (VOID_OB)。
 * @param object ob 环境中存在的对象。
 */
void destruct_env_of(object ob)
{
	if (! userp(ob)) return; // 只处理玩家对象
	tell_object(ob, "你所存在的空间被毁灭了。\n");
	ob->move(VOID_OB);
}

/**
 * @brief 将相对路径转换为绝对路径 (用于 ed)
 * @details ed 编辑器调用此函数来解析文件路径。
 *          它会根据玩家当前的 CWD (当前工作目录) 来解析相对路径。
 * @param string file 需要解析的文件路径 (可能为相对路径)。
 * @return string 解析后的绝对路径。
 */
string make_path_absolute(string file)
{
	file = resolve_path((string)this_player()->query("cwd"), file);
	return file;
}

/**
 * @brief 获取 ed 编辑器中断时的自动保存文件名
 * @details 当玩家在 ed 编辑器中断开连接时，驱动程序调用此函数
 *          来决定自动保存的文件名，以避免覆盖原始文件。
 * @param string fname 原始文件名。
 * @return string 附加了时间戳的自动保存文件名。
 */
string get_save_file_name(string fname)
{
	return fname + "." + time();
}

