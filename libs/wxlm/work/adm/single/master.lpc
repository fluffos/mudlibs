/**
 * @brief 生成标准格式的运行时错误追踪信息 (JSON 格式)
 * @details 将驱动程序提供的错误信息映射表格式化为易于阅读和分析的 JSON 字符串。
 *          包含了错误类型、信息、位置、对象、玩家信息、调用堆栈等。
 * @param mapping error 驱动程序传递的错误信息映射表。
 * @param int caught 标记错误是否被 catch 语句捕获 (1 表示是，0 表示否)。
 * @param int count 此错误发生的次数 (由 error_handler 传入)。
 * @return string 格式化后的 JSON 错误追踪信息字符串。
 */
string standard_trace(mapping error, int caught, int count)
{
        int i, s;
        string res, prog;
        object me;
        mixed *cmds;
		mapping error_info;

		error_info = ([
			"错误类型": "执行时段错误",
			"错误信息": error["error"],
			"程序": error["program"],
			"行号": error["line"],
			"物件": error["object"] ? file_name(error["object"]) : "未知物件",
			"拦截": caught ? "是" : "否",
            "触发次数": count // 添加触发次数信息
		]);
        // 如果错误发生在玩家身上,记录玩家相关信息
        if (!error["object"] && (me = this_player())) {

				error_info["玩家"] = sprintf("%s(%s) - %O  所在环境：%O\n",
								me->name(1), me->query("id"), me, environment(me));
                
                // 记录玩家可用指令
                cmds = me->query_commands();
                if (sizeof(cmds)) {
						error_info["指令"] = ({

						});

						for (i = 0; i < sizeof(cmds); i++) {
							error_info["指令"] += ({
								sprintf("%-15s  %2d %O\n",
										cmds[i][0], cmds[i][1], cmds[i][2])
							});
						}
                }

                // 记录最后执行的指令
				error_info["最后执行的指令"] = me->query_last_input();
        }

        // 处理错误追踪信息
        s = sizeof(error["trace"]);
        i = 0;
        
        // 过滤聊天和消息相关的错误追踪 (避免刷屏)
        if (!this_player(1) && this_player()) {
                for (; i < s; i++) {
                        prog = "/" + error["trace"][i]["program"];
                        if (!sscanf(prog, "/cmds/chat/%*s") &&
                            prog != "/clone/user/chatter.lpc" &&
                            prog != F_COMMAND)
                                break;
                }

				error_info["消息相关追踪"] = prog;
        }


		error_info["追踪"] = ({});
        // 记录调用堆栈
        for (; i < s; i++) {

				mapping trace_err;

				trace_err = ([
					"呼叫程序": error["trace"][i]["program"],
					"呼叫函数": error["trace"][i]["function"],
					"呼叫行号": error["trace"][i]["line"],
				]);

				if (error["trace"][i]["object"]) {
					trace_err["呼叫物件"] = file_name(error["trace"][i]["object"]);
				}

				// 蓝图对象还是复制对象
				if (error["trace"][i]["object"] && clonep(error["trace"][i]["object"])) {
					trace_err["对象类型"] = "复制对象";
				} else {
					trace_err["对象类型"] = "蓝图对象";
				}

				error_info["追踪"] += ({ trace_err });
        }

		res = json_encode(error_info);
		res = json_format(res);
		res += "\n";
		res = "-------------------------------------------------------------------\n" + res;
        return res;
}

/**
 * @brief MUDLib 的运行时错误处理器
 * @details 当游戏运行时发生 LPC 错误时，驱动程序会调用此函数。
 *          它负责缓存错误、记录日志、通知玩家和巫师，并与 LINT_D 交互。
 *          对于首次出现的错误，会记录详细信息并通知 LINT_D；对于重复错误，
 *          仅增加计数并在 debug 频道提示。
 * @param mapping error 驱动程序传递的错误信息映射表。
 * @param int caught 标记错误是否被 catch 语句捕获 (1 表示是，0 表示否)。
 * @return string 返回格式化的错误追踪信息 (对于首次错误) 或重复错误标识。
 */
string error_handler(mapping error, int caught)
{
    object lint_d;

    lint_d = find_object(LINT_D);
    if (lint_d)
    {
        // 将错误处理委托给 LINT_D
        return lint_d->handle_runtime_error(error, caught);
    }
    else
    {
        // LINT_D 未加载时的备用处理
        string fallback_trace = standard_trace(error, caught, 1); // 假设次数为 1
        string log_msg = "LINT_D not found! Fallback log:\n" + fallback_trace;
        
        // 尝试写入日志
        efun::write_file(LOG_DIR + "debug.log", log_msg);
        
        // 尝试通知玩家
        if (this_player(1)) 
        {
            tell_object(this_player(1), "LINT_D 未加载，错误处理可能不完整。\n" + replace_string(fallback_trace, "\"", "“"));
        }
        else if (this_player())
        {
             if(wizardp(this_player())) 
                tell_object(this_player(), "LINT_D 未加载，错误处理可能不完整。\n" + replace_string(fallback_trace, "\"", "“"));
        }
        
        return fallback_trace;
    }
}

/**
 * @brief 验证一个对象是否可以 shadow 另一个对象
 * @details 控制 shadow() efun 的使用权限。
 *          只有 ROOT_UID 或位于 /shadow/ 目录下的对象可以 shadow 其他对象。
 * @param object ob 被尝试 shadow 的对象。
 * @return int 如果允许 shadow 返回 1，否则返回 0。
 */
int valid_shadow(object ob)
{
	object pre;

	pre = previous_object(); // 获取调用 shadow() 的对象
	if (geteuid(pre) == ROOT_UID ||
	    sscanf(file_name(pre), "/shadow/%*s"))
	{
		return 1; // 允许
	}

    // 记录非法 shadow 尝试
	log_file("shadow", sprintf("%O try to shadow %O failed.\n", pre, ob));
	return 0; // 不允许
}

/**
 * @brief 验证 simul_efun 是否可以被 efun:: 前缀覆盖
 * @details 此函数在对象编译时被驱动程序调用，控制哪些 simul_efun
 *          可以被同名的 efun 覆盖 (通过 `efun::name()` 调用原始 efun)。
 * @param string file 尝试覆盖 simul_efun 的文件路径。
 * @param string name 被尝试覆盖的 simul_efun 名称。
 * @return int 如果允许覆盖返回 1，否则返回 0。
 * @note 特殊规则：
 *         - SIMUL_EFUN_OB 或 MASTER_OB 可以覆盖任何 simul_efun。
 *         - move_object 只能由 F_MOVE 或 F_COMMAND 定义。
 *         - destruct 只能由 /adm/simul_efun/ 下的文件定义。
 */
int valid_override( string file, string name )
{
	// simul_efun 或 master 自身总是有权限覆盖
	if (file == SIMUL_EFUN_OB || file == MASTER_OB)
		return 1;

	// 强制使用 F_MOVE 或 F_COMMAND 中的 move_object
	if ((name == "move_object") && file != F_MOVE && file != F_COMMAND)
		return 0;

    // 限制 destruct 的重载
	if ((name == "destruct") && ! sscanf(file, "/adm/simul_efun/%s", file))
		return 0;

	// 其他 simul_efun 默认允许覆盖 (可根据需要添加更多保护)
	return 1;
}

/**
 * @brief 验证一个对象是否可以设置其 euid
 * @details 控制 seteuid() efun 的使用权限。
 *          实际的验证逻辑委托给 SECURITY_D 执行。
 * @param object ob 尝试设置 euid 的对象。
 * @param string str 尝试设置的目标 euid。
 * @return int 如果允许设置返回 1，否则返回 0。
 */
int valid_seteuid(object ob, string str)
{
	if (find_object(SECURITY_D))
		return (int)SECURITY_D->valid_seteuid( ob, str );
	return 1; // 默认允许 (如果 SECURITY_D 不存在)
}

