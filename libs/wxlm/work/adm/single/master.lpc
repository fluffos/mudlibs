/**
 * @brief 验证一个文件是否允许被编译
 * @details 控制 load_object() 或 clone_object() 是否可以编译指定文件。
 * @param string file 尝试编译的文件路径。
 * @return int 如果文件有效且允许编译返回 1，否则返回 0。
 * @note 使用 file_valid() 检查文件路径的有效性。
 */
int valid_compile(string file)
{
	return file_valid(file) == 1;
}

/**
 * @brief 验证是否允许使用 set_hide() efun
 * @details 控制隐藏对象或查看隐藏对象的能力。
 * @param object who 调用 set_hide() 的对象。
 * @return int 如果允许使用返回 1，否则返回 0。
 * @note 当前实现允许所有对象使用。
 */
int valid_hide(object who)
{
	return 1;
}

/**
 * @brief 验证一个由驱动程序加载的对象是否应该存在
 * @details 控制哪些对象可以在加载后继续存在。
 *          主要用于确保 clone出来的对象必须继承 F_MOVE。
 * @param object ob 被加载的对象。
 * @return int 如果对象有效允许存在返回 1，否则返回 0。
 */
int valid_object(object ob)
{
    // 蓝图对象总是有效的
    // clone 对象必须继承 F_MOVE (具备移动能力)
	return (! clonep(ob)) || inherits(F_MOVE, ob);
}

