inherit NPC;

string ask_xinwu();
string ask_newgift1();
string ask_newgift3();
string ask_kaifu_gift();
string ask_yuanxiao_gift();
string ask_guoqing_gift();
string ask_zhongqiu_gift();
void create()
{
	set_name(HIR"江湖大使"NOR, ({ "diyu shizhe", "shizhe" }));
	set("nickname", HBCYN"武林使者"NOR);
	set("long", "这是一位武侠黎明官方派遣的使者，负责处理武侠黎明玩家的事情。\n");
	set("gender", "男性");
	set("age", 30);
	set("per", 24);
	set("str", 40);
	set("int", 40);
	set("con", 40);
	set("dex", 40);
	set("qi",5000);
	set("jingli",6000);
	set("max_qi", 8000);
	set("max_jing", 5000);
	set("eff_jingli", 6000);
	set("jiali", 190);
	set("combat_exp", 9000000);
	set("shen", 25000);

	set("chat_chance_combat", 60);
	set("chat_msg_combat", ({
		(: exert_function, "taiji" :),
		(: perform_action, "sword.chan" :),
		(: perform_action, "cuff.zhen" :),
		(: perform_action, "cuff.zhan" :),
		(: perform_action, "cuff.ji" :)
	}));

	set("inquiry", ([
		"新手大礼包" : (: ask_newgift1 :),
		"瑾墨青花" : (: ask_xinwu :),
		"开服礼包" : (: ask_kaifu_gift :),
		// "端午礼包" : (: ask_yuanxiao_gift :),
		"纪念胜利礼包" : (: ask_newgift3 :),
		// "春节活动礼包" : (: ask_chunjie_gift :),
		"国庆礼包" : (: ask_guoqing_gift :),
		"中秋礼包" : (: ask_zhongqiu_gift :),
	]));
	setup();
}

string ask_yuanxiao_gift()
{
	object ob = this_player();

	if (ob->query("game_duanwu_gift/2025-5-31"))
		return "你已经领取过端午礼包了，不能再次领取，感谢您的支持。";

	command("say 我这就发给你。");
	//666666潜能
	ob->add("potential", 666666);
	tell_object(ob,HIM"你获得了666666点潜能。"NOR"\n");
	//166绑定元宝
	ob->add("bind_yuanbao", 888);
	tell_object(ob,HIM"你获得了888绑定元宝。"NOR"\n");

	ob->set("titles/端午安康",1);
	tell_object(ob,HIM"你获得了端午安康称号。"NOR"\n");

	//设定领取状态
	ob->set("game_duanwu_gift/2025-5-31", 1);

	return "祝你游戏愉快！";
}

string ask_newgift3()
{
	object ob = this_player();
	object obj;
 
	if (ob->query("game_bc/2025-9-3"))
		return ("你已经领取过2025-9-3九月礼包了，不能再次领取，感谢您的支持。");
	
	command("nod "+ob->query("id"));
	command("say 我这就发给你。");

	//增加绑定元宝666
	ob->add("bind_yuanbao", 3888);
	tell_object(ob,HIM"你获得了3888绑定元宝。"NOR"\n");

	//3张十连抽
	obj = new_bind("/clone/baiyi/tencard");
	obj->set_amount(3);
	obj->move(ob);

	//1张意境卷轴
	obj = new_bind("/clone/aoyi_book/aoyi_book");
	obj->set_amount(1);
	obj->move(ob);

	tell_object(ob,HIM"你获得了1张意境卷轴和3张十连抽卡片s。"NOR"\n");

	ob->set("game_bc/2025-9-3", 1);
	ob->delete("game_bc/2025-9-1");
	return "祝你游戏愉快！";
}

string ask_kaifu_gift()
{
	object ob = this_player();
 
	if (ob->query("game_kaifu_gift"))
		return ("你已经领取过开服礼包了，不能再次领取，感谢您的支持。");
	
	command("nod "+ob->query("id"));
	command("say 我这就发给你。");

	ob->add("potential", 88888);
	ob->add("bind_yuanbao", 500);
	tell_object(ob,HIM"你获得了88888点潜能和500绑定元宝。"NOR"\n");
	ob->set("game_kaifu_gift", 1);
	return "祝你游戏愉快！";
}

string ask_newgift1()
{
	object ob = this_player();
	object gift;
 
	//if (!wizardp(ob))
	//	return ("正式开站才可以领取。");
	if (ob->query("newbie_libao_get"))
		return ("你已经领取过新手大礼包了，不能再次领取，感谢您的支持。");
	
	command("nod "+ob->query("id"));
	command("say 我这就发给你。");

	gift = new("/clone/gift/new_gift1");

	tell_object(ob,HIM"你获得了"+gift->short()+"。"NOR"\n");  
	log_file("new_gift/lingqu", sprintf("%s：%s(%s)领取了%s。\n", 
			ctime(time()),ob->query("name"),ob->query("id"),gift->short()));
	
	ob->set("newbie_libao_get", time());
	gift->move(ob);
	return "祝你游戏愉快！";
}

string ask_xinwu()
{
	object ob;
	mapping myfam;
	object nang;

	ob = this_player();
	myfam = (mapping)ob->query("family");
	
	if (ob->query("combat_exp") < 1500000)
		return "你的修为尚浅,还不足以掌握瑾墨青花的奥妙。\n";

	if ( present("jinmo qinghua", ob))
		return "阁下身上已有瑾墨青花，何必再求？知足常乐，方为君子之道。\n";

	nang=new("/clone/weapon/yupei");
	nang->set("owner_id", ob->query("id"));
	nang->move(ob);
	ob->set("yupei/qinghua", 1);
	write("你得到了一块"+nang->name(1)+"\n");
	return "这件东西我就送给你了，如果掉了还可以找我领取。";
}

/**
 * @brief 国庆礼包领取
 * @return string 提示信息
 * @details 包含意境卷轴x1，绑定元宝2888,黄色真意自选宝箱x1，冲脉丹自选宝箱x5
 */
string ask_guoqing_gift()
{
	object ob, obj;
	int i;

	ob = this_player();

	// 检查活动时间
	if (time() < 1759248000 || time() > 1759852800)
		return "国庆活动尚未开始或已结束。";

	if (ob->query("game_guoqing_gift/2025"))
		return "你已经领取过国庆礼包了，不能再次领取，感谢您的支持。";

	// 检查背包空间
	if (sizeof(all_inventory(ob)) >= 380)
		return "你的背包空间不足，请整理后再来领取。";

	command("say 我这就发给你国庆礼包。");

	// 绑定元宝2888
	ob->add("bind_yuanbao", 2888);
	tell_object(ob, HIM "你获得了2888绑定元宝。" NOR "\n");

	// 意境卷轴x1
	obj = new_bind("/clone/aoyi_book/aoyi_book");
	obj->move(ob);
	tell_object(ob, HIM "你获得了意境卷轴x1。" NOR "\n");

	// 黄色真意自选宝箱x1
	obj = new_bind("/clone/box/zhenyi/yellow_zixuan_box");
	obj->move(ob);
	tell_object(ob, HIM "你获得了黄色真意自选宝箱x1。" NOR "\n");

	// 冲脉丹自选宝箱x5
	for (i = 0; i < 5; i++)
	{
		obj = new_bind("/clone/box/chongmai/chongmai_zixuan_box");
		obj->move(ob);
	}
	tell_object(ob, HIM "你获得了冲脉丹自选宝箱x5。" NOR "\n");

	// 设定领取状态
	ob->set("game_guoqing_gift/2025", 1);

	return "祝你国庆快乐，游戏愉快！";
}

/**
 * @brief 中秋礼包领取
 * @return string 提示信息
 * @details 包含意境卷轴x1，绑定元宝1888,神奇葡萄x50,五脏材料自选宝箱x2
 */
string ask_zhongqiu_gift()
{
	object ob, obj;
	int i;

	ob = this_player();

	// 检查活动时间
	if (time() < 1759248000 || time() > 1759852800)
		return "国庆活动尚未开始或已结束。";

	if (ob->query("game_zhongqiu_gift/2025"))
		return "你已经领取过中秋礼包了，不能再次领取，感谢您的支持。";

	// 检查背包空间
	if (sizeof(all_inventory(ob)) >= 380)
		return "你的背包空间不足，请整理后再来领取。";

	command("say 我这就发给你中秋礼包。");

	// 绑定元宝1888
	ob->add("bind_yuanbao", 1888);
	tell_object(ob, HIM "你获得了1888绑定元宝。" NOR "\n");

	// 意境卷轴x1
	obj = new_bind("/clone/aoyi_book/aoyi_book");
	obj->move(ob);
	tell_object(ob, HIM "你获得了意境卷轴x1。" NOR "\n");

	// 神奇葡萄x50
	obj = new_bind("/clone/vip/putao1");
	obj->set_amount(50);
	obj->move(ob);
	tell_object(ob, HIM "你获得了神奇葡萄x50。" NOR "\n");

	// 五脏材料自选宝箱x2
	for (i = 0; i < 2; i++)
	{
		obj = new_bind("/clone/box/wuzang/wuzang_zixuan_box");
		obj->move(ob);
	}
	tell_object(ob, HIM "你获得了五脏材料自选宝箱x2。" NOR "\n");

	// 设定领取状态
	ob->set("game_zhongqiu_gift/2025", 1);

	return "祝你中秋快乐，游戏愉快！";
}

void init()
{
	::init();//继承上一级
}
