/**
 * @brief 计算三次方根(用于技能上限计算)
 * @param int x 输入值
 * @return int 三次方根值
 */
int sqrt3(int x)
{
        float y = 1.0 / 3.0;
        x = to_int(pow(to_float(x), y));
        return x;
}

/**
 * @brief 从列表中随机返回一个元素
 * @param mixed list 输入列表
 * @return mixed 随机选中的元素
 */
mixed random_element(mixed list)
{
    return list[random(sizeof(list))];
}