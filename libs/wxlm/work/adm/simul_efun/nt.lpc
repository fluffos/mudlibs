 * @return mixed 被删除的属性值
 * @details 如果未指定对象，则删除调用者的属性
 */
varargs mixed delete(string prop, object ob)
{
    if (!objectp(ob))
    {
        ob = previous_object();
    }

    return ob->delete(prop);
}

