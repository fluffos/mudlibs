/**
 * @brief 查询对象的属性值
 * @param string prop 属性名
 * @param object ob 目标对象，默认为previous_object()
 * @return mixed 属性值
 * @details 如果未指定对象，则查询调用者的属性
 */
varargs mixed query(string prop, object ob)
{
    // debug_message("ob = " + ob);
    if (!objectp(ob))
    {
        ob = previous_object();
    }
    // debug_message("ob = " + ob);
    // debug_message("prop = " + prop);

    return ob->query(prop);
}

/**
 * @brief 删除对象的属性
