#define SUCCESS 0
#define FAIL 1

/**
 * @brief 比较两个映射是否相等
 * @param mapping m1 第一个映射
 * @param mapping m2 第二个映射
 * @return int 1表示相等，0表示不相等
 * @details 递归比较两个映射的所有键值对，支持嵌套的映射和数组
 */
int mapping_eqv(mapping m1, mapping m2);

