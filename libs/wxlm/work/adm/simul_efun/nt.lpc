#ifndef __PACKAGE_TRIM__
/**
 * @brief 删除字符串首尾的空格
 * @param string str 要处理的字符串
 * @return string 删除首尾空格后的字符串
 * @details 去除字符串开头和结尾的所有空格字符
 */
string trim(string str)
{
    int i, j;
    int len = strlen(str);

    for (i = 0; i < len; ++i)
        if (str[i] != ' ')
            break;

    for (j = 1; j <= len; ++j)
        if (str[ < j] != ' ')
            break;

    return str[i..< j];
}
#endif
