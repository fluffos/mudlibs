/**
 * @brief 递归删除目录树的内部函数
 * @param string dir 要删除的目录路径
 * @return mixed 包含成功和失败文件列表的数组，res[0]为成功列表，res[1]为失败列表
 * @details 仅供root权限对象调用，递归删除目录及其所有内容
 */
mixed f_rmtree(string dir)
{
    mixed *res;
    string *files;

    if (!previous_object())
        return 0;

    if (!is_root(previous_object()))
        return 0;

    res = allocate(2);
    res[0] = allocate(0);
    res[1] = allocate(0);

    if (dir[ < 1] != '/')
        dir += "/";

    if (file_size(dir) != -2)
        return 0;

    if (sizeof(files = get_dir(dir)) < 1)
        return 0;

    foreach (string file in files)
    {
        if (file_size(dir + file) == -2)
            f_rmtree(dir + file);
        else if (rm(dir + file))
            res[SUCCESS] += ({dir + file});
        else
            res[FAIL] += ({dir + file});
    }

    if (rmdir(dir))
        res[SUCCESS] += ({dir});
    else
        res[FAIL] += ({dir});

    return res;
}

/**
 * @brief 删除目录树
 * @param string dir 要删除的目录路径
 * @return mixed 包含成功和失败文件列表的数组，res[0]为成功列表，res[1]为失败列表
 * @details 仅供root权限对象调用，删除指定目录及其所有内容
 */
mixed rmtree(string dir)
{
    mixed *res;

    if (!previous_object())
        return 0;

    if (!is_root(previous_object()))
        return 0;

    res = allocate(2);
    res[0] = allocate(0);
    res[1] = allocate(0);

    res = f_rmtree(dir);

    return res;
}

/**
 * @brief 递归复制目录树的内部函数
 * @param string dir 源目录路径
 * @param string dst 目标目录路径
 * @return mixed 包含成功和失败文件列表的数组，res[0]为成功列表，res[1]为失败列表
 * @details 仅供root权限对象调用，递归复制目录及其所有内容
 */
mixed f_cptree(string dir, string dst)
{
    mixed *res;
    string *files;

    if (!previous_object())
        return 0;

    if (!is_root(previous_object()))
        return 0;

    res = allocate(2);
    res[0] = allocate(0);
    res[1] = allocate(0);

    if (dir[ < 1] != '/')
        dir += "/";

    if (file_size(dir) != -2)
        return 0;

    if (file_size(dst) != -2)
    {
        if (mkdir(dst))
            res[SUCCESS] += ({dst});
        else
            res[FAIL] += ({dst});
    }

    if (sizeof(files = get_dir(dir)) < 1)
        return 0;

    foreach (string file in files)
    {
        if (file_size(dir + file) == -2)
            f_cptree(dir + file, dst + file);
        else if (cp(dir + file, dst + file))
            res[SUCCESS] += ({dst + file});
        else
            res[FAIL] += ({dst + file});
    }

    return res;
}

/**
 * @brief 复制目录树
 * @param string dir 源目录路径
 * @param string dst 目标目录路径
 * @return mixed 包含成功和失败文件列表的数组，res[0]为成功列表，res[1]为失败列表
 * @details 仅供root权限对象调用，复制指定目录及其所有内容到目标位置
 */
mixed cptree(string dir, string dst)
{
    mixed *res;

    if (!previous_object())
        return 0;

    if (!is_root(previous_object()))
        return 0;

    res = allocate(2);
    res[0] = allocate(0);
    res[1] = allocate(0);

    // 2b14中可用下面的方式
    // string *res = allocate(2, allocate(0));

    res = f_cptree(dir, dst);

    return res;
}

/**
 * @brief 生成指定范围内的随机数
 * @param int i 范围的第一个边界值
 * @param int j 范围的第二个边界值
 * @return int 返回[min(i,j), max(i,j)]范围内的随机整数
 * @details 自动处理i和j的大小关系，保证返回值在两者之间
 */
int range_random(int i, int j)
{
    return random(i < j ? j - i + 1 : i - j + 1) + ((i < j) ? i : j);
}

/**
 * @brief 为路径添加斜杠
 * @param string path 路径字符串
 * @return void 无返回值
 * @details 如果路径末尾不是'/'，则添加'/'
 */
void add_slash(string path)
{
    if (path[ < 1] != '/')
        path += "/";
}

/**
 * @brief 递归获取目录下所有文件的完整路径列表
 * @param string dir 目录路径
 * @return string* 包含所有文件完整路径的数组
 * @details 递归遍历目录，返回所有文件（不包括目录）的完整路径
 */
string *deep_path_list(string dir)
{
    int i;
    string *flist, *result = ({});
    string file;

    flist = get_dir(dir);

    for (i = 0; i < sizeof(flist); i++)
    {
        file = dir + flist[i];

        if (file_size(file + "/") == -2)
            result += deep_path_list(file + "/");
        else
            result += ({file});
    }

    return result;
}

/**
 * @brief 反转数组元素顺序
 * @param string* arr 要反转的字符串数组
 * @return void 无返回值
 * @details 使最后一个元素变成第一个元素，元素位置完全对调
 */
void reverse_array(string *arr)
{
    if (!arrayp(arr) || !sizeof(arr))
        return;

    foreach (mixed element in arr)
        arr = ({element}) + arr[0.. < 2];
}
