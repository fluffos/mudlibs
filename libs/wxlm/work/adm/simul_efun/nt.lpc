}

/**
 * @brief 大数小于比较
 * @param mixed n1 第一个数
 * @param mixed n2 第二个数
 * @return int 如果n1<n2返回1，否则返回0
 * @details 调用count函数执行大数小于比较
 */
int count_lt(mixed n1, mixed n2)
{
    return efun::count(n1, "<", n2);
}

/**
 * @brief 大数大于比较
 * @param mixed n1 第一个数
 * @param mixed n2 第二个数
 * @return int 如果n1>n2返回1，否则返回0
 * @details 调用count函数执行大数大于比较
 */
int count_gt(mixed n1, mixed n2)
{
    return efun::count(n1, ">", n2);
}

/**
 * @brief 大数小于等于比较
 * @param mixed n1 第一个数
 * @param mixed n2 第二个数
 * @return int 如果n1<=n2返回1，否则返回0
 * @details 调用count函数执行大数小于等于比较
 */
int count_le(mixed n1, mixed n2)
{
    return efun::count(n1, "<=", n2);
}

/**
 * @brief 大数大于等于比较
 * @param mixed n1 第一个数
 * @param mixed n2 第二个数
 * @return int 如果n1>=n2返回1，否则返回0
 * @details 调用count函数执行大数大于等于比较
 */
int count_ge(mixed n1, mixed n2)
{
    return efun::count(n1, ">=", n2);
}

/**
 * @brief 大数相等比较
 * @param mixed n1 第一个数
 * @param mixed n2 第二个数
 * @return int 如果n1==n2返回1，否则返回0
 * @details 调用count函数执行大数相等比较
 */
int count_eq(mixed n1, mixed n2)
{
    return efun::count(n1, "==", n2);
}

/**
 * @brief 大数次方运算
 * @param mixed number 底数
 * @param mixed exponent 指数
 * @return string 幂运算结果
 * @details 计算number的exponent次方，指数必须大于等于0
 */
string big_number_pow(mixed number, mixed exponent)
{
    mixed result = number;

    if (count(exponent, "<", 0))
        error("exponent must be > 0.");

    if (count(exponent, "==", 0))
        return "1";

    while (count(exponent = count(exponent, "-", 1), ">", 0))
        result = count(result, "*", number);

    return result;
}

