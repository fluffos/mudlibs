/**
 * @file path.c
 * @author Lu dexiang
 * @brief 路径处理相关的模拟外部函数
 */

/**
 * @brief 获取用户的当前工作目录
 * @param string name 用户名
 * @return string 用户的工作目录路径
 */
string user_cwd(string name)
{
	// return ("/u/" + name[0..0] + "/" + name);
	return ("/u/" + name);
}

/**
 * @brief 获取用户的主目录路径
 * @param string name 用户名
 * @return string 用户的主目录路径（以/结尾）
 */
string user_path(string name)
{
	return (user_cwd(name) + "/");
}

/**
 * @brief 解析相对路径为绝对路径
 * @param string curr 当前路径
 * @param string new_path 要解析的新路径
 * @return string 解析后的绝对路径
 */
string resolve_path(string curr, string new_path)
{
	int i;
	string *tmp;
	string t1;

	if (! curr) curr = "/";
	if (! new_path || new_path == ".") return curr;
	if (new_path == "here" && this_player())
		return file_name(environment(this_player())) + ".lpc";
	if (new_path == "~" || new_path == "~/" )
		new_path = user_path(getuid(this_player()));
	if (sscanf(new_path,"~/%s",t1))
		new_path = user_path(getuid(this_player())) + t1;
	else if (sscanf(new_path,"~%s",t1))
		new_path = user_path(t1); 
	else if (new_path[0] != '/') {
		if( curr[sizeof(curr)-1] != '/' ) new_path = curr + "/" + new_path;
		else new_path = curr + new_path;
	}

	tmp = explode(new_path,"/");
	for (i = 0; i < sizeof(tmp); i++)
		if (tmp[i] == "..") {
			if (sizeof(tmp) > 2) {
				tmp = tmp[0..(i-2)] + tmp[(i+1)..(sizeof(tmp)-1)];
				i -= 2;
			} else {
				tmp = tmp[2 ..(sizeof(tmp)-1)];
				i = 0;
			}
		}
	new_path = "/" + implode(tmp,"/");
	if (new_path == "//") new_path = "/";
	return new_path;
}

/**
 * @brief 列出目录内容
 * @param string arg 目录路径
 * @param mixed indx 可选参数，用于过滤结果
 * @return mixed* 目录内容列表
 */
varargs mixed *list_dirs(string arg, mixed indx)
{
	if (!indx)
		return get_dir(arg);
	else
		return get_dir(arg, indx);
}