/**
 * @file wizard.c
 * @author Lu dexiang
 * @brief 巫师权限相关的模拟外部函数
 */

/**
 * @brief 获取对象的巫师身份
 * @param mixed ob 要查询的对象或字符串
 * @return string 巫师身份标识
 */
string wizhood(mixed ob)
{
	return SECURITY_D->get_status(ob);
}

/**
 * @brief 获取对象的巫师等级
 * @param mixed ob 要查询的对象或字符串
 * @return int 巫师等级数值
 */
int wiz_level(mixed ob)
{
	return SECURITY_D->get_wiz_level(ob);
}
