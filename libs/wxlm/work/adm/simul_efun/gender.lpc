/**
 * @file gender.c
 * @author Lu dexiang
 * @brief 性别相关的代词处理模拟外部函数
 */

/**
 * @brief 获取性别对应的自称代词
 * @param string sex 性别字符串
 * @return string 对应的自称代词（"你"）
 */
string gender_self(string sex)
{
	switch(sex) {
		case "女性": return "你";	break;
		default: return "你";
	}
}

/**
 * @brief 获取性别对应的人称代词
 * @param string sex 性别字符串
 * @return string 对应的人称代词（"他"/"她"/"它"）
 */
string gender_pronoun(string sex)
{
	switch(sex) {
		case "中性神":	return "他";	break;
		case "男性":	return "他";	break;
		case "无性":    return "他";    break;
		case "女性":	return "她";	break;
		case "雄性":
		case "雌性":	return "它";	break;
		default: return "它";
	}
}

