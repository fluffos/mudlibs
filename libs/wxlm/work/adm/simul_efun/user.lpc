/**
 * @file user.c
 * @author Lu dexiang
 * @brief 用户相关的模拟外部函数
 */

/**
 * @brief 判断对象是否为终极玩家
 * @param object ob 要判断的对象
 * @return int 1:是终极玩家 0:不是终极玩家
 */
int ultrap(object ob)
{
	return ob&&ob->query("opinion/ultra");
}

/**
 * @brief 判断对象是否为宗师玩家
 * @param object ob 要判断的对象
 * @return int 1:是宗师玩家 0:不是宗师玩家
 */
int masterp(object ob)
{
	return ob&&ob->query("opinion/master");
}

/**
 * @brief 获取所有玩家对象列表
 * @return object* 玩家对象数组
 */
object *users()
{
	return filter_array(children(USER_OB), (: playerp :));
}

/**
 * @brief 获取所有在线玩家对象列表
 * @return object* 在线玩家对象数组
 */
object *all_interactive()
{
	return efun::users();
}

/**
 * @brief 根据ID过滤玩家对象
 * @param object ob 要检查的对象
 * @param string id 玩家ID
 * @return int 1:匹配 0:不匹配
 */
private int filter_player(object ob, string id)
{
	if (clonep(ob) && getuid(ob) == id)
		return 1;
}

/**
 * @brief 根据ID查找玩家对象（包括非在线玩家）
 * @param string id 玩家ID
 * @return object 找到的玩家对象，如果没找到则返回0
 */
object find_player2(string id)
{
	object found;

	if((found = find_object(id))&&(base_name(found)==USER_OB))
		return found;
	return efun::find_player(id);
}

/**
 * @brief 根据ID查找玩家对象（增强版）
 * @param mixed id 玩家ID
 * @return object 找到的玩家对象，如果没找到则返回0
 */
object find_player(mixed id)
{
	object found,*all_users;

	if (!id)
		return 0;

	if((found = find_object(id))&&(base_name(found)==USER_OB))
		return found;

	all_users = filter_array(children(USER_OB), (: $1->query("id")==$2 :), id);
	if(all_users&&sizeof(all_users))
		return all_users[0];
	else
		return 0;
}

