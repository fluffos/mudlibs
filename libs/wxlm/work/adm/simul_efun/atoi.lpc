/**
 * @file atoi.c
 * @author Lu dexiang
 * @brief 数值转换与时间处理相关的模拟外部函数
 */

/**
 * @brief 将字符串转换为整数
 * @param string str 要转换的字符串
 * @return int 转换后的整数，如果转换失败则返回0
 */
int atoi(string str)
{
	int v;

	if( !stringp(str) || !sscanf(str, "%d", v) ) return 0;
	return v;
}

/**
 * @brief 基于种子和等级的随机数生成函数
 * @param int seed 随机数种子
 * @param int lv 等级参数
 * @return int 生成的随机数
 */
int rand2(int seed,int lv)
{
	int k,m,n;

	k = to_int(pow(seed,lv));
	m = random(k);
	n = to_int(pow(k,1.0/lv)-pow(m,1.0/lv));
	return n;
}

int random(mixed n)
{
	if (!intp(n) && floatp(n))
	{
		n = to_int(n);
	}
	return efun::random(n);
}

/**
 * @brief 判断两个时间是否在同一周内
 * @param int time1 第一个时间戳
 * @param int time2 第二个时间戳
 * @return int 1:同一周 0:不同周
 */
int same_week(int time1, int time2)
{
	int last, now;
	int week;
	int year_day1;
	int year_day2;
	
	if (!time1 && !time2)
		return 1;
	else
	/*取周一时间对比是否同一周*/
	if (localtime(time1)[7] != localtime(time2)[7]) {//不是同一天
		if (time1) {
			week = localtime(time1)[6];//上次是周几？
			if (week == 0)
				week = 7;
               /*反算周一是一年中的第几天*/
			now = time1 -week *86400;
			year_day1 = localtime(now)[7];
		}
		if (time2) {
			week = localtime(time2)[6];
			if (week == 0)
				week = 7;
			last = time2 -week *86400;
			year_day2 = localtime(last)[7];
		}
          /*周一是一年中的第几天对比判断*/
		if (year_day1 == year_day2)//同一周
			return 1;
		else
			return 0;
	} else
		return 1;
}

/**
 * @brief 判断当前时间是否为指定的小时
 * @param int target_hour 目标小时数（24小时制）
 * @return int 1:当前小时匹配指定的小时 0:不匹配
 */
int is_current_hour(int target_hour)
{
	 // 获取当前时间戳
	 int current_time = time();
	 
	 // 使用localtime转换为本地时间数组
	 mixed *local_time_array = localtime(current_time);
	 
	 // 获取当前小时
	 int current_hour = local_time_array[2];
	 
	 // 检查当前小时是否匹配目标小时
	 if (current_hour == target_hour)
	 {
		 return 1; // 匹配
	 }
	 else
	 {
		 return 0; // 不匹配
	 }
}

/**
 * @brief 判断两个时间是否是同一天
 * @param int time1 第一个时间戳
 * @param int time2 第二个时间戳
 * @return int 1:同一天 0:不同天
 */
int is_same_day(int time1, int time2)
{
	mixed *local_time_array1 = localtime(time1);
	mixed *local_time_array2 = localtime(time2);
	if (local_time_array1[5] == local_time_array2[5] &&
		 local_time_array1[4] == local_time_array2[4] &&
		 local_time_array1[3] == local_time_array2[3])
	{
		return 1;
	}
	else
	{
		return 0;
	}
}

/**
 * @brief 判断当前时间是否为指定的分钟
 * @param int target_minute 目标分钟数
 * @return int 1:当前分钟匹配指定的分钟 0:不匹配
 */
int is_current_minute(int target_minute)
{
	 // 获取当前时间戳
	 int current_time = time();

	 // 使用localtime转换为本地时间数组
	 mixed *local_time_array = localtime(current_time);

	 // 获取当前分钟
	 int current_minute = local_time_array[1];

	 // 检查当前分钟是否匹配目标分钟
	 if (current_minute == target_minute)
	 {
		 return 1; // 匹配
	 }
	 else
	 {
		 return 0; // 不匹配
	 }
}
 
/**
 * @brief 刷新对象的每日次数限制
 * @param object me 要刷新的对象
 * @param string arg 要刷新的属性名
 * @return int 1:刷新成功 0:刷新失败
 */
int refresh_time(object me,string arg)
{
	int time,now;

	if (!arg ||!me)
	{
		return 0;
	}

	if (!objectp(me))
	{
		return 0;
	}

	now = time();
	time = me->query(arg + "/last_time");

	// 如果时间不是同一天，那么就刷新
	if (!is_same_day(time, now))
	{
		me->delete(arg + "/number");
		me->set(arg + "/last_time", now);
		tell_object(me, "你的次数已经刷新。\n");
		return 1;
	}

	return 0;
}

/**
 * @brief 将秒数转换为可读的时间格式字符串
 * @param int seconds 要转换的秒数
 * @param int show_numer 可选参数，显示的时间单位数量（1-6），默认为3
 * @return string 格式化后的时间字符串
 */
varargs string time_to_str(int seconds, int show_numer)
{
    int year, month, day, hour, minute, second;
    string str = "";
    
    if (!show_numer)
        show_numer = 3;
        
    if (seconds < 0)
        return "0秒";

    year = seconds / (365 * 24 * 3600);
    seconds = seconds % (365 * 24 * 3600);
    
    month = seconds / (30 * 24 * 3600); 
    seconds = seconds % (30 * 24 * 3600);
    
    day = seconds / (24 * 3600);
    seconds = seconds % (24 * 3600);
    
    hour = seconds / 3600;
    seconds = seconds % 3600;
    
    minute = seconds / 60;
    second = seconds % 60;

    if (show_numer >= 6 && year > 0)
        str += sprintf("%d年", year);
    if (show_numer >= 5 && (month > 0 || (year > 0 && show_numer >= 6)))
        str += sprintf("%d月", month);
    if (show_numer >= 4 && (day > 0 || (month > 0 && show_numer >= 5)))
        str += sprintf("%d天", day);
    if (show_numer >= 3 && (hour > 0 || (day > 0 && show_numer >= 4)))
        str += sprintf("%d小时", hour);
    if (show_numer >= 2 && (minute > 0 || (hour > 0 && show_numer >= 3)))
        str += sprintf("%d分钟", minute);
    if (show_numer >= 1 && (second > 0 || str == ""))
        str += sprintf("%d秒", second);

    return str;
}

/**
 * @brief 将指定格式的时间字符串转换为时间戳
 * @param string time_str 时间字符串，格式如："2025-01-03 09:40"
 * @return int 返回时间戳，失败返回-1
 */
int convert_to_timestamp(string time_str)
{
	 // 变量声明
	 int timestamp;
	 string format = "%Y-%m-%d %H:%M";
	 
	 // 参数检查
	 if (!stringp(time_str))
		 return -1;
		 
	 timestamp = strptime(format, time_str);
	 
	 return timestamp;
}

/**
 * @brief 获取数组或数值中的最大值
 * @param mixed arr 要处理的数组或数值
 * @param int flag 可选参数，特殊标记
 * @return mixed 返回最大值
 */
varargs mixed max(mixed arr, int flag)
{
	if (intp(arr))
	{
		return arr;
	}

	if (flag)
	{
		return efun::max(arr,flag);
	}

	return efun::max(arr);
}