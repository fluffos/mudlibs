// 百步飞剑技能文件

inherit SKILL;



// 全局变量声明
string *action_msg;

// 函数声明
mixed hit_ob(object me, object victim, int damage_bonus);

// create() 函数
void create()
{
    // 初始化 action_msg
    action_msg = ({
        HIW "$N" HIW "凝神聚气，低吟道：" HIG "「剑气纵横三万里」" HIW "，手中$w" HIW "化作" HIC "千万道" HIW "流光，" HIM "「百步飞剑」" HIW "瞬息而至，直取$n" HIW "要害！" NOR,
        HIC "$N" HIC "剑势如" HIY "惊鸿" HIC "，长啸一声：" HIG "「一剑霜寒十四州」" HIC "，$w" HIC "化作" HIR "烈焰" HIC "，" HIM "「惊鸿烈焰」" HIC "席卷$n" HIC "全身！" NOR,
        HIM "$N" HIM "身形飘忽，吟道：" HIG "「凤舞九天银河倾」" HIM "，$w" HIM "幻化出" HIW "万千剑影" HIM "，" HIY "「幻影迷踪」" HIM "令$n" HIM "难辨虚实！" NOR,
        HIR "$N" HIR "气贯长虹，朗声道：" HIG "「剑在手兮问苍天」" HIR "，$w" HIR "爆发出" HIY "璀璨星芒" HIR "，" HIC "「星河剑舞」" HIR "如银河倾泻，笼罩$n" HIR "！" NOR,
        HIY "$N" HIY "剑招变幻，低语：" HIG "「倚天长剑飞星落」" HIY "，$w" HIY "化作" HIC "游龙" HIY "，" HIW "「游龙吐珠」" HIY "剑气纵横，直逼$n" HIY "周身要害！" NOR,
        HIG "$N" HIG "轻吟剑诀：" HIG "「沧海横流剑气寒」" HIG "，$w" HIG "绽放" HIW "莹莹光华" HIG "，" HIM "「碧海潮生」" HIG "如浪涛般席卷$n" HIG "！" NOR,
        HIB "$N" HIB "剑势凌厉，吟诵：" HIG "「剑气森森冷似霜」" HIB "，$w" HIB "化作" HIW "冰霜" HIB "，" HIC "「寒冰破」" HIB "瞬间冻结空气，直刺$n" HIB "要害！" NOR,
        HIW "$N" HIW "剑招如" HIY "行云流水" HIW "，轻叹：" HIG "「仙人指路剑光寒」" HIW "，$w" HIW "化作" HIM "天外飞仙" HIW "，" HIC "「仙人指路」" HIW "指向$n" HIW "破绽！" NOR,
        HIM "$N" HIM "剑气纵横，高声吟道：" HIG "「雷霆万钧震九霄」" HIM "，$w" HIM "化作" HIR "九天雷霆" HIM "，" HIY "「雷霆万钧」" HIM "轰然劈向$n" HIM "！" NOR,
        HIC "$N" HIC "剑势绵绵不绝，低吟：" HIG "「天网恢恢疏而不漏」" HIC "，$w" HIC "化作" HIW "千丝万缕" HIC "，" HIM "「天罗地网」" HIC "将$n" HIC "重重包围！" NOR,
    });
}

// 判断技能是否可用
int valid_enable(string usage)
{
    return usage == "sword" || usage == "parry";
}

// 判断技能是否可学
int valid_learn(object me)
{
    // 变量声明
    mapping skills;
    string *skill_names;
    int sword_count = 0;
    int i;

    if (me->query("level") < 100)
    {
        tell_object(me, HIR "你的等级不足，无法领悟「百步飞剑」的奥秘。" NOR "\n");
        return 0;
    }

    skills = me->query_skills();
    if (!mapp(skills))
    {
        tell_object(me, HIR "你还没有学会任何技能，无法领悟「百步飞剑」。" NOR "\n");
        return 0;
    }

    skill_names = keys(skills);
    for (i = 0; i < sizeof(skill_names); i++)
    {
        if (SKILL_D(skill_names[i])->valid_enable("sword") && skills[skill_names[i]] >= 400)
        {
            sword_count++;
        }
    }

    if (sword_count < 6)
    {
        tell_object(me, HIR "你需要精通（400级）至少六门剑法，才能领悟「百步飞剑」的精髓。" NOR "\n");
        return 0;
    }

    return 1;
}

// 练习技能
int practice_skill(object me)
{
    // 变量声明
    object weapon;
    int cost;
    mapping skills;
    string *skill_names;
    int sword_count = 0;
    int i;

    if (!objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "sword")
    {
        tell_object(me, HIR "你需要持剑才能练习「百步飞剑」。" NOR "\n");
        return 0;
    }

    if ((int)me->query("qi") < 300)
    {
        tell_object(me, HIR "你的气血不足，无法练习「百步飞剑」。" NOR "\n");
        return 0;
    }

    cost = me->query_skill("genie_baibufeijian", 1) + 100;
    if ((int)me->query("neili") < cost)
    {
        tell_object(me, HIR "你的内力不足，无法练习「百步飞剑」。" NOR "\n");
        return 0;
    }

    skills = me->query_skills();
    skill_names = keys(skills);
    for (i = 0; i < sizeof(skill_names); i++)
    {
        if (SKILL_D(skill_names[i])->valid_enable("sword") && skills[skill_names[i]] >= 400)
        {
            sword_count++;
        }
    }

    if (sword_count < 6)
    {
        tell_object(me, HIR "你需要精通（400级）至少六门剑法，才能练习「百步飞剑」。" NOR "\n");
        return 0;
    }

    tell_object(me, HIC "你凝神静气，手中" + weapon->name() + HIC "化作千万道流光，剑气纵横天地，练习着「百步飞剑」的奥义。" NOR "\n");

    me->receive_damage("qi", 250);
    me->add("neili", -cost);

    return 1;
}

// 战斗中特效函数
mixed hit_ob(object me, object victim, int damage_bonus)
{
    // 变量声明
    int lvl;
    int extra_damage;
    string msg;

    // 变量初始化
    lvl = me->query_skill("genie_baibufeijian", 1);
    extra_damage = lvl + random(lvl);

    if (random(100) < 40)
    {
        victim->receive_wound("qi", extra_damage, me);
        msg = HIW "$N" HIW "剑势如虹，低吟" HIG "「剑气纵横三万里」" HIW "，" HIC "「百步飞剑」" HIW "瞬息而至，$n" HIW "只觉全身一阵剧痛，" HIR "鲜血飞溅" HIW "！" NOR "\n";
        return msg;
    }
    else if (random(100) < 30)
    {
        victim->start_busy(2 + random(2));
        msg = HIM "$N" HIM "轻吟" HIG "「凤舞九天银河倾」" HIM "，施展「百步飞剑」，" HIW "剑影重重" HIM "，$n" HIM "目眩神迷，一时间竟不知如何应对！" NOR "\n";
        return msg;
    }
    else if (random(100) < 20)
    {
        msg = HIY "$N" HIY "长啸" HIG "「剑在手兮问苍天」" HIY "，气贯长虹，剑锋所至，" HIR "天地失色" HIY "，$n" HIY "被其气势所摄，攻势大减！" NOR "\n";
        victim->add_temp("apply/attack", -lvl / 5);
        victim->add_temp("apply/defense", -lvl / 5);
        call_out("remove_effect", 10, victim, lvl / 5);
        return msg;
    }

    return;
}

// 移除效果
void remove_effect(object victim, int amount)
{
    if (victim)
    {
        victim->add_temp("apply/attack", amount);
        victim->add_temp("apply/defense", amount);
        tell_object(victim, HIG "你感觉周身一轻，剑气的压制终于消散了。" NOR "\n");
    }
}

// 技能的使用文件路径
string perform_action_file(string action)
{
    return __DIR__"genie_baibufeijian/" + action;
}

// 技能描述
string query_description()
{
    string msg;

    msg = HIY "【百步飞剑】" NOR "\n\n";
    msg += WHT "盖聂绝世剑技，身怀「百步飞剑」，剑气纵横，百步之内，取敌首级如探囊取物。\n";
    msg += "此剑法讲究速度与气势，剑随心动，变化莫测，令人防不胜防。\n";
    msg += "更有诗词吟诵，剑法与文采并重，尽显绝世风采。\n\n";

    msg += HIY "【学习要求】\n" NOR;
    msg += "  等级达到 100 级\n";
    msg += "  精通（400级）至少六门剑法\n\n";

    msg += HIY "【练习要求】\n" NOR;
    msg += "  气血不少于 300 点\n";
    msg += "  内力不少于 百步飞剑等级 + 100 点\n";
    msg += "  精通（400级）至少六门剑法\n\n";

    msg += HIY "【技能特点】\n" NOR;
    msg += HIC "  1. 攻击力强大，剑气纵横，威力无穷\n" NOR;
    msg += HIM "  2. 剑招变幻莫测，令敌防不胜防\n" NOR;
    msg += HIW "  3. 有几率造成额外伤害、使敌人僵直或削弱敌人\n" NOR;
    msg += HIG "  4. 剑法与诗词结合，彰显绝世风采\n" NOR;

    return msg;
}