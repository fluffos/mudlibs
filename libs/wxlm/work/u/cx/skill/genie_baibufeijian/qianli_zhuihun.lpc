
#include <combat.h>

#define QIANLI "「" HIR "千里追魂" NOR "」"

inherit F_SSERVER;

int perform(object me, object target)
{
    object weapon;
    int damage, ap, dp, attack_time, i;
    string msg;

    if (! target) target = offensive_target(me);

    if (! target || ! me->is_fighting(target))
        return notify_fail(QIANLI "只能对战斗中的对手使用。\n");

    if (! objectp(weapon = me->query_temp("weapon")) ||
        (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对，难以施展" QIANLI "。\n");

    if ((int)me->query_skill("genie_baibufeijian", 1) < 200)
        return notify_fail("你的百步飞剑不够娴熟，难以施展" QIANLI "。\n");

    if (me->query_skill_mapped("sword") != "genie_baibufeijian")
        return notify_fail("你没有激发百步飞剑，难以施展" QIANLI "。\n");

    if ((int)me->query("neili") < 300)
        return notify_fail("你现在的真气不足，难以施展" QIANLI "。\n");

    if (! living(target))
        return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

    ap = me->query_skill("sword") + me->query_skill("dodge");
    dp = target->query_skill("dodge") + target->query_skill("parry");

    msg = HIW "$N" HIW "轻吟" HIG "「剑气纵横三万里」" HIW "，手中" + weapon->name() + HIW "剑光暴涨，瞬息间化作千百道剑影，" QIANLI "已然施展！" NOR "\n";

    if (COMBAT_D->hit_determination(me,target,ap,dp))
    {
        damage = ap + random(ap / 2);
        me->add("neili", -300);
        attack_time = 5 + random(3);
        msg += HIR "$n" HIR "只觉眼前剑光闪烁，根本无法看清剑招，更遑论躲避，只能勉强招架。" NOR "\n";
        message_combatd(msg, me, target);

        for(i = 0; i < attack_time; i++)
        {
            if (! me->is_fighting(target))
                break;
            COMBAT_D->do_attack(me, target, weapon, 0);
        }

        msg = HIY "\n$N" HIY "长剑回收，" QIANLI "的余威未消，$n" HIY "只觉全身剧痛，难以动弹。" NOR "\n";
        target->start_busy(3);
    } else
    {
        me->add("neili", -100);
        msg += HIG "可是$n" HIG "识破了$N" HIG "的剑路，巧妙地一一化解开来。" NOR "\n";
        me->start_busy(2);
    }
    message_combatd(msg, me, target);
    return 1;
}