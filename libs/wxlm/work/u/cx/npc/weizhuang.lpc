// 卫庄 NPC



inherit NPC;
inherit F_MASTER;

// 函数声明
int ask_skill();
int do_challenge(string arg);
void do_reset();
void unconscious();
void die();

void create()
{
    set_name("卫庄", ({ "wei zhuang", "wei", "zhuang" }));
    set("long", HIB "他就是名震天下的鬼谷传人卫庄，持有名刀「鲨齿」。\n"
                    "他身材高大，容貌英俊冷峻，一袭" + HIB "黑衣如夜" + NOR "，\n"
                    "气质阴冷而神秘。他的" + HIC "眼神凌厉" + NOR "，犹如寒刃，\n"
                    "透出" + HIR "不羁与霸气" + NOR "。卫庄的刀法" + HIM "诡异莫测" + NOR "，\n"
                    "他继承了鬼谷派的精髓，却走出了一条属于自己的道路。\n"
                    "在历史上，卫庄是战国末期的风云人物，作为鬼谷子的弟子，\n"
                    "与师兄盖聂齐名，却因理念不同而分道扬镳。\n" NOR);
    set("title", HIR "鬼谷传人" NOR);
    set("nickname", HIC "鬼谷恶剑" NOR);
    set("gender", "男性");
    set("age", 36);
    set("attitude", "cold");
    set("shen_type", -1);
    set("str", 50);
    set("int", 50);
    set("con", 50);
    set("dex", 50);

    // 属性设置
    set("max_qi", 50000);
    set("eff_qi", 50000);
    set("qi", 50000);
    set("max_jing", 30000);
    set("eff_jing", 30000);
    set("jing", 30000);
    set("neili", 50000);
    set("max_neili", 50000);
    set("jiali", 500);
    set("level", 100);
    set("combat_exp", 50000000);
    set("score", 1200000);

    // 技能设置
    set_skill("force", 1800);
    set_skill("ghost-force", 1800);       // 鬼谷内功
    set_skill("dodge", 1500);
    set_skill("ghost-guzong", 1500);      // 鬼谷身法
    set_skill("parry", 1500);
    set_skill("blade", 1500);
    set_skill("weizhuang_guidao", 1500);  // 鲨齿鬼刀
    set_skill("literate", 1500);
    set_skill("martial-cognize", 1500);
    
    // 新增刀法
    set_skill("liushui-blade", 1200);     // 流水刀法
    set_skill("kuangfeng-blade", 1200);   // 狂风刀法
    set_skill("lingshe-blade", 1200);     // 灵蛇刀法
    set_skill("tieshan-blade", 1200);     // 铁山刀法
    // 无名刀法
    set_skill("wuming-blade", 1200); //无名刀法

    // 技能映射
    map_skill("force", "ghost-force");
    map_skill("dodge", "ghost-guzong");
    map_skill("parry", "weizhuang_guidao");
    map_skill("blade", "weizhuang_guidao");

    // 预备技能
    prepare_skill("blade", "weizhuang_guidao");

    // 战斗设置
    set("chat_chance_combat", 100);
    set("chat_msg_combat", ({
        (: perform_action, "blade.guiying_shan" :),
        (: perform_action, "blade.xueren_kuangwu" :),
        (: perform_action, "blade.zhongji_guizhan" :),
        (: exert_function, "powerup" :),
        (: perform_action, "blade.liushui" :),
        (: perform_action, "blade.kuangfeng" :),
        (: perform_action, "blade.lingshe" :),
        (: perform_action, "blade.tieshan" :),
    }));

    // 对话信息
    set("inquiry", ([
        "鲨齿鬼刀" : (: ask_skill :),
        "流水刀法" : "这是我所创的一种刀法，讲究以柔克刚，如行云流水。\n",
        "狂风刀法" : "此刀法迅猛如狂风，以快打慢，令敌人应接不暇。\n",
        "灵蛇刀法" : "灵蛇刀法诡异难测，如灵蛇般令人防不胜防。\n",
        "铁山刀法" : "这门刀法以力取胜，刀法沉重如山，威力巨大但不够灵活。\n",
        "无名刀法" : "这门刀法以力取胜，刀法沉重如山，威力巨大但不够灵活。\n",
    ]));

    // 初始化
    setup();

    // 装备
    carry_object("/clone/weapon/blade")->wield();
    carry_object("/clone/cloth/cloth")->wear();
}

void init()
{
    if (this_player() && living(this_player()))
        call_out("check_competitor", 1, this_player());
}

// 查询技能
int ask_skill()
{
    object me = this_player();

    if (me->query("can_learn/weizhuang/guidao"))
    {
        command("say 你已经通过了我的考验，我可以传授你鲨齿鬼刀。");
        return -1;
    }

    if (me->query_temp("challenge_weizhuang"))
    {
        command("say 你还在挑战中，尽快开始吧。");
        return -1;
    }

    if (me->query("combat_exp") < 1000000)
    {
        command("hmm");
        command("say 就你这点能力，还想学我的刀法？");
        return -1;
    }

    command("grin");
    command("say 想学我的鲨齿鬼刀？那就先证明你的实力吧！");
    me->set_temp("challenge_weizhuang", 1);
    return -1;
}

// 重置状态
void do_reset()
{
    if (! living(this_object()))
        revive();

    remove_all_enemy(1);
    this_object()->remove_all_killer();

    set("eff_qi", query("max_qi"));
    set("qi", query("max_qi"));
    set("eff_jing", query("max_jing"));
    set("jing", query("max_jing"));
    set("neili", query("max_neili"));
    this_object()->clear_condition();
}

// 不死机制
void unconscious()
{
    message_vision(HIR "\n$N" HIR "冷哼一声，身形一闪，消失在黑暗中。\n\n" NOR, this_object());
    do_reset();
}

void die()
{
    unconscious();
}

// 接受战斗
int accept_fight(object ob)
{
    if (ob->query("combat_exp") < 1000000)
    {
        command("say 就你这点实力，还不配与我较量。");
        return -1;
    }

    if (is_fighting())
    {
        command("say 等我处理完眼前的事。");
        return -1;
    }

    if (query("qi") < 4000 || query("jing") < 2000 || query("neili") < 4000)
    {
        command("say 我现在状态不佳，改日再战。");
        return -1;
    }

    if (ob->query("can_learn/weizhuang/guidao"))
    {
        command("say 既然你已经掌握了鲨齿鬼刀的要诀，那就再切磋切磋。");
        return 1;
    }

    command("say 很好，就让我看看你有什么本事！");
    competition_with(ob);
    return -1;
}

// 添加胜负处理函数
void win()
{
    object ob;
    
    if (objectp(ob = query_competitor()))
    {
        command("say 你还差得远，继续修炼去吧。");
        ::win();
    }
}

void lost()
{
    object ob;
    
    if (objectp(ob = query_competitor()))
    {
        command("hmm");
        command("say 不错，你的实力确实够格，我可以传授你鲨齿鬼刀了。");
        ob->set("can_learn/weizhuang/guidao", 1);
        ::lost();
    }
}

void check_competitor(object me)
{
    if (! me || environment(me) != environment())
        return;
        
    if (me->query("can_learn/weizhuang/guidao"))
        return;
        
    if (me->query("combat_exp") >= 1000000)
        command("say 听说你想学我的鲨齿鬼刀？那就让我看看你的实力如何。");
}

// 接受攻击
int accept_hit(object who)
{
    command("say 哼，找死！");
    kill_ob(who);
    return 1;
}

// 接受杀戮
int accept_kill(object who)
{
    command("say 既然你想找死，那我就成全你！");
    return 1;
}

// 认知技能
// 认知技能
int recognize_apprentice(object me, string skill)
{
    string *allowed_skills = ({
        "blade",
        "weizhuang_guidao",
        "liushui-blade",
        "kuangfeng-blade",
        "lingshe-blade",
        "tieshan-blade",
        "wuming-blade",
    });

    if (member_array(skill, allowed_skills) == -1)
    {
        command("say 我只传授我的刀法，其他的你找别人去学。");
        return -1;
    }

    // 只有无名刀法需要无门派可以学习
    if (skill == "wuming-blade")
    {
        if (me->query("family/family_name"))
        {
            command("say 无名刀法只有无门无派的人才能学习。");
            return -1;
        }
    }

    if (skill == "weizhuang_guidao" && ! me->query("can_learn/weizhuang/guidao"))
    {
        command("hmm");
        command("say 你还没有通过我的考验，凭什么让我教你？");
        return -1;
    }

    command("nod");
    command("say 好吧，既然你有心学习，我就指点你一二。");
    return 1;
}