// 盖聂 NPC

inherit NPC;

int ask_skill();
int do_learn(string arg);
void start_attack(object me);
void check_challenge(object me);

void create()
{
    set_name("盖聂", ({ "gai nie", "gai", "nie" }));
    set("long", HIW"这就是名震天下的剑圣盖聂，鬼谷传人。他身材修长挺拔，容貌俊美如玉，\n"
                "一袭" + HIW "白衣胜雪" + NOR + "，气质超凡脱俗。他的" + HIC "眼神深邃如渊" + NOR + "，平静如水，仿佛能洞察世间万物。\n"
                "盖聂手中的" + HIY "长剑" + NOR + "看似普通，却蕴含着" + HIR "惊天动地的威力" + NOR + "。他的'" + HIM "百步飞剑" + NOR + "'\n"
                "更是天下第一剑法，" + HIW "剑气纵横三万里" + NOR + "，百步之内，取人首级如探囊取物。\n"
                "盖聂" + HIC "超然物外" + NOR + "，不收徒弟，但对" + HIY "有缘人" + NOR + "会传授" + HIM "剑道真谛" + NOR + "。\n" NOR);
    set("title", HIW "剑圣" NOR);
    set("nickname", HIC "鬼谷传人" NOR);
    set("gender", "男性");
    set("age", 35);
    set("attitude", "peaceful");
    set("shen_type", 1);
    set("str", 50);
    set("int", 50);
    set("con", 50);
    set("dex", 50);
    
    set("max_qi", 50000);
    set("max_jing", 30000);
    set("neili", 50000);
    set("max_neili", 50000);
    set("jiali", 500);
	set("score", 1200000);
    set("combat_exp", 50000000);
    
    set_skill("force", 1500);
    set_skill("sword", 1500);
    set_skill("dodge", 1500);
    set_skill("parry", 1500);
    set_skill("tiyunzong", 1500);
    set_skill("taiji-shengong", 1800);
    set_skill("ghost-force", 1800);       // 鬼谷内功
    set_skill("ghost-guzong", 1500);      // 鬼谷身法
    set_skill("genie_baibufeijian", 1500);  // 百步飞剑
    set_skill("tianwai_feixian", 1500);   // 天外飞仙剑法
    set_skill("huanyue_liuguang", 1500);  // 幻月流光剑法
    set_skill("xinghe_cuican", 1500);     // 星河璀璨剑法
    set_skill("jiuxiao_jinghong", 1500);  // 九霄惊鸿剑法
    set_skill("bihai_chaosheng", 1500);   // 碧海潮生剑法
    set_skill("literate", 1500);  // 读书写字
    set_skill("taoism", 1500);    // 道学心法
    set_skill("martial-cognize", 1500);  // 武学修养
    
    map_skill("force", "ghost-force");
    map_skill("dodge", "ghost-guzong");;
    map_skill("parry", "genie_baibufeijian");
    map_skill("sword", "genie_baibufeijian");
    
    prepare_skill("sword", "genie_baibufeijian");
    
    set("chat_chance_combat", 100);
    set("chat_msg_combat", ({
        (: perform_action, "sword.qianli_zhuihun" :),
        (: perform_action, "sword.jiutian_jiange" :),
        (: perform_action, "sword.jueshi_shenjian" :),
        (: exert_function, "recover" :),
        (: exert_function, "powerup" :),
    }) );
    
    set("inquiry", ([
        "百步飞剑" : (: ask_skill :),
    ]));
    
    setup();
    
    carry_object("/clone/weapon/changjian")->wield();
    carry_object("/clone/cloth/cloth")->wear();
}

void init()
{
    object me = this_player();

    ::init();
    add_action("do_learn", "xuexi");

    if (me && living(me))
    {
        call_out("check_challenge", 1, me);
    }
}

int recognize_apprentice(object me, string skill)
{
    string *allowed_skills = ({
        "sword",
        "genie_baibufeijian",
        "tianwai_feixian",
        "huanyue_liuguang",
        "xinghe_cuican",
        "jiuxiao_jinghong",
        "bihai_chaosheng"
    });

    if (member_array(skill, allowed_skills) == -1)
    {
        command("say 我只教授百步飞剑和其他几种特殊剑法，其他的本事你还是去找别人学吧。");
        return -1;
    }
    
    if (skill == "tianwai_feixian" && me->query("family/family_name"))
    {
        command("say 天外飞仙剑法只有无门无派的人才能学习。");
        return -1;
    }

    if (skill == "genie_baibufeijian" && !me->query("can_learn/genie/genie_baibufeijian"))
    {
        command("say 你还没有通过我的考验，如何能学习百步飞剑？");
        return -1;
    }
    
    command("nod");
    command("say 好吧，既然你有心学习，我就指点你一二。");
    return 1;
}

int ask_skill()
{
    object me = this_player();
    
    if (!SKILL_D("genie_baibufeijian")->valid_learn(me))
    {
        command("say 你还不满足学习百步飞剑的条件。");
        return 1;
    }

    if (me->query("can_learn/genie/genie_baibufeijian"))
    {
        command("say 你已经领悟了百步飞剑的精髓，还是自己勤加练习吧。");
        return 1;
    }

    command("say 好，让我看看你的剑法造诣。你需要将我的气血打到70%以下，才能证明你有资格学习百步飞剑。");
    command("say 准备好了吗？我要开始进攻了！");
    
    me->set_temp("challenge_genie", 1);
    this_object()->fight_ob(me);
    me->fight_ob(this_object());
    // 延迟一秒后开始攻击玩家
    call_out("start_attack", 1, me);
    
    return 1;
}

void start_attack(object me)
{
    if (!me || environment(me) != environment())
    {
        return;
    }
    
    message_vision(HIY "$N" HIY "手中长剑一抖，化作千万道流光，向$n" HIY "攻去！\n" NOR, this_object(), me);
    COMBAT_D->do_attack(this_object(), me, query_temp("weapon"));
    
    // 如果玩家还活着且挑战未成功，继续攻击
    if (me && living(me) && me->query_temp("challenge_genie"))
    {
        call_out("start_attack", 3, me);
    }
}

void check_challenge(object me)
{
    if (!me || !me->query_temp("challenge_genie"))
    {
        return;
    }
    
    if (query("qi") < query("max_qi") * 0.7)
    {
        command("say 不错，你的剑法已经达到了很高的境界。");
        tell_object(me, HIC "你成功通过了盖聂的考验，现在可以学习百步飞剑了。\n" NOR);
        me->set("can_learn/genie/genie_baibufeijian", 1);
        me->delete_temp("challenge_genie");
        remove_call_out("start_attack");  // 停止攻击
        this_object()->remove_enemy(me);
        return;
    }
    
    // 如果挑战还在继续，再次检查
    call_out("check_challenge", 1, me);
}


void unconcious()
{
    die();
}
