// 李寻欢 NPC


// #include <combat.h>

inherit NPC;
inherit F_MASTER;

void create()
{
    set_name("李寻欢", ({ "li xunhuan", "li", "xunhuan" }));
    set("long", HIW "这就是江湖上赫赫有名的'小李飞刀'李寻欢，有着'例不虚发'的美誉。\n"
                "他身材清瘦，面容略显苍白，眼神中透着一丝" + HIR "寂寞" + NOR + "与" + HIC "沧桑" + NOR + "。\n"
                "腰间" + HIY "酒壶" + NOR + "与" + HIW "飞刀" + NOR + "是他最忠实的伴侣。传闻他的" + HIM "小李飞刀" + NOR + "\n"
                "从未失手，" + HIR "例不虚发" + NOR + "四个字已成为江湖一绝。他总是独自饮酒，\n"
                "仿佛要将" + HIW "心中的寂寞" + NOR + "与" + HIC "无尽的哀愁" + NOR + "一饮而尽。\n" NOR);
    
    set("title", HIW "小李飞刀" NOR);
    set("nickname", HIC "例不虚发" NOR);
    set("gender", "男性");
    set("age", 38);
    set("attitude", "peaceful");
    set("shen_type", 1);
    set("str", 45);
    set("int", 45);
    set("con", 45);
    set("dex", 50);
    
    set("max_qi", 45000);
    set("max_jing", 28000);
    set("neili", 45000);
    set("max_neili", 45000);
    set("jiali", 450);
    set("score", 1000000);
    set("combat_exp", 45000000);
    
    // 基础技能
    set_skill("force", 1400);
    set_skill("dodge", 1400);
    set_skill("parry", 1400);
    set_skill("throwing", 1500);    // 暗器技能
    set_skill("sword", 1400);
    set_skill("blade", 1400);
    
    // 特殊技能
    set_skill("xiaoli-feidao", 1500);      // 小李飞刀
    set_skill("lonely-force", 1400);       // 寂寞心法
    set_skill("lingbo-weibu", 1400);       // 凌波微步
    set_skill("literate", 1200);           // 读书写字
    set_skill("martial-cognize", 1400);    // 武学修养
    
    map_skill("force", "lonely-force");
    map_skill("dodge", "lingbo-weibu");
    map_skill("parry", "xiaoli-feidao");
    map_skill("throwing", "xiaoli-feidao");
    
    prepare_skill("throwing", "xiaoli-feidao");
    
    set("chat_chance_combat", 100);
    set("chat_msg_combat", ({
        (: perform_action, "throwing.fengliu" :),    // 风流快意
        (: perform_action, "throwing.libuhuafa" :),  // 例不虚发
        (: perform_action, "throwing.xiaoyao" :),    // 逍遥无情
        (: exert_function, "recover" :),
        (: exert_function, "powerup" :),
    }) );
    
    set("inquiry", ([
        "小李飞刀" : "想学小李飞刀？那就陪我切磋一下吧。",
        "例不虚发" : "唉，这四个字背后的代价，又有几人能懂？",
        "醉红尘" : "那是我最爱喝的酒，可以忘却一切烦恼。",
    ]));
    
    setup();
    
    carry_object("/clone/weapon/feidao")->wield();
    carry_object("/clone/cloth/cloth")->wear();
    carry_object("/clone/misc/jiuhu");  // 携带酒壶
}

void init()
{
    add_action("do_learn", "xuexi");
    
    if (this_player() && living(this_player()))
        call_out("check_competitor", 1, this_player());
}

int recognize_apprentice(object ob, string skill)
{
    if (! ob->query("can_learn/lixunhuan/xiaoli-feidao"))
    {
        command("say 想学小李飞刀？先陪我切磋一下吧。");
        return -1;
    }

    if (skill != "throwing" && skill != "xiaoli-feidao")
    {
        command("say 我只传授飞刀之术，其他的本事你还是去找别人学吧。");
        return -1;
    }
    
    return 1;
}

int accept_fight(object ob)
{
    if (ob->query("combat_exp") < 1000000)
    {
        command("say 你的实战经验太少，还无法领会小李飞刀的精髓。");
        return -1;
    }

    if (is_fighting())
    {
        command("say 稍候，待我处理完当前的事情。");
        return -1;
    }

    if (query("qi") < 4000 || query("jing") < 2000 || query("neili") < 4000)
    {
        command("say 抱歉，我现在状态不佳，改日再切磋吧。");
        return -1;
    }

    if (ob->query("can_learn/lixunhuan/xiaoli-feidao"))
    {
        command("say 既然你已经领悟了小李飞刀的要诀，那就再切磋切磋吧。");
        return 1;
    }

    command("say 好，就让我看看你的本事。");
    competition_with(ob);
    return -1;
}

void win()
{
    object ob;
    
    if (objectp(ob = query_competitor()))
    {
        command("say 你的功夫还需要磨练，继续努力吧。");
        ::win();
    }
}

void lost()
{
    object ob;
    
    if (objectp(ob = query_competitor()))
    {
        command("sigh");
        command("say 没想到阁下武功如此了得，既然你赢了我，这小李飞刀的绝技我就倾囊相授了。");
        ob->set("can_learn/lixunhuan/xiaoli-feidao", 1);
        ::lost();
    }
}

void check_competitor(object me)
{
    if (! me || environment(me) != environment())
        return;
        
    if (me->query("can_learn/lixunhuan/xiaoli-feidao"))
        return;
        
    if (me->query("combat_exp") >= 1000000)
        command("say 阁下看起来武功不错，要不要切磋一下？赢了我，我就教你小李飞刀。");
}
