


inherit COMBINED_ITEM;

void setup()
{
	set_amount(1);
	::setup();
}

void create()
{
	set_name(HIR "毒丸" NOR, ({ "du wan", "dan" }) );
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", " 这是一粒由毒虫毒液精制而成的毒药，要是你想不开了，可以尝尝！\n");
		set("base_unit", "粒");
		set("poison_type", "poison");
		set("base_weight", 10);
        set("value", 50);
		set("can_pour", 1);
		set("can_daub", 1);
		set("can_drug", 1);
        set("no_sell", 1);
		set("suit_point", 300);
		set("only_do_effect", 1);
        set("poison", ([
			"level" : 200,
			"id"    : "古春秋",
			"name"  : "毒",
			"duration": 15,
		]));
	}
	setup();
}

int do_effect(object me)
{
	message_vision("$N一仰脖，把毒药全部倒入了嘴中。\n",
		       me);
	me->set_temp("die_reason", "吃了毒药去见黑白无常了");
	me->die();
	destruct(this_object());
	return 1;
}
