 * @file lunwulou.c
 * @author Lu dexiang
 * @brief 论武楼
 * @version 1.0
 * @date 2023-12-01
 */


inherit ROOM;

void create()
{
    set("short", HIY"论武楼"NOR);
    set("long", @LONG
这里是泉州著名的论武楼，是新手切磋武艺的好去处。整个大厅宽敞明亮，
四周摆放着各种练武器械。许多初入江湖的少侠都在此切磋武艺，交流心得。
墙上挂着一块醒目的木牌。
LONG );

    set("item_desc", ([
        "【木牌】" : "武者切磋场所，仅供200级以下的玩家进入。\n"
    ]));

    set("exits", ([
        "west" : __DIR__"haigang",
    ]));

    set("objects", ([
        "/clone/npc/mu-ren" : 3,
    ]));

    set("no_fight", 0);
    set("no_steal", 1);
    set("no_sleep_room", 1);

    setup();
}

int valid_leave(object me, string dir)
{
    if (!me || !living(me))
        return 0;

    return ::valid_leave(me, dir);
}
