		"【红包树】" : popup_comb("玩家红包系统，发红包，抢红包，记录查询。","查看:player_hongbao"),
		// "【8月特别返场活动】" : popup_comb("查看你在8月特别返场活动中的返场积分进度。","查看:august_comeback_reward"),
		// "【返场积分兑换商店】" : popup_comb("使用返场积分兑换各种珍贵物品和称号。","查看:exchange_shop"),
		// "【九月秋季贡献活动】" : popup_comb("查看你在九月秋季贡献活动中的奖励进度。","查看:jiuyue_autumn_reward"),
		// "【国庆贡献活动】" : popup_comb("查看你在国庆贡献活动中的奖励进度。","查看:guoqing_donate_reward"),
		"【国庆经验累计活动】" : popup_comb("查看全服经验累计活动进度和你的奖励领取情况。","查看:guoqing_exp_reward"),
	]));

	set("exits", ([
		"northeast" : __DIR__"shuyuan",
		"southeast" : __DIR__"heishi",
		"east" : __DIR__"dongdajie1",
		"south" : __DIR__"nandajie1",
		"west" : __DIR__"xidajie1",
		"north" : __DIR__"beidajie1",
	]));

	set("objects", ([
		__DIR__"npc/liapo" : 1,
		// "/adm/special_ob/duanwu/npc/quyuan":1,
