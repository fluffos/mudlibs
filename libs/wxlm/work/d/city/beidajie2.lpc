// Room: /city/beidajie2.c

inherit ROOM;

void create()
{
	set("short", "古韵北街");
	set("long", @LONG
这是一条宽阔的青石板铺就的古街，街道两旁店铺林立，行人络绎不绝。北面是高大的北城门，通向城外广阔天地；
南面人声鼎沸，一派繁华景象。东面是一座古色古香的两层楼阁，金字招牌“醉仙楼”在阳光下熠熠生辉；西面则是
香火缭绕的忠武堂，是天下武林人士朝圣参拜之地。
LONG );
	set("outdoors", "city");
	set("exits", ([
		"east"  : __DIR__"zuixianlou",
		"south" : __DIR__"beidajie1",
		"west"  : __DIR__"wumiao",
		"north" : __DIR__"beimen",
	]));
	setup();
}

