// Room: /city/nanmen.c
inherit ROOM;

string look_gaoshi();

void create()
{
	set("short", "南城门");
	set("long", @LONG
这是扬州南城门，高大的城墙上贴满了五颜六色的商铺招贴，琳琅满目，热闹非凡。
城门两侧的官兵们神情轻松，时不时被附近茶楼酒肆传来的欢声笑语吸引。一条
宽阔的青石板大道向南北延伸，来往的商旅络绎不绝。
LONG );
	set("outdoors", "city");
	set("item_desc", ([
		"【告示】" : (: look_gaoshi :),
	]));

	set("exits", ([
		"south" : "/d/wudang/wdroad1",
		"north" : __DIR__"nandajie2",
		"west"  : __DIR__"jiaowai8",
		"east"  : __DIR__"jiaowai7",
	]));
	set("objects", ([
		__DIR__"npc/wujiang" : 2,
		__DIR__"npc/bing" : 10,
		__DIR__"npc/shisong" : 1,
	]));
	setup();
}

string look_gaoshi()
{
	return FINGER_D->get_killer() + "\n扬城巡检司\n巡检使王载\n";
}

