// Room: /city/ximen.c
inherit ROOM;

string look_gaoshi();

void create()
{
	set("short", "西城门");
	set("long", @LONG
这是扬州西城门，高大的城墙上斑驳着岁月的痕迹，城门正上方的"西门"二字依稀可辨。
城墙上张贴着几张通缉要犯的告示，引得过往行人驻足观看。一条宽阔的青石板大道横贯
东西，向东通往繁华的城区，向西则是郊外的田野。城门两侧的卫兵神情严肃，警惕地注
视着来往的行人。
LONG );
	set("outdoors", "city");
	set("item_desc", ([
		"【告示】" : (: look_gaoshi :),
	]));

	set("exits", ([
		"east"  : __DIR__"xidajie2",
		"west"  : __DIR__"ximenroad",
	]));
	set("objects", ([
		__DIR__"npc/wujiang" : 1,
		__DIR__"npc/bing" : 2,
		"/d/mingjiao/npc/fenggongying" : 1,
		"/d/luoyang/npc/libiaoshi" : 1,
	]));
	setup();

}

string look_gaoshi()
{
	return FINGER_D->get_killer() + "\n扬城巡检司\n巡检使王载\n";
}

