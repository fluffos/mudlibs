// Room: /city/wumiao.c
// YZC 1995/12/04 

#include <room.h>

inherit ROOM;

int is_chat_room() { return 1; }

void create()
{
	set("short", "忠武堂");
	set("long", @LONG
这里是忠武堂的正殿，金碧辉煌，庄严肃穆。正中供奉着岳飞塑像，神态威严）
气宇轩昂。像上方悬挂着一块金丝楠木横匾，上书岳飞亲笔“还我河山”四个遒劲大
字。殿堂两侧壁上镶嵌着金漆“尽忠报国”四字，在烛光映照下熠熠生辉。来往武林
人士到此，无不放下兵刃，毕恭毕敬上香参拜。殿角处隐约可见一道精巧的竹门。
LONG );
	set("no_fight", "1");
	set("no_steal", "1");
	set("no_learn", "1");
	set("no_study", "1");
	set("no_teach", "1");
	set("no_dazuo", "1");
	set("no_sleep_room", "1");

	set("valid_startroom","1");
	set("objects", ([
		__DIR__"obj/box" : 1,
	]));


	set("item_desc", ([
		"【武穆尊像】" : "这是一尊栩栩如生的岳飞塑像。岳飞身着铠甲，手持长枪，目光如炬，神态威严。塑像底座上刻有“精忠报国”四个大字，彰显了岳飞的爱国情怀和崇高品格。",
		"【秦桧跪像】" : "这是一尊秦桧的跪像，形象卑劣，面带羞愧之色。雕像栩栩如生地刻画了秦桧跪地求饶的模样，其卖国求荣的罪行永远被钉在历史的耻辱柱上。",
		"【王氏跪像】" : "这是秦桧之妻王氏的跪像。雕像刻画了王氏跪地的姿态，表情中混杂着恐惧和悔恨。这尊跪像与秦桧的跪像一起，象征着背叛者及其同谋最终遗臭万年。",
	]));

	set("exits", ([
		"east" : __DIR__"beidajie2",
		"north"   : __DIR__"wumiao2",
		"northwest": "/d/wizard/guest_room",
	]));
	create_door("northwest", "殿门", "southeast", DOOR_CLOSED);
	setup();
}


int valid_leave(object me, string dir)
{
	if (dir == "northwest" && ! userp(me) && ! me->is_chatter())
		return 0;
	return ::valid_leave(me, dir);
}

