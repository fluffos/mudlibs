inherit ROOM;
void create()
{
	set("short", "民用厨房");
	set("long", @LONG
这是扬州城内的一间公用厨房，专门供普通百姓烹饪使用。厨房内设施齐全,几个大水池前摆放着各式锅碗瓢盆。灶台上炉火正旺,一个个百姓正在忙碌着,不时传来阵阵饭菜香。墙上贴着一张告示,写着使用规则和收费标准。这里经常可以看到附近的居民来此做饭,倒也热闹。
LONG );
	set("exits", ([
		"north" : __DIR__"kedian",
	]));
	set("no_fight", 1);
	set("no_sleep_room", 1);
	setup();
	// set("action_list", ([
	// 	"烹饪":"cook",
	// ]));
	set("item_desc", ([
        "灶台" : popup_comb("这是一个砖砌的大灶台，上面摆放着各式锅具。灶膛内炉火正旺，火苗舔舐着锅底，发出哔啵的响声。一阵阵炊烟袅袅升起，带着柴火的香气。这里可以用来烹饪各种美食。",({ "烹饪:cook" }) ),
    ]) );
}
