// heishi.c

inherit ROOM;

void create()
{
	set("short", "扬城集市");
	set("long", "这里是扬城最繁华的集市，人来人往，熙熙攘攘。四周摆满了各式各样的摊位，商贩们吆喝叫卖声不绝于耳。这里不仅可以交易各种物品，还能找到一些修炼所需的珍贵资源。墙上贴着一张告示，详细说明了交易规则。" NOR);
	set("exits", ([
		"northwest":__DIR__"guangchang",
	]));
	set("objects", ([
		__DIR__"npc/shenyi" : 1,
	]));
	set("action_list", ([
		"寄售物品" : "jishou",
		"物品列表" : "jylist",
		"重选性格" : "xingge",
		"重新洗点" : "xidian",
		"回收物品" : "huishou",
		"内力灌体" : "neili_gt",
	]));
	set("no_fight","1");
	set("no_steal", "1");
	set("no_sleep_room", "1");
	setup();
}

void init()
{
	add_action("do_stock", "jishou");
	add_action("do_buy", "jybuy");
	add_action("do_list", "jylist");
	add_action("do_cha", "jychakan");
	add_action("do_unstock", "quhui");
	add_action("do_xingge","xingge");
	add_action("do_uses","xidian");
	add_action("do_effect", "effect");
	add_action("do_huishou","huishou");
	add_action("do_neili", "neili_gt");
}


// 内力罐体，需要加参数yes确认，确认后：me->set("neidan_number", me->query("max_neili") * 1000);，需要20元宝或者40绑定元宝，优先消耗绑定元宝
int do_neili(string arg)
{
	object me = this_player();

	if (!arg)
	{
		string msg = "你可以使用内力灌体，会补充你的内丹存储量(需要先打通任督二脉并且贡献超过250)，需要20元宝或者40绑定元宝，优先消耗绑定元宝。\n";
		// 如果有内丹药力显示剩余量
		if (me->query("neidan_number") > 0)
		{
			msg += sprintf("你的内丹存储量：%d点。", me->query("neidan_number"));
		}
		else
		{
			msg += "你的内丹存储量：0点。";
		}
		tell_object(me, popup_comb(msg,(({ "确认:neili_gt yes" }))));
		return 1;
	}

	if (arg == "yes")
	{
		// if (me->query("neidan_number") > 0)
		// {
		// 	tell_object(me, "你已拥有内丹存储量。\n");
		// 	return 1;
		// }

		if (me->query("yuanbao") < 20 && me->query("bind_yuanbao") < 40)
		{
			tell_object(me, "你的元宝或者绑定元宝不足。\n");
			return 1;
		}

		// 是否打通任督二脉
		if (!me->query("breakup") || me->query("zjvip/all_pay") <= 250)
		{
			tell_object(me, "你的任督二脉未打通或者贡献不足。\n");
			return 1;
		}

		if (me->query("bind_yuanbao") >= 40)
		{
			me->add("bind_yuanbao", -40);
		}
		else
		{
			me->add("yuanbao", -20);
		}

		me->set("neidan_number", me->query("max_neili") * 1000);
		tell_object(me, "黑心老人使用星辰绝技，对你进行内力灌体，你的内丹存储量已经满了。\n");
	}

	return 1;
}

int do_stock(string arg)
{
	tell_object(this_player(),SALE_D->do_stock(this_player(),arg)+"\n");
	return 1;
}

int do_buy(string arg)
{
	tell_object(this_player(),SALE_D->do_buy(this_player(),arg)+"\n");
	return 1;
}

int do_cha(string arg)
{
	tell_object(this_player(),SALE_D->do_cha(this_player(),arg)+"\n");
	return 1;
}

int do_list(string arg)
{
//	return notify_fail(OKSAY"集市暂时关闭！\n");
	if(!arg)
		arg = "全部 1";
	tell_object(this_player(),SALE_D->do_list(this_player(),arg)+"\n");
	return 1;
}

int do_unstock(string arg)
{
	tell_object(this_player(),SALE_D->do_unstock(this_player(),arg)+"\n");
	return 1;
}



int do_xingge(string arg)
{
object me = this_player();
tell_object(me,ZJOBLONG"请选择性格，第一次免费，之后每次扣费200元宝：\n"
		ZJOBACTS2+ZJMENUF(2,2,6,30)+
        "狡黠多变:effect 狡黠多变"ZJSEP
		"光明磊落:effect 光明磊落"ZJSEP
		"阴险奸诈:effect 阴险奸诈"ZJSEP
		"心狠手辣:effect 心狠手辣\n");
	return 1;
}


int do_effect(string arg)
{
	object me = this_player();
	if (me->query("xixingge")&&me->query("yuanbao") < 200)
	{
	tell_object(me,HIR"你的元宝数量不够！！"NOR"\n");		
		return 1;
	}
	if (me->query("character")==arg)
		{
	tell_object(me,HIR"请选择与你现在性格不一样的！"NOR"\n");		
		return 1;
	}
	if (arg=="狡黠多变") 
	 me->set("character", "狡黠多变");
	else
	 if (arg=="光明磊落") 
	   me->set("character", "光明磊落");

	else 
	if (arg=="心狠手辣") 
	 me->set("character", "心狠手辣");

	else 
	if (arg=="阴险奸诈") 
	me->set("character", "阴险奸诈");
		else 	
		{
	tell_object(me,HIR"\n敬请期待新性格！"NOR"\n");		
	return 1;
		}
	  tell_object(me,"性格转换成功!\n");
	  if (me->query("xixingge"))
	  {	  me->add("yuanbao",-200);
    tell_object(me,"200元宝已扣除!\n");
	  }
	  me->set("xixingge",1);
    return 1;
}

varargs int do_uses(string arg)
{
    // 变量声明
    mapping my;
    string str, line;
    int max_sx;
    int tmpstr, tmpint, tmpcon, tmpdex;
    object me = this_player();
    int min_point;
	int max_point;
	int must_point;

	min_point = (me->query("gift/shenliwan") + me->query("gift/xiandan") + me->query("gift/unknowdan") + me->query("gift/lighting") + me->query("gift/xisuidan")) / 4  + 13;
	max_point = 30 + (me->query("gift/shenliwan") + me->query("gift/xiandan") + me->query("gift/unknowdan") + me->query("gift/lighting") + me->query("gift/xisuidan")) / 4;
	must_point = 80 + (me->query("gift/shenliwan") + me->query("gift/xiandan") + me->query("gift/unknowdan") + me->query("gift/lighting") + me->query("gift/xisuidan"));

    // 检查是否可以免费使用
    if (!me->query("xidian")) {
        tell_object(me, "你当前可以免费试用一次。\n");
    }
    
    // 检查元宝是否足够
    if (me->query("xidian") && me->query("yuanbao") < 200) {
        return notify_fail("你的元宝不够。\n");
    }
    
    // 处理不同的参数情况
    if (!arg) {
        // 显示确认提示
        str = ZJOBLONG + "你真的想重新分配先天属性吗？请慎重选择，一旦洗点造成严重后果概不负责，第一次免费,后续收费200元宝！\n";
        str += ZJOBACTS2 + ZJMENUF(3,3,9,30);
        str += sprintf("确定:xidian -yes" + ZJSEP);
        str += sprintf("取消:look");
        tell_object(me, str + "\n");
        return 1;
        
    } 
	
	if (arg == "-yes") {
        // 计算可分配点数
        max_sx = (me->query("con") + me->query("dex") + me->query("int") + me->query("str"));
        
        // 显示输入提示
        write(INPUTTXT(HIR"注：值必须在" + min_point + "-" + max_point + "之间"ZJBR"总和不能超过你现有的先天"+max_sx+"点。不得少于" + must_point + "点。溢出的天赋点将作为天赋点返还"
                      + NOR + ZJBR + HIW + "(臂力 悟性 根骨 身法)"
                      + NOR + ZJBR + HIY + "(例：20 20 20 20，中间以空格隔开)" + NOR
                      + ZJBR + "请输入四项先天点数：", "xidian $txt#") + "\n");

		return 1;
                      
    }
	
	if (sscanf(arg, "-yes %d %d %d %d", tmpstr, tmpint, tmpcon, tmpdex) == 4) {
        // 检查数值范围
        if (tmpstr < min_point || tmpstr > max_point || tmpint < min_point || tmpint > max_point 
            || tmpcon < min_point || tmpcon > max_point || tmpdex < min_point || tmpdex > max_point) {
            write(HIR"你有一项输入不在" + min_point + "-" + max_point + "范围之内。"NOR"\n");
            return 1;
        }
        
        // 获取数据库并验证总点数
        my = me->query_entire_dbase();

        max_sx = (my["con"] + my["dex"] + my["int"] + my["str"]);
                 
        if (tmpstr + tmpint + tmpcon + tmpdex > max_sx || tmpstr + tmpint + tmpcon + tmpdex < must_point) {
            write(HIR"你想分配的先天点数不得超过你现有的先天属性，且不得低于" + must_point + "点，溢出的属性值将作为天赋点返还。"NOR"\n");
            return 1;
        }
        
        // 记录分配结果
        line = sprintf("str(%d)int(%d)con(%d)dex(%d)", tmpstr, tmpint, tmpcon, tmpdex);
        
        // 更新属性
        my["str"] = tmpstr;
        my["int"] = tmpint;
        my["con"] = tmpcon;
        my["dex"] = tmpdex;
        my["tianfu_point"] += max_sx - (tmpstr + tmpint + tmpcon + tmpdex);
        
        // 发送消息
        CHANNEL_D->do_channel(present("shenyi", this_object()), "chat", "今日，" + me->name() + "在我处重塑了身体！");
        message_vision(HIY"$N在扬州集市重塑了身体！"NOR"\n", me);
        tell_object(me, HIY"身体重塑成功，请再操作升级一次天赋！"NOR"\n");
        
        // 更新技能和保存
        UPDATE_D->check_skill(me);
        me->save();
        
        // 扣除元宝
        if (me->query("xidian"))
            me->add("yuanbao", -200);
            
        me->set("xidian", 1);

		return 1;
        
    }
	
	if (sscanf(arg, "%d %d %d %d", tmpstr, tmpint, tmpcon, tmpdex) == 4) {
        // 显示确认信息
        str = ZJOBLONG + HIC"你的设置："HIG"臂力("+tmpstr+") 悟性("+tmpint+") 根骨("+tmpcon+") 身法("+tmpdex+")"NOR
              + ZJBR"真的想重新分配先天属性吗？"ZJBR
              + "请慎重选择！最后一次提醒！一旦洗点，将不可恢复，造成严重后果概不负责！"NOR"\n";
        str += ZJOBACTS2 + ZJMENUF(3,3,9,30);
        str += sprintf("确定:xidian -yes " + tmpstr + " " + tmpint + " " + tmpcon + " " + tmpdex + ZJSEP);
        str += sprintf("取消:look");
        tell_object(me, str + "\n");
        
    } else {
        me->force_me("xidian");
    }
    
    return 1;
}

// 回收的元宝必须原价格大于10
int jiage(object ob)
{
	if (ob->query("yuanbao") > 10)
		return ob->query("yuanbao") / 5;

	return 0;
}
int do_huishou(string arg)
{
	string msg, id_name;
	object me = this_player();
	object obj;
	int amount;
	if (!arg)
	{
		object *pobj;
		pobj = all_inventory(me);
		pobj = filter_array(pobj, (: jiage($1) :));

		if (!sizeof(pobj))
			return 1;

		msg = ZJOBLONG "请选择你需要回收的物品：\n" ZJOBACTS2 + ZJMENUF(2, 2, 6, 30);

		foreach (obj in pobj)
		{
			amount = obj->query_amount() ? obj->query_amount() : 1;
			msg += sprintf("%d份%s" ZJBR "(%d绑元):huishou %s" ZJSEP, amount, obj->query("name"), jiage(obj), obj->query("id"));
		}

		msg += "取消:look\n";
		tell_object(me, msg);
		return 1;
	}
	// 默认是string 需要后续转换成int
	if (sscanf(arg, "%s==%s", id_name, arg) == 2)
	{

		obj = present(id_name, me);
		amount = to_int(arg);
		if (amount < 1)
		{
			write("参数错误，请重新输入。\n");
			return 1;
		}

		if (!objectp(obj))
			return notify_fail("你没有该物品\n");

		if (obj->query_amount() < amount)
			return notify_fail("你好像没有那么多" + obj->query("name") + "\n");

		log_file("pay/huishou", ctime(time()) + "  " + me->query("name") + me->query("id") + "回收了" + chinese_number(amount) + "个" + obj->query("name") + "\n");

		me->add("bind_yuanbao", jiage(obj) * amount);
		obj->add_amount(-amount);

		write("你成功回收了该物品\n");
		return 1;
	}

	if (arg)
	{
		obj = present(arg, me);

		if (!objectp(obj))
			return notify_fail("你没有该物品\n");

		amount = obj->query_amount();

		if (amount)
			return notify_fail(INPUTTXT("你有" + amount + "份，请问你要回收多少份" + obj->query("name"), "huishou " + arg + "==$txt#") + "\n");

		me->add("bind_yuanbao", jiage(obj));
		log_file("pay/huishou", ctime(time()) + "  " + me->query("name") + me->query("id") + "回收了一个" + obj->query("name") + "\n");
		destruct(obj);
		write("你成功回收了该物品\n");
		return 1;
	}
	return 1;
}