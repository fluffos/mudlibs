// Room: /city/kedian.c

#include <room.h>

inherit CREATE_CHAT_ROOM;

void create()
{
	set("short", "醉仙客栈");
	set("long", @LONG
    这是扬州城内最负盛名的客栈，门前一块金匾上书「醉仙楼」三个大字，笔力遒劲，
气势恢宏。楼内雕梁画栋，富丽堂皇，处处透着江南水乡的精致典雅。店小二身着青衫，
手脚麻利地穿梭其间，招呼着四方来客。据传这里的主人乃是一位武林隐世高人，一身修
为已臻化境，江湖中人提起无不肃然起敬，但数十年来竟无一人见过其真容。
    楼中常有武林豪客落脚，觥筹交错之际，刀光剑影的江湖轶事不绝于耳。
LONG );
	set("no_fight", 1);
	set("valid_startroom", 1);
	set("no_sleep_room",1);
	set("item_desc", ([
		"【金匾】" : "楼上设有雅间，每夜十两白银。若要投宿，需付银两于店小二。\n"
		ZJOBACTS2+ZJMENUF(2,3,9,28)"投宿:give 10 silver to xiao er\n",
	]));
	set("objects", ([
		__DIR__"npc/xiaoer" : 1,
		"/adm/npc/shizhe" : 1,
	  
	]));
	// set("action_list", ([
	// 	"存盘":"save",
	// ]));
	set("exits", ([
		"west" : __DIR__"beidajie1",
		"east"   : __DIR__"kedian2",
		"north": __DIR__"liaotian",
		"south": __DIR__"minyong_chufang",
	]));

	setup();
}

void init()
{
	add_all_action();
}

int valid_leave(object me, string dir)
{

	if (me->query("new_player_quest/stage") < 2 && userp(me))

	{
		return notify_fail("江湖大使忙拦住你道：这位" + RANK_D->query_respect(me) + "，你还是把新手指引任务完成到第二步，然后先在我这里把礼包领取完了再走吧！\n");
	}

	if (! me->query_temp("rent_paid") && dir == "east")
		return notify_fail("店小二忙拦住你道：这位" + RANK_D->query_respect(me) + "，住店可要先付银两啊！\n");

	if (me->query_temp("rent_paid") && dir == "west")
		return notify_fail("店小二快步上前作揖道：" + RANK_D->query_respect(me) + "已经付了银两，还是先上楼歇息吧。\n");

	return ::valid_leave(me, dir);
}
