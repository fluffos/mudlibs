// Room: /city/beimen.c
#include <room.h>

inherit ROOM;

string look_gaoshi();

void create()
{
	set("short", "北城门");
	set("long", @LONG
这是扬州北城门，高大的城墙因为曾经的一场大火而留下了漆黑的痕迹，在斑驳的墙面上贴着一张醒目的白纸黑字官府告示。
城门外是连绵起伏的崇山峻岭，一条蜿蜒的黄土小径穿过山间，不知通往何方。城门两侧站着威武的官兵，目光如炬地巡视着来往的行人。
LONG );
	set("item_desc", ([
		"【告示】" : (:look_gaoshi:),
	]));
	set("exits", ([
		"south" : __DIR__"beidajie2",
		"north" : "/d/shaolin/yidao",
		"west"  : "/d/huanghe/caodi1",
	    "east" : "/d/city/postofficer",
	]));
	set("objects", ([
		"/kungfu/class/yunlong/ma" : 1,
		__DIR__"npc/wujiang" : 2,
		__DIR__"npc/bing" : 10,
	]));
	set("outdoors", "city");
	setup();
}

string look_gaoshi()
{
	return FINGER_D->get_killer() + "\n扬城巡检司\n巡检使王载\n";
}

