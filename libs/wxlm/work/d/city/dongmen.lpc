// Room: /city/dongmen.c
inherit ROOM;

string look_gaoshi();

void create()
{
	set("short", "东城门");
	set("long", @LONG
这是扬州东城门，高大的城墙上斑驳着岁月的痕迹，城门正上方刻着“东门”两个楷书大字，城墙上贴着几张
官府告示。一条宽阔的青石板大道横贯东西，向东通往郊外的田野，向西则是繁华的城区。城门两侧的卫兵神情严肃，警惕地注
视着来往的行人。
LONG );
	set("outdoors", "city");
	set("item_desc", ([
		"【告示】" : (: look_gaoshi :),
	]));
	set("exits", ([
		"east" : "/d/taishan/yidao",
		"north" : __DIR__"ml1",
		"south" : __DIR__"jiaowai1",
		"west" : __DIR__"dongdajie2",
	]));
	set("objects", ([
		__DIR__"npc/wujiang" : 1,
		__DIR__"npc/bing" : 2,
	]));

	setup();
}

string look_gaoshi()
{
	return FINGER_D->get_killer() + "\n扬城巡检司\n巡检使王载\n";
}

