// by luoyun_微笑
// JuYiTing.c


inherit ROOM;

void create()
{
	set("short", "传艺堂");
	seteuid(ROOT_UID);
	set("channel_id", "传艺堂");
	set("long", "这里是一处清幽雅致的阁楼，常有江湖前辈在此收徒授艺。阁内檀香袅袅，茶香四溢，正是武林中人结缘授徒的胜地。你可以在此寻访名师，或是收徒传艺，将武学薪火相传。");
	set("exits", ([
		"south" : __DIR__"shuyuan",
	]));
	set("action_list", ([
		"师徒面板":"new_shengxian",
	]));
	set("no_fight","1");
        set("no_sleep_room",1);
	setup();
}

void init()
{
	add_action("do_baishi","baishi");
	add_action("do_chushili","chushili");
	add_action("do_shoutu","shoutu");
	add_action("do_quzhu","quzhu");
	add_action("do_tuoli","tuoli");
	add_action("do_xunshi","xunshi");
	add_action("do_daoshizg","daoshizg");
}

int do_quzhu(string arg)
{
 int i,last_on;
 string *dizi,str;
	object ob,obj,me=this_player();
	mapping user;

	if(!arg)
	{
		if(!mapp(user=me->query("p_dizi")))
			return notify_fail("你尚未收徒。\n");
		dizi = sort_array(keys(user),1);
		if(!sizeof(dizi))
			return notify_fail("你尚未收徒。\n");
		str = ZJOBLONG"你座下有以下弟子，可点击逐出门墙：\n";
		str += ZJOBACTS2+ZJMENUF(2,2,6,30);
		for(i=0;i<sizeof(dizi);i++)
		{
			last_on = FINGER_D->get_last_on(dizi[i]);
			str += FINGER_D->get_name(dizi[i])+"（"HIG+dizi[i]+NOR"）"ZJBR"上次登录："ZJBR+CHINESE_D->chinese_date(last_on,2)+":quzhu "+dizi[i]+ZJSEP;
		}
		tell_object(me,str+"\n");
		return 1;
	}

	if(sscanf(arg,"%s yes",arg)!=1)
	{
		if(!FINGER_D->get_name(arg))
			return notify_fail("你要逐出何人？\n");
		tell_object(me,ZJOBLONG"你当真要将"+FINGER_D->get_name(arg)+"逐出师门？\n"ZJOBACTS2"确定:quzhu "+arg+" yes\n");
		return 1;
	}

	if(!objectp(obj=find_player(arg)))
	{
		ob = new(LOGIN_OB);
		ob->set("id",arg);
		ob->set("body", USER_OB);
		obj = LOGIN_D->make_body(ob);
		destruct(ob);
		if(obj->restore())
		{
			obj->setup();
			if(!me->query("p_dizi/"+obj->query("id")))
			{
				tell_object(me,"此人并非你的弟子！\n");
			}
			else
			{
				obj->delete("p_master");
				obj->delete("zjvip/master");
				obj->save();
				me->delete("p_dizi/"+obj->query("id"));
				me->save();
				tell_object(me,HIR"你已将"+obj->query("name")+"("+obj->query("id")+")"+"逐出师门！"NOR"\n");
			}
		}else
			tell_object(me,"玩家数据错误！\n");

		destruct(obj);
	}
	else
	{
		if(!me->query("p_dizi/"+obj->query("id")))
		{
			tell_object(me,"此人并非你的弟子！\n");
		}
		else
		{
			obj->delete("p_master");
			obj->delete("zjvip/master");
			obj->save();
			me->delete("p_dizi/"+obj->query("id"));
			me->save();
			tell_object(me,HIR"你已将"+obj->query("name")+"("+obj->query("id")+")"+"逐出师门！"NOR"\n");
			tell_object(obj,HIR+me->query("name")+"("+obj->query("id")+")"+"将你逐出师门！"NOR"\n");
		}
	}

	return 1;
}

int do_tuoli(string arg)
{
 
 string str;
	object ob,obj,me=this_player();
 

	if(!stringp(str=me->query("p_master/id")))
	{
		if(!stringp(str=me->query("zjvip/master")))
		{
			tell_object(me,"你并未拜师，何来脱离之说？\n");
			return 1;
		}
	}

	if(arg!="yes")
	{
		tell_object(me,ZJOBLONG"你当真要与"+FINGER_D->get_name(str)+"断绝师徒之情？\n"ZJOBACTS2"确定:tuoli yes\n");
		return 1;
	}

	if(!stringp(me->query("p_master/id")))
	{
		me->delete("zjvip/master");
		tell_object(me,"从今往后，你与"+FINGER_D->get_name(str)+"再无师徒之情。\n");
		return 1;
	}

	if(!objectp(obj=find_player(str)))
	{
		ob = new(LOGIN_OB);
		ob->set("id",str);
		ob->set("body", USER_OB);
		obj = LOGIN_D->make_body(ob);
		destruct(ob);
		if(obj->restore())
		{
			obj->setup();
			if(me->query("p_master/id")!=obj->query("id"))
			{
				tell_object(me,"此人并非你的师父！\n");
			}
			else
			{
				obj->delete("p_dizi/"+me->query("id"));
				obj->save();
				me->delete("p_master");
				me->delete("zjvip/master");
				me->save();
				tell_object(me,HIR"你与"+obj->query("name")+"("+obj->query("id")+")"+"恩断义绝！"NOR"\n");
			}
		}else
			tell_object(me,"玩家数据错误！\n");

		destruct(obj);
	}
	else
	{
		if(me->query("p_master/id")!=obj->query("id"))
		{
			tell_object(me,"此人并非你的师父！\n");
		}
		else
		{
			me->delete("p_master");
			me->delete("zjvip/master");
			me->save();
			obj->delete("p_dizi/"+me->query("id"));
			obj->save();
			tell_object(me,HIR"你与"+obj->query("name")+"("+obj->query("id")+")"+"恩断义绝！"NOR"\n");
			tell_object(obj,HIR+me->query("name")+"("+obj->query("id")+")"+"与你恩断义绝！"NOR"\n");
		}
	}

	return 1;
}

int do_xunshi(string arg)
{
	string *str,strs,zige;
	int i,j,ye,yeall;
	object ob,*ob_list;

	if(!arg) arg = "1";
	str = ({});
	if( sscanf(arg, "%d", ye)==1)
	{
		ob_list = users();
		ob_list = sort_array(users(), "sort_user", this_object());
		for(i=0; i<sizeof(ob_list); i++)
		{
			ob = ob_list[i];
			if(ob->is_character()&&ob->query("zjvip/daoshizg"))
			{
				if(ob->query("zjvip/daoshizg")>5)
					zige = "武林泰斗";
				else if(ob->query("zjvip/daoshizg")==5)
					zige = "德高望重";
				else if(ob->query("zjvip/daoshizg")==4)
					zige = "名满江湖";
				else if(ob->query("zjvip/daoshizg")==3)
					zige = "桃李满门";
				else if(ob->query("zjvip/daoshizg")==2)
					zige = "武学宗师";
				else if(ob->query("zjvip/daoshizg")==1)
					zige = "江湖前辈";
				str += ({sprintf("%s　%s:baishi %s",zige,ob->query("name"),ob->query("id"))});
			}
		}

		if(!sizeof(str))
			write("目前无"HIY"武林前辈"NOR"在此。\n");
		else
		{
			strs = ZJOBLONG"现有以下高人在此收徒：\n";

			strs += ZJOBACTS2+ZJMENUF(2,2,9,30);

			yeall = sizeof(str)/10;
			if(sizeof(str)%10) yeall += 1;
			if(ye<1) ye = 1;
			if(ye>yeall) ye = yeall;
			j = (ye-1)*10;
			i = ye*10;
			if (i >= sizeof(str)) i = sizeof(str);
			i--;
			if(yeall>1)
				strs += "上一页:xunshi "+(ye-1)+ZJSEP"下一页:xunshi "+(ye+1)+ZJSEP;
			strs += implode(str[j..i], ZJSEP);
			write(strs+"\n");
		}
	}
}

int sort_user(object ob1, object ob2)
{
	if(ob2->query("zjvip/daoshizg")==ob1->query("zjvip/daoshizg"))
		return ob2->query("combat_exp") - ob1->query("combat_exp");
	else 
		return ob2->query("zjvip/daoshizg") - ob1->query("zjvip/daoshizg");
}

int do_daoshizg()
{
 
	string *dizi;
	string *dszg = ({HIW"江湖前辈"NOR,HIG"武学宗师"NOR,HIB"桃李满门"NOR,HIM"名满江湖"NOR,HIY"德高望重"NOR,HIR"武林泰斗"NOR});
	object me=this_player();

	if(me->query("combat_exp")<1000000)
		return notify_fail("你尚需历练，暂不足以收徒授艺。\n需有"HIB"百万经验"NOR"方可收徒。\n");
	if(!me->query("zjvip/daoshizg"))
	{
		me->set("zjvip/daoshizg",1);
		return notify_fail("恭喜，你已获得收徒资格。\n你现为"HIW"【江湖前辈】"NOR"！\n");
	}
	else if(me->query("zjvip/daoshi_exp")>49&&me->query("zjvip/daoshizg")<6&&!me->query("p_master"))
	{
		me->set("zjvip/daoshizg",6);
		return notify_fail("恭喜，你晋升为"HIM"【武林泰斗】"NOR"！\n");
	}
	else if(me->query("zjvip/daoshi_exp")>19&&me->query("zjvip/daoshizg")<5&&!me->query("p_master"))
	{
		me->set("zjvip/daoshizg",5);
		return notify_fail("恭喜，你晋升为"HIM"【德高望重】"NOR"！\n");
	}
	else if(me->query("zjvip/daoshi_exp")>9&&me->query("zjvip/daoshizg")<4&&!me->query("p_master"))
	{
		me->set("zjvip/daoshizg",4);
		return notify_fail("恭喜，你晋升为"HIM"【名满江湖】"NOR"！\n");
	}
	else if(me->query("zjvip/daoshi_exp")>4&&me->query("zjvip/daoshizg")<3&&!me->query("p_master"))
	{
		me->set("zjvip/daoshizg",3);
		return notify_fail("恭喜，你晋升为"HIB"【桃李满门】"NOR"！\n");
	}
	else if(me->query("zjvip/daoshi_exp")>2&&me->query("zjvip/daoshizg")<2 && !me->query("p_master"))
	{
		me->set("zjvip/daoshizg",2);
		return notify_fail("恭喜，你晋升为"HIG"【武学宗师】"NOR"！\n");
	}
	else
	{
		if(!me->query("p_dizi"))
		{
			return notify_fail("你现为"+dszg[me->query("zjvip/daoshizg")-1]+"，尚未收徒。\n");
		}
		dizi = keys(me->query("p_dizi"));
		return notify_fail("你现为"+dszg[me->query("zjvip/daoshizg")-1]+"，座下有"+sizeof(dizi)+"位弟子。\n");
	}
}

int do_baishi(string arg)
{
 
 
	object ob,me=this_player();
 

	if(!arg)
		return notify_fail("你想拜谁为师？\n");
	else if(!(ob = find_player(arg)))
		return notify_fail("阁内并无此人。\n");
	else if(ob==me)
		return notify_fail("自己拜自己为师？痴人说梦！\n");
	else if(me->query("p_master"))
		return notify_fail("你已有师承，岂可另投他人？\n");
	else if(me->query("zjvip/out_master"))
		return notify_fail("你已出师，何需再拜师父？\n");

	if(!ob->query("zjvip/daoshizg"))
	{
		return notify_fail("此人修为尚浅，不足为师。\n");
	}
	else if(me->query("zjvip/daoshizg"))
	{
		return notify_fail("你已是一方高手，何需拜师？\n");
	}
	else if(me->query("combat_exp")>2000000)
	{
		return notify_fail("以你的修为，已可收徒授艺，何不自立门户？\n");
	}
	else
	{
		me->set_temp("baishi",ob);
		if(environment(ob)!=this_object())
		{
			tell_object(ob,popup_comb(me->query("name")+"("+me->query("id")+")欲拜入门下，还请速至传艺堂定夺。"));
			return notify_fail("拜师请求已发出，还请等候恩师回复。若得应允，需待恩师到此方可行拜师之礼。\n");
		}
		else
		{
			tell_object(ob,popup_comb(me->query("name")+"("+me->query("id")+")欲拜入门下，还请定夺。","收徒确认:shoutu "+me->query("id")));
			return notify_fail("拜师请求已发出，还请等候恩师回复。\n");
		}
	}
	return 1;
}

int do_chushili()
{
 
 
 object ob,ob1,me=this_player();

	return notify_fail("暂不开放出师功能。\n");	
 

	if(me->query("combat_exp")<1000000 && me->query("max_neili") > 2000)
		return notify_fail("你功力未足，尚不能出师（需百万经验，两千内力）。\n");
	else if(me->query("zjvip/out_master"))
		return notify_fail("你已出师，何需再行此礼？\n");
	else if(!me->query("p_master"))
		return notify_fail("你并无师承，如何出师？\n");
	else if(!(ob=UPDATE_D->global_find_player(me->query("p_master/id"))))
	{
		return notify_fail("你师承何人？\n");
	}
	else
	{
		me->delete("p_master");
		ob->delete("p_dizi/"+me->query("id"));
		ob->add("zjvip/daoshi_exp",1);
		if(!me->query("zjvip/out_master"))
		{
			ob1 = new("/clone/shizhe/masterbox");
                        ob1->move(me);
			tell_object(me,"恭喜出师，获得一个"HIM"出师礼包"NOR"！\n");
			me->add("zjvip/out_master",1);
		}
		CHANNEL_D->do_channel(me,"chat","多谢恩师"+ob->query("name")+"教诲之恩，今日弟子"+me->query("name")+"在此行出师大礼！");
	}
	return 1;
}

int do_shoutu(string arg)
{
 
	string *dizi;
 object ob,me=this_player();
 

	if(!arg)
		return notify_fail("你要收谁为徒？\n");
	else if(!(ob = find_player(arg)))
		return notify_fail("阁内并无此人。\n");
	else if(ob==me)
		return notify_fail("自收自为徒？荒谬之极！\n");

	if(me->query("p_master"))
		return notify_fail("你尚未出师，如何收徒？\n");

	if(me->query("p_dizi"))
	{
		dizi = keys(me->query("p_dizi"));
	}

	if(ob->query_temp("baishi")!=me)
	{
		return notify_fail("此人并未向你求艺，何谈收徒？\n");
	}
	if (sizeof(dizi) >= 5)
	{
		return notify_fail("你座下弟子已满（最多五人），还是专心教导现有弟子为好。\n");
	}
	else if(sizeof(dizi)&&member_array(ob->query("id"),dizi)!=-1)
	{
		return notify_fail(ob->query("name")+"已是你的弟子！\n");
	}
	else
	{
		ob->delete_temp("baishi");
		if(environment(ob)==this_object())
		{

			ob->set("p_master/name",me->query("name"));
			ob->set("p_master/id",me->query("id"));
			ob->set("p_master/qinmi",1);
			me->set("p_dizi/"+ob->query("id")+"/name",ob->query("name"));
			me->set("p_dizi/"+ob->query("id")+"/qinmi",1);
			if(!ob->query("baishi_times"))
			{
				tell_object(ob,"拜师成功！还请速向师父求教江湖经验，讨要装备！\n");
			}
			else
				tell_object(ob,"拜师成功！还请多向师父讨教！\n");
			ob->add("baishi_times",1);
			ob->set("zjvip/master",me->query("id"));
			CHANNEL_D->do_channel(me,"chat","pat "+ob->query("id"),1);
			CHANNEL_D->do_channel(this_object(),"chat","恭贺"HIM+me->query("name")+"收"+ob->query("name")+"为徒"NOR"，望"+ob->query("name")+"勤学苦练，早日扬名江湖！");
			return notify_fail("又得一佳徒，还望多加指点，助其早日成才。\n");
		}
		else
		{
			tell_object(ob,"拜师失败，你已离开传艺堂！\n");
			return notify_fail("收徒失败，对方已不在此处。\n");
		}
	}
	return 1;
}