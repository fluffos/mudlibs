// jianghu.c 江湖恶霸

inherit NPC;

void create()
{
	set_name("江湖恶霸", ({ "jianghu eba", "eba" }));
	set("gender", "男性");
	set("age", 25);
	set("long", "此人身形魁梧，面带横肉，一双三角眼透着凶光。\n"
		"腰间别着一把短刀，一看就知不是善类。\n"
		"平日里仗势欺人，横行乡里，是附近一带的地头蛇。\n");
	
	set("combat_exp", 1000);
	set("shen_type", -1);

	set("attitude", "aggressive");
	
	set_skill("unarmed", 20);
	set_skill("dodge", 20);
	set_skill("blade", 20);
	set_temp("apply/attack", 10);
	set_temp("apply/defense", 10);

	//设置气血为 100
	set("max_qi",100);

	//设定可以被刷新
	set("is_refreshable", 1);

	setup();
	carry_object("/clone/misc/cloth")->wear();
	carry_object("/clone/weapon/blade")->wield();
	add_money("silver",2);
}
