// zhu.c 朱熹 - 南宋大儒，理学集大成者

inherit NPC;
inherit F_DEALER;

string ask_job();
int do_answer();

void create()
{
	set_name("朱熹", ({ "zhu xi" }));
	set("long", "只见这位老者身着青衫儒袍，面容清癯，双目炯炯有神。\n"
		    "他便是当世大儒朱熹，集理学之大成，学富五车，桃李满天下。\n"
		    "据说他精研四书五经数十载，对儒家经典有着极深的造诣。\n");
	set("gender", "男性");
	set("age", 65);
	set("no_get", 1);
	set_skill("literate", 500);
	set("teacher", 1);
	set_skill("unarmed", 80);
	set_skill("dodge", 80);
	set_skill("parry", 80);
	set_temp("apply/attack", 80);
	set_temp("apply/defense", 80);
	set_temp("apply/damage", 20);

	set("combat_exp", 400000);
	set("shen_type", 1);
	set("inquiry", ([
		"买书" : (: do_answer :),
		"抄书" : (: ask_job :),
		"借书" : "书籍珍贵，岂可轻易借出。若要研读，还请就在此处。",
	]));
	set("vendor_goods", ({
		"/clone/book/lbook1",
		"/clone/book/lbook2",
		"/clone/book/lbook3"
	}));
	setup();

	set("chat_chance", 1);
	set("chat_msg", ({
		"朱熹捋须沉吟道：「普天之下，莫非王土；率土之滨，莫非王臣。」\n",
		"朱熹凝神思索道：「出家人，小过损益焉；无妄大过，未济咸困之。」\n",
		"朱熹正色言道：「大学之道，在明明德，在亲民，在止于至善。」\n",
		"朱熹慨然叹道：「格物致知，诚意正心，修身齐家，治国平天下。」\n",
	}) );
}

void init()
{
	add_action("do_list", "list");
	add_action("do_buy", "buy");
}

int do_answer()
{
	::do_list();
	write(name() + HIR"含笑道：「这些都是精选的善本，价值连城啊。」"NOR"\n");
	return 1;
}

int recognize_apprentice(object ob)
{
	if (ob->query_temp("mark/朱") < 1)
		return 0;

	ob->add_temp("mark/朱", -1);
	return 1;
}

int accept_object(object who, object ob)
{
	if (! who->query_temp("mark/朱"))
		who->set_temp("mark/朱", 0);

	if (ob->query("money_id") && ob->value() >= 2000)
	{
		message_vision("朱熹欣然道：「既蒙厚赐，某当竭力指点$N读书写字之道。」\n", who);
		who->add_temp("mark/朱", ob->value() / 50);
		destruct(ob);
		return 1;
	}

	command("say 求学问道，需得诚心。学规有定，至少需备二十两白银。");
	return 0;
}

string ask_job()
{
	object me;

	me = this_player();
	if (me->query("afk/file")=="chaoshu")
		return "先前交代的书册可曾抄完？";

	if (me->query_temp("pending/afk")||me->query("afk"))
		return "你现下不是正有要事在身么？";

	if (me->query("qi") < 20)
		return "我观阁下气色不佳，还是先去调养休息为上，莫要伤了身子。";

	if (! interactive(me))
		return "...";

	me->delete("afk");
	me->set("afk/file","chaoshu");
	me->set("afk/room",environment(me));
	return "甚好！文房四宝俱在，请即开始誊抄吧。";
}