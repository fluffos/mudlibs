// bing.c 官兵

inherit NPC;
// inherit AI_NPC;
void create()
{
	set_name("城门卫兵", ({ "cheng men wei bing", "bing" }));
	set("age", 22);
	set("gender", "男性");
	set("long", "这是一位身着锦衣的朝廷官兵，腰悬钢刀，目光如炬。\n"
		"虽然武艺平平，但仗着人多势众，也是江湖上不可小觑的一股力量。\n");
	set("attitude", "peaceful");

	set("str", 24);
	set("dex", 16); 
	set("combat_exp", 10000);
	set("shen_type", 1);

	set_skill("unarmed", 40);
	set_skill("dodge", 40);
	set_skill("parry", 40);
	set_skill("blade", 40);
	set_skill("force", 40);
	set_temp("apply/attack", 40);
	set_temp("apply/defense", 40);
	set_temp("apply/damage", 20);
	set_temp("apply/armor", 40);

	//设定可以被刷新
	set("is_refreshable", 1);

	set("chat_chance_combat", 10);
	set("chat_msg_combat", ({
		"官兵怒喝道：大胆狂徒，胆敢冒犯朝廷命官！\n",
		"官兵厉声道：你这等宵小之辈，今日定要将你拿下！\n",
		"官兵大声道：众兄弟，结阵！莫让这贼子跑了！\n"
	}));
	setup();
	carry_object("/clone/weapon/blade")->wield();
	carry_object("/clone/cloth/junfu")->wear();
}

void init()
{
	object ob;
	::init();
	if (interactive(ob = this_player()) && 
		(int)ob->query_condition("killer")) {
		remove_call_out("kill_ob");
		call_out("kill_ob", 1, ob);
	}
}

int accept_fight(object me)
{
	command("say 狂徒休得猖狂，今日我便替天行道，取你性命！\n");
	kill_ob(me);
	return 1;
}
