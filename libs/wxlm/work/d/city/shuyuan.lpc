// Room: /d/city/shuyuan.c

inherit ROOM;

void create()
{
	set("short", "白鹿书院");
	set("long", @LONG
这里是白鹿书院的主讲堂，古朴典雅，肃穆庄严。堂内檀香袅袅，书声琅琅。
一位仙风道骨的老者端坐在雕花太师椅上，正是当世大儒朱熹先生。他面容清癯，
双目炯炯有神，正在为众学子讲解四书五经的精妙之处。两侧分坐着数十名求学
的学子，个个神情专注，聚精会神。朱先生身前是一张古香古色的红木书案，案
上摆放着几本翻开的线装古籍。身后的楠木书架上整齐地摆放着浩如烟
海的典籍。堂内四壁悬挂着历代名家手书的楹联石刻，字字珠玑，尽显书院千年
底蕴。左壁上镶嵌着一块青石匾额，上书学规二字。
LONG );
	set("item_desc", ([ /* sizeof() == 1 */
		"【学规】": "

  晨读经典三遍，日览史书数页。
  明察世事万千，精研诗文歌赋。
  研墨执笔勤练，按时交付功课。
  夜读莫贪安眠，疑难必求甚解。

  求学需缴学费纹银二十两。\n"
ZJOBACTS2+ZJMENUF(3,3,9,28)"求学:give 20 silver to zhu xi\n",
	]));

	set("no_fight", 1);
	set("no_sleep_room", 1);

	set("exits", ([ /* sizeof() == 2 */
		"up"    : __DIR__"shuyuan2",
		"south" : __DIR__"dongdajie1",
		"north" : __DIR__"shengxiantang",
		"southwest":__DIR__"guangchang",
	]));

	set("objects", ([ /* sizeof() == 1 */
		__DIR__"npc/zhu" : 1,
	]));

	setup();
}
