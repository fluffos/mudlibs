// banghui.c

inherit ROOM;

void create()
{
	set("short", "聚义厅");
	set("long", "江湖豪杰相会于此。在这里你可以聚集好友组队创建自己的帮会，大家一起共闯江湖。");
	set("exits", ([
		"east" : __DIR__"qianzhuang",
	]));

	set("action_list", ([
		HIG"建立帮会"NOR:"new_banghui create",
		HIG"查看帮会"NOR:"new_banghui",
	]));
	set("no_fight","1");
	setup();
}

