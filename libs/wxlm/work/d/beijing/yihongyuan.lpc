inherit ROOM;

void create()
{
	set("short", "丽红院");
	set("long", @LONG
你一走进来，发现这是一间装饰华丽的大厅。厅内张灯结彩，处处飘散着
淡淡的香气。几位身着艳丽的女子正在厅内来回走动。一位年长的妇人笑脸相
迎，热情地招呼着客人。隐约能听到楼上传来的说笑声和音乐声。
LONG );
	set("exits", ([
		"west" : __DIR__"wang_8",
	]));

	set("objects", ([
		__DIR__"npc/laobaopo" : 1,
		__DIR__"npc/piaoke" : 1,
		__DIR__"npc/jinv" : 2,
	]));

	setup();
}

