// Room: /d/taishan/.c
inherit ROOM;

void create()
{
	set("short", "日观峰");
	set("long", @LONG
这里是位于南天户西面的山岭，怪石攒簇，最高的地方一石
卓立，名为君子峰。往北走便是泰山的西天户。

日观峰是泰山观赏落日的绝佳位置，相传古往今来多少武学大家
都曾在此观日悟道。落日余晖映照山峰，天地之势尽收眼底，令人胸
怀开阔，灵台清明。据说有缘者在此观落日，能突破三花聚顶之境，
使精、气、神三花汇聚于顶，从而达到更高的武学造诣。
LONG );
	set("exits", ([
		"westup" : __DIR__"yuhuang",
		"eastup" : __DIR__"tanhai",
	]));
	set("objects", ([
		__DIR__"npc/tianmen" : 1,
	]));
	set("action_list", ([
		"观落日":"watch_sunset",
	]));
	set("no_clean_up", 0);
	setup();
}

int do_watch_sunset(string arg)
{
	object me = this_player();
	mixed *local;
	int stage;
	
	local = localtime(time());
	stage = me->query_temp("watch_sunset_stage") || 0;
	
	if (me->query("sanhua_done"))
	{
		tell_object(me, "你已经领悟了三花聚顶的境界，再观落日也无法更进一步。\n");
		return 1;
	}

	// MERIDIAN_D->query_meridian_count(me) 必须打通至少6条奇经
	if (MERIDIAN_D->query_meridian_count(me) < 6)
	{
		tell_object(me, "你的经脉如此僝弱，无法突破三花聚顶的境界。\n");
		return 1;
	}
	
	if (local[2] < 17 || local[2] > 19)
	{
		tell_object(me, "现在不是观落日的最佳时机，还是等傍晚时分(17:00-19:00)再来吧。\n");
		return 1;
	}
	
	if (me->query("max_qi") < 50000)
	{
		tell_object(me, "你的气血修为不足5万，无法突破三花聚顶的境界。\n");
		return 1;
	}

	if (me->query("max_neili") < 30000)
	{
		tell_object(me, "你的内力修为不足3万，无法突破三花聚顶的境界。\n"); 
		return 1;
	}

	if (me->query("max_jing") < 30000)
	{
		tell_object(me, "你的精神修为不足3万，无法突破三花聚顶的境界。\n");
		return 1;
	}
	
	if (me->query_skill("force", 1) < 600 ||
		me->query_skill("dodge", 1) < 600 ||
		me->query_skill("parry", 1) < 600)
	{
		tell_object(me, "你的基本功夫火候未到，尚无法突破三花聚顶的境界。\n");
		return 1;
	}
	
	if (me->is_busy())
	{
		tell_object(me, "你现在正忙着呢。\n");
		return 1;
	}
	
	if (me->is_fighting())
	{
		tell_object(me, "你正在战斗中，无法静心观日。\n");
		return 1;
	}
	
	switch(stage)
	{
		case 0:
			message_vision(HIY "$N盘膝而坐，凝神观看落日，渐渐进入忘我之境。\n" NOR, me);
			tell_object(me, HIC "你凝视着落日，渐渐排除杂念，心神逐渐宁静。\n" NOR);
			me->set_temp("watch_sunset_stage", 1);
			me->start_busy(3);
			break;
			
		case 1:
			message_vision(HIY "$N心神澄澈，浑身毛孔舒张，隐约感觉到精、气、神三花的存在。\n" NOR, me);
			tell_object(me, MAG "你感受到体内精、气、神三花开始缓缓升腾。\n" NOR);
			me->set_temp("watch_sunset_stage", 2);
			me->start_busy(3);
			break;
			
		case 2:
			message_vision(HIY "$N周身真气流转，三花渐次升起，逐渐向头顶凝聚。\n" NOR, me);
			tell_object(me, HIM "你感觉三花即将在顶门汇聚，心中若有所悟。\n" NOR);
			me->set_temp("watch_sunset_stage", 3);
			me->start_busy(3);
			break;
			
		case 3:
			message_vision(HIW "落日余晖映照在$N身上，只见$N头顶三花聚顶，精气神三花交相辉映！\n" NOR, me);
			message_vision(HIM "$N福至心灵，终于突破了传说中的三花聚顶之境！\n" NOR, me);
			
			tell_object(me, HIR "你只觉灵台清明，精气神三花合一，武学感悟有了质的飞跃！\n" NOR);
			tell_object(me, HIG "你的天赋点上升了十点！\n" NOR);
			
			me->add("tianfu_point", 10);
			me->set("sanhua_done", 1);

			// 记录成就武尊时的年龄
			me->set("sanhua_age", me->query("age"));

			me->delete_temp("watch_sunset_stage");
			me->start_busy(5);
			CHAR_D->setup_char(me);
			break;
	}
	return 1;
}

void init()
{
	add_action("do_watch_sunset", "watch_sunset");
}

