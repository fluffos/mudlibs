// Room: /d/taishan/.c
inherit ROOM;

void create()
{
	set("short", "月观峰");
	set("long", @LONG
这里是位于南天户西面的山岭，怪石攒簇，最高的地方一石卓立，
名为君子峰。往北走便是泰山的西天户。西边是太玄山，那里是中级
武者切磋的好去处。
LONG );
	set("exits", ([
		"east" : __DIR__"nantian",
		"northup" : __DIR__"xitian",
		"west" : __DIR__"taixuan_shan",
	]));
	set("out_room","/d/city/guangchang");
	set("no_clean_up", 0);
	set("outdoors", "taishan");
	setup();
}

int valid_leave(object me, string dir)
{
    int level;
    
    if (!me || !living(me))
        return 0;
        
    level = me->query("level");
    if (dir == "west" && (level < 200 || level > 300))
    {
        return notify_fail("太玄山只允许200-300级的玩家进入。\n");
    }
    
    return ::valid_leave(me, dir);
}

