// jiang 江百胜



inherit NPC;

void create()
{
	seteuid(getuid());

	set_name("江百胜", ({ "jiang baisheng", "jiang", "baisheng" }) );
	set("gender", "男性" );
	set("age", 30);
	set("long", "他是血刀门的弃徒，但其刀法已臻化境，登峰造极，在武尊之下堪称第一人。\n"
		    "即便脱离血刀门，他的刀法反而更上一层楼，独创出一套惊世骇俗的杀招。\n");
	set("attitude", "heroism");
	set("generation",0);
	set("winner","none");

	set("str", 110);
	set("con", 45);
	set("int", 45);
	set("dex", 45);

	set("max_qi", 2000000);
	set("eff_qi", 2000000);
	set("qi", 2000000);
	set("max_jing", 2000000);
	set("jing", 2000000);
	set("neili", 50000);
	set("max_neili", 50000);
	set("jiali", 30);
	set("shen_type", 0);

	set("no_clean_up",1);
	set("combat_exp", 50000);

	set("skill_aoyi/血海翻腾",10);

    set_skill("lamaism", 800);
    set_skill("literate", 180);
    set_skill("force", 800);
    set_skill("parry", 800);
    set_skill("blade", 800);
    set_skill("xue-dao", 800);
    set_skill("sword", 800);
    set_skill("mingwang-jian", 800);
    set_skill("dodge", 800);
    set_skill("mizong-neigong", 800);
    set_skill("xuehai-mogong", 800);
    set_skill("shenkong-xing", 800);
    set_skill("hand", 800);
    set_skill("dashou-yin", 800);
    set_skill("cuff", 800);
    set_skill("yujiamu-quan", 800);

	map_skill("force", "xuehai-mogong");
	map_skill("dodge", "shenkong-xing");
	map_skill("hand", "dashou-yin");
	map_skill("cuff", "yujiamu-quan");
	map_skill("parry", "xue-dao");
	map_skill("blade", "xue-dao");
	map_skill("sword", "mingwang-jian");

	set("chat_chance_combat", 120);
	set("chat_msg_combat", ({
		(: perform_action, "blade.shendao" :),
		(: perform_action, "blade.xueyu" :),
		(: perform_action, "blade.huan" :),
		(: perform_action, "blade.shi" :),
		(: exert_function, "powerup" :),
		(: exert_function, "recover" :),
	}));

	set_temp("break_damage",50000);


	set("fight_times", 0);	

	setup();
	carry_object("/clone/weapon/blade")->wield();
}

void die(object player)
{
    object killer;
    string msg;
    
	if (!objectp(player))
	{
		if (undefinedp(player) || !objectp(player))
		{
			killer = player->query_last_damage_from();
		}
	}
    else
    {
        killer = player;
    }

	if (!objectp(killer))
	{
		::die();
		return;
	}
	else
	{
		CHANNEL_D->do_channel(this_object(), "rumor", "惊闻" + killer->name() + "于泰山之巅，以无双武艺击败刀法大宗师江百胜，强势登顶日观峰！江湖沸腾，武林震怖，众豪杰无不叹服，共尊其为无敌宗师！");
		killer->set("game_chengjiu/无敌宗师",1);
	}

    message_vision(msg + "\n", this_object(), killer);

    ::die(killer);
}
