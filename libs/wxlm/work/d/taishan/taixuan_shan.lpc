inherit ROOM;

void create()
{
    set("short", HIW"太玄山"NOR);
    set("long", @LONG
这里是泰山的太玄山，是中级武者切磋的圣地。山势雄伟，云雾缭绕，
四周怪石嶙峋，古木参天。不时可以看到武者在此切磋武艺，交流心得。
墙上挂着一块醒目的石碑。
LONG );

    set("item_desc", ([
        "【石碑】" : "中级武者切磋场所，仅供200-300级的玩家切磋。\n"
    ]));
	set("out_room","/d/city/guangchang");
    set("exits", ([
        "east" : __DIR__"yueguan",
    ]));


    set("no_steal", 1);
    set("no_sleep_room", 1);

    setup();
}
