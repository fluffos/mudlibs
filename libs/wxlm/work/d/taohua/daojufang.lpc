inherit ROOM;

void create()
{
	set("short", "道具房");
	set("long", @LONG
这是一间道具房。摆着一些桃花弟子们常用的东西。房里好象黑
乎乎的，靠窗处有一张斑驳长桌和一把靠背椅，虽是白天还点着小油
灯。哑仆看到你进来，就使劲瞪着你，虽然口不能言，可你还是心中
惴惴。
LONG );
	set("exits", ([
		"west" : __DIR__"dating",
		"up"   : __DIR__"shufang",
	]));
	set("objects", ([
		__DIR__"npc/yapu"  : 2,
		__DIR__"obj/xiang" : 1,
		__DIR__"obj/zhuxiao" : 1,
	]) );

	set("action_list", ([
		HIC"取竹箫"NOR : "get_zhuxiao",
	]));
	setup();
}

void init()
{
	add_action("do_get_zhuxiao", "get_zhuxiao");
}

int do_get_zhuxiao(string arg)
{
	object me = this_player();
	object zhuxiao;

	if (!arg || arg != "zhuxiao")
	{
		return notify_fail("你要获得什么？\n");
	}

	if (present("zhuxiao", me))
	{
		return notify_fail("你已经有一个竹箫了。\n");
	}

	zhuxiao = new(__DIR__"obj/zhuxiao");
	if (!zhuxiao)
	{
		return notify_fail("对不起，竹箫暂时不可用。\n");
	}

	if (zhuxiao->move(me))
	{
		message_vision("$N从道具房里拿了一个竹箫。\n", me);
		return 1;
	}
	else
	{
		destruct(zhuxiao);
		return notify_fail("你无法携带更多的东西了。\n");
	}
}
