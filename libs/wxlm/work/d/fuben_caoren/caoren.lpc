inherit NPC;

string *dan_list = ({
	"/clone/vip/dan_dex",
	"/clone/vip/dan_int",
	"/clone/vip/dan_con",
	"/clone/vip/dan_str",
	});

	// 机关木人：这些木制的战士由精密的机关控制，虽然动作略显僵硬，但它们的每一次攻击都充满了力量。
	// 机关木人的身上绘有各种阵法图案，这些图案在激活时会发出微光，增强木人的战斗力。
	// 它们通常手持木剑，身着布甲，对于初入江湖的少侠来说，是一个不错的练手对象。

	// 铁甲木人：与机关木人相比，铁甲木人更为强大。
	// 它们的身体由坚硬的木材和铁片制成，行动时发出铿锵的声音。铁甲木人的眼神中没有生气，但它们的每一次挥击都足以让少侠们感受到压力。
	// 这些木人的铁甲上刻有复杂的纹路，似乎蕴含着某种神秘的力量，能够抵御更强的攻击。铁甲木人是木剑砺锋副本中的精英守卫，只有真正掌握了武学精髓的少侠才能击败它们。


mapping name_list = ([
	"机关木人" : "jiguan",
	"铁甲木人" : "tiejia",
]);

mapping desc_list = ([
	"jiguan" : "这是一具由名匠精心打造的机关木人，通体由上好的楠木制成，表面光滑细腻，关节处装有精密的机关装置。\n"
	           "它的动作虽然略显僵硬，但每一招一式都蕴含着纯正的武学要义，招式虽简单却不失威力。\n"
	           "木人的眼睛由两颗黑色玉石制成，在阳光下闪烁着冰冷的光芒，仿佛能看透对手的破绽。\n"
	           "它手持一柄木剑，剑身上刻有细密的符文，据说是古代武学大师留下的心法口诀。\n"
	           "对于初入江湖的武者来说，这是一个不错的练手对象。",
	           
	"tiejia" : "这具铁甲木人比普通机关木人更为高大威猛，通体由坚硬的乌木和精钢打造而成。\n"
	           "它全身覆盖着一层精铁铸就的甲胄，上面刻有繁复的符文和阵法，在阳光下泛着冷冽的金属光泽。\n"
	           "铁甲木人行动时发出铿锵有力的金属碰撞声，每一步都沉稳有力，给人一种不可撼动的压迫感。\n"
	           "它的双眼由红色宝石制成，在光线下闪烁着摄人心魄的光芒，仿佛能看穿对手的心思。\n"
	           "铁甲木人手持一柄厚重的铁剑，剑身上铭刻着古老的战斗符文，挥舞时带着呼啸的风声。\n"
	           "只有真正掌握了武学精髓的武者，才能从容应对这种强大的对手。",
]);

// 铁甲的血量是机关的两倍
// 铁甲的技能等级是机关的1.5倍
void create()
{

	string name, id, desc;

	name = keys(name_list)[random(sizeof(name_list))];

	id = name_list[name];

	desc = desc_list[id];

	set_name(name, ({id}));
	set("long", desc);

	set("combat_exp", 100000);
	set("shen",-10000);
	
	// 重新调整血量, 机关木人血量5000，铁甲木人血量10000
	if (id == "jiguan")
	{
		set("max_qi", 5000);
		set("qi", 5000);
	}
	else if (id == "tiejia")
	{
		set("max_qi", 10000);
		set("qi", 10000);
	}
	
	set("qi", 1000);
	set("max_neili", 1000);
	set("neili", 1000);
	set("max_jing", 10000);
	set("jing", 10000);
	set("fuben_caoren", 1);
	         
	set_skill("sword",100);
    set_skill("blade", 100);
    set_skill("whip", 100);
    set_skill("club", 100);
    set_skill("staff", 100);
    set_skill("throwing", 100);

    set_skill("force", 100);
    set_skill("parry", 100);
    set_skill("dodge", 100);

    set_skill("unarmed",100);
    set_skill("cuff", 100);
    set_skill("strike", 100);
    set_skill("finger", 100);
    set_skill("claw", 100);
    set_skill("hand", 100);

	setup();
}


int is_cao() { return 1; }

//当前环境上是否有玩家
mixed get_player()
{
	object *inv;
	if (sizeof(inv = filter_array(all_inventory(environment()), (:playerp($1):))))
	{
		return inv[0];
	}
	else
	{
		return 0;
	}
	
}

void die()
{
    object who = this_object()->query_last_damage_from();
    object *inv;
    string str;
    object gift;
    int random, finish_time;
    int base_exp = 10000;    // 基础经验
    int base_pot = 5000;     // 基础潜能
    int start_time;          // 开始时间
    object room;             // 当前房间

    // 获取当前房间
    room = environment(this_object());

    //是否有玩家
    if (!objectp(who))
    {
        if (!objectp(who = get_player()))
        {
            ::die();
            return;
        }
    }

    // 检查当前地图内除了玩家外是否还有其他活物
    inv = all_inventory(environment());

    // 如果木人是觉醒状态，给予额外奖励
    if (query("awakened"))
    {
        tell_object(who, HIC "【特殊奖励】你击败了觉醒木人，获得额外的1000点经验和500点潜能！\n" NOR);
        FUBEN_D->add_exp(who, 1000);
        who->add("potential", 500);
    }

    // 如果木人在木人阵中，给予额外奖励
    if (query("in_murenzheng"))
    {
        tell_object(who, HIC "【特殊奖励】你击破了木人阵中的一员，获得额外的800点经验和400点潜能！\n" NOR);
        FUBEN_D->add_exp(who, 800);
        who->add("potential", 400);
    }

    //过滤掉玩家以后，如果当前地图没有了，开始计算通关时间(不是玩家且，目标对象->is_cao())
    if (sizeof(filter_array(inv, (:$1->is_cao():))) == 1)
    {
        str = HIC "【试炼完成】" NOR + "恭喜你成功通过木剑砺锋试炼！\n\n" + 
              HIY "【获得奖励】" NOR + "你获得了";

        // 获取开始时间
        start_time = who->query("fuben_caoren/last_time");
        // 计算通关时间
        finish_time = time() - start_time;

        // 基础奖励
        str += sprintf("%s%d%s经验和%s%d%s潜能", HIW, base_exp, NOR, HIW, base_pot, NOR);
        FUBEN_D->add_exp(who, base_exp);
        who->add("potential", base_pot);


        // 随机物品奖励
        random = random(10);
        if(random < 3)
            gift = new_bind("/clone/vip//putao");
        else if(random == 5)
            gift = new_bind("/clone/baiyi/onecard");
        else if(random == 4)
        {
            gift = new_bind(dan_list[random(sizeof(dan_list))]);
        }

        if (objectp(gift))
        {
            str += "、" + HIW + gift->query("name") + NOR;
            gift->move(who);
        }

        //通过时间小于3分钟，奖励5000潜能，20绑定元宝
        if (finish_time < 180)
        {
            who->add("potential", base_pot);
            who->add("bind_yuanbao", 20);
            str += "、" + HIW + "5000" + NOR + "潜能和" + HIW + "20" + NOR + "绑定元宝" + HIG + "（速通奖励）" + NOR;
            base_pot += 5000;  // 更新总潜能值
        }

        //开始检测伤害量,如果返回代表无伤通过
        if (!who->query_time_damage())
        {
            //无伤通关一次性奖励5000潜能
            who->add("potential", base_pot);
            str += "、" + HIW + "5000" + NOR + "潜能" + HIG + "（无伤通关奖励）" + NOR;
            base_pot += 5000;  // 更新总潜能值

            // 设置副本通关时间
            //记录最低的一次通关时间
            if (!who->query("fuben_finish_time/caoren") || who->query("fuben_finish_time/caoren") > finish_time)
            {
                who->set("fuben_finish_time/caoren", finish_time);
                str += "\n\n" + HIC + "【新纪录】" + NOR + "你创造了个人最快通关记录：" + 
                       HIW + CHINESE_D->chinese_time(finish_time) + NOR + "！";
            }
            else
            {
                str += "\n\n" + "你的最快通关记录是：" + HIW + CHINESE_D->chinese_time(who->query("fuben_finish_time/caoren")) + NOR;
            }

            who->set_on_damage(0);//副本结束关闭伤害记录
        }
        else
        {
            str += "\n\n" + HIY + "【提示】" + NOR + "若能无伤通关，可获得额外奖励！";
            if (who->query("fuben_finish_time/caoren"))
            {
                str += "\n你的最快通关记录是：" + HIW + CHINESE_D->chinese_time(who->query("fuben_finish_time/caoren")) + NOR;
            }
        }

        str += "。\n";
        
        // 添加一个击败最后一个木人的描述
        str = HIM + "\n你一招「" + chinese_number(3 + random(10)) + "式连环」击中" + 
              this_object()->query("name") + "的要害，只听「咔嚓」一声，" + 
              this_object()->query("name") + "轰然倒地，化为一堆零件。\n\n" + NOR + str;
              
        tell_object(who, str);

        // 记录副本监控日志
        MONITOR_MASTER->monitor_fuben_log(who, "草人副本", start_time, time(), base_pot, base_exp);
    }
    else
    {
        // 如果不是最后一个木人，添加击败木人的描述
        tell_object(who, HIM + "你一招「" + chinese_number(3 + random(10)) + "式连环」击中" + 
                   this_object()->query("name") + "的要害，只听「咔嚓」一声，" + 
                   this_object()->query("name") + "轰然倒地，化为一堆零件。\n" + NOR);
                   
        // 调用检查函数，检查剩余木人数量并触发相应事件
        if (objectp(room))
            call_other(room, "check_caoren_count", room);
    }

    ::die();
}