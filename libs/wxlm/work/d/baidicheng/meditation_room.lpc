inherit ROOM;

void create()
{
    set("short", "静修室");
    set("long", @LONG
这是一间宁静的房间，专门用于弟子们打坐修炼。房间内光线柔和，空气清新。
地上整齐地摆放着几个蒲团，墙上挂着一幅写有"静心养性"四个大字的字画。这
里常年安静，只能听到微弱的呼吸声。
LONG );
    set("exits", ([
        "south" : __DIR__"garden",
    ]));
    set("no_fight", 1);
    set("sleep_room", 1);
    setup();
}
