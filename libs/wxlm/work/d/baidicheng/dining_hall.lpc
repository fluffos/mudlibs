inherit ROOM;

void create()
{
    set("short", "饭堂");
    set("long", @LONG
这里是白帝城的饭堂，宽敞明亮。几排长桌整齐排列，可以容纳上百人同时用餐。
墙边有一排大锅，散发着诱人的香气。这里不仅为弟子们提供日常饮食，也是大家
交流感情的地方。
LONG );
    set("exits", ([
        "southeast" : __DIR__"square",
    ]));
    // set("objects", ([
    //     __DIR__"npc/cook" : 1,
    // ]));
    set("resource/water", 1);
    setup();
}