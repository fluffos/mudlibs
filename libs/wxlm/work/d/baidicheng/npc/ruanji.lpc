// /d/baidicheng/npc/ruanji.c


inherit NPC;
inherit F_MASTER;

void create()
{
    set_name("阮籍", ({ "ruan ji", "ruan", "ji" }));
    set("title", HIY "白帝城二代弟子" NOR);
    set("gender", "男性");
    set("age", 35);
    set("long", "阮籍是白帝城的二代弟子,也是竹林七贤之一。\n"
                "他精通音律,琴艺高超,同时也是一位出色的诗人。\n");
    set("attitude", "peaceful");
    set("class", "scholar");
    
    set("str", 28);
    set("int", 30);
    set("con", 26);
    set("dex", 28);
    
    set("max_qi", 4000);
    set("max_jing", 2500);
    set("neili", 4000);
    set("max_neili", 4000);
    set("jiali", 120);
    
    set("combat_exp", 1500000);
    
    set_skill("force", 180);
    set_skill("gandanqinxin", 180);
    set_skill("dodge", 160);
    set_skill("lingboweibu", 160);
    set_skill("parry", 160);
    set_skill("qin", 180);
    set_skill("yiqu-qinyinduan", 180);
    set_skill("literate", 180);
    set_skill("yinlv", 200);
    map_skill("force", "gandanqinxin");
    map_skill("dodge", "lingboweibu");
    map_skill("parry", "yiqu-qinyinduan");
    map_skill("qin", "yiqu-qinyinduan");
    
    create_family("白帝城", 2, "弟子");
    
    setup();
    
    carry_object("/clone/cloth/cloth")->wear();
    carry_object("/d/baidicheng/obj/qin2")->wield();
}

void attempt_apprentice(object ob)
{
    if (ob->query("combat_exp") < 300000) {
        command("say 你的实战经验还不够,先去多历练历练吧。（要求300000经验）");
        return;
    }
    if (ob->query_skill("gandanqinxin", 1) < 80) {
        command("say 我们白帝城的内功心法你还没有学好,先下去打好基础再来吧。（要求80级）");
        return;
    }
    if (ob->query("family/family_name") != "白帝城") {
        command("say 你不是我白帝城的弟子,我不能收你为徒。");
        return;
    }
    command("nod");
    command("say 好吧,我就收你为徒。希望你能勤学苦练,为白帝城增光添彩。");
    command("recruit " + ob->query("id"));
}