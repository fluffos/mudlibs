// /d/baidicheng/npc/xiangxiu.c


inherit NPC;
inherit F_MASTER;

void create()
{
    set_name("向秀", ({ "xiang xiu", "xiang", "xiu" }));
    set("title", HIC "白帝城三代弟子" NOR);
    set("gender", "男性");
    set("age", 28);
    set("long", "向秀是白帝城的三代弟子,也是竹林七贤中最年轻的一位。\n"
                "他天资聪颖,琴艺出众,被誉为白帝城新一代的希望。\n");
    set("attitude", "peaceful");
    set("class", "scholar");
    
    set("str", 26);
    set("int", 28);
    set("con", 24);
    set("dex", 26);
    
    set("max_qi", 3000);
    set("max_jing", 2000);
    set("neili", 3000);
    set("max_neili", 3000);
    set("jiali", 100);
    
    set("combat_exp", 1000000);
    
    set_skill("force", 160);
    set_skill("gandanqinxin", 160);
    set_skill("dodge", 140);
    set_skill("lingboweibu", 140);
    set_skill("parry", 140);
    set_skill("qin", 160);
    set_skill("yiqu-qinyinduan", 160);
    set_skill("literate", 160);
    set_skill("yinlv", 200);
    map_skill("force", "gandanqinxin");
    map_skill("dodge", "lingboweibu");
    map_skill("parry", "yiqu-qinyinduan");
    map_skill("qin", "yiqu-qinyinduan");
    
    create_family("白帝城", 3, "弟子");
    
    setup();
    
    carry_object("/clone/cloth/cloth")->wear();
    carry_object("/d/baidicheng/obj/qin3")->wield();
}

void attempt_apprentice(object ob)
{
    
    command("nod");
    command("say 好吧,我就收你为徒。希望你能勤学苦练,为白帝城增光添彩。");
    command("recruit " + ob->query("id"));
}