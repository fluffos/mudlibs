// /d/baidicheng/npc/jikang.c


inherit NPC;
inherit F_MASTER;
inherit F_QUESTER;

void create()
{
    set_name("嵇康", ({ "ji kang", "ji", "kang" }));
    set("title", HIW "白帝城掌门" NOR);
    set("gender", "男性");
    set("age", 45);
    set("long", "这就是白帝城的掌门人嵇康，他风姿潇洒，气质超然。\n"
                "他的琴艺已经达到了出神入化的境界，被誉为【竹林七贤】之首。\n"
                "据说他创作的《广陵散》堪称千古绝唱。\n");
    set("attitude", "peaceful");
    set("class", "scholar");
    set("str", 30);
    set("int", 30);
    set("con", 30);
    set("dex", 30);
    
    set("max_qi", 5000);
    set("max_jing", 3000);
    set("neili", 5000);
    set("max_neili", 5000);
    set("jiali", 150);
    
    set("combat_exp", 2000000);
    
    set_skill("force", 200);
    set_skill("gandanqinxin", 200);
    set_skill("dodge", 180);
    set_skill("lingboweibu", 180);
    set_skill("parry", 180);
    set_skill("qin", 200);
    set_skill("yiqu-qinyinduan", 200);
    set_skill("literate", 200);
    set_skill("yinlv", 200);
    set_skill("pingsha-luoyan", 200);
    set_skill("bainiao-chaofeng", 200);
    set_skill("gaoshan-liushui", 200);
    map_skill("force", "gandanqinxin");
    map_skill("dodge", "lingboweibu");
    map_skill("parry", "yiqu-qinyinduan");
    map_skill("qin", "yiqu-qinyinduan");
    
    create_family("白帝城", 1, "掌门");
    
    setup();
    
    carry_object("/clone/cloth/cloth")->wear();
    carry_object("/d/baidicheng/obj/qin1")->wield();
}

void attempt_apprentice(object ob)
{
    if (ob->query("combat_exp") < 500000) {
        command("say 你的实战经验还不够，先去多历练历练吧。（要求500000经验）");
        return;
    }
    if (ob->query_skill("gandanqinxin", 1) < 120) {
        command("say 我们白帝城的内功心法你还没有学好，先下去打好基础再来吧。（要求120级）");
        return;
    }
    // 判断是不是白帝城的 
    if (ob->query("family/family_name") != "白帝城") {
        command("say 你已经有了门派了，不能再收徒了。");
        return;
    }
    command("nod");
    command("say 好吧，我就收你为徒。希望你能够勤学苦练，为白帝城增光添彩。");
    command("chat " + ob->query("name") + " 以后你就是我的徒弟了，行走江湖一定要好好练琴，不要辜负混子的期望，将我们白帝城发扬光大！");
    command("recruit " + ob->query("id"));
}