inherit ROOM;

void create()
{
    set("short", "客房");
    set("long", @LONG
这里是白帝城接待外来宾客的客房。房间布置得简单雅致，有几张舒适的床铺和
一张茶几。窗外可以看到白帝城的美丽景色。虽然不及其他大门派的客房豪华，但
也充分体现了白帝城的待客之道。
LONG );
    set("exits", ([
        "northeast" : __DIR__"square",
    ]));
    set("no_fight", 1);
    set("sleep_room", 1);
    setup();
}