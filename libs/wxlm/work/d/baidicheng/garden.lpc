inherit ROOM;

void create()
{
    set("short", "白帝城花园");
    set("long", @LONG
这里是白帝城的花园，四季常青。园中种植着各种奇花异草，香气扑鼻。小径蜿
蜒，假山流水，景致优美。这里是弟子们休息放松的好去处，时常可以看到三三两
两的人在此漫步闲谈。
LONG );
    set("exits", ([
        "east" : __DIR__"square",
        "north" : __DIR__"meditation_room",
    ]));
    // set("objects", ([
    //     __DIR__"npc/gardener" : 1,
    // ]));
    set("outdoors", "baidicheng");
