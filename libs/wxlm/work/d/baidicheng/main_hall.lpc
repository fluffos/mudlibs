inherit ROOM;

void create()
{
    set("short", "白帝城主殿");
    set("long", @LONG
这里是白帝城的主殿，气势恢宏。殿内陈设简单却不失威严，正中央放置着一张
虎皮大椅，是掌门人议事的地方。殿壁上挂着历代掌门的画像，还有一些珍贵的字
画。这里是白帝城最重要的地方，平时有弟子们在此当值。
LONG );
    set("exits", ([
        "north" : __DIR__"master_room",
        "south" : __DIR__"square",
        "east"  : __DIR__"library",
        "west"  : __DIR__"weapon_room",
        "northeast" : __DIR__"medicine_room",
        "northwest" : __DIR__"ancestral_hall",
        "southeast" : __DIR__"prison",
    ]));
    set("objects", ([
        __DIR__"npc/ruanji" : 1,
    ]));
    setup();
}