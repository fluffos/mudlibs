inherit ROOM;

void create()
{
    set("short", "秘密通道");
    set("long", @LONG
这是一条隐蔽的地下通道，连接着白帝城的几个重要场所。通道内光线昏暗，空
气略显沉闷。墙壁上每隔一段距离就挂着一盏油灯，勉强照亮前路。这条通道的存
在只有少数高层人物知晓，是紧急情况下的逃生之路。
LONG );
    set("exits", ([
        "up" : __DIR__"master_room",
        "down" : __DIR__"treasure_room",
    ]));
    set("no_fight", 1);
    setup();
}