inherit ROOM;

void create()
{
    set("short", "藏书阁");
    set("long", @LONG
这里是白帝城的藏书阁，内有数千卷典籍。四壁都是高大的书架，上面整齐地摆
放着各种书籍。有武功秘籍，也有诗词歌赋。正中间放着一张大桌，上面摊开着几
本书，还有文房四宝。这里安静异常，只能听到翻书的轻微声响。
LONG );
    set("exits", ([
        "west" : __DIR__"main_hall",
    ]));
    // set("objects", ([
    //     __DIR__"npc/librarian" : 1,
    // ]));
    set("no_fight", 1);
    setup();
}