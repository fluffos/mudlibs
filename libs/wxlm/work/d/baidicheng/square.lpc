inherit ROOM;

void create()
{
    set("short", "白帝城广场");
    set("long", @LONG
这里是白帝城的中心广场，宽阔平整。四周种植着古老的松柏，显得庄严肃穆。
广场中央矗立着一座巨大的石碑，上面刻着白帝城的历史沿革。广场上经常有弟子
们习武切磋，热闹非凡。
LONG );
    set("exits", ([
        "north" : __DIR__"main_hall",
        "south" : __DIR__"gate",
        "east"  : __DIR__"training_ground",
        "west"  : __DIR__"garden",
        "northeast" : __DIR__"martial_arts_hall",
        "northwest" : __DIR__"dining_hall",
        "southeast" : __DIR__"dormitory",
        "southwest" : __DIR__"guest_house",
        "up"    : __DIR__"watchtower",
        "down"  : __DIR__"storage",
    ]));
    
    set("outdoors", "baidicheng");
    setup();
}