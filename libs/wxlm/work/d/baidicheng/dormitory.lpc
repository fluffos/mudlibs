inherit ROOM;

void create()
{
    set("short", "弟子宿舍");
    set("long", @LONG
这里是白帝城弟子们居住的地方。房间虽然简单，但收拾得很整洁。靠墙摆放着
几张木床，每张床边都有一个小柜子。房间中央有一张大桌，供弟子们读书学习。
墙上挂着一些武功图解，时刻提醒弟子们勤学苦练。
LONG );
    set("exits", ([
        "northwest" : __DIR__"square",
    ]));
    set("no_fight", 1);
    set("sleep_room", 1);
    setup();
}