inherit ROOM;

void create()
{
    set("short", "宝库");
    set("long", @LONG
这里是白帝城的宝库，存放着门派多年来积累的财富和珍贵物品。房间四周摆放
着几个大铁箱，上面刻有复杂的符文。正中央的石台上放着一个精致的玉盒，据说
里面藏有白帝城镇派之宝。这里戒备森严，非高层人物不得入内。
LONG );
    set("exits", ([
        "up" : __DIR__"secret_passage",
    ]));
    // set("objects", ([
    //     __DIR__"npc/guardian" : 2,
    // ]));
    setup();
}