inherit ROOM;

void create()
{
    set("short", "掌门人居所");
    set("long", @LONG
这里是白帝城掌门人的居所，布置简单却不失威严。房间正中放着一张檀木案几，
案上摆放着一些卷轴和书籍。墙上挂着一幅山水画，意境深远。这里清静幽雅，是
掌门人处理事务和冥想修炼的地方。
LONG );
    set("exits", ([
        "south" : __DIR__"main_hall",
        "down"  : __DIR__"secret_passage",
    ]));
    set("objects", ([
        __DIR__"npc/jikang" : 1,
    ]));

    setup();
}