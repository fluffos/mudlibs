inherit ROOM;

void create()
{
    set("short", "白帝城大门");
    set("long", @LONG
这里是威震三江的白帝城大门。高大的城墙巍峨耸立，朱红色的大门上方悬挂
着"白帝城"三个鎏金大字。门口两旁站着威武的守卫，目光如炬地盯着来往的人
群。大门内隐约可见白帝城的恢宏气势。
LONG );
    set("exits", ([
        "north" : __DIR__"square",
        // "south" : "/d/city/north/road1",
        "east" : __DIR__"jingji/enter",
    ]));
    
    setup();
}

