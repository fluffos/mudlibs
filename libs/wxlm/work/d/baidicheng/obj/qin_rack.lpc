// /d/baidicheng/obj/qin_rack.c

inherit ITEM;

void create()
{
    set_name("琴架", ({ "qin rack", "rack" }));
    set_weight(30000);
    set_max_encumbrance(5000);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("unit", "个");
        set("long", "这是一个精致的琴架，上面摆放着各种名贵的琴。\n");
        set("value", 1000);
        set("material", "wood");
        set("no_get", 1);
        set("item_desc", ([
            "琴架" : "这是一个精致的琴架，上面摆放着各种名贵的琴。\n"
                ZJOBACTS2+ZJMENUF(3,3,10,30)"获取琴:acquire qin\n"
        ]));
    }
}

void init()
{
    add_action("do_get", "get");
}

int do_get(string arg)
{
    object me = this_player();
    object qin;
    string qin_file;
    
    if (!arg || arg != "qin from rack")
        return 0;
    
    if (me->is_busy())
        return notify_fail("你现在正忙着呢。\n");
    
    if (present("qin", me))
        return notify_fail("你已经有一把琴了，不要太贪心。\n");
    
    switch(random(3)) {
        case 0: qin_file = "/d/baidicheng/obj/qin1"; break;
        case 1: qin_file = "/d/baidicheng/obj/qin2"; break;
        case 2: qin_file = "/d/baidicheng/obj/qin3"; break;
    }
    
    qin = new(qin_file);
    qin->move(me);
    message_vision("$N从琴架上取下一" + qin->query("unit") + qin->name() + "。\n", me);
    
    // 补充新的琴
    new(qin_file)->move(this_object());
    
    return 1;
}