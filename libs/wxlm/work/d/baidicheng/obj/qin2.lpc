// /d/baidicheng/obj/qin2.c
#include <weapon.h>
inherit QIN;

void create()
{
    set_name("龙吟琴", ({ "longyin qin", "qin", "longyin" }));
    set_weight(5000);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("unit", "张");
        set("long", "这张琴通体漆黑，琴身雕刻着栩栩如生的龙纹，琴音如龙吟般震撼。\n");
        set("value", 0);  // 设置价值为0，防止出售
        set("material", "ebony");
        set("wield_msg", "$N郑重地取出$n，轻抚琴身上的龙纹。\n");
        set("unwield_msg", "$N小心翼翼地将$n收起。\n");
        set("no_drop", 1);     // 防止丢弃
        set("no_give", 1);     // 防止给予
        set("no_sell", 1);     // 防止出售
    }
    init_qin(25);
    setup();
}

void init()
{
    add_action("do_drop", "drop");
    add_action("do_give", "give");
    add_action("do_sell", "sell");
}

int do_drop(string arg)
{
    object me = this_player();
    string item;
    object obj;

    if (!arg) return 0;

    if (sscanf(arg, "%s", item) != 1) return 0;

    if (!objectp(obj = present(item, me))) return 0;

    if (obj == this_object())
    {
        tell_object(me, "这把龙吟琴是白帝城的镇派之宝，你不能随意丢弃。\n");
        return 1;
    }
    return 0;
}

int do_give(string arg)
{
    object me = this_player();
    string item, target;
    object obj;

    if (!arg) return 0;

    if (sscanf(arg, "%s to %s", item, target) != 2) return 0;

    if (!objectp(obj = present(item, me))) return 0;

    if (obj == this_object())
    {
        tell_object(me, "这把龙吟琴是白帝城的镇派之宝，你不能随意给予他人。\n");
        return 1;
    }
    return 0;
}

int do_sell(string arg)
{
    object me = this_player();
    string item;
    object obj;

    if (!arg) return 0;

    if (sscanf(arg, "%s", item) != 1) return 0;

    if (!objectp(obj = present(item, me))) return 0;

    if (obj == this_object())
    {
        tell_object(me, "这把龙吟琴是白帝城的镇派之宝，你不能出售。\n");
        return 1;
    }
    return 0;
}