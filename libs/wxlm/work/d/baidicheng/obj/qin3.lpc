// /d/baidicheng/obj/qin3.c
#include <weapon.h>
inherit QIN;

void create()
{
    set_name("凤鸣琴", ({ "fengming qin", "qin", "fengming" }));
    set_weight(4800);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("unit", "张");
        set("long", "这张琴通体呈现淡淡的金色，琴头雕刻着一只展翅欲飞的凤凰，琴音婉转如凤鸣。\n");
        set("value", 0);  // 设置价值为0，防止出售
        set("material", "gold");
        set("wield_msg", "$N轻轻抚过$n琴头的凤凰雕刻，将琴置于膝前。\n");
        set("unwield_msg", "$N恋恋不舍地将$n收起。\n");
        set("no_drop", 1);     // 防止丢弃
        set("no_give", 1);     // 防止给予
        set("no_sell", 1);     // 防止出售
    }
    init_qin(22);
    setup();
}

void init()
{
    add_action("do_drop", "drop");
    add_action("do_give", "give");
    add_action("do_sell", "sell");
}

int do_drop(string arg)
{
    object me = this_player();
    string item;
    object obj;

    if (!arg) return 0;

    if (sscanf(arg, "%s", item) != 1) return 0;

    if (!objectp(obj = present(item, me))) return 0;

    if (obj == this_object())
    {
        tell_object(me, "这把凤鸣琴是白帝城的镇派之宝，你不能随意丢弃。\n");
        return 1;
    }
    return 0;
}

int do_give(string arg)
{
    object me = this_player();
    string item, target;
    object obj;

    if (!arg) return 0;

    if (sscanf(arg, "%s to %s", item, target) != 2) return 0;

    if (!objectp(obj = present(item, me))) return 0;

    if (obj == this_object())
    {
        tell_object(me, "这把凤鸣琴是白帝城的镇派之宝，你不能随意给予他人。\n");
        return 1;
    }
    return 0;
}

int do_sell(string arg)
{
    object me = this_player();
    string item;
    object obj;

    if (!arg) return 0;

    if (sscanf(arg, "%s", item) != 1) return 0;

    if (!objectp(obj = present(item, me))) return 0;

    if (obj == this_object())
    {
        tell_object(me, "这把凤鸣琴是白帝城的镇派之宝，你不能出售。\n");
        return 1;
    }
    return 0;
}