inherit ROOM;

void create()
{
    set("short", "练武场");
    set("long", @LONG
这里是白帝城的练武场，地面坚实平整。四周摆放着各种练功用的器械，有木人
桩、沙袋等。场地中央划分了几块比武擂台。这里终日人声鼎沸，是弟子们习武切
磋的主要场所。在场地的一角，还摆放着一个精致的琴架，上面陈列着几把名贵的琴。
LONG );
    set("exits", ([
        "west" : __DIR__"square",
    ]));
    set("outdoors", "baidicheng");
    set("item_desc", ([
        "琴架" : "这是一个精致的琴架，上面摆放着各种名贵的琴。\n"
                ZJOBACTS2+ZJMENUF(3,3,10,30)"获取琴:acquire qin\n"
    ]));
    setup();
}

void init()
{
    add_action("do_acquire", "acquire");
}

int do_acquire(string arg)
{
    object me = this_player();
    object qin;
    string qin_file;
    
    if (arg != "qin")
        return notify_fail("你要获取什么？\n");

    if (me->is_busy())
        return notify_fail("你现在正忙着呢。\n");
    
    if (present("qin", me))
        return notify_fail("你已经有一把琴了，不要太贪心。\n");
    
    switch(random(3)) {
        case 0: qin_file = "/d/baidicheng/obj/qin1"; break;
        case 1: qin_file = "/d/baidicheng/obj/qin2"; break;
        case 2: qin_file = "/d/baidicheng/obj/qin3"; break;
    }
    
    qin = new(qin_file);
    qin->move(me);
    message_vision("$N从琴架上取下一" + qin->query("unit") + qin->name() + "。\n", me);
    
    return 1;
}