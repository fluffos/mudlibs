inherit ROOM;

void create()
{
    set("short", "药房");
    set("long", @LONG
这里是白帝城的药房，空气中弥漫着浓郁的药香。房间四周摆满了药柜，里面存
放着各种珍贵药材。正中央有一张大案台，上面放着药炉和各种炮制药材的工具。
这里由精通医术的长老主持，为受伤的弟子们治疗伤势。
LONG );
    set("exits", ([
        "southwest" : __DIR__"main_hall",
    ]));
    // set("objects", ([
    //     __DIR__"npc/doctor" : 1,
    // ]));
    setup();
}