#include <room.h>
inherit ROOM;

void create()
{
    set("short", "灵龙洞");
    set("long", @LONG
这里是灵龙洞内部，洞内空间颇为宽敞，四壁上镶嵌着夜明珠，发出柔和的
光芒。洞壁上刻满了古老的壁画(bihua)，似乎记载着远古时期的故事。地面上
铺着整齐的青石，显得十分干净。空气中飘荡着一股奇特的清香。
LONG );

    set("exits", ([
        "out"   : __DIR__"dongwai",
        "north" : __DIR__"mishi",
    ]));
    
    set("item_desc", ([
        "壁画" : popup_comb("壁画上描绘着一条巨龙盘旋在山间的场景，栩栩如生。\n",
            "仔细观察:study bihua"),
    ]));
    
    setup();
}
