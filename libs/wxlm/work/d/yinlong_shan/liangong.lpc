#include <room.h>
inherit ROOM;

void create()
{
    set("short", "练功房");
    set("long", @LONG
这是道观的练功房，虽然年久失修，但还算完整。房间四周摆放着几个蒲团，
正中央有一个铜制的练功桩(练功桩)。墙上挂着几幅壁画，画的是道家修炼的心
法口诀。地面上铺着厚厚的草垫，适合打坐练功。
LONG );

    set("exits", ([
        "west"  : __DIR__"daoguan",
        "north" : __DIR__"juling",
    ]));
    
    set("item_desc", ([
        "练功桩" : popup_comb("一个铜制练功桩，上面有许多凹痕。\n",
            "练习武功:practice cuff"),
    ]));
    
    setup();
}

void init()
{
    add_action("do_practice", "practice");
}

int do_practice(string arg)
{
    object me = this_player();
    int cost;
    
    if (me->is_busy())
        return notify_fail("你现在正忙着呢。\n");
        
    if (me->query("jing") < 50)
        return notify_fail("你现在精神不济，无法练功。\n");
        
    if (! arg)
        return notify_fail("你要练习什么功夫？\n");
        
    if (arg != "cuff")
        return notify_fail("你只能练习【拳法】功夫。\n");
        
    cost = 30;
    
    if (me->query("jing") < cost)
        return notify_fail("你现在太疲倦了，无法练习。\n");
        
    me->receive_damage("jing", cost);
    
    message_vision("$N站在练功桩前开始修炼" + to_chinese(arg) + "。\n", me);
    
    if (me->can_improve_skill(arg))
        me->improve_skill(arg, random(me->query("int")));
    
    me->start_busy(5);

    return 1;
}
