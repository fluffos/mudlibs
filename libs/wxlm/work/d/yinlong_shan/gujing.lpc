#include <room.h>
inherit ROOM;

void create()
{
    set("short", "古井");
    set("long", @LONG
路边有一口古井(古井)，井台用青石砌成，上面爬满了青苔。井口很宽，往
下望去深不见底。井边立着一根石柱，上面刻着「灵龙古井」四个古篆。传说这
口古井通向地下暗河，井水清冽甘甜，具有神奇功效。
LONG );

    set("exits", ([
        "westdown" : __DIR__"shanlu2",
    ]));
    
    set("item_desc", ([
        "古井" : popup_comb("一口深不见底的古井，井水清澈见底。\n",
            "打水:draw water"),
    ]));
    
    set("resource/water", 1);
    
    set("outdoors", "yinlong");
    setup();
}

void init()
{
    add_action("do_draw", "draw");
}

int do_draw(string arg)
{
    object me = this_player();
    object ob;
    
    if (! arg || arg != "water")
        return notify_fail("你要打什么？\n");
        
    if (present("ling quan", me))
        return notify_fail("你已经装了一些井水了。\n");
        
    ob = new(__DIR__"obj/lingquan");
    ob->move(me);
    message_vision("$N从古井中打了一瓢清澈的井水。\n", me);
    return 1;
}
