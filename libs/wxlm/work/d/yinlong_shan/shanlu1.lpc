#include <room.h>

inherit ROOM;

void create()
{
    set("short", "山路");
    set("long", @LONG
这是一条蜿蜒向上的山路，路面用青石铺就，虽历经沧桑，却依然平整。路
边野花绽放，不时有山风吹过，带来阵阵花香。抬头望去，可以看到山路继续向
上延伸，隐没在浓密的竹林中。路边的山崖(山崖)上长着一些不知名的药草，不过位置
太过险要，难以采摘。
LONG );

    set("exits", ([
        "westdown" : __DIR__"shanjiao",
        "eastup"   : __DIR__"shanlu2",
    ]));
    
    set("item_desc", ([
        "山崖" : popup_comb("陡峭的山崖上生长着一些珍贵的药草，不过位置太过险要。\n",
            "攀爬山崖:climb 山崖"),
    ]));
    
    set("objects", ([
        // "/clone/quarry/tu"  : 1,
        __DIR__"obj/lingcao" : 1,
    ]));

    set("outdoors", "yinlong");
    
    setup();
}

void init()
{
    add_action("do_climb", "climb");
    add_action("do_climb", "pa");
}

int do_climb(string arg)
{
    object me = this_player();
    
    if (! arg || arg != "山崖" && arg != "cliff")
        return notify_fail("你要爬什么？\n");
        
    if (me->query("qi") < 80)
        return notify_fail("你现在体力不支，无法爬崖。\n");
        
    if (random(me->query_skill("dodge", 1)) < 30)
    {
        message_vision("$N手脚并用地往山崖上爬，却一个不稳摔了下来。\n", me);
        me->receive_damage("qi", 50);
        me->receive_wound("qi", 50);
        return 1;
    }
    
    //message_vision("$N手脚麻利地爬上山崖，采到一株灵龙草。\n", me);
   // new(__DIR__"obj/lingcao")->move(me);
    return 1;
}
