#include <room.h>
inherit ROOM;

void create()
{
    set("short", "瀑布前");
    set("long", @LONG
眼前是一道巨大的瀑布，水流从高处奔腾而下，发出震耳欲聋的轰鸣声。瀑
布溅起的水雾在阳光下形成一道美丽的彩虹。瀑布后面似乎有个山洞(山洞)，但
被水流遮掩着，不易进入。四周怪石嶙峋，苔藓遍布。
LONG );

    set("exits", ([
        "westdown" : __DIR__"xuanya",
        "eastup"   : __DIR__"liangting",
        "enter"    : __DIR__"backdong",
    ]));

    set("item_desc", ([
        "山洞" : popup_comb("瀑布后面隐约可见一个山洞。\n",
            "穿过瀑布:pass 瀑布"),
    ]));
    
    set("outdoors", "yinlong");
    setup();
}

void init()
{
    add_action("do_pass", "pass");
}

int do_pass(string arg)
{
    object me = this_player();
    
    if (! arg || arg != "瀑布" && arg != "waterfall")
        return notify_fail("你要穿过什么？\n");
        
    if (me->query("qi") < 100)
        return notify_fail("你现在体力不支，无法穿过瀑布。\n");
        
    message_vision("$N深吸一口气，猛地冲入瀑布中。\n", me);
    me->move(__DIR__"backdong");
    message_vision("$N浑身湿透地从瀑布中冲了进来。\n", me);
    return 1;
}
