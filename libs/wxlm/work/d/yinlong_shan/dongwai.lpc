#include <room.h>
inherit ROOM;

void create()
{
    set("short", "灵龙洞外");
    set("long", @LONG
这里是灵龙洞的入口，洞口高约两丈，宽约一丈，四周怪石嶙峋。洞口上方
刻着「灵龙洞」三个大字，笔力遒劲。传说这里曾是远古神龙修炼之地，蕴含着
神秘的力量。洞口不时传出阵阵清凉的山风。
LONG );

    set("exits", ([
        "southdown" : __DIR__"yaopu",
        "enter"     : __DIR__"longdong",
        "eastup"    : __DIR__"xuanya",
    ]));
    
    set("outdoors", "yinlong");
    setup();
}
