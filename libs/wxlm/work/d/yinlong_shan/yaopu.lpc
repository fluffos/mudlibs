#include <room.h>
inherit ROOM;

void create()
{
    set("short", "药圃");
    set("long", @LONG
这里是一片开垦过的药圃，种植着各种名贵药材。药圃中央有一个小亭子，
四周种满了珍稀药草，散发出阵阵药香。这里显然经常有人打理，药草长势良好。
据说这些药材都是历代隐龙山中人精心培育的灵药。
LONG );

    set("exits", ([
        "westdown" : __DIR__"zhulin",
        "northup"  : __DIR__"dongwai",
        // "eastup"   : __DIR__"pingtai",
    ]));
    
    // set("objects", ([
    //     __DIR__"obj/lingcao" : 2,
    //     __DIR__"obj/longsui" : 1,
    // ]));
    
    set("outdoors", "yinlong");
    setup();
}
