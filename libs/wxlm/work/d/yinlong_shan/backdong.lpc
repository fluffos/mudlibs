#include <room.h>
inherit ROOM;

void create()
{
    set("short", "瀑布后山洞");
    set("long", @LONG
这是瀑布后面的一个天然山洞，从这里可以看到瀑布形成的水帘。洞内十分
潮湿，墙壁上布满了青苔。一条狭窄的通道通向洞内深处，隐约可以看到前方有
光亮，似乎别有洞天。
LONG );

    set("exits", ([
        "out"   : __DIR__"pubu",
        "north" : __DIR__"lingquan",
    ]));
    
    setup();
}
