
inherit ITEM;

void create()
{
    set_name(HIY "灵龙草" NOR, ({"linglong cao", "cao", "grass"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("unit", "株");
        set("long", "这是一株生长在隐龙山上的珍贵药草，散发着淡淡的清香。\n");
        set("value", 8000);
        set("weight", 100);
        set("only_do_effect", 1);
    }
    setup();
}

int do_effect(object me)
{
    message_vision("$N小心服下一株" + name() + "。\n", me);
    
    me->receive_curing("qi", 100);
    me->receive_heal("qi", 100);
    
    destruct(this_object());
    return 1;
}
