
inherit ITEM;

void create()
{
    set_name(HIY "《龙心真经》" NOR, ({"longxin zhenjing", "longxin", "zhenjing"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("unit", "本");
        set("long", "这是一本记载着上古龙族修炼心法的秘籍，书页已经发黄。\n");
        set("value", 50000);
        set("material", "paper");
        set("skill", ([
            "name"         : "force",
            "exp_required" : 100000,
            "jing_cost"    : 40,
            "difficulty"   : 30,
            "max_skill"    : 180,
            "min_skill"    : 80,
        ]));
    }
}
