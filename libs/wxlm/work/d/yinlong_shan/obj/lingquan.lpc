
inherit ITEM;

void create()
{
    set_name(HIC "灵泉水" NOR, ({"ling quan", "quan", "water"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("unit", "瓢");
        set("long", "一瓢从古井中打上来的清水，清澈见底，散发着淡淡的灵气。\n");
        set("value", 500);
        set("only_do_effect", 1);
    }
    setup();
}

int do_effect(object me)
{
    message_vision("$N捧起一瓢" + name() + "喝了下去。\n", me);
    
    me->receive_healing("jing", 50);
    me->receive_healing("qi", 50);
    
    destruct(this_object());
    return 1;
}
