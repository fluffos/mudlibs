
inherit ITEM;
inherit F_FOOD;

void create()
{
    set_name(HIG "竹笋" NOR, ({"zhu sun", "sun", "zhusun"}));
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "一根新鲜的竹笋，散发着淡淡的清香。\n");
        set("unit", "根");
        set("value", 100);
        set("food_remaining", 4);
        set("food_supply", 30);
    }
    setup();
}
