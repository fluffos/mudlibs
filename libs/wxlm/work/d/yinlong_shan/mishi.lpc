#include <room.h>
inherit ROOM;

void create()
{
    set("short", "密室");
    set("long", @LONG
这是一间隐秘的密室，四周墙壁上镶嵌着夜明珠，发出柔和的光芒。密室中
央放着一个石台(shitai)，上面刻着复杂的纹路。石台四周摆放着几个蒲团，似
乎是修炼之用。空气中弥漫着一股淡淡的龙涎香。
LONG );

    set("exits", ([
        "south" : __DIR__"longdong",
    ]));
    
    set("item_desc", ([
        "石台" : popup_comb("一个古朴的石台，上面刻着神秘的纹路。\n",
            "打坐修炼:dazuo"),
    ]));
    
    setup();
}

void init()
{
    add_action("do_dazuo", "dazuo");
}

int do_dazuo(string arg)
{
    object me = this_player();
    
    if (me->is_busy())
        return notify_fail("你现在正忙着呢。\n");
        
    if (me->query("jing") < 50)
        return notify_fail("你现在精神不济，无法打坐。\n");
        
    message_vision("$N盘膝坐在石台上开始打坐。\n", me);
    me->start_busy(5);
    call_out("dazuo_finish", 5, me);
    return 1;
}

void dazuo_finish(object me)
{
    if (! me || environment(me) != this_object())
        return;
        
    message_vision("$N只觉一股暖流流遍全身，精神气爽。\n", me);

    if (me->query("max_jingli") < 3000)
    {
        me->add("max_jingli", 1);
        tell_object(me, HIC "你似乎领悟到了一些修炼的要诀，你的最大精力增加了1。\n" NOR);
    }
    else
    {
        tell_object(me, HIC "你似乎已经在石台达到了修炼的极限，石台的灵力已经无法再增加你的最大精力了。\n" NOR);
    }
}
