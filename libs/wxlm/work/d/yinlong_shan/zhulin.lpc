#include <room.h>
inherit ROOM;

void create()
{
    set("short", "竹林小径");
    set("long", @LONG
这里是一片茂密的竹林，翠竹随风摇曳，发出沙沙的响声。阳光透过竹叶间
的缝隙，在地上投下斑驳的光影。一条小径蜿蜒穿过竹林，地上铺满了厚厚的竹
叶。空气中弥漫着淡淡的竹香，令人心旷神怡。
LONG );

    set("exits", ([
        "southdown" : __DIR__"shanlu2",
        "eastup"    : __DIR__"yaopu",
    ]));
    
    set("objects", ([
        __DIR__"obj/zhusun" : 2,
    ]));
    
    set("outdoors", "yinlong");
    setup();
}
