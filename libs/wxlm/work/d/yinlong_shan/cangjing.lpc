#include <room.h>
inherit ROOM;

void create()
{
    set("short", "藏经阁");
    set("long", @LONG
这里是道观的藏经阁，虽然年久失修，但还算完整。四周的书架上零散地摆
放着一些古籍，大多都已经破损不堪。靠墙有一个朱漆剥落的经柜(经柜)，
上面的锁已经锈蚀。阁楼上积满了灰尘，空气中飘荡着一股陈旧的气息。
LONG );

    set("exits", ([
        "west"  : __DIR__"milin",
        "south" : __DIR__"daoguan",
        "east"  : __DIR__"juling",
    ]));
    
    set("item_desc", ([
        "经柜" : popup_comb("一个古旧的经柜，上面的锁已经锈蚀。\n",
            "搜索经柜:search 经柜"),
    ]));
    
    setup();
}

void init()
{
    add_action("do_search", "search");
}

int do_search(string arg)
{
    object me = this_player();
    object ob;
    
    if (! arg || arg != "经柜")
        return notify_fail("你要搜索什么？\n");
        
    if (query("searched"))
        return notify_fail("经柜已经被翻过了。\n");
        
    message_vision("$N仔细搜索着经柜。\n", me);
    
    if (random(10) == 0)
    {
        ob = new(__DIR__"obj/longxin");
        ob->move(me);
        message_vision("$N在经柜深处发现了一本古籍！\n", me);
    } else
    {
        message_vision("$N什么都没找到。\n", me);
    }
    
    set("searched", 1);
    return 1;
}
