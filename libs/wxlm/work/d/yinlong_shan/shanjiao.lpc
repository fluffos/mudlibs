#include <room.h>

inherit ROOM;

void create()
{
    set("short", "隐龙山山脚");
    set("long", @LONG
这里是隐龙山的山脚下，远远望去，群山叠嶂，云雾缭绕。相传上古时期此
山原名「灵龙山」，是远古神龙栖息之地，山中龙脉汇聚，灵气充沛。一条蜿蜒
的山路自山脚向上延伸，消失在云雾中。路旁有一块古朴的石碑(shibei)，上面
似乎刻着什么字迹。山脚下泉水叮咚，绿树成荫，显得格外清幽宁静。
LONG );

    set("exits", ([
        "eastup"    : __DIR__"shanlu1",
    ]));
    
    set("item_desc", ([
        "石碑" : popup_comb("这块古朴的石碑已经很古老了，上面的字迹依然清晰可见。\n", 
            "查看石碑内容:read shibei"),
    ]));
    

    set("outdoors", "yinlong");
    
    setup();
}

void init()
{
    add_action("do_climb", "climb");
    add_action("do_climb", "pa");
    add_action("do_read", "read");
}

int do_climb(string arg)
{
    object me = this_player();

    if (! arg || arg != "山" && arg != "mountain")
        return notify_fail("你要爬什么？\n");

    if (me->query("qi") < 40)
        return notify_fail("你现在体力不支，无法爬山。\n");

    message_vision("$N气喘吁吁地爬上山坡。\n", me);
    me->move(__DIR__"shanlu1");
    return 1;
}

/**
 * @brief 查看石碑内容
 * @param string arg 参数
 * @return int 成功返回1，失败返回0
 */
int do_read(string arg)
{
    object me;

    me = this_player();

    if (! arg || (arg != "石碑" && arg != "shibei"))
        return notify_fail("你要查看什么？\n");

    message_vision("$N走近石碑，仔细阅读上面的碑文。\n", me);

    tell_object(me, popup_title(HIC "\n石碑上刻着古朴的文字：\n\n" NOR +
        "    「灵龙古碑」\n\n" +
        "    上古之时，此山名曰灵龙，乃神龙栖息之所。\n" +
        "    山中龙脉汇聚，灵气充沛，常有紫气东来之象。\n" +
        "    相传远古修道之人于此山修炼，得天地之灵韵，\n" +
        "    终成大道。然沧海桑田，世事变迁，此山渐为\n" +
        "    世人遗忘，更名隐龙，隐于尘世之中。\n\n" +
        "    后人若有缘至此，当心怀敬畏，勿扰山中灵韵。\n\n" +
        HIM "        ——题于上古庚申年\n" NOR));

    return 1;
}
