#include <room.h>
inherit ROOM;

void create()
{
    set("short", "密林");
    set("long", @LONG
这里是一片茂密的原始森林，参天古木遮天蔽日，藤蔓缠绕树干。林中不时
传来各种鸟兽的叫声，偶尔能看到一些珍稀的药草。空气中弥漫着浓郁的草木清
香，脚下的地面铺满了厚厚的落叶。
LONG );

    set("exits", ([
        "south" : __DIR__"liangting",
        "east"  : __DIR__"cangjing",
    ]));
    
    set("objects", ([
        // "/clone/quarry/xiong" : 1,
        __DIR__"obj/lingcao"  : 2,
    ]));
    
    set("outdoors", "yinlong");
    setup();
}
