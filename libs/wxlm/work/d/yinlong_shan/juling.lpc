#include <room.h>
inherit ROOM;

void create()
{
    set("short", "聚灵台");
    set("long", @LONG
这里是隐龙山最高处的聚灵台，据说是远古时期修道之人建造的修炼圣地。
台上有一个八卦法阵(法阵)，阵眼处竖立着一块巨大的龙形玉璧。四周云雾缭
绕，灵气充沛，是一处难得的修炼宝地。
LONG );

    set("exits", ([
        "west"  : __DIR__"cangjing",
        "south" : __DIR__"liangong",
    ]));
    
    set("item_desc", ([
        "法阵" : popup_comb("一个神秘的八卦法阵，阵眼处竖立着一块巨大的龙形玉璧。\n",
            "修炼吐纳:tuna"),
    ]));
    
    setup();
}

void init()
{
    add_action("do_tuna", "tuna");
}

int do_tuna(string arg)
{
    object me = this_player();
    
    if (me->is_busy())
        return notify_fail("你现在正忙着呢。\n");
        
    if (me->query("jing") < 100)
        return notify_fail("你现在精神不济，无法修炼。\n");
        
    if (me->query("qi") < 100)
        return notify_fail("你现在气血不足，无法修炼。\n");
        
    message_vision("$N盘膝坐在八卦法阵中开始吐纳修炼。\n", me);
    me->start_busy(5);
    call_out("tuna_finish", 5, me);
    return 1;
}

void tuna_finish(object me)
{
    if (! me || environment(me) != this_object())
        return;
        
    if (random(20) == 0)
    {
        message_vision("$N感受到一股强大的灵气涌入体内，修为大进！\n", me);
        if (me->query("max_neili") < 10000)
        {
            me->add("max_neili", 1);
        }

        me->add("combat_exp", 100);
    } else {
        message_vision("$N只觉得一股暖流流遍全身，说不出的舒服。\n", me);
        if (me->query("neili") < me->query("max_neili") * 5)
        {
            me->add("neili", 20 * me->query("con"));
        }

        if (me->query("qi") < me->query("max_qi") * 2)
        {
            me->add("qi", 10 * me->query("con"));
        }
    }
}
