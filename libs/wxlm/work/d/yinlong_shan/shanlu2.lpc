#include <room.h>
inherit ROOM;

void create()
{
    set("short", "山路");
    set("long", @LONG
山路到这里变得更加陡峭，两旁怪石嶙峋，偶尔可见山泉从石缝中流出。路
边生长着一些奇特的山花，在山风中轻轻摇曳。向东上方望去，一片竹林随风摇
摆，竹叶沙沙作响，令人心旷神怡。
LONG );

    set("exits", ([
        "westdown" : __DIR__"shanlu1",
        "northup"  : __DIR__"zhulin",
        "eastup"   : __DIR__"gujing",
    ]));
    
    set("outdoors", "yinlong");
    setup();
}
