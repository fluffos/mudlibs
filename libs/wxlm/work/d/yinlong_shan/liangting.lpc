#include <room.h>
inherit ROOM;

void create()
{
    set("short", "山顶凉亭");
    set("long", @LONG
这里是隐龙山顶的一座古老凉亭，亭子建在一块巨大的山石上，四面通风，
视野开阔。从这里可以俯瞰整个山谷，远处群山连绵，云海翻腾。亭子的顶部雕
刻着精美的龙纹，亭柱上刻着许多古老的诗句(poem)。
LONG );

    set("exits", ([
        "westdown" : __DIR__"pubu",
        "north"    : __DIR__"milin",
        "east"     : __DIR__"daoguan",
    ]));
    
    set("item_desc", ([
        "诗句" : popup_comb("亭柱上刻着一首古诗。\n",
            "阅读诗句:read poem"),
    ]));
    
    set("outdoors", "yinlong");
    setup();
}

void init()
{
    add_action("do_read", "read");
}

int do_read(string arg)
{
    tell_object(this_player(), "你阅读了亭柱上的诗句。\n");
    return 1;
}
