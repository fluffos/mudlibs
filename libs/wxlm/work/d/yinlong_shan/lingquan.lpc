#include <room.h>
inherit ROOM;

void create()
{
    set("short", "灵泉");
    set("long", @LONG
这里是一处天然温泉，清澈的泉水从地下涌出，水温适中，氤氲着缕缕白雾。
泉水散发着淡淡的灵气，据说常年浸泡可以增强功力。泉眼(泉眼)周围的石
壁上生长着一些罕见的灵芝，但大都长在难以触及的位置。
LONG );

    set("exits", ([
        "south" : __DIR__"backdong",
    ]));
    
    set("item_desc", ([
        "泉眼" : popup_comb("一眼清澈的温泉，水温适中，氤氲着缕缕白雾。\n",
            "浸泡温泉:soak"),
    ]));
    
    setup();
}

void init()
{
    add_action("do_soak", "soak");
}

int do_soak(string arg)
{
    object me = this_player();
    
    if (me->is_busy())
        return notify_fail("你现在正忙着呢。\n");
        
    if (me->query("jing") < 50)
        return notify_fail("你现在精神不济，无法浸泡温泉。\n");
        
    message_vision("$N缓缓走入温泉中开始浸泡。\n", me);
    me->start_busy(10);
    call_out("soak_finish", 10, me);
    return 1;
}

void soak_finish(object me)
{
    if (! me || environment(me) != this_object())
        return;
        
    message_vision("$N从温泉中起身，只觉得浑身舒泰，功力似乎有所增进。\n", me);
    me->add("neili", 200);
}
