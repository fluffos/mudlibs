//Room: taijitai.c 太极台
//Date: 2024

inherit ROOM;

void create()
{
	set("short", "太极台");
	set("long", @LONG
这里是武当山最高处的一座古老石台，名为太极台。石台呈八卦形状，
中央刻着一个巨大的太极图案，黑白两色的阴阳鱼栩栩如生。台面光滑如镜，
四周云雾缭绕，仿佛置身仙境。传说这里是武当祖师张三丰悟道之所，每当
天地灵气汇聚之时，祖师便会在此现身，与天下武林高手论道。站在台上，
可以俯瞰整个武当山脉，群峰环绕，气势磅礴。
LONG);
	set("exits", ([
		"west": __DIR__"jinding",
	]));
	set("outdoors", "wudang");
	set("no_clean_up", 0);
    set("out_room","/d/city/guangchang");
	set("light", 3);
	
	// 设置特殊属性，表明这是BOSS战斗区域
	set("no_fight", 0);
	set("no_steal", 1);
	set("no_beg", 1);
	
	// 设置可查看的物品描述
	set("item_desc", ([
		"太极图" : "太极图案深深刻在石台中央，阴阳两仪缓缓流转，蕴含着天地至理。\n"
		           "凝视太极图，你仿佛能感受到武当真传的奥妙所在。\n",
		"石台" : "这座太极台由整块巨石雕琢而成，工艺精湛，历经千年风雨依然完好。\n"
	]));
	
	setup();
}