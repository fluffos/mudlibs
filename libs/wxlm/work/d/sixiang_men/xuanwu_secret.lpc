// 玄武秘境


inherit ROOM;

void create()
{
    set("short", "玄武秘境");
    set("long", @LONG
这里是四象门的玄武秘境，是玄武流派最高深武学的传承之地。四周
水汽缭绕，墙壁上刻满了玄武心法的奥秘。中央有一个小型瀑布，据说
蕴含着玄武真水的奥秘。这里常年不对外开放，只有得到玄武堂主的
允许才能进入。空气中弥漫着一股神秘的力量，让人感到心旷神怡。
LONG );
    set("exits", ([
        "out" : __DIR__"xuanwu_pond",
    ]));
    set("objects", ([
        __DIR__"npc/xuanwu" : 1,
    ]));
    set("no_fight", 1);
    set("for_family", "四象门");
    set("item_desc", ([
        "瀑布" : popup_comb("一个小型瀑布，水流清澈见底，似乎蕴含着某种奥秘。",({ "参悟:comprehend" }) ),
    ]) );
    setup();
}

void init()
{
    add_action("do_comprehend", "comprehend");
}

int do_comprehend(string arg)
{
    object me = this_player();
    int comprehend_time;
    
    if (me->query("family/family_name") != "四象门")
        return notify_fail("只有四象门的弟子才能参悟玄武真水的奥秘。\n");
    
    if (me->is_busy() || me->is_fighting())
        return notify_fail("你现在正忙着呢。\n");
    
    if (me->query("jing") < 50)
        return notify_fail("你精神不济，无法参悟玄武真水的奥秘。\n");
    
    comprehend_time = 30 + random(30);
    
    message_vision("$N盘膝坐在瀑布前，开始参悟玄武真水的奥秘。\n", me);
    me->start_busy(comprehend_time);
    
    call_out("comprehend_result", comprehend_time, me);
    
    return 1;
}

void comprehend_result(object me)
{
    if (!me || environment(me) != this_object())
        return;
    
    if (random(me->query("int")) > 25)
    {
        tell_object(me, HIW"你突然领悟到了玄武真水的一丝奥秘，对玄武真身的理解加深了！\n"NOR);
        me->improve_skill("xuanwu-zhenshen", 10 + random(me->query("int")));
    }
    else
    {
        tell_object(me, "你苦思冥想，但是始终无法理解玄武真水的奥秘。\n");
    }
    
    me->receive_damage("jing", 30 + random(20));
}
