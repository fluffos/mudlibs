// 金刚练武场

inherit ROOM;

void create()
{
    set("short", "金刚练武场");
    set("long", @LONG
这里是四象门的金刚练武场，专门用于训练弟子的力量和防御。场地
坚固结实，四周摆放着各种沉重的器械。地面上还有不少凹痕，据说
是历代高手留下的。中央有一块巨大的石碑，上面刻满了白虎杀伐拳
的招式。几个铁人桩立在场地各处，供弟子们练习拳法。空气中弥漫
着浓重的汗水气息，彰显着这里艰苦的训练氛围。这里是锻炼筋骨和
修炼白虎杀伐拳的绝佳场所。
LONG );
    set("exits", ([
        "north" : __DIR__"baihu_peak",
    ]));
    set("outdoors", "sixiang_men");
    set("no_fight", 1);
    set("for_family", "四象门");
    set("item_desc", ([
        "石碑" : popup_comb("一块巨大的石碑，上面刻满了白虎杀伐拳的招式，似乎可以在这里练功。",({ "练功:practice_iron" }) ),
    ]) );
    setup();
}

void init()
{
    add_action("do_practice", "practice_iron");
    add_action("do_practice", "lian");
}

int do_practice(string arg)
{
    object me = this_player();
    
    if (me->query("family/family_name") != "四象门")
        return notify_fail("只有四象门的弟子才能在这里练功。\n");
    
    if (!arg || arg == "")
    {
        tell_object(me, popup_comb("你要练习什么？", ({
            "白虎杀伐拳:practice_iron baihu-quan"
        })));
        return 1;
    }
    
    if (arg == "baihu-quan")
    {
        tell_object(me, "你开始在金刚练武场专心练习白虎杀伐拳。\n");
        me->start_busy(3);
        call_out("practice_result", 3, me, arg);
        return 1;
    }
    
    return notify_fail("这里只能练习白虎杀伐拳。\n");
}

void practice_result(object me, string skill)
{
    if (!me || environment(me) != this_object())
        return;
    
    if (skill == "baihu-quan")
    {
        tell_object(me, "你对着铁人桩不断出拳，感觉白虎杀伐拳的威力更强了。\n");
        me->improve_skill("baihu-quan", 1 + random(me->query("str")));
    }
}
