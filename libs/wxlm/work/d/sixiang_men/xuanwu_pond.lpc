// 玄武潭


inherit ROOM;

void create()
{
    set("short", "玄武潭");
    set("long", @LONG
这里是四象门的玄武潭，一汪深邃的潭水宛如一面巨大的镜子，倒映
着天空的云彩。潭水四周长满了奇花异草，空气中弥漫着淡淡的水汽。
这里是玄武堂弟子修炼的主要场所，充满了神秘和宁静的气息。
LONG );
    set("exits", ([
        "up" : __DIR__"wuji_hall",
        "east" : __DIR__"xuanwu_hall",
        "west" : __DIR__"jingshui_field",
        "north" : __DIR__"xuanwu_secret",
    ]));
    set("outdoors", "sixiang_men");
    setup();
}
