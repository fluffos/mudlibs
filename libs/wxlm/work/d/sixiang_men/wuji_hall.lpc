// 无极殿


inherit ROOM;

void create()
{
    set("short", "无极殿");
    set("long", @LONG
这里是四象门的无极殿，四象门掌门无极真人的居所。殿内布置简洁
而庄重，四周墙壁上挂着四象图，分别代表青龙、白虎、朱雀、玄武。殿
中央有一个蒲团，是无极真人日常修炼之处。
LONG );
    set("exits", ([
        "south" : __DIR__"damen",
        "east" : __DIR__"qinglong_cliff",
        "west" : __DIR__"baihu_peak",
        "north" : __DIR__"zhuque_peak",
        "down" : __DIR__"xuanwu_pond",
    ]));
    set("objects", ([
        __DIR__"npc/wuji" : 1,
    ]));
    set("no_fight", 1);
    setup();
}
