// 疾风练武场

inherit ROOM;

void create()
{
    set("short", "疾风练武场");
    set("long", @LONG
这里是四象门的疾风练武场，专门用于训练弟子的身法和速度。场地
宽阔平整，四周布置着各种障碍物和训练器材。微风拂过，让人感觉
身轻如燕，正是练习轻功的绝佳场所。场地中央有一片开阔地带，地面
上画着复杂的步法图案，是弟子们练习身法的理想之处。几个木桩和
铁环散布在场地各处，供弟子们练习轻功和身法。空气中充满了活力，
让人忍不住想要奔跑跳跃。
LONG );
    set("exits", ([
        "north" : __DIR__"qinglong_cliff",
    ]));
    set("outdoors", "sixiang_men");
    set("no_fight", 1);
    set("for_family", "四象门");
    set("item_desc", ([
        "步法图案" : popup_comb("地面上画着复杂的步法图案，似乎可以在上面练功。",({ "练功:practice_wind" }) ),
    ]) );
    setup();
}

void init()
{
    add_action("do_practice", "practice_wind");
    add_action("do_practice", "lian");
}

int do_practice(string arg)
{
    object me = this_player();
    
    if (me->query("family/family_name") != "四象门")
        return notify_fail("只有四象门的弟子才能在这里练功。\n");
    
    if (!arg || arg == "")
    {
        tell_object(me, popup_comb("你要练习什么？", ({
            "四象神功:practice_wind sixiang-shengong",
            "四象步法:practice_wind sixiang-bufa"
        })));
        return 1;
    }
    
    if (arg == "sixiang-shengong" || arg == "sixiang-bufa")
    {
        tell_object(me, "你开始在疾风练武场专心练习" + to_chinese(arg) + "。\n");
        me->start_busy(3);
        call_out("practice_result", 3, me, arg);
        return 1;
    }
    
    return notify_fail("这里不适合练习这种功夫。\n");
}

void practice_result(object me, string skill)
{
    if (!me || environment(me) != this_object())
        return;
    
    if (skill == "sixiang-shengong")
    {
        tell_object(me, "你感觉内力运转更加迅速了。\n");
        me->improve_skill("sixiang-shengong", 1 + random(me->query("int")));
    }
    else if (skill == "sixiang-bufa")
    {
        tell_object(me, "你在复杂的步法图案上来回跳跃，身法更加敏捷了。\n");
        me->improve_skill("sixiang-bufa", 1 + random(me->query("dex")));
    }
}
