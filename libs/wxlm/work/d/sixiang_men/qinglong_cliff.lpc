// 青龙崖


inherit ROOM;

void create()
{
    set("short", "青龙崖");
    set("long", @LONG
这里是四象门的青龙崖，四周环绕着青翠的植被，空气中弥漫着淡淡的
灵气。崖壁上刻有一条栩栩如生的青龙图案，显得神秘而威严。这里是
青龙堂弟子修炼的主要场所。
LONG );
    set("exits", ([
        "west" : __DIR__"wuji_hall",
        "north" : __DIR__"qinglong_hall",
        "south" : __DIR__"jifeng_field",
        "east" : __DIR__"qinglong_secret",
    ]));
    set("outdoors", "sixiang_men");
    setup();
}
