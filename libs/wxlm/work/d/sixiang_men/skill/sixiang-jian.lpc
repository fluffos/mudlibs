// 四象剑法

inherit SKILL;

mapping *action = ({
    ([  "action" : "$N使出「青龙探爪」，手中$w化为一道青光，直刺$n的$l",
        "force" : 120,
        "dodge" : 20,
        "damage": 25,
        "lvl" : 0,
        "skill_name" : "青龙探爪",
        "damage_type" : "刺伤"
    ]),
    ([  "action" : "$N一式「白虎噬天」，$w挟着雷霆万钧之势扫向$n的$l",
        "force" : 140,
        "dodge" : 15,
        "damage": 30,
        "lvl" : 30,
        "skill_name" : "白虎噬天",
        "damage_type" : "割伤"
    ]),
    ([  "action" : "$N运转「朱雀焚天」，$w上下翻飞，散发出炽热的剑气击向$n",
        "force" : 160,
        "dodge" : 25,
        "damage": 35,
        "lvl" : 60,
        "skill_name" : "朱雀焚天",
        "damage_type" : "刺伤"
    ]),
    ([  "action" : "$N使出「玄武守一」，$w化作一道水幕，将$n笼罩其中",
        "force" : 180,
        "dodge" : 30,
        "damage": 40,
        "lvl" : 90,
        "skill_name" : "玄武守一",
        "damage_type" : "割伤"
    ]),
});

int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me)
{
    if ((int)me->query("max_neili") < 100)
        return notify_fail("你的内力不够，无法练习四象剑法。\n");
    if ((int)me->query_skill("sixiang-shengong", 1) < 20)
        return notify_fail("你的四象神功火候不够，无法练习四象剑法。\n");
    return 1;
}

string query_skill_name(int level)
{
    int i;
    for(i = sizeof(action)-1; i >= 0; i--)
        if(level >= action[i]["lvl"])
            return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    int i, level;
    level = (int)me->query_skill("sixiang-jian", 1);
    for(i = sizeof(action); i > 0; i--)
        if(level > action[i-1]["lvl"])
            return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    object weapon;
    if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对。\n");
    if ((int)me->query("qi") < 50)
        return notify_fail("你的体力不够练四象剑法。\n");
    if ((int)me->query("neili") < 30)
        return notify_fail("你的内力不够练四象剑法。\n");
    me->receive_damage("qi", 30);
    me->add("neili", -20);
    return 1;
}

string perform_action_file(string action)
{
    return __DIR__"sixiang-jian/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【四象剑法】" ZJBR ZJBR NOR;
    msg += WHT "四象剑法是四象门的基础剑法，融合青龙、白虎、朱雀、玄武四象之意，招式变化多端。" ZJBR ZJBR;

    msg += HIY "【学习要求】" ZJBR NOR;
    msg += "  内力最大值不少于100点" ZJBR;
    msg += "  四象神功20级以上" ZJBR;
    msg += "  需要剑类武器" ZJBR ZJBR;

    msg += HIY "【特殊效果】" ZJBR NOR;
    msg += "  可激发为剑法（sword）、招架（parry）" ZJBR;
    msg += "  随等级提升威力递增" ZJBR ZJBR;

    msg += HIY "【招式列表】" ZJBR NOR;
    msg += "1. 青龙探爪（0级）" ZJBR;
    msg += "2. 白虎噬天（30级）" ZJBR;
    msg += "3. 朱雀焚天（60级）" ZJBR;
    msg += "4. 玄武守一（90级）" ZJBR ZJBR;

    msg += HIY "【特殊招式】" ZJBR NOR;
    msg += "1. 四象合一" ZJBR;
    msg += "  要求：" ZJBR;
    msg += "    四象剑法等级100级" ZJBR;
    msg += "    四象神功等级100级" ZJBR;
    msg += "    当前内力200点" ZJBR;
    msg += "    需要剑类武器" ZJBR;
    msg += "    激发四象剑法为剑法" ZJBR;
    msg += "  效果：发出强力一击，四象之力在剑身上流转" ZJBR;
    msg += "  命中机制：(使用者剑法等级 + 内功等级) / 2 + 随机值 > 目标招架等级 + 轻功等级" ZJBR;
    msg += "  伤害计算：(剑法等级 + 内功等级) / 2 + 随机值" ZJBR;
    msg += "  消耗：命中消耗内力150点，未命中消耗内力50点" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 练习需要消耗气血30点，内力20点" ZJBR;
    msg += "2. 特殊招式只能在战斗中对敌人使用" ZJBR;
    msg += "3. 使用特殊招式后会有短暂的僵直时间" ZJBR;
    msg += "4. 必须手持剑类武器才能施展\n";

    return msg;
}
