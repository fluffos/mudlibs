// 白虎噬天


#include <combat.h>

inherit F_SSERVER;

string query_name() { return "白虎噬天"; }
string *pfm_type() { return ({ "cuff", }); }

int perform(object me, object target)
{
    string msg;
    int ap, dp, damage;

    if (! target) target = offensive_target(me);

    if (! target || ! me->is_fighting(target))
        return notify_fail("「白虎噬天」只能对战斗中的对手使用。\n");

    if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
        return notify_fail("「白虎噬天」只能空手使用。\n");

    if ((int)me->query_skill("baihu-quan", 1) < 100)
        return notify_fail("你的白虎杀伐拳不够娴熟，不会使用「白虎噬天」。\n");

    if ((int)me->query_skill("sixiang-shengong", 1) < 100)
        return notify_fail("你的四象神功不够高，不能使用「白虎噬天」。\n");

    if ((int)me->query("neili") < 200)
        return notify_fail("你的真气不够，无法使用「白虎噬天」。\n");

    if (me->query_skill_mapped("cuff") != "baihu-quan")
        return notify_fail("你没有激发白虎杀伐拳，无法使用「白虎噬天」。\n");

    if (! living(target))
        return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

    msg = HIW "$N" HIW "使出白虎杀伐拳的绝技「白虎噬天」，双拳携带着凌厉的劲风向$n" HIW "猛攻而去！\n" NOR;

    ap = me->query_skill("cuff") + me->query_skill("force");
    dp = target->query_skill("dodge") + target->query_skill("parry");

    if (COMBAT_D->hit_determination(me,target,ap,dp))
    {
        damage = ap / 2 + random(ap / 2);
        me->add("neili", -150);
        msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 60,
                                   HIR "$n" HIR "躲闪不及，被$N" HIR
                                   "这一连串的拳势击中，顿时吐血不止！\n" NOR);
        me->start_busy(2);
    } else
    {
        msg += CYN "可是$n" CYN "看破了$N"
               CYN "的攻势，巧妙地避开了这致命的一击。\n" NOR;
        me->add("neili", -50);
        me->start_busy(3);
    }
    message_combatd(msg, me, target);

    return 1;
}
