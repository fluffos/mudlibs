// 朱雀烈焰步

inherit SKILL;

string *dodge_msg = ({
    "$n一式「朱雀展翅」，身形轻盈地跃起，躲过了$N的攻击。",
    "$n使出「凤凰涅槃」，身形一转，已然避开$N的攻击。",
    "$n一招「烈焰腾空」，身体如火焰般闪烁，$N的攻击落空。",
    "$n施展「火舞飞扬」，身形飘忽不定，$N的攻击无从着力。",
});

int valid_enable(string usage) { return (usage == "dodge") || (usage == "move"); }

int valid_learn(object me)
{
    if ((int)me->query("max_neili") < 100)
        return notify_fail("你的内力不够，无法练习朱雀烈焰步。\n");
    return 1;
}

string query_dodge_msg(string limb)
{
    return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
    if ((int)me->query("qi") < 50)
        return notify_fail("你的体力太差了，不能练朱雀烈焰步。\n");
    me->receive_damage("qi", 40);
    return 1;
}

mixed valid_damage(object ob, object me, int damage, object weapon)
{
    int ap, dp, level;
    
    if ((int)me->query_skill("zhuque-bufa", 1) < 100 || 
        ! living(me))
        return;
    
    ap = ob->query_dex();
    dp = me->query_dex();
    level = me->query_skill("zhuque-bufa", 1);
    
    if (random(100) < 50 && dp > ap)
    {
        mixed busy_status = me->query_busy();
        if (intp(busy_status) && busy_status > 0)
        {
            int reduce_busy = 1;  // 减免1秒busy
            
            if (reduce_busy > 0)
            {
                tell_object(me, HIR "你施展朱雀烈焰步，身形如火焰般闪烁，减轻了忙乱的状态！\n" NOR);
                tell_object(ob, HIR "只见" + me->name() + "身形如火焰般闪烁，似乎减轻了忙乱的状态！\n" NOR);
                me->interrupt_me(me, reduce_busy);
            }
        }
        return;
    }
    
    return;
}

int query_effect_dodge(object attacker, object me)
{
    int lvl;

    lvl = me->query_skill("zhuque-bufa", 1);
    if (lvl < 50)  return 0;
    if (lvl < 100) return 30;
    if (lvl < 150) return 50;
    if (lvl < 200) return 80;
    if (lvl < 250) return 100;
    if (lvl < 300) return 120;
    if (lvl < 350) return 140;
    return 150;
}

// 在 zhuque-bufa 目录下创建 huowu-feiyang.c 文件

string perform_action_file(string action)
{
    return __DIR__"zhuque-bufa/" + action;
}
