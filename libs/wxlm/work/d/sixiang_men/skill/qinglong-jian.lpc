// 青龙天罡枪法

inherit SKILL;

mapping *action = ({
    ([  "action": "$N使出「青龙出水」，$w如蛟龙般自下而上扑向$n的$l",
        "force" : 120,
        "dodge" : 20,
        "damage": 30,
        "lvl"   : 0,
        "skill_name" : "青龙出水",
        "damage_type": "挫伤"
    ]),
    ([  "action": "$N一式「苍龙盘绕」，$w绕身疾转，击向$n的$l",
        "force" : 150,
        "dodge" : 15,
        "damage": 40,
        "lvl"   : 30,
        "skill_name" : "苍龙盘绕",
        "damage_type": "刺伤"
    ]),
    ([  "action": "$N使出「龙腾九天」，$w高高举起，以泰山压顶之势向$n当头砸下",
        "force" : 180,
        "dodge" : 15,
        "damage": 50,
        "lvl"   : 60,
        "skill_name" : "龙腾九天",
        "damage_type": "挫伤"
    ]),
    ([  "action": "$N一招「青龙摆尾」，$w横扫$n下盘，气势如虹",
        "force" : 200,
        "dodge" : 25,
        "damage": 60,
        "lvl"   : 90,
        "skill_name" : "青龙摆尾",
        "damage_type": "挫伤"
    ]),
});

int valid_enable(string usage) { return usage == "club" || usage == "parry"; }

int valid_learn(object me)
{
    if ((int)me->query("max_neili") < 100)
        return notify_fail("你的内力不够，无法练习青龙天罡枪法。\n");
    if ((int)me->query_skill("sixiang-shengong", 1) < 20)
        return notify_fail("你的四象神功火候不够，无法练习青龙天罡枪法。\n");
    return 1;
}

string query_skill_name(int level)
{
    int i;
    for(i = sizeof(action)-1; i >= 0; i--)
        if(level >= action[i]["lvl"])
            return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    int i, level;
    level = (int)me->query_skill("qinglong-jian", 1);
    for(i = sizeof(action); i > 0; i--)
        if(level > action[i-1]["lvl"])
            return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    object weapon;
    if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "club")
        return notify_fail("你使用的武器不对。\n");
    if ((int)me->query("qi") < 50)
        return notify_fail("你的体力不够练青龙天罡枪法。\n");
    me->receive_damage("qi", 30);
    return 1;
}

// 在 qinglong-jian 目录下创建 qinglong-chuhai.c 文件

string perform_action_file(string action)
{
    return __DIR__"qinglong-jian/" + action;
}

int difficult_level() 
{
    return 300;
}

string query_description()
{
    string msg;

    msg = HIY "【青龙天罡枪法】" ZJBR ZJBR NOR;
    msg += WHT "青龙天罡枪法是四象门的镇派枪法之一，以灵动迅捷著称，招式如青龙腾跃，气势磅礴。" ZJBR ZJBR;

    msg += HIY "【学习要求】" ZJBR NOR;
    msg += "  内力最大值不少于100点" ZJBR;
    msg += "  四象神功20级以上" ZJBR;
    msg += "  需要棍类武器" ZJBR ZJBR;

    msg += HIY "【特殊效果】" ZJBR NOR;
    msg += "  可激发为长兵法（club）、招架（parry）" ZJBR;
    msg += "  随等级提升威力递增" ZJBR ZJBR;

    msg += HIY "【招式列表】" ZJBR NOR;
    msg += "1. 青龙出水（0级）" ZJBR;
    msg += "2. 苍龙盘绕（30级）" ZJBR;
    msg += "3. 龙腾九天（60级）" ZJBR;
    msg += "4. 青龙摆尾（90级）" ZJBR ZJBR;

    msg += HIY "【特殊招式】" ZJBR NOR;
    msg += "1. 青龙出海" ZJBR;
    msg += "  要求：" ZJBR;
    msg += "    青龙天罡枪法等级100级" ZJBR;
    msg += "    四象神功等级100级" ZJBR;
    msg += "    当前内力200点" ZJBR;
    msg += "    需要棍类武器" ZJBR;
    msg += "    激发青龙天罡枪法为长兵法" ZJBR;
    msg += "  效果：发出强力一击" ZJBR;
    msg += "  命中机制：(使用者长兵法等级 + 内功等级) / 2 + 随机值 > 目标招架等级 + 轻功等级" ZJBR;
    msg += "  伤害计算：长兵法等级 + 内功等级 + 随机值" ZJBR;
    msg += "  消耗：命中消耗内力150点，未命中消耗内力50点" ZJBR ZJBR;

    msg += "2. 狂纵枪舞" ZJBR;
    msg += "  要求：" ZJBR;
    msg += "    青龙天罡枪法等级100级" ZJBR;
    msg += "    四象神功等级100级" ZJBR;
    msg += "    当前内力500点" ZJBR;
    msg += "    需要棍类武器" ZJBR;
    msg += "    激发青龙天罡枪法为长兵法" ZJBR;
    msg += "  效果：连续进行多次攻击" ZJBR;
    msg += "  命中机制：(四象神功等级 + 长兵法等级) / 2 + 随机值 > 目标内功等级 + 招架等级" ZJBR;
    msg += "  攻击次数：每500点内力可额外攻击一次（上限为当前内力的30%）" ZJBR;
    msg += "  消耗：每次攻击消耗内力500点" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 练习需要消耗气血50点" ZJBR;
    msg += "2. 特殊招式只能在战斗中对敌人使用" ZJBR;
    msg += "3. 使用特殊招式后会有短暂的僵直时间" ZJBR;
    msg += "4. 必须手持棍类武器才能施展\n";

    return msg;
}
