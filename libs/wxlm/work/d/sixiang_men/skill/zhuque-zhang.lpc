// 朱雀烈焰掌

inherit SKILL;

mapping *action = ({
    ([  "action": "$N一式「朱雀展翅」，双掌如翼般扇向$n的$l",
        "force" : 120,
        "dodge" : 20,
        "damage": 25,
        "lvl"   : 0,
        "skill_name" : "朱雀展翅",
        "damage_type": "瘀伤"
    ]),
    ([  "action": "$N使出「凤凰涅槃」，掌心烈焰升腾，击向$n的$l",
        "force" : 150,
        "dodge" : 15,
        "damage": 35,
        "lvl"   : 30,
        "skill_name" : "凤凰涅槃",
        "damage_type": "灼伤"
    ]),
    ([  "action": "$N一招「烈焰焚天」，双掌齐出，炽热掌风扫向$n的全身",
        "force" : 180,
        "dodge" : 25,
        "damage": 45,
        "lvl"   : 60,
        "skill_name" : "烈焰焚天",
        "damage_type": "灼伤"
    ]),
    ([  "action": "$N使出「朱雀啼鸣」，全身真气外放，形成火焰光环，扑向$n",
        "force" : 220,
        "dodge" : 30,
        "damage": 55,
        "lvl"   : 90,
        "skill_name" : "朱雀啼鸣",
        "damage_type": "内伤"
    ]),
});

int valid_enable(string usage) { return usage == "strike" || usage == "parry"; }

int valid_learn(object me)
{
    if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
        return notify_fail("练朱雀烈焰掌必须空手。\n");
    if ((int)me->query("max_neili") < 100)
        return notify_fail("你的内力不够，无法练习朱雀烈焰掌。\n");
    if ((int)me->query_skill("sixiang-shengong", 1) < 20)
        return notify_fail("你的四象神功火候不够，无法练习朱雀烈焰掌。\n");
    return 1;
}

string query_skill_name(int level)
{
    int i;
    for(i = sizeof(action)-1; i >= 0; i--)
        if(level >= action[i]["lvl"])
            return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    int i, level;
    level = (int)me->query_skill("zhuque-zhang", 1);
    for(i = sizeof(action); i > 0; i--)
        if(level > action[i-1]["lvl"])
            return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    if ((int)me->query("qi") < 30)
        return notify_fail("你的体力太低了。\n");
    if ((int)me->query("neili") < 20)
        return notify_fail("你的内力不够练朱雀烈焰掌。\n");
    me->receive_damage("qi", 25);
    me->add("neili", -5);
    return 1;
}

// 在 zhuque-zhang 目录下创建 fenghuang-niepan.c 文件

string perform_action_file(string action)
{
    return __DIR__"zhuque-zhang/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【朱雀烈焰掌】" ZJBR ZJBR NOR;
    msg += WHT "朱雀烈焰掌是四象门的镇派掌法之一，以刚猛霸道著称。掌力中蕴含着炽热的真气，" ZJBR;
    msg += "能灼伤敌人，掌法如朱雀展翅，气势磅礴。" ZJBR ZJBR;

    msg += HIY "【学习要求】" ZJBR NOR;
    msg += "  内力最大值不少于100点" ZJBR;
    msg += "  四象神功20级以上" ZJBR;
    msg += "  必须空手" ZJBR ZJBR;

    msg += HIY "【特殊效果】" ZJBR NOR;
    msg += "  可激发为掌法（strike）、招架（parry）" ZJBR;
    msg += "  部分招式可造成灼伤效果" ZJBR;
    msg += "  随等级提升威力递增" ZJBR ZJBR;

    msg += HIY "【招式列表】" ZJBR NOR;
    msg += "1. 朱雀展翅（0级）" ZJBR;
    msg += "   伤害：25点" ZJBR;
    msg += "   特效：瘀伤" ZJBR ZJBR;

    msg += "2. 凤凰涅槃（30级）" ZJBR;
    msg += "   伤害：35点" ZJBR;
    msg += "   特效：灼伤" ZJBR ZJBR;

    msg += "3. 烈焰焚天（60级）" ZJBR;
    msg += "   伤害：45点" ZJBR;
    msg += "   特效：灼伤" ZJBR ZJBR;

    msg += "4. 朱雀啼鸣（90级）" ZJBR;
    msg += "   伤害：55点" ZJBR;
    msg += "   特效：内伤" ZJBR ZJBR;

    msg += HIY "【特殊招式】" ZJBR NOR;
    msg += "凤凰涅槃" ZJBR;
    msg += "  要求：" ZJBR;
    msg += "    朱雀烈焰掌等级100级" ZJBR;
    msg += "    四象神功等级100级" ZJBR;
    msg += "    当前内力200点" ZJBR;
    msg += "    必须空手" ZJBR;
    msg += "    激发朱雀烈焰掌为掌法" ZJBR;
    msg += "  效果：双掌燃起烈焰进行强力一击" ZJBR;
    msg += "  命中机制：(掌法等级 + 内功等级) / 2 + 随机值 > 目标招架等级 + 轻功等级" ZJBR;
    msg += "  伤害计算：(掌法等级 + 内功等级) / 2 + 随机值" ZJBR;
    msg += "  消耗：命中消耗内力150点，未命中消耗内力50点" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 练习需要消耗气血25点，内力5点" ZJBR;
    msg += "2. 特殊招式只能在战斗中对敌人使用" ZJBR;
    msg += "3. 使用特殊招式后会有短暂的僵直时间" ZJBR;
    msg += "4. 必须空手才能施展\n";

    return msg;
}
