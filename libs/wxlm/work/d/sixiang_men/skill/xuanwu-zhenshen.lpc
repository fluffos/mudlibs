// 玄武真身

inherit SKILL;

int valid_enable(string usage) { return usage == "parry"; }

int valid_learn(object me)
{
    if ((int)me->query("con") < 26)
        return notify_fail("你的根骨太差，无法领会玄武真身的奥妙。\n");

    if ((int)me->query("int") < 26)
        return notify_fail("你的悟性不足，难以理解玄武真身的精髓。\n");

    if ((int)me->query_skill("force") < 150)
        return notify_fail("你的内功火候不够，难以修习玄武真身。\n");

    if ((int)me->query("max_neili") < 1500)
        return notify_fail("你的内力还不足以修习玄武真身。\n");

    if ((int)me->query_skill("sixiang-shengong", 1) < 100)
        return notify_fail("你的四象神功火候不够，无法修习玄武真身。\n");

    return 1;
}

mixed valid_damage(object ob, object me, int damage, object weapon)
{
    int ap, dp;
    int recover;
    
    if ((int)me->query_skill("xuanwu-zhenshen", 1) < 100 || 
        ! living(me))
        return;
    
    ap = ob->query_skill("parry");
    dp = me->query_skill("parry");
    
    if (dp > ap)
    {
        recover = damage / 5;  // 恢复受到伤害的20%
        me->add("neili", recover);
        if (me->query("neili") > me->query("max_neili"))
            me->set("neili", me->query("max_neili"));
        
        tell_object(me, HIB "你的玄武真身发动，吸收了部分攻击，转化为内力！\n" NOR);
        tell_object(ob, HIB "只见" + me->name() + "似乎吸收了你的攻击，转化为内力！\n" NOR);
    }
    
    return;
}

int query_effect_parry(object attacker, object me)
{
    int lvl;

    lvl = me->query_skill("xuanwu-zhenshen", 1);
    if (lvl < 100) return 0;
    if (lvl < 150) return 50;
    if (lvl < 200) return 60;
    if (lvl < 250) return 70;
    if (lvl < 300) return 80;
    if (lvl < 350) return 90;
    if (lvl < 400) return 100;
    return 120;
}

int practice_skill(object me)
{
    if (me->query_skill("xuanwu-zhenshen", 1) < 100)
        return notify_fail("你对玄武真身的了解还不够，还不足以自行锻炼。\n");

    if ((int)me->query("qi") < 70)
        return notify_fail("你的体力太低了。\n");

    if ((int)me->query("neili") < 100)
        return notify_fail("你的内力不够练玄武真身。\n");

    me->receive_damage("qi", 60);
    me->add("neili", -85);
    return 1;
}

string perform_action_file(string action)
{
    return __DIR__"xuanwu-zhenshen/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【玄武真身】" ZJBR ZJBR NOR;
    msg += WHT "玄武真身是四象门的镇派防御心法，以坚韧不拔著称。修炼者能将敌人的攻击化为己用，补充自身内力。" ZJBR ZJBR;

    msg += HIY "【学习要求】" ZJBR NOR;
    msg += "  根骨26点以上" ZJBR;
    msg += "  悟性26点以上" ZJBR;
    msg += "  内功等级150级" ZJBR;
    msg += "  内力最大值1500点" ZJBR;
    msg += "  四象神功100级以上" ZJBR ZJBR;

    msg += HIY "【特殊效果】" ZJBR NOR;
    msg += "  可激发为招架（parry）" ZJBR;
    msg += "  被动效果：招架等级高于攻击者时，可将伤害的20%转化为内力" ZJBR;
    msg += "  招架效果随等级提升：" ZJBR;
    msg += "    100级：50" ZJBR;
    msg += "    150级：60" ZJBR;
    msg += "    200级：70" ZJBR;
    msg += "    250级：80" ZJBR;
    msg += "    300级：90" ZJBR;
    msg += "    350级：100" ZJBR;
    msg += "    400级：120" ZJBR ZJBR;

    msg += HIY "【特殊招式】" ZJBR NOR;
    msg += "1. 玄武护体" ZJBR;
    msg += "  要求：" ZJBR;
    msg += "    玄武真身等级100级" ZJBR;
    msg += "    四象神功等级100级" ZJBR;
    msg += "    当前内力200点" ZJBR;
    msg += "    激发玄武真身为招架" ZJBR;
    msg += "  效果：提升防御力" ZJBR;
    msg += "  防御加成：玄武真身等级 / 2" ZJBR;
    msg += "  持续时间：等同于玄武真身等级" ZJBR;
    msg += "  消耗：内力100点" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 练习需要消耗气血60点，内力85点" ZJBR;
    msg += "2. 需要100级以上才能自行练习" ZJBR;
    msg += "3. 玄武护体同一时间只能使用一次" ZJBR;
    msg += "4. 使用玄武护体后会有短暂的僵直时间\n";

    return msg;
}
