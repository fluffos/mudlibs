// 凤凰涅槃


#include <combat.h>

inherit F_SSERVER;

string query_name() { return "凤凰涅槃"; }
string *pfm_type() { return ({ "strike", }); }

int perform(object me, object target)
{
    string msg;
    int ap, dp, damage;

    if (! target) target = offensive_target(me);

    if (! target || ! me->is_fighting(target))
        return notify_fail("「凤凰涅槃」只能对战斗中的对手使用。\n");

    if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
        return notify_fail("「凤凰涅槃」只能空手使用。\n");

    if ((int)me->query_skill("zhuque-zhang", 1) < 100)
        return notify_fail("你的朱雀烈焰掌不够娴熟，不会使用「凤凰涅槃」。\n");

    if ((int)me->query_skill("sixiang-shengong", 1) < 100)
        return notify_fail("你的四象神功不够高，不能使用「凤凰涅槃」。\n");

    if ((int)me->query("neili") < 200)
        return notify_fail("你的真气不够，无法使用「凤凰涅槃」。\n");

    if (me->query_skill_mapped("strike") != "zhuque-zhang")
        return notify_fail("你没有激发朱雀烈焰掌，无法使用「凤凰涅槃」。\n");

    if (! living(target))
        return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

    msg = HIR "$N" HIR "使出朱雀烈焰掌的绝技「凤凰涅槃」，双掌燃起熊熊烈焰，向$n" HIR "猛然拍去！\n" NOR;

    ap = me->query_skill("strike") + me->query_skill("force");
    dp = target->query_skill("dodge") + target->query_skill("parry");

    if (COMBAT_D->hit_determination(me,target,ap,dp))
    {
        damage = ap / 2 + random(ap / 2);
        me->add("neili", -150);
        msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 60,
                                   HIR "$n" HIR "躲闪不及，被$N" HIR
                                   "这炽热的一掌击中，顿时皮肉焦糊！\n" NOR);
        me->start_busy(2);
    } else
    {
        msg += CYN "可是$n" CYN "看破了$N"
               CYN "的攻势，巧妙地避开了这致命的一击。\n" NOR;
        me->add("neili", -50);
        me->start_busy(3);
    }
    message_combatd(msg, me, target);

    return 1;
}
