// 四象神功

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

int valid_learn(object me)
{
    if ((int)me->query("max_neili") < 100)
        return notify_fail("你的内力太弱，无法练习四象神功。\n");
    return 1;
}

int practice_skill(object me)
{
    return notify_fail("四象神功只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
    return __DIR__"sixiang-shengong/" + func;
}

int valid_force(string force)
{
    return force == "sixiang-shengong" || force == "huntian-qigong";
}

int difficult_level()
{
    return 200;
}

int query_neili_improve(object me)
{
        int lvl;

        lvl = (int)me->query_skill("sixiang-shengong", 1);
        return lvl / 10 * lvl / 10 * 15 * 25 / 10 / 20;
}

string query_description()
{
    string msg;

    msg = HIY "【四象神功】" ZJBR ZJBR NOR;
    msg += WHT "四象门镇派内功，融合青龙、白虎、朱雀、玄武四象之力，内力精纯浑厚。" ZJBR ZJBR;

    msg += HIY "【学习要求】" ZJBR NOR;
    msg += "  内力最大值不少于100点" ZJBR ZJBR;

    msg += HIY "【特殊效果】" ZJBR NOR;
    msg += "  可激发为内功（force）" ZJBR;
    msg += "  内力系数25" ZJBR ZJBR;

    msg += HIY "【特殊招式】" ZJBR NOR;
    msg += "四象归元" ZJBR;
    msg += "  要求：" ZJBR;
    msg += "    四象神功等级100级" ZJBR;
    msg += "    当前内力500点" ZJBR;
    msg += "  效果：恢复气血和内力" ZJBR;
    msg += "  恢复数值：气血恢复内功等级点，内力恢复内功等级/2点" ZJBR;
    msg += "  消耗：内力200点" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 只能通过学习提升熟练度" ZJBR;
    msg += "2. 特殊招式使用后会有短暂的僵直时间\n";

    return msg;
}
