// 白虎杀伐拳

inherit SKILL;

mapping *action = ({
    ([  "action": "$N使出「白虎亮爪」，双拳如虎爪般直击$n的$l",
        "force" : 120,
        "dodge" : 15,
        "damage": 25,
        "lvl"   : 0,
        "skill_name" : "白虎亮爪",
        "damage_type": "瘀伤"
    ]),
    ([  "action": "$N一式「虎啸山林」，声若雷霆，拳势凌厉，击向$n的$l",
        "force" : 150,
        "dodge" : 20,
        "damage": 35,
        "lvl"   : 30,
        "skill_name" : "虎啸山林",
        "damage_type": "瘀伤"
    ]),
    ([  "action": "$N使出「白虎扑食」，身形急冲，双拳齐出，直取$n的$l",
        "force" : 180,
        "dodge" : 15,
        "damage": 45,
        "lvl"   : 60,
        "skill_name" : "白虎扑食",
        "damage_type": "瘀伤"
    ]),
    ([  "action": "$N一招「百兽之王」，气势磅礴，连环出拳，攻向$n的全身要害",
        "force" : 220,
        "dodge" : 25,
        "damage": 55,
        "lvl"   : 90,
        "skill_name" : "百兽之王",
        "damage_type": "瘀伤"
    ]),
});

int valid_enable(string usage) { return usage == "cuff" || usage == "parry"; }

int valid_learn(object me)
{
    if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
        return notify_fail("练白虎杀伐拳必须空手。\n");
    if ((int)me->query("max_neili") < 100)
        return notify_fail("你的内力不够，无法练习白虎杀伐拳。\n");
    if ((int)me->query_skill("sixiang-shengong", 1) < 20)
        return notify_fail("你的四象神功火候不够，无法练习白虎杀伐拳。\n");
    return 1;
}

string query_skill_name(int level)
{
    int i;
    for(i = sizeof(action)-1; i >= 0; i--)
        if(level >= action[i]["lvl"])
            return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
    int i, level;
    level = (int)me->query_skill("baihu-quan", 1);
    for(i = sizeof(action); i > 0; i--)
        if(level > action[i-1]["lvl"])
            return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
    if ((int)me->query("qi") < 30)
        return notify_fail("你的体力太低了。\n");
    if ((int)me->query("neili") < 20)
        return notify_fail("你的内力不够练白虎杀伐拳。\n");
    me->receive_damage("qi", 25);
    me->add("neili", -5);
    return 1;
}

// 在 baihu-quan 目录下创建 baihu-shitian.c 文件

string perform_action_file(string action)
{
    return __DIR__"baihu-quan/" + action;
}

string query_description()
{
    string msg;

    msg = HIY "【白虎杀伐拳】" ZJBR ZJBR NOR;
    msg += WHT "白虎杀伐拳是四象门的镇派拳法之一，以刚猛凌厉著称，招式如白虎下山，势不可挡。" ZJBR ZJBR;

    msg += HIY "【学习要求】" ZJBR NOR;
    msg += "  内力最大值不少于100点" ZJBR;
    msg += "  四象神功20级以上" ZJBR;
    msg += "  必须空手" ZJBR ZJBR;

    msg += HIY "【特殊效果】" ZJBR NOR;
    msg += "  可激发为拳法（cuff）、招架（parry）" ZJBR;
    msg += "  随等级提升威力递增" ZJBR ZJBR;

    msg += HIY "【招式列表】" ZJBR NOR;
    msg += "1. 白虎亮爪（0级）" ZJBR;
    msg += "2. 虎啸山林（30级）" ZJBR;
    msg += "3. 白虎扑食（60级）" ZJBR;
    msg += "4. 百兽之王（90级）" ZJBR ZJBR;

    msg += HIY "【特殊招式】" ZJBR NOR;
    msg += "1. 白虎噬天" ZJBR;
    msg += "  要求：" ZJBR;
    msg += "    白虎杀伐拳等级100级" ZJBR;
    msg += "    四象神功等级100级" ZJBR;
    msg += "    当前内力200点" ZJBR;
    msg += "    空手" ZJBR;
    msg += "    激发白虎杀伐拳为拳法" ZJBR;
    msg += "  效果：发出凌厉连击" ZJBR;
    msg += "  命中机制：(使用者拳脚等级 + 内功等级) / 2 + 随机值 > 目标招架等级 + 轻功等级" ZJBR;
    msg += "  伤害计算：(拳脚等级 / 2 + 随机值)" ZJBR;
    msg += "  消耗：命中消耗内力150点，未命中消耗内力50点" ZJBR ZJBR;

    msg += HIR "【注意事项】" ZJBR NOR;
    msg += "1. 练习需要消耗气血25点，内力5点" ZJBR;
    msg += "2. 特殊招式只能在战斗中对敌人使用" ZJBR;
    msg += "3. 使用特殊招式后会有短暂的僵直时间\n";

    return msg;
}
