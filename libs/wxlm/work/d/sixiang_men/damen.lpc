// 四象门大门


inherit ROOM;

void create()
{
    set("short", "四象门山门");
    set("long", @LONG
这里是四象门的山门所在。四周环绕着奇花异草，灵气浓郁。一座
古朴的石牌坊上刻着"四象门"三个大字，笔力遒劲，气势非凡。山门
两侧是两尊石狮，威武庄严。往北是一条石阶小路，通往四象门的内部。
LONG );
    set("exits", ([
        "north" : __DIR__"wuji_hall",
        // "south" : "/d/city/beimen",
    ]));
    set("objects", ([
        __DIR__"npc/guard" : 2,
    ]));
    set("outdoors", "sixiang_men");
    setup();
}

