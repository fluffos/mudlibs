// 白虎堂


inherit ROOM;

void create()
{
    set("short", "白虎堂");
    set("long", @LONG
这里是四象门的白虎堂，是白虎流派弟子们学习和休息的地方。堂内
布置简单而庄重，墙上挂着一幅巨大的白虎图，威风凛凛。堂中摆放
着各种练功器械，处处彰显着刚猛的武学特色。
LONG );
    set("exits", ([
        "south" : __DIR__"baihu_peak",
    ]));
    set("objects", ([
        __DIR__"npc/bairen" : 1,
    ]));
    setup();
}
