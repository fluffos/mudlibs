// 烈焰练武场


inherit ROOM;

void create()
{
    set("short", "烈焰练武场");
    set("long", @LONG
这里是四象门的烈焰练武场，专门用于训练弟子的身法和速度。场地
四周燃烧着熊熊烈火，中央是一片由特殊材料制成的耐热地面。地面
上绘制着复杂的步法图案，闪烁着火焰般的光芒。几个火圈悬挂在
空中，是弟子们练习轻功的绝佳工具。空气中弥漫着灼热的气息，
让人感觉如同置身火焰之中。这里是修炼朱雀烈焰步的理想场所。
LONG );
    set("exits", ([
        "south" : __DIR__"zhuque_hall",
    ]));
    set("outdoors", "sixiang_men");
    set("no_fight", 1);
    set("for_family", "四象门");
    set("item_desc", ([
        "步法图案" : popup_comb("地面上绘制着复杂的步法图案，闪烁着火焰般的光芒，似乎可以在这里练习朱雀烈焰步。",({ "练功:practice_fire" }) ),
    ]) );
    setup();
}

void init()
{
    add_action("do_practice", "practice_fire");
    add_action("do_practice", "lian");
}

int do_practice(string arg)
{
    object me = this_player();
    
    if (me->query("family/family_name") != "四象门")
        return notify_fail("只有四象门的弟子才能在这里练功。\n");
    
    if (!arg || arg == "")
    {
        tell_object(me, popup_comb("你要练习什么？", ({
            "朱雀烈焰步:practice_fire zhuque-bufa"
        })));
        return 1;
    }
    
    if (arg == "zhuque-bufa")
    {
        tell_object(me, "你开始在烈焰练武场专心练习朱雀烈焰步。\n");
        me->start_busy(3);
        call_out("practice_result", 3, me, arg);
        return 1;
    }
    
    return notify_fail("这里只能练习朱雀烈焰步。\n");
}

void practice_result(object me, string skill)
{
    if (!me || environment(me) != this_object())
        return;
    
    if (skill == "zhuque-bufa")
    {
        tell_object(me, "你在火焰中来回穿梭，感觉朱雀烈焰步的身法更加灵活了。\n");
        me->improve_skill("zhuque-bufa", 1 + random(me->query("dex")));
    }
}
