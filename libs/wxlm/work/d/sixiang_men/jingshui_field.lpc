// 静水练武场


inherit ROOM;

void create()
{
    set("short", "静水练武场");
    set("long", @LONG
这里是四象门的静水练武场，专门用于训练弟子的内功心法和控制能力。
场地四周环绕着几条小溪，流水声潺潺，给人一种宁静祥和的感觉。中央
有一片平静如镜的水面，是弟子们练习轻功和水上漂的绝佳场所。几个木
桩零散地立在水中，供弟子们练习平衡和身法。空气中弥漫着淡淡的水汽，
让人感觉神清气爽。
LONG );
    set("exits", ([
        "east" : __DIR__"xuanwu_pond",
    ]));
    set("outdoors", "sixiang_men");
    set("no_fight", 1);
    set("for_family", "四象门");
    set("item_desc", ([
        "水面" : popup_comb("一片平静如镜的水面，似乎可以在上面练功。",({ "练功:practice_water" }) ),
    ]) );
    setup();
}

void init()
{
    add_action("do_practice", "practice_water");
    add_action("do_practice", "lian");
}

int do_practice(string arg)
{
    object me = this_player();
    
    if (me->query("family/family_name") != "四象门")
        return notify_fail("只有四象门的弟子才能在这里练功。\n");
    
    if (!arg || arg == "")
    {
        tell_object(me, popup_comb("你要练习什么？", ({
            "四象神功:practice_water sixiang-shengong",
            "四象步法:practice_water sixiang-bufa"
        })));
        return 1;
    }
    
    if (arg == "sixiang-shengong" || arg == "sixiang-bufa")
    {
        tell_object(me, "你开始在静水练武场专心练习" + to_chinese(arg) + "。\n");
        me->start_busy(3);
        call_out("practice_result", 3, me, arg);
        return 1;
    }
    
    return notify_fail("这里不适合练习这种功夫。\n");
}

void practice_result(object me, string skill)
{
    if (!me || environment(me) != this_object())
        return;
    
    if (skill == "sixiang-shengong")
    {
        tell_object(me, "你感觉内力运转更加顺畅了。\n");
        me->improve_skill("sixiang-shengong", 1 + random(me->query("int")));
    }
    else if (skill == "sixiang-bufa")
    {
        tell_object(me, "你在水面上来回跳跃，身法更加灵活了。\n");
        me->improve_skill("sixiang-bufa", 1 + random(me->query("dex")));
    }
}
