// 朱雀峰


inherit ROOM;

void create()
{
    set("short", "朱雀峰");
    set("long", @LONG
这里是四象门的朱雀峰，四周郁郁葱葱，山顶常年笼罩着一层薄雾。
峰顶有一块形似朱雀的赤红岩石，在阳光下熠熠生辉。这里是朱雀堂
弟子修炼的主要场所，空气中弥漫着淡淡的火热气息。
LONG );
    set("exits", ([
        "south" : __DIR__"wuji_hall",
        "east" : __DIR__"zhuque_hall",
        "west" : __DIR__"lieyan_field",
        "north" : __DIR__"zhuque_secret",
    ]));
    set("outdoors", "sixiang_men");
    setup();
}
