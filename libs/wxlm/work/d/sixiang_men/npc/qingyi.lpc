// 青翼

inherit NPC;
inherit F_MASTER;

void create()
{
    set_name("青翼", ({ "qing yi", "qing", "yi" }));
    set("long", @LONG
青翼是四象门青龙堂的堂主，剑法高超，身法迅捷，以速度和敏捷著称。
他看起来冷静果断，眼神中透露出锐利的光芒。
LONG);
    set("gender", "男性");
    set("age", 35);
    set("attitude", "peaceful");
    set("shen_type", 1);
    set("str", 30);
    set("int", 30);
    set("con", 30);
    set("dex", 35);
    
    set("max_qi", 3000);
    set("max_jing", 2000);
    set("neili", 3000);
    set("max_neili", 3000);
    set("jiali", 100);
    set("combat_exp", 1000000);

    set_skill("force", 700);
    set_skill("sixiang-shengong", 700);
    set_skill("dodge", 700);
    set_skill("sixiang-bufa", 700);
    set_skill("parry", 700);
    set_skill("sword", 700);
    set_skill("qinglong-jian", 700);

    map_skill("force", "sixiang-shengong");
    map_skill("dodge", "sixiang-bufa");
    map_skill("parry", "qinglong-jian");
    map_skill("sword", "qinglong-jian");

    create_family("四象门", 2, "青龙堂主");

    setup();
    
    carry_object("/clone/weapon/changjian")->wield();
    carry_object("/clone/cloth/cloth")->wear();
}

void attempt_apprentice(object ob)
{
    if (ob->query("dex") < 25) {
        command("say 青龙堂的武功讲究身法灵活，你的身法还不够敏捷。（要求25点先天身法）");
        return;
    }
    if (ob->query("int") < 20) {
        command("say 修炼青龙天罡枪法需要一定的悟性，你还需要多加修炼。（要求20点先天悟性）");
        return;
    }
    if (ob->query("combat_exp") < 35000) {
        command("say 你的实战经验不足，还需要多加历练。（要求35000经验）");
        return;
    }
    command("smile");
    command("say 很好，希望你能将青龙堂的武学发扬光大。");
    command("recruit " + ob->query("id"));
}
