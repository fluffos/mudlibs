// 无极真人


inherit NPC;
inherit F_MASTER;
inherit F_QUESTER;
void create()
{
    set_name("无极真人", ({ "wuji zhenren", "wuji", "zhenren" }));
    set("long", @LONG
无极真人是四象门的现任掌门，深谙四象之理，武学造诣极高，
德高望重，深受弟子爱戴。他看起来平和稳重，双目炯炯有神，
显示出深不可测的智慧。
LONG);
    set("gender", "男性");
    set("age", 60);
    set("attitude", "peaceful");
    set("shen_type", 1);
    set("str", 30);
    set("int", 30);
    set("con", 30);
    set("dex", 30);
    
    set("max_qi", 50000);
    set("max_jing", 30000);
    set("neili", 50000);
    set("max_neili", 50000);
    set("jiali", 150);
    set("combat_exp", 200000000);

    set_skill("force", 1000);
    set_skill("sixiang-shengong", 1000);
    set_skill("dodge", 1000);
    set_skill("sixiang-bufa", 1000);
    set_skill("parry", 1000);
    set_skill("sword", 1000);
    set_skill("sixiang-jian", 1000);

    map_skill("force", "sixiang-shengong");
    map_skill("dodge", "sixiang-bufa");
    map_skill("parry", "sixiang-jian");
    map_skill("sword", "sixiang-jian");

    create_family("四象门", 1, "掌门");

    setup();
    
    carry_object("/clone/weapon/changjian")->wield();
    carry_object("/clone/cloth/cloth")->wear();
}

void attempt_apprentice(object ob)
{
    // 收徒条件
    if ((int)ob->query("str") < 20 || (int)ob->query("int") < 20 ||
        (int)ob->query("con") < 20 || (int)ob->query("dex") < 20)
    {
        command("say 我四象门讲究四维平衡，你的资质还需要继续提升。（要求20点先天四维）");
        return;
    }
    
    command("nod");
    command("say 好，希望你能勤学苦练，早日领悟四象之道。");
    command("recruit " + ob->query("id"));
}
