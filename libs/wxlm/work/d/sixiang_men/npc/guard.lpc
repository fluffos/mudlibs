// 四象门守卫

inherit NPC;

void create()
{
    set_name("四象门守卫", ({ "sixiang guard", "guard" }));
    set("long", "这是一位四象门的守卫，负责保护山门安全。他看起来十分强壮，气势不凡。\n");
    set("gender", "男性");
    set("age", 30);
    set("attitude", "peaceful");
    set("shen_type", 1);
    set("str", 25 * 8);
    set("int", 20 * 8);
    set("con", 25 * 8);
    set("dex", 25 * 8);
    
    set("max_qi", 1000 * 8);
    set("max_jing", 800 * 8);
    set("neili", 1000 * 8);
    set("max_neili", 1000 * 8);
    set("jiali", 50 * 8);
    set("combat_exp", 50000 * 8);

    set_skill("force", 500);
    set_skill("sixiang-shengong", 500);
    set_skill("dodge", 500);
    set_skill("sixiang-bufa", 500);
    set_skill("parry", 500);
    set_skill("sword", 500);
    set_skill("sixiang-jian", 500);

    map_skill("force", "sixiang-shengong");
    map_skill("dodge", "sixiang-bufa");
    map_skill("parry", "sixiang-jian");
    map_skill("sword", "sixiang-jian");

    setup();
    
    carry_object("/clone/weapon/changjian")->wield();
    carry_object("/clone/cloth/cloth")->wear();
}
