// 玄武圣者

inherit NPC;
inherit F_MASTER;

void create()
{
    set_name("玄武圣者", ({ "xuanwu shengzhe", "xuanwu", "shengzhe" }));
    set("long", @LONG
玄武圣者是四象门玄武堂的堂主，精通治疗和控制之术。他看起来
年纪已长，但精神矍铄，给人一种深不可测的感觉。
LONG);
    set("gender", "男性");
    set("age", 60);
    set("attitude", "peaceful");
    set("shen_type", 1);
    set("str", 25);
    set("int", 35);
    set("con", 30);
    set("dex", 25);
    
    set("max_qi", 3500);
    set("max_jing", 3000);
    set("neili", 4000);
    set("max_neili", 4000);
    set("jiali", 100);
    set("combat_exp", 1500000);

    set_skill("force", 700);
    set_skill("sixiang-shengong", 700);
    set_skill("dodge", 700);
    set_skill("sixiang-bufa", 700);
    set_skill("parry", 700);
    set_skill("xuanwu-zhenshen", 700);
    set_skill("medical", 700);

    map_skill("force", "sixiang-shengong");
    map_skill("dodge", "sixiang-bufa");
    map_skill("parry", "xuanwu-zhenshen");

    create_family("四象门", 2, "玄武堂主");

    setup();
    
    carry_object("/clone/cloth/cloth")->wear();
}

void attempt_apprentice(object ob)
{
    if (ob->query("int") < 25) {
        command("say 我们玄武堂注重智慧和内力的修炼，你的悟性还不够。（要求25点先天悟性）");
        return;
    }
    if (ob->query("con") < 20) {
        command("say 修炼玄武真身需要强健的体魄，你的根骨还需要锻炼。（要求20点先天根骨）");
        return;
    }
    if (ob->query("combat_exp") < 50000) {
        command("say 你的实战经验太少，还需要多加历练。（要求50000经验）");
        return;
    }
    command("nod");
    command("say 不错，希望你能勤加修炼，为四象门增光添彩。");
    command("recruit " + ob->query("id"));
}
