// 火舞

inherit NPC;
inherit F_MASTER;

void create()
{
    set_name("火舞", ({ "huo wu", "huo", "wu" }));
    set("long", @LONG
火舞是四象门朱雀堂的堂主，精通火系武学，性情如火，热情奔放。
她的眼神中似乎有火焰在跳动，给人一种炽热的感觉。
LONG);
    set("gender", "女性");
    set("age", 25);
    set("attitude", "friendly");
    set("shen_type", 1);
    set("str", 25 * 8);
    set("int", 30 * 8);
    set("con", 25 * 8);
    set("dex", 30 * 8);
    
    set("max_qi", 1800 * 8);
    set("max_jing", 1400 * 8);
    set("neili", 1800 * 8);
    set("max_neili", 1800 * 8);
    set("jiali", 80 * 8);
    set("combat_exp", 400000 * 8);

    set_skill("force", 140 * 8);
    set_skill("sixiang-shengong", 140 * 8);
    set_skill("dodge", 140 * 8);
    set_skill("sixiang-bufa", 140 * 8);
    set_skill("parry", 140 * 8);
    set_skill("unarmed", 140 * 8);
    set_skill("zhuque-zhang", 140 * 8);
    set_skill("literate", 100 * 8);

    map_skill("force", "sixiang-shengong");
    map_skill("dodge", "sixiang-bufa");
    map_skill("parry", "zhuque-zhang");
    map_skill("strike", "zhuque-zhang");

    prepare_skill("strike", "zhuque-zhang");

    create_family("四象门", 2, "朱雀堂主");

    setup();
    
    carry_object("/clone/cloth/cloth")->wear();
}

void attempt_apprentice(object ob)
{
    if (ob->query("dex") < 25) {
        command("say 朱雀堂的武功讲究身法灵活，你的身法还不够敏捷。（要求25点先天身法）");
        return;
    }
    if (ob->query("str") < 20) {
        command("say 练习朱雀烈焰掌需要一定的臂力，你还需要多加锻炼。（要求20点先天臂力）");
        return;
    }
    if (ob->query("combat_exp") < 40000) {
        command("say 你的实战经验不足，还需要多加历练。（要求40000经验）");
        return;
    }
    command("smile");
    command("say 很好，希望你能将朱雀之道发扬光大。");
    command("recruit " + ob->query("id"));
}
