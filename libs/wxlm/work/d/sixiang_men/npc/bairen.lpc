// 白刃

inherit NPC;
inherit F_MASTER;

void create()
{
    set_name("白刃", ({ "bai ren", "bai", "ren" }));
    set("long", @LONG
白刃是四象门白虎堂的堂主，力大无穷，防御坚固。他身材魁梧，
给人一种不可撼动的感觉。
LONG);
    set("gender", "男性");
    set("age", 35);
    set("attitude", "friendly");
    set("shen_type", 1);
    set("str", 30 * 8);
    set("int", 30 * 8);
    set("con", 30 * 8);
    set("dex", 30 * 8);
    
    set("max_qi", 2000 * 8);
    set("max_jing", 1500 * 8);
    set("neili", 2000 * 8);
    set("max_neili", 2000 * 8);
    set("jiali", 100 * 8);
    set("combat_exp", 500000 * 8);

    set_skill("force", 700);
    set_skill("sixiang-shengong", 700);
    set_skill("dodge", 700);
    set_skill("sixiang-bufa", 700);
    set_skill("parry", 700);
    set_skill("sword", 700);
    set_skill("sixiang-jian", 700);
    set_skill("literate", 700);

    map_skill("force", "sixiang-shengong");
    map_skill("dodge", "sixiang-bufa");
    map_skill("parry", "baihu-quan");
    map_skill("cuff", "baihu-quan");

    prepare_skill("cuff", "baihu-quan");

    create_family("四象门", 2, "白虎堂主");

    setup();
    
    carry_object("/clone/cloth/cloth")->wear();
}

void attempt_apprentice(object ob)
{
    if (ob->query("str") < 25) {
        command("say 白虎堂的武功讲究刚猛有力，你的臂力还不够强。（要求25点先天臂力）");
        return;
    }
    if (ob->query("con") < 20) {
        command("say 修炼白虎杀伐拳需要强健的体魄，你的根骨还需要锻炼。（要求20点先天根骨）");
        return;
    }
    if (ob->query("combat_exp") < 45000) {
        command("say 你的实战经验不足，还需要多加历练。（要求45000经验）");
        return;
    }
    command("nod");
    command("say 不错，希望你能将白虎堂的威名发扬光大。");
    command("recruit " + ob->query("id"));
}
