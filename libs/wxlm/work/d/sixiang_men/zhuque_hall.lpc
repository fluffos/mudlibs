// 朱雀堂


inherit ROOM;

void create()
{
    set("short", "朱雀堂");
    set("long", @LONG
这里是四象门的朱雀堂，是朱雀流派弟子们学习和休息的地方。堂内
装饰华丽，墙上挂着一幅巨大的朱雀图，栩栩如生。堂中燃烧着几盆
不灭的火焰，据说是用来锻炼弟子们对火的抗性。
LONG );
    set("exits", ([
        "west" : __DIR__"zhuque_peak",
    ]));
    set("objects", ([
        __DIR__"npc/huowu" : 1,
    ]));
    setup();
}
