// 玄武堂


inherit ROOM;

void create()
{
    set("short", "玄武堂");
    set("long", @LONG
这里是四象门的玄武堂，是玄武流派弟子们学习和休息的地方。堂内
布置简洁而神秘，墙上挂着一幅巨大的玄武图，庄严肃穆。堂中央有
一个小型水池，水面平静如镜，据说能够帮助弟子们冥想修炼。
LONG );
    set("exits", ([
        "west" : __DIR__"xuanwu_pond",
    ]));
    set("objects", ([
        __DIR__"npc/xuanwu" : 1,
    ]));
    setup();
}
