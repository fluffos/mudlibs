// 青龙堂


inherit ROOM;

void create()
{
    set("short", "青龙堂");
    set("long", @LONG
这里是四象门的青龙堂，是青龙流派弟子们学习和休息的地方。堂内
布置简单却不失典雅，墙上挂着一幅巨大的青龙图，栩栩如生。堂中
央放着几张桌椅，供弟子们讨论武学之用。
LONG );
    set("exits", ([
        "south" : __DIR__"qinglong_cliff",
    ]));
    set("objects", ([
        __DIR__"npc/qingyi" : 1,
    ]));
    setup();
}
