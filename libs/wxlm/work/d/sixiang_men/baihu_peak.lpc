// 白虎峰


inherit ROOM;

void create()
{
    set("short", "白虎峰");
    set("long", @LONG
这里是四象门的白虎峰，四周岩石嶙峋，气势雄伟。峰顶有一块巨大
的白色岩石，远看酷似一只蹲伏的白虎。这里是白虎堂弟子修炼的
主要场所，空气中充满了刚猛的气息。
LONG );
    set("exits", ([
        "east" : __DIR__"wuji_hall",
        "north" : __DIR__"baihu_hall",
        "south" : __DIR__"jingang_field",
        "west" : __DIR__"baihu_secret",
    ]));
    set("outdoors", "sixiang_men");
    setup();
}
