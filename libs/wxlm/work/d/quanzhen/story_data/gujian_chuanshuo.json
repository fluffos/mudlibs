{
    "id": "gujian_chuanshuo",
    "title": "古剑传说",
    "intro": "昨夜贫道于山中打坐，忽见天际有异象，一道剑光自九天而降，直坠东海之滨。随即天地间剑气纵横，海浪翻涌，似有神兵出世。古籍有载，上古神剑现世必有其因，或是天下将有大事发生，或是有缘之人当得此剑。施主气度不凡，莫非此剑与你有缘？",
    "chapters": [
        {
            "id": 1,
            "title": "东海寻剑",
            "content": "你们经过数日跋涉来到东海之滨，果然在一处奇异的礁石群中发现了那把传说中的古剑。剑身通体碧绿，如海水般深邃，剑柄镶嵌着夜明珠，在阳光下闪闪发光。但奇怪的是，古剑被无数海藻和珊瑚缠绕，仿佛在海底沉睡了千年。更诡异的是，周围的海水呈现出淡淡的银光，还有阵阵若有若无的剑吟声传来。",
            "choices": [
                {
                    "text": "不顾一切直接拔剑",
                    "action": "pull_sword_directly",
                    "type": "impatient",
                    "description": "迫不及待地想要得到神剑"
                },
                {
                    "text": "先祭拜海神再取剑",
                    "action": "worship_sea_god",
                    "type": "respectful",
                    "description": "以礼待神，表示敬意"
                },
                {
                    "text": "仔细清理海藻和珊瑚",
                    "action": "clean_carefully",
                    "type": "patient",
                    "description": "细心处理，不损坏古剑"
                },
                {
                    "text": "先观察周围是否有危险",
                    "action": "survey_danger",
                    "type": "cautious",
                    "description": "确保安全再行动"
                },
                {
                    "text": "尝试与古剑沟通",
                    "action": "communicate_sword",
                    "type": "mystical",
                    "description": "相信神剑有灵性"
                }
            ],
            "effects": {
                "impatient": 2,
                "respectful": 12,
                "patient": 8,
                "cautious": 5,
                "mystical": 10
            }
        },
        {
            "id": 2,
            "title": "剑灵苏醒",
            "content": "当古剑终于脱离束缚的瞬间，一道耀眼的剑光冲天而起，海面波涛汹涌，天空中现出七彩祥云。更令人惊异的是，从剑身中传出一个苍老而威严的声音：'千年等待，终有有缘人现！吾乃海月剑之器灵，曾随主人征战四方，降妖除魔。今主人已仙去，吾在此地等候新的传人。'剑灵还告诉你们，这把剑名为'海月'，乃是上古名匠欧冶子所铸，剑中蕴含着强大的力量。",
            "choices": [
                {
                    "text": "恭敬地询问剑的来历",
                    "action": "ask_sword_history",
                    "type": "curious",
                    "description": "想了解古剑的历史"
                },
                {
                    "text": "请教剑法修炼之道",
                    "action": "learn_swordplay",
                    "type": "studious",
                    "description": "虚心求学剑术"
                },
                {
                    "text": "询问如何成为传人",
                    "action": "ask_succession",
                    "type": "ambitious",
                    "description": "想要继承剑的力量"
                },
                {
                    "text": "表达愿意守护此剑",
                    "action": "vow_protection",
                    "type": "loyal",
                    "description": "承诺保护神剑"
                },
                {
                    "text": "试图强行驾驭古剑",
                    "action": "force_control",
                    "type": "dominating",
                    "description": "想要征服剑灵"
                }
            ],
            "effects": {
                "curious": 8,
                "studious": 15,
                "ambitious": 6,
                "loyal": 18,
                "dominating": -5
            }
        },
        {
            "id": 3,
            "title": "剑主考验",
            "content": "剑灵感受到你们的诚意，决定进行传承考验。'海月剑法共分九式，分别对应九种品格：仁、义、礼、智、信、忠、勇、廉、耻。只有品格高尚、武德完备者方能习得全部剑法。现在，吾将设置三道考验，以试你们的品格。'话音刚落，周围环境突然变化，你们仿佛进入了一个奇异的幻境之中，面前出现了三个不同的场景。",
            "choices": [
                {
                    "text": "选择第一道考验：救助无助的村民",
                    "action": "save_villagers_test",
                    "type": "compassionate",
                    "description": "展现仁慈之心"
                },
                {
                    "text": "选择第二道考验：对抗强大的邪修",
                    "action": "fight_evil_test",
                    "type": "righteous",
                    "description": "展现正义之勇"
                },
                {
                    "text": "选择第三道考验：守护珍贵的宝物",
                    "action": "guard_treasure_test",
                    "type": "trustworthy",
                    "description": "展现忠诚守信"
                },
                {
                    "text": "要求同时接受所有考验",
                    "action": "accept_all_tests",
                    "type": "determined",
                    "description": "证明全面的品格"
                },
                {
                    "text": "建议让道人代为接受考验",
                    "action": "let_daoist_test",
                    "type": "humble",
                    "description": "谦让他人，自己退后"
                }
            ],
            "effects": {
                "compassionate": 20,
                "righteous": 18,
                "trustworthy": 16,
                "determined": 25,
                "humble": 22
            }
        },
        {
            "id": 4,
            "title": "幻境试炼",
            "content": "在剑灵的考验中，你们经历了种种幻境试炼。有些试炼考验你们面对诱惑时的定力，有些试炼考验你们面对危险时的勇气，还有些试炼考验你们面对选择时的智慧。每一个选择都会影响最终的结果。在试炼过程中，你们不仅要展现武艺，更要展现品格。剑灵时刻在观察着你们的一举一动。",
            "choices": [
                {
                    "text": "面对金银财宝不为所动",
                    "action": "resist_wealth",
                    "type": "incorruptible",
                    "description": "保持心境清净"
                },
                {
                    "text": "救助被困的无辜生灵",
                    "action": "save_innocent",
                    "type": "merciful",
                    "description": "展现慈悲之心"
                },
                {
                    "text": "与邪恶势力正面对抗",
                    "action": "fight_evil_directly",
                    "type": "courageous",
                    "description": "无畏地面对邪恶"
                },
                {
                    "text": "运用智慧化解危机",
                    "action": "solve_wisely",
                    "type": "wise",
                    "description": "以智慧战胜困难"
                },
                {
                    "text": "严守承诺绝不违背",
                    "action": "keep_promise",
                    "type": "faithful",
                    "description": "信守诺言，言出必行"
                }
            ],
            "effects": {
                "incorruptible": 15,
                "merciful": 18,
                "courageous": 16,
                "wise": 20,
                "faithful": 17
            }
        },
        {
            "id": 5,
            "title": "传承决定",
            "content": "经过重重考验，剑灵对你们的表现已有了判断。根据你们在考验中展现出的品格，剑灵将决定是否将海月剑传承给你们，以及传承的程度。如果你们展现出了高尚的品格，将能够获得完整的传承；如果品格有所不足，也会获得相应的指导和部分传承；但如果品格败坏，剑灵可能会拒绝传承，甚至施以惩罚。",
            "final_choices": [
                {
                    "text": "谦逊地接受剑灵的判断",
                    "action": "accept_humbly",
                    "type": "humble",
                    "description": "无论结果如何都虚心接受"
                },
                {
                    "text": "请求剑灵给予指导",
                    "action": "seek_guidance",
                    "type": "learning",
                    "description": "希望得到更多的教诲"
                },
                {
                    "text": "发誓将善用剑的力量",
                    "action": "vow_righteous_use",
                    "type": "righteous",
                    "description": "承诺用剑来行侠仗义"
                },
                {
                    "text": "表示愿意守护海月剑",
                    "action": "promise_protection",
                    "type": "guardian",
                    "description": "成为古剑的守护者"
                },
                {
                    "text": "提议将剑留在此地",
                    "action": "leave_sword_here",
                    "type": "selfless",
                    "description": "认为自己还不够资格"
                }
            ],
            "final_effects": {
                "humble": 20,
                "learning": 15,
                "righteous": 25,
                "guardian": 22,
                "selfless": 30
            }
        }
    ],
    "rewards": {
        "base": {
            "exp": 6000,
            "potential": 2500,
            "shen": 3000,
            "special": "haiyue_sword_manual"
        },
        "bonus": {
            "high_righteousness": {
                "condition": "righteous >= 30",
                "rewards": {
                    "shen": 3000,
                    "exp_bonus": 2000,
                    "title": "正义之剑"
                }
            },
            "high_wisdom": {
                "condition": "wise >= 25",
                "rewards": {
                    "int": 2,
                    "potential_bonus": 1000,
                    "title": "智剑传人"
                }
            },
            "high_loyalty": {
                "condition": "loyal >= 20 && faithful >= 15",
                "rewards": {
                    "max_neili": 200,
                    "special_skill": "haiyue_loyalty",
                    "title": "忠义剑客"
                }
            },
            "perfect_character": {
                "condition": "total_score >= 100",
                "rewards": {
                    "all_attributes": 1,
                    "special_technique": "haiyue_perfect_form",
                    "title": "海月剑圣"
                }
            }
        }
    },
    "endings": {
        "legendary": {
            "condition": "selfless >= 25 && righteous >= 20 && total_score >= 120",
            "description": "你展现出了完美的品格，剑灵决定将海月剑的全部力量传承给你，你成为了新一代的剑圣。",
            "reward_multiplier": 2.0
        },
        "perfect": {
            "condition": "total_score >= 80 && righteous >= 15",
            "description": "你的品格得到了剑灵的认可，获得了海月剑法的完整传承。",
            "reward_multiplier": 1.8
        },
        "good": {
            "condition": "total_score >= 50",
            "description": "你展现出了良好的品格，剑灵传授给你部分海月剑法。",
            "reward_multiplier": 1.3
        },
        "normal": {
            "condition": "total_score >= 20",
            "description": "虽然还有不足，但剑灵认为你有改进的潜力。",
            "reward_multiplier": 1.0
        },
        "poor": {
            "condition": "total_score < 20",
            "description": "你的品格有待提升，剑灵只给了你一些基本指导。",
            "reward_multiplier": 0.7
        },
        "rejected": {
            "condition": "dominating >= 5 || total_score < 0",
            "description": "你的品格让剑灵失望，传承被拒绝了。",
            "reward_multiplier": 0.3
        }
    }
}