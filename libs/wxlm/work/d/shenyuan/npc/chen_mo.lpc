/**
 * @file chen_mo.c
 * @author AI Assistant
 * @brief 嗔魔 - 五气朝元试炼心魔之一
 * @version 2.0
 * @date 2024
 */
inherit NPC;

#define SANMO_HELPER "/d/shenyuan/npc/sanmo_base"

// 函数声明
void perform_chen_skill_1();
void perform_chen_skill_2();
void perform_chen_skill_3();

void create()
{
    set_name("嗔魔", ({"chen_mo", "chen"}));
    set("long", @LONG
这是你内心嗔怒的化身，有着与你相似的面容，却散发着令人窒息的愤怒气息。
它的周身燃烧着无形的怒火，双眼赤红如血，仿佛随时要爆发出毁天灭地的力量。
LONG );

    set("max_qi", 30000000);
    set("qi", 30000000);
    set("max_neili", 200000);
    set("neili", 200000);
    set("max_jing", 8000000);
    set("jing", 8000000);

    set("combat_exp", 0);
    set("shen", 0);
    set("is_sanmo", 1);

    set_skill("unarmed", 5000);
    set_skill("strike", 5000);
    set_skill("force", 5000);
    set_skill("parry", 5000);
    set_skill("dodge", 5000);

    set("chat_chance_combat", 120);
    set("chat_msg_combat", ({
        (: perform_chen_skill_1 :),
        (: perform_chen_skill_2 :),
        (: perform_chen_skill_3 :)
    }));

    setup();
}

/**
 * @brief 嗔魔招式1 - 暴怒狂击（固定气血伤害）
 */
void perform_chen_skill_1()
{
    object *enemies;
    object target;
    int damage;

    enemies = query_enemy();
    if (!sizeof(enemies))
        return;

    target = enemies[0];

    damage = 100000 + random(100000); // 10万-20万

    message_combatd(HIR "$N怒吼一声，周身爆发出狂暴的气势！\n" NOR +
        HIR "「暴怒狂击」！$N对$n造成了" + damage + "点巨额伤害！\n" NOR,
        this_object(), target);

    target->receive_damage("qi", damage,this_object());
}

/**
 * @brief 嗔魔招式2 - 怒火焚心（百分比气血伤害）
 */
void perform_chen_skill_2()
{
    object *enemies;
    object target;
    int damage, max_qi;

    enemies = query_enemy();
    if (!sizeof(enemies))
        return;

    target = enemies[0];

    max_qi = target->query("max_qi");
    damage = max_qi * (5 + random(6)) / 100; // 5%-10%

    message_combatd(HIR "$N双眼赤红，怒火在心中燃烧！\n" NOR +
        HIY "「怒火焚心」！$n被灼烧，气血损失了" + damage + "点！\n" NOR,
        this_object(), target);

    target->receive_damage("qi", damage,this_object());
}

/**
 * @brief 嗔魔招式3 - 狂怒撕裂（固定精神伤害）
 */
void perform_chen_skill_3()
{
    object *enemies;
    object target;
    int damage;

    enemies = query_enemy();
    if (!sizeof(enemies))
        return;

    target = enemies[0];

    damage = 10000 + random(20000); // 1万-3万

    message_combatd(HIR "$N狂怒不已，精神力量化为实质向$n冲击而去！\n" NOR +
        HIM "「狂怒撕裂」！$n的精神遭受重创，损失了" + damage + "点！\n" NOR,
        this_object(), target);

    target->receive_damage("jing", damage,this_object());
}

/**
 * @brief 嗔魔死亡处理
 */
void die()
{
    object who = this_object()->query_last_damage_from();
    string owner_id;

    if (!objectp(who))
    {
        object *players = filter(all_inventory(environment()), (: userp($1) :));
        if (sizeof(players) > 0)
            who = players[0];
    }

    if (objectp(who))
    {
        owner_id = query("owner_id");
        if (owner_id && who->query("id") == owner_id)
        {
            tell_object(who, "\n" + HIR +
                "「" + query("name") + "」在怒吼中消散，你平息了内心的嗔怒！\n" NOR);

            who->set("wuqi_chaoyuan/chen_defeated", 1);
            SANMO_HELPER->check_wuqi_chaoyuan(who);
        }
    }

    ::die();
}

