/**
 * @file sanmo_base.c
 * @author AI Assistant
 * @brief 三魔（贪嗔痴）工具类 - 提供公共函数（独立对象，不被继承）
 * @version 2.0
 * @date 2024
 */

// 函数原型声明
void check_wuqi_chaoyuan(object player);
void announce_wusheng(object player);
void announce_wusheng_feeling(object player);
void create();

/**
 * @brief 创建独立工具对象
 */
void create()
{
    // 这是一个独立的工具对象，不会被销毁
    set("no_clean_up", 1);
}

/**
 * @brief 检查是否达成五气朝元（静态方法，通过call_other调用）
 * @param object player 玩家对象
 */
void check_wuqi_chaoyuan(object player)
{
    int tan_done, chen_done, chi_done;
    int current_age, current_month;

    if (!objectp(player))
        return;

    tan_done = player->query("wuqi_chaoyuan/tan_defeated") || 0;
    chen_done = player->query("wuqi_chaoyuan/chen_defeated") || 0;
    chi_done = player->query("wuqi_chaoyuan/chi_defeated") || 0;

    if (tan_done && chen_done && chi_done)
    {
        player->set("wuqi_done", 1);
        player->set("wuqi_chaoyuan_time", time());

        // 记录突破为武圣的年龄和月份
        current_age = player->query("age");
        current_month = player->query("mud_age") / 43200 % 12 + 1;  // 计算当前月份
        player->set("wusheng_age", current_age);
        player->set("wusheng_month", current_month);

        // 奖励天赋点
        player->add("tianfu_point", 10);

        // 清除临时标记
        player->delete("wuqi_chaoyuan/tan_defeated");
        player->delete("wuqi_chaoyuan/chen_defeated");
        player->delete("wuqi_chaoyuan/chi_defeated");

        tell_object(player, "\n" +
            HIY "═══════════════════════════════\n" +
            HIW "              【五 气 朝 元】\n" +
            HIY "═══════════════════════════════\n\n" NOR +
            "你已战胜内心的贪嗔痴三毒！\n\n" +
            HIW "五脏之气开始朝向黄庭归聚...\n" NOR +
            "你的身心达到了前所未有的和谐与统一！\n\n" +
            HIG "恭喜你达成【五气朝元】，成就武圣之位！\n" NOR +
            HIY "═══════════════════════════════\n" NOR +
            "\n现在可以离开深渊了。\n");

        // 发送系统公告
        call_out("announce_wusheng", 2, player);
    }
}

/**
 * @brief 发送武圣突破公告
 * @param object player 玩家对象
 */
void announce_wusheng(object player)
{
    if (!objectp(player))
        return;

    // 玩家的狂笑
    player->force_me("chat 仰天长啸，笑声震荡九霄！");

    // 第一条rumor - 突破消息
    CHANNEL_D->do_channel(find_object(MASTER_OB), "rumor",
        HIY "【武圣诞生】" NOR + player->query("name") +
        "于深渊之中直面本心，战胜贪嗔痴三毒，五脏之气朝向黄庭归聚，" +
        HIM "成就武圣之位！" NOR);

    // 第二条rumor - 意境描述
    call_out("announce_wusheng_feeling", 3, player);
}

/**
 * @brief 发送武圣突破感悟公告
 * @param object player 玩家对象
 */
void announce_wusheng_feeling(object player)
{
    if (!objectp(player))
        return;

    CHANNEL_D->do_channel(find_object(MASTER_OB), "rumor",
        player->query("name") +
        "于深渊绝境之中悟透本心，贪嗔痴三毒尽化清气，五脏归元，气血浑融。" +
        "心脏赤气如烈焰，肝脏青气若苍松，脾脏黄气似厚土，肺脏白气映清霜，肾脏黑气纳深渊。" +
        "五气朝元于黄庭，天人合一，内外澄明！此刻，" +
        player->query("name") +
        "已然超脱寻常武道桎梏，踏入武圣之境。天地为之变色，" +
        "风云为之激荡，武林之中又添一位" + HIM + "武圣强者" + NOR + "！");
}
