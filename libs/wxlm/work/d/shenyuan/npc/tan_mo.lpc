/**
 * @file tan_mo.c
 * @author AI Assistant
 * @brief 贪魔 - 五气朝元试炼心魔之一
 * @version 2.0
 * @date 2024
 */
inherit NPC;

#define SANMO_HELPER "/d/shenyuan/npc/sanmo_base"

// 函数声明
void perform_tan_skill_1();
void perform_tan_skill_2();
void perform_tan_skill_3();

void create()
{
    set_name("贪魔", ({"tan_mo", "tan"}));
    set("long", @LONG
这是你内心贪婪的化身，有着与你相似的面容，却散发着令人不安的贪婪气息。
它的双眼闪烁着贪婪的光芒，仿佛要吞噬一切。
LONG );

    set("max_qi", 30000000);
    set("qi", 30000000);
    set("max_neili", 200000);
    set("neili", 200000);
    set("max_jing", 8000000);
    set("jing", 8000000);

    set("combat_exp", 0);
    set("shen", 0);
    set("is_sanmo", 1);

    set_skill("unarmed", 5000);
    set_skill("cuff", 5000);
    set_skill("force", 5000);
    set_skill("parry", 5000);
    set_skill("dodge", 5000);

    set("chat_chance_combat", 120);
    set("chat_msg_combat", ({
        (: perform_tan_skill_1 :),
        (: perform_tan_skill_2 :),
        (: perform_tan_skill_3 :)
    }));

    setup();
}

/**
 * @brief 贪魔招式1 - 吞噬气血（百分比伤害）
 */
void perform_tan_skill_1()
{
    object *enemies;
    object target;
    int damage, max_qi;

    enemies = query_enemy();
    if (!sizeof(enemies))
        return;

    target = enemies[0];

    max_qi = target->query("max_qi");
    damage = max_qi * (5 + random(6)) / 100; // 5%-10%

    message_combatd(HIR "$N贪婪地伸出双手，向$n的生命力发起掠夺！\n" NOR +
        HIY "「吞噬气血」！$n的气血被吞噬了" + damage + "点！\n" NOR,
        this_object(), target);

    target->receive_damage("qi", damage,this_object());
    this_object()->add("qi", damage / 2); // 恢复自身一半
}

/**
 * @brief 贪魔招式2 - 掠夺内力（固定伤害）
 */
void perform_tan_skill_2()
{
    object *enemies;
    object target;
    int drain_amount;

    enemies = query_enemy();
    if (!sizeof(enemies))
        return;

    target = enemies[0];

    drain_amount = 5000 + random(5000); // 5000-10000

    if (target->query("neili") < drain_amount)
        drain_amount = target->query("neili");

    if (drain_amount > 0)
    {
        target->add("neili", -drain_amount);
        this_object()->add("neili", drain_amount);

        message_combatd(HIG "$N双掌齐出，一股无形的吸力从掌心涌出！\n" NOR +
            HIY "「掠夺内力」！$n的内力被掠夺了" + drain_amount + "点！\n" NOR,
            this_object(), target);
    }
}

/**
 * @brief 贪魔招式3 - 贪婪之噬（固定气血伤害）
 */
void perform_tan_skill_3()
{
    object *enemies;
    object target;
    int damage;

    enemies = query_enemy();
    if (!sizeof(enemies))
        return;

    target = enemies[0];

    damage = 100000 + random(100000); // 10万-20万

    message_combatd(HIR "$N发出贪婪的怒吼，周身黑气暴涨！\n" NOR +
        HIR "「贪婪之噬」！$N对$n造成了" + damage + "点巨额伤害！\n" NOR,
        this_object(), target);

    target->receive_damage("qi", damage,this_object());
}

/**
 * @brief 贪魔死亡处理
 */
void die()
{
    object who = this_object()->query_last_damage_from();
    string owner_id;

    if (!objectp(who))
    {
        object *players = filter(all_inventory(environment()), (: userp($1) :));
        if (sizeof(players) > 0)
            who = players[0];
    }

    if (objectp(who))
    {
        owner_id = query("owner_id");
        if (owner_id && who->query("id") == owner_id)
        {
            tell_object(who, "\n" + HIY +
                "「" + query("name") + "」化为黑烟消散，你战胜了内心的贪婪！\n" NOR);

            who->set("wuqi_chaoyuan/tan_defeated", 1);
            SANMO_HELPER->check_wuqi_chaoyuan(who);
        }
    }

    ::die();
}

