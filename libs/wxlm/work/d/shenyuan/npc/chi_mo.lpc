/**
 * @file chi_mo.c
 * @author AI Assistant
 * @brief 痴魔 - 五气朝元试炼心魔之一
 * @version 2.0
 * @date 2024
 */
inherit NPC;

#define SANMO_HELPER "/d/shenyuan/npc/sanmo_base"

// 函数声明
void perform_chi_skill_1();
void perform_chi_skill_2();
void perform_chi_skill_3();

void create()
{
    set_name("痴魔", ({"chi_mo", "chi"}));
    set("long", @LONG
这是你内心愚痴的化身，有着与你相似的面容，却散发着令人迷惑的执念气息。
它的身周萦绕着迷雾般的幻象，让人分不清虚实，代表着执迷不悟的执念。
LONG );

    set("max_qi", 30000000);
    set("qi", 30000000);
    set("max_neili", 200000);
    set("neili", 200000);
    set("max_jing", 8000000);
    set("jing", 8000000);

    set("combat_exp", 0);
    set("shen", 0);
    set("is_sanmo", 1);

    set_skill("unarmed", 5000);
    set_skill("finger", 5000);
    set_skill("force", 5000);
    set_skill("parry", 5000);
    set_skill("dodge", 5000);

    set("chat_chance_combat", 120);
    set("chat_msg_combat", ({
        (: perform_chi_skill_1 :),
        (: perform_chi_skill_2 :),
        (: perform_chi_skill_3 :)
    }));

    setup();
}

/**
 * @brief 痴魔招式1 - 精神冲击（固定精神伤害）
 */
void perform_chi_skill_1()
{
    object *enemies;
    object target;
    int damage;

    enemies = query_enemy();
    if (!sizeof(enemies))
        return;

    target = enemies[0];

    damage = 10000 + random(20000); // 1万-3万

    message_combatd(HIC "$N张开双臂，周身迷雾向$n涌去！\n" NOR +
        HIM "「精神冲击」！$n的精神遭受重创，损失了" + damage + "点！\n" NOR,
        this_object(), target);

    target->receive_damage("jing", damage,this_object());
}

/**
 * @brief 痴魔招式2 - 心魔侵蚀（百分比精神伤害）
 */
void perform_chi_skill_2()
{
    object *enemies;
    object target;
    int damage, max_jing;

    enemies = query_enemy();
    if (!sizeof(enemies))
        return;

    target = enemies[0];

    max_jing = target->query("max_jing");
    damage = max_jing * (5 + random(6)) / 100; // 5%-10%

    message_combatd(HIM "$N低声呢喃，心魔之力侵入$n的内心深处！\n" NOR +
        HIC "「心魔侵蚀」！$n的精神被侵蚀，损失了" + damage + "点！\n" NOR,
        this_object(), target);

    target->receive_damage("jing", damage,this_object());
}

/**
 * @brief 痴魔招式3 - 执念缠绕（固定内力伤害）
 */
void perform_chi_skill_3()
{
    object *enemies;
    object target;
    int damage;

    enemies = query_enemy();
    if (!sizeof(enemies))
        return;

    target = enemies[0];

    damage = 5000 + random(5000); // 5000-10000

    if (target->query("neili") < damage)
        damage = target->query("neili");

    if (damage > 0)
    {
        target->add("neili", -damage);

        message_combatd(HIC "$N身周迷雾化为无数触手，缠绕向$n！\n" NOR +
            HIM "「执念缠绕」！$n的内力被吸走了" + (damage) + "点！\n" NOR,
            this_object(), target);
    }
}

/**
 * @brief 痴魔死亡处理
 */
void die()
{
    object who = this_object()->query_last_damage_from();
    string owner_id;

    if (!objectp(who))
    {
        object *players = filter(all_inventory(environment()), (: userp($1) :));
        if (sizeof(players) > 0)
            who = players[0];
    }

    if (objectp(who))
    {
        owner_id = query("owner_id");
        if (owner_id && who->query("id") == owner_id)
        {
            tell_object(who, "\n" + HIC +
                "「" + query("name") + "」在迷雾中消散，你破除了内心的执念！\n" NOR);

            who->set("wuqi_chaoyuan/chi_defeated", 1);
            SANMO_HELPER->check_wuqi_chaoyuan(who);
        }
    }

    ::die();
}

