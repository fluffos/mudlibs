
inherit ROOM;

void create()
{
    set("short", HIR"密道"NOR);
    set("long", @LONG
这是一条隐蔽的密道,连接着练武场后院和秘密洞穴。道路狭窄曲折,
四周的墙壁上挂着几盏昏暗的油灯。空气中有一股淡淡的潮湿气息。
这条密道显然是梁山好汉们用来紧急撤离的通道。
LONG );

    set("exits", ([
        "south" : __DIR__"backyard",
        "north" : __DIR__"secret_cave",
    ]));

    set("no_map", 1);
    setup();
}