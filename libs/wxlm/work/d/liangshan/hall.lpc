
inherit ROOM;

void create()
{
    set("short", HIR"聚义厅"NOR);
    set("long", @LONG
这里是梁山泊的聚义厅,也是梁山好汉们议事的地方。厅内陈设简单但庄重,正中
摆放着一张虎皮交椅,两侧是一排长条凳。墙上挂着各种兵器和旗帜,显示出梁山
好汉的豪迈气概。在厅内的一角,你注意到两位气质不凡的人物:一位白衣胜雪的
剑客,另一位则是一身黑衣的刀客,他们似乎是这里的特殊客人。
好汉的豪迈气概。
LONG );

    set("exits", ([
        "north" : __DIR__"practice",
        "south" : __DIR__"gate",
        "east" : __DIR__"kitchen",
        "west" : __DIR__"storage",
    ]));

    set("objects", ([
        __DIR__"npc/songjiang" : 1,
        "/u/cx/npc/genie" : 1,
        "/u/cx/npc/weizhuang" : 1,
        "/u/cx/npc/lixunhuan" : 1,
    ]));

    set("out_room","/d/city/guangchang");//死亡后传送回城市广场

    setup();
}

void no_die(object me)
{
    // 不死亡，恢复生命和内力


    //真血eff
    me->set("eff_qi", me->query("max_qi"));
    //真气eff
    me->set("eff_jing", me->query("max_jing"));
    //内力eff
    me->set("eff_neili", me->query("max_neili"));

    // 虚血
    me->set("qi", me->query("max_qi"));
    me->set("jing", me->query("max_jing"));
    me->set("neili", me->query("max_neili"));
}