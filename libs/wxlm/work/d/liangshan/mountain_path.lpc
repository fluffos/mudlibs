
inherit ROOM;

void create()
{
    set("short", "后山小径");
    set("long", @LONG
这是一条蜿蜒在梁山泊后山的小径。道路两旁是茂密的树林,不时有野兔或山鸟
从眼前掠过。空气清新,偶尔能听到远处传来的瀑布声。这条小径通向更深的
山林,据说那里隐藏着不为人知的秘密。
LONG );

    set("exits", ([
        "east" : __DIR__"forest",
        "west" : __DIR__"waterfall",
    ]));

   

    set("outdoors", "liangshan");
    setup();
}