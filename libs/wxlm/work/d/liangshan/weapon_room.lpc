
inherit ROOM;

void create()
{
    set("short", "兵器房");
    set("long", @LONG
这里是梁山泊的兵器房,四周的墙上挂满了各式各样的武器。有刀、枪、剑、戟
等冷兵器,也有弓箭、飞镖等远程武器。房间中央还摆放着几个木架,上面整齐
地放置着一些精致的兵器。
LONG );

    set("exits", ([
        "north" : __DIR__"hall",
    ]));

    set("objects", ([
        "/clone/weapon/gangjian" : 2,
        "/clone/weapon/gangdao" : 2,
        "/clone/weapon/changqiang" : 2,
    ]));

    setup();
}