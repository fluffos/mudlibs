
inherit ROOM;

void create()
{
    set("short", "厨房");
    set("long", @LONG
这里是梁山泊的厨房,空气中弥漫着各种美食的香气。几个大锅正冒着热气,
厨师们忙碌地准备着食物。墙边摆放着各种食材和调料,看起来应有尽有。
这里不仅为梁山好汉们提供日常饮食,也为来访的客人准备美味佳肴。
LONG );

    set("exits", ([
        "west" : __DIR__"hall",
    ]));

    

    set("resource/water", 1);
    setup();
}