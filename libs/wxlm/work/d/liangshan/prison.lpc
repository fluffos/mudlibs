
inherit ROOM;

void create()
{
    set("short", HIB"地牢"NOR);
    set("long", @LONG
这里是梁山泊的地牢,空气中弥漫着潮湿和霉味。四周的墙壁上挂着铁链和
刑具,显得阴森可怖。地牢里有几个牢房,关押着一些犯人。一盏昏暗的油灯
勉强照亮这个阴暗的空间。
LONG );

    set("exits", ([
        "up" : __DIR__"hall",
    ]));

    set("objects", ([
        __DIR__"npc/jailer" : 1,
        __DIR__"npc/prisoner" : 2,
    ]));

    setup();
}