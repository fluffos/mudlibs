
inherit NPC;

void create()
{
    set_name("猎人", ({ "hunter", "lie ren" }));
    set("gender", "男性");
    set("age", 30 + random(20));
    set("long", "这是一名在梁山泊后山活动的猎人,他对这片森林了如指掌。\n");
    
    set("combat_exp", 200000);
    set("shen_type", 1);
    set("max_qi", 1000);
    set("max_jing", 1000);
    set("neili", 1000);
    set("max_neili", 1000);
    
    set_skill("force", 80);
    set_skill("dodge", 80);
    set_skill("parry", 80);
    set_skill("blade", 80);
    set_skill("cuff", 80);
    
    setup();
    carry_object(__DIR__"obj/liangshan_blade")->wield();
    carry_object(__DIR__"obj/liangshan_cloth")->wear();
}