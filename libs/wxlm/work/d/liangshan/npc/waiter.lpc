
inherit NPC;

void create()
{
    set_name("酒馆小二", ({ "waiter", "xiao er" }));
    set("gender", "男性");
    set("age", 18 + random(10));
    set("long", "这是快活林酒馆的小二，正忙碌地招呼着客人。\n");
    
    set("combat_exp", 1000);
    set("shen_type", 1);
    set("attitude", "peaceful");
    
    set_skill("unarmed", 20);
    set_skill("dodge", 20);
    
    setup();
    carry_object(__DIR__"obj/liangshan_cloth")->wear();
}

void init()
{
    object ob;
    ::init();
    if (interactive(ob = this_player()) && !is_fighting())
    {
        remove_call_out("greeting");
        call_out("greeting", 1, ob);
    }
}

void greeting(object ob)
{
    if (!ob || environment(ob) != environment())
        return;
    
    say(CYN"酒馆小二笑着说道：这位" + RANK_D->query_respect(ob) + 
        "，里面请！要点什么酒菜？\n"NOR);
}