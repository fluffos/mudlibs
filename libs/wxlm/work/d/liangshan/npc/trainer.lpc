
inherit NPC;

void create()
{
    set_name("训练师", ({ "trainer", "xunlian shi" }));
    set("gender", "男性");
    set("age", 35 + random(20));
    set("long", "这是梁山泊的训练师,负责指导好汉们练习武艺。\n");
    
    set("combat_exp", 500000);
    set("shen_type", 1);
    set("max_qi", 2000);
    set("max_jing", 2000);
    set("neili", 2000);
    set("max_neili", 2000);
    
    set_skill("force", 150);
    set_skill("dodge", 150);
    set_skill("parry", 150);
    set_skill("blade", 150);
    set_skill("cuff", 150);
    
    setup();
    carry_object(__DIR__"obj/liangshan_blade")->wield();
    carry_object(__DIR__"obj/liangshan_cloth")->wear();
}

void init()
{
    object ob;
    ::init();
    if (interactive(ob = this_player()) && !is_fighting())
    {
        remove_call_out("greeting");
        call_out("greeting", 1, ob);
    }
}

void greeting(object ob)
{
    if (!ob || environment(ob) != environment())
        return;
    
    say(CYN"训练师对" + ob->name() + "说道：要不要来练练功夫?\n"NOR);
}