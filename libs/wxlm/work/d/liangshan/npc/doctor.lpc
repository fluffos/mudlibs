
inherit NPC;

void create()
{
    set_name("安道全", ({ "an daoquan", "an", "daoquan" }));
    set("title", "神医");
    set("gender", "男性");
    set("age", 50 + random(10));
    set("long", "这是梁山泊的神医安道全，医术高明，妙手回春。\n");
    
    set("combat_exp", 50000);
    set("shen_type", 1);
    set("attitude", "peaceful");
    
    set_skill("unarmed", 60);
    set_skill("dodge", 60);
    set_skill("parry", 60);
    
    
    setup();
    carry_object(__DIR__"obj/liangshan_cloth")->wear();
}

void init()
{
    object ob;
    ::init();
    if (interactive(ob = this_player()) && !is_fighting())
    {
        remove_call_out("greeting");
        call_out("greeting", 1, ob);
    }
}

void greeting(object ob)
{
    if (!ob || environment(ob) != environment())
        return;
    
    say(CYN"安道全微笑着说道：这位" + RANK_D->query_respect(ob) + 
        "，身体有恙吗？让我给你看看。\n"NOR);
}