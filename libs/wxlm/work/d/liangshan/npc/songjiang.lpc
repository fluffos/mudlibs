
inherit NPC;
inherit F_MASTER;

void create()
{
    set_name("宋江", ({ "song jiang", "song", "jiang" }));
    set("title", HIY"梁山泊主"NOR);
    set("gender", "男性");
    set("age", 45);
    set("long", "这就是梁山泊的领袖宋江,绰号及时雨。他相貌堂堂,目光如炬。\n");
    
    set("combat_exp", 1000000);
    set("shen_type", 1);
    set("max_qi", 3000);
    set("max_jing", 3000);
    set("neili", 3000);
    set("max_neili", 3000);
    
    set_skill("force", 180);
    set_skill("dodge", 180);
    set_skill("parry", 180);
    set_skill("blade", 180);
    set_skill("cuff", 180);
    set_skill("liangshan_boxing", 200);  // 梁山霸拳
    set_skill("jiutian_shenfist", 200);  // 九天神拳
    set_skill("pokong_lieyanzhua", 200); // 破空烈焰拳
    set_skill("huanying_mizong", 200);   // 幻影迷踪拳
    set_skill("xuanbing_hanshuang", 200);// 玄冰寒霜拳
    set_skill("leiting_wanjun", 200);    // 雷霆万钧拳
    set_skill("literate", 150);
    
    map_skill("cuff", "liangshan_boxing");
    map_skill("parry", "liangshan_boxing");
    
    prepare_skill("cuff", "liangshan_boxing");
    
    set("chat_chance_combat", 80);
    set("chat_msg_combat", ({
        (: perform_action, "cuff.shanbeng" :),
        (: perform_action, "cuff.nulong" :),
        (: perform_action, "cuff.bawang" :),
    }));
    
    setup();
    carry_object(__DIR__"obj/liangshan_cloth")->wear();
}

void init()
{
    object ob;
    ::init();
    if (interactive(ob = this_player()) && !is_fighting())
    {
        remove_call_out("greeting");
        call_out("greeting", 1, ob);
    }
    
    add_action("do_learn", "xue");
    add_action("do_learn", "learn");
}

void greeting(object ob)
{
    if (!ob || environment(ob) != environment())
        return;
    
    say(CYN"宋江微笑着对" + ob->name() + "说道：欢迎来到梁山泊,有什么需要帮助的吗?\n"NOR);
}

int recognize_apprentice(object ob, string skill)
{
    if (skill != "liangshan_boxing" && 
        skill != "jiutian_shenfist" && 
        skill != "pokong_lieyanzhua" && 
        skill != "huanying_mizong" && 
        skill != "xuanbing_hanshuang" && 
        skill != "leiting_wanjun")
        return notify_fail("宋江说道：这个技能我不会教。\n");
    
    if (skill == "liangshan_boxing" && ob->query("family/family_name"))
        return notify_fail("宋江说道：梁山霸拳只有无门派的人才能学习。\n");
    
    return 1;
}

int do_learn(string arg)
{
    object me = this_player();
    string skill;
    
    if (!arg)
        return notify_fail("你要学习什么技能？\n");
    
    if (sscanf(arg, "%s", skill) != 1)
        return notify_fail("指令格式：learn <技能名称>\n");
    
    if (skill != "liangshan_boxing" && 
        skill != "jiutian_shenfist" && 
        skill != "pokong_lieyanzhua" && 
        skill != "huanying_mizong" && 
        skill != "xuanbing_hanshuang" && 
        skill != "leiting_wanjun")
        return notify_fail("宋江说道：这个技能我不会教。\n");
    
    if (skill == "liangshan_boxing" && me->query("family/family_name"))
        return notify_fail("宋江说道：梁山霸拳只有无门派的人才能学习。\n");
    
    return 0;
}