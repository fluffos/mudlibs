
inherit NPC;

void create()
{
    set_name("梁山守卫", ({ "gate guard", "guard" }));
    set("long", "这是一名梁山泊的守卫,负责把守大门。他身材魁梧,目光如炬。\n");
    set("gender", "男性");
    set("age", 30 + random(20));
    set("attitude", "peaceful");
    set("str", 28 + random(10));
    set("dex", 25 + random(10));
    set("max_qi", 1500);
    set("max_jing", 1500);
    set("neili", 1500);
    set("max_neili", 1500);
    set("jiali", 80);
    set("combat_exp", 100000 + random(50000));
    
    set_skill("force", 100);
    set_skill("dodge", 100);
    set_skill("parry", 100);
    set_skill("blade", 100);
    set_skill("cuff", 100);
    
    setup();
    
    carry_object(__DIR__"obj/blade")->wield();
    carry_object(__DIR__"obj/cloth")->wear();
}

void init()
{
    object ob;
    ::init();
    if (interactive(ob = this_player()) && !is_fighting())
    {
        remove_call_out("greeting");
        call_out("greeting", 1, ob);
    }
}

void greeting(object ob)
{
    if (!ob || environment(ob) != environment())
        return;
    
    if (ob->query("family/family_name"))
    {
        say(CYN"梁山守卫冷冷地看着" + ob->name() + "说道：这位" + 
            RANK_D->query_respect(ob) + "已经加入其他门派,不得进入梁山泊。\n"NOR);
    }
    else
    {
        say(CYN"梁山守卫对" + ob->name() + "点了点头,说道：这位" + 
            RANK_D->query_respect(ob) + "请进。\n"NOR);
    }
}