
inherit NPC;

void create()
{
    set_name("囚犯", ({ "prisoner", "qiu fan" }));
    set("gender", "男性");
    set("age", 30 + random(30));
    set("long", "这是一名被关在梁山泊地牢里的囚犯，看起来很是狼狈。\n");
    
    set("combat_exp", 10000);
    set("shen_type", -1);
    set("attitude", "peaceful");
    
    set_skill("unarmed", 40);
    set_skill("dodge", 40);
    
    setup();
    carry_object(__DIR__"obj/liangshan_cloth")->wear();
}

void init()
{
    object ob;
    ::init();
    if (interactive(ob = this_player()) && !is_fighting())
    {
        remove_call_out("greeting");
        call_out("greeting", 1, ob);
    }
}

void greeting(object ob)
{
    if (!ob || environment(ob) != environment())
        return;
    
    say(CYN"囚犯可怜巴巴地看着" + ob->name() + "，哀求道：好心人，救救我吧！\n"NOR);
}