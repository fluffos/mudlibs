
inherit NPC;

void create()
{
    set_name("山贼", ({ "bandit", "shan zei" }));
    set("gender", "男性");
    set("age", 25 + random(20));
    set("long", "这是一名在梁山泊附近活动的山贼,看起来凶神恶煞。\n");
    
    set("combat_exp", 100000);
    set("shen_type", -1);
    set("max_qi", 800);
    set("max_jing", 800);
    set("neili", 800);
    set("max_neili", 800);
    
    set_skill("force", 70);
    set_skill("dodge", 70);
    set_skill("parry", 70);
    set_skill("blade", 70);
    set_skill("cuff", 70);
    
    setup();
    carry_object(__DIR__"obj/liangshan_blade")->wield();
    carry_object(__DIR__"obj/liangshan_cloth")->wear();
}

void init()
{
    object ob;
    ::init();
    if (interactive(ob = this_player()) && !is_fighting())
    {
        remove_call_out("greeting");
        call_out("greeting", 1, ob);
    }
}

void greeting(object ob)
{
    if (!ob || environment(ob) != environment())
        return;
    
    say(CYN"山贼凶狠地盯着" + ob->name() + "，喝道：此路是我开,此树是我栽,要想从此过,留下买路财!\n"NOR);
    kill_ob(ob);
}