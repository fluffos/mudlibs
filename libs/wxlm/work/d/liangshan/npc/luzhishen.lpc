
inherit NPC;

void create()
{
    set_name("鲁智深", ({ "lu zhishen", "lu", "zhishen" }));
    set("title", "花和尚");
    set("gender", "男性");
    set("age", 35);
    set("long", "这就是梁山泊的鲁智深，外号花和尚。他身材魁梧，面色红润，一副豪爽模样。\n");
    
    set("combat_exp", 500000);
    set("shen_type", 1);
    set("max_qi", 2000);
    set("max_jing", 2000);
    set("neili", 2000);
    set("max_neili", 2000);
    
    set_skill("force", 150);
    set_skill("dodge", 150);
    set_skill("parry", 150);
    set_skill("unarmed", 150);
    set_skill("staff", 150);
    
    setup();
    carry_object(__DIR__"obj/liangshan_staff")->wield();
    carry_object(__DIR__"obj/liangshan_cloth")->wear();
}

void init()
{
    object ob;
    ::init();
    if (interactive(ob = this_player()) && !is_fighting())
    {
        remove_call_out("greeting");
        call_out("greeting", 1, ob);
    }
}

void greeting(object ob)
{
    if (!ob || environment(ob) != environment())
        return;
    
    say(CYN"鲁智深哈哈大笑道：" + RANK_D->query_respect(ob) + 
        "，来来来，喝酒吃肉！\n"NOR);
}