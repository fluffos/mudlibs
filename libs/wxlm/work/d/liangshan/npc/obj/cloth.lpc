#include <armor.h>
inherit CLOTH;

void create()
{
    set_name("粗布衣", ({ "cloth" }));
    set_weight(3000);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("unit", "件");
        set("long", "这是一件粗布缝制的衣服,虽然简单,但很结实。\n");
        set("material", "cloth");
        set("armor_prop/armor", 10);
        set("value", 100);
    }
    setup();
}