#include <armor.h>
inherit CLOTH;

void create()
{
    set_name("梁山服饰", ({ "liangshan cloth", "cloth" }));
    set_weight(3000);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("unit", "件");
        set("long", "这是一件梁山好汉常穿的粗布衣服,耐磨耐脏。\n");
        set("material", "cloth");
        set("armor_prop/armor", 15);
        set("value", 200);
    }
    setup();
}