#include <weapon.h>
inherit STAFF;

void create()
{
    set_name("梁山禅杖", ({ "liangshan staff", "staff" }));
    set_weight(5000);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("unit", "根");
        set("long", "这是一根梁山和尚常用的镔铁禅杖。\n");
        set("value", 500);
        set("material", "steel");
        set("wield_msg", "$N抽出一根$n握在手中。\n");
        set("unwield_msg", "$N将手中的$n插回背后。\n");
    }
    init_staff(35);
    setup();
}