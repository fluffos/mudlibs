
inherit NPC;

void create()
{
    set_name("梁山哨兵", ({ "liangshan sentry", "sentry" }));
    set("long", "这是一名梁山泊的哨兵,负责守卫入口。他警惕地打量着每一个进出的人。\n");
    set("gender", "男性");
    set("age", 30 + random(20));
    set("attitude", "peaceful");
    set("str", 25 + random(10));
    set("dex", 20 + random(10));
    set("max_qi", 1000);
    set("max_jing", 1000);
    set("neili", 1000);
    set("max_neili", 1000);
    set("jiali", 50);
    set("combat_exp", 50000 + random(50000));
    
    set_skill("force", 80);
    set_skill("dodge", 80);
    set_skill("parry", 80);
    set_skill("blade", 80);
    set_skill("cuff", 80);
    
    setup();
    
    carry_object(__DIR__"obj/liangshan_blade")->wield();
    carry_object(__DIR__"obj/liangshan_cloth")->wear();
}

void init()
{
    object ob;
    ::init();
    if (interactive(ob = this_player()) && !is_fighting())
    {
        remove_call_out("greeting");
        call_out("greeting", 1, ob);
    }
}

void greeting(object ob)
{
    if (!ob || environment(ob) != environment())
        return;
    
    say(CYN"梁山哨兵警惕地打量着" + ob->name() + "，沉声问道：" 
        "来者何人,有何贵干?\n"NOR);
}