
inherit ROOM;

void create()
{
    set("short", "后山密林");
    set("long", @LONG
这里是梁山泊后山的密林,树木高大茂密,枝叶交错遮蔽了阳光。林中小径蜿蜒
曲折,稍不留神就会迷失方向。据说这片密林中隐藏着梁山泊的秘密宝藏,但从未
有人能找到。
LONG );

    set("exits", ([
        "east" : __DIR__"practice",
        "west" : __FILE__,
        "north" : __FILE__,
        "south" : __FILE__,
    ]));

    set("objects", ([
        __DIR__"npc/hunter" : 1,
       
    ]));
    set("item_desc", ([
        "密林" : "密林中隐藏着梁山泊的秘密宝藏,但从未有人能找到。\n",

    ]));
    set("action_list", ([
        "搜索" : "search",
    ]));
    
    set("outdoors", "liangshan");
    setup();
}

void init()
{
    add_action("do_search", "search");
}

int do_search(string arg)
{
    object me = this_player();
    
    if (!arg || arg != "密林")
        return notify_fail("你要搜索什么?\n");
    
    if (random(100) == 0)
    {
        message_vision("$N仔细搜索密林,竟然发现了一个隐藏的洞穴入口!\n", me);
        set("exits/enter", __DIR__"secret_cave");
        call_out("close_enter", 30);
        return 1;
    }
    
    message_vision("$N仔细搜索密林,但什么也没找到。\n", me);
    return 1;
}

void close_enter()
{
    tell_room(this_object(), "洞穴入口突然消失了。\n");
    delete("exits/enter");
}