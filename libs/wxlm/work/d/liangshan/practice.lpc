
inherit ROOM;

void create()
{
    set("short", "练武场");
    set("long", @LONG
这里是梁山泊的练武场,占地颇广。场地中央是一片平整的空地,四周摆放着各种
练武器械。不时有梁山好汉在此切磋武艺,呐喊声此起彼伏。场边还有一些木人桩,
供人练习拳脚。
LONG );

    set("exits", ([
        "south" : __DIR__"hall",
    ]));

    set("objects", ([
        __DIR__"npc/trainer" : 1,
        "/clone/npc/mu-ren" : 3,
    ]));

    set("outdoors", "liangshan");
    set("for_family", "梁山泊");
    setup();
}