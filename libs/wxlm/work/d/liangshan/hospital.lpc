
inherit ROOM;

void create()
{
    set("short", "安乐堂");
    set("long", @LONG
这里是梁山泊的医馆,名为安乐堂。房间内摆放着几张病床,墙边是一排药柜,
里面装满了各种药材。空气中弥漫着浓郁的药香。这里不仅为梁山好汉们治疗
伤病,也为附近的百姓提供医疗服务。
LONG );

    set("exits", ([
        "south" : __DIR__"hall",
    ]));

    set("objects", ([
        __DIR__"npc/doctor" : 1,
     
    ]));

    set("no_fight", 1);
    setup();
}