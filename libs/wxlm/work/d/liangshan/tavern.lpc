
inherit ROOM;

void create()
{
    set("short", "快活林酒馆");
    set("long", @LONG
这里是梁山泊的快活林酒馆,是好汉们休息娱乐的地方。酒馆内烟雾缭绕,
到处都是喝酒划拳的声音。墙上挂着几幅字画,写的都是些豪气冲天的诗句。
酒馆的角落里还有几张赌桌,不时传来喝彩声。
LONG );

    set("exits", ([
        "east" : __DIR__"hall",
    ]));

    set("objects", ([
        __DIR__"npc/waiter" : 1,
        "/clone/food/jitui" : 5,
        "/clone/food/jiudai" : 5,
    ]));

    set("resource/water", 1);
    setup();
}