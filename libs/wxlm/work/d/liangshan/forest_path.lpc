
inherit ROOM;

void create()
{
    set("short", "树林小径");
    set("long", @LONG
你走在一条蜿蜒的小径上,四周是茂密的树林。阳光透过树叶的缝隙洒落在地上,
形成斑驳的光影。空气中弥漫着泥土和植物的清新气息。小径向北延伸,通往梁山泊
的深处。
LONG );

    set("exits", ([
        "north" : __DIR__"gate",
        "south" : __DIR__"entrance",
    ]));

    set("objects", ([
        __DIR__"npc/bandit" : 1 + random(2),
    ]));

    set("outdoors", "liangshan");
    setup();
}

void init()
{
    add_action("do_search", "search");
}

int do_search(string arg)
{
    object me = this_player();
    
    if (!arg || arg != "树林")
        return notify_fail("你要搜索什么?\n");
    
    if (random(10) == 0)
    {
        message_vision("$N仔细搜索树林,突然发现了一些有趣的东西!\n", me);
        new(__DIR__"obj/herb")->move(me);
        return 1;
    }
    
    message_vision("$N仔细搜索树林,但什么也没找到。\n", me);
    return 1;
}