
inherit ROOM;

void create()
{
    set("short", HIY"梁山泊入口"NOR);
    set("long", @LONG
这里是梁山泊的入口。远处可以看到一片茂密的树林,隐约有一条小路通向山寨。
四周环绕着浓雾,给人一种神秘莫测的感觉。路边立着一块石碑(石碑),上面刻着
几个大字。
LONG );

    set("item_desc", ([
       "入口" : "石碑上刻着：" HIR "替天行道,梁山好汉" NOR "\n"
        ZJOBACTS2+ZJMENUF(3,3,10,30)"进入:enter\n"
    ]));

    set("exits", ([
        "north" : __DIR__"forest_path",
        "south" : "/d/jianghu/jietou",
    ]));

    set("objects", ([
        __DIR__"npc/sentry" : 2,
    ]));

    set("outdoors", "liangshan");
    setup();
}

void init()
{
    add_action("do_enter", "enter");
}

int do_enter(string arg)
{
    object me = this_player();

    if (arg)
    {
        return notify_fail("指令格式：进入梁山泊\n");
    }

    message_vision("$N深吸一口气,大步走进了梁山泊。\n", me);
    me->move(__DIR__"forest_path");
    return 1;
}