
inherit ROOM;

void create()
{
    set("short", HIY"梁山泊大门"NOR);
    set("long", @LONG
你来到了梁山泊的大门前。高大的木门上方悬挂着一块牌匾,上书"替天行道"
四个大字。门两侧站着几名彪形大汉,警惕地注视着来往的行人。大门内隐约可见
一座气势恢宏的大厅。
LONG );

    set("exits", ([
        "north" : __DIR__"hall",
        "south" : __DIR__"forest_path",
    ]));

    set("objects", ([
        __DIR__"npc/gate_guard" : 2,
    ]));

    set("outdoors", "liangshan");
    setup();
}

int valid_leave(object me, string dir)
{
    object guard;
    
    if (dir == "north" && objectp(guard = present("gate guard", this_object())))
    {
        if (me->query("family/family_name"))
        {
            return notify_fail("守卫拦住你说道：这位" + RANK_D->query_respect(me) + 
                               "已经加入其他门派,不得进入梁山泊。\n");
        }
    }
    
    return ::valid_leave(me, dir);
}