
inherit ROOM;

void create()
{
    set("short", HIC"飞瀑"NOR);
    set("long", @LONG
眼前是一座气势磅礴的瀑布,水流从高处奔腾而下,发出震耳欲聋的轰鸣声。
瀑布周围雾气缭绕,形成了一道美丽的彩虹。瀑布下方是一个深潭,水面平静
如镜。这里空气清新,是个修炼的好地方。
LONG );

    set("exits", ([
        "east" : __DIR__"mountain_path",
    ]));

    
    set("outdoors", "liangshan");
    setup();
}