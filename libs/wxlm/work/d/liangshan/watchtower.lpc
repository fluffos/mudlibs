
inherit ROOM;

void create()
{
    set("short", "瞭望塔");
    set("long", @LONG
这里是梁山泊的瞭望塔,建在山寨的最高处。从这里可以俯瞰整个梁山泊,
视野极为开阔。塔上配备了各种观察工具,还有一面大鼓和一面旗帜,用于
发出警报和传递信息。
LONG );

    set("exits", ([
        "down" : __DIR__"gate",
    ]));

    set("objects", ([
        __DIR__"npc/watcher" : 1,
    ]));

    set("outdoors", "liangshan");
    setup();
}