// xuantie_mu.c
// 玄铁木 - 披风制作材料

inherit COMBINED_ITEM;

/**
 * @brief 查询自动加载参数
 * @return string 返回数量字符串
 * @details 用于保存道具数量信息
 */
string query_autoload() { return query_amount() + ""; }

/**
 * @brief 自动加载函数
 * @param string param 加载参数
 * @details 从参数中解析并设置道具数量
 */
void autoload(string param)
{
	int amt;

	if (sscanf(param, "%d", amt) == 1)
		set_amount(amt);
}

/**
 * @brief 设置函数
 * @details 初始化道具数量并调用父类设置
 */
void setup()
{
	set_amount(1);
	::setup();
}

/**
 * @brief 创建函数
 * @details 设置玄铁木的基本属性
 */
void create()
{
	set_name(HIB "玄铁木" NOR, ({ "xuantie mu", "mu" }));
	if (clonep())
		set_default_object(__FILE__);
	else {
		// 道具详细描述信息
		set("long", "一种极其坚硬的黑色木材，表面有着金属般的光泽，传说是在玄铁矿脉中生长千年的神木。\n");
		// 道具计量单位
		set("base_unit", "块");
		// 道具基础价值（游戏币）
		set("base_value", 400);
		// 道具元宝价格
		set("yuanbao", 20);
		// 材料类型标识，用于系统识别道具种类
		set("material_type", "cloak_material");
		// 材料品质等级
		set("material_grade", "epic");
		// 道具重量
		set("base_weight", 2);
	}
	setup();
}