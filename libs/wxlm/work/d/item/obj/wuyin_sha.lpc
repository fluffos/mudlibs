// wuyin_sha.c
// 雾隐砂 - 披风制作材料

inherit COMBINED_ITEM;

/**
 * @brief 查询自动加载参数
 * @return string 返回数量字符串
 * @details 用于保存道具数量信息
 */
string query_autoload() { return query_amount() + ""; }

/**
 * @brief 自动加载函数
 * @param string param 加载参数
 * @details 从参数中解析并设置道具数量
 */
void autoload(string param)
{
	int amt;

	if (sscanf(param, "%d", amt) == 1)
		set_amount(amt);
}

/**
 * @brief 设置函数
 * @details 初始化道具数量并调用父类设置
 */
void setup()
{
	set_amount(1);
	::setup();
}

/**
 * @brief 创建函数
 * @details 设置雾隐砂的基本属性
 */
void create()
{
	set_name(HIW "雾隐砂" NOR, ({ "wuyin sha", "sha" }));
	if (clonep())
		set_default_object(__FILE__);
	else {
		// 道具详细描述信息
		set("long", "一种神秘的银白色细砂，在月光下会散发出淡淡的光芒，是制作高级披风的珍贵材料。\n");
		// 道具计量单位
		set("base_unit", "袋");
		// 道具基础价值（游戏币）
		set("base_value", 300);
		// 道具元宝价格
		set("yuanbao", 15);
		// 材料类型标识，用于系统识别道具种类
		set("material_type", "cloak_material");
		// 材料品质等级
		set("material_grade", "rare");
		// 道具重量
		set("base_weight", 1);
	}
	setup();
}