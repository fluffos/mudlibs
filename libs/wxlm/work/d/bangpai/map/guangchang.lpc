//#include <bangpai.h>
inherit ROOM;

void create()
{
	set("short", "帮会广场");
	set("long", "这里是帮派广场，是兄弟们聚会的地方。");
	set("exits", ([
		"east" : __DIR__"chufang",
		"west" : __DIR__"liandan",
		"north" : __DIR__"biguan",
	]));
	set("action_list", ([
		HIG"帮派任务"NOR:"bpquest",
		"回扬州客店":"recall back",
	]));
		set("bangpai_room","1");
		set("bangpai/guangchang",1);
	set("no_fight","1");
	setup();
}

void init()
{
	add_action("do_quest", "bpquest");
}

int do_quest(string arg)
{
	object me;
	me = this_player();

	if (! arg || arg == "")
	{
	 string msg=ZJOBLONG;
	  msg += "为了帮派的发展，为了锻炼帮众的能力，帮派颁布有如下任务可以领取：\n";
	  msg += ZJOBACTS2;
	  msg += "割草:bpquest grass";
			tell_object(me,msg+"\n");
			return 1;
    }		
  
	//检查完成时间和现在的时间是否是同一天，如果不是则清空完成次数
	if (!me->query("bangpai/finish_time") || me->query("bangpai/finish_time") / 86400 != time() / 86400)
	{
		me->delete("bangpai/finish");
		me->delete("bangpai/finish_time");
	}
		
    if (me->query("bangpai/finish")>=10)
    	return notify_fail("你今天做的帮派任务够多了，暂时没有什么任务给你做了。\n");
    	
	if (arg == "grass")
	{ 
		 if (me->is_busy())
			return notify_fail("你的动作还没有完成，不能移动。\n");
         if  (!me->query_temp("bangpai/quest/grass"))
      {
      
        me->set_temp("bangpai/quest/grass",1);
        tell_object(me,HIY"最近帮派草料急缺，你去扬州南边的宜兴镇割点草回来，速去速回（每次需要提交两份草料）！\n");     
       
      }   else
        if  (me->query_temp("bangpai/quest/grass"))
      {
           object grass;
           
            if (!objectp(grass=present("quest grass",me))||grass->query_amount()<2)
        	return notify_fail("你的草料呢？还不快去割草！\n");
        	
        	grass->add_amount(-2);

        	me->add("combat_exp",1000);
        	me->add("potential",1000);
        	me->delete_temp("bangpai/quest/grass");
        	me->add("bangpai/finish",1);
			// 设定完成时间
			me->set("bangpai/finish_time", time());

			// if (me->query("bangpai/finish")>=20)
			// {
			// 	if (me->query("combat_exp") < SHENGXIAN_D->query_combat_exp())
			// 	{
			// 		int birthday = me->query("birthday");
			// 		int x;
			// 		int combat_exp;
			// 		//判断建号的日期距离开服日期是几周 得到基础倍数 暂定x
			// 		x = (birthday - SHENGXIAN_D->query_start_time()) / 604800;
			// 		// 经验值为x*60万
			// 		combat_exp = x * 600000;

			// 		// 继续判断 现在的经验+这个经验 是否大于平均值 如果大于就我的经验设定为平均值 否则直接相加给予经验奖励
			// 		if (me->query("combat_exp") + combat_exp > SHENGXIAN_D->query_combat_exp())
			// 		{
			// 			me->set("combat_exp", SHENGXIAN_D->query_combat_exp());
			// 			tell_object(me, "你的经验达到追赶机制平均值" + SHENGXIAN_D->query_combat_exp() + "点经验了，继续加油啊！\n");
			// 		}
			// 		else
			// 		{
			// 			me->add("combat_exp", combat_exp);
			// 			tell_object(me, "你获得了" + combat_exp + "点经验，继续加油啊！\n");
			// 		}

			// 	}
			// }

        	BANGHUI_D->set_banghui(me->query("banghui/name")+"/exp", BANGHUI_D->query_banghui(me->query("banghui/name")+"/exp")+1);
        	BANGHUI_D->set_banghui(me->query("banghui/name")+"/gongxian/"+me->query("id"), BANGHUI_D->query_banghui(me->query("banghui/name")+"/gongxian/"+me->query("id"))+10);
        	tell_object(me,"你获得了1000点经验和潜能，1点帮会贡献，继续加油啊！\n");      
        	 	
       }
		return 1;
	}
	return 1;
}       
