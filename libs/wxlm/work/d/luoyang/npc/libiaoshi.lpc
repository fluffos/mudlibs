// 李镖师 - libiaoshi.c

inherit NPC;
int do_finish(string arg);
void create()
{

    set_name("李镖师", ({ "li biaoshi", "li", "biaoshi" }));
    set("long", "他是洛阳镖局的镖师，负责接收押镖任务。\n");
    set("gender", "男性");
    set("age", 40);

    set("combat_exp", 400000);
    set("attitude", "friendly");
    set("inquiry", ([
        "完成押镖" : (: do_finish :),
    ]));
    setup();

    carry_object("/clone/cloth/cloth")->wear();


}

void init()
{
    add_action("do_finish", "finish");
}

int do_finish(string arg)
{
    // 奖励计算
    int exp = 50000;
    int pot = 20000;
    int gold = 50;

    object me = this_player();

    if (!me->query_temp("escort/finished"))
    {
        tell_object(me, "你还没有完成押镖任务。\n");
        return 1;
    }

    
    me->add("combat_exp", exp);
    me->add("potential", pot);
    me->add("balance", gold * 10000); // 假设1 gold = 10000 balance

    tell_object(me, sprintf("李镖师说道：辛苦了，这是给你的奖励：\n经验：%d\n潜能：%d\n黄金：%d两\n", exp, pot, gold));

    me->delete_temp("escort");
    me->delete("escort_info");
    me->set_leader(0); // 停止跟随

    return 1;
}
