// 王镖头 - wangbiaotou.c

inherit NPC;

// 函数声明
int tell_task_info();
int do_accept_task();

void create()
{
    set_name("王镖头", ({ "wang biaotou", "wang", "biaotou" }));
    set("long", "他是长安镖局的总镖头，负责安排押镖任务。\n");
    set("gender", "男性");
    set("age", 45);

    set("combat_exp", 500000);
    set("attitude", "friendly");

    // 设置对玩家的回答和任务触发
    set("inquiry", ([
        "任务"     : (: tell_task_info :),    // 询问任务详情
        "押镖"     : (: tell_task_info :),
        "接受任务" : (: do_accept_task :),
        "开始押镖" : "如果你准备好了，就告诉我(ask wang about 接受任务)。",
    ]));

    setup();
    carry_object("/clone/cloth/cloth")->wear();
}

void init()
{
    add_action("do_accept_task", "accept"); // 接受任务的动作
}

// 弹出押镖任务详细介绍的弹窗
int tell_task_info()
{
    object me;
    string msg;
    string *buttons;

    me = this_player();

    // 押镖任务详细介绍
    msg = "押镖任务是一项充满挑战的任务，你需要护送镖车到达指定的地点。\n";
    msg += "在押镖过程中，你可能会遇到劫匪的袭击，需要用你的武艺和智慧来保护镖车的安全。\n";
    msg += "任务风险较高，但奖励也是丰厚的。\n\n";

    // 领取任务的条件
    msg += "【任务要求】\n";
    msg += "1. 战斗经验需达到 100,000 以上。\n";
    msg += "2. 每天只能完成一次押镖任务。\n";
    msg += "3. 需要独自押镖，暂不支持组队。\n\n";

    // 任务奖励说明
    msg += "【任务奖励】\n";
    msg += "1. 大量的经验和潜能奖励，具体数值根据押镖的完成情况决定。\n";
    msg += "2. 一定数量的黄金作为报酬。\n\n";

    // 劫匪生成条件和概率
    msg += "【注意事项】\n";
    msg += "1. 在押镖途中，每次移动都有 30% 的几率遇到劫匪。\n";
    msg += "2. 劫匪的实力根据你的等级动态调整，需小心应对。\n";
    msg += "3. 如果镖车被摧毁，任务将会失败，无法获得奖励。\n\n";

    msg += "你确定要开始押镖任务吗？\n";

    // 定义按钮列表，按钮传递文字指令
    buttons = ({
        "接受任务:ask wang about 接受任务",
    });

    // 使用封装的弹窗函数，显示信息和按钮
    tell_object(me, popup_comb(msg, buttons));

    return 1;
}

// 处理接受任务的指令
int do_accept_task()
{
    object me;

    me = this_player();

    // 检查玩家是否符合条件
    if (me->query("combat_exp") < 100000)
    {
        tell_object(me, "你的战斗经验不足，无法领取押镖任务。\n");
        return 1;
    }

    if (me->query("escort_today"))
    {
        tell_object(me, "你今天已经完成过押镖任务，明天再来吧。\n");
        return 1;
    }

    // 设置任务标记
    me->set("escort_ready", 1);
    me->set_temp("escort/level", 1); // 可根据需要设定任务难度

    tell_object(me, "王镖头说道：好，这份镖就交给你了，一路小心。\n");

    // 自动执行开始押镖的指令
    me->force_me("escort start");

    return 1;
}
