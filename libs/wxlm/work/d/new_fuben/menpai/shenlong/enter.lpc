
inherit ROOM;

void create()
{
    set("short", "神龙教入口");
    set("long", @LONG
这里是神龙教的入口，四周密林环绕，显得阴森诡秘。
你感受到一股危险的气息。
LONG);
    set("exits", ([
        "out"   : "/d/shenlong/wtroad1", // 连接到神龙教入口
        "enter" : __DIR__"dating",
    ]));
    set("no_fight", 1);
    setup();
}

void init()
{
    add_action("do_enter", "enter");
}

int do_enter(string arg)
{
    object me = this_player();

    if (!me->query_temp("menpai_challenge/shenlong"))
    {
        return notify_fail("你还没有开始神龙教的挑战。\n");
    }

    tell_object(me, "你步入了神龙教的领地。\n");
    me->move(__DIR__"dating");
    return 1;
}