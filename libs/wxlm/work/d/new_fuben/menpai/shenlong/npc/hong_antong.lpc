
inherit NPC;

void create()
{
    set_name("洪安通", ({ "hong antong", "hong", "antong" }));
    set("long", "他是神龙教的教主洪安通，武功深不可测，心狠手辣。\n");
    set("gender", "男性");
    set("age", 70);
    set("attitude", "aggressive");
    set("class", "fighter");

    set("str", 38);
    set("int", 35);
    set("con", 36);
    set("dex", 37);

    set("max_qi", 22000);
    set("max_jing", 18000);
    set("neili", 25000);
    set("max_neili", 25000);
    set("jiali", 300);
    set("combat_exp", 19000000);

    set_skill("force", 1550);
	set_skill("shenlong-xinfa", 1550);
	set_skill("dodge", 1530);
	set_skill("yixingbu", 1530);
	set_skill("hand", 1540);
	set_skill("shenlong-bashi", 1540);
	set_skill("strike", 1540);
	set_skill("huagu-mianzhang", 1540);
	set_skill("parry", 1550);
	set_skill("staff", 1550);
	set_skill("sword", 1550);
	set_skill("shedao-qigong", 1550);
	set_skill("unarmed", 1550);
	set_skill("literate", 1520);
	set_skill("medical", 1570);
	set_skill("shenlong-mixin", 1570);

	map_skill("force", "shenlong-xinfa");
	map_skill("dodge", "yixingbu");
	map_skill("hand", "shenlong-bashi");
	map_skill("strike", "huagu-mianzhang");
	map_skill("parry", "shedao-qigong");
	map_skill("staff", "shedao-qigong");
	map_skill("unarmed", "shedao-qigong");

	prepare_skill("strike", "huagu-mianzhang");
	prepare_skill("hand", "shenlong-bashi");

	
	
	set("chat_chance_combat", 120);
	set("chat_msg_combat", ({
		(: perform_action, "staff.chang" :),
		(: perform_action, "staff.chang2" :),
		(: perform_action, "staff.chang3" :),
		(: perform_action, "fei" :),
		(: perform_action, "xian" :),
		(: perform_action, "cui" :),
		(: perform_action, "strike.hua" :),
		(: perform_action, "hand.xian" :),
		(: exert_function, "powerup" :),
		(: exert_function, "recover" :),
	}));

	set_temp("apply/attack", 150);
	set_temp("apply/defense", 150);
	set_temp("apply/damage", 100);
	set_temp("apply/unarmed_damage", 100);
	set_temp("apply/armor", 200);

	setup();
	carry_object("/clone/weapon/gangzhang")->wield();
	carry_object("/clone/misc/cloth")->wear();
	add_money("silver", 35);
}

void die()
{
    object me = query_last_damage_from();
    if (me && me->query_temp("menpai_challenge/shenlong"))
    {
        tell_object(me, HIC "恭喜你成功挑战了神龙教！\n" NOR);
        me->delete_temp("menpai_challenge/shenlong");
        MENPAI_CHALLENGE_D->complete_challenge(me, "神龙教");
    }
    ::die();
}