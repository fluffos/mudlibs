
inherit ROOM;

void create()
{
    set("short", "神龙大厅");
    set("long", @LONG
这里是神龙教的大厅，布置奢华而邪异。
洪安通正坐在大厅的宝座上，目露凶光。
LONG);
    set("exits", ([
        "out" : __DIR__"enter",
    ]));
    set("objects", ([
        __DIR__"npc/hong_antong" : 1,
    ]));
    set("action_list", ([
        HIR"挑战"NOR : "challenge",
    ]));
    setup();
}

void init()
{
    add_action("do_challenge", "challenge");
}

int do_challenge(string arg)
{
    object me = this_player();
    object hong = present("hong antong", this_object());

    if (!hong)
    {
        return notify_fail("洪安通不在这里，无法进行挑战。\n");
    }

    if (!me->query_temp("menpai_challenge/shenlong"))
    {
        return notify_fail("你还没有开始神龙教的挑战。\n");
    }

    tell_object(me, HIY "你向神龙教教主洪安通发起了挑战！\n" NOR);
    hong->fight_ob(me);
    me->fight_ob(hong);
    return 1;
}