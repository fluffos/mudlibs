
inherit ROOM;

void create()
{
    set("short", "峨眉大殿");
    set("long", @LONG
这里是峨眉派的大殿，供奉着普贤菩萨的金身。
几位峨眉派的弟子正在虔诚地祈祷。
LONG );
    set("exits", ([
        "out" : __DIR__"enter",
    ]));
    set("objects", ([
        __DIR__"npc/miejue_shitai" : 1,
    ]));
    set("action_list", ([
        HIR"挑战"NOR : "challenge",
    ]));
    setup();
}

void init()
{
    add_action("do_challenge", "challenge");
}

int do_challenge(string arg)
{
    object me = this_player();
    object shitai = present("miejue shitai", this_object());

    if (!shitai)
    {
        return notify_fail("灭绝师太不在这里，无法进行挑战。\n");
    }

    if (!me->query_temp("menpai_challenge/emei"))
    {
        return notify_fail("你还没有开始峨眉派的挑战。\n");
    }

    tell_object(me, HIY "你向峨眉掌门灭绝师太发起了挑战！\n" NOR);
    shitai->fight_ob(me);
    me->fight_ob(shitai);
    return 1;
}