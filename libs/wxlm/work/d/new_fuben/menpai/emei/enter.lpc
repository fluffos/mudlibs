
inherit ROOM;

void create()
{
    set("short", "峨眉山门");
    set("long", @LONG
这里是峨眉派的山门，门前立着一块石碑，刻着“峨眉派”三个大字。
你感受到一股清新祥和的气息。
LONG );
    set("exits", ([
        "out"   : "/d/emei/shanmen", // 连接到峨眉派的入口
        "enter" : __DIR__"dadian",
    ]));
    set("no_fight", 1);
    setup();
}

void init()
{
    add_action("do_enter", "enter");
}

int do_enter(string arg)
{
    object me = this_player();

    if (!me->query_temp("menpai_challenge/emei"))
    {
        return notify_fail("你还没有开始峨眉派的挑战。\n");
    }

    tell_object(me, "你深吸一口气，踏入了峨眉山。\n");
    me->move(__DIR__"dadian");
    return 1;
}