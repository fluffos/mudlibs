
inherit NPC;

void create()
{
    set_name("灭绝师太", ({ "miejue shitai", "miejue", "shitai" }));
    set("long", "她是峨眉派的掌门人，容貌严肃，目光中透露出一丝锋利。\n");
    set("gender", "女性");
    set("age", 50);
    set("attitude", "peaceful");
    set("class", "taoist");

    set("str", 32);
    set("int", 32);
    set("con", 32);
    set("dex", 32);

    set("max_qi", 18000);
    set("max_jing", 14000);
    set("neili", 18000);
    set("max_neili", 18000);
    set("jiali", 220);
    set("combat_exp", 13000000);

    set_skill("force", 1100);
    set_skill("emei-xinfa", 1100);
    set_skill("dodge", 1100);
    set_skill("zhutian-bu", 1100);
    set_skill("parry", 1100);
    set_skill("sword", 1100);
    set_skill("huifeng-jian", 1100);
    set_skill("strike", 1100);
    set_skill("jinding-zhang", 1100);
    set_skill("mahayana", 1100);
    set_skill("literate", 1100);

    map_skill("force", "emei-xinfa");
    map_skill("dodge", "zhutian-bu");
    map_skill("parry", "huifeng-jian");
    map_skill("sword", "huifeng-jian");
    map_skill("strike", "jinding-zhang");

    prepare_skill("strike", "jinding-zhang");

    setup();
    carry_object("/d/emei/npc/obj/cloth")->wear();
    carry_object("/clone/weapon/changjian")->wield();
}

void die()
{
    object me = query_last_damage_from();
    if (me && me->query_temp("menpai_challenge/emei"))
    {
        tell_object(me, HIC "恭喜你成功挑战了峨眉派！\n" NOR);
        me->delete_temp("menpai_challenge/emei");
        MENPAI_CHALLENGE_D->complete_challenge(me, "峨眉派");
    }
    ::die();
}