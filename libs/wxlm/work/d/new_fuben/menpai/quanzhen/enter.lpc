
inherit ROOM;

void create()
{
    set("short", "全真教山门");
    set("long", @LONG
这里是全真教的山门，山门上方悬挂着“全真教”三个大字的匾额。
你感受到一股纯正浩然的道家气息。
LONG );
    set("exits", ([
        "out"   : "/d/quanzhen/shanmen", // 连接到全真教入口
        "enter" : __DIR__"dadian",
    ]));
    set("no_fight", 1);
    setup();
}

void init()
{
    add_action("do_enter", "enter");
}

int do_enter(string arg)
{
    object me = this_player();

    if (!me->query_temp("menpai_challenge/quanzhen"))
    {
        return notify_fail("你还没有开始全真教的挑战。\n");
    }

    tell_object(me, "你踏入了全真教的大门。\n");
    me->move(__DIR__"dadian");
    return 1;
}