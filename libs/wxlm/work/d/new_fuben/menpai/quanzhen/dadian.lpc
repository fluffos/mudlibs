
inherit ROOM;

void create()
{
    set("short", "全真大殿");
    set("long", @LONG
这里是全真教的大殿，正中供奉着三清祖师的神像。
几位道长正在殿内静修，气氛庄严肃穆。
LONG );
    set("exits", ([
        "out" : __DIR__"enter",
    ]));
    set("objects", ([
        __DIR__"npc/ma_yu" : 1,
    ]));
    set("action_list", ([
        HIR"挑战"NOR : "challenge",
    ]));
    setup();
}

void init()
{
    add_action("do_challenge", "challenge");
}

int do_challenge(string arg)
{
    object me = this_player();
    object mayu = present("ma yu", this_object());

    if (!mayu)
    {
        return notify_fail("马钰不在这里，无法进行挑战。\n");
    }

    if (!me->query_temp("menpai_challenge/quanzhen"))
    {
        return notify_fail("你还没有开始全真教的挑战。\n");
    }

    tell_object(me, HIY "你向全真教掌教马钰发起了挑战！\n" NOR);
    mayu->fight_ob(me);
    me->fight_ob(mayu);
    return 1;
}