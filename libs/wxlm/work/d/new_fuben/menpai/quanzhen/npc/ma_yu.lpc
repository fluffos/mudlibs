
inherit NPC;

void create()
{
    set_name("马钰", ({ "ma yu", "ma", "yu" }));
    set("long", "他是全真教的掌教真人马钰，道貌岸然，仙风道骨。\n");
    set("gender", "男性");
    set("age", 48);
    set("attitude", "peaceful");
    set("class", "taoist");

    set("str", 32);
    set("int", 34);
    set("con", 33);
    set("dex", 32);

    set("max_qi", 17000);
    set("max_jing", 13000);
    set("neili", 18000);
    set("max_neili", 18000);
    set("jiali", 220);
    set("combat_exp", 13000000);

    set_skill("force", 1100);
    set_skill("xiantian-gong", 1100);
    set_skill("dodge", 1100);
    set_skill("jinyan-gong", 1100);
    set_skill("parry", 1100);
    set_skill("sword", 1100);
    set_skill("quanzhen-jian", 1100);
    set_skill("finger", 1100);
    set_skill("zhongnan-zhi", 1100);
    set_skill("taoism", 1100);
    set_skill("literate", 1100);

    map_skill("force", "xiantian-gong");
    map_skill("dodge", "jinyan-gong");
    map_skill("parry", "quanzhen-jian");
    map_skill("sword", "quanzhen-jian");
    map_skill("finger", "zhongnan-zhi");

    prepare_skill("finger", "zhongnan-zhi");

    setup();
    carry_object("/d/quanzhen/npc/obj/greenrobe")->wear();
    carry_object("/clone/weapon/changjian")->wield();
}

void die()
{
    object me = query_last_damage_from();
    if (me && me->query_temp("menpai_challenge/quanzhen"))
    {
        tell_object(me, HIC "恭喜你成功挑战了全真教！\n" NOR);
        me->delete_temp("menpai_challenge/quanzhen");
        MENPAI_CHALLENGE_D->complete_challenge(me, "全真教");
    }
    ::die();
}