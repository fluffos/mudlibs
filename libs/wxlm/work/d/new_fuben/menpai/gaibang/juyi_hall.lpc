
inherit ROOM;

void create()
{
    set("short", "丐帮聚义厅");
    set("long", @LONG
这里是丐帮的聚义厅，厅内摆设简单，但却透着江湖豪迈之气。
厅中坐着一位衣衫褴褛的老者，目光炯炯有神。
LONG );
    set("exits", ([
        "out" : __DIR__"enter",
    ]));
    set("objects", ([
        __DIR__"npc/hong_qigong" : 1,
    ]));
    set("action_list", ([
        HIR"挑战"NOR : "challenge",
    ]));
    setup();
}

void init()
{
    add_action("do_challenge", "challenge");
}

int do_challenge(string arg)
{
    object me = this_player();
    object hong = present("hong qigong", this_object());

    if (!hong)
    {
        return notify_fail("洪七公不在这里，无法进行挑战。\n");
    }

    if (!me->query_temp("menpai_challenge/gaibang"))
    {
        return notify_fail("你还没有开始丐帮的挑战。\n");
    }

    tell_object(me, HIY "你向丐帮帮主洪七公发起了挑战！\n" NOR);
    hong->fight_ob(me);
    me->fight_ob(hong);
    return 1;
}