
inherit ROOM;

void create()
{
    set("short", "丐帮总舵入口");
    set("long", @LONG
这里是丐帮总舵的入口，四周破旧的建筑显得有些凌乱。
你站在这里，能感受到一股江湖草莽的气息。
LONG );
    set("exits", ([
        "out"   : "/d/city/pomiao", // 根据实际情况，连接到丐帮入口
        "enter" : __DIR__"juyi_hall",
    ]));
    set("no_fight", 1);
    setup();
}

void init()
{
    add_action("do_enter", "enter");
}

int do_enter(string arg)
{
    object me = this_player();

    if (!me->query_temp("menpai_challenge/gaibang"))
    {
        return notify_fail("你还没有开始丐帮的挑战。\n");
    }

    tell_object(me, "你深吸一口气，走进了丐帮总舵。\n");
    me->move(__DIR__"juyi_hall");
    return 1;
}