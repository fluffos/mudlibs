
inherit ROOM;

void create()
{
    set("short", "雪山派山门");
    set("long", @LONG
这里是雪山派的山门，四周白雪皑皑，寒风凛冽。
你感受到了一股凌厉的寒意。
LONG );
    set("exits", ([
        "out"   : "/d/xuedao/sroad1", // 连接到雪山派入口
        "enter" : __DIR__"main_hall",
    ]));
    set("no_fight", 1);
    setup();
}

void init()
{
    add_action("do_enter", "enter");
}

int do_enter(string arg)
{
    object me = this_player();

    if (!me->query_temp("menpai_challenge/xueshan"))
    {
        return notify_fail("你还没有开始雪山派的挑战。\n");
    }

    tell_object(me, "你踏入了雪山派的境地。\n");
    me->move(__DIR__"main_hall");
    return 1;
}