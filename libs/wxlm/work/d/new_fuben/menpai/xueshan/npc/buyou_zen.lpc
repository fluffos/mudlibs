
inherit NPC;

void create()
{
    set_name("布优禅师", ({ "buyou zen", "buyou", "zen" }));
    set("long", "他是雪山派的掌门人，身材高大，目光深邃。\n");
    set("gender", "男性");
    set("age", 55);
    set("attitude", "peaceful");
    set("class", "bonze");

    set("str", 36);
    set("int", 34);
    set("con", 36);
    set("dex", 35);

    set("max_qi", 20000);
    set("max_jing", 16000);
    set("neili", 22000);
    set("max_neili", 22000);
    set("jiali", 260);
    set("combat_exp", 17000000);

    set_skill("force", 1660);
	set_skill("longxiang", 1660);
	set_skill("mizong-neigong", 1660);
	set_skill("dodge", 1610);
	set_skill("shenkong-xing", 1610);
	set_skill("cuff", 1640);
	set_skill("yujiamu-quan", 1640);
	set_skill("hand", 1650);
	set_skill("dashou-yin", 1650);
	set_skill("parry", 1650);
	set_skill("staff", 1620);
	set_skill("xiangmo-chu", 1620);
	set_skill("lamaism", 1210);
	set_skill("literate", 1600);
	set_skill("hammer", 1670);
	set_skill("riyue-lun", 1670);
	set_skill("sword", 1650);
	set_skill("mingwang-jian", 1650);

	map_skill("force", "longxiang");
	map_skill("dodge", "shenkong-xing");
	map_skill("cuff", "yujiamu-quan");
	map_skill("hand", "dashou-yin");
	map_skill("parry", "riyue-lun");
	map_skill("sword", "xiangmo-chu");
	map_skill("hammer", "riyue-lun");

	prepare_skill("hand", "dashou-yin");
	prepare_skill("cuff", "yujiamu-quan");

	

	set("chat_chance_combat", 120);
	set("chat_msg_combat", ({
		(: perform_action, "hammer.poli" :),
		(: perform_action, "hammer.wulun" :),
		(: perform_action, "hand.jingang" :),
		(: perform_action, "cuff.chen" :),
		(: exert_function, "powerup" :),
		(: exert_function, "recover" :),
	}));

	set_temp("apply/attack", 150);
	set_temp("apply/defense", 150);
	set_temp("apply/damage", 100);
	set_temp("apply/unarmed_damage", 100);
	set_temp("apply/armor", 2000);

	setup();

	carry_object("/d/xueshan/obj/jinlun")->wield();
	carry_object("/d/xueshan/obj/p-jiasha")->wear();
	carry_object("/d/xueshan/obj/sengmao")->wear();
}

void die()
{
    object me = query_last_damage_from();
    if (me && me->query_temp("menpai_challenge/xueshan"))
    {
        tell_object(me, HIC "恭喜你成功挑战了雪山派！\n" NOR);
        me->delete_temp("menpai_challenge/xueshan");
        MENPAI_CHALLENGE_D->complete_challenge(me, "雪山派");
    }
    ::die();
}