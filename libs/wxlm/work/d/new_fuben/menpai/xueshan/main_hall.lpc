
inherit ROOM;

void create()
{
    set("short", "雪山大殿");
    set("long", @LONG
这里是雪山派的大殿，庄严肃穆。
一位身穿白衣的僧人正站在殿中。
LONG );
    set("exits", ([
        "out" : __DIR__"enter",
    ]));
    set("objects", ([
        __DIR__"npc/buyou_zen" : 1,
    ]));
    set("action_list", ([
        HIR"挑战"NOR : "challenge",
    ]));
    setup();
}

void init()
{
    add_action("do_challenge", "challenge");
}

int do_challenge(string arg)
{
    object me = this_player();
    object buyou = present("buyou zen", this_object());

    if (!buyou)
    {
        return notify_fail("布优禅师不在这里，无法进行挑战。\n");
    }

    if (!me->query_temp("menpai_challenge/xueshan"))
    {
        return notify_fail("你还没有开始雪山派的挑战。\n");
    }

    tell_object(me, HIY "你向雪山派掌门布优禅师发起了挑战！\n" NOR);
    buyou->fight_ob(me);
    me->fight_ob(buyou);
    return 1;
}