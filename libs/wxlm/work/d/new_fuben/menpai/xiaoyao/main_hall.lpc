
inherit ROOM;

void create()
{
    set("short", "逍遥大殿");
    set("long", @LONG
这里是逍遥派的大殿，清幽宁静。
一位白衣飘飘的老者正静坐于此。
LONG );
    set("exits", ([
        "out" : __DIR__"enter",
    ]));
    set("objects", ([
        __DIR__"npc/wuyazi" : 1,
    ]));
    set("action_list", ([
        HIR"挑战"NOR : "challenge",
    ]));
    setup();
}

void init()
{
    add_action("do_challenge", "challenge");
}

int do_challenge(string arg)
{
    object me = this_player();
    object wuyazi = present("wu yazi", this_object());

    if (!wuyazi)
    {
        return notify_fail("无崖子不在这里，无法进行挑战。\n");
    }

    if (!me->query_temp("menpai_challenge/xiaoyao"))
    {
        return notify_fail("你还没有开始逍遥派的挑战。\n");
    }

    tell_object(me, HIY "你向逍遥派掌门无崖子发起了挑战！\n" NOR);
    wuyazi->fight_ob(me);
    me->fight_ob(wuyazi);
    return 1;
}