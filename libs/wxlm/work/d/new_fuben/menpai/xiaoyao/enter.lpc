
inherit ROOM;

void create()
{
    set("short", "逍遥派山门");
    set("long", @LONG
这里是逍遥派的山门，四周云雾缭绕，宛如仙境。
你感受到一股飘逸出尘的气息。
LONG );
    set("exits", ([
        "out"   : "/d/xiaoyao/shanlu", // 连接到逍遥派入口
        "enter" : __DIR__"main_hall",
    ]));
    set("no_fight", 1);
    setup();
}

void init()
{
    add_action("do_enter", "enter");
}

int do_enter(string arg)
{
    object me = this_player();

    if (!me->query_temp("menpai_challenge/xiaoyao"))
    {
        return notify_fail("你还没有开始逍遥派的挑战。\n");
    }

    tell_object(me, "你踏入了逍遥派的境地。\n");
    me->move(__DIR__"main_hall");
    return 1;
}