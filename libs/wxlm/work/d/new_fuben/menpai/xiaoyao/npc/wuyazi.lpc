
inherit NPC;

void create()
{
    set_name("无崖子", ({ "wu yazi", "wu", "yazi" }));
    set("long", "他是逍遥派的掌门人，仙风道骨，令人敬仰。\n");
    set("gender", "男性");
    set("age", 70);
    set("attitude", "peaceful");
    set("class", "scholar");

    set("str", 38);
    set("int", 40);
    set("con", 38);
    set("dex", 37);

    set("max_qi", 22000);
    set("max_jing", 17000);
    set("neili", 25000);
    set("max_neili", 25000);
    set("jiali", 280);
    set("combat_exp", 18000000);

    set_skill("force", 1370);
	set_skill("xiaoyao-xinfa", 1370);
	set_skill("beiming-shengong", 1370);
	set_skill("xiaowuxiang", 1370);
	set_skill("dodge", 1370);
	set_skill("lingbo-weibu", 1370);
	set_skill("feiyan-zoubi", 1370);
	set_skill("liuyang-zhang", 1340);
	set_skill("parry", 1370);
	set_skill("blade", 1340);
	set_skill("ruyi-dao", 1340);
	set_skill("zhemei-shou", 1340);
	set_skill("hand", 1340);
	set_skill("strike", 1340);
	set_skill("literate", 200);
	set_skill("medical", 290);
	set_skill("xiaoyao-qixue", 1390);

	map_skill("force", "beiming-shengong");
	map_skill("dodge", "lingbo-weibu");
	map_skill("hand", "zhemei-shou");
	map_skill("strike", "liuyang-zhang");
	map_skill("parry", "ruyi-dao");
	map_skill("blade", "ruyi-dao");

	prepare_skill("hand","zhemei-shou");
	prepare_skill("strike","liuyang-zhang");

	create_family("逍遥派", 1, "开山祖师");
	set("class", "taoist");

	set("chat_chance_combat", 120);
	set("chat_msg_combat", ({
		(: perform_action, "blade.ruyi" :),
		(: perform_action, "hand.jiubu" :),
		(: perform_action, "strike.jiutian" :),
		(: perform_action, "dodge.lingbo" :),
		(: exert_function, "recover" :),
		(: exert_function, "powerup" :),
	}));

	set_temp("apply/attack", 150);
	set_temp("apply/defense", 150);
	set_temp("apply/damage", 100);
	set_temp("apply/unarmed_damage", 100);
	set_temp("apply/armor", 200);

	setup();
	carry_object("/clone/weapon/blade")->wield();
}

void die()
{
    object me = query_last_damage_from();
    if (me && me->query_temp("menpai_challenge/xiaoyao"))
    {
        tell_object(me, HIC "恭喜你成功挑战了逍遥派！\n" NOR);
        me->delete_temp("menpai_challenge/xiaoyao");
        MENPAI_CHALLENGE_D->complete_challenge(me, "逍遥派");
    }
    ::die();
}