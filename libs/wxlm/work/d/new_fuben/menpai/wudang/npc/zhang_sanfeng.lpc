
inherit NPC;

void create()
{
    set_name("张三丰", ({ "zhang sanfeng", "zhang", "sanfeng" }));
    set("long", "他是武当派的创始人，身穿道袍，看起来仙风道骨。\n");
    set("gender", "男性");
    set("age", 100);
    set("attitude", "peaceful");
    set("class", "taoist");

    set("str", 35);
    set("int", 35);
    set("con", 35);
    set("dex", 35);

    set("max_qi", 20000);
    set("max_jing", 15000);
    set("neili", 20000);
    set("max_neili", 20000);
    set("jiali", 250);
    set("combat_exp", 15000000);

    set_skill("force", 1200);
    set_skill("taiji-shengong", 1200);
    set_skill("dodge", 1200);
    set_skill("tiyunzong", 1200);
    set_skill("parry", 1200);
    set_skill("sword", 1200);
    set_skill("taiji-jian", 1200);
    set_skill("taoism", 1200);
    set_skill("literate", 1200);

    map_skill("force", "taiji-shengong");
    map_skill("dodge", "tiyunzong");
    map_skill("parry", "taiji-jian");
    map_skill("sword", "taiji-jian");

    set("chat_chance_combat", 100);
    set("chat_msg_combat", ({
        (: perform_action, "sword.lian" :),
    }));

    setup();
    carry_object("/d/wudang/obj/greyrobe")->wear();
    carry_object("/clone/weapon/changjian")->wield();
}

void die()
{
    object me = query_last_damage_from();
    if (me && me->query_temp("menpai_challenge/wudang"))
    {
        tell_object(me, HIC "恭喜你成功挑战了武当派！\n" NOR);
        me->delete_temp("menpai_challenge/wudang");
        MENPAI_CHALLENGE_D->complete_challenge(me, "武当派");
    }
    ::die();
}