
inherit ROOM;

void create()
{
    set("short", "武当山门");
    set("long", @LONG
这里是武当山的山门，山门上方挂着“太和山”三个金字牌匾。
你站在这里，感受到一股仙风道骨的气息。
LONG );
    set("exits", ([
        "out"   : "/d/wudang/gaotai", // 连接到武当派的入口
        "enter" : __DIR__"main_hall",
    ]));
    set("no_fight", 1);
    setup();
}

void init()
{
    add_action("do_enter", "enter");
}

int do_enter(string arg)
{
    object me = this_player();

    if (!me->query_temp("menpai_challenge/wudang"))
    {
        return notify_fail("你还没有开始武当派的挑战。\n");
    }

    tell_object(me, "你深吸一口气，踏入了武当山。\n");
    me->move(__DIR__"main_hall");
    return 1;
}