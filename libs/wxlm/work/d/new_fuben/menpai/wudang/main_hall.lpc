
inherit ROOM;

void create()
{
    set("short", "武当大殿");
    set("long", @LONG
这里是武当派的大殿，正前方供奉着真武大帝的神像。
两旁站立着几位武当弟子，神情肃穆。
LONG );
    set("exits", ([
        "out" : __DIR__"enter",
    ]));
    set("objects", ([
        __DIR__"npc/zhang_sanfeng" : 1,
    ]));
    set("action_list", ([
        HIR"挑战"NOR : "challenge",
    ]));
    setup();
}

void init()
{
    add_action("do_challenge", "challenge");
}

int do_challenge(string arg)
{
    object me = this_player();
    object zhang = present("zhang sanfeng", this_object());

    if (!zhang)
    {
        return notify_fail("张三丰不在这里，无法进行挑战。\n");
    }

    if (!me->query_temp("menpai_challenge/wudang"))
    {
        return notify_fail("你还没有开始武当派的挑战。\n");
    }

    tell_object(me, HIY "你向武当掌门张三丰发起了挑战！\n" NOR);
    zhang->fight_ob(me);
    me->fight_ob(zhang);
    return 1;
}