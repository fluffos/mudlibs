
inherit ROOM;

void create()
{
    set("short", "古墓入口");
    set("long", @LONG
这里是古墓派的入口，一股清冷之气扑面而来。
你感受到了一种与世隔绝的静谧。
LONG );
    set("exits", ([
        "out"   : "/d/gumu/shanlu1", // 连接到古墓派入口
        "enter" : __DIR__"zhengting",
    ]));
    set("no_fight", 1);
    setup();
}

void init()
{
    add_action("do_enter", "enter");
}

int do_enter(string arg)
{
    object me = this_player();

    if (!me->query_temp("menpai_challenge/gumu"))
    {
        return notify_fail("你还没有开始古墓派的挑战。\n");
    }

    tell_object(me, "你走进了古墓派的入口。\n");
    me->move(__DIR__"zhengting");
    return 1;
}