
inherit ROOM;

void create()
{
    set("short", "古墓正厅");
    set("long", @LONG
这里是古墓派的正厅，四周石壁上点着油灯，映照出幽暗的光线。
一位白衣少女正静静地坐在石室中央。
LONG );
    set("exits", ([
        "out" : __DIR__"enter",
    ]));
    set("objects", ([
        __DIR__"npc/xiaolongnv" : 1,
    ]));
    set("action_list", ([
        HIR"挑战"NOR : "challenge",
    ]));
    setup();
}

void init()
{
    add_action("do_challenge", "challenge");
}

int do_challenge(string arg)
{
    object me = this_player();
    object xiaolongnv = present("xiaolong nv", this_object());

    if (!xiaolongnv)
    {
        return notify_fail("小龙女不在这里，无法进行挑战。\n");
    }

    if (!me->query_temp("menpai_challenge/gumu"))
    {
        return notify_fail("你还没有开始古墓派的挑战。\n");
    }

    tell_object(me, HIY "你向古墓派掌门小龙女发起了挑战！\n" NOR);
    xiaolongnv->fight_ob(me);
    me->fight_ob(xiaolongnv);
    return 1;
}