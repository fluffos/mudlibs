
inherit NPC;

void create()
{
    set_name("小龙女", ({ "xiaolong nv", "xiaolong", "nv" }));
    set("long", "她是古墓派的掌门人小龙女，容貌清丽绝伦，宛如仙子。\n");
    set("gender", "女性");
    set("age", 28);
    set("attitude", "peaceful");
    set("class", "taoist");

    set("str", 32);
    set("int", 35);
    set("con", 34);
    set("dex", 36);

    set("max_qi", 19000);
    set("max_jing", 15000);
    set("neili", 19000);
    set("max_neili", 19000);
    set("jiali", 240);
    set("combat_exp", 14000000);

    set_skill("force", 1150);
    set_skill("yunv-xinfa", 1150);
    set_skill("dodge", 1200);
    set_skill("shexing-lifan", 1200);
    set_skill("parry", 1150);
    set_skill("sword", 1200);
    set_skill("yunv-jian", 1200);
    set_skill("unarmed", 1100);
    set_skill("meinv-quan", 1100);
    set_skill("literate", 1100);

    map_skill("force", "yunv-xinfa");
    map_skill("dodge", "shexing-lifan");
    map_skill("parry", "yunv-jian");
    map_skill("sword", "yunv-jian");
    map_skill("unarmed", "meinv-quan");

    prepare_skill("unarmed", "meinv-quan");

    setup();
    carry_object("/d/quanzhen/npc/obj/greenrobe")->wear();
    carry_object("/clone/weapon/changjian")->wield();
}

void die()
{
    object me = query_last_damage_from();
    if (me && me->query_temp("menpai_challenge/gumu"))
    {
        tell_object(me, HIC "恭喜你成功挑战了古墓派！\n" NOR);
        me->delete_temp("menpai_challenge/gumu");
        MENPAI_CHALLENGE_D->complete_challenge(me, "古墓派");
    }
    ::die();
}