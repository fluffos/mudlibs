
inherit ROOM;

void create()
{
    set("short", "星宿海入口");
    set("long", @LONG
这里是星宿派的驻地，四周充满了阴森诡秘的气息。
你感受到了一股邪恶的力量在环绕着你。
LONG );
    set("exits", ([
        "out"   : "/d/xingxiu/xxh1", // 连接到星宿派入口
        "enter" : __DIR__"dating",
    ]));
    set("no_fight", 1);
    setup();
}

void init()
{
    add_action("do_enter", "enter");
}

int do_enter(string arg)
{
    object me = this_player();

    if (!me->query_temp("menpai_challenge/xingxiu"))
    {
        return notify_fail("你还没有开始星宿派的挑战。\n");
    }

    tell_object(me, "你走进了星宿派的驻地。\n");
    me->move(__DIR__"dating");
    return 1;
}