
inherit ROOM;

void create()
{
    set("short", "星宿大堂");
    set("long", @LONG
这里是星宿派的大堂，四周布满了骷髅和怪异的符号。
堂上坐着一位阴险狡诈的老者，正冷冷地注视着你。
LONG );
    set("exits", ([
        "out" : __DIR__"enter",
    ]));
    set("objects", ([
        __DIR__"npc/ding_chunqiu" : 1,
    ]));
    set("action_list", ([
        HIR"挑战"NOR : "challenge",
    ]));
    setup();
}

void init()
{
    add_action("do_challenge", "challenge");
}

int do_challenge(string arg)
{
    object me = this_player();
    object ding = present("ding chunqiu", this_object());

    if (!ding)
    {
        return notify_fail("丁春秋不在这里，无法进行挑战。\n");
    }

    if (!me->query_temp("menpai_challenge/xingxiu"))
    {
        return notify_fail("你还没有开始星宿派的挑战。\n");
    }

    tell_object(me, HIY "你向星宿老怪丁春秋发起了挑战！\n" NOR);
    ding->fight_ob(me);
    me->fight_ob(ding);
    return 1;
}