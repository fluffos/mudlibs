
inherit NPC;

void create()
{
    set_name("丁春秋", ({ "ding chunqiu", "ding", "chunqiu" }));
    set("long", "他就是星宿派的开山祖师，星宿老怪丁春秋，面带阴险的笑容。\n");
    set("gender", "男性");
    set("age", 65);
    set("attitude", "aggressive");
    set("class", "taoist");

    set("str", 35);
    set("int", 32);
    set("con", 33);
    set("dex", 34);

    set("max_qi", 19000);
    set("max_jing", 15000);
    set("neili", 20000);
    set("max_neili", 20000);
    set("jiali", 250);
    set("combat_exp", 15000000);

    set_skill("force", 1420);
	set_skill("huagong-dafa", 1420);
	set_skill("guixi-gong", 1400);
	set_skill("throwing", 1410);
	set_skill("feixing-shu", 1410);
	set_skill("dodge", 1480);
	set_skill("zhaixinggong", 1480);
	set_skill("strike", 1485);
	set_skill("chousui-zhang", 1485);
	set_skill("claw", 1480);
	set_skill("sanyin-wugongzhao", 1480);
	set_skill("whip", 1480);
	set_skill("chanhun-suo", 1480);
	set_skill("parry", 1485);
	set_skill("staff", 1490);
	set_skill("poison", 1255);
	set_skill("tianshan-zhang", 1490);
	set_skill("literate", 1120);
	set_skill("medical", 1265);
	set_skill("xingxiu-qishu", 1265);

	map_skill("force", "huagong-dafa");
	map_skill("dodge", "zhaixinggong");
	map_skill("strike", "chousui-zhang");
	map_skill("claw", "sanyin-wugongzhao");
	map_skill("whip", "chanhun-suo");
	map_skill("parry", "tianshan-zhang");
	map_skill("staff", "tianshan-zhang");

	prepare_skill("strike", "chousui-zhang");
	prepare_skill("claw", "sanyin-wugongzhao");

	set("book_count", 1);
	set("zhen_count", 1);
	set("san_count", 1);
	set("xiangliao_count", random(10) + 5);
    set_temp("apply/damage", 280);
	set_temp("apply/armor", 400);
	set_temp("apply/attack", 250);
	set_temp("apply/dodge", 250);
	set_temp("apply/parry", 250);

    setup();
    carry_object("/clone/weapon/gangzhang")->wield();
}

void die()
{
    object me = query_last_damage_from();
    if (me && me->query_temp("menpai_challenge/xingxiu"))
    {
        tell_object(me, HIC "恭喜你成功挑战了星宿派！\n" NOR);
        me->delete_temp("menpai_challenge/xingxiu");
        MENPAI_CHALLENGE_D->complete_challenge(me, "星宿派");
    }
    ::die();
}