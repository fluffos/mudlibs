
inherit ROOM;

void create()
{
    set("short", "血刀门山门");
    set("long", @LONG
这里是血刀门的山门，充满了阴森恐怖的气息。
你感受到了一股危险的力量。
LONG );
    set("exits", ([
        "out"   : "/d/xuedao/xdroad1", // 连接到血刀门入口
        "enter" : __DIR__"main_hall",
    ]));
    set("no_fight", 1);
    setup();
}

void init()
{
    add_action("do_enter", "enter");
}

int do_enter(string arg)
{
    object me = this_player();

    if (!me->query_temp("menpai_challenge/xuedao"))
    {
        return notify_fail("你还没有开始血刀门的挑战。\n");
    }

    tell_object(me, "你踏入了血刀门的境地。\n");
    me->move(__DIR__"main_hall");
    return 1;
}