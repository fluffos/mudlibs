
inherit NPC;

void create()
{
    set_name("血刀老祖", ({ "xuedao laozu", "xuedao", "laozu" }));
    set("long", "他是血刀门的创始人，浑身散发着邪恶的气息。\n");
    set("gender", "男性");
    set("age", 70);
    set("attitude", "aggressive");
    set("class", "bonze");

    set("str", 38);
    set("int", 33);
    set("con", 37);
    set("dex", 36);

    set("max_qi", 21000);
    set("max_jing", 16000);
    set("neili", 23000);
    set("max_neili", 23000);
    set("jiali", 270);
    set("combat_exp", 18000000);

    set_skill("lamaism", 1220);
	set_skill("literate", 180);
	set_skill("force", 1530);
	set_skill("parry", 1520);
	set_skill("blade", 1525);
	set_skill("xue-dao", 1525);
	set_skill("sword", 1580);
	set_skill("mingwang-jian", 1580);
	set_skill("dodge", 1510);
	set_skill("mizong-neigong", 1530);
	set_skill("xuehai-mogong", 1530);
	set_skill("shenkong-xing", 1510);
	set_skill("hand", 1500);
	set_skill("dashou-yin", 1500);
	set_skill("cuff", 1500);
	set_skill("yujiamu-quan", 1500);

	map_skill("force", "xuehai-mogong");
	map_skill("dodge", "shenkong-xing");
	map_skill("hand", "dashou-yin");
	map_skill("cuff", "yujiamu-quan");
	map_skill("parry", "xue-dao");
	map_skill("blade", "xue-dao");
	map_skill("sword", "mingwang-jian");

	prepare_skill("cuff", "yujiamu-quan");
	prepare_skill("hand", "dashou-yin");

	set("chat_chance_combat", 120);
	set("chat_msg_combat", ({
		(: perform_action, "blade.shendao" :),
		(: perform_action, "blade.xueyu" :),
		(: perform_action, "hand.jingang" :),
		(: perform_action, "cuff.chen" :),
		(: exert_function, "powerup" :),
		(: exert_function, "recover" :),
	}));

	
	set("class", "bonze");

	

	set_temp("apply/attack", 150);
	set_temp("apply/defense", 150);
	set_temp("apply/damage", 100);
	set_temp("apply/unarmed_damage", 100);
	set_temp("apply/armor", 200);

	setup();
	carry_object("/d/xueshan/obj/y-jiasha")->wear();
	carry_object("/d/xuedao/obj/xblade")->wield();

	add_money("silver", 3);
	set("xblade_count", 1);
}

void die()
{
    object me = query_last_damage_from();
    if (me && me->query_temp("menpai_challenge/xuedao"))
    {
        tell_object(me, HIC "恭喜你成功挑战了血刀门！\n" NOR);
        me->delete_temp("menpai_challenge/xuedao");
        MENPAI_CHALLENGE_D->complete_challenge(me, "血刀门");
    }
    ::die();
}