
inherit ROOM;

void create()
{
    set("short", "血刀大殿");
    set("long", @LONG
这里是血刀门的大殿，布满了血迹与骷髅。
一位手持血刀的僧人正阴笑着看着你。
LONG );
    set("exits", ([
        "out" : __DIR__"enter",
    ]));
    set("objects", ([
        __DIR__"npc/xuedao_old" : 1,
    ]));
    set("action_list", ([
        HIR"挑战"NOR : "challenge",
    ]));
    setup();
}

void init()
{
    add_action("do_challenge", "challenge");
}

int do_challenge(string arg)
{
    object me = this_player();
    object xuedao = present("xuedao laozu", this_object());

    if (!xuedao)
    {
        return notify_fail("血刀老祖不在这里，无法进行挑战。\n");
    }

    if (!me->query_temp("menpai_challenge/xuedao"))
    {
        return notify_fail("你还没有开始血刀门的挑战。\n");
    }

    tell_object(me, HIY "你向血刀老祖发起了挑战！\n" NOR);
    xuedao->fight_ob(me);
    me->fight_ob(xuedao);
    return 1;
}