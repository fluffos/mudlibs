// /d/fuben/menpai_challenge/shaolin/dadian.c


inherit ROOM;

void create()
{
    set("short", "少林大殿");
    set("long", @LONG
这里是少林寺的大殿,宽敞明亮。正前方供奉着佛祖释迦牟尼的金身。
两旁站立着几位少林高僧,神情严肃地看着你。
LONG );
    set("exits", ([
        "out" : __DIR__"enter",
    ]));
    set("objects", ([
        __DIR__"npc/fangzhang" : 1,
    ]));
    set("action_list", ([
		HIR"挑战"NOR : "challenge",
	]));
    setup();
}

void init()
{
    add_action("do_challenge", "challenge");
}

int do_challenge(string arg)
{
    object me = this_player();
    object fangzhang = present("fang zhang", this_object());
    
    if (!fangzhang)
    {
        return notify_fail("方丈不在这里,无法进行挑战。\n");
    }
    
    if (!me->query_temp("menpai_challenge/shaolin"))
    {
        return notify_fail("你还没有开始少林派的挑战。\n");
    }
    
    tell_object(me, HIY "你向少林方丈发起了挑战！\n" NOR);
    fangzhang->fight_ob(me);
    me->fight_ob(fangzhang);
    return 1;
}