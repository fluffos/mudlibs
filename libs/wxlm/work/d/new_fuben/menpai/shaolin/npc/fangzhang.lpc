// /d/fuben/menpai_challenge/shaolin/npc/fangzhang.c


inherit NPC;

void create()
{
    set_name("少林方丈", ({ "fang zhang", "fangzhang", "zhang" }));
    set("long", "这是少林寺的方丈,看起来慈眉善目,但身上却散发着强大的气场。\n");
    set("gender", "男性");
    set("age", 60);
    set("attitude", "peaceful");
    set("class", "bonze");
    
    set("str", 30);
    set("int", 30);
    set("con", 30);
    set("dex", 30);
    
    set("max_qi", 15000);
    set("max_jing", 13000);
    set("neili", 15000);
    set("max_neili", 15000);
    set("jiali", 200);
    set("combat_exp", 12000000);
    
    set_skill("force", 1000);
    set_skill("hunyuan-yiqi", 1000);
    set_skill("dodge", 1000);
    set_skill("shaolin-shenfa", 1000);
    set_skill("parry", 1000);
    set_skill("cuff", 1000);
    set_skill("jingang-quan", 1000);
    set_skill("staff", 1000);
    set_skill("pudu-zhang", 1000);
    set_skill("buddhism", 1000);
    set_skill("literate", 1000);
    
    map_skill("force", "hunyuan-yiqi");
    map_skill("dodge", "shaolin-shenfa");
    map_skill("parry", "pudu-zhang");
    map_skill("cuff", "jingang-quan");
    map_skill("staff", "pudu-zhang");
    
    prepare_skill("cuff", "jingang-quan");
    
    setup();
    
    carry_object("/d/shaolin/obj/xuan-cloth")->wear();
    carry_object("/d/shaolin/obj/chanzhang")->wield();
}

void die()
{
    object me = query_last_damage_from();
    if (me && me->query_temp("menpai_challenge/shaolin"))
    {
        tell_object(me, HIC "恭喜你成功挑战了少林派！\n" NOR);
        me->delete_temp("menpai_challenge/shaolin");
        MENPAI_CHALLENGE_D->complete_challenge(me, "少林派");
    }
    else if (me)
    {
        tell_object(me, HIC "少林派判定异常！\n" NOR);
    }

    ::die();
}