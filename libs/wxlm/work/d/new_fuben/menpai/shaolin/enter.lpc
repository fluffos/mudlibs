// /d/fuben/menpai_challenge/shaolin/enter.c


inherit ROOM;

void create()
{
    set("short", "少林寺山门");
    set("long", @LONG
这里是少林寺的山门,高大的门楼上刻着"少林寺"三个大字。你站在这里,
感受到一股庄严肃穆的气氛。
LONG );
    set("exits", ([
        "out"   : "/d/shaolin/shanmen",
        "enter" : __DIR__"dadian",
    ]));
    set("no_fight", 1);
    setup();
}

void init()
{
    add_action("do_enter", "enter");
}

int do_enter(string arg)
{
    object me = this_player();
    
    if (!me->query_temp("menpai_challenge/shaolin"))
    {
        return notify_fail("你还没有开始少林派的挑战。\n");
    }
    
    tell_object(me, "你深吸一口气,踏入了少林寺。\n");
    me->move(__DIR__"dadian");
    return 1;
}