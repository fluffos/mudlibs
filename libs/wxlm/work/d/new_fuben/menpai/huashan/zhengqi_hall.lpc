
inherit ROOM;

void create()
{
    set("short", "正气堂");
    set("long", @LONG
这里是华山派的正气堂，堂内摆设简朴，但却透着一股浩然正气。
堂中正坐着一位仙风道骨的中年男子。
LONG );
    set("exits", ([
        "out" : __DIR__"enter",
    ]));
    set("objects", ([
        __DIR__"npc/yue_buqun" : 1,
    ]));
    set("action_list", ([
        HIR"挑战"NOR : "challenge",
    ]));
    setup();
}

void init()
{
    add_action("do_challenge", "challenge");
}

int do_challenge(string arg)
{
    object me = this_player();
    object yue = present("yue buqun", this_object());

    if (!yue)
    {
        return notify_fail("岳不群不在这里，无法进行挑战。\n");
    }

    if (!me->query_temp("menpai_challenge/huashan"))
    {
        return notify_fail("你还没有开始华山派的挑战。\n");
    }

    tell_object(me, HIY "你向华山掌门岳不群发起了挑战！\n" NOR);
    yue->fight_ob(me);
    me->fight_ob(yue);
    return 1;
}