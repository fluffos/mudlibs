
inherit ROOM;

void create()
{
    set("short", "华山山门");
    set("long", @LONG
这里是华山派的山门，两边立着一对石狮子，显得庄严肃穆。
你站在这里，感受到一股凌厉的剑气。
LONG );
    set("exits", ([
        "out"   : "/d/huashan/path1", // 连接到华山派的入口
        "enter" : __DIR__"zhengqi_hall",
    ]));
    set("no_fight", 1);
    setup();
}

void init()
{
    add_action("do_enter", "enter");
}

int do_enter(string arg)
{
    object me = this_player();

    if (!me->query_temp("menpai_challenge/huashan"))
    {
        return notify_fail("你还没有开始华山派的挑战。\n");
    }

    tell_object(me, "你深吸一口气，踏入了华山派。\n");
    me->move(__DIR__"zhengqi_hall");
    return 1;
}