
inherit NPC;

void create()
{
    set_name("岳不群", ({ "yue buqun", "yue", "buqun" }));
    set("long", "他是华山派的掌门人，被誉为君子剑，外表儒雅，内心深沉。\n");
    set("gender", "男性");
    set("age", 50);
    set("attitude", "peaceful");
    set("class", "swordsman");

    set("str", 33);
    set("int", 34);
    set("con", 33);
    set("dex", 34);

    set("max_qi", 18000);
    set("max_jing", 14000);
    set("neili", 18000);
    set("max_neili", 18000);
    set("jiali", 230);
    set("combat_exp", 14000000);

    set_skill("force", 1150);
    set_skill("zixia-shengong", 1150);
    set_skill("dodge", 1150);
    set_skill("shexing-lifan", 1150);
    set_skill("parry", 1150);
    set_skill("sword", 1200);
    set_skill("lonely-sword", 1200);
    set_skill("strike", 1100);
    set_skill("literate", 1100);

    map_skill("force", "zixia-shengong");
    map_skill("dodge", "shexing-lifan");
    map_skill("parry", "lonely-sword");
    map_skill("sword", "lonely-sword");
    

    prepare_skill("sword", "lonely-sword");

    setup();
    carry_object("/d/wudang/obj/greyrobe")->wear();
    carry_object("/clone/weapon/changjian")->wield();
}

void die()
{
    object me = query_last_damage_from();
    if (me && me->query_temp("menpai_challenge/huashan"))
    {
        tell_object(me, HIC "恭喜你成功挑战了华山派！\n" NOR);
        me->delete_temp("menpai_challenge/huashan");
        MENPAI_CHALLENGE_D->complete_challenge(me, "华山派");
    }
    ::die();
}