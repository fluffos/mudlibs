
inherit NPC;

void create()
{
    set_name("张无忌", ({ "zhang wuji", "zhang", "wuji" }));
    set("long", "他是明教的教主张无忌，武功盖世，仁义待人。\n");
    set("gender", "男性");
    set("age", 24);
    set("attitude", "friendly");
    set("class", "fighter");

    set("str", 40);
    set("int", 38);
    set("con", 40);
    set("dex", 39);

    set("max_qi", 25000);
    set("max_jing", 20000);
    set("neili", 30000);
    set("max_neili", 30000);
    set("jiali", 350);
    set("combat_exp", 20000000);

    set_skill("force", 1700);
        set_skill("unarmed", 1700);
        set_skill("dodge", 1700);
        set_skill("parry", 1700);
        set_skill("cuff", 1700);
        set_skill("sword", 1700);
        set_skill("blade", 1700);
        set_skill("strike", 1700);
        set_skill("claw", 1700);
        set_skill("throwing", 1700);
        // set_skill("duoming-jinhua", 450);
        set_skill("jiuyang-shengong", 1700);
        set_skill("shenghuo-xinfa", 1700);
        set_skill("shenghuo-shengong", 1700);
        set_skill("lingxu-bu", 1700);
        set_skill("shenghuo-bu", 1700);
        set_skill("qingfu-shenfa", 1700);
        set_skill("qiankun-danuoyi", 1700);
        set_skill("qishang-quan", 1700);
        set_skill("taiji-quan", 1700);
        set_skill("taiji-jian", 1700);
        set_skill("taiji-dao", 1700);
        set_skill("lieyan-dao", 1700);
        set_skill("liehuo-jian", 1700);
        // set_skill("yingzhua-shou", 450);
        // set_skill("hanbing-mianzhang", 450);
        set_skill("shenghuo-ling", 1700);
        set_skill("guangming-zhang", 1700);
        set_skill("medical", 1300);
        set_skill("literate", 1300);
        set_skill("martial-cognize", 1700);
        set_skill("guangming-jing", 1700);

        map_skill("force", "jiuyang-shengong");
        map_skill("dodge", "qingfu-shenfa");
        map_skill("unarmed", "jiuyang-shengong");
        map_skill("strike","guangming-zhang");
        map_skill("cuff", "qishang-quan");
        map_skill("sword","shenghuo-ling");
        map_skill("parry","qiankun-danuoyi");
        map_skill("blade","taiji-dao");
        // map_skill("claw", "yingzhua-shou");
        // map_skill("throwing", "duoming-jinhua");
        // map_skill("strike", "hanbing-mianzhang");

        prepare_skill("cuff", "qishang-quan");

    
        set_temp("apply/attack", 180);
        set_temp("apply/damage", 180);
        set_temp("apply/unarmed_damage", 180);
        set_temp("apply/armor", 180);
    
        set("chat_chance_combat", 120);
        set("chat_msg_combat", ({
                (: command("perform sword.hua") :),
                (: command("perform sword.xi") :),
                (: command("perform sword.lian") :),
                (: command("perform sword.can") :),
                (: command("perform cuff.shang") :),
                (: command("perform cuff.fei") :),
                (: command("yun shield") :),
                (: command("yun powerup") :),
                (: command("yun recover") :),
        }) );
	   
    set("chat_chance", 1);
    set("chat_msg", ({
	"张无极愤然说道“大丈夫当以国为家, 捐躯沙场, 抗元大业未成, 同辈仍需努力!”\n",
	"张无极叹道“人生失一知己, 生亦何欢, 死亦何忧, 敏儿, 你在哪里?”\n",
	"张无极道“我教兄弟听了: 生于乱世, 当克己为公, 行侠仗义, 荡寇驱魔!”\n",
    }));

    
	setup();
	carry_object("/clone/cloth/cloth")->wear();
	// carry_object("/clone/weapon/gangjian")->wield();
	carry_object("/clone/book/shenghuo-ling")->wield();
	add_money("silver", 70);
}

void die()
{
    object me = query_last_damage_from();
    if (me && me->query_temp("menpai_challenge/mingjiao"))
    {
        tell_object(me, HIC "恭喜你成功挑战了明教！\n" NOR);
        me->delete_temp("menpai_challenge/mingjiao");
        MENPAI_CHALLENGE_D->complete_challenge(me, "明教");
    }
    ::die();
}