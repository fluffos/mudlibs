
inherit ROOM;

void create()
{
    set("short", "光明顶广场");
    set("long", @LONG
这里是光明顶广场，广场中央立着一根巨大的火焰标志。
张无忌正站在广场中央，等待着你的到来。
LONG);
    set("exits", ([
        "out" : __DIR__"enter",
    ]));
    set("objects", ([
        __DIR__"npc/zhang_wuji" : 1,
    ]));
    set("action_list", ([
        HIR"挑战"NOR : "challenge",
    ]));
    setup();
}

void init()
{
    add_action("do_challenge", "challenge");
}

int do_challenge(string arg)
{
    object me = this_player();
    object zhang = present("zhang wuji", this_object());

    if (!zhang)
    {
        return notify_fail("张无忌不在这里，无法进行挑战。\n");
    }

    if (!me->query_temp("menpai_challenge/mingjiao"))
    {
        return notify_fail("你还没有开始明教的挑战。\n");
    }

    tell_object(me, HIY "你向明教教主张无忌发起了挑战！\n" NOR);
    zhang->fight_ob(me);
    me->fight_ob(zhang);
    return 1;
}