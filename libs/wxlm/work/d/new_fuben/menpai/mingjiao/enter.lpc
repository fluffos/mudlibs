
inherit ROOM;

void create()
{
    set("short", "光明顶山门");
    set("long", @LONG
这里是明教的总坛光明顶，山势陡峭，气势磅礴。
你感受到了一股浩然正气。
LONG);
    set("exits", ([
        "out"   : "/d/mingjiao/tomen1", // 连接到光明顶入口
        "enter" : __DIR__"guangchang",
    ]));
    set("no_fight", 1);
    setup();
}

void init()
{
    add_action("do_enter", "enter");
}

int do_enter(string arg)
{
    object me = this_player();

    if (!me->query_temp("menpai_challenge/mingjiao"))
    {
        return notify_fail("你还没有开始明教的挑战。\n");
    }

    tell_object(me, "你迈步进入了明教总坛。\n");
    me->move(__DIR__"guangchang");
    return 1;
}