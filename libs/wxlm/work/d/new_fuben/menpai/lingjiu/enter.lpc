
inherit ROOM;

void create()
{
    set("short", "灵鹫宫山门");
    set("long", @LONG
这里是灵鹫宫的入口，云雾缭绕，宛如仙境。
你感受到一股冷峻的气息。
LONG );
    set("exits", ([
        "out"   : "/d/lingjiu/shanmen", // 连接到灵鹫宫入口
        "enter" : __DIR__"main_hall",
    ]));
    set("no_fight", 1);
    setup();
}

void init()
{
    add_action("do_enter", "enter");
}

int do_enter(string arg)
{
    object me = this_player();

    if (!me->query_temp("menpai_challenge/lingjiu"))
    {
        return notify_fail("你还没有开始灵鹫宫的挑战。\n");
    }

    tell_object(me, "你踏入了灵鹫宫的境地。\n");
    me->move(__DIR__"main_hall");
    return 1;
}