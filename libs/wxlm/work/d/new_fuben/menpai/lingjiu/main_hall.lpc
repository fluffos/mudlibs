
inherit ROOM;

void create()
{
    set("short", "灵鹫大殿");
    set("long", @LONG
这里是灵鹫宫的大殿，气氛庄严肃穆。
一位美貌绝伦的女子正站在殿中，目光冷峻。
LONG );
    set("exits", ([
        "out" : __DIR__"enter",
    ]));
    set("objects", ([
        __DIR__"npc/tianshan_tonglao" : 1,
    ]));
    set("action_list", ([
        HIR"挑战"NOR : "challenge",
    ]));
    setup();
}

void init()
{
    add_action("do_challenge", "challenge");
}

int do_challenge(string arg)
{
    object me = this_player();
    object tonglao = present("tianshan tonglao", this_object());

    if (!tonglao)
    {
        return notify_fail("天山童姥不在这里，无法进行挑战。\n");
    }

    if (!me->query_temp("menpai_challenge/lingjiu"))
    {
        return notify_fail("你还没有开始灵鹫宫的挑战。\n");
    }

    tell_object(me, HIY "你向灵鹫宫宫主天山童姥发起了挑战！\n" NOR);
    tonglao->fight_ob(me);
    me->fight_ob(tonglao);
    return 1;
}