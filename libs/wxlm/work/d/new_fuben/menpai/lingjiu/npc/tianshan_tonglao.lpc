
inherit NPC;

void create()
{
    set_name("天山童姥", ({ "tianshan tonglao", "tianshan", "tonglao" }));
    set("long", "她是灵鹫宫的宫主，虽貌似幼女，实则武功深不可测。\n");
    set("gender", "女性");
    set("age", 96);
    set("attitude", "aggressive");
    set("class", "fighter");

    set("str", 40);
    set("int", 38);
    set("con", 37);
    set("dex", 39);

    set("max_qi", 23000);
    set("max_jing", 18000);
    set("neili", 26000);
    set("max_neili", 26000);
    set("jiali", 300);
    set("combat_exp", 19000000);

    set_skill("force", 1270);
	set_skill("dodge", 1270);
	set_skill("parry", 1270);
	set_skill("hand", 1270);
	set_skill("strike", 1270);

	set_skill("zhemei-shou", 1270);
	set_skill("liuyang-zhang", 1270);
	set_skill("yueying-wubu", 1270);
	set_skill("bahuang-gong", 1270);

	map_skill("force", "bahuang-gong");
	map_skill("strike", "liuyang-zhang");
	map_skill("dodge", "yueying-wubu");
	map_skill("hand", "zhemei-shou");
	map_skill("parry", "liuyang-zhang");

	prepare_skill("hand","zhemei-shou");
	prepare_skill("strike","liuyang-zhang");	

	set("chat_chance_combat", 120);
	set("chat_msg_combat", ({
		(: perform_action, "hand.jiubu" :),
		(: perform_action, "strike.jiutian" :),
		(: exert_function, "recover" :),
	}));

	
	setup();
	carry_object("/d/lingjiu/obj/changpao")->wear();
}

void die()
{
    object me = query_last_damage_from();
    if (me && me->query_temp("menpai_challenge/lingjiu"))
    {
        tell_object(me, HIC "恭喜你成功挑战了灵鹫宫！\n" NOR);
        me->delete_temp("menpai_challenge/lingjiu");
        MENPAI_CHALLENGE_D->complete_challenge(me, "灵鹫宫");
    }
    ::die();
}