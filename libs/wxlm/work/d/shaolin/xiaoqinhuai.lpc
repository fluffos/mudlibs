// Room: /d/shaolin/hanshui1.c

inherit ROOM;
void create()
{
	set("short", "小秦淮");
	set("long", @LONG
小秦淮河边，微风拂面，带着一丝凉爽与宁静。河面波光粼粼，倒映着两岸的灯火与月色，宛如银河落入凡间，璀璨夺目。
偶尔有游船画舫缓缓驶过，荡起层层涟漪，打破了水面的平静。
船上隐约传来丝竹之音，与这夜色相得益彰，更添几分诗意雅致。岸边，垂柳依依，随风轻摆，间有小摊给路过游人歇息饮食。
LONG );
	set("exits", ([
		// "north" : "/adm/special_ob/duanwu/map/yunhe_wai",
		"south" : __DIR__"hanshui1",
		"east" : __DIR__"wangyuetai",
	]));

	set("outdoors", "nanyang");
	setup();
}