#include <room.h>
inherit ROOM;

/**
 * @brief 创建武尊组竞技场房间
 * @return void
 * @details 武魁之战的专用比武场地，只允许武尊参与的高级竞技
 */
void create()
{
	set("short", "竞技场(武尊组)");
	set("long", "这里是武魁之战的比武竞技场，只有达到三花境界的武尊才能踏足此地。空气中弥漫着强者的气息，这里将决出最强的武魁五绝。");
	set("exits", ([
		"out" : __DIR__"wuzun_enter",
	]));
	set("objects",([
	]));
	setup();
}

/**
 * @brief 限制离开房间的行为
 * @param me object 尝试离开的玩家
 * @param dir string 离开方向
 * @return int 返回0表示不允许正常离开
 * @details 强制玩家通过quit命令退出，确保比赛状态正确处理
 */
int valid_leave(object me, string dir)
{
	me->force_me("quit");
	return 0;
}