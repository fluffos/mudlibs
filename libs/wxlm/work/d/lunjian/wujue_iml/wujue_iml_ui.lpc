// 五绝称号列表
nosave string *wujue_name_list = ({
    "中神通",
    "东邪",
    "西毒",
    "南帝",
    "北丐", 
});

// 添加新秀组前缀定义
#define NON_ULTRA_PREFIX "新秀"

// 添加武尊组前缀定义
#define WUZUN_PREFIX "武魁"

// 门派描述映射
nosave mapping family_desc_list = ([
    "少林派": "擅使金刚不坏体神功，内外兼修，刚猛有力。一身横练功夫，能在战斗中化身金刚，无懈可击。",
    "武当派": "以太极拳法闻名，拳风绵密，如行云流水。以静制动，后发先至，达天人合一之境。",
    "峨嵋派": "擅使细剑和临济内功，身姿轻盈，剑法灵动如织。内力浑厚，以智取胜。",
    "华山派": "以华山九剑著称，剑法犀利，招招致命。讲究无招胜有招，一剑封喉。",
    "丐帮": "以打狗棒法和降龙十八掌闻名，棒法灵活多变，掌力如龙吟虎啸，令人闻风丧胆。",
    "桃花岛": "以玉箫神剑和五行八卦见长，剑影如织，剑光闪烁。五行八卦运用出神入化。",
    "星宿派": "擅使冰蚕和化功大法，行事诡谲。冰蚕毒性阴寒，化功大法能化人内力为己用。",
    "逍遥派": "以凌波微步和六阳掌著称，身法灵动，掌力刚猛。来去无踪，令人难以捉摸。",
    "古墓派": "以玄铁重剑和黯然销魂掌闻名，剑重掌轻，刚柔并济。怒海狂涛功更是威力无穷。",
    "全真教": "以道家内功和化三清剑法著称，内功深厚，剑法灵动。剑随意走，剑人合一。",
    "神龙教": "擅使化骨绵掌和神龙八式，掌法阴柔，招式诡异。如神龙般神出鬼没。",
    "雪山寺": "以龙象般若功和日月轮锤法闻名，内力深厚，力大无穷。锤影如日月交替。",
    "血刀门": "以血刀刀法著称，刀法凌厉凶狠，招招夺命。出手无情，令人闻风丧胆。",
    "灵鹫宫": "擅使九天十地唯我至尊功和六阳掌，内力生生不息，掌法刚柔并济。",
    "欧阳世家": "以蛤蟆功闻名，出招奇诡，掌力惊人。一掌拍出，震耳欲聋。",
    "关外胡家": "以胡家刀法和冷月神功著称，刀法凌厉，内功阴寒。刀光剑影中尽显北国豪情。",
    "慕容世家": "擅使斗转星移和参合指，能将敌招化为己用。指力如刀，令人防不胜防。",
    "段氏皇族": "以一阳指和六脉神剑闻名，指力凌厉，剑气纵横。六脉齐发，无人能挡。",
    "白帝城": "以琴功著称，琴音如泣如诉，既能安抚人心，又可化作杀招。曲终人散。",
    "明教": "以紫阳神功和乾坤大挪移闻名，内力深厚，举世无双。如烈日般威震四海。",
    "魔教": "擅使圆月弯刀，刀法凌厉，杀意凛然。刀光闪烁间尽显魔教威仪。",
    "日月神教": "以葵花神功闻名，身法诡异，针法精妙。快若闪电，无人能敌。",
    "四象门": "擅使四象八卦之术，招式变化多端。借天地之力，威力无穷。",
    "移花宫": "以移花接木手法闻名，轻盈飘逸似花瓣，却暗藏杀机。能夺人内力化为己用。",
]);
private string get_wuzun_special_description(string title_name);
/**
 * @brief 生成五绝动画数据（宗师组）
 * @param winners 获胜者列表
 * @return string 五绝动画JSON数据
 */
public string generate_wujue_animation_data(string *winners)
{
    mapping json_data = ([
        "code": "五绝",
        "data": ({}),
    ]);

    object player;
    string player_name, family_name, player_title, desc;
    
    for(int i = 0; i < sizeof(wujue_name_list) && i < sizeof(winners); i++)
    {
        mapping wujue_data;
        // 获取玩家信息
        if(player = UPDATE_D->global_find_player(winners[i]))
        {
            player_name = player->query("name");
            family_name = player->query("family/family_name");
            
            if (family_name) {
                player_title = FAMILY_D->query_family_player_title(player);
                desc = family_desc_list[family_name];
            } else {
                family_name = "无";
                player_title = "";
                desc = "无";
            }
        } else {
            return winners[i] + " 不存在\n";
        }
        
        wujue_data = ([
            "sex": HEAD_IMAGE_MASTER->query_head_image_gender(player),
            "msg": HIY + player_name + NOR + ZJBR + 
                  (family_name == "无" ? "门派" : family_name) + 
                  (player_title == "" ? "" : player_title) + "，位列" + 
                  wujue_name_list[i] + "，" + 
                  desc,
            "head_img_id": HEAD_IMAGE_MASTER->query_head_image_status(player),
            "title": wujue_name_list[i],
        ]);
        
        json_data["data"] += ({wujue_data});
    }

    return json_encode(json_data);
}

