/**
 * @brief 生成武尊组五绝动画数据
 * @param winners 获胜者列表
 * @return string 五绝动画JSON数据
 * @details 专门为武魁之战（武尊组）生成的五绝动画，具有更高级的视觉效果和特殊标识
 */
public string generate_wuzun_wujue_animation_data(string *winners)
{
    mapping json_data = ([
        "code": "五绝",
        "data": ({}),
    ]);
    string special_desc;
    object player;
    string player_name, family_name, player_title, desc;
    string title;

    for(int i = 0; i < sizeof(wujue_name_list) && i < sizeof(winners); i++)
    {
        mapping wujue_data;
        // 获取玩家信息
        if(player = UPDATE_D->global_find_player(winners[i]))
        {
            player_name = player->query("name");
            family_name = player->query("family/family_name");
            
            if (family_name) {
                player_title = FAMILY_D->query_family_player_title(player);
                desc = family_desc_list[family_name];
            } else {
                family_name = "无";
                player_title = "";
                desc = "无";
            }
        } else {
            return winners[i] + " 不存在\n";
        }
    
        
        title = wujue_name_list[i];
        
        // 为武尊组添加特殊的描述和效果
        special_desc = get_wuzun_special_description(wujue_name_list[i]);
        
        wujue_data = ([
            "sex": HEAD_IMAGE_MASTER->query_head_image_gender(player),
            "msg": HIR + player_name + NOR + ZJBR + 
                  (family_name == "无" ? "门派" : family_name) + 
                  (player_title == "" ? "" : player_title) + "，位列" + 
                  HIY + title + NOR + "，" + 
                  desc + ZJBR + HIB + special_desc + NOR,
            "head_img_id": HEAD_IMAGE_MASTER->query_head_image_status(player),
            "title": title,
        ]);
        
        json_data["data"] += ({wujue_data});
    }

    return json_encode(json_data);
}

/**
 * @brief 获取武尊组特殊描述
 * @param title_name string 五绝称号名称
 * @return string 特殊描述文本
 * @details 为不同的武魁五绝称号提供特殊的威严描述
 */
private string get_wuzun_special_description(string title_name)
{
    mapping special_descriptions = ([
        "中神通": "武尊的巅峰存在，武道至尊，天下无双！",
        "东邪": "邪中有正，正中有邪，武尊级别的传奇人物！",
        "西毒": "毒辣手段配合武尊境界，令人闻风丧胆的武魁！",
        "南帝": "帝王风范，武尊气质，南方武林的最强者！",
        "北丐": "侠之大者，义薄云天！",
    ]);
    
    if (special_descriptions[title_name])
        return special_descriptions[title_name];
    else
        return "散花境界的武尊强者，武魁之战的胜利者！";
}

/**
 * @brief 获取五绝称号列表
 * @return string* 五绝称号列表
 */
public string *get_wujue_titles()
{
    return wujue_name_list;
}

/**
 * @brief 获取门派描述
 * @param family_name 门派名称
 * @return string 门派描述
 */
public string get_family_description(string family_name)
{
    return family_desc_list[family_name];
}
