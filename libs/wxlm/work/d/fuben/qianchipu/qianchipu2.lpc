#include <room.h>
inherit ROOM;

void create()
{
	set("short", "逆流而上");
	set("long","你踏入溪水，只觉脚下一股暗劲袭来，原来此处水流确实是逆流而上，有违常理。\n"
               "河岸两侧奇石嶙峋，古松参天，缥缈雾气中若隐若现几处石台，每台各立一位武林高手。这些人被称为逆流者，皆是江湖上的名宿高手，他们守护着这溯源之河的秘密。\n"
               "有的持剑而立，姿态如松，剑意凌厉；有的盘膝静坐，气息绵长；还有的挥掌运气，掌风激荡水面。他们各自修炼不同武学，却都达到了炉火纯青的境界。\n"
               "传闻欲参悟武学奥妙，必须逐一挑战击败这些逆流者，才能更进一步，领悟更高深的武学境界。逆水行舟，不进则退，此言不虚。");

	set("sllv",1);
	set("objects",([
	]));
	set("exits", ([
		"south" : __DIR__"qianchipu",
	]));
	set("action_list", ([
		"结束挑战" : "slover",
	]));
	set("cost", 1);
	setup();
}

void init()
{
       add_action("slover", "slover");
       add_action("slover1", "slover1");
}

int slover()
{
	write(popup_comb("你确定要结束本次千尺瀑试炼吗？", "确定:slover1"));
	return 1;
}
	
int slover1()
{
	object slroom;
	int start_time;
	object me;
	int exp, potential;

	me = this_player();
	slroom = this_object();

	exp = query("sllv") * 150;
	potential = query("sllv") * 75;

	// 获取试炼开始时间
	start_time = me->query("fuben_qianchi/last_time");

	tell_object(me, HIY"【千尺瀑试炼】"NOR + 
        "你历经" + chinese_number(me->query("qianchi")) + "重磨砺，在与逆流者的交手中有所顿悟。\n" + 
        "本次试炼耗时" + chinese_number(time()-start_time) + "秒，获得了" + 
        HIR + chinese_number(exp) + NOR + "点实战经验和" + 
        HIG + chinese_number(potential) + NOR + "点潜能。\n");

	// 记录副本监控日志
	MONITOR_MASTER->monitor_fuben_log(me, "千尺瀑副本", start_time, time(), potential, exp);

	me->delete("qianchi");
	me->move("/d/fuben/qianchipu/qianchipu");
	me->remove_all_killer();
	destruct(slroom);
	return 1;
}

void nextlv(int delay,object me)
{
	add("sllv",1);
	call_out("nextlv2",delay,me);
}

int nextlv2(object me)
{
	object slnpc;
	string *slnpcs;

	slnpcs = ({
		__DIR__"npc/sldz",
	});
	slnpc = new(slnpcs[random(sizeof(slnpcs))]);
	slnpc->set("name",query("sllv")+"段逆流者");
	slnpc->move(this_object());
	tell_object(me, HIC"【千尺瀑试炼】"NOR"你成功击败了一名逆流者，试炼难度提升至" + 
        chinese_number(query("sllv")) + "段！前方已有更强的对手在等待着你！\n");
	AUTO_QUEST->auto_cmd(me,"kill " +  slnpc->query("id"));
	return 1;
}

int valid_leave(object me, string dir)
{
	return ::valid_leave(me, dir);
}
