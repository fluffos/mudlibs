#include <room.h>
inherit ROOM;

void create()
{
	set("short", "溯源之河");
	set("long", "这里是传说中千尺瀑的源头，位于华山深处，四周峰峦叠嶂，云雾缭绕。溪水自峰顶倾泻而下，在阳光照射下如同万千银丝悬挂天际，蔚为壮观。\n"
              "此处灵气充盈，清泉逆流，违背常理，江湖中人称之为。相传饮此水修炼武功，可事半功倍。因此常有武林高手前来挑战此地守护者，欲求一窥天地造化的奥秘。\n"
              "远处山崖上刻有古朴篆字：逆水行舟，不进则退，似是先贤留下的修行箴言。");

	set("objects",([
	]));
	set("npcs",([
	]));
	set("exits", ([
		"south" : "/d/huashan/qianchi",
		"north" : "/d/lunjian/enter",
	]));
	set("action_list", ([
		"逆流直上" : "niliu",
	]));
	set("no_fight", 1);
    setup();
}
void init()
{
	add_action("niliu", "niliu");
}

int niliu()
{
	object me,slnpc,slroom,*slrooms;
	mixed last,now;
	int lvl,i;
	string *slnpcs;
	now = localtime(time());
	me = this_player();

	if(me->query("combat_exp")<800000){
		tell_object(me, HIR"你的实战经验尚浅，难以抵御此地磅礴水势，还是修炼一段时间再来吧！"NOR"\n");
		return 1;
	}
	if(me->query_condition("killer")){
		tell_object(me, HIR"你目前正被官府通缉，此地灵气会与官府的追捕令相互感应，不宜在此修炼！"NOR"\n");
		return 1;
	}

	if(me->query("fuben_qianchi/last_time")) last = localtime(me->query("fuben_qianchi/last_time"));
	else last = localtime(0);
	if(now[7]==last[7]&&!this_player()->query("qianchi")){
		tell_object(me,ZJOBLONG"你今日已完成千尺瀑试炼，体内真气需调息一日，明日再来吧！\n");
		return 1;
	}
	slrooms = children("/d/fuben/qianchipu/qianchipu2");
	for (i = 0; i < sizeof(slrooms); i++) {
		if(slrooms[i]->query("owner")==me->query("id"))
			slroom = slrooms[i];
	}
	if(!slroom)
	{
		slroom = new("/d/fuben/qianchipu/qianchipu2");
		slroom->set("owner",me->query("id"));
		if(!me->query("qianchi")){
			lvl = me->query("level")/ 10;
			if(lvl<1) lvl = 1;
			me->set("qianchi",lvl);
			me->set("fuben_qianchi/last_time",time());
		}
		slroom->set("sllv",me->query("qianchi"));
		slnpcs = ({
			__DIR__"npc/sldz",
		});
		slnpc = new(slnpcs[random(sizeof(slnpcs))]);
		slnpc->set("name",me->query("qianchi")+"段逆流者");

		

	}
	this_player()->move(slroom);
	if(objectp(slnpc))
	{
		slnpc->move(slroom);
		AUTO_QUEST->auto_cmd(me,"kill " +  slnpc->query("id"));
	}
	return 1;
}
