inherit "/kungfu/class/generate/chinese";

void create()
{
	string *fams;

	set_name("逆流者", ({"niliu zhe", "niliu", "zhe"}));
	set("gender", "男性");
	set("age", 25 + random(30));
	set("long", "这是一位在千尺瀑修炼多年的武林高手，被称为逆流者。\n"
              "他的眼神如电，气息内敛，浑身透着一股玄妙的气质，是江湖上赫赫有名的人物。\n"
              "据传每一位逆流者都参透了武学的某种奥义，是守护千尺瀑奥秘的重要力量。");
	set("attitude", "aggressive");

	setup();
	fams = keys(init_family);
	setup_family(fams[random(sizeof(fams))]);
}

int accept_fight(object me)
{
	tell_object(me, HIW"【逆流者】朗声道：逆水行舟，不进则退。在千尺瀑中岂容你畏首畏尾？拿出真本事来！"NOR"\n");
	return 0;
}

void init()
{
	object me = this_object();
	mapping smap = me->query_skills();
	int i;
	string *skills;
	int lvl = environment()->query("sllv")*10;

	skills = keys(smap);
	for(i=0;i<sizeof(skills);i++)
	{
		me->set_skill(skills[i],lvl);
	}

	me->set("combat_exp",lvl*lvl/10*lvl+10000);
	me->set_temp("apply/damage",100+lvl/2);
	me->set_temp("apply/unarmed_damage",100+lvl/2);
	me->set("jiali",lvl);
	me->set("qi",lvl*30);
	me->set("eff_qi",lvl*30);
	me->set("max_qi",lvl*30);
	me->set("jing",lvl*30);
	me->set("eff_jing",lvl*30);
	me->set("max_jing",lvl*30);
	me->set("neili",lvl*30);
	me->set("max_neili",lvl*30);
}

varargs void die(object kill_obj)
{
	int sllv,i,exp,lvl;
	object me = this_object();
	object *inv,ob,obj;
	string *items;
	mapping give;

	sllv = environment()->query("sllv");

	give =  ([
		"/clone/vip/book_tianfu" : 30,
		"/clone/vip/dan_chongmai1" : 25,
		"/clone/vip/dan_chongmai2" : 20,
		"/clone/vip/dan_chongmai3" : 15,
		"/clone/vip/dan_chongmai4" : 10,
	]);

	if ((objectp(ob = kill_obj) || objectp(ob = query_last_damage_from())) && environment(me)==environment(ob))
	{
		items = keys(give);
		for(i=0;i<sizeof(items);i++)
		{
			if(random(100)<give[items[i]] + sllv / 10)
			{
				obj = new_bind(items[i]);
				if (objectp(ob))
				{
					obj->move(ob);
					tell_object(ob, HIY"你从逆流者身上获得了一" + obj->query("unit") + obj->query("name") + "。"NOR"\n");
				}
				else
				obj->move(environment(this_object()));
			}
		}

		exp = ob->improve_experience(random(50) + sllv*5);

		if (ob->query("niliu_qi")<2000)
		{
			ob->add("niliu_qi",1);
			CHAR_D->setup_char(ob);
			tell_object(ob, HIW"【千尺瀑试炼】"NOR"你与逆流者激战一场，体会颇深。经过溯源之水的洗礼，你的气血永久增加了5点。\n");
		}

		tell_object(ob, sprintf(HIG "【千尺瀑试炼】你击败了%s段逆流者，获得了%s点实战体会，你的武学修为更进一步。"NOR"\n", query("name"), chinese_number(exp)));

		ob->add("qianchi", 1);
		if(!ob->query("qianchilv")||ob->query("qianchilv")<ob->query("qianchi"))
			ob->set("qianchilv",ob->query("qianchi"));

		lvl = ob->query("level") / 10;
		if((ob->query("qianchi")-lvl)>50)
		{
			tell_object(ob, HIR"你已达到当前修为所能承受的极限，继续试炼恐有危险，建议先行退出修炼。"NOR"\n");
			ob->force_me("slover1");
		}
		else
			environment()->nextlv(3,ob);
		// destruct(me);
		if (objectp(this_object()))
		{
			::die(ob);
		}
	}
	else
	{
		inv = all_inventory(environment());
		for(i=0;i<sizeof(inv);i++)
		{
			if(playerp(inv[i]))
				inv[i]->move("/d/fuben/qianchipu/qianchipu");
		}
		destruct(environment());
	}
}
