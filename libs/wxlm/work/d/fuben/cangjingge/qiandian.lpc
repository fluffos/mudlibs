// Room: qiandian.c

inherit ROOM;

void create()
{
    set("short", "藏经阁前殿");
    set("long", @LONG
这里是少林寺藏经阁的前殿，古朴的殿堂上方悬挂着一块金漆匾额，上书"法宝
藏海"四个苍劲大字。殿内香烟缭绕，墙壁上挂满了历代高僧的画像，他们目光
炯炯，仿佛在注视着每一位来访者。前方通往内殿的门扉紧闭，两侧站立着守卫
僧人，他们神情肃穆，警惕地监视着每一个进出的人。
LONG
    );
    set("exits", ([
        "south" : __DIR__"enter",
        "north" : __DIR__"neidian",
    ]));
    set("objects", ([
        __DIR__"npc/shouwei_sengren": 2,
    ]));
    setup();
}

int auto_start(object me)
{
    mixed other_ob;
    if (other_ob = AUTO_QUEST->is_not_player(me))
    {
        AUTO_QUEST->auto_cmd(me,"kill " +other_ob->query("id"));
    }
}

int valid_leave(object me, string dir)
{
    object *inv;
    int i;

    if (dir == "north")
    {
        inv = all_inventory(environment(me));
        for (i = 0; i < sizeof(inv); i++)
        {
            if (inv[i]->query("id") == "shouwei sengren")
            {
                return notify_fail("守卫僧人双手合十，挡在你面前道：施主请留步，未经允许不得入内参观珍藏。\n");
            }
        }
        call_out("auto_start", 1, me);
    }
    return ::valid_leave(me, dir);
}

