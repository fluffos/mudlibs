// Room: enter.c

inherit ROOM;

void create()
{
    set("short", "藏经阁入口");
    set("long", @LONG
这里是少林寺藏经阁的入口，一条青石铺就的小径通向前方高耸的建筑。藏经阁
建在一座小山丘上，四周古松环绕，清风徐来，松涛阵阵。阁楼飞檐翘角，雕梁
画栋，显示出非凡的气势。入口处有两名身着袈裟的少林僧人持禅杖守卫，面容
严肃，目光如炬，似乎能看透来访者的内心。据说藏经阁内收藏了无数武林秘籍
和佛门珍宝，是武林中人梦寐以求的宝地。
LONG
    );
    set("exits", ([
        "north" : __DIR__"qiandian",
    ]));
    set("objects", ([
        __DIR__"npc/shouwei_sengren": 2,
    ]));
    setup();
}

int auto_start(object me)
{
    mixed other_ob;
    if (other_ob = AUTO_QUEST->is_not_player(me))
    {
        AUTO_QUEST->auto_cmd(me,"kill " +other_ob->query("id"));
    }
}

int valid_leave(object me, string dir)
{
    object *inv;
    int i;

    if (dir == "north")
    {
        inv = all_inventory(environment(me));
        for (i = 0; i < sizeof(inv); i++)
        {
            if (inv[i]->query("id") == "shouwei sengren")
            {
                return notify_fail("守卫僧人厉声喝道：施主请止步！藏经阁乃本寺重地，闲人免进！\n");
            }
        }

        call_out("auto_start", 1, me);
    }
    return ::valid_leave(me, dir);
}