
inherit ROOM;
int heap_count;
#include "/d/fuben/dig.h"
void create()
{
    set("short", HIW"宝石矿洞四层"NOR);
    set("long", "这是宝石矿洞的第四层,四周的岩壁上闪烁着各色宝石的光芒。\n"
                "空气中弥漫着淡淡的矿物质气息。你可以在这里尝试挖掘宝石。\n");
    set("exits", ([
        "south" : __DIR__"room3",
        "north" : __DIR__"room5",
    ]));
    
    
    // 生成1-2个普通矿堆
    heap_count = 1 + random(2);
    for (int i = 0; i < heap_count; i++) {
        object heap = new(__DIR__"obj/mine_heap");
        heap->set_heap_type(1);
        heap->move(this_object());
    }
    
    setup();
}

void init()
{
    add_action("do_dig", "dig");
}

