
inherit ROOM;
#include "/d/fuben/dig.h"

object normal_heap;

void create()
{
    set("short", HIW"宝石矿洞十层"NOR);
    set("long", "这是宝石矿洞的第十层,也是最深处。这里的宝石光芒最为耀眼。\n"
                "空气中弥漫着浓郁的矿物质气息。你可以在这里尝试挖掘宝石。\n");
    set("exits", ([
        "south" : __DIR__"room9",
    ]));
    
    // 生成1个普通矿堆
    normal_heap = new(__DIR__"obj/mine_heap");
    normal_heap->set_heap_type(1);
    normal_heap->move(this_object());
    
    // 20%概率生成1个华丽矿堆
    if (random(5) == 0) {
        object gorgeous_heap = new(__DIR__"obj/mine_heap");
        gorgeous_heap->set_heap_type(3);
        gorgeous_heap->move(this_object());
    }
    
    setup();
}

void init()
{
    add_action("do_dig", "dig");
}