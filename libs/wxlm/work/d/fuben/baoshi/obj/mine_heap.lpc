

inherit ITEM;

int heap_type; // 1: 普通, 2: 稀有, 3: 华丽

void create()
{
    set_name("矿堆", ({ "mine heap", "heap" }));
    set("long", "这是一堆闪烁着光芒的矿石,看起来可以。\n");
    set("unit", "堆");
    set("value", 0);
    set("no_get", 1);
    set("acts_list", ([
        "挖掘" : "dig "+ file_name(this_object()),
    ]));
    
}

void set_heap_type(int type)
{
    heap_type = type;
    switch(type) {
        case 1:
            set_name("普通矿堆", ({ "normal heap", "heap" }));
            break;
        case 2:
            set_name("稀有矿堆", ({ "rare heap", "heap" }));
            break;
        case 3:
            set_name("华丽矿堆", ({ "gorgeous heap", "heap" }));
            break;
    }
}

int is_mine_heap()
{
    return 1;
}

string get_drop()
{
    int r = random(100);
    switch(heap_type) {
        case 1: // 普通矿堆
            // 掉落概率: 白色宝石75%, 绿色宝石雕琢符10%, 绿色宝石10%, 蓝色雕琢符5%
            if (r < 75) return "/clone/baoshi/white_baoshi";
            else if (r < 85) return "/clone/baoshi/green_diaozhuofu";
            else if (r < 95) return "/clone/baoshi/green_baoshi";
            else return "/clone/baoshi/blue_diaozhuofu";
        case 2: // 稀有矿堆
            // 掉落概率: 白色宝石45%, 绿色宝石雕琢符30%, 绿色宝石15%, 宝石转换符5%, 蓝色雕琢符5%
            if (r < 45) return "/clone/baoshi/white_baoshi";
            else if (r < 75) return "/clone/baoshi/green_diaozhuofu";
            else if (r < 90) return "/clone/baoshi/green_baoshi";
            else if (r < 95) return "/clone/baoshi/zhuanhuan_baoshi";
            else return "/clone/baoshi/blue_diaozhuofu";
        case 3: // 华丽矿堆
            // 掉落概率: 白色宝石35%, 绿色宝石雕琢符30%, 绿色宝石15%, 宝石转换符9%, 开孔符4%, 蓝色雕琢符5%, 宝石转换符2%
            if (r < 35) return "/clone/baoshi/white_baoshi";
            else if (r < 65) return "/clone/baoshi/green_diaozhuofu";
            else if (r < 80) return "/clone/baoshi/green_baoshi";
            else if (r < 89) return "/clone/baoshi/zhuanhuan_baoshi";
            else if (r < 93) return "/d/item/baoshi/kaikong";
            else if (r < 98) return "/clone/baoshi/blue_diaozhuofu";
            else return "/clone/baoshi/zhuanhuan_baoshi";
    }
}


