
inherit ROOM;
#include "/d/fuben/dig.h"
object normal_heap;
void create()
{
    set("short", HIW"宝石矿洞七层"NOR);
    set("long", "这是宝石矿洞的第七层,四周的岩壁上闪烁着各色宝石的光芒。\n"
                "空气中弥漫着淡淡的矿物质气息。你可以在这里尝试挖掘宝石。\n");
    set("exits", ([
        "south" : __DIR__"room6",
        "north" : __DIR__"room8",
    ]));
   
    
    // 生成1个普通矿堆
     normal_heap = new(__DIR__"obj/mine_heap");
    normal_heap->set_heap_type(1);
    normal_heap->move(this_object());
    
    // 50%概率生成1个稀有矿堆
    if (random(2) == 0) {
        object rare_heap = new(__DIR__"obj/mine_heap");
        rare_heap->set_heap_type(2);
        rare_heap->move(this_object());
    }
    
    setup();
}

void init()
{
    add_action("do_dig", "dig");
}

