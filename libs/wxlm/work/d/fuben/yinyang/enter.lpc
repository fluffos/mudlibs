#include <room.h>


inherit ROOM;

void create()
{
    set("short", HIW "阴阳逆转之地" NOR);
    set("long", @LONG
这里是传说中的阴阳逆转之地，一处奇异的空间。入口处呈现出明显的
分界，左方是一片充满阳刚之气的光明区域，右方则是弥漫着阴柔之气
的幽暗区域。两种截然不同的气息在此处泾渭分明，却又相互交融。

传说此地蕴含着至阴至阳之气的精华，能够领悟其中奥秘者，将获得惊
人的武学造诣。但想要获得这份机缘，必须击败守护在两处区域的阴无
极或阳无极，他们都是不世出的绝顶高手。

LONG );

    set("exits", ([
        "out"   : "/d/city/guangchang",
        "west"  : __DIR__"yang_room",
        "east" : __DIR__"yin_room",
    ]));

    set("no_fight", 1);
    set("no_magic", 1);
    set("is_fuben_room", 1);

    setup();
}

void init()
{
    // 玩家进入房间时的初始化
    add_action("do_start_fuben", "start_fuben");
}

int do_start_fuben(string arg)
{
    object me = this_player();
    
    if (arg != "yinyang")
        return 0;
    
    return "/cmds/usr/start_fuben"->main(me, arg);
}

int valid_leave(object me, string dir)
{
    object *team;
    int i;
    
    if (dir == "west" || dir == "east")
    {
        // 检查是否已选择了路径
        if (query("path_chosen") && query("path_chosen") != dir)
        {
            return notify_fail("阴阳逆转之地已经选择了" + 
                (query("path_chosen") == "west" ? "阳" : "阴") + 
                "之路，另一条路已经关闭！\n");
        }
        
        // 如果是第一次选择路径，记录并关闭另一条路
        if (!query("path_chosen"))
        {
            set("path_chosen", dir);
            if (dir == "west")
            {
                message("vision", HIY"随着你们向阳之地迈进，阴之地的入口被一道无形屏障封闭了！\n"NOR, this_object());
            }
            else
            {
                message("vision", HIC"随着你们向阴之地迈进，阳之地的入口被一道无形屏障封闭了！\n"NOR, this_object());
            }
            
            // 获取所有队伍成员
            team = me->query_team();
            if (!team) team = ({ me });
            
            // 给予队伍成员临时标记
            for (i = 0; i < sizeof(team); i++)
            {
                if (present(team[i], this_object()))
                {
                    team[i]->set_temp("yinyang_path", dir);
                }
            }
        }
    }
    
    return ::valid_leave(me, dir);
} 