
inherit NPC;

void create();
int do_reward(object me);
void destroy_fuben();
void die();

void create()
{
    ::create();
    set_name("阳无极", ({ "yang wuji", "yang", "wuji" }));
    set("long", @LONG
阳无极是至阳之地的守护者，浑身笼罩着一层金色的光晕，看起来如
同神祇降世。他容貌刚毅，眉宇间散发着无穷的阳刚之气。据说他是
明教传人，掌握了九阳神功的精髓，在武学上已臻化境。
LONG );
    set("title", HIY "阳刚至尊" NOR);
    set("gender", "男性");
    set("age", 45);
    set("no_get", 1);
    set("shen_type", 1);
    set("attitude", "aggressive");
    set("class", "fighter");

    set("str", 40);
    set("int", 40);
    set("con", 40);
    set("dex", 40);

    set("qi", 3000000);
    set("max_qi", 3000000);
    set("jing", 1500000);
    set("max_jing", 1500000);
    set("neili", 200000);
    set("max_neili", 200000);
    set("jiali", 500);

    set("combat_exp", 50000000);
    
    // 复制张无极的技能，并提升到600级
    set_skill("force", 600);
    set_skill("unarmed", 600);
    set_skill("dodge", 600);
    set_skill("parry", 600);
    set_skill("cuff", 600);
    set_skill("sword", 600);
    set_skill("blade", 600);
    set_skill("strike", 600);
    set_skill("claw", 600);
    set_skill("throwing", 600);
    set_skill("jiuyang-shengong", 600);
    set_skill("shenghuo-xinfa", 600);
    set_skill("shenghuo-shengong", 600);
    set_skill("lingxu-bu", 600);
    set_skill("shenghuo-bu", 600);
    set_skill("qingfu-shenfa", 600);
    set_skill("qiankun-danuoyi", 600);
    set_skill("qishang-quan", 600);
    set_skill("taiji-quan", 600);
    set_skill("taiji-jian", 600);
    set_skill("taiji-dao", 600);
    set_skill("lieyan-dao", 600);
    set_skill("liehuo-jian", 600);
    set_skill("guangming-zhang", 600);
    set_skill("medical", 300);
    set_skill("literate", 300);
    set_skill("martial-cognize", 600);
    set_skill("guangming-jing", 600);

    map_skill("force", "jiuyang-shengong");
    map_skill("dodge", "qingfu-shenfa");
    map_skill("unarmed", "jiuyang-shengong");
    map_skill("strike", "guangming-zhang");
    map_skill("cuff", "qishang-quan");
    map_skill("sword", "liehuo-jian");
    map_skill("parry", "qiankun-danuoyi");
    map_skill("blade", "taiji-dao");

    prepare_skill("cuff", "qishang-quan");
    
    set_temp("apply/attack", 300);
    set_temp("apply/damage", 300);
    set_temp("apply/unarmed_damage", 300);
    set_temp("apply/armor", 300);
    
    set("chat_chance_combat", 120);
    set("chat_msg_combat", ({
        (: command("perform sword.hua") :),
        (: command("perform sword.xi") :),
        (: command("perform sword.lian") :),
        (: command("perform sword.can") :),
        (: command("perform cuff.shang") :),
        (: command("perform cuff.fei") :),
        (: command("yun shield") :),
        (: command("yun powerup") :),
        (: command("yun recover") :),
    }));
    
    setup();
    carry_object("/clone/weapon/changjian")->wield();
    carry_object("/clone/cloth/cloth")->wear();
}

void init()
{
    object me = this_player();
    
    ::init();
    if (interactive(me))
    {
        kill_ob(me);
    }
}

void die()
{
    object *players;
    object me = this_object();
    int i;
    int exp = 100000;        // 基础经验
    int potential = 50000;   // 基础潜能
    int start_time;
    
    message_vision(HIR "\n$N" HIR "发出一声不甘的怒吼，金色的光芒渐渐消散，化作一缕阳气飘向天际。\n" NOR, me);
    message_vision(HIC "\n随着阳无极的死亡，至阳之地开始崩塌，你们必须立即离开！\n" NOR, me);
    
    players = filter_array(all_inventory(environment(me)), (: userp($1) :));
    
    for (i = 0; i < sizeof(players); i++)
    {
        if (players[i]->query_temp("yinyang_path") == "west")
        {
            // 获取开始时间
            start_time = players[i]->query("fuben_yinyang/last_time");
            
            tell_object(players[i], HIG "\n恭喜你击败了阳无极，获得了丰厚的奖励！\n" NOR);
            tell_object(players[i], HIY "你获得了：\n" NOR);
            tell_object(players[i], HIY "  " + exp + " 点经验\n" NOR);
            tell_object(players[i], HIY "  " + potential + " 点潜能\n" NOR);
            
            // 添加经验和潜能
            FUBEN_D->add_exp(players[i], exp);
            players[i]->add("potential", potential);
            
            // 标记已获得奖励
            players[i]->set("new_fuben_api/yinyang_yang_reward", 1);

            {
                object ob;
                
                if (random(2))
                {
                    ob = new_bind("/clone/vip/dan_wuyu");
                    tell_object(players[i], HIY "  一杯" + ob->name() + NOR HIY "！\n" NOR);
                }
                else
                {
                    ob = new_bind("clone/vip/dan_guiyuan.lpc");
                    tell_object(players[i], HIY "  一颗" + ob->name() + NOR HIY "！\n" NOR);
                }
                ob->move(players[i]);
            }
            
            // 记录副本监控日志
            MONITOR_MASTER->monitor_fuben_log(players[i], "阳无极副本", start_time, time(), potential, exp);
            
            // 掉落阳无极宝藏
            {
                object box;
                box = new_bind("/clone/baoxiang/yangwuji-baozang");
                if (box)
                {
                    box->move(players[i]);
                    tell_object(players[i], HIY "  一个" + box->name() + NOR HIY "！\n" NOR);
                }
            }
        }
        
        // 清除临时标记
        players[i]->delete_temp("yinyang_path");
    }
    
    call_out("destroy_fuben", 30);  // 30秒后销毁副本
    
    ::die();
}

void destroy_fuben()
{
    object *players;
    int i;
    
    players = filter_array(all_inventory(environment(this_object())), (: userp($1) :));
    
    for (i = 0; i < sizeof(players); i++)
    {
        tell_object(players[i], HIR "\n至阳之地崩塌，你被传送出副本！\n" NOR);
        players[i]->move("/d/city/guangchang");
        tell_object(players[i], "你眼前一花，发现自己已经回到了扬州广场。\n");
    }
}