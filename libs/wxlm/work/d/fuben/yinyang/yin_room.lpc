#include <room.h>


inherit ROOM;

void create()
{
    set("short", HIC "至阴之地" NOR);
    set("long", @LONG
这里是阴阳逆转之地的至阴之境，四周幽光流转，寒气逼人。空气中弥
漫着浓郁的阴柔之气，令人心境平和，精神不由自主地进入空明状态。
地面铺着青色的玉石，散发出丝丝凉意，使人如置身月下清泉之畔。

中央一座白玉台上，端坐着一位气质超然的老者，他就是守护至阴之地
的阴无极。相传他精通九阴真经，武功深不可测。想要领悟至阴生元之
道，必须战胜这位大宗师。

LONG );

    set("exits", ([
        "west" : __DIR__"enter",
    ]));
    
    set("objects", ([
        __DIR__"npc/yin_wuji" : 1,
    ]));
    
    set("no_clean_up", 1);
    set("is_fuben_room", 1);
    
    setup();
} 