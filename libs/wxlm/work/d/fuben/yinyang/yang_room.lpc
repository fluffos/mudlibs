#include <room.h>


inherit ROOM;

void create()
{
    set("short", HIY "至阳之地" NOR);
    set("long", @LONG
这里是阴阳逆转之地的至阳之境，四周金光闪烁，氤氲蒸腾。空气中充
满了浓郁的阳刚之气，令人心神振奋，体内真气不由自主地加速运转。
地面铺着金色的石板，散发出阵阵热力，使人如置身烈日之下。

中央高台上盘坐着一位气势恢宏的男子，他便是守护至阳之地的阳无极。
传闻他掌握了明教绝学，威震江湖。想要领悟至阳生息之道，必须击败
这位高手。

LONG );

    set("exits", ([
        "east" : __DIR__"enter",
    ]));
    
    set("objects", ([
        __DIR__"npc/yang_wuji" : 1,
    ]));
    
    set("no_clean_up", 1);
    set("is_fuben_room", 1);
    
    setup();
} 