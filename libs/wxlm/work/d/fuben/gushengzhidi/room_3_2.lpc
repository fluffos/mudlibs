/**
 * @file room_3_2.c
 * @brief 古圣之地遗迹 - 西中部
 * @author Assistant
 * @date 2024-12-19
 */



inherit ROOM;

int is_init = 0;

void create()
{
    set("short", HIW "古圣遗迹·西中部" NOR);
    set("long", "这里是古圣之地的西中部，通往中心圣殿的重要通道之一。\n"
               "墙壁上的壁画描绘着古代武圣们切磋武艺的场景，栩栩如生。\n");

    set("exits", ([
        "north" : __DIR__"room_2_2",
        "south" : __DIR__"room_4_2",
        "east"  : __DIR__"room_3_3",
        "west"  : __DIR__"room_3_1",
        "northeast" : __DIR__"room_2_3",
        "northwest" : __DIR__"room_2_1",
        "southeast" : __DIR__"room_4_3",
        "southwest" : __DIR__"room_4_1",
    ]));

    
    set("is_fuben_room", 1);
    set("room_coordinate", "3,2");

    setup();
}

void init()
{
    object wusheng;
    int power;
    
    if (!is_init)
    {
        is_init = 1;
        power = 1000 + random(9001);
        wusheng = NPC_COMBAT_TPS->create_family_npc(0, power, __DIR__"npc/wusheng_canhun");
        
        if (wusheng)
        {
            wusheng->move(this_object());
            wusheng->set("generate_combat_power", power);
            tell_room(this_object(), sprintf(HIR "一道强大的残魂出现了！已存：%d年。\n" NOR, power));
        }
    }
    
    
} 