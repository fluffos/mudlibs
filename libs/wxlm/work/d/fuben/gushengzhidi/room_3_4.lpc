/**
 * @file room_3_4.c
 * @brief 古圣之地遗迹 - 东中部
 * @author Assistant
 * @date 2024-12-19
 */



inherit ROOM;

int is_init = 0;

void create()
{
    set("short", HIW "古圣遗迹·东中部" NOR);
    set("long", "这里是古圣之地的东中部，另一条通往中心圣殿的重要通道。\n"
               "地面上留有深深的武器痕迹，可见当年武圣们在此激烈交手的情景。\n");

    set("exits", ([
        "north" : __DIR__"room_2_4",
        "south" : __DIR__"room_4_4",
        "east"  : __DIR__"room_3_5",
        "west"  : __DIR__"room_3_3",
        "northeast" : __DIR__"room_2_5",
        "northwest" : __DIR__"room_2_3",
        "southeast" : __DIR__"room_4_5",
        "southwest" : __DIR__"room_4_3",
    ]));

    
    set("is_fuben_room", 1);
    set("room_coordinate", "3,4");

    setup();
}

void init()
{
    object wusheng;
    int power;
    
    if (!is_init)
    {
        is_init = 1;
        power = 1000 + random(9001);
        wusheng = NPC_COMBAT_TPS->create_family_npc(0, power, __DIR__"npc/wusheng_canhun");
        
        if (wusheng)
        {
            wusheng->move(this_object());
            wusheng->set("generate_combat_power", power);
            tell_room(this_object(), sprintf(HIR "一道强大的残魂出现了！已存：%d年。\n" NOR, power));
        }
    }
    
    
} 