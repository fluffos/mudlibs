/**
 * @file room_1_2.c
 * @brief 古圣之地遗迹 - 北侧
 * @author Assistant
 * @date 2024-12-19
 */



inherit ROOM;

int is_init = 0;

/**
 * @brief 创建房间
 * @details 设置古圣之地北侧的房间，包含出入口和房间描述
 */
void create()
{
    set("short", HIW "古圣遗迹·北侧" NOR);
    set("long", @LONG
这里是古圣之地的北侧区域，高大的石柱支撑着古老的拱顶。
墙壁上雕刻着各种武学招式的图案，虽然经过岁月的侵蚀，
但仍能看出其中蕴含的深奥武理。地面铺着古老的青石板，
上面留有深深的脚印和兵器划痕，见证着无数武者的修行历程。

你可以向东、西、南方向继续探索。
LONG);

    set("exits", ([
        "west"  : __DIR__"room_1_1",
        "east"  : __DIR__"room_1_3",
        "south" : __DIR__"room_2_2",
        "southwest" : __DIR__"room_2_1",
        "southeast" : __DIR__"room_2_3",
    ]));

    
    set("is_fuben_room", 1);
    set("room_coordinate", "1,2");

    setup();
}

/**
 * @brief 房间初始化
 * @details 在房间初始化时生成一个武圣残魂
 */
void init()
{
    object wusheng;
    int power;
    
    if (!is_init)
    {
        is_init = 1;
        
        power = 1000 + random(9001);
        wusheng = NPC_COMBAT_TPS->create_family_npc(0, power, __DIR__"npc/wusheng_canhun");
        
        if (wusheng)
        {
            wusheng->move(this_object());
            wusheng->set("generate_combat_power", power);
            tell_room(this_object(), sprintf(HIR "一道强大的残魂出现了！已存：%d年。\n" NOR, power));
            tell_room(this_object(), sprintf(HIR "一道强大的残魂出现了！已存：%d年。\n" NOR, power));
        }
    }
    
    
} 