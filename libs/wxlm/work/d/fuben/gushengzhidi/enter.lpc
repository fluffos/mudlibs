/**
 * @file enter.c
 * @brief 古圣之地副本入口
 * @author Assistant
 * @date 2024-12-19
 */



inherit ROOM;

/**
 * @brief 创建房间
 * @details 设置古圣之地副本的入口房间，引导玩家进入5x5的古圣遗迹
 */
void create()
{
    set("short", HIW "古圣之地入口" NOR);
    set("long", @LONG
这里是传说中的古圣之地入口，四周弥漫着古老而神秘的气息。
远古时期，无数武学宗师在此留下了他们的残魂和传承。地面上
刻画着复杂的阵法纹路，散发出淡淡的灵光。据说深入古圣之地，
可以遇到那些武圣的残魂，从他们身上获得珍贵的武学传承。

你可以看到北方有一条石阶小径，通往古圣遗迹的核心区域。
LONG);

    set("exits", ([
        "north" : __DIR__"room_1_1",
    ]));

     // 副本房间不清理
    set("no_fight", 1);    // 入口不允许战斗
    set("is_fuben_room", 1); // 副本房间标记

    setup();
}

/**
 * @brief 初始化房间
 * @details 给玩家一些提示信息
 */
void init()
{
    if (playerp(this_player()))
    {
        tell_object(this_player(), HIY "你感受到了古老武圣们留下的强大气息，小心前进吧！\n" NOR);
    }
}
