/**
 * @file room_5_5.c
 * @brief 古圣之地遗迹 - 东南角
 * @author Assistant
 * @date 2024-12-19
 */



inherit ROOM;

int is_init = 0;

void create()
{
    set("short", HIR "古圣遗迹·东南角" NOR);
    set("long", @LONG
这里是古圣之地的东南角，也是整个遗迹的另一处重要区域。
墙壁上刻着"武道永存，精神不灭"的古老铭文，散发着神圣的
光芒。地面上铺着精美的石砖，每一块都雕刻着不同的武学图案。

从这里可以感受到整个古圣之地的武道精髓汇聚，是离开遗迹
的另一个重要出口。
LONG);

    set("exits", ([
        "north" : __DIR__"room_4_5",
        "west"  : __DIR__"room_5_4", 
        "northwest" : __DIR__"room_4_4",
        "out"   : __DIR__"enter", // 提供另一个出口
    ]));

    
    set("is_fuben_room", 1);
    set("room_coordinate", "5,5");
    set("is_exit_room", 1); // 标记为出口房间

    setup();
}

void init()
{
    object wusheng;
    int power;
    mapping dynamic_adjustment;
    
    if (!is_init)
    {
        is_init = 1;
        
        // 东南角的武圣残魂也比较强大（3000-8000战斗力）
        power = 3000 + random(5001);
        
        // 出口守护者有一定加成
        dynamic_adjustment = ([
            "qi_times" : 1.2,
            "neili_times" : 1.2,
            "npc_set" : "出口守护者",
        ]);
        
        wusheng = NPC_COMBAT_TPS->create_family_npc(0, power, __DIR__"npc/wusheng_canhun", dynamic_adjustment);
        
        if (wusheng)
        {
            wusheng->move(this_object());
            wusheng->set("generate_combat_power", power);
            tell_room(this_object(), sprintf(HIR "一道强大的残魂出现了！已存：%d年。\n" NOR, power));
            wusheng->set("title", "古圣遗迹守护者");
            wusheng->set("long", wusheng->query("long") + 
                        "\n这位武圣残魂是古圣遗迹的守护者，实力不容小觑。\n");
            
            tell_room(this_object(), sprintf(HIR "古圣遗迹的守护者出现了！战斗力：%d\n" NOR, power));
        }
    }
    
    
}

void init_player(object who)
{
    if (!who || !playerp(who)) return;
    
    tell_object(who, HIY "你来到了古圣遗迹的东南角，这里有通往外界的出口。\n" NOR);
    tell_object(who, HIG "击败这里的守护者后，你就可以选择离开古圣之地了。\n" NOR);
} 