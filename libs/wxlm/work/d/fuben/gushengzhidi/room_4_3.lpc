/**
 * @file room_4_3.c
 * @brief 古圣之地遗迹 - 南中部
 * @author Assistant
 * @date 2024-12-19
 */

inherit ROOM;

int is_init = 0;

void create()
{
    set("short", HIW "古圣遗迹·南中部" NOR);
    set("long", "这里是古圣之地的南中部，是离开中心圣殿后的重要通道。空气中依然弥漫着浓厚的武道气息。\n");
    
    set("exits", ([
        "north" : __DIR__"room_3_3", 
        "east" : __DIR__"room_4_4", 
        "south" : __DIR__"room_5_3", 
        "west" : __DIR__"room_4_2",
        "northeast" : __DIR__"room_3_4", 
        "northwest" : __DIR__"room_3_2", 
        "southeast" : __DIR__"room_5_4", 
        "southwest" : __DIR__"room_5_2",
    ]));
    
     
    set("is_fuben_room", 1); 
    set("room_coordinate", "4,3");
    
    setup();
}

void init()
{
    object wusheng;
    int power;
    
    if (!is_init) 
    {
        is_init = 1;
        power = 1000 + random(9001);
        wusheng = NPC_COMBAT_TPS->create_family_npc(0, power, __DIR__"npc/wusheng_canhun");
        
        if (wusheng) 
        { 
            wusheng->move(this_object());
            wusheng->set("generate_combat_power", power);
            tell_room(this_object(), sprintf(HIR "一道强大的残魂出现了！已存：%d年。\n" NOR, power));
        }
    }
    
    
} 