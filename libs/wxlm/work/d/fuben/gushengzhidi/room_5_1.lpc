/**
 * @file room_5_1.c
 * @brief 古圣之地遗迹 - 西南角
 * @author Assistant
 * @date 2024-12-19
 */

inherit ROOM;

int is_init = 0;

void create()
{
    set("short", HIW "古圣遗迹·西南角" NOR);
    set("long", "这里是古圣之地的西南角，遗迹的边界地带。角落里有一口古井，井水清澈见底，散发着淡淡的灵气。\n");
    
    set("exits", ([
        "north" : __DIR__"room_4_1", 
        "east" : __DIR__"room_5_2",
        "northeast" : __DIR__"room_4_2",
    ]));
    
     
    set("is_fuben_room", 1); 
    set("room_coordinate", "5,1");
    
    setup();
}

void init()
{
    object wusheng;
    int power;
    
    if (!is_init) 
    {
        is_init = 1;
        power = 1000 + random(9001);
        wusheng = NPC_COMBAT_TPS->create_family_npc(0, power, __DIR__"npc/wusheng_canhun");
        
        if (wusheng) 
        { 
            wusheng->move(this_object());
            wusheng->set("generate_combat_power", power);
            tell_room(this_object(), sprintf(HIR "一道强大的残魂出现了！已存：%d年。\n" NOR, power));
        }
    }
    
    
} 