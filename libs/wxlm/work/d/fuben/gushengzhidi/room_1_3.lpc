/**
 * @file room_1_3.c
 * @brief 古圣之地遗迹 - 北侧中部
 * @author Assistant
 * @date 2024-12-19
 */



inherit ROOM;

int is_init = 0;

void create()
{
    set("short", HIW "古圣遗迹·北侧中部" NOR);
    set("long", "这是古圣之地北侧的中部区域，古老的石雕和残破的武器散落四处。\n"
               "空气中弥漫着浓厚的武道气息，显示这里曾是武圣们修炼的重要场所。\n");

    set("exits", ([
        "west"  : __DIR__"room_1_2",
        "east"  : __DIR__"room_1_4", 
        "south" : __DIR__"room_2_3",
        "southwest" : __DIR__"room_2_2",
        "southeast" : __DIR__"room_2_4",
    ]));

    
    set("is_fuben_room", 1);
    set("room_coordinate", "1,3");

    setup();
}

void init()
{
    object wusheng;
    int power;
    
    if (!is_init)
    {
        is_init = 1;
        power = 1000 + random(9001);
        wusheng = NPC_COMBAT_TPS->create_family_npc(0, power, __DIR__"npc/wusheng_canhun");
        
        if (wusheng)
        {
            wusheng->move(this_object());
            wusheng->set("generate_combat_power", power);
            tell_room(this_object(), sprintf(HIR "一道强大的残魂出现了！已存：%d年。\n" NOR, power));
        }
    }
    
    
} 