/**
 * @file room_2_3.c
 * @brief 古圣之地遗迹 - 北中部
 * @author Assistant
 * @date 2024-12-19
 */



inherit ROOM;

int is_init = 0;

void create()
{
    set("short", HIW "古圣遗迹·北中部" NOR);
    set("long", "这里是古圣之地的北中部区域，是通往中心圣殿的重要通道。\n"
               "四周的石壁上刻满了各种武学心得，记录着前人的修炼感悟。\n");

    set("exits", ([
        "north" : __DIR__"room_1_3",
        "south" : __DIR__"room_3_3",
        "east"  : __DIR__"room_2_4",
        "west"  : __DIR__"room_2_2",
        "northeast" : __DIR__"room_1_4",
        "northwest" : __DIR__"room_1_2",
        "southeast" : __DIR__"room_3_4",
        "southwest" : __DIR__"room_3_2",
    ]));

    
    set("is_fuben_room", 1);
    set("room_coordinate", "2,3");

    setup();
}

void init()
{
    object wusheng;
    int power;
    
    if (!is_init)
    {
        is_init = 1;
        power = 1000 + random(9001);
        wusheng = NPC_COMBAT_TPS->create_family_npc(0, power, __DIR__"npc/wusheng_canhun");
        
        if (wusheng)
        {
            wusheng->move(this_object());
            wusheng->set("generate_combat_power", power);
            tell_room(this_object(), sprintf(HIR "一道强大的残魂出现了！已存：%d年。\n" NOR, power));
        }
    }
    
    
} 