/**
 * @file room_3_3.c
 * @brief 古圣之地遗迹 - 中心圣殿
 * @author Assistant
 * @date 2024-12-19
 */



inherit ROOM;

int is_init = 0;

/**
 * @brief 创建房间
 * @details 设置古圣之地中心圣殿，这里是整个遗迹的核心
 */
void create()
{
    set("short", HIR "古圣遗迹·中心圣殿" NOR);
    set("long", @LONG
这里是古圣之地的中心圣殿，整个遗迹的核心所在。巨大的圆形
大厅被八根巨大的石柱环绕，每根石柱都雕刻着不同的武学奥义。
天花板上绘有完整的武学传承图谱，虽然年代久远，但依然散发
出强大的武道气息。

大厅中央有一个古老的石台，上面刻着"武道无涯，精神永存"
八个大字。四周弥漫着浓厚的灵气，这里的武圣残魂必定比其他
地方更加强大。

你可以向八个方向探索圣殿的各个区域。
LONG);

    set("exits", ([
        "north"     : __DIR__"room_2_3",
        "south"     : __DIR__"room_4_3",
        "east"      : __DIR__"room_3_4",
        "west"      : __DIR__"room_3_2",
        "northeast" : __DIR__"room_2_4",
        "northwest" : __DIR__"room_2_2",
        "southeast" : __DIR__"room_4_4",
        "southwest" : __DIR__"room_4_2",
    ]));

    
    set("is_fuben_room", 1);
    set("room_coordinate", "3,3");
    set("is_center_room", 1); // 标记为中心房间

    setup();
}

/**
 * @brief 房间初始化
 * @details 在房间初始化时生成一个更强大的武圣残魂
 */
void init()
{
    object wusheng;
    int power;
    mapping dynamic_adjustment;
    
    if (!is_init)
    {
        is_init = 1;
        
        // 中心圣殿的武圣残魂更强大（8000-10000战斗力）
        power = 8000 + random(2001);
        
        // 中心房间的武圣残魂有额外的血量和内力加成
        dynamic_adjustment = ([
            "qi_times" : 3.5,
            "neili_times" : 3.5,
            "npc_set" : "中心圣殿守护者",
        ]);
        
        wusheng = NPC_COMBAT_TPS->create_family_npc(0, power, __DIR__"npc/wusheng_canhun", dynamic_adjustment);
        
        if (wusheng)
        {
            wusheng->move(this_object());
            wusheng->set("generate_combat_power", power);
            tell_room(this_object(), sprintf(HIR "一道强大的残魂出现了！已存：%d年。\n" NOR, power));
            wusheng->set("title", "中心圣殿守护者");
            wusheng->set("long", wusheng->query("long") + 
                        "\n这位武圣残魂明显比其他地方的更加强大，" +
                        "他是中心圣殿的守护者，实力深不可测。\n");          
            
            // 中心圣殿的武圣残魂有特殊的问候语
            wusheng->set("chat_msg", ({
                "圣殿守护者威严地说道：此乃古圣之地的核心，闲杂人等不得入内！",
                "圣殿守护者沉声道：想要通过此地，必须证明你的武道修为！",
                "圣殿守护者环视四周：无数年来，鲜有人能在此地全身而退...",
            }));
        }
    }
    
    
}

/**
 * @brief 玩家进入房间时的特殊处理
 * @param object who 进入的玩家
 * @details 中心圣殿有特殊的进入提示
 */
void init_player(object who)
{
    if (!who || !playerp(who)) return;
    
    tell_object(who, HIR "你感受到了中心圣殿内强大的武道威压！\n" NOR);
    tell_object(who, HIY "这里的武圣残魂比其他地方的更加强大，小心应对！\n" NOR);
} 