/**
 * @brief 创建武圣残魂NPC
 * @details 设置基本属性和门派信息，调用set_combat_power()函数来设置对应门派的技能和战斗力
 */
void create()
{
    string name, desc, family;
    string *names;
    mapping wusheng_data;
    
    // 从mapping中随机选择一个武圣信息
    names = keys(wusheng_info);
    name = names[random(sizeof(names))];
    wusheng_data = wusheng_info[name];
    desc = wusheng_data["desc"];
    family = wusheng_data["family"];
    
    set_name(name, ({ "wusheng", "canhun", "残魂" }));
    set("title", "古代武圣");
    set("long", desc + "\n");
    
    // 设置门派信息，供后续使用
    set("npc_combat_tps_family", family);
    
    set("gender", random(2) ? "男性" : "女性");
    set("age", 300 + random(200)); // 古代武圣，年龄很大
    
    // 基础属性，具体数值将由战斗力系统动态调整
    set("str", 25);
    set("int", 25);
    set("con", 25);
    set("dex", 25);
    
    // 这些属性将被动态覆盖
    set("max_qi", 5000);
    set("eff_qi", 5000);
    set("qi", 5000);
    set("max_jing", 2500);
    set("eff_jing", 2500);
    set("jing", 2500);
    set("max_neili", 3000);
    set("neili", 3000);
    set("jiali", 100);
    set("combat_exp", 1000000);

    set("no_corpse", 1);
    
    // 设置聊天信息
    set("chat_chance", 5);
    set("chat_msg", ({
        "残魂低语道：生前的武功，不知还记得多少...\n",
        "残魂喃喃自语：这些年轻人的武功怎么样？\n",
        "残魂叹息：都已经是死人了，还在这里不肯安息...\n",
        "残魂自言自语：也不知道家里人还好吗...\n",
    }));
    
    set("inquiry", ([
        "武学" : "生前练了几十年，现在只能靠本能战斗了。\n",
        "传承" : "我这点本事，能教给后人就教吧。\n",
        "残魂" : "死了也不安生，大概是放不下生前的执念吧。\n",
        "生前" : "以前的事情有些记不清了，只记得练武和打架。\n",
    ]));
    
    // 设置为副本怪物
    set("is_fuben_npc", 1);
    
    
    setup();
}

/**
 * @brief NPC死亡时的处理
 * @param object who 击杀者
 * @details 根据设计文档实现掉落逻辑
 */
void die(object who)
{
    int power, exp_reward, qiannen_reward;
    string *normal_items, *rare_items;
    
    // 获取战斗力（由外部设置）
    power = query("generate_combat_power") || 5000;
    
    // 计算奖励
    exp_reward = power * 10;
    qiannen_reward = power * 5;
    
    // 普通物品列表（50%掉落几率）
    normal_items = ({
        "/clone/vip/book_tianfu",
        "/clone/vip/book_wuliang", 
        "/clone/vip/dan_zhengqi",
        "/clone/vip/fushougao",
        "/clone/vip/jinsha",
        "/clone/vip/lingzhi",
        "/clone/vip/putao",
        "/clone/vip/tianxiang",
        "/clone/vip/zyao1",
        "/clone/vip/baijia_baoxia",
    });
    
    // 稀有物品列表（20%掉落几率）
    rare_items = ({
        "/clone/vip/jinpiao",
        "/clone/vip/yixun_tu",
        "/clone/vip/putao1",
        "/clone/aoyi_book/aoyi_book_canye",
        "/system/wusheng/obj/dipi",
        "/system/wusheng/obj/longgan",
        "/system/wusheng/obj/tianfei",
        "/system/wusheng/obj/xianshen",
        "/system/wusheng/obj/xuecanguo",
    });

    if (!who)
    {
        who = query_last_damage_from();
    }
    
    // 只给击杀者奖励（单人奖励）
    if (!who || !playerp(who) || environment(who) != environment(this_object()))
    {
        ::die();
        return;
    }
    
    // 经验和潜能奖励
    // who->add("combat_exp", exp_reward);
    FUBEN_D->add_exp(who, exp_reward);
    who->add("potential", qiannen_reward);
    
    tell_object(who, sprintf(HIY "你击败了武圣残魂，获得了 %d 点经验和 %d 点潜能！\n" NOR, 
                exp_reward, qiannen_reward));
    
    // 50%几率掉落普通物品
    if (random(100) < 50)
    {
        object item = new_bind(normal_items[random(sizeof(normal_items))]);
        if (item)
        {
            item->move(who);
            tell_object(who, sprintf(HIG "武圣残魂掉落了%s！\n" NOR, item->query("name")));
        }
    }
    
    // 20%几率掉落稀有物品
    if (random(100) < 20)
    {
        object item = new_bind(rare_items[random(sizeof(rare_items))]);
        if (item)
        {
            item->move(who);
            tell_object(who, sprintf(HIR "武圣残魂掉落了珍贵的%s！\n" NOR, item->query("name")));
        }
    }
    
    // 30%几率掉落武圣真意
    if (random(100) < 30)
    {
        int zhenyi_level = (power / 10);

        zhenyi_level = 100 + random(zhenyi_level);
        if (zhenyi_level > who->query("level"))
            zhenyi_level = who->query("level");
            
        if (zhenyi_level > 0)
        {
            tell_object(who, HIR "武圣残魂的执念化作了武圣真意传承给了你！\n" NOR);
            // 调用武圣真意系统
            if (ZHENYI_MASTER)
                ZHENYI_MASTER->drop_zhenyi_with_boost(who, zhenyi_level);
        }
    }
    
    ::die();
}

/**
 * @brief 初始化NPC
 * @details 设置战斗消息和随机问候
 */
void init()
{
    ::init();
    
    if (random(3) == 0)
    {
        call_out("greet_player", 1 + random(3));
    }
}

/**
 * @brief 问候玩家
 * @details 武圣残魂主动问候进入的玩家
 */
void greet_player()
{
    object *players;
    
    players = filter_array(all_inventory(environment(this_object())), (: playerp($1) :));
    
    if (sizeof(players))
    {
        switch(random(4))
        {
            case 0:
                command("say 残魂看了看你：又有人来了？\n");
                break;
            case 1:
                command("say 残魂皱眉道：这里很危险，你最好小心点。\n");
                break;
            case 2:
                command("say 残魂淡淡地说：年轻人，想试试身手吗？\n");
                break;
            case 3:
                command("say 残魂叹息道：活人不多见了...\n");
                break;
        }
    }
}
