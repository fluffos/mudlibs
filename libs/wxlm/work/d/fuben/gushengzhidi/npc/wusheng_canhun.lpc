/**
 * @file wusheng_canhun.c
 * @brief 武圣残魂NPC模板
 * @author Assistant
 * @date 2024-12-19
 * @details 使用方法：
 *          1. 直接new武圣残魂对象
 *          2. 调用set_combat_power(power)函数设置战斗力
 *          3. 武圣残魂会自动获得对应门派的技能和描述
 *          例如：
 *          object wusheng = new("/d/fuben/gushengzhidi/npc/wusheng_canhun");
 *          wusheng->set_combat_power(5000);
 *          wusheng->move(environment(this_player()));
 */
 
inherit NPC;
