/**
 * @file room_1_5.c
 * @brief 古圣之地遗迹 - 东北角
 * @author Assistant
 * @date 2024-12-19
 */



inherit ROOM;

int is_init = 0;

void create()
{
    set("short", HIW "古圣遗迹·东北角" NOR);
    set("long", "这里是古圣之地的东北角，一处相对隐秘的修炼场所。\n"
               "墙角堆放着许多古老的武学典籍残片，记录着失传的武学奥秘。\n");

    set("exits", ([
        "west"  : __DIR__"room_1_4",
        "south" : __DIR__"room_2_5",
        "southwest" : __DIR__"room_2_4",
    ]));

    
    set("is_fuben_room", 1);
    set("room_coordinate", "1,5");

    setup();
}

void init()
{
    object wusheng;
    int power;
    
    if (!is_init)
    {
        is_init = 1;
        power = 1000 + random(9001);
        wusheng = NPC_COMBAT_TPS->create_family_npc(0, power, __DIR__"npc/wusheng_canhun");
        
        if (wusheng)
        {
            wusheng->move(this_object());
            wusheng->set("generate_combat_power", power);
            tell_room(this_object(), sprintf(HIR "一道强大的残魂出现了！已存：%d年。\n" NOR, power));
        }
    }
    
    
} 