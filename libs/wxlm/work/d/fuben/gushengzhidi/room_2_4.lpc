/**
 * @file room_2_4.c
 * @brief 古圣之地遗迹 - 东北中部
 * @author Assistant
 * @date 2024-12-19
 */



inherit ROOM;

int is_init = 0;

void create()
{
    set("short", HIW "古圣遗迹·东北中部" NOR);
    set("long", "这里是古圣之地的东北中部，古老的武学阵法痕迹依然清晰可见。\n"
               "地面上的石板因为长期承受武者的内力冲击，呈现出特殊的纹理。\n");

    set("exits", ([
        "north" : __DIR__"room_1_4",
        "south" : __DIR__"room_3_4",
        "east"  : __DIR__"room_2_5",
        "west"  : __DIR__"room_2_3",
        "northeast" : __DIR__"room_1_5",
        "northwest" : __DIR__"room_1_3",
        "southeast" : __DIR__"room_3_5",
        "southwest" : __DIR__"room_3_3",
    ]));

    
    set("is_fuben_room", 1);
    set("room_coordinate", "2,4");

    setup();
}

void init()
{
    object wusheng;
    int power;
    
    if (!is_init)
    {
        is_init = 1;
        power = 1000 + random(9001);
        wusheng = NPC_COMBAT_TPS->create_family_npc(0, power, __DIR__"npc/wusheng_canhun");
        
        if (wusheng)
        {
            wusheng->move(this_object());
            wusheng->set("generate_combat_power", power);
            tell_room(this_object(), sprintf(HIR "一道强大的残魂出现了！已存：%d年。\n" NOR, power));
        }
    }
    
    
} 