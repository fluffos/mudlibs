/**
 * @file room_5_2.c
 * @brief 古圣之地遗迹 - 南部西侧
 * @author Assistant
 * @date 2024-12-19
 */

inherit ROOM;

int is_init = 0;

void create()
{
    set("short", HIW "古圣遗迹·南部西侧" NOR);
    set("long", "这里是古圣之地的南部西侧，地面上铺着精美的石砖，每一块都雕刻着不同的武学符号。\n");
    
    set("exits", ([
        "north" : __DIR__"room_4_2", 
        "east" : __DIR__"room_5_3", 
        "west" : __DIR__"room_5_1",
        "northeast" : __DIR__"room_4_3", 
        "northwest" : __DIR__"room_4_1",
    ]));
    
     
    set("is_fuben_room", 1); 
    set("room_coordinate", "5,2");
    
    setup();
}

void init()
{
    object wusheng;
    int power;
    
    if (!is_init) 
    {
        is_init = 1;
        power = 1000 + random(9001);
        wusheng = NPC_COMBAT_TPS->create_family_npc(0, power, __DIR__"npc/wusheng_canhun");
        
        if (wusheng) 
        { 
            wusheng->move(this_object());
            wusheng->set("generate_combat_power", power);
            tell_room(this_object(), sprintf(HIR "一道强大的残魂出现了！已存：%d年。\n" NOR, power));
        }
    }
    
    
} 