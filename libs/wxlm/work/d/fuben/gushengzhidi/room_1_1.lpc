/**
 * @file room_1_1.c
 * @brief 古圣之地遗迹 - 西北角
 * @author Assistant
 * @date 2024-12-19
 */



inherit ROOM;

int is_init = 0;

/**
 * @brief 创建房间
 * @details 设置古圣之地西北角的房间，包含出入口和房间描述
 */
void create()
{
    set("short", HIW "古圣遗迹·西北角" NOR);
    set("long", @LONG
这里是古圣之地的西北角，四周是古老的石墙和残破的石柱。
墙壁上刻着模糊的古文字，诉说着远古武者的传说。地面上
散落着一些古老的武器碎片，显示出这里曾经发生过激烈的
战斗。空气中弥漫着淡淡的灵气，让人感受到古代武圣的威压。

你可以向东、南方向继续探索古圣之地的其他区域。
LONG);

    set("exits", ([
        "south" : __DIR__"enter",
        "east"  : __DIR__"room_1_2",
        "southeast" : __DIR__"room_2_1",
    ]));

     // 副本房间不清理
    set("is_fuben_room", 1); // 副本房间标记
    set("room_coordinate", "1,1"); // 房间坐标标记

    setup();
}

/**
 * @brief 房间初始化
 * @details 在房间初始化时生成一个武圣残魂
 */
void init()
{
    object wusheng;
    int power;
    
    if (!is_init)
    {
        is_init = 1;
        
        // 生成随机战斗力的武圣残魂（1000-10000）
        power = 1000 + random(9001);
        
        // 使用NPC战斗力系统创建武圣残魂
        wusheng = NPC_COMBAT_TPS->create_family_npc(0, power, __DIR__"npc/wusheng_canhun");
        
        if (wusheng)
        {
            wusheng->move(this_object());
            wusheng->set("generate_combat_power", power);
            tell_room(this_object(), sprintf(HIR "一道强大的残魂出现了！已存：%d年。\n" NOR, power));
            
        }
    }
    
    
}