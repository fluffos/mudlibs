

inherit ROOM;

void create()
{
    set("short", "非不裘副本入口");
    set("long", @LONG
这里是非不裘副本的入口。四周弥漫着一股神秘而危险的气息，
仿佛预示着里面将有一场恶战。准备好了吗？踏入这里，你将
面对江湖中最为神秘的高手之一——非不裘！这是一个需要2-6人
组队才能进入的副本。
LONG);
    set("exits", ([
        "out" : "/d/city/guangchang",
        "enter" : __DIR__"fuben_room",
    ]));
    set("no_fight", 1);
    set("no_magic", 1);
    
    set("action_list", ([
        HIC"进入副本"NOR : "start_fuben qiu",
    ]));
    
    setup();
}

void init()
{
    add_action("do_start_fuben", "start_fuben");
}

int do_start_fuben(string arg)
{
    object me = this_player();
    
    if (arg != "qiu")
        return 0;
    
    return "/cmds/usr/start_fuben"->main(me, arg);
}
