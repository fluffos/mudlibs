inherit NPC;
void create()
{
    int qi, attribute, exp, armor, damage;

    ::create();

    set_name("非不裘", ({ "fei buqiu", "fei", "buqiu" }));
    set("long", "非不裘，江湖中神秘的高手，身怀绝技，无人能敌。传闻他曾是一位隐世高人的弟子，因不满师门规矩而叛出，自创一派，横行江湖。其武功诡异莫测，令人难以捉摸。");
    set("gender", "男性");
    set("age", 45);
    set("attitude", "aggressive");

    qi = 200000;
    attribute = 50;
    exp = 500000000;
    armor = 8000;
    damage = 15000;

    set("max_qi", qi);
    set("eff_qi", qi);
    set("qi", qi);
    set("max_jing", qi/2);
    set("eff_jing", qi/2);
    set("jing", qi/2);

    // 设定内力为10w
    set("max_neili", 100000);
    set("neili", 100000);

    set("str", attribute);
    set("int", attribute);
    set("con", attribute);
    set("dex", attribute);

    set("combat_exp", exp);

    set_temp("apply/armor", armor);
    set_temp("apply/damage", damage);

    set_skill("force", 500);
    set_skill("dodge", 500);
    set_skill("parry", 500);
    set_skill("sword", 500);
    set_skill("strike", 500);

    setup();
}
