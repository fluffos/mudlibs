
inherit ITEM;

void create()
{
    set_name(HIW"白色光球"NOR, ({"white ball", "ball"}));
    set("long", "这是一个洁白如玉的光球，散发着祥和的气息。");
    set("unit", "个");
    set("is_light_ball", 1);
    set("no_get", 1);
    setup();
}

void init()
{
    add_action("do_transfer", "transfer");
}

int do_transfer(string arg, object me)
{
    if (!me)
        me = this_player();
    
    if (!arg || arg != "功力")
        return notify_fail("你要传什么？\n");
    
    message_vision("$N将手放在白色光球上，开始传输功力。\n", me);
    me->receive_heal("qi", me->query("max_qi") / 10);
    me->receive_heal("jing", me->query("max_jing") / 10);
    tell_object(me, HIG"你感到一股温和的力量涌入体内！\n"NOR);
    
    destruct(this_object());
    return 1;
}
