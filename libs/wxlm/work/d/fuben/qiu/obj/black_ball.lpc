
inherit ITEM;

void create()
{
    set_name("黑色光球", ({"black ball", "ball"}));
    set("long", "这是一个漆黑如墨的光球，散发着不祥的气息。");
    set("unit", "个");
    set("is_light_ball", 1);
    set("no_get", 1);
    setup();
}

void init()
{
    add_action("do_transfer", "transfer");
}

int do_transfer(string arg, object me)
{
    if (!me)
        me = this_player();
    
    if (!arg || arg != "功力")
        return notify_fail("你要传什么？\n");
    
    message_vision("$N将手放在黑色光球上，开始传输功力。\n", me);
    me->receive_damage("qi", me->query("max_qi") / 10);
    me->receive_damage("jing", me->query("max_jing") / 10);
    tell_object(me, HIR"你感到一股强大的力量从体内流失！\n"NOR);
    
    destruct(this_object());
    return 1;
}
