#include <room.h>

inherit ROOM;

void create();
void heart_beat();

/**
 * @brief 西方刀皇战斗房间
 * @details 集成create_family_npc调用，创建15000战力的西方刀皇
 */
void create()
{
    set("short", HIW "白虎刀楼" NOR);
    set("long", @LONG
这里是白虎刀楼，整个刀楼肃杀威严，四周悬挂着各种名刀。
刀楼中央是一座白玉刀台，台上盘坐着一位白衣刀客。他
手持一把寒光四射的宝刀，周身散发着白色的刀气，那是白虎刀法的至高境界。

楼内刀意纵横，让人感受到一股肉眼可见的肖杀之意。但同时又能感受到一股
强大的压迫感，那是来自刀皇无边刀意的威严。想要在这里挑战刀皇，
不仅需要高强的武功，更需要坚定不移的刀道意志和无畏的勇气。

LONG );

    set("exits", ([
        "east" : __DIR__"enter",
    ]));
    
    set("no_clean_up", 1);
    set("is_fuben_room", 1);
    set("no_fight", 0);  // 允许战斗
    
    // 设置心跳，用于创建天王BOSS
    set_heart_beat(1);
    
    setup();
}

/**
 * @brief 心跳函数，用于创建天王BOSS
 * @details 使用create_family_npc创建15000战力的广目天王
 */
void heart_beat()
{
    object tianwang;
    object *obs;
    
    // 检查是否已经存在天王
    obs = filter_array(all_inventory(this_object()), 
        (: living($1) && $1->id("xifang tianwang") :));
    
    if (sizeof(obs) > 0)
    {
        set_heart_beat(0);
        return;
    }
    
    // 检查是否有玩家在房间内
    obs = filter_array(all_inventory(this_object()), (: userp($1) :));
    if (sizeof(obs) == 0)
        return;
    
    // 使用create_family_npc创建天王BOSS
    tianwang = NPC_COMBAT_TPS->create_family_npc(
        0,  // 门派由模板决定（少林派）
        15000,  // 15000战斗力
        __DIR__"npc/xifang_tianwang_template",  // 模板路径
        ([  // 动态调整参数
            "qi_times": 0,     // 不使用倍数，手动设置
            "jing_times": 0,   // 不使用倍数，手动设置  
            "neili_times": 2  // 内力使用2倍
        ])
    );
    
    if (tianwang)
    {
        // 手动设置2000万气血和500万精神
        tianwang->set("max_qi", 20000000);
        tianwang->set("eff_qi", 20000000); 
        tianwang->set("qi", 20000000);
        tianwang->set("max_jing", 5000000);
        tianwang->set("eff_jing", 5000000);
        tianwang->set("jing", 5000000);
        
        // 移动到当前房间
        tianwang->move(this_object());
        
        // 设置一些额外属性
        tianwang->set_temp("apply/attack", 500);
        tianwang->set_temp("apply/damage", 500);
        tianwang->set_temp("apply/armor", 800);
        tianwang->set_temp("apply/parry", 300);
        tianwang->set_temp("apply/dodge", 300);
        
        message_vision(HIW "\n西方刀皇双手合十，白色刀光大放！\n" NOR, tianwang);
        
        tell_room(this_object(), HIY "空气中传来威严的声音：\"既然敢来挑战，那就让我见识一下你的刀法造诣！\"\n" NOR);
        
        set_heart_beat(0);
    }
    else
    {
        tell_room(this_object(), HIR "创建西方广目天王失败！\n" NOR);
        set_heart_beat(0);
    }
}