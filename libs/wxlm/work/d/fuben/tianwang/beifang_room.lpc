#include <room.h>

inherit ROOM;

void create();
void heart_beat();

/**
 * @brief 北方拳圣战斗房间
 * @details 集成create_family_npc调用，创建15000战力的北方拳圣
 */
void create()
{
    set("short", HIC "玄武拳台" NOR);
    set("long", @LONG
这里是玄武拳台，整个拳台厚重威严，四周矗立着巨大的铁柱。
拳台中央是一座坚固的黑玉武台，台上盘坐着一位黑衣拳客。他
双拳紧握，周身环绕着黑色的护体真气，那是玄武拳法的至高境界。

台内气氛凝重，给人一种坚不可摧的感觉。地面都是用最坚硬的玄武岩铺设，
象征着拳圣无与伦比的防御能力。想要挑战这位拳道大家，不仅需要强大的
攻击力，更需要持久的战斗意志。

LONG );

    set("exits", ([
        "south" : __DIR__"enter",
    ]));
    
    set("no_clean_up", 1);
    set("is_fuben_room", 1);
    set("no_fight", 0);  // 允许战斗
    
    // 设置心跳，用于创建天王BOSS
    set_heart_beat(1);
    
    setup();
}

/**
 * @brief 心跳函数，用于创建天王BOSS
 * @details 使用create_family_npc创建15000战力的多闻天王
 */
void heart_beat()
{
    object tianwang;
    object *obs;
    
    // 检查是否已经存在天王
    obs = filter_array(all_inventory(this_object()), 
        (: living($1) && $1->id("beifang tianwang") :));
    
    if (sizeof(obs) > 0)
    {
        set_heart_beat(0);
        return;
    }
    
    // 检查是否有玩家在房间内
    obs = filter_array(all_inventory(this_object()), (: userp($1) :));
    if (sizeof(obs) == 0)
        return;
    
    // 使用create_family_npc创建天王BOSS
    tianwang = NPC_COMBAT_TPS->create_family_npc(
        0,  // 门派由模板决定（丐帮）
        15000,  // 15000战斗力
        __DIR__"npc/beifang_tianwang_template",  // 模板路径
        ([  // 动态调整参数
            "qi_times": 0,     // 不使用倍数，手动设置
            "jing_times": 0,   // 不使用倍数，手动设置  
            "neili_times": 2  // 内力使用2倍
        ])
    );
    
    if (tianwang)
    {
        // 手动设置2000万气血和500万精神
        tianwang->set("max_qi", 20000000);
        tianwang->set("eff_qi", 20000000); 
        tianwang->set("qi", 20000000);
        tianwang->set("max_jing", 5000000);
        tianwang->set("eff_jing", 5000000);
        tianwang->set("jing", 5000000);
        
        // 移动到当前房间
        tianwang->move(this_object());
        
        // 设置一些额外属性
        tianwang->set_temp("apply/attack", 500);
        tianwang->set_temp("apply/damage", 500);
        tianwang->set_temp("apply/armor", 800);
        tianwang->set_temp("apply/parry", 300);
        tianwang->set_temp("apply/dodge", 300);
        
        message_vision(HIC "\n北方拳圣缓缓起身，黑色护体真气如潮水涌出！\n" NOR, tianwang);
        
        tell_room(this_object(), HIY "空气中传来沉稳的声音：\"年轻人，就让我来试试你的防御功夫如何！\"\n" NOR);
        
        set_heart_beat(0);
    }
    else
    {
        tell_room(this_object(), HIR "创建北方多闻天王失败！\n" NOR);
        set_heart_beat(0);
    }
}