inherit NPC;

void create();
void die();
void init();
void heart_beat();
void xuanwu_fist_skill(object *enemy);

/**
 * @brief 北方拳圣模板文件
 * @details 设置丐帮技能，用于create_family_npc的模板参数
 */
void create()
{
    ::create();
    
    set_name("北方拳圣", ({ "beifang quansheng", "quansheng", "beifang", "quan sheng" }));
    set("title", HIC "北方拳圣" NOR);
    set("long", @LONG
北方拳圣，武林中传说的拳法宗师。他身着黑色武袍，体格魁梧，
双拳如铁，拳意浑厚。他将丐帮绝学修炼到登峰造极，拳法如玄武神
功，坚不可摧，每一拳都蕴含着厚重如山的内力。

他的周身环绕着黑色的护体真气，那是玄武拳法的至高境界。作为武林中的
拳道大家，他的防御之术已达登峰造极的境界。想要从他这里领悟到玄武拳
法的奥妙，必须要有钢铁般的意志和无坚不摧的决心。

LONG );
    
    // 关键设置：指定门派技能为丐帮
    set("npc_combat_tps_family", "丐帮");
    
    set("gender", "男性");
    set("age", 8888);
    set("no_get", 1);
    set("shen_type", 1);
    set("attitude", "aggressive");
    // 移除乞丐设定
    
    // 基础属性会被create_family_npc的战斗力计算覆盖
    set("str", 50);
    set("int", 50);
    set("con", 50);
    set("dex", 50);
    
    // 这些数值会被战斗力计算和手动设置覆盖
    set("qi", 100000);
    set("max_qi", 100000);
    set("jing", 50000);
    set("max_jing", 50000);
    set("neili", 10000);
    set("max_neili", 10000);
    set("jiali", 1000);
    set("combat_exp", 1000000);
    
    setup();
}

/**
 * @brief 初始化函数，玩家进入时自动攻击
 */
void init()
{
    object me = this_player();
    
    ::init();
    
    if (interactive(me))
    {
        call_out("start_fight", 1, me);
    }
}

/**
 * @brief 开始战斗的延迟函数
 * @param object me 玩家对象
 */
void start_fight(object me)
{
    if (!me || environment(me) != environment(this_object()))
        return;
        
    message_vision(HIC "\n$N" HIC "缓缓起身，黑色的护体真气如潮水般涌出，拳意威严。\n" NOR, this_object());
    message_vision(HIY "北方拳圣沉声说道：\"年轻人，就让我来试试你的拳脚功夫如何！\"\n" NOR, this_object());
    
    kill_ob(me);
}

/**
 * @brief 心跳函数，触发特殊技能
 */
void heart_beat()
{
    object *enemy;
    int current_hp_percent;
    
    ::heart_beat();
    
    // 获取当前血量百分比
    current_hp_percent = query("qi") * 100 / query("max_qi");
    
    // 获取所有敌人
    enemy = query_enemy();
    enemy = filter_array(enemy, (: userp($1) :));
    
    if (sizeof(enemy) > 0)
    {
        // 血量低于50%时，有概率释放玄武真劲
        if (current_hp_percent < 50 && random(4) == 0)
        {
            xuanwu_fist_skill(enemy);
        }
    }
}

/**
 * @brief 玄武真劲技能
 * @param object *enemy 敌人列表
 */
void xuanwu_fist_skill(object *enemy)
{
    string msg;
    
    catch {
        msg = HIC "$N" HIB "运转玄武神功，黑色真气如山如海，震撼四方！"NOR"\n";
        message_vision(msg, this_object());
        
        foreach (object ob in enemy)
        {
            if (objectp(ob) && living(ob))
            {
                ob->receive_damage("qi", 32000, this_object());
                ob->receive_wound("qi", 16000, this_object());
                ob->receive_damage("jing", 8000, this_object());
                tell_object(ob, HIC "玄武真劲厚重如山，震得你气血翻涌！"NOR"\n");
                
                // 对低等级玩家造成额外伤害
                if (ob->query("level") < 600)
                {
                    ob->receive_damage("qi", 48000, this_object());
                    ob->receive_wound("qi", 24000, this_object());
                    tell_object(ob, HIR "拳圣的浑厚内力让你难以招架！"NOR"\n");
                }
            }
        }
    };
}

/**
 * @brief 天王死亡处理函数
 * @details 实现秘传领悟、奖励发放和进度记录
 */
void die()
{
    object *players;
    object me = this_object();
    string tianwang_name = "beifang";
    string mizhuan_name = "玄武秘传";
    int i;
    int exp = 200000;        // 基础经验20万
    int potential = 250000;  // 基础潜能25万  
    int start_time;
    
    message_vision(HIC "\n$N" HIC "长叹一声，黑色的真气逐渐消散，化作道道黑光飞向北方。\n" NOR, me);
    message_vision(HIY "\"固若金汤，坚不可摧...玄武秘传的精要，你已经有所领悟了。\"\n" NOR, me);
    
    players = filter_array(all_inventory(environment(me)), (: userp($1) :));
    
    for (i = 0; i < sizeof(players); i++)
    {
        // 获取开始时间
        start_time = players[i]->query("fuben_tianwang/last_time");
        
        tell_object(players[i], HIG "\n恭喜你击败了北方多闻天王，获得了丰厚的奖励！\n" NOR);
        tell_object(players[i], HIY "你获得了：\n" NOR);
        tell_object(players[i], HIY "  " + exp + " 点经验\n" NOR);
        tell_object(players[i], HIY "  " + potential + " 点潜能\n" NOR);
        
        // 添加经验和潜能
        FUBEN_D->add_exp(players[i], exp);
        players[i]->add("potential", potential);
        
        // 记录击败状态
        players[i]->set("tianwang_defeated/" + tianwang_name, 1);
        
        // 尝试领悟玄武秘传
        {
            int chance = 4;  // 4%概率
            string progress_key = "mizhuan_progress/" + mizhuan_name;
            int fail_count = players[i]->query(progress_key);
            
            if (random(100) < chance || fail_count >= 25) {
                // 领悟秘传
                if (MIZHUAN_MASTER->add_mizhuan(players[i], mizhuan_name)) {
                    tell_object(players[i], HIY "  " + HIC + "【玄武秘传】" + HIY + " - 恭喜领悟八极秘传！\n" NOR);
                    players[i]->delete(progress_key);
                } else {
                    players[i]->add(progress_key, 1);
                    tell_object(players[i], HIB "  机缘不足，未能领悟玄武秘传（" + (players[i]->query(progress_key)) + "/25）\n" NOR);
                }
            } else {
                players[i]->add(progress_key, 1);
                tell_object(players[i], HIB "  机缘不足，未能领悟玄武秘传（" + (players[i]->query(progress_key)) + "/25）\n" NOR);
            }
        }
        
        // 20%概率掉落真意（600-700级）
        if (random(100) < 20)
        {
            int zhenyi_level;
            
            // 真意等级范围：600-700级，不超过玩家等级
            zhenyi_level = 600 + random(101);
            if (zhenyi_level > players[i]->query("level"))
                zhenyi_level = players[i]->query("level");
                
            if (zhenyi_level >= 100)
            {
                tell_object(players[i], HIR "北方拳圣的拳道真意化作了传承传授给了你！\n" NOR);
                // 调用真意系统
                if (ZHENYI_MASTER)
                    ZHENYI_MASTER->drop_zhenyi_with_boost(players[i], zhenyi_level);
            }
        }
        
        // 奖励基础炼体丹
        {
            object lianti_dan;
            
            lianti_dan = new_bind("/system/wusheng/obj/chuji_lianti_dan", players[i]);
            if (lianti_dan)
            {
                lianti_dan->move(players[i]);
                tell_object(players[i], HIW "  基础炼体丹 x1\n" NOR);
            }
        }
        
        // 记录副本监控日志
        if (start_time)
            MONITOR_MASTER->monitor_fuben_log(players[i], "北方拳圣", start_time, time(), potential, exp);
        
        // 检查是否击败了全部天王
        {
            string *tianwang_list = ({ "dongfang", "nanfang", "xifang", "beifang" });
            int all_defeated = 1;
            int j;
            
            for (j = 0; j < sizeof(tianwang_list); j++)
            {
                if (!players[i]->query("tianwang_defeated/" + tianwang_list[j]))
                {
                    all_defeated = 0;
                    break;
                }
            }
            
            if (all_defeated)
            {
                tell_object(players[i], HIM "\n\n=== 四象传承完成 ===\n" NOR);
                tell_object(players[i], HIM "恭喜！你已经击败了全部四大天王！\n" NOR);
                tell_object(players[i], HIM "额外奖励：\n" NOR);
                tell_object(players[i], HIY "  " + "300000" + " 点经验\n" NOR);
                tell_object(players[i], HIY "  " + "350000" + " 点潜能\n" NOR);
                
                // 发放终极奖励
                FUBEN_D->add_exp(players[i], 300000);
                players[i]->add("potential", 350000);
                
                // 额外奖励中级炼体丹
                {
                    object zhongji_lianti_dan;
                    
                    zhongji_lianti_dan = new_bind("/system/wusheng/obj/zhongji_lianti_dan", players[i]);
                    if (zhongji_lianti_dan)
                    {
                        zhongji_lianti_dan->move(players[i]);
                        tell_object(players[i], HIG "  中级炼体丹 x1\n" NOR);
                    }
                }
                
                // 清理击败标记，允许再次挑战
                players[i]->delete("tianwang_defeated");
                
                tell_object(players[i], HIW "四象传承已重置，你可以再次挑战四大天王！\n" NOR);
            }
        }
    }
    
    call_out("destroy_fuben", 30);  // 30秒后销毁副本房间
    
    ::die();
}

/**
 * @brief 销毁副本房间
 */
void destroy_fuben()
{
    object *players;
    object room = environment(this_object());
    int i;
    
    if (!room) return;
    
    players = filter_array(all_inventory(room), (: userp($1) :));
    
    for (i = 0; i < sizeof(players); i++)
    {
        tell_object(players[i], HIR "\n天王殿开始崩塌，你被传送出副本！\n" NOR);
        players[i]->move("/d/city/guangchang");
        tell_object(players[i], "你眼前一花，发现自己已经回到了扬州广场。\n");
    }
}