#include <room.h>

inherit ROOM;

void create();
void heart_beat();

/**
 * @brief 东方剑圣战斗房间
 * @details 集成create_family_npc调用，创建15000战力的东方剑圣
 */
void create()
{
    set("short", HIW "青龙剑阁" NOR);
    set("long", @LONG
这里是东方青龙剑阁，整个剑阁古雅幽深，四周挂满了各式古剑。
剑阁中央是一座青石剑台，台上盘坐着一位白衣胜雪的剑客。他
手持一把青锋古剑，周身剑意凌厉，那是青龙剑法的至高境界。

空气中弥漫着淡淡的剑意，居然让人产生一种如沐春风的清新感觉。
这里便是传说中的东方剑圣修炼之地，只有真正的剑道高手才能够与他
过招，并从中领悟到青龙剑法的精髓。

LONG );

    set("exits", ([
        "west" : __DIR__"enter",
    ]));
    
    set("no_clean_up", 1);
    set("is_fuben_room", 1);
    set("no_fight", 0);  // 允许战斗
    
    // 设置心跳，用于创建天王BOSS
    set_heart_beat(1);
    
    setup();
}

/**
 * @brief 心跳函数，用于创建剑圣BOSS
 * @details 使用create_family_npc创建15000战力的东方剑圣
 */
void heart_beat()
{
    object tianwang;
    object *obs;
    
    // 检查是否已经存在剑圣
    obs = filter_array(all_inventory(this_object()), 
        (: living($1) && $1->id("dongfang tianwang") :));
    
    if (sizeof(obs) > 0)
    {
        set_heart_beat(0);
        return;
    }
    
    // 检查是否有玩家在房间内
    obs = filter_array(all_inventory(this_object()), (: userp($1) :));
    if (sizeof(obs) == 0)
        return;
    
    // 使用create_family_npc创建剑圣BOSS
    tianwang = NPC_COMBAT_TPS->create_family_npc(
        0,  // 门派由模板决定（华山派）
        15000,  // 15000战斗力
        __DIR__"npc/dongfang_tianwang_template",  // 模板路径
        ([  // 动态调整参数
            "qi_times": 0,     // 不使用倍数，手动设置
            "jing_times": 0,   // 不使用倍数，手动设置  
            "neili_times": 2  // 内力使用2倍
        ])
    );
    
    if (tianwang)
    {
        // 手动设置2000万气血和500万精神
        tianwang->set("max_qi", 20000000);
        tianwang->set("eff_qi", 20000000); 
        tianwang->set("qi", 20000000);
        tianwang->set("max_jing", 5000000);
        tianwang->set("eff_jing", 5000000);
        tianwang->set("jing", 5000000);
        
        // 移动到当前房间
        tianwang->move(this_object());
        
        // 设置一些额外属性
        tianwang->set_temp("apply/attack", 500);
        tianwang->set_temp("apply/damage", 500);
        tianwang->set_temp("apply/armor", 800);
        tianwang->set_temp("apply/parry", 300);
        tianwang->set_temp("apply/dodge", 300);
        
        message_vision(HIW "\n东方剑圣缓缓睁开双眼，剑意凌天！\n" NOR, tianwang);
        
        tell_room(this_object(), HIY "空气中传来清夙的声音：\"既然敢于挑战老夫，那就让我见识一下你的剑法！\"\n" NOR);
        
        set_heart_beat(0);
    }
    else
    {
        tell_room(this_object(), HIR "创建东方剑圣失败！\n" NOR);
        set_heart_beat(0);
    }
}