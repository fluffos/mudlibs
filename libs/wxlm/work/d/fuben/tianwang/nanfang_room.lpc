#include <room.h>

inherit ROOM;

void create();
void heart_beat();

/**
 * @brief 南方火尊战斗房间
 * @details 集成create_family_npc调用，创建15000战力的南方火尊
 */
void create()
{
    set("short", HIR "朱雀火殿" NOR);
    set("long", @LONG
这里是朱雀火殿，整个火殿灰翟壮丽，四周燃烧着永不熄灭的火焰。
火殿中央是一座由玄武岩雕刻的火台，台上盘坐着一位红衣修行者。他
手持一把烈焰长剑，周身环绕着红色的火焰真气，那是朱雀火功的至高境界。

殿内温度極高，但又不让人感到炽热难耐，反而有一种温暖舒适的感觉。
这里便是传说中的南方火尊修炼之地，能够挑战这位火系宗师的，
必定是武功高强、内力深厚的绝世高手。

LONG );

    set("exits", ([
        "north" : __DIR__"enter",
    ]));
    
    set("no_clean_up", 1);
    set("is_fuben_room", 1);
    set("no_fight", 0);  // 允许战斗
    
    // 设置心跳，用于创建天王BOSS
    set_heart_beat(1);
    
    setup();
}

/**
 * @brief 心跳函数，用于创建天王BOSS
 * @details 使用create_family_npc创建15000战力的增长天王
 */
void heart_beat()
{
    object tianwang;
    object *obs;
    
    // 检查是否已经存在天王
    obs = filter_array(all_inventory(this_object()), 
        (: living($1) && $1->id("nanfang tianwang") :));
    
    if (sizeof(obs) > 0)
    {
        set_heart_beat(0);
        return;
    }
    
    // 检查是否有玩家在房间内
    obs = filter_array(all_inventory(this_object()), (: userp($1) :));
    if (sizeof(obs) == 0)
        return;
    
    // 使用create_family_npc创建天王BOSS
    tianwang = NPC_COMBAT_TPS->create_family_npc(
        0,  // 门派由模板决定（武当派）
        15000,  // 15000战斗力
        __DIR__"npc/nanfang_tianwang_template",  // 模板路径
        ([  // 动态调整参数
            "qi_times": 0,     // 不使用倍数，手动设置
            "jing_times": 0,   // 不使用倍数，手动设置  
            "neili_times": 2  // 内力使用2倍
        ])
    );
    
    if (tianwang)
    {
        // 手动设置2000万气血和500万精神
        tianwang->set("max_qi", 20000000);
        tianwang->set("eff_qi", 20000000); 
        tianwang->set("qi", 20000000);
        tianwang->set("max_jing", 5000000);
        tianwang->set("eff_jing", 5000000);
        tianwang->set("jing", 5000000);
        
        // 移动到当前房间
        tianwang->move(this_object());
        
        // 设置一些额外属性
        tianwang->set_temp("apply/attack", 500);
        tianwang->set_temp("apply/damage", 500);
        tianwang->set_temp("apply/armor", 800);
        tianwang->set_temp("apply/parry", 300);
        tianwang->set_temp("apply/dodge", 300);
        
        message_vision(HIR "\n南方火尊缓缓站起，红色神焰冲天而起！\n" NOR, tianwang);
        
        tell_room(this_object(), HIY "空气中传来威严的声音：\"朱雀神火，炽热如焰，让我看看你们的火功造诣！\"\n" NOR);
        
        set_heart_beat(0);
    }
    else
    {
        tell_room(this_object(), HIR "创建南方增长天王失败！\n" NOR);
        set_heart_beat(0);
    }
}