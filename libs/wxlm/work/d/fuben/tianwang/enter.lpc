#include <room.h>

inherit ROOM;

/**
 * @brief 创建四象守护殿入口房间
 * @details 提供四个方向的传送门，通往四象守护者的战斗房间
 */
void create()
{
    set("short", HIW "四象守护殿" NOR);
    set("long", @LONG
这里是传说中的四象守护殿，一座古朴庄严的武学圣地。殿堂正中央屹立着
四根巨大的汉白玉柱，每根柱子上都雕刻着栩栩如生的四象神兽图案。四周
灵气缭绕，武意盎然，显示着这里深厚的武学底蕴。

东方是青龙剑阁，由东方剑圣镇守，传承着青龙剑法的绝世精义；
南方是朱雀火殿，由南方火尊坐镇，掌握着朱雀神功的奥妙真谛；
西方是白虎刀楼，由西方刀皇驻守，精通着白虎刀法的霸道招式；
北方是玄武拳台，由北方拳圣镇守，修炼着玄武神功的浑厚内力。

想要获得四象秘传的传承，必须击败对应方位的守护者。但要小心，这些武
学宗师都拥有着极其恐怖的实力，非绝顶高手绝对无法与之匹敌。

LONG );

    set("exits", ([
        "out"   : "/d/city/guangchang",
        "east"  : __DIR__"dongfang_room",
        "south" : __DIR__"nanfang_room", 
        "west"  : __DIR__"xifang_room",
        "north" : __DIR__"beifang_room",
    ]));

    set("no_fight", 1);
    set("no_magic", 1);
    set("is_fuben_room", 1);

    setup();
}

/**
 * @brief 初始化函数，添加副本启动命令
 */
void init()
{
    add_action("do_start_fuben", "start_fuben");
    add_action("do_check_progress", "progress");
    add_action("do_check_progress", "jindu");
}

/**
 * @brief 启动副本命令处理
 * @param string arg 参数
 * @return int 1表示成功处理，0表示未处理
 */
int do_start_fuben(string arg)
{
    object me = this_player();
    
    if (arg != "tianwang")
        return 0;
    
    return "/cmds/usr/start_fuben"->main(me, arg);
}

/**
 * @brief 检查守护者击败进度
 * @param string arg 参数
 * @return int 1表示成功处理
 */
int do_check_progress(string arg)
{
    object me = this_player();
    mapping tianwang_defeated;
    string *tianwang_list = ({ "dongfang", "nanfang", "xifang", "beifang" });
    string *tianwang_names = ({ "东方剑圣", "南方火尊", "西方刀皇", "北方拳圣" });
    string msg = "";
    int i;
    int defeated_count = 0;
    
    tianwang_defeated = me->query("tianwang_defeated");
    if (!mapp(tianwang_defeated))
        tianwang_defeated = ([]);
        
    msg += HIY "=== 四象守护者挑战进度 ===\n" NOR;
    
    for (i = 0; i < sizeof(tianwang_list); i++)
    {
        if (tianwang_defeated[tianwang_list[i]])
        {
            msg += HIG "√ " + tianwang_names[i] + " - 已击败\n" NOR;
            defeated_count++;
        }
        else
        {
            msg += HIR "× " + tianwang_names[i] + " - 未击败\n" NOR;
        }
    }
    
    msg += HIY "\n已击败守护者数量：" + defeated_count + "/4\n" NOR;
    
    if (defeated_count == 4)
    {
        msg += HIM "\n恭喜！你已经击败了全部四象守护者！\n" NOR;
        msg += HIM "你可以再次挑战来获取更多的秘传领悟机会。\n" NOR;
    }
    else
    {
        msg += HIR "\n继续挑战剩余的守护者来获得完整的四象传承！\n" NOR;
    }
    
    write(msg);
    return 1;
}

/**
 * @brief 房间离开检查，显示提示信息
 * @param object me 玩家对象
 * @param string dir 方向
 * @return int 1表示允许离开
 */
int valid_leave(object me, string dir)
{
    string tianwang_name = "";
    string mizhuan_name = "";
    
    switch(dir)
    {
        case "east":
            tianwang_name = "东方剑圣";
            mizhuan_name = "青龙秘传";
            break;
        case "south":
            tianwang_name = "南方火尊";
            mizhuan_name = "朱雀秘传";
            break;
        case "west":
            tianwang_name = "西方刀皇";
            mizhuan_name = "白虎秘传";
            break;
        case "north":
            tianwang_name = "北方拳圣";
            mizhuan_name = "玄武秘传";
            break;
        case "out":
            return ::valid_leave(me, dir);
        default:
            return ::valid_leave(me, dir);
    }
    
    if (tianwang_name != "")
    {
        tell_object(me, HIR "你即将前往挑战" + tianwang_name + "，击败后有机会领悟" + mizhuan_name + NOR"！\n" );
        tell_object(me, HIY "准备好面对这位拥有15000战斗力和2000万气血的超级强敌了吗？" NOR"\n");
    }
    
    return ::valid_leave(me, dir);
}