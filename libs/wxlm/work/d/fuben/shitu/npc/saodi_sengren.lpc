inherit NPC;


void set_guard_skills_and_attributes(object player);

void create()
{
    set_name("圣贤堂大师", ({ "saodi sengren", "sengren" }));
    set("gender", "男性");
    set("age", 70);
    set("long", "他是圣贤堂中德高望重的大师，一双眼睛炯炯有神，仿佛能看透世间万物。\n"
                "须发皆白，面容却红润如婴儿，显然内功修为已至化境。虽年过古稀，但举手\n"
                "投足间气势凛然，乃是江湖上少有的高人。据说他一掌之力可开山断石，却从\n"
                "不轻易出手，今日在此考验师徒，想必是看重你们的潜力。\n");
    
    set("gender", "男性");
    set("attitude", "friendly");
    set("class", "bonze");
    set("age", 98);
    set("shen_type", 1);
    set("str", 37);
    set("int", 42);
    set("con", 41);
    set("dex", 36);
    set("max_qi", 80000);
    set("max_jing", 80000);
    set("neili", 80000);
    set("max_neili", 80000);
    set("jiali", 85);
    set("combat_exp", 30000000);
    set_skill("buddhism", 250);
    set_skill("literate", 200);
    set_skill("blade", 200);
    set_skill("claw", 200);
    set_skill("club", 200);
    set_skill("cuff", 200);
    set_skill("dodge", 200);
    set_skill("finger", 200);
    set_skill("force", 200);
    set_skill("hand", 200);
    set_skill("parry", 200);
    set_skill("staff", 200);
    set_skill("strike", 200);
    set_skill("sword", 200);
    set_skill("whip", 200);
    set_skill("banruo-zhang", 200);
    set_skill("cibei-dao", 200);
    set_skill("damo-jian", 200);
    set_skill("fengyun-shou", 200);
    set_skill("fumo-jian", 200);
    set_skill("hunyuan-yiqi", 200);
    set_skill("shaolin-xinfa", 200);
    set_skill("jingang-quan", 200);
    set_skill("longzhua-gong", 200);
    set_skill("luohan-quan", 200);
    set_skill("nianhua-zhi", 200);
    set_skill("pudu-zhang", 200);
    set_skill("qianye-shou", 200);
    set_skill("sanhua-zhang", 200);
    set_skill("riyue-bian", 200);
    set_skill("shaolin-shenfa", 200);
    set_skill("weituo-gun", 200);
    set_skill("wuchang-zhang", 200);
    set_skill("xiuluo-dao", 200);
    set_skill("yingzhua-gong", 200);
    set_skill("yijinjing", 200);
    set_skill("yizhi-chan", 400);
    set_skill("zui-gun", 200);
    set_skill("jingang-buhuaiti", 200);
    map_skill("blade", "cibei-dao");
    map_skill("claw", "longzhua-gong");
    map_skill("club", "wuchang-zhang");
    map_skill("cuff", "luohan-quan");
    map_skill("dodge", "shaolin-shenfa");
    map_skill("finger", "nianhua-zhi");
    map_skill("force", "yijinjing");
    map_skill("hand", "fengyun-shou");
    map_skill("parry", "jingang-buhuaiti");
    map_skill("staff", "weituo-gun");
    map_skill("strike", "sanhua-zhang");
    map_skill("sword", "fumo-jian");
    map_skill("whip", "riyue-bian");
    prepare_skill("finger", "nianhua-zhi");
    prepare_skill("strike", "sanhua-zhang");
    create_family("少林派", 0, "打杂僧人");
    set("chat_chance_combat", 120);
    set("chat_msg_combat", ({
        (: perform_action, "strike.san" :),
        (: perform_action, "finger.fuxue" :),
        (: exert_function, "recover" :),
        (: exert_function, "powerup" :),
        (: command("say " + HIW "武学一道，贵在师徒传承，今日便让我看看你们的本事！" NOR) :),
        (: command("say " + HIW "师徒同心，其利断金！莫要让为师失望！" NOR) :),
        (: command("say " + HIW "我倒要看看，你这徒弟有多大的造化！" NOR) :),
    }));
    set_temp("apply/attack", 300);
    set_temp("apply/defense", 300);
    set_temp("apply/unarmed_damage", 150);
    set_temp("apply/armor", 300);
    setup();
    carry_object("/d/shaolin/obj/cheng-cloth")->wear();
}

void init()
{
    object player = this_player();

    if (playerp(player) && player->is_team_leader())
    {
        set_guard_skills_and_attributes(player);
        message_vision(CYN "$N" CYN "目光如炬，扫视着在场所有人：" + HIW "今日我奉圣贤堂之命，特来考验你们师徒武学造诣。" + NOR + HIY "通过考验者，必有重赏！" NOR + "\n", this_object());
    }
}

void set_guard_skills_and_attributes(object player)
{
    int skill_level = 0;
    int max_att_level = 0;
    object *team = player->query_team();

    if (skill_level < 200) {
        skill_level = 200;
    }

    //技能等级取队伍中除了我以外所有成员的平均值
    foreach (object member in team) {
        if (member == player) {
            continue;
        }

        skill_level += member->query_skill("force", 1);
    }

    skill_level /= (sizeof(team) - 1);

    //我的气血的十倍
    max_att_level = player->query("max_qi") * 10;

    set("qi", max_att_level);
    set("eff_qi", max_att_level);
    set("jing", max_att_level);
    set("eff_jing", max_att_level);
    set("max_qi", max_att_level);
    set("max_jing", max_att_level);
    set("neili", max_att_level / 20);
    set("max_neili", max_att_level / 20);

    if (skill_level > 250) {
        skill_level = 250;
    }

    foreach (string skill in keys(query_skills())) {
        set_skill(skill, skill_level);
    }
}

void die()
{
    object killer = query_last_damage_from();
    object *team;
    
    if (playerp(killer) && killer->is_team_leader())
    {
        team = killer->query_team();
        message_vision(HIY "\n$N" HIY "大笑三声：" HIW "不错不错！你们师徒配合默契，武学造诣已有所成！\n" NOR, this_object());
        message_vision(HIY "$N" HIY "手指轻轻一点，一道金光飞向空中，化作无数金色光点洒落在众人身上。\n" NOR, this_object());
        message_vision(HIY "$N" HIY "含笑道：" HIW "此乃圣贤堂赐予你们的奖励，好好修炼！" NOR "\n\n", this_object());
        
        foreach (object member in team)
        {
            if (member && environment(member) == environment(this_object()))
            {
                tell_object(member, HIG "你感觉一股暖流流遍全身，似乎可以可以结束历练了！\n" NOR);
            }
        }
    }
    
    ::die();
}