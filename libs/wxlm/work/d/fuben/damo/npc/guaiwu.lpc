// NPC: shouwei_sengren.c

inherit NPC;
void set_guard_skills_and_attributes(int player_neigong_level);



void create()
{
    string *titles = ({
        "玄甲神卫", "符箓剑客", "幽冥护法", "七煞镇守", "黑莲使者", "血影刀客", "无相金刚"
    });
    
    string chosen_title = titles[random(sizeof(titles))];
    set_name(chosen_title, ({ "shouwei", "guard" }));
    set("gender", "男性");
    set("age", 35 + random(500));
    set("long", "这是一个大漠神秘黑塔的" + chosen_title + "，全身覆盖着古老的黑色符文铠甲，\n"
               "双眼闪烁着诡异的蓝色光芒。他手持的武器似乎蕴含着神秘的力量，\n"
               "每走一步都会在地面留下短暂的符文光痕。\n");

    set("attitude", "aggressive");
    set("class", "fighter");

    set("shen_type", -1);
    set("str", 37 + random(10));
    set("int", 42 + random(10));
    set("con", 41 + random(10));
    set("dex", 36 + random(10));

	set("qi", 5200);
	set("max_qi", 5200);
	set("jing", 2700);
	set("max_jing", 2700);
	set("neili", 7000);
	set("max_neili", 7000);
	set("jiali", 120);
	set("combat_exp", 2500000);
	set("score", 50000);

	set_skill("force", 270);
	set_skill("jiaohua-neigong", 250);
	set_skill("huntian-qigong", 270);
	set_skill("unarmed", 230);
	set_skill("changquan", 230);
	set_skill("dodge", 240);
	set_skill("xiaoyaoyou", 240);
	set_skill("feiyan-zoubi", 240);
	set_skill("parry", 250);
	set_skill("staff", 270);
	set_skill("strike", 270);
	set_skill("dragon-strike", 270);
	set_skill("jiaohua-bangfa", 250);
	set_skill("dagou-bang", 270);
	set_skill("throwing", 220);
	set_skill("mantianhuayu-zhen", 220);
	set_skill("begging", 200);
	set_skill("checking", 200);
	set_skill("training", 180);
	map_skill("throwing", "mantianhuayu-zhen");
	map_skill("force", "huntian-qigong");
	map_skill("unarmed", "changquan");
	map_skill("dodge", "feiyan-zoubi");
	map_skill("parry", "changquan");
	map_skill("staff", "dagou-bang");
	map_skill("strike", "dragon-strike");

	prepare_skill("strike", "dragon-strike");

	set("chat_chance_combat", 120);
	set("chat_msg_combat", ({
		(: perform_action, "strike.leiting" :),
		(: perform_action, "strike.xiang" :),
		(: exert_function, "recover" :),
		(: exert_function, "powerup" :),
		(: command("say 狂妄小儿，擅闯黑塔，今日便叫你形神俱灭！") :),
		(: command("say 吾乃黑塔守卫，千年不灭，万劫不朽，岂容尔等凡人亵渎！") :),
		(: command("say 黑塔之内，自有天地，进得来，出不去，葬汝骨，炼汝魂！") :),
		(: command("say 多少英雄豪杰，皆葬身于此，你又有何能耐？") :),
		(: command("say 天堂有路你不走，地狱无门偏要闯，受死吧！") :),
	}));

	set_temp("apply/attack", 150);
	set_temp("apply/defense", 150);
	set_temp("apply/damage", 100);
	set_temp("apply/unarmed_damage", 1000);
	set_temp("apply/armor", 500);

	setup();
}

void init()
{
    object player = this_player();
    int player_neigong_level = player->query_skill("force", 1) / 10 * 7;
    if (playerp(player))
        set_guard_skills_and_attributes(player_neigong_level);
        
    // 黑塔守卫会主动攻击玩家
    if (playerp(player) && 
        environment() && 
        !environment()->query("no_fight") && 
        random(3) == 0) {
        remove_call_out("kill_player");
        call_out("kill_player", 1, player);
    }
}

void set_guard_skills_and_attributes(int player_neigong_level)
{
    int skill_level = (player_neigong_level) + 50;
    int max_skill_level = player_neigong_level * 100;
    if (skill_level < 200) {
        skill_level = 200;
    }

    set("qi", max_skill_level);
    set("eff_qi", max_skill_level);
    set("jing", max_skill_level);
    set("eff_jing", max_skill_level);
    set("max_qi", max_skill_level);
    set("max_jing", max_skill_level);
    set("neili", max_skill_level / 10);
    set("max_neili", max_skill_level / 10);

    foreach (string skill in keys(query_skills())) {
        set_skill(skill, skill_level);
    }
}

void kill_ob(object player)
{
    if (!player || environment(player) != environment())
        return;
        
    message_vision("$N发出一声低沉的嘶吼，手中武器闪烁着诡异的光芒，朝$n发起了攻击！\n", 
                  this_object(), player);
    ::kill_ob(player);
}

// 昏迷自动死亡
varargs void unconcious(object player)
{
	if (objectp(player))
	{
		die(player);
	}
	else
	{
		die();
	}
}

varargs void die(object player)
{
	object me, who, gift;
	mixed other_ob;
	
	me = this_object();
	who = environment(this_object())->query("player");

	if (!objectp(who))
	{
		if (undefinedp(player) || !objectp(player))
		{
			who = me->query_last_damage_from();
		}
		else
		{
			who = player;
		}

	}


	if (!objectp(who))
	{
		::die();
		return;
	}

	if (other_ob = AUTO_QUEST->is_not_player(me))
	{
		AUTO_QUEST->auto_cmd(who,"kill " +other_ob->query("id"));
	}
	else
	{
		AUTO_QUEST->auto_cmd(who,"north");
	}

	if (!objectp(who))
	{
		::die();
		return;
	}
	
	if (!playerp(who))
	{
	    ::die();
	}
	else
	{
		message_vision("$N身体中的符文光芒闪烁几下后逐渐暗淡，随后化作一团黑雾消散在空气中。\n", this_object());
		
		gift = new_bind("/clone/vip/qianghua_shi");
		gift->set_amount(2);
		gift->move(who);
		tell_object(who, HIY "你击败了" + query("name") + "，获得了" + HIR "2颗强化石" + NOR "。\n");
		
		// 随机掉落额外奖励
		if (random(10) == 0) {
			object extra_gift;
			string *possible_gifts = ({
				"/clone/vip/dijibao_hufu",
				"/clone/vip/qianghua_shi",
			});
			
			extra_gift = new_bind(possible_gifts[random(sizeof(possible_gifts))]);
			if (extra_gift->move(who)) {
				tell_object(who, HIM "你从" + query("name") + "的残骸中发现了一个珍贵物品：" 
					+ extra_gift->query("name") + NOR "！\n");
			}
		}
    	::die();
		return;
	}
	
	::die();
}