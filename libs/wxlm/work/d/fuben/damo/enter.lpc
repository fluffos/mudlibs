// Room: neidian.c

inherit ROOM;
int do_interact(string arg);

void create()
{
    set("short", "神秘黑塔");
    set("long", @LONG
这里是屹立于大漠深处的神秘黑塔，四周弥漫着诡异的暗淡光芒。古老的黑色石壁
上刻满了无人能解的奇异符文，空气中弥漫着一股远古的气息。塔内寂静无声，仿
佛隐藏着无数不为人知的秘密。
LONG
    );
    set("exits", ([
        "north" : file_name(this_object()),
    ]));
    set("number", 1 + random(20));//地图数量 随机1-20个
    set("objects", ([
        __DIR__"npc/guaiwu": 1 + random(2),//随机1-2个怪物
    ]));
    setup();
}

int valid_leave(object me, string dir)
{
    object *inv;
    int i;
    int random_number;
    object other_ob;
    random_number = 1 + random(2);

    if (dir == "north")
    {

        inv = all_inventory(environment(me));
        for (i = 0; i < sizeof(inv); i++)
        {
            if (inv[i]->query("id") == "shouwei")
            {
                return notify_fail("你必须击败所有黑塔守卫才能继续前进，邪恶的气息阻挡了你的去路。\n");
            }
        }

        //重写生成1-20个地图
        if (query("number_use") >= 20 || query("number_use") >= query("number"))
        {
            return notify_fail("前面一片漆黑，无法继续向北行走（已经达到本次副本可以前进的上限）。\n");
        }

        add("number_use", 1);

        //重新生成1-2个怪物
        while (random_number--)
        {
            new(__DIR__"npc/guaiwu")->move(environment(me));
        }

        // 重新设定short，目前是大漠黑塔xx层
        set("short", "神秘黑塔·"+chinese_number(query("number_use"))+"层");
        set("long", "这里是大漠深处的神秘黑塔第"+chinese_number(query("number_use"))+"层。幽暗的环境中透着诡异的光芒，"
            "石壁上的符文随着层数的上升愈发清晰可见。空气中弥漫着一股远古气息，仿佛暗示着上层的危险与机遇。\n");

        if (query("number_use") == query("number"))
        {
            set("short", "神秘黑塔·顶层");
            set("long", "这里是大漠神秘黑塔的最顶层。经过层层考验，你终于到达了这个充满神秘气息的至高点。"
                "四周墙壁上的符文在此刻闪烁着耀眼的光芒，似乎在诉说着某种古老的秘密。站在这里，你感受到一股强大"
                "的能量波动，预示着最终挑战的来临。\n");
            me->force_me("look");
            delete("exits");
        }

        if (other_ob = AUTO_QUEST->is_not_player(me))
        {
            AUTO_QUEST->auto_cmd(me,"kill " +other_ob->query("id"));
        }
    }

    return ::valid_leave(me, dir);
}

