// boss_room.c - 葵花秘境深处
#include <room.h>


inherit ROOM;

void create()
{
    set("short", HIM "秘境深处" NOR);
    set("long", @LONG
这里是葵花秘境的最深处，四周的紫雾更加浓郁，几乎化不开。
中央有一处略微空旷的平台，一个身着华丽紫袍的身影背对着你，
散发出令人窒息的压迫感。地上散落着无数细小的绣花针。
LONG);

    // No exits leading out normally, rely on fuben daemon or other mechanisms
    set("exits", ([
        // "south" : __DIR__"enter", // Can add exit back if needed
    ]));

    // Load the boss
    set("objects", ([
        __DIR__"npc/kuihua_mozun" : 1,
    ]));

    set("no_clean_up", 1); // 副本房间通常不清理
    set("is_fuben_room",1); // 副本房间标记

    setup();
}