// enter.c - 葵花秘境入口
#include <room.h>


inherit ROOM;

void create()
{
    set("short", HIM "秘境入口" NOR);
    set("long", @LONG
这里便是传说中的葵花秘境入口，四周弥漫着一股诡异的紫色雾
气，隐约能看到前方有一条幽深的小径，通往未知的深处。空气中
似乎漂浮着细微的针状物，让人不寒而栗。
LONG);

    set("exits", ([
        "north" : __DIR__"boss_room",
    ]));

    set("no_clean_up", 1); // 副本房间通常不清理
    set("no_fight", 1);    // 入口通常不允许战斗
    set("is_fuben_room",1); // 副本房间标记

    setup();
}

// 可以在这里添加其他逻辑，例如进入限制、提示等 