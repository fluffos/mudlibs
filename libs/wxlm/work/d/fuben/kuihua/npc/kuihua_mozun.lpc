inherit NPC;

void create()
{
	set_name(HIM "葵花魔尊" NOR, ({ "kuihua mozun", "kuihua", "mozun" }) );
	set("long", @LONG
此人脸型瘦削，脸色苍白，眼神阴鸷，身着一袭华贵的紫色长袍。
他便是葵花秘境的主宰——葵花魔尊，据说其武功已臻化境，
尤其是身法，快如鬼魅，无人能及。
LONG);
    set("title", HIR "秘境主宰" NOR);
	set("gender", "无性"); // Changed gender
	set("age", 99);
	set("attitude", "aggressive"); // Boss attitude
	set("str", 40); // Slightly increased stats for a boss
	set("int", 40);
	set("con", 40);
	set("dex", 50); // High dexterity

    // Significantly increased combat stats for a boss
	set("max_qi", 500000);
    set("eff_qi", 500000);
    set("qi", 500000);
	set("max_jing", 250000);
    set("eff_jing", 250000);
    set("jing", 250000);
	set("neili", 60000);
	set("max_neili", 60000);
	set("jiali", 300); // High jiali

	set("combat_exp", 800000000); // High combat exp

    // High level skills based on kuihua.c
	set_skill("unarmed", 700);
	set_skill("finger", 700);
	set_skill("parry", 700);
	set_skill("dodge", 700); // Exceptional dodge
	set_skill("force", 700);
	set_skill("xinfa", 700); // Use xinfa as base for kuihua-mogong
	set_skill("sword", 700);
	set_skill("kuihua-mogong", 700);
	set_skill("literate", 300);
    set_skill("martial-cognize",500); //武学修养

    // Map skills
	map_skill("force", "kuihua-mogong");
    map_skill("xinfa", "kuihua-mogong");
	map_skill("dodge", "kuihua-mogong");
	map_skill("parry", "kuihua-mogong");
    map_skill("sword", "kuihua-mogong");
    map_skill("unarmed", "kuihua-mogong"); // Assuming it covers unarmed
    map_skill("finger", "kuihua-mogong");

	set("chat_chance_combat", 120); // High chat chance during combat
    set("chat_msg_combat", ({
        (: perform_action, "sword.ci" :), // Example perform
        (: perform_action, "sword.bi" :),
        (: exert_function, "recover" :),
        (: exert_function, "powerup" :),
        HIM "葵花魔尊身形如同鬼魅般闪烁不定，让人难以捕捉！\n" NOR,
        HIM "葵花魔尊尖声笑道：凭你也想挑战本尊？\n" NOR,
    }));

	setup();

    // Equip weapon (e.g., needle or sword)
	carry_object("/clone/cloth/cloth")->wear();
	carry_object("/clone/misc/spin")->wield();
}

void init()
{
    object ob = this_player();
    ::init();
    if (interactive(ob) && !is_fighting()) {
        remove_call_out("greeting");
        call_out("greeting", 1, ob);
    }
}

void greeting(object ob)
{
    if (!ob || environment(ob) != environment())
        return;
    command("hmmph");
    command("say 擅闯秘境者，死！");
    kill_ob(ob);
}

int accept_fight(object ob)
{
    command("say 好，既然你找死，本尊就成全你！");
    kill_ob(ob);
    return 1;
}

int accept_kill(object ob)
{
    command("hehe");
    command("say 不自量力！");
    return 1;
}

void die(object player)
{
    object ob,killer;
    string msg;

    msg = HIR "$N" HIR "发出一声凄厉的惨叫，化作一道紫烟消散了。" NOR;


    
	if (!objectp(player))
	{
		if (undefinedp(player) || !objectp(player))
		{
			killer = player->query_last_damage_from();
		}
	}
    else
    {
        killer = player;
    }


	if (!objectp(killer))
	{
		::die();
		return;
	}

    // Drop treasure
    ob = new_bind("/clone/baoxiang/kuihua-baozang");
    if (objectp(ob) && objectp(killer))
    {
        ob->move(killer);
        msg += HIM "\n$N似乎留下了一个宝箱！" NOR;
    }

    message_vision(msg + "\n", this_object(), killer);
    // Add exp/potential rewards to killer or team members here if needed
    if (objectp(killer))
    {
        int exp = 60000 + random(20000);
        int pot = 30000 + random(10000);
         // 根据说明增加大量经验潜能
        // killer->add("combat_exp", exp);
        FUBEN_D->add_exp(killer, exp);
        killer->add("potential", pot);
        tell_object(killer, HIG "你击败了葵花魔尊，获得了大量经验（" + exp +"）和潜能(" +  pot +  ")！\n" NOR);
    }

    ::die();
}

void unconcious()
{
    // Boss generally doesn't go unconcious, they die
    die(query_last_damage_from());
}

// Override master/apprentice related functions if they exist in inherited files
void attempt_apprentice(object ob) {
    command("say 滚开！本尊不收徒！");
    return;
}

int recognize_apprentice(object me, string skill)
{
    command("say 滚！");
    return -1;
} 