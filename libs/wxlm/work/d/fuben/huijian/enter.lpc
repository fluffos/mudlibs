/**
    * @brief 挥剑求道副本入口
    * @details 玩家进入挥剑求道副本的第一个房间
    */

#include <room.h>

inherit ROOM;

void create()
{
    set("short", HIY "剑道入口" NOR);
    set("long", @LONG
这里是一处空旷的山谷，四周群山环绕，山壁上刻满了各种剑招的
痕迹。阵阵剑气在空中流转，似乎在诉说着无数剑客曾在此处挥剑
问道的往事。远处的山峰上，隐约可见一座古老的练武台。
LONG);

    set("exits", ([
        "north" : __DIR__"boss_room",
    ]));

    set("no_clean_up", 1); // 副本房间通常不清理
    set("no_fight", 1);    // 入口通常不允许战斗
    set("is_fuben_room", 1); // 副本房间标记

    // 可选：添加一些剑道相关的物品描述
    set("item_desc", ([
        "山壁" : "山壁上刻满了各种剑招，有的深入石中三分，显然是顶级剑客所留。",
        "剑痕" : "这些剑痕纵横交错，蕴含着深奥的剑理，让人不禁沉思。",
        "练武台" : "远处的练武台若隐若现，似乎在等待着真正的剑道传人。",
    ]));

    // 动作列表
    set("action_list", ([
        "调息运气" : "meditate"
    ]));

    setup();
}

/**
    * @brief 初始化函数
    * @details 添加玩家进入时的提示信息
    */
void init()
{
    add_action("do_meditate", "meditate");
    add_action("do_meditate", "meditation");
}

/**
    * @brief 冥想动作
    * @param string arg 参数
    * @return int 执行结果
    * @details 在入口处冥想可以恢复部分精神和内力
    */
int do_meditate(string arg)
{
    object me = this_player();

    if (!me) return 0;

    if (me->is_busy()) {
        notify_fail("你现在正忙着其他事情。\n");
        return 0;
    }

    if (me->is_fighting()) {
        notify_fail("战斗中无法冥想。\n");
        return 0;
    }

    if (me->query_temp("meditated_here")) {
        notify_fail("你已经在这里冥想过了。\n");
        return 0;
    }

    message_vision("$N盘腿而坐，开始冥想剑道真谛。\n", me);

    me->set_busy(3);
    call_out("finish_meditation", 3, me);

    return 1;
}

/**
    * @brief 完成冥想
    * @param object me 玩家对象
    * @details 冥想完成后的效果
    */
void finish_meditation(object me)
{
    if (!me || environment(me) != this_object()) return;

    me->set_temp("meditated_here", 1);

    // 恢复部分精神和内力
    me->add("jing", me->query("max_jing") / 10);
    me->add("neili", me->query("max_neili") / 10);

    if (me->query("jing") > me->query("max_jing"))
        me->set("jing", me->query("max_jing"));
    if (me->query("neili") > me->query("max_neili"))
        me->set("neili", me->query("max_neili"));

    message_vision(HIY "$N缓缓睁开双眼，精神似乎好了一些。\n" NOR, me);
    tell_object(me, HIG "通过冥想，你恢复了一些精神和内力。\n" NOR);
}