/**
    * @brief 巅峰杨改之Boss NPC
    * @details 挥剑求道副本的终极BOSS，使用动态NPC系统生成10000战力的古墓派高手
    */

inherit NPC;

void create()
{
    set_name(HIR "巅峰杨改之" NOR, ({ "dianfeng yang guo", "yang guo", "yang", "boss" }));
    set("long", @LONG
他已经达到了武学的巅峰境界，眉目之间虽然还有一丝哀伤，但更多
的是对武道的彻悟。左袖空荡荡的，但这丝毫不影响他那浑然天成的
气势。整个人仿佛与天地融为一体，举手投足间蕴含着无尽的威能。
LONG);

    set("title", HIY "武道巅峰" NOR);
    set("gender", "男性");
    set("age", 26);
    set("attitude", "aggressive");

    // 大幅强化的属性
    set("str", 50);
    set("int", 50);
    set("con", 50);
    set("dex", 45);

    // 巅峰血量500万，精神200万，技能等级1200
    set("max_qi", 5000000);
    set("eff_qi", 5000000);
    set("qi", 5000000);
    set("max_jing", 2000000);
    set("eff_jing", 2000000);
    set("jing", 2000000);
    set("max_neili", 150000);
    set("neili", 150000);
    set("jiali", 300);

    set("skill_aoyi/黯然隐雾",15);

    set("combat_exp", 100000000); // 巨额经验

    // 1200级技能
    set_skill("force", 1200);
    set_skill("yunv-xinfa", 1200);
    set_skill("surge-force", 1200);
    set_skill("sword", 1200);
    set_skill("yunv-jian", 1200);
    set_skill("quanzhen-jian", 1200);
    set_skill("xuantie-jian", 1200);
    set_skill("dodge", 1200);
    set_skill("yunv-shenfa", 1200);
    set_skill("parry", 1200);
    set_skill("unarmed", 1200);
    set_skill("meinv-quan", 1200);
    set_skill("strike", 1200);
    set_skill("sad-strike", 1200);
    set_skill("fireice-strike", 1200);
    set_skill("tianluo-diwang", 1200);
    set_skill("literate", 500);
    set_skill("taoism", 300);
    set_skill("medical", 500);
    set_skill("yunv-xinjing", 1200);
    set_skill("throwing", 1200);
    set_skill("yufeng-zhen", 1200);
    set_skill("zuoyou-hubo", 500);
    set("skill_aoyi/血海翻腾",15);

    map_skill("force", "surge-force");
    map_skill("sword", "xuantie-jian");
    map_skill("dodge", "yunv-shenfa");
    map_skill("parry", "meinv-quan");
    map_skill("unarmed", "sad-strike");
    map_skill("strike", "tianluo-diwang");
    map_skill("throwing", "yufeng-zhen");

    prepare_skill("unarmed", "sad-strike");
    prepare_skill("strike", "tianluo-diwang");

    create_family("古墓派", 1, "巅峰武圣");

    // 超高战斗频率的特殊技能
    set("chat_chance_combat", 150);
    set("chat_msg_combat", ({
        (: perform_action, "strike.wang" :),
        (: perform_action, "sword.juan" :),
        (: force_me, "perform sword.ji twice" :),
        (: exert_function, "shield" :),
        (: exert_function, "powerup" :),
        HIR "巅峰杨改之叹息一声：既然你要以剑问道，那我便以剑回答！\n" NOR,
        HIY "巅峰杨改之身形如鬼魅般闪动，剑招变化莫测！\n" NOR,
        HIM "巅峰杨改之眼中闪过一丝悲伤：龙女，我的剑仍然不够利！\n" NOR,
    }));

    // 超强攻防属性
    set_temp("apply/sword", 1000);
    set_temp("apply/paryy", 1000);
    set_temp("apply/defense", 500);
    set_temp("apply/damage", 2000);
    set_temp("apply/unarmed_damage", 2000);
    set_temp("apply/armor", 10000);
    set_temp("str", 100);
    setup();

    carry_object("/clone/cloth/qingyi")->wear();
    carry_object("/clone/weapon/changjian")->wield();

    // 增加玉蜂针
    new("/d/gumu/obj/yfzhen")->move(this_object());
    set_temp("handing", present("yufeng zhen", this_object()));
}

void init()
{
    object ob = this_player();
    if (interactive(ob) && !is_fighting()) {
        remove_call_out("greeting");
        call_out("greeting", 2, ob);
    }
}

/**
    * @brief 问候函数
    * @param object ob 玩家对象
    * @details Boss出现时的问候语
    */
void greeting(object ob)
{
    if (!ob || environment(ob) != environment())
        return;
    command("sigh");
    command("say 能走到这里，说明你的剑道已有所成。");
    command("say 不过，真正的剑道巅峰，还远得很呢！");
    command("wield sword");
    kill_ob(ob);
}

int accept_fight(object ob)
{
    command("say 既然你要以武证道，那就让我看看你的觉悟！");
    kill_ob(ob);
    return 1;
}

int accept_kill(object ob)
{
    command("say 哈哈哈哈！来吧！");
    return 1;
}

/**
    * @brief 死亡函数
    * @param object player 击杀者
    * @details 处理Boss死亡后的奖励发放
    */
void die(object player)
{
    object ob, killer;
    string msg;

    msg = HIR "$N" HIR "缓缓倒下，眼中却露出了一丝解脱的笑意。" NOR;

    if (!objectp(player))
    {
        if (undefinedp(player) || !objectp(player))
        {
            killer = query_last_damage_from();
        }
    }
    else
    {
        killer = player;
    }

    if (!objectp(killer))
    {
        ::die();
        return;
    }

    // 掉落五脏材料自选箱
    ob = new_bind("/clone/box/wuzang/wuzang_zixuan_box");
    if (objectp(ob) && objectp(killer))
    {
        ob->move(killer);
        msg += HIM "\n$N留下了一个神秘的宝箱（五脏材料自选箱）！" NOR;
    }

    message_vision(msg + "\n", this_object(), killer);

    // 给予100万经验，50万潜能的奖励
    if (objectp(killer))
    {
        int exp = 1000000; // 100万经验
        int pot = 500000;  // 50万潜能

        FUBEN_D->add_exp(killer, exp);
        killer->add("potential", pot);
        tell_object(killer, HIY "你战胜了巅峰杨改之，在剑道上有了巨大的突破！\n" NOR);
        tell_object(killer, HIG "你获得了" + exp + "点经验和" + pot + "点潜能！\n" NOR);
    }

    ::die();
}

void unconcious()
{
    // Boss通常不会昏迷，直接死亡
    die(query_last_damage_from());
}

// 禁止收徒
void attempt_apprentice(object ob)
{
    command("say 武道之路，只能靠自己领悟。");
    return;
}

int recognize_apprentice(object me, string skill)
{
    command("say 去吧，自己去领悟真正的剑道。");
    return -1;
}

void heart_beat()
{
    string msg;
    if (!this_object()->query_temp("weapon"))
    {
        carry_object("/clone/weapon/changjian")->wield();
    }

    if ((query("qi") < query("max_qi") / 2 || query("eff_qi") < query("max_qi") / 2) && random(3) == 1)
    {
        // 当气血低于50%时,恢复1%的气血
        add("qi", query("max_qi") / 100);
        add("eff_qi", query("max_qi") / 100);
        msg = HIC "$N" HBMAG "周身泛起淡淡金光，一股怒海真气涌遍全身，伤势以肉眼可见的速度恢复！"NOR"\n";
        message_vision(msg, this_object());
    }

    ::heart_beat();
}