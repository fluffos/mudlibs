// cutable.c

#include <dbase.h>

// 定义部位属性数组的索引宏，方便访问和维护
#define LEVEL	   0 // 部位层级
#define UNIT	    1 // 部位单位
#define NAME	    2 // 部位名称
#define NAME_LEFT       3 // 切割后留下的部位名称
#define ID_LEFT	 4 // 切割后留下的部位ID
#define ASS_PART	5 // 关联部位映射
#define VERB	    6 // 切割动作的动词
#define CLONE	   7 // 切割后克隆出的对象文件路径

// 定义关联部位处理的标志宏
#define NOT_INCLUDE_THIS_PART   0 // 不包含当前部位本身
#define INCLUDE_THIS_PART       1 // 包含当前部位本身

/**
 * @brief 检查对象是否可被切割
 * @return int 总是返回1，表明该对象支持被切割的特性
 */
int is_cutable() { return 1; }

void include_part(object ob, string id, mixed *in_part, int include_this_part);

/**
 * @brief 查询明确排除在外的部位
 * @return string* 返回一个字符串数组，包含不能被切割的部位ID
 * @details 用于定义一些即使在parts中定义了，也绝不允许被切割的部位。
 */
string *query_exclude_part() { return ({ }); }

/**
 * @brief 执行切割动作
 * @param object me 执行切割动作的玩家对象
 * @param string arg 玩家输入的参数，即要切割的部位ID
 * @return int 成功返回1，失败返回0并提示错误信息
 * @details 这是实现"切割"功能的核心函数，包含了所有逻辑：
 *          1. 参数解析：处理`cut <部位> from <对象>`的命令。
 *          2. 查询功能：当`arg`为`?`时，列出所有可切割的部位。
 *          3. 条件检查：检查部位是否存在、是否已被切割、是否被禁止切割。
 *          4. 动作判断：根据玩家使用的武器或内力，判断是否能进行切割，并显示不同信息。
 *          5. 部位生成：成功切割后，克隆一个新的对象代表被切下的部位，并设置其属性。
 *          6. 状态更新：将被切割的部位记录到原对象的`been_cut`属性中。
 *          7. 关联处理：调用`include_part`处理与被切割部位相关的其他部位。
 */
int do_cut(object me, string arg)
{
	string *exist;
	string *cut;
	mapping parts;
	mixed *part;
	string default_clone;
	string msg;
	object weapon;
	object ob;

	if (! arg)
		return notify_fail("你要取下什么部位？\n");

	if (! mapp(parts = query("parts")))
		return notify_fail("看来你是取不下来什么东西了。\n");

	exist = keys(parts);
	exist -= query_exclude_part();
	cut = query("been_cut");
	if (! cut) cut = ({ });

	if (arg == "?")
	{
		int i;
		int count;
		count = 0;
		msg = ZJOBLONG+this_object()->name() + "有以下部位可以取下来：\n";
		if(sizeof(exist)>0)
			msg += ZJOBACTS2+ZJMENUF(3,3,8,33);
		for (i = 0; i < sizeof(exist); i++)
		{
			if (member_array(exist[i], cut) != -1 || query("no_cut/" + exist[i]))
				continue;
			count++;
			msg += sprintf("%s"ZJBR"%s:cut %s from %s",parts[exist[i]][NAME], exist[i], exist[i], this_object()->query("id"))+ZJSEP;
		}
		if (! count)
			msg = ZJOBLONG+this_object()->name() + "已经没什么可以下刀的地方了。";
		write(msg+"\n");
		return 1;
	}

	part = parts[arg];
	if (! arrayp(part))
		return notify_fail("你怎么也找不到你想取的部位。\n");

	if (member_array(arg, cut) != -1)
		return notify_fail(part[NAME] + "已经被取走了。\n");

	if (msg = query("no_cut/" + arg))
		return notify_fail(msg ? msg : "这样东西你取不下来。\n");

	default_clone = query("default_clone");
	if (weapon = me->query_temp("weapon"))
	{
		switch (weapon->query("skill_type"))
		{
		case "pin" :
			return notify_fail(weapon->name() + "好像只能用来扎个小眼。\n");
		case "hammer" :
			return notify_fail(weapon->name() + "好像只能用来砸烂东西。\n");
		case "staff" :
			return notify_fail(weapon->name() + "好像只能用来打打屁股。\n");
		case "club" :
			return notify_fail(weapon->name() + "好像只能用来敲敲脑袋。\n");
		case "throwing" :
			return notify_fail("用" + weapon->name() + "取东西？不太好吧。\n");
		case "whip":
			return notify_fail(weapon->name() + "这东西用来洗衣服倒也不错，取东西好像差点。\n");
		}
		msg = "$N举起手中的" + weapon->name() + "，“喀嚓”一下子把$n的" +
		      part[NAME] + "给" + (stringp(part[VERB]) ? part[VERB] : "取了下") +
		      "来。\n";
	} else
	if (me->query_skill("force") < 90)
	{
		message_vision("$N举起手来，对着$n的" + part[NAME] + "一掌"
			       "砍了下去，结果被震的“哇哇”怪叫了两声。\n",
			       me, this_object());
		write("好好练练内功再来吧！\n");
		return 1;
	} else
		msg = "$N举起手来，一下子就把$n的" + part[NAME] + "给" +
		      (stringp(part[VERB]) ? part[VERB] : "取了下") + "来。\n";

	message_vision(msg, me, this_object());
	ob = new(stringp(part[CLONE]) ? part[CLONE] : default_clone);
	ob->set_name(stringp(part[NAME_LEFT]) ? part[NAME_LEFT] : part[NAME],
		     ({ stringp(part[ID_LEFT]) ? part[ID_LEFT] : arg }));
	ob->set("unit", part[UNIT]);
	ob->set("long", "一" + part[UNIT] + "被人取下来的" + ob->name() + "。\n");
	ob->set("default_clone", default_clone);
	ob->set("main_part_level", part[LEVEL] + 1);
	if (ob->is_cutable())
		ob->set("been_cut", ({ }));
	ob->set_from(this_object());
	ob->move(environment());

	// seperate the part cut
	cut += ({ arg });
	set("been_cut", cut);

	// seperate the association part
	include_part(ob, arg, 0, NOT_INCLUDE_THIS_PART);
	return 1;
}

/**
 * @brief 生成关于已切割部位的额外描述
 * @return string 返回描述哪些部位不见了的字符串
 * @details 检查对象`been_cut`属性，如果发现有部位被切割，
 *          则生成一句"不过它的<部位1>、<部位2>已经不见了。"的描述。
 *          此函数返回的字符串通常被添加到对象的长描述(long)中，
 *          让玩家能直观地看到对象的状态变化。
 */
string extra_desc()
{
	string msg;
	string *cut;
	mixed *part;
	int flag;
	int i;

	msg = "";
	if (! arrayp(cut = query("been_cut")))
		return msg;
	flag = 0;
	for (i = 0; i < sizeof(cut); i++)
	{
		part = query("parts/" + cut[i]);
		if (part[LEVEL] > query("main_part_level"))
			continue;
		if (! flag)
		{
			msg += "不过它的" + part[NAME];
			flag++;
		} else
			msg += "、" + part[NAME];
	}
	if (flag) msg += "已经不见了。\n";
	return msg;
}

/**
 * @brief 递归处理被切割部位的关联部位
 * @param object ob 新生成的、被切割下来的对象
 * @param string id 当前正在处理的部位ID
 * @param mixed* in_part 来源部位的定义数组
 * @param int include_this_part 标志位，决定是否将当前部位也包含到新对象中
 * @details 这是实现复杂组合物品分离的核心。当一个部位被切下后，此函数
 *          负责将其"子部位"或关联部位的定义从原对象转移到新对象上。
 *          例如：切下"大腿"后，需要将"小腿"、"脚"等部位的定义也附加到
 *          新生成的"大腿"对象上，使"大腿"本身也成为一个可被继续切割的物品。
 *          这是一个递归过程，会一直处理到没有关联部位为止。
 */
void include_part(object ob, string id, mixed *in_part, int include_this_part)
{
	string *cut;
	string *ass;
	mixed  *srcpart;
	mixed  *part;
	string new_id;
	mapping assmap;
	int i;

	srcpart = query("parts/" + id);
	if (! arrayp(srcpart))
		return;
	part = allocate(sizeof(srcpart));
	for (i = 0; i < sizeof(srcpart); i++)
		part[i] = srcpart[i];
	part[ASS_PART] = allocate_mapping(sizeof(srcpart[ASS_PART]));
	if (include_this_part)
	{
		part[NAME] = part[NAME_LEFT];
		new_id = in_part[ASS_PART][id];
		ob->set("parts/" + new_id, part);
		if (member_array(id, cut = query("been_cut")) != -1)
			ob->set("been_cut", ob->query("been_cut") + ({ new_id }));
		set("been_cut", cut + ({ id }));
	}

	if (mapp(assmap = srcpart[ASS_PART]))
	{
		// set the association part
		ass = keys(assmap);
		for (i = 0; i < sizeof(ass); i++)
		{
			include_part(ob, ass[i], srcpart, INCLUDE_THIS_PART);
			new_id = assmap[ass[i]];
			part[ASS_PART][new_id] = new_id;
			if (query("no_cut/" + ass[i]))
				ob->set("no_cut/" + new_id, query("no_cut/" + ass[i]));
		}
	}
}
