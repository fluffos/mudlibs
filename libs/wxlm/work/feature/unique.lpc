/**
 * @brief 检测当前对象是否存在多个克隆实例
 * @return int 返回1表示存在多个克隆实例，返回0表示仅有一个或无克隆实例
 * @details 设计该检测机制是为了防止对象克隆过程中出现状态竞争问题。当对象被克隆后，所有子对象都会继承主对象的克隆属性。通过过滤所有子对象中的克隆实例，可以及时确认克隆是否失控。若存在多个克隆，后续的绑定操作或状态更新可能因对象引用混乱导致不可预测行为，因此需在此处进行预防性检查
 */
nomask int violate_unique()
{
	object *ob;

	if( !clonep(this_object()) ) return 0;

	// Find all the cloned instance of this_object()
	ob = filter_array( children(base_name(this_object())), (: clonep :) );

	return sizeof(ob) > 1;
}

/**
 * @brief 创建基于属性值的物品复制品
 * @return object 生成的复制品对象或0
 * @details 该函数通过检查当前对象的replica_ob属性来创建复制品对象，执行后自动销毁自身。这种设计确保复制品与原对象不存在引用循环，适用于需要独立存在的物品克隆场景。
 * @note 为什么需要自毁：销毁原对象可避免复制品与原对象之间产生双向引用，防止程序内存泄漏。通过属性检查机制，确保复制品的创建依赖于明确配置的replica_ob属性值。
 */
object create_replica()
{
	string replica;
	object obj;

	seteuid(getuid());
	if( stringp(replica = this_object()->query("replica_ob")) )
		obj = new(replica);
	else
		obj = 0;
	destruct(this_object());
	return obj;
}
     			 
