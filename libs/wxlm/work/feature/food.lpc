/**
 * @file food.c
 * @author Lu dexiang
 * @brief 游戏中的食物功能模块
 * @date 2023-01-01
 * @details 提供食物相关的功能，包括食物效果的添加、清除、查询和执行
 */

#include <dbase.h>
#include <name.h>

/**
 * @brief 存储食物效果的变量，可以是单个函数或函数数组
 */
mixed func = 0;

/**
 * @brief 为食物添加效果
 * @param f 要添加的效果函数
 * @details 如果当前没有效果，直接赋值；如果已有一个效果，转换为数组；
 *          如果已有多个效果（数组形式），则添加到数组中，最多支持12个效果
 */
void apply_effect(function f)
{
	if (! func)
		func = f;
	else
	if (functionp(func))
		func = ({ func, f });
	else
	if (sizeof(func) < 12)
		func += ({ f });
}

/**
 * @brief 清除食物的所有效果
 * @details 将效果变量重置为0
 */
void clear_effect()
{
	func = 0;
}

/**
 * @brief 查询食物当前的效果
 * @return mixed 返回当前设置的效果（函数或函数数组）
 */
mixed query_effect()
{
	return func;
}

/**
 * @brief 执行食物的效果
 * @details 如果效果是单个函数，直接执行；
 *          如果效果是函数数组，则依次执行数组中的每个函数
 */
mixed do_effect()
{
	int i;

	if (functionp(func))
		evaluate(func);
	if (arrayp(func))
		for (i = 0; i < sizeof(func); i++)
			evaluate(func[i]);
}
