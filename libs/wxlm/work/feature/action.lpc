/**
 * @brief 角色行动控制模块
 * @file action.c
 * @author Lu dexiang
 * @date 未知
 * @details 该模块负责处理角色的忙乱状态、行动中断和函数重载等功能
 */

// 全局变量声明
/** @brief 忙乱状态变量，可以是整数或函数指针 */
nosave mixed busy;
/** @brief 中断处理变量，可以是整数或函数指针 */
nosave mixed interrupt;
/** @brief 函数重载映射表 */
nosave mapping override;
/** @brief 函数重载调用对象映射表 */
nosave mapping override_call_obj;
varargs void interrupt_me(object who, mixed how);
/**
 * @brief 增加忙乱时间
 * @param int new_busy 要增加的忙乱时间
 * @return void
 * @details 将当前忙乱时间增加指定的值，如果角色性格为"狡黠多变"有几率减少忙乱时间
 */
void add_busy(int new_busy)
{
	if (!intp(new_busy))
		error("action: Invalid busy action type.\n");
	if (intp(busy))
	{
		if (new_busy > 1 && random(10) < 4 && this_object()->query("character") == "狡黠多变")
			new_busy--;
		busy += new_busy;
	}
	set_heart_beat(1);
}


/**
 * @brief 更新玩家的忙乱状态
 * @param int new_busy 新的忙乱值
 * @param object me 玩家对象
 * @return int 更新后的忙乱值
 * @details 该函数根据玩家的宝石效果、经脉等级、角色特性和元素属性等因素综合计算并更新忙乱状态。
 *          忙乱值会根据多种因素被减少，包括宝石和经脉提供的忙乱化解概率、木元素特效、角色特性以及经脉特效。
 *          函数确保忙乱值不会低于1，同时对过高的忙乱值进行衰减处理，以保持游戏平衡性。
 */
int update_busy(int new_busy, object me) {

	//最终忙乱化解概率
	int busy_reduce_probability = 0;
	//宝石减少忙乱的概率值
	int gem_busy_reduce_probability = 0;
	//经脉减少忙乱的概率值
	int meridian_busy_reduce_probability = 0;

	int wood_count = COMBAT_D->get_element_count(me, "木");
    int wood_reduce_percent = 0;

	gem_busy_reduce_probability = me->query_temp("busy_block");
	meridian_busy_reduce_probability = me->query("gain/busy");
	//取两者最大值，3目运算符
	busy_reduce_probability = gem_busy_reduce_probability > meridian_busy_reduce_probability ? gem_busy_reduce_probability : meridian_busy_reduce_probability;

	//最终忙乱化解概率
	busy_reduce_probability = busy_reduce_probability > 100 ? 100 : busy_reduce_probability;
	

    // 限制new_busy的最大值
    if (new_busy > 10) {
        new_busy = 10 + (new_busy - 10) / 2;
    }

    // 基于一定概率减少new_busy
    if (new_busy > 1 && random(10) < 4 && me->query("character") == "狡黠多变") {
        new_busy--;
    }

    // 木元素减少忙乱的逻辑
    if (wood_count >= 12) {
        wood_reduce_percent = 30;
    } else if (wood_count >= 8) {
        wood_reduce_percent = 20;
    } else if (wood_count >= 4) {
        wood_reduce_percent = 8;
    }

    if (wood_reduce_percent > 0) {
        int wood_reduce = new_busy * wood_reduce_percent / 100;
        new_busy -= wood_reduce;
        tell_object(me, HIG"你的木元素特效触发，忙乱减少了" + wood_reduce + "秒"NOR"。\n");
    }

    // 判断忙乱化解概率
	if (random(100) < busy_reduce_probability) {
        int meridian_count = MERIDIAN_D->query_meridian_count(this_object());
        
        // 检查MERIDIAN_D和this_object()的有效性
        if (meridian_count) {
            // 根据经脉数量和概率减少new_busy
			if (random(100) < busy_reduce_probability && random(50) < busy_reduce_probability) 
			{
				int reduce_busy;
				reduce_busy = meridian_count * new_busy / 10;
                new_busy -= reduce_busy;
				tell_object(me, HIR"你的经脉特效触发，忙乱化解了" + reduce_busy + "秒"NOR"。\n");
            }

            // 保证new_busy的最小值为1
            if (new_busy < 1) {
                new_busy = 1;
            }
        }
    }

    return new_busy;
}

/**
 * @brief 设置角色的忙乱状态
 * @param mixed new_busy 忙乱时间或处理函数
 * @param mixed new_interrupt 中断处理时间或函数
 * @return void
 * @details 设置角色的忙乱状态和中断处理方式，可以是固定时间或函数处理
 *          如果是整数类型的忙乱，会通过update_busy函数计算实际忙乱时间
 */
varargs void start_busy(mixed new_busy, mixed new_interrupt)
{
 
	object me;

	if (! new_busy) return;
	if (! intp(new_busy) && ! functionp(new_busy))
		error("action: Invalid busy action type.\n");

	if (! objectp(me = this_object())) return;
	if (intp(new_busy))
	{
		if (functionp(busy))
		{
			//检查玩家是否在战斗中，一般情况下，如果玩家正在进行函数类型的忙乱（如打坐），被突然袭击，可能会造成数字类型的忙乱，此时额外处理
			if (me->is_fighting())
			{
				//执行中断函数
				interrupt_me(me);
				tell_object(me, "你被突然袭击，打断了你目前正在做的事情。\n");
			}
			else
			{
				error("action: busy conflit.\n");
			}
		}

		new_busy = update_busy(new_busy, me);

	}

	if(intp(new_busy)&&intp(busy)&&new_busy<busy);
	else busy = new_busy;
	if (! intp(new_interrupt) && ! functionp(new_interrupt))
		error("action: Invalid busy action interrupt handler type.\n");
	interrupt = new_interrupt;
	set_heart_beat(1);
}

/**
 * @brief 查询当前忙乱状态
 * @return mixed 当前的忙乱状态
 */
nomask mixed query_busy() { return busy; }

/**
 * @brief 检查是否处于忙乱状态
 * @return int 是否忙乱，1为忙乱，0为不忙乱
 */
nomask int is_busy() { return busy != 0; }

/**
 * @brief 继续执行动作
 * @return void
 * @details 在心跳中调用，处理忙乱状态的递减或函数评估
 */
void continue_action()
{
	if (intp(busy) && (busy > 0))
	{
		busy--;
		tell_object(this_object(),"忙乱中。。。"+busy+"\n");
		return;
	} else
	if (functionp(busy))
	{
		if (! evaluate(busy, this_object()))
		{
			busy = 0;
			interrupt = 0;
		}
	} else
	{
		busy = 0;
		interrupt = 0;
	}
}

/**
 * @brief 中断当前角色的动作
 * @param object who 中断发起者
 * @param mixed how 中断方式或减少的忙乱时间
 * @return void
 * @details 根据中断处理方式和当前忙乱状态决定是否中断动作
 */
varargs void interrupt_me(object who, mixed how)
{
	mixed bak;

	bak = busy;
	busy = 0;

	if (! bak) return;

	if (intp(bak) && intp(interrupt))
	{
		if (bak < interrupt)
			return;

		if (intp(how) && how > 0)
		{
			// reduce busy
			bak -= how;
			if (bak < 0) return;
		}
	} else
	if (functionp(interrupt))
	{
		if (evaluate(interrupt, this_object(), who, how))
		{
			bak = 0;
			interrupt = 0;
		}
	} else
	{
		bak = 0;
		interrupt = 0;
	}

	busy = bak;
}

/**
 * @brief 启动延迟调用
 * @param function fun 要调用的函数
 * @param int delay 延迟时间
 * @return int 是否成功启动
 * @details 根据角色权限决定是否绑定函数到当前对象
 */
int start_call_out(function fun, int delay)
{
	if (wiz_level(this_object()) > 0)
		call_out("eval_function", delay, fun);
	else
		call_out("eval_function", delay, bind(fun, this_object()));
	return 1;
}

/**
 * @brief 评估函数
 * @param function fun 要评估的函数
 * @return void
 * @details 安全地评估函数指针，处理Owner被析构的情况
 */
void eval_function(function fun)
{
    mixed err;

    if (!functionp(fun))
    {
        log_file("eval_function_error", sprintf("Invalid function type: %O\n", fun));
        return;
    }

    // 使用catch捕获Owner被析构的错误
    if (err = catch(evaluate(fun)))
    {
        // 记录错误但不抛出异常，避免影响其他功能
        log_file("eval_function_error", sprintf("Function evaluation failed: %s\n", err));
        return;
    }
}

/**
 * @brief 设置函数重载
 * @param string index 函数索引名
 * @param function fun 重载函数
 * @return int 是否成功设置
 * @details 将指定索引的函数绑定到当前对象，并记录调用对象
 */
nomask int set_override(string index, function fun)
{
	if (! override)
		override = ([ ]);

	if (!override_call_obj)
		override_call_obj = ([ ]);

	override[index] = bind(fun, this_object());

	if (objectp(previous_object()))
	{
		override_call_obj[index] = base_name(previous_object());
	}
	else 
	{
		override_call_obj[index] = base_name(this_object());
	}

	return 1;
}

/**
 * @brief 查询重载函数
 * @param string index 函数索引名
 * @return mixed 重载函数或整个重载映射表
 * @details 只有root和admin权限可以调用此函数
 */
nomask mixed query_override(string index)
{
	if (! index) return override;
	if (! override) return 0;
	return override[index];
}

/**
 * @brief 运行重载函数
 * @param string index 函数索引名
 * @return int 重载函数的返回值，0表示继续执行原函数
 * @details 执行指定索引的重载函数，并在执行后删除该重载
 */
nomask int run_override(string index)
{
	function fun;
	mixed call_result,err;
	if (! override || ! functionp(fun = override[index]))
		return 0;

	map_delete(override, index);
	if (! sizeof(override)) override = 0;

	if (err = catch(call_result = (*fun)(this_object())))
	{
		log_file("override_error", sprintf("%s: %s\n", override_call_obj[index], err));
		return 0;
	}

	return call_result;
	// return (*fun)(this_object());
}

/**
 * @brief 删除重载函数
 * @param string index 函数索引名
 * @return void
 * @details 删除指定索引的重载函数
 */
nomask void delete_override(string index)
{
	if (! override) return;
	map_delete(override, index);
	if (! sizeof(override)) override = 0;
}
