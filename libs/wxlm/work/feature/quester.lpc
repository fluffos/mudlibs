int is_quester() { return 1; }

// 接受询问
mixed accept_ask(object who, string topic)
{
	return QUEST_D->accept_ask(this_object(), who, topic);
}

// 请求任务
int ask_quest(object who)
{
	return QUEST_D->ask_quest(this_object(), who);
}

// 接收物品
int accept_object(object who, object ob)
{
	return QUEST_D->accept_object(this_object(), who, ob);
}

// 取消任务
int cancel_quest(object who)
{
	return QUEST_D->cancel_quest(this_object(), who);
}

// 标识为可以被刷新任务管理者系统刷新
int parse_add()
{
	object me = this_object();
	string path = base_name(me);
	mapping me_msg = ([]);

	me_msg["id"] = me->query("id");
	me_msg["path"] = path;
	"adm/special_ob/parse_man_manger"->add_place(base_name(environment(me)), me_msg);
	return 1;
}
// 领取门派挑战令牌
int do_lingqu(string arg)
{
    object me = this_player();
    object ling;

    if (!arg || arg != "挑战令")
        return notify_fail("你要领取什么？\n");

    // 检查玩家是否已经有挑战令
    if (present("menpai tiaozhan ling", me))
    {
        tell_object(me, "你已经有一块门派挑战令了，不能重复领取。\n");
        return 1;
    }

    // 检查玩家是否为本门弟子
    if (!me->query("family") || me->query("family/family_name") != query("family/family_name"))
    {
        tell_object(me, "你不是本派弟子，无法领取门派挑战令。\n");
        return 1;
    }

    // 创建挑战令并给予玩家
    ling = new("/clone/tianshu/menpai_challenge");
    if (ling)
    {
        ling->move(me);
        tell_object(me, this_object()->name() + "递给你一块门派挑战令。\n");
        message_vision("$N从" + this_object()->name() + "那里领取了一块门派挑战令。\n", me);
    }
    else
    {
        tell_object(me, "抱歉，门派挑战令暂时无法领取。\n");
    }
    return 1;
}