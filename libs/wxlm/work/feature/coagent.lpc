/**
 * @brief 协助者功能模块
 * @file coagent.c
 * @author Lu dexiang
 * @date 未知
 * @details 该模块负责处理游戏中的NPC协助战斗功能，允许NPC在其他NPC被攻击时提供帮助
 */

#include <dbase.h>

/** @brief 是否正在协助战斗的标志 */
nosave int helping = 0;

/**
 * @brief 检查对象是否为协助者
 * @return int 是否为协助者，1为是
 */
int is_coagent() { return 1; }

/**
 * @brief 检查对象是否正在协助战斗
 * @return int 是否正在协助，1为是，0为否
 */
int is_helping() { return helping; }

/**
 * @brief 开始协助战斗
 * @param object env 战斗发生的环境
 * @param object helper 被协助的对象
 * @param object ob 攻击者
 * @return int 是否成功开始协助，1为成功，0为失败
 * @details 当其他NPC被攻击时，协助者会移动到战斗现场并参与战斗
 *          如果协助者已经在战斗中或已经在协助他人，则不会提供帮助
 */
int start_help(object env, object helper, object ob)
{
	object me;

	command("yun powerup");
	me = this_object();
	if (! living(me)) return 0;

	if (env == environment())
	{
		if (this_object()->is_killing(ob->query("id")))
			return 1;

		message_vision(HIW + "$N冷笑不止：“好个" +
			       RANK_D->query_rude(ob) + "！你也来添乱？”\n",
			       me);
	} else
	{
		if (helping || me->is_fighting())
			return 0;

		message_vision(HIC + me->name() + "微微一愣，似乎听到了什么，"
			       "双足一点，扑了出去。"NOR"\n", me);
    
		me->move(env);
		if (objectp(helper))
		{
			message_vision(random(2) ? HIW + "$N高声应道：“$n！不必惊慌，我$N来了！”"NOR"\n" :
						   HIW + "$N一声长吟：“且慢，还有我$N呢，接招！”\n",
				       me, helper);
		}
	}

	me->kill_ob(ob);
	helping = 1;
	return 1;
}

/**
 * @brief 结束协助战斗
 * @return void
 * @details 战斗结束后，协助者会返回自己的起始位置
 *          如果协助者不在协助状态或没有设置起始位置，则不会移动
 */
void finish_help()
{
	string startroom;
	object me;

	me = this_object();
	if (! helping)
		return;

	startroom = me->query("startroom");
	if (! stringp(startroom) || startroom == "")
		return;

	if (base_name(environment()) != startroom)
	{
		message_vision("$N看了看四周，匆匆地离开了。\n", me);
		me->move(startroom);
		message_vision("$N匆匆地赶了过来，拍了拍尘土，仿佛什么"
			       "都没有发生似的。\n", me);
	}

	helping = 0;
}
