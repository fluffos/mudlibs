/**
 * @file finance.c
 * @author Lu dexiang
 * @brief 游戏中的金融交易功能模块
 * @date 2023-01-01
 * @details 提供金钱相关的功能，包括检查是否有足够的金钱以及支付金钱
 */


 
/**
 * @brief 检查对象是否能够负担指定金额
 * @param amount 需要检查的金额
 * @return int 返回检查结果
 * @retval 0 无法负担该金额
 * @retval 1 可以负担，且拥有适当面额的钱币
 * @retval 2 可以负担，但没有足够的适当面额钱币
 * @details 函数会检查对象身上的金币、银币和铜钱，计算总价值是否足够支付指定金额
 */
int can_afford(int amount)
{
	int total;
	object gold, silver, coin;

	gold = present("gold");
	silver = present("silve");
	coin = present("coin");

	total = 0;
	if( gold ) total += gold->value();
	// tell_object(this_object(), "gold: " + gold->value() + "\n");
	if( silver ) total += silver->value();
	if( coin ) total += coin->value();

	if( total < amount ) return 0;

	if( coin ) amount -= (int)coin->value();
	if( amount <= 0 ) return 1;
	else if( amount % 100 ) return 2;

	if( silver ) amount -= (int)silver->value();
	if( amount <= 0 ) return 1;
	else if( amount % 10000 ) return 2;

	return 1;
}

/**
 * @brief 支付指定金额的钱
 * @param amount 需要支付的金额
 * @return int 支付结果
 * @retval 0 支付失败，金钱不足
 * @retval 1 支付成功
 * @throws error 如果计算过程中发现金钱不足，将抛出错误
 * @details 函数会从对象身上的金币、银币和铜钱中扣除相应金额，优先使用大面额货币
 *          金币价值为10000，银币价值为100，铜钱价值为1
 */
int pay_money(int amount)
{
	int total;
	object gold, silver, coin;

	gold = present("gold");
	silver = present("silver");
	coin = present("coin");

	total = 0;
	if( gold ) total += gold->value();
	if( silver ) total += silver->value();
	if( coin ) total += coin->value();

	if( total < amount ) return 0;

	if( gold && amount > 10000 ) {
		if( gold->value() >= amount ) {
			gold->add_amount(-amount/10000);
			amount %= 10000;
		} else {
			amount -= (int)gold->value();
			gold->set_amount(0);
		}
	}
	if( silver && amount > 100 ) {
		if( silver->value() >= amount ) {
			silver->add_amount(-amount/100);
			amount %= 100;
		} else {
			amount -= (int)silver->value();
			silver->set_amount(0);
		}
	}
	if( coin && amount > 0 ) {
		if( coin->value() >= amount ) {
			coin->add_amount(-amount);
			amount = 0;
		} else
			error("F_FINANCE: Not enough money!\n");
	}
	
	if( amount > 0 ) error("F_FINANCE: Not enough money!\n");
	return 1;
}

