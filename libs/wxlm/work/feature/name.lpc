// name.c


#include <dbase.h>
#include <condition.h>

// 对象的ID数组，用于存储多个可识别的标识符
nosave string *my_id;

/**
 * @brief 设置对象的名称和ID标识符
 * @param string name 要设置的名称，如果不提供则自动构建全名
 * @param string *id 可选的ID数组，用于对象识别
 * @details 如果不提供name参数，会自动从surname和purename组合构建全名。
 *          如果都为空则设置为"无名氏"。
 *          ID数组的第一个元素会被设置为主要ID，整个数组用于多重识别。
 *          这种设计允许一个对象有多个可识别的名称或标识符。
 */
varargs void set_name(string name, string *id)
{
	string fullname;

	if (! stringp(name))
	{
		if (! stringp(fullname = query("surname")))
			fullname = "";

		if (stringp(query("purename")))
			fullname += query("purename");

		if (fullname == "")
			fullname = "无名氏";

		set("name", fullname);
	}
	else
	{
		set("name", name);
	}

	if (pointerp(id))
	{
		set("id", id[0]);
		my_id = id;
	}
}

/**
 * @brief 检查字符串是否匹配对象的ID
 * @param string str 要检查的ID字符串
 * @return int 匹配返回1，不匹配返回0
 * @details 用于判断给定的字符串是否能识别当前对象。
 *          会进行可见性检查，如果调用者无法看见此对象则返回0。
 *          在my_id数组中查找匹配的标识符，支持多重ID识别。
 *          这是游戏中对象识别系统的核心函数。
 */
int id(string str)
{
 

	if (! str) return 0;
	if (this_object()->is_character() && this_player() &&
	    ! this_player()->visible(this_object())) return 0;

	if (my_id && member_array(str, my_id) != -1)
		return 1;
	else
		return 0;
}

/**
 * @brief 获取对象的真实ID，处理同名对象的区分
 * @return string 返回带编号的真实ID，用于区分同名对象
 * @details 当环境中存在多个相同ID的对象时，自动添加数字后缀进行区分。
 *          通过遍历环境中的同ID对象，确定当前对象的编号位置。
 *          如果是第一个对象则返回原始ID，否则返回"ID 编号"的格式。
 *          这确保了每个对象都有唯一的识别方式，避免命令歧义。
 */
string real_id()
{
	object *inv,obj;
	int i,j;

	obj=this_object();

	if(!environment(obj))
		return obj->query("id");

	inv = all_inventory(environment(obj));
	inv = filter_array(inv, (: $1->query("id")==$2->query("id") :),obj);
	
	for(i=0;i<sizeof(inv);i++)
	{ 
		if(obj== present(inv[i]->query("id")+" "+(i+1),environment(obj)))
		{
			j=i+1;
			break;
		}
	}
	if(j==1)
		return obj->query("id");
	else
		return obj->query("id")+" "+j;
}

/**
 * @brief 解析命令系统使用的ID列表
 * @return string * 返回可用于命令解析的ID数组
 * @details 优先返回临时应用的ID列表，如果不存在则返回默认的my_id数组。
 *          临时ID系统允许动态改变对象的可识别标识符，
 *          常用于变身、伪装等特殊状态下的身份转换。
 *          这为游戏的命令解析系统提供了灵活的对象识别机制。
 */
string *parse_command_id_list() 
{
	string *applied_id;

	if( pointerp(applied_id = query_temp("apply/id")) 
	&&	sizeof(applied_id) )
		return applied_id;
	else
		return my_id;
}

/**
 * @brief 获取对象的显示名称
 * @param int raw 可选参数，为1时获取原始名称，忽略临时名称
 * @return string 返回对象的显示名称
 * @details 支持临时名称系统，可以动态改变对象的显示名称。
 *          如果存在临时应用的名称且raw为0，则返回最新的临时名称；
 *          否则返回对象的基础名称，如果名称未设置则返回文件名。
 *          临时名称系统常用于变身、伪装等需要改变外观的场景。
 */
varargs string name(int raw)
{
	string str, *mask;
	
	if (! raw && sizeof(mask = query_temp("apply/name")))
		return mask[sizeof(mask)-1];
	else
	{
		if (stringp(str = query("name")))
			return str;
		else
			return file_name(this_object());
	}
}

/**
 * @brief 获取对象的简短描述
 * @param int raw 可选参数，为1时忽略自定义的short描述
 * @return string 返回格式化的简短描述
 * @details 如果对象设置了自定义的short描述且raw为0，直接返回该描述；
 *          否则自动构建格式为"名称(真实ID)"的标准描述。
 *          这种格式确保了对象在游戏中的唯一性和可识别性，
 *          特别是在存在同名对象时通过真实ID进行区分。
 */
varargs string short(int raw)
{
	string str;
	
	if (raw || ! stringp(str = query("short")))
		str = name(raw) + "(" + capitalize(this_object()->real_id()) + ")";
	return str;
}

/**
 * @brief 获取对象的详细描述
 * @param int raw 可选参数，为1时忽略临时的long描述
 * @return string 返回完整的详细描述
 * @details 支持临时描述系统，可以动态改变对象的详细描述。
 *          如果存在临时应用的描述且raw为0，返回最新的临时描述；
 *          否则返回基础描述，如果未设置则使用简短描述加句号；
 *          还会追加extra_long()函数返回的额外描述信息。
 *          这种分层描述系统为对象提供了丰富的外观表现能力。
 */
varargs string long(int raw)
{
	string str, extra, *mask;
	
	if (! raw && sizeof(mask = query_temp("apply/long")))
		str = mask[sizeof(mask)-1];
	else
	if (! stringp(str = query("long")))
		str = short(raw) + "。\n";

	if (stringp(extra = this_object()->extra_long()))
		str += extra;

	return str;
}