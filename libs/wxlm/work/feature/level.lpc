// level.c 

#include <dbase.h>


/**
 * @brief 判断玩家是否可以升级并处理升级逻辑
 * @param me 玩家对象
 */
varargs void improve_level(object me)
{
    int exp_num, level;

    if (!me)
    {
        return;
    }
    // 获取当前实战经验
    exp_num = me->query("combat_exp");
    level = me->query("level");

    // 检查是否满足升级条件
    if (exp_num < LEVEL_MASTER->level_up_exp(level + 1))
    {
        // write(HIR "你运转丹田真气，试图提升武道修为，奈何武道经验不足，只得摇头作罢。" NOR "\n");
        return;
    }

    // 处理升级逻辑
    //再次检查是否可以升级。
    if (LEVEL_MASTER->level_up(me))
    {
        call_out_walltime("improve_level",0.1,me);
    }
}

//提升天赋点数
varargs void up_tianfu(object me, string attr)
{
    int i;
    string *valid_attrs = ({"str", "int", "con", "dex"});
    
    if ((int)me->query("tianfu_point"))
    {
		string attr_name;
        if (!attr || member_array(attr, valid_attrs) == -1)
        {
            i = random(4);
            attr = valid_attrs[i];
        }
        
        write(HIY"你体内真气澎湃，一缕先天真炁缓缓注入，顿时金光四射，气势逼人。"NOR"\n");
        
        me->add(attr, 1);
        me->add("tianfu/" + attr, 1);
        

        switch (attr)
        {
            case "str": attr_name = "先天臂力"; break;
            case "int": attr_name = "先天悟性"; break;
            case "con": attr_name = "先天根骨"; break;
            case "dex": attr_name = "先天身法"; break;
        }
        
        write(HIR"你长吐一口真气，只见"HIG"你的「" + attr_name + "」增加了!"NOR"\n");
        
        me->add("tianfu_point", -1);
    }
    else
    {
        write(HIR"你的先天真炁不足以提升先天属性! "NOR"\n");
    }
}
/**
 * @brief 随机提升装备的特殊技能等级
 * @param me 玩家对象
 */
varargs void up_skills(object me)
{
    mixed me_skills;
    string *sky_skills;
    string selected_skill;
    mapping skills;
    int i, skill_level, exp;
    
    // 获取玩家装备的特殊技能映射
    me_skills = me->query_skill_map();
    
    // 检查是否有装备特殊技能
    if (!sizeof(me_skills))
    {
        write(HIR"武圣真意只能提升装备着的特殊武功!"NOR"\n");
        return;
    }
    
    // 检查技能点是否足够
    if (!(int)me->query("skill_point"))
    {
        write(HIR"你的武圣真意不足!"NOR"\n");
        return;
    }
    
    // 随机选择一个特殊技能
    sky_skills = keys(me_skills);
    i = random(sizeof(me_skills));
    selected_skill = me_skills[sky_skills[i]];
    
    // 获取当前技能等级和经验值
    skills = me->query_skills();
    skill_level = skills[selected_skill];
    exp = me->query("combat_exp");

    if (skill_level >= me->query("level"))
    {
        write(HIR"你的武学已经达到当前境界的极限，无法再提升！"NOR"\n");
        return;
    }
    
    // 提升技能等级
    skills[selected_skill]++;
    
    // 消耗技能点
    me->add("skill_point", -1);
    
    // 记录技能升级
    me->add("skill_dian/" + selected_skill, 1);
    
    // 提示信息
    tell_object(me, HIC "你凝聚心神，消耗了一道武圣真意，感受到内力的涌动与武学的交感。\n" NOR);
    printf(HIC"≡"HIY"─────────────────────"HIC"≡"NOR"\n");
    tell_object(me, HIR"  武学交感："NOR" 你的武学"MAG" [ "+to_chinese(selected_skill)+" ]"NOR" 已经突破了瓶颈，境界更上一层楼！"NOR"\n");
    printf(HIC"≡"HIY"─────────────────────"HIC"≡"NOR"\n");
}
