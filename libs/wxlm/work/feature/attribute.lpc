	// 处理其他临时属性加成
	if ((int)query_temp("dex") > 0) {
		dexterity += (int)query_temp("dex");
		set_temp("race_human/dex/其他增益", (int)query_temp("dex"));
	}

	// 处理十脉加成
	if (query("shimai-tong")) {
		dexterity += 10;
