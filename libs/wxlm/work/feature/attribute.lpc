		set_temp("race_human/dex/词条", query("citiao_effects/dex"));
	}

	// 处理头像状态加成
	if (query("head_image_attribute/dex"))
	{
		dexterity += query("head_image_attribute/dex");
		set_temp("race_human/dex/头像状态", query("head_image_attribute/dex"));
	}

	// 处理称号加成
	if (query("titlea/dex"))
	{
		dexterity += query("titlea/dex");
		set_temp("race_human/dex/称号", query("titlea/dex"));
	}
	
	dexterity += query("mizhuan_power/attribute/dex");

	// 武圣肺脏炼体加成 - 身法
	if (query("wusheng_bonus/dex_bonus"))
