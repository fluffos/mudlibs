	}
	
	return dexterity + improve + query_temp("apply/dex") + 
		   query_temp("suit_eff/spirituality");
}

int query_per(string arg)
{
	int appearance, age, art_cognize;
    
	appearance = query("per") + query_temp("apply/per");
    
	// 如果有青春永驻特技,直接返回原值
	if (query("special_skill/youth"))
		return appearance;

	age = query("age");
	art_cognize = query_skill("art-cognize", 1);

	// 处理年龄对容貌的影响
	if (art_cognize < 100) {
		if (age > 70) {
			appearance -= 6;
			set_temp("race_human/per/年龄衰减", -6);
		} else if (age > 60) {
			appearance -= 5;
			set_temp("race_human/per/年龄衰减", -5);
		} else if (age > 50) {
			appearance -= 4;
			set_temp("race_human/per/年龄衰减", -4);
		} else if (age > 40) {
			appearance -= 3;
			set_temp("race_human/per/年龄衰减", -3);
		} else if (age > 30) {
			appearance -= 2;
			set_temp("race_human/per/年龄衰减", -2);
		}
	}

	// 处理艺术修养加成
	if (art_cognize > 0) {
		int art_bonus = art_cognize / 20;
		appearance += art_bonus;
		set_temp("race_human/per/艺术修养", art_bonus);
	}

	// 处理头像状态加成
	if (query("head_image_attribute/per"))
	{
		appearance += query("head_image_attribute/per");
		set_temp("race_human/per/头像状态", query("head_image_attribute/per"));
	}

	return appearance;
}

