// attribute.c
// From ES2
// Modified by Xiang for XKX (12/15/95)
 
#include <command.h>
#include <dbase.h>
#include <skill.h>

int query_str()
{
	mapping sk;
	int str, improve = 0, lx = 0;
	string *basic_skills = ({"unarmed", "cuff", "finger", "strike", "hand", "claw"});
	mapping skill_names = ([
		"unarmed": "基本拳脚",
		"cuff": "基本拳法", 
		"finger": "基本指法",
		"strike": "基本掌法",
		"hand": "基本手法",
		"claw": "基本爪法"
	]);

	str = query("str");
	if (! mapp(sk = query_skills()))
		return str;

	// 处理基础技能加成
	foreach(string skill in basic_skills) {
		if ((int)sk[skill] > 0) {
			improve += (int)sk[skill] / 30;
			set_temp("race_human/str/" + skill_names[skill], (int)sk[skill] / 30);
		}
	}

	// 处理套装技能加成
	foreach(string skill in basic_skills) {
		string suit_skill = "suit_skill/" + skill;
		if ((int)query_temp(suit_skill) > 0) {
			improve += (int)query_temp(suit_skill) / 30;
			set_temp("race_human/str/套装" + skill_names[skill], 
				(int)query_temp(suit_skill) / 30);
		}
	}

	// 处理其他临时属性加成
	if ((int)query_temp("str") > 0) {
		improve += (int)query_temp("str");
		set_temp("race_human/str/其他增益", (int)query_temp("str"));
	}

	// 处理龙象般若功加成
	if ((int)sk["longxiang"] > 0) {
		lx = (int)sk["longxiang"] / 30;
		set_temp("race_human/str/龙象般若功", lx);
	}

	// 处理十脉加成
	if (query("shimai-tong")) {
		str += 10;
		set_temp("race_human/str/十脉", 10);
	}

	// 处理词条加成
	if (query("citiao_effects/str"))
	{
		str += query("citiao_effects/str");
		set_temp("race_human/str/词条", query("citiao_effects/str"));
	}

	// 处理头像状态加成
	if (query("head_image_attribute/str"))
	{
		str += query("head_image_attribute/str");
		set_temp("race_human/str/头像状态", query("head_image_attribute/str"));
	}

	// 处理称号加成
	if (query("titlea/str"))
	{
		str += query("titlea/str");
		set_temp("race_human/str/称号", query("titlea/str"));
	}

	str += query("mizhuan_power/attribute/str");

	return str + improve + lx + query_temp("suit_eff/strength") + query_temp("apply/str");
}

int query_int()
{
	mapping sk;
	int intelligence, improve = 0;
	string *knowledge_skills = ({"literate"});
	mapping skill_names = ([
		"literate": "读书写字"
	]);

	intelligence = query("int");
	if (! mapp(sk = query_skills()))
		return intelligence;

	// 处理基础技能加成
	foreach(string skill in knowledge_skills) {
		if ((int)sk[skill] > 0) {
			improve += (int)sk[skill] / 10;
			set_temp("race_human/int/" + skill_names[skill], (int)sk[skill] / 10);
		}
	}

	// 处理套装技能加成
	foreach(string skill in knowledge_skills) {
		string suit_skill = "suit_skill/" + skill;
		if ((int)query_temp(suit_skill) > 0) {
			improve += (int)query_temp(suit_skill) / 10;
			set_temp("race_human/int/套装" + skill_names[skill], 
				(int)query_temp(suit_skill) / 10);
		}
	}

	// 处理其他临时属性加成
	if ((int)query_temp("int") > 0) {
		intelligence += (int)query_temp("int");
		set_temp("race_human/int/其他增益", (int)query_temp("int"));
	}

	// 处理十脉加成
	if (query("shimai-tong")) {
		intelligence += 10;
		set_temp("race_human/int/十脉", 10);
	}

	// 处理词条加成
	if (query("citiao_effects/int"))
	{
		intelligence += query("citiao_effects/int");
		set_temp("race_human/int/词条", query("citiao_effects/int"));
	}

	// 处理头像状态加成
	if (query("head_image_attribute/int"))
	{
		intelligence += query("head_image_attribute/int");
		set_temp("race_human/int/头像状态", query("head_image_attribute/int"));
	}

	// 处理称号加成
	if (query("titlea/int"))
	{
		intelligence += query("titlea/int");
		set_temp("race_human/int/称号", query("titlea/int"));
	}

	intelligence += query("mizhuan_power/attribute/int");

	// 武圣脾脏炼体加成 - 悟性
	if (query("wusheng_bonus/int_bonus"))
	{
		intelligence += query("wusheng_bonus/int_bonus");
		set_temp("race_human/int/武圣脾脏", query("wusheng_bonus/int_bonus"));
	}

	return intelligence + improve + query_temp("apply/int") + 
		   query_temp("suit_eff/intelligence") + query_temp("max_int");
}

