#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void consider();

void create() {
  set_name("无名老僧", ({ "wuming seng", "wuming", "seng" }));
  set("long", "他就是少林无名老僧，看起来已经是风烛残年。而且双腿残废。 \n");
  create_family("少林派", 2, "弟子");
  set("attitude", "peaceful");
  set("age", 95);
  set("gender", "男性");
  set("shen_type", 1);
  set("no_drop", 1);
  set("chat_msg", ({
    CYN "无名僧人言到：“老纳自创之少林无影剑，举世无双。”\n" NOR,
    CYN "无名僧人言到：“老纳一身只败在独孤九剑之下，于是钻研20年终创出无敌的少林无影剑。”\n" NOR,
  }));
  set("con", 30);
  set("dex", 30);
  set("int", 30);
  set("str", 30);
  set("per", 15);
  set("ker", 10);
  set("max_jing", 1000);
  set("max_neili", 15000);
  set("max_qi", 10000);
  set("jing", 1000);
  set("neili", 50000);
  set("qi", 10000);
  set("jiali", 150);
  set("shen", -100000);
  set("combat_exp", 2500000);

  set_skill("buddhism", 350);
  set_skill("dodge", 350);
  set_skill("force", 350);
  set_skill("literate", 350);
  set_skill("parry", 350);
  set_skill("sword", 350);
  set_skill("finger", 350);
  set_skill("wuying-jian", 300);
  set_skill("hunyuan-yiqi", 350);
  set_skill("shaolin-shenfa", 350);

  map_skill("force", "hunyuan-yiqi");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("parry", "wuying-jian");
  map_skill("sword", "wuying-jian");


  set("chat_chance", 0);
  set("chat_msg", ({
    CYN "无名老僧说道：老衲被玄风这小儿害得双腿尽废。\n" "我一定想法报仇.....\n" NOR,
  }));

  set("inquiry", ([
    "玄风": "少林居然出了玄风这个鼠辈，当年我早看出其心术 不正\n" "因此没有传他少林无影剑，这斯却把我囚禁再此,已有30余年了！\n" "想逼我交出剑谱，哼！我岂能给他......\n",
    "少林无影剑": "少林无影剑是老衲自创绝技。攻击式如狂风一般势不可挡！\n",
    "拜师": "哦！想拜老衲为师？\老衲大仇未报不想收徒，除非......\n",

  ]));

  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: command("exert recover") :),
  }));

  setup();

  carry_object("/d/shaolin/obj/dao-cloth")->wear();
  carry_object("/clone/weapon/changjian")->wield();

}
void attempt_apprentice(object who) {
  mapping who_fam;
  string name, new_name;
  name = who->query("name");
  if ((int)who->query("bai_wuming") == 1) {
    command("say 我不会再收你为徒了，你还是走吧！\n");
    return;
  }
  if (!(who_fam = who->query("family")) || who_fam["family_name"] != "少林派") {
    command("say " + RANK_D->query_respect(who) + "与本派素无来往，不知此话从何谈起？");
    return;
  }
  if ((int)who->query_skill("buddhism", 1) < 120) {
    command("say 悟禅之人，德义为先，功夫的高低倒还在其次，未练武，要先学做人。");
    command("say 在禅宗心法方面，" + RANK_D->query_respect(who) +
      "是否还做得不够？");
    return;
  }

  if ((int)who->query("killxf") == 1) {
    command("chat 想不到老纳在垂死之年，又觅得一个可塑之才，好！老衲就将毕生\n" "的武学都传受于你！\n");
    command("recruit " + who->query("id"));

    who->set("title", HIY "少林派之世外高僧" NOR);
    name = who->query("name");
    new_name = "玄" + name[2..3];
    who->set("name", new_name);
    who->set("bai_wuming", 1);
    command("say 从今以后你的法名叫做" + new_name + "，恭喜你荣升为少林派玄字辈弟子 !");
    command("recruit " + who->query("id"));

    return;
  }

  command("say 哦！想拜老衲为师？\n");
  command("say 老衲大仇未报不想收徒，除非......\n");
  who->set_temp("go_kill_xf", 1);

  return 0;
}

int accept_object(object who, object ob) {
  if ((int)who->query("killxf") == 1) {
    message_vision("无名老僧看了看$N，说道：我不会再收你了，你还是走吧！\n", ob);
    return 1;
  }

  if ((string)ob->query("id") == "xf poll" && (int)who->query("shaxf") == 1) {
    message_vision("无名老僧看了看$N送来的人头，一阵狂笑道：\n"
      "呵！呵！呵！玄风小儿你也有今天。\n"
      "看你拜师至诚，老纳就收下你这个佳弟子。\n", who);
    who->set("killxf", 1);
    return 1;
  }

  if ((string)ob->query("id") == "xf poll") {
    if ((int)who->query("shaxf") != 1) {
      message_vision("无名老僧看了看$N送来的人头，突然说到:\n"
        "哼！哼！你这小贼，居然敢骗我！明年的今天就是你的忌日！！！\n"
        "让你死也死个明白！告诉你吧！因为玄风不是你…杀…的！\n", who);
      who->set("killxf", 1);
      command("kill " + this_player()->query("id"));
      return 1;
    }
  }

  return 0;
}
