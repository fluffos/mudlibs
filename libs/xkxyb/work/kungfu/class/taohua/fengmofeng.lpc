// /kungfu/class/fengmofeng
// adx 4:16 99-2-12

#include <ansi.h>
inherit NPC;
string ask_me(string name);

void create() {
  set_name("冯默风", ({ "feng mofeng", "feng", "mofeng" }));
  set("long", "他是黄药师最小的弟子，只断了一条腿。\n");
  set("gender", "男性");
  set("age", 30);
  set("attitude", "peaceful");
  set("str", 30);
  set("dex", 32);
  set("con", 17);
  set("int", 25);
  set("shen_type", 1);

  create_family("桃花岛", 2, "弟子");

  set_skill("force", 220);
  set_skill("bibo-shengong", 220);
  set_skill("dodge", 160);
  set_skill("anying-fuxiang", 160);
  set_skill("parry", 250);
  set_skill("sword", 250);
  set_skill("luoying-shenjian", 250);
  set_skill("unarmed", 230);
  set_skill("luoying-zhang", 180);
  set_skill("cuixin-zhang", 230);
  set_skill("finger", 200);
  set_skill("tanzhi-shentong", 200);
  set_skill("qimen-wuxing", 200);
  set_skill("literate", 200);

  map_skill("force", "bibo-shengong");
  map_skill("unarmed", "cuixin-zhang");
  map_skill("dodge", "anying-fuxiang");
  map_skill("parry", "cuixin-zhang");
  map_skill("sword", "luoying-shenjian");
  map_skill("finger", "tanzhi-shentong");

  set("jiali", 150);

  set("combat_exp", 2500000);

  set("max_qi", 5000);
  set("max_jing", 1200);
  set("neili", 8000);
  set("max_neili", 8000);

  set("inquiry", ([
    "武器": (: ask_me, "changjian" :),
    "剑": (: ask_me, "changjian" :),
  ]));

  set("foor_count", 2);

  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    (: perform_action, "force.powerup" :),
    (: perform_action, "unarmed.gu" :),
    (: exert_function, "recover" :),
  }));
  setup();
  carry_object("/d/taohua/obj/cloth")->wear();

}
string ask_me(string name) {
  mapping fam;
  object ob;

  if (!(fam = this_player()->query("family")) || fam["family_name"] != "桃花岛")
    return RANK_D->query_respect(this_player()) + "你与本派素无来往，不知此话从何谈起？";

  if (present(name, this_player()))
    return RANK_D->query_respect(this_player()) + "你现在身上不是有吗，怎麽又来要了？真是贪得无厌！";

  if (query("foor_count") < 1)
    return "抱歉，你来得不是时候，长剑已经没有了。";

  ob = new("/d/taohua/obj/" + name);
  ob->move(this_player());

  add("foor_count", -1);

  message_vision(YEL "冯默风给$N一个" + ob->query("name") + "。\n" NOR, this_player());

  return "给。";
}
void attempt_apprentice(object ob) {
  if (ob->query_int() < 25) {
    command("say 我不收资质差的弟子，您请回吧！");
    return;
  }
  if ((int)ob->query_skill("bibo-shengong", 1) < 100) {
    command("say 你的本门内功心法太低了,还是努努力先提高一下吧!");
    return;
  }
  if ((int)ob->query("shen") < 10000) {
    command("say 你多行不义，还是多多行侠仗义，日后在来吧！");
    return;
  }
  command("say 好吧，今后你要群奋练功，光大本门。");
  command("recruit " + ob->query("id"));
}
