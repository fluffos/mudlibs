// /kungfu/class/qulingfeng
// adx 4:16 99-2-12

#include <ansi.h>
inherit NPC;
string ask_me(string name);
void create()
{
	set_name("曲灵风", ({ "qu lingfeng", "qu", "lingfeng" }));
	set("long", "他是黄药师弟子中武功最好的，双腿齐膝而断，但是身手矫健。\n");
	set("gender", "男性");
	set("age", 37);
        set("attitude", "peaceful");
	set("str", 30);
	set("dex", 32);
	set("con", 17);
	set("int", 25);
        set("shen_type", 1);

        create_family("桃花岛", 2, "弟子");

	set_skill("force", 250);
        set_skill("bibo-shengong", 250);
        set_skill("dodge", 160);
        set_skill("anying-fuxiang", 160);
        set_skill("parry", 250);
	set_skill("sword", 250);
	set_skill("luoying-shenjian",250);
        set_skill("unarmed",230);
	set_skill("luoying-zhang",230);
        set_skill("finger",200);
	set_skill("tanzhi-shentong",200);
	set_skill("qimen-wuxing",200);
	set_skill("literate",200);

        map_skill("force"  , "bibo-shengong");
        map_skill("unarmed"   , "luoying-zhang");
        map_skill("dodge"  , "anying-fuxiang");
        map_skill("parry"  , "luoying-shenjian");
        map_skill("sword"  , "luoying-shenjian");
        map_skill("finger"  , "tanzhi-shentong");

	set("jiali",150);

	set("combat_exp", 2500000);

	set("max_qi", 5000);
	set("max_jing", 1200);
	set("neili", 8000);
	set("max_neili", 8000);

        set("inquiry", ([
	"无常丹" :   (: ask_me, "wucdan" :),
	"药" :   (: ask_me, "wucdan" :),
	"疗伤" :   (: ask_me, "wucdan" :),
	"解毒" :   (: ask_me, "wucdan" :),
        ]));

	set("foor_count", 2);

	set("chat_chance_combat", 40);
	set("chat_msg_combat", ({
		(: perform_action, "force.powerup" :),
		(: exert_function, "recover" :),
            }) );
	setup();
	carry_object("/d/taohua/obj/cloth")->wear();
	carry_object("/d/taohua/obj/changjian")->wield();
	}
string ask_me(string name)
{
	mapping fam; 
	object ob;
	
	if (!(fam = this_player()->query("family")) || fam["family_name"] != "桃花岛")
		return RANK_D->query_respect(this_player()) + 
		"你与本派素无来往，不知此话从何谈起？";

	if (  present(name, this_player()) )
		return RANK_D->query_respect(this_player()) + 
		"你现在身上不是有吗，怎麽又来要了？别人有伤怎么办！";

	if (query("foor_count") < 1)
		return "抱歉，你来得不是时候，药品已经发完了。";

	ob = new("/d/taohua/obj/" + name);
	ob->move(this_player());

	add("foor_count", -1);

	message_vision(YEL"曲灵风给$N一个" + ob->query("name") + "。\n"NOR, this_player());

	return "给。";
}
void attempt_apprentice(object ob)
{
    if (ob->query_int() < 25) {
        command("say 我不收资质差的弟子，您请回吧！");
		return;
    }
    if ((int)ob->query_skill("bibo-shengong",1) < 100 ) {
        command("say 你的本门内功心法太低了,还是努努力先提高一下吧!");
		return;
    }
    if ((int)ob->query("shen") < 10000 ) {
        command("say 你多行不义，还是多多行侠仗义，日后在来吧！");
		return;
	}
    command("say 好吧，今后你要群奋练功，光大本门。");
    command("recruit " + ob->query("id"));
}
