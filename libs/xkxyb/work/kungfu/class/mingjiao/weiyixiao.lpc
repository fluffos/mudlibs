// WeiYiXiao.c
// pal 1997.05.10

#include "ansi.h"

inherit NPC;
inherit F_MASTER;
inherit F_UNIQUE;

void create() {
  set_name("韦一笑", ({ "wei yixiao", "wei", "yixiao", }));
  set("long",
    "他是一只青翼大蝙蝠\n"
    "他的脸色灰扑扑的。\n"
  );

  set("title", HIG "明教" HIC "青翼蝠王" NOR);
  set("level", 9);
  set("gender", "男性");
  set("attitude", "peaceful");

  set("age", 48);
  set("shen_type", 1);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("max_qi", 3000);
  set("max_jing", 1500);
  set("neili", 3000);
  set("max_neili", 3000);
  set("jiali", 150);

  set("combat_exp", 1000000);
  set("score", 1000000);

  set_skill("force", 200);
  set_skill("dodge", 250);
  set_skill("strike", 250);
  set_skill("parry", 200);
  set_skill("shenghuo-shengong", 150);
  set_skill("shenghuo-xinfa", 200);
  set_skill("qingfu-shenfa", 300);
  set_skill("hanbing-mianzhang", 250);
  set_skill("literate", 120);

  map_skill("force", "shenghuo-shengong");
  map_skill("dodge", "qingfu-shenfa");
  map_skill("strike", "hanbing-mianzhang");
  map_skill("parry", "hanbing-mianzhang");

  prepare_skill("strike", "hanbing-mianzhang");
  create_family("明教", 35, "护法");
  set("chat_chance", 500);
  set("chat_msg", ({
    (: exert_function, "recover" :),
    (: exert_function, "heal" :),
  }));

  set("chat_chance_combat", 20);
  set("chat_msg_combat", ({
    (: command("perform xixueqingfu") :),
  }));

  setup();

  carry_object("/d/mj/obj/baipao")->wear();
}


void attempt_apprentice(object ob) {

  if ((int)ob->query_skill("force") < 40) {
    command("say 你的基本内功太低了，学习武功要先打好基础。");
    return 0;
  }
  if ((int)ob->query_skill("dodge") < 60) {
    command("say 你的基本轻功太低了，学习武功要先打好基础。");
    return 0;
  }

  if ((int)ob->query("shen") <= 1000) {
    command("say 你应当多作些行侠仗义的事，以修身心。");
    return 0;
  }
  command("recruit " + ob->query("id"));
  ob->set("title", "明教护教法王座下弟子");
  command("say 好，我就收下你这位好兄弟");
  command("say 再接再砺！");
  return;
}
void init() {
  object ob;
  mapping myfam;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    myfam = (mapping)ob->query("family");
    if ((!myfam || myfam["family_name"] != "明教")) {

      remove_call_out("do_killing");
      call_out("do_killing", 4, ob);
    }
  }
}
void do_killing(object ob) {
  if (!ob || environment(ob) != environment())
    return;
  command("consider " + ob->query("id"));
  this_object()->kill_ob(ob);
}
