// miaodaoyi.c 苗道一

inherit NPC;
inherit F_MASTER;
#include <ansi.h>
string ask_me();

void create() {
  set_name(HIW "苗道一" NOR, ({ "miao daoyi", "miao" }));
  set("long",
    "他是全真教四代弟子,年纪不大.\n");
  set("gender", "男性");
  set("age", 23);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 25);
  set("int", 25);
  set("con", 25);
  set("dex", 25);

  set("max_qi", 1000);
  set("max_jing", 800);
  set("neili", 1000);
  set("max_neili", 1000);
  set("jiali", 25);

  set("combat_exp", 300000);
  set("score", 8500);

  set_skill("force", 110);
  set_skill("xiantian-gong", 110);
  set_skill("literate", 90);
  set_skill("sanhuajuding", 100);
  set_skill("sword", 120);
  set_skill("quanzhen-jianfa", 120);
  set_skill("unarmed", 100);
  set_skill("dodge", 110);
  set_skill("jinyan-gong", 110);
  set_skill("taoism", 100);
  set_skill("parry", 90);

  map_skill("force", "xiantian-gong");
  map_skill("unarmed", "sanhuajuding");
  map_skill("sword", "quanzhen-jianfa");
  map_skill("dodge", "jinyan-gong");
  map_skill("parry", "quanzhen-jianfa");

  create_family("全真教", 4, "弟子");
  set("class", "taoist");
  setup();
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/d/obj/greenrobe")->wear();

}
void attempt_apprentice(object ob) {
  if ((int)ob->query("shen") < 0) {
    command("say 我全真教乃是堂堂名门正派，对弟子要求极严。");
    command("say 在德行方面，" + RANK_D->query_respect(ob) +
      "是否还做得不够？");
    return;
  }
  if ((string)ob->query("gender") != "男性") {
    command("say 对不起，本教不收女弟子，你还是另投师们吧。");
    return;
  }

  command("say 好吧，我就收下你了。");
  command("recruit " + ob->query("id"));
}
