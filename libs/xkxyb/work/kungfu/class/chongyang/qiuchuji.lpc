// qiuchuji.c

inherit NPC;
inherit F_MASTER;
#include <ansi.h>
string ask_me();

void create()
{
	set_name("秋处机", ({ "qiu chuji", "qiu" }));
	set("nickname", HIC "长春子" NOR);
	set("long",
		"他就是大名鼎鼎的“长春子”秋处机，看上去是一个\n"
		"不怎么样的糟老头可是在江湖上他的名头可是响当当的。\n");
	set("gender", "男性");
	set("age", 52);
	set("attitude", "peaceful");
	set("shen_type", 1);
	set("str", 30);
	set("int", 20);
	set("con", 20);
	set("dex", 30);
	
	set("max_qi", 6000);
	set("max_jing", 1800);
	set("neili", 10000);
	set("max_neili", 10000);
	set("jiali", 100);

	set("combat_exp", 4000000);
	set("score", 900000);	
	
	set_skill("force",300);
	set_skill("xiantian-gong",300);
	set_skill("literate",280);
	set_skill("sword",290);
	set_skill("quanzhen-jianfa",290);
	set_skill("unarmed",290);
	set_skill("dodge",280);
	set_skill("jinyan-gong",280);
	set_skill("taoism",280);
	set_skill("parry",260);
	set_skill("sanhuajuding",290);

	map_skill("force","xiantian-gong");
	map_skill("unarmed","sanhuajuding");
	map_skill("sword","quanzhen-jianfa");
	map_skill("dodge","jinyan-gong");
	map_skill("parry","quanzhen-jianfa");

	create_family("全真教", 2, "弟子");
	set("class", "taoist");
	set("chat_chance_combat", 60);
	set("chat_msg_combat", ({
		(: perform_action, "unarmed.sanhua" :),
		(: exert_function, "recover" :),
	}) );

	setup();
	carry_object("/d/wudang/obj/greenrobe")->wear();

}
void attempt_apprentice(object ob)
{
	if ((int)ob->query("shen") < 50000) {
		command("say 学武之人，德义为先，功夫的高低倒还在其次，未练武，要先学做人。");
		command("say 在德行方面，" + RANK_D->query_respect(ob) +
			"是否还做得不够？");
		return;
	}
	if ((int)ob->query_skill("xiantian-gong", 1) < 200 ) {
		command("say 我全真教乃内家武功，最重视内功心法。"); 
		command("say " + RANK_D->query_respect(ob) + 
			"是否还应该在先天神功上多下点功夫？");
		return;
	}
	if ((int)ob->query_skill("quanzhen-jianfa", 1) < 200) {
		command("say 我全真教以剑法为重，应该多注重剑法的修行。"); 
		command("say " + RANK_D->query_respect(ob) + 
			"是否还应该在全真剑法上多下点功夫？");
		return;
	}
	command("say 以后可要加倍的努力了。");
	command("recruit " + ob->query("id"));
}


