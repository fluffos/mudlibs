// wangchongyang.c 王重阳

inherit NPC;
inherit F_MASTER;
#include <ansi.h>
string ask_me();

void create() {
  set_name("王重阳", ({ "wang chongyang", "wang" }));
  set("nickname", HIW "中神通" NOR);
  set("long",
    "他就是全真教开山始祖“王重阳”，他几次起兵抗金，都败了回来\n" +
    "后来，一怒之下出家做了黄冠道人，而辜负了林朝英女侠对他的一番深情厚谊。\n");
  set("gender", "男性");
  set("age", 75);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 30);
  set("int", 20);
  set("con", 20);
  set("dex", 30);

  set("inquiry", ([
    "石壁": "你如能帮我想出在石壁上写字的方法我毕有重谢。 \n" ]));

  set("max_qi", 10000);
  set("max_jing", 2800);
  set("neili", 12000);
  set("max_neili", 12000);
  set("jiali", 200);

  set("combat_exp", 6000000);
  set("score", 900000);

  set_skill("force", 450);
  set_skill("xiantian-gong", 450);
  set_skill("literate", 400);
  set_skill("sword", 420);
  set_skill("quanzhen-jianfa", 420);
  set_skill("unarmed", 380);
  set_skill("dodge", 370);
  set_skill("jinyan-gong", 370);
  set_skill("taoism", 400);
  set_skill("parry", 360);
  set_skill("sanhuajuding", 380);

  map_skill("force", "xiantian-gong");
  map_skill("unarmed", "sanhuajuding");
  map_skill("sword", "quanzhen-jianfa");
  map_skill("dodge", "jinyan-gong");
  map_skill("parry", "quanzhen-jianfa");

  create_family("全真教", 1, "开山祖师");
  set("class", "taoist");
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: perform_action, "sword.sanqing" :),
    (: perform_action, "sword.tonggui" :),
    (: exert_function, "recover" :),
  }));

  setup();
  carry_object("/d/obj/greenrobe")->wear();
  carry_object("/clone/weapon/changjian")->wield();
}
void attempt_apprentice(object ob) {
  if ((int)ob->query("shen") < 500000) {
    command("say 学武之人，德义为先，功夫的高低倒还在其次，未练武，要先学做人。");
    command("say 在德行方面，" + RANK_D->query_respect(ob) +
      "是否还做得不够？");
    return;
  }
  if ((int)ob->query_skill("xiantian-gong", 1) < 270) {
    command("say 我全真教乃内家武功，最重视内功心法。");
    command("say " + RANK_D->query_respect(ob) +
      "是否还应该在先天神功上多下点功夫？");
    return;
  }
  if ((int)ob->query_skill("quanzhen-jianfa", 1) < 280) {
    command("say 我全真教以剑法为重，应该多注重剑法的修行。");
    command("say " + RANK_D->query_respect(ob) +
      "是否还应该在全真剑法上多下点功夫？");
    return;
  }
  command("chat 想不到呀，想不到我居然还能收的这样的贤才，真是不旺此生。");
  command("say 以后可要加倍的努力了。");
  command("recruit " + ob->query("id"));
}

int accept_object(object who, object ob) {
  object obn;

  if (!who || environment(who) != environment()) return 0;
  if (!objectp(ob)) return 0;
  if (!present(ob, who)) return notify_fail("你没有这件东西。\n");

  if ((string)ob->query("name") != HIW "化石丹" NOR)
    return notify_fail("你给我这东西可以在石头上用手指写字吗？\n");
  if ((string)ob->query("id") == "huashi dan") {
    message_vision(HIG "\n王重阳看到化石丹，微微一笑说道：“这玄门定阳丹乃是上好之丹药不到万不得已不要服用。\n" NOR, who);
    obn = new("/d/chongyang/obj/xmdydan");
    obn->move(who);
    return 1;
  }
}
