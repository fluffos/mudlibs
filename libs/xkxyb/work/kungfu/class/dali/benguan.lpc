inherit NPC;
inherit F_MASTER;

string ask_me();
void create() {
  set_name("本观", ({ "ben guan", "guan" }));
  set("gender", "男性");
  set("title", "天龙寺长老");
  set("class", "bonze");
  set("age", 67);
  set("shen_type", 1);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("qi", 2500);
  set("max_qi", 2500);
  set("jing", 1000);
  set("max_jing", 1000);
  set("neili", 2500);
  set("max_neili", 2500);
  set("jiali", 150);
  set("combat_exp", 2000000);
  set("score", 900000);

  set_skill("force", 200);
  set_skill("tianlong-shengong", 210);
  set_skill("dodge", 197);
  set_skill("qingdie-shenfa", 200);
  set_skill("yiyang-zhi", 210);
  set_skill("sword", 200);
  set_skill("parry", 199);
  set_skill("finger", 220);
  set_skill("unarmed", 180);
  set_skill("lm-zhongchong", 261);
  set_skill("literate", 210);
  map_skill("force", "tianlong-shengong");
  map_skill("parry", "lm-zhongchong");
  map_skill("dodge", "qingdie-shenfa");
  map_skill("finger", "lm-zhongchong");
  prepare_skill("finger", "lm-zhongchong");
  create_family("大理段氏", 3, "长老");
  setup();
  carry_object("/d/shaolin/npc/obj/hui-cloth")->wear();
}

void attempt_apprentice(object ob) {
  int flag;
  mapping family = ob->query("family");
  flag = 0;
  if (sizeof(family) == 0) {
    command("say 天龙寺不收无名之徒的！");
    return;
  }
  if ((int)ob->query("betrayer") > 1 && family["family_name"] != "大理段氏") {
    command("say 你这个逆贼，岂能入我门下，贫僧今天就先杀了你以示后人！");
    kill_ob(ob);
    return;
  }
  if (ob->query("phlye") != 5) {
    command("say " + RANK_D->query_respect(ob) +
      "的根骨到是不错哟，我也想收你为徒，可是...\n" +
      "目前大理段氏只传武功给云南人，你还是等下辈子吧！");
    return;
  }
  if (family["generation"] <= this_object()->query("family/generation")
    && family["family_name"] == "大理段氏") {
    command("say 你的辈分不比我低了，我怎么能收你为徒呢？");
    return;
  }

  if ((int)ob->query("shen") < 200000) {
    command("say 我天龙乃是堂堂名门正派，对弟子要求极严。");
    command("say 在德行方面，" + RANK_D->query_respect(ob) +
      "是否还做得不够？");
    return;
  }
  if (ob->query_skill("finger", 1) < 30) {
    command("say 我们天龙很重视指力的练习，你的基本指法太低了！");
    flag = 1;
  }
  if (ob->query_skill("force", 1) < 40) {
    command("say 内力修为也应该好好重视的，你的基本内功太低了！");
    flag = 1;
  }
  if (ob->query_skill("yiyang-zhi", 1) < 35) {
    command("say 一阳指是天龙的一门必修的功夫，你还得多花些功夫！");
    flag = 1;
  }
  if (flag) {
    command("say 你还是等达到条件后再来找我吧！");
    return;
  }

  command("say 好吧，贫僧就收下你了。");
  command("recruit " + ob->query("id"));
}
