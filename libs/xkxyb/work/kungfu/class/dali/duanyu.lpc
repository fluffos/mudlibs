// duanyu.c 段誉

#include <ansi.h>

inherit NPC;
int do_test1();
int do_test2();
void create() {
  set_name("段誉", ({ "duan yu", "duan", "yu" }));
  set("nickname", RED "大理王子" NOR);
  set("gender", "男性");
  set("age", 20);
  set("long",
    "他是一个身穿青衫的年轻男子。脸孔略尖，自有一股书生的呆气。\n");
  set("attitude", "peaceful");

  set("str", 12);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("chat_chance", 2);
  set("chat_msg", ({
    "段誉叹了口气道：“唉......何时能再见到语嫣啊......”\n",
    "段誉皱了皱眉，为什么那么多人想拜我为师又不好好学周易？！！\n",
    (: random_move :),
    (: random_move :),
  }));

  set("inquiry", ([
    "大理": "大理是个好地方，山清水秀，风景宜人。\n",
    "王语嫣": "唉，她心里只有她表哥，从来就没把我放在眼里。\n",
    "拜师": "嗯....，我的师傅是老子、孔子和庄子，他们的学问我还没学全呢。\n",

  ]));

  set("jing", 2000);
  set("max_jing", 2000);
  set("jingli", 2000);
  set("max_jingli", 2000);
  set("qi", 2000);
  set("max_qi", 2000);
  set("neili", 4000);
  set("max_neili", 4000);
  set("jiali", 200);

  set("combat_exp", 2500000);
  set("score", 20000);

  set_skill("force", 300);  // 基本内功
  set_skill("beiming-shengong", 280);  // 北冥神功
  set_skill("finger", 320);  // 基本指法
  set_skill("sword", 220);  // 基本剑法
  set_skill("liumai-shenjian", 350);  // 六脉神剑
  set_skill("dodge", 250);  // 基本躲闪
  set_skill("lingboweibu", 390);  // 凌波微步
  set_skill("parry", 220);   // 基本招架

  map_skill("sword", "liumai-shenjian");
  map_skill("force", "beiming-shengong");
  map_skill("dodge", "lingboweibu");
  map_skill("parry", "liumai-shenjian");
  map_skill("finger", "liumai-shenjian");
  prepare_skill("finger", "liumai-shenjian");
  create_family("大理段氏", 3, "弟子");
  setup();

  carry_object("/d/dali/obj/jinduan")->wear();
}

void attempt_apprentice(object ob) {
  int phlye;
  mapping family = ob->query("family");

  if (family["family_name"] != "大理段氏") {
    command("say 我只识周易，这位" + RANK_D->query_respect(ob) + "也想跟我学学么？");
    return;
  }
  if (family["generation"] < 3
    && family["family_name"] == "大理段氏") {
    command("say 你的辈分那么高，我怎么能收你为徒呢？");
    return;
  }
  if ((int)ob->query("shen") < 20000) {
    command("say 我大理段氏乃是堂堂名门正派，对弟子要求极严。");
    command("say 在德行方面，" + RANK_D->query_respect(ob) +
      "是否还做得不够？");
    return;
  }
  if (ob->query_skill("liumai-shenjian", 1) < 46) {
    command("say 你连六脉合使都练不好，拜我又有什么用呢！");
    return;
  }
  command("say 好吧，我就收下你了。");
  command("recruit " + ob->query("id"));
}
