// /d/dali/npc/zhu.c 僬读渔耕四大护法之“书”——朱丹臣

inherit NPC;
inherit F_MASTER;

string ask_me();
void create() {
  set_name("朱丹臣", ({ "zhu danchen", "zhu", "shusheng", "danchen" }));
  set("gender", "男性");
  set("title", "中年书生");
  set("class", "bonze");
  set("age", 34);
  set("shen_type", 1);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("qi", 1200);
  set("max_qi", 1500);
  set("jing", 1500);
  set("max_jing", 1500);
  set("neili", 3000);
  set("max_neili", 3000);
  set("jiali", 150);
  set("combat_exp", 800000);
  set("score", 1000000);

  set_skill("force", 140);
  set_skill("tianlong-shengong", 150);
  set_skill("dodge", 160);
  set_skill("qingdie-shenfa", 143);
  set_skill("parry", 179);
  set_skill("sword", 133);
  set_skill("finger", 149);
  set_skill("literate", 290);
  set_skill("yiyang-zhi", 147);
  map_skill("finger", "yiyang-zhi");
  map_skill("dodge", "qingdie-shenfa");
  map_skill("force", "tianlong-shengong");
  prepare_skill("finger", "yiyang-zhi");

  set("inquiry", ([
    "六脉神剑谱": "“你不会是打什么主意吧？”\n",
    "六脉神剑": "“你不会是想和我较量较量吧？”\n",
    "四大护卫": (: ask_me :),
  ]));
  create_family("大理段氏", 6, "弟子");
  setup();
}

string ask_me() {
  set("title", "四大护卫之一");
  return "呵呵！你怎么知道我的身份的？想来你对大理段家比较熟悉嘛！\n";
}

int recognize_apprentice(object ob) {
  if (ob->query("family/family_name") == "大理段氏")
    return 1;
  return 0;
}
int is_apprentice_of(object ob) {
  return recognize_apprentice(ob);
}

void attempt_apprentice(object ob) {
  int phlye, nf;
  mapping family = ob->query("family");
  nf = 0;
  if (!pointerp(family))
    nf = 1;
  phlye = (int)ob->query("phlye");
  if (phlye != 5) {
    if (ob->query("shen") < 200000) {
      command("say " + RANK_D->query_respect(ob) +
        "的根骨到是不错哟，我也想收你为徒，可是...\n" +
        "目前大理段氏只传武功给云南人，何况你的劣迹太多了，你还是问问自己\n" +
        "够不够资格成为大理段氏的一员吧！");
      return;
    }
    command("say 我看这位" + RANK_D->query_respect(ob) + "到是一位侠义中人，就收下你吧！");
    if (ob->query("phlye") != 5)
      command("say 不过你从此就变为云南人氏了哟！");
    ob->set("phlye", 5);
    command("recruit " + ob->query("id"));
    return;
  }
  if (!nf && (int)ob->query("betrayer") > 1 && family["family_name"] != "大理段氏") {
    command("say 你这个逆贼，岂能入我门下，我今天就先杀了你以示后人！");
    kill_ob(ob);
    return;
  }
  if (!nf && family["generation"] <= this_object()->query("family/generation")
    && family["family_name"] == "大理段氏") {
    command("say 你的辈分不比我低了，我怎么能收你为徒呢？");
    return;
  }
  if ((int)ob->query("shen") < 0) {
    command("say 我大理段氏乃是堂堂名门正派，对弟子要求极严。");
    command("say 在德行方面，" + RANK_D->query_respect(ob) +
      "是否还做得不够？");
    return;
  }
  command("say 好吧，我就收下你了。");
  command("recruit " + ob->query("id"));
}

int accept_object(object me, object ob) {
  if (me->query_skill("literate", 1) > 60) {
    message_vision("朱丹臣呵呵地笑了笑，你的读书识字水平已经够高了，小的水平无法教你！\n", me);
    return 0;
  }
  if (ob->query("money_id") && ob->value() < 2000000) {
    message_vision("朱丹臣对$N摇摇头说：读书识字得二百两黄金。\n", me);
    return 0;
  }

  message_vision("朱丹臣点了点头，你什么时间有空就可以来" +
    "我这里学(xue/learn)点读书识字的本领了。\n", me);
  me->set("jackyboy/xue_from_zhu", 1);
  add_action("do_xue", "xue");
  add_action("do_xue", "learn");
  return 1;
}

void init() {
  object me;
  me = this_player(1);
  if (me->query("jackyboy/xue_from_zhu") == 1) {
    add_action("do_xue", "xue");
    add_action("do_xue", "learn");
  }
}

int do_xue(string arg) {
  object ob, me;
  int gin_cost, grade, my_combat_exp, my_skill;
  string teacher, skill;
  if (!arg || arg == "")
    return notify_fail("指令格式：learn|xue <某人> <技能>\n");
  ob = this_object();
  me = this_player(1);
  if (me->query("jackyboy/xue_from_zhu") != 1)  //只有交过钱才可能用xue这个命令！
    return notify_fail("朱丹臣笑了笑，孺子可教，已经这么高的水平了依然不忘了学习！" +
      "\n不过你已经从我这里毕业了，我的水平是不能再教你了，你还是另请高就吧！\n");
  if (sscanf(arg, "%s %s", teacher, skill) != 2)
    return 0;
  if (member_array(teacher, ob->parse_command_id_list()) == -1)
    return 0;
  if (skill != "literate")
    return 0;
  if (me->is_fighting())
    return notify_fail("临阵磨枪？来不及啦。\n");
  if (!living(ob))
    return notify_fail("嗯....你得先把" + ob->name() + "弄醒再说。\n");
  if (!SKILL_D(skill)->valid_learn(me)) return SKILL_D(skill)->valid_learn(me);

  gin_cost = 150 / (int)me->query("int") + 1;
  if ((int)me->query("learned_points") >= (int)me->query("potential"))
    return notify_fail("你的潜能已经发挥到极限了，没有办法再成长了。\n");
  printf("你向%s请教有关「%s」的疑问。\n", ob->name(), to_chinese(skill));
  my_combat_exp = (int)me->query("combat_exp");
  if (my_combat_exp < 10000)
    grade = 1;
  else if (my_combat_exp < 80000)
    grade = 3;
  else if (my_combat_exp < 500000)
    grade = 7;
  else
    grade = 13;
  if (grade < 1)
    grade = 1;
  if (!(my_skill = me->query_skill(skill, 1))) {
    gin_cost *= 2;
    me->set_skill(skill, 0);
  }
  if ((int)me->query("jing") > gin_cost) {
    if ((string)SKILL_D(skill)->type() == "martial"
      && my_skill * my_skill * my_skill / 10 > (int)me->query("combat_exp")) {
      printf("也许是缺乏实战经验，你对%s的回答总是无法领会。\n", ob->name());
    } else {
      printf("你听了%s的指导，似乎有些心得。\n", ob->name());
      me->add("learned_points", 1);
      me->improve_skill(skill, grade * (10 + random((int)me->query("int") - 9)));
    }
  } else {
    gin_cost = me->query("jing");
    write("你今天太累了，结果什么也没有学到。\n");
  }
  me->receive_damage("jing", gin_cost);

  if (me->query_skill("literate", 1) > 60) {
    me->delete("jackyboy/xue_from_zhu");
    message_vision("朱丹臣双手做了个揖，对$N说道：你已经学业有成，可以毕业了！呵呵。\n", me);
  }
  return 1;
}
