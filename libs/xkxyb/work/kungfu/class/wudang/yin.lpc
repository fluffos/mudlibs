// yin.c 殷梨亭

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("殷梨亭", ({ "yin litin", "yin" }));
  set("nickname", "武当六侠");
  set("long",
    "他就是张三丰的六弟子殷梨亭。\n"
    "他今年三十岁，精明能干，嫉恶如仇，性如烈火。\n");
  set("gender", "男性");
  set("age", 30);
  set("attitude", "heroism");
  set("shen_type", 1);
  set("str", 26);
  set("int", 30);
  set("con", 26);
  set("dex", 28);

  set("max_qi", 3200);
  set("max_jing", 2000);
  set("neili", 4500);
  set("max_neili", 4500);
  set("jiali", 150);
  set("combat_exp", 1800000);
  set("combat_exp", 1400000);
  set("score", 600000);

  set_skill("force", 180);
  set_skill("taiji-shengong", 180);
  set_skill("dodge", 200);
  set_skill("tiyunzong", 200);
  set_skill("unarmed", 180);
  set_skill("taiji-quan", 180);
  set_skill("parry", 200);
  set_skill("sword", 170);
  set_skill("taiji-jian", 170);
  set_skill("taoism", 120);
  set_skill("literate", 150);

  map_skill("force", "taiji-shengong");
  map_skill("dodge", "tiyunzong");
  map_skill("unarmed", "taiji-quan");
  map_skill("parry", "taiji-jian");
  map_skill("sword", "taiji-jian");

  create_family("武当派", 2, "弟子");

  set("chat_chance_combat", 40);
  set("chat_msg_combat", ({
    (: perform_action, "sword.chan" :),
    (: perform_action, "sword.lian" :),
    (: perform_action, "sword.sui" :),
    (: exert_function, "recover" :),
  }));

  setup();
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/d/wudang/obj/whiterobe")->wear();
}
void init() {
  ::init();
  remove_call_out("greeting");
  call_out("greeting", 1, this_player());
}


void greeting(object ob) {
  mapping fam;
  int i;
  object me;
  object *obj;
  me = this_object();
  if (interactive(ob)
    && !environment(ob)->query("no_fight")) {
    if (!(fam = ob->query("family")) || fam["family_name"] != "武当派") {
      if (ob->query("shen") > -1000) {
        command("say 这里是武当重地，你在这里瞎逛什么？");
        obj = all_inventory(environment(me));
        for (i = 0; i < sizeof(obj); i++) {
          if (obj[i] == this_player()) continue;
          if (obj[i] == me) continue;
          if ((obj[i]->query("title") == "盗贼") || (obj[i]->query("shen") < -1000)) {
            command("say 大胆蟊贼,敢在此胡作非为,看招!!");
            me->kill_ob(obj[i]);
            obj[i]->kill_ob(me);
          }
        }
      }

      else {
        command("say 一定要杀了你这江湖败类！");
        me->set_leader(ob);
        remove_call_out("kill_ob");
        call_out("kill_ob", 1, ob);

      }

    }
  }

}

void attempt_apprentice(object ob) {
  if ((int)ob->query("shen") < 10000) {
    command("say 我武当乃是堂堂名门正派，对弟子要求极严。");
    command("say 在德行方面，" + RANK_D->query_respect(ob) +
      "是否还做得不够？");
    return;
  }
  if ((int)ob->query_skill("taiji-shengong", 1) < 60 ||
    (int)ob->query_skill("force", 1) < 60) {
    command("say 我武当派最注重内功心法" + RANK_D->query_respect(ob) +
      "是否应该在内功上多下点功夫啊?");
    return;
  }
  command("say 好吧，我就收下你了。");
  command("say 希望你能好好用功,发扬我武当精神!");
  command("recruit " + ob->query("id"));
  if ((string)ob->query("class") != "taoist")
    ob->set("class", "taoist");
}
