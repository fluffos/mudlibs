// hufei.c
#include <ansi.h>
inherit NPC;
string ask_me();
void do_kill(object ob);

void create() {
  set_name("陈家洛", ({ "chen jialuo", "chen", "jialuo" }));
  set("gender", "男性");
  set("title", HIR "红花会总舵主" NOR);
  set("age", 28);
  set("long",
    "他就是名震江湖的红花会总舵主。\n"
  );
  set("attitude", "peaceful");
  set("str", 25);
  set("int", 28);
  set("con", 23);
  set("dex", 24);
  set("shen", 70000);
  set("chat_chance", 30);
  set("chat_msg", ({
    "陈家洛叹了口气道:“香香公主，我对不起你啊！”\n",
    "陈家洛恨恨道：“乾隆是个狗皇帝！”\n",
  }));

  set("qi", 2000);
  set("max_qi", 2000);
  set("jing", 400);
  set("max_jing", 400);
  set("jingli", 100);
  set("max_jingli", 100);
  set("neili", 3500);
  set("max_neili", 2000);
  set("jiali", 100);
  set("combat_exp", 900000);
  set("score", 20000);
  set("food", 500);
  set("water", 500);
  set_skill("force", 160);
  set_skill("honghua-shengong", 150);
  set_skill("dodge", 180);
  set_skill("shenxing-baibian", 150);
  set_skill("parry", 170);
  set_skill("cuff", 180);
  set_skill("baihua-cuoquan", 170);
  set_skill("blade", 180);
  set_skill("paoding-daofa", 170);
  map_skill("force", "honghua-shengong");
  map_skill("cuff", "baihua-cuoquan");
  map_skill("dodge", "shenxing-baibian");
  map_skill("parry", "paoding-daofa");
  map_skill("blade", "paoding-daofa");
  prepare_skill("cuff", "baihua-cuoquan");
  set("inquiry", ([
    "红花会": "兄弟们全都阵亡啦！",
  ]));
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: perform_action, "blade.yangshen" :),
    (: exert_function, "recover" :),
  }));
  setup();
  create_family("红花会", 2, "总舵主");
  carry_object("/clone/weapon/gangdao")->wield();
  carry_object("/d/city/obj/cloth")->wear();
}
void attempt_apprentice(object ob) {
  if ((int)ob->query("shen") < 0) {
    command("say 红花会不收江湖败类。");
    return;
  }
  command("say 反清复明，后继有人啦！");
  command("recruit " + ob->query("id"));
}
