// fuxue.c 拈花拂穴

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target) {
  int busytime;
  object weapon;
  string msg;
  busytime = (int)me->query_skill("nianhua-zhi") / 10;
  if (busytime > 10) busytime = 10;

  if ((me->query("family/family_name") != "少林派"))
    return notify_fail("你不是少林派弟子，无法施展「拈花拂穴」。\n");
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("拈花拂穴只能对战斗中的对手使用。\n");

  if (objectp(weapon = me->query_temp("weapon")))
    return notify_fail("拈花拂穴必须空手才能使用。\n");

  if (target->is_busy())
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧。\n");

  if ((int)me->query_skill("nianhua-zhi", 1) < 40)
    return notify_fail("你的拈花指不够娴熟，不会使用「拈花拂穴」。\n");

  msg = HIG "$N使出「拈花拂穴」，一指点向$n的人身大穴。\n";

  me->start_busy(1);
  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 5) {
    msg += HIR " 结果$p被$P点得不能动弹了！\n" NOR;
    target->start_busy(busytime);
  } else {
    msg += "可是$p看破了$P的企图，并没有上当。\n" NOR;
  }
  message_vision(msg, me, target);

  return 1;
}
