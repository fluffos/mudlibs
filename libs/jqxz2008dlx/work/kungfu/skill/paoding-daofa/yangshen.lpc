#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target) {
  object weapon, ob;
  string msg, string1;
  int lvl1, lvl2, amount, count;

  if (userp(me) && !wizardp(me) && (me->query("family/family_name") != "红花会"))
    return notify_fail("你不是红花会成员，无法施展「养身之道」。\n");
  if (!me->is_fighting())
    return notify_fail("「养身之道」只能在战斗中使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对。\n");

  if ((int)me->query("neili") < 200)
    return notify_fail("你的真气不够！\n");
  if ((int)me->query_skill("honghua-shengong") < 60)
    return notify_fail("你的红花神功还不够，无法领会庖丁解牛刀法的「养身之道」。\n");
  if ((int)me->query_skill("blade") < 60 ||
    me->query_skill_mapped("blade") != "paoding-daofa")
    return notify_fail("你的刀法还不到家，无法使用绝技「养身之道」！\n");

  lvl1 = me->query_skill("force");

  lvl2 = me->query_skill("blade");

  amount = (lvl1 + lvl2) / 15;

  if (amount < 40) amount = 40;
  if (amount > 80) amount = 80;
  me->add_temp("apply/damage", amount / 2);
  me->add_temp("apply/attack", amount);
  me->add_temp("apply/dodge", amount);
  msg = HIR "$N微微一笑道“杀汝以养吾身！”，动刀似乎甚微。\n" NOR;
  message_vision(msg, me);

  me->clean_up_enemy();
  ob = me->select_opponent();

  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"));
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"));
  COMBAT_D->do_attack(me, ob, me->query_temp("weapon"));
  me->add_temp("apply/damage", -amount / 2);
  me->add_temp("apply/attack", -amount);
  me->add_temp("apply/dodge", -amount);
  me->add("neili", -amount);
  me->start_busy(1);

  return 1;
}
