// dianxue.c 隔空点穴

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target) {
  int busytime;
  object weapon;
  string msg;
  busytime = (int)me->query_skill("yiyang-zhi") / 10;
  if (busytime > 15) busytime = 15;

  if ((me->query("family/family_name") != "天龙寺"))
    return notify_fail("你不是大理天龙寺弟子，无法施展「隔空点穴」。\n");
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("隔空点穴只能对战斗中的对手使用。\n");

  if (objectp(weapon = me->query_temp("weapon")))
    return notify_fail("隔空点穴必须空手才能使用。\n");

  if (target->is_busy())
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧。\n");
  if ((int)me->query_skill("kurong-changong", 1) < 60)
    return notify_fail("你的枯荣禅功修为不够，使用不了「隔空点穴」。\n");
  if ((int)me->query_skill("yiyang-zhi", 1) < 80)
    return notify_fail("你的一阳指不够娴熟，不会使用「隔空点穴」。\n");

  msg = HIG "$N使出「隔空点穴」，一指遍袭$n的数处要穴。\n";

  me->start_busy(1);
  //	if( random(me->query("combat_exp")) > (int)target->query("combat_exp")/10 ) 
  if (random((int)me->query_skill("yiyang-zhi", 1)) * 5 > (int)target->query_skill("dodge")) {
    msg += HIR " 结果$p被$P点得不能动弹了！\n" NOR;
    target->start_busy(busytime);
  } else {
    msg += "可是$p看破了$P的企图，并没有上当。\n" NOR;
  }
  message_vision(msg, me, target);

  return 1;
}
