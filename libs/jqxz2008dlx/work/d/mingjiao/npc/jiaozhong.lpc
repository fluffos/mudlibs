inherit NPC;

void create() {
  set_name("明教教众", ({ "jiao zhong" }));
  set("gender", "男性");

  set("age", 27);
  set("long", "这是明教教众之中很平凡的一位。\n");
  set("shen_type", 1);
  set("combat_exp", 15000);

  set("attitude", "peaceful");

  set("apply/attack", 50);
  set("apply/defense", 50);

  set("neili", 150);
  set("max_neili", 150);
  set_skill("unarmed", 40);
  set_skill("blade", 40);
  set_skill("parry", 40);
  set_skill("dodge", 40);

  setup();
  carry_object("/clone/misc/cloth")->wear();
  carry_object("/clone/weapon/gangdao")->wield();
  add_money("silver", 10);
}
