//xuedao.c
#include <ansi.h>
#include <weapon.h>

inherit BLADE;

void create() {
  set_name(RED "血刀" NOR, ({ "xue dao", "blade", "dao" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 0);
    set("material", "iron");
    set("long", "这是当年血刀老祖名震江湖的血刀。\n");
    set("wield_msg", "$N恶狠狠地把$n抽了出来，好重的杀气！\n");
    set("unwield_msg", "$N将$n插回腰间，杀气久久没有消退。\n");
  }
  init_blade(300);
  setup();
}
