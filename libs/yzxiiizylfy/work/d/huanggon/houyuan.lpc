#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "清和殿后院");
	set("long", @LONG
这里是清和殿后院。院里种着些青菜。墙角有一口水井(well)。
站在水井边往下看，只觉深不见底，井壁上满是滑溜溜的青苔。一个
轱辘吊着一根长绳，绳端系着一个木桶。东边是一条走廊，通往清和
殿。
LONG
	);
        set("outdoors", "huanggon");
	set("resource/water", 1);
	set("exits", ([
		"east" : __DIR__"chufang",
	]));
	set("item_desc", ([
	"well" : "一口枯井,相传跳进去可以美容\n"
]));

	setup();
}

// add by unix 1998.11
	void init()
{
	add_action("do_jump", "jump");
}
	int do_jump(string arg)
{
	if(!arg||arg!="well")
{
	write ("你要往那跳!\n");
return 1;
}
	message_vision("$N看看水井, 拣起一块石头扔进水井!\n",this_player());
	if(arg=="well")
{
	if((int)this_player()->query_skill(
"dodge")<100)
{
	message_vision(HIY"$N奋力跳入井中, 可无法潜到水底!\n"NOR,this_player());
return 1;
}
	else if((int)this_player()->query_skill("dodge")>=100)
{
	message_vision(HIW"只听『哗砬』一声, $N已消失水中, $N奋力向最深处\n"NOR+
HIY"游去, $N眼前一亮, 一道石门挡在前面。\n"NOR,this_player());
	this_player()->move("/d/huanggon/jianlao");
return 1;
}
}
}
