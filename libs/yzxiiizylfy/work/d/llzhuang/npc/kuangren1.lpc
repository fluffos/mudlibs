#include <ansi.h>
inherit NPC;
#include <random_name.h>
void create()
{
       string name,nickname;
        name = comm_man_name();
        nickname = comm_man_nick();
	set_name(name, ({ "kuang ren"}) );
        set("nickname",nickname);
	set("long",@LONG
他眼神凶狠无比，狠狠瞪视着你。
LONG
	 );
	set("max_jing", 1111000);
	set("max_qi", 501100);                    
	set("max_sen", 111000);
	set("max_neili",511000); 
	set("neili",501100);
	set("jiali",51110);     
	set("combat_exp",15100000);
	set("cor",13110);
	set("age",35);
         set_skill("pixie-jian", 1020);
        set_skill("force", 1200);
        set_skill("hamagong", 1800);
        set_skill("dodge", 1280);
        set_skill("unarmed", 1250);
        set_skill("xingxiu-duzhang", 1200);
        set_skill("parry", 1150);
        set_skill("zhaixinggong",1300);
        set_skill("tianshan-zhang", 1215);
        map_skill("force", "hamagong");
        map_skill("dodge", "zhaixinggong");
        map_skill("unarmed", "xingxiu-duzhang");
        map_skill("parry", "pixie-jian");
        map_skill("sword","pixie-jian");
	set("chat_chance_combat",10);
        set("chat_msg_combat", ({
		(: exert_function,"powerup" :),
        }) );

	setup();
        carry_object("/clone/weapon/changjian")->wield();
}
void init()
{
        object ob;
        ::init();
        if (interactive(ob = this_player())) {
                remove_call_out("kill_ob");
                call_out("kill_ob", 1, ob);
        }
}
