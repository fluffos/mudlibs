#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{
        if (!me->query_temp("pending/breakup"))
        {
        me->apply_condition("breakup",0);
        return 0;
        }

        if ((me->query("potential")-me->query("learn_point"))<1)
        {
        message_vision(HIM"$N的潜能耗尽，但是任督二脉仍然未能如愿打通，只好失望站了起来。\n"NOR,me);
        me->apply_condition("breakup",0);
	me->delete_temp("pending/breakup");
	me->delete("breakpot");
        me->delete("potcost");
//      me->start_busy(-1000000);
        return 0;
        }

	if(duration == 0 && me->query_temp("pending/breakup"))
	{
        tell_object(me,HIG"你突然感到五骸内真气流通奔涌，如条条水银般奔流不止。\n"NOR);
        tell_object(me,WHT"突然之间，真气尽皆加速，急速环绕大小周天，过丹田，经檀中，往任督二脉冲去。\n"NOR);
        tell_object(me,HIC"你只觉得真气鼓涨全身，在任督二脉处通行不过，好生难过，突然……\n"NOR);
        tell_object(me,MAG"你只觉得脑中“轰”地一声，真气突破禁制，冲过任督二脉，流过全身，舒坦无比。\n"NOR);
        tell_object(me,HIY"你睁开眼睛，举目四望，只觉得眼明目清，起身动作轻盈，功力显然大有进步。\n"NOR);
        message_vision(CYN"你长啸一声，站起身来，只见双眼精光四射，显然大有长进。\n"NOR, me);
        message("channel:rumor", HIM"【江湖传言】听说"+me->query("name")+"闭关苦修，打通了任督二脉，功力大有长进。\n"NOR, users());
        me->add("potential",-me->query_temp("breakpot"));
	me->delete_temp("pending/breakup");
	me->delete("breakpot");
        me->delete("potcost");
        me->set("rendu",1);
        me->add("con",3);
        me->add("wuxing",5);
        me->add("dex",3);
        me->add("str",3);
//      me->start_busy(-1000000);
	return 0;
	}
	me->apply_condition("breakup", duration - 1);
        me->add("potential",-me->query("potcost"));
	return CND_CONTINUE;

}
