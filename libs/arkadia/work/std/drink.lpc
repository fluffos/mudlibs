/*
 * /std/drink.c — minimal drink base for example objects (archive never shipped one).
 * Pattern mirrors /std/food.c (create_heap -> create_drink) with soft/alco amounts.
 */

#pragma strict_types

inherit "/std/heap";

#include <macros.h>
#include <stdproperties.h>

nosave int soft_amount;
nosave int alco_amount;
nosave string drink_msg;

public void create_drink()
{
}

public nomask void
create_heap()
{
    set_heap_size(1);
    add_prop(OBJ_M_NO_SELL, "Drinks are not to be resold.\n");

    set_name("drink");
    set_pname("drinks");

    create_drink();

    if (!query_prop(HEAP_S_UNIQUE_ID))
        add_prop(HEAP_S_UNIQUE_ID, query_long() || "drink");
}

public void
set_long(string long)
{
    ::set_long(long);

    if (!query_prop(HEAP_S_UNIQUE_ID))
        add_prop(HEAP_S_UNIQUE_ID, long);
}

public void
set_drink_msg(string str)
{
    drink_msg = str;
}


/* English example beers call set_adj(); Polish object.h disabled it (#if 0). */
public void
set_adj(mixed adj)
{
    string a = stringp(adj) ? adj : (pointerp(adj) && sizeof(adj) ? adj[0] : "x");
    dodaj_przym(a, a);
}

public void
set_soft_amount(int a)
{
    soft_amount = a;
    add_prop(OBJ_I_VOLUME, a);
    add_prop(OBJ_I_WEIGHT, a);
}

public int
query_soft_amount()
{
    return soft_amount;
}

public void
set_alco_amount(int a)
{
    alco_amount = a;
}

public int
query_alco_amount()
{
    return alco_amount;
}
