#define F_ROOM_RESET_USED        1
#define F_ROOM_INIT_USED         2

private nosave int flags;
private nosave int lumens;
private nosave mixed brief;
private nosave mixed description;
private nosave mapping exits;
private nosave mapping items;
private nosave mapping commands;
private nosave object *permanent_objects;
private nosave string *permanent_names;
private nosave mixed *transient_objects;

void _apply_calls(object ob, mixed *spec);

int
query_lumens()
{
    return lumens;
}

void
set_lumens(int arg)
{
    lumens = arg;
}

string
query_brief()
{
    return brief;
}

void
set_brief(mixed arg)
{
    if (!stringp(arg)) {
	return;
    }

    brief = arg;
}

string
query_description()
{
    return description;
}

void
set_description(mixed arg)
{
    if (!stringp(arg)) {
	return;
    }

    description = arg;
}

string
query_long()
{
    return query_description();
}

string
long()
{
    return query_description();
}

string
query_exit_string()
{
    string *dirs;
    string out;
    int i, n;

    if (!exits || !sizeof(exits)) {
	return "There are no obvious exits.\n";
    }
    dirs = keys(exits);
    n = sizeof(dirs);
    if (n == 1) {
	return "The only obvious exit is " + dirs[0] + ".\n";
    }
    out = "The obvious exits are ";
    for (i = 0; i < n; i++) {
	if (i == n - 1)
	    out += " and " + dirs[i];
	else if (i)
	    out += ", " + dirs[i];
	else
	    out += dirs[i];
    }
    return out + ".\n";
}

mapping
query_exits()
{
    return exits;
}

void
set_exits(mapping arg)
{
    if (!arg) {
	exits = 0;

	return;
    }

    if (!mapp(arg) || !sizeof(m_indices(arg))) {
	return;
    }

    exits = deep_copy(arg);
}

mixed
query_exit(string arg)
{
    if (!arg || !exits || !sizeof(exits)) {
	return 0;
    }

    return exits[arg];
}

void
add_exit(string dir, mixed room)
{
    if (!stringp(dir) || !stringp(room)) {
	return;
    }

    if (!exits) {
	exits = ([ dir: room ]);
    } else {
	exits[dir] = room;
    }
}

void
remove_exit(string arg)
{
    if (exits && mapp(exits)) {
	exits = m_delete(exits, arg);
    }

    if (!sizeof(exits)) {
	exits = 0;
    }
}

mapping
query_items()
{
    mapping ret = deep_copy(items);

    if (ret && mapp(ret) && sizeof(ret)) {
	string synonym;

	foreach (string key, string val in ret) {
	    if (sscanf(val, "=%s", synonym) == 1 && member(ret, synonym)) {
		ret[key] = ret[synonym];
	    }
	}
    }

    return ret;
}

void
set_items(mapping arg)
{
    mixed item;
    mixed *ks;
    int i;

    if (!arg) {
	items = 0;

	return;
    }

    if (!mapp(arg) || !sizeof(m_indices(arg))) {
	return;
    }

    items = deep_copy(arg);

    ks = m_indices(arg);
    for (i = 0; i < sizeof(ks); i++) {
	item = ks[i];
	if (pointerp(item) && sizeof(item)) {
	    string synonym;
	    mixed element;
	    int j;

	    for (j = 0; j < sizeof(item); j++) {
		element = item[j];
		if (stringp(element)) {
		    if (!synonym) {
			synonym = element;
			items[element] = arg[item];
		    } else {
			items[element] = sprintf("=%s", synonym);
		    }
		}
	    }

	    items = m_delete(items, item);
	}
    }
}

mixed
query_item(string arg)
{
    string synonym;
    mixed val;

    if (!arg || !items || !sizeof(items)) {
	return 0;
    }

    if (stringp(items[arg])
	&& sscanf(items[arg], "=%s", synonym) == 1
	&& member(items, synonym)) {
	val = items[synonym];
    } else {
	val = items[arg];
    }

    if (stringp(val) && strsrch(val, " ") == -1
	&& function_exists(val, this_object())) {
	return call_other(this_object(), val);
    }

    return val;
}

void
add_item(mixed item, mixed desc)
{
    if (!stringp(desc)) {
	return;
    }

    if (!items) {
	items = ([ item: desc ]);
    } else {
	items[item] = desc;
    }

    if (pointerp(item) && sizeof(item)) {
	string synonym;
	mixed element;
	int j;

	for (j = 0; j < sizeof(item); j++) {
	    element = item[j];
	    if (stringp(element)) {
		if (!synonym) {
		    synonym = element;
		    items[element] = desc;
		} else {
		    items[element] = sprintf("=%s", synonym);
		}
	    }
	}

	items = m_delete(items, item);
    }
}

void
remove_item(string arg)
{
    string synonym;
    mixed *ks;
    int i;

    if (items && mapp(items)) {
	items = m_delete(items, arg);
    }

    if (!items) {
	return;
    }

    synonym = sprintf("=%s", arg);
    ks = keys(items);
    for (i = 0; i < sizeof(ks); i++) {
	if (stringp(items[ks[i]]) && items[ks[i]] == synonym) {
	    items = m_delete(items, ks[i]);
	}
    }

    if (!sizeof(items)) {
	items = 0;
    }
}

mapping
query_commands()
{
    return commands;
}

void
set_commands(mapping arg)
{
    if (!arg) {
	commands = 0;
	return;
    }

    if (!mapp(arg) || !sizeof(m_indices(arg))) {
	return;
    }

    commands = deep_copy(arg);
}

mixed
query_command(string arg)
{
    if (!arg || !commands || !sizeof(commands)) {
	return 0;
    }

    return commands[arg];
}

void
add_command(string cmd, mixed func)
{
    if (!stringp(cmd) || !stringp(func)) {
	return;
    }

    if (!mapp(commands)) {
	commands = ([ cmd: func ]);
    } else {
	commands[cmd] = func;
    }
}

void
remove_command(string arg)
{
    if (commands && mapp(commands)) {
	commands = m_delete(commands, arg);
    }

    if (!sizeof(commands)) {
	commands = 0;
    }
}

void
_apply_calls(object ob, mixed *spec)
{
    int i, n, s;
    mixed *a;

    n = sizeof(spec);
    for (i = 1; i < n; i++) {
	if (!pointerp(spec[i])) {
	    continue;
	}
	a = spec[i];
	s = sizeof(a);
	if (s < 1) {
	    continue;
	}
	if (s == 1) {
	    call_other(ob, a[0]);
	} else if (s == 2) {
	    call_other(ob, a[0], a[1]);
	} else if (s == 3) {
	    call_other(ob, a[0], a[1], a[2]);
	} else {
	    call_other(ob, a[0], a[1], a[2], a[3]);
	}
    }
}

void
add_permanent_object(mixed arg)
{
    object ob;
    string file;

    if (stringp(arg)) {
	file = arg;
	catch(ob = clone_object(file));
    } else if (pointerp(arg) && sizeof(arg) && stringp(arg[0])) {
	file = arg[0];
	catch(ob = clone_object(file));
	if (ob)
	    _apply_calls(ob, arg);
    } else {
	return;
    }

    if (!ob) {
	return;
    }

    if (!pointerp(permanent_names)) {
	permanent_objects = ({});
	permanent_names = ({});
    }

    move_object(ob, this_object());

    permanent_objects += ({ ob });
    permanent_names += ({ file });
}

void
reset_permanent_objects()
{
    int s, i, k;

    if (pointerp(permanent_names) && (s = sizeof(permanent_names))) {
	i = 0;

	while (i < s) {
	    if (!permanent_objects[i]) {
		permanent_objects[i] = clone_object(permanent_names[i]);
		k++;
	    }

	    i++;
	}

	if (k || first_inventory() != permanent_objects[0]) {
	    i = s;

	    while ((--i) >= 0) {
		move_object(permanent_objects[i], this_object());
	    }
	}
    }
}

varargs void
add_transient_object(mixed arg, string appearmsg, int reset_chance)
{
    object ob;

    if (!stringp(arg) && !pointerp(arg) && !objectp(arg)) {
	return;
    }

    if (objectp(arg)) {
	ob = arg;
    }

    if (reset_chance && reset_chance < random(101)) {
	;
    } else {
	if (stringp(arg)) {
	    catch (ob = clone_object(arg));
	} else if (pointerp(arg)) {
	    catch (ob = clone_object(arg[0]));
	}

	if (!ob) {
	    return;
	}

	if (pointerp(arg)) {
	    _apply_calls(ob, arg);
	}

	if (!transient_objects) {
	    transient_objects = ({});
	}

	transient_objects += ({({ ob, arg, appearmsg, reset_chance })});
    }

    if (ob) {
	move_object(ob, this_object());
    }

    if (ob && appearmsg) {
	say(sprintf("%s\n", appearmsg), ob);
    }
}

void
reset_transient_objects()
{
    int i, n;
    mixed transient_data;
    object ob;
    mixed object_info;
    string appearmsg;
    int reset_chance;
    int new_clone;

    if (!pointerp(transient_objects)) {
	return;
    }

    n = sizeof(transient_objects);
    for (i = 0; i < n; i++) {
	transient_data = transient_objects[i];
	if (!pointerp(transient_data)) {
	    continue;
	}

	ob = transient_data[0];
	object_info = transient_data[1];
	appearmsg = transient_data[2];
	reset_chance = transient_data[3];

	if (!object_info || (!stringp(object_info) && !pointerp(object_info))) {
	    transient_objects[i] = 0;
	    continue;
	}

	if (reset_chance && reset_chance < random(101)) {
	    continue;
	}

	if (ob && environment(ob) == this_object()) {
	    continue;
	}

	new_clone = 0;

	if (!ob || !ob->is_npc()) {
	    new_clone = 1;

	    if (stringp(object_info)) {
		catch (ob = clone_object(object_info));
	    } else if (pointerp(object_info)) {
		catch (ob = clone_object(object_info[0]));
	    }
	}

	if (!ob) {
	    continue;
	}

	if (new_clone) {
	    if (pointerp(object_info)) {
		_apply_calls(ob, object_info);
	    }

	    transient_data[0] = ob;
	}

	if (!new_clone && ob && ob->is_npc()
	    && (ob->query_attack() || ob->query_master())) {
	    continue;
	}

	move_object(ob, this_object());

	if (ob && appearmsg) {
	    say(sprintf("%s\n", appearmsg), ob);
	}
    }

    transient_objects -= ({ 0 });
}

varargs int
move(string dir, string room)
{
    if (!this_player()) {
	return 0;
    }

    if (!dir) {
	dir = query_verb();
    }

    if (!room && (!exits || !(room = exits[dir]))) {
	return 0;
    }

    if (stringp(room)) {
	this_player()->move_player(dir + "#" + room);
    } else {
	this_player()->move_player(dir, room);
    }
    return 1;
}

int
id(string arg)
{
    if (items && arg && items[arg]) {
	return 1;
    }

    return 0;
}

void
create()
{
    if (function_exists("reset_room", this_object())) {
	flags |= F_ROOM_RESET_USED;
    }

    this_object()->create_room();

    if (function_exists("init_room", this_object())) {
	flags |= F_ROOM_INIT_USED;
    }
}

void
reset()
{
    if (flags & F_ROOM_RESET_USED) {
	this_object()->reset_room();
    }

    if (!this_object()) {
       return;
    }

    if (pointerp(permanent_names)) {
	reset_permanent_objects();
    }

    if (pointerp(transient_objects)) {
	reset_transient_objects();
    }
}

void
init()
{
    add_action("command_driver", "", 1);

    if (flags & F_ROOM_INIT_USED) {
	this_object()->init_room();
    }

    if (!this_player()) {
	return;
    }
}

void
heart_beat()
{
}

int
search_cmd(string arg)
{
    tell_object(this_player()
	, "You search around, but did not find any interesting discoveries.\n");

    return 1;
}

int
listen_cmd(string arg)
{
    tell_object(this_player()
	, "You listen intently, but did not hear any interesting sounds.\n");

    return 1;
}

int
smell_cmd(string arg)
{
    tell_object(this_player()
	, "You sniff vigorously, but did not detect any interesting scents.\n");

    return 1;
}

int
command_driver(string arg)
{
    string verb;
    mixed func;
    int ret;

    verb = query_verb();

    if (commands && sizeof(commands) && (func = commands[verb])) {
	if (stringp(func)) {
	    ret = call_other(this_object(), func, arg);
	}

	if (ret) {
	    return ret;
	}
    }

    if (exits && (func = exits[verb])) {
	if (stringp(func) || objectp(func)) {
	    ret = move(verb, func);
	}

	if (ret) {
	    return ret;
	}
    }

    if (verb == "search") {
	return search_cmd(arg);
    }

    if (verb == "listen" || verb == "hear") {
	return listen_cmd(arg);
    }

    if (verb == "smell") {
	return smell_cmd(arg);
    }

    if (this_player() && this_player()->is_npc()) {
	ret = this_player()->command_driver(arg);

	if (ret) {
	    return ret;
	}
    }

    return 0;
}
