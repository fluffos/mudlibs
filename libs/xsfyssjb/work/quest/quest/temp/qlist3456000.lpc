#include <ansi.h>
inherit SKILL;
mapping *quest = ({
        ([      "quest":                "羽天白",
                "quest_type":           "杀",
                "exp_bonus":            80,
        ]),
        ([      "quest":               HIG"小楼一夜听春雨"NOR,
                "quest_type":           "寻",
                "exp_bonus":            80,
        ]),
        ([      "quest":               HIW"白羽袍"NOR,
                "quest_type":           "寻",
                "exp_bonus":            80,
        ]),
        ([      "quest":                "定邦大师",
                "quest_type":           "杀",
                "exp_bonus":            80,
        ]),
        ([      "quest":               "金刚杵" ,
                "quest_type":           "寻",
                "exp_bonus":            80,
        ]),
        ([      "quest":                "云空",
                "quest_type":           "杀",
                "exp_bonus":            80,
        ]),
        ([      "quest":                "云明",
                "quest_type":           "杀",
                "exp_bonus":            80,
        ]),
        ([      "quest":               "紫铜禅杖" ,
                "quest_type":           "寻",
                "exp_bonus":            80,
        ]),  
});
mapping query_quest()
{
        return quest[random(sizeof(quest))];
}    
