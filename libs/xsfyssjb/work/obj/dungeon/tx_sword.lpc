#include <weapon.h>
#include <ansi.h> 
inherit SWORD; 
void create()
{
        set_name(HIW"蝶剑"NOR, ({ "die sword", "sword" }) );
        set_weight(3000);
        set("class","legend");
        set("experience",3500000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("value", 300);
                set("material", "iron");
                set("weapon_prop/sword",20);
                set("long",
                          "一柄砍金断玉、锋锐无匹的宝剑，剑锋发出莹莹紫光。\n");
        }
        init_sword(70, SECONDARY);
}   
