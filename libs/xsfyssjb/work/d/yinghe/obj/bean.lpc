inherit ITEM;
void create() {
  string *order = ({ "红豆", "绿豆", "黄豆", "黑豆", "花豆", "杂豆" });
  set_name(order[random(6)], ({ "bean", "dou zi" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一些豆子。\n");
    set("unit", "些");
    set("value", 10);
  }
  ::init_item();
}
