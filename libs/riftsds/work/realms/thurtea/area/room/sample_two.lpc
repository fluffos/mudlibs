#include <lib.h>
#include "/realms/thurtea/area/customdefs.h"

inherit LIB_ROOM;

nosave void create() {
    room::create();
    SetClimate("indoors");
    SetAmbientLight(30);
    SetShort("Second Sample Room");
    SetLong("This is another sample room.");
    SetItems( ([
        "template" : "That's what this is.",
      ]) );
    SetExits( ([
        "west" : "/realms/thurtea/area/room/sample_room",
        "north" : "/realms/thurtea/area/room/test1.lpc",
      ]) );
    SetInventory(([
        MY_OBJ "/case" :1,
      ]));

}

void init(){
    ::init();
}
