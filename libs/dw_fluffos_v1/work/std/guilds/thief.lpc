/**
 * Thieves' guild object. Archive lacked /std/guilds/thief while race.lpc
 * already maps thief subtypes here (§6.15 sibling adopt / restore).
 */
#include <player_handler.h>
#include <top_ten_tables.h>
#include <config.h>

inherit "/std/guilds/standard";

void setup() {
  set_name("thieves");
  set_short("Thieves' Guild");
  set_long("The Thieves' Guild. They steal, filch and shoplift.\n");
  set_gp_skill("covert.points");
  set_start_pos(CONFIG_START_LOCATION);
  set_skills(({
      "covert.stealth.inside",
      "covert.stealth.outside",
      "covert.hiding.person",
      "covert.hiding.object",
      "covert.lockpick.doors",
      "covert.lockpick.traps",
      "covert.manipulation.sleight-of-hand",
      "covert.manipulation.stealing",
      "covert.casing.person",
      "covert.casing.place",
      "covert.points",
      "fighting.combat.range.thrown",
      "other.trading.valueing.gems",
      "other.trading.valueing.jewellery"
  }));
} /* setup() */

varargs int query_skill_cost(string skill) {
  string *bits;
  if(member_array(skill, skills) != -1)
    return 3;
  bits = explode(skill, ".");
  switch(bits[0]) {
    case "covert" :
      return 5;
    case "faith" :
      return 20;
    case "magic" :
      return 50;
    default :
      return 10;
  }
} /* query_skill_cost() */

varargs int query_skill_max_level( string skill ) {
  string *bits;
  if ( member_array( skill, skills ) != -1 )
    return 400;
  bits = explode( skill, "." );
  switch( bits[ 0 ] ) {
    case "covert" :
      return 50;
    case "faith" :
      return 40;
   case "fighting" :
      return 40;
    case "magic" :
      return 40;
    case "other" :
      return 40;
    default:
      return 40;
  }
} /* query_skill_max_level() */
