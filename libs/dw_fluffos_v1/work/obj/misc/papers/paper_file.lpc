/* This will deal with happy and fluffy files. and turn them into a page. */
inherit "/obj/misc/paper";

string file_name;

void create() {
  seteuid(getuid());
  ::create();
} /* create() */

void set_file_name(string fname) {
  file_name = fname;
} /* set_file_name() */

string query_file_name() {
  return file_name;
} /* query_file_name() */

mixed *query_read_mess() {
  string str;

  if (!file_name)
    return ::query_read_mess();
  str = read_file(file_name);
  if (!str)
    return ::query_read_mess();
  /* read_file answers a string; query_read_mess is mixed* of
   * ({ text, type, lang, size }) rows (nroff_paper twin). */
  return ({ ({ str, 0, "common", 0 }) });
} /* query_read_mess() */

void init() {
  this_player()->add_command("read", this_object());
  ::init();
} /* init() */
