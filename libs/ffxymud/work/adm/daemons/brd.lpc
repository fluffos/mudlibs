void create() {
  seteuid(getuid());

}
void buildroom(object me, string s_title, string l_title, string dir, int rec) {
  mapping pairs = ([
    "north": "south",
    "south": "north",
    "east": "west",
    "west": "east",
    "northup": "southdown",
    "southup": "northdown",
    "eastup": "westdown",
    "westup": "eastdown",
    "northdown": "southup",
    "southdown": "northup",
    "eastdown": "westup",
    "westdown": "eastup",
    "northeast": "southwest",
    "northwest": "southeast",
    "southeast": "northwest",
    "southwest": "northeast",
    "up": "down",
    "down": "up"
  ]);

  object env;
  string this_file;
  string my_file;
  string name;
  string c_name;
  name = (string)me->query("id") + sprintf("%d", time());
  c_name = base_name(environment(me)) + ".lpc";
  this_file = read_file(c_name);
  this_file = replace_string(this_file, "set(\"exits\", ([",
    "set(\"exits\", ([\n" + "\"" + dir + "\"" + " : \"/p/" + (string)me->query("id") + "/" + name + "\",");
  if (!write_file(c_name, this_file, 1))
    return;
  environment(me)->set("exits/" + dir, "/p/" + (string)me->query("id") + "/" + name);
  switch (rec) {
    case 1:
      my_file = read_file("/obj/USER_ROOM.o");
      break;
    case 2:
      my_file = read_file("/obj/RESTROOM.o");
      break;
    case 3:
      my_file = read_file("/obj/WEAPONROOM.o");
      break;
    case 4:
      my_file = read_file("/obj/EATROOM.o");
      break;
    case 5:
      my_file = read_file("/obj/FIGHTROOM.o");
      break;
    case 6:
      my_file = read_file("/obj/JOBROOM.o");
      break;
    case 7:
      my_file = read_file("/obj/selfmake/rooms/USER_ROOM.o");
      break;
    case 8:
      my_file = read_file("/obj/selfmake/rooms/ZHU_ROOM.o");
      break;
    case 9:
      my_file = read_file("/obj/selfmake/rooms/LIAN_ROOM.o");
      break;
    case 10:
      my_file = read_file("/obj/selfmake/rooms/YUAN_ROOM.o");
      break;
    case 11:
      my_file = read_file("/obj/selfmake/rooms/TING_ROOM.o");
      break;
    case 12:
      my_file = read_file("/obj/selfmake/rooms/USER_ROOM.o");
      break;
    case 13:
      my_file = read_file("/obj/selfmake/rooms/USER_ROOM.o");
      break;
    case 14:
      my_file = read_file("/obj/selfmake/rooms/LIAN2_ROOM.o");
      break;
    case 15:
      my_file = read_file("/obj/selfmake/rooms/ZHU_ROOM.o");
      break;
    case 16:
      my_file = read_file("/obj/selfmake/rooms/LIANNEI_ROOM.o");
      break;
    case 17:
      my_file = read_file("/obj/selfmake/rooms/LIANJIN_ROOM.o");
      break;
  }
  my_file = replace_string(my_file,
    "set(\"exits\", ([",
    "set(\"exits\", ([\n" + "\"" + pairs[dir] + "\"" + " : " + "\"" + c_name + "\",");
  my_file = replace_string(my_file, "SHORT_TITLE", s_title);
  my_file = replace_string(my_file, "LONG_TITLE", l_title);
  if (me->query("family/family_name"))
    my_file = replace_string(my_file, "bigwiz7001",
      me->query("family/family_name"));
  my_file = replace_string(my_file, "bigtie7001",
    me->query("id"));
  if (file_size("/p/" + (string)me->query("id")) != -2) {
    mkdir("/p/" + (string)me->query("id"));
  }
  write_file("/p/" + (string)me->query("id") + "/" + name + ".lpc", my_file, 1);
  me->add("created_room", 1);
  switch (rec) {
    case 1:
      me->add("created_zt", 1);
      break;
    case 2:
      me->add("rest_room", 1);
      break;
    case 3:
      me->add("weapon_room", 1);
      break;
    case 4:
      me->add("eat_room", 1);
      break;
    case 5:
      me->add("fight_room", 1);
      break;
    case 6:
      me->add("job_room", 1);
      break;
    case 7:
      me->add("my_room", 1);
      break;
    case 8:
      me->add("zhu_room", 1);
      break;
    case 9:
      me->add("lian_room", 1);
      break;
    case 10:
      me->add("yuan_room", 1);
      break;
    case 11:
      me->add("ting_room", 1);
      break;
    case 12:
      me->add("xiang_room", 1);
      break;
    case 13:
      me->add("wo_room", 1);
      break;
    case 14:
      me->add("jian_room", 1);
      break;
    case 15:
      me->add("cang_room", 1);
      break;
    case 16:
      me->add("liannei_room", 1);
      break;
    case 17:
      me->add("lianjin_room", 1);
      break;
  }
  me->save();
}

int touch_file(string name) {
  if (write_file(name, " ", 1))
    return 1;
  else return 0;
}
