// longsword.c 长剑
#include <weapon.h>
inherit SWORD;
void create()
{
	set_name("扇子", ({ "shan","shanzi", "shan" }));
	set_weight(10000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("long", "这是一柄扇子，高手很少配带。\n");
		set("value", 100);
		set("material", "steel");
		set("wield_msg", "$N拿出一柄$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n放回怀中。\n");
	}
        init_shan(250,2);
	setup();
}
