inherit ITEM;

void create() {
  set_name("南海剑谱", ({ "jian pu", "pu" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("no_drop", "这样东西不能丢\n");
    set("no_give", "这么宝贵的东西怎么能随便乱给人呢？\n");
    set("no_sell", "你脑子没毛病？\n");
    set("long", "这是一本剑谱，上面画着一些奇奇怪怪的剑法。\n");
    set("value", 500);
    set("material", "paper");
    set("skill", ([
      "name": "badao-shu",
      "exp_required": 100000,
      "jing_cost": 5,
      "difficulty": 10,
      "max_skill": 100,
    ]));
  }
}
