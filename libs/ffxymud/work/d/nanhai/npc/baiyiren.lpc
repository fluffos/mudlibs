#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("白衣人", ({ "baiyi ren" }));
  set("long",
    "他就是「南海剑派」的开山祖师.\n" +
    "他用冷冷的目光扫向你\n" +
    "你不由得打了个寒战\n");
  set("title", "南海孤剑");
  set("gender", "男性");
  set("age", 56);
  set("shen_type", 200);
  set("attitude", "peaceful");

  set("str", 2350);
  set("int", 1250);
  set("con", 1300);
  set("dex", 1200);

  set("qi", 50000000);
  set("max_qi", 50000000);
  set("jing", 14000000);
  set("max_jing", 14000000);
  set("neili", 9000000);
  set("max_neili", 9000000);
  set("jiali", 200000);

  set("combat_exp", 1000000000);
  set("score", 200000);
  set_skill("force", 850);
  set_skill("unarmed", 850);
  set_skill("dodge", 700);
  set_skill("parry", 750);
  set_skill("sword", 850);
  set_skill("literate", 900);

  set_skill("sha-force", 750);
  set_skill("badao-shu", 750);
  set_skill("sha-dodge", 700);

  map_skill("force", "sha-force");
  map_skill("dodge", "sha-dodge");
  map_skill("parry", "badao-shu");
  map_skill("sword", "badao-shu");

  create_family("南海剑派", 1, "魔剑");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "sword.yidao" :),
    (: perform_action, "sword.zhan" :),
    (: perform_action, "sword.aoyi" :),
  }));
  setup();
  carry_object("/d/city/obj/changjian")->wield();
  carry_object("/d/nanhai/obj/cloth")->wear();

}

void attempt_apprentice(object ob) {

  if (ob->query_kar() < 19) {
    command("say 阁下与我无缘，还是走吧.");
    return;
  }
  if (ob->query_con() < 40) {
    command("say 你根骨如此之差，如何悟得无上剑道？.");
    return;
  }
  if ((int)ob->query_skill("badao-shu", 1) < 80) {
    command("say " + RANK_D->query_respect(ob) + "还应多在这套拔刀术上下下苦功！");
    return;
  }
  command("recruit " + ob->query("id"));
  if ((string)ob->query("class") != "chuanren")
    ob->set("class", "chuanren");
  return;
}
