//Cracked by Roath
// box.c 功德箱

#include <ansi.h>

inherit ITEM;

void create() {
  set_name("战斗场景", ({ "fight" }));
  set("short", "$fight#战斗场景");
  set_weight(3000);
  set_max_encumbrance(5000000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "一场打的热火朝天的战斗！\n");
    set("value", 1000);
    set("material", "wood");
    set("no_get", 1);
    set("no_drop", 1);
    set("fightroom", 1);
    set("amount", 30);
  }
  setup();
}
int is_container() { return 1; }
void init() {
  add_action("do_likai", "likai");
  add_action("do_join", "join");
}

int do_likai(string arg) {
  object obj = this_object(), me = this_player();
  object *inv;
  int i;
  if (environment(me) == this_object()) {
    inv = all_inventory(obj);
    if (me->query("id") != obj->query("fighter1") && me->query("id") != obj->query("fighter2")) {
      if (!me->is_fighting()) me->move(environment(obj));
    } else {
      if (!me->is_fighting()) {
        for (i = 0; i < sizeof(inv); i++) {
          inv[i]->move(environment(obj));
        }
        destruct(obj);
      }
    }
  }
  return 1;
}

int do_join(string arg) {
  object obj = this_object(), me = this_player();
  if (environment(me) != obj && arg == obj->query("id"))
    me->move(obj);
  return 1;
}
