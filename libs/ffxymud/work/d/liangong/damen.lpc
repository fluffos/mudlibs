// Room: /city/kedian.c
// YZC 1995/12/04 
inherit ROOM;
void create()
{
        set("short", CYN"龙家练功场门口"NOR);
        set("long", @LONG
这是一家有巫师龙紫衫兴建的练功场，她暂时交托给有间客栈代理
墙上挂着一个牌子(paizi)。
LONG
        );
          set("no_fight", 1);
        set("valid_startroom", 1);
        set("no_sleep_room",1);
        set("item_desc", ([
                "paizi" : "练功房入场费：10两黄金\n",
        ]));
        set("objects", ([
                __DIR__"npc/xiaoer" : 1,
    __DIR__"npc/shizhe" : 1,
        ]));
        set("no_clean_up",1);
        set("exits", ([
                "west" : "/d/city/kedian",
                "up" : __DIR__"liangong",
        ]));
        setup();
        "/d/board/kedian_b"->foo();
}
int valid_leave(object me, string dir)
{
          if (!userp(me))         return ::valid_leave(me, dir);
        if (present("xiao er",environment(me))){
        if ( !me->query_temp("rent_paid") && dir == "up" )
        return notify_fail("店小二一下挡在门前，"+HIW"白眼"NOR+"一翻：怎麽着，这么点钱也付不起？\n");
        }
        return 1;
}

