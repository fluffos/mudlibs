// by wind

inherit ROOM;

void create ()
{
  set ("short", "赛场");
  set ("long", @LONG
赛场四周是高高的贵宾观礼台，十丈见方的场地上整整齐齐地
铺着一圈彩色玛瑙石，架着香烟袅绕的四个巨大金银铜铁鼎，
场地中间是软松的皮绒织锦毯。厅上悬着一块匾额(sign)。
LONG);

  set("no_die", 1);
  set("no_get", 1);
  set("no_get_from",1);
  set("exits", ([
        "westup"  : __DIR__"west",
        "eastup"  : __DIR__"east",
        "northup"  : __DIR__"north",
        "southup"  : __DIR__"south",
      ]));
  set("item_desc", ([
                "sign": @TEXT
   虹台论剑
   天下归心
TEXT
        ]) );


  setup();
}
