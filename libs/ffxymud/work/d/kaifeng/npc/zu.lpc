inherit NPC;

void create()
{
 set_name("开封府吏", ({"fu li", "li" }));
  set("age", 18+random(10));
  set("gender", "男性");
  set("attitude", "peaceful");
  set("str", 20);
  set("combat_exp", 20000);
  set("max_kee", 400);
  set("max_sen", 400);
  set("max_force", 200);
  set("force", 200);
  set("force_factor", 10);
  set_skill("unarmed", 40);
  set_skill("dodge", 40);
  set_skill("parry", 40);
 set_skill("shaolin-shenfa", 40);
  set_skill("force", 40);
 map_skill("dodge", "shaolin-shenfa");

  setup();
carry_object("/clone/misc/cloth")->wear();
}



