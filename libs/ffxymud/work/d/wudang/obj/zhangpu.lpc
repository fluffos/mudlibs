inherit ITEM;

void create() {
  set_name(HIR "倚天屠龙记" NOR, ({ "jian pu", "pu" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("no_drop", "这样东西不能丢了\n");
    set("no_give", "这么宝贵的东西怎么能随便乱给人呢？\n");
    set("no_sell", "当了要是武林人士知道了就麻烦了。\n");
    set("no_get", "这样东西拿不起来。\n");
    set("long", "不会连这个都不知道吧？\n");
    set("value", 500);
    set("material", "paper");
    set("skill", ([
      "name": "yitian-zhang",
      //			"literate": 500,
      "exp_required": 100000,
      "jing_cost": 5,
      "difficulty": 10,
      "max_skill": 500,
    ]));
  }
}
