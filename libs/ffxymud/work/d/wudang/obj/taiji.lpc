#include <ansi.h>
inherit ITEM;
inherit F_UNIQUE;

void create()
{
        set_name(HIW"太极真谛" NOR, ({ "taiji zhendi", }));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
             set("unit", "本");
             set("long",
        "这是一本张三丰十余年来的心血结晶。\n",
         );
         set("value", 0);
         set("material", "silk");
         set("skill", ([
                        "name":       "jieli-dali",
                        "exp_required" : 150000,
                        "jing_cost":  35,
                        "difficulty": 25,
                        "max_skill":  300
                ]) );
        }
        set("no_drop", "武功秘籍可不能随便丢弃！\n");
        set("no_give", "这样东西不能随便给人。\n");
}
