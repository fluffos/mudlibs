// bamboo_sword.c

#include <weapon.h>

inherit SWORD;

void create()
{
        set_name("新月剑",({ "xinyuejian", "jian", "sword" }) );
        set_weight(8990);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("value", 92851);
                set("material", "bamboo");
                set("long", "这是一把在这个世界唯一的一种大师级专署一般玩家可不能乱用他呀！\n");
                set("wield_msg", "$N抽出一把金光闪闪，寒气逼人的$n，握在了手中。\n");
                set("unequip_msg", "$N放下手中的$n。\n");
        }
        init_sword(5);
        setup();
}
