// yitian-jian 倚天剑
// Modifyied by Uranus

#include <weapon.h>
#include <ansi.h>
int do_hukan();
inherit SWORD;

void create()
{
        set_name(HIY HIW "盟主令" NOR,({ "mengzhu ling", "mengzhu", "ling", "lingpai" }) );
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "块");
            set("value",50000);
		set("no_drop", "这样东西不能离开你。\n");
		set("no_put",1);
                set("material", "steel");
                set("long", "盟主令，见令如见盟主！\n");
                set("wield_msg", HIY "$N缓缓拿出象征盟主身份的$n" + HIY + "顺手舞了几下
胆识倍增 ！$N不由得从心底升起一股凌云豪气。\n" NOR);
                set("unwield_msg", HIW "盟主令"HIY"幻作一道白光，「唰」地飞入怀中。\n" NOR);
                set("unequip_msg", HIW "盟主令"HIY"幻作一道白光，「唰」地飞入怀中。\n" NOR);
        }
	init_sword(800);
        setup();
}

/* --- End of Modify --- */



