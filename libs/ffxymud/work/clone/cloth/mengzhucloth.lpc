// cloth.c
//
// This is the basic equip for players just login.
#include <armor.h>
inherit CLOTH;
void create() {
  set_name(HIY HIW "盟主战袍" NOR, ({ "mengzhuzhanpao" }));
  set_weight(10000);
  set("no_drop", "这样东西不能离开你。\n");
  set("no_put", 1);
  set("long", "盟主战袍，见之如见盟主！\n");
  set("wear_msg", HIY "$N缓缓穿上象征盟主身份的$n" + HIY + ",并顺手抖了几下灰尘。\n" NOR);
  set("remove_msg", HIW "盟主战袍" HIY "被盟主严肃的脱了下来！。\n" NOR);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("armor_prop/armor", 800);
  }
  setup();
}
