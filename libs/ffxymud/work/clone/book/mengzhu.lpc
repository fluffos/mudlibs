#include <ansi.h>
inherit ITEM;

void create()
{
        set_name(HIW"盟主日志"NOR, ({ "mengzhu book" }));
        set_weight(600);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
                set("no_drop",1);
                set("no_give",1);
                set("no_get",1);
                set("long",
                        "学化功大法。\n");
                set("value", 1000);
                set("material", "paper");
                set("skill", ([
                        "name":         "huagong-dafa",       
                        "exp_required": 50000,                  
                                                               
                        "jing_cost" :   30,
                        "difficulty":   30,                    
                                                                
                        "max_skill":    1500,                    
                        "min_skill":    0                     
                                                              
                ]) );
        }
}
int query_autoload() { return 1; }

