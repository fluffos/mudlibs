#include <ansi.h>
inherit ITEM;

void create()
{
        set_name(HIM"太玄经"NOR, ({ "taixuan book" }));
        set_weight(600);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
//                set("no_drop",1);
                set("long",
                        "学太玄功。\n");
                set("value", 1000);
                set("material", "paper");
                set("skill", ([
                        "name":         "taixuan-gong",       
                        "exp_required": 50000,                                                  
                        "jing_cost" :   1,
                        "difficulty":   1,                     
                                                               
                        "max_skill":    200,                    
                        "min_skill":    0                      
                                                               
                ]) );
        }
}
int query_autoload() { return 1; }

