// baowu.c
// by smash
#include <ansi.h>
inherit ITEM;


void create()
{
	set_name(HIG"宝物"NOR, ({"bao wu"}));
	set_weight(80);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "你挖出来的宝物，不知道有什么作用。\n");
		set("unit", "个");
		set("value", 50);
		 set("mingjiao", 1);
	}
}
int init()
{
	add_action("do_use", "use");
}

int do_use(string arg)
{
	object me = this_player();
        int i;
        i = (int)me->query_skill("literate",1);
        
	if(arg=="bao wu")
	{
		message_vision(HIW"$N小心翼翼的将宝物打开。\n"NOR, me);
		tell_object(me,HIW"很可惜，这个宝物因为埋藏时间太长，失效了。\n"NOR);
		
		if ( me->query("combat_exp") > 1000)
		{
		
                 me->set_skill("literate", i + -3);
              tell_object(me,HIW"因为你使用了伪劣产品，你的读书写字降低了！！\n"NOR);
		}
		destruct(this_object());
	}
	return 1;
}
