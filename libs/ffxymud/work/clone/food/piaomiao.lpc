inherit ITEM;
inherit F_LIQUID;
void create()
{
	set_name(HIY HIW "飘渺无痕" NOR, ({"piaomiaowuhen"}));
	set_weight(700);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "一种神秘的酒，非常的可怕………………\n");
		set("unit", "瓶");
		set("value", 20);
		set("max_liquid", 150);
	}
	// because a container can contain different liquid
	// we set it to contain wine at the beginning
	set("liquid", ([
		"type": "alcohol",
		"name":HIY HIG "飘渺无痕" NOR,
		"remaining": 150,
		"food_supply": 60,
	]));
}
