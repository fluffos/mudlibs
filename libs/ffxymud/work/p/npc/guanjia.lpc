//qingfeng.c

inherit NPC;
void create()
{
	set_name("管家", ({"guan jia"}));
	set("gender", "男性" );
	set("age", 35);
       set("long","本府的管家，正拿着帐簿算帐．\n");
	set("class", "xian");
	set("combat_exp", 100000);
	set("attitude", "peaceful");
	set("title", "老管家");
	set_skill("unarmed", 40);
	set_skill("dodge", 40);
	set_skill("parry", 40);

	set("per", 20);
	set("max_qi", 200);
	setup();
       add_money("silver", 5+random(8));
        carry_object("/clone/cloth/choupao")->wear();
}

void init()
{       
	object ob=this_player();
	object me=this_object();

	::init();

	if ((int)ob->query("env/invisibility")  == 0)
	{
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;

	if ( (int)ob->query("combat_exp")>5000000 )
		command("say 这位" + RANK_D->query_respect(ob) + "失迎了，快请上坐！请到厢房用香茶！\n");
	else if ( (int)ob->query("combat_exp")>1000000 )
		command("say 这位" + RANK_D->query_respect(ob) + "失迎了，快请坐！请到厢房用茶！\n");
	else if ( (int)ob->query("combat_exp")>100000 )
		command("say 这位" + RANK_D->query_respect(ob) + "，请坐！用茶！\n");
	else if ( (int)ob->query("combat_exp")>1000 )
		command("hi " + ob->query("id"));	
	else
		return;
}
