#include <ansi.h>
inherit NPC;
void create()
{
   set_name("护院",({"hu yuan"}));
   set("gender","男性");
   set("long","保卫大宅的一个护院!\n");
   set("combat_exp",500000);
      
set("age",18+random(30));
set("kee",1500);
set("img",3);
   set("max_qi",1500);
set("food",250);
set("water",250);
   set("force",3000);
   set("max_force",2000);
   set("force_factor",20+random(30));

   set_skill("dodge",100+random(50));
   set_skill("force",100+random(50));
   set_skill("parry",100+random(50));
   set_skill("unarmed",100+random(50));
   set_skill("blade",100+random(50));

   setup();
   add_money("silver",15);
carry_object("clone/cloth/cloth")->wear();
carry_object("clone/weapon/gangdao")->wield();
}
void init()
{
  object ob;
  ::init();
  if (interactive(ob=this_player())&&!is_fighting())  {
  	remove_call_out("greeting");
  	call_out("greeting",1,ob);
    }
  }
void greeting(object ob)
{ 
  if (!ob||environment(ob)!=environment())  return;
  if (ob->query("id")!=environment()->query("owner"))   {
  command("say 你尽然在这里动手?");
    kill_ob(ob);
    return;
   }
   return;
}

