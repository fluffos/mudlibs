#include <ansi.h>

inherit ITEM;

void setup()
{}

void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name(HIW"还性丹"NOR, ({"dan", "peichang"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                set("value", 5000);
        }
        setup();
}

int do_eat(string arg)
{
       
        if (!id(arg))
        return notify_fail("你要吃什么？\n");
         {
             this_player()->set("gender", "男性");
                 message_vision(HIY "$N吃下一颗还性丹,觉得下体起了什么变化，哇．．．$N得到重生了!\n" NOR, this_player());
         }

        destruct(this_object());
        return 1;
}

