// open.c

#include <room.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  int qian, tpot, pot_cost;
  if (!arg
    || !sscanf(arg, "%d", pot_cost))
    return notify_fail("你要把多少经验转换为潜能[10:1]？\n");

  tpot = (int)me->query("combat_exp");
  qian = (int)me->query("potential");
  if (pot_cost < 10)
    return notify_fail("至少要用10点经验才能转换1点潜能。\n");
  if (pot_cost < 0)
    return notify_fail("你无法这样转换潜能！！\n");
  if (pot_cost > tpot)
    return notify_fail("你没有这么多经验！！\n");
  else
    qian = qian + pot_cost / 10;
  me->set("combat_exp", tpot - pot_cost);
  me->set("potential", qian);
  write("ＯＫ,就原了你的愿望吧!\n");
  return 1;
}

int help(object me) {
  write(@HELP
HELP
  );
  return 1;
}
