inherit SKILL;

mapping *action = ({
  ([ "action": "$N没有任何招式，只是一股剑气缓缓推向$n的$l",
    "force": 180,
    "dodge": 25,
    "parry": 20,
    "damage": 120,
    "lvl": 0,
    "skill_name": "一杀",
    "damage_type": "劈伤"
  ]),
  ([ "action": "$N没有任何招式，只是两股剑气缓缓推向$n的$l",
    "force": 360,
    "dodge": 25,
    "parry": 30,
    "damage": 240,
    "lvl": 50,
    "skill_name": "二杀",
    "damage_type": "劈伤"
  ]),
  ([ "action": "$N没有任何招式，只是三股剑气缓缓推向$n的$l",
    "force": 460,
    "dodge": 35,
    "parry": 40,
    "damage": 340,
    "lvl": 100,
    "skill_name": "三杀",
    "damage_type": "劈伤"
  ]),
  ([ "action": "$N没有任何招式，只是四股剑气缓缓推向$n的$l",
    "force": 760,
    "dodge": 55,
    "parry": 60,
    "damage": 740,
    "lvl": 150,
    "skill_name": "四杀",
    "damage_type": "劈伤"
  ]),
});

int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }


int valid_learn(object me) {
  if ((int)me->query_skill("force", 1) < 20)
    if ((int)me->query("max_neili") < 100)
      return notify_fail("你的内力太弱，无法练拔刀术。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("badao-shu", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me) {
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 40)
    return notify_fail("你的内力不够练拔刀术。\n");
  me->receive_damage("qi", 30);
  me->add("neili", -10);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "badao-shu/" + action;
}
