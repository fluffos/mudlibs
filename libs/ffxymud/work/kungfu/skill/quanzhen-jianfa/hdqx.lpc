#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
 
int perform(object me, object target)
{
    object weapon, ob;
    string msg;
    int i;
 
    if( !me->is_fighting() )
        return notify_fail("[魂断七星]只能在战斗中使用。\n");
    if((string)me->query("family/family_name") != "全真教" )
        return notify_fail("此乃全真教不传之秘！n");
    if (me->query_temp("perform")) return notify_fail("你上一招未使完！\n");
    if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    if (!objectp(weapon = me->query_temp("secondary_weapon"))
    || (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对。\n");
    else me->set_temp("secondly_weapon",1);
    if( (int)me->query("neili") < 1200 )
        return notify_fail("你的真气不够！\n");
    if( (int)me->query_skill("sword") < 121 ||
        me->query_skill_mapped("sword") != "quanzhen-jianfa")
        return notify_fail("你的「全真剑法」还不到家，无法使用「魂断七星」！\n");
    msg = HIW "$N步走天罡，脚踏七星，七道剑光疾飞出去！\n" NOR;
    message_vision(msg, me);
    me->clean_up_enemy();
    ob = me->select_opponent();
    me->add("neili", -700);
    me->set_temp("perform",1);
    me->set_temp("perform_hdqx",1);
    for(i = 0; i < 7; i++)
        if (me->is_fighting(ob) && ob->is_fighting(me) && ob->query("eff_qi")>0){
              me->set_temp("action_msg","紧接着");
                if (!weapon->query("equipped")) break;
              COMBAT_D->do_attack(me, ob,weapon, 0);
            }else break;
    me->delete_temp("perform_hdqx");
    me->delete_temp("secondly_weapon");
    me->start_call_out( (: call_other, __FILE__, "del_perform", me :), 3);;
    return 1;
}

void del_perform(object me)
{
   if (!me) return;
   me->delete_temp("perform");
}



