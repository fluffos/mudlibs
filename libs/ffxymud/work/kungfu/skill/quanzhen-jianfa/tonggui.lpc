//  tianditongshou 同归剑式

#include <ansi.h>

inherit F_SSERVER;

int perform(object me, object target) {
  int damage;
  object weapon = me->query_temp("weapon");

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("你只能在战斗中使用『天地同归』。\n");

  if ((int)me->query_skill("quanzhen-jianfa", 1) < 250)
    return notify_fail("你的全真剑法不够娴熟，不会使用『天地同归』。\n");
  if ((int)me->query_skill("xiantian-gong", 1) < 250)
    return notify_fail("你的先天功的基础不够，不能使用『天地同归』。\n");
  if ((int)me->query_dex() < 20)
    return notify_fail("你的先天身法太低，不能使用『天地同归』。\n");

  if ((int)me->query("neili", 1) < 5000)
    return notify_fail("你现在内力不足！\n");

  if ((int)me->query("eff_qi") > (int)me->query("max_qi") / 2)
    return notify_fail("『天地同归』是拼命的招数，你难道想这么快就自杀？！\n");

  if (!weapon || (weapon->query("skill_type") != "sword")
    || me->query_skill_mapped("sword") != "quanzhen-jianfa"
    || me->query_skill_mapped("parry") != "quanzhen-jianfa")
    return notify_fail("你现在无法使天地同归。\n");

  message_vision(
    HIY "\n$N长叹一声：既然天要亡我，我只好使出祖师手创的绝学，莫怪我……一句话说完，$N已经飞起，一剑剑向$n攻出，这几招剑法之神妙已近天人！但却绝无守护之心！\n\n" NOR,
    me,
    target
  );

  if ((me->query("combat_exp")) > (int)target->query("combat_exp") / 2 &&
    random(me->query_str()) > (int)target->query_str() / 4) {
    message_vision(HIR "\n$n哪里见过这等剑法？登时冷汗直下，却忘了去防御！\n" NOR, me, target);
    tell_object(target, HIR "你感觉不妙，已经有数道剑气贯穿你的奇经八脉、胸口、心脏、小腹！\n" NOR);
    me->start_busy(2);
    target->start_busy(2);
    me->add("neili", -300);
    damage = (int)target->query("max_qi");
    damage = damage / 10;
    damage = damage * 9;

    target->receive_damage("qi", damage);
    target->receive_wound("qi", damage);
    me->query_temp("weapon")->move(target);
    target->kill_ob(me);
    me->set_temp("last_damage_from", "使用天地同归和" + target->name() + "同归于尽");
    target->set_temp("last_damage_from", "被" + me->name() + "使用天地同归杀");
    me->add("max_neili", -150);
    me->die();
    target->die();
  } else {
    target->start_busy(5);
    message_vision(HIY "\n$n急忙一招招将门户守得极严，堪堪破解了$N的天地同归！\n" NOR, me, target);
    me->add("max_neili", -50);
    me->set_temp("last_damage_from", "使用天地同归自杀");
    me->die();
  }

  return 1;
}
