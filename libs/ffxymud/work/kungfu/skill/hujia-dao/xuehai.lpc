
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target)
{
        object weapon, ob;
    string msg;
        if( !me->is_fighting() )
            return notify_fail("「雪海芒芒」只能在战斗中使用。\n");
        if (!objectp(weapon = me->query_temp("weapon"))
                || (string)weapon->query("skill_type") != "blade")
                        return notify_fail("你使用的武器不对。\n");
     ;
        if((int)me->query_skill("blade",1) < 150)
                return notify_fail("你的基本刀法的火候还不到家, 不能使用这一绝技 !\n");
        if((int)me->query_skill("hujia-dao",1) < 150)
                return notify_fail("你的胡家刀法的火候还不到家, 不能使用这一绝技 !\n");
        if( (int)me->query("neili") < 500 )
                return notify_fail("你的真气不够！\n");
        if( (int)me->query("max_neili") < 500 )
                return notify_fail("你的内力修为不够！\n");
    msg = 
HIR "\n$N双眼一亮，身形巍然卓立，刀光一闪使出胡家刀法之最后绝技「雪海茫茫」！\n" NOR;
        message_vision(msg, me);
        me->clean_up_enemy();
        ob = me->select_opponent();
        if(!ob)
        return 0;
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        if(!ob)
        return 0;
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        if(!ob)
        return 0;
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        if(!ob)
        return 0;
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        if(!ob)
        return 0;
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        if(!ob)
        return 0;
                me->add("neili", -150);
      me->start_busy(1);
    return 1;
}
