#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
        object weapon;
        string msg;

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("「奥意升龙斩」只能对战斗中的对手使用。\n");
                       
        if( (int)me->query_skill("sha-force",1) < 150 
            || me->query_skill_mapped("force") != "sha-force")
                return notify_fail("你的杀心法造诣不够，无法使用.「奥意升龙斩\n");

        if( (int)me->query_skill("badao-shu", 1) < 150 )
                return notify_fail("你的拔刀术太生疏，不会「奥意升龙斩」\n");

        if ( me->query("neili") < 300)
                return notify_fail("你的内力不够，现在无法使用「奥意升龙斩」。\n");
        me->add("neili", -150);

        if( target->is_busy() )
                return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧！\n");
                
        msg = HIY "$N长出一口气，使出拔刀术「奥意升龙斩」，一条巨龙腾飞，刀气如潮而至。\n";

        me->start_busy(1);

        if( random(me->query_skill("force")) >  target->query_skill("dodge")/5)
        {
                msg += HIR " $p强做精神，左遮右挡，无法还手！\n" NOR;
                target->start_busy( (int)me->query_skill("badao-shu", 1) / 50 );
        } else 
        {
                msg += "可是$p身形一错，已飘然脱离$P的攻击。\n" NOR;
        }
        message_vision(msg, me, target);

        return 1;
}

