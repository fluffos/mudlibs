#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target)
{
        int pow,i;
        string prepare;
 
        prepare = me->query_skill_prepared("finger");

        if( !target ) target = offensive_target(me);
        
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("惊天一刀 只能对战斗中的对手使用。\n"); 

        if( me->query_skill("sword") < 200 )
                return notify_fail("你在剑法上的造诣不够，无法使用惊天一刀。\n");
                
        if( me->query_skill("dodge") < 200 )
                return notify_fail("你在轻功上的造诣不够，无法使用惊天一刀。\n");
                
        if( (int)me->query_skill("sha-force",1) < 200 
            || me->query_skill_mapped("force") != "sha-force")
                return notify_fail("你的杀心法造诣不够，无法使用惊天一刀。\n");

        if( me->query_skill("badao-shu",1) < 300 )
                return notify_fail("你的拔刀述造诣不够，无法使用惊天一刀。\n");
                
        if( me->query("max_neili") < 2000 || me->query("neili") < 800 )
                return notify_fail("你的内力不够，无法施展惊天一刀！\n");
                
        message_vision(
        HIW"$N脸色一暗，全身气劲汇聚经脉，越走越快，杀气越来越强，终于，这「"NOR+HIR"惊天一刀"NOR+HIW"」发了出来！\n" NOR
        +BLINK"[31m「杀心」、[36m「杀气」、[35m「杀意」"
        +"[33m「杀天」、[34m「杀地」、[30m「杀神」"NOR
        + HIW"\n六种杀意汇聚为一刀逼近$n！！！\n"NOR, me, target);
        me->add("neili", -800);

        pow=(int) me->query_skill("badao-shu",1);
        pow=pow/2+random(pow);
        pow=pow/6;
        if( pow > 100 ) pow=100;
        for(i=0;i<6;i++)
         {
          me->add_temp("apply/attack", pow*3);
          me->add_temp("apply/defense", pow*2);
          COMBAT_D->do_attack(me, target,0);
         }
          me->add_temp("apply/attack", -pow*18);
          me->add_temp("apply/defense",-pow*12);
          me->start_busy(4);     

        return 1;
}
