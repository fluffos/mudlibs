#include <ansi.h>
inherit ROOM;
string *master_name=({"xli","lemon","llin","qiaoqiao","rft"});
int CanDo(object);
void create()
{
    string miaoshu;
    miaoshu=
"这里就是闻名天下的宝贝居了。宝宝贝贝在盘古开天辟地之后，女娲补天之
时，将剩余的"+HIB"五色石"NOR+"采集而来，再加炼制，化为数块坚硬无比的"+HIG"五彩石板"NOR+"，再请
九九八十一位能工巧匠，用了九年时间建造起来这间房子。墙壁虽薄，却能抵挡
刀枪剑雨、俗世喧嚣。
    "+GRN"月桂树"NOR+"制成的小门正虚掩着，四季皆温暖如春的房间内，让人总觉得有一种
说不出来的闲适。"+HIM"橡木"NOR+"铺就的地板从纹路里散发出一股淡淡的清新气味，和暖的
"+HIY"阳光"NOR+"透过头顶的水晶天窗洒下来几道"+BLU"彩虹"NOR+"，无数欢跃的"+HIC"小精灵"NOR+"似在其中轻舞着。
    屋内的摆设却并不多，除了几张"+MAG"紫檀木"NOR+"的桌椅茶几，便是墙上挂的数幅工笔
书画了。这些书画却幅幅都是精品，饱含了天上地下众多书画大家的毕生心血。
只见上面画的皆是人间各地繁华的景象：温润旖旎的"+MAG"江南风光"NOR+"，豪爽率直的"+WHT"塞北
风情"NOR+"，扬州小路边"+GRN"杨柳"NOR+"的婀娜多姿，雪域高山上"+HIY"寺顶"NOR+"的夺目金光，大理皇宫内高
耸的四角"+RED"飞檐"NOR+"，昆仑丛山中掩映的数畦"+HIG"菜园"NOR+"，兰州城内笑脸相迎的"+HIK"货郎"NOR+"，楚州门
前肃然而立的"+HIR"校尉"NOR+"，月老祠里喜气洋洋的"+HIM"婚礼"NOR+"，玉门关前悄声低啜的"+YEL"惜别"NOR+"，无量
山上勤学苦练的剑客，崆峒险峰悠然对弈的老仙，少林寺里默默诵经的和尚，南
阳城里巧手烹调的厨娘，侠客岛上随风轻摆的"+GRN"椰树"NOR+"，一品堂里威武英挺的"+HIY"护卫"NOR+"，
冥都地府里铁面阴森的"+BLK"判官"NOR+"，青城偏房中低眉倒茶的"+CYN"小童"NOR+"。
    这里的主人--宝宝贝贝平常并不在这里，身为天界诸多神仙中的一个，他经
常是云游在外，居无定所的。因此平常只是几个烧水端茶的童子在这里负责招待
来客。宝宝贝贝有时也和朋友一起来此处小憩，天上人间，轶事奇闻，他们无所
不谈，往往是观赏山水，品评诗画，随后又隐于"+WHT"烟雾"NOR+"中而去了。
\n";

    set("short",MAG"宝贝居"NOR);
    set("long",miaoshu);

	set("exits", ([ /* sizeof() == 7 */
        "kunlun"	:	"/d/menpai/kunlun/dating.lpc",
        "chu"  		:	"/d/city/chuzhou/jiulou",
        "west" 		:	"/d/menpai/wuliang/west/keting.lpc",
        "dali" 		: 	"/d/city/dali/jiulou.lpc",
        "nanyang" 	: 	"/d/city/nanyang/chufang.lpc",
        "lanzhou" 	: 	"/d/city/lanzhou/kezhan.lpc",
        "yangzhou" 	: 	"/d/city/yangzhou/tongsi_jie.lpc",
        "kongdong" 	: 	"/d/menpai/kongdong/xuanyuan_gong.lpc",
        "shaolin" 	: 	"/d/menpai/shaolin/fatang.lpc",
        "wuliang" 	: 	"/d/menpai/wuliang/dating.lpc",
        "duan" 		: 	"/d/menpai/duanshi/qianyuan",
        "down" 		: 	"/d/place/death/gate",
        "xkdao"		: 	"/d/place/xkdao/cave",
        "yipin"		: 	"/d/zuzhi/yipin_tang/dating",
        "qc"   		: 	"/d/menpai/qingcheng/houdian",
        "yuelao"    :   "/d/city/yangzhou/yuelao_ci",
        "tongsi"    :   "/d/city/yangzhou/tongsi_jie",
    ]));
    set("objects",([
    __DIR__"obj/baobei_zhu"    :  1,
    __DIR__"obj/cake"          :  1,
    __DIR__"obj/hulu"          :  1,
    ]));
	set("no_clean_up", 0);
	setup();
}

void init()
{
	add_action("DoCall","cal");       // 相当于call指令
	add_action("DoFull","ful");       // 相当于增强了的full指令
	add_action("DoRelive","relive");  // 相当于revive指令
	add_action("DoPegOut","pegout");  //相当与unconcious指令
	add_action("DoClone","clo");      //复制物品
	add_action("DoBring","bring");    //将玩家、NPC、物品带到自己身边	
}

int CanDo(object who)
{
	int i;
	int can=0;
	for(i=0;i<sizeof(master_name);i++)
	{
		if(who->query("id")==master_name[i])
		    can=1;
    }
    return can;
}

int DoCall(string arg)
{
	string objname, func, param, euid;
	object me,obj;
	mixed *args, result;
	int i;
    me=this_player();

    if(!CanDo(this_player()))
        return notify_fail("你好象不是主人宝宝贝贝的好友哦，怎么能使用这个指令呢？！\n");
	if( arg ) {
		if( sscanf(arg, "-%s %s", euid, arg)==2 ) {
			if( (string)SECURITY_D->get_status(me) != "(admin)" )
				return notify_fail("你不能设定自己的 euid。\n");
			seteuid(euid);
		}
		else
			seteuid( geteuid(this_player(1)) );

		if( sscanf(arg, "%s->%s(%s)", objname, func, param)!=3 )
			return notify_fail("指令格式：cal <物件>-><函数>( <参数>, ... )\n");
	} else
		return notify_fail("指令格式：cal <物件>-><函数>( <参数>, ... )\n");

    obj = get_object(objname,this_player());
	if(!obj) return notify_fail("找不到指定的物件。\n");

	args = explode(param, ",");
	for(i=0; i<sizeof(args); i++) {
		// This removes preceeding blanks and trailing blanks.
		parse_command(args[i], environment(me), "%s", args[i]);
		if( sscanf(args[i], "%d", args[i]) ) continue;
		if( sscanf(args[i], "\"%s\"", args[i]) ) continue;
		//args[i] = restore_variable(args[i]);
	}

	args = ({ func }) + args;

	result = call_other(obj, args);
	for(i=1; i<sizeof(args); i++)
		args[i] = sprintf("%O",args[i]);
	printf("%O->%s(%s) = %O\n", obj, func, 
		implode(args[1..sizeof(args)-1], ", "), result);
	return 1;

}

int DoFull(string arg)          //补满某人的精气神等
{
	object who;
   if(!CanDo(this_player()))
        return notify_fail("你好象不是主人宝宝贝贝的好友哦，怎么能使用这个指令呢？！\n");
	
	if(!arg)
	    who = this_player();
	else
		who=get_object(arg);
	if(!who)
	    return notify_fail("没有这个人。\n");
	who->set("gin",who->query("max_gin"));
	who->set("eff_gin",who->query("max_gin"));
	who->set("kee",who->query("max_kee"));
	who->set("eff_kee",who->query("max_kee"));
	who->set("sen",who->query("max_sen"));
	who->set("eff_sen",who->query("max_sen"));
	who->set("food",who->max_food_capacity());
	who->set("water",who->max_water_capacity());
	who->set("force",who->query("max_force"));
	tell_object(this_player(),"已经将"+who->query("name")+"的精气神、食物、水和内力补满了！\n");
	return 1;
}

int DoRelive(string arg)     //复活某人
{
    object who;
    object me;
    me=this_player();
   if(!CanDo(this_player()))
        return notify_fail("你好象不是主人宝宝贝贝的好友哦，怎么能使用这个指令呢？！\n");
	
    if(!arg) 
        who = me;
    else
        who=get_object(arg);
    if(!who)
        return notify_fail("没有这个东西。\n");
    if ( !who->is_character() || who->is_corpse() )
        return notify_fail("看清楚点，那不是活物。\n");
    who->remove_call_out("revive");
    who->revive();
    who->reincarnate();
    return 1;
}

int DoPegOut(string arg)     //让某人晕倒
{
	object who;
   if(!CanDo(this_player()))
        return notify_fail("你好象不是主人宝宝贝贝的好友哦，怎么能使用这个指令呢？！\n");

	if(!arg)
	    return notify_fail("你想把谁弄晕？\n");
	who=get_object(arg);
	if(!who)
	    return notify_fail("没有这个生物。\n");
	who->unconcious();
	return 1;
}

int DoClone(string arg)         //复制物品
{
	object thing;
   if(!CanDo(this_player()))
        return notify_fail("你好象不是主人宝宝贝贝的好友哦，怎么能使用这个指令呢？！\n");

	if(!arg)
	    return notify_fail("你要复制什么？\n");
	thing=new(arg);
	if(!thing)
	    return notify_fail("没有这个东西。可能并不存在或者输入的文件路径不对。\n");
	if(!thing->is_character() && thing->move(this_player()) )
	{
		tell_object(this_player(),"已经将"+thing->query("name")+"放入你的物品箱。\n");
		return 1;
	}
	if(thing->move(environment(this_player())))
    {
    	tell_object(this_player(),"已经将"+thing->query("name")+"放入这个房间。\n");
	    return 1;
	}
	return notify_fail("复制失败！\n");
}

int DoBring(string arg)			//将玩家、NPC或物品带到自己身边
{
	object me,who;
	object where;
	
	me = this_player();
   if(!CanDo(this_player()))
        return notify_fail("你好象不是主人宝宝贝贝的好友哦，怎么能使用这个指令呢？！\n");

	if( !arg )
	    return notify_fail("你要把谁带到身边？\n");
	who = get_object(arg);
	if(!who)
	    return notify_fail("没有"+arg+"这个东西。\n");
	where = environment(me);
	if(!where)
	    return notify_fail("你没有环境，无法带"+arg+"过来。\n");
	who->move(where);
	tell_object(me,"已经成功的将"+who->query("name")+"带到了身边。\n");
	tell_object(who,"你被"+me->query("name")+"带到了"+where->query("short")+"。\n");
	return 1;
}
