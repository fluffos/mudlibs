#include <ansi.h>
inherit ITEM;
inherit F_LIQUID;
void create() {
  set_name(RED "红牛" NOR, ({ "hongniu" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一罐红牛饮料。\n");
    set("unit", "罐");
    set("value", 0);
    set("max_liquid", 4);
  }
  // because a container can contain different liquid
  // we set it to contain wine at the beginning
  set("liquid", ([
    "type": "water",
    "name": "红牛",
    "remaining": 4,
    "drink_apply": 20,
  ]));
  setup();
}

void init() {
  ::init();
  add_action("do_drink", "drink");
}

int do_drink(string arg) {
  object me = this_player();
  int thistimes;
  thistimes = me->query_temp("xli_marks/drinkthis");
  if (arg == "hongniu") {
    if (query("liquid/remaining") < 1) {
      destruct(this_object());
      return notify_fail(query("name") + "已经被喝得一滴也不剩了。\n");
    }
    if (me->query("water") >= me->max_water_capacity())
      return notify_fail("你现在已经喝不下更多的水了。\n");
    add("liquid/remaining", -1);
    me->add("water", query("liquid/drink_apply"));
    if (query("liquid/name") != "红牛") {
      message_vision("$N拿起" + query("name") +
        "咕噜噜地喝了几口" + query("liquid/name") + "。\n", me);
      return 1;
    }
    message_vision("$N拿起" + query("name") +
      "咕噜噜地喝了几口红牛饮料。\n", me);

    if (random(20) != 1) me->add("hamlet_food/per", 20);
    else me->add("hamlet_food/str", 20);
    if (me->query("hamlet_food/per") >= 1000) {
      me->add("hamlet_food/per", -1000);
      me->add("per", 1);
      write("你变得更漂亮了耶。\n");
    }
    if (me->query("hamlet_food/str") >= 1000) {
      me->add("hamlet_food/str", -1000);
      me->add("str", 1);
      tell_object(me, "你浑身充满了劲，好象力量有了明显的改善。\n");
      me->add("combat_exp", 1000 + random(4000));
      me->add("social_exp", 1000 + random(2000));
      tell_object(me, "你顿感心胸开朗，仿佛于江湖世事有了更深的了解。\n");

    }
    return 1;
  }
  return 0;
}

/*
你拿起可口可乐咕噜噜地喝了几口可口可乐。
可口可乐已经被喝得一滴也不剩了
*/
