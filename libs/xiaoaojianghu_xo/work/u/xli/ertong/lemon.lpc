// lemon.c  水果，柠檬，有一定几率涨某修为

#include <ansi.h>
inherit ITEM;
inherit F_FRUIT;

string *xiuwei_name=({HIY"拳法"NOR,BLU"剑法"NOR,GRN"刀法"NOR,HIG"轻功"NOR,RED"鞭法"NOR,HIC"长兵刃"NOR,HIW"短兵刃"NOR});
string *xiuwei_type=({"unarmed","sword","blade","dodge","whip","long","short"});

void create()
{
    set_name( GRN"柠檬"NOR, ({"lemon"}) );
    set_weight(50);//一两
    if( clonep() ) 
        set_default_object(__FILE__);
    else 
    {
        set("unit", "枚");
        set("long","一个水灵灵的柠檬，拿在手里光滑圆润。");
        set("value", 10);
        set("lemon_remaining", 4); //可以吃4口
    //	set("food_supply", 10);   //每口加10的food
    //	set("water_supply", 30);  //每口可以加10的water
    //	set("eat_msg", "$N拿起$n，轻轻的咬了一口，顿时满嘴又酸又甜。\n"); 
    //	set("end_msg", "$N仔细的吃完了这个$n。\n");  
    //	set("over_msg", "你看你，吃了几个$n啊，酸成这样！！！！\n"); 
    }
    setup();
}
void init()
{
    add_action( "di_eat", ({"eat","yao"}) );
}

int di_eat(string arg)
{
    int now_xiuwei_no,now_xiuwei,add_xiuwei;
    string now_xiuwei_name,now_xiuwei_type;
    
    object me=this_player();
    
    if( !arg || arg!="lemon" )
    	return notify_fail("你要咬什么啊？\n");
    if( me->query("food") >= me->max_food_capacity() )
        return notify_fail("你已经吃的太饱了，这么惹人喜爱的柠檬都吃不下了。\n");
	if( me->query("water") >= me->max_water_capacity() )
	    return notify_fail("你已经喝的太多了，一滴柠檬汁都喝不下去了。\n");
    if( query("lemon_remaining")==1 )
    {
    	tell_object(me,"你仔细地吃完了这个"+GRN"柠檬"NOR+"。\n");
    	destruct(this_object());
    }
    else
    {
    	tell_object(me,"你拿起"+GRN"柠檬"NOR+"，轻轻的咬了一口，顿时满嘴又酸又甜。\n"); 
    	add("lemon_remaining",-1);
    }
    me->add("food",10);
    me->add("water",20);
    if( random(10)!=1 )
	    return 1;
	
    now_xiuwei_no=random(7);
    now_xiuwei_type=xiuwei_type[now_xiuwei_no];
    now_xiuwei_name=xiuwei_name[now_xiuwei_no];
    now_xiuwei=me->query_xiuwei_by_type(now_xiuwei_type);
    add_xiuwei=100+random(150)-random( me->query("age")*5+now_xiuwei/100 );
    if( add_xiuwei< 50 )
        add_xiuwei=50;
    me->set_xiuwei_by_type(now_xiuwei_type,now_xiuwei+add_xiuwei);
    tell_object(me,"你回味着"+GRN"柠檬"NOR+"又酸又甜的滋味，突然感觉到自己对〖"+
                     now_xiuwei_name+"〗的理解又加深了一层。\n");
    return 1; 
}
