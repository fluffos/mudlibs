// baozi.c

#include <ansi.h>
inherit ITEM;
inherit F_FOOD;

string GetName() {
  string name;
  int i;
  i = random(25);
  switch (i) {
    case 0: name = "干菜包子";
    break;
    case 1: name = "荠菜包子";
    break;
    case 2: name = "三丁包子";
    break;
    case 3: name = "生肉包子";
    break;
    case 4: name = "水晶包子";
    break;
    case 5: name = "干菜包子";
    break;
    case 6: name = "笋肉包子";
    break;
    case 7: name = "小菜包子";
    break;
    case 8: name = "蟹黄包子";
    break;
    case 9: name = "稀沙包子";
    break;
    case 10: name = "鸭菜包子";
    break;
    case 11: name = "狗肉包子";
    break;
    case 12: name = "羊肉包子";
    break;
    case 13: name = "白菜包子";
    break;
    case 14: name = "大葱包子";
    break;
    case 15: name = "狗不理包子";
    break;
    case 16: name = "小树包子";
    break;
    case 17: name = "宝贝包子";
    break;
    case 18: name = "温柔包子";
    break;
    case 19: name = "断肠包子";
    break;
    case 20: name = "小花包子";
    break;
    case 21: name = "菜茵包子";
    break;
    case 22: name = "飞龙包子";
    break;
    case 23: name = "肥狐包子";
    break;
    default: name = "包子";
  }
  return name;
}

string GiveGift() {
  string giftname;
  int i;
  i = random(8);
  switch (i) {
    case 0: giftname = "str";
    break;
    case 1: giftname = "int";
    break;
    case 2: giftname = "per";
    break;
    case 3: giftname = "kar";
    break;
    case 4: giftname = "con";
    break;
    case 5: giftname = "dex";
    break;
    case 6: giftname = "cor";
    break;
    case 7: giftname = "cps";
    break;
    default: giftname = "int";
    break;
  }
  return giftname;
}

void set_all() {
  string theName;
  string getGift;
  theName = GetName();
  getGift = GiveGift();
  set("name", theName);
  set("long", "一个" + theName + "，忍不住想咬（yao）一口。\n");
  set("gifts", ([
    getGift: 10,
  ]));
}

void create() {
  set_name("包子", ({ "baozi" }));
  set_weight(50);  //一两
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("value", 8);
    set("food_remaining", 1);
    set("food_supply", 30);
  }
  set_all();
  setup();
}
void init() {
  add_action("di_eat", "yao");
  //::init();
}

int di_eat(string arg) {
  object me = this_player();
  if (!arg || arg != "baozi")
    return notify_fail("你要咬什么东西？\n");
  if (me->query("food") >= me->max_food_capacity())
    return notify_fail("现在你吃不下任何东西，实在懒得花力气咬了 。\n");
  if (me->query("hamlet_food/kar") >= 1000) {
    write("你的福缘有了显著的改善。\n");
    me->add("kar", 1);
    me->add("hamlet_food/kar", -1000);
  }
  if (me->query("hamlet_food/str") >= 1000) {
    write("你的膂力有了显著的改善。\n");
    me->add("str", 1);
    me->add("hamlet_food/str", -1000);
  }
  if (me->query("hamlet_food/per") >= 1000) {
    write("你的容貌有了显著的改善。\n");
    me->add("per", 1);
    me->add("hamlet_food/per", -1000);
  }
  if (me->query("hamlet_food/con") >= 1000) {
    write("你的根骨有了显著的改善。\n");
    me->add("con", 1);
    me->add("hamlet_food/con", -1000);
  }
  if (me->query("hamlet_food/cps") >= 1000) {
    write("你的灵性有了显著的改善。\n");
    me->add("cps", 1);
    me->add("hamlet_food/cps", -1000);
  }
  if (me->query("hamlet_food/cor") >= 1000) {
    write("你的胆识有了显著的改善。\n");
    me->add("cor", 1);
    me->add("hamlet_food/cor", -1000);
  }
  if (me->query("hamlet_food/int") >= 1000) {
    write("你的悟性有了显著的改善。\n");
    me->add("int", 1);
    me->add("hamlet_food/int", -1000);
  }
  if (me->query("hamlet_food/dex") >= 1000) {
    write("你的机敏有了显著的改善。\n");
    me->add("dex", 1);
    me->add("hamlet_food/dex", -1000);
  }
  //  destruct( this_object() );
  return "/cmds/verb/eat.lpc"->main(me, "baozi");
}
