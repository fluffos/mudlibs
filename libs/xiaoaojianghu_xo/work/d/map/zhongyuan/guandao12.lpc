#include <ansi.h>
inherit ROAD;
void create()
{
  set("short","官道");
  set("long",@LONG
宽阔平坦的大道笔直地通向汴京，道宽十余丈，路面上的黄土压得结结实实
，飞马驰过也只是轻起尘埃。道边是两排高大的垂杨柳。一队队商旅车队在大道
上首尾相连，望不到头，行人络绎不绝，谈吐服饰各异；临近汴京，路上越发热
闹起来；大道两边也出现了很多市坊，集市。叫卖声不绝于耳。
LONG HIY @TEXT
    东面四十里外，汴京城宏伟的外郭城墙隐隐现于地平线处。
TEXT NOR);
  set("exits",([
    "east" : "/d/city/capital/jinming_chi",
    "west"  : __DIR__"guandao11",
  ]));
    set("outdoors","zhongyuan");
  setup();
}
int valid_leave(object me,string dir)
{
     if( dir == "east"){
         write(MAG"终于到达繁华无比的汴京城了\n" NOR);}
     return ::valid_leave(me,dir);
}

