// dog.c

inherit NPC;

void create()
{
        set_name("大狼犬", ({ "lang quan","dog","quan" }) );
        set("race", "野兽");
        set("age", 3);
        set("long", "一只凶恶的大狼犬，它喉咙里不时发出可怕的低吼声。\n");
        
        set("str", 100);
        set("cor", 100);
        set("max_kee",400);
        set("kee",400);
        set("max_sen",300);
        set("sen",300);

        set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }) );
        set("verbs", ({ "bite", "claw" }) );
        
        set("combat_exp", 100000);
        set_temp("armor", 30);

        setup();
}

void init()
{
    if( interactive( this_player() ) && random(10) > 7  )
    {
        message_vision("大狼犬向$N疯狂地咆哮起来.....只听到几声低喉，大狼犬"
                    "已扑到了$N身上.....\n", this_player() );
        kill_ob(this_player());
        this_player()->fight_ob(this_object() );
    }
}

