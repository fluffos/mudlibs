inherit ITEM;

#include <ansi.h>

void create()
{
    set_name( HIY"苜蓿"NOR,({"mu xu","muxu","clove" }) );
    set_weight( 100 );
    if( clonep() )
        set_default_object( __FILE__ );
    else 
    {
        set( "long","一种草药\n" );
        set( "unit","棵" );
        set( "value",3000 );
    }
    setup();
}
