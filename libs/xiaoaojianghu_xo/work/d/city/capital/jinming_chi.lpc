// 汴京     /d/city/capital/jinming_chi.c
#include <room.h>
#include <ansi.h>
#include "bianjing.h"
inherit STREET;
void create()
{
    set("short",GRN "金明池畔" NOR);
    set("long",@LONG
金明池在汴京城西，顺天门外；周徊九里，是周显德四年，世宗欲伐南唐，
为了训练水师而开凿的。太祖登基后，将这里改建成了一片美丽的园林琼苑，作
为皇家游幸的场所。每年也定期向城中百姓开放游览，成为京城一大景致。路北
即是金明池，池边一带园墙围绕，朱漆大门横阔五间，是皇家气派。
LONG);
    set("exits",([
        "northeast"   : __DIR__"hengjie2",
        "south"  : __DIR__"jianke_miao",
        "east"  : __DIR__"xinz_men",
        "west"  : "/d/map/zhongyuan/guandao12",
    ]));
//    set("objects",([
//        __DIR__"npc/gate_yuhou" : 2,
//    ]));
    setup();
}
void reset()
{
    object npc;
    int i;
    ::reset();
    if( !objectp( present( "yu hou", this_object() ) ) )
      for( i = 0; i < 2; i ++ ){
        npc = new( "/d/city/capital/npc/gate_yuhou" );
        npc->move( this_object() );
        npc->set("title",CYN"金明池守卫"YEL"金枪班"NOR);
      }
}

int valid_leave(object me,string dir)
{
       if( !objectp( present( "yu hou", environment( me ) ) ) ) 
               return 1;
       if( dir != "northeast")
               return 1;
       return notify_fail(RED
"守门军官冲你喊道：“此龙颜游幸之所，汝系何人，怎能乱闯？快快走开!!”\n" NOR);
}


