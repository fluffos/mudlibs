// 汴京 TEA :      yuyechun.c

inherit TEA;

#include <ansi.h>
#include "bianjing.h"

void create() {
  set_name(WHT "玉液长春" NOR, ({ "yuye changchun", "cha", "tea" }));
  set("long", @LONG 
    玉液长春是茶中的精品，是用精心采制的茶叶，焙干而成，作浅白绿，遍
  体布满白毛，清香无比。
LONG);
  set("unit", "饼");
  set("value", 5000);
  set_weight(50);
  setup();
}
