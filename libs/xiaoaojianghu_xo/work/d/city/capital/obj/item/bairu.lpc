// 汴京 TEA :      bairu.c

inherit TEA;
              
#include <ansi.h>
#include "bianjing.h"

void create()
{
    set_name(WHT"白乳茶"NOR, ({ "bairu cha","cha","tea","dragon tea" }) );
    set("long",@LONG 
    白乳是茶中的精品，是用精心采制的茶叶，焙干而成，常常用作贡品。
LONG);
    set("unit","饼");
    set("value",50000);
    set_weight(50);
    setup();
}

