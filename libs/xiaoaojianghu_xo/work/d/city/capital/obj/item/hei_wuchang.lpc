// 汴京 ITEM : hei_wuchang.c

#include <ansi.h>
#include "bianjing.h"
inherit ITEM;

void create()
{
    set_name(BLK "黑无常" NOR, ({ "hei wuchang","wuchang" }) );
    set("long","黑无常伸著长长的舌头瞪著你，黝黑的脸上看不出任何喜怒哀乐。\n");
    set("unit","尊");
    set("value",10000);
    set("cant_sell","这么蠢的泥胎也来当？\n");
    set_weight(1000000);
    setup();
}

