// 汴京 TEA :      wanchun_yinye.c

inherit TEA;
              
#include <ansi.h>
#include "bianjing.h"

void create()
{
    set_name(HIW"万春银叶"NOR, ({ "wanchun yinye","cha","tea"}) );
    set("long",@LONG 
    万春银叶是茶中的精品，是用精心采制的茶叶，焙干而成，遍体白毛，
  叶片也作白色，香气清爽。
LONG);
    set("unit","饼");
    set("value",2000);
    set_weight(50);
    setup();
}

