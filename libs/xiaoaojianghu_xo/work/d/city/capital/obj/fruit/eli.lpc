// 汴京 FRUITs:    eli.c
#include <ansi.h>
inherit ITEM;
inherit F_FRUIT;
void create()
{
    set_name(YEL "河北鹅梨"NOR, ({"e li","li","fruit"}));
    set_weight(60);
    set("long", "好大个儿的一个雪花脆梨。");
    set("unit", "个");
    set("value", 1);
    set("fruit_remaining", 3); 
    set("food_supply", 2); 
    set("water_supply", 20); 
    set("eat_msg", "$N拿起$n，咬了一口\n");
    set("end_msg", "$N仔细的啃完了这个$n。\n"); 
    set("over_msg", "吃这么多？小心撑破肚皮！！！！\n"); 
    set("core", "梨核");     //name
    set("core_id", ({"li hu", "core"}) ); //id
    set("core_unit", "个");    //unit
    set("core_long", "一个梨核。\n"); //long

    setup();
}
void init()
{
    add_action("do_eat","eat");
}

