// 汴京 FRUITs:    longya_lizhi.c
#include <ansi.h>
inherit ITEM;
inherit F_FRUIT;
void create()
{
    set_name(MAG "龙牙荔枝" NOR, ({"longya lizhi","lizhi","fruit"}));
    set_weight(300);
    set("long", "一枝从南方运来的荔枝枝条上挂了二三十个鲜嫩的荔枝。");
    set("unit", "把");
    set("value", 400);
    set("fruit_remaining", 20); //可以吃5口
    set("food_supply", 2);   //每口加10的food
    set("water_supply", 8);  //每口可以加10的water
    set("eat_msg", "$N摘下一个荔枝放进嘴里--好甜呀!!\n");
    set("end_msg", "$N仔细的啃完了最后一个$n。\n");
    set("gifts",([
        "per" : 1,
    ]));
    set("core", "荔枝枝");     //name
    set("core_id", ({"lizhi zhi", "zhi"}) ); //id
    set("core_unit", "根");  
    setup();
}
void init()
{
    add_action("do_eat","eat");
}


