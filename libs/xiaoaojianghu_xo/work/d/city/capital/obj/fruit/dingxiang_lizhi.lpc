// 汴京 FRUITs:    dingxiang_lizhi.c
#include <ansi.h>
inherit ITEM;
inherit F_FRUIT;
void create()
{
    set_name(HIW "丁香荔枝" NOR, ({"dingxiang lizhi","lizhi","fruit"}));
    set_weight(300);
    set("long",
"一枝从南方运来的荔枝枝条上挂了二三十个鲜嫩的荔枝，散发出一种\n"
"丁香的香味.\n");
    set("unit", "把");
    set("value", 500);
    set("fruit_remaining", 20);
    set("food_supply", 3); 
    set("water_supply", 10); 
    set("eat_msg", "$N摘下一个荔枝放进嘴里--好甜呀!!\n");
    set("end_msg", "$N仔细的啃完了最后一个$n。\n");
    set("gifts",([
        "per" : 1,
    ]));
    set("core", "荔枝枝");     //name
    set("core_id", ({"lizhi zhi", "zhi"}) ); //id
    set("core_unit", "根");  

    setup();
}
void init()
{
    add_action("do_eat","eat");
}


