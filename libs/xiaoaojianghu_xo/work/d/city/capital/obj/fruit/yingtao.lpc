//汴京 : FRUITs    yingtao.c

inherit ITEM;
inherit F_FRUIT;

#include <ansi.h>

void init()
{
    add_action("do_eat", "eat");
}

void create()
{
    set_name(RED"樱桃"NOR, ({"ying tao","fruit"}));
    set_weight(500);
    set("long", @LONG
    一大把红红的樱桃，鲜灵灵的。
LONG);
    set("unit", "捧");
    set("value", 30);
    set("fruit_remaining", 6); 
    set("food_supply", 5);  
    set("water_supply", 20);  
    set("eat_msg", "$N从一捧樱桃中摘下一个，小心翼翼地放进嘴里。\n");
    set("end_msg", "$N恋恋不舍地吃完了最后一颗樱桃。\n");
    set("over_msg", "吃这么多？小心撑破肚皮！！！！\n");
    set("gifts",([
        "per" : 1,
    ]));
    set("core", "樱桃枝");   
    set("core_id", ({"yingtao zhi", "zhi"}) );
    set("core_unit", "把");
    set("core_long", "一把细小的树枝。\n");

    setup();
}

