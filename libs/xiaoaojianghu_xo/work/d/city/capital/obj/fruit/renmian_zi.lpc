//汴京 FRUITs :   renmian_zi.c

inherit ITEM;
inherit F_FRUIT;

#include <ansi.h>

void init()
{
    add_action("do_eat", "eat");
}

void create()
{
    set_name(MAG"人面子"NOR, ({"renmian zi","zi","fruit"}));
    set_weight(100);
    set("long", @LONG  
    人面子产在岭南山区，样子很象桃子，但是味道酸甜，果核
  椭圆型，两面很象人的面孔。
LONG);
    set("unit", "个");
    set("value", 20);
    set("fruit_remaining", 3);
    set("food_supply", 10); 
    set("water_supply", 13);
    set("eat_msg", "$N拿起$n，咬了一口，登时香甜满腹，顿觉清爽怡人。\n");
    set("end_msg", "$N仔细的啃完了这个$n。\n");
    set("over_msg", "吃这么多？小心撑破肚皮！！！！\n");
    set("gifts",([
    ]));
    set("core", HIM"果核"NOR);  
    set("core_id", ({"guo hu","hu", "core"}) );
    set("core_unit", "枚");  
    set("core_long", "人面子的核，呈椭圆型，两面扁圆，看上去很象人的面孔，有鼻子\n"
    "有嘴，满有趣的。\n"); 

    setup();
}

