// 汴京 FRUITs:    jin_tao.c
#include <ansi.h>
inherit ITEM;
inherit F_FRUIT;
void create()
{
    set_name(RED "朱李"NOR, ({"zhu li","li","fruit"}));
    set_weight(10);
    set("long", "一个红得发紫的李子，肯定很好吃。");
    set("unit", "个");
    set("value", 4);
    set("fruit_remaining", 2); //可以吃5口
    set("food_supply", 3);   //每口加10的food
    set("water_supply", 10);  //每口可以加10的water
    set("eat_msg", "$N拿起$n，咬了一口--好甜呀!!\n"); 
    set("end_msg", "$N仔细的啃完了这个$n。\n");  
    set("core", "李子核");     //name
    set("core_id", ({"lizi hu", "core"}) ); //id
    set("core_unit", "个");  
    set("gifts",([
        "per" : 1,
        "int" : 1,
    ])); 
    set("core_long", "一个李子核。\n"); //long

    setup();
}
void init()
{
    add_action("do_eat","eat");
}

