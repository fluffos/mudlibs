//汴京 FRUITs : fengxi_li.c

inherit ITEM;
inherit F_FRUIT;

#include <ansi.h>

void init()
{
    add_action("do_eat", "eat");
}

void create()
{
    set_name(YEL"凤栖梨"NOR, ({"fengxi li","li","fruit"}));
    set_weight(80);
    set("long", @LONG
一个黄澄澄的大梨，表面布满褐色的小点。一股香气隐隐散出。
LONG);
    set("unit", "个");
    set("value", 2);
    set("fruit_remaining", 3);
    set("food_supply", 5); 
    set("water_supply", 15); 
    set("eat_msg", "$N拿起$n，大大的啃了一口。\n");
    set("core", "梨核");
    set("core_id", ({"li hu","hu", "core"}) );
    set("core_unit", "个"); 
    set("core_long", "一个梨核。\n");

    setup();
}

