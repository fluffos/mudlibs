// 汴京 FRUITs:    wumi_tao.c
#include <ansi.h>
inherit ITEM;
inherit F_FRUIT;
void create()
{
    set_name(HIY"乌蜜桃"NOR, ({"wumi tao","tao","fruit"}));
    set_weight(60);
    set("long", "黄澄澄的一个桃子，看上去肯定好吃的狠。");
    set("unit", "个");
    set("value", 2);
    set("fruit_remaining", 1); //可以吃5口
    set("food_supply", 10);   //每口加10的food
    set("water_supply", 18);  //每口可以加10的water
    set("eat_msg", "$N拿起$n，大大的啃了一口。\n"); 
    set("end_msg", "$N仔细的啃完了这个$n。\n");  
    set("over_msg", "吃这么多？小心撑破肚皮！！！！\n");
    set("gifts",([
        "int" : 1,
    ])); 
    set("core", "桃核");   
    set("core_id", ({"tao hu", "core"}) ); //id
    set("core_unit", "个");    //unit
    set("core_long", "一个桃核。\n"); //long

    setup();
}
void init()
{
    add_action("do_eat","eat");
}

