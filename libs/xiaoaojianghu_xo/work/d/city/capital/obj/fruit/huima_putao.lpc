//汴京 FRUITs : huima_putao.c

inherit ITEM;
inherit F_FRUIT;

#include <ansi.h>

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(MAG "回马葡萄" NOR, ({ "huima putao", "putao", "fruit" }));
  set_weight(1000);
  set("long", @LONG
    一串紫黑色的葡萄，刚刚用冷水洗过，看上去水灵灵的。
LONG);
  set("unit", "串");
  set("value", 20);
  set("fruit_remaining", 10);
  set("food_supply", 5);
  set("water_supply", 20);
  set("eat_msg", "$N摘下几个$n放进嘴里。\n");
  set("gifts", ([
    "per": 2,
  ]));

  setup();
}
