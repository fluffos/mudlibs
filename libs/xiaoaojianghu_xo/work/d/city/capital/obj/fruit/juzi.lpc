//汴京 FRUITs :  juzi.c

inherit ITEM;
inherit F_FRUIT;

#include <ansi.h>

void init()
{
    add_action("do_eat", "eat");
}

void create()
{
    set_name(YEL"橘子"NOR, ({"ju zi","ju","orange","fruit"}));
    set_weight(100);
    set("long", @LONG    
    一个黄澄澄的从岭南运来的橘子。香气四溢
LONG);
    set("unit", "个");
    set("value", 20);
    set("fruit_remaining", 3);
    set("food_supply", 5); 
    set("water_supply", 20);
    set("eat_msg", "$N拿起$n，大大的啃了一口( 当然是剥了皮之后 )。\n");
    set("end_msg", "$N仔细的啃完了这个$n。\n");
    set("over_msg", "吃这么多？小心撑破肚皮！！！！\n");
    set("gifts",([
    ]));
    set("core", YEL"橘子皮"NOR);  
    set("core_id", ({"juzi pi","pi"}) );
    set("core_unit", "张");  

    setup();
}

