// 汴京 FOOD：    dousha_tuanzi.c
inherit ITEM;
inherit F_FOOD;
#include <ansi.h>
void create() {
  set_name(HIW "豆沙团子" NOR, ({ "dousha tuanzi", "tuanzi", "food" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", @LONG
  豆沙团子：用新鲜的江米饭裹了细腻的豆沙馅儿。
LONG
    );
    set("unit", "只");
    set("value", 5);
    set("over_value", 0);
    set("food_remaining", 3);
    set("food_supply", 30);  //正常饭量的人一顿吃二斤。
    set("eat_msg", "$N贪婪地将$n放进嘴里大嚼起来.\n");
    //                set("end_msg","$N将纸包里的最后一个$n放进嘴里，颇有些舍不得。.\n");
  }
}
int eat_effect(object me, object this) {
  //    me->add("water",-3);
  return 0;
}
