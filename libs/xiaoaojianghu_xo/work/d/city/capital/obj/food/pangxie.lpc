//汴京 FOODs:  pangxie.c

inherit ITEM;
inherit F_FOOD;

#include <ansi.h>

void create() {
  set_name(HIY "螃蟹" NOR, ({ "pang xie", "xie", "food" }));
  set_weight(100);
  set("long", @LONG         
    一个煮得金黄色的大螃蟹，八条腿蜷蜷着，一双眼睛瞪得大大的，好一
  付死不瞑目的样子，可怜呦～～～！
LONG);
  set("unit", "只");
  set("value", 6);
  set("over_value", 0);
  set("food_remaining", 2);
  set("gifts", ([
    "int": 1,
    "cor": 1,
  ]));
  set("food_supply", 20);
  set("eat_msg", "$N拿起$n，掰开壳，对着里面肥厚的蟹黄就是一口.\n");
  set("end_msg", "$N将剩下的钳子，小腿都嘬得干干净净。.\n");
}
int eat_effect(object me, object this) {
  if (me->query("water") < me->max_water_capacity())
    me->add("water", -3);
  return 0;
}
