#include <ansi.h>
inherit ITEM;
inherit F_FOOD;
void create()
{
    set_name("狗肉包子", ({"gourou baozi","baozi","bao"}));
    set_weight(500);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "一包热气腾腾的狗肉包子，用油纸包着。\n");
        set("unit", "包");
        set("value", 10);
        set("over_value",0);
        set("food_remaining", 3);
