// 汴京 FOOD：    gancao_liangshui.c   

inherit ITEM;
inherit F_FOOD;      

#include <ansi.h>                   

void create()
{
    set_name(CYN"甘草冰雪凉水"NOR, ({"gancao bingxue liangshui","liangshui","shui","water"}));
    set_weight(150);
    set("long",@LONG
    一杯凉气怡人的雪水，里面还可以看的见冰渣儿。由于加了些甘草，又
  别有一番香气。
LONG
);
    set("unit", "杯");
    set("value", 3);
    set("food_remaining", 1);  
    set("gifts",([
        "per" : 1,
        "spi" : 6,
        "dex" : 3,
    ]));
    set("food_supply",1);
    set("end_msg","$N将杯子里的$n一饮而尽，真凉爽呀！\n");
}
int eat_effect(object me,object this)
{
    if( me->query("water") < me->max_water_capacity() )
    {
        me->add("water",60);
        return 0;
    }
    else
    {
        tell_object(me,"你肚子里已经灌了个水饱儿了，别喝啦!\n");
        return 1;
    }
}
int finish_eat( object me , object this )
{
    this->set_name(GRN"竹杯"NOR,({"zhu bei","bei","cup" }));
    this->set("long","一个竹子抠成的小杯子。\n");
    this->set("unit","只");
    this->set("value",0);
    this->set_weight(10);
    return 1;
}

