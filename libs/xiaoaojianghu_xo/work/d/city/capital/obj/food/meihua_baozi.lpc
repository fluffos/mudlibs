// 汴京 FOOD：    meihua_baozi.c
inherit ITEM;
inherit F_FOOD;
#include <ansi.h>
void create() {
  set_name(MAG "梅花包子" NOR, ({ "meihua baozi", "baozi", "bao" }));
  set_weight(250);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", @LONG
    一包热气腾腾的“山洞梅花包子”，用油纸包着。这是汴京城中最有名的
食品之一，是龙津桥王楼的“招牌”。
LONG
    );
    set("unit", "包");
    set("value", 15);
    set("over_value", 0);
    set("food_remaining", 10);
    set("food_supply", 10);  //正常饭量的人一顿吃二斤。
    set("gifts", ([
      "per": 1,
      "str": 1,
      "spi": 1,
    ]));
    set("eat_msg", "$N从纸包里拿出一个$n放进嘴里，好吃的不得了耶！\n");
    set("end_msg", "$N将纸包里的最后一个$n放进嘴里，颇有些舍不得。.\n");
  }
}
int eat_effect(object me, object this) {
  me->add("water", -1);
  return 0;
}
int finish_eat(object me, object this) {
  this->set_name("油皮纸", ({ "youpi zhi", "zhi", "paper" }));
  this->set("long", "一张用来包包子的纸，已经被油浸透了。\n");
  this->set("unit", "张");
  this->set("value", 0);
  this->set_weight(1);
  return 1;
}
