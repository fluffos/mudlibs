// 汴京 FOOD：    xunaozirou.c
inherit ITEM;
inherit F_FOOD;
#include <ansi.h>
void create()
{
    set_name(WHT"须脑子肉"NOR, ({"xunaozi rou","rou","meat"}));
    set_weight(150);
    set("long",@LONG
    一碗炖动物的脑子。            
LONG
);
    set("unit", "碗");
    set("value", 12);
    set("over_value",0);
    set("food_remaining", 4);
    set("food_supply",20);//正常饭量的人一顿吃二斤。
    set("gifts",([
        "str" : 3,
        "cor" : 3, 
        "int" : 10,
    ]));
    set("eat_msg","$N舀了一勺$n放进嘴里.\n");
}
int finish_eat( object me , object this )
{
    this->set_name(WHT"瓷碗"NOR,({"ci wan","wan" }));
    this->set("unit","个");
    this->set("value",2);
    this->set_weight(100);
    return 1;
}

