// 汴京 FOOD：    shanyu_baozi.c
inherit ITEM;
inherit F_FOOD;
#include <ansi.h>
void create() {
  set_name(HIY "鳝鱼包子" NOR, ({ "bao zi", "bao" }));
  set_weight(250);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一包热气腾腾的鳝鱼馅儿包子，用油纸包着。\n");
    set("unit", "包");
    set("value", 15);
    set("over_value", 0);
    set("food_remaining", 8);
    set("food_supply", 12);  //正常饭量的人一顿吃二斤。
    set("gifts", ([
      "str": 1,
      "spi": 1,
    ]));
    set("eat_msg", "$N从纸包里拿出一个$n放进嘴里，好吃的不得了耶！\n");
    set("end_msg", "$N将纸包里的最后一个$n放进嘴里，颇有些舍不得。.\n");
  }
}
int eat_effect(object me, object this) {
  me->add("water", -1);
  return 0;
}
int finish_eat(object me, object this) {
  this->set_name(HIY "油皮纸" NOR, ({ "youpi zhi", "zhi", "paper" }));
  this->set("long", "一张用来包包子的纸，已经被油浸透了。\n");
  this->set("unit", "张");
  this->set("value", 0);
  this->set_weight(1);
  return 1;
}
