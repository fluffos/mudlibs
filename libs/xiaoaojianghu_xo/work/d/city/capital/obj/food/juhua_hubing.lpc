//汴京 FOODs:   juhua_hubing.c

inherit ITEM;
inherit F_FOOD;

#include <ansi.h>

void create()
{
    set_name("菊花胡饼", ({"juhua hubing","hubing","bing","food"}));
    set_weight(200);
    set("long",@LONG   
    一个烤得外皮焦黄的芝麻胡饼,用菊花熏过，散发着一股清香。
LONG);
    set("unit", "个");
    set("value", 5);
    set("over_value",0);
    set("food_remaining", 3);    
    set("gifts",([
        "spi" : 1,
    ]));
    set("food_supply", 25);
    set("eat_msg","$N拿起$n咬了一口.\n");
    set("end_msg","$N将剩下的$n吃的干干净净.\n");
}
int eat_effect(object me,object this) 
{
    if( me->query("water") > 0  ) 
        me->add("water",-1);     
    return 0;
}

