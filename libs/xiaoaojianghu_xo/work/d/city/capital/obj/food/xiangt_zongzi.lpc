//汴京： FOODs :    xiangt_zongzi.c

inherit ITEM;
inherit F_FOOD;

#include <ansi.h>

void create()
{
    set_name(YEL"香糖粽子"NOR, ({"xiang tang zongzi","zongzi","food"}));
    set_weight(50);
    set("long",@LONG 
    粽子本名“角黍”，俗称为“粽子”。煮的粽子用烧艾草的灰调水淋煮，
  煮好的粽子颜色金黄，所谓“角黍包金，香蒲切玉”就是谓此。粽子里面
  裹的是乳糖，还点有麝香，别有一番风味。
LONG);
    set("unit", "个");
    set("value", 10);
    set("over_value",0);  
    set("gifts",([
        "con" : 1,
        "int" : 2,
        "per" : 1,
        "kee" : 1000,
    ]));                                
    set("food_remaining", 2);
    set("food_supply", 30);
    set("eat_msg","$N拿起$n咬了一口--真粘呀！，牙齿都要掉下来了!一股清新的麝香气味直渗入全身。\n");
    set("end_msg","$N将剩下的$n吃的干干净净.\n");
}

int eat_effect( object me , object this )                  
{
    if( me->query("kee") < me->query("max_kee") )    
    {
        me->add( "kee" , random(3) );
        tell_object(me,"你觉得自己甚至又多了些力气......\n");
    }
    return 0;
}  
int finish_eat( object me , object this )
{
    this->set_name(HIG"菰叶"NOR,({"gu ye","ye","leaf" }));
    this->set("long",@LONG      
    菰叶就是芦苇叶子，民间通常都用它来包粽子，这片叶子上面粘着不少
  江米粒，显然是已经用过的叶子了。
LONG);
    this->set("unit","张");
    this->set("value",0);
    this->set_weight(1);
    return 1;
}

