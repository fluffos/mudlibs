//汴京： FOODs :   tangyuan.c 

inherit ITEM;
inherit F_FOOD;

#include <ansi.h>

void create()
{
    set_name(MAG"五"YEL"色"WHT"汤圆"NOR ,({"wuse tangyuan","tangyuan","yuan","food"}));
    set_weight(300);
    set("long",@LONG
    一碗热气腾腾的汤圆，有红白黄橙各色，是上元节的必备食品。
LONG);
    set("unit", "碗");
    set("value", 14);
    set("gifts",([
        "per" : 2,
        "spi" : 2,
        "con" : 2,
    ]));             
    set("food_remaining", 5);
    set("food_supply", 20);
    set("eat_msg","$N拿起筷子夹起一个$n放进嘴里....\n");
    set("end_msg","$N将剩下的$n吃的干干净净.\n");
}
int eat_effect(object me,object this)
{
    if( me->query("water") < me->max_water_capacity() ) 
        me->add("water",10);     
    return 0;
}
int finish_eat( object me , object this )
{
    this->set_name(HIR"木碗"NOR,({"mu wan","wan" }));
    this->set("long",@LONG    
    一只看上去有点蠢的大木碗。
LONG);
    this->set("unit","个");
    this->set("value",1);
    this->set_weight(30);  
    return 1;
}

