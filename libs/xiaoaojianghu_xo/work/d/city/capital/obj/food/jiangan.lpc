//汴京 FOODs:     jiangan.c

inherit ITEM;
inherit F_FOOD;

#include <ansi.h>

void create()
{
    set_name(HIM"煎肝脏"NOR, ({"jian gan","gan","food"}));
    set_weight(150);
    set("unit", "盒");
    set("value", 18);
    set("food_remaining",3 );
    set("food_supply", 30);
    set("eat_msg","$N夹起一块$n放进嘴里.\n");
    set("end_msg","$N将剩下的$n吃的干干净净.\n");
}
int eat_effect(object me,object this) 
{
    if( me->query("water") >0 ) 
        me->add( "water" , -2 );     
    return 0;
}
int finish_eat( object me , object this )
{
    this->set_name(HIM"匣盒"NOR,({"xia he","he","box" }));
    this->set("long",@LONG      
    一个梅红色的匣盒似乎是京城里小贩们专门用来盛食物的那种。
LONG);
    this->set("unit","个");
    this->set("value",1);
    this->set_weight(40);
    return 1;
}

