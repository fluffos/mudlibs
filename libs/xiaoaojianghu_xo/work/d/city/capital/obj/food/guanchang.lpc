// 汴京 FOOD：   guanchang.c

inherit ITEM;
inherit F_FOOD;        

#include <ansi.h>

void create()
{
    set_name(MAG"灌肠"NOR, ({"guan chang","chang","food"}));
    set_weight(500);
    set("long",@LONG        
    灌肠就是把猪小肠中塞些糯米等物，然后切成片来，用滚油煎焦，
  然后沾些盐，蒜，等调味料来吃，很受大众的欢迎。
LONG);
    set("unit", "盘");
    set("value", 10);
    set("food_remaining", 6);
    set("food_supply", 28);
    set("eat_msg","$N从盘子里夹了两片又香又脆，外焦里嫩的$n,高兴地大嚼起来。\n");
    set("end_msg","$N贪婪地将盘子里的最后一块$n吃掉了，眼睛还是盯着盘子，有点想舔盘子的意思。\n");
}
int finish_eat( object me , object this )
{
    this->set_name(GRN"小竹盘儿"NOR,({"zhu pan","pan","zhu","plate" }));
    this->set("long","一个竹子编的小盘。\n");
    this->set("unit","个");
    this->set("value",0);
    this->set_weight(10);
    return 1;
}
