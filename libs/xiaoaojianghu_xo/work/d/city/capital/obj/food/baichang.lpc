// 汴京 FOOD：   baichang.c

inherit ITEM;
inherit F_FOOD;

#include <ansi.h>

void create() {
  set_name(WHT "白肠" NOR, ({ "bai chang", "chang", "meat", "food" }));
  set_weight(500);
  set("long", "一盘刚刚炖好的白煮猪肠，热气腾腾～～～\n");
  set("unit", "盘");
  set("value", 12);
  set("food_remaining", 4);
  set("food_supply", 40);
  set("eat_msg", "$N从盘子里夹了一块$n,高兴地大嚼起来。\n");
  set("end_msg", "$N贪婪地将盘子里的最后一块$n吃掉了，眼睛还是盯着盘子，有点想舔盘子的意思。\n");
}
int finish_eat(object me, object this) {
  this->set_name(GRN "小竹盘儿" NOR, ({ "zhu pan", "pan", "zhu", "plate" }));
  this->set("long", "一个竹子编的小盘。\n");
  this->set("unit", "个");
  this->set("value", 0);
  this->set_weight(10);
  return 1;
}
