//汴京： FOODs :   hebaofan.c 

inherit ITEM;
inherit F_FOOD;

#include <ansi.h>

void create()
{
    set_name(GRN"荷包"WHT"白饭"NOR, ({"hebao fan","fan","food"}));
    set_weight(300);
    set("long",@LONG    
    一个热气腾腾的饭团子，用新鲜的荷叶包裹着，透着一股荷叶的香气。
LONG);
    set("unit", "团");
    set("value", 5);                               
    set("food_remaining", 3);
    set("food_supply", 50);
    set("eat_msg","$N拿起$n狠狠地咬了一口，饭团子里面的鲜肉味和着荷叶的清香，好吃死了！！\n");
    set("end_msg","$N将剩下的$n吃的干干净净.\n");
}
/*
int eat_effect(object me,object this)
{
    if( me->query("water") < me->max_water_capacity() ) 
        me->add("water",10);     
    return 0;
} 
*/
int finish_eat( object me , object this )
{
    this->set_name(GRN"荷叶"NOR,({"he ye","ye" }));
    this->set("long",@LONG  
    一张小小的荷叶，用来包裹食物的。
LONG);
    this->set("unit","张");
    this->set("value",0);
    this->set_weight(10);
    return 1;
}

