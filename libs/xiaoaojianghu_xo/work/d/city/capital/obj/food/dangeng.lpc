//汴京： FOODs :   hegeng.c 

inherit ITEM;
inherit F_FOOD;

#include <ansi.h>

void create()
{
    set_name("单羹", ({"dan geng","geng","food"}));
    set_weight(300);
    set("long",@LONG    
    一碗热气腾腾的素面条。
LONG);
    set("unit", "碗");
    set("value", 5);     
    set("gifts",([
        "str" : -1,
    ]));
    set("over_value",2);                                  
    set("food_remaining", 3);
    set("food_supply", 30);
    set("eat_msg","$N拿起筷子使劲往嘴里扒拉着面条....\n");
    set("end_msg","$N将剩下的$n有些舍不得地吃了个干干净净，连面汤也喝干了.\n");
}
int eat_effect(object me,object this)
{
    if( me->query("water") < me->max_water_capacity() ) 
        me->add("water",30);     
    return 0;
}
int finish_eat( object me , object this )
{
    this->set_name(WHT"粗磁大碗"NOR,({"cuci wan","wan" }));
    this->set("long",@LONG          
    一个加工很不精致的大碗，口上还破了点边。
LONG);
    this->set("unit","个");
    this->set("value",2);
    this->set_weight(30);  
    return 1;
}

