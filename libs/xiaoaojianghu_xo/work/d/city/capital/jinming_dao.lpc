// 汴京     /d/city/capital/jinming_dao.c
#include <room.h>
#include <ansi.h>
#include "bianjing.h"
inherit BROOM;
void create()
{
  set("short",HIW "金明岛" NOR);
  set("long",@LONG
金明岛地处金明池中南侧，方圆百丈；小岛四岸以巨石相砌，岛上柳树成林，
桃李夹道；岛中央有一座圆形的大殿，是皇帝游幸时登临观水的地方；南面是一
座高大的桥，有如飞虹之状，人称“仙桥”。
LONG GRN @TEXT
    一阵阵微风吹来，夹着池水的气息，让人联想起了江南的风光。
TEXT NOR);
  set("exits",([
    "southup"  : __DIR__"xianqiao",
    "enter"    : __DIR__"shuixin_dian",
  ]));
  set("outdoors","capital");
  setup();
}

