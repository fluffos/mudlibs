// 汴京 caolian_chang10.c
#include <room.h>
#include <ansi.h> 
#include "bianjing.h"
inherit BROOM;
void create()
{
    set("short",YEL "操练场" NOR );
    set("long", @LONG            
好大的一个操练广场，脚下是踏实的黄土，四面皆是营房。每天早晨军中士
兵要在这里轮班操练一到两个时辰。余下的时间就都归其自由支配了。久居繁华，
人心生变，向往富贵生平，甚至做小买卖的也大有人在。
    北面空场上是禁军招募士兵，考核军官的地方。
LONG
    );
    set("objects", ([ 
    ]));
    set("location",([
        "meihua-zhuang" : 2,
    ]));
    set("exits", ([    
            "south" : __DIR__"bingying_men4",
        "north" : __DIR__"caolian_chang11",
        "east"  : __DIR__"yingfang15",
        "west"  : __DIR__"yingfang19",
    ]));
    set("detail",([
    ]));     
    set("outdoors","capital");
    setup();
}
int valid_leave( object who, string dir )
{
    if ( dir != "north" )
        return ::valid_leave( who, dir );
    if ( ( ZUZHI_DIR + "jinjun" )->IsExTime() )//是比武招募的季节（春、秋）
        return ::valid_leave( who, dir );
    else
    {
        if ( who->ZuzhiTouxian( "jinjun" ) )
            return notify_fail("还没到比武升官的时候呢！\n");
        else
            return notify_fail("现在不是招募新兵的时候，要等到春秋大比的时候才行。\n");
    }
}

