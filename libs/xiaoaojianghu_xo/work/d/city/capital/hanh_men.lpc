#include <room.h>
#include <ansi.h>
#include "bianjing.h"
inherit GATE;
void create() {
  set("short", HIW "含辉门" NOR);
  set("long", @LONG
含辉门位于外城西北，内与旧城曹门相对，所以旧称“新曹门”，后来才起
了这个名字。城外每隔百步即建一军哨，屯驻数十骑禁军官兵，沿着护城河两岸
是一带柳树临水，风景怡然。
LONG
  );
  set("outdoors", "capital");
  set("objects", ([
    __DIR__ "npc/gate_shibing": 2,
    __DIR__ "npc/gate_dutou": 2,
  ]));
  set("exits", ([
    "south": __DIR__ "xsng_men",
    "northwest": __DIR__ "fqiu_men",
  ]));
  set("detail", ([
  ]));
  setup();
}
void init() {}
