// 汴京     /d/city/capital/dxgs_shanmen.c
#include <room.h>
#include <ansi.h>
#include "bianjing.h"

inherit BROOM;  
void create()
{
    set("short",RED "山门" NOR);
    set("long",@LONG
山门飞阁凌空，朱檐青瓦，气势非凡。正面共开三个大门洞，象征着佛经上
所说的“三界”，进了山门，就算跳出了三界。门楼上挂着一块金龙匾，木质陈
久，上面题着“大相国寺”四个大字，据说这是唐朝慕宗皇帝亲笔所题。
LONG);
    set("exits",([
        "south"    : __DIR__"dxgs_simen",
        "west"     : __DIR__"dxgs_xilang1",
        "east"     : __DIR__"dxgs_donglang1",
        "north"    : __DIR__"dxgs_dayuan1",
    ]));
    set("outdoors","capital");
    setup();
}
void init()
{
    ::init();
}

