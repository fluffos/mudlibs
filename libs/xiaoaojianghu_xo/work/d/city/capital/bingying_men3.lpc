// 汴京 bingying_men1.c
#include <room.h>
#include <ansi.h> 
#include "bianjing.h"
inherit STREET;
void create()
{
        set("short",RED "兵营大门" NOR );
        set("long", @LONG            
这里驻扎的着天武军从第一营一直到第二十三营的禁军官兵。营盘齐整，大帐，
房屋整齐划一。门口几名站岗。禁止行人驻足观看。
LONG
        );
        set("objects", ([ 
        __DIR__"npc/soldier1" : 3,
         ]));
        set("exits", ([    
            "west" : __DIR__"fengqiumen_jie1",
            "east" : __DIR__"caolian_chang9",
         ]));
        set("detail",([
        ]));
        setup();
}
int valid_leave( object me , string dir )
{
    if ( dir != "east" )
        return ::valid_leave( me, dir );
    if ( me->query( "class" ) == "soldier" || me->query( "class" ) == "government" )
        return ::valid_leave( me, dir );
    if ( !objectp ( present ( "shi bing" , environment( me ) ) ) )
        return ::valid_leave( me, dir );
    else{
        message_vision("守门的士兵拦住$N喝道：“里面是禁军兵营，你乱闯什么！！”\n", me );
        return notify_fail("守门士兵拦住了你的去路。\n");
    }
}

