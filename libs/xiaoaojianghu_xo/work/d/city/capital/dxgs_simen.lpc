// 汴京     /d/city/capital/dxgs_simen.c
#include <room.h>
#include <ansi.h>
#include "bianjing.h"

inherit BROOM;  
void create()
{
    set("short",HIW "大相国寺门" NOR);
    set("long",@LONG
大相国寺是汴京最大，最富盛名的寺院。据说这里一千多年前魏公子信陵君
无忌的住宅。北齐年间，这里建起了“建国寺”，后来几经发展而来。临街的前
门是唐朝修建的。门楼卷檐堪称一绝。被本朝著名的木匠喻浩比为“鬼斧神功”，
为了研究其构造，他曾经一连数日卧于门前仰头长思。
LONG);
    set("exits",([
        "south" : __DIR__"dxgs_qiao",
        "north" : __DIR__"dxgs_shanmen",
    ]));
    set("outdoors","capital");
    setup();
}
void init()
{
    ::init();
} 

