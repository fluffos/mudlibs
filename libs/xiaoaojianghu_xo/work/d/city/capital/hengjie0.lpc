// 汴京     /d/city/capital/hengjie0.c
#include <room.h>
#include <ansi.h>
#include "bianjing.h"
inherit STREET;
void create()
{
  set("short",GRN "横街" NOR);
  set("long",@LONG
沿着金明池南岸，是一条牙道柳径，人称横街。南面是一带朱红围墙，沿着
地势高矮相应，金黄色的琉璃瓦映着灿烂的阳光。街北是一溜翠柳临池，脚下青
草茵茵；向东，向西，小径曲曲折折，绿树掩映。中有空地如坪者，是都中游人
击逑游戏的场所。南面有一座不大的宫殿。
LONG GRN @TEXT
    一阵阵微风吹来，夹着池水的气息，让人联想起了江南的风光。
TEXT NOR);
  set("exits",([
    "south"  : __DIR__"shedian",
    "northwest"  : __DIR__"jinming_xian",
    "east"   : __DIR__"chimen_guangchang",
  ]));
  set("outdoors","capital");
  set("objects",([
//          __DIR__"npc/youren1" : 1,
  ]));
  setup();
}

