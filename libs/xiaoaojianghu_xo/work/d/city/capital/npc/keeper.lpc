// 汴京 NPC: keeper.c
#include <ansi.h>
#include "bianjing.h"
inherit NPC;
void create()
{
    set_name("庙祝", ({ "miao zhu","zhu","keeper"}) );
    set("gender", "男性" );
    set("age",random(30) + 45);
    set("max_gin",200);
    set("max_kee",200);
    set("max_sen",200);
    set("title","平民百姓");
    set("class","government");
    set("long",
"一名负责管理这个庙的庙祝，每天打扫庙宇，接受施舍，定时给神主上供等等。\n"
    );
    set("talk_msg",({
      "好心的施主，给神主供奉些钱物吧。\n",
      "神灵会保佑你的\n",
    }));
    set("attitude", "friendly");
    set("rank_info/respect", "老公公");
    set("rank_info/rude","死老头子");
    set("positive_score", 100);
    set("combat_exp",1000);
    set("social_exp",1000);
    setup();
    carry_object( CLOTH_DIR "cloth1")->wear();
}

