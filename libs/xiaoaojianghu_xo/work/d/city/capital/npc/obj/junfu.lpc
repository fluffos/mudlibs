// standard soldieritem    lin 06/26/97
#include <armor.h>
inherit CLOTH;
#include <ansi.h>
void create() {
  set_name(WHT "军服" NOR, ({ "jun fu", "cloth" }));
  set("long", "这是一件崭新的白棉布军服。\n");
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "cloth");
    set("value", 100);
    set("cant_sell", "这是军中的东西，小的可不能收\n");
    set("unit", "件");
    set("armor_prop/armor", 5);
  }
  setup();
}

int is_soldier_use(object me) {
  return 1;
}
