// 汴京 ITEM :      stone_for_joinarmy.c

inherit ITEM;
              
void create()
{
    set_name("大石头", ({ "da shitou","shitou","stone" }) );
    set("long",@LONG 
    一块很大的石头，上面有几处被手磨得光光的，是禁军考试时用来
  检验力气的用具。
LONG);
    set("unit","块");
    set("value","1");
    set("cant_sell","这么大的石头你拿到这儿来干啥？\n");
    set("use_for_join_army's_test",1);
    set_weight( 80000 );// 一个str 16的人将就可以拿动。
}

