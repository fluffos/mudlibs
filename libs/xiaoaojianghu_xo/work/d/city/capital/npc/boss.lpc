inherit RENHE;
void create()
{
        set_name("宋大老板", ({ "lao ban","boss","song" }) );
        set("title", "仁和车行东主" );
        set("gender", "男性" );
        set("age", 46);
        set("location", "汴京");
        set_hp("gin", 500);
        set_hp("kee", 700);
        set_hp("sen", 700);
        set_wugong("haofeng-quan", 70 );
        set_wugong("tianhong", 70 );
        set_xiuwei_by_type("unarmed", 1000 );
        set_xiuwei_by_type("dodge", 1000 );
        set("combat_exp",50000);
        set("long","宋大老板看起来确实是个人物,一双眼睛盯住你\n"
                    "似乎看到了你心里.难怪仁和车行由这么大规模.\n");
        set("attitude", "friendly");
        setup();
        carry_object( CLOTH_DIR "cloth2")->wear();
        add_money("silver", random(5));
}

