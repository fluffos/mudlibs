//汴京 Npc : lin_chong.c 
inherit SOLDIER; 
#include "bianjing.h"
#include <ansi.h>
string call_others(object who); 
void create()
{
    set_name("林冲",({ "lin chong","lin","chong" }));
    set("title",CYN"殿前司"RED"天武军"BLU"枪棒教头"NOR);    
    set("age", 24 );
    set("gender", "男性");
    set("long", @LONG
    林冲二十几岁年纪，年轻气盛，仗着武艺超群，已当上了禁军教头。
LONG);
    set("combat_exp", 130000);
    set("max_force",1500); 
    set("force",1500);
    set("force_factor",20);     
    set_wugong("qiang",120,120);
    set_wugong("jinjun-qiangfa",110,110,1);
    set_wugong("qimei-gun",80,78);
    set_wugong("yang-qiang",100,90,1);
    set_xiuwei_by_type("long",1000);
    set_wugong("unarmed",120,120);
    set_wugong("taizu-quan",100,100);
    set_wugong("yuanyang-tui",90,87,1);
    set_wugong("tiesha-zhang",60,59,1);
    set_xiuwei_by_type("unarmed", 800);
    set_wugong("qinggong",120,120);
    set_wugong("feiyan-zoubi",110,110);
    set_wugong("meihua-bu",100,100,1);
    set_xiuwei_by_type("dodge",800);
    set_wugong("shaolin-xinfa",60,55,1);
    setup();
    carry_object( __DIR__"obj/wuyun_xue" )->wear();
    carry_object( __DIR__"obj/wuyin_qiang" )->wield();
    carry_object( __DIR__"obj/zhan_pao" )->wear();
    carry_object( __DIR__"obj/zhuying_toukui" )->wear();
    carry_object( __DIR__"obj/lianhuan_jia" )->wear();
    carry_object( __DIR__"obj/yaopai")->wear();
}

