// 汴京 NPC polan.c 收破烂的
#include <ansi.h>
inherit NPC;
void create()
{
    set_name( comm_man_name(), ({ "po lan","lan","po"}) );//*
    set("gender", "男性" );
    set("age",20 + random(20));
    set("title","收破烂的");
    set("class","beggar");
    set("long",@LONG
    一名以拣破烂为生的穷苦老百姓。在京城这样繁华的地方，竟然也有
  许多这样的人。只是现在人们太奢侈了，什么都扔，所以也还活的下去。
LONG);
    set("talk_msg",({
        "看什么看！我有什么好看的？！给大爷滚远点儿！！\n",
        "我是京城的破烂王，别管什么东西，只要碰到就拣。\n",
    }));
    set("chat_chance", 15);
    set("chat_msg",({
        (: random_move :),
    }));
    set("attitude", "friendly");
    setup();

}
void init()
{
       object this;
       this = this_object();
       call_out("get_all",2,this);
}
int get_all(object me)
{
    object *inv,env;
    int i;      
    if( me->is_fighting() ) return 1;
    if( me->is_busy() ) return 1;
    env = environment(me);       
    if( !env ) return 1;
    inv = all_inventory(environment(me)); 
    if ( !sizeof(inv) ) return 1;   
    for( i = 0; i < sizeof( inv ); i++ )
    {   
        if( !inv[i]->is_character() && !inv[i]->query("no_get") )
        {   
            inv[i]->move(me);
            message_vision("$N捡起地上的"+inv[i]->name()+"看了看，满意地收进搭链里\n",me);
            destruct(inv[i]);
        }
    }
    return 1;
}
int random_move()
{
    return ::random_move();
}
    

