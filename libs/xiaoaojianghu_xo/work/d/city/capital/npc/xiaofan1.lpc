// 汴京NPCs:   xiaofan1.c
 
inherit NPC;
inherit F_VENDOR;

#include <ansi.h>
#include "bianjing.h"     

void create()
{
    set_name(comm_man_name(), ({ "xiao fan","fan","waiter"}) );
    set("gender", "男性" );
    set("age",20+ random(10) );
    set_hp("gin", 200);
    set_hp("kee", 400);
    set_hp("sen", 500);
    set("title","街头卖野味的小贩");
    set("attitude", "friendly");
    set("vendor_goods", ([  
        "野狐肉"       : BIANJING_FOOD "yehu_rou",
        "獾肉"         : BIANJING_FOOD "huan_rou",
        "盘兔肉"       : BIANJING_FOOD "panturou",
    ]) );
    set("positive_score", 100);
    set("combat_exp", 1000);
    set("social_exp", 400);
    set_xiuwei_by_type( "short",200 );
    setup();
    carry_object(CLOTH_DIR "mancloth1" )->wear();
    carry_object(BIANJING_FOOD "huan_rou" )->wield();

}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}
void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        message_vision("小贩冲着$N喊道：“客官，尝尝新鲜的野味呀？”\n",ob);
}

