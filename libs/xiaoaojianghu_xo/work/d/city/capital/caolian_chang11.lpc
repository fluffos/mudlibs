// 汴京 caolian_chang11.c
#include <room.h>
#include <ansi.h> 
#include "bianjing.h"
inherit BROOM;
void create()
{
    set("short",YEL "操练场" NOR );
    set("long", @LONG            
好大的一个操练广场，这里是禁军招募士兵，考核军官的地方。每年都有固
定的时间，由军队中的军官在这里招募民间强健年轻的男子参加禁军队伍，或是
设立擂台，让江湖上的武林高手一显丰采，并且接纳或是劝说其中的好手在禁军
中担任各种不同级别的军官，为朝廷效力。
    靠北面当地放着一张桌子，几名军官坐在桌后；身后放着一些器械：木杆、
铁砧、弓箭，还有别的什么。几个年轻的汉子正在参加考试。北面和两边的营房
则是专门用作比武的擂台。
LONG
    );
    set("objects", ([ 
        __DIR__"npc/jinjun_kaoguan1" : 1,
        __DIR__"npc/obj/stone_for_joinarmy" : 1,
    ]));
    //这里有一个军官，对参加考试的人进行登记，给其设定各种初值。
    //并且用来检测是否合格进入军队，然后在营房中进行比武。
    set("exits", ([    
            "south" : __DIR__"caolian_chang10",
        "north" : __DIR__"yingfang17",
        "east"  : __DIR__"yingfang16",
        "west"  : __DIR__"yingfang18",
    ]));
    set("detail",([
    ]));     
    set("outdoors","capital");
    setup();
}

