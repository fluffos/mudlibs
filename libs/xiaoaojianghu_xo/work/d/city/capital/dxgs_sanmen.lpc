inherit BROOM;  
void create()
{
    set("short",RED "三  门" NOR);
    set("long",@LONG
三门乃真宗时修建，供奉佛牙舍利之用。整体用砖砌成，涂以白灰，中开三
门，门上有阁楼一间，高数丈，尽施彩绘，华丽美观。门前有王温塑造的善神一
对，形态可亲，动作自然，堪称一绝。
LONG);
    set("exits",([
        "up"       : __DIR__"dxgs_gelou",
        "south"    : __DIR__"dxgs_dayuan1",
        "east"     : __DIR__"dxgs_donglang3",
        "west"     : __DIR__"dxgs_xilang3",
        "north"    : __DIR__"dxgs_dayuan2",
    ]));
    set("detail",([
    ]));
    set("objects",([
    ]));
    set("outdoors","capital");
    setup();
}
void init()
{
    ::init();
}

