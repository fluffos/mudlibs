#include "bianjing.h"
inherit BROOM;
void create()
{
    set("short",HIR "继照堂" NOR);
    set("long",@LONG
开封府人称南衙，开国以来只有亲王，太子方可为府尹，州牧，谓之“判南
衙”；其他官吏只能以“权知开封府”官之。自真宗以太子任州牧后，正堂被赐
名“继照堂”，正面有“正大光明”金龙墨匾横悬其上，廊外两边立着包拯执开
封府印时用过的铡刀。十数名捕卒分立两侧，肃杀之极。
LONG);
    set("exits",([
        "south" : __DIR__"fuya_pailou",
        "north" : __DIR__"fuya_houtang",
    ]));
    set("objects",([
    ]));
    set("detail",([
    ]));
    setup();
}
