#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "北大街");
        set("long", @LONG
这里是大理的北大街，双人合抱的大树在街边十步一株，整整齐齐，青石铺
就的街面打扫的干干净净，街上行人稀少，气氛肃穆而冷清。因为这里是进出皇
宫的必经之路，又是衙门和兵营所在地，所以不许闲杂人等无事逗留的。西面是
衙门，东面是兵营。北面有座高大的牌坊。
LONG
        );
    set("exits", ([ 
                "south"  : __DIR__"guangchang",
                "north" : "/d/menpai/duanshi/paifang",
                "west"  : __DIR__"yamen",
                "east"  : __DIR__"bingying",
        ]));
        set("objects",([
                __DIR__"npc/daoke" : 1,
                __DIR__"npc/zuihan" : 1,
                ]) );
        set("outdoors","xinan");        
        setup();
        replace_program(ROOM);
}                       


