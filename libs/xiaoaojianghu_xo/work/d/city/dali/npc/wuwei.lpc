// master.c

inherit NPC;
inherit F_MASTER;

#include <ansi.h>

string *drink_msg = ({
    "段无畏慢慢地品味着手中的女儿红，显得非常陶醉。。。。。\n",
    "段无畏叹道：“人生难得几回醉呀。。。”\n",
    "段无畏向你瞥了一眼：“这位朋友，过来喝一杯怎么样？”\n",
    "段无畏拍拍酒保的肩膀：“不错，这酒确实不错。。。”\n",
});

string ask_for_join();

void create()
{
        set_name("段无畏", ({ "duan wuwei", "duan", "wuwei" }) );
    set("title","镇南王府大管事");
        set("gender", "男性");
        set("age", 34);
        set("attitude", "peaceful");
        set("class", "duanshi");
        set("apprentice_available", 10);
        set("long", @LONG
段无畏是大理镇南王府的大管事，三十多岁，以前是王爷的书童,精明能干，主管
王府杂务，兼教家丁们习武，听说手下很有点功夫，家丁们多是他的记名弟子。
当年王爷曾指点过他一二。他经常到太白楼来喝酒。
LONG);
        set("str", 28);
        set("int", 30);
        set("spi", 30);
        set("con", 30);
        set("cps", 30);
        set("cor", 20);

        set("force", 500);
        set("max_force", 500);
        set("force_factor", 5);
    set("max_kee",400);
    set("kee",400);
    set("max_sen",400);
    set("sen",400);

        set("combat_exp", 10000);
        set("score", 2000);

        set("inquiry", ([
                "入府" : (: ask_for_join :),
                "生计" : (: ask_for_join :),
        ]) );
    set_wugong("jiben-qinggong",100);
    set_wugong("unarmed",100);
    set_wugong("duanshi-neigong",100);
    set_wugong("blade",130);       
    set_wugong("kuaige-dao",100);
    set_wugong("zuiliu-dao",100,100,1);
    set_wugong("haofeng-quan",100, 100, 1);
//    set_wugong("taixu-quan",100,100,1);
    set_wugong("tianhong",100);
    set_wugong("shenxing",100,100,1);
    set_xiuwei_by_type("blade",2000);
    set_xiuwei_by_type("unarmed",2000);
    set_xiuwei_by_type("dodge",2000);
    
        
        create_family("镇南王府", 1, "管事");

        setup();
        carry_object(__DIR__"obj/cloth")->wear();
        carry_object(__DIR__"obj/finger")->wear();

}

void init()
{
    object ob;
    ::init();
    if( this_object()->can_act() ) 
    {
        remove_call_out("greeting");
        call_out("greeting", 5, ob);
    }
        add_action("do_yuanyi", "yuanyi");
        add_action("give_quest","quest");
}

string ask_for_join()
{
        object me;

        me = this_player();

        if( (string)me->query("class")=="duanshi" )
                return "跟师傅开什么玩笑！没见我正忙着！我可没空和你逗着玩！\n";
        if( (string)me->query("title") !="普通百姓" )
                return "哈，对不起，咱们镇南王府只收良家百姓做家人! 您请回吧！\n";

        me->set_temp("pending/join_duanshi", 1);
        return "好吧，入了王府要改姓“段”你可愿意(yuanyi)？\n";
}

int do_yuanyi()
{
        string *prename =
         ({ "段" });
        string name, new_name;
    int len;
        if( !this_player()->query_temp("pending/join_duanshi") ) return 0;
        message_vision(
                HIC "$N恭恭敬敬地给段无畏鞠了个躬。\n\n"
                        "$n点点头，对$N说：从今天起，你就是我们段家的人了。\n\n" NOR,
                this_player(), this_object() );
        name = this_player()->query("name"); 
        len = strlen(name);
        new_name = prename[random(sizeof(prename))] + name[2..(len-1)];
        command("say 从今以後你的名字叫做" + new_name + "。");
        command("smile");
        this_player()->delete_temp("pending/join_duanshi");
        this_player()->set("name", new_name);
    this_player()->set("title","镇南王府见习家丁");
    this_player()->set("class","duanshi");
        return 1;
}

void attempt_apprentice(object ob)
{
    if( (int)ob->query("age") < 20 )
    tell_object( ob, "段无畏摇摇头：“你太小了，过两年再学功夫吧。”\n");
        if( query("apprentice_available") ) {
                if( find_call_out("do_recruit") != -1 )
                        command("say 慢著，一个一个来。");
                else
                        call_out("do_recruit", 2, ob);
        } else {
                command("say 本府今天已经收了十个家丁，不想再收人了。");
        }
}

void do_recruit(object ob)
{
        if( (string)ob->query("class") != "duanshi" )
                command("say 我只收咱们王府的人作弟子，好吧，你既然如此诚心，就先入府为奴吧？");
        else
    {
                command("say 好啦！ 从今天起你就是王府正式的家人啦！ 别给咱们王爷丢脸！ 好好干，别偷懒啊！");
                command("recruit " + ob->query("id") );
        }
}

int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) ) 
    {
                add("apprentice_availavble", -1);
            ob->set("class", "duanshi");
        ob->delete("master");
                return 1;
        }
}

int accept_fight(object me)
{
        if( (string)me->query("class")=="duanshi" )
                command("say 你疯啦！ 敢跟师傅叫阵，要弑师造反啊？!");
        else
                command("say 镇南王府的人从来不和外人较量！你请回吧！。");
        
        return 0;
}

void greeting(object ob)
{
    if(!ob || environment(ob)!=environment() ) return;
    if( can_act()
        && environment(this_object())->query("short") == "太白楼")
    {            
        tell_object(ob,drink_msg[random(sizeof(drink_msg))] );
        call_out("greeting",20,ob);
    }
}                           


