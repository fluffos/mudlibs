inherit ITEM;
void create()
{
        set_name("野鸡", ({ "ye ji" }));
        set_weight(1500);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "只");
                set("long","一只风干的野鸡，可以用来作出美味的鸡羹\n");
                set("value", 300);
        }
}

