inherit HEALER;
void create()
{
        set_name("段志德", ({ "duan zhide","duan","zhide", "healer" }) );
        set("title", "药铺老板" );
        set("gender", "男性" );
        set("age", 40);
        set_hp("gin", 500);
        set_hp("kee", 700);
        set_hp("sen", 700);
        set_wugong("haofeng-quan", 70 );
        set_wugong("tianhong", 70 );
        set_xiuwei_by_type("unarmed", 1000 );
        set_xiuwei_by_type("dodge", 1000 );
        set("combat_exp",50000);
        set("long","段志德保养的很好，精神矍铄，看起来很精明。\n");
        set("attitude", "friendly");
        setup();
        carry_object( CLOTH_DIR "cloth1")->wear();
        add_money("silver", random(5));
}
