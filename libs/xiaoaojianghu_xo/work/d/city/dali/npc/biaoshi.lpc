
inherit NPC;

void create()
{
    set_name("大镖师",({"biao shi", "shi" }) );
    set("title","青龙镖局");
    set("gender", "男性" );
    set("age", 32);
    set("long", "这是一位体态轻盈的趟子手。\n");
    set("combat_exp", 50000);
    set_xiuwei_by_type("unarmed",400);
    set("attitude", "friendly");
        set_wugong("unarmed",100);
        set_wugong("jiben-qinggong",100,100,1);
    set_xiuwei_by_type("dodge",400);
    set("max_force",1000);
    set("force",1000);
    set("force_factor",30);
    set("max_kee",600);
    set("max_gin",500);

    set("chat_chance", 5);
    set("chat_msg", ({
        (: random_move :),
    }) );
        
        setup();
        add_money("coin",30);
        carry_object( __DIR__"obj/cloth" )->wear();
        carry_object( CLONE_DIR"bianfa" );
}


