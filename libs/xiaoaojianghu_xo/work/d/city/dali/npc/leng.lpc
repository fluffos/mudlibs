// beggar.c

inherit NPC;

int ask_me();
void create()
{
    set_name("乞丐", ({ "qi gai" }) );
    set("gender", "男性" );
    set("age", 23);
    set("long", "一个满脸油污的中年乞丐。\n");
    set("combat_exp", 100);
    set("str", 27);
    set("force", 200);
    set("max_force", 200);
    set("force_factor", 2);
    set("inquiry",([
        "冷锋" :  (: ask_me :),
        "无量" :  "不知道。。。。我从来不知道什么无量。。。。",
    ]) );
    setup();
    set("chat_chance", 10);
    set("chat_msg", ({
        (: random_move :)
    }) );
    carry_object(__DIR__"obj/cloth")->wear();
}

int accept_object(object me, object obj)
{
    command("smile");
        command("chat 多谢这位" + RANK_D->query_respect(me) +"了，
                江湖风波险恶，您这几天可要注意了呀。。。\n");
    command("say 多谢这位" + RANK_D->query_respect(me) + 
"，您好心一定会有好报的！");
    return 1;
}

int accept_fight(object me)
{
    command("say " + RANK_D->query_respect(me) + 
"饶命！小的这就离开！\n");
    return 0;
}
 
int ask_me()
{
    object me;
    me = this_player();
    message_vision("那乞丐神色突然变得极为慌乱：“你...是无量派的？”\n"
        "忽地那乞丐又恶狠狠地说：“知道老子是冷锋又怎么样？\n"
        "老子这就把你们杀了，看还有没有人知道我叫冷锋！”\n"
        ,me);
    set_name("冷锋",({"leng feng","feng"}) );
    set("title","无量派叛徒");
    set("class","swordsman");
    set_wugong("lingxiao-shou",100,100,1);
    set_wugong("yanxing", 100, 100, 1);
    set_xiuwei_by_type("unarmed",300);
    set_xiuwei_by_type("dodge", 400);
    set("force_factor",30);
    set("max_force",1000);
    set("force",1000);
    set("max_kee",300);
    set("eff_kee",300);
    set("kee",300);
    kill_ob(me);
    me->fight_ob(this_object());
    return 1;
}

