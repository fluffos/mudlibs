#include <ansi.h>
inherit NPC;
void create()
{
    set_name("衙役", ({ "ya yi", "ya" }));
    set("age", 34);
    set("title","");
    set("gender", "男性");
    set("long", "大理城的一名衙役。\n");
    set("str",40);
        
    set("combat_exp", 80000);
        set_wugong("yuanyang-dao", 40,40,1);
        set_wugong("jiben-qinggong", 40, 40, 1);
    set_xiuwei_by_type("blade",100);
    set_xiuwei_by_type("dodge", 100);
    set("chat_chance_combat", 10);
    set("chat_msg_combat", ({
        "衙役喝道：大胆!\n",
    }));
    set("chat_chance",10);
    set("chat_msg",({
        "衙役问道：“你有什么事？”\n",
        "衙役喝道：“衙门重地，没事别老站在这儿!”\n",
    }));
    setup();
    carry_object(__DIR__"obj/blade1")->wield();
    carry_object(__DIR__"obj/yayi_fu")->wear();
    carry_object(__DIR__"obj/wuyun_xue")->wear();
}

void init()
{
    object ob;
    ::init();
    if( interactive(ob = this_player()) && !this_object()->can_act() ) 
    {
        remove_call_out("greeting");
        call_out("greeting", 1, ob);
    }
}

void greeting(object ob)
{
    if( !ob || environment(ob) != environment() ) return;
    say("衙役看了你一眼，说：有什么事吗？\n");
}
int accept_fight(object me)
{
    command("say 我看你今天是活得不耐烦了,"+ RANK_D->query_rude(me)+",去死吧！\n");
    say(RED "只听得衙役一声大喝:'杀死他!'\n" NOR);
    message_vision(RED "只见大门里冲出来很多捕快，个个持刀向$N砍下，登时将$N砍翻在地!!\n" NOR,me);
    me->unconcious();
    return 1;
}

