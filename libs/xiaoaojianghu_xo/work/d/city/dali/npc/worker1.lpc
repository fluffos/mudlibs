// worker1.c

inherit NPC;

void create()
{
    set_name("茶工", ({ "cha gong", "worker" }) );
    set("gender", "女性" );
    set("age", 32);
    set("long", "茶工正在忙碌地烘烤茶叶。\n");
    set("combat_exp", 500);
    set("attitude", "friendly");
    set_wugong("unarmed",30);
    set_xiuwei("unarmed",50);
        setup();
        add_money("coin", 15);
        carry_object(CLONE_DIR + "wear/cloth/cloth2")->wear();
}


