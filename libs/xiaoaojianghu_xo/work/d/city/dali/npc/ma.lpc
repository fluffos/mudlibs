inherit NPC;

void create() {
  set_name("马五德", ({ "ma wude", "ma" }));
  set("title", "大理武师");
  set("trainer", 1);
  set("gender", "男性");
  set("age", 52);
  set("long", "   马五德少年时就生得异常魁梧，早年曾在少林寺当了很多年的\n"
    "   俗家弟子，后来又得高人相授；刀法和铁砂掌功夫都是相当了\n"
    "   得。\n");
  set_wugong("unarmed", 40, 40, 1);
  set_xiuwei("unarmed", 600);
  set_xiuwei("dodge", 600);
  set_xiuwei_by_type("sword", 600);
  set_xiuwei_by_type("blade", 600);
  set_wugong("blade", 40, 40, 0);
  set_wugong("jiben-qinggong", 40, 40, 0);
  set_wugong("sword", 40, 40, 0);
  set("chat_chance", 5);
  set("chat_msg", ({
    (: random_move :),
  }));
  set("max_force", 2000);
  set("force", 2000);
  set("force_factor", 100);
  set("combat_exp", 2000000);

  setup();


  carry_object(__DIR__ "obj/cloth5")->wear();
  carry_object(CLONE_DIR + "book/bianfa");

}

void init() {
  object ob;

  ::init();

  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment() != environment(ob))
    return;

  if (!living(ob) || ob->is_fighting())
    return;

  if (ob->query("age") > 14)
    return;

  if (ob->query("family"))
    return;

  message_vision("$N爽朗地对$n说：" + RANK_D->query_respect(ob) + "，"
    "我看你身体单薄，不\n如就跟我学点防身的功夫吧。\n",
    this_object(), ob);
}

int accept_object(object who, object ob) {
  say("马五德爽朗地笑道：“这位" + RANK_D->query_respect(who) +
    "岂不是太小瞧我马五德了？”\n");
  if (ob->value() >= 100000) {
    message_vision("马五德对$N说：“这样吧，我先把礼金收下，等你学有所成\n"
      "后，再送给你，就当作你闯荡江湖的盘缠吧。”\n", who);
    who->set_marks("apprentice_of_ma", 1);
    return 1;
  } else if (ob->value() >= 10000) {
    message_vision("马五德缓缓地对$N说：“没事，你暂且跟我学，礼金的事，\n"
      "以后再说。”\n", who);
    who->set_temp_marks("apprentice_of_ma", 1);
    return 1;
  }
  return notify_fail("马五德叹了口气：“我怎么能收你的钱呢？你还是拿回去吧。”\n");
}

int valid_teach(object ob) {
  if (ob->query_marks("apprentice_of_ma") ||
    ob->query_temp_marks("apprentice_of_ma") ||
    ob->query("age") < 15)
    return 1;
  else return 0;
}
