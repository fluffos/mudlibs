#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "王府大院");
        set("long", @LONG
这里是镇南王府的大院，当面一堵宽阔的白玉照壁，上书“忠心报国”四个
大字，落款是当今大理皇帝段正明，一色的青砖铺地，有几个仆役正在院中洒扫，
北面是王府大厅，东面是帐房，南面是个小院。东北和西北各有一条走廊。
LONG
        );
    set("exits", ([ 
                "northwest" : __DIR__"xilang",    
                "northeast" : __DIR__"donglang",    
                "south"  : __DIR__"xiaoyuan",
                "north"  : __DIR__"dating",
                "west"  : __DIR__"wangfu_pailou",
                "east"  : __DIR__"zhangfang",
        ]));
        
        setup();
        replace_program(ROOM);
}                       


