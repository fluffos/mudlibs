#include <room.h>

inherit ROOM;

void create() {
  set("short", "药铺");
  set("long", @LONG
这是一间大药铺，你一进来，一阵药味扑鼻而来。这里看上去各种药品都非
常齐全，不管是跌打损伤还是体病虚弱，在这都可已找到良药。西边这家药铺的
老板正在为病人看病，另一位专门抓药的药铺伙计正忙得不可开交，房间的东侧
有个小门，可能里面是放药的地方，但平时是关上的，北面直通东街。
LONG
  );
  set("exits", ([
    "north": __DIR__ "dongjie",
  ]));
  set("objects", ([
    __DIR__ "npc/healer": 1,
    __DIR__ "npc/huoji1": 1,
  ]));
  setup();
  replace_program(ROOM);
}
