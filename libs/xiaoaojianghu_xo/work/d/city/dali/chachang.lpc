// chachang.c

#include <room.h>

inherit ROOM;

string look_sign();

void create()
{
        set("short", "鼎泰茶场");
        set("long", @LONG
这里便是鼎泰茶庄焙制茶叶的地方，一进来就有一股浓郁的茶香扑鼻而来，令人心
神俱畅。茶场里有很多的茶工，都在一声不响地在干活，一边有人在仔细地挑选好的生
茶，另一边，又有人在慢慢地揉制，在茶场的一角，放了许多几个大竹箩，里面装满了
刚从茶园里采回来的茶叶和焙制好了的茶叶，还有不少搬运工等着把作好的茶叶搬到茶
庄里去。 
LONG
        );

        set("exits", ([
                "east"          : __DIR__"dingtai",
        ]) );

        set("objects", ([
                __DIR__"npc/worker1" :  3,
                __DIR__"npc/worker2" :  2,
                __DIR__"npc/guanshi" :  1,
        ]) );

        create_door("east", "木雕门", "west", DOOR_CLOSED);

        setup();

}
