#include <room.h>
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "王府边门");
  set("long", @LONG
这里是王府边门，供家丁丫鬟们出入之用，平时王府所需之生活用品也由此
运入，这当儿两个王府卫士正没精打采的在聊天，出门是一条小巷，几乎没有人
经过。门边是两棵大树，地上的落叶被风吹过发出沙沙的声音，你感觉有点冷。
LONG
  );
  set("exits", ([
    "north": __DIR__ "chaiyuan",
    //            "south" : __DIR__"xiaoxiang",
    "northeast": __DIR__ "wuchang",
  ]));

  setup();
  replace_program(ROOM);
}
