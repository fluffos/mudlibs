#include <room.h>
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "王府牌楼");
  set("long", @LONG
这里是镇南王府前的一座牌楼，高达二丈，由黄玉制成，和西北面皇宫屋顶
的琉璃瓦在阳光的照耀下黄白掩映，金碧辉煌，令人目为之眩，感觉分外巍峨庄
严。你抬头望去，但见牌楼上四个大金字“镇南王府”。东面就是王府大院了！
西面是是一条幽静的大街。
LONG
  );
  set("exits", ([
    "west": __DIR__ "wangfu_jie",
    "east": __DIR__ "wangfu_dayuan",
  ]));
  set("objects", ([
    __DIR__ "npc/shiwei~": 4,
  ]));
  set("blocks", ([
    "east": "shi wei",
  ]));
  set("block_msg", "王府侍卫恭声说：实在抱歉，王爷近日有恙，无法见客，请回吧。\n");

  setup();
  replace_program(ROOM);
}
