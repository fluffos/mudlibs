#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "小巷");
        set("long", @LONG
这里是王府小院东南面的一条小巷，青石地，夹壁墙，光线幽暗，四通八达
西面通向厨房，东面通向王府卫士的驻地，东南传来兵器交接的声音。西北就是
王府小院。
LONG
        );
    set("exits", ([ 
            "southeast" : __DIR__"wuchang",
                "west"  : __DIR__"chufang",
                "northwest"  : __DIR__"xiaoyuan",
                "east"  : __DIR__"weishi_ying",
        ]));
        
        setup();
        replace_program(ROOM);
}                       


