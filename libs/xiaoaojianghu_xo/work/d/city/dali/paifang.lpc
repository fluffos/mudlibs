#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "皇宫牌坊");
        set("long", @LONG
这里是大理皇宫前的一座牌坊，高达三丈，由汉白玉制成，和北面皇宫屋顶
的琉璃瓦在阳光的照耀下黄白掩映，金碧辉煌，令人目为之眩，感觉分外巍峨庄
严。你抬头望去，但见牌坊上四个大金字“圣道广慈”。北面就是大理皇宫了！
东面是是一条幽静的大街。
LONG
        );
    set("exits", ([ 
                "south"  : __DIR__"beijie",
                "north"  : __DIR__"shengci_gong",
                "east"  : __DIR__"wangfu_jie",
        ]));
        
        setup();
        replace_program(ROOM);
}                       


