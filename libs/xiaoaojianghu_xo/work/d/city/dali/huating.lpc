#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "花厅");
        set("long", @LONG
这是一座漂亮的木制建筑，顶上是八檐飞角，挂着镏金的风铃，微风拂过发
出悦耳的声音。居中是张石制的圆桌，几个石凳环绕周围。镇南王爷时常在这里
招待贵客，赏花饮酒，赋诗作对。听说连皇上也很喜欢这里呢
LONG
        );
    set("exits", ([ 
                "out"  : __DIR__"huayuan",
        ]));
        
        setup();
        replace_program(ROOM);
}                       


