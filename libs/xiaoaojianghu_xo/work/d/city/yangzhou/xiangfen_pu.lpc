inherit ROOM;
#include <ansi.h>

void create()
{
    set("short", YEL"戴记香粉铺"NOR);
    set("long",@LONG
「天下香料，莫如扬州」，这里便是扬州香粉铺子中最好的一家「戴春林」
香粉铺。一进入铺子，一种混杂的香气扑鼻而来。铺子边上摆着几面镜子，中间
是一红木柜台。几个年轻女子正在试用粉饼胭脂，另有几个老妈子正在和伙计商
量着什么。随着你进来，一个伙计缓缓的站起身来。
LONG
    );
    set("no_kill", "yangzhou");
    set("no_clean_up", 0);

    set("exits",([
        "west" : __DIR__"dashi_jie",
    ]));
    set("objects", ([
        __DIR__"npc/dai_chunlin" : 1,
    ]));
    setup();
    replace_program(ROOM);
}