// waiter.cr.c
#include <ansi.h>

inherit NPC;
inherit F_VENDOR;
void create()
{
    set_name( YEL "沈万福" NOR, 
        ({ "shen wanfu","shen","wanfu","seller","boss" }) );
    set("gender", "男性" );
    set("title", "沈家白衣铺老板");
    set("age", 45);
    set("long", @LONG
沈万福是一个白胖子，脸上总是笑呵呵的，象一尊弥勒佛。看他的样子
不象是个买卖人，然而如果你仔细看看他那双眯缝的笑眼，就会发现里
面同样闪动着一丝狡黠的光芒。他就是这家白衣铺的老板。
LONG
    );
    set("talk_msg",({
        "这里就是扬州城啦，您家没有来过么？",
        "啊，这位客官，听您的口音是……北方……南方……西边……到底是哪儿的人啊？",
        "客官，咱这白衣，哎，没的说，您找不到比这更好的啦，来一件吧，啊？",
        "客官，您瞧瞧，这件白衣您穿上多精神哪！人靠衣服马靠鞍嘛，您说是不是这个理儿？",
            
    }));
    set("inquiry", ([
        "白衣" : "要买白衣，您到我这儿就找对地方了，绝对没错！",
        "here"   : "吓，这儿可不就是扬州城嘛。",
        ]) );
    set("attitude", "friendly");
    set("rank_info/respect", "老哥");
    set("rank_info/rude","老王八蛋");
    set("vendor_goods", ([
        "白缎衫"            : CLOTH_DIR "baiduan_shan",
        "白苎丝袍"          : CLOTH_DIR "baizhu_sipao",     
        "湖蓝衲袄"          : CLOTH_DIR "hulan_naao",       
        "麻布宽衫"          : CLOTH_DIR "mabu_kuanshan",  
        "纱布直缀"          : CLOTH_DIR "shabu_zhizhui",    
        "直缝宽衫"          : CLOTH_DIR "zhifeng_kuanshan",
        "嫩绿绸衫"          : CLOTH_DIR "nenlv_choushan", 
        "淡黄纱衣"          : CLOTH_DIR "danhuang_shayi",
        "银红红衫子"        : CLOTH_DIR "yinhong_shanzi",
        "桃花撒花袄"        : CLOTH_DIR "sahua_ao",
    ]) );
    set("positive_score",10);
    set("no_kill", "yangzhou");
    set("combat_exp",100);
    set("social_exp",100);
    set_xiuwei_by_type("unarmed",50);
    setup();
    carry_object( CLOTH_DIR "baiduan_shan")->wear();
}

void init()
{
    object ob = this_player();
    ::init();
    if( this_object()->can_act() ) 
    {
        remove_call_out("greeting");
        call_out("greeting", 1, ob);
    }
    add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
    if( !ob || environment(ob) != environment() ) return;
    message_vision("沈老板笑呵呵的说道：“客官，您瞧瞧咱家的白衣怎么样？”\n",ob);

}