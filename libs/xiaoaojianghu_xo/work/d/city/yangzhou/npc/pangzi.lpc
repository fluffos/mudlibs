inherit RENHE;
void create() {
  set_name("周胖子", ({ "zhou pangzi", "pangzi", "zhou", "fat" }));
  set("title", "仁和车行管事");
  set("gender", "男性");
  set("age", 35);
  set_hp("gin", 500);
  set_hp("kee", 700);
  set_hp("sen", 700);
  set_wugong("haofeng-quan", 70);
  set_wugong("tianhong", 70);
  set_xiuwei_by_type("unarmed", 1000);
  set_xiuwei_by_type("dodge", 1000);
  set("combat_exp", 50000);
  set("long", "周胖子长得油光满面，两只绿豆般的眼睛令人生厌，不过平时\n"
    "作买卖还算规矩。\n");
  set("attitude", "friendly");
  setup();
  carry_object(CLOTH_DIR "cloth1")->wear();
  add_money("silver", random(5));
}
