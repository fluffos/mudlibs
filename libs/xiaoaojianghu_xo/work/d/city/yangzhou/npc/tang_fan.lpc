//by lnwm /d/city/yangzhou/npc/tang_fan.c

#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

void create()
{
    set_name("卖糖小贩" , ({ "tang fan", "fan" }) );
    set("gender", "男性" );
    set("age",20);
    set("combat_exp", 15000);
    set_jibie("unarmed",50);
    set_lingwu("unarmed",50);
    enable_skill("unarmed");
    set("attitude", "friendly");
    set("vendor_goods", ([
            "冰糖"      :   __DIR__ "obj/bing_t",
            "水晶糖"    :   __DIR__ "obj/shui_t",
                        "鸳鸯糖"    :   __DIR__ "obj/yuan_t",
                    "灶糖"      :   __DIR__ "obj/zao_t",
    ]) );
    setup();
    carry_object( CLOTH_DIR "cloth1")->wear();
}

void init()
{
    object ob;
    ::init();
    if( interactive(ob = this_player()) && !is_fighting() ) {
            remove_call_out("greeting");
            call_out("greeting", 1, ob);
    }
    add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
        message_vision("卖糖的小贩冲$P吆喝着：家里有喜事吗？买点糖果招待朋友吧。\n",ob);
    return;
}
                  