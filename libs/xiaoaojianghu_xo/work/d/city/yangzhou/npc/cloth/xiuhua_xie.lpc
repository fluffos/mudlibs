#include <armor.h>

inherit BOOTS;

void create()
{
        set_name("绣花鞋", ({"xiuhua xie", "xie", "shoes"}));
        set_weight(1000);
        if ( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "双");
                set("value", 500);
                set("material", "silk");
                set("armor_prop/armor", 1);
                set("femaly_only", 1);
        }
        setup();
}


