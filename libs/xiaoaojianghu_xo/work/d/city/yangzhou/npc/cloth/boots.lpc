#include <armor.h>

inherit BOOTS;

void create()
{
        set_name("", ({"", "xie", "shoes"}));
        set_weight(1000);
        if ( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "");
                set("unit", "˫");
                set("value", 500);
                set("material", "silk");
                set("armor_prop/armor", 1);
        }
        setup();
}

