//sengxie.c 僧鞋
//by trill 04/07/97

#include <armor.h>

inherit BOOTS;

void create()
{
        set_name("僧鞋", ({"seng xie", "xie", "shoes"}));
        set_weight(1000);
        if ( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一双方头的黑布鞋，多为和尚行者所穿。\n");
                set("unit", "双");
                set("value", -100);
                set("cant_sell", "这是庙产，小的收了会有罪过的。\n");
                set("material", "cloth");
                set("armor_prop/armor", 1);
        }
        setup();
}
