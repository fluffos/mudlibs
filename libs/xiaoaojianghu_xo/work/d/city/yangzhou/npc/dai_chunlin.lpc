//Npc dai_chunlin.c 戴春林

#include <ansi.h>

inherit NPC;

void create()
{   
        set_name(YEL "戴春林" NOR, ({ "dai chunlin", "dai", "chunlin"}) );
    set("gender", "男性");
    set("title", "戴记香粉铺老板");
    set("age", 42);
    set("long", @LONG
他是扬州城里戴记香粉铺的老板，五短身材，肥肥胖胖，但看上去甚是威
严，另人不敢亲近。
LONG
        );
    set("attitude", "peaceful");

    set("str", 17);
    set("int", 30);
    set("spi", 30);
    set("con", 30);
    set("cps", 30);
    set("cor", 20);

    set("combat_exp", 50000);
    set("score", 1000);

    set("inquiry", ([
    ]) );


    setup();

}
