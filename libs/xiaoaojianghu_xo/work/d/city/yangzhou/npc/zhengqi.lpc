// cha_boshi.c
// by trill 

#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

void create()
{
        set_name(YEL "郑戚" NOR, ({ "zheng qi","waiter"}) );
        set("title", "茶博士");
        set("gender", "男性" );
        set("age", 36);
        set("long",
           "郑戚手拎个大茶壶，站在柜台边上，正在沏一壶茶。\n"
        );
        set("combat_exp", 8000);
        set_wugong("unarmed", 20,20,1);
        set_temp("apply/attack", 20);
        set_temp("apply/attack", 30);
        set("chat_chance_combat", 10);
        set("chat_msg_combat",({
"郑戚一边躲一边说：“你敢在扬州城里杀人放火了？，不要命了？！！”\n",
"郑戚恶狠狠的对你骂到：“你可知道衙门里的秦捕头可是我表妹的姨夫的\n""
外甥，敢对我动手，吃了熊心豹子胆了？”\n",
"“还不滚开，我要使出绝技了！！！”郑戚边挡边骂。\n",
        }) );
        set("attitude", "friendly");
        set("rank_info/respect", "郑博士");
    set("vendor_goods", ([
        "富春茶" : LIQUID_DIR "fuchun",
        "龙井茶" : LIQUID_DIR "longjing",
        "魁尖茶" : LIQUID_DIR "kuijian",
    ]));
        setup();
        carry_object(__DIR__"obj/baishan")->wear();
        carry_object(__DIR__"obj/sixie")->wear();
}

void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        say( "郑戚说：这位" + RANK_D->query_respect(ob)
                + "，您想喝茶还是吃点心？\n");
}
