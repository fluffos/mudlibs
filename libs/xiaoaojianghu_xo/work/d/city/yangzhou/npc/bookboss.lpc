inherit NPC;
inherit F_VENDOR;
void create()
{
        set_name("辛友清", ({ "xin youqing","xin" }) );
        set("title","书局老板");
        set("gender", "男性" );
        set("age", 38);
        set("long", "辛友清一看就是个读书人，他功名未就，但卖书贩画为生，也颇为自得。
\n");
        set("attitude","friendly");
        set("inquiry",([
               "书" : "我这里什么书都有，你想买什么？\n",
               "here" : "这是我花了三百两银子买来的店铺。\n",  
        ]));
        set("vendor_goods",([
              "百家姓" : __DIR__"obj/baijia_xing",
              "太公辩" : __DIR__"obj/taigong",
              "说剑" : __DIR__"obj/jibenjianshu.lpc",
              "拳法入门" : __DIR__"obj/jibenquanfa.lpc",
              "提纵术" : __DIR__"obj/qinggong", 
              "格斗大全" : __DIR__"obj/quanfa",
              "说文解字" : __DIR__"obj/shuowen",
              "乡书" : __DIR__"obj/xiangshu",
              "说律" : __DIR__"obj/shuolv",
              "刀术" : __DIR__"obj/daoshu",
              "基本刀法" : __DIR__"obj/daofa.lpc",  
              "三字经" : __DIR__"obj/sanzi_jing",
        ]));
        set("chat_chance", 15);
        set("chat_msg",(
         {
            "老板手里拿着一把鸡毛掸子，轻轻掸去墙上，书架上的尘土。\n",
            "老板笑着问道：'买书？还是看看字画儿？'\n",
         }));
     
        setup();
      
        carry_object(__DIR__"obj/cloth5")->wear();
}
void init()
{
        ::init();
        add_action("do_vendor_list","list");
}          
