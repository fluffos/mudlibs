// waiter.cr.c
#include <ansi.h>

inherit NPC;
inherit F_VENDOR;
void create()
{
    set_name( YEL "彭宝现" NOR, 
                ({ "peng baoxian","peng","baoxian","seller","boss" }) );
    set("gender", "男性" );
    set("title", "彭记鲜果店老板");
    set("age", 49);
    set("long", @LONG
彭老板的这家彭记鲜果店在扬州城也是颇有名气，来采买果品的顾客很
多，一致于人手总是很紧张，这不，连老板都亲自上阵了。老彭一边给
一个顾客算帐，一边回答另外一个顾客的问讯，还不时回头对伙计吩咐
些什么。
LONG
    );
    set("talk_msg",({
        "怎么样？客官，不来二斤桃子尝尝么？",
        "来啊客官，这西瓜不甜不要钱！",
        "您等等，我这儿忙完了就过来。",
        "瞧一瞧罢，客官，连知府老爷家的果品都是小店供应的。",
    }));
    set("inquiry", ([
        "鲜果" : "啊，是啊是啊，小店各种鲜果应有尽有，看看吧！",
        "here"   : "咦！您家看了，「彭记鲜果店」这大招牌不是明摆着的么？",
        ]) );
    set("attitude", "friendly");
    set("rank_info/respect", "老哥");
    set("rank_info/rude","老王八蛋");
    set("vendor_goods", ([
        "香蕉"       : FRUIT_DIR "banana",      
        "菠萝"       : FRUIT_DIR "boluo",       
        "草莓"       : FRUIT_DIR "caomei",      
        "甘蔗"       : FRUIT_DIR "ganzhe",      
        "哈蜜瓜"     : FRUIT_DIR "hamigua",     
        "橘子"       : FRUIT_DIR "juzi",    
        "柠檬"       : FRUIT_DIR "lemon",       
        "李子"       : FRUIT_DIR "lizi",    
        "枇杷"       : FRUIT_DIR "pipa",    
        "葡萄"       : FRUIT_DIR "putao",       
        "石榴"       : FRUIT_DIR "shiliu",      
        "桃子"       : FRUIT_DIR "taozi",       
        "香瓜"       : FRUIT_DIR "xianggua",    
        "西瓜"       : FRUIT_DIR "xigua",       
        "杏子"       : FRUIT_DIR "xingzi",      
        "鸭梨"       : FRUIT_DIR "yali",   
        "杨梅"       : FRUIT_DIR "yangmei",     
        "樱桃"       : FRUIT_DIR "yingtao",     
    ]) );
    set("positive_score",10);
    set("no_kill", "yangzhou");
    set("combat_exp",100);
    set("social_exp",100);
    set_xiuwei_by_type("unarmed",50);
    setup();
    carry_object( CLOTH_DIR "cloth4")->wear();
}
void init()
{
    object ob = this_player();
    ::init();
    if( this_object()->can_act() )
    {
        remove_call_out("greeting");
        call_out("greeting", 1, ob);
    }
    add_action("do_vendor_list", "list");
}
void greeting(object ob)
{
    if( !ob || environment(ob) != environment() ) return;
    message_vision("彭老板大声吆喝道：“时新鲜果，样样都有，价钱公道，童叟无欺！”\n",ob);
}
