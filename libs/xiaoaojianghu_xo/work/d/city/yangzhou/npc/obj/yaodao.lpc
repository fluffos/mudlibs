#include <weapon.h>
#include <ansi.h>

inherit BLADE;

void create()
{
        set_name("腰刀", ({ "yao dao", "blade"}) );
        set_weight(2500);
        set("long","一把腰刀，重约四五斤，上有「扬州官府」的字样。\n");
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("value", 500);
                set("material", "iron");
                set("family", "yangzhou");
        }
        init_blade(15);
        set("wield_msg", "$N「唰」的一声抽出一把$n握在手中。\n");
        set("unwield_msg", "$N将手中的$n插入腰间。\n");
        setup();
}