// dodge.c
inherit ITEM;
void create()
{
    set_name("闪躲之术", ({ "dodge book", "shu", "book" }));
    set_weight(300);
        if( clonep() )
                set_default_object(__FILE__);
        else {
        set("unit","本");
        set("long","这是一本普普通通的研究闪躲之术的书籍。\n");
        set("value", 20);
        set("material", "paper");
       set("skill", ([
                "name"             : "dodge",
                "xiuwei_required"  : 100,
                "literate_required": 5,
                "gin_cost"         : 10+random(10),
                "max_jibie"        : 70,
                "bonus_jilei"      : 0,
                "bonus_xiuwei"     : 2,
                "max_xiuwei"       : 700,
                "bonus_combat_exp" : 5,
                "max_combat_exp"   : 1000,
                "bonus_social_exp" : 0,
                "max_social_exp"   : 0,
                ]) );
        }
}