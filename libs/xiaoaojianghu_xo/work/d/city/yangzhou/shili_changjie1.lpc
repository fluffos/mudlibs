#include <ansi.h>
inherit ROOM;

void create()
{
    set("short", YEL"十里长街"NOR);
    set("long", @LONG
这里就是张佑诗中写的「十里长街市井连，月明桥上望神仙」的十里长街。
长街宽达三十丈，青砖铺地，东边一道泄水沟。街中心种有槐树，分行人以左右
而行。西边是官河，岸边相间种有绿柳碧桃，倒影水面，摇曳风中。东边临街的
屋子有些还挂有招牌，但却门窗紧闭，听说已搬去新城。
LONG
    );
    set("no_clean_up", 0);
    set("no_kill", "yangzhou");
    set("outdoors", "yangzhou");
    set("objects", ([
        __DIR__"npc/xunbu" : 1,
    ]));
    set("exits", ([ /* sizeof() == 3 */
        "east" : __DIR__"keyu",
        "north" : __DIR__"shili_changjie2",
        "south" : __DIR__"nanmen_dajie",
    ]));

    setup();
    replace_program(ROOM);
}

