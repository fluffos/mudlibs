// Room: /d/city/yangzhou/jiulou.c

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", YEL "小秦淮酒楼" NOR);
  set("long", @LONG
一座二层木阁楼临河而建，二楼的飞檐上悬一匾额「小秦淮酒楼」。楼内北
头有一柜台，一个帐房先生站在柜台后面。小二肩搭白布巾，正在店内招呼客人。
酒楼中间摆着几张木桌，几个客人正在吃酒。西边有一楼梯，据说是扬州的冶春
诗社就在二楼。
LONG
  );
  set("no_clean_up", 0);
  set("no_kill", "yangzhou");
  set("detail", ([]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/xiaoer2.lpc": 1,
  ]));
  set("exits", ([ /* sizeof() == 3 */
    "up": __DIR__ "jiulou2",
    "west": __DIR__ "shili_changjie3",
    "south": __DIR__ "ganquan_jie",
  ]));

  setup();
}

int valid_leave(object me, string dir) {
  object ob;

  if (dir == "up" && objectp(ob = present("xiao er", environment(me)))
    && living(ob)) {
    message_vision("店小二拦住了$N说道：我家店主说了，没有请帖的一律不能上二楼。\n", me);
    return notify_fail("你被店小二拦住了去路。\n");
  }
  return ::valid_leave(me, dir);
}
