#include <ansi.h>
inherit ROOM;
void create()
{
    set("short",YEL"门庭"NOR);
    set("long",@LONG
门庭北向，是一座高大的磨砖门楼，门楣上方嵌有「小玲珑山馆」四字砖额。
门内与穿廊相接，游廊逶迤北去，廊尽而门。
LONG
    );
    set("no_kill", "yangzhou");
    set("no_clean_up", 0);
    set("refuse_npc", 1);
    set("objects", ([
        __DIR__"npc/jiading" : 2,
    ]));
    set("exits",([ /* sizeof() ==  */
        "north" : __DIR__"chuanlang",
        "east" : __DIR__"nan_xiaojie",
    ]));
    setup();
}
int valid_leave(object me, string dir)
{
    object ob;
    if ( dir == "north" && !me->query_temp("enter_yang") 
        && objectp( ob = present ( "jia ding", environment( me )  ) )
        && living(ob) )
    {
        message_vision("家丁对$N说道：未经老爷邀请，你不能进去。\n", me);
        return notify_fail("你被家丁拦住了去路。\n");
    }
    return ::valid_leave(me, dir);
}