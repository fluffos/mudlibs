#include <ansi.h>
inherit ROOM;
void create()
{
    set("short", YEL"小秦淮客寓"NOR);
    set("long", @LONG
这里是小秦淮客寓，过往扬州的客商大多在此歇脚。客寓内摆设简单，边上一个柜台，柜台后有一个帐房先生正在拨着算盘珠子，一边还拿枝笔记着什么。
一个店小二看到你的到来，笑吟吟的迎上前来。边上的楼梯前挂着个告示。
LONG
    );
    set("no_kill", "yangzhou");
    set("exits", ([ /* sizeof() == 2 */
        "west" : __DIR__"shili_changjie1",
        "north" : __DIR__"ganquan_jie",
    ]));
    set("objects", ([ /* sizeof() == 1 */
       __DIR__"npc/popo.lpc" : 1,
       __DIR__"npc/xiaoer1.lpc" : 1,
    ]));
    if( random(10) > 7 )
        add("objects", ([
                MISC_DIR"killer" : 1,
                ]) );

    set("no_clean_up", 0);
    setup();
    call_other( CLONE_DIR + "board/yangzhou_b", "???" );
    replace_program(ROOM);
}