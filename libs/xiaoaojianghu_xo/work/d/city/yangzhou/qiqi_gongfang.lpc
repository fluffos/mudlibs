// Room: /d/city/yangzhou/qiqi_gongfang.c

inherit ROOM;
#include <ansi.h>

void create() {
  set("short", YEL "江氏漆器工坊" NOR);
  set("long", @LONG
这里是名噪扬州的漆工艺人江千里的作坊。江千里制作的漆器器皿，异常精
致，形神俱美。扬州人莫不以有一套江千里的漆器器皿为傲，扬州城里「杯盘处
处江秋水」。作坊内几个客人正和江千里商量些什么，边上的一个帐房模样的人
执笔记着。对于你的进来，似乎没人在意。
LONG
  );
  set("no_clean_up", 0);
  set("no_kill", "yangzhou");
  set("objects", ([
    __DIR__ "npc/jiang_qianli": 1,
  ]));
  set("exits", ([
    "north": __DIR__ "dashi_jie",
  ]));

  setup();
  replace_program(ROOM);
}
