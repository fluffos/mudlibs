// Room: /d/city/yangzhou/tongsi_men.c

inherit ROOM;
#include "men.h"
#include <ansi.h>
void create()
{
    set("short", YEL"通泗门"NOR);
    set("long", @LONG
通泗门是扬州的西门，青砖砌成。城门前沿着城墙，在护城河边种着扬柳，
因而扬州被称为「绿柳城郭」。几个士兵站在城门口，检查着过往行人车辆。城
门口贴着几张榜文，几个泼皮在围观。此门进出的人员车马较连接驿道的南北门
少，因此显得较为悠闲，城门口的众人显得有些懒散。
LONG
    );
    set("no_clean_up", 0);
    set("outdoors", "yangzhou");
    set("bangwen", "yangzhou");
    set("no_kill", "yangzhou");
    set("detail", ([
        "榜文" : (: look_bangwen :),
    ]));
    set("objects", ([
        __DIR__"npc/xiaowei" : 1,
        __DIR__"npc/shibing2" : 1,
        __DIR__"npc/shibing1" : 1,
        __DIR__"npc/run_yu" : 1,
    ]));
    set("exits", ([ /* sizeof() == 2 */
        "east" : __DIR__"tongsi_jie",
        "west" : __DIR__"renhe",
    ]));

    setup();
}

int valid_leave(object me, string dir)
{
    if ( me->query("no_leave_yangzhou") && dir == "west" )
    {
        write("你现在不能离开扬州。\n");
        return 0;
    }
    return ::valid_leave(me, dir);
}


