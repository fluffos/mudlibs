#include <ansi.h>
inherit ROOM;

void create()
{
    set("short",YEL"开明桥"NOR);
    set("long",@LONG
拾级而上，步上开明桥头。桥两侧围以石栏，每块石栏板雕刻着四时花木，
雕刻精致，神形俱美。正处河心的石栏镶着一匾额「开明桥」。开明桥据说是扬
州城里最古老的桥，能在五代战火之幸存下来，扬州的老人对开明桥多有感慨。
下了东边的石阶，就是北门大街；西边是北小街，通向府学「资政书院」。
LONG
    );
    set("exits",([ /* sizeof() ==  */
        "east" : __DIR__"beimen_dajie",
        "west" : __DIR__"bei_xiaojie",
    ]));

    set("outdoors", "yangzhou");
    set("no_kill", "yangzhou");
    setup();
    replace_program(ROOM);
}
