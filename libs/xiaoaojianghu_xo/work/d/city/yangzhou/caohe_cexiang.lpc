//草河侧巷 caohe_cexiang.c

#include <ansi.h>

inherit ROOM;

void create()
{
    set("short", YEL"小草河侧巷"NOR);
    set("long", @LONG
傍依官河的草河小街上的一处普普通通的巷子，也是这里的居民区的一部分。
向东穿过草河小街就是官河了，西南通向繁华热闹的通泗街，从那里向西就是通泗
门－扬州的西门。这里虽小，却热热闹闹，两侧有许多店铺，另有许多小贩沿街摆
摊，吆喝着自己的生意。
LONG
    );
    set("outdoors", "yangzhou");
    set("no_clean_up", 0);
    set("no_kill", "yangzhou");
        set("objects", ([
        __DIR__ "npc/tang_fan" : 1,
        ]) );
    set("exits", ([ /* sizeof() == 3 */
        "west" : __DIR__ "yu_dian",
        "northwest"     :        __DIR__ "tongsi_jie",
                "southeast"     :        __DIR__"nan_xiaojie",
    ]));

    setup();
}
