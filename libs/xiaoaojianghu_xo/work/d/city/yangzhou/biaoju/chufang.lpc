#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", "厨房");
  set("long", @LONG
东边是个大灶台，几个厨娘在忙活着。中间是放着一张桌子，摆着几张长条
凳，一些镖局弟子正坐在那里填饱肚子。看那饭菜，真不知道那几个弟子是如何
下咽的，不知镖局从哪里找来的厨娘，估计不会是扬州人，找到这么几个宝贝也
真是不容易。
LONG
  );
  set("no_clean_up", 0);
  set("exits", ([
    "west": __DIR__ "tianjing"
  ]));
  set("objects", ([]));
  set("no_kill", "penglai");
  setup();
}

void init() {
  add_action("do_zuo", "zuo");
}

int do_zuo() {
  object me = this_player();
  message_vision("$N一屁股坐了下去，大喊一声：上菜！\n", me);
  if (me->query("zuzhi/zuzhi_name") != "凤翔镖局") {
    message_vision("过了好一伙儿，也没人搭理$N，$N讪讪的站了起来。\n", me);
    return 1;
  } else {
    message_vision("一个厨娘给$N送上一些吃的，$N开始吃喝起来。\n", me);
    me->start_busy(3);
    remove_call_out("eating");
    call_out("eating", 3, me);
    return 1;
  }
}

int eating(object me) {
  message_vision("$N吃饱喝足，站了起来。\n", me);
  me->set("food", (int)me->max_food_capacity());
  me->set("water", (int)me->max_water_capacity());
}
