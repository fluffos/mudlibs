inherit NPC;
#include "biaoju_master.h"

void create()
{
    set_name("张镖师", ({"zhang biaoshi", "zhang", "biaoshi"}) );
//    set("title", "凤翔镖局");
    create_zuzhi( "凤翔镖局", 3, "镖师" );
    set("long", @LONG
这是凤翔镖局的一个镖师，在镖局干了十几年了，江湖阅历很丰富。
LONG
    );
    set("str", 21);
    set("con", 22);
    set("age", 30);
    set( "combat_exp", 5000 );
    set( "social_exp", 2000 );
    
    set_wugong( "jiben-quanfa", 80, 80, 1 );
    set_wugong( "changquan", 70, 70, 1 );
    set_wugong( "jiben-qinggong", 70, 70, 1 );
    set_wugong( "xingyun-shenfa", 60, 60, 1 );
    set_wugong( "penglai-xinfa", 50, 50, 1 );
    set_xiuwei_by_type( "unarmed", 300 );
    set_xiuwei_by_type( "dodge", 300 );

    setup();
    carry_object(CLOTH_DIR "cloth6")->wear();
}

