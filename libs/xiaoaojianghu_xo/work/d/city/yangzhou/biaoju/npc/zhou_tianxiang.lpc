inherit NPC;
inherit F_MASTER;

void create()
{
    set_name("周天翔", ({"zhou tianxiang", "zhou"}) );
    set("title","凤翔镖局局主");
    set("nickname", "剑掌双绝");
    set("long", @LONG
周天翔身材消瘦，红光满面，看上去颇有些仙风道骨。据说周
天翔原是山东蓬莱派的高徒，一手八仙剑使的出神入化，一手
创下凤翔镖局。
LONG
    );
    set("gender", "男性");
    set("str", 21);
    set("con", 22);
    set("per", 22);
    set("int", 27);
    set("kar", 25);
    set("dex", 26);

    set("age", 61);
    set( "combat_exp", 500000 );
    set( "social_exp", 500000 );


    set_wugong( "jiben-quanfa", 100, 100, 0 );
    set_wugong( "penglai-xinfa", 120, 120, 1 );
    set_wugong( "feiying-zhang", 100, 100, 0 );
    set_wugong( "baxian-zhang", 100, 100, 1);
    set_wugong( "jiben-jianfa", 100, 100, 0 );
    set_wugong( "chuiliu-jianfa", 100, 100, 0 );
    set_wugong( "fengxiang-jianfa", 100, 100, 0);
    set_wugong( "baxian-jian", 100, 100, 1);
    set_wugong( "jiben-qinggong", 100, 100, 0 );
    set_wugong( "xingyun-shenfa", 100, 100, 0 );
    set_wugong( "chusuifeng", 100, 100, 0 );
    set_wugong( "baxian-shenfa", 100, 100, 1);

    set_xiuwei_by_type("unarmed", 1100);
    set_xiuwei_by_type("sword", 1100);
    set_xiuwei_by_type("dodge", 1100);
    
    set("talk_msg", ({
        "老夫现在正忙着呢，你别打扰我了。\n",
    }));
    create_family( "蓬莱派", 16, "掌门人" );
    setup();
    carry_object(CLOTH_DIR "heibu_yi")->wear();
    carry_object(BOOTS_DIR "sifeng_kuanxue")->wear();
}
void init()
{
    ::init();
    add_action("give_quest","quest");
}

void should_follow( object ob )
{
    command( "follow " + ob->query( "id" ) );
}

int attempt_apprentice(object me)
{
    object this;
    mapping family;
    this = this_object();
    if ( me != this->query_temp( "can_recruit" ) )
    {
        write( "周天翔说道：拜师入我镖局之事去找我的徒弟去吧。\n" );
        return 0;
    }
    command( "look " + me->query( "id" ) );
    message_vision("周天翔高兴对$N笑了笑，说：很好很好。\n", me);
    message_vision("\n$n决定收$N为弟子。\n\n"
        "$N跪了下来向$N恭恭敬敬地磕了三个响头，叫道：「师父！」\n",
         me, this);
    recruit_apprentice( me );
    family = me->query("family");
    tell_object( me,
            sprintf("恭喜您成为%s的第%s代弟子。\n\n", family["family_name"],
            chinese_number(family["generation"]) ));
    me->set("class","swordsman");
    delete_temp( "can_recruit" );
    remove_call_out( "zhou_back1" );
    call_out( "zhou_back1", 3 );
    return 1;
}

void zhou_back1()
{
    command( "say 老夫先回去了。\n" );
    command( "go southwest");
    remove_call_out( "invite_master2" );
    call_out( "zhou_back2", 1 );
}

void zhou_back2()
{
    command( "go south");
}
