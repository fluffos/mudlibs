#include <room.h>

inherit ROOM;

void create()
{
        set("short", "铜驼街");
        set("long", @LONG
铜驼街是洛阳城南的主要街道，是洛阳城最热闹的地方。宽阔的街道青石铺
成，所以人和车马走在上面，并未尘土飞扬。无论是从那里来的旅客都能被这里
的热闹非凡的气氛所感染，感觉到中原大都市的繁华。向西是洛阳城的西市，那
里有钱庄和当铺，东边是一个大的宅院。
LONG
        );
        set("exits", ([ 
            "west"    : __DIR__"xishi",
            "south"   : __DIR__"changxia_men",
            "east"    : __DIR__"zhaiyuan_damen",             
            "north"   : __DIR__"tongtuo_jie1",
        ]));
        set("objects", ([
            __DIR__"npc/xiaofan": 1,   
            __DIR__"npc/youke": 2 
        ])); 
        set("outdoors","luoyang");
        setup();
        replace_program(ROOM);
}                       

