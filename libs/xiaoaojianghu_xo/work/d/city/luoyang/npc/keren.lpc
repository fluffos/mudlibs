//NPC:/d/city/luoyang/npc/keren 饭馆客人 edit by Happyman Mar.25.97
inherit NPC;
void create()
{
        set_name("客人", ({ "ke ren","ren" }) );
        set("gender", "男性" );
        set("age", 30);
        set("long", "这是一位来这儿用餐的客人。\n"
           );
        set("attitude","friendly");
        set("combat_exp",3000+random(1000));
        set_wugong("unarmed",30,30,1);
        setup();
        carry_object(__DIR__"obj/cloth3")->wear();
        add_money("silver",2);
}

