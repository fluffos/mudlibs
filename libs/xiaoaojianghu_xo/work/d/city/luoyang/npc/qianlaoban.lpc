//NPC:/d/city/luoyang/npc/qianlaoban edit by Happyman Mar.25.97
inherit NPC;
void create()
{
        set_name("钱老板", ({ "qian","laoban" }) );
        set("title","钱庄老板");
        set("gender", "男性" );
        set("age", 45);
        set("long",
"钱老板是这里的老板，他把钱庄经营得很好，洛阳城里的人都到这里来存钱。\n"
           );
        set("attitude","friendly");
        set("combat_exp",20000);
        set_wugong("unarmed",45,45,1);
        setup();
        carry_object(__DIR__"obj/cloth5")->wear();
        add_money("gold",1);
}

