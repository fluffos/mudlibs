//NPC:/d/city/luoyang/npc edit by Happyman Mar.25.97
inherit NPC;
//inherit F_DEALER;
void create()
{
        set_name("杨恒", ({ "dian dang","dang" }) );
        set("title","典当");
        set("gender", "男性" );
        set("age", 35);
        set("long", "杨恒是这里的典当，面无表情的打着算盘，嘴里念念有词。\n"
           );
        set("attitude","friendly");
        set("max_force", 500);
        set("force",500);
        set("force_factor",10);
        set("combat_exp",20000);
        set_wugong("unarmed",40,40,1);
        setup();
        carry_object(__DIR__"obj/cloth4")->wear();
      
}        
