//NPC:/d/city/luoyang/npc/jinxiangke edit by Happyman Mar.25.97
inherit NPC;
void create()
{
        set_name("进香客", ({ "jinxiang ke","ke" }) );
        set("gender", "男性" );
        set("age", 30+random(10));
        set("long", "这是一位来进香的人，一脸虔诚的表情。\n"
            );
        set("combat_exp",1000+random(200));
        set_wugong("unarmed",20,20,1);
        set("attitude","friendly");
        setup();
        carry_object(__DIR__"obj/cloth2")->wear();
}

