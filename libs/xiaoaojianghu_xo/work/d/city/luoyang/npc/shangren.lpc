//NPC:/d/city/luoyang/npc/shangren edit by Happyman Mar.25.97
inherit NPC;
void create()
{
        set_name("西域商人", ({ "shang ren","ren" }) );
        set("gender", "男性" );
        set("age", 30+random(5));
        set("long", "这是一位从西域来的商人，金发碧眼，说着生硬的汉文。\n");
        set("attitude","friendly");
        set("combat_exp",10000+random(1000));
        set_wugong("blade",40,40,1);
        setup();
        carry_object(__DIR__"obj/cloth1")->wear();
        carry_object(__DIR__"obj/blade1")->wield();
        add_money("silver",5);
}

