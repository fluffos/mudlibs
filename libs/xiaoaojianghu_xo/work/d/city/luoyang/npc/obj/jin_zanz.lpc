#include <armor.h>
inherit HEAD;
void create()
{
        set_name("金簪子", ({ "zan zi", }) );
        set_weight(30);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "这是一件用黄金打成的首饰。\n");
                set("unit", "根");
                set("value", 12000);
                set("material", "iron");
                set("armor_prop/armor", 1);
                set("armor_prop/personality", 4);
                set("female_only", 1);
        }
        setup();
}

