#include <room.h>
inherit ROOM;
void create() {
  set("short", "安喜门");
  set("long", @LONG
这里是洛阳城的北门，是洛阳的主要城门。城门洞上方写着三个大字“安喜
门”城门两侧贴着官府的告示，门口的官兵盘查着过往的行人。南来北往的行人
很多，磨肩擦踵。向北是一条通往城外的青石官道。向南就走进热闹的洛阳城。
LONG
  );
  set("exits", ([
    "north": __DIR__ "guandao",
    "south": __DIR__ "beishi",
  ]));
  set("outdoors", "luoyang");
  set("objects", ([
    __DIR__ "npc/wujiang": 1,
    __DIR__ "npc/guanbing": 2
  ]));

  setup();
  replace_program(ROOM);
}
