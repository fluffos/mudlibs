#include <room.h>

inherit ROOM;

void create()
{
        set("short", "放生池");
        set("long", @LONG
佛教本着“众生平等”的慈护之心，提倡不杀生。特意在此设置了放生池，
池塘周围杨柳夹道，两座小小的石桥通往池中的小岛。小岛上有一座朱红栏杆的
凉亭，亭中有块石碑，上面刻着“放生池”三个大字，池中的鱼儿逍遥的游动。
LONG
        );
        set("exits", ([ 
                "south" : __DIR__"daxiong_baodian",
        ]));
        set("objects",([
             __DIR__"npc/youke": 2  
        ]));
        set("outdoors","luoyang"); 
        setup();
        replace_program(ROOM);
}                       

