//伏牛的南厢房 lala changed on Jan. 20, 1998
//amber原来的那个文件xiangf2.c被保存为xiangf2.c.amber.1998.01.20
#include <room.h>
inherit ROOM;

void create()
{
    set("short","南厢房");
  set("long",@LONG
这是一间专门供上府求助的江湖侠客们小住的客房。来这里的人，有的是缺
钱，有的是躲仇人；对于这些人，只要没有大恶，伏牛派一律予以热情款待。东
墙下有一张方桌，两把椅子；床头上一张高几，茶具，香炉一一齐备。屋里打扫
得干干净净。
LONG);
  set("exits",([
    "north" : __DIR__"dating",
  ]));
  set("objects",([
        __DIR__"npc/lv" : 1,
  ]));
    set("sleep_room", "inn");
    set("need_clean","伏牛派");
     create_door("north","木门","south",DOOR_CLOSED);
  setup();
}
void init()
{
        add_action("do_sleep","sleep");
}

int do_sleep()
{
        object me;
    me=this_player();
    if( !me->can_act() ) 
        return 0;
        if ( !me->query_temp("lin_marks/暂住"))
        {
            tell_object( me, "这里不是让你睡的地方。\n");
            return 1;
        }
        return 0;
}

