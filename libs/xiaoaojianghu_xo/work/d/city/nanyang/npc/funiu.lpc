#include <ansi.h>
inherit NPC;

void init()
{
    object who = this_player();
    call_out("do_greeting",1,who);
}

void do_greeting(object who)
{
    if( !who || environment(who) != environment(this_object()) )
        return 0;
    if ( !this_object()->can_act() ) return 0;
    if( who->query_condition("kill_funiu") )
    {
        message_vision("只见"+this_object()->query("name")+
"对着$N大喝一声:'大胆狂徒!!竟然欺负到我伏牛派的头上来了!!\n"
"今天一定不能让$N跑了!!!\n",who);
        if( who->query("family/family_name") == "伏牛派" )
        {
            message_vision(this_object()->query("name")+"悲愤地看着$N:'你竟然杀害自己的同门??!!\n",who);
            who->set("class_score/伏牛派",-100);
        }
        kill_ob(who);
        who->fight_ob(this_object());
        this_object()->set("bellicosity",600);
        this_object()->set("env/attack",100);
    }
}
void setup()
{
    ::setup();
    set("family/master_name","柯百岁");
    set("family/master_id","master ke");
}


