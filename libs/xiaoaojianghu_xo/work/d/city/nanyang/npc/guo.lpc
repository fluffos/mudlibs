// guo.c

inherit __DIR__ "funiu";
inherit F_MASTER;

#include <ansi.h>
mixed help_me(object me);

void create() {
  set_name("过彦之", ({ "guo yanzhi", "guo" }));
  set("gender", "男性");
  set("age", 34);
  set("str", 30);
  set("cor", 30);
  set("cps", 30);
  set("int", 25);
  set("ker", 24);
  set("kar", 30);
  set("dex", 30);
  set("talk_limit", ([
    "marks/lin/伏牛百胜": 0,
  ]));
  set("talk_msg", ({
    "百胜鞭法是我派的镇派绝技，若非深得掌门人的赞许，是没有机会学到的，就是学了，\n"
    "也不许随便传给别人。\n",
    "要想学习百胜鞭法，就要先作些给我伏牛派光大门户的事情呀！\n",
  }));
  set("max_force", 1500);
  set("force", 1500);
  set("force_factor", 30);
  set("inquiry", ([
    "暂住": (: help_me :),
    "住": (: help_me :),
    "帮助": (: help_me :),
    "help": (: help_me :),
  ]));
  set("class_score/伏牛派", 1200);
  create_family("伏牛派", 2, "大弟子");
  set("no_kill", "funiu");
  set("combat_exp", 40000);
  set("social_exp", 20000);
  set("positive_score", 5000);
  set_wugong("whip", 100, 100, 0);
  set_wugong("kuangf-bian", 110, 100);
  set_wugong("baisheng-bian", 70, 60, 1);
  set_xiuwei_by_type("whip", 500);
  set_wugong("unarmed", 100, 100);
  set_wugong("taizu-quan", 120, 120, 1);
  set_xiuwei_by_type("unarmed", 400);
  set_wugong("qinggong", 100, 100);
  set_wugong("xingyun-shenfa", 100, 90, 1);
  set_xiuwei_by_type("dodge", 350);
  set_wugong("ke-xinfa", 100, 100, 1);
  setup();
  carry_object(__DIR__ "obj/qlwhip")->wield();
  carry_object(CLOTH_DIR "cloth5")->wear();
}
void init() {
  ::init();
  add_action("give_quest", "quest");
}

mixed help_me(object me) {
  me = this_player();

  if (me->query("family/family_name") == "伏牛派") {
    if (random(3) == 1)
      me->add("class_score", -1);
    return ("过彦之气鼓鼓地说道：“这就是你的家了，倒什么乱！?”");
  }
  if (me->query_temp("lin_marks/暂住")) {
    command("haha " + me->query("id"));
    return ("“阁下不是已经住下了么？莫非阁下的头脑出了什么问题？”");
  }
  if (!me->query("family/family_name")) {
    if (me->query("age") > 15)
      return (
        "“看你也老大不小的了，却还是什么也不会，这辈子还是别进练武这一行了吧！！”");
    else
      return (
        "“小孩子懂得什么，还是先拜入我伏牛派吧。”");
  }
  if (me->query("pks") > 10)
    return (
      "“阁下身上的人命官司太多了，敝派薄土陋地，恐怕接纳不了。”");

  message_vision("过彦之冲着$N笑了笑，说道：“既然阁下瞧得起柯府，我们自当尽力相待。\n", me);
  me->set_temp("lin_marks/暂住", 1);
  write("过彦之同意你在柯府暂住了。\n");
  return 1;
}

int valid_teach(object who, string skill) {
  if (skill == "baisheng-bian")
    return notify_fail("过彦之说：“这门功夫是本门的不传之密，虽是本派弟子，也不是都能学的。\n"
      "你去向师傅请教吧，看他老人家愿不愿意教给你。”\n");
  if (who->query("family/family_name") == "伏牛派" && this_object()->query_jibie(skill))
    return 1;
  return ::valid_teach(who, skill);
}
