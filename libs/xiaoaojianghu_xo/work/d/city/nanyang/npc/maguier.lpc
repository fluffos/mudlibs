//maguier.c
#include <ansi.h>

inherit NPC;

void create() {
  set_name("马龟儿", ({ "ma gui er", "ma" }));
  set("gender", "男性");
  set("title", GRN "青松寨" NOR + "头领");
  set("str", 40);
  set("age", 33);
  set_wugong("taizu-quan", 80, 80, 1);
  set("max_force", 200);
  set("force", 200);
  set("force_factor", 20);
  set("max_kee", 500);
  set_xiuwei_by_type("unarmed", 250);
  set_wugong("qimei-gun", 60, 60, 1);
  set_xiuwei_by_type("long", 250);
  set("attitude", "aggressive");
  set("combat_exp", 8500);

  setup();
  carry_object(__DIR__ "obj/cloth1")->wear();
  carry_object(LONG_DIR "qimei_gun")->wield();
}
