#include <ansi.h>
#include <weapon.h>

inherit WHIP;

void create()
{
    set_name( "软鞭", ({ "ruan bian","whip" }) );
    set_weight(500);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("long","一条四尺来长的鞭子，是伏牛派专用的类型。\n");
        set("unit", "条");
        set("value", 30);
        set("cant_sell","这好象是武林中人使用的鞭子吧，小店可不敢收咧！.\n");  
        set("material", "skin");
    }
    init_whip(25);

    set("wield_msg", "$N从腰间解下一条$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n束在腰间。\n");

    setup();
}


