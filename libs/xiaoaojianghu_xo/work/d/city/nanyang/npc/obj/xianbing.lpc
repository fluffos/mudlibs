// xianbing for eat.
inherit ITEM;
inherit F_FOOD;
void create()
{
        set_name("馅饼", ({"xian bing","bing"}));
        set_weight(250);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一张厚厚的馅饼，不知是什么馅儿的。\n");
                set("unit", "张");
                set("value", 5);//很便宜，（基本食物都应该很便宜）.
                set("food_remaining",5 );
                set("food_supply",40);//正常饭量的人一顿吃二斤。
        }
}

