// liang.c

#include <ansi.h>

inherit NPC;

void create()
{
    set_name("吕七", ({ "lv qi","lv" }) );
    set("gender", "男性" );
    set("title","剑客");
    set("age", 35);
    set_wugong("xueying-jian",120,120,1);
    set_xiuwei("sword",1200);
    set("combat_exp", 40000);
    set("social_exp", 20000);
    setup();
    carry_object(SWORD_DIR"sword1")->wield();
    carry_object(CLOTH_DIR"cloth1")->wear();
}

void init()
{
    object ob;
    if ( interactive(ob = this_player()) && !is_fighting() )
    {
        remove_call_out("greeting");
        call_out("greeting", 1, ob);
    }
}

void greeting(object ob)
{
    if ( !ob || environment(ob) != environment() ) return;
    command("look "+ob->query("id"));
}

