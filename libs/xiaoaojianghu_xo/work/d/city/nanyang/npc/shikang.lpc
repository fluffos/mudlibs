//shikang.c
#include <ansi.h>

inherit NPC;

void create()
{
    set_name("施康", ({ "shi kang","shi" }) );
    set("gender", "男性" );
    set("title",GRN"青松寨"RED"寨主"NOR);
    set("str",40);
    set("age", 40);
    set("max_force",500);
    set("force",500);
    set("force_factor",50);
    set("max_sen",600);
    set_wugong("taizu-quan",80,80,1);
    set_wugong("tiesha-zhang",100,70,1);
    set_xiuwei_by_type("unarmed",600);
    set("attitude","aggressive");
    set("combat_exp", 18500);

    setup();
    carry_object(__DIR__"obj/cloth1")->wear();
}

