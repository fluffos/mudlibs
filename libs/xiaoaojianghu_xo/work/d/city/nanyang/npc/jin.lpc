//caiyao.c
#include <ansi.h>

inherit NPC;
inherit F_VENDOR;
void create() {
  set_name("金堂辉", ({ "jin tang hui", "jin" }));
  set("gender", "男性");
  set("age", 35);
  set("title", "游方道人");
  set("long", "一名到处游荡，采药练气的游方道人，身上穿得破破烂烂的。\n");
  set("class", "taoist");
  set("max_kee", 800);
  set("max_sen", 700);
  set_xiuwei_by_type("unarmed", 250);
  set_xiuwei_by_type("sword", 150);
  set_wugong("wuliang-jian", 40, 40, 1);
  set_wugong("yanxing", 40, 40, 1);
  set_xiuwei_by_type("dodge", 180);
  set("combat_exp", 1500);
  set("vendor_goods", ([
    "甘草": __DIR__ "obj/gancao",
    "虎骨": __DIR__ "obj/hugu",
    "党参": __DIR__ "obj/dangshen",
    "银耳": __DIR__ "obj/yiner",
    "人参": __DIR__ "obj/shanshen",
  ]));
  setup();
  carry_object(__DIR__ "obj/cloth1")->wear();
  carry_object(SWORD_DIR "sword")->wield();
  carry_object(__DIR__ "obj/shanshen");
  carry_object(__DIR__ "obj/yiner");
  carry_object(__DIR__ "obj/hugu");
  carry_object(__DIR__ "obj/yaowo");
}
void init() {
  ::init();
  add_action("do_vendor_list", "list");
}
