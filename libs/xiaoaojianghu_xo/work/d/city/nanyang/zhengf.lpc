#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
  set("short", "正房" );
  set("long",@LONG
正房五间，青砖黑瓦，红柱粉墙，看起来不象是一般人家盖得起的；地下两
边各立着一盏戳灯，正中供桌桑放着香案，供果，墙上挂着一幅英姿飒爽的侠客
随像，纸已发黄。两边黑木高桌上摆着一对二尺来高的秘色柴窑弧瓶，地下一溜
两列椅子，直排到门口。
LONG);
  set("exits",([
    "south" : __DIR__"tianjing",
    "east"  : __DIR__"woshi",
  ]));
   create_door("east","榆木红漆门","west",DOOR_CLOSED);
  setup();
}

