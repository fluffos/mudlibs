inherit ROOM;
void create() {
  set("short", "大街");
  set("long", @LONG
南阳城自古是关，洛通荆，襄的必经之路。城虽不大，却很整洁，且民风淳
朴。街东有一家大院，红漆大门甚是威武。左首旗斗上悬一面杏黄大旗，上书“
神鞭无敌”，随风飘动。大门两边的灯笼上写着“柯府”二字。街西边是一家商
号。
LONG);
  set("exits", ([
    "north": __DIR__ "beimen",
    "south": __DIR__ "dajie2",
    "east": __DIR__ "qianyuan",
    "west": __DIR__ "shop",
  ]));
  set("objects", ([
    __DIR__ "npc/jiading": 2,
  ]));
  set("outdoors", "nanyang");
  setup();
}
int valid_leave(object me, string dir) {
  if (!objectp(present("jia ding", environment(me))))
    return 1;
  if (dir != "east")
    return 1;
  if (me->query("family/family_name") == "伏牛派") {
    message_vision(
      "家丁向$N道：你回来啦? 快进去歇歇吧。\n", me);
    return 1;
  }
  /*       else{
            if( me->query("age") > 15)
            {

                   message_vision(
"家丁对$N喝道：“这里是柯府大宅，你想乱闯吗？”\n",me);
                   return notify_fail("家丁挡住了你的去路。\n");
             }
          }
*/
  return 1;
}
