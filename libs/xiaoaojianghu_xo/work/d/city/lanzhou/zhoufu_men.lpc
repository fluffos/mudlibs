//  Changed by Lala, 1998-03-20

inherit ROOM;

void create()
{
    set( "short", "州府大门" );
    set( "long", @LONG
这里是兰州府府衙。三间青瓦兽头大门，门前蹲着两个大石狮子, 三间兽头
大门, 正门之上有一匾, 匾上大书“兰州州衙”四个大字。大门两边是一带高高
的砖墙。两个披甲带盔的士兵手持长矛分立在大门口，两侧廊下有诉状用的皮鼓
(gu)，铜锣(luo)。 门前空场上一个人也没有。因为当年征讨西夏的统帅李宪奏
请神宗皇帝在这里建立了帅府，因此人们俗称之为“将军府”。台阶前立着一块
石板，上面贴有告示(gao shi)。
LONG
    );
    set( "outdoors", "lanzhou" );
    set( "item_desc", ([
        "皮鼓"      :   "这是用来告状用的，每当有冤的百姓要申冤时，"
                        + "就来敲鼓，或是敲锣。\n",
        "gu"        :   "这是用来告状用的，每当有冤的百姓要申冤时，"
                        + "就来敲鼓，或是敲锣。\n",
        "铜锣"      :   "这是用来告状用的，每当有冤的百姓要申冤时，"
                        + "就来敲鼓，或是敲锣。\n",
        "luo"       :   "这是用来告状用的，每当有冤的百姓要申冤时，"
                        + "就来敲鼓，或是敲锣。\n",
        "告示"      :   "告示上写着：“缉拿逃犯，举报立赏；公正廉洁，"
                        + "不徇私情。”\n",
        "gao shi"   :   "告示上写着：“缉拿逃犯，举报立赏；公正廉洁，"
                        + "不徇私情。”\n",
        "gaoshi"    :   "告示上写着：“缉拿逃犯，举报立赏；公正廉洁，"
                        + "不徇私情。”\n",
    ]) );
    set( "exits", ([
        "west"      :   __DIR__"dongchang", //东广场
        "northwest" :   __DIR__"bingying_men",          //兵营大门
        "southwest" :   __DIR__"majiu",     //马厩
    ]) );

    setup();
    call_other( CLONE_DIR + "board/lanzhou_b", "???" );
}

void init()
{
    add_action( "do_qiao", 
        ({ "qiao", "knock" }) );            //敲鼓（锣）的动作函数。
}

int do_qiao( string arg )                   //敲鼓（锣）的动作函数。
{                                           //arg：敲的对象。
    object npc, here = this_object();
    object ppl = this_player();
       
    if ( arg == "gu" 
        || arg == "luo" )
    {
        message_vision( "$N走到廊下，拿起小锤敲了几下。\n"
            + "衙役走了出来，问道：“什么事？”\n", ppl );
        if ( !present( "ya yi", here ) )
        {
           npc = new( __DIR__"npc/yayi" );
           npc->move( here );
        }
        return 1;
    }
    return notify_fail("你要敲什么?\n");
}

