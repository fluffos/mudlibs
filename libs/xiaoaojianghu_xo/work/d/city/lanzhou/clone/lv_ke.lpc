inherit NPC;
void create()
{
    set_name("旅客", ({ "lu ke","ke"}) );
    set("combat_exp", 600+random(800));
    set("long","一名长途跋涉来到此地的旅客，脸上颇有风尘劳顿之态。\n");
    setup();
    if(random(2) == 1){
    carry_object(__DIR__"obj/cloth1")->wear();
    }
    else{ carry_object(__DIR__"obj/cloth3")->wear();}
    if(random(2) == 1){
    carry_object("/clone/money/silver");}
}

