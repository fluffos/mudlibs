#include <ansi.h>
#include <armor.h>

inherit HEAD;

void create()
{
    set_name( YEL"金簪子"NOR, ({ "jin zanzi", "zanzi", "jinzanzi" }) );
    set_weight( 15 );                       //三钱；
    if ( clonep() )
        set_default_object( __FILE__ );
    else 
    {
        set( "long", "这是一件用黄金打成的首饰。\n" );
        set( "unit", "根" );
        set( "value", 3300 );               //价格：(1*100)防御力价格
                                            //+(200*15)黄金价格
                                            //+(4*50)附加价格=3300总价格；
        set( "material", "gold" );          //质地：黄金（单价
                                            //２００，０００文／千克）
        set( "armor_prop/armor", 1 );       //防御力：+1；
        set( "armor_prop/personality", 4 ); //附加值：容貌：+4；
        set( "female_only", 1 );            //女性专用。
    }

    setup();
}

