//  金创药  /clone/medicine/jinchuang_yao.c
//  By lin
//  Changed by lala, 1998-03-16

inherit ITEM;

void create()
{
    set_name( "金创药", 
        ({ "jinchuang yao", "yao", "jinchuangyao", "medicine" }) );
    if ( clonep() )
        set_default_object( __FILE__ );
    else 
    {
        set( "unit", "包" );
        set( "long", "这是一包武林人士必备的金创药。\n" );
        set( "value", 600 );
    }
    setup();
}

void init()
{
    add_action( "do_use", "use" );          //使用金创药的动作函数。
}

int do_use( string arg )                    //使用金创药的动作函数。
{                                           //arg：药名。
    object ppl = this_player();
    if ( !id( arg ) ) 
        return notify_fail( "你要用什么？\n" );
    if ( ppl->query_condition( "jin-chuangyao" ) )
        return notify_fail( "你已经敷上金创药了。\n" );
    if ( ppl->query("eff_kee") == ppl->query("max_kee") )
        return notify_fail( "你现在不需要用金创药。\n" );
    message_vision( "$N把一包金创药敷在自己的伤口上。\n", ppl );
    if ( ppl->query( "usetime" ) >3)
        destruct( this_object() );
    else
    {
        ppl->add( "usetime", 1 );
        ppl->apply_condition( "jin-chuangyao", 8 );
    }
    return 1;
}

