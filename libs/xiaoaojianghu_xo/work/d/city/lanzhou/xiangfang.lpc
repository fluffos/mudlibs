#include <room.h>
inherit ROOM;
void create()
{
    set("short","厢房");
    set("long",@LONG
这里是镖局的仓库，存放着尚未送出的货物和镖局的财物，家当。平时是不
许人进来的。地上积了一层灰尘，几只箱子放在墙角。
LONG);
    set("exits",([
          "east" : __DIR__"dayuan",
    ]));
    set("objects",([
          __DIR__"obj/box3" : 1,
          __DIR__"obj/box2" : 1,
          __DIR__"obj/box4" : 1,
          __DIR__"obj/box1" : 1
    ]));
    create_door("east","门","west",DOOR_CLOSED);
    setup();
}

