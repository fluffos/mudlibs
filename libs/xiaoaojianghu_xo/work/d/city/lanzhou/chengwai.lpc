//  By lin
//  Changed by Lala, 1998-03-12

inherit ROOM; 

#include <localtime.h>

void create()
{
    set( "short", "兰州城外" );
    set( "long", @LONG
南面就是兰州城了。兰州城是西北边陲的著名古城，地处熙州以北、秦州西
北，是大宋西拒吐蕃北抗西夏的军事、交通重镇，这里连结着丝绸古道与关中平
原，又是中原和西域之间重要的商业中心。许多的商人聚集在城里歇脚，行商。
    放眼望去，北面的黄河如一条巨龙蜿蜒而过，河对岸是一片荒野。南面，兰
州高大的城池被连绵的山峦三面包围着。一队商旅正在向城里走去。
LONG
    );
    set( "outdoors", "lanzhou" );
    set( "exits", ([
        "south"     :   __DIR__"beimen",    //兰州北门
        "north"     :   "/d/map/xibei/jincheng_guan",   //西北金城关
    ]) );
    set( "objects", ([
        __DIR__"npc/trader"     :   2       //商人
    ]) );
    
    setup();
}
  
void welcome_visitor( object ppl )
{
    int hour = NATURE_D->game_hour();
    object here = this_object();

    if ( hour < 5                           //当地时间在晨五点以前，在晚七时以
        || hour > 19 )                      //后关闭城门。
    {
        if ( query( "exits/north" ) )       //如果此刻城门是开放状态的话，
        {
                 delete("exits/south");
            tell_room( here, "城门关了。\n" ); 
            return;
        }
        tell_room( here, "城门正关着。\n" );
        return;
    }
    if( !query("exits/north") )       //在晨五时到晚七时的时间开放城门。
    {
        set( "exits/north", __DIR__"chengwai" );  //通向城外的出口
        tell_room( here, "城门开了。\n" );     
        return;    
    }
    tell_room( here, "城门正开着。\n" );
}


