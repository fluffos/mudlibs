#include <room.h>

inherit ROOM;

void create() {
  set("short", "帐房");
  set("long", @LONG
这里是镖局的账房，迎面一道木柜台，将两张榆木长桌圈在里面，一条桌子
上堆着账本子，另一条桌子上账房先生正在打算盘。地下堆着几只箱子，两口麻
袋。小活计在一边沏茶，准备端水送给外面的镖师们。
    外面是一个大院，一片吆喝之声不断传来。
LONG
  );
  set("exits", ([
    "west": __DIR__ "dayuan",    //镖局大院
  ]));
  set("objects", ([
    __DIR__ "npc/zhu_suan": 1,      //朱算
  ]));
  create_door("west", "黑漆木门", "east", DOOR_CLOSED);  //西面有木门

  setup();
}
