//  狗肉：佛光阁和尚之物，完成任务用。  /d/city/lanzhou/obj/gourou.c
//  By lin
//  Changed by lala, 1998-03-16

#include <ansi.h>

inherit ITEM;
inherit F_FOOD;

void create()
{
    set_name( YEL"狗肉"NOR, ({ "gou rou", "gourou", "rou", "meat" }) );
    set_weight( 1000 );                     //两市斤；
    if ( clonep() )
        set_default_object( __FILE__ );
    else 
    {
        set( "long", "一大块香喷喷的红烧狗腿。\n" );
        set( "unit", "块" );
        set( "value", 80 );                 //价格80文；    
        set( "food_remaining", 7 );         //可以吃七口；
        set( "food_supply", 30 );           //每口补充30的食物。
    }
}
