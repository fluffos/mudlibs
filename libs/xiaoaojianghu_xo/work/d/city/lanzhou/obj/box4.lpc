inherit ITEM;
void create()
{
        set_name("红木箱", ({ "red muxiang", "muxiang", "box" }));
        set_weight(10000);
        set_max_encumbrance(40000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "只");
                set("long", "一只用红木作成的小箱子.\n");
                set("value", 1000);
        }
}
int is_container() { return 1; }
