inherit ITEM;
void create()
{
        int i;
        object money;
        seteuid(getuid());
        seteuid(geteuid());
        set_name("黑漆木箱", ({ "black muxiang", "muxiang", "box" }));
        set_weight(40000);
        set_max_encumbrance(100000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "只");
                set("long", "一只漆黑发亮的大木箱子。\n");
                set("value", 4000);
        }
        for(i=0;i<100;i++)
        {
                money = new(__DIR__"cloth");
                money->move(this_object());
         }
}
int is_container() { return 1; }
