inherit ITEM;
void create() {
  object money;
  seteuid(getuid());
  seteuid(geteuid());
  set_name("大铁箱", ({ "big tiexiang", "tiexiang", "box" }));
  set_weight(300000);
  set_max_encumbrance(400000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", "一只又大又笨的铁箱子。\n");
    set("value", 8000);
  }
  money = new(MONEY_DIR "silver");
  money->move(this_object());
  money->set_amount(1000);
}
int is_container() { return 1; }
