inherit ROOM;
string look_sign(object me);
void create()
{
    set("short","城煌殿");
    set("long",@LONG
这里供奉的是本城城煌。供桌上放着炉鼎，鼎里满是香灰，还有二十几根香
在燃着，散出浓浓的香烟；供桌后面一尊黑脸大汉的雕像(diaoxiang)身穿戎服
手握大刀，威武有神。有人说这位城煌是当年汉武帝手下的飞将军李广，也有的
说就是当今筑城守城的狄青大将军。殿两厢的木栏后架着十八般兵器；殿后一道
小门通向后院佛寺。殿外是个集市，热闹非凡。
LONG);
    set("item_desc",([
          "diaoxiang" : (: look_sign :),
    ]));
    set("exits",([
        "out"   : __DIR__"nanjie1",
        "in"    : __DIR__"foguang_ge",
    ]));
 set("objects",([
        __DIR__"npc/oldwoman" : 1
    ]));
    setup();
}
string look_sign(object me)
{
     return"  你盯着神像看了看，只觉得神圣无比，令你不\n"
           "  由自主地想跪下去磕头(ke tou)。\n";
}
void init()
{
      add_action("do_ketou","ke");
}
int do_ketou(string arg)
{
     int my_kee,my_beli;
     object me;
     me = this_player();
     if( !arg || arg == "")
           return 0;
     else if ( arg != "tou" )
           return 0;
     else {
          my_kee = me->query("kee");
          if ( my_kee < 5 ){
               tell_object(me,"你一个头磕下去，只觉得头晕眼花，一个趔趄......\n");
               me->unconcious();
               return 0;
            }
          else {
               message_vision("$N虔诚地磕了个头.....\n",me);
               my_beli = me->query("bellicosity");
               if ( my_beli > 100 ){
                   my_beli = my_beli / 100 + random(2);
                   me->add("bellicosity",-my_beli);
                   me->receive_damage("kee",my_beli);
                   tell_object(me,"你觉得心中的恶念在一点点地消除......\n");
                   return 1;
                }
               else {
                    if( my_beli < 0 ) {
                        me->receive_damage("kee",1);
                        return 1;
                      }
                    else {
                        me->receive_damage("kee",1);
                        me->add("bellicosity",-1);
                        tell_object(me,"你觉得心中的恶念在一点点地消除......\n");
                        return 1;
                     }
                 }
           }
      }
}
            
          


