
#include <ansi.h>
inherit NPC;

int delay( int time );
int query_answer( object ppl );

string ask_me( object ppl );

void create()
{
    set_name( MAG "金湘玉" NOR, 
        ({ "jin xiangyu", "jin", "xiangyu", "jinxiangyu", "boss" }) );
    set( "title", MAG "龙门客栈老板娘" NOR );
    set( "nickname", RED"桃花夫人"NOR );
    set( "gender", "女性" );
    set( "age", 28 );
    set( "per", 24 );
    set( "long", @LONG
金湘玉是龙门客栈的老板娘。她一身披红挂绿，行动招摇，言语风骚。虽然是将
个客栈经营得蒸蒸日上，却也免不了招来许多背地里的闲言碎语。
LONG
    );
    set( "inquiry", ([
        "武功"  :   (: ask_me :),
        "skill" :   (: ask_me :),
        "skills":   (: ask_me :),
        "wugong":   (: ask_me :),
    ]));
    set_wugong( "unarmed",          100,    100,    0 );
    set_wugong( "taizu-quan",       100,    100,    0 );
    set_wugong( "yuanyang-tui",     100,    100,    1 );

    set_wugong( "blade",            100,    100,    0 );
    set_wugong( "liuhe-dao",        100,    100,    0 );
    set_wugong( "yuanyang-dao",      80,     80,    1 );

    set_wugong( "qinggong",         100,    100,    0 );
    set_wugong( "feiyan-zoubi",     100,    100,    1 );
    set_wugong( "feiyan-gong",      100,    100,    1 );

    set_xiuwei_by_type( "unarmed",  700 );
    set_xiuwei_by_type( "blade",   1050 );
    set_xiuwei_by_type( "dodge",    800 );
    set_xiuwei_by_type( "zonggang", 500 );

    set( "combat_exp", 200000);
    set( "bellicosity", 400);
    set( "positive_score", 10000);
    set( "negative_score", 8000);
    set( "attitude", "friendly" );
    set( "max_force", 1500 );
    set( "force", 1500 );
    set( "force_factor", 30 );

    setup();
    carry_object(__DIR__"obj/yu_zhuozi")->wear();
    carry_object(__DIR__"obj/jin_zanzi")->wear();
    carry_object(__DIR__"obj/wocloth3")->wear();
    carry_object(__DIR__"obj/woboots1")->wear();
}

void init()
{
    object ppl;
    ::init();
    if( interactive(ppl = this_player()) 
        && !is_fighting() ) 
    {
        remove_call_out("greeting");
        call_out("greeting", 1, ppl);
    }
}

void greeting( object ppl )
{
    object npc, ye, here, there;
    npc = this_object();
    if( !ppl 
        || environment(ppl) != environment() ) 
        return;
    if( !living( npc ) ) 
        return;

    if( environment() == find_object( "/d/city/lanzhou/yazuo" ) )
    {// 这是在雅座上时的反应。
        if( objectp( present( "duan dao", ppl) ) 
            && !ppl->query( "marks/lin/兰州秘密A" ) )
        {//来者身上有短刀
            message_vision( "$N突然冲着$n喝道：“你的短刀是从哪儿来的？！”\n"
                , npc, ppl);
            carry_object(__DIR__"obj/blade3")->wield();
            kill_ob(ppl);
            ppl->fight_ob(npc);
            return;
        }
        if( ppl->query("marks_lin/kill_ye_maozi") )
        {//来者曾经为了谋求破带鱼施舍的二十两金子，狠心将夜锚子交给了官府.
            message_vision( "$N一见到$n，突然象发疯了一样地冲了上来！\n", 
                npc, ppl );
            carry_object(__DIR__"obj/blade3")->wield();
            set( "here/attack", 100 );
            npc->kill_ob(ppl);
            ppl->figh_ob(npc);
            return;
        }
        if( !ppl->query("marks/lin/兰州秘密A") )
        {
            if( ppl->query("gender") == "男性" 
                && ppl->query("age") > 19 )
                //待客之道
                message_vision( "$N笑眯眯地迎着$n道：“哎呦呦这位大官人，"
                    + "小店有您捧场真是福大运大呀！您请坐！” \n", npc, ppl );
            else
                message_vision( "$N看了$n一眼，又去招呼别的客人去了。\n", 
                    npc, ppl );
        }
        //故事：在搭救了金湘玉及其爱人夜猫子后。过了三个月，有一天，你正象
        //这些日子以来一贯的那样来到雅座上(:P)向金湘玉请教武功，可是......
        if( ppl->query("marks/lin/兰州秘密A") == 2 )
        {
            if ( ( ppl->query("mud_age")
                - ppl->query("marks/lin/兰州秘密A开始时间") ) > 10800 )
            {
                if( !npc->can_act() ) 
                    return;
                if( ( ppl->query("mud_age")
                    - ppl->query("marks/lin/兰州秘密A开始时间") ) > 21600 ) 
                //时间太长了。
                {
                //又不能继续向金学了，这条线索就此中断，以后你不可能再与金发生
                //什么关系啦，呵呵
                ppl->set("marks/lin/兰州秘密A",-1);
                message_vision( "$N看了$n一眼，又转过了头去。\n", npc, ppl);
                tell_object( ppl, "好象发生了什么你不清楚的事情了，嗯，"
                    + "是长时间没来的缘故吧。\n");
                return;
            }
            ppl->disable_command( "verb", "不想知道后面将发生什么？\n" );
            message_vision( "$N看到$n上来，便四面看了一看，装作很随便的样子走"
                "到$N旁边。\n", npc, ppl );
            command( "whisper " + ppl->query("id") 
                +" 你听了可别着急，我有点事情要告诉你：。");
            command( "whisper " + ppl->query("id") 
                + " 你知道我有个师哥也在这城里么？");
            delay(25);
            tell_object( ppl, name() + "边留意着四周的人，边对你耳语道：" 
                + CYN " “\n" + @TEXT
     我这个师兄，其实就在龙门镖局中干事，他姓汤，你们可能见过的。
     他从小和我与业师学习武功，只是他为人很是奸猾，我一直就看不  
     他那样的人，所以很是讨厌他，师傅也不喜欢他，连本门精华的武  
     功也不肯教给他。为此他反说是我挑拨了他和师傅的关系。从此就  
     恨上了我。
TEXT
            NOR );
            call_out( "story1", 2, ppl );
            return;
         }
      }
    }
    else if( environment() == find_object( "/d/city/lanzhou/chaidui" ) )
    {//身在柴堆，与夜锚子在一起。。。。。。
        if( !npc->can_act() ) 
            return;
        if( ppl->query("marks/lin/兰州秘密A")  
            ||  ppl->query_temp("marks/lin/兰州秘密A发现") )
            return;
        here = environment();
        if( !ye = present( "ye maozi", here ) )
        {
            if( npc->can_act() )
            {
                message_vision( "$N一见到$n钻进来，登时尴尬地走了出去。\n",
                    npc, ppl );
                there = find_object( "/d/city/lanzhou/yazuo" );
                if( !present( "jin xiangyu", there ) 
                    && npc->can_act() )
                {
                    npc->move( there );
                    tell_room( there, name() + "悄悄地从楼下上来。\n");
                }
                else
                {
                    destruct( npc );
                    return;
                }
            } 
        }
        else
        {   //金湘玉看到有人发现了自己的心上人--躲在柴堆中养伤的大盗夜猫子           
            message_vision( "$N见到$n进来，大吃一惊，飞快地抽出一把亮晃晃的"
                + "短刀握在手中。\n" ,npc, ppl );
            if( !npc->query_temp("weapon") )//拿刀..
            {
                new( __DIR__"obj/blade3" )->move( npc );
                command( "wield blade" );
            }
            //喝问..
            command("say “你怎么知道这里？！！你是不是官府派来的？！！？老"
                + "娘这就和你拼了！！”" );
            tell_object( ppl, RED"看来" + name() + RED"想杀死你！！！\n" NOR);
            //这时如果夜猫子无力劝阻。。。。。。
            if ( !living( ye ) 
                || random(3) != 1 
                || sizeof( all_inventory( here ) ) > 3 
                || ppl->query( "kar" ) == 20 
                || !npc->can_act() )
            {
                npc->kill_ob( ppl );
                ppl->fight_ob( npc );
                if( living( ye ) )
                    message_vision( "$N呻吟了一声，似乎要出手阻止，"
                        + "却是半点力气也没有。\n", ye );
                return;
            }
            else
            {//恰好夜猫子担心湘玉受到牵连,....
                ppl->disable_command( "verb", "不想看看他们想对你作什么？" );
                message_vision( "$N说：“不要！！湘玉，你冷静一下！！”\n",
                    ye );
                message_vision( "$N挣扎着想站起来。\n", ye );
                delay( 30 );
                command( "unwield blade" );
                message_vision( "$N喘着气说：“也许这个人是咱们的最后希望了"
                    + "……”\n", ye );
                delay( 20 );
                command( "say “你是说……”" );
                message_vision( "$N点了点头。\n", ye ); 
                call_out( "give_quest", 5, ppl );
                return;//算你小子走运！
            }
        }
    }
}

void story1( object ppl )
{
    object tmp;
    tell_object( ppl, CYN @TEXT
    后来他学不到师傅的真传，就一气之下下山来到兰州当镖师。不久
    我也来到了这里，靠着秦大官人的本钱帮忙办起了这个客栈。可是
    他心里总是存着报复我的意思。倒霉的是这回咱们救夜猫子的事，
    也不知道他是从哪儿打听到的。我看事情不太妙了，你还是快快离
    开吧。虽说你帮过我的大忙，不过老娘向来一人做事一人当，不要
    旁人来垫背。
TEXT
    NOR );
    tell_object( ppl, CYN
"    这是五十两银子，先给你作路费，尽快离开城里，有什么事以后再说。”\n" NOR);
    command( "sigh" );
    ppl->set( "marks/lin/兰州秘密A", 3 );
    ppl->enable_path();
    tmp = new( MONEY_DIR + "silver" );
    tmp->set_amount( 50 );
    tmp->move( ppl );
    return;
}

int valid_teach( object ppl, string skill )
{
    if( !query_jibie( skill ) )
        return 0;

    if( !ppl->query("marks/lin/兰州秘密A") )
        return ::valid_teach( ppl, skill );

    if( ppl->query("marks/lin/兰州秘密A") == 1 )
        return query_answer( ppl );

    if( ppl->query("marks/lin/兰州秘密A") != 3  )
        return 1;

    write( name() 
        + "瞪了你一眼，着急地小声说：“怎么还不走？迟了就来不及了！！\n"); 
    return 0;
}

string ask_me( object ppl )
{
    ppl = this_player();
    if ( valid_teach( ppl, "taizu-quan" ) )
        return @TEXT
你可以学：
    横刀六式     〖blade〗     
    飞燕功       〖feiyan-gong〗  
    飞檐走壁之术 〖feiyan-zoubi〗   
    六合刀法     〖liuhe-dao〗   
    基本轻功     〖qinggong〗   
    太祖长拳     〖taizu-quan〗    
    基本拳法     〖unarmed〗        
    鸳鸯刀法     〖yuanyang-dao〗   
    鸳鸯腿       〖yuanyang-tui〗  
TEXT
    ;
    return "我不知道什么武功的事，阁下请便吧。";
}

int query_answer( object ppl )
{
    if ( ppl->query( "marks/lin/兰州秘密A" ) == 1 )//教功夫
    {
        command( "whisper " + ppl->query("id") 
            + CYN " “刚才的事多亏你啦！！要不是你正巧撞进来，真不知道" 
            + "会出什么事咧！”" NOR );
        command( "whisper " + ppl->query("id") 
            + CYN " “我看你也是个学武的，正好，没有别的可以帮你，要是"
            + "有什么不懂的，就问我吧。" NOR );
        message_vision( "$N用感激的眼光看了看$n，很快就转过头去招呼顾客了。\n"
            , this_object(), ppl );

        ppl->set( "marks/lin/兰州秘密A" , 2 );
        ppl->set( "marks/lin/兰州秘密A开始时间", ppl->query("mud_age") );
        //计时
        return 1;
    }
    if ( ppl->query( "marks/lin/兰州秘密A" ) >= 2 )
    {
        command( "xixi " + ppl->query( "id" ) );
        command( "tell " + ppl->query( "id" ) 
            + " “我不是说了嘛？可不要随便乱说呦！！”" NOR );
        return 1;
    }
    return 0;
}

//这里太太太太太土了~~
int delay( int time )
{
    int i,j;
    for( i = 0; i < time; i++ )
        for( j = 0; j < 10000; j++ )
        {}
    return 1;
}

int give_quest( object ppl )
{
    object npc, there;

    npc = this_object();
    
    command( "think" );
    command( "ok" );
    message_vision( "$N转过头去，匆匆写了一张纸条，塞给$n。\n", npc, ppl );
    message_vision( @TEXT 
$N说：“ 
这是我们两人的最后希望了。外面官府看的紧，这里不少人知道我和
我和天翔的关系，他一出事，门外就开始有不少捕快查来查去。我一
直想将消息带给王太医，就是出不得门。阁下如果愿意帮助，不妨就
作点好事吧，小女子一辈子感激你的大恩大德。你快把这纸条交给泰
仁堂的王太医，他知道该如何办。我还要出去照顾客人，免得大家起
疑，你快去快回！！”
TEXT
    , npc );
    ppl->set_temp( "marks/lin/兰州秘密A发现", 1 );
    new( __DIR__"obj/zhitiao" )->move( ppl );
    message_vision( "$N匆匆地拨开柴草，小心地看了看外面，才走了出去。\n", 
        npc );
    if ( !there = find_object( "/d/city/lanzhou/yazuo" ) )
        there = load_object( "/d/city/lanzhou/yazuo" );
    if( !present( "jin xiangyu", there ) )
    {
        npc->move( there );
        tell_room( there, name() + "悄悄地从楼下上来。\n");
    }
    else
        destruct( npc );
    ppl->enable_path();
    return 1;
}


