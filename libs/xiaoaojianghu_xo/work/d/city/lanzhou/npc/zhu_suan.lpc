//  等级：
//  【巳等】小门派的弟子，江湖闲汉
//          零级修为（      ０－  １００）一级武功（    ０－  ６０）
//          经验（        ０－  ７５００）声望（          ０－         ７５）
//  By lin
//  Changed by lala, 1998-04-02

inherit NPC;

#include "jianxi.h"

void create()
{
    set_name( "朱算", ({ "zhu suan", "zhusuan", "zhu", "sir" }) );
    set( "title", "帐房先生" );
    set( "gender", "男性" );                //性别：男
    set( "age", 56 );                       //年龄：56
    set( "attitude", "friendly" );          //态度：友善
    set( "long", @LONG
    朱算来镖局已有十来年了。他心思敏捷，打得一手好算盘又颇懂经营之道，
这二年不但使镖局财源滚滚，还办起了其他行当的买卖。
LONG
    );

    set( "chat_chance", 5 );
    set( "chat_msg", ({
        "朱算把算盘拨得“哗哗”响，嘴里不住念叨着什么。\n",
     }) );

    setup();
    carry_object( CLOTH_DIR + "cloth5" )->wear();       //紫绸长衫
}

