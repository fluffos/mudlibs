//  店小二：住宿，卖食物    /d/city/lanzhou/npc/xiaoer.c
//  等级：
//  【巳等】小门派的弟子，江湖闲汉
//          零级修为（      ０－  １００）一级武功（    ０－  ６０）
//          经验（        ０－  ７５００）声望（          ０－         ７５）
//  By lin
//  Changed by lala, 1998-03-29

#define LANZHOU_DIR "/d/city/lanzhou/"

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("店小二", ({ "xiao er", "xiaoer", "waiter" }));
  set("gender", "男性");                //性别：男
  set("age", 22);                       //年龄：22
  set("attitude", "friendly");          //态度：友善
  set("rank_info/respect", "小二哥");   //敬称：小二哥
  set("long", @LONG
    店小二身穿青布衣衫，正笑眯眯地看着你，等你点菜或是租房。
LONG
  );

  set_wugong("unarmed", 60, 60, 1);    //基本拳法：    一级

  set_xiuwei_by_type("unarmed", 100);  //拳脚修为：    零级

  set("combat_exp", 7500);             //战斗经验：7500

  set("inquiry", ([
    "租房": "呃，客官要租房？好，一天三两银子。",
    "住店": "客官是要租房吧？",
    "老板娘": "老板娘对我可好了咧！～～",
    "金湘玉": "老板娘对我可好了咧！～～",
  ]));
  set("talk_msg", ({
    "“住店一天三两银子，管保你人财安全。”",
  }));
  set("chat_chance_combat", 5);
  set("chat_msg_combat", ({
    "店小二大声喊道：“你不要逞强，等镖局的师傅们来了，有你好看的。”\n",
    "店小二边打边喊：“人都哪儿去啦？快来帮忙哇！！”\n",
  }));
  set("vendor_goods", ([
    "江南黄酒": LIQUID_DIR + "hulu",
    "白面馒头": FOOD_DIR + "mantou",
    "红烧狗肉": FOOD_DIR + "gourou",
    "肉馅包子": FOOD_DIR + "baozi",
  ]));

  setup();
  carry_object(CLOTH_DIR + "cloth1")->wear();       //青布衣衫
}

void init() {
  object ppl;

  ::init();

  add_action("do_vendor_list", "list");

  if (!userp(ppl = this_player())
    || !can_act())
    return;
  remove_call_out("Greeting");
  call_out("Greeting", 1, ppl);
}

void Greeting(object ppl) {
  if (!ppl
    || environment(ppl) != environment())
    return;
  switch (random(3)) {
    case 0:
      say("店小二笑咪咪地说道：“这位" + RANK_D->query_respect(ppl)
        + "，进来歇歇腿吧。这里可以住店哪！”\n");
      break;
    case 1:
      say("店小二用脖子上的毛巾抹了抹手，说道：“这位"
        +RANK_D->query_respect(ppl) + "，来点什么？”\n");
      break;
    case 2:
      say("店小二说道：“这位" + RANK_D->query_respect(ppl)
        + "，进来喝几盅小店的好酒吧，这几天才从窖子里开封的哟。”\n");
      break;
  }
}

int accept_object(object ppl, object obj) {
  if (obj->value() >= 3000) {
    message_vision("店小二收下钱，笑眯眯地说：“请进，请进！”\n"
      + "店小二将$N请进后边客房里。\n", ppl);
    ppl->move(LANZHOU_DIR + "changyuan");
    ppl->set_temp("住店", 1);
    return 1;
  }
  return 0;
}

int refuse_killing(object ppl) {
  object npc;

  if (!can_act())
    return 0;

  command("chat* help!");
  command("chat 各位，" + ppl->name() + "无缘无故要杀我，快救命啊！");
  if (!npc = present("cheng biaotou", environment())) {
    remove_call_out("Killing");       //遭到攻击后三秒内调出成镖头。
    call_out("Killing", 3, ppl);
    return 0;
  }
  message_vision("只见$N冲着$n大喝一声：“竟敢来兰州城里捣乱？！”，"
    + "提着刀就冲了上去。\n", npc, ppl);
  npc->kill_ob(ppl);
  ppl->fight_ob(npc);
  return 0;
}

void Killing(object ppl) {
  object npc;

  if (!ppl
    || environment(ppl) != environment())
    return;
  message_vision("一名龙门镖局的镖师匆匆走进来喝道：“是谁在撒野？！”\n",
    ppl);
  message_vision("镖师对着$N喝道：“原来是你，竟敢在这里行凶！！\n", ppl);
  npc = new(__DIR__ "guard4");
  npc->move(environment());
  npc->set_wugong("fenglei-dao", 20, 20, 1);        //一个加强成镖头
  npc->set_xiuwei_by_type("blade", 601);            //刀法修为：三级
  npc->set_xiuwei_by_type("dodge", 601);            //轻功修为：三级
  npc->kill_ob(ppl);
  ppl->fight_ob(npc);
}
