//  夜猫子：西北大盗，有秘密  /d/city/lanzhou/npc/ye_maozi.c
//  等级：
//  【丁等】大门派的三级师傅、中等门派的二级师傅、小门派的一级师傅
//  ★★★☆
//  〖一级〗三级修为（  ９０１－１１００）四级武功（  ８０－１１０）
//          经验（    ２５万－    ５０万）声望（    ２５００－    ５０００）
//          内力（  １２００－  １８００）体能、生命（  ５００－    ７５０）
//  By Lin
//  Changed Lala,  1998-03-25

#include <ansi.h>

inherit NPC;

void create() {
  set_name(BLU "夜猫子" NOR, ({ "ye maozi", "maozi", "ye", "yemaozi" }));
  set("title", "通辑犯");
  set("nickname", HIY "西北名盗" NOR);
  set("gender", "男性");               //性别：男
  set("age", 33);                       //年龄：33
  set("per", 30);                       //容貌：30
  set("long", @LONG
    夜猫子人称西北名盗，为人精滑，偷技高超，曾经在西北一带偷过数不清的
深宅大户，却极少失手。
LONG
  );

  set_wugong("yuanyang-dao", 80, 80, 1);    //鸳鸯刀法：    四级

  set_wugong("feiyan-zoubi", 100, 100, 0);    //飞檐走壁之术：二级
  set_wugong("meihua-bu", 80, 80, 1);    //梅花七星步：  三级

  set_xiuwei_by_type("blade", 1050);  //刀法修为：    四级
  set_xiuwei_by_type("dodge", 800);  //轻功修为：    三级

  set("combat_exp", 250000);           //战斗经验：25万
  set("social_exp", 25000);            //江湖阅历：25000

  set("gin", 10);                   //受伤后的表现
  set("kee", 20);
  set("sen", 40);

  set("eff_kee", 40);
  set("eff_sen", 40);

  setup();

  carry_object(__DIR__ "obj/yuma");     //羊脂玉马
  carry_object(__DIR__ "obj/yuanyang-dao")->wield();  //鸳鸯刀
  carry_object(CLOTH_DIR + "jinzhuang1")->wear();  //黑色劲装
}

int accept_object(object ppl, object obj) {
  if (obj->query("id") != "yuling san"  //如果给的不是玉灵散就不要，
  //如果此人没有发现兰州秘密也不行。
  || !ppl->query_temp("marks/lin/兰州秘密A发现"))
    return 0;
  message_vision("夜猫子看了看$N，接过玉灵散服了下去。\n", ppl);
  message_vision("夜猫子坐在地上，闭上眼睛……\n", ppl);
  remove_call_out("Thank");
  call_out("Thank", 10, ppl);
  return 1;
}

int Thank(object ppl)                     //服药后伤好了，表示感谢。
{
  object blade;

  if (!ppl
    || environment(ppl) != environment())
    return 0;
  message_vision("夜猫子睁开眼睛，对$N说道：“多谢恩人相救，官府追查得紧，"
    + "湘玉不能亲自取药\n若不是恩人相助，我夜猫子就命丧黄泉了。”\n\n"
    + "夜猫子将一柄刀递给$N，说：“这是我在郝府中盗来的一口宝刀，就送"
    + "给阁下作为一点\n心意吧！”\n", ppl);
  blade = new(__DIR__ "obj/7-blade");    //得到从郝意凝这条带鱼家偷出的七星
  //碧玉刀。
  blade->move(ppl);
  message_vision("夜猫子说：“恩人保重，我这就要离开此地了。湘玉还要拜托恩"
    + "人多多照顾才是。”\n夜猫子缓缓走了出去。\n\n", ppl);
  if (ppl->query("social_exp") < 100000) {
    ppl->add("social_exp", 500);      //加江湖阅历500
    ppl->add("positive_score", 1000);  //加正声望1000
  }
  ppl->add("positive_score", 500);      //加正声望500
  ppl->set("marks/lin/兰州秘密A", 1);
  destruct(this_object());
}
