inherit FILLER;

void create() {
  set_name("老妪", ({ "lao yu", "laoyu", "old woman", "old", "woman" }));
  set("gender", "女性");                //性别：女
  set("age", 65);                       //年龄：65
  set("attitude", "friendly");          //态度：友善
  set("long", @LONG
    一位年俞花甲的老婆婆，正在烧香拜神。
LONG
  );

  set("chat_chance", 5);
  set("chat_msg", ({
    "老婆婆冲着神像磕了个头，嘴里还念叨着什么。\n",
  }));

  setup();
  carry_object(CLOTH_DIR + "cloth_f")->wear();      //棉布衣衫
}

int query_answer(object ppl) {
  command("en");
  command("say “年景不利，要多求神仙保佑才是。”");
  return 1;
}
