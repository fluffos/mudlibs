// force_book.c

inherit ITEM;

void create()
{
    set_name("三字经", ({"san zi jing","jing", "shu" }));
        set_weight(60);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
                set("long",
                "这本书的纸张都已经泛黄了，看上去相当破旧。\n");
                set("value", 170);
                set("material", "paper");
                set("skill", ([
                        "name":"literate",
                        "xiuwei_required" : 0,
                        "gin_cost" : 10+random(10),
                        "difficulty":   20,
                        "max_lingwu" : 30,
            "bonus_jilei" : -1, //-1表示用literate来计算你每次所得的jilei
                ]) );
        }
}

