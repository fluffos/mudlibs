#include <armor.h>
inherit BOOTS;
void create()
{
        set_name("绣花鞋", ({ "boots", }) );
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一双精致的绣花鞋.\n");
                set("unit", "双");
                set("value", 600);
                set("material", "cloth");
                set("armor_prop/armor", 1);
                set("armor_prop/personality", 1);
                set("female_only", 1);
        }
        setup();
}

