//  羊脂玉马：兰州解谜用    /d/city/lanzhou/npc/obj/yuma.c
//  By lin
//  Changed by lala, 1998-03-16

#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIY "羊脂玉马" NOR, ({ "yu ma", "yuma", "ma", "jade" }));
  set_weight(200);                        //四市两；
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一只用羊脂白玉雕成，五寸来高的小马，尖耳挺背，"
      + "作嘶鸣状，极是可爱。\n");
    set("unit", "只");
    set("cant_sell", "伙计大惊，道：“客官这东西是哪儿来的？别是来路不"
      + "正吧？”\n");
    set("value", 20000);              //价格：(100*200)珠翠价格
    //=20000总价格；
    set("material", "jade");          //质地：珠翠（单价
    //１００，０００文／千克）
  }

  setup();
}
