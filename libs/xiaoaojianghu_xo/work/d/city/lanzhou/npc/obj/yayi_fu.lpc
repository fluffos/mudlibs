#include <armor.h>
inherit CLOTH;
void create()
{
        set_name("衙役服", ({ "yayi fu", "cloth" }));
        set("long", "一件红色的棉布衣服。背心上一个大白圈，里面写着一个'捕'字\n");
        set_weight(1000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("material", "cloth");
                set("unit", "件");
                
                set("armor_prop/armor", 1);
        }
        setup();
}

