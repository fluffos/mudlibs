#include <ansi.h>
inherit ITEM;
inherit F_FOOD;
void create() {
  set_name(RED "红烧狗肉" NOR, ({ "gou rou", "rou" }));
  set_weight(1500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一大块香喷喷的红烧狗腿。\n");
    set("unit", "块");
    set("value", 80);
    set("food_remaining", 7);
    set("food_supply", 30);
  }
}
