//  年轻人：有秘密  /d/city/lanzhou/npc/youngman.c
//  等级：
//  【巳等】小门派的弟子，江湖闲汉
//          零级修为（      ０－  １００）一级武功（    ０－  ６０）
//          经验（        ０－  ７５００）声望（          ０－         ７５）
//  By lin
//  Changed by lala, 1998-04-01

inherit NPC;

int Dest(object obj, object ppl);

void create() {
  set_name("年轻人", ({ "nianqing ren", "nianqingren", "ren",
    "man" }));
  set("gender", "男性");                //性别：男
  set("age", 23);                       //年龄：23
  set("per", 24);                       //容貌：24
  set("attitude", "friendly");          //态度：友善
  set("long", @LONG
    一个年纪轻轻，眉清目秀的后生，一看便知是个读书人。只是身上穿戴颇为
寒酸，面有菜色，显然是落魄难求生计。
LONG
  );

  setup();
  carry_object(CLOTH_DIR + "cloth1")->wear();       //青布衣衫
}

void init() {
  object ppl;

  ::init();

  if (!userp(ppl = this_player())
    || !can_act())
    return;

  remove_call_out("Greeting");
  call_out("Greeting", 30);
}

void Greeting() {
  object here;
  if (!here = environment()
    || here->query("location") != "lanzhou"
    || !here->can_shop())
    return;

  say(@TEXT
    年轻人可怜巴巴地向伙计求道：“行行好，就当我几十个钱吧？”
    伙计大声斥责道：“几本破书烂纸也想骗钱？！当心我报了官，将你拿进衙
    门里，一顿驮水棍打你个七荤八素！快滚！”
TEXT
  );
}

int accept_object(object ppl, object obj) {
  object book;

  if (obj->value() < 1000
    || ppl->query_temp_marks("年轻人"))
    return 0;
  if (!ppl->query("marks/年轻人"))    //如果以前没有和他发生任何关系
  {
    if (ppl->query("age") > 15)     //如果年龄超过15岁就不发生任何事
      return 0;
    ppl->set("marks/年轻人", 1);      //否则记录下来，作为此人一生的记录
    LOG_D->do_log(ppl,
      "年轻的你在兰州当铺中救助了一个身无分文的年轻书生。");
  } else
    ppl->set_temp_marks("年轻人", 1);  //若已经发生过前面的事情了
    //就把这回上线的事情记录下来
    remove_call_out("Dest");
  call_out("Dest", 1, obj, ppl);
  return 1;
}

int Dest(object obj, object ppl)          //obj：钱；
{                                           //ppl：玩家；
  object book = new(__DIR__ "obj/shiji");  //book：《史记》
  say("\n");
  message_vision2("　　年轻人忍不住哽噎起来，说道：“在下流寓到此，谁知"
    + "盘缠用尽，此地举目无亲，若无恩人相助……多谢这位$F，只是读书人不可"
    + "无端受人之物，在下的这几本书，原是指望细心研读，谁承想落到如此地步"
    + "，竟欲以此当钱求生。恩人就将此书收下，留作纪念吧！”\n　　年轻人缓"
    + "缓走出店门。", ppl);
  book->move(ppl);
  destruct(obj);
  destruct(this_object());
}
