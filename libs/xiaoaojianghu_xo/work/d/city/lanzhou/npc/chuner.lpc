//  春儿：妓女，奸细    /d/city/lanzhou/npc/chunner.c
//  等级：
//  【巳等】小门派的弟子，江湖闲汉
//          零级修为（      ０－  １００）一级武功（    ０－  ６０）
//          经验（        ０－  ７５００）声望（          ０－         ７５）
//  By lin
//  Changed by lala, 1998-03-25

#include <ansi.h>

inherit NPC;

void create() {
  set_name("春儿", ({ "chun er", "chuner", "chun", "girl" }));
  set("title", RED "群红院妓女" NOR);
  set("gender", "女性");                //性别：女
  set("age", 22);                       //年龄：22
  set("per", 24);                       //容貌：24
  set("attitude", "friendly");          //态度：友善
  set("rank_info/respect", "姐姐");     //尊称：姐姐
  set("negative_score", 70);           //负声望：70
  set("long", @LONG
春儿是群红院的一名妓女，长得颇有几分姿色。
LONG
  );

  set("combat_exp", 100);               //战斗经验：100
  set("env/wimpy", 80);                 //逃跑系数：80

  set("chat_chance_combat", 5);
  set("chat_msg_combat", ({
    "春儿大喊：“救命呀！”\n",
  }));

  setup();
  carry_object(SKIRT_DIR + "hong_lingqun")->wear();  //石榴红绫裙
  carry_object(BOOTS_DIR + "xiuhua_xie")->wear();   //绣花鞋
  carry_object(HEAD_DIR + "yin_zanzi")->wear();     //银簪子
  add_money("coin", 200);               //铜钱：200
}

void init() {
  object ppl = this_player();
  object npc = this_object();

  ::init();

  if (!userp(ppl = this_player())
    || !can_act())
    return;

  remove_call_out("Greeting");
  call_out("Greeting", 1, ppl);

  if (ppl->query("yipin/refuse_join"))  //如果此人拒绝过加入一品堂
    return;                             //则不理睬；
    if (ppl->IsMemberOf("yipin"))       //如果此人是一品堂的
      return;                             //则不理睬；
      if (ppl->query_temp("yipin_tang/fazhan_ren"))   //如果有人发展过了
        return;                                         //则不理睬；
        if (ppl->query("positive_score") < 3000          //如果此人声望不够
        && ppl->query("negative_score") < 1000)      //则不理睬；
          return;
  if (ppl->query_xiuwei_by_type("sword") +         //如果此人总修为和
  ppl->query_xiuwei_by_type("blade") +          //不足一千，则不理睬；
  ppl->query_xiuwei_by_type("unarmed") +
    ppl->query_xiuwei_by_type("dodge") +
    ppl->query_xiuwei_by_type("short") +
    ppl->query_xiuwei_by_type("long") +
    ppl->query_xiuwei_by_type("whip") +
    ppl->query_xiuwei_by_type("zonggang") <= 1000)
    return;
  if (random(100) < 30)               //三分之一的概率不理睬。
    return;

  remove_call_out("FaZhan");            //发展一品堂新成员。
  call_out("FaZhan", 2, ppl, npc);
}

void Greeting(object ppl) {
  if (!ppl
    || environment(ppl) != environment())
    return;
  if (ppl->query_temp("killchuner"))  //如果此人杀过春儿，
  {                                       //则以百分之三十的概率逃走。
    message_vision("春儿一见$N走过来，吓得急忙想跑开。\n", ppl);
    if (random(100) > 30)
      random_move();
  }

  if (ppl->query("gender") == "男性"     //如果是成年男子，则招呼。
  || ppl->query("age") > 17)
    message_vision("春儿笑着上来拉住$N的手说：“这位大官人，进来坐坐呀！"
      + "”\n", ppl);
}

int refuse_killing(object ppl)            //被杀的反应。
{
  message_vision("春儿大叫一声：“杀人啦～～！”，吓得撒腿就跑。\n", ppl);

  if (random(100) < 50)               //以百分之五十的概率逃走。
    random_move();
  ppl->set_temp("killchuner", 1);       //玩家被做标记。
  return 0;
}

void FaZhan(object ppl, object npc) {
  if (!ppl
    || environment(ppl) != environment())
    return;

  if (ppl->query("gender") == "男性"   //如果是成年男性
  && ppl->query("age") > 17) {
    message_vision("春儿笑着上来拉住$N的手说：“这位大官人，进来坐坐呀！"
      + "”\n", ppl);
    tell_object(ppl, "你正想打发春儿走开，突然觉得春儿那只空着的手在\n"
      + "你胸前一碰，你怀里似乎多了件物事。你不由得一怔。\n");
    command("whisper " + ppl->query("id")
      + "“大官人若是闲来无事，到小巷深处的那家大宅子去看看如何？\n"
      + "官人一定会满意的。”");
    ppl->set_temp("yipin/fazhan_ren", "春儿");
    new(__DIR__ "obj/pazi")->move(ppl);          //得到一品堂的信物。
  }
}
