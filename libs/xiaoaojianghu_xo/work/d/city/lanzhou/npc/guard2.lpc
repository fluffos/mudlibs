//  汤镖头：龙门镖局镖师，有秘密    /d/city/lanzhou/npc/guard2.c
//  等级：
//  【丁等】大门派的三级师傅、中等门派的二级师傅、小门派的一级师傅
//  ★★★☆
//  〖一级〗三级修为（  ９０１－１１００）四级武功（  ８０－１１０）
//          经验（    ２５万－    ５０万）声望（    ２５００－    ５０００）
//          内力（  １２００－  １８００）体能、生命（  ５００－    ７５０）
//  By Lin
//  Changed Lala, 1998-03-25

#include <ansi.h>

inherit NPC;

void create()
{
    set_name( "汤镖头", 
        ({ "tang biaotou", "tangbiaotou", "biaotou", "tang", "guard" }) );
    set( "title", "龙门镖局镖师" );
    set( "gender", "男性" );                //性别：男
    set( "age", 38 );                       //年龄：38
    set( "per", 20 );                       //容貌：20
    set( "str", 28 );                       //臂力：28
    set( "positive_score", 500 );           //正声望：500
    set( "negative_score", 3500 );          //负声望：3500
    set( "long", @LONG
    汤镖头中等身材，面色和气，从外表看不出有什么真功夫。
LONG
    );

    set_wugong( "blade",        100,    100,    0 );    //横刀六式：    一级
    set_wugong( "ditang-dao",    90,     90,    1 );    //地趟刀：      二级
    set_wugong( "yuanyang-dao",  80,     80,    1 );    //鸳鸯刀法：    四级

    set_wugong( "unarmed",      100,    100,    0 );    //基本拳法：    一级
    set_wugong( "qinglong-zhua", 70,     70,    1 );    //青龙十三抓：  二级
    set_wugong( "tiesha-zhang",  40,     40,    1 );    //铁砂掌：      三级

    set_wugong( "jiben-qinggong",90,     90,    0 );    //基本轻功：    一级
    set_wugong( "xingyun-shenfa",90,     90,    1 );    //行云身法：    二级

    set_xiuwei_by_type( "blade",   1000 );  //刀法修为：    四级
    set_xiuwei_by_type( "unarmed",  450 );  //拳脚修为：    二级
    set_xiuwei_by_type( "dodge",    400 );  //轻功修为：    二级

    set( "max_force",   1200 );             //内力：    1200
    set( "force",       1200 );
    set( "force_factor",  60 );             //加力：    60(5%)

    set_hp( "kee",      500 );              //生命、体能：  500
    set_hp( "sen",      500 );

    set( "combat_exp",  300000 );            //战斗经验：30万
    set( "social_exp",  30000 );             //江湖阅历：30000

    set( "inquiry", ([
        "练武"      :   "江湖险恶呀，我看你还是读读书，将来当官发财去得了。",
        "学功夫"    :   "你向老李问问吧，他很有功夫教你的。",
        "总镖头"    :   "秦大哥在西北还真是数一数二的，不过嘛……",
        "金湘玉"    :   "……",
        "夜猫子"    :   "夜猫子是本地有名的大盗，据说最近失了手，正被官府\n"
                        + "通缉，还受了重伤呢。哼哼～～",
    ]) );

    setup();
      
    carry_object( __DIR__"obj/fenglei-dao" )->wield();  //风雷刀
    carry_object( CLOTH_DIR + "jinzhuang1" )->wear();   //黑色劲装

    add_money( "silver", 1 );               //一两白银三百五十文钱
    add_money( "coin", 350 );    
}

int query_answer( object ppl )
{
    object npc = this_object();
    int test = ppl->query( "marks/lin/兰州秘密A" );     //test：兰州秘密的步骤

    if ( test  > 3 )                        //如果已经全部完成
    {
       command( "fear" );
       command( "say “为了那个臭婆娘的事，你已经杀了我一次，难道还不够嘛？！"
            + "”" );
       return 1;
    } 
    if ( test == 3                          //如果正好应该问本NPC
        && !npc->query( "been_asked" ) )
    {
        ppl->disable_command( "verb", "你这件事还没有干完呢！\n" );
        npc->set( "been_asked" , 1 );
        command( "say “你有事吗？”" );
        command( "look " + ppl->query( "id" ) );
        call_out( "GotoDie", 2, ppl, npc );
        return 1;
    }
}

int GotoDie( object ppl, object npc )      //汤镖头中计自寻死路。
{
    tell_object( ppl, GRN"你在" + name() + "的耳边说道：“ 金湘玉让我来跟你\n"
        + "说，你要想和她私下解决夜猫子的事，就跟我来。咱们商量商量条件。”"
        NOR ); 
    command( "ok" );
    message_vision( "$N看了看$n，脸上流露出贪婪的表情。\n", npc, ppl );
    command( "follow " + ppl->query( "id" ) );
    ppl->set_temp( "marks/lin/杀汤", 1 );   //应该杀汤镖头了。
    ppl->enable_path();
    return 1;
}

int be_killed( object ppl )                 //被杀时的反应。
{
    object *inv;
    int i;

    if ( ppl->query( "marks/lin/兰州秘密A" ) != 3 )       //如果不是该杀则无效。
        return 0;
    tell_object( ppl, "嘻嘻～～\n" );
    if( !ppl->query_temp( "marks/lin/杀汤" ) )//如果不是骗出来的汤镖头，则无效。        
        return 0;
    ppl->delete_temp( "marks/lin/杀汤" );
    inv = all_inventory( environment( ppl ) );
    for( i = 0; i < sizeof( inv ); i++)
        if ( living( inv[i] ) 
            && inv[i] != ppl 
            && inv[i] != this_object()
            && !id( "jin xiangyu" ) )
        {
            tell_object( ppl, RED"不好，有人看到了。\n"NOR );
            ppl->set( "marks/lin/兰州秘密A", -1 );      //事情没有办好，以后金
                                                        //湘玉也不敢认你了。
            return 0;
        }
    tell_object( YEL"你想： 这下金湘玉可以放心了。\n"NOR );
    ppl->set( "marks/lin/兰州秘密A", 4 );               //解谜成功。
    return 0;
}

