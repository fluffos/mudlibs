inherit NPC;

void create()
{
    set_name("将虞候", ({ "jiang yuhou", "yuhou" }));
    set( "age", 28 + random( 5 ) );
    set("title","禁军");
    set("gender", "男性");
    set("long", "他是一名低级军官，负责城防巡查等事。\n");
    set("str",40);
    set("per", 25);
    set("combat_exp", 50000);
    set("max_gin",300);
    set("max_kee",700);
    set_wugong("staff",120,140,1);
    set_xiuwei_by_type("long",800);
    set_wugong("qinggong",100,100,1); 
    set_xiuwei_by_type("dodge",600);
    set_wugong("taizu-quan",100,100,1);
    set_xiuwei_by_type("unarmed",600);

    set("chat_chance_combat", 10);
    set("chat_msg_combat", ({
    "虞候喝道：来人！快把这个反贼拿下！\n",
    }));
    setup();
    carry_object(__DIR__"obj/wolfstick")->wield();
    carry_object(__DIR__"obj/junfu")->wear();
    carry_object(__DIR__"obj/kaijia1")->wear();
    carry_object(__DIR__"obj/toukui1")->wear();
    carry_object(__DIR__"obj/zhan_pao")->wear();
    carry_object(__DIR__"obj/yaopai")->wear();
    carry_object(__DIR__"obj/wuyun_xue")->wear();
}

void init()
{
    object ob;

    ::init();
    if ( interactive(ob = this_player()) && !is_fighting() )
    {
    remove_call_out("Greeting");
    call_out("Greeting", 1, ob);
    }
}

void Greeting(object who)
{
    if ( !present( who, environment( this_object() ) ) )
    return;
    if ( who->query_condition("kill_lanzhou") )
    {
    message_vision("守城的虞候对着$N大喝一声：“杀人放火的刁民，快快受死吧！！！” \n",who);
    kill_ob(who);
    who->fight_ob(this_object());
    return;
    }
}

int accept_fight(object me)
{
    command("say 我看你今天是活得不耐烦了,"+ RANK_D->query_rude(me)+",去死吧！\n");
    me->apply_condition("kill_lanzhou", 360);
    kill_ob(me);
    return 1;
}

