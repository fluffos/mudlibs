//  李镖头：龙门镖局镖师    /d/city/lanzhou/npc/guard1.c
//  等级：
//  【戊等】小门派的大弟子，大、中门派的一般弟子
//  ★★
//  〖一级〗二级修为（  ３０１－  ４５０）二级武功（  ８０－１２０）
//          经验（      ３万－      ６万）声望（       ３００－      ６００）
//          内力（  ３００－      ６００）体能、生命（   ２７５－    ３５０）
//  By Lin
//  Changed Lala, 1998-03-25

inherit NPC;

int CanTeach();

void create()
{
    set_name( "李镖头", 
        ({ "li biaotou", "biaotou", "li", "libiaotou", "guard" }) );
    set( "title", "龙门镖局镖师" );
    set( "gender", "男性" );                //性别：男
    set( "age", 35 );                       //年龄：35
    set( "per", 21 );                       //容貌：21
    set( "str", 30 );                       //臂力：30
    set( "int", 18 + random( 12 ) );        //悟性：18～29
    set( "positive_score", 500 );           //正声望：500
    set( "long", @LONG
    李镖头正当旺年，身材魁梧，一身的肌肉练得块块凸起，似要爆裂开来。他
虽然武功不是很高，可是人很热情，要是你向他学功夫，他说不定会很高兴地教
你。
LONG
    ); 

    set_wugong( "blade",        100,    100,    0 );    //横刀六式：    一级
    set_wugong( "ditang-dao",    90,     90,    1 );    //地趟刀：      二级

    set_wugong( "unarmed",      100,    100,    0 );    //基本拳法：    一级
    set_wugong( "taizu-quan",    90,     90,    1 );    //太祖长拳：    二级

    set_wugong( "staff",         90,     90,    0 );    //基础杖法：    一级
    set_wugong( "qimei-gun",     80,     80,    1 );    //齐眉棍法：    二级

    set_wugong( "jiben-qinggong",80,     80,    1 );    //基本轻功：    一级

    set_wugong( "sword",         90,     90,    1 );    //基本剑术：    一级

    set_wugong( "whip",          90,     90,    1 );    //鞭法基础：    一级

    set_wugong( "shaolin-xinfa", 15,     15,    1 );    //少林心法

    set_xiuwei_by_type( "blade",    370 );  //刀法修为：    二级
    set_xiuwei_by_type( "unarmed",  300 );  //拳脚修为：    一级
    set_xiuwei_by_type( "long",     300 );  //长兵刃修为：  一级
    set_xiuwei_by_type( "dodge",    150 );  //轻功修为：    一级
    set_xiuwei_by_type( "whip",     150 );  //鞭法修为：    一级
    set_xiuwei_by_type( "sword",    150 );  //剑术修为：    一级

    set( "max_force",   500 );              //内力：    500
    set( "force",       500 );
    set( "force_factor", 25 );              //加力：    25(5%)

    set_hp( "gin",      325 );              //生命、体能、精力：    325
    set_hp( "kee",      325 );
    set_hp( "sen",      325 );

    set( "combat_exp",  50000 );            //战斗经验：5万
    set( "social_exp",  5000 );             //江湖阅历：5000

    set( "inquiry", ([
        "练武"      :   "练武之人要能吃苦，吃得了苦才能练成好功夫！",
        "学功夫"    :   (: CanTeach :),
        "总镖头"    :   "咱们总镖头的武功，不是天下第一也差不多。",
        "skills"    :   (: tell_skills :),
        "wugong"    :   (: tell_skills :),
        "gongfu"    :   (: tell_skills :),
        "kungfu"    :   (: tell_skills :),
        "功夫"      :   (: tell_skills :),
        "武功"      :   (: tell_skills :),
    ]) );
    set( "talk_msg", ({
        "“练武之人要能吃苦，吃得了苦才能练成好功夫！”",
        "“咱们总镖头的武功，不是天下第一也差不多。”",
    }) );

    setup();
  
    carry_object( BLADE_DIR + "blade2" )->wield();      //单刀
    carry_object( CLOTH_DIR + "jinzhuang1" )->wear();   //黑色劲装
}

int valid_teach( object ppl, string skill )
{
    if ( !ppl->query( "marks/guard" ) )      //如果没有学功夫的标记
    {
        command( "say “你想学功夫？”" );
        return 0;
    }

    if ( !query_jibie( skill ) )
        return 0;

    if ( skill == "ditang-dao"              //高级的武功不给学
        || skill == "qimei-gun" 
        || skill == "taizu-quan" )
    {
        command( "say “这些功夫嘛，可就不是那么容易就能让你学的喽！”" );
        return 0;
    }
    return 1; 
}

int zhongcheng( object ppl, string skill )  //不检查忠诚度
{
    return 1;
}

int CanTeach()
{
    object ppl = this_player();

    if ( !ppl->query( "marks/guard" ) )       //没有记号则可以学功夫。
    {
        message_vision( "$N高兴地哈哈大笑起来，用力地拍了拍$n的肩膀。\n", 
            this_object(), ppl );
        command( "nod" );
        command( "say “既然你有心学，俺就教你些功夫罢了！”" );
        ppl->set( "marks/guard", 1 );       //可以学功夫的标记。
        LOG_D->do_log( ppl, "你在兰州镖局得到了李镖头的同意，暂时在镖局学习武"
            + "功。" );                     //加一个log记录。
        return 1;
     }
     command( "pat" + ppl->query( "id" ) );
     command( "say “要学就学吧，罗嗦什么？”" );
     return 1;
}

int tell_skills()
{
    object ppl = this_player();

    if ( !ppl->query( "marks/guard" ) )     //如果没有记号就不回答。
        return notify_fail( "李镖头不想回答你这个问题。\n" );

    message_vision( @TEXT
$N对$n说：“你可以学：
    横刀六式     〖blade〗
    基本轻功     〖jiben-qinggong〗
    少林心法     〖shaolin-xinfa〗
    基础杖法     〖staff〗
    基本剑术     〖sword〗
    基本拳法     〖unarmed〗
    鞭法基础     〖whip〗。”
TEXT
    , this_object(), ppl );

    return 1;
}



