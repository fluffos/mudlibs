//  梅老三：马倌，奸细，有秘密  /d/city/lanzhou/npc/ma_guan.c
//  等级：
//  【巳等】小门派的弟子，江湖闲汉
//          零级修为（      ０－  １００）一级武功（    ０－  ６０）
//          经验（        ０－  ７５００）声望（          ０－         ７５）
//  By lin
//  Changed by lala, 1998-03-28

#include "jianxi.h"

inherit NPC;

int AskHorse();
int AskBuyHorse();
int AskMoney();
int GiveHorse();

void create()
{
    set_name( "梅老三", 
        ({ "mei laosan", "mei", "laosan", "meilaosan", "stableman" }) );
    set( "title", "马倌" );
    set( "gender", "男性" );                //性别：男
    set( "age", 24 );                       //年龄：24
    set( "str", 26 );                       //臂力：26
    set( "per", 10 );                       //容貌：10
    set( "long", @LONG
    一个禁军中的小小士卒，被派到这里来看马。他尖头削背，看上去蛮机灵的。
LONG
    );
    
    set( "inquiry", ([
        "马"        :   (: AskHorse :),
        "买马"      :   (: AskBuyHorse :),
        "发财"      :   (: AskMoney :),
        "横财"      :   (: GiveHorse :),
    ]) );
    set( "chat_chance", 3 );
    set( "chat_msg", ({
        "马倌一边往石槽里添草一边叹气。\n",
        "马倌说：“唉！累了一整天也落不了个好！”\n",
        "马倌说：“什么时候我也能发笔财就好了！”\n",
    }) );

    setup();
    carry_object( CLOTH_DIR + "junfu" )->wear();
}

int AskHorse()
{
    object ppl = this_player();

    command( "say “这里的马都归我管。你想怎样？”" );
    ppl->set_temp( "marks/lanzhou/lala/BuyHorse", 1 );
    return 1;
}

int AskBuyHorse()
{
    object ppl = this_player();

    command( "say “嘿嘿，这个嘛……你也知道这些都是军马～～”" );
    switch( ppl->query_temp( "marks/lanzhou/lala/BuyHorse" ) )
    {
        case 0  :
            command( "say “这官家的东西，我可做不了主。”" );
            command( "shake" );
            break;
        case 1  :
            command( "say “归我管是归我管，可是我只管喂马，买马找我就找错人了"
                + "。”" );
            command( "xixi" );
            ppl->set_temp( "marks/lanzhou/lala/BuyHorse", 2 );
            break;
        case 2  :
            command( "say “我不是说过了吗？甭老问了，没用。”" );
            break;
        case 3  :
            command( "say “呵，看起来你也挺精明的嘛，不过……这个……”" );
            break;
        default :
            command( "say “行了行了，别老光说不练啊，我可没那么多工夫。”" );
    }
    return 1;
}

int AskMoney()
{
    object ppl = this_player();

    command( "say “这个谁不想啊，古话说：“马无夜草不肥！”" );
    switch( ppl->query_temp( "marks/lanzhou/lala/BuyHorse" ) )
    {
        case 0  :
        case 1  :
            command( "say “喝！你想打军马的主意呀！”" );
            command( "face" );
            break;
        case 2  :
            command( "think" );
            command( "say “你想打军马的主意？这要是让上头知道了，还了得！”" );
            ppl->set_temp( "marks/lanzhou/lala/BuyHorse", 3 );
            break;
        case 3  :
            command( "say “我不是说过了吗？甭老问了，没用。”" );
            break;
        default :
            command( "say “行了行了，别老光说不练啊，我可没那么多工夫。”" );
    }
    return 1;
}

int GiveHorse()
{
    object ppl = this_player();
    string ppl_id = ppl->query( "id" );

    switch( ppl->query_temp( "marks/lanzhou/lala/BuyHorse" ) )
    {
        case 0  :
        case 1  :
        case 2  :
            command( "say “这是哪儿和哪儿啊？”" );
            command( "?" );
            break;
        case 3  :
            command( "say “唔，你说得也有道理啊～～”" );
            command( "grin " + ppl_id );
            command( "whisper " + ppl_id 
                + " “看你也是个明白人，话就不用我多说了吧？”" );
            ppl->set_temp( "marks/lanzhou/lala/BuyHorse", 4 );
            break;
        default :
            command( "say “行了行了，别老光说不练啊，我可没那么多工夫。”" );
    }
    return 1;
}

int accept_object( object ppl, object obj )
{
    object horse, here = environment();

    if ( ( sizeof( all_inventory( here ) )  > 2 )       //如果有第三者在场，
        || ( here->query( "short" ) != "马厩" ) )       //或者此地不是马厩。
        return 0;
    if ( !obj->query( "value" )             //如果东西不值钱。
        && !obj->value() )
    {
        command( "say “我不是收破烂的！”" );
        return 0;
    }
    if ( ppl->query_temp( "marks/lanzhou/lala/BuyHorse" ) != 4 )  //如果此人没
    {                                       //得到买马的暗示。
        command( "say “呵呵，今天该我发财，有人白送东西给我……”" );
        remove_call_out( "Dest" );
        call_out( "Dest", 1, obj );
        return 1;
    }
    if ( !obj->value() )                    //如果东西不是钱。
    {
        command( "say “咱们还是现钱交易吧！”" );
        return 0;
    }
    if ( obj->value() < 30000 )             //如果钱少于30两白银。
    {
        command( "say “嘿！你也太狠了吧？这一匹马在集市上怎么也值四五十吊钱" 
            + "啊。”" );
        return 0;
    }

    horse = new( NPC_DIR + "horse1" );      //一匹最一般的马。
    horse->move( here );
    horse->set_leader( ppl );
    message_vision( name() + "四下看了看，然后小心地解开一匹$N的缰绳，交给$n"
        + "。\n", horse, ppl );
    call_out( "Dest", 1, obj );
    return 1;
}

void Dest( object obj )
{
    destruct( obj );
}

