//  小巷    /d/city/lanzhou/xiaoxiang.c
//  By Lin
//  Changed by Lala, 1998-03-20

#include <room.h>

inherit ROOM;

void create()
{
    set( "short", "小巷" );
    set( "long", @LONG
这里的小巷静悄悄的，两边都是深宅大院，墙高足有一丈，看不到里面有什
么。西面的小巷深处有一口水井。南边有一家私塾，却听不到朗朗的读书声。
    东边是热闹的南大街，不时传来一阵阵喧嚣声。
LONG
    );
    set( "outdoors", "lanzhou" );
    set( "item_desc", ([
        "south"     : "私塾的房门紧关着，不过外面并没有上锁。\n",
        "door"      : "私塾的房门紧关着，不过外面并没有上锁。\n",
        "私塾"      : "私塾的房门紧关着，不过外面并没有上锁。\n",
    ]) );
    set( "exits", ([
        "northwest" :   __DIR__"zhaimen",   //深宅大门
        "east"      :   __DIR__"nanjie2",   //南大街
        "south"     :   __DIR__"sishu",     //私塾
    ]) );
    create_door( "south", "木门", "north", DOOR_CLOSED );   //南面有木门

    setup();
}

void init()
{
    add_action( "do_che", "knock" );        //敲门的动作函数。
    add_action( "do_open", "open" );        //开门的动作函数。
}

int do_che( string arg )                    //敲门的动作函数。
{                                           //arg：敲的对象。
    object ppl = this_player();

    if ( !ppl->can_act() )
        return notify_fail( "你现在正忙着呢，怎么能开门？\n" );
    if ( arg == "door"
        || arg == "south" )
    {
        message_vision( @TEXT
$N走到私塾门前，轻轻地敲了敲门上锈迹斑斑的铜环。
只听门里传来走动的声音。一个人把门打开了，
门里的人对$N说：“请进请进！”
一位老儒生把$N请了进去。
TEXT
            , ppl );
        ppl->move( __DIR__"sishu" );
        message_vision( "老儒生在$N身后又把门关上了。\n", ppl );
        return 1;
    }
    write( "你要敲什么？\n" );
}

int do_open( string arg )                   //开门的动作函数。
{                                           //arg：开的对象。
     write( "这门是从屋子里锁上了的。\n");
     return 1;
}

