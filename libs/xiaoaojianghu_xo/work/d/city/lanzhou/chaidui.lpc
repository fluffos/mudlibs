//  龙门客栈柴堆内  /d/city/lanzhou/buzhuang.c
//  By lin
//  Changed by Lala, 1998-03-11

inherit ROOM;

void create()
{
    set( "short", "柴堆" );
    set( "long", @LONG
这是一个高大的柴禾堆，足可把一个人藏在里面；透过缝隙能看到外面发生
的事情。
LONG
    );
    set( "exits", ([
         "out"      :   __DIR__"houyuan",   //龙门客栈后院
    ]) );
    set( "objects", ([
         __DIR__"npc/ye_maozi"  :   1,      //夜猫子（人物）
    ]) );
    
    setup();
}

void welcome_visitor( object ppl )          //金湘玉和夜猫子的爱情故事之引子。
{
    object here = this_object();            //here：本地。

    if( !userp( ppl ) ) 
        return;

    if( ppl->query("marks/lin/兰州秘密A")   //已经发现秘密的不会有发展。
        || ppl->query_temp("marks/lin/兰州秘密A发现") ) 
        return;

    if ( !( object there = find_object( "/d/city/lanzhou/yazuo" ) ) )
        there = load_object( "/d/city/lanzhou/yazuo" );     //there：客栈雅座。
        
    jin = present( "jin xiangyu" , there ); //jin：金湘玉。                 
    
    if ( sizeof( all_inventory( here ) )  > 2 ) 
        return;                             //如果此地除玩家和夜猫子外还有第三
                                            //者，那么故事没有发展。
    
    if ( ppl->query("age") < 22             //如果过于年轻（２２岁以下）或者岁
        || ppl->query("age") > 40 )         //数太大（４０以上）而令人不可信任
        return;                             //的话，没有发展。
                                            //嘴上无毛，办事不牢；
                                            //老奸巨滑，不可不防。

    if ( ppl->query( "gender" ) == "女性"   //如果是年轻女性（在１８～３３岁之
        && ppl->query( "age" ) > 18         //间），则没有发展。
        && ppl->query( "age" ) < 33 )       //金湘玉天生嫉妒。
        return;
    
    if ( ppl->query( "kar" ) == 20 )        //福缘为２０则没有发展。
        return;                             //此规定没道理。    

    if( objectp( present( "jin xiangyu", here ) )       //如果本地已经有金湘玉
        || !objectp( present( "ye maozi", here ) ) )    //或没有夜猫子，则没有
        return;                                         //发展。

    if( objectp( jin )                      //如果金湘玉处于空闲状态，那么挪到
        && jin->can_act() )                 //本地。引子结束。后续部分在金湘玉
    {                                       //身上。
        tell_room( there, jin->name() + 
            "瞅着众人都不注意的空儿，悄悄下楼去了。\n");
        jin->move( here );
    }
}

