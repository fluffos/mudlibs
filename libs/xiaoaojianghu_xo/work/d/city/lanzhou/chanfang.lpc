#include <room.h>

inherit ROOM;

void create() {
  set("short", "禅房");
  set("long", @LONG
这里是佛光寺僧侣居住的地方，屋里只有一通大炕，几个蒲团，一张矮桌，
打扫得干干净净。
LONG
  );
  set("sleep_room", "inn");
  set("exits", ([
    "out": __DIR__ "foguang_ge",  //佛光阁
  ]));
  set("search_things", ([
    "大炕": __DIR__ "obj/jiu",   //大炕里面有烧酒。
    "矮桌": __DIR__ "obj/gourou",  //矮桌里面有狗肉。
  ]));
  create_door("out", "木门", "in", DOOR_CLOSED);    //木门通向佛光阁。

  setup();
}
