inherit ROOM;

void create()
{
    set( "short", "群红院" );
    set( "long", @LONG
这里是兰州最有名的一家妓院，原本华丽无比。不过最近边境军事紧迫，州
府下令严禁优娼事务，因此这里一下子就冷清了。不知道什么时候才会再兴旺起
来。
LONG
    );
    set( "exits", ([
        "east"      :   __DIR__"nanjie1",   //南大街
    ]) );

    setup();
}

