
inherit ROOM;

void create()
{
    set("short", "大理石场");
    set("long", @LONG
这里是一家采石场，远远的就听到了里面叮叮当当的打石声，这个石场生意很好
来来往往运石头的马车络绎不绝。传说很古很古的时候，这里曾经来过一位酷爱山光
水色的仙女，看到大理风光如画，就把这些山水都画进一块块石头里面去了，这就是
有名的大理石。在这个石场的前面有一块牌子，牌子周围站着不少腰大膀圆的壮汉在
小声聊着什么。
LONG
);
    set("detail", ([
                    "牌子" : @TEXT
牌子上面写着：
           
        本石场招收大量石工，报酬优厚。
        
TEXT
,
                ]) );
    set("exits", ([
                "south" : __DIR__"dali_yidao",
                ]) );
    set("objects", ([
            __DIR__"npc/boss" : 1,
            __DIR__"npc/worker" : 3,
            ]) );
    set("outdoors","matou");                             
    setup();                                             
}                                                        

void init()
{
    add_action("do_work","work");
}

int do_work( string arg )
{
    object me;
    me = this_player();
    
    if( !present( "lao ban",environment(me) ) )
    return notify_fail("现在老板不在，过一会再来吧。\n");        

    if( me->query("gender") == "女性" )
    return notify_fail("老板摇摇头，“对不起，我们不收女工。”\n");
    
    if( me->query_temp("mask/working") )
    return notify_fail("你已经在工作了。\n");

    if( me->query("age") < 16 )
        return notify_fail("老板看了看你，说：“小孩子凑什么热闹？！去去！”\n");

    if( me->query("sen") < 150 || me->query("gin") < 50 )
    return notify_fail("老板见你一付无精打采的样子，摇摇头说：“我看你还是"
                        "回去歇着吧。”\n");

    if( query_temp_marks("worktimes") >= 10 )
    {
        message_vision("石场老板拍拍$N的肩膀，叹了口气说：“明天再来吧。\n"
                        "今天的石工已经招够了。”\n", me);                
        return 1;
    }
    message_vision("石场老板笑道：“太好了，我们正需要你这样的好帮手呢。你\n"
                    "这就下去干活吧。”\n"
                    "$N拿起工具就埋头敲起石头来.....\n", me );
    add_temp_marks( "worktimes", 1 );
    me->disable_command("verb", "你正在干活呢。");
    call_out("do_pay",7,me);
    return 1;
}

void do_pay( object me )
{
    object coin;
    me->receive_damage("sen",150);
    me->receive_damage("gin",50);
    me->enable_path();

    message_vision("$N终于结束了自己的工作，长长舒了一口气，站了起来，长叹道：“\n"
                    "唉，太累了，这活真不是人干的。”\n", me);                     
    me->delete_temp("mask/working");
                    
    if( !present( "lao ban", environment(me) ))
    message_vision("$N正要跟石场老板要报酬的时候却发现他已经不见了，气得大骂：“\n"
                    "该死的老板怎么能这么欺骗我们呢？我一定要把他找回来！”\n"
                    "最后$N只得垂头丧气地说：“唉，又上当了。”\n", me);            
    else 
    {
        message_vision("老板对$N点点头，“干得还不错，这点钱你就拿去吧，以后要有空\n"
                    "再来干活啊！”\n", me);
        coin = new(MONEY_DIR + "coin");
        coin->set_amount(100);
        coin->move(me);
    }
}
