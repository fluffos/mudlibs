
inherit NPC;

void create()
{
        set_name("石场老板", ({"lao ban", "boss" }) );
        set("gender", "男性" );
        set("age", 45);
        set("str",40);
        set("long", "这是一位看起来很是狡猾的石场老板。\n");
        set("combat_exp", 50000);      
        set("max_kee", 400);
        set("kee", 400);
        set("attitude", "friendly");
            set_wugong("unarmed",100,100,1);
        set_wugong("jiben-qinggong",100,100,1);
        set_xiuwei("unarmed", 300);
                setup();
            carry_object(__DIR__"obj/cloth2")->wear();
}

