// 镖局的镖头 /d/city/chuzhou/npc/lin_tianhao.c
// by lala, 1997-12-23

#include <ansi.h>

inherit NPC;

void create()
{
    set_name( "林天豪", ({ "lin tianhao", "lin", "tianhao", }) );
    set( "title", REV BBLU WHT"扬威镖局"YEL"镖  师"NOR );
    set( "gender", "男性" );
    set( "age", 35 );
    set( "long", @LONG
林天保是林总镖头的次子，自幼和父亲学武，也是一身的好功夫。现在也帮爹爹
赚钱养家。
LONG
    );
    set( "attitude", "friendly" );
    set( "talk_msg",({
    }));
    set("kee",400);
    set("max_kee",400);
    set("eff_kee",400);
    set("sen",400);
    set("max_sen",400);
    set("eff_sen",400);
    set("max_force", 1600);
    set("force",     1600);
    set("force_factor", 20);
    set("combat_exp", 10000);
    set("social_exp", 10000);
    set("positive_score", 3000);
    set("negative_score",  800);

    set_wugong("fenglei-dao",    60, 60, 1);
    set_wugong("feiyan-zoubi",   60, 60, 1);            
    set_xiuwei_by_type("blade", 600);
    set_xiuwei_by_type("dodge", 600);
 
    setup();
      
    carry_object( CLOTH_DIR + "cloth5")->wear();
    carry_object( BLADE_DIR + "blade")->wield();        
}          

int accept_object( object me, object ob )
{
    object this = this_object();  
 
    if ( this->query_temp( "is_duilianing" ) )
    {
        command( "say “呵呵，等一会我练完了就来。”" );
        return 0;
    }
    if ( ob->value() < 5000 )
    {
        command( "say “你弄错了吧？请看看那里的牌子。”" );
        return 0;
    }
    command( "say “哦，好吧，那在下就和你对练一场。献丑了！”");
    call_out( "do_duilian", 1, me, this );
    call_out( "end_duilian", 1800, me, this );
    return 1;
}

void do_duilian( object me, object this )
{
    if ( !present( me, environment() ) )        
    {
        remove_call_out( "end_duilian" );
        return;
    }
    message_vision( CYN @LONG

$N对$n深施一礼：“领教壮士的高招！”

$n对$N还了一礼：“领教了！”

LONG
    NOR, me, this );
    me->duilian_ob( this );
    this->duilian_ob( me );
    this->set_temp( "is_duilianing" );
    return;
}

void end_duilian( object me, object this )
{
    this->delete_temp( "is_duilianing" );
    command( "stop" );
    this->set( "sen", this->query( "max_sen" ) );
    return;
}
        
