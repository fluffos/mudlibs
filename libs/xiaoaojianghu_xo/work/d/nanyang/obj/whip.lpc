// the common weapon:whip.c
// modified by Lin on March 29 ,1997
// common 市卖物品：武器。：鞭子.
#include <ansi.h>
#include <weapon.h>

inherit WHIP;

void create() {
  set_name("皮鞭", ({ "pi bian", "whip" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一条四尺来长，普普通通的牛皮鞭子。\n");
    set("unit", "条");
    set("value", 60);
    set("material", "skin");
  }
  init_whip(5);

  set("wield_msg", "$N从腰间解下一条$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n束在腰间。\n");

  setup();
}
