// guo.c

#include <ansi.h>

string *refuse_msg = ({
        "过彦之说：“现在没什么事做，你可以去练功了。”\n",
           });

inherit NPC;

string help_me(object me);

void create()
{
    set_name("过彦之", ({ "guo yanzhi","guo" }) );
    set("gender", "男性" );
    set("age", 34);
    set("str", 30);
    set("cor", 30);
    set("cps", 30);
    set("int", 25);
    set("ker", 24);
    set("kar", 30);
    set("dex",30);
    set("max_force", 1500);
    set("force", 1500);
    set("force_factor", 3);
    set("inquiry",([
          "暂住" : (: help_me :),
          "住"   : (: help_me :),
          "帮助" : (: help_me :),
          "help" : (: help_me :),   
    ]));
    create_family("伏牛派", 2,  "弟子" );

    set("combat_exp", 40000);
    set("social_exp", 20000);
    set("positive_score",5000);

        seteuid( getuid() );
    set_wugong("kuangfeng-bian",30,30,1);
    set_xiuwei("whip",120);        
    set_wugong("taizu-quan",70,70,1);
    set_xiuwei("unarmed",120);
    set_wugong("whip",70,80,0);
    setup();
    carry_object(__DIR__"obj/qlwhip")->wield();
    carry_object("obj/cloth5")->wear();
}

string help_me(object me)
{
    me = this_player();
       
    if ( me->query("family/family_name") == "伏牛派" )
    {
        me->add("class_score",-1);
        return ("过彦之气鼓鼓地说道：“这就是你的家了，倒什么乱！?”\n");
    }
    if ( me->query_temp("lin_marks/暂住") )
    {
        return("过彦之说道：“阁下不是已经住下了么？莫非阁下的头脑出了什么问题？”\n");
        // 能执行到这里吗?
        command("haha "+me->query("id"));
    }
    if ( !me->query("family/family_name") )
    {
        if ( me->query("age") > 15 )
            return (
"过彦之说：“看你也老大不小的了，却还是什么也不会，这辈子还是别进练武这一行了吧!!”\n");
        else
            return (
"过彦之说：“小孩子懂得什么，还是先拜入我伏牛派吧。”\n");
    }
    if ( me->query("pks") > 10 )
        return (
"过彦之说：“阁下身上的人命官司太多了，敝派薄土陋地，恐怕接纳不了。”\n");
       
    message_vision("过彦之冲着$N笑了笑，说道：“既然阁下瞧得起柯府，我们自当尽力相待。\n",me);
    me->set_temp("lin_marks/暂住",1);
    return ("过彦之同意你在柯府暂住了。\n");
}

int recognize_apprentice(object me)
{
    me = this_player();
    if ( !me->query("family/family_name") ||
         me->query("family/family_name") != "伏牛派" )
    {
        return 0;
    }
    return 1;

    /* 我看写糊涂了吧, 下面肯定是的啦. :-)
    else
    {
        if ( me->query("family/family_name") == "伏牛派")
            return 1;
    }
    */
}

void init()
{
    add_action("do_quest","quest");
}

int do_quest(object me,object ob)
{
    int s_exp,c_score;

    me = this_player();
    ob = this_object();
    s_exp = me->query("social_exp");
    c_score= me->query("class_score");
    if ( me->query("family/family_name") == "伏牛派" )
    {   
        if ( me->query("funiu_marks/") )
        {
            message_vision(
ob->query("name")+"对$N说：“让你干的事情不是还没有干完呢吗？”\n",me);
//                tell_object(me,
//"你现在应该去干以下的事：\n"+me->query("funiu_marks/")+"");
            return 1;
        }

        if ( me->query_condition("funiu_quest_penalty") )
        {
            message_vision(
ob->query("name")+"不耐烦地对$N挥了挥手：“这没有什么事，你去吧。”\n",me);
            return 1;
        }

        if ( c_score < 0 )
        {
            me->set("class_score",0);
            me->apply_condition("funiu_quest_penalty",30);
            message_vision(
ob->query("name")+"看了看$N,显然是有些不耐烦地说：“没什么事了，干你的去吧。”\n",me);
            return 1;
        }

        if ( c_score < 100 )
        {
            switch( random(3) )
            {
            case 0:
                message_vision(refuse_msg[random(sizeof(refuse_msg))],ob);
                return 1;
                // 既然 return 了, 再 break 就没有意义了.
                //break;

            case 1:
                message_vision(refuse_msg[random(sizeof(refuse_msg))],ob);
                return 1;

            case 2:
                message_vision( ob->query("name") +
                    "对$N说：“你去厨房帮帮忙吧。”\n", me );
                me->set("funiu_marks/帮厨",1);
                return 1;
            }
        }
    }
    if ( me->query_temp("lin_marks/暂住") )
    {
    }
    else
        return notify_fail( ob->query("name") +
            "对你笑了笑，说：“" + RANK_D->query_respect(me) +
            "，你这是什么意思呐？”\n" );
}