// waiter.cr.c
#include <ansi.h>

inherit NPC;
inherit F_VENDOR;
void create()
{
        set_name("樊子发", ({ "fan zifa","fan","seller"}) );
        set("gender", "男性" );
        set("age", 46);
        set("long",
          "樊子发是这间小商号的老板，写得一手好字，总是被柯府请去写东西.\n"
        );
        set("talk_msg",({
            "这里是南阳城",
            "柯府老爷为民除害，大家都感恩待德呀！",
            "南阳城北接中原，南渡汉水，客官想去哪里呀？",
            "伏牛山上有一伙强盗，经常下山为害百姓。",
            
        }));
        set("chat_chance_combat", 20);
        set("chat_msg_combat",({
                "樊子发喊道：'你干什么？如此无理？！！！'\n",
                "樊子发边打边喊：'我可是柯府的红人，你竟敢杀我？！！！'\n",
        }) );
        set("inquiry", ([
                "伏牛派" : "伏牛派在这里可是大大的有名，全仗着柯老太爷的威风，伏牛山上那群\n"
+"强盗才不敢轻举妄动。客官要找柯府，出门向东就是了。",
                "here"   : "这里是南阳城，南阳诸葛祠，天下闻名耶！",
                
        ]) );
        set("attitude", "friendly");
        set("rank_info/respect", "老哥");
        set("rank_info/rude","老王八蛋");
        set("vendor_goods", ([
                "折扇": __DIR__"obj/zheshan",
                "银耳": __DIR__"obj/yiner",
                "燕窝" : __DIR__"obj/yanwo",
                "老山人参" : __DIR__"obj/shanshen",
                "虎骨" : __DIR__"obj/hugu",
        ]) );
        set("positive_score",10);
        set("combat_exp",100);
        set("social_exp",100);
        set_xiuwei_by_type("unarmed",50);
        setup();
        carry_object(__DIR__"obj/cloth4")->wear();

}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}
void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        message_vision("樊老板笑嘻嘻地迎上前来，说道：“客官，您来啦？！。”\n",ob);
        
}
