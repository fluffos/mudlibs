// ke.c
#include <ansi.h>

inherit __DIR__"funiu";
inherit F_MASTER;
//inherit NPC;
string leave_funiu(object me);
void create()
{
        set_name("柯百岁", ({ "ke baisui","ke" }) );
    set("gender", "男性" );
    set("age", 71);
    set("str", 30);
    set("cor", 30);
    set("cps", 30);
    set("int", 25);
    set("ker", 24);
    set("kar", 30);
    set("dex",30);
    set("max_force", 1500);
    set("force", 1500);
    set("force_factor", 3);
    set("inquiry",([
        "离开师门" : (:leave_funiu :),
    ]));
    create_family("伏牛派", 1, HIW "掌门人" NOR);
    set("no_kill","funiu");
    set("combat_exp", 100000);
    set("social_exp", 800000);
    set("positive_score",50000);
    set_wugong("whip",150,150,0);
//    set_wugong("kuangf-bian",120,140);
    set_wugong("baisheng-bian",130,120,1);
    set_xiuwei_by_type("whip",1900);
    set_wugong("unarmed",100,100,0);
//    set_wugong("taizu-quan",100,120,0);
//    set_wugong("zhuifeng-quan",120,120,1);
    set_xiuwei_by_type("unarmed",650);
//    set_wugong("shaolin-xinfa",40,40,1);
//    set_wugong("ke-xinfa",110,110,1);
//    set_wugong("qinggong",110,110);
//    set_wugong("xingyun-shenfa",100,100);
//    set_wugong("feiyan-gong",80,80,1);
    set_xiuwei_by_type("dodge",650);
    setup();

    carry_object(__DIR__"obj/goldwhip")->wield();
//    carry_object(CLOTH_DIR"cloth5")->wear();
}

void init()
{
    object me = this_player();
    ::init();
    delete("family/master_id");
    delete("family/master_name");
    call_out("varify_class_score",1,me);
}
void varify_class_score(object me)
{
    if( !me || environment(me) != environment(this_object() ) )
        return;
    if( me->query("family/family_name") != "伏牛派" )
        return;
    if( me->query("class_score/伏牛派") < -20 )
    {
        command("heng " + me->query("id"));
        message_vision("柯百岁对$N怒气冲冲地说道:'你目无尊长,干下如此多伤害同门?!\n"
"之事,竟然还有胆子来见我???!!\n",me);
        kill_ob(me);
        me->fight_ob(this_object());
    }
}
void attempt_apprentice(object ob)
{
    if( ob->query("marks/left_funiu") )
    {
        message_vision("柯百岁对$N笑了笑:'你既然已经离开我派,怎么又回来啦?/n",ob);
        return;
    }
    if ( ob->query("pks") > 30 )
    {
        message_vision(
"柯百岁对$N说：“阁下在江湖上劣迹已经出了名了，老夫断乎不会收下您这样\n"
+"的人物!!!!\n",ob);
        command("heng "+ob->query("id"));
        return;
    }
    if ( ob->query("combat_exp") > 30000 || ob->query("social_exp") > 5000 )
    {
        message_vision(
"柯百岁对$N笑了笑，说：“阁下有一身非凡的武艺，我怎敢收您为徒？”\n",ob);
        return;
    }
    else
    {
            message_vision("柯百岁高兴对$N笑了笑，说：很好很好。\n",this_player());
        command("recruit " + this_player()->query("id") );
        return;
    }
}

int valid_teach(object me,string skill)
{
    if( skill == "baisheng-bian" )
        if( me->query("class_score/伏牛派") < ( me->query_lingwu("baisheng-bian") * 5 + 500 ) )
        {
            command("hmm");
            message_vision(
            "只见柯百岁看了$N一眼，摇了摇头，说道：“你虽是我门下的弟子，不过......\n"
            "你还是先学习狂风鞭法和追风拳吧。”\n",me);
            if( me->query_temp("marks/lin/伏牛百胜") )
                me->add("class_score/伏牛派",-1);
            me->set_temp("marks/lin/伏牛百胜",1);
            return notify_fail("\n");
        }
    if ( me->query_xiuwei_by_type("whip") < 300 )
    {
        write("柯百岁说：“你的鞭法基本功还不够熟练哪”\n");
        return notify_fail("看来柯百岁并不愿意教你。\n");
    }
    return ::valid_teach(me,skill);
}
string leave_funiu(object me)
{
    object ob;
    me = this_player();
    if( me->query("family/family_name") != "伏牛派" )
    {
        message_vision("柯百岁笑呵呵地对$N说:'你既非我之徒,何有此问呢?'\n",me);
        return " ";
    }
    if( me->query_jibie("baisheng-bian") < 20 )
    {
        if( me->query_jibie("kuangf-bian") < 80 || me->query_jibie("zhuifeng-quan") < 50 )
        {
            me->add("class_score/伏牛派",-10);
            message_vision("柯百岁冷冷地瞪了$N一眼,说:'你的功夫还学得很不够,就想走了?'\n",me);
            return "你还得练练本门的功夫再说吧。\n";
        }
        else if( me->query("age") < 20 )
        {
            message_vision("柯百岁对$N笑了笑,说:'你的年纪太小,先不要急着闯荡江湖嘛.'\n",me);
            return "过两年再说吧。\n";
        }
        else
        {
            message_vision("柯百岁看了看$N,叹了口气,说:'既是这样,我也就不久留你了,但愿你能再找到更好的师傅\n"
		"到时候,可不要忘记为师啊,呵呵.'\n",me);
            message_vision("柯百岁拿出一些银子交给$N,说:'这些银两,你带着路上用吧,算是为师的一点礼物.\n",me);
            ob = new(MONEY_DIR"silver");
            ob->set_amount(100);
            ob->move(me);
            message_vision("$N向师傅恭恭敬敬地磕了四个头,就此离开伏牛派,去闯荡江湖了.\n",me);
            me->delete("family");
            me->set("marks/left_funiu",1);
        }
    }
    else
    {
       me->add("class_score/伏牛派",-50);
       message_vision("柯百岁冷冷地对$N说:'要想离开,就先打过我再说吧.'/n",me);
    }
    return "";
}
int refuse_killing(object me)
{
    if ( me->query("family/family_name") == "伏牛派" )
    {
        me->set("class_score/伏牛派",-300);
        message_vision("柯百岁愤怒地对$N喝了一声，道：“老夫收徒四十余年，还没有见过你这样的叛逆！！！\n",me);
        CRIME_D->set_crime( me, "funiu" );
    }
    message_vision("柯百岁镇静地看了看$N，说：“阁下进招吧！今天老夫就用这条老命陪阁下玩玩儿！！\n",me);
    this_object()->set("force_factor",50);

    return 0;
}