#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "老鸦岭");
  set("long", @LONG
一条山梁在脚下拐向东去，南边下山是一条黑黝黝的深谷，谷中风声森然。
头上顶着茂密的枝叶，阳光稀疏地撒在地上，不时有一群乌鸦在树林中出没，叫
声此起彼伏。
LONG);
  set("exits", ([
    "east": __DIR__ "qingsong",
    "southdown": __DIR__ "heifeng",
  ]));
  set("outdoors", "nanyang");
  setup();
}
