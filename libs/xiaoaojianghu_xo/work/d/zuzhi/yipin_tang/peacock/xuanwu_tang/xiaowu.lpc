// /xuanwu/xiaowu.c
inherit ROOM;

void create()
{
    set("short", "小茅屋");
    set("long", @LONG
一间简陋的小茅屋，墙上不少地方的黄泥已经剥落下来了，露出了夹在里面
的高粱竿子。屋里基本上没有什么象样的家具，只是在北墙上靠着的一个木制碗
橱做工还算精细，用料也颇为考究。看来这是这家唯一值钱点的东西了。
LONG );
    set("exits", ([
        "south" :   __DIR__ "cunkou",
        ]) );
    setup();
}

void init()
{
    add_action("do_push","push");
}

void open_exit()
{
    message("vision", @TEXT
只听得一阵几不可闻的轻响，靠着北墙的柜子向右边滑开，露出一道
通向下面的台阶。
TEXT , this_object());
    set("exits/down", __DIR__"midao");
}

void close_exit()
{
    message("vision", @TEXT
柜子滑回原处，将密道挡住。
TEXT , this_object());
    delete( "exits/down" );
}

int do_push()
{
    object me = this_player(), room = load_object( __DIR__"midao" );

    if ( !arg || arg=="" ) return notify_fail( "你想转动什么？\n" );
    if ( ( arg != "cupboard" ) && ( arg != "碗橱" ) && ( arg != "橱") )
        return 0;

    if ( query("exits/up") )
    {
//        message_vision("$N走到最南端的油灯旁，将灯座向右转了半圈。\n", me);
        close_exit();
        room->close_exit();
    }
    else
    {
//        message_vision("$N走到最南端的油灯旁，将灯座向左转了半圈。\n", me);
        open_exit();
        room->open_exit();
    }
    return 1;
}

