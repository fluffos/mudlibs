// Room: /xuanwu/wuchang1.c

inherit ROOM;

void create()
{
    set("short", "练武场");
    set("long", @LONG
爬上山顶，眼前顿时一阔。数百块平平整整的大青石铺在峰顶。
场边站立着两排卫士，正对着场中打得不可开交的一对指指点点。在
这开阔的地形上，本来就猛烈的山风无遮无挡，更加肆虐起来，吹得
人立脚不住。山顶不时有薄雾飘过，刀光剑气，闪耀其间。让人疑是
天外飞仙正在争斗。
LONG
    );
    set("exits", ([ /* sizeof() == 4 */
        "west"  : __DIR__"wuchang2",
        "east"  : __DIR__"xiuxi_shi3",
        "south" : __DIR__"wuchang3",
        "northdown" : __DIR__"shanlu",
    ]));
    set("objects", ([
        __DIR__"npc/helianchunshui" : 1,
        __DIR__"npc/tuzhong1"       : 2,
    ]) );
    set("outdoors","xuanwu");
    set("no_clean_up", 0);

    setup();
}

