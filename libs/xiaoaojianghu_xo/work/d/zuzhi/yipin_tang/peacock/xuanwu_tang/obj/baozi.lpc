// modify by peacock

inherit ITEM;
inherit F_FOOD;

void create()
{
    set_name("包子", ({ "bao zi","baozi" }));

    set_weight(150);
    set("long", "一屉热气腾腾的肉包子。\n");
    set("unit", "屉");
    set("food_remaining", 7);
    set("food_supply", 25);//正常饭量的人一顿吃二斤。
    set("eat_msg", "$N抓起一个包子吃了起来。\n");
    set("end_msg", "$N刚把最后一个包子送进嘴里，就有一个青衣童子走了过来，把空了的笼屉收走了。\n");
    set("no_get","吃就是了，你还想兜着走吗？");
}

int is_food_of_xuanwu()
{
    return 1;
}
