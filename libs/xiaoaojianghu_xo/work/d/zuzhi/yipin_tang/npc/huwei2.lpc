#include <ansi.h>
#include "weishi.h"

inherit NPC;

void create() {
  set_name(CYN "银甲护卫" NOR, ({ "hu wei", "wei" }));
  set("title", CYN "一品堂总堂" NOR);
  set("age", 20 + random(10));
  set("gender", "男性");
  set_wugong("chusuifeng", 60 + random(30), 60 + random(30), 1);
  set_wugong("damo-jian", 60 + random(30), 60 + random(20), 1);
  set_xiuwei_by_type("dodge", 600);
  set_xiuwei_by_type("sword", 600);
  set("combat_exp", 30000);
  JoinZuzhi("yipin", "指挥使", "玄阳堂");
  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 10);
  setup();
  carry_object(__DIR__ "obj/cloth2")->wear();
  carry_object(__DIR__ "obj/jian1")->wield();
}
