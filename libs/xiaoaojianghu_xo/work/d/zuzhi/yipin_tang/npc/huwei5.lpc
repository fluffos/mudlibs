// by lnwm 97-09-12

#include <ansi.h>

inherit NPC;

void create()
{
        set_name(GRN"护卫"NOR, ({ "hu wei","wei"}));
    set("title",GRN"一品堂总堂"NOR);
    set("age", 20+random(10));
    set("gender", "男性");
    set_wugong("chusuifeng",60,60,1);
        set_wugong("wuhu-dao",80,80,1);
    set_xiuwei_by_type("dodge",600);
        set_xiuwei_by_type("blade",600);
    set("combat_exp", 30000);
        JoinZuzhi("yipin","指挥使","玄阳堂");    
        set("force",1000);
        set("max_force",1000);
        set("force_factor",10);
    setup(); 
    carry_object(__DIR__"obj/cloth2")->wear();
    carry_object(__DIR__"obj/blade2")->wield();   
}

void init()
{
    object ob,me;
    ob = this_object();
    me = this_player();
    
    if (  ob->can_act() && me->query_condition("kill_yipin") );
    {
        remove_call_out("kill"); 
        call_out("kill",1,me);
    }
    if( ob->query("lnwm/have_followed") ) return;
    else
    {
        ob->set("lnwm/have_followed",1);
        call_out("leave",300,ob);
    }
    return;
} 

int kill( object me )
{
    this_object()->kill_ob( me );
    me->fight_ob( this_object() );
    return 1;
}

int leave( object ob )
{
    message_vision("护卫离开了。\n", ob);
    destruct( ob );
    return 1; 
}

