#include <weapon.h>
#include <ansi.h>

inherit BLADE;

void create()
{
        set_name("腰刀", ({ "yao dao", "dao", "blade"}) );
        set_weight(1500);
        set("long","一把腰刀，刀身极薄. \n");
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("value", 100);
                set("material", "iron");
        }
        init_blade(10);
        set("wield_msg", "$N抽出一把$n握在手中。\n");
        set("unwield_msg", "$N将手中的$n插入腰间的剑鞘。\n");
        setup();
}

