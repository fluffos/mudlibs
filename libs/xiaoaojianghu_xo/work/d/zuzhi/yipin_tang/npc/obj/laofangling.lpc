// laofangling.c
// 牢房腰牌
// By lnwm 

#include <ansi.h>
inherit ITEM;

void create() {
  set_name("牢房腰牌", ({ "laofang yaopai", "yaopai" }));
  set_weight(250);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一块出入牢房的许可证。\n");
    set("unit", "块");
    set("material", "bamboo");
  }
  setup();
}
