// by lnwm 97-09-12

#include <ansi.h>

inherit NPC;

void create()
{
        set_name("花匠", ({ "hua jiang","jiang"}));
    set("title","一品堂杂役");
    set("age", 30+random(10));
    set("gender", "男性");
    set_wugong("blade",40+random(50),40+random(50),1);
        set_xiuwei_by_type("blade",200 );
    set("combat_exp", 10000);
   
        set("force",1000);
        set("max_force",1000);
        set("force_factor",10);
    setup(); 
    carry_object(CLOTH_DIR"cloth1")->wear();
} 

void init()
{
        object me, dao;
        me = this_player();
        if ( me->query_condition("kill_yipin") )
        {
                set("force_factor",30);
                set_xiuwei_by_type("dodge", 400 );
        set_xiuwei_by_type("blade", 600 );
        set_wugong("wuhu-dao",100,90,1);
        set_wugong("feiyan-zoubi",100,100,1);
        dao=new( __DIR__ "obj/blade1");
        dao->move( this_object() );
        command("wield blade");
        kill_ob(me);
        me->fight_ob( this_object() );// by lin
        }
    return;
}

