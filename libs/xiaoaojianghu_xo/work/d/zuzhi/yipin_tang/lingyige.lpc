#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "零一阁");
        set("long", @LONG
和飞鸟阁对称的位置也有一个同样的阁楼。形状样式方面都非常相似，也是
唐时所建。一品堂将这里占据后就大兴土木，所以虽然名义上这里和飞鸟阁一样
是唐的工匠的杰作，但实际上一品堂已经对这里进行过无数的改造和重修，除样
式外，这里没有一块砖瓦是唐代的了。不过话虽如此，零一阁依然修得十分古朴
，同样也有四个飘飘欲飞的尖角，仿佛欲飞的大雁。
LONG
        );
        set("exits", ([ /* sizeof() == 1 */
                "south" : __DIR__"houhuayuan1",
        ]));    

        setup();
}

void init()
{
    add_action("do_open", ({"tui","推","push"}) );
}

int do_open( string arg )
{
    object me;
    me = this_player();

    if ( !arg || arg =="")
    {
        tell_object(me,"你要推哪边的柱子？\n");
        return 1;
    }
    
    if ( arg != "东" && arg != "east" && arg != "西" && arg != "west"
         && arg !="南" && arg != "south" && arg != "北" && arg != "north" )
    {
        tell_object(me,"这里只有四根柱子，分别在东西南北四个方向上。\n");
        return 1;
    } 
    
    if ( !me->query_temp("lnwm/enter_yipin/中") )
    {
        tell_object( me,"你试着推了推柱子，没有任何反应。\n");
        return 1;
    }
    
    if ( ( arg != me->query_temp("lnwm/enter_yipin/中") ) &&
           ( arg != me->query_temp("lnwm/enter_yipin/英") ) )
    {
        tell_object( me,"你推了推柱子，没有什么反应。\n");
        me->delete_temp("lnwm/enter_yipin");
        return 1;
    }
    
    tell_object(me,"你忽然听到一阵机关的轻响，你只觉脚下一软，一道翻板在你脚下打开。\n");
    tell_object(me,"接着你就滑进了一个密道之中。\n");
    me->delete_temp("lnwm/enter_yipin");
    me->move(__DIR__ "dixia/rukou");
    return 1;
}

