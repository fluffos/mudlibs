#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "武器库");
        set("long", @LONG
这里是玄阳坛的武器库。屋子很大，但是放满了各种各样的武器。靠墙边放
了一具兵器袈，江湖上常见的各种兵器如：刀、枪、剑、戟、棍···等等，在
这儿你都能找得到，还有诸如仙人掌、神龙剑等不常用的兵器，以及江湖上已经
禁用的暴雨犁花针等等暗器。你一进来，禁不住眼花缭乱，不知道该选什么好。
    如果得到允许，你可以在这里领(ling)你需要的武器。
LONG
        );

        set("exits", ([ /* sizeof() == 1 */
            "southwest" : __DIR__"midao8",
        ]));      

        set("objects", ([
                __DIR__"npc/weishi3_1": 1,
        ]));
        setup();
}

void init()
{
    object ob, me;
    ob = this_object();
    me = this_player();
          
    if ( me->IsMemberOf("yipin")) return;   

    if(!objectp(present("wei shi", environment(me)))) return;    
    tell_object( me, RED"卫士瞪了你一眼，喝道:你来这儿干什么？\n"NOR); 
    remove_call_out("act_one");
    call_out("act_one",1, me);
}

void act_one(object me)
{
    if(objectp(present("wei shi", environment(me)))) 
    { 
    tell_object( me, RED"卫士看势不妙，回身拉了一下一根绳,顿时警铃大作.\n"NOR);
    remove_call_out("act_two");
    call_out("act_two",1, me);
    }
}

void act_two(object me)
{
     tell_object( me, RED"洞口的断龙石慢慢落下，一阵白雾涌来，你开始神志模糊.\n"NOR);
     me->unconcious(); 
     me->move(__DIR__"laofang3");         
}
