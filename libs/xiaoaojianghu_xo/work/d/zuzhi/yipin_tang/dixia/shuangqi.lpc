inherit SKILL;

mapping *action = ({
  ([ "action": "$N剑身平指，一招「顺流直下」，手中$w挽了一个剑花，如长江三
                 峡中一叶扁舟，以万均之势刺向$n胸口",
    "lian": "$N手中$w平平刺出，虽说毫无花哨，却如离弦之箭，挟有万均之势，
                 这正是一招「顺流直下」。",
    "sen": 3,
    "jibie": 5,
    "dodge": 10,
    "parry": 10,
    "wound": 10,
    "zhaoshi": "「顺流直下」",
    "damage_type": "刺伤" ]),
  ([ "action": "正在$n手忙脚乱之际，$N又一招「白虹贯日」，$w剑尖直指苍天，向
                  $n遥遥发出一道剑气",
    "lian": "$N使出一招「白虹贯日」，手中$w化为无坚不摧的一道剑气。",
    "sen": 3,
    "jibie": 10,
    "dodge": 15,
    "parry": 5,
    "wound": 15,
    "zhaoshi": "「白虹贯日」",
    "damage_type": "刺伤" ]),
  ([ "action": "$N身形一侧，使出一招「云横西岭」，手中$w缓缓移动，就见漫天剑
                 气袭向$n，宛如在$n四周布下了一道铜墙铁壁",
    "lian": "$N手中$w一晃，使出一招「云横西岭」，只见剑影如虹，将$N团团包
                  围在其中。",
    "sen": 2,
    "jibie": 18,
    "dodge": 20,
    "parry": 0,
    "wound": 20,
    "zhaoshi": "「云横西岭」",
    "damage_type": "割伤" ]),
  ([ "action": "$N气凝丹田，脚踩阴阳，左手手捏剑诀，一招「飞沙走石」手中$w
                  灌注了十成内力缓缓刺出，顿时地上的砂石落叶随着$N走动之势象
                  受到了什么命令似的开始围绕照$n缓缓转动起来。",
    "lian": "$N脚踩阴阳，手捏剑诀，一招「飞沙走石」手中$w缓缓刺出。",
    "sen": 2,
    "jibie": 25,
    "dodge": 0,
    "parry": 15,
    "wound": 22,
    "zhaoshi": "「飞沙走石」",
    "damage_type": "刺伤" ]),
  ([ "action": "$N不退反进，袍袖一拂，口中一声长啸，手中$w以剑作刀，使出一
                   招「喝马奔泉」，直上直下的朝$n劈了下来。",
    "lian": "$N双手直握，手中$w化作一道长虹，宛如天兵天将，利劈华山，这
                   确正是一招「喝马奔泉」。",
    "sen": 5,
    "jibie": 80,
    "dodge": 10,
    "parry": 20,
    "wound": 30,
    "zhaoshi": "「喝马奔泉」",
    "damage_type": "割伤" ]),
});

string *parry_msg = ({
  "$n往后一纵，在半空中身形一折，使出一招「白虹贯日」，手中的$v化作一条长虹，
     磕开了$N的$w。\n",
  "$n使出一招「云横西岭」，手中的$v化做一道铜墙铁壁，使得$N的攻势不攻自破。\n",
  "$n将手中的$v一晃，一招「飞沙走石」，宛如黑云压城，$N顿觉无从下手，无奈只
     得收招自保。\n",
  "$n顺势一招「顺流直下」，整个人随剑走，凌空划出一道长虹，$v不仅荡开了$N的
     $w，而且剑尖还直指$N的胸前。\n",
});

int valid_learn(object me) {
  if ((int)me->query("dodge") < 40)
    return notify_fail("你的身法不够，没有办法练双清剑法。\n");

  if ((string)me->query("using_force") != "      ")
    return notify_fail("无量剑法必须配合      才能练。\n");

  return 1;
}

int valid_lian(object me) {
  object ob;
  ob = me->query_temp("weapon");
  if (!ob || (string)ob->query("weapon_type") != "sword")
    return notify_fail("你必须先找一把剑才能练习剑法。\n");

  return valid_learn(me);
}

string query_xiuwei_type() { return "sword"; }
string query_weapon_type() { return "sword"; }

int query_dengji() { return 2; }

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
}

string query_zhaoshi(int jibie) {
  int i;
  for (i = 0; i < sizeof(action); i++) {
    if (action[i]["jibie"] >= jibie)
      return action[i]["zhaoshi"];
  }
  return "";
}

int query_youxiao_jibie() { return 10; }

int query_parry_ratio() { return 8; }
