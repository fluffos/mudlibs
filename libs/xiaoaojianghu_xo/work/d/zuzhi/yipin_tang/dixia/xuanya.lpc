// Room: /u/ysg/room/xuanya.c
// (C) ysg 5/9/1997

#include <ansi.h> 
inherit ROOM;

void create()
{
        set("short", "断崖");
        set("long", @LONG
你费尽全身力气，爬出窗户时，竟发现这里是一处断崖。断崖上只有一块只
容数人的地方，既没有树，也没有草，光秃秃的，看起来十分荒凉。这里三面都
是高耸入云的峭壁，人很难从这儿爬上去；剩下的一面是个深渊。你低头朝脚下
看去，发现下面云遮雾饶，很难看清有多深，隐隐约约的，你发现半空中好象有
几棵松树，你不由心中一动，似乎想到了什么。
    几只秃鹰在你头上饶来饶去，发出“啊～啊～”的凄厉的叫声，让你毛骨悚
然，浑身都不舒服。你似乎已经无路可走了。
LONG
        );

        set("item_desc", ([
        "松树"     :GRN"这是一棵虬枝劲节的老松树，枝干上有一些看不清是什么东西的白色斑点，它展开的\n"
                    "枝叶象一把大扇子，你似乎可以从这儿跳(tiao)下去。\n"NOR,    
        "pinetree" :GRN"这是一棵虬枝劲节的老松树，枝干上有一些看不清是什么东西的白色斑点，它展开的\n"
                    "枝叶象一把大扇子，你似乎可以从这儿跳(tiao)下去。\n"NOR,    
        ]));
        setup();
}
                      
void init()
{
        object me;
        me = this_player();

        me->clear_condition("yipin_laofang"); 
        //能出来已经算逃出来了。所以去掉做牢的标记。--by lnwm
        add_action("do_tiao","tiao");
        return;
}

int do_tiao()
{
        object me, ob;
        me = this_player();   
        if( me->query("combat_exp") < 10000 )
        {
                if( random(10) < 6 )
                {
                tell_object(me,RED"你感觉身子象腾云驾雾一样，但是你却失去了对身形的控制，你徒劳的挥舞\n"
                                "着双臂，眼睁睁的看着松树离你越来越远，你如石头一样坠了下去！\n"NOR);
                me->die();
                return 1;
                }
                else if( random(10) > 6 )
                {                        
                tell_object(me,MAG"你奋力一跃，在半空中抓住了一截松枝，只听见“噼啪”一声，松枝从中断\n"
                                "为两截，但你的下落之势却因此大为减缓。\n"NOR);
                remove_call_out("diao");
                call_out("diao", 1 , me);
                return 1;
                }
                else 
                {
                tell_object(me,HIY"你奋力一跃，在半空中身形一折，重重的撞在了松树上，你感觉浑身疼痛难\n"
                                "忍，好象受了重伤，但你的下落之势却因此大为减缓。\n"NOR);
                me->receive_damage("sen" ,(int)( me->query("sen")/2 ));
                me->receive_damage("kee" ,(int)( me->query("kee")/2 ));
                me->receive_damage("gin" ,(int)( me->query("gin")/2 ));
                remove_call_out("diao");
                call_out("diao", 1 , me);
                return 1;
                }
                       
        }      
        else if( me->query("combat_exp") < 150000 )
        {
                if( random(10) < 3 )
                {
                tell_object(me,RED"你感觉身子象腾云驾雾一样，但是你却失去了对身形的控制，你徒劳的挥舞\n"
                                "着双臂，眼睁睁的看着松树离你越来越远，你如石头一样坠了下去！\n"NOR);
                me->die();
                return 0;
                }
                else if( random(10) > 7 )
                {                        
                tell_object(me,MAG"你奋力一跃，在半空中抓住了一截松枝，只听见“噼啪”一声，松枝从中断\n"
                                "为两截，但你的下落之势却因此大为减缓。\n"NOR);
                remove_call_out("diao");
                call_out("diao", 1 , me);
                return 1;
                }
                else 
                {
                tell_object(me,HIY"你奋力一跃，在半空中身形一折，重重的撞在了松树上，你感觉浑身疼痛难\n"
                                "忍，好象受了重伤，但你的下落之势却因此大为减缓。\n"NOR);
                me->receive_damage("sen" ,(int)( me->query("sen")/2 ));
                me->receive_damage("kee" ,(int)( me->query("kee")/2 ));
                me->receive_damage("gin" ,(int)( me->query("gin")/2 ));
                remove_call_out("diao");
                call_out("diao", 1 , me);
                return 1;
                }
        }                                   
        else 
        {
        tell_object(me,HIY"你轻轻一跃，在半空中瞅准了松树所在的地方，借势一跃，“噼啪”一声，落\n"
                                "脚的松枝断了，但你早已缓了一口气，如浮萍一样安然飘下。\n"NOR);
                remove_call_out("diao");
                call_out("diao", 1 , me);
                return 1;
        }
}

void diao(object me)      
{
        message_vision(HIB"$N轻轻的吁了一口气，安全的落在断崖下面的地上。\n"NOR, me);
        me->move("/d/zuzhi/yipin_tang/xuanwu_tang/migong");
        return;
}


