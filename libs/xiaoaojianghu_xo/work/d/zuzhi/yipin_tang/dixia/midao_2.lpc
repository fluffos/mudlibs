//密道模型之二--毒烟 
             
#include <ansi.h>
inherit ROOM;    

void init()
{
        object ob, me;
        ob = this_object();
        me = this_player();

        if( me->IsMemberOf("yipin") != 1 && me->query("combat_exp") < 100000 )
        {
                if( random(5) < 2 )
                {
                        message_vision(RED"$N看见密道的四壁中一下子都冒出了浓烟，烟色呈碧，看起来\n"
                                       "烟中必然有什么古怪，$N只觉神智渐渐模糊。\n"NOR, me);
                        me->unconcious();    //晕倒
                        me->move(__DIR__"laofang3");
                        return;
                }
        }
        else
                message_vision("$N感觉有一种说不出的担心充满的了整个心头，只想赶快离开这里。\n", me);
                return;
}
    
                        
