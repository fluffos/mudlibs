inherit ROOM;

void create()
{
        set("short", "档案室");
        set("long", @LONG
这里是玄阳坛的记录江湖人士的资料的档案室。一间极大的屋子，墙上贴着
一张告示(gaoshi) ,屋子正中放着一张厚实的红木桌，桌子上面放着文房四宝，
长长的桌子后面正坐着一个帐房先生，看见你进来，他抬起头来看了你一眼，然
后又低下头去继续在他的帐簿上写着什么。
LONG
        );

        set("exits", ([ /* sizeof() == 1 */
            "south" : __DIR__"midao8",
])); 
        
        set("item_desc",([ /*sizeof() == 1*/
            "gaoshi" : " 本档案室资料不得外借，欲使用者，请先登记。"
]));
      
        set("no_sleep_room", 1);

        setup();
}

