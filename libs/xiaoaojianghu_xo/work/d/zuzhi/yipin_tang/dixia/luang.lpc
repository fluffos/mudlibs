#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "暖阁");
        set("long", @LONG
这里是玄才坛议事的地方。通常你能在这儿看到坛主等人在这儿处理公务。
暖阁里冬暖夏凉，四壁上挂着山水花鸟画，地上铺的是大理石地面，看上去有说
不出的豪华气派。暖阁正中放着一把太师椅，椅上蒙着一张斑斓虎皮，额上的“
王”字正说明了这里的主人是多么有权势。
LONG
        );

        set("exits", ([ /* sizeof() == 4 */
            "north"     : __DIR__"midao12",
            "south"     : __DIR__"groom2",
            "northwest" : __DIR__"midao11",
            "southwest" : __DIR__"shenf2",
]));                    

        setup();
}

