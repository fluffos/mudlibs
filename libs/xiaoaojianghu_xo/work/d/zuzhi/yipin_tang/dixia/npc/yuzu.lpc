#include <ansi.h>

inherit NPC;

void create()
{
        set_name(BLK"狱卒"NOR, ({ "yu zu", "zu"}));
        set("title",YEL"一品堂"NOR);
        set("age", 30);
        set("gender", "男性");
        set("str",40);
        set("per", 25);   
        set_wugong("sword",100);
        set_xiuwei_by_type("sword",1200);
        set_xiuwei_by_type("dodge",1300);
        set_wugong("wuliang-shenfa",150,150,1);
        set("max_force",1600);
        set("force",1600);
                JoinZuzhi("yipin","杀手统领","玄阳堂");    
        set("combat_exp", 100000);
        set("force_factor",30);
        setup(); 
        carry_object(__DIR__"obj/cloth1")->wear();
        carry_object(__DIR__"obj/jian1") ->wield();   
} 

void init()
{
    object ob, me;
    me = this_player();
        ob = this_object();  
        
    ob->set("yipin", 1);
        if( interactive(me) && environment() == environment(me))
        {
        message_vision(GRN"$N对$n哼的一声，斜眼瞥了$n一眼，嘴里咕噜道：“嘿！又来了一个。”\n"
                NOR, ob, me);
                message_vision(HIY"$N喃喃自语道：也不知道这些人有没有钱，懂不懂得孝敬我老人家。\n"
                NOR, ob);
        return;
        }
}    
     
int accept_object(object who,object from)
{
        if( from->query("id") != "silver")
        {
                command("?");  
                remove_call_out("del");
                call_out("del", 1, from);
                return 0;
        }
        if( (int)from->query_amount() >= 4 ) 
        {
                tell_object(who,BLU"狱卒悄悄的告诉$N：“以前进了狱中的人都是有来无回，但是近来\n"
                        "有好几个江湖人士就从这儿跑了出去，听说他们都是砸(za)碎窗户跑出去的。”\n"NOR);
                command("hehe");  
                remove_call_out("del");
                call_out("del", 1, from);
                return 1;
        }                    
        else 
        {
                tell_object(who,BLU"狱卒显出一副不屑一顾的样子，对$N哼了一声道：“才这么一点，你\n"
                        "就想探听消息了吗？”\n"NOR);
                command("sneer");        
                remove_call_out("del");
                call_out("del", 1, from);
                return 1;
        }
}
                                         
int accept_fight(object me)
{
    message_vision("狱卒冷笑一声，你想陪大爷玩两手？\n", me );
        kill_ob( me );
    return 0;
}

void del(object from)
{
        destruct(from);
        return;
}

int refuse_killing( object me )
{
        message_vision(YEL"\n狱卒高声叫喊着，犯人反了！快来人呀！！！\n"NOR, me );
        call_out( "come_other", 10 , me );
        return 0;
}

int come_other( object me )
{
        message_vision(RED"\n只见外面突然冲进来几个狱卒，一顿乱棒将$N打翻在地。\n"NOR, me );
        this_object()->remove_killer( me );
        me->unconcious();
        return 1;
}
