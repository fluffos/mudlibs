#include <ansi.h>
#include "refuse_kill.h"

inherit NPC;

void create()
{
        set_name(MAG"紫衣卫士"NOR, ({ "wei shi"}));
        set("title",YEL"一品堂"NOR);
        set("age", 22);
        set("gender", "男性");
        set("str",40);
        set("per", 25);   
        set_wugong("liuyun-jian",100,100,1);
        set_xiuwei_by_type("sword",600);
        set_xiuwei_by_type("dodge",300+random(200));
        set_wugong("yanxing",100,100,1);
        set("force",1200);
        set("max_force",1200);
        set("combat_exp", 40000);
        JoinZuzhi("yipin","杀手统领","玄武堂");
        set("force_factor",20);
        setup();
        carry_object(__DIR__"obj/cloth2")->wear();
        carry_object(__DIR__"obj/jian1") ->wield();        
}
 

