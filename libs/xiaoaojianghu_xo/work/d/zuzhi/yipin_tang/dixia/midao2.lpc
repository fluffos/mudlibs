#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "密道");
        set("long", @LONG
这是一条密道。四面墙上插了几盏桐油灯，昏黄的灯光不仅不能照亮整个密
道，反而更添了几分阴森恐怖的气氛。密道潮湿而阴冷，头顶的石缝里“滴～～
答～～！滴～～答～～”的往下渗着水，脚下时不时蹿出一只硕大的老鼠。不知
为何，你仿佛总觉得有无数暗中窥探的眼睛在盯着你，使你生出一种若芒刺在背
的感觉。
LONG
        );

        set("exits", ([              
                "north"      : __DIR__"midao_s",
                "southeast"  : __DIR__"laofang_rukou",
                "southwest"  : __DIR__"xuanyun_tang_rukou",
        ]));
        set("objects", ([
                __DIR__"npc/weishi2":1,
        ]));
        setup();
}

