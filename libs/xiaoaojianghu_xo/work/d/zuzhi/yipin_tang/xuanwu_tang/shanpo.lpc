inherit ROOM;

void create()
{
        set("short", "山坡");
        set("long", @LONG
练武场北侧的高坡。爬上坡就能自上而下看到整个练武场的全貌。练武场三
面是悬崖，只北面有路回内院。整个练武场地势比较低，所以尽管三面是悬崖，
也并不用担心练功时会跳出崖外。不过还是小心些好。
    站在这里，以是制高点，咧咧山风吹动你的衣裾，身后是巍峨耸立的贺兰山
脉，你不禁心中凭添几分豪气。
LONG
        );
        set("exits", ([ 
//  "westup" : __DIR__"xuanya4",
  "northdown" : __DIR__"wuchang4",
]));
        set("no_clean_up", 0);
    set("outdoors","xuanwu");
        setup();
}

