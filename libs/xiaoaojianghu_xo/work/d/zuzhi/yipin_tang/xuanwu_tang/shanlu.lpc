inherit ROOM;

void create()
{
    set("short", "山路");
    set("long", @LONG
玄武堂的练武场建在西南峰上，每天都有少人经过这里，天长日
久，踩出了这条山路。为了随时提高功力。卫士们故意选择了这个最
难攀爬的方向。山路不时断绝，得从裸露的山石上攀爬过去，没有一
定的轻身功夫是过不去的。从峰顶传来一阵阵到剑撞击之声。抬头望
去，不时有刀的的闪光划过。
LONG
    );
    set("exits", ([ /* sizeof() == 2 */
        "northdown" : __DIR__"xiaolu2",
        "southup" : __DIR__"wuchang1",
    ]));
    set("no_clean_up", 0);

    setup();
    replace_program(ROOM);
}

