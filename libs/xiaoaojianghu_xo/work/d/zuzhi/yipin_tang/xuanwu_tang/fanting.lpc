// Room: /u/zodiac/xuanwu/fanting.c

inherit ROOM;

void create()
{
    set("short", "饭厅");
    set("long", @LONG
这是一个可供百人同时进餐的大饭厅。厅内摆着十数张八仙桌，
张张擦得亮可照人。十余个青衣小童往来穿梭，服侍众人进餐。由于
山势高险，这里连一只苍蝇都没有。别看进餐的人不少。一品堂的卫
士们可都是训练有素的，用餐时，诺大个饭厅除了碗筷撞击之声外，
一个聊天的人都没有。曾有一个小卫士只因饭菜不佳，嘟囔了一句，
就被绑在大门外的旗杆上冻饿十天后，推入了悬崖。
LONG
    );
    set("exits", ([ /* sizeof() == 1 */
        "east" : __DIR__"tingyuan4",
    ]));
    set("no_clean_up", 0);

    setup();
}

void init()
{
    add_action( "do_sit", "sit" );
}

int do_sit( string arg )
{
    object me = this_player();
    object food;

    if ( !arg || arg=="" )
        return notify_fail("你要坐在哪儿？\n");
    if ( arg == "table" )
        return notify_fail("嗯……按说坐在桌子上也不是不可以，不过这好象太西化了吧？\n");
    if ( arg != "chair" && arg != "椅子" && arg != "yizi" )
        return 0;
    message_vision(@TEXT
$N走到一张八仙桌旁，坐了下来。
青衣小童连忙走了过来，端上一碗热腾腾的小米粥和一屉包子。
TEXT , me);
    food = new(__DIR__"obj/xiaomi_zhou");
    food->move( this_object() );
    food = new(__DIR__"obj/baozi");
    food->move( this_object() );
    return 1;
}

int valid_leave(object me, string dir)
{
    if ( dir == "east" )
        foreach( object ob in deep_inventory( me ) )
        {
            if ( ob->is_food_of_xuanwu() )
                return notify_fail("门口的青衣童子走到你面前，道：“真对不起，\n"
                               "堂主有令，只许在这儿吃，不许带走。”\n");
        }
    return ::valid_leave( me, dir );
}
