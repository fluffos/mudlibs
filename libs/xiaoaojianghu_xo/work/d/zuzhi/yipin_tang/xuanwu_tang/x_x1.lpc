inherit ROOM;

void create() {
  set("short", "羊肠小道");
  set("long", @LONG
越往西，地势越高，贺兰山的轮廓逐渐在视野里出现，山势跌宕起伏，山顶
上能看到终年不化的皑皑白雪，象少女头上所围的洁白的头巾，远远看去，飘渺
美丽。
    脚下的路也越走越窄，已经由最初的黄土大道，变成了几乎仅容一人的羊肠
小路，路边的绿色也渐渐稀少，带之的是大片的沙砾山石构成的丘陵。
LONG
  );
  set("exits", ([
    "northwest": __DIR__ "shanjiao",
    "southeast": __DIR__ "x_x2",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "xuanwu");
  setup();
}
