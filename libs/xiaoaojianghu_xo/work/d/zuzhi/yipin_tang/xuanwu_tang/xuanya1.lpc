// Room: /u/zodiac/xuanwu/xuanya1.c

inherit ROOM;
int receive_alarm ( object );
int receive_summon( object );

void create()
{
    object diaolan;

    set("short", "悬崖");
    set("long", @LONG
小路在这里拐了一个大弯。山势突然断绝，裸露的岩石仿佛怪兽
锋锐的牙齿正待人而啮。世界好象残缺了半边，一下子给你带来极度
的不平衡感。冉冉的薄雾不时从你脚下升起，将你裹在其中，辨不清
方向。风从一个顽皮的孩子变成凶饿的壮汉，将你的衣襟抽打得啪啪
作响。若不小心，只怕你就要被他吹下悬崖了。
    透过薄雾，你隐隐约约看见北边那高大的玄武堂正门。
LONG
    );
    set("exits", ([ /* sizeof() == 1 */
        "north" : __DIR__"zhengmen",
    ]) );
    set("objects", ([
        __DIR__"npc/weishi3" : 2,
    ]) );

    set("no_clean_up", 0);
    set("outdoors","xuanwu");    
    setup();
    if ( ( diaolan = load_object( __DIR__"diaolan" ) )->query("exits/out") ==
         __DIR__"xuanya1" )
        set("exits/enter", __DIR__"diaolan" );

    set_marks("guards", all_inventory( this_object() ) );
    
}

void init()
{
    add_action("do_pull","pull");
    add_action("do_droop", "droop");
}

int receive_blow( string arg )
{
    int t1, t2;
    string *args, msg, s1, s2;
    object room = this_object();

    msg = "从下面的山谷里传来了";

    args = explode( arg, " ");
    switch ( sizeof( args ) )
    {
        case 1:
            sscanf( args[0], "%d%s", t1, s1);
            if ( s1 == "l" ) s1 = "悠长";
            else s1 = "短促";
            msg += CHINESE_D->chinese_number( t1 ) + "声" + s1 + "的哨响。\n";
            break;
        case 2:
            sscanf( args[0], "%d%s", t1, s1);
            sscanf( args[1], "%d%s", t2, s2);
            if ( s1 == "l" )
            {
                s1 = "长";
                s2 = "短";
            }
            else
            {
                s1 = "短";
                s2 = "长";
            }
            msg +=  CHINESE_D->chinese_number( t1 ) + s1 +
                    CHINESE_D->chinese_number( t2 ) + s2 + "的" +
                    CHINESE_D->chinese_number( t1 + t2 ) + "声哨响。\n";
            break;
        default:
            msg += "一串长短错落变化繁复的哨音。";
            break;
    }
    tell_room( room, msg );

    if ( !present( "weishi", room ) )
        return 0;
    switch (arg)
    {
        case "1l":
            receive_summon( room );
            break;
        case "3s":
            receive_alarm ( room );
            break;
        default:
            break;
    }
    return 1;
}

int receive_alarm( object room )
{
    object *guards = ({});
    foreach ( object ob in all_inventory( room ) )
    {
        if ( ob->id("weishi") && living( ob ) )
            guards += ({ ob });
    }
    return 1;
}

int receive_summon( object room )
{
    object *guards = ({}), diaolan;

    if ( query( "exits/enter" ) )
    {
        guards = query_marks( "guards" );
        if ( present( guards[0], room ) && living( guards[0] ) ||
             present( guards[1], room ) && living( guards[1] ) )
        {
            diaolan = load_object( __DIR__"diaolan" );
            diaolan->go_down();
            return 1;
        }
    }
    return 0;
}
