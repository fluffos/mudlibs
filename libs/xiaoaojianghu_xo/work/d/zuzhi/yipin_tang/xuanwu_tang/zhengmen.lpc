// Room: /xuanwu/zhengmen.c

inherit ROOM;

void create()
{
    set("short", "玄武堂正门");
    set("long", @LONG
在这巍峨的贺兰群山之间，你来到了玄武堂的正门之前。门前的
旗杆上挂着几个与风沙，鲜血，冰霜冻结在一起的人头。刁斗被那常
年的血淤成了暗紫色，好象随时会从旗杆上掉下来，将你的头咬去半
边。朱红的大门被那长年的劲风裹者冰碴打出了不少白点。一只鸽子
从檐下的鸽窗穿过，撞出一连串清脆的叮灵声。也不知它给主人又带
回了什么消息？
    正门的东西两面连着两间卫士房。北边往里是一个小小的庭院。
LONG
    );
    set("exits", ([ /* sizeof() == 4 */
        "south" : __DIR__"xuanya1",
        "north" : __DIR__"tingyuan1",
        "east"  : __DIR__"weishi_fang1",
        "west"  : __DIR__"weishi_fang2",
    ]));
    set("no_clean_up", 0);
    set("outdoors","xuanwu");
    setup();
}

