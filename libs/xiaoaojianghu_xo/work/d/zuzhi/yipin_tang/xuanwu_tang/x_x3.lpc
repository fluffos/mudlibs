inherit ROOM;

void create()
{
        set("short", "草滩");
        set("long", @LONG
离开兴庆府不多远，四周已是一片开阔，周围已经少见人烟。这里的特色是
无边无尽的草滩。和草原不同，这里是由一簇一簇的绿色植物覆盖着沙砾地面，
千百万个这样的草堆就构成了一片广阔的草滩。
    向西北望去，远远就是贺兰山巍峨的群山。
LONG
        );
        set("exits", ([ 
                "northwest"     : __DIR__ "x_x2",
                "east"          : __DIR__ "x_x4",
]));
        set("no_clean_up", 0);
        set("outdoors", "xuanwu");
        setup();
}

