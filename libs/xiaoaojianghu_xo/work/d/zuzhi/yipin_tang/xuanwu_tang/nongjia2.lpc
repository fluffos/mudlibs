inherit ROOM;

void create()
{
        set("short", "农家");
        set("long", @LONG
山区常见的农居，屋子并不大。不过屋子里有一长很大的炕，几乎占了半个
房间。在穷人的眼里，家里的炕越大，家境一定越好，这家的家境显然相对来说
不错。屋内的墙上显眼地挂着一张熊皮，熊皮的旁边挂着一把巨大的钢叉，是打
猎用的。
LONG
        );
        set("exits", ([ 
                "north"         :       __DIR__ "shancun",
]));
        set("no_clean_up", 0);
        setup();
        replace_program(ROOM);
}

