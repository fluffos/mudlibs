// Room: /xuanwu/tingyuan1.c

inherit ROOM;

void create()
{
    set("short", "庭院");
    set("long", @LONG
这是连接玄武堂正厅和正门的一个小庭院。
    院子正中是一堵大影壁。上面绘着李元昊单骑平叛的故事。西边
有一座月亮门，一条小路通向内堂去了。东边是精致的操手游廊，拐
到北边的正厅里去了。游廊下的阳沟里，缓缓的流着山中引来的温泉
。由着着温泉的滋养，庭院中四时有不败之花，尤以那几株虞美人红
得娇艳欲滴。叫人几乎忘了大门外就是终年积雪的贺兰山。
LONG
    );
    set("exits", ([ /* sizeof() == 3 */
        "east"  : __DIR__"ceting",
        "west"  : __DIR__"xiaolu1",
        "south" : __DIR__"zhengmen",
        "north" : __DIR__"zhengting",
    ]));
    set("no_clean_up", 0);
    set("outdoors","xuanwu");
    setup();
}

