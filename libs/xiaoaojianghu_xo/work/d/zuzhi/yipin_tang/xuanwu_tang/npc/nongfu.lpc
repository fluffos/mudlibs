//man.c

inherit NPC;

int ask_for_xuanwu( );

void create()
{
    set_name("农夫", ({ "nong fu", "nongfu", "man" }) );
    set("gender", "男性" );
    set("age", 40);
    set("long", "一个典型的北方农民，正光着膀子在田里干活。\n");
    set("combat_exp", 3000);
    set_wugong("unarmed",30,30,1);
    set("inquiry", ([
        "玄武堂"  : (: ask_for_xuanwu :),     
        ]) );

    set("chat_chance", 1);
    set("chat_msg",({                             
"农夫抬手擦了一下额头上的汗珠，又继续干他的活。\n",
        }) );
        
    setup();
//    carry_object(__DIR__"obj/cloth1")->wear();
}

int ask_for_xuanwu()
{
    object me = this_player(), ob = this_object();

    message_vision( "$N抬头看了$n一眼，又低下头去干活。\n", ob, me);
    return 1;
}

