#include <ansi.h>

inherit NPC;

int welcome_visitor( object me )
{
    object npc = this_object(), cloth, ling;
    int time_available;

    foreach( object inv in deep_inventory( me ) )
    {
        if ( ( inv->name() == YEL"玄武令"NOR ) && inv->id( "ling pai" ) )
            ling = inv;
        if ( ( inv->name() == "黑色号坎" ) && inv->id( "hao kan" ) )
            cloth = inv;
    }

//    if ( ( time_available = me->query_condition("can_stay_in_xuanwu") ) > 2 ||
//         with_ling )
    if ( cloth || with_ling )
    {
        if ( random( 10 ) > 8 )
            message_vision( "$N冲$n微微一笑，点了一下头。\n", npc, me );
    }
    else if ( cloth->time_available() > 0 )
    {
        message_vision( GRN "$N见$n走了过来，诧异地说：“咦？你不是已经在这里待了三\n"
                            "天了吗？还不赶快下山？”\n" NOR , npc, me );
    }
    else
    {
        message_vision2( "$N大喝一声：“什么人竟想混入玄武堂，今天教你来得，去不得！”", npc);
        kill_ob( me );
    }
}

int query_ask_answer( object ppl, string arg )
{
    object npc = this_object();

    if ( random( 2 ) )
        message_vision( "$N瞟了$n一眼道：“少用嘴多用手，你这颗脑袋自会长得牢靠些。”\n",
                        npc, ppl);
    else
        message_vision( "$N瞪了$n一眼，冷冷道：“不该你问的就别乱打听！”\n",
                        npc, ppl);
    return 1;
}

int accept_fight( object me )
{
    message_vision( "$N瞪了$n一眼，道：“我正在执行公务，别烦我。”\n",
                this_object(), me );
    return 0;
}

