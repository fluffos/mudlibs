#include <ansi.h>

inherit NPC;

int greeting( object npc, object me );
int alarming( object npc, object me );

int welcome_visitor( object me )
{
    object npc = this_object(), cloth, ling;
    int time_available;

    foreach( object inv in deep_inventory( me ) )
    {
        if ( ( inv->name() == YEL"玄武令"NOR ) && inv->id( "ling pai" ) )
            ling = inv;
        if ( ( inv->name() == "号坎" ) && inv->id( "hao kan" ) )
            cloth = inv;
    }

    time_available = me->query_condition("can_stay_in_xuanwu");

    if ( cloth || ling )
        greeting( npc, me );
    else
        alarming( npc, me );
}

int greeting( object npc, object me )
{
    if ( random( 10 ) > 8 )
        message_vision( "$N冲$n微微一笑，点了一下头。\n", npc, me );
    return 1;
}

int alarming( object npc, object me )
{
    message_vision2( "$N大喝一声：“什么人竟想混入玄武堂，今天教你来得，去不得！”", npc);
    kill_ob( me );
    return 1;
}

int query_ask_answer( object ppl, string arg )
{
    object npc = this_object();

    if ( random( 2 ) )
        message_vision( "$N瞟了$n一眼道：“少用嘴多用手，你这颗脑袋自会长得牢靠些。”\n",
                        npc, ppl);
    else
        message_vision( "$N瞪了$n一眼，冷冷道：“不该你问的就别乱打听！”\n",
                        npc, ppl);
    return 1;
}

int accept_duilian( object ppl )
{
    object npc = this_object(), ling, cloth;

    foreach( object inv in deep_inventory( ppl ) )
    {
        if ( ( inv->name() == YEL"玄武令"NOR ) && inv->id( "ling pai" ) )
            ling = inv;
        if ( ( inv->name() == "号坎" ) && inv->id( "hao kan" ) )
            cloth = inv;
    }

    if ( !ling && !cloth )
        return alarming( npc, ppl );
    else if ( ling )
    {
        message_vision( CYN "$N" CYN "对$n" CYN "道：“你是新来的吧？要"
                            "先去找堂主报到知道吗？堂主在正厅呢。\n" NOR,
                            npc, ppl );
        return 0;
    }
    else if ( ( npc->query( "gin" ) * 100 / npc->query( "max_gin" ) < 70 ) ||
              ( npc->query( "kee" ) * 100 / npc->query( "max_kee" ) < 70 ) ||
              ( npc->query( "sen" ) * 100 / npc->query( "max_sen" ) < 70 ) )
    {
        message_vision( CYN "$N对$n歉然一笑：“我今天太累了，改天吧。”\n" NOR, npc, ppl );
        return 0;
    }
    else
        return 1;
}

int accept_fight( object me )
{
    object npc = this_object();
    
    if ( member_array( "一品堂", me->GetZuzhiName() ) == -1 )
        return alarming( npc, me );
    else
    {
        message_vision( CYN "$N瞟了$n一眼，道：“本堂禁止私斗，你不会不知道吧？”\n" NOR, npc, me );
        return 0;
    }
}
