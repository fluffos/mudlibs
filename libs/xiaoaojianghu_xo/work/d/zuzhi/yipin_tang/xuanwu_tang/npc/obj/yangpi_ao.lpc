// yangpi_ao.c

#include <armor.h>

inherit CLOTH;

void create()
{
    set_name("羊皮袄", ({ "yang pi ao", "pi ao", "pi'ao", "ao" }) );
    set_weight(1000);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("unit", "件");
        set("material", "cloth");
        set("value", 900);
        set("armor_prop/armor", 10);
    }
    setup();
}

