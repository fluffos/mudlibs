#include <ansi.h>

inherit __DIR__"xwnpc";

int admonish( object npc, object me )
{
    return 1;
}

int greeting( object npc, object me )
{
    object *invs = all_inventory( me );
    return 1;
}

int query_ask_answer( object ppl, string arg )
{
    object npc = this_object();

    if ( random( 2 ) )
        message_vision( "$N瞟了$n一眼道：“少用嘴多用手，你这颗脑袋自会长得牢靠些。”\n",
                        npc, ppl);
    else
        message_vision( "$N瞪了$n一眼，冷冷道：“不该你问的就别乱打听！”\n",
                        npc, ppl);
    return 1;
}

int accept_duilian( object me )
{
    message_vision( "$N瞪了$n一眼，道：“我正在执行公务，别烦我。”\n",
                this_object(), me );
    return 0;
}
