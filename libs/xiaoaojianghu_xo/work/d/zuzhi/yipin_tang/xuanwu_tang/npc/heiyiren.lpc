//jieyin_ren.c 一品堂之玄武堂的接引人

#include <ansi.h>

inherit NPC;

//inherit __DIR__"xwnpc";
//by lnwm

//nosave int last_time;
int summon_diaolan();
int alarm();

void create()
{
    set_name("黑衣人", ({ "heiyi ren", "heiyi ren" }) );
    set("gender", "男性" );
    set("age", 20 + random(10) );
    set("long", "一个身着黑衣的男子。\n");

    set("combat_exp", 3000000);
//    set_wugong("unarmed",30,30,1);

    setup();
    carry_object( __DIR__"obj/tieshao" );
    carry_object( CLOTH_DIR"jingzhuang1" )->wear();
}

int welcome_visitor( object me )
{
    object npc = this_object();
    int with_ling = 0;

    foreach( object inv in all_inventory( me ) )
    {
        if ( ( inv->name() == YEL"玄武令"NOR ) && inv->id( "ling pai" ) )
            with_ling = 1;
    }

    message_vision("$N见$n走了过来，忙迎了上去。\n", npc, me);

    if ( with_ling )
    {
        message_vision( "$n亮出一枚玄武令，$N微一点头，侧身让开道路。\n",
                        npc, me );
                alarm();
    }
    else
    {
        message_vision2( "$n见$N走了过来，心中不禁慌了起来，一只手伸到怀里就"
                         "怎么也掏不出个所以然来。\n", npc, me );
        message_vision2( "$N一见之下自然心中了然，大喝一声：“什么人竟想混入"
                         "玄武堂，今天教你来得，去不得！”", npc);
        kill_ob( me );
    }
}

int summon_diaolan()
{
    command( "blow 3s" );
        return 1; // by lnwm
}

int alarm()
{
    command( "blow 1l" );
        return 1; // by lnwm
}
