#include <ansi.h>

inherit __DIR__ "weishi";

void create() {
  set_name(HIG "锦衣卫士" NOR, ({ "jinyi weishi", "weishi" }));
  set("gender", "男性");
  set("age", 20 + random(10));
  set("long", "一个身着锦衣，外罩大红武士袍的男子。\n");

  set("combat_exp", 3000);
  //    set_wugong("unarmed",30,30,1);

  setup();
  //    carry_object(__DIR__"obj/cloth1")->wear();
}
