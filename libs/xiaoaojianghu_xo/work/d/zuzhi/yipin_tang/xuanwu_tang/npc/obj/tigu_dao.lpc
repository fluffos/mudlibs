// tigu_dao.c
#include <weapon.h>
inherit SHORT;

void create() {
  set_name("剔骨刀", ({ "tigu dao", "knife" }));
  set_weight(250);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", @LONG
一把普普通通的剔骨刀。枣木的把，纯钢的刀刃，看起来很是锋利。
LONG);
    set("value", 20);
    set("material", "iron");
    set("wield_msg", "$N拔出$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插回腰间。\n");
    set("verbs", ({ "point", "bash", "crush", "slam" }));
  }

  init_short(10);
  setup();
}
