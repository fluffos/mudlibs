#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
  set("short",YEL "木屋" NOR);
  set("long",@LONG
一间用木料和树枝搭成的木屋......
LONG);
  set("exits",([
    "out" : __DIR__"caodi",
  ]));
  create_door("out","木门","in",DOOR_CLOSED);
  set("not_startroom",1);
  set("sleep_room","inn");
  setup();
}

