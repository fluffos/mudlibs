//veiled_jin.c.蒙面巾
//data:1997.10.19
// by dan

#include <ansi.h>

inherit ITEM;

void create()
{
    set_name(YEL"蒙面巾"NOR, ({ "mengmian jin", "jin" }) );
    set_weight(100);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("unit", "块");
        set("value",150);
        }   
    setup();
}

void init()
{
   add_action("do_veiled","veiled");
   add_action("do_unveiled","unveiled");
}

int do_veiled()
{ 
     object me;
     me = this_player();
     if( me->query_temp_marks("veiled") )
     return notify_fail(HIR"你已经蒙面了。。。还想干什么？\n"NOR);
     message_vision(MAG"$N戴上纱巾，蒙好面，隐在暗处。。。。、\n"NOR,me);
     me->set_temp_marks("veiled",1);
     me->set_temp_marks("apply/id",({"none"}));
     me->set_temp_marks("apply/name",({"蒙面客"}));
     me->set_temp_marks("apply/short",({"平民 蒙面客(None)"}));
     me->set_temp_marks("apply/long",({"一个蒙面客，不知真实面目。。"}));
     return 1;
}
 
int do_unveiled()
{
     object me;
     me=this_player();
     if( !me->query_temp_marks("veiled") )
     return notify_fail(HIR"你什么都没有戴啊。。。。。\n"NOR);
     me->delete_temp_marks("veiled");
     me->delete_temp_marks("apply/id");
     me->delete_temp_marks("apply/name");
     me->delete_temp_marks("apply/short");
     me->delete_temp_marks("apply/long");
     message_vision(MAG"$N摘下面纱，现出本来面目。。。\n"NOR,me);
     return 1;
}

