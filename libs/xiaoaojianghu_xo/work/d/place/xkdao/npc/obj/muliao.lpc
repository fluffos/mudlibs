#include <ansi.h>

inherit ITEM;

void create()
{
    set_name(GRN"木料"NOR, ({"mu liao","mu"}));
    set_weight(30000);
    if (clonep())
            set_default_object(__FILE__);
    else {
        set("long", "一根已经加工的木料,可以制成许多种木器...\n");
        set("unit", "根");
        set("value", 20);
        set("can_fire",1);
        }
}


