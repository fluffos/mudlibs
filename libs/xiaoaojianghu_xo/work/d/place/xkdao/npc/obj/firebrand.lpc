//firebrand.c.火堆
//date:1997.10.23
//by dan

#include <ansi.h>

inherit ITEM;

string *real_name = ({
  "野兔","泽鹿","拟绒鼠","毛猬","鼯鼠","穿山甲","果子狸","豪猪","云豹",  
 });

string *real_id = ({
  "yetu","zelu","nirongshu","maowei","wushu","chuanshanjia","guozili","haozhu","yunbao",
  });

void create()
{
    set_name(RED"火堆"NOR, ({"huo dui"}));
    set_weight(150000000);
    if (clonep())
         {
            set_default_object(__FILE__);
         }
    else {
        set("long", "一堆正在燃烧的木柴。\n");
        set("unit", "堆");
        set("value", 20);
     }
}

void init()
{
   add_action("do_cook","cook");
}

int do_cook(string arg)
{
     string arg1,arg2,name,id;
     object ob,obj,me;
     int i;
     me = this_player();
     
     if ( this_object()->query("id")!="huo dui" )
       return notify_fail("这堆火已不能用来烧烤了....\n");
     if ( !arg )
       return notify_fail("你烧什么啊.....莫非你的手是熊掌?\n");
     if ( !objectp(ob = present(arg, me)) )
       return notify_fail("你身上没有这样东西。\n");
     if ( !ob->query("can_cook") )
       return notify_fail("这东西不能烧，你还是....烧自己的手也许好些!\n");
     arg1 = "/d/place/xkdao/npc/obj/";
     arg2 = (string)((ob->query("cook_name")));
     arg1 +=arg2;
     obj = new( arg1 ) ;
     i = ob->query("number");
     if ( i !=0 )
     {
            name = "烤";
            name += real_name[i];
            name += "肉";
            id = "kao";
            id += real_id[i];
            id += " rou";
            obj ->set("name",name);
            obj ->set("id",id);
            obj ->set("number", i);
        }
     obj ->move( me );
     if( !ob->query("cook_msg") )
            {
             message_vision("$N拿起$n开始烧烤......\n",me,ob);
        }
        else{
             arg1 = (string)(ob->query("cook_msg"));
             message_vision(arg1,me,ob);
            } 
     destruct(ob);   
     return 1;
}  


