#include <ansi.h>

inherit ITEM;
inherit F_FRUIT;

void init()
{
    add_action("do_eat", "eat");
}

void create()
{
    set_name(HIY"椰子"NOR, ({"ye zi"}));
    set_weight(100);
    set("long", "一个大大的椰子，里面好象有很多汁水.....");
    set("unit", "个");
    set("life", 7);
    set("value", 50);
    set("fruit_remaining", 4); 
    set("food_supply", 2);   
    set("water_supply", 10);  
    set("eat_msg", "$N拿起$n，开个口开始吸汁水......\n"); 
    set("end_msg", "$N把$n里面的汁水喝光了，只剩一个椰子壳了......。\n");  
    set("over_msg", "吃这么多？小心撑破肚皮！！！！\n"); 
    set("core", "椰子壳");
    set("core_id", ({"yezi ke", "ke"}) );
    set("unit", "个");
    set("core_long", "一个椰子壳......\n"); 
    setup();
}


