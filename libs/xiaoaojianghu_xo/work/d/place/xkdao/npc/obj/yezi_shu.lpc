//yezi_shu.c.椰子树
//date:1997.10.23
//by dan

#include <ansi.h>

inherit ITEM;

void create()
{
    set_name(GRN"椰子树"NOR, ({"yezi shu","shu"}));
    set_weight(30000);
    if (clonep())
            set_default_object(__FILE__);
    else {
        set("long", "一棵很粗壮的椰子树，树上有很多椰子，当心一震树干很砸下来....\n");
        set("unit", "棵");
        set("value", 20);
        set("can_fire",1);
        set("no_get",1); 
    }
}

void init()
{
   add_action("do_zhen","zhen");
}

int do_zhen()
{
   object me,ob,room,obb;
   me = this_player();
   ob = this_object();
   room = environment(me);
   if ( me->query("force") <200 )
   return notify_fail("你的内力不足.....\n");
   me -> add("force", -50 );
   obb = new( __DIR__"yezi" );
   obb -> move ( room );
   return notify_fail("你用尽全力震下一个大椰子......\n");
}


