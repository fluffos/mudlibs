//to be 野兽

#include <ansi.h>

inherit NPC;

string *real_name = ({
  "泽鹿", "拟绒鼠", "毛猬", "鼯鼠", "穿山甲", "果子狸", "豪猪", "云豹",
});

string *real_id = ({
  "zelu", "nirong shu", "maowei", "wushu", "chuanshan jia", "guozi li", "haozhu", "yunbao",
});

void create() {
  string name, id, lon;
  int i;
  i = random(sizeof(real_name));
  name = real_name[i];
  id = real_id[i];
  lon = "一只可爱的" + name;
  lon += "......\n";
  set_name(name, ({ id }));
  set("race", "野兽");
  set_weight(2500);
  set("age", 1);
  set("long", lon);
  set("str", 30);
  set("cor", 30);
  set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));
  set("combat_exp", 3000);
  set("edible", 1);
  set("refine_name", "lostcony");
  set("refine_msg", "$N拎起兔子剥皮...开膛...破肚...加工成一块兔肉.\n");
  setup();
}
