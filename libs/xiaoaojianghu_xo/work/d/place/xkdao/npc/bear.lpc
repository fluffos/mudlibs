inherit NPC;

void create()
{
        set_name("熊", ({ "xiong"}));
    set("race", "野兽");
        set("age", 20);
        set("long",
                "这是一种南海特有的熊，也是这里唯一的猛兽...\n");  
    set("attitude","aggressive");
    set("str", 150);
    set("cor", 50);
    set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }) );
    set("verbs", ({ "bite", "claw" }) );
    set("combat_exp", 3000000);   
    set("chat_chance",5);
    set("chat_msg",({
        (:random_move:),
    }));
    setup();
}

void init()
{
   kill_ob( this_player() );
}   
