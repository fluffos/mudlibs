//shore.c.海滩
//date:1997.8.19
// by dan 

#include <ansi.h>
#include <room.h>
#include <ansi.h>
#include <localtime.h>

inherit ROOM;

void create() {
  set("short", YEL "海滩" NOR);
  set("long", @LONG
这里是一片白茫茫的沙滩。整个海滩呈半月形，你赤着双脚走在上面，觉的
沙子非常柔软的烫着你的双脚，使你感到十分地舒适。海浪正哗哗啦冲上滩头，
偶尔有几个颜色鲜艳的贝壳被海水带上来，一些小乌龟在沙滩上自由自在的爬着。
旁边有几棵高高的结满椰子的椰子树，南面是一片翠绿的丛林和草地，一些小螃
蟹在沙滩上爬来爬去，还不时爬上你的脚丫上，弄得你浑身痒痒的。沙堆下好像
有什么似的.
LONG);
  set("not_startroom", 1);
  set("exits", ([ /* sizeof() == 1 */
    "north": __DIR__ "sea",
    "south": __DIR__ "caodi",
  ]));
  set("outdoor", "zhongyuan");
  set("objects", ([
    __DIR__ "npc/obj/yezi_shu": 1,
  ]));
  set("search_things", ([
    "沙堆": __DIR__ "npc/obj/fuzi",
  ]));
  setup();
}

void init() {
  object me, room1, room2, room3;
  int time;
  mixed *ltime;
  me = this_player();
  if (!room1 = find_object(__DIR__ "caodi"))
    room1 = load_object(__DIR__ "caodi");
  if (!room2 = find_object(__DIR__ "shore"))
    room2 = load_object(__DIR__ "shore");
  if (!room3 = find_object(__DIR__ "sea"))
    room3 = load_object(__DIR__ "sea");
  if (room1->query("typhoon")) {
    message_vision(RED "台风正在逼近小岛......\n", me);
    return;
  }
  if (room2->query("typhoon")) {
    message_vision(RED "台风正在逼近小岛......\n", me);
    return;
  }
  if (room3->query("typhoon")) {
    message_vision(RED "台风正在逼近小岛......\n", me);
    return;
  }
  time = time();
  ltime = localtime(time * 60);
  if ((ltime[LT_MON] < 4) && (ltime[LT_MON] > 9)) {
    if (random(5) < 4) return;
  }
  if (random(10) > 0) return;
  message_vision(RED "台风来了，风量慢慢变大了......\n" NOR, me);
  room1->set("typhoon", 1);
  room2->set("typhoon", 1);
  room3->set("typhoon", 1);
  remove_call_out("typhoon");
  call_out("typhoon", 30, me);
  return;
}

int typhoon(object me) {
  object room1, room2, room3, *inv;
  int i, j;
  if (!room1 = find_object(__DIR__ "caodi"))
    room1 = load_object(__DIR__ "caodi");
  if (!room2 = find_object(__DIR__ "shore"))
    room2 = load_object(__DIR__ "shore");
  if (!room3 = find_object(__DIR__ "sea"))
    room3 = load_object(__DIR__ "sea");
  message_vision(RED "台风卷过海岛，杀死了一切生气......\n" NOR, me);
  room1->set("typhoon", 0);
  room2->set("typhoon", 0);
  room3->set("typhoon", 0);
  inv = all_inventory(room1);
  for (j = 0; j < sizeof(inv); j++) {
    if (living(inv[j])) {
      inv[j]->die();
    } else {
      if (inv[j]->query("id") != "mu wu")
        destruct(inv[j]);
    }
  }
  inv = all_inventory(room2);
  for (j = 0; j < sizeof(inv); j++) {
    if (living(inv[j])) {
      inv[j]->die();
    } else {
      destruct(inv[j]);
    }
  }
  inv = all_inventory(room3);
  for (j = 0; j < sizeof(inv); j++) {
    if (living(inv[j])) {
      inv[j]->die();
    } else {
      destruct(inv[j]);
    }
  }
  return 1;
}
