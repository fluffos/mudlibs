void create()
{
    set_name( "哈密老人", ({ "hami laoren", "laoren"  }) );
    set( "gender", "男性" );                //性别：男
    set( "age", 60 );                
    set( "long", @LONG
本地的一个老人，看上去是很悠闲的样子，一个人在街到处转。
LONG );
    set( "attitude", "friendly" );
    set( "inquiry", ([
    "此地" : (:ask_where:),
]) );
    setup();
    carry_object( CLOTH_DIR + "cloth2" )->wear();       //粗布衣
}

