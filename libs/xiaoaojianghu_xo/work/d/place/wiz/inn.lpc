// Room: /d/place/wiz/inn.c

inherit ROOM;

#include <ansi.h>
void create() {
  set("short", "狐儿的开发部");
  set("long", @LONG
你现在正站在狐儿的开发部最靠东的客厅，四处杂乱放着蚊香，电热杯
等。到处都可以看到用过的一次性杯子堆满在桌面上，其中有几个还盛满了
烟头。几台开了机箱，裸露着各个零步件的的电脑可怜兮兮地工作着。音箱
里正传出Beyond的歌--《大地》，已经不知道放了几百遍了，但小马仍然流
着口水，带着白痴般的笑容傻愣愣地听着，边听还边跟着哼，显然是崇拜之
至。晚上的时候这里会挤满了XO的巫师：有的在看小说《翻云覆雨》；有的
打游戏( Diablo )( 那就是俺啦 *_^ )；有的两眼通红地紧盯着刚搜出来的
大量colourful pictures，不时发出会心的狂笑；有的在睡觉，发出一阵阵
鼾声，偶尔冒出两句话，傻笑两声，甚至爬下床，绕床跑一圈又躺下接着睡
那也不必多说了。两副扑克牌瞒着狐儿藏在莱因哈特的包里，但大家各忙各
的显然早就忘了它的存在了，只是可惜了俺的五十大毛。
LONG +
    RED "黛玉因为贪吃，没有赶上和JOJO的聚会，正在一边大哭\n" NOR
  );
  set("exits", ([ /* sizeof() == 7 */
    "kunlun": "/d/menpai/kunlun/dating.lpc",
    "chu": "/d/city/chuzhou/jiulou",
    "west": "/d/menpai/wuliang/west/keting.lpc",
    "dali": "/d/city/dali/jiulou.lpc",
    "nanyang": "/d/city/nanyang/chufang.lpc",
    "lanzhou": "/d/city/lanzhou/kezhan.lpc",
    "yangzhou": "/d/city/yangzhou/jiulou.lpc",
    "kongdong": "/d/menpai/kongdong/xuanyuan_gong.lpc",
    "shaolin": "/d/menpai/shaolin/fatang.lpc",
    "wuliang": "/d/menpai/wuliang/dating.lpc",
    "duan": "/d/menpai/duanshi/qianyuan",
    "down": "/d/place/death/gate",
    "xkdao": "/d/place/xkdao/sea",
    "yipin": "/d/zuzhi/yipin_tang/dating",
  ]));
  set("detail", ([
    "diablo": "小马快感地盯着计算机的屏幕,嘴里流着口水,右手神经质地紧抓着鼠标\n"
    "本能地操作着.屏幕上正是地狱中情景,显然深得小马胃口.他正阴笑呢.\n",
    "Diablo": "小马快感地盯着计算机的屏幕,嘴里流着口水,右手神经质地紧抓着鼠标\n"
    "本能地操作着.屏幕上正是地狱中情景,显然深得小马胃口.他正阴笑呢.\n",
    "计算机": "小马快感地盯着计算机的屏幕,嘴里流着口水,右手神经质地紧抓着鼠标\n"
    "本能地操作着.屏幕上正是地狱中情景,显然深得小马胃口.他正阴笑呢.\n",

  ]));

  set("objects", ([]));
  set("no_clean_up", 0);

  setup();
  call_other(CLONE_DIR "board/common_b", "???");
}
void init() {
  if (!wizardp(this_player())) {
    this_player()->die();
  }
}
