//孟婆茶 edit by lin on March 5, 1997
#include <ansi.h>
inherit ITEM;
int effect(object me);
void create()
{
        set_name(GRN "孟婆茶" NOR,({GRN "mengpo tea" NOR, "cha", "tea"}));
        set_weight(1);
        if (clonep())
                 set_default_object(__FILE__);
         else {
                set("long",GRN @LONG
      这就是传说中著名的孟婆茶。每个鬼魂在投胎转世之前，都要喝上
    一碗孟婆茶，据说喝了这碗茶后，你在阳间的一切一切就都会忘得干
    干净净，就此与今世脱离了一切关系。
LONG NOR);
                set("unit", "碗");
    }

 setup();
}

void init()
{
 add_action("do_drink", "drink");
}


int do_drink(string arg)
{
     object me;
     me = this_player();
     if(arg == "tea"){
        //if a ghost
          if( !me->is_ghost() )
          {
              write("你得先死了才能喝这碗茶......\n\n"
"  要不，先死一次？..........\n");
              return 1;
          }
          message_vision("$N犹豫了一会儿，还是把一碗孟婆茶喝了下去\n\n\n\n",me);
          remove_call_out("effect");
          call_out("effect",5,me);
          return 1;
      }
     else { write("你想喝什么？\n\n");
            return 1;
     } 
}
int effect(object me)
{     
//      string stroom;
//      stroom = me->query("startroom");
//      if( stroom[0..7] != "/d/death" && me->query("eff_gin") < 5 )
      if ( me->query("eff_gin") < 5 )
      {
          me->set("eff_kee",(int)me->query("max_kee"));
          me->set("kee",(int)me->query("max_kee"));
          me->set("eff_gin",(int)me->query("max_gin"));
          me->set("gin",(int)me->query("max_gin"));
          me->set("eff_sen",(int)me->query("max_sen"));
          me->set("sen",(int)me->query("max_sen"));
      }
      message_vision(BLU "$N觉得一阵头晕目眩，以前发生的事情似乎忘记了许多许多..........\n\n\n",me);
      tell_object(me,BLU "忘记吧...................\n\n\n\n" NOR);
      destruct(this_object());
      return 1;
}

