inherit ROOM;
void create() {
  set("short", "花园");
  set("long", @LONG
园中种满了各种奇花异草，一年中无论什么季节，都有数种鲜花绽放，到处
一片姹紫嫣红，花丛中不时可见到蝴蝶翩翩穿飞，再加上迎面扑来的浓郁的香气
，使人有一种如入仙境之感。
LONG
  );
  set("exits",
    ([
      "east": __DIR__ "houyuan",
      "west": __DIR__ "kefang",
      "north": __DIR__ "muwu",
      "south": __DIR__ "ceting",
    ]));
  set("objects", ([
    __DIR__ "npc/hudie": 3,
    __DIR__ "npc/mifeng": 2, ]));
  setup();
  replace_program(ROOM);
}
