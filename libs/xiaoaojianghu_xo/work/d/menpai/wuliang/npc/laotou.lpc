//filename : /d/wuliang/npc/laotou.c
//created by qyz at 1996-12-25

int ask_me(object me);

inherit NPC;
void create()
{   set_name("怪老头",({"guai laotou","laotou"}));
    set("gender","男性");
    set("age",65);
    set("attitude","peaceful");
    set("str",50);
    set("per",19);
    set("int",30);
        set("inquiry",([
        "悟剑居" : (:ask_me:), ]));
    set("combat_exp",1000000);
    set("social_exp",1000000);

    set_wugong("sword",100,100,1);
    set_wugong("unarmed",100,100,1);
    set_wugong("lingxiao-shou",80,100,1);
    set_wugong("yanxing",120,120,1);
    set_wugong("liuyun-jian",100,100,1);
    set_xiuwei_by_type("sword",300);
    set_xiuwei_by_type("dodge",400);
    set_xiuwei_by_type("unarmed",300);
    
    setup();
    carry_object(__DIR__"obj/cloth")->wear();
    carry_object(__DIR__"obj/jian3")->wield();
    add_money("coin",130);
}

void init()
{
    object ob;
    
    ::init();
    if(interactive(ob = this_player()) && !is_fighting()){
        remove_call_out("greeting");
        call_out("greeting",1,ob);
    }
}

void greeting(object ob)
{
    if(!ob||!present(ob,environment(this_object())) ) return;
    say("怪老头眯着一双醉眼，对你笑道：“这位"+RANK_D->query_respect(ob)
            +"，到这来是想进悟剑居吗？”\n");
}
int ask_me(object me)
{
     object ob;
     ob = this_player();
     if( ob->query("marks/悟剑居")){
         command("pat"+ ob->query("id"));
         command("say 哈哈，快进去吧，能否参出剑道就看你的造化了！");
         message_vision("怪老头把$N推进门，然后把门又关上。\n",ob);                                                            
         ob->move("/d/menpai/wuliang/wujian_ju");
         return 1; 
         }
     else{
        command("say 要想进悟剑居嘛，必需先要掌门批准。");
          return 1;
     }
}

