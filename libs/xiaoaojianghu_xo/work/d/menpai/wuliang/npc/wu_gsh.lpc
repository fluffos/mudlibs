// wu_gsheng.c
#include <ansi.h>
inherit NPC;

void create()
{
    set_name("吴光胜", ({ "wu gsheng", "wu" }) );
        set("title","无量剑派东宗第六代弟子");
    set("gender", "男性" );
    set("age", 25);
    set("str", 25);
    set("int", 15);
    set("long","吴光胜看起来有些木讷，经常呆呆地看着前方，也不知道想些什么。\n");
    set("combat_exp", 20000);
    set("attitude", "herosim");

    set("force", 1000);
    set("max_force", 1000);
    set("force_factor", 10);
    set("kee",1000);
    set("max_kee",1000);

    set_wugong("unarmed", 70);
    set_wugong("lingxiao-shou", 70);
    set_wugong("jiben-qinggong", 70);
    set_wugong("haoran-zhengqi",50);
    set_wugong("sword",80);
    set_wugong("wuliang-jian",80);
    set_xiuwei("dodge",1100);
    set_xiuwei("unarmed",1200);
    set_xiuwei("sword",1100);
    setup();
        carry_object(__DIR__"obj/yaochi");
    carry_object(__DIR__"obj/cloth")->wear();
    carry_object(__DIR__"obj/changjian")->wield();
    add_money("silver",1);
}

void init()
{
   object ob;
   ::init();
   if(interactive(ob=this_player()) && !is_fighting()){
       remove_call_out("greeting");
       call_out("greeting",1,ob);
       }
}

void greeting(object ob)
{
   if(!ob||!present(ob,environment(this_object())))return;
   say("吴光胜喝道："+HIM"还不快快出去！\n"NOR);
   kill_ob(ob);
   ob->fight_ob(this_object());
}

