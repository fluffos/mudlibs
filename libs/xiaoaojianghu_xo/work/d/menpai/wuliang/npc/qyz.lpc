int accept_fight(object me)
{
    if(!this_player()->query_temp("random_fight") ||
          random(4)<2){
        command("headshake");
        command("我最讨厌打架了，算了吧\n");
        this_player()->set_temp("random_fight",1);
        return 0;
}
        else{
        command("hehe "+this_player()->query("name") );
        command("say 你既然要打，那就试试吧，不许哭啊！");
        return 1;
        }
}

void init()
{
        object ob;
        ::init();
        add_action("do_bit", "bit");
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting",1 , ob);
        }
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        command(chat_emote[random(sizeof(chat_emote))]);
        command("say "+chat_msg[random(sizeof(chat_msg))]);
}

int make_chat(string msg)
{
    if(!is_fighting()){
        string emote;
        emote = chat_emote[random(sizeof(chat_emote))];
        msg = chat_msg[random(sizeof(chat_msg))];
        switch(random(4)){
             case 1 :
                  command("chat* "+emote);
                  break;
             case 2 :
                  command("rumor* "+emote);
                  break;
             case 3 :
                  command("chat "+msg);
                  break;
             default:
                  command(emote);
                  break;
                  }                  
        return 1;
        }else 
        return 0;
}

