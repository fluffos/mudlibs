// xu_yuanzhou.c

#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("许远舟", ({ "xu" }) );
    set("gender", "男性" );
    set("age", 50);
    set("str", 30);
    set("cor", 30);
    set("cps", 30);
    set("int", 25);
    set("ker", 24);
    set("kar", 30);
    set("max_force", 1500);
    set("force", 1500);
    set("force_factor", 3);

    set("long",
        "许远舟身材极为高大，目光犀利。\n");

    create_family("无量剑派", 1, HIW "掌门人" NOR);

    set("combat_exp", 1000000);
    set("score", 200000);

//    set_skill("wuliang-jian", 120);
//      set_jibie( "qi-jian", 120 );
        seteuid( getuid() );
    set_wugong("wuliang-jian",100,70,1);
    set_xiuwei("sword",1000);        
    setup();
    carry_object(__DIR__"obj/changjian")->wield();
}

void attempt_apprentice(object ob)
{
        message_vision("许远舟高兴对$N笑了笑，说：很好很好。\n",this_player());
    command("recruit " + this_player()->query("id") );
}

