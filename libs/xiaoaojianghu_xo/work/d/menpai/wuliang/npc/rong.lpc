//  rong.c

#include <ansi.h>
inherit NPC;

#include "east_master.h"
string ask_me(object);

void create()
{
    set_name("容子矩", ({ "rong ziju", "rong" }) );
    create_family("无量剑派东宗",5,"弟子");
    set("gender", "男性" );
    set("age", 50);
    set("str", 25);
    set("int", 30);
    set("per",24);
    set("long","容子矩为人极为精明,办事干练,无量派上上下下的事都要经他的手.\n");
    set("combat_exp", 10000);
    set("social_exp", 10000);
    set("class_score", 1000);
    set("attitude", "herosim");

    set("inquiry",([
        "武功" : (: ask_me :),]) );
        
    set("force", 2000);
    set("max_force", 2000);
    set("force_factor", 10);

    set_wugong("unarmed", 100);
    set_wugong("lingxiao-shou", 80,80,1);
        set_wugong("wuliang-shenfa", 100,100,1);
    set_wugong("haoran-zhengqi",110);
    set_wugong("sword",100);
    set_wugong("jiben-qinggong",95,95,1);
    set_wugong("wuliang-jian",80,80,1);
        set_wugong("liuyun-jian",90,90,1);
    set_wugong("taizu-quan",60,60,1);
    set_xiuwei_by_type("dodge",1700);
    set_xiuwei_by_type("unarmed",1300);
    set_xiuwei_by_type("sword",1600);
    set_xiuwei_by_type("zonggang",100);
    
    setup();
    carry_object(__DIR__"obj/cloth")->wear();
    carry_object(__DIR__"obj/xuanquan")->wield();
    add_money("coin",10);
}

void init()
{
        object ob;
        ::init();
        if(interactive(ob=this_player()) && !is_fighting()){
            remove_call_out("greeting");
            call_out("greeting",1,ob);
            }
}

void greeting(object ob)
{
        if(!ob||!present(ob,environment(this_object()))
        ||ob->query("family/family_name")!="无量剑派东宗")return;
        say("容子矩笑眯眯地说:过来一块练练吧!\n"NOR);
}

int recognize_apprentice(object who)
{   if(who->query("family/family_name")=="无量剑派东宗" )
    {   if((int)who->query("class_score")>10 )
            return 1;
        else
            command("say 你还是现为师门做点事吧。\n");
            return 0;
    }
    return 0;
}

string ask_me(object who)
{   if( (string)who->query("family/family_name")=="无量剑派东宗" )
        return "嗯，你可以向我学习一些基本的武功，如太祖长拳(taizu-quan)。";
    else
        return "你非我派弟子，还是请回吧。";
}


