
inherit NPC;

void create()
{   set_name("蛐蛐", ({ "qu qu" }) );
    set("race", "野兽");
    set("age", 1);
    set("long", "一只方头方脑的大蛐蛐\n");
    set("limbs", ({ "头部", "身体", "尾巴" }) );
    set("verbs", ({ "bite" }) );

    set_wugong("dodge",100);
    set_xiuwei("dodge",100);

    setup();
}


