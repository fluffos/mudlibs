//西宗细石路

inherit ROOM;

void create()
{
        set("short","细石路");
        set("long",@LONG
你现在走在一条数十丈长的细石路上，脚下的细石发出“吱吱呀呀”的声
音。两旁的清竹在微风的吹拂下，“沙沙”的声音不绝于耳，一股淡淡的香气
从南面的屋子飘来，东面一间青石屋。屋前悬挂着一块木匾，上书「书宅」两
个大字，笔力娟秀，似为女子所题。
LONG    
        );
        set("exits",([ /* sizeof() == 3 */
                "south" : __DIR__"woshi",
                "east" : __DIR__"shufang",
                "west" : __DIR__"keting",
        ]));
        set("objects", ([ /* sizeof() == 1 */
                __DIR__"npc/xiaolang" : 1,
        ]));
        set("outdoors","wuliang");   
        setup();
}

int valid_leave(object me, string dir)
{
        string room;

        if ( dir !="south" ) return ::valid_leave(me, dir);
        if ( objectp( present("xiao lang", environment(me)) ) ) {
                if ( dir == "east" ) room = "书斋";
                else room = "卧室";
                message_vision("小郎拦住了$N去路，对$N说道：\n"+
        "掌门的"+room+"你也敢乱闯？\n", me);
                return notify_fail("你被小郎挡住了去路。\n");
        }
        return ::valid_leave(me, dir);
}

                  
                 

