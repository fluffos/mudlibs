#include <weapon.h>
#include <ansi.h>
#include <mudlib.h>
#include <command.h>
inherit SWORD;
inherit F_SAVE;
inherit F_AUTOLOAD;
void create()
{
        set_name(HIY "长剑" NOR, ({ "chang jian","sword" }) );
        set_weight(1500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
        set("no_drop",1);
        set("cant_sell", "无量剑派的东西，砍了小的脑袋也不敢收。\n");
                set("value", 1000);
                set("material", "steel");
        }
        init_sword(25);
        set("wield_msg", "$N「唰」地一声抽出一把$n握在手中。\n");
        set("unwield_msg", "$N将手中的$n插入腰间的剑鞘。\n");
        setup();
}
int query_autoload()
{
    if( !this_player() ) return 0;
    if( this_player()->query("family/family_name") == "无量剑派西宗")
     {
         this_object()->set("long","一把无量剑派本门使用的长剑，剑上刻着"+HIY "无量剑"+this_player()->query("name")+"" NOR+"几个字\n");
         
         return 1;
     }
     else { return 0;}
}

