//人头..rentou.c

inherit ITEM;

void create()
{
        set_name("人头", ({"ren tou", "head"}));
        set("weight", 2500);
        if ( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一个面目狰狞的人头，还散发者恶臭。\n");
                set("unit", "个");
                set("value", 0);
        }
        setup();
}

