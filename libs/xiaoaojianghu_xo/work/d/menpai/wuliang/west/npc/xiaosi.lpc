//NPC

inherit NPC;
#include "west.h";

void create()
{
        set_name("青衣小厮", ({ "xiao si","dizi" }) );
        set("title","");
        set("gender", "男性" );
        set("age",18);
      
    set("no_kill", "west_wuliang");
        set_wugong("unarmed", 40, 40, 1);
        set_wugong("nanshan-liushi", 10, 10, 1);
        set_xiuwei_by_type("unarmed", 150);
        set("combat_exp",2000);
      
        setup();
//        carry_object(__DIR__"obj/cloth4")->wear();
}

int accept_object(object me,object obj)
{
        if ( me->query("family") && 
                (string)me->query("family/family_name") =="无量剑派西宗" ) {
                write ("青衣小厮对你摇摇头，说道：何必花这冤枉钱呢，去休息室吧。\n");
                return 0;
        }
        if ( (int)obj->value() >=1000 ) {
                me->set_temp("marks/money",1);
                message_vision("青衣小厮对$N笑道：请进厢房休息。\n", me);
                return 1;
        }
        return 0;
}

                


