//Npc: /d/menpai/wuliang/west/npc/xin_shuangqing.c 辛双清
//copied from zuo_zimu.c modified by trill
//Changed by lala 1997/09/08

#define NEITING "/d/menpai/wuliang/west/neiting"
#define KETING  "/d/menpai/wuliang/west/keting"

#include <ansi.h>

string ask_jianhugong();

string change_master(object);
string master_name(object);
string about_yubi(object me);
string leave_west(object);
void get_sword(object);

inherit NPC;
inherit F_MASTER;

inherit "/system/std/char/marry_npc.lpc";

#include "west.h"
#include "west_master.h"

void create() {
  set_name("辛双清", ({ "xin shuangqing", "xin", "shifu", "master", }));
  set("class", "swordsman");
  set("gender", "女性");
  set("age", 46);
  set("str", 22);
  set("cor", 30);
  set("cps", 30);
  set("int", 28);
  set("ker", 28);
  set("kar", 30);
  set("max_force", 1500);
  set("force", 1500);
  set("force_factor", 30);
  set("no_kill", "west_wuliang");
  set("using_force", "haoran-zhengqi");

  set("rank_info/respect", "辛道长");
  set("class", "swordsman");
  set("long", @LONG
她是一位中年道姑，脸色严峻，嘴唇紧闭，不苟言笑。一付心事重重的样子。
不过脸上却没有一丝皱纹，头上没有一丝白发，可能是内功精湛，驻颜有术。
LONG
  );

  create_family("无量剑派西宗", 5, "掌门人");

  set("combat_exp", 400000);
  set("social_exp", 20000);

  set_wugong("lingxiao-shou", 100, 100, 1);
  set_wugong("nanshan-liushi", 100, 100, 0);
  set_wugong("jiben-qinggong", 100, 100, 0);

  set_wugong("literate", 50, 50, 0);

  set_wugong("wuliang-shenfa", 100, 100, 0);
  set_wugong("yanxing", 100, 100, 1);

  set_wugong("haoran-zhengqi", 100, 100, 1);

  set_wugong("wuliang-jian", 100, 100, 0);
  set_wugong("liuyun-jian", 120, 100, 1);

  set_xiuwei_by_type("sword", 1300);
  set_xiuwei_by_type("unarmed", 1100);
  set_xiuwei_by_type("dodge", 1100);
  set_xiuwei_by_type("zonggang", 900);

  set("inquiry", ([
    //                "剑湖宫" : (: ask_jianhugong :),
    "此地": "这里便是无量剑派西宗。",
    "姓名": "嗯，你既知我姓辛，怎会不知在下便是无量西宗掌门人辛双清？",
    "指点武功": (: change_master :),
    "结婚": (: ask_about_marry :),
    "玉壁": (: about_yubi :),
    "出师": (: leave_west :),
  ]));

  setup();
  carry_object(__DIR__ "obj/sword")->wield();
  carry_object(__DIR__ "obj/daopao")->wear();
}

void init() {
  object this, env, me;

  ::init();
  add_action("do_kneel", ({ "kneel", "ketou" }));
  add_action("give_quest", "quest");
  this = this_object();
  env = environment(this);
  me = this_player();
  if (me->query_condition("kill_west_wuliang") &&
    me->query("family/family_name") != "无量剑派西宗") {
    message_vision("辛双清对$N大喝：大胆狂徒，以为无量山是你随便杀人放火的地方吗？\n视我们西宗为无物吗？\n", me);
    set("force_factor", 150);
    set("env/attack", 80);
    me->set_temp("no_leave_west", 1);
    command("kill " + me->query("id"));
    return;
  }
  if ((env->query("short") == "内厅") &&
    (this->query_temp("bai_xin") == me->query("id"))) {
    remove_call_out("tell_mengui");
    call_out("tell_mengui", 1, me);
  }
}

int attempt_apprentice(object me) {
  object this, env;
  string my_id;

  my_id = me->query("id");
  this = this_object();
  env = environment(this);

  if (me->query("hydra/出师/无量剑派西宗")) {
    message_vision(CYN "$N对$n说道：“你既已离开师门，怎么又回来"
      "了呢？”\n" NOR, this, me);
    return 0;
  }

  if (env->query("short") == "客厅") {
    message_vision("辛双清向西一指，对$N说：你先去内厅等我。\n", me);
  }
  if (this->query_temp("bai_list/" + my_id)) {
    command("heng " + my_id);
    message_vision("辛双清冷冷地对$N说：你品性不正，不配入我门。\n", me);
    return 1;
  }
  command("nod " + my_id);
  this->set_temp("bai_xin", my_id);
  this->set_temp("bai_list/" + my_id, 1);
  call_out("back_dating", 100);
  message_vision("辛双清对$N说：既然这样，先拜过祖师爷。\n", me);
  message_vision("辛双清往西离去。\n", me);
  move(NEITING);
  return 1;
}

void back_dating() {
  if (environment(this_object())->query("short") == "内厅")
    move(KETING);
}

void tell_mengui(object me) {
  message_vision(YEL @MSG
辛双清对$N说: 既然入我门下，第一便是要恪守本派门规。你听好了，我无量剑派

        首戒欺师灭祖，不敬尊长；  二戒同门操戈，兄弟不和。
        三戒心猿意马，不用心练功；四戒恃强凌弱，擅伤无辜。
        五戒奸淫好色，调戏妇女；  六戒口出妄言，行事不正。
        
这些门规，你要记牢了，如有违反，我定严惩不殆！！
好了，给祖师爷磕头吧！
MSG NOR, me);
  me->set_temp("bai_xin", 1);
}

int do_kneel(string arg) {
  object sword, me, this;
  mapping family;

  me = this_player();
  this = this_object();
  if (environment(this)->query("short") != "内厅") {
    tell_object(me, "你打算给谁磕头啊？\n");
    return 1;
  }
  if (me->query_temp("bai_xin")) {
    message_vision("$N对着墙上挂着的祖师像拜了八拜，站起身来。\n", me);
    message_vision("辛双清高兴对$N笑了笑，说：很好很好。\n", me);
    message_vision("$n决定收$N为弟子。\n\n"
      "$N跪了下来向$n恭恭敬敬地磕了四个响头，叫道：「师父！」\n",
      me, this);
    recruit_apprentice(me);
    me->set("no_kill", "west_wuliang");
    family = me->query("family");
    tell_object(me,
      sprintf("恭喜您成为%s的第%s代弟子。\n", family["family_name"],
        chinese_number(family["generation"])));
    me->set("class", "swordsman");
    sword = new(__DIR__ "obj/peijian");
    sword->move(me);
    sword->set("long", "一把无量剑派本门使用的长剑，剑上刻着" + HIY " 无量剑" +
      me->query("name") + NOR "\n");
    me->delete_temp("bai_xin");
    this->delete_temp("bai_xin");
    this->delete_temp("bai_list/" + me->query("id"));
    message_vision("辛掌门将一把刻着$N名字的长剑交给了$N，说：这把剑就归你"
      "随身携带使用。\n记住，剑在人在，剑亡人亡！\n", me);
    command("go south");
    command("go south");
    command("go east");
    return 1;
  }
  return 0;
}

int recruit_apprentice(object me) {
  ::recruit_apprentice(me);
  me->set("master", "zhu guangquan");
  message_vision("辛双清对$N说：你现在先去跟褚师兄学点本门的基本功夫吧。\n", me);
  return 1;
}

string change_master(object who) {
  string master_id, msg;
  object me;

  me = this_player();
  if (me->query("marks/悟剑居"))
    return "你的武功已经不低于师父我了。\n";
  if (me->query("family/family_name") != "无量剑派西宗")
    return "这位" + RANK_D->query_respect(me) + "说笑了, 贫道无德无能, 何言指点.\n";
  if (!me->query("master")) {
    me->set("master", "zhu guangquan");
    msg = "从今天起，你就去跟褚光泉师兄学习本门基本武功吧。\n";
  } else if (me->query_temp("defeat_master") != me->query("master")) {
    if (!me->query_temp("fight_master")) {
      me->set_temp("fight_master", me->query("master"));
      msg = sprintf("辛双清沉思了一会...\n好，你跟%s比试一下，再做决定吧。\n",
        master_name(me));
    } else {
      printf("辛双清有些不高兴，皱了皱眉头。\n");
      msg = sprintf("好高骛远，是学不好功夫的，你还是先跟%s多学点东西再说。\n",
        master_name(me));
      me->add("class_score/无量剑派西宗", -1);
    }
  } else {
    me->delete_temp("defeat_master");
    me->delete_temp("fight_master");
    switch (me->query("master")) {
      case "zhu guangquan":
        me->set("master", "ge guangpei");
        msg = "好，你现在可以去跟葛光佩师姐学习了。\n";
        break;

      case "ge guangpei":
        me->set("master", "lin shuangxiu");
        msg = "嗯，不错，现在就让你林师叔来指导你吧。\n";
        break;

      case "lin shuangxiu":
        me->set("master", "xin shuangqing");
        msg = "好徒儿，从今天开始，为师亲自指点于你！\n";
        break;

      case "xin shuangqing":
        me->set("marks/悟剑居", 1);
        msg = "你武功已至如此境界，看来足以领悟悟剑居中本派的武学精华。\n";
        break;
    }
  }
  return msg;
}

string master_name(object me) {
  string master_id;
  master_id = me->query("master");
  switch (master_id) {
    case "zhu guangquan": return "你褚师兄";
    case "ge guangpei": return "你葛师姐";
    case "lin shuangxiu": return "你林师叔";
    case "xin shuangqing": return "为师我";
    default: error("master_name");
  }
}

//lnwm:here is for 四川的无名老人

string about_yubi(object me) {
  string msg;

  me = this_player();

  if (me->query("family/family_name") != "无量剑派西宗") {
    message_vision(CYN "\n辛双清冷冷地看了$P一眼：这是我无量的地方，关你什么事？！\n" NOR, me);
    msg = "以后请不要再问这个问题。";
    return msg;
  }

  if (me->query("lnwm/maowu/问左子穆") == 1) {
    if (me->query("class_score/无量剑派西宗") >= 500) {
      if (!random(20)) {
        tell_object(me, CYN "\n辛双清稍稍犹豫了一下：你最好不要再问这个问题。\n" NOR);
        tell_object(me, CYN "辛双清深深地看了你一眼：当年你的一位师叔就是在参看玉壁的秘密后突然失踪的。\n" NOR);
        me->delete("lnwm/maowu/问左子穆");
        me->set("lnwm/maowu/师叔", 1);
        msg = "玉壁是我无量的秘密，你现在还是不知道的好些，去吧。\n";
        return msg;
      } else {
        msg = "玉壁是我无量的秘密，你现在还是不知道的好些，去吧。\n";
        return msg;
      }
    } else {
      tell_object(me, CYN "\n辛双清略微有些不快：你问这个问题做什么？\n" NOR);
      msg = "你还是想想如何为师门多做些贡献吧。";
      return msg;
    }
  } else {
    tell_object(me, CYN "\n辛双清一脸茫然。\n" NOR);
    msg = "你怎么想起来问这个问题呢？";
    return msg;
  }
}

string ask_jianhugong() {
  return "这个你现在还不到知道的时候。\n";
}

//Hydra:add for 出师 19980507
string leave_west(object me) {
  object this;
  string msg;
  me = this_player();
  this = this_object();

  if (me->query("hydra/出师/无量剑派西宗")) {
    return "你不是已经出师了吗？";
  }
  if (me->query("family/family_name") != "无量剑派西宗") {
    command("? " + me->query("id"));
    return "你又不是我无量西宗之人，何来出师之说。";
  }

  if (me->query("class_score/无量剑派西宗") < 1000) {
    message_vision(CYN "$N对$n道：“你在我门下多年，却不尽心为师门"
      "效力，怎么就想离开了呢？”\n" NOR, this, me);
    me->add("class_score/无量剑派西宗", -10);
    return "你还是先为光大师门多干点事吧！\n";
  }

  if (me->query_jibie("liuyun-jian") >= this->query_jibie("liuyun-jian")) {
    if (!me->query("marks/悟剑居")) {
      me->add("class_score/无量剑派西宗", -10);
      return "你功夫未成，还是在我手下多学几年吧。\n";
    } else if (me->query("age") < 28) {
      message_vision(CYN "$N对$n说道：“你年纪轻轻就出去，人家会以为我无量"
        "无人的。”\n" NOR, this, me);
      me->add("class_score/无量剑派西宗", -10);
      return "过两年再说吧。\n";
    } else {
      command("chat* snow " + me->query("id"));
      message_vision(CYN "$N看看了$n，道：“既然这样，我也知道留你不住了。"
        "出去了可不要忘了为师和你的师兄弟们啊。\n" NOR, this, me);
      me->delete("marks/悟剑居");
      me->delete("master");
      me->set("title", "普通百姓");
      me->delete("family");
      me->set("hydra/出师/无量剑派西宗", 1);
      get_sword(me);
      message_vision("$N恭恭敬敬地跪了下来，向$n磕了四个响头。\n", me, this);
      return "罢了，罢了。。。";
    }
  } else {
    return "学艺未精，出去岂非给我无量西宗丢脸！";
  }
  return "";
}

void get_sword(object me) {
  object *inv;
  inv = all_inventory(me);
  foreach (object ob in inv) {
    if (ob->query("id") == "chang jian"
      && ob->query("name") == HIY "长剑" NOR) {
      say(CYN "辛双清说道，“你身上的剑就不要带着了吧。\n"
        "说着把你身上的长剑拿走了。\n" NOR);
      ob->move(environment(me));
      destruct(ob);
    }
  }
}
