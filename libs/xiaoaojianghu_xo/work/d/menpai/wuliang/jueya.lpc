#include <room.h>

inherit ROOM;

void create()
{
        set("short","绝崖");
        set("long",@LONG
这里已没有出路，前面是一道深渊，隐隐能听到从下面传来隆隆的响声。
西北角上一条大瀑布从高崖直泻而下，便如潮水大至一般。这里已到了山路的
尽头，再也无法往前走了。
LONG);
        set("exits", ([
                "south" : __DIR__"milin1",
        ]));
        set("outdoors","wuliang");
        setup();
}

void init()
{
    add_action("do_tiao", ({ "tiao", "jump" }) );
}

int do_tiao(string arg)
{
    object me;
    int kar;

    me = this_player();
    kar = me->query("kar");
    if( !me->can_act() )
        return notify_fail("你现在没法跳。\n");
    message( "vision",
                        me->name()+"咬了咬牙，纵身跃下旁边深不见底的绝崖。\n",
                environment(me), ({me}) );
        tell_object( me, "你挺身一跃，朝着深渊跳下去......\n"
                                   "你觉耳旁风声呼呼，你的身体不住地下飞坠......\n");
    me->disable_command("verb");
    call_out("end_tiao", 5, me );
    return 1;
}

void end_tiao( object me )
{
    int kar;

    if( !me ) return;

    me->enable_path();
    
    kar = me->query("kar");
    if( kar + random(40) > 100 )
    {
        tell_object( me,   
                               "突然，你撞到一棵大松树上，被弹出丈许，落到一处崖缝\n"
                           "之间，摔了个半死。\n" );
        me->move(__DIR__"yafeng");
        me->unconcious();
    }
    else
    {
        tell_object( me,
                "慢慢地，你失去了知觉......\n");
        me->die();
    }
}

