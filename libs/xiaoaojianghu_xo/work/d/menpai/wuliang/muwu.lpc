inherit ROOM;
void create()
{
        set("short","小木屋");
        set("long",@LONG
这个小屋是给看守的弟子住的，全以杉木料子制成，看上去极为古朴，晚上
这里颇是寒冷，所以门脚放了一个大火盆，除此外，更无其它家具，整个屋子显
得空荡荡的，屋前是一个花园，屋后有一块空地，颇为空旷。
LONG 
);
        set("exits",
        ([
        "north" : __DIR__"wuhou",
        "south" : __DIR__"huayuan",
        ]));
        set("objects",([
        __DIR__"npc/dizi" : 4,
        ]) );
        setup();
        replace_program( ROOM );
}

