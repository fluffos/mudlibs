inherit ROOM;
void create() {
  set("short", "崎岖小路");
  set("long", @LONG
这里山势极为险峻，一条羊肠小道蜿蜒而出，歪歪扭扭一直通向远方，小道
上满是泥泞，稍不小心就会摔倒，旁边就是万丈深渊，往下看，只见大雾封谷，
灰蒙蒙一片，要是摔下去，必定是尸骨无存。
LONG
  );
  set("exits",
    ([
      "northwest": __DIR__ "xiaodao2",
      "southeast": __DIR__ "shanyao",
    ]));
  set("outdoors", "wuliang");
  setup();
  replace_program(ROOM);
}
