inherit NPC;
void create() {
  set_name("无量弟子", ({ "wuliang dizi", "dizi" }));
  set("gender", "男性");
  set("age", 18);
  set_skill("unarmed", 20);
  set_skill("celestrike", 20);
  map_skill("unarmed", "celestrike");
  set_skill("dodge", 20);
  set_skill("stormdance", 20);
  map_skill("dodge", "stormdance");
  set_skill("force", 20);
  set_skill("blade", 20);
  set_skill("parry", 20);
  set("combat_exp", 2000);
  setup();
  //        carry_object(__DIR__"obj/cloth4")->wear();
}
void init() {
  add_action("do_leave", "go");
}
int do_leave(string arg) {
  if (arg == "northup") {
    if (ob->query("class") != "无量剑派") {
      object me;
      me = this_player();
      message_vision("弟子拦住了$N，说：'你不是我派弟子，你请回吧。'\n", me);
      return 1;
    }
  }
}
