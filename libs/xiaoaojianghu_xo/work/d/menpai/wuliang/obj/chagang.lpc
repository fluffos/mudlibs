#include <armor.h>
inherit ITEM;
void create()
{
        set_name("大茶缸", ({ "cha gang" }) );
        set_weight(5000000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                       }
        set("no_get","这茶缸太重了,你拿不起来.\n");
        setup();
}

