//xing.c 邢老头。
//可以从邢老头学绵掌，但要完成4件任务，也就是帮四会忙。
//最初学绵掌，要先帮老头干活，然后把钱还他。
//但这时邢老头只是个临时的师傅。每次学都要干活。
//绵掌练到40级，帮第一个忙：撮合小玉和小郎。
//这以后邢老头是永久的师傅，学绵掌不用干活了。
//绵掌练到60级，帮第二个忙：诛杀邢虎。
//绵掌练到80级，帮第三个忙：打晕负心人小郎，背过来给老头。

inherit NPC;

#include <ansi.h>

int ask_xue();

void create()
{   
        set_name("邢老头", ({ "xing laotou","xing" }) );
        set("long", @LONG
他是管西宗菜园的邢老头。脸上布满皱纹，手臂上青筋绽露，身形略有些
佝偻，似乎饱经风霜，不过红光满面，目蕴微笑，显得神完气足。
LONG
        );
    set("gender", "男性");
    set("age", 52);
    set("attitude", "friendly");

    set("str", 30);
    set("int", 20);
    set("spi", 20);
    set("con", 20);
    set("cps", 20);
    set("cor", 20);

    set("force", 1000);
    set("max_force", 2000);
    set("force_factor", 25);

    set("combat_exp", 200000);
    set("score", 9000);

    set("inquiry", ([
        "工作" : "你想在园子里干活，好啊，不过活是很累人，报酬也是很少的。\n",
        "干活" : "你想在园子里干活，好啊，不过活是很累人，报酬也是很少的。\n",
                "小玉" : "她是我女儿，现在正在花园里。不过最近她好象有心事，老皱着眉头。\n",
                "女儿" : "就是小玉，她正在花园里。不过最近她好象有心事，老皱着眉头。\n",
                "绵掌" : "绵掌是我的家传绝学，不过好久不连，功夫都搁下了。\n",
                "借力打力" : "借力打力是绵掌的精髓，借力打力，四两拨千斤。\n",
                "邢天崃" : "呵呵，难得还有人记得我，不过现在都叫我邢老头。\n",
                "邢虎" : "提他做甚，恶贼还在那横行霸道，真是老天无眼。\n",
                "学习" : (:ask_xue:),
                "学招" : (:ask_xue:),
                "新招" : (:ask_xue:),
                "学新招" : (:ask_xue:),
    ]) );
        set_wugong("mian-zhang", 100, 100, 1);
        set_xiuwei_by_type("unarmed", 3000);

    setup();
        carry_object(CLOTH_DIR + "cloth1")->wear();
}

void init()
{
        object me, obj;
        
        add_action("do_answer","answer");
        ::init();

        me = this_player();

//第一个忙：撮合小玉和小郎。判断是否完成。
        if ( me->query("trill_marks/helped")
                && !(me->query("trill_marks/master")) ) {
                command("haha "+(string)me->query("id"));
                message_vision("邢老头对$N笑道：\n"+
"多谢"+RANK_D->query_respect(me)+"的帮忙了，小玉已经对我说了。\n"+
"来来来，让我来指点你几招。\n", me);
                me->set("trill_marks/master", 1);
                return ;
        }

//第三个忙 打晕小郎，背过来
        if ( !objectp( obj = present( "xiao lang", me) ) ) return ;
        if ( (string)obj->query("name") == "小郎" ) {
                obj->move(environment(me));
                obj->revive();
                if ( me->query("trill_marks/help_xing3") ) {
                        me->delete("trill_marks/help_xing3");
                        me->set("trill_marks/master",3);
                        command("kick "+(string)obj->query("id"));
                        message_vision("邢老头死死的盯着小郎，骂道:\n"+
                "这死小子，竟敢欺负我女儿，对我女儿始乱终弃，我打死你！\n",obj);
                        remove_call_out("kill_ob");
                        call_out("kill_ob", 1, obj);
                        return;
                }
                message_vision("邢老头迷惑的看着$N说道：\n"+
        "好端端的你把小郎背来给我做甚？如果你把他背去给小玉，..."+
    "说不定会有什么好处的。\n", me);
        message_vision("说着说着，老头就乐了。\n", me);         
        return;
        }
}

int accept_object(object me, object obj)
{
        if ( userp(obj) ) return 0;

        if ( me->query("trill_marks/no_help_xing") )
                return notify_fail("邢老头对你说：不想帮我，还想做什么。"
                +"过几天再说吧。\n");

//第二个忙 杀邢虎,判断是否完成。
        if ( (string)obj->query("name") == "邢虎的人头" ) {
                if ( (int)me->query("trill_marks/master") >1 ) {
                        write("邢老头最后一个仇家已经被你干掉了！");
                        return 0;
                }
                if ( me->query("trill_marks/help_xing2") ) {
                        me->set("trill_marks/help_xing2", 0);
                        me->set("trill_marks/master", 2);
                        command("smile "+(string)me->query("id"));
                        message_vision("邢老头长叹一声，对$N说道：\n"+
                "我这一生最后一件恨事，在"+RANK_D->query_respect(me)+
                "你的帮住下终于了结了。\n多谢你了。\n", me);
                        return 1;
                }
                command("look "+(string)me->query("id") );
                message_vision("邢老头冲着$N哈哈一乐，笑道：\n"+
        "好小子，居然打听到老头我唯一的仇家是邢虎，提了他的人头来见\n"+
        "我，多谢多谢了。我身无长物，无所报答，就教你几招绵掌吧。\n", me);
                me->set("trill_marks/master", 2);
                return 1;
        }

        if  ( !(me->query_temp("worked")) &&
                (int)obj->value() != 1000 ) return 0;
        me->set_temp("worked", 0);

//学到40级时，老头不教了，要求帮他一个忙。
//第一个忙 撮合小玉和小郎。
        if ( (int)me->query_jibie("mian-zhang") >=40 ) { 
                if( me->query("trill_marks/master") < 1) {
                        message_vision("邢老头对着$N摇摇头，说道：\n"+
                        "年轻人要知足，前几天我心情好教了你三招，你还想把\n"+
                        "老头我这点功夫都掏走吗？\n", me);
                        if ( random(2) ) return 0;
                        me->set("trill_marks/help_xing1", 1);
                        message_vision("邢老头顿了顿，又说道：\n"+
                        "不过嘛，如果你能替我办件事，如果办成了的话，\n"+
                        "老头我再教你几招。\n", me);
                        write("如果你想帮他就回答(answer)能，"+
                        "否则就回答(answer)不。\n");
                        return 1;
                }
                write("邢老头已经答应教你了，钱你自己留着吧。\n");
                return 0;
        }

//最初学绵掌：先干活，再把钱还邢老头。
        command("look "+(string)me->query("id"));
        if ( random(3) ) {
                command("smile "+(string)me->query("id"));
                command("say 不要钱？看来想从老头我这里学几招了，\n"+
                "今天我心情好就教你几招吧。\n");
                me->set_temp("trill_marks/master", 1);
                return 1;
        }
        command("hehe "+(string)me->query("id"));
        command("say 居然有干活不要钱的，少见少见。\n"+
                "不要就不要，钱老头我自己留着了。\n");
        return 1;
}

int ask_xue()
{
        object me;
        int i ;
        
        me = this_player();
        i = (int)me->query_jibie("mian-zhang");

        if ( me->query("trill_marks/no_help_xing") ) {
                message_vision("邢老头不满的对$N说：既然不想帮我，"
                +"还问什么？过几天再说吧。\n", me);
                return 1;
        }

        if ( !(me->query("trill_marks/master")) ) {
                message_vision("邢老头不耐烦的对$N说：\n"+
        "学什么学，没看到我正忙着嘛，有工夫就来帮我干点农活。\n\n", me);
                write ("你还是先帮他干活，再试试能不能学。\n");
                return 1;
        }

        if ( i > 90) { 
                write ("邢老头告诉你：一套绵掌都已经传授给\n你了。没有新招了。\n");
                return 1;
        }
        if ( i != 40 && i != 60 && i != 80 ) {
                message_vision("邢老头对$N说道：\n"+
        "师傅领进门，修行在自身嘛，先自己练练。\n", me);
                return 1;
        }
        i = i/20-1;     
        message_vision("邢老头对$N说道：\n"+
        "要想学新招，你得先帮我个忙。能帮我吗?\n", me);
        me->set_temp("trill_marks/ask",1);
        me->set("trill_marks/help_xing"+i,1);
        write("如果你想帮他就回答(answer)能，否则就回答(answer)不\n");
        return 1;
}

int do_answer(string arg)
{
        object me, ob, axe;
        
        me = this_player();
        ob = this_object();

        if ( !(me->query_temp("trill_marks/ask")) )
                return notify_fail("什么？你想干什么？\n");

//给出第一个任务：撮合小玉。    
        if ( me->query("trill_marks/help_xing1") && arg == "能" ) {
                command("say "+(string)me->query("name")+
        " 小玉最近好象有心事。我猜可能是喜欢上了某个小子了。\n"
        +"却一直不肯说，你去把她的心事了结了吧，怎么样？这个忙很容易帮吧？");
                return notify_fail("邢老头笑着说：快去，快去。\n");
        }

//给出第二个任务：诛杀邢虎。
        if ( me->query("trill_marks/help_xing2") && arg == "能" ) {
                command("say "+"我要你把邢虎的人头提来。\n");
                command("tell "+(string)me->query("id")+
                " 邢虎原是我的义子，十年前他勾结外人妄图弑父，下毒\n"+
                "想害死我和小玉，幸亏西宗的前掌门救了我和小玉的一命，可掌门说\n"+
                "冤家易结不易解，要我饶他一命，我饶了他，可这小子死不悔改，这\n"+
                "十年一直为非作歹，你给我把他杀了，提他的人头来。"+
                "对了给你一把大斧子，拿这把斧子可以干净利落的剁下他的头来了。\n");
                axe=new(__DIR__"obj/axe");
                axe->move(me);
                return notify_fail("邢老头对你说：赶紧去，"+
                        "留他一天就多危害一天。\n");            
        }

//给出第三个任务：擒拿小郎。
        if ( me->query("trill_marks/help_xing3") && arg == "能" ) {
                message_vision("$n阴沉着脸，一改往昔笑眯眯的样子。\n", ob);
                command("sya "+(string)me->query("name")+
                "我要你把小郎这狗东西给我抓到我面前来。\n");
                return notify_fail("邢老头告诉你：不要问为什么了，快去。\n");
        }

//如果回答不，30分钟后才能再问老头。
        me->set("trill_marks/no_help_xing",1);
        remove_call_out("del_marks");
        call_out("del_marks", 1800, me);
        return notify_fail("邢老头失望的看着你，说到：下次吧。\n");
}

int recognize_apprentice(object me)
{
        if (!(int)me->query_temp("trill_marks/master") &&
                !(int)me->query("trill_marks/master") )
                return 0;
        return 1;
}

void del_marks(object me)
{
        if ( me->query("trill_marks/no_help_xing") )
                me->delete("trill_marks/no_help_xing");
        return ;
}

