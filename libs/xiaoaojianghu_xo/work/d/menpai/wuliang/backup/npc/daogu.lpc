// daogu.c

inherit NPC;

#include "west.h";

//int talk_me();

void create()
{
        set_name("道姑", ({ "daogu"}) );
        set("title","执法弟子");
        set("gender", "女性" );
        set("age", 33);
        set("str", 20);
        set("cor", 22);
        set("cps", 20);
        set("per", 20);
        set("int", 20);

        set("max_kee", 500);

        set("attitude", "heroism");
    set("no_kill", "west_wuliang");

        set("max_force", 400);
        set("force", 400);
        set("force_factor", 3);

        set("long","她是一位无量剑派西宗的弟子，脸色肃穆，一副吓人的样子。\n");

        set_xiuwei_by_type("sword", 500);
        set_xiuwei_by_type("unarmed", 500);
        set_wugong("wuliang-jian",60,60, 0);
        set_wugong("liuyun-jian", 60, 60, 1);
        set_wugong("nanshan-liushi", 70, 70, 1);
        set_wugong("yanxing", 70, 70, 1);
    
        set("combat_exp", 10000);
        set("social_exp", 5000);
        set("positive_score",1000);
    setup();

    carry_object(__DIR__"obj/sword")->wield();
    carry_object(__DIR__"obj/daopao")->wear();
}

void init()
{
    object me;
    me = this_player();
    if ( me->query_condition( "kill_west_wuliang" ) )
    {
     message_vision("道姑对$N大喝：大胆狂徒，以为无量山是你随便杀人放火的地方吗？\n视我们西宗为无物吗？\n", me );
        set("force_factor", 30);
        set("env/attack", 70);
        command( "kill " + me->query( "id" ) );
        me->set_temp("pending/no_leave_west", 1);
        return ;
    }
}


