// nv_dizi.c

inherit NPC;
#include "west.h"
#include "west_master.h"

void create()
{
        set_name("葛光佩", ({ "ge guangpei", "ge", "dizi"}) );
    set("gender", "女性" );
    set("age", 22);
   
    set("str", 20);
    set("cor", 20);
    set("cps", 20);
    set("per", 23);
    set("int", 20);
    set("no_kill", "west_wuliang");
    set("attitude", "peaceful");

    set("max_force", 1000);
    set("force", 1000);
    set("force_factor", 2);

    set("long", @LONG
她是一位无量剑派西宗的女弟子，瓜子脸，柳叶眉，白净的脸皮上有几个
小麻子。更添了几分姿色。长的倒是挺出众的,就是嘴唇薄了点。
LONG
        );
        set("inquiry", ([
                "干光豪" : "他是东宗的弟子，我不认识，真的不认识。",
        ]));
    create_family("无量剑派西宗", 6, "弟子");

    set("combat_exp", 50000);

        set_wugong("unarmed",100,100,1);
    set_wugong("nanshan-liushi",80,80,1);
    set_wugong("jiben-qinggong", 100, 100, 1);
    set_wugong("haoran-zhengqi",80,80,1);
    set_wugong("sword",130,130,1);         
    set_wugong("wuliang-shenfa", 100, 100, 1);
    set_wugong("yanxing", 80, 80, 1);
    set_wugong("wuliang-jian",80,80,1);
    
    set_xiuwei_by_type("sword",700);
    set_xiuwei_by_type("dodge",640);
    set_xiuwei_by_type("unarmed",600);

        setup();

        carry_object(__DIR__"obj/sword")->wield();
        carry_object(__DIR__"obj/pink-cloth")->wear();
}

