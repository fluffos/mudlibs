// Npc: xiaolang.c
//by trill 02/04/97

inherit NPC;

int ask_me();

void create()
{

        set_name("小郎", ({"xiao lang", "nan dizi", "dizi"}) );
        set("long", @LONG
他身形修长，猿臂熊肩，剑眉虎目，二十几岁的年纪，体形并不特别魁梧雄
壮，但一看便知是矫捷勇悍的年轻人。
LONG
        );
        set("gender", "男性");
        set("attitude", "heroism");
    set("no_kill", "west_wuliang");

        set("per", 25);

        set("age", 24);
        set("max_kee", 500);
        set("kee",500);
        set("max_force", 600);
        set("force", 600);
        set("combat_exp", 8000);
        set("inquiry", ([
                "心事" : "我是有心事，可谁能帮助我？ 说着说着，就长叹一声。\n",
                "小玉" : "小玉啊，她是我的师妹。",
                "邢小玉" : "小玉啊，她是我的师妹。",
                "帮助" : (:ask_me:),
                "帮忙" : (:ask_me:),
        ]));
        set_wugong("unarmed",80,80,1);
    set_wugong("nanshan-liushi",40,30,1);
    set_wugong("haoran-zhengqi",50,40,1);
    set_wugong("sword",60,40,1);         
    set_wugong("wuliang-jian",40,20,1);
    set_xiuwei_by_type("parry",100);
    set_xiuwei_by_type("sword",100);
    set_xiuwei_by_type("dodge",100);
    set_xiuwei_by_type("unarmed",100);
        
        create_family("无量剑派西宗", 6, "弟子");
        setup();
    carry_object(__DIR__"obj/sword")->wield();
    carry_object(__DIR__"obj/baishan")->wear();
}

void init()
{
        add_action("do_answer", "answer");
        add_action("do_answer", "huida");
}

int ask_me()
{
        object ob, me;

        me = this_player();
        if ( me->query_temp("trill_marks/helping") ) {
                message_vision("小郎对你说道：赶紧去吧，我在这里等你。\n", me);
                return 1;
        }
        if ( me->query_temp("trill_marks/lost") ) {
                command("kick "+(string)me->query("id"));
                message_vision("小郎看着$N，叹了一口气，说到：帮不上别人的忙，就不要\n"+
                "随便允诺嘛。下次吧。\n", me);
                remove_call_out("del0");
                call_out("del0",3000,me);
                return 1;
        }
        if ( me->query("trill_marks/helped") ) {
                command("touch "+(string)me->query("id"));
                message_vision("小郎笑着对$N说：多谢您的帮忙！\n", me);
                return 1;
        }
        if ( me->query_temp("trill_marks/no_help") ) {
                message_vision("小郎看着$N皱了皱眉头，说道：\n"+
                "你既然不想帮我，还问什么？", me);
                return 1;
        }
        command("look "+(string)me->query("id"));
    message_vision("小郎对$N说到：我有是需要人帮我。你能帮我吗？\n", me);
        me->set_temp("trill_marks/helping",1);
        write("如果你想帮他,回答(answer)能,否则回答(answer)不\n");
        return 1;
}

int do_answer(string arg)
{
        object me, letter;
        
        me = this_player();
        if ( !(me->query_temp("trill_marks/helping")) )
                return notify_fail("什么？\n");
        if ( arg == "不" ) {
                command("sigh");
                me->set_temp("trill_marks/no_help", 1);
                me->set_temp("trill_marks/helping", 0);
                write("小郎看着你，叹到：那就算了罢。\n");
                return 1;
        }
        if ( arg == "能" || arg == "可以" ) {
                letter = new(__DIR__"obj/letter");
                letter->move(me);
                write("小郎悄悄给你一封信。\n");
                command("whisper "+(string)me->query("id")+" 请你把这封信给花园里的那个姑娘。赶紧去吧！");
                remove_call_out("del1");
                call_out("del1", 600, me);
                write("小郎期盼的看着你。\n");
                return 1;
        }
        write("你要回答什么？\n");
        return 1;
}

int accept_object(object me, object ob)
{
        if ( userp(ob) ) return 0;
        if ( (string)ob->query("id") == "yu lianhuan" ) {
                if ( !(me->query_temp("trill_marks/back")) ) {
                        message_vision("小郎皱着眉头看着你，不满的对你说道；\n"+
        "这是小玉的吧，你从哪里得到的？\n", me);
                        return 0;
                }
                me->set_temp("trill_marks/back", 1);
                message_vision("$N对小郎说:\n小玉让我告诉你，她在花园等你。\n", me);
                command("jump");
                command("wave "+(string)me->query("id"));
                message_vision("小郎向西离去。", me);
                this_object()->move("/d/menpai/wuliang/west/huayuan");
                me->set("trill_marks/helped", 1);
                return 1;
        }
        return 0;
}               

void del0(object me)
{
        if ( me->query_temp("trill_marks/lost") )
                me->delete_temp("trill_marks/lost");
        return ;
}

void del1(object me)
{
        object ob;

        if ( !(me->query_temp("trill_marks/helping")) ) return ; 
        me->delete_temp("trill_marks/helping");
        me->set_temp("trill_marks/lost", 1);
        write("你迟迟未把信送到，小郎的忙你是帮不上了。\n");
        if ( objectp( ob = present("letter", me)) ) 
                destruct(ob);
        return ;
}
        





