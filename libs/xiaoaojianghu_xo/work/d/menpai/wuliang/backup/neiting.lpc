inherit ROOM;
inherit MARRIAGEROOM;

void create()
{
    set("short", "内厅");
    set("long", @LONG
这里是西宗的内厅，是西宗供奉历代掌门神位的地方，也是举行收徒，惩戒
犯门规弟子，开除恶徒的地方。这里光线灰暗，香烟缠绕。内墙上安放着一个神
龛，里头端放着历代掌门的神位。神龛正对的地方摆着一张檀木桌，桌上供奉着
几盘果品，桌角点着一盏长明灯，正中端放着一个香炉，两个道姑肃立在桌子的
两侧。
LONG
     );
    set("no_clean_up", 0);
    
    set("exits", ([ /* sizeof() == 3 */
         "south" : __DIR__"zoulang",
         "north" : __DIR__"xishi_lu",
        ]));
    set("objects" , ([ /* sizeof() == 3 */
        __DIR__"npc/zhang_shuanglai" : 1,
        __DIR__"npc/daogu" : 2,
    ]));
        
    setup();
} 
void init()
{
    add_action( "do_swear", "swear" );
}


int valid_leave( object me, string dir )
{
    object ob;

    if ( objectp( ob = present( "zhang shuangyi", environment( me ) ) ) )
    {
        if ( ob->can_act() && me->query_temp("no_leave_west")
            && me->query_condition( "kill_west_wuliang") )
        return notify_fail( "\n张双翌对你喝到，还想跑？\n" );
    }
    if ( objectp( ob = present( "daogu", environment( me ) ) ) )
    {
        if ( ob->can_act() && me->query_temp("no_leave_west")
            && me->query_condition( "kill_west_wuliang") )
        return notify_fail( "\n道姑对你喝到，还想跑？\n" );
    }

    return ::valid_leave( me, dir );
}


