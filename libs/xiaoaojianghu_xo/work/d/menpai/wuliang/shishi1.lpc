#include <room.h>

inherit ROOM;

void create()
{
        set("short","圆形石室");
        set("long",@LONG
只见所处之地是座圆形石室，石壁上镶了一块大水晶，约有铜盆大小，从水
晶中透出些许光亮；透过水晶可以看到碧绿的水流不住幌动，鱼虾水族来回游动
；室内放着一只石桌，桌前有凳，桌上竖着一面铜镜，镜旁放着些梳子钗钏之属
，铜镜上生满了铜绿，桌子上也是尘土寸积，不知已有多少年无人来此，石室的
西南隅有一道石门，通向另一个石室。
LONG 
);
        set("exits", ([
        "west" : __DIR__"tongmen",
        "southwest" : __DIR__"shiji",
         ]));
        create_door("west","铜门","east",DOOR_CLOSED);
        create_door("southwest","石门","northeast",DOOR_CLOSED);
        setup();
        replace_program( ROOM );
}

