#include <room.h>

inherit ROOM;

void create()
{
        set("short","琅寰福地");
        set("long",@LONG
这“琅寰福地”是个极大的石洞，洞中一排排的列满木制书架，可是架上空
荡荡的，一本书都没有，只是贴满了签条，尽是“昆仑派”，“少林派”，“四
川青城派”，“大理段氏”等等名称，“少林派”的签条下注“缺易筋经”，“
丐帮”的签条下注“缺降龙十八掌”，“大理段氏”的签条下注“缺一阳指法，
六脉神剑剑法，憾甚”的字样。
LONG 
);
        set("exits", ([
        "south" : __DIR__"shishi3",
         ]));

    setup();

    replace_program(ROOM);
}

