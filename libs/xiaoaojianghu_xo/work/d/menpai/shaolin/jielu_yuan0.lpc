#include <ansi.h>

inherit ROOM;

void create()
{
    set("short", YEL "戒律院正门" NOR);
    set("long",@LONG 
这是戒律院的正门。稀疏的翠竹旁，两名武僧站在大门的旁边。虽然这
座小院看起来并不起眼，然而这里却是令全寺僧人又敬又怕的所在。一般没
有什么事，大家都不在这里多作停留，更不要提接到戒律院的传唤了。
LONG);

    set("exits", ([
        "west" : __DIR__"jielu_yuan1",
        "east" : __DIR__"zhulin_xiaodao10",
    ]));
    set("objects", ([
        __DIR__"npc/huwei1" : 2,
    ]));

    setup();
}

int valid_leave(object me, string dir)
{
   object ob;   
   if ( (dir == "west") 
        && (ob = present("shaolin sengbing", this_object())) 
        && (ob->can_act()) )
   {
        if ( !me->query("announced") 
        && ( me->query("title") != RED"少林寺"YEL"戒律院"BLU"武僧" ))
                return notify_fail(
"少林僧兵跨上一步，喝道：“这是什么地方？！戒律院也是乱闯的？！”\n");
        if ( me->query("announced") )
write("少林僧兵虎着脸叫道：“算你识相，主动来投案，不用劳烦我们去请你。”\n");
   }
        return ::valid_leave(me, dir);
}

