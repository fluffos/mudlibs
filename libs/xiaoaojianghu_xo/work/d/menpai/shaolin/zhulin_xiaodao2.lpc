#include <room.h>

inherit ROOM;

void create()
{
    set("short", "竹林小道");
    set("long", @LONG
这里是少林寺的竹林小道，往东是般若堂，往西是达摩院。
LONG
    );
    set("exits", ([ 
        "east"      : __DIR__"banruo_tang1",
        "west"      : __DIR__"damo_yuan1",
        "south"     : __DIR__"zhulin_xiaodao1",
        "north"     : __DIR__"zhulin_xiaodao3",
    ]));
    set("outdoors", "shaolin");
    setup();
    replace_program(ROOM);
}                       

