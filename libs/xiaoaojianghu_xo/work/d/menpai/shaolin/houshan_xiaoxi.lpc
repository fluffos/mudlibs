// hou shan xiao xi : /d/shaolin/houshan_xiaoxi.c

inherit ROOM;

void init();
int do_look(string);
int do_jump(string);
int do_study(string);

void create()
{
    set("short","后山小溪");
    set("long",@LONG
你掉入一条小溪中，呛了好大一口水。你费了九牛二虎之力才爬上一块溪水
中突出的岩石，活象个落汤鸡。岸(bank)边有只蛤蟆冲着你直乐。
LONG
    );

    set("item_desc", ([
        "bank" : "岸上就是少林寺的后山。\n",
    ]) );

    setup();
}

void init()
{
    add_action("do_jump", "jump");
    add_action("do_look", "look");
    add_action("do_study", "study");
}

int do_jump(string arg)
{
    object me = this_player();

    if (arg != "bank" )
        return command("jump "+arg);
    message_vision("$N提足一口气，跃回了岸上。\n", me);
    me->move(__DIR__"houshan_pubu");

    return 1;
}

int do_look(string arg)
{
    object me = this_player();

    if (arg != "jing" && arg != "yijin jing")
        return command("look "+arg);
    if (!present("yijin jing", me))
        return command("look "+arg);

    message_vision("易筋经在水中浸湿了，\n", me);
    message_vision("每一页上忽然都显出一个怪僧的图形，姿势各不相同。\n", me);

    return 1;
}    

int do_study(string arg)
{
    object me = this_player();

    if (arg != "jing" && arg != "yijin jing")
        return command("study "+arg);
    if (!present("yijin jing", me))
        return command("study "+arg);
    if ((int)me->query_skill("force", 1) < 30 
            || (int)me->query_skill("force", 1) > 100)
        return command("study "+arg);

    me->receive_damage("gin", 20);
    me->improve_skill("force", me->query("int"));
    message_vision("$N阅读易筋经，内功心法有所进步，\n", me);

    return 1;
}
