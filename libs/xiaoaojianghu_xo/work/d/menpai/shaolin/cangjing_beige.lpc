// 藏经阁北阁 : /d/shaolin/cangjing_beige.c

inherit ROOM;

void create()
{
    set("short","藏经阁北阁");
    set("long",@LONG
这是一间收拾得极为朴素的楼阁，中间放着一张竹制的茶几，有位老僧坐在
蒲团上正翻阅着经书。往北是藏经阁的北阁书库，往南是一条长长的走廊。
LONG
    );
    set("exits",([
        "south" : __DIR__"cangjing_zoulang4",
        "north" : __DIR__"cangjing_shukun",
    ]) );

    setup();
}

