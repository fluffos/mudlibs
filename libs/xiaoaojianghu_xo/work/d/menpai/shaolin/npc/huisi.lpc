//huisi.c 十八罗汉之降龙罗汉
inherit NPC;
inherit F_MASTER;


void create()
{
        set_name("慧思",({ "hui si","hui","monk" }) );
        set("long",@LONG
这就是十八罗汉之首降龙罗汉，他身材瘦高，须发花白，身穿一袭金边红色袈裟。
太阳穴高高鼓起，分明身怀绝世武功。
LONG    );


        set("title", "降龙罗汉");
        set("gender", "男性");
        set("attitude", "friendly");
        set("class", "bonze");

        set("age", 52);
        set("str", 25);
        set("int", 25);
        set("con", 25);
        set("dex", 25);
    set_hp("kee",1000);
    set_hp("sen",900);
        set("force", 2000);
        set("max_force", 2000);
    set("force_factor",30);
        set("combat_exp", 100000);
        set("class_score", 5000);
    set("positive_score",3000);
    set("social_exp",5000);

    set_wugong("shaolin-shenfa", 185,160,1);
    set_wugong("shaolin-xinfa",120,100,1);
    set_wugong("xumishan-zhang",60,60,1);
    set_wugong("fuhu-quan",60);

    set_xiuwei_by_type("unarmed",2500);
    set_xiuwei_by_type("dodge",2100);
    set_xiuwei_by_type("zonggang",300);

        create_family("少林派", 37, "弟子");

        setup();

    carry_object(CLOTH_DIR "hong-jiasha")->wear();
}


#include "hui.h"


