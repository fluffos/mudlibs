#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create()
{
    set_name("玄难", ({"xuan nan","xuannan","xuan","nan"}));
    set("long",@LONG
他是一位须眉皆白的老僧，当他抬头扫视四周时，眼光无比威严。
在他的目光下，你不禁心里打起了小鼓，不知自己什么时候就会犯
过失，撞在老僧的手里。这位威严的老僧便是少林寺戒律院的首座。
LONG   );
    set("title",RED"少林寺"YEL"戒律院"MAG"首座"NOR);
    set("rank_info/respect", "玄难大师");
    set("gender", "男性");
    set("attitude", "friendly");
    set("class", "bonze1");
    set("family",([
        "title"         :"少林寺戒律院首座",
        "generation"    :36,
        "family_name"   :"少林派",
        "master_name"   :"灵门",
        "master_id"     :"ling men",
        ]) );

    set("age", 72);
    set("str", 30);
    set("int", 30);
    set("con", 30);
    set("spi", 30);
    set("ker", 30);

    set("max_kee", 1500);
    set("kee", 1500);

    set("max_force", 3000);
    set("force", 3000);
    set("force_factor", 100);

    set("combat_exp", 1000000);
    set("social_exp", 200000);
    set("class_score", 500000);

    set_wugong("longzhua-shou",300,100,1);
    set_wugong("shaolin-shenfa",350,100,1);
    set_wugong("shaolin-neigong", 300,100,1);
    set_xiuwei_by_type("unarmed",6000);
    set_xiuwei_by_type("dodge",6000);
    set_xiuwei_by_type("zonggang",500);

    set("inquiry",([
        "武功" : "少林僧人习武只为健体强身，可不是为了逞强好胜。",
    ]) );

    setup();

    carry_object(CLOTH_DIR"jiasha2")->wear();
}


