// zhi zhan : /d/shaolin/npc/zhizhan.c

inherit NPC;

string ask_sec();
string ask_word();

void create()
{
    set_name("止湛",({"zhi zhan","zhizhan"}));
    set("title","少林寺菩提院守卫僧");
    set("gender","男性");
    set("age", 25);
    set("str", 32);
    set("cor", 30);
    set("cps", 30);
    set("int", 36);
    set("per", 33);
    set("con", 34);
    set("kar", 35);

    set("long","一个青年僧人\n");
    set("attitude","peaceful");
    set("combat_exp",50000);

    set("max_force", 300);
    set("force", 300);
    set("force_factor", 3);

    set_wugong("unarmed", 60);
    set_wugong("dodge", 60);

    set_temp("apply/attack", 60);
    set_temp("apply/defense", 80);
    set_temp("apply/damage", 70);
    set_temp("apply/armor", 90);

    create_family("少林派",37,"弟子");

    set("inquiry",([
        "秘密" : (: ask_sec :),
        "一梦如是" : (: ask_word :),
    ]) );

    setup();
}

string ask_sec()
{
    this_player()->set_temp("marks/菩", 1);
    return "一梦如是";
}

string ask_word()
{
    return "你问这个干什么？";
}

