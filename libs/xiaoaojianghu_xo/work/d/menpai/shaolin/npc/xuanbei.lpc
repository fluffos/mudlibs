// Npc: xuan bei : /d/shaolin/xuanbei.c

inherit NPC;
inherit F_MASTER;

void create()
{
    set_name("玄悲", ({"xuan bei","xuanbei","xuan","bei"}));
    set("long",
        "他是一位慈眉善目的老僧，须眉皆白。\n"
        "他便是少林寺罗汉堂的首座。\n"
    );
    set("title","少林寺罗汉堂长老");
    set("rank_info/respect", "玄悲大师");
    set("gender", "男性");
    set("attitude", "friendly");
    set("class", "bonze");
    set("family",([
        "title"         :"罗汉堂长老",
        "generation"    :36,
        "family_name"   :"少林派",
        "master_name"   :"灵门",
        "master_id"     :"ling men",
        ]) );

    set("age", 70);
    set("str", 30);
    set("int", 30);
    set("con", 30);
    set("spi", 30);
    set("ker", 30);

    set("max_kee", 1500);
    set("kee", 1500);

    set("max_force", 2000);
    set("force", 2000);
    set("force_factor", 10);

    set("combat_exp", 1000000);
    set("social_exp", 200000);
    set("class_score", 500000);

//    set_wugong("baiyu-xinfa", 60); 
    set_wugong("literate", 110);
    set_wugong("xumishan-zhang",400,400,1);
    set_wugong("shaolin-shenfa",300,300,1);
    set_xiuwei("unarmed",8000);
    set_xiuwei("dodge",6000);
//    set_xiuwei("parry",450);
    set_xiuwei("force",6000);

    set("inquiry",([
        "武功" : "少林僧人习武只为健体强身，可不是为了逞强好胜。",
    ]) );

        setup();

    carry_object(CLOTH_DIR"jiasha1")->wear();
}

