// xiao sha mi : /d/shaolin/npc/xiaoshami.c

inherit NPC;

string ask_me();
void call_wuseng(object who);

void create() {
  set_name("小沙弥", ({ "xiao shami", "xiao", "shami" }));
  set("gender", "男性");
  set("age", 12);
  set("str", 12);
  set("cor", 10);
  set("cps", 10);
  set("int", 16);
  set("per", 13);
  set("con", 24);
  set("kar", 25);
  set("class", "bonze");
  set("long", "一个稚气未脱的小沙弥\n");
  set("attitude", "peaceful");
  set("combat_exp", 500);

  set("max_force", 30);
  set("force", 30);
  set("force_factor", 1);

  set_wugong("unarmed", 10);
  set_wugong("dodge", 10);
  //    set_wugong("force", 10);

  set_temp("apply/attack", 10);
  set_temp("apply/defense", 10);
  set_temp("apply/damage", 10);
  set_temp("apply/armor", 10);

  create_family("少林派", 40, "弟子");
  set("title", 0);
  set("inquiry", ([
    "方丈": (: ask_me :),
  ]));

  setup();
}

string ask_me() {
  mapping fam;

  if (!(fam = this_player()->query("family"))
    || fam["family_name"] != "少林派")
    return "方丈大师不见外人，施主请回！";
}

int refuse_killing(object who) {
  object ob = this_player(1);
  ob->set("marks/kill_shaolin");
  say("小沙弥说道:\"佛门圣地,还望施主放下屠刀,立地成佛.\"\n");
  call_out((: call_wuseng, this_player(1) :), 2);
  return 0;
}

void call_wuseng(object killer) {
  int i;
  object ob;
  if (!this_object() || !this_object()->is_fighting()) return;
  if (environment(killer) != environment())
    return;
  if (present("monk", environment())) return;
  say("几个护卫僧走了过来.\n");
  for (i = 0; i < 4; i++) {
    ob = new(__DIR__ "huwei1");
    ob->move(environment());
    ob->kill_ob(killer);
    killer->fight_ob(ob);
  }
}
