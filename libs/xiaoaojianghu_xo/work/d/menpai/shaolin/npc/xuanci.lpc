// Npc: xuan ci : /d/shaolin/xuanci.c

inherit NPC;

inherit F_MASTER;

string ask_ye();
string ask_biguan();

void create() {
  set_name("玄慈", ({ "xuan ci", "xuanci" }));
  set("long",
    "他是一位白须白眉的老僧，矮矮的身材，却透着一股英气。\n"
    "他便是少林寺的方丈\n"
  );

  set("nickname", "少林寺方丈");
  set("gender", "男性");
  set("attitude", "friendly");
  set("class", "bonze");

  set("age", 70);
  set("shen_type", 1);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  //      set("max_qi", 1500);
  //      set("max_jing", 1000);
  set("force", 10000);
  set("max_force", 10000);
  //      set("", 150);
  set("combat_exp", 200000);
  set("score", 500000);

  //      set_wugong("force", 110);
  //      set_wugong("dodge", 110);
  set_wugong("shalin-xinfa", 200);
  set_wugong("literate", 200);

  create_family("少林派", 36, "掌门方丈");

  set("inquiry", ([
    "叶二娘": (: ask_ye :),
    "虚竹": "他是本寺的一位小僧人，你去问他的师父慧轮吧。",
    "石屋": "后院石屋，乃历代方丈闭关静修之处。",
    "闭关": (: ask_biguan :),
  ]));

  setup();

  //    carry_object("")->wear();
}

string ask_ye() {
  this_player()->set_temp("marks/叶", 1);
  return "......你究竟是谁？";
}

string ask_biguan() {
  object me;

  me = this_player();

  if (me->query_temp("marks/关1")) {
    me->set_temp("marks/关2", 1);
    me->set_temp("marks/关1", 0);
    return "后院有一间石屋，可以进去闭关静修。";
  }

  return "你还不够资格闭关静修。";

}

void attempt_apprentice(object ob) {
  object me;
  mapping ob_fam, my_fam;
  string name, new_name;

  me = this_object();
  my_fam = me->query("family");

  name = ob->query("name");

  if (!(ob_fam = ob->query("family")) || ob_fam["family_name"] != "少林派") {
    command("say " + RANK_D->query_respect(ob) + "与本派素无来往，不知此话从何谈起？");
    return;
  }

  if ((string)ob->query("class") != "bonze" && ob_fam["family_name"] == "少林派") {
    command("say " + RANK_D->query_respect(ob) + "是俗家弟子，不能在寺内学艺。");
    return;
  }

  if (ob_fam["generation"] <= my_fam["generation"]) {
    command("say " + RANK_D->query_respect(ob) + "，贫僧哪里敢当 !");
    return;
  }

  if (ob_fam["generation"] == (my_fam["generation"] + 1) && name[0..1] == "澄") {
    command("say " + ob_fam["master_name"] + "的徒弟怎麽跑到我这儿来了，哈哈哈 !");
    command("recruit " + ob->query("id"));
  } else {
    command("say " + RANK_D->query_respect(ob) + "，你辈份不合，不能越级拜师。");
    return;
  }

  return;
}
