void attempt_apprentice(object ob)
{
    if( (string)ob->query("gender") != "男性" )
        command("say 阿弥陀佛，女施主不要跟贫僧开玩笑。");
    else if( ob->query("class") != "bonze" )
        command("say 未得方丈准许，贫僧不敢擅收俗家弟子。施主还是请回吧。");
    else if( ob->query("lnwm/pass_muren") != 9)
        command("say 莫急，莫急。你现在的功夫还欠火候，再磨练磨练吧。");
    else {
        message_vision( "$N对$n微微一笑，道：“好孩子，从今天起你就是罗汉堂的弟子了。\n"
                        "可别给少林丢脸呵。”",this_object(),ob);
        command( "recruit " + ob->query("id") );
        ob->set("title","少林寺罗汉堂弟子");
        ob->set("class","bonze1");//武僧
    }
}


int accept_fight(object me)
{
    if( (string)me->query( "class")=="bonze" )
        command("say 阿弥陀佛！出家人戒逞强恶斗！贫僧不敢违反清规。");
    else
        command("say 施主既然身负绝艺，贫僧佩服便是，也不必较量了。");

    return 0;
}


void ask_for_shaolin()
{
    object me,ob;

    me = this_player();
    ob = this_object();
    if ( me->query("family/family_name") == "少林派")
        message_vision("$N和颜悦色地向$n说：“本门建寺百余年，一时也讲不了许多。改天有空时我细细告诉你。”",ob,me);
    else
        message_vision("$N拂然不悦道：“施主这是拿小寺说笑吗。”\n",ob,me);
    return;
}

int valid_teach(object me, string skill)
{
    int last_amount,now;
    now = me->query("PKS") + me->query("MKS");
    last_amount=me->query("last_penalty");
    if(now > last_amount )
    {
        if(!me->query("announced"))
        {
            command("shake");
            command("disapp " + me->query("id"));
            command("say 你又犯了戒律了,戒律院的慧见执事让你去一趟.阿弥陀佛..");
            me->set("announced",me->query("mud_age"));
        }
        else
            command("say 你还没去戒律院啊,唉," + RANK_D->query_self(this_object()) +
                    "也无能为力了.阿弥陀佛");
    }
    if (! me->query("family/master_id") )
        return notify_fail("慧轮摇头道：“少林武功最重根基，这门功夫待你过了木人巷，成为\n本寺入室弟子再来精研也不迟。");

/*    switch(skill){
        case "guanyin-shou":
        case "banruo-zhang":
            return notify_fail("慧轮摇头道：“少林武功最重根基，我且问你，散花掌你已练到几品了？”\n");
        default :
            break;
        }*/
    return ::valid_teach(me, skill);
}

