inherit "/d/menpai/shaolin/npc/wuseng";
void create() {
  set_name("巡寺武僧", ({ "xunsi wuseng", "wuseng", "seng", "monk" }));
  set("gender", "男性");
  set("class", "bonze");
  set("age", 40);
  create_family("少林派", 38, "弟子");
  set("chat_chance", 10);
  set("chat_msg", ({
    "巡寺武僧警惕地审视着周围。\n",
    "巡寺武僧看了你一眼，又转头到另一边。\n",
    (: random_move :),
  }));
  set_wugong("unarmed", 100 + random(50));
  set_wugong("jiben-qinggong", 100 + random(50));
  set_wugong("cibei-dao", 100, 100, 1);
  set_xiuwei("dodge", 300 + random(200));
  set_xiuwei("blade", 300 + random(100));
  set_xiuwei("unarmed", 100 + random(200));
  set("social_exp", 20000);
  set("combat_exp", 100000);
  setup();
  carry_object(CLONE_DIR + "weapon/blade/jiedao")->wield();
}
