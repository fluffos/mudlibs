inherit "/d/menpai/shaolin/npc/wuseng.lpc";

void create()
{
    set_name("练武僧人", ({ "lianwu seng","seng","monk" }) );
    set("age",23);

    create_family("少林派", 38, "弟子"); 

    set( "chat_chance", 6 );
    set( "chat_msg", ({
        "练武僧人举起了一个石锁，脸憋得通红。\n",
        "练武僧人坐到旁边，开始歇息。\n",
        "练武僧人挠了挠头：这招到底怎么出好呢？\n",
        }) );
    set_wugong("luohan-quan", 80 + random(10));
    set_wugong("shaolin-shenfa", 80 + random(10));
    set_xiuwei("dodge",100 + random(20));
    set_xiuwei("unarmed",100 + random(20));
    setup();
}


