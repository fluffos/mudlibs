inherit "/d/menpai/shaolin/npc/seng.lpc";

void create()
{
    set_name("挑水和尚", ({ "tiaoshui heshang","heshang","monk" }) );

    set("str",30+random(5));
    set("con",30+random(5));
    set("dex",30+random(5));

    set("chat_chance", 6 );
    set("chat_msg", ({
        "挑水和尚挑着两个沉重的大木桶，脚步轻快地向前走去。\n",
        "挑水和尚正快步向前走，忽地滑了一下，险些摔倒。\n",
        }) );
    set_wugong("unarmed"        ,100,100,1);
    set_wugong("jiben-qinggong" ,120,120,1);
    set_xiuwei("dodge"  ,170);
    set_xiuwei("unarmed",170);
    setup();
//    carry_object(__DIR__"obj/cloth4")->wear();
}


