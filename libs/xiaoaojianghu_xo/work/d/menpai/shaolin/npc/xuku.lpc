#include <ansi.h>

inherit "/d/menpai/shaolin/npc/xu";

void create()
{
    set_name("虚苦", ({ "xu ku", "xu", "monk" }) );
    set("long", @LONG
    虚苦总是默默无闻地在罗汉堂埋头工作，每天难得见他有一次笑脸，似乎总
担着很重的心事。当年他剃度出家时，方丈就是怜他悲惨的身世而收他入寺，并
赐法名为苦。
LONG
        );
    set( "age", 30 );

    set( "max_force", 800 );
    set( "force", 800 );
    set( "force_factor", 20);

    set_wugong("luohan-quan",80,80,1);
    set_wugong("weituo-zhang",80,80,1);
    set_wugong("shaolin-shenfa",60,60,1);
    set_xiuwei_by_type("unarmed",250);
    set_xiuwei_by_type("dodge",250);

    set("social_exp", 15000);
    
    setup();
    carry_object(CLOTH_DIR "sengyi2") -> wear();
}

