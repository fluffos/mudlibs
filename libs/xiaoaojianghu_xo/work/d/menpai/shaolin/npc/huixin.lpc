#include <ansi.h>
inherit F_MASTER;
inherit NPC;

void create() {
  set_name("慧心", ({ "hui xin", "hui", "xin", "bonze" }));
  set("long", "一个四十多岁的中年僧人，是玄难大师的得力助手。\n"
    "负责戒律院的武僧的教练工作。\n");
  set("gender", "男性");
  set("age", 45);
  set("attitude", "friendly");
  set("class", "bonze1");

  set("str", 30);
  set("int", 30);
  set("spi", 30);
  set("con", 30);
  set("cps", 30);
  set("cor", 20);
  set("per", 30);
  set("kar", 30);

  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 40);

  set_wugong("longzhua-shou", 100, 100, 1);
  set_wugong("damo-jian", 120, 100, 1);
  set_wugong("shaolin-shenfa", 100, 100, 1);
  set_wugong("shaolin-neigong", 100, 100, 1);
  set_xiuwei_by_type("unarmed", 2200);
  set_xiuwei_by_type("dodge", 2200);
  set_xiuwei_by_type("sword", 2400);

  set("combat_exp", 180000);
  set("social_exp", 50000);
  set("positive_score", 10000);
  set("negative_score", 0);
  set("class_score", 10000);

  create_family("少林派", 37, "弟子");
  set("title", RED "少林寺" YEL "戒律院" BLU "武僧" NOR);

  setup();
  carry_object(CLOTH_DIR "sengyi3")->wear();
  carry_object(CLONE_DIR "weapon/sword/sword1")->wield();
}
