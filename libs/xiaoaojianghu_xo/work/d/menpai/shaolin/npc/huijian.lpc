#include <ansi.h>

inherit NPC;

string do_accept(string msg,object me);

void create()
{
        set_name("慧见", ({ "hui jian", "hui", "jian", "bonze" }) );
        set("long",     "一个四十多岁的中年僧人，是玄难大师的得力助手。\n"
                        "负责戒律院的日常工作。\n");
        set("gender", "男性");
        set("age", 43);
        set("attitude", "friendly");
        set("class", "bonze1");

        set("str", 27);
        set("int", 30);
        set("spi", 30);
        set("con", 30);
        set("cps", 30);
        set("cor", 20);
        set("per", 30);
        set("kar", 30);

    set("force", 2000);
    set("max_force", 2000);
    set("force_factor", 40);
  
    set_wugong("duoluoye-zhi"   ,100,100,1);
    set_wugong("shaolin-shenfa" ,100,100,1);
    set_wugong("shaolin-neigong",100,100,1);
    set_xiuwei_by_type("unarmed",2200);
    set_xiuwei_by_type("dodge",2200);
        
    set("combat_exp", 180000);
    set("social_exp", 50000);
    set("positive_score",10000);
    set("negative_score",0);
    set("class_score",10000);

    create_family("少林派", 37, "弟子");
    set("title",RED"少林寺"YEL"戒律院"BLU"知事"NOR);
        
    setup();
    carry_object(CLOTH_DIR"sengyi3")->wear();

}


