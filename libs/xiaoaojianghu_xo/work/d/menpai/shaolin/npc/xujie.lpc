// Filename : /d/menpai/shaolin/npc/xujie.c

#include <ansi.h>

inherit "/d/menpai/shaolin/npc/xu";

void create() {
  set_name("虚戒", ({ "xu jie", "xu", "jie", "he shang",
    "sen ren", "bonze" }));
  set("title", "罗汉堂武僧");
  set("long", @LONG
    虚戒本来是年轻一代中武功的佼佼者，但由于过分注重武功修练，忽略了佛
法的研习，以至一些小处把持不定，屡次犯戒。方丈为了让他时刻能保持禅心，
特地给他换成现在的法号。
LONG
  );

  set("age", 27);

  set("max_force", 600 + random(40));
  set("force", 600 + random(40));

  set_wugong("luohan-quan", 100, 100, 1);
  set_wugong("weituo-zhang", 100, 100, 1);
  set_wugong("fuhu-quan", 80, 80, 1);
  set_wugong("shaolin-shenfa", 60, 60, 1);
  set_wugong("shaolin-neigong", 60, 60, 1);

  set_xiuwei_by_type("unarmed", 500);
  set_xiuwei_by_type("dodge", 500);

  setup();
  carry_object(CLOTH_DIR "sengyi2")->wear();
}
