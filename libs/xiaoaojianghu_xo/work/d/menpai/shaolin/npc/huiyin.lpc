//huisi.c 十八罗汉之金身罗汉
inherit NPC;
inherit F_MASTER;


void create() {
  set_name("慧因", ({ "hui yin", "hui", "monk" }));
  set("long", @LONG
他是一位须发花白的老僧，身穿一袭金边红色袈裟。他身材瘦高，
太阳穴高高鼓起，似乎身怀绝世武功。
LONG);

  set("title", "金身罗汉");
  set("gender", "男性");
  set("attitude", "friendly");
  set("class", "bonze");

  set("age", 62);
  set("str", 25);
  set("int", 25);
  set("con", 25);
  set("dex", 25);
  set_hp("kee", 1000);
  set_hp("sen", 500);
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 25);
  set("combat_exp", 100000);
  set("class_score", 5000);
  set("positive_score", 3000);
  set("social_exp", 5000);

  set_wugong("banruo-shenfa", 185, 160, 1);
  set_wugong("shaolin-xinfa", 100, 90, 1);
  set_wugong("xumishan-zhang", 90, 100, 1);
  set_wugong("weituo-zhang", 160);

  set_xiuwei_by_type("unarmed", 2500);
  set_xiuwei_by_type("dodge", 2000);
  set_xiuwei_by_type("zonggang", 300);

  create_family("少林派", 37, "弟子");

  setup();

  carry_object(CLOTH_DIR "hong-jiasha")->wear();
}


#include "hui.h"
