inherit "/d/menpai/shaolin/npc/wuseng.lpc";

void create()
{
    set_name("年轻武僧", ({ "nianqing wuseng", "wu seng", "seng", "monk" }) );
    set( "age",18);
    create_family("少林派", 38, "弟子"); 
    set( "chat_chance", 10 );
    set( "chat_msg", ({
        "年轻武僧迟迟疑疑地挥出一刀，看起来姿势笨拙。\n",
        "年轻武僧练了半天仍是一筹莫展，垂头丧气地坐到一旁。\n",
        "年轻武僧终于劈出一刀，隐隐有风雷之声。\n",
        }) );
    set_wugong("cibei-dao"      , 60, 60, 1);
    set_wugong("luohan-quan"    , 60, 60, 1);
    set_wugong("shaolin-shenfa" , 60, 60, 1);
    set_xiuwei("dodge"  , 100 + random(40));
    set_xiuwei("blade"  , 100 + random(40));
    set_xiuwei("unarmed", 100 + random(40));

    setup();
    carry_object( CLONE_DIR + "weapon/blade/jiedao")->wield();
}

