// qyz

inherit F_MASTER;
inherit "/d/menpai/shaolin/npc/seng.lpc";

void create()
{
    set_name("缘净", ({ "yuan jing","jing","monk" }) );
    set( "gender", "男性" );
        set( "title", "香积厨执事");
    set( "class","bonze");
    set( "age",40);
    create_family("少林派", 38, "弟子"); 

        set( "chat_chance", 10 );
        set( "chat_msg", ({
                        "缘净不耐烦地催促道：“还不快点，...磨磨蹭蹭，哼！”\n",
                        "缘净忙碌地指挥着那些小和尚，不停地走来走去。\n",
                        "缘净见你在发呆，冲你喊到：“还不快去干活练功！”\n",
                        }) );

    set_wugong("unarmed", 100 + random(50));
        set_wugong("weituo-zhang", 100 );
    set_wugong("jiben-qinggong", 100 + random(50));
    set_xiuwei("dodge", 600 + random(200));
    set_xiuwei("unarmed",600 + random(200));

    set("social_exp",200000);
    set("combat_exp",1000000);
    setup();

}

void init()
{
        add_action("give_quest", "quest" );
        ::init();
}

int valid_teach(object ob, string skill)
{
    object me=this_object();

    if ( ob->query("family/family_name")!="少林派")  
        return 0;
    if ( ob->query("task_time")+1000 < time() ) 
    {
        say(  me->name()+ "微一皱眉，说：嗯...今天的日常洒扫作了没有？\n");
        return 0;
    }
    say ( me->name() + "呵呵一笑道：我这点三脚猫的功夫，见不得人的。\n");
    return 0;
}

