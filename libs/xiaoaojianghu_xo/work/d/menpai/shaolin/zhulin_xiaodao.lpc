inherit ROOM;

void create() {
  set("short", "竹林小道");
  set("long", @LONG
这是一段长长的竹林小道，作为少林第三部分的临时入口。路旁一棵大毛竹
上挂着一块招牌(sign)。这里还可以通向碧云天的工作室。
LONG
  );

  set("valid_startroom", 1);

  set("exits", ([
    "whicloud": "/u/whicloud/whicloud_room",
    "northwest": __DIR__ "puti_yuan",
    "north": __DIR__ "fangzhang_changlang",
    "northeast": __DIR__ "longshu_yuan",
  ]));

  set("item_desc", ([
    "sign": "少林第三部分临时入口\n",
  ]));

  setup();
}
