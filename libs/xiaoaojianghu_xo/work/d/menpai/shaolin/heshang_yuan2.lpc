// rooms:/d/shaolin/heshang_yuan2.c

#include <room.h>

inherit ROOM;

void create()
{
    set("short", "青砖路");
    set("long", @LONG
一条青砖铺成的路由北往南穿过整个院落，两边是一间间的僧舍。僧舍后是
雪白的院墙，墙外的翠竹有几枝越过墙来，随着阵阵清风拂过屋顶。四下里静悄
悄的，远处的喧哗都以淡去。只偶尔有一两个僧人走过，也都默不作声。
LONG
    );
    set("exits", ([ 
        "east"      : __DIR__"heshang_yuan6",
        "west"      : __DIR__"heshang_yuan7",
        "south"     : __DIR__"heshang_yuan3",
        "north"     : __DIR__"heshang_yuan1",
    ]));
    set("outdoors", "shaolin");
    setup();
    replace_program(ROOM);
}                       

