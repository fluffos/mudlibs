inherit ROOM;

void create() {
  set("short", "走廊");
  set("long", @LONG
这是藏经阁二楼的东走廊。往北是藏经阁的东阁，往西走可以到达藏经阁的
北阁和西阁。有一道楼梯盘旋而下，通向藏经阁东厅。
LONG
  );
  set("exits", ([
    "down": __DIR__ "cangjing_ge1e",
    "west": __DIR__ "cangjing_zoulang2",
    "north": __DIR__ "cangjing_dongge"
  ]));

  setup();
