inherit ROOM;

void create()
{
    set("short","后山竹林");
    set("long",@LONG
你走在一片茂密的竹林丛中，脚下踩着软软的碎叶，耳旁听得鸟鸣声声。环
顾四周，这一片竹影，看上去无边无际。你发觉自己被淹没在绿的海洋中了。
LONG
    );
    set("exits",([
        "northeast" : __DIR__"houshan_pubu",
        "north" : __DIR__"houshan_zhulin"+(random(4)+1),
        "northwest" : __DIR__"houshan_zhulin"+(random(4)+1),
        "south" : __DIR__"houshan_zhulin"+(random(4)+1),
    ]));

    setup();
}

