// fang zhang jing she chang lang 2 : /d/shaolin/fangzhang_changlang2.c

inherit ROOM;

void create() {
  set("short", "长廊");
  set("long", @LONG
长廊到此，通往一座石屋，上面挂着一块匾额(sign)，仔细一看，那便是方
丈精舍了，少林寺方丈就在此处起居执事。屋外站着一位小沙弥，如有事要求见
方丈，可由小沙弥先进去禀报。方丈精舍两侧，有两道游廊呈环抱之势，通向屋
后深处......
LONG
  );
  set("exits", ([
    "south": __DIR__ "fangzhang_changlang",
    "northeast": __DIR__ "fangzhang_youlang1e",
    "northwest": __DIR__ "fangzhang_youlang1w",
    "north": __DIR__ "fangzhang_hall",
  ]));

  set("item_desc", ([
    "sign": "方丈精舍\n",
  ]));

  set("objects", ([
    __DIR__ "npc/xiaoshami": 1,
  ]));

  setup();
}

int valid_leave(object me, string dir) {
  mapping fam;
  fam = (mapping)me->query("family");

  if ((!fam || fam["family_name"] != "少林派") && dir == "north" &&
    objectp(present("xiao shami", environment(me))))
    return notify_fail("小沙弥双手合十：方丈大师不见外人，施主请回吧！\n");
  return ::valid_leave(me, dir);
}
