// Room: /d/shaolin/luohan_tang1.c

#include <ansi.h>

inherit ROOM;

void create()
{
    set("short", CYN"罗汉堂正厅"NOR);
    set("long", @LONG
罗汉堂是少林最重要的部门，专管少林寺院的警戒和弟子工夫的测验。少林
武学闻名天下，每天总有不少好事之徒前来挑战。虽说少林僧人习武只为强身健
体，对这类挑战多由知客一推了事，但总还有推不掉时候。每当此时，维护少林
声誉的重任就落到罗汉堂的身上。这罗汉堂的“罗汉”二字正是护法罗汉的意思。
LONG
    );
    set("exits", ([
        "west"      : __DIR__"zhongyang_guangchang2.lpc",
        "east"      : __DIR__"luohan_tang2.lpc",
        "south"     : __DIR__"luohan_tang3.lpc",
        "north"     : __DIR__"luohan_tang4.lpc",
    ]));
    set("objects", ([
        __DIR__"npc/huilun" : 1,
        __DIR__"npc/xuku"   : 1,
        __DIR__"npc/xujie"  : 1,
    ]));
    set("need_clean", "少林派" );
    setup();
}

void init()
{
        add_action("da_sao", "sao");
        add_action("da_sao", "clean");
}

int da_sao(string arg)
{
    object me;
    mapping quest;
    me = this_player();
    if( !me->can_act() ) return notify_fail("你现在无法打扫。\n");

    if( call_other("/cmds/verb/clean", "main", me, arg ) )
    {
        if( quest = me->query("quest") )
        {
            if( quest["quest"] == "打扫罗汉堂正厅" )
            me->set("done_quest", "打扫罗汉堂正厅" );
            return 1;
        }
        return 1;
    }
    return 0;
}

