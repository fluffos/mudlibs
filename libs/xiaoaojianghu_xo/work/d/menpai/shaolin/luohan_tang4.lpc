#include <ansi.h>

inherit ROOM;

void create() {
  set("short", CYN "罗汉堂侧厅" NOR);
  set("long", @LONG
这里是罗汉堂侧厅。大厅收拾得非常整洁，厅虽很大，但却空荡荡的。只在地上
摆着一溜蒲团。大厅紧里边有一个屏风，屏风上画着一对罗汉在对练拳脚，左边的罗
汉神情紧张，似正处于守式，右边的和尚则气定神闲，显然占了上风。画面线条清晰
甚有古风，依然是名家手笔。
LONG
  );
  set("exits", ([
    "south": __DIR__ "luohan_tang1.lpc",
  ]));

  // replace_program(ROOM);

  setup();


}



void init() {
  add_action("do_open", ({ "tui", "推", "push" }));
}


int do_open(string arg) {
  object obj;
  object me;

  if (!arg || arg == "") {
    write("你要推开什么？\n");
    return 1;
  }
  if (arg == "pingfeng" || arg == "屏风") {
    me = this_player();
    message_vision("$N推了推屏风，屏风无声地滑到一边。出现了一个入口\n", me);
    if (!query("exits/north")) {
      set("exits/north", __DIR__ "mishi");
      call_out("close_path", 3);
    }
    return 1;
  } else {
    write("你不可以推" + arg + "\n");
    return 1;
  }
}


void close_path() {
  if (!query("exits/north")) return;
  message("vision", "一阵沉闷的机关响动，屏风移动遮住了入口。\n", this_object());
  delete("exits/north");
}

int valid_leave(object me, string dir) {
  if (dir == "north" && !this_object()->query("exits/north"))
    write("一扇屏风\n");

  return ::valid_leave(me, dir);
}
