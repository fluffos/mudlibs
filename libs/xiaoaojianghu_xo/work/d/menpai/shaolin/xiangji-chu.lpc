// Room: /d/shaolin/xiangji-chu.c
// Date: 1997 6 7
// chatged by lnwm

#include <ansi.h>;

inherit ROOM;

void create() {
  set("short", CYN "香积厨" NOR);
  set("long", @LONG
少林的香积厨。管着少林一寺上下近千僧人的斋饭，所以每日的工作
十分繁忙而紧张。靠墙是一溜大灶，每个灶前都有个小和尚在拉风箱，并
不时看看火势。没个大灶上都放有一口巨大的锅，烧饭的僧人必须用一把
十分之大的饭勺来搅拌锅里的饭菜。正好可即此练功。寺中的其他僧人也
要到这里来帮厨，这也是修行的一部分。
LONG
  );

  set("exits", ([ /* sizeof() == 4 */
    "north": __DIR__ "heshang_yuan3",
    "south": __DIR__ "shantang.lpc",
    "west": __DIR__ "xiangji_chuli",
  ]));
  set("objects", ([
    __DIR__ "npc/yuanjing": 1,
    __DIR__ "npc/toutuo1": 2,
  ]));
  setup();
}

void init() {
  add_action("pi_chai", "pi");
  add_action("ban_chai", "ban");
}

int pi_chai(string arg) {
  object me;
  me = this_player();
  if (!arg || (arg != "柴" && arg != "chai"))
    return notify_fail("你要劈什么？\n");

  if (!me->can_act()) return notify_fail("你现在无法劈柴。\n");

  if (arg == "柴" || arg == "chai") {
    if (query_temp_marks("pichai_times") >= 5)
      return notify_fail("这里的柴已经被劈光了。\n");
    if ((int)me->query("sen") < 30)
      return notify_fail("你现在太累了，先休息一会吧。\n");
    else {
      tell_object(me, "你在角落里拿起一把斧头，开始劈柴....\n"
        "你一下一下地劈，只觉得柴越来越多，自己也越来越累......\n");
      add_temp_marks("pichai_times", 1);
      me->disable_command("verb", "你正在劈柴呢。");
      call_out("done_pichai", 10, me);
      return 1;
    }
  }
}

int done_pichai(object me) {
  mapping quest;
  tell_object(me, "终于，你劈好了好大一堆柴，也累了个半死。\n");
  me->receive_damage("sen", 30);
  me->enable_path();
  if (quest = me->query("quest")) {
    if (quest["quest"] == "劈柴")
      me->set("done_quest", "劈柴");
    return 1;
  }
  return 1;
}

int ban_chai(string arg) {
  object me;
  me = this_player();
  if (!arg || (arg != "柴" && arg != "chai"))
    return notify_fail("你要搬什么？\n");

  if (!me->can_act()) return notify_fail("你现在无法搬柴。\n");

  if (arg == "柴" || arg == "chai") {
    if (query_temp_marks("banchai_times") >= 5)
      return notify_fail("这里的柴已经被搬光了。\n");
    if ((int)me->query("sen") < 50)
      return notify_fail("你现在太累了，先休息一会吧。\n");
    else {
      tell_object(me, "你抱起劈好的柴，搬到角落去....\n"
        "你把柴整整齐齐地码在角落上...\n");
      add_temp_marks("banchai_times", 1);
      me->disable_command("verb", "你正在搬柴呢。");
      call_out("done_banchai", 5, me);
      return 1;
    }
  }
}

int done_banchai(object me) {
  mapping quest;
  tell_object(me, "你码好了一大堆柴，满意地笑了笑。\n");
  me->receive_damage("sen", 50);
  me->enable_path();
  if (quest = me->query("quest")) {
    if (quest["quest"] == "搬柴")
      me->set("done_quest", "搬柴");
    return 1;
  }
  return 1;
}
