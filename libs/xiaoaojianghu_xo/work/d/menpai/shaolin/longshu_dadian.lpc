inherit ROOM;

void create() {
  set("short", "龙树院大殿");
  set("long", @LONG
这里是龙树院的大殿。大殿的两旁整整齐齐地排放着两排蒲团，中间是一座
讲坛，龙树院守座就在这里向众僧讲经。东西两侧各有一间厢房，门被从里闩了
个严严实实。
LONG
  );
  set("exits", ([
    "south": __DIR__ "longshu_yuan",
  ]));

  set("item_desc", ([
    "east": "龙树院东厢房房门\n",
    "west": "龙树院西厢房房门\n",
  ]));

  setup();
}
