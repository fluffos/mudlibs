inherit ROOM;

void create()
{
    set("short","龙树院西禅房");
    set("long",@LONG
这是龙树院的西禅房，是龙树院首座打坐练功之处起居之处。屋内正中有一
张很旧的蒲团。东侧有一扇门，那里通往龙树院的大殿。
LONG
    );
    set("exits",([
        "east" : __DIR__"longshu_dadian",
    ]) );

    set("item_desc", ([
        "east" : "龙树院西禅房房门\n",
    ]) );

    setup();
}

