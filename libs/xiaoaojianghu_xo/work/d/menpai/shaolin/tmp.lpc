// zhi qing : /d/shaolin/npc/zhiqing.c

inherit NPC;

void creat()
{
    set_name("止清",({"zhi qing"}));
    set("gender","男性");
    set("age", 45);
    set("str", 32);
    set("cor", 30);
    set("cps", 30);
    set("int", 36);
    set("per", 33);
    set("con", 34);
    set("kar", 35);

    set("long","一个中年僧人\n");
    set("attitude","peaceful");
    set("combat_exp",50000);

    set("max_atman", 300);         set("atman", 300);             set("atman_factor", 3);
    set("max_force", 300);         set("force", 300);             set("force_factor", 3);
    set("max_mana", 300);          set("mana", 300);              set("mana_factor", 3);

    set_skill("unarmed", 60);
    set_skill("parry", 60);
    set_skill("dodge", 60);
    set_skill("force", 60);

    set_temp("apply/attack", 60);
    set_temp("apply/defense", 80);
    set_temp("apply/damage", 70);
    set_temp("apply/armor", 90);

    setup();
}

