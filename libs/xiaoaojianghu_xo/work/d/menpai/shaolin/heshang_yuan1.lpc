#include <room.h>

inherit ROOM;

void create()
{
    set("short", "青砖路");
    set("long", @LONG
一条青砖铺成的路向南拐了个弯，穿过整个院落，路边是一间间的僧舍。这
里就是少林和尚起居习禅的和尚院。往东是少林僧人习武的广场，阵阵吆喝声不
时传来，打破了这里的寂静，也平添了几分生气。
LONG
    );
    set("exits", ([ 
        "east"      : __DIR__"zhongyang_guangchang3",
        "west"      : __DIR__"heshang_yuan4",
        "south"     : __DIR__"heshang_yuan2",
        "north"     : __DIR__"heshang_yuan5",
    ]));
    set("outdoors", "shaolin");
    setup();
    replace_program(ROOM);
}                       

