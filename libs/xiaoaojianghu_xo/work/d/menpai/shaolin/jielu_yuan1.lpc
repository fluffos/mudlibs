// Room: /d/shaolin/jielu_yuan1.c

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "戒律堂正厅");
  set("long", @LONG
厅堂正上方挂了一块匾额，上书“谨言慎行”四个大字。少林威名得以百年
不坠，不光是因为武学精湛，更是因为戒律严明。上至方丈，下至刚入门的弟子
，只要是触犯戒律的，都要受罚，决无情面可言。这里大概是少林僧人最不愿涉
足的地方了。但少林弟子每次下山归来，都要先到这里禀告有无犯规。实是不得
不来。
LONG
  );
  set("exits", ([
    "east": __DIR__ "jielu_yuan0",
    "west": __DIR__ "jielu_yuan2",
    "south": __DIR__ "jielu_yuan3",
    "north": __DIR__ "jielu_yuan4",
  ]));
  set("objects", ([
    __DIR__ "npc/huwei": 2,
    __DIR__ "npc/huwei1": 2,
    __DIR__ "npc/huijian": 1,
  ]));
  setup();
}

void init() {
  object me, ob;
  me = this_player();
  if (me->query("announced")
    && (ob = present("hui jian", this_object()))
    && ob->can_act()) {
    remove_call_out("processing");
    call_out("processing", 1, me);
  }
}

void processing(object me) {
  message_vision(HIY @LONG

只听一声大喝，$N战战兢兢地抬头观瞧：戒律院的执事僧坐在大殿正中，狠恨地盯着$N；

周围的戒律院僧兵个个横眉立目，身前身后摆放着各种各样的刑具，令人不寒而栗。

$N不由得双腿打颤，“咕咚”一声跪倒在大殿上，不敢抬头再看。

LONG NOR, me);
  remove_call_out("decide");
  call_out("decide", 3, me);
}

void decide(object me) {
  int i;
  message_vision(GRN @LONG
慧见盯了$N一会儿，缓缓说道：
    “$N身为佛门弟子，居然杀害生灵，犯我僧家诸戒之首戒！
     按律当重责一百，打入水牢。众僧兵！给我用力打！” 
LONG NOR, me);
  message_vision(RED "\n众僧兵答应一声：“是！”一顿乱棍打来，$N疼得昏死过去……\n" NOR, me);
  i = me->query("eff_gin");
  me->set("eff_gin", i * 5 / 6);
  i = me->query("eff_kee");
  me->set("eff_kee", i * 5 / 6);
  i = me->query("eff_sen");
  me->set("eff_sen", i * 5 / 6);
  me->move(__DIR__ "shuilao1");
  me->unconcious();
  me->delete("announced");
  me->apply_condition("shuilao", 300);
}

int valid_leave(object me, string dir) {
  object ob;
  int i;
  if (me->query("announced")
    && (ob = present("hui jian", this_object()))
    && (ob->can_act())) {
    message_vision(GRN
      "慧见大喝一声：“大胆刁徒，不真心思过，居然还想潜逃不成！执法僧兵何在？！”\n\n" YEL +
      "众僧兵一起应道：“弟子在！”\n\n" GRN +
      "慧见喝道：“将此刁蛮顽劣之徒重责三百，打入水牢！”\n\n" YEL +
      "众僧兵答应一声：“是！”一顿乱棍打来，$N疼得昏死过去……\n" NOR, me);
    i = me->query("eff_gin");
    me->set("eff_gin", i / 2);
    i = me->query("eff_kee");
    me->set("eff_kee", i / 2);
    i = me->query("eff_sen");
    me->set("eff_sen", i / 2);
    me->move(__DIR__ "shuilao1");
    me->unconcious();
    me->delete("announced");
    me->apply_condition("shuilao", 600);
    return notify_fail("");
  }
  return ::valid_leave(me, dir);
}
