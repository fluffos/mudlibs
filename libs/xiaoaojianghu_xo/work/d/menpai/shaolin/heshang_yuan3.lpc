#include <room.h>

inherit ROOM;

void create()
{
    set("short", "青砖路");
    set("long", @LONG
一条青砖铺成的路由北往南穿过整个院落，两边是一间间的僧舍。路的尽头
有一扇木门，通往膳堂。门那边不时传来小和尚们的笑声，不知这些小家伙又发
现了什么有趣的事。
LONG
    );
    set("exits", ([ 
        "east"      : __DIR__"heshang_yuan8",
        "west"      : __DIR__"heshang_yuan9",
        "south"     : __DIR__"xiangji-chu",
        "north"     : __DIR__"heshang_yuan2",
    ]));
    set("outdoors", "shaolin");
    setup();
    replace_program(ROOM);
}                       

