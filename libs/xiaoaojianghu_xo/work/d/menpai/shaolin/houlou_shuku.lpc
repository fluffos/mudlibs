// 藏经后楼书库 : /d/shaolin/houlou_shuku.c

inherit ROOM;

void init();
int do_study(string);

void create()
{
    set("short","后楼书库");
    set("long",@LONG
这里是藏经后楼的书库，少林七十二技中的高深功夫的秘籍大部分藏在这里
。书库中间和四周墙边密密地排满了书架(shelf)。 书架上的书放得整整齐齐，
显得多而不乱。
LONG
    );
    set("exits",([
        "south" : __DIR__"cangjing_xige",
    ]) );

    set("item_desc", ([
        "shelf" : "书架上摆满了武功秘籍。\n",
    ]));

    setup();
}

void init()
{
    add_action("do_study", "study");
    add_action("do_study", "du");
}


int do_study(string arg)
{
    object me = this_player();

    message_vision("请不要在书库里读书。\n", me);

    return 1;
}

