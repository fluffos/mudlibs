#include <weapon.h>
#include <ansi.h>
inherit HAMMER;
//inherit F_SAVE;
//inherit F_AUTOLOAD;
void create() {
  set_name("木鱼锤", ({ "muyu chui", "chui" }));
  set_weight(800);
  set("long", "这是和尚念经用的木鱼锤\n");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 50);
    set("material", "wood");
  }
  init_hammer(1);
  set("wield_msg", "$N从腰间抽出一把$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n插回腰间。\n");
  setup();
}
