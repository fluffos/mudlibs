inherit ITEM;
inherit F_FOOD;

void create()
{
    set_name("卷心菜", ({"juanxin cai" }) );
    set_weight(60);//一两
    if( clonep() ) 
        set_default_object(__FILE__);
    else {
        set("unit", "棵");
        set("value", 20);
        set("food_remaining", 3);
        set("food_supply", 10);
         
    }
    setup();
}

