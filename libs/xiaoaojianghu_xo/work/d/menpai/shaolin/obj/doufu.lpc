// doufu.c

inherit ITEM;
inherit F_FOOD;

void create()
{
    set_name("清水豆腐", ({"doufu"}));
    set_weight(100 + random(100));
    set("cant_sell","少林的庙产，小的可不敢收。\n");
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "一块鲜嫩的豆腐，正发出阵阵香气。\n");
        set("unit", "块");
        set("value", 20);
        set("food_remaining", 3);
        set("food_supply", 20);
    }
}

