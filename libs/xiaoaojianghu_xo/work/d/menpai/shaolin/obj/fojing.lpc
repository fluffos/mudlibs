// fojing.c

inherit ITEM;

void create() {
  set_name("佛经", ({ "fo jing", "jing" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "一本佛经。\n");
    set("value", 1);
    set("material", "paper");
    set("skill", ([
      "name": "literate",
      "xiuwei_required": 0,
      "literate_required": 30,
      "gin_cost": 40 + random(10),
      "max_lingwu": 100,
      "bonus_jilei": 20,
      "bonus_xiuwei": 2,
      "bonus_social_exp": 10,
      "max_social_exp": 15000,
    ]));
  }
}
