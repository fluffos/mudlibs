// tietong.c
inherit ITEM;
inherit F_LIQUID;

void create()
{
        set_name("铁桶", ({ "tie tong","tong" }) );
        set_weight(40000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "少林武僧练习负重的铁桶，看起来极为沉重.\n");
                set("unit", "只");
                set("value", 90);
                set("max_liquid", 2000);
        }

        // The liquid contained in the container is independent, we set a copy
        // in each cloned copy.
        set("liquid", ([
                "name": "清水",
                "remaining": 30,
        ]) );
}


