inherit ITEM;

void create()
{
        set_name("木鱼", ({ "muyu"}) );
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long",     "一个和尚念经敲打的木鱼，已经被磨得发亮了。\n");
                set("unit", "个");
        set("value", 150);
        }
        setup();
}

