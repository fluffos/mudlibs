/* xu.c
少林寺虚字辈模板,可以inherit.
代设:
    "gender","age","attitude","max_force","force","force_factor","combat_exp",
    "social_exp","class","family"
    另备有标准 "inquiry" 一套,知道少林寺,知道出家和剃度.
    预装有valid_teach(),tell_skills().其中tell_skills()对已拜师的玩家调用
    tell_skills_to_apprenticed(),该函数可重载.
需设:
    "name","id","long",skill和修为,9项天赋.
    还要穿衣服.
*/

#include <ansi.h>

inherit NPC;

string ask_for_join();
string ask_for_shaolin();

void setup() {
  mapping my;
  my = this_object()->query_entire_dbase();

  if (!my["title"]) set("title", "罗汉堂武僧");
  if (!my["gender"]) set("gender", "男性");
  if (!my["age"]) set("age", 18 + random(10));
  if (!my["attitude"]) set("attitude", "friendly");

  if (!my["max_force"]) set("max_force", 500 + random(40));
  if (!my["force"]) set("force", 500 + random(40));
  if (!my["force_factor"]) set("force_factor", 10);

  /*    
    set_wugong("luohan-quan"    , 80, 80,1);
    set_wugong("weituo-zhang"   , 80, 80,1);
    set_wugong("fuhu-quan"      , 80, 80,1);
    set_wugong("shaolin-shenfa" , 60, 60,1);
    set_wugong("shaolin-neigong", 20, 20,0);
    set_xiuwei_by_type("unarmed",300);
    set_xiuwei_by_type("dodge"  ,300);
不知道怎么判断有没有set武功
*/


  if (!my["combat_exp"]) set("combat_exp", 10000);
  if (!my["social_exp"]) set("social_exp", 10000);

  if (!my["inquiry"])
    set("inquiry", ([
      "少林寺": (: ask_for_shaolin :),
      "剃度": (: ask_for_join :),
      "出家": (: ask_for_join :),
    ]));

  if (!my["class"]) set("class", "bonze");
  if (!my["family"])
    set("family", ([
      "family_name": "少林派",
      "master_name": "慧轮",
      "master_id": "hui lun",
      "generation": 38,
      "title": "罗汉堂弟子",
    ]));

  ::setup();
}

string ask_for_shaolin() {
  object me, ob;

  me = this_player();
  ob = this_object();
  message_vision("$N惊讶地望着$n，一脸的不能置信。\n", ob, me);
  return ("什么？你连少林寺都没听说过吗？\n");

}

string ask_for_join() {
  object me;

  me = this_player();

  if ((string)me->query("class") == "bonze")
    return "阿弥陀佛！师弟何苦开这种玩笑？\n";
  if ((string)me->query("gender") != "男性")
    return "阿弥陀佛！女施主，这里是寺庙，请你到尼庵去剃度吧。\n";
  return "阿弥陀佛！善哉！善哉！\n"
    "施主若真心皈依我佛，不妨找慧绝师叔剃度。\n";
}

void attempt_apprentice(object ob) {
  object me = this_object();

  if ((string)ob->query("gender") != "男性")
    message_vision(CYN "$N脸一红，低头道：“女施主不要跟贫僧开这种玩笑。”\n" NOR, me, ob);
  else if (ob->query("class") != "bonze")
    message_vision(CYN "$N合什道：“小僧武功见识皆不足道，施主取笑了。”\n" NOR, me, ob);
  else
    message_vision(CYN "$N怫然道：“师弟何苦开这种玩笑？”\n" NOR, me, ob);
  return;
}

int valid_teach(object ob, string skill) {
  object me = this_object();

  if (ob->query("family/family_name") != "少林派")
    return 0;
  if (ob->query_marks("quest_finished/少林") + 1000 < ob->query("mud_age")) {
    say(me->name() + "微一皱眉，说：“嗯...今天的日常洒扫作了没有？”\n");
    return 0;
  }
  switch (skill) {
    case "shaolin-neigong":
      if (ob->query_lingwu("shaolin-neigong") > 20)
        return notify_fail("强身健体有这点内力也就够了。\n");
    case "shaolin-shenfa":
    case "luohan-quan":
      break;
    case "weituo-zhang":
      if (ob->query_lingwu("luohan-quan") < 60)
        return notify_fail("本门武功最重根基，待你将罗汉拳练熟，我自会教你。\n");
      break;
    case "fuhu-quan":
      if (ob->query_lingwu("weituo-zhang") < 60)
        return notify_fail("本门武功最重根基，待你将韦陀掌练熟，再学伏虎拳不迟。\n");
      break;
  }
  return ::valid_teach(ob, skill);

}

void tell_skills_to_apprenticed(object me) {
  message_vision(
    "$N脸一红道：愚兄姿质愚鲁，武学上的进境反到不如师弟你快捷，真是惭愧。\n"
    "不过我听得师父曾言到，少林武学最高的有七十二门绝技，施展起来威力无穷，\n"
    "直逼天人之境。江湖上多有人窥视。我这辈子大概是没指望了，但愿师弟你能有\n"
    "机会研习。\n", this_object());
  return;
}

int tell_skills(object me) {
  object ob = this_object();

  if (me->query("family/family_name") != "少林派")
    message_vision("$N警觉地望着$n，问道：“你问这个干什么？”\n", ob, me);
  else if (me->query("family/master_id"))
    tell_skills_to_apprenticed(me);
  else message_vision(
    "$N脸色一正道：本门武功以拳脚为主。你过木人巷前能学的，\n"
    "有罗汉拳，韦陀掌，伏虎拳三门拳脚。也能练少许内力。另外轻\n"
    "身健体的功夫也可以抽空练练。\n", ob);
  return 1;
}
