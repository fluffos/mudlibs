#include <ansi.h>

inherit "/d/menpai/shaolin/npc/xu";

void create() {
  set_name("虚明", ({ "xu ming", "xu", "ming", "he shang",
    "seng ren", "bonze" }));
  set("long", @LONG
一个二十多岁的青年僧人，身材魁梧，双目有神。举手投足间常显现出彪悍
之气，怎么看也象武师多过象和尚。
LONG
  );

  set_wugong("luohan-quan", 80, 80, 1);
  set_wugong("weituo-zhang", 80, 80, 1);
  set_wugong("shaolin-shenfa", 60, 60, 1);
  set_wugong("shaolin-neigong", 20, 20, 0);
  set_xiuwei_by_type("unarmed", 250);
  set_xiuwei_by_type("dodge", 250);

  setup();
  carry_object(CLOTH_DIR "sengyi1.lpc")->wear();
}
