// room:/d/shaolin/dizang_dian.c

#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
    set("short", CYN"地藏殿"NOR);
    set("long", @LONG
这里是供奉主宰阴曹地府的地藏王菩萨的地藏殿。殿内正中佛龛里是一座紫
檀木雕成的地藏菩萨像。雕刻得精巧入微，有若生人，显然是出自名家之手。殿
两边侍立着十殿阎罗。你刊着这些雕像(diaoxiang)，不禁心有所感。
LONG
    );
    set("exits", ([ 
        "east"      : __DIR__"lixue_ting",
        ]));
    set("item_desc", ([
        "diaoxiang" : @TEXT
虽是木雕泥塑，但神情自若，不怒自威，站在他们面前，你忽然感到自己过去的
种种所为，无不落在他们眼中，再是自以为不为人知的劣迹，也难瞒过他们去。
你不禁检讨起自己往昔的种种过错，立志向佛行善，做个好人。
TEXT
        ]));    
    set("valid_startroom", 1);
    setup();
    replace_program(ROOM);
}                       


