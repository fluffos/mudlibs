// rooms:/d/shaolin/zhulin_xiaodao1.c

#include <room.h>

inherit ROOM;

void create() {
  set("short", "竹林小道");
  set("long", @LONG
这里是少林寺的竹林小道，往东是药王院，往西是戒律堂。
LONG
  );
  set("no_fight", 1);
  set("exits", ([
    "east": __DIR__ "yaowang_yuan1",
    "west": __DIR__ "jielu_tang1",
    "south": __DIR__ "lixue_ting",
    "north": __DIR__ "zhulin_xiaodao2",
  ]));
  set("objects", ([
    __DIR__ "npc/huwei2": 2,
  ]));

  set("outdoors", "shaolin");
  setup();
}

int valid_leave(object who, string dir) {
  if (dir != "south" && !wizardp(who)) {
    if (objectp(present("huwei seng"))) {
      message_vision("灰衣护卫僧双手一张，拦住去路：\n"
        "“都说了不能乱闯。你怎么不听呀！”\n", who);
      return notify_fail("你只好收住了脚。\n");
    }
  }

  return ::valid_leave(who, dir);
}
