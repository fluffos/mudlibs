// long shu shu shao : /d/shaolin/longshu_shushao.c

inherit ROOM;

void init();
int do_climb(string);

void create()
{
    set("short","龙树树稍");
    set("long",@LONG
这里是龙树的树稍，人站在这里，就感觉到被层层绿色所包围，头顶上的鸟
鸣声逾加清脆了。透过茂密的枝叶中，可以看到有一枝巨大的树枝向北方延伸出
去，一直横跨到东厢房的屋顶之上。
LONG
    );
    set("exits",([
        "down" : __DIR__"longshu",
        "north" : __DIR__"longshu_wuding",
    ]) );

    setup();
}

void init()
{
    add_action("do_climb", "climb");
}


int do_climb(string arg)
{
    object me = this_player();
    int ddg = this_player()->query_skill("dodge", 1);

    if (arg != "tree") return command("climb "+arg);

    message_vision("$N一缩身,顺着数干往上爬。\n", me);

    if (ddg<20)
    {
        message_vision("爬到一半，一不留神，又滑了下来。\n", me);
    }
    else
    {
        message_vision("你一口气爬上了龙树的树顶。\n", me);

        me->move(__DIR__"longshu_top");
    }

    return 1;
}


