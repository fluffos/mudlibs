#include <ansi.h>
#include <room.h>

inherit ROOM;

void create()
{
    set("short","山麓小径");
    set("long",@LONG
一条弯弯曲曲的小径，沿着山势，在一条不深的山谷中之中，随着地势渐渐
升高。两边是数人高的，斜斜的土坡，上面生满了半人高的灌木丛；耳边不时传
来各种山林鸟雀的叫声，地上蟋蟀的鸣叫，以及风吹过山梁上高大的树林时发出
的“呜呜”的声音。
LONG);
    set("exits",([
        "westdown"   : "/d/map/zhongyuan/tulu1",
        "southeast"  : __DIR__"shaoshi_shanyao1",        
    ]));
    set("outdoors","shaolin");
    setup();
    replace_program(ROOM);
}
