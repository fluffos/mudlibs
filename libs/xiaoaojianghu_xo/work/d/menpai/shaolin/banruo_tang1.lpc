// Room: /d/shaolin/banruo_tang1.c

inherit ROOM;

void create()
{
    set("short", "般若堂正厅");
    set("long", @LONG
宽广的大厅，居中挂着一块匾额：“般若堂”。原来这里就是少林高僧研究
别派武学的般若堂了。每当少林弟子回山，到戒律堂检讨自己此次下山有无触犯
戒律之后，就要到般若堂来，详细记叙这次看到别派有什么新奇的武功。般若堂
的高僧就会仔细研究其中有无破绽，如何破解，当真有所变故时，也不致束手无
策。少林威名得以百年不坠，实非侥幸，期间尽是无数人的心血。
LONG
    );
    set("exits", ([
        "west"      : __DIR__"zhulin_xiaodao2.lpc",
        "east"      : __DIR__"banruo_tang2.lpc",
        "south"     : __DIR__"banruo_tang3.lpc",
        "north"     : __DIR__"banruo_tang4.lpc",
    ]));

    setup();
    replace_program(ROOM);
}

