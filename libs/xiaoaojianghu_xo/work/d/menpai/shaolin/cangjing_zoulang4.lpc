inherit ROOM;

void create()
{
    set("short","走廊");
    set("long",@LONG
这是藏经阁二楼的北走廊。往北是藏经阁的北阁，往南是一条长长的走廊，
通往藏经阁的西阁和东阁。
LONG
    );
    set("exits",([
        "south" : __DIR__"cangjing_zoulang2",
        "north" : __DIR__"cangjing_beige"
    ]) );

    setup();
