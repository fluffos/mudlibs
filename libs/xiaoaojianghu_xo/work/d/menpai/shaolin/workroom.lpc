// Room: /u/peacock/workroom.c

#include "ansi.h"

inherit ROOM;

void create()
{
    set("short", HIR"孔雀明王封印处"NOR);
    set("long", @LONG
甬道的尽头是一个巨大的石匣(shixia)。石匣浑然一体，没有丝毫缝隙，仿佛
是一整块石头雕刻成的。你忽然意识到你之所以一开始就认为这是一个石匣，
是因为从匣里传来一种感觉，使你清楚地知道里面装有东西。石匣正面加了一
道封印，封印上方是七个深红色的篆字: 
LONG
RED "                         孔雀明王封印处\n" NOR
@TEXT
字色鲜艳，红得仿佛会滴出血来。原来，这就是七万五千年前，率领魔族同诸
神战斗的光明守护神，黑暗大天使孔雀长眠的地方了。
TEXT
    );
        set("valid_startroom", 1);
    set("exits", ([
        "inn"       : "/d/snow/inn",
        "shaolin"   : "/d/peacock/dizang_dian",
        "wiz"       : "/d/wiz/wizhall",
    ]));
    set("item_desc",([
        "shixia"    : @TEXT
        一个足有一人多高，四四方方的石匣，上面镌刻着许多
        栩栩如生的图案(tu)，描写的都是些非人的异物，显出
        一种说不出的诡异。
TEXT
,
        "tu"        : @TEXT
            酷烈的画面描绘的是一场战争，一场非人与非人之
        间的战争。虽然只是刻在石头上的浮雕，记叙的也是虚
        无缥缈的事，但却使你觉得仿佛被卷入了这血腥的战场
        。
            你的目光被一个背生双翅的人所吸引，想挪开也有
        所不能。他身披战甲，头戴王冠，六只手中握着剑和盾
        ，斜睨的眼里毫不掩饰他的桀骜不逊。他就那么站在半
        空，站在天与地之间，站在神与魔之间，站在光明与黑
        暗之间。那么孤独，那么寂寞，那么充满了热情和斗志
        。
            你知道，这个独力向诸天挑战的年轻人，就是传说
        中的孔雀明王(kongque)了。
TEXT
,
        "kongque"   : @TEXT
    在遥远的过去，人类还只会在林间与野兽搏命的时代，掌握天地
万物的是神和魔。在漫长的战争中，诸神逐渐占了上风，魔族被迫藏
匿在黑暗里，在恐惧与不安中生活。直到有一天，孔雀诞生了。
    孔雀是作为诸神中最强的战士——光明的守护神出生的。但他深
深体味到黑暗中的悲哀，那种绝望中的期待。于是他背叛了自己的族
人，率领魔族反击诸神的屠戮。那是一场惊心动魄的大战。失去了孔
雀的神族节节败退，七座光的圣域全部被毁。他高贵的仪表和那无可
抗拒的力量征服了战场上的每一个人。他在诸神中散布着恐惧，而魔
族则对他衷心地敬仰，他们觉得孔雀是他们的天使——黑暗大天使。
    但在孔雀出生之前，魔族已被诸神欺凌得太弱了。孔雀几乎是在
独力对抗众神。他终于在这近乎无休止的战斗中耗尽了全部的力量。
他们战败了。
    燃烧着的天使带着诸神的诅咒和魔族的期盼沉入了地狱。侥幸获
胜的神族已伤亡得所剩无几，无力再追杀至地底深处，而魔族也不敢
惊扰他们的英雄的休息。于是，这一睡就是七万五千年。
    在这七万五千年里，人类由于神和魔的衰弱而崛起，逐渐成了万
物之灵。而神和魔在实力均等下，也都不敢首先发难。他们一方占据
着光明，一方占据着黑暗，各自待在自己的领地。而光与暗之间的世
界就属于人类了。
    神和魔在这七万五千年中始终流传着一个传说，一个梦想。那是
一个恐怖的传说，美丽的梦想——
TEXT
RED"                终有一天，孔雀将会醒来。\n"NOR
    ]));
    setup();
    call_other( "/u/peacock/peacock_b", "???" );
}

