inherit ROOM;

void create()
{
        set("short", "八部天龙");
        set("long", @LONG
这里是少林寺的八部天龙之天，之夜叉，之阿修罗，之紧那罗。天为天神，为
极乐之无上神通，尊万物无常妙法，亦不能脱生死轮回；夜叉为鬼，主鬼蜮亦及众
生界，往来护法；阿修罗为神道，善斗，无受佛祖约束，叱咤天地间；紧那罗为人
道，然非人，擅鸣而乐歌舞，以颂众生。
LONG
        );
        set("exits", ([ /* sizeof() == 1 */
                "east" : __DIR__"daxiong-baodian.lpc",    
        ]));
