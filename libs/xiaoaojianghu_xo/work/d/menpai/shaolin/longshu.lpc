// long shu : /d/shaolin/longshu.c

inherit ROOM;

void init();
int do_climb(string);

void create()
{
    set("short","龙树");
    set("long",@LONG
眼前有一株高大的古树，主干粗大，足可让十来个人团团围抱。树上枝叶茂
密，挡住了天空，所以即使在白天，也看不见阳光。繁枝密叶中，隐隐传来声声
的鸟鸣。树底有一个小小的树洞(hole)，里面黑漆漆的，什么都看不见。这里往
西，可以走回到龙树院的大门口。
LONG
    );
    set("exits",([
        "west" : __DIR__"longshu_yuan",
    ]) );

    set("item_desc", ([
        "hole" : "洞里面黑漆漆的，什么都看不见。\n",
    ]));


    setup();
}

void init()
{
    add_action("do_climb", "climb");
}


int do_climb(string arg)
{
    object me = this_player();

    if (arg != "tree") return command("climb "+arg);

    message_vision("$N一缩身,顺着数干爬上了龙树。\n", me);

    me->move(__DIR__"longshu_shushao");

    return 1;
}

