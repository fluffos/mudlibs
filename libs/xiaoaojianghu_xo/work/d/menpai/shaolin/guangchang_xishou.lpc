// rooms:/d/shaolin/guangchang_xishou.c

#include <room.h>

inherit ROOM;

void create()
{
    set("short", "广场西首");
    set("long", @LONG
广场西首是打熬力气的所在。四下里七零八落地放着一些石锁，仙人石之类的器
件。几个僧人正在认真地举起放下，一个个呲牙咧嘴的，也不知已经举了多少次
，更不知还要举到什么时侯。看着他们脸上痛苦的表情，你不禁联想起另一种也
是骑马蹲裆，脸憋得通红的活动，不禁感慨自己想象力丰富。
LONG
    );
    set("exits", ([ 
        "east"      : __DIR__"guangchang",
        "west"      : __DIR__"heshang_yuan1",
        "north"     : __DIR__"lixue_ting",
    ]));
    set("outdoors", "shaolin");
    setup();
    replace_program(ROOM);
}                       

