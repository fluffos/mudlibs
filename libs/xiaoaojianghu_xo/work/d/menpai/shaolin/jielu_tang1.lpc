inherit ROOM;

void create()
{
    set("short", "戒律堂正厅");
    set("long", @LONG
厅堂正上方挂了一块匾额，上书“谨言慎行”四个大字。少林威名得以百年
不坠，不光是因为武学精湛，更是因为戒律严明。上至方丈，下至刚入门的弟子
，只要是触犯戒律的，都要受罚，决无情面可言。这里大概是少林僧人最不愿涉
足的地方了。但少林弟子每次下山归来，都要先到这里禀告有无犯规。实是不得
不来。
LONG
    );
    set("exits", ([
        "east"      : __DIR__"zhulin_xiaodao1.lpc",
        "west"      : __DIR__"jielu_tang2.lpc",
        "south"     : __DIR__"jielu_tang3.lpc",
        "north"     : __DIR__"jielu_tang4.lpc",
    ]));

    setup();
    replace_program(ROOM);
}

