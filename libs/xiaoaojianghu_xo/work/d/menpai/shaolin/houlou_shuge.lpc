// 藏经后楼书阁 : /d/shaolin/houlou_shuge.c

inherit ROOM;

void create()
{
    set("short","藏经后楼书阁");
    set("long",@LONG
这是一间收拾得极为朴素的楼阁，里面除了几张蒲团之外一无所有。有几位
僧人坐在蒲团上边翻阅着武功秘籍，边在冥思苦想。往北是藏经后楼的书库。沿
往着楼梯往下走，是藏经后楼的底楼大厅。
LONG
    );
    set("exits",([
        "down" : __DIR__"cangjing_houlou",
        "north" : __DIR__"houlou_shuku",
    ]) );

    setup();
}

