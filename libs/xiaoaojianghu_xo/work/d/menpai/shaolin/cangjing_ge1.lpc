// Room: /d/shaolin/cangjing_ge1.c

#include <ansi.h>

inherit ROOM;

void create()
{
    set("short", RED"少林藏经阁"NOR);
    set("long",@LONG 
一座精巧而又朴实的三层八角小楼座落在翠竹林中，四周三面环水，只
有一面和陆地相通。这，就是天下武林豪杰无不渴望得以入内的少林藏经阁。
这座小楼中存放着浩如烟海的佛学经典，然而最吸引人的无疑是内藏的少林
名动天下的七十二绝艺的武学秘籍。无数武林人士穷极种种手法以图进入此
阁，因而少林寺也对本阁严加看守，要想随便入阁真是势比登天还难。
LONG    );

    set("exits", ([
        "north" : __DIR__"cangjing_ge2",
        "south" : __DIR__"shanmen_guangchang",
    ]));
    set("objects", ([
        __DIR__"npc/huwei" : 4,
    ]));

    set("outdoors", "shaolin");
    set_temp( "lala/武僧总数", 24);    
    setup();
}

int valid_leave(object me, string dir)
{
        object ob, here;
        int i;

        here = this_object();
        if ( ( me->query("class") != "bonze1" ) && ( dir == "north" ) )
        {
                if( ( ob = present( "huwei seng", here )) && ob -> can_act() )
                        return notify_fail(
GRN "灰衣僧人合十为礼，朗声说道：“阿弥陀佛！藏经阁乃本寺重地，这位" + RANK_D->query_respect(me) +
"没有得到本寺方丈准许，不可入内！”\n" NOR);
                if( ( ob = present( "shaolin sengbing", here )) && ob -> can_act() )
                        return notify_fail(
YEL "少林僧兵喝道：“好贼子，哪里逃！”上前拦住了去路。\n" NOR );
                if ( here -> query_temp( "lala/武僧总数" ) >0 )
                {
                        message_vision( YEL 
"$N正要前行，突然只听一声佛号，从草丛中跳出几个身穿土黄色袈裟的少林僧来，\n" +
"只见这些僧人或空手或持兵刃，一个个对$N怒目而视。\n\n" + RED
"为首的僧人喝道：“大胆贼子，竟敢在少林寺杀人放火！” \n\n" NOR, me);
                        for (i=1;i<=4;i++)
                        {
                                ob = new(__DIR__ + "npc/huwei1");
                                ob -> move(here);
                                ob -> set_leader(me);
                                ob -> kill_ob(me);
                        }
                        here -> add_temp( "lala/武僧总数", -4);
                        return notify_fail("看来是过不去了……\n");             
                }
        }
        return ::valid_leave(me, dir);
}


