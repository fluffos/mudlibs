#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "水井");
        set("long", @LONG
这里是伙房后面，有一口水井，平时家丁卫士们吃水都是吃这里的水。水井
周围的泥土很湿润，看来是经常有人来挑水的样子。旁边长着绿油油的小草和无
名的野花，随风摇曳，倒也让人觉得颇为安静。
LONG
        );
    set("exits", ([ 
                "north"  : __DIR__"huofang",
        ]));
        set("resource/water",1);
        set("fillplace","水井");
        set("watername","清凉的井水");
        set("outdoors", "dali");
        setup();
}                       


