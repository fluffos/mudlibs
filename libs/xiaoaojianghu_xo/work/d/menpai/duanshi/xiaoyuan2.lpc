#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "小院");
        set("long", @LONG
一所精巧的小院，是供王府的女性下人居住的地方。院子东面南面都是一排
侍女们住的厢房。院子中有几棵树，还有一些石桌石凳，几个女孩子正坐在那儿
说悄悄话，不时发出“吃吃”的笑声。
LONG
        );
    set("exits", ([ 
                "south"  : __DIR__"xiangfang4",
                "north"  : __DIR__"xikuayuan",
                        "east"   : __DIR__"xiangfang6",
        ]));
        set("objects", ([
                        __DIR__"npc/shinv"  : random(3),
                        __DIR__"npc/shinv2" : random(3),
                ]));
        set("outdoors", "dali");
        setup();
}                       

