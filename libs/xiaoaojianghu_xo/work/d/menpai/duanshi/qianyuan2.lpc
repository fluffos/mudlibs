#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "王府前院");
        set("long", @LONG
这里是镇南王府的前院，一色的青砖铺地，四周种了几棵大树。这里是王府
下人们活动的中心，到各处都要经过这里。向西是伙房，向南是库房。
LONG
        );
    set("exits", ([ 
                "south"  : __DIR__"kufang",
                "north"  : __DIR__"qianyuan",
                "west"   : __DIR__"huofang",
                "east"   : __DIR__"jiadao1",
        ]));
        set("objects", ([
                        __DIR__"npc/jiading2" : 1,
                ]));
        set("outdoors", "dali");
        create_door("south","厚重的铁门","north",DOOR_CLOSED);
        setup();
}                       


