#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "狗房");
        set("long", @LONG
这儿是王府的狗房。一溜儿铁笼子里养着十几条狼犬，这些狼犬看见你进来，
都警觉地竖起耳朵，直直地盯着你。几个家丁正在忙着给狗添食添水，训练狗的
各种动作，一个身份高些的家丁走来走去地监督他们。
LONG
        );
    set("exits", ([ 
                "south"  : __DIR__"dongkuayuan",
        ]));
        set("objects", ([
                        __DIR__"npc/jiading3" : 2,
                        __DIR__"npc/jiading1" : 1,
                ]));
        setup();
}                       


