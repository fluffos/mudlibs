inherit NPC;
inherit F_MASTER;

#include <ansi.h>

void create() {
  set_name("华赫艮", ({ "hua hegen", "hua", "hegen" }));
  set("title", CYN "大理国" RED "司徒" NOR);
  set("gender", "男性");
  set("age", 45);
  set("attitude", "peaceful");
  set("class", "duanshi");
  set("long", @LONG
华赫艮官居大理三公之一的司徒之位，深得保定帝的信任，视之如左膀右臂。
然而他原来叫做华阿根，专干掘地道盗墓的勾当。一次盗墓时发现了一本先代
秘籍，自此练就了一身卓绝的外门工夫，便舍弃了这下贱的营生，辅佐保定帝
累立奇功，终于升到司徒之位。
LONG);
  set("str", 24);
  set("int", 25);
  set("spi", 26);
  set("con", 27);
  set("cps", 28);
  set("cor", 29);
  set("per", 15);
  set("force", 1800);
  set("max_force", 1800);
  set("force_factor", 15);
  set("max_kee", 700);
  set("kee", 700);
  set("max_sen", 800);
  set("sen", 800);
  set("rank_info/respect", "司徒大人");

  set("class_score/镇南王府", 2000);
  set("combat_exp", 100000);
  set("social_exp", 500000);
  set("positive_score", 50000);

  set_wugong("jiben-qinggong", 180, 180, 0);
  set_wugong("unarmed", 190, 190, 0);
  set_wugong("duanshi-neigong", 180, 180, 0);
  set_wugong("duanshi-xinfa", 70, 70, 1);
  set_wugong("blade", 180, 180, 0);
  set_wugong("kuaige-dao", 160, 160, 0);
  set_wugong("zuiliu-dao", 140, 140, 1);
  set_wugong("haofeng-quan", 170, 170, 0);
  set_wugong("zhuifeng-quan", 150, 150, 0);
  set_wugong("tianhong", 160, 160, 0);
  set_wugong("shenxing", 140, 140, 1);
  set_wugong("huzhua-gong", 130, 130, 1);

  set_xiuwei_by_type("blade", 1300);
  set_xiuwei_by_type("unarmed", 1500);
  set_xiuwei_by_type("dodge", 1300);
  set_xiuwei_by_type("zonggang", 1100);

  create_family("镇南王府", 1, "司徒");

  setup();

  carry_object(CLONE_DIR "wear/boots/wuyun_xue")->wear();
  carry_object(CLONE_DIR "wear/waist/chahe_luandai")->wear();
  carry_object(CLONE_DIR "wear/cloth/baizhu_sipao")->wear();
  carry_object(CLONE_DIR "wear/head/qingsha_jin")->wear();
}

#include "sangong.h";
#include "teach.h";
