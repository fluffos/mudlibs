// By lala on July 19, 1997

#include <ansi.h>
#include "guard.h";

void create()
{
    string name, id;
    int i, j;
    i = random(sizeof(second_name));
    j = random(sizeof(last_name));
    name = "段";
    name += second_name[i];
    name += last_name[j];
    id = second_id[i];
    id += last_id[j];
    set_name(name, ({ "duan " + id, id }) );
    set("title", MAG"镇南王府卫士"NOR);
    set("gender", "男性");
    set("age", 30+random(20));
    set("combat_exp", 10000+random(10)*1000);
        set("social_exp", 50000+random(10)*5000);
        set("positive_score", 200);
        set("class", "duanshi");
    set("max_force", 800);
    set("force", 800);
    set("force_factor", 10);

    set_wugong("duanshi-neigong", 80, 80, 1);
    set_wugong("zuiliu-dao", 100, 100, 1);
    set_wugong("zhuifeng-quan", 100, 100, 1);
    set_wugong("shenxing", 60, 60, 1);

    set_xiuwei_by_type("blade", 400);
    set_xiuwei_by_type("unarmed", 400);
    set_xiuwei_by_type("dodge", 400);

    set("env/attack", 60);

    create_family("镇南王府", 2, "卫士");
    
    setup();

        carry_object(__DIR__"obj/boots")->wear();
        carry_object(__DIR__"obj/waist")->wear();
        carry_object(__DIR__"obj/armor")->wear();
        carry_object(__DIR__"obj/surcoat")->wear();    
    carry_object(__DIR__"obj/cloth2")->wear();
    switch( random(2) )
    {
        case 0:
            break;
        case 1:
            carry_object(__DIR__"obj/blade")->wield();
            break;
     }
}

void init()
{
    object ob, me;
    ob = this_object();
    me = this_player();
    
    if ( ob->can_act() 
        && !me->query_condition("kill_dali")
        && !ob->is_fighting() 
        && (me->query("title")=="大理国武官") || (me->query("title")==YEL"镇南王府卫士"NOR) )
    {
        remove_call_out("greeting");
        call_out("greeting", 1, me);
    }
    if (ob->can_act()
        && me->query_condition("kill_dali") )
    {
        remove_call_out("kill_him");
        call_out("kill_him", 1, me);
    }
}

void greeting(object me)
{
    if( interactive(me) && environment() == environment(me))
    {
        message_vision(YEL"$N对$n叉手施礼：“卑职见过长官！长官好！”\n"NOR, this_object(), me);
    }
}

void kill_him(object me)
{
    message_vision( "$N对着$n大喝一声：“杀人放火的强盗，快快受死吧！！！” \n",
 this_object(), me );
    kill_ob(me);
}
    
