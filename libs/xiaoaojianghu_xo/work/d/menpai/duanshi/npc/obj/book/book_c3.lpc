inherit ITEM;

void create()
{
    set_name("「拳脚入门」", ({ "quanjiao rumen", "book", "shu" }));
    set_weight(350);
    if( clonep() )
        set_default_object(__FILE__);
    else {
    set("unit", "本");
    set("num", "c3");
    set("long", "这是一本讲述拳脚的书。\n");
    set("value", 50);
    set("material", "paper");
    set("skill", ([
        "name"              :"unarmed",
        "xiuwei_required"   : 0,
        "literate_required" : 5,
        "gin_cost"          : 10+random(10),
        "max_jibie"         : 80,
        "max_lingwu"        : 80,
        "bonus_jilei"       : 2+random(5),
        ]) );
    }
}   

#include "duan_book.h"
         
