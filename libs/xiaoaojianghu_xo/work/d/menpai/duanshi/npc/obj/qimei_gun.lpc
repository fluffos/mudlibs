//qimei_gun.c
#include <weapon.h>
#include <armor.h>
#include <ansi.h>
inherit STAFF;
void create() {
  set_name("齐眉棍", ({ "qi mei gun", "wood gun", "woodstick", "gun", "staff" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", @LONG
一根长逾四尺手腕粗细的木棒，直立正好齐眉，上面镌刻着“镇南王府 段”。
LONG);
    set("unit", "根");
    set("value", 2);
    set("material", "wood");
    set("armor_prop/armor", 1);
    set("cant_sell", "啊？！这个可是镇南王府的东西呀！小的我还想多活两年呢，可不敢收！\n");
  }
  init_staff(10);
  set("wield_msg", "$N将一根$n紧握在胸前。\n");
  set("unwield_msg", "$N将手中的$n放下。\n");
  setup();
}
