#include <armor.h>
#include <ansi.h>
inherit SURCOAT;
void create()
{
    set_name(RED"大红披风"NOR, ({ "pi feng", "surcoat", }) );
    set_weight(500);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("long", "这是一件大红面黑缎里子的披风，披风正中绣着一个碗口大的“段”字。\n");
        set("unit", "件");
        set("value",140);
        set("material", "cloth");
        set("armor_prop/armor", 2);
                set("cant_sell", "啊？！这个可是镇南王府的东西呀！小的我还想多活两年呢，可不敢收！\n");
    }
    setup();
}

