//boots.c
#include <armor.h>
inherit BOOTS;
void create()
{
    set_name("薄底快靴", ({"baodi kuaixue", "xue", "boots"}));
    set_weight(500);
    if ( clonep() )
        set_default_object(__FILE__);
    else {
        set("long", "这双靴子缝制精细，轻便灵巧，武林人士常穿这种靴子；靴子的面上绣着“镇南王府 段”。\n");
        set("unit", "双");
        set("value", 200);
                set("cant_sell", "啊？！这个可是镇南王府的东西呀！小的我还想多活两年呢，可不敢收！\n");
        set("material", "silk");
        set("armor_prop/armor", 1);
        set("armor_prop/dodge", 10);
    }
    setup();
}

