#include <armor.h>
inherit ARMOR;
void create()
{
        set_name("绵甲", ({"mian jia", "armor", }) );
        set_weight(3000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一套用厚实的布料缝制的绵甲，胸口绣一个碗口大的“段”字。\n");
                set("unit", "套");
                set("value",200);
                set("material", "cloth");
                set("armor_prop/armor", 4);
                set("armor_prop/defence", 4);
                set("cant_sell", "啊？！这个可是镇南王府的东西呀！小的我还想多活两年呢，可不敢收！\n");
        }
        setup();
}

