inherit ITEM;

void create()
{
    set_name("「基本杖法」", ({ "jiben zhangfa", "book", "shu" }));
    set_weight(250);
    if( clonep() )
        set_default_object(__FILE__);
    else {
    set("unit", "本");
    set("num", "b1");
    set("long", "这是一本简要介绍杖法的书。\n");
    set("value", 100);
    set("material", "paper");
    set("skill", ([
        "name"              :"staff",
        "xiuwei_required"   : 10,
        "literate_required" : 20,
        "gin_cost"          : 10+random(10),
        "max_jibie"         : 60,
        "max_lingwu"        : 60,
        "bonus_xiuwei"      : 2,
        "max_xiuwei"        : 200,
        ]) );
    }
}   

#include "duan_book.h"
         
