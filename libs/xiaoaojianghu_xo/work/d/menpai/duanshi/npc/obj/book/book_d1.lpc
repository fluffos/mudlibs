inherit ITEM;

void create()
{
    set_name("「雨后霓虹图」", ({ "yuhounihong tu", "tu" }));
    set_weight(30);
    if( clonep() )
        set_default_object(__FILE__);
    else {
    set("num", "d1");
    set("unit", "幅");
    set("long", "这是一幅精美的「雨后霓虹图」。\n");
    set("value", 400);
    set("material", "paper");
    set("skill", ([
        "name"              :"tianhong",
        "xiuwei_required"   : 90,
        "literate_required" : 80,
        "gin_cost"          : 10+random(10),
        "max_jibie"         : 60,
        "max_lingwu"        : 60,
        "bonus_xiuwei"      : 2,
        "max_xiuwei"        : 260,
        ]) );
    }
}   

#include "duan_book.h"
         
