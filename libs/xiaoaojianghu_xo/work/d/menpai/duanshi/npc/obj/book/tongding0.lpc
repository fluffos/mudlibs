#include <ansi.h>
inherit ITEM;

void create() {
  set_name(GRN "青铜鼎" NOR, ({ "tong ding", }));
  set_weight(300000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "口");
    set("long", "这是一口巨大的" GRN "青铜鼎" NOR "，鼎身上铭刻着花纹，有些仿佛是文字。\n");
    set("value", 50);
    set("material", "steel");
    set("skill", ([
      "name": "duanshi-xinfa",
      "xiuwei_required": 0,
      "literate_required": 120,
      "gin_cost": 30 + random(10),
      "max_jibie": 105,
      "max_lingwu": 105,
      "bonus_jilei": 0,
    ]));
  }
}

#include "duan_book.h"
