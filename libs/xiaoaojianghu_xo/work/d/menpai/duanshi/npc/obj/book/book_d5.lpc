inherit ITEM;

void create()
{
    set_name("「闪躲之术」", ({ "shanduo zhishu", "book", "shu" }));
    set_weight(300);
    if( clonep() )
        set_default_object(__FILE__);
    else {
    set("unit", "本");
    set("num", "d5");
    set("long", "这是一本简单讲述轻功的书。\n");
    set("value", 20);
    set("material", "paper");
    set("skill", ([
        "name"              :"jiben-qinggong",
        "xiuwei_required"   : 0,
        "literate_required" : 5,
        "gin_cost"          : 10+random(10),
        "max_jibie"         : 30,
        "max_lingwu"        : 30,
        "bonus_xiuwei"      : 2,
        "max_xiuwei"        : 20,
        ]) );
    }
}   

#include "duan_book.h"
         
