inherit ITEM;

void create()
{
    set_name("「魏征诗集」", ({ "weizheng shiji", "book", "shu" }));
    set_weight(200);
    if( clonep() )
        set_default_object(__FILE__);
    else {
    set("unit", "本");
    set("num", "f0");
    set("long", "这是一本唐朝大臣魏征的诗集。\n");
    set("value", 150);
    set("material", "paper");
    set("skill", ([
        "name"              :"shuhuai-bifa",
        "xiuwei_required"   : 100,
        "literate_required" : 100,
        "gin_cost"          : 10+random(10),
        "max_jibie"         : 45,
        "max_lingwu"        : 45,
        "bonus_jilei"       : 2+random(5),
        ]) );
    }
}   

#include "duan_book.h"
         
