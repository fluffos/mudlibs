// the common weapon:whip.c
// modified by Lin on March 29 ,1997
#include <ansi.h>
#include <weapon.h>

inherit WHIP;

void create()
{
        set_name( "铁鞭", ({ "tie bian","whip" }) );
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long","一条四尺来长，用钢丝拧成的鞭子，把柄上镌刻着“镇南王府 段”。\n");
                set("unit", "条");
                set("value", 600);
                set("material", "iron");
                set("cant_sell", "啊？！这个可是镇南王府的东西呀！小的我还想多活两年呢，可不敢收！\n");
        }
        init_whip(15);

        set("wield_msg", "$N从腰间解下一条$n握在手中。\n");
        set("unwield_msg", "$N将手中的$n束在腰间。\n");

        setup();
}


