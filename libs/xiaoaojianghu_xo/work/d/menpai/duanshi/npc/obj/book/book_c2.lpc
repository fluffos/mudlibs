inherit ITEM;

void create()
{
    set_name("「浩风拳谱」", ({ "haofeng quanpu", "book", "shu" }));
    set_weight(350);
    if( clonep() )
        set_default_object(__FILE__);
    else {
    set("unit", "本");
    set("num", "c2");
    set("long", "这是一本厚厚的讲浩风拳的书。\n");
    set("value", 130);
    set("material", "paper");
    set("skill", ([
        "name"              :"haofeng-quan",
        "xiuwei_required"   : 90,
        "literate_required" : 50,
        "gin_cost"          : 10+random(10),
        "max_jibie"         : 80,
        "max_lingwu"        : 80,
        "bonus_xiuwei"      : 2,
        "max_xiuwei"        : 260,
        ]) );
    }
}   

#include "duan_book.h"
         
