#include <armor.h>
#include <ansi.h>
inherit CLOTH;
void create() {
  set_name(MAG "武士服" NOR, ({ "wushi fu", "fu", "cloth" }));
  set("long", "这是一件专供镇南王府的中级卫士穿的武士服。\n");
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "cloth");
    set("unit", "件");
    set("armor_prop/armor", 2);
    set("armor_prop/dodge", 2);
    set("armor_prop/defence", 2);
    set("value", 500);
    set("cant_sell", "啊？！这个可是镇南王府的东西呀！小的我还想多活两年呢，可不敢收！\n");
  }
  setup();
}
