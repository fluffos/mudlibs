inherit ITEM;

void create()
{
    set_name("「基本鞭法」", ({ "jiben bianfa", "book", "shu" }));
    set_weight(200);
    if( clonep() )
        set_default_object(__FILE__);
    else {
    set("unit", "本");
    set("num", "e2");
    set("long", "这是一本讲基本鞭法的书。\n");
    set("value", 150);
    set("material", "paper");
    set("skill", ([
        "name"              :"jiben-bianfa",
        "xiuwei_required"   : 10,
        "literate_required" : 10,
        "gin_cost"          : 10+random(10),
        "max_jibie"         : 50,
        "max_lingwu"        : 50,
        "bonus_jilei"       : 2+random(5),
        ]) );
    }
}   

#include "duan_book.h"
         
