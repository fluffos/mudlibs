// room:/d/menpai/duanshi/wuqi_ku.c  writen by lala July-30-97

#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "武器库");
        set("long", @LONG
这里就是镇南王府的武器库。兵器架子上陈列着各种各样的兵器，长枪短刀
斧钺钩叉、十八般兵器应有尽有。王府的家丁卫士可以向值班的卫士领取自己需
要的兵器。墙上贴着一张告示(sign)。一名值班的卫士正在清点兵器。
LONG
        );
        set("item_desc", ([
                        "sign"   :
"本府卫士、家丁可以领取(ling)以下兵器：\n\n"+
"       单刀(blade)  板斧(axe)  齐眉棍(stick)  铁鞭(whip)  判官笔(pen)\n",
        ]) );
    set("exits", ([ 
                        "west"   : __DIR__"lianwu_chang5",
        ]));
        set("objects", ([
                        __DIR__"npc/weishi1" : 1,
                ]));
        create_door("west", "厚重的铁门", "east", DOOR_CLOSED);
        set("num_weapon", 16);
        setup();
}                       

void init()
{
        object *inv = all_inventory( this_object() );
    int i;
    
    for( i = 0; i < sizeof( inv ); i++ )
    {
        if( inv[i]->query("title") == YEL"镇南王府卫士"NOR
                && inv[i]->can_act()
                && !userp( inv[i] ) )
        {
                remove_call_out("greeting");
                    call_out("greeting", 1, inv[i]);
                add_action("do_ling", "ling");
            }
    }
}

void greeting( object ob )
{
        object me=this_player();
        if (random(2))
        {
                message_vision("$N发觉$n走进来，站起身，转过脸看着$n。\n", ob, me);
        }
        else
        {
                message_vision("$N忙得不可开交，根本就没有发觉$n走进来。\n", ob, me);
        }
}

int do_ling( string arg )
{
        object who, ob, me=this_player();
        object *inv = all_inventory( this_object() );
    int i;
    
    for( i = 0; i < sizeof( inv ); i++ )
    {
        if( inv[i]->query("title") == YEL"镇南王府卫士"NOR
                && inv[i]->can_act()
                && !userp( inv[i] ) )
        who = inv[i];
    }

        if (me->query("class")!="duanshi") return 0;
        if (!arg || 
                 ( arg!="blade"
                && arg!="axe"
                && arg!="stick"
                && arg!="pen"
                && arg!="whip" ) )
        {
                tell_object(me, "你要领取什么兵器？请说明。\n");
        }
        else
        {
                if ((int)query("num_weapon") > 0)
                {
                        if ( arg=="blade" )
                        {
                                ob=new(__DIR__"npc/obj/blade");
                                ob->move(me);
                                message_vision("$N交给$n一把单刀。\n", who, me);
                                add("num_weapon", -1);
                        }                                               
                        if ( arg=="axe" )
                        {
                                ob=new(__DIR__"npc/obj/banfu1");
                                ob->move(me);
                                message_vision("$N交给$n一对板斧。\n", who, me);
                                add("num_weapon", -1);
                        }                                               
                        if ( arg=="stick" )
                        {
                                ob=new(__DIR__"npc/obj/qimei_gun");
                                ob->move(me);
                                message_vision("$N交给$n一条齐眉棍。\n", who, me);
                                add("num_weapon", -1);
                        }                                               
                        if ( arg=="whip" )
                        {
                                ob=new(__DIR__"npc/obj/tiebian");
                                ob->move(me);
                                message_vision("$N交给$n一根铁鞭。\n", who, me);
                                add("num_weapon", -1);
                        }                                               
                        if ( arg=="pen" )
                        {
                                ob=new(__DIR__"npc/obj/pen");
                                ob->move(me);
                                message_vision("$N交给$n一支判官笔。\n", who, me);
                                add("num_weapon", -1);
                        }                                               
                }
                else
                {
                        message_vision("$N说：“你来的太晚了，武器都发完了。”\n", who);
                }
        }
        return 1;
}

