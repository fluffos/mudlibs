#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", GRN"餐厅"NOR);
        set("long", @LONG
一间雅致的小厅，上悬一块匾「至雅轩」。整个房间的装饰基调为翠绿色，
看起来让人感觉赏心悦目。这里就是王府里王爷和众内眷一起用餐的地方，上首
是一张雕饰着虬龙的长几，左右手分别是两张小几。几名侍女、家丁恭立一旁。
LONG
        );
    set("exits", ([ 
                "south"  : __DIR__"ceting2",
                "east"  : __DIR__"xiaochufang",
        ]));
        set("objects", ([
                        __DIR__"npc/jiading1": 3,
                        __DIR__"npc/shinv"   : 3,
                ]));
        setup();
        replace_program(ROOM);
}                       


