#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "鹰房");
        set("long", @LONG
这儿是王府的鹰房。一溜儿铁笼子里养着十几只猎鹰，这些猎鹰是在秋高气
爽的时候供王爷打猎取乐用的。这种猎鹰虽然体形不大，但是性情很是凶猛，而
且能够很好地理解主人的意旨。几个家丁正准备架着鹰出去遛遛，训练一下，一
个身份高些的家丁走来走去地监督他们。
LONG
        );
    set("exits", ([ 
                "north"  : __DIR__"dongkuayuan",
        ]));
        set("objects", ([
                        __DIR__"npc/jiading3" : 2,
                        __DIR__"npc/jiading2" : 1,
                ]));
        setup();
}                       


