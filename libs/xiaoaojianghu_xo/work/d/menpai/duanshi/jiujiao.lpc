// room:/d/menpai/duanshi/jiujiao.c  writen by lala July-25-97

#include <room.h>
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "酒窖");
  set("long", @LONG
伙房的地下是王府里存放各种酒类的酒窖。整个酒窖都是用青条石砌成的，
由于在地下，所以湿漉漉的。四周是木架子，架子上放着各式各样的酒坛子和酒
桶。虽然坛子和木桶都封得很严实，但是仍然能够闻到一股醇厚的酒香。
LONG
  );
  set("exits", ([
    "up": __DIR__ "huofang",
  ]));
  create_door("up", "沉重的铁盖子", "down", DOOR_CLOSED);
  set("num", 0);
  setup();
}

void init() {
  add_action("do_move", "move");
}

int do_move(string arg) {
  object me;
  int force;

  me = this_player();

  if (!arg ||
    (arg != "jia zi"
      && arg != "jiazi"
      && arg != "mujiazi"
      && arg != "架子"
      && arg != "木架子")) {
    return 0;
  } else {
    if (force = me->query("force") < 400) {
      message_vision("$N使出了吃奶的力气来推动木架子，但是那木架子纹丝不动。\n", me);
    } else {
      if (query("num") < (5 + ((int)me->query("kar")) / 3)) {
        message_vision("$N用力推了一下木架子，木架子动了动，上面的酒桶摇摇晃晃，似乎要掉下来……\n", me);
        add("num", 1);
        me->add("force", -50);
        if (random(40) > me->query("kar")) {
          message_vision(HIR "木架子上的酒桶一晃，终于掉了下来，“砰”的一声砸在$N的头上。\n" NOR, me);
          me->unconcious();
          me->add("eff_kee", -50);
        }
      } else {
        message_vision(HIY "$N用力一推，“吱嘎嘎～”一阵响，木架子终于挪开了一条缝，后面露出一个大洞来。\n" NOR, me);
        set("exits/eastdown", __DIR__ "midao_rukou");
        remove_action("do_move", "move");
        remove_call_out("close_dong");
        call_out("close_door", 3);
      }
    }
  }
  return 1;
}

void close_dong(int num) {
  printf("一阵机关响动，木架子又挪回原来的位置，把洞口遮了个严严实实。\n");
  delete("exits/eastdown");
  add_action("do_move", "move");
  set("num", 0);
}
