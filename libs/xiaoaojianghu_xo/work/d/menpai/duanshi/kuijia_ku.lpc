// room:/d/menpai/duanshi/kuijia_ku.c  writen by lala July-30-97

#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "盔甲库");
        set("long", @LONG
这里就是镇南王府的盔甲库。一口口箱子里放着各种盔甲和衣服。这里可以
为本府的家丁和卫士们提供盔甲和衣服。墙上贴着一张告示(sign)。一名值班的
卫士正在清点盔甲。
LONG
        );
        set("item_desc", ([
                        "sign"   :
"本府卫士、家丁可以领取(ling)以下服装和盔甲：\n\n"+
"       服装（只供卫士穿用）(cloth)  披风（只供卫士穿用）(surcoat)\n"
"       绵甲(armor)            腰带(waist)             靴子(boots)\n",
        ]) );
    set("exits", ([ 
                        "east"   : __DIR__"lianwu_chang5",
        ]));
        set("objects", ([
                        __DIR__"npc/weishi1" : 1,
                ]));
        create_door("east", "厚重的铁门", "west", DOOR_CLOSED);
        set("num_armor", 20);
        setup();
}                       

void init()
{
        object *inv = all_inventory( this_object() );
    int i;
    
    for( i = 0; i < sizeof( inv ); i++ )
    {
        if( inv[i]->query("title") == YEL"镇南王府卫士"NOR
                && inv[i]->can_act()
                && !userp( inv[i] ) )
        {
                remove_call_out("greeting");
                    call_out("greeting", 1, inv[i]);
                add_action("do_ling", "ling");
            }
    }
}

void greeting( object ob )
{
        object me=this_player();
        if (random(2))
        {
                message_vision("$N发觉$n走进来，站起身，转过脸看着$n。\n", ob, me);
        }
        else
        {
                message_vision("$N忙得不可开交，根本就没有发觉$n走进来。\n", ob, me);
        }
}

int do_ling( string arg )
{
        object who, ob, me=this_player();
        object *inv = all_inventory( this_object() );
    int i;
    
    for( i = 0; i < sizeof( inv ); i++ )
    {
        if( inv[i]->query("title") == YEL"镇南王府卫士"NOR
                && inv[i]->can_act()
                && !userp( inv[i] ) )
        who = inv[i];
    }
        
        if (me->query("class")!="duanshi") return 0;
        if (!arg || 
                 ( arg!="cloth"
                && arg!="armor"
                && arg!="surcoat"
                && arg!="waist"
                && arg!="boots" ) )
        {
                tell_object(me, "你要领取什么盔甲？请说明。\n");
        }
        else
        {
                if ((int)query("num_armor") > 0)
                {
                        if ( arg=="boots" )
                        {
                                ob=new(__DIR__"npc/obj/boots");
                                ob->move(me);
                                message_vision("$N交给$n一双靴子。\n", who, me);
                                add("num_armor", -1);
                        }                                               
                        if ( arg=="waist" )
                        {
                                ob=new(__DIR__"npc/obj/waist");
                                ob->move(me);
                                message_vision("$N交给$n一条腰带。\n", who, me);
                                add("num_armor", -1);
                        }                                               
                        if ( arg=="armor" )
                        {
                                ob=new(__DIR__"npc/obj/armor");
                                ob->move(me);
                                message_vision("$N交给$n一件绵甲。\n", who, me);
                                add("num_armor", -1);
                        }                                               
                        if ( arg=="surcoat" )
                        {
                                if ( me->query("title")==RED"镇南王府卫士"NOR
                                        || me->query("title")==MAG"镇南王府卫士"NOR
                                        || me->query("title")==YEL"镇南王府卫士"NOR )
                                {
                                        ob=new(__DIR__"npc/obj/surcoat");
                                        ob->move(me);
                                        message_vision("$N交给$n一件披风。\n", who, me);
                                        add("num_armor", -1);
                                }
                                else
                                {
                                        message_vision("$N嘲讽地看着$n：“怎么？不识字？等当上卫士再来领吧！”\n", who, me);
                                }
                        }                                               
                        if ( arg=="cloth" )
                        {
                                if ( me->query("title")==RED"镇南王府卫士"NOR
                                        || me->query("title")==MAG"镇南王府卫士"NOR
                                        || me->query("title")==YEL"镇南王府卫士"NOR )
                                {
                                        if ( me->query("title")==RED"镇南王府卫士"NOR )
                                        {
                                                ob=new(__DIR__"npc/obj/cloth3");
                                                ob->move(me);
                                                message_vision("$N交给$n一件武士服。\n", who, me);
                                                add("num_armor", -1);
                                        }
                                        if ( me->query("title")==MAG"镇南王府卫士"NOR )
                                        {
                                                ob=new(__DIR__"npc/obj/cloth2");
                                                ob->move(me);
                                                message_vision("$N交给$n一件武士服。\n", who, me);
                                                add("num_armor", -1);
                                        }
                                        if ( me->query("title")==YEL"镇南王府卫士"NOR )
                                        {
                                                ob=new(__DIR__"npc/obj/cloth1");
                                                ob->move(me);
                                                message_vision("$N交给$n一件武士服。\n", who, me);
                                                add("num_armor", -1);
                                        }
                                }
                                else
                                {
                                        message_vision("$N嘲讽地看着$n：“怎么？不识字？等当上卫士再来领吧！”\n", who, me);
                                }
                        }
                }
                else
                {
                        message_vision("$N说：“你来的太晚了，盔甲都发完了。”\n", who);
                }
        }
        return 1;
}

                
        
