#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "库房");
        set("long", @LONG
这里是王府的大库房，存放着府上各种各样的日常用品。上至王爷上朝用的
朝服朝珠，下至丫鬟们用的针头线脑，都放在这里。不过现在你只能看见一口口
贴着标签的巨大的铁箱子。这些箱子一直堆到了房顶。
LONG
        );
    set("exits", ([ 
                "north"  : __DIR__"qianyuan2",
        ]));
        set("objects", ([
                        __DIR__"npc/jiading1" : 1,
                ]));
        create_door("north", "厚重的铁门", "south", DOOR_CLOSED);
        setup();
}                       
                
