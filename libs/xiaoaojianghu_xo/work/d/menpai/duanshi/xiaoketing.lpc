#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "小客厅");
        set("long", @LONG
这是王世子的小客厅，平素他在这里接待他的一干朋友。正中是一张红木圆
桌，旁边是四个绣墩；四壁上挂满书画，地上铺着厚厚的地毯，上面绣着“万字
不到头”的花样；在圆桌的后面是一扇绘着大理的名产－－茶花和孔雀的巨大的
屏风，屏风的旁边垂着宝石蓝色的帷幕。一位身材高大的高官正在屋内来回走动，
似乎在等待什么人。
LONG
        );
    set("exits", ([ 
                "west"  : __DIR__"dongyuan",
        ]));
    set("objects", ([ 
                __DIR__"npc/gao_shengtai" : 1,
        ]));
        setup();
        replace_program(ROOM);
}                       


