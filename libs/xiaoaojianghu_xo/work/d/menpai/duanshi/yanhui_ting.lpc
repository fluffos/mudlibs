#include <room.h>
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", RED "宴会厅" NOR);
  set("long", @LONG
这是一间金碧辉煌的大厅，正面悬挂着一幅巨大的图画，画的是大理的名产
－－茶花“十八学士”，姹紫嫣红，光彩夺目。四周是金漆蟠龙红漆大柱，龙口
中含着黄铜的烛台，上插粗大的红烛。上首是飞龙大几，两厢分列仙鹤、孔雀、
猛虎等动物图案的长几。地中央铺着华贵的羊毛地毯。镇南王是个风流潇洒的人
物，最好结交，故而这里经常是红烛高烧，高朋满座。
LONG
  );
  set("exits", ([
    "north": __DIR__ "xiaochufang",
    "west": __DIR__ "ceting2",
  ]));
  setup();
  replace_program(ROOM);
}
