#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "王府大街");
        set("long", @LONG
这里是大理的王府大街，双人合抱的大树在街边十步一株，整整齐齐，青石铺
就的街面打扫的干干净净，街上行人稀少，气氛肃穆而冷清。因为这里是进出镇南
王府必经之路，又是皇宫附近，所以不许闲杂人等无事逗留的。西面有座高大的牌
坊，东面就是镇南王府了。
LONG
        );
    set("exits", ([ 
                "west"  : __DIR__"paifang",
                "east"  : __DIR__"wangfu_pailou",
        ]));
        set("outdoors", "dali");
        setup();
        replace_program(ROOM);
}                       


