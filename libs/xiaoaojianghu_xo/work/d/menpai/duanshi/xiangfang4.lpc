#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "厢房");
        set("long", @LONG
这里是王府下女们的住处，整个是间大房间，靠墙摆着十几张小床，中间是
张大木桌，桌上有两面铜镜，几把椅子四散放着。有几个值夜班的侍女在休息。
床前地上摆放着几双鞋子，墙上挂着几件衣服。
LONG
        );
    set("exits", ([ 
                "east"    : __DIR__"xiangfang5",
                "north"   : __DIR__"xiaoyuan2",
        ]));
        set("sleep_room", "inn");
        set("no_fight", 1);

        setup();
}                       

void init()
{
        add_action("check_sleep", "sleep");
}

int check_sleep()
{
        object me=this_player();
        if (me->query("gender")!="女性" 
        || ((me->query("title")!="镇南王府见习家丁")
        &&  (me->query("title")!="镇南王府家丁")
        &&  (me->query("title")!=BLU"镇南王府家丁"NOR)
        &&  (me->query("title")!=CYN"镇南王府家丁"NOR)) )
        {
                tell_object(me, "这里不是让你睡的地方。\n");
                return 1;
        }
        return 0;
}

