// room:/d/menpai/duanshi/zhengyuan.c  writen by lala Aug-1-97

#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
    set("short", "王府正院");
    set("long", @LONG
这里是王府的正院，也就是镇南王爷的居所。雅致的小院里当中有一方小小
的金鱼池子，旁边开满艳丽的茶花。院子里一遛高大的北房是王爷的卧室。右面
是王爷接待比较亲密的客人的外书房。左面是只有王爷的极其亲密的客人才能进
入的内书房，有时皇上驾临时也是在这里召见臣子的。
LONG
    );
    set("exits", ([ 
            "north"  : __DIR__"woshi1",
            "west"   : __DIR__"neishufang",
            "east"   : __DIR__"waishufang",
            "south"  : __DIR__"yueliang_men1",
        ]));
    set("objects", ([
            __DIR__"npc/gu_ducheng" : 1,
            __DIR__"npc/weishi1"    : 5,
        ]));
    set("outdoors", "dali");
    create_door("north",([
            "name"   : "雕花朱漆门",
            "lock"   : "段_lock001",
            "status" : 3,
            "id"     : ({ "north","door"}),
            "other_side_dir": "south",
            ]),
            "south");
    create_door("west", ([
            "name"   : "内书房门", 
            "lock"   : "段_lock002",
            "status" : 3,
            "id"     : ({ "west","door"}),
            "other_side_dir": "east",
            ]),
            "east");
    setup();
}                       

void init()
{
    add_action("do_say", "say");
}

int do_say( string arg )
{
    object me = this_player();
    int num = me->query("marks/段/can_ask_key");
    if( !arg
      || arg != CHINESE_D->chinese_number( num/10000 ) 
              + CHINESE_D->chinese_number( num/1000-num/10000*10 ) 
              + CHINESE_D->chinese_number( num/100-num/1000*10 ) 
              + CHINESE_D->chinese_number( num/10-num/100*10 ) 
              + CHINESE_D->chinese_number( num-num/10*10 ) )
        return 0;
    call_out("open_door", 1, me);
    return 0;
}                               
 
void open_door( object me )
{
    object ob, *inv;
    int i, num = 0;
    
    if ( !ob = find_object( __DIR__"neishufang" ) ) 
        ob = load_object( __DIR__"neishufang" );

    if( !me || !present( me, this_object() ) || !me->can_act() )
        return;

    inv = all_inventory( ob );
    for( i = 0;i<sizeof(inv);i++)
        if( userp(inv[i]) ) num++;
    if( num>=3 )
    {
        message("vision",
CYN"内书房里面有人说：“书房里面的人已经太多了，过一会再来吧。”\n"NOR, ob );
        return;
    }
    message_vision( 
CYN"内书房里面有人说：“口令正确，可以进来。”房门打开，把$N放了进去，然后又关闭了。\n"NOR
    , me );
    
    tell_room( ob, "你听到开门的声音，一位" + RANK_D->query_normal(me) 
    + "走了进来。\n" );       
    me->move( __DIR__"neishufang" );                
    return;
}    
