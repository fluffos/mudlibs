#include <room.h>
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "西跨院");
  set("long", @LONG
这里是镇南王府的西跨院，院子里绿树如伞，投下了大片的树荫，的确是个
乘凉的好所在。这里是家丁、侍女等下人居住的地方。男女下人分别住在两个小
院里面。东南的一所院子供侍女、丫鬟和女性家丁住；西南的一所供男性家丁住。
卫士们不住在这里，住在卫士营。
LONG
  );
  set("exits", ([
    "southeast": __DIR__ "xiaoyuan2",
    "southwest": __DIR__ "xiaoyuan1",
    "east": __DIR__ "yueliang_men5",
  ]));
  set("objects", ([
    __DIR__ "npc/wuju": 1,
  ]));
  set("outdoors", "dali");
  setup();
}

int valid_leave(object me, string dir) {
  if (me->query("gender") != "男性" && dir == "southwest" && !wizardp(me))
    return notify_fail("那是男人住的地方，你去了恐怕多有不便～\n");
  if (me->query("gender") != "女性" && dir == "southeast" && !wizardp(me))
    return notify_fail("那是女孩子住的地方，你要当大色狼啊？\n");
  return ::valid_leave(me, dir);
}
