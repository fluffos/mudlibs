#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "后厅");
        set("long", @LONG
这里是镇南王爷一般用来接待少数宾客、邀请客人观看歌舞的后厅。这里到
处都垂挂着多彩的幔帐，气氛远没有大厅那么庄重严肃，充满了一种欢快亲切的
气氛。然而现在朝中三公都聚集在这里，似乎是在开会商讨什么，使你又感觉到
一种奇特的气氛。
LONG
        );
    set("exits", ([ 
                        "south" : __DIR__"dating",
        ]));
        set("objects", ([
                        __DIR__"npc/ba_tianshi" : 1,
                        __DIR__"npc/fan_hua"    : 1,
                        __DIR__"npc/hua_hegen"  : 1,
                ]));
        create_door("south", "从屋顶一直垂到地面的绣着二龙戏珠的帘子", "north", DOOR_CLOSED);
        setup();
}                       


