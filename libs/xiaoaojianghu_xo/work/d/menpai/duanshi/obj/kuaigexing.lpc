// kuangexing.c 2
inherit ITEM;
void create() {
  set_name("快歌行", ({ "kuaige xing", "shu", "book" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "这是一本普普通通的乐府诗词，看不出有什么特别的地方。\n");
    set("value", 100);
    set("material", "paper");
    set("skill", ([
      "name": "kuaige-dao",
      "xiuwei_required": 100,
      "literate_required": 20,
      "gin_cost": 10 + random(10),
      "max_jibie": 80,
      "bonus_jilei": 0,
      "bonus_xiuwei": 2,
      "max_xiuwei": 290,
      "bonus_combat_exp": 10,
      "max_combat_exp": 1000,
      "bonus_social_exp": 0,
      "max_social_exp": 0,
    ]));
  }
}
