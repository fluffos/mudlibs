#include <ansi.h>
inherit __DIR__"ShennongNpc.lpc";
inherit F_MASTER;

void create()
{
    set_name("司空玄", ({ "sikong xuan", "sikong", "sikongxuan", "bangzhu", }) );
    set("class_score/神农帮",       400);
    set("title", BLU"神农帮帮主"NOR);
    create_family("神农帮", 1, "帮主");
    set("combat_exp",   120000);
    set("social_exp",   240000);
    set("negative_score", 1200);
    set("max_force",       900);
    set("force",           900);
    set("force_factor",     50);
    set("max_kee",         425);
    set("max_sen",         425);
    set("kee",             425);
    set("sen",             425);
    set("age",              55);
    set("int",              30);
    set("long", @LONG
　　神农帮主司空玄是一个瘦小的老者，颏下一把山羊胡子，神态甚是倨傲。
LONG
    ); 
/*    
    set_wugong("unarmed",           150, 150, 0);
    set_wugong("yingzhua-shou",     120, 120, 0);
    set_wugong("pikong-zhang",      100, 100, 1);
    set_wugong("blade",             150, 150, 0);
    set_wugong("baidu-dao",         100, 100, 0);
    set_wugong("panshe-dao",         80,  80, 1);
    set_wugong("hammer",            150, 150, 0);
    set_wugong("shennong-chu",      100, 100, 0);
    set_wugong("baicao-chu",         80,  80, 1);
    set_wugong("jiben-qinggong",    150, 150, 0);
    set_wugong("lingshe-shenfa",    100, 100, 0);
    set_wugong("jumang-shenfa",      80,  80, 1);
    set_wugong("shaolin-xinfa",      80,  80, 1);
    set_wugong("dugong",             60,  60, 0);

*/
    set_xiuwei_by_type("unarmed",   600);
    set_xiuwei_by_type("blade",     600);
    set_xiuwei_by_type("dodge",     600);
    set_xiuwei_by_type("short",     600);

    setup();

    carry_object( CLOTH_DIR + "cloth2" )->wear();
    add_money( "silver", 2 + random(5) );
}

void attempt_apprentice(object ppl)
{
    object npc = this_object();

    if( ppl->query("positive_score") > ppl->query("negative_score")
     && ppl->query("positive_score") > 1000 )
    {
        command("say “我们神农帮和你们白道上的人物井水不犯河水，请便吧！”");
        ppl->set_temp("CanPass", 1);
        return;
    }
    if( ppl->query("combat_exp") > npc->query("combat_exp") )
    {
        command("say “我们神农帮这座小庙可是供不起您这座大菩萨！”");
        ppl->set_temp("CanPass", 1);
        return;
    }
    if( ppl->query("cor") < 20 
     || ppl->query("cps") < 20 )
    {
        command("say “嗯……我神农帮用毒为主，用毒之人需要胆大心细，这位"
        + RANK_D->query_respect(ppl) + "恐怕不适合～～”");
        ppl->set_temp("CanPass", 1);
        return;
    }
    command("say “哈哈，好好，我就收下你这个徒弟！”");
    command("recruit " + ppl->query("id") );
    ppl->set("title", BLU"神农帮帮众"NOR);    
    ppl->set("class_score/神农帮", 50);
    if( ppl->query("combat_exp") > npc->query("combat_exp") / 2 )
        ppl->add("class_score/神农帮", 100);
}

void init()
{
    add_action("give_quest", "quest");
    ::init();
}
        
