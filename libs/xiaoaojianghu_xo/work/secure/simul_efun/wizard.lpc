string wizhood( mixed ob )
{
	return SECURITY_D->get_status(ob);
}

int wiz_level( mixed ob )
{
	return SECURITY_D->get_wiz_level(ob);
}

int newbiep( mixed ob )
{
    if( !objectp( ob ) || ! userp( ob ) )
        return 0;
    if( ob->query("age") < 15 )
        return 1;
    if( ob->query("age") < 16 && ob->query("combat_exp") < 1000 )
        return 1;
    return 0;
}

