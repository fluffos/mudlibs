string chinese_place_name(string str) {
  return CHINESE_D->chinese_place_name(str);
}

string chinese_number(int i) {
  return CHINESE_D->chinese_number(i);
}

string to_chinese(string str) {
  return CHINESE_D->chinese(str);
}

// AGENTS.md §15h: this used to be a GBK lead-byte range check
// (str[0] > 160 && str[0] < 255), which silently never matches once
// strings are UTF-8-native (str[0] is a full Unicode codepoint, not a
// GBK byte). Fixed to test the CJK Unified Ideographs codepoint range
// instead. Also relaxed the length gate from >=2 to >=1: the original
// >=2 assumed "one Chinese character = 2 bytes", but logind.lpc's
// check_legal_name() calls is_chinese() on single-CHARACTER substrings
// (name[i..<0]-style sliding window) which are perfectly valid 1-char
// strings under UTF-8 -- keeping >=2 here would reject every name's
// last character unconditionally.
int is_chinese(string str) {
  if (strlen(str) >= 1 && str[0] >= 0x4e00 && str[0] <= 0x9fff)
    return 1;
  return 0;
}
