#include <localtime.h>

mixed *localtime(int time) {
  mixed *result = allocate(10);

  //LPC 居然不支持unsigned型，简直要命。
  if (time < 0) time = -time;

  result[LT_YEAR] = time / 86400;
  time %= 86400;
  result[LT_MON] = time / 7200;
  time %= 7200;
  result[LT_MDAY] = time / 720;
  time %= 720;
  result[LT_HOUR] = time / 60;
  time %= 60;
  result[LT_MIN] = time / 15;
  time %= 15;
  result[LT_SEC] = time;

  return result;
}

int query_year() {
  return localtime(time())[LT_YEAR] + 1;
}

int query_month() {
  return localtime(time())[LT_MON] + 1;
}

int query_day() {
  return localtime(time())[LT_MDAY] * 3 + 1;
}

int query_shichen() {
  return localtime(time())[LT_HOUR];
}

int query_quarter() {
  return localtime(time())[LT_MIN] + 1;
}

int query_second() {
  return localtime(time())[LT_SEC];
}

int query_season() {
  int mon = query_month();

  if (mon == 1 || mon == 2)
    return 4;
  else return mon / 3;
}
