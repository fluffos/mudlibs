 * from XO Object Library II
 * compile a object which can control a task. 
 * created by trill 19970920
 * version: @(#) task.c 1.0@(#)
 */

object load_task_object(string zuzhi_name, string task_name, int level)
{
    string file_name = TASK_DIR + zuzhi_name + "/task" + level + ".lpc";
    if (file_size(file_name) < 0) return 0;
    return VIRTUAL_D->compile_task_object(file_name, task_name);
}

