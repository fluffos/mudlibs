//
// Filename : /adm/simul_efun/file.c
//

void cat( string file )
{
	// AGENTS.md §15ab/§15k precedent: write(0) can crash a fresh
	// connection's receive_message() if the object handling it (e.g.
	// clone/user/login.lpc) has no !stringp() guard. Harden here once
	// instead of relying on every caller's target file always existing.
	string str;
	str = read_file(file);
	if ( stringp(str) )
		write(str);
}

void log_file(string file, string text)
{
	write_file(LOG_DIR + file, text);
}

void assure_file(string file)
{
	string path, *dir;
	int i;

    if ( !stringp(file) ) return;
	if ( file_size( file ) != -1 )
		return;

	seteuid(ROOT_UID);
	dir = explode(file, "/");
	dir = dir[0..sizeof(dir)-2];
	path = "/";
	for ( i = 0; i < sizeof( dir ); i++ )
	{
		path += dir[i];
		mkdir(path);
		path += "/";
	}
}

string base_name(object ob)
{
	string file;

	if ( sscanf(file_name(ob), "%s#%*d", file)==2 )
		return file;
	else
		return file_name(ob);
}
