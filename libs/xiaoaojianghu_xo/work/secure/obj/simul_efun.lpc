//
// File:     simul_efun.c
// Purpose:  This object is loaded at boot time.
//           Functions defined in this object can be called by any object
//			 in the game in the same way efuns are called, and are said
//			 to be simulated efuns (or simul_efuns for short).
//
// 96-10-02	 Falcon
//

void create() {
  seteuid(ROOT_UID);
  write("simul_efun 成功加载.\n");
}

#include "/secure/simul_efun/atoi.lpc"
#include "/secure/simul_efun/chinese.lpc"
#include "/secure/simul_efun/gender.lpc"
#include "/secure/simul_efun/file.lpc"
#include "/secure/simul_efun/message.lpc"
#include "/secure/simul_efun/object.lpc"
#include "/secure/simul_efun/path.lpc"
#include "/secure/simul_efun/system.lpc"
#include "/secure/simul_efun/wizard.lpc"
#include "/secure/simul_efun/math.lpc"
#include "/secure/simul_efun/get_object.lpc"
#include "/secure/simul_efun/command.lpc"
#include "/secure/simul_efun/time.lpc"

varargs object snoop(object who, object target) {
  if (!target) return efun::snoop(who);
  if (!wizardp(who)) return 0;
  log_file("snoop", who->name() + " snoops " + target->name() +
    " at " + ctime(time()));
  return efun::snoop(who, target);
}

varargs void shutdown(object who, int code) {
  if (!who || !userp(who) || !wizardp(who))
    return 0;
  log_file("shutdown", who->name() + " shutdown xo at " + ctime(time()));
  foreach (object ob in previous_object(-1)) {
    if (wizardp(ob) && ob != who)
      log_file("shutdown", ob->name() + " seems to have something with the last shutdown.\n");
  }
  return efun::shutdown(code);
}

int exec(object target, object src) {
  string tmp;

  tmp = base_name(previous_object());
  /*    if( tmp != LOGIN_OB ) 
    {
        error("cannot exec");
        return 0;
    }
*/
  return efun::exec(target, src);
}

void destruct(object ob) {
  string err;

  if (ob) {
    if (previous_object())
      err = catch(ob->remove(geteuid(previous_object())));
    else
      err = catch(ob->remove(0));
    if (err) {
      log_file("destruct",
        sprintf("[%s]%O\n%s\n", ctime(time()), ob, err));
      if (userp(ob) && geteuid(previous_object()) != ROOT_UID)
        return;
    }
    efun::destruct(ob);
  }
}
