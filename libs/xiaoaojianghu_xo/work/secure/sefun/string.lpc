// get the string lenght while trip the colors(ansi)
// bugs: if a string contains a escape char but is not a ansi
// will cause a very fun result.
int strnlen(string str) {
  int ansi = 0, len = 0;
  if (!str || !stringp(str))
    return 0;
  foreach (int ch in str) {
    if (ch == 0x1b)  // char ESC
    {
      ansi = 1;
    }
    if (!ansi)
      len++;
    else if (ch == 'm' || ch == 'J' || ch == 'H' || ch == 'f') {
      ansi = 0;
    }
  }
  return len;
}

// format string:
// format a string with ansi and Chinese chars
// wrap is the line to wrap, default is 70
varargs string format_string(string str, int wrap, int ignore_return) {
  string tmp = "";
  int len = 0, ansi = 0, clen = 0;   // clen 是已出现的汉字个数。
  if (!str || !stringp(str))
    return 0;
  if (!wrap)
    wrap = 70;
  if (strlen(str) <= wrap)
    return str;
  foreach (int ch in str) {
    if (ch == '\n' && ignore_return)       // return char
      continue;           // ignore it.
      tmp += sprintf("%c", ch);
    if (ch == 0x1b)       // esc char
    {
      ansi = 1;
    }
    if (!ansi) {
      len++;
      if (ch > 127)
        clen++;
      //        printf("ch %c clen: %d len %d ch=%d\n", ch, clen,len,ch);
    } else if (ch == 'm' || ch == 'H' || ch == 'J') {
      ansi = 0;
    }
    if (len >= wrap)
      if ((!(clen % 2)) || (ch == ' ')) {
        //            printf("str: %s ch %c clen: %d len %d ch=%d\n", tmp, ch, clen,len,ch);
        tmp += "\n";
        len = 0;
      }
  }
  tmp += "\n";            // is this line required? 
  return tmp;
}

// trip_ansi.
// return a string which trip the ansi(s) of the argument.
// but I don't think this function useful
string trip_ansi(string str) {
  string tmp = "";
  int ansi = 0;
  if (!str || !stringp(str))
    return 0;
  foreach (int ch in str) {
    if (ch == 0x1b)
      ansi = 1;
    if (!ansi)
      tmp += sprintf("%c", ch);
    else if (ch == 'm' || ch == 'J' || ch == 'K' || ch == 'H')
      ansi = 0;
  }
  return tmp;
}
