#include <ansi.h>

string PriceString(int value)             //把价值转化成以金银计量的中文价值
//的函数。value：要转换的价值数。
{

  int gold_v, silver_v;                       //gold_v是黄金价值，
  //silver_v是白银价值。
  string msg;                                                 //msg是中文价值信息。
  if (!value)                                           //如果价值为零，则返回空串。
    return "";
  gold_v = value / 10000;                     //计算合多少黄金。
  //（金：钱＝１：１００００）
  value -= gold_v * 10000;                    //计算剩余的零头。
  silver_v = value / 1000;                    //再计算零头合多少白银。
  //（银：钱＝１：１０００）
  value -= silver_v * 1000;                   //计算不能折合金银的零头。
  if (gold_v)                                           //如果能折合黄金，那么写下按黄金的价
    //值。
    msg = chinese_number(gold_v) + "两" + YEL "黄金" NOR;
  if (silver_v)                                     //如果能折合白银，
  {                                                                   //那么写下按白银的价值。
    if (msg)                                          //如果已经写了黄金价值，那么在后面补
      //上白银价值。
      msg = msg + chinese_number(silver_v) + "两" + WHT "白银" NOR;
    else                                                //如果没有写，则直接写白银的价值。
      msg = chinese_number(silver_v) + "两" + WHT "白银" NOR;
  }
  if (value)                                            //写下按铜钱计算的价值。
  {
    if (msg)                                          //如果已经写了金银价值，在后面补上铜
      //钱价值。
      msg = msg + chinese_number(value) + "文" + YEL "铜钱" NOR;
    else                                                //如果没有写，则直接写铜钱的价值。
      msg = chinese_number(value) + "文" + YEL "铜钱" NOR;
  }
  return msg;                                                 //返回字符型的中文价值。
}


void PayPlayer(object ppl, int amount)        //这是给player付钱的函数了。
{
  object ob;                                                  //ob是通用的物品（钱的实体）。
  seteuid(getuid());
  seteuid(geteuid());

  if (amount < 1)                                       //若总量不足一文钱，按一文计算。
    amount = 1;
  if (amount / 1000000)                     //如果总量超过一百两黄金，那么兑
  {                                                                   //换成一千两的银票的形式支付。
    ob = new(MONEY_DIR "thousand-cash");
    ob->set_amount(amount / 1000000);
    ob->move(ppl);
    amount %= 1000000;                          //计算除去银票的零头。
  }
  if (amount / 10000)                           //如果剩余部分超过一两黄金，那么
  {                                                                   //兑换成黄金的形式支付。
    ob = new(MONEY_DIR "gold");
    ob->set_amount(amount / 10000);
    ob->move(ppl);
    amount %= 10000;                            //计算除去银票、黄金的零头。
  }
  if (amount / 1000)                            //如果剩余部分超过一两白银，那么
  {                                                                   //兑换成白银的形式支付。
    ob = new(MONEY_DIR "silver");
    ob->set_amount(amount / 1000);
    ob->move(ppl);
    amount %= 1000;                             //计算除去银票、黄金和白银的零头。
  }
  if (amount)                                           //如果还有剩余的话，以铜钱支付。
  {                                                                   //然后就不会有剩余了。
    ob = new(MONEY_DIR "coin");
    ob->set_amount(amount);
    ob->move(ppl);
  }
}
