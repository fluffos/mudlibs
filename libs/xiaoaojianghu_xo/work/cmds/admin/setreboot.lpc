/*    /cmds/admin/setreboot.c
 *    from the XOA Object Library
 *    set the reboot interval for the mud.
 *    created by nerd 98-08-30
 *    Version: @(#) setreboot.c 1.0@(#)
 *    Last modified: 98-08-30
 */

inherit F_CLEAN_UP;

int main(object me, string arg) {
  int t;
  if (!adminp(me))
    return 0;
  if (!arg || !sscanf(arg, "%d", t))
    return notify_fail("指令格式：setreboot <hours to reboot>\n");
  master()->SetReboot(t);
  write("O.K.\n");
  return 1;
}

int help(object o) {
  write(@HELP
Syntax: setreboot <hours to reboot>
这个指令用来设置系统自动重起的间 隔  。
HELP);
  return 1;
}
