// quit.c

#include <ansi.h>
#include <command.h>

inherit F_DBASE;
inherit F_CLEAN_UP;

private void confirm_quit(string yn,object me,object link_ob);

void create() 
{
	seteuid(getuid());
	set("name", "离线指令");
	set("id", "quit");
}

int main(object me, string arg)
{
	int i;
	object *inv, link_ob;

	if( !wizardp(me) ) {
		inv = all_inventory(me);
		for(i=0; i<sizeof(inv); i++)
			if( !inv[i]->query_autoload() )
				DROP_CMD->do_drop(me, inv[i]);
	}

	link_ob = me->query_temp("link_ob");

	// We might be called on a link_dead player, so check this.
	if (me->query("mud_age") >30*60)
	{
	if( link_ob ) {
		write("test\n");
		// Are we possessing in others body ?
		if( link_ob->is_character() ) {
			write("你的魂魄回到" + link_ob->name(1) + "的身上。\n");
			exec(link_ob, me);
			link_ob->setup();
			return 1;
		}

		link_ob->set("last_on", time());
		link_ob->set("last_from", query_ip_name(me));
		link_ob->save();
		destruct(link_ob);
	}

	write("欢迎下次再来！\n");
	message("system", me->name() + "离开游戏。\n", environment(me), me);

	CHANNEL_D->do_channel(this_object(), "sys",
		me->name() + "离开游戏了。");
	me->save();
	destruct(me);
	return 1;
	}else
	{
	write("您初次进入不超过三十分钟，退出将丢失数据，您确定要退出吗(y/n)？\n");
	write("sigh");
	input_to("confirm_quit",1,me,link_ob);
	write("hi");
	}		
}

private void confirm_quit(string yn,object me,object link_ob)
{
	string old="yes";
	write(yn+"\n");
	
	if ( crypt(yn,old)!=old)
//	if (yn='y'/*|| yn[0]='Y'*/)
	{
		write("1\n");
		link_ob->set("last_on", time());
		link_ob->set("last_from", query_ip_name(me));
		link_ob->save();
		destruct(link_ob);
		write(DATA_DIR + "login/" + me->query("id")[0..0] + "/" + me->query("id") + __SAVE_EXTENSION__+"\n");
		rm(DATA_DIR + "login/" + me->query("id")[0..0] + "/" + me->query("id") + __SAVE_EXTENSION__);
		rm(DATA_DIR + "user/" + me->query("id")[0..0] + "/" + me->query("id") + __SAVE_EXTENSION__);
		destruct(me);
		return;
	}
	else	
	{
		if (yn[0]='n'|| yn[0]='N')
			return ;else
		{
			write("您初次进入不超过三十分钟，退出将丢失数据，您确定要退出吗(y/n)？\n");
			input_to("confirm_quit",me,link_ob);
			return;
		}
	}
}

int help(object me)
{
	write(@HELP
指令格式 : quit

当你(□)想暂时离开时, 可利用此一指令。
HELP
    );
    return 1;
}
