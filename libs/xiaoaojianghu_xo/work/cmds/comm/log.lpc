//by qyz
//modified by trill

#include <ansi.h>

inherit F_CLEAN_UP;

void create()
{
    seteuid(getuid());
}

int main(object me, string arg)
{
    string file, title, end;
    object ob;
    if( !arg ) ob = me;
    else if( !wizardp(me) )
        return notify_fail("你只能查看自己的记录。\n");
    else ob = find_player( arg );

    if( !wizardp(me) &&
        me->query("last_read_log") == me->query("age") )
        return notify_fail("这一年的记录你已经看了。\n");

    if( !ob ) 
    {   ob=FINGER_D->acquire_login_ob(arg);
        if(!ob) return notify_fail("没有这个玩家。\n"); 
        file = LOG_D->query_log_file( arg );
    }
    else file = LOG_D->query_log_file( ob->query("id") );

    if( !file && !read_file( file ) )
        return notify_fail(YEL"你发现事情好象有点不对。\n"NOR);

    title = @TEXT
◎ 笑傲江湖记录系统 ◎
=============================================================
TEXT
;
    end = @TEXT
=============================================================

                                            ＸＯ  ＴＥＡＭ

TEXT
;
    file = title + read_file( file ) + end;
//    tell_object( me, title );
    me->start_more( file );
//    tell_object( me, end );

    me->set("last_read_log", (int)me->query("age") );
        return 1;
}

int help(object me)
{
write(@HELP
指令格式 : log

你可以通过log命令来查看以前的记录，但每年只能看一次。

相关指令：record
HELP
     );
     return 1;
}



