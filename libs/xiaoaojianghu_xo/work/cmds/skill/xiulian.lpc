// xiulian.c
// by qyz

inherit F_CLEAN_UP;

#include <skill.h>
#include <ansi.h>

int exercising(object me);
int halt_exercise(object me);

int main(object me, string arg) {
  string my_force, force;
  object where;
  int force_jibie;

  seteuid(getuid());

  where = environment(me);
  if (where->query("wiz"))
    return notify_fail(HIR "这是属于神的房间，不能用来练功。\n" NOR);

  if (!arg) {
    if (!force = me->query("using_force")) {
      this_object()->help();
      return 1;
    }
  } else
    force = arg;

  if (!me->can_act())
    return notify_fail("你现在正忙着呢。\n");

  if (me->is_fighting())
    return notify_fail("战斗中不能练内功，你不会想走火入魔吧。\n");

  if (me->is_duilianing())
    return notify_fail("对练中不能练内功，会走火入魔的。\n");

  force_jibie = me->query_jibie(force);
  if (!force_jibie)
    return notify_fail("你没学过这门内功，怎能无师自练呢？\n");

  if (SKILL_D(force)->query_xiuwei_type() != "force")
    return notify_fail("你要练的是内功吗？\n");

  if (!SKILL_D(force)->valid_xiulian(me))
    return notify_fail("这门技能不能用来修炼内力。\n");

  if (me->query_char_ratio("kee") < 90 ||
    me->query_char_ratio("sen") < 90 ||
    me->query_char_ratio("gin") < 90) {
    return notify_fail("你现在身体状况不佳，无法产生内息运行全身经脉。\n");
  }

  my_force = me->query("using_force");

  if (!my_force)
    write(HIY "你开始修炼" + to_chinese(force) + "。\n" NOR);
  else if (my_force != force) {
    write(RED "你决定改修" + to_chinese(force) + "，所以你的内力"
      "必须从新积累。\n" NOR);
    me->set("force", 0);
  }

  me->set("using_force", force);
  me->set_temp("exercise_cost", 200);
  message_vision("$N盘膝坐下，紧闭双目，开始修炼内力。\n", me);
  write(HIW "你心中存想，缓缓催动体内气息运行周天。\n"
    "只觉体内一股热气直透上来,你进入了一种玄妙的境界......\n" NOR);
  me->start_busy((: exercising :), (: halt_exercise :));
  return 1;
}

int exercising(object me) {
  string using_force, force_type;
  int force_gain, jilei_gain;
  int exercise_cost;
  int force, max_force, lingwu, my_con, level, jibie, max_zouhuo;

  exercise_cost = me->query_temp("exercise_cost");
  using_force = me->query("using_force");

  // qyz 用lingwu..我想这个内力这个东西还是严格按照
  // 师傅教的练比较好，自己领悟出来的东西不知道合不合理
  // 应该按照口诀练，就是jibie来控制一切。
  // 这样也可以让机器人容易走火入魔 :-)
  // trill 

  lingwu = me->query_lingwu(using_force);
  jibie = me->query_jibie(using_force);
  level = (int)SKILL_D(using_force)->query_level();
  my_con = me->query("con");
  force = me->query("force");
  max_force = me->query("max_force");

  force_gain = random(2);
  if (!random(3)) force_gain = (jibie * level + my_con) / 10;

  if (random(10) > 6)
    tell_object(me,
      HIW "你的内息在体内沿着经脉要穴不断运转，感觉你的内力"
      "正在不断的凝集......\n" NOR);
  if (!random(20)) {
    jilei_gain = random((int)me->query("int")) / 1333 + 1;
    if (!random(40)) jilei_gain += sqrt(max_force);
    me->improve_jilei(using_force, jilei_gain);
  }
  if (exercise_cost >= 10) {
    me->add("force", force_gain);
    me->add_temp("exercise_cost", -10);
    return 1;
  }

  message_vision("$N运功完毕，深深吸了口气，站了起来。\n", me);
  if (me->query("can_recover_max_force")) {
    me->add("max_force", me->query("recover_force"));
    me->set("can_recover_max_force", 0);
    write(HIC "你感觉到散入经脉的真气重归丹田. \n" NOR);
  }
  if (force < max_force * 2)
    return 0;
  else {
    force_type = SKILL_D(using_force)->query_type();
    me->add("max_force", 1);
    if (force_type == "yin")
      me->add("yin", 1);
    else if (force_type == "yang")
      me->add("yang", 1);
    me->set("force", max_force + 1);
    write(HIC "你感觉内力充盈，显然内功又有进境。\n" NOR);
    if (me->query("can_recover_max_force")) {
      me->add("max_force", me->query("recover_force"));
      me->set("can_recover_max_force", 1);
      write(HIC "你感觉到散入经脉的真气重归丹田. \n" NOR);
    }
    call_out("show_balance", 5, me);
    max_zouhuo = (jibie * level / 2 + my_con / 3) * 10;
    if (max_force > max_zouhuo) {
      switch (random(4)) {
        case 0:
          write(HIY "你觉得内息有些混乱。\n" NOR);
          break;
        case 1:
          write(HIY "你感觉到内力有失控的迹象。\n" NOR);
          break;
        case 2:
          write(HIY "你觉得有些胸闷头痛，心里很烦躁。\n" NOR);
          break;
        default:
          break;
      }
      if (!random(40 + max_zouhuo - max_force) && (max_force > max_zouhuo)) {
        remove_call_out("lost_control");
        call_out("lost_control", 1, me);
      }
    }
    return 0;
  }
}

int halt_exercise(object me) {
  int force, max_force, jibie;
  string using_force;

  using_force = me->query("using_force");
  jibie = me->query_jibie(using_force);
  force = me->query("force");
  max_force = me->query("max_force");
  if (force > max_force * 2)
    me->set("force", (int)me->query("max_force") * 2);
  me->delete_temp("mask/lian_force");
  write("你强行将体内运行的真气压回丹田，站起身来。\n");
  if (!random(100 + jibie * 10)) {
    remove_call_out("lost_control");
    call_out("lost_control", 3, me);
  }
  return 1;
}

// trill:  真是不幸 走火入魔了... :-(((
// apply_condition( "zouhuo_rumo" );
// 照这样干，修炼两门内功的人就惨了。。。。。。lin

int lost_control(object me) {
  int time, max_force, recover_force;
  string using_force;

  max_force = me->query("max_force");
  using_force = me->query("using_force");
  recover_force = me->query_jibie(using_force) * SKILL_D(using_force)->query_level() / 20 + 1;
  time = max_force / recover_force / 4;
  if (me->query_kar() % 4 == 0) time += random(4);
  write(RED "你觉得体内的真气突然失去控制，蹿入全身各处经脉，\n"
    "你浑身如针刺一般，痛苦之至。\n" NOR);
  me->unconcious();
  me->set("recover_force", recover_force);
  me->apply_condition("zouhuo_rumo", time);
  me->set("max_force", max_force / 2);
  me->set("yin", me->query("yin") / 2);
  me->set("yang", me->query("yang") / 2);
  me->add("max_age", -1);
  LOG_D->do_log(me, "你因强行修炼内力，控制不住自己的内息，走火入魔了。");
  return 1;
}

// qyz:实现内功里阴与阳的作用。
void show_balance(object me) {
  int yin, yang, chazhi;

  yin = me->query("yin");
  yang = me->query("yang");
  if ((yin - yang) >= 0)
    chazhi = (yin - yang);
  else
    chazhi = (yang - yin);
  if (me->query("force_ok")) return;
  if (yin > 1000 && yang > 1000 && chazhi < 300) {
    tell_object(me, HIW "你突然觉得体内的真气流动不同寻常，体内阴阳二气\n"
      "正在慢慢地融合......\n" NOR);
    if (random(10) > 3) {
      tell_object(me, HIW "终于，你体内的真气完全汇交融合为一体，只觉得全身\n"
        "内力充盈，你的内功已经大成了。\n" NOR);
      me->add("max_force", 300);
      me->set("force", me->query("max_force"));
      me->set("force_ok", 1);
    }
  } else if (yin < 1000 && yang < 1000 && yin > 200 && yang > 200 &&
    chazhi < 100) {
    tell_object(me, HIC "在内功精进的同时，你隐隐觉得体内的阴阳二气\n"
      "似乎在互相冲撞，真气的流动有些不大顺畅。\n" NOR);
  }
  return;
}

int help(object me) {
  write(@HELP
指令格式 : xiulian [ 内功名称 ] 

运气练功，控制体内的气在各经脉间流动，藉以训练人体肌肉骨骼的耐
力、爆发力，并且用内力的形式将能量储备下来。
修练时你的生命、精神、体能的值都必须大于 90%。

HELP
  );
  return 1;
}
