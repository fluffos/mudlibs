// localtime.c 
#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
    printf("现在是%s，时值%s季。\n",
        NATURE_D->game_time(),
        NATURE_D->game_season()
        ); 
	return 1;
}

int help(object me)
{
     write(@HELP
指令格式: time

这个指令告诉你泥巴世界中现在的时间。

HELP
    );
    return 1;
}
