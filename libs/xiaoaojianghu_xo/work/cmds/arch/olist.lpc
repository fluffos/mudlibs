// Filename : /cmds/wiz/olist.c 

//inherit F_CLEAN_UP;

#define OPT_ALL				0
#define OPT_OBJECT_NAME		1	
#define OPT_FILENAME		2
#define OPT_EMPTY			3

int main(string str, string arg)
{
	string *temp;
	object *ob;
    int i, option;

	option = OPT_ALL;
	if ( arg )
	{
		temp = explode( arg, " " );
		i = sizeof( temp );
	}
    ob = objects();
    i = sizeof( ob );
    while ( i-- ) 
	{
     	write( sprintf( "%15s : %30s\n", ob[ i ]->query( "id" ),
    		file_name( ob[ i ] ) ) );
    }
    return 1;
}

int help(object me)
{
write(@HELP
指令格式 : olist

将所有对象的信息显示出来。
HELP
    );
    return 1;
}
