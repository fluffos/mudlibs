// search.c                                 
// qyz

#include <ansi.h>

inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

int main(object me, string arg)
{   
    string *key,*gain_item;
    mapping searchs;
    mixed item;
    object env; 
    int i,k;
 
	if( !arg ) 
    return notify_fail("你要搜什麽东西？\n");
  
    if( !me->can_act() ) return 0;

	env = environment(me);

    if( !searchs = env->query("search_things") )
    {
        if ( strsrch( env->query( "long" ), arg ) >= 0 )
        return notify_fail("这里的"+arg+"没有东西可搜。\n");
        else
        return notify_fail("这里没有"+arg+"\n");
    }
    if( !item = searchs[arg] )    
    {
        if ( strsrch( env->query( "long" ), arg ) >= 0 )
        return notify_fail("这里的"+arg+"没有东西可搜。\n");
        else
        return notify_fail("这里没有"+arg+"\n");                          
    }

    message_vision("$N开始仔细搜寻这里的"+arg+"......\n",me); 
    if( stringp( item ) )
    {
         me->disable_command("verb","你现在正在搜索中。\n");
         call_out("find_it",3,me,arg,item);
         return 1;
    }                                  
    key = keys(item);
    gain_item = key; 
    me->disable_command("verb","你现在正在搜索中。\n");   
    
    k = 0;
    for( i = 0; i < sizeof( key ); i++ )
    {                         
        if( item[key[i]] <= me->query("social_exp") )  
        {
             gain_item[k] = key[i];
             k += 1;
        }
    }
    if( k > 0 )    
        call_out("find_it", 3, me, arg, gain_item[random(k)]);  
    else
        call_out("fail_find",3,me);
    return 1;
}

private void find_it( object me, string arg, string item )
{
    mapping founds;
    string msg;                   
    object env;
    env = environment(me);
    me->receive_damage("gin" , 10);	
    founds = env->query_temp_marks("been_got");
    if ( !mapp(founds) ) founds = ([]);          
    if ( !undefinedp(founds[item] )
         || item->cannot_search(me)  )
	msg = "结果什么也没有发现。\n";
    else
    {   
        new(item)->move(me);
        me->add("social_exp", 1+random(3));
        msg = "$N找到了一"+item->query("unit")+item->name()+"！\n";
        founds[item] = 1;
        env->set_temp_marks("been_got", founds );
    }
    message_vision(msg,me); 
    me->enable_path();
}                   
void fail_find(object me)
{
    message_vision("结果什么也没有发现。\n",me);
    me->enable_path();   
}

int help(object me)
{
	write(@HELP
指令格式 : search <物品名称> 
 
这个指令可以让你搜索房间里的某样物品。
 
HELP
    );
    return 1;
}
 
