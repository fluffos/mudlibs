// shake.c 不答应啦。唉
// by trill 06/15/97

inherit F_CLEAN_UP;

int refuse_marriage( object, string );
int eventShake( object );

int main( object me, string arg )
{
    mapping prop;
    string *id;
    int i;

    if ( me->query( "gender" ) != "女性" ) return eventShake(me);
    prop = me->query_temp( "be_proposed" );
 
    if ( !prop )
        return eventShake(me);
    if ( !arg )
    {
        write( "你要拒绝谁的求婚呢？\n" );
        return 1;
    }

    id = keys( prop );
    for ( i = 0; i < sizeof( id ); i ++ )
    {
        if ( id[ i ] == arg )
        {
            refuse_marriage( me, id[ i ] );
            return 1;
        }
    }
    write( "你的求婚者中没有这个人。\n" );

    return 1;
}

int refuse_marriage( object me, string id )
{
    object you;
    string msg;
    if ( !find_player( id ) )
    {
        write( "真是可惜，他已经走了，暂时离开这个世界了。\n" );
        return 1;
    }
    you = find_player( id );
    if ( environment( you ) != environment( me ) )
    {
        write( "就算你不同意，也要在他的身边告诉他，他才能知道啊。\n" );
        return 1;
    }
    if ( msg = me->query( "env/shake_msg" ) )
        message_vision( msg, me, you );
    else
        message_vision( "$N无奈的冲着$n摇摇头。\n", me, you );
    tell_object( you, "唉，" + me->name() + "不想嫁给你。\n" );
    me->delete_temp( "be_proposed/" + id );

    return 1;
}

int eventShake(object me)
{
        if (!environment( me ))
            return 0;
        message_vision(EMOTE_D->query_emote("nod")["others"],me);
        foreach ( object ob in all_inventory( environment(me) ) )
            ob->eventSeeShake(me);
        environment(me)->eventSeeShake(me);
        return 1;
}

int help( object me )
{
    write( @HELP
指令格式: shake <某个求婚者ID>

拒绝你的某个求婚者的求婚。
这个指令女性专用。

相关的帮助：help marriage

HELP
    );
    return 1;
}

