// buy.c
// rewrited by qyz

inherit F_CLEAN_UP;

int main(object me, string arg) {
  string item, targ;
  object ob, owner;
  int price, afford;

  if (!arg) return notify_fail("如果你不会用buy命令，可以 help buy\n");
  if (sscanf(arg, "%s from %s", item, targ) == 2
    || sscanf(arg, "%s %s", targ, item) == 2);
  else return notify_fail("如果你不会用buy命令，可以 help buy\n");

  if (!objectp(owner = present(targ, environment(me))))
    return notify_fail("你要跟谁买东西？\n");

  if (userp(owner)) {
    message_vision("$N想向$n购买「" + item + "」。\n", me, owner);
    return 1;
  }

  price = owner->buy_object(me, item);
  if (price < 1) return notify_fail("对方好像不愿意跟你交易。\n");
  if (afford = me->can_afford(price)) {
    if (afford == 2)
      return notify_fail("你没有足够的零钱，而对方也找不开银票...。\n");
    if (!owner->query("sell_times")) {
      me->pay_money(price, 0);
      me->start_busy(1);
      owner->compelete_trade(me, item);
      me->save();
      return 1;
    }
    if ((int)owner->query("sell_times") <= 1) {
      if (!owner->query_temp("calling")) {
        remove_call_out("sell_again");
        call_out("sell_again", 60, owner);
        owner->set_temp("calling", 1);
      }
      return notify_fail("对不起，今天的货物已经卖完了。\n");
    }
    me->start_busy(1);
    me->pay_money(price, 0);
    owner->compelete_trade(me, item);
    me->save();
    owner->add("sell_times", -1);
    return 1;
  } else
    return notify_fail("你的钱不够。\n");
}

void sell_again(object owner) {
  owner->set("sell_times", 20);
}

int help(object me) {
  write(@HELP
指令格式: buy  <某人> <某物> 或者 buy <某物> from <某人>
比如 购买小二(seller)身上的包子(baozi)
你可以输入物品的英文代号：
buy seller baozi 或 buy baozi from seller
或者输入物品的中文名：
buy seller 包子 或 buy 包子 from seller
以上指令都是等效。
这一指令让你可以从某些人身上买到物品。你可以输入这个物品的英文代号
也可以输入这个物品的中文名。为了确保能购买到物品, 你最好输入这个物
品的中文名.
BTW:小二会自动找钱，不需要去钱庄或当铺换钱了。
HELP
  );
  return 1;
}
