//显示任意长度的文件

inherit F_CLEAN_UP;

int main(object me, string arg)
{
    int i;
    string *text, file;
    if ( !arg ) return notify_fail("你要看哪个档案？\n");
	file = resolve_path(me->query("cwd"), arg);

    if ( file_size( file ) < 0 ) 
	return notify_fail("没有这个文件！\n");
    text = explode( read_file( file ),"\n");
    for ( i=0; i<sizeof( text ); i++)
        write( text[ i ] + "\n" );
    return 1;
}