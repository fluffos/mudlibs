//writed by Xujs for test 6.12.98
//类似与DOS的 dir

inherit F_CLEAN_UP;

int number=1;  //全局变量，记录文件总数
int totalsize=1;

void rehash(string dir)
{
    int i ,j,tsize=0,num=0;
    string *file;
    if ( file_size( dir ) == -2 )
        if ( dir[ sizeof( dir ) - 1 ] != '/' )
	    dir += "/";
    file = get_dir(dir);
    write("目录：" + dir + "\n");
    j = sizeof(file);
    for ( i=0; i < j; i++ )
    {
    	file[i]=dir+file[i];
	    if ( file_size( file[i] ) == -2 ) 
	        rehash( file[i] );
        else
        {
    	    totalsize += file_size( file[i] );
    	    tsize += file_size( file[i] );
            number++;
            num++;
    	    printf("Name:%50s  Size:%d字节\n", file[i], file_size( file[i] ) );
        }
    }
    printf("在目录%s里共有%d个文件   %d字节\n", dir, num, tsize);
}



int main(object me, string dir)
{
    int i;
    number=1;
    totalsize=0;
//    if ( me->query("id") != "xujs" ) 
//    	return 0;

    if ( !dir ) 
    {
        dir=me->query("cwd");
        rehash(dir);
        printf("合计: %d个文件, %d字节\n", number, totalsize);
        return 1;
    }

    if ( file_size( dir ) == -1 ) 
    	return notify_fail("The file or directory does not exist!\n");
    rehash(dir);
    printf("合计: %d个文件, %d字节\n", number, totalsize);
    return 1; 
}