inherit F_CLEAN_UP;

int /*do_localcmds*/main(object me)
{
    mixed *cmds;
    int i;
//    object me;
//    me = this_player();

    cmds = F_COMMAND->commands();
    write("你身上及四周的物品与所在的环境提供以下指令：\n");
    printf("%d\n",sizeof(cmds) );
    for(i = 0; i<sizeof(cmds); i++)
    {
//        if( cmds[i][2]==me ) continue;
        printf("%-15s  %2d %O\n", cmds[i][0], cmds[i][1], cmds[i][2]);
    }
    return 1;
}