#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  string arg1, arg2;
  if (!arg) return notify_fail("请先输入一个字符串\n");
  if (sscanf(arg, "%s %s", arg1, arg2) != 2) {
    arg1 = arg;
    arg2 = 0;
  }
  printf(
    "the password you input is: %s\nAfter coding the password is: %s\n",
    arg,
    crypt(arg1, arg2)
  );
  return 1;
}
