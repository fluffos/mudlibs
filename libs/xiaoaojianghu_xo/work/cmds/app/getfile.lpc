//getfile.c  
//将log下来的源码还原 grin

inherit F_CLEAN_UP;

string outfile="";
int infile=1;

int dowith( string );

int main(object me, string arg)
{
    int i;
    string *text, file;
    infile=0;
    seteuid(ROOT_UID);
    if ( !arg ) return notify_fail("你要解哪个档案？\n");
	file = resolve_path(me->query("cwd"), arg);

    if ( file_size( file ) < 0 ) 
	return notify_fail("没有这个文件！\n");
    text = explode( read_file( file ),"\n");
    for ( i=0; i<sizeof( text ); i++)
        if ( !dowith(text[i]) ) return 1;
    return 1;
}

int dowith(string text)
{
    int i=0,j=0;
    if ( strsrch( text, "Name:" )==9
        && strsrch( text, "NO:" )==0
                         )  //判断此行是不是包含有文件名
    {
        i = strsrch( text, "Name:" ) + 4;
        outfile="";
        while ( text[++i]==' ' );
        while ( text[i] != ' ') 
        {
            outfile += " ";
            outfile[ j++ ]= text[i++];
        }
        infile=0;
        assure_file( outfile );
        write_file( outfile,"", 1 );
        write (outfile+"\n");
    }
    if ( strsrch( text,"this file xujs1234561")==6 ) infile=1;
    else
    if ( strsrch( text,"this xujs1234561")==4 ) infile=0;
    else
    if (infile) 
    {
        assure_file( outfile );
        write_file( outfile, text+"\n", 0 );
    }
    return 1;
}