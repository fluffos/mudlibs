//Qyz
#include <ansi.h>

inherit SKILL;

mapping *quest = ({
        ([      "quest":                "杀青木子",               
                "time":                 700,
                "bonus":        10,
                "quest_msg":            
"木灵子沉吟了一下：“兰州城中来了个叫青木子的星宿派妖孽，本派\n"
"素来与星宿派势不两立，你即刻下山去将其除掉！”\n",
                "reward_msg":        
"木灵子拍拍你的肩膀，用欣赏的眼光看着你：“看来你也是个可造\n"
"之材呀，日后定会好好栽培于你。”\n",
        ]),
        ([      "quest":                "杀士兵",
                "time":                 600,
                "bonus":                7,
                "positive_score":       40,
                "quest_msg":
"木灵子看了你一眼，郑重地对你说：“兰州城中许多士兵不思为国报\n"
"效，疏于训练，平常欺压百姓，抢劫之事时而有之，现在我命你下山\n"
"去杀一名士兵，以示杀一儆百之意。”\n",
                "reward_msg":
"木灵子大喜，对你说：“你能办成这件事，实乃兰州黎民之福也，日\n"
"后我必将倾囊相授，令你成为武林奇葩！”\n",
        ]),
        ([      "quest":                "杀将虞候",
                "time":                 1000,
                "bonus":                10,
                "quest_msg":
"木灵子愤愤不平地对你说：“兰州城中将虞候欺上瞒下，无恶不作，\n"
"你去把他杀了！”\n",
                "reward_msg":
"木灵子看看你，轻轻颔首：“嗯，很好。”\n",
        ]),
        ([      "quest":                "杀崔兴福",
                "time":                 500,
                "bonus":                7,
                "quest_msg":
"木灵子愤愤不平地对你说：“兰州城中布庄老板崔兴福对雇工极是苛\n"
"刻，还经常克扣工钱，实在是可恨，你即刻下山将其除掉！”\n",
                "reward_msg":
"木灵子看看你，轻轻颔首：“嗯，很好。”\n",
        ]),
        ([      "quest":                "杀阔少",
                "time":                 700,
                "bonus":                4,
                "quest_msg":
"木灵子想了一会说：“兰州城中那个阔少极是可恶，仗着官府的势力\n"
"，成天欺压善良，肆无忌惮，你这就去除掉他。”\n",
                "reward_msg":
"木灵子拍拍你的肩膀：“嗯，不错。”\n",
        ]),
        ([      "quest":                "杀何三",
                "time":                 500,
                "bonus":                4,
                "quest_msg":
"木灵子沉吟了一会说：“我上次看见兰州城中有个叫何三的泼皮，极\n"
"是可恨，专门欺负那些作小本生意的老百姓，你去把他杀了，也让老\n"
"百姓不用再受骚扰。”\n",
                "reward_msg":
"木灵子看看你，轻轻颔首：“嗯，很好。”\n",
        ]),
        ([      "quest":                "取七伤拳谱",
                "time":                 400,
                "bonus":                5,
                "quest_msg":
"木灵子迟疑了一下，对你说：“我听说本派的绝学七伤拳竟有拳谱流\n"
"传在外，你这就下山去寻访，取回来我看看是否真是本门的绝技七伤\n"
"拳。”\n",
                "reward_msg":
"木灵子仔细地翻了翻七伤拳谱，惊讶地说：“果然是本派的不传之秘\n"
"七伤拳，怎么会为外人拿去，还作成了拳谱？一定得派个人去查。”\n",
        ]),
        ([      "quest":                "取「古文志」",
                "time":                 400,
                "bonus":                3,
                "quest_msg":
"木灵子对你说：“你去找一本「古文志」来给我。”\n",
                "reward_msg":
"木灵子点了点头：“嗯，你下去吧。”\n",
        ]),             
        ([      "quest":                "取史记",
                "time":                 400,
                "bonus":                3,
                "quest_msg":
"木灵子对你说：“你去山下找一本史记来给我。”\n",
                "reward_msg":
"木灵子点了点头：“嗯，你下去吧。”\n",
        ]),             
        ([      "quest":                "取野鸡",
                "time":                 500,
                "bonus":                3,
                "quest_msg":
"木灵子对你点点头说：“你速下山去买一只野鸡来，我有急用。”\n"
"快去快回呀！”\n",
                "reward_msg":
"木灵子看了看你拿来的野鸡，“嗯，还算及时，没耽误事。”\n",
        ]),             
        ([      "quest":                "取" YEL "狐狸皮" NOR,
                "time":                 500,
                "bonus":                3,
                "quest_msg":
"木灵子说：“你下山去买一张狐狸皮来，我要做件背心。”\n",
                "reward_msg":
"木灵子拿起狐狸皮看了看，“嗯，这毛皮可真不错，色泽很好，看来\n"
"你对毛皮的好坏是很熟悉的嘛！”\n",
        ]),             
        ([      "quest":                "杀和尚",
                "time":                 500,
                "bonus":                4,
                "positive_score":       100,
                "quest_msg":
"木灵子气哼哼地说：“山下佛光寺那几个和尚，不守佛门戒律，整天\n"
"游手好闲，还经常在寺里藏着晕腥之物，不加惩戒，实在难消我心头\n"
"之气，你这就去杀个和尚，以示警戒！”\n",
                "reward_msg":
"木灵子猛一拍膝盖：“太好了！  这几个和尚就应该杀他几个才好！”\n",
        ]),            
        ([      "quest":                "取" HIG "烧酒" NOR,
                "time":                 400,
                "bonus":                2,
                "quest_msg":
"木灵子想了一会，对你说：“我听说山下佛光寺的和尚经常偷藏烧酒\n"
"在寺院里喝，败坏佛门清誉，你到山下查看一番是否属实。”\n",
                "reward_msg":
"木灵子看着你递给他的烧酒，恨恨地说：“没想到这几个秃驴果然如\n"
"此大胆。佛门净地，岂容他如此玷污，我必要对其加以惩戒！”\n",
        ]),
        ([      "quest":                "取" YEL "狗肉" NOR,
                "time":                 400,
                "bonus":                2,
                "quest_msg":
"木灵子想了一会，对你说：“我听说山下佛光寺的和尚经常偷藏狗肉\n"
"在寺院里吃，败坏佛门清誉，你到山下查看一番是否属实。”\n",
                "reward_msg":
"木灵子看着你递给他的狗肉，恨恨地说：“没想到这几个秃驴果然如\n"
"此大胆。佛门净地，岂容他如此玷污，我必要对其加以惩戒！”\n",
        ]),
        ([      "quest":                "取风雷刀",
                "time":                 500,
                "bonus":                10,
                "quest_msg":
"木灵子想了一下，“哦，我曾听人说，城里汤镖头有把风雷刀还不错\n"
"，你这就下山去取回来我赏鉴一番。”\n",
                "reward_msg":
"木灵子拿起风雷刀仔细看了看：“嗯，这风雷刀确实言过其实，并”\n"
"不能称作什么好刀。”\n",
        ]),
        ([      "quest":                "取铁砂掌谱",
                "time":                 500,
                "bonus":                7,
                "quest_msg":
"木灵子想了一下，“哦，我曾听人说，城里洪镖头有一本拳谱，上面\n"
"所说的铁砂掌与本门的七伤拳颇有互相映证之妙，你去取回来看看。”\n",
                "reward_msg":
"木灵子拿起铁砂掌谱仔细看了看：“嗯，这铁砂掌果然利害，与本门\n"
"的七伤拳确有异曲同工之妙。你此行可谓功劳不小呀！”\n",
        ]),
        ([      "quest":                "取勾魂刀",
                "time":                 1000,
                "bonus":                5,
                "quest_msg":
"木灵子瞄了你一眼说：“有件事情看来只有派你去了，听说江湖上出\n"
"现了一把勾魂刀，你这就下山去寻访，取回来吧。”\n",
                "reward_msg":
"木灵子凝视着你递给他的勾魂刀，叹道：“果然是一把好刀呀！”\n",
        ]),             
/*        ([      "quest":                "取七星碧玉刀",
                "time":                 1500,
                "bonus":                10,
                "quest_msg":
"木灵子瞄了你一眼说：“有件事情看来只有派你去了，听说江湖上出\n"
"现了一把七星碧玉刀，你这就下山去寻访，取回来吧。”\n",
                "reward_msg":
"木灵子凝视着你递给他的七星碧玉刀，叹道：“果然是一把好刀呀！”\n",
        ]),   */          
        ([      "quest":                "取「十八学士」",
                "time":                 1200,
                "bonus":                10,
                "quest_msg":
"木灵子笑了一声，说：“花园里缺几盆茶花，我听说大理有一种名茶\n"
"叫做「十八学士」，你就远行大理一趟，买一盆「十八学士」来吧。”\n",
                "reward_msg":
"木灵子点了点头说：“这「十八学士」果然是上品呀！”\n",
        ]),             
        ([      "quest":                "取「羽衣霓裳」",
                "time":                 1200,
                "bonus":                10,
                "quest_msg":
"木灵子笑了一声，说：“花园里缺几盆茶花，我听说大理有一种名茶\n"
"叫做「羽衣霓裳」，你就远行大理一趟，买一盆「羽衣霓裳」来吧。”\n",
                "reward_msg":
"木灵子点了点头说：“这「羽衣霓裳」果然是上品呀！”\n",
        ]),             
        ([      "quest":                "取「步步生莲」",
                "time":                 1200,
                "bonus":                10,
                "quest_msg":
"木灵子笑了一声，说：“花园里缺几盆茶花，我听说大理有一种名茶\n"
"叫做「步步生莲」，你就远行大理一趟，买一盆「步步生莲」来吧。”\n",
                "reward_msg":
"木灵子点了点头说：“这「步步生莲」果然是上品呀！”\n",
        ]),             
        ([      "quest":                "取「恨天高」",
                "time":                 1200,
                "bonus":                10,
                "quest_msg":
"木灵子笑了一声，说：“花园里缺几盆茶花，我听说大理有一种名茶\n"
"叫做「恨天高」，你就远行大理一趟，买一盆「恨天高」来吧。”\n",
                "reward_msg":
"木灵子点了点头说：“这「恨天高」果然是上品呀！”\n",
        ]),             
});


mapping query_quest()
{
        return quest[random(sizeof(quest))];
}
