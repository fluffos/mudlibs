//Qyz
#include <ansi.h>

inherit SKILL;

mapping *quest = ({
        ([      "quest":                "取烧柴",
                "time":                 600,
                "bonus":                2,
                "quest_msg":
"辛双清想了想，说：“听厨房里说，这两天烧柴颇缺，你就上剑湖宫\n"
"后山密林中去砍些烧柴回来吧。”\n",
                "reward_msg":
"辛双清点了点头：“待会我会命人把这些烧柴送到厨房，你累了吧？\n"
"下去歇歇吧。”\n",
                "fail_msg":
"辛双清看上去很不高兴，皱了皱眉头对你说：“下去歇着吧。”，嘴\n"
"里嘟囔着：“真是没用。。。。”\n",
                "delay_msg":
"辛双清很不高兴地看了你两眼，一言不发，又把身子转了过去。。。\n",
        ]),  
        ([      "quest":                "取三字经",
                "time":                 300,
                "bonus":                2,
                "quest_msg":
"辛双清点了点头，对你说：“到书房去替我拿一本三字经来，我要教\n"
"你的师弟们识几个字。”\n",
                "reward_msg":
"辛双清看看三字经，轻轻颔首：“嗯，很好。”\n",
                "fail_msg":
"辛双清疑惑地看着你：“怎么回事？怎么你。。。”\n",
                "delay_msg":
"辛双清很不高兴地说：“怎么去了那么长时间？书房不就在里面吗？\n",
        ]),
        ([      "quest":                "扫前院",
                "time":                 300,
                "bonus":                3,
                "quest_msg":
"辛双清点了点头，对你说：“听说前院现在比较脏，嗯，你去看看，\n"
"把那里扫扫干净。”\n",
                "reward_msg":
"辛双清看看你，轻轻颔首：“嗯，很好。”\n",
                "fail_msg":
"辛双清疑惑地看着你：“怎么回事？怎么你。。。”\n",
                "delay_msg":
"辛双清很不高兴地说：“怎么去了那么长时间？前院不就在前面吗？\n",
        ]),     
});


mapping query_quest()
{
        return quest[random(sizeof(quest))];
}
