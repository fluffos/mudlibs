//by lnwm

#include <ansi.h>

inherit SKILL;

mapping *quest = ({
  ([ "quest": "送「鞭法基础」给左子穆",
    "time": 180,
    "send_ob": CLONE_DIR + "book/bianfa",
    "bonus": 4,
    "quest_msg":
    "段无畏沉思了一下，抬头对你说：“你把这本鞭法送给无量左子穆。快去快回。\n",
    "send_msg":
    "左子穆很是高兴，对你说：“很好很好。”\n",
    "reward_msg":
    "段无畏很是高兴，对你说：“很好很好。”\n",
  ]),
  ([ "quest": "送猪头给马五德",
    "time": 600,
    "send_ob": CLONE_DIR + "eat/food/zhutou",
    "bonus": 3,
    "quest_msg":
    "段无畏对你说：“你把这猪头送给马五德老拳师。快去快回。\n",
    "send_msg":
    "马五德很是高兴，对你说：“啊唷，府上真是客气。。”\n",
    "reward_msg":
    "段无畏很是高兴，对你说：“很好很好，办事很利索嘛！”\n",
  ]),
  ([ "quest": "取大石头",
    "time": 80,
    "bonus": 2,
    "quest_msg":
    "段无畏笑了一声，说：“没有什么事情做啊？那你去给我拣块大石头来吧。”\n",
    "reward_msg":
    "段无畏点了点头说：“嗯，这么快就回来了，不错、不错。”\n",
    "delay_msg":
    "段无畏叹了口气道：“叫你办点事，就应快去快回，年青人也太过贪\n"
    "玩了。”\n",
  ]),
  ([ "quest": "取" YEL "姜" NOR,
    "time": 700,
    "bonus": 4,
    "quest_msg":
    "段无畏沉吟了一下：“这两天天凉，府里要做点姜汤，你去买点姜”\n"
    "回来吧。”\n",
    "reward_msg":
    "段无畏仔细端详了一下，点了点头\n",
  ]),
  ([ "quest": "杀" BLU "豺狼" NOR,
    "time": 900,
    "bonus": 4 + random(4),
    "quest_msg":
    "段无畏对你点点头说：“不知道你现在功夫怎么样？听说山区有豺狼\n"
    "伤人，百姓深受其苦，你就去为百姓除此害吧。速去速回。”\n",
    "reward_msg":
    "段无畏很是高兴，对你说：“很好很好，为民除害，为王爷扬名啊。”\n",
    "fail_msg":
    "段无畏摇摇头道：“看来你功夫还是要多练啊。”\n",
    "delay_msg":
    "段无畏看了看你，淡淡地说道：“怎么？豺狼不好对付吧？\n"
    "罢了，你先下去休息好了。”\n",
  ]),
});

#include "quest.h"
