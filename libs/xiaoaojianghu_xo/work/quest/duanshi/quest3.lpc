//by lala

#include <ansi.h>

inherit SKILL;

mapping *quest = ({
        ([      "quest":                "送「鞭法基础」给左子穆",// quest 0
                "time":                 180,
                "send_ob":              CLONE_DIR + "book/bianfa",
                "bonus":                4,
                "quest_msg":
"段无畏沉思了一下，抬头对你说：“你把这本鞭法送给无量左子穆。快去快回。”\n",
                "reward_msg":
"段无畏很是高兴，对你说：“很好很好。”\n",
                "send_msg":
"左子穆很是高兴，对你说：“很好很好。”\n",
        ]),             
        ([      "quest":                "送"RED"女儿红"NOR"给过彦之",// quest 1
                "time":                 950+random(100),
                "send_ob":              "/d/city/dali/npc/obj/nver",
                "bonus":                5+random(8),
                "quest_msg":
"段无畏说：“听说南阳的柯老爷子要过寿了，你把这坛酒送到他府上管事的过大侠\n"
"手上吧，算是府上的一点点意思。”\n",
                "send_msg":
"过彦之很是高兴，对你说：“嗨呀，难得王府上看得起，这么远路送礼物来啊。”\n",
                "reward_msg":
"段无畏满意地对你说：“很好很好，多跑跑路，多办办事，长长见识嘛。”\n",
                "fail_msg":
"段无畏不满地喝道：“磨磨蹭蹭！送礼都送到人家正日子后头了，还有什么用？”\n",                
        ]),             
        ([      "quest":                "送信给慧觉",// quest 2
                "time":                 1000+random(100),
                "send_ob":              "/d/menpai/duanshi/npc/obj/letter",
                "bonus":                8+random(8),
                "quest_msg":
"段无畏说：“这里有一封信是府上给少林寺慧觉大师的，你辛苦一趟吧。”\n",
                "send_msg":
"慧觉点头微笑道：“施主辛苦了，回去请转告贵主上，说慧觉收到信了。”\n",
                "reward_msg":
"段无畏满意地对你说：“很好很好，多跑跑路，多办办事，长长见识嘛。”\n",
        ]),             
        ([      "quest":                "送信给朱算",// quest 3
                "time":                 780+random(100),
                "send_ob":              "/d/menpai/duanshi/npc/obj/letter",
                "bonus":                5+random(5),
                "quest_msg":
"段无畏说：“府上和兰州的龙门镖局有笔帐目没有了结，你送封信给镖局的帐房吧。”\n",
                "send_msg":
"朱算看了信笑道：“原来是这回事，好说好说，回去和段管事说，我照办了。”\n",
                "reward_msg":
"段无畏满意地对你说：“很好很好，多跑跑路，多办办事，长长见识嘛。”\n",
        ]),             
        ([      "quest":                "杀衙役",// quest 4
                "time":                 1000,
                "bonus":                10,
                "positive_score":       40,
                "quest_msg":
"段无畏看了你一眼，郑重地对你说：“大理衙门里那个衙役平常作威\n"
"作福，欺压百姓，鱼肉乡里，现在我命你去把他杀了，为大理百\n"
"姓除掉这个祸害！”\n",
                "reward_msg":
"段无畏大喜，对你说：“你能办成这件事，实乃大理黎民之福也，日\n"
"后我必将倾囊相授，令你成为武林奇葩！”\n",
                "fail_msg":
"段无畏叹了一口气，说：“那贼子果然厉害，也难怪你敌不过他，只\n"
"是，如此一来，那恶贼必将愈加猖獗，唉～～”\n",
                "delay_msg":
"段无畏舒了一口气：“你一去不返，我等均以为凶多吉少，如今你终\n"
"于杀掉那恶贼而平安归来，还属天助呀！”\n",
        ]),

        ([      "quest":                "取"YEL"姜"NOR,// quest 5
                "time":                 700,
                "bonus":                4,
                "quest_msg":
"段无畏沉吟了一下：“这两天天凉，府里要做点姜汤，你去买点姜”\n"
"回来吧。”\n",
                "reward_msg":
"段无畏仔细端详了一下，点了点头\n",
        ]),           
        ([      "quest":                "取" BLU "鱼肠剑" NOR,// quest 6
                "time":                 1600,
                "bonus":                7,
                "quest_msg":
"段无畏说道：“听说有人在大理城中得了一把宝剑，这等宝物若是落在\n"
"凡夫俗子手中，只怕会招人窥觑，若是被心术不正之徒拿到，势将为\n"
"祸他人，你这就下山去跑一趟吧。”\n",
                "reward_msg":
"段无畏接过宝剑，拉出匣中看了看点了点头道：“嗯，倒也难为你了\n"
"，先下去休息休息吧。“\n", 
                "fail_msg":
"段无畏皱了皱眉头沉吟道：“看来得我亲自走一趟了。”\n",
                "delay_msg":
"段无畏接过剑来看了看，淡淡地说道：“这点小事都费这么长时间，\n"
"罢了，你先下去吧。”\n",
        ]),    
        ([      "quest":                "杀禁军士兵",// quest 7
                "time":                 600,
                "bonus":                4,
                "quest_msg":
"段无畏沉思了一下，抬头对你说：“城中禁军士兵助纣为虐，大理百姓\n"
"深受其苦，你就下山去杀一名禁军士兵以作儆戒吧。”\n",
                "reward_msg":
"段无畏很是高兴，对你说：“很好很好。”\n",
        ]),    
        ([      "quest":                "杀"RED "斑斓猛虎" NOR,// quest 8
                "time":                 800+random(100),
                "bonus":                4+random(6),
                "positive_score":       20+random(30),
                "quest_msg":
"段无畏对你点点头说：“不知道你现在功夫怎么样？听说山区有猛虎\n"
"伤人，百姓深受其苦，你就去为百姓除此害吧。速去速回。”\n",
                "reward_msg":
"段无畏很是高兴，对你说：“很好很好，为民除害，为王府扬名啊。”\n",
                "fail_msg":
"段无畏摇摇头道：“看来你功夫还是要多练啊。”\n",
                "delay_msg":
"段无畏看了看你，淡淡地说道：“怎么？老虎很不好对付吧？\n"
"罢了，你先下去休息好了。”\n",
        ]),    
        
});

#include "quest.h"
