//Qyz
#include <ansi.h>

inherit SKILL;

mapping *quest = ({
  ([ "quest": "挑水",
    "time": 300,
    "bonus": 2,
    "quest_msg":
    "缘净说道：“嗯，现在厨房里缺水了，你去挑一担水来吧。\n",
    "reward_msg":
    "缘净拍拍你的肩膀，用欣赏的眼光看着你：“能吃苦，好样的。”",
    "fail_msg":
    "缘净对着你摇了摇头，说：“连这点事都做不好——下去吧。”\n",
    "delay_msg":
    "缘净似乎有些不满：“怎么挑一趟水要这么长时间？，以后快点！”\n",
  ]),
  ([ "quest": "打扫立佛殿",
    "time": 300,
    "bonus": 2,
    "quest_msg":
    "缘净想了一下，说：你去打扫一下立佛殿吧，那里的地也该扫扫了。\n",
    "reward_msg":
    "缘净说，“嗯，不错，能吃苦，是练武的好材料。”\n",
    "fail_msg":
    "缘净瞪着你，似乎有些圭怒：“让你去打扫立佛殿，怎么你竟。。。”\n",
    "delay_msg":
    "缘净无奈地笑了笑：“扫地都要花那么多时间。。。唉！！”\n",
  ]),
