//Qyz
#include <ansi.h>

inherit SKILL;

mapping *quest = ({
  ([ "quest": "杀毒蛇",
    "time": 600,
    "bonus": 8,
    "quest_msg":
    "左子穆沉吟了一下：“听说近来后山上常有毒蛇出没，伤及人畜，\n"
    "你就去把它杀死吧。”\n",
    "reward_msg":
    "左子穆拍拍你的肩膀，用欣赏的眼光看着你：“看来你也是个可造\n"
    "之材呀，日后定会好好栽培于你。”\n",
    "fail_msg":
    "左子穆对着你摇了摇头，说：“连这点事都做不好.....下去吧。”\n",
    "delay_msg":
    "左子穆似乎有些不满：“怎么现在才办好这件事？，你。。。”\n",
  ]),
  ([ "quest": "扫前厅",
    "time": 300,
    "bonus": 2,
    "quest_msg":
    "左子穆看看周围，“暂时也没什么事做，听老高说前厅没人打扫，你\n"
    "就先去打扫一下吧。”\n",
    "reward_msg":
    "左子穆说，“嗯，不错，能吃苦，是练武的好材料。”\n",
    "fail_msg":
    "左子穆瞪着你，似乎有些圭怒：“让你去打扫前厅，怎么你竟。。。”\n",
    "delay_msg":
    "左子穆无奈地笑了笑：“扫地都要花那么多时间。。。唉！！”\n",
  ]),
  ([ "quest": "杀衙役",
    "time": 1000,
    "bonus": 10,
    "positive_score": 40,
    "quest_msg":
    "左子穆看了你一眼，郑重地对你说：“大理衙门里那个衙役平常作威\n"
    "作福，欺压百姓，鱼肉乡里，现在我命你下山去把他杀了，为大理百\n"
    "姓除掉这个祸害！”\n",
    "reward_msg":
    "左子穆大喜，对你说：“你能办成这件事，实乃大理黎民之福也，日\n"
    "后我必将倾囊相授，令你成为武林奇葩！”\n",
    "fail_msg":
    "左子穆叹了一口气，说：“那贼子果然厉害，也难怪你敌不过他，只\n"
    "是，如此一来，那恶贼必将愈加猖獗，唉～～”\n",
    "delay_msg":
    "左子穆舒了一口气：“你一去不返，我等均以为凶多吉少，如今你终\n"
    "于杀掉那恶贼而平安归来，还属天助呀！”\n",
  ]),
  ([ "quest": "取烧柴",
    "time": 600,
    "bonus": 4,
    "quest_msg":
    "左子穆想了想，说：“听厨房里说，这两天烧柴颇缺，你就上后山密\n"
    "林中去砍些烧柴回来吧。”\n",
    "reward_msg":
    "左子穆点了点头：“待会我会命人把这些烧柴送到厨房，你累了吧？\n"
    "下去歇歇吧。”\n",
    "fail_msg":
    "左子穆看上去很不高兴，皱了皱眉头对你说：“下去歇着吧。”，嘴\n"
    "里嘟囔着：“真是没用。。。。”\n",
    "delay_msg":
    "左子穆很不高兴地看了你两眼，一言不发，又把身子转了过去。。。\n",
  ]),
  ([ "quest": "杀关东刀客",
    "time": 1000,
    "bonus": 12,
    "positive_score": 70,
    "quest_msg":
    "左子穆突然想起了什么，急切地对你说：“速速下山除掉大理城中的\n"
    "关东刀客，此人乃一名大盗假扮，意欲对我大理国不利，此事甚急，\n"
    "你快点下山去办吧！”\n",
    "reward_msg":
    "左子穆如释重负，欣然对你说，“所幸你及时除掉关东刀客，否则我\n"
    "大理百姓又要遭受磨难了。”\n",
    "fail_msg":
    "左子穆焦急地搓着双手，眉头紧皱，看着你叹了一口气说：“看来得\n"
    "再派个人去。。。。要不然。。。”\n",
    "delay_msg":
    "左子穆点了点头：“嗯，迟了一点，还好没出大事。”\n",
  ]),
  ([ "quest": "取三字经",
    "time": 300,
