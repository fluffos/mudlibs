// yipin_jiewuqi.c
// by lnwm 1997-12-11
// 用来监视谁借了一品堂的武器不还？

#include <ansi.h>
#include <condition.h>
#include <dbase.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration) {
  me->apply_condition("yipin_jiewuqi", duration - 1);

  if (duration < 10)
    tell_object(me, "现在离你交还一品堂发的武器的日期不远了。\n");
  if (duration < 1) {
    tell_object(me, "你已经过了交还一品堂所发武器的时间，等着回去受罚吧。\n");
    return 0;
  }
  return CND_CONTINUE;
}
