// zouhuo_rumo.c

inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{
    me->apply_condition( "zouhuo_rumo", duration -1 );
    if ( ! duration ) 
    {
        me->delete( "recover_force" );
        me->delete( "can_recover_max_force" );
        return 0;
    }
    me->set( "can_recover_max_force", 1 );
        return 1;
}

