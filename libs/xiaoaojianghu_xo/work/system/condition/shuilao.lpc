// shuilao.c
// By lala, July 12, 97
#include <ansi.h>
#include <login.h>

int update_condition(object me, int duration) {
  if (duration < 1) {
    me->move("/d/menpai/shaolin/shuilao_exit");
    message("vision",
      HIY "只听一阵脚步声响，一个水牢中的犯人跟着护卫僧走过来。\n" NOR,
      environment(me), me);
    tell_object(me, HIY "水牢的铁门“哐铛”一声打开，一个护卫僧把你带了出来。\n" NOR);
    me->set("startroom", "/d/menpai/shaolin/shuilao_exit");
    return 0;
  }
  me->apply_condition("shuilao", duration - 1);
  return 1;
}
