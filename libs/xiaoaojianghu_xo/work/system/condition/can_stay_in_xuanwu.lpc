// can_stay_in_xuanwu.c

inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{
        if( duration <= 2 )
        tell_object( me, "你在玄武堂学艺的时限已经到了，得赶快走了。\n");

        me->apply_condition("can_stay_in_xuanwu", duration - 1);
        if( !duration ) return 0;
        return 1;
}

