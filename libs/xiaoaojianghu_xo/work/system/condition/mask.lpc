// by lnwm 1997-10-17

#include <ansi.h>
#include <condition.h>
#include <dbase.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration) {
  me->apply_condition("mask", duration - 1);
  if (!me->query_temp_marks("apply")) return 0;
  //      message_vision(HIW "$N易容中... \n" NOR , me);
  if (duration < 1) {
    if (!me->query_temp_marks("apply")) return 0;
    message_vision(CYN "易容术失效了.\n" NOR, me);
    me->delete_temp_marks("apply/id");
    me->delete_temp_marks("apply/name");
    me->delete_temp_marks("apply/short");
    me->delete_temp_marks("apply/long");
    return 0;
  }
  return CND_CONTINUE;
}
