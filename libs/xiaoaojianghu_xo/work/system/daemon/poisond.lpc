// poisond.c 广义上的“染毒”处理。 
// lin
void get_effect(object me,object who,int touch_type,int eff_type);
void add_effect(object me,object who,int get_type,int eff_type);  
void copy_virus(object me,object who,mapping eff,string type);
void complete_effect(object me,object who,int eff_type);   
///////////////////////////////////////////////////////////////////////
void get_effect(object me,object who,int touch_type,int eff_type)
{            
    mapping edge,inside;
    string *k_edge,*k_inside;    
    int i;
    edge = who->query("extra_eff/edge");
    inside = who->query("extra_eff/inside");  
    if( edge )
        k_edge = keys(edge);  
    if( inside )
        k_inside = keys(inside);  
    if( !k_edge && ! k_inside ) return;
    switch ( touch_type )
    {
        case 0:
            break;
        case 1:
            for( i = 0; i < sizeof( k_edge ) ; i++ )
            {
                write(edge[k_edge[i]] + "\n");
                edge[ k_edge[i] ]->complete_effect(me,who,eff_type);  
                write("run complete_effect\n");
            }   
            break;
        case 2:
            for( i = 0; i < sizeof( k_inside ) ; i++ )
                inside[ k_inside[i] ]->complete_effect(me,who,eff_type);
            break;
        case 3:                       
            for( i = 0; i < sizeof( k_edge ) ; i++ )
                edge[ k_edge[i] ]->complete_effect(me,who,eff_type);
            for( i = 0; i < sizeof( k_inside ) ; i++ )
                inside[ k_inside[i] ]->complete_effect(me,who,eff_type);
            break;
    }     
}
///////////////////////////////////////////////////////////////////////
void add_effect(object me,object who,int touch_type,int eff_type)
{    
    //who对me产生“传染”作用.  
    string eff_id;
    mapping edge,inside; 
    //是药么？
    if( (who->is_medicine()) && (eff_id = who->query("eff_id")) )
    {   
        write("is medicine.\n");
        switch (touch_type)
        {
            case 0:
                break;
            case 1://touch_type是"edge"
                me->set("extra_eff/edge/"+eff_id,base_name(who) ); 
                write("ok.\n");
                break;
            case 2://touch_type is inside
                me->set("extra_eff/inside/"+eff_id,base_name(who) );
            case 3://touch_type is edge and inside
                me->set("extra_eff/edge/"+eff_id,base_name(who) );
                me->set("extra_eff/inside/"+eff_id,base_name(who) );
                break;
        }
    }
    //接触传染:  
    edge = who->query("extra_eff/edge");
    inside = who->query("extra_eff/inside"); 
    if( !edge ) write ("no edge!.\n");
        switch ( touch_type )
        {
            case 0:
                break;
            case 1:
                copy_virus(me,who,edge,"edge"); 
                write(" done infecting\n"); 
                break;
            case 2:
                copy_virus(me,who,inside,"inside");
                break;
            case 3:
                copy_virus(me,who,edge,"edge");
                copy_virus(me,who,inside,"inside");
                break;
        }
}                                       
///////////////////////////////////////////////////////////////////////
void copy_virus(object me,object who,mapping eff,string type)
{                                               
    string *key;
    int i;    
    if( !eff ) return;
    key = keys( eff );
    for( i=0 ; i<sizeof(key) ; i++ )
        if( eff[key[i]]->is_infective() )
            me->set("extra_eff/"+type+"/"+key[i],eff[key[i]]); 
    write( me->query("id") + " is infected.\n ");
}    
    
    
                
    
    
        
        