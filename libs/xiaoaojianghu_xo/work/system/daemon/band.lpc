// Filename : /system/daemon/band.c

// #include <net/telnet.h>

#define BANNED_SITES "/system/etc/banned_sites"

void load_sites();
void add(string pattern);
void remove(string pattern);
int is_banned(string site);
void print();

string *Sites;

void create() {
  seteuid(getuid());
  load_sites();
}

void load_sites() {
  string *tmp, file;
  int loop;

  Sites = ({});

  // reads in the list of the banned sites

  file = read_file(BANNED_SITES);
  if (!file) return;

  tmp = explode(file, "\n");
  for (loop = 0; loop < sizeof(tmp); loop++)
    if (tmp[loop][0] == '#' || tmp[loop][0] == '\n' || tmp[loop] == "")
      continue;
    else Sites += ({ tmp[loop] });
}

int is_banned(string site) {
  string *line;
  int i;

  // WASM/loopback: local connections are always allowed; empty/non-string/
  // malformed input (older WASM query_ip_number()/query_ip_name() garbage,
  // or "localhost") counts as loopback. Anything that is not a plausible
  // hostname/IP (chars outside [A-Za-z0-9.-]) is treated as loopback too,
  // both for safety and because such garbage could break regexp() below.
  if (!stringp(site) || site == "" || site == "127.0.0.1"
    || site[0..3] == "127." || site == "localhost")
    return 0;
  for (i = 0; i < sizeof(site); i++)
    if (!((site[i] >= 'a' && site[i] <= 'z') || (site[i] >= 'A' && site[i] <= 'Z')
      || (site[i] >= '0' && site[i] <= '9') || site[i] == '.' || site[i] == '-'))
      return 0;
  line = ({});
  line += ({ site });

  for (i = 0; i < sizeof(Sites); i++)
    if (sizeof(regexp(line, Sites[i])) == 1)
      return 1;
  return 0;
}

void print() {
  int i;
  for (i = 0; i < sizeof(Sites); i++)
    write(Sites[i] + "\n");
}

void add(string site) {
  int i;

  Sites += ({ site });
  write_file(BANNED_SITES, Sites[sizeof(Sites) - 1] + "\n", 0);
}

void remove(string site) {
  write("请修改 " + BANNED_SITES + " 解禁。\n");
}
