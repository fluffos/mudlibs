//record_d.c
//by lnwm 
//用来给写某些权限不够的目录.
//涉及系统安全,所以必须限定能写的目录.目前设为/data.

#include <ansi.h>

inherit F_DBASE;

void create()
{
    seteuid(ROOT_UID);
    set("name", "书记员");
    set("id", "record_d");
}

int OverwriteFile( string file, string str )
{
    return write_file( file, str, 1 );
}

int AppendFile( string file, string str )
{
    return write_file( file, str );
}    

