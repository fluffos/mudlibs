// Ffox 98-3-28 9:52

inherit F_CLEAN_UP;

void create() {
  seteuid(getuid());
}

int set_new_order(string ORDER_FILE, string msg) {
  if (ORDER_FILE != "/data/kunlun_order.o") {
    write("Cannot write file " + ORDER_FILE + ".\n");
    return 0;
  }
  write_file(ORDER_FILE, msg, 1);
  return 1;
}

int save_data(string file, string msg, int a) {
  if (file != "/data/brother.o" && file != "/data/sister.o") {
    write("Cannot write file " + file + ".\n");
    return 0;
  }
  if (a == 1) write_file(file, msg, 1);
  else write_file(file, msg);
  return 1;
}
