#include <ansi.h>
//#include <dirs.h>
//#include <daemons.h>

//inherit LIB_DAEMON;
inherit F_CLEAN_UP;
inherit F_DBASE;

nosave private string Error;
nosave private mapping Indices;

nosave private void LoadIndices();
mixed GetHelp(string str);
mixed GetHelpByIndex(string index, string topic);
string GetTopic(string index, string topic);
varargs string *GetIndices(string topic);

nosave void create() {
  //    daemon::create();
  set("no_clean_up", 1);
  Error = 0;
  LoadIndices();
  seteuid(geteuid());
}

int CanAccess(object who, string index) {
  switch (index) {
    case "wizard commands":
    case "wizard documents":
      //      case "library objects":
      //      case "daemon objects":
      return wizardp(who);

    default:
      return 1;
  }
}

private int file_exists(string file) {
  return (file_size(file) >= 0);
}

nosave private void LoadIndices() {
  string *tmp;
  function f;
  string dir;

  f = function(string str) {
    return str[0..<3];
  };
  Indices = ([]);

  tmp = get_dir(COMMAND_DIR + "comm/*.lpc") + get_dir(COMMAND_DIR + "verb/*.lpc") + get_dir(COMMAND_DIR + "skill/*.lpc");
  Indices["commands"] = map(tmp, f);

  tmp = get_dir(COMMAND_DIR + "imm/*.lpc") + get_dir(COMMAND_DIR + "app/*.lpc") + get_dir(COMMAND_DIR + "wiz/*.lpc") + get_dir(COMMAND_DIR + "arch/*.lpc") + get_dir(COMMAND_DIR + "adm/*.lpc");
  Indices["wizard commands"] = map(tmp, f);

  /*      tmp = _D->GetEmotes();
        Indices["feelings"] = tmp;
*/
  if (tmp = get_dir(HELP_DIR "menpai/"))
    Indices["menpai"] = tmp;
  else
    Indices["menpai"] = ({});

  if (tmp = get_dir(HELP_DIR "rules/"))
    Indices["rules"] = tmp;
  else
    Indices["rules"] = ({});

  if (tmp = get_dir(HELP_DIR "map/"))
    Indices["map"] = tmp;
  else
    Indices["map"] = ({});

  if (tmp = get_dir(HELP_DIR "story/"))
    Indices["story"] = tmp;
  else
    Indices["story"] = ({});

  if (tmp = get_dir(HELP_DIR "notion/"))
    Indices["notion"] = tmp;
  else
    Indices["notion"] = ({});

  if (tmp = get_dir(HELP_DIR "start/"))
    Indices["start"] = tmp;
  else
    Indices["start"] = ({});
}

mixed GetHelp(string str) {
  string *tmp;
  string topic;
  int x;

  Error = 0;
  if (!str || str == "" || str == "help") {
    return ("Syntax: <help>\n"
      "        <help index>\n"
      "        <help TOPIC>\n"
      "        <help INDEX TOPIC>\n\n"
      /*                      "Without an argument, you get this help screen.  The same "
                        "applies for trying to get help on the help command.  With "
                        "an argument, you are given information on the topic you "
                        "specified.  The special topic, \"help index\", puts you into "
                        "a menu driven index of categories for which help exists.  In "
                        "some cases, the same help topic will exist in two separate "
                        "categories.  If help tells you that you have asked for "
                        "help on such a topic, you may specify the index from which "
                        "it comes by using the index name help gives you.  For "
                        "example:\n"
                        "> help list\n"
                        "There exists help for \"list\" in the following indices:\n"
                        "commands, channels\n"
                        ">\n"
                        "You could then type \"help player commands list\" to get "
                        "the help for the list player command.\n\n"
                        "In general, most commands have only a single index, so there "
                        "is generally no need to specify the index.\n"
                        "Finally, to help you better understand how to issue commands "
                        "on Nightmare, you should check out the document "
                        "\"help syntax\".\n\n" 

                        "See also: faq, index, syntax"
*/
    );
  }
  /*      if (sscanf(str, "adverbs %s", topic) || str == "adverbs")
        {
                return (string) SOUL_D->GetHelp(str);
        }
*/
  tmp = GetIndices(str);
  if (sizeof(tmp) == 1) {
    return GetHelpByIndex(tmp[0], str);
  } else if (sizeof(tmp) > 1) {
    Error = "有如下" + chinese_number(sizeof(tmp)) + "个关于" + str + "主题：" + implode(tmp, ", ") + "\n";
    return 0;
  }
  topic = "";
  //      str = trim(str);
  while ((x = strsrch(str, " ")) != -1) {
    if (topic != "") {
      topic = topic + " " + str[0..(x - 1)];
    } else {
      topic = str[0..(x - 1)];
    }
    str = str[(x + 1)..];
    if (Indices[topic] && strlen(str)) {
      return GetHelpByIndex(topic, str);
    }
  }
  Error = "没有关于" + str + "的帮助文件。";
  return 0;
}

mixed GetHelpByIndex(string index, string topic) {
  mixed *tmparr, fun, help;
  mapping tmpmap;
  object ob;
  string file, tmpstr;

  if (this_player() && !CanAccess(this_player(), index)) {
    Error = "用户权限被否定。";
    return 0;
  }
  switch (index) {
    case "wizard commands":
    case "commands":
      switch (index) {
        case "wizard commands":
          if (file_exists(COMMAND_DIR + "imm/" + topic + ".lpc"))
            file = COMMAND_DIR + "imm/" + topic;
          else if (file_exists(COMMAND_DIR + "app/" + topic + ".lpc"))
            file = COMMAND_DIR + "app/" + topic;
          else if (file_exists(COMMAND_DIR + "wiz/" + topic + ".lpc"))
            file = COMMAND_DIR + "wiz/" + topic;
          else if (file_exists(COMMAND_DIR + "arch/" + topic + ".lpc"))
            file = COMMAND_DIR + "arch/" + topic;
          else
            file = COMMAND_DIR + "adm/" + topic;
          break;

        case "commands":
          foreach (string directory in ({
            COMMAND_DIR + "comm/",
            COMMAND_DIR + "verb/",
            COMMAND_DIR + "skill/",
          })) {
            if (file_exists(directory + topic + ".lpc")) {
              file = directory + "/" + topic;
              break;
            }
          }
          break;
      }
      if (!file_exists(file + ".lpc")) {
        Error = "没有这个指令：" + index[0..<2];
        return 0;
      }
      if (catch(help = file->help(this_player()))) {
        Error = "An error occurred in attempting to access help.";
        return 0;
      }
      if (!help) {
        help = "有这个指令存在，但是没有相应的帮助信息。";
      } else if (intp(help))
        return help;
      help = "Index: " GRN + index + NOR "\n" +
        "Topic: " GRN + topic + NOR "\n\n" + help;
      return help;

    case "map":
    case "rules":
    case "menpai":
    case "story":
    case "notion":
      file = HELP_DIR + index + "/" + topic;
      if (!file_exists(file)) {
        Error = "没有这个帮助文件。";
        return 0;
      }
      if (!(help = read_file(file))) {
        Error = "文件" + topic + "是空的。";
        return 0;
      }
      help = "Index: " GRN + index + NOR "\n" +
        "Topic: " GRN + topic + NOR "\n\n" + help;
      return help;
    default:
      Error = "No help exists for the index " + index + ".";
      return 0;
  }
}

varargs string *GetIndices(string topic) {
  string *topics, val;
  string ind, tmp;

  if (!topic) {
    return sort_array(keys(Indices), 1);
  }
  topics = ({});
  foreach (ind, val in Indices) {
    if (!CanAccess(this_player(), ind)) {
      continue;
    }
    tmp = GetTopic(ind, topic);
    if (member_array(tmp, val) != -1) {
      topics += ({ ind });
    }
  }
  return sort_array(topics, 1);
}

