string *GetTopics(string index) {
  string *topics = Indices[index];

  if (!topics) {
    return 0;
  } else {
    return sort_array(topics, 1);
  }
}

string GetLastError() {
  return Error;
}

void Reload() {
  LoadIndices();
}
