// /system/daemon/skilld.c
// this is the skill daemon, to classify the skill by the classes
// by nerd 97/6/27 :P
inherit F_DBASE;
inherit F_CLEAN_UP;

string * path=({
    "/system/skill/",
    "/system/skill/basic/",
    "/system/skill/gaibang/",
    "/system/skill/misc/",
    "/system/skill/shaolin/",
    "/system/skill/kongdong/",
    "/system/skill/biaoju/",
    "/system/skill/wuliang/",
    "/system/skill/funiu/",
    "/system/skill/duanshi/",
    "/system/skill/fofa/",
    "/system/skill/soldier/",
    "/system/skill/xkdao/",
    "/system/skill/yipin/",
    "/system/skill/murong/",
    }) ;

mapping search = ([]);

void create()
{
    set("no_clean_up",1);
    seteuid(geteuid());
}

void rehash(string dir)
{
        int i;
        string *cmds;

        if ( dir[ sizeof( dir ) - 1 ] != '/' )
                dir += "/";
        cmds = get_dir(dir);
        i = sizeof(cmds);
        while ( i-- )
                if ( !sscanf( cmds[ i ], "%s.c", cmds[ i ] ) )
                {
                        if ( i == 0 )
                                cmds = cmds[ 1..sizeof(cmds) ];
                        else if ( i == sizeof( cmds ) )
                                cmds = cmds[ 0..<2 ];
                        else
                                cmds = cmds[ 0..i - 1 ] + cmds[ i + 1..<1 ];
                }
        if ( sizeof( cmds ) )
                search[ dir ] = cmds;
}

string find_skill(string skill)
{
        int i;

        i = sizeof( path );
        while ( i-- ) 
        {
                if ( undefinedp( search[ path[ i ] ] ) )
                        rehash( path[ i ] );
                if ( undefinedp( search[ path[ i ] ] ) )
                        continue;
                if ( member_array( skill, search[ path[ i ] ] ) != -1 )
                        return path[ i ] + skill;
        }
        return 0;
}
