void create()
{
	seteuid(getuid());
}

object compile_object(string file)
{
	return 0;
}

object compile_task_object(string file, string task_name)
{
    object ob, task;
    mapping task_dbase;
    if (!(ob = find_object(file)))
        ob = load_object(file);
    if (!objectp(ob)) return 0;
    task_dbase = ob->GetTask(task_name);
    if (!task_dbase) return 0;
    task = new(TASK);
    if (!objectp(task)) return 0;
    task->SetTask(task_dbase);
    return task;
}
