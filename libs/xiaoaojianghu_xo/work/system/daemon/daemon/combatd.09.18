////////////////////////////////////////////////////////////////////////////
// Interface 

void create()
{
    seteuid(getuid());
    set("name", "战斗精灵");
    set("id", "combatd");
}

int wugong_power(object ob, string skill, int usage)
{
    int i ,j, power;
    int xiuwei, xiuwei_jibie;
    int wugong_dengji, wugong_dengji_temp;
    int wugong_lingwu;
    int skill_dengji;
    string type, *wugong,weapon_type;

    if ( !living( ob ) ) return 0;

    // combat_exp 提供的 wugong_power

    power = ob->query( "combat_exp" ) / 200;

    // 如果手持武器，攻防提高一点。
    if ( ob->query_temp( "weapon" ) ) power += 30;

    // 天赋对武功的影响
    switch ( usage )
    {
    case TYPE_ATTACK:
        power += random( ob->query_str() ) + 1;
        break;

    case TYPE_DODGE:
        power += random( ob->query_dex() ) + 1;
        break;

    case TYPE_PARRY:
        power += random( ob->query_cps() ) + 1;
        break;
    }

    // 以下计算xiuwei提供的wugong_power
    // 这里的xiuwei是总修为。
    xiuwei = (int)ob->query_xiuwei_by_type( "zonggang" );
    xiuwei_jibie = (int)ob->query_xiuwei_jibie( "zonggang" ) + 1;
    power += xiuwei * xiuwei_jibie * xiuwei_jibie / 10;

    if ( skill == "kongshou" )
    {
        type = "unarmed"; 
        weapon_type = type;
        skill_dengji = 0;
    }
    else if ( skill == "wuqi" )
    {
        object weapon = ob->query_temp( "weapon" );
        type = weapon->query( "skill_type" );  
        weapon_type = weapon->query("weapon_type");
        skill_dengji = 0;
    }
    else
    {
        type = SKILL_D( skill )->query_xiuwei_type(); 
        weapon_type = SKILL_D( skill )->query_weapon_type();
        if( !weapon_type )
            weapon_type = type;
        //这样的话，对于不同的兵器，虽然修为是一样的，但是攻防将不加。
        //ACTION也将不用。
        skill_dengji = SKILL_D( skill )->query_dengji();
    }

    // 这里的修为是某种技能的修为
    xiuwei = (int)ob->query_xiuwei_by_type( type );
    xiuwei_jibie = (int)ob->query_xiuwei_jibie( type ) + 1;
    power += xiuwei * xiuwei_jibie * xiuwei_jibie * 2 / 5;

    // 以下计算技能产生的wugong_power       

    if ( undefinedp( ob->query_temp( "sort_wugong/" + weapon_type ) ) )
        ob->sort_wugong( weapon_type );
    wugong = ob->query_temp( "sort_wugong/" + weapon_type );
    
    if ( sizeof( wugong ) )
    {
        // ap依赖wugong_lingwu的(1+2/(wugong_dengji+1))次方的
        // 这样在xiuwei较低时，技能提供的power随着技能的提高能
        // 增长的更多。

        for ( i = 0 ; i < sizeof( wugong ); i ++ )
        {
            wugong_dengji_temp = wugong_dengji;

            wugong_dengji = SKILL_D( wugong[ i ] )->query_dengji();
            if ( skill_dengji < wugong_dengji )
                wugong_dengji = ( wugong_dengji + skill_dengji ) / 2;
            wugong_lingwu = (int)ob->query_lingwu( wugong[ i ] );
            // 计入有效级别
            wugong_lingwu = wugong_lingwu *
                SKILL_D( wugong[ i ] )->query_youxiao_jibie() / 10;

            if ( wugong_dengji < wugong_dengji_temp ) j = 0;
            j++;
            power += power_ratio[ wugong_dengji ] * wugong_lingwu
                * pow( wugong_lingwu / 60.0, 2.0 / ( wugong_dengji + 1 ) );
        }
    }

    // 调整攻防比的影响
    switch ( usage )
    {
    case TYPE_ATTACK:
        power = power *((  ob->query_gongfang() - 50 ) * 7 / 10  + 35 + random(31) )  / 50;
        break;

    case TYPE_DODGE:
        power = power * ( 100 - ((  ob->query_gongfang() - 50 ) * 7 / 10  + 35 + random(31)) )  / 50;
        break;

    case TYPE_PARRY:
        power = power * ( 100 - ((  ob->query_gongfang() - 50 ) * 7 / 10  + 35 + random(31)) )  / 50;
        power = power * SKILL_D( skill )->query_parry_ratio() / 10;
        break;
    }

    // 实力比的影响
    power = power * ob->query_shili() / 100;

    if ( ob->is_busy() ) power /= 3;
    return power;
}

varargs int fight_control( object me, object you, int type )
{
    mapping attack_action, fanji_action;
	string result, temp;

	//
	// 决定进攻者(me)的攻击动作
	//
    attack_action = me->select_attack_action();
    result = "\n" + attack_action["action"] + "！\n";
#ifdef DEBUG
    debug = "";
#endif

    if ( make_fanji_decide( you, type ) == DECIDE_FANJI )
    {
        fanji_action = you->select_attack_action();
        if ( make_fanji_decide( me, AT_FANJI ) == DECIDE_FANJI )
        {
            // 对招时用双方的 dodge / 2 来计算, 事实上可以在这里
            // 实现"对掌"等效果.
            temp = get_fanji_msg() + fanji_action["action"] + "\n";
            result += jiaohuan_daci( temp );
            duel_attack( me, you, attack_action, fanji_action, result );
        }
        else
        {
            result = replace_weapon( result, me, you, attack_action );
            result = jiaohuan_daci( result );
            result = replace_limb( you, attack_action, result );
            result += get_fanji_msg();
            result += fanji_action["action"] + "\n";
            result += get_shouzhao_msg();
            defend_action( you, me, fanji_action, result, AT_FANJI );
        }
    }
    else
    {
        defend_action( me, you, attack_action, result, type );
    }

	return 1;
}

// fight()
//
// This is called in the attack() defined in F_ATTACK, which handles fighting
//  in the heart_beat() of all livings. Be sure to optimize it carefully.
//
void fight(object me, object victim)
{
    object ob;

    if ( !living(me) ) return;

    /*
    if ( !me->visible(victim) &&
		 (random(100 + (int)me->query_skill("perception")) < 100) )
	{
        return;
	}
    */

	// If victim is busy or unconcious, always take the chance
	//  to make an attack.
    if ( victim->is_busy() || !living(victim) )
	{
        me->set_temp( "guarding", 0 );
        // 先去掉, 看看效果如何? 在 fight_ob() 函数中我们有些判断与
        // 这儿冲突
        //if ( !victim->is_fighting( me ) )
		//	victim->fight_ob( me );
        fight_control( me, victim, AT_QUICK );
	}
    // Else, see if we are brave enough to make an aggressive action.
    else if ( make_attack_decide( me ) ) 
	{
        me->set_temp( "guarding", 0 );
        //if ( !victim->is_fighting( me ) )
		//	victim->fight_ob( me );
        fight_control( me, victim, AT_NORMAL );
	}
    // Else, we just start guarding.
    else if ( !me->query_temp("guarding") )
	{ 
        me->set_temp("guarding", 1);
        message_vision( get_guard_msg(), me, victim );
    }
	else
		me->add_temp("guarding", 1);
}

// auto_fight()
//
// This function is to start an automatically fight. Currently this is
//  used in "aggressive", "vendetta", "hatred", "berserk" fight.
//
void auto_fight(object me, object obj, string type)
{
    // Don't let NPC autofight NPC.
    if ( !userp(me) && !userp(obj) ) return;

 	// Because most of the cases that we cannot start a fight cannot
	//	be checked before we really call the kill_ob(), so we just make
	//	sure we have no aggressive callout wating here.
    if ( me->query_temp("looking_for_trouble") ) return;
    me->set_temp( "looking_for_trouble", 1 );

    // This call_out gives victim a chance to slip trough the fierce guys.
    call_out( "start_" + type, 0, me, obj );
}

void start_berserk(object me, object obj)
{
    int bellicosity;

    if ( !me || !obj )
		return;
                               
	// Are we still exist( not becoming a corpse )?

    me->set_temp("looking_for_trouble", 0);

    if ( me->is_fighting(obj) || 		// Are we busy fighting?
		 !living(me) ||                 // Are we capable for a fight?
         environment(me) != environment(obj) || // Are we still in same room?
         environment(me)->query("no_fight") )   // Are we in a peace room?
   	{ 
		return;
	}

    bellicosity = (int)me->query("bellicosity");
    message_vision("$N用一种异样的眼神扫视著在场的每一个人。\n", me);

    if ( (int)me->query("force") >
		 (random(bellicosity) + bellicosity)/2 )
	{
		return;
	}

    if ( bellicosity > (int)me->query("score") && !wizardp(obj) )
	{
        message_vision( "$N对著$n喝道：" + RANK_D->query_self_rude(me) +
			"看你实在很不顺眼，去死吧。\n", me, obj );
        me->kill_ob(obj);
    }
	else
	{
        message_vision( "$N对著$n喝道：喂！" + RANK_D->query_rude(obj) +
			"，" + RANK_D->query_self_rude(me) + 
			"正想找人打架，陪我玩两手吧！\n", me, obj );
        me->fight_ob(obj);
    }
}

void start_hatred(object me, object obj)
{
    if ( !me || !obj ) return;                               

	// Are we still exist( not becoming a corpse )?

    me->set_temp("looking_for_trouble", 0);

    if ( me->is_fighting(obj) || 		// Are we busy fighting?
		 !living(me) ||                 // Are we capable for a fight?
         environment(me) != environment(obj) || // Are we still in same room?
         environment(me)->query("no_fight") )   // Are we in a peace room?
   	{ 
		return;
	}

    // We found our hatred! Charge!
    message_vision( catch_hunt_msg[random(sizeof(catch_hunt_msg))],
		me, obj );
    me->kill_ob(obj);
}

void start_vendetta(object me, object obj)
{
    if ( !me || !obj ) return;                               

	// Are we still exist( not becoming a corpse )?

    me->set_temp("looking_for_trouble", 0);

    if ( me->is_fighting(obj) || 		// Are we busy fighting?
		 !living(me) ||                 // Are we capable for a fight?
         environment(me) != environment(obj) || // Are we still in same room?
         environment(me)->query("no_fight") )   // Are we in a peace room?
   	{ 
		return;
	}

    // We found our vendetta opponent! Charge!
    me->kill_ob(obj);
}

void start_aggressive(object me, object obj)
{
    if ( !me || !obj ) return;                               

	// Are we still exist( not becoming a corpse )?

    me->set_temp("looking_for_trouble", 0);

    if ( me->is_fighting(obj) || 		// Are we busy fighting?
		 !living(me) ||                 // Are we capable for a fight?
         environment(me) != environment(obj) || // Are we still in same room?
         environment(me)->query("no_fight") )   // Are we in a peace room?
   	{ 
		return;
	}

    // We got a nice victim! Kill him/her/it!!!
    me->kill_ob(obj);
}

// This function is to announce the special events of the combat.
// This should be moved to another daemon in the future.
void announce(object ob, string event)
{
    switch(event)
	{
    case "dead":
        message_vision("\n$N死了。\n\n", ob);
        break;

    case "unconcious":
		message_vision("\n$N脚下一个不稳，跌在地上一动也不动了。\n\n", ob);
        break;

    case "revive":
        message_vision("\n$N慢慢睁开眼睛，清醒了过来。\n\n", ob);
        break;
    }
}

///////////////////////////////////////////////////////////////////////////
// Internal Functions

// 面对敌人的进攻, 我是否要反击
// 我想如果是 busy 中，反击就不太可能了吧
private int make_fanji_decide( object me, int type )
{
    int gong, fang, temp;

    if ( me->is_busy() ) return DECIDE_DEFENSE;

    gong = me->query_gongfang();
    fang = 100 - gong;

    switch ( type )
    {
    case AT_NORMAL:
        temp = gong - fang * 2;
        if ( temp < 0 ) temp = 0;
        else if ( temp > 100 ) temp = 100;
        if ( random( 100 ) < temp )
            return DECIDE_FANJI;
        break;

    case AT_FANJI:
        temp = gong * 15 / 10 - fang;
        if ( temp < 0 ) temp = 0;
        else if ( temp > 100 ) temp = 100;
        if ( random( 100 ) < temp )
            return DECIDE_FANJI;
        break;

    case AT_FANGFAN:
    // 这种状态应该是 me 处于 busy 时，所以我看应该执行不到这儿的
    case AT_QUICK:
        return DECIDE_DEFENSE;

    default:
        error( sprintf( "D_COMBAT: 进攻类型错误, type = %d\n", type ) );
    }
    return DECIDE_DEFENSE;
}

// 面对敌人的进攻, 我是招架还是躲闪
private int make_defense_decide( int ap, int pp, int dp )
{
    int temp;

	temp = 6 * pp / 5;
	if (( ap < temp ) || ( ap >= temp ) && ( 10 * dp < 9 * pp ))
        return DECIDE_PARRY;
    return DECIDE_DODGE; 
}

private int make_attack_decide( object me )
{
    int attack, sen_ratio, guarding = 0, cor, temp;

    // 体能小于 15%, 我看还是别攻击的好
    sen_ratio = me->query_char_ratio( "sen" );
    if ( sen_ratio <= 15 ) return 0; 

    attack = me->query_gongfang();
    if ( me->query_temp( "guarding" ) >= 3 ) guarding = 1;
    cor = me->query_cor();
    temp = attack*35/50 + sen_ratio*35/100 + guarding*10 + cor*20/20;
#ifdef DEBUG
    message_vision( sprintf( "***** 攻击决定因子是 %d *****\n", temp ), me );
#endif
    if (( temp >= 100 ) || ( random( 100 ) + 1 < temp ))
        return 1;
    return 0;
}

// 这里的 dp 是指 defense power, 而前面的是指 dodge power
private int can_hit_enemy( int ap, int dp )
{
    if ( random( ap + dp ) < dp )
        return 0;
    return 1;
}

private int attack_reward( object me, int ap, int dp )
{
    string attack_skill;
    object skill;
    int bonus, amount, fight_type;

    if ( ap * 10 < 11 * dp )
    {
        attack_skill = me->query_temp( "attack_skill" );
        skill = load_object( SKILL_D( attack_skill ) );
        bonus = me->query_xiuwei_jibie( skill->query_xiuwei_type() )
                    - skill->query_dengji() + 2;

        fight_type = get_fight_type( me );

        // 如果该player使用一高于他修为的武功去战斗，由于修为没到
        // 就算打中也是瞎猫遇到死耗子，无法对该武功有真正的理解。
        if ( bonus <= 0 && random( 100 * ( 1 - bonus ) ) == 0 )
            bonus = 1;
        if ( bonus <= 0 ) return 0;
        if ( 2 * dp >=  3 * ap ) amount = ( 2 + fight_type ) * bonus;
        else if ( dp >= ap ) amount = ( 1 + fight_type ) * bonus;
        else amount = fight_type * bonus;

        // 实力比影响奖励多少
        amount = amount * me->query_shili() / 100;
        bonus = bonus * me->query_shili() / 100;

        if ( !skill->is_native_skill() )
            me->improve_jilei( attack_skill, amount );
        me->add( "combat_exp", skill->query_dengji() );
#ifdef DEBUG
        debug += sprintf( "%s可以获得%d, %d点攻击奖励.\n",
            me->name(), amount, skill->query_dengj());
#endif
        return 1;
    }
    return 0;
}

private int parry_reward( object me, int ap, int dp )
{
    string parry_skill;
    object skill;
    int amount, bonus, fight_type;

    if ( ap * 10 > 9 * dp )
    {
        parry_skill = me->query_temp( "parry_skill" );
        skill = load_object( SKILL_D( parry_skill ) );

        bonus = me->query_xiuwei_jibie( skill->query_xiuwei_type() )
                    - skill->query_dengji() + 2;

        fight_type = get_fight_type( me );

        // 如果该player使用一高于他修为的武功去战斗，由于修为没到
        // 就算打中也是瞎猫遇到死耗子，无法对该武功有真正的理解。
        if ( bonus <= 0 && random( 100 * ( 1 - bonus ) ) == 0 )
            bonus = 1;
        if ( bonus <= 0 ) return 0;
        if ( 2 * ap >=  3 * dp ) amount = ( 2 + fight_type ) * bonus;
        else if ( ap >= dp ) amount = ( 1 + fight_type ) * bonus;
        else amount = fight_type * bonus;

        // 实力比影响奖励多少
        amount = amount * me->query_shili() / 100;
        bonus = bonus * me->query_shili() / 100;

        if ( !skill->is_native_skill() )
            me->improve_jilei( parry_skill, amount );
        me->add( "combat_exp", skill->query_dengji() );
#ifdef DEBUG
        debug += sprintf( "%s可以获得%d, %d点招架奖励.\n",
            me->name(), amount, skill->query_dengji() );
#endif
        return 1;
    }
    return 0;
}

private int dodge_reward( object me, int ap, int dp )
{
    string dodge_skill;
    object skill;
    int amount, bonus, fight_type;

    if ( ap * 10 > 9 * dp )
    {
        dodge_skill = me->query_temp( "dodge_skill" );
        skill = load_object( SKILL_D( dodge_skill ) );

        bonus = me->query_xiuwei_jibie( skill->query_xiuwei_type() )
                    - skill->query_dengji() + 2;

        fight_type = get_fight_type( me );

        // 如果该player使用一高于他修为的武功去战斗，由于修为没到
        // 就算打中也是瞎猫遇到死耗子，无法对该武功有真正的理解。
        if ( bonus <= 0 && random( 100 * ( 1 - bonus ) ) == 0 )
            bonus = 1;
        if ( bonus <= 0 ) return 0;
        if ( 2 * ap >=  3 * dp ) amount = ( 2 + fight_type ) * bonus;
        else if ( ap >= dp ) amount = ( 1 + fight_type ) * bonus;
        else amount = fight_type * bonus;

        // 实力比影响奖励多少
        amount = amount * me->query_shili() / 100;
        bonus = bonus * me->query_shili() / 100;

        if ( !SKILL_D( dodge_skill )->is_native_skill() )
            me->improve_jilei( dodge_skill, amount );
        me->add( "combat_exp", skill->query_dengji() );
#ifdef DEBUG
        debug += sprintf( "%s可以获得%d, %d点躲闪奖励.\n",
            me->name(), amount, skill->query_dengji() );
#endif
        return 1;
    }
    return 0;
}
//7/21/97 2:45AM: Edit by Lin,Leonhart,Peacock,Lnwm.
/*
  damage是有一下因素造成的： 
    str,skill的action["damage"],apply/damage,
  wound的伤害因素有： 
    apply/wound, str, action["wound"],hit_ob(),
*/
private mapping make_damage( string msg, object me, object you, mapping action )
{
    int damage, wound, force_factor;
    mapping my;
    string skill;
    object my_weapon;
    mixed foo;
    mapping result = ([]);

    // 对练是设计是不会造成 damage 的, 但由于我们在 damage
    // 为 0 时有防守反击设计, 所以我只好给 damage 为 1 了。
    if ( me->is_duilianing( you ) )
    {
        you->receive_damage( "kee", 1 );
#ifdef DEBUG
    debug += sprintf( "%s受到1点damage\n", you->name() );
    debug += sprintf( "%s受到0点wound\n" , you->name() );
#endif
        result["damage"] = 1;
        result["msg"] = msg;
        return result;
    }

    my = me->query_entire_dbase();
    my_weapon = me->query_temp("weapon");
    force_factor = (int)my["force_factor"];

    // 基本的damage由攻击者的膂力和apply/damage(!!)造成
    damage = ( me->query_str()- force_factor ) / 2 + me->query_temp("apply/damage");
    //招式中给出的damage项
    if ( action[ "damage" ] )
        damage += action[ "damage" ] * damage / 100;
    damage = (damage + random(damage)) / 2;
    
    // 基本的wound由apply/wound(!!)决定
    wound = me->query_temp("apply/wound");
    // 所用skill中带来的招式本身的damage.
    if ( action[ "wound" ] )
        wound += action[ "wound" ] * wound / 100;
    wound = (wound + random(wound)) / 2;
    // 由各种hit_ob引起的wound.
    if ( force_factor && (my["force"] > force_factor) )
    {
        skill = me->query_wugong( "force" );
        if ( stringp( skill ) )
        {
            foo = SKILL_D( skill )->hit_ob( me, you,
                            wound, force_factor);
            if ( stringp( foo ) )
                msg += foo;
            else if ( intp( foo ) )
                wound += foo;
        }
        else me->add("force", -force_factor);
    }

    skill = me->query_temp( "attack_skill" );
    if ( skill )
    {
        foo = SKILL_D( skill )->hit_ob( me, you, wound );
        if ( stringp( foo ) )
            msg += foo;
        else if ( intp( foo ) )
            wound += foo;
    }

    if ( objectp( my_weapon ) )
    {
        foo = my_weapon->hit_ob( me, you, wound );
        if ( stringp( foo ) )
            msg += foo;
        else if ( intp( foo ) )
            wound += foo;
    }
    else
    {
        foo = me->hit_ob( me, you, wound );
        if ( stringp( foo ) )
            msg += foo;
        else if ( intp( foo ) )
            wound += foo;
    }

    if ( action["wound"] || my_weapon ) wound += force_factor / 2;
    else damage += force_factor / 2;

    damage += wound;

    you->receive_damage( "kee", damage );
    if ( (wound -= me->query_temp("apply/armor")) < 0 ) wound = 0;
    you->receive_wound("kee",wound, me );
    //利用一个函数将原来分开的damage和wound 一次完成。
#ifdef DEBUG
    debug += sprintf( "%s受到%d点damage\n", you->name(), damage );
    debug += sprintf( "%s受到%d点wound\n", you->name(), wound );
#endif
    result["damage"] = damage;
    result["wound"] = wound;
    result["msg"] = msg;
    return result;
}

private string replace_limb( object enemy, mapping action, string result )
{
    string limb, *limbs;

    if ( stringp( action[ "limb" ] ) )
        limb = action[ "limb" ];
    else
    {
        limbs = enemy->query("limbs");
        limb = limbs[ random( sizeof( limbs ) ) ];
    }
    result = replace_string( result, "$l", limb );
    return result;
}

private varargs string replace_weapon( string result,
                       object me,
                       object you,
                       mapping my_action,
                       mapping your_action )
{
    object my_weapon, your_weapon;

    my_weapon = me->query_temp( "weapon" );
    your_weapon = you->query_temp( "weapon" );
    if ( objectp( my_weapon ) )
        result = replace_string( result, "$w", my_weapon->name() );
    else if ( mapp( my_action ) && stringp( my_action[ "weapon" ] ) )
        result = replace_string( result, "$w", my_action[ "weapon" ] );
    if ( objectp( your_weapon ) )
        result = replace_string( result, "$v", your_weapon->name() );
    else if ( mapp( your_action ) && stringp( your_action[ "weapon" ] ) )
        result = replace_string( result, "$v", your_action[ "weapon" ] );
    return result;
}

private string jiaohuan_daci( string result )
{
    result = replace_string( result, "$N", "$T" );
    result = replace_string( result, "$n", "$N" );
    result = replace_string( result, "$T", "$n" );
    result = replace_string( result, "$P", "$T" );
    result = replace_string( result, "$p", "$P" );
    result = replace_string( result, "$T", "$p" );

    //为什么要replace_string $w $v ? trill
    //$w是自己的武器 $v是敌人的武器
    
    result = replace_string( result, "$w", "$v" );
    return result;
}

private void after_hit_enemy( object me, object you )
{
    string my_id, your_id;

    my_id = me->query( "id" );
    your_id = you->query( "id" );
    if ( you->is_busy() )
        you->interrupt_me( me );
    if ( me->is_duilianing( you ) ) return;
    if ( ( !me->is_killing( your_id ) ) &&
         ( !you->is_killing( my_id ) ) )
    {
        if ( me->is_bihuaing( your_id ) )
        {
            if ( you->query_char_ratio( "kee" ) < 20 )
                REWARD_D->bihua_reward( me, you ); //by nerd
            else if ( you->query_char_ratio( "sen" ) >= 20 ) 
            {
                return;
            }
            me->remove_bihua( you );
            you->remove_bihua( me );
        }
        // by nerd
        else
            REWARD_D->fight_reward( me, you );
        me->remove_enemy( you );
        you->remove_enemy( me );
        message_vision( get_winner_msg(), me, you );
    }
}

// me 是进攻者, you 是防守者, action 是我的进攻动作, result 是信息串,
// type 表示我的攻击是正常进攻或反击
// 防守反击的效果只有这种情况才可能出现
private void defend_action( object me,
                    object you,
                    mapping action,
                    string result,
                    int type )
{
    mapping dodge_action,damage_result;
    string parry_msg, debug;
    string attack_skill, parry_skill, dodge_skill;
    object my_weapon;
    int ap, dp, pp, damage = 0, wounded = 0;
    int my_sen_cost = 0, your_sen_cost = 0;

    dodge_action = you->select_dodge_action();
    my_weapon = me->query_temp( "weapon" );
    parry_msg = you->select_parry_action( my_weapon );

    attack_skill = me->query_temp( "attack_skill" );
    ap = wugong_power( me, attack_skill, TYPE_ATTACK );
    dodge_skill = you->query_temp( "dodge_skill" );
    dp = wugong_power( you, dodge_skill, TYPE_DODGE );
    parry_skill = you->query_temp( "parry_skill" );
    pp = wugong_power( you, parry_skill, TYPE_PARRY );
#ifdef DEBUG
    debug = sprintf( "%s(%s) ap %d, %s(%s) dp %d, pp %d\n", me->name(),me->query_temp( "attack_skill" ) , ap,
        you->name(), you->query_temp( "parry_skill" ), dp, pp );
    message_vision(debug, me, you);
#endif
    
    my_sen_cost = random( 3 ) + 1;
    if ( intp( action[ "sen" ] ) )
        my_sen_cost += action[ "sen" ]; 
    if ( make_defense_decide( ap, dp, pp ) == TYPE_PARRY )
    {
        your_sen_cost = 1;
        // 暂时这样定, parry 消耗的 sen 是 attacker sen 的 1/3 - 2/3
        your_sen_cost += ( action[ "sen" ] + random( action[ "sen" ] ) ) / 3;
        // pp 受 attack action 的影响, 由于下面不使用 pp 了, 所以直接
        // 改变 pp , 如果以后后面要使用, 这样再用个中间变量吧.
        if ( intp( action[ "parry" ] ) )
            pp = pp * ( 100 - action[ "parry" ] ) / 100;
        if ( can_hit_enemy( ap, pp ) )
        {
            result += get_parry_fail_msg();
            attack_reward( me, ap, pp );
            damage_result = make_damage( result, me, you, action );
            damage = damage_result["damage"];
            wounded = damage_result["wound"];
            result = damage_result["msg"];
            //加下面这个是因为可能上面的result值可能为空
            if ( stringp(result) )
                result += damage_msg( damage, action[ "damage_type" ] );
            else
                result = damage_msg( damage, action[ "damage_type" ] );
        }
        else
        {
            result += parry_msg + "\n";
            parry_reward( you, ap, pp );
        }
    }
    else
    {
        your_sen_cost = random( 1 ) + 1;
        your_sen_cost += ( action[ "sen" ] + random( action[ "sen" ] ) ) / 3;
        if ( intp( action[ "dodge" ] ) )
            dp = dp * ( 100 - action[ "dodge" ] ) / 100;
        if ( can_hit_enemy( ap, dp ) )
        {
            result += get_dodge_fail_msg();
            pp /= 2;
            if ( intp( action[ "parry" ] ) )
                pp = pp * ( 100 - action[ "parry" ] ) / 100;
            if ( pp < 1 ) pp = 1;
            if ( can_hit_enemy( ap, pp ) )
            {
                attack_reward( me, ap, pp );
                damage_result = make_damage( result, me, you, action );
                damage = damage_result["damage"];
                wounded = damage_result["wound"];
                result = damage_result["msg"] || "";
                result += damage_msg( damage, action[ "damage_type" ] );
            }
            else
            {
                your_sen_cost += 2;
                result += get_second_parry_msg() + parry_msg;
                parry_reward( you, ap, pp );
            }
        }
        else
        {
            result += dodge_action[ "action" ] + "\n";
            dodge_reward( you, ap, dp );
        }
    }
    me->receive_damage( "sen", my_sen_cost );
    you->receive_damage( "sen", your_sen_cost );

    // 后效函数, 暂时没有使用
    //if ( functionp( action[ "post_action" ] ) )
    //    evaluate( action[ "post_action" ], me, you, damage );

    result = replace_limb( you, action, result );
    result = replace_weapon( result, me, you, action );

    //message_vision( result, me, you );
    combat_message( result, me, you );
#ifdef DEBUG
    message_vision( debug, me, you );
#endif
    if ( damage > 0 )
    {
        report_status( you, wounded );
        after_hit_enemy( me, you );
    }
    else if (( type == AT_NORMAL ) && you->query_temp( "guarding" ))
    {
        you->set_temp( "guarding", 0 );
        //message_vision( get_fangfan_msg(), me, you );
        combat_message( get_fangfan_msg(), me, you );
        fight_control( you, me, AT_FANGFAN );
    }
}

// me 是进攻者, you 是反击者.
private void duel_attack( object me,
                  object you,
                  mapping attack_action,
                  mapping fanji_action,
                  string result )
{
    // 双方的 dodge 都除 2, 是否对原来的进攻方不公平
    mapping my_dodge, your_dodge, damage_result;
    int my_ap, my_dp, your_ap, your_dp;
    int me_wounded = 0, you_wounded = 0;
    int my_sen_cost = 0, your_sen_cost = 0;
    int my_damage, your_damage;
    string temp;

    my_dodge = me->select_dodge_action();
    your_dodge = you->select_dodge_action();

    my_ap = wugong_power( me, me->query_temp( "attack_skill" ), TYPE_ATTACK );
    my_dp = wugong_power( me, me->query_temp( "dodge_skill" ), TYPE_DODGE );
    your_ap = wugong_power( you, you->query_temp( "attack_skill" ), TYPE_ATTACK );
    your_dp = wugong_power( you, you->query_temp( "dodge_skill" ), TYPE_DODGE );
#ifdef DEBUG
    debug += sprintf( "%s ap %d, dp %d, %s ap %d, pp %d\n",
        me->name(), my_ap, my_dp, you->name(), your_dp, your_dp );
#endif

    my_sen_cost = random( 3 ) + 1;    
    if ( intp( attack_action[ "sen" ] ) )
        my_sen_cost += attack_action[ "sen" ]; 
    your_sen_cost = random( 3 ) + 1;    
    if ( intp( fanji_action[ "sen" ] ) )
        your_sen_cost += fanji_action[ "sen" ]; 

    if ( intp( attack_action[ "dodge" ] ) )
        your_dp = your_dp * ( 100 - attack_action[ "dodge" ] ) / 100;
    if ( can_hit_enemy( my_ap, your_dp ) )
    {
        result += get_dodge_fail_msg();
        attack_reward( me, my_ap, your_dp );
        damage_result = make_damage( result, me, you, attack_action );
        your_damage = damage_result["damage"];
        you_wounded = damage_result["wound"];
        result = damage_result["msg"] || "";
        result += damage_msg( your_damage, attack_action[ "damage_type" ] );
    }
    else
    {
        your_sen_cost += random( 1 ) + 1;
        result += your_dodge[ "action" ] + "\n";
        dodge_reward( you, my_ap, your_dp );
    }
    result = replace_limb( you, attack_action, result );
    //result = replace_weapon( me, you, attack_action, result );

    if ( intp( fanji_action[ "dodge" ] ) )
        my_dp = my_dp * ( 100 - fanji_action[ "dodge" ] ) / 100;
    if ( can_hit_enemy( your_ap, my_dp ) )
    {
        temp = get_dodge_fail_msg();
        attack_reward( you, your_ap, my_dp );
        damage_result = make_damage( temp, you, me, fanji_action );
        my_damage = damage_result["damage"];
        me_wounded = damage_result["wound"];
        temp = damage_result["msg"] || "";
        temp += damage_msg( my_damage, fanji_action[ "damage_type" ] );
    }
    else
    {
        my_sen_cost += random( 1 ) + 1;
        temp = my_dodge[ "action" ] + "\n";
        dodge_reward( me, your_ap, my_dp );
    }
    result += jiaohuan_daci( temp );
    result = replace_limb( me, fanji_action, result );
    result = replace_weapon( result, me, you, attack_action, fanji_action );

    me->receive_damage( "sen", my_sen_cost );
    you->receive_damage( "sen", your_sen_cost );

    //message_vision( result, me, you );
    combat_message( result, me, you );
#ifdef DEBUG
    message_vision( debug, me, you );
#endif
    if ( my_damage > 0 )
    {
        report_status( me, me_wounded );
        after_hit_enemy( you, me );
    }
    if ( your_damage > 0 )
    {
        report_status( you, you_wounded );
        after_hit_enemy( me, you );
    }
}

// 在 /cmds/std/look.c 里调用, 所以不能是 private 的
string eff_status_msg(int ratio)
{
    if ( ratio == 100 )
		return HIG "看起来气血充盈，并没有受伤。" NOR;
    if ( ratio > 95 )
		return HIG "似乎受了点轻伤，不过光从外表看不大出来。" NOR;
    if ( ratio > 90 )
		return HIY "看起来可能受了点轻伤。" NOR;
    if ( ratio > 80 )
		return HIY "受了几处伤，不过似乎并不碍事。" NOR;
    if ( ratio > 60 )
		return HIY "受伤不轻，看起来状况并不太好。" NOR;
    if ( ratio > 40 )
		return HIR "气息粗重，动作开始散乱，看来所受的伤著实不轻。" NOR;
    if ( ratio > 30 )
		return HIR "已经伤痕累累，正在勉力支撑著不倒下去。" NOR;
    if ( ratio > 20 )
		return HIR "受了相当重的伤，只怕会有生命危险。" NOR;
    if ( ratio > 10 )
		return RED "伤重之下已经难以支撑，眼看就要倒在地上。" NOR;
    if ( ratio > 5  )
		return RED "受伤过重，已经奄奄一息，命在旦夕了。" NOR;
    return RED "受伤过重，已经有如风中残烛，随时都可能断气。" NOR;
}

private string status_msg(int ratio)
{
    if ( ratio == 100 )
		return HIG "看起来充满活力，一点也不累。" NOR;
    if ( ratio > 95 )
		return HIG "似乎有些疲惫，但是仍然十分有活力。" NOR;
    if ( ratio > 90 )
		return HIY "看起来可能有些累了。" NOR;
    if ( ratio > 80 )
		return HIY "动作似乎开始有点不太灵光，但是仍然有条不紊。" NOR;
    if ( ratio > 60 )
		return HIY "气喘嘘嘘，看起来状况并不太好。" NOR;
    if ( ratio > 40 )
		return HIR "似乎十分疲惫，看来需要好好休息了。" NOR;
    if ( ratio > 30 )
		return HIR "已经一副头重脚轻的模样，正在勉力支撑著不倒下去。" NOR;
    if ( ratio > 20 )
		return HIR "看起来已经力不从心了。" NOR;
    if ( ratio > 10 )
		return RED "摇头晃脑、歪歪斜斜地站都站不稳，眼看就要倒在地上。" NOR;
    return RED "已经陷入半昏迷状态，随时都可能摔倒晕去。" NOR;
}

private varargs void report_status(object ob, int effective)
{
    int kee, max_kee, eff_kee;

    kee = ob->query( "kee" );
    eff_kee = ob->query( "eff_kee" );
    max_kee = ob->query( "max_kee" );
    if ( effective ) 
        message_vision( "( $N" +
			eff_status_msg( eff_kee * 100 / max_kee ) + " )\n", ob );
    else
        message_vision( "( $N" +
			status_msg( kee * 100 / max_kee ) + " )\n", ob );
}

private string damage_msg(int damage, string type)
{
    string str;

    if ( damage == 0 ) return "";
	//	return "被$p轻描淡写将其化开。\n";

    switch( type )
	{
    case "砍伤":
    case "割伤":
        if ( damage < 10 )
			return "只是轻轻地划破$p一层肉皮。\n";
        else if ( damage < 20 )
			return "$w在$p$l划出一道血肉模糊的伤痕。\n";
        else if ( damage < 40 )
			return "「嗤」地一声，$n的$l被划出一道深达寸许的伤口！\n";
        else if ( damage < 80 )
			return "$P$w一划而过，在$p身上留下一条鲜血淋淋的伤口！\n";
        else if ( damage < 160 )
			return "「嗤」。。。$p的$l被$w生生拉出一道又长又深的伤口！\n";
        else if ( damage < 300 )
			return "「嗤」地一声划出一道又长又深的伤口，溅得$N满脸鲜血！\n";
        else
			return "只听见$n一声惨嚎，$w已在$p$l划出一道深及见骨的可怕伤口！！\n";
        break;

    case "刺伤":
        if ( damage < 10 )
            return "只是轻轻地刺破$p的皮肉。\n";
        else if ( damage < 20 )
            return "在$p$l刺出一个不大的伤口。\n";
        else if ( damage < 40 )
            return "「噗」地一声，$w刺入了$n$l寸许！\n";
        else if ( damage < 80 )
            return "「噗」地一声$N手中$w刺进$n的$l，使$p不由自主地退了几步！\n";
        else if ( damage < 160 )
            return "「噗嗤」一声，$w已在$p$l刺出一个血肉沫糊的血窟窿！\n";
        else if ( damage < 300 )
            return "$P把$w力刺而入$n$l，深可及柄！\n";
        else
            return "只听见$n一声惨嚎，$w已在$p的$l对穿而出，鲜血溅得满地！！\n";
        break;

    case "瘀伤":
        if ( damage < 10 )
			return "只是轻轻地碰到$n$l，比拍苍蝇稍微重了点。\n";
        else if ( damage < 20 )
			return "在$p的$l造成一处瘀青。\n";
        else if ( damage < 40 )
			return "$P一击命中，$n的$l顿时肿了一块老高！\n";
        else if ( damage < 80 )
			return "$N用力一击，正中$n$l，$p闷哼了一声，退了两步！\n";
        else if ( damage < 120 )
			return "「砰」地一声，打得$n退开三步，显然是吃了不小的亏！\n";
        else if ( damage < 160 )
			return "这一下狠狠击中$l，$p连退了好几步，差一点摔倒！\n";
        else if ( damage < 240 )
			return "$P这一击重重地击中$n$l，$p「哇」地一声吐出一口鲜血！\n";
        else if ( damage < 360 )
			return "$N全力对正$p$l一击，打得$n口中鲜血狂喷而出！\n";
        else
			return "只听见「砰」地一声巨响，$n像一捆稻草般飞了出去！！\n";
        break;

    default:
        if ( !type )
			type = "伤害";
        if ( damage < 10 )
			str =  "只是在$n$l勉强造成一处轻微";
        else if ( damage < 20 )
			str = "造成$p轻微的";
        else if ( damage < 30 )
			str = "在$n的$l造成一处";
        else if ( damage < 50 )
			str = "给$p的$l造成一处严重";
        else if ( damage < 80 )
			str = "造成$n颇为严重的";
        else if ( damage < 120 )
			str = "在$n$l造成相当严重的";
        else if ( damage < 170 )
			str = "造成$n十分严重的";
        else if ( damage < 230 )
			str = "给$p造成极其严重的";
        else
			str = "在$n的$l造成非常可怕的严重";
        return str + type + "！\n";
    }
}

private int get_fight_type( object me )
{
    // 对练给 1, 其他暂时都给 2. 以后可以扩展
    if ( me->is_duilianing() )
        return 1;
    else
        return 2;
}

