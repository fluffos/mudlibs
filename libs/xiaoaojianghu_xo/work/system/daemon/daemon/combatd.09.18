#undef DEBUG

// 这些以后移到 combat.h 里面去
#define TYPE_ATTACK		0
#define TYPE_DODGE		1
#define TYPE_PARRY		2

// 攻击的类型
#define AT_NORMAL       0
#define AT_FANJI        1
#define AT_FANGFAN      2
#define AT_QUICK        3

// 我们的决定
#define DECIDE_FANJI    0
#define DECIDE_DEFENSE  1
#define DECIDE_DODGE    2
#define DECIDE_PARRY    3

inherit F_DBASE;

