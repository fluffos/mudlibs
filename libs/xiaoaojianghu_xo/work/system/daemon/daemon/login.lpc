// Filename : /system/daemon/logind.c

#include <ansi.h>
#include <command.h>
#include <login.h>
#include <options.h>
#include <register.h>
#include "include/login.h"

inherit F_DBASE;

int wiz_lock_level = WIZ_LOCK_LEVEL;
int startup_time;

string *start_rooms =
({
    "/d/city/lanzhou/kezhan",
    "/d/city/dali/jiulou",
    "/d/city/yangzhou/keyu",
});

void create() 
{
    seteuid(getuid());
    set("channel_id", "连线精灵");
    startup_time = time();
}

void logon(object ob)
{
    int player_count = 0;
    int t, d, h, m, s;
    string time;

    if ( time() - startup_time < NO_LOGIN_LIMIT_TIME )
    {
        printf( YEL"对不起，为了系统稳定，请在系统起动 %d 秒后再登录。\n" NOR
            , NO_LOGIN_LIMIT_TIME );
        destruct( ob );
        return;
    }

    switch ( REGISTER_D->CheckUserIp( query_ip_number( ob ) ) )
    {
    case BANNED_IP :
        write( "你的IP在笑傲江湖中不受欢迎，如果有问题请给\n" +
            "zhc@bjnet.edu.cn\n发 email 询问。\n" );
        destruct( ob );
        break;
    case WORNING_MESSAGE_IP :
        cat(WELCOME);
        write( @TEXT
    你来的 Ip 已经有玩家在线了，如果这个 IP 需要多重登录，请给
            zhc@bjnet.edu.cn
    发 email 注册。或者在 XO bbs sysop 板声明。
    我们保留一段时间的注册期，过期将禁止多重登录。
TEXT );
        break;
    case BANISH_IP :
        write( "笑傲江湖禁止多重登录！。\n" );
        destruct( ob );
        break;
    case COMMON_IP :
    case REGISTED_IP :
        cat(WELCOME);
        break;
    }

    if ( wiz_lock_level > 0 )
    {
        write(RED "           >>> 本ＭＵＤ暂时关闭，只有巫师等级" +
            chinese_number( wiz_lock_level )+ "的玩家可以连线。 <<<\n" NOR );
    }

    t = uptime();
    s = t % 60; t /= 60;
    m = t % 60; t /= 60;
    h = t % 24; t /= 24;
    d = t;

    if ( d )
        time = chinese_number(d) + "天";
    else
        time = "";

    if ( h )
        time += chinese_number(h) + "小时";
    if ( m )
        time += chinese_number(m) + "分";
    if ( time == "" )
        write( mud_name() + "刚起动" + "，");
    else
        printf( mud_name() + "已经运行了" + time + "，");

    foreach( object player in users() )
    {
        if ( environment( player ) )
            player_count ++;
    }
    printf(HIR "目前共有 %d 位玩家在这个世界中。\n\n", player_count );

    write(CYN "您的英文名字：" NOR);
    input_to( "GetIdentify" , ob );
}

private void GetIdentify( string arg, object ob )
{
    string identify = lower_case( arg );

    if ( !objectp( ob ) || ( string )ob->set( "id", identify )
        != identify )
    {
        error( "login object error." );
        destruct( ob );
        return;
    }
    switch ( REGISTER_D->CheckUserId( identify ) )
    {
    case ILLEGAL_ID :
        write( CYN "你的 Id 只能是由 3 到 12 英文字母组成。\n" NOR );
        write( CYN "请重新输入你的英文名字：" NOR );
        input_to( "GetIdentify", ob );
        break;
    case OVERLOAD_ID :
        write( "笑傲江湖现在的玩家太多，请过几分钟再来。\n" );
        destruct( ob );
        break;
    case NEWBIE_ID :
        write(YEL "使用 " + (string)ob->query("id") +
	    	" 这个名字将会在笑傲江湖中创造一个新的生命，\n您确定吗(y/n)？" NOR);
        input_to("confirm_id", ob);
        break;
    case WIZARD_ID :
        if ( ob->restore() )
        {
            write( BLU "请输入您的密码：" NOR );
            input_to("get_passwd", 1, ob);
        }
        else
        {
            write( YEL"你的数据出了问题，赶快告诉 falcon 吧。\n"NOR);
            destruct(ob);
        }
        break;
    case COMMON_ID :
        if ( wiz_level( identify ) < wiz_lock_level
            && !ALLOW_D->is_allowed( identify ) )
    	{
            write( RED "对不起，" + MUD_NAME + "目前限制巫师等级 "
                + wiz_lock_level + " 以上的人才能连线。\n" NOR );
            destruct(ob);
        }
        else if ( ob->restore() )
        {
            write(BLU "请输入您的密码：" NOR);
            input_to("get_passwd", 1, ob);
        }
        else
        {
            write(YEL"你的 login 数据出了问题，请利用 guest 登录通知巫师。\n"NOR);
            destruct(ob);
        }
        break;
    case GUEST_ID :
        write( "欢迎来笑傲江湖作客！\n" );
        confirm_id("Yes", ob);
        break;
    case QUITED_ID :
        write( "你刚从笑傲江湖中退出，请过3分钟重新登录。\n" );
        destruct( ob );
        break;
    case BANNED_ID :
        write( "这个 id 暂时被禁止使用, 若有疑问请 mail 给 \n"
               + "            zhc@bjnet.edu.cn\n" 
               + "或者在 XO bbs 的 sysop 版询问.  \n" );
        destruct( ob );
        break;
    }
}

private void get_passwd(string pass, object ob)
{
    string my_pass, msg;
    object user;

    write("\n");
    my_pass = ob->query("password");
    if ( crypt(pass, my_pass) != my_pass )
	{
        if ( wiz_level( ob->query("id") ) )
        {
            msg = sprintf("%s error login at %s from %s\n",
                ob->query("id"), ctime(time()), query_ip_number( ob ) );
            log_file( WIZ_LOGIN_ERR_LOG, msg );
        }
        write("密码错误！\n");
        destruct(ob);
        return;
    }

    // Check if we are already playing.
    user = find_body( ob->query("id") );
    if ( user )
	{
        if ( user->query_temp("netdead") )
		{
            reconnect(ob, user);
            return;
        }
		write(YEL"您要将另一个连线中的相同人物赶出去，取而代之吗？(y/n)"NOR);
        input_to("confirm_relogin", ob, user);
        return;
    }

    user = make_body(ob);
    if ( objectp(user) )
	{
        if ( user->restore() )
		{
            log_login( ob, user, "%s(%s) loggined from %s (%s)\n" );
            enter_world( ob,user);
            return;
        }
		else
		{
            write(YEL"您的角色存盘数据出了问题，请利用 guest 通知神仙处理。\n"NOR);
            destruct(user);
        }
    }
    write(HIW "请您重新创造这个人物。\n" NOR);
    confirm_id("y", ob);
}

private void confirm_relogin(string yn, object ob, object user)
{
    object old_link;

    if ( yn == "" )
	{
		write(YEL "您要将另一个连线中的相同人物赶出去，取而代之吗？(y/n)" NOR);
        input_to("confirm_relogin", ob, user);
        return;
    }       

    if ( yn[0] != 'y' && yn[0] != 'Y' )
	{
        write("好吧，欢迎下次再来。\n");
        destruct(ob);
        return;
    }
	else
	{
        tell_object(user,HIW "有人从别处( " + query_ip_number(ob)
        	+ " )连线取代你所控制的人物。\n" NOR);
        log_login( ob, user, "%s(%s) replaced by %s (%s)\n" );
    }

    // Kick out tho old player.
    old_link = user->query_temp("link_ob");
    if ( old_link )
	{
        exec(old_link, user);
        destruct(old_link);
    }

    reconnect(ob, user);    
}

private void confirm_id(string yn, object ob)
{
    if ( yn == "" )
	{
        write(YEL "使用这个名字将会在笑傲江湖中创造一个新的生命，您确定吗(y/n)？" NOR );
        input_to("confirm_id", ob);
        return;
    }       

    if ( yn[0] != 'y' && yn[0] != 'Y' )
	{
        write(HIW "好吧，那麽请重新输入您的英文名字：" NOR);
        input_to("get_id", ob);
        return;
    }
    write( "如果你是一个新手，请用 help 指令来获取帮助。特别\n"
           + "你可以输入 help newbie 来阅读新手入门。\n" );

    write(MAG @TEXT

    那么请您为您即将在XO MUD里使用的新生命起一个中文名字吧!!您
可以用这个名字赋予他（她）与众不同的个性和气质。要注意，您起的
名字不要太古怪，不要金庸小说里人物的名字，更不要取一些不雅或容
易造成他人困惑的名字，否则XO将视情况要求你修改你的名字。
TEXT);
    write( HIR"    名字一旦输入就终生不能再自行修改，请务必慎重。\n\n" NOR);
    write(HIW "您的中文名字：" NOR);
    input_to("get_name", ob);
}

private void get_name(string arg, object ob)
{
    switch ( REGISTER_D->CheckUserName( arg ) )
    {
    case ILLEGAL_NAME :
        write( HIW " 请重新输入你的名字: " NOR );
        input_to( "get_name", ob );
        break;
    case BANNED_NAME :
        write("对不起，这种名字会造成其他人的困扰。\n");
        input_to( "get_name", ob );
        break;
    case COMMON_NAME :
        ob->set("name", arg);
        write(HIW "请设定您的密码：" NOR);
        input_to("new_password", 1, ob);
        break;
    }
}

private void new_password(string pass, object ob)
{
    write("\n");
    if ( strlen(pass) < 6 )
	{
        write(HIY "密码的长度至少要六个字符，请重设您的密码：" NOR);
        input_to("new_password", 1, ob);
        return;
    }
    ob->set("password", crypt(pass,0) );
    write(HIW "请再输入一次您的密码，以确认您没记错：" NOR);
    input_to("confirm_password", 1, ob);
}

private void confirm_password(string pass, object ob)
{
    string old_pass;

    write("\n");
    old_pass = ob->query("password");
    if ( crypt(pass, old_pass) != old_pass )
	{
        write(HIW "您两次输入的密码并不一样，请重新设定一次密码：" NOR);
        input_to("new_password", 1, ob);
        return;
    }

    write(HIW "您的电子邮件地址：" NOR);
    input_to("get_email",  ob);
}

private void get_email(string email, object ob)
{
    object user;

    ob->set("email", email);

    // If you want do race stuff, ask player to choose one here, then you can
    // set the user's body after the question is answered. The following are
    // options for player's body, so we clone a body here.
    ob->set("body", USER_OB);
    user = make_body(ob);
    if ( !objectp( user ) )
        return;

    write(HIW "您要扮演男性(m)的角色或女性(f)的角色？" NOR);
    input_to("get_gender", ob, user);
}

private void get_gender(string gender, object ob, object user)
{
    if ( gender == "" )
	{
        write(YEL "您要扮演男性(m)的角色或女性(f)的角色？" NOR);
        input_to("get_gender", ob, user);
        return;
    }

    if ( gender[0] == 'm' || gender[0] == 'M' )
        user->set("gender", "男性");
    else if ( gender[0] == 'f' || gender[0] == 'F' )
        user->set("gender", "女性" );
    else
	{
        write(YEL "对不起，您只能选择男性(m)或女性(f)的角色：" NOR);
        input_to("get_gender", ob, user);
        return;
    }

    log_login( ob, user, "%s(%s) was created from %s (%s)\n" );
    init_new_player(user);
    enter_world(ob,user);
}

object make_body(object ob)
{
    string err;
    object user;
    int n;

    user = new(ob->query("body"));
    if (!user)
	{
		write("现在可能有人正在修改使用者对象的程序，无法进行复制。\n");
        write(err+"\n");
        return 0;
    }
    seteuid(ob->query("id"));
    export_uid(user);
    export_uid(ob);
    seteuid(getuid());
    user->set("id", ob->query("id"));
    user->set_name( ob->query("name"), ({ ob->query("id")}) );
    return user;
}

private void init_new_player(object user)
{
    user->set("title", "普通百姓");
    user->set("birthday", time() );

    user->set("str", 10 + new_random());
    user->set("cps", 10 + new_random());
    user->set("int", 10 + new_random());
    user->set("cor", 10 + new_random());
    user->set("con", 10 + new_random());
    user->set("spi", 10 + new_random());
    user->set("per", 10 + new_random());
    user->set("kar", 10 + new_random());
    user->set("dex", 10 + new_random());

    user->set("food", ((int)user->query("str")+10)*10);
    user->set("water",((int)user->query("str")+10)*10);

    user->set("channels", ({ "chat", "rumor", "family" }) );
    user->set("max_age", select_max_age( user ) );
}

varargs void enter_world(object ob, object user, int silent)
{
    object cloth, room;
    string startroom, temp;

    user->set_temp("link_ob", ob);
    ob->set_temp("body_ob", user);
    exec(user, ob);

    write("目前权限：" + wizhood(user) + "\n");
    user->setup();

    // In case of new player, we save them here right aftre setup 
    // compeleted.
    user->save();
    ob->save();
    user->set("last_save_time",time());// autosave requires.

    cloth = new(CLOTH_DIR + "cloth1");
    cloth->move(user);
    cloth->wear();

    if ( !silent )
	{
        cat(MOTD);
        if ( wizardp(user))
        {
              cat(SYSTEM_CONFIG_DIR "wizmotd");
        }
        if ( user->is_ghost() && !wizardp(user) )
            startroom = DEATH_ROOM;
        else if ( !stringp(startroom = user->query("startroom")) )
        {
            startroom = select_start_room();
            rm( LOG_D->query_log_file( user->query("id") ) );
            LOG_D->do_log( user, sprintf("你充满传奇色彩的一生就从%s开始。", 
                load_object( startroom )->query("short") ));
        }

        if ( catch(load_object(startroom)) )
		{
            startroom = select_start_room();
            user->set("startroom", startroom);
        }
        user->move(startroom);
        MARRY_D->check_will_marry( user );
        MARRY_D->check_marriage( user );        
        tell_room(startroom, user->query("name") + 
			"连线进入这个世界。\n", ({user}));
    }

    CHANNEL_D->do_channel( this_object(), "sys",
        sprintf("%s(%s)由%s连线进入。", user->name(), geteuid(user),query_ip_name(user)) );
		
    UPDATE_D->check_user(user);
}

varargs void reconnect(object ob, object user, int silent)
{
    switch ( REGISTER_D->CheckUserIp( query_ip_name( user ) ) )
    {
    case WORNING_MESSAGE_IP :
        write( @TEXT
    你来的 Ip 已经有玩家在线了，如果这个 IP 需要多重登录，请给
            zhc@bjnet.edu.cn
    发 email 注册。或者在 XO bbs sysop 板声明。
    我们保留一段时间的注册期，过期将禁止多重登录。
TEXT );
        break;
    case BANISH_IP :
        write( "笑傲江湖禁止多重登录！。\n" );
        user->set_temp("link_ob", ob);
        ob->set_temp("body_ob", user);
        exec(user, ob);
        user->reconnect();
        "/cmds/comm/quit"->main( user, "" );
        break;
    }

    user->set_temp("link_ob", ob);
    ob->set_temp("body_ob", user);
    exec(user, ob);

    user->reconnect();
    if ( !silent )
	{
        tell_room(environment(user), user->query("name") + 
			"重新连线回到这个世界。\n", ({user}));
    }
    CHANNEL_D->do_channel( this_object(), "sys",
    	sprintf("%s(%s)由%s重新连线进入。", user->query("name"), 
		geteuid(user), query_ip_name(user)) );
    UPDATE_D->check_user(user);
}

object find_body(string name)
{
    object ob, *body;

    ob = find_player(name);
    if ( objectp(ob) ) return ob;
    body = children(USER_OB);
    for ( int i = 0; i < sizeof( body ); i++ )
        if ( clonep( body[ i ] ) && getuid(body[i]) == name )
			return body[i];

    return 0;
}

int set_wizlock(int level)
{
    if ( wiz_level(this_player(1)) <= level )
        return 0;
    if ( geteuid(previous_object()) != ROOT_UID )
        return 0;
    wiz_lock_level = level;
    return 1;
}
 
private string select_start_room()
{
    return start_rooms[ random( sizeof( start_rooms ) ) ];
}

private void log_login( object ob, object user, string format )
{
    if ( wiz_level( user->query("id") ) )
    {
        log_file( WIZ_USAGE_LOG, sprintf( format,
            user->query("id"), user->query("name"),
            query_ip_name(ob), ctime(time()) ) );
    }
    else
    {
        log_file( PPL_USAGE_LOG, sprintf( format,
            user->query("id"), user->query("name"), 
            query_ip_name(ob), ctime(time()) ) );
    }
}

int select_max_age(object user)
{
    int max_age;
    int per, Int, spi, con;

    per = user->query( "per" );
    Int = user->query( "int" );
    spi = user->query( "spi" );
    con = user->query( "con" );
    max_age = BASE_MAX_AGE + new_random();
    max_age -= ( per - 20 ) / 3 + ( Int - 20 ) / 3 + ( spi - 20 ) / 3;
    max_age += con / 6;
    return max_age;
}

