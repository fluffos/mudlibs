// 汴京daemon:     capitald.c
/*
 用途：在城市中接受由ROOM或NPC提出的调用请求，根据这些 
 请求来决定各种不同的反应。 
 设想：一个城市作为一个整体应该有些指数，比如安定系数， 
 人口指数，商业值，军队化程度等等。在游戏运行过程中， 
 daemon将对这些数值进行探查，并根据这些实时进行反应。 
 同时，将对由NPC 和ROOM提出的各种请求进行反应，比如围捕 
 玩家，商店开业，酒店关门，城门的开闭，某个区域的开与关， 
 NPC 的不同反应等等。 
*/

inherit F_DBASE;
inherit F_SAVE;

#include <localtime.h>

//  下面的东西将是这次新作的，回去加在家里的capitald.c里。
void Setup();
void report( string str );

//////////////////////////////////////////////////////////////////////


void create()
{
    set("name","汴京城防总部");
    set("id","capitald");
    Setup();
}
void Setup()
{
    remove_call_out("Reset");
    call_out( "Reset" , 30 );
    return;
}

void Reset()
{
    string taget;
    mixed localtime = NATURE_D->game_time(1);
    //  用来实现第二种功能。
    //  检查data，完成将要产生的反应。
    taget = "/d/city/capital/nanx_men";
    if( ( localtime[ LT_HOUR ] > 18 || localtime[ LT_HOUR ] < 5 ) &&
        taget->query("exits/north" ) )
    {
        taget->delete("exits/north");
        tell_room( taget, "城门关了。\n" );
    }
    if( ( localtime[ LT_HOUR ] < 18 && localtime[ LT_HOUR ] > 5 ) &&
        !taget->query("exits/north" ) )
    {
        taget->set("exits/north","/d/city/capital/yujie9" );
        tell_room( taget, "城门开了.\n" );
    }
    report( "now the time is " + (string)time() );
    report( "                " + NATURE_D->game_time() );
    call_out( "Reset", 30 );
    return;
}

void report( string str )
{
    object ob;
    if( !ob = LOGIN_D->find_body( "lin" ) )
        return;
    tell_object( ob, str + "\n" );
    return;
}