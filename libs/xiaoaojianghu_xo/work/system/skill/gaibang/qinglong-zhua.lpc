// qinglong-zhua.c
// 丐帮功夫：  青龙十三抓

inherit SKILL;

mapping *action = ({
        ([      "action":
"$N左掌微分，右手一长使出一招「毒龙扑舟」，抓向$n的$l",
                "lian" :
"$N左掌微分，右手一长使出一招「毒龙扑舟」，抓向半空中......",
                "jibie":8,
                "zhaoshi":"「毒龙扑舟」",
                "sen"  :2,
                "wound":              30,
                "damage_type":  "抓伤"
        ]),
        ([      "action":
"$N倏地一个转身，双手一翻，一招「撺锅手」直掼$n下颌....",
                "lian" :
"$N倏地一个转身，双手一翻，一招「撺锅手」直掼假想对手的下颌....",
                "jibie":16,
                "limb" : "下颌",
                "sen" :2,
                "zhaoshi":"「摔锅手」",
                "parry":                10,
                "wound":               20,
                "damage_type":  "瘀伤"
        ]),
        ([      "action":
"$N身子微斜，随即跨出一步，左手忽掌忽爪使出「撮灰手」，拍向$n的$l",
                "lian" :
"$N身子微斜，随即跨出一步，左手忽掌忽爪使出一招「撮灰手」来。",
                "jibie":                25,
                "zhaoshi":"「撮灰手」",
                "sen"  :3,
                "wound":               35,
                "damage_type":  "瘀伤"
        ]),
        ([      "action":
"$N使出「青蛇十段锦」，身子一纵，双手滑溜异常对准$n的后心抓去",
                "lian" :
"$N使出「青蛇十段锦」，身子一纵，跨步上前，身形右转，双手同时向右抓去...",
                "jibie":33,
                "zhaoshi":"「青蛇十段锦」",
                "sen":3,
                "limb":"后心",
                "dodge":                6,
                "wound":               45,
                "damage_type":  "抓伤"
        ]),
        ([      "action":
"$N左手虚晃，右掌飘飘，一招「梁上君子」击向$n$l",
                "lian":
"$N左手虚晃，右掌飘飘，一招「梁上君子」，出掌诡异，不知所至....",
                "jibie":40,
                "sen"  :3,
                "zhaoshi":"「梁上君子」",
                "parry":                10,
                "wound":                30,
                "damage_type":  "瘀伤"
        ]),
        ([      "action":
"$N使出「拨草寻履」，凌空跃起，冷不防在落地前对准$n$l踢出一脚",
                "lian":
"$N使出「拨草寻履」，凌空跃起，两脚空踢下方....",
                "jibie":50,
                "sen": 2,
                "zhaoshi":"「拨草寻履」",
                "dodge":                8,
                "wound":               40,
                "damage_type":  "瘀伤"
        ]),
        ([      "action":
"$N右手在$n$l划过，随後一招「随棍上身」左爪又向同一方位抓到",
                "lian":
"$N右手斜抓前方，随後一招「随棍上身」左爪又向同一方位抓到",
                "jibie":             60,
                "zhaoshi":"「随棍上身」",
                "sen" : 2,
                "parry":                0,
                "wound": 35,
                "damage_type":  "抓伤"
        ]),
});


string *parry_msg = ({
        "$n使出一招「青龙摆尾」，躲开了$N的$w。\n",
        "$n身形急转，有如泥鳅一般，登时将$N的$w躲开了。\n",
        "$n一招「龙游东海」，不战而走，向左急闪，同时右手翻出，攻向$N....\n",
});
string *unarmed_parry_msg = ({
        "$n使出一招「青龙摆尾」，躲开了$N的一击。\n",
        "$n身形急转，有如泥鳅一般，登时将$N的一击躲开了。\n",
        "$n一招「龙游东海」，不战而走，向左急闪，同时右手翻出，攻向$N....\n",
});
int valid_learn(object me)
{
        return 1;
}

int valid_lian( object me )
{
        object weapon;
        if( (int)me->query("max_force") < 80 )
                return notify_fail("你的内力太弱，无法练青龙十三抓。\n");

        weapon = me->query_temp( "weapon" );
    if ( weapon)
        return notify_fail("你必须先把手中的兵刃放下。\n");

        return 1;
}

mapping query_action(int jibie)
{
        int i, size;

        size = sizeof( action );
        for ( i = 0; i < sizeof( action ); i++ )
                if ( action[ i ][ "jibie" ] > jibie )
                {
                        size = i;
                        break;
                }
    return action[ random( size ) ];
}


string query_parry_msg(object weapon)
{   
    if ( objectp( weapon ) )
        return parry_msg[random(sizeof(parry_msg))];
    else
        return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_xiuwei_type()
{
        return "unarmed";
}

// 返回这路武功的等级, 第十等返回0, 第一等返回9.
int query_dengji()
{
        return 2;
}

string query_zhaoshi( int jibie )
{
    int i;
    for ( i = 0; i < sizeof(action); i++ )
    {
        if ( action[ i ][ "jibie" ] >= jibie )
            return action[ i ][ "zhaoshi" ];
    }

    return "";
}
             
int query_youxiao_jibie() { return 12; }

int query_parry_ratio() { return 6 ; }

