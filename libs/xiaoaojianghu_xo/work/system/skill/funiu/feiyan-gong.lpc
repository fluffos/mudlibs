// Dodge : feiyan-gong 飞燕功
// by lin

inherit SKILL;

mapping *action = ({
    ([  "action" : "$n身形微晃，一式「飞燕迎朝霞」，身子登时飞掠向右，跃出数尺。",
        "lian"   : "$n身形微晃，一式「飞燕迎朝霞」，身子登时飞掠向右，跃出数尺。",
        "jibie"  : 10,
        "sen"    :  5, 
        "zhaoshi": "「飞燕迎朝霞」",
    ]),
    ([  "action" : "$n心中存想，双脚轻点，一式「雨中剪尾」，身子急速拔高，避开了$N的攻势。",
        "lian"   : "$n双脚一点地面，一式「雨中剪尾」身形急拔而起。",
        "jibie"  : 20,
        "sen"    :  4, 
        "zhaoshi": "「雨中剪尾」",
    ]),
    ([  "action" : "$n一招「乳燕投林」，身子轻飘飘地向一旁掠出，犹如在风里飘动一般。",
        "lian"   : "$n一招「乳燕投林」，身子轻飘飘地向一旁掠出，犹如在风里飘动一般。",
        "jibie"  : 30,
        "sen"    :  5, 
        "zhaoshi": "「乳燕投林」",
    ]),
    ([  "action" : "$n突然身子一矮，伏下身去，一招「燕子穿帘」身子紧贴地面，避开了$N的攻势。",
        "lian"   : "$n突然身形一矮，一式「燕子穿帘」，身子轻轻飘开。",
        "jibie"  : 40,
        "sen"    :  5, 
        "zhaoshi": "「燕子穿帘」",
    ]),
    ([  "action" : "$n轻松地一拂袖子，一招「燕灵上九天」，身形急转，令$N一阵眼花缭乱。",
        "lian"   : "$n轻松地一拂袖子，一招「燕灵上九天」，身形急转，令人一阵眼花缭乱。",
        "jibie"  : 50,
        "sen"    :  4, 
        "zhaoshi": "「燕灵上九天」",
    ]),
    ([  "action" : "$n身影飞转，一式「冲贯九霄」，身子急拔起有丈许高，一个转身轻轻地落在数丈之外。",
        "lian"   : "$n身影飞转，一式「冲贯九霄」，身子急拔起有丈许高，一个转身轻轻地落在数丈之外。",
        "jibie"  : 60,
        "sen"    :  6, 
        "zhaoshi": "「冲贯九霄」",
    ]),
});

int valid_learn(object me)
{
    return 1;
}

int valid_lian( object me )
{
    return 1;
}

mapping query_action(int jibie)
{
    int i, size;

    size = sizeof( action );
    for ( i = 0; i < sizeof( action ); i++ )
        if ( action[ i ][ "jibie" ] > jibie )
            {
                size = i;
                break;
            }
    return action[ random( size ) ];
}

string query_xiuwei_type() { return "dodge"; }

int query_dengji() { return 3; }

string *query_lian()
{
    string *lian_msg;
    mapping lian_act;

    lian_msg = allocate( sizeof( action ) );
    for ( int i = 0; i < sizeof( action ); i++ )
    {
        lian_act = action[ i ];
        lian_msg[ i ] = (string)lian_act[ "lian" ];
    }
    return lian_msg;
}




