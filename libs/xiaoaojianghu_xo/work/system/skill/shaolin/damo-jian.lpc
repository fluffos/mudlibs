string *parry_msg = ({
        "$n一式「如露亦如电」，飘身而退，顺势挥出一剑，铮的一声将$w荡了开去",
        "$n$v一顿，发出一声龙吟般的清啸，剑芒吞吐，剑势不定，令$N不敢轻试",
        "$n真气贯注剑身，一式「水月通禅寂」，手中$v寂然挥出\n"
        "$N之觉得手中$w一滞，不自主的向$v贴了上去，却无半丝声响发出\n"
        "$N猛提一口真气，震腕一挣，方得以吧$w收了回来",
        "$n右手$v剑芒陡然一暗，左手剑诀疾点$N手中$w，两下一碰竟发出铮的一记金铁交鸣之声",
        "却见$n横剑当胸之下，脸上神光湛然，方圆数尺之内竟找不处一线$w可以挥入的缝隙",
});


string *unarmed_parry_msg =({
        "$n一式「世事多纷扰」，手中$v微微一颤，幻作千万道流光，布下层层剑幕",
        "$n使出一式「如梦幻泡影」，手中$v欲进还退，欲抑还扬，有意无意间向$N手腕截去",
        "$n一式「如露亦如电」，飘身而退，顺势一剑抹向$N的小臂",
        "$n左手剑诀一扬，迎向$N来势点出。$N惊觉这一指竟带着森森剑气，连忙缩手不迭",
    "$N分明见$n收剑当胸，却觉得$n身边方原数尺之内，密布着无数把寒光闪闪的长剑，\n"
    "修说是拳脚，便是一蝇一羽也难加诸其上！",
});
int valid_learn(object me)
{    
    if ( (int)me->query("max_force") < 150 )
                return notify_fail("你的内力不够，强练达摩剑法有损无益。\n");

        return 1;
}

int valid_lian( object me )
{
        object weapon;

        weapon = me->query_temp( "weapon" );
    if ( !weapon || (string)weapon->query("skill_type") != "sword" )
        return notify_fail("你必须先找一把剑才能练剑法。\n");

        return valid_learn(me);
}

mapping query_action(int jibie)
{
    int i, size;

    size = sizeof( action );
    for ( i = 0; i < sizeof( action ); i++ )
        if ( action[ i ][ "jibie" ] > jibie )
        {
            size = i;
            break;
        }
    return action[ random( size ) ];
}

string query_parry_msg(object weapon)
{
    if ( weapon )
        return parry_msg[random(sizeof(parry_msg))];
    else
        return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_xiuwei_type() { return "sword"; }
string query_weapon_type() { return "sword"; }

int query_dengji() { return 4; }

int query_youxiao_jibie() { return 10; }

int query_parry_ratio() { return 15; }

int hit_ob(object me,object you,int extra_damage)
{
        int e_kee,kee;
        
        if ( me->query("env/unkill") && (you->query("eff_kee")<0) ) 
                {
        you->set("eff_kee",0);
                return -extra_damage;
                }
    return 0;
}

