        "dodge"  : 30,
        "jibie"  : 40,
        "sen"    : 10,
        "damage_type" : "淤伤",
    ]),
    ([  "action" : "$N左脚一点，右脚腾起跃进，一式「心寂欲除」，将$n罩在掌风之下",
        "lian"   : "$N左脚一点，右脚腾起跃进，一式「心寂欲除」，掌力所至，花败草衰，不禁有得意感。",
        "zhaoshi":"「心寂欲除」",
        "damage" : 90,
        "parry"  : 40,
        "dodge"  : 0,
        "jibie"  : 40,
        "sen"    : 10,
        "damage_type" : "淤伤",
    ]),
    ([  "action" : "$N左脚向後偷步，身体向右微转，左手缓缓推出，击向$n的$l，\n"
                   "又忽地身形一转，右手从袖中急拍而出，后力十足，乃是一招「转重令轻」",
        "lian"   : "$N左脚向後偷步，身体向右微转，左手缓缓推出，又忽地身形一转，\n"
                   "右手从袖中急拍而出，后力十足，乃是一招「转重令轻」",
        "zhaoshi":"「转重令轻」",
        "damage" : 60,
        "wound"  : 30,
        "parry"  : 30,
        "dodge"  : 20,
        "jibie"  : 30,
        "sen"    : 11,
        "damage_type" : "淤伤",
    ])
});

string * parry_msg=({
    "$n身体向后微微仰倒，一式「无著得道」顺势右拳收腰、左手封掌护胸，档开了$N这一击。",
    "$n右掌拉回，立掌护住左肩部位，接著收左拳向前直击而出，以攻为守，防开了对方的攻势。",
    "$n不退反进，一招「假真并观」，左腿上前一步，右手攻向$N的$l。",
});
    
string * unarmed_parry_msg=({
    "$n身体向后微微仰倒，一式「无著得道」顺势右拳收腰、左手封掌护胸，档开了$N这一击。",
    "$n右掌拉回，立掌护住左肩部位，接著收左拳向前直击而出，以攻为守，防开了对方的攻势。",
    "$n不退反进，一招「假真并观」，左腿上前一步，右手攻向$N的$l。",
});

int valid_learn(object me)
{
    if ( (int)me->query("max_force") < 850 )
        return notify_fail("你的内力不够，没有办法练拈花指。\n");
    if ( (int)me->query("yin") < 50)
        return notify_fail("拈花指必须配合以阴柔的内功，否则容易走火入魔。\n");
    return 1;
}

int valid_lian( object me )
{
    if( me->query_temp("weapon"))
        return notify_fail("你得先把手中的兵刃放下才能修习拈花指。\n");
    return valid_learn( me );
}

string query_xiuwei_type() { return "unarmed"; } 

string query_weapon_type() { return "unarmed" ; }

int query_dengji() { return 6; }

mapping query_action(int jibie)
{
        int i, size;

        size = sizeof( action );
        for ( i = 0; i < sizeof( action ); i++ )
                if ( action[ i ][ "jibie" ] > jibie )
                {
                        size = i;
                        break;
                }
    return action[ random( size ) ];
}

string query_parry_msg(object weapon)
{   
    if ( !weapon )
        return parry_msg[random(sizeof(parry_msg))];
    else
        return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi( int jibie )
{
    int i;
    for ( i = 0; i < sizeof(action); i++ )
    {
        if ( action[ i ][ "jibie" ] >= jibie )
            return action[ i ][ "zhaoshi" ];
    }
    return "";
}

int query_youxiao_jibie() { return 10; }

int query_parry_ratio() { return 12 ; }

