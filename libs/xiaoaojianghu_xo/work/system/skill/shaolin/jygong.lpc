inherit FORCE;

string query_xiuwei_type()
{ 
    return "force"; 
}

string *parry_msg = ({
    "$n双臂一震，内力游走全身，$N根本不可近身。\n",
    "$n长袖一甩，一股大力将$N送出丈外。\n",
    "$n凝聚内力，轻描淡写地化解了$N的攻势。 ÷n",
});

string *absorb_msg = ({
    "$n身体微蹲，双臂一张，浑厚的九阳神功游走全身。\n",
    "$n施展出九阳神功，浑身坚如寒铁。\n",
    "$n身型微展，九阳神功充斥了丈许空间。\n",
});

int valid_learn(object me)
{
        if ( me->query("gender") != "男性" )
                return notify_fail("你非童男之体，不能练习少林九阳神功。\n");

    if ( me->query_jibie("shaolin-neigong") < 90 )
        return notify_fail("你的少林基本内功还没有练好呢！\n");
        return 1;
}

int valid_lian(object me)
{
        return notify_fail("少林九阳功只能通过修炼或者是使用来增加领悟度。\n");
}

string exert_function_file(string func)
{
        return __DIR__"jygong/" + func;
}

int query_level() 
{ 
        return 4; 
}
string query_type()
{
     return "yang"; 
} 
string query_parry_msg(object weapon)
{
        return parry_msg[random(sizeof(parry_msg))];
}

string query_absorb_msg()
{
    return absorb_msg[random(sizeof(absorb_msg))];
}

