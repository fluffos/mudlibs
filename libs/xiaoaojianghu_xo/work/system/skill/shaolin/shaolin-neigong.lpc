// 少林内功

inherit FORCE;

string query_xiuwei_type(){ return "force"; }

int valid_learn(object me)
{
    if((int)me->query("PKS")>5&&(int)me->query_jibie("shaolin-neigong")>=40)
        return notify_fail("你杀人过多，无法领悟更高深的少林内功。\n");
    return 1;
}

int valid_lian(object me)
{
        return notify_fail("少林内功只能通过修炼或者是使用来增加领悟度。\n");
}

