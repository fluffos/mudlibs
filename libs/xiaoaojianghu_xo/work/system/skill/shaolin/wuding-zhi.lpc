inherit SKILL;

mapping *action = ({
        ([      "action":               
"$N指影交错，层层叠叠，一招「风吹玉宇」，一片指影罩向$n",
                "lian":
"$N指影交错，层层叠叠，一招 「风吹玉宇」，一片指影直罩下来",
                "zhaoshi":         "风吹玉宇",
                "dodge":                15,
                "sen":                  2,
                "jibie":                  0,
                "parry":                30,
                "force":                80,
                "damage":               50,
                "damage_type":  "刺伤",
                                   ]),
        ([      "action":               
"$N身形急转，指影千幻，一招「泉流太漩」，忽前忽後，封住了$n的所有攻势",
                "lian":
"$N身形急转，指影千幻，一招「泉流太漩」，忽前忽後，封了出去",
                "zhaoshi":         "泉流太漩",
                "dodge":                15,
                "parry":                50,
                "force":                90,
                "sen":                  3,
                "jibie":                  15,
                "damage":               70,
                "damage_type":  "刺伤",
                    ]),
        ([      "action":               
"$N身法稍顿，左手一扬使出「玉冰穿林」往$n的$l点去",
                "lian":
"$N身法稍顿，左手一扬使出「玉冰穿林」直点而出",
                "zhaoshi": "玉冰穿林",
                "dodge":                15,
                "sen":                  4,
                "parry":                30,
                "jibie":                  23,
                "force":                70,
                "damage":               80, 
                "damage_type":  "刺伤",
                       ]),
        ([      "action":               
"只见$N腰身一摆，陡然滑出数尺，右手顺著来势一招「飘姿所如」往$n攻去",
                "lian":
"只见$N腰身一摆，陡然滑出数尺，右手顺著来势一招「飘姿所如」攻了出去",
                "zhaoshi":   "飘姿所如",
                "sen":                  3,
                "jibie":                 35,
                "dodge":                10,
                "parry":                30,
                "force":                90,
                "damage":               70,
                "damage_type":  "刺伤",
                     ]),
  ([      "action":               
"$N无视$n攻势，身形微晃，一招「岩壑翠微」绕至$n身后，以攻为守，直点向$n",
                "lian":
"$N身形微晃，一招「岩壑翠微」直点出去",
                "zhaoshi":         "岩壑翠微",
                "dodge":                15,
                "sen":                   2,
                "jibie":                  50,
                "parry":                55,
                "force":                100,
                "damage":               90,
                "damage_type":  "刺伤",
                                   ]),
        ([      "action":               
"$N飞身跃起，一招「风吹绵邈」，一片指影向$n头顶罩下",
                "lian":
"$N飞身跃起，一招「风吹绵邈」，一片指影直罩而下",
                "zhaoshi":         "风吹绵邈", 
                "dodge":                20,
                "parry":                70,
                "force":                130,
                "sen":                  3,
                "jibie":                 70, 
                "damage":               130,
                "damage_type":  "刺伤",
                    ]),

});

string  *parry_msg=({
    "$n身形一跃而起，躲开$N攻势，同时一招「锡卓浸影」，幻出万千指影，罩向$N。",
    "$n身体往后一仰，险险避过$N的一击。",
    "$n镇定自若，一招「自动虚岩」，身形一侧，躲开了$N的这一击。",
});

int valid_learn(object me)
{
    if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
        return notify_fail("大智无定指必须空手。\n");
    return 1;
}

int valid_lian(object me)
{
    return valid_learn(me);
}

mapping query_action(int jibie)
{
    int i, size;
    size=sizeof(action);
    for (i=0;i<sizeof(action);i++)
    if(action[i]["jibie"]>jibie)
    {
        size=i;
        break;
    }
    return action[random(size)];       
}

string query_zhaoshi(int jibie)
{
    int i;
    for (i=0;i<sizeof(action);i++)
    {
        if(action[i]["jibie"]>=jibie)
        return action[i]["zhaoshi"];
    }
    return "";
}

string query_xiuwei_type()
{
    return "unarmed";
}

int query_dengji()
{
    return 6;
}

string query_parry_msg(object weapon)
{
    return parry_msg[random(sizeof(parry_msg))];
}

int query_youxiao_jibie()
{
    return 18;
}

int query_parry_ratio()
{
    return 14;
}


 




