// sanhua-zhang.c 散花掌 know 97/5/28

inherit SKILL;

mapping *action = ({/*size = 6*/
    ([  "action": "$N身形微动，一式「自在天宫」，右掌虚晃，左掌已向$n拍去",
        "lian"  : "$N身形微动，有如杨柳迎风一般，右掌一晃，左掌奋力拍出",
        "zhaoshi":"「自在天宫」",
        "limb"  :"小腹",
        "jibie" : 6,   
        "sen"   : 5,
        "dodge" :10,
        "parry" :10,
        "damage":45,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N身形前倾，正是散花掌之「七宝合成」，双掌合十却向$n的$l捣出",
        "lian"  : "$N身形前倾，正是散花掌之「七宝合成」，双掌合十向前捣出",
        "zhaoshi":"「七宝合成」",
        "jibie" :14,   
        "sen"   :5,
        "dodge" :10,
        "parry" :20,
        "damage":50,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N使出散花掌「佛敕大殊」，步下一错，散出一溜人影，同时攻向$n$l",
        "lian"  : "$N使出散花掌「佛敕大殊」，步下一错，散出一溜人影，同时出掌攻击",
        "zhaoshi":"「佛敕大殊」",
        "jibie" :26, 
        "sen"   : 6,
        "dodge" :20,
        "parry" :10,
        "damage":40,
        "wound" :15,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N使出「无量亿劫」，身形不动，掌势却飘忽不定，捺向四面八方",
        "lian"  : "$N使出「无量亿劫」，身形虽不动，掌势却飘向四面八方",  
        "zhaoshi":"「无量亿劫」",
        "jibie" :45,
        "sen"   : 7,
        "dodge" :20,
        "parry" :15,
        "damage" :70,
        "wound"  : 10,
        "damage_type" : "瘀伤"
    ]),                    
    ([  "action":"$N行随意动，一式「白宝轮掌」拍出，顿时$n眼前无数掌影，令人匪疑所思！",
        "lian":"$N行随意动，一式「白宝轮掌」拍出，顿时飞出无数掌影，令人匪疑所思！",  
        "zhaoshi":"「白宝轮掌」",
        "jibie" :69,
        "sen"   : 8,
        "dodge" :30,
        "parry" :20,
        "damage" :50,
        "wound"  :20,
        "damage_type" : "瘀伤"
    ]),                    
    ([  "action": "但见$N凌空跃起，使出「天女散花」，满天之中竞是无数掌影，潇洒挥出，宛如天成",
        "lian"  : "但见$N凌空跃起，使出「天女散花」，满天之中竞是无数掌影，潇洒挥出，宛如天成",
        "zhaoshi":"「天女散花」",
        "jibie" :35, 
        "sen"   : 6,
        "dodge" :30,
        "parry" :30,
        "damage":50,
        "wound" :25,
        "damage_type" : "瘀伤"
    ]),
});

string *parry_msg = ({ /* size = 5*/
    "$n不退不让，使出散花掌「七宝合成」，双掌合十，硬接$N的来势。\n",
    "$n身形动处已是一招「自在天宫」，飞身跃起，反守而功逼得$N退出三步！\n",
    "$n一招「无量亿劫」，左掌当胸，右掌拍出，以退为进。\n",
    "$n一招「天女散花」，身随意走，恰恰让过$N的攻势。\n",
    "$n使出「佛敕大殊」，身体后跃数丈，将将让开$N的攻势。\n",
    "$n游走于$N的拳风掌影之间，如漫步在花雨中，流露出一种说不出的潇洒。\n", 
});

string *unarmed_parry_msg = ({ /* size = 5*/
    "$n不退不让，使出散花掌「七宝合成」，双掌合十，硬接$N的来势。\n",
    "$n身形动处已是一招「自在天宫」，飞身跃起，反守而功逼得$N退出三步！\n",
    "$n一招「无量亿劫」，左掌当胸，右掌拍出，以退为进。\n",
    "$n一招「天女散花」，身随意走，恰恰让过$N的攻势。\n",
    "$n使出「佛敕大殊」，身体后跃数丈，将将让开$N的攻势。\n",
    "$n施展「维摩不染」的步法，衣袂飘飘，冷若御风。\n"
    "任$N手中$w千般变化，偏就落在了空处。\n",    
});

int valid_learn(object me)
{
    if( (int)me->query("max_force") < 250 )
        return notify_fail("以你现在的内力练散花掌只能有损自身！\n");
    return 1;
}

int valid_lian( object me )
{
    if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
        return notify_fail("练掌法不能那兵器呀！\n");

    return 1;
}

string query_xiuwei_type() { return "unarmed";}

string query_weapon_type() { return "unarmed";}

mapping query_action(int jibie)
{
    int i, size;

    size = sizeof( action );
    for ( i = 0; i < sizeof( action ); i++ )
        if ( action[ i ][ "jibie" ] > jibie )
        {
            size = i;
            break;
        }
    return action[ random( size ) ];
}

string query_parry_msg(object weapon)
{   
    if ( weapon )
        return parry_msg[random(sizeof(parry_msg))];
    else
        return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi( int jibie )
{
    int i;
    for ( i = 0; i < sizeof(action); i++ )
    {
        if ( action[ i ][ "jibie" ] >= jibie )
            return action[ i ][ "zhaoshi" ];
    }
    return "";
}

int query_dengji() { return 4;}

int query_youxiao_jibie() { return 13; }

int query_parry_ratio() { return 10; }

string exert_action_file( string action )
{
    return EXERT_DIR + "sanhua-zhang/" + action;
}


