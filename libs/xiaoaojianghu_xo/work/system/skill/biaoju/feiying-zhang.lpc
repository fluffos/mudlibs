// feiying-zhang.c 飞莺掌
// by trill
// reedit by lin 97-7-29 1:49.

inherit SKILL;

mapping * action=({
    ([  "action"  : "$N连续上步，一式「流莺比邻」，双手左右分插，击向$n的$l",
        "lian"    : "$N连续上步，一式「流莺比邻」，双手左右分插，向前击出",
        "sen"     : 3,
        "jibie"   : 8,
        "dodge"   : 10,
        "damage"  : 60,
        "zhaoshi" : "「流莺比邻」",
        "damage_type":"淤伤"
    ]),
    ([  "action"  : "$N右脚虚点，全身左旋，一招「乘之愈往」，右掌猛地拍向$n的$l",
        "lian"    : "$N右脚虚点，全身左旋，一招「乘之愈往」，右掌猛地按出",
        "sen"     : 4,
        "jibie"   : 16,
        "dodge"   : 0,
        "parry"   : 10,
        "damage"  : 50,
        "zhaoshi" : "「乘之愈往」",
        "damage_type":"淤伤"
    ]),
    ([  "action"  : "$N双手大开大阖，宽打高举，使一招「蓬蓬远春」，双拳向$n的$l打去",
        "lian"    : "$N双手大开大阖，宽打高举，使一招「蓬蓬远春」，双拳发力击出",
        "sen"     : 3,
        "jibie"   : 24,
        "parry"   : 10,
        "damage"  : 80,
        "zhaoshi" : "「蓬蓬远春」",
        "damage_type":"淤伤"
    ]),
    ([  "action"  : "$N左掌划一半圈扬起，屈肘当胸，右掌一招「采采流水」斜斜拍向$n的$l",
        "lian"    : "$N左掌划一半圈扬起，屈肘当胸，右掌一招「采采流水」斜斜拍出",
        "sen"     : 3,
        "jibie"   : 32,
        "dodge"   : 0,
        "parry"   : 10,
        "damage"  : 60,
        "zhaoshi" : "「采采流水」",
        "damage_type":"淤伤"
    ]),
    ([  "action"  : "$N使一招「柳阴路曲」，上身前躬，双掌各划了个半圆，齐齐拍向$n的$l",
        "lian"    : "$N使一招「柳阴路曲」，上身前躬，双掌各划了个半圆，齐齐拍向$n的$l",
        "sen"     : 3,
        "jibie"   : 40,
        "dodge"   : 0,
        "parry"   : 10,
        "damage"  : 50,
        "zhaoshi" : "「柳阴路曲」",
        "damage_type":"淤伤"
    ]),
    ([  "action"  : "$N双掌划弧，一记「识之愈真」，左掌带起一股劲风，切向$n的$l",
        "lian"    : "$N双掌划弧，一记「识之愈真」，左掌带起一股劲风，切向空中",
        "sen"     : 4,
        "jibie"   : 48,
        "dodge"   : 10,
        "parry"   : 0,
        "damage"  : 40,
        "zhaoshi" : "「识之愈真」",
        "damage_type":"淤伤"
    ]),
    ([  "action"  : "$N施出「碧桃满树」，双掌掌出如风，同时按向$n头，胸，腹三处要害",
        "lian"    : "$N施出「碧桃满树」，双掌掌出如风，闪出数个掌影",
        "sen"     : 4,
        "jibie"   : 56,
        "dodge"   : 10,
        "parry"   : 0,
        "damage"  : 60,
        "zhaoshi" : "「碧桃满树」",
        "damage_type":"淤伤"
    ]),
    ([  "action"  : "$N左脚内扣，右腿曲坐，一式「与古为新」，双手齐齐按向$n的胸口",
        "lian"    : "$N左脚内扣，右腿曲坐，一式「与古为新」，双手齐齐按出",
        "sen"     : 3,
        "jibie"   : 70,
        "dodge"   : 10,
        "parry"   : 0,
        "limb"    : "前胸",
        "damage"  : 50,
        "zhaoshi" : "「与古为新」",
        "damage_type":"淤伤"
   ]),
});

string *parry_msg = ({
    "$n左掌划一半圈扬起，屈肘当胸，右掌一招「采采流水」架开$N的攻势。\n",
    "$n施出「碧桃满树」，双掌掌出如风，闪出数个掌影护住全身。\n",
    "$n使一招「柳阴路曲」，上身前躬，双掌各划了个半圆，封住了$N这招。\n",
});

int valid_learn(object me)
{
    return 1;
}

int valid_lian( object me )
{
    object weapon;

    weapon = me->query_temp( "weapon" );
    if ( weapon )
        return notify_fail("你必须空手练习\n");

    return 1;
}

string query_xiuwei_type() { return "unarmed"; }

int query_dengji()
{ 
    return 3;
}

mapping query_action(int jibie)
{
    int i, size;

    size = sizeof( action );
    for ( i = 0; i < sizeof( action ); i++ )
        if ( action[ i ][ "jibie" ] > jibie )
        {
            size = i;
            break;
        }
    return action[ random( size ) ];
}

string query_parry_msg(object weapon)
{
    return parry_msg[random(sizeof(parry_msg))];
}

string query_zhaoshi( int jibie )
{
    int i;
    for ( i = 0; i < sizeof(action); i++ )
    {
        if ( action[ i ][ "jibie" ] >= jibie )
            return action[ i ][ "zhaoshi" ];
    }
    return "";
}

int query_youxiao_jibie() { return 12; }

int query_parry_ratio() { return 8 ; }


