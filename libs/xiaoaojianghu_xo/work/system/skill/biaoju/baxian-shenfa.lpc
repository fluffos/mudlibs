//baxian-shenfa.c 八仙身法
//by trill
//reedit by lin 97-07-29

inherit SKILL;

mapping *action = ({
    ([  "action"  : "$n傲然一笑，身形急旋，扶摇至上，衣裾满天飘舞，使出一式「何仙姑提\n"
                    "篮散花」空中一折腰，一翻身悄然落在$N的身后。",
        "lian"    : "$N傲然一笑，身形急旋，扶摇至上，衣裾满天飘舞，使出一式「何仙姑提\n"
                    "篮散花」空中一折腰，一翻身悄然落地上。",
        "jibie"   : 10,
        "sen"     : 4,
        "zhaoshi" : "「何仙姑提篮散花」",]),
    ([  "action"  : "$n一提真气，身子急拔，使出一招「铁拐李遨游东海」，幻出数个身影，\n"
                    "$N不知哪是真哪是假，无从选择。",
        "lian"    : "$N一提真气，身子急拔，使出一招「铁拐李遨游东海」，幻出数个身影，",
        "jibie"   : 20,
        "sen"     : 4,
        "zhaoshi" : "「铁拐李遨游东海」", ]),
    ([  "action"  : "$n若酒醉一般，踉踉跄跄跨出三步，一式「张果老酒醉倒骑驴」闪开了$N\n"
                    "的攻势",
        "lian"    : "$N若酒醉一般，踉踉跄跄跨出三步，一式「张果老酒醉倒骑驴」向一侧闪开了",
        "jibie"   : 30,
        "sen"     : 5,
        "zhaoshi" : "「张果老酒醉倒骑驴」", ]),
    ([  "action"  : "$n大步向前，眼见就要撞上$N，一招「吕纯阳月下过洞庭」一拔身形，越\n"
                    "过$N的头顶，飘然落在$N的背后。",
        "lian"    : "$N大步向前，一招「吕纯阳月下过洞庭」一拔身形，跃其数丈高，飘然落在地面。",
        "jibie"   : 40,
        "sen"     : 5,
        "zhaoshi" : "「吕纯阳月下过洞庭」", ]),
    ([  "action"  : "$n悄然一笑，身形急旋，仿佛飞蝶戏花一般，一招「何仙姑嘻笑采山茶」绕\n"
                    "着$N游走，轻轻巧巧的避开了$N的攻势。",
        "lian"    : "$N悄然一笑，身形急旋，仿佛飞蝶戏花一般，一招「何仙姑嘻笑采山茶」满场游走。",
        "jibie"   : 50,
        "sen"     : 5,
        "zhaoshi" : "「何仙姑嘻笑采山茶」", ]),
});
int valid_learn(object me)
{
    if ( me->query( "family/family_name" ) != "蓬莱派" )
        return notify_fail( "八仙身法不传授给非蓬莱派的弟子。\n");

    return 1;
}

int valid_lian( object me )
{
        return 1;
}

mapping query_action(int jibie)
{
        int i, size;

        size = sizeof( action );
        for ( i = 0; i < sizeof( action ); i++ )
                if ( action[ i ][ "jibie" ] > jibie )
                {
                        size = i;
                        break;
                }
    return action[ random( size ) ];
}

string query_xiuwei_type()
{
        return "dodge";
}

// 返回这路武功的等级, 第十等返回0, 第一等返回9.
int query_dengji()
{
    return 4;
}

string *query_lian()
{
        string *lian_msg;
        mapping lian_act;

        lian_msg = allocate( sizeof( action ) );
        for ( int i = 0; i < sizeof( action ); i++ )
        {
                lian_act = action[ i ];
                lian_msg[ i ] = (string)lian_act[ "lian" ];
        }
        return lian_msg;
}


