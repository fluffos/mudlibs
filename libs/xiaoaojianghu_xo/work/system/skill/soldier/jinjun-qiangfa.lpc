//jinjun-qiangfa.c
//禁军枪法
inherit SKILL;

mapping *action = ({
  ([ "action":
    "$N将手中的$w一抖，全身力气都集中在双臂之上，挥动$w直刺$n的$l",
    "lian":
    "$N将手中的$w一抖，全身力气都集中在双臂之上，挥动$w直刺$n的$l",
    "jibie": 8,
    "sen": 2,
    "zhaoshi": "刺字诀",
    "dodge": 10,
    "parry": 10,
    "damage": 30,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N右手握住枪身,左手斜拿杆头,猛力回收,$w枪尖直打$n$l",
    "lian":
    "$N右手握住枪身,左手斜拿杆头,猛力回收,$w枪尖直打",
    "jibie": 16,
    "zhaoshi": "挥字诀",
    "sen": 2,
    "dodge": 10,
    "parry": 10,
    "damage": 25,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N倒转$w,持枪反打,枪身激起一阵劲风",
    "lian":
    "$N倒转$w,持枪反打,枪身激起一阵劲风",
    "zhaoshi": "反切诀",
    "jibie": 24,
    "sen": 2,
    "dodge": 20,
    "parry": 10,
    "damage": 35,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N一抖手中的$w,枪尖一沉，猛地向上挑起，直打$n$l",
    "lian":
    "$N一抖手中的$w,枪尖一沉，猛地向上挑起",
    "zhaoshi": "挑字诀",
    "jibie": 32,
    "sen": 2,
    "dodge": 10,
    "parry": 20,
    "damage": 40,
    "damage_type": "划伤",
  ]),
  ([ "action":
    "$N转身撤步,脚踩斜步,枪挥左肩斜刺向前",
    "lian":
    "$N转身撤步,脚踩斜步,枪挥左肩斜刺向前",
    "zhaoshi": "点字诀",
    "jibie": 40,
    "sen": 1,
    "dodge": 0,
    "parry": 0,
    "damage": 35,
    "damage_type": "瘀伤",
  ]),
});

string *parry_msg = ({
  "$n将手中的$w横揽在胸前，「当」的一声，将$N的$w挡开了\n",
  "$n$w抖成一团枪花，将$N的$w搅在其中....\n",
});

string *unarmed_parry_msg = ({
  "$n转身而退，避开$N的攻势，反手一招「回马枪」，反刺$N$l!\n",
});

int valid_learn(object me) {
  return 1;
}

int valid_lian(object me) {
  object weapon;

  weapon = me->query_temp("weapon");
  if (!weapon || weapon->query("weapon_type") != "qiang")
    return notify_fail("你必须用枪练枪法。\n");

  return 1;
}


string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}
mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_zhaoshi(int jibie) {
  int i;
  for (i = 0; i < sizeof(action); i++) {
    if (action[i]["jibie"] >= jibie)
      return action[i]["zhaoshi"];
  }
  return "";
}

string query_xiuwei_type() {
  return "long";
}

// 返回这路武功的等级, 第十等返回0, 第一等返回9.
int query_dengji() {
  return 2;
}

int query_youxiao_jibie() { return 12; }

int query_parry_ratio() { return 12; }


string query_weapon_type() {
  return "qiang";
}
