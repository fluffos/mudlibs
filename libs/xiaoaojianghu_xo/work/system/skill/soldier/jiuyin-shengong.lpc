// jiuyin-shengong.c
// 九阴神功

inherit FORCE;

string query_xiuwei_type(){ return "force"; }

int valid_learn(object me)
{
    if ( me->query("max_force") < 1500 )
        return notify_fail("你的内功修行还不够学习这门内功。\n");
    if ( me->query_xiuwei_by_type( "zonggang" ) < 3200 )
        return notify_fail("你的武学造诣还没有达到能够领会这门内功的地步。\n");
    return 1;
}

int valid_lian(object me)
{
    return notify_fail("九阴内功只能通过修炼或者是使用来增加领悟度。\n");
}
int query_level()
{
    return 10;//wa!!!!!!
}

string query_type()
{
    return "yin";
}

int valid_xiulian( object me )
{
    return 1;
}
int query_zhuyan() 
{ 
    return 1;
}



