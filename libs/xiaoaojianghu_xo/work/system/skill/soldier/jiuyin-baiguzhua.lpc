string *parry_msg = ({
    "$n使出“四两拨千斤之术，轻轻地用手一挥，一股内力登时将$N的$w带偏",
    "$n身影一晃，竟似生出三头六臂一般，$N的眼前全是$n的身影，竟不知如何下手才是",
    "$n身子急转，使出一股柔和的力量绕在身周，$N的$w一碰上，登时象砍上了一块滑溜\n"
  "的鱼皮，滑了开去",
    "$n五指似铁，竟抢上来将$N的$w夹在两指之间，丝毫动弹不得",
});

string *unarmed_parry_msg = ({
    "$n使出“四两拨千斤之术，轻轻地用手一挥，一股内力登时将$N的手臂带偏",
    "$n身影一晃，竟似生出三头六臂一般，$N的眼前全是$n的身影，竟不知如何下手才是",
    "$n身子急转，使出一股柔和的力量绕在身周，$N一碰上，登时象砍上了一块滑溜\n"
  "的鱼皮，滑了开去",
    "$n五指似铁，竟抢上来将$N的双手夹在两指之间，丝毫动弹不得",
});


int valid_learn(object me)
{
    if( me->query("dex") < 20 )
        return notify_fail("你的身子太笨重了，还是练真经上所载的其他功夫吧。\n");
    if( me->query_xiuwei_by_type("unarmed") <= 5300 )
        return notify_fail("你的修为不足以学习这门功夫\n");
    if( me->query("max_force") < 2000 )
        return notify_fail("你的内力不够\n");
    if( me->query_lingwu("jiuyin-shengong") < 80 )
        return notify_fail("你真经领会的还不够透彻，不能学习这门功夫\n");
    return 1;
}

int valid_lian( object me )
{
    object weapon;
    weapon = me->query_temp( "weapon" );
    if ( weapon )
        return notify_fail("你必须空手.\n");
    if( me->query("dex") < 20 )
        return notify_fail("你的身子太笨重了，还是练真经上所载的其他功夫吧。\n");
    if( me->query_xiuwei_by_type("unarmed") <= 5300 )
        return notify_fail("你的修为不足以学习这门功夫\n");
    if( me->query("max_force") < 2000 )
        return notify_fail("你的内力不够\n");
    if( me->query_lingwu("jiuyin-shengong") < 80 )
        return notify_fail("你真经领会的还不够透彻，不能学习这门功夫\n");
    return 1;
    return 1;
}

mapping query_action(int jibie)
{
        int i, size;

        size = sizeof( action );
        for ( i = 0; i < sizeof( action ); i++ )
                if ( action[ i ][ "jibie" ] > jibie )
                {
                        size = i;
                        break;
                }
    return action[ random( size ) ];
}

string query_zhaoshi( int jibie )
{
    int i;
    for ( i = 0; i < sizeof(action); i++ )
    {
        if ( action[ i ][ "jibie" ] >= jibie )
            return action[ i ][ "zhaoshi" ];
    }
        return "";
}

string query_xiuwei_type()
{
        return "unarmed";
}

// 返回这路武功的等级, 第十等返回0, 第一等返回9.
int query_dengji()
{
        return 10;
}

string query_parry_msg(object weapon)
{
    if ( objectp( weapon ) )
        return parry_msg[random(sizeof(parry_msg))];
    else
        return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int query_youxiao_jibie()
{
    return 20;
}

int query_parry_ratio() 
{ 
    return 10; 
}

