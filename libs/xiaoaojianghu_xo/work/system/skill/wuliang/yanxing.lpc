int effective_level(){  return 10; }

string *query_lian()
{
        string *lian_msg;
        mapping lian_act;

        lian_msg = allocate( sizeof( action ) );
        for ( int i = 0; i < sizeof( action ); i++ )
        {
                lian_act = action[ i ];
                lian_msg[ i ] = (string)lian_act[ "lian" ];
        }
        return lian_msg;
}


