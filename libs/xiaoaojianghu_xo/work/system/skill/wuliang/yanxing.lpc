inherit SKILL;

mapping *action = ({
        ([     
                "action":               
"$n纵身一跳，一招「孤飞一雁」，轻轻松松躲了开去.......",
                "lian" :
"$N提气在胸，一招「孤飞一雁」，纵身一跃，飘至半空。。",
                "jibie":          8,
                "sen"  :      5,
        ]),
        ([      "action":
"$n猛的一闪身，使一招「雁逐明月」，向后退出数丈.....",
                "lian" :
"$N向旁边猛的一闪，想使一招「雁逐明月」，却滑了一下，险些摔倒。",
                "jibie":15,
                "sen"  :5,
        ]),
        ([      
                "action":               
"$n一招「直上青云」，轻飘飘地飞到半空，躲过了$N的凌厉攻势。",
                "lian" :
"$N使劲一蹬腿，往上一招「直上青云」，身体往上一直蹿去。",
                "jibie":25,
                "sen"  : 5,
        ]),
        ([    
                "action":               
"$n旋了一个大圈，然后一个「雁没青天」，飘然转下身来，落到$N身后。",
                "lian" :
"$N一蹬地，使劲一旋，一个「雁没青天」飘然而下。",
                "jibie":33,
                "sen"  : 5,
        ]),
        ([      
                "action":               
"$n昂头向上一纵，一式「雁上天飞」飘到空中，在空中转了两个大圈，躲了过去。",
                "lian" :
"$N低头侧身，昂头向上一纵，一式「雁上天飞」，在空中转了两个大圈。。",
                "jibie":40,
                "sen"  : 6,
        ]),
});
