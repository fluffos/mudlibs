// haoran-zhengji.c
// 浩然正气 for wu-liang

inherit FORCE;

string query_xiuwei_type(){ return "force"; }
//int valid_enable(string usage) { return usage=="force"; }

int valid_learn(object me)
{
    if((int)me->query("PKS")>5&&(int)me->query_skill("haoran-zhengqi",1)>=40)
        return notify_fail("你杀人过多，无法领悟更高深的浩然正气。\n");
    return 1;
}

int valid_lian(object me)
{
        return notify_fail("浩然正气只能通过修炼或者是使用来增加领悟度。\n");
}

/*string exert_function_file(string func)
{
        return CLASS_D("swordsman") + "/haoran-zhengqi/" + func;
} */

int query_level()
{       return 2;
}

string query_type()
{
        return "yang";
}

int valid_xiulian( object me )
{
        if( (int)me->query("bellicosity") < 200 )
        return 1;
        else
        return notify_fail("你尝试着静思入定，可不知为什么，总是觉得很烦躁。\n");
}

int query_zhuyan() { return 1;}




