// liuyun-jian.c
//      nerd     Dec 9,1996 create

inherit SKILL;

mapping *action = ({
  ([ "action": "$N一招「伯牙抚琴」，手中$w一弹，刺向$n的$l",
    "lian": "$N一招「伯牙抚琴」，手中$w一弹，缓缓刺出。",
    "sen": 4,
    "jibie": 0,
    "dodge": 10,
    "parry": 20,
    "zhaoshi": "「伯牙抚琴」",
    "wound": 30,
    "damage_type": "刺伤" ]),
  ([ "action": "紧接着$N一招「樊哙屠狗」，高举手中$w，向$n迎头一劈",
    "lian": "$N一招「樊哙屠狗」，手中$w凌空一劈。",
    "sen": 3,
    "jibie": 5,
    "dodge": 20,
    "parry": 20,
    "zhaoshi": "「樊哙屠狗」",
    "wound": 40,
    "damage_type": "割伤" ]),
  ([ "action": "紧跟着$N反手一招「西子浣沙」，手中$w向$n的$l一抹",
    "lian": "$N手握$w，使出一招「西子浣沙」向前顺势一抹。",
    "sen": 4,
    "jibie": 10,
    "dodge": 10,
    "parry": 0,
    "zhaoshi": "「西子浣沙」",
    "wound": 50,
    "damage_type": "割伤" ]),
  ([ "action": "$N左手捏了个剑诀，右手一招「班超投笔」，手中$w对准$n一点",
    "lian": "$N左手捏了个剑诀，右手一招「班超投笔」，手中$w轻轻一点。",
    "sen": 4,
    "jibie": 20,
    "dodge": 40,
    "parry": 0,
    "zhaoshi": "「班超投笔」",
    "wound": 55,
    "damage_type": "刺伤" ]),
  ([ "action": "只见$N弓步上前，双手紧握$w，一招「张良进履」，向$n的头部由下而上一撩",
    "lian": "$N一个弓步，使出一招「张良进履」，手中$w往上一撩。",
    "sen": 5,
    "jibie": 30,
    "dodge": 30,
    "parry": 10,
    "zhaoshi": "「张良进履」",
    "wound": 50,
    "damage_type": "割伤" ]),
  ([ "action": "$N手拿$w，一招「渐离击筑」，向$n的$l飞速一击",
    "lian": "$N手拿$w，一招「渐离击筑」，快速击出。",
    "sen": 5,
    "jibie": 40,
    "dodge": 10,
    "parry": 15,
    "zhaoshi": "「渐离击筑」",
    "wound": 60,
    "damage_type": "割伤" ]),
});

string *parry_msg = ({
  "$n使出一招「柳拂旌旗」，手中的$v化作一条长虹，磕开了$N的$w。\n",
  "$n使出一招「惊凤乱点」，手中的$v化做漫天雪影，荡开了$N的$w。\n",
  "$n手中的$v一抖，一招「蓝田日暖」，向$N拿$w的手腕削去。\n",
  "$n反手一招「密雨斜侵」，击出，\n",
  "$n使出一招「沧海月明」，$w直刺$N的双手。\n",
});

string *unarmed_parry_msg = ({
  "$n双手舞得密不透风，使出「避实就虚」，封住了$N的攻势。\n",
  "$n反手一招「将繁就简」，避开了$N的这一招。\n",
  "$n使出一招「虚敲实应」，架住了$N的攻势。\n",
  "但见$n一招「欲擒故纵」，迫得$N连连后退。\n",
});

int valid_learn(object me) {
  if (me->query("max_force") < 150) {
    return notify_fail("你的内力不够，没有办法练流云剑法。\n");
  }
  if (me->query_lingwu("haoran-zhengqi") < me->query_jibie("liuyun-jian")) {
    return notify_fail("流云剑法必须配合足够的浩然正气才能练。\n");
  }
  return 1;
}

int valid_lian(object me) {
  object ob = me->query_temp("weapon");
  if (!ob || (string)ob->query("weapon_type") != "sword") {
    write("你必须先找一把剑才能练剑法。\n");
    return 0;
  }
  return valid_learn(me);
}

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_xiuwei_type() { return "sword"; }
string query_weapon_type() { return "sword"; }

int query_dengji() { return 3; }

int query_youxiao_jibie() { return 9; }

int query_parry_ratio() { return 12; }
