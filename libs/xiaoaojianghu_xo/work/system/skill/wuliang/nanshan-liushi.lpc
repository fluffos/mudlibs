//  nanshan-liushi
//  南山六式   by nerd@xo on March 22,1997
inherit SKILL;

mapping *action = ({
    ([  "action": "$N扎稳下盘，两掌一错，一招「太公钓鱼」，向$n的胸前一劈",
        "lian"    : "$N扎稳下盘，两掌一错，一招「太公钓鱼」，向前凌空一劈。",
        "limb"    : "胸前",
        "zhaoshi" : "「太公钓鱼」",
        "jibie"   :  10,
        "sen"    :   2,
        "damage" :   20,
        "damage_type":  "瘀伤"
    ]),
    ([  "action" : "只见$N向左急跨一步，右手握拳护住胸腹，一式「织女投梭」，左手飞速击出",
        "lian"     :"$N向左急跨一步，右手握拳护住胸腹，一式「织女投梭」，左手飞速击出",
        "zhaoshi" : "「织女投梭」",
        "jibie"    : 15,
        "sen"     :  3,
        "damage":  20,
        "damage_type":  "瘀伤"
    ]),
    ([  "action": "$N双手抱拳，一式「霸王卸甲」狠狠砸向$n的$l",
        "lian"    : "$N双手抱拳，一式「霸王卸甲」狠狠向空气砸出。",
        "zhaoshi" : "「霸王卸甲」",
        "jibie"   : 25,
        "sen"    : 2,
        "damage":  30,
        "damage_type":  "瘀伤"
    ]),
    ([  "action": "$N一招「金刚托钵」，左手横立，跨上一步，右手从下而上一托",
        "lian" :  "$N一招「金刚托钵」，左手横立，跨上一步，右手从下而上一托",
        "zhaoshi" : "「金刚托钵」",
        "jibie" :40,
        "sen"  : 2,
        "damage": 30,
        "damage_type":  "抓伤"
    ]),
    ([  "action": "$N大喝一声，一招「樵夫问路」，弓步上前，双掌并立劈向$n",
        "lian" :"$N大喝一声，一招「樵夫问路」，弓步上前，双掌并立劈出",
        "zhaoshi" : "「樵夫问路」",
        "jibie"  :50,
        "sen"  : 3,
        "damage":   24,
        "damage_type":  "瘀伤"
    ]),
    ([  "action":  "$N忽的跃起，一招「玉女穿针」，双脚连环踢向$n的头部",
        "lian" :"$N忽的跃起，一招「玉女穿针」，双脚连环踢出",
        "limb"    : "头部",
        "zhaoshi" : "「玉女穿针」",
        "jibie":60,
        "sen"  :2,
        "damage":  30,
        "damage_type":  "瘀伤"
    ]),
});

string *parry_msg = ({
    "$n使出一招「卧看巧云」，掌力倾吐，身子一侧，化开了$N的的攻势。\n",
    "$n一招「拨云见日」，轻描淡写地将$N的攻势挡了回去。\n",
    "$n使出「推窗望月」，以守为攻，化解了$N的攻势\n",
    "$n双掌并举，一招「举火燎天」，内力吐出，架住$N的招式\n",
});

string *unarmed_parry_msg = ({
    "$n见势紧急，双掌向外奋力推出。\n",
});

int valid_learn(object me)
{
    return 1;
}

int valid_lian( object me )
{
    if ( me->query_temp( "weapon" ))
        return notify_fail("你必须空手练习南山六式.\n");
    return 1;
}

mapping query_action(int jibie)
{
        int i, size;

        size = sizeof( action );
        for ( i = 0; i < sizeof( action ); i++ )
                if ( action[ i ][ "jibie" ] > jibie )
                {
                        size = i;
                        break;
                }
    return action[ random( size ) ];
}

string query_zhaoshi( int jibie )
{
    int i;
    for ( i = 0; i < sizeof(action); i++ )
    {
        if ( action[ i ][ "jibie" ] >= jibie )
            return action[ i ][ "zhaoshi" ];
    }
    return "";
}

string query_xiuwei_type() { return "unarmed"; }

// 返回这路武功的等级, 第十等返回 1, 第一等返回 10
int query_dengji() { return 2; }

string query_parry_msg(object weapon)
{   
    if ( objectp( weapon ) )
        return parry_msg[random(sizeof(parry_msg))];
    else
        return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}


