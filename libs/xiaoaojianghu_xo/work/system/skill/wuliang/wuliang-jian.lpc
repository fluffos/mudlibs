        "sen"   :2,
        "jibie" :18,
        "dodge" :20,
        "parry" :0,
        "wound":20,
        "zhaoshi" : "「苍松迎客」",
        "damage_type":"割伤" ]),
    ([  "action":"$N脚走阴阳，手捏剑诀，一招「古柏森森」手中$w缓缓刺出。",
        "lian"  :"$N脚走阴阳，手捏剑诀，一招「古柏森森」手中$w缓缓刺出。",
        "sen"   :2,
        "jibie" :25,
        "dodge" :0,
        "parry" :15,
