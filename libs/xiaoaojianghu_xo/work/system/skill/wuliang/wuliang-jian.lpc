        "sen"   :4,
        "jibie" :40,
        "dodge" :5,
        "parry" :20,
        "wound":28,
        "zhaoshi" : "「金雁横空」",
        "damage_type":"割伤"    ]),
    ([  "action":"又见$N高高跃起，一式「腾蛟起凤」，向$n$l一劈！",
        "lian"  :"$N身形乍展，高高跃起，一式「腾蛟起凤」$w凌空一劈。",
        "sen"   :5,
        "jibie" :50,
        "dodge" :5,
        "parry" :15,
        "wound":40,
        "zhaoshi" : "「腾蛟起凤」",
