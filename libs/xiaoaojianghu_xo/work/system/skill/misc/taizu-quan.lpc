inherit SKILL;

mapping *action = ({ 
        ([
                "zhaoshi": "双 抄 封 天",
                "action" :
"$N下半身右脚撇步上前、成扣步坐定,侧面上同时、双手化掌、向前双抄而上",
                "lian" : 
"$N使出一招「双 抄 封 天」:下半身右脚撇步上前、成扣步坐定,侧面上同时\n"
"、双手化掌、向前双抄而上\n"
"下半身接著、左脚以勾腿法向前踢出侧面上顺势、双掌外翻、\n"
"向两侧以双分掌压落、平置两旁,下半身全身下压、成七星步坐定不动",
                "jibie" : 1,
                "sen" : 2,
                "dodge" : 10,
                "parry" : 10,
                "damage" : 20,
                "damage_type" : "瘀伤",
        ]),                         
        ([
                "zhaoshi": "冲 步 双 掌",

                "action" :
"$N侧面上顺势、双手先抱回腰际後、向前以双撑掌直推而出",

                "lian" : 
"$N使出一招「冲 步 双 掌」:下半身撑直右脚、身体向前冲出侧面上\n"

"顺势、双手先抱回腰际後、\n"
"向前以双撑掌直推而出下半身身体压低、成弓箭步站定......。",

                "jibie" : 2,
                "sen" : 3,
                "dodge" : 5,
                "parry" : 10,
                "damage" : 24,
                "damage_type" : "瘀伤",
        ]),                                                      
        ([
                "zhaoshi": "魁 星 踢 斗",
                "action" :
"$N上身保持原姿势不动,提起左腿、升直右腿成独立步站定,\n"
"顺势左腿向前直蹬而出.",
                "lian" : 
"$N使出一招「魁 星 踢 斗」:全身原步右转、依然成弓箭步站定同时、\n"
"右手向右刁出、左手顺势护肩\n"
"接著、以右脚为轴、向左转回顺势、左手向左反刁而回身体下坐、\n"
"成虚步坐定,抱腰顺势、双手握拳、紧扣腰际放定......。",
                "jibie" :3,
                "sen" : 3,
                "dodge" : 5,
                "parry" : 10,
                "damage" : 16,
                "damage_type" : "瘀伤",
        ]),                      
        ([
                "zhaoshi": "进 步 冲 捶",
                "action" :
"$N双手依然握拳扣住腰际,上右步至左脚旁、将身体站直,同时、\n"
"双手以双冲拳、向前直击而出.",
                "lian" : 
"$N紧接上式、使出一招「进 步 冲 捶」:将蹬出的左腿向前落步,双手\n"
"依然握拳扣住腰际\n"
"上右步至左脚旁、将身体站直同时、双手以双冲拳、向前直击而出......。",
                "jibie" : 4,
                "sen" : 3,
                "dodge" : 5,
                "parry" : 10,
                "damage" : 20,
                "damage_type" : "瘀伤",
        ]),                      
        ([
                "zhaoshi": "回 首 双 刁",
                "action" :
"$N全身原步右转、依然成弓箭步站定,同时、右手向右刁出、左手顺势护肩",
                "lian" : 
"$N使出一招「回 首 双 刁」: 全身原步右转、依然成弓箭步站定,同时、\n"
"右手向右刁出、\n"
"左手顺势护肩.接著、以右脚为轴、向左转回顺势、左手向左反刁而回\n"
"身体下坐、成虚步坐定抱腰顺势、双手握拳、紧扣腰际放定......。",
                "jibie" : 5,
                "sen" : 3,
                "dodge" : 5,
                "parry" : 10,
                "damage" : 15,
                "damage_type" : "瘀伤",
        ]),                      
        ([
                "zhaoshi": "拍 案 齐 掌",
                "action" :
"$N收回右手、左手化掌向前平推而出",
                "lian" : 
"$N使出一招「拍 案 齐 掌」: 收回右手、左手化掌向前平推而出同时、\n"
"右腿以《踢腿式》\n"
"向前直踢而出前踢之右腿、自然踢到左横掌、而发出声音\n"
"全式不变、全身微向下坐、产生後拉之势右腿向後大步撤回、\n"
"顺势拖回左脚、成弓箭步站定,上半身同时、收左手、右手化掌向前直压而出",
                "jibie" : 6,
                "sen" : 3,
                "dodge" : 5,
                "parry" : 10,
                "damage" : 18,
                "damage_type" : "瘀伤",
        ]),
        ([      "zhaoshi": "弓 步 冲 打",
                "action":               
"$N使出一招「弓 步 冲 打」，左脚向左跨出、身体尽量压低,上半身顺势、拉回\n"
"左手、右拳向前直击而出.",
                "lian" :
"$N使出一招「弓 步 冲 打」:左脚向左跨出、身体尽量压低顺势、左手化掌、\n"
"向左圈采而出\n"
"右拳同时收回腰际蓄劲不动.接著、撑直右腿、成弓箭步站定\n"
