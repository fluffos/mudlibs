inherit SKILL;

mapping * action=({
    ([  "action":"$N一招「釜底抽薪」，手中$w急向前送，斩向$n左腿!",
        "lian"  :"$N把手中$w舞的密不透风。",
        "jibie" :10,
        "zhaoshi":"「釜底抽薪」",
        "limb"  : "左腿",
        "sen"   :3,
        "dodge" :20,
        "damage":20,
        "damage_type":"刀伤"   ]),
    ([  "action":"$N攻敌之不备，又一招「疾风吹劲草」，手中$w从侧面向$n腰间掠了上去",
        "lian"  :"$N一招「疾风吹劲草」，手中$w从侧面反撩上来",
        "jibie" :20,
        "zhaoshi":"「疾风吹劲草」",
        "sen"   :3,
        "dodge" :10,
        "parry" :20,
        "damage":30,
        "damage_type":"割伤"    ]),
    ([  "action":"只见$N一招「滚刀式」，俯身向前，手中$w左右急晃",
        "lian"  :"$N反手一招「滚刀式」，俯身向前，直探下三路。",
        "jibie" :30,
        "zhaoshi":"「滚刀式」",
        "sen"   :4,
        "limb" :"后腰",
        "dodge" :20,
        "parry" :15,
        "damage":35,
        "damage_type":"割伤"    ]),
    ([  "action":"$N趁机使出一招「斩马式」，纵身向前，探身$w斩向$n下盘",
        "lian"  :"$N一式「斩马式」，探身向前刀锋如电",
        "jibie" :40,
        "zhaoshi":"斩马式",
        "sen"   :2,
        "limb"  : "小腿",
        "dodge" :20,
        "parry" :10,
        "damage":20,
        "damage_type":"砍伤"    ]),
    ([  "action":"$N身子一侧，一招「推风迎雪」，身子在地上飞转，手中$w象一团雪影迎着\n"
                 "$n压地而来",
        "lian"  :"$N身子一侧，一招「推风迎雪」，身子如一个陀螺一样在地上飞转",
        "jibie" :50,
        "sen"   :5,
        "zhaoshi":"「推风迎雪」",
        "damage":40,
        "limb" : "右腿",
        "parry" :20,
        "dodge":30,
        "damage_type":"刀伤"   ]),
    ([  "action":"$N一招「刀斩黄沙」，刀锋贴地掠过，激起一片尘土。",
        "lian"  :"$N一招「刀斩黄沙」，刀锋贴地掠过，激起一片尘土。",
        "jibie" :60,
        "zhaoshi":"「刀斩黄沙」",
        "sen"   :3,
        "damage":50,
        "limb" : "后腰",
        "dodge":30,
        "parry": 30,
        "damage_type":"割伤"   ]),

});

string *parry_msg = ({
        "$n使出一招「枪下幽魂」，手中的$v舞成一团刀花，架开了$N的$w。\n",
        "$n立刀胸前，顺手将$N的$w「当」的一声挡住了。\n",
        "$n使出一招「拖刀式」，身形反转，手中的$v向后急刺....\n",
});
string *unarmed_parry_msg = ({
        "$n使出一招「枪下幽魂」，手中的$v舞成一团刀花，架开了$N的\n",
        "$n立刀胸前，顺手将$N的攻势挡住了。\n",
        "$n使出一招「拖刀式」，身形反转，手中的$v向后急刺....\n",
});
int valid_learn(object me)
{
    return 1;
}

int valid_lian( object me )
{
        object weapon;

        weapon = me->query_temp( "weapon" );
    if ( !weapon || weapon->query("weapon_type") != "blade" )
        return notify_fail("你必须先找一把刀才能练刀法。\n");

        return 1;
}

mapping query_action(int jibie)
{
        int i, size;

        size = sizeof( action );
        for ( i = 0; i < sizeof( action ); i++ )
                if ( action[ i ][ "jibie" ] > jibie )
                {
                        size = i;
                        break;
                }
    return action[ random( size ) ];
}


string query_xiuwei_type()
{
        return "blade";
}
string query_weapon_type()
{
    return "blade";
}

int query_dengji()
{
        return 2;
}

string query_parry_msg(object weapon)
{
    if ( weapon )
        return parry_msg[random(sizeof(parry_msg))];
    else
        return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi( int jibie )
{
    int i;
    for ( i = 0; i < sizeof(action); i++ )
    {
        if ( action[ i ][ "jibie" ] >= jibie )
            return action[ i ][ "zhaoshi" ];
    }
    return "";
}

int query_youxiao_jibie() { return 8; }

int query_parry_ratio() { return 14; }