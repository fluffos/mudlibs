string *parry_msg = ({ /* size = 12*/
    "$n不退不让，使出「脱然畦封」，左掌按出，硬接$N的来势。\n",
    "$n以第二势「虚伫神素」，右掌接住$N的来势，左手一连三拳，逼得$N退出三步。\n",
    "$n一招「落落元宗」，步下一错，散出一地人影，逃得满地都是，不可收拾。\n",
    "$n一招「虚伫神素」，身随拳走，恰恰让过$N的攻势。\n",
    "$n一招「太华夜碧」，单拳护身，足成独立，另一只手挥向$N的右手。\n",
    "$n长啸声中，一招「人闻清钟」，身若游龙，$N的攻势顿时落在空处。\n",
});

string *unarmed_parry_msg = ({
    "$n不退不让，使出「脱然畦封」，左掌按出，硬接$N的来势。\n",
    "$n以第二势「虚伫神素」，右掌接住$N的来势，左手一连三拳，逼得$N退出三步。\n",
    "$n一招「落落元宗」，步下一错，散出一地人影，逃得满地都是，不可收拾。\n",
    "$n一招「虚伫神素」，身随拳走，恰恰让过$N的攻势。\n",
    "$n一招「太华夜碧」，单拳护身，足成独立，另一只手挥向$N的右手。\n",
    "$n长啸声中，一招「人闻清钟」，身若游龙，$N的攻势顿时落在空处。\n",
});

int valid_learn(object me)
{
        return 1;
}

int valid_lian( object me )
{
        if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
                return notify_fail("老哥，您在练拳法耶！拿的哪门子兵器呵？\n");

        return 1;
}

string query_xiuwei_type()
{
        return "unarmed";
}

mapping query_action(int jibie)
{
        int i, size;

        size = sizeof( action );
        for ( i = 0; i < sizeof( action ); i++ )
                if ( action[ i ][ "jibie" ] > jibie )
                {
                        size = i;
                        break;
                }
    return action[ random( size ) ];
}

int query_dengji()
{
       return 2;
}

string query_parry_msg(object weapon)
{   
    if ( weapon )
        return parry_msg[random(sizeof(parry_msg))];
    else
        return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi( int jibie )
{
    int i;
    for ( i = 0; i < sizeof(action); i++ )
    {
        if ( action[ i ][ "jibie" ] >= jibie )
            return action[ i ][ "zhaoshi" ];
    }
    return "";
}

int query_youxiao_jibie() { return 10; }

int query_parry_ratio() { return 8; }//这么多parry_msg，能不多给点防御吗？
