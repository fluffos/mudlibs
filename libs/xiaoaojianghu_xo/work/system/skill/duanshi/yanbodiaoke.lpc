//yanbodiaoke
//烟波钓客鞭法
//千山鸟飞绝，万径人踪灭，孤舟蓑笠翁，独钓寒江雪

inherit SKILL;

mapping * action=({
    ([  "action":"$N手中的$w使出「千山鸟飞绝」笼罩了$n的整个上盘",
                "lian"  :"$N手中的$w使出「千山鸟飞绝」笼罩了前方的上空",
                "jibie" :5,
        "limb"  :"头部",
        "sen"   :7,
        "dodge" :30,     
        "parry" :0,
        "damage":50,
        "wound" :20,
        "damage_type":"鞭伤"   ]),
    ([  "action":
"$N一式「万径人踪灭」，手中的$w从下向上斜攻而至$n的下三路",
                "lian"  :
"$N一式「万径人踪灭」，手中的$w从下向上斜攻而至",
                "jibie" :15,
        "limb"  :"膝部",
        "sen"   :8,
        "dodge" :40,
        "parry" :5,
        "damage":45,
        "wound" :15,
        "damage_type":"鞭伤"    ]),
    ([  "action":
"$N使出「孤舟蓑笠翁」，神情落寞，$w向怀中一带，$w柄横扫$n",
                "lian"  :
"$N使出「孤舟蓑笠翁」，神情落寞，$w向怀中一带，$w柄横扫",
                "jibie" :35,
        "sen"   :8,
        "dodge" :20,
        "parry" :20,
        "damage":60,
        "wound" :30,
        "damage_type":"淤伤"    ]),
    ([  "action":
"$N使出最后一式「独钓寒江雪」把$w一提一收，却以$w柄如长枪般直刺$n",
                "lian"  :
"$N使出最后一式「独钓寒江雪」把$w一提一收，却以$w柄如长枪般直刺",
                "jibie" :60,
        "sen"   :8,                        
        "dodge" :20,
        "parry" :50,
        "damage":70,
        "wound" :40,
        "damage_type":"刺伤"    ]),
});

string *parry_msg = ({
        "$n$v柄磕开$N的$w，同时$v头反击$N。\n",
        "$n摆$v一封一架，封住了$N的攻势。\n",
        "$n$v一荡，逼得$N不能近身。\n",
});
string *unarmed_parry_msg=({
        "$n$v柄磕开$N的$w，同时$v头反击$N。\n",
        "$n摆$v一封一架，封住了$N的攻势。\n",
        "$n$v一荡，逼得$N不能近身。\n",
});

mapping query_action(int jibie)
{
    int i, size;

    size = sizeof( action );
    for ( i = 0; i < sizeof( action ); i++ )
         if ( action[ i ][ "jibie" ] > jibie )
         {
             size = i;
             break;
         }
    return action[ random( size ) ];
}

string query_xiuwei_type()
{
        return "whip";
}                    
string query_weapon_type() { return "whip";}

// 返回这路武功的等级, 第十等返回0, 第一等返回9.
int query_dengji()
{
        return 4;
}

int valid_learn(object me)
{   
        if ( me->query("max_force")<300 )
                return notify_fail("你的内力太弱，无法练这门武功。\n");
    return 1;
}

string query_parry_msg(object weapon)
{   
    if ( objectp( weapon ) )
        return parry_msg[random(sizeof(parry_msg))];
    else
        return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}
             
int query_youxiao_jibie() { return 12; }

int query_parry_ratio() { return 11 ; }

int valid_lian( object me )
{
        object weapon;

        weapon = me->query_temp( "weapon" );    
    if ( !weapon || weapon->query("weapon_type") != "whip" )
        return notify_fail("你必须先找一条鞭才能练鞭法。\n");

        return 1;
}

