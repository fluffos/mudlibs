//pangencuojie
//盘根错节斧法;
inherit SKILL;

mapping * action=({
    ([  "action":
"$N着地向$n卷去，双斧劈向$n下盘",
                "lian"  :
"$N着地向前卷去，双斧劈出",
                "jibie" :15,
        "limb"  :"下身",   
        "sen"   :5,
        "dodge" :5,     
        "parry" :30,
        "damage":50,
                "wound" :20,
        "damage_type":"劈伤"   ]),
    ([  "action":
"$N就地一滚，左右$w同时向$n下三路攻到",
                "lian"  :
"$N就地一滚，左右$w同时向假象之敌下三路攻到",
                "jibie" :30,
        "limb"  :"左腿",    
        "sen"   :6,
        "dodge" :0,
        "parry" :40,
                "wound" :35,
        "damage":45,
        "damage_type":"劈伤"    ]),
    ([  "action":
"$N左$w护住自己的要害，欺身而上，右$w猛磕$n踝部",
                "lian"  :
"$N左$w护住自己的要害，欺身而上，右$w猛磕下去",
                "jibie" :45,
        "limb"  :"踝部",
        "sen"   :8,
        "dodge" :10,
        "parry" :50,
        "damage":20,
                "wound" :20,
        "damage_type":"淤伤"    ]),
    ([  "action":
"$N见$n来势汹汹，$w如门板般一封，同时伸足飞踢$n裆部",
                "lian"  :
"$N$w如门板般一封，同时伸足飞踢",
                "jibie" :60,
        "limb"  :"裆部",
        "sen"   :7,                        
        "dodge" :20,
        "parry" :30,
        "damage":60,
                "wound" :40,
        "damage_type":"淤伤"    ]),
    ([  "action":
"$N一个前滚翻，避开$n的攻势，突然站起，$w拦腰横劈$n",
                "lian"  :
"$N一个前滚翻，$w拦腰横劈",
                "jibie" :75,
        "limb"  :"腰部",
        "sen"   :10,
        "damage":90, 
        "dodge" :0,
        "parry" :50,
                "wound" :30,
        "damage_type":"劈伤"   ]),
    ([  "action":
"$N怒吼连连，猛地$w脱手飞出，向$n袭至，随后$N紧跟便到，又将$w接回手中",
                "lian"  :
"$N猛地$w脱手飞出，在空中划了两条弧线，随后$N紧跟便到，又将$w接回手中",  
                "jibie" :90,
        "sen"   :13,
        "dodge" :0,
        "parry" :50,
        "damage":20,
                "wound" :100,
        "damage_type":"割伤"   ]),
});

string *parry_msg = ({
        "$n就地十八滚，避开$N的攻势。\n",
        "$n双$v如封似闭，将$N封在外门。\n",
        "$n大喝一声，$v全力一架，只听“锵”的一声大响，将$N的$w格开。\n",
        "$n把$v舞成一片，风雨不透。令$N一时无计可施。\n",
});
string *unarmed_parry_msg=({
        "$n就地十八滚，避开$N的攻势。\n",
        "$n双$v如封似闭，将$N封在外门。\n",
        "$n把$v舞成一片，风雨不透。令$N一时无计可施。\n",
});

mapping query_action(int jibie)
{
    int i, size;

    size = sizeof( action );
    for ( i = 0; i < sizeof( action ); i++ )
         if ( action[ i ][ "jibie" ] > jibie )
         {
             size = i;
             break;
         }
    return action[ random( size ) ];
}

string query_xiuwei_type()
{
        return "blade";
}                    
string query_weapon_type() { return "twohands_axe";}

// 返回这路武功的等级, 第十等返回0, 第一等返回9.
int query_dengji()
{
        return 4;
}

string query_parry_msg(object weapon)
{   
    if ( objectp( weapon ) )
        return parry_msg[random(sizeof(parry_msg))];
    else
        return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}
             
int query_youxiao_jibie() { return 11; }

int query_parry_ratio() { return 6 ; }

int valid_learn(object me)
{   
        if ( me->query("max_force")<300 )
                return notify_fail("你的内力太弱，无法练这门武功。\n");
        if ( me->query("age")<18 )
                return notify_fail("你的年纪太小，无法修练这门刚猛的武功。\n");

    return 1;
}

int valid_lian( object me )
{
        object weapon;

        weapon = me->query_temp( "weapon" );    
    if ( !weapon || weapon->query("weapon_type") != "twohands_axe" )
        return notify_fail("你必须先找一对板斧才能炼斧法。\n");

        return 1;
}

