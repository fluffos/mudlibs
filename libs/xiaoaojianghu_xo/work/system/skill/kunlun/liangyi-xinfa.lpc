inherit FORCE;

string query_xiuwei_type() { return "force"; }

int valid_learn(object me) {
  //    if((int)me->query("PKS")>5&&(int)me->query_skill("haoran-zhengqi",1)>=40)
  //        return notify_fail("你杀人过多，无法领悟更高深的两仪心法。\n");
  return 1;
}

int valid_lian(object me) {
  return notify_fail("内功只能通过修炼或者是使用来增加领悟度。\n");
}


int query_level() {
  return 5;  //等级为五
}

string query_type() {
  return "yang";  //阳性
}

int valid_xiulian(object me) {
  // 杀气高于100点不能练
  if ((int)me->query("bellicosity") < 100)
    return 1;
  else
    return notify_fail("你尝试着静思入定，可不知为什么，总是觉得很烦躁。\n");
}

int query_zhuyan() { return 1; }
