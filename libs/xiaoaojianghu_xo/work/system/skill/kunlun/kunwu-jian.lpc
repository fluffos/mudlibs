// kunwu-jian.c
//  昆吾剑

inherit SKILL;
mapping *action = ({
    ([  "action":
"$N往后一个踞步，正是一招「黑虎坐洞」，手中$w向$n肩部直挑过去。",
        "lian"  :
"$N往后一个踞步，使出一招「黑虎坐洞」，手中$w向前直挑而上。",
        "sen"   :3,
        "jibie" :5,
        "dodge" :20,
        "parry" :20,
        "zhaoshi":"「黑虎坐洞」",
        "damage":30,
        "damage_type":"割伤"    ]),
    ([  "action":
"$N目光盯住$n，使出一招「青蛇盘地」，手中$w旋起一片剑光，将$n整个罩住。",
        "lian"  :
"$N目光向前凝视，使出一招「青蛇盘地」，只见剑光霍霍。",
        "sen"   :6,
        "jibie" :20,
        "dodge" :30,
        "parry" :30,
        "zhaoshi":"「青蛇盘地」",
        "damage":50,
        "damage_type":"割伤" ]),
    ([  "action":
"$N手臂往前一伸，一招「白猿鲜果」随之递出，$w向$n急刺过去。",
        "lian"  :
"$N一个拗步，手握$w，使出一招「白猿鲜果」，向前急刺而出。",
        "sen"   :9,
        "jibie" :35,
        "dodge" :40,
        "parry" :40,
        "zhaoshi":"「白猿鲜果」",
        "damage":70,
        "damage_type":"割伤"    ]),
    ([  "action":
"$N身子突然跃起，使出一招「乌雀空飞」，手中$w向$n的右肩划下。",
        "lian"  :
"$N手拿$w，使出一招「乌雀空飞」，身体随之跃起。",
        "sen"   :12,
        "jibie" :50,
        "dodge" :50,
        "parry" :50,
        "zhaoshi":"「乌雀空飞」",
        "damage":90,
        "damage_type":"割伤"    ]),
        ([      "action":
"$N手中$w施展开来，正是一招「丹凤亮翅」，晃出点点剑花，向$n击过去。",
                "lian" :
"$N将手中的$w施展开来，一招「丹凤亮翅」，晃出点点剑花。",
        "zhaoshi":"「丹凤亮翅」",
        "sen" :15,
        "jibie":75,
        "dodge":60,
        "parry":60,
        "damage":110,
        "damage_type":"割伤"
        ]),
        ([ 
        "action":
"$N一招「黄龙探海」，手举$w，向$n当头砍下，隐隐有风雷之声。",
        "lian":
"$N一招「黄龙探海」，手举$w，往前砍下，隐隐有风雷之声。",
        "zhaoshi":"「黄龙探海」",
        "sen":18,
        "jiebie":90,
        "dodge":70,
        "parry":70,
        "damage":130,
        "damage_type":"割伤"
        ]),
});

string *parry_msg = ({
        "$n使出了一招「金鸡点头」，躲开了$N的攻势。。\n",
        "$n手中$w，往上一封，顿时瓦解了$N的这一招。。\n",
        "$n往旁边急跃，潇洒地避了开去。。\n",
        "$n将$w一抖，漫天剑气飞舞，$N赶忙将身形稳住。。 \n",
});

string *unarmed_parry_msg = ({
        "$n使出了一招「金鸡点头」，躲开了$N的攻势。。\n",
        "$n以掌当剑，往上一封，顿时瓦解了$N的这一招。。\n",
        "$n往旁边急跃，潇洒地避了开去。。\n",
        "$n亮开双掌，掌影空飞，$N赶忙将身形稳住。。 \n",
});

int valid_learn(object me)
{
    object ob;
    if( (int)me->query("max_force") < 500 )
        return notify_fail("你的内力不够，没有办法练昆吾剑。\n");
    return 1;
}

int valid_lian( object me )
{
    object weapon;
    weapon = me->query_temp( "weapon" );
    if ( !weapon || weapon->query("weapon_type") != "sword" )
        return notify_fail("你必须先找一把剑才能练习剑法。\n");
    return 1;
}
string query_xiuwei_type() { return "sword";}      
string query_weapon_type() { return "sword"; }

int query_dengji() { return 4; } //1~~ 10

mapping query_action(int jibie)
{
        int i, size;

        size = sizeof( action );
        for ( i = 0; i < sizeof( action ); i++ )
                if ( action[ i ][ "jibie" ] > jibie )
                {
                        size = i;
                        break;
                }
    return action[ random( size ) ];
}

string query_parry_msg(object weapon)
{   
    if ( weapon )
        return parry_msg[random(sizeof(parry_msg))];
    else
        return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi( int jibie )
{
    int i;
    for ( i = 0; i < sizeof(action); i++ )
    {
        if ( action[ i ][ "jibie" ] >= jibie )
            return action[ i ][ "zhaoshi" ];
    }
    return "";
}

int query_youxiao_jibie() { return 16;}

int query_parry_ratio() { return 16; }

