// yinzhi-bufa.c 阴骘步法
// Ffox 98-1-17 7:33

inherit SKILL;
mapping *action = ({
  ([
    "action":
    "$n一招「蝴蝶上阶飞」，身随意动，轻飘飘地就到了$N的身后。",
    "lian":
    "$N一招「蝴蝶上阶飞」，身随意动，轻飘飘地就到了两丈开外。",
    "jibie": 5,
    "sen": 5,
    "dodge": 0,
    "parry": 0,
    "damage": 20,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$n使出一招「风阶自在垂」，一个纵身，霎时从$N眼前飞过。",
    "lian":
    "$N使出一招「风阶自在垂」，一个纵身，霎时飞出两丈远近。",
    "jibie": 20,
    "sen": 10,
    "dodge": 0,
    "parry": 0,
    "damage": 30,
    "damage_type": "瘀伤"
  ]),
  ([
    "action":
    "$n一个「双雁落遥空」，身形微动，象一只飞鸟冲天而去，$N这一招差一点没有赶上。",
    "lian":
    "$N一个「双雁落遥空」，身形微动，象一只飞鸟冲天而去，姿势潇洒已极。",
    "jibie": 35,
    "sen": 15,
    "dodge": 0,
    "parry": 0,
    "damage": 40,
    "damage_type": "瘀伤"
  ]),
  ([
    "action":
    "$n一招「醉袖扶危栏」，人象一条游蛇，滑溜溜的从$N身旁一闪而过。",
    "lian":
    "$N一招「醉袖扶危栏」，人象一条游蛇，滑溜溜的一闪而过。",
    "jibie": 50,
    "sen": 20,
    "dodge": 0,
    "parry": 0,
    "damage": 50,
    "damage_type": "瘀伤"
  ]),
  ([
    "action":
    "$n使出一招「莫道不销魂」，身体蜿蜒蛇行，在$N就要击中的时候，突然避开。",
    "lian":
    "$N使出一招「莫道不销魂」，身体蜿蜒蛇行，突然跃起。",
    "jibie": 65,
    "sen": 25,
    "dodge": 0,
    "parry": 0,
    "damage": 60,
    "damage_type": "瘀伤"
  ]),
  ([
    "action":
    "只见$n使出一招「老矣真堪愧」，黯然之中，象是不会动弹似的，但是$N偏偏就是不能击中。",
    "lian":
    "$N使出一招「老矣真堪愧」，黯然之中，象是不会动弹似的，倏而不见踪迹。",
    "jibie": 80,
    "sen": 30,
    "dodge": 0,
    "parry": 0,
    "damage": 70,
    "damage_type": "瘀伤"
  ]),
});

int valid_learn(object me) {
  return 1;
}

int valid_lian(object me) {
  return 1;
}

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_xiuwei_type() {
  return "dodge";
}

// 返回这路武功的等级, 第十等返回0, 第一等返回9.
int query_dengji() {
  return 5;
}

int effective_level() { return 20; }

string *query_lian() {
  string *lian_msg;
  mapping lian_act;

  lian_msg = allocate(sizeof(action));
  for (int i = 0; i < sizeof(action); i++) {
    lian_act = action[i];
    lian_msg[i] = (string)lian_act["lian"];
  }
  return lian_msg;
}
