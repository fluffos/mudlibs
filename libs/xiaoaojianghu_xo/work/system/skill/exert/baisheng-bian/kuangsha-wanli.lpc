
// 百胜鞭之狂沙万里 
// by lnwm on 98/4/2

#include <ansi.h>

int exert(object me)
{
    object weapon;
    object *enemy;

    weapon = me->query_temp("weapon");
    enemy = me->query_enemy();

    if ( !weapon || weapon->query("weapon_type") != "whip" )
        return notify_fail("你手中无鞭，如何使用鞭法？！\n");
   
    if( !sizeof( enemy ) || !me->is_fighting() )
        return notify_fail("“狂沙万里”只能在战斗中使用。\n");

    if ( me->query_temp("exert/attack") )
            return notify_fail("你正在施展绝技，不能施展新的绝技。\n");
    
    if ( me->query("force") <= 500 )
            return notify_fail("你内力不足，不能使用“狂沙万里”。\n");
        
    if ( (int)me->query_lingwu("baisheng-bian", 1) < 70 )
        return notify_fail("你的“百胜鞭法”不够娴熟，不会施展狂沙万里。\n");

    me->set_temp("exert/attack",
        ([
            "name" : EXERT_DIR "baisheng-bian/kuangsha-wanli",
            "call" : "pre_action",
            "arg"  : enemy,
        ]) );

    return 1;
}

int pre_action(object me, object * enemy )
{
    foreach( object ob in enemy )
    {            
        if( present( ob , environment( me ) ) )
        {    
            me->set_temp("exert/attack/call", "action");
            return 1;
        }
    }
    return notify_fail("你的敌人不在这里。\n");     
}

int action(object me , object * enemy )
{
    int i;

    foreach( object ob in enemy )
    {
        if( present( ob , environment( me ) ) )
        {
            if( me->query("force") <= 500 ) 
            {
                me->delete_temp("exert/attack");
                return notify_fail("你内力不足。\n");
            }
            i = me->query_lingwu("baisheng-bian",1);
            me->add("force",-1200/i);
            message_vision(YEL"\n$N使出“狂沙万里”向$n发出攻击。\n", me , ob );
            COMBAT_D->fight_control( me, ob, 0 ); 
        }
    }
    message_vision(NOR,me);
    me->delete_temp("exert/attack");
    return 1;
}

