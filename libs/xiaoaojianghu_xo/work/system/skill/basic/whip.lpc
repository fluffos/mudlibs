// 鞭法基础  whip.c
//   ChangeLog by lin on March 24, 1997

inherit SKILL;

mapping *action = ({
  ([ "zhaoshi": "「入门招式」",
    "action":
    "$N当头凌空一鞭....",
    "lian":
    "$N手握$w,凌空一鞭.",
    "jibie": 10,
    "sen": 1,
    "damage_type": "鞭伤"
  ]),
  ([ "zhaoshi": "「入门招式」",
    "action":
    "$N一鞭接着一鞭，全是自$n右侧攻到.",
    "lian":
    "$N一鞭接着一鞭，全是向右侧攻出.",
    "jibie": 20,
    "sen": 1,
    "damage_type": "鞭伤"
  ]),
  ([ "zhaoshi": " 「入门招式」",
    "action":
    "$N一鞭接着一鞭，全是向$n左侧攻到.",
    "lian":
    "$N一鞭接着一鞭，全是向左侧攻出.",
    "jibie": 25,
    "sen": 1,
    "damage_type": "鞭伤"
  ]),
  ([ "zhaoshi": "「入门招式」",
    "action":
    "$N双手齐用，探身屈腿，横扫$n下盘。",
    "lian":
    "$N双手齐用，探身屈腿，横扫下盘。",
    "jibie": 35,
    "sen": 2,
    "limb": "腿部",
    "damage_type": "鞭伤"
  ]),
  ([ "zhaoshi": "「入门招式」",
    "action":
    "$N左掌伸出，笼住$n退路，右手将$w劈头甩下。",
    "lian":
    "$N左掌伸出，翻成一片掌花，右手将$w劈头甩下。",
    "jibie": 45,
    "limb": "头部",
    "sen": 2,
    "damage_type": "鞭伤"
  ]),
});

string *parry_msg = ({
  "$n手握$v,一个上甩，架住了$N的$w\n",
  "$n用$v架开了$N的$w\n",
  "$n架开了$N的$w。\n",
});
string *unarmed_parry_msg = ({
  "$n手握$v,一个上甩，架住了$N\n",
  "$n用$v架开了$N\n",
  "$n架开了$N\n",
});
int valid_learn(object me) {
  return 1;
}

int valid_lian(object me) {
  object weapon;

  weapon = me->query_temp("weapon");
  if (!weapon || weapon->query("skill_type") != "whip")
    return notify_fail("你必须先找一根鞭子才能练.\n");

  return 1;
}

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_xiuwei_type() {
  return "whip";
}

// 返回这路武功的等级, 第十等返回0, 第一等返回9.
int query_dengji() {
  return 1;
}
string query_zhaoshi(int jibie) {
  int i;
  for (i = 0; i < sizeof(action); i++) {
    if (action[i]["jibie"] >= jibie)
      return action[i]["zhaoshi"];
  }

  return "";
}

string query_parry_msg(object weapon) {
  if (objectp(weapon))
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}


int query_youxiao_jibie() { return 10; }

int query_parry_ratio() { return 10; }
