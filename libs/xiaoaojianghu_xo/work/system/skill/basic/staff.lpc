inherit SKILL;

mapping *action = ({
  ([
    "action":
    "$N大喝一声，手中$w直击不回",
    "lian":
    "$N大喝一声，挥动$w直击不回。",
    "jibie": 8,
    "sen": 1,
    "damage_type": "瘀伤"
  ]),
  ([
    "action":
    "$N举起$w，向$n当头砸下.",
    "lian":
    "$N举起$w，向$n当头砸下.",
    "jibie": 16,
    "limb": "头部",
    "sen": 1,
    "damage_type": "瘀伤"
  ]),
  ([
    "action":
    "$N双手紧握$w，踏步向前，径点$n$l",
    "lian":
    "$N双手紧握$w，踏步向前",
    "jibie": 24,
    "sen": 1,
    "damage_type": "瘀伤"
  ]),
  ([
    "action":
    "$N横举$w，身形一转，左右挥扫",
    "lian":
    "$N横举$w，身形一转，左右挥扫",
    "jibie": 32,
    "sen": 1,
    "damage_type": "瘀伤"
  ]),
  ([ "zhaoshi": "「千里长行」",
    "action":
    "$N一招「千里长行」，径点$n面门.",
    "lian":
    "$N一招「千里长行」，径点前方",
    "jibie": 40,
    "limb": "面门",
    "sen": 1,
    "damage_type": "刺伤"
  ]),
  ([
    "action":
    "$N手中$w似乎要脱手而出，暴长径尺，突点$n$l",
    "lian":
    "$N手中$w似乎要脱手而出，暴长径尺",
    "jibie": 48,
    "sen": 1,
    "damage_type": "瘀伤"
  ]),
  ([ "action":
    "$N手握$w,横扫$n下盘",
    "lian":
    "$N手握$w,横扫下盘",
    "jibie": 54,
    "sen": 1,
    "damage_type": "瘀伤"
  ]),
  ([
    "action":
    "$N俯身上前，挥杖击地，再转横扫，顿时沙土飞扬。",
    "lian":
    "N俯身上前，挥杖击地，再转横扫，顿时沙土飞扬。",
    "jibie": 60,
    "sen": 1,
    "damage_type": "瘀伤"
  ]),
});

string *parry_msg = ({
  "$n反守为攻，$v飞击$N下身。\n",
  "$n手中$v一抖，架住了$N的攻势。\n",
});
string *unarmed_parry_msg = ({
  "$n反守为攻，$v飞击$N下身。\n",
  "$n转身撤步，一条$v舞成一团，将全身罩住。\n",
  "$n手中$v一抖，架住了$N的$w。\n",
});
int valid_learn(object me) {
  return 1;
}

int valid_lian(object me) {
  object weapon;

  weapon = me->query_temp("weapon");
  if (!weapon || weapon->query("weapon_type") != "staff")
    return notify_fail("你必须先找一条长杖才能练.\n");

  return 1;
}

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_xiuwei_type() {
  return "long";
}
string query_weapon_type() { return "staff"; }

// 返回这路武功的等级, 第十等返回0, 第一等返回9.
int query_dengji() {
  return 1;
}
string query_parry_msg(object weapon) {
  if (objectp(weapon))
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int query_youxiao_jibie() { return 10; }

int query_parry_ratio() { return 11; }
