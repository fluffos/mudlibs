//  wuqi 人类拿着武器时最基本的战斗动作, 我们统一为一门技能 
//   ChangeLog by Falcon on March 24, 1997

inherit SKILL;

mapping action = ([
    "slash":
    ([
        "damage_type": "割伤",
        "action": "$N挥动$w，斩向$n的$l",
    ]),
    "slice":
    ([
        "damage_type":  "砍伤",
        "action": "$N用$w往$n的$l砍去",
    ]),
    "chop":
    ([
        "damage_type": "劈伤",
        "action": "$N的$w朝著$n的$l劈将过去",
    ]),
    "hack":
    ([
        "damage_type": "砍伤",
        "action": "$N挥舞$w，对准$n的$l一阵乱砍",
    ]),
    "thrust":
    ([
        "damage_type": "刺伤",
        "action": "$N用$w往$n的$l刺去",
    ]),            
    "point":
    ([
        "damage_type": "瘀伤",
        "action": "$N用$w向$n的$l点去",
    ]),
    "pierce":
    ([
        "damage_type": "刺伤",
        "action": "$N的$w往$n的$l狠狠地一捅",
    ]),
    "whip":
    ([
        "damage_type":  "鞭伤",
        "action": "$N将$w一扬，往$n的$l抽去",
    ]),
    "impale":
    ([
        "damage_type": "刺伤",
        "action": "$N用$w往$n的$l直戳过去",
    ]),
    "bash":
    ([
        "damage_type": "挫伤",
        "action": "$N挥舞$w，往$n的$l用力一击",
    ]),
    "crush":
    ([
        "damage_type": "挫伤",
        "action": "$N高高举起$w，朝$n当头砸下",
    ]),
    "slam":
    ([
        "damage_type": "挫伤",
        "action": "$N手握$w，眼露凶光，猛地对准$n的$l挥了过去",
    ]),
    "throw":
    ([
        "damage_type": "刺伤",
        "action": "$N将$w对准$n的$l射了过去",
    ]),
    "hit":
    ([
        "damage_type": "挫伤",
        "action": "$N用$w向$n的$l直击过去",
    ]),
]);

string *parry_msg = ({
    "只听见「锵」一声，被$P的$w被$p格开了。\n",
    "「当」地一声被$p挡开了。\n",
    "被$p用手中的$v架开。\n",
    "$p身子一侧，用手中的$v格开。\n",
});

string *unarmed_parry_msg = ({
    "$p拼命挥舞手中的$v, 化解了$P的攻势。\n",
});

int valid_learn(object me)
{
    return 0;
}

int valid_lian( object me )
{
        return 0;
}

int is_native_skill()
{
        return 1;
}

mapping query_action( object weapon )
{
    string verb, *verbs;

        //if ( !objectp( weapon ) return 0;
    verbs = weapon->query( "verbs" );
    //printf( "verbs is %O\n", verbs );

    if ( !pointerp( verbs ) )
        return action[ "hit" ];
    else
    {
        verb = verbs[ random( sizeof( verbs ) ) ];
        if ( !undefinedp( action[ verb ] ) )
            return action[ verb ];
        else
            return action[ "hit" ];
    }
}

string query_parry_msg(object weapon)
{
    if ( objectp( weapon ) )
        return parry_msg[random(sizeof(parry_msg))];
    else
        return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}


