
nosave mapping tasks = ([
    "kill xiao er" : ([
        "begin"     : ([
            "time"      : 0,                 //时间，如某月某日，则在此时发生
                                             //如 0 则随便。。pig trill
            "site"      : "yangzhou",        //地点：特定的房间名，或是目录名
                                             //如是目录名必须是/d/city下的。
            "character" : 0,                 //new出一个***放在当前房间内
                                             //pig trill 为什么不能放在指定房间
            "message"   : "杀了 xiao er.\n", //玩家看见的信息。。pig trill
            "bonus"     : -1,                //可以是物品(文件名)
                                             // ，用来先期给。。
            "perform"   : "kill_lnwm",       //给任务时同时作用的函数。。
                                             //好象没有好。。:(( pig trill
            "follow"    : 1,                 //说明这个任务是个后继任务
                                             //必然是由其他任务后继而来
                                             //不可能作为第一步任务
                                             //如没有follow或为0则无效 
        ]),
        "event"     : ([
            "verb"      : "kill",            //决定event的类型
                                             //目下有kill give send buy learn
            "event"     : "kill xiao er",    //只判断 id  (如果有重名怎么办？)
        ]) ,          
        "success"   : ([
            "message"   : "很好.\n",         //成功的message。
            "bonus"     : 10,                //成功的奖励
                                             //也可以是物品(文件名)
            "perform"   : "kill_lnwm",       //成功使调用的函数。。
                                             //pig trill
            "follow"    : "buy jicai baozi", //后继任务，可以缺省
        ]),
        "fail"      : ([
            "message"   : "笨的象lnwm了....杀个xiao er也这么慢.\n",
            "bonus"     : -1,                 //也可以是物品(文件名)
            "follow"    : "buy jicai baozi",  //后继任务
            "perform"   : "kill_trill",       //惩罚函数    
        ]),
        "time"      : 60,                     //任务时间，单位秒
    ]),
    "buy jicai baozi" : ([
        "begin"     : ([
            "time"      : 0,
            "site"      : "yangzhou",
            "character" : 0,
            "message"   : "buy a jicai baozi.......\n",
            "bonus"     : -1,
        ]),
        "event"     : ([
            "verb"      : "buy",
            "event"     : "buy jicai baozi",
        ]) ,
        "success"   : ([
            "message"   : "baozi 很好.\n\n\n",
            "bonus"     : 10,
        ]),
        "fail"      : ([
            "message"   : "连lnwm都不如, buy东西都不会.\n",
            "bonus"     : -3,
        ]),
        "time"      : 10,
    ]),
    "give baozi to xiaoer" : ([
        "begin"     : ([
            "time"      : 0,
            "site"      : "yangzhou",
            "character" : 0,
            "message"   : "give a jicai baozi to xiao er",
            "bonus"     : 2, 
        ]),
        "event"     : ([
            "verb"      : "give",
            "event"     : "give jicai baozi to xiao er",
        ]),
        "success"   : ([
            "message"   : "xiao er say: baozi 很好.\n\n\n",
            "bonus"     : 10,
        ]),
        "fail"      : ([
            "message"   : "连lnwm都不如, give东西都不会.\n",
            "bonus"     : -3,
        ]),
        "time"      : 1000,
    ]),
    "send baozi to xiaoer" : ([
        "begin"     : ([
            "time"      : 0,
            "site"      : "yangzhou",
            "character" : 0,
            "message"   : "send a jicai baozi to xiao er",
            "bonus"     : FOOD_DIR + "jicai", 
        ]),
        "event"     : ([
            "verb"      : "give",
            "event"     : "give jicai baozi to xiao er",
        ]),
        "success"   : ([
            "message"   : "xiao er say: baozi 很好.\n\n\n",
            "bonus"     : 10,
        ]),
        "fail"      : ([
            "message"   : "连lnwm都不如, send东西都不会.\n",
            "bonus"     : -3,
        ]),
        "time"      : 1000,
    ]),
    "learn 10 baxian-zhang" : ([
        "begin"     : ([
            "time"      : 0,
            "site"      : "yangzhou",
            "character" : 0,
            "message"   : "learn 10 baxian-zhang",
        ]),
        "event"     : ([
            "verb"      : "give",
            "event"     : "learn 10 baxian-zhang",
        ]),
        "success"   : ([
            "message"   : "baxian-zhang 很好.\n\n\n",
            "bonus"     : 10,
        ]),
        "fail"      : ([
            "message"   : "连lnwm都不如, 学东西都不会.\n",
            "bonus"     : -3,
        ]),
        "time"      : 1000,
    ]),
]); 


