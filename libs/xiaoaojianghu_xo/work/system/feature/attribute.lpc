// filename : /feature/attribute.c

#include <dbase.h>

int query_str()
{
    int eff_str;

    if ( (int)query("force") >= (int)query("force_factor"))
        eff_str = (int)query("force_factor");
    eff_str += (int)query("str") + query_temp("apply/strength") 
                + query("gifts_modify/str");
    return eff_str;
}

int query_cor()
{
    return (int)query("cor") + (int)query("bellicosity") / 50
        + query_temp("apply/courage") + query("gifts_modify/cor");
}

int query_int()
{
    return (int)query("int") + query("gifts_modify/int")
        + query_temp("apply/intelligence");
}

int query_spi()
{
    return (int)query("spi") + query("gifts_modify/spi")
        + query_temp("apply/spirituality");
}

int query_cps()
{
    return (int)query("cps") + (int)query("force_factor") / 2
        + query_temp("apply/composure") + query("gifts_modify/cps");
}

int query_per()
{
    return (int)query("per") + query("gifts_modify/per")
        + query_temp("apply/personality");
}

int query_con()
{
    return (int)query("con") + query("gifts_modify/con")
        + query_temp("apply/constitution");
}

int query_kar()
{
    return (int)query("kar") + query("gifts_modify/kar")
        + query_temp("apply/karma");
}

int query_dex()
{
    return (int)query("dex") + query("gifts_modify/dex") 
        + query_temp("apply/dex");
}

int query_age()
{
    object me = this_object();
    int age, zhuyan;
    string force;

    age = query("age");
    if ( age <= 18 ) return age;
    force = query( "using_force" );
    if ( force )
        age -= me->query_lingwu( force ) / 10 * SKILL_D( force )->query_zhuyan();
    zhuyan = me->query_lingwu("zhuyan-shu");
    age -= zhuyan / 5;
    if ( zhuyan == 200 ) age = 18;
    return ( age < 18 ) ? 18 : age;
}


