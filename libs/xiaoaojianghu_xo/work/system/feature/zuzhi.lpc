mapping group;

string * GetZuzhiName()
{
    string *name;
    int i,num;
    if ( !group )
        return ({});
    num = JoinedZuzhiNumber();
    name = allocate( num );
    for ( i = 0; i < num; i++ )
        name[ i ] = ZuzhiName( keys( group )[ i ] );
    return name;
}
string * GetZuzhiId()
{
    string *id;
    int i,num;
    if ( !group )
        return ({});
    num = JoinedZuzhiNumber();
    id = allocate( num );
    for ( i = 0; i < num; i++ )
        id[ i ] = ZuzhiId( keys( group )[ i ] );
    return id;
}
int IsMemberOf( string zuzhiname )
{
    string *zuzhi;
    int i;
    if ( file_size( ZUZHI_DIR + zuzhiname + ".lpc" ) < 0 )
        return 0;
    zuzhi = GetZuzhiId();
    if ( !zuzhi )
        return 0;
    for ( i = 0; i < sizeof( zuzhi ); i++ )
        if ( zuzhi[ i ] == zuzhiname && !group[ zuzhi[i] ][ "deleted" ] )
            return 1;
    return 0;
}
int JoinedZuzhiNumber()
{
    if ( !group )
        return 0;
    return sizeof( keys( group ) );
}
mapping GetZuzhi( string zuzhiname )
{
    if( !group )
        return ([]);
    if( !group[ zuzhiname ] )
        return ([]);
    return group[ zuzhiname ];
}
string ZuzhiName( string zuzhiname )
{
    return GetZuzhi( zuzhiname )[ "name" ];
}
string ZuzhiId( string zuzhiname )
{
    return GetZuzhi( zuzhiname )[ "id" ];
}
string ZuzhiTouxian( string zuzhiname )
{
    return GetZuzhi( zuzhiname )[ "touxian" ];
}
string ZuzhiZhiwu( string zuzhiname )
{
    return GetZuzhi( zuzhiname )[ "zhiwu" ];
}
int EnterZuzhiTime( string zuzhiname )
{
    return GetZuzhi( zuzhiname )[ "entertime" ];
}
int ZuzhiScore( string zuzhiname )
{
    return GetZuzhi( zuzhiname )[ "score" ];
}
int ZuzhiTouxianJibie( string zuzhiname )
{
    string * all_touxian;
    int jibie,i;
    string touxian; 

    all_touxian = ( ZUZHI_DIR + zuzhiname )->QueryTouxian( this_object() );
    touxian = ZuzhiTouxian( zuzhiname );
    jibie = 0;
    for( i=0; i < sizeof( all_touxian ); i++ )
        if ( touxian == all_touxian[i] )
            jibie = i;
    return jibie; 
}
int ZuzhiZhiwuJibie( string zuzhiname )
{
    string * all_zhiwu;
    int jibie,i;
    string zhiwu; 

    all_zhiwu = ( ZUZHI_DIR + zuzhiname )->QueryZhiwu( this_object() );
    zhiwu = ZuzhiZhiwu( zuzhiname );
    jibie = 0;
    for( i=0; i < sizeof( all_zhiwu ); i++ )
        if ( zhiwu = all_zhiwu[i] )
            jibie = i;
    return jibie; 
}
int LastContactTime( string zuzhiname )
{
    return GetZuzhi( zuzhiname )[ "lastcontacttime" ];
}
void JoinZuzhi( string zuzhiname, string touxian, string zhiwu )
{
    group = ZUZHI_D->SetupZuzhi( this_object(), zuzhiname, touxian, zhiwu, group );
    return;
}
void IncreaseZuzhiTouxian( string zuzhiname, int step )
{
    string * all_touxian;
    string touxian;
    int i,jibie;
  
    all_touxian = ( ZUZHI_DIR + zuzhiname )->QueryTouxian( this_object() );
    jibie = ZuzhiTouxianJibie( zuzhiname ) + step;
    if ( jibie < 0 )
        jibie = 0;
    if ( jibie > sizeof( all_touxian ) )
        jibie = sizeof( all_touxian );
    SetZuzhiTouxian( zuzhiname, all_touxian[ jibie ] );
    return;
}
int SetZuzhiTouxian( string zuzhiname, string touxian )
{
    group[ zuzhiname ][ "touxian" ] = touxian;
    return 1;
}
int SetZuzhiZhiwu( string zuzhiname, string zhiwu )
{
    group[ zuzhiname ][ "zhiwu" ] = zhiwu;
    return 1;
}
int DoneContact( string zuzhiname )
{
    group[ zuzhiname ][ "lastcontacttime" ] = this_object()->query("mud_age");
    return 1;
}
int SetZuzhiName( string zuzhiname, string name )
{
    group[ zuzhiname ][ "name" ] = name;
    return 1;
}
int SetZuzhiScore( string zuzhiname, int score )
{
    group[ zuzhiname ][ "score" ] = score;
    return 1;
}
int AddZuzhiScore( string zuzhiname, int score )
{
    group[ zuzhiname ][ "score" ] = ZuzhiScore( zuzhiname ) + score;
    return 1;
}
void LeaveZuzhi( string zuzhiname )
{
    group = ZUZHI_D->DeleteZuzhi( this_object(), zuzhiname, group );
    return;
}
int IsRefusedBy( string zuzhiname )
{
    string *family, *zuzhi;
    int i;
    zuzhi = ( ZUZHI_DIR + zuzhiname  )->RefusedZuzhi();
    family = ( ZUZHI_DIR + zuzhiname  )->RefusedFamily();
    for ( i = 1; i < sizeof( family ); i++ )
        if ( query("family/family_name") == family[ i ] )
            return 1;
    for ( i = 1; i < sizeof( zuzhi ); i++ )
        if ( IsMemberOf( zuzhi[ i ] ) )
            return 1;
    return 0;
}
int IsBossOf( object mate, string zuzhiname )
{
    int my_jibie, his_jibie;
    if ( !IsMemberOf( zuzhiname ) || !mate->IsMemberOf( zuzhiname ) )
        return 0;
    my_jibie = ZuzhiTouxianJibie( zuzhiname );
    his_jibie = mate->ZuzhiTouxianJibie( zuzhiname );
    if ( my_jibie > his_jibie )
        return 1;
    return 0;
}


int is_chairman_of( object chairman )
{
    mapping zuzhi;

    if ( !mapp( zuzhi = query( "zuzhi" ) ) )
        return 0;

    if ( zuzhi[ "chairman_id" ] == (string)chairman->query( "id" ) &&
         zuzhi[ "chairman_name" ] == (string)chairman->query( "name" ) )
        return 1;

    return 0;
}

int is_tongshi_of(object obj)
{
    mapping my_zuzhi, your_zuzhi;

    my_zuzhi = query("zuzhi");
    your_zuzhi = obj->query("zuzhi");
    if ( !mapp( my_zuzhi ) || !mapp( your_zuzhi ) )
        return 0;

    if ( my_zuzhi[ "zuzhi_name" ] == your_zuzhi[ "zuzhi_name" ] )
    {
        return 1;
    }
    return 0;
}

int in_samezuzhi_with(object obj)
{
    string *MyZuzhi, *UrZuzhi;

    MyZuzhi = GetZuzhiId();
    UrZuzhi = obj->GetZuzhiId();
    if ( !arrayp( MyZuzhi ) || !arrayp( UrZuzhi ) )
        return 0;

    foreach( string Zuzhi in MyZuzhi )
    {
        if ( member_array( Zuzhi, UrZuzhi ) != -1 )
            return 1;
    }
    return 0;
}

void assign_chengyuan(string title, int privs)
{
    mapping zuzhi;

    if ( !mapp( zuzhi = query("zuzhi") ) )
        return;

    zuzhi[ "title" ] = title;
    zuzhi[ "privs" ] = privs;

    if ( userp( this_object() ) || !query( "title" ) )
    {
        if ( zuzhi[ "generation" ] == 1 )
        {
            if ( zuzhi[ "title" ] )
                set( "title", sprintf( "%s%s", zuzhi[ "zuzhi_name" ],
                    zuzhi[ "title" ] ) );
            else
                set( "title", zuzhi[ "zuzhi_name" ] + "大首领" );
        }
        else
            set( "title", sprintf( "%s%s", zuzhi[ "zuzhi_name" ],
                zuzhi[ "title" ] ) );
    }

}

// This is used for NPC, or start a new zuzhi for a player.
varargs void create_zuzhi(string zuzhi_name, int generation, string title)
{
    mapping zuzhi;

    zuzhi = allocate_mapping( 6 );

    zuzhi[ "zuzhi_name" ] = zuzhi_name;
    zuzhi[ "generation" ] = generation;

    set( "zuzhi", zuzhi );

    // priv = -1 for ALL privileges.
    assign_chengyuan( title, -1 );
}

varargs int recruit_chengyuan(object dizi, string title)
{
    mapping my_zuzhi, zuzhi;

    if ( dizi->is_shouxia_of( this_object() ) )
        return 0;
    if ( !mapp( my_zuzhi = query( "zuzhi" ) ) )
        return 0;
    if ( !title ) title = "弟子";
    zuzhi = allocate_mapping( sizeof( my_zuzhi ) );
    zuzhi[ "chairman_id" ] = query( "id" );
    zuzhi[ "chairman_name" ] = query( "name" );
    zuzhi[ "zuzhi_name" ] = my_zuzhi[ "zuzhi_name" ];
    zuzhi[ "generation" ] = my_zuzhi[ "generation" ] + 1;
    zuzhi[ "enter_time" ] = time();
    dizi->set( "zuzhi", zuzhi );
    dizi->assign_chengyuan( title, 0 );
    LOG_D->do_log( dizi, sprintf( "你加入%s的%s，成为%s。",
        zuzhi[ "chairman_name" ], zuzhi[ "zuzhi_name" ],
         dizi->query( "title" ) ) );
    return 1;
}

string get_tongshi_guanxi(object obj)
{
    object me;
    mapping my_zuzhi, your_zuzhi;
    int my_gen, your_gen;
    int my_time, your_time;
    string my_gender;

    me = this_object();
    my_zuzhi = me->query( "zuzhi" );
    your_zuzhi = obj->query( "zuzhi" );

    if ( your_zuzhi[ "title" ] ) return your_zuzhi[ "title" ];

    if (( obj != me ) && mapp( my_zuzhi ) && mapp( your_zuzhi ) &&
        ( my_zuzhi[ "zuzhi_name" ] == your_zuzhi[ "zuzhi_name" ] ))
    {
        my_gen = my_zuzhi[ "generation" ];
        your_gen = your_zuzhi[ "generation" ];
        my_time = my_zuzhi[ "enter_time" ];
        your_time = your_zuzhi[ "enter_time" ];
        my_gender = me->query( "gender" );
        if ( my_gen == your_gen )
        {
            if ( my_gender == "男性" || my_gender == "无性" )
            {
                if ( my_time < your_time )
                    return "大哥";
                else
                    return "贤弟";
            }
            else
            {
                if ( my_time < your_time )
                    return "大姐";
                else
                    return "小妹";
            }
        }
        else if ( my_gen > your_gen )
        {
            return "属下";
        }
        else
        {
            if ( your_zuzhi[ "chairman_id" ] == me->query( "id" ) )
                return "在下";
            else
                return "先生";
        }
    }
    return 0;
}



