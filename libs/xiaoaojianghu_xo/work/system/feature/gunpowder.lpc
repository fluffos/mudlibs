#include <dbase.h>
#include <name.h>
#include <ansi.h>

int status = 0;
int delay_time = 0;
int explode_power = 0;

varargs void init_gunpowder(int power, int delay)
{
    explode_power = power;
    delay_time = delay;
}

int egnight()
{
    if ( status ) return 0;
    status = 1;
    call_out("exploding", delay_time);
    return explode_power;
}

varargs int explode( object victim, string msg )
{
    object obj= this_object(), *inv;
    int power,i;

    status = 2;
    while ( remove_call_out("explode") != -1);

    if ( !objectp( victim )) victim = environment(obj);

    if ( stringp(msg))
        message_vision( msg, obj, victim);
    else if ( victim->is_character() && !victim->is_corpse())
        message_vision("震动之下，$n怀里的$N“"RED"轰"NOR"”的一声炸了开来！\n", obj, victim);
    else if ( victim->is_room())
        message_vision("“轰”的一声，一股黑烟冲天而起！\n", obj);
    else if ( objectp(victim) )
        message_vision("只听“"YEL"砰"NOR"”的一声，$n里的$N炸了开来！\n", obj, victim);

    power = explode_power;

    inv = all_inventory( victim );
    for ( i = 0; i < sizeof(inv); i++)
        if( objectp(inv[i]) && inv[i]->is_gunpowder()) power += inv[i]->explode( victim );
    //嵌套式的调用，使得inv[i]可能已经被解构了。因此，objectp(inv[i])是必须的。

/*    if ( stringp(msg))
        for ( i = 0; i < sizeof(inv); i++)
            if( inv[i]->is_gunpowder()) power += inv[i]->explode( victim );
            else inv[i]->set("name","破破烂烂的"+inv[i]->name());
*/            
    if ( victim->is_gunpowder())
        message_vision("震动之下，$N“"RED"轰"NOR"”的一声也炸了开来！\n", victim);

    if ( !stringp(msg)) destruct( obj );

    return power;
}

int is_gunpowder()
{
    if ( status != 2 )
        return explode_power;
    else return 0;
}

void exploding()
{
    object obj= this_object(), victim;
    int power;

    victim = environment(obj);
    if ( victim->is_character() && !victim->is_corpse())
    {
        power = explode( victim , "$n怀里的$N“"RED"轰"NOR"”的一声炸了开来！\n");
        victim->recieve_wound( power );
    }
    else if ( victim->is_room() )
    {
        explode( victim , "“轰”的一声，一股黑烟冲天而起！\n" );
    }
    else 
    {
        explode( victim , "只听“"YEL"砰"NOR"”的一声，$n里的$N炸了开来！\n" ); 
        destruct( victim );
    }
    destruct( obj );
}

