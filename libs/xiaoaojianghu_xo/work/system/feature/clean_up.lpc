// filename : /feature/clean_up.c

int clean_up() {
  object *inv;
  int i;

  if (!clonep() && this_object()->query("no_clean_up"))
    return 1;

  if (interactive(this_object()))
    return 1;

  if (environment())
    return environment()->clean_up();

  inv = all_inventory();
  for (i = sizeof(inv) - 1; i >= 0; i--)
    if (interactive(inv[i]))
      return 1;

  destruct(this_object());
  log_file("clean_up", sprintf("%O was cleaned up at %s", this_object(), ctime(time())));
  return 0;
}
