    "zhaoshi": "「击鼓式」",
    "damage": 90,
    "parry": 0,
    "dodge": 0,
    "jibie": 30,
    "sen": 12,
    "damage_type": "淤伤",
  ]),
  ([ "action": "$N双手平提胸前，左手护住面门，一招「抱残式」右手推向$n的$l",
