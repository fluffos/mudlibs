    "zhaoshi": "「捕风式」",
    "damage": 60,
    "parry": 30,
    "dodge": 20,
    "jibie": 50,
    "sen": 10,
    "damage_type": "淤伤",
  ]),
  ([ "action": "$N猛地向前跃出，一招「捉影式」，两腿踢出，双手抓向$n的面门",
    "lian": "$N猛地向前跃出，一招「捉影式」，两腿踢出，双手乱抓一气。",
    "zhaoshi": "「捉影式」",
    "damage": 70,
    "parry": 40,
    "dodge": 10,
    "jibie": 10,
