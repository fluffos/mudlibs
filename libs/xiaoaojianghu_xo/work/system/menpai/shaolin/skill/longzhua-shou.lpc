    "zhaoshi": "「抱残式」",
    "damage": 70,
    "parry": 80,
    "dodge": 0,
    "jibie": 40,
    "sen": 8,
    "damage_type": "淤伤",
  ]),
  ([ "action": "$N两手胸前环抱，腋下含空，五指如钩，一招「守缺式」插向$n的顶门",
    "lian": "$N两手胸前环抱，腋下含空，五指如钩，一招「守缺式」由上而下一插。",
    "zhaoshi": "「守缺式」",
    "damage": 100,
    "parry": 0,
    "dodge": 0,
    "jibie": 50,
    "sen": 11,
    "damage_type": "淤伤",
  ]),
  ([ "action": "$N右腿斜插$n二腿之间，一招「抢珠式」，上手取目，下手反勾$n的裆部",
    "lian": "$N右腿斜跨一步，一招「抢珠式」，上手取目，下手迅速反勾。",
    "zhaoshi": "「抢珠式」",
    "damage": 80,
    "parry": 50,
    "dodge": 50,
    "jibie": 30,
    "sen": 12,
    "damage_type": "淤伤",
  ]),
  ([ "action": "$N一手虚指$n的剑诀，一招「夺剑式」，一手劈空向$n的手上一抓",
    "lian": "$N一手二指捏了个剑诀，一招「夺剑式」，一手劈空一抓。",
    "zhaoshi": "「夺剑式」",
    "damage": 100,
    "parry": 10,
    "dodge": 0,
    "jibie": 100,
    "sen": 10,
    "damage_type": "淤伤",
  ]),
});

string *parry_msg = ({
  "只见$n以攻代守，腾步上前，左手护胸，右手探出，一招「掏虚式」击向$n的裆部。",
  "但见$n右手虚握，左手掌立如山，一招「批亢式」，格开了$N的攻势。",
  "$N左手指向$n胸前的五道大穴，右手斜指太阳穴，一招「拿云式」反而使$n进退两难。",
  "$N前脚着地，一手顶天成爪，一手指地，一招「追日式」劲气笼罩$n的全身。",
});

int valid_learn(object me) {
  if ((int)me->query("max_force") < 300)
    return notify_fail("你的内力不足，强练龙爪手会走火入魔。\n");
  if ((int)me->query("yang") < 50)    // 不知道确切是多少？
    return notify_fail("龙爪手须阳刚的内力，你的内力不适合练龙爪手。\n");
  if ((int)me->query_lingwu("shaolin-neigong") < 70)
    return notify_fail("你的少林内功火候不足，还须多加练习。\n");
  if ((int)me->query_temp("weapon"))
    return notify_fail("你必须空手练习龙爪手。\n");
  return 1;
}

int valid_lian(object me) {
  return valid_learn(me);
}

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_zhaoshi(int jibie) {
  int i;
  for (i = 0; i < sizeof(action); i++) {
    if (action[i]["jibie"] >= jibie)
      return action[i]["zhaoshi"];
  }
  return 0;
}

string query_xiuwei_type() { return "unarmed"; }

string query_weapon_type() { return "unarmed"; }

int query_dengji() { return 6; }

int query_youxiao_jibie() { return 12; }

int query_parry_ratio() { return 10; }

string query_parry_msg(object weapon) {
  return parry_msg[random(sizeof(parry_msg))];
}   //这里很奇怪，有weapon就不应该call this query_parry_msg,对不对？
