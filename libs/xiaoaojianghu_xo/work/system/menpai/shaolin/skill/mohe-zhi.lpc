// mohe-zhi.c -摩诃指                                    
                                                                                
inherit SKILL;                                                                  
                                                                                
mapping *action = ({                                                            
([      "action" : "$N心如止水，使出「佛心兰花」，五指拢作兰花状，向拂去",    
        "lian"      :"$N五指拢作兰花状，体会「佛心兰花」，旁人还以为你想吃鸡爪了。",              
        "jibie"     :6,
        "sen"       :9,
        "dodge"     :0,
        "parry"     :30,
        "force"     :30,
        "damage"    :10,
        "zhaoshi" : "佛心兰花",
        "damage_type" : "刺伤"
]),
([      "action" : "$N纵身一跃，一招「龙指天下」，十指居高临下，以泰山压顶之势向袭去。",  
        "lian"      :"$N纵身一跃，使出一招「龙指天下」，但好象有些不得要领。",
        "jibie"     :13,
        "sen"       :8,
        "dodge"     :30,
        "parry"     :10,
        "force"     :20,
        "damage"    :19,
        "zhaoshi" : "龙指天下",
        "damage_type" : "刺伤"
]),
([      "action" : "$N闻风先动，抢先一招「佛手降魔」，十指隐着丝丝劲风，向全身各大要害指去。",  
        "lian"      :"$N十指微动，使出「佛手降魔」，十指间隐着丝丝劲风。",
        "jibie"     :20,
        "sen"       :9,
        "dodge"     :40,
        "parry"     :30,
        "force"     :40,
        "damage"    :40,
        "zhaoshi" : "佛手降魔",
        "damage_type" : "刺伤"
]),
([      "action" : "$N使出「弹指惊雷」，扣起中指，运力弹开，只见一道光芒以迅雷不及掩耳之势向面门冲去。",
        "lian"      :"$N扣起中指，运力弹开，正是一招「弹指惊雷」。",
        "jibie"     :27,
        "sen"       :10,
        "dodge"     :0,
        "parry"     :40,
        "force"     :20,
        "damage"    :30,
        "zhaoshi" : "弹指惊雷",
        "damage_type" : "刺伤"
]),
([      "action" : "$N后退两尺，使出「佛光灌顶」，右手中指微弹，一道详和的瑞光向的印堂飞去。",
        "lian"      :"$N右手中指慢慢抬起，体会「佛光灌顶」的气势。",
        "jibie"     :36,
        "sen"       :10,
        "dodge"     :30,
        "parry"     :0,
        "force"     :40,
        "damage"    :50,
        "zhaoshi" : "佛光灌顶",
        "damage_type" : "刺伤"
]),
([      "action" : "$N使出「罗汉御魔」，左手引开视线，右手五指叉开，指尖带着淡淡金光，向咽喉叉去。",
        "lian"      :"$N左右手配合，使出「罗汉御魔」，招式甚为漂亮。",              
        "jibie"     :44,
        "sen"       :11,
        "dodge"     :50,
        "parry"     :20,
        "force"     :20,
        "damage"    :43,
        "zhaoshi" : "罗汉御魔",
        "damage_type" : "刺伤"
]),                                                                             
([      "action" : "$N无我无心，倒飘两尺开外，右手中指遥指丹田，一道淡金色光芒直飞出去，气势浩然。",
        "lian"      :"$N闭目盘膝而坐，心念「佛指天心」，右手指尖似有金光流动。",
        "jibie"     :52,
        "sen"       :11,
        "dodge"     :20,
        "parry"     :40,
        "force"     :30,
        "damage"    :50,
        "zhaoshi" : "佛指天心",
        "damage_type" : "刺伤"
]),
([      "action" : "$N抖擞精神，使出「地狱擒魔」，十指间金光暴现，像无数利剑，将全身笼罩。",
        "lian"      :"$N凝神聚气，体会「地狱擒魔」，身着的衣服无风自动。",              
        "jibie"     :64,
        "sen"       :10,
        "dodge"     :60,
        "parry"     :20,
        "force"     :50,
        "damage"    :60,
        "zhaoshi" : "地狱擒魔",
        "damage_type" : "刺伤"
]),
});

string *parry_msg = ({
    "$n一招「龙指天下」，立右掌护住上三路，伸左拳挡向下盘，封得密不透风。\n", 
    "$n使出「弹指惊雷」，一指弹出，罡风后发先至，扑向面门，赶紧收招。\n"
    "$n临危不慌，使出「罗汉御魔」，十指微动，几道金光交错成网，根本攻不进去。\n", 
    "$n心无旁骛，指尖轻点，直袭招中破绽之处，将攻势击散于无形。\n",     
});                                                                             

string *unarmed_parry_msg = ({
    "$n一招「龙指天下」，立右掌护住上三路，伸左拳挡向下盘，封得密不透风。\n", 
    "$n使出「弹指惊雷」，一指弹出，罡风后发先至，扑向面门，赶紧收招。\n"
    "$n临危不慌，使出「罗汉御魔」，十指微动，几道金光交错成网，根本攻不进去。\n", 
    "$n心无旁骛，指尖轻点，直袭招中破绽之处，将攻势击散于无形。\n",     
});                                                                             
                                                                                
int valid_learn(object me)                                                      
{                                                                               
        if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))     
                return notify_fail("练摩诃指必须空手。\n");                     
        if ((int)me->query("max_force") < 900) 
                return notify_fail("你的内力太弱，无法练摩诃指。\n");           
        return 1;
}                                                                               
                                                                                
int valid_lian( object me )
{
    if( me->query_temp("weapon"))
        return notify_fail("拿着剑练爪法，开玩笑吧。\n");
    return valid_learn( me );
}

string query_xiuwei_type() { return "unarmed"; } 

string query_weapon_type() { return "unarmed"; }

int query_dengji() { return 5; }

mapping query_action(int jibie)
{
        int i, size;

        size = sizeof( action );
        for ( i = 0; i < sizeof( action ); i++ )
                if ( action[ i ][ "jibie" ] > jibie )
                {
                        size = i;
                        break;
                }
    return action[ random( size ) ];
}

string query_parry_msg(object weapon)
{   
    if ( !weapon )
        return parry_msg[random(sizeof(parry_msg))];
    else
        return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi( int jibie )
{
    int i;
    for ( i = 0; i < sizeof(action); i++ )
    {
        if ( action[ i ][ "jibie" ] >= jibie )
            return action[ i ][ "zhaoshi" ];
    }
    return "";
}

int query_youxiao_jibie() { return 10; }

int query_parry_ratio() { return 11 ; }

