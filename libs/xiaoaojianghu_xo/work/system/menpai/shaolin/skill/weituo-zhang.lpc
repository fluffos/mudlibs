string *parry_msg = ({
    "$n双掌合什，一招「灵山礼佛」，内力隐隐罩住全身之下，衣袂早以鼓荡而起。\n",
    "$n使一招「恒河入海」，硬将$N的攻势逼向右侧。\n",
    "$n使一招「山门护法」，双掌翻出，硬接$N的攻势。\n",
    "$n「长虹贯日」，攻敌所必救。$N不得不抽招换式，先图自保。\n",
});


int valid_learn(object me)
{
        if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
                return notify_fail("练韦陀掌必须空手。\n");
        if( (int)me->query("max_force") < 100 )
                return notify_fail("你的内力太弱，无法练习韦陀掌。\n");
        return 1;
}

int valid_lian( object me )
{
        object weapon;

        weapon = me->query_temp( "weapon" );
    if ( weapon)
        return notify_fail("你必须先把手中的兵刃放下。\n");

        return 1;
}

string query_xiuwei_type()
{
        return "unarmed";
}

string query_weapon_type()
{
    return "unarmed";
}

mapping query_action(int jibie)
{
        int i, size;

        size = sizeof( action );
        for ( i = 0; i < sizeof( action ); i++ )
                if ( action[ i ][ "jibie" ] > jibie )
                {
                        size = i;
                        break;
                }
    return action[ random( size ) ];
}

int query_dengji()
{
        return 2;
}

int query_youxiao_jibie()
{
    return 9;
}

int query_parry_ration()
{
    return 12;
}

string query_parry_msg(object weapon)
{
                return parry_msg[random(sizeof(parry_msg))];
}

