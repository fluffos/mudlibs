// 凤翔镖局 

int is_benmen_wugong(string skill) {
  switch (skill) {
    case "chusuifeng":
    case "xingyun-shenfa":
    case "feiying-zhang":
    case "chuiliu-jianfa":
    case "fengxiang-jianfa":
    case "jiben-jianshu":
    case "changquan":
    case "jiben-quanfa":
    case "baxian-jian":
    case "baxian-zhang":
    case "baxian-shenfa":
    case "penglai-xinfa":
    case "haoran-zhengqi":
    case "jiben-qinggong":
    case "wuliang-shenfa":
    case "yanxing":
    case "sword":
    case "wuliang-jian":
      return 1;

    default:
      return 0;
  }
}
