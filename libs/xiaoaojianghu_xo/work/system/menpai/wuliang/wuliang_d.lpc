//
// 无量剑派

// 判断给定的武功是否是无量的武功
int is_benmen_wugong(string skill) {
  switch (skill) {
    case "unarmed":
    case "wuliang-jian":
    case "liuyun-jian":
    case "wuliang-shenfa":
    case "yanxing":
    case "taizu-quan":
    case "literate":
    case "lingxiao-shou":
    case "nanshan-liushi":
    case "sword":
    case "jiben-qinggong":
    case "haoran-zhengqi":
      return 1;

    default:
      return 0;
  }
}
