// zuo_zimu.c

#define QUEST(x) ("/d/menpai/wuliang/quest/quest"+x)

inherit NPC;
inherit F_MASTER;

#include <ansi.h>
#include "east_master.h"

int time_period(int timep, object me);
//string ask_me(object who);
string change_master(object who);
string master_name(object me);

void create()
{
    set_name("左子穆", ({ "zuo zimu", "zuo", "zimu" }) );
    set("class","swordsman");
    set("gender", "男性" );
    set("age", 50);
    set("str", 30);
    set("cor", 30);
    set("cps", 30);
    set("int", 25);
    set("ker", 24);
    set("kar", 30);
    set("max_force", 1500);
    set("force", 1500);
    set("force_factor", 3);

    set("rank_info/respect", "左先生");
        set("class","swordsman");

    set("long","左子穆身材极为高大，目光犀利，但也儒雅有礼，显然曾读过不少书。\n");

    create_family("无量剑派东宗", 5,"掌门人");

    set("combat_exp", 1000000);
    set("social_exp", 200000);

    set_wugong("lingxiao-shou",100);
    set_wugong("nanshan-liushi", 70);
        set_wugong("force",50);
    set_wugong("literate", 40);
    set_wugong("haoran-zhengqi", 60); 
    set_wugong("wuliang-jian", 100);
        set_wugong("wl-shenfa",120);
    set_wugong("liuyun-jian",120);
    set("inquiry", ([
        "此地" : "这里便是无量剑派。",
        "姓名" : "嗯，你既知我姓左，怎会不知在下便是无量东宗掌门人左子穆？",
        "指点武功" : (: change_master :),
    ]) );

    setup();
    carry_object(__DIR__"obj/xuanquan")->wield();
    carry_object(__DIR__"obj/choushan")->wear();
}

void init()
{
    object this, env, me;

    add_action( "do_kneel", ({ "kneel", "ketou" }) );
    //add_action("give_quest", "quest");

    this = this_object();
    env = environment( this );
    me = this_player();
    if (( env->query( "short" ) == "侧厅" ) &&
        ( this->query_temp( "bai_zuo" ) == me->query( "id" ) ))
    {
        remove_call_out( "tell_mengui" );
        call_out( "tell_mengui", 1, me );
    }
}

// 这儿我希望实现的是当 ppl 拜了 zuo 以后, zuo 走去侧厅等待 ppl 完成拜师
// 仪式. 可能出现的意外情况是 ppl 不过去, 这种情况 zuo 会记住谁放了他鸽
// 子, 在这次 MUD 运行中就拒收这个 ppl.
int attempt_apprentice(object me)
{
    object this, env;
    string my_id;

    my_id = me->query( "id" );
    this = this_object();
    env = environment( this );
    if ( env->query("short") == "侧厅" )
    {
        message_vision("左子穆向东一指，对$N说：你先去大厅等我。\n", me);
        return 1;
    }
    if ( env->query("short") != "大厅" )
    {
        message_vision("左子穆说：一切从权吧，入了我门，可得守规矩呀。。。\n", me);
        command( "recruit " + me->query("id") );        
        message_vision("左子穆对$N说：什么时候你再去跟老高领把剑吧。”\n", me);
        return 1;
    }
    if ( this->query_temp( "bai_list/" + my_id ) )
    {
        command( "heng " + my_id );
        message_vision("左子穆冷冷地对$N说：你品性不正，不配入我门。\n", me);
        return 1;
    }
    command( "nod " + my_id );
    this->set_temp( "bai_zuo", my_id );
    this->set_temp( "bai_list/" + my_id, 1 );
    call_out( "back_dating", 30 );
    message_vision("左子穆对$N说：既然这样，先随我去拜过了祖师。\n", me);
    command( "go west" );
}

void back_dating()
{
    if ( environment( this_object() )->query("short") == "侧厅" )
    {
        command( "go east" );
    }
}

void tell_mengui( object me )
{
    message_vision(YEL@MSG
左子穆对$N说: 既然入我门下，第一便是要恪守本派门规。你听好了，我无量剑派

        首戒欺师灭祖，不敬尊长；  二戒同门操戈，兄弟不和。
        三戒心猿意马，不用心练功；四戒恃强凌弱，擅伤无辜。
        五戒奸淫好色，调戏妇女；  六戒口出妄言，行事不正。
        
这些门规，你要记牢了，如有违反，我定严惩不殆！！
好了，给祖师爷磕头吧！
MSG NOR, me);
    me->set_temp( "bai_zuo", 1 );
}

int do_kneel(string arg)
{
    object sword, me, this;
    mapping family;

    me = this_player();
    this = this_object();
    if ( environment( this )->query("short") != "侧厅" )
    {
        tell_object( me, "你打算给谁磕头啊？\n" ); 
        return 1;
    }
    if ( me->query_temp( "bai_zuo" ) )
    {
        message_vision("$N对着墙上挂着的祖师像拜了八拜，站起身来。\n", me);
        message_vision("左子穆高兴对$N笑了笑，说：很好很好。\n", me);
        message_vision("$n决定收$N为弟子。\n\n"
                "$N跪了下来向$N恭恭敬敬地磕了四个响头，叫道：「师父！」\n",
                me, this);
        recruit_apprentice( me );
        family = me->query("family");
        tell_object( me,
            sprintf("恭喜您成为%s的第%s代弟子。\n", family["family_name"],
            chinese_number(family["generation"]) ));
        me->set("class","swordsman");
        sword = new(__DIR__"obj/sword");
        sword->move( me );
        sword->set("long","一把无量剑派本门使用的长剑，剑上刻着" + HIY " 无量剑" +
            me->query("name") + NOR"\n");
        me->delete_temp( "bai_zuo" );
        this->delete_temp( "bai_zuo" );
        this->delete_temp( "bai_list/" + me->query("id") );
        message_vision("左掌门将一把刻着$N名字的长剑交给了$N，说：这把剑就归你"
                   "随身携带使用。\n记住，剑在人在，剑亡人亡！\n", me);
        command( "go east" );
        return 1;
    }
    return 0; 
}

int recruit_apprentice(object me)
{
    ::recruit_apprentice(me);
    me->set("master","shang yuqing");
    message_vision("左子穆对$N说：你现在先去跟商师兄学点本门的基本功夫吧。\n", me);
    return 1;
}
                
// qyz & falcon
// let player can change a master when he becomes strong...
string change_master(object who)
{
    string master_id, msg;
    object me;

    me = this_player(); 
    if ( me->query("family/family_name") != "无量剑派东宗" )
        return "这位" + RANK_D->query_respect(me) + "说笑了, 老朽无德无能, 何言指点.\n";
    // 如果还没有 master, 就先指定商余庆. 不过怎么可能没有呢!!!
    if ( !me->query("master") )
        {
        me->set( "master", "shang yuqing" );
                msg = "从今天起，你就去跟商余庆师兄学习本门基本武功吧。\n";
        }
    else if ( !me->query("defeat_master") )
    {
        if ( !me->query_temp("fight_master") )
        {
            me->set_temp("fight_master", 1);
            printf( "左子穆沉思了一会...\n" );
            msg = sprintf( "好，你去跟%s比试一下，再做决定吧。\n",
                master_name(me) );
        }
        else
        {
            printf( "左子穆有些发怒。\n" );
            msg = sprintf( "好高骛远，是学不好功夫的，你还是先跟%s多学点东西再说。\n",
                master_name(me));
            me->add("class_score", -1);
        }
    }
        else
        {
        me->delete("defeat_master");
        switch ( me->query("master") )
                {
                case "shang yuqing":
                me->set( "master", "qu lianxing" );
                msg = "好，你现在可以去跟曲连兴师兄学习了。\n";
                break;

            case "qu lianxing":
                me->set( "master", "rong ziju" );
                msg = "嗯，不错，现在就让你容师叔来指导你吧。\n";
                break;
        
            case "rong ziju":
                me->set( "master", "zuo zimu" );
                msg = "好徒儿，从今天开始，为师亲自指点于你！\n";
                break;
                }
        }
    return msg;
}

string master_name( object me )
{
    string master_id;
    master_id = me->query("master");
    switch ( master_id )
    {
        case "shang yuqing" : return "你商师兄";
        case "qu lianxing" : return "你曲师兄";
        case "rong ziju" : return "你容师叔";
        case "zuo zimu" : return "为师我";
        default : error( "master_name" );
    }
}

//modify qyz 1997-3-26
int give_quest()
{
        mapping quest ;
        object me,ob;
        int j, class_score, timep, bonus,num;  
        string tag = "1000000";
         string *levels = ({
                        "0",
                        "400",
                        "900",
                        "1600",
                        "2500",
                        "3600",
                        "4900",
                        "6400",
                        "8100",
                        "10000",
                        "12100",
                        "14400",
                        "40000",
                        "50000",
                        "60000",
                        "80000",
                        "100000",
                        "200000",
                        "400000",
                        "800000",
                        "1000000"
        });
        me = this_player();
        ob = this_object();
        if(me->query("family/family_name")!=this_object()->query("family/family_name") )
        {
             tell_object(me,ob->name()+"疑惑地看着你：“这位"+RANK_D->query_respect(me)+"想要做什么？”\n");
                return 1;
        }
        if(quest = me->query("quest"))
        {
             if( me->query("done_quest") == quest["quest"] )
             {
                    tell_object(me,quest["reward_msg"]);
                    me->add("class_score",quest["bonus"]);
                    printf(HIR"->师门忠诚度升高 %s 点\n"NOR
                        ,chinese_number(quest["bonus"]) );
                    if( quest["positive_score"])
                    {
                        me->add("positive_score",quest["positive_score"]);
                        printf(HIG"->正评价升高 %s 点\n"NOR
                        , chinese_number(quest["positive_score"]) );
                    }
                    if( quest["negative_score"])
                    {
                        me->add("negative_score",quest["negative_score"]);
                        printf(HIC"->负评价升高 %s 点\n"NOR
                        ,chinese_number(quest["negative_score"]) );
                    }
                    me->delete("done_quest");
                    me->delete("quest");
                    return 1;
              }

              else 
              {
                 if( ((int) me->query("task_time")) >  time() && quest["time"])
                      return 0;
                  else
                  {
                      tell_object(me,quest["fail_msg"]);
                      me->add("class_score",-quest["bonus"]/3);
                      if(quest["bonus"]/3)
                        printf(HIY"->师门忠诚度下降 %s 点\n"NOR
                        ,chinese_number(quest["bonus"]/3) ); 
                      me->delete("quest");
                      return 1;
                  }
               }            
         }
         if((int)me->query("task_time")&&
                (int)me->query("task_time") > time()) 
         {                     
                message_vision(refuse_msg[random(sizeof(refuse_msg))],ob);        
                return 1;
         }
        class_score = (int)me->query("class_score");
        for(j= sizeof(levels) - 1 ; j>=0; j--)
        {
                if( atoi(levels[j])  <= class_score )
                        {
                                num=j;
                                break;
                        }
        }
/*      if (num>0)
        {
                if (random(50+me->query_kar())>65)
                {
                        num=num-1;
                }
        } else {
                if ((num<sizeof(levels)-1)&&(random(100)>95))
                {
                        num=num+1;
                        factor=15;
                }
        }
*/
        if (num>9)
        {
                num=9;
        }
        tag=levels[num];                        
//现在先共用一个quest库。
        tag = 0;
        quest = QUEST(tag)->query_quest();
        tell_object(me,quest["quest_msg"]);
        me->set("quest", quest);
        me->delete("task_time");
        if( timep = quest["time"] )
        {
            time_period( timep, me);
            me->set("task_time", (int) time()+(int) quest["time"]);
        }
        return 1;
}

int time_period(int timep, object me)
{
        int t, d, h, m, s;
        string time;
        t = timep;
        s = t % 60;             t /= 60;
        m = t % 60;             t /= 60;
        h = t % 24;             t /= 24;
        d = t;

        if(d) time = chinese_number(d) + "天";
        else time = "";

        if(h) time += chinese_number(h) + "小时";
        if(m) time += chinese_number(m) + "分";
        time += chinese_number(s) + "秒";

        tell_object(me,HIW "你有" + time + "的时间\n去完成你师傅给的任务。\n"NOR);
        return 1;
}

int accept_object(object who, object ob)
{
        string test;
        mapping quest;
        if(!(quest =  who->query("quest")))
        {
        tell_object(who,this_object()->name()+"笑道：“你给我东西干什么？”\n");
        return 0;
        }
        if( "取"+ob->name(1) != quest["quest"] || ob->is_character())
        {
        tell_object(who,this_object()->name()+"皱眉说：“我当初可不是让你去找这个呀！”\n");
        return 0;
        }
        if ( who->query("task_time") && (int) who->query("task_time") < time() )
        {
        tell_object(who,quest["delay_msg"]);
        who->delete("quest");
        return 1;
        }
        else
        {
                    tell_object(who,quest["reward_msg"]);
                    who->add("class_score",quest["bonus"]);
                    printf(HIR"->师门忠诚度升高 %s 点\n"NOR
                        ,chinese_number(quest["bonus"]) );
                    if( quest["positive_score"])
                    {
                        who->add("positive_score",quest["positive_score"]);
                        printf(HIG"->正评价升高 %s 点\n"NOR
                        , chinese_number(quest["positive_score"]) );
                    }
                    if( quest["negative_score"])
                    {
                        who->add("negative_score",quest["negative_score"]);
                        printf(HIC"->负评价升高 %s 点\n"NOR
                        ,chinese_number(quest["negative_score"]) );
                    }
                    who->delete("quest");
                    return 1;
        }
}


