#include <ansi.h>   
inherit SHOP;       

void init()
{
    seteuid( getuid() );
    seteuid( geteuid() );

    add_action( "DoValue",     "value" );   //给物品估价的函数。
    add_action( "DoPawn",      "pawn" );    //典当物品的函数。
    add_action( "DoPawnlist",  "pawnlist" );//查看典当物品的函数。
    add_action( "DoRedeem",    "redeem" );  //赎买典当物品的函数。
    add_action( "DoSell",      "sell" );    //收购物品的函数。
    add_action( "DoList",      "list" );    //列出出售物品的函数。
    add_action( "DoBuy",       "buy" );     //买物品的函数。
}

