// marry_room.c
// by trill 06/25/97

int do_swear() {
  object me, she, ob, *all;
  string my_id, her_id;
  int sign, i;

  me = this_player();
  my_id = me->query("id");
  if (me->query("have_married")) {
    tell_object(me, "你已经发过你的誓言了。\n");
    return 1;
  }
  her_id = me->query("will_marry");
  if (!her_id || !objectp(she = present(her_id, environment(me)))) {
    //        tell_object( me, "你自己嫁给自己啊？\n" );
    return 0;
  }

  all = all_inventory(environment(me));
  // 看看在场的有没有活口。
  for (i = 0; i < sizeof(all); i++) {
    if (all[i] == me || all[i] == she) continue;
    if (all[i]->can_act()) {
      sign++;
      ob = all[i];
    }
  }

  if (!me->query("can_swear") || !she->query("can_swear")) {
    /*        if ( sign ) 
        {
            message_vision( "$N对$n说道：未有师傅同意，你们不得在此发誓结成夫妇。\n", ob, me );
            tell_object( me, "你此刻无法在此发誓。\n" );   
            return 1;
        }    
*/
  }

  if (me->query("gender") == "男性")
    message_vision("$N跪下低声祝祷：“弟子" + me->name() + "和" + she->name() + "真心相爱，始终不渝，\n" +
      "愿生生世世，结为夫妇。\n", me);
  else
    message_vision("$N跪下低声祝祷：“愿上天保佑，让咱俩生生世世，结为夫妇。\n", me);
  me->set_temp("sweared", 1);
  if (she->query_temp("sweared")) {
    me->clear_condition("will_marry");
    she->clear_condition("will_marry");
    me->delete("can_swear");
    she->delete("can_swear");
    me->delete_temp("sweared");
    she->delete_temp("sweared");
    me->set("have_married/" + her_id);
    she->set("have_married/" + my_id);
    tell_object(me, "\n从此之后，你和" + she->name() + "就是夫妇了，愿能白头到老。\n ");
    tell_object(she, "\n从次之后，你和" + she->name() + "就是夫妇了，愿能白头到老。\n");
    MARRY_D->marry(my_id, her_id);
    LOG_D->do_log(me, "你和" + she->name() + "结为夫妇。");
    LOG_D->do_log(she, "你和" + me->name() + "结为夫妇。");
    // TODO 如果强行结婚，相当于一次判师惩罚。 
    // if ( sign ) 
  }
  return 1;
}
