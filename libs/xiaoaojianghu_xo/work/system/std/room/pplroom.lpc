//  标准的玩家住房  /system/std/room/pplroom.c                            //
//************************************************************************//
//  Edit by lala, on March 7, 1998                                        //
//************************************************************************//

#include <ansi.h>
inherit ROOM;

void save_desc();

void setup() {
  set("not_startroom", 1);            //不是可以存储的地点。
  set("sleep_room", "inn");            //是可以睡觉的地方。  
  ::setup();
}

void init() {
  seteuid(getuid());
  add_action("do_change", ({ "change", "gaibian" }));    //改变描述的函数。
  add_action("do_invite", ({ "invite", "yaoqing" }));    //邀请玩家的函数。
  add_action("do_letout", ({ "letout", "ganzou" }));    //赶走客人的函数。
  add_action("do_sleep", "sleep");                     //控制睡觉的函数。
}

int do_change(string arg)                 //改变描述的函数。
{                                           //arg：要改变的对象。                
  string long, my_id, owner_id;
  object ppl;

  ppl = this_player();                    //ppl：玩家本身。
  my_id = ppl->query("id");             //my_id：玩家id。
  owner_id = query("owner");            //owner_id：房间的主人id。
  if (my_id != owner_id                  //若非房主或其配偶，指令无效。
  && !ppl->query("have_married/" + owner_id))
    return 0;
  switch (arg) {
    case "short": case "住宅名称":    //改变住宅的名称。
      write(@TEXT
───────────────────────────────────────
你想对你的住宅起什么名称？（请用八个以内的汉字命名）
TEXT
      );
      write("->");                  //显示提示符。
      input_to("change_short");     //调用efun输入。
      break;
    case "long": case "住宅描述":     //改变住宅的描述。
      write(@TEXT
───────────────────────────────────────
你想怎样装修你的住宅？（用“.”结束输入）
TEXT
      );
      write("->");                  //显示提示符。
      long = "";                      //long：新的长描述。
      input_to("change_long", long);
      break;
    default:                           //没有参数的提示。
      write(@TEXT
    你能改变房子的如下性质：
    住宅的名称：    gaibian 住宅名称(short)
    住宅的描述：    gaibian 住宅描述(long)
TEXT
      );
      break;
  }
  return 1;
}

int change_short(string msg)              //改变短描述的函数。
{                                           //msg：短描述内容。
  if (msg                                //若长度在一个汉字以内，重新输入。
  && strlen(msg) < 2) {
    write("你输入的住宅名称不合要求。请重新输入。\n->");
    input_to("change_short");
    return 1;
  } else if (strlen(msg) > 16)          //若长度在八个汉字以外，重新输入。
  {
    write("你起的住宅的名称请控制在８个中文字以内。\n");
    return 1;
  }
  set("short", msg);                    //改变内存中的短描述。
  save_desc();                            //调用函数改变文件中的描述。
  write("住宅名称改变完毕。\n");
  return 1;
}

int change_long(string msg, string long)  //改变长描述的函数。
{                                           //msg：终止符号。
  //long：长描述内容。
  if (msg == ".")                         //若收到终止符号，则终止。
  {
    write("住宅描述改变完毕。\n");
    set("long", long);                //改变内存中的长描述。
    save_desc();                        //调用函数改变文件中的描述。
    return 1;
  }
  long = long + msg + "\n";               //没有受到终止符号的时候，就继续
  write("->");                            //接收msg， 加在long的后面。
  input_to("change_long", long);
  return 1;
}

int do_invite(string arg)                 //邀请玩家的函数。
{                                           //arg：受邀请的对象id。
  object ob, ppl;
  string my_id, owner_id;

  ppl = this_player();                    //ppl：玩家自身。
  my_id = ppl->query("id");             //my_id：玩家自身的id。
  owner_id = query("owner");            //owner_id：房主的id。
  if (my_id != owner_id                  //若非房主或其配偶，则指令无效。
  && !ppl->query("have_married/" + owner_id)) {
    return 0;
  }
  if (arg == my_id)                     //如果对象是玩家自身，无效。
    return notify_fail("你邀请自己？有没有搞错啊？\n ");
  if (!find_player(arg))              //如果找不到指定玩家，失败。
  {
    write("你确信这个玩家现在在线上吗？\n");
    return 1;
  }
  ob = find_player(arg);                //ob：受邀请的玩家。
  if (environment(ob) == environment(ppl))  //如果受邀请的玩家已经在
  {                                               //这里，指令无效。    
    write(ob->name() + "不就在你的身边吗？\n");
    return 1;
  }
  ob->set_temp(owner_id + " invited", owner_id);  //受邀请的玩家得到邀请标志
  tell_object(ob, REV MAG BWHT "\n" + ppl->name() + "邀请你去" + ppl->name()
    + "的家：" + query("short") + "。\n" NOR);  //显示讯息。
  tell_object(ppl, GRN "已经成功地向"             //显示成功讯息。
  +ob->query("name") + "发出邀请函。\n" NOR);
  return 1;
}

void save_desc()                            //存储修改后的信息的函数。
{
  string long, short, owner, str, out;
  long = query("long");                 //long：住宅的长描述。
  short = query("short");               //short：住宅的短描述。
  owner = query("owner");               //owner：住宅的房主。
  out = query("exits/out");             //out：住宅的出口连接。
  //以下都是写入新的房间文件的内容。
  //*****************************************************************************
  str = @LONG
// 这是系统自动生成的玩家住宅。\n

#include <room.h>
inherit PPLROOM;

void create()
{
LONG
    + "    set(\"short\", \"" + short + "\");\n"
    + "    set(\"long\", \"" + long + "\");\n"
    + "    set(\"owner\", \"" + owner + "\");\n"
    +@LONG
    set("exits", ([
LONG
    + "        \"out\" : \"" + out + "\",\n"
    +@LONG
    ]) );
    setup();
}
LONG;
  //*****************************************************************************

  rm(file_name() + ".lpc");               //删除原来旧的文件。
  write_file(file_name() + ".lpc", str);  //把新的内容写入到文件中去。
}

int do_sleep() {
  object ppl;
  string my_id, owner_id;

  ppl = this_player();                    //ppl：玩家自身。
  my_id = ppl->query("id");             //my_id：玩家自身的id。
  owner_id = query("owner");            //owner_id：房主的id。
  if (my_id != owner_id                  //若非房主或其配偶，则指令无效。
  && !ppl->query("have_married/" + owner_id)) {
    tell_object(ppl, "这里不是你睡觉的地方。\n");
    return 1;
  }
  return 0;                               //如果是合法用户，那么正常执行
  //sleep命令。
}

int do_letout(string arg)                 //赶走客人的函数。
{                                           //arg：客人的id。
  object ppl, ob;
  string my_id, owner_id;

  ppl = this_player();                    //ppl：玩家自身。
  my_id = ppl->query("id");             //my_id：玩家自身的id。
  owner_id = query("owner");            //owner_id：房主的id。
  if (my_id != owner_id                  //若非房主或其配偶，则指令无效。
  && !ppl->query("have_married/" + owner_id))
    return 0;
  if (!arg)                             //如果没有参数，指令无效。
    return notify_fail("你想赶走谁？\n");
  if (arg == my_id)                     //如果要赶出去的是自己，指令无效。
    return notify_fail("你要赶走自己？那自己走出去吧。\n");
  if (objectp(ob = present(arg, this_object())))    //如果目标在室内。
  {
    if (userp(ob)                    //如果是邀请来的玩家。
    && ob->query_temp(owner_id + " invited")) {
      message_vision("$N对$n说道：“我不再欢迎你呆在这里啦，"
        + "请出去吧！”\n说着，就把$n推了出去。\n", ppl, ob);
      ob->delete_temp(owner_id + " invited");       //删除邀请标记。
      ob->move(find_object(query("exits/out")));  //挪到出口房间。  
      tell_object(ob, "你被" + ppl->query("name") + "赶出了"
        +query("short") + "。\n", ppl, ob);
      message("vision", "一位" + RANK_D->query_normal(ob)
        + "从路旁的住宅里走出来。\n", environment(ob), ob);
      return 1;
    }
    write("你只能把被邀请来的客人赶出去，\n"           //失败信息。
    + "对于象" + ob->query("name")
      + "这样闯进来的不速之客是行不通的。\n");
    tell_object(ob, GRN "看来主人发逐客令了，要不要溜之大吉呢？\n" NOR);
  }
  write("这个人在哪儿啊？\n");
  return 1;
}
