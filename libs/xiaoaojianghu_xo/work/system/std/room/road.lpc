// filename : /std/room/road.c

inherit ROOM;
void setup()
{
    mapping obj;
	seteuid( getuid() );
    if( random(5) == 2 )
    {
        obj = this_object()->query("objects");
        if( !obj  || !mapp(obj) )
            obj = ([ MISC_DIR "tree" : random(2) + 1 ]);
        else
            obj[ MISC_DIR "tree" ] =  random(2) + 1 ;
        this_object()->set("objects",obj);
    }
	this_object()->reset();
    this_object()->set("outdoors","map");
    if( random(16) == 1 )
        new( WEAPON_DIR "short/xiaostone" )->move( this_object() );
    if( random(16) == 2 )
        new( WEAPON_DIR "short/stone" )->move( this_object() );
    if( random(16) == 3 )
        new( MISC_DIR "stone" )->move( this_object() );
    if( random(16) == 4 )
        new( MISC_DIR "xiaostone" )->move( this_object() );
    else if( random(10) == 5 )
        new( MISC_DIR "bigstone" )->move( this_object() );
}
int valid_leave(object me,string dir)
{
        mapping exit;
        int force,mforce,sen,kee;
        force = me->query("force");
        mforce = me->query("max_force");
        sen = me->query("sen");
        kee = me->query("kee");
        if( !userp( me ) ) 
        {
             me->add_temp_marks("run",1);
             if( me->query_temp_marks("run") > 3 )
                 return 0;
        }
        if ( !mapp(exit = this_object()->query("exits")) 
|| undefinedp(exit[dir]) )
        {
            if ( query_verb() == "go" )
                return notify_fail("这个方向没有出路。\n");
            else
                return 0;
        }
        if( me->query("food") > 0 )
            me->add("food",-2);
        if( me->query("food") <= 0 )
        {
            me->receive_wound("kee",1);
            me->receive_damage("sen",1);
        }
        if( me->query("water") > 0 )
            me->add("water",-2);
        if( me->query("water") <=  0 )
        {
            me->receive_damage("kee",1);
            me->receive_damage("sen",1);
        }
        if ( mforce >= 1 && force >= 1 )
        {
            me->set("force",force - 1);
            return 1;
        }
        else
        {
            if( sen <= 1 )
                return notify_fail("你太累了，还是歇歇吧。\n");
            if( mforce > 100 )
            {
                me->add("sen",-1);
                return 1;
            }
            else
            {
                me->add("sen",-1);
                return 1;
            }
        }
}

string query_room_type()
{ 
    return "road";
}
