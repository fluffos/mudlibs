int do_addbug(string arg)
{
	mapping *notes, *posts;
	mapping note;
	int num;
	mixed *local;
	string fn;
	object bug;

    if ( !wizardp(this_player() ) )
        return notify_fail("只有神仙才能增加 bug 记录。\n");

	notes = query( "notes" );	
	if ( !pointerp( notes ) || !sizeof( notes ) )
		return notify_fail( "留言板上目前没有任何留言。\n" );

	if ( !arg )
		return notify_fail( "指令格式：addbug <留言编号>\n" );
	else if ( !sscanf( arg, "%d", num ) )
		return notify_fail( "你要将第几张留言加入 bug 记录中？\n" );
	else if ( num < 1 || num > sizeof( notes ) )
		return notify_fail( "没有这张留言。\n" );
	num--;
	note = notes[ num ];
	local = localtime( note[ "time" ] );
	seteuid( getuid() );
	bug = new( CLONE_DIR + "misc/bug.lpc" );
   	if ( !bug )
   	{
       	write( "无法产生新的 bug 记录。\n" );
       	return 0;
   	}
	export_uid( bug );
	bug->set( "year", local[ LT_YEAR ] );
	bug->set( "month", local[ LT_MON ] + 1 );
	if ( file_size( bug->query_save_file() + __SAVE_EXTENSION__ ) >= 0 )
	{
		bug->restore();
	}
	posts = bug->query( "notes" );
	if ( !pointerp( posts ) || !sizeof( posts ) )
		posts = ({ note });
	else
		posts += ({ note });
	bug->set( "notes", posts );
	tell_object( this_player(), "加入 bug 记录完毕。\n" );
	bug->save();
	destruct( bug );
	return 1;
}
