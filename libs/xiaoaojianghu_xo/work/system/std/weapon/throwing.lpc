// filename : /std/weapon/throwing.c

#include <weapon.h>

inherit COMBINED_ITEM;
inherit F_EQUIP;

varargs void init_throwing(int damage, int wound, int flag)
{
        if ( clonep( this_object() ) ) return;

        set( "weapon_prop/damage", damage );
        if ( undefinedp(wound) )
                set( "weapon_prop/wound", damage );
        else set("weapon_prop/wound", wound  );
        set( "flag", flag );
}

void setup()
{
        // ::setup();
        seteuid( getuid() );

        if ( clonep(this_object()) ) return;

        set( "skill_type", "throwing" );
        set( "verbs", ({ "throw" }) );
}

