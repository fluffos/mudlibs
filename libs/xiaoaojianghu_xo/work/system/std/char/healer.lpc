//一个标准的NPC。可以让玩家接受治疗。
// Qyz

inherit NPC;

void init()
{
    ::init();
    add_action("do_ask", "ask");
    add_action("do_pay", "pay");
}

int do_ask( string arg )
{
    object me, ob;
    string name, verb;
    ob = this_object();
    me = this_player();

    if( !me->can_act() )
        return notify_fail("你现在正忙着呢。\n");

    if( !arg || !stringp(arg) )
        return notify_fail("你要问什么？\n");

    if( sscanf( arg, "%s to %s", name, verb ) != 2 )
        return notify_fail("指令格式：ask <对象> to [ 疗伤 | 解蛇毒 ]\n"); 

    if( ob != present( name, environment() ) )
        return notify_fail( name + "可不会疗伤。\n");

    if( verb != "疗伤" && verb != "解蛇毒" )
        return notify_fail( ob->name() + "无奈地耸耸肩说：你还是另请高明"
                            "吧，请赎在下无能。\n");

    if( me->query("age") < 15 )
    {
        ob->do_heal(me, verb);
        return 1;
    }
    else
    {
        if( me->query_marks("heal_pay") )
        {
            message_vision("$N向$n瞪了一眼说：上次让你赊帐，你却"
                            "至今仍未付帐，这\n次我不会再上你的当了！\n",
                            ob, me );
            return 1;
        }
        if( !me->can_afford(1000) )
        {
            message_vision("$N对$n笑道：没带钱吧？没事，医金是一两银子，"
                            "你改天再来\n付帐（ｐａｙ）吧。\n", ob, me );        
            me->set_marks("heal_pay", 1);
        }
        else me->pay_money(1000);
        ob->do_heal(me, verb);
        return 1;
    }
}

void do_heal( object me, string verb )
{
    object ob;
    ob = this_object();

    switch( verb ){
        case "疗伤" :
            if( me->query("eff_kee") >= me->query("max_kee") )
            {
                message_vision("$N仔细一看，不禁生气地对$n说：你明明没有受伤\n"
                                "为什么要来这里胡闹耽误我的时间？快出去！\n",
                                    ob, me );
                return;
            }
            message_vision("$N仔细地检查$n的伤口，清洗干净后，找出伤药敷在"
                            "伤口上，然后\n对$n说：不要着急，过两天自然会好。\n",
                            ob, me );
            me->apply_condition("healing", 20 );
            break;
        case "解蛇毒" :
            if( !me->query_condition("snake_poison") )
            {
                message_vision("$N仔细一看，不禁生气地对$n说：你明明没有中蛇毒\n"
                                "为什么要来这里胡闹耽误我的时间？快出去！\n",
                                    ob, me );
                return;
            }                
            message_vision("$N看了看蛇牙的痕迹，笑道：没事没事，一敷上我这药\n"
                            "就好。说完便给$n敷上了蛇药。\n", ob, me );
            tell_object( me, "你感到创口一阵清凉，只见毒血已慢慢的流尽，看来\n"
                            "性命已是无碍。\n");
            me->clear_condition("snake_poison");
            break;
        }
}

int do_pay( string arg )
{
    object me, ob;
    me = this_player();
    ob = this_object();

    if( !me->can_act() )
    return notify_fail( "你现在无法付钱。\n");

    if( !me->query_marks("heal_pay") )
    return notify_fail( ob->name() + "奇怪地看着你问：给我钱干什么？我不要。\n");

    if( !me->can_afford(1000) )
    return notify_fail( ob->name() + "笑道：你还是没带够钱，下次再来付吧。\n");                    

    me->pay_money(1000);
    message_vision( "$N笑着接过$n的钱说：你果然是个守信之人呀。\n", ob, me );
    me->delete_marks("heal_pay");
    return 1;
}
