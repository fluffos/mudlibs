// by lala, 1997-12-16

inherit ITEM;

void create()
{
    set_name( "五味子", ({"wuwei zi", "wuweizi"}));
    set_weight( 200 );
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", query("name") + "是一种中药材。\n");
        set("unit", "包");
        set("value", 400 + random( 500 ) );
    }
}
