// 楚州（淮安）的平桥豆腐 /clone/eat/food/pingqiao_doufu.c
// by lala, 1997-12-14

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("平桥豆腐", ({ "pingqiao doufu" }));
  set_weight(250);
  set("long", @LONG
这是用原产于楚州平桥镇的一道楚州名菜。是用豆腐和鲫鱼脑子放在荤汤里面烩制成的。
LONG
  );
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "大碗");
    set("value", 1200);
    set("food_remaining", 8);
    set("food_supply", 30);
    set("gifts", ([
      "per": 1,
      "int": 2,
    ]));
  }
  setup();
}
