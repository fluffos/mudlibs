// cake.c

#include <ansi.h>

inherit ITEM;
inherit F_FOOD;

void make_cake( object me );

void create()
{
        set_name("生日蛋糕", ({ "cake" }) );
        set_weight(160);
        set("long", "庆祝生日所订制的特大号蛋糕。\n");
        set("unit", "块");
        set("food_remaining", 99);
        set("food_supply", 100);
	set("value",1);
        if( clonep(this_object()) ) make_cake( this_player() );
}

void init()
{   ::init();
    add_action("do_make","make");
    add_action("do_xuyuan","xuyuan");
    add_action("do_throw","throw");
}

int do_make(string arg)
{
    object me;
        if( !arg ) return notify_fail("make什么？\n");
        me = present( arg, environment(this_player()) );
    if(!me)
            return 0;
    make_cake(me);
    return 1;
}


void make_cake( object me )
{   
    set("owner",me);
    set("short", me->name()+"的"+chinese_number((int)me->query("age"))+"生日蛋糕" );
    set("long", "这是"+me->name()+"为庆祝"+chinese_number((int)me->query("age"))+"岁生日所定制的特大蛋糕。\n"
                "上面插了" + chinese_number((int)me->query("age")) + "根蜡烛。\n"
                   "你要先许个愿(xuyuan),然后才能吹(blow)蜡烛\n");
}

int do_throw(string arg)
{
        string what, who, msg;
        object target;
    if(query("owner")!=this_player())
        return notify_fail("这个蛋糕不是你的。\n");
        
    if( !arg || arg=="" || sscanf(arg, "%s at %s", what, who)!=2)
                return notify_fail("指令格式：throw <what> at <who>\n");
        if( !id(what) ) return notify_fail("丢什麽？\n");
        target = present(who, environment(this_player()));
        if( !target || !target->is_character() )
                return notify_fail("你要向谁丢蛋糕？\n");
        msg = YEL BBLU "$N举起" + name() + "，在空中画出一个漂亮的弧线——丢向$n的鼻子！\n\n";
                msg += "「啪」地一声，正中红心，好爽 ....\n\n" NOR;
        message_vision(msg, this_player(), target);
        this_object()->move(target);
        return 1;
}

int do_xuyuan(string arg)
{   
    if(query("owner")!=this_player())
        return notify_fail("这个蛋糕不是你的。\n");
        message_vision("$N在心中默默地许了一个愿....\n",this_player());
        add_action("do_blow","blow");
        return 1;
}

int do_blow(string arg)
{
        message_vision("$N一口气吹灭了所有的蜡烛...嗯..可以吃了...\n",
                        this_player());
        return 1;
}
