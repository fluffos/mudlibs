inherit ITEM;
inherit F_FOOD;
void create() {
  set_name("猪头", ({ "zhu tou", "tou" }));
  set_weight(1500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个血淋淋的猪头。\n");
    set("unit", "个");
    set("value", 200);
    set("food_remaining", 7);
    set("food_supply", 30);
  }
}

int do_eat(string arg) {
  return notify_fail("这还是生的，怎么吃呀。\n");
}
