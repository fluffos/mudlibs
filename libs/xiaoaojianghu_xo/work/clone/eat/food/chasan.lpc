// 楚州金丝茶馓 /clone/eat/food/chasan.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("金丝茶馓", ({ "jinsi chasan", "chasan" }));
  set_weight(50);  //一两
  set("long", @LONG
楚州的麻油茶馓极其有名，香、脆、酥、细，成为本地名产，有“金丝茶馓”之称。
LONG
  );
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "包");
    set("value", 55);
    set("food_remaining", 1);
    set("food_supply", 30);
    set("gifts", ([
      "per": 2,
      "int": 2,
    ]));
  }
  setup();
}
