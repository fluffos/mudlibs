//这是common装备用的。
#include <ansi.h>
inherit ITEM;
inherit F_LIQUID;
void create()
{
        set_name(GRN "易拉罐" NOR, ({"yila guan", "guan", "coco"}));
    set_weight(3000);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "一个装可口可乐的易拉罐。\n");
        set("unit", "个");
        set("value",3);
        set("max_liquid", 30);
    }
    // because a container can contain different liquid
    // we set it to contain wine at the beginning
    set("liquid", ([
        "type": "water",
        "name": RED"可口可乐"NOR,
        "remaining": 30,
         "drink_apply" : 10,
    ]));
}
