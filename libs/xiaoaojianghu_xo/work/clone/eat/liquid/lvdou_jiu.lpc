// 楚州（淮安）的绿豆酒

#include <ansi.h>

inherit ITEM;
inherit F_LIQUID;

void create()
{
    set_name(GRN"绿豆酒"NOR, ({ "lvdou jiu", "jiu" }));
    set_weight(300);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "一个小小的装着绿豆酒的小酒壶。\n");
        set("unit", "壶");
        set("value", 100);
        set("max_liquid", 20);
    }
    // because a container can contain different liquid
    // we set it to contain wine at the beginning
    set("liquid", ([
        "type": "alcohol",
        "name": GRN"绿豆酒"NOR,
        "remaining": 5,
        "drunk_apply": 5,
    ]));
}

void init()
{
    this_object()->delete("value");
        add_action("do_drink","drink");
}
