// 楚州（淮安）的桂花酒

#include <ansi.h>

inherit ITEM;
inherit F_LIQUID;

void create()
{
    set_name(YEL"桂花酒"NOR, ({ "guihua jiu", "jiu" }));
    set_weight(300);
    if (clonep())
        set_default_object(__FILE__);
    else 
    {
        set("long", "一个小小的装着苦槁酒的小酒壶。\n");
        set("unit", "壶");
        set("value", 150);
        set("max_liquid", 25);
    }
    // because a container can contain different liquid
    // we set it to contain wine at the beginning
    set("liquid", ([
        "type": "alcohol",
        "name": YEL"桂花酒"NOR,
        "remaining": 7,
        "drunk_apply": 6,
    ]));
}

void init()
{
    this_object()->delete("value");
        add_action("do_drink","drink");
}
