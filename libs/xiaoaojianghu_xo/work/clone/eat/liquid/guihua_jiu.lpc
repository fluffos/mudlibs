#include <ansi.h>
inherit ITEM;
inherit F_LIQUID;
void create()
{
    set_name(YEL "黄酒坛子" NOR, ({"jiu tanzi", "tanzi", "pot"}));
    set_weight(3000);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "一个专门用来装大理黄酒的酒坛子。\n");
        set("unit", "个");
        set("value", 200);
        set("max_liquid", 30);
    }
    // because a container can contain different liquid
    // we set it to contain wine at the beginning
    set("liquid", ([
        "type": "alcohol",
        "name": "大理黄酒",
        "remaining": 30,
        "drunk_apply": 10,
    ]));
}
