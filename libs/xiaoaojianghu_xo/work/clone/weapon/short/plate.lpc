// plate.c
// modified by lin 21/05/97
#include <weapon.h>
#include <armor.h>
#include <ansi.h>
inherit PLATE;

void create()
{
        set_name("镔铁牌", ({"bintie pai","pai","plate" }) );
        set_weight(3000);
        if ( clonep() )
                set_default_object(__FILE__);
        else
    {
                set("unit", "块");
                set("value", 700);
                set("material", "iron");
        }
        init_plate(30);

// These properties are optional, if you don't set them, it will use the
// default values.

        set("wield_msg", "$N拿出一块$n握在手中。\n");
        set("unwield_msg", "$N将手中的$n收起来。\n");

// The setup() is required.

        setup();
}
