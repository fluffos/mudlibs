//yaodao.c

#include <weapon.h>
#include <ansi.h>

inherit BLADE;

void create() {
  set_name("长刀", ({ "chang dao", "blade" }));
  set_weight(2500);
  set("long", "一把长刀，长约四尺，上有「扬州守备」的字样。\n");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 2000);
    set("cant_sell", "这种东西，小人可不敢收。\n");
    set("material", "steel");
  }
  init_blade(15);
  set("wield_msg", "$N「唰」的一声抽出一把$n握在手中，寒气逼人。\n");
  set("unwield_msg", "$N将手中的$n插回腰间。\n");
  setup();
}
