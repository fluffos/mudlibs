#include <weapon.h>
#include <ansi.h>

inherit BLADE;
//inherit F_SAVE;
//inherit F_AUTOLOAD;
void create()
{
        set_name("钢刀", ({ "gang dao"}) );
        set_weight(2500);
        set("long","一把精钢打就的刀，长约二尺半，刀面隐隐有斑斑血迹。\n");
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("value",1500);
        set("cant_sell","你这把刀上有血迹！小店可不敢收哇！\n");
                set("material", "steel");
        }
        init_blade( 20 + random(30) );
        set("wield_msg", "$N把$n握在手中。\n");
        set("unwield_msg", "$N将手中的$n插入腰间。\n");
        setup();
}
