// 宽刀  /clone/weapon/blade/kuandao.c 
// By lala, 1998-01-25 
#include <weapon.h>
inherit BLADE;

void create()
{
    set_name("宽身短刀", ({ "kuan dao", "kuandao", "dao", "blade"}) );
    set_weight(300);
    set("long","这是一把很特别的刀身极阔的短刀。\n");
    if( clonep() )
        set_default_object(__FILE__);
    else
    {
        set("unit", "把");
        set("value",200 );
        set("material", "iron");
    }
    init_blade(12);
    set("wield_msg", "$N「唰」的一声抽出一把$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插入腰间。\n");
    setup();
}
