#include <armor.h>
inherit CLOTH;
void create()
{
    set_name("大红袈裟", ({ "dahong jiashang", "jiasha", "cloth" }) );
    set("long","一件大红袈裟,镶着闪亮的金边.\n"); 
    set_weight(1000);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("unit", "件");
        set("material", "cloth");
        set("value",400);
        set("armor_prop/armor", 10);
    }
    setup();
}
 
