// clothname.c  

#include <ansi.h>

string *com_type = ({
  "衲袄", "宽衫", "窄衫", "汗衫", "罗衫", "罗袄",
});
string *man_color = ({
  CYN "青" NOR, BLU "蓝" NOR, WHT "白" NOR, HIB "藏青" NOR, GRN "胡绿" NOR, HIR "猩红" NOR,
  BLK "皂" NOR, WHT "素白" NOR, HIM "紫" NOR, MAG "浅紫" NOR,
});
string *com_material = ({
  "布", "旧", "印花", "绸", "麻布",
});
string *high_type = ({
  "罗袍", "袍", "宽袍", "战袍", "衲袄", "宽衫", "罗衫",
});
string *high_material = ({
  "缎子", "锦", "绸", "薄绸", "直缝",
});
string *wo_type = ({
  "裙", "罗裙", "衫", "锦袄", "小袄",
});
string *wo_color = ({
  RED "大红" NOR, RED "银红" NOR, HIY "杏黄" NOR, GRN "葱绿" NOR, BLU "蓝" NOR, MAG "藕合色" NOR
  , MAG "粉" NOR, YEL "泥金" NOR, WHT "素白" NOR, WHT "白" NOR, GRN "胡绿" NOR,
});
string *wo_material = ({
  "绸", "细纱", "团花", "绣花", "罗", "六幅", "百绉", "薄绸", "对襟",
});
string comm_man_cloth() {
  return man_color[random(sizeof(man_color))] + com_material[random(sizeof(com_material))] + com_type[random(sizeof(com_type))];
}
string high_man_cloth() {
  return man_color[random(sizeof(man_color))] + high_material[random(
    sizeof(high_material)) ] + high_type[random(sizeof(high_type))];
}
string woman_cloth() {
  return wo_color[random(sizeof(wo_color))] + wo_material[random(sizeof(
    wo_material)) ] + wo_type[random(sizeof(wo_type))];
}
