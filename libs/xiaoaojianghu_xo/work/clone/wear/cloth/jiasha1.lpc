#include <armor.h>
inherit CLOTH;
void create() {
  set_name("袈裟", ({ "jiasha", "cloth" }));
  set("long", "一件土黄色的袈裟，穿起来还真象那么回事。\n");
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("value", 1000);
    set("armor_prop/armor", 1);
  }
  setup();
}
