#include <armor.h>
inherit CLOTH;
void create() {
  set_name("青布僧衣", ({ "qingbu sengyi", "sengyi", "cloth" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("value", 400);
    set("armor_prop/armor", 1);
  }
  setup();
}
