//bailing_qunzi.c
#include <armor.h>
#include <ansi.h>
inherit SKIRT;
void create()
{
    set_name(YEL "葱黄绫裙" NOR, ({"conghuang lingqun", "qunzi", "skirt"}));
    set_weight(1000);
    if ( clonep() )
        set_default_object(__FILE__);
    else {
        set("unit", "条");
        set("value", 1500);
        set("material", "silk");
        set("armor_prop/armor", 1);
        set("armor_prop/dodge", 4);
        set("female_only", 1);
    }
    setup();
}
