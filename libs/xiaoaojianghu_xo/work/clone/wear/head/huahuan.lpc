#include <ansi.h>
#include <armor.h>
inherit HEAD;
void create()
{
    set_name( HIR"花环"NOR, ({ "huahuan", "head" }) );
    set_weight(100);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("unit", "顶");          
        set("long", @LONG
        供伴娘戴在头上的花环，由七色花束成，据说会带给
        新人以祝福。
LONG
        );
        set("value",150);
        set("material", "cloth");
        set("armor_prop/personality", 5);
    }
    setup();
}
