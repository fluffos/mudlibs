#include <ansi.h>
#include <armor.h>
inherit WAIST;
void create()
{
    set_name("玲珑嵌宝玉绦环" , ({"yutao huan", "yaodai", "waistband"}));
    set_weight(100);
    if ( clonep() )
        set_default_object(__FILE__);
    else {
        set("unit", "根");
        set("value", 2000);
        set("material", "jade");
        set("armor_prop/armor", 3);
        set("armor_prop/personality", 3);
    }
    setup();
}
