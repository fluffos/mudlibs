//standard soldieritem by lin on March 6.  1997
#include <armor.h>
inherit SURCOAT;
#include <ansi.h>
void create()
{
        set_name(HIR"猩红战袍"NOR, ({ "xinghong zhanpao","zhanpao","pao","cloth", }) );
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "这是军队里通用的军服，标志军官身份的战袍。\n");
                set("unit", "件");
                set("value",140);
                set("cant_sell","这是军中的东西，小的可不能收\n");
                set("material", "steel");
                set("armor_prop/armor", 10);
          
        }
        setup();
}

int is_soldier_use(object me)
{
    return 1;
}
