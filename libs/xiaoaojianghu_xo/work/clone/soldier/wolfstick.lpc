//standard soldieritem   lin 06/26/97

#include <weapon.h>

inherit STAFF;
#include <ansi.h>

void create() {
  set_name(HIC "狼牙棒" NOR, ({ "wolf stick", "stick" }));
  set_weight(20000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("value", 800);
    set("cant_sell", "官军的装备也来买卖，不要脑袋了么？！\n");
    set("material", "steel");
    set("long", "这是一根实心镔铁大棒，入手沉重，棒上满是狼牙倒刺。\n");
    set("wield_msg", "$N拿起沉甸甸的$n握在手中。\n");
    set("unequip_msg", "$N将手中的$n插入腰间。\n");
  }
  init_staff(50);
  setup();
}
int is_soldier_use(object me) {
  return 1;
}
int wield() {
  object who = this_player();
  if (who->query("str") < 25)
    return notify_fail("你拿不动。\n");
  return ::wield();
}
