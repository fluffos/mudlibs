//汴京: ITEMs   wuyin-qiang.c for林冲
#include <weapon.h>
#include <ansi.h>
inherit QIANG;
void create()
{
    set_name(BLK"乌"WHT"银"RED"枪"NOR, ({ "wu yin qiang","qiang","gun"}) );
    set_weight(6000);
    set("long",@LONG
    一根丈八乌银枪，枪身俱是精铁打就，镔铁枪头闪闪发亮。
LONG);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("unit", "杆");
        set("value",5600);
        set("material", "iron");
    }
    init_qiang(50);
    set("wield_msg", "$N抄起$n握住手中的$n。\n");
    set("unwield_msg", "$N将手中的$n放下。\n");
    setup();
}
