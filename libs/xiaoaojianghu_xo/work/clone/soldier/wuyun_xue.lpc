// boots for 军官   edit by in on March 4, 1997
#include <armor.h>
inherit BOOTS;
#include <ansi.h>
void create()
{
    set_name(BLK"乌云靴"NOR, ({"wuyun xue","xue", "blackcloud boots","boots" }) );
    set_weight(700);
    if( clonep() )
            set_default_object(__FILE__);
    else {
        set("long", "这是军官们最爱穿的军靴。\n");
        set("unit", "双");
        set("value", 400);
        set("cant_sell","官军的装备也来买卖，不要脑袋了么？！\n");
        set("material", "steel");
        set("armor_prop/armor", 1);
        set("armor_prop/dodge", 10);
    }
    setup();
}
int is_soldier_use(object me)
{
    return 1;
}
