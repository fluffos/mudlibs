inherit F_DBASE;
inherit F_SAVE;

void create() {
  seteuid(getuid());
  set("name", "聊天室总管");
  set("id", "chatroom");
}

string query_save_file() {
  return DATA_DIR + "chatroom";
}

> c stone.c inherit ITEM;
void create() {
  set_name("石头", ({ "shi tou", "shitou", "stone" }));
  set("unit", "块");
  set_weight(random(5000) + 5000);
  setup();
}
