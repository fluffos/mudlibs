// chabei.c

inherit ITEM;
inherit F_LIQUID;

void create()
{
        set_name("小茶杯", ({ "cha bei" }) );
        set_weight(50);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一个小小的茶杯。\n");
                set("unit", "个");
                set("value", 3);
                set("max_liquid", 10);
        }

        // The liquid contained in the container is independent, we set a copy
        // in each cloned copy.
        set("liquid", ([
                "name": "茶水",
                "remaining": 1,
        ]) );
}
