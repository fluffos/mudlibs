// chaidao.c

#include <weapon.h>

inherit AXE;

void create()
{
    set_name("砍柴刀", ({ "chai dao","dao" }) );
    set_weight(1000);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("unit", "把");
        set("long", "这是一把锋利的砍柴刀。");
                set("value", 200 );
        set("material", "steel");
    }
    init_axe(40);

    set("wield_msg", "$N从腰间抽出一把锋利的$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n别在腰间。\n");


    setup();
}

