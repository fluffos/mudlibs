//by ranger 游侠

#include <ansi.h>

inherit F_DBASE;

int flag;

string *dirs = ({
	"/d/city/guangchang",
	"/d/city/beimen",
});

string *boss = ({
	"/clone/boss/dadao",
});

void create()
{
        seteuid(ROOT_UID);
        set("channel_id", "BOSS精灵");
        CHANNEL_D->do_channel( this_object(), "sys", "BOSS系统已经启动。\n"); 
	flag = 0;
//        set_heart_beat(10);
}

void heart_beat()
{
	object newob;
	string dir;
	mixed* r;
	int time = time();
	r = localtime(time);

	if(r[1]==35&&r[2]>7&&r[2]<23)
	{
		if(!flag)
		{
			newob = new(boss[random(sizeof(boss))]);
			dir = dirs[random(sizeof(dirs))];
			newob->move(dir);
			flag = 1;
			CHANNEL_D->do_channel( this_object(), "sys", dir->query("short")+"刷出"+newob->query("name")+"。\n"); 
//			CHANNEL_D->do_channel( this_object(), "rumor", dir->query("short")+"刷出"+newob->query("name")+"。\n"); 
		}
	}
	else flag = 0;
}
