void create()
{
        seteuid(ROOT_UID);
        set("channel_id", "宝石精灵");
        CHANNEL_D->do_channel( this_object(), "sys", "天降陨石系统已经启动。\n"); 
	flag = 0;
        set_heart_beat(10);
}

void heart_beat()
{
	object newob;
	mixed* r;
	int time = time();
	r = localtime(time);

	if(r[1]==0&&r[2]>7&&r[2]<23)
	{
		if(!flag)
		{
			newob = new("/quest/obj/baoshi");
			random_place(dirs[random(sizeof(dirs))],newob);
			flag = 1;
		}
	}
	else  {
		flag = 0;
		log_file("/baoshid", sprintf("宝石系统待命状态！\n"));
	}
}

int random_place(string dirss,object bs)
{

	int  j, k;
	object  newob,ob;
	mixed*  file, exit;
	string room,id_name,str;
	file = get_dir( dirss+"/*.lpc", -1 );

	if( !sizeof(file) ) return 0;

	sscanf(bs->query("name"),"%*s级%s宝石",str);
	if (bs->query("b_lvl")>1) str ="耀眼的"+str;
	for(k=0;k<50;k++)
	{ // try 10 times
		j = random(sizeof(file));
		if( file[j][1] > 0 )
		{
			room = dirss+"/"+file[j][0];
			if(room->query("outdoors"))
			{
				if(bs->move(room))
				{
					message("channel:chat",HIG"【"+HIC"天降陨石"+HIG"】"+HIW"突然空中打了个炸雷,一个火球横空出世！"NOR"\n",users());
					message("channel:chat",HIG"【"+HIC"天降陨石"+HIG"】"+HIW"火球拖着一道"+str+"光落向"
						HIW+ZJURL("cmds:fly "+room->query("outdoors"))+ZJSIZE(22)+room->query("outdoors")+NOR+HIW"的方向!"NOR"\n",users());
					
					log_file("/baoshid", sprintf("宝石发布到%s成功！\n", room));
					CHANNEL_D->do_channel( this_object(), "sys", "宝石落到了"ZJURL("cmds:goto "+room)+ZJSIZE(22)+room->query("outdoors")+NOR+room->query("short")+"。"NOR"\n");        
					return 1;
				}
			}
		}
	}
	CHANNEL_D->do_channel( this_object(), "sys", room+"本次宝石发布失败\n");        
        return 0;

}
