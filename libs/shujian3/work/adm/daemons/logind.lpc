private void random_gift(mapping my, int select)
{
	int i = 10, j;
	int tmpstr, tmpint, tmpcon, tmpdex;

	tmpstr = tmpint = tmpcon = tmpdex = 10;

	switch (select) {
		case 1: tmpstr = i = my["str"]; break;
		case 2: tmpint = i = my["int"]; break;
		case 3: tmpcon = i = my["con"]; break;
		case 4: tmpdex = i = my["dex"];
	}
	i = 50 - i;
	while (i--) {
		j = random(4);
		if (j == select - 1) i++;
		else switch (j) {
			case 0: if (tmpstr < 30) tmpstr++;
				else i++;
				break;
			case 1: if (tmpint < 30) tmpint++;
				else i++;
				break;
			case 2: if (tmpcon < 30) tmpcon++;
				else i++;
				break;
			case 3: if (tmpdex < 30) tmpdex++;
				else i++;
		}
	}
	my["str"] = tmpstr;
	my["int"] = tmpint;
	my["con"] = tmpcon;
	my["dex"] = tmpdex;
	// next 3 are randomly selected
	my["kar"] = 10 + random(21);
	my["per"] = 20 + random(11);
	my["pur"] = 30;
}

void create()
{
	seteuid(getuid());
	set("channel_id", "连线精灵");
}

int remove()
{
	write_file("/log/ppls", sprintf("%d", ppls), 1);
	return 1;
}

void logon(object ob)
{
	string str;
	object *usr;
        int i,iplimit;
	str = crypt(ZJKEY,"zj");
	write("\n");
	write("ver1.0,"+str+"\n");
	write("版本验证成功\n");
	input_to("jiance",ob,str);
}

