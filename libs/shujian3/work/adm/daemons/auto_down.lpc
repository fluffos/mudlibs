//auto_down
//by luoyun
#include <ansi.h>

inherit F_DBASE;
#include <localtime.h>
int ok =0;

void create()
{
	seteuid(getuid());
	set("channel_id", "系统维护精灵");
	CHANNEL_D->do_channel( this_object(), "sys", "系统维护精灵已经启动。"NOR);
	set_heart_beat(10);
}

int clean_up()
{
	return 1;
}

void check_time()
{
	int GMT = time() + localtime(0)[8];
	string d, times;
	int h, s;
	
	times = ctime(GMT+28800);
	//Sun(星期日) Mon(星期一)  Tue(星期二)  Wed(星期三)  Thu(星期四)  Fri(星期五)  Sat(星期六)
	d = times[0..2];//星期
	h = to_int(times[10..12]);//时
	s = to_int(times[14..15]);//分
		
	if (d =="Mon" && h == 6) {//星期日 提前一小时时间范围内通知和执行指令
		if (s == 57 && ok < 3) {
			//3分钟后重启
			"/cmds/common/reboot"->main(this_object(), "3");
			ok = 3;
		} else
		if (s == 40 && ok < 2) {
			message("channel", HIR"【系统维护精灵】:"HIY"系统将于今日7:00例行维护！请各位提前做好下线准备！"NOR"\n", users());
			ok = 2;
		} else
		if (s == 30 && ok < 1) {
			message("channel", HIR"【系统维护精灵】:"HIY"系统将于今日7:00例行维护！请各位提前做好下线准备！"NOR"\n", users());
			ok = 1;
		} 
	}
}

protected void heart_beat()
{	
	check_time();
}