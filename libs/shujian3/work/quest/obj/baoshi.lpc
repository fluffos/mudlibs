int is_baoshi() {
  return 1;
}

void setname() {
  int i, j, k;
  string name, *kn, *id;

  k = random(1000);
  if (k > 9995) {
    i = 21 + random(7);
    j = i - 21;
    set("is_monitored", 1);
  } else if (k > 9990) {
    i = 14 + random(7);
    j = i - 14;
    set("is_monitored", 1);
  } else if (k > 950) {
    i = 7 + random(7);
    j = i - 7;
    set("is_monitored", 1);
  } else {
    i = random(7);
    j = i;
  }

  set("b_lvl", i / 7 + 1);

  name = b_names[i] + "宝石";
  set("baoshi", b_names[i]);
  id = ({ names[b_names[i]] + " baoshi", "bao shi" });
  set("reward_lvl", j + 1);

  if (j == 0) {
    set("bscolor", HIR);
    set_name(HIR + name + NOR, id);
  }
  if (j == 1) {
    set("bscolor", HIB);
    set_name(HIB + name + NOR, id);
  }
  if (j == 2) {
    set("bscolor", HIG);
    set_name(HIG + name + NOR, id);
  }
  if (j == 3) {
    set("bscolor", HIC);
    set_name(HIC + name + NOR, id);
  }
  if (j == 4) {
    set("bscolor", HIY);
    set_name(HIY + name + NOR, id);
  }
  if (j == 5) {
    set("bscolor", HIM);
    set_name(HIM + name + NOR, id);
  }
  if (j == 6) {
    set("bscolor", YEL);
    set_name(YEL + name + NOR, id);
  }
  if (j == 7) {
    set("bscolor", YEL);
    set_name(YEL + name + NOR, id);
  }
  set("long", query("bscolor") + "一块发着闪闪发光的宝石，传说是女娲补天石的碎块,也不知道什么时候落入凡间的。" NOR "\n");
}

void changename(int i, int j) {
  string name, *id;
  object ob = this_object();

  ob->set("b_lvl", i);
  ob->set("reward_lvl", j);

  i--;
  j--;

  name = b_names[i * 7 + j] + "宝石";

  id = ({ names[b_names[i * 7 + j]] + " baoshi", "bao shi" });

  ob->set("baoshi", b_names[i * 7 + j]);

  if (j == 0) {
    ob->set("bscolor", HIR);
    ob->set_name(HIR + name + NOR, id);
  }
  if (j == 1) {
    ob->set("bscolor", HIB);
    ob->set_name(HIB + name + NOR, id);
  }
  if (j == 2) {
    ob->set("bscolor", HIG);
    ob->set_name(HIG + name + NOR, id);
  }
  if (j == 3) {
    ob->set("bscolor", HIC);
    ob->set_name(HIC + name + NOR, id);
  }
  if (j == 4) {
    ob->set("bscolor", HIY);
    ob->set_name(HIY + name + NOR, id);
  }
  if (j == 5) {
    ob->set("bscolor", HIM);
    ob->set_name(HIM + name + NOR, id);
  }
  if (j == 6) {
    ob->set("bscolor", YEL);
    ob->set_name(YEL + name + NOR, id);
  }
  if (j == 7) {
    ob->set("bscolor", YEL);
    ob->set_name(YEL + name + NOR, id);
  }
  set("long", query("bscolor") + "一块发着闪闪发光的宝石，传说是女娲补天石的碎块,也不知道什么时候落入凡间的。" NOR "\n");
}

void create(int i) {
  setname();
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("value", 200000);
    set("unit", "颗");
    set("can_store", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_sell", 1);
    set("no_put", 1);
    set("long", query("bscolor") + "一块发着闪闪发光的宝石，传说是女娲补天石的碎块,也不知道什么时候落入凡间的。" NOR "\n");
  }
  setup();
}

int do_enchase(string arg) {
  object in_obj;
  string item, str, mats, *eenb;
  int rd, i, j, k, kong, n;
  object me = this_player();
  object ob = this_object();
  mapping oldee;

  if (!arg) {
    write("你要干什么？\n");
    return 0;
  }
  if (!objectp(in_obj = present(arg, me))) {
    write("你身上没有这样东西。\n");
    return 0;
  }
  if (!(kong = in_obj->query("drill_num"))) {
    write("没开孔的装备无法镶嵌！！\n");
    return 0;
  }
  if (mapp(oldee = in_obj->query("old_ee")) && sizeof(keys(oldee)) >= kong) {
    write("这个装备已经没有多余的孔来镶嵌了！！\n");
    return 0;
  }
  if (in_obj->query("equipped")) {
    write("你必须放下这样东西才能镶嵌宝石。\n");
    return 0;
  }
  if (in_obj->is_character()) {
    write("你难道疯了，怎么能把宝石镶嵌到人身上？\n");
    return 0;
  }
  i = ob->query("b_lvl");
  j = ob->query("reward_lvl");

  for (n = 1; n < (kong + 1); n++) {
    if (mapp(in_obj->query("old_ee/" + sprintf("%d", n)))) {
      if (j == in_obj->query("old_ee/" + sprintf("%d", n) + "/rlv")) {
        write("你的装备上已经镶嵌过同类宝石，不能重复！\n");
        return 0;
      }
    }
  }

  if (i == 1) k = 1;  //1
  else if (i == 2) k = 2;  //3
  else if (i == 3) k = 3;  //9
  else if (i == 4) k = 5;  //27
  else if (i == 5) k = 7;  //81
  else if (i == 6) k = 9;  //243


  mats = in_obj->query("material");  //装备或武器

  if (!in_obj->query("weapon_prop/damage"))  //防具
  {
    message_vision(CYN "$N把$n" + CYN "镶嵌到" + in_obj->query("name") + CYN "上 " NOR "\n", me, ob);
    tell_room(
      environment(me),
      HIG "只见" + ob->name() + HIG "发出一团灿烂的金光,环绕在" + in_obj->query("name") + HIG "的周围 " NOR "\n"
    );

    log_file(
      "baoshi/remake",
      sprintf(me->query("id") + "给%s镶嵌%s成功。\n", in_obj->query("name"), ob->name())
    );

    //判断同类宝石
    if (j == 1) {
      k = k * 6;
      in_obj->add("armor_prop/armor", k);  //红宝石
      message_vision(CYN "" + in_obj->query("name") + CYN "似乎变得更加坚固了！" NOR "\n", me);
    } else if (j == 2) {
      k = 0;
      in_obj->add("armor_prop/dodge", k);  //蓝宝石
      message_vision(CYN "" + in_obj->query("name") + CYN "似乎没什么变化！" NOR "\n", me);

    } else if (j == 3) {
      k = k * 120;
      in_obj->add("armor_prop/qi", k);  //绿宝石
      message_vision(CYN "" + in_obj->query("name") + CYN "似乎变得更加厚实了！" NOR "\n", me);
    } else if (j == 4) {
      //k=i;
      in_obj->add("armor_prop/dexerity", k);  //青宝石
      message_vision(CYN "" + in_obj->query("name") + CYN "似乎变得更加轻盈了！" NOR "\n", me);
    } else if (j == 5) {
      //k=i;
      in_obj->add("armor_prop/strength", k);  //黄宝石
      message_vision(CYN "" + in_obj->query("name") + CYN "似乎变得更加有力了！" NOR "\n", me);
    } else if (j == 6) {
      //k=i;
      in_obj->add("armor_prop/intelligence", k);  //紫宝石
      message_vision(CYN "" + in_obj->query("name") + CYN "似乎充满了灵性！" NOR "\n", me);
    } else if (j == 7) {
      //k=i;
      in_obj->add("armor_prop/constitution", k);  //橙宝石
      message_vision(CYN "" + in_obj->query("name") + CYN "似乎变得更加坚实了！" NOR "\n", me);
    }

    in_obj->set("no_sell", 1);
    in_obj->set("name", HIG + in_obj->query("name") + NOR);
    for (n = 1; n < (kong + 1); n++) {
      if (!mapp(in_obj->query("old_ee/" + sprintf("%d", n)))) {
        in_obj->set("old_ee/" + sprintf("%d", n) + "/name", ob->query("name"));
        in_obj->set("old_ee/" + sprintf("%d", n) + "/lv", ob->query("b_lvl"));
        in_obj->set("old_ee/" + sprintf("%d", n) + "/rlv", ob->query("reward_lvl"));
        in_obj->set("old_ee/" + sprintf("%d", n) + "/num", k);
        break;
      }
    }
    destruct(ob);
    return 1;
  } else {
    //武器
    message_vision(CYN "$N把$n" + CYN "镶嵌到" + in_obj->query("name") + CYN "上 " NOR "\n", me, ob);
    tell_room(
      environment(me),
      HIG "只见" + ob->name() + HIG "发出一团灿烂的金光,环绕在" + in_obj->query("name") + HIG "的周围 " NOR "\n"
    );

    log_file(
      "baoshi/remake",
      sprintf(me->query("id") + "给%s镶嵌%s成功。\n", in_obj->query("name"), ob->name())
    );

    if (j == 1) {
      k = k * 6;
      in_obj->add("weapon_prop/damage", k);
      message_vision(CYN "" + in_obj->query("name") + CYN "似乎变得更有威力了！" NOR "\n", me);
    } else if (j == 2) {
      k = 0;
      in_obj->add("weapon_prop/dodge", k);
      message_vision(CYN "" + in_obj->query("name") + CYN "似乎没什么变化！" NOR "\n", me);

    } else if (j == 3) {
      k = k * 120;
      in_obj->add("weapon_prop/qi", k);
      message_vision(CYN "" + in_obj->query("name") + CYN "似乎变得更加厚实了！" NOR "\n", me);
    } else if (j == 4) {
      //k=i;
      in_obj->add("weapon_prop/dexerity", k);
      message_vision(CYN "" + in_obj->query("name") + CYN "似乎变得更加轻盈了！" NOR "\n", me);
    } else if (j == 5) {
      //k=i;
      in_obj->add("weapon_prop/strength", k);
      message_vision(CYN "" + in_obj->query("name") + CYN "似乎变得更加有力了！" NOR "\n", me);
    } else if (j == 6) {
      //k=i;
      in_obj->add("weapon_prop/intelligence", k);
      message_vision(CYN "" + in_obj->query("name") + CYN "似乎充满了灵性！" NOR "\n", me);
    } else if (j == 7) {
      //k=i;
      in_obj->add("weapon_prop/constitution", k);
      message_vision(CYN "" + in_obj->query("name") + CYN "似乎变得更加坚实了！" NOR "\n", me);
    }

    in_obj->set("no_sell", 1);
    in_obj->set("name", HIG + in_obj->query("name") + NOR);

    for (n = 1; n < (kong + 1); n++) {
      if (!mapp(in_obj->query("old_ee/" + sprintf("%d", n)))) {
        in_obj->set("old_ee/" + sprintf("%d", n) + "/name", ob->query("name"));
        in_obj->set("old_ee/" + sprintf("%d", n) + "/lv", ob->query("b_lvl"));
        in_obj->set("old_ee/" + sprintf("%d", n) + "/rlv", ob->query("reward_lvl"));
        in_obj->set("old_ee/" + sprintf("%d", n) + "/num", k);
        break;
      }
    }

    destruct(ob);
    return 1;
  }
  return notify_fail("你镶嵌宝石失败了？\n");
}

int do_combine() {
  int i, j, m;
  string name, *kn, *id;

  object me = this_player();
  object ob = this_object();
  object *inv, ob2, ob3;

  i = ob->query("b_lvl");
  j = ob->query("reward_lvl");

  if (ob->query("b_lvl") == 6) {
    write("这个宝石已经是最高等级了！\n");
    return 0;
  }
  if (me->query("max_neili") < 500 || me->query("neili") < 800) {
    write("以你现在的内力修为，还无法运功合并宝石！\n");
    return 0;
  }

  inv = all_inventory(me);
  for (m = 0; m < sizeof(inv); m++) {
    if ((inv[m] != ob) && (inv[m]->query("id") == ob->query("id"))) {
      if (!ob2) ob2 = inv[m];
      else if (!ob3) ob3 = inv[m];
    }
  }
  if (!ob2 || !ob3) {
    write("你必须用三块" + ob->query("name") + "来合并。\n");
    return 0;
  }

  if (random(100) + 11 > 10) {
    message_vision(HIM "$N把三块" + ob->query("name") + HIM "合在一起，暗运内力熔炼，但见" + ob->query("name")
      +HIM "表面异彩流动......\n" HIG "渐渐地$N收回了内力，" + ob->query("name") + HIG "似乎变得更加完美了！" NOR "\n", me);
    me->add("max_neili", -(1 + random(5)));
    me->add("neili", -100);
    me->start_busy(1);
    destruct(ob2);
    destruct(ob3);
    ob->changename(i + 1, j);
    return 1;
  } else {
    message_vision(HIM "$N把三块" + ob->query("name") + HIM "合在一起，暗运内力熔炼，但见" + ob->query("name") + HIM "表面异彩流动......\n"
      HIW "只听“咔”的一声脆响，$N手中的" + ob->query("name") + HIW "变得粉碎！" NOR "\n", me);
    me->add("max_neili", -(1 + random(5)));
    me->add("neili", -100);
    me->start_busy(1);
    destruct(ob2);
    destruct(ob3);
    destruct(ob);
    return 1;
  }

  return 1;
}
