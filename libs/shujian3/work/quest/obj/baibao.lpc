// baibao.c
// by ranger_游侠

#include <ansi.h>
inherit ITEM;
inherit F_SAVE;

mapping baowus;

void create()
{
	set_name(HIW"百宝囊"NOR, ({ "baibao nang", "nang" }) );
	set("long",HIW"一个神奇的锦囊，可以存取各种宝贝。"NOR"\n");
	set("unit", "个");
	set("no_put", 1);
	set("no_get", 1);
	set("no_give", 1);
	set("no_drop", 1);
	set("no_sell", 1);
	set("no_steal", 1);
	seteuid(getuid());
}

string query_save_file()
{
	string id;

	if( !stringp(id = query("owner_id")) ) return 0;

	return sprintf(DATA_DIR"baibao/%c/%s", id[0], id);
}

int set_owner(string id)
{
	set("owner_id", id);
	return 1;
}

void init()
{
	if(!query("owner_id"))
	{
		set_owner(this_player()->query("id"));
	}

	if(this_player()->query("id")==query("owner_id"))
	{
		add_action("do_cunbao","cunbao");
		add_action("do_qubao","qubao");
		add_action("do_chabao","chabao");
		restore();
	}
}

int do_cunbao(string arg)
{
	object me,ob;
	string *item_nb,nb,*valid_ob;
	int i,snum;
	mapping info=([]);

	valid_ob = ({
		"fei xue",
		"ebook",
	});

	me = this_player();
	if(!arg)
		return notify_fail("你要向百宝囊中存什么宝贝？\n");

	snum = 10+me->query("vip/all_pay")/20+me->query("combat_exp")/200000;
if (snum>100) snum=100;
	if(mapp(baowus)&&(sizeof(keys(baowus))>=snum))
		return notify_fail("以你目前的修为和贡献，你的百宝囊最多只能存储"+snum+"件物品。\n");

	if(!objectp(ob=present(arg,me)))
		return notify_fail("你身上没有这种宝贝吧？\n");

	if(!ob->query("can_store"))
		return notify_fail("只有某些特殊物品才能存入百宝囊。\n");

	info["short"] = ob->query("name");
	info["id"] = ob->parse_command_id_list();
	info["file"] = base_name(ob);
	info["data"] = save_variable(ob->query_entire_dbase());

	if( !mapp(baowus)) baowus = ([]);
	if( baowus == ([]))
	{
		baowus["1"] = info;
		destruct(ob);
		save();
	}
	else
	{
		item_nb = sort_array( keys(baowus), (: strcmp :) );
		for(i=1; i<(sizeof(item_nb)+2); i++) {
			nb = sprintf("%d",i);
			if(undefinedp(baowus[nb]))
			{
				baowus[nb] = info;
				tell_object(me,"你把"+ob->query("name") + "存入百宝囊！\n");
				destruct(ob);
				save();
				break;
			}
		}
	}
	if(objectp(ob))
		tell_object(me,"物品存入失败！\n");
	else
		tell_object(me,"物品存入成功！\n");
	return 1;
}

int do_qubao(string arg)
{
	object me,ob;
	string *item_nb;
	int i;

	me = this_player();

	if( !mapp(baowus) || baowus==([]))
		return notify_fail("你的百宝囊中没什么东西可取的。\n");
	if(!arg)
		return notify_fail("你要从百宝囊中取出什么宝贝？\n");

	if(undefinedp(baowus[arg]))
		return notify_fail("你的百宝囊中没没有这个编号的物品。\n");

	ob = new(baowus[arg]["file"]);

	if(ob->move(me))
	{
		ob->set_entire_dbase(restore_variable(baowus[arg]["data"]));
		ob->set_name(baowus[arg]["short"],baowus[arg]["id"]);
		map_delete(baowus, arg);
		save();
		tell_object(me,"你把"+ob->query("name")+"从百宝囊中取出！\n");
		tell_object(me,"物品取出成功！\n");
	}
	else
		tell_object(me,"宝物取出失败！\n");

	return 1;
}

int do_chabao(string arg)
{
	object me;
	string *item_nb;
	string msg, ob_name;

	me = this_player();

	if( !mapp(baowus) )
		return  notify_fail("你目前没有存放任何物品在百宝囊里。\n");     

	item_nb = sort_array( keys(baowus), (: strcmp :) );

	if( sizeof(item_nb)<1 )
		return  notify_fail("你目前没有存放任何物品在百宝囊里。\n");     

	msg = HIW "\n目前你百宝囊的物品有：\n编号\t\t物品\n"
		  "──────────────────────────"NOR"\n";
	      
	for (int i = 0; i < sizeof(item_nb); i++) 
	{
		ob_name = baowus[item_nb[i]]["short"]; 
		msg += sprintf("[%3s]    %s\n", item_nb[i], ob_name+"("+baowus[item_nb[i]]["id"][0]+")");
	}
	msg += HIW "──────────────────────────"NOR"\n";
	me->start_more(msg);
	return 1;
}

string long()
{
	object me;
	string *item_nb;
	string msg, msg2,ob_name;

	me = this_player();

	msg = ZJOBLONG+HIG"一个神奇的锦囊，可以存取各种宝贝。"NOR+ZJBR;
	if( !mapp(baowus) )
	{
		msg += "你目前没有存放任何物品在百宝囊里。\n";
		write(msg+"\n");
		return  "";     
	}
	item_nb = sort_array( keys(baowus), (: strcmp :) );

	if( sizeof(item_nb)<1 )
	{
		msg += "你目前没有存放任何物品在百宝囊里。\n";
		write(msg+"\n");
		return  "";     
	}

	msg += HIW"目前你百宝囊中的物品有："ZJBR
		  "一一一一一一一一一一一一一一一一一一一一一一一"NOR"\n";
	msg += ZJOBACTS2+ZJMENUF(2,2,9,30);
	for (int i = 0; i < sizeof(item_nb); i++) 
	{
		ob_name = baowus[item_nb[i]]["short"]; 
		msg += sprintf("[%3s] %s:%s"ZJSEP, item_nb[i], ob_name,"qubao "+item_nb[i]);
	}
	write(msg+"\n");
	return "";
}	

int query_autoload() { return 1; }
