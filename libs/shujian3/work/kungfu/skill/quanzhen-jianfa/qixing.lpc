// qixing. 七星绝命剑
// Modify By River 99.5.26
// Modified by darken@SJ
#include <ansi.h>
#include "/kungfu/skill/eff_msg.h";
inherit F_SSERVER;

string perform_name() {return HIW"七星绝命剑"NOR;}

int perform(object me, object target)
{
        string msg,dodge_skill;
        object weapon = me->query_temp("weapon");
        int damage, p;
        if( !target ) target = offensive_target(me);

         if( !objectp(target)
         || !target->is_character()
         || !me->is_fighting(target) )
                return notify_fail("你只能对战斗中的对手使用「七星绝命剑」绝技。。\n");

        if( (int)me->query_skill("quanzhen-jianfa", 1) < 40 )
                return notify_fail("你的全真剑法不够熟练，使不出「七星绝命剑」绝技。\n");

        if ( !weapon
         || weapon->query("skill_type") != "sword"
         || me->query_skill_mapped("sword") != "quanzhen-jianfa"
         || me->query_skill_mapped("parry") != "quanzhen-jianfa")
               return notify_fail("你没有激发全真剑法，使不出七星绝命剑。\n");

        if((int)me->query_skill("sword", 1) < 40 )
               return notify_fail("你的基本剑法还不够娴熟，使不出「七星绝命剑」绝技。\n");

        if((int)me->query_dex() < 15)
               return notify_fail("你的身法还不够迅速，使不出「七星绝命剑」绝技。\n");

        if((int)me->query_skill("force", 1) < 40)
               return notify_fail("你的基本内功修为不够，使不出「七星绝命剑」绝技。\n");  

        if((int)me->query_temp("hebi"))
               return notify_fail("你正在施展双剑合壁，无法使用「七星绝命剑」绝技。\n"); 

        if((int)me->query("neili") < 200)
               return notify_fail("你的内力不够，无法使用「七星绝命剑」绝技。\n");

        msg = HIW"\n$N一声长啸，一抖手中剑，剑幕中飞出七朵寒星，既如狂风暴雨又如流星般向$n罩了过去。"NOR"\n";

           me->add("neili", -100);
        if(random(me->query("combat_exp")) > (int)target->query("combat_exp")/3 )
        {
           damage = 10 * (int)me->query_skill("quanzhen-jianfa", 1);
           if (damage>1500) damage=1500;
           if (me->query_skill("xiantian-gong")>100) damage *= 2;
               else msg+=HIG"只是$N的先天功还没到家，剑气微弱。"NOR"\n";
           target->receive_damage("qi", damage);
           msg += HIR"$n躲闪不及，身中七剑，“哇”的狂叫一声，鲜血狂喷而出！"NOR"\n";
           p = (int)target->query("qi")*100/(int)target->query("max_qi");
           msg += "( $n"+eff_status_msg(p)+" )\n";
//           target->set_temp("last_damage_from", "被"+me->name()+"杀");
	   target->set_temp("last_damage_from", me);
           me->start_perform(5,"「七星绝命剑」");
        } 
        else {
              dodge_skill = target->query_skill_mapped("dodge");
              if( !dodge_skill ) dodge_skill = "dodge";
              msg += SKILL_D(dodge_skill)->query_dodge_msg(target, 1);
              me->start_busy(2); 
              me->start_perform(3,"「七星绝命剑」");
        }
        message_vision(msg, me, target);
        return 1;
}
