// tizongshu.c 提纵术

inherit SKILL;

string *dodge_msg = ({
  "$n纵身一跳，闪身躲了开去。\n",
  "$n猛的一闪身，向后跳开数尺。\n",
  "$n双脚轻点，身形向后一退。\n",
  "$n轻飘飘地向旁边一闪，$N的攻势尽数落空。\n",
  "$n向高空里一纵身，跃起五尺来高。\n",
  "$n用力一拔，从$N头上跃了过去。\n",
  "$n低头侧身，蜷腿一纵，向旁边跃开七尺。\n",
});

int valid_enable(string usage) {
  return usage == "dodge";
}

int valid_learn(object me) {
  return 1;
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  if ((int)me->query("jingli") < 10)
    return notify_fail("你的体力太差了，不能练提纵术。\n");
  me->receive_damage("jingli", 5);
  return 1;
}
