  "劳宫穴", "膻中穴", "曲池穴", "关元穴", "曲骨穴", "中极穴", "承浆穴", "天突穴",
  "百会穴", "幽门穴", "章门穴", "大横穴", "紫宫穴", "冷渊穴", "天井穴", "极泉穴",
  "清灵穴", "至阳穴", "涌泉穴", "大锥穴", "风府穴",
});

string *xue_name1 = ({
  "大锥穴", "百会穴", "志室穴", "肩井穴", "劳宫穴", "内关穴", "外关穴", "会宗穴",
});
string *xue_name2 = ({
  "曲池穴", "冲阳穴", "臂儒穴", "白海穴", "灵台穴", "风府穴", "神风穴", "玉书穴",
});
string *xue_name3 = ({
  "青门穴", "商阳穴", "丝空竹穴", "气海穴", "冲门穴", "大椎穴", "百里穴", "槐阳穴",
});

string *parry_msg = ({
  "$n不等$N收招，信手一指点出，嗤的一声急响，一道无形剑气直刺$N，$P只好暂避一旁。\n",
  "$n不等$N变招，一指弹出，嗤的一声响，一道无形剑气直指$N，$P慌忙退让，攻势顿缓。\n"
});

string *msgc = ({
  //少泽HIC  「"HIC"少泽剑法"NOR"」
  "忽见$N左手小指一伸，一条气流从$P少冲穴中激射而出，好一招「" HIC "少泽剑法" NOR "」，忽左忽右，变化无常，指向$n" NOR,
  HIC "$N左斜行三步，右手食指虚点，左手小指突然点出，内力斜攻过去，直插$n的$l" NOR,
  "$N手臂陡然一提，在手掌离$n不到一尺之处，使一招「" HIC "少泽剑法" NOR "」,立即翻腕向上，屈掌成拳，小指弹出" NOR,
  HIC "$N左手小指上翘，灵动异常，忽屈忽伸，连续划圈，发出无数劲风" NOR,
  HIC "$N身体一蹲，小指上伸，轻轻弹出，一股无形指风打向$n的$l" NOR,
  //关冲MAG   "MAG"
  MAG "$N长笑一声，俯身斜倚，无名指弹出，指尖已对准$n的$l发出了一缕强烈的劲风" NOR,
  MAG "$N无名指一挥，拙滞古朴的关冲剑气直射而出，端端正正地刺向$n" NOR,
  MAG "$N身体一转，手臂向后伸出，无名指遥遥一指，剑气破空，直向$n的$l" NOR,
  "$N食指一收，无名指突然点出，「" MAG "关冲剑法" NOR "」一发，一条剑气直射而出，快捷无比" NOR,
  MAG "$N双掌交错，缓缓伸出无名指，突然间剑气纵横，一股剑气狂冲而上" NOR,
  //商阳HIG  "HIG"
  HIG "$N变招奇速，右手食指如毒蛇出洞，疾从袖底穿出，大喝一声，双手幻出无数指影" NOR,
  "$N拇指一屈，食指点出，变成了「" HIG "商阳剑法" NOR "」，一缕剑气向$n刺出" NOR,
  "$N食指连动，「" HIG "商阳剑法" NOR "」一剑又一剑的刺出，其轻灵迅速，快速无比" NOR,
  HIG "$N以食指运那无形剑气，却不过是手指在数寸范围内转动，对着$n一点一戳" NOR,
  "$N使出「" HIG "商阳剑法" NOR "」，食指忽屈忽伸，每一下点出，都是一缕无形指风似剑刺出" NOR,
  //中冲HIR
  HIR "$N身体一转，中指反手划出，犹如长风破浪，一道剑气如刀般向前攻出" NOR,
  "$N身形一恭，双手前伸，一式「" HIR "中冲剑法" NOR "」,双手合使，两道凌厉无比的剑气破空刺出" NOR,
  "$N脸色森然，中指一竖，一挑，一式「" HIR "中冲剑法" NOR "」,两道剑气交错而行，向前刺出" NOR,
  HIR "$N将中指向上一弹，中冲剑气汹涌而出，接着$P将手指向下一划，剑气如利刀般砍向$n" NOR,
  HIR "电光火石之间，$N一翻掌，身向右移，奋起神威，右手斗然探出，中指向$n一竖" NOR,
  //少冲HIW
  "$N掌托于胸前，伸出右小指，一招「" HIW "少冲剑法" NOR "」,缓缓地点向$n的周身大穴，弹指无声" NOR,
  "$N小指一弹，使一招「" HIW "分花拂柳" NOR "」，剑势如同柳絮一般，飘而不乱" NOR,
  "$N一招「" HIW "少冲剑法" NOR "」，剑气回转，竟从左侧绕了过来，点向$n的$l" NOR,
  "$N右手小指一挥，一招「" HIW "少冲剑法" NOR "」,点点刺刺，宛如雕花刺画一般" NOR,
  "$N一招「" HIW "少冲剑法" NOR "」,小指一横一竖，交替两道指风一前一后攻向$n" NOR,
  //少商HIB
  HIB "$N大拇指一按，嗤嗤两指，劲道使得甚巧，初缓后急，剑气如怒潮般汹涌而至" NOR,
  "$N大拇指连挥，「" HIB "少商剑气" NOR "」便如是一幅泼墨山水相似，纵横倚斜，寥寥数笔，却是剑路雄劲" NOR,
  "$N的「" HIB "少商剑法" NOR "」大开大阖，气派宏伟，每一剑刺出，都有石破天惊、风雨大至之势" NOR,
  "$N大拇指一屈一伸，使出「" HIB "少商剑法" NOR "」,一道剑气刺出，古朴至极，却是无法可挡" NOR,
  HIB "$N双手围圈，左手紧压右手，右手大拇指慢慢按出，只见一股排山倒海的无形剑气缓缓推出" NOR,
});


int valid_enable(string usage) {
  return usage == "finger" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  string msg;

  if (me->query_temp("liumai")) {
    switch (me->query_temp("liumai")) {
      case 6: msg = HIB "$N双手拇指同时捺出，嗤嗤两声急响，「少商剑」有如石破天惊、风雨大至之势，同时指向$n" NOR; break;
      case 5: msg = HIG "$N食指连动，「商阳剑」一剑又一剑的刺出，轻灵迅速，奇巧活泼，剑气纵横，$n根本无法看清来路" NOR; break;
      case 4: msg = HIR "$N右手中指一竖，「中冲剑」向前刺出。真气鼓荡，嗤然声响，无形剑气直指$n" NOR; break;
      case 3: msg = MAG "$N右手无名指伸出，「关冲剑」剑路拙滞古朴，一股雄浑的内力鼓荡而出，如排山倒海般向$n涌去" NOR; break;
      case 2: msg = HIW "$N右手小指弹出，真气自少冲穴激荡而出，「少冲剑」横生奇变，从意想不到的方向指向$n" NOR; break;
      case 1: msg = HIC "$N左手小指上翘，忽屈忽伸，「少泽剑」出手入风，一股无形指风自左向右打向$n" NOR; break;
      default: msg = HIB "$N反过手来，双手拇指同时捺出，嗤嗤两声急响，「少商剑」有如石破天惊、风雨大至之势，同时指向$n" NOR; break;
    }
    me->add_temp("liumai", -1);
    return ([
      "action": msg,
      "force": 250 + random(350),
      "dodge": 50 + random(30),
      "parry": 50 + random(30),
      "damage": me->query_temp("type") ? 100 + random(100) : 120 + random(120),
      "damage_type": me->query_temp("type") ? "瘀伤" : "瘀伤",
      "weapon": "剑气",
    ]);
  }
  if (!weapon)
    return ([
      "action": msgc[random(sizeof(msgc))],
      "force": 150 + random(300),
      "dodge": 50 + random(30),
      "parry": 50,
      "damage_type": random(2) ? "瘀伤" : "瘀伤",
      "weapon": "剑气",
    ]);

}

int practice_skill(object me) {
  if ((int)me->query("jingli") < 999 || (int)me->query("neili") < 499)
    return notify_fail("你的体力不够练习六脉神剑。\n");

  me->receive_damage("jingli", 1000);
  me->receive_damage("neili", 500);
  return 1;
}

int valid_learn(object me) {
  if ((string)me->query("gender") != "男性")
    return notify_fail("六脉神剑乃是纯阳玄功，你如何可以修习？\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("学习六脉神剑必须空手。\n");
  if ((int)me->query("max_neili") < 4000)
    return notify_fail("你的内力太弱，无法领悟六脉神剑的精髓。\n");
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "six-finger/" + action;
}

int ob_hit(object ob, object me, int damage) {
  string name, msg;
  int skill, neili, neili1;
  int j = 0;
  skill = me->query_skill("six-finger", 1);
  neili = me->query("neili");
  neili1 = ob->query("neili");
  name = xue_name[random(sizeof(xue_name))];


  if (me->query_temp("six-finger")) {
    me->delete_temp("six-finger");
    return j;
  }

  if (skill / 2 > random(ob->query_skill("force", 1)) * 2
    && me->query("combat_exp") > ob->query("combat_exp") / 2
    && me->query_skill_mapped("finger") == "six-finger"
    && me->query_skill_mapped("parry") == "six-finger"
    && neili > 2000
    && skill > 300
    && !me->query_temp("six-finger")
    && !me->is_busy()) {

    //                 me->add_temp("six-finger", 1);

    ob->receive_damage("qi", damage / 2, me);
    ob->receive_wound("qi", damage / 2, me);
    ob->start_busy(2);
    j = (int)ob->query("eff_qi") * 100 / (int)ob->query("max_qi");
    message_vision(
      RED "$N不等$n收招，指力一转直向$n的「" HIW "" + name + "" RED "」点去，$p闪避不及，被$N一指点中。" NOR "\n",
      me,
      ob
    );
    msg = damage_msg(damage, "瘀伤") + "( $n" + eff_status_msg(j) + " )\n";
    message_vision(msg, me, ob);
    j = -(damage * 2 + skill * 3);

    return j;
  }


  else if (skill / 2 > random(ob->query_skill("dodge", 1)) * 2
    && me->query_skill_mapped("finger") == "six-finger"
    && me->query_skill_mapped("parry") == "six-finger"
    && !me->query_temp("six-finger")
    && neili > 2000
  ) {
    //               me->add_temp("six-finger", 1);
    ob->start_busy(1);
    message_vision(
      WHT "$N不等$n收招，指力一转直向$n的「" RED "" + name + "" WHT "」点去，$p慌忙退让，攻势顿时迟滞。" NOR "\n",
      me,
      ob
    );
    j = -(damage * 2 + skill * 3);
    return j;
  }

  else if (random(neili) > neili1 / 5) {
    msg = CYN + parry_msg[random(sizeof(parry_msg))] + NOR;
    message_vision(msg, ob, me);
    j = -damage;
  }
  return j;
}


int hit_ob(object me, object ob, int damage) {
  if (random(me->query_skill("six-finger")) > ob->query_skill("force") / 4) {
    message_vision(HIW "$n被$N" HIY "纯阳真气" HIW "侵体，急忙运功化解，损耗了些许内息！" NOR "\n", me, ob);
    ob->add("neili", -damage / 3);
    if (ob->query("neili") < 0) ob->set("neili", 0);
    return 0;
  }
}
