// beimin-shengong.c 北溟神功
// By Hop

#include <ansi.h>

inherit FORCE;

int valid_enable(string usage) { return usage=="force"; }

int valid_learn(object me)
{
	int lvl = (int)me->query_skill("beiming-shengong", 1);

	if ( me->query("gender") == "无性" && lvl > 49)
		return notify_fail("你无根无性，阴阳不调，难以领会高深的北溟神功。\n");

	if ( me->query_skill("bibo-shengong",1)
	|| me->query_skill("hunyuan-yiqi",1)
	|| me->query_skill("longxiang",1)
	|| me->query_skill("jiuyang-shengong",1)
	|| me->query_skill("taiji-shengong",1)
	|| me->query_skill("yunlong-shengong",1)
	|| me->query_skill("zixia-shengong",1) )
		return notify_fail("你不先散了别派内功，怎能学北溟神功？！\n");

	return 1;
}

int practice_skill(object me)
{
	if( (int)me->query_skill("beiming-shengong", 1) >= 200 ) {
		if( (int)me->query("potential", 1) > 9 && (int)me->query("neili", 1) > 1000) {
			me->improve_skill("beiming-shengong", (int)me->query_int());
			me->add("neili", -200); 
			me->add("potential", -1*(1+random(5)));
			return 1;
		}
		else return notify_fail("你现在的修为不足以提高北溟神功了。\n");
	}
	else return notify_fail("你现在的北溟神功修为只能用学(learn)的来增加熟练度。\n");
}



int ob_hit(object ob, object me, int damage)
{
	int my_neili, my_max, ob_neili, ob_max, j, lvl, cur = 0;

	my_neili = me->query("neili");
	my_max = me->query("max_neili");

	ob_neili = ob->query("neili");
	ob_max = ob->query("max_neili");

	lvl = me->query_skill("beiming-shengong",1);

	if (me->query_temp("beiming") > 0 ) {
		if (me->query_skill_mapped("force") == "beiming-shengong"
		 && ob_neili>100 && random(10)>1) {
			message_vision(HIR"$n的招式击中$N，却大喊一声：不好！"NOR"\n", me,ob);
            tell_object(ob, HIW "原来" + me->name() + "身怀北溟神功，你只觉混身乏力，全身内力如水银般向" + me->name() + "飞泄而去！"NOR"\n");
		tell_object(me, HIW "你默运北溟神功，顿觉" + ob->name() + "的内力源源不绝地流了进来。"NOR"\n");

                if ( ob_neili >= lvl*10 )		j=lvl*10 ;
                if ( ob_neili < lvl*10 )		j=ob_neili ;
		    ob->add("neili",  - j );

	if ( my_neili + j/2 < my_max * 2 ) me->add("neili", j/2 );
      if ( my_neili + j/2 >= my_max * 2 )	me->set("neili",my_max*2);

			cur = damage/2;
		}
	}
	return -cur;
}

mapping exercise_msg(object me)
{
        return ([
                "status_msg" : HIY + me->name()+"盘膝坐下，凝神调息，开始纳天地之精华于己身"NOR,
                "start_my_msg" : HIC"你盘膝坐下，暗运北溟神功，渐入忘我之境，开始纳天地之精华于己身。"NOR"\n",
                "start_other_msg" :HIG + me->name()+"盘膝坐下，暗运内力，试图纳天地之精华于己身。"NOR"\n",
                "halt_msg" : HIW"$N内息一转，迅速收气，缓缓收功站了起来。"NOR"\n",
                "end_my_msg" : HIC"你双眼微闭，缓缓将天地精华之气纳入体内，收功站了起来。"NOR"\n",
                "end_other_msg" : HIC +me->name()+"双眼微闭，缓缓将天地精华之气纳入体内，收功站了起来。"NOR"\n",
                "heal_msg" : HIY"$N神情肃然，双目虚闭，开始吸纳身周天地之精华为已所用，恢复受损元气。"NOR"\n",
                "heal_finish_msg" : HIY"$N将天地精气与内息融纳一体，感觉伤势已然痊愈，神情也变得清朗起来。"NOR"\n",
                "heal_unfinish_msg" : HIR"$N内息难以为继，脸色发白，只好暂停疗伤，站了起来。"NOR"\n",
                "heal_halt_msg" : HIY"$N突感天地精气再难与内息融合,继续疗伤反而有损真元，急忙强压内息，缓缓站起。"NOR"\n",
        ]);
}

string exert_function_file(string func)
{
    return __DIR__"beiming-shengong/" + func;
}