// Skill: shenlong-shenfa.c 神龙身法
// Date : AHA 97/06/22

inherit SKILL;

string *dodge_msg = ({
"只见$n一招「飞龙在天」，纵身高跃，半空中一折一转，飘然落在一旁。\n",
"$n一招「倦鸟归林」，向后纵出数丈之远，避开了$N的凌厉攻势。\n",
"$n使出「金鹏展翅」，陡然身形拔起，在空中几个盘旋，一个转折落在丈许之外。\n"
"但是$n一招「旭日东升」，身形忽地向上高高纵起，$N这一招扑了个空。\n",
"$n一招「影随人移」，身随意转，倏地往一旁挪开了三尺，避过了这一招。\n",
"可是$n使出「变幻无常」，身子一晃，$N的眼前顿时出现了多个$n的身形，当真不知哪个是真哪个是假。\n",
"却见$n足不点地，一招「归去来兮」，瞻之在前，忽焉在后，躲了开去。\n",
"$n一招「轻如鸿毛」，身形飘忽浑不着力，如一片羽毛随风而动，堪堪躲过了$N狂风暴雨般的攻势。\n",
"$n一式「雁去无痕」，长身而起飘然后退，$N一击不中，$n已落在丈许之外。\n",
"$n身形突变，使出「群星灿烂」，围绕$N四处游走。顿时幻化出无数人影，$N目瞪眼呆不知击向何处。\n",
"$n虚步前跨，脚踩七星方位，由天玑至玉衡，一招「斗转星移」已然绕到$N身后。\n",
"$n一招「似左忽右」，身形微晃，有惊无险地避开了$N这一招。\n"
});

int valid_enable(string usage) 
  { return usage == "dodge"; }

int valid_learn(object me) { return 1; }

string query_dodge_msg(string limb)
{
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
   if( (int)me->query("jingli") < 30 )
      return notify_fail("你的体力太差了，不能练峨眉身法。\n");
      me->receive_damage("jingli", 20);
   return 1;
}
