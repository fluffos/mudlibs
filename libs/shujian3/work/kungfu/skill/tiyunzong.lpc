// tiyunzong.c 梯云纵
// written by Xiang

#include <ansi.h>;
inherit SKILL;

string *dodge_msg = ({
"只见$n一式「白鹤冲天」，身体向上笔直地纵起丈余，躲过了$N这一招。\n",
"$n一招「轻如鸿毛」，身形飘忽浑不着力，如一片羽毛随风而动，躲过了$N狂风暴雨般的攻势。\n",
"$n使出「上天梯」身体陡然拔起，越升越高，空中微一转折落在数丈之外，$N的攻势尽数落空！\n",
"$n虚步前跨，脚踩七星方位，一招「斗转星移」，$N顿时失去了$n的踪影。\n",
"$n一式「更上一层楼」，身在空中，左脚在右足上一点，从$N头顶腾空而过。\n",
"$n一个「倦鸟归林」，向后连纵，腾出数丈之远，避开了$N的凌厉攻势。\n",
"$n使出「大鹏展翅」，陡然身形拔起，在空中一个盘旋，轻轻着地。\n",
});

int valid_enable(string usage)
{
	return usage == "dodge";
}

int valid_learn(object me)
{
	if ( me->query_skill("yinyun-ziqi", 1) < 10)
		return notify_fail("你的氤氲紫气等级太低了。\n");
	return 1; 
}

string query_dodge_msg()
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
	if( (int)me->query("jingli") < 100 )
		return notify_fail("你的体力太差了，不能练梯云纵。\n");
	me->receive_damage("jingli", 50);
	return 1;
}

string perform_action_file(string action)
{       
	return __DIR__"tiyunzong/" + action;
}

