int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

int valid_learn(object me) {
  object weapon;

  if ((int)me->query("max_neili") < 200)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("force", 1) < 40)
    return notify_fail("你的基本内功火候太浅。\n");

  if (((int)me->query_skill("yunlong-xinfa", 1) + 200) < (int)me->query_skill("yunlong-jianfa", 1))
    return notify_fail("你的云龙心法太低了。\n");
  if (((int)me->query_skill("yunlong-shenfa", 1) + 200) < (int)me->query_skill("yunlong-jianfa", 1))
    return notify_fail("你的云龙身法太低了。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能练云龙剑法。\n");

  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}


mapping query_action(object me, object weapon) {



  if (me->query_temp("sanxian"))
    return ([
      "action": action[random(sizeof(action))]["action"],
      "damage": 100 + random(100),
      "dodge": 20 + random(30),
      "force": 350 + random(250),
      "parry": 20 + random(30),
      "damage_type": "割伤",
    ]);

  if (me->query_temp("heyi"))
    return ([
      "action": HIR "$N身体下沉，突然左手一掌向地拍出，身子借着掌力飘起，人剑合一扑向$n，这一招精妙绝伦" NOR,
      "force": 400 + random(300),
      "dodge": 30,
      "parry": 30,
      "damage": 200 + random(100),
      "damage_type": "刺伤"
    ]);

  return action[random(sizeof(action))];


}


int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力不够练云龙剑法。\n");

  if (((int)me->query_skill("yunlong-xinfa", 1) + 200) < (int)me->query_skill("yunlong-jianfa", 1))
    return notify_fail("你的云龙心法太低了。\n");
  if (((int)me->query_skill("yunlong-shenfa", 1) + 200) < (int)me->query_skill("yunlong-jianfa", 1))
    return notify_fail("你的云龙身法太低了。\n");

  me->receive_damage("qi", 25);
  return 1;

}

string perform_action_file(string action) {
  return __DIR__ "yunlong-jianfa/" + action;
}




mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  int lvl;
  int p;
  int flvl;

  lvl = me->query_skill("yunlong-jianfa", 1);
  p = me->query("jiali");
  if (me->query_skill_mapped("force") != "yunlong-xinfa")
    return;
  if (lvl < 120 || !damage_bonus || me->query("neili") < 300)
    return;

  flvl = lvl + p;

  if (random(3) == 0) {
    if (victim->query("qi") > flvl * 3) {
      victim->add("qi", -flvl * 3);
      victim->add("eff_qi", -flvl * 2);
    }
    return HIR "$n被一剑刺中要害，鲜血飞出!!" NOR "\n";

  }
}




int ob_hit(object ob, object me, int damage) {
  object weapon, wp;
  string name, msg, wpname, *limbs;
  int ap, dp, j = 0, skill;
  name = xue_name[random(sizeof(xue_name))];
  skill = me->query_skill("yunlong-jianfa", 1);

  if (ob->query("env/invisibility")) return 0;

  if (me->query_skill("yunlong-xinfa", 1) < 100
    || skill < 100
    || me->query("neili") < ob->query("neili") / 4
    || me->query_skill_mapped("force") != "yunlong-xinfa"
    || me->query_skill_mapped("parry") != "yunlong-jianfa"
    || me->query("combat_exp") < ob->query("combat_exp") / 3) return 0;


  if (!objectp(wp = me->query_temp("weapon"))
    || wp->query("skill_type") != "sword") return 0;


  if (me->query_temp("yunlong")) {
    me->delete_temp("yunlong");
    return 1;
  }

  if (random(skill) < 1) me->set_temp("yunlong", 1);

  if (objectp(weapon = ob->query_temp("weapon")))
    msg = weapon->query("skill_type");
  else {
    mapping prepare = ob->query_skill_prepare();
    if (!sizeof(prepare)) msg = "unarmed";
    else msg = keys(prepare)[0];
  }


  wpname = wp->name();

  if (random(me->query_skill("yunlong-jianfa", 1)) > ob->query_skill("dodge") / 3) {
    ob->receive_damage("qi", damage / 2, me);
    ob->receive_wound("qi", damage / 2, me);
    ob->start_busy(3);
    j = (int)ob->query("eff_qi") * 100 / (int)ob->query("max_qi");

    message_vision(
      HIB "$N不等$n收招，" + wpname + HIB "一转直向$n的「" RED "" + name + "" HIB "」点去，$p闪避不及，被$N一剑点中。" NOR "\n",
      me,
      ob
    );

    msg = damage_msg(damage, "内伤") + "( $n" + eff_status_msg(j) + " )\n";
    message_vision(msg, me, ob);
    j = -(damage * 2 + skill * 3);

    return j;

  }


  else if (random(me->query_skill("yunlong-jianfa", 1)) > ob->query_skill("force") / 2) {

    limbs = ob->query("limbs");
    if (weapon) {
      msg = WHT + parry_msg[random(sizeof(parry_msg))] + NOR;
      msg = replace_string(msg, "$W", weapon->name() + WHT);
      msg = replace_string(msg, "$w", wpname + WHT);
      message_vision(msg, ob, me);
    } else {
      msg = HIY "$N不紧不慢将" + wpname + HIY "一立，锋刃正挡在$n身前，";
      if (random(me->query_skill("yunlong-jianfa", 1)) > ob->query_skill("parry") / 2) {
        msg += "$n来不及收招，自己打在了锋刃上！" NOR "\n";
        ob->receive_damage("qi", damage / 3, me);
        ob->receive_wound("qi", damage / 3, me);
        j = (int)ob->query("eff_qi") * 100 / (int)ob->query("max_qi");
        msg += damage_msg(damage, "割伤") + "( $n" + eff_status_msg(j) + " )\n";
        msg = replace_string(msg, "$l", "身上");
        msg = replace_string(msg, "$w", "锋刃");
      } else msg += "$n大吃一惊，连忙收招站开！" NOR "\n";
      message_vision(msg, me, ob);
    }
    return -6000;


  }


  else if (random(me->query_skill("yunlong-jianfa", 1)) > 1) {
    if (weapon) msg = YEL "$N情急之下将" + wpname + YEL "平搭在$n的" + weapon->name() + YEL "之上，顺势一拉，卸掉了$p一部分劲力！" NOR "\n";
    else msg = YEL "$N连忙将" + wpname + YEL "往前一横，挡住了$n一部分劲力！" NOR "\n";
    j = -damage / 2;
  }

  //加上这个条件意味着有些伤害不招架了	else return 0;

  message_vision(msg, me, ob);
  return j;


}
