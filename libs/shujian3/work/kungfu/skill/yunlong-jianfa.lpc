string *parry_msg = ({
  "$p左手剑诀斜引，$w横过，画了个半圈，平搭在$P$W之上，劲力传出，$W登时一沉。\n",
  "$p手中$w斜指，在$W上一搭一引，结果$P的力道被卸在一旁！" NOR "\n",
  "$p挥洒$w在身前划了一个圆圈，剑劲连绵护住全身，竟无半分空隙，将$P之来势化解于无形。\n",
  "只见$p使出四两拨千斤之巧劲，$w斜引，将$P的$W引在一旁！" NOR "\n",
  "$p以数十招剑法连成守势，似有千百柄长剑护住全身，$w圆转如意，竟无半分破绽。" NOR "\n",
  "$n身形绕向$P背后，$N身随剑转，$w反手圈转轻易化解！\n",
  "$p当下凝神专志，将一套云龙剑法使得圆转如意，$w严密异常的守住门户，使$P招数落空。\n",
  "$p一套云龙剑法施展开来，精妙绝伦。$P见$p化解时毫不滞涩，举重若轻，不待$p回手，跳开一步。\n"
});

