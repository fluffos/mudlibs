// jiuyang.c 九阳神功加力

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

string exert_name() { return HIR "九阳神功" NOR; }
int check(object me);
int exert(object me) {
  int skill, i;
  if (!me->is_fighting() && me->query_skill("jiuyang-shengong", 1) < 300)
    return notify_fail("你只能在战斗中用九阳神功来提升自己的战斗力。\n");

  if ((int)me->query("neili") < 400)
    return notify_fail("你的内力不够。\n");

  if ((int)me->query_temp("jiuyang/powerup"))
    return notify_fail("你已经在运功中了。\n");

  skill = (int)me->query_skill("jiuyang-shengong", 1);
  i = skill / 5;  //以前是skill/6+random(skill/10) 略微增加上限 By lsxk

  me->add("neili", -200 + random(200));
  message_vision(HIR "$N微一凝神，运起九阳神功，只见$N的脸色变得红润多了。" NOR "\n", me);
  me->add_temp("apply/attack", i);
  me->add_temp("apply/armor", i * 2);
  me->set_temp("jiuyang/powerup", i);

  check(me);

  call_out("remove_effect", 1, me, skill / 3);
  if (me->is_fighting()) me->start_busy(random(2));
  me->start_exert(1, "九阳神功");
  return 1;
}

int check(object me) {
  if (!me || !me->query_temp("jiuyang/powerup")) return 0;


  if ((int)me->query_skill("jiuyang-shengong", 1) > 200
    && me->query_temp("jiuyang/powerup")
    && me->query_conditions_by_type("poison")
    && !random(5)) {
    message_vision(HIW "$N感到身体有些异常，立即潜运九阳神功，体内毒素顿时被祛除的干干净净！" NOR "\n", me);
    me->clear_conditions_by_type("poison");
  }

  call_out("check", 1, me);

  return 1;

}




void remove_effect(object me, int amount) {
  int i;
  if (!me) return;
  if (amount < 1) {
    i = me->query_temp("jiuyang/powerup");
    me->add_temp("apply/attack", -i);
    me->add_temp("apply/armor", -i * 2);
    me->delete_temp("jiuyang/powerup");
    tell_object(me, HIW "\n你的" HIR "九阳神功" HIW "运行完毕，将内力收回丹田。" NOR "\n");
    return;
  }
  call_out("remove_effect", 1, me, amount - 1);
}
