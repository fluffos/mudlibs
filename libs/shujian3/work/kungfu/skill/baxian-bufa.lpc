// baxian-bufa.c 八仙步法

inherit SKILL;

string *dodge_msg = ({
"$n傲然一笑，身形急旋，扶摇至上，衣裾满天飘舞，使出一式「何仙姑提\n篮散花」空中一折腰，一翻身悄然落在$N的身后。",
"$n悄然一笑，身形急旋，仿佛飞蝶戏花一般，一招「何仙姑嘻笑采山茶」\n绕着$N游走，轻轻巧巧的避开了$N的攻势。",
"$n一提真气，身子急拔，使出一招「铁拐李遨游东海」，幻出数个身影，\n$N不知哪是真哪是假，无从选择。",
"$n若酒醉一般，踉踉跄跄跨出三步，一式「张果老酒醉倒骑驴」闪开了$N\n的攻势",
"$n大步向前，眼见就要撞上$N，一招「吕纯阳月下过洞庭」一拔身形，越\n过$N的头顶，飘然落在$N的背后。",

});

int valid_enable(string usage)
{
	return usage == "dodge"; 
}

int valid_learn(object me)
{
	return 1; 
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
	if( (int)me->query("jingli") < 50 )
		return notify_fail("你的体力太差了，不能练八仙步法。\n");
	me->receive_damage("jingli", 25);
	return 1;
}
