// maxsuck.c
#include <ansi.h>
inherit F_SSERVER;
int exert(object me, object target) {
  int sp, dp;
  int my_max, tg_max, max_suck, skill, lmt1, lmt2;

  lmt1 = (me->query_skill("force") - me->query_temp("apply/force")) * 8 + me->query("combat_exp") / 1000 + me->query_temp("apply/neili");
  lmt2 = (me->query_skill("force") - me->query_temp("apply/force")) * 10 + me->query("combat_exp") / 1000 + me->query_temp("apply/neili") + me->query("age") * 20;


  if (target == me) target = offensive_target(me);
  if (!objectp(target) || target->query("id") == "niao ren")
    return notify_fail("你要吸取谁的丹元？\n");

  my_max = me->query("max_neili");
  tg_max = target->query("max_neili");
  skill = (int)me->query_skill("huagong-dafa", 1);

  if (me->query_temp("sucked"))
    return notify_fail("你刚刚吸取过丹元！\n");
  if (objectp(me->query_temp("weapon")))
    return notify_fail("你必须空手才能施用化功大法吸人丹元！\n");
  if (target->query("age") < 18)
    return notify_fail("小孩子能有什么内力?\n");
  if (me->query("max_neili") > lmt2)
    return notify_fail("你的内力已经超出身体承受的极限，不能再吸取更多的内力！\n");
  if ((int)me->query_skill("huagong-dafa", 1) < 200)
    return notify_fail("你的化功大法功力不够，不能吸取对方的丹元！\n");
  if ((int)me->query("neili", 1) < 200)
    return notify_fail("你的内力不够，不能使用化功大法。\n");
  if ((int)target->query("max_neili") < (int)me->query("max_neili") / 2 || !living(target))
    return notify_fail(target->name() + "丹元涣散，功力未聚，你无法从他体内吸取任何东西！\n");
  if (wizardp(target) || (int)target->query("no_suck"))
    return notify_fail(target->name() + "不能让你吸取内力!\n");
  message_vision(HIR "$N全身骨节爆响，双臂暴长数尺，掌缘猛地向$n的檀中穴印去！" NOR "\n" "\n", me, target);
  if (living(target))
    target->kill_ob(me);
  //    me->kill_ob(target);
  sp = me->query_skill("force") + me->query_skill("dodge") + me->query_skill("huagong-dafa", 1) / 2;
  dp = target->query_skill("force") + target->query_skill("dodge");
  me->set_temp("sucked", 1);
  if ((random(sp) > random(dp))) {
    tell_object(target, HIR "你只觉胸口发闷，全身功力狂泻而出，如融雪般消失得无影无踪！" NOR "\n");
    tell_object(me, HIG "你觉得" + target->name() + "的真元自手掌源源不绝地流了进来。" NOR "\n");
    max_suck = (int)target->query("max_neili") - (int)me->query("max_neili") / 2;
    max_suck = (max_suck / 1000 + (int)me->query_skill(
      "huagong-dafa",
      1
    ) + target->query("jiali")) / 400;
    if (max_suck < 1) max_suck = 1 + random(2);

    if (me->query("max_neili") > lmt1)
      max_suck = 1 + random(2);
    target->add("max_neili", -max_suck);
    me->add("max_neili", max_suck);

    if (target->query("max_neili") < 1) target->set("max_neili", 0);
    if ((int)me->query("potential") < 90)
      me->add("potential", 1);
    me->add("combat_exp", 1);
    me->start_busy(random(4) + 3);
    target->start_busy(3);
    me->add("neili", -10);
    call_out("del_sucked", 15, me);
  } else {
    message_vision(HIY "可是$p看破了$P的企图，机灵地溜了开去。" NOR "\n", me, target);
    me->start_busy(4);
    call_out("del_sucked", 10, me);
  }
  return 1;
}
void del_sucked(object me) {
  if (me && me->query_temp("sucked"))
    me->delete_temp("sucked");
}


int help(object me) {
  write(BLU "\n化功大法「吸」：" NOR "\n");
  write(@HELP
吸取对方的内力。
要求：
化功大法 200 级；       
HELP
  );
  return 1;
}
