// tiesha-zhang.c 铁砂掌

inherit SKILL;

string *unarmed_parry_msg = ({
  "$n使出一招「夸夫追日」，掌力一吐，身子斜向左方，挡开了$N的$w。\n",
  "$n一招「漫天飞雪」，掌风似墙一般将$N的$w挡了回去。\n",
});
string *unarmed_parry_msg2 = ({
  "$n使出「盘古开天」，反攻$N$l，$N只好收回$w。\n",
  "$n掌开乾坤，双掌一上一下，内力吐出，将$N的攻势化解了。\n",
});


mapping *action = ({
  ([
    "action": "$N催动掌力，一招「飞沙走石」，击向$n的$l",
    "lvl": 0,
    "skill_name": "飞沙走石",
    "damage_type": "瘀伤"
  ]),
  ([
    "action": "$N使出一招「盘古开天」，身形跃起，双掌齐向$n后脑扫去！",
    "lvl": 15,
    "skill_name": "盘古开天",
    "damage_type": "瘀伤"
  ]),
  ([
    "action": "$N左虚右实，一招「蛟龙探海」，化掌为拳，击向$n小腹气海穴",
    "lvl": 30,
    "skill_name": "蛟龙探海",
    "damage_type": "瘀伤",
  ]),
  ([
    "action": "$N运起掌力，大喝一声，一招「泰山压顶」，身子腾空而起，双掌齐向$n面门击去",
    "lvl": 40,
    "skill_name": "泰山压顶",
    "damage_type": "瘀伤"
  ]),
  ([
    "action": "$N一招「横扫六合」，手掌殷红如血，催动内力击向$n$l",
    "lvl": 50,
    "skill_name": "横扫六合",
    "damage_type": "瘀伤"
  ]),
  ([
    "action": "$N一记开山掌，击向$n$l，身子跟着揉纵而上，另一只手掌后发先至",
    "lvl": 60,
    "skill_name": "开山掌",
    "damage_type": "瘀伤"
  ]),
  ([
    "action": "$N右手微拳，探步向左，使出一招「力劈群魔」，右手后缩，肘部重重地撞向$n胸部",
    "lvl": 70,
    "skill_name": "力劈群魔",
    "damage_type": "瘀伤"
  ]),
});

int valid_enable(string usage) { return usage == "strike" || usage == "parry"; }

int valid_combine(string combo) { return combo == "yingzhua-gong"; }

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练铁砂掌必须空手。\n");
  if ((int)me->query_skill("force", 1) < 10)
    return notify_fail("你的基本内功火候不够，无法练铁砂掌。\n");
  if ((int)me->query("max_neili") < 50)
    return notify_fail("你的内力太弱，无法练铁砂掌。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, level, j;
  level = (int)me->query_skill("tiesha-zhang", 1);
  for (i = sizeof(action); i > 0; i--) {
    if (level > action[i - 1]["lvl"]) {
      j = NewRandom(i, 20, level / 5);
      return ([
        "action": action[j]["action"],
        "damage_type": action[j]["damage_type"],
        "lvl": action[j]["lvl"],
        "force": 100 + random(250),
        "dodge": random(20) - 10,
        "parry": random(10),
      ]);
    }
  }
}

int practice_skill(object me) {
  int lvl = me->query_skill("tiesha-zhang", 1);
  int i = sizeof(action);

  while (i--) if (lvl == action[i]["lvl"]) return 0;

  if ((int)me->query("jingli") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 10)
    return notify_fail("你的内力不够练铁砂掌。\n");
  me->receive_damage("jingli", 20);
  me->add("neili", -5);
  return 1;
}

string query_parry_msg(object weapon, object target) {
  if (objectp(target->query_temp("weapon")))
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
  else
    return unarmed_parry_msg2[random(sizeof(unarmed_parry_msg2))];
}
