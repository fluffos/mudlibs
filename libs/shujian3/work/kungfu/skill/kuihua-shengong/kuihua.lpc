//by yueying@SJTY 6/7/2008
//葵花
#include <ansi.h>
void remove_effect(object me, int amount);
inherit F_SSERVER;
void kuihua_aoto(object me);

string exert_name() { return HIR "葵花" NOR; }
int exert(object me, object target) {
  int skill, sk;

  /*
    if( target != me ) 
        return notify_fail("葵花挪移大法只能对自己使用。\n");
    */
  if ((int)me->query("neili") < 1000)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_temp("apply/shade_vision"))
    return notify_fail("你已经在运功中了。\n");
  skill = me->query_skill("kuihua-shengong", 1);
  if (skill < 90) return notify_fail("你的葵花神功还不够娴熟。\n");

  skill = skill + me->query_skill("dodge") / 2;
  sk = skill;
  skill = skill / 3;
  if (me->query("gender") == "女性") skill = skill * 2 / 3;

  message_vision(HIW "$N微一凝神，运起葵花神功，整个人如同被烟雾笼罩一般，飘忽不定。\n"
    HIB "  鬼魅至极" NOR "\n", me);

  me->add("neili", -300);
  me->set_temp("apply/shade_vision", 1);

  me->set_temp("buff/kuihua", 1); /*葵花buff标志*/

  me->add_temp("apply/dodge", skill * 3 / 2);
  me->add_temp("apply/parry", skill);
  me->add_temp("apply/attack", skill);

  if (wizardp(me) && me->query("env/debug"))
    tell_object(me, "你的「" HIW "葵花神功" NOR "」增加：「" HIW "有效身法 " NOR "」"
      +skill + "；「" HIW "命中率" NOR "」 " + skill + "；「" HIW "招架 " NOR "」" + skill
      + " ；「" HIW "持续时间" NOR "」 " + sk / 2 + "。" NOR "\n");

  me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill :), sk / 2);

  me->start_exert(2 + random(2), "葵花");
  if (me->is_fighting()) me->start_busy(1);

  kuihua_aoto(me);
  return 1;
}
void remove_effect(object me, int amount) {
  if (!me) return;
  me->delete_temp("apply/shade_vision");
  me->delete_temp("buff/kuihua", 1); /*葵花buff标志删除*/ me->add_temp("apply/dodge", -(amount * 3 / 2));
  me->add_temp("apply/parry", -amount);
  me->add_temp("apply/attack", -amount);

  message_vision(BOLD "$N的葵花运行完毕，全身忽的一顿，现出整个身形。" NOR "\n", me);
}

void kuihua_aoto(object me) {
  int lvl, i, j;
  object target;
  if (!me) return;
  if (!me->query_temp("buff/kuihua")) return;

  target = offensive_target(me);

  lvl = (int)me->query_skill("kuihua-shengong", 1) * 2 + (int)me->query_skill("dodge", 1) / 2;
  if (target) {
    if (me->is_fighting(target)) {
      if (random(lvl) + lvl / 2 > ((int)target->query_skill("dodge")) * 3 / 4) {
        j = random(2) + 1;  //随机出1－2招

        message_vision(
          HIR "$N“嘿嘿~~”冷笑数声，鬼魅似的身影迅速向$n攻出" NOR HIC + chinese_number(j) + HIR "招！" NOR "\n",
          me,
          target
        );

        for (i = 0; i < j; i++) {
          if (me && target)
            COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
        }
      }
    }
  }
  //随机出招时间
  if (me)
    call_out("kuihua_aoto", random(2) + 1, me);
}

int help(object me) {
  write(YEL "\n葵花神功「" MAG "葵花" YEL "」：" NOR "\n");
  write(@HELP
    葵花神功前朝太监遗留神功，东方不败练此功后称霸一方而无敌，号称“不败”。
    此神功一旦运用，便可增强身体灵活度，抗击能力也大幅度提升，并且让对手
    看不到已身，随着身法的灵活度增加，战斗中便可更轻易地快速攻击对手！
    
    指令：exert kuihua 对手ID

    要求：当前内力 1000 以上。
    说明：除增加自身状态外，同时隐身并加快攻击速度，另提升辟邪刺目命中率。
        该技能在非战斗时只能增益自身状态，在战斗中可指定对手而快速攻击！
    
HELP
  );
  return 1;
}

void reset() {}
int clean_up() { return 1; }
