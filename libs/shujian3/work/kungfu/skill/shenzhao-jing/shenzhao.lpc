// shenzhao.c   神照经之「神照」
// Create By yitian 2014.12.6


#include <ansi.h>
string exert_name() {return HIY"神照"NOR;}
int check(object me);
int exert(object me)
{


   if( (int)me->query_skill("shenzhao-jing", 1) < 200 )
           return notify_fail("你的神照经修为还不够。\n");

   if( (int)me->query_skill("force", 1) < 200 )
           return notify_fail("你的基本内功修为还不够。\n");

   if( (int)me->query_skill("shenzhao-jing", 1) < 200 )
           return notify_fail("你的神照经修为还不够。\n");

   if( (int)me->query_skill("medicine", 1) < 120 )
		return notify_fail("你的本草术理等级不够。\n");

   if( (int)me->query("max_neili") < 2000 )
           return notify_fail("你的内力修为还不够。\n");

   if( (int)me->query("max_jingli") < 1500 )
           return notify_fail("你的精力修为还不够。\n");

   if( (int)me->query("neili") < 1500 )
		return notify_fail("你的真气不够。\n");

   if( (int)me->query("jingli") < 500 ) 
		return notify_fail("你的精力不够。\n");
/*
   if( (int)me->query(QUESTDIR4+"shenzhao") < 2 )
           return notify_fail("你还需向狄云请教神照经的奥妙，才能熟练运用「神照」绝技。\n");
*/
   if( me->query_temp("shenzhao") )
           return notify_fail("你正在运用神照经之「神照」绝技！\n");


   message_vision(HIY"$N深深吸了一口气，神照经内劲遍布全身，似乎能抵挡任何伤害！"NOR"\n", me);
   me->set_temp("shenzhao", 1);  
   me->add("neili", - 500);
       check(me);
   me->start_exert(random(2),"「神照」");
   me->start_busy(1+random(2));
	return 1;
}

int check(object me)
{
   if( !me || !me->query_temp("shenzhao") ) return 0;

	if( me->is_ghost() || !living(me) )
           me->delete_temp("shenzhao");

   if( me->query("jingli") < 200 
      || me->query("neili") < 500
	|| me->query("qi") < 1		// 避免 BUG，气（-1）还恢复
	|| (userp(me) && me->query_skill_mapped("force") != "shenzhao-jing") ) {
		me->start_call_out( (: call_other, __FILE__, "remove_effect", me :), 1);
	}
	else {
           if( (int)me->query("eff_qi") < (int)me->query("max_qi") && !me->is_busy() && !random(10)) {
                   message_vision(HIG"$N一皱眉，催动神照经为自己疗伤，就一会功夫，$N看上去面色红润了不少！"NOR"\n",me);
                   me->add("neili", -me->query_skill("shenzhao-jing", 1)/10 );
		   me->add("eff_qi", (me->query_skill("medicine", 1)+me->query_skill("shenzhao-jing", 1))/10);
			if( me->query("eff_qi") > me->query("max_qi") )
			        me->set("eff_qi", me->query("max_qi"));

		}
           else if( (int)me->query("eff_jing") < (int)me->query("max_jing") && !me->is_busy() && !random(10) ) {
                   message_vision(HIC"$N一皱眉，催动神照经调理受损精神，$N神色逐渐恢复了正常！"NOR"\n",me);
                   me->add("neili", -me->query_skill("shenzhao-jing", 1)/10 );
                   me->add("eff_jing", me->query_skill("shenzhao-jing", 1)/10);
                   if( me->query("eff_jing") > me->query("max_jing") )
                          me->set("eff_jing", me->query("max_jing"));
           }

/*
        if((int)me->query_skill("shenzhao-jing",1) > 200 && me->is_fighting()){
           if( me->is_busy() && !random(10) ){
               message_vision(HIM"$N行动一受制，立即潜运神照经，慢慢使自己脱离险境！"NOR"\n",me);
               me->start_busy(random((int)me->query_busy()));
           }

           if( me->query_condition("no_perform") && !random(10)){
               message_vision(HIW"$N发现自己已被封招，便连连催动神照经，让自己行动渐渐恢复正常！"NOR"\n",me);
               me->apply_condition("no_perform",random((int)me->query_condition("no_perform")));
           }

           if( me->query_condition("no_exert") && !random(10)){
               message_vision(HIR"$N发现自己已被闭气，急忙暗运神照经，渐渐恢复受损经络穴道！"NOR"\n",me);
               me->apply_condition("no_exert",random((int)me->query_condition("no_exert")));
           }

           if( me->query_condition("no_force") && !random(10)){
               message_vision(HIB"$N发现自己已内息不匀，急忙催动神照经，调理内息！"NOR"\n",me);
               me->apply_condition("no_force",random((int)me->query_condition("no_force")));
           }
        }
*/
           call_out("check", 1, me); 
	}
	return 1;
}       

void remove_effect(object me)
{
        if( !me || !me->query_temp("shenzhao") ) return;
        me->start_exert(0);
        me->delete_temp("shenzhao");
        message_vision(HIW"$N「神照」绝技用毕，长长地呼出了一口浊气！"NOR"\n", me);
}

int help(object me)
{
        write(WHT"\n神照经「"HIY"神照"WHT"」："NOR"\n\n");
        write(@HELP
   神照经乃当世内功一绝,非常人能道也!此「神照」绝技乃是神照经最大特色，在战斗中，不但有机会治疗自己气的损伤，也有机会治疗精的受伤，但这个还不是全部，神照经到达一定境界后，甚至可以在战斗中调理内息，解除自身的各种不良状态。

   要求：  当前内力 600 以上；
           当前精力 400 以上；
           最大内力 2000 以上；
           最大精力 1600 以上；
           神照经等级 200 以上；
           基本内功等级 200 以上；
           本草术理等级 120 以上；
HELP
        );
        return 1;
}
