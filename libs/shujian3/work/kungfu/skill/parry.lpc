// parry.c

inherit SKILL;
//武器对武器
string *parry_msg = ({
        "只听见「锵」一声，$w和$W相击，溅起几点火星。\n",
        "结果「当」的一声，$w被$n用$W架住了。\n",
        "但是$n身子一侧，用$W格开了$N的$w。\n",
});
//武器对空手
string *parry_msg2 = ({
        "结果「啪」的一声，$n的左手稳稳挡在$N的$w前。\n",
        "$n撤回$W横在$N$w前面，挡住了$N这一招。\n",
        "但是$P的$w被$n用$W架开了。\n",
});
//空手对武器
string *unarmed_parry_msg = ({
        "但是被$n用手一推，$w失了准头，和$p的$l偏了几寸。\n",
        "$n往$P的手腕轻轻一按，结果$N的$w偏向一边。\n",
});
//空手对空手
string *unarmed_parry_msg2 = ({
        "结果「啪」的一声轻响，$n把$P的$w挡住了。\n",
        "只听「砰」的一声闷响，$n和$N的$w重重地击在一起。\n",
        "只听「砰」的一声大响，$n和$N的$w重重地击在一起。\n",
});


string query_parry_msg(object weapon,object weapon2)
{
	string msg;
        if( weapon && weapon2)	 {
			msg = parry_msg[random(sizeof(parry_msg))];
			msg = replace_string( msg, "$W", weapon->query("name") );
                return msg;
		}
        else if( weapon && !weapon2)	 {
			msg = parry_msg2[random(sizeof(parry_msg2))];
			msg = replace_string( msg, "$W", weapon->query("name") );
                return msg;
		}
        else if(!weapon && weapon2)
                return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
        else
                return unarmed_parry_msg2[random(sizeof(unarmed_parry_msg2))];
}
