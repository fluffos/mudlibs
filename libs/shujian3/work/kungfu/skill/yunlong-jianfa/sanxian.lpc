//三现 sanxian.c 

#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;

string perform_name() {return MAG"云龙三现"NOR;}

int perform(object me, object target)
{

        object weapon;
        int i;

        weapon = me->query_temp("weapon");
       
        if( !target ) target = offensive_target(me);
         if( !objectp(target)) return notify_fail("你要对谁攻击？\n");

        if( !me->is_fighting() )
                return notify_fail("「云龙三现」只能在战斗中使用。\n");
 
        weapon = me->query_temp("weapon");

        if (!weapon || weapon->query("skill_type") != "sword"
        || me->query_skill_mapped("sword") != "yunlong-jianfa")
                return notify_fail("手中无剑,你怎么使得出「云龙三现」！\n");

        if( (int)me->query("max_neili") < 1000 )
                return notify_fail("你的内力不够！\n");
                
        if( (int)me->query("neili") < 500 )
                return notify_fail("你的真气不够！\n");

        if( (int)me->query("jingli") < 300 )
                return notify_fail("你的精力不够！\n");

        if( (int)me->query_str() < 24 )
                return notify_fail("你的臂力不够！\n");

        if( (int)me->query_dex() < 24 )
                return notify_fail("你的身法不够！\n");

        if( (int)me->query_skill("yunlong-jianfa",1) < 100 )
                return notify_fail("你的云龙剑法还不到家，无法使用「云龙三现」绝技！\n");

        if( (int)me->query_skill("sword",1) < 100 )
                return notify_fail("你的基本剑法造诣不够，无法使用如此高深的「云龙三现」绝技！\n");

        i = (int)me->query_skill("yunlong-jianfa",1)/3;
        if (i > 800) i=800;

       message_vision(MAG"\n$N使出云龙剑法的绝招「云龙三现」，顿时风起云涌！
$N一大步跃起在空中，身体围绕着$n不停旋转，从不同方向出剑攻向$n，轨迹妙不可言"NOR"。"NOR"\n", me,target);
        me->add("neili",-(150+random(50))); 
        me->add("jingli",-50); 
	  me->set_temp("sanxian",3);
                me->add_temp("apply/sword", i);
		    me->add_temp("apply/attack", i);
      if(me->is_fighting(target))
	     COMBAT_D->do_attack(me, target, me->query_temp("weapon"), random(2)?1:3);
	if( me->is_fighting(target))
           COMBAT_D->do_attack(me, target, me->query_temp("weapon"), random(2)?1:3);
	if( me->is_fighting(target))
           COMBAT_D->do_attack(me, target, me->query_temp("weapon"), random(2)?1:3);

       message_vision(HIC"\n$N借着$n的劲风在空中一荡，再出几剑攻向$n，剑光如出海蛟龙一般，迅猛无比"NOR"。"NOR"\n", me,target);
      if(me->is_fighting(target))
	     COMBAT_D->do_attack(me, target, me->query_temp("weapon"), random(2)?1:3);
	if( me->is_fighting(target))
           COMBAT_D->do_attack(me, target, me->query_temp("weapon"), random(2)?1:3);
                    me->delete_temp("sanxian");


	              me->set_temp("heyi",1);
                    target->set_temp("must_be_hit", 1);
      if(me->is_fighting(target))
           COMBAT_D->do_attack(me, target, me->query_temp("weapon"), random(2)?1:3);
                    target->delete_temp("must_be_hit", 1);      
          me->add_temp("apply/sword", -i);
                me->add_temp("apply/attack", -i); 
       	  me->delete_temp("heyi");
        me->start_perform( 3 + random(2), "「云龙三现」");
        return 1;
}
