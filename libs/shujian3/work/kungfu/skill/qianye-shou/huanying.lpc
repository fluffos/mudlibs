// huanying.c 如来千叶手「幻影」
// by yitian //2014.11.28

#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target)
{
        string msg;
        if( !target ) target = offensive_target(me);

        if( !objectp(target) 
         || !me->is_fighting(target)
         || !living(target))
           return notify_fail("「幻影」攻击只能对战斗中的对手使用。\n");

        if((int)me->query_int() < 40)
           return notify_fail("你悟性不够,不能使用这一绝技!\n");

        if((int)me->query_skill("yijin-jing",1) < 120)
           return notify_fail("你易筋经的功力不够不能使用「幻影」!\n");

        if((int)me->query_skill("qianye-shou",1) < 120)
           return notify_fail("你的千叶手修为不够,目前还不能使用「幻影」绝技!\n");
        if (me->query_skill_prepared("hand") != "qianye-shou"
        || me->query_skill_mapped("hand") != "qianye-shou" )
                return notify_fail("你必须用千叶手才能出此奇功。 \n");

        if( me->query_skill_mapped("force") != "yijin-jing" )
                return notify_fail("你的内功不对。\n");

        if((int)me->query("max_neili")<1500)
           return notify_fail("你的内力修为尚欠火候。\n");  

        if((int)me->query("neili") < 300)
           return notify_fail("你内力现在不够, 不能使用「幻影」! \n");

        if( target->is_busy() )
           return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧！\n");
        
        msg = HIC "\n$N掌到中途，忽然微微摇晃，使出「"HIB"幻影"HIC"」绝技，登时一掌变两掌，两掌变四掌，四掌变八掌，\n"+
                  "结果$n迟得顷刻，便八掌变十六掌，进而幻化为三十二掌。\n";
           me->start_perform(2,"幻影");    
        if(random(me->query("combat_exp")) > (int)target->query("combat_exp") / 4 ){
           msg +=  HIR"结果$n躲闪不及被漫天掌影裹在核心! "NOR"\n";
           target->start_busy( 3 + random((int)me->query_skill("qianye-shou",1) / 30));
           me->add("neili",-300);
           me->add("jingli",-100);
        }
        else {
           msg += HIM"$n慌乱中镇定心神，仔细看清了$N的身影，漫天手影顷刻间消散干净。"NOR"\n";
           me->add("neili",-100);
           me->add("jingli",-50);
           me->start_busy(1+random(1));
        }
        message_vision(msg, me, target);
        return 1;
}

