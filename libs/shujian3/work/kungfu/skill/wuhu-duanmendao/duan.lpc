#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
 
int perform(object me, object target)
{
	object weapon, ob;
        int lv=me->query_skill("wuhu-duanmendao");
 
	if( !me->is_fighting() )
		return notify_fail("五虎断门刀「断」字决只能在战斗中使用。\n");

	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "blade")
		return notify_fail("你使用的武器不对。\n");

	if( (int)me->query("neili") < 200 )
		return notify_fail("你的真气不够！\n");

	if( (int)me->query_skill("blade") < 60 ||
	    me->query_skill_mapped("blade") != "wuhu-duanmendao")
		return notify_fail("你的「五虎断门刀」还不到家，无法使用「断」字决！\n");

message_vision( HIW "$N使出五虎断门刀「"HIR"断"HIW"」字决，顿时一片白光裹着$P直向前扑去！"NOR"\n", me);

/*
message_vision( HIW"$N使出五虎断门刀「"HIR"断"HIW"」字决，顿时一片白光裹着$P直向前扑去！

  ●／                    ＼●／
 ┃—∝╬▅▆▇◤          ┃┃  
／ ）                      ／ ＼  
  ●／                      ●   
 ┃—∝╬▅▆▇◤         ＜┃＞ 
／ ）                      ／＼ 
  ●／                    ＼●   
 ┃—∝╬▅▆▇◤         （ ＞ 
／ ）                      ／＼ "NOR"\n", me);
*/
	me->clean_up_enemy();
	ob = me->select_opponent();

        me->add_temp("apply/attack", lv);
        if (lv<150) 
          {me->add_temp("apply/damage", lv);
           me->set_temp("duan", 1);}

	COMBAT_D->do_attack(me, ob, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, ob, me->query_temp("weapon"));
	COMBAT_D->do_attack(me, ob, me->query_temp("weapon"));

        me->add_temp("apply/attack", -lv); 
        if (me->query_temp("duan")) 
          {me->add_temp("apply/damage", -lv);
           me->delete_temp("duan");}

	me->add("neili", -100);
        me->start_perform(4,"断字诀");
	me->start_busy(random(2));

	return 1;
}
