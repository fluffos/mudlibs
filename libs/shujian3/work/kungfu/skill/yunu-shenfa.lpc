// yunu-shengfa.c 玉女身法
#include <ansi.h>;
inherit SKILL;

string *dodge_msg = ({
HIW"$n一招「洛神凌波」，长袖舞动，掩住身形去处，轻飘飘腾身丈外，躲过了$N这一招。"NOR"\n",
HIM"$n嫣然一笑，风姿绝代，$n已借这「一笑倾国」之势，避开了$N的凌厉攻势。"NOR"\n",
MAG"$n使出「贵妃醉酒」，满面红晕，脚步踉跄中已饶至$N的身后。"NOR"\n",
HIR"$n左足点地，眼看$N杀招堪堪袭来，一招「红拂夜奔」，身躯已借势平移，闪过一旁。"NOR"\n",
HIG"$n一式「绿珠坠楼」，身体贴地滑行，真叫人匪夷所思，令$N的攻击已然扑空。"NOR"\n",
});

string *dodge_msgm = ({
"但是$n一招「旭日东升」，身形忽地向上高高纵起，$N这一招扑了个空。\n",
"$n一招「影随人移」，身随意转，倏地往一旁挪开了三尺，避过了这一招。\n",
"可是$n使出「变幻无常」，身子一晃，$N的眼前顿时出现了多个$n的身形，当真不知哪个是真哪个是假。\n",
"却见$n足不点地，一招「归去来兮」，瞻之在前，忽焉在后，躲了开去。\n",
"$n一招「轻如鸿毛」，身形飘忽浑不着力，如一片羽毛随风而动，堪堪躲过了$N狂风暴雨般的攻势。\n",
"$n虚步前跨，脚踩七星方位，由天玑至玉衡，一招「斗转星移」已然绕到$N身后。\n",
});

int valid_enable(string usage) { return (usage == "dodge"); }

int valid_learn(object me)
{
	if ( me->query_skill("yunu-xinjing", 1) < 10)
		return notify_fail("你的玉女心经等级不够，无法领悟玉女身法的要诀。\n");
	return 1;
}

string query_dodge_msg(object me)
{
	if(me->query("gender") == "女性")
	return dodge_msg[random(sizeof(dodge_msg))];
else
	return dodge_msgm[random(sizeof(dodge_msgm))];
}

int practice_skill(object me)
{
	if((int)me->query("jingli") < 300 )
		return notify_fail("你该休息一下了，等会再练玉女身法吧。\n");
	me->receive_damage("jingli", 100);
	return 1;
}

mapping query_action(object me, object weapon)
{
	int level,out;
	level   = (int) me->query_skill("yunu-shenfa",1);
	out = (stringp(environment(me)->query("outdoors"))?1:0);
	if(me->query("family/family_name")!="古墓派")
		return ([
			"action":dodge_msg[random(sizeof(dodge_msg))], 
			"dodge": -level/3,
		]);
	if(me->query("gender") == "男性")
		return ([
			"action":dodge_msgm[random(sizeof(dodge_msgm))],
			"dodge": level/3 + me->query_con() - out*level/5,
		]);
	else
		return ([
			"action":dodge_msg[random(sizeof(dodge_msg))],
			"dodge": level/2 + me->query_per()*4 - out*level/5,
		]);
}
