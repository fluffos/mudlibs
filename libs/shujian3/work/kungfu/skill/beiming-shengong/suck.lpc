#include <ansi.h>
inherit F_SSERVER;

int exert(object me, object target)
{       
	int skill, my_neili, my_max, tg_neili, tg_max, j;

	if( !target ) target = offensive_target(me);

	if( !objectp(target) || !necessary(target) )
		return notify_fail("没有吸取内力的对象。\n");

	if ( target == me ) target = offensive_target(me);

	if( environment(me)->query("no_fight") )
		return notify_fail("在这里不能攻击他人。\n");

	if( !objectp(target) ||
		target->query("id") == "mu ren" ||
		target->query("id") == "jin ren" )
		return notify_fail("你要吸取谁的内力？\n");


//	if (!userp(target) && !target->accept_hit(me)) return 0;

	if (target->query("race") != "人类")
		return notify_fail("搞错了！只有人才能有丹元！\n");
       
	if ( me->query_temp("sucked") )
		return notify_fail("你刚刚吸取过内力！\n");

	if( objectp(me->query_temp("weapon")) )
		return notify_fail("你必须空手才能施用北溟神功吸人内力！\n");

//	if( !me->is_fighting() || !target->is_fighting())

	if( (int)me->query_skill("beiming-shengong",1) < 90 )
		return notify_fail("你的北溟神功功力不够，不能吸取对方的内力！\n");

/*	if( (int)me->query("neili") > 2*(int)me->query("max_neili")  )
		return notify_fail(HIR "你只觉膻中气海似乎要胀裂开一般，心中燥热难当之极。"NOR"\n");

	if( (int)me->query("neili") < 10 )
		return notify_fail("你的内力不够，不能使用北溟神功。\n");

	if( (int)me->query_skill("force") < (int)me->query("max_neili") /10 )
		return notify_fail("你的内功太低了，再吸取也是徒劳。\n");

	if( (int)target->query("max_neili") < (int)me->query("max_neili")/10 )
		return notify_fail( target->name() + "的内功修为远不如你，你无法从他体内吸取丹元！\n");
*/

	if( (int)target->query("neili") < 100 )
		return notify_fail( target->name() + "丹元涣散，功力未聚，你无法从他体内吸取任何东西！\n");


	my_neili = me->query("neili");
	my_max = me->query("max_neili");

	tg_neili = target->query("neili");
	tg_max = target->query("max_neili");


	skill = me->query_skill("beiming-shengong",1);



	message_vision(HIW"$N全身一振，伸出右手，轻轻贴在$n的身上。"NOR"\n", me, target);

        if ( skill > 100 ) {
        	
                message_vision(HIR"$n只觉全身乏力，全身功力如融雪般消失得无影无踪！"NOR"\n", me, target);
		message_vision(HIY"$N觉得$n的内力自手掌源源不绝地流了进来！"NOR"\n", me, target);

                if ( tg_neili >= skill*30 )		j=skill*30 ;
                if ( tg_neili < skill*30 )		j=tg_neili ;

		target->add("neili",  - j );

//                	if ( tg_neili < 1 )
//		target->set("neili",0) ;

		me->add("neili", j/2 );

                	if ( my_neili > my_max*2 )
		me->set("neili",my_max*2) ;

	        me->add("jingli", -100);
	}
	else {
		message_vision(HIW"不管$N用力，$n的丹田真气总是磐然不动。"NOR"\n", me, target); 
	        me->add("neili", - 500);
	        me->add("jingli", -200);
	}

        me->start_exert(2, "「北溟大法」");
	if ( !me->is_perform())
		me->start_perform(1, "「北溟大法」");
	return 1;

}

string exert_name(){ return HIW"北溟大法"NOR; }

int help(object me)
{
        write(HIW"\n北溟神功之「北溟大法」："NOR"\n\n");
        write(@HELP
        要求：  当前内力 2000 以上；
        	后天悟性 45 以上；
                北溟神功等级 200 以上。

HELP
        );
        return 1;
}
