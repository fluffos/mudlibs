// zhihuan.c 七宝指环

#include <ansi.h>
#include <armor.h>

inherit FINGER;

void create()
{
	set_name(HIC"七宝指环"NOR, ({ "qibao zhihuan", "zhihuan", "ring" }));
        set_weight(100);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "个");
                set("long", "又称逍遥神仙环，逍遥派掌门的指环，谁佩戴该指环，谁就是灵鹫宫的主人。\n");
		set("value", 2000);
		set("material", "gold");
		set("armor_prop/parry", 5);
		set("armor_prop/armor", 5);
	}
	setup();
}	
