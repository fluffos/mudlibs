// qilinsuo.c
 
#include <ansi.h> 
#include <armor.h> 
 
inherit NECK; 
 
void create() 
{ 
        set_name( HIC "麒麟踏云锁" NOR, ({ "qilin suo", "suo" }) ); 
        set_weight(500); 
        if( clonep() ) 
                set_default_object(__FILE__); 
        else { 
                set("unit", "根"); 
                set("long", "这是一根打造得非常精美的长命锁，锁坠是一头脚踏祥云的麒麟。据说可以驱魔辟妖。\n"); 
                set("value", 30000); 
                set("material", "silver"); 
                set("armor_prop/qi", 5000);
                set("armor_prop/jing", 3000);
                set("armor_prop/armor", 10); 
             } 
        setup(); 
} 
