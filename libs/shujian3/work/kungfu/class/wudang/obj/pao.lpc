// white-robe.c 太极道袍
// By Marz

#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create()
{
	set_name(WHT"太极道袍"NOR, ({"taiji pao", "cloth", "pao"}) );
        set_weight(1000);
    if( clonep() )
       set_default_object(__FILE__);
    else {
        set("unit", "件");
		set("long", "这是件素雅洁净的白色道袍，前面绣着一个黑白太极图案。\n");
        set("material", "cloth");
        set("armor_prop/armor", 30);
    }
    setup();
}
