// silverring.c 银戒指

#include <ansi.h>
#include <armor.h>

inherit FINGER;

void create() {
  set_name(HIW "银戒指" NOR, ({ "silver ring", "yin ring", "ring" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "这是一个纯银打造的戒指，古朴典雅。\n");
    set("value", 2000);
    set("material", "gold");
    set("armor_prop/parry", 5);
    set("armor_prop/armor", 5);
  }
  setup();
}
