// shoutao.c

#include <ansi.h>
#include <armor.h>

inherit HANDS;

void create() {
  set_name(CYN "分金断玉" NOR, ({ "fenjin duanyu", "fenjin", "duanyu", "shoutao" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "双");
    set("long", "一双暗青色的铁手套，看似笨拙，实则刀枪不入，可分金断玉，是武林中最霸道的兵刃之一。\n");
    set("value", 6000);
    set("material", "hands");
    set("armor_prop/damage", 50);
    set("wudang", 1);
  }
  setup();
}
