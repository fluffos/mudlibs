// jifeng.c

#include <ansi.h>
#include <armor.h>

inherit BOOTS;

void create() {
  set_name(HIW "疾风靴" NOR, ({ "jifeng xue", "xue", "shoes" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "双");
    set("long", "一双缎子面的疾风快靴，穿在脚上特别轻快。\n");
    //                set("value", 6000);
    set("material", "silk");
    set("armor_prop/dodge", 8);
    set("wudang", 1);
  }
  setup();
}
