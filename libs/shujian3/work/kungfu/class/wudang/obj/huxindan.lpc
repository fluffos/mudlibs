// huxin-dan.c 天王护心丹

#include <ansi.h>

inherit ITEM;

void init() {
  add_action("do_eat", "eat");
  add_action("do_eat", "fu");
}

void create() {
  set_name(HIR "天王护心丹" NOR, ({ "huxin dan", "huxindan", "dan" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一颗" + name() + "，武当派炼制的疗伤圣药，功能起死回生。\n");
    set("value", 20000);
    set("unit", "颗");
    set("numb", 999);
    //                set("no_get", 1);
    //                set("no_drop", 1);
    //                set("no_give", 1);
  }
  setup();
}

int do_eat(string arg) {
  int q, j;

  object me, ob;
  me = this_player();
  ob = this_object();

  q = me->query("eff_qi") + me->query_temp("apply/qi");
  j = me->query("eff_jing") + me->query_temp("apply/jing");

  if (!id(arg))
    return notify_fail("你要吃什么？\n");

  if ((int)me->query_condition("medicine") > 0)
    return notify_fail("你上次的药劲儿还没过呢，等会再吃吧。\n");


  /*        if( (int)me->query("eff_qi") > (int)me->query("max_qi")/2 )
                return notify_fail("你没受重伤，吃了这颗灵丹妙药岂不可惜？\n");
        if( (int)me->query("eff_qi") < (int)me->query("max_qi")/10 )
                return notify_fail("你的伤势过重，还是想其他办法吧。\n");
        if (!(fam = this_player()->query("family")) || fam["family_name"] !="武当派")
               {
                tell_object(me, "ｏｏｐｓ！你突然发现身上少了一颗天王护心丹。。。\n");
                destruct(this_object());
                return 1;
               }
        if((int)me->query("combat_exp") < 100000 )
                return notify_fail("你的实战经验太低。\n");
        if((int)me->query_skill("yinyun-ziqi", 1) < 80 )
                return notify_fail("你的氤氲紫气功力不够深厚。\n");
        if((int)me->query_skill("medicine", 1) < 60 )
                return notify_fail("你的药理知识还不足。\n");

     if (this_player()->is_busy() || this_player()->is_fighting())
        return notify_fail("你正忙着呢。\n");
*/

  if ((int)this_player()->query("eff_qi") ==
    (int)this_player()->query("max_qi") && (int)this_player()->query("eff_jing") ==
    (int)this_player()->query("max_jing") && (int)this_player()->query("neili") >
    (int)this_player()->query("max_neili"))
    return notify_fail("你现在不需要吃" + name() + "。\n");

  if (ob->query("numb") > 0) {
    me->set("eff_qi", me->query("max_qi"));
    me->set("eff_jing", me->query("max_jing"));
    me->set("qi", q);
    me->set("jing", j);
    me->set("neili", me->query("max_neili") * 2);
    me->set("jingli", me->query("max_jingli") * 2);
    me->set("food", me->max_food_capacity());
    me->set("water", me->max_water_capacity());
    me->apply_condition("medicine", 2);
    message_vision(HIG "$N服下一颗" + name() + "" HIG "，顿时伤势痊愈气血充盈！" NOR "\n", me);

    ob->add("numb", -1);


    if (mapp(me->query_conditions_by_type("hurt")))
      me->clear_conditions_by_type("hurt");

    if (mapp(me->query_conditions_by_type("wound")))
      me->clear_conditions_by_type("wound");

    if (mapp(me->query_conditions_by_type("poison")))
      me->clear_conditions_by_type("poison");

    if ((int)me->query_condition("fx_busy") > 0)
      me->apply_condition("fx_busy", 0);

    this_player()->start_busy(1);
    return 1;
  }

  if (ob->query("numb") < 1) {
    write("" + name() + "已经被吃的一丝不剩了。\n");
    //           ob->set("long", "一个放"+name()+"的玉瓶。\n");
    //           ob->set("value", 5000);
    destruct(this_object());
    return 1;
  }
}
