
#include <ansi.h>

inherit ITEM;

void init()
{
             add_action("do_eat", "eat");
             add_action("do_eat", "fu");
}

void create()
{
        set_name(CYN"辟谷丹"NOR, ({"bigu dan","bigudan","dan"}));
        set_weight(50);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long","一颗"+name()+"，武当派炼制的普通丹药，能满足身体几天的食物需求。\n");
                set("value", 2000);
                set("unit", "颗");
                set("numb", 999);
          }
   	setup();
}

int do_eat(string arg)
{
      object me, ob;
      
       me=this_player();
       ob=this_object();

      if (!id(arg))
                return notify_fail("你要吃什么？\n");

      if( ob->query("numb") > 0){      
                me->set("food", me->max_food_capacity());
                me->set("water", me->max_water_capacity());
                message_vision(GRN"$N服下一颗"+name()+""GRN"，再也感觉不到饥饿了！"NOR"\n" , me);
                ob->add("numb", -1);
                return 1;
             }
        
       if(ob->query("numb") < 1){
           write(""+name()+"已经被吃的一丝不剩了。\n");
           destruct(this_object()); 
           return 1;
             }
}


