// shoutao.c

#include <ansi.h>
#include <armor.h>

inherit HANDS;

void create()
{
	set_name( WHT"蚕丝手套"NOR, ({ "cansi shoutao", "shoutao" }) );
	set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "双");
                set("long", "这是一双蚕丝和银丝混合编织而成的手套，水火难浸。\n");
		set("value", 6000);
		set("material", "hands");
		set("armor_prop/armor", 15);
		set("wudang",1);
	}
	setup();
}
