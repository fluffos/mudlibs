// sl_cloth.c

#include <ansi.h>
#include <armor.h>

inherit CLOTH;

string setcolor();

void create()
{
        set_name(HIW"五"HIG"彩"HIC"神"HIB"龙"HIR"皮"NOR, ({"shenlong pi", "pi"}));
        set_weight(2500);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "张");
		set("text" , "这是一张五彩神龙的皮，有储存内力(xuli)的功效。"NOR"\n");
		set("long",HIW+query("text") );
                set("value", 8000);
                set("material", "fur");
                set("unique", 1);
                set("treasure",1);
                set("armor_prop/armor", 80);
		set("neili",19000);
        }
        setup();
}

void init()
{
	add_action("do_xuli","xuli");
}

int do_xuli(string arg)
{
	int cost;
	object me = this_player();

	if( query("neili") >= 139000 )
		return notify_fail(""HIW"五"HIG"彩"HIC"神"HIB"龙"HIR"皮"NOR"中已经充满了内力，你再也无法蓄入了！\n");

	if( me->query_skill("force") < 160 )
		return notify_fail("你的内功等级不够，无法往"HIW"五"HIG"彩"HIC"神"HIB"龙"HIR"皮"NOR"中蓄入内力！\n");

	if( me->query_skill("dulong-dafa",1)>100 && me->query_skill_mapped("force")=="dulong-dafa" )
		cost = 1000;
	else
		cost = 1200;

	if( cost > me->query("neili") )
		return notify_fail("你的内力不足，无法往"HIW"五"HIG"彩"HIC"神"HIB"龙"HIR"皮"NOR"中蓄入足够的内力！\n");

	add("neili" ,  10000);
	if (query("neili") > 139000) set("neili" , 139000);
	me->add("neili" , -cost);


	if( cost<=1000 )
		message_vision(BLU"$N"BLU"脸上泛起一层隐隐的黑气，双手虚按五彩神龙皮，把毒龙内力注入其中。"NOR"\n",me);
	else
		message_vision(HIC"$N"HIC"潜运内功，双手虚按"HIW"五"HIG"彩"HIC"神"HIB"龙"HIR"皮"HIC"，将内力蓄入其中。"NOR"\n",me);
	
	setcolor();

	return 1;
}


mixed ob_hit(object target, object me, int damage)
{
	int cost , charge = 10;
	string color;
	
	::ob_hit();
	if(query("neili")<= 0 || damage<100)
		return 0;

	if(query("neili")> 0)
	cost = (damage / 2)*charge/10;

	if( cost > query("neili") ) {
		cost = query("neili");
	}		
	add("neili" , -cost);

//	if( wizardp(me) ) 
//		tell_object(me,sprintf("qi:%d , neili:%d   ",qi,cost));

	color = setcolor();	

		message_vision(HIW"五"HIG"彩"HIC"神"HIB"龙"HIR"皮"NOR+color+"突然发出耀眼的光芒，抵挡了$N"+color+"的部分攻势！"NOR"\n",target);

	return -cost;
}

string setcolor()
{
	int lvl;
	string color , s;

	if ( query("neili") != 0 )
		lvl = query("neili") / 10000;
	else
		lvl = 0;
	switch (lvl)  {
		case  0:
		case  1:
		case  2: color = HIW;break;
		case  3:
		case  4: color = HIC;break;
		case  5:
		case  6: color = CYN;break;
		case  7:
		case  8: color = HIB;break;
		case  9:
		case 10: color = BLU;break;
		case 11:
		case 12: color = HIM;break;
		case 13: color = MAG;break;
		default: color = HIW;
	}
	set("name" , HIW"五"HIG"彩"HIC"神"HIB"龙"HIR"皮"NOR );
	
	if( lvl > 0 )
		s = HIW"五"HIG"彩"HIC"神"HIB"龙"HIR"皮"+color+"之内已经蓄有"+CHINESE_D->chinese_number(lvl)+"道内力！"NOR"\n";
	else
		s = "";
	set("long" , color+query("text")+s);

	return color;
}

