// jinguan.c 束发金冠
// by yitian

#include <ansi.h>
#include <armor.h>

inherit HEAD;

void create() {
  set_name(YEL "紫金冠" NOR, ({ "zijin guan", "guan", "faguan" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "顶");
    set("long", "这是一顶束发紫金冠，形制较小，通体布满了装饰花纹。紫金冠的两侧各有一行浮雕游龙，双龙中间点缀着一颗宝珠，呈现出双龙夺珠的造型。\n");
    set("value", 500);
    set("material", "gold");
    set("armor_prop/armor", 5);
    set("wear_msg", "$N拿起紫金冠戴在头上，用一枚玉簪横贯而入固定发髻。\n");
  }
  setup();
}
