#include <ansi.h>
#include <armor.h>

inherit WRISTS;

void create()
{
        set_name( HIG"翡翠护腕"NOR, ({ "feicui huwan", "huwan" }) );
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "副");
                set("long", "这是一副由翡翠制成的护腕，不仅外观华丽，而且非常实用。\n");
//                set("value", 6000);
                set("material", "wrists");
//                set("armor_prop/constitution", 5);
//                set("armor_prop/intelligence", 5);
                set("armor_prop/armor", 10);
                set("wudang",1);
        }
        setup();
}
