#include <ansi.h>

int update_condition(object me, int duration)
{
        string room;
        
        if (duration < 1)
        {
                if (me->query_temp("day_jobs/was_job"))
                {
                        tell_object(me, HIR"宝塔的火势已然遍及整塔，营救行动已然失败，你只好迅速撤离。"NOR"\n");
                        if (room = base_name(environment(me))) {//所处环境检测
                                if (sscanf(room, "/d/jingcheng/wanan-si/%*s")) {//如果玩家在副本中 
                                        me->move("/d/nanyang/kedian1");
                                }
                        }
                        me->clear_conditions_by_type("poison");//清除所有毒
                        me->clear_conditions_by_type("hurt");//清除所有内伤
                        me->clear_condition("was_job");
                        me->delete_temp("day_jobs/was_job");
                        /*确保玩家不死,全部恢复到最佳状态*/
                        me->reincarnate();
                        me->apply_condition("job_busy", 10);
                }
                return 0;
        } 
        if (me->query_temp("day_jobs/was_job"))
        {
                if (room = base_name(environment(me))) {//所处环境检测
                        if (sscanf(room, "/d/jingcheng/wanan-si/%*s")) {//如果玩家在副本中 
                                if (duration < 5)
                                        tell_object(me, HIR"宝塔的火势已经凶猛异常，抓紧时间！"NOR"\n");
                                else if (duration < 10)
                                        tell_object(me, HIR"宝塔的火势已经迅速扩大，抓紧时间！"NOR"\n");
                                else
                                        tell_object(me, HIR"宝塔的火势已经慢慢扩散，抓紧时间！"NOR"\n");
                        }
                }  else
                        me->clear_condition("was_job");
        }
        me->apply_condition("was_job", duration - 1);
        return 1;
}

string query_type()
{
        return "job";
}
