// kickout.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string name,q_name,q_id,q_ip;
	object obj, link_ob;

	if( !arg ) return notify_fail("指令格式 : kickout <玩家名>\n" );

	seteuid(ROOT_UID);

	obj = LOGIN_D->find_body(arg);
	if( !obj || !userp(obj) || !me->visible(obj)) return notify_fail("没有这个玩家....。\n");
	name = obj->short(1);
	q_name = obj->name(1);
	q_id = obj->query("id");
	q_ip = query_ip_name(obj);

	if( me == obj )
		return notify_fail("用 quit 这条指令好些 :) \n");

	if (wiz_level(me) <= wiz_level(obj))
		return notify_fail("想对"+q_name+"下手？很遗憾。。。你不能这么做。\n");

	message_vision("东方明突然出现在$N面前，说道：“"+q_name +"！因为某种原因强制你退出游戏，请稍后尝试重新登录！”\n", obj);
	obj->dismiss_team();
	//add by LinuX for DB_SAVE
	if (!obj->query_temp("db_quit"))
		obj->set_temp("db_quit", 1);
	obj->save();
	destruct(obj);

/*
	link_ob = obj->query_temp("link_ob");
	if (link_ob) {
		link_ob->save();
		destruct(link_ob);
	}
	catch(destruct(obj));
	*/
	if( obj ) return notify_fail("你无法让这个玩家离线。\n");
	else {
		//set("channel_id", me->name() );
		CHANNEL_D->do_channel(this_object(), "rumor", q_name + "因为某种原因，被强行退出了"+MUD_NAME+"。");
		CHANNEL_D->do_channel(me, "wiz", "我将"NOR + name + HIR"踢出了游戏。");
		log_file("nosave/kickout",
			sprintf("%s(%s) kickout %s(%s) at %s\n",
				me->name(1), me->query("id"), q_name, q_id, q_ip
			), me, ({ q_id })
		);
		write("嘻嘻!\n");
	}
	return 1;
}

int help(object me)
{
	write(@HELP
指令格式 : kickout <玩家名>

此命令可以强迫恶意的玩家离线。

HELP );
	return 1;
}
