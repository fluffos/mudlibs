// perform.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	mapping smap, pmap, pfms,skips;
	string force_ski,dodge_ski,parry_ski,weapon_ski,and,*pfm,ski_type,uski_type;
	int lvl,i,j,k,flag;
	string msg,*valid_types,*skis;
	object weapon;

	seteuid(getuid());

	smap = me->query_skill_map();

	pmap = me->query_skill_prepare();

	if(objectp(weapon = me->query_temp("weapon")))
		ski_type = weapon->query("skill_type");

	if (!arg)
	{
		valid_types = ({"finger","hand","cuff","claw","strike","unarmed"});
		j = 3;
		skips = ([]);
		msg = ZJBTSET"b1:内力"ZJBR"回血:exert recover"ZJSEP"b2:内力"ZJBR"回精:exert regenerate"ZJSEP"b3:内力"ZJBR"回体:exert refresh"ZJSEP;
		if(!mapp(smap)||smap==([]))
		{
			while(j<11)
			{
				j++; if(j>11) continue;
				msg += "b"+ j + ":暂未"ZJBR"设定:look"+ZJSEP;
			}
			write(msg+"\n");
			return 1;
		}

		if(force_ski=smap["force"])
		{
			pfms = SKILL_D(force_ski)->query_pfms();
			if(mapp(pfms)&&pfms!=([]))
			{
				pfm = sort_array(keys(pfms), (: strcmp :) );
				for(i=0;i<sizeof(pfm);i++)
				{
					j++; if(j>11) continue;
					msg += "b"+ j + ":" + pfms[pfm[i]]+" "+pfm[i]+ZJSEP;
				}
			}
			skips[force_ski] = 1;
		}
		if(stringp(dodge_ski=smap["dodge"])&&!skips[weapon_ski])
		{
			pfms = SKILL_D(dodge_ski)->query_pfms();
			if(mapp(pfms)&&pfms!=([]))
			{
				pfm = sort_array(keys(pfms), (: strcmp :) );
				for(i=0;i<sizeof(pfm);i++)
				{
					j++; if(j>11) continue;
					msg += "b"+ j + ":" + pfms[pfm[i]]+" dodge."+pfm[i]+ZJSEP;
				}
			}
			skips[dodge_ski] = 1;
		}

		if(objectp(weapon))
		{
			if(stringp(weapon_ski=smap[ski_type])&&!skips[weapon_ski])
			{
				pfms = SKILL_D(weapon_ski)->query_pfms();
				if(mapp(pfms)&&pfms!=([]))
				{
					pfm = sort_array(keys(pfms), (: strcmp :) );
					for(i=0;i<sizeof(pfm);i++)
					{
						j++; if(j>11) continue;
						msg += "b"+ j + ":" + pfms[pfm[i]]+" "+ski_type+"."+pfm[i]+ZJSEP;
					}
				}
				skips[weapon_ski] = 1;
			}
		}
		else if(!objectp(weapon))
		{
			if(mapp(pmap)&&pmap!=([]))
			{//首先推送准备技能
				skis = sort_array(keys(pmap), (: strcmp :) );
				for(k=0;k<sizeof(skis);k++)
				{
					if(skips[pmap[skis[k]]]) continue;

					pfms = SKILL_D(pmap[skis[k]])->query_pfms();
					if(mapp(pfms)&&pfms!=([]))
					{
						pfm = sort_array(keys(pfms), (: strcmp :) );
						for(i=0;i<sizeof(pfm);i++)
						{
							j++; if(j>11) continue;
							msg += "b"+ j + ":" + pfms[pfm[i]]+" "+skis[k]+"."+pfm[i]+ZJSEP;
						}
					}
					skips[pmap[skis[k]]]=1;
				}
			}
/*
			skis = sort_array(keys(smap), (: strcmp :) );
			for(k=0;k<sizeof(skis);k++)
			{
				flag = 1;
				for(i=0;i<sizeof(valid_types);i++)
				{
					if(SKILL_D(smap[skis[k]])->valid_enable(valid_types[i]))
					{
						uski_type = valid_types[i];
						flag = 2;
					}
				}
				if(!skips[smap[skis[k]]]&&flag==2)
				{
					pfms = SKILL_D(smap[skis[k]])->query_pfms();
					if(mapp(pfms)&&pfms!=([]))
					{
						pfm = sort_array(keys(pfms), (: strcmp :) );
						for(i=0;i<sizeof(pfm);i++)
						{
							j++; if(j>11) continue;
							msg += "b"+ j + ":" + pfms[pfm[i]]+" "+skis[k]+"."+pfm[i]+ZJSEP;
						}
					}
				}
				skips[smap[skis[k]]]=1;
			}
*/
		}
		while(j<11)
		{
			j++; if(j>11) continue;
			msg += "b"+ j + ":暂未"ZJBR"设定:look"+ZJSEP;
		}
		write(msg+"\n");
		return 1;
	}

	return 1;
}

int help (object me)
{
	write(@HELP
显示所有可用pfm
HELP );
	return 1;
}
