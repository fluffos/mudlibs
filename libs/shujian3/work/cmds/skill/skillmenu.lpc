//recruit.c

#include <ansi.h>

inherit F_CLEAN_UP;



int main(object me, string arg)
{
	string itemId,pops,*args,skill,target_sk,userid;
	mapping map;

	if (! arg) return notify_fail("指令格式：没有对应技能");
	args = explode(arg,"/");
	skill = args[1];
	target_sk = args[2];
	userid = args[0];
	map = me->query_skill_map();
	pops= ZJOBLONG+"你可以对技能"+to_chinese(skill)+"做如下操作\n";
	
	//write(arg+"\n");
	
	pops+=ZJOBACTS2+ZJMENUF(4,4,9,32);
	
	if (userid!=me->query("id")){
		pops += "请教:learn "+userid+" "+skill+ZJSEP; 
	}else{
		
		if (target_sk=="0"){//没有目标技能
			pops += "练习:lian "+skill+ZJSEP; 
			
			//pops += "准备:prepare "+skill+ZJSEP; 
			//pops += "组合:unhand "+skill+ZJSEP; 
			//pops += "撤销组合:bei none "+ZJSEP; 
			pops += "忘记:abandon "+skill+ZJSEP;
			
			pops += "研究:research "+skill+ZJSEP;
			pops += "演练:yanlian "+skill+ZJSEP;
			pops += "准备:prepare "+skill+ZJSEP;
			
			pops += "技能关联:skills "+skill+ZJSEP; 
			pops += "技能绝招:qskill "+skill+ZJSEP; 
		}else{
			pops += "激发到"+to_chinese(skill)+":jifa "+skill+" "+target_sk+ZJSEP;  
			pops += "撤销激发"+to_chinese(skill)+":jifa "+skill+" none"+ZJSEP;
			pops += "组合"+to_chinese(skill)+":bei "+skill+" "+target_sk+ZJSEP;
			pops += "撤销组合"+to_chinese(skill)+":bei none"+ZJSEP;
		}
			
		
			
		
		
	
		
		
		
	}
	
	
	
	write(pops+"\n");

	
}


int help(object me)
{


	return 1;
}
