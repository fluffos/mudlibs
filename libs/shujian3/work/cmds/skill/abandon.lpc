// abandon.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	int skill_lvl, lvl;
    	int jingcost;
	string skill;
    	string name;
	int lost,queren;

	if (! arg || arg == "")
		return notify_fail("你要放弃什么技能？\n");

	if(sscanf(arg,"%s %d",skill,lvl)!=2)
	{
		return notify_fail(INPUTTXT("你想放弃多少级的"HIY+to_chinese(arg)+NOR"：","abandon "+arg+" $txt#")+"\n");
	}

    	if (me->is_fighting())
		return notify_fail("你正忙着打架呢，哪有时间做这种事？\n");

    	if (lvl<0) {
	        log_file("bug/skill", sprintf(me->query("id")+"因尝试放弃%d级的%s而被记录在案。IP：%s\n",lvl,skill,query_ip_number(me)));
		return notify_fail("你想利用bug？你的行为已经被记录在案！\n");
        }

    	if (me->is_busy())
		return notify_fail("你正忙，没法静下心来。\n");

    	jingcost = me->query("int") + random(me->query("int"));
    	if (jingcost > me->query("jing"))
		return notify_fail("你无法集中精力。\n");

    	name = to_chinese(skill);
    	if (name[0] < 160) name = "这项技能";

	skill_lvl = (int)me->query_skill(skill, 1);
	if (! skill_lvl)
	{
		me->delete_skill(skill);
		write("好了。\n");
		return 1;
	}

    	me->start_busy(2 + random(2));

    	skill_lvl = skill_lvl - lvl;
    	if (skill_lvl < 1)
    	{
		me->delete_skill(skill);
		write("你集中精力不再想【" + name + "】，结果终于将它彻底忘记了。\n");
    	} else
    	{
		me->set_skill(skill, skill_lvl);
		write("你集中精力不再想【" + name + "】，结果有所效果。\n");
    	}
	return 1;
}

int help()
{
	write(@TEXT
指令格式：abandon|fangqi <技能名称>

放弃你的实战经验或是某一项你所学过的技能，成功率和你的天赋有
关，只有能够休息的地方才能够静下心来忘记武功。如果你对这项技
能的修为比较高，一次不一定能够彻底的忘记。

有时候因为武功相克或者你不再打算在某项技能上再下功夫，就可以
使用这条指令放弃它。
TEXT );
	return 1;
}
