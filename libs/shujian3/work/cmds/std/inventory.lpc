#include <ansi.h>

inherit F_CLEAN_UP;

void popMenus(object me,string itemId)
{
        object ob;
        string pops,itemName;
        if (!objectp(me) || itemId=="")
        {
                tell_object(me,"参数错误!\n");
                return;
        }


        
        ob = present(itemId, me);
        if (! objectp(ob) )
        {
                tell_object(me,"你身上没有这个东西!\n");
                return;
        }
        itemName = ob->query("name");
        itemId  = ob->query("id");
        //write(itemId+"\n");
        pops = ZJPOPMENU;
        pops += "放入神行袋|cwd join "+itemId+ZJSP2;
        pops += "查看 "+itemName+"|look "+itemId+ZJSP2;
        pops += "手持 "+itemName+"|hand "+itemId+ZJSP2;
        pops += "放下 "+itemName+"|unwield "+itemId+ZJSP2;
        pops += "喝下 "+itemName+"|drink "+itemId+ZJSP2;
        pops += "吃下 "+itemName+"|eat "+itemId+ZJSP2;
        pops += "穿戴 "+itemName+"|wear "+itemId+ZJSP2;
        pops += "脱掉 "+itemName+"|remove "+itemId+ZJSP2;
        pops += "装备 "+itemName+"|wield "+itemId+ZJSP2;
        pops += "下来 "+itemName+"|unride "+itemId+ZJSP2;
        pops += "研读 "+itemName+"|study "+itemId+ZJSP2;
        pops += "展示 "+itemName+"|eye "+itemId+ZJSP2;
        pops += "出售 "+itemName+"|sellob "+itemId+ZJSP2;
        pops += "丢弃 "+itemName+"|drop "+itemId;
        pops += ZJSP2;
        
        
        write(pops+"\n");

        
        
}




void popMenu(object me,string itemId)
{
        object ob;
        string pops,itemName,*buts;
        mapping map_buts;
        if (!objectp(me) || itemId=="")
        {
                tell_object(me,"参数错误!\n");
                return;
        }


        
        ob = present(itemId, me);
        if (! objectp(ob) )
        {
                tell_object(me,"你身上没有这个东西!\n");
                return;
        }
        itemName = ob->query("name");
        itemId  = ob->query("id");
        //write(itemId+"\n");
        pops= ZJOBLONG+ob->long()+"\n";
        //pops+= ob->query("long")+ZJBR;
        //pops+= "asdasdasdasd"+ZJBR;
        //pops+= "------------------------\n";
        pops+=ZJOBACTS2+ZJMENUF(4,4,9,32);
        pops += "放入神行袋:cwd join "+itemId+ZJSEP; 
        pops += "查看:look "+itemId+ZJSEP; 
        pops += "手持:hand "+itemId+ZJSEP; 
        pops += "放下:unwield "+itemId+ZJSEP; 
        pops += "穿戴:wear "+itemId+ZJSEP;  
        pops += "装备:wield "+itemId+ZJSEP; 
        pops += "脱掉:remove "+itemId+ZJSEP; 
        pops += "喝下:drink "+itemId+ZJSEP; 
        pops += "吃下:eat "+itemId+ZJSEP;  
        pops += "研读:study "+itemId+ZJSEP;  
        pops += "展示:eye "+itemId+ZJSEP; 
        pops += "出售:sellob "+itemId+ZJSEP;  
        pops += "放入:pour "+itemId+ZJSEP;
        pops += "丢弃:drop "+itemId+ZJSEP;  
        
        //加上物品自己的按钮 物品有BUTS属性就可以抓取出来显示
        if (  mapp(map_buts=ob->query("buts"))){
                buts = keys(map_buts);
        }
        if (sizeof(buts)>0){
                foreach(string k in buts){
                        
                        pops+=k+":"+map_buts[k]+ZJSEP;
                }
        }

        
        
        write(pops+"\n");

        
        
}







int main(object me, string arg)
{
        int i,count;
        //环境物件
        object *inv, ob;

        mapping itype;
        string short_name,target,cmd, str,cwdbtn;

        if (arg){
                if (sscanf(arg,"%s %s",cmd,target)==2){
                        if (cmd!="" && cmd=="popmenu" )
                        {//如果是弹窗指令
                                popMenu(me,target);
                                //return 1;
                                return 1;
                        }
                }
        }
        
        
        

        if (! ob) ob = me;


        if (me->query("new_bie") < 1) {
                        me->set("new_bie", 1);
                        me->add("combat_exp", 100);
                        tell_object(me, HIG"恭喜你完成了新手第一步，获得100经验奖励，请按系统提示完成第二步吧。"NOR"\n");
         }
        
        cwdbtn = ZJOBACTS2+ZJMENUF(2,2,8,30)+"神行袋:cwd open"+ZJSEP+"\n";
        
        inv = all_inventory(ob);
        if (! sizeof(inv))
        {
                write(ZJOBLONG+((ob == me) ? "目前你身上没有任何东西。\n"
                                 : ob->name() + "身上没有携带任何东西。\n"));
                
                write(cwdbtn);
                
                return 1;
        }
        str = ZJOBLONG+sprintf("%s身上带著下列这些东西(负重 %d%%)：\n",
                      (ob == me)? "你" : ob->name(),
                      (int)ob->query_encumbrance() * 100 / (int)ob->query_max_encumbrance());
        


        str += ZJOBACTS2+ZJMENUF(2,2,8,30);
       // str+= "神行袋:cwd open"+ZJSEP;
        
        
        for (i = 0; i < sizeof(inv); i++)
        {
                short_name = inv[i]->query("name");
                
                
                if (inv[i]->query("equipped"))
                {
                        short_name = HIC"口"NOR+short_name;
                }
                        
                count = inv[i]->query_amount()==0? 1 :inv[i]->query_amount();
                str+= short_name+"["+count+"]:i popmenu "+inv[i]->query("id")+ZJSEP;
                
                
        }





        write(str+"\n");
        return 1;
}

int help (object me)
{
        write(@HELP
指令格式: inventory
 
可列出你(你)目前身上所携带的所有物品。
 
注 : 此指令可以 " i " 代替。

HELP );
        return 1;
}
