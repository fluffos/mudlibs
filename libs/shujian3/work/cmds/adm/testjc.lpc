// exercise.c
#include <ansi.h>
inherit F_CLEAN_UP;
int exercising(object me, string *str);
int halt_exercise(object me);

int main(object me, string arg)
{
      
	int exercise_cost;
	string *str;

	seteuid(getuid());

	if (me->is_busy() || me->query_temp("pending/exercising"))
		return notify_fail("你现在正忙着呢。\n");

	str = explode(read_file("/adm/etc/cg1"),"\n");
	me->set_temp("txtcg/step", 1);
	write(CLR+"\n");
	me->start_busy((: call_other, __FILE__, "exercising",me,str :),
		       (: call_other, __FILE__, "halt_exercise",me:));
	return 1;
}

int exercising(object me, string *str)
{
	int finish;
	int neili_temp,skill_temp_point;

      if (!interactive(me)) return 0;

	if (! me->query_temp("txtcg/step"))
		me->set_temp("txtcg/step", 1);

	if (! living(me))
	{
		me->set_temp("pending/exercise", 0);
		me->delete_temp("txtcg/step");
		return 0;
	}
	finish = 0;

	write(ZJSIZE(25)+str[me->query_temp("txtcg/step")-1]+NOR"\n");
	if(me->query_temp("txtcg/step")>=sizeof(str))
		finish = 1;
	if(!finish)
	{
		me->add_temp("txtcg/step", 1);
		return 1;
	}
	me->set_temp("pending/exercise", 0);
}
int halt_exercise(object me)
{
	me->delete_temp("dazuo/step");
	me->set_temp("pending/exercise", 0);
	tell_object(me,"你跳过了过场动画！\n", me);
	return 1;
}
int help(object me)
{
	write(@HELP
未知。
HELP	);
	return 1;
}
