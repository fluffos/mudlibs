#include <ansi.h>

int main(object me, string arg) {
  int i;
  string str, *files, name, cmds;

  if (!arg)
    write(ZJOBLONG "请选择你要将按钮11定义的功能：\n"
      ZJOBACTS2 + ZJMENUF(4, 4, 9, 30) + "打坐:zl 打坐,dazuo" ZJSEP "睡觉:zl 睡觉,sleep\n");
  else {
    if (sscanf(arg, "%s,%s", name, cmds) == 2)
      write(ZJBTSET "b11:" + name + ":" + cmds + "\n");
    else
      return notify_fail(HIR "参数错误！" NOR "\n");
  }
  return 1;
}
