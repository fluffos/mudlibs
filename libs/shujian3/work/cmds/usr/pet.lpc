// save.c

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object *pets, pet;
  int i;
  string str;

  if (!me->query("pets"))
    return notify_fail("你还没有宠物呢！\n");
  if (!arg) {
    return notify_fail(ZJOBLONG "你想对宠物进行什么操作：\n"
      ZJOBACTS2 + ZJMENUF(
        3,
        3,
        9,
        30
      ) + "召唤:pet call" ZJSEP "收回:pet gone" ZJSEP "改名:pet name" ZJSEP "查看:pet score\n");
  } else if (arg == "call") {
    pets = children("/clone/pet/pet");
    for (i = 0; i < sizeof(pets); i++) {
      if (pets[i]->query("owner") == me->query("id")) {
        pets[i]->move(environment(me));
        return 1;
      }
    }
    pet = new("/clone/pet/pet");
    pet->set("owner", me->query("id"));
    pet->set_name(pet->query("name"), ({ me->query("id") + "'s pet", "pet" }));
    pet->restore();
    pet->move(environment(me));
    pet->set_leader(me);
  } else if (arg == "gone") {
    pets = children("/clone/pet/pet");
    for (i = 0; i < sizeof(pets); i++) {
      if (pets[i]->query("owner") == me->query("id")) {
        pets[i]->save();
        destruct(pets[i]);
        write("你的宠物被收回到了宠物空间。\n");
        return 1;
      }
    }
    return notify_fail("你的宠物已经在宠物空间了！\n");
  } else if (arg == "score") {
    if (!(pet = present(me->query("id") + "'s pet", environment(me))))
      return notify_fail("你的宠物不在你跟前，无法查看！\n");
    str = ZJOBLONG;
    str += pet->short(1) + ZJBR;
    str += "一一一一一一一一一一一一一一一一" ZJBR;
    str += sprintf("　强壮：%d　身法：%d" ZJBR, pet->query_str(), pet->query_dex());
    str += sprintf("　根骨：%d　灵性：%d" ZJBR, pet->query_con(), pet->query_int());
    str += sprintf("　天赋：%d" ZJBR, pet->query("spi"));
    str += "一一一一一一一一一一一一一一一一" ZJBR;
    str += sprintf(
      "　伤害：%d　攻击：%d" ZJBR,
      pet->query_temp("apply/damage"),
      COMBAT_D->skill_power(pet, 1)
    );
    str += sprintf(
      "　盔甲：%d　防御：%d" ZJBR,
      pet->query_temp("apply/armor"),
      COMBAT_D->skill_power(pet, 2)
    );
    str += "一一一一一一一一一一一一一一一一" ZJBR;
    write(str + "\n");
  }
  return 1;
}

int help(object me) {
  write(@HELP
宠物操作。
HELP
  );
  return 1;
}
