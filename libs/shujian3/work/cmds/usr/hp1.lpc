#include <ansi.h>

inherit F_CLEAN_UP;

string status_color(int current, int max);

int main(object me, string arg) {
  object ob;
  mapping my;
  string sp;

  seteuid(getuid(me));
  ob = me;

  my = ob->query_entire_dbase();

  if (my["max_jing"] < 1 || my["max_qi"] < 1)
    return notify_fail("无法察看" + ob->name(1) + "的状态。\n");

  sp = ZJHPTXT + sprintf(
    "气血.%d:%d/%d/%d:%s:%s",
    my["qi"],
    my["qi"],
    my["eff_qi"],
    my["max_qi"],
    "#BBFF0000",
    "exert recover"
  );
  sp += "║" + sprintf(
    "内力.%d:%d/%d/%d:%s",
    my["neili"],
    my["neili"],
    my["max_neili"],
    (ob->query_skill("force") - ob->query_temp("apply/force")) * 8 + my["combat_exp"] / 1000 + ob->query_temp("apply/neili"),
    "#BB6495ED"
  );
  sp += "║" + sprintf(
    "精神.%d:%d/%d/%d:%s:%s",
    my["jing"],
    my["jing"],
    my["eff_jing"],
    my["max_jing"],
    "#BB6600CC",
    "exert regenerate"
  );
  sp += "║" + sprintf(
    "精力.%d:%d/%d/%d:%s:%s",
    my["jingli"],
    my["jingli"],
    my["eff_jingli"],
    my["eff_jingli"] - my["max_jingli"] + (ob->query_skill("force") - ob->query_temp("apply/force")) * 8 + ob->query_temp("apply/jingli"),
    "#BB006600",
    "exert refresh"
  );
  sp += "║" + sprintf("通宝.%d:%d/%d:%s", my["SJ_Credit"], my["SJ_Credit"], 2000, "#BB8B7500");
  sp += "║" + sprintf(
    "存款.%d:%d/%d:%s",
    my["balance"] / 10000,
    my["balance"] / 10000,
    F_BANKER->query_balance_limit(ob) / 10000,
    "#BBFF6600"
  );
  sp += "║" + sprintf("经验.%d:100/100:%s", my["combat_exp"], "#BB0000FF");
  sp += "║" + sprintf(
    "潜能.%d:%d/%d:%s",
    my["potential"],
    my["potential"],
    my["max_pot"],
    "#BBD2691E"
  );
  sp += "\n";
  tell_object(me, sp);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : hp
	  hp <对象名称>		  (巫师专用)
 
这个指令可以显示你(你)或指定对象(含怪物)的精, 气, 神数值。
 
see also : score
HELP);
  return 1;
}
