// time.c

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  int i, bt;
  string str, cmd;

  if (!arg)
    write(ZJBTSET "b12:" HIG "常用" ZJBR "指令" NOR ":mycmds ofen" ZJSEP "b13:" HIY "技能" ZJBR "相关" NOR ":mycmds skill" ZJSEP "b14:" HIR "战斗" ZJBR "相关" NOR ":mycmds fight" ZJSEP
      "b15:" HIM "任务" ZJBR "相关" NOR ":mycmds quest" ZJSEP "b16:" HIW "游戏" ZJBR "指南" NOR ":mycmds help" ZJSEP "b17:" HIC "频道" ZJBR "交流" NOR ":liaotian" + "\n");
  else if (arg == "ofen")
    write(ZJBTSET "b1:查看" ZJBR "背包:i" ZJSEP "b2:综合" ZJBR "属性:score" ZJSEP "b3:人物" ZJBR "状态:hp"
      ZJSEP "b4:查看" ZJBR "装备:arm" ZJSEP "b5:查看" ZJBR "排行:help top" ZJSEP "b8:更新" ZJBR "公告:help new" ZJSEP "b6:乘雕" ZJBR "飞行:help mapb"
      ZJSEP "b7:本地" ZJBR "地图:map" ZJSEP "b9:" YEL "随身" ZJBR "购买" NOR ":myshop" ZJSEP "b10:在线" ZJBR "玩家:who" + "\n");
  else if (arg == "skill")
    write(ZJBTSET "b1:查看" ZJBR "技能:skills" ZJSEP "b2:内力" ZJBR "打坐:dazuo" ZJSEP "b3:内力" ZJBR "吐纳:tuna"
      ZJSEP "b4:内力" ZJBR "疗伤:exert heal" ZJSEP "b5:内功" ZJBR "加力:enforce" ZJSEP "b6:特殊" ZJBR "状态:cond"
      ZJSEP "b7:暂未" ZJBR "设定:look" ZJSEP "b8:暂未" ZJBR "设定:look" ZJSEP "b9:暂未" ZJBR "设定:look" ZJSEP "b10:暂未" ZJBR "设定:look" + "\n");
  else if (arg == "fight") {
    str = ZJBTSET;
    for (i = 1; i < 11; i++) {
      if (cmd = me->query("mycmds/fight/b" + i))
        str += "b" + i + ":" + cmd;
      else
        str += "b" + i + ":点击" ZJBR "选择" + i + ":mycmds reset " + i;
      str += ZJSEP;
    }
    str += "b11:重新" ZJBR "定义:mycmds reset";
    write(str + "\n");
  } else if (arg == "quest")
    write(ZJBTSET "b1:查看" ZJBR "任务:help job" ZJSEP "b2:任务" ZJBR "传送:jobto" ZJSEP "b3:任务" ZJBR "NPC:help mapc"
      ZJSEP "b4:武当" ZJBR "锄奸:ask song yuanqiao about 任务" ZJSEP "b5:惩恶" ZJBR "扬善:ask yue buqun about 惩恶扬善" ZJSEP "b6:查看" ZJBR "副本:fuben" ZJSEP "b7:本地" ZJBR "地图:map"
      ZJSEP "b8:雪山" ZJBR "抢美:ask bao xiang about 任务" ZJSEP "b9:送信" ZJBR "任务:ask zhu wanli about 送信" ZJSEP "b10:查看" ZJBR "信件:l letter" + "\n");
  else if (arg == "help")
    write(ZJBTSET "b2:基本" ZJBR "系统:help rule" ZJSEP "b1:" HIG "新手" ZJBR "指南" NOR ":help newbie" ZJSEP "b3:门派" ZJBR "介绍:help party"
      ZJSEP "b4:自制" ZJBR "装备:help worker" ZJSEP "b5:特殊" ZJBR "武功:help quest" ZJSEP "b6:充值" ZJBR "说明:help credit" ZJSEP "b7:会员" ZJBR "福利:help vip"
      ZJSEP "b8:神兵" ZJBR "宝甲:help baowu" ZJSEP "b9:帮派" ZJBR "系统:help group" ZJSEP "b10:任务" ZJBR "系统:help job" + "\n");

  else if (strsrch(arg, "clickLong") != -1) {
    //字符替换
    arg = replace_string(arg, "：", ":");
    arg = replace_string(arg, "；", ";");
    arg = replace_string(arg, "\n", ";");

    if (sscanf(arg, "fight clickLong:%d:%s", bt, cmd) == 2) {

      me->set("mycmds/fight/b" + bt, cmd);
      tell_object(me, ZJFORCECMD("mycmds fight"));
    }

  }


  else if (arg == "reset") {
    str = ZJBTSET;
    for (i = 1; i < 11; i++) {
      str += "b" + i + ":点击" ZJBR "选择" + i + ":mycmds reset " + i;
      str += ZJSEP;
    }
    str += "b11:返回:mycmds fight";
    write(str + "\n");
    write(ZJTMPSAY "请点击你想要定义的按钮选择新功能。\n");
  } else if (sscanf(arg, "reset %d %s", bt, cmd) == 2) {
    string a, b;

    if (bt < 1 || bt > 10)
      return notify_fail(ZJOBLONG "没有这个按钮。。。\n");
    if (cmd == "自定义") {
      write(INPUTTXT("请输入自定义字串：标题:命令(查看:look)", "mycmds reset " + bt + " $txt#") + "\n");
      return 1;
    }
    cmd = replace_string(cmd, "：", ":");
    cmd = replace_string(cmd, "#E", ESA);
    cmd = replace_string(cmd, "/", ZJBR);
    cmd = replace_string(cmd, "\n", ZJBR);
    if (sscanf(cmd, "%s:%s", a, b) != 2)
      return notify_fail(HIR "格式错误，请重新定义！" NOR "\n");
    me->set("mycmds/fight/b" + bt, cmd);
    if (me->query("new_bie") == 10) {
      me->set("new_bie", 11);
      me->add("combat_exp", 1100);
      tell_object(me, HIG "恭喜你完成了新手第十一步，获得1100经验奖励，恭喜你完成了全部新手训练。" NOR "\n");
      tell_object(me, HIY "此处定义的快捷按钮在以后的战斗或练功中，可直接点击使用(包括技能绝招，内功特殊运用等)。" NOR "\n");
    }
    write(ZJBTSET "b" + bt + ":" + cmd + "\n");
  } else if (sscanf(arg, "reset %d", bt) == 1) {
    mapping smap, pmap, pfms, skips;
    string dodge_ski, force_ski, weapon_ski, *pfm, ski_type, uski_type;
    int k, flag;
    string msg, *valid_types, *skis, *cmdd;
    object weapon;

    if (bt < 1 || bt > 10)
      return notify_fail(ZJOBLONG "没有这个按钮。。。\n");

    valid_types = ({ "finger", "hand", "cuff", "claw", "strike", "unarmed" });
    skips = ([]);
    if (!smap = me->query_skill_map()) smap = ([]);
    if (!pmap = me->query_skill_prepare()) pmap = ([]);
    msg = "";

    if (objectp(weapon = me->query_temp("weapon")))
      ski_type = weapon->query("skill_type");

    if (force_ski = smap["force"]) {
      pfms = SKILL_D(force_ski)->query_pfms();
      if (mapp(pfms) && pfms != ([])) {
        pfm = sort_array(keys(pfms), (: strcmp :));
        for (i = 0; i < sizeof(pfm); i++) {
          cmdd = explode(pfms[pfm[i]], ":");
          msg += cmdd[0] + ":mycmds reset " + bt + " " + replace_string(
            cmdd[0],
            ESA,
            "#E"
          ) + "：" + cmdd[1] + " " + pfm[i] + ZJSEP;
        }
      }
      skips[force_ski] = 1;
    }

    if (stringp(dodge_ski = smap["dodge"]) && !skips[dodge_ski]) {
      pfms = SKILL_D(dodge_ski)->query_pfms();
      if (mapp(pfms) && pfms != ([])) {
        pfm = sort_array(keys(pfms), (: strcmp :));
        for (i = 0; i < sizeof(pfm); i++) {
          cmdd = explode(pfms[pfm[i]], ":");
          msg += cmdd[0] + ":mycmds reset " + bt + " " + replace_string(
            cmdd[0],
            ESA,
            "#E"
          ) + "：" + cmdd[1] + " dodge." + pfm[i] + ZJSEP;
        }
      }
      skips[dodge_ski] = 1;
    }

    if (objectp(weapon)) {
      if (stringp(weapon_ski = smap[ski_type]) && !skips[weapon_ski]) {
        pfms = SKILL_D(weapon_ski)->query_pfms();
        if (mapp(pfms) && pfms != ([])) {
          pfm = sort_array(keys(pfms), (: strcmp :));
          for (i = 0; i < sizeof(pfm); i++) {
            cmdd = explode(pfms[pfm[i]], ":");
            msg += cmdd[0] + ":mycmds reset " + bt + " " + replace_string(
              cmdd[0],
              ESA,
              "#E"
            ) + "：" + cmdd[1] + " " + ski_type + "." + pfm[i] + ZJSEP;
          }
        }
        skips[weapon_ski] = 1;
      }
    } else if (!objectp(weapon)) {
      if (mapp(pmap) && pmap != ([])) {  //首先推送准备技能
        skis = sort_array(keys(pmap), (: strcmp :));
        for (k = 0; k < sizeof(skis); k++) {
          if (skips[pmap[skis[k]]]) continue;
          pfms = SKILL_D(pmap[skis[k]])->query_pfms();
          if (mapp(pfms) && pfms != ([])) {
            pfm = sort_array(keys(pfms), (: strcmp :));
            for (i = 0; i < sizeof(pfm); i++) {
              cmdd = explode(pfms[pfm[i]], ":");
              msg += cmdd[0] + ":mycmds reset " + bt + " " + replace_string(
                cmdd[0],
                ESA,
                "#E"
              ) + "：" + cmdd[1] + " " + skis[k] + "." + pfm[i] + ZJSEP;
            }
          }
          skips[pmap[skis[k]]] = 1;
        }
      }

      skis = sort_array(keys(smap), (: strcmp :));
      for (k = 0; k < sizeof(skis); k++) {
        flag = 1;
        for (i = 0; i < sizeof(valid_types); i++) {
          if (SKILL_D(smap[skis[k]])->valid_enable(valid_types[i])) {
            uski_type = valid_types[i];
            flag = 2;
          }
        }
        if (!skips[smap[skis[k]]] && flag == 2) {
          pfms = SKILL_D(smap[skis[k]])->query_pfms();
          if (mapp(pfms) && pfms != ([])) {
            pfm = sort_array(keys(pfms), (: strcmp :));
            for (i = 0; i < sizeof(pfm); i++) {
              cmdd = explode(pfms[pfm[i]], ":");
              msg += cmdd[0] + ":mycmds reset " + bt + " " + replace_string(
                cmdd[0],
                ESA,
                "#E"
              ) + "：" + cmdd[1] + " " + skis[k] + "." + pfm[i] + ZJSEP;
            }
          }
        }
        skips[smap[skis[k]]] = 1;
      }
    }
    write(ZJOBLONG "你想设定按钮" HIG + chinese_number(bt) + NOR "为什么功能？\n" ZJOBACTS2 + ZJMENUF(
      5,
      5,
      8,
      30
    )
      + "自定" ZJBR "按键:mycmds reset " + bt + " 自定义" + ZJSEP
      +msg
      + "内力" ZJBR "回气:mycmds reset " + bt + " 内力" ZJBR "回气：exert recover" ZJSEP
      + "内力" ZJBR "回精:mycmds reset " + bt + " 内力" ZJBR "回精：exert regenerate" ZJSEP
      + "内力" ZJBR "回体:mycmds reset " + bt + " 内力" ZJBR "回体：exert refresh" ZJSEP
      + "服护" ZJBR "心丹:mycmds reset " + bt + " 服护" ZJBR "心丹：fuyong huxin dan"
      + "\n");
  }
  return 1;
}

int help(object me) {
  write(@HELP

这个指令让设定游戏默认的自定义按钮。

HELP
  );
  return 1;
}
