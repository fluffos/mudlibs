// appiinput.c
//app打头的都为客户端专用

#include <ansi.h>
 
inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
	
	mapping q;

	write(INPUTTXT("输入指令指令","$txt#\n"));

	return 1;
}



int help(object me)
{
	write(@HELP
指令格式 : assist <玩家ID>

这个指令表示你想帮助另一个人一同完成掌门或是世家长老分配给他
的杀人任务。当然你必须和他是同门，而且你当时没有任务。如果对
方同意接受你的帮助，那么你会自动加入到对方的队伍中（除非对方
在另外一个队伍中并且不是队长）。
HELP );
	return 1;
}
