// jobto.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object obj,feixue;
	int i;
	string *job,str,msg,*files;
	mapping jobtos1,jobtos2;

	if(!mapp(jobtos1 = me->query_temp("jobto"))&&!mapp(jobtos2 = me->query("jobto")))
	{
		return notify_fail(HIR"你没有需要传送的任务地点！"NOR"\n");
	}
//		return notify_fail(HIR"更新中。暂停使用。请稍后。。！"NOR"\n");

	if(mapp(jobtos1)&&sizeof(job=keys(jobtos1))>0)
	{
		files = values(jobtos1);
		str = ZJOBLONG"任务快速传送每次需要消耗通宝道具"HIY"小飞靴"NOR"的使"ZJBR"用次数，请在寻找任务目标困难时合理使用传送。"ZJBR+ZJBR"请选择任务传送：\n"+ZJOBACTS2+ZJMENUF(3,3,9,30);
		for(i=0;i<sizeof(job);i++)
		{
			str += job[i]+":jobto "+jobtos1[job[i]];
			if(i<(sizeof(job)-1)) str += ZJSEP;
		}
	}
	if(mapp(jobtos2)&&sizeof(job=keys(jobtos2))>0)
	{
		if(str)
			files += values(jobtos2);
		else
			files = values(jobtos2);
		if(!str)
			str = ZJOBLONG"请选择任务传送：\n"+ZJOBACTS2+ZJMENUF(3,3,9,30);
		else
			str += ZJSEP;

		for(i=0;i<sizeof(job);i++)
		{
			str += job[i]+":jobto "+jobtos2[job[i]];
			if(i<(sizeof(job)-1)) str += ZJSEP;
		}
	}

	if(!str)
	{
		return notify_fail(HIR"你没有需要传送的任务地点！"NOR"\n");
	}
	if( !arg )
	{
		write(str+"\n");
		return 1;
	}

	if(member_array(arg, files) == -1)
		return notify_fail("你只能飞往你当前任务的标记地点或目标人物身边！\n");

	if(me->is_busy())
		return notify_fail("你正忙着呢！\n");
	if(me->is_ghost())
		return notify_fail("等你还阳了再说吧！\n");

	if( obj = find_living(arg))
		obj = environment(obj);
	else if( obj = find_object(arg) )
	{
		if(environment(obj))
			obj = environment(obj);
	}
	else
		obj = load_object(arg);

	if(!obj)
		return notify_fail("目标人物无法追踪或目标地点无法到达，\n或许是你所追踪的人物已被杀死或更新，\n你可以尝试手动完成或放弃任务。\n");

	if(!objectp(feixue=present("fei xue",me)))
		return notify_fail("你身上已经没有"HIM"小飞靴"NOR"了，不能传送！\n");

	if(!feixue->do_eat())
		return 0;

	if( stringp(msg = me->query("env/msg_mout")) )
		message_vision(CYN +msg+NOR"\n", me);
	else
		message_vision(CYN "只见一阵烟雾过后，$N的身影已经不见了。"NOR"\n", me);

	me->move(obj);

	if( stringp(msg = me->query("env/msg_min")) )
	message_vision(CYN +msg+NOR"\n", me);
	else
		message_vision(CYN "$N的身影突然出现在一阵烟雾之中。"NOR"\n", me);

	return 1;
}

int help(object me)
{
write(@HELP
指令格式 : jobto <任务地点>
 
这个指令会将你传送到指定的环境.
 
HELP
    );
    return 1;
}
