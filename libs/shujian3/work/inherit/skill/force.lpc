// force.c
// force skill can have: mixed hit_ob(object me, object victim, int damage_bonus)
// force type are from 至阴(-4) to 至阳(4), 
#include <ansi.h>
inherit SKILL;

int force_type() { return 0; }

mapping query_pfms() {
  // 查询技能的 pfm 情况
  string dir, filename;
  string *all_file;
  int i, l;
  mapping pfms;

  dir = file_name(this_object()) + "/";
  pfms = ([]);

  if (file_size(dir + "exert/") == -2) {
    all_file = get_dir(dir + "exert/");
    if (sizeof(all_file)) {
      for (i = 0; i < sizeof(all_file); i++) {
        filename = all_file[i];
        l = strlen(filename);
        if (filename[l - 1] == 'c' && filename[l - 2] == '.')
          filename = filename[0..l - 3];
        else
          break;
        if ((dir + filename)->exert_name())
          pfms[filename] = (dir + filename)->exert_name() + ":exert";
        else
          pfms[filename] = filename + ":exert";
      }

    }
    all_file = get_dir(dir + "perform/");
    if (sizeof(all_file)) {
      for (i = 0; i < sizeof(all_file); i++) {
        filename = all_file[i];
        l = strlen(filename);
        if (filename[l - 1] == 'c' && filename[l - 2] == '.')
          filename = filename[0..l - 3];
        if ((dir + filename)->perform_name())
          pfms[filename] = (dir + filename)->perform_name() + ":perform";
        else
          pfms[filename] = filename + ":perform";
      }
    }
  } else if (file_size(dir) == -2) {
    all_file = list_dirs(dir);
    if (sizeof(all_file)) {
      for (i = 0; i < sizeof(all_file); i++) {
        filename = all_file[i];
        l = strlen(filename);
        if (filename[l - 1] == 'c' && filename[l - 2] == '.')
          filename = filename[0..l - 3];
        if ((dir + filename)->query_name())
          pfms[filename] = (dir + filename)->query_name() + ":exert";
        else if ((dir + filename)->exert_name())
          pfms[filename] = (dir + filename)->exert_name() + ":exert";
        else
          pfms[filename] = filename + ":exert";
      }
    }
  }
  return pfms;
}
