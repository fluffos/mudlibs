// Room: /d/xiaoyao/shulin3.c

#include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "树林");
	set("long", @LONG
这是一片茂密的树林。很多棵几十丈高的大树聚在一块，像一把把琼天大
伞，把整个树林遮蔽得暗然无光，偶尔能听见头顶上传来一些鸟儿的啼鸣。这
正是个打鸟（da niao）的好地方。
LONG );
	set("no_fight", 1);
	set("objects", ([ ]));
	set("outdoors", "huanghe");
	set("exits", ([ /* sizeof() == 4 */
		"west" : __DIR__"shulin3",
		"southeast" : __DIR__"caodi1",
	]));
	set("item_desc", ([
		"【大树】": "树枝上不时停下几只鸟儿叽叽喳喳交个不停。\n"
		ZJOBACTS2"打鸟:da auto\n",
	]) );
	set("no_clean_up", 0);
	setup();
}
void init()
{
	add_action("do_da", "da");
}

int do_da(string arg)
{
	object me;
	int i;
	me = this_player();

	if (arg!="niao" && arg!="鸟" && arg!="auto")
		return notify_fail("你要打什么？\n");

	if (me->query("combat_exp") > 2000000)
		return notify_fail("你已经无法通过打鸟来增加实战经验了。\n");

	if(me->is_busy())
	     return notify_fail("你的上一个行动还没有完成！\n");

	if(me->query_temp("job/step")) 
	     return notify_fail("你上一次搜索还没有结束！\n");

	if(me->query("qi")<10)
	     return notify_fail(HIR"你还是先休息一下吧，打猎也要用力气哟。。。"NOR"\n");

	if(arg=="auto")
	{
		tell_object(me,ZJEXIT"northwest:"RED"站起来"NOR":halt\n");
		me->set_temp("pending/auto_work",1);
	}

	me->set_temp("job/step", 1);
	me->start_busy((: call_other, __FILE__, "working" :),
			(: call_other, __FILE__, "halt_working" :));
        message_vision("$N准备开始打鸟。\n", me);
	return 1;
}

void auto_work(object me)
{
	if(!me||!me->query_temp("pending/auto_work"))
		return;
	if(me->is_busy())
		call_out("auto_work",1,me);
	else if( (int)me->query("qi") < 50)
	{
		if (SKILL_D("force/recover")->exert(me, me))
		{
			if( (int)me->query("qi") < 50)
			{
				tell_object(me,"气力不足，等待恢复中。。。\n");
				call_out("auto_work",10,me);
			}
			else
			{
				call_out("auto_work",1,me);
			}
		}
		else
		{
			tell_object(me,"气力不足，等待恢复中。。。\n");
			call_out("auto_work",10,me);
		}
	}
	else
	{
		tell_object(me,CYN"托管中，继续打鸟。。。。。。"NOR"\n");
		tell_object(me,ZJFORCECMD("da auto"));
	}
}

int working(object me)
{
	int kar,exp,pot;
	string msg;
	int finish;

	if(!me->query_temp("job/step"))
		me->set_temp("job/step", 1);

	if(!living(me))
	{
		me->delete_temp("job/copy");
		me->delete_temp("job/step");
		return 0;
	}

	finish = 0;
	me->receive_damage("qi", 3);
	switch (me->query_temp("job/step"))
	{
	case 1:
		msg = "你拿起儿时玩耍用的弹弓，开始搜索树林里的鸟儿。";
		break;
	case 2:
		msg = "你东看看西瞧瞧。";
		break;
	case 3:
		msg = "找了半天，结果连了鸟影子都没见到。";
		break;
	case 4:
		msg = "你有些垂头丧气......";
		break;
	case 5:
		msg = "正在这时，从远方隐约传来几声鸟鸣。";
		break;
	case 6:
		msg = "你不由振奋起精神。";
		break;
	case 7:
		msg = "鸟叫声逐渐临近，眼前飞来几只小鸟。";
		break;
	default:
		msg = "你连忙拉开弹弓向小鸟射去。";
		finish = 1;
		break;
	}
	msg += "\n";

	if (finish)
	{
		kar = random(me->query("kar"));	
		if (kar>15)
		{
			msg += "结果你打到一只"HIW+ZJSIZE(20)"百灵鸟"NOR"。\n";
			exp=90;
			pot=15;
		}
		else if (kar>10)
		{
			msg += "结果你打到一只"HIY+ZJSIZE(20)"金丝雀"NOR"。\n";
			exp=80;
			pot=12;
		}	
		else if (kar>7)
		{	   
			msg += "结果你打到一只"HIG+ZJSIZE(20)"鹦鹉"NOR"。\n";
			exp=60;
			pot=10;
		}
		else if (kar>5)
		{	   
			msg += "结果你打到一只"YEL+ZJSIZE(20)"麻雀"NOR"。\n";
			exp=50;
			pot=8;
		}
		else
		{
			msg += "结果你什么都没打到。\n";
			msg += "真衰！！！\n";
			exp=0;
			pot=0;
		}

	if (me->query("combat_exp") < 200000) {
			me->add("combat_exp",exp);
			msg += "你得到了"HIW+exp+NOR"点经验。\n";
			me->add("potential",pot);
			msg += "你得到了"HIW+pot+NOR"点潜能。\n";
                          }
                  else {
                        msg+="由于你经验过高，打鸟练功的经验减少了!\n";
			me->add("combat_exp",exp/10);
			msg += "你得到了"HIW+exp/10+NOR"点经验。\n";
			me->add("potential",pot/5);
			msg += "你得到了"HIW+pot/5+NOR"点潜能。\n";
                       }
	}

	msg = replace_string(msg, "$N", "你");
	tell_object(me, msg);

	if(finish)
	{
		me->delete_temp("job/step");
		if(me->query_temp("pending/auto_work"))
		{
			call_out("auto_work",8,me);
		}
		return 0;
	}

	me->add_temp("job/step", 1);
	return 1;
}

int halt_working(object me)
{
	message_vision("$N放下手中的弹弓，看起来是不想再打鸟了！\n", me);
	tell_object(me,ZJEXITRM"northwest\n");
	me->delete_temp("pending/auto_work");
	me->delete_temp("job/step");
	return 1;
}
