// by lsxk@hsbbs  增加兑换试剑山庄物品  2008/06/27

inherit NPC;
#include <ansi.h>

int ask_buchang();
int ask_buchang2();
int ask_sjling();
int ask_sjsz();
string ask_baibao();
int ask_fanli();


void create() {
  set_name("巫师", ({ "wizard", "wushi" }));
  set("gender", "男性");
  set("age", 30);
  set("long", "这是一个成天无所事事的巫师。\n");
  set("str", 17);
  set("dex", 16);
  set("con", 15);
  set("int", 17);
  set("shen_type", 1);
  set_temp("apply/defense", 10);
  set("combat_exp", 100);
  set("attitude", "peaceful");

  setup();

  set("inquiry", ([
    //              "试剑令": (: ask_sjling :),
    //              "试剑山庄": (: ask_sjsz :),
    //              "年龄补偿": (: ask_buchang :),
    //              "补偿九阳": (: ask_buchang2 :),
    "百宝囊": (: ask_baibao :),
    "弟子贡献": (: ask_fanli :),
  ]));

  carry_object("/clone/misc/cloth")->wear();
}


int ask_fanli() {
  int i;
  object ob = this_player();
  i = ob->query("vip/dizi_pay");

  if (ob->query("vip/dizi_pay") < 1) {
    command("say 你的弟子贡献太低，无法领取奖励。");
    return 1;
  } else {
    command("nod " + ob->query("id"));
    command("say 你已符合领取弟子贡献奖励条件。");
    ob->add("SJ_Credit", i);
    ob->add("vip/dizi_pay", -i);
    ob->add("vip/dizi_fanli", i);
    message_vision("$N获得了" + i + "个通宝的奖励。\n", ob, this_object());
    return 1;
  }
}

int ask_sjsz() {
  object me = this_player();

  int i = me->query("SJ_YuanBao");

  if (i < 3) {
    command("say 你的试剑元宝数量不够！");
    return 1;
  }

  me->add("SJ_YuanBao", -3);
  command("haha");
  command("say 既然你在试剑山庄略有作为，那我就通融下，你再去闯一次山庄吧！");
  me->add_temp("get_in_sjsz", 1);
  CHANNEL_D->do_channel(
    this_object(),
    "rumor",
    sprintf("%s从巫师这里获得了一次进入" + HIW + "试剑山庄" + HIM + "的机会！", me->name(1))
  );
  return 1;
}

int ask_sjling() {
  object me = this_player();
  object ob;

  int i = me->query("SJ_YuanBao");

  if (i < 5) {
    command("say 你的试剑元宝数量不够！");
    return 1;
  }

  me->add("SJ_YuanBao", -5);
  ob = new("/cmds/leitai/bwdh/obj/sjsz_ling");
  ob->move(me);
  command("say 兑换完毕！");
  return 1;
}

int ask_buchang() {
  object ob;
  object gold1;
  ob = this_player();


  if (ob->query("age_buchang")) {
    command("say 你不是已经补偿过了么？");
    return 1;
  }
  if (ob->query("combat_exp") < 500000) {
    command("say 你的经验没有达到补偿的要求。");
    return 1;
  }
  if (ob->query("registered") < 3) {
    command("say 对不起，只有成为会员才能领取补偿。");
    return 1;
  }
  if (ob->query("mud_age") < 2073600) {
    command("pat " + ob->query("id"));
    command("say 你符合天神dongfangming补偿玩家的条件，可以获得金币补偿。");
    command("say 如果你有更多疑问，请及时和天神dongfangming联系。");
    gold1 = new("/clone/money/gold");
    gold1->set_amount(800);
    gold1->move(ob);
    message_vision("$n给了$N八百两黄金。\n", ob, this_object());
    ob->set("age_buchang", 1);
    return 1;
  } else {
    command("nod " + ob->query("id"));
    command("say 你符合天神dongfangming补偿玩家的条件，可以获得金币补偿。");
    command("say 如果你有更多疑问，请及时和天神dongfangming联系。");
    gold1 = new("/clone/money/gold");
    gold1->set_amount(1000);
    gold1->move(ob);
    message_vision("$n给了$N一千两黄金。\n", ob, this_object());
    ob->set("age_buchang", 1);
    return 1;
  }
}


int ask_buchang2() {
  object ob;
  mapping myfam;
  ob = this_player();

  myfam = (mapping)ob->query("family");

  if (!myfam || myfam["family_name"] != "明教")
    return 0;
  if (ob->query("mjxl_buchang")) {
    command("say 你不是已经补偿过了么？");
    return 1;
  }
  ob->add("job_time/明教巡逻", 250);
  ob->set("mjxl_buchang", 1);
  write("补偿完毕，添加250次明教巡逻任务!\n");
  return 1;
}

string ask_baibao() {
  object ob;
  mapping myfam;
  object nang;

  ob = this_player();
  myfam = (mapping)ob->query("family");

  if (!myfam && !wizardp(ob)) return "你还是先加入门派吧？";

  if (present("baibao nang", ob))
    return "你身上不是已经有一个了吗？别贪得无厌！\n";

  if (ob->query("combat_exp") < 10000)
    return "百宝囊可是个宝贝，你战斗经验这么差，被人抢走了怎么办？\n";

  if (ob->query("vip/all_pay") < 99 && ob->query("combat_exp") < 1000000)
    return "你没有达到领取百宝囊的要求，你可以通过努力练功或者提升你的贡献度来获得这件宝贝。\n";

  nang = new("/quest/obj/baibao");
  nang->set("owner_id", ob->query("id"));
  nang->move(ob);
  write("你得到一个百宝囊!\n");
  return "这可是个宝贝，好好利用它。";
}
