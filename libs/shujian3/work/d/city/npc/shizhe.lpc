#include <ansi.h>

inherit NPC;

string ask_lilian();
string ask_jieshu();
string ask_apprentice();
string ask_pay();
string ask_yao();
int ask_qudu();
int ask_baotu();

void create() {
  set_name(HIW "书剑使者" NOR, ({ "shizhe" }));
  set("nickname", HBCYN "书剑江湖使者" NOR);
  set("long", "这是一位书剑使者。\n");
  set("gender", "男性");
  set("age", 30);
  set("per", 24);
  set("str", 60);
  set("int", 60);
  set("con", 60);
  set("dex", 60);
  set("qi", 100000);
  set("jingli", 6000);
  set("max_qi", 100000);
  set("max_jing", 6000);
  set("eff_jingli", 6000);
  set("jiali", 200);
  set("combat_exp", 9000000);
  set("shen", 250000);

  set_skill("force", 500);
  set_skill("yinyun-ziqi", 500);
  set_skill("dodge", 500);
  set_skill("tiyunzong", 500);
  set_skill("cuff", 500);
  set_skill("taiji-quan", 500);
  set_skill("parry", 500);
  set_skill("sword", 500);
  set_skill("taiji-jian", 500);
  set_skill("taoism", 200);
  set_skill("literate", 300);
  map_skill("force", "yinyun-ziqi");
  map_skill("dodge", "tiyunzong");
  map_skill("cuff", "taiji-quan");
  map_skill("parry", "taiji-jian");
  map_skill("sword", "taiji-jian");
  prepare_skill("cuff", "taiji-quan");

  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: exert_function, "taiji" :),
    (: perform_action, "sword.sanhuan" :),
    (: perform_action, "cuff.zhen" :),
    (: perform_action, "cuff.zhan" :),
    (: perform_action, "cuff.ji" :)
  }));

  set("inquiry", ([
    "宝图": (: ask_baotu :),
    "历练": (: ask_lilian :),
    "结束": (: ask_jieshu :),
    "重择门派": (: ask_apprentice :),
    "贡献": (: ask_pay :),
    "护心丹": (: ask_yao :),
    "驱毒": (: ask_qudu :),
  ]));
  setup();
  carry_object("/clone/weapon/gangjian")->wield();
  carry_object("/d/wudang/obj/whiterobe")->wear();
  carry_object("/d/wudang/obj/daolv")->wear();
}

int ask_baotu() {
  object me = this_player();
  int time;
  object item;

  if (!me) return 0;
  time = me->query("baotu/time");

  if (time() - time >= (7 * 24 * 60 * 60)) {
    item = new("/d/fuben/obj/heifeng1.lpc");
    if (item->move(me)) {
      me->set("baotu/time", time());
      tell_object(me, "你领取了一张藏宝图。\n");
    } else
      tell_object(me, "你领取藏宝图失败，请检查身上物品上限。\n");
  } else
    tell_object(me, "你七天之内已经领取过一次藏宝图了，下次还需要" +
      ((7 * 24 * 60) - (time() - time) / 60) + "分钟才能领取。\n");

  return 1;
}

void init() {
  object ob;
  ::init();  //继承上一级
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 0, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  if (ob->query("registered") > 1 && !ob->query("lilian/start")) {
    command("hi " + ob->query("id"));
    command("whisper " + ob->query("id") + " " HIC "\n这位" + RANK_D->query_respect(ob) + "你是书剑江湖的赞助者，\n" +
      "你还没有在我这里" ZJURL("cmds:ask shizhe about 历练") + ZJSIZE(20) "登记" NOR "" HIC "历练，\n" +
      "赶紧开始你的历练，领取丰厚的奖励吧！" NOR "");
  }

}


string ask_lilian() {
  object me = this_object();
  object ob = this_player();

  if (ob->query("registered") < 3) return "对不起，我只处理赞助会员的事情！\n";

  if (ob->query("lilian/start")) return "我已经记录了你的历练信息，放心去吧。\n";

  message_vision(HIG "$N翻开记事簿，对$n点了点头，说道：好吧，我这就为你记上。" NOR "\n", me, ob);

  ob->set("lilian/start", time());
  return "记得在24小时之内来找我结束历练。\n";
}

string ask_jieshu() {
  object me = this_object();
  object ob = this_player();
  int exp1;

  if (ob->query("registered") < 3) return "对不起，我只处理赞助者的事情！\n";

  if (!ob->query("lilian/start")) return "我这里没有你的历练记录。\n";

  exp1 = time() - (int)ob->query("lilian/start");

  tell_object(ob, HIC "你的累计历练时间是" + CHINESE_D->chinese_time(exp1) + "。" NOR "\n");

  if (exp1 > 86400) exp1 = 86400;

  tell_object(ob, HIC "你的有效历练时间是" + CHINESE_D->chinese_time(exp1) + "。" NOR "\n");

  message_vision(HIY "$N结束了$n的本次历练！" NOR "\n", me, ob);

  ob->add("balance", exp1 * 2);
  ob->add("combat_exp", exp1 / 3);
  ob->add("potential", exp1 / 28);
  ob->delete("lilian/start");

  return "你的存款增加了" + chinese_number(exp1 * 2 / 100) + "两白银，
你的经验增加了" + chinese_number(exp1 / 3) + "点，
你的潜能增加了" + chinese_number(exp1 / 28) + "点。\n";
}


string ask_apprentice() {
  object me = this_object();
  object ob = this_player();
  object ob1;

  if (ob->query("registered") < 3) return "你不是我们赞助成员，来问我重择门派的事情干什么？！\n";

  if (ob->query("combat_exp", 1) < 100000) return "你目前的实战经验太低了，等以后再重择门派吧！\n";


  if (!ob->query_temp("rebai")) return "我没有收到你给我的" HIW "推荐信" NOR "，我不能帮你改投门派！\n";

  if (ob->query_temp("rebai") > 0) {

    ob->delete_temp("rebai");

    message_vision(RED "$N废去了$n所有的门派特殊武功！" NOR "\n", me, ob);
    tell_object(ob, HIC "特别提示：请留意你的内力上限，这和你的内功等级息息相关。" NOR "\n");

    ob->set("family", 0);
    ob->delete("title");
    ob->delete("class");
    //ob->add("combat_exp", -ob->query("combat_exp", 1)/20);


    //桃花岛
    ob->delete_skill("qimen-bagua");
