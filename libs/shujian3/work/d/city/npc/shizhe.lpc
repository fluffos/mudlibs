    ob->delete_skill("buddhism");

    //慕容
    ob->delete_skill("shenyuan-gong");
    ob->delete_skill("murong-daofa");
    ob->delete_skill("murong-jianfa");
    ob->delete_skill("canhe-zhi");
    ob->delete_skill("douzhuan-xingyi");
    //昆仑
    ob->delete_skill("art");
    ob->delete_skill("xuantian-wuji");
    ob->delete_skill("xunlei-jian");
    ob->delete_skill("liangyi-jian");
    ob->delete_skill("taxue-wuhen");
    ob->delete_skill("kunlun-zhang");
    ob->delete_skill("mantian-huayu");
    //少林
    ob->delete_skill("buddhism");
    ob->delete_skill("yijin-jing");
