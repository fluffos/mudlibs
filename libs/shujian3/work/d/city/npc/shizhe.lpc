    ob->delete_skill("taiji-quan");
    ob->delete_skill("tiyunzong");
    //古墓
    ob->delete_skill("yunu-xinjing");
    ob->delete_skill("meinu-quanfa");
    ob->delete_skill("anran-zhang");
    ob->delete_skill("xuantie-jianfa");
    ob->delete_skill("yinsuo-jinling");
    ob->delete_skill("yunu-shenfa");
    ob->delete_skill("tianluo-diwang");
    //华山
    ob->delete_skill("zhengqi-jue");
    ob->delete_skill("dugu-jiujian");
    ob->delete_skill("huashan-jianfa");
    ob->delete_skill("huashan-qigong");
