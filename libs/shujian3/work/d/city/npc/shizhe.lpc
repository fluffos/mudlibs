string ask_pay() {
  object me = this_object();
  object ob = this_player();

  if (ob->query("registered") < 3) return "对不起，我只处理赞助者的事情！\n";

  return "你当前贡献是" + chinese_number(ob->query("vip/all_pay")) + "点。\n";
}


string ask_yao() {
  object me = this_object();
  object ob = this_player();
  object yao;

  //	if (ob->query("registered") < 3) return "对不起，我只处理东方族人的事情！\n";

  if (ob->query(
    "combat_exp",
    1
  ) > 3000000) return "这位" + RANK_D->query_respect(ob) + "，你已经是武林高手了，可不能再靠天王护心丹练功了！\n";

  if (present("huxin dan", ob))
    return RANK_D->query_respect(ob) + "你身上不是已经有天王护心丹了吗，怎么又来要了？ 真是贪得无厌！";

  yao = new("/clone/shizhe/huxindan");
  yao->move(ob);
  message_vision("$N给了$n一颗" + yao->query("name") + "。\n", me, ob);
  return "这可是好东西，希望对你行走江湖有所帮助。\n";
}

int ask_qudu() {
  object me = this_object();
  object ob = this_player();

  if (ob->query("registered") < 3) return notify_fail("对不起，我只处理赞助者的事情！\n");

  //	if (ob->query("combat_exp", 1) > 3000000) return "这位"+RANK_D->query_respect(ob)+"，你已经是武林高手了，可不能再靠天王护心丹练功了！\n";

  command("nod " + ob->query("id"));
  message_vision(
    "$N运起氤氲紫气，伸出手掌在$n的背心轻轻一拍，顿时一股温和的真气进入$n体内。$n大喜过望，不由盘膝坐下运行真气，配合氤氲紫气在经脉流动，慢慢祛除体内毒素。\n",
    me,
    ob
  );
  ob->clear_conditions_by_type("poison");
  ob->start_busy(20);
  call_out("do_qudu", 40, ob);
  return 1;
}

void do_qudu(object ob) {
  if (!objectp(ob))
    return;


  message_vision(HIW "\n过了半响，$N终于站起身来，但见$P脸色红润，体内的毒素似乎得到了清除。" NOR "\n", ob);
  remove_call_out("do_qudu");
}
