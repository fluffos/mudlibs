// Room: /city/shuyuan.c

inherit ROOM;

void create()
{
	set("short", "书院");
	set("long", @LONG
这里就是顾炎武晚年隐居, 教书谈文的扬州书院。顾先生的身后还有一
幅字贴(zitie)。
LONG
	);

	set("exits", ([
        "up" : __DIR__"wizroom",
		"south" : __DIR__"dongdajie2",
	]));

	set("item_desc", ([
		"zitie" : "清风虽细难吹我，明月何尝不照人。\n山川开霁故壁完，何处登临不狂喜? \n\n"
	]));
	
	set("no_fight",1);
	set("objects", ([
		__DIR__"npc/gu": 1,
		__DIR__"npc/boy": 1,
	]));

	set("incity",1);
	setup();
}

int valid_leave(object me, string dir)
{
	me->delete_temp("mark/literate");
	return 1;
}
