// Room: /d/wizard/wizard_room.c

inherit ROOM;
#include <ansi.h>
#include <mudlib.h>

string area_mulu();

void create() {
  set("short", "巫师休息室");
  set("long",
    "这里是" + CHINESE_MUD_NAME + "巫师休息的地方。
" HIW "巫师请调整负责的目录(mulu)" NOR "\n"
  );
  set("exits", ([
    "north": __DIR__ "zoulang",
    "enter": "/adm/etc/admin_room",
    "south": __DIR__ "newsroom",
    "south": __DIR__ "guest_room",
    "east": __DIR__ "wizard_meet"
  ]));
  set("item_desc", ([
  ]));

  set("no_save", 1);
  set("no_fight", 1);
  set("incity", 1);
  setup();
}

void init() {
  object ob = this_player();

  if (userp(ob) && !wiz_level(ob)) {
    ob->move("/d/wizard/guest_room");
    message_vision("$N从巫师休息室重重地摔了下来。\n", ob);
    //ob->unconcious();
  }

}

int valid_enter(int t) {
  return 0;
}
