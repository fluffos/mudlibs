// yun.c 宠物商人

inherit NPC;
string ask_pet();

void create()
{
        set_name("云飘飘", ({ "yun piaopiao", "pet seller" }));
        set("age", 22+random(10));
        set("gender", "男性");
        set("long", "宠物店老板。\n");
        set("attitude", "peaceful");

        set("str", 24);
        set("dex", 16);
        set("combat_exp", 15000+random(20000));
        set("shen_type", 1);

        set_skill("unarmed", 40);
        set_skill("dodge", 40);
        set_skill("parry", 40);
        set_skill("blade", 40);
        set_skill("force", 40);
        set_temp("apply/attack", 40);
        set_temp("apply/defense", 40);
        set_temp("apply/damage", 20);
        set_temp("apply/armor", 40);

	set("inquiry", ([
		"领取宠物" : (: ask_pet :),
	]) );

        setup();
        carry_object(BINGQI_D("blade"))->wield();
        carry_object(ARMOR_D("junfu"))->wear();
}

string ask_pet()
{
	object yun,me,pet;

	yun = this_object();
	me = this_player();

	if(!wizardp(me))
		return "功能测试中，只有巫师才能领取。\n";

	if(me->query("pets"))
		return "你已经领取过宠物了，如果他不在你身边，你可以直接在宠物面板里召唤他。\n";
	pet = new("/clone/pet/pet");
	pet->set_name(me->query("name")+"的宠物",({me->query("id")+"' pet","pet beast"}));
	pet->set("owner",me->query("id"));
	pet->move(environment(me));
	pet->set_leader(me);
	me->set("pets",1);

	return "这是你的宠物，好好善待它、培养它，将来会对你行走江湖有大用处的。\n";
}
