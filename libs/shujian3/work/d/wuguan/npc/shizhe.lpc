// shizhe.c 天涯一号
#include <ansi.h>
#define Weapon_LEVEL				50
#define SKILLS_LEVEL				50
#define KNOWLEDGE_LEVEL 50
#define GIVE_EXP					12500
#define MAX_NEILI					500
#define MAX_JINGLI				 500
inherit NPC;

string ask_newbie();
string ask_mp();
string ask_fanhui();
string ask_newbie_1();

void create()
{
	set_name(HIW"使者"NOR, ({ "shizhe" }));
	set("nickname", HBCYN"江湖使者"NOR);
	set("long", "你可以ask shizhe about 帮助,再ask shizhe about 门派,喜欢哪个门派就ask shizhe about ***,addoil all \n");
	set("gender", "男性");
	set("age", 70);
	set("per", 24);
	set("str", 40);
	set("int", 40);
	set("con", 40);
	set("dex", 40);
	set("qi",5000);
	set("jingli",6000);
	set("max_qi", 8000);
	set("max_jing", 5000);
	set("eff_jingli", 6000);
	set("jiali", 190);
	set("combat_exp", 9000000);
	set("shen", 25000);

	set("chat_chance_combat", 60);
	set("chat_msg_combat", ({
		(: exert_function, "taiji" :),
		(: perform_action, "sword.chan" :),
		(: perform_action, "cuff.zhen" :),
		(: perform_action, "cuff.zhan" :),
		(: perform_action, "cuff.ji" :)
	}));

	set("inquiry", ([
		"新手训练" : (: ask_newbie_1 :),
		"帮助" : (: ask_newbie :),
		"门派" : (: ask_mp :),
	]));
	setup();
}



void init()
{
	object ob;
	add_action("do_answer","answer");
	add_action("do_fly","fly");
	add_action("ask_menpai","ask_menpai");
	::init();
	if (interactive(ob = this_player()) && !is_fighting() && ob->query("new_bie") < 6) {
		ob->start_call_out((: call_other, this_object(), "do_check", ob :), 1);
	} else if (interactive(ob = this_player()) && !is_fighting())
	{
		remove_call_out("greeting");
		call_out("greeting", 0, ob);
	}
}
int do_fly(string arg)
{
	object me = this_player();
	
	if (me->query("new_bie") < 6) {
		tell_object(me, this_object()->name()+"嘿嘿一笑“新手训练”都没完成，想往哪里跑？\n"+name()+"伸出手掌一巴掌手把你从半空中拍了下去！\n");
		return 1;
	}
}
void do_check(object ob)
{
	if (ob && ob->query("new_bie") < 6)
		ob->start_call_out((: call_other, this_object(), "do_check", ob :), 5+(random(5)) );
	else
		ob->remove_call_out("do_check");
	
	if (ob->query("new_bie") < 1) {
		tell_object(ob, "新手入门第一步：请点击屏幕左下方“常用指令”，接着点击一次“查看背包”\n");
		return;
	}
	if (ob->query("new_bie") < 2){
		tell_object(ob, "新手入门第二步：请点击屏幕左下方“常用指令”，接着点击一次“更新公告”\n");
		return;
	}
	if (ob->query("new_bie") < 3){
		tell_object(ob, "新手入门第三步：请点击屏幕左下方“常用指令”，接着点击一次“人物状态”\n");
		return;
	}
	if (ob->query("new_bie") < 4){
		tell_object(ob, "新手入门第四步：请点击屏幕左下方“常用指令”，接着点击一次“综合属性”\n");
		return;
	}
	if (ob->query("new_bie") < 5){
		tell_object(ob, "新手入门第五步：请点击屏幕右下方“游戏指南”，接着点击一次“"HIG"新手指南"NOR"”\n");
		return;
	}
	if (ob->query("new_bie") < 6){
		tell_object(ob, "新手入门第六步：请点击屏幕右下方“游戏指南”，接着点击一次“任务系统”来查看任务帮助\n");
		return;
	}
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	if (ob->query("new_bie") < 6)
		return ;
	if( ob->query("combat_exp") < 100000000000 ) {
		command("hi "+ob->query("id"));
		command("whisper "+ob->query("id")+" "HIC"\n这位" + RANK_D->query_respect(ob) +"初次来到这个武侠世界，是不是充满了新奇和向往？
如果你是新手，请仔细阅读客户端下方的"HIW"〖游戏指南〗"HIC"，里面有许多关于游戏的说明，
另外请多熟悉客户端下方的各个按钮，了解各种功能。
当你初步熟悉之后，再让我来帮你尽快融入这个世界，
首先，请进入"HIR""ZJURL("cmds:ask shizhe about 新手训练")+ZJSIZE(20)+"新手训练"NOR+HIC"教程熟悉一些基本操作，
然后，点击这个"HIY""ZJURL("cmds:ask shizhe about 帮助")+ZJSIZE(20)+"帮助"NOR+HIC"，获得一些基础技能，
最后，点击这个"HIY""ZJURL("cmds:ask shizhe about 门派")+ZJSIZE(20)+"门派"NOR+HIC"，我将把你送到门派师父的旁边，方便你拜师学艺。
当你闯荡江湖遇到问题，记得多向QQ群(223072670)里的其他老玩家请教。
祝你在书剑江湖里玩得开心愉快！"NOR"");
	}

}
string ask_newbie_1()
{
	object ob = this_player();
	
	if (ob->query("new_bie") < 1)
		return "新手入门第一步：请点击屏幕左下方“常用指令”，接着点击一次“查看背包”";
	if (ob->query("new_bie") < 2)
		return "新手入门第二步：请点击屏幕左下方“常用指令”，接着点击一次“更新公告”";
	if (ob->query("new_bie") < 3)
		return "新手入门第三步：请点击屏幕左下方“常用指令”，接着点击一次“人物状态”";
	if (ob->query("new_bie") < 4)
		return "新手入门第四步：请点击屏幕左下方“常用指令”，接着点击一次“查看属性”";
	if (ob->query("new_bie") < 5)
		return "新手入门第五步：请点击屏幕左下方“游戏指南”，接着点击一次“"HIG"新手指南"NOR"”";
	if (ob->query("new_bie") < 6)
		return "新手入门第六步：请点击屏幕左下方“游戏指南”，接着点击一次“任务系统”来查看任务帮助";
	
	return "你已经完成新手训练了呀！\n";
}

string ask_newbie()
{ 
	mapping skill;
	string *skl;
	int i;
	object me = this_object();
	object ob = this_player();
	
	if (ob->query("new_bie") < 6)
		return "新手训练还未完成，等等再说吧";
	
	write ("请输入 ask shizhe about 门派 来加入门派。\n");
	
	if (this_player()->query("离馆")) return "你不是要过一次新手帮助了嘛！？\n";
	ob->set_skill("dodge",1);
	skill = ob->query_skills();
	skl = keys(skill);
	i = sizeof(skl);
	while (i--) 
	{
		ob->delete_skill(skl[i]);				 
	}
	message_vision(HBRED"$N帮助$n提升了一些基础武功！"NOR"\n",me,ob);
	message_vision(HBRED"另外赠送$n3天的会员时间！"NOR"\n",me,ob);	
	ob->delete("double_attack");
	this_player()->set_skill("cuff",SKILLS_LEVEL);
	this_player()->set_skill("blade",SKILLS_LEVEL*2);
	this_player()->set_skill("dodge",SKILLS_LEVEL);
	this_player()->set_skill("force",SKILLS_LEVEL);
	this_player()->set_skill("parry",SKILLS_LEVEL);
	this_player()->set_skill("parry",SKILLS_LEVEL);
	this_player()->set_skill("tizongshu",SKILLS_LEVEL);
	this_player()->set_skill("taizu-quan",SKILLS_LEVEL);
	this_player()->set_skill("wuhu-duanmendao",SKILLS_LEVEL*2);

	this_player()->set_skill("caikuang",Weapon_LEVEL);
	this_player()->set_skill("nongsang",Weapon_LEVEL);
	this_player()->set_skill("duanzao",Weapon_LEVEL);
	this_player()->set_skill("zhizao",Weapon_LEVEL);
	this_player()->set_skill("literate",Weapon_LEVEL);
	this_player()->set_skill("medicine",Weapon_LEVEL);
	this_player()->set_skill("jingmai-xue",Weapon_LEVEL);
  
	ob->set("neili",MAX_NEILI);
	ob->set("max_neili",MAX_NEILI);
	ob->set("jingli",MAX_JINGLI);
	ob->set("max_jingli",MAX_JINGLI);
	ob->set("eff_jingli",MAX_JINGLI);
	ob->set("qi",800);
	ob->set("max_qi",800);
	ob->set("eff_qi",800);
	ob->set("jing",800);
	ob->set("max_jing",800);
	ob->set("eff_jing",800);
	ob->set("combat_exp",GIVE_EXP);
	ob->set("job_time/送信",1000);
	ob->set("job_time/丐帮",400);
	ob->set("shizhe_newbie",1);
	ob->set("registered", 3);	
	ob->set("vip/vip_time",time());
	ob->add("vip/vip_time",3*24*3600);
	ob->set("vip/vip_start_time",time());	
//	ob->set("age",15);
//	ob->set("mud_age",100000);
	ob->set("离馆",1);
	ob->delete("enter_wuguan");
	return "为帮助新手特设此礼物!请用 ask shizhe about 门派 来要加入门派。\n"; 
}

string ask_fanhui()
{
	mapping skill;
	string *skl;
	int i;
	object me = this_object();
	object ob = this_player();
	skill = ob->query_skills();
	skl = keys(skill);
	i = sizeof(skl);
	while (i--) 
	{
		ob->delete_skill(skl[i]);				 
	}
	message_vision(HBRED"$N废去了$n的所有武功！"NOR"\n",me,ob);
	ob->delete("shizhe_newbie");
	ob->delete("shizhe_拜师");
	ob->delete("mishu_newbie");
	ob->delete("mishu_want");
	ob->set("family",0);
	return "请重新 ask shizhe about 帮助 一次。\n";
}

string ask_mp()
{
	object me = this_player();
	
	if (me->query("new_bie") < 6)
		return "请先完成新手训练。";
	
	write(ZJOBLONG"你要拜哪里:\n"ZJOBACTS2+ZJMENUF(3,3,9,30)
		"大轮寺:ask_menpai xs"ZJSEP
		"桃花岛:ask_menpai thd"ZJSEP
		"星宿:ask_menpai xingxiu"ZJSEP
		"武当:ask_menpai wudang"ZJSEP
		"峨嵋:ask_menpai emei"ZJSEP
		"明教:ask_menpai mingjiao"ZJSEP
		"少林:ask_menpai shaolin"ZJSEP
		"丐帮:ask_menpai gb"ZJSEP
		"古墓:ask_menpai tttt"ZJSEP
		"华山:ask_menpai hs"ZJSEP
		"嵩山:ask_menpai ss"ZJSEP
		"慕容:ask_menpai mur"ZJSEP
		"天龙寺:ask_menpai tls"ZJSEP
		"铁掌:ask_menpai tz"ZJSEP
		"神龙岛:ask_menpai sld"ZJSEP
		"昆仑:ask_menpai kl\n");
	return "hehe";
}

int ask_menpai(string arg)
{
    object ob;
    ob=this_player();

	if(!arg)
		return notify_fail("你要选哪个门派？\n");
    
	if (ob->query("new_bie") < 6)
		return notify_fail("请先完成新手训练。");
	
    else if(arg == "xingxiu")
    {
	if (this_player()->query("shizhe_拜师")) return notify_fail("你不是要过一次门派skills了嘛！？\n");
	if (!this_player()->query("shizhe_newbie")) return notify_fail("你必须要先ask shizhe about 新手！？\n");
	message_vision(HIY "使者"+ NOR "一挥手，一阵狂风将$N吹得无影无踪了。"+ NOR "\n",this_player());
	this_object()->create_family("星宿派", 2, "弟子");
	this_object()->recruit_apprentice(this_player());
	this_object()->delete("title");
	this_player()->move("/d/xingxiu/xxh");
	this_player()->set_skill("huagong-dafa",SKILLS_LEVEL);
	this_player()->set_skill("chousui-zhang",SKILLS_LEVEL);
	this_player()->set_skill("sanyin-zhua",SKILLS_LEVEL);
	this_player()->set_skill("zhaixingshu",SKILLS_LEVEL);
	this_player()->set_skill("tianshan-zhang",SKILLS_LEVEL);
	this_player()->set_skill("strike",SKILLS_LEVEL);
	this_player()->set_skill("staff",SKILLS_LEVEL);
	this_player()->set_skill("claw",SKILLS_LEVEL);
	this_player()->set_skill("poison",Weapon_LEVEL);
	this_player()->set("shizhe_拜师",1);
	this_player()->set("shen",-100000);
    }
    else if(arg == "ss")
    {
	if (this_player()->query("shizhe_拜师")) return notify_fail("你不是要过一次门派skills了嘛！？\n");
	if (!this_player()->query("shizhe_newbie")) return notify_fail("你必须要先ask shizhe about 新手！？\n");
	message_vision(HIY "使者"+ NOR "一挥手，一阵狂风将$N吹得无影无踪了。"+ NOR "\n",this_player());
	this_object()->create_family("嵩山派", 4, "弟子");
	this_object()->recruit_apprentice(this_player());
	this_object()->delete("title");
	this_player()->move("/d/songshan/damen");
	this_player()->set_skill("songyang-zhang",SKILLS_LEVEL);
	this_player()->set_skill("strike",SKILLS_LEVEL);
	this_player()->set_skill("songyang-shou",SKILLS_LEVEL);
	this_player()->set_skill("hand",SKILLS_LEVEL);
	this_player()->set_skill("songshan-jian",SKILLS_LEVEL);
	this_player()->set_skill("hanbing-shenzhang",SKILLS_LEVEL);
	this_player()->set_skill("sword",SKILLS_LEVEL);
	this_player()->set_skill("hanbing-zhenqi",SKILLS_LEVEL);
	this_player()->set_skill("force",SKILLS_LEVEL);
	this_player()->set_skill("zhongyuefeng",SKILLS_LEVEL);
	this_player()->set_skill("dodge",SKILLS_LEVEL);
	this_player()->set_skill("parry",SKILLS_LEVEL);
	this_player()->set("shen",-100000);
//	this_player()->set("songshan_points",600);
	this_player()->set("shizhe_拜师",1);
    }
    else if(arg == "wudang")
    {
	if (this_player()->query("shizhe_拜师")) return notify_fail("你不是要过一次门派skills了嘛！？\n");
	if (!this_player()->query("shizhe_newbie")) return notify_fail("你必须要先ask shizhe about 新手！？\n");
	message_vision(HIY "使者"+ NOR "一挥手，一阵狂风将$N吹得无影无踪了。"+ NOR "\n",this_player());
