#include <ansi.h>

inherit SPEC; 

void create()
{
	set_name (HIW"推荐信"NOR, ({ "tuijian xin","xin"}));
	set("long","这是一封"HIW"推荐信"NOR"，"ZJURL("cmds:send tuijian xin")+ZJSIZE(20)+"用"NOR"它能让你重新选择门派。\n");

	set("unit","本");
	set_weight(100);
	set("value",300000);
  set("no_give",1);
  set("no_drop",1);
  set("no_get",1);
  set("no_sell",1);
  set("no_steal",1);	
	set("degree",1);
	set("flag","spec/xin1");
    set("rest",1);
    set("desc","用它能改投门派。");
    set("credit",1000);
	setup();
}

void init()
{
	add_action("do_read","send");
  
}

int do_read(string arg)
{
	object me=this_player();
	    
	if (!arg)
      		return notify_fail("你要读什么?\n");
      		
	if (arg!="tuijian xin" && arg!="xin")
      		return notify_fail("你要读什么?\n");
      	
      		
      	if (!restrict()) {return notify_fail("本周你已经不能使用"+this_object()->query("name")+"了。\n");}   


	
	write(HIY"你使用了一封"HIC"推荐信"HIY"，东方使者答应你在离线之前到他那里重择门派。"NOR"\n");
	me->set_temp("rebai", 1);
	degree();
	return 1;
}	 

int query_autoload() { return 1; }