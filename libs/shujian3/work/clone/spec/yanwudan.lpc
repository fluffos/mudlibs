#include <ansi.h>


inherit SPEC;

void create() {
  set_name(BLU "烟雾弹" NOR, ({ "yanwu dan" }));
  set("long", "这是一颗" BLU "烟雾弹" NOR "，在人物昏迷前逃离当前场景。\n");
  set("unit", "颗");
  set_weight(100);
  set("value", 50000);
  set("no_put", 1);
  set("no_give", 1);
  set("no_drop", 1);
  set("no_sell", 1);
  set("no_steal", 1);
  set("can_store", 1);
  set("degree", 1);
  set("flag", "spec/yanwudan");
  set("desc", "在人物昏迷前逃离当前场景。");
  set("credit", 50);
  setup();
}

int query_autoload() { return 1; }
