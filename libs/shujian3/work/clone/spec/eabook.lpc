#include <ansi.h>

inherit SPEC;

void create() {
  set_name(HIC "天赋之书" NOR, ({ "tbook" }));
  set("long", "这是一本" HIC "天赋之书" NOR "，能临时提高你的四种天赋属性：
" ZJURL("cmds:add str") + ZJSIZE(20) + "臂力" NOR "、
" ZJURL("cmds:add con") + ZJSIZE(20) + "根骨" NOR "、
" ZJURL("cmds:add int") + ZJSIZE(20) + "悟性" NOR "、
" ZJURL("cmds:add dex") + ZJSIZE(20) + "身法" NOR "。
注：每种天赋至多临时提高30点，下线将失效。\n");

  set("unit", "本");
  set_weight(100);
  set("value", 300);
  set("no_give", 1);
  set("no_drop", 1);
  set("no_get", 1);
  set("no_sell", 1);
  set("no_steal", 1);
  set("degree", 1);
  set("flag", "spec/sbook");
  set("desc", "暂时性提高一些天赋。");
  set("credit", 10);
  setup();
}

void init() {
  add_action("do_read", "add");

}

int do_read(string arg) {
  object me = this_player();
  int i;

  if (!arg)
    return notify_fail("你要增加哪方面的天赋能力?\n");

  if (arg != "str" && arg != "dex" && arg != "int" && arg != "con")
    return notify_fail("你要增加哪方面的天赋能力(add str/con/int/dex)?\n");

  if ((arg == "str") && me->query_temp("sbooks") > 29)
    return notify_fail("你看了看这本书，发现关于力量方面的天赋已经无法继续提高了!\n");
  if ((arg == "con") && me->query_temp("sbookc") > 29)
    return notify_fail("你看了看这本书，发现关于根骨方面的天赋已经无法继续提高了!\n");
  if ((arg == "int") && me->query_temp("sbooki") > 29)
    return notify_fail("你看了看这本书，发现关于悟性方面的天赋已经无法继续提高了!\n");
  if ((arg == "dex") && me->query_temp("sbookd") > 29)
    return notify_fail("你看了看这本书，发现关于身法方面的天赋已经无法继续提高了!\n");

  if (!restrict()) { return notify_fail("本周你已经不能使用" + this_object()->query("name") + "了。\n"); }

  i = 1 + random(2);

  write(HIY "你读完" HIC "天赋之书" HIY "发现自己好象变得厉害了一点。\n" NOR);

  switch (arg) {
    case "str":
      if ((i + query_temp("sbooks")) > 29) i = 30 - query_temp("sbooks");
      me->add_temp("apply/strength", i);
      me->add_temp("sbooks", i);
      write("你的臂力临时增加了" + i + "点。\n");
      write("你的临时臂力累计增加了" + me->query_temp("sbooks") + "点。\n");
      break;

    case "con":
      if ((i + query_temp("sbookc")) > 29) i = 30 - query_temp("sbookc");
      me->add_temp("apply/constitution", i);
      me->add_temp("sbookc", i);
      write("你的根骨临时增加了" + i + "点。\n");
      write("你的临时根骨累计增加了" + me->query_temp("sbookc") + "点。\n");
      break;
    case "int":
      if ((i + query_temp("sbooki")) > 29) i = 30 - query_temp("sbooki");
      me->add_temp("apply/intelligence", i);
      me->add_temp("sbooki", i);
      write("你的悟性临时增加了" + i + "点。\n");
      write("你的临时悟性累计增加了" + me->query_temp("sbooki") + "点。\n");
      break;
    case "dex":
      if ((i + query_temp("sbookd")) > 29) i = 30 - query_temp("sbookd");
      me->add_temp("apply/dexerity", i);
      me->add_temp("sbookd", i);
      write("你的身法临时增加了" + i + "点。\n");
      write("你的临时身法累计增加了" + me->query_temp("sbookd") + "点。\n");
      break;
  }

  degree();
  return 1;
}

int query_autoload() { return 1; }
