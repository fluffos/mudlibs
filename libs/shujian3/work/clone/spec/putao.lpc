//flowray 2005.6.20
#include <ansi.h>


inherit SPEC; 

void create()
{
	set_name (HIG"神奇葡萄"NOR, ({ "putao"}));
	set("long","这是一串由达摩传入中土的"HIG"神奇葡萄"NOR"，"ZJURL("cmds:eat putao")+ZJSIZE(20)+"吃"NOR"下它会增加2000点潜能。\n");

	set("unit","串");
	set_weight(100);
	set("value",30000);
        set("no_put",1);
        set("no_give",1);
        set("no_drop",1);
        set("no_sell",1);
        set("no_steal",1);
	set("degree",1);
	set("flag","spec/putao");
	set("desc","增加潜能二千点。");
	set("credit",5);
	setup();
}

void init()
{
	add_action("do_eat","eat");
  
}

int do_eat(string arg)
{
	object me=this_player();
	
	    
	if (arg!="putao")
      		return notify_fail("你要吃什么?\n");
      	
      	if (!restrict()) {return notify_fail("本周你已经不能再吃"+this_object()->query("name")+"了。\n");}   

	me->add("potential",2000);
	write(HIY"你吃下一颗"HIG"神奇葡萄"HIY"发现自己的潜能大增!"NOR"\n");
        if(me->query("potential") > me->query("max_pot")*50)
               write(HIR"提示：你的潜能上限是"+(me->query("max_pot")*50)+"点，请在任务或离开游戏前使用超出部分！"NOR"\n");
	degree();
	return 1;
}	 

int query_autoload() { return 1; }