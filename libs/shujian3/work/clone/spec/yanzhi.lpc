
#include <ansi.h>

inherit SPEC; 

void create()
{
	set_name (HIM"胭脂"NOR, ({ "yanzhi"}));
	set("long","这是一盒"HIM"胭脂"NOR"，你可以"ZJURL("cmds:fu yanzhi")+ZJSIZE(20)+"傅粉"NOR"给自己化妆，提高容貌值。\n");

	set("unit","盒");
	set_weight(100);
	set("value",300000);
        set("no_give",1);
        set("no_drop",1);	
        set("no_get",1);
        set("no_sell",1);
        set("no_steal",1);
	set("degree",1);
	set("flag","spec/yanzhi");
//	set("rest",10);
	set("desc","据说用了之后能提高人的容貌。");
	set("credit",100);	
	setup();
}

void init()
{
	add_action("do_read","fu");
  
}

int do_read(string arg)
{
	object me=this_player();
	    
	if (!arg)
      		return notify_fail("你要傅什么?\n");
      		
	if (arg!="yanzhi")
      		return notify_fail("你要傅什么?\n");
      	
      	if (!restrict()) {return notify_fail("本周你已经不能使用"+this_object()->query("name")+"了。\n");}   

        if (me->query("per")>29) return notify_fail("你的容貌已经极美了。\n");

	    me->add("per",1+random(2));

        if (me->query("per")>30) me->set("per",30);
	
	write(HIY"你使用了一盒"HIM"胭脂"HIY"，你的容貌似乎更美了......"NOR"\n");
        write(HIW"你当前的容貌为:"+HIC+(string)me->query("per")+NOR"\n");
	degree();
	return 1;
}	 

int query_autoload() { return 1; }