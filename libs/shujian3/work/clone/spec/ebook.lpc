//flowray 2005.6.20
#include <ansi.h>


inherit SPEC;

void create() {
  set_name(HIC "精英之书" NOR, ({ "ebook", "book" }));
  set(
    "long",
    "这是一本" HIC "精英之书" NOR "，" ZJURL("cmds:read ebook") + ZJSIZE(20) + "阅读" NOR "它后增加一小时的双倍时间。\n"
  );

  set("unit", "本");
  set_weight(100);
  set("value", 30000);
  set("no_put", 1);
  set("no_get", 1);
  set("no_give", 1);
  set("no_drop", 1);
  set("no_sell", 1);
  set("no_steal", 1);
  set("degree", 1);
  set("flag", "spec/ebook");
  //    set("rest",7);
  set("desc", "一个小时之内获取经验翻倍。");
  set("credit", 10);
  setup();
}

void init() {
  add_action("do_read", "read");

}

int do_read(string arg) {
  object me = this_player();

  if (!arg)
    return notify_fail("你要读什么?\n");

  if (arg != "ebook" && arg != "book")
    return notify_fail("你要读什么?\n");


  if (!restrict()) { return notify_fail("本周你已经不能使用" + this_object()->query("name") + "了。\n"); }


  if (!mapp(me->query_conditions_by_type("db_exp")))
    me->apply_condition("db_exp", 360);
  else
    me->add_condition("db_exp", 360);

  write(HIY "你细细阅读" HIC "精英之书" HIY "心有所得,做什么都是事半功倍。" NOR "\n");

  degree();
  return 1;
}

int query_autoload() { return 1; }
