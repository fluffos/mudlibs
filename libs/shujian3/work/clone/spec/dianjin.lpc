#include <ansi.h>

inherit SPEC;

void create() {
  set_name(HIM "点金之箭" NOR, ({ "dianjin arrow" }));
  set("long", "这是一支" HIM "点金之箭" NOR "，给装备打孔的必需物品。\n");
  set("unit", "支");
  set_weight(100);
  set("value", 30000);
  set("can_store", 1);
  set("degree", 1);
  set("flag", "spec/dianjin");
  set("desc", "可以给装备开孔。");
  set("credit", 10);
  setup();
}

int do_use(string arg) {
  object me = this_player();

  if (!restrict()) {
    write("本周你已经不能再使用" + this_object()->query("name") + "了。\n");
    return 0;
  }

  degree();
  return 1;
}

int query_autoload() { return 1; }
