//flowray 2005.6.20
#include <ansi.h>

inherit SPEC; 

void create()
{
	set_name (HIY"金票"NOR, ({ "jin piao"}));
	set("long","这是一张全国通用的"HIY"金票"NOR"，"ZJURL("cmds:duihuan jin piao")+ZJSIZE(20)+"兑换"NOR"它能获得一千两黄金。\n");

	set("unit","张");
	set_weight(100);
	set("value",300000);
  set("no_give",1);
  set("no_drop",1);
  set("no_get",1);
  set("no_sell",1);
  set("no_steal",1);
	set("degree",1);
	set("flag","spec/jinpiao");
	set("desc","可以换取一千两黄金。");
	set("credit",200);
	setup();
}

void init()
{
	add_action("do_eat","duihuan");
  
}

int do_eat(string arg)
{
	object me=this_player();
	object coin;
	
	    
	if (arg!="jin piao")
      		return notify_fail("你要兑换什么?\n");
      	
      	if (!restrict()) {return notify_fail("本周你已经不能再吃"+this_object()->query("name")+"了。\n");}   

	        coin = new("/clone/money/gold");
		coin->set_amount(1000);
		coin->move(me); 
	write(HIY"你得到了一千两黄金，请注意检查你的金钱上限，如有疑问，可以到各大钱庄进行查询。"NOR"\n");
	degree();
	return 1;
}	 

int query_autoload() { return 1; }