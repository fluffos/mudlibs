#include <ansi.h>


inherit SPEC;

void create() {
  set_name(HIB "周卡" NOR, ({ "week card" }));
  set("long", "这是一张会员周卡，" ZJURL("cmds:use week card") + ZJSIZE(20) + "使用" NOR "之后可以增加7天的会员时间。\n");

  set("unit", "张");
  set_weight(100);
  set("value", 30000);
  set("degree", 1);
  //	set("rest",100);
  set("flag", "spec/wcard");
  set("desc", "增加7天会员时间。");
  set("credit", 50);
  setup();
}

void init() {
  add_action("do_eat", "use");

}

int do_eat(string arg) {
  int vip_time;
  object me = this_player();
  vip_time = 7 * 24 * 3600;

  if (arg != "week card")
    return notify_fail("你要用什么?\n");

  /*
	me->set("vip/vip_start_time",time()); 

	if((int)me->query("vip/vip_time")!=0 && (int)me->query("vip/vip_time") < time())
	        {me->set("vip/vip_time",vip_time + time());}
	else {   me->add("vip/vip_time",vip_time);}
*/


  if ((int)me->query("vip/vip_time") != 0 && (int)me->query("vip/vip_time") < time()) {
    me->delete("vip/vip_time");
    me->delete("vip/vip_start_time");
  }

  if (!(int)me->query("vip/vip_start_time")) {
    me->set("vip/vip_time", vip_time + time());
    me->set("vip/vip_start_time", time());
  } else {
    me->add("vip/vip_time", vip_time);
    me->set("vip/vip_start_time", time());
  }


  if (!mapp(me->query_conditions_by_type("db_exp")))
    me->apply_condition("db_exp", 180);
  else
    me->add_condition("db_exp", 180);

  me->add("potential", 1);

  write(HIY "你用掉了一张" HIB "周卡" HIY "，会员时间增加7天，你可以用time查看。\n" NOR);
  write(HIY "书剑使者又额外赠送你30分钟的双倍时间，你可以输入cond进行查看。\n" NOR);
  degree();
  return 1;
}

int query_autoload() { return 1; }
