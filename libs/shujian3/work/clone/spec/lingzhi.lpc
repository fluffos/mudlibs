//flowray 2005.6.16
// By Spiderii 放宽每周的使用次数限制
#include <ansi.h>


inherit SPEC;

void create() {
  set_name(HIC "千年灵芝" NOR, ({ "ling zhi" }));
  set(
    "long",
    "这是一株" HIC "千年灵芝" NOR "，" ZJURL("cmds:fu ling zhi") + ZJSIZE(20) + "服下" NOR "它可以增长100点内力修为和些许精力值。\n"
  );

  set("unit", "株");
  set_weight(100);
  set("value", 30000);
  set("degree", 1);
  set("flag", "spec/lingzhi");
  //	set("rest",10);
  set("desc", "增加一百点内力上限和一些精力上限。");
  set("credit", 20);
  setup();
}

void init() {
  add_action("do_eat", "eat");
  add_action("do_eat", "fu");
}

int do_eat(string arg) {
  object me = this_player();

  if (!arg)
    return notify_fail("你要服用什么?\n");

  if (arg != "ling zhi")
    return notify_fail("你要服用什么?\n");

  if (!restrict()) { return notify_fail("本周你已经不能使用" + this_object()->query("name") + "了。\n"); }

  if (me->query("max_neili") > (me->query_skill("force") - me->query_temp("apply/force")) * 11 + me->query("combat_exp") / 1000 + me->query_temp("apply/neili") + me->query("age") * 20) return notify_fail("你已经不能继续使用" + this_object()->query("name") + "来提高内力修为了。\n");

  me->add("neili", 100);
  me->add("max_neili", 100);
  me->add("max_jingli", 20 + random(30));
  write(HIY "你服下一株" HIC "千年灵芝" HIY "，顿觉内力、精力大增!" NOR "\n");
  degree();
  return 1;
}

int query_autoload() { return 1; }
