//flowray 2005.6.20
#include <ansi.h>


inherit SPEC;

void create() {
  set_name(HIR "月卡" NOR, ({ "month card" }));
  set("long", "这是一张会员月卡，" ZJURL("cmds:use month card") + ZJSIZE(20) + "使用" NOR "之后可以增加30天的会员时间。\n");

  set("unit", "张");
  set_weight(100);
  set("value", 300000);
  set("no_give", 1);
  set("no_drop", 1);
  set("no_get", 1);
  set("no_sell", 1);
  set("no_steal", 1);
  set("degree", 1);
  //	set("rest",100);
  set("flag", "spec/mcard");
  set("desc", "增加30天会员时间。");
  set("credit", 200);
  setup();
}

void init() {
  add_action("do_eat", "use");

}

int do_eat(string arg) {
  int vip_time;
  object me = this_player();
  vip_time = 30 * 24 * 3600;

  if (arg != "month card")
    return notify_fail("你要用什么?\n");

  if ((int)me->query("vip/vip_time") != 0 && (int)me->query("vip/vip_time") < time()) {
    me->delete("vip/vip_time");
    me->delete("vip/vip_start_time");
  }

  if (!(int)me->query("vip/vip_start_time")) {
    me->set("vip/vip_time", vip_time + time());
    me->set("vip/vip_start_time", time());
  } else {
    me->add("vip/vip_time", vip_time);
    me->set("vip/vip_start_time", time());
  }



  if (!mapp(me->query_conditions_by_type("db_exp")))
    me->apply_condition("db_exp", 720);
  else
    me->add_condition("db_exp", 720);

  me->add("potential", 1);

  write(HIY "你用掉了一张" HIR "月卡" HIY "，会员时间增加30天，你可以输入time进行查看。\n" NOR);
  write(HIY "东方使者又额外赠送你120分钟的双倍时间，你可以输入cond进行查看。\n" NOR);
  degree();
  return 1;
}

int query_autoload() { return 1; }
