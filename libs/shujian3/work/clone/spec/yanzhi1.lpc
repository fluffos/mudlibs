#include <ansi.h>

inherit SPEC;

void create() {
  set_name(HIW "硫酸" NOR, ({ "liu suan" }));
  set(
    "long",
    "这是一瓶" HIW "硫酸" NOR "，你可以" ZJURL("cmds:fu1 liu suan") + ZJSIZE(20) + "自毁" NOR "容貌。\n"
  );

  set("unit", "瓶");
  set_weight(100);
  set("value", 30000);
  set("no_put", 1);
  set("no_get", 1);
  set("no_give", 1);
  set("no_drop", 1);
  set("no_sell", 1);
  set("no_steal", 1);
  set("degree", 1);
  set("flag", "spec/yanzhi1");
  set("desc", "据说用了之后能自毁容貌。");
  set("credit", 20);
  setup();
}

void init() {
  add_action("do_read", "fu1");

}

int do_read(string arg) {
  object me = this_player();

  if (!arg)
    return notify_fail("你要用什么?\n");

  if (arg != "liu suan")
    return notify_fail("你要用什么?\n");

  if (!restrict()) { return notify_fail("本周你已经不能使用" + this_object()->query("name") + "了。\n"); }

  if (me->query("per") < 11) return notify_fail("你的容貌已经极丑了。\n");

  me->add("per", -(1 + random(3)));

  if (me->query("per") < 10) me->set("per", 10);

  write(HIY "你使用了一瓶" HIW "硫酸" HIY "，你的容貌似乎变丑了......" NOR "\n");
  write(HIW "你当前的容貌为:" + HIC + (string)me->query("per") + NOR "\n");
  degree();
  return 1;
}

int query_autoload() { return 1; }
