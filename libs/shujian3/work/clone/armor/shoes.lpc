// cloth.c
//
// This is the basic equip for players just login.

#include <armor.h>
#include <ansi.h>
inherit BOOTS;

void create()
{
        set_name(WHT"布履"NOR, ({ "shoes","lv" }) );
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "双");
                set("long", "这是一双布鞋，鞋底由手工纳制，非常透气舒适。\n");
                set("value", 0);
                set("material", "silk");
                set("armor_prop/dodge", 5);
        }
        setup();
}

