void create()
{
        set_name(CYN"蓝色劲装"NOR, ({ "clothes","cloth" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
                set("long", "这是一件江湖人士常用的蓝色劲装。\n");
                set("material", "cloth");
                set("armor_prop/armor", 10);
        }
        setup();
}