// tizongshu.c


inherit ITEM;

void create() {
  set_name("提纵术", ({ "tizongshu", "shu", "book" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long",
      "这是一本提纵术概要。\n");
    set("value", 5000);
    set("material", "paper");
    set("skill", ([
      "name": "tizongshu",      // name of the skill
      "exp_required": 10,  // minimum combat experience required
      "jing_cost": 20,     // jing cost every time study this
      "difficulty": 10,     // the base int to learn this skill
      "max_skill": 301      // the maximum level you can learn
    ]));
  }
}
