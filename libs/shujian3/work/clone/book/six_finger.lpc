// six_finger.c 六脉真经

inherit ITEM;
#include <ansi.h>

void create()
{
	set_name(MAG"六脉真经"NOR, ({ "liumai zhenjing", "zhenjing", "book" }));
	set_weight(600);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long", "这是一本线装书，封面上霍然写着《六脉真经》四个大字，亮瞎了众人的眼。\n");
		set("unique", 1);
		set("treasure", 1);
		set("value", 50000);
		set("material", "paper");
		set("skill", ([
			"name":	"six-finger",	// name of the skill
			"exp_required":	1000000,	// minimum combat experience required
			"jing_cost":	50,	// jing cost every time study this
			"difficulty":	40,	// the base int to learn this skill
			"max_skill":	999	// the maximum level you can learn
		]) );
	}
}
