// tizongshu.c


inherit ITEM;

void create() {
  set_name("全真剑谱", ({ "jianpu", "shu", "book" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long",
      "这是一本关于全真剑法的普通剑谱。\n");
    set("value", 10000);
    set("material", "paper");
    set("skill", ([
      "name": "quanzhen-jianfa",      // name of the skill
      "exp_required": 10,  // minimum combat experience required
      "jing_cost": 10,     // jing cost every time study this
      "difficulty": 10,     // the base int to learn this skill
      "max_skill": 101      // the maximum level you can learn
    ]));
  }
}
