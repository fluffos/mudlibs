#include <ansi.h>


inherit SPEC;

void create()
{
	set_name (HIM"小飞靴"NOR, ({ "fei xue","feixue"}));
	set("long","这是一双"HIM"小飞靴"NOR"，穿上它可以直达任务目的地。\n");
	set("unit","双");
	set_weight(100);
	set("value",500000);
        set("no_give",1);
        set("no_drop",1);	
        set("no_get",1);
        set("can_store",1);
	set("degree",10);
	set("flag","spec/feixue");
//	set("rest",100);
	set("desc","穿上它可以直达目的地。");
//        set("credit",10);
	setup();
}

int do_eat(string arg)
{
	object me=this_player();
	      	
	if (!restrict())
	{
		write("本周你已经不能再使用"+this_object()->query("name")+"了。\n");
		return 0;
	}    

//	write(HIY"你使用"HIM"小飞靴"HIY"直达目的地!"NOR"\n");
	degree(); 
	return 1;
}	 

