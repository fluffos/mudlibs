// jinchuang.c 金创药

#include <ansi.h>
inherit ITEM;

void init() {
  add_action("do_eat", "fu");
}

void create() {
  set_name("生生造化丹", ({ "zaohua dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("value", 50000);
    set("unit", "颗");
    set("long", "这是一颗生生造化丹，" ZJURL("cmds:fu zaohua dan") + ZJSIZE(20) + "服用" NOR "它能够补满自己的当前内力。\n");
    set("base_value", 50000);
    set("base_unit", "颗");
    set("base_weight", 30);
    set("can_store", 1);
  }
}

int do_eat(string arg) {
  object me = this_player();

  if (arg != "zaohua dan")
    return notify_fail("你要吃什么药？\n");

  if (me->is_busy())
    return notify_fail("你正忙着呢。\n");

  if (me->query_temp("dgjj/zongjue"))
    return notify_fail("你目前的状态无法使用生生造化丹。\n");

  if (sizeof(filter_array(me->query_enemy(), (: userp :))))
    return notify_fail("正在和玩家对手战斗，不能使用生生造化丹。\n");

  if (me->query("neili") > me->query("max_neili"))
    return notify_fail("你现在不需要服用生生造化丹。\n");
  else {
    if (me->query_condition("medicine") > 0)
      return notify_fail("你上一次服药的药性还没有过呢！\n");

    me->set("neili", me->query("max_neili") * 2);
    message_vision("$N服下一颗生生造化丹，顿感真气充盈。\n", me);
    destruct(this_object());
    me->apply_condition("medicine", 4);
    me->start_busy(2);
    return 1;
  }
}

int query_autoload() { return 1; }
