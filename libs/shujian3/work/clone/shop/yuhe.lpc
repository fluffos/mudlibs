
#include <ansi.h>
inherit ITEM;

void init()
{
        add_action("do_open", "open");
}

void create()
{
        set_name("低级玉盒", ({"yu he"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("value", 1000000);
                set("unit", "个");
                set("long", "这是一个不起眼的小盒子，据说里面存放着一块宝玉，你可以试试"ZJURL("cmds:open yu he")+ZJSIZE(20)+"打开"NOR"它。\n");
                set("base_value", 1000000);
                set("base_unit", "个");
                set("base_weight", 500);
                set("can_store",1);
        }
}

int do_open(string arg)
{
        int i;
	object me=this_player();
	object ob1;

        if (!id(arg))
                return notify_fail("你要打开什么？\n");

        if (me->is_busy())
                return notify_fail("你正忙着呢。\n");

        if (random(10)){
                        ob1 = new("/d/zhiye/obj/othermaterial");
                        ob1->set_level(3);
                        ob1->move(me);
	                write("你得到了一块"WHT"宝玉"NOR"。\n");
                destruct(this_object()); 
        	me->start_busy(2);
                return 1;
           }
        else {
                        ob1 = new("/d/zhiye/obj/othermaterial");
                        ob1->set_level(4);
                        ob1->move(me);
	                write("你得到了一块"HIW"宝玉"NOR"。\n");
                destruct(this_object()); 
        	me->start_busy(2);
                return 1;
           }

}
