//flowray 2005.6.20
#include <ansi.h>


inherit SPEC; 

void create()
{
	set_name (BLU"鹿鼎记"NOR, ({ "luding ji","book"}));
	set("long","这是一本查老先生所著的"HIY"鹿鼎记"NOR"，你可以"ZJURL("cmds:read luding ji")+ZJSIZE(20)+"阅读"NOR"它可以提高你的运气。\n");

	set("unit","本");
	set_weight(100);
	set("value",8000000);
        set("no_give",1);
        set("no_drop",1);	
        set("no_get",1);
        set("no_sell",1);
	set("degree",1);
	set("flag","spec/luding");
//	set("rest",10);
	set("desc","据说看了之后会提高一个人的运气。");
//	set("credit",100);	
	setup();
}

void init()
{
	add_action("do_read","read");
  
}

int do_read(string arg)
{
	object me=this_player();
	    
	if (!arg)
      		return notify_fail("你要阅读什么?\n");
      		
	if (arg!="luding ji" && arg!="book")
      		return notify_fail("你要阅读什么?\n");
      	
      	if (!restrict()) {return notify_fail("本周你已经不能使用"+this_object()->query("name")+"了。\n");}   

if (me->query("kar")>29) return notify_fail("你的运气已经极好了。\n");

	me->add("kar",1+random(3));

if (me->query("kar")>30) me->set("kar",30);
if (me->query("kar")<20) me->set("kar",20);
	
	write(HIY"你细细翻阅这本"BLU"鹿鼎记"HIY"，研究着书中韦小宝的经历......"NOR"\n");
	write(HIW"在看书过程中你得到了一些感悟,你的运气似乎变好了。"NOR"\n");
        write(HIW"你当前的福源值为:"+HIC+(string)me->query("kar")+NOR"\n");
	degree();
	return 1;
}	 

int query_autoload() { return 1; }