inherit NPC;
#include <ansi.h>
#include <job_skill.h>

void create() {
  set_name("武林人士", ({ "npc rz", "npc" }));
  set("gender", "男性");
  set("age", 20 + random(60));
  set("long", name() + "已经被折磨得伤痕累累，眼看支撑不下去了。\n");
  set("str", 20);
  set("int", 20);
  set("con", 20);
  set("dex", 20);
  set("combat_exp", 200000);
  set("no_get", 1);
  set("qi", 100);
  set("jing", 100);
  set("neili", 100);
  set("jingli", 100);
  set("max_qi", 500);
  set("jiejiu", 1);
  set_basic();
  setup();
}
void init(object me) {
  object ob;
  me = this_player();
  ob = this_object();
  ::init();

  if (!me->query_temp("day_jobs/was_job/asked"))
    return;

  command("say 这位英雄，小心敌人！\n");
}

void die() {
  write(this_object()->name() + "叹息一声，已然身亡！\n");
  destruct(this_object());
}
