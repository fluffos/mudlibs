//天下第一神兵，完全打破了游戏平衡, /clone/weapon/sword/changsheng-jian.c
// changsheng-jian 长生剑

#include <weapon.h>
#include <ansi.h>

inherit SWORD;
inherit F_UNIQUE;

void create()
{
        set_name( HIG"长生剑"NOR,({ "changsheng jian", "changsheng", "jian", "sword"}) );
        set_weight(5000);
        if( clonep())
                set_default_object(__FILE__);
        else {
            set("unit", "柄");
//		set("value", 1000);
//		set("unique", 1);
//          set("treasure",1); 
		set("rigidity", 10);
		set("sharpness", 8);
//		set("weapon_prop/jing", 2000);
//		set("weapon_prop/qi", 2000);
		set("weapon_prop/strength", 20);
		set("weapon_prop/intelligence", 40);
		set("weapon_prop/constitution", 20);
		set("weapon_prop/dexerity", 20);
		set("weapon_prop/attack", 100);
		set("weapon_prop/sword", 20);
		set("weapon_prop/parry", 20);
		set("weapon_prop/dodge", 20);
		set("weapon_prop/lv", 0);
		set("wield_str", 30);
		set("wield_neili", 1000);
		set("wield_maxneili", 1000);
		set("material", "stone");
                set("wield_msg", HIW"$N嘶的一声抽出"HIG"长生剑"HIW"，但见寒光闪动，宛若一轮明月升空，令目睹者心神摇曳。"NOR"\n");
                set("long", HIG"这是一把长生之剑，采用万年晶石所制，通体碧绿，具有不可思议之功效，无愧「天下第一奇兵」的称号。"NOR"\n");                
                set("unwield_msg", HIM "$N将"HIG"长生剑"HIM"插回剑鞘，锋芒深藏，一切重归静谧。"NOR"\n");               
        }
        init_sword(180);
        setup();
}

void init()
{

    add_action("do_duanlian","duanlian");
    add_action("do_hui","hui");
    add_action("do_rename","rename");
}

int do_duanlian(string arg)
{
    object me;
    object weapon;
    int w_level;
    me=this_player();
    weapon=this_object();

    if( !arg || !id(arg) )
        return notify_fail("你要锻炼什么?\n");
    if( (int)me->query("max_neili") < 1000 )
        return notify_fail("你的内力不够，无法锻炼剑气！\n");
    if( (int)me->query("qi") < 150 )
        return notify_fail("你的气不够，无法锻炼剑气！\n");
    if( (int)me->query("eff_qi") < 50 )
        return notify_fail("你现在的体力太弱，无法锻炼剑气！\n");
    if( (int)me->query("eff_jing") < 50 )
        return notify_fail("你现在的精力无法集中，不能锻炼剑气！\n");
    if( ((int)me->query("potential") - (int)me->query("learned_points"))< 2 )
        return notify_fail("你的潜能不够，无法锻炼剑气！\n");
 message_vision(HIR "$N手指剑脊，一股强大的内力一丝丝的传到剑上。"NOR"\n", me);
    me->add("max_neili",-10);
    me->set("neili", (int)me->query("max_neili"));
    me->add("qi",-(int)me->query("max_qi")/2);
    me->add("eff_qi",-(int)me->query("max_qi")/2);
    me->add("jing",-(int)me->query("max_jing")/2);
    me->add("eff_jing",-(int)me->query("max_jing")/2);
    me->add("potential",-2);

        w_level = (int)weapon->query("weapon_prop/lv");
        w_level+=1;
        weapon->set("weapon_prop/lv", w_level);
        message_vision(HIY "$N运功完毕，只见剑身一亮，一道金光隐入剑体，倏忽不见了！"NOR"\n",me);
        message_vision(RED "$N把长生剑的威力提高了!"NOR"\n", me);

        if(weapon->query("equipped") ) 
            weapon->unequip();
	      weapon->add("weapon_prop/damage", 10);

        return 1;

}




