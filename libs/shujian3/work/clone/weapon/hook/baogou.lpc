// baogou.c 神龙夺命钩

#include <ansi.h>
#include <weapon.h>
inherit HOOK;

void create()
{
        set_name(HIB"神龙夺命钩"NOR, ({ "duoming gou","hook","gou" }));
        set_weight(15000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "这是一柄锐利无比的宝钩。\n");
                set("value", 300);
                set("material", "steel");
		    set("rigidity", 9);
		    set("sharpness", 9);
                set("unique", 1);
                set("treasure",1);
                set("wield_str", 35);
                set("wield_maxneili", 1000);
        }
         init_hook(120);
        setup();
}
