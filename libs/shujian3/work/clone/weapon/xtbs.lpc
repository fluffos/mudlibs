// xtbs.c 匕首
// by snowman@SJ

#include <ansi.h>
#include <weapon.h>
inherit DAGGER;

void create()
{
        set_name(HIB"玄铁匕首"NOR, ({ "xuantie bishou","bishou"}));
        set_weight(5000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "这是一柄黑黝黝的匕首，好像是用玄铁制成的。\n");
                set("value", 30000);
		set("rigidity",6);
                set("sharpness",6);
		set("unique", 1);
                set("treasure",1);
                set("material", "steel");
        }
        init_dagger(120);
        setup();
}
