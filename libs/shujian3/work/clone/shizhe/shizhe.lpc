	return "好了，这位" + RANK_D->query_respect(ob) +"赶紧重新去选择一个心仪的门派吧。\n";
}
	return "出错了！请立即截图向管理报告。\n";

}




string ask_pay()
{
	object me = this_object();
	object ob = this_player();

	if (ob->query("registered") < 3) return "对不起，我只处理赞助会员的事情！\n";

	return "你当前贡献是"+chinese_number(ob->query("vip/all_pay"))+"点。\n";
}


string ask_yao()
{
	object me = this_object();
	object ob = this_player();
        object yao;

	if (ob->query("registered") < 3) return "对不起，我只处理赞助会员的事情！\n";

	if (ob->query("combat_exp", 1) > 3000000) return "这位"+RANK_D->query_respect(ob)+"，你已经是武林高手了，可不能再靠天王护心丹练功了！\n";

        if (  present("huxin dan", ob) )
                return RANK_D->query_respect(ob) + 
                "你身上不是已经有天王护心丹了吗，怎么又来要了？ 真是贪得无厌！";

        yao = new("/clone/shizhe/huxindan");
        yao->move(ob);
        message_vision("$N给了$n一些" + yao->query("name") + "。\n",me ,ob);
	return "这可是好东西，希望对你行走江湖有所帮助。\n";
}