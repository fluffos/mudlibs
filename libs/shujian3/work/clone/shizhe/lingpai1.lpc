#include <ansi.h>

inherit SPEC;

void create() {
  set_name(GRN "传送令牌" NOR, ({ "chuansong lingpai" }));
  set("long", "这是一个" GRN "传送令牌" NOR "，你可以请求东方使者帮你送到目标身边：
" ZJURL("cmds:chuansong zhou botong") + ZJSIZE(20) + "周伯通" NOR "。\n");

  set("unit", "个");
  set_weight(100);
  set("value", 10000);
  set("no_give", 1);
  set("no_drop", 1);
  set("no_get", 1);
  set("no_sell", 1);
  set("no_steal", 1);
  set("degree", 1);
  set("flag", "spec/lingpai1");
  set("rest", 1);
  set("desc", "用它能传送到目标身边。");
  set("credit", 10);
  setup();
}

void init() {
  add_action("do_read", "chuansong");

}

int do_read(string arg) {
  object me = this_player();

  if (!arg && arg != "zhou botong")
    return notify_fail("你要传送去哪里？\n");

  //	if (arg!="tuijian xin" && arg!="xin")
  //      		return notify_fail("你要读什么?\n");

  if (!restrict()) { return notify_fail("本周你已经不能使用" + this_object()->query("name") + "了。\n"); }

  if (arg == "zhou botong") {
    write("你使用了一个传送令牌，空中现出一只巨手抓向你。" NOR "\n");
    me->unconcious();
    me->move("/d/thd/cave");
  }

  degree();
  return 1;
}

int query_autoload() { return 1; }
