//bianxingdan.c
#include <ansi.h>

inherit SPEC;

void do_gender(object player, string gender);

void create()
{
	set_name(HIR"变性丹" NOR, ({ "bianxing dan"}) );
	set_weight(200);
	set("long","一颗红红的丹药，据说"+ZJURL("cmds:fu bianxing dan")+ZJSIZE(22)+"服用"NOR"后可改变自己的性别。\n");
	set("value", 10000);
	set("no_drop",1);
	set("no_sell",1);
	set("degree",1);//可使用次数
	set("flag","spec/bianxin");//类别
	set("credit", 200);//通宝价格
	//set("rest",10);//最高使用次数(每周)
	set("unit", "颗");
	setup();
}

void init()
{
	add_action("do_eat", "fu");
}

int do_eat(string arg)
{
	object me = this_player();		
	object ob;		
	string gender, id, id2;
	
	
	if (sscanf(arg,"%s %s %s", gender, id, id2) != 3)
	{
		tell_object(me, ZJOBLONG + "你要变性为："NOR""ZJBR+
					ZJURL("cmds:fu 男性 bianxing dan")ZJSIZE(15)+CYN+"男性"NOR""ZJBR+
					ZJURL("cmds:fu 女性 bianxing dan")ZJSIZE(15)+HIM+"女性"NOR""ZJBR+
					ZJURL("cmds:fu 无性 bianxing dan")ZJSIZE(15)+HIW+"阴阳人"NOR"\n");
		return 1;
	}
	if (!id(id + " " +id2))
		return 0;	
	
	if( !objectp(ob = present(id + " " +id2, me)) )
		return 0;	
		
	tell_object(me, "你一仰脖，吞下了一颗" + name() +"。\n");
	
	do_gender(me, gender);

	return 1;
}

void do_gender(object player, string gender)
{
	if (gender !="男性" && gender !="女性" && gender !="无性") {
		tell_object(player, "没有这种性别！\n");
		return;
	}

	if(player->query("gender") == gender)
	{
		tell_object(player,sprintf("你已本来就是%s！\n", gender));
		return;
	}

	player->set("gender", gender);
	tell_object(player,"变性成功！\n");
	player->save();
	degree(); //使用次数-1;
}
int query_autoload() { return 1; }
