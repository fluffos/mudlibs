#include <ansi.h>

inherit SPEC; 

void create()
{
	set_name ("七彩宝盒", ({ "baoshi box3"}));
	set("long","这是一个神奇的七彩宝盒，里面装有一颗三级七色宝石，你可以自由选择宝石种类：
"ZJURL("cmds:open red")+ZJSIZE(20)+HIR"红宝石"NOR"(增加攻击/防御)、
"ZJURL("cmds:open blue")+ZJSIZE(20)+HIB"蓝宝石"NOR"(不明效果)、
"ZJURL("cmds:open green")+ZJSIZE(20)+HIG"绿宝石"NOR"(增加气血)、
"ZJURL("cmds:open yellow")+ZJSIZE(20)+HIY"黄宝石"NOR"(增加力量)、
"ZJURL("cmds:open cyan")+ZJSIZE(20)+HIC"青宝石"NOR"(增加身法)、
"ZJURL("cmds:open purple")+ZJSIZE(20)+HIM"紫宝石"NOR"(增加悟性)、
"ZJURL("cmds:open orange")+ZJSIZE(20)+YEL"橙宝石"NOR"(增加根骨)。\n");
	set("unit","个");
	set_weight(100);
	set("value",100000);
	set("flag","spec/baoshi");
	set("desc","能够获得一颗三级七色宝石。");
	set("credit",90);	
	setup();
}

void init()
{
	add_action("do_read","open");
  
}

int do_read(string arg)
{
	object me=this_player();
	object ob1;
	int i;
	    
	if (!arg)
      		return notify_fail("你要开什么宝石？\n");
      		
	if (arg!="red" && arg!="blue" && arg!="yellow" && arg!="cyan" && arg!="green" && arg!="purple" && arg!="orange")
      		return notify_fail("你要开那种颜色的宝石？\n");
      		
	
	switch(arg)
	{
		case "red":
                        ob1 = new("/quest/obj/baoshi");
                        ob1->changename(3,1);
                        ob1->move(me);
	                write("你得到了一颗"HIR"红"NOR"宝石。\n");
			break;
		case "blue":
                        ob1 = new("/quest/obj/baoshi");
                        ob1->changename(3,2);
                        ob1->move(me);
	                write("你得到了一颗"HIB"蓝"NOR"宝石。\n");
			break;
		case "green":
                        ob1 = new("/quest/obj/baoshi");
                        ob1->changename(3,3);
                        ob1->move(me);
	                write("你得到了一颗"HIG"绿"NOR"宝石。\n");
			break;
		case "cyan":
                        ob1 = new("/quest/obj/baoshi");
                        ob1->changename(3,4);
                        ob1->move(me);
	                write("你得到了一颗"HIC"青"NOR"宝石。\n");
			break;
		case "yellow":
                        ob1 = new("/quest/obj/baoshi");
                        ob1->changename(3,5);
                        ob1->move(me);
	                write("你得到了一颗"HIY"黄"NOR"宝石。\n");
			break;
		case "purple":
                        ob1 = new("/quest/obj/baoshi");
                        ob1->changename(3,6);
                        ob1->move(me);
	                write("你得到了一颗"HIM"紫"NOR"宝石。\n");
			break;
		case "orange":
                        ob1 = new("/quest/obj/baoshi");
                        ob1->changename(3,7);
                        ob1->move(me);
	                write("你得到了一颗"YEL"橙"NOR"宝石。\n");
			break;
	}

	degree();
	return 1;
}	 

int query_autoload() { return 1; }