#include <ansi.h>

inherit ITEM_OB;

void create()
{
	set_name(HIW"洗炼石"NOR, ({ "xilian shi","xilian","shi" }));
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "块"); 
		set("long", "这是一块天然的洗炼石，据说是"+ZJURL("cmds:uweapon -xl")+ZJSIZE(24)	+HIC+"洗炼"NOR"自造装备的必备品。\n");
		set("value", 1500);
		set("base_unit", "块");
		set("no_give", 1);
		set("no_drop", 1);
		set("no_get", 1);
		set("no_sell", 1);
		set("no_put", 1);
		set("amount", 1);
	}
       set_amount(1);
} 
