// jinchuang.c 金创药

#include <ansi.h>
inherit COMBINED_ITEM;

void init() {
  add_action("do_eat", "eat");
  add_action("do_eat", "fu");
}

void create() {
  set_name("金创药", ({ "jinchuang yao", "jinchuang", "yao" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("value", 10000);
    set("unit", "些");
    set(
      "long",
      "这是武林人士必备的" ZJURL("cmds:fu jinchuang yao") + ZJSIZE(20) + "金创药" NOR "，能够恢复自身两成左右的气血。\n"
    );
    set("base_value", 10000);
    set("base_unit", "包");
    set("base_weight", 30);
  }
  set_amount(3);
}

int do_eat(string arg) {
  object me = this_player();

  if (!id(arg))
    return notify_fail("你要吃什么药？\n");

  if (me->is_busy())
    return notify_fail("你正忙着呢。\n");

  if (me->query("eff_qi") * 100 / me->query("max_qi") > 98)
    return notify_fail("你现在不需要用金创药。\n");
  else {
    if (me->query_condition("medicine") > 0)
      return notify_fail("你上一次服药的药性还没有过呢！\n");

    me->receive_curing("qi", me->query("max_qi") / 5);
    if (me->query("eff_qi") > me->query("max_qi")) me->set("eff_qi", me->query("max_qi"));
    message_vision("$N吃下一包金创药，气色看起来好多了。\n", this_player());
    add_amount(-1);
    me->apply_condition("medicine", 4);
    me->start_busy(2);
    return 1;
  }
}
