
#include <ansi.h>
inherit SPEC; 

void create()
{
	set_name (HIG"解毒丸"NOR, ({ "jiedu wan","wan"}));
	set("long","这是一颗黑糊糊的药丸，江湖人称"HIG"【解毒丸】"NOR"，据说能解百毒。
你可以"ZJURL("cmds:fu jiedu wan")+ZJSIZE(20)+"服用"NOR"它来解毒。\n");

	set("unit","颗");
	set_weight(100);
	set("value",300000);
        set("no_give",1);
        set("no_drop",1);	
        set("no_get",1);
	set("degree",1);
	set("flag","spec/jiedu");
	set("desc","能解百毒。");
	set("credit",10);	
	setup();
}

void init()
{
        add_action("do_eat", "eat");
        add_action("do_eat", "fu");
}


int do_eat(string arg)                             
{
        object me = this_player();

      if (!id(arg))
                return notify_fail("你要吃什么？\n");

	if (arg!="wan" && arg!="jiedu wan")
      		return notify_fail("你要服用什么?\n");      	
      		
      	if (!restrict()) {return notify_fail("本周你已经不能使用"+this_object()->query("name")+"了。\n");}   

      if (me->is_busy())
                return notify_fail("你正忙着呢。\n");

        me->clear_conditions_by_type("poison");
        message_vision(HIW"$N吃下一颗"HIG"解毒丸"HIW"，体内所中之毒得到了清除。"NOR"\n", me);
	degree();
	return 1;
}
