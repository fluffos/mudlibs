#include <ansi.h>

inherit SPEC; 

void create()
{
	set_name (HIC"天赋之书"NOR, ({ "tbook"}));
	set("long","这是一本"HIC"天赋之书"NOR"，你可以阅读有关增长"ZJURL("cmds:read str")+ZJSIZE(20)+"臂力"NOR"、"ZJURL("cmds:read int")+ZJSIZE(20)+"悟性"NOR"、"ZJURL("cmds:read con")+ZJSIZE(20)+"根骨"NOR"和"ZJURL("cmds:read dex")+ZJSIZE(20)+"身法"NOR"方面的知识。\n");

	set("unit","本");
	set_weight(100);
	set("value",3000000);
        set("no_give",1);
        set("no_drop",1);	
        set("no_get",1);
	set("degree",1);
	set("flag","spec/sbook");
	set("desc","暂时性提高一些天赋。");
	set("credit",20);	
	setup();
}

void init()
{
	add_action("do_read","read");
  
}

int do_read(string arg)
{
	object me=this_player();
	int i;
	    
	if (!arg)
      		return notify_fail("你要阅读什么知识?\n");
      		
	if (arg!="str" && arg!="dex" && arg!="int" && arg!="con")
      		return notify_fail("你要阅读什么知识?\n");
      	
      	if (me->query_temp("sbook")>29)
      		return notify_fail("你看了看这本书，发现已经没什么好学的了!\n");
      		
      	if (!restrict()) {return notify_fail("本周你已经不能使用"+this_object()->query("name")+"了。\n");}   

	i=random(3)+1;
	if (i+query_temp("sbook")>29) i=30-query_temp("sbook");

	me->add_temp("sbook",i);
	write(HIY"你读完"HIC"天赋之书"HIY"发现自己好象变得厉害了一点。\n"NOR);
	
	switch(arg)
	{
		case "int":
			me->add_temp("apply/intelligence",i);
	write("你的悟性临时增加了"+i+"点。\n");
	write("你的临时属性累计增加了"+me->query_temp("sbook")+"点。\n");
			break;
		case "str":
			me->add_temp("apply/strength",i);
	write("你的臂力临时增加了"+i+"点。\n");
	write("你的临时属性累计增加了"+me->query_temp("sbook")+"点。\n");
			break;
		case "dex":
			me->add_temp("apply/dexerity",i);
	write("你的身法临时增加了"+i+"点。\n");
	write("你的临时属性累计增加了"+me->query_temp("sbook")+"点。\n");
			break;
		case "con":
			me->add_temp("apply/constitution",i);
	write("你的根骨临时增加了"+i+"点。\n");
	write("你的临时属性累计增加了"+me->query_temp("sbook")+"点。\n");
			break;
	}

	degree();
	return 1;
}	 

int query_autoload() { return 1; }