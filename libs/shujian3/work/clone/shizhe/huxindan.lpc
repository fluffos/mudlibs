// huxin-dan.c 天王护心丹

#include <ansi.h>

inherit ITEM;

void init()
{
             add_action("do_eat", "fuyong");
}

void create()
{
        set_name(HIR"天王护心丹"NOR, ({"huxin dan"}));
        set_weight(50);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long","一颗"+name()+"，东方一族秘制的"ZJURL("cmds:fuyong huxin dan")+ZJSIZE(20)+"疗伤"NOR"圣药，功能起死回生。\n");
                set("value", 2000);
                set("unit", "颗");
                set("numb", 10);
                set("no_put", 1);
                set("no_get", 1);
                set("no_drop", 1);
                set("no_give", 1);
                set("no_sell", 1);
                set("no_steal", 1);
          }
   	setup();
}

int do_eat(string arg)
{
       int q, j;

       object me, ob;      
       me=this_player();
       ob=this_object();

	q = me->query("eff_qi") + me->query_temp("apply/qi");
	j = me->query("eff_jing") + me->query_temp("apply/jing");

	if (!arg || arg!="huxin dan")
		return notify_fail("你要服什么?\n");

        if(me->is_busy())
                return notify_fail("你正忙着呢。\n");

//	if (sizeof(filter_array(me->query_enemy(),(: userp :))))
//		return notify_fail("正在和玩家对手战斗，不能使用天王护心丹。\n");

        if((int)me->query_skill("medicine", 1) < 49 )
                return notify_fail("你的药理知识不足，此丹药对你起不到什么作用。是不是该向襄阳的平一指学点本草术理呢？\n");

 //       if(me->query_skill("force", 1) > 250 ) 
 //               return notify_fail("你的内功修为太高，此丹药已经对你没什么作用了。\n");

	if(me->query("combat_exp", 1) > 1000000 && me->query("registered") < 3) 
                return notify_fail("你还是先去加入东方一族吧！\n");

	if(me->query("combat_exp", 1) > 2000000) 
                return notify_fail("你已经是武林高手了，此丹药已经对你失去了作用！\n");

        if(me->query_condition("medicine") > 0 )
                  return notify_fail("你上次的药劲儿还没过呢，等会再吃吧。\n");


        if (me->query("eff_qi") == me->query("max_qi") 
             && me->query("eff_jing") == me->query("max_jing") 
             && me->query("neili") >= me->query("max_neili"))
                return notify_fail("你现在不需要吃"+name()+"。\n");

      if( ob->query("numb") > 0){      
                me->set("eff_qi", me->query("max_qi"));
                me->set("eff_jing", me->query("max_jing"));
                me->set("qi", q);
                me->set("jing", j);
                me->set("neili",me->query("max_neili")*2);
                me->set("jingli",me->query("max_jingli"));
                me->set("food", me->max_food_capacity());
                me->set("water", me->max_water_capacity());
                me->apply_condition("medicine", 4);
                message_vision(HIG"$N服下一颗"+name()+""HIG"，顿时伤势痊愈气血充盈！"NOR"\n" , me);

                ob->add("numb", -1);

           if(ob->query("numb") < 1){
                write(""+name()+"已经被吃的一丝不剩了。\n");
                destruct(this_object()); 
             }
           else write(""+name()+"还能继续使用"+ob->query("numb")+"次。\n");

                me->start_busy(2);      
                return 1;
             }
        
}


