#include <ansi.h>
//新的继承
inherit ITEM_OB;

void create() {
  set_name("天王保命丹", ({ "baoming dan" }));
  set("value", 90000);
  set("unit", "颗");
  set(
    "long",
    "这是一颗天王保命丹，" ZJURL("cmds:uses " + file_name(this_object())) + ZJSIZE(20) + "服用" NOR "它能够完全恢复自身伤势。\n"
  );
  set("base_value", 90000);
  set("base_unit", "颗");
  set("base_weight", 30);
  set("can_store", 1);
  set("uses", 1);  //可uses的标志
  set_amount(1);
  setup();
}

int do_uses(mixed arg) {
  object me = this_player();
  object ob;

  if (objectp(arg)) {
    ob = arg;
    if (!present(ob, me)) {
      tell_object(me, "你要使用什么？\n");
      return 1;
    }
  } else {
    if (arg != "zaohua dan") {
      tell_object(me, "你要吃什么？\n");
      return 1;
    }
    if (!objectp(ob = present(arg, me))) {
      tell_object(me, "你要吃什么？\n");
      return 1;
    }
  }

  if (me->is_busy()) {
    tell_object(me, "你正忙着呢。\n");
    return 1;
  }

  if (sizeof(filter_array(me->query_enemy(), (: userp :)))) {
    tell_object(me, "正在和玩家对手战斗，不能使用生生造化丹。\n");
    return 1;
  }

  if (me->query("eff_qi") * 100 / me->query("max_qi") > 99 && me->query("eff_jing") * 100 / me->query("max_jing") > 99) {
    tell_object(me, "你现在不需要服用" + name() + "。\n");
    return 1;
  } else {
    if (me->query_condition("medicine") > 0) {
      tell_object(me, "你上一次服药的药性还没有过呢！\n");
      return 1;
    }

    me->set("eff_qi", me->query("max_qi"));
    me->set("eff_jing", me->query("max_jing"));

    message_vision("$N服下一颗天王保命丹，伤势痊愈了。\n", me);
    ob->add_amount(-1);
    me->apply_condition("medicine", 4);
    me->start_busy(2);
    return 1;
  }
}
