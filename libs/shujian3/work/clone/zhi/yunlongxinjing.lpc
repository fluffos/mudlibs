// 参照 /d/thd/obj/book.c
// 新的quest武功系统

#include <ansi.h>
inherit ITEM;

void create()
{
	set_name(YEL"云龙心经"NOR, ({ "yunlong xinjing", "yunlong","xinjing" }));
	set_weight(900);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long","这是一本云梦上人所著的武学秘籍，你可以研读（read）以下的技能：\n"
HIY"云龙心法     (yunlong-xinfa)   \n"
HIM"云龙剑法     (jiuyin-shenzhua) \n"
HIW"云龙身法     (xuanyin-jian)    "NOR"\n"
);
		set("material", "paper");
		set("no_drop", "这样东西不能离开你。\n");
		set("no_get", "这样东西不能离开那儿。\n");
		set("no_give", 1);
		set("no_put", 1);
		set("unique", 1);
		set("treasure", 1);
	}
}

void init()
{
	add_action("do_du", "read");
}

int do_du(string arg)
{
        int cost, my_skill;
        object me=this_player();
        object where = environment(me);

        if (!arg) return notify_fail("你要读什么？\n");

        if ( me->is_busy())
             return notify_fail("你现在正忙着呢。\n");

        if (where->query("sleep_room") || where->query("no_fight"))
             return notify_fail("这里你不能读书。\n");

        if( me->is_fighting())
             return notify_fail("你无法在战斗中专心下来研读新知！\n");

        if( !me->query_skill("literate", 1) )
             return notify_fail("你是个文盲，先学点文化(literate)吧。\n");

        if( (int)me->query("potential") < 1 )
             return notify_fail("你的潜能已经用完了，再怎么读也没用。\n");

        if( (int)me->query("combat_exp") < 1000000 )
             return notify_fail("你的实战经验不足，再怎么读也没用。\n");

        if( me->query_int() < 40 )
             return notify_fail("以你目前的领悟能力，还没有办法学这个技能。\n");

        cost = 40 * ( 1 + ( 35 - (int)me->query("int"))/20 );
        if (cost < 20) cost = 20;

        if( me->query("neili") < cost * 2 + 300)
          return notify_fail("你的内力不够，无法领会这个技能。\n");
        me->set_temp("last_damage_from", "研读高深武功，熬尽心机累");

        switch (arg){
         case "yunlong-shenfa":
              my_skill = me->query_skill("yunlong-shenfa", 1);
              if( my_skill >= 200)
                 return notify_fail("你觉得这经书上所写的已经太浅了，不能学到什么东西。\n");
              if( my_skill >= me->query_skill("yunlong-xinfa",1))
                 return notify_fail("你的云龙心法等级太低了，不能继续学习云龙身法。\n"); 
              if( my_skill * my_skill * my_skill / 10 > (int)me->query("combat_exp") ) 
                 return notify_fail("也许是缺乏实战经验，你对经书上面所说的东西总是无法领会。\n");
              else
                 write("你研读着有关云龙身法的技巧，似乎有些心得。\n");
              me->improve_skill("yunlong-shenfa", ((int)me->query_skill("literate", 1)/5+1) );
              me->receive_damage("jing", cost );
              me->add("neili", -cost * 2);
              me->add("potential", - random(2));
              break;

         case "yunlong-zhua":
              my_skill = me->query_skill("yunlong-zhua", 1);
              if( my_skill >= 200)
                 return notify_fail("你觉得这经书上所写的已经太浅了，不能学到什么东西。\n");
              if( my_skill >= me->query_skill("yunlong-xinfa",1))
                 return notify_fail("你的云龙心法太低了，不能学到什么东西。\n");
              else if( my_skill * my_skill * my_skill / 10 > (int)me->query("combat_exp") ) 
                 return notify_fail("也许是缺乏实战经验，你对经书上面所说的东西总是无法领会。\n");
              else write("你研读着有关云龙爪的技巧，似乎有些心得。\n");
              me->improve_skill("yunlong-zhua", ((int)me->query_skill("literate", 1)/5+1) );
              me->receive_damage("jing", cost );
              me->add("neili", -cost * 2);
              me->add("potential", - random(2));
              break;                                     

         case "yunlong-jianfa":
              my_skill = me->query_skill("yunlong-jianfa", 1);
              if( my_skill >= 200)
                 return notify_fail("你觉得这经书上所写的已经太浅了，不能学到什么东西。\n"); else
              if( my_skill >= me->query_skill("yunlong-xinfa",1))
                 return notify_fail("你的云龙心法太浅，不能学到什么东西。\n");
              if( my_skill * my_skill * my_skill / 10 > (int)me->query("combat_exp") ) 
                 return notify_fail("也许是缺乏实战经验，你对经书上面所说的东西总是无法领会。\n");
              else write("你研读着有关云龙剑法的技巧，似乎有些心得。\n");
              me->improve_skill("yunlong-jianfa", ((int)me->query_skill("literate", 1)/5+1) );
              me->receive_damage("jing", cost );
              me->add("neili", -cost * 2);
              me->add("potential", - random(2));
              break;             
            
         case "yunlong-xinfa":
              my_skill = me->query_skill("yunlong-xinfa", 1);
          write("你研读着云龙心法，似乎有些心得。\n");
          me->improve_skill("yunlong-xinfa", ((int)me->query_skill("literate", 1)/5+5) );
          me->receive_damage("jing", cost );
          if(me->query_skill("yunlong-xinfa",1)>150)
               me->add("potential", - random(2));
          if(me->query_skill("yunlong-xinfa",1)>200)
               me->add("potential", - random(2));
          if(me->query_skill("yunlong-xinfa",1)>250)
               me->add("potential", - random(3));
          if(me->query_skill("yunlong-xinfa",1)>300)
               me->add("potential", - random(3));
         break;             
        }
        return 1;
}
