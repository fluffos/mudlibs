
// killer.c

#include <ansi.h>

int update_condition(object me, int duration)
{
	if( me->query("kill_flag") > 3) {
		message("channel:chat", HIC"〖官府通告〗重犯"+ me->query("name")+"已经被抓获，打入刑部大牢！\n"NOR,users());
		me->move("/adm/daemons/jianyu");
		me->set("parsion_flag",1);
		me->set("parsion_time",me->query("mud_age"));
		me->set("start_room","/d/jianyu");
		me->delete_condition("killer");
		me->delete("kill_flag");
		return 1;
	}
	
	if( duration <= 1)
	{
		message("channel:chat", HIC"〖官府通告〗重犯"+ me->query("name")+"刑期已满，现无罪释放，望其洗心革面，重新做人。\n"NOR,users());
		me->move("/d/city/wumiao");
		me->delete("parsion_flag");
		me->delete("parsion_time");
		me->set("start_room","/d/city/wumiao");
		me->delete_condition("parsion");
		return 0;
	}
	me->apply_condition("parsion", duration - 1);
	return 1;
}
