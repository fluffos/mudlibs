// killer.c

#include <ansi.h>

int update_condition(object me, int duration) {
  if (duration < 1) {
    message(
      "channel:chat",
      HIC "〖官府通告〗" + me->query("name") + "杀人一案已破，放弃追捕" + me->query("name") + "。\n" + NOR,
      users()
    );
    me->delete("kill_flag");
    return 0;
  }
  me->apply_condition("killer", duration - 1);
  return 1;
}
