// song.c 宋远桥

inherit NPC;
inherit F_MASTER;
#include <ansi.h>
string ask_me();
int job();
int finish();
int saoba();
void create() {
  set_name("宋远桥", ({ "song yuanqiao", "song" }));
  set("nickname", "武当首侠");
  set("long",
    "他就是张三丰的大弟子、武当七侠之首的宋远桥。\n"
    "身穿一件干干净净的灰色道袍。\n"
    "他已年过六十，身材瘦长，满脸红光。恬淡冲和，沉默寡言。\n");
  set("gender", "男性");
  set("age", 61);
  set("attitude", "peaceful");
  set("class", "taoist");
  set("shen_type", 1);
  set("str", 28);
  set("int", 28);
  set("con", 28);
  set("dex", 28);

  set("max_jing", 2000);
  set("neili", 40000);
  set("max_neili", 40000);
  set("jiali", 120);
  set("combat_exp", 6500000);
  set("score", 60000);

  set_skill("force", 700);
  set_skill("taiji-shengong", 700);
  set_skill("dodge", 700);
  set_skill("tiyunzong", 700);
  set_skill("unarmed", 700);
  set_skill("taiji-quan", 700);
  set_skill("parry", 700);
  set_skill("sword", 700);
  set_skill("taiji-jian", 700);
  set_skill("wudang-jian", 700);
  set_skill("taoism", 700);
  set_skill("literate", 700);

  map_skill("force", "taiji-shengong");
  map_skill("dodge", "tiyunzong");
  map_skill("unarmed", "taiji-quan");
  map_skill("parry", "taiji-jian");
  map_skill("sword", "taiji-jian");

  create_family("武当派", 2, "弟子");

  set("inquiry", ([
    "秘籍": (: ask_me :),
    "job": (: job :),
    "finish": (: finish :),
    "工作": (: job :),
    "领赏": (: finish :),
    "扫把": (: saoba :),
  ]));

  set("book_count", 1);

  setup();
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/d/wudang/obj/greyrobe")->wear();
}

void attempt_apprentice(object ob) {
  if ((int)ob->query("guarded") < 3) {
    command("say " + RANK_D->query_respect(ob) +
      "你对我武当派尽了多少心力，有几分忠心呢？");
    return;
  }
  if ((int)ob->query_skill("taiji-shengong", 1) < 450) {
    command("say 我武当派乃内家武功，最重视内功心法。");
    command("say " + RANK_D->query_respect(ob) +
      "是否还应该在太极神功上多下点功夫？");
    return;
  }
  if ((int)ob->query("shen") < 10000) {
    command("say 我武当乃是堂堂名门正派，对弟子要求极严。");
    command("say 在德行方面，" + RANK_D->query_respect(ob) +
      "是否还做得不够？");
    return;
  }
  command("say 好吧，贫道就收下你了。");
  command("recruit " + ob->query("id"));
}

string ask_me() {
  mapping fam;
  object ob;

  if (!(fam = this_player()->query("family")) || fam["family_name"] != "武当派")
    return RANK_D->query_respect(this_player()) + "与本派素无来往，不知此话从何谈起？";
  if (query("book_count") < 1)
    return "你来晚了，本派的内功心法不在此处。";
  add("book_count", -1);
  ob = new("/clone/book/force_book");
  ob->move(this_player());
  command("rumor " + this_player()->query("name") + "拿到太极十三式啦。\n");
  return "好吧，这本「太极十三式」你拿回去好好钻研。";
}

int job()

{
  object me, obj;
  me = this_player();
  obj = this_object();

  if (obj->query_temp("give_job") > 50 + random(50)) {
    command("shake");
    command("say 今天已经没事情做了，明天再来吧。");
    return 1;
  }

  if (me->query_temp("扫地_job")) {
    command("? " + me->query("id"));
    command("say 叫你去扫地，你打扫干净了吗？？");
    return 1;

  }
  if (me->query("family/family_name") != "武当派") {
    command("say 你不是武当的弟子，我怎敢让你做事呀？");
    command("hehe " + me->query("id"));
    return 1;
  }

  if (me->query("family/family_name") == "武当派") {
    message_vision("$N打量了$n一眼。\n", obj, me);
    command("say 好吧！你去把后院，林间小径或者武当广场给打扫一下。");
    command("say 扫完了再来找我吧！");
    me->set_temp("扫地_job", 1);
    obj->add_temp("give_job", 1);
    return 1;
  }

}
int finish() {
  int i, n;
  object me;
  me = this_player();



  if (me->query_temp("扫地_finish")) {
    command("nod " + me->query("id"));
    command("say 好！干得好！");
    me->delete_temp("扫地_job");
    me->delete_temp("job_times");
    me->delete_temp("bad_job");
    me->delete_temp("扫地_finish");
    me->add("score", random(10));
    i = me->query("kar") * (random(3) + 2);
    n = me->query("per") * (random(2) + 1);
    me->add("combat_exp", n);
    me->add("potential", i);
    tell_object(
      me,
      "宋远桥给了你" HIW + chinese_number(n) + NOR "点经验和" HIW + chinese_number(i) + NOR "点潜能做为奖励。\n"
    );
    message_vision("$N出色的完成了工作，获得了宋远桥的奖励。\n", me);
    return 1;

  }

  command("say 你的工作还没有做完呢！");
  return 1;

}

int saoba() {
  object ob, me, obj;
  me = this_player();
  ob = this_object();

  if (me->query("family/family_name") != "武当派") {
    command("say 你要扫把做什么？");
    return 1;
  }

  if (!me->query_temp("扫地_job")) {
    command("say 你要扫把做什么？");
    return 1;
  }

  if (present("sao ba", me)) {
    command("say 你身上不是已经有扫把了吗？");
    return 1;
  }
  obj = new("/clone/misc/saoba");
  command("say 拿去吧！不要拿来做武器哦！");
  obj->move(me);
  return 1;
}
