// gaibang npc code
// Modified By Jonak

inherit NPC;
inherit F_MASTER;

void create()
{
	set_name("左全", ({"zuo quan", "zuo", "quan"}));
	set("title", "丐帮七袋弟子");
	set("gender", "男性");
	set("age", 35);
	set("long", 
		"这是位豪爽大方的丐帮七袋弟子，看来是个北地豪杰。\n");
	set("attitude", "peaceful");
	set("class", "beggar");
	set("str", 20);
	set("int", 20);
	set("con", 20);
	set("dex", 26);

	set("max_qi", 360);
	set("max_jing", 300);
	set("neili", 710);
	set("max_neili", 710);
	set("jiali", 36);
	
	set("combat_exp", 5000000);
	
	set_skill("force", 300); 
	set_skill("huntian-qigong", 300); 
	set_skill("unarmed", 300); 
	set_skill("xianglong-zhang", 300); 
	set_skill("dodge", 300); 
	set_skill("xiaoyaoyou", 300); 
	set_skill("parry", 300); 
	set_skill("begging", 300); 
	set_skill("checking", 300); 
	
	map_skill("force", "huntian-qigong");
	map_skill("unarmed", "xianglong-zhang");
	map_skill("dodge", "xiaoyaoyou");
	
	create_family("丐帮", 19, "弟子");
	setup();
}

void init()
{
        add_action("give_getquest", "getquest");
}

int give_getquest()
{
        mapping getquest ;
        object me;
        int j;
        
        me = this_player();

        if (me->query("family/family_name") != "丐帮"){
            command("say 你不是丐帮弟子，我不会给任务你的。");  
            return 1;
            }
        if (me->query("beggarlvl") <= 2){
            command("say 四袋以下的弟子想领任务就去何不净那里吧！");
            return 1;
            }
        if (me->query("beggarlvl") >= 6){
            command("say 你的辈份已经这么高了，我可不敢叫你去办事，你还是去找鲁长老吧！");
            return 1;
            }
        if (me->query("combat_exp") >= 2000000 ){
            command("say 你的武功已经很有水平了，该去做些艰辛点的任务。");
            return 1;
            }
        if (me->query("gaibang_job") == 1 ){
            command("say 我不是叫你去捉毒物了吗，你还呆在这里干什么，快点去。");
            return 1;
            }
        if ((me->query("beggarlvl") == 3) || 
            (me->query("beggarlvl") == 4) || 
            (me->query("beggarlvl") == 5)){
            command("say 好，我现在正好要找些毒物，你就去帮我捉吧。");
            me->set("gaibang_job", 1); 
            return 1;
            }
}

int accept_object(object who, object ob)
{
	object ob_yzz, me = this_object();
        int bonus, exp, pot, factor;
        string test;

        if (who->query("gaibang_job") == 1 ) {
            if ((ob->query("id") == "wu gong") || 
                (ob->query("id") == "du xie") || 
                (ob->query("id") == "jin she") || 
                (ob->query("id") == "fu she") || 
                (ob->query("id") == "dushe")) {
                command("say 怎么只捉到这些没用小东西，哎...算了，看你也辛苦了，就给点实战经验和潜能你作为奖励吧。");    
                this_player()->add("combat_exp",100+random(50));                    
                this_player()->add("potential",30+random(20)); 
		return 1;      
	    }
            if ((ob->query("id") == "mang she") || 
                (ob->query("id") == "wubu she") || 
                (ob->query("id") == "yin she")) {
                command("say 嗯，干得不错，奖励些实战经验和潜能给你作为报答吧。");    
                this_player()->add("combat_exp",300+random(100));                    
                this_player()->add("potential",50+random(30)); 
		return 1;      
	    }
            if ((ob->query("id") == "ju mang") || 
                (ob->query("id") == "bing can") || 
                (ob->query("id") == "zhu ha")) {
                command("say 哇~！连这么稀有的东西都能帮我找来，很好，我会好好的报答你。");    
                this_player()->add("combat_exp",1000+random(1000));                    
                this_player()->add("potential",200+random(100));  
		return 1;     
	    }
                who->set("gaibang_job", 0);
                destruct(ob);
}
        else
        {
        message_vision("左全对着$N直摇头道：这些东西我不需要，你给我干什么？不要乱来！\n",this_player());
        return 0;
        }

}

void attempt_apprentice(object ob)
{
        if( ob->query("gender") != "男性") return;
        command("say 好吧，希望你能好好学习本门武功，将来为丐帮争一口气！。");
        command("recruit " + ob->query("id"));
        if((string)ob->query("class") != "beggar")
	ob->set("class", "beggar");
}

