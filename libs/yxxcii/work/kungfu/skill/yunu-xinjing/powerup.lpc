// powerup.c

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int exert(object me, object target) {
  int skill;

  if ((int)me->query_skill("yunu-xinjing", 1) < 100)
    return notify_fail("你的玉女心经修为不够。\n");
  if (target != me)
    return notify_fail("你只能用玉女心经提升自己的战斗力。\n");

  if ((int)me->query("neili") < (int)me->query("max_neili") / 50)
    return notify_fail("你的内力不够！\n");
  if ((int)me->query_temp("powerup"))
    return notify_fail("你已经在运功中了。\n");

  skill = me->query_skill("force");

  me->add("neili", -(int)me->query("max_neili") / 50);
  me->receive_damage("qi", 0);

  message_vision(HIM "$N微微低下头必除杂念潜心默念玉女心经，牢记心经总决。\n" NOR, me);
  message_vision(HIM "後微一抬头眼中透出冷漠的目光射向在场的所有人，根本没人注意到$N已有了微妙的变化。\n" NOR, me);

  me->add_temp("apply/attack", skill / 2);
  me->add_temp("apply/dodge", skill / 2);
  me->set_temp("powerup", 1);

  me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill / 2 :), skill);

  if (me->is_fighting()) me->start_busy(2);

  return 1;
}

void remove_effect(object me, int amount) {
  if ((int)me->query_temp("powerup")) {
    me->add_temp("apply/attack", -amount);
    me->add_temp("apply/dodge", -amount);
    me->delete_temp("powerup");
    message_vision(
      HIM "$N" HIY "运行完毕，将内力收回丹田，俏丽的脸蛋上又露出了迷人的微笑。\n" NOR, me);
  }
}
