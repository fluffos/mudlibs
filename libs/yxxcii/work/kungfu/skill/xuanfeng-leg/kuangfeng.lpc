// kuangfeng.c  狂风绝技

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
 
int perform(object me, object target)
{
	object weapon, ob;
	string msg, string1;
	int count;
 
 	if( !target ) target = offensive_target(me);
	if( !me->is_fighting() )
		return notify_fail("「狂风绝技」只能在战斗中使用。\n");
 
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("「狂风绝技」开始时不能拿着兵器！\n");

	if( (int)me->query("neili") < (int)me->query("max_neili")/10)
		return notify_fail("你的内力不够！\n");

	if( (int)me->query_skill("bibo-shengong",1) < 150)
		return notify_fail("你的碧波神功不够！\n");

	if( (int)me->query_skill("luoying-zhang",1) < 100 ||
		me->query_skill("xuanfeng-leg",1) < 100)
		return notify_fail("你的腿掌功夫还不到家，无法使用狂风绝技！\n");

	msg = HIY "$N使出桃花岛绝技「狂风绝技」，整个人朝$n飞去！！\n" NOR;
	message_vision(msg, me,target);

	me->clean_up_enemy();
	ob = me->select_opponent();

	COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
	msg = HIY "$N右脚往$n头部一扫，使出的正是「狂风扫叶」！！\n" NOR;
	message_vision(msg, me,target);
	COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
	msg = HIB "$N左脚往$n头部一踢，使出的正是「风卷残云」！！\n" NOR;
	message_vision(msg, me,target);
	COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
	msg = HIY "$N猛的往$n天灵盖上踩去，使出的正是「狂风怒啸」！！\n" NOR;
	message_vision(msg, me,target);
	COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
	msg = HIB "$N脚尖点地，后脚往$n要害踢去，使出的正是「风云幻变」！！\n" NOR;
	message_vision(msg, me,target);
	COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
	msg = HIY "$N双腿夹住$n的脖子，使出的正是「风雨怒嚎」！！\n" NOR;
	message_vision(msg, me,target);
	COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
	msg = HIY "$N右脚正好踢中$n的腰部，使出的正是「落叶秋风」！！\n" NOR;
	message_vision(msg, me,target);
	
	me->add("neili", -(int)me->query("max_neili")/10);
	me->start_busy(2);

	return 1;
}
