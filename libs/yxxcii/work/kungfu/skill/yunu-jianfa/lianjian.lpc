// lianjian.c 玉女素心剑法<<总决式>>

#include <ansi.h>
 
inherit F_SSERVER;
 
int perform(object me)
{
	mapping myfam;
	string msg;
	object weapon;
	int skill;
	myfam = (mapping)me->query("family");
	skill = me->query_skill("yunu-jianfa",1);

	if( me->is_fighting() )
		return notify_fail("「总诀式」不能在战斗中演练。\n");
 
	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "sword")
		return notify_fail("你必须先去找一把剑。\n");

	if( !skill || (skill < 40))
		return notify_fail("你的玉女素心剑法等级不够, 不能用总诀式练剑法！\n");

	if( me->query("neili") < (int)me->query("max_neili")/80)
		return notify_fail("你的内力不够，没有力气练玉女素心剑！\n");
 
	if( me->query("qi") < me->query("max_qi")/50)
		return notify_fail("你现在太累了，没有力气练玉女素心剑！\n");
	if((int)me->query_skill("yunu-xinfa",1)<(int)me->query_skill("yunu-jianfa",1))
		return notify_fail("你的玉女心法修为不足以练玉女素心剑法了。\n");	

	msg = HIC "$N"HIC"默想剑法，身随意走，剑随心出，将手中" + weapon->name() + "舞出条条寒光，演练了一套"HIY"玉女素心剑法"NOR"。\n";
	message_vision(msg, me);

	me->add("neili", -(int)me->query("max_neili")/80);
	me->add("qi",- me->query("max_qi")/50);
	me->improve_skill("yunu-jianfa", ((int)me->query_skill("yunu-jianfa",1)+((int)me->query_skill("yunu-jianfa",1)/2)));

	msg = YEL"$P的「玉女素心剑法」进步了！\n"NOR;
	me->start_busy(random(2));
	message_vision(msg, me);

	return 1;
}
