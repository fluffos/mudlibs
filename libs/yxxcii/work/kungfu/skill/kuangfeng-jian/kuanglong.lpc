// kuanglong.c 狂龙八剑

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
 
int perform(object me, object target)
{
	object weapon, ob;
	string msg, string1;
	int count;
 
	if( !me->is_fighting() )
		return notify_fail("「狂龙八剑」只能在战斗中使用。\n");

	if (!objectp(weapon = me->query_temp("weapon"))
		|| (string)weapon->query("skill_type") != "sword")
			return notify_fail("你使用的武器不对。\n");

	if((int)me->query_dex() < 30)
		return notify_fail("你的身法不够, 目前还不能使用这项绝技！\n");

	if((int)me->query_skill("force",1) < 200)
		return notify_fail("你的内力修为不够, 不能使用这一绝技！\n");

	if((int)me->query_skill("dodge") < 200)
		return notify_fail("你的轻功修为不够, 不能使用狂龙八剑！\n");
 
	if((int)me->query_skill("sword") < 200)
		return notify_fail("你的剑法修为不够， 目前不能使用狂龙八剑！\n");

	if( (int)me->query("neili") < me->query("max_neili")/ 10)
		return notify_fail("你的真气不够！\n");


	msg = HIG "$N使出狂风剑法的绝技「狂风快剑」，剑法陡然加快！\n" NOR;
	me->clean_up_enemy();
	ob = me->select_opponent();
	message_vision(msg, me);
	
	COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
	msg = BLINK + HIG "风！\n" NOR;
	message_vision(msg, me);
	COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
	msg = BLINK + HIR "起！\n" NOR;
	message_vision(msg, me);	
	COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
	msg = BLINK + HIC "云！\n" NOR;
	message_vision(msg, me);	
	COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
	msg = BLINK + HIB "涌！\n" NOR;
	message_vision(msg, me);	
	COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
	msg = BLINK + HIY "无！\n" NOR;
	message_vision(msg, me);	
	COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
	msg = BLINK + HIM "风！\n" NOR;
	message_vision(msg, me);	
	COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
	msg = BLINK + HIM "起！\n" NOR;
	message_vision(msg, me);	
	COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
	msg = BLINK + HIW "浪！\n" NOR;
	message_vision(msg, me);
	COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
	msg =HIR"
     #    #          
      #   #########  
       # #    #            
	#     #            
       ##     #            
      #  #    #            
     #   #    #            
	## ########        
       # #    #            
      #  #    #            
     #   #    #            
	 #    #            
	 #    #            
	#     #            
      # # ##########       
       #                   


	   #               
	   #  #            
	   #   #           
	   #   #           
      ##############       
	   # #        
	   # #  #     
	   # #  #     
	  #  # #      
	  #  ##       
	 #   #        
	 #  ##        
	#  # #     #  
       #     #     #  
      #       ######  
\n"NOR;
      message_vision(msg, me);
      
	me->add("neili", -(int)me->query("max_neili") / 10);
	me->start_busy(4);

	return 1;
}