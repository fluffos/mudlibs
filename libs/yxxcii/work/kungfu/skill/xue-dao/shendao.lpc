// shendao.c  血刀「祭血神刀」

#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target)
{
	int damage;
	string msg,limb,*limbs,limb1,*limbss;
	object weapon;
	
	if (!target ) target = offensive_target(me);
	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "blade")
		return notify_fail(RED"必须装备刀才能使用「祭血神刀」！\n"NOR);
	if (!target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「祭血神刀」只能对战斗中的对手使用。\n");
	if ((int)me->query_skill("xue-dao", 1) < 120 )
		return notify_fail(WHT"你血刀刀法不够娴熟，使不出「祭血神刀」。\n"NOR);
	if ((int)me->query_skill("xuehai-mogong", 1) < 120 )
		return notify_fail(RED"你血海魔功火候不够，使不出「祭血神刀」。\n"NOR);
	if ((int)me->query("max_neili") < 1000)
		return notify_fail(RED"你的内力修为不足，无法运用内力来发挥「祭血神刀」。\n"NOR);
	if ((int)me->query("neili") < ((int)me->query("max_neili")/10))
		return notify_fail(RED"你的内力不够了。\n"NOR);
	if ((int)me->query("shen") > 0)
		return notify_fail("血海魔功需要以负神来发挥它的伤害力。\n");
		
	if ((int)me->query("neili") < 600)
	{
	return notify_fail(HIC"你现在内力不够，没能将「祭血神刀」使完！\n"NOR);
	}
	limbs = target->query("limbs");
	limb = limbs[random(sizeof(limbs))];
	msg = HIC"\n$N右手持刀向左肩一勒，一阵血珠溅满刀面，紧接着右臂抡出......"HIR"\n\n一道刀光划出，一片血光裹住刀影向$n"+ limb +"劈去。\n"NOR;
	if ( random(me->query("combat_exp")) > (int)target->query("combat_exp")/5 )
	{
	damage = random((int)(me->query("shen")/-30000));
	me->add("neili", -((int)me->query("max_neili") / 10));
	me->add("qi",(int)me->query("max_qi")/ 50);
	me->start_busy(random(4));
	limbss = me->query("limbs");
	limb1 = limbss[random(sizeof(limbss))];
	target->start_busy(random(2));
	target->add("qi", - damage/2);
	msg += HIR"\n$n急忙侧身避让，但血刀疾闪，只觉眼前一阵血红，刀刃劈面而下....\n\n只见$n"+ limb +"一道血口划开，鲜血溅在$N的"+ limb1+"，$n惨声大嚎！\n"NOR;
	} else
	{
	me->start_busy(random(3));
	me->receive_wound("qi", me->query("qi")/20);
	msg += HIY"\n可是$n侧身避让，不慌不忙，躲过了$N的一记「祭血神刀」。\n"NOR;
	me->add("neili", -((int)me->query("max_neili") / 80));
	}
	message_vision(msg, me, target);
	return 1;
  }

