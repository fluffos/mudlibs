// item: /d/city/obj/fire.c
// by RORO@YXXZ 1999

inherit ITEM;
#include <ansi.h>;
int do_dian(string arg);
void fire_over(object);

void create() {
  set_name("灯笼", ({ "deng long" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是用于夜晚照路的灯笼，到了晚上就可以点(dian)着了。\n");
    set("unit", "支");
    set("value", 100);
    setup();
  }
}
void init() {
  add_action("do_dian", "dian");
}
int do_dian(string arg) {
  object me;
  int time;
  me = this_player();
  time = 60;

  if (!arg || arg == "") return notify_fail("你要点着什么？\n");
  if (!present("deng long", me)) return notify_fail("你要点着什么？\n");
  if (arg == "deng long") {
    tell_object(me,
      HIY "你点燃了灯笼，一蓬火光一闪，四周顿时亮了起来。。\n" NOR
    );
    me->set_temp("fire", 1);

    call_out("fire_over", time, me);

    return 1;
  }
}
void fire_over(object ob) {
  tell_object(ob, HIY "一阵风吹过，你手中的灯笼被吹灭了! \n" NOR);
  ob->set_temp("fire", 0);
  destruct(this_object());
}
