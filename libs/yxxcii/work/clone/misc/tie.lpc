// transite.c
#include <ansi.h>
inherit ITEM;

void create()
{
        set_name("铁锨", ({ "tie xian", "tie","xian"}) );
        set_weight(2000);
        set("long", @LONG
这是一把铁锨，你可以用它来挖地道。
LONG
  );
        set("unit", "把");
        set("value",9900);
        set("material", "iron");
}
void init()
{
        add_action("do_wa", "wa");
}

int do_wa(string arg)
{
	string obj;
	if(!arg) return notify_fail("指令格式：wa here \n");
	if(!environment(this_player())->query("outdoors"))
		return notify_fail("你不能在这里挖地道！\n");
	if( present("biao yin",this_player()))
	return notify_fail("你身上带着镖银，无法挖地道！\n"); 		
	if( this_player()->is_busy()) return notify_fail("你正忙着呢！\n");
	if( this_player()->is_fighting()) return notify_fail("一心不能二用，打完再说吧！\n");
	if( arg == "here" && this_object()->query("use_times") > random(10) ) {
	tell_object(this_player(),"铁锨已经断了，不能再用了。\n");
	destruct(this_object());
	return 1;
}
	else {
	message_vision(HIC"$N从身后拿出一把大铁锨，在地面上挖个洞钻了进去。\n"NOR,this_player());
	this_player()->move("/clone/misc/floor");
	this_object()->add("use_times",1);
	return 1;
	}
}
	
