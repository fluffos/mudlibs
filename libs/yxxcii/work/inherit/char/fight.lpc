inherit NPC;
int init()
{
        set("fight_npc",1);
}
int accept_fight(object ob)
{
        object me;
        mapping hp_status, skill_status, map_status, prepare_status;
        string *sname, *mname, *pname;
        int i, temp;
        me = this_object();
        
        if (is_fighting()) return 0;

        if (me->query("damaged"))
                return notify_fail("这个"+ me->query("name") +"受伤太重了！\n");   

        if (random(me->query("fight_times")) >= 10) {
                me->set("damaged", 1);
                return notify_fail("这个"+ me->query("name") +"受伤太重了！\n");   
        }

        if (me->query_temp("last_fighter") == ob->query("id"))
                return notify_fail("你刚跟"+ me->query("name") +"练过功！\n");         

        me->set_temp("last_fighter", ob->query("id"));
        me->add_temp("fight_times", 1);
        me->set_temp("fighter_id",ob->query("id"));
        remove_call_out("renewing");    
        call_out("renewing", 200 + random(300), me);    

/* delete and copy skills */

        if ( mapp(skill_status = me->query_skills()) ) {
                skill_status = me->query_skills();
                sname  = keys(skill_status);

                temp = sizeof(skill_status);
                for(i=0; i<temp; i++) {
                        me->delete_skill(sname[i]);
                }
        }

        if ( mapp(skill_status = ob->query_skills()) ) {
                skill_status = ob->query_skills();
                sname  = keys(skill_status);

                for(i=0; i<sizeof(skill_status); i++) {
                        me->set_skill(sname[i], skill_status[sname[i]]);
                }
        }
        
/* delete and copy skill maps */

        if ( mapp(map_status = me->query_skill_map()) ) {
                mname  = keys(map_status);

                temp = sizeof(map_status);
                for(i=0; i<temp; i++) {
                        me->map_skill(mname[i]);
                }
        }

        if ( mapp(map_status = ob->query_skill_map()) ) {
                mname  = keys(map_status);

                for(i=0; i<sizeof(map_status); i++) {
                        me->map_skill(mname[i], map_status[mname[i]]);
                }
        }
        
/* delete and copy skill prepares */

        if ( mapp(prepare_status = me->query_skill_prepare()) ) {
                pname  = keys(prepare_status);

                temp = sizeof(prepare_status);
                for(i=0; i<temp; i++) {
                        me->prepare_skill(pname[i]);
                }
        }

        if ( mapp(prepare_status = ob->query_skill_prepare()) ) {
                pname  = keys(prepare_status);

                for(i=0; i<sizeof(prepare_status); i++) {
                        me->prepare_skill(pname[i], prepare_status[pname[i]]);
                }
        }
        
        hp_status = ob->query_entire_dbase();

                me->set("str", hp_status["str"]);
                me->set("int", hp_status["int"]);
                me->set("con", hp_status["con"]);
                me->set("kar", hp_status["kar"]);
		me->set("dex", hp_status["dex"]);
		
                
                me->set("max_qi",    hp_status["max_qi"]*3);
                me->set("eff_qi",    hp_status["eff_qi"]*3);
                me->set("max_jing",  hp_status["max_jing"]*2);
                me->set("eff_jing",  hp_status["eff_jing"]*2);
                me->set("qi",        hp_status["qi"]*3);
                me->set("jing",      hp_status["jing"]*2);
                me->set("max_jingli",hp_status["max_jingli"]);
                me->set("eff_jingli",hp_status["eff_jingli"]);
                me->set("jingli",    hp_status["jingli"]*2);
                me->set("max_neili", hp_status["max_neili"]);
                me->set("neili",     hp_status["neili"]);
                me->set("combat_exp",hp_status["combat_exp"]);

        return 1;
}


void renewing(object me)
{
	if(me->is_fighting()){
	remove_call_out("renewing");
	call_out("renewing",400,me);	
	}
	else  {
        me->delete_temp("last_fighter");
        }
}

int accept_kill(object ob)
{
        return accept_fight( ob );
}
int accept_hit(object ob)
{
        return accept_fight( ob );
}

