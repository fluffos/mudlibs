// staff.c 
#include <weapon.h>

inherit STAFF;

void create() {
  set_name("铁杖", ({ "staff" }));
  set_weight(7000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("long", "这是一根铁杖");
    set("value", 300);
    set("material", "iron");
  }
  init_staff(10);

  set("wield_msg", "$N把$n紧紧地握在手中。\n");
  set("unwield_msg", "$N松开了手中的$n。\n");

  // The setup() is required.

  setup();
}
