#include <ansi.h>
#include <weapon.h>
inherit FORK;
void create() {
  set_name("钢叉", ({ "fork" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一把尖利的钢叉。\n");
    set("unit", "把");
    set("wield_msg", "$N抽出一把$n，握在手中。\n");
    set("unwield_msg", "$N放下手中的$n。\n");


    set("material", "steel");
  }
  init_fork(30);
  setup();
}
