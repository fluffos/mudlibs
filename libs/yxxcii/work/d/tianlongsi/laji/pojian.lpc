
// duanjian.c 断了的长剑
// xueer

inherit ITEM;

void init();
void create()
{
	object me;
	string name,new_name;
	me=this_player();
	name = me->query("id")+"_duanjian";
	set_name("断了的长剑", ({"duan jian",name}));
	set_weight(40);
	set("unit", "把");
	new_name = me->query("name")+"要清扫的东西";
	set("long", "这是一把被折断的长剑, 它是"+new_name+"。\n");
	set("no_get",1);
//	  set("value", 10);
	setup();
}