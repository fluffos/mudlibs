// liumang.c 监工

inherit NPC;

string ask_me();
string pay();

void create() {
  set_name("监工", ({ "jian gong", "jiangong" }));
  set("gender", "男性");
  set("age", 19);
  set("long", "他是一个监工，负责主管房屋的修建。\n");

  set("combat_exp", 1000);
  set("shen_type", -1);

  set("attitude", "peaceful");

  set_skill("unarmed", 20);
  set_skill("dodge", 20);
  set_temp("apply/attack", 10);
  set_temp("apply/defense", 10);
  set("inquiry", ([
    "job": (: ask_me :),
    "work": (: ask_me :),
    "pay": (: pay :),

  ]));

  set_temp("times", 500);
  setup();
  carry_object("/clone/misc/cloth")->wear();
  add_money("silver", 2);
}

string ask_me() {
  object me = this_player();
  if (query_temp("times") == 0)
    return "今天的活干完了，明天再来吧！";
  if (me->query_temp("打工"))
    return "你不是接了活了吗?快些干吧!";
  command("xixi " + me->query("id"));
  me->set_temp("打工", 1);
  add_temp("times", -1);
  return "我正好有活给你干,快些做吧.";
}
string pay() {
  object ob, me = this_player();

  if (!me->query_temp("打工/pay")) {
    command("sneer");
    return this_player()->name() + " ,你活还没做完就想要钱?";
  }

  me->receive_damage("qi", 20 + random(40));
  ob = new("/clone/money/silver");
  ob->set_amount(1 + random(10));
  ob->move(this_object());
  command("smile" + me->query("id"));
  command("give silver to " + me->query("id"));
  me->delete_temp("doing");
  me->delete_temp("打工");
  return "你工作的不错呀，这是你的酬劳.";
}
