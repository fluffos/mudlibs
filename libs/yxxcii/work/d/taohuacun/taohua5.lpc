
// chufang.c 打工

inherit ROOM;
#include <ansi.h>
int do_da(string arg);

void create()
{
	set("short", "桃花坪");
	set("long", @LONG
桃花坪是个小盆地。此处四面环山，山间白云缭绕，山上桃林
层叠，如列屏障。中有小溪潺潺流过，清澈碧透。春鸟娇鸣，游鱼
踊跃，春岚气动，景象万千。坪中大大小小琉瓦别墅，山野之中诸
多风味。一个牌子(paizi)
LONG
	);
	set("no_fight", "1");
	set("no_steal", "1");
	set("no_beg",   "1");
	set("no_yun", "1");


	set("exits", ([
		"south"	 : __DIR__"taohua4",

	]));
	set("item_desc", ([
		"paizi": "招收建房工人，待遇从优。\n"
	]) );
	set("objects" , ([
		__DIR__"npc/jiangong" : 1,
	]));
	setup();
}

void init()
{
	add_action("do_da","da");
}

int do_da(string arg)
{
	object me=this_player();
	object ob;
	
	if (!me->query_temp("打工"))
		return notify_fail("你别多事了.\n");

	if (!arg || arg != "工")
		return notify_fail("别乱做，弄坏了算谁的。\n");
		
	if (me->query_temp("doing"))
		return notify_fail("你正在干活呢? \n");

	if(present("jiangong", environment(me)) && living(present("jiangong", environment(me))))
	{
	if ( (int)me->query("qi")<50)
		return notify_fail("你的精力不够了，休息一会儿再做吧。\n");

	message_vision("$N加入到民工队伍，卖力干起活来。\n",me);
	me->set_temp("doing",1);
	me->start_busy(10);
	call_out("do_work1",5,me);
	return 1;
	}
	else
		return notify_fail("老板都不见了，你为谁白干啊？\n");
}

int do_work1(object me)
{
	message_vision(CYN"嘿哟嘿,$N擦擦头上的汗水,又继续卖力的干活.\n"NOR,me);
	call_out("do_work2",5,me);
	return 1;
}
	
int do_work2(object me)
{
	  message_vision("$N长长的舒了一气,终于干完了。\n",me);
	  tell_object(me,"活干完了,快点找监工要钱吧.\n");
	me->set_temp("打工/pay",1);
	  return 1;
}

