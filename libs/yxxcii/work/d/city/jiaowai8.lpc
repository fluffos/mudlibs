#include <room.h>
inherit ROOM;

void create()
{
	set("short", "草地");
	set("long", @LONG
这是扬州郊外的一片芳草地，落英缤纷，蜂歌蝶舞，朝露夕光，沁人
心脾。呼朋唤友开怀欢乐正其时。
LONG );
	set("exits", ([
		"east" : __DIR__"nanmen",
		"west" : __DIR__"jiaowai9",
	]));

	set("outdoors", "yangzhou");
	setup();
	replace_program(ROOM);
}
