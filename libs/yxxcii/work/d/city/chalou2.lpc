inherit CHAT_ROOM;

void create() {
  set("short", "凝香楼二楼");
  set("long", @LONG
这是「凝香楼」二楼的走廊，可以通往凝香楼的雅间。从走廊一直望
去，可以看见一排整齐的房门，房门上还挂着牌子。这里是凝香楼的老板
为客人们提供的静区，不时可以看见有几个客人进进出出。
LONG
  );

  set("chat_room", 1);
  set("no_sleep_room", 1);
  set("no_fight", 1);
  set("no_bag", 1);
  set("no_kill", 1);

  set("exits", ([
    "down": __DIR__ "chalou",
    "1": __DIR__ "chat_room_1",
    "2": __DIR__ "chat_room_2",
    "3": __DIR__ "chat_room_3",

  ]));
  ::create();
  replace_program(ROOM);

}
