// wineskin.c  女儿红

inherit ITEM;
inherit F_LIQUID;



void create() {
  set_name("女儿红", ({ "nuerhong", "erhong", "hong" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一坛三十年的女儿红。\n");
    set("unit", "坛");
    set("value", 5000);
    set("max_liquid", 15);
  }

  // because a container can contain different liquid
  // we set it to contain wine at the beginning
  set("liquid", ([
    "type": "jiu",
    "name": "酒",
    "remaining": 90,
    "drunk_apply": 300,
  ]));
}
