#include <ansi.h>

inherit NPC;

void create()
{
	set_name("收破烂的", ({ "po lan" }));

	set("long", @LONG
他是一个靠收破烂为生的人。
LONG
	);

	set("attitude", "friendly");
	set("gender", "男性" );
	set("age", 48);
	set("str",1000);  //特地加大力量，有时候会背负很多的东西。

	set("combat_exp", 300);
	set("SEN",1);

	set("chat_chance", 120);
	set("chat_msg", ({
		(: command, "get all" :),
		(: random_move :)
	}) );

	setup();

	carry_object("/clone/cloth/cloth")->wear();
	add_money("coin", 50);

}

int accept_object(object me, object obj)
{
	command("smile");
	command("say 多谢这位" + RANK_D->query_respect(me) + "！");
	return 1;
}

int accept_fight(object me)
{
	command("say " + RANK_D->query_respect(me) + "饶命！小的这就离开！\n");
	return 0;
}
