#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
	  set("short", "忘尘居");
	  set("long",@LONG
这里是“忘尘居”，是名与春泥格格小俩口的家。家具摆设雅致舒适
，四处遍植各色奇花异草，花团锦簇，满室生香。光线自玻璃屋顶投射进
来，五彩斑烂，炫丽异常，令人恍如置身仙境。右首一张大床，床头置有
七色锦缎一床，绣金鸳鸯枕一对。正中墙上书有四行大字：

		菩提本无树
		明镜亦非台
		本来无一物
		何处染尘埃

字迹瘦劲挺拔，清峻遒美，充满奇逸之气，令人叹为观止。
);
	set("exits", ([ 
		"west" : __DIR__"jiaowai1",
		"south": "/u/java/room/house",
	]));
	set("valid_startroom","1");

	set("no_fight", 1);
	set("sleep_room", 1);
	setup();
	create_door("west", "垂花小门", "east", DOOR_CLOSED);
}
int valid_leave(object me, string dir)
{
	if (dir=="south")
	return notify_fail(GRN"那是人家女孩子的书房，看看就别进去了。\n"NOR);
	return ::valid_leave(me, dir);
}		   

