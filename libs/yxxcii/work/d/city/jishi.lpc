#include <ansi.h>
#include <room.h>
#include <login.h>

inherit ROOM;

string look_sign();

void create() {
  set("short", "集市");
  set("long", @LONG
这里是扬州城集市。满街的店铺都挂着一团团、一簇簇的羊角风灯。
一声接一声的叫卖声在各个街口、小巷深处此呼彼应，连绵不绝。集市的
入口处，挂着一块牌子(sign)。
LONG
  );

  set("outdoors", "city");
  set("item_desc", ([
    "sign": @TEXT
在这里你可以做下面的事情。

join        开展生意

TEXT
  ]));

  set("exits", ([
    "west": __DIR__ "beimen",
  ]));

  setup();
}

void init() {
  add_action("do_join", "join");
}

int do_join(string arg) {
  string *name = ({ "私盐", "水果", "食品", "陈酒", "鲜花", "草药", "煤炭", "古董", "珠宝", "玉器",
    "字画", "木材", "竹器", "武器", "铁器", "农具", "马匹", "布匹", "瓷器", "杂货" });
  object me;
  string tempstr, namestr;

  me = this_player();

  if (me->query_temp("working") == 1) return notify_fail("你已经在贩卖当中了！\n");
  if (me->is_fighting()) return notify_fail("边打架边卖东西？！神了 ！\n");
  if (me->query("qi") < 10) return notify_fail("健康才是革命的本钱，休息一下吧！\n");
  if (me->query("jing") < 10) return notify_fail("健康才是革命的本钱，休息一下吧！\n");

  namestr = name[random(sizeof(name))];
  tempstr = "$N开始贩卖" + namestr + "....\n";
  message_vision(tempstr, me);
  me->set_temp("working", 1);
  call_out("compelete_join", 4, me);
  return 1;
}

private void compelete_join(object me) {
  object ob;
  int i, n;

  me->delete_temp("working");

  if (me->query("per") < random(10) + random(15) + 10) {
    message_vision("$N只顾着招呼客人，东西卖出去，却忘了收钱……\n", me);
    return;

  }

  if (me->query("kar") < random(10) + random(15) + 5) {
    message_vision("客人很多，$N忙得透不过气来，被小偷光顾……\n", me);
    message_vision("白忙了一场，$N却毫无所获！！\n", me);
    return;

  }

  if (present(me)) {
    message_vision("$N开展生意，人虽然累坏了，但是收益不小。\n", me);
    n = random(10 * me->query("per")) / 10;
    for (i = 0; i < n; i++) {
      ob = new("/clone/money/silver.lpc");
      ob->move(me);
    }
    tell_object(me, sprintf("你赚到%s两银子。\n", chinese_number(n)));
    me->add("qi", -n);
    me->add("jing", -n);
    me->add_temp("seller", 1);
  }

  return;

}
