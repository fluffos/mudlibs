// shulin12.c
// longhao 3/12/1999
#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "树林");
        set("long", @LONG
这位於终南山间的一大片树林，生的颇为茂密。走在其间，只听
得脚下沙沙的落叶声，四周昏昏暗暗的，不时几道日光穿过浓密的枝
头，投射而下。偶而远处几声兽吼声，更添了一份神密感。这儿也是
全真教道士经常采药的地方，往北、南各有一条小径。
LONG
        );
        set("outdoors", "gumu");
        set("exits", ([
        
            "northdown" :__DIR__"shandao3",
           "southup"  :__DIR__"shulin11",
        ]));
        set("objects", ([
          "/d/wudang/npc/monkey":1,
        ]));
        setup();
}
void init()
{
        add_action("do_bo", "bo");
        }

int do_bo(string arg)
{
        object ob, me;
        mapping fam;
        int i, kar, cps;
        ob = present("yaochu",this_player());
        me = this_player();
         
        if(me->is_busy()) return notify_fail("你正忙着呢！！\n");      
        
        if(!present("yaochu",me))
        return notify_fail("没有药锄你怎么拔开杂草呀？\n你用手吗？\n");        
        
        if (!(fam = this_player()->query("family")) || fam["family_name"] != "全真教")
                return message_vision(HIG"           $N不是本教弟子,怎么会采药呢！\n"NOR, me);
        
        if(me->query("neili")<100)
                 return notify_fail(HIR"你太累了，该休息一下啦。\n"NOR);

        message_vision(HIC"$N用药锄轻轻地拔动着树林中的杂草，希望能找到草药！\n"NOR, me);
        call_out("boing", random(2), me );

        kar = me->query("kar");
        cps = me->query("cps");
        if ( kar > 10+random(1000)) {
                switch (random(3)){   
                case 0:
                message_vision(HIG"$N挥动着药锄非常卖力地拔开着杂草，可惜什么也没有发现！\n"NOR, me);
                me->start_busy(3);
                //ob=new("/d/wudang/npc/mengmian.lpc");
                //ob->move(environment(me));
                me->add("neili",random(25) - 60);
                break;
                case 1:
                message_vision("树草丛中藏着一条毒蛇，突然向$N冲了过来。\n",me);
                me->start_busy(3);
                ob=new("/d/quanzhen/job/snake.lpc");
                ob->move(environment(me));   
                me->add("neili",random(25) - 60);
                break;
                case 2:
                message_vision("突然一朵与众不同的花出现在$N面前，原来$N发现了"HIY"金银花"NOR"!\n",me);
                me->start_busy(3);
                ob=new("/d/quanzhen/job/hua.lpc");
                ob->move(this_player());
                me->add("neili",-random(25) - 60);
                me->add("combat_exp",random(15) + 15);
                me->add("potential",random(15) + 10);
                break;            
                }
           }
                else {
                switch (random(6)){  
                case 0:
                message_vision("原来里面什么都没有，看来$N是白忙了一场。\n",me);
                me->start_busy(3);
                me->add("neili",-100);
                break;
                case 1:
                message_vision("只见杂草中"WHT"生地"NOR"被$N用药锄挖了出来。\n\n", me);
                ob=new("/d/quanzhen/job/shengdi.lpc");
                ob->move(this_player());
                me->start_busy(3);
                me->add("neili",-random(25) - 60);
                me->add("combat_exp",30);
                me->add("potential",30);
                break;
                case 2:
                message_vision(RED"$N一不小心，从一块石头上摔了下来，浑身受了点轻伤！\n"NOR,me);
                me->start_busy(3);
                me->add("qi",-20);
                me->add("neili",-100);
                break;
                case 3:
                message_vision("$N突然发现"HIW"何首乌"NOR"被$N用药锄给锄了出来。\n\n",me);
                ob=new("/d/quanzhen/job/heshouwu.lpc");
                me->start_busy(3);
                ob->move(this_player());
                me->add("neili",-random(25) - 60);
                me->add("combat_exp",30);
                me->add("potential",30);
                break;
                case 4:
                message_vision(RED"只听见“啪”的一声，你一不小心把药锄锄到了石头上，药锄断了。\n"NOR,me);
                destruct(ob);
                me->start_busy(3);
                me->add("neili",-100);
                break;   
                case 5:
                message_vision("看来你的运气真是好背啊，什么也没有找到！\n",me);
                //ob=new("/d/quanzhen/job/xiaobaozi.lpc");
                //ob->move(environment(me));
                me->start_busy(3);
                me->add("neili",-random(25) - 60);
                break;                                             
                }
          }
          me->receive_damage("qi", 10); 
          return 1;
}
       
