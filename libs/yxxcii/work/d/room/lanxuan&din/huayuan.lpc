inherit ROOM;

void create() {
  set("short", "花园");
  set("long", @LONG
你才刚踏进来，就马上被吸引住了，这是兰铃小居的花园，
在这里花的种类多不胜数。粉红、天蓝、雪白、藏青等等，五
颜六色的花散发着迷人的芳香，小狗和小猫也能亲密的在玩耍，
追逐着花间的蝴蝶，蜜峰也在这里快乐的采着花蜜。你仿佛忘
却了世俗的烦恼，陶醉于此。
LONG
  );
  set("exits", ([
    "southeast": __DIR__ "lanling",
    "northwest": __DIR__ "liangong_room",
    "east": __DIR__ "dating",
    "north": __DIR__ "zoulang"

  ]));


  setup();
}
