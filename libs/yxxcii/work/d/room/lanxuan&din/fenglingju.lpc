inherit ROOM;

void create()
{
        set("short", "风铃居");
        set("long",@LONG
这是雨铃的闺房。
　　粉紫色的屏风后是雨铃的床(chuang)。窗口上挂着由雨铃
亲手做的风铃，墙上挂着一把装饰用的宝剑。右边摆着一张梳
妆台，台上放着一些女孩子用的小玩意。整个房间看起来好像
有点乱，但仔细看起来又乱中有序，或许这跟雨铃的个性有关
吧。
LONG
);
        set("exits", ([
            "out":__DIR__"zoulang",
        ]));
        set("objects", ([
                __DIR__"npc/puren":1,
        ]));	
        set("item_desc",([
        "chuang":@TEXT
这是张收拾得十分整齐的床。假如你要在这里休息，要先征得雨玲的同意哦！
TEXT
        ]));
        set("sleep_room",1);
setup(); 
}
