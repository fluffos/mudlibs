inherit ROOM;

void create()
{
        set("short", "练功房");
        set("long",@LONG
这里是兰铃小居的练功房。兰萱和雨铃就是在这里练功的。
诺大的一间房，只是在一旁摆放着兵器架，之外就什么都没有，
但又不会让人觉得太过空荡，可以看出她们平时练功很认真。
LONG
);
        set("exits", ([
            "southeast":__DIR__"huayuan",
            "east":__DIR__"zoulang",
            
        ]));

 
        setup();
}

