inherit ROOM;

void create()
{
        set("short", "大厅");
        set("long",@LONG
这是兰铃小居的大厅。前面是一张古香古色的大桌子，桌
子上摆放着花瓶，花瓶里插着早上刚刚摘的鲜花。整个房间充
满了花的气息和香味。墙上挂着一幅丹青画，画中人栩栩如生，
可想像得出这画画之人的造诣。桌子的左右各摆放着藤椅。
LONG
);
        set("exits", ([
            "west": __DIR__"huayuan",
            "east":__DIR__"book_room",
            "north":__DIR__"zoulang",
            "south":__DIR__"lanling",
                       
        ]));

        setup();
}
