inherit ROOM;

void create()
{
        set("short", "书房");
        set("long",@LONG
你走进了一间充满檀香味的房间，幽幽的清香飘散在空气之
中。房间的中间是一张大书桌，看样子起码可以容纳俩个人一起
读书。桌子上的文房四宝整齐的摆放着，左右各摆着两个长长大
书架。
LONG
);
        set("exits", ([
            "southwest":__DIR__"lanling",
            "west":__DIR__"dating",
            "northeast":__DIR__"chufang",
                      
        ]));

        setup();
}
