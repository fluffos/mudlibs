inherit ROOM;

void create()
{
        set("short", "幽兰居");
        set("long",@LONG
这是兰萱的闺房。
　　粉红色的屏障后面是兰萱的床(chuang)。墙上挂着兰萱亲手
缝的小布娃娃，左边摆着一张梳妆台，台上左角放着一瓶还滴着
露珠的兰花，右角放着一把梳子。整个房间收拾得整整齐齐的，
女孩子的房间嘛，到底不比男孩子。
LONG
);
        set("exits", ([
            "out":__DIR__"zoulang",
           ]));
        set("objects",([
                __DIR__"npc/puren2":1,
           ]));
        set("item_desc",([
        "chuang":@TEXT
这是张收拾得十分整齐的床。假如你要在这里休息，要先征得兰萱的同意哦！
TEXT
           ]));
        set("sleep_room",1);
    	
        setup();
}
