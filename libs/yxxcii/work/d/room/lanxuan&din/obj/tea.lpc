// tea.c 奶茶
#include <ansi.h>

inherit ITEM;
inherit F_LIQUID;

void create()
{
	set_name(HIW"珍珠奶茶"NOR, ({"tea", "naicha"}));
	set_weight(10);
        set("no_drop","请讲文明，不要随地乱扔垃圾，喝不完的，可以留到下次嘛。\n\n");
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "一杯香喷喷的奶茶。\n");
		set("unit", "杯");
		set("value", 0);
		set("max_liquid", 15);
	}

	set("liquid", ([
		"name": "奶茶",
		"remaining": 15,
		"drunk_apply": 10,
	]));
}