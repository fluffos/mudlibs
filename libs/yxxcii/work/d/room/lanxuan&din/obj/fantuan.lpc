// fantuan.c 玫瑰饭团
// Written by Jonak

#include <ansi.h>

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name(HIR"玫瑰饭团"NOR, ({"fantuan", "fan"}));
	set_weight(10);
        set("no_drop","请讲文明，不要随地乱扔垃圾，吃不完可以留到下次嘛。\n\n");
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "一个香喷喷的饭团，看到就令人食指大动了。\n");
		set("unit", "个");
		set("value", 0);
		set("food_remaining", 10);
		set("food_supply", 30);
	}
}