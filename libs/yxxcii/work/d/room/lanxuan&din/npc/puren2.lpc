#include <ansi.h>
inherit NPC;

string ask_puren();

void create() {
  set_name("仆人", ({ "pu ren", "ren" }));
  set("long",
    "这是一个专门服侍兰萱的仆人。\n");
  set("gender", "女性");
  set("age", 16);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 10);
  set("int", 10);
  set("con", 10);
  set("dex", 10);
  set("max_qi", 100);
  set("max_jing", 100);
  set("combat_exp", 100);
  set("score", 100);

  setup();

}
