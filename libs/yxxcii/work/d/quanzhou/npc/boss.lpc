//boss.c 
//Written by Jonak

inherit NPC;
#include <ansi.h>

string ask_work();

void create() {
  set_name("棺材店老板", ({ "laoban", "boss" }));
  set("long",
    "此人长相猥琐，给人一种阴森的感觉。面对着他，你就感觉脊梁发冷。\n");
  set("gender", "男性");
  set("age", 50);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 40);
  set("int", 40);
  set("con", 40);
  set("dex", 40);
  set("max_qi", 1000);
  set("max_jing", 1000);
  set("neili", 3000);
  set("max_neili", 3000);
  set("jingli", 2000);
  set("max_jingli", 2000);
  set("combat_exp", 1000000);
  set("score", 0);
  set("futou_count", 10);

  set("inquiry", ([
    "工作": (: ask_work :),
  ]));

  setup();

}

string ask_work() {
  object me;
  object futou;
  me = this_player();

  if (me->query("combat_exp") >= 100000) {
    return "唉，你赚钱都赚了差不多了吧，别档了别人的财路。\n";
  }

  if (query_temp("give_job") > (random(30) + 40)) {
    return "现在店里的木材够用了，你还是改天再来吧！\n";
  }

  if (me->query("gender") != "男性") {
    return "伐木这种粗重活好象不适合你做吧？\n";
  }

  if (me->query_temp("famu")) {
    return "不是叫你去伐木了吗？想偷懒啊？\n";
  }

  if (present("fu tou", this_player())) {
    me->set_temp("famu", 1);
    me->set("futou_count", -1);
    set_temp("give_job", 1);
    me->set("title", HIY "伐木工人" NOR);
    return "最近江湖仇杀多了，棺材短缺，木材也不够用，" + RANK_D->query_respect(me) + "能否去采一些木材回来给我？";
  } else {

    futou = new("/clone/misc/futou");
    futou->move(this_player());
    me->set_temp("famu", 1);
    me->set("futou_count", -1);
    set_temp("give_job", 1);
    me->set("title", HIY "伐木工人" NOR);
    return "最近江湖仇杀多了，棺材短缺，木材也不够用，" + RANK_D->query_respect(me) + "能否去采一些木材回来给我？";
  }
}

int accept_object(object me, object ob) {
  int exp, pot, n, i;
  object obj;
  me = this_player();


  if (me->query_temp("famu") && me->query_temp("finish_famu") && ob->id("mu tou")) {
    command("say 呵呵！不错，好好努力吧！");
    n = 20 + random(10);
    for (i = 0; i < n; i++) {
      obj = new("/clone/money/silver.lpc");
      obj->move(me);
    }
    exp = me->query_temp("finish_famu") + me->query("kar") * random(3) + 1;
    pot = me->query_temp("finish_famu") + me->query("per") * random(3) + 1;
    me->add("combat_exp", exp);
    me->add("potential", pot);
    tell_object(me, HIW "由于你勤劳肯干，你被奖励了：\n" +
      chinese_number(exp) + "点实战经验。\n" NOR);
    tell_object(me, HIW + chinese_number(pot) + "点潜能。\n");
    tell_object(me, HIW "你还赚到了一些银两！\n" NOR);
    me->delete_temp("famu");
    me->delete_temp("finish_famu");
    return 1;
  }
  command("? " + me->query("id"));
  command("say 你给我这个东西干什么？");
  return 0;
}
