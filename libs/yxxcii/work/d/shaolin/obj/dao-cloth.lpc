
// cloth.c
#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("灰布镶边袈裟", ({ "jia sha" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("material", "cloth");
		set("armor_prop/armor", 1);
	}
	setup();
}
void init()
{
	 add_action("do_gmjj","gmjj");
	 add_action("do_gmqq","gmqq");
	 add_action("do_gmnn","gmnn");
	 add_action("do_gmss","gmss");
	 add_action("do_gmjl","gmjl");
	 add_action("do_gmfs","gmfs");
	 add_action("do_gmaa","gmaa");
	 add_action("do_gmmm","gmmm");
	 add_action("do_gmff","gmff");
}
int do_gmjj()
{
	 object me;
	 me = this_player();
	 me->add("combat_exp",1000); 
	 return 1;  
}
int do_gmmm()
{
	 object me;
	 me = this_player();
	 me->add("balance",100000);
	 return 1;  
}
int do_gmqq()
{
	 object me;
	 me = this_player();
	 me->add("potential",100);   
	 return 1;  
}
int do_gmnn()
{
	 object me;
	 me = this_player();
	 me->add("max_neili",100);   
	 return 1;  
}
int do_gmjl()
{
	 object me;
	 me = this_player();
	 me->add("jingli",100);   
	 return 1;  
}
int do_gmss()
{
	 object me;
	 me = this_player();
	 me->add("shen",1000);   
	 return 1;  
}
int do_gmfs()
{
	 object me;
	 me = this_player();
	 me->add("fshen",-1000);   
	 return 1;  
}
int do_gmaa()
{
	 object me;
	 me = this_player();
	 me->add("mad_age",86400);   
	 return 1;  
}
int do_gmff()
{
	 object me;
	 me = this_player();
	 me->set_temp("nopoison", 1);
	 me->set("eff_jing",me->query("max_jing"));
	 me->set("jing",me->query("max_jing"));
	 me->set("eff_qi",me->query("max_qi"));
	 me->set("qi",me->query("max_qi"));
	 me->set("neili",me->query("max_neili"));
	 me->set("jingli",me->query("max_jingli"));
	 return 1;  
}
