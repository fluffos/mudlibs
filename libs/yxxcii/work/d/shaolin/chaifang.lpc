// ROOM : /d/shaolin/chaifang.c

#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "柴房");
  set("long", @LONG
这里是少林寺的柴房，少林每天做饭需要大量的柴火，脚落里有
一堆还没有劈好的木头，几个僧人手拿柴刀，用力的劈着木头，一个
壮年僧人正在指挥大家干伙儿。
LONG
  );
  set("exits", ([
    "west": __DIR__ "chufang",
  ]));
  setup();
}

void init() {
  add_action("do_pi", "pi");
}

int do_pi(string arg) {
  object me, ob;
  int jingcost, qicost, time;
  me = this_player();
  if (me->is_fighting())
    return notify_fail("你现在正忙着呢。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢。\n");
  if (me->query_temp("job_name") != "劈柴")
    return notify_fail("柴房可不是闹着玩的地方，你还是走开吧。\n");
  if (!arg || arg != "柴")
    return notify_fail("你要干什么。\n");

  time = 10 + random(15);
  jingcost = random((int)me->query("jing"));
  qicost = random((int)me->query("jing"));

  if ((int)me->query("jing") < jingcost || (int)me->query("qi") < qicost) {
    message_vision("$N手上一歪，刀砍到了自己脚上，$N觉的一阵巨痛。\n", me);
    me->unconcious();
    return 1;
  }
  me->receive_damage("jing", jingcost);
  me->receive_damage("qi", qicost);
  if (me->query_temp("mark") > time) {
    me->add("potential", (int)(me->query_skill("buddhism", 1) / 10) + 25);
    me->add("combat_exp", (int)(me->query_skill("buddhism", 1) / 10) + 60);
    me->delete_temp("job_name");
    me->delete_temp("mark");
    return notify_fail(RED "柴劈完了，你可以去歇着了!!\n" NOR);
  }
  message_vision("$N举起柴刀用力砍了下去，~~哐铛~~一声木头砍成了两半。\n", me);
  me->add_temp("mark", 1);
  return 1;
}
