
#include <ansi.h>
#include <room.h>
#include <login.h>

inherit ROOM;

void create()
{
        set("short", "钓鱼台");
        set("long", @LONG
这里是汉水中下游，水流见缓。江边有一老翁身穿蓑衣，头带斗笠，
嘴含烟袋正悠闲自得的钓着鱼，哇！他身边已经掉了好几根大鱼了！
还发什么呆啊? 你旁边还放着几根钓鱼杆，快点钓(fish)吧。
LONG
        );
        set("outdoors", "center");
        set("exits", ([ 
		"west" : "/d/shaolin/matou1",
		"enter" : "/d/shaolin/diaoyuxuan",
        ]));

        set("no_fight", 1);
        set("no_magic",1);
        set("no_beg",1);

        setup();
}

void init()
{
        add_action("do_fish", "fish");
}

int do_fish(string arg)
{        
        object me;

        me = this_player();

        if(me->query_temp("fishing") == 1) return notify_fail("钓鱼要耐心一点嘛！\n");
	if(me->query("qi") < 30|| me->query("jing") < 30) return notify_fail("身体要紧，还是赶紧休息吧！\n");
 	if(me->query("combat_exp") >= 100000) return notify_fail("一把年纪了还学人家钓鱼涨经验？你要不要脸呀？\n");
 	
        message_vision("$N拿着一把钓鱼杆坐在大石头上钓起鱼来……\n",me);
        me->set_temp("fishing", 1);
        call_out( "compelete_fish", random(6), me );
        return 1;
}

void compelete_fish(object me)
{
        object ob;
	string badstr, namestr;
	string *name = ({HIR"红鳟鱼"NOR,"草鱼",HIR"大鲤鱼"NOR,HIR"大红鲤鱼"NOR,HIW"白鲳鱼"NOR,HIM"鲇鱼"NOR,HIY"鲤鱼"NOR,HIY"娃娃鱼"NOR});
        string *badname = ({HIC"一双破鞋"NOR,YEL"一件破烂不堪的衣服"NOR,YEL"一个扯烂了的鱼网"NOR,YEL"一顶破烂的斗笠"NOR,HIR"一件红色的肚兜"NOR,
			    RED"一只螃蟹"NOR,HIW+BLK"一个已经进水的灯笼"NOR,YEL"一个破烂的睡袋"NOR,HIW+BLK"一只乌龟"NOR}); 
        namestr = name[random(sizeof(name))];
        badstr = badname[random(sizeof(badname))];
	
        me->delete_temp("fishing");
	
	if( me->query("kar") < random(20)+10) {
		message_vision("$N猛的一提杆，仔细一看，钓到了"+ badstr+"。\n",me);
		tell_object(me,RED"你心里不禁骂道：%!#@$!#@，怎么今天那么背？！\n"NOR);
		me->add("qi",-random(10));
		me->add("jing",-random(10));
		return 1;
	}

	if( me->query("int") < random(20) +10) {
		message_vision("$N鱼漂晃动，$N心里一急，猛的一提杆，$N钓到了"+ badstr+"。\n",me);
		message_vision("$N无奈的看着那"+ badstr +"，眼睛立刻红了起来。\n",me);
		me->add("qi",-random(10));
		me->add("jing",-random(10));
		return 1;
	}
	if( namestr == "娃娃鱼") {
	        message_vision("$N得意的提起那条娃娃鱼，得意的说道：又是一个丰收的日子！\n",me);
	        me->add("qi",- 20);
	        me->add("jing", - 20);
	        me->add("combat_exp",30);
	        me->add("potential",30);
	        tell_object(me,HIC"你的经验增加了三十点。\n"NOR);
	        tell_object(me,HIC"你的潜能增加了三十点。\n"NOR);
	        return 1;
	}
	 
        if( present(me) ) {                     // 如果玩家还在原地
                message_vision("$N一提杆，钓到了一条"+ namestr +"。\n", me);
                me->add("qi", -random(20));
                me->add("jing", -random(20));
                me->add("combat_exp",random(20));
                me->add("potential",random(25));
                tell_object(me, "你的潜能和经验增加了！\n");
        }

        return;
}
