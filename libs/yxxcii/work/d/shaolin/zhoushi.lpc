// ROOM : /d/shaolin/aozhoushi.c

#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "粥室");
  set("long", @LONG
这里是少林寺的熬粥室，全寺弟子喝的粥都是从这里熬出来的，
屋子中央站着一个身体粗壮的僧人，他正在指挥一些和尚忙碌
的工作着，几个和尚倒吊在房梁上，手中各拿着一根大铁勺的
在一口大锅里来回的搅拌。
LONG
  );
  set("exits", ([
    "east": __DIR__ "chufang",
  ]));
  setup();
}

void init() {
  add_action("do_ao", "ao");
}

int do_ao(string arg) {
  object me, ob;
  int jingcost, qicost, time;
  me = this_player();
  if (me->is_fighting()) {
    write("你现在正忙着呢。\n"); return 1;
  }
  if (me->is_busy()) {
    write("你现在正忙着呢！\n"); return 1;
  }
  if (me->query_temp("job_name") != "熬粥")
    return notify_fail("厨房可不是闹着玩的地方，你还是走开吧。\n");
  if (!arg || arg != "粥")
    return notify_fail("你要干什么。\n");
  time = 10 + random(10);
  jingcost = random((int)me->query("jing"));
  qicost = random((int)me->query("jing"));

  if ((int)me->query("jing") < jingcost || (int)me->query("qi") < qicost) {
    message_vision("$N突然觉的后劲不续，手上一松，掉进了锅里\n", me);
    me->unconcious();
    return 1;
  }
  me->receive_damage("jing", me->query("jing") / 10);
  me->receive_damage("qi", me->query("qi") / 10);
  if (me->query_temp("mark") > time) {
    me->add("potential", (int)(me->query_skill("buddhism", 1) / 10) + 25);
    me->add("combat_exp", (int)(me->query_skill("buddhism", 1) / 10) + 60);
    me->delete_temp("job_name");
    me->delete_temp("mark");
    return notify_fail(RED "粥熬好了，你可以去歇着了！！\n" NOR);
  }
  message_vision("$N倒挂在房梁之上，努力的用手中的大铁勺搅着粥。\n", me);
  me->add_temp("mark", 1);
  return 1;
}
