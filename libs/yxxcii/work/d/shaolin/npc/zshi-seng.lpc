// NPC : /d/shaolin/npc/zshiseng.c

inherit NPC;
string ask_job();
void create()
{
        set_name("执事僧",({ "zhishi seng","zhishi","seng"}));
        set("gender","男性");
        set("age",30);
        set("no_get",1);
        set("long",@LONG
一个粗壮的僧人，一看就知道长年从事体力劳动！
少林寺的弟子们，都可以找他询问“厨房执事”。
LONG
);
	set_skill("force",300);
	set_skill("dodge",300);
	set_skill("unarmed",300);
	set_skill("parry",300);
	set("neili",30000);
	set("max_neili",30000);
        set("combat_exp",500000);
        set("attitude", "friendly");
        set("inquiry",([		
		"厨房执事": (: ask_job :),
		"job":	    (: ask_job :),
	]));

        setup();
}



string ask_job()
{
	mapping fam;
        object ob;
        int i;
        ob=this_player();
	if( ob->query("family/family_name") != "少林派" )
		return RANK_D->query_respect(this_player()) + "与本派素无来往，不知此话从何谈起？";
        
        if((string)ob->query("class") != "bonze")
        	return "俗家弟子不能在这里领任务。\n";
        if(ob->query_temp("job_name"))
        	return "你不是已经领了任务了吗，还不快去做！\n";
        if(this_object()->query_temp("give_job") > 50)
        	return "今天的活已经干得差不多了，你明天再来吧！\n";
        i = random(10);
        
        if( i <= 1)
        {	
        	this_object()->add_temp("give_job",-1);
        	return "我想想看现在还有什么事情给你们做的吧！\n";
        }
        
        if( i > 5 )
        {
                ob->set_temp("job_name", "熬粥");
                this_object()->add_temp("give_job",1);
                return("好吧，你去粥室帮我熬(ao)粥去吧！\n");
                
        }
        if( i < 5)
        {
                ob->set_temp("job_name","劈柴");
                this_object()->add_temp("give_job",1);
                return("好吧，厨房现在缺柴火，你去柴房去劈(pi)点木头吧！\n");
        }
        


}

