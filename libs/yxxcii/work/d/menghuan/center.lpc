#include <room.h>

inherit ROOM;
void create() {
  set("short", "十字广场");
  set("long", @LONG
这里是大理城的十字广场，街道上人来人往，络绎不绝。东西
两条大街汇合于此。往北便是大理皇宫，往南可达天龙寺。东面是
恶人谷，西面则通向剑湖宫。
LONG);

  set("outdoors", "city");
  set("objects", ([
    __DIR__ "obj/box": 1,
  ]));

  set("exits", ([
    "east": __DIR__ "eload1",
    "west": __DIR__ "wload1",
    "south": __DIR__ "sload1",
    "up": "/d/wizard/guest_room",
  ]));

  setup();

}
