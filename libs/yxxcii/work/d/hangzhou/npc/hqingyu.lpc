// hqingyu.c 胡庆余
// Design By Ymh 飞影 email:stcoolman@163.ent

#include <ansi.h>

inherit NPC;

string ask_per();
string ask_betrayer();
string change_name();

void create()
{
	set_name("胡庆余",({ "hu qingyu","hu","qingyu" }));
	set("title","药店老板");
	set("long",@LONG
他是这家药店的老板，除了高超的医术之外，私底下
还帮人家做一些其他的事情，比如：消除叛师记录和
整容。不过收费当然是非常昂贵的了。
LONG
);
	set("gender","男性");
	set("age",40);
	set("per",40);
	set("int",40);
	set("str",40);
	set("cps",40);
	set("con",40);
	set("kar",40);
	
	set("combat_exp",30000);
	set("shen",10);
	
	set("inquiry",([
		"叛师": (: ask_betrayer :),
		"整容": (: ask_per :),
		"改名": (: change_name :),
	]));
	
	setup();
	carry_object("/clone/cloth/cloth")->wear();
	add_money("gold",1);
}

void init()
{
	object ob;
	ob = this_player();
	
	if(ob->query_temp("unconcious")) return;
	if(interactive(ob) && !is_fighting() ) {
	remove_call_out("greeting");
	call_out("greeting", 1, ob);
        }
	add_action("do_name","改");
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(1) ) {
                case 0:
                        say( "胡庆余笑咪咪地说道：这位" + RANK_D->query_respect(ob)
                                + "，进来随便看看吧。\n");
                        break;
                }
}

string ask_betrayer()
{
	object ob;
	ob = this_player();
	
	if(!ob->query("betrayer")) 
	return "你有叛师吗？我怎么没听说过？";
		
	command("whisper "+ ob->query("id")+" 给你消除记录，我可要你十分之二的经验和一百两黄金。\n");
	command("heihei");
	ob->set_temp("ask_betrayer",1);
	return "天下没有不要钱的午餐，你可要慎重考虑哟！";
}

string change_name()
{
	object ob;
	ob = this_player();
	
	ob->set_temp("ask_name",1);
	return"你要改名换姓？！这好办，每次一百两黄金就给你改！";
	
}

string ask_per()
{
	object ob;
	ob = this_player();
	
	if( ob->query("per") > 40)
	return "你的容貌简直无人可比，老夫帮不了你了。";
	
	command("look "+ ob->query("id"));
	command("say 太可怜了，长得这个样子.....");
	command("whisper "+ ob->query("id") +"  整容一次须给一百两黄金，你付得起吗？嘿嘿！");
	ob->set_temp("ask_per",1);
	return "天下没有不要钱的午餐，你可要慎重考虑哟！";
}

int accept_object(object who, object ob)
{
	who = this_player();
	
        if( who->query_temp("ask_per")) {
   
        if(ob->query("money_id") && ob->value() >= 1000000) 
        {
                tell_object(who, "胡庆余说道：好好！请稍等一会！\n");
		who->set_temp("give_per_money",1);
		remove_call_out("changeing");
		call_out("changeing",5,who);
                return 1;
        }
}

	if( who->query_temp("ask_betrayer")) {
	if( ob->query("money_id") && ob->value() >= 1000000)
	{
		tell_object(who,"胡庆余说道：好！好！请稍等一会！\n");
		who->set_temp("give_betrayer_money",1);
		remove_call_out("changeing");
		call_out("changeing",5,who);
		return 1;
	}
}

        if( who->query_temp("ask_name")) {
        if( ob->query("money_id") && ob->value() >= 1000000)
        
        {
                tell_object(who, "胡庆余低头沉思了一会儿，说道：好吧，那您想取个什么样的名字呢？\n");
                tell_object(who, "请您自己输入：改 新的中文名字\n");
                who->set_temp("fee_paid",1);
                return 1;
        }
}
	command("say 哎呀！可真是谢谢你了！");
	return 1;
}

void changeing()
{
	object ob;
	ob = this_player();
	
	if( ob->query_temp("give_per_money") && ob->query_temp("ask_per")){
	message_vision("胡庆余拿出一罐紫红色的胭脂，轻轻的往$N脸上抹去。\n",ob);
	ob->delete_temp("give_per_money");
	ob->delete_temp("ask_per");
	ob->add("per",1);
	tell_object(ob,HIG"你只觉得脸上一阵麻痹过后，又舒服了许多......\n"NOR);
	tell_object(ob,HIC"你的魅力增加了，你现在的魅力值是"+chinese_number(ob->query("per"))+"点！\n"NOR);
	return 1;
}

	if( ob->query_temp("give_betrayer_money") && ob->query_temp("ask_betrayer")) {
	message_vision("胡庆余轻轻的拍了拍$N的头，说道：忠！义！乃对人之本，你可要牢记呀！\n",ob);
	ob->delete_temp("give_betrayer_money");
	ob->delete_temp("ask_betrayer");
	
	tell_object(ob,HIW"听了胡庆余的一番话，你觉得追悔莫极，心中十分难过！！！\n"NOR);
	ob->add("betrayer",- 1);
	ob->add("combat_exp", - ob->query("combat_exp") / 5);
	ob->set("score",0);
	ob->set("shen",ob->query("shen")- ob->query("shen")/10);
	if(ob->query("family/family_name")) {
	message("channel:chat",HIC"〖"+ob->query("family/family_name") +"〗："+ ob->query("name")+"对门派忠心耿耿，现解除"+ ob->query("name")+"的一切监视与疑虑。\n"NOR,users());
	}else {
	command("chat "+ob->query("name")+"洗心革面，终于获得了师父的信任了。");
	}
	return 1;
}	

}

int do_name(string target)
{
        object me;
        string old_name;
        me = this_player();
        old_name = me->query("name");

        if( !me->query_temp("fee_paid") )
                return notify_fail("想改名字必须先给钱的哦！\n");

        if( !target || target==" ") 
        	return notify_fail("胡庆余说道：改名字要这样打：改 <新名字> \n");

        if( old_name == target )
                return notify_fail("胡庆余惊讶的说道：您的钱是不是想送给我？\n");

        command("mud " + old_name + "从现在开始改名为：" + target + "。\n");
        me->delete_temp("fee_paid");
        me->delete_temp("ask_name");
        me->set("name", target);

        return 1;
}
