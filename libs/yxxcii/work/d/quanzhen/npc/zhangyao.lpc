// ren1.c 掌药道长
inherit NPC;
#include <ansi.h>
string ask_dan();
void create()
{
        set_name("掌药道长", ({"zhangyao"}));
        set("gender", "男性");
        set("age", 28);
        set("class", "taoist");
        set("long",
                "这是全真教中的掌管所有药物的道人。他年纪不大，但看起来\n"
                "显得少年老成。\n");
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 40);
        set("int", 40);
        set("con", 40);
        set("dex", 40);
        set("max_qi", 1000);
        set("max_jing", 1000);
        set("neili", 2000);
        set("max_neili", 2000);
        set("jiali", 50);
        set("combat_exp", 9350000);
        set("score", 60000);

        set_skill("force", 450);
        set_skill("xiantian-qigong", 450);    //先天气功
        set_skill("sword", 450);
        set_skill("quanzhen-jian",450);  //全真剑
        set_skill("dodge", 420);
        set_skill("jinyan-gong", 450);   //金雁功
        set_skill("parry", 450);
        set_skill("haotian-zhang", 450);    //昊天掌
        set_skill("literate",480);
        set_skill("strike",420);
        set_skill("taoism",400);

        map_skill("force", "xiantian-qigong");
        map_skill("sword", "quanzhen-jian");
        map_skill("dodge", "jinyan-gong");
        map_skill("parry", "quanzhen-jian");
        map_skill("strike", "haotian-zhang");
        
        create_family("全真教", 4 , "弟子");
        set("inquiry", ([
                "内丹术" : (: ask_dan :),
                     ]));

        set("danyao_count", 10);
        setup();
        carry_object("/clone/cloth/cloth")->wear();
        
}


string ask_dan()
{
        mapping fam; 
        object ob,me;
        me=this_player();
        
        
        if(me->query_temp("job_aoyao")) {
                return "不是已经批准你了吗？还问什么？\n";
        }        
        
        if ((int)this_player()->query_skill("xiantian-qigong",1) < 250 ) 
            return "你的本门内功心法火候不足,怎么炼丹啊！";        
        
        if ((int)this_player()->query_skill("taoism",1) < 250 ) 
            return "你连我们道家的心法都还没有领悟透，怎么也敢学人家炼丹！";              
        
        
        if (query("danyao_count") < 1)
		return "别总想着炼丹啊，加紧练功吧！";
        
        if (!(fam = this_player()->query("family")) || fam["family_name"] != "全真教")
                return RANK_D->query_respect(this_player()) + 
                "与本派素无来往，不知此话从何谈起？";       
        
        
        me->set_temp("job_aoyao",1);
        add("danyao_count", -1);
        return "你来的正是时候，现在炼丹房正好有空，你去修炼去吧，记得回来交差啊！";
        
}

void attempt_apprentice(object ob)
{
                
        if ((int)ob->query_skill("xiantian-qigong",1) < 250 ) {
                command("say 你的本门内功心法火候不足,难以领略更高深的武功。");
                return;
        }
        
        if ((int)ob->query("shen")<10000) {
        command("say 行侠仗义是我辈学武人的基本品质，你若能多做些狭义之
事，我一定收你为徒。\n");
                return;
        }
        command("say 好吧，我就收下你这个徒弟了。");
        command("recruit " + ob->query("id"));
}
        
