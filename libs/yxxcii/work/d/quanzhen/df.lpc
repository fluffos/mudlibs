//danfang.c 炼丹房
//Written By Longhao 

inherit ROOM;

void create ()
{
  set ("short", "炼丹房");
  set ("long", @LONG
这里是全真教配药炼丹的地方，屋子正中放了一只炼药炉，一个
小道童正不停的加药、鼓火、添水，炉中不停的冒出腾腾水雾，并散
发着浓浓的药气，在丹房的另一头还有一个小门(men)。在小门的两边       
还挂着一幅楹联(lian),这儿是全真教的重地，外人轻易是不能进来
LONG);

  set("exits", ([ /* sizeof() == 1 */
  "north" : __DIR__"yaojishi",
]));
  set("item_desc", ([ /* sizeof() == 2 */
  "men" : "一忘扇紧闭的小门。 
",
  "lian" : "               斗                    龙
               室                    泉
               能                    飞
               观                    舞
               天                    振
               下                    八
               事                    荒
",
]));
  set("objects", ([ /* sizeof() == 1 */
  __DIR__"job/lip" : 1,
  __DIR__"npc/tianxu" : 1,
]));

  setup();
  
}


void init()
{
        add_action("do_aoyao", "aoyao");
        add_action("do_quyao","quyao");
}


int do_aoyao(string arg)
{
        object me;
        me = this_player();
        if(me->is_fighting())return notify_fail("你已经在熬药了 ！！\n");
        if(me->is_busy()) return notify_fail("你正忙着呢！！\n");
        if(!me->query_temp("job_aoyao"))return notify_fail("你想干什么！\n");      
                       
        if(me->query("neili") < 1200 ||me->query("max_neili") < 1200)  
        return notify_fail("你太累了，小心身体要紧！\n");
              
        
        if(me->query_temp("aoyao")) 
        return notify_fail("你正在熬药呢！\n");
        
        me->set_temp("aoyao",1);
       me->start_busy(10);
        message_vision("$N盘膝坐下，运起先天功，开始炼制外丹！\n",me);
        call_out("aoyao",random(4), me );
        
        return 1;

}

void aoyao()
{
	object me;
        me = this_player();
        
        if( me->query("str") > 5) {
                message_vision("无虚子对着$N微微笑了笑，对$N念起了《九转丹证歌》。\n\n", this_player());
                message_vision("$N随着无虚子的的诵经声渐渐地进入了无我无物的境界，$N脸上慢慢泛出红晕。\n\n" , me);
                message_vision("只听见无虚子在你耳边轻轻地念道：\n\n",me);
                message_vision("     丹转一，冥冥海底升红日，祥云烟霭遍三千，种出玄珠如黍粒。\n\n",me);
                message_vision("     丹转二，炎炎朱雀烧天地，霞光入鼎虎龙蟠，一粒黄芽如大齿。\n\n",me);         
                message_vision("     丹转三，三才混象结成丹，形容斫块随人意，天质人生已造端。\n\n",me);
                message_vision("     丹转四，蓬壶灵户常关闭，静中暗转法长轮，无限灵光照真宇。\n\n",me);
                message_vision("     丹转五，灵真耀日修仙所，重重道气添光明，为吾增长神明主。\n\n",me);
                message_vision("     丹转六，昼夜河车驰圣轴，灵泉直上昆仑顶，一轴明月瑶池浴。\n\n",me);
                message_vision("     丹转七，无为光里藏灵质，四时道气真官形，千神降福来神室。\n\n",me);
                message_vision("     丹转八，炼得丹心如满月，同行同望又同眠，虽在尘中人不识。\n\n",me);
                message_vision("     丹转九，圣功完满胎仙就，已证虚无自在身，此后不须行火候。\n\n",me);
                message_vision("　　只见一股神气从慧命上升到百会，再从百会返回到慧命，走中脉，上下循行\n\n",me);
                message_vision(" 中产生一种有如云雾上升下降的气感，并逐渐充满整个胸腹腔内，先收在中田，然\n\n",me);
                message_vision(" 后逐渐收在神室以养神。\n\n",me);
                message_vision("     你在天虚子的教导下，完成了九转金丹的一周天的修炼，站起身来，深吸了一口气\n\n",me);
                message_vision("从太虚境界里回到了尘世间。\n\n",me);
                me->add("neili",- random(100) - 400);
        me->delete_temp("job_aoyao");
        me->start_busy(3);
        me->set_temp("quyao",1);
        me->delete_temp("aoyao");
        return;
}
}       

int do_quyao(string arg)
{
        object me;
        me = this_player();
        if(me->is_busy()) return notify_fail("你正忙着呢！！\n");
                             
        if(!me->query_temp("quyao"))return notify_fail("你想取什么！\n");      
               
        message_vision("$N把丹炉中的火熄灭，轻轻地打开丹炉！\n",me);
        call_out("quyao",random(4), me );
        return 1;

}

void quyao()
{
	object me,ob;
	me=this_player();
		message_vision("                        \n\n",this_player());
		message_vision("一粒丹药在丹炉内形成了。\n\n",this_player());
		message_vision("你丹炉取出一粒丹药！\n\n",this_player());
		ob = new("/clone/drug/danyao.lpc");
                ob->move(this_player());
                me->delete_temp("quyao");                 
                me->add("neili",- 1200);
                me->add("combat_exp",30);
                return ;       
       
}

