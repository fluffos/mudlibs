// deer.c 梅花鹿
//longhao 3/12/99

#include <ansi.h>

inherit NPC;

void create() {
  set_name("梅花鹿", ({ "deer", "lu" }));
  set("long", "一支美丽漂亮的雄性梅花鹿，看来它受了惊吓。\n");
  set("race", "野兽");
  set("age", 3);
  set("attitude", "peaceful");

  set("max_ging", 280);
  set("max_qi", 380);

  set("str", 30);
  set("cor", 50);

  set("limbs", ({ "鹿头", "鹿身", "前腿", "后腿", "臀部" }));
  set("verbs", ({ "hoof" }));
  set_temp("apply/attack", 60);
  set_temp("apply/damage", 30);
  set_temp("apply/armor", 40);

  set("combat_exp", 2000);
  setup();
}

void init() {
  object me, ob;
  ::init();
  if (interactive(me = this_player())) {
    if (!(ob = present("xionghuang", this_player()))) {
      remove_call_out("kill_ob");
      call_out("kill_ob", 1, me);
    }
  }
}
