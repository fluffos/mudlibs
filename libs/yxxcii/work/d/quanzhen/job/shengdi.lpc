#include <ansi.h>

inherit ITEM;

void create()
{
   set_name(WHT "生地" NOR, ({"shengdi"}));
   set_weight(100);
   if (clonep())
     set_default_object(__FILE__);
   else {
set("no_sell","这样东西是什么,还是你自己留着吧!\n");
     set("unit", "钱");
 set("value", 50);
     set("long", "一钱生地，是药铺常见的一种药材。\n");
     set("drug_type", "药材");
   }
  
   set("is_monitored",1);
   setup();
}

