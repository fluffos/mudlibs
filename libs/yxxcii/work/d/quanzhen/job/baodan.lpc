//baodan.c 小豹子胆
//longhao 3/12/99

inherit ITEM;


void init()
{
        add_action("do_eat", "eat");
}

void create()
{
	set_name("豹子胆", ({"dan", "baodan"}));
        set("unit", "只");
	set("long", "这是一只豹子胆，是恢复气力的好补品。\n");
	set("value", 200);
        set("drug_type", "补品");
        set("is_monitored",1);
  setup();
}

int do_eat(string arg)
{
	object me = this_player();
  if (arg!="dan" && arg!="baodan")   return 0;
  
  me->set("qi", (int)me->query("max_qi"));
  me->set("neili", (int)me->query("max_neili"));
  me->set("jing", (int)me->query("max_jing"));
  me->set("jingli", (int)me->query("max_jingli"));  
  message_vision("$N吞下一粒豹子胆,一时间全身的疲惫一扫而空。\n只见$N脸上慢慢泛出红晕，看起来有精神多了！\n", me);
  destruct(this_object());
  return 1;
}

