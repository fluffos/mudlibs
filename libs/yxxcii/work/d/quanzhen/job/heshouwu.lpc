// heshouwu.c 何首乌
// longhao 3/12/99
#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();

void init()
{
   add_action("do_eat", "eat");
}

void create()
{
   set_name(HIW "何首乌" NOR, ({"heshouwu"}));
   set_weight(100);
   if (clonep())
     set_default_object(__FILE__);
   else {
     set("unit", "枚");
set("value", 10);
     set("long", "一枚何首乌。外观看起来象一个成形的小娃娃，实是天地间的灵宝。\n");
   set("value",10);
     set("drug_type", "珍贵的药材");
   }
  
   set("is_monitored",1);
   setup();
}

int do_eat(string arg)
{
   int howmany;

   object me = this_player();
  
   if (!id(arg)) return notify_fail("你要吃什么？\n");

   
   message_vision(HIW "$N把何首乌往嘴里一塞，忍不住大叫一声：何首乌啊，的确是太棒了！ \n说罢兴奋得都快晕了过去。\n" NOR, me);  
   me->unconcious();
   destruct(this_object());

   return 1;
}

