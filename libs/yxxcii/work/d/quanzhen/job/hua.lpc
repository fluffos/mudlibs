//hua.c 金银花
// longhao 3/12/99
#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIG"金银花"NOR, ({"hua", "jinhua"}));
        set_weight(100);
        if (clonep())
        set_default_object(__FILE__);
        else {        
        set("unit", "朵");
        set("long", "这是一朵山中的野花，看起来像中可以用来当一味药材。\n");
        set("drup_type","药材");
}
set("is_monitored",1);
        setup();
}

