// yaochu.c  药锄
//longhao 3/12/99
#include <weapon.h>
inherit STAFF;

void create()
{
        set_name("药锄", ({ "yaochu","chu" }));
        set_weight(3000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "这是一把全真教专门用来采药的锄头，入手轻轻的，似乎不是相当结实。\n");
                set("value", 200);
                set("material", "steel");
                set("wield_msg", "$N拿出一把$n握在手中。\n");
                set("unwield_msg", "$N将手中的$n放下。\n");
        }
        init_staff(25);
        setup();
}
