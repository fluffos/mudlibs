// baozi.c 小豹子
//longhao 3/12/99

#include <ansi.h>

inherit NPC;

void create() {
  set_name("小豹子", ({ "baozi", "xiaobaozi" }));
  set("long", "一头刚出生不久的小豹子，看起来它还是十分可爱的。\n");
  set("race", "野兽");
  set("age", 3);
  set("attitude", "peaceful");

  set("max_ging", 280);
  set("max_qi", 480);

  set("str", 30);
  set("cor", 50);

  set("limbs", ({ "前爪", "", "豹嘴", "后爪", "尾巴" }));
  set("verbs", ({ "hoof" }));
  set_temp("apply/attack", 60);
  set_temp("apply/damage", 40);
  set_temp("apply/armor", 40);

  set("combat_exp", 3400);
  setup();
}

void init() {
  object me, ob;
  ::init();
  if (interactive(me = this_player())) {
    if (!(ob = present("xionghuang", this_player()))) {
      remove_call_out("kill_ob");
      call_out("kill_ob", 1, me);
    }
  }
}
void die() {
  object ob;
  message_vision("$N倒在地上，死了！\n", this_object());
  ob = new("/d/longhao/baodan");
  ob->move(environment(this_object()));
  destruct(this_object());
}
