//bee.c

inherit NPC;

void create() {
  set_name("蜜蜂", ({ "bee" }));
  set("race", "野兽");
  set("age", 8);
  set("long", "这是一只蜜蜂，正忙着采蜜。\n");

  set("str", 40);
  set("dex", 50);

  set("max_qi", 300);
  set("eff_qi", 300);
  set("qi", 300);
  set("max_jing", 100);
  set("jing", 100);
  set("neili", 300);
  set("max_neili", 300);
  set("jiali", 10);
  set("limbs", ({ "头部", "身体", "翅膀", "尾巴" }));
  set("verbs", ({ "bite", "poke" }));

  set_temp("apply/attack", 33);
  set_temp("apply/armor", 40);

  set("chat_chance", 2);
  set("chat_msg", ({
    (: this_object(), "random_move" :),
    "蜜蜂嗡嗡嗡飞过来，在你头上转了一圈，有飞走了。\n",
  }));

  setup();
}

void init() {
  object me, ob;
  ::init();
  if (interactive(me = this_player())) {
    if (!(ob = present("xionghuang", this_player()))) {
      remove_call_out("kill_ob");
      call_out("kill_ob", 1, me);
    }
  }
}
