inherit ROOM;

void create() {
  set("short", "暗道");
  set("long", @LONG
这是法元寺的暗道，阵阵湿气从北边吹来，你听到周围
有男女荡笑的声音。
LONG);
  set("exits", ([
    "north": __DIR__ "midao5",
    "south": __DIR__ "midao2",
    "west": __DIR__ "midao4",
    "east": __DIR__ "midao1",
    "up": __DIR__ "xiaoshi",
  ]));
  set("no_clean_up", 0);

  setup();
}
