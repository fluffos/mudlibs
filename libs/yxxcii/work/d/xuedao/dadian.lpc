inherit ROOM;

void create()
{
	set("short","大殿");
	set("long",@LONG
这里是法元寺的大殿，中央供奉着佛祖塑像。连一个僧人
都见不到。更不要说是香客了。大殿两侧
都是侧殿血刀门弟子留言板(board)。
LONG );
	set("exits",([
		"east"  : __DIR__"cedian1",
		"west"  : __DIR__"cedian2",
		"south" : __DIR__"guangchang",
	]));
	set("objects",([
		CLASS_D("xuedao")+"/shengdi" : 1,
	]));
	set("valid_startroom", 1);
//	set("no_clean_up", 0);
	setup();
	replace_program(ROOM);

	"/clone/board/xuedao_b"->foo();
}

