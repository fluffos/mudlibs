inherit ROOM;

void create() {
  set("short", "法元寺山门");
  set("long", @LONG
红的异常的红漆大门(men)上方高挂着一块匾,写着"法元寺"三个大字.
门口站着一位穿着红袈裟的和尚.据说这儿晚上经常听到妇女的
哭声。
LONG);
  set("outdoors", "xuedao");
  set("exits", ([
    "north": __DIR__ "guangchang",
    "south": "/d/xuedao/wangyougu",
  ]));
  set("item_desc", ([
    "gate": "两扇血色大门，给人一种很诡异的感觉。\n",
  ]));
  set("objects", ([
    CLASS_D("xuedao") + "/suixi": 1,
  ]));
  setup();
}
int valid_leave(object me, string dir) {
  mapping myfam;
  myfam = (mapping)me->query("family");

  if ((!myfam || myfam["family_name"] != "法元寺") && dir == "north" &&
    objectp(present("sui xi", environment(me))))
    return notify_fail("随喜拦住你说:乱闯我们佛爷的地方干什么？\n");

  return ::valid_leave(me, dir);
}
