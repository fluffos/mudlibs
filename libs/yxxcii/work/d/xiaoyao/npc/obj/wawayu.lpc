// wawayu.c
#include <ansi.h>

inherit NPC;
inherit F_UNIQUE;

void create() {
  object me;
  string new_name, new_id, host_id;
  me = this_player();
  set_name("娃娃鱼", ({ "wawa yu", "wawayu", "yu" }));
  //	  new_name = me->query("id")+"_wawayu";
  //	  set_name("娃娃鱼", ({new_name}));
  set("race", "野兽");
  set("age", 20);
  set("verbs", ({ "hoof" }));
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("env/wimpy", 100);
  set("chat_chance", 30);
  set("chat_msg", ({
    "娃娃鱼从远处游了过来,盯着你看,不知道在打什么主意。\n",
    "娃娃鱼在你面前游来游去, 对一旁的你看也看一眼, 看来它并不怕你。\n",
    "娃娃鱼正盯着你看, 但看上去却十分的有善。\n",
    (: random_move :),
  }));

  set("combat_exp", 10000 + random(10000));

  set_temp("apply/attack", 25);
  set_temp("apply/attack", 25);
  set_temp("apply/damage", 25);

  new_name = me->query("name") + "捕捉的对象";
  set("long",
    "娃娃鱼是寒冰池里特有的动物,因为它们终年都在寒冰池里,所以有很高的药用价值。\n");
  setup();
}

void die() {
  object ob;
  message_vision("$N翻转身，死了！\n", this_object());
  destruct(this_object());
  this_player()->set_temp("wang/鱼网", 0);

}
