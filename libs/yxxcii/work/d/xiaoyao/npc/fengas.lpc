
// fengas.c

inherit NPC;
string ask_bl();
string ask_me();
inherit F_MASTER;

#include <ansi.h>

string ask_me();

void create()
{
	set_name("冯阿三", ({ "feng asan", "feng" }));
	set("long", 
		"据说他就是鲁班的后人，当代的第一巧匠，设计机关的能手。\n");
	set("gender", "男性");
	set("age", 40);
	set("attitude", "friendly");
	set("class", "alchemist");
	set("shen_type", 1);
	set("str", 38);
	set("int", 28);
	set("con", 30);
	set("dex", 28);

	set("inquiry", ([
		"网鱼" : (: ask_bl :),
		"工具" : (: ask_bl :),
		"机关" : (:ask_me:),
	]) );

	set("max_qi", 600);
	set("max_jing", 600);
	set("neili", 600);
	set("max_neili", 600);
	set("jiali", 30);
	set("combat_exp", 100000);
	set("score", 20000);

	set_skill("blade",50);
	set_skill("ruyi-dao",50);
	set_skill("force", 50);
	set_skill("dodge", 50);
	set_skill("unarmed", 50);
	set_skill("parry", 50);
	set_skill("lingboweibu", 50);
	set_skill("beiming-shengong",50);
	set_skill("liuyang-zhang", 50);

	map_skill("unarmed", "liuyang-zhang");
	map_skill("dodge", "lingboweibu");
	map_skill("force", "beiming-shengong");
	map_skill("blade", "ruyi-dao");

	create_family("逍遥派", 3, "弟子");
	set("title","逍遥派“函谷八友”");
	set("nickname","巧匠");

	setup();
//	carry_object(__DIR__"obj/cloth")->wear();
//	carry_object(__DIR__"obj/blade")->wield();

}

string ask_me()
{
	object me,ob;
	ob=this_player(); 

	if (random(100)<70)
		return "我在设计机关方面是有点特长，让大家见笑了。";   
	command("laugh");
	return "别吵着我，我在看书呢。哈哈，芝麻开门。。。。这书真好笑\n";
}

string ask_bl()
{	 
	object me,ob;
	string new_id;
	me=this_player();

	  if (me->query_temp("wang/工具")==1) 
	  {
	   ob = new(__DIR__"obj/yuwang");
	   ob->move(me);
	   this_player()->set_temp("wang/工具",0);
	   this_player()->set_temp("wang/网鱼",1);
	   return("你既然要去网鱼,就把这个拿去吧。\n");
	  }
	  else 
	  return("你如果要去网鱼,就去找苏星河吧。\n");

}

int accept_object(object who, object ob)
{	
	object me;
	me=this_player();
	  if (me->query_temp("wang/鱼")==0) 
	{
	message_vision("冯阿三对$N说：鱼都没网到就来还工具? \n",who);
	return 0;
	}

	if ((string)ob->query("id")=="yu wang") 
	   {
		   who->set_temp("wang/完成",1);
		   this_player()->set_temp("wang/鱼",0);
		   message_vision("冯阿三对你说：好，你把网到的娃娃鱼交给苏星河吧。\n",who);
		   call_out("destroy", 1, ob);
		   return 1;
	   }
	return 0;
}

void destroy(object ob)
{
	destruct(ob);
	return;
}

