
// suxingh.c  苏星河

inherit NPC;
#include <ansi.h>

string ask_me();
string ask_he();
string ask_book();

void create()
{

	set_name("苏星河",({"su xinghe","su"}));
	set("gender", "男性" );
	set("nickname", "聪辩老人");
	set("shen_type", 0);
	set("class", "scholar");
	set("age",60);
	set("str", 30);
	set("con", 30);
	set("int", 45);
	set("dex", 35);
	set("per", 30);

	set("no_clean_up",1);

	set("long",
"此人就是号称聪辩老人的苏星河，据说他能言善辩， \n"
"是一个武林中的智者，而他的武功也是无人能知。\n");

	set("combat_exp", 500000);
	set("attitude", "peaceful");
	set("book_count", 1);
	set("chat_chance", 1);

	set("max_qi", 3400);
	set("max_jing", 400);
	set("neili", 3500);
	set("max_neili",3500);
	set("jiali", 60);
	set("env/wimpy", 60);

	set_skill("force", 150);
	set_skill("dodge", 150);
	set_skill("unarmed", 150);
	set_skill("parry", 150);
	set_skill("blade", 150);
	set_skill("lingboweibu", 150);
	set_skill("beiming-shengong", 150);
	set_skill("chixin-jian",150);
	set_skill("ruyi-dao", 150);
	set_skill("liuyang-zhang", 150);
	set_skill("zhemei-shou", 150);
	set_skill("literate", 100);

	map_skill("unarmed", "liuyang-zhang");
	map_skill("blade", "ruyi-dao");
	map_skill("dodge", "lingboweibu");
	map_skill("sword","chixin-jian");
	map_skill("force", "beiming-shengong");

	prepare_skill("hand","zhemei-shou");
	prepare_skill("strike","liuyang-zhang");	

	create_family("逍遥派", 2, "弟子");
	set("title","逍遥派第二代大弟子");
	set_temp("鱼数",0);

	set("inquiry", ([
		"娃娃鱼" : "我也想要娃娃鱼,你能帮我吗? \n",
		"job" : (: ask_me :),
		"任务" : (: ask_me :),
		"网鱼" : (: ask_me :),
		"秘密地道" :(:ask_he:),
		"秘籍"	 :(:ask_book:),
	   
	]) );
//	  carry_object(__DIR__"obj/cloth")->wear();
//	  carry_object(__DIR__"obj/blade")->wield();

	setup();


}

void attempt_apprentice(object ob)
{

	if (ob->query_int() < 30) {
		command("shake"+ ob->query("id")); 
		command("say " + RANK_D->query_respect(ob) + 
			"是否还应该在学问上多下点功夫？");
		return;
	}

	command("say 好吧，我就收下你了，今后要多加努力啊！");
	command("recruit " + ob->query("id"));
 }

string ask_book()
{
	object me,ob;
	mapping fam; 
	ob=this_player();
	if (!(fam = ob->query("family")) 
		|| fam["family_name"] != "逍遥派")
	{
		return"想要秘籍就得加入逍遥派。";
	}
	command("sigh");
	return"本派的武功秘籍藏在一个很秘密的地方，我也没去过。";
}
string ask_he()
{
	object me,ob;
	mapping fam; 
	ob=this_player();
	if (!(fam = ob->query("family")) 
		|| fam["family_name"] != "逍遥派")
	{
		return"想要知道密道就得加入逍遥派。";
	}
	command("sigh");
	return"本派的密道在华山之上，很是艰险。你有兴趣可以去看看。";
}

void recruit_apprentice(object ob)
{
	if( ::recruit_apprentice(ob) )
		ob->set("class", "scholar");
}

string ask_me()
{	   
	object me=this_player();
	mapping fam;
	object ob,door,who;
	int i;

	if (!(fam = this_player()->query("family")) || fam["family_name"] != "逍遥派")
		return RANK_D->query_respect(this_player()) +
		"与本派毫无瓜葛，谈何任务？";
	if(me->query("combat_exp")<300000) 
	if(me->query_temp("wang/网鱼")==0) 
	 if(me->query_temp("wang/工具")==0) 
	   if ( (int)me->query("jing") > 95)
		  if ( (int)me->query("qi") > 95)
		 {	  
		 add_temp("鱼数",1);
		 this_player()->set_temp("wang/工具",1);

	  if (query_temp("鱼数") < 5)
	  {
		 i = random(10);
		 door = new("/d/xiaoyao/npc/obj/wawayu");

	  if ( i > 0) 
	 if ( i > 1) 
		if ( i > 2) 
		   if ( i > 3) 
		  if ( i > 4) 
			 if ( i > 5) 
			if ( i > 6)
			   if ( i > 7)
				  if ( i >8)
				 if ( i >9)
					if ( i >10) 
					door->move("/d/xiaoyao/chi1");
					else door->move("/d/xiaoyao/chi2");
				 else door->move("/d/xiaoyao/chi3");
				  else door->move("/d/xiaoyao/chi21");
			   else door->move("/d/xiaoyao/chi22");
			else door->move("/d/xiaoyao/chi23");
			 else door->move("/d/xiaoyao/chi24");
		  else door->move("/d/xiaoyao/chi31");
		   else door->move("/d/xiaoyao/chi32");
		else door->move("/d/xiaoyao/chi33");
	 else door->move("/d/xiaoyao/chi34");
	 }

		 return("你既然要帮我,就去向冯阿三要工具吧。\n");

		 }  
		  else return ("你的体力不够了，休息一会儿再来吧。\n");
	   else return ("你的精力不够了，休息一会儿再来吧。\n");
	else return("你没有完成任务,我不能给你新的任务。\n");
	 else return("你没有完成任务,我不能给你新的任务。\n");
  else return("你是本派的高手网鱼这种小事就不麻烦你了。\n");
}

int accept_object(object who, object ob)
{
	object me=this_player();
	int combat_exp,potential,exp,pot,exp1,pot1;

	  if(me->query_temp("wang/完成")==1) 
	   if ((string)ob->query("id")==me->query("id")+"_wawayu") 
	   {
		exp = (int)me->query("combat_exp");
		pot = (int)me->query("potential");

		who->set_temp("wang/完成",0);
		add_temp("鱼数",-1);
		call_out("destroy", 1, ob);

		this_player()->add("combat_exp", 30+random(100));
		this_player()->add("potential", 15+random(50));
		this_player()->receive_damage("jing",10+random(45));
		this_player()->receive_damage("qi",10+random(45));
		exp1 = (int)me->query("combat_exp");
		pot1 = (int)me->query("potential");

		combat_exp = exp1 - exp;
		potential = pot1 - pot;
		message_vision("苏星河对$N说：好，这是给你的奖励。\n",who);
		tell_object(me,HIR"终于把任务完成了,你看上去似乎有些累。\n"NOR);
		tell_object(me,HIW"你被奖励了：" +
		chinese_number(combat_exp) + "点实战经验，"+
		chinese_number(potential) + "点潜能。\n" NOR);

		return 1;
	   }

	  if(this_player()->query_temp("wang/鱼")==1) 
	if ((string)ob->query("id")==me->query("id")+"_wawayu") 
	   {
		message_vision("苏星河对你说:你先把工具交还给冯阿三吧。\n",who);
	   }
	return 0;
}

void destroying(object me, object obj)
{
	destruct(obj);
	return;
}

