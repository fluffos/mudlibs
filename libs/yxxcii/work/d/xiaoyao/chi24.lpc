//chi2.c 寒冰池内

inherit ROOM;
#include <ansi.h>
void create() {
  set("short", "寒冰池内");
  set("long",
    "这里是寒冰池下，四周倒还渐渐有些昏暗了，几道天光从头顶的潭水中 \n"
    "投射下，此时也不那么瑰丽了，昏沉沉的犹如天边的晚霞。脚下漆黑一片也 \n"
    "不知有些什么。四周的水流也没有那么平静了，似乎在向一个方向流动着。\n"

  );
  set("exits", ([
    "north": __DIR__ "chi2",
  ]));
  setup();
}

void init() {
  object me = this_player();
  if (me->query("id") != "wawa yu") {
    tell_object(me, HIR "你的四肢都冻僵了。\n" NOR);

    if ((int)me->query_skill("force", 1) > 50)
      if ((int)me->query("neili", 1) > 100) {
        me->improve_skill("force", me->query("int"));
        this_player()->receive_damage("jing", random(30));
        this_player()->add("neili", -100);
        write("你运足内力与冰冷的池水相对抗，似乎觉得身体要暖和了些。\n");
      } else
        this_player()->receive_damage("jing", 20 + random(20));
    else
      this_player()->receive_damage("jing", 20 + random(20));
  }

}
