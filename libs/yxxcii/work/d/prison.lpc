#include <ansi.h>

inherit ROOM;

void create() {
  set("short", HIW "寂寞之乡" NOR);
  set("long", HIW @LONG
这里白蒙蒙的一片。举目远眺仍看不到任何事物。拢耳倾听却听不到任何声响。
这里到底是什么地方呢？该不会是监狱吧？！
















┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉┉

LONG NOR);
  set("valid_startroom", 1);
}
void init() {
  object me;
  me = this_player();
  me->set("food", 0);
  me->set("water", 0);
  me->set("jing", 0);
  add_action("do_punish", "chat");
  add_action("do_punish", "chat*");
  add_action("do_punish", "rumor");
  add_action("do_punish", "new");
  add_action("do_punish", "new*");
  add_action("do_punish", "rumor*");
  add_action("do_punish", "tell");
  add_action("do_punish", "say");
  add_action("do_punish", "'");
  add_action("do_punish", "mp");
  add_action("do_punish", "ct");
  add_action("do_punish", "vote");
  add_action("do_punish", "reply");
  add_action("do_punish", "suicide");
  add_action("do_punish", "drop");
  add_action("do_punish", "get");
  add_action("do_punish", "give");
  add_action("do_punish", "go");
  add_action("do_punish", "shout");
  add_action("do_punish", "put");
  add_action("do_punish", "dazuo");
  add_action("do_punish", "exercise");
  add_action("do_punish", "exert");
  add_action("do_punish", "yun");
  add_action("do_punish", "learn");
  add_action("do_punish", "xue");
  add_action("do_punish", "tuna");
  add_action("do_punish", "respirate");
  add_action("do_punish", "practice");
  add_action("do_punish", "lian");
  add_action("do_punish", "du");
  add_action("do_punish", "study");

  //add_action("do_punish","quit");
  if ((int)me->query_condition("bonze_jail") <= 0) {
    message("vision",
      HIY "只听铁门匡地一响，一个家伙被扔了进来！\n\n" NOR,
      environment(me), me);

    tell_object(me, RED "你似乎作了一些不该作的事情，好好在这里反省反省吧！\n\n" NOR);
    me->apply_condition("bonze_jail", 200);

  }
}

int do_punish() {
  object me;
  me = this_player();
  if (wizardp(me)) return 0;
  tell_object(me, HIR "省省吧，还是老老实实地坐你的牢吧！谁叫你不听话呢！\n" NOR);
  return 1;
}
