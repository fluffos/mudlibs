#include <ansi.h>

inherit ITEM;

void create() {
  set_name("信件", ({ "xin", "letter" }));
  set("long", "这是一封紧急信件，还看，快给送去吧！\n");
  set("unit", "封");
  set("weight", 5);
  set("no_get", 1);
  setup();
}

void init() {
  add_action("do_give", "give");
  add_action("do_drop", "drop");
}

int do_drop(string arg) {
  object me, ob;
  int i;
  ob = this_object();
  me = this_player();
  i = me->query("quest/exp_bonus") * (random(1) + 1);
  if (arg == "xin" || arg == "letter") {
    if (me->query("quest/quest_type") == "把信送给") {
      me->add("combat_exp", -i);
      tell_object(
        me,
        "由于你把" + me->query("quest/quest") + "的信件丢失了，延误了" + me->query("quest/quest") + "的事情。\n"
      );
      tell_object(
        me,
        sprintf("你被" + me->query("quest/quest") + "扣除了%s点的战斗经验！\n", chinese_number(i))
      );
      me->delete("quest");
      me->set("letter_bad", 1);
      destruct(ob);
      return 1;
    }
  }

}
int do_give(string arg) {
  object me, ob;
  string obj, target;
  int i, j, h, k;
  me = this_player();
  i = me->query("quest/exp_bonus") * (random(1) + 1);
  j = me->query("quest/pot_bonus") * (random(1) + 1);
  h = me->query("quest/exp_bonus") * (random(2) + 1);
  k = me->query("quest/pot_bonus") * (random(2) + 1);

  if (!arg || arg == " ")
    return 0;
  if (sscanf(arg, "%s to %s", obj, target) != 2)
    if (sscanf(arg, "%s %s", target, obj) != 2)
      return 0;

  if (!id(obj)) return 0;

  if (!ob = present(target, environment(me))) {
    tell_object(me, "你想要把信件交给谁？\n");
    return 1;
  }
  if (ob->query("name") != me->query("quest/quest") || userp(ob)) {
    tell_object(me, "你不能把这样东西给这个人。\n");
    return 1;
  }

  if (!living(ob)) {
    tell_object(me, ob->query("name") + "已经无法收下这样东西了。\n");
    return 1;
  }

  if (time() > (int)me->query("task_time")) {
    message_vision("$N很骂道：这么晚才送来，你误了我的大事啦！！\n" + NOR, ob, me);
    tell_object(me, "你没有及时把信件送到" + ob->query("name") + "的手中，你的任务失败了！\n");
    tell_object(me, HIW "你被" + ob->query("name") + "扣除了：" + chinese_number(i) + "点实战经验\n", NOR);
    me->add("combat_exp", -(i));
  } else {
    message_vision(HIW "$N对$n说道：多谢！多谢！这是你的酬劳，你拿去吧！\n" NOR, ob, me);
    tell_object(me, "你成功地将信件送到了" + ob->query("name") + "的手中。\n");
    tell_object(me, sprintf(WHT "你被奖励了%s点战斗经验，%s点潜能。\n" NOR, chinese_number(h), chinese_number(k)));
    me->add("combat_exp", h);
    me->add("potential", k);
    ob = new(SILVER_OB);
    if (!ob->move(me))
      ob->move(environment(me));
    ob->add_amount(random(50) + 30);
    me->delete("quest");
  }

  me->receive_damage("qi", 30);
  me->receive_damage("jing", 30);

  destruct(this_object());

  return 1;
}
void owner_is_killed() { destruct(this_object()); }
