                        if( ((int)ob->query("PKS") > 300) )
                                return HIR"【杀人女魔】"NOR;
                        else if (shen >= 8000000 ) return HIR"【天下无双】"NOR;
                        else if (shen >= 7000000 ) return HIR"【神行天下】"NOR;
                        else if (shen >= 6000000 ) return HIR"【叱咤风云】"NOR;
			else if (shen >= 5000000 ) return HIR"【纵横四海】"NOR;
			else if (shen >= 4500000 ) return HIR"【笑看风云】"NOR;
			else if (shen >= 4000000 ) return HIY"【武林神话】"NOR;
			else if (shen >= 3000000 ) return HIY"【武林至尊】"NOR;
			else if (shen >= 2500000 ) return HIY"【笑傲江湖】"NOR;
			else if (shen >= 2000000 ) return HIY"【武林传奇】"NOR;
			else if (shen >= 1500000 ) return HIY"【世外高人】"NOR;
			else if (shen >= 1000000 ) return HIM"【武林天骄】"NOR;
			else if (shen >= 800000  ) return HIM"【一代宗师】"NOR;
			else if (shen >= 600000  ) return HIM"【旷世高人】"NOR;
			else if (shen >= 400000  ) return HIM"【旷世女侠】"NOR;
			else if (shen >= 100000  ) return HIM"【一代女侠】"NOR;
