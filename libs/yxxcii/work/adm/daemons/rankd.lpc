#include <ansi.h>

string query_rank(object ob)
{
        mapping fam;

        int shen;
        int budd;
        
        if( ob->query_condition("prostitute") && ob->query("gender") == "男性" ) return HIM"【 男  妓 】"NOR;
        if( ob->query_condition("prostitute") && ob->query("gender") == "女性" ) return HIM"【风尘女子】"NOR;
        if( ob->query("id") == "hoowa") return HIM "【处处留情】" NOR;
        if( ob->query("id") == "guest") return HIG "【过客匆匆】" NOR;
        if( ob->is_ghost() ) return HIB "【 冤  魂 】" NOR;
        if( ob->query("kill_flag") ) return HIR "【 通缉犯 】" NOR;
        if( ob->query("id") == "bmw") return HIY "【笑看風雲】" NOR;
        if( ob->query("combat_exp") <= 100 ) return HIG "【初来乍道】" NOR;
        if( ob->query_temp("seller") >= 300 ) return HIR"【 富  商 】" NOR;
        if( ob->query_temp("seller") >= 100 ) return HIC"【 商  人 】" NOR;
        if( ob->query_temp("seller") >= 50 ) return HIY"【 小  贩 】" NOR;                
	if( ob->query("scores") > ob->query("combat_exp")) return  HIC "【江湖义士】" NOR;
        
        shen = ob->query("shen");
        if ( (fam = ob->query("family")) && fam["family_name"] == "少林派" ) 
                budd = ob->query_skill("buddhism",1);

      
        switch(ob->query("gender")) {
        case "女性":
                switch(wizhood(ob)) {
                case "(admin)":  
                        return HIW "【 女  神 】" NOR;
                case "(arch)":    
                        return HIR "【 大巫女 】" NOR;
                case "(wizard)":        
                        return HIY "【 女天官 】" NOR;
                case "(programer)":      
