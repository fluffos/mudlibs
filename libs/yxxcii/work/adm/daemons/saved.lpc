// autosaved.c
#include <ansi.h>

inherit F_DBASE;

void auto_save();

void create() {
  seteuid(ROOT_UID);
  set("channel_id", "内存精灵");
  CHANNEL_D->do_channel(this_object(), "sys", "自动存盘系统已经启动。");
  call_out("auto_save", 1);
}

void auto_save() {
  int i, mem;
  object *ob, link_ob;
  string id;
  seteuid(getuid());
  ob = users();
  i = sizeof(ob);
  reclaim_objects();
  for (i = 0; i < sizeof(ob); i++) {
    id = (string)ob[i]->query("id");
    if (!id) continue;
    if (!environment(ob[i])) continue;
    if (!objectp(link_ob = ob[i]->query_temp("link_ob"))) continue;
    ob[i]->save();
    if ((int)link_ob->save() && (int)ob[i]->save())
      message("channel:chat", HIC "〖官府通告〗你的资料已经被载入史册。\n" NOR, ob[i]);
    else
      message("channel:chat", HIC "〖官府通告〗蝴蝶君快来啊，官府遭人洗劫了。\n" NOR, ob[i]);
  }
  CHANNEL_D->do_channel(this_object(), "sys",
    sprintf("系统自动清除 " + reclaim_objects() + " 个变数。"));
  remove_call_out("auto_save");
  call_out("auto_save", 300);
}
