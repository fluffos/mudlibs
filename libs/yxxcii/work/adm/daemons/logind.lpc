void random_gift(mapping my) {
  int i;
  int tmpstr, tmpint, tmpcon, tmpdex, tmpper, tmpkar;
  tmpstr = 10 + random(13);
  tmpint = 10 + random(13);
  tmpcon = 10 + random(13);
  tmpdex = 10 + random(13);
  tmpper = 10 + random(13);
  tmpkar = 10 + random(13);
  for (i = 0; i < 40; i++) {
    switch (random(6)) {
      case 0: tmpstr++; break;
      case 1: tmpint++; break;
      case 2: tmpcon++; break;
      case 3: tmpdex++; break;
      case 4: tmpkar++; break;
      case 5: tmpper++; break;
    }
  }
  if (tmpstr <= 30) my["str"] = tmpstr; else my["str"] = 30;
  if (tmpint <= 30) my["int"] = tmpint; else my["int"] = 30;
  if (tmpcon <= 30) my["con"] = tmpcon; else my["con"] = 30;
  if (tmpdex <= 30) my["dex"] = tmpdex; else my["dex"] = 30;
  if (tmpper <= 30) my["per"] = tmpper; else my["per"] = 30;
  if (tmpkar <= 30) my["kar"] = tmpkar; else my["kar"] = 30;
  // next 2 are randomly selected
}
void create() {
  seteuid(getuid());
  set("channel_id", "连线精灵");
}
void logon(object ob) {
  write(CLR);
  write("\n游侠笑传II欢迎您！如果您是使用国标码，请键入：GB or g\n");
  write("村獿肚II舧眤狦眤ㄏノき絏叫块big5 or B\n");
  input_to((: encoding :), ob);
}
void encoding(string arg, object ob) {
  object *usr;
  int i, inv_wiz_cnt, wiz_cnt, ppl_cnt, login_cnt;
  int iplimit, encode;
  int i_user, user_nums;
  string come_num, user_num;
  int t, d, h, m, s;
  string time;
  t = uptime();
  s = t % 60; t /= 60;
  m = t % 60; t /= 60;
  h = t % 24; t /= 24;
  d = t;

  if (d) time = chinese_number(d) + "天";
  else time = "";
  if (h) time += chinese_number(h) + "小时";
  if (m) time += chinese_number(m) + "分";
  time += chinese_number(s) + "秒";

  if (!arg || arg == "") {
    write("\nSelect 国标码 GB or き絏 BIG5 (gb/big5):");
    input_to((: encoding :), ob);
    return;
  } else if (arg[0..0] == "g" || arg[0..0] == "G")
    encode = 0;
  else if (arg[0..0] == "b" || arg[0..0] == "B")
    encode = 1;
  else {
    write("\nSelect 国标码 GB or き絏 BIG5 (gb/big5):");
    input_to((: encoding :), ob);
    return;
  }

  if (encode == 0)
    write("\nUse GB encoded Chinese.\n");
  else
    write("\nUse BIG5 encoded Chinese.\n");

  ob->set_encoding(encode);
  if (mad_lock == 1) {
    write("现在时空已经封闭了，不能进入！！ \n");
    destruct(ob);
    return;
  }
  if (BAN_D->is_banned(query_ip_number(ob)) == 1 && !check_open_ip(query_ip_name(ob))) {
    write("你的地址在本 MUD 不受欢迎。\n");
    destruct(ob);
    return;
  }
  write(read_file(WELCOME));
  write("\n");
  usr = users();
  wiz_cnt = 0;
  inv_wiz_cnt = 0;
  ppl_cnt = 0;
  login_cnt = 0;
  iplimit = 0;
  for (i = 0; i < sizeof(usr); i++) {
    if (query_ip_name(usr[i]) == query_ip_name(ob)) iplimit++;
    /*
                printf("%O",usr[i]);
                printf("%s",query_ip_name(usr[i]));
                printf("%d",iplimit);
*/
    if (!environment(usr[i])) login_cnt++;
    else if (wizardp(usr[i]) && usr[i]->query("env/invisibility")) inv_wiz_cnt++;
    else if (wizardp(usr[i]) && !usr[i]->query("env/invisibility")) wiz_cnt++;
    else ppl_cnt++;
  }
  if (!check_open_ip(query_ip_name(ob))) {
    if (iplimit > 3) {
      write("对不起，你这个ip的使用者已经太多了,请退出其他帐号再试!\n");
      destruct(ob);
      return;
    }
  } else if (iplimit > 15) {
    write("这个地址已经有太多帐号正在使用了。\n");
    destruct(ob);
    return;
  }
  write(MUD_NAME + "已经连续运行了" + time + "。\n");
  user_num = read_file(__DIR__ "iduser", 1);
  i_user = atoi(user_num);
  i_user = i_user + 1;
  user_num = sprintf("%d", i_user);
  write_file(__DIR__ "iduser", user_num, 1);
  user_num = read_file(__DIR__ "iduser", 1);
  i_user = atoi(user_num);
  printf("自一九九九年十月二十五日开放至今您是第" + HIY + " %s" + NOR + "位访问者。\n", chinese_number(i_user));
  user_nums = howmany_user();
  printf("游侠笑传到目前为止共有" + HIY + "%s" + NOR + "个玩家。\n", chinese_number(user_nums));
  printf("目前共有 %s 位巫师、%s 位玩家在进行游戏，以及 %s 位使用者尝试连线中。\n",
    HIW + chinese_number(wiz_cnt) + NOR, HIC + chinese_number(ppl_cnt) + NOR, HIG + chinese_number(login_cnt + inv_wiz_cnt) + NOR);
  write("您的英文名字：");
  input_to("get_id", ob);
}

int howmany_user() {
  int i, j, ppl_cnt;
  string *dir, *ppls, name;
  mixed info;
  seteuid(getuid());
  ppl_cnt = 0;
  dir = get_dir(DATA_DIR "login/");
  for (i = 0; i < sizeof(dir); i++) {
    reset_eval_cost();
    ppls = get_dir(DATA_DIR "login/" + dir[i] + "/");
    ppl_cnt += sizeof(ppls);
  }
  return ppl_cnt;
}

void get_id(string arg, object ob) {

  object ppl, *usr;
  int i, wiz_cnt;
  arg = lower_case(arg);
  if (!check_legal_id(arg)) {
    write("请输入您的英文名字：");
    input_to("get_id", ob);
    return;
  }

  usr = users();
  wiz_cnt = 0;
  for (i = 0; i < sizeof(usr); i++) {
    if (wizardp(usr[i]))
      wiz_cnt++;
  }

  if ((string)SECURITY_D->get_status(arg) == "(player)"
    && (sizeof(users()) - wiz_cnt) >= 120) {
    ppl = find_body(arg);
    if (!ppl || !interactive(ppl)) {
      write("对不起，" + MUD_NAME + "的使用者已经太多了，请待会再来。\n");
      destruct(ob);
      return;
    }
  }

  if (wiz_level(arg) < wiz_lock_level) {
    write("对不起，" + MUD_NAME + "目前限制巫师等级 " + WIZ_LOCK_LEVEL
      + " 以上的人才能连线。\n");
    destruct(ob);
    return;
  }
  if ((string)ob->set("id", arg) != arg) {
    write("Failed setting user name.\n");
    destruct(ob);
    return;
  }
  if (arg == "guest") {
    confirm_id("Yes", ob);
    return;
  } else if (file_size(ob->query_save_file() + __SAVE_EXTENSION__) >= 0) {
    if (ob->restore()) {
      write("该帐号已被注册,请输入密码：");
      input_to("get_passwd", 1, ob);
      return;
    }
    write("您的人物储存挡出了一些问题，请利用 guest 人物通知巫师处理。\n");
    destruct(ob);
    return;
  }
  write(HIW "\n你好，新玩家！这个 id 无人使用，您确定要创造一个新人物吗(y/n)？\n" NOR);
  input_to("confirm_id", ob);
}
void get_passwd(string pass, object ob) {
  string my_pass;
  object user;
  int time_rl, time_r2;
  string temps;
  write("\n");
  my_pass = ob->query("password");
  if (crypt(pass, my_pass) != my_pass) {
    write("密码错误！\n");
    destruct(ob);
    return;
  }
  time_rl = time() - ob->query("last_on");
  time_r2 = 30 - time_rl;
  // Check if logout recently
  if (time_rl >= 0 && time_rl <= 30) {
    temps = sprintf("你距上次退出仅" + HIR + " %d " + NOR + "秒.\n", time_rl);
    write(temps);
    if ((string)SECURITY_D->get_status(ob->query("id")) == "(player)") {
      write("对不起，为了降低系统负荷，请过 " + HIR + time_r2 + NOR + " 秒后再login，多谢您的合作。\n");
      destruct(ob);
      return;
    } else {
      write(HIY "虽然你是巫师，也不要频繁的login哦。\n" NOR);
    }
  }
  // Check if we are already playing.
  user = find_body(ob->query("id"));
  if (user) {
    if (user->query_temp("netdead")) {
      reconnect(ob, user);
      return;
    }
    write("您要将另一个连线中的相同人物赶出去，取而代之吗？(y/n)");
    input_to("confirm_relogin", ob, user);
    return;
  }
  if (objectp(user = make_body(ob))) {
    if (user->restore()) {
      log_file("USAGE", sprintf("%s loggined from %s (%s)\n", user->query("name"),
        query_ip_name(ob), ctime(time())));
      enter_world(ob, user);
      return;
    } else {
      destruct(user);
    }
  }
  write("请您重新创造这个人物。\n");
  confirm_id("y", ob);
}

void confirm_relogin(string yn, object ob, object user) {
  object old_link;

  if (yn == "") {
    write("您要将另一个连线中的相同人物赶出去，取而代之吗？(y/n)");
    input_to("confirm_relogin", ob, user);
    return;
  }


  if (yn[0] != 'y' && yn[0] != 'Y') {
    write("好吧，欢迎下次再来。\n");
    destruct(ob);
    return;
  } else {
    tell_object(user, "有人从别处( " + query_ip_number(ob)
      + " )连线取代你所控制的人物。\n");
    log_file("USAGE", sprintf("%s replaced by %s (%s)\n", user->query("name"),
      query_ip_name(ob), ctime(time())));
  }
  old_link = user->query_temp("link_ob");
  if (old_link) {
    exec(old_link, user);
    destruct(old_link);
  }

  reconnect(ob, user);
}

void confirm_id(string yn, object ob) {
  if (yn == "") {
    write("您确定要创造一个新人物了吗(y/n)？");
    input_to("confirm_id", ob);
    return;
  }

  if (yn[0] != 'y' && yn[0] != 'Y') {
    write("好吧，那么请重新输入您的英文名字：");
    input_to("get_id", ob);
    return;

  }
  write(@TEXT
[1;37m
请输入您的高姓大名，由于这个名字将代表你本人，请慎重择名。
请不要起不雅观的名字，也请尽量不要和别人同名。谢谢合作！！
[0m
TEXT
  );
  write("您的中文名字(使用Big5的玩家可请求巫师修改)：");
  input_to("get_name", ob);
}

void get_name(string arg, object ob) {
  if (!check_legal_name(arg)) {
    write("您的中文名字(使用Big5的玩家可请求巫师修改)：");
    input_to("get_name", ob);
    return;
  }
  ob->set("name", arg);
  write("请设定您的密码：");
  input_to("new_password", 1, ob);
}

void new_password(string pass, object ob) {
  write("\n");
  if (strlen(pass) < 5) {
    write("密码的长度至少要五个字元，请重设您的密码：");
    input_to("new_password", 1, ob);
    return;
  }
  ob->set("password", crypt(pass, 0));
  write("请再输入一次您的密码，以确认您没记错：");
  input_to("confirm_password", 1, ob);
}

void confirm_password(string pass, object ob) {
  mapping my;
  string old_pass;
  write("\n");
  old_pass = ob->query("password");
  if (crypt(pass, old_pass) != old_pass) {
    write("您两次输入的密码并不一样，请重新设定一次密码：");
    input_to("new_password", 1, ob);
    return;
  }

  write(@TEXT

[1;37m一个人物的天赋对于他或她所修习的武艺息息相关。游侠笑传中的人物大多具有[0m
[1;37m以下四项天赋：[0m
[0m[36m
	膂力：影响攻击能力及负荷量的大小。
	悟性：影响学习武功秘籍的速度及理解师傅的能力。
	根骨：影响体力恢复的速度及升级后所增加的体力。
	身法：影响防御及躲避的能力。
	容貌：影响游戏中的拜师以及迷题等。
	运气：影响游戏中的任务。
[0m
TEXT);
  my = ([]);
  random_gift(my);
  printf(MAG "\n膂力[%d]， 悟性[%d]， 根骨[%d]， 身法[%d]，容貌[%d],  运气[%d]\n\n" NOR,
    my["str"], my["int"], my["con"], my["dex"], my["per"], my["kar"]);
  write("您接受这一组天赋吗？");
  input_to("get_gift", ob, my);
}

void get_gift(string yn, object ob, mapping my) {
  if (yn[0] != 'y' && yn[0] != 'Y') {
    random_gift(my);
    printf(MAG "\n膂力[%d]， 悟性[%d]， 根骨[%d]， 身法[%d]，容貌[%d],  运气[%d]\n\n" NOR,
      my["str"], my["int"], my["con"], my["dex"], my["per"], my["kar"]);
    write("您同意这一组天赋吗？");
    input_to("get_gift", ob, my);
  }
  if (yn[0] == 'y' || yn[0] == 'Y') {
    write("\n您的电子邮件地址：");
    input_to("get_email", ob, my);
  }
}

void get_email(string email, object ob, mapping my) {
  object user;
  string id, address;
  write("\n");
  if (email == "" || strsrch(email, "@") == -1 ||
    sscanf(email, "%s@%s", id, address) != 2 || strsrch(address, ".") == -1)

  {
    write("电子邮件地址需要是 id@address 的格式。\n");
    write(HIR "建议：您最好登记你真实的电子邮件地址，以方便我们与您取的联系。\n"
      "当你忘记密码的时候,这是你取回密码的唯一方式.\n\n" NOR);
    write("请再一次输入您的电子邮件地址：");
    input_to("get_email", ob, my);
    return;
  }
  ob->set("email", email);
  ob->set("registered", 1);

  ob->set("body", USER_OB);
  if (!objectp(user = make_body(ob)))
    return;
  user->set("str", my["str"]);
  user->set("dex", my["dex"]);
  user->set("con", my["con"]);
  user->set("int", my["int"]);
  user->set("per", my["per"]);
  user->set("kar", my["kar"]);
  ob->set("registered", 1);
  user->set("registered", 1);

  write("您要扮演男性(m)的角色或女性(f)的角色？");
  input_to("get_gender", ob, user);

}

void get_gender(string gender, object ob, object user) {
  int id_temp;
  string id_num;

  write("\n");
  if (gender == "") {
    write("您要扮演男性(m)的角色或女性(f)的角色？");
    input_to("get_gender", ob, user);
    return;
  }

  if (gender[0] == 'm' || gender[0] == 'M')
    user->set("gender", "男性");
  else if (gender[0] == 'f' || gender[0] == 'F')
    user->set("gender", "女性");
  else {
    write("对不起，您只能选择男性(m)或女性(f)的角色：");
    input_to("get_gender", ob, user);
    return;
  }

  log_file("USAGE", sprintf("%s was created from %s (%s)\n", user->query("id"),
    query_ip_name(ob), ctime(time())));
  init_new_player(user);
  enter_world(ob, user);
  //统计注册人数
  /*      
        id_num=read_file(__DIR__"users",1);
        id_temp=atoi(id_num); id_temp=id_temp+1;
        id_num=sprintf("%d",id_temp);
        write_file(__DIR__"users",id_num,1);
*/
  write("\n");
}

object make_body(object ob) {
  string err;
  object user;
  int n;

  user = new(ob->query("body"));
  if (!user) {
    write("现在可能有人正在修改使用者物件的程式，无法进行复制。\n");
    write(err + "\n");
    return 0;
  }

  seteuid(ob->query("id"));
  export_uid(user);
  export_uid(ob);
  seteuid(getuid());
  user->set("id", ob->query("id"));
  user->set_name(ob->query("name"), ({ ob->query("id") }));
  return user;
}

void init_new_player(object user) {

  user->set("title", "平民百姓");
  user->set("birthday", time());
  user->set("combat_exp", 0);
  user->set("potential", 100);
  user->set("food", 700);
  user->set("water", 700);

  user->set("channels", ({ "chat", "rumor", "music", "es", "music", "news", "party", "mud" }));
  user->set("balance", 200);
  if (user->query("gender") == "男性") {
    message(
      "channel:chat",
      HIW "〖小道消息〗" + HIG + "听说" + MUD_NAME + "又来了一个叫" + user->name(1) + "(" + user->query("id") + ")的江湖人士！\n" NOR,
      users()
    );
  } else {
    message(
      "channel:chat",
      HIW "〖小道消息〗" + HIM + "听说" + MUD_NAME + "又来了一个叫" + user->name(1) + "(" + user->query("id") + ")的江湖女子！\n" NOR,
      users()
    );
  }
}


varargs void enter_world(object ob, object user, int silent) {
  object cloth, shoe, room, mailbox, gift, login_ob, site;
  string startroom, hood = "";
  int card_num, money;
  string week, month, c_week, time99, welcome;
  int day, hour, minute, second, year, y1, y2, y3, y4, c_month;
  int n;
  n = random(sizeof(start_room));

  user->set_encoding(ob->query_encoding());
  user->set_temp("link_ob", ob);
  ob->set_temp("body_ob", user);
  user->set("registered", ob->query("registered"));
  exec(user, ob);

  money = (int)user->query("balance");
  if (hood != wiz_rank(wizhood(user))) {
    hood = wiz_rank(wizhood(user));
  }

  write(CLR + read_file(MOTD));


  write(HIC "\n请按任意键继续……\n" NOR);

  input_to("in_world", ob);
  write(HIC "\n☆" HIG "目前权限：" + hood + "\n" + NOR);
  if (!money) {
    write(HIC "☆" HIG "你在钱庄还没有存款,多多加油哦!\n" NOR);
  } else write(HIC "☆" HIG "你的存款：" + MONEY_D->money_str(money) + "\n" + NOR);
  if (user->query_skill("pixie-sword", 1)) {
    user->set_skill("pixie-jian", (int)user->query_skill("pixie-sword", 1));
    user->delete_skill("pixie-sword", 1);
    user->save();
  }

  user->setup();

  // In case of new player, we save them here right aftre setup 
  // compeleted.
  user->save();
  ob->save();
  //Use condition to auto save user file
  user->apply_condition("autosave", 1);
  // Give user a mailbox.
  // Modified by Hop at 1997.04.10
  // new modifiy by ymh 如果玩家上线的时候，自动检查信箱中邮件数量。提示玩家是否有新邮件。

  mailbox = present("mailbox", user);
  mailbox = new("/clone/misc/mailbox");
  mailbox->move(user);

  if (!user->is_ghost() && user->query("age") < 18) {
    site = new("/clone/misc/site");
    site->move(user);
  }

  if (!user->query("login_online")) {
    write(HIC "☆" HIG "您是自" HIY " 1999 " HIG "年 " HIY "10 " HIG "月" HIY " 2 " HIG "日以来第 " HIY "一" HIG " 次光临" HIM " 游侠笑传 " HIG "欢迎您!\n" NOR);
  } else {
    login_ob = new(LOGIN_OB);
    login_ob->set("id", user->query("id"));
    login_ob->restore();
    sscanf(
      ctime(login_ob->query("last_on")),
      "%s %s %d %d:%d:%d %d",
      week,
      month,
      day,
      hour,
      minute,
      second,
      year
    );

    if (week == "Mon") c_week = HIC "星期一";
    else if (week == "Tue") c_week = HIC "星期二";
    else if (week == "Wed") c_week = HIC "星期三";
    else if (week == "Thu") c_week = HIC "星期四";
    else if (week == "Fri") c_week = HIC "星期五";
    else if (week == "Sat") c_week = HIR "星期六";
    else if (week == "Sun") c_week = HIR "星期天";

    if (month == "Jan") c_month = 1;
    else if (month == "Feb") c_month = 2;
    else if (month == "Mar") c_month = 3;
    else if (month == "Apr") c_month = 4;
    else if (month == "May") c_month = 5;
    else if (month == "Jun") c_month = 6;
    else if (month == "Jul") c_month = 7;
    else if (month == "Aug") c_month = 8;
    else if (month == "Sep") c_month = 9;
    else if (month == "Oct") c_month = 10;
    else if (month == "Nov") c_month = 11;
    else if (month == "Dec") c_month = 12;

    if (hour < 6 && hour > 0) { time99 = HIW "凌晨" NOR; welcome = HIW "要保重身体哦!" NOR; } else if (hour < 8 && hour >= 6) {
      time99 = HIM "早上" NOR; welcome = HIM "新的一天又开始了,加油哦!" NOR;
    } else if (hour < 12 && hour >= 8) { time99 = HIY "上午" NOR; welcome = HIY "小心别被老板抓住哦!" NOR; } else if (hour == 12) {
      time99 = HIR "中午" NOR; welcome = HIR "你真用功!多多加油!" NOR;
    } else if (hour < 19 && hour > 12) { time99 = HIC "下午" NOR; welcome = HIC "外面阳光还好吧!" NOR; } else if (hour < 24 && hour >= 19) {
      time99 = HIB "晚上" NOR; welcome = HIB "不用陪女朋友吗?" NOR;
    } else if (hour == 24 || hour == 0) { time99 = HIR "子夜" NOR; welcome = HIR "别玩的太晚了!" NOR; }

    if (hour > 12) {
      if (hour == 13) hour = 1;
      else if (hour == 14) hour = 2;
      else if (hour == 15) hour = 3;
      else if (hour == 16) hour = 4;
      else if (hour == 17) hour = 5;
      else if (hour == 18) hour = 6;
      else if (hour == 19) hour = 7;
      else if (hour == 20) hour = 8;
      else if (hour == 21) hour = 9;
      else if (hour == 22) hour = 10;
      else if (hour == 23) hour = 11;
      else if (hour == 24) hour = 0;
    }

    y1 = year / 1000;
    y2 = year / 100 - 20 + 10;
    y3 = year / 10 - 200 + 10;
    y4 = year - 2000 + 10;
    write(HIC "☆" HIG "您上次连线的" HIW "IP" HIG "是: " + HIY + login_ob->query("last_from") + "\n" + NOR);
    write(HIC "☆" HIG "您是自" HIY " 1999 " HIG "年 " HIY "10 " HIG "月" HIY " 2 " HIG "日以来第 " + HIY + (user->query("login_online") + 1) + HIG + " 次光临" HIM " 游侠笑传 " HIG "欢迎您!\n" NOR);
    destruct(login_ob);
  }
  if (!wizardp(user) && user->query("mud_age")) {
    message(
      "channel:chat",
      HIY "〖天下公告〗" + HIW + user->name(1) + "决意重出江湖，一举夺下天下武林盟主之位！\n" NOR,
      users()
    );
  }

  // End of modification
  // new modify by ymh 进入游戏的时候，检查玩家与离线时差距所得的经验。
  // 如果经验超出了5000，潜能超出了1000的时候，将自动写入WARNING的记录文件。
  // 定义5000经验不大也不小，如果定义5000经验以下的话，到时候记录文件WARNING将会很大。
  // 如果定义5000以上的经验，玩家可以利用这个检测，多次连线，避开记录。
  if ((int)user->query("combat_exp") - (int)user->query("exp") >= 20000
    || (int)user->query("exp") - (int)user->query("combat_exp") >= 20000) {
    log_file("nosave/WARNING", sprintf("%s（%s） 在 %s 连接。经验：%d <> %d\n",
      user->query("name"), user->query("id"),
      ctime(time()),
      (int)user->query("exp"), (int)user->query("combat_exp")));
  }
  if ((int)user->query("potential") - (int)user->query("pot") >= 2000

    || (int)user->query("pot") - (int)user->query("potential") >= 2000) {
    log_file("nosave/WARNING", sprintf("%s（%s） 在 %s 连接。潜能：%d <> %d\n",
      user->query("name"), user->query("id"),
      ctime(time()),
      (int)user->query("pot") - (int)user->query("learned_points"),
      (int)user->query("potential") - (int)user->query("learned_points")));
  }

  cloth = new("clone/misc/cloth");
  cloth->move(user);
  cloth->wear();
  shoe = new("clone/misc/shoe");
  shoe->move(user);
  shoe->wear();

  if (!silent) {
    write("\n" NOR);
    if (user->is_ghost())
      startroom = DEATH_ROOM;
    else if (!stringp(startroom = user->query("startroom"))) {
      startroom = start_room[n];
    }
    //巫师必须先到休息室报到
    if (wizardp(user) && user->query("id") != "robert") {
      user->move("/d/wizard/wizard_room");
      message("channel:wiz", HIC "〖巫师公告〗" + user->query("name") + "连线进入这个世界！\n" NOR, users());
    } else {
      if (!catch(load_object(startroom)))
        user->move(startroom);
      else {
        user->move(START_ROOM);
        startroom = START_ROOM;
        user->set("startroom", START_ROOM);
      }
    }

  }

  if (user->query("id") != "robert") {
    CHANNEL_D->do_channel(this_object(), "sys",
      sprintf("%s由%s连线进入。[" + ctime(time()) + "]",
        user->name() + "(" + user->query("id") + ")", query_ip_name(user)));
    UPDATE_D->check_user(user);
    TOPTEN_D->topten_checkplayer(user);
    user->add("login_online", 1);
    user->set_temp("temp_exp", user->query("combat_exp"));
    user->set_temp("temp_time", time());
    user->set_temp("temp_pot", user->query("potential"));
  }
}

varargs void reconnect(object ob, object user, int silent) {
  user->set_temp("link_ob", ob);
  ob->set_temp("body_ob", user);
  exec(user, ob);
  user->set_encoding(ob->query_encoding());
  user->reconnect();
  if (!silent) {
    tell_room(environment(user), user->query("name") + "重新连线回到这个世界。\n",
      ({ user }));
  }
  message("channel:chat", HIY "〖天方夜潭〗" + HIW + user->name(1) + "从朦胧中苏醒过来，恢复了神志。\n" NOR, users());
  CHANNEL_D->do_channel(this_object(), "sys",
    sprintf("%s由%s重新连线进入。", user->query("name"), query_ip_name(user)));
  UPDATE_D->check_user(user);
}

int check_legal_id(string id) {
  int i, j;

  i = strlen(id);
  if ((strlen(id) < 3) || (strlen(id) > 12)) {
    write("对不起，你的英文名字必须是 3 到 8 个英文字母。\n");
    return 0;
  }
  while (i--)
    if (id[i] < 'a' || id[i] > 'z') {
      write("对不起，你的英文名字只能用英文字母。\n");
      return 0;
    }

  for (i = 0; i < sizeof(banned_id); i++) {
    if (strsrch(id, banned_id[i]) == -1) continue;
    write("对不起，游戏中不允许使用此类英文代号，请重新选择。\n");
    return 0;
  }

  return 1;
}
int check_legal_name(string name) {
  int i, j;

  i = strlen(name);
  if ((strlen(name) < 1) || (strlen(name) > 6)) {
    write("对不起，你的中文名字必须是 1 到 6 个中文字。\n");
    return 0;
  }
  while (i--) {
    if (name[i] <= ' ') {
      write("对不起，你的中文名字不能用控制字元。\n");
      return 0;
    }
    if (!CHINESE_D->is_chinese(name[i..i]))  //修改: by ymh 用chinesed来检测名称是否属于中文
    {
      write("对不起，请您用「中文」取名字。\n");
      return 0;
    }
  }

  for (i = 0; i < sizeof(banned_name); i++) {
    if (strsrch(name, banned_name[i]) == -1) continue;
    write("对不起，这种名字会造成其他人的困扰。\n");
    return 0;
  }


  return 1;

}

object find_body(string name) {
  object ob, *body;

  if (objectp(ob = find_player(name)))
    return ob;
  body = children(USER_OB);
  for (int i = 0; i < sizeof(body); i++)
    if (clonep(body[i])
      && getuid(body[i]) == name) return body[i];


  return 0;
}

int set_wizlock(int level) {
  if (wiz_level(this_player(1)) <= level)
    return 0;
  if (geteuid(previous_object()) != ROOT_UID)
    return 0;
  wiz_lock_level = level;
  return 1;
}
// add for ten top. 
int set_madlock(int setmark) {
  if (wiz_level(this_player(1)) < wiz_level("(arch)"))
    return 0;
  if (setmark == 1) mad_lock = 1;
  else mad_lock = 0;
  return 1;
}


int get_madlock() {
  return mad_lock;
}
int howmuch_money(object ob) {
  int total;
  int total2;
  object gold, silver, coin;

  total = 0;
  total2 = 0;

  gold = present("gold_money", ob);
  silver = present("silver_money", ob);
  coin = present("coin_money", ob);

  if (gold) total += gold->value();
  if (silver) total += silver->value();
  if (coin) total += coin->value();

  total2 = (int)ob->query("balance");
  if (!total2 || total2 < 0) {
    ob->set("balance", 0);
  }
  total = total + total2;
  return total;
}

string wiz_rank(string hood) {
  switch (hood) {

    case "(admin)":
      return HIW "(主管巫师)" NOR;
    case "(arch)":
      return HIC "(系统巫师)" NOR;
    case "(programer)":
      return HIC "(开发巫师)" NOR;
    case "(wizard)":
      return HIY "(维护巫师)" NOR;
    case "(engineer)":
      return HIY "(策划巫师)" NOR;
    case "(immortal)":
      return HIM "(见习巫师)" NOR;
    default: return HIY "(玩家)" NOR;


  }
}
int check_open_ip(string ip) {
  int i, open_ip;
  string *sip, *lip;
  if (member_array(ip, escpecial_ip) != -1) return 1;
  for (i = 0; (i < sizeof(escpecial_ip) && !open_ip); i++) {
    int k;
    sip = explode(escpecial_ip[i], ".");
    lip = explode(ip, ".");
    if (sizeof(sip) >= sizeof(lip)) continue;
    for (k = 0, open_ip = 1; (k < sizeof(sip) && open_ip); k++) if (sip[k] != lip[k]) open_ip = 0;
  }
  if (!open_ip) return 0;
  return 1;
}
