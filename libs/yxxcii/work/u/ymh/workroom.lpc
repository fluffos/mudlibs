#include <ansi.h>
#include <room.h>

inherit ROOM;

void create()
{
       set("short","灌木丛");
       set("long",@LONG
这里是飞影的栖身之所，高大挺拔的灌木丛林中，隐约传来阵阵候鸟
的啼叫声音，显得十分凄凉。轻风在树丛中来回穿梭，树叶发出阵阵沙沙
的声响，让人感到十分恐惧。白天，飞影就会在这里发呆；晚上，就是飞
影就会离开这里，四处巡视。
LONG
);
      set("exits",([
            "down":  "/d/center/guangchang",
            "up":    "/u/robert/workroom",
            "east":  "/u/longhao/workroom",
            "west":  "/d/wizard/wizard_room",
      ]));
 
      set("outdoors","center");
      set("no_fight",1);
      set("no_sleep",1);
      set("no_beg",1);
      set("no_steal",1);
}

       
