// workroom.c 龙浩的房间
// Design By longhao add from 1999.12.25
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "龙潭居");
  set("long", @LONG
这是龙浩平时工作的地方，屋角有一张木床靠近窗台放着一张斑驳的
木桌和一条竹椅，桌的左首是一盏昏黄的油灯，右边则凌乱地摆放着几册
泛黄的线装书，中央用铜镇纸压着一幅书法，龙飞凤舞般地写着几个大字
：“十年磨剑今何在，秋风无名笑狂生。”
LONG
  );
  set("exits", ([
    "down": "/d/wizard/wizard_room",
    "down": "/d/wizard/wizard_room",
    "east": "/u/robert/workroom",
    "hs": "/d/huashan/chaoyang",
    "qz": "/d/quanzhen/laojundian",
  ]));
  set("valid_startroom", "1");
  setup();
}
