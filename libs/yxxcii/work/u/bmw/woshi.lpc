// woshi.c 逍遥阁
// Design By BMW add from 1999.11.6

#include <ansi.h>
inherit CHAT_ROOM;

void create() {
  set("short", "逍遥阁");
  set("long", @LONG 
这里是逍遥的卧室。卧室使用寒冰铺成，只见天花板，墙壁上都铺
满了晶莹剔透的寒冰，给人一种凉飕飕的感觉。透过寒冰，可以倒
映出你的影子。一张硕大的寒冰床放在卧室的正中，那是逍遥休息
的时候用的。
LONG
  );
  set("sleep_room", 1);
  set("chat_room", 1);
  set("no_fight", 1);
  set("no_kill", 1);
  set("no_steal", 1);
  set("no_magic", 1);

  set("exits", ([
    "out": __DIR__ "workroom",

  ]));

  setup();
}

void init() {
  object ob;

  if (interactive(ob = this_player())) {
    remove_call_out("greeting");
    call_out("greeting", 0, ob);
  }
}

void greeting(object ob) {
  //if( !ob || environment(ob) != environment() ) return;
  tell_object(ob, HIB "一股寒意袭上心头，你不禁打了个冷战。\n" NOR);

}
