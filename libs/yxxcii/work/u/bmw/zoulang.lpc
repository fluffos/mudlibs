// zoulang.c 走廊
// Design By BMW add from 1999.11.6

#include <ansi.h>
inherit CHAT_ROOM;

void create()
{
        set("short","走廊");
        set("long",@LONG 

  这是一条走廊，南面是逍遥的逍遥居，北面是蝴蝶哥哥的卧室。

LONG
);
        set("no_fight",1);
        set("no_kill",1);
        set("no_steal",1);
        set("no_magic",1);
        
        set("exits",([
                "north": "/u/robert/workroom",
                "south": "/u/bmw/workroom",
        ]));

        setup();
}
