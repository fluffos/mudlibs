// li.c

#include <ansi.h>

inherit NPC;

string ask_me(object who);

void create()
{
        set_name(HIR"圣诞老人"NOR, ({ "shengdan laoren", "laoren" }) );
        set("title",HIW"游侠笑传"NOR);
        set("gender", "男性" );
        set("shen_type", -1);
        set("age", 103);
        set("str", 25);
        set("con", 25);
        set("dex", 25);
        set("int", 25);
        set("long",@LONG
他是游侠笑传里的圣诞老人，专门负责派发圣诞礼物给玩家。
只见他身着红色礼服，头戴大红帽，络腮胡子又白又长，一
副笑呵呵而又让人可亲可敬的面孔，十分慈祥。
LONG
);

	set("no_kill",1);
        set("combat_exp", 1000000);
        set("attitude", "heroism");	        
        set_skill("blade", 50);
        set_skill("dodge", 40);
        set_skill("unarmed", 30);
        set_skill("parry", 50);
	set_temp("is_riding", HIW"雪鹿"NOR);

        setup();
        
        carry_object("/clone/cloth/lifu")->wear();
        carry_object("/clone/cloth/limao")->wear();
        carry_object("/clone/cloth/lixue")->wear();
}

        
void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("checking");
                call_out("checking", 1, ob);
        }
}

void checking(object ob)
{
        object obj;
        
	
	if(!ob->query("chirstmas") && ob->query("mud_age") > 21600) {
	command("say "+ RANK_D->query_respect(ob)+"，圣诞节到了，真是高兴！");
	command("say 这是圣诞节日礼物，给你吧！");
	message_vision("$N送给$n一份圣诞节礼物！\n",this_object(),ob);
	obj=new("clone/wizard/liwu"+random(3));
	obj->move(ob);
	ob->set("chirstmas",1);
	ob->save();
	return;
}

	if(ob->query("chirstmas")) {
	command("say "+ RANK_D->query_respect(ob)+"，圣诞节到了，真是高兴！");
	return;
	}

}