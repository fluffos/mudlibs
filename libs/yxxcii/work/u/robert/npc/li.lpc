// li.c

#include <ansi.h>

inherit NPC;

string ask_me(object who);

void create()
{
        set_name("李三", ({ "li san", "li" }) );
        set("title", HIR"快刀"NOR);
        set("gender", "男性" );
        set("shen_type", -1);
        set("age", 40);
        set("str", 25);
        set("con", 25);
        set("dex", 25);
        set("int", 25);
        set("long",
                "他就是江湖上人人闻风丧胆的快刀李三。\n" );

        set("combat_exp", 100000);
        set("attitude", "heroism");
        
        set_skill("blade", 50);
        set_skill("dodge", 40);
        set_skill("unarmed", 30);
        set_skill("parry", 50);
        
        setup();
        
        carry_object("/d/city/npc/obj/gangdao")->wield();
        carry_object("/d/city/npc/obj/cloth")->wear();
}

        
void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("checking");
                call_out("checking", 1, ob);
        }
}

void checking(object ob)
{
        int n;

        if( !ob || !present(ob, environment(this_object())) ) {
                if(ob == query_leader() )  set_leader(0);
                return;
        }

        if( ob->query("combat_exp") < 100000)
        {
                command("say 大爷今日让你见识一下快刀李三的厉害！");
                command("kill "+ ob->query("id"));
                return;
        }
        
        if( ob->query("combat_exp") > 100000)

{
        
        // 自动生成武功参数

        n = ob->query("combat_exp") + random(10000) - 7000;
        if( n <= 0 ) n = random(3000) + 1;
        set("combat_exp", n );

        n = ob->query_skill("force", 1) + random(10) - 7;
        if( n <= 0 ) n = random(3) + 1;
        set_skill("force", n );
        n = ob->query_skill("unarmed", 1) + random(10) - 7;
        if( n <= 0 ) n = random(3) + 1;
        set_skill("unarmed", n );
        n = ob->query_skill("force", 1) + random(10) - 7;
        if( n <= 0 ) n = random(3) + 1;
        set_skill("blade", n );                 // 本来的做法是取兵器中最强的一项，为了简单，这里用force取代
        n = ob->query_skill("parry", 1) + random(10) - 7;
        if( n <= 0 ) n = random(3) + 1;
        set_skill("parry", n );
        n = ob->query_skill("dodge", 1) + random(10) - 7;
        if( n <= 0 ) n = random(3) + 1;
        set_skill("dodge", n );

        n = ob->query_skill(ob->query_skill_mapped("force"), 1) + random(10) - 7;
        if( n <= 0 ) n = random(3) + 1;
        set_skill("taiji-shengong", n );
        n = ob->query_skill(ob->query_skill_mapped("force"), 1) + random(10) - 7;
        if( n <= 0 ) n = random(3) + 1;
        set_skill("xue-dao", n );
        n = ob->query_skill(ob->query_skill_mapped("dodge"), 1) + random(10) - 7;
        if( n <= 0 ) n = random(3) + 1;
        set_skill("tiyunzong", n );

        map_skill("dodge", "tiyunzong");
        map_skill("force", "taiji-shengong");
        map_skill("blade", "xue-dao");
        map_skill("parry", "xue-dao");

        command("say " + ob->name() + "，你死定了！！\n");
        set_leader(ob);

        command("kill " + ob->query("id") );

        }

}



void afterdie_func(object killer)
{
        object me;
        int m, n, i;

        me = this_object();
        message_vision("$N打败了李三，为江湖除去了一害。\n", me->name(),killer);
        message_vision("由于$N的侠义表现，$N得到了奖励。\n", killer);

        i = killer->query("combat_exp") / 10000;
        if( i > 500 ) i = 500;
        m = random(50) + i / 10 + 1;
        n = random(500) + i + 1;
        killer->add("potential", m);
        killer->add("combat_exp", n);
        tell_object(killer, sprintf("你的潜能增加了%s点！\n", chinese_number(m)));
        tell_object(killer, sprintf("你的经验增加了%s点！\n", chinese_number(n)));
}

