// anu.c 阿奴

inherit NPC;

string ask_help();

void create() {
  set_name("阿奴", ({ "a nu", "nu", "welcome" }));
  set("nickname", "游侠笑传迎客使者");
  set("gender", "女性");
  set("age", 21);
  set("per", 30);
  set("str", 20);
  set("long", @LONG
她是游侠笑传的迎客使者，如果你是新手，可以找她给你一些钱。
LONG
  );
  set("combat_exp", 2500000);
  set("attitude", "friendly");
  set("inquiry", ([
    "新手": (: ask_help :),
    "钱": (: ask_help :),
    "我要钱": (: ask_help :),
    //              "蝴蝶哥哥" : "蝴蝶哥哥正忙着呢，你找他有什么事情吗？\n";
  ]));

  setup();

  carry_object("/d/city/npc/obj/goldring.lpc")->wear();
  carry_object("/d/city/npc/obj/necklace.lpc")->wear();
  carry_object("/d/city/npc/obj/changjian.lpc")->wield();
  carry_object("/d/city/npc/obj/pink_cloth.lpc")->wear();
  carry_object("/d/city/obj/flower_shoe.lpc")->wear();

}

string ask_help() {
  object obj, ob, me, obj1;
  me = this_player();
  ob = this_object();


  if (me->query("help"))
    return "你不是已经拿了钱了吗？还想要？真是贪得无厌！";

  if (me->query("help"))
    return "你不是已经拿了钱了吗？还想要？真是贪得无厌！";

  if (present("gold" || "silver" || "coin" || "thousand-cash", me))
    return "你现在身上不是已经有钱了吗？";

  if (me->query("balance") > 2000)
    return "你钱庄里还有存款呢！？";

  if (query_temp("give_money") > 3)
    return "最后一笔钱已经被人拿走了。";

  obj = new("/clone/money/thousand-cash");
  obj->move(me);
  obj->move(me);
  add_temp("give_money", 1);
  me->save();

  message_vision("$N给了$n一叠银票。\n", ob, me);
  return "拿去吧！别乱花哦！";



}
