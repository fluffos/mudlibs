// yunyun.c 韵韵
#include <ansi.h>
inherit NPC;

string ask_help();
string ask_eat();
string ask_drink();

void create() {
  set_name("韵韵", ({ "yun yun", "yun" }));
  set("gender", "女性");
  set("title", "蝴蝶哥哥的女朋友");
  set("age", 21);
  set("per", 38);
  set("str", 20);
  set("long", @LONG
她就是蝴蝶哥哥的女朋友韵韵了。一双水灵灵的大
眼睛，樱桃小口不时抿抿一笑。
LONG
  );
  set("no_kill", 1);
  set("attitude", "friendly");
  set("chat_chance", 20);
  set("chat_msg", ({
    (: command("chat 好无聊呀！没人陪我聊聊天吗？") :),
    (: command("chat* :( ") : ),
    (: command("chat 蝴蝶哥哥，你在哪里呀？！") :),
    (: command("chat 蝴蝶哥哥，人家呆得好无聊啊，你又不陪我聊天。") :),
    (: command("chat* sigh") :),
    (: command("chat 大家陪我聊聊天好吗？我好无聊啊！") :),
    })
  );
set("inquiry", ([
  "蝴蝶哥哥": "蝴蝶哥哥是我的男朋友，不过他总是很忙......",
  "蝴蝶": "我最喜欢蝴蝶了，扑闪扑闪着翅膀飞来飞去，好美呀......",
  "逍遥": "逍遥呀，他可是蝴蝶哥哥的好朋友，蝴蝶哥哥和他可好了。",
  "逍遥先生": "逍遥呀，他可是蝴蝶哥哥的好朋友，蝴蝶哥哥和他可好了。",
  "狐狸": "狐狸伯伯是蝴蝶哥哥的师父，不过他总爱欺负蝴蝶哥哥。",
  "钱": (: ask_help :),
  "食物": (: ask_eat :),
  "水": (: ask_drink :),
]));

setup();

carry_object("/d/city/npc/obj/goldring.lpc")->wear();
carry_object("/d/city/npc/obj/necklace.lpc")->wear();
carry_object("/d/city/npc/obj/changjian.lpc")->wield();
carry_object("/d/city/npc/obj/pink_cloth.lpc")->wear();
carry_object("/d/city/obj/flower_shoe.lpc")->wear();

}

string ask_help() {
  object obj, ob, me;
  me = this_player();
  ob = this_object();


  if (me->query("help"))
    return "你不是已经拿了钱了吗？还想要？真是贪得无厌！";

  if (me->query("help"))
    return "你不是已经拿了钱了吗？还想要？真是贪得无厌！";

  if (present("gold" || "silver" || "coin" || "thousand-cash", me))
    return "你现在身上不是已经有钱了吗？";

  if (me->query("balance") > 2000)
    return "你钱庄里还有存款呢！？";

  if (query_temp("give_money") > 3)
    return "最后一笔钱已经被人拿走了。";

  obj = new("/clone/money/thousand-cash", 4);
  obj->move(me);
  obj->move(me);
  add_temp("give_money", 1);
  me->save();

  message_vision("$N给了$n一叠银票。\n", ob, me);
  return "拿去吧！别乱花哦！";
}

string ask_eat() {
  object obj, ob, me;

  me = this_player();
  ob = this_object();
  obj = new("/clone/food/baozi", 3);
  obj->move(me);
  message_vision("$N给了$n几个包子。\n", ob, me);
  return "快吃吧，别饿坏了身子。";

}

string ask_drink() {
  object obj, ob, me;

  me = this_player();
  ob = this_object();

  obj = new("/clone/food/jiudai");
  obj->move(me);
  message_vision("$N递给了$n一个牛皮酒袋。\n", ob, me);
  return "快喝吧，小心别呛着了。";

}
