#include <ansi.h>
#include <room.h>
inherit ROOM;


void create() {
  set("short", "蝴蝶居");
  set("long", @LONG
这里是蝴蝶君的避風港。只有在這裡，蝴蝶君才能夠找到片刻的安
寧。這裡雖然不大，但是裝飾得十分別致。一床軟綿綿的床被，收拾得
整整齊齊。你或許會疑惑，一個男人的房間爲什麽回收拾得這麽乾淨。
告訴你吧，是蝴蝶君的女朋友韵韵給收拾的。
LONG
  );

  set("sleep_room", 1);
  set("outdoors", "city");
