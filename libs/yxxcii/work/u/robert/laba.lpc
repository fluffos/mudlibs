// rose.c

#include <ansi.h>;
#include <command.h>;
inherit ITEM;

void create() {
  set_name("小喇叭", ({ "la ba", "la" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "支");
    set("long", @LONG
这是一支小喇叭，能够发出很大的声音。
LONG
    );
    set("value", 1);
    set_weight(10);
  }
  setup();
}
void init() {
  add_action("do_shuo", "shuo");
}

int do_shuo(string arg) {
  object room, me;

  me = this_player();

  if (!arg || arg == "") return notify_fail("你想要叫什么？\n");

  message(
    "channel:chat",
    HIG "〖游侠笑传广播站〗" + HIW + me->query("name") + "：" + arg + "....\n" NOR,
    users()
  );
  return 1;
}
