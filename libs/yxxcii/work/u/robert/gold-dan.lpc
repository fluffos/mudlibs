// gold-dan.c - 九转金丹

#include <ansi.h>

inherit ITEM;

void create()
{
        set_name( HIY "金色神丹" NOR, ({ "gold dan", "dan" }) );
        set("no_give", 1);
        set("no_drop",1);
        set("no_put",1);
        set("no_get",1);
        set("no_sell",1);

        if( clonep()) 
                set_default_object(__FILE__);
        else {  
                set("long", @LONG
这是可以内服（use）的"+ HIY + "金色神丹"+ NOR +"，它只是蝴蝶君用来
奖励比武大会获奖者的奖励品。
LONG
);
                
                set("unit", "颗");
                set("value", 0 );
        }

//        set_amount(1);
        setup();
}
void init()
{
	add_action("do_use","use");
}

int do_use(string arg)
{
	object me,ob;
	me = this_player();
	ob = this_object();
	if(!arg||arg =="")
		return notify_fail("什么？\n");
	if( !me->query("winner"))
		return notify_fail("你吃下去会被毒死的。\n");
	if( arg == "dan" || arg =="gold dan" && me->query("winner"))
{
		message_vision("$N吞下一颗"HIY"金色神丹"NOR"。\n",me);
		me->add("int",1);
		me->add("kar",1);
		me->add("str",1);
		me->add("con",1);
		me->add("per",1);
		me->add("dex",1);
		me->set("qi",(int)me->query("max_qi"));
		me->set("jing",(int)me->query("max_jing"));
		me->set("jingli",(int)me->query("max_jingli"));
		me->set("neili",(int)me->query("max_neili"));
		tell_object(me,"你的悟性增加了一点，你现在的悟性是："HIY + chinese_number(me->query("int"))+"\n"NOR);
		tell_object(me,"你的运气增加了一点，你现在的运气是："HIY + chinese_number(me->query("kar"))+"\n"NOR);
		tell_object(me,"你的臂力增加了一点，你现在的臂力是："HIY + chinese_number(me->query("str"))+"\n"NOR);
		tell_object(me,"你的根骨增加了一点，你现在的根骨是："HIY + chinese_number(me->query("con"))+"\n"NOR);
		tell_object(me,"你的容貌增加了一点，你现在的容貌是："HIY + chinese_number(me->query("per"))+"\n"NOR);
		tell_object(me,"你的身法增加了一点，你现在的身法是："HIY + chinese_number(me->query("dex"))+"\n"NOR);
		tell_object(me,HIC"你的体力也得到了恢复！\n"NOR);
		destruct(ob);
		return 1;
	}
}