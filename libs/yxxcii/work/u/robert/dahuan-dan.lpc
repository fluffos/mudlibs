// longyan-guo.c - 龙涎果

#include <ansi.h>

inherit ITEM;

void create()
{
        set_name( HIY "大还丹" NOR, ({ "dahuan dan", "dan" }) );
        set("no_give", 1);
        set("no_drop",1);
        set("no_put",1);
        set("no_get",1);

        if( clonep()) 
                set_default_object(__FILE__);
        else {  
                set("long", @TEXT
这是一颗可以服用(use)的大还丹，是蝴蝶君用来奖励比武大
会的胜利者。它可以使你的所有基本技能升级，并且获得五百
点潜能和两千点经验。
TEXT
                );
                
                set("unit", "颗");
                set("base_weight", 500);
                set("value", 0 );
        }

        setup();
}
void init()
{
	add_action("do_use","use");
}


int do_use(string arg)
{
	object me,ob;
        mapping skills_map, all_skills;
        string *base_skills;
        int i;
 	me = this_player();
 	ob = this_object();
        
        if(!arg||arg=="")
        	return notify_fail("什么？\n");
        if( !me->query("winner"))
        	return notify_fail("你吃下去会给毒死的。\n");
        if( arg == "dan" || arg == "dahuan dan" && me->query("winner"))
{	
        skills_map = me->query_skill_map();
        if( mapp(skills_map) || sizeof(skills_map) ) {
        base_skills = keys(skills_map);
        all_skills = me->query_skills();
        for( i = 0; i < sizeof(base_skills); i ++ ) {
                all_skills[ base_skills[i] ] ++;
                tell_object(me, "你的“" + to_chinese( base_skills[i] ) + "”升级了！\n");
			}
		}
        me->add("potential", 500);
        tell_object(me, "你的潜能增加了" + chinese_number( 500 ) + "点！\n");
        me->add("combat_exp", 2000);
        tell_object(me, "你的经验增加了" + chinese_number( 2000 ) + "点！\n");
	destruct(ob);
	}
	return 1;
}