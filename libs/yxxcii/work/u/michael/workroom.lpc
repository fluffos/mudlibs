inherit ROOM;
#include <ansi.h>

void create() {
  set("short", HIW "霹雳舞台" NOR);
  set("long", @LONG
这里就是天神“米高”的工作、休息室。这里布置非常的特别，宛如
一个大舞台。摆放着很多乐器，有爵士鼓啦、电吉他啦等等。上面还有一
幅很酷的图画，仔细一看，原来是Ｍｉｃｈａｅｌ　Ｊａｃｋｓｏｎ的海
报(poster)。
LONG
  );
  set("item_desc", ([
    "poster": @TEXT
                
          @@@@@@@@@@@@@_
        @@@@@@@@@@@@@@@@@  
        @@@@@@@@@@@@@@@@@
       @@@@@@@@@@@@@@@@@@@_ 
       @@@@@@@@@@@@@@@@@@@@
       @@@@@@@@@@@@@@@@@@@@@
  __@@@@@@@@@@@@@@@@@@@@@@@@@@@
@@@@@@@@@@@——-@C~~———W@@@@@@@@
@@@@@@@~-]@@@@@@@@@~@@@@@@@@@@@@@@@
@~@@@@r..]@@@@@@@@@.@@@@@@@@@~~~~~.
          ~-@@@@@@~.`-@@@@@~'
             ~~@%".....~~"
              ｜    
　　　　　　　 ｜    
　　　　　　　 ,_'-

TEXT
  ]));

  set("no_fight", 1);
  set("no_beg", 1);
  set("no_steal", 1);
  setup();
}

void init() {
  add_action("do_sleep", "sleep");
}
int do_sleep(string arg) {
  object me;
  me = this_player();
  if (me->query("id") != "michael")
    return notify_fail("你不是“米高”，你不能在这里睡觉！\n");
}
