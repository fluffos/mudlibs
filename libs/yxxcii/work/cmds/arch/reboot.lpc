
// reboot.c

#include <login.h>
#include <ansi.h>

int main(object me, string arg)
{
	string wiz_status;
	object npc;

	if( me != this_player(1) ) return 0;
	
	wiz_status = SECURITY_D->get_status(me);
	if( wiz_status != "(arch)" && wiz_status != "(admin)" )
	return notify_fail("只有 (admin) 以上的巫师才能重新启动.\n");

	message("channel:chat",HIY"〖系统精灵〗系统内部核心更新，准备重新启动，所有使用者资料正在存档中。\n" NOR,users());
	call_out("countdown", 30, 1);

	return 1;
}

void countdown(int min)
{
	min--;
	if( min ) {
	message("channel:chat",HIY"〖系统精灵〗系统内部核心更新，准备重新启动，所有使用者资料正在存档中。\n" NOR,users());
		call_out("countdown", 10, min);
	} else {
	message("channel:chat",HIY"〖系统精灵〗系统重新启动准备就绪，五秒后将重新启动，请各玩家做好准备。\n" NOR,users());
		call_out("do_shutdown", 5);
	}
}

void do_shutdown()
{
	shutdown(0);
}

int help (object me)
{
	write(@HELP
指令格式: reboot
 
重新起动游戏, 系统会开始倒数计时, 30秒後重新起动。
 
HELP
);
	return 1;
}



