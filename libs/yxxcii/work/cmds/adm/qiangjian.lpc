// qiangjian.c

#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg) {
  mapping fam;
  object obj, old_target, where = environment(me);
  int oexp, mexp;
  seteuid(getuid());

  if (environment(me)->query("no_steal") || environment(me)->query("no_fight"))
    return notify_fail("光天化日之下，你想干嘛？\n");

  if (!arg || !objectp(obj = present(arg, environment(me))))
    return notify_fail("你现在很冲动，可是一点辙都没有。\n");

  if (me->query("gender") == "无性")
    return notify_fail("你连那个工具都没有，还想干好事？\n");

  if (me->query("gender") == "女性")
    return notify_fail("哇！现在女人也想强奸别人了，太可怕了！\n");

  if (me->query("age") < 17)
    return notify_fail("你连十七岁都没到，就学坏啊！\n");
  if (obj->query_temp("qiangjian") > 0)
    return notify_fail("人家已经被强奸过了，你还想轮奸吗？\n");

  if (obj == me) return notify_fail("自己强奸自己？好象做不到嘛。\n");

  if (obj->query("gender") != "女性")
    return notify_fail("不对吧？！他好象不是女人吧。\n");

  if (obj->query("age") < 17)
    return notify_fail("人家还是幼女啊！\n");

  if (!obj->is_character()) return notify_fail("哇，死的东西都不放过！\n");

  if (!living(obj))
    return notify_fail(obj->name() + "立马被强奸了。好可怜！\n");

  if (!wizardp(me) && wizardp(obj))
    return notify_fail("强奸巫师？你不怕杀档？\n");

  if (me->is_fighting())
    return notify_fail("一边打架一边色迷迷？你真是活腻了！\n");

  if (obj->is_fighting())
    return notify_fail(obj->name() + "正在打架，你不怕被阉？\n");

  if (obj->query("race") == "人类" && obj->query("gender") == "女性")

    tell_object(me, "你用手轻抚着" + obj->name() + "又白又嫩的脸颊，轻声说道：“姐姐好生美丽，真是想煞小生了～～”\n");
  tell_object(me, "说完，你伸手把" + obj->name() + "抱在怀里，感受着" + obj->name() + "醉人的芳香。\n");
  tell_object(me, "你色胆横生，伸手便要去扯" + obj->query("name") + "的衣服！\n");
  tell_object(obj, me->name() + "用手轻抚着你的脸颊，轻声说道：“姐姐好生美丽，真是想煞小生了～～”\n");
  tell_object(obj, "说完，" + me->name() + "伸手把你抱在怀里，感受着你醉人的芳香。\n");
  tell_object(obj, me->name() + "凶巴巴地扑了过来，伸手就想扯脱你的衣服！\n\n");
  message(
    "vision",
    "只见" + me->name() + "恶狠狠地扑向" + obj->name() + "一把抓住她的衣服！\n\n",
    environment(me),
    ({ me, obj })
  );

  oexp = obj->query("combat_exp");
  mexp = me->query("combat_exp");

  if ((mexp < oexp) || (random(2)) == 1) {
    tell_object(me, HIR "糟糕！你惹错人了！\n\n" NOR);
    message_vision("$N粉脸一板，刮了$n一巴掌，大喝道：「$n这个大色狼！我杀了你！」\n", obj, me);
    if (userp(obj)) obj->fight_ob(me);
    else obj->kill_ob(me);
    me->fight_ob(obj);
    me->start_busy(3);
  } else {
    message_vision("$N被按到在地，大声呼救：有色狼！拼命挣扎。\n", obj, me);
    message_vision("$n一脸坏笑，继续着$n的下个动作。\n", obj, me);
    message_vision("悲惨的事终于发生在$N的身上了。\n", obj, me);
    tell_object(me, "你感觉一阵莫名的快感，精神为之一震！\n");
    tell_object(obj, "你只觉得一阵针刺般的痛楚，隐约听到了" + me->name() + "发出阵阵奸笑声～～\n");
    CHANNEL_D->do_channel(this_object(), "rumor",
      sprintf("%s把%s强奸了～～真是可怜～～", this_player()->query("name"), obj->query("name")));
    obj->unconcious();
    obj->add("eff_kee", -5);
    obj->set_temp("qiangjian", 1);
    me->set("kee", me->query("eff_kee"));
    me->set("force", me->query("max_force"));
    me->add("combat_exp", 2);
    me->add("SEN", -1000);
    me->set("couple/have_couple", 1);
    me->start_busy(3);
    me->set("rascal_flag", 1);
  }
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : rape | qiangjian <某人>

HELP
  );
  return 1;
}
