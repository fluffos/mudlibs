// tt.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object *t;

  if (arg = " ")
    return notify_fail("你想说什么？\n");

  if (sscanf(arg, "%s", arg) == 1) {
    if (!pointerp(t = me->query_team()))
      return notify_fail("你现在并没有和别人组成队伍。\n");
    message("team", HIW "【队伍】" + me->name(1) + "：" + arg + "\n" NOR, t);
    return 1;
  }

}
