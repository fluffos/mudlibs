// unchblk.c

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg)
{
        object ob;
        string who, ch_name;
        
        if (!arg)  return help(me);
                
        if (sscanf(arg, "%s %s", who, ch_name) != 2)
        {
                ch_name = "";
                if (sscanf(arg, "%s", who) != 1)  return help(me);
        }

        if (who == "rumor")
        {
                CHANNEL_D->set_block(who, 0);
                CHANNEL_D->do_channel(me, "sys", "谣言频道被打开了。\n");
                return 1;
        }
        
        if (who == "mud")
        {
                CHANNEL_D->set_block(who, 0);
                CHANNEL_D->do_channel(me, "sys", "MUD频道被打开了。\n");
                return 1;
        }
        
        if (who == "chat")
        {
                CHANNEL_D->set_block(who, 0);
                CHANNEL_D->do_channel(me, "sys", "聊天频道被打开了。\n");
                return 1;
        }
        if (who == "news")
        {
                CHANNEL_D->set_block(who, 0);
                CHANNEL_D->do_channel(me, "sys", "新闻频道被打开了。\n");
                return 1;
        }
        if (who == "es")
        {
                CHANNEL_D->set_block(who, 0);
                CHANNEL_D->do_channel(me, "sys", "网际频道被打开了。\n");
                return 1;
        }
        if (who == "music")
        {
                CHANNEL_D->set_block(who, 0);
                CHANNEL_D->do_channel(me, "sys", "音乐频道被打开了。\n");
                return 1;
        }
        
        if (who == "all")
        {
                CHANNEL_D->set_block("rumor", 0);
                CHANNEL_D->set_block("chat", 0);
                CHANNEL_D->set_block("mud", 0);
                CHANNEL_D->set_block("news", 0);
                CHANNEL_D->set_block("es", 0);
                CHANNEL_D->set_block("music", 0);
                CHANNEL_D->do_channel(me, "sys", "所有频道被打开了。\n");
                return 1;
        }
        
        ob = LOGIN_D->find_body(who);
        if (!ob) return notify_fail("现在没有这个人。\n");
        
        if (ch_name == "" || ch_name == " " || ch_name == "all")
        {               
                if ((int)ob->query("chblk_on")) ob->delete("chblk_on");
                if ((int)ob->query("chblk_rumor")) ob->delete("chblk_rumor");
                if ((int)ob->query("chblk_chat")) ob->delete("chblk_chat");
                if ((int)ob->query("chblk_mud")) ob->delete("chblk_mud");
	        if ((int)ob->query("chblk_music")) ob->delete("chblk_music");
                if ((int)ob->query("chblk_es")) ob->delete("chblk_es");
                if ((int)ob->query("chblk_news")) ob->delete("chblk_news");
		if (ob->query("chblk_time")) ob->delete("chblk_time");
		
                tell_object(me, (string)ob->query("name") + "的频道被打开了。\n");
        } else if (ch_name == "rumor")  
        {
                if ((int)ob->query("chblk_on"))
                {
                        ob->delete("chblk_on");
                        ob->set("chblk_chat", 1);
                        ob->set("chblk_mud", 1);
                }
                
                if ((int)ob->query("chblk_rumor")) ob->delete("chblk_rumor");
                tell_object(me, (string)ob->query("name") + "的谣言频道被打开了。\n");
        } else if (ch_name == "mud")  
        {
                if ((int)ob->query("chblk_on"))
                {
                        ob->delete("chblk_on");
                        ob->set("chblk_chat", 1);
                        ob->set("chblk_rumor", 1);
                }
                
                if ((int)ob->query("chblk_mud")) ob->delete("chblk_mud");
                tell_object(me, (string)ob->query("name") + "的MUD频道被打开了。\n");
        } else if (ch_name == "chat")
        {
                if ((int)ob->query("chblk_on"))
                {
                        ob->delete("chblk_on");
                        ob->set("chblk_rumor", 1);
                        ob->set("chblk_mud", 1);
                }
                if ((int)ob->query("chblk_chat")) ob->delete("chblk_chat");
                tell_object(me, (string)ob->query("name") + "的聊天频道被打开了。\n");
        }else if (ch_name == "es")
        {
                if ((int)ob->query("chblk_on"))
                {
                        ob->delete("chblk_on");
                        ob->set("chblk_es", 1);
                }
                if ((int)ob->query("chblk_chat")) ob->delete("chblk_chat");
                tell_object(me, (string)ob->query("name") + "的网际频道被打开了。\n");
        } else if (ch_name == "news")
        {
                if ((int)ob->query("chblk_on"))
                {
                        ob->delete("chblk_on");
                        ob->set("chblk_news", 1);
                }
                if ((int)ob->query("chblk_chat")) ob->delete("chblk_chat");
                tell_object(me, (string)ob->query("name") + "的新闻频道被打开了。\n");
        } else if (ch_name == "music")
        {
                if ((int)ob->query("chblk_on"))
                {
                        ob->delete("chblk_on");
                        ob->set("chblk_music", 1);
                }
                if ((int)ob->query("chblk_chat")) ob->delete("chblk_chat");
                tell_object(me, (string)ob->query("name") + "的音乐频道被打开了。\n");
        } else 
                return help(me);
        
        return 1;
}

int help(object me)
{
        write(@HELP
指令格式：unchblk <某人>                显示某人当前的频道状态
          unchblk <某人> <频道名>       打开某人的某个频道
          unchblk <频道名>              打开全体人员的某个频道
          
<频道名>：可以是rumor、chat、mud或者all。

HELP
        );
        
        return 1;
}
