// pwd.c

inherit F_CLEAN_UP;
#include <ansi.h>

int main(object me, string arg) {
  if (!arg) {
    write(HIY "目前所在目录: " HIW + (string)me->query("cwd") + "\n" NOR);
    write(HIY "目前所读档案: " HIW + (string)me->query("cwf") + "\n" NOR);
    return 1;
  }
}

int help(object me) {
  write(@HELP
指令格式 : pwd
 
这个指令会显示出你目前的工作目录 (cwd) 及工作档案 (cwf).
'update' 不加参数时便会更新你的 cwf.
 
HELP
  );
  return 1;
}
