// chblk.c

#include <globals.h>

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg) {
  object ob;
  string who, ch_name;

  if (!arg) return help(me);

  if (sscanf(arg, "%s %s", who, ch_name) != 2) {
    ch_name = "";
    if (sscanf(arg, "%s", who) != 1) return help(me);
  }

  if (who == "rumor") {
    CHANNEL_D->set_block("rumor", 1);
    CHANNEL_D->do_channel(me, "sys", "谣言频道关闭了。\n");
    return 1;
  }
  if (who == "es") {
    CHANNEL_D->set_block("es", 1);
    CHANNEL_D->do_channel(me, "sys", "网际频道关闭了。\n");
    return 1;
  }
  if (who == "music") {
    CHANNEL_D->set_block("music", 1);
    CHANNEL_D->do_channel(me, "sys", "音乐频道关闭了。\n");
    return 1;
  }
  if (who == "news") {
    CHANNEL_D->set_block("rumor", 1);
    CHANNEL_D->do_channel(me, "sys", "新闻频道关闭了。\n");
    return 1;
  }
  if (who == "chat") {
    CHANNEL_D->set_block("chat", 1);
    CHANNEL_D->do_channel(me, "sys", "聊天频道关闭了。\n");
    return 1;
  }

  if (who == "mud") {
    CHANNEL_D->set_block("mud", 1);
    CHANNEL_D->do_channel(me, "sys", "MUD关闭了。\n");
    return 1;
  }

  if (who == "all") {
    CHANNEL_D->set_block("rumor", 1);
    CHANNEL_D->set_block("chat", 1);
    CHANNEL_D->set_block("mud", 1);
    CHANNEL_D->set_block("es", 1);
    CHANNEL_D->set_block("news", 1);
    CHANNEL_D->set_block("music", 1);
    CHANNEL_D->do_channel(me, "sys", "所有频道关闭了。\n");
    return 1;
  }
  ob = LOGIN_D->find_body(who);
  if (!ob) return notify_fail("现在没有这个人。\n");
  if (wizardp(ob)) return notify_fail("不能关闭巫师的频道。\n");

  if (ch_name == "" || ch_name == " ") {
    if (ob->query("chblk_on")
      || ob->query("chblk_rumor")) {
      tell_object(me, (string)ob->query("name") + "的谣言频道是关闭的。\n");
    }
    if (ob->query("chblk_on")
      || ob->query("chblk_chat")) {
      tell_object(me, (string)ob->query("name") + "的聊天频道是关闭的。\n");
    }
    if (ob->query("chblk_on")
      || ob->query("chblk_mud")) {
      tell_object(me, (string)ob->query("name") + "的MUD频道是关闭的。\n");
    }
    if (ob->query("chblk_on")
      || ob->query("chblk_es")) {
      tell_object(me, (string)ob->query("name") + "的网际频道是关闭的。\n");
    }
    if (ob->query("chblk_on")
      || ob->query("chblk_news")) {
      tell_object(me, (string)ob->query("name") + "的新闻频道是关闭的。\n");
    }
    if (ob->query("chblk_on")
      || ob->query("chblk_music")) {
      tell_object(me, (string)ob->query("name") + "的音乐频道是关闭的。\n");
    }
    if (!(ob->query("chblk_on")
      || ob->query("chblk_rumor")
      || ob->query("chblk_mud")
      || ob->query("chblk_chat")
      || ob->query("chblk_es")
      || ob->query("chblk_music")
      || ob->query("chblk_news"))) {
      tell_object(me, (string)ob->query("name") + "没有被关闭的频道。\n");
    }
  } else if (ch_name == "rumor") {
    if (ob->query("chblk_on") || ob->query("chblk_rumor")) {
      tell_object(me, (string)ob->query("name") + "的谣言频道已经是关闭的了。\n");
    } else {
      if (ob->query("chblk_chat") && ob->query("chblk_mud")) {
        ob->delete("chblk_chat");
        ob->delete("chblk_mud");
        ob->set("chblk_on", 1);
        ob->set("chblk_time", ob->query("mud_age"));
      } else {
        ob->set("chblk_rumor", 1);
        ob->set("chblk_time", ob->query("mud_age"));
      }
      tell_object(me, (string)ob->query("name") + "的谣言频道被关闭了。\n");
    }
  } else if (ch_name == "all") {
    if (ob->query("chblk_on")) {
      tell_object(me, (string)ob->query("name") + "的频道已经是关闭的了。\n");
    } else {
      ob->set("chblk_on", 1);
      ob->delete("chblk_rumor");
      ob->delete("chblk_chat");
      ob->delete("chblk_mud");
      ob->delete("chblk_es");
      ob->delete("chblk_music");
      ob->delete("chblk_news");

      ob->set("chblk_time", ob->query("mud_age"));
      tell_object(me, (string)ob->query("name") + "的频道被关闭了。\n");
    }
  } else if (ch_name == "chat") {
    if (ob->query("chblk_on") || ob->query("chblk_chat")) {
      tell_object(me, (string)ob->query("name") + "的聊天频道已经是关闭的了。\n");
    } else {
      if (ob->query("chblk_chat")) {
        ob->delete("chblk_chat");
        ob->set("chblk_on", 1);
        ob->set("chblk_time", ob->query("mud_age"));
      } else {
        ob->set("chblk_chat", 1);
        ob->set("chblk_time", ob->query("mud_age"));
      }
      tell_object(me, (string)ob->query("name") + "的聊天频道被关闭了。\n");
    }
  } else if (ch_name == "mud") {
    if (ob->query("chblk_on") || ob->query("chblk_mud")) {
      tell_object(me, (string)ob->query("name") + "的MUD频道已经是关闭的了。\n");
    } else {
      if (ob->query("chblk_mud")) {
        ob->delete("chblk_mud");
        ob->set("chblk_on", 1);
        ob->set("chblk_time", ob->query("mud_age"));
      } else {
        ob->set("chblk_mud", 1);
        ob->set("chblk_time", ob->query("mud_age"));
      }
      tell_object(me, (string)ob->query("name") + "的MUD频道被关闭了。\n");
    }
  } else if (ch_name == "es") {
    if (ob->query("chblk_on") || ob->query("chblk_es")) {
      tell_object(me, (string)ob->query("name") + "的网际频道已经是关闭的了。\n");
    } else {
      if (ob->query("chblk_es")) {
        ob->delete("chblk_es");
        ob->set("chblk_on", 1);
        ob->set("chblk_time", ob->query("mud_age"));
      } else {
        ob->set("chblk_es", 1);
        ob->set("chblk_time", ob->query("mud_age"));
      }
      tell_object(me, (string)ob->query("name") + "的聊天频道被关闭了。\n");
    }
  } else if (ch_name == "news") {
    if (ob->query("chblk_on") || ob->query("chblk_news")) {
      tell_object(me, (string)ob->query("name") + "的聊天频道已经是关闭的了。\n");
    } else {
      if (ob->query("chblk_news")) {
        ob->delete("chblk_news");
        ob->set("chblk_on", 1);
        ob->set("chblk_time", ob->query("mud_age"));
      } else {
        ob->set("chblk_news", 1);
        ob->set("chblk_time", ob->query("mud_age"));
      }
      tell_object(me, (string)ob->query("name") + "的新闻频道被关闭了。\n");
    }
  } else if (ch_name == "music") {
    if (ob->query("chblk_on") || ob->query("chblk_music")) {
      tell_object(me, (string)ob->query("name") + "的聊天频道已经是关闭的了。\n");
    } else {
      if (ob->query("chblk_music")) {
        ob->delete("chblk_music");
        ob->set("chblk_on", 1);
        ob->set("chblk_time", ob->query("mud_age"));
      } else {
        ob->set("chblk_music", 1);
        ob->set("chblk_time", ob->query("mud_age"));
      }
      tell_object(me, (string)ob->query("name") + "的音乐频道被关闭了。\n");
    }
  } else {
    return help(me);
  }

  return 1;
}

int help(object me) {
  write(@HELP
指令格式：chblk <某人>                  显示某人当前的频道状态
          chblk <某人> <频道名>         关闭某人的某个频道
          chblk <频道名>                关闭全体人员的某个频道
          
<频道名>：可以是rumor、chat、mud或者all。

HELP
  );

  return 1;
}
