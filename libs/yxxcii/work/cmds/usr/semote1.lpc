#include "/doc/help.h"

inherit F_CLEAN_UP;

int main(object me, string arg) {
  string *e, msg, str;
  int i;
  mapping emote = EMOTE_D->all_emote();
  e = sort_array(EMOTE_D->query_all_emote(), 1);
  msg = "\n";

  for (i = 0; i < sizeof(e); i++) {
    if (emote[e[i]]["others_target"])
      str = emote[e[i]]["others_target"];
    else {
      if (emote[e[i]]["others"])
        str = emote[e[i]]["others"];
      else str = emote[e[i]]["others_self"];
    }
    if (!str) continue;
    str = replace_string(str, "$n", "某人");
    str = replace_string(str, "$N", "你");
    str = replace_string(str, "$p", "他");
    str = replace_string(str, "$s", "壮士");
    str = replace_string(str, "$r", "小王八蛋");
    msg += e[i] + "\n";
    msg += str;
  }

  msg += "\n";
  me->start_more(msg);

  return 1;
}

int help(object me) {
  write(@HELP
指令格式：semote1	   用中文列出目前所能使用的emote

相关讯息：semote
HELP
  );

  return 1;
}
