
// wizlist.c
// update by oak@SDXL 1999.10
// Give the information of the player

#include <mudlib.h>
#include <ansi.h>

inherit F_CLEAN_UP;

int level(mixed, mixed);
string check_all();

void create()
{
	seteuid(getuid());
}
int main(object me, string arg)
{		   me->start_more( check_all() );
	return 1;
}


string check_all()
{
	object *ob;
	string msg, fip;
	int i;

	ob = children("/clone/user/user");
	msg = "";
	if ( !wizardp(this_player()) )  // player's show
	{
		for(i=0; i<sizeof(ob)-1; i++) {
			if( this_player() && !this_player()->visible(ob[i]) ) continue;
			msg = sprintf("%s%-14s%-14s%-14s\n",
				msg, ob[i]->query("name"),SECURITY_D->get_status(ob[i]->query("id"))!="(player)"? HIW+"巫师"+NOR:NOR+"玩家" ,
				((int)query_ip_name(ob[i])!=0)? HIY+"连线"+NOR:"离线" );
		}
	return "◎ "+MUD_NAME+"\n" +
		"——————————————————\n"
		+ "姓名	  身份 状态	   \n" +
		"——————————————————\n"
		+ msg +
		"——————————————————\n";
	} else	  // wizard's show
	{
		for(i=0; i<sizeof(ob)-1; i++) {
			if( this_player() && !this_player()->visible(ob[i]) ) continue;
			msg = sprintf("%s%-14s%-14s%-14s%-7s%s\n",
				msg, ob[i]->query("name"),
				ob[i]->query("id"),
				SECURITY_D->get_status(ob[i]->query("id")),
				((int)query_ip_name(ob[i])!=0)? HIY+"连线"+NOR:"离线" , query_ip_number(ob[i]));
		}
		return "◎ "+MUD_NAME+"\n" + 
		"—————————————————————————————————————\n"
		+ "姓名	  帐号	  身份	  状态   连线\n" +
		"—————————————————————————————————————\n"
		+ msg +
		"—————————————————————————————————————\n";
	}
}
	
