// quit.c
#include <ansi.h>
#include <command.h>

inherit F_DBASE;
inherit F_CLEAN_UP;

void create() {
  seteuid(getuid());
  set("name", "离线指令");
  set("id", "quit");
  set("channel_id", "离线精灵");
}

int main(object me, string arg) {
  int i, j;
  object *inv, link_ob;

  if (LOGIN_D->get_madlock())
    return notify_fail("时空已经封闭，没有人能够退出这个时空了。\n");
  if (me->is_busy()) return notify_fail("你现在正忙着做其他事，不能退出游戏！\n");
  if (me->query_temp("sleeped")) me->set("marks/insleeping", 1);
  if (environment(me)->query("parsion_room"))
    return notify_fail("你逃不掉的啦，老老实实呆着吧！\n");
  if (me->over_encumbranced())
    return notify_fail("身上带的东西太多了，离不开游戏了。\n");

  if (me->query("id") != "robert") {
    inv = all_inventory(me);
    for (i = 0; i < sizeof(inv); i++)
      if (!inv[i]->query_autoload())
        DROP_CMD->do_drop(me, inv[i]);
  }

  link_ob = me->query_temp("link_ob");

  // We might be called on a link_dead player, so check this.
  if (link_ob) {

    // Are we possessing in others body ?
    if (link_ob->is_character()) {
      write("你的魂魄回到" + link_ob->name(1) + "的身上。\n");
      exec(link_ob, me);
      link_ob->setup();
      return 1;
    }

    link_ob->set("last_on", time());
    link_ob->set("last_from", query_ip_name(me));
    link_ob->save();
    destruct(link_ob);
  }

  write(HIW "\n欢迎您下次再来！再见！！\n" NOR);
  if (me->query("id") != "robert") {
    message("system", me->name() + "离开游戏。\n", environment(me), me);
  }
  i = me->query("combat_exp") - me->query_temp("temp_exp");
  if (i < 0) i = 0;
  j = me->query("potential") - me->query_temp("temp_pot");
  if (!wizardp(me)) {
    if (me->query("gender") == "女性") {
      message(
        "channel:chat",
        HIG "〖天下公告〗" HIW "一代女侠" + me->name(1) + "退隐江湖，告老还乡去了！\n" NOR,
        users()
      );
    } else {
      message(
        "channel:chat",
        HIG "〖天下公告〗" HIW "一代侠客" + me->name(1) + "退隐江湖，告老还乡去了！\n" NOR,
        users()
      );
    }

    CHANNEL_D->do_channel(this_object(), "sys",
      me->name() + "(" + me->query("id") + ")离开游戏了。共清除 " +
      reclaim_objects() + " 个变数。\n" + "\t本次连线经验增长" + i +
      ",潜能增长" + j + "。\n\t连线时间" + CHINESE_D->chinese_period(FINGER_D->online_time(me)) + "。\n");
  }
  //add check exp by ymh
  if ((int)me->query("combat_exp") - (int)me->query("exp") >= 10000
    || (int)me->query("exp") - (int)me->query("combat_exp") >= 10000) {
    log_file("nosave/WARNING", sprintf("%s（%s） 在 %s 退出。经验：%d -> %d\n",
      me->query("name"), me->query("id"),
      ctime(time()),
      (int)me->query("exp"), (int)me->query("combat_exp")));
  }
  if ((int)me->query("potential") - (int)me->query("pot") >= 1000
    || (int)me->query("pot") - (int)me->query("potential") >= 1000) {
    log_file("nosave/WARNING", sprintf("%s（%s） 在 %s 退出。潜能：%d -> %d\n",
      me->query("name"), me->query("id"),
      ctime(time()),
      (int)me->query("pot") - (int)me->query("learned_points"),
      (int)me->query("potential") - (int)me->query("learned_points")));
  }
  me->save();
  destruct(me);

  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : quit | exit

当你(你)想暂时离开时, 可利用此一指令。
HELP
  );
  return 1;
}
