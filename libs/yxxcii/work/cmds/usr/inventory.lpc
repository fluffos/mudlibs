// inventory.c
#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object *inv, ob;
  int i, j, k, l;
  mapping *data;
  string str;

  k = 0;
  str = "";
  data = allocate(3000);

  if (wizardp(me) && arg) {
    ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) ob = present(arg, environment(me));
  }

  if (!ob) ob = me;

  inv = all_inventory(ob);
  if (!sizeof(inv)) {
    write((ob == me) ? "目前你身上没有任何东西。\n"
      : ob->name() + "身上没有携带任何东西。\n");
    return 1;
  }
  for (i = 0; i < sizeof(inv); i++) {
    reset_eval_cost();
    if (!inv[i]->query("equipped")
      && !inv[i]->query("money_id")
      && !inv[i]->query_temp("check_only")) {
      data[k] = ([]);
      for (j = i; j < sizeof(inv); j++) {
        reset_eval_cost();
        if (inv[i]->query("name") == inv[j]->query("name")
          && inv[i]->query("id") == inv[j]->query("id")
          //				  &&   inv[i]->query("value")==inv[j]->query("value")
          && !inv[j]->query_temp("check_only")) {
          data[k]["id"] = inv[i]->short();
          data[k]["unit"] = inv[i]->query("unit");
          //					  data[k]["value"]=inv[i]->query("value");
          data[k]["num"] = data[k]["num"] + 1;
          inv[j]->set_temp("check_only", 1);
        } else continue;
      }
      k++;
    } else continue;
  }

  printf("%s身上带著下列这些东西(负重 %d%%)：\n",
    (ob == me) ? "你" : ob->name(),
    (int)ob->query_encumbrance() * 100 / (int)ob->query_max_encumbrance());

  for (i = 0; i < sizeof(inv); i++) {
    if (!inv[i]->query_temp("check_only"))
      printf("%s%s\n", inv[i]->query("equipped") ? HIC "□" NOR : "  ", inv[i]->short());
  }

  for (i = 0; i < sizeof(inv); i++)
    if (inv[i]->query_temp("check_only"))
      inv[i]->delete_temp("check_only");

  if (k > 0) {
    for (l = 0; l < k; l++)
      str = sprintf(
        "%s%s%s\n",
        str,
        "  " + chinese_number(data[l]["num"]) + data[l]["unit"],
        data[l]["id"]
      );
  }
  write(str);

  return 1;
}

int help(object me) {
  write(@HELP
指令格式: inventory

可列出你(你)目前身上所携带的所有物品。

注 : 此指令可以 " i " 代替。

HELP
  );
  return 1;
}
