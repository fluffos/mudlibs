
// setfrd.c
// modified by roro@YXXZ 1999 
#define MAX_FRIENDS	 20
 
inherit F_CLEAN_UP;
#include <login.h> 
#include <ansi.h>
 
int main(object me, string arg)
{
	 int i,j;
	 object ob;
	 string *termi,*termn;
	 mapping friends,friends_name,friends_id;
 
	 friends = me->query("friends");
	 friends_name = me->query("friends/name");
	 friends_id = me->query("friends/id");
	 seteuid(ROOT_UID);
	 ob = new(LOGIN_OB);
	 ob->set("id", arg);	

	if( !arg || arg=="" ) {
		write(HIG+"你目前设定的好友名单如下：\n"+NOR);
		if( !mapp(friends) || !sizeof(friends_id) )
			write(HIC+"\t没有设定任何好友。\n"+NOR);
		else {
			termn = keys(friends_name);
			termi = keys(friends_id);
			for(i=0; i<sizeof(termn); i++)
				 printf(HIC"%s  "NOR, termn[i]); 
				 printf("\n");
		}
		return 1;
	}
	if( arg && arg!="" ) {
		
		if( mapp(friends) && undefinedp(friends[arg]) && sizeof(friends) >= MAX_FRIENDS )
		return notify_fail(HIR"你设的好友太多了，请先用 unsetfrd 删掉几个吧。\n"NOR);
		if( ob->query("id")==me->query("id"))
		return notify_fail(HIR"别开玩笑了,自己都不认识吗!\n"NOR);
		if( !ob->restore() ) {
		write(HIG+"没有这个玩家: "+HIC+arg+" \n"+NOR);
		destruct(ob);
		return 1;
		}
		me->set("friends/name/" + ob->query("name"), 1);
		me->set("friends/id/"+ arg ,1);
		tell_object(me,HIG"你将 "HIC+ob->query("name")+HIG" 加入你的好友名单. \n"NOR);
		message("channel:rumor", HIR"〖武林传闻〗"+me->name(1)+"将"+ob->query("name")+"加入好友名单。\n"NOR,users());
		return 1;
	}
	return 0;
}
int help(object me)
{
	write(@HELP
指令格式 :	setfrd		查看你的好友名单.
		setfrd (id)	将某人加入你 的好友名单,最多加 20 个. 
		unsetfrd (id)   将对方移出好友名单
HELP
	);
	return 1;
}

