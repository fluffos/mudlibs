// singsong.c
//edited bye potato on Sep 12,1999

#include <ansi.h>

int main(object me, string arg) {
  if (!arg) {
    write("你低声哼着歌。\n");
    message("sound", me->name() + "低声哼着不知道什么歌。\n",
      environment(me), me);
    return 1;
  }

  if ((int)me->query("qi") < (int)me->query("max_qi") / 5) {
    arg = replace_string(arg, " ", " ... ") + " ...";
  }

  arg = replace_string(arg, "$BLK$", BLK);
  arg = replace_string(arg, "$RED$", RED);
  arg = replace_string(arg, "$GRN$", GRN);
  arg = replace_string(arg, "$YEL$", YEL);
  arg = replace_string(arg, "$BLU$", BLU);
  arg = replace_string(arg, "$MAG$", MAG);
  arg = replace_string(arg, "$CYN$", CYN);
  arg = replace_string(arg, "$WHT$", WHT);
  arg = replace_string(arg, "$HIR$", HIR);
  arg = replace_string(arg, "$HIG$", HIG);
  arg = replace_string(arg, "$HIY$", HIY);
  arg = replace_string(arg, "$HIB$", HIB);
  arg = replace_string(arg, "$HIM$", HIM);
  arg = replace_string(arg, "$HIC$", HIC);
  arg = replace_string(arg, "$HIW$", HIW);
  arg = replace_string(arg, "$NOR$", NOR BLINK);

  write("你唱到：" BLINK + arg + "\n" NOR);
  say(me->name() + "唱道：" BLINK + arg + "\n" NOR, me);

  // The mudlib interface of say
  all_inventory(environment(me))->relay_say(me, arg);

  return 1;
}

int help(object me) {
  write(@HELP
指令格式: singsong <讯息>
 
唱歌，所有跟你在同一个房间的人都会听到你唱的歌。
颜色使用参照 nick 命令	

HELP
  );
  return 1;
}

string short_help() {
  return "唱歌";
}
