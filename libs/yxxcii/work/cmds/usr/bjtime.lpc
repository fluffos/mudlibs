#include <mudlib.h>
#include <ansi.h>
inherit F_CLEAN_UP;

int main() {

  string week, month, c_week, time99, welcome;
  int day, hour, minute, second, year, y1, y2, y3, y4, c_month;

  // e_time must is ctime(time string) like "Sun May  3 00:52:12 1998"

  sscanf(ctime(time()), "%s %s %d %d:%d:%d %d", week, month, day, hour, minute, second, year);

  if (week == "Mon") c_week = HIC "星期一";
  else if (week == "Tue") c_week = HIC "星期二";
  else if (week == "Wed") c_week = HIC "星期三";
  else if (week == "Thu") c_week = HIC "星期四";
  else if (week == "Fri") c_week = HIC "星期五";
  else if (week == "Sat") c_week = HIR "星期六";
  else if (week == "Sun") c_week = HIR "星期天";

  if (month == "Jan") c_month = 1;
  else if (month == "Feb") c_month = 2;
  else if (month == "Mar") c_month = 3;
  else if (month == "Apr") c_month = 4;
  else if (month == "May") c_month = 5;
  else if (month == "Jun") c_month = 6;
  else if (month == "Jul") c_month = 7;
  else if (month == "Aug") c_month = 8;
  else if (month == "Sep") c_month = 9;
  else if (month == "Oct") c_month = 10;
  else if (month == "Nov") c_month = 11;
  else if (month == "Dec") c_month = 12;

  if (hour < 6 && hour > 0) { time99 = HIW "凌晨" NOR; welcome = HIW "要保重身体哦!" NOR; } else if (hour < 8 && hour >= 6) {
    time99 = HIM "早上" NOR; welcome = HIM "新的一天又开始了,加油哦!" NOR;
  } else if (hour < 12 && hour >= 8) { time99 = HIY "上午" NOR; welcome = HIY "小心别被老板抓住哦!" NOR; } else if (hour == 12) {
    time99 = HIR "中午" NOR; welcome = HIR "你真用功!多多加油!" NOR;
  } else if (hour < 19 && hour > 12) { time99 = HIC "下午" NOR; welcome = HIC "外面阳光还好吧!" NOR; } else if (hour < 24 && hour >= 19) {
    time99 = HIB "晚上" NOR; welcome = HIB "不用陪女朋友吗?" NOR;
  } else if (hour == 24 || hour == 0) { time99 = HIR "子夜" NOR; welcome = HIR "别玩的太晚了!" NOR; }

  if (hour > 12) {
    if (hour == 13) hour = 1;
    else if (hour == 14) hour = 2;
    else if (hour == 15) hour = 3;
    else if (hour == 16) hour = 4;
    else if (hour == 17) hour = 5;
    else if (hour == 18) hour = 6;
    else if (hour == 19) hour = 7;
    else if (hour == 20) hour = 8;
    else if (hour == 21) hour = 9;
    else if (hour == 22) hour = 10;
    else if (hour == 23) hour = 11;
    else if (hour == 24) hour = 0;
  }

  y1 = year / 1000;
  y2 = year / 100 - 20 + 10;
  y3 = year / 10 - 200 + 10;
  y4 = year - 2000 + 10;

  printf("现在是北京时间：" + MAG + "%s%s%s%s" + NOR + "年" + MAG + "%s" + NOR + "月" + MAG + "%s" + NOR + "日%s" + MAG + "%s" + NOR + "点" + MAG + "%s" + NOR + "分" + MAG + "%s" + NOR + "秒 %s" + NOR "。\n%s\n",
    chinese_number((int)y1), chinese_number(y2), chinese_number(y3), chinese_number(y4),
    chinese_number(c_month), chinese_number(day), time99, chinese_number(hour),
    chinese_number(minute), chinese_number(second), c_week, welcome);
  return 1;

}
