// score.c

#include <ansi.h>
#include <combat.h>

inherit F_CLEAN_UP;

string bar_string = "■■■■■■■■■■■■■■■■";
string blank_string = "□□□□□□□□□□□□□□□□";
string display_attr(int gift, int value);
string status_color(int current, int max);
string date_string(int date);
string tribar_graph(int val, int eff, int max, string color);

void create() { seteuid(ROOT_UID); }

int main(object me, string arg) {
  object ob;
  mapping my;
  string line, str, skill_type;
  object weapon;
  int attack_points, dodge_points, parry_points, lvl;
  seteuid(getuid(me));

  if (!arg)
    ob = me;
  else if (wizardp(me)) {
    ob = present(arg, environment(me));
    if (!ob) ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) return notify_fail("你要察看谁的状态？\n");
  } else
    return notify_fail("只有巫师能察看别人的状态。\n");

  my = ob->query_entire_dbase();
  line = sprintf(BOLD "  %s" NOR "%-10s\n\n", RANK_D->query_rank(ob), ob->short(1));

  if (userp(ob))
    line += sprintf("  你今年%s岁，出生于：%s。\n",
      chinese_number(ob->query("age")),
      CHINESE_D->chinese_date(((int)ob->query("birthday") - 14 * 365 * 24 * 60) * 60));
  else
    line += sprintf("  %s今年%s岁，出生于：%s。\n",
      ob->query("name"),
      chinese_number(ob->query("age")),
      CHINESE_D->chinese_date(((int)ob->query("birthday") - 14 * 365 * 24 * 60) * 60));
  if (userp(ob))
    if (ob->query("family")) {
      line += sprintf("  你是%s第%s代%s，你的师父是：%s\n",
        ob->query("family/family_name"),
        chinese_number(ob->query("family/generation")),
        ob->query("family/title"),
        ob->query("family/master_name"));
    }
  if (!userp(ob) && ob->query("family"))
    line += sprintf("  %s是%s第%s代%s，%s的师父是：%s\n",
      ob->query("name"),
      ob->query("family/family_name"),
      chinese_number(ob->query("family/generation")),
      ob->query("family/title"),
      ob->query("name"),
      ob->query("family/master_name"));
  if ((int)ob->query("balance") > 0)
    line += "  你目前在钱庄里共有存款：" + MONEY_D->money_str((int)ob->query("balance")) + "。\n";
  else
    line += "  你目前还没有任何存款。\n";
  if (ob->query("couple/couple_name"))
    if (ob->query("gender") == "男性")
      line += " 你的妻子是：" + ob->query("couple/couple_name") + "。\n";
    else
      line += " 你的丈夫是：" + ob->query("couple/couple_name") + "。\n";

  if (1 || wizardp(me) || (int)ob->query("age") >= 18) {
    line += sprintf(
      "\n  膂力:「%s」 ",
      display_attr(my["str"], ob->query_str()));
    line += "食物 " + tribar_graph(
      my["food"],
      ob->max_food_capacity(),
      ob->max_food_capacity(),
      HIY
    ) + "\n";
    line += sprintf(
      "  悟性:「%s」 ",
      display_attr(my["int"], ob->query_int()));
    line += "饮水 " + tribar_graph(
      my["water"],
      ob->max_water_capacity(),
      ob->max_water_capacity(),
      HIC
    ) + "\n";
    line += sprintf(
      "  根骨:「%s」 ",
      display_attr(my["con"], ob->query_con()));
    line += "精气 " + tribar_graph(my["jing"], my["eff_jing"], my["max_jing"], HIG) + "\n";
    line += sprintf(
      "  身法:「%s」 ",
      display_attr(my["dex"], ob->query_dex()));
    line += "气血 " + tribar_graph(my["qi"], my["eff_qi"], my["max_qi"], HIR) + "\n";
    line += sprintf(
      "  魅力:「%s」 ",
      display_attr(my["per"], ob->query_per()));
    line += "精力 " + tribar_graph(
      my["jingli"],
      my["max_jingli"],
      my["max_jingli"] - my["jingli"] + 1,
      HIB
    ) + "\n";
    line += sprintf(
      "  运气:「%s」 ",
      display_attr(my["kar"], ob->query_kar()));
    line += "无常 " + tribar_graph(
      my["PKS"],
      my["MKS"],
      my["MKS"] + my["PKS"] + my["age"],
      HIM
    ) + "\n\n";

  }

  if (objectp(weapon = ob->query_temp("weapon")))
    skill_type = weapon->query("skill_type");
  else
    skill_type = "unarmed";

  attack_points = COMBAT_D->skill_power(ob, skill_type, SKILL_USAGE_ATTACK);
  parry_points = COMBAT_D->skill_power(ob, skill_type, SKILL_USAGE_DEFENSE);
  dodge_points = COMBAT_D->skill_power(ob, "dodge", SKILL_USAGE_DEFENSE);

  line += sprintf("┏━━━━━━━━━━━━━━━━━━━━━━━━━┓\n");
  line += sprintf("┃战斗攻击力 " HIW "%9d" NOR "\t\t战斗防御力 " HIW "%9d" NOR "┃\n",
    attack_points / 100 + 1, (dodge_points + (weapon ? parry_points : (parry_points / 10))) / 100 + 1,);
  if (ob->query_temp("apply/armor") == 33) {
    line += sprintf("┃战斗伤害力 " HIW "%9d" NOR "\t\t战斗保护力 " HIW "%9d" NOR "┃\n" NOR,
      ob->query_temp("apply/damage"), 100);
  } else {
    line += sprintf("┃战斗伤害力 " HIW "%9d" NOR "\t\t战斗保护力 " HIW "%9d" NOR "┃\n" NOR,
      ob->query_temp("apply/damage"), ob->query_temp("apply/armor"));

  }
  line += sprintf("┃你参与「" HIR "%7d" NOR "」次江湖仇杀，杀害了「" HIW "%5d" NOR "」个玩家┃\n",
    ob->query("PKS") + ob->query("MKS"), ob->query("PKS"));
  line += sprintf("┃你被残杀了%6s次，最后一次被：「" + HIR + "%10s" + NOR + "」所杀┃\n",
    chinese_number(my["VKS"]), my["last_pker"]);
  line += sprintf("┗━━━━━━━━━━━━━━━━━━━━━━━━━┛\n");
  line += sprintf("┏━━━━━━━━━━━━━━━━━━━━━━━━━┓\n");
  if (ob->query("shen") >= 0)
    line += sprintf(
      "┃目前你的正气是：" + HIR + "%9d" + NOR + "\t  江湖阅历：" + HIY + "%8d" NOR "┃\n" NOR,
      ob->query("shen"),
      ob->query("score")
    );
  else
    line += sprintf(
      "┃目前你的戾气是：" + HIM + "%9d" + NOR + "\t  江湖阅历：" + HIY + "%8d" NOR "┃\n" NOR,
      ob->query("shen"),
      ob->query("score")
    );

  line += sprintf("┃你的实战经验有： " HIM "%9d" NOR "\t  内在潜能：" HIY "%8d" NOR "┃\n", ob->query("combat_exp"),
    (int)ob->query("potential") - (int)ob->query("learned_points"));
  line += sprintf(
    "┃目前你的杀气是： " HIC "%9d" NOR "\t  江湖威望：" HIC "%8d" NOR "┃\n" NOR,
    ob->query("shaqi"),
    ob->query("scores")
  );
  line += sprintf("┗━━━━━━━━━━━━━━━━━━━━━━━━━┛\n");
  if (ob->query("mud_age")) {
    line += sprintf(
      HIY + " %s已经在" + MUD_NAME + "里奋斗了%s，加油呀！！\n\n" + NOR,
      ob == me ? "你" : ob->name(1),
      CHINESE_D->chinese_time((int)ob->query("mud_age"))
    );
  }
  write(line);
  return 1;
}

string display_attr(int gift, int value) {
  if (value > gift) return sprintf(HIY "%3d" NOR, value);
  else if (value < gift) return sprintf(CYN "%3d" NOR, value);
  else return sprintf("%3d", value);
}

string status_color(int current, int max) {
  int percent;

  if (max) percent = current * 100 / max;
  else percent = 100;

  if (percent > 100) return HIC;
  if (percent >= 90) return HIG;
  if (percent >= 60) return HIY;
  if (percent >= 30) return YEL;
  if (percent >= 10) return HIR;
  return RED;
}

string tribar_graph(int val, int eff, int max, string color) {
  return color + bar_string[0..(val * 16 / max) * 2 - 1] + ((eff > val) ? blank_string[(val * 16 / max) * 2..(eff * 16 / max) * 2 - 1] : "") + NOR;
}


int help(object me) {
  write(@HELP
指令格式 : score
           score <对象名称>                (巫师专用)

这个指令可以显示你(你)或指定对象(含怪物)的基本资料。
基本资料的设定请参阅 'help setup'。

see also : hp
HELP
  );
  return 1;
}
