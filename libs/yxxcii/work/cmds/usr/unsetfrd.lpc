// unsetfrd.c
// modified by roro@YXXZ 1999
inherit F_CLEAN_UP;
#include <ansi.h>

int main(object me, string arg) {
  int i;
  object ob;
  string *termi;
  mapping friends, friends_name, friends_id;

  friends = me->query("friends");
  friends_name = me->query("friends/name");
  friends_id = me->query("friends/id");
  seteuid(ROOT_UID);
  ob = new(LOGIN_OB);
  ob->set("id", arg);

  if (!arg || arg == "") return notify_fail(HIR "请选择一个好友的ID！\n" NOR);

  if (arg && arg != "") {
    if (!ob->restore()) {
      write(HIG + "没有这个玩家: " + HIC + arg + " \n" + NOR);
      destruct(ob);
      return 1;
    }
    if (ob->query("id") == me->query("id"))
      return notify_fail(HIR "别开玩笑了，自己都不认识吗！\n" NOR);
    me->delete("friends/id/" + arg);
    me->delete("friends/name/" + ob->query("name"));
    tell_object(me, HIG "你将 " HIC + ob->query("name") + HIG " 移出你的好友名单. \n" NOR);
    message(
      "channel:rumor",
      HIM "〖武林传闻〗" + me->name(1) + "将" + ob->query("name") + "移出好友名单。\n" NOR,
      users()
    );
    return 1;
  }
  return 0;
}
int help(object me) {
  write(@HELP
指令格式 :	setfrd		查看你的好友名单.
		setfrd (id)	将某人加入你 的好友名单,最多加 20 个. 
		unsetfrd (id)   将对方移出好友名单
HELP
  );
  return 1;
}
