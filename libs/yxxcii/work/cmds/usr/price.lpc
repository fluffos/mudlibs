#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object obj, sobj;
	   string objname,*sellobname;
	   mapping priced_map,item_map;
	   int i,pri;  
	   
	 // if(!wizardp(me))return notify_fail("你现在还不能使用这条指令.\n");
	  if( !arg)
	  return notify_fail("你要把什么估多少价? \n");
	  if(arg=="none")
	{
	  if(!me->query_temp("sellobj"))
	   return notify_fail("你现在并没有为任何东西标价.\n");
	  me->delete_temp("sellobj");
	  printf("你取消了所有的物品标价.\n"); 
	  return 1;
	}
	  if(!sscanf(arg,"%s %d",objname,pri))
	  return notify_fail("你要把什么估多少价? \n");
 
	  if(pri<0)return notify_fail("你不可以把价格定为负数.\n");  
	  if(pri==0)
	  { if(!mapp(priced_map = me->query_temp("sellobj")))
	   return notify_fail("你现在并没有为任何东西标价.\n");
	sellobname=keys(priced_map);
	for(i=0;i<sizeof(priced_map);i++)
	  if(sellobname[i]==objname)
	  {
	   map_delete(priced_map,objname);
	   me->set_temp("sellobj",priced_map);
	   printf("你取消了\""+objname+"\"的标价.\n");
	   return 1;
	  }
	 return notify_fail("你并没有为这样东西标价.\n");
		 
	  }
	  if(!objectp(sobj = present(objname,me)))
	   return notify_fail("你身上没有这样东西啊!\n");
	  if(sobj->query("no_get"))
	   return notify_fail("这样东西还是不要卖掉的好。\n");
	  if (sobj->query("money_id"))
		return notify_fail("你想把钱卖掉？\n");
	  printf("你把"+sobj->name()+"("
		   +sobj->query("id")+")"
		   +"定价"+MONEY_D->price_str(pri)
		   +",准备卖掉它.\n");
	  if(!mapp(priced_map=me->query_temp("sellobj")))priced_map=([]);
	  item_map=([]);
	  item_map[(string)sobj->name()]=pri;
	  priced_map+=([(string)sobj->query("id"):item_map]);
	  me->set_temp("sellobj",priced_map);
	  return 1;

}
int help(object me)
{
  write(@HELP
指令格式 : price something number(以coin为单位).
	   price something 0 (取消该物品的标价).
	   price none	(取消所有的物品标价).
	 这条指令是让玩家商人用来标价自己所要卖的物品的.
HELP
	);
	return 1;
}
 
