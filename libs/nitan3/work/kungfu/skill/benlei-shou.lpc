inherit SKILL;

mapping *action = ({
  ([ "action": "$N口中低喝，左掌叠于右掌之上，施展出「雷动风行」，猛然劈向$n",
    "force": 130,
    "dodge": 20,
    "damage": 10,
    "lvl": 0,
    "skill_name": "雷动风行",
    "damage_type": "内伤"
  ]),
  ([ "action": "$N吐气扬声，一招「春雷乍现」，双掌轻飘飘地拍向$n的$l",
    "force": 150,
    "dodge": 10,
    "damage": 30,
    "lvl": 20,
    "skill_name": "春雷乍现",
    "damage_type": "内伤"
  ]),
  ([ "action": "$N大笑不绝，双掌翻飞，幻化如云，一招「雷奔云谲」已将$n笼罩于内",
    "force": 150,
    "dodge": 30,
    "damage": 35,
    "lvl": 30,
    "skill_name": "雷奔云谲",
    "damage_type": "内伤"
  ]),
  ([ "action": "$N一声轻叱，一式「电闪雷鸣」，双掌一前一后，迅疾攻向$n的$l",
    "force": 250,
    "dodge": 20,
    "damage": 10,
    "lvl": 40,
    "skill_name": "电闪雷鸣",
    "damage_type": "内伤"
  ]),

  ([ "action": "$N低喝一声，双掌平挥，如雷奔行般击向$n，正是一招「牧野惊雷」",
    "force": 300,
    "dodge": 25,
    "damage": 50,
    "lvl": 60,
    "skill_name": "牧野惊雷",
    "damage_type": "内伤"
  ]),
  ([ "action": "$N怒喝一声，身形陡然拔起，双掌下击，一招「雷动九天」攻向$n的顶门",
    "force": 350,
    "dodge": 30,
    "damage": 80,
    "lvl": 70,
    "skill_name": "雷动九天",
    "damage_type": "内伤"
  ]),
  ([ "action": "$N轻叱声中，左掌虚晃，右掌一招「雷惊电绕」，迳击$n的胸腹之间",
    "force": 350,
    "dodge": 30,
    "damage": 90,
    "lvl": 80,
    "skill_name": "雷惊电绕",
    "damage_type": "内伤"
  ]),
  ([ "action": "$N一声长啸，双掌挟风，似箭离弦，施出「雷霆万钧」同时击向$n的$l",
    "force": 450,
    "dodge": -10,
    "damage": 120,
    "lvl": 100,
    "skill_name": "雷霆万钧",
    "damage_type": "内伤"
  ])
});

int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练奔雷手必须空手。\n");
  if ((int)me->query("max_neili") < 50)
    return notify_fail("你的内力太弱，无法练奔雷手。\n");
  return 1;
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("benlei-shou", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me) {
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练奔雷手。\n");
  me->receive_damage("qi", 25);
  me->add("neili", -10);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "benlei-shou/" + action;
}
