/*
 * Catalog landing for Sagenwelt. Archive login/player (feature/player)
 * are unfinished: no rooms, no look/score, concatenated leftover
 * source in player.c, and the original simul does not compile.
 */

string name;

void write_prompt();
mixed process_input(string input);

void create() {
  name = "guest";
}

void logon() {
  write("\nSagenwelt Base-MudLib — catalog landing.\n");
  write("Once ready, this lib will contain everything needed to setup a new mud...\n");
  write("Domains/ is empty. Commands: look, score, quit.\n\n");
  write_prompt();
}

void write_prompt() {
  write("> ");
}

string query_name() { return name; }

int cmd_look(string arg) {
  write("The Void\n");
  write("An unfinished FluffOS skeleton by Gwenhwyvar (Shea690901).\n");
  write("There is no game world yet. The archive login/player never shipped a room.\n");
  return 1;
}

int cmd_score(string arg) {
  write(capitalize(name) + " (Sagenwelt guest)\n");
  write("This is a bootstrapping mudlib, not a game. No stats.\n");
  return 1;
}

int cmd_quit(string arg) {
  write("Goodbye.\n");
  destruct(this_object());
  return 1;
}

mixed process_input(string input) {
  string verb, rest;

  if (!input)
    input = "";
  input = replace_string(input, "\r", "");
  if (input == "") {
    write_prompt();
    return 1;
  }
  if (sscanf(input, "%s %s", verb, rest) != 2) {
    verb = input;
    rest = 0;
  }
  switch (verb) {
    case "look":
    case "l":
      cmd_look(rest);
      return 1;
    case "score":
    case "sc":
      cmd_score(rest);
      return 1;
    case "quit":
    case "q":
      cmd_quit(rest);
      return 1;
  }
  write("What?\n");
  return 1;
}
