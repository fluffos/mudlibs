#include    <simul_efun.h>
#include    <simul_efun_intern.h>

#include "/secure/sefuns/arrays.lpc"
#include "/secure/sefuns/communication.lpc"
#include "/secure/sefuns/driver.lpc"
#include "/secure/sefuns/file_system.lpc"
#include "/secure/sefuns/general.lpc"
#include "/secure/sefuns/logging.lpc"
#include "/secure/sefuns/math.lpc"
#include "/secure/sefuns/objects.lpc"
#include "/secure/sefuns/passwd.lpc"
#include "/secure/sefuns/regex_globbing.lpc"
#include "/secure/sefuns/room.lpc"
#include "/secure/sefuns/security.lpc"
#include "/secure/sefuns/strings.lpc"
#include "/secure/sefuns/terminal.lpc"

#ifndef __SAGENWELT_STARTUP_FINISHED__
#define __SAGENWELT_STARTUP_FINISHED__
private int startup_finished;
#endif

private void create(void)
{
    startup_finished = FALSE;

    init_object_sefuns();
    init_terminal_sefuns();
    initialize_regex_globbing();
}

public void done_startup(void)
{
    startup_finished = TRUE;
}

// event handler
public void event_destruct(void)
{
    if(origin() != ORIGIN_EFUN)
        return;
}

public void event_shutdown(void)
{
    if(origin() != ORIGIN_EFUN)
        return;
}

/// @}
