/*
 * Catalog simul_efun. Archive simul_efun_orig.lpc includes a header
 * that does not compile (messages.h missing; unfinished prototypes).
 */

void create() {}

/* §7.231: LDMud two-argument move_object(item, dest) */
varargs mixed move_object(mixed item, mixed dest)
{
    if (undefinedp(dest))
        return efun::move_object(item);
    /* Common case in archive move.lpc: item is this_object(). */
    if (objectp(item) && item == this_object())
        return efun::move_object(dest);
    return 0;
}

varargs void syslog(int facility, string fmt, mixed a0, mixed a1, mixed a2, mixed a3, mixed a4)
{
    string msg;
    if (!stringp(fmt)) return;
    msg = sprintf(fmt, a0, a1, a2, a3, a4);
    if (file_size("/var/log") != -2)
        mkdir("/var/log");
    catch(write_file("/var/log/syslog", ctime(time()) + " " + msg + "\n"));
}

int creatorp(object ob)
{
    if (!ob) ob = this_player();
    return objectp(ob) && wizardp(ob);
}

int Dcreatorp(object ob, string domain) { return creatorp(ob); }

int cred_cmp(object a, object b) { return 0; }

string HOME_DIR(string uid)
{
    if (!stringp(uid) || uid == "") return "/players/";
    return "/players/" + uid[0..0] + "/" + uid + "/";
}

varargs void set_this_player(object ob) { }

string itoa(int arg) { return sprintf("%d", arg); }

int query_host_port() { return 40282; }

int elderp(object ob) { return creatorp(ob); }
int archp(object ob) { return creatorp(ob); }
int adminp(object ob) { return creatorp(ob); }
int Dlordp(object ob, string domain) { return creatorp(ob); }
void done_startup(void) {}

string trim_spaces(string s) {
    if (!stringp(s)) return "";
    return trim(s);
}
varargs void more(mixed arg, int height, string input) {
    if (stringp(arg)) write(arg);
}
varargs string *reg_pat_translate(string s, int flag) { return ({ s }); }
varargs string *insensitive_regexp(mixed choices, mixed pat) {
    if (pointerp(choices)) return choices;
    return ({});
}

void set_debug(int x) {}
string author_of(object ob) { return "unknown"; }
string domain_of(object ob) { return "unknown"; }

/* LDMud efun; FluffOS exposes no simul_efun() — return this object. */
object simul_efun() { return this_object(); }

/* LDMud file_name(ob, flag): flag 1 strips "#clone". */
varargs string file_name(object who, int flag)
{
    string fn;
    int    i;

    if (!who)
        who = this_object();
    fn = efun::file_name(who);
    if (flag && ((i = strsrch(fn, "#")) != -1))
        fn = fn[0..i - 1];
    return fn;
}

/* Archive sefuns/security.lpc typo'd this as init_eteids; stub for create(). */
int init_eids() { return 1; }

/* LDMud credential efuns FluffOS lacks — string gid stubs. */
varargs string getegid(object ob) { return "sagenwelt"; }
varargs string getgid(object ob) { return "sagenwelt"; }

varargs mixed *distinct_array(mixed *arr)
{
    mixed *out;
    int    i, n;

    if (!pointerp(arr))
        return ({});
    out = ({});
    n = sizeof(arr);
    for (i = 0; i < n; i++)
        if (member_array(arr[i], out) == -1)
            out += ({ arr[i] });
    return out;
}

varargs void m_syslog(string uid, string gid, int priority, string format,
                      mixed a0, mixed a1, mixed a2, mixed a3)
{
    syslog(priority, format, a0, a1, a2, a3);
}

string get_cwd(object who) { return "/"; }
string canonical_path(string path)
{
    if (!stringp(path) || path == "")
        return "/";
    return path;
}
