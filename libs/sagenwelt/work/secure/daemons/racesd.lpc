/// @file racesd.c
/// @brief races daemon
///
/// handles the available races
/// @author Gwenhwyvar
/// @version 0.0.0
/// @date 2016-03-31

#include <race_d.h>

private mapping races;
private mapping genders;

public mapping get_gender_map()
{
    if (!genders)
        genders = ([
                "female": ([ "human": 1 ]),
                "male"  : ([ "human": 1 ]),
                ]);
    return genders;
}

public mapping get_races_map()
{
    if (!races)
        races = ([
                "human": ([
                        RD_RACE_GENDER: ({ "female", "male" }),
                        RD_RACE_INFO  : "A typical human.\n",
                        ]),
                ]);
    return races;
}

void create()
{
    get_races_map();
    get_gender_map();
}
