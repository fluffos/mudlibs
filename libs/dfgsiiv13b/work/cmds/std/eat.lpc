inherit F_CLEAN_UP;

int main(object me, string arg)
{
    object ob;

    if( me->is_busy() ) return 0;

    if( !arg || arg=="" ) return notify_fail("璶ぐ或\n");

    if( !me->query_stat_maximum("kee") )
        return notify_fail("⊿Τ砰礚猭秈\n");

    ob = present(arg, me);
    if( !ob ) ob = present(arg, environment(me));
    if( !ob ) return notify_fail("硂柑⊿Τ硂妓狥﹁ ...\n");
    if( inherits(COMBINED_ITEM, ob) && !ob->query_amount() )
	return notify_fail("眔рい\n");

    notify_fail("硂妓狥﹁ぃ\n");
    if( ob->stuff_ob(me) ) {
        me->start_busy(1);
        return 1;
    }
    return 0;
}

int help()
{
    write(@TEXT
Αeat <珇>

硂ノㄓ琵秈┪狝ノ媚es2 瘤礛砞﹚琌硄盽ぃゲ钩
痷龟ネ妓ぱ繺璶▄緅碞

驹矮い穦アΩю阑诀穦
TEXT
    );
    return 1;
}
