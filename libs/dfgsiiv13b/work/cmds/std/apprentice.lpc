// apprentice.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object ob;

	if( !arg ) return notify_fail("璶街畍\n");

	ob = present(arg, environment(me));
	if( !ob || !ob->is_character() ) return notify_fail("硂柑⊿Τ硂\n");
	// add by dragoon
        if( objectp(ob) && ob->query("no_fight") ) 
		return notify_fail("ぐ或??\n");

	if( ob==me ) return notify_fail("︑畍\n");

	if( me->is_apprentice_of(ob) )
		return notify_fail("竒琌" + ob->name() + "\n");

	if( !living(ob)	)
		return notify_fail(ob->name() + "瞷⊿Τ快猭氮\n");

	notify_fail(ob->name() + "⊿ΤΜ畕ゴ衡\n");
	if( !ob->accept_apprentice(me) )
		return 0;

	message_vision(CYN "\n$N各ㄓ穛穛$n絎臫繷笵畍\n\n" NOR,
		me, ob);
	ob->init_apprentice(me);

	return 1;
}

int help(object me)
{
	write(@Help
Α: apprentice <琘>

琘讽畍, 狦琘琌(﹑)畍, 玥琌畍叫
Help
	);
	return 1;
}
