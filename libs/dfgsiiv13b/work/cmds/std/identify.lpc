#include <combat.h>

inherit F_CLEAN_UP;

mapping named_apply = ([
    "attack" : "ю阑",
    "defense" : "ň縨",
    "str" : "籑",
    "cor" : "義醚",
    "cps" : "﹚",
    "int" : "┦",
    "wis" : "紌",
    "spi" : "艶┦",
    "con" : "癌",
    "dex" : "诀庇",
    "damage" : "端甡",
    "armor" : "ň縨",
]);

int main(object me, string arg)
{
    object ob;
    string type, sub_type;
    class damage_parameter dp;
    mapping apply;

    if( me->is_busy() ) return 0;

    if( !arg ) return notify_fail("璶挪﹚ぐ或狥﹁?\n");
    ob = present(arg, me);
    if( !ob ) return notify_fail("璶挪﹚ぐ或狥﹁?\n");
    if( !(type = ob->query("equipped")) )
        return notify_fail("ゲ斗杆称" + ob->name() + "挪﹚.\n");
    if( sscanf(type, "%s/%s", type, sub_type) != 2 )
        return notify_fail("硂摸珇礚猭挪﹚.\n");

    if( !wizardp(me) ) {
        if( me->query_stat("sen") < 10 )
            return notify_fail("び仓.\n");
        me->consume_stat("sen", 10);
    }

    write(ob->long() + "\n");
    if( type=="weapon" ) {
        string s;
        mixed sk = ob->query("wield_as");
        
        write("ノм\n");
        if( stringp(sk) ) sk = ({ sk });
        foreach(s in sk)
            printf("  %s (%s)\n", to_chinese(s), s);
        dp = ob->query("damage/" + sub_type);
        printf("\n端甡 %d - %d (秖タ %d%%计单 %d)\n", 
            dp->roll + dp->multipler,
            dp->roll + dp->multipler * dp->range,
            dp->bonus, dp->multipler );
        apply = ob->query("apply_" + type + "/" + sub_type);
        if( mapp(apply) ) {
            string prop;
            mixed value;
            
            write("\n猌竟疭┦\n");
            foreach(prop, value in apply) {
                if( !undefinedp(named_apply[prop]) )
                    prop = named_apply[prop];
                else
                    prop = to_chinese(prop);
                printf("  %-30s %O\n", prop, value);
            }
        }
    }
    if( type=="armor" ) {
        apply = ob->query("apply_" + type + "/" + sub_type);
        if( mapp(apply) ) {
            string prop;
            mixed value;
            
            write("臔ㄣ疭┦\n");
            foreach(prop, value in apply) {
                if( !undefinedp(named_apply[prop]) )
                    prop = named_apply[prop];
                printf("  %-30s %O\n", to_chinese(prop), value);
            }
        }
    }

    return 1;        
}

int help(object ob)
{
    write(@TEXT
Α: identify <ン>

硂琵挪﹚ㄇ猌竟杆称单珇, 惠璶禣ㄇ弘.
TEXT
    );
    return 1;
}
