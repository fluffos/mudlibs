inherit F_CLEAN_UP;

private void create() { seteuid(getuid()); }

int main(object me, string arg)
{
    string item, targ;
    object ob, owner;
    mixed handle;
    int price, afford;

    if( me->is_busy() ) return notify_fail("瞷⊿Τ\n");

    if( !arg || sscanf(arg, "%s from %s", item, targ)!=2 )
        return notify_fail("Αbuy <琘> from <琘>\n");

    if( !objectp(owner = present(targ, environment(me))) )
        return notify_fail("璶蛤街禦狥﹁\n");

    if( userp(owner) ) {
        message_vision("$N稱$n潦禦" + item + "\n", me, owner);
        return 1;
    }

    // add by dragoon
        if( objectp(owner) && owner->query("no_fight") )
                return notify_fail("ぐ或??\n");

    if( !living(owner) )
        return notify_fail("癬ㄓ"+owner->name()+"竒礚猭禦芥狥﹁\n");
        
    if( owner->is_fighting() )
        return notify_fail("癬ㄓ" + owner->name() + "タΓ帝 ... ゴ琜⊿瞶\n");

    notify_fail("癸よ钩ぃ腀種蛤ユ\n");
    if( !(handle = owner->affirm_merchandise(me, item)) ) return 0;
    price = owner->query_trading_price(handle);

    switch( me->can_afford(price) ) {
        case 0: return notify_fail("ō窥ぃ镑\n");
        case 1:
            me->pay_money(price);
            owner->deliver_merchandise(me, handle);
            me->gain_score("survive", random(price/300 + me->query_attr("wis")/3) );
            return 1;
        case 2:
            return notify_fail("⊿Τì镑箂窥τ癸よтぃ秨...\n");
    }

}

int help(object me)
{
   write( @HELP
Α: buy <something> from <someone>

硂琵眖琘ㄇō禦珇
HELP
   );
   return 1;
}
