#include <skill.h>

inherit F_CLEAN_UP;

private void create() { seteuid(getuid()); }

int main(object me, string arg)
{
    string cauterization, spl, trg;
    object target, weapon;
       
    weapon = me->query_temp("weapon/needle");

    if( me->query("life_form") == "ghost" )
        return notify_fail("碞κ, ет丢確!!\n");

    if(!weapon) return notify_fail("ゲ斗杆称皐摸洛ㄣㄏノ皐╞ぇ砃\n");
        
    if( me->is_busy() )
        return notify_fail("瞷⊿Τ\n");

    if( !arg ) return notify_fail("Αacupuncture <╞砃> [to <ヘ夹>]\n");
    if( sscanf(arg, "%s to %s", spl, trg)==2 ) {
        target = present(trg, environment(me));
        if( !target ) target = present(trg, me);
        if( !target ) return notify_fail("硂柑⊿Τ " + trg + "\n");
        // add by dragoon
        if( userp(target) && !interactive(target) )
            return notify_fail("硂瞷ぃ絬\n");
    } else {
        spl = arg;
        target = 0;
    }

    spl = replace_string( spl, " ", "_");

    notify_fail("叫ノ enable 匡拒璶ㄏノ╞砃╰\n");
    if( stringp(cauterization = me->skill_mapped("cauterization")) ) {
        me->set_temp("pending/hidden", 0);
        return (int)SKILL_D(cauterization)->acupuncture_cauterization(me, 
                spl, target);
    } 
    return 0;
}

int help (object me)
{
    write(@HELP
Αacupuncture <╞砃嘿> [to <癸禜>]
 
ㄏノ╞砃ゲ惠﹚<╞砃嘿><琁╞癸禜>玥Τ礚
ㄏノ琘╞砃ぇ玡ゲ斗ノ enable ㄓ﹚
璶ㄏノ╞砃╰, 冈灿砞﹚叫把σ help cauterization 
 
HELP
    );
    return 1;
}
