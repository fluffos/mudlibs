#include <login.h>
#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object who;

	if( !arg ) {
		if( me->query("level") < 50 
		|| me->query_score("reputation") < 60000 ) return 
			notify_fail("Τ羘辨镑蔼郴產Τ腊戈\n");

		if( me->query("clan/create") ) return 
			notify_fail("–ネす砛\承硑Ω穝腊\n");

		if( me->query("clan/clan_level") ) return 
			notify_fail("竒琌腊Θ, 叫叉瞒ㄓ腊\n");

		if( me->query_temp("clan/sign_number") < 2 ) return
			notify_fail("︓ぶ眔тㄢ捌もㄓ腊Γ腊\n");
		write("ヘ玡Τ腊: \n\n");
		seteuid(ROOT_UID);
		write( read_file("/obj/CLAN") );
		write("\n腊∕﹚ぇ玡, 繦:q叉瞒腊も尿叫\n");
		write("承ㄣ穝腊叫块腊: ");
		input_to("get_clan_name", me);
		return 1;
	}

	if( sscanf(arg, "with %s", arg) ) {
		if( me->query("level") < 44 ) return 
			notify_fail("单ぃì把籔腊\n");

		if( me->query("clan/clan_level") ) return 
			notify_fail("竒琌腊Θ, 礚猭腊腊\n");

		if( me->query("clan/signed") ) return 
			notify_fail("竒腊ΓΘミ筁腊穦\n");

		who = present(arg, environment(me));

		if( who == me ) return notify_fail("叫т︑腊Γ\n");

		if( !objectp(who) || !living(who) ) 
			return notify_fail("硂柑⊿Τ硂\n");

		message_vision(HIW"$N∕﹚$n承ミ穝腊\n"NOR
		, me, who);

		who->add_temp("clan/sign_number", 1);
		me->set("clan/signed", 1);
#ifdef SAVE_USER
        me->save();
#endif
		return 1; }
	else {
		tell_object(me, 
		"Α: cestablish ┪琌 cestablish with <琘>\n");
		return 1;
	}
}

private void get_clan_name(string arg, object me)
{
        seteuid(getuid(me));
	me->set("clan/clan_name", arg);
	write("眤絋﹚璶ノ硂讽眤腊盾(y/n/q)");
	input_to("confirm_name", me);
}

private void confirm_name(string yn, object me)
{        
	if( yn=="" ) {
		write("眤絋﹚璶ノ硂讽眤腊盾(y/n)");
                input_to("confirm_name", me);
                return;
	}
	if( yn == "q" ) {
		write("ê或....Ω\n");
		return;
	}

        if( yn[0]!='y' && yn[0]!='Y' ) {
                write("ê或叫穝块眤稱璶腊: ");
                input_to("get_clan_name", me);
                return;
        }
	seteuid(ROOT_UID);
	// keep in /log/CLAN
	log_file("CLAN", sprintf("[%s] %s パ %s(%s) 承ミ\n",
        ctime(time()), me->query("clan/clan_name"), me->name(),
        me->query("id")) );
	// write in /obj/CLAN for player to query clan data
	write_file("/obj/CLAN", sprintf("[%s] %s パ %s(%s) 承ミ\n",
	ctime(time()), me->query("clan/clan_name"), me->name(),
	me->query("id")) );
	write("叫块硂腊烩旧嘿腹(: 腊, , 磝): ");
	input_to("get_clan_rank", me);
}

private void get_clan_rank(string arg, object me)
{
	if( strlen(arg) > 4 ) {
		write("嘿腹筁, 叫穝块: ");
		input_to("get_clan_rank", me);
	}
	seteuid(getuid(me));
	me->set("clan/rank", arg);
	me->set("clan/nick", "材繷ヘ");
	me->set("clan/clan_level", 3);
	me->set("clan/elder", 0);
	write("眤絋﹚璶ノ硂讽眤腊嘿腹盾(y/n)");
	input_to("confirm_rank", me);
}

private void confirm_rank(string yn, object me)
{
	object mark;

	if( yn=="" ) {
		write("眤絋﹚璶ノ硂讽眤腊嘿腹盾(y/n)");
                input_to("confirm_rank", me);
                return;
        }

        if( yn[0]!='y' && yn[0]!='Y' ) {
                write("ê或叫穝块眤稱璶腊嘿腹: ");
                input_to("get_clan_rank", me);
                return;
        }
#ifdef SAVE_USER
        me->save();
#endif
	message("system", HIW"ぱ绰そ: "+me->query("clan/clan_name")
	+"パ"+me->name()+"承ミЧΘ, 秨﹍┷Μ腊渤!!\n"NOR, users());
	mark = new("/obj/clan_symbol");
	mark->move(me);
	return;		
}


int help(object me)
{
write(@HELP
セノ硚Θミ腊, 稱Θミ腊(腊嘿ぇ)惠
т(腊渤嘿ぇ)癬秈︽, よΘミ穝腊Θミ腊
ぇ, 腊渤计ゲ惠ㄢ, τ兜Θミ腊ぇ叫把綷
: help clan, Α:
1. 腊渤   cestablish with <琘>
2. 腊
   cestablish
   繦ボ恶腊兜膀セ戈
HELP
    );
    return 1;
}
