// say.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object *ob;
	if (!arg) return notify_fail("璶弧ぐ或\n");

	write("弧笵" + HIG + arg + "\n" NOR);
	message("sound", me->name() + "弧笵" + HIG + arg + "\n" NOR,
		environment(me), me);

	// The mudlib interface of say
	ob = all_inventory(environment(me)) - ({ me });
	ob->relay_say(me, arg);

	return 1;
}

int help (object me)
{
	write(@HELP
Α: say <癟>
 
弧杠┮Τ蛤┬丁常穦钮弧杠
 
爹: セノ ' .
 
HELP
	);
	return 1;
}
