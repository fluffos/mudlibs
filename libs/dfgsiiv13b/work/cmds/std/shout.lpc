// shout.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	if( !wizardp(me) )
		return notify_fail("ヘ玡既ぃ秨產 shout\n");
	if (!arg) return notify_fail("稱璶ぐ或?\n");
	shout( me->name() + "羇羘糞" + HIY + arg + NOR + "\n");
	write("羇羘糞" + HIY + arg + NOR + "\n");
	return 1;
}
int help(object me)
{
  write(@HELP
Α : shout <癟>
 
硂琵盢 <癟> 肚癳, ┮Τタ絬ゼ常穦钮ǎ杠ヘ玡
Τ畍ノ
 
see also : tune
HELP
    );
    return 1;
}
 
