#include <ansi.h>
#include <char.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
    object obj, old_target;
    int rg, rk, rgm, rkm;

    if( me->query("life_form")=="ghost" )
        return notify_fail("碞κ, ет丢確!!\n");

    if( environment(me)->query("no_fight") )
	return notify_fail("硂柑窽ゎ驹矮\n");
 
    if( !arg
    ||	!objectp(obj = present(arg, environment(me)))
    ||	!obj->is_character()
    ||	obj->is_corpse() )
	return notify_fail("稱ю阑街\n");

    if( obj->query("no_fight") ) return notify_fail("ぃ︽\n");

    // ぃю阑耞絬產 -Dragoon
    if( userp(obj) && !interactive(obj) ) 
        return notify_fail("硂瞷ぃ絬\n");

    if( !me->visible(obj) )
	return notify_fail( obj->name() + "ぃǎぃ笵珼驹\n");

    if( me->is_apprentice_of(obj) )
	return notify_fail( obj->name() + "琌畍\n");

    if( obj->is_fighting(me) )
	return notify_fail("猳猳猳\n");

    if( !living(obj) && inherits(F_ATTACK, obj) )
	return notify_fail( "㎝" + obj->name() + "驹矮\n"); 

    if( obj==me ) return notify_fail("ぃю阑︑\n");

    if( userp(obj) && (object)obj->query_temp("pending/fight")!=me ) {
	message_vision("\n$N癸帝$n弧笵" 
	    + me->rank("self") + me->name() + "烩毙硂︗"
	    + obj->rank("respectful") + "蔼┷\n\n", me, obj);

	if( objectp(old_target = me->query_temp("pending/fight"))
	&&  obj != old_target
	&&  environment(old_target)==environment(me) )
	    message_vision("\n$N$n╆暗触弧笵"
		+ me->rank("self") + "эら︽叫毙\n", me, old_target);
	me->set_temp("pending/fight", obj);

	tell_object(obj, YEL "狦腀種㎝癸よ秈︽ゑ刚叫癸" + me->name() + "("+(string)me->query("id")+")"+ "Ω fight \n" NOR);
	write(YEL "パ癸よ琌パ產北ゲ斗单癸よ種秈︽ゑ刚\n" NOR);
	return 1;
    }

    if( obj->query("civilized") ) {
	if( me->is_fighting() )
	    message_vision( "\n$N癸帝$n弧笵ㄖ烩毙硂︗"
		+ obj->rank("respectful") + "蔼┷\n\n", me, obj);
	else
	    message_vision( "\n$N癸帝$n弧笵" 
		+ me->rank("self") + me->name() + "烩毙硂︗"
		+ obj->rank("respectful") + "蔼┷\n\n", me, obj);

	if( obj->query_temp("pending/fight")==me ) {
	    obj->start_busy(1);
//	delete else, 琵蛮よ常busyτ獶fightbusy only -dragoon
//	else 
	    me->start_busy(1);
	}

	if( !userp(obj) && !obj->accept_fight(me) ) {
	    write("癬ㄓ" + obj->name() + "ぃ稱蛤耕秖\n");
	    return 1;
	}

	me->fight_ob(obj);
	obj->fight_ob(me);
    } else {
	message_vision("\n$N耻羘秨﹍癸$n祇笆ю阑\n\n", me, obj);
	me->fight_ob(obj);
	obj->kill_ob(me);
    }

    return 1;
}

int help(object me)
{
    write(@HELP
Α : fight <>
 
硂琵癚毙┪琌ち絉猌美硂贺Α驹矮洪琌
翴ゎ穦砰ぃ穦痷端琌ぃ琌┮Τ  NPC 常尺舧
ゴ琜Τ砛\猵ゑ猌璶―穦砆┶荡
 
ㄤ闽: kill

PS. 狦癸よぃ腀種钡珼驹ご礛硍︽ノ kill 秨﹍驹矮Τ
    闽 fight 蛤 kill 跋だ叫 'help combat'.
HELP
    );
    return 1;
}
 
