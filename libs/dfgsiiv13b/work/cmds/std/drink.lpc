inherit F_CLEAN_UP;

int main(object me, string arg)
{
    object ob;

    if( me->is_busy() ) return 0;

    notify_fail("璶耻ぐ或\n");
    if( !arg || arg=="" ) return 0;

    if( !me->query_stat_maximum("kee") ) // changed by dragoon
        return notify_fail("璝村捣礚猭耻ヴ︙狥﹁\n");

    if(me->query_stat_maximum("water") <= me->query_stat("water"))
        return notify_fail("耻ぃ狥﹁\n");

    // Drink from liquid containers.
    if( sscanf(arg, "from %s", arg) ) {
        object liq;

        ob = present(arg, me);
        if( !ob ) ob = present(arg, environment(me));
        if( !ob ) return notify_fail("硂柑⊿Τ硂妓狥﹁ ...\n");
        if( !ob->query("liquid_container") )
            return notify_fail( ob->name() + "ぃ琌杆甧竟\n");
        foreach(liq in all_inventory(ob))
            if( liq->query_volume()) {
                liq->drink_ob(me);
                me->start_busy(1);
                return 1; }

        return notify_fail( ob->name() + "柑⊿Τヴ︙耻狥﹁\n");
    }

    return environment(me)->do_drink(arg);
}

int help()
{
    write(@TEXT
Α drink from <something>, drink <something>

硂ノㄓ都┪耻琘ㄇ睪砰, 瑄猠皊单Something い
ゅ, ぃ甧竟砛ぃ惠璶ノ迭 from

TEXT
    );
    return 1;
}
