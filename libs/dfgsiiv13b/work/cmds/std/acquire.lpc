inherit F_CLEAN_UP;

private void create() { seteuid(getuid()); }

int main(object me, string arg)
{
    string skill, who;
    object ob;

    if( !arg || sscanf(arg, "%s from %s", skill, who)!= 2)
        return notify_fail("Αacquire <м嘿> from <>\n");

    if( !objectp(ob = present(who, environment(me))) )
        return notify_fail("硂柑⊿Τ硂\n");

    // add by dragoon
    if( ob->query("no_fight") )
	return notify_fail("ぐ或??\n");

    if( !ob->query_skill(skill, 1) )
        return notify_fail(ob->name() + "ぃ穦硂贺м\n");

    if( me->query_skill(skill, 1) > 0 )
        return notify_fail("竒穦硂贺м\n");

    // Produce proper message according to relation between player and teacher.
    if( me->is_apprentice_of(ob) ) {
        message_vision("$N$n絎繷︽搂穛穛弧笵畍―眤肚甭畕ㄠ"
            + "" + to_chinese(skill) + "\n",
            me, ob);
    } else if( ob->query("age") > me->query("age") ) {
        message_vision("$N$n﹠渐弧笵边晋" + me->name() + "辨玡晋翴"
            + me->rank("self") + "" + to_chinese(skill) + "\n",
            me, ob);
    } else {
        message_vision("$N$nも︽搂弧笵叫硂︗" + ob->rank("respectful") 
            + "翴" + me->rank("self") + "" + to_chinese(skill) + "\n",
            me, ob);
    }

    notify_fail("癬ㄓ" + ob->name() + "ぃ稱毙硂兜м\n");
    return ob->acquire_skill(me, skill);
}

int help()
{
    write(@TEXT
Αacquire <м嘿> from <>

硂琵琘―毙琘贺мぃ筁癸よ腀ぃ腀種毙ぃ琌︑
∕﹚硄盽猌狶ぃ穦淮毙猌τΤㄏ毙ぃǎ眔穦
渡舗甭
TEXT
    );
    return 1;
}
