// charge.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object ob;

	if( !arg || arg=="" ) {
		if( ob = me->query_charging() ) {
			write("瞷" + ob->name() + "璶ю阑ヘ夹\n");
			return 1;
		}
		write("瞷⊿Τ匡﹚璶ю阑ヘ夹\n");
		return 1;
	}

	if( arg=="cancel" ) {
		write("Ok.\n");
		me->remove_charge();
		return 1;
	}

	ob = present(arg, environment(me));
	if( !ob ) return notify_fail("硂柑⊿Τ硂\n");

	if( !me->is_fighting(ob) )
		return notify_fail("瞷⊿Τ蛤" + ob->name() + "驹矮\n");
	me->charge_ob(ob);
	write("Ok.\n");

	return 1;
}

int help(object me)
{
	write(@TEXT
Αcharge [<驹矮ヘ夹>|cancel]

硂琵匡﹚タ㎝驹矮い寄璶ю阑ヘ夹┮孔璶ю阑
ヘ夹琌讽硂ヘ夹临蛤驹矮穦┛菠ㄤ寄τ盡珼硂ヘ夹ю
阑ㄓ栋い防ゑ耕┤寄琌癸癸ㄤ
寄ю阑ň縨瞯碞Τキ盽 2/3

璶 charge 家Αノ charge cancelぃヴ︙把计玥陪ボヘ玡栋
いю阑癸禜
TEXT
	);
	return 1;
}
