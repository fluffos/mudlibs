// drop.c

#include <login.h>
inherit F_CLEAN_UP;

int do_drop(object me, object obj);

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
    object obj, *inv, obj2;
    int i, amount;
    string item;

    if( me->is_busy() )
        return notify_fail("タΓ帝ㄤㄆ\n");

    if(!arg) return notify_fail("璶メ斌ぐ或狥﹁\n");
    if( !environment(me) ) return 0;

    if(sscanf(arg, "%d %s", amount, item)==2) {
        if( !objectp(obj = present(item, me)) )
            return notify_fail("ō⊿Τ硂妓狥﹁\n");
        if( stringp(obj->query("no_drop")) )
            return notify_fail( (string)obj->query("no_drop") );
        if( !obj->query_amount() )
            return notify_fail( obj->name() + "ぃ砆だ秨メ斌\n");
        if( amount < 1 )
            return notify_fail("狥﹁计秖︓ぶ琌\n");
        if( amount > obj->query_amount() )
            return notify_fail("⊿Τê或" + obj->name() + "\n");
        else if( amount == (int)obj->query_amount() )
            return do_drop(me, obj);
        else {
            obj->set_amount( (int)obj->query_amount() - amount );
            seteuid(MUDLIB_UID);
            obj2 = new(base_name(obj));
            seteuid(getuid());
            obj2->set_amount(amount);
            return do_drop(me, obj2);
        }
    }

    if(arg=="all") {
        inv = all_inventory(me);
        for(i=0; i<sizeof(inv); i++) {
            if( inv[i]->query("keep_this") ) continue;
            do_drop(me, inv[i]);
        }
        write("Ok.\n");
        return 1;
    }

    if(!objectp(obj = present(arg, me)))
        return notify_fail("ō⊿Τ硂妓狥﹁\n");
    return do_drop(me, obj);
}

int do_drop(object me, object obj)
{
    mixed no_drop;

    if( no_drop = obj->query("no_drop") )
        return notify_fail( stringp(no_drop) ? no_drop : "硂妓狥﹁ぃ繦種メ斌\n");

    if (obj->move(environment(me))) {
        if( obj->is_character() )
            message_vision("$N盢$n眖璉ㄓ仅\n", me, obj);
        else {
            if ( wizardp(me) ) {
		write("唉厚︹碍е禲ㄓ钡︘メ狥﹁礛アぃǎ\n");
		destruct(obj); 
		return 1;
	    } // 畍ぃメ狥﹁ add by tears
	    message_vision( sprintf("$Nメ%s$n\n", obj->query("unit")),
		me, obj );
	    if( !obj->query("value") && !obj->value() ) {
		write("硂妓狥﹁ぃ窥┮ぃ穦猔種ウ\n");
		destruct(obj);
		return 1;
	    }
	}
	// ぃ窥狥﹁Ν碞砆 dest 奔... 硂柑⊿Τ obj.... -elon 12/2/96
	if(obj) obj->delete("keep_this");
#ifdef SAVE_USER
//    me->save();
#endif 
	return 1;
    }
    return 0;
}

int help(object me)
{
    write(@HELP
Α : drop <珇嘿>
 
硂琵メ┮拟盿珇.
ㄒ:
drop all	メ┮Τゼ keep 珇.
drop sword 2	メ┮拟盿材р sword.
drop 200 gold	メκㄢ独. 
HELP
    );
    return 1;
}
