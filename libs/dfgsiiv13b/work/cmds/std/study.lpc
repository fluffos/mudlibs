inherit F_CLEAN_UP;

int main(object me, string arg)
{
    object ob;

    if( me->is_busy() ) return notify_fail("ゲ斗ノ halt 氨ゎタ暗ㄆ\n");

    if( !arg || arg=="" ) return notify_fail("璶弄ぐ或\n");

    ob = present(arg, me);
    if( !ob ) ob = present(arg, environment(me));
    if( !ob ) return notify_fail("硂柑⊿Τ硂妓狥﹁ ...\n");

    return ob->study_ob(me);
}

int help()
{
    write(@TEXT
Αstudy <珇>

硂琵弄ㄇ膟┪ゅンぇ摸珇

弄筁祘琌讽丁の弘τ繦帝尿弄穦糤癸硂ㄇ
笆痟骋(fatigue)τ硂ㄇ痟骋琌み瞶繦帝丁τ
TEXT
    );
    return 1;
}
