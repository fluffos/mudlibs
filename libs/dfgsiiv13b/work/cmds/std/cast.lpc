#include <skill.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
    string spells, spl, trg;
    object target;
        
    if( me->query("life_form") == "ghost" )
        return notify_fail("碞κ, ет丢確!!\n");

    if( me->is_busy() ) return notify_fail("瞷⊿Τ\n");

    if( !arg ) return notify_fail("Αcast <〨ゅ嘿> [on <琁〨癸禜>]\n");

    if( sscanf(arg, "%s on %s", spl, trg)==2 ) {
	target = present(trg, environment(me));
	if( !target ) target = present(trg, me);
	if( !target ) return notify_fail("硂柑⊿Τ " + trg + "\n");

	// add by dragoon, modified by annihilator
	if( userp(target) && !interactive(target) ) {
	     write("ぃ癸耞絬い琁猭\n");
	     return 1;
	}
    } else {
	spl = arg;
	target = 0;
    }

    if( environment(me)->query("no_magic")
    && !me->is_fighting(target)
    && !target->query("unprotect_mark") ) {
	    tell_object(me, "硂柑ぃ驹矮\n");
	    return 1;
    }

    spl = replace_string( spl, " ", "_");

    notify_fail("叫ノ enable 匡拒璶ㄏノ〨ゅ╰\n");
    if( stringp(spells = me->skill_mapped("spells")) )
	return (int)SKILL_D(spells)->cast_spell(me, spl, target);

    return 0;
}

int help (object me)
{
    write(@HELP
Αcast <〨ゅ嘿> [on <琁〨癸禜>]

琁甶猭砃ゲ惠璶﹚<〨ゅ嘿><琁〨癸禜>璝矪驹篈玥菠

ㄏノ琘〨ゅぇ玡ゲ斗ノ enable ㄓ﹚璶ㄏノ〨ゅ╰
ㄏノ赣〨ゅ╰い〨ゅ〨ゅ嘿把σ help taoism

计猭砃眖秨﹍粀〨ゅЧΘ猭砃穦惠璶琿丁硂琿丁琁猭穦
礚猭簿笆┪ю阑
HELP
    );
    return 1;
}
