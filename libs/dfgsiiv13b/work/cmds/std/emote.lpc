// emote.c (Mon  09-04-95)

#include <ansi.h>
inherit F_CLEAN_UP;
 
int main(object me, string str)
{
    if (!str) {
        write(CYN"癬ㄓ薄伦碔\n"NOR);
        tell_room(environment(me), CYN+(string)me->name()+
		"癬ㄓ薄伦碔\n" +NOR, me);
        return 1;
    }
    write(CYN""+str+"\n"NOR);
    tell_room(environment(me), CYN+( (userp(me) && !wizardp(me)) ? "->":"")+(string)me->name()+
        str+"\n"+NOR, me);
    return 1;
}
 
int help(object me)
{
	write(@HELP
Α: emote <笆迭>

硂琵笷╰参⊿Τ箇砞笆迭, ╰参穦盢┮块
ゅ﹎陪ボ倒┮Τよネ. 磷硑
Θ耑, 產┮块迭玡穦 -> ㄑ跋. (畍玥ぃ
.)

絛ㄒ: emote Гㄓ
穦ǎ: Гㄓ
ㄤ穦: ->Гㄓ

ㄤい, 碞琌.

闽: semote
HELP
	);
        return 1;
}
