
inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

int main( object me, string name )
{
  string * ignore;
  int i;

  // add by dragoon
  if( name == "all" ) {
	me->set_temp("ignore/all", 1);
	tell_object(me, "秨﹍┶荡┮Τ癸弧杠\n");
	return 1;
  }
  if( name == "cancel" ) {
	me->delete_temp("ignore/all");
	tell_object(me, "秨﹍钡Μ┮Τ癸弧杠\n");
	return 1;
  }

  seteuid(getuid(me));
  ignore = me->query( "ignore" );
  if( !pointerp( ignore ) ) ignore = ({ });
  if( !name )
  {
    if( !sizeof( ignore ) ) write( "瞷⊿Τ┶荡蛤ユ酵\n" );
    else write( "瞷┶荡蛤ユ酵Τ" + implode( ignore, ", " ) + "\n");
    return 1;
  }
  if( -1 == member_array( name, ignore ) )
  {
    write( "瞷秨﹍ぃ琵  " + name + "  蛤ユ酵\n" );
    ignore += ({ name });
  } else {
    write( "瞷秨﹍琵  " + name + "  蛤ユ酵\n" );
    ignore -= ({ name });
  }
  me->set( "ignore", ignore );
  return 1;
}

int help()
{
        write(@HELP
Αignore < player > | all | cancel

讽ぃ稱蛤琘ユ酵碞ノ硂

絛ㄒ
    ignore cuteweca             ┶荡钮 cuteweca 羘
    ignore cuteweca             琵 cuteweca 蛤眤弧杠
    ignore all			┶荡钮ヴ︙癸量杠
    ignore cancel		 ignore all ノ

HELP
        );
  return 1;
}
