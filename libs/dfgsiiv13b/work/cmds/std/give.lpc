#include <command.h>
#include <login.h>

inherit F_CLEAN_UP;

int do_give(object me, object item, object who);

private void create() { seteuid(getuid()); }

int main(object me, string arg)
{
    string target, item;
    object obj, who, *inv, obj2, fwho;
    int i, amount;

    if(!arg) return notify_fail("璶倒街ぐ或狥﹁\n");

    if( !(sscanf(arg, "%s to %s", item, target)==2
        || sscanf(arg, "%s %s", target, item)==2) )
        return notify_fail("璶倒街ぐ或狥﹁\n");

    if( !objectp(who = present(target, environment(me)))
    ||  !living(who))
        return notify_fail("硂柑⊿Τ \"" + target + "\" 硂\n");

    if(who==me) return notify_fail("倒︑狥﹁稦陈\n");

    // add by dragoon
    if( objectp(who) && who->query("no_fight") )
        return notify_fail("ぐ或??\n");

    if(sscanf(item, "%d %s", amount, item)==2)
    {
        if( !objectp(obj = present(item, me)) )    
            return notify_fail("ō⊿Τ硂妓狥﹁\n");
        // 糤ぃр產倒浪琩 -Dragoon
        if( obj->query("no_drop") || userp(obj) )
            return notify_fail("硂妓狥﹁ぃ繦獽倒\n");
        if( !obj->query_amount() )    
            return notify_fail( obj->name() + "ぃ砆だ秨倒\n");
        if( amount < 1 )
            return notify_fail("狥﹁计秖︓ぶ琌\n");
        if( amount > obj->query_amount() ) 
            return notify_fail("⊿Τê或" + obj->name() + "\n");
        else if( amount == (int)obj->query_amount() )
            return do_give(me, obj, who);
        else {
            seteuid(MUDLIB_UID);
            obj2 = new(base_name(obj));
            seteuid(getuid());
            obj2->set_amount(amount);
            if( do_give(me, obj2, who) ) {
                obj->add_amount(-amount);
                return 1;
            } else {
                destruct(obj2);
                return 0;
            }
        }
    }

    if( arg=="all" ) {
        foreach(object ob in all_inventory(me))
            do_give(me, ob, who);
        write("Ok.\n");
        return 1;
    }

    if(!objectp(obj = present(item, me)))
        return notify_fail("ō⊿Τ硂妓狥﹁\n");

    return do_give(me, obj, who);
}

private int
do_give(object me, object item, object who)
{
    if( item->query("no_drop") )
        return notify_fail("硂妓狥﹁ぃ繦獽倒\n");

    if( who->over_encumbranced() )
        return notify_fail( who->name() + "竒璽颤筁穐ぃ笆ヴ︙狥﹁\n");

    notify_fail("癬ㄓ" + who->name() + "ぃ腀種Μ硂" + item->query("unit")
        + item->name() + "\n");

    if( !userp(who) ) {
        if( !who->accept_object(me, item) ) return 0;
        if( item->value() ) {
            /* 倒 NPC 窥钡盢窥綪反 */
            message_vision("$N" + item->short() + "ユ倒$n\n", me, who);
            destruct(item);
            return 1;
        }
    }

    if( !item->move(who) ) return 0;

    if( wizardp(me) && (userp(who) && !wizardp(who)) )
        log_file( "nosave/GIVE", sprintf("[%s] %s gived %s to %s\n",
                ctime(time()), geteuid(me), item->name(), geteuid(who)) );
    message_vision("$Nユ倒$n" + item->query("unit") + item->name()
        + "\n", me, who );

    return 1;
}

int help(object me)
{
    write(@HELP
Α : give <珇嘿> to <琘>
           give <琘> <珇嘿>

硂琵盢琘妓珇倒
 
HELP
    );
    return 1;
}
