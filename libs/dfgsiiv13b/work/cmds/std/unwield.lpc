// unwield.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object ob;
	string equipped, str;

	if( !arg ) {
		mapping weapons;
		string skill;

		if( mapp(weapons = me->query_temp("weapon")) && sizeof(weapons) ) {
			foreach(skill, ob in weapons) ob->unequip();
			write("Ok.\n");
			return 1;
		} else
			return notify_fail("瞷⊿Τ杆称ヴ︙猌竟\n");
	}

	if( !objectp(ob = present(arg, me)) )
		return notify_fail("ō⊿Τ硂妓狥﹁\n");

	if( !stringp(equipped = ob->query("equipped"))
	||	!sscanf(equipped, "weapon/%*s") )
		return notify_fail("⊿Τ杆称硂妓狥﹁猌竟\n");

	if( ob->unequip() ) {
		if( !stringp(str = ob->query("unwield_msg")) )
			str = "$Nもい$n\n";
		message_vision(str, me, ob);
		return 1;
	} else
		return 0;
}

int help(object me)
{
  write(@HELP
Α : unwield <珇>
 
硂琵もい猌竟
 
HELP
    );
    return 1;
}
 
