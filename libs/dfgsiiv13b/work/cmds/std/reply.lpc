#include <ansi.h>
#include <net/dns.h>

#define MIN_REPLY_INTERVAL       3
#define MAX_REPLY_MESSAGE        1024

inherit F_CLEAN_UP;

int help(object me);

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
    string target, mud, uid, *ignore;
    object obj;
    int idle_time, tmp;

    if( !arg || arg=="" )
	return notify_fail("璶氮ぐ或\n");

    if( !stringp(target = me->query_temp("reply")) )
	return notify_fail("⊿Τ㎝弧筁杠\n");

    if( time() - (int)me->query_temp("last_reply_time") < MIN_REPLY_INTERVAL )
        return notify_fail("ゲ斗ヰㄏノ硂\n");

    me->set_temp("last_reply_time", time());

    if( strlen(arg) > MAX_REPLY_MESSAGE )
        return notify_fail("癟び叫杠祏弧\n");

    if( sscanf(target, "%s@%s", target, mud)==2 ) {
	GTELL->send_gtell(lower_case(mud), lower_case(target), me, arg);
	write("呼隔癟癳璶祔眔莱\n");
	return 1;
    }

    if( (!obj = find_player(target)) || (!interactive(obj)) )
	return notify_fail("㎝弧杠瞷礚猭钮ǎ┪竒瞒秨笴栏\n");

    uid = getuid(me);
    ignore = obj->query("ignore");

    // add by dragoon to let tell work in sneak
    if( me->query_temp("pending/hidden") ) {
        tmp = me->query_temp("pending/hidden");
        me->delete_temp("pending/hidden");
    }

        if (pointerp(ignore) && member_array(uid, ignore) != -1  )
         return notify_fail(sprintf("%sぃ稱钮氮\n",obj->name(1)));
        if( obj->query_temp("netdead") )
          return notify_fail(sprintf(HIG"%s耞絬い...\n"NOR,obj->name(1)));
        write("氮" + obj->name(1) + "(" + obj->query("id") + ")"
                + HIG + arg + "\n" NOR);

    if ((idle_time = query_idle(obj)/60) > 2
    || in_input(obj)
    || in_edit(obj) ) {
                write(GRN+obj->name(1)+
                (idle_time>2 ? "竒祇 "+idle_time+" だ牧" : "")+
                (in_input(obj) ? " <块ゅい> " : "")+
                (in_edit(obj) ? " <絪胯郎い> " : "")+
                ", ぃ穦皑氮翅...\n"+NOR);
    }

        tell_object(obj, sprintf("%s(%s)氮" + HIG + "%s\n"NOR,
                me->name(1), me->query("id"), arg ));

    // reset hidden if it exist before use tell, -Dragoon
    if( tmp > 0 ) {
        me->set_temp("pending/hidden", tmp); }

        obj->set_temp("reply", me->query("id"));
        return 1;
}

int help(object me)
{
        write(@HELP
Αreply <癟>

ノ硂㎝ノ tell ┪ reply 籔弧杠ㄏノ弧杠癸よ璝祇
だ牧, ┪矪块ゅ篈, ┪絪胯郎篈, 玥╰参穦陪ボ

see also : tell
HELP
        );
        return 1;
}
