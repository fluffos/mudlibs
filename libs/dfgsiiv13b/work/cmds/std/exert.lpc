inherit F_CLEAN_UP;

private void create() { seteuid(getuid()); }

int main(object me, string arg)
{
    int ratio;
    string f, dest;
    object target;

    if( !(f = me->skill_mapped("force")) )
        return notify_fail("瞷⊿Τㄏノヴ︙ず\\n");
    if( f=="force" )
        return notify_fail("ゲ斗 enable 贺ず\\n");

    if( !arg ) {
        ratio = me->query("force_ratio");
        if( !ratio ) ratio = 75;
        printf("驹盢ㄏ%sΘ%s\\n",
            chinese_number(ratio/10), (ratio%10==0 ? "" : chinese_number(ratio%10)));
        return 1;
    }

    if( sscanf(arg, "%d", ratio)==1 ) {
        if( ratio < 10 || ratio > 100 )
            return notify_fail("北絛瞅琌ΘΘ\ぇ丁\n");
        me->set("force_ratio", ratio);
        write("Ok.\n");
        return 1;
    }

    if( me->is_busy() )
        return notify_fail("ゲ斗ノ halt 氨ゎタ暗ㄆ\n");

    if( sscanf(arg, "%s on %s", arg, dest)==2 ) {
        target = present(dest, environment(me));
//        if( !target || !target->is_target() )
//            return notify_fail("硂柑⊿Τ硂\n");
// edit by ueiren .....cant find is_target()
	if( !target ) target = present( dest, me );
	if( !target ) return notify_fail("硂柑⊿Τ硂\n");
    }
    notify_fail("┮ㄏノず\⊿Τ硂贺\\n");
    return SKILL_D(me->skill_mapped("force"))->exert_function(me, arg, target);
}

int help(object me)
{
    write(@TEXT
Αexert [<> [on <ヘ夹>]]
          exert <κだゑ(10-100)>
          exert

ㄏノず琘ㄇ┪砞﹚驹矮い璶ㄏ碭Θexert 100 ボ盢ㄏ
驹矮讽мぃ蔼癸北盢ゑ耕ぃΜ祇︑ㄏ驹矮盢ㄏ
笲ノず矗狜驹矮ю阑㏑い瞯瘆胊籔ň縨琌癸讽
癸耕畓寄匡拒ㄏノきせΘ竊砰

ぃヴ︙把计穦陪ボ瞷砞﹚

ㄏノずм┮ノ繦厩策ずτ钵硄盽ノ exert <ず嘿> ㄓ
芬ずぃ筁Τㄇ疭ず芬よ猭穦Τぃ

TEXT
    );
    return 1;
}
