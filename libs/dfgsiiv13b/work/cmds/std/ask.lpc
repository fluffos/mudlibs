inherit F_CLEAN_UP;

int help();

int main(object me, string arg)
{
    string targ, key;
    object target;

    if( !arg || arg=="" ) return notify_fail("拜ぐ或\n");

    if( sscanf(arg, "%s about %s", targ, key)==2 ) {
        target = present(targ, environment(me));
        if( !target || !target->is_character() )
            return notify_fail("硂柑⊿Τ硂\n");
                // add by dragoon
                if( objectp(target) && target->query("no_fight") )
                        return notify_fail("ぐ或??\n");
        message_vision("$N$nゴ钮Τ闽" + key + "\n", me, target);
        target->accept_inquiry(me, key);
        return 1;
    }
    else if( sscanf(arg, "%s for %s", targ, key)==2 )
    {
	target = present(targ, environment(me));
	if( !target || !target->is_character() )
	    return notify_fail("硂柑⊿Τ硂\n");

	// add by dragoon
	if( objectp(target) && target->query("no_fight") )
	    return notify_fail("ぐ或??\n");

	switch(key) {
	case "help":
	    message_vision("$N癸帝$n" + target->rank("respectful")
		+ "毕㏑\n", me, target);
            break;
	case "peace":
            if( !target->is_fighting(me) ) {
		write(target->name() + "㎝⊿Τ挡こ\n");
		return 1;
            }
            message_vision("$N$nも触弧笵硂︗"
		+ target->rank("respectful")
		+ "猌美蔼眏ㄘ狝眔候ぃて寄ね︙\n", me, target);
            break;
	case "mercy":
            if( target->is_killing(me) )
                message_vision("$N$n蛮渐各玸―笵" + target->rank("respectful")
                    + "那㏑Ωぃ幢\n", me, target);
            break;
	default:
	}
	target->accept_negotiation(me, key);
	return 1;
    }
    else
	return notify_fail("叫ノ help ask 把σ弧\n");
}

int help()
{
    write(@TEXT
Αask <琘> about <闽龄>
          ask <琘> for <ユ疉ヘ夹>

硂琵㎝ npc 秈︽ㄇ虏虫が笆ノ材贺Αボ npc ゴ钮
Τ闽琘闽龄材贺Α玥琌㎝ npc 秈︽ユ疉ヘ玡计 npc 镑
秆ユ疉ヘ夹Τ

help     癸よ―
peace    蛤Τこ璶―㎝秆
mercy    タю阑寄―那

TEXT
    );
    return 1;
}
