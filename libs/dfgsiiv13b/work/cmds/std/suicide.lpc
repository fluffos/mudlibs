#include <ansi.h>
#include <command.h>

inherit F_CLEAN_UP;

private void create() { seteuid(getuid()); }

int main(object me, string arg)
{
    object link_ob;
    string passwd;

    SECURED_COMMAND;

    if( !(link_ob = me->link()) )
        return notify_fail("硈絬ンぃǎ瞷礚猭︑炳\n");

    if( !arg ) return notify_fail("Αsuicide <盞絏>\n");

    passwd = link_ob->query("password");
    if( crypt(arg, passwd) != passwd )
        return notify_fail("盞絏岿粇\n");

    log_file("nosave/SUICIDE",
        sprintf("[%s] %s committed suicide from %s\n",
	    ctime(time()), geteuid(me), query_ip_name(me)) );
    CHANNEL_D->do_chnnel(me, "sys", me->name() + "︑炳\n");

    rm( link_ob->query_save_file() );
    rm( me->query_save_file() );
    
    write("辨临е ES2 い眤\n");
    tell_room(environment(me), me->name() +
        "︑炳ぃ硂\n", ({me}));

    destruct(link_ob);
    destruct(me);

    return 1;
}

int help (object me)
{
    write(@HELP
Αsuicide <盞絏>
 
狦琘贺ぃ稱ノ硂︑炳ㄓ埃︑炳
穦盢郎Ч︑祑盒埃礚猭毕┮︑炳玡叫叭ゲ


硂ぃ琌琵產ㄓ伐畍┪ mud恨瞶︑炳癸
產蛤畍τē常ぃ琌贾種ǎ硂㎝瞷龟ネい琘贺
糷琌ㄣΤ種竡匡拒︑炳硚畖ぇ玡叫絋﹚竒稱睲贰
絋龟フ硂ノ
HELP
    );
    return 1;
}
