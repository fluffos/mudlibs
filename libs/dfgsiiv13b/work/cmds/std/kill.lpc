#include <ansi.h>

inherit F_CLEAN_UP;

void do_kill(object, object);

int main(object me, string arg)
{
    object obj;
    string *killer, callname;

    if( me->query("life_form") == "ghost" )
	return notify_fail("碞κ, ет丢確!!\n");

    if( !arg ) return notify_fail("稱炳街\n");

    if( !(obj = present(arg, environment(me)))
    ||	!obj->is_character()
    ||	obj->is_corpse() )
	return notify_fail("硂柑⊿Τ硂\n");

    // add by dragoon
    if( wizardp(obj) ) return notify_fail("ぃ︽!!\n");

    if( environment(me)->query("no_fight") ) {
	if( !obj->query("unprotect_mark") ) {
	    tell_object(me, "硂柑ぃ驹矮\n");
	    return 1;
	}
    }

    // add by dragoon
    if( userp(obj) && !interactive(obj) ) 
        return notify_fail("硂瞷ぃ絬\n");

    if( obj->query("no_fight") ) return notify_fail("ぃ︽\n");

    if( me->is_busy() ) return notify_fail("砆寄ю眔もΓ竲睹 ...\n");

    if(obj==me) return notify_fail("ê或稱盾\n");

    me->set_temp("pending/hidden", 0);      // be visible
        
    if( ! me->is_fighting(obj)
    ||	! me->is_killing(obj) ) {
	switch( random(3) )
	{
	case 0:
	    message_vision("\n$N癸帝$n耻笵" + obj->rank("rude")
		+ "さらぃ琌碞琌и\n\n", me, obj);
	    break;
	case 1:
	    message_vision("\n$N癸帝$n耻笵" + obj->rank("rude")
		+ "㏑ㄓ\n\n", me, obj);
	    break;
	case 2:
	    message_vision("\n$N癸帝$n耻笵" + obj->rank("rude")
		+ "さぱ碞琌бら\n\n", me, obj);
	    break;
	}
    }

    do_kill(me, obj);

    return 1;
}

void do_kill(object me, object obj)
{
    me->kill_ob(obj);

    if( obj->is_fighting(me) && obj->is_killing(me) ) return;

    if( userp(obj) )
    {
	/* 癸產 kill  */
	obj->fight_ob(me);
	tell_object(obj, HIR "狦璶㎝" + me->name() 
	    + "┦㏑穒叫癸硂Ω kill \n" NOR);
    }
    else {
	/* 癸 NPC  kill  */
	if( function_exists("accept_kill", obj)
	&&  ! obj->is_killing(me)
	&&  obj->accept_kill(me) ) {
	    return; }

	if( ! obj->is_killing(me) ) obj->kill_ob(me);
	else if( ! obj->is_fighting(me) ) obj->fight_ob(me);
    }
}

int help(object me)
{
  write(@HELP
Α : kill <>
 
硂琵笆秨﹍ю阑纜刚炳癸よkill ㎝ fight 程
ぃ蛮よ盢穦痷龟簀ゴ矮碞琌弧穦痷端パ kill 惠虫よ
碵薄腀碞Θミ癸ヴ︙ㄏノ kill 常穦秨﹍驹矮硄盽狦
癸よ琌 NPC 杠穦妓癸ㄏノ kill

讽Τ癸ㄏノ kill 穦瞷︹妓牡癸產τē狦
⊿Τ癸寄ㄏノ筁 kill 碞ぃ穦盢癸よ痷ゴ端┪炳( ㄏノ猭砃┪
敖脓埃)

ㄤ闽: fight

Τ闽 fight 蛤 kill 跋だ叫 'help combat'.
HELP
    );
    return 1;
}
 
