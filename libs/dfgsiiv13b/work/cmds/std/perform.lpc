// cast.c

#include <skill.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
    object weapon;
    string martial_skill, act, trg;
    object target;

    if( me->is_busy() )
        return notify_fail("瞷⊿Τ\n");
    
    if( environment(me)->query("no_fight") )
	return notify_fail("硂柑ぃ驹矮\n");

    if( !me->is_fighting())
	return notify_fail("ゲ斗驹矮いㄏノ荡┷\n");

    if( !arg ) return notify_fail("Αperform <м:荡┷> on <ヘ夹>\n");
    
    if( sscanf( arg, "%s:%s on %s", martial_skill, act, trg) != 3
    &&	sscanf( arg, "%s:%s", martial_skill, act) != 2 )
        return notify_fail("Αperform <м.荡┷> [on <ヘ夹>]\n");
    
    if( trg ) {
        target = present(trg, environment(me));
        if( !target ) return notify_fail("璶癸街ㄏノ┷Α\n");
        if( !living(target) ) return notify_fail("钡甠硂癵ぃ眶趁ルぃ惠璶ノ荡┷\n");
    }

    if( !me->query_temp("weapon/" + martial_skill ) 
        && (martial_skill != "unarmed") )
        return notify_fail("ゲ斗杆称続讽猌竟ㄓㄏ荡┷\n");

        notify_fail("叫ノ enable 匡拒璶ㄏノм\n");

    if( (martial_skill != me->skill_mapped( martial_skill ))
    &&	(me->skill_mapped(martial_skill) != 0))
        return SKILL_D(me->skill_mapped(martial_skill))->perform_action(me, act, target);

    return 0;

}

int help (object me)
{
    write(@HELP
Αperform <м:荡┷> [on <琁┷癸禜>]

驹矮いㄏノ┮厩м荡┷ㄓ㎝琁┷癸禜癸驹荡┷把σ
м┮矗ㄑHELP

ㄒ perform sword:snowblade on guard

碞琌﹚┮ enable 糃猭 snowblade 硂┷ㄓ癸 guard 琁甶

ㄏノ琘м荡┷ぇ玡ゲ斗ノ enable ㄓ﹚璶ㄏノм
 
HELP
    );
    return 1;
}
