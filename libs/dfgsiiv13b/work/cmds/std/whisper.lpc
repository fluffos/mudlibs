// whisper.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string dest, msg;
	object ob;

	if( me->is_fighting() )
		return notify_fail("タ驹矮い\n");

	if( !arg || sscanf(arg, "%s %s", dest, msg)!=2 )
		return notify_fail("璶癸街φ粂ㄇぐ或\n");

	ob = present(dest, environment(me));
	if( !ob || !ob->is_character() )
		return notify_fail("璶癸街φ粂\n");

	if( ob->is_fighting() )
		return notify_fail( ob->name() + "タ驹矮い\n");

	write( GRN "" + ob->name() + "φ娩羘弧笵" + msg + "\n" NOR);
	tell_room( environment(me), me->name() + "" + ob->name()
		+ "φ娩羘弧ㄇ杠\n", ({ me, ob }) );
	if( !userp(ob) ) ob->relay_whisper(me, msg);
	else
		tell_object( ob, GRN + me->name() + "φ娩羘弧笵" + msg + "\n" NOR);
	return 1;
}

int help(object me)
{
	write( @TEXT
Αwhisper <琘> <癟>

硂ノㄓ㎝┬丁いφ粂珹 NPC ず
TEXT
	);
	return 1;
}
