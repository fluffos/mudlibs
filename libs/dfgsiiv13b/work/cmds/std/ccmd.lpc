#include <login.h>
#include <ansi.h>
inherit F_CLEAN_UP;

varargs int clan_line(string msg,int emote);

int main(object me, string arg)
{
    object who, obj;
    string target;

    // function 1: check all clans
    if( !arg ) {
	seteuid( getuid() );
	write("ヘ玡Τ腊: \n\n");
        write( read_file("/obj/CLAN") );
	write("\n饼腊叫тρ產ビ叫腊\n");
	return 1;
    }

    seteuid( getuid() );

    // function 2: verify - get clan symbol for a clan member
    if( arg == "verify" ) {	
	if( !me->query("clan/clan_name") ) 
	    return notify_fail("獶腊Θ\n");
	if( !present("clan symbol", me) ) {
	    obj = new("/obj/clan_symbol");
	    tell_object(me, "眔穝腊獺\n");
	    obj->move(me);
	    return 1; }
	else return notify_fail("竒Τ獺\n");
    }

    // function 3: leave - leave this clan
    if( arg == "leave" ) {
	if( me->query("clan/clan_level") > 1 )
	    return notify_fail("叫р戮︗︓腊渤\n");
	log_file("CLAN",sprintf("[%s] %s: %s(%s) leaves\n",
	    ctime(time()), me->query("clan/clan_name"), me->name(),
	    me->query("id")) );
	clan_line("セ, ㄨ癬癶" + me->query("clan/clan_name")
	    + "\n");
	me->delete("clan/clan_name");
	me->delete("clan/clan_level");
	me->delete("clan/nick");
	me->delete("clan/rank");
	if( obj = present("clan symbol", me) )
	    destruct(obj);
#ifdef SAVE_USER
	me->save();
#endif
	return 1;
    }
 
    // following function should classify function name
    if( sscanf(arg, "%s %s", arg, target)!=2 ) 
	return notify_fail("叫ノhelp ccmd琩高タ絋Α\n");

    // function 4: nick - change clan nickname
    if( arg == "nick" ) {
	me->set("clan/nick", target);
	tell_object(me, "Ok.\n");
	return 1 ;
    }

    // searching target
    //who = present(target, environment(me));
    who = find_player(target);
    if( !who || !userp(who) ) return notify_fail("⊿Τ硂\n");

    // function 5: join - apply to join a clan
    if( arg == "join" ) {
        if( me->query("clan/clan_name") ) 
	    return notify_fail("筁腊叫叉瞒ㄓ腊\n");
	if( who->query("clan/clan_level") < 2 )
	    return notify_fail("獶腊ρ\n");

	if( !present(target, environment(me)) )
	    return notify_fail("硂柑⊿Τ硂\n");

	message_vision(HIW"$N$nビ叫"+who->query("clan/clan_name")
	+"\n"NOR, me, who);
	me->set_temp("clan/apply", 1);
	return 1;
    }

    // following cmds only clan member can use them
    if( !me->query("clan/clan_name") ) return notify_fail("獶腊Θ\n");
    // the cmds need clan_level > 1 
    if( me->query("clan/clan_level") < 2 )
	return notify_fail("岿粇ノ猭┪腊戮单ぃì\n");    

    // function 6: accept - accept somebody join my clan
    if( arg == "accept" ) {
	if( !arg ) return notify_fail("稱Μ街腊??\n");

        if( !present(target, environment(me)) )
            return notify_fail("硂柑⊿Τ硂\n");

	if( who->query_temp("clan/apply") ) {
	    obj = new("/obj/clan_symbol");
	    obj->move(who);
	    seteuid( geteuid() );
	    who->delete_temp("clan/apply");
	    who->set("clan/clan_name", me->query("clan/clan_name"));
	    who->set("clan/rank", "腊渤");
	    who->set("clan/nick", "礚");
	    who->set("clan/clan_level", 1);

	    log_file("CLAN", sprintf("[%s] %s: %s(%s) accepts %s(%s)\n",
		ctime(time()), me->query("clan/clan_name"), me->name(),
		me->query("id"), who->name(), who->query("id")));

	    tell_object(who, HIY+me->name() + "ユ倒腊獺\n"NOR);
	    clan_line("舧"+who->name()+"" +
		me->query("clan/clan_name") + "!!\n"); }
        else {
            tell_object(me, "ゼビ叫腊\n");
	}
	return 1;
    }

    // check if same clan
    if( who->query("clan/clan_name") != me->query("clan/clan_name") )
	return notify_fail("ぃ琌セ腊Θ\n");

    // function 7: kickout - kickout someone from clan members  
    if( arg == "kickout" ) {
	if( target == me->query("id") ) 
	    return notify_fail("璶玵腊叫ノ: ccmd leave.\n");
	if( who->query("clan/clan_level") == 2 
	&& me->query("clan/clan_level") != 3 ) 
	    return notify_fail("ρゲ惠パ腊克︑矪瞶\n");
	if( who->query("clan/clan_level") == 3 )
	    return notify_fail("ぃ︽\n");

        seteuid( getuid() );
	if( who->query("clan/clan_level") == 2 ) {
	    // 砞ρ计ヘ
	    me->add("clan/elder", -1); }
	clan_line("ㄨ癬, " + who->name() + "ぃ琌セ腊腊渤\n");
	log_file("CLAN",sprintf("[%s] %s: %s(%s) kickouts %s(%s)\n",
	    ctime(time()), me->query("clan/clan_name"), me->name(),
	    me->query("id"), who->name(), who->query("id")) );
	tell_object(who, HIY"竒ぃ琌" +
	    who->query("clan/clan_name") + "腊渤\n"NOR);
	who->delete("clan/clan_name");
	who->delete("clan/clan_nick");
	who->delete("clan/clan_level");
	who->delete("clan/rank");
	if( obj = present("clan symbol", who) )
	    destruct(obj);
#ifdef SAVE_USER
	me->save();
	who->save();
#endif
	return 1;
    }

    // the cmds for clan leader
    if( me->query("clan/clan_level") < 3 )
	return notify_fail("岿粇ノ猭┪腊戮单ぃì\n");

    // function : promote - promote the level of clan member
    if( arg == "promote" ) {
	if( target == me->query("id") ) return notify_fail("ぃ︽!\n");
	if( who->query("class") == "commoner" )
	    return notify_fail("キチぃì踞ヴ璶戮\n");
	if( me->query_temp("clan/change_leader") ) {
	    me->delete_temp("clan/change_leader");
	    clan_line("セЧΘ琵︗祸Α, ㄨ癬, パ"
		+ who->name() + "膥ヴ" + me->query("clan/clan_name")
		+ me->query("clan/rank") + "ぇ戮\n");

	    seteuid( getuid() );
	    who->set("clan/clan_level", 3);
	    who->set("clan/elder", me->query("clan/elder"));
	    who->set("clan/rank", me->query("clan/rank"));
	    tell_object(who, HIY"戮︗パρど" +
	    	me->query("clan/rank") + "\n"NOR);
	    me->delete("clan/elder");
	    me->set("clan/clan_level", 2);
	    me->set("clan/rank", "ρ");
	    tell_object(me, HIY"戮︗パ" + who->query("clan/rank") +
		"ρ\n"NOR);
#ifdef SAVE_USER
	    me->save();
	    who->save();
#endif
	    log_file("CLAN", sprintf("[%s] %s changes %s: %s(%s) to %s(%s)\n",
		ctime(time()), me->query("clan/clan_name"), 
		who->query("clan/rank"), me->name(), me->query("id"),
		who->name(), who->query("id")) );
	    return 1;
	}

	if( who->query("clan/clan_level") == 2 ) {
	    if( who->query("level") < 40 ) {
		tell_object(me, "ぃì踞讽"
		    + me->query("clan/rank")+"ぇ戮\n");
		return 1;
	    }
	    tell_object(me, HIY"猔種!! 羭盢ㄏ" + who->name() +
		"ヘ玡" + me->query("clan/rank") + "︗," +
		"璝琌タ絋叫块Ω\n"NOR);
	    me->set_temp("clan/change_leader", 1);
	    return 1;
	}

	if( me->query("clan/elder") > 2 )
	    return notify_fail("セ腊ρ计骸, 礚猭Μ穝ρ\n");

	if( who->query("level") < 20 ) 
	    return notify_fail("ぃì踞讽ρぇ戮\n");

	clan_line("ㄨ癬, " + who->name() + "ど" + 
	    me->query("clan/clan_name") + "ρ\n");
	seteuid( getuid() );
	me->add("clan/elder", 1);
	if( who->query("clan/elder") )
	    who->delete("clan/elder");
	who->set("clan/clan_level", 2);
	who->set("clan/rank", "ρ");
	log_file("CLAN", sprintf("[%s] %s: %s(%s) promotes %s(%s)\n",
	    ctime(time()), me->query("clan/clan_name"), me->name(),
	    me->query("id"), who->name(), who->query("id")) );
#ifdef SAVE_USER
	me->save();
	who->save();
#endif
	return 1;
    }

    // function 9 : demote - demote the level of clan member
    if( arg == "demote" ) {
	if( target == me->query("id") ) 
	    return notify_fail("ゲ惠肚︗倒ρ\n");

	if( who->query("clan/clan_level") == 1 )
	    return notify_fail("戮单琌程, 礚猭\n");

	clan_line("ㄨ癬,  " + who->name() + "ρぇ戮, 腊渤\n");
	seteuid( getuid() );
	me->add("clan/elder", -1);
	who->set("clan/clan_level", 1);
	who->set("clan/rank","腊渤");
	log_file("CLAN", sprintf("[%s] %s: %s(%s) demotes %s(%s)\n",
	    ctime(time()), me->query("clan/clan_name"), me->name(),
	    me->query("id"), who->name(), who->query("id")) );
#ifdef SAVE_USER
	me->save();
	who->save();
#endif
	return 1;
    }
}

varargs int clan_line(string msg, int emote) 
{
    object *usr, me, obj;
    int i, tmp;

    me = this_player();

    if(!msg) return notify_fail("璶癸セ腊︸弧ぐ或\n");

    if( me->query_temp("pending/hidden") ) {
        tmp = me->query_temp("pending/hidden");
        me->delete_temp("pending/hidden");
    }

    if( !obj = present("clan symbol", me) )
	return notify_fail("叫眔腊獺\n");

    usr = filter_array(users(), "filter_clan", obj);
    if(sizeof(usr))
        for(i=0; i<sizeof(usr); i++)
            if (emote)
                message("system", HIY""+me->query("clan/clan_name")+""
                HIW+msg+"\n"NOR, usr[i]);
            else
                message("system", HIY""+me->query("clan/clan_name")+""
                +me->name()+"("+me->query("id")+")"HIW
                +msg+"\n"NOR, usr[i]);

    if( tmp > 0 ) {
        me->set_temp("pending/hidden", tmp); }
    return 1;
}

int help(object me)
{
write(@HELP
セ腊盡ノ, Α:
   1. ccmd: 琩高ヘ玡Θミ腊の璽砫
   2. ccmd verify: 干祇獺
   3. ccmd leave: 玵腊
   4. ccmd nick <痹瓃>: э腊拔嘿
   5. ccmd join <產id>: ビ叫腊
HELP
	);

    if( me->query("clan/clan_level") > 1 ) {
write(@HELP
   6. ccmd accept <產id>: 钡腊ビ叫
   7. ccmd kickout <產id>: 赣產ぇ腊戈
HELP
        );
    }

    if( me->query("clan/clan_level") > 2 ) {
write(@HELP
   8. ccmd promote <產id>: 矗狜腊渤戮单
   9. ccmd demote <產id>: 腊渤戮单
HELP
	);
    }
	return 1;
}
