// conjure.c

#include <skill.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string magic, spl, trg;
	object target;
	

	if( me->is_busy() )
		return notify_fail("瞷⊿Τ\n");

	if( environment(me)->query("no_magic") )
		return notify_fail("硂柑ぃ琁甶猭砃\n");

	if( !arg ) return notify_fail("Αconjure <猭砃> [on <ヘ夹>]\n");
	if( sscanf(arg, "%s on %s", spl, trg)==2 ) {
		target = present(trg, environment(me));
		if( !target ) target = present(trg, me);
		if( !target ) return notify_fail("硂柑⊿Τ " + trg + "\n");
	} else {
		spl = arg;
		target = 0;
	}

	spl = replace_string( spl, " ", "_");

	notify_fail("叫ノ enable 匡拒璶ㄏノ猭砃╰\n");
	if( stringp(magic = me->skill_mapped("magic")) )
		return (int)SKILL_D(magic)->conjure_magic(me, spl, target);
		
	return 0;
}

int help (object me)
{
        write(@HELP
Αconjure <猭砃嘿> [on <癸禜>]
 
琁猭ゲ惠璶﹚<猭砃嘿><琁〨癸禜>玥Τ礚
ㄏノ琘猭砃ぇ玡ゲ斗ノ enable ㄓ﹚
璶ㄏノ猭砃╰ㄏノ猭砃╰把σ help alchemy
 
HELP
        );
        return 1;
}
