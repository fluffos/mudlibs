// open.c

#include <room.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	mapping doors;
	string *dirs, dir, key;
	object key_ob;
	int i;

	if( !arg ) return notify_fail("璶秨ぐ或狥﹁玛\n");
	if( sscanf(arg, "%s with %s", arg, key) != 2 )
		return notify_fail("璶ノぐ或狥﹁秨玛\n");
	if( !objectp(key_ob = present(key, me)) )
		return notify_fail("ō⊿Τ硂贺狥﹁\n");

	doors = environment(me)->query_doors();
	if( mapp(doors) ) {
		dirs = keys(doors);
		if( member_array(arg, dirs)!=-1 ) dir = arg;
		else for(i=0; i<sizeof(dirs); i++)
			if( arg==doors[dirs[i]]["name"] || member_array(arg, doors[dirs[i]]["id"])!=-1 ) {
				dir = dirs[i];
				break;
			}
		if( !dir ) return notify_fail("璶秨ぐ或狥﹁玛\n");
	
		if( environment(me)->unlock_door(dir, key_ob->query("lock")) ) {
			message_vision("$N盢" + doors[dir]["name"] + "玛ゴ秨\n", me);
			return 1;
		}
	}

	return 0;
}

int help(object me)
{
        write(@HELP
Α : unlock <珇┪> with <芲巴>
 
硂琵ゴ秨玛帝┪甧竟
 
HELP
    );
    return 1;
}
