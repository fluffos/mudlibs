#include <login.h>
#include <command.h>

inherit F_CLEAN_UP;

int
main(object me, string arg)
{
    object ob;
    string userid, new_passwd;

#ifndef SAVE_USER
    return notify_fail("╰参ヘ玡ぃ纗ㄏノ戈\n");
#endif

    SECURED_ADMIN_COMMAND;

    if( previous_object() != this_player(1) ) {
        log_file("nosave/CHPASS", sprintf("[%s] %s call_other chpass command\n",
            ctime(time()), file_name(previous_object())));
        return notify_fail("硂ぃ砆丁钡㊣\n");
    }

    // Write every attempt to this command.
    log_file("nosave/CHPASS",
        sprintf("[%s] %s %s\n", ctime(time()), geteuid(this_player(1)), arg));

    if( sscanf(arg, "%s %s", userid, new_passwd) != 2 )
        return notify_fail("Αchpass <ㄏノ腹> <盞絏>\n");

    if( wizhood(userid)=="(admin)" )
        return notify_fail("ぃэ╰参恨瞶盞絏\n");

    if( find_player(userid) )
        return notify_fail("ぃэ硈絬いㄏノ盞絏\n");

    seteuid(getuid());
    ob = new(LOGIN_OB);
    ob->set("id", userid);
    if( file_size(ob->query_save_file()) < 0 )
        return notify_fail("⊿Τ硂ㄏノ\n");

    if( ! ob->restore() )
        return notify_fail("ㄏノ戈弄ア毖\n");

    if(    ob->set("password", crypt(new_passwd, 0))
    &&    ob->save() )
        write("ㄏノ " + userid + " 盞絏跑Θ\\n");
    else
        write("ㄏノ戈纗ア毖\n");

    return 1;
}

int help(object me)
{
    write(@HELP
Α : chpass <ㄏノ腹> <盞絏>
 
硂琌╰参恨瞶盡ノэ埃恨瞶ㄤ盞絏┮Τ纜刚
磅︽硂笆礚阶Θ┪ア毖常穦砆 log ㄓ
 
HELP
    );
    return 1;
}
 
