// socket.c

inherit F_CLEAN_UP;

int main(object me, string arg) {
#ifdef __PACKAGE_SOCKETS__
  /* MudOS's dump_socket_status() is socket_status() on this driver. */
  string out = sprintf("%-4s %-12s %-10s %-22s %-22s %s\n",
    "fd", "state", "mode", "local", "remote", "owner");

  foreach (mixed *st in socket_status())
    out += sprintf("%-4d %-12s %-10s %-22s %-22s %O\n",
      st[0], st[1], st[2], st[3], st[4], st[5]);
  write(out);
#else
  write("This driver has no socket package.\n");
#endif
  return 1;
}
