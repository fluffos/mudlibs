// cat.c

#include "/doc/help.h"

inherit F_CLEAN_UP;
int help(object me);

int main(object me, string arg)
{
	string file, text;

	seteuid(geteuid(this_player(1)));

    if (!arg) return notify_fail("稱璶陪ボê郎?\n");
	file = resolve_path(me->query("cwd"), arg);
	if( file_size(file)<0 ) return notify_fail("⊿Τ硂郎\n");
	if( !text = read_file(file) ) text = "";
	write(text);
	return 1;
}

int help(object me)
{
write(@HELP
Α : cat <郎>

琵(﹑)钡弄琘郎ぇ祘Α
HELP
    );
    return 1;
}
