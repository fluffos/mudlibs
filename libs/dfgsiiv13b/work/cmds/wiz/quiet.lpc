// quiet command..

inherit F_CLEAN_UP;

int main(object me, string str)
{
        object ob;
        int i;

        seteuid(getuid(me));
        if(!str) return notify_fail("Α: quiet <ㄏノ>\n");
        ob = LOGIN_D->find_body(str);
        if(!ob) return notify_fail("絬ㄏノい⊿Τ硂\n");

	seteuid(geteuid(ob));
	if (ob->query("no_chat") == 1) {
		ob->set("no_chat", 0) ; 
		tell_object(ob, "畍("+me->query("id")+")窽ē\n");
		tell_object(me,"產("+ob->query("id")+")窽ē\n");
		}
	else {
		ob->set("no_chat", 1) ;
		tell_object(ob, "畍("+me->query("id")+")窽ゎㄏノそ繵笵\n");
                tell_object(me,"币笆產("+ob->query("id")+")窽ē\n");
		}
        return 1;
}

int help(object me)
{
write(@HELP
Α : quiet <琘>

砆窽ēΩㄏノquite 碞窽ē
琵(﹑)盢琘窽ゎㄏノそノ繵笵
HELP
    );
    return 1;
}
