#include <intermud.h>
#include <command.h>

inherit F_CLEAN_UP;

private void create() { seteuid(getuid()); }

int main(object me, string arg)
{
    string addr;
    int port;

    SECURED_WIZARD_COMMAND;

    if( !arg || sscanf(arg, "%s %d", addr, port)!=2 )
	return notify_fail("Αping <IP > <UDP 梆>\n");

    INTERMUD_SERVICE("ping")->send_request(addr, port);
    write("Ok.\n");
    return 1;
}

int help(object me)
{
    write(@HELP
Αping <IP > <UDP 梆>

硂ノㄓ代刚环狠 MUD 琌磅︽い

叫猔種材把计梆腹琌 Intermud  UDP 梆腹ぃ琌 MUD 硈絬祅
梆腹狦癸よ琌 ES2-based  MUD τぃ笵 UDP 梆刚
刚 ES2 mudlib 箇砞碞琌祅梆腹 +4

闽弧
	mudlist
HELP
    );
    return 1;
}
