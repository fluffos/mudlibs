// tail.c

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg)
{
        object *ob;
        int i;
        ob=users();
        i = sizeof(ob);
        while (i--) {
        write(sprintf("%15s : %s\n",ob[i]->query("id"),
        ob[i]->query("userid")));
        }
        return 1;
}           

int help(object me)
{
write(@HELP
Α : usrid <產 id>

琵(﹑)琩琘產┪┮Τ產 userid.
HELP
    );
    return 1;
}
