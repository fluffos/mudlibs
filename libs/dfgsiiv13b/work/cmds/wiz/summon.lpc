#include <command.h>

inherit F_CLEAN_UP;

int main(object me, string str)
{
    object ob;
    int i;

    seteuid(getuid(me));
    if(!str) return notify_fail("Α: summon <ㄏノ>\n");
    ob = LOGIN_D->find_body(str);
    if(!ob) return notify_fail("絬ㄏノい⊿Τ硂\n");

    // moving
    tell_room(environment(ob), "ぱい唉もр"+
	ob->name() + "ъ癬ㄓ礛ぃǎ\n", ob);
    tell_object(ob,"唉もръ癬ㄓ泊玡皚堵 ....\n");
    ob->move(environment(me));
    tell_object(me, "р" + ob->name() + "ъ玡\n");
    tell_object(ob,".... 眶ㄓ祇瞷琌" + me->name() +
	"р筁ㄓ\n");
    log_file("nosave/SUMMON",
	sprintf("%s(%s) summon %s(%s)  %s at  %s\n",
	me->name(1), geteuid(me), ob->name(1), geteuid(ob),file_name(environment(me)),ctime(time()) ) );
    tell_room(environment(ob), ob->name() + "礛瞷泊玡\n",({me,ob}));

    // ok ..
    return 1;
}

int help(object me)
{
write(@HELP
Α : summon <琘>

琵(﹑)盢琘ъ玡
HELP
    );
    return 1;
}
