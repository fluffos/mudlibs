// arrest command..

inherit F_CLEAN_UP;

int main(object me, string str)
{
        object ob;
        int i;

        seteuid(getuid(me));
        if(!str) return notify_fail("Α: arrest <ㄏノ>\n");
        ob = LOGIN_D->find_body(str);
        if(!ob) return notify_fail("絬ㄏノい⊿Τ硂\n");
	if(ob->query("level") > 4 ) 
		return notify_fail("ぃ琌砆玂臔单ぃノ玂臔\n");

	seteuid(geteuid(ob));
	if (ob->query("get_kill") == 1) {
		ob->set("get_kill", 0) ; 
		tell_object(ob, "畍("+me->query("id")+")確玂臔\n");
		tell_object(me,"確產("+ob->query("id")+")玂臔\n");
		}
	else {
		ob->set("get_kill", 1) ;
		tell_object(ob, "畍("+me->query("id")+")玂臔\n");
                tell_object(me,"產("+ob->query("id")+")玂臔\n");
		}
        return 1;
}

int help(object me)
{
write(@HELP
Α : arrest <琘>

琵疭﹚碿產单玂臔
HELP
    );
    return 1;
}
