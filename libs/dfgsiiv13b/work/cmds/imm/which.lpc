// which.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string f;

	if( !arg ) return notify_fail("Αwhich <>\n");

	if( f = me->find_command(arg) ) {
		write(f + "\n");
		return 1;	
	}
	write("隔畖い⊿Τ硂叫刚刚 localcmds 硂\n");
	return 1;
}

int help(object me)
{
	write(@Help
Α: which <>

т┮ヘ魁

