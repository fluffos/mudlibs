#include <command.h>

inherit F_CLEAN_UP;

private void create() { seteuid(getuid()); }

int main(object me, string arg)
{
    int goto_inventory = 0, goto_object = 0;
    object obj, oldenv;
    string msg;

    SECURED_COMMAND;

    if( !arg ) return notify_fail("璶柑\n");

    if( sscanf(arg, "-i %s", arg) ) goto_inventory = 1;
    if( sscanf(arg, "-o %s", arg) ) goto_object = 1;

    if( !arg ) return notify_fail("璶柑\n");

    obj = find_player(arg);
    if(!obj) obj = find_living(arg);
    if(!obj && goto_object ) obj = present(arg, environment(me));
    if(!obj || !obj->visible(me)) {
        arg = resolve_path(me->query("cwd"), arg);
        if( !sscanf(arg, "%*s.lpc") ) arg += ".lpc";
        if( !(obj = find_object(arg)) ) {
            if( file_size(arg)>=0 ) {
                message("vision", "皚废铭撮癬" + me->name() + "ō紇硋亥罸絢\n", environment(me), me);
                return me->move(arg);
            }
            return notify_fail("⊿Τ硂產ネ┪よ\n");
        }
    }

    if(!goto_inventory && !goto_object && environment(obj))
        obj = environment(obj);

    if( !obj ) return notify_fail("硂ン⊿Τ吏挂 goto\n");

    oldenv = environment(me);
    if( !me->move(obj) )
        return notify_fail("琘贺瞶パ goto ア毖\n");

    message("vision", "ǎ皚废铭筁" + me->name() + "ō紇竒ぃǎ\n", oldenv);
    message("vision", me->name() + "ō紇礛瞷皚废铭ぇい\n", environment(me), me);

    return 1;
}

int help(object me)
{
    write(@HELP
Α : goto [-i] <ヘ夹>
 
硂穦盢肚癳﹚ヘ夹. ヘ夹琌living ┪┬丁
郎. 狦ヘ夹琌living , 穦砆簿蛤ê妓吏挂.
狦Τ -i 把计ヘ夹琌 living, 玥穦砆簿赣 living 
 inventory い.
 
HELP
    );
    return 1;
}
