// overview.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object *ob;
	int i, m;

	switch(arg) {
		case "user":
			ob = users();
			printf("Τ %d ㄏノン\n", sizeof(ob));
			break;
		case "living":
			ob = livings();
			printf("Τ %d ネ(ㄏノ)ン\n", sizeof(ob));
			break;
		case "char":
			ob = objects( (: $1->is_character() && !clonep($1) :) );
			printf("Τ %d 贺ン master copy 砆更\n", sizeof(ob));
			break;
		case "npc":
			ob = filter_array( livings(),
				(: $1->is_character() && !userp($1) && clonep($1) :) );
			printf("Τ %d  NPC ン\n", sizeof(ob));
			break;
		case "combat":
			ob = objects( (: $1->is_fighting() :) );
			printf("Τ %d タ驹矮篈\n", sizeof(ob));
			break;
		case "kill":
			ob = objects( (: $1->is_killing() && $1->is_fighting() :) );
			printf("Τ %d タ┦㏑穒驹矮篈\n", sizeof(ob));
			break;
		case "hunt":
			ob = objects( (: $1->is_killing() :) );
			printf("Τ %d タ㎝ㄤがこ\n", sizeof(ob));
			break;
		case "heart beat":
			ob = objects( (: query_heart_beat :) );
			printf("Τ %d ン heart beat Τ篈\n", sizeof(ob));
			break;
		case "virtual":
			ob = objects( (: virtualp :) );
			printf("Τ %d 店览ン\n", sizeof(ob));
			break;
		case "room":
			ob = objects( (: function_exists("create_door", $1) :) );
			printf("Τ %d ┬丁\n", sizeof(ob));
			break;
		case "special room":
			// inherits won't work if master copy got cleaned up.
			if( !find_object(ROOM) ) ROOM->foo();
			ob = objects( (: inherits(ROOM, $1) :) );
			printf("Τ %d ン膥┯夹非┬丁\n", sizeof(ob));
			break;
		case "equip":
			// inherits won't work if master copy got cleaned up.
			if( !find_object(F_EQUIP) ) F_EQUIP->foo();
			ob = objects( (: inherits(F_EQUIP, $1) :) );
			printf("Τ %d ン膥┯夹非杆称\n", sizeof(ob));
			break;
		case "object":
			ob = objects();
			printf("Τ %d ン砆更\n", sizeof(ob));
			break;
		default:
			return notify_fail("Αoverview <topic>\n");
	}
	m = 0;
	i = sizeof(ob);
	while(i--)
		m += memory_info(ob[i]);
	printf("羆ㄏノ %d bytes 癘拘砰\n", m);
	if( sizeof(ob) )
		printf("キА–ンㄏノ %d bytes 癘拘砰\n", m / sizeof(ob));
	return 1;
}

int help()
{
	write(@TEXT
Αoverview <肈>

user:		userp()
living:		living()
room:		function_exists("create_door", ob);
TEXT
	);
	return 1;
}


