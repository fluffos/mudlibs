// rehash.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
        seteuid(geteuid(this_player(1)));
	if( !arg )
		return notify_fail("Αrehash <隔畖>\n");

	if( arg[strlen(arg)-1]!='/' ) arg += "/";
	if(  file_size(arg)!=-2 )
		return notify_fail("⊿Τ硂ヘ魁\n");

	write("穝" + arg + "\n");
	seteuid(getuid());
	COMMAND_D->rehash(arg);
	return 1;
}

int help(object me)
{
	write(@HELP
Αrehash <ヘ魁嘿>

硂穦穝╰参ず场狦穝糤┪埃琘ヘ魁ゲ斗ノ
硂穝赣ヘ魁ㄏノ
HELP
	);
	return 1;
}
