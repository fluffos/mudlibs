inherit F_CLEAN_UP;

private void create() { seteuid(getuid()); }

int main(object me, string arg)
{
    object ob, *all_ob;
    int i;

    if( !arg ) return notify_fail("Αkeep <ō珇>\n");
    if( arg=="all" ) {
        all_ob = all_inventory(me);
        i = sizeof(all_ob);
        while( i-- )
            all_ob[i]->set("keep_this", 1);
        write("盢┮Τō狥﹁癘癘腹》\n");
        return 1;
    }
    if( arg=="none" ) {
        all_ob = all_inventory(me);
        i = sizeof(all_ob);
        while( i-- )
            all_ob[i]->set("keep_this", 0);
        write("盢┮Τō狥﹁ぇ癘腹》睲奔\n");
        return 1;
    }
    ob = present(arg, me);
    if( !ob ) return notify_fail("ō⊿Τ硂妓狥﹁\n");
    if( userp(ob) ) return notify_fail("ぃ︽\n");
    if( ob->query("keep_this") ) {
        ob->delete("keep_this");
        write("р " + ob->name() + " 癘腹》睲奔\n");
    }
    else {
        ob->set("keep_this", 1);
        write(" " + ob->name() + " ゴ癘腹》\n");
    }
    return 1;
}

int help(object me)
{
    write(@HELP
Αkeep <ō珇>|<all>|<none>

ㄒ:
keep none    盢┮Τ珇秆埃 keep
keep sword    皐癸 sword 砞﹚ keep ┪秆埃 keep

砞﹚ō璶珇ぃ穦砆ぃみメ斌( drop all ┪ sell all) inventory
琩琌砞﹚ keep 》

砞﹚ぃ繦種メ斌狥﹁Τ讽﹚メ斌/芥硂狥﹁穦砆メ斌┪芥ㄤ
砞﹚穦砆秆埃璝盢砞﹚ぃ繦種メ斌珇メ具癬ㄓゲ斗穝砞﹚Ω
HELP
    );
    return 1;
}
