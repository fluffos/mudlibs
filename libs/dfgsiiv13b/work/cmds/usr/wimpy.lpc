#include <statistic.h>

inherit F_CLEAN_UP;

void create() {seteuid(getuid());}

int main(object me, string arg)
{
    string stat, dir;
    int ratio;

    if( !arg )
    {
	string* stat_name = me->query_stat_name();
	string msg = "兜计ゑㄒ穦︑笆発㏑\n";
	if( arrayp(stat_name) && sizeof(stat_name) )
	    foreach(stat in stat_name)
	    {
		ratio = me->query_stat_notify(stat);
		if( ratio > 0 )
		    msg += sprintf("  %s\t%d%%\n", to_chinese(stat), ratio);
	    }
        else
            msg += "⊿Τ砞﹚\n";
        if( dir = me->query("wimpy_dir") )
            msg += "箇砞発禲よ琌 " + dir + "\n";
        write(msg);
        return 1;
    }

    if( sscanf(arg, "%s at %d", stat, ratio) == 2 )
    {
	if( !me->query_stat_maximum(stat) )
            return notify_fail("⊿Τ硂兜计兜ヘ\n");

        if( (ratio < 0) || (ratio > 80) )
            return notify_fail("ゑㄒゲ斗 0  80 ぇ丁\n");

        me->set_stat_notify(stat, ratio);
        write("Ok\n");

        return 1;
    }
    else if( sscanf(arg, "to %s", dir) ) {
        me->set("wimpy_dir", dir);
        write("Ok\n");
        return 1;
    }
    else if( arg=="random" ) {
        me->delete("wimpy_dir");
        write("Ok.\n");
        return 1;
    }

    return notify_fail("Αwimpy <计兜ヘ> at <ゑㄒ>\n");

}

int help()
{
    write(@TEXT
Αwimpy <计兜ヘ> at <κだゑ>
          wimpy to <よ>
          wimpy random

硂琵砞﹚琘兜计κだゑ︑笆発禲
(–计兜ヘ常砞璶ㄤい砞κだゑ碞穦発禲)

砞﹚计兜ヘ珹

HP        ネ㏑翴计
gin       弘
kee       
sen       
food      
water     都

wimpy to <よ> 琵﹚発禲┕よ禲
wimpy random 硂﹚発禲よ
TEXT
    );
    return 1;
}
