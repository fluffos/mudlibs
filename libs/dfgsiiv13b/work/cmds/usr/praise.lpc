#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
    object ob;
    int level = me->query_level();
    string pro = me->query_class();

    seteuid(getuid());

    if( wizardp(me) ) return notify_fail("畍ぃ苂喘\n");

    // This prevent abuse of praise from new characters.
    if( level < 2 ) return notify_fail("ゲ斗ど材ぇ苂喘Τ狦\n");

    if( me->query("praise_done") )
        return notify_fail("ぃ玡苂喘筁ゲ斗どぇ苂喘\n");

    if( !arg || arg=="" )
        return notify_fail("璶苂喘街\n");

    ob = find_player(arg);
    if( !ob ) return notify_fail("硂ぃ絬\n");
    if( wizardp(ob) )
        return notify_fail( ob->name() + "谅谅種ぃ筁叫苂喘猋洁產\n");
    if( ob==me )
        return notify_fail("硂ぃ琌ノㄓ︑肛钡苂喘\n");

    log_file("praise", sprintf("[%s] %s praised %s at level %d.\n",
        ctime(time()), getuid(me), getuid(ob), level) );
    
    if( pro=="commoner")
        ob->gain_score("reputation", level-1);
    else
        ob->gain_score("reputation", (level-1) * (level-1) );

    me->gain_score("reputation", 1);
    if( pro!="commoner" && ob->query_class()==pro )
        CLASS_D(pro)->brother_praise(me, ob);
    me->set("praise_done", 1);

    shout( sprintf(YEL "%s癸%s苂喘莉眔砛\粄矗蔼%s羘辨\n" NOR,
            me->name(), ob->name(), ob->name() ));
    write("Ok.\n");

    return 1;
}

int help()
{
    write(@TEXT
Αpraise <產>

硂琵苂喘琘︗猋洁產矗蔼癸よ羘辨讽ど材ぇ–
Ωど矗苂喘Ωτ钡苂喘⊿Τヴ︙狦苂喘
產㎝ㄣΤ戮穨羘辨矗ど狦┪ㄖ糤ㄇ盡穨羘辨璝
琌セōご妮キチō玥パセō猌狶いゼΤì镑ぇ羘辨羘辨ぇ矗ど狦耕畉
TEXT
    );
    return 1;
}
