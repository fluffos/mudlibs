#include <ansi.h>
#include <command.h>

inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
    mapping map;
    string *types, *skill, ski, map_to;
    int i, modify;

    SECURED_COMMAND;

    if( !arg ) {
        map = me->query_skill_map();
        if( !mapp(map) ) map = ([]);

        write("琌ヘ玡ㄏノい疭м\n");
        foreach( skill, map_to in map ) {
            printf("%-20s%s\n", to_chinese(skill),
                map_to ? to_chinese(map_to) : "ぃㄏノ");
        }
        return 1;
    }

    if( sscanf(arg, "%s with %s", ski, map_to)==2 ) {

        if( !me->query_skill(map_to, 1) && !me->query_learn(map_to) )
            return notify_fail("ぃ穦硂贺м\n");

        if( !function_exists("valid_enable", SKILL_D(map_to)) )
            return notify_fail( "" + to_chinese(map_to) + "ぃ㎝ㄤмノ\n");

        notify_fail("硂мぃ讽Θ硂贺ノ硚\n");
        if( !SKILL_D(map_to)->valid_enable(ski) )
            return 0;

        me->map_skill(map_to, map_to);
        me->map_skill(ski, map_to);

        write("∕﹚ㄏノ" + to_chinese(map_to) + "讽" + to_chinese(ski) + "\n");
        return 1;
    }

    if( !me->query_learn(arg) )
        return notify_fail("⊿Τ厩筁硂贺м\n");

    if( me->skill_mapped(arg)==arg ) {
        write("続讽初穦︑笆ㄏノ硂м\n");
        return 1;
    }

    me->map_skill(arg);
    write("∕﹚確ㄏノ┮厩Τ闽" + to_chinese(arg) + "мォ\n");

    return 1;
}
int help(object me)
{
    write(@HELP
Α : enable <м贺摸> with <м嘿>   <- ㄏノ疭м猌砃
           enable <м贺摸>                   <- ノ膀セм

硂琵﹚┮璶ノм惠м贺摸㎝м嘿狦ぃ把计玥穦
陪ボм贺摸のヘ玡┮ㄏノм嘿 狦 ? 穦┮Τㄏノ疭
мм贺摸

SEE ALSO:
    disable 
HELP
    );
    return 1;
}
