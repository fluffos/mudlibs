inherit F_CLEAN_UP;

private void create() { seteuid(getuid()); }

int main(object me, string arg)
{
    object ob;
    mapping m;
    string sk, sk_m;

    if( !arg || !(ob = SKILL_D(arg)) || ob==SKILL_D("none") )
        return notify_fail("璶氨ノぐ或м\n");

    if( me->is_busy() )
        return notify_fail("タΓ帝ㄆ, 礚猭盡み\n");

    if (!me->query_learn(arg)) 
        return notify_fail("ヘ玡ぃ穦硂兜м\n");

    if( !function_exists("valid_enable", ob) ) {
        me->map_skill(arg, "none");
        write("∕﹚既氨ゎㄏノ┮厩Τ闽" + to_chinese(arg) + "мォ\n");
    } else {
	int c = 0;
	m = me->query_skill_map();
	foreach(sk, sk_m in m) {
	    if( sk_m==arg ) {
		me->map_skill(sk);
		write("∕﹚氨ゎ" + to_chinese(sk) + "よ氨ゎㄏノ┮厩Τ闽" + to_chinese(arg) + "мォ\n");
		c++;
	    }
	}
	if( !c ) {
	    write("∕﹚氨ゎㄏノ┮厩Τ闽" + to_chinese(arg) + "мォ\n");
	    me->map_skill(arg, "none");
	}
    }

    return 1;
}

int help()
{
    write(@TEXT
Αdisable <м>

硂琵氨ゎㄏノ琘贺м硂柑┮м琌ゑ耕約竡糃猭猭
单狦璶氨ゎㄏノ琘贺糃猭摸猌璶ノ enable 砞﹚糃猭Θㄤ猌


ㄤ闽enableskills
TEXT
    );
    return 1;
}
