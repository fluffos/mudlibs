inherit F_CLEAN_UP;

int main(object me, string arg)
{
    string term, txt;
    int g;
    mapping score_g, skill_g;

    score_g = me->query_score_gain();
    me->reset_score_gain();
    skill_g = me->query_skill_gain();
    me->reset_skill_gain();

    txt = "眖Ωㄏノ gain 瞷ゎ莉眔\n\n";
    
    txt += "竒喷翴计\n";
    if( !sizeof(score_g) )
	txt += "    礚\n";
    else {
	foreach(term, g in score_g)
	    txt += sprintf("    %-16s %+d 翴\n",
		to_chinese("score of " + term), score_g[term] );
    }

    txt += "\nм翴计\n";
    if( !sizeof(skill_g) )
	txt += "    礚\n";
    else {
	foreach(term, g in skill_g)
	    txt += sprintf("    %-16s %+d 翴\n",
		to_chinese(term), skill_g[term] );
    }

    write(txt);
    return 1;    
}

int help()
{
    write(@TEXT
Αgain

硂ノㄓ浪喷Θ–Ω莉眔ヴ︙竒喷翴计┪м翴计╰
参穦癘魁┮莉眔讽ㄏノ gain 穦陪ボ硂ㄇ礛睲埃硂ㄇ魁眖繷秨
﹍驹矮秨﹍玡ノ gain 睲埃礛驹矮挡ノ gain 浪跌眖
驹矮い莉ぶ秈˙
TEXT
    );
    return 1;
}
