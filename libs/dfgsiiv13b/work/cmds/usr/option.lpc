#include <command.h>

inherit F_CLEAN_UP;

private void create() { seteuid(getuid()); }

int main(object me, string arg)
{
    string term;
    mixed v;

    if( !arg )
    {
        mapping opt = me->query("option");
        string str = "砞﹚匡兜\n";

        if( !mapp(opt) || !sizeof(opt) )
            str += "    礚\n";
        else
            foreach(term, v in opt)
                str += sprintf("    %-20s%O\n", term, v);
        write(str);
        return 1;
    }

    if( sscanf(arg, "%s %d", term, v)==2
    ||	sscanf(arg, "%s %s", term, v)==2 ) {
	if( !v ) me->delete("option/" + term);
	else me->set("option/" + term, v);
    } else
	return notify_fail("Αoption <匡兜> <砞﹚>\n");

    write("Ok.\n");
    return 1;
}

int help()
{
    write(@TEXT
Αoption <匡兜> <砞﹚>

硂琵砞﹚ㄇΤ闽ㄏノざ匡兜

BRIEF_ROOM
  0 - 簿笆芠诡┬丁冈灿痹瓃(箇砞)
  1 - 簿笆ぃ陪ボ┬丁冈灿痹瓃

BRIEF_SHORT
  0 - 陪ボ珇のいゅ籔璣ゅ嘿(箇砞)
  1 - 陪ボ珇のいゅ嘿
TEXT
    );
    return 1;
}
