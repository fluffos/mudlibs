#include "/doc/help.h"

inherit F_CLEAN_UP;

nosave string *default_search = DEFAULT_SEARCH_PATHS;

private void create() { seteuid(getuid()); }

int main(object me, string arg)
{
    string file, *search;

    if( !arg ) {
        cat(HELP_DIR + "help/topics");
        return 1;
    }

    arg = replace_string(arg, " ", "_");

    // Else, try if a command name is specified.
    seteuid(getuid());
    if( stringp(file = me->find_command(arg)) ) {
        notify_fail("Τ硂琌⊿Τ冈灿弧ゅン\n");
        return file->help(me);
    }

    // Support efun/lfun help with same name as other topics such as
    // ed() and ed command.
    sscanf(arg, "%s()", arg);

    search = DEFAULT_SEARCH_PATHS;
    if( wizardp(me) )
        search += WIZARD_SEARCH_PATHS;
        
    foreach(string path in search)
    {
	if( file_size(path + arg) < 0 ) continue;
	if( wizardp(me) )
	    write("弧ゅン" + path + arg
		+ "\n---------------------------------------------------------------------\n");
	me->start_more( read_file(path + arg) ); 
	return 1;
    }

    return notify_fail("⊿Τ皐癸硂兜肈弧ゅン\n");
}

int help(object me)
{
    write(@HELP
Αhelp <肈>              ㄒ> help all
          help <ㄧ计嘿>()        ㄒ> help call_out()

硂矗ㄑ皐癸琘肈冈灿弧ゅン璝琌ぃ﹚肈玥矗ㄑΤ闽肈
ゅン┮Τ肈籔ㄧ计嘿璣ゅ
HELP
    );
    if( wizardp(me) )
        write(@HELP
セ穦穓碝肈琌 command, ( 璝㊣畍, 玥钡帝穓碝 /doc/help.h
い WIZARD_SEARCH_PATHS ), 穓碝 DEFAULT_SEARCH_PATHS 
璝Τ郎ぇゅン矪硂ㄇ穓碝︗竚い, 玥︗穓隔畖盢ぃ砆穓碝, 
玡穓碝ぇ doc, 絪籹穝ゅン叫痙種
HELP
        );
    return 1;
}
