inherit F_CLEAN_UP;

private void create() { seteuid(getuid()); }

int main(object me, string arg)
{
    string *txt;

    if( !arg ) return notify_fail("Αdescribe <磞瓃>\n");

    txt = explode(arg, "\n");
    if( (strlen(arg) > 400) || (sizeof(txt) > 8) )
        return notify_fail("眤痹瓃び叫北︽ㄢκず\n");

    arg = implode(txt, "\n") + "\n";

    me->set("long", arg);
    write("Ok\n");
    return 1;
}

int help()
{
    write(@TEXT
Αdescribe <磞瓃>

硂琵砞﹚讽ノ look 癸磞瓃硄盽讽
磞瓃禬筁︽ノ to describe よΑㄓ块
TEXT
    );
    return 1;
}
