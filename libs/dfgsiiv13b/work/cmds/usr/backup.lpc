#include <command.h>
#include <login.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
    int last_backup, delta_t;
    string save_file;

    SECURED_COMMAND;

    seteuid(getuid());

    if( (last_backup = me->query_temp("last_backup"))
    &&  (delta_t = (time()/60 - last_backup)) < 5 ) {
	write( sprintf("ぃノ%d だ牧玡称筁%d だ牧刚\n",
		delta_t, (5-delta_t)) );
	return 1;
    }

#ifdef SAVE_USER
    save_file = me->query_save_file();
    if( cp(save_file, save_file+".backup") ) {
	write("称Ч拨\n");
	me->set_temp("last_backup", (int)(time()/60) );
    }
    else
	write("称ア毖\n");
    return 1;
#else
    return notify_fail("╰参ヘ玡ぃ纗ㄏノ戈\n");
#endif
}

int help(object me)
{
    write(@HELP
Αbackup

рǒ璚灸矮挡狦称癬ㄓ矗ど╰参瞯ヘ玡ㄢΩ backup ぇ丁丁禯程
祏きだ牧

硂ヘ琌磷ㄏノ綝 <獶砞璸種礚猭磷> τ硑
Θ礚猭辣干ぇ穕ア

讽畍┪粄Τゲ璶穦盢称郎
HELP
    );
    return 1;
}
