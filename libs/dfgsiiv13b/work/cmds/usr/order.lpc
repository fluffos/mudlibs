inherit F_CLEAN_UP;

int main(object me, string arg)
{
    int res;
    object ob;
    string who, cmd, verb, path;

    // No indirect mode for this command.
    if( me != this_player(1) ) return 0;

//    if( !wizardp(me) ) return 0;

    if( !arg || arg=="" || sscanf(arg, "%s to %s", who, cmd)!=2 )
        return notify_fail("璶㏑街暗ぐ或ㄆ\n");

    ob = present(who, environment(me));
    if( !ob || !ob->is_character())
        return notify_fail("硂柑⊿Τ硂\n");

    if( sscanf(cmd, "%s %*s", verb) != 2 ) verb = cmd;

    if( stringp(path = ob->find_command(verb))
    &&    path != "/cmds/std/" + verb )
        return notify_fail("ぃ㏑暗硂贺ㄆ\n");

    if( wizardp(ob) && wiz_level(me) <= wiz_level(ob) )
        return notify_fail("ぃ揣硂\n");

    write("㏑" + ob->name() + ": " + cmd + "\n");
    if( (object)ob->query_temp("possessed") != me
    &&    !ob->accept_order(me, verb) )
        return notify_fail( "癬ㄓ" + ob->name() + "ぃ稱钮揣\n");

    notify_fail( ob->name() + "礚猭ЧΘ硂㏑\n");
    seteuid(getuid());
//    snoop(me, ob);
    res = ob->force_me(cmd);
//    snoop(me);
    return res;
}

int help(object me)
{
    write(@TEXT
Αorder <琘> to <>

㏑磅︽琘︓︙ㄏ钮㏑ ... ︑т :P
TEXT
    );
    return 1;
}
