inherit F_CLEAN_UP;

// This command is also called by LOGIN_D, so we don't want it use 
// arguments.
int main()
{
    seteuid(getuid());
    write("狥よ珿ㄆ⒑竒磅︽" + CHINESE_D->chinese_period(uptime()) + "\n");
    printf("瞷丁 "+ctime(time())+"\n");
    return 1;
}

int help(object me)
{
    write(@HELP
Α : uptime
 
硂禗狥よ珿ㄆ II 竒硈尿磅︽
の硂诀竟ヘ玡丁
 
HELP
    );
    return 1;
}
