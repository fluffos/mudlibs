#include <login.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
    object link_ob;
    int last_save, delta_t;
    
    seteuid(getuid());

    if( !objectp(link_ob = me->link()) )
        return notify_fail("ぃ琌竒パタ盽硈絬秈ぃ纗\n");

    if( environment(me)->query("valid_startroom") ) {
        me->set("startroom", base_name(environment(me)));
        write("讽Ω硈絬秈ㄓ穦眖硂柑秨﹍\n");
    }

    if( !wizardp(me)
    &&  (last_save = me->query_temp("last_save"))
    &&  (delta_t = (time()/60 - last_save)) < 5 ) {
        return notify_fail("ぃノ, " +delta_t+ " だ牧玡纗筁, " +(5 - delta_t)+ " だ牧刚\n");
    }

#ifdef SAVE_USER
    if( (int)me->save() ) {
        write("郎纗Ч拨\n");
        me->set_temp("last_save", (int)(time()/60) );
        return 1;
    } else {
        write("纗ア毖\n");
        return 0;
    }
#else
    return notify_fail("╰参ヘ玡ぃ纗ㄏノ戈\n");
#endif
}

int help(object me)
{
    write(@HELP
Αsave

рǒ璚灸矮挡狦癬ㄓ矗ど╰参瞯, ヘ玡ㄢΩ save ぇ丁丁禯程祏
きだ牧 quit ╰参穦刚帝腊 save
see also: quit, backup
HELP
    );
    return 1;
}
