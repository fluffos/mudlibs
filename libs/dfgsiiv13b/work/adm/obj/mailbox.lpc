#include <ansi.h>

inherit ITEM;
inherit F_SAVE;

/* 硂 mapping 纗更秎ンず甧 private ňゎ砆ㄤン
 * 膥┯よΑ
 */
private mapping *mails;

void get_mail_text(mapping mail, string str);

private void
create()
{
    set_name("獺ゾ", "mail folder", "mail", "folder" );
    set("long", @LONG
硂琌ノㄓ俱瞶獺ン獺ゾノㄓ矪瞶獺ン

mail <琘>		盚獺倒埃獶琌畍玥ゲ斗沛盚獺
forward <絪腹> <琘>	盢琘獺锣盚倒妓ゲ斗沛Τノ
from [-a]		琩獺ゾい獺ン箇砞陪ボ﹟ゼ弄獺ン -a
			穦陪ボ场獺ン
read <絪腹>		綷弄獺ン
discard <絪腹>		メ斌獺ン
LONG
    );
    set("unit", "");
    set("no_drop", "╬獺ゾ叫ぃ璶繦獽メ斌\n");
    set("no_insert", 1);
    setup();

    seteuid(0);	/* 睲埃 euid琵 SMTP daemon ﹚ uid 倒硂ン */
}

varargs string
short(int raw)
{
    if( arrayp(mails) && sizeof(mails) )
	return ::short(raw) + "[ " + sizeof(mails) + " 獺 ]";
    return ::short(raw) + "[ 礚 ]";
}

nomask void
retire()
{
    destruct(this_object());
}

nomask private void
init()
{
    object ob;

    if( environment()!=this_player() ) {
	/* 惫琁璝 mailbox 砆簿笆 this_player() よミㄨ
	 * 綪反ンい更秎ンず甧鲸е綪反硂ン
	 */
	mails = 0;
	call_out("retire", 0);
	return;
    }

    seteuid(getuid());		/* 砞﹚ euidノㄓ更 SMTP daemon */
    ob = load_object(SMTP_D);
    seteuid(0);			/* 睲埃 euid琵 SMTP ﹚ uid 倒硂ン */
    ob->restore_mailbox(this_object());

    if( objectp(ob = this_player()->query_temp("mbox_ob")) )
	ob->retire();

    this_player()->set_temp("mbox_ob", this_object());

    set("owner_ob", this_player());
    add_action("do_mail", "mail");
    add_action("do_forward", "forward");
    add_action("do_from", "from");
    add_action("do_read", "read");
    add_action("do_discard", "discard");
}

nomask string
query_save_file()
{
    return mail_data(getuid());
}

void receive_mail(mapping mail)
{
    /* 钡ㄓ︑ㄣΤ ROOT 舦ン┮癳獺 */
if (!previous_object()) error("no previous object\n");
    if( geteuid(previous_object()) != ROOT_UID )
	error("Permission denied.\n");

    if( !pointerp(mails) ) mails = ({ mail });
    else mails += ({ mail });
}

private int
do_mail(string arg)
{
    mapping mail;

    if( this_player()!=environment() ) return 0;
    if( !wizardp(this_player())
    &&  !environment(this_player())->query("post_office") )
	return notify_fail("ゲ斗т丁沛盚獺\n");

    if( !arg || arg=="" )
	return notify_fail("璶盚獺倒街\n");

    mail = ([
	"from": this_player()->name(1) + "(" + this_player()->query("id") + ")",
	"unread": 1 ,
	"title": "礚肈",
	"to": arg,
	"time": time(),
	"text": ""
    ]);
    write("獺ン夹肈");
    input_to("get_mail_title", mail);
    return 1;
}

private void
get_mail_title(string str, mapping mail)
{
    if( str!="" ) mail["title"] = str;
    write("獺ンず甧\n");
    this_player()->edit( (: get_mail_text, mail :) );
}

void get_mail_text(mapping mail, string str)
{
    mail["text"] = str;
    write("眤︑璶痙称盾(y/n)[n]");
    input_to("confirm_copy", mail);
}

private void
confirm_copy(string yn, mapping mail)
{
    if( yn[0]=='y' || yn[0]=='Y' ) receive_mail(mail);
    if( SMTP_D->send_mail(getuid(), mail["to"], mail) )
	write("Ok.\n");
    else
	write("盚獺ア毖\n");
}

private int
do_from(string arg)
{
    int i, n_listed = 0, all = 0;
    string txt = "--------------------------------------------------\n";

    if( !arrayp(mails) || !sizeof(mails) ) {
	write("獺ゾいヘ玡⊿Τヴ︙獺ン\n");
	return 1;
    }

    if( arg=="-a" ) all = 1;
    for(i=sizeof(mails)-1; i>=0; i--)
    {
	mapping msg = mails[i];

	if( !all && !msg["unread"] ) continue;
	n_listed++;
	if( msg["unread"] == 1 )
	    txt += sprintf("%2d " HIC "%-46s ㄓ︑: %-20s\n" NOR,
		i+1, msg["title"], msg["from"]);
	else
	    txt += sprintf("%2d %-46s ㄓ︑: %-20s\n",
		i+1, msg["title"], msg["from"]);
    }
    if( all ) txt = "瞷Τ " + sizeof(mails) + " 獺ン\n" + txt;
    else txt = sprintf("Τ %d/%d ゼ弄獺\n%s", n_listed,
	sizeof(mails), txt);
    this_player()->start_more(txt);

    return 1;
}

private int
do_read(string arg)
{
    int num;

    if( !arg || !sscanf(arg, "%d", num) )
	return notify_fail("璶弄獺\n");

    if( !pointerp(mails) || num < 1 || num > sizeof(mails) )
	return notify_fail("⊿Τ硂絪腹獺ン\n");

    num--;

    printf(HIC "獺ン夹肈%s\n盚獺%s" NOR "\n\n%s\n",
	mails[num]["title"], mails[num]["from"], mails[num]["text"] );

	mails[num]["unread"] = 0;
	save();
    return 1;
}

private int
do_discard(string arg)
{
    int num;

    if( !arg || !sscanf(arg, "%d", num) )
	return notify_fail("璶メ斌獺\n");

    if( !pointerp(mails) || num > sizeof(mails) )
	return notify_fail("⊿Τ硂絪腹獺ン\n");

    num --;

    mails = mails[0..num-1] + mails[num+1..sizeof(mails)-1];
    save();
    write("Ok.\n");

    return 1;
}

private int
do_forward(string arg)
{
    string dest;
    int num;
    mapping m;

    if( !wizardp(this_player())
    &&  !environment(this_player())->query("post_office") )
	return notify_fail("ゲ斗т丁沛盚獺\n");

    if( !arg || sscanf(arg, "%d %s", num, dest)!=2 )
	return notify_fail("璶盢獺锣盚倒\n");

    if( !pointerp(mails) || num > sizeof(mails) )
	return notify_fail("⊿Τ硂絪腹獺ン\n");

    num --;

    m = ([]);
    m["title"] = mails[num]["title"];
    m["text"] = mails[num]["text"];
    m["unread"] = 1;
    m["time"] = mails[num]["time"];
    m["from"] = mails[num]["from"] + "/锣盚︑" + this_player()->query("name");
    m["to"] = dest;
    SMTP_D->send_mail( getuid(), dest, m );
    write("Ok.\n");

    return 1;
}

nomask void
owner_is_killed()
{
    retire();
}

