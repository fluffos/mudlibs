#include <ansi.h>
#include <command.h>

inherit ROOM;

string filename;

void create()
{
        set("short", "穦某芔");
        set("long", @LONG
硂柑琌狥よ毙穦某芔, Τぐ或ㄆ薄璶癚阶常穦硂秈︽
蛾┬丁, フ︹鲤, 綫帝︹脆, ┬丁郴狠芧畆帝聋
垂ホ, 絬碞眖垂ホ床祇ㄓ, 酚獹俱┬丁, 獹玱ぃ
泊綼鲤娩疊帝遏档︹ド狾, 狾ㄨㄇ玭娩
畍そ穦
LONG
        );

        set("exits", ([ /* sizeof() == 1 */
                "south" : "/adm/guild/guildhall"
        ]));

	set("detail", ([ /* sizeof() == 1 */
		"ド狾" : "遏钠疊い档籄ド狾, ㄨㄇ:

穦某癘魁よ猭:
start <filename> :	秨﹍癘魁穦某筁祘, filename 琌穦某癘魁郎
over :			氨ゎ癘魁穦某筁祘

",
	]));
	setup();
	load_object("/daemon/board/wizard_talk");
}

void init()
{
	add_action("say", ({"say", "'"}) );
	add_action("start", "start");
	add_action("over", "over");
}

int start(string str)
{
	if( !wizardp(this_player()) )
	return notify_fail("⊿Τ舦秨穦某\n");

	if( !str )
	return notify_fail("璶盢穦某癘魁糶ê郎??\n");

	if ( (int)query("meeting_trigger") != 0 )
	return notify_fail("ヘ玡タ秨穦い\n");

	set("meeting_trigger", 1);
	message_vision(HIW"\n$Nガ瞷穦某タΑ秨﹍\n\n"NOR, this_player());
	filename = str;
	log_file(filename, sprintf("[%s] %s (%s) 秨币穦某\n",
		ctime(time()), this_player()->name(1), geteuid(this_player())));
	return 1;
}

int say(string msg)
{
	if( !msg ) return 0;
	else
	SAY_CMD->main(this_player(), msg);
	if ((int)query("meeting_trigger") == 1)
	log_file(filename,
	sprintf("%s弧笵" + msg + "\n",this_player()->name(1)) );
	return 1;
}

int over()
{
	if( !wizardp(this_player()) )
        return notify_fail("⊿Τ舦挡穦某\n");

	delete("meeting_trigger");
	log_file(filename, sprintf("[%s] %s (%s) 挡穦某\n",
		ctime(time()), this_player()->name(1), geteuid(this_player())));
	message_vision(HIW"\n$Nガ穦某挡\n\n"NOR, this_player());
	return 1;
}
