varargs int
getoid(object ob)
{
    int id;

    if (!ob) ob = previous_object();
    sscanf(file_name(ob), "%*s#%d", id);
    return id;
}

// Get the owner of a file.  Used by log_error() in master.c.
string
file_owner(string file)
{
    string name, rest, dir;

    if (file[0] != '/') file = "/" + file;
    if (sscanf(file, "/u/%s/%s/%s", dir, name, rest) == 3) {
        return name;
    }
    return 0;
}

/*  creator_file()
 *
 *  硂ㄧ计琌 ES2 ╰参み–讽ン砆 load ╰参穦
 *  盢硂ン郎肚倒 simul_efun い creator_file() ㄧ计ノ
 *  硂ㄧ计肚ン uid ES2 ╰参いン
 *  uid ボ硂ン程蔼舦( ン竒パ seteuid ㄓ矗蔼┪︑
 *  舦 )硂程蔼舦琌虫パン郎∕﹚弧ES2
 *  ╰参琌膀郎弄糶舦恨
 *
 *  ES2 ヘ玡癸 uid 祇よΑ叫把σ祘Α絏い爹秆
 */
string
creator_file(string file)
{
    string *path, euid;

    path = explode(file, "/") - ({ "" });
    if( ! sizeof(path) )
	return 0;	/* 硂薄猵莱赣ぃ穦祇ネ琌箇ň窾 */

    switch(path[0])
    {
	// ----------------------------------------------------------
	//  /adm ㎝ /cmds ン局Τ程蔼舦 ROOT_UID暗ヴ
	// ︙ㄆ
	// ----------------------------------------------------------
	case "adm":
	case "cmds":	return ROOT_UID;

	// -----------------------------------------------------------
	// 秨跋办舦 DOMAIN_UIDэ跑ㄏノ妮┦ぃ糶
	// 郎
	// -----------------------------------------------------------
	case "d":	return DOMAIN_UID;

	// -----------------------------------------------------------
	//  /u の /open ン狦琌パㄏノ更玥莉眔ㄏノ
	// 舦狦ぃ琌パㄏノ更玥莉眔㎝更ウン舦
	// 
	// -----------------------------------------------------------
	case "u":
	case "open":
	    if( this_player(1) ) euid = getuid(this_player(1));
	    if( !euid ) euid = geteuid(previous_object(1));
	    if( euid && euid != ROOT_UID ) return euid;
            return "NONAME";

	// ------------------------------------------------------------
	//  /obj ンㄤ程蔼舦パ更赣ン舦(euid)∕﹚传
	// 杠弧パㄣΤ ROOT_UID 舦ン更 /obj ン碞ㄣΤ ROOT
	// 舦パㄏノ更ン碞ㄣΤㄏノ舦ㄣΤ ROOT 舦
	// ン狦璶更 /obj ン硄盽穦 seteuid Θ続讽舦
	// 秈︽更
	// ------------------------------------------------------------
	case "obj":
	    if( previous_object(1) ) return geteuid(previous_object(1));
	    return "NONAME";

	// ------------------------------------------------------------
	// ㄤヘ魁ン常倒ぉ MUDLIB_UID 舦
	// ------------------------------------------------------------
	case "daemon":
	default:
	    return MUDLIB_UID;
    }
}

void
destruct(object ob)
{
    string err;

    if( !ob ) return;

    err = catch(ob->remove());

    if( err )
	log_file("destruct", sprintf("[%s] %O: %s", ctime(time()), ob, err));

    if( userp(ob)
    &&	(geteuid(previous_object())!=ROOT_UID)
    &&	(geteuid(previous_object())!=geteuid(ob)) ) {
	log_file("destruct", sprintf("[%s] %O: Destructed by %s denied\n",
	    ctime(time()), ob, err));
	error("Destruction denied.\n");
    }

    efun::destruct(ob);
}
