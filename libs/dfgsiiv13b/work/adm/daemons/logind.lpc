private void
create() 
{
    seteuid(getuid());
    set("channel_id", "硈絬弘艶");
}

private void
reset()
{
    object room, ob;

#if 0
    /* 睲 void 柑耞絬產 */
    room = find_object(VOID_OB);
    seteuid(getuid());
    if( objectp(room) )
	foreach(ob in all_inventory(room)) {
#ifdef	SAVE_USER
	    if( userp(ob) ) ob->save();
#endif
	    destruct(ob);
	}
#endif

    /* 癘魁絬ㄏノ计 */
    log_file("USRGRAPH", sprintf("[%s] %d users\n",
	ctime(time()), sizeof(users())));

#ifdef ENABLE_ANTISPAM
    spammer_player = ([]);
    spammer_ip = ([]);
#endif
}

void
logon(object ob)
{
    object *usr;
    int i, wiz_cnt, ppl_cnt, login_cnt;

#ifdef ENABLE_ANTISPAM
    if( spammer_ip[query_ip_number(ob)] >= 10 ) {
        write("眖眤硈絬诀承硑び眤诀盢砆┶荡┕ㄓ琿丁\n");
        destruct(ob);
        return;
    }
#endif

    seteuid(getuid());
    efun::write(read_file(WELCOME) + "");
    UPTIME_CMD->main();
    VISITOR_CMD->main();

    usr = users();
    wiz_cnt = 0;
    ppl_cnt = 0;
    login_cnt = 0;
    // invis wizard count in ppl in stead of wiz, by grain (03/25/1998)
    for(i=0; i<sizeof(usr); i++) {
        if( !environment(usr[i]) ) login_cnt++;
        else if( wizardp(usr[i]) ) {
            if( !usr[i]->link()->query("invis") ) wiz_cnt++;
        }
        else ppl_cnt++;
    }
    printf("ヘ玡Τ %d ︗畍%d ︗產絬の %d ︗ㄏノ沽刚硈絬い\n\n",
        wiz_cnt, ppl_cnt, login_cnt );

    write("眤ㄏノ腹");
    input_to( "get_id", ob );
}

private void
get_id(string arg, object ob)
{
    object ppl;

    arg = lower_case(arg);
    if( !check_legal_id(arg)) {
	write("眤ㄏノ腹");
	input_to("get_id", ob);
	return;
    }

    /* 砞﹚硈絬ン舦单 */
    seteuid(arg);
    export_uid(ob);
    seteuid(getuid());
    ob->set("id", arg);

#ifdef MAX_USERS
    if( wizhood(arg)=="(player)" && sizeof(users()) >= MAX_USERS )
    {
	ppl = find_body(arg);
	// Only allow reconnect an interactive player when MAX_USERS exceeded.
	if( !ppl || !interactive(ppl) ) {
	    write("癸ぃ癬" + MUD_NAME + "ㄏノ竒び叫穦ㄓ\n");
	    destruct(ob);
	    return;
	}
    }
#endif

#ifdef ENABLE_BAN_SITE
    // Rework by Annihilator (11/10/1999), support IP address and hostname
    if( wizhood(arg)=="(player)" )
    {
	string ip, pattern;

	ip = query_ip_number(ob);
	foreach(pattern in banned_ip)
	    if( ip==pattern || sscanf(ip, pattern) ) {
		write("癸ぃ癬眤硈絬︗竚ヘ玡ぃ钡ㄏノ祅\n");
		destruct(ob);
		return;
	    }
	ip = query_ip_name(ob);
	foreach(pattern in banned_hostname)
	    if( ip==pattern || sscanf(ip, pattern) ) {
		write("癸ぃ癬眤硈絬︗竚ヘ玡ぃ钡ㄏノ祅\n");
		destruct(ob);
		return;
	    }
    }
#endif	/* ENABLE_BAN_SITE */

#ifdef WIZ_LOCK_LEVEL
    if( (int)wiz_level(arg) < (int)wiz_lock_level ) {
        write("癸ぃ癬" + MUD_NAME + "ヘ玡畍单 " + WIZ_LOCK_LEVEL
            + " 硈絬\n");
        destruct(ob);
        return;
    }
#endif

    if( arg=="guest" ) {
        // If guest, let them create the character.
        get_email( "guest@" + query_ip_name(ob), ob);
        return;
    }

    if( file_size(login_data(arg)) != -1 ) {
        if( ob->restore() ) {
            write("叫块盞絏");
            input_to("get_passwd", 1, ob);
            return;
        }
        write("癸ぃ癬眤纗咀ㄇ拜肈叫ノ guest 硄畍矪瞶\n");
        destruct(ob);
        return;
    }

    write("ㄏノ " + (string)ob->query("id") + " 硂盢穦承硑穝眤絋﹚盾(y/n)");
    input_to("confirm_id", ob);
}

private void
get_passwd(string pass, object ob)
{
    string my_pass;
    object user;

    write("\n");

    if( !check_ip(ob) ) {
	write("癸ぃ癬眤硈絬︗竚ぃタ絋\n");
	destruct(ob);
	return;
    }

    my_pass = ob->query("password");
    if( crypt(pass, my_pass) != my_pass ) {
        write("盞絏岿粇\n");
        destruct(ob);
        return;
    }

    user = find_body(ob->query("id"));
    if (user) {
	/* 耞絬ㄏノ穝硈絬 */
        if( !user->link() ) {
            reconnect(ob, user);
            return;
        }
        write("眤璶盢硈絬い话τぇ盾(y/n)");
        input_to("confirm_relogin", ob, user);
        return;
    }

    user = make_body(ob);
    if( ! user ) {
	/* 狦⊿Τ快猭籹硑ㄏノン钡ち耞硈絬 */
	destruct(ob);
	return;
    }

    if( user->restore() )
    {
	log_file( "USAGE", sprintf("[%s] %s login from %s\n",
	    ctime(time()), (string)user->query("id"), query_ip_name(ob) ) );

	if( wizhood(ob)=="(admin)") {
	    if( (query_ip_name(ob) != "localhost")
	    &&	(query_ip_number(ob) != "127.0.0.1") ) {
		write("浪琩ア毖....︑笆祅\n");
		destruct(user);
		destruct(ob);
		return;
	    }
	    write("浪琩硄筁\n");
	}
	enter_world(ob, user);
	return;
    } else {
	if( file_size(user->query_save_file())==-1 ) {
	    write(@NOTICE
╰参тぃ眤戈珹眤承硑┪щ璍锣
耞絬┪笻は砏﹚眤戈砆埃狦眤絋﹚硂⊿Τ
瓃硂ㄇ薄猵叫ノ guest 眀腹絬畍琩高

NOTICE
	    );
	    destruct(user);
	    write(HIY "眤璶穝承硑硂盾(y/n) " NOR);
	    input_to("confirm_reincarnate", ob);
	} else {
	    write(@NOTICE
╰参ヘ玡礚猭弄眤戈珹╰参タ称だ┪俱瞶ㄏノ
戈叫祔刚
NOTICE
	    );
	    destruct(user);
	    destruct(ob);
	}
    }
}

private void
confirm_reincarnate(string yn, object ob)
{
    if( yn=="" ) {
        write(HIY "眤璶穝承硑硂盾(y/n) " NOR);
        input_to("confirm_reincarnate", ob);
        return;
    }

    if( yn[0]!='y' && yn[0]!='Y' ) {
        write("舧Ωㄓ\n");
        destruct(ob);
        return;
    }

    if( !list_user_race(ob) ) {
	/*  穨ぃì礚猭щ璍锣猵 */
#ifdef	SAVE_USER
	rm(ob->query_save_file());
#endif
        destruct(ob);
        return;
    }

    input_to("get_race", ob);
}

private void
confirm_relogin(string yn, object ob, object user)
{
    object old_link;

    if( yn=="" ) {
        write("眤璶盢硈絬い话τぇ盾(y/n)");
        input_to("confirm_relogin", ob, user);
        return;
    }       

    if( yn[0]!='y' && yn[0]!='Y' ) {
        write("舧Ωㄓ\n");
        destruct(ob);
        return;
    } else {
        tell_object(user, "Τ眖矪( " + query_ip_number(ob)
            + " )硈絬眤┮北\n");
        log_file( "USAGE", sprintf("[%s] %12s replaced @ %s\n",
            ctime(time()),
            (string)user->query("id"),
            query_ip_name(ob),  ) );
    }

    // Kick out tho old player.
    old_link = user->link();
    if( old_link ) {
	seteuid(getuid());
	if( interactive(user) ) exec(old_link, user);
        destruct(old_link);
    }

    reconnect(ob, user);    
}

private void
confirm_id(string yn, object ob)
{
    if( yn=="" ) {
        write("ㄏノ硂盢穦承硑穝眤絋﹚盾(y/n)");
        input_to("confirm_id", ob);
        return;
    }       

    if( yn[0]!='y' && yn[0]!='Y' ) {
        write("ê或叫穝块眤璣ゅ");
        input_to("get_id", ob);
        return;
    }

#ifdef ENABLE_ANTISPAM
    if( spammer_player[ob->query("id")] ) spammer_player[ob->query("id")]++;
    else spammer_player[ob->query("id")] = 1;
    if( spammer_ip[query_ip_number(ob)] ) spammer_ip[query_ip_number(ob)]++;
    else spammer_ip[query_ip_number(ob)] = 1;
#endif
    write("叫砞﹚眤盞絏");
    input_to("new_password", 1, ob);
}

private void
new_password(string pass, object ob)
{
    write("\n");
    if( strlen(pass)<5 ) {
        write("盞絏︓ぶ璶きじ叫砞眤盞絏");
        input_to("new_password", 1, ob);
        return;
    }
#ifdef	ENABLE_MD5_PASSWORD
    ob->set("password", crypt(pass, sprintf("$1$%d", random(99999999))));
#else
    ob->set("password", crypt(pass, 0) );
#endif
    write("叫块Ω眤盞絏絋粄眤⊿癘岿");
    input_to("confirm_password", 1, ob);
}

private void
confirm_password(string pass, object ob)
{
    string old_pass;

    write("\n");
    old_pass = ob->query("password");
    if( crypt(pass, old_pass)!=old_pass ) {
        write("眤ㄢΩ块盞絏ぃ妓叫穝砞﹚Ω盞絏");
        input_to("new_password", 1, ob);
        return;
    }

    write(@TEXT
磷眤綝祍ノES2 盢蹦ノ email 粄靡よΑ玂臔
┮Τ舦┮叫眤块ㄑ钡Μ粄靡ノ筿秎ン 硂
筿秎ン埃畍ぃ穦砆ㄤㄏノ
TEXT
    );
    write("眤筿秎ン");
    input_to("get_email",  ob);
}

private void
get_email(string email, object ob)
{
    int c, delim=0, err=0;

    if( strlen(email) > 64 ) {
	write("筿秎ン程Τ 64 じ\n");
	write("眤筿秎ン");
	input_to("get_email",  ob);
	return;
    }

    foreach(c in email) {
	if( c=='@' && !delim ) { delim = 1; continue; }
	if( strsrch("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.", c) < 0 )
	    { err = 1; break; }
    }
    if( !delim || err ) {
	write("眤筿秎ンΑ岿粇叫块タ絋筿秎ン\n");
	write("眤筿秎ン");
	input_to("get_email",  ob);
	return;
    }

    ob->set("email", email);

//  If ONE_GUEST is defined in /include/login.h, only permit one guest login.
#ifdef ONE_GUEST
    if ((string)ob->query("id") == "guest") {
        write("╆簆, 絬竒Τ Guest .\n");
        destruct(ob);
        return;            }
#endif /* ONE_GUEST */

    // Complete non-body-specific initialization of new user here.
    ob->set("karma", 20);
    list_user_race(ob);
    input_to("get_race", ob);
}

private void
get_race(string race, object ob)
{
    int kar;
    string choice;
    if( sscanf(race, "? %s", race) ) {
        write( read_file(HELP_DIR + "help/" + race) );
        // add by ueiren ... 
        // list_user_race(ob);
        input_to("get_race", ob);
        return;
    }
    if( member_array(race, user_race)==-1 ) {
        write("⊿Τ硂贺贺壁叫眤穝匡拒");
        input_to("get_race", ob);
        return;
    }

    kar = (int)RACE_D(race)->query("karma");
    if( wizhood(ob)=="(player)" && (int)ob->query("karma") < kar ) {
        write("眤穨ぃ镑叫眤穝匡拒");
        input_to("get_race", ob);
        return;
    }
    ob->add("karma", -kar);

    write("眤璶ш簍╧┦(m)à︹┪┦(f)à︹");
    input_to("get_gender", ob, race);
}

private void
get_gender(string gender, object ob, string race)
{
    object body;
    string body_file;

    if( gender=="" ) {
        write("眤璶ш簍╧┦(m)à︹┪┦(f)à︹");
        // fix 匡┦岿粇硑Θ race  human bug  .... by ueiren
        // input_to("get_gender", ob, body);
        input_to("get_gender", ob, race);           
        return;
    }

    if( gender[0]=='m' || gender[0]=='M' )      gender = "male";
    else if( gender[0]=='f' || gender[0]=='F' )     gender = "female";
    else {
        write("癸ぃ癬眤匡拒╧┦(m)┪┦(f)à︹");
        // fix 匡┦岿粇硑Θ race  human bug  .... by ueiren 
        // input_to("get_gender", ob, body);
        input_to("get_gender", ob, race);
        return;
    }

    if( !stringp(body_file = RACE_D(race)->query("default_body")) )
        body_file = USER_OB;
        ob->set("body", body_file);
        if( !(body = make_body(ob)) ) {
            destruct(ob);
            return;
        }

        body->set("gender", gender);
        body->set_race(race);
        init_new_body(ob, body);
        // Remember it so we can dest it if we go linkdead before finishing
        // chraracter creation.
        ob->set_temp("temp_body", body);

        write("眤いゅ");
        input_to("get_name", ob, body);
}

private void
get_name(string arg, object ob, object user)
{
    if( !check_legal_name(arg) ) {
        write("眤いゅ");
        input_to("get_name", ob, user);
        return;
    }

    ob->set("name", arg);
    user->set("name", arg);
    if( !ob->query("creation_time") ) {
        log_file( "USAGE", sprintf("[%s] %12s created  @ %s\n",
            ctime(time()),
            user->query("id"),
            query_ip_name(ob), ) );
            ob->set("creation_time", time());
            // default open chat and rumor channel -- by dragoon
            ob->set("channels", ({"chat","rumor"}));
    }
    enter_world(ob, user);
}

object
make_body(object link_ob)
{
    string err;
    object user;
    int n;

    seteuid(getuid());
    err = catch(user = new(USER_OB));
    if(err || !user) {
        write("瞷Τ畍タэㄏノン祘Α叫祔刚\n");
        return 0;
    }

    /* 砞﹚ㄏノ舦 */
    seteuid(getuid(link_ob));
    export_uid(user);
    seteuid(getuid());

    user->set("id", link_ob->query("id"));
    user->set_name( link_ob->query("name"), link_ob->query("id") );

    return user;
}

private int
check_ip(object link)
{                                                                               
    string okip, cur_ip, cur_ip_num, ip_part, num_part, be_checked;
    int len, ed;

    okip = link->query("okip");
    if( !arrayp(okip) || !sizeof(okip) ) return 1;

    cur_ip = query_ip_name(link);
    cur_ip_num = query_ip_number(link);
    foreach(string ip in explode(okip, ":") - ({ "" }))
    {
	if (sscanf(ip, "%s*", be_checked) && be_checked!="")
	{
	    len = strlen(be_checked);
	    ip_part = cur_ip[0..len-1];
	    num_part = cur_ip_num[0..len-1];
	}
	else if (sscanf(ip, "*%s", be_checked) && be_checked!="")       
	{
	    len = strlen(be_checked);
	    ed = strlen(cur_ip);
	    ip_part = cur_ip[ed-len..<1];
	    num_part = cur_ip_num[ed-len..<1];
	}
	else
	{
	    be_checked = ip;
	    ip_part = cur_ip;
	    num_part = cur_ip_num;
	}
       
	if (lower_case(be_checked) == lower_case(ip_part)
	|| lower_case(be_checked) == lower_case(num_part))
	{
	    write(HIW "浪琩硄筁\n" NOR);
	    return 1;
	}
    }

    return 0;
}

private void
init_new_body(object link, object user)
{
#ifdef ENABLE_ANTISPAM
    int penalty;
    string a;
#endif

    user->set("birthday", time() );
    user->set_class("commoner");
    user->set_level(1);

#ifdef ENABLE_ANTISPAM
    penalty = spammer_player[user->query("id")] - 1;
    if( penalty < spammer_ip[query_ip_number(link)] )
        penalty = spammer_ip[query_ip_number(link)];
        while(penalty-- > 0) {
            a = penalty_attr[random(sizeof(penalty_attr))];
            if( user->query_attr(a) > 1 )
                user->set_attr(a, user->query_attr(a)-1);
        }
#endif

    CHAR_D->setup_char(user);
}

varargs void
enter_world(object ob, object user, int silent)
{
    object room;
    string startroom, err;

    /* 盢ㄏノ眖硈絬ン exec ㄏノン */
    user->set_link(ob);
    ob->set_body(user);
    exec(user, ob);

    if( !silent ) write("ヘ玡舦" + wizhood(user) + "\n");
    user->setup();
    increment_visitor_count();

#ifdef SAVE_USER
    /* 硂柑纗琵穝承硑砆ㄓ */
    user->save();
#endif

    if( silent ) return;

    cat(MOTD);
    IDENT_D->query_userid((string)user->query("id"));

    /* よ猭更ㄏノ祅┬丁 */
    startroom = user->query("startroom");
    if( !startroom ) startroom = START_ROOM;
    err = catch(room = load_object(startroom));
    if( !room ) err = catch(room = load_object(VOID_OB));

    if( !room || !user->move(room) ) {
	write(@NOTICE
癸ぃ癬ヘ玡╰参タ俱ㄇ祅翴祘Α叫祔刚
NOTICE
	);
	destruct(ob);
	destruct(user);
	return;
    }

    /* 浪琩ㄏノ琌Τゼ弄獺ン */
    if( ob->query("new_mail") ) {
	write( HIW "\nΤ眤獺叫沛ㄓ诫 ...\n\n" NOR);
	ob->delete("new_mail");
    }
 
    // if detect mark: pker, set the time mark -dragoon
    if( user->query("pker") ) {
	user->set("last_pk_time", time());
	user->delete("pker");
    }

    /* ㄏノ祅 */
    if( !wizardp(user) && !user->query("invis") ) {
	message("vision", user->query("name") + "硈絬秈硂\n",
		room, user);
	CHANNEL_D->do_channel( this_object(), "sys",
		sprintf("%s(%s)パ%s硈絬秈",
		user->name(1),
		user->query("id"),
		query_ip_name(user))
	);
    }
}

varargs void
reconnect(object ob, object user, int silent)
{
    /* 盢ㄏノ眖硈絬ン exec ㄏノン */
    user->set_link(ob);
    ob->set_body(user);
    exec(user, ob);

    user->reconnect();
    IDENT_D->query_userid((string)user->query("id"));   

    if( silent ) return;

    // if detect pking, reset time mark to now -dragoon
    if( time() - (int)user->query("last_pk_time") < 60 * 60 )
	user->set("last_pk_time", time());

    /* ㄏノ穝硈絬 */
    if( !wizardp(user) && !user->query("invis") ) {
	message("vision", user->query("name") + "穝硈絬硂\n",
		environment(user), user);
	CHANNEL_D->do_channel( this_object(), "sys",
		sprintf("%s(%s)パ%s穝硈絬秈",
		user->name(1),
		user->query("id"),
		query_ip_name(user))
	);
    }
}

void
net_dead(object ob)
{
    CHANNEL_D->do_channel( this_object(), "sys",
        sprintf("%s(%s)耞絬", ob->name(1), ob->query("id")));
    ob->move("/obj/void");
}

int
check_legal_id(string id)
{
    int i;

    i = strlen(id);
    if( (strlen(id) < 3) || (strlen(id) > 12 ) ) {
        write("癸ぃ癬眤璣ゅゲ斗琌 3  12 璣ゅダ\n");
        return 0;
    }
    while(i--)
        if( id[i]<'a' || id[i]>'z' ) {
            write("癸ぃ癬眤璣ゅノ璣ゅダ\n");
            return 0;
        }

    return 1;
}

int
check_legal_name(string name)
{
    int i;
    string bname;

    i = strlen(name);

    if( (strlen(name) < 2) || (strlen(name) > 12 ) ) {
        write("癸ぃ癬眤いゅゲ斗琌 1  6 いゅ\n");
        return 0;
    }
    while(i--) {
        if( name[i]<=' ' ) {
            write("癸ぃ癬眤いゅぃノ北じ\n");
            return 0;
        }
        if( i%2==0 && !is_chinese(name[i..<0]) ) {
            write("癸ぃ癬叫眤ノいゅ\n");
            return 0;
        }
        if( name[i..i+1]=="" ) {
            write("癸ぃ癬叫ぃ璶ノフじ\n");
            return 0;
        }
    }
    if( member_array(name, banned_name)!=-1 ) {
        write("癸ぃ癬硂贺穦硑Θㄤ耑\n");
        return 0;
    }
    foreach(bname in banned_rude_name)
        if( strsrch( name, bname )>-1 ) {
            write("癸ぃ癬, 硂贺穦ま癬ぃゲ璶粇穦\n");
            return 0;
        }
    return 1;
}

object
find_body(string name)
{
    object ob, *body;

    if( objectp(ob = find_player(name)) ) return ob;
    foreach(ob in children(USER_OB))
        if( clonep(ob)
        &&  userp(ob)
        &&  ob->is_character()
        &&  getuid(ob) == name )
            return ob;

    return 0;
}

int
set_wizlock(int level)
{
    if( wiz_level(this_player(1)) <= level ) return 0;
    if( geteuid(previous_object()) != ROOT_UID ) return 0;

    wiz_lock_level = level;
    return 1;
}

nosave int
list_user_race(object link)
{
    string msg, race;
    int karma;

    karma = link->query("karma");
    msg = "";
    foreach(race in user_race) {
	if( RACE_D(race)->query("karma") > karma ) continue;
	msg += sprintf("%-25s %d 翴穨\n",
		to_chinese(race) + "(" + race + ")",
		RACE_D(race)->query("karma") );
    }

    if( msg=="" ) {
	write("┮逞穨竒⊿Τ快猭щ璍锣\n");
	return 0;
    }

    msg = "眤瞷Τ " + karma + " 翴穨匡拒贺壁\n" + msg;
    msg += "眤匡拒(ノ '? <贺壁>' 琩綷\弧)";

    write(msg);
    return 1;
}

/*  reincarnate()
 *
 *  硂ㄧ计琌ノㄓ琵 player щ璍锣ノ玥Τ CHAR_D 惠璶
 *  ノ硂ノ硂ㄧ计ンゲ斗ㄣΤ ROOT 舦
 */

void
reincarnate(object ob)
{
    object link;
    int max_karma_gain, karma_gain;

    if( previous_object() && geteuid(previous_object()) != ROOT_UID )
	return;

    seteuid(getuid());

    /* 狦秈︽锣耞絬单Ω硈絬锣 */
    link = ob->link();
    if( ! link ) {
#ifdef	SAVE_USER
        ob->save();
#endif
        destruct(ob);
        return;
    }

    /* –Ω莉眔穨 MIN(絬ぱ计*2, 锣单) */
    max_karma_gain = link->query("time_aged") / 43200;
    karma_gain = ob->query_level();
    if( karma_gain > max_karma_gain ) karma_gain = max_karma_gain;
    link->add("karma", karma_gain);
#ifdef	SAVE_USER
    link->save();
#endif

    /* 盢ㄏノ exec 硈絬ン埃戈郎 */
    exec(link, ob);
#ifdef	SAVE_USER
    rm(ob->query_save_file());
#endif
    destruct(ob);

    /* 狦┮逞穨竒ぃ镑锣Θヴ︙贺壁 GAME OVER */
    if( !list_user_race(link) ) {
        write("叫眤穝承硑穝ㄓ\n");
#ifdef	SAVE_USER
        rm(link->query_save_file());
#endif
        destruct(link);
        return;
    }

    input_to("get_race", link);
}

#define VISITOR_COUNTER_FILE	"/adm/etc/visitor.cnt"

private void
increment_visitor_count()
{
    int t, cnt;
    string s = read_file(VISITOR_COUNTER_FILE);

    if( !s ) 
        s = sprintf("%d 1", time());
    else {
        sscanf(s, "%d %d", t, cnt);
        if( ! t ) { t = time(); cnt = 0; }
        s = sprintf("%d %d", t, cnt+1);
    }
    write_file(VISITOR_COUNTER_FILE, s, 1);
}
