// sockets package unavailable under WASM -- no-op here.
void write_data(int fd) {
  return;
}

// sockets package unavailable under WASM -- no-op here.
void receive_data(int fd, string str) {
  return;
}

mapping query_requests() { return requests; }

// sockets package unavailable under WASM -- just clear the map.
void timeout(int fd) {
  map_delete(requests, fd);
}
