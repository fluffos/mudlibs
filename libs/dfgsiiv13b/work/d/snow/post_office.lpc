inherit ROOM;

void create()
{
    set("short", "撤獸沛");
    set("long", @LONG
硂柑琌撤獸马沛瘤礛沛璶琌蠢﹛┎患癳ゅぃ筁パㄓ
眏祍⊿繵羉ぃぶκ﹎穦ㄇ窥叫沛﹛腊Γ癳獺Μ獺踌潮
郡郡粄耑チ琌﹛┎琁現ア沛璝琌临Μκ﹎窥龟琌
ぇΤ穃┦郡ず沛癸κ﹎秎患〆癠ぃ眔Μ禣

狦稱璶Μ祇獺ノ request 沛﹛烩Μ祇獺獺ゾ
LONG
    );
    set("exits", ([ /* sizeof() == 1 */
        "east" : __DIR__"nstreet2",
    ]));
    set("post_office", 1);    // mailbox checks this flag.
    set("no_fight", 1);

    setup();
}

void init()
{
    add_action("do_request", "request");
}

int do_request(string arg)
{
    object mbox;

    if( objectp(mbox = this_player()->query_temp("mbox_ob"))
    &&	base_name(mbox)==MAILBOX_OB
    &&	environment(mbox)==this_player() )
        return notify_fail("竒烩Τ獺ゾ\n");

    mbox = new(MAILBOX_OB);
    mbox->move(this_player());

    write("沛﹛盢糶帝獺ゾ患倒\n");
    return 1;
}

int
valid_leave(object ob)
{
    object mbox;

    if( objectp(mbox=ob->query_temp("mbox_ob")) ) {
	mbox->retire();
	write("盢獺ゾユ倒沛﹛玂恨\n");
	ob->delete_temp("mbox_ob");
    }

    return 1;
}
