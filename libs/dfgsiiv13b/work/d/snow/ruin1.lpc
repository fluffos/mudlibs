// Room: /d/snow/ruin1.c

#include <localtime.h>

inherit ROOM;

int flag = 0;

void create()
{
	set("short", "瘆侣");
	set("long", @LONG
硂柑琌丁瘆侣玡皘芔竒盰厄礘堵假琖咀
︘隔畑皘柑馒翺ネㄓ竒⊿Τ︘沮弧硂柑
边Τ碍活瞷琌眖⊿钮弧筁Τ砆甡﹡チご礛
酚盽ネ┕﹁竒パタ刁
LONG
	);
	set("detail", ([ /* sizeof() == 2 */
		"馒" : "硂柑馒竒ììΤの竬┛礛祇瞷玭娩翺Τぐ
或狥﹁祇妮皗ぃ筁Τ琌岿谋
",
		"假琖" : "眖假琖礘堵勃格ㄓ硂畒阀琌╝闽玒
瞒秨
",
]));
	set("outdoors", "snow");
	set("exits", ([ /* sizeof() == 2 */
		"west" : __DIR__"lane1",
		"east" : __DIR__"egate",
]));

	setup();
}

void init()
{
	add_action("do_climb", "climb");
	add_action("do_search", "search");
}

int do_climb(string arg)
{
	if( arg != "假琖" ) return 0;

	message_vision("$Nみ羖羖筁厄假琖秈芔\n", this_player());
	this_player()->move(__DIR__"ruin2");
	message("vision", this_player()->name() + "眖厄假琖繷筁ㄓ\n",
		environment(this_player()), this_player());
	return 1;
}

int do_search(string arg)
{
	mixed t;
	object ob;

	if( arg != "馒" ) return 0;

	t = NATURE_D->game_time(1);
	// Can only be found during 11:00 to 14:00
	if( flag || (t[LT_HOUR] < 10) || (t[LT_HOUR] > 13) ) {
		message_vision("$N馒翺柑тㄓт琌ぐ或⊿Τт\n", this_player());
		return 1;
	}
	flag = 1;
	ob = new(__DIR__"npc/obj/hairpin");
	ob->move(this_player());
	message_vision("$N翺柑тㄓт挡狦祇瞷や緑炉\n", this_player());
	return 1;
}

void reset()
{
	flag = 0;
	::reset();
}
