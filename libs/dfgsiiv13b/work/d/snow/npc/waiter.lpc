// waiter.c

#include <npc.h>

inherit F_VILLAGER;
inherit F_VENDOR;

int on_service = 0;

void create()
{
	set_name("┍", ({ "waiter", "snow_inn_waiter" }) );
	set_race("human");
	set_class("commoner");
	set_level(2);

	set("age", 21);
	set("long",
		"繷淮官璸タΓ秈Γ┷㊣ノ\n"
		"list 翴ぐ或垫ノ buy 蛤┍翴垫\n");
	set("chat_chance", 1);
	set("chat_msg", ({
		"┍盯帝礚册癬Ρㄠㄓ\n",
		"┍贝繷辨辨ぱ︹弧笵硂碭ぱぱぃ岿痷稱ǐǐ\n",
		"┍弧笵ê弧ネぃ笵翴⊿ぶ弧硂柑龟磂\n",
		"┍弧笵さぱ或Τ程Τ穝翧ㄆ弧ㄓ钮钮盾\n",
	}));
	set("merchandise", ([
		"/obj/food/dumpling": 50,
		"/obj/food/manto": 50,
		"/obj/food/pork": 30,
		__DIR__"obj/roast_chicken": 30,
	]));

	setup();
}

void init()
{
	::init();
	add_action("do_vendor_list", "list");
}


int accept_fight(object ob)
{
	do_chat("┍ш碍羪弧笵璶ゴ琜杠иぃ琌癸も\n");
	return 0;
}

mixed affirm_merchandise(object customer, string item_name)
{
	if( on_service )
		return notify_fail("┍タΓ帝┷㊣ㄤ叫单穦ㄠ\n");
	return ::affirm_merchandise(customer, item_name);
}

private void handover(object customer, mixed item)
{
	on_service = 0;
	if( !customer || environment(customer)!=environment() ) {
		command("say 玿ê︗㎡或窥ぃǎ ...");
		say("┍р狠ㄓ" + item->name() + "狠\n");
		return;
	}
	command("say 眤" + item->name() + "ㄓ罢");
	message_vision("$Nр眖紁┬狠ㄓ" + item->name()
		+ "癳$n玡\n", this_object(), customer);
	::deliver_merchandise(customer, item);
}

void deliver_merchandise(object customer, mixed item)
{
	command("say " + item->name() + "琌皑ㄓ");
	say("┍癸帝紁┬驰笵" + item->name() + "\n");
	on_service = 1;
	do_chat((: handover, customer, item :));
}
