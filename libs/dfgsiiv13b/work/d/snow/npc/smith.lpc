// smith.c

#include <npc.h>

inherit F_VILLAGER;
inherit F_VENDOR;

void create()
{
        set_name("臟", ({ "smith" }) );
        set_race("human");
        set_level(13);
        set_stat_maximum("kee", 80);
        set_attr("str", 19);
        set_attr("cor", 17);
        set_attr("cps", 15);
        set_attr("dex", 18);

        set("long",
                "ō彩Ё臟タΓ窵帝\n"
                "狦稱禦ㄇ臟竟ノ list Τㄇ狥﹁ノ buy 臟潦禦\n");

        set("merchandise", ([
                __DIR__"obj/hoe": 3,
                __DIR__"obj/shovel": 5,
                "/obj/area/obj/dagger": 10,
                "/obj/area/obj/shortsword": 5,
        ]));

        set("chat_chance", 5);
        set("chat_msg", ({
                "臟盢遏縉臟遏夺羘絚い\n",
                "臟ノもい臟埋臟痾ノ篤ゴ\n",
                "臟弧笵秨翴み縎帝\n",
                "臟弧笵 ... 痷ри倒Γ胊\n",
        }));
        setup();
        carry_object(__DIR__"obj/smock")->wear();
}

int accept_fight()
{
        do_chat("臟傈傈泊弧笵ǐ秨иタΓ帝\n");
        return 0;
}

void init()
{
        ::init();
        add_action("do_vendor_list", "list");
}
int accept_object(object who, object ob)
{
        object thing;
        if ( !ob->id("lo iron") ) return 0;
        call_out((:command("say 翅璶籹Θ絙盾, ê虏虫, 皑碞暗.\n"):),1);
        thing=new(__DIR__"obj/arrow");
        thing->move(who);
call_out((:message_vision("臟р暗絙ユ倒$N\n",this_player(),) :),2);
        return 1;
}



