// innkeeper.c

#include <localtime.h>
#include <npc.h>

inherit F_VILLAGER;

void open_inn();
void close_inn();

int on_business = 0;

void create()
{
	mapping gt;

	set_name("磝耫", ({ "innkeeper", "keeper" }) );
	set_race("human");
	set_level(4);

	set("age", 52);
	set("long", "硂︗獽琌硂產刺磝耫癬ㄓ褐褐钩琌ρ\n");
	set("schedule", ([
		700: (: open_inn :),
		2200: (: close_inn :),
	]));
	setup();
	carry_money("coin", 160);

	gt = NATURE_D->game_time(1);
	if( gt[LT_HOUR] < 7 || gt[LT_HOUR] > 22 ) on_business = 0;
	else on_business = 1;
}

void init()
{
	::init();
	if( !is_fighting() )
		do_chat( (: command, "say 舧舧叫柑Г" :) );
}

void relay_emote(object from_ob, string verb)
{
	command("smile");
}

int accept_fight(object player)
{
	do_chat((: command, "say 硂︗" + player->rank("respectful")
	 + "痷稲秨ρㄠ临璶暗ネ種㎡\n":));
	return 0;
}

void accept_kill(object player)
{
	object ob;

	// 竒ゴ琜Τ kill 磝耫ぃ暗ヴ︙ㄆ
	if( is_fighting() ) return;

	// 秨﹍ゴ琜驰毕㏑( 硂柑ノ command() 穦驰ㄓ )
	command("emote 炳毕㏑");

	// 瞷初Τ⊿Τ﹛Τ杠 present() 穦肚┬丁い材﹛
	ob = present("garrison");

	// ⊿Τ杠ㄓ
	if( !ob ) {
		ob = new(__DIR__"patrol");
		ob->move(environment());

		// ユ﹛瞷猔種玡磝耫竒ノ command() 驰羘狦
		// ノ do_chat() ㄤ癟璶 heart beat 穦ㄓ
		tell_room(environment(), "ǖ呸﹛钮羘禲筁ㄓ\n");
	}

	// protect() ﹚竡﹛ō琌羘腤腤碭初杠
	ob->protect(this_object());

	// 硂琌琵﹛も眏
	ob->kill_ob(player);
}

void open_inn()
{
	command("emote ゴろ弧笵何痷秨┍暗ネ種");
	environment()->open_door("east");
	environment()->open_door("west");
	environment()->set("no_fight", 1);
}

void close_inn()
{
	object ob;

	command("say 垛.. ゴ疞︗ら叫Ν");
	command("emote 盢癳刺");
	environment()->close_door("east");
	environment()->close_door("west");
	environment()->set("no_fight", 0);
	foreach(ob in all_inventory(environment()) ) {
		if( ob==this_object()
		||	!ob->is_character()
		||	ob->id("snow_inn_waiter") ) continue;
		ob->move(environment()->query("exits/east"));
	}
}
