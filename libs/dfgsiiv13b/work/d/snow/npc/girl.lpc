// girl.c

#include <npc.h>

inherit F_FIGHTER;

object *dest = ({});

void create()
{
    set_name("フ︾", ({ "girl" }) );
    set_attr("con", 23);
    set_attr("str", 23);
    set_attr("spi", 27);
    set_attr("int", 22);
    set_attr("dex", 26);
    set_race("human");
    set_class("fighter");
    set_level(55);

    set_skill("sword", 140);
    set_skill("dodge", 120);
    set_skill("parry", 120);
    set_skill("blade", 70);
    set_skill("dagger", 70);
    set_skill("unarmed", 90);
    set_skill("force", 80);
    set_skill("celestial force", 80);
    map_skill("force", "celestial force");
    set("defensive", 60);

    advance_stat("gin", 160);
    advance_stat("kee", 160);
    advance_stat("sen", 80);

    set("age", 19);
    set("gender", "female");
    set("long",
        "ōフ︾癬ㄓぃ穦禬筁烦甧华瘤ぃ玱\n"
        "Τ艶╭ぇ箕礛ぃ幢淮玍\n" );
    setup();
    carry_object(__DIR__"obj/white_dress")->wear();
    carry_object(__DIR__"obj/slasher_sword")->wield();
}

void relay_emote(object ob, string verb)
{
    do_chat((: command, "shake" :));
}

void attack_intruder(object ob)
{
    if( !ob || member_array(ob, dest)==-1 ) return;
    dest -= ({ ob });
    if( environment(ob) != environment() ) return;
    if( wizardp(ob) ) {
	command("say ㄓ琌" + ob->name() + "続玙デ临叫ǎ教");
	return;
    }
    command("say 痷琌ぃ璶㏑\n");
    kill_ob(ob);
    ob->fight_ob(this_object());
}

void listen_request(object ob)
{
    set("pending_requester", ob);
    command("hmm");
    command("say 稱璶ぐ或弧");
}

int accept_object(object who, object ob)
{
    if( ob->id("bronze hairpin") ) {
        command("say 硂 ... 硂琌и緑炉临倒и");
        dest -= ({ who });
        if( is_fighting(who) ) {
            remove_killer(who);
            who->remove_killer(this_object());
        }
        do_chat( (: listen_request, who :) );
        return 1;
    } else {
        command("say 硂琌ぐ或瘆簧年臟秨");
        return 0;
    }
}

void drop_invitation()
{
    object ob;

    command("say и笵琌ぐ或е簎");
    ob = new(__DIR__"obj/invitation");
    ob->move(this_object());
    command("drop invitation");
    delete("pending_requester");
}

void relay_say(object ob, string msg)
{
    if( ob==this_object() ) return;
    if( ob != query("pending_requester") ) 
        do_chat((: command, "say 硂柑⊿Τ弧杠緇倒и超糒":));
    else {
        if( msg!="璣动┇" ) {
            do_chat((: command, "say 硂贺狥﹁и⊿Τ传贺" :));
            return;
        }
        do_chat((: drop_invitation :));
    }
}

void init()
{
    ::init();
    if( this_player() && (!this_player()->query_temp("hairpin_quest")) ) {
        do_chat((: command, "say 琌街簎簎ぃ礛и炳" :));
        if( member_array(this_player(), dest)==-1 ) {
            dest += ({ this_player() });
            call_out((: attack_intruder, this_player() :), 5);
        }
    }
}
