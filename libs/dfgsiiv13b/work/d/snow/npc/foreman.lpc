// foreman.c

#include <npc.h>

inherit F_VILLAGER;

void new_crate();


void create()
{
	set_name("繷", ({ "foreman" }) );
	set_race("human");
	set_level(8);
	set_stat_maximum("kee", 60);
	set_attr("str", 18);
	set_attr("cor", 19);
	set_attr("cps", 15);
	set_attr("dex", 16);

	set("age", 48);
	set("long",
		"硂︗碞琌硂產砯刺繷璽砫揣盢砯穐秈穐狦\n"
		"稱ゴ寥ㄇ窥蛤酵酵\n");
	set("chat_chance", 10);
	set("chat_msg", ({
		(: new_crate :),
		"繷羘耻帝盢砯眖畐穐ㄓ\n",
		"繷㎡さぱΤ⊿Τㄓ\n",
		"繷弧笵街тㄇもΓ\n",
		"繷弧笵璶衡窥ㄓ ...  ...\n"
	}) );
		
	setup();
	carry_money("coin", 220);
}

int accept_fight()
{
	do_chat("繷弧笵ゑ猌浩盾и⊿ê贺盯\ひ\n");
	return 0;
}

void relay_say(object me, string msg)
{
	if( is_fighting() || is_chatting() ) return;

	if( strsrch(msg, "窥") >= 0 ) {
		int amount;
		object money;

		if( amount = me->query_temp("wage_deserved") ) {
			money = new("/obj/money/coin");
			money->set_amount(amount);
			money->move(this_object());
			command("say  ... 羆琌" + chinese_number(amount) + "ゅ窥倒");
			me->delete_temp("wage_deserved");
			do_chat((: command, "give coin to " + me->query("id"):));
		}
		else do_chat("繷弧笵穐絚きゅ窥穕胊竭\n");
		return;
	}
}

void new_crate()
{
	object ob;
	
	if( !environment()
	||	sizeof(all_inventory(environment())) >= 15 ) return;

	ob = new(__DIR__"obj/crate");
	ob->move(environment());
	say("繷弧笵侈ê娩砯み翴倒篖胊\n");
}
