// hoe.c

#include <weapon.h>

inherit F_PIKE;

void create()
{
	set_name("維繷", ({ "hoe" }) );
	set_weight(6000);
	setup_pike(2, 10, 50, 0);

	if( !clonep() ) {
		set("wield_as", ({ "twohanded pike" }));
		set("unit", "р");
		set("value", 800);
		set("rigidity", 20);
		set("long", "р╨╨維繷\n");
	}
	setup();
}
