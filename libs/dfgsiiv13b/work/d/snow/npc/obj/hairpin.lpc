// hairpin.c

#include <armor.h>

inherit F_HEAD_EQ;

void create()
{
	set_name("簧緑炉", ({ "bronze hairpin", "hairpin" }));
	set_weight(400);
	setup_head_eq();
	if( !clonep() ) {
		set("unit", "や");
		set("value", 100);
		set("long", "やネ骸簧厚ρ侣ぃ臭緑炉\n");
		set("wear_as", "head_eq");
		set("apply_armor/head_eq/spi", 1);
	}
	setup();
}
