// crate.c

inherit ITEM;

void create()
{
	set_name("れ絚", ({ "big crate", "crate"}));
	set_weight(40000);
	if( !clonep() ) {
		set("unit", "");
		set("long", "硂琌ノㄓ杆砯れ絚癬ㄓ讽℉\n");
		set("value", 1);
		set("wage", 25);
	}
	setup();
}

void init()
{
	add_action("do_get", "get");
}

int do_get(string arg)
{
	if( environment() != environment(this_player())
	||	!id(arg) ) return 0;

	if( (int)this_player()->query_stat("kee") < 10 ) {
		write("ぃ镑ヰ弧\n");
		return 1;
	}

	if( move(this_player()) ) {
		message_vision("$N舠竬盢" + name() + "Κ癬ㄓ\n", this_player());
		return 1;
	}
}

