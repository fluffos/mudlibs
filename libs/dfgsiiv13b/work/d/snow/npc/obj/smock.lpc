// smock.c

#include <armor.h>

inherit F_ARMOR;

void create()
{
	set_name("ゴ臟籵", ({ "work smock", "smock" }) );
	set_weight(5500);
	setup_armor();

	if( !clonep() ) {
		set("unit", "ン");
		set("value", 720);
		set("long", "硂琌ン臟ノㄓ綛咀琍聁狝\n");
		set("wear_as", "armor");
		set("apply_armor/armor", ([
			"armor": 2,
			"armor_vs_fire": 5,
		]));
	}

	setup();
}
