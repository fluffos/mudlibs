// broadsword.c

#include <weapon.h>

inherit F_SWORD;
inherit F_BLADE;

void create()
{
	set_name("溜糃", ({ "broadsword", "sword" }) );
	set_weight(12000);
	setup_sword(2, 12, 60, 1);
	setup_blade(2, 12, 80, 0);

	if( !clonep() ) {
		set("wield_as", ({ "sword", "twohanded sword", "blade" }));
		set("unit", "р");
		set("value", 4000);
		set("rigidity", 25);
		set("long", "р弘葵疟Θ蛮臟糃硂琌﹛┎瓁盽ノ猌竟\n");
	}
	setup();
}
