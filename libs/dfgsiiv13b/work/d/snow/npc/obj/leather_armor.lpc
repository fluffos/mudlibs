// leather_armor.c

#include <armor.h>

inherit F_ARMOR;

void create()
{
	set_name("祑ブヒ玚", ({ "leather armor", "armor" }));
	set_weight(10000);
	setup_armor();

	if( !clonep() ) {
		set("unit", "ン");
		set("long",
			"ンノブ歼祑羅ノㄓ玂臔ō砰ヒ玚瘤礛ň臔狦ゑぃ\n"
			"妮籹Θ馴ヒ琌淮獽獽﹜琌硂摸ブ籹ヒ玚纔翴\n");
		set("value", 1400);
		set("wear_as", "armor");
		set("apply_armor/armor", ([
			"armor": 6
		]) );
	}
	setup();
}
