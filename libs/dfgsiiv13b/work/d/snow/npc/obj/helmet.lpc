// helmet.c

#include <armor.h>

inherit F_HEAD_EQ;

void create()
{
	set_name("簧帛", ({ "brass helmet", "helmet"}));
	set_weight(4000);
	setup_head_eq();

	if( !clonep() ) {
		set("unit", "郴");
		set("long", "硂琌郴簧籹繷帛妮瓁钉い猌﹛郴拦\n");
		set("value", 900);
		set("wear_as", "head_eq");
		set("apply_armor/head_eq", ([
			"armor" : 3,
			"dodge" : -3,
		]) );
	}
	setup();	
}