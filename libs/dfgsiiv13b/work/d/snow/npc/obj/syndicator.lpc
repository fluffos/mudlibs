// syndicator.c

#include <ansi.h>
#include <weapon.h>

inherit F_DAGGER;
inherit F_UNIQUE;

void create()
{
	set_name("へ甉", ({ "syndicator" }));
	set_weight(3000);
    setup_dagger(3, 14, 100, 5);

	if( !clonep() ) {
		set("wield_as", ({ "dagger", "secondhand dagger" }));
		set("unit", "р");
		set("value", 32000);
		set("rigidity", 40);
		set("long",
			"硂琌рノ弘灿繨皿华\n"
			"羪疭琌硂薄钩琌︕繷籕糒娩﹀\n"
			"格琡祏ノㄢ唉も︘\n");
	}
	setup();
}

int inflict_damage(string strength, object victim)
{
	int dam = ::inflict_damage(strength, victim);

    if( dam && random(100) < 40 ) {
		environment()->add_temp("fight_msg", HIW "へ甉┛礛祇皚羘" NOR);
        victim->act(15);
	}
	return dam;
}
