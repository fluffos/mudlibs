// woodsword.c : an example weapon

#include <weapon.h>

inherit F_SWORD;

void create()
{
	set_name("れ糃", ({ "wooden sword", "sword" }) );
	set_weight(2000);
	setup_sword(1, 14, 40, 0);

	if( !clonep() ) {
		set("wield_as", "sword");
		set("unit", "р");
		set("value", 400);
		set("rigidity", 10);
		set("long", "рノ祑れ玠Θ糃砆聇眔堵堵\n");
	}
	setup();
}
