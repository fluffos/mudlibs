// clothboot.c

#include <armor.h>

inherit F_FEET_EQ;

void create()
{
	set_name("╩˙箄", ({ "black boots", "boots" }));
	set_weight(1000);
	setup_feet_eq();

	if( !clonep() ) {
		set("unit", "蛮");
		set("long", "硂琌瓁钉い˙猌﹛盽箄淮獽瑻ノ\n");
		set("value", 1000);
		set("wear_as", "feet_eq");
		set("apply_armor/feet_eq", ([
			"armor" : 1,
			"dodge" : 1,
		]) );
	}
	setup();	
}