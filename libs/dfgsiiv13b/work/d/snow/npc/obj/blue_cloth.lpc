// blue_cloth.c

#include <armor.h>

inherit F_CLOTH;

void create()
{
	set_name("屡ガ璵", ({ "blue cloth", "cloth" }) );
	set_weight(2000);
	setup_cloth();

	if( !clonep() ) {
		set("unit", "ン");
		set("value", 600);
		set("long", "ン彩ガ羅籹ガ︾癬ㄓ钩琌秏﹉甉︾狝\n");
		set("wear_as", "cloth");
		set("apply_armor/cloth", ([
			"armor": 2,
		]));
	}

	setup();
}
