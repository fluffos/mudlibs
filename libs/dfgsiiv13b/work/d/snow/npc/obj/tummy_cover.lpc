// tummy_wear.c

#include <armor.h>

inherit F_CLOTH;

void create()
{
	set_name("▄奥", ({ "tummy cover", "tummy", "cover" }) );
	set_weight(1000);
	setup_cloth();

	if( !clonep() ) {
		set("unit", "ン");
		set("value", 400);
		set("long", "遏ㄢへǎよ彩ガ么ㄢ兵梅ㄠノㄓ倒︾\n");
		set("wear_as", "cloth");
		set("apply_armor/cloth", ([
			"armor": 1,
		]));
	}

	setup();
}
