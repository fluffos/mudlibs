// ssilversword.c

#include <weapon.h>

inherit F_SWORD;

void create()
{
	set_name("瑍蝗糃", ({ "silver sword", "sword" }) );
	set_weight(7000);
	setup_sword(2, 15, 40, 4);

	if( !clonep() ) {
		set("wield_as", ({ "sword" }));
		set("unit", "р");
		set("value", 19000);
		set("rigidity", 40);
		set("long", "р蝗籹祏糃疟硑眔だ弘\n");
		set("wield_msg", "$N┾р皗皗祇獹祏糃讽猌竟\n");
	}
	setup();
}
