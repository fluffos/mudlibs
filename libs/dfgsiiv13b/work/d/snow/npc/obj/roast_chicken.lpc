// roast_chicken.c

inherit COMBINED_ITEM;
inherit F_FOOD;

void create()
{
	set_name("縉蔓", ({ "roast chicken", "chicken" }) );
	if( !clonep() ) {
		set("unit", "帮");
		set("base_unit", "唉");
		set("base_value", 800);
		set("base_weight", 1500);
		set("food_stuff", 190);
		set("heal_kee", 30);
		set("long", "唉糛糛縉蔓珃常е瑈ㄓ\n");
	}
	setup();
}

