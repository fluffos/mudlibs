// pot.c

inherit ITEM;

void create()
{
	object water;

	set_name("", ({ "pot" }));
	set_max_encumbrance(180000);
	set("long", "杆骸睲狦戴ㄓ耻(drink)\n");
	set("no_get", 1);
	set("liquid_container", 1);
	setup();
	if( clonep() ) {
		water = new("/obj/water");
		water->set_volume(100000);
		water->move(this_object());
	}
}

varargs int accept_object(object me, object ob)
{
	if( ob )
		if( !userp(ob) )
			return 1;
	else return notify_fail("ぃ盢產甧竟柑\n");
}

void reset()
{
	object water;
	if( water = present("water", this_object()) )
		water->set_volume(100000);
}

