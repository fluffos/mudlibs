//blue_jacket.c
#include <armor.h>

inherit F_CLOTH;

void create()
{
	set_name("屡︾甅", ({ "blue jacket", "jacket" }) );
	set_weight(2000);
	setup_cloth();
	if( !clonep() ) {
		set("unit", "ン");
		set("value", 500);
		set("long", "ン瞏屡︹︾赂ρ\"辰\"\n");
		set("wear_as", "cloth");
		set("apply_armor/cloth", ([
			"armor": 2,
		]));
	}
	setup();
}