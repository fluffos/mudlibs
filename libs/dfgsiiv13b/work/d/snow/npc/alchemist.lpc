// alchemist.c

#include <npc.h>

inherit F_VILLAGER;

void create()
{
	set_name("朝蝴獿", ({ "chen weisha", "weisha", "chen" }));
	set("nickname", "﹡");
	set_attr("dex", 18);
	set_attr("int", 24);
	set_attr("wis", 25);
	set_attr("spi", 22);
	set_attr("cps", 19);
	set_attr("con", 20);
	set_race("human");
	set_level(30);
	set_class("alchemist");
	set_skill("unarmed", 60);
	set_skill("sword", 60);
	set_skill("parry", 80);
	set_skill("dodge", 70);
	set_skill("force", 70);
	set_skill("kee anatomy", 100);
	set_skill("dragon force", 60);
	set_skill("alchemy-medication", 140);
	set_skill("alchemy-wealth", 40);
	set_skill("alchemy-magic", 80);
	set_skill("alchemy-immortality", 30);
	map_skill("force", "dragon force");

	advance_stat("gin", 180);
	advance_stat("kee", 180);
	advance_stat("sen", 180);

	set("age", 55);
	set("long",
		"朝蝴獿琌帝よ竒盽ㄓ┕ぱǜ瓣籔踌潮郡ぇ丁蹦媚の碝砎\n"
		"膓㎝撤獸马琌侣ら怠硂碭らセ璶┕偿ο\n"
		"蹦媚琌祍搁竩環┮既產絃计ら\n"
		"朝蝴獿セ朝蝴獿琌厩ネ癳倒嘿腹種琌弧讽\n"
		"Τ獿尺舧ゴ╆ぃキ璝ぃ琌倒縒鸟︘量緄ネぇ砃\n"
		"┤Ν碭ら玡碞偿ο缎埃祍\n");
	setup();
	carry_object(__DIR__"obj/silversword")->wield();
	carry_object("/obj/area/obj/cloth")->wear();
}

void set_flag(object me)
{
	if( me && present(me, environment()) ) {
		if( me->query_class() != "commoner"
		||	me->query("title") )
			return;
		me->set_temp("pending/alchemist", 1);
	}
	else
		do_chat("朝蝴獿弧笵糑 ... 常ǐи硂ρ繷临︑ē︑粂 ...\n");
}

int accept_apprentice(object me)
{
	if( is_chatting() ) return 0;
	if( me->query_temp("pending/alchemist") ) return 1;
	if( me->query("title") ) {
		do_chat("朝蝴獿笵: 淮, Τ縉蹦媚, 硂矪盯瑼\n");
		return 0;
	}
	do_chat(({
		"朝蝴獿弧笵и畍 ... иぃ琌ぐ或猌狶蔼も\n",
		"朝蝴獿辨帝穦弧笵и琌尺舧芬う蹦媚ゴ╆ぃキρ繷ㄠ\n",
		"朝蝴獿┛礛癬ㄓ弧笵芬う蹦媚ゴ╆ぃキ... ...\n",
		"朝蝴獿弧笵и硂淮临抖泊狦ぃ┤暗ㄇ縉蹦媚彩 ...\n",
		"朝蝴獿弧笵ρひ畕ぃ獽ぃЙ\n",
		(: set_flag, me :)
	}));
	return 0;
}

int init_apprentice(object me)
{
	// add by dragoon
	if( me->query_class() != "commoner" ) {
		do_chat(({
			"朝蝴獿弧笵琂癦Τ緇策иう砃?\n",
			"朝蝴獿揣揣も弧笵.....\n"
		}));
		return 1;
	}
	if( ::init_apprentice(me) ) {
                seteuid(getuid());
		me->set_class("alchemist");
		me->set("title", "纒瓜う");
		do_chat(({
			"朝蝴獿翴翴繷弧笵瘤礛и琌眔縉蹦媚\n",
			"朝蝴獿弧笵ぇ狦畍临臭硑碞硂肚う砃\n",
			"朝蝴獿耚\耚\も弧笵\n"
		}));
	}
}

int acquire_skill(object ob, string skill)
{
	if( is_chatting() )
		return notify_fail("程单ρ產杠弧Ч础糒 ...\n");
	if( !ob->is_apprentice_of(this_object()) ) return 0;

	switch(skill) {
	case "alchemy-medication":
		if( !ob->query_learn(skill)
		&&	ob->query_score("alchemy") >= 1000 ) {
			say("朝蝴獿翴翴繷弧笵畍硂碞肚钮\n");
			message_vision("$N盢纒瓜う笵い笰ぇ砃璶肚甭倒$n\n", this_object(), ob);
			ob->improve_skill(skill, random(ob->query_attr("wis")) + 1);
		}
		break;
	case "alchemy-wealth":
	case "alchemy-magic":
	case "alchemy-immortality":
	default:
		return 0;
	}

	do_chat(({
		"朝蝴獿弧笵иよい礚ぃ蕾毕ヴ\n",
		"朝蝴獿弧笵う笵瘤琌┕絤秨﹍ ...\n",
		"朝蝴獿弧笵璶ち癘ぃ瞋打︽腇いぇ瑈Τ碭だセ烩弧碭だ杠\n",
		"朝蝴獿弧笵辨︑ぇ\n",
	}));

	return 1;
}
