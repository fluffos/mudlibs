// miller.c

#include <npc.h>

inherit F_VILLAGER;

void create()
{
	set_name("法耇", ({ "miller" }));
	set_race("human");
	set_level(2);

	set("gender", "female");
	set("long",
		"法耇琌玡碭穐硂よ沮弧ひ琌绰い蔼﹛琌\n"
		"眔\碔禥ぇ玱┻斌ヾㄠ琌法耇︑眖ぃ┯粄弧ひ\n"
		"ㄊ竒坝\n");
	setup();
	carry_object("/obj/area/obj/cloth")->wear();
}
