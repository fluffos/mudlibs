// child2.c

#include <npc.h>

inherit F_VILLAGER;

void create()
{
	set_name("", ({ "child" }) );
	set_race("human");
	set_stat_notify("kee", 100);
	set_level(1);

	set("long", "烦╧絅絅辨帝\n");
	set("chat_chance", 10);
	set("chat_msg", ({
		"笵 °  °\n",
		"忘忘帝露帝禲ㄓ禲\n",
		"笵 °  °\n"
	}) );
	setup();
	carry_money("coin", 1);
	carry_object(__DIR__"obj/woodsword")->wield();
}

int accept_fight(object ob)
{
	do_chat("砍灸铬帝ㄓゑ猌\n");
	return 1;
}

int notify_stat(mapping flag)
{
	command("emote 珃羘癬ㄓゴи琌胊");
	return ::notify_stat(flag);
}

