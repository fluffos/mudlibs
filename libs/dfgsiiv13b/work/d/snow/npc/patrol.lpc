// patrol_garrison.c

#include <npc.h>

inherit F_VILLAGER;

void create()
{
    set_name("ǖ呸﹛", ({ "patrol garrison", "patrol", "garrison" }) );
    set_race("human");
    set_class("fighter");
    set_level(15);
    set_skill("sword", 60);
    set_skill("parry", 60);
    set_stat_maximum("gin", 150);
    set_stat_maximum("kee", 150);

    set("pursuer", 1);
    set("long",
        "︗璽砫蝴臔よ獀﹛筁讽癡絤Τ\n"
        "瓁钉驹\n");
    set("vendetta_mark", "authority");
    setup();
    carry_object( STOCK_ARMOR("cloth") )->wear();
    // Wiled the sword when protecting someone. (Just for cool :P)
    carry_object( STOCK_WEAPON("broadsword"));
}


int accept_fight(object ob)
{
    do_chat((: command, "emote 傈傈泊弧笵簎秨簎秨ぶ硂柑舘":));
    return 0;
}

void protect(object ob)
{
    command("emote 耻ははぱてらぇ澈幢炳硏た㏑ㄓ");
    command("wield sword");
    guard_ob(ob);
}
