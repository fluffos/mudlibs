// gammer.c

#include <npc.h>

inherit F_VILLAGER;

void create()
{
	set_name("組泊ρび盋", ({ "blind gammer", "gammer", "__ID_GAMMER__" }) );
	set_attr("dex", 29);
	set_attr("con", 21);
	set_attr("cor", 22);
	set_attr("str", 19);
	set_race("human");
	set_class("thief");
	set_level(44);

	set_skill("staff", 40);
	set_skill("stealing", 70);
	set_skill("dodge", 90);
	set_skill("blade", 30);
	set_skill("sword", 30);
	set_skill("unarmed", 50);
	set_skill("dagger", 70);
	set_skill("secondhand dagger", 70);
	set_skill("killerhood", 60);
	set_skill("force", 90);
	set_skill("regular force", 100);
    map_skill("force", "regular force");

	advance_stat("gin", 270);
	advance_stat("kee", 180);
	advance_stat("sen", 90);

	set("gender", "female");
	set("age", 66);
	set("long",
		"組泊氟ρび盋骸羪終琌玱倒贺克ち稰谋\n");

	set("chat_chance", 8);
	set("chat_msg", ({
		"組泊ρび盋充充弧笵腳琌盾\n",
		"組泊ρび盋凹帝φΨ渡钮ぐ或\n",
		(: random_move :)
	}) );

	set("chat_chance_combat", 10);
	set("chat_msg_combat", ({
		"組泊ρび盋笵腳Τ碿篡璽盋盋еㄓ摆\n",
		(: random_move :),
	}) );
	set_stat_notify("kee", 40);

	setup();
	carry_object("/obj/area/obj/cloth")->wear();
	carry_object(__DIR__"obj/cane")->wield();
	carry_object(__DIR__"obj/syndicator")->wield("secondhand dagger");
}

private void give_coin(object who)
{
	object ob;

	if( environment(who) != environment() ) return;
	ob = new(__DIR__"obj/coin");
	if( !ob->move(who) )
		ob->move(environment());
}

void relay_say(object ob, string arg)
{
	int tmp = ob->query_temp("try/fon");
	// communicate with arbao
	if( !userp(ob) ){
		if( ob->id("__ID_ARBAO__") ){
			this_object()->delete("chat_msg");	// stop chat_msg
			this_object()->delete("chat_chance");
			if( strsrch(arg,"êび")>= 0 ) {
				do_chat((:command(
"say 羥舠摆腳, ﹑琌尺舧琱睧ê."):));
				return;
			}
			if( strsrch(arg,"琌")>= 0 ){
				do_chat(({
(:command("say 稱谤﹑, , 兵ン琌璶腊份份厨こ.
硂妓產籔衡掸つ."):),
				}));
				call_out((:message_vision("組泊ρび盋弧Ч, 锣筁ōǐ.\n",this_player()):),4);
				call_out((:destruct(this_object()):),6);
				return;
			}
		}
	}
	if( !tmp || tmp==0 ){
		if( arg=="イイ" && ob->query_temp("thief_qualified") ) {
			command("giggle");
			command("pat " + ob->query("id"));
			if( (string)ob->query_class() != "commoner" ) return;
			ob->set_class("thief");
			tell_object(ob, "タΑΘ祍搁\n");
			ob->improve_skill("sneak", 20);
			ob->improve_skill("stealing", 20);
			do_chat(({
				"組泊ρび盋弧笵癸硂倒",
				(: give_coin, ob :),
				"組泊ρび盋弧笵狦稱厩セㄆ硂狥﹁倒癸よ\n",
			}));
			return;
		}
		if( strsrch(arg, "腳") >= 0 )
			do_chat((: command, "say 腳弧腳柑" :));
		else switch(random(10)) {
			case 0: do_chat((: command, "shake" :));
			case 1: do_chat((: command, "?" :));
			case 2: do_chat((: command, "steal coin from " + ob->query("id") :));
		}
		return;
	}
	switch(tmp) {
		case 8:
			if( strsrch(arg,"琱")>=0 ) {
				do_chat(({
"組泊ρび盋ぃ筀, 耻笵: 簎, 簎, 簎, иぃ稱钮硂﹎.\n",
"組泊ρび盋充充︑粂帝瞒秨, 留留钮或碍, 腳, 或こ.\n",
"稱砛\ρび盋甝ㄠ笵碍種.\n",
				}));
				ob->set_temp("try/fon",10);
			}
			break;
		case 16:
			if( strsrch(arg,"化ぅ")>=0 ) {
				do_chat(({
"組泊ρび盋弧笵: иê碍Ν玡砆琱狥莫倒甡, 拜暗裕?\n",
"組泊ρび盋炽炽ぃヰ弧笵: 璶ぃ琌砆琱狥莫端, 咎ぱ材淮\荡ぃ穦
砆炳, 硂ぃ琌琱狥莫ê紃甡盾.\n",
"拜ぱ临琌ぃ睲ぃ贰, ぃ窽好碽, ぃ琱狥莫蛤硂ンㄆΤ︙ナ腐.\n"
				}));
				ob->set_temp("try/fon",18);
			}
			break;
		case 45:
			if( strsrch(arg,"睫睫")>=0 ) {
				do_chat(({
"組泊ρび盋佩笵: 硂..硂.. ⊿Τ硂妓и.. ㄓ硂痷琌ρ繷糶.\n",
"冈灿弧化ぅ.\n", 
"組泊ρび盋↖.\n",
(:command("say , 腊ρ盋Γ, 禗﹎琱, ρ盋ぃ穦т碝こ
, 絩ぇㄆ, 稱叉眔砫ヴ."):),
				}));
				ob->set_temp("try/fon",48);
			}
			break;
		default:        break;
	}
}

int accept_fight()
{
	do_chat((: command, "?" :));
	return notify_fail("組泊ρび盋癸跌璝礚窣 ...\n");
}

void init()
{
    if( environment(this_object())->query("connect-p") ) {
	command("say 戴, ㄓ耻...\n");
        message_vision("$N絯絯ǐ娩\n", this_object());
        this_object()->move("/d/snow/square");
        return;
    }
	// Dont call original init() to check autofight.
	if( !is_chatting() && this_player()->query_temp("try/fon")==43 ){
		do_chat(({
			"ǎρび盋, 矗瘆ガㄆ.\n",
			"ρび盋耻笵: 或瘆ガ, ㄓ.\n",
		}));
	}
}

private void ask_join(object player)
{
	if( !player || environment(player)!=environment() ) return;

	if( player->query_class() != "commoner" )
		command("say  ... ρ硈繦ō常盽盽メ奔\n");
	else {
		command("whisper " + player->query("id") + 
			" 趁ル澈礛倒敖稱Θ敖琌ぃ琌羘イイи碞琵硂︽ ...");
		player->set_temp("thief_qualified", 1);
	}
}

int accept_object(object player, object ob)
{
	if( player->query_temp("try/fon")!=43 ){
		if( !ob->id("annatto comb") ) return 0;
		command("say 玿硂 ... 硂琌 ... и");
		do_chat((: ask_join, player :));
		return 1;
	}
	if( ob->id("__ID_CHALLIE__") )	{
		do_chat(({
			"組泊ρび盋笵: 硂琌篡и泊組ぃǎ, 稱ㄓ腇и盾?\n",
			"稱ρび盋际嘿, 砛\ㄏ獺êン瘆ガ.\n"
		}));
		player->set_temp("try/fon", 45);
		return 1;
	}
}
