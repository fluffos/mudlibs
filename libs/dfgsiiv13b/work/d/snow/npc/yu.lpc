//yu.c
#include <npc.h>
#include <ansi.h>

inherit F_VILLAGER;
inherit F_VENDOR;

void create()
{
	set_name("辰ぱ", ({ "yu tan","yu","tan" }) );
	set_race("human");
	set_level(1);
	set("gender", "male");
	set("age", 25);
	set("long",
"緻φ羘瑇, ︑ギ縒﹖辰產担, ぃ醚ダ醚臟, ぃ稲簀稲窥硔\n"
"辰ぱ蛤辰產瞁方瞏, 沮肚籇辰臟讽粇炳獿, ōぇ╧捆\n"
", パぃㄤ┦ん產方, 珿眖辰產ぱ. 辰產癸ㄤΤ穃\, τ\n"
"辰ぱぃ猌美, 獽辰產戈方, ㄤ秨砞窥缠砪馒砯\n"
	);
	set("merchandise", ([
		"/d/snow/npc/obj/blue_jacket": 5,
		"/obj/armor/fur_hat": 5,
		"/obj/bottle": 5,
	]));
	set("chat_chance", 5);
	set("chat_msg", ({
		"辰ぱ充充搬笵: 垛, るΜκㄢフ蝗, ぃ岿 ぃ岿 !\n",
		"辰ぱ綼オ凹耫籓, 繷充充︑粂, タ衡璸帝.\n",
	}));
	setup();
	carry_object(__DIR__"obj/blue_jacket")->wear();
}

int accept_fight()
{
	do_chat((: command("emote 笵: ! ぃ絤ㄇňōм, 爱疪êㄠ琌环毕ぃ!") :));
	return 1;
}

void init()
{
	::init();
	if( !userp(this_player()) )	return;
	add_action("do_vendor_list", "list");

	do_chat(({
		"辰ぱ秨糒笵: 硂︗" + this_player()->rank("respectful") + "睰ㄇ︾狝!\n",
		"辰ぱざ残笵: 璶蹿, и辰癘琌龟翅!\n",
	}));
	if( this_player()->query("level")<=5 )
		// cancel call_out to test, by dragoon
		//call_out((:
		message("whisper",GRN
"辰ぱφ娩羘弧笵: 玡碭ぱи具狥﹁翅, 倒и翴窥碞癳, 镑種!\n"NOR,
		//	this_player()):),5);
		this_player());
}

int accept_object(object me,object ob)
{
	int tmp;
	object tmp_ob;
	if( !ob->query("money_id") && !userp(ob) ){
		do_chat(({
"辰ぱ弧笵: 硂.. 瘤礛ぃ琌蝗ㄢ, ぃ筁弧ぃ﹚Τ稱禦, 痷琌谅谅罢.\n",
"辰ぱ锣ō盢"+ob->name()+"Μ耫ぇ.\n",
		}));
		return 1;					// lv <=5, 1 coin is enough
	}								// lv >5, cost silver or gold
	if( ob->query("money_id")!="coin")
		tmp=1;
	if( me->query("level")>5 && ob->query("money_id")=="coin" )
		tmp=2;
	if( me->query("level")<=5 )
		tmp=3;
	switch(tmp){
		case 3:
		case 1:
			do_chat(({
"辰ぱ弧笵: , 硂︗﹛镑種, 硂種ㄠ碞癳倒罢!\n",
"辰ぱ盢眎ブユ倒.\n",
			}));
			tmp_ob=new(__DIR__"obj/note.lpc");
			if( !tmp_ob->move(me) )	ob->move(environment(me));
			return 1;;
		case 2:
			do_chat("硂︗﹛笵и穝Μ旅珇? ㄓ硂種碭窥, , 基蝗ㄢ碞Θ!\n");
			return 1;;
		default:	return 1;
	}
}
