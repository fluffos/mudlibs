// junkman.c

#include <npc.h>

inherit F_VILLAGER;

void create()
{
	set_name("珺ρ繷", ({ "junkman" }));
	set_race("human");
	set_level(2);

	set("age", 66);
	set("long",
		"仪芗珺ρ繷綼具珺紀蝴ネ狦腀種腊硂妓\n"
		"ρ筁翴ネ┪琌腀種蠢ǒ璚畍竊翴癘拘砰\n"
		"叫рō緇狥﹁倒眔翴 civism\n");
	set("bounty/mortal sin", 5);
	set("chat_chance", 8);
	set("chat_msg", ({
		(: random_move :),
		(: command, "get all" :),
	}));
	setup();

	// Always flee.
	set_stat_notify("gin", 100);
	set_stat_notify("kee", 100);
	set_stat_notify("sen", 100);
}

int accept_fight()
{
	do_chat("珺ρ繷臩甡┤薄弧笵硂 ... 珁 ... 那 ...\n");
	return 0;
}
