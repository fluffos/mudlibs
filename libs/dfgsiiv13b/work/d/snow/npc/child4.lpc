// child1.c

#include <npc.h>

inherit F_VILLAGER;

void create()
{
	set_name("", ({ "child" }) );
	set_race("human");
	set_level(1);
	set_stat_maximum("gin", 20);
	set_stat_maximum("kee", 20);
	set_stat_maximum("sen", 20);
	set_stat_notify("kee", 100);

	set("age", 6);
	set("long", "瑈帝惑窩帝蛮礚ǜ泊氟辨帝\n");
	setup();
	carry_money("coin", 1);
	carry_object(__DIR__"obj/tummy_cover")->wear();
}

int accept_fight(object ob)
{
	do_chat("穘穘繷弧笵и⊿ゴ琜иノ\搬盢ㄓ璶σじ\n");
	return 0;
}

int notify_stat(mapping flag)
{
	command("emote 珃羘癬ㄓゴи洱洱洱洱");
	return ::notify_stat(flag);
}
