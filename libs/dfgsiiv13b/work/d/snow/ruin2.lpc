{
	set("short", "瘆侣タ芔");
	set("long", @LONG
硂柑琌瓷瘆侣タ芔鲤纠蛤郴竒俱厄
睤腂腂眖娩拈秈ㄓ谋眔種琌硂柑睲苯眔
讽俱间ノ爱俱俱霍霍綫帝鏓弧琌瑈簙硂柑聪
盝玱ぃ钩柑穦Τ硂或稲俱间瑈簙芔厄假琖咀︘┕
﹁
LONG
	);
	set("detail", ([ /* sizeof() == 3 */
		"假琖" : "蛤彩假琖ㄓタ咀︘タ芔
",
		"鏓" : "ノ爱綫Θ鏓瘤礛虏琌玱爱爱瞓瞓讽綼
澈临籇睭睭
",
		"" : "眖┕辨ǎㄤ场常竒Θニ膖帮狦
