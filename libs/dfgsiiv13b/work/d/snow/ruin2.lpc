void init()
{
	add_action("do_climb", "climb");
}

int do_climb(string arg)
{
	if( arg != "假琖" ) return 0;

	message_vision("$N筁厄假琖┕玡皘瞒\n", this_player());
	this_player()->move(__DIR__"ruin1");
	message("vision", this_player()->name() + "眖厄假琖繷ㄓ\n",
		environment(this_player()), this_player());
	return 1;
}

