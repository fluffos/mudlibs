{
	set("short", "紁┬");
	set("long", @LONG
硂柑琌丁糴疮紁┬畒╛沮狥娩鲤纠玭娩耫
俱俱霍霍帝砛羚窲縘硂柑キ盽琌讽Γ窵狦璶
硂柑狥眎﹁辨杠程み砆┍狠帝荐傣倒縎┕狥
刺柑
LONG
	);
	set("detail", ([ /* sizeof() == 2 */
		"耫" : "硂ㄇ耫柑琌倒ノ窲絃盒竉だ摸杆碭耫\n"
				 "柑耫常╊稱琌よ獽ノ\n",
		"╛" : "畒縐縉帝旱旱╛╛甧簙秈ぃ筁\n"
