// Room: /d/snow/kitchen.c

inherit ROOM;

void create()
{
	set("short", "紁┬");
	set("long", @LONG
瞷タめΤ窥產紁┬柑ぃ筁㎝稱钩いΤ窥產紁
┬钩ぃび妓⊿Τ帮骸蔓纍辰ψ蛤稱ㄓΤ窥琌
稽ノΤ窥紁┬玭娩ぃ筁玛︘狥娩玥琌
秈ㄓ瞅鲤
LONG
	);

	set("objects", ([
		"/obj/food/dumpling" : 2
	]) );
	setup();
}

void init()
{
	add_action("do_climb", "climb");
}

int do_climb(string arg)
{
	if( arg!="瞅鲤" ) return 0;

	message_vision("$Nノも胟瞅鲤棉碭陆筁\n", this_player());
	this_player()->move(__DIR__"epath");
	message("vision", this_player()->name() + "眖瞅鲤繷ㄓ\n",
		environment(this_player()), this_player());
	return 1;
}
