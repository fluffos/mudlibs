// Room: /d/snow/epath.c

inherit ROOM;

void create()
{
	set("short", "击繰");
	set("long", @LONG
硂柑琌兵击繰┕﹁ぃ环矪硄┕撤獸马約初
琌ㄇニ瞅露帝蔼蔼瞅鲤ㄓ琌Τ窥玭娩Τ產
媚綫本ㄇ盼爱媚┕狥琌锣à
LONG
	);
	set("detail/瞅鲤",
		"硂丁瞅鲤癬ㄓ讽蔼ぃ筁狦铬癬ㄓ杠玧眏穚眔帝\n");
	set("outdoors", "snow");
	set("exits", ([ /* sizeof() == 2 */
		"east" : __DIR__"lane1",
		"west" : __DIR__"square_e",
		"south" : __DIR__"herb_shop",
	]));

	setup();
}

void init()
{
	add_action("do_climb", "climb");
}

int do_climb(string arg)
{
	if( arg!="瞅鲤" ) return 0;

	message_vision("$Nノも胟瞅鲤棉碭陆筁\n", this_player());
	this_player()->move(__DIR__"kitchen");
	message("vision", this_player()->name() + "眖瞅鲤繷筁ㄓ\n",
		environment(this_player()), this_player());
	return 1;
}
