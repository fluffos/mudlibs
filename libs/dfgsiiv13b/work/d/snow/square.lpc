// Room: /d/snow/square.c

inherit ROOM;

void create()
{
	set("short", "約初いァ");
	set("long", @LONG
硂柑琌撤獸马約初いァエρ篲攫絃岿挡いァ
ㄇ担盽盽硂ρ篲糬栏篲攫绢捷帝碭眎构ㄑ
凡册ぱ攫临Τㄑ隔秆戴
LONG
	);
	set("objects", ([ /* sizeof() == 1 */
		__DIR__"npc/obj/pot" : 1,
		__DIR__"npc/gammer" : 1,
		__DIR__"npc/junkman": 1,
	]));
	set("detail", ([ /* sizeof() == 2 */
		"篲攫" : "硂篲攫ぶ弧Τㄢκ烦兵兵沤碭
攫稦竒盽砆季篘τ陪眔菲
",
		"构" : "だ炊硄盽ǎ构狦仓ぃゲ荷恨暗ㄓヰ
",
]));
	set("exits", ([ /* sizeof() == 4 */
		"east" : __DIR__"square_e",
		"north" : __DIR__"square_n",
		"west" : __DIR__"square_w",
		"south" : __DIR__"square_s",
	]));

	setup();
}

void init()
{
	add_action("do_climb", "climb");
}

int do_climb(string arg)
{
	if( arg != "篲攫" ) return 0;

	message_vision("$N胟帝篲攫攫稦\n", this_player());
	if( this_player()->move(__DIR__"tree") )
		message("vision", this_player()->name() + "眖攫ㄓ\n",
		environment(this_player()), this_player());
	return 1;
}

