// map.c

inherit ITEM;

void create()
{
	set_name("瓜", ({ "map" }));
	set_weight(10);
	if( !clonep() ) {
		set("unit", "眎");
		set("value", 300);
		set("long", "眎陪ボ瓜ノ read map ㄏノ\n");
	}
	setup();
}

void init()
{
	add_action("do_read", "read");
}

int do_read(string arg)
{
	mapping m;
	string mstr;

	if( !id(arg) ) return 0;
	if( !mapp(m = environment(this_player())->query("virtual_map")) )
		return notify_fail("瓜Τ跋办いΤ\n");
	mstr = "\n";
	mstr += repeat_string("                  \n", 9);
	mstr += "\n";
	write(mstr);
	return 1;
}
