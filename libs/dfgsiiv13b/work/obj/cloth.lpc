// cloth.c

#include <armor.h>

inherit F_CLOTH;

void create()
{
	set_name("ガ︾", ({ "cloth" }) );
	set_weight(2000);
	setup_cloth();

	if( !clonep() ) {
		set("unit", "ン");
                set("value",60);
		set("long", "ン彩ガ羅籹ガ︾癬ㄓ钩琌秏︾狝\n");
		set("wear_as", "cloth");
		set("apply_armor/cloth", ([
			"armor": 1,
		]));
	}

	setup();
}
