// bankbond.c

inherit ITEM;

int balance = 0;

void create()
{
	set_name("窥缠", ({ "bankbond" }));
	set_weight(1);
	if( !clonep() ) {
		set("unit", "眎");
		set("long",
			"硂琌眎窥缠ノㄓ癘更蛤め窥┕ㄓΤ蛮よ┿蛤\n"
			"挡緇\n");
        set("no_sell", 1);
	        set("value", 1);
	}
	set("keep_this", 1);
	setup();
}

string query_autoload() { return balance + ""; }

void autoload(string param)
{
	if( sscanf(param, "%d", balance) )
		set("owner_id", geteuid(previous_object()));
}

void transact(int amount)
{
	if( environment()->query("bank_account") != balance ) return;

	balance = environment()->query("bank_account") + amount;
	environment()->set("bank_account", balance);
}

void set_balance(int b) { balance = b; environment()->set("bank_account", b); }
int query_balance() { return balance; }

string long(int raw)
{
	string str;
	int amount;

	str = ::long(raw);
	if( balance > 0 ) {
		str += "瞷羆挡緇";
		amount = balance;
	} else if( balance < 0 ) {
		str += "瞷临画ろ窥缠";
		amount = - balance;
	}
	if( balance != 0 ) {
		if( amount >= 100 ) {
			str += chinese_number(amount/100) + "ㄢ";
			if( amount%100 ) str += "";
		}
		if( amount%100!=0 )
			str += chinese_number(amount%100) + "ゅ窥";
		str += "\n";
	}

	return str;	
}
