inherit ROOM;

void create()
{
	set("short","厚畄");
	set("long",@LONG
硂柑琌 ES2 瞒畄恨癡┮, 狦砆癳硂柑, ボ:
笻は笴栏砏玥, 叫は┮┮, 稱瞒
秨杠璶耞絬禬筁 15 だ牧 :-) 
LONG
	);
	setup();
}

void init()
{
	if (!wizardp(this_player()) ) 
	add_action("block_cmd","",1);
	call_out("green", 2, this_player());
}

int block_cmd()
{
	if((string)query_verb() == "look") return 0;
	if((string)query_verb() == "help") return 0;
	return 1;
}

void green()
{
	tell_room(environment(this_player()),"钮φ娩肚ㄓ厚畄Ρ簈羘: \n\n"+
		"硂厚畄钩唉差  る柑穘摆穘\n"+
		"﹉甉﹑иみ柑钠摆钠\n"+
		"琵и簈羘繦ê稬  秨﹑怠卯\n"+
		"琵и癑薄繦ê瑈  ぃ耞﹑渡禗\n"+
		"乏攫紇被ぃ︘и薄種\n"+
		"碅る酚獹иみ\n"+
		"硂厚畄竒硂妓↖繰\n"+
		"﹉甉绥°﹑ぐ或临琌纐纐礚粂\n\n");
	return;
}
