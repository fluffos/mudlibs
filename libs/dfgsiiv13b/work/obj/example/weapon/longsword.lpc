// longsword.c

#include <weapon.h>

inherit F_SWORD;

void create()
{
	set_name("糃", ({ "longsword", "sword" }) );
	set_weight(5000);
	setup_sword(3, 7, 50, 0);

	if( !clonep() ) {
		set("wield_as", "sword" );
		set("unit", "р");
		set("value", 4000);
		set("rigidity", 25);
		set("long", "р弘葵疟Θ糃琌猌狶い盽ノ猌竟\n");
		set("wield_msg", "$N詜羘┾р糃搐もい\n");
	}
	setup();
}
