// shortsword.c

#include <weapon.h>

inherit F_SWORD;

void create()
{
	set_name("祏糃", ({ "shortsword", "sword" }) );
	set_weight(3000);
	setup_sword(3, 6, 40, 0);

	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("wield_as", ({ "sword", "secondhand sword" }));
		set("unit", "р");
		set("value", 900);
		set("rigidity", 20);
		set("long", "р彩罻祏糃盿ō娩ňōノ猌竟\n");
		set("wield_msg", "$N┾р祏糃讽猌竟\n");
	}
	setup();
}
