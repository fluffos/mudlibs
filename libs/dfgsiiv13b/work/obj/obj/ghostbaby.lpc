// ghostbaby.c

inherit ITEM;

void create()
{
        set_name("碍", ({ "ghostbaby" }));
        set_weight(1);
        if( !clonep() ) {
                set("unit", "");
                set("long",
                        "硂琌碍, 蠢\n");
        set("no_sell", 1);
//	set("no_drop",1);
        set("value", 1000000000);
        }
