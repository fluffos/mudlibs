#include <ansi.h>

inherit ITEM;


void create()
{
	set_name("废", ({ "firework" }) );
	if (!clonep()) set("long", @CLONG
硂琌废, 翴縐ウ(light_firework), 盢穦莉眔砛贾届
ノ猭琌light_firework xxx
xxx 琌稱璶弧杠舘 ....
CLONG
		);
                set("base_unit", "");
                set("base_value", 1000);
                set("base_weight", 100);
		                set("unit", "");
	setup();
} // create()


void init()
{
	add_action("do_light","light_firework");
} // init()


int do_light(string s)
{
	string s1, s2, cmsg;

	switch (random(7))
	{
	case 0  : s1= HIR; s2= ""; break;
	case 1  : s1= HIM; s2= "档"; break;
	case 2  : s1= HIY; s2= "独"; break;
	case 3  : s1= HIG; s2= "厚"; break;
	case 4  : s1= HIB; s2= "屡"; break;
	case 5  : s1= HIC; s2= "獵"; break;
	case 6	: s1= HIW; s2= "フ"; break;
	default : s1= HIR; s2= "";
	} // switch

	message_vision("$N盢废翴帝, 礛被︘φΨǔ硉跟娩\n",
		this_player() );
	if (!s) cmsg = s1 + "痽羘猅腞"+ s2 +
		"︹废ぱい皀甮秨ㄓ\n" + NOR;
	else cmsg = s1 + "痽羘砛\猅腞"+ s2 +
		"︹废い皀甮秨ㄓ絯絯ほてΘ逼\n"+s+"\n" + NOR;
	shout(cmsg);
	write(cmsg);
	destruct(this_object());
	return 1;
} // do_light()
