// green_pill.c

inherit COMBINED_ITEM;

void do_cure_poison(object me);

void create()
{
	set_name("ヌ艶睲瑀う", ({"green pill", "pill"}));
	if( !clonep() ) {
		set("unit", "ㄇ");
		set("long",
"ヌ艶睲瑀う琌贺睲荐秆瑀う媚,パ独土, īダ, れ硄, 菲ホ\n"
"单贺媚铃籹τΘ, 讽炊筂秆媚媚ぇ\n");
		set("base_unit", "采");
		set("base_value", 650);
		set("base_weight", 5);
		set("mixture_value", 100);
		set("produce_param", ([
			"min_heat_power" : 85,
			"max_heat_power" : 230,
			"min_heat" : 150,
			"max_heat" : 200,
		]));
		set("cure_poison", ([
		"" : -1, "" : -1, "" : -1, "" : -1, "れ" : -1,
		"damage" :   -1,
		]));
		set("requirement", ([
			"literate" : 5,
			"alchemy-medication" : 15,
		]));
	}
	set_amount(1);
	setup();
}

int stuff_ob(object me)
{
	if( me->query_stat_maximum("food") - me->query_stat("food") < 20)
		return notify_fail("▄竒嫉眔硈硂采媚ぃ\n");
	message_vision("$N采ヌ艶睲瑀う\n", me);
	me->consume_stat("water", 10);
	me->supplement_stat("food", 5);
	me->supplement_stat("sen", 2);
	do_cure_poison( me );	
	add_amount(-1);
	return 1;
}

void do_cure_poison(object me)
{
        mixed cnd_data;
        object ob;
        ob=this_object();
        cnd_data = me->query_condition("poison");

	if ( me->query_condition("poison") == 0 ) {
		tell_object(me, "硂聋媚, 琌玱⊿ぐ或稰谋\n");
	} else {
		if ( ob->query("cure_poison/damage") )
		cnd_data["damage"] = cnd_data["damage"] + 
			ob->query("cure_poison/damage");
                if (cnd_data["damage"] <= 0 ){
                        me->delete_condition("poison");
	                tell_object(me, 
			"硂聋媚, ō砰ぃ続竒Ч埃\n");
                        return;
                }
                else {
	                tell_object(me, 
			"硂聋媚, ō砰ぃ続稰祔稬搭淮\n");
                }
                return;
        }
}
