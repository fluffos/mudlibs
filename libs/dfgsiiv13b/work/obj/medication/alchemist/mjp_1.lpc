// basic setup of major_heal_pill 
#include <ansi.h>

inherit COMBINED_ITEM;

void create()
{
	set_name(HIY"临う"NOR, ({"major heal pill", "major", "pill" }));
	if( !clonep() ) {
		set("unit", "ㄇ");
		set("long", 
"临う琌贺伐う, ㄣ眏励琵狝ノ\n"
"ず端俐丁隆, ぃ筁芬籹临う┮惠媚埃临う\n"
"┮惠碭妓媚, 临ゲ惠т碝撤浆, 鐇单计贺╱ǎ\n"
"禥媚, 临う埃縉芬螟, 媚ぇ基ョ\n"
"伐禥硂聋う睭睭独︹, 铃籹筁祘い\n"
"ìぇ紉, κい匡ぇ伐珇临う\n");
		set("base_unit", "采");
		set("base_value", 10000);
		set("base_weight", 5);
		set("mixture_value", 6000);
	}
	set_amount(1);
	setup();
}

int stuff_ob(object me)
{
	if (me->query_stat_maximum("food") - me->query_stat("food") < 10)
		return notify_fail("▄竒嫉眔硈硂采媚ぃ\n");
	message_vision("$N采临う\n", me);
	me->consume_stat("water", 18);
	me->supplement_stat("food", 7);
	me->heal_stat("gin", 60);
	me->supplement_stat("gin", 80);
	me->heal_stat("kee", 150);
	me->supplement_stat("kee", 180);
	me->heal_stat("HP", 25);
	me->supplement_stat("HP", 40);
	add_amount(-1);

	return 1;
}
