// black_pill.c

inherit COMBINED_ITEM;

void create()
{
	set_name("疩みう", ({"black pill", "pill"}));
	if( !clonep() ) {
		set("unit", "ㄇ");
		set("long",
			"疩みう琌贺チ丁炊筂媚よノㄓ確巨絤┮砰\n"
			"Τぃ岿狦翴琌穦℉℉稱何谋甧戴\n");
		set("base_unit", "采");
		set("base_value", 80);
		set("base_weight", 5);
		// 媚よ基
		set("mixture_value", 30);
		// 芬籹把计
		set("produce_param", ([
			"min_heat_power" : 80,
			"max_heat_power" : 250,
			//change from 1000/1500 to  100/150
			"min_heat" : 100,
			"max_heat" : 150,
		]));
		// й魁媚よ┮惠程м
		set("requirement", ([
			"literate" : 1,
		]));
	}
	set_amount(1);
	setup();
}

int stuff_ob(object me)
{
	if( me->query_stat_maximum("food") - me->query_stat("food") < 5 )
		return notify_fail("▄竒嫉眔硈硂采媚ぃ\n");
	message_vision("$N采堵堵媚\n", me);
	me->consume_stat("water", 30);
	me->supplement_stat("food", 5);
	me->damage_stat("sen", 1);
	me->consume_stat("sen", 4);
	me->supplement_stat("gin", 15);
	me->supplement_stat("kee", 15);
	add_amount(-1);

	return 1;
}
