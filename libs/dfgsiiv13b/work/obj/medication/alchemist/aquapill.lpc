// aquapill.c

inherit COMBINED_ITEM;

void create()
{
	set_name("睪う", ({"aquapill", "pill"}));
	if( !clonep() ) {
		set("unit", "ㄇ");
		set("long",
			"睪う琌贺よ產う媚羆嘿璶\琌励端睪う励端\n"
			"\讽ぃ岿τ┮惠媚甧禦琌芬籹筁祘ゑ\n"
			"耕惠璶м砃┮Τカ媚鏓禦眔\n");
		set("base_unit", "采");
		set("base_value", 160);
		set("base_weight", 5);
		set("mixture_value", 50);
		set("produce_param", ([
			"min_heat_power" : 90,
			"max_heat_power" : 180,
			// change from 4200/4500 to 2700/3000 by dragoon
			"min_heat" : 420,
			"max_heat" : 450,
		]));
		// skill changed from 5 to 30 by dragoon
		set("requirement", ([
			"literate" : 10,
			"alchemy-medication" : 30,
		]));
	}
	set_amount(1);
	setup();
}

int stuff_ob(object me)
{
	if( me->query_stat_maximum("food") - me->query_stat("food") < 20)
		return notify_fail("▄竒嫉眔硈硂采媚ぃ\n");
	message_vision("$N采睪う\n", me);
	me->consume_stat("water", 10);
	// changed from 15 to 5 by dragoon
	me->supplement_stat("food", 5);
	me->damage_stat("gin", 3);
	me->consume_stat("gin", 5);
	me->heal_stat("kee", 25);
	me->supplement_stat("kee", 25);
	add_amount(-1);

	return 1;
}
