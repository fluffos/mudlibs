// dragon_saliva.c

inherit COMBINED_ITEM;

void create()
{
	set_name("纒睠", ({"dragon-saliva herb", "dragon-saliva", "herb"}));
	if( !clonep() ) {
		set("unit", "ㄇ");
		set("long",
			"纒睠琌贺讽禥励端媚琌ぃび禦眔癬硂贺媚\n"
			"纒睠竒盽砆よノ芬籹ㄇ禥う媚琌钡狝硂贺\n"
			"媚Τㄇ砛\励端狦ぃ筁Τㄇ禣絵\n");
		set("base_unit", "");
		set("base_value", 5000);
		set("base_weight", 7);
	}
	set_amount(1);
	setup();
}

int stuff_ob(object me)
{
	if( me->query_stat_maximum("food") - me->query_stat("food") < 10 )
		return notify_fail("▄竒嫉眔ぐ或狥﹁ぃ\n");
	message_vision("$N纒睠い腪腪\n", me);
	me->consume_stat("water", 10);
	me->supplement_stat("food", 10);
	me->consume_stat("sen", 3);
	me->heal_stat("kee", 30);
	add_amount(-1);

	return 1;
}
