// gray_mushroom.c

inherit COMBINED_ITEM;

void create()
{
	set_name("η郏", ({ "gray mushroom", "mushroom"}));
	if( !clonep() ) {
		set("unit", "ㄇ");
		set("long",
			"η郏琌贺ネ奸楞打娩猦ノㄓ獀励端\n"
			"灿郏硄盽矗芬ノㄓ籹硑寂籌媚ぃ筁钡狝\n"
			"ノΤぶ砛\獀励ず端\\n");
		set("base_unit", "");
		set("base_value", 90);
		set("base_weight", 30);
	}
	set_amount(1);
	setup();
}

int stuff_ob(object me)
{
	if( me->query_stat_maximum("food") - me->query_stat("food") < 20 )
		return notify_fail("▄竒嫉眔ぐ或狥﹁ぃ\n");
	message_vision("$Nη郏糒柑腪腪\n", me);
	me->supplement_stat("food", 20);
	me->consume_stat("water", 20);
	me->heat_stat("gin", 3);
	me->heat_stat("kee", 3);
	add_amount(-1);

	return 1;
}
