// boar_berry.c

inherit COMBINED_ITEM;

void create()
{
	set_name("睫狦", ({"boar berry", "berry"}));
	if( !clonep() ) {
		set("unit", "ㄇ");
		set("long",
			"睫狦琌贺ネ瞏いぷㄤ琌偿睫盻マ贺穞︹\n"
			"偿铲Τㄇ睫狦琌Τ瑀Τㄇ玥琌礚瑀礚瑀睫狦\n"
			"ノㄓ讽秆瑀警媚钡狝ノ玥矗ぃ筁牡笵\n"
			"ぃ....び\n");
		set("base_unit", "聋");
        set("base_value", 2000);
		set("base_weight", 70);
	}
	set_amount(1);
	setup();
}

int stuff_ob(object me)
{
	if( me->query_stat_maximum("food") - me->query_stat("food") < 20 )
		return notify_fail("▄竒嫉眔ぐ或狥﹁ぃ\n");
	message_vision("$N聋祇帝碿睫狦 ... ぱ摆$P澈礛眔 .... \n", me);
    me->supplement_stat("food", 10);
	me->consume_stat("water", 20);
    me->heal_stat("sen", 15);
    me->supplement_stat("sen", 10);
	add_amount(-1);

	return 1;
}
