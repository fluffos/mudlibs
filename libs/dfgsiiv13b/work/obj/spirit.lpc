// spirit.c
// ask player some question, and log some data to check he is robot or not
#include <npc.h>
#include <ansi.h>

//default question and answer, can be changed by setq seta
string question = "叫拜瞷ê柑?";
string answer = "诀竟畄";

void ask_q();

void create()
{
	set_name("弘艶", ({ "spirit","robot" }) );
	set("long", "
弘艶癸帝, 癸臩皋钵甧
弘艶帝茂, 癘魁帝ぃ氮拜肈 robot, 璶т畍厨薄.
	");
	set("chat_chance",20);
	set("chat_msg", ({
		(: ask_q :),
	}));
	setup();
}

void init()
{
	int arr_time = time();
	object me = this_player();
	
	if(!userp(me))
		return;
	if(wizardp(me)) {
		add_action("set_question", "setq");
		add_action("set_answer", "seta");
		add_action("about_robot", "about");
		add_action("robot_help", "help");
		call_out((:message("tell_ob", HIY+ "<help spirit> to complement robot check\n" +NOR, $1):), 1, me);
		return;
	}
	if(!me->query_temp("robot/time")){
		call_out((:message("tell_en", HIY+ "弘艶笵: " +$1+ " ㄓ抄и, 瑿! 瞷琌 " +ctime($2)+ ".\n" +NOR, $3):), 2, me->query("id"), arr_time, environment());
		me->set_temp("robot/time", arr_time);
		me->set_temp("robot/question", question);
		me->set_temp("robot/answer", answer);
		log_file("block_robot", sprintf("%s %s %12s ====init====\n",
			ctime(time()), ctime(arr_time), me->query("id")));
	}
}

//繦獽т初 player, 禗 拜肈
void ask_q()
{
	object *all, target;
	int i, tmp;

	all = all_inventory(environment(this_object()));
	i = sizeof(all);
	target = all[random(i)];
	if(!target || target == this_object())
		return;
	if( wizardp(target)
	|| target->query_temp("robot/time") <=0 )
		return;

	if( (tmp=(time() - target->query_temp("robot/time"))/60) > 20 )
		tell_object(target, tmp+ " だ牧, 妮 robot 翅.\n");
	tell_object( target, "弘艶弧笵: 叫ノ say 氮и拜肈: \n" +question+ "\n>");
}

//皐癸 who, 砞璸 question
int set_question(string arg)
{
	string who, que;
	object target;
	if(!arg || arg==""){
		write("SYNTAX: setp <ID> <question>\n");
		return 1;
	}
	if(sscanf(arg, "%s %s", who, que)!=2){
		write("SYNTAX: setp <ID> <question>\n");
		return 1;
	}
	if( !(target=present(who, environment())) ){
		write(who+ " ぃ硂, р summon ㄓ.\n");
		return 1;
	}
	target->set_temp("robot/question", que);
	write("р " +target->name()+ "拜肈砞: " +que+ "\n");
	return 1;
}

//皐癸 who 砞ㄤ answer
int set_answer(string arg)
{
	string who, ans;
	object target;
	if(!arg || arg==""){
		write("SYNTAX: setp <ID> <answer>\n");
		return 1;
	}
	if(sscanf(arg, "%s %s", who, ans)!=2){
		write("SYNTAX: setp <ID> <answer>\n");
		return 1;
	}
	if( !(target=present(who, environment())) ){
		write(who+ " ぃ硂, р summon ㄓ.\n");
		return 1;
	}
	target->set_temp("robot/answer", ans);
	write("р " +target->name()+ "ぇ拜肈 <"
		+target->query_temp("robot/question")+ "> 氮砞 <" +ans+ ">\n");
	return 1;
}

//琩琘 ぇ robot 戈癟
int about_robot(string who)
{
	object target;
	int arr_time;
	if(!who){
		write("SYNTAX: about <ID>\n");
		return 1;
	}
	if( !(target=present(who, environment())) ){
		write(who+ " ぃ硂, р summon ㄓ.\n");
		return 1;
	}
	if( !(arr_time=target->query_temp("robot/time")) ){
		write(who+ " 笷丁反, Τ瞒絬筁, ┪畍┪...\n");
		return 1;
	}
	write(who+ " 秨﹍丁: " +ctime(arr_time)+ "\n");
	write(who+ " 芠诡丁: Τ " +(time() - arr_time)/60+ " だ牧⊿氮癸\n");
	write(who+ " 拜肈: " +target->query_temp("robot/question") +"\n");
	write(who+ " 莱璶氮: " +target->query_temp("robot/answer") +"\n");
	return 1;
}

int robot_help(string arg)
{
	if(arg!="spirit")	return 0;
	write(@HELP
1. summon <ID>
2. setq <ID> <question>
3. seta <ID> <answer>
4. about <ID>
璝璶琩琘 player 琌 robot, 琵弘艶拜拜肈,  robot ︙, ︙
 say êㄇ杠, А穦癘魁Θ郎, 畍穦Τ琩癘魁矪瞶.
App, Wiz 胔好 robot Аノ弘艶, 叫絋﹚產砆ъㄓぇ玡琌矪
絤篈,  post 磞瓃薄.
HELP
	);
	return 1;
}

// say 氮, 20 min ず璝氮癸穦睲奔 temp mark  move ︓ snow
void relay_say(object me,string msg)
{
	int tmp;
	log_file("block_robot", sprintf("%s %12s %8s <%s>\n", 
		ctime(time()),
		me->query("id"),
		me->query_temp("robot/time")>0 ? 
			(time() - me->query_temp("robot/time"))/60+ " min" : " * min",
		msg,
	));

	if( (tmp=(time() - me->query_temp("robot/time"))/60) > 20 ){
		tell_object(me, 
"禬筁 " +tmp+ " だ牧⊿氮癸, 畍穦Τ矪瞶(郎), 璝Τ好某叫のΝは
莱, 冈瓃猵瞶パ. 璝璶 suicide 絤, 癘眔 post 硄畍, 玥穝絤à︹
砆ぃ璽砫. 璝璶瞒秨, 叫耞絬 15 だ牧\n"
		);
		return;
	}
	if( me->query_temp("robot/answer") ){
		if( strsrch(msg, me->query_temp("robot/answer"))>=0 ){
//		CHANNEL_D->do_channel( this_object(), "chat", "ê畍Τ, ㄓ厚畄.") );
			tell_object(me, "弘艶笵: 氮癸, ΩΤㄓ.\n弘艶, 淮钠钠.\n\n");
			if( me->move("/d/snow/inn_hall") ){
				tell_room(environment(me), me->name()+ "砆弘艶筁ㄓ.\n");
				log_file("block_robot", sprintf("%s %12s %8s 氮癸瞒秨\n",
					ctime(time()),
					me->query("id"),
					(int)(time() - me->query_temp("robot/time"))/60+ " min",
				));
				this_player()->delete_temp("robot/");	//clean robot record
				return;
			}
			tell_object(me, "弘艶笵: 翅,  ぃ笆, т腊Γр, 產ぃ恨.\n");
			return;
		}
	}
	tell_object(me, "弘艶笵: 钩氮岿, 临琌弧杠и钮ぃ来, и拜Ω:\n" +me->query_temp("robot/question")+ "\n");
}
