//block_robot.c	the npc in this room will ask player some question
//and log some data to file: robot_check

inherit ROOM;

void create()
{
	set("short","诀竟畄");
	set("long","\n
\t硂柑琌 ES2 诀竟畄, 狦砆癳硂柑, 
\têボ︽摸诀竟 (help robot).
\t璝眶, 叫氮诀竟弘艶拜杠, ┪т畍は莱.\n\n\n");
	set("no_fight", 1);
	set("objects", ([
		__DIR__"spirit": 1,
	]));
	setup();
}

void init()
{
	if(!wizardp(this_player()))
		add_action("do_quit", "quit");
}

int do_quit()
{
	write("╆簆, 瞷ぃ quit , 叫氮诀竟弘艶拜杠┪т畍は莱.\n");
	return 1;
}
