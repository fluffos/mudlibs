// demongorgon.c

#include <ansi.h>

inherit NPC;

void create()
{
        set_name( HIW "" NOR, ({ "demogorgon" }) );
        set_level(100);
        set_race("human"); 
       set("long",
                "    タ慌玡蔼ō逻蛤部\n"
                "┤炳タ溃眔碭齿ぃ筁ㄓみ柑Τ羘\n"
                "禗 е瞒秨 \n");

        set("age", 500);

        advance_stat("kee",900);
        advance_stat("gin",900);

        set_attr("str",35);
        set_attr("dex",42);
        set_attr("con",35);
         set_attr("spi",45);
        set_attr("cor",45);

        setup();

}

void start_shutdown()
{
        if( geteuid(previous_object()) != ROOT_UID ) return;

        message("system",
                HIR "\n钮ぱい肚ㄓ皚┤〩 ....\n\n"
                HIW     "" HIR "慌↖羘肚φず\n\n"
                        "\t\t稱璶㏑临Τきだ牧话е瞒秨\n\n"
                        "\t\tぃ礛杠狦︑︽璽砫°°\n\n" NOR,
                users() );
        call_out("countdown", 240, 61);
}

private void countdown(int sec)
{
        sec--;
        if( sec > 59) {
                message("system",
                        HIW "\n" HIR "慌↖羘肚秈φず\n\n"
                "\t\t临Τ" + chinese_number(sec) + "牧瞒秨\n\n"
                    "\t\tぃ璶㏑碞刚刚\n\n" NOR,
                        users() );
                call_out("countdown", 49, 11);
        }else if( sec > 0) {
                message("system",
                        HIW "\n" HIR "慌↖羘肚秈φず\n\n"
                                "\t\t临Τ" + chinese_number(sec) + "牧丁発\n\n"
                                "\t\tぃ稱碞话е発\n\n" NOR,
                        users() );
                call_out("countdown", 1, sec);
        }
        else {
                message("system",
                        HIW "\n" HIR "ノ极羘〩笵\n\n"
                            "\t\tぱ摆° 摆°  摆° \n\n" NOR,
                        users() );
                call_out("do_shutdown", 2);
        }
}

private void do_shutdown()
{
        message("system",
                HIW "\n\n" HIR "ノ极羘耻笵\n\n"
                HIW "\t\t硄 硄 ㎝ и  癬   夯  °°°° \n\n"
                HIR "\t\t羘拨ぱミㄨ跑眔﹀ぃ....泊玡ち常跑眔﹀...\n\n"
                        "\t\t┮Τち常俐丁炒....\n\n"
                        "\t\t礛泊玡琌堵穞....礚ゎ荷堵穞....\n\n" NOR,
                users() );
        shutdown(0);
}

void die()
{
        object ob;

        if( !ob = query_temp("last_damage_from") )
                ob = this_player(1);

        if( !ob ) return;

        message("system",
                HIR "\n\n钮羘盿帝极佩籔偿脋〩羘臫过俱ぱ\n\n"
                HIW "" HIR "糝白帝碿" + ob->short() + "и﹚穦厨こ°°°\n\n"
                        "礛笵堵︹礙㊣糞帝侥冻狠確圭繰\n\n" NOR,
                users() );
        
        destruct(this_object());
}
