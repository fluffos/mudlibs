// coin.c

inherit MONEY;

void create()
{
	set_name("窥", ({"coin", "coins", "coin_money" }));
	if( !clonep() ) {
		set("money_id", "coin");
		set("long", "硂琌瑈硄い虫︗程砯刽璶κゅ窥眔ㄢ蝗\n");
		set("unit", "ㄇ");
		set("material", "copper");
		set("base_value", 1);
		set("base_unit", "ゅ");
		set("base_weight", 3);
	}
	set_amount(1);
	setup();
}

