// fur_hat.c

#include <armor.h>

inherit F_HEAD_EQ;

void create()
{
	set_name("をブ碪", ({"fur hat", "hat"}));
	set_weight(1000);
	setup_head_eq();

	if( !clonep() ) {
		set("unit", "郴");
		set("long", "郴ぃ琌忱ブ临琌殳ブ羅籹碪\n");
                set("value",50);
		set("wear_as", "head_eq");
		set("apply_armor/head_eq", ([
			"armor" : 1,
		]) );
	}
	setup();	
}
