inherit ITEM;

nosave int decayed = 0;
nosave int decay_interval = 120;

void create()
{
    set_name("礚砰", ({ "corpse" }) );
    set("long", "硂琌ㄣ礚砰\n");
    set("unit", "ㄣ" );
    setup();
}

void
start_decay(int interval)
{
    if( interval < 1 ) interval = 0;

    decay_interval = interval;

    remove_call_out("decay");
    decayed = 0;
    call_out("decay", decay_interval * 2);
}

int is_corpse() { return decayed < 2; }
int is_character() { return decayed < 1; }

string short() { return name() + "(" + capitalize(query("id")) + ")"; }

void decay()
{
    switch(++decayed) {
        case 1:
            say( query("name") + "秨﹍籊年祇螟籇碿\n" );
            switch(query("gender")) {
                case "male":
                    set_name("籊年╧", ({ "corpse" }) );
                    break;
                case "female":
                    set_name("籊年", ({ "corpse" }) );
                    break;
                default:
                    set_name("籊年砰", ({ "corpse" }) );
                    break;
            }
            set("long", "硂ㄣ砰陪礛竒仅硂柑Τ琿丁タ床祇帝籊笵\n");
            call_out("decay", decay_interval);
            break;
        case 2:
            say( query("name") + "砆爱跑Θㄣ纄癌\n" );
            set_name("琝\爱纄癌", ({ "skeleton" }) );
            set("long", "硂捌纄癌竒仅硂柑\n");
            call_out("decay", decay_interval);
            break;
        case 3:
            say( "皚筁р" + query("name") + "てΘ癌η床\n" );
            destruct(this_object());
            break;
    }
}

int receive_object(object oob, int from_inventory) { return 1; }
