// flower_pill.c

inherit COMBINED_ITEM;

void create()
{
	set_name("", ({"flower pill", "pill"}));
	if( !clonep() ) {
		set("unit", "ㄇ");
		set("long",
			"琌贺獀励浮耺盽ǎうよぃ筁籹硑讽禣陈沸\n"
			"璶翴カ马禦眔\n");
		set("base_unit", "采");
		set("base_value", 150);
		set("base_weight", 5);
	}
	set_amount(1);
	setup();
}

int stuff_ob(object me)
{
	if( me->query_stat_maximum("food") - me->query_stat("food") < 5 )
		return notify_fail("▄竒嫉眔硈硂采媚ぃ\n");
	message_vision("$N采穞︹媚\n", me);
	me->consume_stat("water", 30);
	me->supplement_stat("food", 5);

	// TODO: implement medical function.

	add_amount(-1);

	return 1;
}
