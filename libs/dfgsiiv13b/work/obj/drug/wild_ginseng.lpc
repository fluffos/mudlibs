// wild_ginseng.c

inherit COMBINED_ITEM;

void create()
{
	set_name("偿鐇", ({"wild ginseng", "ginseng"}));
	if( !clonep() ) {
		set("unit", "ㄇ");
		set("long",
			"偿鐇琌贺約干珇癸弘常会Τ痲τ\n"
			"⊿Τぐ或陪捌ノ硄盽励端媚媚ぃ筁案焊Τ\n"
			"钡狝ノ琌狦耕ぃ陪帝\n");
		set("base_unit", "");
		set("base_value", 1500);
		set("base_weight", 400);
	}
	set_amount(1);
	setup();
}

int stuff_ob(object me)
{
	if( me->query_stat_maximum("food") - me->query_stat("food") < 50 )
		return notify_fail("▄竒嫉眔ぐ或狥﹁ぃ\n");
	message_vision("$N偿鐇い腪腪\n", me);
	me->supplement_stat("food", 50);
	me->heal_stat("gin", 5);
	me->heal_stat("kee", 5);
	me->heal_stat("sen", 5);
	add_amount(-1);

	return 1;
}
