// man.c

#include <npc.h>

inherit F_VILLAGER;

void create()
{
	set_name("隔", ({ "man" }) );
	set_race("human");
	set_level(2);
	set("long", "炊硄隔钩硂妓ぱ隔窱ǎ碭\n");
	setup();
	carry_money("coin", 30);
	carry_object("/obj/area/obj/cloth")->wear();
	carry_object("/obj/area/obj/shortsword")->wield();
}
