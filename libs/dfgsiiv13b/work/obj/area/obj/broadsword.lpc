// broadsword.c

#include <weapon.h>

inherit F_SWORD;

void create()
{
	set_name("溜糃", ({ "broadsword", "sword" }) );
	set_weight(10000);
	setup_sword(2, 12, 70, 1);

	if( !clonep() ) {
		set("wield_as", ({ "sword", "twohanded sword"}) );
		set("unit", "р");
		set("value", 5500);
		set("rigidity", 25);
		set("long", "рへ溜糃秖ぃ淮惠璶ぃ籑揣籖硂贺猌竟\n");
		set("wield_msg", "$N詜羘┾р溜糃搐もい\n");
	}
	setup();
}

void varify_template(object owner)
{
	int i = owner->query_level();
	
	ENHANCE_D->enhance_weapon(this_object(), i*i + 10, "糃");
}
