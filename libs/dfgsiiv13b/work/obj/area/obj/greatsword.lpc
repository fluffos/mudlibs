#include <weapon.h>

inherit F_SWORD;

void create()
{
    set_name("糃", "great sword", "sword" );
    set_weight(24000);
    setup_sword(3, 13, 100, 5);

    if( !clonep() ) {
        set("wield_as", "twohanded sword");
        set("unit", "р");
        set("value", 11000);
        set("rigidity", 25);
        set("long",
            "рきへ糃钩硂或エ糃琌璉璉パ籑\n"
            "筁Ё簙ㄏノ\n");
        set("wield_msg", "$N盢璉糃舗ц㊣羘┾р糃\n");
    }
    setup();
}

void varify_template(object owner)
{
    int i = owner->query_level();
    
    ENHANCE_D->enhance_weapon(this_object(), i*i + 10, "糃");
}
