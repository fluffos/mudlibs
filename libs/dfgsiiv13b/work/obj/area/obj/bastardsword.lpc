// bastardsword.c

#include <weapon.h>

inherit F_SWORD;

void create()
{
	set_name("糃", ({ "bastardsword", "sword" }) );
	set_weight(16000);
	setup_sword(3, 9, 80, 2);

	if( !clonep() ) {
		set("wield_as", ({ "twohanded sword", "sword" }) );
		set("unit", "р");
		set("value", 8500);
		set("rigidity", 25);
		set("long",
			"рきへ糃钩硂或エ糃琌璉璉パ籑\n"
			"筁Ё簙ㄏノ\n");
		set("wield_msg", "$N盢璉糃舗ц㊣羘┾р糃\n");
	}
	setup();
}

void varify_template(object owner)
{
	int i = owner->query_level();
	
	ENHANCE_D->enhance_weapon(this_object(), i*i + 10, "糃");
}
