// curved_blade.c

#include <weapon.h>

inherit F_BLADE;

void create()
{
	set_name("舠", ({ "curved blade", "blade" }) );
	set_weight(9000);
	setup_blade(2, 12, 60, 0);

	if( !clonep() ) {
		set("wield_as", "blade" );
		set("unit", "р");
		set("value", 4200);
		set("rigidity", 25);
		set("long", "硂琌贺э▆虫ō耕糴τ舠ノ揣辟璶ゑ虫\n");
	}
	setup();
}

void varify_template(object owner)
{
	int i = owner->query_level();
	
	ENHANCE_D->enhance_weapon(this_object(), i*i + 10, "");
}
