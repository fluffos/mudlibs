//t_whip.c
#include <weapon.h>
inherit F_WHIP;

void create()
{
	set_name("皑聾", ({ "horse whip","whip" }));
	set_weight(8000);
        setup_whip(3, 5, 40, 3);
	if( !clonep() ) {
		set("wield_as", ({ "whip" }));
		set("unit", "兵");
		set("value", 2000);
		set("long",
"兵碝皑聾, 堵, 絪猤骸猟膖, 聾Τ螟籇笵.\n"
		);
        }
	setup();
}
