// leather_boot.c

#include <armor.h>

inherit F_FEET_EQ;

void create()
{
	set_name("ブ祏箄", ({ "leather boots", "boots" }));
	set_weight(1000);
	setup_feet_eq();

	if( !clonep() ) {
		set("unit", "蛮");
		set("long", "硂琌蛮ブ籹祏箄癬ㄓΤㄇ侣\n");
		set("value", 400);
		set("wear_as", "feet_eq");
		set("apply_armor/feet_eq", ([
			"armor" : 1
		]) );
	}

	setup();
}
