// weirblade.c

#include <weapon.h>

inherit F_BLADE;

void create()
{
	set_name("", ({ "weirblade", "blade" }) );
	set_weight(15000);
	setup_blade(2, 14, 60, 0);

	if( !clonep() ) {
		set("wield_as", ({ "blade", "twohanded blade" }) );
		set("unit", "р");
		set("value", 6500);
		set("rigidity", 25);
		set("long", "玴辨τネ狦蛮も搐杠琌眏\n");
	}
	setup();
}

void varify_template(object owner)
{
	int i = owner->query_level();
	
	ENHANCE_D->enhance_weapon(this_object(), i*i + 10, "");
}
