// robe.c

#include <armor.h>

inherit F_CLOTH;

void create()
{
	set_name("ガ砊", ({ "robe" }) );
	set_weight(1000);
	setup_cloth();

	if( !clonep() ) {
		set("unit", "ン");
		set("value", 600);
		set("long", "甅炊硄粗ガ砊Τㄇη剐\n");
		set("wear_as", "cloth");
		set("apply_armor/cloth", ([
			"armor": 1,
		]));
	}

	setup();
}
