// longsword.c

#include <weapon.h>

inherit F_SWORD;

void create()
{
	set_name("糃", ({ "long sword", "sword" }) );
	set_weight(7500);
	setup_sword(2, 10, 50, 1);

	if( !clonep() ) {
		set("wield_as", "sword" );
		set("unit", "р");
		set("value", 4000);
		set("rigidity", 25);
		set("long", "рへ糃琌猌狶い盽ノ猌竟\n");
		set("wield_msg", "$N詜羘┾р糃搐もい\n");
	}
	setup();
}

void varify_template(object owner)
{
	int i = owner->query_level();
	
	ENHANCE_D->enhance_weapon(this_object(), i*i + 10, "糃");
}
