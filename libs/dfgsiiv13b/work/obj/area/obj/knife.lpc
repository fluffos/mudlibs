// knife.c

#include <weapon.h>

inherit F_DAGGER;

void create()
{
	set_name("", ({ "knife" }) );
	set_weight(900);
	setup_dagger(1, 14, 20, 0);

	if( !clonep() ) {
		set("wield_as", ({ "dagger", "secondhand dagger" }));
		set("unit", "р");
		set("value",70);
		set("long", "琡彩罻ㄓ钩琌╬硑た竟\n");
		set("rigidity", 15);
	}
	setup();
}
