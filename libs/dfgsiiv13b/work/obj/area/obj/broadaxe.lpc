// broadaxe.c

#include <weapon.h>

inherit F_AXE;

void create()
{
	set_name("狾", ({ "broadaxe", "axe" }) );
	set_weight(10000);
	setup_axe(2, 11, 100, 0);

	if( !clonep() ) {
		set("wield_as", ({ "axe", "twohanded axe" }) );
		set("unit", "р");
		set("value", 5000);
		set("rigidity", 25);
		set("long", "р狾秖帝龟↖ぃ筁狾琌讽糉甡\n");
	}
	setup();
}

void varify_template(object owner)
{
	int i = owner->query_level();
	
	ENHANCE_D->enhance_weapon(this_object(), i*i + 10, "");
}
