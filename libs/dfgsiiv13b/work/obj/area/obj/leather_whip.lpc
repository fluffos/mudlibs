// leather_whip.c

#include <weapon.h>

inherit F_WHIP;

void create()
{
	set_name("ブ聾", ({ "leather whip", "whip" }) );
	set_weight(2000);
	setup_whip(4, 5, 70, 0);

	if( !clonep() ) {
		set("wield_as", "whip");
		set("unit", "兵");
		set("value",1800);
		set("long", "兵へブ聾ノㄓ讽ㄏノ\n");
		set("rigidity", 15);
	}
	setup();
}
