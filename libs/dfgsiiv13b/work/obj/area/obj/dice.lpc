// dice.c

inherit ITEM;

void create()
{
	set_name("浑", ({ "dice"}));
	set_weight(3);
	if( !clonep() ) {
		set("unit", "采");
		set("value", 5);
		set("long",
			"采浑ノ roll 耏浑\n");
	}
	setup();
}

void init()
{
	add_action("do_roll", ({ "roll", "throw" }));
}

int do_roll(string arg)
{
	if( !id(arg) ) return 0;

	message_vision("$N浑耏浑簎簎氨ㄓ挡狦琌"
		+ (random(6)+1) + "翴\n", this_player());
	return 1;
}
