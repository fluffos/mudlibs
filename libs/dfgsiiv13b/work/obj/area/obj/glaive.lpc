// glaive.c

#include <weapon.h>

inherit F_BLADE;

void create()
{
	set_name("碍繷", ({ "glaive", "blade" }) );
	set_weight(9000);
	setup_blade(2, 10, 80, 0);

	if( !clonep() ) {
		set("wield_as", ({ "blade", "twohanded blade" }) );
		set("unit", "р");
		set("value", 6000);
		set("rigidity", 25);
		set("long",
			"碍繷琌贺璉玴痢ōτ璉疭玴瘤礛绊㏕瑻ノ秖\n玱琌ぃ淮\n");
	}
	setup();
}

void varify_template(object owner)
{
	int i = owner->query_level();
	
	ENHANCE_D->enhance_weapon(this_object(), i*i + 10, "");
}
