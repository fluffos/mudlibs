// belt.c

#include <armor.h>

inherit F_WAIST_EQ;

void create()
{
	set_name("竬盿", ({ "belt" }) );
	set_weight(100);
	setup_waist_eq();

	if( !clonep() ) {
		set("unit", "ン");
		set("value", 200);
		set("long",
			"兵ノㄓ︘壳竬盿ゑ耕絘璚┕┕ノ壳盿么︘祔稬\n"
			"Τ翴縩籛穦︾兵竬盿\n");
		set("wear_as", "waist_eq");
		set("apply_armor/waist_eq", ([
			"armor" :1,
		]));
	}

	setup();
}
