// shortsword.c

#include <weapon.h>

inherit F_SWORD;

void create()
{
	set_name("祏糃", ({ "short sword", "sword" }) );
	set_weight(4000);
	setup_sword(1, 15, 40, 1);

	if( !clonep() ) {
		set("wield_as", ({ "sword", "secondhand sword" }));
		set("unit", "р");
		set("value", 900);
		set("rigidity", 20);
		set("long", "р彩罻祏糃盿ō娩ňōノ猌竟\n");
		set("wield_msg", "$N┾р祏糃讽猌竟\n");
	}
	setup();
}

void varify_template(object owner)
{
	int i = owner->query_level();
	
	ENHANCE_D->enhance_weapon(this_object(), i*i + 10, "糃");
}
