
// pen.c ﹛掸
#include <weapon.h>

inherit F_DAGGER;

void create()
{
	set_name("﹛掸", ({ "pen" }));
	set_weight(3000);
	setup_dagger(3,8,80,3);

	if( !clonep() ) {
		set("wield_as", ({ "dagger", "secondhand dagger" }));
		set("unit", "唉");
		set("value", 3000);
		set("rigidity", 30);
		set("long", 
		"рノ弘疟硑﹛掸掸ōΘ堵︹\n"
		);
		set("wield_msg",
		"$N唉﹛掸搐も\n"
		);
	}
	setup();
}
