// pike.c

#include <weapon.h>

inherit F_PIKE;

void create()
{
	set_name("簀", ({ "long pike", "pike"}));
	set_weight(11000);
	setup_pike(2,11,60,1);

	if( !clonep() ) {
		set("wield_as", ({ "twohanded pike", "pike" }));
		set("unit", "膘");
		set("value", 6000);
		set("rigidity", 25);
		set("long",
"р簀繷ノ弘葵疟硑τΘ簀簀ō掸簀繷簀ō晃钡よ竕帝兵籑
盽盽ㄏノ猌竟\n"
		);
		set("wield_msg",
		"$Nノ蛮も眖ō┾膘簀搐も\n"
		);
	}
	setup();
}

void varify_template(object owner)
{
	int i = owner->query_level();
	
		ENHANCE_D->enhance_weapon(this_object(), i*i + 10, "簀");
}
