// axe.c

#include <weapon.h>

inherit F_AXE;

void create()
{
	set_name("繷", ({ "axe" }) );
	set_weight(10000);
	setup_axe(2, 12, 80, 0);

	if( !clonep() ) {
		set("wield_as", ({ "axe", "twohanded axe" }) );
		set("unit", "р");
		set("value", 2700);
		set("long", "硂琌р碝盽繷ノㄓ攫糀ノ\n");
		set("rigidity", 22);
	}
	setup();
}
