// vagabond.c

#include <npc.h>

inherit F_BANDIT;

void create()
{
	set_name("カか礚苦", ({ "vagabond" }));
	set_race("human");
	set_class("fighter");
	set_level(2);
	set_skill("unarmed", 5);
	set_skill("dodge", 3);
	set_skill("dagger", 7);

	set("age", 24);
	set("long", "骸羪碿︽碿礚苦簙程綼び\n");
	set("chat_chance", 6);
	set("chat_msg", ({
		"礚苦簙糑糑┣帝娩ぃ胔種╪帝\n",
		"礚苦簙杆璝礚ㄤㄆ妓ō娩礛ㄤぃ種疾\n",
		"礚苦簙ノ潸みよΑ徉徉惑礛┕硂娩紆 ... е跟\n",
	}));

	setup();
	carry_object(__DIR__"obj/knife")->wield();
	carry_object(__DIR__"obj/dice");
}
