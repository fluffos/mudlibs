//traveller.c

#include <npc.h>

inherit F_VILLAGER;

void create()
{
	set_name("筁隔", ({ "traveller" }) );
	set("unit", "︗");
	set("gender", "female");
	set_race("jiaojao");
	set_class("thief");
	set_attr("con",36);
	set_level(20);
	set("age", 19);
	set_skill("parry",50);
	set_skill("dodge",50);
	set_skill("blade",60);
	advance_stat("kee",100);
	set("long",
"︗︽︹, 骸羪流筁隔, ō玪杆, 繦璶隔.\n");
	set("chat_chance", 4);
	set("chat_msg", ({
"筁隔齿碭笵: ㊣ ㊣ .. 仓, 痷环.\n",
"筁隔仓量ぃ杠ㄓ.\n",
		(: command,"sweat":),
	}));
	setup();
	carry_money("silver", 30);
	carry_object(__DIR__"obj/cloth")->wear();
	carry_object(__DIR__"obj/whip")->wield();
}

int accept_fight(object ob)
{
	do_chat("筁隔揽揽蹭, 笵: ゴ裕, 常е仓陆临ゴ!\n");
	return 0;
}
