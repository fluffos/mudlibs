inherit BULLETIN_BOARD;

void create()
{
	set_name("XX狾", ({ "X board" }) );
	set("long", "Τ XX 狾");
	set("location", "/d/snow/X");
	set("board_id", "X");		//璝郎 abc.c 玥 X 恶 abc
	set("capacity", 30);		//狾, キ盽跋办 30 
	setup();
	replace_program(BULLETIN_BOARD);
}
//糶郎穦穐 /daemon/board 
//癘眔 location room い setup() 璶糶 load_object("/daemon/board/X");
