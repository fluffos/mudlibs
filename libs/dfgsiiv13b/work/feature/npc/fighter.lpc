// fighter.c

#include <attack.h>
#include <statistic.h>

// prototypes
mixed do_chat(mixed chat);
varargs string name(int raw);
void kill_ob(object ob);
varargs int is_fighting(object ob);
int query_level();
string rank(string politeness);

int accept_fight(object ob)
{
    if( is_fighting() ) {
        int differ;

        differ = query_level() - (int)ob->query_level();
        if( differ > 10 ) {
            do_chat( name() + "帝弧笵糑糑 ... ㄓ腊も盾\n");
            return 1;
        } else if( differ > 5 ) {
            do_chat( name() + "弧笵糑糑 ... " + rank("self") + "さぱ璶ㄓ硅阑渤\n");
            return 1;
        } else {
            do_chat( name() + "弧笵硂︗" + ob->rank("respectful") + "螟笵琌稱秤\n");
            return 0;
        }
    }

    if( ob->is_fighting() ) {
	do_chat( name() + "弧笵ち絉猌美临琌虫ゴ縒矮и卑皚\n");
	return 0;
    }

    if( query_stat_current("kee") < query_stat_maximum("kee") ) {
	do_chat( name() + "弧笵单穦ㄠ琵и齿\n");
	return 0;
    }

    do_chat( name() + "弧笵ぃ幢叫界┷\n");
    return 1;
}

void accept_kill(object ob)
{
    do_chat( name() + "弧笵" + rank("self") + "籔硂︗" + ob->rank("respectful")
        + "钩礚礚こ或 ...\n");
}

void accept_negotiation(object who, string key)
{
    switch(key) {
    case "peace":
        if( !is_killing(who) ) {
            do_chat( name() + "癭ō临搂弧笵弧弧\n");
            remove_enemy(who);
            who->remove_enemy(this_object());
        }
        else do_chat( name() + "弧笵紀杠ぶ弧さらぃ琌獽琌и\n");
        return;
    case "mercy":
        if( is_killing(who) ) {
            do_chat( name() + "弧笵琂礛さぱ碞那\n");
            remove_killer(who);
            remove_enemy(who);
            who->remove_killer(this_object());
            who->remove_enemy(this_object());
	    // add by dragoon
	    if( who->query_class() == "fighter" )
                who->gain_score("martial fame", - who->query_level() * 10);
        }
    }
}
