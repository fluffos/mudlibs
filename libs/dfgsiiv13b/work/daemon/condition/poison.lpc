inherit CONDITION;

private void create()
{
    seteuid(getuid());
    DAEMON_D->register_condition_daemon("poison");
}

/*
    硂い瑀痝琌┦ノれㄓ﹚竡瑀┦借穦洛砃禘耞
    瑀┦借秨媚秆瑀

    τē︑パ﹚竡瑀き︽妮┦だ摸ㄑ把σ

     - 膓ぇ瑀–Ω祇穦穕端篈
    れ - れぇ瑀い硂摸瑀ぇ┦穦
     - 潮┦ぇ瑀–Ω祇穦穕端弘篈
     - 锭┦ぇ瑀–Ω祇穦穕端篈
     - 挛矰ぇ瑀い硂摸瑀ぇ籑穦

    贺瑀硄盽パき︽いㄢ贺┦借篶Θи﹚竡琘贺矰瑀琌[ 10,  10]
    ノ媚獀励硂贺矰瑀碞惠璶ノ玤㎝舱ㄓ癸惠璶贺┦借[れ 10,
     10]媚秆瑀

    い瑀痝﹚竡碭把计

    duration	- 尿丁–祇Ω碞搭搭 0 瑀┦碞ア
    damage	- 瑀┦祇┮Ιネ㏑翴计
		  端甡琌 update_condition いノ妮篊┦端甡
*/

void
condition_update(object me, string cnd, mixed cnd_data)
{
    // Τ living ネ㏑篈穦瑀紇臫
    if( me->query("life_form") != "living"
    ||	!mapp(cnd_data)
    ||	(cnd_data["duration"]--) < 1 ) {
	me->delete_condition(cnd);
	return;
    }

    if( cnd_data["damage"] )
    {
	int dam = cnd_data["damage"];

	tell_object(me, "い瑀祇\n");

	dam -= random( me->query_temp("apply/resist_poison") );
	if( dam < 0 ) dam = 0;

	me->consume_stat("HP", dam);
	if( cnd_data[""] > 0 ) me->damage_stat("gin", cnd_data[""] );
	if( cnd_data[""] > 0 ) me->damage_stat("kee", cnd_data[""] );
        if( cnd_data[""] > 0 ) me->damage_stat("sen", cnd_data[""] );
    }
    me->set_condition("poison", cnd_data);
}
