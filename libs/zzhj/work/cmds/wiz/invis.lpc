// invis.c

inherit F_CLEAN_UP;
inherit F_CMD;

void main(object me, string arg)
{
	object link;

	seteuid(getuid());
	if( (me!=this_player(1)) || !objectp(link = me->link()) ) return 0;

	if( !arg ) 
		link->set("invis", (int)link->query("invis") == 0 );
	else if( arg=="on" )
		link->set("invis", 1);
	else if( arg=="off" )
		link->set("invis", 0);
	else
		return notify_fail("指令格式﹕invis [on|off]");

	write("Ok。\n");
	return 1;
}
