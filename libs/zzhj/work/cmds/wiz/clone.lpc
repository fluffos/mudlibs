// clone.c

#include "/doc/help.h"

inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string file)
{
	object obj;
	string err, msg;

	seteuid( getuid(me) );

	if (!file) file = me->query("cwf");
	if (!file)
		return notify_fail("你要複製什麼物件﹖\n");

	file = resolve_path(me->query("cwd"), file);
	if( sscanf(file, "%*s.lpc") != 1 ) file += ".lpc";
	me->set("cwf", file);

	if( file_size(file) < 0 )
		return notify_fail("沒有這個檔案(" + file + ").\n");

	if( sscanf( file, "/std/%*s" ) )
		return notify_fail("無法複製用以繼承的標準物件.\n");

	if( !find_object(file) ) {
		err = catch(call_other(file, "???"));
		if (err) {
			write("載入失敗﹕" + err + "\n");
			return 1;
		}
	}

	err = catch(obj = new(file));

	if (err) {
		write("複製失敗﹕" + err + "\n");
		return 1;
	}

	if( !stringp(msg = me->query("env/msg_clone")) )
		msg = "只見$N伸手凌空一指, 變出了$n.\n";

	if( obj->is_character() || obj->is_vehicle() || obj->is_space_ship() ) { 
		if( obj->move(environment(me)) ) {
			write(obj->query("name") + "複製成功, 放在這個房間.\n");
		        message_vision(msg + "\n", me, obj);
			if( obj->is_space_ship() ) 
				obj->give_heart_beat(1);
			return 1;
		}
	}
	if( obj->move(me) ) {
		write(obj->query("name") + "複製成功, 放在你的物品欄.\n");
	        message_vision(msg + "\n", me, obj);
		return 1;
	}

	destruct(obj);
	return notify_fail("無法複製不能移動的物件(" + file + ").\n");
}

int help(object me)
{
  write(@HELP
指令格式 : clone <檔名>

利用此指令可複製任何能移動之物件 (含 NPC ).

注意 !! 除了 /d 及 /obj 以下的物件外, 不准複製其他的物件.
尤其是 /std 下的標準物件, 一旦複製會造成極嚴重的後果. 
HELP
    );
    return 1;
}
