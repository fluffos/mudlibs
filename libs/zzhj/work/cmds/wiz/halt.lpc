// halt.c

#include "/doc/help.h"
inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string arg)
{
	object target_ob;
	string target;

	if( !arg ) {
		if( !me->is_fighting() )
			return notify_fail("你現在並沒有在戰鬥。\n");
		me->remove_all_killer();
		me->delete("killer");
		message_vision("$N用巫師的神力停止了這場打鬥。\n", me);
		write("Ok.\n");
		return 1;
	}

	if( arg && sscanf( arg, "%s", target) != 0 ) {
		target_ob = present( target, environment( me));

		if( !target_ob ) return notify_fail("這裡沒有你欲停止的戰鬥目標.\n");
		if( !target_ob->is_fighting() ) return notify_fail("那個人不在戰鬥中.\n");

		target_ob->remove_all_killer();
		target_ob->delete("killer");
		message_vision("$N 用巫師的神力停止了這場戰鬥.\n", me);
		write("Ok.\n");
		return 1;
	}
}

int help(object me)
{
   write(@HELP
指令格式: halt
	  halt <對象>

可以停止所有與你(妳)有關, 或別人的戰鬥。

參考: kill, adv, back
HELP
   );
   return 1;
}
