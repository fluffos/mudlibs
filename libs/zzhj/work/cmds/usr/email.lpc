// email.c
// Change user's email address data.
// Author:	Spock @ FF
// Last modified by Spock @ FF	97.Sep.5.

#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_CMD;

int help( object me );

int main(object me, string arg)
{
	object ob;

	if( !arg ) {
		help( me );
		return 1;
	}
	if( strlen(arg) > 100 )
		return notify_fail("您輸入的電子郵件信箱地址太長了.\n");

	ob = me->link();
	ob->set("email", arg );
	ob->save();

	write("Ok.\n");
	return 1;
}

int help(object me)
{
        write(@HELP
指令格式 : email <您的電子郵件信箱地址>
 
這個指令可以讓您更改自己的電子郵件信箱地址.

參考: finger, cname, profile, signature
HELP
        );
        return 1;
}
