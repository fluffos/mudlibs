// uptime.c
// Display how much time mudlib runs from last reboot.
// Original ES 2 command.
// Last modified by Spock @ FF	97.Sep.5. 

inherit F_CLEAN_UP;
inherit F_CMD;

// This command is also called by LOGIN_D, so we don't want it use 
// arguments.
int main()
{
	int t, d, h, m, s;
	string time;

	t = uptime();
	s = t % 60;		t /= 60;
	m = t % 60;		t /= 60;
	h = t % 24;		t /= 24;
	d = t;

	if(d) time = chinese_number(d) + "天";
	else time = "";

	if(h) time += chinese_number(h) + "小時";
	if(m) time += chinese_number(m) + "分";
	time += chinese_number(s) + "秒";

	write("The Final Frontier 已經執行了" + time + "\n");
	printf("[ 現在時間 ] "+ CHINESE_D->chinese_date( time(), 1 ) + "\n");
	return 1;
}

int help(object me)
{
	write(@HELP
指令格式 : uptime
 
這個指令告訴你 The Final Frontier 已經開始執行了多久時間.
以及現在的時間 [中原標準時間, 即格林威治時間 + 8 ].

參考: time
HELP
    );
    return 1;
}
