// suicide.c

#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_CMD;

private void check_password(string passwd, object me, int forever);

int main(object me, string arg)
{
	seteuid( getuid() );
	if( me->is_busy() )
		return notify_fail("你上一個動作還沒完成.\n");

	if( !arg ) {
		message_vision(CYN "$N " CYN "對人生, 對這個世界徹底絕望了, 引頸自刎了.\n" NOR, me );
		return 1;
	}

	if( arg!="-f" ) 
		return notify_fail("您是要永遠死掉 ?\n");

	write(
		"如果您選擇永遠死掉的自殺方式, 這個人物的資料就永遠刪除了, 請務必\n"
		"考慮清楚, 確定的話請輸入您的密碼:");
	input_to("check_password", 1, me, 1);
	return 1;
}

private void check_password(string passwd, object me, int forever)
{
	object link_ob;
	string old_pass;

	seteuid( getuid() );
	link_ob = me->link();
	old_pass = link_ob->query("password");
	if( crypt(passwd, old_pass)!=old_pass ) {
		write("密碼錯誤 !\n");
		return;
	}

	if (forever) {
	link_ob = me->link();
	if( !link_ob ) return 0;

	log_file("static/SUICIDE",
		sprintf("%s commits a suicide on %s\n", geteuid(me), ctime(time())) );

	rm( link_ob->query_save_file() + __SAVE_EXTENSION__ );
	rm( me->query_save_file() + __SAVE_EXTENSION__ );
		write("\n永別了...\n");
	tell_room(environment(me), me->name() +
		"真的自殺了, 以後你再也看不到這個人了. \n", ({me}));
	destruct(me);
	return 0;
	}
}

int help (object me)
{
        write(@HELP
指令格式: suicide [-f]
 
如果因為某種原因你不想活了, 你可以選擇自殺.
自殺分兩種:
 
suicide    : 作出自殺的動作.
suicide -f : 永遠的除去玩家資料, 系統會要求你
             輸入密碼以確認身份.
 
請慎重選擇.
 
HELP
);
        return 1;
}
