// describe.c
// Change user's long description.
// Author:	Spock @ FF
// Last modified by Spock @ FF	97.Sep.5.

#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string arg)
{
	if( !arg ) {
		if( me->query("long") )
			return notify_fail("目前對您自己的描述是:\n" + 
				me->query("long") + "\n" );
		else return notify_fail("目前您沒有設定個人的敘述.\n");
	}

	if( arg == "-d" ) {
		me->delete("long");
		return 1;
	}
	if( sizeof( explode( arg, "\n") ) > 8 )
		return notify_fail("請將您對自己的描述控制在八行以內。\n");

	arg = CHINESE_D->ansi_color( arg );

	me->set("long", arg);
	write("Ok.\n");
	return 1;
}

int help()
{
	write(@TEXT
指令格式﹕desc <描述>
	  desc -d

這個指令讓你設定當別人用 look 指令看你時, 對你的描述. 通常當
你的描述超過一行時可以用 to describe  的方式來輸入, 不過請將
您的敘述控制在八行之內. 另外, 本指令提供彩色控制碼, 詳情請參
考 nick 指令.

如果使用 -d 的參數, 則會刪除你設定的個人描述.

參考: nick, cname, finger, email, profile, signature
TEXT
	);
	return 1;
}
