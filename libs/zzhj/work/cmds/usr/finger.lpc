// finger.c
// Display a player's personal data.
// Original ES 2 command.
// Last modified by Spock @ FF	97.Sep.5.

inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string arg)
{
	if( !arg ) {
		if( !wizardp(me) )
			return notify_fail("請您指定欲查詢的玩家代號\n");
		write( FINGER_D->finger_all() );
	} else {
		write( FINGER_D->finger_user(arg, me) );
	}
	return 1;
}

int help(object me)
{
  write(@HELP
指令格式 : finger [使用者姓名]
 
這個指令, 如果沒有指定使用者姓名, 會顯示出所有正在線上玩家
的連線資料. 反之, 則可顯示有關某個玩家的連線, 權限等資料.
 
see also : who, cname, email, profile
HELP
    );
    return 1;
}
 
