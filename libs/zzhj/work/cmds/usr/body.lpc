// body.c
// Display body status.
// Author: Spock @ FF
// Last modified by Spock	97.Sep.12.

#include <ansi.h>
#include <combat.h>

inherit F_CLEAN_UP;
inherit F_CMD;

void create() { seteuid(ROOT_UID); }

int main(object me, string arg)
{
	object ob;
        string line, str, *limbs, limb;
        int *limbs_hit, *limbs_eff_hit, *limbs_max_hit;
        int limb_hit, limb_eff_hit, limb_max_hit, j;
	int sq;
	string color;
	int *limb_protect;

	seteuid(getuid(me));

	if(!arg)
		ob = me;
	else if (wizardp(me)) {
		ob = present(arg, environment(me));
		if (!ob) ob = find_player(arg);
		if (!ob) ob = find_living(arg);
                if (!ob) return notify_fail("你要察看誰的狀態 ?\n");
	} else
                return notify_fail("只有系統管理員能察看別人的狀態.\n");

        line = sprintf(" %s  一%s%s歲的%s%s.\n",
		ob->short(),
		ob->query("unit"),
		chinese_number(ob->query("age")),
		ob->query("gender"), 
		ob->query("race") );

        limbs = ob->query("limbs");
        limbs_hit = ob->query("limbs_hit");
        limbs_eff_hit = ob->query("limbs_eff_hit");
        limbs_max_hit = ob->query("limbs_max_hit");

	for( j = 0; j < sizeof( ob->query("limbs")); j++ ) {
		limb = limbs[j];
		limb_hit = limbs_hit[j];
		limb_eff_hit = limbs_eff_hit[j];
		limb_max_hit = limbs_max_hit[j];
		line += sprintf(
			" [%s] ", limb );

		sq = limb_eff_hit*25/limb_max_hit;
		if( sq < 0 ) sq = 0;
		if( sq >= 0 && sq < 8 ) color = HIR;
		if( sq >= 8 && sq < 14 ) color = HIY;
		if( sq >= 14 ) color = GRN;

		line += "/cmds/usr/score.lpc"->tribar_graph( limb_hit, limb_eff_hit, limb_max_hit, color );
		line += sprintf("   ( %d/%d/%d )\n",
			limb_hit, limb_eff_hit, limb_max_hit);
	}

	line +=   " 身體各部護甲強度 :\n"
		+ "              類別 │  傳統   動能   光學   粒子   爆破\n"
		+ "       ──────┼──────────────────\n";

	for( j = 0; j < sizeof( ob->query("limbs") ); j++ ) {
		line += sprintf("        %10s │  %4d   %4d   %4d   %4d   %4d\n",
				( ob->query("limbs") )[j],
				ob->query_temp( sprintf("protect/traditional/%d", j ) ),
				ob->query_temp( sprintf("protect/projectile/%d", j ) ),
				ob->query_temp( sprintf("protect/optical/%d", j ) ),
				ob->query_temp( sprintf("protect/high_energy/%d", j ) ),
				ob->query_temp( sprintf("protect/explosive/%d", j ) ),
			);
	}

	write(line);
	return 1;
}

int help(object me)
{
	write(@HELP
指令格式 : body
           body <對象名稱>          (醫師、巫師專用)

這個指令可以顯示你(妳)或指定對象(含怪物)的身體狀況.
基本資料的設定請參閱 'help setup'.

只有醫師、巫師或是持有醫療儀器的人才看得到詳細的身體狀況.

參考 : hp, score
HELP
    );
    return 1;
}
