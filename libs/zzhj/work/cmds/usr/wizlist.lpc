// wizlist.c
// List all wizards of this mud.
// Original ES 2 command.
// Last modified by Spock @ FF	98.Jul.14.

#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string arg)
{
	string *list;
	string str;
	string *admin = ({}), *arch = ({}), *wizard = ({}),
		*apprentice = ({}), *immortal = ({}), *unknown = ({});
	int i, end;

	str = "  " + MUD_NAME + " 目前的巫師有﹕
==============================================================================\n";
//	list = sort_array(SECURITY_D->query_wizlist(), 1);
	list = SECURITY_D->query_wizlist();
	

	for( i = 0; i < sizeof( list ); i++ ) {
		switch( SECURITY_D->get_status( list[i] ) ) {
			case "(admin)":
				admin += ({ list[i] });
				break;
			case "(arch)":
				arch += ({ list[i] });
				break;
			case "(wizard)":
				wizard += ({ list[i] });
				break;
			case "(apprentice)":
				apprentice += ({ list[i] });
				break;
			case "(immortal)":
				immortal += ({ list[i] });
				break;
			default:
				unknown += ({ list[i] });
		}
	}

	str += HIW 
"【壹級巫師】【壹級工友】";
	if( admin ) {
		end = sizeof( admin );
		for( i = 0; end; i++ ) {
			end--;
			str += sprintf("%-12s%s", admin[i], 
				( (i % 4 == 3) && ( end ) ) 
					? "\n			" : "");
		}
	}
	str += "\n" + HIY +
"【貳級巫師】【貳級工友】";
	if( arch ) {
		end = sizeof( arch );
		for( i = 0; end; i++ ) {
			end--;
			str += sprintf("%-12s%s", arch[i], 
				( (i % 4 == 3) && ( end ) ) 
					? "\n			" : "");
		}
	}
	str += "\n" + HIG +
"【參級巫師】【參級工友】";
	if( wizard ) {
		end = sizeof( wizard );
		for( i = 0; end; i++ ) {
			end--;
			str += sprintf("%-12s%s", wizard[i], 
				( (i % 4 == 3) && ( end ) ) 
					? "\n			" : "");
		}
	}
	str += "\n" + HIC +
"【實習巫師】【實習工友】";
	if( apprentice ) {
		end = sizeof( apprentice );
		for( i = 0; end; i++ ) {
			end--;
			str += sprintf("%-12s%s", apprentice[i], 
				( (i % 4 == 3) && ( end ) ) 
					? "\n			" : "");
		}
	}
	str += "\n" + HIM +
"【見習巫師】【見習工友】";
	if( immortal ) {
		end = sizeof( immortal );
		for( i = 0; end; i++ ) {
			end--;
			str += sprintf("%-12s%s", immortal[i], 
				( (i % 4 == 3) && ( end ) ) 
					? "\n			" : "");
		}
	}
	str += "\n" + HIB +
"【幽靈巫師】【幽靈工友】";
	if( unknown ) {
		end = sizeof( unknown );
		for( i = 0; end; i++ ) {
			end--;
			str += sprintf("%-12s%s", unknown[i], 
				( (i % 4 == 3) && ( end ) ) 
					? "\n			" : "");
		}
	}
	write( str + "\n" );
	return 1;
}

int help(object me)
{
write(@HELP
指令格式 : wizlist

用途: 列出目前所有的巫師名單.

參考: finger, who
HELP
     );
     return 1;
}
