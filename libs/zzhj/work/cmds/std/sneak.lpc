// sneak.c
// Go into sneak status.
// Author: Spock @ FF	97.Nov.29.
// Last modified by Spock @ FF	97.Nov.29.

inherit F_CLEAN_UP;
inherit F_CMD;

int help( object me );

int main( object me, string arg )
{
	if( me->query("position") == "sleep" )
		return notify_fail("你仍在睡夢中.\n");

        if( me->query_time_unit() <= 0 )
                return notify_fail("你的動作不夠快 !\n");

	if( this_player()->is_busy() )
		return notify_fail("你上一個動作還沒有完成.\n");

	if( me->query_skill("sneak") < 10 )
		return notify_fail("你還抓不到訣竅, 無法潛行.\n");

	if( !me->query_temp("apply/sneak") ) {
		me->set_temp("apply/sneak", COMBAT_D->skill_power( me, "sneak" ) );
		write("你趁著無人注意之時, 悄悄地潛藏起來.\n");
	}
	else {
		me->delete_temp("apply/sneak");
		write("你若無其事地從暗處現身.\n");
	}

	return 1;
}
