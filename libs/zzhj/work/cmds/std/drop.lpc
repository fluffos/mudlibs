// drop.c
// Drop something.
// Original ES II command.
// Last modified by Spock @ FF   97.Feb.6.

inherit F_CLEAN_UP;
inherit F_CMD;

int do_drop(object me, object obj);

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
	object obj, *inv, obj2;
	int i, amount;
	string item;

	if( me->query("position") == "sleep")
		return notify_fail("你仍在睡夢中.\n");

        if( me->query_time_unit() <= 0 )
                return notify_fail("你的動作不夠快 !\n");

	if(!arg) return notify_fail("你要丟棄什麼東西﹖\n");

	if(sscanf(arg, "%d %s", amount, item)==2) {
		if( !objectp(obj = present(item, me)) )
			return notify_fail("你身上沒有這樣東西。\n");
		if( stringp(obj->query("no_drop")) )
			return notify_fail( (string)obj->query("no_drop") );
		if( !obj->query_amount() )
			return notify_fail( obj->name() + "不能被分開丟棄。\n");
		if( amount < 1 )
			return notify_fail("東西的數量至少是一個。\n");
		if( amount > obj->query_amount() )
			return notify_fail("你沒有那麼多的" + obj->name() + "。\n");
		else if( amount == (int)obj->query_amount() )
			return do_drop(me, obj);
		else {
			obj->set_amount( (int)obj->query_amount() - amount );
			obj2 = new(base_name(obj));
			obj2->set_amount(amount);
			return do_drop(me, obj2);
		}
	}

	if(arg=="all") {
		inv = all_inventory(me);
		for(i=0; i<sizeof(inv); i++) {
			do_drop(me, inv[i]);
			me->time_unit_loss( 1 );
		}
		write("Ok.\n");
		return 1;
	}

	if(!objectp(obj = present(arg, me)))
		return notify_fail("你身上沒有這樣東西。\n");
	return do_drop(me, obj);
}

int do_drop(object me, object obj)
{
	mixed no_drop;

	if( no_drop = obj->query("no_drop") ) {
		tell_object( me, stringp(no_drop) ? no_drop : obj->query("name") + "這樣東西不能隨意丟棄.\n");
		return 0;
	}

	if( obj->query("equipped") ) {
		tell_object( me, obj->query("name") + "這樣東西正在使用.\n" );
		return 0;
	}

	if (obj->move(environment(me))) {
		if( obj->is_character() )
			message_vision("$N 將 $n 從背上放了下來, 躺在地上.\n", me, obj);
		else {
			message_vision( sprintf("$N 丟下一%s%s.\n", obj->query("unit"),
				obj->identify( me, obj) ? 
					obj->name() : "不知名的物品"), me);
			if( wizardp( me ) ) {
				obj->set("wizard/drop", getuid( me ) );
				log_file( "INV",
					sprintf("%s(%s) 扔掉 %s.(%s) %s %s\n",
					me->name(), capitalize(geteuid(me)),
					obj->name(), base_name( obj), base_name(environment( me )), 
				ctime( time()) ));
			}
		}
		me->time_unit_loss( 2 );
		return 1;
	}
	return 0;
}

int help(object me)
{
	write(@HELP
指令格式: drop <物品名稱>
	  drop all
時間消耗: 每件物品 2 單位, 使用 all 則每件 1 單位.
 
這個指令可以讓你丟下你所攜帶的物品.
 
HELP
    );
    return 1;
}
 
