// follow.c
// Follow someone's movement.
// Original ES II command.
// Last modified by Spock @ FF   97.Feb.6.

inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string arg)
{
	object ob;

	if( me->query("position") == "sleep")
		return notify_fail("你仍在睡夢中.\n");

        if( me->query_time_unit() <= 0 )
                return notify_fail("你的動作不夠快 !\n");

	if( !arg ) return notify_fail("指令格式: follow <某人> | none\n");

	if( arg=="none" )
		if( me->query_leader() ) {
			me->set_leader(0);
			write("Ok.\n");
			return 1;
		} else {
			write("你現在並沒有跟隨任何人.\n");
			return 1;
		}

	if( !objectp(ob = present(arg, environment(me))) )
		return notify_fail("這裡沒有 " + arg + ".\n");

	if( !ob->is_character() && !ob->is_vehicle())
		return notify_fail("什麼 ? 跟隨...." + ob->name() + " ?\n");

	if( ob == me ) {
		if( me->query_leader() ) {
			me->set_leader(0);
			write("Ok.\n");
			return 1;
		} else {
			write("你現在並沒有跟隨任何人。\n");
			return 1;
		}
	}

	me->set_leader( ob );
	message_vision("$N 決定開始跟隨 $n 一起行動.\n", me, ob);

	return 1;
}

int help (object me)
{
        write(@HELP
指令格式: follow [<生物> | none]
時間消耗: 無時間消耗.
 
這個指令讓你能跟隨某人、某生物或載具 (當然, 你得跟得上載具才行).
如果輸入 follow none 或自己的名字則停止跟隨.
 
HELP
);
        return 1;
}
