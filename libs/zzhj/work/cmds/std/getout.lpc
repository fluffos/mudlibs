// getout.c
// Get off from a vehicle.
// Author: Spock @ FF
// Last modified by Spock @ FF   97.Feb.6.

#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_CMD;

int do_getout( object me, object env, object dest);

void create() { seteuid(getuid()); }

int main( object me)
{
	object env, dest;
	string msg;

	if( me->query("position") == "rest" )
		return notify_fail("你得先站起身子才行.\n");

	if( me->query("position") == "sleep" )
		return notify_fail("你仍在睡夢中.\n");

        if( me->query_time_unit() <= 0 )
                return notify_fail("你的動作不夠快 !\n");

	if( me->is_busy() )
		return notify_fail("你上一個動作還沒有完成 !\n");

	env = environment( me);
		if( !env->is_vehicle()) return notify_fail("你不在任何載具中.\n");

	dest = environment( env);
		if( !dest) return notify_fail("你無法離開載具.\n");

	if( (int)env->query_temp("lock") == 1 ) {
		msg = env->name() + " 的門已經鎖上了.\n";
		return notify_fail( msg );
	}

	return do_getout(me, env, dest);
}
	
int do_getout( object me, object env, object dest)
{
	message_vision( sprintf("$N 從一%s %s 走出來.\n", 
			env->query("unit"), env->query("name")), me);
	if( me->move( dest) ) {
		if( me->is_fighting() ) me->start_busy(1);
		message_vision( sprintf("$N 離開這%s %s.\n", 
				env->query("unit"), env->query("name")), me);
		if( me->query_temp("command")) me->delete_temp("command");
		me->set_temp("location", env->query_temp("location"));
		me->time_unit_loss( 2 + ( 25 - me->query("dex")) / 5 );
		return 1;
	}
	else return 0;
}

int help(object me)
{
	write(@HELP
指令格式: getout
時間消耗: 2 單位 + 敏捷加成.
 
這個指令可以讓您離開正在搭乘的載具.
HELP
    );
    return 1;
}
 
