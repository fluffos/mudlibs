// open.c
// Open a door which is not locked.
// Original ES II command
// Last modified by Spock @ FF   97.Feb.6.

#include <room.h>

inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string arg)
{
	mapping doors;
	string *dirs, dir;
	int i;

	if( me->query("position") == "rest" )
		return notify_fail("你得先站起身子才行.\n");

	if( me->query("position") == "sleep" )
		return notify_fail("你仍在睡夢中.\n");

        if( me->query_time_unit() <= 0 )
                return notify_fail("你的動作不夠快 !\n");

	if( !arg ) return notify_fail("你要打開什麼﹖\n");

	doors = environment(me)->query_doors();
	if( mapp(doors) ) {
		dirs = keys(doors);
		if( member_array(arg, dirs)!=-1 ) dir = arg;
		else for(i=0; i<sizeof(dirs); i++)
			if( arg==doors[dirs[i]]["name"] || member_array(arg, doors[dirs[i]]["id"])!=-1 ) {
				dir = dirs[i];
				break;
			}
		if( !dir ) return notify_fail("你要打開什麼﹖\n");
	
		me->time_unit_loss( 4 );
		if( environment(me)->open_door(dir) ) {
			message_vision("$N將" + doors[dir]["name"] + "打開。\n", me);
			return 1;
		}
	}

	return 0;
}

int help(object me)
{
        write(@HELP
指令格式: open <door> 或 <方向>
時間消耗: 4 單位.
 
這個指令可以讓你打開門.
 
參考: close, lock, unlock
HELP
    );
    return 1;
}
