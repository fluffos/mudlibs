// vl.c
// Look outside in the vehicle...:P
// Author: Spock @ FF
// Last modified by Spock @ FF   97.Feb.6.

#include <room.h>
#include <ansi.h>
#include <localtime.h>

inherit F_CLEAN_UP;
inherit F_CMD;

#define LOOK_CMD	"/cmds/std/look.lpc"

int main(object me, string arg)
{
	object obj, env;
	int result;

	if( me->query("position") == "sleep" )
		return notify_fail("你仍在睡夢中.\n");

      if( me->query_time_unit() <= 0 )
              return notify_fail("你的動作不夠快 !\n");

	if( !environment( me )->is_vehicle() ) return notify_fail("你並不在載具中.\n");

	if( !arg ) result = LOOK_CMD->look_room( me, environment( environment( me ) ), "vl" );
	else if( obj = present( arg, environment( environment( me ) ) ) ) {
		if( obj->is_character() ) result = LOOK_CMD->look_living( me, obj, "vl" );
		else result = LOOK_CMD->look_item( me, obj, "vl" );
	} else
		result = LOOK_CMD->look_room_item( me, arg, "vl" );

	me->time_unit_loss( 1 );
	return result;
}

int help (object me)
{
	write(@HELP
指令格式: vl [<物品>|<生物>|<方向>]
時間消耗: 1 單位
 
這個指令讓你查看載具之外的環境、某件物品、生物、或是方向.
 
參考: look, sl
HELP
);
	return 1;
}
