// unwield.c
// Unwield a weapon.
// Original ES II command.
// Last modified by Spock @ FF   97.Feb.6.

inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string arg)
{
	object ob, *inv;
	string str;
	int i;

	if( me->query("position") == "sleep" )
		return notify_fail("你仍在睡夢中.\n");

        if( me->query_time_unit() <= 0 )
                return notify_fail("你的動作不夠快 !\n");

	if( !arg ) return notify_fail("你要放下什麼武器 ?\n");

	if( !objectp(ob = present(arg, me)) )
		return notify_fail("你身上沒有這個武器.\n");

	if( (string)ob->query("equipped")!="wielded" )
		return notify_fail("你並沒有裝備這個武器.\n");

	if( ob->unequip() ) {
		if( !stringp(str = ob->query("unwield_msg")) )
			str = "$N 放下手中的 $n.\n";
		message_vision(str, me, ob);
		me->time_unit_loss( 3 );
		return 1;
	} else
		return 0;
}

int help(object me)
{
  write(@HELP
指令格式: unwield <物品名>
時間消耗: 3 單位.
 
這個指令讓你放下手中的武器.
 
參考: remove, wear, wield
HELP
    );
    return 1;
}
 
