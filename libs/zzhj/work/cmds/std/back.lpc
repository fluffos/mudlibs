// back.c
// move away from the target.
// Author: Spock @ FF
// Last modified by Spock @ FF   97.Feb.3.

inherit F_CLEAN_UP;
inherit F_CMD;

int help( object me);

int main( object me, string arg)
{
	string target;
	object target_ob;
	int steps;

	if( me->query("position") == "rest" )
		return notify_fail("你得先站起身子才行.\n");

	if( me->query("position") == "sleep" )
		return notify_fail("你仍在睡夢中.\n");

        if( me->query_time_unit() <= 0 )
                return notify_fail("你的動作不夠快 !\n");

	if( !arg && !me->is_fighting() ) return notify_fail("你想要遠離誰 ?\n");

	if( !arg && me->is_fighting() ) {
		target_ob = me->query_temp("last_opponent");
		if( !target_ob) return notify_fail("沒有目標可以遠離.\n");
	}

	else if( me->is_fighting() && sscanf( arg, "%d", steps ) == 1 )
		target_ob = me->query_temp("last_opponent");

	else if( sscanf( arg, "%d %s", steps, target ) == 2 ) {
		target_ob = present( target, environment( me ) );

		if( !target_ob ) return notify_fail("這裡沒有你欲遠離的目標.\n");
		if( objectp( target_ob ) && !me->visible( target_ob)) {
			if( target_ob->is_character())
				return notify_fail("你看不見這個人.\n");
			if( target_ob->is_vehicle())
				return notify_fail("你看不見這個載具.\n");
		}
	}

	else if( sscanf( arg, "%s", target ) == 1 ) {
		target_ob = present( target, environment( me ) );
		steps = me->query("dex");

		if( !target_ob ) return notify_fail("這裡沒有你欲遠離的目標.\n");
		if( objectp( target_ob ) && !me->visible( target_ob)) {
			if( target_ob->is_character())
				return notify_fail("你看不見這個人.\n");
			if( target_ob->is_vehicle())
				return notify_fail("你看不見這個載具.\n");
		}
	}

	if( target_ob->is_character() || target_ob->is_vehicle() )
		COMBAT_D->back( me, target_ob, steps );
	else	return notify_fail("這裡沒有這個人.\n");
	return 1;
}

int help(object me)
{
	write(@HELP
指令格式 : back [公尺] <人物或載具名稱>
	   back	[公尺]				( 戰鬥中 )

時間消耗: 1 + 負重量 1 ~ 10 成 - 力量與敏捷加分
 
這個指令可以讓您遠離與一個目標人物或者是載具的距離.
戰鬥中如果不加上目標名稱, 則自動遠離與敵人的距離.

一次遠離的公尺數最高不能大於您的敏捷屬性值.
如果不加上公尺數, 則以敏捷屬性值做為遠離的距離.
參考: advance
HELP
    );
    return 1;
}
