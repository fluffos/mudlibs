// reply.c

#include <ansi.h>
#include <net/dns.h>

inherit F_CLEAN_UP;
inherit F_CMD;

int help(object me);

int main(object me, string arg)
{
	string target, mud;
	object obj;

	if( me->query("position") == "sleep" )
		return notify_fail("你仍在睡夢中.\n");

        if( me->query_time_unit() <= 0 )
                return notify_fail("你的動作不夠快 !\n");

	if( me->query("water") <= 0 )
		return notify_fail("你口渴得說不出話來了.\n");

	if( !arg || arg=="" )
		return notify_fail("你要回答什麼﹖\n");

	if( !stringp(target = me->query_temp("reply")) )
		return notify_fail("剛才沒有人和你說過話。\n");

	if( sscanf(target, "%s@%s", target, mud)==2 ) {
		GTELL->send_gtell(lower_case(mud), lower_case(target), me, arg);
		write("網路訊息已送出﹐可能要稍候才能得到回應。\n");
		return 1;
	}

	obj = find_player(target);
	if( !obj )
		return notify_fail("剛才和你說話的人現在無法聽見你﹐或者已經離開遊戲了。\n");
	write(GRN + gender_self( me->query("gender") ) + "回答" + obj->name(1) + GRN "﹕" + arg + "\n" NOR);
	tell_object(obj, sprintf( GRN "%s " GRN "回答" + gender_self( obj->query("gender")) + "﹕%s\n"NOR,
		me->name(1), arg ));

	obj->set_temp("reply", me->query("id"));
	return 1;
}

int help(object me)
{
	write(@HELP
指令格式﹕reply <訊息>

你可以用這個指令和剛才用 tell 和你說話的使用者說話。

see also : tell
HELP
	);
	return 1;
}
