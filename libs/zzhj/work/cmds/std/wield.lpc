// wield.c
// wield a weapon on hands.
// Original ES II command.
// Last modified by Spock @ FF   97.Feb.6.

inherit F_CLEAN_UP;
inherit F_CMD;

int do_wield(object me, object ob);

int main(object me, string arg)
{
	object ob, *inv;
	int i, count;

	if( me->query("position") == "sleep" )
		return notify_fail("你仍在睡夢中.\n");

        if( me->query_time_unit() <= 0 )
                return notify_fail("你的動作不夠快 !\n");

	if( !arg ) return notify_fail("你要裝備什麼武器 ?\n");

	if(arg=="all") {
		inv = all_inventory(me);
		for(count=0, i=0; i<sizeof(inv); i++) {
			if( inv[i]->query("equipped") ) continue;
			if( !inv[i]->identify( me, inv[i])) continue;
			if( inv[i]->query("broken") ) continue;
			if(do_wield(me, inv[i]) ) count ++;
		}
		write("Ok.\n");
		return 1;
	}

	if( !objectp(ob = present(arg, me)) )
		return notify_fail("你身上沒有這樣東西.\n");

	if( ob->query("equipped") )
		return notify_fail("你已經裝備著了.\n");

	if( !ob->identify( me, ob))
		return notify_fail("你不知道怎麼使用這樣物品.\n");

	return do_wield(me, ob);
}

int do_wield(object me, object ob)
{
	string str;

	if( ob->wield() ) {
		if( !stringp(str = ob->query("wield_msg")) )
			str = "$N 拿起 $n 作為武器.\n";
		message_vision(str, me, ob);
		me->time_unit_loss( 3 );
		return 1;
	} else
		return 0;
}

int help(object me)
{
	write(@HELP
指令格式: wield <裝備名稱>
時間消耗: 3 單位.

這個指令讓你裝備某件物品作武器, 而你必需要擁有這樣物品.
 
參考: remove, unwield, wear
HELP
    );
    return 1;
}
