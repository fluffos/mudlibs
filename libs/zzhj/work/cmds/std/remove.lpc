// remove.c
// Remove a cloth or equipment from body.
// Original ES II command.
// Last modified by Spock @ FF   97.Feb.6.

#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_CMD;

int do_remove(object me, object ob);

int main(object me, string arg)
{
	object ob, *inv;
	int i;

	if( !arg ) return notify_fail("你要脫掉什麼 ?\n");

        if( me->query_time_unit() <= 0 )
                return notify_fail("你的動作不夠快 !\n");

	if(arg=="all") {
		inv = all_inventory(me);
		for(i=0; i<sizeof(inv); i++)
			do_remove(me, inv[i]);
		write("Ok.\n");
		return 1;
	}

	if( !objectp(ob = present(arg, me)) )
		return notify_fail("你身上沒有這樣東西.\n");
	return do_remove(me, ob);
}

int do_remove(object me, object ob)
{
	string str;

	if( (string)ob->query("equipped")!="worn" )
		return notify_fail("你並沒有裝備這樣東西.\n");

	if( ob->unequip() ) {
		if( !stringp(str = ob->query("unequip_msg")) )
			switch(ob->query("armor_type")) {
				case "cloth":
					str = "$N" YEL " 脫下了一" + ob->query("unit") + NOR " $n" YEL ".\n" NOR;
					break;
				case "armor":
					str = "$N" YEL " 卸下身上的一"  + ob->query("unit") + NOR " $n" YEL ".\n" NOR;
					break;
				case "surcoat":
					str = "$N" YEL " 把披在身上的一" + ob->query("unit") +NOR " $n " YEL "脫了下來.\n" NOR;
					break;
				case "boots":
					str = "$N" YEL " 將一" + ob->query("unit") + NOR " $n " YEL "從腳上脫了下來.\n" NOR;
					break;
				case "head":
					str = "$N" YEL " 將一" + ob->query("unit") + NOR " $n " YEL "從頭上脫了下來.\n" NOR;
					break;
				case "neck":
					str = "$N" YEL " 將一" + ob->query("unit") + NOR " $n " YEL "自頸中拿了下來.\n" NOR;
					break;
				case "wrists":
					str = "$N" YEL " 將一" + ob->query("unit") + NOR " $n " YEL "從雙手的手腕上取下.\n" NOR;
					break;
				case "finger":
					str = "$N" YEL " 將一" + ob->query("unit") + NOR " $n " YEL "自手指上取下.\n" NOR;
					break;
				case "hands":
					str = "$N" YEL " 將一" + ob->query("unit") + NOR " $n " YEL "從雙手上脫下.\n" NOR;
					break;
				case "waist":
					str = "$N" YEL " 將一" + ob->query("unit") + "自腰間拿下.\n" NOR;
					break;
				case "bandage":
					str = "$N" YEL " 將一" + ob->query("unit") + NOR " $n " YEL "從傷口上拆了下來.\n" NOR;
					break;
				default:
					str = "$N" YEL " 脫下了一" + ob->query("unit") + NOR " $n" YEL ".\n" NOR;
			}
		message_vision(str, me, ob);
		me->time_unit_loss( 3 );
		return 1;
	} else
		return 0;
}

int help(object me)
{
write(@HELP
指令格式: remove all | <物品名稱>
時間消耗: 3 單位.
 
這個指令讓你脫掉身上某件護具.
 
參考: wield, unwield, wear
HELP
    );
    return 1;
}
 
