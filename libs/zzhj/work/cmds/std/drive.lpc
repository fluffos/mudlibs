// drive.c
// drive a vehicle.
// Author: Spock @ FF
// Last modified by Spock @ FF   97.Feb.6.

#include <ansi.h>
 
inherit F_CLEAN_UP;
inherit F_CMD;
 
int help();
 
int main( object me)
{
	object *inside;
	int i;


	if( me != this_player(1) ) return 0;

	if( me->query("position") == "sleep")
		return notify_fail("你仍在睡夢中.\n");

        if( me->query_time_unit() <= 0 )
                return notify_fail("你的動作不夠快 !\n");
 
	if( !environment( me)->is_vehicle())
		return notify_fail("你不在任何載具中.\n");
	if( !wizardp(me)){
		for( i = 0; i < sizeof( inside = all_inventory( environment( me))); i++) {
			if( inside[i] == me ) continue;
			if( inside[i]->query_temp("command"))
				return notify_fail(sprintf("%s(%s)正在駕駛這%s%s.\n",
				inside[i]->query("name"),capitalize(geteuid(inside[i])),
				environment(me)->query("unit"),
				environment(me)->query("name")));		
		}
	}
	if( me->query_temp("command") == 1 ){ 
		return notify_fail(sprintf("您已經在駕駛這%s%s"NOR"了.\n",
			environment(me)->query("unit"),
			environment(me)->query("name")));
	}		
	me->set_temp("command", 1);
	message_vision
	(sprintf(CYN" %s"CYN"開始駕駛這%s%s"CYN"。\n"NOR,
	me->query("name"),environment(me)->query("unit"), 
	environment(me)->query("name")), me);
	me->time_unit_loss( 3 );
	return 1;
}
 
int help()
{
	write(@HELP
指令格式: drive
時間消耗: 3 單位.
 
這個指令可以讓你開始駕駛載具。 

參考: leave, pilot, getout, getin. 
HELP
	);
	return 1;
}
