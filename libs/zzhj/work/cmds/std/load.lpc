// load.c
// Load a ammunition of a advanced weapon.
// Author: Spock @ FF
// Last modified by Spock @ FF   97.Feb.6.

inherit F_CLEAN_UP;
inherit F_CMD;

int do_load( object me, object obj, object dest);

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
	string target, item;
	object obj, dest;
	int i;

	if( me->query("position") == "sleep" )
		return notify_fail("你仍在睡夢中.\n");

        if( me->query_time_unit() <= 0 )
                return notify_fail("你的動作不夠快 !\n");

	if(!arg) return notify_fail("你要將什麼彈匣或彈藥裝進哪樣武器 ?\n");

	if( sscanf(arg, "%s with %s", target, item)!=2 )
		return notify_fail("你要裝上什麼東西 ?\n");

	dest = present(target, me);
	if( !dest || living(dest) ) dest = present(target, environment(me));
	if( !dest || living(dest) )
		return notify_fail("這裡沒有這樣東西.\n");

	if(!objectp(obj = present(item, me)))
		return notify_fail("你身上沒有這種彈匣或彈藥.\n");

	if( obj->query("loaded"))
		return notify_fail("武器裡已經有彈匣或彈藥了.\n");

	return do_load(me, obj, dest);
}

int do_load(object me, object obj, object dest)
{
	int ammo, i;
	object *inv;

	if( obj->is_clip()) {
		if( !obj->query("weapon_type") == dest->query("weapon_type"))
			return notify_fail("彈匣與武器的規格並不符合.\n");

		for( i = 0; i < sizeof( inv = all_inventory( obj)); i++) {
			if( !inv[i]->is_ammo()) {
				return notify_fail("彈匣內裝有彈藥以外的東西.\n");
				break;
			}

			if( !inv[i]->query("weapon_type") == dest->query("weapon_type")) {
				return notify_fail("彈匣內裝有不同規格的彈藥.\n");
				break;
			}

			ammo += inv[i]->query_amount();
		}
	}
	if( ammo >= 0 ) {
		message_vision( sprintf("$N 將一%s %s填進 %s.\n",
			obj->query("unit"), obj->name(), dest->name()),
			me );

		dest->set("ammo", ammo);
		dest->set("loaded", 1);
		destruct( obj);
		me->time_unit_loss( 10 );
		return 1;
	}
	return 0;
}

int help(object me)
{
write(@HELP
指令格式: load <武器名稱> with <彈匣或彈藥名稱>
時間消耗: 10 單位.
 
這個指令可以讓你將彈藥裝進武器. 你身上要有武器所需的彈藥, 而
且一次只能裝進一顆彈藥( 火炮 )或是一個彈匣.
 
參考: unload.
HELP
    );
    return 1;
}
