// fill.c
// Fill some liquid from water resource.
// Modified from ES 2 /feature/liquid.c
// Last modified by Spock @ FF	97.Sep.7.

inherit F_CLEAN_UP;
inherit F_CMD;

int help( object me );

int main( object me, string arg )
{
	object obj;

	if( me->query("position") == "rest" )
		return notify_fail("你得先站起身子才行.\n");

	if( me->query("position") == "sleep" )
		return notify_fail("你仍在睡夢中.\n");

        if( me->query_time_unit() <= 0 )
                return notify_fail("你的動作不夠快 !\n");

	if( this_player()->is_busy() )
		return notify_fail("你上一個動作還沒有完成.\n");

	if( !environment( me )->query("resource/water") )
		return notify_fail("這裡沒有地方可以裝水.\n");

	if( !objectp( obj = present( arg, me ) ) )
		return notify_fail("你身上沒有這個容器.\n");

	if( !obj->is_water_container() )
		return notify_fail("這不是一個液體容器.\n");

	if( obj->query("liquid/remaining") && ( obj->query("liquid/type") != "water" ) )
		message_vision("$N 將" + obj->name() + " 裡剩下的 " + obj->query("liquid/name") + "倒掉.\n", me );

	message_vision("$N將" + obj->name() + "裝滿清水.\n", me );

	if( me->is_fighting() )
		me->time_unit_loss( 50 );
	else
		me->time_unit_loss( 5 );

	obj->set("liquid/type", "water");
	obj->set("liquid/name", "清水");
	obj->set("liquid/remaining", obj->query("max_liquid"));

	return 1;
}

int help( object me )
{
	write( @HELP
指令格式: fill <容器名>

時間消耗: 5

讓您從潔淨的水源裝水到容器中.

參考: drink, eat
HELP
	);
	return 1;
}