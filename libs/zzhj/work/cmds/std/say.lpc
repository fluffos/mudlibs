// say.c
// Say some words.
// Original ES II commands.
// Last modified by Spock @ FF   97.Feb.6.

#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string arg)
{
	if( me->query("position") == "sleep" )
		return notify_fail("你仍在睡夢中.\n");

        if( me->query_time_unit() <= 0 )
                return notify_fail("你的動作不夠快 !\n");

	if( me->query("water") <= 0 )
		return notify_fail("你口渴得說不出話來了.\n");

	if( !arg ) {
		message_vision( "$N 自言自語不知道在說些什麼。\n", me);
		return 1;
	}

	if( (int)me->query("hit") < (int)me->query("max_hit") / 10 ) {
		arg = replace_string(arg, " ", " ... ") + " ...";
	}

	message_vision( CYN + "$N " + CYN + "說道: " +  arg + "\n" NOR, me);

// The mudlib interface of say
	all_inventory(environment(me))->relay_say(me, arg);
	me->time_unit_loss( 1 );

	return 1;
}

int help (object me)
{
	write(@HELP
指令格式: say <訊息>
時間消耗: 1 單位.
 
說話﹐所有跟你在同一個房間的人都會聽到你說的話。
 
註: 本指令可用 ' 取代.
 
參考: ask, emote, reply, tell
HELP
	);
	return 1;
}
