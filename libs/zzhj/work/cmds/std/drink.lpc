// drink.c
// Drink some liquid from a container.
// Modified from ES 2 /feature/liquid.c
// Last modified by Spock @ FF	97.Sep.6.

inherit F_CLEAN_UP;
inherit F_CMD;

int help( object me );

int main( object me, string arg )
{
	object obj;

	if( me->query("position") == "sleep" )
		return notify_fail("你仍在睡夢中.\n");

        if( me->query_time_unit() <= 0 )
                return notify_fail("你的動作不夠快 !\n");

	if( this_player()->is_busy() )
		return notify_fail("你上一個動作還沒有完成.\n");

	if( !arg ) {
		if( !environment( me )->query("resource/water") )
			return notify_fail("此地沒有潔淨的水源.\n");
		if( me->query("position") == "rest" )
			return notify_fail("你得先站起身子才行.\n");
		if( me->query("water") > me->max_water_capacity() )
			return notify_fail("你已經喝得太多了, 再也灌不下一滴水了.\n");

		message_vision("$N 從 " + environment( me )->query("resource/water") + " 舀了一些清水, 咕嚕嚕地喝了幾口.\n", me);
		me->add("water", 30 );
		me->add("food", 5 );
		if( me->is_fighting() ) 
			me->time_unit_loss( 30 );
		else
			me->time_unit_loss( 3 );
		return 1;
	}

	if( !objectp( obj = present( arg, me ) ) )
		return notify_fail("你身上沒有這個容器.\n");
	if( !obj->is_water_container() )
		return notify_fail("這不是一個液體容器.\n");

	if( !obj->query("liquid/remaining") )
		return notify_fail( obj->name() + ( obj->query("liquid/name") 
			? "的" + obj->query("liquid/name") + "已經被喝得一滴也不剩了" : "是空的.\n") );

	if( me->query("water") > me->max_water_capacity() )
		return notify_fail("你已經喝得太多了, 再也灌不下一滴水了.\n");

	obj->add("liquid/remaining", -1);

	message_vision("$N 拿起 " + obj->name() + " 咕嚕嚕地喝了幾口" + obj->query("liquid/name")
		+ ".\n", me );
	me->add("water", 30 );
	me->add("food", 5 );

	if( me->is_fighting() ) 
		me->time_unit_loss( 30 );
	else
		me->time_unit_loss( 3 );

	switch( obj->query("liquid/type") ) {
		case "alcohol":
			me->apply_condition("drunk",
				(int)me->query_condition("drunk") 
				+ (int)obj->query("liquid/drunk_apply"));
			break;
		default:
			break;
	}

	if( !obj->query("liquid/remaining") ) {
		write("你已經將 " + obj->name() + " 裡的 " + obj->query("liquid/name")
			+ " 喝得一滴也不剩了.\n");
		if( obj->query("destruct_if_empty") )
			destruct( obj );
	}
	
	return 1;
}

int help( object me )
{
	write( @HELP
指令格式: drink <容器名>
	  drink			(在有乾淨水源的地方可以直接喝水)

時間消耗: 3

讓您喝容器中的液體.

參考: fill, eat
HELP
	);
	return 1;
}