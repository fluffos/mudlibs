// shout.c
// Shout a message to all players.
// Original ES II command.
// Last modified by Spock @ FF   97.Feb.3.

inherit F_CLEAN_UP;
inherit F_CMD;

int main(object me, string arg)
{
	if( me->query("position") == "sleep" )
		return notify_fail("你仍在睡夢中.\n");

//	if( !wizardp(me) )
//		return notify_fail("目前暫不開放玩家 shout。\n");

	if (!arg) return notify_fail("你想要大叫什麼?\n");
	shout( me->name() + "縱聲長嘯: " + arg + "\n");
	write("你縱聲長嘯: " + arg + "\n");
	return 1;
}
int help(object me)
{
  write(@HELP
指令格式 : shout <訊息>
 
這個指令讓你將 <訊息> 傳送出去, 所有正在遊戲中的人都
會聽見你的話.
 
參考 : tune, channels
HELP
    );
    return 1;
}
 
