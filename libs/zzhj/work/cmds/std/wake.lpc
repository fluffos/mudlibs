// wake.c
// As thew same as stand.c
// Author: Spock @ FF
// Last modified by Spock @ FF   97.Sep.4.

inherit F_CLEAN_UP;
inherit F_CMD;

int main( object me )
{
	if( me->is_busy() )
		return notify_fail("你的上一個動作還未完成.\n");

	if( me->is_fighting() )
		return notify_fail("你正在戰鬥中.\n");

	if( me->query_time_unit() <= 0 )
		return notify_fail("你的行動沒那麼快.\n");

	if( me->query("position") == "sleep") {
		me->set("position", "stand");
		message_vision("$N 從睡夢中醒來, 抖擻精神站起身子.\n", me);
	} else if( me->query("position") == "stand") {
		return notify_fail("你已經站著了.\n");
	} else if( me->query("position") == "rest") {
                me->set("position", "stand");
		message_vision("$N 打起精神站了起來.\n", me );
	}
	return 1;
}

int help( object me)
{
	write(@HELP
指令格式: wake
時間消耗: 無時間消耗.

讓你站起身子.

相關指令: stand, rest, sleep
HELP
	);
        return 1;
}
