// rest.c
// Take a rest.
// Author: Spock @ FF
// Last modified by Spock @ FF   97.Feb.3.

inherit F_CLEAN_UP;
inherit F_CMD;

int main( object me )
{
	if( me->is_busy() )
		return notify_fail("你的上一個動作還未完成.\n");

	if( me->is_fighting() )
		return notify_fail("你正在戰鬥中.\n");

	if( me->query_time_unit() <= 0 )
		return notify_fail("你的行動沒那麼快.\n");

	if( me->query("position") == "sleep") {
		me->set("position", "rest");
		message_vision("$N 從睡夢中醒來, 坐在地上休息.\n", me);
	} else if( me->query("position") == "rest") {
		return notify_fail("你已經在休息了.\n");
	} else {
		me->set("position", "rest");
		message_vision("$N 找了個地方坐下來休息.\n", me );
	}
	return 1;
}

int help( object me)
{
	write(@HELP
指令格式: rest
時間消耗: 無時間消耗.

讓你坐下來休息.

相關指令: sleep, stand
HELP
	);
        return 1;
}
