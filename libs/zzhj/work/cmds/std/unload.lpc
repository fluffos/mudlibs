// unload.c
// Unload ammunition from a advanced weapon.
// Author: Spock @ FF
// Last modified by Spock @ FF   97.Feb.6.

inherit F_CLEAN_UP;
inherit F_CMD;

int do_unload(object me, object weapon);

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
	object weapon;

	if( me->query("position") == "sleep" )
		return notify_fail("你仍在睡夢中.\n");

        if( me->query_time_unit() <= 0 )
                return notify_fail("你的動作不夠快 !\n");

	if( !arg && me->is_fighting()) {
		if( ( weapon = me->query_temp("weapon")) && weapon->is_loadable()) {
			do_unload( me, me->query_temp("weapon"));
			write("Ok.\n");
		}
		else return notify_fail("這種武器無法卸下彈匣或彈藥.\n");
	}

// Check if a weapon is specified.
	if( arg) {
		weapon = present( arg, me);
		if( !weapon) weapon = present( arg, environment(me));
		if( !weapon) return notify_fail("你找不到 " + arg + " 這樣武器.\n");
	} else return notify_fail("你要從什麼武器裡卸下彈匣或彈藥 ?\n");

	if( !weapon->is_loadable())
		return notify_fail("這種武器無法卸下彈匣或彈藥.\n");

	if( weapon->query("loaded"))
		return do_unload(me, weapon);
	else return notify_fail("武器裡沒有彈匣或彈藥.\n");
}
	
int do_unload(object me, object weapon)
{
	string clip_name, ammo_name, message;
	object clip, ammo;
	int i;

	clip_name = weapon->query("clip");
	clip = new( clip_name);
	clip->move( me);
	ammo_name = clip->query("ammo");

	ammo = new( ammo_name);
	ammo->set_amount( (int)weapon->query("ammo"));
	ammo->move( clip);

	weapon->delete("loaded");
	weapon->delete("ammo");

	message = "$N 從 " + weapon->name() + " 中取出一" + clip->query("unit")
		+ clip->name() + ".\n";
	message_vision( message, me);
	me->time_unit_loss( 6 );
	return 1;
}

int help(object me)
{
	write(@HELP
指令格式: unload [<武器名稱>]
時間消耗: 6 單位.
 
這個指令可以讓您卸下武器裡的彈匣或彈藥 (火炮) , 如果您正在
戰鬥中, 可以直接打 unload 以卸下正在使用之武器的彈匣或彈藥
.
參考: load.
HELP
    );
    return 1;
}
 
