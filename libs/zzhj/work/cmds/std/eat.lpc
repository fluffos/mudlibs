// fill.c
// Fill some liquid from water resource.
// Modified from ES 2 /feature/liquid.c
// Last modified by Spock @ FF	97.Sep.7.

inherit F_CLEAN_UP;
inherit F_CMD;

int help( object me );

int main( object me, string arg )
{
	object obj;

	if( me->query("position") == "sleep" )
		return notify_fail("你仍在睡夢中.\n");

        if( me->query_time_unit() <= 0 )
                return notify_fail("你的動作不夠快 !\n");

	if( this_player()->is_busy() )
		return notify_fail("你上一個動作還沒有完成.\n");

	if( !arg ) return notify_fail("你想吃什麼 ?\n");

	if( !objectp( obj = present( arg, me ) ) )
		return notify_fail("你身上沒有這樣食物.\n");

	if( !obj->query("food") )
		return notify_fail( obj->name() + "無法食用.\n");

	if( (int)me->query("food") >= (int)me->max_food_capacity() )
		return notify_fail("你已經吃得太飽了, 再也塞不下任何東西了.\n");

	me->add("food", obj->query("food/supply") );
	me->add("water", obj->query("food/water") );
	if( me->is_fighting() ) 
		me->time_unit_loss( 20 );
	else
		me->time_unit_loss( 2 );

	obj->set("value", 0);
	
	obj->add("food/remaining", -1);
	if( !obj->query("food/remaining") ) {
		message_vision("$N 將剩下的 " + obj->name() + " 吃得乾乾淨淨.\n", me );
		destruct( obj );
	} else 
		message_vision("$N 拿起 " + obj->name() + " 吃了幾口.\n", me );

	return 1;
}

int help( object me )
{
	write( @HELP
指令格式: eat <食物名>

時間消耗: 3

吃下某樣食物以填飽肚子.

參考: drink, fill
HELP
	);
	return 1;
}