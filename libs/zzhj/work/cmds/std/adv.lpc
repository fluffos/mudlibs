// advance.c
// approach the target.
// Author: Spock @ FF
// Last modified by Spock @ FF   97.Feb.6.

inherit F_CLEAN_UP;
inherit F_CMD;

int help( object me);

int main( object me, string arg)
{
	string target;
	object target_ob;
	int steps;

	if( me->query("position") == "rest" )
		return notify_fail("你得先站起身子才行.\n");

	if( me->query("position") == "sleep" )
		return notify_fail("你仍在睡夢中.\n");

        if( me->query_time_unit() <= 0 )
                return notify_fail("你的動作不夠快 !\n");

	if( !arg && !me->is_fighting() ) return notify_fail("你想要接近誰 ?\n");

	if( !arg && me->is_fighting() ) {
		target_ob = me->query_temp("last_opponent");
		if( !target_ob) return notify_fail("沒有目標可以接近.\n");
	}

	else if( me->is_fighting() && sscanf( arg, "%d", steps ) == 1 )
		target_ob = me->query_temp("last_opponent");

	else if( sscanf( arg, "%d %s", steps, target) == 2 ) {
		target_ob = present( target, environment( me));

		if( !target_ob ) return notify_fail("這裡沒有你欲接近的目標.\n");
		if( objectp( target_ob ) && !me->visible( target_ob )) {
			if( target_ob->is_character())
				return notify_fail("你看不見這個人.\n");
			if( target_ob->is_vehicle())
				return notify_fail("你看不見這個載具.\n");
			if( target_ob->is_space_ship() || target_ob->is_shuttle() )
				return notify_fail("你看不見這艘船艦.\n");
		}
	}

	else if( sscanf( arg, "%s", target ) == 1 ) {
		target_ob = present( target, environment( me));
		steps = me->query("dex");

		if( !target_ob ) return notify_fail("這裡沒有你欲接近的目標.\n");
		if( objectp( target_ob ) && !me->visible( target_ob )) {
			if( target_ob->is_character())
				return notify_fail("你看不見這個人.\n");
			if( target_ob->is_vehicle())
				return notify_fail("你看不見這個載具.\n");
			if( target_ob->is_space_ship() || target_ob->is_shuttle() )
				return notify_fail("你看不見這艘船艦.\n");
		}
	}


	if( target_ob->is_character() || target_ob->is_vehicle() || 
		target_ob->is_space_ship() || target_ob->is_shuttle() )
		COMBAT_D->advance( me, target_ob, steps );
	else	return notify_fail("這裡沒有這個人或載具、船艦.\n");
	return 1;

}

int help(object me)
{
	write(@HELP
指令格式: advance [公尺] <人物或載具、船艦名稱>
	  advance [公尺]			( 戰鬥中 )

時間消耗: 1 + 負重量 1 ~ 10 成 - 力量與敏捷加分
 
這個指令可以讓您拉近與一個目標人物或者是載具、船艦的距離.
戰鬥中如果不加上目標名稱, 則自動拉近與敵人的距離.

一次接近的公尺數最高不能大於您的敏捷屬性值.
如果不加上公尺數, 則以敏捷屬性值做為接近的距離.
參考: back
HELP
    );
    return 1;
}
