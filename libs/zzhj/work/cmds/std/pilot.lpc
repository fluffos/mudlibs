// pilot.c
// pilot a space ship.
// Author: Spock @ FF
// Last modified by Spock @ FF   97.Aug.31.

#include <ansi.h>
 
inherit F_CLEAN_UP;
inherit F_CMD;
 
int help();
 
int main( object me, string arg )
{
	object *inside, bridge, ship, ob;
	int i, planet, flag = 0;
	int *coord = ({ 0, 0, 0, });
	int cmding;
	float velocity;	
	string *planets;
	string msg = "", name, type;

	if( me != this_player(1) ) return 0;

	if( me->query("position") == "sleep")
		return notify_fail("你仍在睡夢中.\n");

        if( me->query_time_unit() <= 0 )
                return notify_fail("你的動作不夠快 !\n");
 
	bridge = environment( me );

	if( !bridge->is_space_ship_room() )
		return notify_fail("你不在任何宇宙船艦或太空梭中.\n");

	if( !bridge->query("bridge") )
		return notify_fail("你不在艦橋中.\n");

	ship = environment( environment( me ) );
	if( (int)ship->is_space_ship() )
		type = "ss";
	else
		type = "shuttle";

	cmding = me->query_temp("ss_command");

	if( !arg ) {		
		if( !wizardp(me)){
			i = sizeof( inside = all_inventory(bridge) );
			while( i-- ) {
				if( inside[i] == me ) continue;
				if( inside[i]->query_temp("ss_command"))
					return notify_fail(sprintf("%s(%s)正坐在駕駛座上.\n",
						inside[i]->query("name"),capitalize(geteuid(inside[i]))));		
			}
		}
		if( me->query_temp("ss_command") == 1 ) {
			return notify_fail("您已經坐在駕駛座上了.\n");
		}		
		me->set_temp("ss_command", 1);
		message_vision(sprintf(CYN" %s"CYN"坐上駕駛席, 開始駕駛這%s%s"CYN".\n"NOR,
		me->query("name"), ship->query("unit"), 
		ship->query("name")), me);
		me->time_unit_loss( 5 );
		return 1;
	} 
	if( cmding ) {
		switch( type ) {
			case "ss":
				if( sscanf( arg, "w %f", velocity) == 1 ) {
					if( !ship->query("max_velocity") )
						return notify_fail("本艦沒有曲速飛行能力.\n");
					if( velocity > ship->query("max_velocity") )
						return notify_fail("超過本艦的最高速度.\n");
					if( velocity < 0 )
						return notify_fail("本艦速度不能設定為負值.\n");
					ship->set_velocity( to_float( velocity ) );
					message_vision( sprintf("本艦將進入 %2.1f 級曲速飛行.\n", velocity ), me );
					return 1;
				} else if( sscanf( arg, "c %d,%d,%d", coord[0], coord[1], coord[2] ) == 3) {
					if( !ship->query("max_velocity") )
						return notify_fail("本艦沒有曲速飛行能力.\n");
					if( coord[0] > 999 || coord[0] < -999 || coord[1] > 999 || coord[1] < -999 || coord[2] > 999 || coord[2] < -999 )
						return notify_fail("目的地座標值不正確.\n"); 
					ship->set_destination( coord );
					message_vision( sprintf("本艦航向設定為 %d-%d-%d.\n", coord[0], coord[1], coord[2]), me);
					return 1;
				} else if( arg == "p" ) {
					planets = environment( ship )->query("planets/name");
					if( !planets )
						planets = environment( ship )->query("env_space")->query("planets/name");
					if( !planets )
						planets = environment( environment( ship ) )->query("planets/name");
					if( !planets )
						return notify_fail("附近的宙域沒有恆星系.\n");
					msg = "";
					for( i = 0; i < sizeof( planets ); i ++ ) {
						msg += sprintf( "(%d) ", i ) + planets[i] + "\n";
					}
					write( msg );
					return 1;
				} else if( sscanf( arg, "p %d", planet ) == 1 ) {
					planets = environment( ship )->query("planets/name");
					if( !planets )
						planets = environment( ship )->query("env_space")->query("planets/name");
					if( !planets )
						planets = environment( environment( ship ) )->query("planets/name");
					if( !planets )
						return notify_fail("附近的宙域沒有恆星系.\n");
					if( planet > sizeof( planets ) || planet < 0 )
						return notify_fail("不正確的星球編號.\n");
					ship->set_planet_coord( planet );
					message_vision( sprintf("本艦設定進入環繞 (%d) %s 的軌道.\n", planet, planets[planet] ), me);
					return 1;
				} else if( arg == "orbit" ) {
					if( ship->query_arrive() )
						return notify_fail("本艦不在任何星系中.\n");
					if( ship->query_planet_coord() == -1 )
						return notify_fail("還未設定進入第幾星球的軌道.\n");
					message_vision("$N 下令道: 進入軌道 !\n", me );
					ship->move_into_orbit();
					return 1;
				} else if( arg == "exit" ) {
					if( ship->query_arrive() )
						return notify_fail("本艦不在任何星系中.\n");
					if( ship->query_planet_coord() == -1 )
						return notify_fail("本艦不在任何星球的軌道上.\n");
					message_vision("$N 下令道: 離開軌道 !\n", me );
					ship->exit_orbit();
					return 1;
				} else if( arg == "engage" ) {
					if( !ship->query("max_velocity") )
						return notify_fail("本艦沒有曲速飛行能力.\n");
					if( ship->query_destination() == ship->query_current_coord() )
						return notify_fail("本艦已經在設定的目的地座標上.\n");
					if( (float)ship->query_velocity() == 0.0 )
						return notify_fail("本艦還未設定速度.\n");
					if( (int)ship->query_arraive_time() )
						return notify_fail("本艦仍在子空間曲速航行中.\n");
					message_vision("$N 下令道: 啟動 !\n", me );
					ship->warp();
					return 1;
				} else if( sscanf( arg, "enter %s", name ) == 1 ) {
					if( !objectp( ob = present( name, environment(ship) ) ) || !ob->query("stargate") )
						return notify_fail("附近的宙域沒有星際跳躍門.\n");
					message_vision("$N 下令道: 進入" + ob->name() + ".\n", me );
					ship->enter_stargate( ob );
					return 1;
				} else if( arg == "display" ) {
					if( ship->query("max_velocity") ) {
						msg += sprintf("目前座標: %d-%d-%d	目的座標: %d-%d-%d\n",
								ship->query_current_coord()[0],
								ship->query_current_coord()[1],
								ship->query_current_coord()[2],
								ship->query_destination()[0],
								ship->query_destination()[1],
								ship->query_destination()[2],
							);
						msg += sprintf("曲速設定: %2.1f 級	航行距離: %4.2f 光年\n",
								(float)ship->query_velocity(),
								(float)ship->query_distance(),
							);
						msg += sprintf("航行時間: %d 小時 %d 分\n",
								( (int)ship->query_arrive_time() / 60 ),
								(int)ship->query_arrive_time() % 60,
							);
					}
					msg += sprintf("行星軌道: 第 %d 行星軌道	停靠宇宙港: %s\n",
							ship->query_planet_coord(),
							( (object)ship->query_docking_ob() ? ship->query_docking_ob()->name() : "無" )
						);

					write( msg );
					return 1;
				} 
			case "shuttle":
				if( sscanf( arg, "dock %s", name ) == 1 ) {
					if( ( msg = (string)ship->docking( name ) ) != "" )
						return notify_fail( msg );
					if( (int)ship->is_space_ship() ) {
						ob = present( name, environment(ship) );
						message_vision("$N 下令道: 停泊在 " + ob->name() + ".\n", me );
					} else {
						message_vision("$N 下令道: 進入降落航道.\n", me );
					}
					return 1;				
				} else if( arg == "launch" ) {
					if( !( ob = (object)ship->query_docking_ob() ) )
						return notify_fail("船艦並未停泊在任何港口.\n");
					ship->launching();
					if( (int)ship->is_space_ship() )
						message_vision("$N 下令道: 離開 " + ob->name() + ".\n", me );
					else
						message_vision("$N 下令道: 進入起飛程序.\n", me );

					return 1;
				}
		}
	} else return notify_fail("您現在並沒有駕駛本艦.\n");
	return 0;
}
 
int help()
{
	write(@HELP
指令格式: pilot			     ※ (坐上駕駛席)
	  pilot w <速度>	     ◎ (設定船艦預設曲速速度)
	  pilot c x,y,z		     ◎ (x, y, z 是星系的座標值)
	  pilot engage		     ◎ (開始曲速航行)
	  pilot enter <門名>	     ※ (進入星際跳躍門)
	  pilot p			(本星系的行星列表)
	  pilot p <行星編號>		(設定進入第幾行星軌道)
	  pilot orbit			(進入設定的環繞行星軌道)
	  pilot exit			(離開目前的行星軌道)
	  pilot dock <港口名>	     ※ (將船艦停泊在太空站港口
	  pilot dock surface		 駕駛太空梭降落於行星宇宙港)
	  pilot launch		     ※ (離開太空站港口或行星宇宙港)
	  pilot display			(顯示駕駛座儀表板資料)

時間消耗: 坐上駕駛座耗費 5 單位.
	  其他動作 1 單位.
 
這個指令可以讓你開始駕駛宇宙船艦, 或是對船艦下達命令. 
有「◎」記號的指令, 只有擁有曲速飛行引擎的船艦才能執行.
有「※」記號的是太空梭僅能執行的四個指令.
宇宙飛行的詳細說明, 請參考 help space_flight

參考: leave, board, disembark, sl
HELP
	);
	return 1;
}
