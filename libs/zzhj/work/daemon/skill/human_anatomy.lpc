// human_anatomy.c
// SKILL: human anatomy

inherit SKILL;

mixed type() { return ({ "int" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("medicine") < 25 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("medicine", 5 );
}

string learn_failed()
{
	return "學習 [人體解剖學] 知識需要先修 [醫學 25].\n";
}
