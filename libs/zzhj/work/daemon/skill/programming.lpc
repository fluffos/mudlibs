// programming.c
// SKILL: programming

inherit SKILL;

mixed type() { return ({ "int" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("mathmatics") < 40 
		|| (int)me->query_skill("computer_op") < 30 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("mathmatics", 5 );
	me->improve_skill("computer_op", 5 );
}

string learn_failed()
{
	return "學習 [電腦程式設計] 知識需要先修 [數學 40] 及 [電腦操作 30].\n";
}