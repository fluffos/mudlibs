// make_bomb.c
// SKILL: make bomb

inherit SKILL;

mixed type() { return ({ "int", "tec", "dex" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("chemistry") < 50 
	|| (int)me->query_skill("demolition") < 40
		|| (int)me->query_skill("make_machinary") < 20 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("chemistry", 5 );
	me->improve_skill("demolition", 5 );
	me->improve_skill("make_machinary", 5 );
}

string learn_failed()
{
	return "學習 [炸彈製造] 知識需要先修 [化學 50] [機械製造 20] [爆破 40].\n";
}
