// make_machinary.c
// SKILL: make machinary

inherit SKILL;

mixed type() { return ({ "int", "tec", "dex" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("repair_machinary") < 60 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("repair_machinary", 5 );
}

string learn_failed()
{
	return "學習 [機械製造] 知識需要先修 [機械維修 60].\n";
}
