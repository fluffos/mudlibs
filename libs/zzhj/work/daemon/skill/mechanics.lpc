// mechanics.c
// SKILL: mechanics

inherit SKILL;

mixed type() { return ({ "int", "tec" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("physics") < 20 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("physics", 5 );
}

string learn_failed()
{
	return "學習 [機械學] 知識需要先修 [物理 2].\n";
}