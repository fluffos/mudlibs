// backstab.c

inherit SKILL;

mixed type() { return ({ "dex" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("sneak") < 45 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("sneak", 5 );
}

string learn_failed()
{
	return "學習 [背後偷襲] 知識需要先修 [潛行 15].\n";
}
