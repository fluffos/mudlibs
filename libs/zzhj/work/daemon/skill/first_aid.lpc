// first_aid.c
// SKILL: first aid

inherit SKILL;

mixed type() { return ({ "int", "tec" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("medicine") < 20 
		|| (int)me->query_skill("human_anatomy") < 30 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("medicine", 5 );
	me->improve_skill("human_anatomy", 5 );
}

string learn_failed()
{
	return "學習 [急救] 知識需要先修 [醫學 30] [人體解剖 20].\n";
}
