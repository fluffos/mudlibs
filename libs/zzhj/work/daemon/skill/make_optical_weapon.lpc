// make_optical_weapon.c
// SKILL: make optical weapon

inherit SKILL;

mixed type() { return ({ "int", "tec", "dex" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("make_electronics") < 60
		|| (int)me->query_skill("make_machinary") < 50
		|| (int)me->query_skill("metallurgy") < 40 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("make_electronics", 5 );
	me->improve_skill("make_machinary", 5 );
	me->improve_skill("metallurgy", 5 );
}

string learn_failed()
{
	return "學習 [光學武器製造] 知識需要先修 [電器製造 60] [機械製造 50] [冶金學 40].\n";
}
