// pilot_ss.c
// SKILL: pilot space ship

inherit SKILL;

mixed type() { return ({ "dex", "tec" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("space_nav") < 40 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("space_nav", 5 );
}

string learn_failed()
{
	return notify_fail("學習 [宇宙航艦駕駛] 知識需要先修 [宇宙航行 40].\n");
}

