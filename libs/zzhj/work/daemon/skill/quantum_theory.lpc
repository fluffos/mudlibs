// quantum_theory.c
// SKILL: quantum theory

inherit SKILL;

mixed type() { return ({ "int" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("mathmatics") < 80 
		|| (int)me->query_skill("physics") < 70 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("mathmatics", 5 );
	me->improve_skill("physics", 5 );
}

string learn_failed()
{
	return "學習 [量子理論] 知識需要先修 [數學 80] 及 [物理學 70].\n";
}