// dodge.c

inherit SKILL;

mixed type() { return ({ "dex" });}

string *dodge_msg = ({
	"但是和 $p 的 $l 偏了幾寸.\n",
	"但是被 $p 機靈地躲開了.\n",
	"但是 $n 身子一側, 閃了開去.\n",
	"但是被 $p 及時避開.\n",
	"但是 $n 已有準備, 不慌不忙的躲開.\n",
});

string query_dodge_msg()
{
	return dodge_msg[random(sizeof(dodge_msg))];
}
