// repair_machinary.c
// SKILL: repair machinary

inherit SKILL;

mixed type() { return ({ "int", "tec" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("mechanics") < 40 ) 
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("mechanics", 5 );
}

string learn_failed()
{
	return "學習 [機械維修] 知識需要先修 [機械學 40].\n";
}
