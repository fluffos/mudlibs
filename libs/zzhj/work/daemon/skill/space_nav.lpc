// space_nav.c
// SKILL: space navigation

inherit SKILL;

mixed type() { return ({ "int", "tec" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("astronomy") < 50 
		|| (int)me->query_skill("computer_op") < 30
		|| (int)me->query_skill("physics") < 30 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("astronomy", 5 );
	me->improve_skill("computer_op", 5 );
	me->improve_skill("physics", 5 );
}

string learn_failed()
{
	return "學習 [宇宙航行] 知識需要先修 [天文學 50] [電腦操作 30] [物理學 30].\n";
}
