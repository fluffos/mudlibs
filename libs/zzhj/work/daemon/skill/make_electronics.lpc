// make_electronics.c
// SKILL: make electronics

inherit SKILL;

mixed type() { return ({ "int", "tec", "dex" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("repair_electronics") < 70
		|| (int)me->query_skill("repair_machinary") < 55 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("repair_electronics", 5 );
	me->improve_skill("repair_machinary", 5 );
}

string learn_failed()
{
	return "學習 [電器製造] 知識需要先修 [電器維修 70] [機械維修 55].\n";
}
