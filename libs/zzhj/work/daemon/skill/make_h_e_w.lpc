// make_h_e_w.c
// SKILL: make high energy weapon

inherit SKILL;

mixed type() { return ({ "int", "tec", "dex" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("make_electronics") < 80
		|| (int)me->query_skill("make_machinary") < 60
		|| (int)me->query_skill("metallurgy") < 70
		|| (int)me->query_skill("quantum_theory") < 40 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("make_electronics", 5 );
	me->improve_skill("make_machinary", 5 );
	me->improve_skill("metallurgy", 5 );
	me->improve_skill("quantum_theory", 5 );
}

string learn_failed()
{
	return @LONG 
學習 [高能武器製造] 知識需要先修 [電器製造 80] [機械製造 60] [冶金學 70]
				 [量子理論 40].
LONG;
}
