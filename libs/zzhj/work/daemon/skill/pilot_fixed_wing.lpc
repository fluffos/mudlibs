// pilot_fixed_wing.c
// SKILL: pilot fixed wing craft

inherit SKILL;

mixed type() { return ({ "dex", "tec" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("physics") < 30 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("physics", 5 );
}

string learn_failed()
{
	return "學習 [固定翼飛行器駕駛] 知識需要先修 [物理學 30].\n";
}
