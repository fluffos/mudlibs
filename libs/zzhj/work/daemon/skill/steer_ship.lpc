// steer_ship.c
// SKILL: steer ship

inherit SKILL;

mixed type() { return ({ "dex" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("physics") < 15 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("physics", 5 );
}

string learn_failed()
{
	return "學習 [掌舵操船] 知識需要先修 [物理 15].\n";
}