// cybernetic_eng.c
// SKILL: cybernetic engineering

inherit SKILL;

mixed type() { return ({ "int", "tec" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("human_anatomy") < 40
		|| (int)me->query_skill("biochemistry") < 75
		|| (int)me->query_skill("medicine") < 50
		|| (int)me->query_skill("make_electronics") < 70
		|| (int)me->query_skill("make_machinary") < 60 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("human_anatomy", 5 );
	me->improve_skill("biochemistry", 5 );
	me->improve_skill("medicine", 5 );
	me->improve_skill("make_electronics", 5 );
	me->improve_skill("make_machinary", 5 );
}

string learn_failed()
{
	return @LONG 
學習 [神經機械學] 知識需要先修 [人體解剖 40] [生物化學 75] [醫學 95]
			       [電器製造 70] [機械製造 60].
LONG;
}
