// ocean_nav.c
// SKILL: ocean navigation.

inherit SKILL;

mixed type() { return ({ "int" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("astronomy") < 20 
		|| (int)me->query_skill("steer_ship") < 10 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("astronomy", 5 );
	me->improve_skill("steer_ship", 5 );
}

string learn_failed()
{
	return "學習 [航海] 知識需要先修 [天文學 20] 及 [操船掌舵 10].\n";
}