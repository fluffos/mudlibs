// lab_equip_op.c
// SKILL: labratory equipment opration

inherit SKILL;

mixed type() { return ({ "int", "tec" }); }

int valid_learn( object me )
{
	if( (int)me->query_skill("programming") < 35 )
		return 0;
	
	return 1;
}

void skill_improved( object me )
{
	me->improve_skill("programming", 5 );
}

string learn_failed()
{
	return "學習 [儀器操作] 知識需要先修 [電腦程式設計 35].\n";
}
