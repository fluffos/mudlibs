// weapond.c

#include <ansi.h>
#include <combat.h>

inherit F_DBASE;

mapping weapon_actions = ([
	"hit": ([
                "damage_type":  "傷害",
                "action":               "$N 使用 $w, 攻擊 $n 的 $l",
		]),
	"slash": ([
                "damage_type":  "割傷",
                "action":               "$N 揮動 $w, 斬向 $n 的 $l",
		]),
	"slice": ([
                "damage_type":  "砍傷",
                "action":               "$N 用 $w 往 $n 的 $l 砍去",
		]),
	"chop": ([
                "damage_type":  "砍傷",
                "action":               "$N 的 $w 朝著 $n 的 $l 劈下",
		]),
	"hack": ([
                "action":               "$N 揮舞 $w, 對準 $n 的 $l 一陣亂砍",
                "damage_type":  "砍傷",
		]),
	"thrust": ([
		"damage_type":	"刺傷",
                "action":               "$N 用 $w 往 $n 的 $l 刺去",
		]),
	"pierce": ([
                "action":               "$N 的 $w 往 $n 的 $l 狠狠地一刺",
		"damage_type":	"刺傷",
		]),
	"whip": ([
                "action":               "$N 將 $w 一揚, 往 $n 的 $l 抽去",
		"damage_type":	"鞭傷",
		]),
	"impale": ([
                "action":               "$N 用 $w 往 $n 的 $l 直戳過去",
		"damage_type":	"刺傷",
		]),
	"bash": ([
                "action":               "$N 揮舞 $w, 往 $n 的 $l 用力一打",
		"damage_type":	"挫傷",
//		"post_action":	(: call_other, __FILE__, "bash_weapon" :),
		]),
	"crush": ([
                "action":               "$N 高舉 $w, 往 $n 的 $l 當頭砸下",
		"damage_type":	"挫傷",
//		"post_action":	(: call_other, __FILE__, "bash_weapon" :),
		]),
	"slam": ([
                "action":               "$N 手握 $w, 眼露兇光, 猛地對準 $n 的 $l 揮了過去",
		"damage_type":	"挫傷",
//		"post_action":	(: call_other, __FILE__, "bash_weapon" :),
		]),
	"throw": ([
                "action":               "$N 將 $w 對準 $n 的 $l 射了過去",
		"damage_type":	"刺傷",
		"post_action":	(: call_other, __FILE__, "throw_weapon" :),
		]),
	"bow_shoot": ([
                "action":               "$N 將 $w 瞄準 $n 的 $l 射了過去",
		"damage_type":	"刺傷",
//		"pre_action":  (: call_other, __FILE__, "pre_bow_weapon" :),
//		"post_action":	(: call_other, __FILE__, "bow_weapon" :),
		]),
        "gun_shoot": ([
                "action":               "$N 舉起 $w 瞄準 $n 的 $l, 扣下扳機開火",
                "damage_type":  "槍傷",
		"pre_action":  (: call_other, __FILE__, "pre_gun_weapon" :),
		"post_action":  (: call_other, __FILE__, "gun_weapon" :),
		]),
        "explode": ([
                "action":               "$N 將 $w 對準 $n 投過去",
                "damage_type":  "炸傷",
//		"pre_action":  (: call_other, __FILE__, "pre_explosive_weapon", :)
//              "post_action":  (: call_other, __FILE__, "explosive_weapon" :),
		]),
        "laser": ([
                "action":               "$N 舉起 $w 瞄準 $n 的 $l, 一道光束直射過去",
                "damage_type":  "灼傷",
//		"pre_action":  (: call_other, __FILE__, "pre_optical_weapon" :),
//              "post_action":  (: call_other, __FILE__, "optical_weapon" :),
		]),
        "fire": ([
                "action":               "$N 舉起 $w 瞄準 $n, 開炮 !!",
                "damage_type":  "炸傷",
//		"pre_action":  (: call_other, __FILE__, "pre_cannon_weapon" :),
//              "post_action":  (: call_other, __FILE__, "cannon_weapon" :),
		]),
        "burn": ([
                "action":               "$N 拿起 $w 瞄準 $n, 開火 !!",
                "damage_type":  "灼傷",
//		"pre_action":  (: call_other, __FILE__, "pre_high_energy_weapon" :),
//              "post_action":  (: call_other, __FILE__, "high_energy_weapon" :),
		]),

]);

void create()
{
	seteuid(getuid());
	set("name", "武器精靈");
	set("id", "weapond");
}

mapping query_action( object weapon )
{
	string verb, *verbs;

	verbs = weapon->query("verbs");

	if( !arrayp(verbs) )
		return weapon_actions["hit"];
	else {
		verb = verbs[random(sizeof(verbs))];
		if( mapp(weapon_actions[verb]) )
			return weapon_actions[verb];
		else return weapon_actions["hit"];
	}	
}

void pre_gun_weapon(object me, object victim, object weapon, int damage)
{
	int malfunction;

	if( objectp(weapon) ) {
		if( (int)weapon->query("ammo") <= 0 ) {
			tell_object(me, HIM "\n" + weapon->query("name") + "的彈匣裡沒有子彈 !\n\n" NOR );
			weapon->unequip();
			me->reset_action();
			return;
		}
		if( !( malfunction = weapon->query("malfunction") ) )
			malfunction = 100;
		if( random( malfunction ) == 0 )
			weapon->set("broken", 1 );
	}
	return;
}

void gun_weapon(object me, object victim, object weapon, int damage)
{
	if( objectp(weapon) ) {
		if( (int)weapon->query("ammo") <= 0 ) {
			tell_object(me, HIM "\n" + weapon->query("name") + "的子彈用完了!\n\n" NOR);
			weapon->unequip();
			me->reset_action();
		}
		else weapon->add("ammo", -1);
	}
	tell_object(me, sprintf("ammo: %d\n", weapon->query("ammo") ) );
	return;
}

void throw_weapon(object me, object victim, object weapon, int damage)
{
	if( objectp(weapon) ) {
		if( (int)weapon->query_amount()==1 ) {
			weapon->unequip();
			tell_object(me, "\n你的" + weapon->query("name") + "用完了!\n\n");
		}
		weapon->add_amount(-1);
	}
}

