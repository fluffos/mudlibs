// robot.c
//
//      NOTE: robot has no initial limbs, limbs_hit, limbs_eff_hit,
//	and limbs_max_hit defined, you must define it yourself.
//	Critical limbs must be limbs[0] and limbs[1].

#include <race/robot.h>

void setup_robot(object ob)
{
	mapping my;

	my = ob->query_entire_dbase();

	my["unit"] = "個";

// You should define your robot's limbs your own.

	my["limbs"] = ({ "感應器", "主體", "移動部", });
	my["limb_cns"] = ({ 0, });
	my["limb_trunk"] = ({ 1 });
	my["limb_movement"] = ({ 2 });
	
	if( undefinedp(my["gender"]) ) my["gender"] = "無性";
	if( undefinedp(my["age"]) ) my["age"] = random(10);
        if( undefinedp( my["level"])) my["level"] = 1;
        if( undefinedp( my["combat_exp"])) my["combat_exp"] = my["level"] * random(100);

        if( undefinedp(my["str"]) ) my["str"] = random(20) + 5;
        if( undefinedp(my["int"]) ) my["int"] = random(10);
	if( undefinedp(my["con"]) ) my["con"] = random(16) + 10;
        if( undefinedp(my["dex"]) ) my["dex"] = random(20) + 5;
        if( undefinedp(my["tec"]) ) my["tec"] = random(15);
	if( undefinedp(my["not"]) ) my["not"] = random(16) + 10;

        if( undefinedp(my["basic_dp"]) ) my["basic_dp"] = 40 + ( my["dex"]- 15)/ 3 * 10;
        if( undefinedp(my["basic_ap"]) ) my["basic_ap"] = 60 + ( my["dex"]- 15)/ 3 * 10;
	if( undefinedp(my["round"]) ) my["round"] = 1;
	if( undefinedp(my["dice_number"]) ) my["dice_number"] = 1;
	if( undefinedp(my["dice_roll"]) ) my["dice_roll"] = 10;
	if( undefinedp(my["damage_bonus"]) ) my["damage_binus"] = 
		(my["str"]-13)/2;
	if( undefinedp(my["range"]) ) my["range"] = 0;

	if( undefinedp(my["max_spi"]) ) {
		my["max_spi"] = my["int"] * 6 + my["not"] * 5;
	}

	if( undefinedp(my["max_mov"]) ) {
		my["max_mov"] = 50 + my["dex"] * 5 + my["con"] * 3;
	}

//      ob->init_limbs(LIMBS);
	if( !ob->query_weight() ) ob->set_weight(BASE_WEIGHT + (my["str"] - 10)* 2000);
}

