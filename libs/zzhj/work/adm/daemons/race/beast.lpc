// beast.c
//
//      NOTE: beast has no initial limbs and limbs_max_hit,
//	limbs_eff_hit & limbs_hit defined,
//      you must define it yourself.
//	P.S. Critical limbs must be limbs[0] and limbs[1].
//      ob->init_limbs(LIMBS);

#include <race/beast.h>

mapping combat_action =
([
	"hoof": ([
                "action":               "$N 用後腿往 $n 的 $l 用力一蹬",
		"damage_type":	"瘀傷",
	]),
	"bite": ([
                "action":               "$N 撲上來張嘴往 $n 的 $l 狠狠地一咬",
		"damage_type":	"咬傷",
	]),
	"claw": ([
                "action":               "$N 用爪子往 $n 的 $l 一抓",
		"damage_type":	"抓傷",
	]),
	"poke": ([
                "action":               "$N 用嘴往 $n 的 $l 一啄",
		"damage_type":	"刺傷",
	]),
]);

string *actions;

void create()
{
	actions = keys(combat_action);
}

void setup_beast(object ob)
{
	mapping my;

	my = ob->query_entire_dbase();

	my["unit"] = "隻";

// You should define your beast's limbs your own.

	my["limbs"] = ({ "頭部", "身體", "左前腿", "右前腿", "左後腿", "右後腿" });
	my["limb_cns"] = ({ 0, });
	my["limb_trunk"] = ({ 1 });
	my["limb_movement"] = ({ 2, 3, 4, 5 });

	if( undefinedp(my["actions"]) ) {
		if( pointerp(my["verbs"]) )
			ob->set("default_actions", (: call_other, __FILE__, "query_action" :) );
		else
			my["default_actions"] = ([
				"action": "$N攻擊$n的%s﹐%s\n",
			]);
	}
	
	if( undefinedp( my["gender"]) ) my["gender"] = "雄性";
	if( undefinedp( my["age"]) ) my["age"] = random(40) + 5;
        if( undefinedp( my["level"])) my["level"] = 1;
        if( undefinedp( my["combat_exp"])) my["combat_exp"] = my["level"] * random(100);
	if( undefinedp( my["score"])) my["score"] = random( my["level"]);

        if( undefinedp(my["str"]) ) my["str"] = random(20) + 10;
        if( undefinedp(my["dex"]) ) my["dex"] = random(20) + 10;
        if( undefinedp(my["int"]) ) my["int"] = random(5) + 3;
        if( undefinedp(my["not"]) ) my["not"] = random(10);
        if( undefinedp(my["con"]) ) my["con"] = random(20) + 5;
        if( undefinedp(my["tec"]) ) my["tec"] = random(5);

        if( undefinedp(my["basic_dp"]) ) my["basic_dp"] = 40 + ( my["dex"]-15)* 10/ 3;
        if( undefinedp(my["basic_ap"]) ) my["basic_ap"] = 60 + ( my["dex"]-15)* 10/ 3;
	if( undefinedp(my["round"]) ) my["round"] = 1;
	if( undefinedp(my["dice_number"]) ) my["dice_number"] = 1;
	if( undefinedp(my["dice_roll"]) ) my["dice_roll"] = 5;
	if( undefinedp(my["damage_bonus"]) ) my["damage_binus"] = 
		(my["str"]-13)/2;
	if( undefinedp(my["range"]) ) my["range"] = 1;

	if( undefinedp(my["max_spi"]) ) {
		my["max_spi"] = my["int"] * 2 + my["wis"] * 2 + my["not"] * 5;
	}

	if( undefinedp(my["max_mov"]) ) {
		my["max_mov"] = my["dex"] * 5 + my["con"] * 2;
	}

	if( !ob->query_weight() ) ob->set_weight(BASE_WEIGHT + (my["str"] - 10)* 2000);
}

mapping query_action(object me)
{
	string *act;

	act = me->query("verbs");
	return combat_action[act[random(sizeof(act))]];
}
