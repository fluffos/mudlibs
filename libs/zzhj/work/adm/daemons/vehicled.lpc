// vehicled.c

#include <vehicle.h>

void create() { seteuid(getuid()); }

void setup_vehicle(object ob)
{
	int *armors_max_hit;

	armors_max_hit = ob->query("armors_max_hit");
	if( undefinedp( ob->query("armors_hit")) )
		ob->set("armors_hit", armors_max_hit);

	if( !ob->query_max_encumbrance() )
		ob->set_max_encumbrance( ob->query_weight() / 2 );
}

varargs object make_trash(object victim, object killer)
{
	int i;
	object trash, *inv;

		inv = all_inventory(victim);
		inv->vehicle_is_destroyed(killer);
		inv -= ({ 0 });
		i = sizeof(inv);
		while(i--) inv[i]->move(environment(victim));
		return 0;

	trash = new(TRASH_OB);
	trash->set_name( victim->name(1) + "的殘骸", ({ "trash" }) );
	trash->set("long", victim->long()
		+ "然而, " + victim->short() 
		+ "已經壞了, 剩下殘骸堆在這裡.\n");
	trash->set("victim_name", victim->name(1));
	trash->set_weight( victim->query_weight() );
	trash->set_max_encumbrance( victim->query_max_encumbrance() );
	
	return trash;
}
