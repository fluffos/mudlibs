#pragma save_binary

inherit F_DBASE;
inherit F_SAVE;

#define STARS DATA_DIR + "stars";

//string *registered_ships = ({});
mapping common_spaces = ([]);

void create();
string query_save_file() { return STARS; }
mapping query_all_stars();
string query_star_file( int *coord );
mixed query_star_coord( string file );
void remove_star( int *coord, string file );
void add_star( int *coord, string file );
void register_ship( object ship );
void heart_beat();

void create()
{
	seteuid(getuid());
	restore();
//	set_heart_beat(300);
}

mapping query_all_stars()
{
	return query("star_coords");
}

string query_star_file( int *coord )
{
	return query("star_files/" + sprintf("%d#%d#%d", coord[0], coord[1], coord[2] ) );
}

mixed query_star_coord( string file )
{
	mapping coords;

	coords = query("star_coords");
	return coords[file];
}

void remove_star( int *coord, string file )
{
	mapping coords;

	delete("star_files/" + sprintf("%d#%d#%d", coord[0], coord[1], coord[2] ) );
	coords = query("star_coords");
	map_delete( coords, file );
	set("star_coords", coords );
	save();
}

void add_star( int *coord, string file )
{
	mapping coords;

	coords = query("star_coords");
	if( !mapp(coords) )
		coords = ([ ]);
	coords += ([ file : coord ]);
	set("star_files/" + sprintf("%d#%d#%d", coord[0], coord[1], coord[2] ), file );
	set("star_coords", coords );
	save();
}

object query_common_space( int *coord )
{
	return common_spaces[sprintf("%d#%d#%d", coord[0], coord[1], coord[2] )];
}

void add_common_space( object space, int *coord )
{
	if( !space )
		return;
	common_spaces += ([ sprintf("%d#%d#%d", coord[0], coord[1], coord[2] ) : space ]);
	return;
}

void remove_common_space( object space, int *coord )
{
	if( !space )
		return;
	map_delete( common_spaces, sprintf("%d#%d#%d", coord[0], coord[1], coord[2] ) );
	destruct( space );
	return;
}

