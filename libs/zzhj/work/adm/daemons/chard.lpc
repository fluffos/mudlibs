// chard.c

#include <race.h>

void create() { seteuid(getuid()); }
void setup_char(object ob)
{
	string race;
	mapping my;

	if( !stringp(race = ob->query("race")) ) {
		race = "人類";
		ob->set("race", "人類");
	}
		
	switch(race) {
		case "人類":
			HUMAN_RACE->setup_human(ob);
			break;
		case "機械":
			ROBOT_RACE->setup_robot(ob);
			break;
		case "野獸":
			BEAST_RACE->setup_beast(ob);
			break;
		default:
			error("Chard: undefined race " + race + ".\n");
	}

	my = ob->query_entire_dbase();

	if( undefinedp(my["spi"]) ) my["spi"] = my["max_spi"];
	if( undefinedp(my["mov"]) ) my["mov"] = my["max_mov"];


	if( undefinedp(my["eff_spi"]) ) my["eff_spi"] = my["max_spi"];
	if( undefinedp(my["eff_mov"]) ) my["eff_mov"] = my["max_mov"];


	if( !ob->query_max_encumbrance() )
		ob->set_max_encumbrance( my["str"] * 5000 );

	if( undefinedp ( my["food"] ) ) 
		my["food"] = ob->max_food_capacity();
	if( undefinedp ( my["water"] ) ) 
		my["water"] = ob->max_water_capacity();

	ob->reset_action();
}

varargs object make_corpse(object victim, object killer)
{
	int i;
	object corpse, *inv;

	if( victim->is_ghost() ) {
		inv = all_inventory(victim);
		inv->owner_is_killed(killer);
		inv -= ({ 0 });
		i = sizeof(inv);
		while(i--) inv[i]->move(environment(victim));
		return 0;
	}

	corpse = new(CORPSE_OB);
	corpse->set_name( victim->name(1) + "的屍體", ({ "corpse" }) );
	corpse->set("long", victim->long()
		+ "然而, " + gender_pronoun(victim->query("gender")) 
		+ "已經死了, 剩下屍體躺在這裡.\n");
	corpse->set("age", victim->query("age"));
	corpse->set("gender", victim->query("gender"));
	corpse->set("victim_name", victim->name(1));
	corpse->set_weight( victim->query_weight() );
	corpse->set_max_encumbrance( victim->query_max_encumbrance() );
	if( userp( victim ) ) corpse->set("player", 1 );
	corpse->move(environment(victim));
	
// Don't let wizard left illegal items in their corpses.
	if( !wizardp(victim) ) {
		inv = all_inventory(victim);
		inv->owner_is_killed(killer);
		inv -= ({ 0 });
		i = sizeof(inv);
		while(i--) {
			if( (string)inv[i]->query("equipped")=="worn" ) {
				inv[i]->move(corpse);
				if( !inv[i]->wear() ) inv[i]->move(environment(victim));
			}
			else inv[i]->move(corpse);
		}
	}

	return corpse;
}
