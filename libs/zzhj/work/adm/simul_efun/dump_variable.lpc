
varargs string dump_variable(mixed arg, int indent, int flag)
{
	mapping list, tlist; 
   	mixed  index, *klist, *tlist2;
   	string rtn, spaces, text;
   	int i, loop;
   
	if (indent) spaces="\t\t\t\t\t\t\t\t\t\t\t\t\t"[0..indent-1];
		else spaces="";
		rtn="";
   	if(objectp(arg)){
   		if( flag == 1 ){

			list = (mapping)arg->query_entire_dbase();
   			tlist = (mapping)arg->query_entire_temp_dbase();
   			if( (!list || !mapp(list)) && (!tlist || !mapp(tlist)))
   	   			return "此物件並沒有任何的資料。\n";
 
   			if (sizeof(list))
   			{
   				klist = keys(list);
   				klist = sort_array(klist, "sort_keys", arg);
   			}
	
   			if (sizeof(tlist))
   			{
    				tlist2 = keys(tlist);
   				tlist2 = sort_array(tlist2, "sort_keys", arg);
   			}
 
   			if(!klist || !sizeof(klist))
     				return "此物件並沒有儲存任何資料。\n";
 
 			text = "Object : " + base_name(arg) + ".c\n";
 			
     			for(loop=0; loop<sizeof(klist); loop++)  {
     					if(strlen(klist[loop]) > 7)  text += klist[loop] + "\t: ";
       						else text += klist[loop] + "\t\t: ";
        				text +=sprintf("%O \n",list[ klist[loop] ]);
     				}
     			text += "\n總共有 " + sizeof(klist) + " 個儲存的資料。\n\n";
 
     			text += "TEMP DATA :\n\n";
 
     			for(loop=0; loop<sizeof(tlist2); loop++)  {
       				if(strlen(tlist2[loop]) > 7)  text += tlist2[loop] + "\t: ";
       				else text += tlist2[loop] + "\t\t: ";
         			text +=sprintf("%O \n",tlist[ tlist2[loop] ]); 
     				}
     			text += "\n總共有 " + sizeof(tlist2) + " 個暫存的資料。\n\n";
   			
   			return text;
   		} 
   		else return "("+file_name(arg)+")";
   	}
    	if(stringp(arg))
		return "\""+arg+"\"";
   
   	if(intp(arg))
      		return "#"+arg;
   
   	if(pointerp(arg))
   	{
		if (indent==0)
		rtn = "ARRAY:";
      
      		for(i = 0; i < sizeof(arg); i++)
		{
			rtn+="\n";
			rtn+=spaces;
			rtn+="["+i+"] == "+dump_variable(arg[i],indent+1);
		}
      
      	return rtn;
   	}

   	if(mapp(arg))
   	{
		if (indent==0)
			rtn="MAPPING:";

      		index = keys(arg);

      		for(i = 0; i < sizeof(index); i++)
		{
			rtn +="\n";
			rtn+=spaces;
			rtn+="["+dump_variable(index[i],0)+"] == "+dump_variable(arg[index[i]],indent+1);
		}

      	return rtn;
   	}
   	if (floatp(arg)) {
      		return "%"+arg ;
   	}
   	return "UNKNOWN";
}

// This function is used to sort the key array.

nosave int sort_keys(string one, string two) {
	return strcmp(one, two);  }

//  This function strips out the secured props from the data array. 

nosave int filter_props(string prop, object target) { 

//   if(member_array((int)target->query_permission(prop),
//      ({ MASTER_ONLY, PRIVATE, OWNER_ONLY })) != -1)   return 0;
	
	return 1; } 
