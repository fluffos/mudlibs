// room.c
// Standard room object.
// Original ES2 mudlib code
// Last modified by Spock @ FF	98.Aug.27.

#pragma save_binary

#include <dbase.h>

inherit F_DBASE;
inherit F_DOOR;
inherit F_CLEAN_UP;

int query_max_encumbrance() { return 100000000000; }

object make_inventory(string file)
{
	object ob;

	ob = new(file);
	ob->move(this_object());
	ob->set("startroom", base_name(this_object()));
	return ob;
}

void reset()
{
	mapping ob_list, ob;
	string *list;
	int i,j;
	mixed local;

//
// Check loaded objects to match the objects specified in "objects"
// while query("objects") is 
// ([ <object filename>: <amount>, ..... ])
// and query_temp("objects") is
// ([ <object filename>: ({ob1, ob2, ...}), .... ])
//
	if( query("docking_ship") )
		return;
	ob_list = query("objects");
	if( !mapp(ob_list) ) {
// after all need to reset, we find we didnt do any reset
// so we put the reset time forward a long time :)
// to avoid reset lag, Idea by Jesse@Doom 1998/3/21
	        if( function_exists("reset", this_object() ) == "/std/room" ) {
                	set_reset(this_object(), 86400);
                }
// Code above is written by Jesse @ Doom, posted on Taiwan BBS InstallMUD board.
		return;
	}
	if( !mapp(ob = query_temp("objects")) )
		ob = allocate_mapping(sizeof(ob_list));
	list = keys(ob_list);
	i = sizeof(list);
	while( i-- ) {
// Allocate an array if we have multiple same object specified.
		if(	undefinedp(ob[list[i]])
		&&	intp(ob_list[list[i]])
		&&	ob_list[list[i]] > 1 )
			ob[list[i]] = allocate(ob_list[list[i]]);

		switch(ob_list[list[i]]) {
		case 1:
			if( !ob[list[i]] ) ob[list[i]] = make_inventory(list[i]);
			if( environment(ob[list[i]]) != this_object()
			&&	ob[list[i]]->is_character() ) {
				if( !ob[list[i]]->return_home(this_object()) )
					add("no_clean_up", 1);
			}
			break;
		default:
			j = ob_list[list[i]];
			while( j-- ) {
// If the object is gone, make another one.
				if( !objectp(ob[list[i]][j]) ) {
					ob[list[i]][j] = make_inventory(list[i]);
					continue;
				}
// Try to call the wandering npc come back here.
				if( environment(ob[list[i]][j]) != this_object()
				&&	ob[list[i]][j]->is_character() ) {
					if( !ob[list[i]][j]->return_home(this_object()) )
						add("no_clean_up", 1);
				}
			}
		}
	}
	set_temp("objects", ob);
}

void setup()
{
	mixed room_doors;

	seteuid(getuid());
	this_object()->reset();
	if( !(int)query("mov_cost") ) 
		set("mov_cost", 10 );
	if( room_doors = query("doors") ) {
		setup_doors( room_doors );
	}
}
