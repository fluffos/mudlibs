// boarding_tube.c
// Standard space station boarding tube object.
// Author: Spock @ FF	98.Aug.25.
// Last modified by Spock @ FF	98.Aug.27.

inherit ROOM;

void init()
{
	seteuid( getuid() ); 
	setup();
}

void setup()
{
	string ship_file, space_file, station_file;
	object station, space, ship;
	string msg;

	::setup();
	if( stringp( ship_file = query("docking_ship_file") )
		&& stringp( station_file = query("space_station") ) ) {

		space_file = query("space_station_location");
		call_other( space_file, "???" );
		space = find_object( space_file );

		if( objectp( query("docking_ship") ) )
			return;
		ship = new( ship_file );

		station = find_object( station_file );
		ship->docking( station->query("id") );
	}
	return;
}
