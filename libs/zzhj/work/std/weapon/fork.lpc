// fork.c

#include <weapon.h>
#include <dbase.h>

inherit WEAPON;

varargs void init_fork(int damage, int flag)
{
	if( clonep(this_object()) ) return;

	set("weapon_prop/damage", damage);
	set("flag", (int)flag | EDGED);
	set("skill_type", "melee_weapon");
	set("damage_type", "traditional");
	set("unknown_type", "鋼叉");
	if( !query("max_durability") )
		set("max_durability", 700 );
	if( !query("durability") )
		set("durability", 700 );
	if( !query("attack") )
		set("attack", 75 );
	if( !query("defence") )
		set("defense", 60 );

	set("verbs", ({ "thrust", "pierce", "impale" }) );
}
