// whip.c

#include <weapon.h>
#include <dbase.h>

inherit WEAPON;

varargs void init_whip(int damage, int flag)
{
	if( clonep(this_object()) ) return;

	set("weapon_prop/damage", damage);
	set("flag", (int)flag);
	set("skill_type", "melee_weapon");
	set("damage_type", "traditional");
	set("unknown_type", "長鞭");
	if( !query("max_durability") )
		set("max_durability", 700 );
	if( !query("durability") )
		set("durability", 700 );
	if( !query("attack") )
		set("attack", 75 );
	if( !query("defence") )
		set("defense", 60 );

	set("verbs", ({ "whip", "wave" }) );
}
