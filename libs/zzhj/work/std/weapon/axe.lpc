// axe.c

#include <weapon.h>
#include <dbase.h>

inherit WEAPON;

varargs void init_axe(int damage, int flag)
{
	if( clonep() ) return;

	set("weapon_prop/damage", damage);
	set("flag", (int)flag | EDGED);
	set("skill_type", "melee_weapon");
	set("damage_type", "traditional");
	set("unknown_type", "斧頭");
	if( !query("max_durability") )
		set("max_durability", 1000 );
	if( !query("durability") )
		set("durability", 1000 );
	if( !query("attack") )
		set("attack", 50 );
	if( !query("defence") )
		set("defense", 50 );
	if( !query("armor_piercing") )
		set("armor_piercing", 50 );

	set("verbs", ({ "chop", "slice", "hack" }) );
}

