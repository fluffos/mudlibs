// item.c

#include <dbase.h>
#include <move.h>
#include <name.h>

inherit F_CLEAN_UP;
inherit F_DBASE;
inherit F_MOVE;
inherit F_NAME;

void setup()
{
	seteuid(getuid());
	if( clonep() && !query_default_object())
		set_default_object(base_name(this_object()));
	else {
		if( !query("unit") ) set("unit", "個");
	}
	set("unknown_type", "物品");
	return;
}

int query_autoload() { return 1; }

int identify( object me, object ob)
{
	if( me->query_skill("identify") >= ob->query("identify"))
		return 1;
	else return 0;
}
