// shield.c

#include <armor.h>

inherit ARMOR;

void setup()
{
	if( clonep(this_object()) ) return;

	set("armor_type", TYPE_SHIELD);
	if( !query("armor_apply/dodge")
	&&	weight() > 1000 )
		set("armor_prop/dodge", - weight() / 1000 );

	set("unknown_type", "盾牌" );
	if( !query("durability") ) 
		set("durability", 500 );
	if( !query("max_durability") ) 
		set("max_durability", 500 );
	if( query("armor_prop/traditional_armor") ) 
		delete("armor_prop/traditional_armor");
	if( !query("armor_prop/traditional_resist") ) 
		set("armor_prop/traditional_resist", 90 );
}
