// enterprise_2.c

inherit SS_ROOM;

void create()
{
	set("short", "企業號中央走道");
	set("long", @LONG
這裡是企業號中央的走道 (main access) , 通往艦上各處.
up: 往艦橋, tube: 往登艦門, beam: 往輸送室, down: 往輪機室.
LONG
	);

	set("exits", ([
		"up"	:	__DIR__"enterprise_1",
		"tube"	:	__DIR__"enterprise_3",
		"beam"	:	__DIR__"enterprise_4",
		"down"	:	__DIR__"enterprise_5",
	]) );

	setup();
}
