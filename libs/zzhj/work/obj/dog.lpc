// dog.c

inherit NPC;

string *gender = ({ "雄性", "雌性" });

void create()
{
	set_name("野狗", ({ "dog" }) );
	set("race", "野獸");
	set("gender", gender[random(sizeof(gender))]);
	set("age", 3);
	set("long", "一隻渾身髒兮兮的野狗.\n");
	
	set("str", random(10)+6);
	set("dex", random(10)+6);

	set("limbs", ({ "頭部", "身體", "前腳", "後腳"}) );
	set("verbs", ({ "bite", "claw" }) );
	set("limbs_max_hit", ({ 15, 20, 13, 13 }));
	set("limbs_eff_hit", ({ 15, 20, 13, 13 }));
	set("limbs_hit", ({ 15, 20, 13, 13 }));
	
	set_temp("apply/attack", 3);
        set_temp("armor", 1);

	setup();
}
