// platinum.c

inherit MONEY;

void create()
{
        set_name("鉑幣", ({"platinum", "platinum_coin", "platinum_money" }));
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("money_id", "platinum");
                set("long", "極為罕見的梅尼亞克鑄造的鉑幣, 十分珍貴.\n");
                set("unit", "些");
		set("base_value", 1000000);
                set("base_unit", "枚");
                set("base_weight", 5);
	}
	set_amount(1);
}

