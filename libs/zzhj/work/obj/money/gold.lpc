// gold.c

inherit MONEY;

void create()
{
        set_name("金幣", ({"gold", "gold_coin", "gold_money" }));
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("money_id", "gold");
                set("long", "梅尼亞克市鑄造的金幣, 份量和純度十足.\n");
		set("unit", "些");
		set("base_value", 10000 );
                set("base_unit", "枚");
                set("base_weight", 10);
	}
	set_amount(1);
}

