// waterskin.c

inherit F_CONTAINER;

void create()
{
	set_name("牛皮水袋", ({ "waterskin", "water", "skin" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一個牛皮縫的大水袋, 大概裝得下十公升的水.\n");
		set("unit", "個");
		set("value", 10);
		set("max_liquid", 20);
	}

// The liquid contained in the container is independent, we set a copy
// in each cloned copy.
	set("liquid", ([
		"type": "water",
		"name": "清水",
		"remaining": 20,
	]) );
}
