// gun_clip.c

inherit ITEM;

#include <weapon.h>

int is_container() { return 1; }
int is_clip() {return 1; }

void create()
{
	set_name("手槍彈夾", ({ "clip" }) );
	set_weight( 100);
	set_max_encumbrance( 1000);
	set("long", "這是一個巫師測試用手槍的彈夾.\n");
	set("unit", "個");
	set("value", 50000);
	set("weapon_type", GUN);
	set("ammo", "/obj/weapon/projectile/gun_ammo.lpc");
	set("max_ammo", 10);
	seteuid(getuid());
}
