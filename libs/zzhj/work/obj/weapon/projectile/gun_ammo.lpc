// dust.c

#include <weapon.h>

inherit COMBINED_ITEM;

int is_ammo() { return 1; }

void create()
{
	set_name("手槍子彈", ({"ammo"}));
	set("long", "這是一顆巫師測試用手槍的子彈.\n");
	set("value", 500);
	set("weapon_type", GUN);
	set("unit", "些");
	set("base_unit", "顆");
	set("base_weight", 100);
	set_amount(1);
}
