// pistel.c

#include <weapon.h>

inherit GUN;

void create()
{
	set_name("測試用手槍", ({ "pistel" }) );
	set_weight(900);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "枝");
                set("long", "這是一枝巫師測試用的手槍.\n");
		set("value", 100000);
                set("material", "鋼");
		set("weapon_type", GUN);
		set("clip", "/obj/weapon/projectile/pistel_clip.lpc");
		set("identify", 10);
                set("wield_msg", "$N 從腰際抽出一把 $n 握在手中.\n");
                set("unwield_msg", "$N 將手中的 $n 插入腰際的槍套.\n");
	}
        init_gun(3, 10, 10, 1, 50);
	setup();
}
