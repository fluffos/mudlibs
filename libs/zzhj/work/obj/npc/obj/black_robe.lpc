// black_robe.c
//
// This is the black cloth for Doromy.

#include <armor.h>

inherit CLOAK;

void create()
{
	set_name( "[1;30;47m黑袍[0;37;40m", ({ "black robe", "black", "robe" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("long", "一件絲織的黑色袍子, 反光閃閃發亮.\n");
		set("material", "silk");
		set("value", 100000);
		set("armor_prop/dp", 50);
		set("armor_prop/traditional_armor", 50);
		set("armor_prop/projectile_armor", 50);
		set("armor_prop/high_energy_armor", 50);
		set("armor_prop/optical_armor", 50);
		set("armor_prop/explosive_armor", 50);
		set("armor_prop/defense", 20);
	}
	setup();
}
