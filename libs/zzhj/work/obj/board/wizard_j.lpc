// wizard_j.c

inherit BULLETIN_BOARD;

void create()
{
	set_name("工友排班、計畫報告板", ({ "board" }) );
	set("board_id", "wizard_j");
	set_weight(20000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "這是一個供工友排班、計畫的留言板.\n" );
		set("unit", "個");
		set("capacity", 100);
		set("value", 10 );
	}
	setup();
}
