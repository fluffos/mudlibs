// query_b.c

inherit BULLETIN_BOARD;

void create()
{
	set_name("意見反應留言板", ({ "board" }) );
	set("board_id", "query_b");
	set_weight(20000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "這是一個供人留言記事的留言板.\n" );
		set("unit", "個");
		set("capacity", 100);
		set("value", 10 );
	}
	setup();
}
