// corpse.c

inherit ITEM;

int decayed;

void create()
{
	set_name("無名屍體", ({ "corpse" }) );
	set("long", "這是一具無名屍.\n");
	set("unit", "具" );
	decayed = 0;
	if( clonep(this_object()) ) call_out("decay", 120, 1);
}

int is_corpse() { return decayed < 2; }
int is_character() { return decayed < 1; }
int is_container() { return 1; }

string short() { return name() + "(" + capitalize(query("id")) + ")"; }

void decay(int phase)
{
	decayed = phase;
	switch(phase) {
		case 1:
			say( query("name") + "開始腐爛了﹐發出一股難聞的惡臭.\n" );
			switch(query("gender")) {
				case "男性":
					set_name("腐爛的男屍", ({ "corpse", "屍體" }) );
				case "女性":
					set_name("腐爛的女屍", ({ "corpse", "屍體" }) );
				default:
					set_name("腐爛的屍體", ({ "corpse", "屍體" }) );
			}
			set("long",	"這具屍體顯然已經躺在這裡有一段時間了, 正散發著一股腐屍的臭味.\n");
			if( query("player") ) 	
				call_out("decay", 1200, phase + 1);
			else 
				call_out("decay", 120, phase + 1);
			break;
		case 2:
			message_vision_exclude("$N 筋肉已經爛光了, 成為一具骸骨.\n", this_object(), ({ this_object() }) );
			set_name("一具枯乾的骸骨", ({ "skeleton", "骸骨" }) );
			set("long", "這付骸骨已經躺在這裡很久了.\n");
			if( query("player") ) 			
				call_out("decay", 600, phase + 1);
			else
				call_out("decay", 60, phase + 1);
			break;
		case 3:
			message_vision_exclude( "一陣風吹過, 把 $N 化成骨灰吹散了。\n", this_object(), ({ this_object() }) );
			if( environment() ) {
				object *inv;
				int i;
				
//				inv = all_inventory(this_object());
//				for(i=0; i<sizeof(inv); i++) inv[i]->move(environment());
			}
			destruct(this_object());
			break;
	}
}

