// battle_armor.c

#include <armor.h>

inherit ARMOR;

void create()
{
        set_name( "[1;31m戰鬥裝甲[0;37;40m", ({ "battle_armor", "b_armor" }) );
	set_weight(10000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "巴比倫城的高科技結晶, 以強化塑鋼打造, 內有電子制動系統.");
		set("unit", "件");
                set("material", "強化塑鋼");
		set("value", 200000);
                set("armor_prop/dodge", 20);
		set("armor_prop/defense", 10);
                set("armor_prop/dp", 100);
		set("armor_prop/armor", 100);
                set("wear_msg", "$N 穿上一件火紅而閃閃發亮的 $n.\n" );
	}
	setup();
}
