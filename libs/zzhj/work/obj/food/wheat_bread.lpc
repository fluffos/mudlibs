// wheat_bread.c

inherit F_FOOD;

void create()
{
	set_name("小麥麵包", ({ "wheat bread", "wheat", "bread" }) );
	set_weight(400);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一塊硬梆梆的小麥麵包.\n");
		set("unit", "塊");
		set("value", 2 );
		set("food/remaining", 4 );
		set("food/supply", 20 );
		set("food/water", 1 );
	}
	setup();
}
