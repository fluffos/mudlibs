// mongolian_barbicue.c

inherit F_FOOD;

void create()
{
	set_name("蒙古烤肉", ({ "mongolian barbicue", "mongolian", "barbicue" }) );
	set_weight(400);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一份香味四逸, 加上許\\多香辛料和蔬菜的蒙古烤肉.\n");
		set("unit", "份");
		set("value", 6 );
		set("food/remaining", 7 );
		set("food/supply", 13 );
		set("food/water", 5 );
	}
	setup();
}
