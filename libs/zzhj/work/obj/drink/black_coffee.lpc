// balck_coffee.c

inherit F_CONTAINER;

void create()
{
	set_name("濃咖啡", ({ "balck coffee", "black", "coffee" }) );
	set_weight(250);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一小杯香醇的濃摩卡咖啡, 並沒有加糖或奶精.\n");
		set("unit", "杯");
		set("value", 10 );
		set("max_liquid", 2 );
		set("destruct_if_empty", 1 );
	}

// The liquid contained in the container is independent, we set a copy
// in each cloned copy.
	set("liquid", ([
		"type": "mocca coffee",
		"name": "摩卡咖啡",
		"remaining": 2,
	]) );
}
