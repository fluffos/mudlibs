// waterskin.c

inherit F_CONTAINER;

void create()
{
	set_name("紅葡萄酒", ({ "grape wine", "wine" }) );
	set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一杯紅葡萄酒.\n");
		set("unit", "杯");
		set("value", 40);
		set("max_liquid", 5);
		set("destruct_if_empty", 1 );
	}

// The liquid contained in the container is independent, we set a copy
// in each cloned copy.
	set("liquid", ([
		"type": "wine",
		"name": "紅葡萄酒",
		"remaining": 5,
	]) );
}
