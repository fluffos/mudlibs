// An example of item making instruction book

inherit ITEM;

void create()
{
	set_name("物品組裝課本", ({ "instruction book", "book", "instruction" }));
	set_weight(200);
	set("unit", "本");
	set("long", @LONG
這是一本巫師測試物品組裝技能的書, 指導你如何把測試物品正確組裝:
測試甲 (targeta) 由 零件甲 (c1), 零件乙 (c2) 組成.
LONG
	);
	set("value", 100);
	set("make", ([
		"name"		: 	"targeta",		// name of the target item
		"cname"		:	"測試甲",		// chinese name of target item
		"base_name"	:	"/obj/targeta",		// file name of target item
		"component_names":	({ "c1", "c2" }),		// component names
		"component_cnames":	({ "零件甲", "零件乙" }),	// component Chinese names
		"component_bnames":	({ "/obj/c1", "/obj/c2" }), // component file names
		"spi_cost"	:	40,			// spi cost for study
		"time_unit_cost":	400,			// time unit cost for study
		"literacy"	:	10,			// literacy needed to read this book
		"skill_name"	:	"make_bomb",		// which skill is needed to learn this
		"skill_level"	:	10,			// skill level required	
	]) );
}
