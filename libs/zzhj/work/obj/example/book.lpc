// An example book

inherit ITEM;

void create()
{
	set_name("螳螂拳譜", ({ "textbook of mantis fist", "textbook", "mantis", "fist" }));
	set_weight(200);
	set("unit", "本");
	set("long", @LONG
螳螂拳的入門拳譜, 繪有各式螳螂拳招的人物動作圖, 並在圖旁加注要訣.
LONG
	);
	set("value", 100);
	set("skill", ([
		"name"		:	"unarmed",	// name of the skill
		"combat_level"	:	10,		// minimum combat level required
		"spi_cost"	:	70,		// spi cost every time study this
		"time_unit_cost":	1000,		// time unit cost
		"leteracy"	:	10,		// literacy required to learn this skill
		"max_level"	:	10,		// the maximum level you can learn from this book
	]) );
}
