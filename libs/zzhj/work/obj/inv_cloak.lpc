// inv_cloak.c
//
// Basic example of invisible equipment.

#include <armor.h>

inherit CLOAK;

void create()
{
	set_name("光學迷彩服", ({ "invis cloak", "cloak", "invis", }) );
        set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "這是在攻殼機動隊中出現過的光學迷彩服, 可以使人隱形.\n");
		set("unit", "件");
                set("value", 650000);
		set("armor_prop/traditional_armor", 3);
		set("armor_prop/invis", 3);
	}
	setup();
}
