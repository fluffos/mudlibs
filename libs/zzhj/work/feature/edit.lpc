// edit.c

#include <function.h>
#include <ansi.h>

#define edit_version "(0.2)"
#define HELP_FILE "/doc/help/input"

void editp(int lines, string text, function callback);

int edit(function callback)
{
	write(GRN"   線上輸入編輯器簡易版"+edit_version+"﹐想看"NOR+HIG"功能說明書"NOR+GRN"請押 '"HIW"~h"NOR+GRN"'。\n"NOR);
	write(GRN"     輸入完了想"NOR+HIG"結束離開"NOR+GRN"請押 '"HIW"."NOR+GRN"'﹐想"NOR+HIG"取消輸入"NOR+GRN"請押 '"HIW"~q"NOR+GRN"'。\n"NOR);
	write(GRN"────────────────────────────\n"NOR);
	if( (functionp(callback) & FP_NOT_BINDABLE)==0 )
		callback = bind(callback, this_object());
	//input_to("input_line", "", callback );
	editp(1,"",callback);
	return 1;
}

private void editp(int lines, string text, function callback)
{
	/* 這個是印出行號..方便輸入的人..*/
//	write(((lines < 10) ? " " : "")+ lines +"> ");
	input_to("input_line", text, callback);
}

void input_line(string line, string text, function callback)
{
	string help_file, *lin;
	int lines, i, start, end;

	lin = explode(text , "\n");
	lines = sizeof(lin)+2; 
	
	if( line=="." ) {
		if( text=="" ) text = "\n";
		if( functionp(callback) & FP_OWNER_DESTED ) 
			write("啟動編輯模式的物件已經消失了﹐輸入取消。\n");
		else if (functionp(callback))
			evaluate(callback, text);
		return;
	} 
	
	if( line=="~q" ) {
		write("嗯...反悔了。\n");
		return;
	} 
	
	if( line=="~h" ) {
		help_file = read_file (HELP_FILE);
		write(help_file);
		lines -= 1;
		editp(lines,text,callback);
		return;
	}
	/* 這個是把已經輸入的顯示出來..*/
	if( line=="~p" ) {
		if(text == ""){
			write("還沒有輸入任何資料.\n");
			lines -= 1;
			editp(lines,text,callback);
			return;
		}			
		write("───這是剛才輸入的───\n");
		lines -= 1;
		for( i=0; i < lines-1 ; i++){
			printf("%2d  %s\n",i+1,lin[i]);
		}
		write("─────────────\n");
		editp(lines,text,callback);
		return;
	}/* 顯示出來的處理 END */
	  
	/* 這個是刪除的處理... */
	if(sscanf(line,"~d%d,%d",start, end) || sscanf(line,"~d%d",start)) {
		if( !end ) end = start;
		lines -= 1;
		if((start < 1) || (start > lines - 1) || (end < start) || ( end > lines - 1) ){
			write("嗯..超出範圍了喔..\n");
			editp(lines,text,callback);
		return;
		}
		printf("Ok..刪除了 第%2d%s",start, 
			(start == end)? "行.\n" : sprintf("行∼第%2d行.\n",end));
		text="";
		for( i=0 ; i < start - 1; i++){
			text += lin[i] + "\n";
		}
		for(i=end ; i < lines-1 ; i++){
			text += lin[i] + "\n" ;
		}
		lines -= ((end+1)-start);
		editp(lines,text,callback);
	return;
	}/* 刪除的處理... END  */
	
		text += line + "\n";
		editp(lines,text,callback);
}
