// vehicle.c

#include <dbase.h>
#include <move.h>
#include <name.h>

inherit F_ACTION;
inherit F_ATTACK;
inherit F_CLEAN_UP;
inherit F_V_DAMAGE;
inherit F_DBASE;
inherit F_MOVE;
inherit F_NAME;

void setup()
{
	seteuid(getuid());
}

int is_vehicle() { return 1; }

int identify( object me, object ob)
{
	if( me->query_skill("identify") >= ob->query("identify"))
		return 1;
	else return 0;
}
