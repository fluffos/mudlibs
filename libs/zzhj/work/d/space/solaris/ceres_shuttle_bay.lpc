// ceres_shuttle_bay.c

inherit SHUTTLE_BAY;

void create()
{
	set("short", "太空梭停泊港");
	set("long", @LONG
    這裡是賽芮絲太空站的太空梭停泊港, 廣大的平台上停泊著各式太空梭.
從太空梭的飛行出口可以看見一望美麗的地球. 飛行出口有力場屏障, 不用
擔心空氣外洩的問題.
LONG
	);

	set("mov_cost", 200 );
	set("space_station_location", __DIR__"earth");
	set("space_station", __DIR__"ceres_space_station");
	set("shuttle_bay", 1 );
	set("landing_site", __DIR__"utopia_space_port" );

	set("exits", ([
		"up"	:	__DIR__"ceres_boarding_hall",
	]) );

	set("objects", ([
		"/obj/ss/s_shuttle"	:	5,
	]) );

	setup();
}
