// ceres_boarding_tube_1.c

inherit BOARDING_TUBE;

void create()
{
	set("short", "一號登艦門");
	set("long", @LONG
    這裡是賽芮絲太空站的第一號登艦門. 從走道兩旁的景觀窗可以看到其他
的登艦通道, 自太空站主結構體延伸至數百公尺外, 連接其他的船艦.
欲登艦請使用 board <艦名> 指令.
LONG
	);

	set("mov_cost", 100 );
	set("boarding_tube", 1 );
	set("docking_ship", 0 );
	set("docking_ship_file", "/obj/ss/enterprise" );
	set("space_station_location", __DIR__"earth");
	set("space_station", __DIR__"ceres_space_station");

	set("exits", ([
               "hall"          : __DIR__"ceres_boarding_hall",
	]) );

	setup();
}
