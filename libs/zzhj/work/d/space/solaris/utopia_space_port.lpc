// utopia_space_port.c

inherit ROOM;

void create()
{
	set("short", "烏托邦宇宙港");
	set("long", @LONG
    這裡是烏托邦宇宙港, 跑道上停著各式太空梭. 地勤人員往來於各架太空
梭, 進行各種起飛前後的準備. 不遠處, 可以看到一間間停放太空梭的機庫.
LONG
	);

	set("mov_cost", 200 );
	set("space_station_location", __DIR__"earth");
	set("space_port", 1 );

	set("objects", ([
		"/obj/ss/s_shuttle"	:	5,
	]) );

	setup();
}
