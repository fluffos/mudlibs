// ceres_boarding_hallc

inherit ROOM;

void create()
{
	set("short", "登艦大廳");
	set("long", @LONG
    這裡是賽芮絲太空站的登艦大廳, 放眼望去共有十個登艦門, 但是目前除
了一號登艦門以外, 其他的門都關著. 從各登艦門之間的景觀窗可以看到登艦
通道自太空站主結構體延伸至數百公尺外, 連接其他的船艦.
LONG
	);

	set("mov_cost", 200 );
	set("space_station_location", __DIR__"earth");

	set("exits", ([
		"1"	:	__DIR__"ceres_boarding_tube_1",
		"down"	:	__DIR__"ceres_shuttle_bay"
	]) );

	setup();
}
