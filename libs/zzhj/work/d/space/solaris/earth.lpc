// earth.c

#include <room.h>

inherit SPACE;
inherit PLANET;

void create()
{
	set("short", "地球");
	set("long", @LONG
地球是人類的發源地, 有著佔地表四分之三的水層. 由於在二
十一世紀中期進入冰河期, 人口總數已經銳減為二十億人. 目前地
球上僅有烏托邦政權 (Utopia) 擁有宇宙航行的能力.

地球是一顆中年的中型行星. 地表成份為固態岩石, 核心成份為融
熔的金屬. 
行星有小規模的地質活動.
LONG
	);
	set("coord_1", ({ 0, 0, 0 }) );
	set("habitability", 1 );
	set("coord", 3 );
	set("env_space", "/d/space/systems/solaris" );
	set("special_space", 1 );
	set("objects", ([
		"/d/space/solaris/ceres_space_station" : 1,
	]) );

	setup();
}
