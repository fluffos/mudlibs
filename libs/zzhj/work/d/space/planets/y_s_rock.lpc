// y_s_rock.c

#include <room.h>

inherit SPACE;
inherit PLANET;

void create()
{
	if( clonep())
		set_default_object(__FILE__);
	else {
		set("short", "小型岩質行星");
		set("long", @LONG
一顆年青的小型行星. 地表成份為固態的岩石, 核心成份為融熔的輕金屬.
行星有頻繁的地質活動.
LONG
		);
		set("habitability", 0 );
	}

	setup();
}
