// m_s_rock.c

#include <room.h>

inherit SPACE;
inherit PLANET;

void create()
{
	if( clonep())
		set_default_object(__FILE__);
	else {
		set("short", "小型岩質行星");
		set("long", @LONG
一顆中年的小型行星. 地表成份為固態岩石, 核心成份為固態的輕金屬.
整個行星無地質活動跡象.
LONG
		);
		set("habitability", 0 );
	}

	setup();
}
