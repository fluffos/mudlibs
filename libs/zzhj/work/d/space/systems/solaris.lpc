// solaris.c

inherit SPACE;

void create()
{
	set("short", "太陽系");
	set("long", @LONG
 [座標] ( 0, 0, 0 )
 [恆星] 太陽 (The Sun), 是一顆中年的恆星 (M 級星球).
 [行星] 九顆, 於第五與第六行星間有小行星帶.
LONG
	);
	set("coord_1", ({ 0, 0, 0, }));

	set("planets/name", ({
		"太陽",
		"水星",	
		"金星",	
		"地球",	
		"火星",	
		"土星",	
		"小行星帶",
		"木星",	
		"天王星",
		"海王星",
		"冥王星",
	}) );
	set("planets/file", ({
		"/d/space/suns/m.lpc",
		"/d/space/planets/m_s_rock.lpc",
		"/d/space/planets/m_m_gas.lpc",
		"/d/space/solaris/earth.lpc",
		"/d/space/planets/m_m_rock.lpc",
		"/d/space/planets/m_l_gas.lpc",
		"/d/space/planets/asteriod.lpc",
		"/d/space/planets/m_h_gas.lpc",
		"/d/space/planets/m_l_gas.lpc",
		"/d/space/planets/m_l_gas.lpc",
		"/d/space/planets/m_m_gas.lpc",
	}) );

	setup();
//	replace_program(SPACE);
}
