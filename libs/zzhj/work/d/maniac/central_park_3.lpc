inherit ROOM;

void create()
{
	set("short", "中央公園");
	set("long", @LONG
    你放眼望去, 是一大片綠油油的草地, 開滿了蒲公英花. 這裡是
市民們常來的地方, 有一群小孩子正在草地上玩耍.
LONG
	);
	set("night_long", @LONG
    你放眼望去, 在夜空下是一大片草地, 開滿了蒲公英花. 這裡是
市民們常來的地方. 草地上有幾個人影.
LONG
	);

	set("mov_cost", 100 );
	set("exits", ([ /* sizeof() == 1 */
		"north" : __DIR__"central_park_2",
		"east"  : __DIR__"central_park_4",
]));

	set("outdoors", 1);
	setup();
}
