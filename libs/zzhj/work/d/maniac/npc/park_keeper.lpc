// park_keeper.c

inherit NPC;

void create()
{
	set_name("老人", ({ "old man", "old", "man", "Micheal Zarasikov", "Micheal",}) );
	set("title", "平民");
	set("gender", "男性" );
	set("age", 53);
	set("long", @LONG
一位高而細瘦的老人, 穿著帶有斑斑點點泥土和灰塵髒污的衣服.
他的臉色看起來非常難看, 面孔因為極度的痛苦而扭曲著.
LONG
	);
	set("str", 5);
	set("dex", 7);
	set("int", 17);
	set("wis", 20);
	set("not", 7);
	set("cha", 12);
	set("con", 8);
	set("tec", 4);
	set("level", 1);
//	set("limbs_max_hit", ({ 30, 20, 30, 30, 20, 20 }));
//	set("limbs_eff_hit", ({ 30, 20, 30, 30, 20, 20 }));
//	set("limbs_hit", ({ 30, 20, 30, 30, 20, 20 }));
//	set("max_mov", 30);
//	set("eff_mov", 3);
	set("combat_exp", 30);
	set("attitude", "friendly");
	set("group", ({"maniac", "maniac_officer"}));
	set("score", 5 );
	set("positive_fame", 20 );
	set("negative_fame", 5 );

	set("inquiry", ([
		"name" : 
"馬...科....\n",
		"job" : 
"...求...瓦..., 嗚...\n",
	]));

	set("chat_chance", 5);
	set("chat_msg", ({
"老人抱著腹部, 痛苦地發出 :...啊......咕...救...我...\n",
"老人坐倒在地上, 無力地說 :...拜......託...\n",
	}) );

	set_skill("literature", 50);
	setup();
	add_money("silver", 1 );
	add_money("copper", 60 );
	carry_object("/obj/coat")->wear();
	carry_object("/obj/pants")->wear();
	carry_object("/d/maniac/npc/obj/cabin_key");
	apply_condition("heart_attack", 20);
}
