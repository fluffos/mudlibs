#include <armor.h>

inherit BOOTS;

void create()
{
	set_name("黑色長靴", ({ "black boots", "black", "boots" }) );
        set_weight( 1000 );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "雙" );
		set("long",
"這是一雙梅尼亞克警備隊員使用的黑色長靴.\n");
                set("value", 50 );
		set("armor_prop/traditional_armor", 5 );
	}
	setup();
}
