// rod.c

#include <weapon.h>

inherit STAFF;

void create()
{
	set_name("警棍", ({ "rod" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "枝");
                set("long", 
"這是一枝梅尼亞克警備隊員的制式警棍, 長 75 公分.\n");
		set("value", 100);
                set("material", "木材");
                set("wield_msg", "$N 從腰間抽出一把 $n 握在手中.\n");
                set("unwield_msg", "$N 將手中的 $n 插入腰間的皮套.\n");
	}
        init_staff( 1, 5, 3, 1, 2);
	setup();
}
