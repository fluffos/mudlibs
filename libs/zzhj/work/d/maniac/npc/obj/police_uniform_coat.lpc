#include <armor.h>

inherit COAT;

void create()
{
	set_name("警備隊員制服上衣", ({ "uniform coat", "uniform", "coat" }) );
        set_weight( 1200 );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件" );
		set("long",
"這是一件黑色的梅尼亞克警備隊員的制服上衣, 左胸前還有一枚警徽.\n");
                set("value", 70 );
		set("armor_prop/traditional_armor", 6 );
	}
	setup();
}
