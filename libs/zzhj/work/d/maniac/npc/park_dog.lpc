// dog.c

inherit NPC;

string *gender = ({ "雄性", "雌性" });

void create()
{
	set_name("褐色的狗", ({ "dog" }) );
	set("race", "野獸");
	set("gender", gender[random(sizeof(gender))]);
	set("age", 3);
	set("long", "一隻渾身髒兮兮, 體型粗壯的褐色野狗.\n");
	
	set("str", random(7)+6);
	set("dex", random(10)+6);

	set("verbs", ({ "bite", "claw" }) );
	set("limbs_max_hit", ({ 15, 20, 13, 13, 15, 15 }));
	set("limbs_eff_hit", ({ 15, 20, 13, 13, 15, 15 }));
	set("limbs_hit", ({ 15, 20, 13, 13, 15, 15 }));
	
	set("chat_chance", 5);
	set("chat_msg", ({
		"褐色的狗向你無力地搖了幾下尾巴.\n",
		"褐色的狗坐到你面前, 雙眼直望著你.\n",
		"褐色的狗把頭往右邊一轉, 豎起了雙耳不知道在傾聽什麼聲音.\n",
		"褐色的狗對你發出嗚嗚的叫聲.\n",
		(: this_object(), "random_move" :),
	}) );
	
	set("chat_msg_combat", ({
		(: this_object(), "random_move" :),
		"褐色的狗對你大聲吠叫: 汪...嗚汪 ! 汪汪汪 !! 嗚汪 !!\n",
		"褐色的狗兩眼直瞪著你, 喉嚨低聲地咕嚕咕嚕著.\n",
	}) );
	set_temp("apply/attack", 3);
        set_temp("armor", 1);

	setup();
}
