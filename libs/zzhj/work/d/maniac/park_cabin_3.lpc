// Room: /d/maniac/park_cabin_3.c
#include <room.h>

inherit ROOM;

void create()
{
	set("short", "小木屋");
	set("long", @LONG
這棟原木建造的小木屋相當地狹小, 屋內的北面有一個壁爐 
(fireplace),  東面有一張木桌 (table)、兩張木椅 (chairs).  而
南面有一張木床 (bed), 床旁有一個小木櫃 (closet).
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "east" : __DIR__"park_cabin_2.lpc",
]));
	set("no_clean_up", 0);
	set("mov_cost", 10 );

	set("detail", ([
		"fireplace":
"這個壁爐是用磚塊堆砌而成, 裡面有一些柴火的餘燼. 在壁爐裡的鐵
架上放有一個小鐵鍋, 鍋裡還剩下一些冷掉的食物 (food),  看來不
像是今天煮的.\n",

		"table":
"這個木桌子的造型十分樸素, 上面並沒有任何裝飾的花紋. 在桌子上
擺有一排大約有十幾本的書 (books), 還有一瓶墨汁和一枝筆 (pen).\n",

		"chairs":
"其中比較小的一張是個木板凳, 只有膝蓋一半高. 另外一張放在書桌
前面, 大概是寫字和閱\\讀時所使用的. 兩張椅子可以看得出都有精細
的手工, 但是上面仍然沒有任何裝飾.\n",

		"bed":
"這是張單人床, 床大概有兩公尺的長度, 由簡單的手工製作而成. 床
上擺著折疊得整整齊齊的一條被子, 以及整理得非常平整的床單.\n",

		"closet":
"這個櫃子有一個人高, 裡面放了些男人的衣物和幾塊黑麵包、一袋小
米、一隻小刀.\n",

		"food":
"鍋子裡盛著少許的小米粥, 聞起來一點味道也沒有.\n",

		"books":
"這一排書分別是: 三本老舊的日記 (diaries)、三本近代史、一本人
類學、兩本文化史、兩本古代史、兩本考古學、一本天文學、兩本地
理學、一本地質學. 看來這間小木屋的主人是個學者.\n",

		"pen":
"這枝黑色的墨水筆很顯然是非常值錢的東西, 有著金屬的筆尖和沈重
的金屬筆身, 不同於常見的羽毛筆.\n",

		"diaries":
"這三本日記的日期從七年前記到現在. 從日記的內容看來, 日記的主
人叫做勞倫斯．雅茲科夫 ( Lawrence Yatzkov), 是一位歷史學家. 
他並不常寫日記, 大概是因為紙價非常昂貴吧? 日記裡有一段時間記
了許多關於一個叫做莎拉 (Serah) 的女人的事情.\n",
	]));

	set("doors", ([
		"east"	:	([
				"data"		:	"小木屋的門",
				"other_side_dir":	"west",
				"status"	:	DOOR_LOCKED,
				"key_id"	:	"maniac/cabin_key",
				]),
	]) );

//	create_door("east", "小木屋的門", "west", DOOR_LOCKED, "maniac/cabin_key");

	setup();
}
