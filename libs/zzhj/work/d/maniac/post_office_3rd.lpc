// Room: /obj/post_office_3rd.c

inherit ROOM;

void create()
{
	set("short", "郵局第三支局");
	set("long", @LONG
這裡是梅尼亞克市郵政局的第三支局, 負責本市南區一半的郵政.
由於梅尼亞克市是個繁忙的商業轉口港, 因此郵件數量龐大, 而郵件
也常常延遲許多天才送達. 郵局的效率低落, 已經被市民們詬病許久.
    在你的面前有五個櫃臺, 分別處理不同的業務. 可是現在你只看
到一位職員坐在「本地信件收發」的櫃臺後, 而其他的櫃臺全掛上了
「暫停服務」(NO SERVICE) 的牌子.
    稍微後面一點的地方有個樓梯, 可以通往二樓的辦公室.
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
		"east" : __DIR__"f_road_1",
	]));

	set("objects", ([
		__DIR__"npc/post_officer" : 1,
	]));

	set("no_clean_up", 0);
	set("mov_cost", 10 );

	setup();
}

int valid_leave(object me, string dir)
{
	object mbox;

	if( mbox = me->query_temp("mbox_ob") ) {
		tell_object(me, "你將信箱交回驛站。\n");
		destruct(mbox);
	}
	return 1;
}
