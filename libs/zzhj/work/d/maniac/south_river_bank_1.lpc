LONG
	);
	set("exits", ([ /* sizeof() == 2 */
		"south" : __DIR__"park_cabin_2.lpc",
		"east"	: __DIR__"south_river_bank_2.lpc",
		"west"	: __DIR__"south_river_bank_3.lpc",
]));

