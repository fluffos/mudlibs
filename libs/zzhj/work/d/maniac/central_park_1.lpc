// central_park_1.c 紀念碑

#include <room.h>

inherit ROOM;

void create()
{
	set("short", "中央公園紀念碑");
	set("long", @LONG
    這裡是梅尼亞克市 (Maniac City)  中央公園. 你看到一棟高大
而半毀的建築物 (building) , 在整個梅尼亞克市內是最高的建築物
, 亦為象徵性的地標. 只是擺在如此風景美麗的公園內, 給人一種蒼
涼而破敗的感覺. 在你的面前豎有一塊牌子 (plaque) , 看來是這棟
建築物的說明.
    一座老舊的噴水池 (fountain) 正在噴出美麗的水花.
    你注意到上方有一扇透明的門 (up) , 看來很奇怪.
LONG
	);

	set("night_long", @LONG
    這裡是梅尼亞克市 (Maniac City)  中央公園. 你看到一棟高大
而半毀的建築物 (building) 矗立在微亮的夜空中, 在整個梅尼亞克
市內是最高的建築物, 亦為象徵性的地標. 在夜空中半毀的建築物給
人一種猙獰而詭異的感覺. 離你不遠處似乎有一塊牌子 (plaque) .
    你面前有一座盛滿著水的老舊噴水池 (fountain) .
LONG
	);

	set("mov_cost", 100 );
	set("outdoors", 1);
	set("resource/water", "噴水池" );

	set("detail", ([ /*sizeof() == 3 */
		"building":
"這棟建築物已經殘破不堪, 露出歪扭的鋼筋和碎裂的外牆. 大概是戰
爭後的遺物, 看來至少有一百年的歷史以上. 雖然建築物已經攔腰斷
成兩截, 仔細數數剩下來的樓層, 居然有五、六十層! 令人不禁懷疑
, 古時候這棟高大的建築物有多高呢?\n",

		"plaque":
"梅尼亞克市紀念碑:
    卡德菲爾大樓, 於 2033 年落成. 樓高一百五十七層, 佔地三千
一百平方公尺.2051 年毀於石油之戰, 為石油文明劃下句點. 目前仍
為本市最高之建築物、地標以及精神象徵.

警告!!  請勿進入紀念碑周圍以紅色纜繩所圍起來的區域, 可能有危
        險石塊落下.\n",

		"fountain":
"雖然外表已經破舊不堪, 但是可以看得出原來這座噴水池一定是精心
設計過的, 有著優美的造型.\n",
	]));

	set("exits", ([ /* sizeof() == 4 */
		"up"		: "/d/wiz/guestroom",
                "west"          : __DIR__"central_park_2",
                "south"         : __DIR__"central_park_4",
                "east"          : __DIR__"central_park_6",
        ]) );

	set("objects", ([
		"/obj/board/common_b" : 1,
		"/obj/ballot" : 1,
		__DIR__"npc/police_officer" : 1,
	]) );

	set("doors", ([
		"up"	:	([
				"data" : "透明的門",
				"other_side_dir" : "down",
				"status" : DOOR_CLOSED,
				]),
	]) );
//	create_door("up", "透明的門", "down", DOOR_CLOSED);

	setup();
}
