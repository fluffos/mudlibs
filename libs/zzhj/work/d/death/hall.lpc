// Room: /d/death/hall.c

#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", HIW "垃圾屋內" NOR );
	set("long", @LONG
    你進入了垃圾屋裡, 當你的眼睛適應了屋內的黑暗之後, 你看到
在屋內狹小的空間內, 只擺著一個白色的馬桶, 裡面有水可以解渴. 
    在你的右手邊有一個通往下方另一個洞的梯子, 洞內傳來微弱的
亮光.
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
		"ladder": __DIR__"transporter",
		"out" : __DIR__"gateway",
]));
	set("objects", ([
		__DIR__"npc/toilet":1
	]) );
	set("no_fight", 1 );
	set("resource/water", "馬桶" );

	setup();
}

