// Room: /d/wiz/transporter.c
#include <ansi.h>

inherit ROOM;

mapping destination = ([
	"ceres"	  : "/d/space/solaris/ceres_boarding_hall",
	]);

int xdo_say( string arg);

void create()
{
	set("short", "傳送室");
	set("long", @LONG
這裡是 FF 控制中心的傳送室, 負責運送玩家或巫師到巫師們自
己偷偷創造的「神秘世界」. 如果您不顧一切危險, 願意進去一探究
竟的話, 你可以走進傳送機器的平臺上, 進行傳送. 
    牆上貼著一張公告 (post).
    在房間的牆壁旁有一個通往上方的梯子.
[32m( TROS v0.37 visual projection mode ) 
User permission granted. Please say "menu" to activate the menu.[37m
LONG
	);
	set("no_fight", 1);
	set("mov_cost", 1);

	set("exits", ([ /* sizeof() == 1 */
		"ladder" : __DIR__"hall",
	]));

	set("detail", ([
		"post":
@LONG
傳送室公告:
    目前開放區域總共一處:
	(1) 賽芮絲太空站	---- ceres

警告: 如果你無法在測試區域找到出口, 請打 recall 回到傳送室.
LONG,	
	]));

	setup();
}

void init()
{
	add_action("xdo_say", "say");
}

int xdo_say( string arg)
{
	string msg, dest, dest_cmd;

	if( arg == "menu" ) {

		msg = CYN "$N 說道: " + arg + "\n"
			+ GRN "Tranporter Room Operating System v0.37 ( TROS )\n"
			+ "    ( sound command mode activated )\n"
			+ MAG "    < Main Menu >\n"
			+ GRN "    menu :               this menu.\n"
			+     "    destination <area>:  set destination.\n"
			+ GRN "    energize:            engage tranporting process.\n" NOR;

		message_vision( msg, this_player() );
		return 1;
	}

	if( arg == "energize" ) {
		dest = this_player()->query_temp("wiz_area_dest");
		if( !dest) {
			msg = CYN "$N 說道: " + arg + "\n"
				+ GRN "Tranporter Room Operating System v0.37 ( TROS )\n"
				+ MAG "    Please select your distination first.\n" NOR;
			message_vision( msg, this_player() );
			return 1;
		}
		if( dest) {
			msg = CYN "$N 說道: " + arg + "\n"
				+ GRN "Tranporter Room Operating System v0.37 ( TROS )\n"
				+ "    Proceed transport procedure...\n"
				+ "    Checking object integrety...\n"
				+ "    Start energizing...\n" NOR;
			message_vision( msg, this_player() );

			if( this_player()->move( dest)) {
				msg = HIY "眼前突然出現一陣刺眼的強光, $N 的身影慢慢在空氣中凝結.\n";
				message_vision( msg, this_player() );
				this_player()->delete_temp("wiz_area_dest");
				return 1;
			} else {
				msg = CYN "$N 說道: " + arg + "\n"
					+ GRN "Tranporter Room Operating System v0.37 ( TROS )\n"
					+ RED "    Destination not correct, please check it.\n" NOR;
				message_vision( msg, this_player() );
				return 1;
			}
		}
	}

	if( arg == "destination" ) {

		msg = CYN "$N 說道: " + arg + "\n"
			+ GRN "Tranporter Room Operating System v0.37 ( TROS )\n"
			+ GRN "    Command format: distination <area>\n" NOR;

		message_vision( msg, this_player() );
		return 1;
	}

	if( sscanf( arg, "destination %s", dest_cmd) == 1) {
			msg = CYN "$N 說道: " + arg + "\n"
				+ GRN "Tranporter Room Operating System v0.37 ( TROS )\n"
				+ "    Searching data base...\n" NOR;
			message_vision( msg, this_player() );
			dest = destination[dest_cmd];
			if( dest) {
				msg = HIW "    Coordination setting complete.\n" NOR
					+ GRN "    Say \"energize\" to engage transporting.\n" NOR;
				message_vision( msg, this_player() );
				this_player()->set_temp("wiz_area_dest", dest);
			} else {
				msg = RED "    Destination not available.\n" NOR;
				message_vision( msg, this_player() );
			}
		return 1;
	}
	return "/cmds/std/say.lpc"->main( this_player(), arg );

}
