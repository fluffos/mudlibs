// shadow.c

#include <ansi.h>
#include <login.h>

inherit NPC;

string *death_msg = ({
	GRN "白色馬桶平靜地說道: 「我是史巴克在這個世界的影子. 」\n" NOR,
	GRN "白色馬桶向您說道: 「時候不早了, 您一定急著想回去吧?\n"
		"不好意思耽誤了您寶貴的時間. 」\n" NOR,
	GRN "白色馬桶似乎不捨得結束與你的會面, 嘆了口氣.\n" NOR,
	HIW "你全身突然籠罩在白色的光暈之中, 四周的景物漸漸地模糊了起來.\n" NOR,
	HIW "白色馬桶向您做了最後的道別.\n" NOR
});

void create()
{
	set_name( HIW "白色馬桶" NOR, ({ "toilet", "white", "white-toilet" }) );
	set("long",
		"一個白色的馬桶, 整個馬桶看來並沒有什麼特殊之處.\n");
	set("attitude", "peaceful");
	set("chat_chance", 3);
	set("chat_msg", ({
		"$N 緩緩說道: 「您是怎麼來到這裡的呢? 」\n",
		"$N 看到你, 不覺莞爾地說道: 「您怎麼......」, 卻覺得不便再說.\n",
		"$N 靜靜地望著你, 你覺得這樣的一個普通馬桶似乎不應出現在此處.\n",
		"$N 搖了搖頭道: 「這裡不是常人該來的地方.」\n",
		"$N 平靜地說道: 「您如果累了, 可以好好地在此休息.」\n"
	}) );
	set("inquiry", ([
		"name": 
"我是史巴克的影子, 想知道史巴克的真名(real_name)嗎?",
		"real_name": 
"史巴克的真實姓名才不告訴你. ( 邪惡地笑 ) 
還想知道其他的事 (more) 嗎?",
		"more":
"史巴克現在正在讀中山醫學院醫學系, 他實在很混,
這個 MUD  遲遲不能開放, 100% 要怪他太混了... :P",		
		"job": 
"我負責將死去的靈魂送回 (return) 人世.",
		"return": 
"如果您急著趕回人世, 您可以說:「return」.", 
	]) ); 
	set("age", 19);
	set("level", 1000);
	set("combat_exp", 1000000);

	set("str", 12);
	set("dex", 15);
	set("not", 24);
	set("int", 22);
	set("wis", 20);
	set("con", 13);
	set("cha", 15);
	set("tec", 23);

	set_temp("apply/astral_vision", 1);
 
	set_skill("parry", 100);
	set_skill("dodge", 100);
	set_skill("unarmed", 100);

	setup();

	carry_object(__DIR__"obj/white_robe")->wear();
}

void init()
{
	::init();
	if( !previous_object()
	||	!userp(previous_object())) return;
}

void death_stage(object ob, int stage)
{
	if( !ob || !present(ob) ) return;

	tell_object(ob, death_msg[stage]);
	if( ++stage < sizeof(death_msg) ) {
		call_out( "death_stage", 5, ob, stage);
		return;
	} else
		ob->reincarnate();

	message_vision_exclude(
		ob->name() + "全身籠罩在柔和的白光之中, 慢慢地消失在你面前.\n", ob, ({ ob }));
	ob->move(REVIVE_ROOM);
	message_vision_exclude(
		"一道光芒忽然出現在你面前! 光芒消逝之後, 一個全身赤裸裸的人躺\n"
		"在你的面前. 那人緩緩地張開眼睛, 站了起來.\n", ob, ({ ob }));
}

void relay_say( object ob, string msg)
{
	int *limbs_eff_hit_s, *limbs_max_hit_s;
	int i, flag;

	if( !userp(ob)) return;
	if( ob == this_object()) return;

	if( msg == "return" ) {
		limbs_eff_hit_s = ob->query("limbs_eff_hit");
		limbs_max_hit_s = ob->query("limbs_max_hit");

		for( i = 0; i < sizeof( ob->query("limbs") ); i++ ) {
			if( limbs_eff_hit_s[i] * 10 / limbs_max_hit_s[i] < 5 )
				flag = 1;
		}
		if( flag == 1 ) {
			message_vision("$N 說道: 您目前的狀況還無法回到人世, 請多休息一下吧.\n", this_object() );
			return;
		}
		call_out( "death_stage", 1, ob, 0);
	}
	return;
}

void relay_emote( object ob, string verb )
{
	if( verb == "bow" )
		this_object()->relay_say( ob, "return" );
	return;
}
