// Room: /d/death/gateway.c

#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", HIW "垃圾屋" NOR );
	set("long", @LONG
    當你走近這堆垃圾堆時, 你發現在垃圾堆的底部有個像人一般高
的洞口, 裡面隱隱透出些微的光線.
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
		"hole" : "/d/death/hall",
		"from" : "/d/death/gate",
	]));
	set("no_fight", 1 );

	setup();
}

int valid_leave(object me, string dir)
{
	if( wizardp(me) || !userp(me) ) return 1;

	if (dir == "south") {
		return notify_fail("一個柔和安詳的聲音在你耳邊響起....\n"+
			       "請進來吧.\n");
	}
	else return 1;
}


