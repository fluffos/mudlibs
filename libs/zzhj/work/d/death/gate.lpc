// gate.c

#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", HIW "垃圾山上" NOR);
	set("long", @LONG 
    你身處一座非常巨大的垃圾山之上, 奇怪的是你聞不到任何的味
道. 你輕輕地站起身子, 把身上的一些垃圾殘片撥掉. 往四周一望只
發現一望無際的垃圾堆, 無窮無盡的垃圾鋪滿了所有你目力可及的範
圍. 抬頭環視天空, 你只看到兩個月亮掛在天邊. 你完全不知道這裡
到底是什麼地方.
    你注意到不遠處有一堆堆得特別高的垃圾堆.
LONG
	);
	set("exits", ([
		"pile" : "/d/death/gateway",
	]) );
	set("no_fight", 1 );

	setup();
}
