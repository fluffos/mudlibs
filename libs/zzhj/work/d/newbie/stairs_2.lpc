#include <ansi.h>
#include <room.h>

inherit ROOM;

//______05________10________15________20________25________30________35________40__(中文字)

void create()
{
	set("short", "二樓樓梯");
	set("long",@LONG
    這裡是二樓上下一樓及三樓的樓梯. 旁邊是廁所. 身旁的牆壁上
有個標示 (sign).
    往北是新手學院唯一的餐廳.
LONG
	);

	set("exits", ([ /* sizeof() == 2 */
		"north" : __DIR__"cafe",
		"down"	: __DIR__"stairs_1",
	]));
	set("no_fight", 1);
	set("mov_cost", 5 );

	set("detail/sign", @LONG
  一樓 ---> 咨詢櫃檯及職員辦公室
  三樓 ---> 生存基礎知識教室
LONG
	);

	setup();
	replace_program(ROOM);
}
