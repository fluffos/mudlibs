// /d/newbie/entrance.c 
#include <ansi.h>
#include <room.h>

inherit ROOM;

//______05________10________15________20________25________30________35________40__
 
void create()
{
	set("short", "FF 新手學院大廳");
	set("long", @LONG
    這裡是 The Final Frontier 新手學院, 由著名的「打混蟑螂史巴克」
( Spock, the roach )  所創立, 成立的宗旨在於唬爛....不, 是教導
各位新來到 FF 世界的人所需的基本知識.
    學院大廳由環繞著四面高聳的粉紅色大理石牆 (walls), 東面的石
牆離地面十公尺之上, 可以看見學院各層樓 (floors) 的走廊. 往上仰
望, 大廳的頂端天井可以看到天空中的景色.
    在你面前有一個告示牌 (plaque), 你可以打 l plaque 閱讀內容.
LONG
	);

	set("detail/plaque", @DETAIL
    「打 l 可以看您四周的環境. 打 l walls  可以仔細地看看大理
石牆. 試試 l floors 吧.打 e  或 east 往東方走, 可以進入新手學
院訓練中心. 詳細的方向簡寫請參考 help go. 
    如果您已完成訓練, 請往西走. 」

    你發現告示牌的字跡潦草, 署名正是打混蟑螂史巴克....呃....校長.
DETAIL
	);

	set("detail/walls", @DETAIL
    你用手摸了一下粉紅的大理石牆, 發現手上沾了一些白色的粉末
(powder). 你懷疑粉末是石牆自然形成的.
DETAIL
	);

	set("detail/floors", @DETAIL
    你數了數東面到底有幾層走廊, 結果有九層. 一樓是行政區, 二
樓是餐廳的落地窗.
DETAIL
	);

	set("exits", ([ /* sizeof() == 2 */
		"east" : __DIR__"training_1_info",
		"west" : __DIR__"transporter",
	]));

	set("objects", ([
		"/obj/board/common_b" : 1,
	]) );

	set("no_fight", 1);
	set("mov_cost", 20);
	set("outdoors", 1);

	setup();
// To "load" the board, don't ever "clone" a bulletin board.
//	call_other( "/obj/board/common_b", "???" );
}
