#include <ansi.h>
#include <room.h>

inherit ROOM;


//______05________10________15________20________25________30________35________40__(中文字)

void create()
{
	set("short", "學院餐廳");
	set("long",@LONG
    走進餐廳, 四周明亮的燈光和潔淨的桌椅讓人覺得有些單調.
在你左手邊是整面的落地窗, 窗外望出去可以看到整個廣場. 右邊
的牆上是一份價目表 (menu), 價目表下面是一臺奇怪的機器 (machine).
這裡有位服務生負責為你點餐.
LONG
	);

	set("exits", ([ /* sizeof() == 1 */
		"south"	: __DIR__"stairs_2",
	]));
	set("no_fight", 1);
	set("mov_cost", 5 );

	set("menu", ([
		"sandwich"	:	"/obj/food/sandwich",
		"bread"		:	"/obj/food/jelly_bread",
		"steak"		:	"/obj/food/beef_steak",
		"chinese"	:	"/obj/food/chinese_meal",
		"barbicue"	:	"/obj/food/mongolian_barbicue",
		"milk"		:	"/obj/drink/milk",
		"tea"		:	"/obj/drink/black_tea",
		"coffee"	:	"/obj/drink/black_coffee",
		"water"		:	"/obj/drink/water",
	]) );

	set("food_cname", ([
		"sandwich"	:	"三明治",
		"bread"		:	"果醬麵包",
		"steak"		:	"牛排",
		"chinese"	:	"中式套餐",
		"barbicue"	:	"蒙古烤肉",
		"milk"		:	"牛奶",
		"tea"		:	"紅茶",
		"coffee"	:	"咖啡",
		"water"		:	"開水",
	]) );

	set("detail/menu", @LONG
本餐廳為各位學員免費提供以下各式餐飲.

    三明治 (sandwich)
    果醬麵包 (bread)
    牛排 (steak)
    中式套餐 (chinese)
    蒙古烤肉 (barbicue)
    牛奶 (milk)
    紅茶 (tea)
    咖啡 (coffee)
    開水 (water)

				新手學院餐廳
LONG
	);

	set("detail/machine", @LONG
  這臺機器前面有個顯示屏幕, 不過你也看不懂寫些什麼. 機器下方
有個大凹槽, 好像可以放什麼東西進去.
LONG
	);

	set("objects", ([
		__DIR__"npc/waiter" : 1,
	]) );

	setup();
}
