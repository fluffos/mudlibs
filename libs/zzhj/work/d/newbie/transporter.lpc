// Room: /d/newbie/transporter.c
// Author: Spock @ FF	97.Sep.6.

#include <ansi.h>

inherit ROOM;

mapping destination = ([
		"guestroom" : "/d/wiz/guestroom",
		"ceres"	    : "/d/space/solaris/ceres_boarding_hall"
	]);

int xdo_say( string arg);

void create()
{
	set("short", "傳送中心");
	set("long", @LONG
    這裡是 FF 新手學院的傳送中心, 負責運送訓練完成的新手到 FF 
的世界裡. 你可以走到傳送機器的平臺上, 進行傳送. 
    牆上貼著一張公告 (post).
    往東走可以回到大廳.
[32m [TROS v0.37 視覺投影顯示模式] 
使用者權限獲准使用. 請說 "menu" 以啟動主畫面.[37m
LONG
	);
	set("no_fight", 1);
	set("mov_cost", 5);

	set("exits", ([ /* sizeof() == 1 */
		"east" : __DIR__"entrance",
	]));

	set("detail", ([
		"post":
@LONG
傳送室公告:
    目前開放區域總共一處:
        (1) 巫師會客室		---- guestroom
	(2) 賽芮絲太空站	---- ceres
LONG,	
	]));

	setup();
}

void init()
{
	add_action("xdo_say", "say");
}

int xdo_say( string arg )
{
	string msg, dest, dest_cmd;

	if( !arg )
		return "/cmds/std/say.lpc"->main( this_player(), arg );

	else if( arg == "menu" ) {

		msg = CYN "$N 說道: " + arg + "\n"
			+ GRN "[傳送中心操作系統  TROS v0.37]\n"
			+ "    ( 聲音命令模式啟動 )\n"
			+ MAG "    < 主畫面 >\n"
			+ GRN "    menu :               此畫面.\n"
			+     "    destination <區域>:  設定目的地.\n"
			+ GRN "    energize:            啟動傳送程序.\n" NOR;

		message_vision( msg, this_player() );
		return 1;
	}

	else if( arg == "energize" ) {
		dest = this_player()->query_temp("wiz_area_dest");
		if( !dest) {
			msg = CYN "$N 說道: " + arg + "\n"
				+ GRN " [傳送中心操作系統  TROS v0.37]\n"
				+ MAG "    請您先選擇目的地.\n" NOR;
			message_vision( msg, this_player() );
			return 1;
		}
		if( dest) {
			msg = CYN "$N 說道: " + arg + "\n"
				+ GRN " [傳送中心操作系統  TROS v0.37]\n"
				+ "    進行輸送程序....\n"
				+ "    檢查輸送物體之完整性....Ok\n"
				+ "    傳送器開始充能....\n" NOR;
			message_vision( msg, this_player() );

			if( this_player()->move( dest)) {
				msg = HIY "眼前突然出現一陣刺眼的強光, $N 的身影慢慢在空氣中凝結.\n" NOR;
				message_vision( msg, this_player() );
				this_player()->delete_temp("wiz_area_dest");
				this_player()->delete("newbie");
				return 1;
			} else {
				msg = CYN "$N 說道: " + arg + "\n"
					+ GRN " [傳送中心操作系統  TROS v0.37]\n"
					+ RED "    無法傳送到指定的目的地, 請檢查目的地名稱是否錯誤.\n" NOR;
				message_vision( msg, this_player() );
				return 1;
			}
		}
	}

	else if( arg == "destination" ) {

		msg = CYN "$N 說道: " + arg + "\n"
			+ GRN " [傳送中心操作系統  TROS v0.37]\n"
			+ GRN "    命令格式: distination <area>\n" NOR;

		message_vision( msg, this_player() );
		return 1;
	}

	else if( sscanf( arg, "destination %s", dest_cmd) == 1) {
			msg = CYN "$N 說道: " + arg + "\n"
				+ GRN " [傳送中心操作系統  TROS v0.37]\n"
				+ "    搜尋資料庫....\n" NOR;
			message_vision( msg, this_player() );
			dest = destination[dest_cmd];
			if( dest) {
				msg = HIW "    目的地坐標設定完畢.\n" NOR
					+ GRN "    說 \"energize\" 以啟動傳送程序.\n" NOR;
				message_vision( msg, this_player() );
				this_player()->set_temp("wiz_area_dest", dest);
			} else {
				msg = RED "    目前無法傳送到此地.\n" NOR;
				message_vision( msg, this_player() );
			}
		return 1;
	}
	return "/cmds/std/say.lpc"->main( this_player(), arg );
}
