#include <ansi.h>
#include <room.h>

inherit ROOM;

//______05________10________15________20________25________30________35________40__(中文字)

void create()
{
	set("short", "一樓樓梯");
	set("long",@LONG
    這裡是一樓通往二樓的樓梯. 旁邊是廁所. 身旁的牆壁上有個藍
底白字的標示 (sign).
    北邊是新手學院的咨詢櫃檯.
LONG
	);

	set("exits", ([ /* sizeof() == 2 */
		"north" : __DIR__"training_1_info",
		"up" : __DIR__"stairs_2",
	]));
	set("no_fight", 1 );
	set("mov_cost", 5 );

	set("detail/sign", @LONG
  二樓 ---> 餐廳
LONG
	);

	setup();
}
