// leather_shoes.c

#include <armor.h>

inherit BOOTS;

void create()
{
	set_name("白色平底鞋", ({ "leather shoes", "leather", "shoes" }) );
        set_weight(130);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "雙");
		set("long", @LONG
一雙深褐色的牛皮製皮鞋, 上面有著一個圓形小商標的烙印.
LONG
	);
                set("value", 14);
		set("armor_prop/traditional_armor", 2);
	}
	setup();
}
