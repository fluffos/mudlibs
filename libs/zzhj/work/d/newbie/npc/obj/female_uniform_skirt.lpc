// female_uniform_skirt.c

#include <armor.h>

inherit PANTS;

void create()
{
	set_name("女性職員制服窄裙", ({ "skirt" }) );
        set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "條");
		set("long", @LONG
一件深藍色的女用套裝窄裙. 這是新手學院女性職員的制服套裝.
LONG
	);
                set("value", 50);
		set("armor_prop/traditional_armor", 2);
	}
	setup();
}
