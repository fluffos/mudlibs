// uniform_cap.c

#include <armor.h>

inherit HEAD;

void create()
{
	set_name("軟圓小帽", ({ "round cap", "round", "cap" }) );
        set_weight(130);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "頂");
		set("long", @LONG
一頂深藍色的軟圓小帽, 是新手學院女性職員的制服之一.
LONG
	);
                set("value", 25);
		set("armor_prop/traditional_armor", 1);
	}
	setup();
}
