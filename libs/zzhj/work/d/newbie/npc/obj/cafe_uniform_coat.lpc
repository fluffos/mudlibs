// cafe_uniform_coat.c

#include <armor.h>

inherit COAT;

void create()
{
	set_name("服務生上衣制服", ({ "waiter coat", "waiter", "coat" }) );
        set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("long", @LONG
一件深藍色的上衣外套, 配上白色的襯衫.
這是新手學院餐廳服務生的制服套裝, 胸前別著身分識別卡.
LONG
	);
                set("value", 10);
		set("armor_prop/traditional_armor", 3);
	}
	setup();
}
