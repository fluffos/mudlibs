// pearl_earring.c

#include <armor.h>

inherit EARRING;

void create()
{
	set_name("珍珠耳墜", ({ "pearl earring", "pearl", "earring" }) );
        set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "對");
		set("long", @LONG
一對各鑲了一顆珍珠的耳墜.
LONG
	);
                set("value", 1100);
	}
	setup();
}
