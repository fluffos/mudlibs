// white_shoes.c

#include <armor.h>

inherit BOOTS;

void create()
{
	set_name("白色平底鞋", ({ "white shoes", "white", "shoes" }) );
        set_weight(130);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "雙");
		set("long", @LONG
一雙有點磨損的白色平底鞋.
LONG
	);
                set("value", 25);
		set("armor_prop/traditional_armor", 1);
	}
	setup();
}
