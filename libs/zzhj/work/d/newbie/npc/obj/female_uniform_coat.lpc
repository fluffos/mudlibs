// female_uniform_coat.c

#include <armor.h>

inherit COAT;

void create()
{
	set_name("女性職員上衣制服", ({ "female coat", "female", "coat" }) );
        set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("long", @LONG
一件深藍色的女用套裝上衣, 配上白色的襯衫和深紅色的領結.
這是新手學院女性職員的制服套裝, 胸前別著身分識別卡.
LONG
	);
                set("value", 70);
		set("armor_prop/traditional_armor", 3);
	}
	setup();
}
