// leather_belt.c

#include <armor.h>

inherit BELT;

void create()
{
	set_name("牛皮皮帶", ({ "leather belt", "leather", "belt" }) );
        set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "條");
		set("long", @LONG
一條深褐色的牛皮製皮帶. 上面烙印著一行黑色小字: 「Guthrie Leather」
LONG
	);
                set("value", 10);
		set("armor_prop/traditional_armor", 1);
	}
	setup();
}
