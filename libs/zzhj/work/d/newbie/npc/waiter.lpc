// Author: Spock @ FF	97.Oct.3
// Last modified by Spock	97.Oct.30.

inherit NPC;

int do_order( string arg );

void create()
{
	set_name("餐廳服務生", ({ "waiter", "Carl", "carl", "Carl Simpson" }) );
	set("title", "平民");
	set("gender", "男性");
	set("age", 18 );

	set("long", @LONG
    一位不到二十歲的年青人. 一頭黑髮, 臉上有著許多痘痕. 他身
著胸前繡有「學院餐廳」的藍色職員制服.
LONG
	);
	set("str", 9);
	set("dex", 10);
	set("int", 8);
	set("wis", 15);
	set("not", 12);
	set("cha", 10);
	set("con", 10);
	set("tec", 5);
	set("attitude", "friendly");
	set("score", 40 );
	set("positive_fame", 37 );
	set("negative_fame", 5 );
	
	set("welcome_msg", "$N 面帶微笑地招呼您: 請參考價目表點餐 (order).\n" );

	set("inquiry", ([
		"name" :
"我是卡爾•辛普森 (Carl Simpson) , 我是這裡的服務生.",
		"job" :
"那裡的牆上有一張菜單 (menu), 如果您要食物或飲料, 請告訴我名字 (order).",
		"menu" :
"請看牆上的單子 (look menu).\n",
		"machine" :
"那是食物複製機 (replicater). 只要對它說名稱, 就會憑空製造食物出來.\n",
		"replicater" :
"複製啊....我也不清楚那是怎麼一回事.\n",
		"closet" :
"那裡是放雜物的小房間, 請不要隨意打開.\n",
	]));

	set("chat_chance", 3);
	set("chat_msg", ({
"$N 拿起一塊抹布, 四處擦了擦桌子.\n",
"$N 從置物間 (closet) 拿出拖把和水桶, 準備拖地.\n",
	}) );

	setup();
	
	add_money("gold", 1);
	add_money("silver", 15);
	add_money("copper", 130);
	carry_object(__DIR__"obj/cafe_uniform_coat")->wear();
	carry_object(__DIR__"obj/cafe_uniform_pants")->wear();
	carry_object(__DIR__"obj/leather_belt")->wear();
	carry_object(__DIR__"obj/leather_shoes")->wear();
}

void init()
{
	::init();
	add_action("do_order", "order");
}

int do_order( string arg )
{
	int i, err, flag = 0;
	mapping menu;
	string *food_name, *food_file;
	mapping food_cname;

	if( !arg )
		return notify_fail("服務生詢問道: 請問您要點什麼呢 ?\n");
	
	menu = environment()->query("menu");
	if( !mapp( menu ) )
		return notify_fail("服務生說道: 我已經下班了.\n");
	food_name = keys( menu );
	food_file = values( menu );

	for( i = 0; i < sizeof( menu ); i++ ) {
		if( arg == food_name[i] ) {
			flag = 1;
			break;
		}
	}

	food_cname = environment()->query("food_cname");

	if( flag == 0 )
		return notify_fail("我們並沒有提供 " + arg + " 這種餐點.\n");
	else {
		err = catch ( new( food_file[i] )->move( this_player() ) );

		if( err ) 
			return notify_fail("無法提供此種食物, 請通知巫師.\n");

		message_vision("$N 走向奇怪的機器, 按了上面的按鈕.\n"
			+ "$N 向機器說道: " + food_cname[arg] + " 一份.\n"
			+ "只見機器的凹槽突然憑空冒出一份 " + food_cname[arg] 
			+ " ! 你不知道到底是誰放進去的 ?\n"
			+ "$N 向你說道: 這是您點的 " + food_cname[arg] + ", 請慢用.\n"
			+ "服務生將手中的 " + food_cname[arg] + " 送到你面前.\n", this_object() );
	}
	return 1;
}
