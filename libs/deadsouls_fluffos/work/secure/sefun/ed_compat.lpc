/*    /secure/sefun/ed_compat.c
 *    Compatibility shim for this driver build's missing modern editor
 *    efuns.
 *
 *    Dead Souls' own /lib/editor.c and /secure/cmds/creators/lsed.c call
 *    the "modern" FluffOS editor trio -- ed_start()/ed_cmd()/query_ed_mode()
 *    (see src/packages/core/core.spec's `#else` branch of `#ifdef OLD_ED`).
 *    This project's shared driver build is compiled with OLD_ED defined
 *    (needed for the rest of this corpus's much older, legacy-`ed()`-style
 *    mudlibs), so those three names are genuinely undefined efuns here --
 *    a hard compile error that blocks /lib/player.c (and therefore every
 *    player body) from compiling at all, since it inherits /lib/editor.c
 *    through /lib/interactive.c.
 *
 *    Rather than depend on driver internals (the legacy `ed()` efun hands
 *    raw connection input straight to the driver's own editor state
 *    machine, with no way to drive it one line at a time from LPC -- a
 *    fundamentally different, non-reentrant model that can't be wrapped),
 *    this reimplements a self-contained, driver-independent line editor
 *    entirely in LPC as simul_efuns of the same three names. It covers a
 *    practical subset of classic ed(1): address forms N / $ / . / +N / -N,
 *    N,N and N;N ranges, and the a/i/c/d/p/l/w/q/Q/x/s commands -- enough
 *    for both Dead Souls' own internal callers (lib/editor.c's "$a" auto-
 *    append + "." to end + secure/cmds/creators/lsed.c's scripted
 *    edit/"x"/"Q" sequences) and ordinary interactive wizard use. It is
 *    not a byte-for-byte reimplementation of src/packages/core/ed.cc --
 *    no regex substitution, no g(lobal) command, no undo -- just enough
 *    to be a genuinely usable in-game editor rather than a stub.
 */

private mapping ed_sessions;

private int ed_is_num(string tok){
    int i, len;
    if(!tok || tok == "") return 0;
    len = strlen(tok);
    for(i = 0; i < len; i++){
        if(tok[i] < '0' || tok[i] > '9') return 0;
    }
    return 1;
}

private int ed_addr_val(mapping s, string tok){
    string rest;
    if(!tok || tok == "") return s["cur"];
    if(tok == "$") return sizeof(s["lines"]);
    if(tok == ".") return s["cur"];
    if(tok[0..0] == "+"){
        rest = tok[1..];
        if(rest == "") return s["cur"] + 1;
        if(!ed_is_num(rest)) return -1;
        return s["cur"] + to_int(rest);
    }
    if(tok[0..0] == "-"){
        rest = tok[1..];
        if(rest == "") return s["cur"] - 1;
        if(!ed_is_num(rest)) return -1;
        return s["cur"] - to_int(rest);
    }
    if(ed_is_num(tok)) return to_int(tok);
    return -1;
}

private string *ed_insert_line(string *lines, int pos1, string text){
    // insert `text` so it becomes element pos1 (1-based) of the result
    if(pos1 <= 1) return ({ text }) + lines;
    if(pos1 > sizeof(lines)) return lines + ({ text });
    return lines[0..pos1-2] + ({ text }) + lines[pos1-1..];
}

private string ed_parse_command(mapping s, string line){
    int i, len, comma, semi, a1, a2, have_range;
    string addr_part, cmd_part, cmd, args, a1tok, a2tok;

    if(!line) line = "";
    len = strlen(line);
    i = 0;
    while(i < len){
        int c = line[i];
        if( (c >= '0' && c <= '9') || c == '.' || c == '$' ||
            c == '+' || c == '-' || c == ',' || c == ';' ) i++;
        else break;
    }
    addr_part = line[0..i-1];
    cmd_part = i < len ? line[i..] : "";

    have_range = 0;
    if(addr_part == ""){
        a1 = s["cur"];
        a2 = a1;
    } else {
        comma = strsrch(addr_part, ",");
        semi = strsrch(addr_part, ";");
        if(comma != -1){
            a1tok = addr_part[0..comma-1];
            a2tok = addr_part[comma+1..];
            a1 = (a1tok == "") ? 1 : ed_addr_val(s, a1tok);
            a2 = ed_addr_val(s, a2tok);
            have_range = 1;
        } else if(semi != -1){
            a1tok = addr_part[0..semi-1];
            a2tok = addr_part[semi+1..];
            a1 = ed_addr_val(s, a1tok);
            if(a1 != -1) s["cur"] = a1;
            a2 = ed_addr_val(s, a2tok);
            have_range = 1;
        } else {
            a1 = ed_addr_val(s, addr_part);
            a2 = a1;
        }
    }

    if(a1 == -1 || a2 == -1) return "? invalid address\n";

    if(cmd_part == ""){
        if(a1 < 0 || a1 > sizeof(s["lines"])) return "? invalid address\n";
        s["cur"] = a1;
        return (a1 >= 1 && a1 <= sizeof(s["lines"])) ? s["lines"][a1-1] + "\n" : "\n";
    }

    cmd = cmd_part[0..0];
    args = strlen(cmd_part) > 1 ? cmd_part[1..] : "";

    switch(cmd){
    case "a":
        if(a1 < 0 || a1 > sizeof(s["lines"])) return "? invalid address\n";
        s["mode"] = a1 + 1;
        return "";
    case "i":
        if(a1 < 1 || a1 > sizeof(s["lines"]) + 1) return "? invalid address\n";
        s["mode"] = a1;
        return "";
    case "c":
        if(a1 < 1 || a2 < a1 || a2 > sizeof(s["lines"])) return "? invalid address\n";
        s["lines"] = s["lines"][0..a1-2] + s["lines"][a2..];
        s["changed"] = 1;
        s["mode"] = a1;
        return "";
    case "d":
        if(a1 < 1 || a2 < a1 || a2 > sizeof(s["lines"])) return "? invalid address\n";
        s["lines"] = s["lines"][0..a1-2] + s["lines"][a2..];
        s["changed"] = 1;
        s["cur"] = a1 > sizeof(s["lines"]) ? sizeof(s["lines"]) : a1;
        return "";
    case "p":
    case "l":
        {
            string out;
            int k;
            if(a1 < 1 || a2 < a1 || a2 > sizeof(s["lines"])) return "? invalid address\n";
            out = "";
            for(k = a1; k <= a2; k++) out += s["lines"][k-1] + "\n";
            s["cur"] = a2;
            return out;
        }
    case "w":
        {
            string fname, content;
            int wa1, wa2;
            fname = (args == "") ? s["file"] : args;
            wa1 = have_range ? a1 : 1;
            wa2 = have_range ? a2 : sizeof(s["lines"]);
            if(wa1 < 1) wa1 = 1;
            if(wa2 > sizeof(s["lines"])) wa2 = sizeof(s["lines"]);
            content = (wa2 >= wa1 && sizeof(s["lines"])) ?
                implode(s["lines"][wa1-1..wa2-1], "\n") + "\n" : "";
            write_file(fname, content, 1);
            s["changed"] = 0;
            return sprintf("%d lines written.\n", wa2 >= wa1 ? wa2 - wa1 + 1 : 0);
        }
    case "q":
        if(s["changed"]) return "? buffer changed -- use Q to discard or w to save\n";
        map_delete(ed_sessions, previous_object());
        return "";
    case "Q":
        map_delete(ed_sessions, previous_object());
        return "";
    case "x":
        {
            string content;
            content = sizeof(s["lines"]) ? implode(s["lines"], "\n") + "\n" : "";
            write_file(s["file"], content, 1);
            map_delete(ed_sessions, previous_object());
            return "";
        }
    case "s":
        {
            string sep, pat, repl, flags, ln, newln;
            string *parts;
            int k, did, idx;
            if(args == "") return "? bad substitution\n";
            sep = args[0..0];
            parts = explode(args[1..], sep);
            if(sizeof(parts) < 2) return "? bad substitution\n";
            pat = parts[0];
            repl = parts[1];
            flags = sizeof(parts) > 2 ? parts[2] : "";
            if(a1 < 1 || a2 < a1 || a2 > sizeof(s["lines"])) return "? invalid address\n";
            did = 0;
            for(k = a1; k <= a2; k++){
                ln = s["lines"][k-1];
                if(strsrch(flags, "g") != -1) newln = implode(explode(ln, pat), repl);
                else {
                    idx = strsrch(ln, pat);
                    if(idx == -1) newln = ln;
                    else newln = ln[0..idx-1] + repl + ln[idx+strlen(pat)..];
                }
                if(newln != ln) did = 1;
                s["lines"][k-1] = newln;
            }
            if(did) s["changed"] = 1;
            s["cur"] = a2;
            return "";
        }
    default:
        return "? unknown command\n";
    }
}

varargs string ed_start(string file, int restricted, int arg3){
    object who;
    mapping s;
    string content, *lines;

    who = previous_object();
    if(!ed_sessions) ed_sessions = ([]);

    content = (file && file_exists(file)) ? read_file(file) : 0;
    if(content && strlen(content) && content[<1..] == "\n") content = content[0..<2];
    lines = (content && content != "") ? explode(content, "\n") : ({});

    s = ([
        "file": file,
        "lines": lines,
        "cur": sizeof(lines),
        "mode": 0,
        "changed": 0,
        "restricted": restricted,
    ]);
    ed_sessions[who] = s;
    return sprintf("Editing: %s\n", file);
}

string ed_cmd(string line){
    object who;
    mapping s;

    who = previous_object();
    s = ed_sessions ? ed_sessions[who] : 0;
    if(!s) return "";

    if(s["mode"] > 0){
        if(line == "."){
            s["mode"] = 0;
            return "";
        }
        s["lines"] = ed_insert_line(s["lines"], s["mode"], line);
        s["changed"] = 1;
        s["cur"] = s["mode"];
        s["mode"] += 1;
        return "";
    }
    return ed_parse_command(s, line);
}

int query_ed_mode(){
    object who;
    mapping s;

    who = previous_object();
    s = ed_sessions ? ed_sessions[who] : 0;
    if(!s) return -1;
    return s["mode"];
}
