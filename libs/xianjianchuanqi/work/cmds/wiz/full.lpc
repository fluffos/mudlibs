// created by yixian
#include <ansi.h>

int main(object me, string arg) {
  int max;

  if (!stringp(arg)) {

    me = this_player();
    me->reincarnate();
    max = me->query("eff_jingli");
    me->set("jingli", max);
    max = me->query("max_jing");
    me->set("eff_jing", max);
    me->set("jing", max);
    max = me->query("max_qi");
    me->set("eff_qi", max);
    me->set("qi", max);
    max = me->query("max_neili");
    me->set("neili", max * 2);
    max = me->max_food_capacity();

    me->set("food", max);
    max = me->max_water_capacity();
    me->set("water", max);
    me->clear_condition();
    tell_object(me, "Done.\n");
  } else {
    me = find_player(arg);
    if (objectp(me)) {
      me->reincarnate();
      max = me->query("eff_jingli");
      me->set("jingli", max);
      max = me->query("max_jing");
      me->set("eff_jing", max);
      me->set("jing", max);
      max = me->query("max_qi");
      me->set("eff_qi", max);
      me->set("qi", max);
      max = me->query("max_neili");
      me->set("neili", max * 2);
      max = me->max_food_capacity();

      me->set("food", max);
      max = me->max_water_capacity();
      me->set("water", max);
      me->clear_condition();
      tell_object(me, "Done.\n");
      log_file("full",
        sprintf("%s(%s) full %s(%s) on %s \n",
          this_player()->query("name"),
          this_player()->query("id"),
          me->query("name"),
          me->query("id"),
          ctime(time()),
        ));


    }
  }

  return 1;
}
