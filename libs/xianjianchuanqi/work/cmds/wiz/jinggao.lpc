// shout.c
//by leonardo
#include <ansi.h>

inherit F_CLEAN_UP;
int help(object me);
int main(object me, string arg)
{
        string cmds;
        object ob;

        if (!arg || !sscanf(arg, "%s because %s", arg, cmds)) return help(me);
                
        ob = find_player(arg);
        if(!ob)
                return 0;

        shout( HIR + "【纪律警告】：" + ob->name(1) +"（"+geteuid(ob) + "）因为" + cmds + "，如果再犯，将请到桃花源做客。\n" NOR);
        write(HIR + "你发布纪律警告：" + ob->name(1) +"（"+geteuid(ob) + "）因为" + cmds + "，如果再犯，将请到桃花源做客。\n" NOR);
        
        log_file("jinggao",
                sprintf("%s(%s) 警告 %s(%s) because %s at %s.\n",  
                me->name(1), geteuid(me),
                ob->name(1), geteuid(ob),
                cmds,
                ctime(time())
                ));
                
        return 1;

}
int help(object me)
{
  write(@HELP
指令格式 : jinggao <id> because <xxx>
 
这个指令让你将 <讯息> 传送出去, 所有正在游戏中的人都
会听见你的话.
 
see also : tune
HELP
    );
    return 1;
}

