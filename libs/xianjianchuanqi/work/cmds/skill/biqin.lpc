// bipin.c 内力比拼

 
#include <ansi.h>

// #include <skill.h>
#include <combat.h>
inherit F_SSERVER;

int start_bipin(object me);

int main(object me, string arg)
{
        object target;
        int myneili,taneili,mystr,tastr,mydex,tadex,mydodge,tadodge;
            int myexp,taexp;
        // string msg; 
            seteuid(getuid());
    if(!arg) return notify_fail("你想和谁比拼内力？\n");

    if(!objectp(target = present(arg, environment(me))))
             return notify_fail("这里没有这个人。\n"); 

    if( !target->is_fighting() || !target->is_character() || !me->is_fighting() )
               return notify_fail("内力比拼只能在战斗中使用。\n");

    if(!living(target))
                return notify_fail("你似乎不用再和"+target->name()+"比拼内力。\n"); 

    if(target==me) return notify_fail("想和自己比拼内力？\n"); 
    if(!me->is_fighting(target))
                return notify_fail("你必须在"+target->name()+"和你战斗的时候，才能使用内力比拼。\n");            
       // 是否判断双放有没有busy?
    if(me->query_temp("weapon") || target->query_temp("weapon"))
        return notify_fail("你必须在双方空手战斗的时候才能使用内力比拼。\n");
 
    myneili = me->query("neili");
    taneili = target->query("neili");
    if (me->query_skill("force") < 900 )
        return notify_fail("你的内功修为不足，无法和对手较量内力。\n");
   
       if(myneili < 2500 )
        return notify_fail("你的真气太弱，无法和对手较量内力。\n");
 
       if (me->query_skill("force")*2/3 >=  target->query_skill("force"))
            return notify_fail("对手的内功修为远不如你，还用比拼什麽内力呢？\n");

   if((int)me->query("max_neili") < 2000 )
        return notify_fail("你现在内力修为太弱，无法和对手较量内力。\n");

    if(me->query_temp("neili/bipin")) 
        return notify_fail("你正在和人比拼内力。\n");

    if(target->query_temp("neili/bipin")) 
        return notify_fail(target->name()+"正在和人比拼内力。\n");  
   //    if (me->query("jiali") <100)
   //          return notify_fail(target->name()+"正在和人比拼内力。\n"); 
       mystr = me->query_str();
       tastr = target->query_str();
       mydex = me->query_dex();
       tadex = target->query_dex();
       mydodge = me->query("dodge");
       tadodge = target->query("dodge");
       myexp = me->query("combat_exp",1);
       taexp = target->query("combat_exp",1);
            
   //    msg = SKILL_D(force)->bipin_msg(me);
// 关于内力比拼的描述尽可能做到突出各个内功的不同，想在每种force增加一个类似dazuo的msg，但是很难在内功里定义target
// 或许yuj, snowman有什麽好办法，我只能在在这里一个一个判断了，先只写个氤氲紫气的。
      if (me->query_skill_mapped("force")== "yinyun-ziqi"){
       tell_object(me,YEL"你袍袖一拂，一股疾风随着这一拂之势卷出，看似柔和、实则力道强劲之极，已然向" + target->name() +"压去。\n");
       tell_room(environment(me),HIW + me->name() + "袍袖一拂，一股疾风随着这一拂之势卷出，看似柔和、实则力道强劲之极，已然向" + target->name() +"压去。\n"NOR,({me}));
       
             }
              else
        message_vision(HIW"$N凝聚毕生功力缓缓推出一掌，一股劲风已然压向$n。\n"NOR,me, target);

  
       if (random(mydex*mydodge*myexp) < tadex*tadodge*taexp*2/3){
            message_vision(HIW"$n骇然至极，连忙双腿弹起，向后跃出数丈，才勉强躲开$N这凶猛一击。\n"NOR,me, target);
        me->add("neili",-500);
        me->start_busy(3);
        target->start_busy(2);
        }
        if (target->query_skill_mapped("force")== "yinyun-ziqi")
        message_vision(HIW"$n谨守太极之意中“以逸待劳、以静制动”的要旨，身不动，待内劲袭到，借力卸力，将$N这沉重之极的掌力引到掌心。\n"NOR,me, target);
        else
        message_vision(HIW"$n深吸一口气，挺背硬接了$N一招，并随即摧动内力以之向抗。\n"NOR,me, target);
        me->add("neili",-200);
        target->add("neili",-200);
           me->set_temp("neili/bipin",1);
           target->set_temp("neili/bipin",1);
      //  me->set_temp("bipin_lost", (int)me->query("neili"));
   //  target->set_temp("bipin_lost",(int)target->query("neili"));
              me->set_temp("bipin/target", target->query("id"));
             target->set_temp("bipin/target", me->query("id"));
        target->start_busy((: start_bipin :));
        me->start_busy((: start_bipin :));
              me->set_temp("bipin/period", 1);
           //   target->set_temp("bipin/period", 1);
           //   check_pfm(me, tar, ob);
             return 1;
}
int start_bipin(object me)
{
        string tar;
        object target;
        int myneili_lost,obneili_lost,period, neili, neili2;

        if(!me) return 0;
        tar = me->query_temp("bipin/target");
        target = present(tar, environment(me));
        myneili_lost = target->query_skill("force")/20 + me->query("jiali") + target->query("jiali")/2;
              obneili_lost = me->query_skill("force")/20 + me->query("jiali")/2 + target->query("jiali");
        period = (int)me->query_temp("bipin/period"); 
        neili = me->query("neili");
      neili2 = target->query("neili");

        me->receive_damage("neili", myneili_lost);
        me->receive_damage("jingli", 3+random(5));        
        me->improve_skill("force", random(2));
        //      me->receive_damage("qi",- target->query("jiali")/10);
              target->receive_damage("neili", obneili_lost);
        target->receive_damage("jingli", 3+random(5));        
        target->improve_skill("force", random(2));
        //      target->receive_damage("qi",- me->query("jiali")/10);
        if(me->is_ghost()) return 0;
            //  message_vision(HIW"$N和$n各出生平苦练的内家真力，全神贯注的比拼内劲。\n"NOR,me, target);

        if(!target || target->is_ghost() || environment(me)!=environment(target)){
            message_vision(CYN"$N当下内劲一收，的一双衣袖便即垂下，摇摇幌幌地站了起来。\n"NOR, me);
            return 0;
            }
               /*  if((neili + neili2) >=4000){ 
                              message_vision(HIW"$N和$n各出生平苦练的内家真力，全神贯注的比拼内劲。\n"NOR,me, target);
                 return 1;
                    } 
                 if( (neili + neili2) > 3000){ 
                                message_vision(HIR"$N催动内尽，头顶白气越聚越浓，双掌缓缓的向$n推去。\n"NOR,me, target);}
                             else{
                             message_vision(HIR"$N催动内尽，头顶白气越聚越浓，双掌缓缓的向$n推去。\n"NOR,target,me);
                            return 0; 
                 }
                  if(neili >neili2){ 
                                message_vision(HIR"$N头顶白气凝聚不散，面色越来越严峻，不断鼓动内劲向$n推去。\n"NOR,me, target);
                               
                             message_vision(HIR"$N只觉手上一沉，对方力道涌来，忙加劲反击。\n"NOR,target);
                            return 0; 
                 }     */ 
        if(neili < myneili_lost){
                   message_vision(RED"$N只觉压力越来越重，胸口烦恶，渐渐每喘一口气都感艰难，突然身体一阵摇晃，晕到在一旁。\n"NOR,me);
            me->unconcious();
           me->add("max_neili",-5); 
                    me->set_delete("bipin/target",);
                   target->set_delete("bipin/target",);
                   me->delete_temp("neili/bipin");
              target->delete_temp("neili/bipin");
           message_vision(HIW"$N只觉得心神具衰，深深吸了口气，但脸色惨白如纸。\n"NOR,target);
                                return 0;
                    } 
        if(!living(target) && living(me)){
                      message_vision(RED"$N只觉压力越来越重，胸口烦恶，渐渐每喘一口气都感艰难，突然身体一阵摇晃，晕到在一旁。\n"NOR,target);
                      target->unconcious();
             target->add("max_neili",-5);
                      target->unconcious();
                      message_vision(HIW"$N深深吸了口气，压住散乱的真气，脸色惨白如纸。\n"NOR,me);
                     me->delete_temp("bipin/target",);
                   target->delete_temp("bipin/target",);  
                      me->delete_temp("neili/bipin");
              target->delete_temp("neili/bipin");  
            return 0;
            }        
        if(!living(me) && !living(target)){
                     me->set_delete("bipin/target");
                   target->set_delete("bipin/target");
                   me->delete_temp("neili/bipin");
              target->delete_temp("neili/bipin");
            message_vision(HIW"此时$N脸上都已无半点血色，看来已经到了油尽灯枯之时！\n"NOR,me);
            me->set_temp("last_damage_from", "和"+target->name()+"同归于尽");
            me->die();
            return 0;
        }


        switch(period) {   
       case 3: 
        case 9:
        case 15:
        case 21: 
        case 27:
        case 33:
        case 39:
        case 45:
        case 51:
        case 57:
                            if((neili+neili2) >=1500){ 
                              message_vision(HIW"不一会，$N和$n头顶都透出一缕缕的白气，渐渐越来越浓，就如蒸笼一般。\n"NOR,me, target);
                 }
                 break;
        case 63:
        case 69:
        case 75:
        case 81:
        case 87:
        case 93:   
        case 99:     
        case 115:
        case 145:
        case 175:
        case 205:  
                if(neili > neili2){ 
                              message_vision(HIR"$N催动内尽，头顶白气越聚越浓，双掌缓缓的向$n推去。\n"NOR,me, target);}
                              else{
                             message_vision(HIR"$N催动内尽，头顶白气越聚越浓，双掌缓缓的向$n推去。\n"NOR,target,me);
                 }
                 break;
        case 12:       
        case 24:
        case 42:
        case 60:
        case 78:  
        case 96: 
        case 125:
        case 155:
        case 185:
                 if(neili > neili2){
                 message_vision(HIR"$N头顶白气凝聚不散，面色越来越严峻，不断鼓动内劲向$n推去。\n"NOR,me, target);}
                              else{
                             message_vision(HIR"$N头顶白气凝聚不散，面色越来越严峻，不断鼓动内劲向$n推去。\n"NOR,target,me);
                 }                 
                 break; 
       case 36:
        case 54:
        case 72:        
        case 90:
        case 105:
        case 135:
        case 165:
        case 195:
                 if(me->query("jiali") < target->query("jiali")){ 
                               message_vision(HIR"$N只觉手上一沉，对方力道涌来，忙加劲反击。\n"NOR,me);}
                              else{
                             message_vision(HIR"$N只觉手上一沉，对方力道涌来，忙加劲反击。\n"NOR,target);
                 }
                 
                 break;
        } 

        period++;
             me->set_temp("bipin/period", period);
       // me->set_temp("bipin/period", period);
        //      target->set_temp("bipin/period", period);
 //              me->delete_temp("neili/bipin");
      //        target->delete_temp("neili/bipin");
       return 1;        
}
