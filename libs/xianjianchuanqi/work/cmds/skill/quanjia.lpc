
// quanjia.c

#include <ansi.h>

int main(object me, string arg)
{
        string what, who;
        object victim;
        int sp, dp;
        object where = environment(me);
        if ( me->query("family/family_name") != "峨嵋派" )
                return notify_fail("只有峨嵋派才能用渡世济人！\n");
        if( me->query_temp("quanjia") )
               return notify_fail("你已经在劝人家罢斗了！\n");
        if( !arg || sscanf(arg, "%s halt", who)!=1 )
                return notify_fail("指令格式：quanjia <人物> halt\n");
        victim = present(who, where);
       if( !victim || victim == me) return notify_fail("你想找的对象不在这里。\n");
        if( !living(victim) || !victim->query("can_speak"))
                return notify_fail("你要劝谁罢斗？\n");
        if ( victim->query("family/family_name") == "峨嵋派" )
                return notify_fail("你不能向本派的使用渡世济人！\n");
        if( !wizardp(me) && wizardp(victim) )
                return notify_fail("玩家不能劝巫师罢斗。\n");
//        if( me->is_fighting() )
//                return notify_fail("一边打架一边劝别人罢斗？你真是虚伪到家了！\n");
        if (!victim->is_fighting())
                return notify_fail(victim->name()+"并没有和人争斗。\n");
        sp = (int)me->query_skill("dacheng-fofa") * 15+(random(((int)me->query("kar"))/5)+1)*(int)me->query("combat_exp",1);
        if( sp < 1 ) sp = 1;
        dp = (int)victim->query("combat_exp",1);
        tell_object(me, "你摇摇了头，向" + victim->name() + "走过去，双手合十，说道：两位休得伤了和气，不要再斗下去了吧！"
                + "...\n\n");
        tell_object(victim, me->name() + "摇摇了头向你慢慢走过来，双手合十，说道：我佛慈悲普度渡众生, 还请"
                + RANK_D->query_respect(victim) + "罢斗, 免增罪孽吧 ...！\n\n");

        tell_room(where, "只见" + me->name() + "摇摇了头，慢慢地向" 
                + victim->name() + "走过去，\n双手合十，说道: 请"
                + RANK_D->query_respect(victim) + "，停手吧...\n\n", ({ me, victim }) );

        me->set_temp("quanjia", 1);
         me->start_busy(10+random(10));
        call_out( "compelete_quanjia", 3, me, victim, where, sp, dp);
        return 1;
}

private void compelete_quanjia(object me, object victim, object where, int sp, int dp)
{
        int my_exp,ob_exp,get_exp;
        my_exp=(int)me->query("combat_exp",1);
        ob_exp=(int)victim->query("combat_exp",1);
        if (my_exp=0)
            my_exp=1;
        get_exp=(ob_exp^2/my_exp^2)*100;
        if (get_exp>500)
            get_exp=500;
        me->delete_temp("quanjia");
        if( !victim || environment(victim) != where ) {
                tell_object(me, "太可惜了，你要劝的人已经走了。\n");
                return;
        }

        if (!victim->is_fighting()) {
                tell_object(me, victim->name()+"已经停手了！\n");
                return;
        }
         if (!living(victim)){
            tell_object(me,victim->name()+"已经死了，不能劝了！\n");
             return;
             }    
       
         if( sp > random(dp) ) {
               victim->remove_all_killer();
               message_vision("$n受到$N的佛法感招，决定罢手不斗。\n", me, victim);
               message_vision("只见$n往后一纵，说道：好！$N良言相劝，看在人家的面子上，这次就算了。\n", me, victim);
               me->improve_skill("dacheng-fofa", random(me->query("int")));
//               if(me->query("max_pot") > me->query("potential")) me->add("potential",1);
               if (get_exp>0) {
               if (get_exp<1) 
                   get_exp=1; 
               me->add("combat_exp",random(get_exp));
               me->start_busy(2);
             }   
            return;
     }
        if(random((int)me->query("kar")/2)>6) {
          message_vision(RED"只见$n对着$N不屑地撇撇嘴：哪凉快哪待着去，少管闲事！\n"NOR, me, victim);
          return;
        }
        message_vision(HIY"只见$n恶狠狠的骂道:多管闲事多吃屁，休走看招!!\n"NOR, me, victim);
        victim->kill_ob(me);
//        me->start_busy(5);
}
int help(object me)
{
write(@HELP
指令格式 : quanjia <某人> halt

HELP
        );
        return 1;
}
