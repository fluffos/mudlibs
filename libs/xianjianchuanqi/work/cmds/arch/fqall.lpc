#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
        int i;
        mapping pmap;
        string* sk;

    message_vision(HIW "$N喃喃的念到:除四害，除害能手人人爱！\n\n" NOR, me);
           message_vision(HIY "$N一脸无辜状，是谁干啊！\n\n" NOR, me);
        pmap = me->query_skill_prepare();
        if (!pmap) pmap = ([]);
        if( mapp(pmap) && sizeof(pmap) > 0 )
        {
                sk = keys(pmap);
                for (i=0; i<sizeof(sk); i++)
                {
                        me->prepare_skill(sk[i]);
                }
        }
        sk = keys(me->query_skills());
        for(i = 0; i<sizeof(sk); i++)
        {
                me->map_skill(sk[i]);
                map_delete(me->query_skills(), sk[i]);
        }

        me->reset_action();
        return 1;
}

int help(object me)
{
write(@HELP
指令格式 : fqall

放弃所有武功。

HELP
    );
    return 1;
}
