// created by yixian
#include <ansi.h>

int main(object me,string arg)
{
        int num, exp;
        object ob;
        if(!wizardp(me)) return notify_fail("你的权限等级不够。\n");
        if(stringp(arg) && sscanf(arg ,"%s on %d" ,arg , num) ) {       
                        ob = LOGIN_D->find_body(arg);
                        if(objectp(ob)) {
                                exp = ((ob->query("combat_exp")/100)*num);
                               ob->add("combat_exp", -exp);
                               message("channel:chat",HIW"『武林公告』由巫师"+HIY+me->query("name")+"("+me->query("id")+")"+HIW+"检查并通过，"+HIY+ob->query("name")+"("+ob->query("id")+")"+HIW"扣除EXP"+HIR+exp+HIW"\n"NOR,users());
                               ob->save();
                               tell_object(ob,HBBLU+HIW"\n\n请您最好是退出游戏重新连入……\n"NOR);
                               ob->reset_action();
                                ob->restore();
                               return 1;
                               }
       }
                return 1;
                
}


