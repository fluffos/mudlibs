// rm.c

#include "/doc/help.h"

inherit F_CLEAN_UP;
int help(object me);

int main(object me, string dir) {
  int i;
  string *file;

  seteuid(geteuid(me));
  if (!dir) return notify_fail("你要删除那个档案?\n");
  dir = resolve_path(me->query("cwd"), dir);
  if (file_size(dir) == -2 && dir[<1] != '/') dir += "/";
  if (dir[<1] == '/') dir += "*";
  file = get_dir(dir);
  i = sizeof(file);
  if (!i) return notify_fail("没有这个档案。\n");
  write("rm " + dir + "\n");
  dir = implode(explode(dir, "/")[0..<2], "/") + "/";
  while (i--)
    if (file_size(dir + file[i]) >= 0) {
      if (!rm(dir + file[i])) break;
      write("\r" + file[i] + " ");
    }
  if (i >= 0) write("\n你没有删除这个档案的权利。\n");
  else write("\nok.\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : rm <档名>

此指令可让你删除有权修改的档案。
HELP
  );
  return 1;
}
