#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me,string obj)
{
        object dst;
        int max;
        if (!geteuid()) seteuid(getuid());
        if(!obj)
                dst = this_player();
        else
                dst = present(lower_case(obj), environment(this_player()));

        if (!dst) return notify_fail ("没有"+obj+"\n");
        dst->reincarnate();
        max = dst->query("eff_jingli");
        dst->set("jingli",max);
        max = dst->query("max_jing");
        dst->set("eff_jing",max);
        dst->set("jing",max);
        max = dst->query("max_qi");
        dst->set("eff_qi",max);
        dst->set("qi",max);
        max = dst->query("max_neili");
        dst->set("neili",max);
        max = dst->max_food_capacity();
        dst->set("food",max);
        max = dst->max_water_capacity();
        dst->set("water",max);

        if (wizardp(dst)) dst->clear_condition();
        if (dst != this_player()&&!wizardp(dst)&&userp(dst))
        {
        log_file("full", sprintf("[%s] %s full %s(%s)。\n",
                ctime(time())[0..15], geteuid(this_player(1)), dst->name(),dst->query("id")));
                message_vision( HIR"$N使用巫师权利恢复了$n!\n"NOR,
                                this_player(), dst);
        }
        else
                printf(dst->name()+"状态恢复完毕！\n");

        return 1;
}
