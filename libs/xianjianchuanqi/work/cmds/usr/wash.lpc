int main(string arg) {
  object *obj, me, target;
  int i, test;

  me = this_player();
  if (!stringp(arg) || !sscanf(arg, "%s", arg)) return 0;

  target = find_living(arg);


  if (!target || environment(target) != environment(me)) return 0;
  message_vision("$N拿起了毛巾在$n的后背上使劲擦，口中低吟：“我擦，我擦，我擦擦擦……”\n", me, target);
  me->start_busy(6);
  call_out("out", 3, target);
  return 1;
}
int out(object target) {
  object me;
  me = this_player();
  message_vision("$N说到：“好了好了，你的技术也太差了……，唉……，走人了……”\n", target);
  message_vision("$N心中骂到：“哼，和大象皮似的，累死我了。”\n", me);
  me->add("times", 1);
  return 1;
}
