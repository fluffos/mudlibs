// quit.c

#include <ansi.h>
#include <command.h>

inherit F_DBASE;

void do_quit(object, object);

mixed query(string arg) {
  if (arg && arg == "channel_id")
    return HIM "游戏管理器(Quit)";
  return 0;
}
void create() {
  seteuid(getuid());
  set("channel_id", "离线指令");
}

int main(object me, string arg) {
  object link_ob;
  int flag = 0;

  if (me->query_temp("quit"))
    return notify_fail("正在退出过程中，请稍候。\n");
  link_ob = me->query_temp("link_ob");

  // We might be called on a link_dead player, so check this.
  if (link_ob) {

    // Are we possessing in others body ?
    if (link_ob->is_character()) {
      write("你的魂魄回到" + link_ob->name(1) + "的身上。\n");
      exec(link_ob, me);
      link_ob->setup();
      return 1;
    }
  }

  if (interactive(me) && query_idle(me) < 10) {
    if (me->is_busy()) return notify_fail("你现在正忙着做其他事，不能退出游戏！\n");
    if (me->is_fighting()) return notify_fail("你现在正在战斗，不能退出游戏！\n");
    if (me->query_temp("sq_pk") && !wizardp(me)) return notify_fail(HIR "才杀了人就想一走了之？你杀了人，跑不了了！\n" NOR);
  } else flag = 1;
  /*
        if(  explode(base_name(environment(me)), "/")[0] == "d" 
          && explode(base_name(environment(me)), "/")[1] == "death")
                return notify_fail("在地府里QUIT？你想永远留在这里？！\n");
*/
  if (!environment(me)->query("no_save") && !me->is_ghost()) me->set(
    "startroom",
    base_name(environment(me))
  );

  me->set_temp("quit", 1);
  CHANNEL_D->do_channel(this_object(), "sys", NOR + me->short() + HIR " 准备离开游戏了。");
  if (!flag && !wizardp(me) && !environment(me)->query("valid_startroom")) {
    write("正在退出游戏......\n");
    call_out("do_quit", 3, me, link_ob);
  } else do_quit(me, link_ob);

  return 1;
}

void do_quit(object me, object link_ob) {
  int i;
  object *inv;

  if (!me) return;
  if (!wizardp(me)) {
    inv = all_inventory(me);
    for (i = 0; i < sizeof(inv); i++)
      if (!inv[i]->query_autoload())
        DROP_CMD->do_drop(me, inv[i]);
  }
  write("欢迎下次再来！\n");
  message("system", me->name() + "离开游戏。\n", environment(me), me);

  CHANNEL_D->do_channel(this_object(), "sys", NOR + me->short(1) + HIR " 离开游戏了。");

  if (link_ob) {
    link_ob->set("last_on", time());
    link_ob->set("last_from", query_ip_name(me));
    link_ob->save();
    destruct(link_ob);
  }

  if (me->query("mud_age") == me->query_temp("mud_age"))
    me->add("mud_age", 1);
  if (!wizardp(me)
    && (i = (me->query("combat_exp") - me->query_temp("combat_exp")) * 60
      / (me->query("mud_age") - me->query_temp("mud_age"))) > 100)

    if (!wizardp(me) && i > 1000 && me->query_temp("combat_exp") != 0) CHANNEL_D->do_channel(
      this_object(),
      "wiz",
      HIY "\n" + me->name() + "(" + me->query("id") + ")离开游戏。本次游戏经验值评估：" + HIR + i + HIY + "可能有些不正常，请在线巫师查看。\n" NOR
    );


  log_file("nosave/EXP",
    sprintf("%s 上次经验：%d，本次经验：%d，平均：%d/min\n",
      geteuid(me), me->query_temp("combat_exp"),
      me->query("combat_exp"), i));

  me->save();
  destruct(me);
}

int help(object me) {
  write(@HELP
指令格式 : quit

当你想暂时离开时, 可利用此一指令。
HELP
  );
  return 1;
}
