// by tiantian(www.wangcf.com) 2001.4
// 申请加入对方所在的帮派

#include <ansi.h>
#include <group.h>

int do_time(object me);

int main(object me, string arg)
{
	object ob, old_app;

    seteuid(getuid(me));

    if( !arg ) 
    	return notify_fail("指令格式：gjoin [cancel]|<对象>\n");

    if( me->query("group")) 
    	return notify_fail("你已经加入某个帮派了。\n");

	if( me->query("combat_exp") < EXP_GROUP_DISCIPLE )
		return notify_fail( "你的武功太差了，最好过几年再出来闯荡吧。\n" );

    if( arg=="cancel" ) {
    	old_app = me->query_temp("join");
        if( !objectp( old_app) || !userp( old_app ) )
    	    return notify_fail("你现在并没有向任何人申请加入帮派。\n");
        write( "你改变主意不想申请加入" + old_app->name() + "所在的帮派了。\n" );
        tell_object( old_app, me->name() + "改变主意不想向你申请加入帮派了。\n" );
        me->delete_temp("join");
        return 1;
    }

    if( !( ob = present( arg, environment(me) ) ) || !userp( ob ) )
	    return notify_fail( "你想向谁申请加入帮派？\n" );

    if( ob == me ) 
    	return notify_fail("向自己申请加入帮派做什么。\n");

	if( !ob->query( "group" ) )
		return notify_fail( "对方并没有加入任何帮派。\n" );

    if( !living(ob) ) 
    	return notify_fail( "你必须先把" + ob->name() + "弄醒。\n" );

    if( !( ob->query("group/lvl") < GROUP_MINISTER ) )
	    return notify_fail( "对方在帮中的级别太低,不能发展新成员。\n" );

    // If the target is willing to recruit us already, we do it.
    old_app = me->query_temp("join");
    if( ob == old_app )
	    return notify_fail( "你向" + ob->name() + "申请加入帮派，但是对方还没有答应。\n" );
    else if( objectp( old_app) && userp( old_app ) ) {
    	write( "你改变主意不想向" + old_app->name() + "申请加入帮派了。\n" );
        tell_object(old_app, me->name() + "改变主意不想向你申请加入帮派了。\n");
    }

    message_vision("$N向$n申请加入帮派。\n", me, ob);
    me->set_temp("join", ob );
    tell_object( ob, YEL "如果你愿意收" + me->name() + "入帮，用 gaccept 指令。\n" NOR );
    call_out("do_time",20,me);

    return 1;
}

int do_time( object me )
{
	if( !me ) return 0;

    if( me->query_temp( "join" ) ) {
    	me->delete_temp( "join" );
        write( "看样子对方好像不想理你。\n" );
    }
    
    return 1;
}

int help(object me)
{
write(@HELP
----------------------------------------
指令格式：gjoin [cancel]|<对象>

申请加入对方所在的帮派。

对方在帮派中的级别必须是长老以上，才可以发展新成员。

相关命令：gaccept

----------------------------------------
HELP
        );
        return 1;
}

