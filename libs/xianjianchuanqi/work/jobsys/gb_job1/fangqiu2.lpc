// fangqiu.c 
inherit NPC;
inherit __DIR__"gb_nz";
#include "gaibang_npc.lpc"
string ask_job();
void create()
{
	set_name("方裘", ({ "fang qiu", "fang"}));
	set("gender", "男性");
	set("age", 40);
	set("long", "这是位豪爽大方的丐帮八袋弟子，是大仁分舵的舵主。\n");
	set("combat_exp", 100000);
	set("shen_type", 0);
	set("attitude", "peaceful");
	
	set_skill("blade", 80);
	set_skill("dodge", 90);
        set_skill("force",80);
        set_skill("xiaoyaoyou",80);
        set_skill("huntian-qigong",80);
        set_skill("liuhe-daofa",80);
        set_skill("begging",60);  
        set_skill("suohou-shou",80);
        set_skill("hand",80); 
        map_skill("hand","suohou-shou");
        map_skill("dodge","xiaoyaoyou");
        map_skill("blade","liuhe-daofa");
        map_skill("parry","liuhe-daofa");
        map_skill("force","huntian-qigong");	
        set_temp("apply/attack", 20);
	set_temp("apply/defense", 20);
        create_family("丐帮", 19, "八袋长老");
        set("inquiry", ([
                "丐帮" : "我们丐帮是天下第一大帮！\n",
                "升袋" : (: ask_me :),
                "job"  : (: ask_job:),
        ]));
        setup();
	carry_object("/clone/armor/gb_budai8")->wear();
        carry_object("/clone/weapon/blade")->wield();
}

int accept_object(object who, object ob)
{
         int pot ,exp ,extra ;
if (promotion_checking(who,ob)) return 1;
else if ((string)ob->query("id")=="qing zhuling" ){
if ((string)ob->query("owner")!=(string)who->query("id")) return notify_fail("这不是你的吧。\n");
	command("applaud " + who->query("id"));
        command("say 做得好，行侠仗义正是本帮本色。");
        who->add("gb_job",1);
	who->delete_temp("gbjob1_target_name");
	who->delete_temp("gbjob1_get");
	who->delete_temp("gbjob1_where");
        who->clear_condition("gbjob1_time");
             if( (int)who->query("max_pot") > 300 )
         extra = 0;
             else
          extra = (int)who->query("max_pot")/6;
                      exp=60*4 + random(120) + extra;
                       pot=40*4 + random(60) + extra;
                who->add("combat_exp",exp);
                who->add("potential",pot);
             log_file( "/log/job/fangqiu_songxin",sprintf("%s 
%s(%s)方裘任务奖励%d点经验，%d点潜能，目前实战经验：%d\n",ctime(time())[4..19],me->name(),me->query("id"),
              combat_exp")));;
        tell_object(who, HIY"你被奖励了"+ chinese_number(exp) +"点经验和"+ chinese_number(pot)+"点潜能！\n"NOR);
ob->destruct();
	return 1;
}
else return 0;
}
	
void attempt_apprentice(object ob)
{
	gb_apprentice(ob);        
}
int destroying(object ob)
{
destruct(ob);
return 1;
}
