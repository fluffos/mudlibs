#include <ansi.h>
inherit ITEM;
void create()
{
	set_name("青竹令", ({ "qing zhuling", "zhuling"}));
	set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "根");
		set("long",
"这是一青绿色的竹令，两头尖尖，写着一个"+RED"杀"NOR+"字。\n");
		set("value", 0);
//             set ("no_drop",1);
		set("material", "wood");
}
   }
