#include <ansi.h>
inherit "/jobsys/xx_mz/job_npc_status.lpc";
inherit "/jobsys/xx_mz/job_npc_skill.lpc";
inherit "/jobsys/xx_mz/jobwhere.lpc";
string *titles=({
"海沙帮","巨鲸帮","神拳门","泰山单家","五凤刀","淮阳帮","黄河帮","白鲸岛","长乐帮","清城派","红花会","六合门",});
string ask_job()
{                          
                 mapping job;
                  object me,job_npc;
                  string title,title_msg;
                  int jobtime, myexp;
                   jobtime = 30;
         me=this_player();
       if ((int)me->query("combat_exp",1)<100000)
            return RANK_D->query_respect(me)+"武功未成，为帮中出马我可不放心。";                   
       if (interactive(me) &&(int)me->query_condition("tzjob_time") && me->query_temp("tzjob_get"))  
       return "不是让你去保护"+me->query_temp("tzjob_target_name")+"了么，快快去干。";
       job_npc= new(__DIR__"haoke");
       title=titles[random(sizeof(titles))];
      set_npc_name(job_npc);
      title_msg=select_color()+title+NOR;
     job_npc->set("title",title_msg);
     set_npc_basedata(me,job_npc,50,60,1);
      job_npc->set("combat_exp",(int)me->query("combat_exp")/5*3);
         set_npc_skill(me,job_npc,60+random(5));
         job=query_job();
      me->set_temp("tzjob_get",1);
      me->set_temp("tzjob_target_name",job_npc->query("name")+"("+job_npc->query("id")+")");
      me->set_temp("tzjob_where",job["c_place"]);
      job_npc->apply_condition("tzjob_time",jobtime);
      me->apply_condition("tzjob_time",jobtime);
      job_npc->set("saver",me->query("id"));
      job_npc->move(job["place"]);
      return "帮主挚友"+title+me->query_temp("tzjob_target_name")+"近日受人追杀，帮主已经颁下命令保护他们。\n"+"他们已经落魄逃亡至"+me->query_temp("tzjob_where")+"一带，你即刻出发，保护好他，万不可让他有所损伤。";
}
