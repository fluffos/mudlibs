void attempt_apprentice(object ob)
{
       if ((int)ob->query("shen") < 10000) {
               command("say 我武当乃是堂堂名门正派，对弟子要求极严。");
               command("say 在德行方面，" + RANK_D->query_respect(ob) +
                       "是否还做得不够？");
               return;
       }
       command("say 好吧，贫道就收下你了。");
       command("recruit " + ob->query("id"));
}

string ask_me()
{
       mapping fam; 
       object ob;
       
       if (!(fam = this_player()->query("family")) || fam["family_name"] != "武当派")
               return RANK_D->query_respect(this_player()) + 
               "与本派素无来往，不知此话从何谈起？";
       if (query("book_count") < 1)
               return "你来晚了，本派的内功心法不在此处。";
       add("book_count", -1);
       ob = new(__DIR__"force_book");
       ob->move(this_player());
       return "好吧，这本「太极十三式」你拿回去好好钻研。";
}
string ask_me1()
{
        mapping fam; 
        object ob;
        
        if (!(fam = this_player()->query("family")) || fam["family_name"] != "武当派")
                return RANK_D->query_respect(this_player()) + 
                "与本派素无来往，不知此话从何谈起？";
        if (query("book1_count") < 1)
                return "你来晚了，刀法概要已经不在此处了。";
        add("book1_count", -1);
        ob = new(__DIR__"blade_book");
        ob->move(this_player());
        return "这本书中讲述的刀法要领，你会去好好研究一下。";
}

string ask_gonglao()
{
  object me;
  object who;
  int i;
           
  me = this_player();
  if(!me->query("wd_job_count"))
  i=0;
  else 
  i =(int)me->query("wd_job_count"); 
  message_vision(CYN"$N对$n说道:你已经完成了" + chinese_number(i) + "次任务。\n"NOR,who,me);
  return "继续努力吧！";
}



int ask_job()
{      
        object me;
        me = this_player(); 
        
    if( me->query("job/wd-done")>0)
    {
                tell_object(me,"你必须先把上次的任务报告了以后才能再要任务。\n");
                return 1;
    } 
    else 
    if( me->query("job/wd")>0)
    {
                tell_object(me,"你已在这儿要过任务了，快去巡查。\n");
                return 1;
    } 
    else 
    if( me->query("combat_exp")<60000)
    {
                tell_object(me,"你的爱派之心可表，可是巡查不是儿戏，不要丢了性命。\n");
                return 1;
    }

    message_vision(CYN"宋远桥对$N说道：本门弟子得到情报，蒙古鞑子的前哨已到本派之中，你这就去巡查一翻，将他们剿灭干净。\n"NOR,me); 
        me->set("job/wd", 1);
        me->apply_condition("wd-job", 8);
        return 1;   
}

int ask_done()
{      

        object me,ob;
        int gong,exp,pot,money;
        me = this_player();
        gong = me->query("job/gong");
        exp = gong * 30;
        pot = gong * 12;
        money = gong * 5; 
        
    if( me->query("job/wd-done")< 1)
    {
                tell_object(me,"你的任务还没完成呢。\n");
                return 1;
    }

    message_vision(CYN"宋远桥对$N说道：做得不错！\n"NOR,me);
    message_vision(CYN"宋远桥对$N说道：你总共立了" + gong + "件功。\n"NOR,me);     
    message_vision(CYN"宋远桥对$N说道：该奖励你" + exp + "点经验，" + pot + "点潜能。你的侠义正气提高了!\n"NOR,me);        
    me->add("combat_exp",exp);
    me->add("potential",pot);
    me->add("shen",exp*2);
    me->delete("job/gong");

    me->delete("job/wd");
    me->delete("job/wd-done");
    me->add("wd_job_count",1); 
    return 1;
}

