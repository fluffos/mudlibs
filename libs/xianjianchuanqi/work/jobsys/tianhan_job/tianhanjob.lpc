// by blade
inherit NPC;
inherit F_MASTER;
#include <ansi.h>;

#define ADDRESS "/d/didian.lpc"
int ask_job();

void create()
{
        set_name("天寒血", ({ "tian hanxue", "tian" }) );
        set("title", HIR"魔尊"NOR);
        set("gender", "男性");
        set("class", "swordsman");
        set("age", 55);
        set("attitude", "peaceful");
        set("str", 26);
        set("con", 30);
        set("dex", 30);
        set("int", 28);

        set("neili", 5400);
        set("max_neili", 5400);
        set("jiali", 30);
        set("max_qi",3000);
        set("max_jing",1200);
        set("combat_exp", 1200000);
        set("shen", - 200000);

        set_skill("unarmed", 300);
        set_skill("staff", 300);
        set_skill("force", 300);
        set_skill("parry", 300);
        set_skill("dodge", 300);
        set_skill("lingshe-zhangfa", 300);
        set_skill("tiyunzong", 300);
        set_skill("hamashengong", 300);

        map_skill("staff", "lingshe-zhangfa");
        map_skill("parry", "lingshe-zhangfa");
        map_skill("force", "hamashengong");
        map_skill("dodge", "tiyunzong");


        set("inquiry", ([
                "job" : (: ask_job :),
                ]));
        setup();

        carry_object("/d/baituo/obj/shezhang")->wield();
        carry_object("/clone/cloth/cloth")->wear();
}
int ask_job()
{
        mapping me_hp,place, me_skill;
          int i,j,max_skill;
        object ob, me, name1,shouhuntie,target,target_id,ob1;
        me = this_object();
        ob = this_player();
           me_hp = ob->query_entire_dbase();
            me_skill = ob->query_skills();
        place = ADDRESS->query_quest();
          if(this_player()->query("combat_exp") < 200000) 
             {
             command("say  这点屁本事也想入我魔道？我靠！");
           return 1;
              }
          if(this_player()->query_skill("parry") < 1) 
             {
             command("say 去学点基本招架吧，我怕你应付不来。");
           return 1;
              }
          if(this_player()->query("combat_exp") >= 5500000) 
             {
             command("say 小子武功比我高,这里已经没有什么你好做的了.....");
           return 1;
              }
          if(this_player()->query("shen") >= 1) 
             {
             command("say 你们这些正派人事也来混水摸鱼啊！我再靠！");
           return 1;
              }
            if ( ob->query_condition("mdjob") ){
                command("say 领了任务还不快去，还在这里站着做什么？我靠！");
                return 1;
          }
        if((int) this_player()->is_ghost())
             {
                write(BLU"鬼魂不可要工作．\n"NOR);
                return 1;
        }
        if (  !present("shouhun tie", this_player()) )
        {
                shouhuntie = new("/jobsys/tianhan_job/shouhuntie");
                shouhuntie->move(this_player());
        }
          ob1 = new("/jobsys/tianhan_job/mdnpc");
        ob1->set("long", 
                 "他是"HIR BLINK+ob->query("name")+NOR"的目标.\n");
        ob1->set("max_qi",              me_hp["max_qi"]);
        ob1->set("eff_qi",              me_hp["eff_qi"]);
        ob1->set("qi",                  me_hp["qi"]);
        ob1->set("max_jing",    me_hp["max_jing"]);
        ob1->set("eff_jing",    me_hp["eff_jing"]);
        ob1->set("eff_jingli",  me_hp["eff_jingli"]);
        ob1->set("max_jingli",  me_hp["max_jingli"]);
        ob1->set("jingli",              me_hp["jingli"]);
        ob1->set("max_neili",   me_hp["max_neili"]);
        ob1->set("neili",               me_hp["max_neili"] * 4 / 3);
        ob1->set("jiali", 50);
        if(me_hp["combat_exp"] >= 150000) ob1->set("jiali", 80);
        if(me_hp["combat_exp"] >= 300000) ob1->set("jiali", 90);
        if(me_hp["combat_exp"] >= 500000) ob1->set("jiali", 100); 
        ob1->set("combat_exp",  me_hp["combat_exp"] + 12000);
        ob1->set("force",me_skill["parry"]);
        ob1->set_skill("dodge", me_skill["dodge"]);
        ob1->set_skill("cuff", me_skill["dodge"]);
        ob1->set_skill("wuhu-duanmendao", me_skill["parry"]);
        ob1->set_skill("parry", me_skill["parry"]);             
        ob1->set_skill("shenxing-baibian", me_skill["parry"]);             
        ob1->set_skill("yijin-jing", me_skill["parry"]);             
        ob1->set_skill("blade", me_skill["parry"]);             
        ob1->map_skill("force", "yijin-jing");
        ob1->map_skill("blade", "wuhu-duanmendao");
        ob1->map_skill("parry", "wuhu-duanmendao");
        ob1->map_skill("dodge", "shenxing-baibian");

        ob1->set_skill("qishang-quan", me_skill["parry"]);             
        ob1->map_skill("cuff", "qishang-quan");
        ob1->prepare_skill("cuff", "qishang-quan");

        ob1->set("target_id", ob->query("id"));
        place = ADDRESS->query_quest();
        ob1->move(place["place"]);
        j = 6 + random(6);
        for( i=0;i < j;i++)
        ob->apply_condition("mdjob", 20);
        target = ob1->query("name");
        ob->set_temp("md_target",target);
        command("say 最近"+ob1->query("nickname")+CYN"武士"+ob1->query("name")+CYN"老和我魔教
作对，正好大爷我最近肚子有点饿.");
        command("say 这小子现在已经到了"HIR+place["short"]+NOR+CYN"方圆"+chinese_number(j)+"里之内."NOR);
        command("say 你去将他杀了,带他的心肝回来给魔爷爷我下酒.");
return 1;
}
int accept_object(object who, object ob, object me)
{
       if ( ob->query("victim_name") != who->query_temp("md_target"))
       {
         command("say 我靠!你脑袋是不是有问题！这个不是那小子的心肝");
           return 0;
        }    
         if ( ob->query("victim_user"))
      {
         command("say 想死啊，敢做弊!？");
           call_out("destroying", 1, ob);
         return 0;
         }
//             if ( ob->query("kill_by") != who) {
//               command("say 你怎麽冒领其他人的功劳呢？");
//             return 0;
//           }

        if ( ob->query("id") != "xinzang" ) 
        {
                command("say 魔爷爷我今天心情好，放你一马不和你小子计较。");
                return 0;
        }
        call_out("destroying", 1, ob);
        call_out("ok", 1, who);
        return 1;
}

void ok(object who)
{
        int exp,pot,job_time;
        if (!who) return;
        command("thumb " + who->query("id"));
        command("say 哈哈哈，小子有我当年的风范!不错不错！");

                exp = 150 + random((int)who->query("force")*4/2);
                pot = exp*3/2;
            tell_object(who,HIW"你被奖励了：\n" + 
                       chinese_number(exp) + "点实战经验\n" +
                       chinese_number(pot) + "点潜能\n"NOR);
           
        message("chat", HIM"〖小道消息〗：听说"+who->query("name")+"又杀了一个正派人士，在邪道中越走越远!\n"NOR,users());

        if( (int)who->query("learned_points")-pot < 0 ){
        who->set("learned_points", 0);
        }
        else {
        who->set("learned_points", (int)who->query("learned_points")-pot);
        }

        who->add("combat_exp",exp);
        who->add("potential",pot);
        who->add("shen",- exp*2);
        who->delete_temp("md_target");
//        who->apply_condition("after_mdjob", 3);
        who->apply_condition("mdjob", 0);   
 
}   

void destroying(object obj)
{
        destruct(obj);
        return;
}


