// by blade
#include <ansi.h>
inherit NPC;
inherit F_UNIQUE;

string *name = ({
"风",
"火",
"雷",
"电",
});
string *id = ({
"feng",
"huo",
"lei",
"dian",
});
     void create()
 {
          set_name(name[random(sizeof("name"))],({"guarder",""}));
        set("age",30+random(10));
        set("attitude", "peaceful");
        set("nickname",HIW"天蚕门"NOR);
        set("str", 40+random(10)); 
        set("int", 20+random(10));
        set("con", 40+random(10));
        set("dex", 40+random(10));
        set("combat_exp", 500000);
        set("shen_type", -1);
        set("max_jingli", 2000);
        set("max_neili", 6000);
        set("eff_jingli", 4000);
        set("neili", 6500);
        set("jingli",4000);
        set("jiali",100);
        set("score", 1000);
        set_skill("force", 150);
        set_skill("unarmed", 150);
        set_skill("dodge", 150);
        set_skill("parry", 150);
        set_skill("blade", 150);
        set_skill("hand", 180);
        set_skill("sword", 150);
        set_skill("longxiang", 280);
        set_skill("shenkong-xing", 180);
        set_skill("hand", 180);
        set_skill("dashou-yin", 180);
        set_skill("mingwang-jian", 180);
        set_skill("xue-dao", 180);
        map_skill("dodge", "shenkong-xing");
        map_skill("hand", "dashou-yin");
        map_skill("parry", "xue-dao");
        map_skill("blade", "xue-dao");
        map_skill("sword", "mingwang-jian");
        set("chat_chance_combat", 20);  
        set("chat_msg_combat", ({
                (: perform_action, "blade.shendao" :),
                (: exert_function, "recover" :),
        }) );
        setup();
        add_money("gold", 1);
        carry_object("/d/city/obj/tiejia")->wear();
        carry_object("/clone/weapon/gangdao")->wield();
        carry_object("/clone/weapon/changjian")->wield();
}

void init() 
{
        object ob;
        ::init();
        ob = this_player();
       if( this_object()->query("owner_id")== this_player()->query("id")){
      command(RED"say 嘿嘿,"+ob->query("name")+"胆敢行刺我家将军！\n"NOR);
                remove_call_out("do_killing");
               call_out("do_killing",2,ob);
        }
        if(!query("dest"))
        {
                call_out("dest", 100);
        }
}

void do_killing(object ob)
{
        if (!ob || environment(ob) != environment())
                return;
        this_object()->kill_ob(ob);
}

void dest()
{
       object ob;
       ob = this_object();
       message_vision("$N说道：好身手,改天在来领教。\n",ob);  
       message_vision("$N匆匆忙忙的离开了。\n",ob);  
       destruct(this_object());
}

