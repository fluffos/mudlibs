// letter.c
// by blade
inherit ITEM;
#include <ansi.h>

void create() {
  set_name(HIR "密函" NOR, ({ "mihan" }));
  set_weight(100);
  set("value", 0);
  //        set("no_get",1);
  //        set("no_drop",1);
  set("unit", "张");
  set("long",
    "这是一封密函,不知道藏有什么秘密.\n"); set("material", "paper");


}

void init() {
  add_action("do_send", "send");
  call_out("dest", 230);
}

int do_send() {
  mapping quest;
  int exp, score, pot;
  object me = this_player();
  quest = me->query("quest");
  if (this_object()->query("owner_id") != me->query("id"))
    return notify_fail("这好象不是你的吧?!");
  //       destruct(this_object());
  if (me->query("target") == base_name(environment(me))) {
    message_vision(HIG "" + quest["name"] + "低声说道：谢谢你了同志,国家和人民不会忘记你的。\n" NOR, me);
    exp = 150 + random(250);
    pot = exp / 3 - random(120);
    score = random(1);
    me->add("combat_exp", exp);
    me->add("potential", pot);
    me->delete_temp("target_name");
    me->delete_temp("target_path");
    me->delete("quest");
    me->apply_condition("fjob", 0);
    tell_object(me, HIW "由于你的出色表现你被奖励了：\n" +
      chinese_number(exp) + "点实战经验\n" +
      chinese_number(pot) + "点潜能\n" NOR);

    message(
      "chat",
      HIM "〖小道消息〗：听说" + me->query("name") + "把密函送到了" + quest["name"] + "的手中!\n" NOR,
      users()
    );
    destruct(this_object());
  } else {
    message_vision(HIW "这么重要的东西你可不能乱给啊！\n" NOR, me);
  }
  return 1;
}
void dest() {
  object ob;
  ob = this_object();
  message_vision("一阵大风吹来,你一个不留神,密函被风吹走了。\n", ob);
  destruct(this_object());
}
