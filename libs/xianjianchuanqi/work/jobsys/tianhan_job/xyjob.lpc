// linzhennan.c 林震南

#include <ansi.h>

inherit NPC;

string do_quest();
string ask_gonglao();
void create()
{
        set_name("北冥子", ({ "beiming zi", "zi", "beiming" }));
        set("gender", "男性");
        set("age", 45);
        set("title", "逍遥派护法");
        set("long", "这位就是逍遥派的护法弟子，北冥子\n");
        set("combat_exp", 30000);
        set("shen_type", 1);
        set("max_neili", 500);
        set("neili", 500);
        set("jiali", 10);
        set_skill("force", 240);
        set("per",19);
        set_skill("unarmed", 250);

        set_skill("dodge", 250);
        set_skill("parry", 250);
        set("inquiry", ([
                "work": (:do_quest:),
                "功劳": (:ask_gonglao:),
        ]) );
        set_temp("apply/attack", 330);
        set_temp("apply/defense", 330);
        set_temp("apply/damage", 333);
        setup();
        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/clone/misc/cloth")->wear();
}


string chinese_time(int t)
{
        int d, h, m, s;
        string time;
        s = t % 60;     t /= 60;
        m = t % 60;     t /= 60;
        h = t % 24;     t /= 24;
        d = t;
        if(d) time = chinese_number(d) + "天";


        else time = "";
        if(h) time += chinese_number(h) + "小时";
        if(m) time += chinese_number(m) + "分";
        time += chinese_number(s) + "秒";
        return time;
}

string do_quest()
{
        mapping target=([
        "jinlun fawang":         "法王 金轮法王",
        "daerba":         "密宗第十代弟子 达而巴",
        "xu xueting":         "神龙教青龙使「热血神龙」许雪亭",
        "shou toutuo":         "神龙教右护法「辽东瘦尊者」瘦头陀",
        "lu gaoxuan":         "神龙教军师「神机妙算」陆高轩",
        "hong antong":         "神龙教教主 洪安通",
        "tong lao":         "灵鹫宫主人「唯我独尊」天山童姥",
        "xu zhu":         "灵鹫宫掌门人 虚竹",
        "song yuanqiao": "武当派第二代弟子「武当首侠」宋远桥",
        "huise zunzhe": "少林派第三十八代弟子 慧色尊者",
        "xuannan dashi": "少林派第三十六代弟子「般若堂首座」玄难大师",
        "xuanku dashi": "少林派第三十六代弟子「罗汉堂首座」玄苦大师",
        "jinghe shitai":         "峨嵋派第四代弟子 静和师太",
        "jingxian shitai":         "峨嵋派第四代弟子 静闲师太",
        "jingfeng shitai":         "峨嵋派第四代弟子 静风师太",
        "fang bilin":         "峨嵋派第四代弟子 方碧琳",
"jingxian shitai":        "峨嵋派第四代弟子 静闲师太",
  "du nan":        "少林长老 渡难",
  "du jie":        "少林长老 渡劫",
  "du e":          "少林长老 渡厄",
        "yue buqun":         "华山派掌门「君子剑」岳不群",
        "yu lianzhou":          "武当派第二代弟子「武当二侠」俞莲舟",
        "song yuanqiao":        "武当派第二代弟子「武当首侠」宋远桥",
        "ding chunqiu":         "星宿派开山祖师「星宿老怪」丁春秋",
        "wei yixiao":           "明教青翼蝠王 韦一笑",
          "shi daizi":            "华山派第十四代弟子 施戴子",
          "zhao zhijing":          "全真教第三代第子 赵志敬",
          "lu guanying":          "归云庄少庄主 陆冠英", 
"zuo lengchan":        "嵩山派第四代掌门人「嵩山派掌门人」左冷禅",
          "maimaiti":             "杂货铺老板 买卖提",
         "alamuhan":             "牧羊姑娘 阿拉木罕",
          
          "qingfa biqiu":         "少林派第四十代弟子 清法比丘",
        
        "gu yanwu":             "顾炎武",
        "gao shengtai":         "大理官员「善阐侯」高升泰",
        "fu sigui":             "大理镇南王府侍卫 傅思归",
        "zhu wanli":            "大理镇南王府侍卫 褚万里",
        "ba tianshi":           "大理官员「司空」巴天石",
        "xu zhu":               "灵鹫宫掌门人「梦郎」虚竹",
        
        "zhang sanfeng":        "武当「邋遢真人」张三丰",
        ]);                     
          int ran, t, time;
        string *str;
        object ob, who, obj;
        ob = this_object();
        who = this_player();
      if (who->query("zlqjover")) return "珍珑已过,无信可送了\n";
 
  if ((who->query("family/family_name") != "逍遥派")&&who->query("xytask",1)>=1000 && !who->query("zlqj1")&& !who->query("zlqjover")) 
{     
      who->set("zlqj1",1);
   return "真是后生可喜啊,本门祖师爷要见你!先去后面的大空地吧!那里有东西等着你!\n";         
} 
 else if ((who->query("family/family_name") == "逍遥派")&&who->query("xytask",1)>=500 && !who->query("zlqj1") && !who->query("zlqjover"))      
{
        who->set("zlqj1",1);
     return "真是后生可喜啊,祖师爷要见你!先去后面的大空地吧!那里有东西等着你!\n";
}
       if ( environment(this_object())->query("short")!="青草坪" )
                return "这里不是本门范围，你有事回青草坪再说吧\n";

        if (who->query("combat_exp") < 20000)

                return "你还是先练几年功再来吧，我怕你出师未捷身先死啊！\n";

        if (who->query("combat_exp") > 2000000)
                return("您这样的高手，送信这点小事怎敢麻烦您去做啊！\n");
//        if (who->query("family/family_name") != "逍遥派")
//                return "你不是本门弟子，我可不敢放心的将秘函给你！\n";
        t = time()-who->query("songxin/start");
        time = who->query("songxin/time");

        if( t <= time )
                return RANK_D->query_respect(who) + "似乎还有任务在身吧？\n";
        if( t > time && who->query("songxin/time") && who->query("songxin/start") ) {
                if( obj = present("mi xin", who) ) {
                        message_vision(CYN+"$N很生气地对$n说道：秘函虽说没送到，但总算没丢！下去休息休息再说吧！\n"+NOR, ob, who);
                        tell_object(who, "你没有及时把秘函送到"+target[obj->query("target")]+"手中，你的任务失败了！\n");
                        who->delete("songxin/start");
                        who->delete("songxin/time");
                        who->set("songxin/halt", time());
                        destruct(obj);
                        return "快滚！不要让我再见到你！！";
                }
                else {
                        message_vision(CYN+"$N很生气地对$n说道：你送不到也就算了，竟然把秘函都弄丢了，看你这回怎么向师傅交代！\n"+NOR, ob, who);

                        tell_object(who, "你没有完成任务，连秘函也弄丢了，唉。。。\n");
                        who->delete("songxin/start");
                        who->delete("songxin/time");
                        who->set("songxin/halt", time()+30);
;
                        return "快滚！不要让我再见到你！！";
                }
        }
 if( time()-who->query("songxin/halt") >= 100 )
                who->set("songxin/halt",0);
        else {
                command("heng " + who->query("id"));
                return this_player()->name() + "，刚把密函弄丢，怎么又来要了？。\n";
        }

        t = ( 60 + random(20) ) * 10;
        str=keys(target);
        ran = random(sizeof(str));
        ob = new("/jobsys/tianhan_job/mixin");
        ob->set("target", str[ran]);
        who->set("songxin/start", time());
        who->set("songxin/time", t);
        ob->move(who);


        return ("你来得正好，本门祖师爷最近摆了一个珍陇棋局，广邀天下英雄前来破此棋局，
这是给" + target[str[ran]] + "的秘信。赶快送过去，一路小心\n"+"你还有" + chinese_time(t)+ "的时间。快快动身吧！\n");
}
string ask_gonglao()
{
  object me;
  int task; 
   me = this_player();
   if(!me->query("xytask"))
  task=0;
  else  
task = (int)me->query("xytask");     return 
("你已经完成了" + chinese_number(task) + "次任务! 继续努力吧！\n");
}

