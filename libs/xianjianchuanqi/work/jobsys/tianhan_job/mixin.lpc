// mixin.c
//last by jrx@xssx
#include <ansi.h>
inherit ITEM;

int robberC;
int flagR;
int rob;
int robs;
int potential_lv(int exp);

void create()
{
        set_name( "秘信", ({ "mi xin", "mi","xin" }) );
        set_weight(2000+random(3000));
        set("no_put", 1);                       // 这样东西不能放入容量
        set("identifier", random(10000));       // 全球镖银识别码 呵呵

        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "封");
                set("long", "一封秘信，是逍遥子亲手所写的。\n");
        }

        flagR=0;
        robberC=7+random(4);
        rob=0;
        robs=random(2);
        robs=(robs<1)?1:robs;
}

void init()
{
        add_action("do_give", "give");
        add_action("do_go", "go");
        add_action("do_trans", "trans");
        add_action("do_home", "home");
        add_action("do_sleep", "sleep");
        if( query("target") ) {
                remove_call_out("set_target");
                call_out("set_target", 4, query("target"));
                delete("target");               // add 4 seconds' delay, can't be so fast
        }
}

int do_trans()
{
        tell_object(this_player(),"你带着这么重的秘信可飞不动。\n");
        return 1;
}

int do_sleep()
{
        tell_object(this_player(),"你带着秘信还睡觉！！！去阎王爷哪儿睡不是更好！\n");
        return 1;
}
void set_target(string target)
{
        set("target", target);
}

int do_go(string arg)
{
        object robber, env;
        mapping exit;

        env = environment(this_player());
        exit = env->query("exits");
        if(!env) return notify_fail("你哪里也去不了。\n");

        if( !mapp(exit = env->query("exits")) || undefinedp(exit[arg]) )
                return notify_fail("这个方向没有出路。\n");

        if ( objectp(robber=present("xiaoyao pantu", env)) ) {
                if ( robber->is_killing(this_player()->query("id")) && living(robber) && random(10) < 7 ) {
                        switch(random(2)) {
                                case 0:
                                        message_vision(HIR"\n$n一把拦在$N面前。小子可把你找到了！\n"NOR, this_player(), robber);
                                break;
                                case 1:
                                        message_vision(HIR"\n$n团团把$N围住，秘函留下，休想离开！\n"NOR, this_player(), robber);
                                break;
                                case 2:
                                        message_vision(HIR"\n$n喝道：“识相的就赶快交出秘函！”\n"NOR, this_player(), robber);
                                break;
                        }
                        return 1;
                }
        }

        flagR++;

        if( flagR == robberC && environment(this_player())->query("outdoors") && rob <= robs ) {
                if(!this_player()->is_busy())
                        this_player()->start_busy(1);
                remove_call_out("attract_robber");
                call_out("attract_robber", 0);
                flagR = 0;
                robberC=random(11);
                robberC=(robberC<7)?7:robberC;
                return 1;
        }
//      write(flagR+"\n");
//      write(robberC+"\n");
        return 0;
}

int do_give(string arg)
{
        int i, bonus; 
        int task;
        string obj, target;
        object me, ob, home;

        if(!arg || arg==" ")
                return 0;
        if( sscanf(arg,"%s to %s", obj, target)!=2 )
                if(sscanf(arg,"%s %s", target, obj) !=2 )
                        return 0;

        if( !id(obj) ) return 0;

        me = this_player();

        if(!ob = present(target,environment(me)) ) {
                tell_object(me,"你想要把秘函交给谁？\n");
                return 1;
        }

        if(!ob->id(query("target")) || userp(ob)) {
                tell_object(me, "你不能把这样东西给这个人。\n");
                return 1;
        }

        if(!living(ob) ) {
                tell_object(me,ob->query("name")+"已经无法收下这样东西了。\n");
                return 1;
        }

        if( !home = find_object(ob->query("startroom")) )
                home = load_object(ob->query("startroom"));
        if(environment(ob)!=home){
                message_vision(CYN+"$N说道：我现在正忙着呢！等我回去再说吧！"+NOR, ob);
                return 1;
        }

        message_vision("$N拿出一箱镖银交给了" + ob->query("name") + "。\n", me);
        if((time()-me->query( "songxin/start" ))>me->query( "songxin/time" ) ) {
                message_vision(CYN+"$N很生气地对$n说道：这么点儿事都办不好，真没用！\n"+NOR, ob, me);
                tell_object(me, "你没有及时把秘函送到" + ob->query("name") + "的手中，你的任务失败了！\n");
/*              i = 200 + random(time()-me->query( "songxing/start" )-me->query( "songxing/time" ))/5;
                i = i/2;
                i = (i>100)?100:i;
                me->add("combat_exp", -i);
                tell_object(me, sprintf(WHT"你被扣除%s点战斗经验，\n"NOR, chinese_number(i)) );
                bonus = (int)me->query("potential");
                bonus = bonus - i/5 - 1;
                bonus = (bonus<(int)me->query("learned_points"))?(int)me->query("learned_points"):bonus;
                tell_object(me, sprintf(WHT"%s点潜能。\n"NOR, chinese_number(i/5+1)) );*/
                me->delete("songxin/start");
                me->delete("songxin/time");
                me->set("songxin/halt", time());
        }
        else {
                message_vision(CYN+"$N对$n笑道：很好！既然逍遥子前辈如此厚爱，本人一定准时赴会！\n"+NOR, ob, me);
                tell_object(me, "你成功地将秘函送到了" + ob->query("name") + "的手中!! 你的门派忠诚度提高了n");
               task = (int)me->query("xytask")/5; 

                i = 50 + task + random(me->query( "songxin/time" )-time()+me->query( "songxin/start" ))/5;
                task = (int)me->query("xytask"); 
               tell_object(me, sprintf(WHT"你获得了%s点战斗经验，\n"NOR, chinese_number(i)) );
                me->add("combat_exp", i);
                me->add("potential", i*2/3);
                me->add("xytask",1);
                tell_object(me, sprintf(WHT"%s点潜能。\n"NOR, chinese_number(i*2/3)) );
  

                me->delete("songxin/start");
                me->delete("songxin/time");
        }

        me->receive_damage("qi", 20+random(20));
        me->receive_damage("jing", 20+random(10));

        destruct(this_object());

        return 1;
}

// 设置强盗
void attract_robber()
{
        int robbers, i;
        object ob, robber, room;

        if (!userp(ob = environment(this_object())) ) return;

        robbers = random(3);
        robbers = (robbers<1)?1:robbers;
        room = environment(ob);

        if(!objectp(present("xiaoyao pantu", environment(this_player())))) {
                for(i=0; i<robbers; i++) {
                        robber = new("/jobsys/tianhan_job/xiaoyaopantu");
                        robber->set("target", query("identifier"));
                        robber->set("speaker", (i==0)?1:0);
                        robber->move(room);
                }
                rob++;
                message_vision("一群$n从路旁冲了出来，将$N团团围住。\n", ob, robber);
        }
}

void owner_is_killed() { destruct(this_object()); }

int potential_lv(int exp)
{
        int grade;

        grade = 100 + exp / 500;;
        return grade;
}

