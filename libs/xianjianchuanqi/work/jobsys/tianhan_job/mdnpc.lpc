// by blade
#define NAME_D    "/jobsys/tianhan_job/random_name"
#include <ansi.h>
inherit NPC;
inherit F_UNIQUE;
//inherit F_SAVE;

     void create()
 {
        mapping target_name;
        target_name = NAME_D->md_name();

        set_name(target_name["name"],({target_name["id"]}));
        set("gender","男性");
        set("nickname", HIY"名刀门"NOR);
        set("age", random(20) + 25);
        set("str", 13+random(5)); 
        set("int", 13+random(5));
        set("con", 13+random(5));
        set("dex", 13+random(5));
        set("combat_exp", 100000);
        set("shen_type", 0);
        set("attitude", "friendly");
        set("max_qi", 1000);
        set("max_jing", 1000);
        set("max_neili", 1000);
        set("eff_jingli", 1000);
        set("jingli",1000);
        set("score", 1000);
        set_skill("force", 100);
        set_skill("unarmed", 100);
        set_skill("dodge", 100);
        set_skill("parry", 100);
        set("env/wimpy", 20);
        set("chat_chance", 30);
        set("chat_msg", ({
                (: random_move :),
        }) );
        set("inquiry", ([
//                "伊贺流" : (: ask_killer :),
        ]));
        setup();
        add_money("silver", random(20) +20);
        carry_object("/d/city/obj/tiejia")->wear();
        carry_object("/clone/weapon/gangdao")->wield();
}

void init()
{
        object me, ob, obj;
        ::init();
        ob = this_player();
        me = this_object();
        if(interactive(ob)
        && !is_fighting()
        && me->query("target_id") == ob->query("id"))
//        && me->query_temp("start_kill"))
        {
      command(RED"say 嘿嘿"+ob->query("name")+"你终于来了，受死吧！\n"NOR);
                remove_call_out("do_killing");
               call_out("do_killing",2,ob);
        }
        if(!query("dest"))
        {
                call_out("dest", 300);
                me->set("dest", 1);
        }
}
                


void do_killing(object ob)
{
        if (!ob || environment(ob) != environment())
                return;
        this_object()->kill_ob(ob);
}

void dest()
{
       object me,ob;
       ob = this_player();
       me = this_object();
           if(me->query_temp("start_kill"))
                message_vision(CYN"$N说道：好身手，可惜大爷我没空跟你周旋，我改日再来领教。\n"NOR, me);  
       message_vision("$N说道：魔尊手下也不过如此。哼！。\n",me);  
       message_vision("$N匆匆忙忙的离开了。\n",me);  

       destruct(this_object());
}
void die(){
        object corp,me=this_object();
        
        corp=new("/clone/misc/corpse");
        corp->set("corpse",1);
        corp->set("kill_by",me->query("target_id"));
        corp->set("victim_id",me->query("id"));
        corp->set("victim_name",me->query("name"));
        corp->move(environment(me));
        message_vision(HIW"你又杀掉一个名刀门的高手!\n"NOR,me);
        destruct(me);
        return;
}


