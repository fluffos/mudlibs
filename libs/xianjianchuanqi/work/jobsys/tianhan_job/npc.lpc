#include <ansi.h>
inherit NPC;
#include <ansi.h>

string *name = ({
"平南王",
"征西将军",
"威武将军",
"平北将军",
"镇东将军",
});

void create()
{
          set_name(name[random(sizeof("name"))],({"commander",""}));
        set("gender", "男性");
        set("title", HIY"蒙古国"NOR);
        set("attitude", "friendly");
        set("age", 40);
        set("per", 10);
        set("str", 40);
        set("int", 40);
        set("con", 30);
        set("dex", 30);
        set("max_qi", 1450);
        set("neili", 3000);
        set("max_neili", 3000);
        set("max_jing", 1300);
        set("combat_exp", 3000000);
        set("score", 10000);
        set_skill("force", 200);
        set_skill("dodge", 200);
        set_skill("unarmed", 180);
        set_skill("parry", 220);
        set_skill("cuff", 200);
        set_skill("strike", 200);
        set_skill("sword", 200);
        set_skill("kurong-changong", 200);
        set_skill("tiannan-step", 220);
        set_skill("jinyu-quan", 220);
        set_skill("wuluo-zhang", 220);
        set_skill("duanjia-sword", 220);
        set_skill("literate", 100);

        map_skill("dodge", "tiannan-step");
        map_skill("cuff", "jinyu-quan");
        map_skill("strike", "wuluo-zhang");
        map_skill("parry", "duanjia-sword");
        map_skill("sword", "duanjia-sword");
        map_skill("staff", "duanjia-sword");
        prepare_skill("cuff", "jinyu-quan");
        prepare_skill("strike", "wuluo-zhang");
        setup();
        carry_object("/clone/misc/cloth")->wear();
        carry_object("/clone/weapon/changjian")->wield();
//      carry_object("/u/blade/kill/xin");
}
void init()
{
        object ob;

        ::init();
   if( this_object()->query("owner_id")== this_player()->query("id")){
        command("say 胆敢行刺本将军,受死吧！\n");
        this_player()->set_temp("killing",1);
                        remove_call_out("do_killing");
                        call_out("do_killing",2,ob);
                        call_out("dest",150,ob);
                }
}

void do_killing(object ob)
{
        if (!ob || environment(ob) != environment())
                return;
        this_object()->kill_ob(ob);
}

void dest()
{
       object me,ob;
       ob = this_player();
       me = this_object();
        if ((int)this_player()->query_temp("killing")){
       message_vision("$N眼见身负重伤,趁你没注意,钻到路边的草丛中,不见了。\n",me);  
                        call_out("failed",2,ob);
                       this_player()->delete_temp("killing");
                }
       ob->set_temp("fail_kill",1);
       destruct(this_object());
}

void failed()
{
       object ob,me;
       ob = this_player();
       me = this_object();
       message_vision("不知道从哪里冒出来了许多侍卫,你见任务失败,保命要紧,跑吧...\n",me);  
       ob->move("/u/blade/kill/jiaow");
}
void die()
{
        object ob,me;
        ob =this_player();
        me =this_object();
        message_vision(HIW"任务完成了，快交到接头的人那里吧,小心啊!\n"NOR,me); 
        ::die();
        ob->set_temp("finish");
        ob->delete_temp("st_kill");
        }        



