// robber.c

#include <ansi.h>
inherit NPC;

void create() {
  object ob;
  set_name("逍遥派叛徒", ({ "xiaoyao pantu" }));
  set("long", "这是一名逍遥派叛徒，样子很神秘。\n");
  set("attitude", "heroism");
  set("str", 20 + random(2));            // 膂力
  set("per", 20 + random(2));            // 容貌
  set("int", 20 + random(2));            // 悟性
  set("con", 20 + random(2));            // 根骨
  set("dex", 20 + random(2));            // 身法
  set("kar", 20 + random(1));            // 福缘
  set("chat_chance_combat", 15);
  set("chat_msg_combat", ({
    BOLD "逍遥派叛徒喝道：逍遥子那老东西，死了也这么麻烦！\n" NOR,
    CYN "逍遥派叛徒喝道：快快放下东西，留你一条生路！\n" NOR,
  }));
  set("neili", 1200 + random(2000));
  set("max_neili", 1200 + random(2000));
  set("jiali", 10);
  set("shen", -5);
  set("no_suck", 1);
  set_temp("apply/attack", 30 + random(10));
  set_temp("apply/defense", 30 + random(10));
  set_temp("apply/damage", 30 + random(10));
  set_temp("apply/armor", 30 + random(10));
  set_temp("apply/dodge", 30 + random(10));
  setup();
  carry_object("/clone/misc/cloth")->wear();
  carry_object("/clone/weapon/gangzhang")->wield();
  add_money("gold", 1 + random(2));
}

void init() {
  object me, ob, obj;
  int n;

  me = this_object();
  ob = this_player();

  ::init();

  if (obj = present("mi xin", ob)) {
    if (obj->query("identifier") == query("target"))
      if (!me->is_killing(ob)) {
        set_leader(ob);
        if (query("speaker"))
          command("say " + ob->name() + "，把秘函留下，放你走路！！！");
        me->kill_ob(ob);
        ob->fight_ob(me);
        set("victim", ob->query("id"));
        set("max_qi", ob->query("max_qi", 1) * 1);
        set("eff_qi", ob->query("max_qi", 1) * 1);
        set("eff_jing", ob->query("max_jing", 1) * 1);
        set("eff_jingli", ob->query("max_jingli", 1) * 1); set("qi", ob->query("max_qi", 1) * 1);
        set("max_jing", ob->query("max_jing", 1) * 1);
        set("jing", ob->query("jing", 1) * 1);
        set("max_jingli", ob->query("max_jingli", 1) * 1);
        set("jingli", ob->query("jingli", 1) * 1);
        n = ob->query("combat_exp") + 20000 - random(10000);
        if (n <= 0) n = random(3000) + 1;
        set("combat_exp", n);
        n = ob->query_skill("force", 1) + random(15) - 7;
        if (n <= 0) n = random(3) + 1;
        set_skill("force", n);
        n = ob->query_skill("force", 1) + random(15) - 7;
        if (n <= 0) n = random(3) + 1;
        set_skill("claw", n);
        n = ob->query_skill("force", 1) + random(15) - 7;
        if (n <= 0) n = random(3) + 1;
        set_skill("staff", n);
        n = ob->query_skill("parry", 1) + random(15) - 1;
        if (n <= 0) n = random(3) + 1;
        set_skill("parry", n);
        n = ob->query_skill("dodge", 1) + random(15) - 5;
        if (n <= 0) n = random(3) + 1;
        set_skill("dodge", n);
        n = ob->query_skill(ob->query_skill_mapped("force"), 1) + random(15) - 5;
        if (n <= 0) n = random(3) + 1;
        set_skill("huagong-dafa", n);
        n = ob->query_skill(ob->query_skill_mapped("force"), 1) + random(15) - 5;
        if (n <= 0) n = random(3) + 1;
        set_skill("tianshan-zhang", n);
        n = ob->query_skill(ob->query_skill_mapped("dodge"), 1) + random(15) - 3;
        if (n <= 0) n = random(2) + 1;
        set_skill("zhaixinggong", n);
        n = ob->query_skill(ob->query_skill_mapped("dodge"), 1) + random(15) - 5;
        if (n <= 0) n = random(2) + 1;
        set_skill("sanyin-zhua", n);
        map_skill("dodge", "zhaixinggong");
        map_skill("force", "huagong-dafa");
        map_skill("staff", "tianshan-zhang");
        map_skill("parry", "sanyin-zhua");
        map_skill("claw", "sanyin-zhua");

      }
  }
  remove_call_out("check_out");
  call_out("check_out", 1);
}

void check_out() {
  int i, present;
  object me, *ob, obj;

  me = this_object();
  ob = all_inventory(environment());
  for (i = 0; i < sizeof(ob); i++) {
    if (obj = present("mi xin", ob[i])) {
      if (obj->query("identifier") == query("target")) {
        if (!me->is_killing(ob[i]->query("id"))) {
          set_leader(ob[i]);
          if (query("speaker"))
            command("say " + ob[i]->name() + "，把秘函留下，放你走路！！\n");
          me->kill_ob(ob[i]);
          ob[i]->fight_ob(me);
          set("victim", ob[i]->query("id"));
        }
        present = 1;
        break;
      }
    }
    present = 0;
  }

  if (present) {
    remove_call_out("check_out");
    call_out("check_out", 1);
  } else {
    for (i = 0; i < sizeof(ob); i++)
      if (me->is_killing(ob[i]->query("id")))
        remove_killer(ob[i]);
    remove_call_out("leave");
    call_out("leave", 1);
  }
}

void leave() {
  object ob;

  if (!environment()) return;

  if (query("speaker"))
    if (objectp(ob = present(query("victim"), environment()))) {
      message("vision", "\n", environment(), this_object());
      message("vision", HIY + name() + "哼了一声。\n" NOR, environment(), this_object());
      message(
        "vision",
        HIY + name() + "说道：“" + ob->name() + "，算你识相！逍遥武功也不过如此！”\n" NOR,
        environment(),
        this_object()
      );
      message("vision", GRN + name() + "迅速的撤走了。\n" NOR, environment(), this_object());
    } else {
      message("vision", "\n", environment(), this_object());
      message("vision", HIB + name() + "喊道：“太厉害了！我们先撤”\n" NOR, environment(), this_object());
      message("vision", HIB + name() + "一哄而散。\n" NOR, environment(), this_object());
    }
  destruct(this_object());
}
