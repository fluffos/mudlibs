// zhangd.c
// by blade
inherit ITEM;
#include <ansi.h>

void create() {
  set_name(HIW "帐单" NOR, ({ "zhangdan" }));
  set_weight(100);
  set("value", 0);
  set("no_drop", 1);
  set("no_give", 1);
  set("unit", "张");
  set("long",
    "这是一张帐单,好象是用来收帐用的.\n"); set("material", "paper");
}


void init() {
  add_action("do_cuizhang", "cuizhang");
  call_out("dest", 170);
}


int do_cuizhang() {
  object me, qiand;
  int costj, costq;
  me = this_player();
  qiand = new("/u/blade/kill/qiand");

  //        if(me->query_temp("cui_z")) 
  //            return notify_fail("你得先去找人给你任务才可以! \n");
  if (me->query("target") != base_name(environment(me)))
    return notify_fail("你神经病啊，有这个人吗？! \n");
  if (me->query_temp("mark/完成"))
    return notify_fail("钱,你已经收到了,快点回去吧！\n");
  if (me->is_busy()) return notify_fail("你现在正忙着呢！\n");
  if (!(int)me->query_condition("feng_job")
    && (int)me->query_temp("mark/还钱") > 15 + random(10)) {
    me->set_temp("mark/完成", 1);
    message_vision(HIW "看到$N凶神恶刹的样子，他连忙丢给你一个钱袋。\n" NOR, me);
    message_vision(HIW "袋子里就是钱，你快拿回去吧。\n" NOR, me);
    qiand->move(this_player());
    destruct(this_object());
    return 1;
  }
  if (me->is_fighting()) return notify_fail("你正在战斗中呢！\n");
  if ((int)(me->query("qi")) < 40)
    return notify_fail(HIR "你这种忘我的工作态度是好的，但是小命要紧啊，你还是休息一下吧。\n");

  costj = random((int)me->query("per") / 2) + 50;
  costq = random((int)me->query("int") / 2) + 50;

  message_vision(HIW "$N翘着二郎腿说道,喂,老板,该还钱了吧.....\n" NOR, me);
  message_vision(HIC "人家看都不看你一眼， 哼了一声，高高的把头扬起来了，一副不屑一顾的样子...\n" NOR, me);
  me->add_temp("mark/还钱", 1);
  me->start_busy(1);
  me->receive_damage("jing", costj);
  me->receive_damage("qi", costq);
  return 1;

}

void dest() {
  object ob;
  ob = this_object();
  message_vision("你一不小心把帐单弄掉了。\n", ob);
  destruct(this_object());
}
