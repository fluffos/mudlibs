inherit NPC;
#include <ansi.h>
#include "/kungfu/class/emei/nigu.h"
#define ADDRESS "/jobsys/tianhan_job/place.lpc"
#define ZHANG "/jobsys/tianhan_job/questzhang.lpc"
#define SONG "/jobsys/tianhan_job/questsong.lpc"
int ask_me();
string do_fail();

void create() {
  set_name("静虚师太", ({
    "jingxu shitai",
    "jingxu",
    "shitai",
  }));
  set("long",
    "她是一位慈祥的中年师太，在华藏庵修行。\n"
    "她是灭绝师太的八大静字辈弟子之二。\n");

  set("gender", "女性");
  set("attitude", "friendly");
  set("class", "bonze");

  set("age", 35);
  set("shen_type", 1);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 35);
  set("max_qi", 1200);
  set("max_jing", 1200);
  set("neili", 1500);
  set("max_neili", 1500);
  set("jiali", 30);
  set("combat_exp", 500000);
  set("score", 100);

  set_skill("dacheng-fofa", 130);
  set_skill("linji-zhuang", 130);
  set_skill("literate", 130);
  set_skill("huifeng-jian", 130);
  set_skill("sword", 130);
  set_skill("parry", 130);
  set_skill("dodge", 130);
  set_skill("force", 130);
  set_skill("anying-fuxiang", 130);
  set("inquiry", ([
    "剃度": (: ask_for_join :),
    "出家": (: ask_for_join :),
    "job": (: ask_me :),
    "fail": (: do_fail :),
  ]));
  map_skill("force", "linji-zhuang");
  map_skill("sword", "huifeng-jian");
  map_skill("parry", "huifeng-jian");
  map_skill("dodge", "anying-fuxiang");

  create_family("峨嵋派", 4, "弟子");
  setup();
  carry_object("/d/emei/obj/changjian")->wield();
  carry_object("/d/emei/obj/shoes")->wear();
  carry_object("/d/emei/obj/cloth")->wear();

}

int ask_me() {
  mapping place, me_hp, quest;
  object ob, me, officer, killer, xin;
  me = this_player();
  ob = this_object();
  me_hp = me->query_entire_dbase();
  officer = new("/jobsys/tianhan_job/npc");
  officer->set("long", "他是" HIR + me->query("id") + NOR "的行刺目标.\n");
  officer->set("owner_id", me->query("id"));
  xin = new("/jobsys/tianhan_job/xin");
  killer = new("/jobsys/tianhan_job/guarder");
  killer->set("owner_id", me->query("id"));
  killer->set("combat_exp", me_hp["combat_exp"] + 60000);
  if (me_hp["combat_exp"] >= 500000) killer->set("jiali", 80);
  if (me_hp["combat_exp"] >= 700000) killer->set("jiali", 90);
  if (me_hp["combat_exp"] >= 1000000) killer->set("jiali", 100);
  if (me->query("combat_exp") < 500000) {
    command("say 你的功夫太差了,我不放心啊.");
    return 1;
  }
  if (me->query_condition("in_cuizhang")) {
    command("say 先把手上的活做了在说.");
    return 1;
  }
  if (me->query_condition("fjob")) {
    command("say 你不是要了任务了吗?");
    return 1;
  }
  quest = SONG->query_quest();
  place = ADDRESS->query_quest();
  officer->move(place["place"]);
  xin->set("owner_id", me->query("id"));
  xin->move(officer);
  killer->move(place["place"]);
  me->set_temp("st_kill", 1);
  me->set("quest", quest);
  me->apply_condition("fjob", 20);
  me->set("target", quest["target_path"]);
  command("say 朝廷现在昏君当道，眼看蒙古鞑子践踏我们大宋的大好江山，正是我大好热血男儿报国之际!");
  command("say 据本帮探子回报，现有一蒙古将军带贴身侍卫秘密入关,此人身上有密函一封,意图对我大宋不利.");
  command("say 他现在正在" HIY + place["short"] + NOR + CYN "附近,你去把他劫杀与半路之上，好好干吧!" NOR);
  command("say 事成以后把密函务必交于" HIR + quest["name"] + NOR + CYN ",切记切记!" NOR);
  return 1;
}

string do_fail() {
  mapping zhang, quest;
  object me, zhangd;
  me = this_player();
  zhangd = new("/jobsys/tianhan_job/zhangd");
  zhang = ZHANG->query_quest();
  quest = SONG->query_quest();
  if (me->query_condition("fjob")) {
    command("sigh");
    command("say 这点事都办不好,看你还算老实,再给你一个任务,算是补偿." NOR);
    me->set_temp("target_name", zhang["name"]);
    me->set("target", zhang["target_path"]);
    me->delete_temp("fail_kill");
    me->apply_condition("in_cuizhang", 7);
    me->apply_condition("fjob", 0);
    zhangd->move(me);
    return "找" CYN + zhang["target_name"] + NOR "的" CYN + zhang["name"] + NOR ",把他欠我的钱要回来.";
  }
  if (me->query_condition("in_cuizhang")) {
    command("say 不是给过你任务了吗？" NOR);
    return "还不快去。";
  }
  return "我好象没给过你什么任务吧?!";
}

int accept_object(object who, object ob, object me) {
  if (ob->query("id") != "qiandai") {
    command("say 这东西我要来没用。");
    return 0;
  }
  if (!this_player()->query_temp("mark/完成")) {
    command("say 送钱给我？好，真乖。");
    destruct(ob);
    return 0;
  }
  call_out("destroying", 1, ob);
  call_out("ok", 1, who);
  return 1;
}

void ok(object who) {
  int exp, pot;
  if (!who) return;
  command("cry " + who->query("id"));
  command("say 辛苦你了，先下去休息休息吧!");

  exp = random(50) + random((int)who->query("literate") / 2);
  pot = exp * 5 / 2;
  tell_object(who, HIW "你被奖励了：\n" +
    chinese_number(exp) + "点实战经验\n" +
    chinese_number(pot) + "点潜能\n" NOR);
  message("chat", HIM "〖小道消息〗：听说" + who->query("name") + "替人收帐，得了不少好处!\n" NOR, users());
  who->add("combat_exp", exp);
  who->delete_temp("mark");
  who->apply_condition("after_cuizhang", 2);
  who->apply_condition("in_cuizhang", 0);
  who->delete_temp("fail_kill");
  who->delete_temp("st_kill");
}


void destroying(object obj) {
  destruct(obj);
}
