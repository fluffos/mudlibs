#include <ansi.h>
inherit NPC;

void create()
{
        set_name(YEL"顾客"NOR,({"gu ke","ke","gu"}));
        if(clonep()) 
                set_default_object(__FILE__);
                else {
                        set("long","这是一个很普通的顾客。\n");
                          set("gender",random(11)>5?"男性":"女性");
                }
                
                setup();
call_out("away",8,this_object());
        }
void init()
{
add_action("do_wash","wash");
}
int do_wash(string arg)
{
if(!arg || !stringp(arg)) return 0;
if(this_player()->is_busy()) return notify_fail("你现在正忙着呢\n");
message_vision("$N开始给$n擦背。\n",this_player(),this_object());
this_player()->start_busy(random(10)+random(10));
this_player()->add_temp("times",1);
return 1;
}
        
                
                        
                
                
