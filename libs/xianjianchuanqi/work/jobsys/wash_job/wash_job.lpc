//by leonardo

#include <ansi.h>
#include <login.h>

int update_condition(object me, int duration)
{
        
        int pots,exp,times;
        times=me->query_temp("times");
        pots = random(times*10);
        exp = random(times*100);
        
      if (duration < 1) {
                write("你的下班的時間到\n");
                write(HIM"你得到了"+chinese_number(pots)+"點潛能\n"NOR);
                 write(HIM"你得到了"+chinese_number(exp)+"經驗值\n"NOR);
                me->add("potential",pots);
                me->add("combat_exp",exp);
                me->clear_condition("洗澡_job");
                return 1;
        }
        if (!duration) return 0;
       if(random(duration*10)/3 < duration )  
       {
       tell_object(me, HIY "你觉的有些不妙，回頭一看，有一个人向你走了过來。\n你心中暗骂：又一个猪！\n" NOR);
        me->start_busy(1);
       call_out("rascal", 3, me);    
       }
        me->apply_condition("洗澡_job", duration - 1);
        return 1;
}
void rascal(object me)
{
        object obj; 
        obj = new("/jobsys/wash_job/npc/pig");
         obj->set("target", me->query("id"));
        obj->move(environment(me));
        return;
}
string query_type(object me)
{
        return "job";
}

