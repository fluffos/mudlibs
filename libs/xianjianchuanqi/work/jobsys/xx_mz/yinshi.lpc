// yinshi.c
#include <ansi.h>
inherit NPC;
void create()
{
        set_name("隐士", ({"yinshi"}));
        if (random(10) > 7)
                set("gender", "女性");
        else 
                set("gender", "男性");
        set("title","江湖隐士");
        set("age",30+random(40));
        set("attitude", "friendly");
        set("shen_type", 1);
    set("no_quest",1);
        set("str", 20);
        set("int", 20);
        set("con", 20);
        set("dex", 20);
        set("chat_chance", 20);
        set("chat_msg", ({ 
                 (: random_move :) 
         }));
        set("chat_chance_combat",20);
        setup();
        carry_object(__DIR__"obj/pao15")->wear();
}

void die() {
        object now_killer,ob;
        ob=this_object();
        if (!objectp(now_killer=query_temp("last_damage_from")))
        {       ::die();
                return;
        }
        if ( now_killer->query("id") != query("mizhao_killer") )
        {       ::die();
                return;
        }
        now_killer->clear_condition("mizhao_job_time");
        now_killer->set_temp("mizhao_job_over",3);
        if (ob->query("gender")=="女性")
                message_vision(HIR"\n$n对着$N惨然一笑道：士可杀而不可辱！，到了阴间我也不会放你的!\n"NOR,now_killer,ob);
        else
                message_vision(HIR"\n$n对着$N惨然一笑道：士可杀而不可辱！，老子十八年后又是一条好汉!\n"NOR,now_killer,ob);
        ::die();
        return ;
}

void get_weapon() {
        carry_object(BINGQI_D((string)query("my_weapon")))->wield();
}
 
void pfm_select(int i)
{
        switch(i) {
        case 0 :
                set("chat_msg_combat", ({
                        (: perform_action, "strike.xiaohun" :),
                        }) );   
                break;
        case 1 :
                break;
        }
}

