// made by sunyc
#include <ansi.h>
int update_condition(object me, int duration) {
  if (duration < 1) {
    if (!userp(me)) {
      if (living(me)) {
        message_vision("$N回头对身后的帮众说道：“这次可真爽啊，扯乎！”和帮众一起转进人群中不见了。\n", me);
        destruct(me);
      }
    } else
      tell_object(me, HIY "一名丐帮弟子说道:清竹令已被送回！你是怎么搞的！\n" NOR);
    return 0;
  }
  me->apply_condition("gbjob1_time", duration - 1);
  return 1;
}
