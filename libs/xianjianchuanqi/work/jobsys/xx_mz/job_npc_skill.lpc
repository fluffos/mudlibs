void set_npc_skill(object killer,object me,int spot)

{       int lvl,i;
        string *sname,myweapon;
        mapping skl;
        lvl=0;
        skl = killer->query_skills();
        if(sizeof(skl) > 0) {
                sname  = sort_array( keys(skl), (: strcmp :) );
                for(i=0; i<sizeof(skl); i++) 
                if((int)skl[sname[i]] > lvl) lvl=(int)skl[sname[i]];
        }
        if (lvl > (int)killer->query("max_pot") - 100)
                lvl=(int)killer->query("max_pot") - 100;
        lvl = lvl - spot ;
        i=random(14);
        switch(i) {
        case 0 :
                set_base_gm(me,lvl);
                myweapon="changjian";
                break;
        case 1 :
                set_base_gb(me,lvl);
                switch(random(2)) {
                        case 0:
                                myweapon="zhubang";
                                break;                          
                        case 1:
                                myweapon="gangzhang";
                                break;
                        }
                break;
        case 2 :
                set_base_ss(me,lvl);
                myweapon="changjian";
                break;
        case 3 :
                set_base_xx(me,lvl);
                myweapon="gangzhang";
                break;
        case 4 :
                set_base_wd(me,lvl);
                myweapon="changjian";
                break;
        case 5 :
                set_base_mr(me,lvl);
                myweapon="changjian";
                break;
        case 6 :
                set_base_mj(me,lvl);
                switch(random(3)) {
                        case 0:
                                me->map_skill("blade","shenghuo-lingfa");
                                myweapon="tieling";
                                break;                          
                        case 1:
                               myweapon="changjian";
                                break;
                        case 2:
                               myweapon="blade";
                                break;
                }
                break;
        case 7 :
                set_base_thd(me,lvl);
                myweapon="changjian";
                break;
        case 8 :
                set_base_sl(me,lvl);
                switch(random(5)) {
                        case 0:
                               myweapon="gangzhang";
                                break;                          
                        case 1:
                               myweapon="whip";
                                break;
                        case 2:
                               myweapon="mudao";
                                break;
                        case 3:
                               myweapon="tiegun";
                                break;
                        case 4:
                               myweapon="changjian";
                                break;
                }
                break;
        case 9 :
                set_base_em(me,lvl);
                myweapon="changjian";
                break;
        case 10 :
                set_base_tls(me,lvl);
                myweapon="changjian";
                break;
        case 11 :
                set_base_mz(me,lvl);
                switch(random(3)) {
                        case 0:
                               myweapon="gangzhang";
                                break;                          
                        case 1:
                               myweapon="changjian";
                                break;
                        case 2:
                               myweapon="falun";
                                break;
                }
                break;
        default:
                set_base_pxj(me,lvl);
                myweapon="changjian";
                break;
        }
        me->set("pfm_select",i);
 me->set_temp("apply/armor",lvl/2);
        me->set("my_weapon",myweapon);
        me->get_weapon();
}
