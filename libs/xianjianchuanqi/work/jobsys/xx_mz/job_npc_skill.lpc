void set_npc_basedata(object killer,object me,int spot,int r_jiali,int rate)
{
        int me_exp ,me_qi,me_jing,me_jingli,me_neili,me_jiali,me_lvl;
        me_exp=(int)killer->query("combat_exp");
        me_qi=(int)killer->query("max_qi",1)*(100+random(rate))/100;
        me_jing=(int)killer->query("max_jing",1);
        me_jingli=(int)killer->query("eff_jingli",1);
        me_neili=(int)killer->query("max_neili",1)*(100+random(rate))/100;
        me_lvl=(int)killer->query("max_pot") - 100;
        me_lvl = me_lvl - spot;
        me_jiali=random(r_jiali);

        me->set("max_qi", me_qi);
        me->set("eff_qi", me_qi);
        me->set("qi", me_qi);

        me->set("max_jing", me_jing);
        me->set("eff_jing", me_jing);
        me->set("jing", me_jing);
        me->set("max_neili", me_neili);
        me->set("neili", me_neili);
        me->set("jiali", me_jiali);

        me->set("eff_jingli", me_jingli);
        me->set("jingli", me_jingli);

        me->set("combat_exp", me_exp);
        me->set("shen", me_exp/100);

        me->set_skill("literate", me_lvl);
        me->set_skill("force", me_lvl);
        me->set_skill("dodge", me_lvl);
        me->set_skill("parry", me_lvl);
}

void set_base_gm(object me,int lvl)
{
        me->set_skill("yunu-xinjing", lvl);
        me->set_skill("yunu-shenfa", lvl);
        me->map_skill("force","yunu-xinjing");
        me->map_skill("dodge","yunu-shenfa");
        me->set_skill("strike",lvl);
        me->set_skill("tianluo-diwang",lvl);
        me->set_skill("cuff",lvl);
        me->set_skill("meinu-quanfa",lvl);
        me->map_skill("cuff","meinu-quanfa");
        me->set_skill("sword",lvl);
        me->set_skill("yunu-jianfa",lvl);
        me->set_skill("xuantie-jianfa",lvl);
        me->map_skill("strike","tianluo-diwang");
        me->map_skill("parry","meinu-quanfa");
        me->map_skill("sword","yunu-jianfa");
        me->prepare_skill("cuff","meinu-quan");
        me->prepare_skill("strike","tianluo-diwang");
}

