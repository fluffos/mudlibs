//密诏
#include <ansi.h>
inherit ITEM;
void create() {
        set_name(HIR"密诏"NOR, ({"mi zhao"}) );
        set_weight(1000);
        if( clonep() )  
                set_default_object(__FILE__);
        else {
                set("no_get",1);
                set("no_put",1);
                set("no_steal",1);
                set("no_give",1);
                set("no_drop",1);
                set("no_sell",1);
                set("unit","封");
                set("material","paper");
                set("long","这是西夏国一品堂的一封密诏。你可以用[ kan ]来阅读\n");
                }
        setup();
}

void init() {
        add_action("do_kan","kan");
           add_action("do_kan","chakan");
        add_action("do_fei","fei");
        add_action("do_hui","hui");
}
int do_kan(string arg)
{
        object me;
        string name,place;
        me = this_player();
        if (!arg || arg != "mi zhao")
                return notify_fail("你要看什么？\n");
        name=query_temp("mizhao_npc_name");
        place=query_temp("mizhao_job_where");
        tell_object(me,HIW"据查：\n" +  "     " + name + HIW"欲谋对我西夏不利，此人现隐居在" + place + HIW"一带\n速去废了此人武功，以敬效尤！"HIR"如有违抗，杀无赦！\n"NOR);
        return 1;
        }
int do_fei(string arg)
{
        object me , ob ,killer;
        me = this_player();
        if( !arg || !objectp( ob = present(arg, environment(me)) ) )
                return notify_fail("你要做什么？\n");
        if ( (int)me->query_temp("mizhao_ask_had")!=1 && me->is_fighting())
                return notify_fail("你现在正忙着了！\n");
        if (ob->query("mizhao_killer")!=me->query("id"))
                return notify_fail("你要做什么？\n");
        killer=ob->query_temp("last_damage_from");
        if( !living(ob) && (!objectp(killer) || killer->query("id")!=me->query("id")) )
                return notify_fail("对方都成这样了，你还下得了手么？\n"); 
        if ( (int)me->query_temp("mizhao_ask_had")!=1 && living(ob))
        {       message_vision(WHT"\n$N凝视着$n冷冷地说道：奉西夏国一品堂密令，前来废你武功!\n"NOR,me,ob);
                message_vision(HIR"\n$N对着$n磔然一笑道：是你自己来，还是要我动手？\n"NOR,me,ob);
                me->set_temp("mizhao_ask_had",1);
                if (random(10)> 4)
                { message_vision(HIY"\n$n仰天长笑道：“好狂妄的家伙，就让我来看看你有什么能耐吧！”\n"NOR,me,ob);
                        ob->fight_ob(me);}
                else message_vision("\n$n重重的哼了一声，冷笑道：那就要看看你的本事了！\n"NOR,me,ob);
                return 1;
        }
        if ( (int)me->query("neili")< 50 ) {
                write(HIG"你内力不够了，怎么废别人的武功？\n");
                return 1;}

        if (random(10) > 5 )
                message_vision(WHT"\n$N大喝一声，揉身而上，双手急拍$n全身七处大穴，!\n"NOR,me,ob);
        else
                message_vision(WHT"\n$N大喝一声，揉身而上，双手直扣$n的琵琶骨!\n"NOR,me,ob);

        if ( ( (int)ob->query("neili") < (int)ob->query("max_neili")/20 && (int)ob->query("qi") < (int)ob->query("max_qi")/6 ) || !living(ob) )
        {
                message_vision(HIR"\n只听得“咯咯”数声，$n全身筋脉尽断，身子软绵绵的歪倒在地上!\n"NOR,me,ob);
                message_vision(HIR"\n$n哇的一声吐出一大口鲜血，挣扎着起身恨恨的说道：\n“想不到今天竟然会栽在你的手里 ，君子报仇，十年不晚，咱们后会有期!”\n"NOR,me,ob);
                destruct(ob);
                me->clear_condition("mizhao_job_time");
                me->set_temp("mizhao_job_over",4);
                return 1;
        }
        if (random(10) > 3 )
        {       message_vision(HIR"\n$n一个后翻，躲过了$N的攻势，大怒道：“好狠毒的家伙，看来今天定要拼个鱼死网破了”!\n"NOR,me,ob);
                ob->kill_ob(me);}
        else 
                message_vision(HIR"\n$n冷笑一声，双手一拂，将$N的攻势化解!\n"NOR,me,ob);
        if(!ob->is_fighting(me))
          {     message_vision(HIR"\n$n对着$N大叫一声：“恶贼看招”!\n"NOR,me,ob);
                ob->fight_ob(me);}
        me->add("neili",-50);
        return 1;
}

int do_hui(string arg)
{
        object me;
    int pot ,exp , over_lvl ,extra ;
        string msg;
        me = this_player();
        if (!arg || arg != "mi zhao")
                return notify_fail("你要毁什么？\n");
        if ( (int)me->query_condition("mizhao_job_time") >0 )
                return notify_fail("你现在还不能销毁密诏!\n");
        msg=CYN"$N阴笑着从怀里掏出一封" + HIR"密诏"NOR + CYN"，看也不看，随手扔在了地上。\n"NOR;
        over_lvl=(int)me->query_temp("mizhao_job_over");
if( (int)me->query("max_pot") > 300 )
      extra = 0;
else
     extra = (int)me->query("max_pot")/6;
        if( over_lvl > 1 )
        {       me->add("mizhao_job_count",1);
      exp=60*over_lvl + random(120) + extra;
      pot=40*over_lvl + random(60) + extra;
                me->add("combat_exp",exp);
                me->add("potential",pot);
    me->add("now_valid_count",2);
                me->delete_temp("mizhao_job_over");
                msg=WHT"$N一声冷笑，两手一搓，手中的"+ HIR"密诏"NOR + WHT"竟化为片片雪花随风飘散!\n"NOR;
        }
        message_vision(msg,me);
        me->delete_temp("mizhao_ask_had");
        if( over_lvl > 1 )
                tell_object(me, HIY"你被奖励了"+ chinese_number(exp) +"点经验和"+ chinese_number(pot)+"点潜能！\n"NOR);
    destruct(this_object());
        return 1;
}
