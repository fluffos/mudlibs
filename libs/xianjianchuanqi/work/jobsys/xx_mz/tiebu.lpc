// tiebu.c
#include <ansi.h>
inherit NPC;
void try_jina();
void create() {
  set_name("我是谁", ({ "wahaha" }));
  set("gender", "男性");
  set("title", WHT "六扇门铁捕" NOR);
  set("age", 30 + random(20));
  set("attitude", "friendly");
  set("shen_type", 1);
  set("no_quest", 1);
  set("str", 20);
  set("int", 20);
  set("con", 20);
  set("dex", 20);
  set("chat_chance", 20);
  set("chat_msg", ({ (: try_jina() :) }));
  set("chat_chance_combat", 20);
  setup();
  carry_object(__DIR__ "obj/pao15")->wear();
}
void init() {
  object target = this_player();
  object me = this_object();
  if (me->query("jina_target") == target->query("id") && me->query("first_ok") == 1) {
    me->kill_ob(target);
    target->kill_ob(me);
  }
}

void die() {
  object now_killer, ob;
  ob = this_object();
  if (!objectp(now_killer = query_temp("last_damage_from"))) {
    ::die();
    return;
  }
  if (now_killer->query("id") != query("jina_target")) {
    ::die();
    return;
  }
  command("sigh");
  message_vision(WHT "\n$N惨然笑道：今天不能缉拿你归案，只怪我学艺不精!\n\n" NOR, ob);
  ::die();
  return;
}

void get_weapon() {
  carry_object(BINGQI_D((string)query("my_weapon")))->wield();
}

void pfm_select(int i) {
  switch (i) {
    case 0:
      set("chat_msg_combat", ({
        (: perform_action, "strike.xiaohun" :),
      }));
      break;
    case 1:
      break;
  }
}

void try_jina() {
  command("jina " + query("jina_target"));
}
