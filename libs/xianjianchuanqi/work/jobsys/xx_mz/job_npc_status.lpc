void set_npc_name(object me) {
  string s_name, s_id, f_id, l_id;
  int i;
  i = random(sizeof(npc_name1));
  s_name = npc_name1[i]["name"];
  f_id = npc_name1[i]["id"];
  i = random(sizeof(npc_name2));
  s_name = s_name + npc_name2[i]["name"];
  l_id = npc_name2[i]["id"];
  i = random(sizeof(npc_name2));
  s_name = s_name + npc_name2[i]["name"];
  l_id = l_id + npc_name2[i]["id"];
  s_id = f_id + " " + l_id;
  me->set_name(s_name, ({ s_id, f_id, l_id }));
}
