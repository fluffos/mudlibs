// shiwei.c 带刀侍卫

inherit NPC;
//inherit F_SKILL;

void create()
{
        object me=this_player();
        set_name(me->name(1)+"的侍卫", ({ "shi wei", "shi", "wei" }));
        set("gender", "男性");
        set("age", random(20) + 30);
        set("str", 25);
        set("dex", 16);
        set("long", "他手握钢刀，目视前方，真是威风凛凛。\n");
        set("combat_exp", me->query("combat_exp", 1)/5);
        set("shen_type", 1);
        set("attitude", "peaceful");
        set("owner","shi wei");

        set_skill("cuff", me->query_skill("force", 1)/2);
        set_skill("force", me->query_skill("force", 1)/2);
        set_skill("blade", me->query_skill("force", 1)/2);
        set_skill("dodge", me->query_skill("force", 1)/2);
        set_skill("parry", me->query_skill("force", 1)/2);
        set_skill("xuanxu-daofa", me->query_skill("force", 1)/2);
        set_skill("yinyun-ziqi", me->query_skill("force", 1)/2);
        set_skill("tiyunzong", me->query_skill("force", 1)/2);
        set_skill("wudang-quan", me->query_skill("force", 1)/2);

        map_skill("force", "yinyun-ziqi");
        map_skill("cuff", "wudang-quan");
        map_skill("dodge", "tiyunzong");
        map_skill("parry", "xuanxu-daofa");
        map_skill("blade", "xuanxu-daofa");


        set("neili", me->query("max_neili", 1)/2); 
        set("max_neili", me->query("max_neili", 1)/2);
        set("qi", me->query("max_qi", 1)/2);
        set("max_qi", me->query("max_qi", 1)/2);
        set("jiali", 10);
        setup();
        carry_object("/d/city/obj/gangdao")->wield();
        carry_object("/d/city/obj/pixue")->wear();
        carry_object("/d/city/obj/tiejia")->wear();
}
void init()
{
        remove_call_out("destroy");
        call_out("destroy",20);
}

void destroy()
{
        object ob = this_object();
        if ( !objectp(present( ob->query("owner"),environment(ob) )) )
        if (!ob->is_fighting()) {
                message_vision("侍卫急急忙忙的走了。\n",this_object());
                destruct(ob);
        }
}

