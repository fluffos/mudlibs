//mudgod@xssx

#include <ansi.h>
inherit ITEM;
object *bing = ({ 0, 0, 0, 0, 0, 0, 0, 0, 0 });
int mark = 0;

void create() {
  set_name(WHT "腰牌" NOR, ({ "yao pai", "pai", }));
  set("weight", 100);
  if (clonep()) set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", WHT "

     *~*~*~*~*~*~*~*~*~*~*~*~*
     *                       *
     *           皇          *
     *      " HIR "大        内 " HIW "    *
     *                       *
     *                       *
     *                       *
     *   各地官员，便宜行事  *
     *                       *
     *                       *
     *                       *
     *                 " HIG "御赐" HIW "  *
     *                       *
     *                       *
     *~*~*~*~*~*~*~*~*~*~*~*~*

                
这个是为官的腰牌，可以(show)给别人看。\n" NOR);
    set("value", 0);
    set("no_get", 1);
    set("no_put", 1);
    set("no_give", 1);
    set("no_drop", 1);
  }
  setup();
}

void init() {
  add_action("do_show", ({ "show" }));
  add_action("do_order", ({ "huwei" }));
  add_action("do_kill", ({ "gongji" }));
}

int do_show(string arg) {
  object ob, me = this_player();
  if (!arg)
    message_vision(
      YEL "\n$N高举一块" HIR + me->query("guanwei") + NOR YEL "的腰牌大喝道：本大人在此公干，闲杂人等速速离去！\n\n" NOR,
      me
    );
  else if (!objectp(ob = present(arg, environment(me)))) tell_object(me, "这里没有这个人！\n");
  else {
    message_vision(
      YEL "\n$N高举一块" HIR + me->query("guanwei") + NOR YEL "的腰牌对$n道：本大人在此，还不过来参见！\n\n" NOR,
      me,
      ob
    );
    if (me->query("guanwei/lvl") < ob->query("guanwei/lvl"))
      message_vision(YEL "$N看也不看$n一眼，说道：我还以为是什么达官显贵出来了，结果不过是个小小的" HIR + me->query("guanwei") + "！\n"
        NOR YEL "本官乃" HIR + ob->query("guanwei") + NOR YEL "，尔等还不让到一边？？\n\n" NOR, ob, me);
    if (me->query("guanwei/lvl") > ob->query("guanwei/lvl") && ob->query("guanwei"))
      message_vision(
        YEL "$N马上单膝着地向$n请安道：卑职" HIR + ob->query("guanwei") + NOR YEL + ob->name(1) + "参见大人！\n\n" NOR,
        ob,
        me
      );
    if (!ob->query("guanwei") && !ob->query("guanwei/lvl"))
      message_vision(YEL "$N马上双膝跪地向$n请安道：草民" + ob->name(1) + "参见大人！\n\n" NOR, ob, me);
  }
  return 1;
}

int do_order() {
  object me = this_player();
  int i, lvl;
  i = me->query("guanwei/lvl");
  lvl = me->query("guanwei/lvl");
  if (!lvl) return notify_fail("你还没有品级，没有侍卫保护你！\n");

  message_vision(YEL "$N高举一块腰牌大喝道：护卫亲兵听令！\n" NOR, me);
  if (!mark) {
    for (i = 0; i < lvl; i++) {
      bing[i] = new("/u/jrx/npc/shiwei");
      bing[i]->move(environment(me));
      bing[i]->set_leader(me);
      bing[i]->set("owner", me->query("id"));
      message_vision(CYN "侍卫大声应道：卑职在！\n" NOR, me);
    }
    mark = 1;
  }
  return 1;
}

int do_kill(string arg) {
  object ob, me = this_player();
  int i, lvl = me->query("guanwei/lvl");

  if (environment(me)->query("no_fight") || environment(me)->query("no_fight_g"))
    return notify_fail("这里不能动武？\n");
  if (!arg) return notify_fail("你要杀谁？\n");
  else if (!objectp(ob = present(arg, environment(me)))) tell_object(me, "这里没有这个人！\n");
  else {
    message_vision(
      YEL "$N高举一块" HIR + me->query("guanwei") + NOR YEL "的腰牌对$n大喝道：护卫亲兵听令，格杀勿论！\n",
      me,
      ob
    );
    if (lvl < ob->query("guanwei/lvl"))
      message_vision(YEL "$N狠狠瞪$n一眼，说道：你一个小小的" HIR + me->query("guanwei") + "敢对本官无礼！\n"
        NOR YEL "本官乃" HIR + ob->query("guanwei") + NOR YEL "，尔等还不上前认罪？？\n", ob, me);
    else for (i = 0; i < lvl; i++) if (objectp(bing[i]) && !userp(ob)) bing[i]->kill_ob(ob);
  }
  return 1;
}
int query_autoload() { return 1; }
