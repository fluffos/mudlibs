// huxin.c                                                                           

#include <ansi.h>
#include <armor.h>

inherit WRISTS;

void create()
{
	set_name( HIW"银锁护心" NOR, ({ "yinsuo huxin", "huxin" }) );
	set_weight(300);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "双");
                set("long", "这是一件银锁制的护心，用以保护心部。\n");
		set("value", 6000);
		set("material", "wrists");
		set("armor_prop/armor", 5);
	}
	setup();
}
