// yuebing 月饼


inherit ITEM;
#include <ansi.h>
void create()
{
        set_name(HIG"经验丹"NOR, ({"jingyan dan", "dan"}));
        set_weight(50);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "这是一颗由很神奇的丹药。\n");
                set("unit", "颗");
                set("no_get", 1);
                set("no_give", 1);
                set("no_drop", 1);
           
        }
}
void init()
{
add_action("do_open","open");
}
int do_open()
{
object me;
me = this_player();
message_vision(HIG"$N吃下一颗经验丹觉得五脏六腑都在翻腾。\n",me);
me -> add("combat_exp",5000);
tell_object(me,"你突然觉得你的实战经验增加了。\n");
destruct(this_object());
return 1;
}
