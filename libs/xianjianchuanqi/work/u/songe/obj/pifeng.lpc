// huyao.c

#include <ansi.h>
#include <armor.h>

inherit SURCOAT;

void create()
{
	set_name( HIR"披风" NOR, ({ "pifeng", "pi feng" }) );
	set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
                set("long", "这是一件披风，好象使用很珍惜的东西缝制的。\n");
		set("value", 6000);
		set("material", "waist");
		set("armor_prop/armor", 5);
	}
	setup();
}
