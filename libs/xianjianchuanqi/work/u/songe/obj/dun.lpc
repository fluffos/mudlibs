// huyao.c

#include <ansi.h>
#include <armor.h>

inherit SHIELD;

void create()
{
	set_name( "盾", ({ "dun pai", "dun" }) );
	set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "条");
                set("long", "这是一盾，用来抵挡敌人的攻击。\n");
		set("value", 6000);
		set("material", "waist");
		set("armor_prop/armor", 5);
	}
	setup();
}
