// LLY@FYSY
inherit NPC;
void create() {
  string *order = ({ "少年", "青年", "中年", "壮年" });
  set_name((order[random(4)]) + "庄丁", ({ "guards" }));
  set("gender", "男性");
  set("title", "神剑山庄");
  set("age", 22 + random(10));
  set("long", "这是神剑山庄的一个庄丁。\n");
  set("combat_exp", 300000 + random(300000));
  set("attitude", "friendly");
  set_skill("unarmed", 50);
  set_skill("shadowsteps", random(50) + 50);
  set_skill("dodge", random(50) + 50);
  set_skill("softsword", random(50) + 50);
  set_skill("parry", random(50) + 50);
  set_skill("sword", random(50) + 50);
  map_skill("dodge", "shadowsteps");
  map_skill("sword", "softsword");
  map_skill("parry", "softsword");
  set("force", 500);
  set("force_factor", random(10) + 20);
  set("max_force", 100);
  set("chat_chance", 4);
  set("chat_msg", ({
    "庄丁对着你友善的笑了笑！\n",
    (: random_move :),
  }));

  setup();
  carry_object(__DIR__ "obj/sword")->wield();
  carry_object(__DIR__ "obj/zcloth")->wear();

}
