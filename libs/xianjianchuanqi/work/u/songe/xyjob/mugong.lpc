// smith.c
#include <ansi.h>;

inherit NPC;
inherit F_DEALER;

string ask_me();
int do_ju(string arg); 
int do_sao(string arg); 
void reward(object me); 

void create()
{
                     set_name(HIY"木工师"NOR, ({ "mu jiang", "jiang" }));
                       set("title", "逍遥派木器管理");
                       set("shen_type", 1);

                       set("gender", "男性" );
                       set("age", 33);
                       set("long", "他手里面拿个一个锯子正在做一些木工制品。\n");

                       set("combat_exp", 2000000);
                       set("attitude", "friendly");
                       set("vendor_goods",({
                                   "/clone/weapon/sword",
                       }));

                       set("inquiry", ([ 
                       "job" : (: ask_me :), 
                       ]));
                       
                       setup();
                                              
                       carry_object("/clone/misc/cloth")->wear();
}

void init()
{
        add_action("do_ju", "ju");
        add_action("do_sao", "sao");
}
string ask_me()
{
  object me = this_player(); 
  mapping fam; 
        if (!(fam = this_player()->query("family")) || fam["family_name"] != "逍遥派")
        return RANK_D->query_respect(this_player())+"你不是逍遥派的人，来这里做什么？  ";

if (me->query("combat_exp") > 500000) 
return "让您老干这个未免屈尊了吧？"; 

if (me->query("qi") < 40) 
return "你还是歇会儿吧！要是出了人命我可承担不起。"; 

if (me->query_temp("sao-muxie")) 
return "叫你扫木屑你怎么还在这里发呆？"; 

if (me->query_temp("ju-mutou")) 
return "叫你锯的木头还没有好吗？？"; 


switch(random(2))
{ 
case 0: 
me->set_temp("sao-muxie", 1); 
return "这样吧，你帮我打一下扫(sao)一下这里的木屑！"; 

case 1:
me->set_temp("ju-mutou", 1); 
return "去帮我把这快木头锯(ju)成两节。"; 
} 
}

int do_sao(string arg) 
{ 
object me = this_player(); 

if (me->is_busy()) 
return notify_fail("你现在正忙。\n"); 

if (! me->query_temp("sao-muxie")) 
{ 
message_vision("$n从一个角落里刚刚拿起扫帚要扫去地上的木屑。" 
"就听见$N对$n大喝道：滚开，乱搞什么。\n", 
this_object(), me); 
return 1; 
} 

message_vision("$N给你一把扫帚，你开始扫了起来过了一会儿，$N看了点了点头。\n", 
this_object(), me); 
reward(me); 
return 1; 
} 

int do_ju(string arg) 
{ 
object me = this_player(); 

if (me->is_busy()) 
return notify_fail("你现在正忙。\n"); 

if (! me->query_temp("ju-mutou")) 
{ 
message_vision("$n拿起几块锯子，好象沉甸甸的。" 
"就听见$N对$n大喝道：放下，乱搞什么。\n", 
this_object(), me); 
return 1; 
} 

message_vision("$n拿起木匠给你的木头，小心翼翼的锯起来" 
"$N“嗯”了一声，看上去有些满意，你也觉得累了半天也应该歇一下了。\n", 
this_object(), me); 
reward(me); 
return 1; 
} 

void reward(object me)
{ 
object silver; 

me->delete_temp("sao-muxie"); 
me->delete_temp("ju-mutou"); 

silver = new("/clone/money/silver"); 
silver->set_amount(10 + random(5)); 
silver->move(this_player()); 
message_vision("$N对$n道：这是给你的工钱。\n", 
this_object(), me); 
if (me->query("combat_exp") < 400000) 
{
me->add("potential", 20 + random(20)); 

me->add("combat_exp", 20 + random(20)); 
} 
me->receive_damage("qi", 80); 
me->start_busy(15); 
} 

