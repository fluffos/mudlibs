// 还魂丹 恢复死亡一次专用，不得随意复制
// By adx @ CuteRabbit 13:08 99-3-25

inherit ITEM;

void init() {
  add_action("do_eat", "eat");
}
void create() {
  set_name("还魂丹", ({ "huanhun dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "这是一颗『还魂丹』。据说有起死回生的功效\n");
    set("no_pawn", 1);
    set("nopawn", 1);
    set("value", 0);
  }
  setup();
}
int do_eat(string arg) {
  object obj = this_player();
  int shen, exp, pot, i;
  mapping skl;
  string *sname, skills;

  if (!id(arg)) return notify_fail("你要吃什么？\n");
  else {

    exp = ((obj->query("combat_exp") * 21) / 1000);
    shen = ((obj->query("shen") * 112) / 1000);
    pot = obj->query("potential");
    skl = obj->query_skills();
    skills = skl[sname[i]];

    obj->set("eff_jing", obj->query("max_jing"));
    obj->set("jing", obj->query("max_jing"));
    obj->set("eff_qi", obj->query("max_qi"));
    obj->set("qi", obj->query("max_qi"));
    obj->set("neili", obj->query("max_neili"));

    obj->add("shen", shen);
    obj->add("combat_exp", exp);
    obj->add("potential", pot);

    obj->add_skills("%s", 1);

    tell_object(obj, "你吃下一颗还魂丹，连放几个响屁...，感觉大好！\n");
    destruct(this_object());
  }
  return 1;
}
