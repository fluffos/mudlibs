#include <ansi.h>
#include <mudlib.h>

#define BOARD_CAPACITY 1024

inherit F_CLEAN_UP;
inherit F_DBASE;
inherit F_SAVE;


string gateway(string arg) {
            string str,strhelp;
            str="<html><head>";
            str+="<meta http-equiv='Content-Type' content='text/html; charset=gb2312'>";
            str+="<title>新鹿鼎记在线帮助系统</title></head>";
            str+="<body><table align=center bgcolor=#fed8ad><td><p>";
            strhelp=read_file("/doc/help/"+arg);
                strhelp = replace_string(strhelp,"\n","<br>\n");
            str+=strhelp;
            str+="</p></td></table></body></html>";
	return str;
}

