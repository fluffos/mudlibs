 
#include <ansi.h>
inherit ROOM;

void create()
{
set("short", HIW "山猫会客室" NOR);
set("long", @LONG
        你走进一个很大的房间，这里是山猫的客厅，山猫都在这里接待
客人，客厅放着两排椅子（chair），中央放着一张桌子（desk），楼上是
山猫的工作室，这里放着一本很厚的留言簿。
LONG    );
        set("exits", ([
                "down" : "/d/taohua/zhangqian",
                "up" : __DIR__"workroom",
        ]));
        set("item_desc", ([
                "desk" : "一张典雅的酸枝木桌子，上面放着一套功夫茶具。\n",
                "chair" : "一只酸枝木的太师椅，坐在上面有点冰凉，很舒服。\n",
        ]));
        set("valid_startroom", 1);
        set("no_steal", 1);
        set("no_fight", 1);
        set("no_sleep", 1);

        setup();
        call_other("/u/adx/adx_b", "???");
}
int valid_leave(object me, string dir)
{
        if( dir=="up" && !wizardp(me) )
                return notify_fail("那里只有巫师才能进去。\n");
        return ::valid_leave(me, dir);
}

