#include <ansi.h>
inherit NPC;
string ask_newbie();
string ask_fanhui();
int do_want(string arg);
void create()
{
	set_name("礼物使者", ({ "shizhe" }));
	set("long", "礼物使者微笑的望着你   \n");
	set("gender", "男性");
	set("age", 70);
         set("per", 24);
	setup();
	set("inquiry", ([
		"newbie" : (: ask_newbie :),
                         "反悔" : (: ask_fanhui :),
	]) );
}
void init()
{
object ob=this_object();
add_action("do_want","want");
::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}
void greeting(object ob)
{
	if (!ob || !present(ob, environment())) return;
            write(HBRED"请ask shizhe about newbie 来的到奖励!\n"NOR);
            write(HBRED"如果你后悔了的话，也可以ask shizhe about 反悔，来重新要取礼物!\n"NOR);
}

string ask_newbie()
{ 
                        mapping skill;
		string *skl;
                int i;
    object me = this_object();
	object ob = this_player();
	if (ob->query("shizhe_newbie")) return "你不是领过了嘛！？\n";
              write ("请输入 want 来要技能。\n");
               write ("你获得了20k经验,500 点内力,500 点精力and 5000 点潜能!\n");
ob->set_skill("dodge",1);
           skill = ob->query_skills();
		skl = keys(skill);
		i = sizeof(skl);
		while (i--) {
                        ob->delete_skill(skl[i]);              
        	}
              message_vision(HBRED"$N废去了$n的所有武功！\n"NOR,me,ob);
              this_player()->set_skill("dodge",30);
      this_player()->set_skill("force",30);
      this_player()->set_skill("parry",30);
      this_player()->set_skill("literate",30);
ob->set("neili",300);
  ob->set("max_neili",300);
 ob->set("eff_neili",300);
 ob->set("jingli",300);
ob->set("max_jingli",300);
ob->set("eff_jingli",300);
 ob->set("qi",500);
ob->set("max_qi",500);
   ob->set("potential",5000);
 ob->set("eff_qi",500);
 ob->set("jing",500);
ob->set("max_jing",500);
          ob->set("eff_jing",500);
   ob->set("combat_exp",20000);
 ob->set_skill("medicine",30);
      ob->set("shizhe_newbie",1);
      ob->delete("enter_wuguan");
      return "为鼓励newbie特此奖励!请用want来要技能。\n"; 
        
}
string ask_fanhui()
{
              mapping skill;
             	string *skl;
                int i;
                object me = this_object();
	       object ob = this_player();
           skill = ob->query_skills();
		skl = keys(skill);
		i = sizeof(skl);
		while (i--) {
                        ob->delete_skill(skl[i]);              
        	}
              message_vision(HBRED"$N废去了$n的所有武功！\n"NOR,me,ob);
                        ob->delete("shizhe_newbie");
                        ob->delete("shizhe_want");
                         return "请重新ask shizhe about newbie一次。\n";
}
int do_want(string arg)
{
object me=this_player();
if(me->query("shizhe_want"))  return 0;
if (!arg || (arg!="kunlun" && arg!="tiandi" && arg!="hh" && arg!="shenlong" && arg!="lingjiu" && arg!="xiaoyao" && arg!="baituo" && arg!="mr" && arg!="emei" && arg!="mingjiao" && arg!="xx" && arg!="gaibang" && arg!="wudang" && arg!="tiezhang" && arg!="taohua" && arg!="huashan" && arg!="songshan" && arg!="shaolin" && arg!="mizong" && arg!="wudu" && arg!="gumu" && arg!="tls")) 
{
write("请输入门派名来要技能。\n");
write("wudu -- 五毒教。\n");
write("mingjiao -- 明教。\n");
write("gaibang  -- 丐帮。\n");
write("wudang  -- 武当派。\n");
write("tiezhang  -- 铁掌帮。\n");
write("taohua  -- 桃花岛。\n");
write("huashan  -- 华山派。\n");
write("songshan  -- 嵩山派。\n");
write("shaolin   -- 少林派。\n");
write("mizong  -- 密宗。\n");
write("gumu  -- 古墓派。\n");
write("tls  -- 大理和天龙寺。\n");
write("xx -- 星宿。\n");
write("emei -- 峨嵋。\n");
write("mr -- 慕容。\n");
write("xiaoyao -- 逍遥派。\n");
write("lingjiu -- 灵鹫宫。\n");
write("shenlong -- 神龙。\n");
write("hh -- 浣花剑派。\n");
write("tiandi -- 天地会。\n");
write("kunlun -- 昆仑。\n");
write("baituo -- 白驮。\n");
return 1;
}
me->set("shizhe_want",1);
me->set_temp("dest",arg);
if (arg=="kunlun")
{
