// sample master.c code
// xiake island master.c
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void consider();

void create()
{
	set_name(RED"曾能混"NOR, ({"zheng nenghun", "zheng", "nenghun"}));
	set("title", "狂人帮帮主");
	set("nickname", HIY"天才混混"NOR);
	set("gender", "男性");
	set("age", 18);
	set("long", 
		"自17岁出狂人谷，走遍江湖混得就是一个狂字，一手成名绝技血刃掌，也独步武林，为得也只是一个狂字，所谓能狂者就狂，不狂拉倒！n");
	set("attitude", "peaceful");
	set("str", 35);
	set("int", 35);
	set("con", 35);
	set("dex", 35);

	set("qi", 7500);
	set("max_qi", 7500);
	set("jing", 7700);
	set("max_jing", 7700);
	set("neili", 7000);
	set("max_neili", 7000);
	set("jiali", 7100);
	
	set("combat_exp", 6200000);
	
	set_skill("force", 350);
	set_skill("tianyu-xinfa", 350); 
	set_skill("finger", 350);
	set_skill("changkong-zhi", 340); 
	set_skill("dodge", 350); 
	set_skill("tianyu-shenfa", 350); 
	set_skill("tianyu-qijian", 400); 
	set_skill("sword", 350); 
	set_skill("parry", 350); 
	
	map_skill("force", "tianyu-xinfa");
	map_skill("finger", "changkong-zhi");
	map_skill("sword", "tianyu-qijian");
	map_skill("dodge", "tianyu-shenfa");
	
	prepare_skill("finger", "changkong-zhi");

	create_family("长空帮", 1, "帮主");

	setup();

	carry_object("/clone/armor/changpao")->wear();
	carry_object("/clone/weapon/changjian")->wield();

}

void attempt_apprentice(object ob)
{
	command("say 好吧，希望" + RANK_D->query_respect(ob) +
	"能好好学习本帮武功，将来在江湖中闯出一番作为。");
	command("recruit " + ob->query("id"));
	ob->set("title", "狂人帮帮众");
	return;
}
