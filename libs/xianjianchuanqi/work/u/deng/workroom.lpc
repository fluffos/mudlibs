#include <ansi.h>
inherit ROOM;

void create()
{       
set("short", HIW "小刀工作室" NOR);
set("long", @LONG
        这里是山猫的工作室。正门桌上的茶盘放着刚砌好的“铁观音”，
飘出阵阵香气。左边桌上放着一台奔腾IV 1.6G电脑正在嗡嗡地工作。书架(shelf)
上全是好看的小说，墙上有一副对联(duilian)。
LONG    );
        set("valid_startroom", 1);
set("no_fight", 1);
set("no_sleep", 1);
set("no_stear", 1);
        set("exits", ([
                                   "lingjiu" : "/d/lingjiu/dating",
                "kedian" : "/d/city/kedian",
                "south" : "/d/wizard/exitroom",
                "southeast" : "/d/wizard/wizard_room",
                        "mj"  :  "/d/mingjiao/qianting",
	"out" : "/d/wizard/zoulang",
	"wud" : "/d/wudang/sanqingdian",
	"sl" : "/d/shaolin/guangchang1",
	"gb" : "/d/city/gbxiaowu",
	"dl" : "/d/dali/dating",
	"xx" : "/d/xingxiu/xxh2",
          "gc" : "/d/city/guangchangpishou",     ]));
        set("item_desc", ([
                "shelf" : HIR "\n这里有各门各派的武功秘籍。\n" NOR,
                "duilian" : HIM "\n还没想好挂什么?\n" NOR,
        ]));
        set("objects",([
                "/d/city/obj/jiudai" : 1,
        ]));

	setup();
	replace_program(ROOM);	}
int valid_leave(object me, string dir)
{
        if( (dir=="south") && !wizardp(me)||(dir=="southeast") && !wizardp(me) )
        if( (dir=="south") && !wizardp(me)||(dir=="southeast") && !wizardp(me) )
                return notify_fail("那里只有巫师才能进去。\n");
        return ::valid_leave(me, dir);
}

void init()
{
    if (this_player()->query("id") != "deng")
        message_vision(HIY"$N乐呵呵的飞了过来，突然觉得不大对，飞起一脚踢中邓小刀的屁股，
                              破口大骂，音乐打那么大声做什么找死。后来一听是刘德华唱的
                             《男人哭吧不是罪》， 听着听着自已确哭了起来，因为他刚刚失恋，
                              不哭不行！！\n"NOR, this_player());
}