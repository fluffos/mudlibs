// murong-jianfa 慕容剑法
// by kain

#include <ansi.h>
inherit F_SSERVER;

int perform(object me, object target)
{
      object weapon;
      int i;
      weapon = me->query_temp("weapon");  


       if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("「剑雨飞花」攻击只能对战斗中的对手使用。\n");
     
       if (!weapon || weapon->query("skill_type") != "sword"
           || me->query_skill_mapped("sword") != "murong-jianfa")
           return notify_fail("你现在无法使出「剑雨飞花」绝技！\n");

       if (weapon->query("unique"))
           return notify_fail("你手中之物乃是神兵利刃，怎可用内力震碎？！\n");

        if(me->query_skill("murong-jianfa", 1) < 150 )
                return notify_fail("你的慕容剑法火候不够，不能使用「剑雨飞花」绝技。\n");

        if(me->query_skill("sword", 1) < 150 )
                return notify_fail("你的基本功还不够娴熟，不能使用「剑雨飞花」绝技。\n");

        if( (int)me->query_skill("shenyuan-gong", 1) < 160 )
                return notify_fail("你的神元功等级不够，不能使用「剑雨飞花」绝技。\n");

        if ( me->query_skill_mapped("force") != "shenyuan-gong")
           return notify_fail("没有神元功作为根基，是无法使出「剑雨飞花」绝技的！\n"); 

       if(me->query_temp("jianyu")) 
           return notify_fail("你刚刚使用完「剑雨飞花」绝技，现在还不能使用！\n"); 

       if (me->query("max_neili") < 2500)
           return notify_fail("你的内力修为不够，用什么来震碎武器？\n");
       if (me->query("neili") < 650)
           return notify_fail("你的内力不够了，无法震碎兵刃。\n");
       if (me->query("jingli") < 200)
           return notify_fail("你的精力不够。\n");
        me->add("neili", -600);
        me->add("jingli", -100);        
        message_vision(HIR"\n$N默运神元功，手中的"+weapon->name()+HIR"「啪」地一声断为数节，$N用手一抄，用「满天花雨」手法打出，片片断剑好似满天繁星，尽数冲向$n周身大穴！\n"NOR,me,target);      

//jianyu's damage depends on how many times u pfmd       
        i = me->query("jianyu");
        if(i > me->query_skill("sword")) i = me->query_skill("sword");
        i -= me->query("age");
//and it will not be over ur enable sword skill

        me->add_temp("apply/damage", i);
        me->set_temp("jianyu_hit", 1);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
        weapon->add("jianyu", 1);
        if (weapon && weapon->query("jianyu") >= (1+weapon->query("rigidity"))) {
           message_vision(HIY"\n只见$N手中的$n"HIY"已然不见！\n"NOR,me,weapon);
           weapon->unequip();
           weapon->move(environment(me));
           weapon->set("name", "碎掉的" + weapon->query("name"));
           weapon->set("value", 49);
           weapon->set("weapon_prop", 0);
           me->reset_action();
           }
        me->add_temp("apply/damage", -i);
        me->delete_temp("jianyu_hit");
        me->start_busy(2+random(2));
        return 1;
}
 