// tufei.c 全真土匪

#include <ansi.h>

inherit NPC;
#define NAME_D "/adm/daemons/random_name"
void create()
{
	mapping name;
	name = NAME_D->man_name();
	set_name(name["name"],({name["id"],name["id1"],name["id2"]}));
        set("title","土匪");
	set("gender", "男性");
	set("age", 35);
	set("long",
		"此人是全真附近杀人越货的土匪\n");
	set("combat_exp", 2500 + random(10000));
	set("attitude", "heroism");
	
	set("qi", 100 + random(300));
        set("max_qi", 100 + random(300));
        set("jing", 100 + random(300));
        set("max_jing", 100 + random(300));
        set("neili", 400 + random(500));
        set("max_neili", 400 + random(500));

	set_temp("apply/attack",  50);
	set_temp("apply/defense", 50);

	set_skill("unarmed", 20 + random(30));
	set_skill("parry", 20 + random(30));
	set_skill("dodge", 20 + random(30));

	setup();
	
        carry_object("/clone/cloth/cloth")->wear();
        call_out("reach", 50 + random(50), this_object());
        add_money("silver", 30 + random(50));
}

void init()
{
        object me,ob;
        ::init();
        if (interactive(me = this_player()))
        {
	if (!(ob = present("xionghuang", this_player())))          
               {
	       remove_call_out("kill_ob");
	       command("say 哈哈，肥羊自己送上门了。\n");
               call_out("kill_ob", 1, me);
		}
        }
}
void reach(object me)
{
        command("say 回家了，今天什么都没有抢着。\n");
        command("sigh");
        destruct(this_object());
}