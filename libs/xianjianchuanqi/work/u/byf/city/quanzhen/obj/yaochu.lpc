// yaochu.c 药锄
// wowo 2k-4-8

inherit ITEM;
#include <ansi.h>

void init()
{
        add_action("do_bo", "bo");
        add_action("do_dig", "dig");
}

void create()
{
        set_name(HIY"药锄"NOR, ({"yao chu","yaochu"}));
        set_weight(800);
	if( clonep() )
		set_default_object(__FILE__);
        else {
        set("no_drop", 1);
	set("no_put", 1);
	set("no_beg", 1);
	set("no_steal", 1);
	//set("no_give", 1);
        set("unit", "根");
        set("long", "这是一把全真道士挖药的药锄。\n");
        setup();
        }
}

int do_bo()
{
	object me=this_player();
	object ani;
	object s_1=me->query("id");

        if (environment(me)->query("short") != "树林") 
                     return notify_fail("这里能有草药吗？\n");
        
        if ((int)me->query("qi") <30 ) return notify_fail("你想累死吗？\n");
                     message_vision(me->query("name")+"用药锄拨动着四周的灌木杂草，仔细地看有没有草药！\n", this_player());
       switch ( random(8) )
            
              {
                 case 0:
                        me->add("qi",-10);
                        ani = new("/d/city/npc/snake");
                        ani ->move(environment(me));
                        ani ->set("s_2",s_1);
                        tell_room(environment(me),HIR + me->query("name")+"用药锄拨动四周的山草，突然一条毒蛇窜了出来。\n" NOR);
                 break;  
                 case 1:
                        me->add("qi",-10);
                        ani = new("/d/city/npc/snake");
                        ani ->move(environment(me));
                        ani ->set("s_2",s_1);
                        tell_room(environment(me),HIR + me->query("name")+"用药锄拨动四周的山草，突然一条毒蛇窜了出来。\n" NOR);
                 break;
                 case 2:
                        me->add("qi",-10);
                        ani = new("/d/quanzhen/npc/tufei");
                        ani ->move(environment(me));
                        ani ->set("s_2",s_1);
                        tell_room(environment(me),HIR + me->query("name")+"用药锄拨动四周的山草，突然一个大汉窜了出来。\n" NOR);
                  break;
                  case 3:
                        me->add("qi",-10);
                  break;
                  case 4:
                        me->add("qi",-10);
                        message_vision(me->query("name")+"用药锄不断的拨动着四周的山草，忽然发现杂草之中有一株特别的草！\n", this_player());
                        me -> set_temp("marks/can_dig",1);
                  break;
                  case 5:
                        me->add("qi",-10);
                  break;
                  case 6:
                        me->add("qi",-10);
                  break;
                  case 7:
                        me->add("qi",-10);
                  break;
               } 
                  return 1;
}
int do_dig()
{
	object me=this_player();
	object yaocai;
	
	if(me->query_temp("marks/can_dig")) 
            {
  	
  	          me->delete_temp("marks/can_dig",1);
  	          me->add("combat_exp",50 + random(50));
                  me->add("potential",10 + random(40));
                if ( me->query("potential")-me->query("learned_points") > me->query_max_potential() )
                  me->set("potential",me->query_max_potential() + me->query("learned_points"));
                  me->save();
                  //message_vision(me->query("name")+"用药锄小心翼翼的把药材从土中起出！。\n");
                  tell_room(environment(me),HIG + me->query("name")+"用药锄小心翼翼的把药材从土中起出。\n" NOR);
        
                switch( random(3) )
                   {
    
                       case 0:
                               yaocai = new("/d/quanzhen/obj/moyao");
                               yaocai->set_amount(1);
                               yaocai->move(me);
                       break;  
  
                       case 1:
                               yaocai = new("/d/quanzhen/obj/tianqi");
                               yaocai->set_amount(1);
                               yaocai->move(me);
                       break; 
  
                       case 2:
                               yaocai = new("/d/quanzhen/obj/xuejie");
                               yaocai->set_amount(1);
                               yaocai->move(me);
                       break; 
                     }
       
                 switch( random(2) )
                     {
                       
                       case 0:
                               tell_room(environment(me),HIY + me->query("name")+"用力过大，结果把药锄挖断了。\n" NOR);
                               destruct(this_object());
                       break;  
  
                       case 1:
                               tell_room(environment(me),HIG + me->query("name")+"小心翼翼的把药锄拿了起来了。\n" NOR);
                       break; 
                      }
                return 1;
             }
  
        else
             {
                   tell_room(environment(me),HIR + me->query("name")+"用力的用药锄挖土，结果把药锄挖断了。\n" NOR);
                   destruct(this_object());
                   return 1;
              }
}