// weidou.c

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create() {
  set_name("围兜", ({ "weidou", "dou" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是燕宝宝用的小围兜，也不知道用什么做的，漂亮
的不得了，下面有个小兜兜，放者燕宝宝的纸尿布，小围兜还是名牌啊，阿曼尼的。。\n");
    set("material", "silk");
    set("unit", "件");
    set("value", 0);
    set("wear_msg", HIY "只听「哗」的一声，$N穿上一件小围兜。
瞬时间日月为之失色，瑞气千条，祥云朵朵，一派幸福吉祥气象。\n" NOR);
    set("remove_msg", HIY "$N将小围兜从身上脱了下来，细心的叠起来，叹口气嘟囔：又脏了，要给小胖哥洗了。\n" NOR);
    set("armor_prop/armor", 20000);
  }
  setup();
}
