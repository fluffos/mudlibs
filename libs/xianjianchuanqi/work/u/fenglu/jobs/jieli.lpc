// lian.c 太极剑法「连」字诀

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>


inherit F_SSERVER;

int perform(object me, object target)
{
        object weapon;
                 string msg;
         int i,attack_time,t,damage;

             weapon = me->query_temp("weapon");

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招"HIW"「借力打力」"NOR"？\n");
        
     if (!weapon || weapon->query("skill_type") != "sword"
       || me->query_skill_mapped("sword") != "taiji-jian")
              return notify_fail("你手里没有剑，无法使用「借力打力」！\n");

        if(!me->is_fighting())
                return notify_fail(""HIW"「借力打力」"NOR"只能在战斗中使用！\n");


        if((int)me->query("max_neili") < 2000 )
                return notify_fail("你的内力不够！无法借力!\n");

   if((int)me->query("neili") < 600 )
     return notify_fail("你的内力不足！\n");
             if (me->query_skill_mapped("force") != "yinyun-ziqi")
                return notify_fail("你所使用的内功不对。\n");
          if (me->query_skill_mapped("parry") != "taiji-jian")
                return notify_fail("你所使用的招架不对。\n");
       if((int)me->query("jieli") >= 2 )
//  45                return notify_fail("你已经两次借力，在无力借力了。\n");
        if((int)me->query_skill("yinyun-ziqi", 1) < 200)
                return notify_fail("你的氤氲紫气级别还不够，无法借力!\n");
       if((int)me->query_skill("taiji-jian",1) < 202 )
     return notify_fail("你的太级剑等级不够，无力可借\n");
         if( (int)me->query("double_attack",1) > 0)
  return notify_fail("你已经会hubo不能用借力。\n");
            if((int)me->query_skill("taiji-quan", 1) < 200)
                return notify_fail("你的太极拳级别还不够，无法融会这一招!\n");
        if( (int)me->query_temp("tjj_jie") ) 
                return notify_fail("你正在运用[破力]，无法再用[借力]了。\n");
      msg = HIC "$N使出太级剑法的"HIW"借力"HIC"之决，画出无数个圆圈，将$n的攻击悉数引向自己身上。\n"NOR;
  t=(int)target->query("jiali", 1)/5+(2+random(4));
        if( random(me->query("combat_exp")) > (int)target->query("combat_exp")*40/100)
        {
                msg += HIR" 结果$n的招数被$N的剑圈悉数引向自己！\n" NOR;
                message_vision(msg, me, target); 
attack_time = (int)target->query("jiali", 1)/10+random(2);  
  if(attack_time > 5)
                        attack_time = 5;
               for(i = 0; i < attack_time; i++){               
 COMBAT_D->do_attack(target, target,me->query_temp("weapon"), 0);}
                 target->add("jingli",-t*100);
             target->add("max_qi",-t*100);
             target->add("qi",-t*100);
            target->add("jing",-t*100);
                me->add("neili", - 150);
                me->add("jingli", - 100);
                call_out("perform2", 0, me, target); 

        }
        else
        {
        msg += HIM"$n强用心神，终于控制住自己。但是也被"HIW"圈"HIY"得头昏脑涨！\n" NOR;
                message_vision(msg, me, target);
                target->start_busy(random(3)+2);
                me->add("neili", -50); 
             call_out("perform2", 1, me, target); 

                       }
        if(!target->is_fighting(me)) target->fight_ob(me);
        return 1;
}
int perform2(object me, object target, int p)
{
              string msg, dodge_skill; 
         int i,attack_time,extra,t;
          object weapon;
if( !target ) target = offensive_target(me);
         weapon = me->query_temp("weapon");

      if(!living(target))
   return notify_fail("对手已经不能再战斗了。\n");   
    if(!living(me))  
         return notify_fail("你已经不能再战斗了。\n");

        if(  target->query("qi", 1) < 500 ) 
          return notify_fail(HIR"对手已经不能再战斗了。"NOR"\n");
      if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招"HIW"「借力打力」"NOR"？\n");
        
       if (!weapon || weapon->query("skill_type") != "sword"
       || me->query_skill_mapped("sword") != "taiji-jian")
              return notify_fail("你手里没有剑，无法使用「借力打力」！\n");

        if(!me->is_fighting())
                return notify_fail(""HIW"「借力打力」"NOR"只能在战斗中使用！\n"); 
        if(!target->is_fighting())
                return notify_fail(""HIW"「借力打力」"NOR"只能在战斗中使用！\n"); 
        if( (int)me->query("neili", 1) < 200 )
                return notify_fail("你待要再次借力，却发现自己的内力不够了！\n");   
        if( (int)me->query("jiali", 1) > 0 )
    return notify_fail("你既要接力，却又为何加力?\n");    
   t=(int)target->query("jiali", 1)/5+(3+random(2));

// 124        if ( target->query("env/no_fight") )
     if (10 < 1)
       {
 message_vision(HIC "$N"HIR"继续"HIC"使出太级剑法的"HIW"借力"HIC"之决，但发现$n并未出手,你的"HIW"借力效果"HIC"顿失。\n"NOR,me,target);
// 128       call_out("perform2", 1, me, target); 
                } 
          else
   {
  msg = HIC "$N"HIR"再次"HIC"使出太级剑法的"HIW"借力"HIC"之决，画出无数个圆圈，将$n的攻击悉数引向自己身上。\n"NOR;
   if (random (me->query("combat_exp")) > (int)target->query("combat_exp")*40/100)
     {
            msg += HIR " 结果$n的招数被$N的剑圈悉数引向自己！\n" NOR;
                message_vision(msg, me, target); 
 
   attack_time = (int)target->query("jiali", 1)/10+random(2);
     if(attack_time > 5)
                        attack_time = 5;
               for(i = 0; i < attack_time; i++){               
    COMBAT_D->do_attack(target, target,me->query_temp("weapon"), 0);}
                                 me->add("neili", 30);
                      target->add("jingli", - t*30);
                  target->add("qi", - t*20);
                  target->add("jing", - t*25);
         target->add("jingli", - t*15);
// 139         if(!target->is_fighting(me)) target->fight_ob(me);
// 140             return 1;
                   call_out("perform2", 1, me, target); 

       }
      else
        {
        msg += HIM"$n强用心神，提气吐浊，看上去似乎没有上当! 其实已经"HIR"受伤不轻。\n" NOR;  
                message_vision(msg, me, target);
                  me->add("neili", -10); 
             target->add("jing", - t*10);
                  target->add("jingli", - t*25);
                  me->add("qi",t*8);
            target->add("qi", - t*50);
// 153          if(!target->is_fighting(me)) target->fight_ob(me);^M
// 154          return 1;^M
          call_out("perform2", 1, me, target); 
                       }
    }
}

