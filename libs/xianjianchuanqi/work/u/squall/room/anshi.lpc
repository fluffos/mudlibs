// anshi.c
inherit ROOM;
#include <ansi.h>
void create()
{
        set("short", HIB"暗室"NOR);
        set("long", @LONG
这是一个地下的秘密暗室，里面空荡荡的，你隐约看到有个人影。
细看之下，你发现那人面朝石壁，盘膝而坐。也不知道在这里坐了
多久，是死是活。一种莫名的恐惧在你心里油然而生。
LONG );
        set("exits", ([
                "east" : "/d/xiaoyao/shishi4",
        ]));
        set("objects",([
                "/u/squall/npc/wuya" : 1,
        ]));
        setup();
}
