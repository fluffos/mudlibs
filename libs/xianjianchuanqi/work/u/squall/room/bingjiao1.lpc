// bingjiao.c
inherit ROOM;
void create()
{
        set("short", "冰窖");
        set("long", @LONG
你走在一个冰洞里面，四面都有出路，冰壁就好象是一面镜子，反映出你的
身影，在这里面，你根本就分不清东南西北，只感觉到里面越来越冷，心里想着
这个地方还是快快离开吧，但找不到出路的你却越来越着急。
LONG
        );
        set("exits", ([ 
         "south" : "/u/squall/room/bingjiao1",
          "east" : "/u/squall/room/bingjiao2",
          "north" : "/u/squall/room/bingjiao3",
     "west" : "/u/squall/room/bingjiao4",
]));
        setup();
        replace_program(ROOM);
}
