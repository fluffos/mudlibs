#include <ansi.h>
inherit ROOM;
void create() {
  set("short", HIG "藏剑室" NOR);
  set("long", @LONG
这间房间里面什么也没有，但传闻以前华山曾经有高人在这里闭关修行，
还留下了一把宝剑，你环顾四周，只看见屋顶有根大梁(liang)。
LONG
  );
  set("sword_count", 1);
  set("exits", ([
    "out": "/u/squall/room/xiaolu",
  ]));
  set("item_desc", ([
    "liang": "你隐约看见上面有光一闪，不知道上面会不会藏着什么东西。\n",
  ]));
  set("objects", ([
    //                "" : 1,
  ]));
  setup();
}
void init() {
  add_action("do_jump", ({ "tiao", "jump" }));
}
int do_jump(string arg) {
  mapping fam;
  object sword, me;
  me = this_player();
  if (!arg || arg != "liang")
    return notify_fail("你要做什么呢？\n");
  if (!(fam = this_player()->query("family")) || fam["family_name"] != "华山派")
    return notify_fail("你不是华山弟子，想要什么啊。\n");
  if ((int)me->query("neili") < 1200)
    return notify_fail("你纵身一跳，却发现自己现在的内力跳不上去。\n");
  if (random(10) != 8) {
    me->add("neili", -200);
    return notify_fail("你潜运内力，纵身一跳，想要一把抓住剑柄。\n");
  }
  message_vision("$N潜运内力，纵身上跳，一把抓住剑柄，跳了下来。\n", me);
  me->add("neili", -1000);
  me->set_temp("mark/sword", 1);
  sword = unew("/u/squall/obj/qingfeng");
  if (!clonep(sword)) {
    message_vision("结果$N发现上面什么也没有了，一个漂亮的后翻，$N稳稳的落在地上，一脸的沮丧。\n", me);
    return 1;
  }
  sword->move(me);
  return 1;
}
