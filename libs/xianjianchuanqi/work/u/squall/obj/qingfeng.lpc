// qingfeng.c 清风剑
#include <ansi.h>
#include <weapon.h>
inherit SWORD;
inherit F_UNIQUE;
void create() {
  set_name(HIB "清风剑" NOR, ({ "qingfeng jian", "sword", "qingfeng" }));
  set_weight(15000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long",
      "一把极为锋利的宝剑，你手指在剑身上轻轻一弹，嗡嗡声震耳欲聋。\n");
    set("value", 1);
    set("unique", 1);
    set("rigidity", 5);
    set("sharpness", 3);
    set("material", "blacksteel");
    set("weapon_prop/dodge", 5);
    set("weapon_prop/parry", 5);
    set("treasure", 1);
    set("wield_neili", 300);
    set("wield_maxneili", 700);
    set("wield_str", 22);
    set("skill", ([
      "name": "sword",
      "exp_required": 50000,
      "difficulty": 25,
      "min_skill": 50,
      "max_skill": 100,
    ]));
    set("wield_msg", HIG "一阵清风拂面，$N[噌]的一声抽出一把清风剑,舞了个剑花。\n" NOR);
    set("unwield_msg", HIG "$N把手中的清风剑缓缓插入剑鞘。\n" NOR);
  }
  init_sword(110);
  setup();
}
