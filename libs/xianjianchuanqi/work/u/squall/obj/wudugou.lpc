// 五毒追魂钩 by squall

#include <ansi.h>
#include <weapon.h>
inherit HOOK;
inherit F_UNIQUE;

void create() {
  set_name(BLU "五毒追魂钩" NOR, ({ "zhuihun", "gou" }));
  set_weight(50000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("unique", 1);
    set("wield_neili", 800);
    set("wield_maxneili", 1200);
    set("sharpness", 1);
    set("weapon_prop/parry", 5);
    set("weapon_prop/dodge", -8);
    set("wield_str", 28);
    set("value", 10);
    set("treasure", 1);
    set("rigidity", 10);
    set("long", "这是五毒教的镇教之宝，千年玄铁打造的钩身上泛着隐隐蓝光，行家一看就知道上面;注有奇毒！见血封喉！。\n");
    set("value", 100);
    set("material", "steel");
    set("wield_msg", BLU "$N阴阴一笑，$N意随心动一把五毒追魂钩已经无声无息的握在手中。\n" NOR);
    set("unwield_msg", BLU "$N身形为动，五毒追魂钩以被$N收到身后。\n" NOR);
  }
  init_hook(110);
  setup();
}
