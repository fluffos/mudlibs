// qiushui.c
#include <weapon.h>
#include <ansi.h>
inherit BLADE;
inherit F_UNIQUE;
void create()
{
        set_name(MAG"秋水刃"NOR, ({ "qiushui ren","blade","dao" }));
        set_weight(15000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("rigidity", 5);
                set("sharpness", 3);
                set("long", "一把泛着波光的宝刀，相传是逍遥子耗尽多年心血打造的。\n");
                set("value", 1);
                set("unique", 1);
                set("weapon_prop/dodge", 5);
                set("weapon_prop/parry", 3);
                set("material", "steel"); 
                set("wield_neili", 150);
                set("wield_maxneili", 1200);
                set("wield_str", 23);
                set("wield_msg", MAG" 一道水痕从天空落在在$N手中，让人在感到一种莫名的悲哀。\n"NOR);            
                set("unwield_msg", MAG"$N随手一抖，秋水刃化为一团水气消失在$N的手中。\n"NOR);
                set("treasure",1);
        }
        init_blade(120);
        setup();
}
