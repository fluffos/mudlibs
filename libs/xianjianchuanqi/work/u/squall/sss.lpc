
#include <ansi.h>;
inherit ROOM;

void create()
{
     set("short", HIR"情花"NOR"园");
     set("long", "这里是"+HIR"情花"+NOR"的花园，里面种满了红色的"+HIR"情花"+NOR"。\n"
		 "传说如果你被满身是刺的"+HIR"情花"+NOR"刺到，就会受尽折磨。你害怕的浑身发抖，急忙退了出去。\n");
        set("no_fight", 1);
	set("sleep_room", 1);
        set("exits", ([
         "east" : "/u/squall/room1",
          ]));
	setup();
}

 
