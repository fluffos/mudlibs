// lifeheal.c

#include "ansi.h"

int exert(object me, object target) {
  if (!target || target == me)
    return notify_fail("你要用真气为谁治疗？\n");

  if (me->is_fighting() || target->is_fighting() || !living(target))
    return notify_fail("战斗中无法运功治疗！\n");

  if ((int)me->query("max_neili") < 1500)
    return notify_fail("你的内力修为不够。\n");

  if ((int)me->query("neili") < 1600)
    return notify_fail("你的真气不够。\n");
  if (!target->query_conditions_by_type("poison"))
    return notify_fail("对方没有中毒啊。\n");

  if ((int)me->query_skill("medicine", 1) < 61)
    return notify_fail("你本草术理的等级不够，无法为他人疗伤。\n");
  if ((int)me->query_skill("wudu-shengong", 1) < 150)
    return notify_fail("你内功等级不够，无法为他人疗伤。\n");

  else {
    message_vision(
      HIB "$N满头大汗，将五毒神功真气灌入一颗蓝色的小丹里面，慢慢喂$n服下...\n"
      "$n只觉得五脏六腑无处不痛，脸色极为难看，但所中之毒有了很大的好转。\n" NOR,
      me, target);
  }
  target->receive_curing("qi", 10 + (int)me->query_skill("force") / 2);
  target->add("qi", 10 + (int)me->query_skill("force") / 2);
  if ((int)target->query("qi") > (int)target->query("eff_qi")) target->set(
    "qi",
    (int)target->query("eff_qi")
  );
  target->clear_condition("xx_poison");
  target->clear_condition("dashouyin");
  target->clear_condition("hb_poison");
  target->clear_condition("qzhu_poison");
  me->add("neili", -1500);

  return 1;
}
