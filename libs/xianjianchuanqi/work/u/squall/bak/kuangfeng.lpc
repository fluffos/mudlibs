// squall_npc 
inherit NPC;
#include "ansi.h"
string ask_me();
void create()
{
       set_name(HIC"狂风"NOR, ({ "kuang feng", "feng"}) );
       set("gender", "男性" );
       set("age", 22);
       set("long",
               HIY"一个穿着十分古怪的人，个子挺高，看起来倒也不错，满面笑笑嘻嘻的，\n"
                  "骨子里却透着一股邪气。\n"NOR
	       HIG"据说他是从个叫什么二十一世纪来的，跑到这里来专门做杀人放火的勾当。\n"
	          "不过当你杀了人，来这里也许他能帮你些忙。当然是要钱的。\n"NOR
		);
       set("combat_exp", 5000000);
       set("attitude", "peaceful");
       set("max_qi", 30000);
       set("max_jing", 30000);
       set("neili", 30000);
       set("max_neili", 30000);
       set("eff_jingli", 30000);

       set_skill("literate", 400);

       set("attitude", "friendly");
              set("inquiry", ([
            	"杀人" :  "你杀了人？！恩，不错，有我当年的风范。",
		"狂风" :  "没见我就是吗，你是真不知道还是装蒜啊。",
		"真不知道":"我这么出名你都不认识我？唉，看来该重出江湖了。",
		"装蒜" : "嘿嘿，你给我发呆去吧。",
		"重出江湖":"这个谈何容易，老啦，不中用了。",
		"squall"  : "squall ？ 嘿嘿，他是我老大，厉害着呢。",
                "帮忙" : (: ask_me :),
		"价钱" : "心诚则灵。",
		"通缉" : "你是通缉犯？要是在我们二十一世纪，你早被枪毙了。",
		"二十一世纪" : "二十一世纪？好玩着呢？想去不？想去就和我说声要去。",
		"要去" : "你想要去啊？等我哪天心情高兴了就带你去。",
		"高兴" : "我没高兴的时候，呵呵…………",
		"心情" : "我没心情好的时候，哈哈……",	
       ]) );
	   set("chat_chance", 30);
       set("chat_msg", ({
                "狂风嘿嘿一笑，说道: 想要找兄弟我帮忙的尽管开口，只要兄弟我能帮得上的。嘿嘿…… \n",
                "狂风仰天长叹道：难道这个世道竟然没有王法，天理何在啊？！ \n",
		"狂风快乐地唱着：“我们是害虫，我们是害虫……”\n",
              }) );

       setup();

}

string ask_me()
{
  object me;
  me = this_player();


  if (me->query("sq_k_player",1)<=0)
  return "平日兄弟我待你不薄啊，怎来开这种玩笑？\n";
  if (me->query_temp("sq_pk")) return "不是做兄弟的不帮你，你才犯了事，我实在没办法啊。\n";
  me->set_temp("sq_ask1", 1);
  message_vision("\n$N对着$n嘿嘿一笑说道：人杀多了吧，找我帮忙就找对了？\n
$N对着$n拍着胸脯说道：别说就是帮忙，就是要做兄弟的为了你赴汤蹈火，也绝不皱一下眉头。\n
$N对着$n满脸委屈说道：不过……，你也知道，做这个事是要担很大的风险的，不小心就要被砍头的。\n
$N对着$n说道：再说，做兄弟的最近手头紧，还有几个老婆要养活，你也知道，最近物价飞涨\n，房子卖得又贵，为了帮你的忙还要去打通众多门道…………\n"
, this_object(), me);
    return "说了这么多了，你懂了吗？再不懂我也没办法了。\n";    
}


int accept_object(object me, object obj)
{            
      if(obj->query("money_id")){
        if(me->query_temp("sq_ask1")){
          if(obj->value() >= me->query("combat_exp")/5+500000){
              command("hehe " + me->query("id"));
              command("whisper "+me->query("id")+" 都是自家人，你也太客气了吧！");
	      command("say 古代人就是比现代人懂事。呵呵……");
              me->add("sq_k_player",-1);
              me->delete_temp("sq_ask1");
              return 1;
              }
          else {
              command("say 唉，看来你还是不知道做兄弟的苦衷啊！");
              return 1;
              }
          }
        else {
             command("? "+ me->query("id"));
             return 1;
             }
      }
      command("faint " + me->query("id"));
      command("say "+obj->name()+"对我没用。");
      return 0;
}
