#include <room.h>
#include <ansi.h>
inherit ROOM;

void create()
{ 
       set("short","秘道");
       set("long", @LONG
这里是秘道的出口，直通半山腰。
LONG
     );
    
	set("exits", ([
               "east" : __DIR__"bidao21",
                 "southdown"  :  __DIR__"bidao15",
	]));             
        setup();
}
int valid_leave(object me, string dir)
{
        if (dir == "out") {
                write(HIW"\n你出得洞来，强光闪耀，一时之间竟然睁不开眼。\n\n"NOR);
       }
       return 1;
}



