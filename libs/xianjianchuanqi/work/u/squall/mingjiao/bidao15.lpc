#include <room.h>
#include <ansi.h>
inherit ROOM;

void create()
{ 
       set("short","秘道");
       set("long", @LONG
这是一条弯曲而上的秘道。
LONG
     );
    
	set("exits", ([
      "eastup" : __DIR__"bidao16",               
                 "northup"  :  __DIR__"bidao20",
                  "north" : __DIR__"bidao22",
	]));             
        setup();
}
void init()
{
	add_action("do_gua","gua");
	add_action("do_pull","pull");
}
