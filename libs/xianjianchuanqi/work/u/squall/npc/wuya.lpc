inherit NPC;
#include <ansi.h>
inherit F_MASTER;
string ask_me();
void create() {
  set_name("吴崖子", ({ "wuya zi", "zi", "wuya" }));
  set("gender", "男性");
  set("shen_type", 0);
  set("class", "scholar");
  set("age", 100);
  set("str", 30);
  set("con", 30);
  set("int", 45);
  set("dex", 35);
  set("per", 30);
  set("no_clean_up", 1);
  set("long",
    "此人就是逍遥派苏星河的师傅，看他容貌很难相信他已经年过\n"
    "一百，江湖传闻此人早以死去，你在这儿见到他不由大吃一惊。\n");
  set("combat_exp", 3000000);
  set("attitude", "peaceful");
  set("book_count", 1);
  set("chat_chance", 1);
  set("inquiry", ([
    "宝刀": (: ask_me :),
    "秋水刃": (: ask_me :),
  ]));
  set("max_qi", 7400);
  set("max_jing", 3000);
  set("neili", 8500);
  set("max_neili", 8500);
  set("jiali", 60);
  set("env/wimpy", 60);
  set_skill("force", 300);
  set_skill("dodge", 300);
  set_skill("parry", 300);
  set_skill("blade", 300);
  set_skill("lingboweibu", 300);
  set_skill("beiming-shengong", 300);
  set_skill("ruyi-dao", 300);
  set_skill("liancheng-jian", 300);
  set_skill("sword", 300);
  set_skill("liuyang-zhang", 300);
  set_skill("zhemei-shou", 300);
  set_skill("literate", 300);
  set_skill("hand", 300);
  set_skill("strike", 300);
  map_skill("strike", "liuyang-zhang");
  map_skill("blade", "ruyi-dao");
  map_skill("dodge", "lingboweibu");
  map_skill("force", "beiming-shengong");
  map_skill("hand", "zhemei-shou");
  prepare_skill("hand", "zhemei-shou");
  prepare_skill("strike", "liuyang-zhang");
  create_family("逍遥派", 1, "弟子");
  set("title", "逍遥派隐居高人");
  setup();
  carry_object("/d/xiaoyao/npc/obj/cloth")->wear();
}
void attempt_apprentice(object ob) {
  if (ob->query_int() < 30) {
    command("pat" + ob->query("id"));
    command("say " + RANK_D->query_respect(ob) +
      "是否还应该在学问上多下点功夫？");
    return;
  }
  if (ob->query_str() < 35) {
    command("say 你还是去找我徒儿吧。");
    return;
  }
  if (ob->query_con() < 35) {
    command("say 你还是去找我徒儿吧。");
    return;
  }
  command("say 好，我就收你为徒，今后不要丢了我的脸！");
  command("chat* haha" + ob->query("id"));
  command("chat 好，今天" + ob->name(1) + "就为我的正式传人了！");
  command("recruit " + ob->query("id"));

}
string ask_me() {
  object me, ob;
  mapping fam;
  if (!(fam = this_player()->query("family"))
    || fam["family_name"] != "逍遥派")
    return RANK_D->query_respect(this_player()) + "与本派毫无瓜葛，何来此言？！";
  if (!this_player()->query_temp("squall_dao"))
    return "你是在说什么呢？我怎么听不懂？";
  if (this_player()->query("combat_exp") < 100000)
    return RANK_D->query_respect(this_player()) + "看来功力不够，逍遥的宝刀还不能给你。";

  this_player()->set_temp("squall_dao1", 1);
  this_player()->delete_temp("squall_dao", 1);
  command("say 不错，你去找我徒弟苏星河拿秋水刃吧，要妥善保管。");
  return "如果你用我逍遥的宝刀为非作歹我亲自取你性命。";
}
