#include <ansi.h>
inherit NPC;
void create()
{
    object ob;
        set_name(HIY"萧峰"NOR, ({ "xiao feng",  "xiao" }) );
        set("nickname", HIG"铁掌降龙"NOR);
        set("long", 
"这人身材甚是魁伟，三十来岁年纪，身穿灰色旧布袍，已微有破烂，浓眉大\n"
"大眼，高鼻阔口，一张四方的国字脸，颇有风霜之色，顾盼之际，极有威势。\n");
        set("gender", "男性");
        set("age", 35);
        set("attitude", "friendly");
        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);
        set("unique", 1);
         set("max_qi", 4000);
         set("max_jing", 3000);
         set("eff_jingli", 3000);
         set("jiali", 50);
         set("combat_exp", 2200000);
         set("shen", 250000);
         set("chat_chance_combat", 50);
         set("chat_msg_combat", ({
                 (: exert_function, "xiao" :),
                  (: perform_action, "strike.paiyun" :)
         }));
        set_skill("force", 200);
        set_skill("bangjue", 200);
        set_skill("begging", 200);
        set_skill("checking", 200);
        set_skill("dagou-bang", 200);
        set_skill("dodge", 200);
        set_skill("huntian-qigong", 200);
        set_skill("parry", 200);
        set_skill("stick", 200);
        set_skill("strike", 200);
        set_skill("xianglong-zhang", 200);
        set_skill("xiaoyaoyou", 200);
        map_skill("force", "huntian-qigong");
        map_skill("dodge", "xiaoyaoyou");
        map_skill("parry", "xianglong-zhang");
        map_skill("strike", "xianglong-zhang");
        map_skill("stick", "dagou-bang");
        prepare_skill("strike", "xianglong-zhang");
        setup();
           if (clonep(this_object())) 
            if (ob = carry_object("/u/squall/obj/kuxue")) ob->wield();
        carry_object("/clone/armor/cloth")->wear();
}
