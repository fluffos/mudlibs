// ning_zhongze.c 宁中则

inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("宁中则",({"ning zhongze","ning"}));
        set("title","华山派掌门夫人");
        set("long", "她是个不让须眉的女中豪杰，华山派君子剑岳不群的夫人。");
        set("age", 36);
	set("gender", "女性");
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 25);
        set("int", 25);
        set("con", 25);
        set("dex", 25);
        
        set("max_qi",1700);
	set("qi",1700);
	set("jingli",1500);
	set("max_jingli", 1500);
        set("max_jing", 1500);
        set("neili", 2000);
	set("jing", 1500);
        set("max_neili", 2000);
        set("jiali", 10);
        set("combat_exp", 450000);
	set("score", 20000);
       	set("chat_chance_combat",40);
        set("chat_msg_combat", ({
	(: perform_action, "cuff.leidong" :),
	(: perform_action, "sword.jianmang" :),
}));
        
        set_skill("cuff",   160);
	set_skill("poyu-quan", 160);
          set_skill("strike",   160);
        set_skill("sword",  160);
        set_skill("dodge",  160);
        set_skill("force",  160);
        set_skill("parry",  160);
        set_skill("literate",160);
        set_skill("huashan-jianfa", 160);
        set_skill("huashan-shenfa", 160);
        set_skill("zixia-gong",160);
	set_skill("ziyin-yin", 170);
	set_skill("zhengqi-jue", 170);

        map_skill("dodge", "huashan-shenfa");
	map_skill("cuff", "poyu-quan");
        map_skill("force","zixia-gong");
        map_skill("sword","huashan-jianfa");
        map_skill("parry","huashan-jianfa");
        prepare_skill("cuff", "poyu-quan");
        create_family("华山派",13,"弟子");

       setup();
       carry_object("/clone/weapon/changjian")->wield();
	carry_object("/clone/misc/cloth")->wear();
        
}
void attempt_apprentice(object ob)
{
	if( (string)ob->query("gender") != "女性" )
	{
		command ("say 对不起，我只收女弟子。");
		return;
	}
	if( (string)ob->query("class") == "bonze" )
	{	command ("say 对不起，我不收出家之人。");
		return;
	}

        command("say 咦，不错的小女孩嘛，我就收下你了。");
        command("recruit " + ob->query("id"));
        ob->set("title","华山派第十四代弟子");
}
