// tongshou.c 天地同寿
// by shifei
 
#include <ansi.h>

inherit F_SSERVER;

int perform(object me, object target)
{
        int damage,ap,dp;
        string msg;
        
        if( !target ) target = offensive_target(me);
                        
        if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail(""HIR"「天地同寿」"NOR"只能对战斗中的对手使用。\n");
                        
        if( objectp(me->query_temp("weapon")) )
                return notify_fail("你必须空手才能使用"HIR"「天地同寿」"NOR"");
                
        if( (int)me->query_skill("taiji-quan",1) < 150 )
                return notify_fail("你的太极拳不够娴熟，不会使用"HIR"「天地同寿」"NOR"。\n");
        
        if( (int)me->query_skill("yinyun-ziqi", 1) < 150 )
                return notify_fail("你的氤氲紫气不够高，不能用来反震伤敌。\n");
                           
        if((int)me->query("max_neili") < 1000 )
                return notify_fail("这是拼命呀！你那点内力怎么能拚呀！\n");

        if((int)me->query("neili") < 1200 )
                return notify_fail("这是拼命呀！你那点内力怎么能拚呀！\n");

        if((int)me->query("jing") < 200 )
                return notify_fail("精神都没有还想拼命！真不知死活！！\n");
                
   msg = HIC"\n$N银牙紧咬，运足精神，大吼一声，使出了"HIR"「天地同寿」"NOR""HIC"的拼命招式！"NOR"\n"NOR;
           if( !target->is_killing(me) ) target->kill_ob(me);
           
           ap =me->query_skill("force");
           ap = ( ap * ap * ap / (3 * 400) ) * (int)me->query("neili");
           ap += (int)me->query("combat_exp");
           dp = target->query("combat_exp");
           if( random(ap + dp) > dp ) {
                   damage = (int)me->query("max_neili") / 8 +
random((int)me->query("eff_neili") / 4);
                damage -= (int)target->query("max_neili") / 10 +
random((int)target->query("eff_neili") / 5);      
     damage+=(int)me->query("neili_factor")-random((int)target->query("neili_factor"));
                if( damage > 0 ) {
     msg += HIC "结果打了个正着，差点没把$n打扁！\n" NOR;
     damage +=random((damage*(int)me->query_skill("force"))/70);
                        target->receive_damage("qi", damage, me);
                        target->receive_wound("qi", damage/3, me);
                        target->receive_damage("jing", damage, me);
                        target->receive_wound("jing", damage/4, me);
                        me->improve_skill("taiji-quan", 1, 1);
                }
       else {

     msg += HIC "结果$N被$n的内力反激，反而$N被$n的内力振伤了！\n" NOR;
     damage -= (int)target->query("neili_factor");
     damage -=random((-damage*(int)target->query_skill("force"))/120);
                        me->receive_damage("qi", -damage, target);
                        me->receive_wound("qi", -damage/3, target);
                        me->receive_damage("jing", -damage, target);
                        me->receive_wound("jing", -damage/4, target);
                        me->improve_skill("taiji-quan", 1, 1);
       }
             } 
   else
                msg += HIC "但是被$n躲开了。\n" NOR;

        message_vision(msg, me, target);
        if( damage > 0 ) COMBAT_D->report_status(target);
        else if( damage < 0 ) COMBAT_D->report_status(me);  

        me->start_busy(1+random(5));
        return 1;
}




    

  

       
