#include <ansi.h>
#include "/kungfu/skill/eff_msg.h"

inherit F_SSERVER;

int perform(object me, object target) {
  string msg;
  object wep;
  int damage, skill, i;
  if (!target) target = offensive_target(me);
  wep = me->query_temp("weapon");
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("幻剑式只能对战斗中的对手使用。\n");

  if ((int)me->query_skill("taiji-jian", 1) < 120)
    return notify_fail("你的太极剑法不到家，还不能使用幻剑决。\n");
  if ((int)me->query_skill("sword", 1) < 101)
    return notify_fail("你基本剑法还不到家，怎能使用幻剑决？\n");
  if ((int)me->query("neili") < 1000)
    return notify_fail("你内力现在不够, 不能使用幻剑决！! \n");
  message_vision(CYN "$N长笑一声，口中背着太极剑决，运起幻剑绝式，身形陡然加快！\n" NOR, me, target, wep);
  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 4) {
    skill = me->query_skill("taiji-jian");
    i = skill / 30;
    if (i > 5)
      i = 5;
    damage = skill * 3;
    message_vision(RED "$n眼前一花，$N分化为四条人影各以不同招式绵绵袭来！\n" NOR, me, target);
    me->add("neili", -150);
    target->receive_damage("qi", damage * 3 / 2);
    target->receive_wound("qi", damage);
    me->add_temp("apply/attack", skill / 3);
    me->add_temp("apply/dexerity", skill / 10);
    me->add_temp("apply/dodge", skill / 5);
    me->set_temp("taiji", 1);
    for (i = 1; i < 5; i++) {
      me->set_temp("taiji", i);
      COMBAT_D->do_attack(me, target, wep, 1);
    }
    me->delete_temp("taiji");
    me->add_temp("apply/attack", -(skill / 3));
    me->add_temp("apply/dexerity", -(skill / 10));
    me->add_temp("apply/dodge", -(skill / 5));
  } else {
    message_vision("可是$p看破了$P的企图，并没有上当。\n" NOR, me, target);
    me->start_busy(2);
    me->add("neili", -150);
  }
  return 1;
}
