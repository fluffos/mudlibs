// lian.c 太极剑法「连」字诀

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>


inherit F_SSERVER;

int perform(object me, object target)
{
        object weapon;
                 string msg;
        int i, attack_time;

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招"HIW"「借力打力」"NOR"？\n");

        if(!me->is_fighting())
                return notify_fail(""HIW"「借力打力」"NOR"只能在战斗中使用！\n");
    if( (int)me->query_temp("inpfm") )              
                return notify_fail(HIW"你刚刚用完绝招，内息还未调匀！\n"NOR); 

        if((int)me->query("max_neili") < 1000 )
                return notify_fail("你的内力不够！\n");

   if((int)me->query("neili") < 1000 )
     return notify_fail("你的内力不足！\n");

        if((int)me->query("max_jingli") < 800 )
                return notify_fail("你的精力不足，没法子施用外功！\n");
        if((int)me->query("jingli") < 400 )
                return notify_fail("你的精力不足，没法子施用外功！\n");  
        if((int)me->query_skill("taiji-jian", 1) < 200)
                return notify_fail("你的太极剑级别还不够，连基本的都耍不完全，怎么玩必杀？\n");
        if((int)me->query_skill("yinyun-ziqi", 1) < 200)
                return notify_fail("你的氤氲紫气级别还不够，连基本的都耍不完全，怎么玩必杀？\n");
        if((int)me->query_skill("taiji-quan", 1) < 200)
                return notify_fail("你的太极拳级别还不够，无法融会这一招!\n");
                 msg = HIC "$N使出太级剑法的借力打力之决，画出无数个圆圈，将$n的攻击悉数引向自己身上。\n"NOR;

        if( random(me->query("combat_exp")) > (int)target->query("combat_exp")*40/100)
        {
                attack_time = (int)me->query_skill("taiji-jian", 1) / 30;
                if(attack_time < 1)
                        attack_time = 4;
                if(attack_time > 10)
                        attack_time = 12;

                msg += CYN " 结果$n的招数被你的剑圈悉数引向自己！\n" NOR;
                message_vision(msg, me, target);
                for(i = 0; i < attack_time; i++)
                        COMBAT_D->do_attack(target, target, target->query_temp("weapon"), 0);

//                me->start_busy(3);
                me->add("neili", - attack_time*50);
                me->add("jingli", - 100);
               //一定要有，这个是还原的定时器。    

        }
        else
        {
                msg += "$n强用心神，终于控制住自己。但是也被圈得头昏脑涨！\n" NOR;
                message_vision(msg, me, target);
                target->start_busy(3);
                me->add("neili", -200); 
                       }
        if(!target->is_fighting(me)) target->fight_ob(me);
        return 1;
}




