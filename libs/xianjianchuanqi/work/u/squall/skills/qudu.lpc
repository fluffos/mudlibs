// qudu.c 「纯阳无极功」
// Write by cht 1999/9/

#include <ansi.h>

mapping pname = ([
  "snake_poison": "蛇毒",
  "xx_poison": "星宿掌毒",
  "dsy_poison": "密宗大手印掌毒",
  "fs_poison": "腐尸毒",
  "huagu_poison": "化骨棉掌剧毒",
  "man_poison": "蔓陀萝花毒",
  "qinghua_poison": "情花毒",
  "qishang_poison": "七伤拳毒",
  "qzhu_poison": "千蛛万毒手毒",
  "sl_poison": "神龙毒",
  "sy_poison": "大手印掌毒",
  "warm_poison": "热毒",
  "hot_poison": "火毒",
  "cold_poison": "寒毒",
  "bing_poison": "冰魄银针毒",
  "hb_poison": "寒冰绵掌毒",
  "bt_poison": "怪蛇毒",
]);

mapping cname = ([
  "" BLU "": "湛蓝之气",
  "" HIB "": "黑气",
  "" HIR "": "潮红之气",
  "" RED "": "红色",
  "" HIG "": "绿气",
  "" GRN "": "青气",
  "" YEL "": "黄色",
  "" CYN "": "天青色",
  "" MAG "": "紫气",
  "" WHT "": "白气",
]);

int exert(object me, object target) {
  string msg, poison, pc;
  int i, yyzq_lvl, poi_lvl, neili_cost, yyzq_reg;
  object *inv, myarmor, urarmor;
  object where;
  mixed a;
  mixed b;

  a = ({
    "snake_poison",
    "xx_poison",
    "dsy_poison",
    "fs_poison",
    "huagu_poison",
    "man_poison",
    "qinghua_poison",
    "qishang_poison",
    "qzhu_poison",
    "sl_poison",
    "sy_poison",
    "warm_poison",
    "hot_poison",
    "cold_poison",
    "bing_poison",
    "hb_poison",
    "bt_poison"
  });
  b = ({
    "" HIB "",
    "" HIB "",
    "" CYN "",
    "" HIG "",
    "" BLU "",
    "" HIB "",
    "" MAG "",
    "" HIR "",
    "" HIR "",
    "" BLU "",
    "" HIR "",
    "" RED "",
    "" HIR "",
    "" HIG "",
    "" HIB "",
    "" HIB "",
    "" YEL ""
  });
  where = environment(me);
  yyzq_lvl = (int)me->query_skill("yinyun-ziqi", 1);

  if (!present(target, where))
    return notify_fail("你要给谁疗毒？\n");

  if (me->is_fighting())
    return notify_fail("你无法在战斗中运功疗毒。\n");

  if ((int)me->query_skill("medicine", 1) < 80)
    return notify_fail("你还得多学点草木药理。\n");

  if (!target || target == me) {
    for (i = 0; i < sizeof(a); i++)
      if (me->query_condition(a[i]) > 0) {
        poison = a[i];
        pc = b[i];
        break;
      }

    poi_lvl = me->query_condition(poison);

    if (poi_lvl == 0)
      return notify_fail("你并未中毒。\n");

    neili_cost = poi_lvl * 5;
    yyzq_reg = 160 + poi_lvl / 2;

    if ((int)me->query("neili") < neili_cost)
      return notify_fail("你现在的真气不足" NOR "。\n");

    if (yyzq_lvl < yyzq_reg)
      return notify_fail("你的" MAG "「氤氲紫气」" NOR "修为还不能化掉" + pc + pname[poison] + NOR "。\n");

    me->set("jiali", 0);
    message_vision(
      "$N坐在一旁，慢慢以真气通走三关，鼓荡丹田中的" MAG "「氤氲紫气」" NOR "，将体内的" + pc + pname[poison] + NOR "一丝丝的化掉。\n", me);

    me->start_busy(10);
    call_out("huadu", poi_lvl / 30 + 2, me, poison, pc, yyzq_lvl, poi_lvl, neili_cost);

    return 1;
  } else {
    if (me->query("gender") != "男性")
      return notify_fail("你只能运用" MAG "「氤氲紫气」" NOR "为自己化毒。\n");

    if (!target->is_character())
      return notify_fail("为" + target->name() + "疗毒？\n");

    if (target->query("gender") == "女性") {
      if (target->is_spouse_of(me)) {
        inv = all_inventory(environment(me));
        for (i = 0; i < sizeof(inv); i++)
          if ((string)inv[i]->query("race") == "人类"
            && inv[i] != me && !me->is_spouse_of(inv[i]))
            return notify_fail("众目睽睽之下脱光衣裳，你也不替你妻子想想？\n");
      } else
        return notify_fail("男女授受不亲，武当弟子行走江湖，於女色上人人律己严谨。\n");
    }

    for (i = 0; i < sizeof(a); i++)
      if (me->query_condition(a[i]) > 0) {
        poison = a[i];
        pc = b[i];
        return notify_fail("你已身中" + pc + pname[poison] + NOR "，恐会散及" + target->name() + "。\n");
      }

    for (i = 0; i < sizeof(a); i++)
      if (target->query_condition(a[i]) > 0) {
        poison = a[i];
        pc = b[i];
        break;
      }

    poi_lvl = target->query_condition(poison);

    if (poi_lvl == 0)
      return notify_fail(target->name() + "并未中毒。\n");

    if (target->is_fighting())
      return notify_fail(target->name() + "正在战斗中，你无法为其疗毒。\n");

    if (target->is_busy())
      return notify_fail(target->name() + "正忙着呢，你无法为其疗毒。\n");

    neili_cost = poi_lvl * 5;
    yyzq_reg = 160 + poi_lvl / 2;

    if (yyzq_lvl < yyzq_reg)
      return notify_fail("你的" HIY "「纯阳无极功」" NOR "修为还不能为"
        +target->name() + "吸取" + pc + pname[poison] + NOR "。\n");

    me->set("jiali", 0);
    myarmor = me->query_temp("armor/cloth");
    urarmor = target->query_temp("armor/cloth");

    if (objectp(myarmor) && objectp(urarmor)) {
      msg = "    $N手指连伸，点了$n身上" + chinese_number((poi_lvl / 100) + 3) + "处大穴。$p穴道被点，登时不再颤抖，脸上" + pc + cname[pc] + NOR "却愈来愈浓。\n"
        "$N当下除去$n身上" + urarmor->name() + "，自己也解开" + myarmor->name() + "，胸膛和$p的背心相贴。以" HIY "「纯阳无极功」" NOR "吸\n"
        "取$n身上的" + pc + pname[poison] + NOR "。\n\n";
      myarmor->unequip();
      urarmor->unequip();
    }

    else

    if (objectp(myarmor) && !objectp(urarmor)) {
      msg = "    $N手指连伸，点了$n身上" + chinese_number((poi_lvl / 100) + 3) + "处大穴。$p穴道被点，登时不再颤抖，脸上" + pc + cname[pc] + NOR "却愈来愈浓。\n"
        "$N当下解开" + myarmor->name() + "，胸膛和$p的背心相贴。以" HIY "「纯阳无极功」" NOR "吸取$n身上的" + pc + pname[poison] + NOR "。\n\n";
      myarmor->unequip();
    }

    else

    if (!objectp(myarmor) && objectp(urarmor)) {
      urarmor->unequip();
      msg = "    $N手指连伸，点了$n身上" + chinese_number((poi_lvl / 100) + 3) + "处大穴。$p穴道被点，登时不再颤抖，脸上" + pc + cname[pc] + NOR "却愈来愈\n"
        "浓。$N当下除去$n身上" + urarmor->name() + "，胸膛和$p的背心相贴。以" HIY "「纯阳无极功」" NOR "吸取$n身上的\n" + pc + pname[poison] + NOR "。\n\n";
    }

    else

      msg = "    $N手指连伸，点了$n身上" + chinese_number((poi_lvl / 100) + 3) + "处大穴。$p穴道被点，登时不再颤抖，脸上" + pc + cname[pc] + NOR "却愈来愈浓。\n"
        "$N当下胸膛和$p的背心相贴。以" HIY "「纯阳无极功」" NOR "吸取$n身上的" + pc + pname[poison] + NOR "。\n\n";


    message_vision(msg, me, target);

    me->start_busy(poi_lvl / 30);
    target->start_busy(poi_lvl / 30);

    if ((int)me->query("neili") < neili_cost)
      call_out("selfhurt", 1, me, target, neili_cost);
    else
      call_out("xidu", poi_lvl / 30 + 2, me, target, poison, pc, yyzq_lvl, poi_lvl, neili_cost);

    return 1;
  }
}


int huadu(object me, string poison, string pc, int yyzq_lvl, int poi_lvl, int neili_cost) {
  int poi_amount, cure_amount, cure;

  if (!me || me->is_ghost() || !living(me))
    return 0;

  poi_amount = (int)me->query_condition(poison, 1);
  cure_amount = yyzq_lvl;
  cure = yyzq_lvl / 10;

  me->add("neili", -neili_cost);

  if (poi_amount > cure_amount) {
    write("你体内" + pc + pname[poison] + NOR "太深，现在无法化除。\n");
    return 0;
  }

  write("\n你将内力循环一周，身子如灌甘露，丹田里的真气似香烟缭绕，悠游自在。\n");

  //        me->add("max_neili", -random(2));
  if (poi_amount < cure)
    me->apply_condition(poison, 0);
  else
    me->apply_condition(poison, poi_amount - cure);

  return 1;
}

int xidu(
  object me,
  object target,
  string poison,
  string pc,
  int yyzq_lvl,
  int poi_lvl,
  int neili_cost
) {
  int my_poi, ur_poi, cure_amount, cure;

  if (!me || me->is_ghost() || !living(me) || !target || target->is_ghost())
    return 0;

  my_poi = (int)me->query_condition(poison, 1);
  ur_poi = (int)target->query_condition(poison, 1);

  cure_amount = yyzq_lvl;
  cure = yyzq_lvl / 10;

  me->add("neili", -neili_cost);
  //        me->add("max_neili",-random(2));

  if (ur_poi > cure_amount) {
    write(target->name() + "身上的所中的" + pc + pname[poison] + NOR "太深了你现在还吸不出来。\n");
    return 0;
  } else {
    message_vision("\n过了约莫半个时辰，只见$N脸上隐隐现出" + pc + cname[pc] + NOR "，手指微微颤动。\n", me);

    if (ur_poi < cure) {
      me->apply_condition(poison, my_poi + ur_poi);
      target->apply_condition(poison, 0);
    } else {
      me->apply_condition(poison, my_poi + cure);
      target->apply_condition(poison, ur_poi - cure);
    }
  }
  return 1;
}

int selfhurt(object me, object target, int neili_cost) {
  if (!me || me->is_ghost() || !living(me) || !target || target->is_ghost())
    return 0;

  message_vision(HIW "$N将$n一抱入怀，立时大叫一声，全身打颤。\n" NOR, me, target);

  if (me->query("neili") < neili_cost / 2) {
    me->set("neili", 0);
    me->receive_damage("qi", (int)me->query("qi") + 1, "毒气攻心死了");
    return 1;
  }

  else {
    me->add("neili", -(neili_cost / 2));
    me->receive_damage("qi", neili_cost, "毒气攻心死了");
    me->receive_wound("qi", neili_cost / 5, "毒气攻心死了");
    return 1;
  }

}
