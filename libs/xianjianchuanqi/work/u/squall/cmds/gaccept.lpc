// by tiantian(www.wangcf.com) 2001.4
// 接受某人入帮

#include <ansi.h>
#include <group.h>

int main(object me, string arg) {
  object ob;
  string group_file, str;

  seteuid(getuid(me));

  if (!me->query("group"))
    return notify_fail("你并没有加入任何帮派。\n");

  if (me->query("group/level") < GROUP_MINISTER)
    return notify_fail("你在帮派中的级别太低了，没有权力发展新成员。\n");

  if (!arg)
    return notify_fail("指令格式：gaccept <对象>\n");

  if (!(ob = present(arg, environment(me))))
    return notify_fail("这里没有这个人？\n");

  if (!objectp(ob) || !userp(ob))
    return notify_fail("这里没有这个人？\n");

  if (ob == me)
    return notify_fail("收自己当帮众？好主意....不过没有用。\n");

  if ((object)ob->query_temp("join") == me) {
    if (!living(ob))
      return notify_fail("你必须先把对方弄醒再说。\n");

    message_vision("$N决定收$n当帮众。\n\n", me, ob);

    ob->delete_temp("join");

    write("恭喜你新收了一位帮众！\n");
    tell_object(ob, sprintf("恭喜您成为%s的帮众。\n", to_chinese(me->query("group/group"))));
    ob->set("group/group", me->query("group/group"));
    ob->set("group/level", GROUP_DISCIPLE);
    ob->set("group/title", HIW ""
      +to_chinese(ob->query("group/group"))
      +HIW "" HIR
      +GROUP_D->query_rank(ob)
      +HIR "" NOR);
    ob->set("group/old_title", ob->query("title"));
    ob->set("title", ob->query("group/title"));
    ob->save();

    group_file = GROUP_D->query_home(me);
    load_object(group_file)->add("people", 1);
    str = HIR "我，" + ob->query("name") + "，即日起决定效忠于"
      +to_chinese(ob->query("group/group")) + "。" NOR;
    CHANNEL_D->do_channel(ob, "chat", sprintf("%s", str));

    GROUP_D->save_group(me);
    return 1;
  } else {
    return notify_fail("对方并没有向你提出申请。\n");
  }
}

int help(object me) {
  write(@HELP
指令格式 : gaccept <对象>
 
这个指令能让你收某人入帮。

相关指令：gjoin
 
HELP
  );
  return 1;
}
