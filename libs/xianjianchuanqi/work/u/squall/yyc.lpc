// Room: /d/emei/xixiangchi.c

inherit ROOM;
#include <ansi.h>
#include <command.h>
string look_chi();

void create()
{
        set("short",HIW "游泳池" NOR);
        set("long", @LONG
描述待定。
LONG
        );
        set("outdoors", "花园");
        set("item_desc",([            
            "chi" : (: look_chi :),
        ]));
        set("exits", ([ 
           "south" :  "/u/squall/room5",
          ]));


        setup();
}

void init()
{
        add_action("do_jump", "tiao");
}

int do_jump(string arg)
{
        int i, j;
        object me, room, *ob, *inv;
        me = this_player();
        if (!(room = find_object("/u/squall/chi")))
              room = load_object("/u/squall/chi");
        ob = all_inventory(room);
        j = sizeof(ob);

     if(!living(me) ) return 0;

     if( !arg || arg == "" || arg != "chi" )
        return notify_fail("你要干什么？\n");
        
     if((me->query_encumbrance()*20) > me->query_max_encumbrance())
        return notify_fail("带这么多东西好象不是要游泳而是想自杀吧！\n");

     inv = all_inventory(me);
       for (i = 0; i < sizeof(inv); i++){
               if(!inv[i]->query("no_drop"))
                  DROP_CMD->do_drop(me, inv[i]);
               else if(inv[i]->query("equipped"))
                   inv[i]->unequip();
               else
                  tell_object(me, "你将"+inv[i]->name()+"放在池边的太阳椅上。\n");               
                }

        tell_object(me, HIG "你走到游泳池边，脱下全身衣物，裸体跳了进去。\n"NOR);
        tell_room(environment(me), me->name()+"走到游泳池边，准备跳进池里游水去。\n", ({ me }));
       
                   me->move("/u/squall/chi");

    return 1;
}

string look_chi()
{
    object me, room;
    me = this_player();
    if (!(room = find_object("/u/squall/chi")))
          room = load_object("/u/squall/chi");

    message_vision("$N站在游泳池边，往池里望去。\n", me);
    "/cmds/std/look.lpc"->look_room(this_player(), room);
    return "";
}
