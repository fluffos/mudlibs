 // Npc: /kungfu/class/shaolin/xuan-ci.c
// Date: blade 2001/02/08

inherit NPC;
#include <ansi.h>
inherit F_MASTER;
void greeting(object ob);
int ask_me();
int ask_ok();


void create()
{
        set_name("清难比丘", ({
                "qingnan biqiu",
                "qingnan",
                "biqiu",
        }));
        set("long",
                "。\n"
                "他身材略显佝偻，但却满面红光，目蕴慈笑，显得神完气足。\n"
        );


        set("nickname", "少林寺迎客僧");
        set("gender", "男性");
        set("attitude", "friendly");
        set("class", "bonze");

        set("age", 70);
        set("shen_type", 1);
        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);
        set("inquiry", ([
                "挑战" : (: ask_me :),                 
                "完成" : (: ask_ok:), 
               ]));
        set("max_qi", 1500);
        set("max_jing", 1000);
        set("neili", 2000);
        set("max_neili", 2000);
        set("jiali", 150);
        set("combat_exp", 1000000);
        set("score", 500000);

        set_skill("force", 110);
        set_skill("hunyuan-yiqi", 110);
        set_skill("dodge", 110);
        set_skill("shaolin-shenfa", 110);
        set_skill("finger", 110);
        set_skill("strike", 110);
        set_skill("hand", 110);
        set_skill("claw", 110);
        set_skill("parry", 110);
        set_skill("nianhua-zhi", 110);
        set_skill("sanhua-zhang", 110);
        set_skill("fengyun-shou", 110);
        set_skill("longzhua-gong", 110);
        set_skill("buddhism", 110);
        set_skill("literate", 110);

        map_skill("force", "hunyuan-yiqi");
        map_skill("dodge", "shaolin-shenfa");
        map_skill("finger", "nianhua-zhi");
        map_skill("strike", "sanhua-zhang");
        map_skill("hand", "fengyun-shou");
        map_skill("claw", "longzhua-gong");
        map_skill("parry", "nianhua-zhi");

        prepare_skill("finger", "nianhua-zhi");
        prepare_skill("strike", "sanhua-zhang");

        create_family("少林派", 40, "弟子");

        setup();

        carry_object("/d/shaolin/obj/xuan-cloth")->wear();
}


int ask_me()
{
         mapping me_hp;
        object me,ob,npc;
        me=this_player();
        ob=this_object();
   me_hp = me->query_entire_dbase();
        if(me->query("combat_exp")< 500000){
        command("say 施主的功力似乎不够啊,刀剑无眼，恐伤了和气!");
        return 1;}
        if(me->query_condition("over_tiao")){
        command("say 施主不是刚才才去过了吗？!");
        return 1;}
         if(ob->query_condition("over_tiao")){
        command("say 刚才有人已经挑战过本寺高手了，施主请呆会再来吧!");     
        if(ob->query_temp("in_tiao")){
        command("say 现在有人正在挑战本寺高手，施主请呆会再来吧!");
        return 1;}
        if(me->query_condition("in_tiao")){
        command("say 施主不是已经去了吗？!");
        return 1;}
        npc = new("/jobsys/tianhan_job/sldizi");
        npc->set("max_qi",              me_hp["max_qi"]* 7 / 3);
        npc->set("eff_qi",              me_hp["max_qi"]* 7 / 3);
npc->set("qi",                  me_hp["max_qi"]* 7 / 3);
        npc->set("max_jing",    me_hp["max_jing"]* 4 / 3);
        npc->set("jing",    me_hp["max_jing"]* 4 / 3);
 npc->set("eff_jing",    me_hp["max_jing"]* 4 / 3);
npc->set("eff_jingli",  me_hp["max_jingli"]* 4 / 3);
        npc->set("max_jingli",  me_hp["max_jingli"]* 4 / 3);
npc->set("jingli",              me_hp["max_jingli"]* 4 / 3);
        npc->set("max_neili",   me_hp["max_neili"]* 4 / 3);
        npc->set("neili",               me_hp["max_neili"] * 4 / 3);

        npc->set("jiali", 120);
        npc->set("combat_exp",  me->query("combat_exp")*150/100);
        npc->set_skill("force",me->query_skill("force",1)+ random(5));
        npc->set_skill("dodge", me->query_skill("force",1)+ random(5));
        npc->set_skill("unarmed", me->query_skill("force",1)+ random(5));
        npc->set_skill("parry", me->query_skill("force",1)+ random(5));
        npc->set_skill("blade", me->query_skill("force",1)+ random(5));             
        npc->set_skill("yijin-jing",me->query_skill("force",1)+ random(5));
        npc->set_skill("longzhua-gong", me->query_skill("force",1)+ random(5));
        npc->set_skill("damo-jian", me->query_skill("force",1)+ random(5));
        npc->set_skill("riyue-bian", me->query_skill("force",1)+ random(5));
        npc->set_skill("hunyuan-yiqi", me->query_skill("force",1)+ random(5)); 
        npc->set_skill("claw",me->query_skill("force",1)+ random(5));
        npc->set_skill("shaolin-shenfa", me->query_skill("force",1)+ random(5));
        npc->set_skill("whip", me->query_skill("force",1)+ random(5));
        npc->set_skill("wuchang-zhang", me->query_skill("force",1)+ random(5));
        npc->set_skill("club", me->query_skill("force",1)+ random(5));
        npc->set_skill("sword", me->query_skill("force",1)+ random(5)); 
        npc->set_skill("cibei-dao", me->query_skill("force",1)+ random(5)); 
       npc->map_skill("blade", "cibei-dao");
       npc->map_skill("claw", "longzhua-gong");
       npc->map_skill("unarmed", "longzhua-gong");                        
       npc->map_skill("club", "wuchang-zhang");
       npc->map_skill("dodge", "shaolin-shenfa");
       npc->map_skill("force", "yijin-jing");
       npc->map_skill("parry", "longzhua-gong");
       npc->map_skill("sword", "damo-jian");
       npc->map_skill("whip", "riyue-bian");
        npc->move("/d/shaolin/yanwutang");
        
        command("say 施主看来是想和本寺高手切磋一番啊.");
        command("say 这位"+me->query("name")+"施主,请随小僧来.");
        command("chat 今日"+me->query("name")+"施主挑战本寺，特广告天下以视公正!");                      me->move("/d/shaolin/yanwutang");
        ob->set_temp("in_tiao",1);
        ob->apply_condition("over_tiao",60);
        me->apply_condition("in_tiao",60);  
       return 1;
}

int ask_ok(object me, object ob)
{
       int kar, exp, pot,exp_reward,rate;
        rate = 100*2;
        if (rate>100) rate=100;
        exp = me->query("combat_exp");
        if(exp<800000) exp_reward=400;
        else if(exp<1000000) exp_reward=550;
        else exp_reward=650;
        exp = exp_reward*rate/100;
        exp = exp + random(exp/10);
        pot = exp/2;
     
        if(me->query_temp("win_tiao")){
        command("say 施主武艺高强，又兼心地仁慈，手下留情，本寺上下无不感谢!");
        command("chat 今日"+me->query("name")+"施主战胜本寺高手，心地仁慈，手下留情，本寺上下无不感谢!"); 
        ob->set_temp("in_tiao",0);
        me->apply_condition("over_tiao",30);  
        me->apply_condition("in_tiao",0);  
        ob->apply_condition("over_tiao",30);
        me->set_temp("win_tiao",0);
        message_vision(HIC "\n由于$N成功的战胜了少林寺的高手，被奖励：\n"
                + chinese_number(exp) + "点实战经验，\n"
                + chinese_number(pot) + "点潜能.\n"NOR, me);
                me->add("combat_exp", exp);
                me->add("potential", pot);
}
       if(me->query_temp("lose_tiao")){
      command("say 施主武艺虽现在有所不及，但他日必须为武林翘楚!");
        command("say "小僧恕不远送"); 
        me->set_temp("lose_tiao",0);
        me->apply_condition("over_tiao",300);  
        me->apply_condition("in_tiao",0);  
        ob->apply_condition("over_tiao",30);
        message_vision(HIC "\n少林还是很不错的哦！$N被奖励了：\n"
                + chinese_number(exp/15) + "点实战经验，\n"
                + chinese_number(pot/15) + "点潜能.\n"NOR, me);
                me->add("combat_exp", exp/15);
                me->add("potential", pot/15);
} 
        else{
          command("say ？？？？？？？!");
}
}
