// jiche jian 机车剑

#include <weapon.h>
#include <ansi.h>

inherit SWORD;
inherit F_UNIQUE;

void create()
{
        set_name( HIY"机车剑"NOR,({ "jiche jian", "jiche", "jian", "sword"}) );
        set_weight(70000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("value", 10);
                set("unique", 1);
                set("rigidity", 20);
                set("sharpness", 1);
                set("material", "steel");
                set("weapon_prop/parry", 5);
                set("weapon_prop/dodge", -12);
                set("wield_neili", 1500);
                set("wield_maxneili", 0);
                set("wield_str", 20);
                set("wield_msg", HIY"$N嗡的一声从背后抽出机车剑，但见杀气逼人，弥漫四方，
方圆之内轰然雷声滚滚，肃杀万分。\n"NOR);
                set("long", "此剑长七尺，黝黑黝黑由机车破铁所铸，无锋无刃，
却杀气森然，实乃天下第一神兵。\n");                
                set("unwield_msg", BLU "$N将机车插回身后，杀气顿减。\n" NOR);               
        }
        init_sword(170);
        setup();
}
