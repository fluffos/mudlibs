// hunting-ground1.c
// create by yixian

#include <ansi.h>
inherit ROOM;

void create()
{
        set("short",HIY"狩猎场"NOR);
        set("long","这是一个废弃的采石场;现在已经草木从深，野兽出没……\n");
        set("exits",([
                "east" : __DIR__"hunting-ground"+random(3)+1,
                "west" : __DIR__"hunting-ground"+random(3)+1,
                ]));
        setup();
}

void init()
{
        object ob;
        ob=this_player();
        
        if( interactive(ob) && ob->query("combat_exp")<500000 && ob->query_temp("hunting") && !ob->query_condition("hunting_object") && !ob->query_condition("hunting_busy") ) 
                ob->apply_condition("hunting_object",random(int));
                
}
