// 保存总舵文件
int save_group( object me )
{
	if( !me ) return 0;
	if( !me->query("group") ) {
		error( "group daemons file: save group.\n" );
		return 1;
	}

	return save_room( me, query_home( me ) );
}

// 保存帮派房间指定文件
int save_room( object me, string file )
{
	object room;
    string str, *name;
    mapping prop;
    int i;

	if( !me ) return 0;
	if( !me->query("group") ) {
		error( "group daemons file: save group.\n" );
		return 0;
	}

	room = load_object( file );
	if( !room ) {
		error( "group daemons file: save room.\n" );
		return 1;
	}

    str = "// Room: " + file + " / " + me->query( "group/group" ) + @ROOM_CODE

#include <ansi.h>
inherit ROOM;

void create()
{
ROOM_CODE
        ;
    str += sprintf("\tset(\"short\", %O);\n", room->query( "short" ) );
    str += sprintf("\tset(\"long\", @LONG\n%sLONG\n\t);\n", room->query("long") );
    prop = room->query_entire_dbase();
    name = keys(prop);
    for(i=0; i<sizeof(name); i++) 
    {
	    if( member_array(name[i], special_props) != -1 ) continue;
        str += sprintf("\tset(\"%s\", %O);\n", name[i], prop[name[i]] );
    }
    str += "\n\tsetup();\n\treplace_program(ROOM);\n}\n";

    rm(file);
	if ( write_file(file, str, 1) ) {
	    return 1;
	}
	else {
	    tell_object (me,"Mudos 尝试写入(" + file + ")失败!!\n");
		return 0;
	}
}

// 查找帮派的类型是否合法
int query_type_index( string name )
{
	int i;
	
	if( !name || strlen(name) < 2 )
		return -1;
		
	for( i = 0; i < sizeof( group_type ); i ++ ) {
		if( ! strcmp( name[strlen(name)-2..strlen(name)-1], group_type[i] ) )
			return i;
	}
	
	return -1;
}

// 返回所有帮派类型
string * query_all_group_type()
{
	return group_type;
}

// 返回帮派的目录
string query_cwd( object ob )
{
	if( !ob || !ob->query("group") ) {
		error( "group daemons error.\n" );
		return 0;
	}
	return GROUP_DIR + ob->query("group/group") + "/";
}

// 返回帮派的总舵的文件名
string query_home( object ob )
{
	if( !ob || !ob->query("group") ) {
		error( "group daemons error.\n" );
		return 0;
	}

	return GROUP_DIR + ob->query("group/group") + "/group.lpc";
}

// 返回玩家在帮派中的rank
string query_rank( object ob )
{
	if( !ob || !ob->query("group") ) {
		error( "group daemons error.\n" );
		return 0;
	}
		
	return group_rank[ query_type_index( to_chinese( ob->query( "group/group" ) ) )
		+ ob->query("group/level") * GROUP_TYPE_NUM ];
}

// 检查帮派名称是否合法
int is_banned( string name )
{
	int j;
	
    for( j = 0; j < sizeof( banned_name ); j++ ) {
        if( strsrch( name, banned_name[j] ) >= 0 ) {
            return 1;
        }
    }
    
    return 0;
}

// 替换颜色串
string replace_color( string str )
{
	str = replace_string(str, "$BLK$", BLK);
	str = replace_string(str, "$RED$", RED);
	str = replace_string(str, "$GRN$", GRN);
	str = replace_string(str, "$YEL$", YEL);
	str = replace_string(str, "$BLU$", BLU);
	str = replace_string(str, "$MAG$", MAG);
	str = replace_string(str, "$CYN$", CYN);
	str = replace_string(str, "$WHT$", WHT);
	str = replace_string(str, "$HIR$", HIR);
	str = replace_string(str, "$HIG$", HIG);
	str = replace_string(str, "$HIY$", HIY);
	str = replace_string(str, "$HIB$", HIB);
	str = replace_string(str, "$HIM$", HIM);
	str = replace_string(str, "$HIC$", HIC);
	str = replace_string(str, "$HIW$", HIW);
	str = replace_string(str, "$NOR$", NOR);

	return str;
}