mapping valid_login = ([
        "bbb":          ({ "202.100.193.", "202.100.208." }),
        "cool":         ({ "210.74.17" }),
        "dubei":        ({ "202.99.5", "210.74.17" }),
        "jpei":         ({ "202.100.193.", "202.100.208." }),
        "lover":        ({ "127.0.0." }),
        "goddess":      ({ "127.0.0." }),
        "killall":      ({ "202.100.193.", "202.100.208." }),
        "look":         ({ "202.96.84." }),
        "qingyun":      ({ "202.96.143." }),
//        "snowman":      ({ "194.233.128.", "%*s.nuernberg.netsurf.de" }),
        "yuj":          ({ "202.100.193.", "202.100.208.", "%*s.hk.hi.cn" }),
]);

int is_valid(string id, string ip)
{
        int i;

        if (ip == "127.0.0.1" || ip == "localhost")
                if (wiz_level(id)) return 1;
                else if(id == "zen") return 1;
                else return 0;
        if (undefinedp(valid_login[id])) return 1;
        i = sizeof(valid_login[id]);
        while (i--) if (sscanf(ip, valid_login[id][i] + "%*s")) return 1;
        return 0;
}
