// Create By Yixian
// Topd.C
int get_point(object ob);
int write_top(int num,object ob);
int del_top();

int list(int num,object ob) // 显示TOP
{
        object file;
        string msg,*message,*msg2;
        mapping *content;
        
        if(!num || !intp(num)) return 0;
        
        if(num >100)  num = 100;
        if(num <100)  num = 10;
        
//      file = load_object("/data/toplist.o");
        /*
        toplist.o文件格式：
        
        1行：测试玩家 玩家门派 玩家点数
        2行：测试玩家2 玩家2门派 玩家2点数
        
        
        */
        
//      if( file_size(file) < 0 ) return 0;
        
        msg = read_file("/data/toplist.o",1,num);
        message = explode(msg,"\n");
        msg = "\n\t江湖高手风云榜\n";
        for(int a=0;a<sizeof(message);a++) {
                msg2=explode(message[a]," ");
                for(int b=0;b<sizeof(msg2);b++) {
                        if( b = 0 ) content[a]["name"] = msg2[b];
                        if( b = 1 ) content[a]["party"] = msg2[b];
                        if( b = 2 ) content[a]["score"] = (int)msg2[b];
                }
                msg += sprintf("  %-8s     %-s     %d\n",
                                "第"+content[a]["name"]+"名",
                                content[a]["party"],
                                content[a]["score"],
                                );
        }
                        
        msg += "\n\n您的评价是："+chinese_number(get_point(this_player()))+"点。\n";
                        
        ob->start_more(msg);
        return 1;
}
int get_point(object ob)
{
        int point;
        mapping skills;
        int tlvl,i,score;
        string *ski;
        
        reset_eval_cost();

        point = 0;
        point += ob->query("combat_exp")/3000;
        point += ob->query("max_neili")/500;
        point += ob->query_str() + ob->query_int() + ob->query_dex() + ob->query_con();
        
        skills = ob->query_skills();
        if (!sizeof(skills)) 
                return 1; 
        ski  = keys(skills);
        for(i = 0; i<sizeof(ski); i++) 
        {
                tlvl += skills[ski[i]];
        }  
        // count total skill levels
        
        point += tlvl/10;

        return point;
}
int compare(object ob)
{
        int num,a,b;
        string msg,*msg1,*message;
        mapping *content;
        
                
        reset_eval_cost();
        
        msg = read_file("/data/toplist.o",1,100);
        message = explode(msg,"\n");
        for(num=0;num<sizeof(message);num++) {
                msg1 = explode(message[num]," ");
                        for(a=0;a<sizeof(msg1);a++) {
                                if( a = 0 ) {
                                        content[num]["name"] = msg1[a];
                                        continue;
                                }
                                
                                if( a = 1 ) {
                                        content[num]["party"] = msg1[a];
                                        continue;
                                }
                                
                                
                                if( a = 2 ) {
                                        content[num]["score"] = msg1[a];
                                        continue;
                                }
                                                                
                                if( content[num]["score"] <= get_point(ob)) {
                                        write_top(num,ob);
                                        /*　重新写toplist.o */
                                        break;
                                }
                        }
                }
                
                return 1;
}
int write_top(int num,object ob)
{
        int a;
        string msg,*message;
        msg = read_file("/data/toplist.o",1,100);
        message = explode(msg,"\n");
        for(a=0;a<sizeof(message);a++) {
                if( a = num ) write_file("/data/toplist.o",ob->query("name")+" "+ob->query("family/family_name")+" "+get_point(ob));
                write_file("/data/toplist.o",message[a]);
        }
        del_top();
        return 1;
}
int del_top()
{
        string msg;
        msg = read_file("/data/toplist.o",1,100);
        write_file("/data/toplist.o",msg,1);
        return 1;
}
