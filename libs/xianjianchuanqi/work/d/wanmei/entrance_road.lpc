#include <ansi.h>
void create() {
  set("short", HIW "古龙城大门" NOR);
  set("long", @LONG
这是踏往古龙城之路的第一步，古龙群侠辈出处，风起云涌，几时消，
  莫名心痛把酒杯，踏上无恨江湖路.欢迎来到古龙群侠城……
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "west": "/d/city/eroad2",
    "east": "/d/city3/tlroad2",
  ]));
  set("objects", ([
    __DIR__ "npc/bing": 4,
    __DIR__ "npc/wujiang1": 1,
  ]));

  set("outdoors", "wanmei");
  set("item_desc", ([
    "古龙花": "
                        路边的野花好美呀．．．采（ｐｉｃｋ）一朵吧！\n"


  ]));
  set("coor/x", 110);
  set("coor/y", -400);
  set("coor/z", 30);
  setup();
}
void init() {
  add_action("do_pick", "pick");
}

int do_pick() {
  object flower;
  message_vision("$N弯下腰，采了一朵路边的古龙花。\n", this_player());
  flower = new(__DIR__ "obj/flower");
  flower->move(this_player());
  return 1;
}
