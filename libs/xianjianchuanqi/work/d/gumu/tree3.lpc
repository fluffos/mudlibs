// Room: /u/xdd/gumu/tree.c

#include <ansi.h>;
#include <room.h>;
inherit ROOM;

void create()
{
     set("short", BLU"浓荫深处"NOR);
     set("long", @LONG
此处一片密密的枝叶,遮住了阳光,遮住了视线. 枝杈上有不少毒虫鸟
兽,你仔细打量这片浓荫,寻找出路.
LONG        );  
	  setup();
}

void init()
{
	 add_action("do_jump", "jump");
	 add_action("do_climb", "climb");
}

int do_jump(string arg)
{
	 object me = this_player();

	 if ( arg == "off")
{
	 message_vision("$N从树上跳了下去. \n", me);
	 me->delete_temp("climb/up");
	 me->delete_temp("climb/down");
	 me->delete_temp("climb/left");
	 me->delete_temp("climb/right");

	 if ((int)me->query_skill("dodge", 1) < 50)
{
	 me->move(__DIR__"xuanya");
	 message_vision("$N从树上跳下来,结果重重掉到地上. \n", me);
	 me->receive_damage( "qi", 30, me);
	 me->receive_wound("qi", 30, me);
	 return 1;
}

	 me->move(__DIR__"xuanya");
	 message_vision("$N轻飘飘从树上跃下,气定神闲。\n", me);
	 return 1;
}

	 if (arg == "tree" || arg == "around")
{
	 message_vision("$N在巨树的枝叶间闪展腾挪练习起轻功身法. \n", me);

	 if ((int)me->query_skill("dodge", 1) < 50)
{
	 message_vision(RED"$N身形凝滞一下,正撞到一根隐蔽的大树枝,身体前扑,啊..
身体往树下栽去. \n"NOR, me);
	 me->move(__DIR__"xuanya");
	 message_vision(RED"$N从树上栽了一下,结果砰一声重重摔在地上. \n"NOR, me);
	 me->receive_damage("qi", 30, me);
	 me->receive_wound("qi", 30, me);
	 return 1;
}

	 if ((int)me->query_skill("dodge", 1) > 120)
{
	 message_vision("$N身影如同蝴蝶般于树叶间穿梭游行,委实已至化境. \n", me);
	 write("你的轻功已无法用此法提高了. \n");
	 return 1;
}

	 me->improve_skill("dodge", (int)(me->query_dex()/2) +
							 (int)(me->query_skill("dodge", 1)/10) );
	 me->receive_damage("qi", 30);
//	 me->add("combat_exp", random(4));
	 return 1;
}
	 return 0;
}

int do_climb(string arg)
{
	  object me = this_player();

	  if ((int)me->query_temp("mark/up") > 4 && (int)me->query_temp("mark/down") < 3
	  && (int)me->query_temp("mark/left") == 3 && (int)me->query_temp("mark/right") == 3)
{
	  message_vision("$N身影一晃,突然消失了. \n", me);
	  me->move(__DIR__"treetop");
	  return 1;
}

	  if ((int)me->query_temp("mark/down") > 5)
{
	  message_vision("$N屁股翘得老高慢慢爬下树. \n", me);
	  me->move(__DIR__"xuanya");
	  message_vision("$N象熊猫一样从树上爬了下来. \n", me);
	  me->delete_temp("mark/up");
	  me->delete_temp("mark/down");
	  me->delete_temp("mark/left");
	  me->delete_temp("mark/right");
	  return 1;
}

	  if (arg == "up")
{
	  int a = random(5);
	  message_vision(BLU"$N往大树顶上爬去. \n"NOR, me);
	  me->move(__DIR__"tree4");
	  me->add_temp("mark/up", 1);
	  if ((int)me->query_temp("mark/up") == 3 && a == 3)
{
	  message("vision", "一条毒蛇从树枝后游了过来. \n", me);
	  new(__DIR__"obj/snake1")->move(__DIR__"tree4");
}
	  return 1;
}

	  if (arg == "down")
{
	  int a = random(5);
	  message_vision("$N往大树下方爬去. \n", me);
	  me->move(__DIR__"tree");
	  me->add_temp("mark/down", 1);
	  if ((int)me->query_temp("mark/down") == 2 && a == 4)
{
	  new(__DIR__"obj/snake2")->move(__DIR__"tree");
	  message("vision", "一条毒蛇从树后游了出来,对你发动攻击. \n", me);
}
	  return 1;
}

	  if ( arg == "left")
{
	  int a = random(5);
	  message_vision("$N抓住树枝,荡向树的左边。\n", me);
	  me->move(__DIR__"tree1");
	  me->add_temp("mark/left", 1);
	  if ((int)me->query_temp("mark/left") == 3 && a == 3);
	  new(__DIR__"obj/snake3")->move(__DIR__"tree1");
	  return 1;
}

	  if (arg == "right")
{
	  int a = random(10);
	  message_vision("$N抓住树枝藤条,荡向树的右边. \n", me);
	  me->move(__DIR__"tree2");
	  me->add_temp("mark/right", 1);
	  if ((int)me->query_temp("mark/right") > 3 && a == 8)
	  message_vision("有几只玉蜂嗡嗡朝$N飞了过来. \n", me);
	  new(__DIR__"obj/bee")->move(__DIR__"tree2");
	  new(__DIR__"obj/bee")->move(__DIR__"tree2");
	  return 1;
}
	  return 0;
}
