// oldlady.c

inherit NPC;

int give_food();

int give_water();

string* foods = ({
       "/food/buzhan",
       "/food/cuishan",
       "/food/doufu",
       "/food/douhua",
       "/food/fan",
       "/food/guoba",
       "/food/liyu",
       "/food/ruzhu",
       "/food/ya",
});

void create()
{
       set_name("王婆婆", ({ "wang popo", "wang", "popo" }) );
       set("gender", "女性" );
       set("age", 50);
       set("long",
               "王婆婆生就一张生满鸡皮疙瘩的丑脸，但奇丑之中却含仁慈温柔之意。\n");
       set("combat_exp", 2500);
       set("attitude", "friendly");
       set("rank_info/respect", "婆婆");
       set("inquiry", ([
               "name" : "我不是你王婆婆吗?",
	       "food" : (: give_food :),
	       "water" : (: give_water :),	
       ]) );
       setup();

}

int give_food()
{
       object food, me, ob;

       me = this_object();
       ob = this_player();

       say("王婆婆柔声道：“多吃点，别饿坏了，吃完了还有。”\n");

       food = new( "/u/snowman" + foods[random(sizeof(foods))] );

       food->move(ob);

       message_vision("$N交给$n一碟小吃。\n", me, ob);

       return 1;
}
 
int give_water()
{
       object water, me, ob;

       me = this_object();
       ob = this_player();

       say("王婆婆柔声道：“这是刚泡好的茶，小心烫。”\n");


       water = new( "/u/snowman/food/tea");

       water->move(ob);

       message_vision("$N交给$n一杯热茶。\n", me, ob);

       return 1;
}