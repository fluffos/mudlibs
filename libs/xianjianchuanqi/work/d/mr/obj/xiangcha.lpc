// xiangcha.c 香茶
// By Marz 03/29/96

inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("香茶",({"tea", "cha", "xiang cha"}));
        set_weight(50);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一杯热茶，悠悠地冒着香气～～～\n");
                set("unit", "杯");
                set("value", 1000);
        set("water_remaining", 2);
        set("water_supply", 25);
    }
        
        setup();
}

