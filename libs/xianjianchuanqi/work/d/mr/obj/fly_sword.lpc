inherit ITEM;

inherit F_UNIQUE;


#include "/inherit/item/embed.h"
void create() {
  set_name(HIW "飞剑" NOR, ({ "fly sword", "sword" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("damage", 20);
    set("poison", "fly_sword_poison");
    set("embed", 1);
    set("unit", "把");
    set("unique", 5);
    set("treasure", 1);
    set("material", "steel");
    set("throw_msg", HIW "$N突然把手中飞剑向前一射！\n" NOR);
    set("long", "一把百炼钢所制的短剑，上面刻着〖燕国飞剑〗。\n");
    set("value", 20000);
  }
  setup();
}
