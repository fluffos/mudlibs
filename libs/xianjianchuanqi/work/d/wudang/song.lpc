string ask_job()
{ 
  object  ob, me,gift,*team,obj;
  int exp,position,i;
  mapping target;
  string str;
  ob=this_player();
  me=this_object();
  exp=ob->query("combat_exp");

  if (interactive(ob) && (int)ob->query_condition("huang_mission"))
       return "你上一次的任务还没完成!";
  if (interactive(ob) && (int)ob->query_condition("huang_busy"))  
       return "现在我可没有给你的任务，等会再来吧。\n";

	if(exp<=100000)     
       return "你的武功太差了,等练强了再来吧。\n";
    
    for(i=100;i*i*i/10<=exp;i++);//i=maxpot
    if(random(10)>7||ob->query("id")=="zzz")
    { obj=new("/kungfu/class/wudang/killer.lpc");
	 i=i+10+random(10);
	 obj->do_copy(ob,i);
	 obj->set("title",HIR"江南一霸"NOR);
	 ob->set_temp("huang_job_super",1);
	}
	else
    {
      obj=new("/kungfu/class/wudang/killer.lpc");
	  i=i-random(10);
	  obj->do_copy(ob,i);
    }

    target = wheres[random(sizeof(wheres))];
//    if(file_size(target["weizhi"]) == -1)
//        target = wheres[1];

	command("nod");
	str=HIY"我收到密报人在『"+target["chinese"]+"』一带行凶作恶。"NOR;
	command("say "+str);
    obj->move(target["weizhi"]);
    obj->set_temp("must_killby",ob->query("id"));
    ob->set_temp("huang_job_target", target["chinese"]);//where
    ob->apply_condition("huang_mission",30);
    return HIY"你去打发他们，回来自有你好处。"NOR;
}

int accept_object(object who, object ob,object me)
{
        if ( ob->query("id") != "corpse") {
                command("say 你给我这个干吗?");
                return 0;
        }
        if ( !who->query_temp("huang_job_target") ) {
                command("say 好啊！不过你得先申请任务。");
                return 0;
        }
	       	if (ob->query_temp("must_killby")!= who->query("id")
			||ob->query("victim_user")||who->query_temp("huang_given") )
		{       command("shake");
                command("say 你杀错人了。");
                return 0;
        } 

  /*      if ( ob->query("kill_by") != who) {
                command("say 这个任务似乎不是你自己完成的吧？");
                return 0;
        }
*/      who->set_temp("huang_given",1);
        call_out("destroying", 1, ob);
        call_out("ok", 1, who);
        return 1;
}

void ok(object who)
{
        int exp,pot,count,i;
        if (!who) return;
        command("pat" + who->query("id"));
        command("say 做的好，加油干!");
        if(!who->query("huang_job_count"))
		who->set("huang_job_count",1);
        else
		who->add("huang_job_count",1);        
		count=who->query("huang_job_count");
		for(i=0;i*i<count;i++);
		exp=450+random(50)+i*2;
        if(who->query_temp("huang_job_super"))
        {exp+=100;
		 who->delete_temp("huang_job_super");
		}
		pot=exp/2+random(40);
		who->add("potential",pot);
        who->add("combat_exp",exp);
        who->clear_condition("huang_mission");
		who->delete_temp("huang_job_target");
        who->delete_temp("huang_given");
		who->apply_condition("huang_busy",3+random(6));
        tell_object(who,HIW"你被奖励了：\n" + 
        chinese_number(exp) + "点实战经验\n" +
        chinese_number(pot) + "点潜能\n"+
        NOR);
        return;
}


void destroying(object obj)
{
        destruct(obj);
        return;
}

string ask_fangqi()
{
         object me;
         me = this_player();
         if(!me->query_temp("huang_job_target"))
         return "你没有领任务,跑这里瞎嚷嚷什麽?";
         me->add("combat_exp",-80+random(20));
       //me->apply_condition("huang_busy",4+random(4));
         me->delete_temp("huang_job_target");
	     return "没关系,下次继续努力 。";
}

string ask_gonglao(object who)
{
  object me;
  int i;
           
  me = this_player();
  if(!me->query("huang_job_count"))
  i=0;
  else 
  i =(int)me->query("huang_job_count"); 
  message_vision(CYN"$N对$n说道:你已经完成了" + chinese_number(i) + "次任务。\n"NOR,who,me);
  return "继续努力吧！";
}



void create()
{
       set_name("宋远桥", ({ "song yuanqiao", "song" }));
       set("nickname", "武当首侠");
       set("long", 
               "他就是张三丰的大弟子、武当七侠之首的宋远桥。\n"
               "身穿一件干干净净的灰色道袍。\n"
               "他已年过六十，身材瘦长，满脸红光。恬淡冲和，沉默寡言。\n");
       set("gender", "男性");
       set("age", 61);
       set("attitude", "peaceful");
       set("shen", 10000);
       set("str", 29);
       set("int", 27);
       set("con", 26);
       set("dex", 26);
       set("unique", 1);
       set("max_qi", 3000);
       set("max_jing", 1000);
       set("neili", 2000);
       set("max_neili", 4000);
       set("jiali", 50);
       set("combat_exp", 1000000);
//       set("score", 60000);
       set_skill("force", 180);
        set_skill("yinyun-ziqi", 180);
       set_skill("dodge", 180);
       set_skill("wudang-quan", 180);
       set_skill("tiyunzong", 180);
       set_skill("taoism", 200);
       set_skill("cuff", 180);
       set_skill("taiji-quan", 170);
       set_skill("parry", 160);
       set_skill("sword", 150);
       set_skill("taiji-jian", 170);
       set_skill("literate", 100);
       set_skill("xuanxu-daofa", 180);
   set_skill("blade",150);    set_skill("wudang-quan", 140);
        map_skill("force", "yinyun-ziqi");
       map_skill("dodge", "tiyunzong");
       map_skill("cuff", "taiji-quan");
       map_skill("parry", "taiji-quan");
       map_skill("sword", "taiji-jian");
       prepare_skill("cuff", "taiji-quan");

       create_family("武当派", 2, "弟子");

       set("inquiry", ([
               "秘籍" : (: ask_me :),
                "概要" : (: ask_me1 :),
                "job"  : (: ask_job :),
           "神门十三剑"  : (: ask_jianfa :),
           "饶指柔剑法"  : (: ask_jianfa :),
]));

       set("book_count", 1);
       set("book1_count", 1);

       setup();
     carry_object("/clone/weapon/changjian")->wield();
       carry_object("/d/wudang/obj/white-robe")->wear();

}
void attempt_apprentice(object ob)
{
       if ((int)ob->query("shen") < 10000) {
               command("say 我武当乃是堂堂名门正派，对弟子要求极严。");
               command("say 在德行方面，" + RANK_D->query_respect(ob) +
                       "是否还做得不够？");
               return;
       }
       command("say 好吧，贫道就收下你了。");
       command("recruit " + ob->query("id"));
}
string ask_jianfa()
{
mapping fam;  
 object me;
  int task; 
   me = this_player();
   if(!me->query("wd_job_count"))
  task=0;
  else  
task = (int)me->query("wd_job_count");  
        if (!(fam = this_player()->query("family")) || fam["family_name"] != "武当派")
                return RANK_D->query_respect(this_player()) + 
                "与本派素无来往，不知此话从何谈起？";   
if (task<(100+(int)me->query("kar",1)*10 + random(500)))
return "这个...你对本门的贡献似乎不够吧！";
   me->set_skill("wudang-jian",1);      return "好吧，我就传授你这套剑法!";

}
string ask_me()
{
       mapping fam; 
       object ob;
       
       if (!(fam = this_player()->query("family")) || fam["family_name"] != "武当派")
               return RANK_D->query_respect(this_player()) + 
               "与本派素无来往，不知此话从何谈起？";
       if (query("book_count") < 1)
               return "你来晚了，本派的内功心法不在此处。";
       add("book_count", -1);
       ob = new(__DIR__"force_book");
       ob->move(this_player());
       return "好吧，这本「太极十三式」你拿回去好好钻研。";
}
string ask_me1()
{
        mapping fam; 
        object ob;
        
        if (!(fam = this_player()->query("family")) || fam["family_name"] != "武当派")
                return RANK_D->query_respect(this_player()) + 
                "与本派素无来往，不知此话从何谈起？";
        if (query("book1_count") < 1)
                return "你来晚了，刀法概要已经不在此处了。";
        add("book1_count", -1);
        ob = new(__DIR__"blade_book");
        ob->move(this_player());
        return "这本书中讲述的刀法要领，你会去好好研究一下。";
}




