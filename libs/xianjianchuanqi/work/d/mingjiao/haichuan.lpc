inherit ROOM;
#include "haichuan.h";

void create() {
  set("short", "大海船");
  set("long", @LONG
这是一条大帆船，白帆挂在十余丈高的双桅上，行驶速度颇快。但帆船
虽大，在惊涛骇浪中也会成了无主游魂，只是随风飘荡，所以你必须有一身
高深的武功和高明的航海本领，才可在大海中行驶(turn)。从帆船的窗口向
外看，可以观赏到海面上的风景(fengjing)。
LONG);
  set("item_desc", ([
    "fengjing": (: lookout :),
  ]));
  set("outdoors", "东海");
  set("seaboat", 1);
  setup();
}
