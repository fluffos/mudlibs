#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIW"大冰山"NOR);
        set("long", @LONG
大冰山在日光的照射下发出刺眼的光芒，显得十分奇丽，这里到处都是
冰雪，冰山颇大，如陆地上之山丘，一眼望去，横百余丈，纵长几十丈，冰
山上滑不留步。
LONG);	
	set("outdoors","极北");
	set("exits",([
		"north" : __DIR__"dbshan1",
	]));
        setup();
        replace_program(ROOM);
}
