#include <room.h>
inherit ROOM;
void create()
{ 
       set("short","厅堂");
       set("long", @LONG
这是一个很大厅堂，是明教接待外来宾客之地。厅堂的周围放着几张古
木所造的家具，正前方放着一张大师椅，是教主接待宾客的座位，四周站着
几个小丫环，专为客人送茶水。
LONG);    
	set("exits", ([
       		"east" : __DIR__"xiangfang",
		"west" : __DIR__"tearoom",	
                "north" : __DIR__"muqi",
                "south" : __DIR__"qianting",			
	]));             
	set("objects",([
		__DIR__"npc/yahuan" : 1,
                __DIR__"npc/xiao-tong" : 1,
	]));
        setup();
        replace_program(ROOM);
}

