#include <room.h>

inherit ROOM;

void create() {
  set("short", "秘道");
  set("long", @LONG
你走入了一条忽高忽低，崎岖不平，螺旋而下的秘道。
秘道越来越窄，到了这里只能容下一个人了，便似一口深
井。
LONG
  );

  set("exits", ([
    "eastdown": __DIR__ "bidao12",
    "westup": __DIR__ "bidao10",
  ]));
  setup();

  replace_program(ROOM);
}
