 // /d/xueshan/zoul02.c 走廊
// by dubei

inherit ROOM;
void create()
{
        set("short","走廊");
        set("long",@LONG 
这里已经是快到主持禅室了，四周有一些喇嘛恭敬等候主持的传见。
门口站着两名红衣喇嘛，神情居傲。
LONG);
        set("exits",([ 
                "enter": __DIR__"zcchanshi",
                            "down": __DIR__"zoul01",
        ]));
                set("objects",([ 
                            __DIR__"npc/dlama" : 2,
        ]));
        setup();
 
}
int valid_leave(object me, string dir)
{
        mapping myfam;
        myfam = (mapping)me->query("family");
        if ((!myfam || myfam["family_name"] != "密宗") &&
            objectp(present("hongyi lama", environment(me))) && dir == "enter" && (!me->query_temp("mz_baijian")))
           return notify_fail("红衣喇嘛低声道：此乃主持禅室，未经过主持许可，不能进入。\n");

   if ((int)me->query_skill("lamaism", 1) < 61 &&
            objectp(present("hongyi lama", environment(me))) && dir == "enter")
           return notify_fail("红衣喇嘛伸手一拦,说道：必须等候主持召见，才能进去。\n");

        return ::valid_leave(me, dir);
}