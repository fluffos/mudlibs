inherit NPC;
inherit F_UNIQUE;
void create()
{
        set_name("野狼", ({ "yelang", "lang" }) );
	set("race", "野兽");
	set("age", 10);
        set("unique", 2);
        set("long", "狼以群居，这是一只凶狠的大也狼，低沉地吼着。\n");
        set("attitude", "aggressive");	
	set("limbs", ({ "头部", "牙齿", "前脚", "后脚", "前爪" }) );
	set("verbs", ({ "bite", "claw" }) );
        set("max_qi", 450);
        set("max_jing", 200);
        set("eff_jingli", 200);
	set("combat_exp", 9500);
        set("chat_chance", 20);
 
	set_temp("apply/attack", 20);
	set_temp("apply/defense", 20);
	set_temp("apply/damage", 30);
	set_temp("apply/armor", 14);        
        set("senlin", 1);
	setup();
}
 
	
