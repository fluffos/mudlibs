// /u/dubei/xueshan/yadi.c 悬底
// by dubei
#include <ansi.h>
#include <room.h>

inherit ROOM;
 
void create()
{
        set("short",HIW"崖底"NOR);
        set("long",@LONG 
这里是大雪山的崖底，四面都是冰山，山上一年四季都积满了厚厚的白雪。
寻常人很难到达这里，就算武功高强之人，也不敢高声说话，甚怕有什麽声响引
来雪崩。
LONG);
 
     setup(); 
}
void init()
{
              add_action("do_yell", "yell");        
              add_action("do_pa", "pa");   
}
 
int do_yell(string arg)
{
 
	object where,me; 

       me = this_player(); 
       where = environment(me);
 
       if (!arg) return 0;
       if (where->query_temp("mz/yell")){
       message_vision("$N张嘴喊了一声：“" + arg + "！”，但被震耳遇聋的雪崩具响给淹没了。\n", me);
       return 1;
                     }
       message_vision("$N气沉丹田，仰声长啸：“" + arg + "！”\n", me);
       message_vision("四面群山传来一阵阵回声：“" + arg + "～～～”\n", me);
            where->set_temp("mz/yell",1);
       call_out("xuebeng1",3,where);
                     
	return 1;
}
void xuebeng1(object where)
{
       
     tell_object(where,HIW"声音未落，忽见四面高峰上一片片白雪缓缓滚将下来。\n"NOR);
        call_out("xuebeng2",3,where);
}
void xuebeng2(object where)
{
       
       tell_object(where,HIW"但听得雷声隐隐，山头上滚下来的积雪渐多渐速。\n"NOR);
       tell_object(where,HIW"只隔得片刻，隐隐的雷声已变作轰轰隆隆、震耳欲聋的大响。\n"NOR);
        tell_object(where,HIY"大自然如此可怖，纵使武功再高强，也是半点施展不出了，此时最好是逃命吧( pa up)。\n"NOR);
	call_out("xuebeng3",6,where);
}

void xuebeng3(object where)
{ 
       tell_object(where,HIW"雪崩从高峰上一路滚将下来，沿途挟带大量积雪，更有不少岩石随而俱下，声势越来越大。\n"NOR);
       tell_object(where,HIW"雪崩已至半山，当真如群山齐裂、怒潮骤至一般，说不出的可怖可畏。再不跑恐怕就要命丧于此了。\n"NOR);
	call_out("xuebeng4",10,where);
}
void xuebeng4(object where)
{ 
       tell_object(where,RED"伴随着山崩地裂的巨响，一道百长高的雪墙压将下来，人人具心胆俱裂。\n"NOR);
       tell_object(where,HIW"忽然侧面崖壁上的雪一阵松动，露出一个山洞来。\n"NOR);
       set("exits/enter", __DIR__"shandong");
	call_out("xuebeng5",12, where);
}
void xuebeng5(object where)
{
          object cor;
           object *inv;
           int i; 
           inv = all_inventory(where); 
          //     where = environment(me);
           tell_object(where,RED"倾刻间雪墙便已滚到了山底，逃得较慢之人立时被压在如山如海的白雪之中，你连叫声都立时被雪淹没。\n"NOR);
                 where->delete_temp("mz/yell");
                 delete("exits/enter");
            if(sizeof(inv)>0){  
                      for(i=0;i<sizeof(inv);i++){         
                     if(inv[i]->is_character()){                                               
            inv[i]->set_temp("last_damage_from","被雪崩活埋");
            inv[i]->die();
                     }
                     }
               if (cor = present("corpse",this_object())){
			inv = deep_inventory(cor);
			i = sizeof(inv);
			while (i--) if (userp(inv[i])) inv[i]->move(this_object());
			destruct(cor);
                       // destruct("corpse"); 
		} 
    }
} 
int do_pa(string arg)
{
        object me,cor;
             object *ob;
               int i;

        me=this_player();
        if ( !arg || arg != "up" )
            return notify_fail("你要向那里爬？\n");
 

        message_vision("$N战战兢兢的向上爬了上去。\n", me);
        if ((int)me->query_skill("dodge", 1) < 120 || (int)me->query("neili") < 100 || (int)me->query("jingli") <100) 
           {
           message_vision(RED"$N觉得眼睛冒金星，体力不支，急速向下跌了下去。\n"NOR, me); 
                   me->set_temp("last_damage_from","摔下冰山跌");
          me->die();
                 if (cor = present("corpse", this_object())) {
			ob = deep_inventory(cor);
			i = sizeof(ob);
			while (i--) if (userp(ob[i])) ob[i]->move(this_object());
			destruct(cor);
                        destruct("corpse");
                        if (me) tell_room(this_object(), me->name()+"的尸骨被积雪埋了。\n");
		}
            return 1;
           }
              me->add("jingli",-100);
              me->add("neili",-100);
        me->move(__DIR__"xuanya1");
	 tell_room(environment(me), me->name() + "从下面气喘吁吁爬了上来。\n", ({ me }));
        me->delete_temp("mz/hua");
     	return 1;
}
 
 
