#include <room.h>
inherit ROOM;
void create()
{
        set("short","石板路");
        set("long",@LONG 
你走在一条长长的石板路，前面隐隐约约见到了一座座法坛宝塔，据说寺
中大喇嘛们常到那里去听法王宣讼佛法，想到这里，你顾不得脚下湿滑的积雪，
逐渐加快了脚步。
LONG);
        set("exits",([
                "east": __DIR__"xiaomen",
                "west": __DIR__"shilu02",
                "south": __DIR__"xl01",
                "north": __DIR__"zoul01",
        ]));

        setup();
 
      create_door("east", "小门", "west", DOOR_CLOSED);
}
