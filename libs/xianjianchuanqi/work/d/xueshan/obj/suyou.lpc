// suyou  酥油

inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("酥油", ({ "su you", "you" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是。\n");
    set("unit", "个");
    set("value", 1000);
    set("max_liquid", 15);
  }


  set("liquid", ([
    "name": "酥油",
    "remaining": 15,
  ]));
}
