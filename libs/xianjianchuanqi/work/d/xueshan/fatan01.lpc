 // fatan01.c 紫金法坛

#include <ansi.h>

inherit ROOM;

void create()
{
        set("short",HIY "紫金法坛"NOR);
        set("long",@LONG
好一座气势雄伟的法坛，站在这里，寺中景色一目了然，左右周围都是一 
座座比规模较小的法坛，是日常喇嘛们宣讲佛法的所在而你现在站的地方，则 
是为金轮法王每年等坛讲佛的紫金法坛，再往下走，就是法王的禅室。遥望两 
侧，只见两作玲珑宝塔，传说如来佛祖的舍利子就在塔中保存。 
LONG);
        set("exits",([
                "westdown": __DIR__"chanshi03",
                "eastdown": __DIR__"shilu02",
                "southwest": __DIR__"fatan03", 
 		"northwest": __DIR__"fatan02"
        ]));

        setup();
        replace_program(ROOM);
}
