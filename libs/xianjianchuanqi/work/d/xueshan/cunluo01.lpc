 //      cunluo01.c 藏民村落

#include <ansi.h>

inherit ROOM;


void create()
{
        set("short",NOR"藏民村落"NOR);
        set("long",@LONG 
想不到这里竟然有这么大一处居民区。每隔几步就是一处帐篷，里面似乎
是什么店铺，商号。应该也可以在里面借宿。这里的藏民都是以放牧为生，如
果有虔心向佛的，则到山上的雪山大轮寺出家。你四周一看，这里有两个帐篷
第一帐篷是个药铺(yaopu)，另外一个是家杂货店(store)。平时藏民们都到这
里购买物品。你也可以通过查看(list yaopu, list store)来购买(buy)东西。
LONG);
        set("exits",([
                "north" : __DIR__"cunluo02",  
                "southup" : __DIR__"shanjiao",
                "west" :__DIR__"muchang03",
                "east" :__DIR__"muchang07"


        ]));

        setup();
