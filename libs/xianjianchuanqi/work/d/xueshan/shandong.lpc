//  /u/dubei/xueshan/shandong
// by dubei
#include <ansi.h>;

inherit ROOM;
string wall(object);
void create()
{
     set("short",HIW"雪洞"NOR);
     set("long", @LONG
这里是个不大的石洞，人在里面，感到寒意刺骨。透过暗淡的光线，你
隐隐约约看见四壁全是光滑的冰面。
LONG
        );
     set("exits", ([
             "out" : __DIR__"yadi",
             ]));    
     set("item_desc", ([ 
                 "wall" : (: wall :),
             ])); 
     setup();
}
string wall(object me)
{
    me = this_player();
    me->set_temp("mz/look1", 1);
    return  "石洞的四壁全是厚厚的冰面，西首的石壁似乎有几个掌印。\n";
}
void init()
{
     add_action("do_strike", "strike");          
}

int do_strike(string arg)
{
     object me,room;

     me = this_player();
         room = environment(me);
     if ( !living(me) ) return 0;
         
       if (!me->query_temp("mz/look1"))  return 0;
        if ( !arg || (arg != "west") ) 
        return notify_fail("你要击什麽？\n");

       if (me->is_busy())
       return notify_fail("你正忙着呢。\n");
      
       if((int)me->query("neili") <=500)
      return notify_fail("你身体太虚弱了。\n");

       if (room->query_temp("mz/strike") < 15 || !room->query_temp("mz/strike")){

     if ((int)me->query("max_neili") < 1500){
     message_vision("$N运内劲至双臂，挥掌猛然击向石壁。\n",me);
        message_vision("结果冰面只掉下几个小冰块，$N被内劲发弹回来震的虎口发麻。\n",me);
        me->add("max_neili",-2);
        me->add("neili",-200);
        me->unconcious();
        return 1;
     }
        if (room->query_temp("mz/strike") <= 15 && room->query_temp("mz/strike") >=8){
      message_vision("$N运内劲至双臂，挥掌猛然击向石壁。\n",me);
         message_vision("结果冰壁被击出一道裂纹。\n",me);
         me->add("neili",-200);
         room->add_temp("mz/strike",1);
     return 1;
   }
       message_vision("$N运内劲至双臂，挥掌猛然击向石壁。\n",me);
         message_vision("结果冰壁上的裂纹又裂开寸许。\n",me);
     me->add("neili",-200);
         room->add_temp("mz/strike",1);
     return 1;
   }
      if (room->query_temp("mz/strike") >= 15  && random(5) >=3 ){
      message_vision("$N忽然低吼一声，推出一股凌厉的掌风击向石壁。\n",me);
      message_vision("只听一阵碎裂声，冰壁被击出个一人高的缺口。\n",me);
      me->add("neili",-200);
      set("exits/west", __DIR__"shandong1");
      call_out("shandong",20, room);
   return 1;
   }
     return 1;
}
 void shandong(object room)
{
         delete("exits/west");
         room->delete_temp("mz/strike");
}
