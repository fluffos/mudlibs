inherit ROOM;
#include <ansi.h>

int do_look(string arg);
int do_xia(string arg);
void create() {
  set("short", "大空地");
  set("long", @LONG
你走着走着，突然发现你来到大空地内，周围什么都没有也不知道
是什么地方,只是旁边有个大石头(rock)， 孤零零的放在那里!
LONG);
  set("item_desc", ([
    "rock": "一块大石头，不知道有什么用\n",
  ]));

  set("exits", ([
    "south": __DIR__ "xiaodao1",
  ]));
  set("no_clean_up", 0);
  setup();
  //        replace_program(ROOM);
}
void init() {
  add_action("do_xia", "xia");
  add_action("do_look", "look");
}

void relay_revive(object me) {
  add_action("do_xia", "xia");
  add_action("do_look", "look");
}
int do_look(string arg) {
  object me = this_player();
  if (me->query("xytask", 1) < 500 || !me->query("zlqj1")) {
    set("long", @LONG
你走着走着，突然发现你来到大空地内，周围什么都没有也不知道
是什么地方,只是旁边有个大石头(rock)， 孤零零的放在那里!
LONG
    );
    me->look(arg);
  } else {
    if (!arg) {
      set("long", @LONG
你走着走着，突然发现你来到大空地内，周围什么都没有也不知
道是什么地方,只是旁边有个大石头(rock)， 石头上似乎摆了些东西
你忙走过去仔细看清楚。
LONG
      );
      me->look(arg);
    } else if (arg == "rock" || arg == "shitou") {
      write("原来大石头上摆着一个棋盘，棋盘左边写着珍珑两个大字，寻常“珍珑” 少则十余子，多者也不过四五十子，但这一个却有二百余子，一盘棋已下得接近完
     局。见这一局棋劫中有劫，既有共活，又有长生，或反扑，或收气，花五聚六，
     复杂无比。你登时精神一振，再看片时，忽觉头晕脑胀，已觉胸口气血翻涌。你突然听见耳边传来一个声音。\n");
      write("“解我珍珑，传我神功! 这位不妨下下(xia qipan)试试” 。\n");
      me->set("zlqj2", 1);
      return 1;
    }

  }
}
int do_xia(string arg) {
  object me;
  int i; me = this_player();
  if (!arg || (arg != "qipan"))
    return notify_fail("什么？\n");
  if (!me->query("zlqj2"))
    return notify_fail("什么?\n");
  i = me->query_int(); if (i > 40 && (random(20) > 10)) {
    me->add("jing", (-15) * random(5));
    me->add("max_neili", 400);
    me->add("max_jingli", 500);
    me->add("combat_exp", 50000);
    me->set("zlqjover", 1);
    me->set("zlqj1", 0);
    me->set("zlqj2", 0);
    me->add("con", 1);
    me->add("str", 1);
    me->add("int", 1);
    me->add("dex", 1); write(HIR "你算了半天，眼前渐渐模糊，棋局上的白子黑子似乎都化作了将官士卒，
东一团人马，西一块阵营，你围住我，我围住你，互相纠缠不清的厮杀。眼睁睁见到
己方白旗白甲的兵马被黑旗黑甲的敌人围住了，左冲右突，始终杀不出重围，心中越
来越是焦急，绝望之下，从棋盒中取过一枚白子，闭了眼睛，随手放在棋局之上。\n" NOR);
    write(HIC "你双眼还没睁开，只听得那个怒声斥道：“胡闹，胡闹，你自填一气，自己
杀死一块白棋，哪有这等下棋的法子？”你睁眼一看，不禁满脸通红。\n" NOR);
    write(HIW "原来自己闭着眼睛瞎放一子，竟放在一块已被黑棋围得密不通风的白棋之中。
这大块白棋本来尚有一气，虽然黑棋随时可将之吃净，但只要对方一时无暇去吃，总还有
一线生机，苦苦挣扎，全凭于此。现下他自己将自己的白棋吃了，棋道之中，从无这等自
杀的行径。这白棋一死，白方眼看是全军覆没了。\n" NOR);
    write(HIY "你硬着头皮继续下,可是数着之后，局面竟起了大大变化，你才知这个“珍珑”
的秘奥，正是要白棋先挤死了自己一大块，以后的妙着方能源源而生。棋中固有“反扑”、
“倒脱靴”之法，自己故意送死，让对方吃去数子，然后取得胜势，但送死者最多也不过
八九子，决无一口气奉送数十子之理，这等“挤死自己”的着法，实乃围棋中千古未有之
奇变，任你是如何超妙入神的高手，也决不会想到这一条路上去。任何人所想的，总是如
何脱困求生，从来没人故意往死路上去想。若不是你闭上眼睛、随手瞎摆而下出这着大笨
棋来，只怕再过一千年，这个“珍珑”也没人能解得开。\n" NOR);
    write(BLU "待到十余步之后，那个声音说道：“我布下此局，数十年来无人能解 你解开这个珍珑，在下感激不尽。”，我将我70余年功力传将与你，望你好自为知\n" NOR);
    write(MAG "你突觉气血翻涌，一股内力源源而来，片刻之后只觉身轻似燕，武学修为提升几乘!\n" NOR);
    CHANNEL_D->do_channel(this_player(), "rumor", BRED HIY "解开了珍珑棋局!\n\n" NOR);
  } else {
    write(RED "你定了定神，认真算棋，发觉原先以为这块白棋是死的，其实却有可活之道，但要杀却旁边一块黑棋，牵涉却又极多，再算得几下，突然间眼前一团漆黑，喉头一甜，喷出一大口鲜血。那声音又道:：“这局棋原是极难，你天资有限,虽然棋力不弱，却也多半解不开，还是请回吧？”\n" NOR);
    me->set("zlqjover", 1);
    me->set("zlqj1", 0);
    me->set("zlqj2", 0);

  }
  return 1;

}
