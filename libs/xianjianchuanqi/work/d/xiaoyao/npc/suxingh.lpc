inherit NPC;
#include <ansi.h>
inherit F_MASTER;

string ask_me();
 string ask_me1();
string ask_me2();
string ask_book();

void create()
{
        set_name("苏星河",({"su xinghe","su"}));
        set("gender", "男性" );
        set("nickname", "聪辩老人");
        set("shen_type", 0);
        set("class", "scholar");
        set("age",60);
        set("str", 30);
        set("con", 30);
        set("int", 45);
        set("dex", 35);
        set("per", 30);

        set("no_clean_up",1);

        set("long",
"此人就是号称聪辩老人的苏星河，据说他能言善辩， \n"
"是一个武林中的智者，而他的武功也是无人能知。\n");

        set("combat_exp", 500000);
        set("attitude", "peaceful");
        set("book_count", 1);
        set("chat_chance", 1);

        set("inquiry", ([
                "秘密地道" :(:ask_me:),
              "秋水刃" : (:ask_me2:),
                "刀法要决"     :(:ask_book:),
                  "宝刀"     :(:ask_me1:),
        ]) );

        set("max_qi", 3400);
        set("max_jing", 400);
        set("neili", 3500);
        set("max_neili",3500);
        set("jiali", 60);
        set("env/wimpy", 60);

        set_skill("force", 200);
        set_skill("dodge", 200);
 //       set_skill("unarmed", 180);
        set_skill("parry", 180);
        set_skill("blade", 180);
        set_skill("lingboweibu", 180);
        set_skill("beiming-shengong", 180);
        set_skill("ruyi-dao", 180);
        set_skill("liuyang-zhang", 180);
        set_skill("zhemei-shou", 180);
        set_skill("literate", 100);
        set_skill("hand", 180);
        set_skill("sword", 180);
        set_skill("liancheng-jian", 180);
        set_skill("strike", 180);

        map_skill("strike", "liuyang-zhang");
        map_skill("blade", "ruyi-dao");
        map_skill("dodge", "lingboweibu");
        map_skill("force", "beiming-shengong");
        map_skill("hand", "zhemei-shou");


        prepare_skill("hand","zhemei-shou");
        prepare_skill("strike","liuyang-zhang");        

        create_family("逍遥派", 2, "弟子");
        set("title","逍遥派第二代大弟子");
        setup();
//       carry_object(__DIR__"obj/cloth")->wear();
//        carry_object(__DIR__"obj/blade")->wield();
}


void attempt_apprentice(object ob)
{

        if (ob->query_int() < 24) {
                command("shake"+ ob->query("id")); 
                command("say " + RANK_D->query_respect(ob) + 
                        "是否还应该在学问上多下点功夫？");
                return;
        }

        command("say 好吧，我就收下你了，今后要多加努力啊！");
        command("recruit " + ob->query("id"));
 }

string ask_book()
{
        object me,ob;
        mapping fam; 
        if (!(fam = this_player()->query("family"))
            || fam["family_name"] != "逍遥派")
                return RANK_D->query_respect(this_player()) +
                "与本派毫无瓜葛，鬼才会给你！";
        ob = new("/clone/book/xydf");
        ob->move(this_player());
        return "好吧，这本「逍遥刀法总决」你拿回去好好研读。";
}
string ask_me()
{
        object me,ob;
        mapping fam; 
        ob=this_player();
        if (!(fam = ob->query("family")) 
                || fam["family_name"] != "逍遥派")
        {
                return"想要知道密道就得加入逍遥派。";
        }
        command("sigh");
        return"本派的密道在华山之上，很是艰险。你有兴趣可以去看看。";
}
string ask_me1()
{
        object me,ob;
        mapping fam; 
        me=this_player();
       if (!(fam = this_player()->query("family")) || fam["family_name"] != "逍遥派")
        {
                return"你也想要逍遥的宝物，别开玩笑了。";
        }
        me->set_temp("squall_dao",1);
        command("nod");
          command("say 要拿宝刀就必须得到我师傅吴崖子的同意。");
            return"我师傅在哪儿我也不知道啊。";
 }
string ask_me2()
{
        object ob;
       if (!this_player()->query_temp("squall_dao1"))
           return "要经过我师傅的同意才能给你秋水刃。";
      this_player()->delete_temp("squall_dao1",1);
          ob=unew("/u/squall/obj/qiushui");
        if(!clonep(ob)) return "呵呵，刀已经被别人拿走了。";  
        if(clonep(ob) && ob->violate_unique()){
           destruct(ob);
           return "呵呵，刀已经被别人拿走了。";
           } 
        ob->move(this_player());
        return "不要丢逍遥派的脸啊，自己加油吧。";
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "scholar");
}

