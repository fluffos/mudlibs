// liqiushui.c 李秋水


#include <ansi.h>

inherit NPC;
inherit F_MASTER;


void create() {
  set_name("李秋水", ({
    "li qiushui",
    "li",
    "qiushui",
  }));
  set("long",
    "她身穿一袭白衣。脸上有一道长长的疤痕，烛光下显得阴深可怖，\n"
    "她愁眉苦脸，似乎不甚开心。\n"
  );


  set("nickname", "西夏国太皇太妃");
  set("gender", "女性");
  set("attitude", "friendly");

  set("per", 10);
  set("str", 30);
  set("int", 20);
  set("con", 26);
  set("dex", 30);
  set("age", 70);
  set("chat_chance_combat", 9);
  set("chat_msg_combat", ({
    (: exert_function, "recover" :),
  }));
  set("chat_chance", 1);
  set("chat_msg", ({
    "李秋水长叹道：“不知师哥现在在什么地方？”\n",
    "李秋水狠狠道：“巫行云那个贱人，总有一天我会把他碎尸万段！”\n",
    "李秋水嘿嘿的奸笑了几声。\n",
    "李秋水道：我这万蛇蚀心手和幽冥鬼爪配合可说是天下无敌，巫行云那贱人怎么可能挡得住我一招？。\n",
  }));

  set("max_qi", 4000);
  set("max_jing", 2000);
  set("neili", 5000);
  set("max_neili", 5000);
  set("jiali", 150);
  set("combat_exp", 2000000);
  set("score", 500000);

  set_skill("force", 280);
  set_skill("beiming-shengong", 280);    //北冥神功
  set_skill("claw", 280);
  set_skill("youming-guizhua", 280);  //幽冥鬼爪
  set_skill("zhemei-shou", 280);  //天山折梅手
  set_skill("dodge", 280);
  set_skill("lingboweibu", 280);   //凌波微步
  set_skill("parry", 280);
  set_skill("liuyang-zhang", 280);    //天山六阳掌
  set_skill("literate", 200);
  set_skill("hand", 280);
  set_skill("poison", 280);   //基本毒技

  map_skill("force", "beiming-shengong");
  map_skill("unarmed", "wanshe-shou");
  map_skill("dodge", "lingboweibu");
  map_skill("parry", "youming-guizhua");
  map_skill("claw", "youming-guizhua");
  map_skill("hand", "wanshe-shou");

  set("class", "taoist");


  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
}

void destroying(object me, object obj) {
  destruct(obj);
  return;
}
