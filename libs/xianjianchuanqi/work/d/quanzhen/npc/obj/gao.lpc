// gao.c 龟苓膏
// By Lgg,1998.10

inherit ITEM;
#include <ansi.h>

void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name(HIW"龟苓膏"NOR, ({"guiling gao","gao"}));
        set_weight(3000);
        set("unit", "块");
        set("long", "这是一块龟苓膏，功能延年益寿。\n");
        setup();
}

int do_eat(string arg)
{
        object me = this_player();

        if (!id(arg))
        return notify_fail("你要吃什么？\n");

        if ( me->query_skill_mapped("force") != "quanzhen-xinfa" )
      {
       
                write("所练内功不符，这龟苓膏恐怕对你没有什么作用！\n");

                return 1;
            }  

         if ( me->query("max_neili") < 50 )
        {
    message_vision(HIR "$N吃下龟苓膏，可惜内力修为尚缺，没有什么收益！\n" NOR, me);
        }
        else if ( (int)me->query_condition("medicine" ) > 0 )
        {
                message_vision(HIR "$N吃下了一块龟苓膏，但是好象没什么用！\n" NOR, me);
        }
        else
        {
                me->add("max_neili", 1);
       message_vision(HIG "$N你吃下了一块龟苓膏，只觉得丹田健旺之极，内力直
欲奔腾而出！\n" NOR, me);
              me->apply_condition("medicine", 30);
        }
        destruct(this_object());
        return 1;
}
