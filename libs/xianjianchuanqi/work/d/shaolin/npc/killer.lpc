inherit NPC;
inherit F_UNIQUE;
inherit F_SAVE;
#include <ansi.h>

string *skill = ({ 
    "riyue-bian","ranmu-daofa",
    "taiji-jian","dagou-bang","murong-daofa",
    "murong-jianfa","yuxiao-jian","huifeng-jian",
    "huashan-jianfa","fanliangyi-dao",
    "lingshe-bianfa","songshan-jian","yanxing-daofa",
    "dugu-jiujian",
	}); 

string *force = ({
    "yijin-jing","yijin-jing",
    "yinyun-ziqi","huntian-qigong","shenyuan-gong",
    "shenyuan-gong","bihai-chaosheng","linji-zhuang",
    "zixia-gong","zixia-gong",
    "dulong-dafa","hanbing-zhenqi","linji-zhuang",
    "zixia-gong",
	});

string *perform = ({
    "chanrao","fenwo",
    "chan","chan","daoying",
    "lianhuan","qimen","mie",
    "jianmang","sanshenfeng",
    "sandou","feiwu","huanying",
    "kuangfeng",
	 });

string *base = ({
    "whip","blade",
    "sword","stick","blade",
    "sword","sword","sword",
    "sword","blade",
    "whip","sword","blade",
    "sword",
    }); 

string *weapon1 = ({
    "whip","blade",
    "sword","zhubang","blade",
    "sword","xiao","sword",
    "sword","blade",
    "whip","sword","blade",
    "sword",
    });

void create()
{
    set_name("魔教教徒", ({ "jiaotu"}));

    set("init",0);
    set("gender", "男性");
    set("age", 20 + random(60));
    set("long", "这是一名魔教教徒。\n" ); //我太懒了，不想写描述
    set("str", 15 + random( 5 ) );
    set("int", 20 + random( 10 ) );
    set("con", 20 + random( 10 ) );
    set("dex", 25 + random( 10 ) );
    set("max_qi",4000);
    set("eff_qi",4000);
    set("qi",4000);
    set("neili",4000);
    set("max_neili",4000);
    set("jingli",4000);
    set("max_jingli",4000);
    set("eff_jingli",4000);
    set("max_jing",4000);
    set("jing",4000);
    set("shen",0);
	if( random(20) < 1 )
		set("double_attack",1);

    setup();

    call_out("remove_ob",300,this_object());
}       

int remove_ob(object ob)
{
    if(!ob) return 1;
    destruct(ob);
    return 1;
}

void init()
{
    object ob=this_object(),ob1;
   	string s_skill,s_force,s_perform,s_base,s_weapon;
   	int lvl,index;

    ::init();
    if(!ob) return;
    ob1=present("dashi",environment(ob));
    if( !ob1 ) return;
    ob->kill_ob(ob1);
    ob1->kill_ob(ob);
    if( query("init")==0)
    {
        set("init",1);
        lvl = ob1->query("lvl");
	    index = random( sizeof( skill ) );

	    s_skill = skill[ index ];
	    s_force = force[ index ];
	    s_perform = perform[ index ];
	    s_base = base[ index ];
	    s_weapon = weapon1[ index ];
	    set("combat_exp", lvl*lvl*lvl/10);
	    set("meitude", "peaceful");
	    set("max_qi", 4000+lvl*lvl*lvl/10000);
	    set("qi",query("max_qi"));
	    set("max_jing", 3000);
	    set("max_neili", 4500 + lvl * lvl*lvl /10000 );
	    set("neili",query("max_neili"));
	    set("eff_jingli",4000);
	    set("jiali",10);
	    set_skill(s_skill, lvl );
	    set_skill(s_force, lvl );
	    set_skill(s_base, lvl);
	    set_skill("dodge", lvl);
	    set_skill("force", lvl);
	    set_skill("parry", lvl);
	    set_skill("tiyunzong", lvl);
	    set_skill("qimen-bagua",200);
	    set_skill("poison",200);
	    set_skill("buddhism",200);
	    set_skill("cuff",lvl);
	    set_skill("literate",200);
	    set_skill("bangjue",200);
	    set_skill("qiankun-danuoyi",200);
	    set_skill("poyu-quan",lvl);
	    set_skill("xingyi-zhang",lvl);
	    set_skill("strike",lvl);
	       
    	map_skill("force", s_force);
	    map_skill("dodge", "tiyunzong");
	    map_skill("parry", s_skill);
	    map_skill("cuff","poyu-quan");
	    map_skill("strike","xingyi-zhang");
	    map_skill(s_base, s_skill);
	    prepare_skill("cuff", "poyu-quan");
	    prepare_skill("strike", "xingyi-zhang");
	    
	    set("chat_chance_combat", 10);
		set("chat_msg_combat", ({
			    (: perform_action, s_base + "." + s_perform :)
		        }) );
        setup();
        reincarnate(); 

    	carry_object(ARMOR_D("cloth"))->wear();
    	carry_object(BINGQI_D(s_weapon))->wield();
	    add_money("gold",2);
    }
    
    return;
}

void unconcious()
{
	object ob = this_object(),me;
	
	me = ob->query_temp("last_damage_from");

	if(!me)
	{
		::unconcious();
		return;
	}
		
	if( userp(me) )
	    me->add_temp("sljob/killed",1);

	::unconcious();

	return;
}

void die()
{
    object ob = this_object(),ob1;
    
    ob1 = present("dashi",environment(ob));
    if( !ob1 )
    {
        :: die();
        return;
    }

    ob1->add("neili",-(ob1->query("max_qi")-ob1->query("eff_qi"))/2);    
    ob1->set("eff_qi",ob1->query("max_qi"));
    ob1->set("qi",ob1->query("max_qi"));
	ob1->add_temp("sljob/killed",1);
    if( ob1->query("neili")<0)
        ob1->set("neili",100);
    ::die();
    return;
}
