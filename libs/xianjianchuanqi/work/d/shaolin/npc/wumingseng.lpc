// Npc: wuming-laoseng
inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("无名老僧", ({
                "wuming laoseng",
                "wuming",
                "laoseng",
        }));
        set("long",
                "他是一位身穿青袍的枯瘦僧人，身材不高。\n"
                "年纪已在七旬开外，稀稀疏疏的几根长须已然全白。\n"
        );


        set("nickname", "无名神僧");
        set("gender", "男性");
        set("attitude", "friendly");
        set("class", "bonze");

        set("age", 70);
        set("shen", 30000);
        set("str", 40);
        set("int", 30);
        set("con", 30);
        set("dex", 30);
        set("max_qi", 5000);
        set("max_jing", 2000);
        set("neili", 5000);
        set("max_neili", 5000);
        set("jiali", 150);
        set("combat_exp", 3000000);
        set("score", 500000);

        set_skill("force", 500);
        set_skill("whip", 500);
        set_skill("parry", 500);
        set_skill("dodge", 500);
        set_skill("leg", 500);
        set_skill("finger", 500);
        set_skill("yijin-jing", 500);
        set_skill("riyue-bian", 500);
        set_skill("shaolin-shenfa", 500);
        set_skill("ruying-suixingtui", 500);    
        set_skill("mohe-zhi", 500);
        set_skill("buddhism", 500);
        set_skill("literate", 500);
        set_skill("yizhi-chan", 500);
        set_skill("banruo-zhang", 500);
        set_skill("strike", 500);
        set_skill("cuff", 500);
        set_skill("blade", 500);
        set_skill("xiuluo-dao", 500);
        set_skill("jingang-quan", 500);
         set_skill("longzhua-gong", 500);
        set_skill("claw", 500);



        map_skill("force", "yijin-jing");
        map_skill("dodge", "shaolin-shenfa");
        map_skill("cuff", "jingang-quan");
        map_skill("club", "weituo-chu");
        map_skill("parry", "weituo-chu");
        map_skill("claw","longzhua-gong");
 
        prepare_skill("cuff", "jingang-quan");
        prepare_skill("claw","longzhua-gong");
        create_family("少林派", 34, "弟子");

         

        setup();

//        carry_object("/d/shaolin/obj/chanzhang")->wield();
        carry_object("/d/shaolin/obj/xuan-cloth")->wear();
}

void attempt_apprentice(object ob)
{
           string new_name;
           if (!ob->query_temp("laoseng_pass",)){
           command("say 对不起，老衲现在不收徒。");
           return;
         }
        command("recruit " + ob->query("id"));
        new_name=ob->query("name");
        new_name[0..1] = "渡";
        ob->set("name", new_name);
       command("say 从今以后你的法名叫做" + new_name + "，就随老纳研修少林佛法吧！\n");
}
int accept_object(object who, object ob)
{       
         mapping my_fam  = who->query("family");
        if ((string)ob->query("id") != "fenwen jing"){
              command(" :) ");
            return 0;
           }

       if (!(my_fam) || my_fam["family_name"] !="少林派"
            || my_fam["generation"] != 36 || who->query_skill("yijin-jing",1) <180
       || who->query_skill("buddhism",1) <160 || who->query_skill("literate",1)<150 || !who->query_temp("sl_bookget"))
      {
           command(" :) ");
           command("say "+RANK_D->query_respect(this_player())+"不辞辛苦把经书送给还少林,老衲代方丈仅此谢过. \n");
          command("say 空既是幻,幻既是空.\n");
          who->delete_temp("sl_bookget");
          call_out("destroying", 1, ob);
          return 1;
            }
       command("say "+RANK_D->query_respect(this_player())+"不辞辛苦把经书找回,了却老衲心愿,善哉,善哉. \n");
       command("look "+(string)who->query("id"));
       command("say "+RANK_D->query_respect(this_player())+"可原拜老衲为师? \n");
//       who->set("title",少林寺第三十五代弟子);
       who->delete_temp("sl_bookget");
       who->set_temp("laoseng_pass",1);
       call_out("destroying", 1, ob);
       return 1;
}
void destroying(object obj)
{
        destruct(obj);
        return;
}

