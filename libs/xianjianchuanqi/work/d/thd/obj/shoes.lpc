#include <ansi.h>
#include <armor.h>
inherit BOOTS;
void create()
{
        set_name(GRN"布履"NOR, ({ "shoes", "xie" }) );
        set_weight(1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("long","这是一双平常的布履。\n");
                set("unit", "双");
                set("value", 0);
		set("no_transfer",1);
                set("material", "cloth");
                set("armor_type", "feet");
                set("armor_prop/armor",1);
                set("armor_prop/dodge", 0);
}
}
