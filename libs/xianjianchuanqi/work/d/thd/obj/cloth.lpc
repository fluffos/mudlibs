#include <armor.h>
#include <ansi.h>
inherit CLOTH;
void create() {
  set_name(MAG "紫长衫" NOR, ({ "chang shan", "cloth" }));
  set_weight(3);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一件普通的紫色长衫。\n");
    set("unit", "件");
    set("material", "cloth");
    set("armor_prop/armor", 25);
  }
  setup();
}
