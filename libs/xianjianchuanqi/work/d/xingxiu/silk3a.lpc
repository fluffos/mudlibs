// /d/xingxiu/silk3.c
inherit ROOM;
#include <ansi.h>
void create() {
  set("short", YEL "鸣沙山" NOR);
  set("long", @LONG
此山高数十米，山峰陡峭，势如刀刃。北麓有月牙泉。登山俯瞰，沙丘林
立，清泉荡漾。从山顶下滑沙砾随人体下坠，鸣声不绝于耳，兴味盎然。
故称“沙岭晴鸣”。
LONG);
  set("outdoors", "yili");

  set("exits", ([
    "south": __DIR__ "silk3",
    "west": __DIR__ "silk3b",
  ]));

  setup();
  set("yushi_count", 2);
}
#include "/d/xingxiu/job2.h";
