
inherit NPC;
int give_food();
int give_water();

string* foods = ({
       "/d/xingxiu/obj/shiwu1.lpc",
       "/d/xingxiu/obj/shiwu2.lpc",
       "/d/xingxiu/obj/shiwu3.lpc",
         });

void create()
{
       set_name("厨子", ({ "chu zi", "zi" }) );
       set("gender", "男性" );
            set("per",15);
       set("age", 19);
       set("long",
               "他是一个年轻的厨师，负责星宿的饮食。\n");
            set("max_qi",2000);
            set("eff_jingli",2000);
            set("max_neili",2000);
            set("neili",2000);
             set("per",17);
       set("combat_exp", 132500);
       set("attitude", "friendly");
       set("inquiry", ([ 
	       "食物" : (: give_food :),
	       "水" : (: give_water :),	
       ]) );
       setup();
           carry_object("/clone/armor/h-jiasha")->wear();
}
void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

int give_food()
{
       object food, me, ob;

       me = this_object();
       ob = this_player();

       if ( objectp(present("mian", (ob)))||
	   objectp(present("mantou", (ob)))||
	   objectp(present("doufu", (ob))))
          { 
                  say("厨子撇了撇嘴，说道，你身上还有食物，还是先吃了再向我要吧。”\n");
          return 1;
		  } 

       food = new( foods[random(sizeof(foods))] );

       food->move(ob);

       message_vision("$N交给$n一碗食物。\n", me, ob);

       return 1;
}
 
int give_water()
{
       object water, me, ob;

       me = this_object();
       ob = this_player();

if ( objectp(present("tea",(ob))))
          { 
                  say("厨子说道：你身上还有茶，先喝了再说吧。”\n");
          return 1;
		  } 
       
       water = new("/d/xingxiu/obj/shui.lpc");

       water->move(ob);

       message_vision("$N倒了一杯茶交给$n。\n", me, ob);

       return 1;
}
void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return; 
  command("say 这里是星宿的厨房，如果饿了，可以向我要食物(ask zhu zi about 食物)和喝的(ask chuzi about 水)。\n");
 }
