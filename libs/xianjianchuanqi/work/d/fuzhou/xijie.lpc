// Room: /d/fuzhou/xijie.c

inherit ROOM;

void create()
{
	set("short", "西街");
	set("long", @LONG
这里是福州的西大街，北面有一所破败的宅子。西面有一家杂货铺，专卖
女人家用的东西，男人不可以进去。南面正是福威镖局。
LONG
	);

	set("exits", ([
                "east" : __DIR__"zhongxin",
                "north" : __DIR__"laozhai",
                "west" : __DIR__"zahuopu",
                "south" : __DIR__"biaoju",
	]));

	set("outdoors", "福州");
	setup();
}

int valid_leave(object me, string dir)
{
        if (dir == "west" && ((string)me->query("gender") =="男性") && !wizardp(me))
                return notify_fail("你个大老爷们儿去那干嘛！！\n");
        return 1;
}

