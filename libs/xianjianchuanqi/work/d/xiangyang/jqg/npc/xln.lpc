        set("int", 30);
        set("con", 30);
        set("dex", 30);
        set("double_attack", 1);
        set("max_qi", 5000);
        set("max_jing", 3000);
        set("neili", 5000);
        set("max_neili", 5000);
        set("jiali", 150);
        set("combat_exp", 2400000);
        set("shen", 25000);
        set("chat_chance_combat", 10);
//       set("chat_msg_combat", ({
//                (: perform_action, "sword.xuan" :),
//        }));
        set_skill("force", 300);
        set_skill("yunu-shenfa", 300);
        set_skill("dodge", 300);
        set_skill("yunu-xinjing", 300);
        set_skill("cuff", 280);
        set_skill("meinu-quanfa", 280);
        set_skill("parry", 300);
        set_skill("sword", 300);
       set_skill("literate", 300);
       set_skill("throwing", 300);
       set_skill("whip", 300);
       set_skill("yinsuo-jinling", 300);
        set_skill("yunu-jianfa", 300);
