//menlang.c

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "门廊");
  set("long", @LONG
武馆进大门后要往里走，必须穿过这个门廊。廊顶描绘着江南秀美的风景。
每两根翠绿色的柱子间相隔也就两三尺的距离，朱红色的琉璃瓦，嫩黄色的地
砖。门廊正中站着一个少年，看见你来了，他笑嘻嘻地迎了上来。往北走就进
入武馆的前院了。
LONG
  );

  set("exits", ([
    "north": __DIR__ "qianting",
    "west": __DIR__ "yiguan",
    "out": __DIR__ "damen",
  ]));

  set("no_fight", 1);

  set("objects", ([
    __DIR__ "npc/dizi4": 1,
  ]));

  setup();
}

int valid_leave(object me, string dir) {

  if ((me->query("combat_exp") < 3000) && (dir == "out" || dir == "west") && (present(
    "sun jun",
    environment(me)
  )))
    return notify_fail("孙坎上前把手一伸：江湖险恶，你还是在武馆学点东西再出去吧。\n");
  if (!me->query_temp("marks/离馆") && (dir == "out" || dir == "west") && (present(
    "sun jun",
    environment(me)
  )))
    return notify_fail("孙坎把手一伸，拦住你的去路：没有馆主老人家的同意，不得私自离馆。\n");
  if (((int)me->query_encumbrance() * 100 / (int)me->query_max_encumbrance() >= 50) && dir != "north" && (present(
    "sun jun",
    environment(me)
  )))
    return notify_fail("孙坎朝你嘿嘿一笑：带这么多东西出去干吗？\n");
  return ::valid_leave(me, dir);
}
