//cool 98.4.18
inherit ROOM;
#include <ansi.h>
void create()
{
        set("short", "小集市");
        set("long", @LONG
这里是武馆门前的一个小集市，人来人往，许多做小买卖的
人在不停的吆喝。人群中有不少小流氓在寻衅滋事，许多人都敢
怒不敢言。
LONG);
        set("exits", ([
              "north" : __DIR__"guanmen",
              "south" : "/d/xiangyang/eroad1",
        ]));
        set("objects", ([
           __DIR__"npc/liumang" : 1,
             ]));
               set("no_fight",1);
	set("outdoors", "武馆");
	setup();
}

int valid_leave(object me, string dir)
{
	int i;
	object *ob;

	if (present("xiao liumang", environment(me))){
         if(me->query("combat_exp") < 2500 && dir =="south") return notify_fail("小流氓不怀好意的在打量着你。\n")
;
	    ob = deep_inventory(me);
	    i = sizeof(ob);
	    while (i--)
	       if (ob[i]->is_character()) {
		   message_vision("只见小流氓悄悄在$N脚下使了个绊，$N措不及防摔了个狗啃泥，身上的$n掉了下来。\n", me, ob[i]);
		   me->unconcious();
		   return notify_fail("");
		   }
            }
	return ::valid_leave(me, dir);
}
