// chedl2.c 大理3
#include <ansi.h>
inherit ROOM;
void create() {
  set("short", HIY "车厢内" NOR);
  set("long", @LONG
干净舒服的车厢里，整洁的座位上铺着红色的锦缎。车前老车夫正在用力
地赶着马车，马行颠簸，但坐在车内，却并不感觉震荡。透过的车窗你能够欣
赏窗外优美的景色。
LONG
  );
  set("exits", ([
    "out": "/d/dali/dalics",
  ]));
  set("no_fight", 1);

  setup();
}
void init() {
  mapping fam;
  object me, room;
  me = this_player();
  room = this_object();
  message_vision(
    YEL "\n车夫把大车靠在路旁，大理城到了，快下车（out）吧。\n\n" NOR, me);
}
