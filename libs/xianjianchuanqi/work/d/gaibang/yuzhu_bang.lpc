// bamboo_stick.c 玉竹棒
// by shang 97/6

#include <ansi.h>
#include <weapon.h>

inherit STICK;

void create()
{
	set_name("玉竹棒", ({"yuzhu bang", "bang", "stick"}));
	set_weight(5000);
	init_stick(30);

	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "根");
		set("long", "一根泛着淡淡青光的竹杖。\n" "你可以揣摩(chuaimo)棒上所刻的武学。\n");
		set("value", 10000);
		set("material", "bamboo");
		set("wield_msg", "$N抽出一根青光闪闪的玉竹杖抓在手中。\n");
		set("unwield_msg", "$N把手中的玉竹杖插回腰中。\n");
	}
}	


void init()
{
        if( this_player() == environment() )
                add_action("do_chuaimo", "chuaimo");
                add_action("do_chuaimo", "揣摩");
      }

int do_chuaimo(string arg)
{
        int damage, i;

        object me = this_player();

        if ( arg != "bang" && arg != "stick" )
        return notify_fail("你要学什么？\n");
        if ( (int)me->query_skill("literate", 1) < 30 )
        return notify_fail("你的学识还没够领会棒上的口决。\n");

        if ( (int)me->query("int") < 25)
        return notify_fail("以你的悟性, 一辈子都无法揣摩棒上所刻的口诀。\n");

        if ( (int)me->query("combat_exp") < 50000 )
        return notify_fail("你的实战经验不足，再怎么揣摩也没用。\n");

        if ( (int)me->query_skill("stick", 1) < 60 )
        return notify_fail("你的基本棒法太差, 还领会不了棒决。\n");

        damage = 1000 / (int)me->query("int");
        me->receive_damage("jing", damage);
        me->receive_damage("jingli", damage);

        i = random(3);

        if (i < 2)
        return notify_fail("你兀自颠三倒四、缠七来八的揣摩不清。\n");

        me->improve_skill("bangjue", (int)me->query("int"));

        message_vision("$N看着棒上的字迹, 凝思不已。\n", me);
        return 1;
      }



