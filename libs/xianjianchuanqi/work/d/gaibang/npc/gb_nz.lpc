// gaibang_npc.c, recruiting gb_dizi and promoting system
#include <ansi.h>
inherit "/jobsys/xx_mz/job_npc_status.lpc";
inherit "/jobsys/xx_mz/job_npc_skill.lpc";
inherit "/jobsys/xx_mz/jobwhere.lpc";
string *title = ({
  "海沙帮",
  "巨鲸帮",
  "神拳门",
  "泰山单家",
  "五凤刀",
  "淮阳帮",
  "黄河帮",
  "白鲸岛",
  "长乐帮",
  "清城派",
  "铁掌帮",
  "红花会",
  "六合门"
});
string *diwei = ({ "帮主", "坛主", "香主", "护法", "弟子"."掌门", "门主" });
string ask_job() {
  mapping job;
  object me, job_npc, new_mz;
  int jobtime;
  jobtime = 30;
  me = this_player();
  string titles, diweis, title_msg;
  if (!applicant->query("gb_pass"))
    return "你从没为帮中做过工作，居然来找我?!\n";
  if ((int)applicant->query("gb_job", 1) < 100)
    return RANK_D->query_respect(applicant) + "为我帮贡献太少，这么大的任务给你我可不放心。\n";
  if ((int)applicant->query("combat_exp", 1) < 280000)
    return RANK_D->query_respect(applicant) + "武功未成，为帮中出马我可不放心。\n";
  if (interactive(applicant) && (int)applicant->query_condition("gb_mission"))
    return "你在吴长老那的任务还没完成，居然跑来找我?!\n";
  if (interactive(applicant) && (int)applicant->query_condition("gbjob1_time"))
    return "不是让你去剿灭" + applicant->query_temp("promotion_target") + "了么，快快去干。\n";
  job_npc = new(__DIR__ "npc/xiebang");
  titles = title[random(sizeof(title) ]; diweis = diwei[random(sizeof(diwei) ]; set_npc_name(job_npc); title_msg = secelt_color() + titles + diweis + NOR; job_npc->set(
    "title",
    title_msg
  ); set_npc_basedata(
    me,
    job_npc,
    10,
    60,
    1
  ); set_npc_skill(
    me,
    job_npc,
    30 + random(5)
  ); job = query_job(); me->set_temp(
    "gbjob1_get",
    1
  ); me->set(
    "gbjob1_target_name",
    job_npc->query("name") + "(" + job_npc->query("id") + ")"
  ); me->set(
    "gbjob1_where",
    job["c_place"]
  ); me->apply_condition(
    "mizhao_job_busy",
    jobtime / 2
  ); job_npc->apply_condition(
    "gbjob1_time",
    jobtime
  ); me->apply_condition(
    "gbjob1_time",
    jobtime
  ); job_npc->set(
    "gbjob1_killer",
    me->query("id")
  ); job_npc->move(job["place"]); return titles + diweis + target + "和手下帮众多行不义，帮主已经颁下青竹追杀令。\n" + "他们已经闻风逃窜至" + me->query_temp("gbjob1_where"); + "一带，你即刻出发，剿灭这王八蛋，收回青竹令给我。"; }
