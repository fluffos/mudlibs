inherit NPC;
inherit F_MASTER;
string ask_yao();
string ask_staff();
inherit __DIR__"gaibang_npc.lpc";
void create()
{
        set_name("奚长老", ({"xi zhanglao", "xi", "zhanglao"}));
        set("title", "丐帮九袋长老");
        set("gender", "男性");
        set("age", 60);
        set("long", 
       "他乃丐帮六大长老之一,一根钢杖使得出神入话。\n");
        set("attitude", "peaceful");
        set("str", 25);
        set("int", 18);
        set("con", 20);
        set("dex", 20);
        set("apprentice",1);
        set("qi", 1000);
        set("max_qi", 1000);
       set("jing", 600);
        set("max_jing", 600);
        set("neili", 1400);
        set("max_neili", 1400);
        set("jiali", 100);
        
        set("combat_exp", 500000);
        
        set_skill("force", 120); // 基本内功
        set_skill("huntian-qigong", 120); // 混天气功
        //set_skill("strike", 95); // 基本拳脚
        set_skill("dodge", 120); // 基本躲闪
        set_skill("xiaoyaoyou", 120); // 千里行乞 
        set_skill("parry", 120); // 基本招架
        set_skill("staff", 140);
        set_skill("hand", 120);
        set_skill("suohou-shou",120);
        set_skill("fengmo-zhang",150);
        set_skill("begging", 90);
        map_skill("force", "huntian-qigong");
        map_skill("parry","fengmo-zhang");
        map_skill("staff","fengmo-zhang");
        map_skill("dodge", "xiaoyaoyou");
        
        create_family("丐帮", 18, "九袋长老");
        set("yao_count", 12);
		 set("book_count", 1);
        set("inquiry", ([
                "丐帮" : "我们丐帮是天下第一大帮！\n",
                "乔峰" : "唉。。。乔。。。他小以前还跟过我学掌法呢。\n",
                "萧峰" : "他不就是乔峰，我们的前任帮主。\n",
                "学掌法" : "那都是很多年前的事了，他那时常到附近的一个小岛\n"
                         "上埋头苦练。\n",
                "伤药" : (: ask_yao :),
				"学杖法" : (: ask_staff :),
				"练杖法" : (: ask_staff :),
				"小岛" : "我老了，以前的事也不记得太清楚了，好象是在泉洲附近吧。\n",
        ]));
        setup();
        carry_object(__DIR__"obj/gb_budai9")->wear();
        carry_object(__DIR__"obj/gangzhang")->wield(); 
}


void attempt_apprentice(object ob)
{
        gb_apprentice(ob);        
}
string ask_yao()
{
        mapping fam; 
   
        if (!(fam = this_player()->query("family")) || fam["family_name"] != "丐帮")
                return RANK_D->query_respect(this_player()) + 
                "非我丐帮好汉，不知此话从何谈起？";

        if ( (int)this_player()->query("max_neili" ) < 100)
                return RANK_D->query_respect(this_player()) + 
                "目前武功还没有根基，伤药留给更需要它的帮中兄弟吧。";

        if (  present("gaibang shangyao", this_player()) )
                return RANK_D->query_respect(this_player()) + 
                "伤药很珍贵，你身上还有，还是留一些给其他帮中兄弟吧，丐帮弟子最讲义气。！";
        if (query("yao_count") < 1) return "目前伤药没有了，等会吧";

        new("/d/gaibang/npc/obj/yao")->move(this_player());

        add("yao_count", -1);

        message_vision("$N获得一包丐帮伤药。\n",this_player());
        return "我这里有一包丐帮伤药，功效显著，你拿去护身吧。";

}
string ask_staff()
{
        mapping fam = this_player()->query("family");
        object ob;
        
        if(!fam || fam["family_name"] != "丐帮")
           return RANK_D->query_respect(this_player())+"自己练吧，问我做什么？";
         if(this_player()->query_skill("staff",1) > 30)
           return "你的杖法已经有一定基础了，我这里没什么东西可以辅助你了。";
                if(query("book_count") < 1)
           return "你来晚了，我的那张图已经送给他人了。";
        add("book_count", -1);
       ob = new("/d/gaibang/npc/obj/pic_staff");
       ob->move(this_player());
        return "好吧，这副图画你拿回去好好揣摩下。";
}