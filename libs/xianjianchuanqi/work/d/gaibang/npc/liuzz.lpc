inherit NPC;

int action_1();
int action_2();

void create()
{
	set_name("刘竹庄", ({"liu zhuzhuang", "liu" }));
	set("title", "丐帮五袋弟子");
	set("gender", "男性");
	set("age", 28);
	set("long", 
       "他是丐帮五袋弟子，大智分舵属下帮众。\n");
	set("attitude", "peaceful");
	set("shen_type", -1);
	set("str", 25);
	set("int", 20);
	set("con", 25);
	set("dex", 25);

	set("qi", 600);
	set("max_qi", 600);
	set("jing", 300);
	set("max_jing", 300);
	set("neili", 600);
	set("max_neili", 600);
	set("jiali", 50);
	
	set("combat_exp", 60000);
	
	set_skill("force", 60); // 基本内功
	set_skill("huntian-qigong", 60); // 混天气功
	set_skill("strike", 60); // 基本拳脚
        set_skill("dodge", 60); // 基本躲闪
        set_skill("xiaoyaoyou", 60); // 千里行乞 
	set_skill("parry", 60); // 基本招架
	
	map_skill("force", "huntian-qigong");
	map_skill("dodge", "xiaoyaoyou");
	
	create_family("丐帮", 20, "五袋弟子");
	set("inquiry", ([
		"丐帮" : "我们丐帮是天下第一大帮！\n",
		"全冠清" : (: action_1 :),
		"图画" : (: action_2 :),
	]));
	setup();
	set("count",1);
	carry_object(__DIR__"obj/gb_budai5")->wear();
}

int action_1()
{
	object who = this_player();
	who->set_temp("marks/刘1", 1);
	command("say 啊，不关我的事，是全...他...");
	return 1;
}	

int action_2()
{
	object who = this_player();
	object obj;
	if ( !who->query_temp("marks/刘1") ) {
		command("say 这个...我不清楚。");
		return 1;
	}
	else {
		if (this_object()->query("count") < 1) {
			command("say 我不是给了你了吗？");
			who->delete_temp("marks/刘1");
		}
		else {
			command("say 冤枉呀，是全舵主要我干的。");
			command("say 你把它给你了，放过我吧。");
			command("cry");
			obj=new(__DIR__"obj/book-pic");
			obj->move(who);
			message_vision("刘竹庄拿出一幅图画交了给$N。\n", 
				        who);
			who->delete_temp("marks/刘1");
			add("count",-1);
		}	
		return 1;
	}
}

