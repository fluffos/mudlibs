// by snowcat 10/05/1997
// zhangmen.c 掌门
//modified for shushan

inherit NPC;
inherit F_SAVE;


void create()
{
	set_name("大弟子", ({ "zhang men", "zhangmen" }) );
	set("gender", "男性" );
	set("age", 30);
	set("str", 30);
	set("per", 30);
	set("int", 30);
	set("long", "掌门大弟子。" );
	set("attitude", "heroism");
	set("combat_exp", 100000);
	set("daoxing", 100000);
	set("current_player","none of us");

	setup();

	carry_object("/d/obj/cloth/linen")->wear();
}

void init()
{
	object me = this_object();

        me->create_identity("/d/shushan/npc/jiansheng", "/d/shushan/dadian");
	
	add_action("do_bandage","bandage");

	if (me->query("current_player")=="none of us")
		me->reset_me(me);    
	me->restore();
	me->fully_recover(me);

	me->set("inquiry", ([
		"name" : "蜀山掌门大弟子！\n",
		"here" : "自己看。\n",
		"掌门大弟子" : (: zm_apply :),		
		"掌门弟子" : (: zm_apply :),	
		"大弟子" : (: zm_apply :),	
		"掌门" : (: zm_apply :),	 
	]) );

	me->setup();
}


