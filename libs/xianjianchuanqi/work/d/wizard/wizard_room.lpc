// Room: /d/wizard/wizard_room.c

inherit ROOM;
#include <ansi.h>
void create() {
  set("short", "巫师休息室");
  set("long",
    "这里就是「" + MUD_NAME + "」巫师的休息所在，刚粉刷过的四周墙壁上光\n"
    "秃秃的什么都没有，屋子的正中央放着一张楠木桌，上面摆着一本厚厚的\n"
    "巫师留言簿(board)。旁边有巫师守则(wizrules)。屋子最上方写着两行字\n"
    WHT "任何人在任何情况下不能随意更改玩家数据\n"
    "任何人在任何情况下违反天条都将受到惩罚\n" NOR);

  set("exits", ([
    "up": __DIR__ "zoulang",
    "enter": "/adm/etc/admin_room",
    "down": __DIR__ "guest_room",
    "east": __DIR__ "wizard_meet",
    "north": "/d/wizard/news_room",
  ]));
  set("item_desc", ([
    "wizrules": "巫师行为总则
一、除非有玩家违反了玩家规则，巫师不能以任何理由参与、干涉玩家
正常的游戏，不能随意改动或删除某位玩家的档案。
二、巫师不能以任何理由向玩家和其它 Mud透露游戏机密；不能随意以
各种借口向玩家提供任何好处。
三、低级巫师要尊重高级巫师，高级巫师要善待低级巫师。巫师之间有
不同的意见时，不得在玩家面前发生争执，可在巫师频道讨论解决。讨
论未能取得一致意见时，低级巫师当时必须服从高级巫师的决定，之后
可要求巫师会议仲裁。
四、不能擅自将自己的巫师帐号借给别人使用, 不能保留另一玩家帐号。
任何巫师不能在其他中文 mud担任巫师。 
五、巫师的吸收由Approval Department 部门负责引荐，然后由巫师投
票决定，任何人无权擅自吸收提升巫师。
六、不能擅自改动游戏的基本设计, 任何(arch)或 (admin)想修改基本
文件, 必须先公布修改内容, 修改步骤。任何(arch)或 (admin)要修改
其他(arch)或 (admin)主管的程序、必须告知修改内容, 修改步骤。
七、任何巫师不允许通过任何手段越级别使用高级别巫师才可以使用的
指令。
九、任何巫师不许上传任何不法和与工作无关的程序。
十、克隆还魂丹等物品必须post用途。\n",
  ]));
  set("no_save", 1);
  set("no_fight", 1);
  setup();

  call_other("/clone/board/wiz_b", "???");
}

void init() {
  object ob = this_player();

  if (userp(ob) && !wiz_level(ob)) {
    ob->move("/d/wizard/guest_room");
    message_vision("$N从巫师休息室重重地摔了下来。\n", ob);
    ob->unconcious();
  }
}

int valid_enter(int t) {
  return 0;
}
