#include <ansi.h>
inherit NPC;
object pkerob=this_object();

string *stdskillclass=({"dodge","force","parry","unarmed"});
string *wudangskillclass=({"tiyunzong","yinyun-ziqi","taiji-quan"});    
string *shaolinskillclass=({"shaolin-shenfa","yijin-jing","yizhi-chan"});    
string *huashanskillclass=({"huashan-shenfa","zixia-gong","huashan-jianfa"});    
string *mingjiaoskillclass=({"piaoyi-shenfa","shenghuo-shengong","shenghuo-ling"});    
string *quanzhenskillclass=({"huashan-shenfa","zixia-gong","huashan-jianfa"});  
string *xiaoyaoskillclass=({"lingboweibu","beiming-shengong","huashan-jianfa"});    
string *xuedaoskillclass=({"piaoyi-shenfa","longxiang-gong","huashan-jianfa"});    
string *gaibangskillclass=({"xiaoyaoyou","huntian-qigong","xianglong-zhang"});
string *baituoskillclass=({"chanchu-bufa","hamashengong","shexing-diaoshou"});
string *taohuaskillclass=({"suibo-zhuliu","bihai-chaosheng"});
string *xingxiuskillclass=({"huagong-dafa","taiji-jian"});
int set_std_skills (int level,object pkerob)
{
   pkerob->set_skill("dodge",level);
   pkerob->set_skill("parry",level);
   pkerob->set_skill("force",level);
   pkerob->set_skill("sword",level);
}

int set_pker_skills (int level,object pkerob,string *str)
{
   int i;
   for (i=0;i<3;i++)
    {
      pkerob->set_skill(str[i],level);
      pkerob->map_skill(stdskillclass[i],str[i]);
    }       
} 

int set_wudang_pker(int level,object pkerob)
{
   set_pker_skills(level,pkerob,wudangskillclass);
   pkerob->set("gender","男性");
   pkerob->set_skill("sword",level);
   pkerob->set_skill("taiji-jian",level);
   pkerob->set_skill("cuff",level);
   pkerob->set_skill("taiji-quan",level);
   pkerob->map_skill("sword","taiji-jian");
   pkerob->map_skill("cuff","taiji-quan");
pkerob->map_skill("parry","taiji-jian");
   pkerob->prepare_skill("cuff","taiji-quan");   
carry_object("/clone/weapon/gangjian")->wield();
   set("chat_chance_combat",40);
   set("chat_msg_combat", ({
                (: perform_action, "sword.sanhuan" :),
                (: perform_action, "sword.chan" :),
                (: exert_function, "qi" :),
       }) );

}
int set_shaolin_pker(int level,object pkerob)
{
   set_pker_skills(level,pkerob,shaolinskillclass);
   pkerob->set("gender","男性");
   pkerob->set_skill("sword",level);
   pkerob->set_skill("damo-jian",level);
 pkerob->set_skill("claw",level);
   pkerob->set_skill("longzhua-gong",level);
pkerob->map_skill("claw","longzhua-gong");   
pkerob->map_skill("sword","damo-jian");
pkerob->map_skill("parry","damo-jian");
 pkerob->prepare_skill("claw","longzhua-gong");   
carry_object("/clone/weapon/gangjian")->wield();
   set("chat_chance_combat",40);
   set("chat_msg_combat", ({
                (: perform_action, "sword.sanjue" :),
                (: exert_function, "recover" :),
       }) );
}
int set_huashan_pker(int level,object pkerob)
{
   set_pker_skills(level,pkerob,huashanskillclass);
   pkerob->set("gender","男性");
     pkerob->set_skill("strike",level);
   pkerob->set_skill("hunyuan-zhang",level);
   pkerob->map_skill("strike","hunyuan-zhang");
   pkerob->set_skill("sword",level);
   pkerob->set_skill("huashan-jianfa",level);
   pkerob->map_skill("sword","huashan-jianfa");
  pkerob->map_skill("parry","huashan-jianfa");
 pkerob->prepare_skill("strike","hunyuan-zhang");   
carry_object("/clone/weapon/gangjian")->wield();
   set("chat_chance_combat",30);
   set("chat_msg_combat", ({
                (: perform_action, "sword.jianzhang" :),
               (: perform_action, "sword.sanxian" :),
                (: exert_function, "recover" :),
       }) );
}
