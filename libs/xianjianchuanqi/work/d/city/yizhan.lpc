int valid_leave(object me, string dir)
{
object ob;
if (!objectp(ob=present("mailbox",me)))
	return ::valid_leave(me, dir);
	me->delete_temp("get_mailbox");
	destruct(ob);
	return ::valid_leave(me, dir);
}
