#include <command.h>
#include <ansi.h>
inherit "/d/city/job/npcskill";
int time_period(int timep, object me);
int accountpkerexp(int turn, object who);
int pkerf(int turn, object who);
int pkerm(int turn, object who);
int set_pker_qi_jing(int turn, object pker);
int accountlevel(int turn, object who);
mapping userskills;
string *npcs = ({
  "pker",
});
mapping default_dirs = ([
  "north": "北", "south": "南", "east": "东", "west": "西", "northup": "北边", "southup": "南边", "eastup": "东边", "westup": "西边", "northdown": "北边", "southdown": "南边", "eastdown": "东边", "westdown": "西边", "northeast": "东北", "northwest": "西北", "southeast": "东南", "southwest": "西南", "up": "上", "down": "下", "enter": "里", "out": "外",
]);
mapping alias_dirs = ([
  "n": "north", "s": "south", "e": "east", "w": "west", "nu": "northup", "su": "southup", "eu": "eastup", "wu": "westup", "nd": "northdown", "sd": "southdown", "ed": "eastdown", "wd": "westdown", "ne": "northeast", "se": "southeast", "nw": "northwest", "sw": "southwest", "u": "up", "d": "down",
]);
void create() {
  string *ordera = ({ "张", "王", "李", "赵", "孙", "徐", "郑", "周", "吴",
    "蒋", "沈", "杨", "独孤", "欧阳", "金", "魏", "陶", "俞", "柳", "朱", "宋" });
  string *orderb = ({ "大", "二", "三", "云", "飞", "刚", "康", "泰",
    "十八", "刑天", "无敌", "月", "风", "无双", "扬", "风" });
  string renzhiname;
  int pkerlevel; object who = this_player(); object pkerob; int turn = 5; pkerlevel = accountlevel(
    turn,
    who
  ); pkerob = this_object(); renzhiname = ordera[random(20)] + orderb[random(11)]; set(
    "nname",
    renzhiname
  ); set_name(
    renzhiname,
    ({ "man" })
  ); set(
    "long",
    "这是一个被追杀的人，他非常害怕的看着左右。\n"
  ); set(
    "gender",
    "男性"
  ); set("per", 10); set("age", 60); set("no_suck", 1); set_temp("apply/armor", 100);
  set(
    "no_get",
    1
  ); pkerob->set(
    "max_neili",
    (int)who->query("max_neili") * 6 / 5
  ); pkerob->set(
    "neili",
    (int)who->query("max_neili") * 6 / 5
  ); pkerob->set(
    "jiali",
    100
  ); pkerob->set(
    "max_jingli",
    (int)who->query("max_jingli") * 6 / 5
  ); pkerob->set(
    "jingli",
    (int)who->query("jingli") * 6 / 5
  ); pkerob->set(
    "combat_exp",
    (int)who->query("combat_exp") * 4 / 5
  ); pkerob->set(
    "neili_factor",
    (int)(pkerlevel / 2)
  ); pkerob->set(
    "jingli_factor",
    (int)(pkerlevel / 2)
  ); set_pker_qi_jing(
    turn,
    pkerob
  ); pkerob->setpkerskill(
    pkerlevel,
    pkerob
  ); setup(); carry_object(this_object()->query("bingqi"))->wield();
  carry_object("/d/city/npc/obj/tiejia")->wear();
}

void init() {
  call_out("des", 700); add_action("do_move", "move"); add_action("do_job", "job");
}
int des() {
  message_vision(
    (string)this_object()->query("nname") + "左右看了一下,丢下你向前继续前进。\n",
    this_object()
  ); destruct(this_object()); return 1;
}
int do_job() {
  mapping job; object me = this_player(); int nowtime = time(); job = me->query("fjob"); if (!job) return 0; if (query("owner") != me->query("id")) return 0; nowtime = (int)me->query("fjob_time") - time(); write("你现在的任务是护送" + (string)this_object()->query("nname") + "到" + "『" + job["target_name"] + "』。\n");
  if (nowtime > 0) time_period(nowtime, me); else
    write("但是你已经没有足够的时间来完成它了。\n");
  return 1;
}
int time_period(int timep, object me) {
  int t, d, h, m, s; string time; t = timep; s = t % 60; t /= 60; m = t % 60; t /= 60; h = t % 24; t /= 24; d = t;
  if (d) time = chinese_number(d) + "天"; else time = ""; if (h) time += chinese_number(h) + "小时"; if (m) time += chinese_number(m) + "分"; time += chinese_number(s) + "秒"; tell_object(
    me,
    "你还有" + time + "去完成它。\n"
  );
  return 1;
}
int des_renzhi() {
  object me; remove_call_out("des_renzhi"); if (!(me = present(
    query("owner"),
    environment(this_object())
  ))) {
    message_vision(
      HIG "一群蒙面杀手冲了过来，把" + (string)this_object()->query("nname") + "捉走了。\n" NOR,
      this_object()
    ); destruct(this_object()); return 1;
  }
  call_out("des_renzhi", 10);
}
int do_move(string arg) {
  mapping exit, job; string dest, dir, min, mout; object me = this_player(), env, obj, killer, who, gold, npc; int dex, i, count; env = environment(me);
  if (query("owner") != me->query("id")) return 0;
  if (!arg) return notify_fail("你要把" + (string)this_object()->query("name") + "送到哪里去？\n");
  if (!undefinedp(alias_dirs[arg]))
    arg = alias_dirs[arg];
  if (!mapp(exit = env->query("exits")) || undefinedp(exit[arg]))
    return notify_fail("这个方向没有出路。\n");
  if (me->is_fighting())
    return notify_fail((string)this_object()->query("nname") + "说道:你先帮我把杀手杀了再说吧？\n");
  if (objectp(who = present("pker", environment(me)))) {
    if (living(who))
      return notify_fail(HIW "有人要抢劫，你要先保护" + (string)this_object()->query("nname") + "呀！\n" NOR);
  }
  if (!env->valid_leave(me, arg)) return 0;
  if (!undefinedp(default_dirs[arg]))
    dir = default_dirs[arg];
  else
    dir = arg;
  dest = exit[arg];
  obj = load_object(dest);
  mout = HIY "$N带着" + (string)this_object()->query("nname") + "，小心翼翼的向" + dir + "走去。\n" NOR;
  min = HIY "" + (string)this_object()->query("nname") + "小心翼翼的走了过来。\n" NOR;
  message_vision(mout, me);
  GO_CMD->main(
    me,
    arg
  ); dex = me->query("dex"); job = me->query("fjob"); if (this_object()->move(obj)) {
    call_out("des_che", 1); message_vision(min, me); if (me->query("fjob_time") < time()) {
      call_out("des_che", 10); return 1;
    }
    if (job && job["target_path"] == file_name(obj)) {
      gold = new("/clone/money/gold"); message_vision(
        "$N大声喝道：" + job["npc_title"] + "的" + job["job"] + "在吗？我护送" + (string)this_object()->query("nname") + "来了.\n",
        me
      ); if (!(npc = present(job["npc_id"], environment(me)))) {
        npc = new(job["npc_path"]); npc->move(environment(me)); message_vision(
          "$N急步走了过来。\n",
          npc
        ); call_out("des_npc", 2, npc);
      }
      message_vision(
        job["job"] + "答道：原来是江湖接济站的朋友来了,\n这里有点银子请收下暂做酬劳。" + job["job"] + "拿出来了一些银子交给了$N。\n",
        me
      ); gold->set_amount(10000); gold->move(me); me->set(
        "fend_job",
        1
      ); destruct(this_object()); return 1;
    } else if (3 + random(dex) < 12 && environment(me)->query("outdoors")) {
      count = random(2) + 1; if (count <= 0) count = 1; for (i = 0; i < count; i++) {
        killer = new("/d/city/job/pker"); killer->move(environment(me)); killer->kill_ob(this_object());
      }
      message_vision(
        HIR "忽然间从道两边跳出一群蒙面杀手！\n" NOR,
        this_object()
      ); message_vision(
        "$N对着" + (string)this_object()->query("nname") + "冷笑到：看你这次往那里逃?\n",
        killer,
        me
      ); message_vision(
        HIG "看起来蒙面杀手想杀死" + (string)this_object()->query("nname") + "!\n",
        killer,
        me
      );
    }
    return 1;
  }
  return 0;
}
int des_npc(object npc) {
  message_vision("$N保护着" + (string)this_object()->query("nname") + "离开了。\n", npc);
  destruct(npc);
  return 1;
}
int max_skill_level(object pkerob) {
  int s, i = 0, maxlevel = 1;
  string *str;
  userskills = pkerob->query_skills();
  if (!mapp(userskills)) { maxlevel = 3; return maxlevel; }
  str = keys(userskills);
  s = sizeof(str);
  if (s < 2) return userskills[str[0]];
  while (s > 0) {
    s -= 1;
    i = userskills[str[s]];
    if (i > maxlevel) maxlevel = i;
  }
  return maxlevel;
}

int accountlevel(int turn, object pkerob) {
  int level;
  level = max_skill_level(pkerob);
  level = (int)level * (70 + turn * 4) / 120;
  return level;
}

int accountpkerexp(int turn, object who) {
  int userexp, pkerexp;
  userexp = who->query("combat_exp");
  pkerexp = userexp;
  return pkerexp;
}

int pkerf(int turn, object who) {
  int userneili, pkerneili;
  userneili = who->query("max_neili");
  pkerneili = userneili * 2 / 3;
  return pkerneili;
}

int pkerm(int turn, object who) {
  int userjingli, pkerjingli;
  userjingli = who->query("max_jingli");
  pkerjingli = userjingli * (70 + turn * 5) / 80;
  return pkerjingli;
}

int set_pker_qi_jing(int turn, object pker) {
  int maxqi, maxjing;
  maxqi = 200 + (int)pker->query("max_neili") * 100 / 200;
  maxjing = 200 + (int)pker->query("max_jingli") * 100 * 4 / 1000;
  pker->set_temp("maxqi", maxqi);
  pker->set("max_qi", maxqi * 2);
  pker->set("eff_qi", maxqi * 2);
  pker->set("qi", maxqi * 2);
  pker->set("max_jing", maxjing);
  pker->set("eff_jing", maxjing);
  pker->set("jing", maxjing);
  return 1;
}

int setpkerskill(int level, object pkerob) {
  set_std_skills(level, pkerob); switch (random(8)) {
    case 0: set_wudang_pker(level, pkerob); break;
    case 1: set_shaolin_pker(level, pkerob); break;
    case 2: set_huashan_pker(level, pkerob); break;
    case 3: set_quanzhen_pker(level, pkerob); break;
    case 4: set_xiaoyao_pker(level, pkerob); break;
    case 5: set_gaibang_pker(level, pkerob); break;
    case 6: set_xuedao_pker(level, pkerob); break;
    case 7: set_baituo_pker(level, pkerob); break;
    case 8: set_mingjiao_pker(level, pkerob); break;
    case 9: set_xingxiu_pker(level, pkerob); break;
    case 10: set_taohua_pker(level, pkerob); break;
    case 11: set_baituo_pker(level, pkerob); break;
  }
}
