//snake.c
#include <ansi.h>
inherit NPC;

void create() {
  set_name("毒蛇", ({ "snake", "she" }));
  set("race", "野兽");
  set("age", 20);
  set("long", "一只身子细长的小蛇，它的舌头不停从嘴里吐出,好象随时要咬你一口。\n");
  set("attitude", "aggressive");
  set("qi", 200);
  set("max_qi", 200);
  set("jing", 100);
  set("max_jing", 100);
  set("str", 10);
  set("cor", 20);
  set("limbs", ({ "头部", "身体", "七寸", "尾巴" }));
  set("verbs", ({ "bite" }));

  set("combat_exp", 1000 + random(10000));
  set_temp("apply/attack", 20 + random(70));
  set_temp("apply/damage", 20 + random(70));
  set_temp("apply/armor", 10 + random(40));
  set_temp("apply/defence", 10 + random(30));

  setup();
}

void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  object *work, me;
  int i;
  me = this_object();
  work = all_inventory(environment(me));
  for (i = 0; i < sizeof(work); i++) {
    if (!living(work[i]) || work[i] == me) continue;
    me->kill_ob(work[i]);
  }
  // command("kill guanjia");
}

int hit_ob(object me, object ob, int damage) {
  if ((int)ob->query("combat_exp") > 10000) return 1;
  if (random(damage) > (int)ob->query_temp("apply/armor")
    && (int)ob->query_condition("snake_poison") < 10) {
    ob->apply_condition("snake_poison", 20);
    tell_object(ob, HIG "你觉得被咬中的地方一阵麻木！\n" NOR);
  }
}
