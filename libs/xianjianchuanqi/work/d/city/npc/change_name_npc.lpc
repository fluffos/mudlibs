// chang_name_npc.c
// create by Leonardo@xjkx2k

#include <ansi.h>
inherit NPC;

int ask_change();
int ask_pay();
int check_legal_name(object ob, string name);

string *banned_name = ({
  "自己", "杀手", "闪电", "寒雨", "燃情岁月", "雪人", "大富豪",
  "某人", "尸体", "金庸", "我们", "你们", "他们", "大家",
  "他妈的", "去你的", "毛泽东", "邓小平", "江泽民", "巫师",
  "中神通", "书剑", "逸仙", "邓小刀", "浪子强",
});

void create() {
  set_name("管事", ({ "guan shi", "guan", "shi" }));
  set("long", "........\n");          // 我自己懒得写了，你们加吧

  set("inquiry", ([
    "改名": (: ask_change :),
    "手须费": (: ask_pay :),
    "money": (: ask_pay :),
  ]));
  setup();
}
int ask_change() {
  object ob;
  ob = this_player();
  if (ob->query_temp("pay_ok")) {
    add_action("do_change", "change");
    tell_object(ob, "你现在可以用 " + HIW "change XXXX" NOR + " 命令来改名字。\n");
    return 1;
  }
  say("请你先给我钱再说。\n");
  return 0;
}
int ask_pay() {
  int times, money, gold;
  object ob;

  ob = this_player();
  times = ob->query("change_name_times");
  money = times * 20000;
  gold = times * 200;
  if (times < 1) {
    command("say 你想改名？看你是第一次改名就便宜点吧。");
    tell_object(ob, "管事小声的告诉你：你给我" + HIW "200" NOR + "两黄金吧。\n");
    ob->set_temp("change_name_money", 20000);
    return 1;
  } else {
    command("say 你想改名？好吧，让我算算你应该拿多少黄金。");
    tell_object(ob, "管事小声的告诉你：你给我" + HIW + chinese_number(gold) + NOR "两黄金吧。\n");
    ob->set_temp("change_name_money", money);
    return 1;
  }
}
int accept_object(object who, object ob) {
  if (ob->query("money_id") && (ob->value() >= who->query_temp("change_name_money"))) {
    tell_object(who, HIC "你现在(ask guan shi about 改名) 吧。\n" NOR);
    who->set_temp("pay_ok", 1);
    return 1;
  }
  tell_object(who, "管事说道：谢谢您哩……\n");
  return 0;
}
int do_change(string arg) {
  object ob;
  ob = this_player();
  if (!ob->query_temp("pay_ok")) return 0;
  if (!stringp(arg)) return 0;
  if (!check_legal_name(ob, arg)) {
    write("对不起，请您用「中文」取名字。\n");
    return 0;
  }
  shout(HIC "【管府通告】" + ob->query("name") + "已经改名为" + arg + "。\n" NOR);
  write(HIC "【管府通告】" + ob->query("name") + "已经改名为" + arg + "。\n" NOR);
  ob->set("name", arg);
  ob->add("change_name_times", 1);
  ob->delete_temp("pay_ok");
  return 1;

}
int check_legal_name(object ob, string name) {
  int i;

  i = strlen(name);

  if (i < 4 || i > 8 || i % 2) {
    write("对不起，您的中文名字必须是 2 到 4 个中文字。\n");
    return 0;
  }

  while (i--)
    if (i % 2 == 0 && !is_chinese(name[i..<0])) {
      write("对不起，请您用「中文」取名字。\n");
      return 0;
    }

  if (!wiz_level(ob->query("id"))
    && member_array(name, banned_name) != -1) {
    write("对不起，这种名字会造成其他人的困扰。\n");
    return 0;
  }

  return 1;
}
