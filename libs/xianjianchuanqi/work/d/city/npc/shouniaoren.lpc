inherit NPC;

void create()
{
	set_name("老头", ({ "lao tou", "lao" }));
	set("title", "收鸟人");
	set("shen_type", 1);

	set("str", 30);
	set("gender", "男性");
	set("age", 50);
	set("long",
		"他是一个驼背的老人，不声不响的站在那里。\n"
		"据说，他很喜欢小鸟。常常用钱来换。\n");
	set("combat_exp", 500);
	set("attitude", "friendly");
	set("inquiry", ([
		"小鸟" : "你有鸟么？\n",
	]));
	setup();
}

int accept_object(object me, object obj)
{
object n_money;
int money;
money=me->query("birthday")/100000000+random(10)*5;
if (obj->query("id")=="xiao niao")
{
tell_object(me,"老人说道：哦，好好好，多可爱的鸟啊，我出"+chinese_number(money)+"文铜板和你换好不好？\n");
message_vision("老人说罢，塞给$N一些铜板。\n",me);
n_money = new("/clone/money/coin");
n_money->move(this_player());
n_money->add_amount(money);
(destruct(obj));
return 1;
}
}
