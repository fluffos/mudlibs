//zhengqiyun 郑起云
 
inherit NPC;
 
void create()
{
        set_name("郑起云", ({ "zheng qiyun", "zheng", "qiyun" }));
        set("nickname", "长鲸帮帮主");
        set("long", "一个魁梧之极的大汉，脸庞极尽苍桑，精神却甚矍铄。\n");
        set("gender", "男性");
        set("age", 32);
        set("attitude", "peaceful");
        set("shen", 10000);
        set("str", 20+random(10));
        set("int", 35+random(10));
        set("con", 25+random(10));
        set("dex", 27+random(10));
        
        set("max_qi", 2500+random(2000));
        set("max_jing", 2500+random(2000));
        set("jiali", 120);
        set("combat_exp", 1200000+random(800000)); 
         
        set_skill("force", 160+random(50));
        set_skill("hook", 180+random(50));
        set_skill("dodge", 190+random(50));
        set_skill("parry", 190+random(50));
        set_skill("leg", 180+random(50));

        set_skill("dulong-dafa", 180+random(50));
        set_skill("youlong-shenfa", 190+random(50));
        set_skill("canglang-goufa", 180+random(50));
        set_skill("ruying-suixingtui", 180+random(50));
        
        map_skill("force", "dulong-dafa");
        map_skill("dodge", "youlong-shenfa");
        map_skill("hook", "canglang-goufa");
        map_skill("leg", "ruying-suixingtui");
        map_skill("parry", "canglang-goufa");
        
        prepare_skill("leg", "ruying-suixingtui");
 
        setup(); 
        carry_object("/d/sld/npc/obj/hook")->wield();
        carry_object("/clone/misc/cloth")->wear();
        add_money("gold", 1);
}

#include "/d/city/npc/job/npc.h"
