//范一飞 fanyifei.c
 
inherit NPC;
 
void create()
{
        set_name("范一飞", ({ "fan yifei", "fan", "yifei" }));
        set("nickname", "鹤笔门掌门人");
        set("long", 
        "他是一个矮瘦的老者，一张黑脸。
        腰里插着判官笔，人称‘辽东鹤’。\n");
        set("gender", "男性");
        set("age", 52);
        set("attitude", "peaceful");
        set("shen", 10000);
        set("str", 30);
        set("int", 35);
        set("con", 25);
        set("dex", 27);
        
        set("max_qi", 2500);
        set("max_jing", 2500);
        set("jiali", 120);
        set("combat_exp", 1350000); 
         
        set_skill("force", 160);
        set_skill("yijin-jing", 180);
        set_skill("dodge", 190);
        set_skill("longzhua-gong", 160);
        set_skill("parry", 190);
        set_skill("shaolin-shenfa", 190);
        set_skill("cuff", 180);
        set_skill("claw", 180);
        set_skill("jingang-quan", 180);
        set_skill("literate", 150);
        set_skill("brush", 180);
        set_skill("yingou-bifa", 180);
        set_skill("yizhi-chan", 180);
        set_skill("finger", 150);
        map_skill("force", "yijin-jing");
        map_skill("dodge", "shaolin-shenfa");
        map_skill("finger", "yizhi-chan");
        map_skill("brush", "yingou-bifa");
        map_skill("claw", "longzhua-gong");
        map_skill("parry", "jingang-quan");
        prepare_skill("claw", "longzhua-gong");
        prepare_skill("finger", "yizhi-chan");
 
        setup(); 
        carry_object("/d/tiezhang/obj/tiebi")->wield();
        carry_object("/clone/misc/cloth")->wear();
        add_money("gold", 1);
}

#include "/d/city/npc/job/npc.h"
