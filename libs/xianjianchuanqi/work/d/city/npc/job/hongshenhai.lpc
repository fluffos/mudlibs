//hong shenhai 洪胜海

inherit NPC;

void create() {
  set_name("洪胜海", ({ "hong shenhai", "hong", "shenhai" }));
  set("nickname", "渤海帮帮主");
  set("long", "一个魁梧之极的大汉，脸庞极尽苍桑，精神却甚矍铄。\n");
  set("gender", "男性");
  set("age", 32);
  set("attitude", "peaceful");
  set("shen", 10000);
  set("str", 20 + random(10));
  set("int", 35 + random(10));
  set("con", 25 + random(10));
  set("dex", 27 + random(10));

  set("max_qi", 2500 + random(2000));
  set("max_jing", 2500 + random(2000));
  set("jiali", 120);
  set("combat_exp", 1200000 + random(800000));

  set_skill("force", 160 + random(50));
  set_skill("blade", 180 + random(50));
  set_skill("dodge", 190 + random(50));
  set_skill("parry", 190 + random(50));
  set_skill("cuff", 180 + random(50));

  set_skill("zixia-gong", 180 + random(50));
  set_skill("huashan-shenfa", 190 + random(50));
  set_skill("wuhu-duanmendao", 180 + random(50));
  set_skill("poyu-quan", 180 + random(50));

  map_skill("force", "zixia-gong");
  map_skill("dodge", "huashan-shenfa");
  map_skill("blade", "wuhu-duanmendao");
  map_skill("cuff", "poyu-quan");
  map_skill("parry", "wuhu-duanmendao");

  prepare_skill("cuff", "poyu-quan");

  setup();
  carry_object("/clone/weapon/blade/blade")->wield();
  carry_object("/clone/misc/cloth")->wear();
  add_money("gold", 1);
}

#include "/d/city/npc/job/npc.h"
