//吕正平 luzhenping.c
 
inherit NPC;
 
void create()
{
        set_name("吕正平", ({ "lu zhengping", "lu", "zhengping" }));
        set("nickname", "快刀门掌门人");
        set("long", 
        "只见他一张国字方脸，腮上一部虬髯，将大半张脸都遮没了。\n");
        set("gender", "男性");
        set("age", 42);
        set("attitude", "peaceful");
        set("shen", 10000);
        set("str", 30);
        set("int", 35);
        set("con", 25);
        set("dex", 27);
        
        set("max_qi", 2500);
        set("max_jing", 2500);
        set("jiali", 120);
        set("combat_exp", 1350000); 
         
        set_skill("force", 160);
        set_skill("yijin-jing", 180);
        set_skill("dodge", 190);
        set_skill("longzhua-gong", 160);
        set_skill("parry", 190);
        set_skill("shaolin-shenfa", 190);
        set_skill("cuff", 180);
        set_skill("claw", 180);
        set_skill("jingang-quan", 180);
        set_skill("literate", 150);
        set_skill("blade", 180);
        set_skill("xiuluo-dao", 180);
        set_skill("yizhi-chan", 180);
        set_skill("finger", 150);
        map_skill("force", "yijin-jing");
        map_skill("dodge", "shaolin-shenfa");
        map_skill("finger", "yizhi-chan");
        map_skill("blade", "xiuluo-dao");
        map_skill("claw", "longzhua-gong");
        map_skill("parry", "jingang-quan");
        prepare_skill("claw", "longzhua-gong");
        prepare_skill("finger", "yizhi-chan");
 
        setup(); 
        carry_object("/clone/weapon/blade/blade")->wield();
        carry_object("/clone/misc/cloth")->wear();
        add_money("gold", 1);
}

#include "/d/city/npc/job/npc.h"
