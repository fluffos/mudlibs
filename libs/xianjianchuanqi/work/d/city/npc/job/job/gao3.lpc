//gao3 高三娘子
 
inherit NPC;
 
void create()
{
        set_name("高三娘子", ({ "gao san", "gao", "gaosan niangzi" }));
        set("nickname", "万马庄女庄主");
        set("long", 
        "这女子颇有几分姿色，两幅罗裙外面系着绣花鸾带。
腰间整整齐齐插着两排短刀。\n");
        set("gender", "女性");
        set("age", 32);
        set("attitude", "peaceful");
        set("shen", 10000);
        set("str", 30);
        set("int", 35);
        set("con", 25);
        set("dex", 27);
        
        set("max_qi", 2500);
        set("max_jing", 2500);
        set("jiali", 120);
        set("combat_exp", 1200000); 
         
        set_skill("force", 160);
        set_skill("yijin-jing", 180);
        set_skill("dodge", 190);
        set_skill("longzhua-gong", 160);
        set_skill("parry", 190);
        set_skill("shaolin-shenfa", 190);
        set_skill("cuff", 180);
        set_skill("claw", 180);
        set_skill("jingang-quan", 180);
        set_skill("literate", 150);
        set_skill("blade", 180);
        set_skill("fanliangyi-dao", 180);
        set_skill("yizhi-chan", 180);
        set_skill("finger", 150);
        map_skill("force", "yijin-jing");
        map_skill("dodge", "shaolin-shenfa");
        map_skill("finger", "yizhi-chan");
        map_skill("blade", "fanliangyi-dao");
        map_skill("claw", "longzhua-gong");
        map_skill("parry", "jingang-quan");
        prepare_skill("claw", "longzhua-gong");
        prepare_skill("finger", "yizhi-chan");
 
        setup(); 
        carry_object("clone/weapon/blade")->wield();
        carry_object("/clone/misc/cloth")->wear();
        add_money("gold", 1);
}

#include "/d/city/npc/job/npc.h"

