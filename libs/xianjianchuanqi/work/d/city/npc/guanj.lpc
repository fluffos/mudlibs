#include <ansi.h>
inherit NPC;
int do_work();
int do_quit(string arg);
void create()
{
        set_name("胡管家", ({ "guan jia","guanjia" }) );
        set("title","药铺管家");
        set("long","他就是药铺的管家，为平一指管理着药铺内外的琐事。\n");
        set("age", 55);
        set("int", 30);
        set("qi", 500);
        set("max_qi", 500);
        set("jing", 500);
        set("max_jing", 500);
        set("shen_type", 1);
        set("combat_exp", 30000);
        set("attitude", "heroism");
        set_skill("unarmed", 20);
        set_skill("dodge", 30);
        set_skill("parry", 20);
        set_temp("apply/attack", 70);
        set_temp("apply/defense", 70);
        set_temp("apply/damage", 50);
        set("inquiry", ([
                "工作" : (: do_work :),
                "job" : (: do_work :),
        ]));
        set("chat_chance",3);
        set("chat_msg",({
        "胡管家说道：“老头子有个宝贝闺女，芳名叫“不死”!”\n",
        "胡管家说道：“老头子的续命八丹是武林中鼎鼎有名的疗伤圣药！”\n",
        "胡管家说道：可惜老头子为了他的宝贝闺女四处奔波寻找灵药，如今不知道居住在何处!”\n",
    }));
        setup();
        carry_object("/clone/misc/cloth")->wear();
}

void init()
{
        object ob;

        ::init();
        if( interactive(ob=this_player()) && !is_fighting() )
        {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_work","work");
        add_action("do_workend", "workend");
        add_action("do_quit","quit");
}
     
int do_work()
{
        object me=this_player();
        object* ob;
        int i;
      if (me->query("combat_exp")> 100000)
       { 
           message_vision(HIY"胡管家对$N哼了一声道：凭$N的身手，本店可不敢雇佣！\n" NOR,me);
           return notify_fail(HIR"管家说：你还是另找出路吧。\n" NOR);
           me->delete_temp("in_work");
       }
        if (me->query_temp("in_work")) 
           return notify_fail(HIR"管家对你说：你已经开始干活了。\n" NOR);
       else
           ob = users();
        for (i = 0; i < sizeof(me); i ++)
           message_vision("管家仔细地打量了$N一下：呵呵！好！好！本店正急需帮工，你就在这里整理草药吧！\n",me);
           ob = users();
           tell_room(environment(me),HIG + me->query("name")+"开始在药铺整理药材，不一会就累得满头大汗！\n" NOR);
           me->set("work", HIY"药铺伙计"NOR);
           me->set_temp("in_work","1"); 
           me->save();
           remove_call_out("end_work");
           call_out("end_work", 20 + random(80), me);
           remove_call_out("clone_snake");
           call_out("clone_snake", 10 + random(50), me);
           return 1;
}
void clone_snake(object me)
{
        object ob;
    if (me->query_temp("in_work") && objectp(present("guan jia", environment(me))))
    {
        tell_room(environment(me),HIB"突然从草药堆里钻出一条毒蛇。\n" NOR);
        ob=new("/d/city/npc/snake.lpc");
        ob->move("/d/city/yaopu");
        call_out("clone_snake", 10 + random(20), me);}
    }
void end_work(object me)
{
  if (me->query_temp("in_work") && objectp(present("guan jia", environment(me))))
      {
        object silver;
        me->delete("work");
        me->add("combat_exp",10 + random(150));
        me->add("potential",10 + random(90));
        /*if ( me->query("potential")-me->query("learned_points") > me->query_max_potential() )
            me->add("potential",me->query_max_potential() + me->query("learned_points"));*/
        silver = new("/clone/money/silver");
        silver->set_amount(10 + random(70));
        silver->move(me);
        me->delete_temp("in_work"); 
        me->save();
        remove_call_out("clone_snake");
        tell_room(environment(me),HIG + me->query("name")+"在药铺工作结束的时间到了。\n" NOR);
        tell_object(me,HIY"你在本药铺的工作干完了。\n" NOR);
      }
}

int do_workend(string arg)
{
       object me;
       me = this_player();

       if (me->query_temp("in_work")) 
       {
          remove_call_out("end_work");
          me->delete_temp("in_work"); 
          me->delete("work");
          me->save();
          remove_call_out("clone_snake");
          message_vision(HIY"$N低声说道：管家安排的工作我干不了！\n" NOR,me);
          message_vision("胡管家轻轻的拍了拍$N的头说道：做不了不要紧，下次努力接着做！\n",me);    
          return notify_fail(HIR"你在药铺的工作取消了\n" NOR);
        }
       else
       return notify_fail(HIR"你还没领到工作呢,^_^！\n" NOR);

       return 1;
}
int do_quit(string arg)
{
        object link_ob,me=this_player();
        if (me->query_temp("in_work")) 
           {
              write(this_player()->query("name")+"，你还在工作呢！\n");
        
              return 1;
            }   
   
   
        else 
                       
             return 0;
}



int kill_ob(object me)
{
        object ob;
        string name1, name2;
        ob = present("guan jia", environment(me));
        command("say 大胆刁民，竟敢谋害本老爷？去死吧！。\n");
        name1 = (string)me->query("name");
        name2 = (string)ob->query("name");
        tell_room(environment(me),
        name2+"高举双手大喝 去死把!, 只见天上一道闪电不偏不倚地击中"+name1+", 将之化为一堆灰烬.\n", 
        ({me, ob}));
//        me -> die()
tell_object(me,"你连忙跑了出来。\n");
me->move("/d/city/dongdajie1");
        return 1;
}


