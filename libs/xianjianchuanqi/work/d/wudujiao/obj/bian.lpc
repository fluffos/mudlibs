// bian.c 长鞭

#include <weapon.h>
inherit WHIP;

void create()
{
        set_name("长鞭", ({ "bian" }));
        set_weight(500);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "条");
                set("long", "这是一柄练功用的长鞭。\n");
                set("value", 100);
                set("material", "steel");
                set("wield_msg", "$N「唰」的一声抽出一条$n握在手中。\n");
                set("unwield_msg", "$N将手中的$n插回腰间。\n");
        }
        init_whip(15);
        setup();
}
