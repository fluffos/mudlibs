#include <ansi.h>
inherit NPC;
string ask_me();
void create() {
  set_name(HIY "哈哈" NOR, ({ "admin jrx", "admin" }));
  set("nickname", HIY "傻" HIC "瓜" HIM "神" HIR "仙" NOR);
  set("gender", "男性");
  set("age", 20);
  set("long", HIY "这位是傻瓜，向他打听“道歉”，他会带给您意想不到的收获。\n" NOR);
  set("shen_type", 0);
  set("combat_exp", 0);
  set("str", 50);
  set("dex", 50);
  set("con", 50);
  set("int", 50);
  set("per", 50);
  set("attitude", "friendly");
  set("max_qi", 10000000);
  set("neili", 10000000);
  set("max_neili", 10000000);
  set("score", 10000000);

  set("inquiry", ([
    "道歉": (: ask_me :)
  ]));
  setup();
}

void init() {
  object ob;
  ob = this_player();
  ::init();
  if (interactive(ob) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment() || (int)ob->query("xssx")) return;
  command("whisper " + ob->query("id") + " " HIW "欢迎光临" + HIY "仙剑狂侠" + HIR "(ask admin about 道歉)\n" + NOR + HIW + "，祝你玩的愉快．" NOR);
}

string ask_me() {
  object me = this_player();
  mapping fam;
  if ((int)me->query("sdlr1"))
    return "已经道歉了,再到一次!!!sorry sorry sorry sorry sorry ";
  else {
    me->set("sdlr1", 1);
    me->add("max_neili", 300);
    me->add("neili", 300);
    me->add("potential", 20000);
    me->add("food", 10000);
    me->add("water", 10000);
    me->add("combat_exp", 20000);

    return "欢迎光临" NOR + HIR "仙剑狂侠" NOR "，对以前的失误我们表示万分的歉意!你吃下全套的汤圆，只觉得浑身火辣辣的" NOR;
  }
}
