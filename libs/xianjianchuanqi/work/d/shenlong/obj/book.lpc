// book.c 招蛇术
inherit ITEM;

void create()
{
	set_name("招蛇术详解", ({ "zhaoshe xiangjie", "xiangjie", "shu", "book" }));
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("treasure", 1);
		set("unit", "本");
		set("long", "这是本神龙教历年来所创的对招蛇术的心得，值得研究研究。\n");
		set("no_drop", 1);
		set("material", "paper");
		set("skill", ([
			"name":	"zhaosheshu",
			"exp_required":	100,
			"jing_cost":	15,
			"difficulty":	25,
			"max_skill":	80
		]) );
     }
}
