#include <room.h>

inherit ROOM;

void create()
{
          set("short", "天龙寺斋房");
        set("long", @LONG
这是天龙寺的斋房。整个房间飘荡着香味，一些仆役在不停的忙着，边
上一角放着好多刚摘回来的青菜，你不由得舔舔嘴巴，好象听到你的肚子“
咕咕咕”的叫了起来。
LONG
        );

        set("exits", ([
                  "southeast"  : __DIR__"zoulang",
                ]));
        set("objects",([
        __DIR__"obj/qingcai" : 1,
        __DIR__"obj/dawan" : 1,
       ]) );

        setup();
}

