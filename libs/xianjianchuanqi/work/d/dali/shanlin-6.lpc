inherit ROOM;

void create()
{
	set("short", "森林");
	set("long", @LONG
你肥了九牛二虎之力，从密密麻麻的树枝中钻进了这里，却
发现眼前已没有了去路,前面一株株古树互相挤在一起，便如一
堵大墙(wall)相似，无法前进。
LONG
	);
        set("outdoors", "dali");

	set("exits", ([
      "south" : __DIR__"shanlin-5",
	]));

	setup();
}
 void init()
{       
       add_action("do_jump", "jump");
       add_action("do_tiao", "tiao");
}
int do_jump(string arg)
{
               object me;
               me = this_player();
               if (!arg || arg !="wall") 
                   return notify_fail("你要跳到那去？\n");
                if (random(me->query_skill("dodge",1))<60) { 
                    write("你吸气奋力一跳，无奈运气不好，没跳过树墙，摔了下来。\n");
					 write("你受了点伤!。\n");
					me->add("qi", -100);
                    me->add("jingli", -80);
                    me->receive_wound("qi", 50);
					  return 1;
                } else {
                    write("你一吸气，轻轻巧巧的跳过了大树墙。\n");
                    message("vision",
                             me->name() + "一纵身跳过了树墙。\n",
                             environment(me), ({me}) );
                    me->start_busy(1);
                    me->move(__DIR__"muwu1");
                    message("vision",
                             me->name() + "从树墙后面跳了过来。\n",
                             environment(me), ({me}) );
                return 1;
           }
}