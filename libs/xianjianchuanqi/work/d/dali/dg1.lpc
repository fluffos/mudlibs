inherit ROOM;

void create()
{
	set("short", "大观楼");
	set("long", @LONG
大观楼是昆明重要的风景区之一，位于城西南二公里的滇池岸边。据其
地势，约可分成三片：近华浦、大观楼片，楼外楼、鲁园片，庚园，花圃及
柏园片。这里往西可看到很多荷花。
LONG
	);
        set("outdoors", "dali");

	set("exits", ([
         "northwest" : __DIR__"xgf",
           "southup" : __DIR__"hg1",
            "south" : __DIR__"tulin",
		"west" : __DIR__"dg2",
	]));

	setup();
	replace_program(ROOM);
}
