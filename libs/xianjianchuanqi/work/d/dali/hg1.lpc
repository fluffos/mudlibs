inherit ROOM;

void create()
{
	set("short", "海埂");
	set("long", @LONG
这里原是一条由东向西横插入滇池中的长堤，东面从金家河起，徐徐向
西延伸，止于距西山脚一里许的滇池中。隔水与西山、大观楼等名胜遥相呼
应，堤长约四公里半，宽处从四五十公尺至二三百公尺不等，它象一条漂浮
在海中的玉带，将滇池一分为二：南为滇池主体，北为直达昆明城边的“草
海”。
LONG
	);
        set("outdoors", "dali");

	set("exits", ([
		"south" : __DIR__"hg2",
		"north" : __DIR__"hg3",
         "northdown" : __DIR__"dg1",
	]));

	setup();
	replace_program(ROOM);
}
