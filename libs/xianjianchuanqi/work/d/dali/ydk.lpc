// Room: /d/dali/ydk.c
// bbb 1997/06/10 

inherit ROOM;

void create()
{
	set("short", "燕子洞口");
	set("long", @LONG
沿着石阶，经过林木荫翳的小道宛转前行，便到了燕子洞的入口。洞似
大厅，四面透光，宽敞明亮。洞壁刻有“境绝人寰”，“胜景无双”，“灵
谷涵春”等题词。其中“洞锁三天”四字颇有奇趣。千百万年的漫长岁月里
地下水、雨水的溶蚀，使这里的石岩产生了奇异的变化，洞内不仅曲折幽深
奇幻美观；而且洞中有洞，天外有天；站在洞中三个不同的地点，可以看见
三块不同形状的天。故谓之“洞锁三天”。
LONG
	);
        set("outdoors", "dali");

	set("exits", ([
		"down" : __DIR__"ydn",
         "out" : __DIR__"yd",
	]));

	setup();
	replace_program(ROOM);
}
