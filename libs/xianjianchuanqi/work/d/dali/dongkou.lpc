// dongkou.c
// bbb 1997/06/11
#include <ansi.h>
inherit ROOM;

string look_huan();
void create() {
  set("short", "洞口");
  set("long", @LONG
走得十余步，洞中已无丝毫光亮，但觉脚下平整，便似走在石板路上一
样，洞中道路必是经过人工修整，只是道路不住的向下倾斜，显是越走越低
突然之间，你碰到什么，有圆物铛的一下，声音清亮，原来是个门环(huan)
LONG
  );
  set("exits", ([
    "out": __DIR__ "shibi",
  ]));

  set("item_desc", ([
    "huan": "门环在一扇大门上，似以钢铁铸成，但里面并未插上。\n",
  ]));

  setup();
}

void init() {
  add_action("do_knock", "knock");
  add_action("do_knock", "qiao");
  add_action("do_enter", "push");
  add_action("do_enter", "tui");
}

int do_knock(string arg) {
  object me;
  me = this_player();
  message_vision("$N提起门环当的敲了一下，但门内无人答应。\n", me);
  return 1;
}
int do_enter(string arg) {
  object me = this_player();
  message_vision("$N手劲使将上去，那门便缓缓的开了。\n", me);
  set("exits/enter", __DIR__ "dong1");
  return 1;
}

string look_huan() {
  return "门环在一扇大门上，似以钢铁铸成，但里面并未插上。\n";
}
