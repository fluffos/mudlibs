inherit ROOM;

void create()
{
	set("short", "天池半山");
	set("long", @LONG
天池半山，森林苍翠茂密，时闻鸟鸣，偶见兽迹，清晨可登上五宝山箸
看日出，远山若海，红日冉冉升腾，分外壮观。远可望碧罗雪山，雪冠如银
天池地势高，景色幽奇，气候凉爽，野花缤纷，每逢暑月，人们多来赏。
LONG
	);
        set("outdoors", "dali");

	set("exits", ([
		"down" : __DIR__"tianchi1",
	]));

	setup();
//	replace_program(ROOM);
}
void init()
{
            object me = this_player();
     if(me->query_temp("xuncheng"))
     {
       me->set_temp("dali_xc/tianchi2",1);
      }
}
