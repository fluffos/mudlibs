inherit ROOM;

void create()
{
	set("short", "虎跳峡");
	set("long", @LONG
金沙江流经丽江的石鼓之后，切穿了玉龙雪山和哈巴雪山，形成极为壮
观的大峡谷，这就是有名的虎跳峡。虎跞峡全长十五公里，自谷底到江岸山
顶，高差达三千多米，是世界上最深的峡谷之一。两岸如刀削斧砍，谷底狭
窄，江面宽仅几十米。传说有巨虎一跃而过，因而得名。
LONG
	);
        set("outdoors", "dali");

	set("exits", ([
           "south" : __DIR__"nj",
           "northup" : __DIR__"qunshan",
           "northeast" : __DIR__"ninglang",
	]));

	setup();
	replace_program(ROOM);
}
