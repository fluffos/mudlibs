inherit NPC;
inherit F_DEALER;

void create() {
  set_name("张千", ({ "zhang qian", "zhang", "zhangqian" }));
  set("title", "风味店老板");
  set("shen_type", 1);

  set("gender", "男性");
  set("age", 45);
  set("long",
    "这位老板正忙的满头大汗。\n");
  set_skill("unarmed", 40);
  set_skill("dodge", 40);
  set_temp("apply/damage", 25);

  set("combat_exp", 8000);
  set("attitude", "friendly");
  set("vendor_goods", ({
    __DIR__ "obj/baozi1",
    __DIR__ "obj/yang",
    __DIR__ "obj/chaoshou",
    __DIR__ "obj/mo",

  }));

  setup();
  carry_object("/clone/misc/cloth")->wear();
}

void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");
}
