inherit NPC;
inherit F_MASTER;

void create() {
  set_name("段正明", ({ "duan zhengming", "duan" }));
  set("nickname", "保定帝");
  set("gender", "男性");
  set("age", 46);
  set("str", 22);
  set("con", 23);
  set("dex", 23);
  set("int", 25);

  set("max_qi", 1900);
  set("max_jing", 1900);
  set("eff_jingli", 1500);
  set("max_neili", 3000);
  set("jiali", 20);


  create_family("天龙寺", 13, "俗家弟子");

  set("long",
    "这人雍容威严，神色间全是富贵尊荣，正是大理国当今皇帝。\n");

  set("combat_exp", 900000);
  set("score", 200000);

  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    (: exert_function, "powerup" :),
    (: exert_function, "recover" :),
  }));

  set_skill("parry", 120);
  set_skill("dodge", 120);
  set_skill("force", 120);
  set_skill("finger", 120);
  set_skill("buddhism", 80);
  set_skill("literate", 120);
  set_skill("sword", 140);
  set_skill("duanjia-jianfa", 140);
  set_skill("strike", 140);
  set_skill("qingyan-zhang", 140);
  set_skill("qiantian-yiyang", 120);
  set_skill("yiyang-zhi", 160);
  set_skill("tianlong-xiang", 120);

  map_skill("dodge", "tianlong-xiang");
  map_skill("parry", "yiyang-zhi");
  map_skill("sword", "duanjia-jianfa");
  map_skill("finger", "yiyang-zhi");
  map_skill("force", "qiantian-yiyang");
  map_skill("strike", "qingyan-zhang");
  prepare_skill("finger", "yiyang-zhi");
  prepare_skill("strike", "qingyan-zhang");

  set("inquiry", ([
    "段誉": "这孩子是在下侄儿，出去一次，不知道从哪学的武功。",
    "name": "你问这干嘛，我就是段正明。",
    "here": "这里便是大理国皇宫。",
  ]));

  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
}
