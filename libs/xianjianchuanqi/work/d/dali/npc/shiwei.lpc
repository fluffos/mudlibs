#include <ansi.h>

inherit NPC;

void create() {
  set_name("侍卫", ({ "shiwei" }));
  set("gender", "男性");
  set("age", 35);
  set("long",
    "他是当今大理国" 保 定 帝 "的侍卫。\n");

  set("combat_exp", 250000);
  set("attitude", "heroism");

  set("str", 23);
  set("con", 23);
  set("int", 23);
  set("dex", 23);

  set("max_qi", 700);
  set("eff_qi", 700);
  set("qi", 700);
  set("max_jing", 300);
  set("jing", 300);
  set("neili", 800);
  set("max_neili", 800);
  set("jiali", 40);

  set_temp("apply/attack", 40);
  set_temp("apply/defense", 40);

  set_skill("sword", 120);
  set_skill("unarmed", 100);
  set_skill("parry", 120);
  set_skill("dodge", 120);
  set("chat_chance", 10);

  setup();

  carry_object("/d/city/obj/gangjian")->wield();
  carry_object("/d/city/obj/tiejia")->wear();
}
