inherit F_MASTER;
inherit NPC;

#include <ansi.h>
void create()
{
        set_name("一灯大师", ({ "yideng dashi","yi deng","dashi"}) );
        set("nickname", HIY"南帝"NOR);
        set("title", "隐圣");
         set("long", 
" 他就是和东邪西毒等人齐名的南帝段王爷。\n");
        set("gender", "男性" );
        set("class","bonze");   
        set("age", 60);
        set("str", 30);
        set("cor", 27);
        set("dex", 32);
        set("int", 25);
        set("max_jing",3000);
        set("max_qi",5000);
               set("jiali",150);
        set("neili",5000);
        set("max_neili",5000); 
        set("force_factor", 70);
        set("rank_info/respect", "高僧");
        create_family("天龙寺", 13, "僧侣");
        set("combat_exp", 1500000);
        set("score", 200000);
        set("chat_chance_combat", 60);
          set("chat_msg_combat",({ (: perform_action, "finger.sandie" :) }));
        set_skill("parry", 260);
        set_skill("dodge", 260);
        set_skill("force", 260);
        set_skill("finger", 280);
        set_skill("duanjia-jianfa",260);
        set_skill("sword",280);
        set_skill("strike",260);
        set_skill("buddhism", 240);
        set_skill("literate", 300);
        set_skill("qiantian-yiyang", 260);
        set_skill("kurong-changong", 260);
        set_skill("qingyan-zhang", 260);
        set_skill("yiyang-zhi", 280);
        set_skill("tianlong-xiang", 260);
        map_skill("dodge", "tianlong-xiang");
        map_skill("parry", "yiyang-zhi");
        map_skill("finger", "yiyang-zhi");
        map_skill("strike","kurong-changong");
        map_skill("force", "qiantian-yiyang");
        prepare_skill("finger","yiyang-zhi");
        prepare_skill("strike","kurong-changong"); 
        set("inquiry", ([
                 "name": "我的名字早忘了，老衲法号一灯",
                 "段王爷": "段王爷已经不存在了，你问这个干嘛？",
        ]) );
        setup();
        carry_object("/d/tls/obj/jiasha")->wear();
        carry_object("/d/tls/obj/sengxie")->wear();
}
void attempt_apprentice(object ob)
{
  string old_name,new_name;
  mapping myfam;

        myfam = (mapping)ob->query("family");
      if (!myfam) return;
      if (myfam["family_name"] != "天龙寺") 
{
                 command ("say 你不是天龙寺弟子，这话从何说起！\n");
         return;
}
 if((int)ob->query_skill("buddhism",1)<200)
       {
         command("say "+RANK_D->query_respect(ob)+"的禅宗修为不足以化除你心中的邪念！");
          return;
}
   if((int)ob->query_skill("yiyang-zhi",1)<200)
{
   command("say 我段家武功首推一阳指，我看"+RANK_D->query_respect(ob)+"似乎应在一阳指上多下点功夫。");
          return;
        }
    if((int)ob->query_skill("qiantian-yiyang",1)<200)
 {
          command("say 修练一阳指内功最为重要，我看"+RANK_D->query_respect(ob)+"似乎应在乾天一阳功上多下点功夫。");
          return;
}
        if(!(ob->query("tls")) && !(ob->query_temp("tls_app")))
                 {
                                 command("say 阿弥陀佛！请回吧，贫僧不轻易收出家弟子。");
                 return;
}
  if(ob->query("tls")&&((int)ob->query("shen") > 1000 || (int)ob->query("shen")+1000 <0 )){
          command("say 我天龙寺乃清修之地，依我看"+RANK_D->query_respect(ob)+"似乎红尘未了,不宜继续修行。");
          return;
}
       command("smile");
        command("recruit " + ob->query("id") );
        command("say 你以后就跟我一起演习佛法吧。");
                ob->set("yd_1",1);
        return;
}
void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
        ob->set("class", "bonze");
}
