// bishui-jian 碧水剑
#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create()
{
set_name("碧水剑",({ "bishui jian", "jian","sword" }) );
set_weight(6000);
if( clonep() )
   set_default_object(__FILE__);
else {
   set("unit", "把");
   set("value", 1800);
   set("material", "steel");
   set("long", "此剑非常封利，是一口断金削铁的利器。\n");
   set("wield_msg","$N “唰”的一声抽出$n，握在手中。\n");
// "这是华山派岳岭珊十八岁生日那天岳不群送她的生日礼物。
   }
   init_sword(81);
   setup();
}