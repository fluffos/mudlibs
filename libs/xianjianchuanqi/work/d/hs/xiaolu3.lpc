// xiaolu2.c 小路

inherit ROOM;

void create()
{
	set("short", "小路");
	set("long", @LONG
	小路幽幽，林木清清，南面和北面各横着一幢粉墙院落。
LONG
	);

	set("exits", ([
		"north" : __DIR__"xiaozhu",
		"southeast" : __DIR__"xiaolu",
		"south" : __DIR__"shuyuan",
	]));
	set("objects",([
		__DIR__"npc/shi_daizi" : 1,
	]));
	setup();

}
int valid_leave(object me, string dir)
{
	mapping myfam;
	myfam = (mapping)me->query("family");

	if ((!myfam || myfam["family_name"] != "华山派") && dir == "north" &&
		objectp(present("shi daizi", environment(me))))
	   return notify_fail("施戴子喝道：这是华山派住室，不是本派弟子休得入内！\n");
	if ((!myfam || myfam["family_name"] != "华山派") && dir == "south" &&
		objectp(present("shi daizi", environment(me))))
	   return notify_fail("施戴子喝道：这是华山派书院，不是本派弟子休得入内！\n");
		
        return ::valid_leave(me, dir);
}

