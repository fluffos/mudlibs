// shulin1.c

inherit ROOM;

void create()
{
	set("short", "松树林");
	set("long", @LONG
这是一片松树林。几十丈高的大松树簇在一块，密实的枝叶象一蓬蓬巨
伞般伸向天空，把阳光遮得丝毫也无。尺把厚的松针积在地上，一脚踩下去
，半天拔不出来。
LONG
	);

	set("exits", ([
		"east" : __FILE__,
		"south" : __DIR__"kongdi",
		"west" : __FILE__,
		"north" : __DIR__"shulin2",
	]));

	set("outdoors", "华山");

	setup();
}


