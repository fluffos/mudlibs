// yunu.c

inherit ROOM;

void create() {
  set("short", "玉女峰山路");
  set("long", @LONG
这是一条通向玉女峰绝顶上危崖的山路。一路上来，草木越来越少，与华
山草木清华，景色极幽的特色成对比。
LONG
  );
  set("exits", ([
    "southdown": __DIR__ "yunu",
    "northup": __DIR__ "xiaolu2",
  ]));
  set("objects", ([
    __DIR__ "npc/lu_dayou": 1,
  ]));
  set("outdoors", "华山");

  setup();
}
int valid_leave(object me, string dir) {
  if (dir == "northup" && me->query("family/family_name") != "华山派" && objectp(present(
    "lu dayou",
    environment(me)
  )))
    return notify_fail("陆大有喝道：“不是本派弟子休得往上半步。\n");
  return ::valid_leave(me, dir);
}
