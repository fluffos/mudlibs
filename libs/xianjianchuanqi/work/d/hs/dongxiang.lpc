// dongxiang.c 东厢走廊
// Modified by Marz 03/27/96

#include <room.h>
inherit ROOM;

void create()
{
	set("short", "东厢走廊");
	set("long", @LONG
你走在一条东走廊上，通道前有几间雅室，静静的人很少，东边是女弟子
休息室，北边是男弟子休息室。
LONG
	);

	set("exits", ([
		"north" : __DIR__"xiuxi",
		"west" : __DIR__"xiaozhu",
		"east" : __DIR__"xiuxi2",
	]));
	setup();
}
int valid_leave(object me, string dir)
{
        if (dir == "east" && this_player()->query("gender") == "男性" )
                return notify_fail("看清楚，那是女弟子休息室！！\n");

        if (dir == "north" && this_player()->query("gender") == "女性" )
                return notify_fail("看清楚，那是男弟子休息室！！\n");
        return ::valid_leave(me, dir);
}
