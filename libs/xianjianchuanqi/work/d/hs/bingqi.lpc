#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", HIW"兵器房"NOR);
	set("long", @LONG
这里是华山派兵器房，西面是华山派的练功场。
LONG	);
	set("exits", ([ /* sizeof() == 2 */
		"west"  : __DIR__"square",
	]));
	set("objects", ([ 
		__DIR__"obj/changjian": 2,
		__DIR__"obj/duanjian": 3,
		__DIR__"obj/zhujian": 3,
	]) );
	set("no_clean_up", 0);
	setup();
}

int valid_leave(object me, string dir)
{
	if ( present("jian 2",me) ) {
	write("带这么多剑出去，不太好吧？\n");
	return notify_fail("");
	}
	me->set_temp("mark/bingqi",1);
	call_out("del_tmp",1800,me);
	return ::valid_leave(me, dir);
}

void del_tmp(object me)
{
        if ( objectp(me) ) me->delete_temp("mark/bingqi");
}