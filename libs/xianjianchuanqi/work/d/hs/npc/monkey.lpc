// animal: monkey.c
// Jay 3/18/96

inherit NPC;

void create() {
  set_name("小猴子", ({ "monkey", "xiao houzi" }));
  set("race", "野兽");
  set("age", 200);
  set("long", "一个活泼可爱的小猴子。\n");
  set("attitude", "peaceful");
  set("str", 50);
  set("con", 30);
  set("qi", 400);
  set("max_qi", 400);
  set("limbs", ({ "头部", "身体", "尾巴", "爪子" }));
  set("verbs", ({ "bite" }));
  set("combat_exp", 1000);
  set_temp("apply/attack", 50);
  set_temp("apply/armor", 50);
  setup();
}
