// yu.c  于鲜通
#include <ansi.h>

inherit NPC;

void create()
{
	set_name("于鲜通", ({ "yu xiantong" , "yu" }));
        set("title","华山派第十三代弟子");
        set("long", "这就是在江湖中众人皆知的华山派于鲜通。");
        set("age", 40);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);
        
        set("max_qi",1800);
	set("qi", 1800);
        set("max_jing", 1400);
	set("jing",1400);
	set("max_jingli", 1700);
	set("jingli", 1700);
        set("max_neili", 2000);
        set("neili", 2000);
        set("jiali", 50);
        set("combat_exp", 500000);
	set("score", 30000);
       	set("chat_chance_combat",40);

        set_skill("sword",  170);
        set_skill("dodge",  170);
        set_skill("force",  170);
        set_skill("parry",  170);
        set_skill("literate",170);
        set_skill("zixia-gong", 170);
        set_skill("huashan-jianfa",  170);
        set_skill("huashan-shenfa",  170);
  	set_skill("ziyin-yin", 170);
	set_skill("zhengqi-jue", 170);

        map_skill("dodge", "huashan-shenfa");
        map_skill("force","zixia-gong");
        map_skill("sword","huashan-jianfa");
        map_skill("parry","huashan-jianfa");

        create_family("华山派",13,"弟子");

        setup();
        carry_object(__DIR__"../obj/changjian")->wield();
	carry_object("/clone/misc/cloth")->wear();
}
