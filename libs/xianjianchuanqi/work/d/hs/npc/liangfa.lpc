// Npc /u/huashan/npc/liang-fa 
// by KEN.Q.Z.ZHANG
// 01/24/1997

inherit NPC;
string ask_me();

void create()
{
	set_name("梁发", ({ "liang fa", "liang" }));
	set("long", "梁发在同门中排行第三，人称华山梁三哥。\n");
	create_family("华山派", 14, "弟子");
	set("gender", "男性");
	set("age", 30);
	set("attitude", "peaceful");
	set("shen_type", 1);
	set("con", 24);
	set("dex", 24);
	set("int", 24);
	set("str", 24);

	set("max_jing", 300);
	set("max_neili", 500);
	set("max_qi", 400);
	set("jing", 300);
	set("neili", 500);
	set("qi", 400);

	set("jiali", 30);
	set("combat_exp", 80000);

	set("apply/attack", 30);
	set("apply/defense", 30);

	set_skill("cuff",  75);
	set_skill("dodge", 75);
	set_skill("force", 75);
	set_skill("literate", 75);
	set_skill("parry", 75);
	set_skill("sword", 75);
	set_skill("strike",75);

	set_skill("huashan-jianfa", 75);
//	set_skill("zixia-shengong", 70);
	set_skill("huashan-shenfa", 75);
	set_skill("hunyuan-zhang", 75);
	set_skill("pspy-quan", 75);

	map_skill("cuff",  "pspy-quan");
	map_skill("dodge", "huashan-shenfa");
//	map_skill("force", "zixia-shengong");
	map_skill("parry", "huashan-jianfa");
	map_skill("sword", "huashan-jianfa");
	map_skill("strike","hunyuan-zhang");

	prepare_skill("cuff",	"pspy-quan");
	prepare_skill("strike",	"hunyuan-zhang");

	set("inquiry", ([
		"长剑" :   (: ask_me, "changjian" :),
		"竹剑" :   (: ask_me, "zhujian" :),
        ]));
	set("wuqi_count", 10);

	setup();
	carry_object("/clone/weapon/changjian")->wield();
	carry_object("/clone/misc/cloth")->wear();
}

string ask_me(string name)
{
	mapping fam; 
	object ob;
	if ( !(fam = this_player()->query("family")) || fam["family_name"] != "华山派")
		return RANK_D->query_respect(this_player()) + "与本派素无来往，不知此话从何谈起？";
	if ( query_temp("mask/qu_jian") == 1 )
		return RANK_D->query_respect(this_player()) + 
		"你刚才不是取过武器吗，怎麽又来要了？ 真是贪得无餍！";
	if (  present(name, this_player()) )
		return RANK_D->query_respect(this_player()) + 
		"你现在身上不是有这样武器吗，怎麽又来要了？ 真是贪得无餍！";
	if (query("wuqi_count") < 1)
		return "抱歉，你来得不是时候，武器已经发完了。";
	ob = new(__DIR__"obj/" + name);
	ob->move(this_player());
	add("wuqi_count", -1);
	ob->set_temp("mask/qu_jian",1);
	message_vision("梁发给$N一把" + ob->query("name") + "。\n", this_player());
	return "拿去吧。不过要记住，武器只可防身练武，不可凭此杀害生灵。";
}
