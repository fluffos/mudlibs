// xiaoer.c 小二

inherit NPC;
inherit F_DEALER;

void create()
{
	set_name("小二", ({ "xiao er", "xiaoer", "xiao" }) );
	set("gender", "男性" );
	set("age", 22);
	set("long",
		"这是位精明的小二，什么名字不记得了，只看到正笑咪咪地忙著，生怕招待不周上华山的客人。\n");
	set("combat_exp", 500);
      	set("shen_type", 1);
	set("attitude", "friendly");
       set("vendor_goods",({
              __DIR__"obj/baozi",
              __DIR__"obj/jitui",
              __DIR__"obj/kaoya",
              __DIR__"obj/jiudai",
              __DIR__"obj/mabudai",
       }));
	setup();
}

void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
        add_action("do_list", "list");
        add_action("do_buy", "buy");
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(2) ) {
		case 0:
			say( "小二笑咪咪地说道：这位" + RANK_D->query_respect(ob)
				+ "，进来喝杯茶，歇歇腿吧。\n");
			break;
		case 1:
			say( "小二用脖子上的毛巾抹了抹手，说道：这位" + RANK_D->query_respect(ob)
				+ "，请进请进。\n");
			break;
	}
}

int accept_object(object who, object ob)
{
	
	if (ob->query("money_id") && ob->value() >= 500) 
	{
		tell_object(who, "小二点点头，笑道：多谢客官，请进房歇息。\n");

		who->set_temp("rent_paid",1);

		return 1;
	}

	return 0;
}
