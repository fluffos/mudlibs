// haoke.c 豪客

inherit NPC;

void create()
{
	set_name("江湖豪客", ({ "hao ke","hao" }));
	set("long", 
		"一名满脸彪捍之色的江湖豪客。\n");
	set("gender", "男性");
	set("age", 20 + random(20));
	set("attitude", "heroism");
	set("shen_type", 1);

	set("str", 22);
	set("int", 20);
	set("con", 22);
	set("dex", 20);
	
	set("max_qi", 300);
	set("max_jing", 200);
	set("neili", 300);
	set("max_neili", 300);

	set("combat_exp", 40000 + random(10000));

	set_skill("force", 30);
	set_skill("dodge", 30);
	set_skill("unarmed", 30);
	set_skill("parry", 30);
	set_skill("sword", 30);
	setup();
	carry_object("/clone/weapon/changjian")->wield();
	carry_object("/clone/misc/cloth")->wear();
	add_money("silver", 5);
}
