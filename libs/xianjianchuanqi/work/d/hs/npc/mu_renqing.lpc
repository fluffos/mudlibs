// mu_renqing.c 穆人清

inherit NPC;
inherit F_MASTER;
#include <ansi.h>
void create()
{
	set_name("穆人清",({"mu renqing","mu"}));
        set("nickname","神剑仙辕");
        set("long", "这就是在江湖中侠名远播，疾恶如仇，华山派神剑轩辕穆人清。\n");
        set("age", 70);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);
        
        set("max_qi",2500);
	set("qi", 2500);
        set("max_jing", 2500);
	set("jing",2500);
	set("max_jingli", 2500);
	set("jingli", 2500);
        set("max_neili", 2500);
        set("neili", 2500);
        set("jiali", 50);
        set("combat_exp", 2000000);
	set("score", 30000);
       	set("chat_chance_combat",40);
        set("chat_msg_combat", ({
	(: perform_action, "strike.wuji" :),
	(: perform_action, "cuff.leidong" :),
}));
        set_skill("strike", 300);
	set_skill("hunyuan-zhang", 300);
        set_skill("sword",  300);
        set_skill("dodge",  270);
        set_skill("force",  300);
	set_skill("cuff", 200);
	set_skill("poyu-quan", 300);
        set_skill("parry",  280);
        set_skill("literate", 260);
        set_skill("zixia-gong", 250);
        set_skill("huashan-shenfa", 270);
        set_skill("huashan-jianfa", 270);
	set_skill("ziyin-yin", 270);
	set_skill("zhengqi-jue", 270);
  
        map_skill("dodge", "huashan-shenfa");
        map_skill("force","zixia-gong");
        map_skill("cuff","poyu-quan");
        map_skill("parry","hunyuan-zhang");
        map_skill("strike","hunyuan-zhang");
        prepare_skill("strike","hunyuan-zhang");
	prepare_skill("cuff", "poyu-quan");

        create_family("华山派",12,"弟子");
        setup();
	carry_object("/clone/misc/cloth")->wear();
}
void attempt_apprentice(object ob)
{
        mapping fam;
        if ( mapp(fam=ob->query("family")) && (string)fam["family_name"] != "华山派"  && (int)ob->query("is/huashan")==1 ) {
                message_vision(CYN "$N！你这个华山派的叛徒还回来干什么 ？？？\n"NOR, ob );
                command("slap "+ob->query("id"));
                return;
        }
        if ((int)ob->query("shen") <= 0) {
        command("say 我华山派乃是堂堂名门正派，对弟子要求极严。");
        command("say 在德行方面，" + RANK_D->query_respect(ob) +
        "是否还做得不够？");
        return;
        }
        command("say 好吧，我就收下你了,你可要为我们华山派争口气。");
        ob->set("is/huashan",1);
        command("recruit " + ob->query("id"));
}