// yue_lingshan.c 岳灵珊

inherit NPC;

void create()
{
	set_name("岳灵珊", ({ "yue lingshan", "yue", "lingshan" }));
	set("long", 
"华山掌门岳不群和夫人宁中则的爱女，容颜俏丽，天真无邪，自小娇惯，\n"
"华山门下人人叫她作“小师妹”。\n");
	set("nickname", "小师妹");
	set("gender", "女性");
	set("age", 19);
	set("attitude", "peaceful");
       set("vendetta_mark", "authority");
	set("shen_type", 1);
	set("str", 22);
	set("int", 25);
	set("con", 23);
	set("dex", 28);
	
    set("max_qi",700);
    set("max_jing",600);
    set("neili",600);
    set("max_neili",600);
	set("jiali", 20);
  set("combat_exp", 220000);
	set("score", 5000);

        set_skill("sword",  80);
        set_skill("dodge",  80);
        set_skill("unarmed",80); 
        set_skill("force",  80);
        set_skill("parry",  80);
        set_skill("literate",80);
	set_skill("hunyuan-zhang", 80);
	set_skill("strike",80);
        set_skill("huashan-jianfa", 80);
        set_skill("huashan-shenfa", 80);
        set_skill("zixia-gong",80);

	map_skill("force", "zixia-gong");
	map_skill("parry", "huashan-jianfa");
	map_skill("strike", "hunyuan-zhang");
	map_skill("sword", "huashan-jianfa");
       map_skill("dodge", "huashen-shenfa");

	prepare_skill("strike", "hunyuan-zhang");
	create_family("华山派", 14, "弟子");

	setup();
	carry_object("/clone/weapon/changjian")->wield();
	carry_object("/clone/misc/cloth")->wear();
}

int accept_object(object who, object obj)
{
	object ling;
	ling =present("ling pai", who);

	if( !ling )
	      return notify_fail("你的令牌呢？\n");
	if( (int)ling->query_temp("mmr", 1) != who->query("id") )
	      return notify_fail("这好象不是你领的令牌吧？\n");

	if( (int)ling->query_temp("killed", 1) > 4 )
	      return notify_fail("赶紧回去复命吧。\n");

        if ( !who->query_temp("hs/jobji")) 
              return notify_fail("你还没有领任务，怎么就来祭坛了？\n");

        if ( obj->query("id") != "mengmian ren" ) {
                command("say 这东西我要来没用。");
                return 0;
        }

	if( (int)obj->query_temp("mmr", 1) != who->query("id") ) 
		return notify_fail("这个蒙面人好象不是你杀的吧？\n");

        if ( obj->query("victim_user") )          // is it player's corpse?
                return notify_fail("想用玩家蒙混过关？没那么容易！\n");
/*
	if( ob->query("kill_by") != who )
		return notify_fail("这个蒙面人好象不是你杀的吧？\n");
*/
	write("岳灵珊在你的令牌上写了几个字。\n", who);        
	command("say " + "好吧，请师兄把恶贼尸体放于祭台，以告慰侠义之士的在天之灵。\n");
	who->set_temp("jitan", 1);
	call_out("destroying", 1, obj);
	return 1;	
}

void destroying(object obj)
{
        destruct(obj);
        return;
}
