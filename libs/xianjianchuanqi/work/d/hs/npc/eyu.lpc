// animal: eyu.c
// Jay 3/18/96

inherit NPC;

void create()
{
        set_name("鳄鱼", ({ "eyu" }));
        set("race", "野兽");
        set("age", 200);
        set("long", "一条庞大无比的大鳄鱼，张开大嘴象你游来。\n");
        set("attitude", "aggressive");
        set("str", 70);
        set("con", 50);
        set("max_qi", 1800);
        set("limbs", ({ "头部", "身体", "尾巴" }) );
        set("verbs", ({ "bite" }) );
        set("combat_exp", 400000);
        set_temp("apply/attack", 100);
        set_temp("apply/armor", 100);
        setup();
}

void die()
{
        object ob, sword;
        sword = unew("/clone/weapon/bishui-jian");
        if( !clonep(sword) ) {
        message_vision("$N抽搐了几下，身体缩在一起，死了。\n", this_object());
        }
        else {
        ob = new("/clone/weapon/bishui-jian");
        ob->move(environment(this_object()));
        message_vision("$N抽搐了几下，身体缩在一起，死了。\n", this_object());
        }
        destruct(this_object());
}

