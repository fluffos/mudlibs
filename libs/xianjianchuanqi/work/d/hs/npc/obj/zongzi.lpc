// zongzi.c 粽子
// By Marz

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("粽子", ({"zong zi", "zong","zongzi" }));
	set_weight(50);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "一碟香喷喷的粽子，闻到这香气才觉着真的好饿。\n");
		set("unit", "碟");
		set("value", 80);
		set("food_remaining", 4);
		set("food_supply", 30);
	}
}
