// zhengqi book 2 正气诀下册

inherit ITEM;

void create()
{
	set_name("正气诀下册", ({ "zhengqi jue", "book" }));
	set_weight(200);
	set("unit", "册");
	set("long", "这是一册正气诀下册，上面画满了各种打坐吐呐的姿势。\n");
        set("treasure",1);
	set("value", 3000);
	set("material", "paper");
	set("skill", ([
			"name":	"zhengqi-jue",	// name of the skill
			"exp_required":	1000,	// minimum combat experience required
			"jing_cost": 20+random(15),// jing cost every time study this
			"difficulty":	25,	// the base int to learn this skill
			"max_skill":	100	// the maximum level you can learn
		      ]) );
}
