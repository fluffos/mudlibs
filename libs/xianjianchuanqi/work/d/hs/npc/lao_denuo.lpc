// lao_denuo.c 劳德诺

inherit NPC;
inherit F_MASTER;

void create()
{
	set_name("劳德诺", ({ "lao denuo", "lao", "denuo" }));
	set("long", 
"华山十四代弟子劳德诺，处事稳键，颇有师傅岳不群风范，他在\n"
"同门中排行第二，只因带艺从师，是华山派弟子中最年长者。\n");
	set("gender", "男性");
	set("age", 39);
	set("attitude", "peaceful");
       set("vendetta_mark", "authority");
	set("shen_type", 1);
	set("str", 24);
	set("int", 24);
	set("con", 24);
	set("dex", 24);
	
	set("max_qi", 600);
	set("max_jing", 300);
	set("neili", 600);
	set("max_neili", 600);
	set("jiali", 40);
	set("combat_exp", 70000);
	set("score", 1000);

        set_skill("sword",  70);
        set_skill("dodge",  70);
        set_skill("unarmed",70); 
        set_skill("force",  70);
        set_skill("parry",  70);
        set_skill("literate",70);
        set_skill("huashan-jianfa",  70);
        set_skill("huashan-shenfa",  70);
        set_skill("huashan-neigong",70);

	map_skill("force", "huashan-neigong");
	map_skill("parry", "huashan-jianfa");
	map_skill("sword", "huashan-jianfa");
       map_skill("dodge", "huashen-shenfa");
	create_family("华山派", 14, "弟子");

       if (random(2) == 1) {
            set("chat_chance",10);
            set("chat_msg",({
                   (: random_move :),
            }));
     }

	setup();
	carry_object("/clone/weapon/changjian")->wield();
	carry_object("/clone/misc/cloth")->wear();
}
void attempt_apprentice(object ob)
{
        command("say 好,华山又多一个弟子了，你可要为我们华山派争口气。");
        command("recruit " + ob->query("id"));
        ob->set("title","华山派第十五代弟子");
}

