// Room: chufang.c 橱房

#include <ansi.h>
inherit ROOM;

int make_food();
int make_drink();

void create()
{
        set("short", "厨房"NOR);
        set("long", @LONG
厨房四周摆有几张桌子和椅子，几个女弟子正忙着烧饭煮菜。饭菜
的香气，另人垂涎欲滴，还是赶快找个位子坐下吃饭喝茶(askfood)和
(asktea)吧。
LONG    );
        set("exits", ([ 
                "east" : __DIR__"xixiang",
        ]));
        setup();
}

void init()
{
        add_action("make_food","askfood");
        add_action("make_drink","asktea");
}

int make_food()
{
        object me,ob;
        me=this_player();
        if ( present("zongzi", me ) )
                return notify_fail("你身上不有棕子吗？ 你饿的话就先吃了它吧。\n");
        if ( present("zongzi", environment(me)) )
                return notify_fail("桌上不有棕子吗？ 你饿的话就先吃了它吧。\n");
        if ( me->query("food") > ( me->max_food_capacity()*0.8 ) ) {
                message_vision("师姊不耐烦地对$N说道：怎么刚吃完又要吃，你没看见我正忙着呢 ！\n",me);
                return 1;
        }
        message_vision("不一会儿，师姊为$N端上了食物。\n", me);
        ob=new(__DIR__"obj/zongzi");
        ob->move(__FILE__);
        return 1;
}

int make_drink()
{
        object me,ob;
        me=this_player();
        if ( present("xiang cha", me ) )
                return notify_fail("你身上不有香茶吗？ 你渴的话就先喝了它吧。\n");
        if ( present("xiang cha", environment(me)) )
                return notify_fail("桌上不有香茶吗？ 你渴的话就先喝了它吧。\n");
        if ( me->query("water") > ( me->max_water_capacity()*0.8 ) ) {
                message_vision("师姊不耐烦地对$N说道：怎么刚喝完又要喝，你没看见我正忙着呢 ！\n",me);
                return 1;
        }
        message_vision("不一会儿，师姊为$N端上了茶水。\n", me);
        ob=new(__DIR__"obj/xiangcha");
        ob->move(__FILE__);
        return 1;
}

int valid_leave(object me, string dir)
{
        if ( present("xiang cha",me) || present("zongzi",me) )
                return notify_fail("师姊喝到：‘吃饱了喝足了还不够，临走怀里还揣上一些，这不太好吧 ？’\n");
        return ::valid_leave(me, dir);
}
