#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "红茶馆");
	set("long", @LONG
这里是华山上一个简陋的小茶馆，旁边有一条竹竿上挑着一面旗。墙上有个牌子，
是个价目表(sign)。茶馆老板一见你进来，立刻笑容满面的过来招呼。
LONG	);
	set("exits", ([
		"west" : __DIR__"zhenyue",
	]));
	set("item_desc", ([
		"flag" : "上面大大的写着“茶”字，游客远远的就能看到。\n",
		"sign" : "牌子上写着：
			红茶一碗(wan)：50 文。
			山桃一个(tao)：50 文。\n"
	]));
	set("objects",([
		__DIR__"npc/waiter" : 1
	]) );
	setup();
	replace_program(ROOM);
}