// jitan.c 祭坛

inherit ROOM;
void create()
{
	set("short", "祭坛");
	set("long",@long
这里是华山绝顶上人们祭祀上天的祭坛，每年华山弟子都要下山行侠
仗义，以换取上苍对华山百姓的保佑。
long);
	set("exits", ([
	"westdown" : __DIR__"yunuci",
]));
	set("objects", ([
	__DIR__"npc/yue_lingshan" : 1,
]));
//         set("no_fight", 1);
	setup();
}

void init()
{
	add_action("do_jitan", "jitan");
}

int do_jitan(string arg)
{
	object me, ob, ling;
	me = this_player();
	ob = this_object();
	ling = present("ling pai", me);
	if(!living(me) ) return 0;
	
	if(!ling)
	return notify_fail("你身上没有令牌如何告慰英烈的在天之灵？\n");

        if (me->is_busy() || me->is_fighting())
	return notify_fail("你正忙着哪！\n");

	if( !me->query_temp("jitan") )
	return notify_fail("你要干什么？\n");

 if(!arg || arg =="" ||  ( arg != "sword" && arg != "blade" ) )
	return notify_fail("你要干什么？\n");
	
	if( arg == "blade")
	{
		message_vision("$N恭敬地从侍童手中接过尸体，摆放在祭坛前，恭敬地磕了三个响头。\n", me);
		me->improve_skill("blade", (int)me->query("combat_exp", 1) / 500);
		ling->add_temp("done", 1);
		me->delete_temp("jitan");
		return 1;
	}
	if( arg == "sword")
	{
		message_vision("$N恭敬地从侍童手中接过尸体，摆放在祭坛前，恭敬地磕了三个响头。\n", me);
		me->improve_skill("sword", (int)me->query("combat_exp", 1) / 500);
		ling->add_temp("done", 1);
		me->delete_temp("jitan");
		return 1;
	}
	return 1;
}		
