// /d/hs/jinshe/biding.c 壁顶

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "壁顶");
  set("long", @LONG
这里是峭壁的顶端，四周怪石嶙峋，旁边有几棵柏树(shu)枝叶茂
盛，一些野藤(teng)缠绕的树干。在树的下隐约有个洞穴(dong)，由于
年深日久，封住洞口的泥土已经剥落。
LONG
  );
  set("outdoors", "华山");
  set("exits", ([
    //                "northdown":__DIR__"gudao2",
  ]));
  set("item_desc", ([
    "shu": "\n一棵枝叶繁茂的大树，粗粗的树干，看上去很牢固。\n",
    "teng": "\n一些不知名的野藤，紧紧缠绕的大树。\n",
    "dong": "\n里面黑沉沉的，什麽也看不清，不知有多深。\n",
  ]));



  setup();
}

void init() {
  //        add_action("do_zhai", ({"stick","bo"}));
  add_action("do_bian", ({ "weave", "bian" }));
  //        add_action("do_use", ({"use","dian"}));
  //     add_action("do_pa", ({ "climb", "pa" }));
  //       add_action("do_bang", ({ "tie", "bang" }));
}
int do_bian(string arg) {

  object me = this_player();

  if (arg != "teng")
    return notify_fail("你拿什麽编？\n");
  if (query("teng_count") > 0) {
    message_vision("$N你把折下一些树藤，编了一个篮筐，又挑了一些细的拧成麻绳，
        看上去还算结实。\n", me);
    add("chu_count", -1);
    new(__DIR__ "obj/kuang")->move(me);
  } else
    message_vision("$N你把树藤都已经折光了。\n", me);
  return 1;
}
