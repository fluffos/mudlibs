// hole.c
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "思过崖洞口");
  set("long", @LONG
这里便是华山派弟子受罚思过的地方。位于玉女峰顶，正好有一小快
平地，一面是深不可测的山谷、一面是陡峭的悬壁(bi)，零零落落的有几
快山石。
LONG
  );
  set("exits", ([
    "out": __DIR__ "siguoya",
  ]));

  set("item_desc", ([
    "bi": "你看着看着忽然发现有一处石壁上的青苔比别处少得多。不禁想....\n",
  ]));

  setup();
}

void init() {
  add_action("do_break", "break");
  add_action("do_mianbi", "mianbi");
  add_action("do_han", "han");
}

int do_break(string arg) {
  int n;
  object me = this_player();
  object weapon = me->query_temp("weapon");
  object room;
  object ob = this_object();
  n = (int)me->query("neili");
  room = find_object(__DIR__ "rukou");
  if (!objectp(weapon)) return 0;
  message_vision(
    "$N走到石壁前，拔出腰间所悬长剑，运劲向石壁刺了过去。\n", me);

  if (n >= 600) {
    message_vision(
      "$N只听一声轰响，石壁被捅穿了，原来里面有一个大洞。！\n", me);
    set("exits/enter", __DIR__ "rukou");
    set("exits/out", __DIR__ "siguoya");
    this_player()->add("neili", -200);
    remove_call_out("close");
    call_out("close", 5, this_object());

    if (!(room = find_object(__DIR__ "rukou")))
      room = load_object(__DIR__ "rukou");
    if (room = find_object(__DIR__ "rukou")) {
      message("vision", "你只听外面一声轰响，石洞被人从外面捅穿了，露出了一个洞口。\n", room);
      room->set("exits/out", __DIR__ "hole1");
      remove_call_out("close1");
      call_out("close1", 5, room);
    }
  } else {
    message_vision(
      "结果只听一声闷哼，$N被石壁的反弹力震得眼前一黑....\n", me);
    this_player()->unconcious();
  }

  return 1;
}

void close(object ob) {
  message("vision", "崖上忽然掉下来一块巨石，将洞口封了个严严实实。\n", ob);
  ob->delete("exits/enter");
}
void close1(object room) {
  message("vision", "崖上忽然掉下来一块巨石，将洞口封了个严严实实。\n", room);
  room->delete("exits/out");
}
int do_mianbi(object me) {
  me = this_player();
  if (me->if_fighting() || me->is_busy()) return notify_fail("你正忙着呢。\n");
  if (me->query("family/family_name") == "华山派") me->add_temp("feng_times", 1);
  message_vision(HIY "$N把心神静了一静，面向山壁开始暝思……\n" NOR, me);
  me->start_busy(5);
  me->add("jing", -20);
  me->add("shen", 10);
  return 1;

}
int do_han(string arg, object ob) {
  object feng;
  ob = this_player();
  if (ob->is_busy()) return notify_fail("你现在正在忙着呢。\n");
  if (stringp(arg) && arg == "风老前辈") {
    if (ob->query("family/family_name") == "华山派") {
      if (random(ob->query_temp("feng_times")) > 100 && random(10) > 5 && !present(
        "feng qingyang",
        environment(ob)
      )) {
        feng = new("/d/hs/npc/feng");
        message_vision(HIW "$N大喊一声：“风老前辈……”\n" NOR, ob);
        ob->start_busy(10);
        feng->move(environment(ob));
        tell_room(environment(ob), "只见，一灰色的身形向这里飞射过来。\n");
        remove_call_out("feng");
        call_out("feng", 15, ob);
      } else {
        message_vision("$N大喊一声“风老前辈……”\n", ob);
        ob->start_busy(4);
        remove_call_out("yue");
        call_out("yue", 2, ob);

      }
    } else return notify_fail("你不是华山弟子，你来喊什么？\n");
  } else {
    call_out("yue", 0, ob);
  }

  return 1;
}
int yue(object ob) {
  tell_room(environment(ob), "只见高老者快步走了过来。\n");
  message_vision(HIG "高老者说道：$N搞什么搞？再喊的话，我就……嘿嘿\n" NOR, ob);
  tell_room(environment(ob), "只见高老者又很快的离去了。\n");
  return 1;
}
int feng(object ob) {
  object feng;
  ob = this_player();
  feng = present("feng qingyang", environment(ob));
  if (!objectp(feng)) return 0;
  tell_room(environment(ob), "风清扬离开了。\n");
  destruct(feng);
  return 1;
}
