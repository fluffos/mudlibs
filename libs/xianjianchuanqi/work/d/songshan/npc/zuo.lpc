#include <ansi.h>
inherit NPC;
inherit F_MASTER;

#include "zuo.h";

string do_ask();
string ask_me();
void create()
{
        set_name("左冷禅", ({ "zuo lengchan", "zuo", "lengchan" }));
        set("nickname", "嵩山派掌门人");
        set("long", "嵩山掌门左冷禅更是当今武林中了不起的人物，武功固然出神入化，
为人尤富机智，机变百出，江湖上一提到“左盟主”三字，无不惕然。\n");
        set("gender", "男性");
        set("age", 52);
        set("per", 20);
        set("attitude", "heroism");
        set("shen_type", -1);
        set("str", 29);
        set("int", 28);
        set("con", 28);
        set("dex", 28);
        
        set("max_qi", 5000);
        set("max_jing", 2800);
        set("eff_jingli", 2300);
        set("jiali", 50);
        set("combat_exp", 3000000);
        set("shen", -18000);

        set_skill("force", 290);
        set_skill("songshan-qigong", 300);
        set_skill("dodge", 290);
        set_skill("zhongyuefeng", 300);
        set_skill("strike", 290);
        set_skill("songyang-zhang", 300);
        set_skill("parry", 290);
        set_skill("sword", 290);
        set_skill("songshan-jian", 300);
        set_skill("literate", 150);
        set_skill("hanbing-shenzhang", 300);
        map_skill("force", "songshan-qigong");
        map_skill("dodge", "zhongyuefeng");
        map_skill("strike", "hanbing-shenzhang");
        map_skill("parry", "songshan-jian");
        map_skill("sword", "songshan-jian");
        prepare_skill("strike", "hanbing-shenzhang");
        set("inquiry", ([
                "job": (: do_ask() :),
                "任务": (: do_ask() :),
                 "观日": (: ask_me() :),
        ]));
        create_family("嵩山派", 4, "掌门人");
        set("chat_chance_combat", 20);
        set("chat_msg_combat", ({
                (: perform_action, "sword.feiwu" :),
                (: perform_action, "strike.hanbing" :),
                (: perform_action, "sword.jianqi" :),
        }));

        setup();
        carry_object(ARMOR_D("changpao1"))->wear();
        carry_object(BINGQI_D("changjian"))->wield();          
        add_money("gold", 2);
}

void attempt_apprentice(object ob)
{
     if(ob->query_skill("songshan-qigong",1) < 140 ||
        ob->query_skill("songshan-jian",1) < 140 ||
        ob->query_skill("songyang-zhang",1) < 140){
        command("say 你的武功还不够娴熟，再回去练练吧。");
        return;
        }
     command("say 好，我正想找些优秀弟子来传授寒冰神掌，看来你还不错嘛。");
     command("recruit " + ob->query("id"));
}
string ask_me()
{
        object ob;
        mapping fam; 

       if (!(fam = this_player()->query("family"))
            || fam["master_name"]!="左冷禅" )
                return "你不是我徒弟，我不会给你的，赶快滚回去！";
          ob=unew("clone/weapon/guanrijian");
        if(!clonep(ob)) return "宝剑已经被别人拿走了。";  
        if(clonep(ob) && ob->violate_unique()){
           destruct(ob);
           return "呵呵，宝剑已经被别人拿走了。";
           } 
        ob->move(this_player());
        return "好！我五岳剑派一统天下的希望就在你身上了,观日就借你一用。";
}


