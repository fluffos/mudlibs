inherit ROOM;

void create()
{
	set("short", "封禅台");
	set("long", @LONG
这绝巅独立天心，万峰在下。其时云开日朗，纤弱不生。向北望去，
遥见成皋玉门，黄河有如一线，西向隐隐见到洛阳伊阙，东南两方皆是重
重叠叠的山峰。这里虽已涂抹泥苔，仍可看出是新近补上，显然这封禅台
年深月久，颇已毁败，左冷禅曾命人好好修整一番，只是着意掩饰，不免
欲盖弥彰，反而令人看出来其居心不善。
LONG);
	set("exits", ([ 
            "southdown" : __DIR__"fengchantai",
        ]));
	set("outdoors", "嵩山");
	setup();
	replace_program(ROOM);
}
