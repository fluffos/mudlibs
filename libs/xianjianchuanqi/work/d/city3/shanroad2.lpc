inherit ROOM;

void create()
{
        set("short", "山路");
        set("long", @LONG
一条僻静的山间小路，极少有人迹，路边是又高又密的
杂草。一条向东北的路也不知通向哪。
LONG
        );
        set("exits", ([ 
  "northeast" :  __DIR__"shanroad3",
  "southwest" :  __DIR__"shangu",
  "west" :  __DIR__"shanjiao"
]));
        set("outdoors", "dali");
        set("coor/x",-680);
        set("coor/y",-900);
        set("coor/z",80);
        setup();
}



