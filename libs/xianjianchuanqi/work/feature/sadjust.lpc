void skill_adjust(object ob)
{
        mapping skl;
        string *sname;
        int i=3, lmt;

        lmt = (int)ob->query("combat_exp");
        if (lmt < 0) lmt = 0;
        if (ob->query("shen") > lmt) ob->set("shen", lmt);
        if (ob->query("shen") < -lmt) ob->set("shen", -lmt);
        if (ob->query("reputation") > lmt) ob->set("reputation", lmt);
        for (;i*i*i/10<=lmt;i++);
        lmt = i;
        ob->set("max_pot", 100 + lmt);
        
        skl = ob->query_skills();
        if (!sizeof(skl))
                return;
        sname = keys(skl);
        for (i = 0; i < sizeof(skl); i++) {
                if (!intp(skl[sname[i]])) skl[sname[i]] = 0;
                if (SKILL_D(sname[i])->type() == "martial" && skl[sname[i]] > lmt)
                        skl[sname[i]] = lmt;
        }
        switch (ob->query("family/family_name")) {
                case "昆仑派":
                        if (skl["art"] > 81) {
                                ob->add("max_jing",
                                        (skl["art"]/2)*(skl["xuantian-wuji"]/15));
                                ob->add("max_qi",
                                        (skl["art"]/2)*(skl["xuantian-wuji"]/15));
                        }
                        break;
                case "少林派":
                        if (skl["buddhism"] > 31)
                                ob->add("max_jing",(skl["buddhism"]/2)*(skl["yijin-jing"]/10));
                        if (skl["buddhism"] > 121)
                                ob->add("max_qi",(skl["buddhism"]/2)*(skl["yijin-jing"]/15));
                        break;
                case "峨嵋派":
                        if (skl["dacheng-fofa"] > 31)
                                ob->add("max_jing",(skl["dacheng-fofa"]/2)*(skl["linji-zhuang"]/10));
                        if (skl["dacheng-fofa"] > 101)
                                ob->add("max_qi",(skl["dacheng-fofa"]/2)*(skl["linji-zhuang"]/20));
                        break;
                case "桃花岛":
                        if (skl["qimen-bagua"] > 61){
                                ob->add("max_qi", (skl["qimen-bagua"]/2)*(skl["bihai-chaosheng"]/20));
                                ob->add("max_jing", (skl["qimen-bagua"]/2)*(skl["bihai-chaosheng"]/20));
                                }
                        break;
                case "武当派":
                        if (skl["taoism"] > 61)
                                ob->add("max_qi",(skl["taoism"]/2)*(skl["yinyun-ziqi"]/10));
                        if (skl["taoism"] > 121)
                                ob->add("max_jing",(skl["taoism"]/2)*(skl["yinyun-ziqi"]/25));
                        break;
                case "天龙寺":
                        if (skl["buddhism"] > 61)
                                ob->add("max_jing",(skl["buddhism"]/2)*(skl["qiantian-yiyang"]/10));
                        if (skl["buddhism"] > 121)
                                ob->add("max_qi",(skl["buddhism"]/2)*(skl["qiantian-yiyang"]/20));
                        break;
                case "星宿派":
                        if (skl["poison"] > 61)
                                ob->add("max_qi",(skl["poison"]/2)*(skl["huagong-dafa"]/10));
                        if (skl["poison"] > 121)
                                ob->add("max_jing",(skl["poison"]/2)*(skl["huagong-dafa"]/20));
                        break;
                case "白驼山派":
                        if (skl["hamashengong"] > 61)
                                        ob->add("max_qi",(skl["hamashengong"]/2)*((skl["training"]/20)+(skl["poison"]/25)));
                        if (skl["hamashengong"] > 121)
                                ob->add("max_jing",(skl["hamashengong"]/2)*2);
                        break;
                case "姑苏慕容":
                        if (skl["shenyuan-gong"] > 81)
                                ob->add("max_qi",(skl["shenyuan-gong"]/2)*15);
                        if (skl["shenyuan-gong"] > 151)
                                ob->add("max_jing",(skl["shenyuan-gong"]/2)*15);
                        break;
case "灵鹫宫":
                        if (skl["bahuang-gong"] > 81)
                                ob->add("max_qi",(skl["bahuang-gong"]/2)*15);
                        if (skl["bahuang-gong"] > 151)
                                ob->add("max_jing",(skl["bahuang-gong"]/2)*15);
                        break;
                case "丐帮":
                        if (ob->query("death_times") > 1){
                                ob->add("max_qi", ob->query("death_times") * ob->query("con"));
                                ob->add("max_qi", ob->query("death_times") * ob->query("con"));
                                }
                        if (skl["huntian-qigong"] > 81)
                                ob->add("max_qi",(skl["huntian-qigong"]/2)*15);
                        if (skl["huntian-qigong"] > 151)
                                ob->add("max_jing",(skl["huntian-qigong"]/2)*15);
                        break;
                case "明教":
                        if (skl["shenghuo-shengong"] > 81)
                                ob->add("max_qi",(skl["shenghuo-shengong"]/2)*15);
                        if (skl["qiankun-danuoyi"] > 81)
                                ob->add("max_jing",(skl["qiankun-danuoyi"]/2)*15);
                        break;
                case "密宗":
                        if (skl["lamaism"] > 61)
                                ob->add("max_jing",(skl["lamaism"]/2)*(skl["longxiang-gong"]/10));
                        if (skl["lamaism"] > 121)
                                ob->add("max_qi",(skl["lamaism"]/2)*(skl["longxiang-gong"]/20));
                        break;
                case "古墓派":
                        if (skl["yunu-xinjing"] > 81)
                                ob->add("max_qi",(skl["yunu-xinjing"]/2)*10);
                        if (skl["yunu-xinjing"] > 81)
                                ob->add("max_jing",(skl["yunu-xinjing"]/2)*15);
                        break;
                    case "嵩山派":
                        if (skl["songshan-qigong"] > 81)
                                ob->add("max_qi",(skl["songshan-qigong"]/2)*8);
                        if (skl["songshan-qigong"] > 81)
                                ob->add("max_jing",(skl["songshan-qigong"]/2)*5);
                        break;
                case "灵鹫宫":
                        if (skl["yangyanshu"] > 61)
                                ob->add("max_jing",(skl["yangyanshu"]/2)*(skl["bahuang-gong"]/10));
                        if (skl["yangyanshu"] > 121)
                                ob->add("max_qi",(skl["yangyanshu"]/2)*(skl["bahuang-gong"]/25));
                        break;
                case "逍遥派":
 if (skl["zhenyuan-gong"] > 61)
ob->add("max_jing",(skl["force"]/20)*(skl["force"]/20));
if (skl["zhenyuan-gong"] > 91)                                ob->add("max_qi",(skl["force"]/10)*(skl["force"]/20));


                        if (skl["beiming-shengong"] > 61)
                                ob->add("max_jing",(skl["beiming-shengong"]/2)*(skl["force"]/10));
                        if (skl["beiming-shengong"] > 71)
                                ob->add("max_qi",(skl["beiming-shengong"]/2)*(skl["force"]/20));
                        break;
                case "浣花剑派":
                        if (skl["guiyuan-dafa"] > 61)
                                ob->add("max_jing",(skl["guiyuan-dafa"]/2)*(skl["force"]/10));
                        if (skl["guiyuan-dafa"] > 101)
                                ob->add("max_qi",(skl["guiyuan-dafa"]/2)*(skl["force"]/20));
                        break;
                case "五毒教":
                        if (skl["wudu-shengong"] > 61)
                                ob->add("max_jing",(skl["wudu-shengong"]/2)*(skl["force"]/8));
                        if (skl["guiyuan-dafa"] > 101)
                                ob->add("max_qi",(skl["wudu-shengong"]/2)*(skl["force"]/18));
                        break;
 case "云龙门":
                        if (skl["yunlong-shengong"] > 61)
                                ob->add("max_jing",(skl["yunlong-shengong"]/2)*(skl["force"]/10));
                        if (skl["yunlong-shengong"] > 101)
                                ob->add("max_qi",(skl["yunlong-shengong"]/2)*(skl["force"]/20));
                        break;
                case "神龙教":
                        if (skl["shenlong-xinfa"] > 61)
ob->add("max_jing",(skl["shenlong-xinfa"]/2)*(skl["zhaosheshu"]/10));
                        if (skl["shenlong-xinfa"] > 101)
ob->add("max_qi",(skl["shenlong-xinfa"]/2)*(skl["zhaosheshu"]/20));
                        break;
                    case "华山派":
         if (skl["zhengqi-jue"] > 61 ) {
                                ob->add("max_qi",
                                        (skl["zhengqi-jue"]/2)*(skl["zixia-gong"]/10));
                        }
                        if (skl["ziyin-yin"] > 61 ) {
                                ob->add("max_jing",
                                        (skl["ziyin-yin"]/2)*(skl["zixia-gong"]/10));
                        }           
break;
                    case "铁掌帮":
                        if (skl["guiyuan-tunafa"] > 81)
                                ob->add("max_qi",(skl["guiyuan-tunafa"]/2)*15);
                        if (skl["guiyuan-tunafa"] > 81)
                                ob->add("max_jing",(skl["guiyuan-tunafa"]/2)*15);
                        break;
                        } 
}

