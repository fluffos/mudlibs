// alias.c
// From ES2
// Modified for XKX by Xiang (12/15/95)

#include <ansi.h>

#define MAX_REPEAT 40
#define MAX_ALIASES 40
#define HISTORY_BUFFER_SIZE 10

mapping alias;

nosave string *history, last_input;
nosave int last_cmd, repeat_cnt = 0, last_time = 0;

string process_input(string str)
{
	string *args, cmd, argstr;
	int i, j;
	object me = this_object();

	if (!living(me) && !wizardp(me)) return "";
	for (i=0; i<strlen(str); i++)
		if (str[i]!=' ') {str = str[i..<1]; break;}
	if (str == "") return str;
	if (++repeat_cnt > MAX_REPEAT) {
		repeat_cnt = 0;
		if (last_time == time()) {
			write("\n本系统发现你滥用指令！\n");
			message_vision(HIR "\n突然天空中乌云密布，一道白色的闪电象利剑般劈向$N。\n" NOR, me);
			this_object()->unconcious();
			message_vision(HIR "\n半空中隐约传来几声奸笑，天空又恢复了刚才的景象。\n\n" NOR, me);
			return "";
		}
		last_time = time();
	}

	if (!wizardp(me)) {
		if (me->query("jing") < 0
		|| me->query("qi") < 0
		|| me->query("jingli") < 0) {
			write("你马上要昏迷了，不能做任何事情。\n");
			return "";
		}
	}

	if (me->query_temp("big5")) str = "/adm/daemons/gb_b5d"->b5_gb(str);

	if( str[0]=='!' && str[0..2]!="!!!") {
		if( pointerp(history) && sizeof(history) ) {
			if( sscanf(str, "!%d", i) )
				str = (string)history[(HISTORY_BUFFER_SIZE + last_cmd - i) % HISTORY_BUFFER_SIZE];
			else
				str = history[last_cmd];
		} else
			return 0;
	} else {
		if( !pointerp(history) ) history = allocate(HISTORY_BUFFER_SIZE);
		last_cmd = (last_cmd + 1) % HISTORY_BUFFER_SIZE;
		history[last_cmd] = str;
	}

	if( mapp(alias) ) {
		if( !undefinedp(alias[str]) && str != "quit")
			return replace_string( alias[str], "$*", "" );

		if( sscanf(str, "%s %s", cmd, argstr)==2 && !undefinedp(alias[cmd]) && cmd != "quit") {
			cmd = replace_string( alias[cmd], "$*", argstr );
			args = explode(argstr, " ");
			if( (j = sizeof(args)) )
				for(i=0; i<j; i++)
					cmd = replace_string( cmd, "$" + (i+1), args[i] );
			return cmd;
		}
	}

	return (string)ALIAS_D->process_global_alias(str);
}

int set_alias(string verb, string replace)
{
	if( !replace ) {
		if( mapp(alias) ) map_delete(alias, verb);
		return 1;
	} else {
		if( sizeof(alias) > MAX_ALIASES )
			return notify_fail("您设定的 alias 太多了，请先删掉一些不常用的。\n");
        if (!mapp(alias)) alias = ([]);
		alias[verb] = replace;
		return 1;
	}
}

mapping query_all_alias()
{
	return alias;
}
