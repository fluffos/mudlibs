// force.c
#include <ansi.h>
inherit SKILL;

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
	int damage, i, max;

//add for beiming-shengong
        if(victim->query_skill("beiming-shengong", 1) > 50 
           && victim->query_skill_mapped("force") == "beiming-shengong"
           && random(victim->query_skill("force")) > me->query_skill("force")/2
           && random(victim->query_int()) > me->query_int()/2 
           && me->query("max_neili") > 1*(1+(victim->query_skill("beiming-shengong", 1)-50)/10)
           && !me->query_temp("weapon") && living(victim)
           && !me->query("no_beiming_suck") && !me->query("mute")
           && me->query("race")=="人类"){              
              i = 1*(1+(victim->query_skill("beiming-shengong", 1)-50)/10);
              tell_room(environment(me), HIR+me->name()+"与"+victim->name()+"一相接触，竟然如坠冰窖一般，全身一震！\n"NOR, ({ me, victim }));
              tell_object(me, HIR"你与"+victim->name()+"一接触，登时便感到自己的内力如水银般外泄！\n"NOR);
              tell_object(victim, HIW"你与"+me->name()+"一接触，体内的北冥神功顿时发动，将他的内力滔滔不绝地吸了过来！\n"NOR);
              if(me->query("max_neili") > i)
                 me->add("max_neili", -i);
              else me->set("max_neili", 0);
              victim->add("max_neili", i);
              max = victim->query_skill("force") * 10 + victim->query("age")*20 + victim->query("combat_exp")/1000;
              if (victim->query("max_neili") > max)
                victim->set("max_neili", max);
              if( !me->is_killing(victim->query("id"))) me->kill_ob(victim);
              me->start_busy(1);
              if(!victim->is_busy()) victim->start_busy(1);
              }
// end of beiming-shengong


        /* 防止轻微加力和不加力之间的巨大差别，如 jiali 1 */
	damage = (int)me->query("neili")/20 + factor - victim->query_con() - (int)victim->query("neili")/25;
        me->add("neili", - factor );

	if( damage < 0 ) {
		if( !me->query_temp("weapon")
                   && !me->query("env/invisibility")
                   && !me->query_temp("fanzhen")
		   && random(victim->query_skill("force")) > me->query_skill("force")/2 ) 
                   {
			damage = - damage;
			me->receive_damage( "qi", damage);
			me->receive_wound( "qi", damage/3 );
			if( damage < 50 ) return "$N受到$n的内力反震，闷哼一声。\n";
			if( damage < 80 ) return "$N被$n以内力反震，「嘿」地一声退了两步。\n";
			if( damage < 160 ) return "$N被$n以内力一震，胸口有如受到一记重锤，连退了五六步！\n";
			return "$N被$n的内力一震，眼前一黑，身子向后飞出丈许！！\n";
		}
		if( damage_bonus + damage < 0 ) return - damage_bonus;
		return damage;
	}

	damage -= victim->query_temp("apply/armor_vs_force");
	if (damage < 0) damage = 0;
	if( damage_bonus + damage < 0 ) return - damage_bonus;
	if( random(me->query_skill("force")) > damage )
		return damage;
	return damage/2;
}
