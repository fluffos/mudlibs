// dali_busy.c 

#include <login.h>
#include <ansi.h>
int update_condition(object me, int duration)
{
        if (duration < 1) {              
              me->clear_condition("mdjob");              
                  }
        if (!duration) return 0;
        me->apply_condition("mdjob", duration - 1);
        return 1;
}


