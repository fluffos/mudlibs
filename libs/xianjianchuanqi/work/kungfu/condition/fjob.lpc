#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration) {
  if (duration < 1) {
    if (!me->query_condition("after_fjob")) {
      me->delete_temp("fail_kill");
      me->delete_temp("st_kill");
      me->apply_condition("after_fjob", 7);
      tell_object(me, HIW "你没在指定的时间内杀掉蒙古鞑子，你的任务失败了！\n" NOR);
      message("chat", HIM "〖小道消息〗：听说" + me->query("name") + "行刺失败，逃回了扬州，真是可笑!\n" NOR, users());
    }
    return 0;
  }
  me->apply_condition("fjob", duration - 1);
  return 1;
}
