#include <ansi.h>
int update_condition(object me, int duration)
{
    if( duration < 1 ) 
     { 
        if (!userp(me))  {
               if(living(me)) {
                   message_vision("职业杀手突然扔出一片毒药，洒向$n!$n一个躲闪不及，中毒而亡。\n",me);
                   me->die();
				     }
		 	         }
        else
                tell_object(me, HIY"铁掌帮飞鸽传书：目标已死亡！你任务失败!\n" NOR );
          return 0;
     }
        me->apply_condition("tzjob_time", duration - 1);
        return 1;
}