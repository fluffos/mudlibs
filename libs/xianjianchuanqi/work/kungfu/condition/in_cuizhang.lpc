#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{
        if ( duration < 1 ) {
                if (!me->query_condition("after_fjob"))
                {
                        me->delete_temp("in_cui");
                         me->delete_temp("mark/完成");
                        me->apply_condition("after_cuizhang", 7);
                        tell_object(me, HIW"你真是笨啊，这点小事都办不好，你的任务失败了！\n"NOR);
                        message("chat", HIG"〖小道消息〗：听说"+me->query("name")+"连收帐这等小事都做不好，真是笨得出奇!\n"NOR,users());
                }
                return 0;
        }
        me->apply_condition("in_cuizhang", duration - 1);
        return 1;
}
