// created by yixian for mr throwing

#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{
   
      tell_object(me, HIB "突然你感觉体内的血流有些加快！\n" NOR );
      tell_room(environment(me), HIB + me->name()+"突然全身一颤，周身以成赤红色！\n" NOR,
                ({ me }));     
  
      me->receive_damage("qi", 25);
      if(userp(me))
          me->receive_wound("jing", 20);
      else me->receive_wound("jing", 40);
      if(!me->is_busy()) me->start_busy(2);
      me->set_temp("last_damage_from", "中飞剑毒");
      me->apply_condition("fly_sword_poison", duration - 1);
      if( duration < 1 ) return 0;
      return CND_CONTINUE;
}

string query_type(object me)
{
        return "poison";
}

