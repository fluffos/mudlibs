#include <ansi.h>

int update_condition(object me, int duration)
{
        if(me->query_temp("nopoison")) return 0;
        me->receive_wound("qi",35 + random(10));
        me->receive_wound("jing",5 + random(10));
        me->start_busy(2 +random(2));
        me->apply_condition("bt_poison", duration - random(5));
message_vision(HIR"$N脸色突然间变得灰白,看来是"HIW"白驼毒功"HIR"的毒性发作了！\n" NOR, me);
        if( duration < 1 ) return 0;
        return 1;
}
