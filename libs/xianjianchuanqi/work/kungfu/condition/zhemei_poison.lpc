#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration) {
  if (!living(me)) {
    message(
      "vision",
      me->name() + "“" HIR "哇" NOR "”的一声喷出一口" HIR "鲜血" NOR "!。\n",
      environment(me),
      me
    );
  } else {
    tell_object(me, HIG "你只觉得胸口一阵发闷，喉头一甜，吐出一口鲜血！\n" NOR);
    message("vision", me->name() + "眉头一蔟，似乎非常不舒服。\n",
      environment(me), me);
  }
  me->receive_damage("jing", 25);
  if (userp(me))
    me->receive_wound("qi", 30);
  else me->receive_wound("jing", 30);
  if (!me->is_busy()) me->start_busy(2);
  me->apply_condition("zhemei_poison", duration - 1);
  if (duration < 1) return 0;
  return CND_CONTINUE;
}

string query_type(object me) {
  return "poison";
}
