#include <ansi.h>
int update_condition(object me, int duration)
{
    if( duration < 1 ) 
     { 
        if (!userp(me))  {
               if(living(me)) {
                   message_vision("$N笑了两笑，转进人群中不见了。\n",me);
                   destruct(me);}}
        else
                tell_object(me, HIY"西夏国一品堂飞鸽传书：目标已消失！你任务失败!\n" NOR );
          return 0;
     }
        me->apply_condition("mizhao_job_time", duration - 1);
        return 1;
}