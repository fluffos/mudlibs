// huagu_poison.c

#include <ansi.h>

int update_condition(object me, int duration)
{
	int qi;
       //me->receive_wound("jing", 10);
       if(duration<0)
                return 0;
       if(!living(me))
            {
                me->set("huagu",0);
                return 0;
            }
       if( duration < 1 ) 
       {
          qi=me->query("huagu");
          if(qi>me->query("eff_qi") || qi<0 )
              qi=me->query("max_qi");
          me->receive_wound("qi", qi);
	    me->receive_damage("qi", qi);
           me->set("huagu",0);
           if (living(me))
		    message_vision(BLU "$N感到一阵剧痛，全身的骨头格格作响！\n" NOR, me);
	     else
		    message_vision(BLU "$N一声惨叫，全身的骨头一块块地化做了粉末！\n" NOR, me);
           return 0;
       }
	me->receive_damage("qi", 10);
	me->set_temp("last_damage_from", "化骨绵掌毒发作");
	me->apply_condition("huagu_poison", duration - 1);
	if (living(me))
		message_vision(BLU "$N感到有点疲倦！\n" NOR, me);
	else
       {
		message_vision(BLU "$N痛苦地呻咛了一声！\n" NOR, me);
              me->set("huagu",0);
              return 0;
             }
       if(me->query("neili")>800)
                me->add("neili",-800);
            else
         me->add("huagu",400);
	return 1;
}
