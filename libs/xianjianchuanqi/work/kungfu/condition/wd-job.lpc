#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

mapping *wd = ({
  ([ "wd": "雨后彩虹", "where": "/d/wudang/caihong" ]),
  ([ "wd": "望背坡", "where": "/d/wudang/wangbeipo" ]),
  ([ "wd": "山路", "where": "/d/wudang/shanlu1" ]),
  ([ "wd": "武当柏林", "where": "/d/wudang/wdbolin" ]),
  ([ "wd": "遇真宫", "where": "/d/wudang/yuzhengong" ]),
  ([ "wd": "松林大道", "where": "/d/wudang/sldadao" ]),
  ([ "wd": "松林", "where": "/d/wudang/songlin1" ]),
  ([ "wd": "松林", "where": "/d/wudang/songlin2" ]),
  ([ "wd": "石阶", "where": "/d/wudang/shijie2" ]),
  ([ "wd": "石阶", "where": "/d/wudang/shijie1" ]),
  ([ "wd": "玄岳门", "where": "/d/wudang/xuanyuemen" ]),
  ([ "wd": "山脚下", "where": "/d/wudang/wdroad8" ]),
  ([ "wd": "茶亭", "where": "/d/wudang/chating" ]),
  ([ "wd": "黄土路", "where": "/d/wudang/wdroad7" ]),
  ([ "wd": "十八盘", "where": "/d/wudang/shibapan" ]),
  ([ "wd": "石阶", "where": "/d/wudang/shijie3" ]),
  ([ "wd": "石阶", "where": "/d/wudang/shijie4" ]),
  ([ "wd": "紫霄宫大门", "where": "/d/wudang/zxgdamen" ]),
  ([ "wd": "山路", "where": "/d/wudang/shanlu2" ]),
  ([ "wd": "武当广场", "where": "/d/wudang/guangchang" ]),
  ([ "wd": "三清殿", "where": "d/wudang/sanqingdian" ]),
  ([ "wd": "西厢走廊", "where": "/d/wudang/xilang1" ]),
  ([ "wd": "练丹房", "where": "/d/wudang/liandanfang" ]),
  ([ "wd": "藏经阁", "where": "/d/wudang/cangjingge" ]),
  ([ "wd": "林间小径", "where": "/d/wudang/xiaolu4" ]),
  ([ "wd": "练功房", "where": "/d/wudang/liangongfang" ]),
  ([ "wd": "东厢走廊", "where": "/d/wudang/donglang2" ]),
});

mapping query_wd() {
  return wd[random(sizeof(wd))];
}

int update_condition(object me, int duration) {
  mapping wd, wdwhere;
  object ob;
  wd = this_object()->query_wd();
  wdwhere = wd["where"];

  if (duration < 1) {
    tell_object(me, HIB "你的巡查任务时限到了，快回去报告吧\n" NOR);
    me->set_temp("job/wd", 0);
    me->set_temp("job/wd-done", 1);
    return 0;
  }
  if (!living(me)) {
    message("vision", me->name() + "大呼道：死有重与泰山,我这次真是阴沟里翻船了！！\n", environment(me), me);
  } else {
    tell_object(me, HIB "忽然有人大呼，在" + wd["wd"] + "发现蒙古前哨了！\n" NOR);
    ob = new("/jobsys/tianhan_job/wdjob/menggubing");
    ob->move(wdwhere);
  }

  me->apply_condition("wd-job", duration - 1);

  if (duration < 1) {
    tell_object(me, HIB "你的巡查任务时限到了，快回去报告吧\n" NOR);
    me->set_temp("job/wd", 0);
    me->set_temp("job/wd-done", 1);
    return 0;
  }
  return CND_CONTINUE;
}
