#include <ansi.h>
inherit NPC;

int ask_job();

void create() {
  set_name("方正大师", ({ "da shi", }));
  set("long", "他是一位身材矮小的老年僧人，容颜瘦削，神色慈和，\n"
    "也瞧不出有多少年纪。\n"
  );
  set("nickname", "少林长老");
  set("gender", "男性");
  set("attitude", "friendly");
  set("class", "bonze");
  set("muren_winner", 1);
  set("no_get", "你膂力不够，背不起来。");

  set("age", 60 + random(20));
  set("shen", 1);
  set("str", 20);
  set("int", 20);
  set("con", 20);
  set("dex", 20);
  set("max_qi", 3000);
  set("max_jing", 5000);
  set("max_jingli", 5000);
  set("eff_jingli", 5000);
  set("neili", 3000);
  set("max_neili", 3000);
  set("jiali", 40);
  set("combat_exp", 1600000);

  set_skill("force", 180);
  set_skill("yijin-jing", 180);
  set_skill("dodge", 180);
  set_skill("shaolin-shenfa", 180);
  set_skill("parry", 180);
  set_skill("finger", 180);
  set_skill("yizhi-chan", 180);
  set_skill("buddhism", 180);
  set_skill("literate", 100);
  map_skill("force", "yijin-jing");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("finger", "yizhi-chan");
  map_skill("parry", "yizhi-chan");

  prepare_skill("finger", "yizhi-chan");
  create_family("少林派", 35, "弟子");

  set("inquiry", ([
    "救援": (: ask_job :),
  ]));

  setup();



  if (clonep()) call_out("remove_ob", 1200);
}

void remove_ob() {
  message_vision(HIR "$N不耐烦地说：怎么这么久还不到华山，老衲自己先去了。\n" NOR, this_object());
  destruct(this_object());
}

void init() {
  object me = this_player(), ob = this_object();
  object ob1, ob2;
  int i, teams;
  int exp, pot;
  int killed;
  int times;
  mapping exits;
  string *dirs;
  object env;
  int j;
  int k, m, n;
  object *envs;
  object *envs2;

  ::init();
  if (file_name(environment(ob)) == "/d/hs/yunu"
    && me == ob->query("jobleader")) {
    if (!me->query_temp("sljob")) {
      write_file("/log/job/sljob1", sprintf("%s 少林“救援华山”"
        + "任务出现BUG。\n", ctime(time())[4..19]));
      call_out("remove_obj", 1);
      return;
    }
    command("say 好了，历尽艰险，终于到了华山。");
    command("say 你们先回去告诉方丈，我和华山弟子一起抵抗魔教的进攻。");
    teams = ob->query("teams");
    for (i = 1; i <= teams; i++) {
      ob1 = ob->query_temp("team" + i);
      if (ob1) {
        if (teams == 1)
          exp = 600;
        else
          exp = 1000 / teams;
        killed = ob1->query_temp("sljob/killed");
        if (killed > 5)
          killed = 5;
        exp = exp + killed * 50 + random(killed * 50);
        times = ob1->query("sl_job");
        if (times < 200) exp += 0;
        else if (times < 500) exp += 100;
        else if (times < 1000) exp += 200;
        else if (times < 1800) exp += 300;
        else if (times < 2800) exp += 400;
        else if (times < 4000) exp += 500;
        else if (times < 5500) exp += 600;
        else if (times < 7000) exp += 700;
        else if (times < 8500) exp += 800;
        else if (times < 10000) exp += 900;
        else exp += 1000;
        exp += random(50);
        if (query_temp("sljob/totle") - query_temp("sljob/killed") > 2) {
          exp = exp - (query_temp("sljob/totle") - query_temp("sljob/killed")) * 100;
          if (exp < 100)
            exp = 100 + random(100);
        }
        if (exp > 2000) exp = 1800 + random(200);
        if (ob1->query_temp("sljob/killed") == 0 && teams > 1)
          exp = 80 + random(20);
        pot = exp / 5 + random(exp / 10);
        ob1->add("combat_exp", exp);
        ob1->add("potential", pot);
        if (ob1->query("potential") > ob1->query("max_pot"))
          ob1->set("potential", ob1->query("max_pot"));
        ob1->delete_temp("sljob");
        ob1->add("sl_job", 1);
        ob1->apply_condition("sljob", 10 + random(10 / teams));
        if (teams == 1)
          ob1->apply_condition("sljob", me->query_condition("sljob") + 5 + random(5));
        ob1->apply_condition("job_busy", 6);
        ob1->start_busy(2);
        tell_object(ob1, HIW "好，任务完成，你得到了"
          +CHINESE_D->chinese_number(exp)
          + "点实战经验和"
          +CHINESE_D->chinese_number(pot)
          + "点潜能。\n" NOR);
        write_file("/log/job/sljob1", sprintf("%s %s(%s) 救援"
          + "任务，总第%d次，共%d个杀手，杀死%d个，"
          + "奖励%d点。\n", ctime(time())[4..19],
          ob1->query("name"), ob1->query("id"),
          ob1->query("sl_job"), query_temp("sljob/totle"),
          query_temp("sljob/killed"), exp));
        // add for sl wuxiang-zhi's quest
        /*				if( ob1->query("family/family_name")=="少林派" 
					&& ob1->query("combat_exp")>2000000
					&& random(ob1->query("combat_exp"))>1500000
					&& random(ob1->query_skill("shaolin-shenfa",1))>200
					&& ob1->query("sl_job")>2000
					&& ob1->query_skill("buddhism",1)>180
					&& random(ob1->query_skill("buddhism",1))/5 == 0
					&& !me->query("wxz/done")
					) {
					command("whisper "+ob1->query("id")+" 刚才我碰到方生师弟，他似乎有一些"
						+"关于少林武技的想法要告诉你，请你马上去他那里一趟。");
					ob1->set("wxz/quest",1);
					write_file( "/log/quest/slskill", sprintf("%s %s(%s) 获得学习少林武技的机会。\n",
						ctime(time())[4..19], ob1->query("name"), ob1->query("id")) );
*/
      }
    }
    call_out("remove_obj", 1);

    /*		i=random(teams)+1;
		ob1=ob->query_temp("team"+i);
		if( ob1 && random(10)>4 ) {
			tell_object(ob1,HIG"你从"+ob->query("name")
				+"那里得到了一颗大还丹。\n" NOR);
			ob2=new("/clone/medicine/dahuan-dan.lpc");
			if( ob2 ) {
				ob2->set("owner",ob1->query("id"));
				ob2->move(ob1);
			}
			write_file( "/log/quest/neili", sprintf("%s %s(%s) 得到大还丹。\n",
				ctime(time())[4..19], 
				ob1->query("name"), ob1->query("id") ) );
		}
*/
    return;
  }

  if (me == ob->query("jobleader") && me->query_temp("sljob/asked") >= 2 && !environment(me)->query("no_fight")) {
    ob->add("neili", -(ob->query("max_qi") - ob->query("eff_qi")) / 2);
    ob->set("eff_qi", ob->query("max_qi"));
    ob->set("qi", ob->query("max_qi"));
    if (ob->query("neili") < 0) {
      ob->set("neili", 1000);
      if (ob->query("max_qi") > 1000) {
        ob->set("max_qi", ob->query("max_qi") - 1000);
        ob->set("qi", ob->query("max_qi"));
      }
    }
    if (me->query("id") != "tiantian")
      me->start_busy(1 + random(3));
    ob->add_temp("sljob/go", 1);
    if ((ob->query_temp("sljob/go") > 4 && random(10) < 3)
      || ob->query_temp("sljob/go") > 8) {
      ob->set_temp("sljob/go", 0);
      ob1 = new("/d/shaolin/npc/killer");
      message_vision(RED "突然从路边冲出一个魔教教徒，一声不吭的向"
        +ob->query("name") + "冲去。\n" NOR, ob);
      ob1->set("lvl", ob->query("lvl"));
      ob1->set("dashi", ob);
      ob1->move(environment(me));
      ob1->set_leader(ob);
      ob1->kill_ob(ob);
      ob->add_temp("sljob/totle", 1);
      ob->kill_ob(ob1);
      // 防止robot do job, 增加了dashi逃跑的代码
      // 逃跑的范围是以当前位置为圆心的一个园，半径
      // 是从这里开始第4行for循环语句中的常量来控制的
      if (random(20) == 0) {
        message_vision(HIY "" + ob->query("name") + "高喊一声：情况紧急，我撤退，你掩护。\n" NOR, me);
        envs = ({ file_name(environment(me)) });
        if (!envs)
          return;
        for (m = 0; m < 2; m++) {
          envs2 = envs;
          for (n = 0; n < sizeof(envs); n++) {
            exits = envs[n]->query("exits");
            dirs = keys(exits);
            for (k = 0; k < sizeof(dirs); k++) {
              env = envs[n]->query("exits/" + dirs[k]);
              if (env && !env->query("no_fight") && !env->query("sleep_room")) {
                for (j = 0; j < sizeof(envs2); j++) {
                  if (envs2[j] == env) break;
                }
                if (j == sizeof(envs2))
                  envs2 = envs2 + ({ env });
              }
            }
          }
          envs = envs2;
        }
        me->set_temp("env", envs);
        env = envs[random(sizeof(envs))];
        ob->move(env);
        ob1->move(env);
      }
    }
  }
}

void remove_obj() {
  destruct(this_object());
}

int ask_job() {
  object me = this_player();
  object ob = this_object();

  if (ob->query("jobleader") != me) {
    return 0;
  }

  if (me->query_temp("sljob/asked") == 0) {
    return 0;
  }

  if (me->query_temp("sljob/asked") > 1) {
    command("say 你刚才不是问过了吗？快去吧。\n");
    return 1;
  }

  command("say 好的，就请这位" + RANK_D->query_respect(me)
    + "在前面带路，前去恒山。");
  message_vision("$N决定跟随$n一起行动。\n", ob, me);
  ob->set_leader(me);
  ob->set("sljob/leader", me);
  me->set_temp("sljob/asked", 2);
  return 1;
}


void attempt_apprentice(object ob) {
  command("say 对不起，老衲现在不收徒。");
  return;
}

void unconcious() {
  object ob = this_object(), me;

  me = ob->query_temp("last_damage_from");

  if (!me) {
    ::unconcious();
    return;
  }

  if (userp(me)) {
    reincarnate();
    return;
  }
  ::unconcious();

  return;
}


void die() {
  object ob = this_object(), me;
  me = ob->query("jobleader");
  if (!me) {
    ::die();
    return;
  }

  tell_object(me, HIY "" + ob->query("name") + "不幸阵亡，你任务失败。\n" NOR);
  me->apply_condition("sljob", 0);

  ::die();
  return;
}
