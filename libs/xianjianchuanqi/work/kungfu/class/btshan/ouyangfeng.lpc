///ouyangfeng.c

#include <ansi.h>

inherit NPC;
inherit F_MASTER;

string ask_shezhang();
string ask_wan();
string ask_jiuyin1();


void create() {
  set_name("欧阳锋", ({ "ouyang feng", "ouyang", "feng" }));
  set("long", "他是白驼山庄主，号称“西毒”的欧阳锋。\n"
    + "由于习练「九阴真经」走火入魔，已变得精\n"
    + "神错乱，整日披头散发。\n");
  set("title", "白驼山庄主");
  set("gender", "男性");
  set("age", 53);
  set("nickname", HIR "西毒" NOR);
  set("shen_type", -1);
  set("shen", -150000);
  set("attitude", "peaceful");

  set("str", 30);
  set("int", 29);
  set("con", 30);
  set("dex", 28);

  set("inquiry", ([
    "蛇杖": (: ask_shezhang :),
    "九转龙蛇丸": (: ask_wan :),
    "九阴真经": (: ask_wan :),
  ]));

  set("qi", 6500);
  set("max_qi", 6500);
  set("jing", 5300);
  set("max_jing", 5300);
  set("neili", 8000);
  set("max_neili", 8000);
  set("jiali", 200);

  set("combat_exp", 4000000);
  set("score", 200000);

  set_skill("force", 300);
  set_skill("dodge", 300);
  set_skill("parry", 300);
  set_skill("hand", 300);
  set_skill("training", 300);
  set_skill("staff", 300);
  set_skill("poison", 300);
  set_skill("hamashengong", 300);
  set_skill("chanchu-bufa", 300);
  set_skill("shexing-diaoshou", 300);
  set_skill("lingshe-zhangfa", 300);
  map_skill("force", "hamashengong");
  map_skill("dodge", "chanchu-bufa");
  map_skill("hand", "shexing-diaoshou");
  map_skill("parry", "lingshe-zhangfa");
  map_skill("staff", "lingshe-zhangfa");

  create_family("白驼山派", 1, "开山祖师");
  set("chat_chance", 2);
  set("chat_msg", ({
    "欧阳锋自言自语道：何日白驼山派才能重霸江湖呢…\n",
    "欧阳锋道：我儿欧阳克必能够重振白驼山派雄风！\n",
    "欧阳锋道：江湖险恶，困难重重哪！\n",
  }));
  setup();
  carry_object("/d/baituo/obj/shezhang")->wield();
  carry_object("/clone/misc/cloth")->wear();
  carry_object("/d/baituo/npc/obj/wan");

  add_money("gold", 50);
}

void attempt_apprentice(object ob) {
  object me;
  mapping ob_fam, my_fam;
  string name, new_name;

  me = this_object();
  my_fam = me->query("family");
  if ((int)ob->query_skill("hamashengong", 1) < 120) {
    message_vision("欧阳锋对$N笑道：你的本门内功太低了,我还不能收你！\n", ob);
    return;
  }
  message_vision("欧阳锋拍拍$N的头，微微点了点头。\n", ob);
  command("say 想不到克儿去世后，我西毒门下终有了传人 !");
  name = ob->query("name");
  new_name = "欧阳" + name[2..3];
  ob->set("name", new_name);

  command("chat* haha");
  command("chat* 长叹道: 想不到克儿去世后，我西毒门下终有了传人 !");
  command("chat* 说道：从今以后" + name + "为我白驼少庄主,改名" + new_name + "!"); command("recruit " + ob->query("id"));
  ob->set("title", HIW "白驼山庄少庄主" NOR);
  return;
}


string ask_shezhang() {
  int i;
  object me, ob;
  mapping fam;
  me = this_object();

  if (!(fam = this_player()->query("family"))
    || fam["master_name"] != "欧阳锋")
    return "你不是我徒弟，我不会给你的，赶快滚回去！";
  ob = new("/d/baituo/obj/shezhang");
  ob->move(this_player());
  return "好吧，乖徒儿，师傅就把宝贝借给你用。";
}

string ask_wan() {
  int i;
  object me, ob;
  mapping fam;
  me = this_object();

  if (!(fam = this_player()->query("family"))
    || fam["master_name"] != "欧阳锋")
    return "你不是我徒弟，我不会给你的，赶快滚回去！";
  return "现在原料短缺,只有我身上还有最后一个了,我是不会给你的。";
}

string ask_jiuyin1() {
  object me, ob;
  mapping fam;
  me = this_player();
  if (!(fam = this_player()->query("family")) || fam["master_name"] != "欧阳锋")

  {
    message("vision",
      HIR "欧阳锋嘿嘿嘿嘿的阴笑一声：『九阴真经!你这小子是怎么知道的？』！\n"
      "欧阳锋看来想杀死" + me->name() + "！\n"
      NOR, environment(), this_object());
    kill_ob(this_player());
    return "小子，要怨就怨你命不好吧！";

  } else if (me->query_skill("force", 1) < 150
    || me->query_skill("hamashengong", 1) < 150
    || me->query_con() < 40) {
    return "你现在就问这个是不是早了点？？？";
  }
  me->set_temp("jiuyin_niezhuan", 1);
  command("nod");
  command("say 九阴真经，九阴真经，我好象是放在老山庄的密道里面了。");
  return "是头上脚下，还是脚上头下？？";
}
