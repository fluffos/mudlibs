// by dubei

#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("鸠摩智", ({ "jiumo zhi", "zhi" ,"ming wang"}));
        set("nickname", HIG "大轮明王" NOR);
        set("long",@LONG
他就是吐蕃国师鸠摩智，人称大轮明王。脸上神采飞扬，隐隐似有宝光流动，
更如是明珠宝玉，自然生辉。
LONG
        );
        set("title","雪山寺掌门");
        set("gender", "男性");
        set("age", 50);
        set("attitude", "friendly");
        set("shen", -20000);
        set("str", 30);
        set("int", 40);
        set("con", 30);
        set("dex", 30);
        set("max_qi", 5000);
        set("max_jing", 5000);
        set("jiali", 100);
        set("combat_exp", 2400000);
        set("per",20);
        set("eff_jingli",2500);
              set("unique", 1);
        set_skill("force", 200);
        set_skill("longxiang-gong", 220);
        set_skill("dodge", 200);
        set_skill("qingshen-fa", 200);
        set_skill("cuff", 200);
        set_skill("fuhu-quan", 200);
        set_skill("parry", 200);
        set_skill("sword", 200);
        set_skill("mingwang-jian", 200);
        set_skill("lamaism", 200);
        set_skill("literate", 100);
        set_skill("staff", 200);
        set_skill("xiangmo-chu", 200 );
        set_skill("strike", 200 );
        set_skill("huoyan-dao", 200);
        set("chat_chance_combat", 40);
        set("chat_msg_combat", ({
        	(: exert_function, "fumozhou" :),
                (: perform_action, "strike.honglian" :),
                (: perform_action, "strike.xiuluo" :)
        }));


        map_skill("force", "longxiang-gong");
        map_skill("dodge", "qingshen-fa");
        map_skill("cuff", "fuhu-quan");
        map_skill("parry", "huoyan-dao");
        map_skill("sword", "mingwang-jian");
        map_skill("staff", "xiangmo-chu");
        map_skill("strike","huoyan-dao");
        prepare_skill("strike", "huoyan-dao");
        create_family("密宗", 9, "掌门");
        set("class", "lama");

        setup();

        carry_object("/clone/armor/r-jiasha")->wear();
}

void attempt_apprentice(object ob)
{                 
        mapping fam; 

        string name, new_name;

        fam = ob->query("family");  

        if (!fam || fam["family_name"] != "密宗"){
                command("say "+RANK_D->query_respect(ob)+"与本派素无来往，不知此话从何谈起？");
                return;
                }       
        if ((int)ob->query_skill("longxiang-gong", 1) < 160 || (int)ob->query_skill("lamaism",1)<=160) {
                command("say 我密宗派是以龙象般若功为基础,密宗心法为辅,你还差的远呢,回去多多修炼吧。"); 
                return;
        }
         if ((int)ob->query_str() < 35 || (int)ob->query_con() <30) { 
                command("say 想修炼我的火焰刀,必须有宏伟的体魄,你臂力和根古欠佳,怎能学此绝学?"); 
                return;
        
        }  
        if (fam["generation"] <=9){
              command("say 我密宗门规甚严,我怎麽能受你为徒呢！");
              return;
              }   
              
        if ((int)ob->query("shen")> -1000000 || (int)ob->query("combat_exp",1) < 700000){
              command("say 我大轮明王可不收没什麽作为的弟子。"); 
             return;
             }
         command("smile"); 
        if (fam["generation"]!= 10){
         name = ob->query("name");
          new_name = "智" + name[2..3];
         ob->set("name", new_name);
              
        command("say 你资质甚佳,今后法名就叫做" + new_name + "，并封为国师,就跟随老衲一起光大我密宗武学吧！");
               
         }    
     
         command("recruit " + ob->query("id"));
         
}