// /kungfu/class/xueshan/daerba.c  达而巴
// by dubei

inherit NPC;
inherit F_MASTER;
string ask_fawang();
int checking(object me, object ob);
void create()
{           
        object ob;
        set_name("达而巴", ({ "daerba", "da" }));
        set("long",@LONG
他是金轮法王座下的大弟子。深得法王的真传。身穿一件黄色袈裟，头带僧帽。
LONG); 
        set("gender", "男性");
        set("age", 45);
        set("attitude", "heroism");
        set("shen", -9500);
        set("str", 40);
        set("int", 20);
        set("con", 25);
        set("dex", 25);
        set("per", 15);
        set("max_qi", 3000);
        set("eff_jingli", 2500);
        set("jiali", 50);
        set("combat_exp", 800000); 
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
		(: perform_action, "hand.dashouyin" :),
		(: exert_function, "fumozhou" :),
        }));
        set_skill("lamaism", 160);
        set_skill("literate", 100);
        set_skill("force", 160);
        set_skill("longxiang-gong", 160);
        set_skill("dodge", 160);
        set_skill("qingshen-fa", 160);
        set_skill("cuff", 160);
        set_skill("fuhu-quan", 160);
        set_skill("parry", 160);
        set_skill("hand", 160);
      set_skill("blade", 160);
        set_skill("dashou-yin", 160);
       set_skill("huoyan-dao", 160);
        set_skill("staff", 160);
        set_skill("xiangmo-chu", 160 );
        map_skill("force", "longxiang-gong");
        map_skill("dodge", "qingshen-fa");
        map_skill("cuff", "fuhu-quan");
        map_skill("parry", "xiangmo-chu");
        map_skill("hand", "dashou-yin");
        map_skill("staff", "xiangmo-chu");
       map_skill("blade", "huoyan-dao");
        prepare_skill("cuff", "fuhu-quan");
        prepare_skill("hand", "dashou-yin");
        create_family("密宗", 10, "弟子");
        set("class", "lama");
              set("inquiry",([
                "金轮法王"   : "就是我们大轮寺的护寺法王，也是在下的尊师，想拜他老人家为师，就要先过我这关。",
                "拜师"   : (: ask_fawang :),
        ]));
        setup();
        carry_object("/clone/armor/h-jiasha")->wear();
        if (clonep(this_object())){
           ob = unew(BINGQI_D("xiangmo-chu"));     
           if (!ob) ob = unew(BINGQI_D("gangzhang"));
           ob->move(this_object());
           ob->wield();
           }
}

void attempt_apprentice(object ob)
{                 
        mapping fam; 

        string name, new_name;
        fam = ob->query("family");  

        if (!fam || fam["family_name"] != "密宗"){
                command("say "+RANK_D->query_respect(ob)+"与本派素无来往，不知此话从何谈起？");
                return;
                }       
        if ((int)ob->query_skill("longxiang-gong", 1) < 100 || (int)ob->query_skill("lamaism",1)<=100) {
                command("say 我密宗派是以龙象般若功为基础,密宗心法为辅,你还差的远呢,回去多多修炼吧。"); 
                return;
                }
        if((int)ob->query_str()<35){
               command("say 我的金刚降魔杖需要很高的臂力才能学会,你条件不够,再去修炼吧。"); 
               return;
               } 
             if ((int)ob->query("shen")> -60000){
               command("say 你好象没为密宗出过什麽力啊。"); 
               return;
               }
        if (fam["generation"] <=10 && fam["master_name"] != "血刀老祖"){
              command("say 我密宗门规甚严,我怎麽能受你为徒呢！");
              return;
              }
        if ((string)ob->query("gender") != "男性") {
                command("say 修习密宗内功需要纯阳之体。");
                command("say 这位"+RANK_D->query_respect(ob)+"还是请回吧！");
                return;
                } 
        if ((string)ob->query("class") != "lama") {
                command("say 我密宗的清规戒律甚多。");
                command("say 这位"+RANK_D->query_respect(ob)+"还是请回吧！");
                return;
                }  
        command("smile"); 
        if (fam["generation"]!= 11){
            name = ob->query("name");
            new_name = "慧" + name[2..3];
            ob->set("name", new_name);  
            command("say 好吧,我就收你为徒,今后法名就叫做" + new_name + "！");   
            }    
         command("recruit " + ob->query("id"));
         
}


int checking(object me, object ob)
{

// object obj;

        if ( !present(ob, environment()) ) return 1;        

        if (me->is_fighting()){
                call_out("checking",1, me, ob);
                return 1;
                }
        if( me->query_temp("last_lost_to") == ob
           && me->query_temp("last_damage_from") == ob) {
                command("say 你已经尽数学会了我的功夫，看来法王他老人家又要多一名弟子了！\n");
                ob->set_temp("daerba_win",1);
                } 
        return 1;
}

int accept_fight(object ob)
{
        object me  = this_object();
        ob = this_player();
        if ( !ob->query_temp("mz_ask_fight") 
            || (int)me->query("eff_qi") < (int)me->query("max_qi") 
            || (int)me->query("neili") < (int)me->query("max_neili")/2
            || !present("xiangmo chu", me) || me->is_fighting()) 
                return 0;
                
        remove_call_out("checking");
        call_out("checking", 1, me, ob);
        ob->delete_temp("mz_ask_fight");
        return 1;
}

string ask_fawang()
{
// object ob;
       mapping fam;

       if (!(fam = this_player()->query("family")) || fam["family_name"] != "密宗")
                return RANK_D->query_respect(this_player())+"非我密宗弟子，何谈拜来我密宗拜师？";

       if ((int)this_player()->query_temp("mz_ask_fight")) 
                return RANK_D->query_respect(this_player())+"不是已经问完了吗？尽管出招吧！";
           
       if ((int)this_player()->query_temp("daerba_win")) 
                return RANK_D->query_respect(this_player())+"你不是都打赢我了吗?还打什麽?！";

       if (fam["master_name"] == "金轮法王")
                return RANK_D->query_respect(this_player())+"你已经是法王座下弟子了，怎麽又来戏弄贫僧！"; 

       if ((int)this_player()->query_skill("longxiang-gong",1) < 160)
                return RANK_D->query_respect(this_player())+"你的龙象般若火候不足，还是回去勤加练习吧！";
   
       command("consider");
       command("nod");
       this_player()->set_temp("mz_ask_fight", 1);
       return "你如果主意已定，我们就比划一下吧。";
}

