inherit NPC;
 void create()
{             
        set_name("大丑", ({ "da chou", "chou" }));
        set("long",@LONG
他是金轮法王的大弟子达尔巴的徒弟大丑。平素作恶多端。
LONG
        ); 
        set("gender", "男性");
        set("nickname", "藏边五丑");
        set("age", 35);
              set("per",2);
        set("attitude", "friendly");
              set("eff_jingli", 1500);
        set("shen", -6500);
        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);
        set("max_qi", 2000);
        set("max_jing", 2500);
        set("neili", 2000);
        set("max_neili", 2000);
        set("jiali", 50);
        set("combat_exp", 650000); 
        set("chat_chance_combat", 30);
        set("chat_msg_combat", ({
		(: perform_action, "hand.dashouyin" :),
		(: exert_function, "fumozhou" :),
        }));
        set_skill("lamaism", 120);
        set_skill("literate", 100);
        set_skill("force", 120);
        set_skill("longxiang-gong", 120);
        set_skill("dodge", 120);
        set_skill("qingshen-fa", 120);
        set_skill("cuff", 120);
        set_skill("fuhu-quan", 120);
        set_skill("parry", 120);
        set_skill("hand", 120);
        set_skill("dashou-yin", 120);
        set_skill("staff", 120);
        set_skill("xiangmo-chu", 120 );


        map_skill("force", "longxiang-gong");
        map_skill("dodge", "qingshen-fa");
        map_skill("cuff", "fuhu-quan");
        map_skill("parry", "xiangmo-chu");
        map_skill("hand", "dashou-yin");
        map_skill("staff", "xiangmo-chu");
        prepare_skill("cuff", "fuhu-quan");
        prepare_skill("hand", "dashou-yin");
        create_family("密宗", 12, "弟子");
        set("class", "lama");

        setup();
        carry_object("/clone/armor/h-jiasha")->wear(); 
            //  carry_object("/clone/weapon/staff")->wield(); 
}
 
