// /kungfu/class/emei/mie-jue.c
// Make by jackie 98.2

inherit F_MASTER;
inherit NPC;
#include "miejue.h"
int ask_sword();
void create()
{
        set_name("灭绝师太", ({
                "miejue shitai",
                "miejue",
                "shitai",
        }));
        set("long","她就是峨嵋派第三代掌门人灭绝师太了。\n"
"她容貌算得极美，但两条眉毛斜斜下垂，一副面相便变得极是诡异，几乎\n"
"有点儿戏台上的吊死鬼味道。\n"
        );

        set("gender", "女性");
        set("attitude", "friendly");
        set("class", "bonze");

        set("age", 50);
        set("shen", 12000);
        set("str", 42);
        set("int", 42);
        set("con", 42);
        set("dex", 42);
        set("max_qi", 2000);
        set("max_jing", 2000);
        set("neili", 2000);
        set("max_neili", 2000);
        set("jiali", 100);
        set("combat_exp", 3200000);
         

        set_skill("dacheng-fofa", 215);
        set_skill("linji-zhuang", 215);
        set_skill("jieshou-jiushi", 215);
        set_skill("huifeng-jian", 215);
        set_skill("sixiang-zhang", 205);
        set_skill("yanxing-daofa", 195);
        set_skill("hand", 195);
        set_skill("literate", 100);
        set_skill("strike", 195);
        set_skill("sword", 235);
        set_skill("blade", 225);
        set_skill("parry", 215);
        set_skill("dodge", 215);
        set_skill("force", 215);
        set_skill("anying-fuxiang", 225);
        set("inquiry",([
          "倚天剑" : (: ask_sword :),
        ]) );


        map_skill("force", "linji-zhuang");
        map_skill("sword", "huifeng-jian");
        map_skill("blade", "yanxing-daofa");
        map_skill("parry", "huifeng-jian");
        map_skill("dodge", "anying-fuxiang");
        map_skill("strike", "sixiang-zhang");
        map_skill("hand", "jieshou-jiushi");

        prepare_skill("hand", "jieshou-jiushi");

        create_family("峨嵋派", 3, "掌门");

        setup();
        carry_object("/d/emei/obj/changjian")->wield();
        carry_object("/d/emei/obj/shoes")->wear();
        carry_object("/d/emei/obj/cloth")->wear();
}
void init()
{
        object me, ob;
        ::init();
        ob = this_player();
        me = this_object();
        if (interactive(ob = this_player()) && !is_fighting()) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }       
     
}
void greeting(object me)
{
        mapping myfam;
        int shen;
        myfam = (mapping)me->query("family");
        shen = me->query("shen");

   if(!myfam || myfam["family_name"] != "峨眉派") command("say 不知施主到我峨眉有何事情？");
   else if(shen > 0 && shen < 100000) command("say 我娥眉弟子要多做侠义之事，你做的还不够？");
   else if(shen < 0){
        command("say 你满眼瘴气，身带邪气，从今天起你不再是娥眉弟子了！");
        command("expell " + me->query("id"));
        }
   else command("say 你的功夫进展如何了？");
}


