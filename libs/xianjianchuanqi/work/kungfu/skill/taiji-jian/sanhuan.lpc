//by jrx xjkx 2001


#include <ansi.h>

inherit F_SSERVER;

#include "/kungfu/skill/eff_msg.h";

int perform(object me, object target)
{
      
              int damage, p;
         object weapon;
        string msg, dodge_skill;

        if( !target ) target = offensive_target(me);
        

      weapon = me->query_temp("weapon");
      if( !target ) 
        target = offensive_target(me);

      if( !target || !me->is_fighting(target) )
              return notify_fail("三环套月只能在战斗中对对手使用。\n");

      if (!weapon || weapon->query("skill_type") != "sword"
       || me->query_skill_mapped("sword") != "taiji-jian")
              return notify_fail("你手里没有剑，无法使用三环套月！\n");

      if( (int)me->query_skill("taiji-jian",1) < 130 )
              return notify_fail("你的太极剑法不够娴熟，不能使用三环套月！\n");
      
      if( (int)me->query_skill("sword",1) < 130 )
              return notify_fail("你的基本剑法等级不够，不能使用三环套月！\n");  


      if( (int)me->query_skill("yinyun-ziqi", 1) < 130 )
              return notify_fail("你的氤氲紫气等级不够，不能使用三环套月！\n");

      if (me->query_skill_mapped("force") != "yinyun-ziqi")
                                return notify_fail("你所使用的内功不对。\n");

      if( (int)me->query("max_neili") < 1500 )
              return notify_fail("你的内力太弱，不能使用三环套月！\n");

      if( (int)me->query("neili") < 500 )
              return notify_fail("你的内力太少了，无法使用出三环套月！\n");
        
 
        msg = HIM "\n$N使出「三环套月」，招式一变，左手抚剑把，右手托剑，剑尖青光闪动，以一个圆弧将手中剑向$n轻轻挑出！\n"NOR;        
        
        if (random(me->query_skill("force",1)) > target->query_skill("force",1) /4 ){                     
                me->start_busy(1);
                target->start_busy(1); 
                me->add("neili", -100);
                me->add("jingli", -20);
                damage = (int)me->query_skill("taiji-jian", 1)/6;                
                damage = damage + random(damage);
                if(me->query("neili") > target->query("neili")*2 ) damage += random(damage);
                target->receive_damage("qi", damage);
                target->receive_wound("qi", damage/2);
                p = (int)target->query("qi")*100/(int)target->query("max_qi");
               msg += damage_msg(damage, "内伤");
               msg += "( $n"+eff_status_msg(p)+" )\n";       
                call_out("perform2", 0, me, target);    
                } 
        else {
                target->start_busy(1);
                me->add("neili", -100);
                dodge_skill = target->query_skill_mapped("dodge");
                if( !dodge_skill ) dodge_skill = "dodge";
                msg += SKILL_D(dodge_skill)->query_dodge_msg(target, 1);
                call_out("perform2", 0, me, target); 
        }
        message_vision(msg, me, target); 
        return 1;
}

int perform2(object me, object target, int p)
{
        int damage;
 object weapon;
        string msg, dodge_skill;
if( !target ) target = offensive_target(me);
        

      weapon = me->query_temp("weapon");
   if( !target || !me->is_fighting(target) )
              return notify_fail("三环套月只能在战斗中对对手使用。\n");

      if (!weapon || weapon->query("skill_type") != "sword"
       || me->query_skill_mapped("sword") != "taiji-jian")
              return notify_fail("你手里没有剑，无法使用三环套月！\n");

        if(!living(target)) 
          return notify_fail("对手已经不能再战斗了。\n");

        if( (int)me->query("neili", 1) < 400 )
                return notify_fail("你待要再出一剑，却发现自己的内力不够了！\n");     

        msg = BLU "\n然后$N移进一步，右手左招，左手右招，同样一剑接着挥出，上下连续，不着一点停顿的痕迹！\n"NOR;        
        if (random(me->query_skill("force")) > target->query_skill("force") / 3 &&
            me->query_skill("taiji-jian", 1) > 124 ){                
                me->start_busy(1);
                target->start_busy(1);
                me->add("neili", -100);
                me->add("jingli", -30);                
                damage = (int)me->query_skill("taiji-jian", 1)/4;                
                damage = damage*2 + random(damage);
                if(me->query("neili") > target->query("neili")*2 ) damage += random(damage);
                target->receive_damage("qi", damage);
                target->receive_wound("qi", damage/2);
                p = (int)target->query("qi")*100/(int)target->query("max_qi");
               msg += damage_msg(damage, "内伤");
                msg += "( $n"+eff_status_msg(p)+" )\n";                
                call_out("perform3", 0, me, target);  
        } 
        else 
        {
                me->add("neili", -100);
                dodge_skill = target->query_skill_mapped("dodge");
                if( !dodge_skill ) dodge_skill = "dodge";
                msg += SKILL_D(dodge_skill)->query_dodge_msg(target, 1);
                 call_out("perform3", 0, me, target);  
        }
        message_vision(msg, me, target); 
        return 1;
}

int perform3(object me, object target, int p)
{
        int damage;
       object weapon;
        string msg, dodge_skill;
if( !target ) target = offensive_target(me);
        

      weapon = me->query_temp("weapon");
   if( !target || !me->is_fighting(target) )
              return notify_fail("三环套月只能在战斗中对对手使用。\n");

      if (!weapon || weapon->query("skill_type") != "sword"
       || me->query_skill_mapped("sword") != "taiji-jian")
              return notify_fail("你手里没有剑，无法使用三环套月！\n");
        if(!living(target))
              return notify_fail("对手已经不能再战斗了。\n");

        if( (int)me->query("neili", 1) < 200 )
                return notify_fail("你待要再出一剑，却发现自己的内力不够了！\n");     

        msg = BLU "\n剑光紧接，$N手中剑又一次挥出急点$n右臂，这三剑剑势相联，剑气相叠，剑意相同，正合道家三清之属！\n"NOR;        
        if (random(me->query_skill("force")) > target->query_skill("force") / 3 &&
            me->query_skill("taiji-jian", 1) > 149 )
        {
                
                target->start_busy(random(2));
                me->add("neili", -100);
                me->add("jingli", -40);                
                damage = (int)me->query_skill("taiji-jian", 1)/2;                
                damage = damage*3 + random(damage);
                if(me->query("neili") > target->query("neili")*2 ) damage += random(damage);
                target->receive_damage("qi", damage);
                target->receive_wound("qi", damage/2);
                p = (int)target->query("qi")*100/(int)target->query("max_qi");
               msg += damage_msg(damage, "内伤");
                msg += "( $n"+eff_status_msg(p)+" )\n";     
        } else 
        {
                me->start_busy(2);
                target->start_busy(1);
                me->add("neili", -200);
                target->add("jingli", -100);
                dodge_skill = target->query_skill_mapped("dodge");
                if( !dodge_skill ) dodge_skill = "dodge";
                msg += SKILL_D(dodge_skill)->query_dodge_msg(target, 1);
        }
        message_vision(msg, me, target); 
        return 1;
}

