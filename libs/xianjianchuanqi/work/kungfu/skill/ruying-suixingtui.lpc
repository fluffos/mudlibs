// 如影随形腿 pfm_control
#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *a_msg=({
"$N纵身向前，忽然伸出左腿，一式「仗义执言」，直踢$n的头部",
"$N身形一闪，双足点地，一式「七星伴月」，在空中连踢七脚，直本$n的头、胸、臂",
"$N身体前倾，左脚画圆，右腿使出一式「佛界无边」，扫向$n的腰部",
"$N左足倏地弹出，连环六腿，分踢$n的头部，胸部和裆部，正是一式「转世轮回」",
"$N左足独立，右腿随身形反转横扫，一招「西天极乐」，踢向$n的$l",
"$N跃起在半空，双足带起无数劲风，一式「佛祖慈悲」迅捷无伦地卷向$n",
});

int valid_enable(string usage) { return usage=="leg" || usage=="parry"; }

int valid_combine(string combo)
 {
         object me;
         me = this_player();
         if ((int)me->query_int() + (int)me->query_con() >  90 )
                 return combo=="yizhi-chan" || combo=="longzhua-gong" 
                        || combo=="banruo-zhang" || combo=="jingang-quan" 
                        || combo=="qianye-shou" ;
 }

int valid_learn(object me)
{
        if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
                return notify_fail("学如影随形腿时手里不能拿武器。\n");
        if ((int)me->query_skill("yijin-jing", 1) < 60)
                return notify_fail("你的易筋经内功火候不够，无法学如影随形腿。\n");
        if ((int)me->query_int() > 42)
        {
        return 1;
        }
        else
        {
        if ((int)me->query_skill("jingang-quan") &&
                                ("yizhi-chan")   &&
                                ("longzhua-gong") &&
                                ("banruo-zhang") &&
                                ("qianye-shou"))
                return notify_fail("你的功力不够，无法同时学习两种以上的上乘功夫。\n");
        }
        
        if ((int)me->query("max_neili") < 600)
                return notify_fail("你的内力太弱，无法练如影随形腿。\n");
        return 1;
}
mapping query_action(object me)
{
        int level;
          string msg;
        level = (int)me->query_skill("ruying-suixingtui",1);
         msg=a_msg[random(sizeof(a_msg))] ;
        if( random(level) > level - level/12  )
                msg= select_color() + msg + NOR;
        if (me->query_temp("sl_rysxt"))
        {
            switch(me->query_temp("sl_rysxt"))
                {
                   case 5: msg = HIY"$N忽然跃起，左脚一勾一弹，霎时之间踢出一招「如
」字诀的穿心腿，直袭$n前胸"NOR; break;
                   case 4: msg = HIC"紧接着$N左腿勾回，将腰身一扭，那右腿的一招「影」字诀便紧随而至，飞向$n"NOR; break;
                   case 3: msg = HIM"只见$N右脚劲力未消，便凌空一转，左腿顺势扫出一招「随」字诀，如影而至"NOR; break;
                   case 2: msg = HIG"半空中$N脚未后撤，已经运起「形」字诀，内劲直透脚尖，在$n胸腹处连点了数十下"NOR; break;
                   case 1: msg = HIR"这时$N双臂展动，带起一股强烈的旋风，双腿霎时齐并，「如影随形」一击重重轰在$n胸堂之上"NOR; break;
                   default: msg = HIY"$N忽然跃起，左脚一勾一弹，霎时之间踢出一招「如」字诀的穿心腿，直袭$n前胸"NOR; break;
              }    
            me->add_temp("sl_rysxt", -1);                  
         }

        return (["damage_type":random(2)?"内伤":"瘀伤","action":msg ])
                + query_my_power(me,level,at_type_hand,attack_lvl_high,defense_lvl_normal);
}

int practice_skill(object me)
{
        if ((int)me->query("jingli") < 60)
                return notify_fail("你的精力太低了。\n");
        if ((int)me->query("neili") < 30)
                return notify_fail("你的内力不够练如影随形腿。\n");
        me->receive_damage("jingli", 50);
        me->add("neili", -20);
        return 1;
}

string perform_action_file(string action)
{
         return __DIR__"ruying-suixingtui/" + action;
}
