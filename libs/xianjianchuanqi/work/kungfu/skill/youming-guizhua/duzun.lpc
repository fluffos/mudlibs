#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target)
{
        string msg,msg1;
        int i;
        object weapon;
        if( !target ) target = offensive_target(me);
        if( !target || !me->is_fighting(target) )
                return notify_fail("「唯我独尊」只能在战斗中对对手使用。\n");
     

        if( (int)me->query_skill("youming-guizhua", 1) < 180 )
                return notify_fail("你的幽冥鬼爪不够娴熟，不会使用「唯我独尊」。\n");

        if( (int)me->query_str() < 40 )
                return notify_fail("你的臂力太低，不能使用「唯我独尊」。\n");
        if( (int)me->query("neili", 1) < 1200 )
                return notify_fail("你现在内力太弱，不能使用「唯我独尊」。\n");
        i = (me->query_skill("youming-guizhua", 1)/20);      
        msg = HIR  "\n$N仰天狂笑，运气于丹田，一式[唯我独尊]，双手暴起，势若疯魔般连接攻出！\n"NOR;
        msg1=HIY"$N怪叫一声，似乎疲惫不堪，招数也慢了下来。\n"NOR;
        me->add_temp("apply/strength", i);
        me->add_temp("apply/dodge", i);   
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),0);
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),0);
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),0);
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),0);
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),0);
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),0);
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),0);
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),0);
        
        me->add("neili", -800);
        me->start_busy(2);
        target->start_busy(3);
        me->add_temp("apply/strength",-i);
         me->add_temp("apply/dodge", -i); 
         message_vision(msg1, me,target);
 
       return 1;
}


