// powerup.c 易筋经加力
// writtwn by jrx

#include <ansi.h>
inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int exert(object me, object target)
{
        int skill;

        if( target != me )
                return notify_fail("你只能提升自己的战斗力。\n");
        if( (int)me->query("neili")<150)
                return notify_fail("你的内力不够。\n");
        if( (int)me->query_temp("powerup"))
                return notify_fail("你已经在运功中了。\n");
        if( (int)me->query_temp("jingang") ) 
                return notify_fail(HIG"你的全部功力都运在大金刚拳上了。\n"NOR);
        

        skill = me->query_skill("yijin-jing");

         message_vision(
        HIR "$N舌尖一咬，喷出一口鲜血，运起易筋经神功已将全身潜力尽数提起！\n" NOR, me);
        me->add_temp("apply/strength", 10);
        me->add_temp("apply/attack", skill*3/2);
        me->add_temp("apply/dodge", skill/2);
        me->set_temp("powerup", 1);
        me->add("neili", -50);

        me->start_call_out( (: call_other, __FILE__, "remove_effect", me, skill/2 :), skill);

        if( me->is_fighting() ) me->start_busy(2);

        return 1;
}

void remove_effect(object me,int amount)
{
        int skill;
        skill = me->query_skill("yijin-jing");
        me->add_temp("apply/strength", -10);
        me->add_temp("apply/attack", - skill*3/2);
        me->add_temp("apply/dodge", - skill/2);
        me->delete_temp("powerup");
        tell_object(me, "你的易筋经神功运行完毕，将内力收回丹田。\n");
}


