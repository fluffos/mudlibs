// regenerate.c
//inherit SSERVER;

//	2001.6.22	by jianxia 剑侠
//	路径：kungfu/skill/force/jing.c
//	解决tuna flood问题

int exert(object me, object target) {
  int n, q;

  if ((int)me->query("neili") < 20 || !me->query_skill("force"))
    return notify_fail("你的内力不够。\n");

  q = (int)me->query("eff_jing") - (int)me->query("jing");
  if (q < 10)
    return notify_fail("你现在精神饱满。\n");
  n = 100 * q / me->query_skill("force");
  if (n < 20)
    n = 20;
  if ((int)me->query("neili") < n) {
    q = q * (int)me->query("neili") / n;
    n = (int)me->query("neili");
  }

  me->add("neili", -n);
  me->receive_heal("jing", q);

  tell_object(me, "你深深吸了几口气，精神看起来好多了。\n");

  if (me->is_fighting())
    me->start_busy(1);

  return 1;
}
