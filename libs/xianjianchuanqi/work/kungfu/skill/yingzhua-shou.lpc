// yingzhua-shou.c 鹰爪擒拿手
#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *msg = ({
  "$N一式「金针渡线」，右手抬起，左手暗藏，突然拍向$n的$l",
  "$N侧身一晃，一式「双阳沓手」，左手拿向$n的肩头，右拳打向$n的胸口",
  "$N一式「飞鹰现爪」，双手环拢成爪，左手护体，右手扣向$n的$l",
  "$N身形住回一撤，一个斜身塌式，一式「大鹏展翅」，右掌向$n扫下",
  "$N使一式「孔雀剔翎」，一个闪身，左脚飞起，向$n的裆部踹去",
  "$N右手一伸，一式「猿猴摆手」，手臂突然长了数倍，在$n的$l一拂",
  "$N一式「雨打飞花」，整个身体歪歪斜斜，右手斜斜的拍向$n的$l",
  HIY "$N双手抱拳，一式「自在飞花」，左手慢慢的拍出，飘逸绝纶的拍向$n的$l" NOR,
});

int valid_enable(string usage) { return usage == "hand" || usage == "parry"; }
int valid_combine(string combo) { return combo == "hanbing-mianzhang"; }

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练鹰爪擒拿手必须空手。\n");
  if ((int)me->query_skill("shenghuo-shengong", 1) < 20)
    return notify_fail("你的圣火神功火候不够，无法学练鹰爪擒拿手。\n");
  if ((int)me->query("max_neili") < 100)
    return notify_fail("你的内力太弱，无法练鹰爪擒拿手。\n");
  return 1;
}
mapping query_action(object me, object weapon) {
  return ([
    "damage_type": random(2) ? "内伤" : "瘀伤",
    "action": msg[random(sizeof(msg))]
  ]) + query_my_power(
    me,
    (int)me->query_skill("yingzhua-shou", 1),
    at_type_hand,
    attack_lvl_normal,
    defense_lvl_normal
  );
}
int practice_skill(object me) {
  if ((int)me->query("jingli") < 30)
    return notify_fail("你的精力太低了。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练鹰爪擒拿手。\n");
  me->receive_damage("jingli", 25);
  me->add("neili", -5);
  return 1;
}
