//cuogu-shou.c -错骨手
#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *msg = ({
"$N斜身避过，伸手猛抓敌腕，左手拿向$n肘部，这一手是分筋错骨手中的「壮士断腕」，",
"$N凝神不动，待到$n近前，$N身子略偏，左手拿敌手臂，右手暴起，捏向$n$l，",
"$N施展擒拿手中的绞拿之法，左手向上向右，右手向下向左，双手交叉而落，一绞之下，同时拿向$n$l",
"$N右手钩转，已刁住$n手腕，“顺手牵羊”往外带出，右腿在$n右腿迎面骨上一拨，借力使力，",
"$N一个反手钩擒，抓向$n指关节,同时乘机直上，手指疾点$n胸口“鸠尾穴”，",
"$N运力于掌，右掌斗然探出，来抓$n手腕，这一下迅捷之至，随后，左掌反手劈向$n$l",
"$N伸食中两指扣向$n腕后“养老穴”,中指弹向$n的$l,这两下一气呵成，无比灵巧。",
"$N右掌立缩，左掌横劈,一掌劈下化掌为抓，拿向$n的$l,右掌化指，点$n的“檀中穴”",
});

int valid_enable(string usage) { return  usage=="hand" || usage=="parry"; }

int valid_learn(object me)
{
        if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
                return notify_fail("练分筋错骨手须空手。\n");
        if ((int)me->query_skill("mingyun-qingqi", 1) < 80)
                return notify_fail("你的冥云清气不够，无法学分筋错骨手。\n");
        if ((int)me->query("max_neili") < 250)
                return notify_fail("你的内力太弱，无法练分筋错骨手。\n");
        return 1;
}

mapping query_action(object me, object weapon)
{
        int level;
        string a_msg;
        level = (int)me->query_skill("cuogu-shou",1);
        a_msg=msg[random(sizeof(msg))] ;
  if( random(level) > level - level/6 )
            a_msg=select_color() + a_msg + NOR;
  if(me->query("bai_guo"))
    return (["damage_type":"拉伤","action":a_msg,"weapon":"手指" ])
                + query_my_power(me,level,at_type_hand,attack_lvl_middle,defense_lvl_high);
      return (["damage_type":"拉伤","action":a_msg,"weapon":"手指" ])
                + query_my_power(me,level,at_type_hand,attack_lvl_middle,defense_lvl_middle);
}

int practice_skill(object me)
{
        if ((int)me->query("qi") < 50)
                return notify_fail("你的体力太低了。\n");
        if ((int)me->query("neili") < 25)
                return notify_fail("你的内力不够练分筋错骨手。\n");
        me->receive_damage("qi", 40);
        me->add("neili", -20);
        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"cuogu-shou/" + action;
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
   if( random((int)me->query_skill("hand",1)) > (int)victim->query_skill("dodge",1)/2 && random(6)>3 && 
(int)me->query_skill("hand",1) > 100 && (int)me->query("neili") > 100 ) 
        { victim->start_busy(random(4));
        // 这里最好加上 个描述
         message_vision(WHT"只见$N出手如风，抓住一瞬即逝的一个机会，看准了$n的破绽！\n"NOR, me, victim);        
        }
}
int ob_hit(object ob, object me, int damage)
{
        object wp,wp1;
        string msg1,msg2,msg3;
        int j,skill,neili,neili2;
        wp = me->query_temp("weapon");
                wp1 = ob->query_temp("weapon");
        skill = me->query_skill("parry", 1);
                neili=me->query("neili");
                neili2=ob->query("neili");
      if( me->query_skill("sword",1)>120 && me->query_skill("blade",1)>120
         && me->query_skill("force",1)>169 && (wp1) &&(!wp)&& me->query("bai_guo")
         && (random(me->query("combat_exp") )>random(ob->query("combat_exp")))
         //&& (random(skill) > skill - skill/3)
     && me->query("neili")>500 && me->query("con")>19)
         {        
         msg1 = CYN"$N手中伸出食指，一指点向$n的手腕的脉门，$n连忙缩手。\n"NOR;
         msg2 = CYN"$N眼见躲闪不及，双掌运足一股劲风往"+wp1->query("name")+"上一托。\n"NOR;
                 msg3 = CYN"$N深深吸了口气，运足真力，伸出中指向"+wp1->query("name")+"侧面弹去。\n"NOR;
           if( random(neili) > neili2/2 && random(6) > 3 ) 
                        {
              msg1 += "结果$n的力道被迫收回大半！\n";
              j = -damage*2/3;
                   message_vision(msg1, me, ob);
              }
           else if( random(neili) > neili2/3 ){
              msg2 += "结果$n的力道被卸掉了一半！\n";
              j = -damage/2;
           message_vision(msg2, me, ob);
                          }
           else{
              msg3 += "结果$n的力道只被弹掉了一小半！\n";
              j = -damage/3; 
            message_vision(msg3, me, ob);
              }           
           return j; 
       }          
}

