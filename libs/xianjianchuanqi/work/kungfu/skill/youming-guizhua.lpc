// youming-guishou 幽冥鬼爪
#include <ansi.h>;
inherit SKILL;

int lvl_temp;

string *action_msg = ({
BLU "$N身如幽魂，毫不着力，左飘右晃，刹时间双手急往$n的$l抓去。" NOR,
BLU "$N飘往半空，单手掠起一股劲风，双脚连踢，直取$n的$l。"NOR,
BLU "$N脸色变换，双手伸出，将$n防守招数尽格在外门，右脚对着$n的$l连踢五次!"NOR,
BLU "$N移步换位，绕到$n的身后，一双冰冷的大手抓向$n的$l!"NOR,
BLU "$N双臂弯出，柔若无骨，无声无息间抓向$n的$l!"NOR,
});

int valid_enable(string usage)
{
        return usage == "claw" || usage == "parry" ;
}
  mapping query_action(object me, object weapon)
{
        lvl_temp = random((int)me->query_skill("youming-guishou", 1));
        if ( lvl_temp > 100 && me->query("neili") > 2000)
        {
           if (lvl_temp <= 150){
               me->add("neili", -80);
               return ([
                      "action": RED"$N厉叫一声，双手齐出，如雷似电，疾往$n的$l抓去。"NOR,
        "damage_type":random(800)?"抓伤":"内伤",          
             "dodge": 5,
    "force" : 540,
                      ]);
               }
           else{
               me->add("neili", -120);
               return ([
                "action": RED "$N全身白雾蒙蒙，如烟似幻，招招不离$n的要害部位。"
                          RED 
"双手如地狱鬼爪，
身如冤魂，飘忽之间，抓向$n的$l。"NOR,
                "damage_type": "内伤",
                "dodge": 5,
    "force" : 680,
                ]);
                }
        }

        return ([
                "action": action_msg[random(sizeof(action_msg))],
                "damage_type": random(1300)?"抓伤":"内伤",                "dodge": random(50),
                "force": 80 + lvl_temp,
        ]);
}

int practice_skill(object me)
{
                 object weapon;

                 if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
                 return notify_fail("练幽冥鬼爪必须空爪。\n");

                 if ((int)me->query("neili") < 155)
                                        return notify_fail("你的内力不够练幽冥鬼爪。\n");
                 if ((int)me->query("jingli") < 155)
                                        return notify_fail("你的精力不够练幽冥鬼爪。\n");
                 me->add("neili", -70);
                me->add("jingli", -70);
                  return 1;
}

int valid_learn(object me)
{
                 if ((int)me->query("kar") > 16)
                                        return notify_fail("你先天不足,是学不了这一式的。\n");
                 if ((int)me->query("max_neili") < 800)
                                        return notify_fail("你的内力不够。\n");
                 
}
string perform_action_file(string action)
{
        return __DIR__"youming-guizhua/" + action;
}


