// jinyan-gong.c 金雁功 全真武功

inherit SKILL;
string *dodge_msg = ({
  "$n微一侧身，轻轻向前一纵，一式「北雁南飞」，轻描淡写地躲过$N的一击。\n",
  "$n一式「雁去无痕」，长身而起飘然后退，$N一击不中，$n已落在丈许之外。\n",
  "$n虚步前跨，脚踩七星方位，由天玑至玉衡，一招「回神转玄」已然绕到$N身后。\n",
  "$n微微一笑，足不动，身不摆，一式「鸿雁双飞」如清烟般冉冉而起，滑向$N左侧。\n",
  "$n身形突变，使出「边秋飞雁」，围绕$N四处游走顿时幻化出无数人影，$N目瞪眼呆不知击向何处。\n",
  "$n一式「暮雁南飞」，身形飘忽浑不着力，如一片鸿毛随风而动，堪堪躲过$N狂风暴雨般的攻势。\n",
  "$n身子如陀螺般急速旋转起来，一招「雁抹金河」将$N的攻势统统化解。\n",
  "$n一式「雁下芦洲」，衣袂飘飘，随着$N的走势而动，在$N大惊之下$n已飘然滑开！\n",
  "只见$n一式「胡雁哀鸣」拔地而起，在半空中转了数转，$N的攻势尽告落空。\n",
  "$n使出「上天梯」身体斗然拔起，越升越高，空中微一转折落在数丈之外，将$N的攻势尽数化于无形！\n",
});

string query_dodge_msg(object me) {
  return dodge_msg[random(sizeof(dodge_msg))];

}

int valid_enable(string usage) {
  return usage == "dodge" || usage == "move";
}

int valid_learn(object me) {
  return 1;
}

int practice_skill(object me) {
  if ((int)me->query("jingli") < 60)
    return notify_fail("你的精力太差了，不能练金雁身法。\n");
  me->receive_damage("jingli", 50);
  return 1;
}
