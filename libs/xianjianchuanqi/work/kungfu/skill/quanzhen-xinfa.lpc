// quanzhen-xinfa.c 全真心法

#include <ansi.h>
inherit FORCE;

#include "/kungfu/skill/force.h"
int valid_enable(string usage) { return usage == "force"; }

int valid_learn(object me)
{
        int lvl = (int)me->query_skill("quanzhen-xinfa", 1);
        int t = 1, j;

        for (j = 1; j < lvl / 10; j++) t *= 2;
        if (t > 5000) t = 5000;
        if ( me->query("gender") == "无性" && lvl > 49)
                return notify_fail("你无根无性，阴阳不调，难以领会高深的全真心法。\n");

        if ((int)me->query_skill("force", 1) < 15)
                return notify_fail("你的基本内功火候还不够。\n");

        if ((lvl > 10 && lvl < 100 && (int)me->query("shen") < t * 200)
            || ( lvl >=100 && (int)me->query("shen") < 10000))
                return notify_fail("你的侠义正气太低了。\n");

        return 1;
}

int practice_skill(object me)
{
        return notify_fail("全真心法只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func)
{
        return __DIR__"quanzhen-xinfa/" + func;
}

mapping exercise_msg(object me)
{
  return ([
    "status_msg" : HIC + me->name()+"鼻息绵绵，魂不内荡，神不外游" NOR,
    "start_my_msg" : HIC"你五气朝元，和合四象，深深吸一口气引如丹田，丹田中有一股气渐渐上来。\n"NOR,
    "start_other_msg" : HIC + me->name()+"盘膝坐下，鼻息绵绵，魂不内荡，神不外游。\n"NOR,
    "halt_msg" : HIW"$N眼中精光一闪，将内息压回丹田，双臂一震，站了起来。\n"NOR,
    "end_my_msg" : CYN"你精化为气，气化为神，神化为虚，内息在体内运行十二周天，返回丹田。\n"NOR,
    "end_other_msg" : CYN + me->name()+"长出一口气，一抖衣襟，站了起来，眼中精光一闪。\n"NOR
  ]);
}


