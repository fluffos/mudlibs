// liuyang.c
// created by yixian


#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target)
{
        string msg,msg1;
        int i;
        object weapon;
        if( !target ) target = offensive_target(me);
        if( !target || !me->is_fighting(target) )
                return notify_fail("『云聚六阳』只能在战斗中对对手使用。\n");
        
        if(objectp(me->query_temp("weapon"))) 
                return notify_fail("你必须空手才能使用『云聚六阳』。\n");
        

        if( (int)me->query_skill("liuyang-zhang", 1) < 100 )
                return notify_fail("你的天山六阳掌不够娴熟，不会使用『云聚六阳』。\n");




        if ( me->query_skill_mapped("force") != "beiming-shengong")
                return notify_fail("你的内功等级不够，不能使用『云聚六阳』。\n");
                
        if( (int)me->query("neili", 1) < 800 )
                return notify_fail("你现在内力太弱，不能使用『云聚六阳』。\n");
        if((int)me->query("jingli",1)<400)
               return notify_fail("你现在精力太少，不能使用『云聚六阳』。\n");
         i = (me->query_skill("liuyang-zhang", 1)/3);
        
        message_vision(HIY"$N身随意动，一式『云聚六阳』向$n施展开来！"NOR,me,target);
        
        me->add_temp("apply/strength", i);
        me->add_temp("apply/attack", i); 
        target->start_busy(1);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);       
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);

        me->add_temp("apply/strength",-i);
        me->add_temp("apply/attack", -i); 
        

        me->start_busy(1+random(3));
        
        me->add("neili",-500);
      return 1;
}

