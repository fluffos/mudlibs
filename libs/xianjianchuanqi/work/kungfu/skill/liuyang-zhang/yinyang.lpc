#include <ansi.h>

inherit F_SSERVER;

int perform(object me, object target)
{
        int damage;
        string msg;

        if( !target ) target = offensive_target(me);

        if( !target || !target->is_character() || !me->is_fighting(target) || !living(target))
                return notify_fail("阴阳合击只能对战斗中的对手使用。\n");



        if( (int)me->query_skill("liuyang-zhang", 1) < 70 )
                return notify_fail("你的天山六阳掌不够娴熟，不能使出阴阳合击。\n");

        
        if( (int)me->query("neili", 1) < 400 )
                return notify_fail("你现在真气不充盈，强行使用阴阳合击是发挥不了威力的！\n");                   
        if( me->query_temp("weapon"))
                return notify_fail("你先放下手中的武器再说吧！\n");     
        if( target->is_busy())
                return notify_fail("对方正在忙乱中呢，你不忙使用阴阳合击。\n");   


 msg =CYN"\n$N深吸一口气，逆运八荒六合惟我独尊功，左掌阳，右掌阴，拍出两股截然不同的掌风。\n"NOR;
        
        if(random(me->query("combat_exp")) > target->query("combat_exp")/2){
                damage = (int)me->query_skill("liuyang-zhang", 1)/20; 
                damage = 2+random(damage);
                if(damage > 8) damage = 8; 
                target->add("qi", -(damage*40));
                target->start_busy(damage);
                target->apply_condition("no_perform", damage*damage);
                me->add("neili", -(damage*20));
                msg += HIR"$n被$N的阴阳掌力拍中，脸上忽红忽白，看来受了不轻的暗伤。\n"NOR;       
                } 
        else{
                me->start_busy(3);
                me->add("neili", -150);
                msg += HIY"$n只感觉得掌风扑面，赶紧稳住步法将劲力卸到一旁。\n"NOR;
             }
        message_vision(msg, me, target);

        
       return 1;
}

