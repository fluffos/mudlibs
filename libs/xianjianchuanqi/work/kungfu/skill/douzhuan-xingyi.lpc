// douzhuan-xingyi 斗转星移
//#include <pfm_control.h>
#include <ansi.h>
inherit SKILL;
#include "/kungfu/skill/eff_msg.h";

string *parry_msg = ({
  "$N一股劲力冲向$n，$n击向$N的招数莫名奇妙的溜滑向一旁",
  "$N双手前探，左臂搭上$n右臂，右臂使出$n的招数将$n此招化去",
  "$N凝神运气向$n猛攻快打，使出的招数好似$n的成名绝技，把$n的招数化于无行",
  "只见$N身如飘风，恰似漫天星移，诡异地一式，双掌动向无定不可捉摸地拍向$n",
  "$N身行飘忽不定，在星移斗转之间反用$n的招数击向$n，却令人$n百思不得其解",
});

int valid_enable(string usage) {
  return usage == "parry";
}

string query_parry_msg(object weapon) {

  return parry_msg[random(sizeof(parry_msg))] + "。\n";
}

int valid_learn(object me) {
  if ((int)me->query_skill("douzhuan-xingyi", 1) < 200)
    return notify_fail("斗转星移开始只能通过领悟来提高。\n");
  return 1;
}

int practice_skill(object me) {
  if ((int)me->query_skill("douzhuan-xingyi", 1) < 200)
    return notify_fail("斗转星移开始只能通过领悟来提高。\n");
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "douzhuan-xingyi/" + action;
}

int ob_hit(object ob, object me, int damage) {
  string msg, *limbs;
  object wp;
  int p, j, skill, neili, neili1;
  skill = me->query_skill("douzhuan-xingyi", 1);
  neili = me->query("neili");
  neili1 = ob->query("neili");
  wp = ob->query_temp("weapon");
  if (!living(ob)) return 0;

  if (random(skill) < ob->query_skill("parry", 1) / 2 || skill < 100 || neili < 300)
    return 0;
  if (random(skill) > (int)ob->query_skill("parry", 1) / 2 && random(6) > 3) {
    message_vision(HIG "$N使出斗转星移，$n这招竟然莫名其妙的在中途转了方向，直奔自己袭来\n" NOR, me, ob);
    if (damage > 2000) damage = 2000;
    //       ob->receive_damage("qi", damage+(int)me->query("jiali"));
    ob->receive_damage("qi", damage);
    ob->receive_wound("qi", damage / 4);
    p = ob->query("qi") * 100 / ob->query("max_qi");
    if (objectp(wp)) {
      limbs = ob->query("limbs");
      msg = damage_msg(damage, "刺伤");
      msg = replace_string(msg, "$w", wp->query("name"));
      msg = replace_string(msg, "$l", limbs[random(sizeof(limbs))]);
    } else
      msg = damage_msg(damage, "内伤");
    msg += "( $n" + eff_status_msg(p) + " )\n";
    message_vision(msg, me, ob);
    j = -8000;
    return j;
  }

  msg = select_color() + parry_msg[random(sizeof(parry_msg))] + NOR;
  message_vision(msg, me, ob);
  if (random(neili) > neili1 / 3) {
    msg = "\n基本上卸掉了$n的力道。\n";
    j = -(damage + skill);
  } else {
    j = damage / 2 + random(damage / 2);
    if (j < damage / 2) msg = "\n卸掉了一些$n的力道。\n";
    else msg = "\n卸掉了$n一半的力道。\n";
    j = -j;
  }
  message_vision(msg, me, ob);
  return j;
}
