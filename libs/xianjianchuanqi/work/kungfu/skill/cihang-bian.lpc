//慈航鞭,
//取自普明禅师<牧牛图颂>
#include <ansi.h>
#include <power_control.h>
inherit SKILL;

string *body_name = ({
  "左手腕", "左胳膊", "脖子", "头部", "腰部", "左腿", "小腿", "左脚脚腕", "右手腕", "右胳膊", "右腿", "右脚脚腕", });

string *msg = ({
  "$N双手合什，内力灌注, 一式「未牧」，腰间$w似有灵性，笔直的刺向$n的$l",
  "$N沉肩滑步，手中$w一抖，一式「初调」，迅捷无比地分打左右两侧，$n顿时左右支绌，慌了手脚",
  "$N将内力注入$w，蓦地使出一式「受制」，$w矫夭飞舞，直如神龙破空一般抽向$n",
  "$N一声清啸，手中$w一招「回首」，划出漫天鞭影铺天盖地地向$n卷来，势道猛烈之极",
  "$N急速旋绕手中$w，一式「驯服」，挥出无数旋转气流向$n逼去 ",
  "$N身体凌空飞起，右手大力挥出$w，一式「无碍」，一股排山倒海的鞭风直击向$n",
  "$N面露微笑跨前一步，右手$w轻扬，使出一式「任运」，鞭势平和中正，不带丝毫霸气",
  "$N向前急进，双手握住$w，缓缓使出一式「相望」，鞭势沉稳, 一股劲风破空而起",
  "$N狂舞手中$w，一式「独照」，鞭若蛟龙, 盘旋飞舞",
  "$N身体螺旋飞舞，手中$w突然挥出，使出一式「双泯」，鞭势犹如雨中闪电,气势惊人",
});
int valid_enable(string usage) { return (usage == "whip") || (usage == "parry"); }
int valid_learn(object me) {
  object weapon;
  if ((int)me->query("max_neili") < 100)
    return notify_fail("你的内力不足，没有办法练习鞭法, 多练些内力再来吧。\n");
  if ((int)me->query_skill("kurong-changong") < 20)
    return notify_fail("你的枯荣禅功修为不够。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "whip")
    return notify_fail("你必须先找一条鞭子才能练鞭法。\n");
  return 1;
}

mapping query_action(object me, object weapon) {
  int level;
  level = (int)me->query_skill("cihang-bian", 1);
  return ([
    "damage_type": random(2) ? "拉伤" : "割伤",
    "action": msg[random(sizeof(msg))]
  ]) + query_my_power(me, level, at_type_weapon, attack_lvl_middle, defense_lvl_middle);
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "whip")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query_skill("kurong-changong", 1) < 100)
    return notify_fail("慈航鞭法以枯荣禅功为根基,你不会枯荣禅功,无法修练慈航鞭。\n");
  if ((int)me->query("jingli") < 50)
    return notify_fail("你的体力不够练慈航鞭法。\n");
  if ((int)me->query("neili") < 30)
    return notify_fail("你的内力不够练慈航鞭法。\n");
  me->receive_damage("jingli", 30);
  return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  object weap, weap1;
  string name;
  int i;
  name = body_name[random(sizeof(body_name))];
  i = victim->query_skill("whip") / 10 + 1;
  weap = victim->query_temp("weapon");
  weap1 = me->query_temp("weapon");
  if (!(me->query_skill("cihang-bian", 1) > 100 && me->query("neili") > 100))
    return 0;
  if (!(random(me->query_skill("parry", 1)) > victim->query_skill("parry", 1) / 2 && random(6) > 2))
    return 0;
  if (victim->query_temp("weapon") && random(10) > 6) {
    message_vision(
      HIY "只见$N急速挥舞" + weap1->name() + "，转出无数个大小圈子，以阴柔之劲缠住对方的" + weap->name() + "！\n" NOR,
      me
    );
    victim->start_busy(2);
    if (random(me->query_skill("parry", 1)) > victim->query_skill("parry", 1) / 2) {
      message_vision(
        HIY "$N气运手臂用力一拽，" + weap->name() + "却无法从" + weap1->name() + "的缠绕中脱开，情急之下只好放弃了手中的兵刃。\n" NOR,
        victim
      );
      weap->move(environment(me));
      victim->reset_action();
    } else
      message_vision(
        HIY "$N暗运巧劲，" + weap->name() + "顺着方向快速旋转数下，解开了" + weap1->name() + "的缠绕。\n" NOR,
        victim
      );
    return 0;
  }
  victim->start_busy(1);
  me->add("neili", -50);
  victim->receive_damage("qi", me->query_skill("kurong-changong", 1) / 3 + damage_bonus / 6);
  victim->receive_wound("qi", me->query_skill("kurong-changong", 1) / 8 + damage_bonus / 8);
  message_vision(
    HIY "只见$N的鞭式灵动异常," + weap1->name() + "转出无数个大小圈子，以阴柔之劲缠住了对方的" + name + "！\n" NOR,
    me
  );
  message_vision(HIR "$N身形一缓,似乎受了点伤。\n" NOR, victim);
  return 0;
}

string perform_action_file(string action) {
  return __DIR__ "cihang-bian/" + action;
}
