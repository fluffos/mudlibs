#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *msg= ({
        "$N一式「蜈蚣盘步」，右手虚晃，左手化爪，连晃几下，突然向$n的背后二穴抓去",
        "$N侧身一晃，十指飞舞，挟带一股从指尖冒出的阴气向$n的$l连连插去",
        "$N一式「毒蚣盘身」，右手爪指交错，手臂一挥，出手就扣向$n的咽喉要害",
        "$N错步飘出，迷幻$n，接着右手斜斜探出，阴狠的抓向$n的$l",
        "$N一式「蜈蚣摆尾」，十指伸缩，泛起森森蓝光，虚虚实实地袭向$n的全身要穴",
        "$N面显阴笑，腾身飞出，十指若隐若现，若有若无，急急地抓向$n的$l",
        BLU"$N惨笑一声，人如中风发狂一般，双臂连连舞动，卷起满天爪影直袭$n的$l"NOR,
});

int valid_enable(string usage) { return usage=="claw" || usage=="parry"; }
int valid_combine(string combo)  
{
         object me = this_player();
         mapping myfam = (mapping)me->query("family");
        if ((int)me->query_str() > 27 && myfam && myfam["master_name"] == "丁春秋")
                 return combo=="chousui-zhang";
}
mapping query_action(object me, object weapon) {
        return (["damage_type":random(2)?"内伤":"瘀伤","action":msg[random(sizeof(msg))] ])
                + query_my_power(me,(int)me->query_skill("sanyin-zhua",1),at_type_hand,attack_lvl_middle,defense_lvl_middle);
}

int practice_skill(object me)
{
        if ((int)me->query("jingli") < 40)
                return notify_fail("你的体力太低了。\n");
        if ((int)me->query("neili") < 20)
        return notify_fail("你的内力不够，无法练三阴蜈蚣爪。\n");
        me->receive_damage("jingli", 30);
        me->add("neili", -10);
        return 1;
}
int valid_learn(object me)
{
        if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
        return notify_fail("空了手才能练三阴蜈蚣爪。\n");
        if ((int)me->query_skill("huagong-dafa", 1) < 100)
        return notify_fail("你还是先练好化功大法吧。\n");
        if ((int)me->query("max_neili") < 1000)
        return notify_fail("你内力修行太差, 练不了三阴蜈蚣爪。\n");
        return 1;
}
mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{                
        if(random(me->query_skill("huagong-dafa", 1)) > 50 &&
            me->query_skill("poison", 1) > 50 && 
            me->query_skill("poison", 1)+20 > victim->query_skill("poison", 1)) {                
            victim->apply_condition("xx_poison", random(2) + 
                    (me->query_skill("poison", 1)+20 - victim->query_skill("poison", 1))/20 +
                    victim->query_condition("xx_poison"));
    

    }
}
