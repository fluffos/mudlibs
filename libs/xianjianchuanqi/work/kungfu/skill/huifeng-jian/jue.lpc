#include <ansi.h>

inherit F_SSERVER;

int perform(object me, object target) {
  int lvl;
  object weapon;
  weapon = me->query_temp("weapon");
  lvl = ((int)me->query_skill("huifeng-jian", 1) + (int)me->query_skill("sword", 1)) / 6;
  if (!target) target = offensive_target(me);

  if (!target || !me->is_fighting(target))
    return notify_fail("「绝剑」只能在战斗中对对手使用。\n");

  if (!weapon || weapon->query("skill_type") != "sword"
    || me->query_skill_mapped("sword") != "huifeng-jian")
    return notify_fail("你手里没有剑，无法使用「绝剑」！\n");

  if ((int)me->query_skill("sword", 1) < 100)
    return notify_fail("你的基本剑法等级不够，不能使用「绝剑」！\n");

  if ((int)me->query_skill("linji-zhuang", 1) < 100)
    return notify_fail("你的临济十二庄等级不够，不能使用「绝剑」！\n");
  if ((int)me->query("max_neili") < 200)
    return notify_fail("你的内力太弱，不能使用「绝剑」！\n");

  if ((int)me->query("neili") < 100)
    return notify_fail("你的内力太少了，无法使用出「绝剑」！\n");

  message_vision(HIY "\n$N身法忽然变的十分诡异，刷刷刷向$n连攻六剑，正是回风拂柳剑绝技「绝剑」！\n\n" NOR, me, target);
  me->add("neili", -150);
  me->add("jingli", -50);
  me->add_temp("apply/damage", lvl);
  me->add_temp("apply/attack", lvl);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  me->add_temp("apply/damage", -lvl);
  me->add_temp("apply/attack", -lvl);
  me->start_busy(2);
  return 1;
}
