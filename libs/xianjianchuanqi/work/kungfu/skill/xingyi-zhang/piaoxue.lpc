// by skydream
// if it have some bug , pls fixed it ,thank
#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target) {
  int j;
  j = ((int)me->query_skill(
    "strike",
    1
  ) + (int)me->query_skill("xingyi-zhang", 1) + me->query_skill("shenyuan-gong", 1)) / 3;
  if (!target) target = offensive_target(me);

  if (!target || !me->is_fighting(target) || !living(target))
    return notify_fail("「飘雪流霜」只能在战斗中对对手使用。\n");
  if (objectp(me->query_temp("weapon")))
    return notify_fail("你必须空手才能使用「飘雪流霜」！\n");
  if ((int)me->query_skill("xingyi-zhang", 1) < 110)
    return notify_fail("你的星移掌还不够娴熟，使不出「飘雪流霜」绝技。\n");
  if ((int)me->query_skill("shenyuan-gong", 1) < 110)
    return notify_fail("你的神元功等级还不够，使不出「飘雪流霜」绝技。\n");
  if (me->query_skill_mapped("force") != "shenyuan-gong")
    return notify_fail("你所使用的内功不对。\n");
  if ((int)me->query_skill("force") < 110)
    return notify_fail("你的内功等级不够，不能使用「飘雪流霜」。\n");
  if (me->query_skill_prepared("strike") != "xingyi-zhang"
    || me->query_skill_mapped("strike") != "xingyi-zhang"
    || me->query_skill_mapped("parry") != "xingyi-zhang")
    return notify_fail("你现在无法使用「飘雪流霜」！\n");

  if ((int)me->query("max_neili") < 1100)
    return notify_fail("你现在内力太弱，使不出「飘雪流霜」。\n");
  if ((int)me->query("neili") < 500)
    return notify_fail("你现在真气太弱，使不出「飘雪流霜」。\n");

  message_vision(
    HIW "\n$N突然大喝一声“飘雪”，随即星移掌舞的更加密不透风，一个个掌影来来去去，宛如漫天飞雪随风飘动，$n呆立当场，不只如何来防。\n" NOR,
    me,
    target
  );
  me->add_temp("apply/strike", j);
  me->add_temp("apply/damage", j);
  me->add_temp("apply/attack", j);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  message_vision(
    HIW "\n$N见$n呆楞模样，又一声爆喝「流霜」，掌变拳，漫天的飞雪瞬时不见，全化做这一拳，恰似寒霜坠地，发而不收，攻而不守。 \n" NOR,
    me,
    target
  );
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  me->add_temp("apply/strike", -j);
  me->add_temp("apply/damage", -j);
  me->add_temp("apply/attack", -j);
  me->add("neili", -300);
  me->add("jingli", -50);
  me->start_busy(4);
  target->start_busy(2 + random(4));
  return 1;
}
