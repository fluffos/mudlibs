// dalv-tui.c 大驴飞腿

#include <ansi.h>

inherit FORCE;

mapping *action = ({
([      "action": "$N忽而转身，前腿撑地，尾巴杨起，只见双腿向$n的$l踢出",
        "dodge": 10,
        "force": 200,
        "lvl" : 0,
        "damage_type": "瘀伤"
]),
([      "action": "$N四蹄在地上一撑，身子忽地拔起，一跃三尺，落在$n的身后，尾巴向$p直劈而下",
        "weapon" : "蹄边",
        "dodge": 15,
        "force": 230,
        "damage" : 20,
        "lvl" : 0,
        "damage_type": "割伤"
]),
([      "action": "$N突然尾巴在自己左后腿一绑，只见左后腿随着尾巴在自己肾上狠踢一脚，右后腿踢出，中途方向必变，实不知将打何处",
        "dodge": 5,
        "force": 350,
        "lvl" : 20,
        "damage_type": "瘀伤"
]),
([      "action": "突然之间，$N俯身疾攻，四踢不动，微微侧身，一屁股往$n$l坐去",
        "weapon" : "屁股",
        "dodge": 10,
        "force": 290,
        "damage" : 40,
        "lvl" : 50,
        "damage_type": "刺伤"
]),
([      "action": "$N倒转身子，四蹄站在一条水平线上，口中阿阿阿的叫了三声，尾巴向$n旋转飞出！激得灰泥弥漫，尘土飞扬",
        "dodge": 5,
        "force": 380,
        "lvl" : 80,
        "damage_type": "瘀伤"
]),
([      "action": "$N闭眼逼住呼吸，过了片刻，突然转身，紧闭口鼻，屁股向$n的方向放出一股香气",
        "dodge": 1,
        "force": 350,
        "lvl" : 110,
        "damage_type": "瘀伤"
]),
([      "action": "$N丝毫不动声色，后腿微曲，前腿跃起，仰天长萧，前蹄象风一般踩向$n",
        "dodge": 10,
        "force": 330,
        "lvl" : 140,
        "damage_type": "瘀伤"
]),
([  "action": "$N默念口诀运气经脉，只听两声阿,阿长萧，当下一个翻身跃起，尾巴着地，四蹄对着$n踢出",
        "dodge": 0,
        "force": 450,
        "lvl" : 170,
        "damage_type": "内伤"
]),
([  "action": "但见$N后腿微曲，前腿抬起，然后以$n为中心，飞速旋转，尾巴如千万条彩虹飞扫而出",
        "dodge": 5,
        "force": 440,
        "lvl" : 199,
        "damage_type": "瘀伤"
]),
});

int valid_enable(string usage) 
{ return usage == "force" || usage=="strike" || usage =="parry"; }

string query_skill_name(int level)
{
        int i = sizeof(action);

        while (i--)
                if(level > action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me)
{
        int i, level;
        
        level   = (int) me->query_skill("dalv-tui",1);
        if (random(me->query_str()) > 35 && 
            random(level) > 120 &&
            me->query("max_neili") > 3000 &&
            me->query("neili") > 1300 ) {
                me->add("neili", -50);
                return ([
                "action": HIC "$N突然跌倒，忽然尾巴旋转,如同直升飞机，飞到半空，千百条踢影$n猛然踢出" NOR,
                "dodge" : 10,
                "force": 750,
                "damage_type": "瘀伤"]);
        }
        
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];
}

int valid_learn(object me)
{
        return notify_fail("蛤蟆功不是随便什么地方都可以练习的。\n");
}

int practice_skill(object me)
{
      return notify_fail("蛤蟆功不是随便什么地方都可以练习的。\n");
}


string exert_function_file(string func)
{
       return __DIR__"dalv-tui/" + func;
}

string perform_action_file(string action)
{
        return __DIR__"dalv-tui/" + action;
}
