int valid_enable(string usage) {
  object me;
  me = this_player();

  if ((int)me->query_skill("liumai-shenjian", 1) >= 100) {
    return usage == "finger" || usage == "parry";
  } else {
    message_vision("你的六脉神剑火候不够，无法激发。\n", me);
    return 0;
  }

}

int valid_learn(object me) {

  if ((int)me->query_skill("yiyang-zhi", 1) < 120)
    return notify_fail("你的一阳指火候不够，无法学六脉神剑。\n");
  if ((int)me->query("max_neili") < 3000)
    return notify_fail("你的内力太弱，无法学六脉神剑。\n");
  if ((int)me->query_skill("liumai-shenjian", 1) < 40)
    return notify_fail("你必须从六脉神剑经上学习六脉神剑的运气法门。\n");
  if ((int)me->query_skill("liumai-shenjian", 1) < 100)
    return notify_fail("你必须从六脉神剑经上研习六脉神剑的六路剑法。\n");
  return 1;
}

mapping query_action(object me, object weapon) {
  string s_msg, a_msg;
  int lvl_temp, level, neili;
  s_msg = msg0[random(sizeof(msg0))];
  level = (int)me->query_skill("liumai-shenjian", 1);
  neili = me->query("max_neili");
  /*if( random(level) > level - level/4 ){
            a_msg=select_color() + a_msg + NOR;
                        }*/
  lvl_temp = random((int)me->query_skill("liumai-shenjian", 1));
  if (lvl_temp > 200 && level > 250 && me->query("6mai_power") > 3 && me->query("neili") > 4500)
    return ([
      "damage_type": "刺伤",
      "action": s_msg,
      "weapon": "破体无形剑气"
    ]) + query_my_power(me, level, at_type_hand, attack_lvl_superhigh, defense_lvl_high);
  if (level > 250 && me->query("6mai_power") > 3 && me->query("neili") > 4500) {
    a_msg = (msg1 + msg2 + msg3 + msg4 + msg5 + msg6)[random(sizeof(msg1 + msg2 + msg3 + msg4 + msg5 + msg6))];
    return ([
      "damage_type": "刺伤",
      "action": s_msg,
      "weapon": "无形剑气"
    ]) + query_my_power(me, level, at_type_hand, attack_lvl_superhigh, defense_lvl_middle);
  }
  if (level > 220 && me->query("6mai_power") > 2) {
    a_msg = (msg1 + msg2 + msg3 + msg4 + msg5)[random(sizeof(msg1 + msg2 + msg3 + msg4 + msg5))];
    return ([
      "damage_type": "刺伤",
      "action": a_msg,
      "weapon": "剑气"
    ]) + query_my_power(me, level, at_type_hand, attack_lvl_super, defense_lvl_high);
  }
  if (lvl_temp > 160 && me->query("6mai_power") > 1) {
    a_msg = (msg1 + msg2 + msg3 + msg4)[random(sizeof(msg1 + msg2 + msg3 + msg4))];
    return ([
      "damage_type": "刺伤",
      "action": a_msg,
      "weapon": "剑气"
    ]) + query_my_power(me, level, at_type_hand, attack_lvl_super, defense_lvl_middle);
  }
  if (me->query("6mai_power") > 0 && neili > 3000) {
    a_msg = (msg1 + msg2 + msg3)[random(sizeof(msg1 + msg2 + msg3))];
    return ([
      "damage_type": "刺伤",
      "action": a_msg,
      "weapon": "剑气"
    ]) + query_my_power(me, level, at_type_hand, attack_lvl_super, defense_lvl_middle);
  }
  if (level > 200 && neili > 3000) {
    a_msg = (msg1 + msg2)[random(sizeof(msg1 + msg2))];
    return ([
      "damage_type": "刺伤",
      "action": a_msg,
      "weapon": "指风"
    ]) + query_my_power(me, level, at_type_hand, attack_lvl_high, defense_lvl_middle);
  }
  a_msg = (msg1)[random(sizeof(msg1))];
  return ([
    "damage_type": "刺伤",
    "action": a_msg,
    "weapon": "手指"
  ]) + query_my_power(me, level, at_type_hand, attack_lvl_high, defense_lvl_middle);
}

int practice_skill(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练六脉神剑必须空手。\n");

  if ((int)me->query("max_neili") < 2000)
    return notify_fail("你的内力修为太差，不能使出无形剑气。\n");
  if ((int)me->query_skill("liumai-shenjian", 1) < 170)
    return notify_fail("你的一阳指火候不够，无法学六脉神剑。\n");
  //              if ((int)me->query_skill("liumai-shenjian", 1) < 40)
  //              return notify_fail("你必须先从六脉神剑经上学习六脉神剑的运气法门。\n");
  if ((int)me->query_skill("liumai-shenjian", 1) < 100)
    return notify_fail("你剑法尚未娴熟，必须从六脉神剑经上研习六脉神剑的六路剑法。\n");
  if ((int)me->query("jingli") < 160)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 130)
    return notify_fail("你的内力不够练六脉神剑。\n");
  me->receive_damage("jingli", 50);
  me->add("neili", -30);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "liumai-shenjian/" + action;
}
mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  int damage, i, lvl_temp;
  object weap;
  weap = victim->query_temp("weapon");
  lvl_temp = random((int)me->query_skill("liumai-shenjian", 1));
  if (lvl_temp > 100) {
    if ((me->query("neili") > 100)
      && (me->query_temp("marks/sword_add") != 1)) {
      i = (int)me->query_skill("liumai-shenjian", 1) / 2;
      me->add_temp("apply/attack", i);
      me->add_temp("apply/defense", i);
      me->add_temp("apply/dodge", i);
      me->add_temp("apply/damage", i);
      me->add("neili", -50);
      me->set_temp("marks/sword_add", 1);
      call_out("reset_temp", lvl_temp / 10, me);
      return 1;
    }


    if ((lvl_temp > 100) && (me->query("neili") > 300)
      && (victim->query_temp("weapon"))
      && (random(me->query_str()) > victim->query_str() / 5)) {
      if (random((int)weap->query("rigidity")) < 15) {
        message_vision(HIW "只听见「啪」地一声，$N手中的" + weap->name()
          + "已经断为两截！\n" NOR, victim);
        weap->move(environment(me));
        weap->set("name", "断掉的" + weap->query("name"));
        weap->set("value", 0);
        weap->set("weapon_prop", 0);
      } else {
        message_vision(HIW "只听见「当」地一声，$N手中的" + weap->name()
          + "被剑气震落到地上！\n" NOR, victim);
        weap->move(environment(me));
      }

      victim->reset_action();
      me->add("neili", -100);
      return 1;
    }
    if ((lvl_temp >= 160)
      && (me->query("neili") > 250)
    ) {
      damage = (int)me->query_skill("liumai-shenjian", 1);
      damage = damage / 2 + random(damage);
      victim->receive_damage("qi", (random(3) + 2) * damage);
      victim->receive_wound("qi", damage / 2);
      me->add("neili", -50);
      return 1;
    }


  }
}

int reset_temp(object me) {
  int i = (int)me->query_skill("liumai-shenjian", 1) / 2;
  me->add_temp("apply/attack", -i);
  me->add_temp("apply/defense", -i);
  me->add_temp("apply/dodge", -i);
  me->add_temp("apply/damage", -i);
  me->delete_temp("marks/sword_add");
  return 1;
}
