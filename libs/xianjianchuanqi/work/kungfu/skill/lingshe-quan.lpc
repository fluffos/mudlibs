// lingshe-shou.c 灵蛇拳
// modified by jrx 11.2000
// by jrx
#include <ansi.h>;
inherit SKILL;

mapping *action = ({
([      "action": HIM "$N左拳虚击，右拳由左拳下反转而上，迅捷无比的击向$n的$l"NOR,
    "dodge": 30,
    "force": 160,
//      "poison": 80,
    "damage_type": "内伤"
]),
([      "action": HIM "$N左脚侧踢，双拳弯弯曲曲，如灵蛇缠向$n的$l"NOR,
    "dodge": 80,
    "force": 260,
//      "poison": 60,
    "damage_type": "内伤"
]),
([      "action": HIM "$N全身无一处着力，左拳顺着$n的右手游动，刹那间挥向$n的$l" NOR,
    "dodge": 40,
    "force": 350,
//      "poison": 100,
    "damage_type": "内伤"
]),
([      "action": HIG "$N双手伫地，双脚如蛇口嘬食一般，连环踢向$n的$l" NOR,
    "dodge": 30,
    "force": 360,
//      "poison": 80
    "damage_type": "内伤"
]),
});

int valid_enable(string usage) { return usage=="cuff" ||  usage=="parry"; }   

int valid_combine(string combo) { return combo=="hamashengong"; }

mapping query_action(object me)
{
    if (random(me->query_skill("cuff",1)) > 160 &&
        me->query_skill("force",1) > 160 &&
        me->query("neili") > 300 ) {
             me->add("neili", -200);
             return ([
                  "action": HIR "$N倒立而起，双手矗地，以脚为拳，连接踢向$n的$l" NOR,
                  "force": 1300,
                  "damage_type": "内伤"]);
    }
    return action[random(sizeof(action))];
}

int valid_learn(object me)
{
    if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
       return notify_fail("练灵蛇拳必须空手。\n");
    if ((int)me->query_skill("hamashengong", 1) < 140)
       return notify_fail("你的蛤蟆功火候不够，无法练灵蛇拳。\n");
    if ((int)me->query_skill("poison", 1) < 120)
       return notify_fail("你的基本毒计修为不够，无法练灵蛇拳。\n");
    if ((int)me->query_skill("chanchu-bufa", 1) < 120)
       return notify_fail("你的蟾蜍步法修为不够，无法练灵蛇拳。\n");
    if ((int)me->query("max_neili") < 700)
       return notify_fail("你的内力太弱，强练灵蛇拳可是会被万毒反蚀的。");
    return 1;
}


int practice_skill(object me)
{
    if ((int)me->query("jingli") < 30)
        return notify_fail("你的体力太低了。\n");
    if ((int)me->query("neili") < 80)
        return notify_fail("你的内力不够练灵蛇拳。\n");
    if (me->query_skill("lingshe-quan", 1) < 50)
        me->add("jingli", -1);
    else
        me->add("jingli", -30);
         me->add("neili", -25);
    return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
    if( random(me->query_skill("poison",1)) > 3) {
   victim->apply_condition("bt_poison", random(10) + 5 +
      victim->query_condition("bt_poison"));
    }
}
string perform_action_file(string action)
{
    return __DIR__"lingshe-quan/" + action;
}


