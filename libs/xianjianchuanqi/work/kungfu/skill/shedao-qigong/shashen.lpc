#include <ansi.h>
#include <combat.h>

inherit F_DBASE;
inherit F_SSERVER;
int perform(object me, object target)

{       
            object weapon;
        string msg;
        int damage, p, staff, dodge, parry, attack, busy_time;
        weapon = me->query_temp("weapon");
        if(!target) target = offensive_target(me);
        if(!target || !target->is_character()
           || !me->is_fighting(target) || !living(target) )
                return notify_fail("「上天入地杀神一式」只能在战斗中使用。\n");
        if( (int)me->query_skill("force", 1) < 210 ||
            (int)me->query_skill("staff", 1) < 210 ||
            (int)me->query_str() < 40 ||
            (int)me->query_skill("hand", 1)< 210 ||
            (int)me->query_skill("parry", 1) < 210 ||
            (int)me->query_skill("dodge", 1) < 210)
                return notify_fail("你现在还用不了这么精深奥妙的绝技？\n");
        if(me->query_skill("shedao-qigong", 1) <210)
                return notify_fail("你的蛇岛奇功火候不足，还使不出「上天入地杀神一式」。\n");    
        if(me->query_skill("shenlong-bashi", 1) <210)
                return notify_fail("你的神龙八式火候不足，还使不出「上天入地杀神一式」。\n");    
        if(me->query_skill("shenlong-xinfa", 1) <210)
                return notify_fail("你的神龙心法火候不足，还使不出「上天入地杀神一式」。\n");             if(me->query_skill("huagu-mianzhang", 1) <210)
                return notify_fail("你的化骨绵掌火候不足，还使不出「上天入地杀神一式」。\n"); 
        if(me->query_skill("yixingbu", 1) <210)
                return notify_fail("你的意形步法火候不足，还使不出「上天入地杀神一式」。\n");  
        if (me->query_skill_mapped("force") != "shenlong-xinfa")
                return notify_fail("你所使用的内功不对。\n");

              
        if (me->query_skill_mapped("dodge") != "yixingbu")
                return notify_fail("你所使用的轻功不对。\n");
        if( (int)me->query("max_neili") < 1200 )
                return notify_fail("这么强的武技岂能是你这点儿内力修为就能用的！\n");
        
        if( (int)me->query("neili") < 1000 )
                return notify_fail("你的内力不够！\n");
          msg = HIC "\n$N长啸一声“上天入地杀神一式”！脚步陡然加快！身影也变的朦胧起来！。\n" NOR;
          if (random(me->query_skill("yixingbu")) > target->query_skill("dodge") / 10)
             {
                msg += HIR "$n被$N绕的头晕眼花，一时分不清方向！\n"NOR;  
                target->start_busy(7); 
                damage = (int)me->query_skill("shenlong-xinfa", 1);
                damage = damage + random(damage/2);
                target->receive_damage("qi", damage/10);
                target->receive_wound("qi", damage/10);               
                me->add("neili", -200);
               call_out("perform2", 6, me, target);    
                   }
         else {       
                me->start_busy(1);
                me->add("neili", -100);                
                msg += HIW"$p大惊之下连忙向旁边一跳，在危急之中闪了开去。\n"NOR;
              }
         message_vision(msg, me, target);
        return 1;
}

int perform2(object me, object target)
{
         string msg,msg1;
        int i;
        object weapon;

        if (!me || !target) return 0;
        if(!living(target)) 
          return notify_fail("对手已经不能再战斗了。\n");  

        if( (int)me->query("neili", 1) < 800 )
                return notify_fail("你待要再乘胜追击，突然发现自己已经无力出招了。\n");     
       
                i = (me->query_skill("shedao-qigong", 1)/10);      
        msg = HIW "$N半空中连翻跟头，猛的一掌击在地面上，趁着一股反弹之力飞身扑向$n。\n"NOR;
        msg1=YEL"$N落回地面，趁着$n慌乱之时，连接攻击。\n"NOR;
        me->add_temp("apply/attack", i); 
        me->add_temp("apply/dodge", i);
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_QUICK);
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_QUICK);
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_QUICK);
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_QUICK);
        message_vision(msg, me, target);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_QUICK);
        me->add("neili", -300);
        target->start_busy(2);
        me->add_temp("apply/attack", -i); 
        me->add_temp("apply/dodge", -i);
        message_vision(msg1, me,target);
        call_out("perform3", -10, me, target);  
        return 1;
}


int perform3(object me, object target)
{
        int skill, damage, p;
        string msg;
        skill = (int)me->query_skill("shedao-qigong", 1);                
        skill = skill/10;
       
        if(!living(target)) 
          return notify_fail("对手已经不能再战斗了。\n");

        if( (int)me->query("neili", 1) < 500 )
                return notify_fail("你待要再乘胜追击，突然发现自己已经无力出招了!\n");     

        msg = HIC "\n$N深深地吸一囗气，忽然仰天长啸，高声狂叫：不死神龙，唯我不败！余音未
落，几丝如针一般的劲气，刺象$n！\n"NOR;        
        if (random(me->query_skill("dodge")) > target->query_skill("dodge") / 2){                
                msg += HIR "$n呆立当场，未待闪躲，“哇”的一声，吐出一口鲜血，已然昏昏沉沉。\n" NOR;
                me->start_busy(4);
                target->start_busy(1);
                damage = skill;
                damage = damage + random(damage/2);
                target->receive_damage("qi", damage);
                target->receive_wound("qi", damage/2);      
              } 
        else {
                me->add("neili", -200);
                target->start_busy(1);
                msg += HIW"\n$p连忙一个跟头翻出圈外，却也被吓的浑身是汗！\n" NOR;
                target->add_temp("apply/parry", -150);
                }
        message_vision(msg, me, target);
        return 1;
}


