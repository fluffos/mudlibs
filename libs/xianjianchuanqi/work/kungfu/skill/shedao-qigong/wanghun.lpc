//yujiamu-quan.c Modify by jrx

#include <ansi.h>

inherit F_SSERVER;
#include "/kungfu/skill/eff_msg.h";
int perform(object me, object target)
{          
        string msg; 
object weapon;        int damage;
        int i,p;
        weapon = me->query_temp("weapon");
        i=(me->query_skill("shedao-qigong",5)/30);
damage = i*(int)me->query_skill("shedao-qigong", 3);
damage = random(damage)+me->query_temp("apply/damage",4)*10;
        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("「亡魂一击」只能对战斗中的对手使用。\n");
      if (!weapon || weapon->query("skill_type") != "staff"
       || me->query_skill_mapped("staff") != "shedao-qigong")
              return notify_fail("你手里没有杖，无法使用亡魂一击！\n");

         if( (int)me->query_skill("shedao-qigong",1) < 120)
                return notify_fail("你的蛇岛奇功必须要在第4层以上才能，使出「亡魂一击」。\n");

         if ( (int)me->query("neili") < damage/2)
                return notify_fail("你的内力不够，无法使出「亡魂一击」。\n");

        msg = YEL "你眼中冒出丝丝血丝,狠毒的盯住对方.不顾死活的用出了
                               「"HIM"亡魂一击"YEL"」
你身形忽的凭空升高数丈,然后头下脚上.以手中"+weapon->name()+YEL"重重的向对方天灵拍落
! \n";

        if( random(me->query("combat_exp")) > random(target->query("combat_exp")) ) {
                msg += HIC"$n对$N如此诡异的招数 感到赫然全然忘了抵抗.结果被$N手中"+weapon->name()+HIC"重重击上
！\n";
                               target->receive_damage("qi", damage);
                target->receive_wound("qi", damage/3);
                if( damage < 500 ) msg += HIM"$n喉头一甜，吐出一口淤血。\n"NOR;
                else if( damage < 1000 ) msg += HIR"$n被$N手中"+weapon->name()+HIC"击中要害,头晕目眩，不辩西东! \n"NOR;
                else msg += RED"$n被$N手中"+weapon->name()+HIC"穿透而过,摇摇晃晃,“哇”的一口鲜血狂喷而出！\n"NOR;
              p = target->query("qi")*100/target->query("max_qi");
              msg += "( $n"+eff_status_msg(p)+" )\n";
                message_vision(msg, me, target);
        } 
        else {
                msg += HIY"$n见$N使出如此不要命的招数.大感不妙.立即远远的跳了开去
。\n" NOR;
                message_vision(msg, me, target);
        }
        me->add("neili", damage/2);
        target->start_busy(1);
        return 1;
}

