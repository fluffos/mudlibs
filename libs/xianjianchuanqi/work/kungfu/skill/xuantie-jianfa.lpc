// 玄铁剑法 yun_control
#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string  *msg = ({
"$N当胸平平刺出一剑，实在是毫无任何变化，而却有轰轰之声，$n只觉一股大力由$w直逼周身",
"$N凌空跃起，身随剑起，借助下行之势向下猛劈一剑，将$n周身笼于剑气之下",
"$N轻叹一声，随手横劈一剑，缓缓指向$n，看似无丝毫变化，却尽得剑法精髓，当真平淡中蕴涵所有变化，无招胜有招",
"$N迅疾挑出一剑，但见剑势如虹，快似闪电，无可当锋！此剑之快，匪夷所思，无法分辨剑路去来",
"$N仰首长啸，令风云变幻，狂风遽起，旋及一剑平指，剑气弥漫于$n周身各处，$n只觉身处惊涛骇浪之中，惊怖中更觉$N剑力有如海潮一般，一波一浪阵阵涌来，绵延不绝，愈发愈强",
"$N祭起$w，左手捏成剑诀置于胸前，咄喝一声，正是剑法至尊的“御剑式”，空中满是剑影，宛若千道银链，只在$n身边游动",
"$N连出十余剑，一时迅疾如流星划空，一时凝重迟缓，招招无迹可寻，平淡至极又匪思至极，顺刺，逆击，横削，倒劈，无不是剑法的入门，当真返朴归真，却已不再存任何破绽",
HIB"$N脸色凝重虔诚，缓缓举起$w，突然跃起身剑合一，驭剑化为一道黑气向$n冲刺而去"NOR,
});

int valid_enable(string usage){ return usage == "sword" || usage == "parry";}

mapping query_action(object me, object weapon)
{
        int level;
        level = (int)me->query_skill("xuantie-jianfa",1);
        return (["damage_type":random(2)?"刺伤":"割伤","action":msg[random(sizeof(msg))] ])
                + query_my_power(me,level,at_type_weapon,attack_lvl_super,defense_lvl_middle);
}

int valid_learn(object me)
{
        return notify_fail("你只能通过领悟来提高玄铁剑法。\n");
}
string perform_action_file(string action)
{
        return __DIR__"xuantie-jianfa/" + action;
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        object weapon;
        string w_name;
        int skill;
        skill=(int)me->query_skill("xuantie-jianfa",1);
        weapon=me->query_temp("weapon");
        w_name=weapon->query("name");
        if ( skill < 120 ) return 0;
        if ( (int)me->query("jiali") < (int)me->query_con()/2 ) return 0;
        if( random(skill) > (int)victim->query_skill("force",1)/2 && random(6)>3 && (int)me->query("neili") > 0 ) {
                victim->start_busy(2);
                if ( (int)me->query("max_neili") < 5000 && (int)weapon->query("unique") < 1 && random(10)==9 )
                  {     weapon->unequip();
                        weapon->move(environment(me));
                        weapon->set("name", "断了的"+weapon->query("name"));
                        weapon->set("long", weapon->query("long")+"，可是已经折断了\n");
                        weapon->set("weapon_prop", 0);
                        me->reset_action();
                        return WHT"$N大喝一声，手中" + w_name + WHT"剑气大盛,颤动不停，可惜$N内功修为不够精纯，“啪”的一声"+w_name+WHT"\n在劲气激荡之下竟然折为两断!\n"NOR;
                }
                if ( (int)me->query("max_neili") > 5000 && skill > 220 && random(10) > 7 )
                        return WHT"$N手中" + w_name + WHT"随意挥出，但见剑气纵横,手中"+w_name+WHT"却寂然无声！\n"NOR; 
                return HIB"$N大喝一声，手中" + w_name + HIB"剑气大盛，颤动不停，龙吟之声不绝于耳！\n"NOR;
        }
}

