//by rockman 2001.2.16

#include <ansi.h>

inherit F_SSERVER;

int perform(object me, object target)
{
        int j;
        string msg;
        j = (int)me->query_skill("canhe-zhi", 1);
        if( !target ) target = offensive_target(me);

        if( !target || !me->is_fighting(target) || !living(target))
                return notify_fail("「斗转」绝技只能在战斗中对对手使用。\n");

        if( objectp(me->query_temp("weapon")) )
                return notify_fail("你必须空手才能使用「斗转」绝技！\n");

   if( (int)me->query_skill("canhe-zhi", 1) < 120)
                return notify_fail("你的参合指还不够娴熟，使不出「斗转」绝技。\n");

        if (me->query_skill_prepared("finger") != "canhe-zhi" || me->query_skill_mapped("finger") != "canhe-zhi" || me->query_skill_mapped("parry") != "canhe-zhi")
                return notify_fail("你现在无法使用「斗转」绝技！\n");

        if( (int)me->query("max_neili") < 1000)
                return notify_fail("你现在内力太弱，使不出「斗转」绝技。\n");   

        if( (int)me->query("neili") < 500 )
                return notify_fail("你现在真气太弱，使不出「斗转」绝技。\n");

      message_vision(HIW"\n$N突然爆喝一声：“「斗转」绝技！”，双指分点$n的身上十余处穴道。$n只觉得血气翻腾，“哇”的一声吐出一口鲜血！\n"NOR, me ,target);
        me->set_temp("chz_dz", 1);
        me->start_call_out( (: call_other, __FILE__, "remove_effect", me:), j/5);
        me->add_temp("apply/finger", j);
        me->add_temp("apply/damage", j);
        me->add_temp("apply/attack", j);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);

        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
        me->add_temp("apply/finger", -j);
        me->add_temp("apply/damage", -j);
        me->add_temp("apply/attack", -j);
        me->add("neili", -500);
        me->add("jingli", -100);
        me->start_busy(2);
        target->start_busy(1+random(1));
        return 1;
}

void remove_effect(object me)
{
        me->delete_temp("chz_dz");
        tell_object(me, HIC "你又可以使用「斗转绝技」了。\n"NOR);
}
