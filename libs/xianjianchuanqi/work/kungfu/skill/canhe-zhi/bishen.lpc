// 慕容空手终极「以彼之道，还施彼身」
// by rockman  perform bishen

#include <ansi.h>

inherit F_SSERVER;

#include "/kungfu/skill/eff_msg.h";

int perform(object me, object target)
{
        int damage, p;
        string msg, dodge_skill;

        if( !target ) target = offensive_target(me);
        if( !target || !target->is_character() || !me->is_fighting(target) || !living(target) )
                return notify_fail("「还施彼身」绝招只能对战斗中的对手使用。\n");

        if( (int)me->query_skill("canhe-zhi", 1) < 120 )
                return notify_fail("你的参合指还不够熟练，不能使用「还施彼身」绝招对敌！\n");

        if( me->query_temp("weapon") )
                return notify_fail("你必须空手才能使用「还施彼身」！\n");

        if (me->query_skill_mapped("force") != "shenyuan-gong")
                return notify_fail("你的内功中无此功夫。\n");

        if( (int)me->query("max_neili") < 1000 )
                return notify_fail("你现在内力不足，使不出「还施彼身」的绝招！\n");

        if( (int)me->query("neili") < 400 )
                return notify_fail("你现在内力不足，使不出「还施彼身」的绝招！\n");

        if( (int)me->query_skill("finger", 1) < 100 )
                return notify_fail("你的指法不够娴熟，使不出「还施彼身」的绝招！\n");
        if (me->query_str() < 30 )
                return notify_fail("你的力量太小，使不出用「还施彼身」！\n");

        msg = HIR "\n$N奋力跃起，左指飘然点出，使的正是$N生平最得意的「还施彼身」绝招，阴柔的指风直逼$n而去！\n"NOR;

        if (random(me->query_skill("force",1)) > target->query_skill("force",1) /8 ){
                me->start_busy(1);
                target->start_busy(1); 
                me->add("neili", -200);
                me->add("jingli", -20);
                damage = damage*2 + random(damage);
                damage = (int)me->query_skill("canhe-zhi", 1);                
                if(random(me->query("parry")) > target->query("parry")/4 ) damage += random(damage);
                target->receive_damage("qi", damage);
                target->receive_wound("qi", damage/2);
                p = (int)target->query("qi")*100/(int)target->query("max_qi");
                msg += damage_msg(damage, "内伤");
                msg += "( $n"+eff_status_msg(p)+" )\n";
                call_out("perform2", 0, me, target, p);   
                } 
        else {
                me->start_busy(2);
                target->start_busy(1);
                me->add("neili", -100);
                tell_object(target, RED"你但觉一股栩栩微风迎面而来，双手相叠一挥，就将这一股劲气轻松化解。\n" NOR);
                dodge_skill = target->query_skill_mapped("dodge");
                if( !dodge_skill ) dodge_skill = "dodge";
                msg += SKILL_D(dodge_skill)->query_dodge_msg(target, 1);
        }
        message_vision(msg, me, target); 
        return 1;
}
int perform2(object me, object target, int p)
{
        int damage;
        string msg, dodge_skill;

        if(!living(target)) 
          return notify_fail("对手已经不能再战斗了。\n");

        if( (int)me->query("neili", 1) < 500 )
                return notify_fail("你待要再发一指，怎奈自己内力不足，气息散乱，竟然连指头也抬不起来！\n");     

        msg = HIY "\n$N身在半空，左指劲力未消，右指也跟着猛力点出，功力相叠，指风象利箭一般刺向$n！\n"NOR;

        if (me->query_skill("canhe-zhi", 1) > 150 ){
                me->start_busy(1);
                target->start_busy(1);
                me->add("neili", -300);
                me->add("jingli", -30);                
                damage = (int)me->query_skill("canhe-zhi", 1)/2*3;                
                damage = damage*3 + random(damage)*2;
                if(me->query("parry") > target->query("parry")/3 ) damage += random(damage);
                target->receive_damage("qi", damage);
                target->receive_wound("qi", damage/2);
                p = (int)target->query("qi")*100/(int)target->query("max_qi");
                msg += damage_msg(damage, "内伤");
                msg += "( $n"+eff_status_msg(p)+" )\n";                
                call_out("perform3", 0, me, target, p);
        } 
        else {
                me->start_busy(4);
                me->add("neili", -200);
                tell_object(target, HIG"你又觉一股指风扑面而来，刚想再次化解，但觉得指风如利箭一般犀利，只得跃开数尺，狼狈地避开。\n" NOR);
                dodge_skill = target->query_skill_mapped("dodge");
                if( !dodge_skill ) dodge_skill = "dodge";
                msg += SKILL_D(dodge_skill)->query_dodge_msg(target, 1);
        }
        message_vision(msg, me, target); 
        return 1;
}
int perform3(object me, object target, int p)
{
        int damage;
        string msg, dodge_skill;

        if(!living(target))
              return notify_fail("对手已经不能再战斗了。\n");

        if( (int)me->query("neili", 1) < 1000 )
                return notify_fail("你待要再发一指，却发现自己的内力不够了！\n");

        msg = HIC "\n$N怒喝一声：「以彼之道，还施彼身！」，双臂骨节爆响，青筋爆突，运足全身力量，双指相并向$n猛力点出，$n连同周围方圆三丈全在「还施彼身」劲力笼罩之下！\n"NOR;

        if (me->query_skill("canhe-zhi", 1) > 180 ) {
                me->start_busy(2);
                target->start_busy(random(1));
                me->add("neili", -300);
                me->add("jingli", -40);                
                damage = (int)me->query_skill("canhe-zhi", 1)*2;         
                damage = damage*5 + random(damage)*2;
                if(me->query("parry") > target->query("parry")/2 ) damage += random(damage);
                target->receive_damage("qi", damage);
                target->receive_wound("qi", damage/2);
                p = (int)target->query("qi")*100/(int)target->query("max_qi");
                msg += damage_msg(damage, "内伤");
                msg += "( $n"+eff_status_msg(p)+" )\n";     
        } else {
                me->start_busy(4);
                target->start_busy(1);
                me->add("neili", -200);
                target->add("jingli", -100);
                tell_object(target, BLU"你只觉得汗毛乍立，虚汗溢出，浑身上下仿佛被刀割一般。情急之下向后一滚，挥起双手一挡，总算架开了这致命的一击！\n" NOR);
                dodge_skill = target->query_skill_mapped("dodge");
                if( !dodge_skill ) dodge_skill = "dodge";
                msg += SKILL_D(dodge_skill)->query_dodge_msg(target, 1);
        }
        message_vision(msg, me, target); 
        return 1;
}
