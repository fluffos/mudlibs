// huayn-qiangfa.c 【呼延枪法】
#include <power_control.h>
inherit SKILL;

string *msg = ({
  "$N使一招「迎门三不过」，手中$w连续刺向$n面门，哽嗓，前心",
  "$N运足精神，抖起$w，一招「拨草寻蛇」,$w枪尖乱颤，刺向$n$l",
  "$N一个跨步，使一招「高山流水」，手中$w势若流云飞瀑刺向$n的$l",
  "$N一按枪把，啪！地一声抖出五朵枪花。上下左右，虚虚实实刺向$n全身要害",
  "只见$N一个斜跨，使个「举火烧天势」，手中$w带出猛地抖出，由下而上疾挑$n$l",
  "只见$N手腕一翻，手中$w从意想不到的角度刺向$n的$l。\n这一招「灵蛇出洞」快若闪电，毒辣无比",

  "$N使个「飞鸟投林势」，身形斜飞，从侧面突出一枪，径刺$n$l",
  "$N似欲退走，可是忽地一个转身，枪尖斗起碗大的枪花，使出一招「回马枪」，$w一挺扎向$n$l",
});

int valid_learn(object me) {
  object ob;
  if ((int)me->query("neili") < 100)
    return notify_fail("你的内力不够，没有办法练呼延枪法。\n");
  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "spear")
    return notify_fail("你必须先找一柄枪,或棒才能练枪法。\n");

  return 1;
}

int valid_enable(string usage) {
  return ((usage == "spear") || (usage == "parry"));
}
mapping query_action(object me, object weapon) {
  int level;
  string a_msg;
  level = (int)me->query_skill("huyan-qiangfa", 1);
  a_msg = msg[random(sizeof(msg))];
  return ([
    "damage_type": "刺伤",
    "action": a_msg
  ]) + query_my_power(me, level, at_type_weapon, attack_lvl_normal, defense_lvl_middle);
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "spear")
    return notify_fail("你必须先找一柄长枪或者是类似的武器，才能练枪法。\n");

  if ((int)me->query("jingli") < 130
    || (int)me->query("neili") < 95)
    return notify_fail("你的体力不够练这门枪法，还是先休息休息吧。\n");
  me->receive_damage("jingli", 20);
  me->add("neili", -25);
  write("你按着所学练了一遍呼延枪法。\n");
  return 1;
}
