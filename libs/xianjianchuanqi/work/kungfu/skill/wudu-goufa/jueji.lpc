inherit F_SSERVER;
#include <ansi.h>
int perform(object me, object target) {
  string msg;
  if (!target) target = offensive_target(me);
  if (!target || !target->is_character()
    || !me->is_fighting(target) || !living(target))
    return notify_fail("「五毒追魂杀」只能在战斗中使用。\n");
  if (!objectp(me->query_temp("weapon")))
    return notify_fail("没有武器能使出五毒的绝技吗。\n");
  if ((int)me->query_skill("wudu-goufa", 1) < 150 ||
    (int)me->query_skill("hook", 1) < 150)
    return notify_fail("你的基本钩法还不够娴熟，不会使用「五毒三绝技」。\n");
  if (!me->query_skill("wudu-shengong", 1))
    if (me->query_skill("wudu-shengong", 1) < 150)
      return notify_fail("你的五毒神功还没练到家。\n");
  if (me->query_skill_mapped("force") != "wudu-shengong")
    return notify_fail("你所使用的内功不对。\n");
  if (me->query_skill_mapped("hook") != "wudu-goufa")
    return notify_fail("你现在无法使用「五毒三绝技」。");
  if (me->query_skill_mapped("parry") != "wudu-goufa")
    return notify_fail("你所使用的招架不对。\n");
  if ((int)me->query("max_neili") < 800)
    return notify_fail("你现在的内力修为不行！\n");
  if ((int)me->query("neili") < 600)
    return notify_fail("你的内力不够了！\n");
  msg = HIB "\n$N突然间满脸发黑，身法越来越快，有如一团毒气直向$n避近！\n" NOR;
  me->start_busy(1);
  target->start_busy(1);
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  if (random(me->query_skill("parry")) > target->query_skill("parry") / 3) {
    call_out("perform2", 0, me, target);
  } else {
    me->start_busy(1 + random(4));
    me->add("neili", -300);
    msg += HIB "$N还想再攻，可是$n识得厉害，纵身后跳，远远的躲了开去。\n" NOR;
    message_vision(msg, me, target);
    return 1;
  }
  me->add("neili", -300);
  return 1;
}
int perform2(object me, object target) {
  string msg;
  if (!me || !target) return 0;
  if (!living(target))
    return notify_fail("对手已经不能再战斗了。\n");
  if ((int)me->query("neili", 1) < 600)
    return notify_fail("你内力不够了！\n");
  msg = HIR "\n紧接着$N的脸突然由黑转红，又向$n的要害刺出连续两招。\n" NOR;
  me->add_temp("apply/damage", 50);
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 2);
  me->start_busy(1 + random(4));
  me->add("neili", -300);
  me->add_temp("apply/damage", -20);
  return 1;
}
