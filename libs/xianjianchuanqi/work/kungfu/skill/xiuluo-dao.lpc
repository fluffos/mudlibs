// xiuluo-dao.c 修罗刀
#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *msg = ({
"$N藏刀内收，一招「割肉饲鹰」，刀锋自下而上划了个半弧，向$n的$l挥去",
"$N左掌虚托右肘，一招「投身饿虎」，手中$w笔直划向$n的$l",
"$N一招「斫头谢天」，$w绕颈而过，刷地一声自上而下向$n猛劈",
"$N右手反执刀柄，一招「折骨出髓」，猛一挫身，$w直向$n的颈中斩去",
"$N一招「挑身千灯」，无数刀尖化作点点繁星，向$n的$l挑去",
"$N双手合执$w，一招「挖眼布施」，拧身急转，刀尖直刺向$n的双眼",
"$N一招「剥皮书经」，手中$w划出一个大平十字，向$n纵横劈去",
"$N反转刀尖对准自己，一招「剜心决志」，全身一个翻滚，$w向$n拦腰斩去",
"$N一招「烧身供佛」，$w的刀光仿佛化成一簇簇烈焰，将$n团团围绕",
"$N刀尖平指，一招「刺血满地」，一片片切骨刀气如飓风般裹向$n的全身",
});

int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

int valid_combine(string combo) { return combo=="damo-jian"; }

int valid_learn(object me)
{
        if ((int)me->query("max_neili") < 50)
                return notify_fail("你的内力不够。\n");
        if ((int)me->query_skill("yijin-jing", 1) < 10)
                return notify_fail("你的易筋经内功火候太浅。\n");
        return 1;
}

mapping query_action(object me)
{
        int level;
          string a_msg;
        level = (int)me->query_skill("xiuluo-dao",1);
         a_msg=msg[random(sizeof(msg))] ;
        if( random(level) > level - level/12  )
                a_msg=select_color() + a_msg + NOR;
        return (["damage_type":random(2)?"刺伤":"割伤","action":a_msg ])
                + query_my_power(me,level,at_type_weapon,attack_lvl_normal,defense_lvl_normal);
}


int practice_skill(object me)
{
        object weapon;
        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "blade")
                return notify_fail("你使用的武器不对。\n");
        if ((int)me->query("jingli") < 50)
                return notify_fail("你的体力不够练修罗刀。\n");
        me->receive_damage("jingli", 35);
        return 1;
}
