// huifeng-bian 回风鞭法
#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *msg = ({
"$N身形不动，一招「李广射石」，手中$w笔直如矢，对准$n的前胸刺去",
"$N身形连转，一招「长鲸吸水」，手中$w如长龙出水，将$n卷在重重鞭影当中。",
"$N身形拔起，力贯鞭梢，一招「灵燕穿云」，手中$w舞出一道长虹直取$n的$l",
"$N身形伏低，一招「哪吒探海」，手中$w抖出无数鞭影，对准$n的下身攻去",
"$N身形若被狂风吹送，飘然而至。一招「玉带围腰」，手中$w变出一个个圆圈，卷向$n的腰间。",
});
int valid_enable(string usage) { return (usage == "whip") || (usage == "parry"); }
int valid_learn(object me)
{
       object weapon;
       if( (int)me->query("max_neili") < 100 )
               return notify_fail("你的内力不足，没有办法练回风鞭法, 多练些内力再来吧。\n");
       if ((int)me->query_skill("huntian-qigong", 1) < 30)
               return notify_fail("你的混天气功火候太浅。\n");
       if ( !objectp(weapon = me->query_temp("weapon"))
       || ( string)weapon->query("skill_type") != "whip" )
               return notify_fail("你必须先找一条鞭子才能练鞭法。\n");
       return 1;
}
mapping query_action(object me, object weapon) {
        return (["damage_type":random(2)?"割伤":"瘀伤","action":msg[random(sizeof(msg))] ])
                + query_my_power(me,(int)me->query_skill("huifeng-bian",1),at_type_weapon,attack_lvl_normal,defense_lvl_normal);
}
int practice_skill(object me)
{
       object weapon;

       if (!objectp(weapon = me->query_temp("weapon"))
       || (string)weapon->query("skill_type") != "whip")
               return notify_fail("你使用的武器不对。\n");
       if ((int)me->query_skill("huntian-qigong", 1) < 30)
               return notify_fail("你的混天气功火候太浅。\n");
       if ((int)me->query("jingli") < 50)
               return notify_fail("你的体力不够练回风鞭法。\n");
       me->receive_damage("jingli", 30);
       return 1;
}

