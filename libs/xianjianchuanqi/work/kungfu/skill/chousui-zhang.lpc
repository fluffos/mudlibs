// chousui-zhang.c, 抽髓掌
#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *msg = ({
  HIG "$N催动内力，衣袖挥动，双掌挟着一股腥臭之气一前一后拍向$n的$l" NOR,
  "$N双脚一曲一弯，身体旋转起来, 突然间双掌飞舞着拍向$n的$l",
  "$N身形飘动，围着$n一圈圈游走，同时双掌连拍，激起阵阵劲风吹向$n",
  "$N突然厉声大喝，跃于半空，立掌如斧，上上下下向$n连连劈出数掌",
  "$N身形微晁抢前一步，运起十成功力，大喝一声，须发戟张，呼的一掌又向$n推去",
  "$N面露诡异的笑容，猛地向前冲出，对准$n的$l就是一招阴毒无比的「抽髓掌」",
  "$N心念一转，计上心来，一招「三阴蜈蚣爪」，招招连环，连珠般抓向$n的$l",
});

int valid_enable(string usage) { return usage == "strike" || usage == "parry"; }
int valid_combine(string combo) {
  object me = this_player();
  mapping myfam = (mapping)me->query("family");
  if ((int)me->query_str() > 27 && myfam && myfam["master_name"] == "丁春秋")
    return combo == "sanyin-zhua";
}
int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("空了手才能练抽髓掌。\n");
  if ((int)me->query_skill("huagong-dafa", 1) < 10)
    return notify_fail("你还是先练好化功大法吧。\n");
  if ((int)me->query("max_neili") < 100)
    return notify_fail("你内力修行太差, 练不了抽髓掌。\n");
  return 1;
}
mapping query_action(object me, object weapon) {
  return ([
    "damage_type": random(2) ? "内伤" : "瘀伤",
    "action": msg[random(sizeof(msg))]
  ]) + query_my_power(
    me,
    (int)me->query_skill("chousui-zhang", 1),
    at_type_hand,
    attack_lvl_normal,
    defense_lvl_normal
  );
}

int practice_skill(object me) {
  if (!me->query_skill("huagong-dafa", 1))
    return notify_fail("练抽髓掌需要有化功大法的支持。\n");
  if ((int)me->query("jingli") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 40)
    return notify_fail("你的内力不够练抽髓掌。\n");
  me->receive_damage("jingli", 30);
  me->add("neili", -10);
  return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  if (random(me->query_skill("huagong-dafa", 1)) > 30 &&
    me->query_skill("poison", 1) > 50 &&
    me->query_skill("poison", 1) + 20 > victim->query_skill("poison", 1)) {
    victim->apply_condition("xx_poison", random(2) +
      (me->query_skill("poison", 1) + 20 - victim->query_skill("poison", 1)) / 20 +
      victim->query_condition("xx_poison"));
  }
}

string perform_action_file(string action) {
  return __DIR__ "chousui-zhang/" + action;
}
