// yinsuo-jinling.c 银索金铃 古墓武功
#include <ansi.h>
#include <power_control.h> 
inherit SKILL;
string *xue_name = ({ "劳宫穴","膻中穴","曲池穴","关元穴","曲骨穴","中极穴","承浆穴","天突穴","百会穴",
"幽门穴","章门穴","大横穴","紫宫穴","冷渊穴","天井穴","极泉穴","清灵穴","至阳穴","迎香穴","灵道穴","承泣穴","人中穴","曲泽穴","强间穴","风府穴","灵台穴","悬枢穴",
});
string *d_type = ({ "内伤","拉伤","割伤","瘀伤",});
string  *a_msg = ({
"$w破空而响,如点点繁星滑过天际,连连击向$n的$x",
"只听得$w破空而响,去势甚急,直奔$n的$x",
"突然黄光一闪，$N一声轻啸，$w向$n的胸口要害打去",
"$N身影婆娑，双手交叉于胸前，旋即突然甩开，$w从$N袖底挥出，从左右分射$n的$x",
"$N反手一扬，手中的$w如雨点般打向$n",
"$N信手一挥，动作虽慢，但恰好落在$n招式用老之后，$w如沾身细雨，$n竟无处躲避",
"$N双手不断飞舞，手中的$w上下翻飞，接连不短的射向$n",
"$N嘴角轻笑，$w从$N袖底挥出，疾点$n的$x",
"$N手腕一抖，$w如长蛇穿空，疾点$n的$x",
"$N嫣然一笑，眼角却暗含杀机，$w从各个方向不断飞出，有如神出鬼没!",
});

int valid_enable(string usage) {return usage == "whip" || usage == "parry";}
mapping query_action(object me, object weapon)
{
        int level;
        string new_msg=a_msg[random(sizeof(a_msg))];
        new_msg=replace_string(new_msg,"$x",select_color()+xue_name[random(sizeof(xue_name))]+NOR );
        level = (int)me->query_skill("yinsuo-jinling",1);
        return (["damage_type":d_type[random(sizeof(d_type))],"action":new_msg ])
                + query_my_power(me,level,at_type_weapon,attack_lvl_middle,defense_lvl_normal);
}

int practice_skill(object me)
{
        object weapon;
        if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "whip")
                return notify_fail("你使用的武器不对。\n");
        if ((int)me->query("jingli") < 35 || (int)me->query("neili") < 10)
                return notify_fail("你的体力不够练银索金铃。\n");
        me->add("jingli", -30);
        me->add("neili", -20);
        return 1;}
int valid_learn(object me)
{
        if ((int)me->query("max_neili") <1200)
                return notify_fail("你的内力不够。\n");
        if ((int)me->query_skill("yunu-xinjing", 1) < 120)
                return notify_fail("你的玉女心经功力不够。\n");
        return 1;}

mixed hit_ob(object me, object victim, int damage_bonus)
{
        string msg,name;
        int j,damage;
        object weapon, weapon1;
        name = xue_name[random(sizeof(xue_name))];
        weapon = me->query_temp("weapon");
        weapon1 = victim->query_temp("weapon");
        j = (int)me->query_skill("yinsuo-jinling", 1);
        if(j < 120 || me->query("max_neili") < 1500 ) return 0;
        if (random(j)>(int)victim->query_skill("dodge",1)/2 && random(6)>3 && (int)me->query("neili") > 50 ) {
                me->add("neili", -random(30));
                if(weapon->query("id")=="yinsi suo" && random(10) > 7) {
                switch(random(2)) {
                        case 0 :
                                message_vision( HIY"$N右手的"+weapon->name()+HIY"疾翻，缠住"+weapon1->name()+HIY"的把柄，运起“带”字诀，顺势向外带! \n"NOR,me, victim);
                                message_vision( HIY"$N左手却一拉银索，使起“撞”字诀，金铃在"+weapon1->name()+HIY"上一弹，反而借着$n的力气，弹向$n的"RED+name+HIY"! \n"NOR,me, victim);
                                message_vision( HIR"$n只感觉"RED+name+HIR"一麻，手上力气尽失，一个把握不住，手中兵器飞了出去。\n"NOR,me, victim);
                                weapon1->unequip();
                                weapon1->move(environment(victim));
                                break;
                        case 1 :
                                message_vision( WHT"$N使个“缠”字诀,"+weapon->name()+WHT"紧紧缠住"+weapon1->name()+WHT"，"+weapon1->name()+WHT"打到哪儿，"+weapon->name()+WHT"随到哪儿，如影随形，借力制敌，银索顶端的金球却异常灵活，不受限制。\n"NOR,me, victim);
                                victim->start_busy(2);
                                break;}
                        return 0;}

                switch(random(4)) {
                        case 0 :
                                message_vision(WHT"$N"+weapon->name()+WHT"挥出，以“缠”字诀着地扫去，如一条白蛇,蜿蜒不断。\n"NOR,me, victim);
                                victim->start_busy(2);
                                if (!random(2))
                                        message_vision(HIR"$n纵身稍慢，被"+weapon->name()+HIR"在左胫上一缠，右踝上一绕，扑地倒了。\n"NOR,me, victim);
                                else

                                        message_vision(HIR"$n尚未落地，被"+weapon->name()+HIR"又是一缠一绕，$n立足不住，仰天一交摔倒。\n"NOR,me, victim);
                                break;
                        case 1 :
                                message_vision(HIB"$N使出“点”字诀，挥舞起手中"+weapon->name()+HIB"，如狂蛇一般上下翻飞！\n"NOR,me, victim);
                                damage = damage_bonus/4 ;
                                victim->receive_damage("qi",damage);
                                victim->receive_wound("qi", damage);
                                break;
                        case 2 :
                                message_vision( HIY"$N使出“弹”字诀，左手"+weapon->name()+HIY"抖然弹出，直点$n的"RED+name+HIY"！\n"NOR,me, victim);
                                damage = damage_bonus/6;
                                victim->receive_damage("qi",damage);
                                victim->receive_wound("qi", damage);
                                victim->receive_damage("jing",damage/2);
                                victim->receive_wound("jing",damage/3);
                                break;
                        case 3 :
                                message_vision( WHT"$N手法再变，使出了“转”字诀。但见"+weapon->name()+WHT"化成了一团白影，\n"NOR,me, victim);
                                message_vision( WHT"$n前前后后各大要穴被照了个严严实实。\n"NOR,me, victim);
                                victim->receive_damage("qi",j/2);
                                victim->receive_wound("qi",j/2);
                                message_vision(HIR"结果$n被"+weapon->name()+HIW"点中"RED+name+HIR"!\n" NOR,me, victim);
                                break;}
                        }
}
string perform_action_file(string action)
{
        return __DIR__"yinsuo-jinling/" + action;
}

