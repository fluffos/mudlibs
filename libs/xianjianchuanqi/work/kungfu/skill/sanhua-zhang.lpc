// sanhua-zhang.c -散花掌
#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *msg = ({
  "$N合掌抱球，一式「" HIG "春深芳草尽" NOR "」，双掌变幻吞吐，缓缓推向$n的$l",
  "$N五指绽开，一式「" HIG "夏闲独兰馨" NOR "」，左右掌穿插翻飞，疾向$n的$l拍去",
  "$N使一式「" HIY "秋酣菊霜清" NOR "」，左掌虚托，右掌乍伸乍合，猛地插往$n的$l",
  "$N双掌血红，一式「" HIW "冬卧听梅吟" NOR "」，幻成漫天梅花朵朵，雨点般向$n击去",
});

int valid_enable(string usage) { return usage == "strike" || usage == "parry"; }

int valid_combine(string combo) {
  return combo == "mohe-zhi" || combo == "fengyun-shou" || combo == "jimie-zhua" || combo == "shaolin-tantui" || combo == "luohan-quan" || combo == "nianhua-zhi" || combo == "qianye-shou" || combo == "yizhi-chan" || combo == "longzhua-gong" || combo == "jingang-quan" || combo == "ruying-suixingtui";
}

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练散花掌必须空手。\n");
  if ((int)me->query_skill("yijin-jing", 1) < 20)
    return notify_fail("你的易筋经内功火候不够，无法学散花掌。\n");
  if ((int)me->query("max_neili") < 100)
    return notify_fail("你的内力太弱，无法练散花掌。\n");
  return 1;
}
mapping query_action(object me) {
  int level;
  string a_msg;
  level = (int)me->query_skill("sanhua-zhang", 1);
  a_msg = msg[random(sizeof(msg))];
  return ([
    "damage_type": random(2) ? "内伤" : "瘀伤",
    "action": a_msg
  ]) + query_my_power(me, level, at_type_hand, attack_lvl_normal, defense_lvl_normal);
}

int practice_skill(object me) {
  if ((int)me->query("jingli") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练散花掌。\n");
  me->receive_damage("jingli", 30);
  me->add("neili", -10);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "sanhua-zhang/" + action;
}
