#include <ansi.h>

inherit F_SSERVER;

int exert(object me, object target) {
  int sp, dp;

  if (target == me)
    target = offensive_target(me);

  if (environment(me)->query("no_fight"))
    return notify_fail("你不能在禁止战斗的地方使用内功的这个功能!\n");

  if (!objectp(target) || target->query("id") == "mu ren")
    return notify_fail("你要攻击谁？\n");

  if ((int)me->query_skill("yunu-xinjing", 1) < 50)
    return notify_fail("你的玉女心经功力不够，不能凝神攻击对方！\n");
  if ((int)me->query_skill("yunu-xinfa", 1) < 100)
    return notify_fail("你的玉女心法修为不足,不能使用内功.\n");

  if ((int)me->query("neili") < 100)
    return notify_fail("你的内力不够。\n");

  message_vision(
    HIW "$N风情万种,妖媚动人的对" + target->name() + "" HIW "嫣然一笑！\n" NOR, me);
  if (target->query("class") != "男性") {
    if (me->query_per() < target->query_per()) {
      if (living(target))
        if (!target->is_killing(me))
          target->kill_ob(me);
      tell_object(target, HIY "你完全不能忍受" + me->name() + "的妖媚,你只觉怒火攻心,要杀死" + me->name() + ".\n" NOR);
      tell_object(me, HIY "你看到" + target->name() + "怒火中烧,对你恨之入骨的扑来.\n" NOR);
      me->add("neili", -100);
      me->start_busy(random(3));
    } else {
      tell_object(target, HIY "你被" + me->name() + "的美貌所迷,呆呆的看着她,心里在想:“为什么我妈妈没把我生的这么美。”\n" NOR);
      tell_object(me, HIY "你看到" + target->name() + "被你的美貌所迷,正在呆呆的看着你出神。\n" NOR);
      target->receive_damage(
        "jing",
        me->query_per() / 2 + random((int)me->query_skill(
          "yunu-xinjing",
          1
        ) / 2 + (int)me->query_skill("yunu-xinfa", 1) / 2)
      );
      if (target->query("combat_exp") >= me->query("combat_exp"))
        if ((int)me->query("potential") - (int)me->query("learned_points") < 100)
          me->add("potential", 1);
      me->start_busy(2);
      target->start_busy(random(3));
      me->add("neili", -100);
    }
  } else {
    if (me->query_per() < target->query_per()) {
      if (living(target))
        if (!target->is_killing(me))
          target->kill_ob(me);
      tell_object(target, HIY "你看到" + me->name() + "的相貌差一点儿没吐出来.\n" NOR);
      tell_object(me, HIY "你" + target->name() + "对你怒目而视，眼睛里象是要冒出火来。\n" NOR);
      me->add("neili", -100);
      me->start_busy(random(3));
    } else {
      tell_object(target, HIY "你被" + me->name() + "的美貌所迷,呆呆的看着她,看的发了痴\n" NOR);
      tell_object(me, HIY "你看到" + target->name() + "被你的美貌所迷,正在呆呆的看着你出神。\n" NOR);
      target->receive_damage(
        "jing",
        me->query_per() + random((int)me->query_skill(
          "yunu-xinjing",
          1
        ) + (int)me->query_skill("yunu-xinfa", 1))
      );
      if (target->query("combat_exp") >= me->query("combat_exp"))
        if ((int)me->query("potential") - (int)me->query("learned_points") < 100)
          me->add("potential", 1);
      me->start_busy(2);
      target->start_busy(random(3));
      me->add("neili", -100);
    }
  }

  return 1;
}
