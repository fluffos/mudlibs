//五毒指法
//benlong 2001-02-16
#include <ansi.h>
inherit SKILL;

mapping *action = ({
  ([ "action": "$N深吸口气，身体急纵而上，双手食指疾伸，从$n意想不到的角度戳向$p的$l",
    "dodge": 30,
    "force": 150,
    "lvl": 0,
    "poison": 80,
    "damage_type": "刺伤"
  ]),

  ([ "action": "$N身形微曲，踢出右腿横扫$n的下盘, 突然间又飞起,身形急射，左手食指点向$n的$l",
    "dodge": 30,
    "force": 170,
    "lvl": 15,
    "poison": 60,
    "damage_type": "刺伤"
  ]),

  ([ "action": "$N仰天狂笑，趁$n一错愕之间，十根手指连点向$p的$l",
    "dodge": 10,
    "force": 200,
    "lvl": 20,
    "poison": 40,
    "damage_type": "刺伤"
  ]),

  ([ "action": "$N十指狂弹，仿佛中了邪一般，只见缕缕内劲犹如飞瀑般向$n的$l射去",
    "dodge": 40,
    "force": 300,
    "lvl": 25,
    "poison": 80,
    "damage_type": "内伤"
  ]),

  ([ "action": "$N嘿嘿一声阴笑，脸上阴气大盛，一股黑气顺双手蔓延到两臂，一招「五毒聚化」连连戳向$n的$l",
    "dodge": 20,
    "force": 360,
    "lvl": 30,
    "poison": 100,
    "damage_type": "瘀伤"
  ]),
});
int valid_enable(string usage) { return usage == "finger" || usage == "parry"; }
int valid_combine(string combo) {
  object me = this_player();
  mapping myfam = (mapping)me->query("family");
  if (myfam["master_name"] == "何铁手")
    return combo == "qianzhu-wandushou";
}
string query_skill_name(int level) {
  int i = sizeof(action);

  while (i--)
    if (level > action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me) {
  int i, level;
  level = (int)me->query_skill("wudu-zhi", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 25, level / 5)];
}
int valid_skill(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练五毒指法必须空手。\n");
  if ((int)me->query_skill("wudu-shengong", 1) < 10)
    return notify_fail("你的五毒神功火候不够，无法学五毒指法。\n");
  if ((int)me->query("max_neili") < 50)
    return notify_fail("你的内力太弱，无法练五毒指法。\n");
  return 1;
}
int practice_skill(object me) {
  if ((int)me->query("jingli") < 30)
    return notify_fail("你的精力太低了。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练五毒指法。\n");
  me->receive_damage("jingli", 30);
  me->add("neili", -10);
  return 1;
}
