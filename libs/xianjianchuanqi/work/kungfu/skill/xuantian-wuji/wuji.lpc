#include <ansi.h>
inherit F_CLEAN_UP;
void remove_effect(object me, int amount);

int exert(object me, object target)
{
        int skill;

        if( target != me ) 
                return 0;

        if( (int)me->query("neili") < 500  ) 
                return notify_fail("你的内力不够,不能提升战斗力\n");
        if( (int)me->query_temp("wuji") ) 
                return notify_fail("你已经在运功中了。\n");

        skill = me->query_skill("parry");
        me->add("neili", -200);
        me->add("jingli", -10);
        me->receive_damage("qi", 0);

        message_vision(
       HIW "$N运起玄天无级内功，混身发出荧荧光芒，脸色也变成了青色。\n" NOR, me);
        me->add_temp("apply/attack", skill/2);
        me->add_temp("apply/dodge",  skill/2);
        me->add_temp("apply/parry",  skill);
        me->set_temp("wuji", 1);

        me->start_call_out( (: call_other, __FILE__, "remove_effect", me, skill/2 :), skill/3);

        if( me->is_fighting() ) me->start_busy(1);

        return 1;
}

void remove_effect(object me, int amount)
{
        me->add_temp("apply/attack", - amount);
        me->add_temp("apply/dodge", - amount);
        me->add_temp("apply/parry", - amount*2);
        me->delete_temp("wuji");
        tell_object(me, HIW"你玄天无级功运行完毕，脸色也恢复正常。\n"NOR);
}
