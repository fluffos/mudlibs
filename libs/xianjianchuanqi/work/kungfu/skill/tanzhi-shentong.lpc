//    弹指神通
#include <ansi.h>
#include <power_control.h> 
inherit SKILL;
string *action_finger = ({
"$N中指微屈，突然弹出，一式「指点江山」，一缕劲风直袭$n的$l",
"$N左掌在身前一划，右手突然穿出，中指微弹，「如来神指」！直袭$n的$l",
"$N右臂挥动，中指连弹，在身前划了一道弧线，正是「一衣带水」，划向$n的前胸",
"$N跃起在半空，双手急挥，中指连弹，「弹指惊雷」铺天盖地般向$n涌去",
HIR "$N一声断喝，身形开始急速晃动，绕着$n游走。$n一错愕间，只听“嗤嗤”之声连响，无数道劲风从四面八方袭向$n！" NOR,
});

string *action_throwing = ({
"$N中指微屈，突然弹出，一式「指点江山」，$w破空之声甚厉，直袭$n的$l",
"$N左掌在身前一划，右手突然穿出，中指微弹，「如来神指」！$w呼啸着直袭$n的$l",
"$N右臂挥动，中指连弹，数个$w在身前划了一道弧线，正是「一衣带水」，划向$n的前胸",
"$N跃起在半空，双手急挥，中指连弹，「弹指惊雷」弹出铺天盖地的$w，向$n涌去",
HIR "$N一声断喝，身形开始急速晃动，绕着$n游走。$n一错愕间，只听“嗤嗤”之声连响，无数$w从四面八方袭向$n！" NOR,
});
int valid_enable(string usage) { return usage=="finger" || usage=="throwing" || usage=="parry"; }

int valid_combine(string combo) { return combo=="xuanfeng-tui"  || combo=="luoying-zhang" || combo=="lanhua-shou";}

int valid_learn(object me)
{
        object weapon;
        if (weapon = me->query_temp("weapon"))
                if ((string)weapon->query("skill_type") != "throwing")
                        return notify_fail("学弹指神通必须空手或手持暗器。\n");
        if ((int)me->query_skill("bihai-chaosheng", 1) < 130)
                return notify_fail("你的碧海潮生功火候不够，无法学弹指神通。\n");
        if (me->query_skill_mapped("force") != "bihai-chaosheng")
                return notify_fail("修习弹指神通必须有碧海潮生功配合。\n");
        if ((int)me->query("max_neili") < 1500)
                return notify_fail("你的内力太弱，无法练弹指神通。\n");
        return 1;
}

mapping query_action(object me, object weapon)
{
        int level;
        level = (int)me->query_skill("tanzhi-shentong",1);
        if (!weapon) 
                return (["damage_type":random(2)?"内伤":"瘀伤","action":action_finger[random(sizeof(action_finger))] ])
                        + query_my_power(me,level,at_type_hand,attack_lvl_high,defense_lvl_normal);
        else
                return (["damage_type":random(2)?"刺伤":"割伤","action":action_throwing[random(sizeof(action_throwing))], "post_action": (:call_other, WEAPON_D, "throw_weapon":) ])
                        + query_my_power(me,level,at_type_weapon,attack_lvl_high,defense_lvl_normal);
}

int practice_skill(object me)
{
        object weapon;
        if (weapon = me->query_temp("weapon"))
                if ((string)weapon->query("skill_type") != "throwing")
                        return notify_fail("练弹指神通必须空手或手持暗器。\n");
        if ((int)me->query("jingli") < 70)
                return notify_fail("你的体力太低了。\n");
        if ((int)me->query("neili") < 40)
                return notify_fail("你的内力不够练弹指神通。\n");
        me->receive_damage("jingli", 50);
        me->add("neili", -30);
        return 1;
}

string perform_action_file(string action)
{
      return __DIR__"tanzhi-shentong/" + action;
}

int ob_hit(object ob, object me, int damage) 
{ 
             object wp,wp1; 
             string msg; 
             int j,skill, neili, neili1; 
             wp1 = ob->query_temp("weapon"); 
             skill = me->query_skill("tanzhi-shentong", 1); 
             neili = me->query("neili"); 
             neili1 = ob->query("neili"); 
                if(!objectp(wp1)) return 0;
                if (me->query_skill_mapped("parry")!="tanzhi-shentong")  return 0;
         if (random(skill) > (int)ob->query_skill("dodge",1)/2  && random(6)>3 && (int)me->query("neili") > 0 && skill > 120 )
         {
                msg = HIM"$N眼见$n攻到面前，急催内劲，伸食指扣在拇指之下，对准"+wp1->name()+HIM"弹出，嗡的一声，恰好弹在"+wp1->name()+HIM"上！\n"; 
                message_vision(msg, me, ob); 
              if(random((int)me->query("str")) > (int)ob->query("str")/2 && random(10) > 7 && neili > neili1) 
               {
                     message_vision(HIC"$N"HIC"只觉一股大力自"+wp1->name()+HIC"传来，手臂一酸，手中"+wp1->name()+HIC"再也拿捏不住，脱手飞出！\n"NOR, ob); 
                wp1->unequip(); 
                wp1->move(environment(ob)); 
                     return -5000;
                }
              if ( (int)me->query("max_neili") < (int)ob->query("max_neili")*3/4 && random(10) > 7 )
                {
                message_vision(HIC"可惜$N的内力修为和$n相差太远,手指被震的隐隐作痛!\n"NOR,me,ob); 
                me->start_busy(1);
                return 0;
                }
               message_vision(HIC"$N"HIC"只觉一股大力自"+wp1->name()+HIC"传来，虎口震得发麻，"+wp1->name()+HIC"险些脱手！\n"NOR, ob); 
                 ob->start_busy(1);
                 return -damage/2; 
                     } 
}
