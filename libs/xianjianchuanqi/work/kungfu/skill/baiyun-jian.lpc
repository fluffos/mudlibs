// baiyun-jian.c  白云剑法
#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *msg = ({
"$N手中剑轻轻一晃，$w化为一道电光，使出「春云乍展」刺向$n的$l",
"$N挺剑直刺，剑尖将到之际，突然圈转一招「海市蜃楼」劈向$n的$l，虚虚实实，剑光霍霍",
"$N抢到$n左面，$w举剑在面前挽个平花，一招「天外来云」向$n突刺而去",
"$N拔起身子向前急纵，手中$w使出一式的「白虹贯日」直刺$n的$l",
"$N左掌护身，剑走偏锋，身形婉如行云流水，手中$w一式的「杏花春雨」，挺剑当胸平刺",
"$N左手轻轻拍出一掌，右手中的$w使出一招「横云断峰」，斩向$n的$l",
"$N使出一招「春云绵绵」，手中的$w画了一道圆弧，向$n的$l刺来",
});
string *parry_msg = ({
"$n以功代守，$v直向$N刺去。逼迫$N撤回了攻势。\n",
"$n使出一招「云雾缭绕」，将全身躲在了$v形成的剑幕中。\n",
"$n将手中的$v连续刺出，挡住$N的全部攻势。\n",
});
int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }
int valid_learn(object me)
{
        if ((int)me->query("max_neili") < 100)
                return notify_fail("你的内力不够。\n");
        if ((int)me->query_skill("mingyun-qingqi", 1) < 20)
                return notify_fail("你的内功火候太浅。\n");
        if ((int)me->query_skill("sword", 1) < 20)
                return notify_fail("你的剑术火候太浅。\n");
        return 1;
}

mapping query_action(object me, object weapon) {
        return (["damage_type":random(2)?"刺伤":"割伤","action":msg[random(sizeof(msg))] ])
                + query_my_power(me,(int)me->query_skill("songshan-jian",1),at_type_weapon,attack_lvl_normal,defense_lvl_middle);
}

int practice_skill(object me)
{
        object weapon;

        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
                return notify_fail("你使用的武器不对。\n");
        if ((int)me->query("jingli") < 50)
                return notify_fail("你的体力不够练白云剑法。\n");
        if ((int)me->query("jingli") < 20)
                return notify_fail("你的内力不够练白云剑法。\n");
                        me->receive_damage("jingli", 35);
        if ((int)me->query_skill("baiyun-jian",1) > 120 )
            me->add("neili",-15);
        return 1;
}
string perform_action_file(string action)
{
        return __DIR__"baiyun-jian/" + action;
}

