// weituo-zhang.c 韦驮掌
#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *msg = ({
"$N双眼微睁，袍袖微微鼓气，双掌齐推，一招「开天辟地」，一股排山之势压向$n",
"$N口中阿弥陀佛，一招「即世即空」，左掌击向$n面门，另一掌却按向$n的小腹",
"$N双掌互错，变幻莫测，一招「无相无色」，瞬息之间向$n攻出了三四一十二招",
"$N呼的一掌，没有半点征兆，一招「佛法无边」，猛地向$n的$l击打过去",
"$N双掌交错，若有若无，一招「谁入地狱」，带着劲风拍向$n的肩头和前胸",
"$N一招「禅心永明」，右手一掌击出，紧接着右掌上一搭，击向$n的$l",
"$N双手在空中齐划，跟着双掌齐推，一招「我佛慈悲」，一股排山倒海的掌力，直扑$n面门",
"$N突然身行急转，一招「苦海回头」，掌影飞舞，霎时之间将$n四面八方都裹住了",
});

int valid_enable(string usage) { return usage=="strike" ||  usage=="parry"; }

int valid_combine(string combo) { 
        return  combo=="mohe-zhi" || combo=="fengyun-shou" || combo=="jimie-zhua"
                 || combo=="shaolin-tantui" || combo=="luohan-quan" 
                 || combo=="nianhua-zhi" || combo=="qianye-shou" || combo=="yizhi-chan"
                 || combo=="longzhua-gong" || combo=="jingang-quan" || combo=="ruying-suixingtui"; 
}

int valid_learn(object me)
{
        if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
                return notify_fail("练韦驮掌必须空手。\n");
        if ((int)me->query_skill("yijin-jing", 1) < 10)
                return notify_fail("你的易筋经内功火候不够，无法练韦驮掌。\n");
        if ((int)me->query("max_neili") < 50)
                return notify_fail("你的内力太弱，无法练韦驮掌。\n");
        return 1;
}

mapping query_action(object me)
{
        int level;
          string a_msg;
        level = (int)me->query_skill("weituo-zhang",1);
         a_msg=msg[random(sizeof(msg))] ;
        if( random(level) > level - level/12  )
                a_msg=select_color() + a_msg + NOR;
        return (["damage_type":random(2)?"内伤":"瘀伤","action":a_msg ])
                + query_my_power(me,level,at_type_hand,attack_lvl_normal,defense_lvl_normal);
}

int practice_skill(object me)
{
        if ((int)me->query("jingli") < 30)
                return notify_fail("你的体力太低了。\n");
        if ((int)me->query("neili") < 20)
                return notify_fail("你的内力不够练韦驮掌。\n");
        me->receive_damage("jingli", 25);
        me->add("neili", -10);
        return 1;
  }

