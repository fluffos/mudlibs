// if it have some bug , pls fixed it ,thank
#include <ansi.h>
inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int exert(object me, object target) {
  int skill;

  if (target != me)
    return 0;

  if ((int)me->query("neili") < 500)
    return notify_fail("你的内力不够,不能提升战斗力\n");
  if ((int)me->query_temp("shenyuan"))
    return notify_fail("你已经在运功中了。\n");

  skill = me->query_skill("force");
  me->add("neili", -200);
  me->add("jingli", -10);
  me->receive_damage("qi", 0);

  message_vision(
    HIC "$N双目紧闭，内息顿绝，混身发出荧荧光芒。突然$N睁开双目，眼中充满诡异的杀气。\n" NOR, me);

  me->add_temp("apply/attack", skill / 4);
  me->add_temp("apply/dodge", skill / 6);
  me->add_temp("apply/parry", skill / 6);
  me->set_temp("shenyuan", 1);

  me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill / 2 :), skill / 3);

  if (me->is_fighting()) me->start_busy(1);

  return 1;
}

void remove_effect(object me, int amount) {
  int skill;
  skill = me->query_skill("force");
  me->add_temp("apply/attack", -skill / 4);
  me->add_temp("apply/dodge", -skill / 6);
  me->add_temp("apply/parry", -skill / 6);
  me->delete_temp("shenyuan");
  tell_object(me, BLU "你神元功运行完毕，内息恢复从前。\n" NOR);
}
