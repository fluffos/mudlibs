#include <ansi.h>
inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }

#include "force.h"

int valid_learn(object me)
{
        int lvl = (int)me->query_skill("zixia-gong", 1);
        if ( me->query("gender") == "无性" && lvl > 49)
                return notify_fail("你无根无性，阴阳不调，难以领会高深的紫霞功。\n");

        if ((int)me->query_skill("force", 1) < 15)
                return notify_fail("你的基本内功火候还不够。\n");

        if (lvl > 10 && (int)me->query("shen") < lvl*lvl*lvl / 15)
                return notify_fail("你的侠义正气太低，无法研习高深的紫霞功。\n");

        return valid_public(me);
}

int practice_skill(object me)
{
        return notify_fail("紫霞功只能用学来增加熟练度。\n");
}

string exert_function_file(string func)
{
        return __DIR__"zixia-gong/" + func;
}
mapping exercise_msg(object me)
{
  return ([
    "status_msg" : MAG + me->name()+"双手捏个剑诀，脸上紫气浮现。" NOR,
 "start_my_msg" : HIM"你屏息静气，坐了下来，左手搭在右手之上，在胸前捏了个剑诀，引导内息游走各处经脉。\n"NOR,
    "start_other_msg" : me->name()+"盘膝坐了下来，双手虚握成拳，不一会，头顶冒出氤氤紫气。\n",
    "halt_msg" : HIM"$N心神一动，将内息压回丹田，双臂一振站了起来。\n"NOR,
    "end_my_msg" : HIM"你将内息走满一个周天，只感到全身通泰，丹田中暖烘烘的，双手一分，缓缓站了起来。\n"NOR,
    "end_other_msg" : me->name()+"长出一口气，一抖衣襟，站了起来，眼中精光一闪。\n"
  ]);
}
