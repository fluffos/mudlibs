// zixia.c 
// by kain
#include <ansi.h>
inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int exert(object me)
{
        int skill;
//  if( target != me ) 
//  return 0

        if((int) me->query_skill("zixia-gong",1)< 100)
                return notify_fail("你的紫霞功修为不够.\n");
        if( (int)me->query("neili") < 300  ) 
                return notify_fail("你的内力不够,不能提升战斗力!\n");
        if( (int)me->query_temp("zixia") ) 
                return notify_fail("你已经在运功中了。\n");

        skill = me->query_skill("force");
        me->add("neili", -200);
        me->add("jingli", -10);
        me->receive_damage("qi", 0);

        message_vision(
        MAG "$N双目发出凌厉的眼神，默运紫霞神功，只见$N的脸上紫气忽隐忽现，战斗力顿时提升。\n" NOR, me);

        me->add_temp("apply/attack", skill/5);
        me->add_temp("apply/dodge",  skill/5);
        me->set_temp("zixia", 1);

        me->start_call_out( (: call_other, __FILE__, "remove_effect", me, skill/2 :), skill/3);

        if( me->is_fighting() ) me->start_busy(1);

        return 1;
}

 void remove_effect(object me, int amount)
{
int skill;
 skill = me->query_skill("force");
        me->add_temp("apply/attack", - skill/5);
        me->add_temp("apply/dodge", - skill/5);
        me->delete_temp("zixia");
        tell_object(me, HIW"你长出一口气，散去全身的紫霞，一切恢复如前。\n"NOR);
}


