// jingang-quan.c -大金刚拳
#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *msg = ({
  "$N蔼然微笑，一式「礼敬如来」，双手合十向前微微一拜，一股暗劲蓄势而发，击向$n的$l",
  "$N面色恭敬，一式「遇佛传法」，闪到$n的身后，左手单掌在胸前一立，右手成拳直击$n的后脑。",
  "$N一声冷笑，一式「幽冥搜魂」双拳快速交替击出十数拳，拳带风声“呼呼”作响，令$n不住倒退，疲于招架",
  "$N暴雷般大喝声中，一式「引火炼妖」，双拳一前一后，挟着一股热浪推向$n",
  "$N一式「魂散心魔」，低眉垂目之间，突然双拳直上直下，不成章法，犹如疯魔一般攻向$n的身前身后",
  "$N一式「无相法相」，右拳虚晃，身形一变，已化出数十个幻影，齐齐击向$n的全身各处",
  "$N腾身跃起，半空中出现巨大身影，突然一式「攀天祥云」，头下脚上，旋转着俯冲下来，双拳兜向$n的太阳穴",
  "$N庄严伫立，深深吸了一口气，全身衣服微微涨起，低喝一声，一式「超度极乐」，内力澎湃而出，击向$n的前胸",
});

int valid_enable(string usage) { return usage == "cuff" || usage == "parry"; }

int valid_combine(string combo) {
  object me;
  me = this_player();
  if ((int)me->query_int() + (int)me->query_con() > 90)
    return combo == "yizhi-chan" || combo == "longzhua-gong" || combo == "banruo-zhang" || combo == "ruying-suixingtui" || combo == "qianye-shou";
}

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练大金刚拳必须空手。\n");
  if ((int)me->query_skill("yijin-jing", 1) < 60)
    return notify_fail("你的易筋经内功火候不够，无法学大金刚拳。\n");
  if ((int)me->query_int() > 42)
    return 1;
  else {
    if ((int)me->query_skill("banruo-zhang") &&
      ("yizhi-chan") &&
      ("longzhua-gong") &&
      ("qianye-shou") &&
      ("ruying-suixingtui"))
      return notify_fail("你的功力不够，无法同时学习两种以上的上乘功夫。\n");
  }

  if ((int)me->query("max_neili") < 600)
    return notify_fail("你的内力太弱，无法练大金刚拳。\n");
  return 1;
}

mapping query_action(object me) {
  int level;
  string a_msg;
  level = (int)me->query_skill("jingang-quan", 1);
  a_msg = msg[random(sizeof(msg))];
  if (random(level) > level - level / 12)
    a_msg = HIY + a_msg + NOR;
  return ([
    "damage_type": random(2) ? "内伤" : "瘀伤",
    "action": a_msg
  ]) + query_my_power(me, level, at_type_hand, attack_lvl_high, defense_lvl_normal);
}

int practice_skill(object me) {
  if ((int)me->query("jingli") < 60)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 30)
    return notify_fail("你的内力不够练大金刚拳。\n");
  me->receive_damage("jingli", 50);
  me->add("neili", -20);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "jingang-quan/" + action;
}
