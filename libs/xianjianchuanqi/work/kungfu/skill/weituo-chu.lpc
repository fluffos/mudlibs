#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *msg = ({
"$N跃在半空，一招「仙鹤展翅入灵山」，手中$w已化成无数棍影，令$n眼花缭乱，不知所措，连连倒退",
"$N一招「玉马衔环拜仙宫」，$w上下左右飞快搅动，身随棍走，向$n压了下来",
"$N一招「鸣鹿踏蹄觅仙草」，屈膝俯身，手中$w连点$n下盘，却未等招数用老，猛的一提，向$n的胸腹间戳去",
"$N突然滚到在地，$n错愕间，一招「金鲤跃水潜天池」，竟从$n的裆下窜过，更不回头，$w反手扫向$n的$l",
"$N一招「灵猿献果赴蓬莱」，身形如电，绕着$n飞快奔跑，手中$w一招快似一招，刹那间向$n连打出十六棍",
"$N大踏步上前，劲贯双臂，手中$w大开大阖，呼呼风声中一招「飞鹰盘旋扫乾坤」扫向$n的腰间",
"$N大喝一声，一招「天龙出水腾宇宙」，$w脱手飞出，夹着劲风射向$n的前心，随即抢到$n的身后，伸手又把$w抄在手中",
"$N双目圆睁，口中默诵真言，一招「白象卷云憾天柱」，$w似有千斤，缓缓举起，又缓缓向$n的当头砸落",
 });
 
 int valid_enable(string usage) { return  (usage == "club") || (usage =="parry"); }
 
 int valid_learn(object me)
 {
           mapping fam  = me->query("family");
         if (fam["family_name"] != "少林派" )
         return notify_fail("韦陀杵只能从少林派学到。\n");
         if ((int)me->query("max_neili") < 1500)
                 return notify_fail("你的内力不够。\n");
         if ((int)me->query_skill("yijin-jing", 1) < 160)
                 return notify_fail("你的易筋经内功火候太浅。\n");
          if((int)me->query_skill("zui-gun",1) <=120)
      return notify_fail("你的醉棍火候不足，难以领悟韦陀杵。\n");
             if ((int)me->query_skill("ranmu-daofa",1) >1 || (int)me->query_skill("riyue-bian",1)>1)
                  return notify_fail("你如果有达摩老祖的修为，方可同时学习少林三绝技。\n"); 
         return 1;
 }
 
string perform_action_file(string action)
{
        return __DIR__"weituo-chu/" + action;
}
mapping query_action(object me)
{
        int level,at_lvl;
         string a_msg;
          at_lvl=attack_lvl_high;
        level = (int)me->query_skill("weituo-chu",1);
         a_msg=msg[random(sizeof(msg))] ;
        if( random(level) > level - level/8  )
        {
                a_msg= select_color() + a_msg + NOR ;
                at_lvl=attack_lvl_super;
        }
        return (["damage_type":random(2)?"刺伤":"内伤","action":a_msg ])
                + query_my_power(me,level,at_type_weapon,at_lvl,defense_lvl_normal);
}
 
int practice_skill(object me)
 {
         object weapon;
           if((int)me->query_skill("zui-gun",1) <=120)
      return notify_fail("你的醉棍火候不足，难以领悟韦陀杵。\n");
             if ((int)me->query_skill("ranmu-daofa",1) >1 || (int)me->query_skill("riyue-bian",1)>1)
                  return notify_fail("你如果有达摩老祖的修为，方可同时学习少林三绝技。\n"); 
         if (!objectp(weapon = me->query_temp("weapon"))
                  || (string)weapon->query("skill_type") != "club")
                 return notify_fail("你使用的武器不对。\n");
         if ((int)me->query("jingli") < 70)
                 return notify_fail("你的体力不够练韦陀棍。\n");
                if ((int)me->query("neili") < 70)
                 return notify_fail("你的内力不够练韦陀棍。\n");
         me->receive_damage("jingli", 60);           
            me->add("neili",-20);
         return 1;
}

