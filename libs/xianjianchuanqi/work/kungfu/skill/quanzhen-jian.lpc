// quanzhen-jian.c 全真武功
#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *msg = ({
  "$N使出一招「星河影动」，剑光闪烁不定，若有若无地刺向$n$l",
  "$N贴地斜飞，一招「雁行斜击」，尚未落地，$w已指向$n的后心",
  "$N神态悠闲，手中$w凭空一指，一招「白云千载」轻妙地划向$n的$l",
  "$N脚下踏了个七星步，一招「古道西风」手中$w势若飞瀑向$n拦腰一斩",
  "$N一招「花前月下」，模拟冰轮横空，清光铺地之光景，自上而下搏击",
  "$N轻轻一跃，使了个「乘风归去」，却在转身之际对准$n$l斜斜挥出一剑",
  "$N左掌前挥，右手扬剑跟随，一招「推窗望月」，身形前扬，往$n的$l杀至",
  "$N一招「分花拂柳」，$w似左实有右，似右实左，虚实莫辩，点向$n的腹部",
  "$N轻飘飘地纵身跃起，手中$w连续划出几个光环，，一招「皓月当空」，向$n的$l圈去",
  "$N手中$w向$n的右手疾刺，但正当$n要招架时，$w却突然转向了$n的左足！这招「金波低转」确实神鬼莫测",
  "$N一式「琴心三叠」，看似不急不缓，三道剑影，一道胜似一道，直攻$n的前胸",
  "$N展开身形，$w之攻势绵绵不绝地缠向$n的$l。诗云：无边丝雨细如愁。这一招「丝雨如愁」果然深得诗中三味",
  "$N使出「抚琴按箫」，$w提至唇边，如同清音出箫，剑掌直出，划向$n的$l",
  "但见$N连退几步，忽然间纵身跃起，手中$w一式「沧海月明」对准$n的$l凌空一斩",
  "激战中，$N一招「飞花似梦」，英姿勃发，$w舞出数点寒心，若梅桃盛开，点向$n的$l",
  "$N双脚一顿，笔直跃起，手中$w不停地颤抖着，如「水银泄地」般笼罩住$n全身，无孔不入",
  "$N在$n四周游走，手中$w去势飘忽不定，只看得$n眼花缭乱。趁此良机，$N于朦朦胧胧中一抖$w，一招「清雨朦胧」向$n的$l疾挑",
  "$N手中$w中宫直进，疾速刺向$n的前心。这招「月白风清」令人耳目一新。$n只觉浑身一紧，$w已刺到了$l",
  "$N手中$w带起点点寒光，指向$n前胸穴道。$n正专心致志地对付着剑招，不料$N左手运力拍向$n的$l。这式「花明月暗」亦真亦幻，实是难防",
  "$N仗起手中$w，带出点点寒光，罩住$n的胸腹，只等$n的破绽，$N将这招「潇湘夜雨」使得直如细雨般紧密，$n实在不知$w将要指向自己身上何处",
});

int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }

int valid_learn(object me) {
  if ((int)me->query("max_neili") < 100)
    return notify_fail("你的内力修为不够。\n");
  if ((int)me->query_skill("quanzhen-xinfa", 1) < 20)
    return notify_fail("你的全真心法火候不到。\n");
  if ((int)me->query_skill("jinyan-gong", 1) < 20)
    return notify_fail("你的金雁身法火候太浅。\n");
  return 1;
}


mapping query_action(object me) {
  int level, at_lvl;
  string a_msg;
  at_lvl = attack_lvl_high;
  level = (int)me->query_skill("quanzhen-jian", 1);
  a_msg = msg[random(sizeof(msg))];
  if (random(level) > level - level / 10) {
    a_msg = select_color() + a_msg + NOR;
    at_lvl = attack_lvl_super;
  }
  return ([
    "damage_type": random(2) ? "刺伤" : "割伤",
    "action": a_msg
  ]) + query_my_power(me, level, at_type_weapon, at_lvl, defense_lvl_normal);
}

int practice_skill(object me) {
  object weapon;
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("jingli") < 60)
    return notify_fail("你的体力不够练全真剑法。\n");
  if ((int)me->query("neili") < 30 && (int)me->query_skill("quanzhen-jian", 1) > 100)
    return notify_fail("你的内力不够练全真剑法。\n");
  if ((int)me->query_skill("quanzhen-jian", 1) > 100)
    me->add("neili", -20);
  me->receive_damage("jingli", 50);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "quanzhen-jian/" + action;
}
