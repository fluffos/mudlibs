//junlin.c 君临天下 by rockman 慕容终极pfm

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>


inherit F_SSERVER;

int perform(object me,object target)
{
		object weapon;
        string msg;
		int jl;

                jl=(int)me->query_skill("murong-jianfa",1);
		weapon=me->query_temp("weapon");

                if(!target)  target=offensive_target(me);

		if(!target||!target->is_character()||!me->is_fighting(target))
			return notify_fail("「君临天下」只能对战斗中的对手使用!\n");

                if(!weapon||weapon->query("skill_type")!="sword"||me->query_skill_mapped("sword")!="murong-jianfa")
			return notify_fail("你手中无剑,如何使用「君临天下」?!\n");


		if(me->query_skill("murong-jianfa",1)<180)
			return notify_fail("你的慕容剑法级别不够,还不能使用「君临天下」绝技!\n");

		if(me->query_skill("murong-jianfa",1)<180)
			return notify_fail("你的慕容剑法级别不够,还不能使用「君临天下」绝技!\n");

		if(me->query_skill("sword",1)<180)
			return notify_fail("你的基本剑法级别不够,不能使用「君临天下」绝技!\n");

		if(me->query_skill("shenyuan-gong",1)<180)
			return notify_fail("你的内功修为火候未到,如果冒然使用「君临天下」绝技,会伤及自身的!\n");

		if(me->query_skill_mapped("force")!="shenyuan-gong")
			return notify_fail("你所使用的内功不对!\n");

		if(me->query("max_neili")<=2000)
			return notify_fail("你的内力修为不足,不足以使用「君临天下」绝技!\n");

		if(me->query("neili")<=1000)
			return notify_fail("你的内力不够使用「君临天下」绝技了!\n");

		if(me->query("jingli")<500)
			return notify_fail("你的精力有限,不能使用「君临天下」绝技!\n");
          msg = HIG"\n$N纵身而起,使出大燕王室绝学-「君临天下」,突然天空乌云密布,一条五彩金龙从天而降,付在$N的身上.$n惊骇之下,手忙脚乱,顿时出招散乱，无从招架!\n\n"NOR;
        message_vision(msg, me, target);

		me->add_temp("apply/dodge",jl);
		me->add_temp("apply/parry",jl);
		me->add_temp("apply/attack",jl);
		me->add_temp("apply/damage",jl);
                me->add_temp("neili",-1000);
                me->add_temp("jingli",-100);

                msg = HIM"$N大喝一声: 「君」!五彩金龙挥出一爪,击向$n的左臂!\n"NOR;
        message_vision(msg, me, target);
		COMBAT_D->do_attack(me,target,me->query_temp("weapon"),1);
                msg = HIY"$N大喝一声: 「临」!五彩金龙挥出一爪,击向$n的右臂!\n"NOR;
        message_vision(msg, me, target);
		COMBAT_D->do_attack(me,target,me->query_temp("weapon"),1);
                    msg = HIC"$N大喝一声: 「天」!五彩金龙挥出一爪,击向$n的胸口!\n"NOR;
        message_vision(msg, me, target);
		COMBAT_D->do_attack(me,target,me->query_temp("weapon"),1);
                        msg = HIG"$N大喝一声: 「下」!五彩金龙挥出一爪,击向$n的下身!\n"NOR;
        message_vision(msg, me, target);
                COMBAT_D->do_attack(me,target,me->query_temp("weapon"),1);
        msg = HIR "$N双目圆瞪,怒喝到:君临天下,惟我独尊!五彩金龙长啸一声,四爪齐出,击向$n的头部!\n"NOR;
        message_vision(msg, me, target);
		COMBAT_D->do_attack(me,target,me->query_temp("weapon"),1);

		me->add_temp("apply/dodge",-jl);
		me->add_temp("apply/parry",-jl);
                me->add_temp("apply/attack",-jl);
		me->add_temp("apply/damage",-jl);
		me->start_busy(2);
                msg = HIW "$N的「君临天下」神功使用完毕,五彩金龙嘶鸣一声,返回天际!\n"NOR;
        message_vision(msg, me, target);

		return 1;
}
