// wuming-qiangfa.c 【无名枪法】也可以当棒使用
#include <ansi.h>
inherit SKILL;
#include <power_control.h>
string *msg = ({
"$N使个旗鼓，一招“毒龙出洞”，枪上红缨抖动，卷起碗大枪花，往$n的$l直搠过去,",
"$N倒转枪来，一招“白虹经天”，大枪一横，“呼”地一声，向$n的$l直扫过去,",
"$N一招“春雷震怒”，大枪一抖，自下而上，快如闪电，疾挑$n的$l而来,",
"$N一个上步“孤雁出群”，枪势如风，往$n的$l刺去",
"$N将手一抖一收，红缨一扑，一招“风起云涌”，手中$猛向$n的$l直戳进去",
"$N提起$w，一招“行步蹬虎”，身形一闪，一式“朝天一炷香”，枪尖闪闪，直刺$n咽喉",
"$N抖动枪杆，朱缨乱摆，枪头嗤嗤声响，颤成一个大红圈子。$n只觉耀眼生花，明晃晃的枪尖离$l不过数寸，",
"$N举起$w，力贯双臂，枪尖下寒光闪动，势挟劲风，向$n的$l疾刺,向$n$l,劲力威猛已极。",
});

int valid_learn(object me)
{
        object ob;
        if( (int)me->query("neili") < 100 )
                return
                notify_fail("你的内力不够，没有办法练无名枪法。\n");
        if( !(ob = me->query_temp("weapon"))
        ||  (string)ob->query("skill_type") != "spear" )
                return notify_fail("你必须先找一柄枪才能练枪法。\n");
        return 1;
}

int valid_enable(string usage)
{
        return ((usage=="spear") || (usage=="parry") );
}

mapping query_action(object me, object weapon)
{
        int level;
        string a_msg;
        level = (int)me->query_skill("wuming-qiangfa",1);
        a_msg=msg[random(sizeof(msg))] ;
        if( random(level) > level - level/6 )
                a_msg=select_color() + a_msg + NOR;
        return (["damage_type":"刺伤","action":a_msg ])
        + query_my_power(me,level,at_type_weapon,attack_lvl_high,defense_lvl_normal);
}

int practice_skill(object me)
{
        object weapon;

        if( !objectp(weapon = me->query_temp("weapon"))
        ||      (string)weapon->query("skill_type") != "spear" )
                return
notify_fail("你必须先找一柄长枪或者是类似的武器，才能练枪法。\n");

        if( (int)me->query("jingli") < 200 
        ||    (int)me->query("neili") < 300  )
                return
        notify_fail("你的体力不够练这门枪法，还是先休息休息吧。\n");
        me->receive_damage("jingli", 30);
        me->add("neili", -25);
//        write("你默默回忆那路枪法，按照所记忆的练了一遍枪法。\n");
        return 1;
}
        
string perform_action_file(string action)
{
        return __DIR__"wuming-qiangfa/" + action;
}
