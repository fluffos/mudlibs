// yitian-tulong.c 「倚天屠龙功」
// sunyc 00/9/3

#include <ansi.h>
inherit SKILL;
#include "/kungfu/skill/eff_msg.h";

string *parry_msg = ({
  HIW "$p但觉一股劲风袭至胸口，当下$W一带，画出一个上撇，刚好封住了$P的来势。\n" NOR,
  HIW "危急之中，$p伸$W在$P的右掌上一按，一借力，轻轻巧巧的避过，这一招乃是「武」字诀中的一戈。\n" NOR,
  HIW "$p$W下掠，反手使出一记「刀」字诀，带住$P的来势，$W一撇一点，身子借势窜起。\n" NOR,
  HIW "当下$p$W使一招「刀」字诀中的左撇，借着$P的来势，稍加拨动，当千钧一发之际，转危为安。\n" NOR,
  HIW "$p转身$W虚划「至」字诀第二三笔，套住$P的来势，轻轻引向一旁。\n" NOR,
  HIW "$p$W轻分，一式「龙」字诀的立勾早将$P的劲风引至一旁。\n" NOR,
});

string query_parry_msg(object weapon, object victim) {
  object ob;

  if (!objectp(ob = victim->query_temp("weapon")))
    return replace_string(parry_msg[random(sizeof(parry_msg))], "$W", random(2) ? "左掌" : "右掌");
  else
    return replace_string(parry_msg[random(sizeof(parry_msg))], "$W", ob->name());
}

mapping *action = ({
  ([ "action": HIW "$N凝神展行,双手缓缓挥动,一个[" RED "武" NOR "" HIW "]字业已拍向$n$l。" NOR,
    "force": 900,
    "dodge": 20,
    "damage_type": "震伤"
  ]),
  ([ "action": HIG "$N神色凝重,身体高纵而起,纵而险劲,连攻带守业已向$n的$l划出8掌。分明写出了一个[" RED "林" NOR "" HIG "]字。" NOR,
    "force": 520,
    "dodge": 10,
    "damage_type": "割伤"
  ]),
  ([ "action": CYN "$N行随神移,如狡兔之脱,淋漓酣畅,一个[" RED "至" NOR "" CYN "]字飘然拍向$n$l." NOR,
    "force": 550,
    "dodge": 20,
    "damage_type": "震伤"
  ]),
  ([ "action": BLU "$N缓缓道出一个[" RED "尊" NOR "" BLU "]字,双掌大开大合拍向$n$l,当真大有武林至尊的气势。" NOR,
    "force": 600,
    "dodge": 20,
    "damage_type": "震伤"
  ]),
  ([ "action": MAG "$N神情愈加悲愤,双掌转而厚重,掌掌带风,掌掌不离$n的$l,虎虎之声不绝于耳,正是一个[" RED "宝" NOR "" MAG "]字。" NOR,
    "force": 740,
    "dodge": 20,
    "damage_type": "震伤"
  ]),
  ([ "action": HIW "$N当胸一掌横劈$n转而又攻敌下盘,双掌重如千斤,简简单单的一个[" RED "刀" NOR "" HIW "]字,当真厚重如虎蹲,如象步。" NOR,
    "force": 600,
    "dodge": 20,
    "damage_type": "劈伤"
  ]),
  ([ "action": HIW "$N[" RED "屠" NOR "" HIW "]字缓缓拍向$n$l,缩如尺蠖之屈,招式无奇却透着掌法真谛。" NOR,
    "force": 550,
    "dodge": 20,
    "damage_type": "震伤"

  ]),
  ([ "action": HIY "$N运起梯云纵神功,身法陡增,掌掌刺向$n$l,星剑光芒,霆不暇发,电不及飞,瞬间划出一个[" RED "龙" NOR "" HIY "]字" NOR,
    "force": 560,
    "dodge": 20,
    "damage_type": "刺伤"
  ]),
  ([ "action": HIR "$N身法忽而轻灵,一[" RED "号" NOR "" HIR "]字划向$n$l,扬波搏击,威风无比。" NOR,
    "force": 500,
    "dodge": 20,
    "damage_type": "割伤"
  ]),
  ([ "action": CYN "$N[" RED "令" NOR "" CYN "]字拍向$n$l,利风嗖嗖有如雁飞雕振,鹤唳天翔,果真奇妙无比。" NOR,
    "force": 500,
    "dodge": 20,
    "damage_type": "震伤",
  ]),
  ([ "action": CYN "$N掌式大开大阔,一个[" RED "天" NOR "" CYN "]字挥向$n$l,顶天立地,气势咄咄逼人。" NOR,
    "force": 500,
    "dodge": 20,
    "damage_type": "割伤"
  ]),
  ([ "action": YEL "$N招式平淡无奇,竟似吟诗作画一般,身形流动,一个轻飘飘的[" RED "不" NOR "" YEL "]字随即划向$n$l。" NOR,
    "force": 800,
    "dodge": 20,
    "damage_type": "割伤"
  ]),
  ([ "action": HIG "$N单掌陡然劈出,正是[" RED "倚" NOR "" HIG "]字的第二笔,当真电光火石,快如闪电劈向$n$l。" NOR,
    "force": 880,
    "dodge": 20,
    "damage": 900,
    "damage_type": "劈伤"
  ]),
  ([ "action": "$N[" RED "天" NOR "]字缓缓划向$n$l,正合武当三清本意,博大精深,清静无为。",
    "force": 570,
    "dodge": 10,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N神情默然,身形俊逸如风飘,如雪舞,好一个[" RED "不" NOR "]字劈向$n$l。",
    "force": 600,
    "dodge": 30,
    "damage_type": "劈伤"
  ]),
  ([ "action": "$N身如俊龙一般盘旋而起,双掌默运真气,利风嗖嗖,划向$n$l的正是一个[" RED "出" NOR "]字。",
    "force": 850,
    "dodge": -20,
    "damage_type": "割伤"
  ]),
  ([ "action": CYN "$N" RED "[谁与争锋]" CYN "四字合一,一经用出方圆十里之内肃杀之声不绝于耳,$n全身大穴尽在掌式之中" NOR,
    "force": 900,
    "dodge": 20,
    "damage_type": "震伤"
  ]),
});

int valid_enable(string usage) {
  return usage == "strike" || usage == "parry";
}

int valid_combine(string combo) {
  return combo == "taji-quan" || combo == "taiji-jian";
}

mapping query_action(object me, object weapon) {
  string *msg = ({
    HIY "但见$N转身欺上,双手翻飞一个飘摇不定的" RED "「羲」" HIY "字无可捉摸的按向$n胸口!" NOR,
    HIY "$N一声长啸,左手单掌翻飞按向$n头部,右掌横劈$n胸口随即划向$n下盘,\n妙处横生的一个" RED "「之」" HIY "字顿现。" NOR,
    HIY "$N左手虚划半圆,右掌直劈$n左臂再挑$n胸口,跟着双掌划出页字,合成后边成为一个草体的" RED "「顿」" HIY "字。" NOR,
    HIY "$N双掌分划一个反八字,而后分而横劈$n上身大穴,随即转身直劈$n下盘,同时捉摸不定的划向$n小腹,\n却正写出了个" RED "「首」" HIY "字" NOR,
    HIY "$N当胸双掌交叉按向$n胸口,随即双掌上挑$n双臂,\n掌气将而未到之时,右掌转而横劈$n小腹,左掌立劈而下,\n转而上挑$n大腿和小腿,原来是一个" RED "「丧」" HIY "字。" NOR,
    HIY "$N左掌虚虚斜划向$n左臂,右掌突然直劈$n左脚,旋即双掌划出圆圈罩向$n下盘,\n转身单掌立劈转而斜下,上挑$n右臂!确正写出了一个" RED "「乱」" HIY "字!" NOR,
    HIY "$N左掌劈向$n颈部,右掌划出一个z形笼罩$N全身大穴。正组成了一个美妙的" RED "「之」" HIY "字!" NOR,
    HIY "$N右掌虚划十字花,双掌落向$n双手,\n左掌虚划$n大腿,右掌斜劈而下,合成了一个" RED "「极」" HIY "字!" NOR,
    HIY "$N左掌横劈而出,掌风笼罩$n胸口和小腹,右掌立劈\n分划$n左右双腿,却是一个精妙无比的" RED "「先」" HIY "字!" NOR,
    HIY "$N右掌草字缓缓罩向$n头部,左掌日字划向$n前胸,\n掌式忽变沉重,虎虎风声划向$n下盘,却不正是一个" RED "「墓」" RED "字!" NOR,
    HIY "$N单掌横劈$n颈部，右手虚幻半圆,左手快如闪电立劈$n$l,活灵灵一个「再」字顿现!" NOR,
    HIY "$N双掌默运真气，身形陡然加快，$n只觉四周遍布$N的身影，整整被一个「离」字拍中胸口！" NOR,
    HIY "$N双手草字分花罩向$n印堂大穴，转而滑劈$n双手，而或横劈立勾，写出一个「荼」字" NOR,
    HIY "$N单掌分出三条劲气分截$n定门，胸口，小腹，右掌立劈，快如闪电！\n进而虚桃圆圈，单掌斜劈，正为「毒」字顿点！" NOR,
    HIY "$N口中喃喃而语，单掌分截顶门，咽喉，胸口，双臂，腰眼，裆部，举动中深得王羲之草字之妙！" NOR,
  });
  int i, j, level, level1, damage;
  object target;
  level = (int)me->query_skill("yitian-tulong", 1);
  level1 = (int)me->query_skill("literate", 1);
  damage = random(500) * (level / 100);
  if (damage < 700) damage = 700;
  if (random(level1) > 80 && random(6) == 4 &&
    level > 150 && me->query("neili") > 600) {
    me->add("neili", -70);
    return ([
      "action": RED "$N长啸三声,趁$n神情恍惚之际单掌拍向$n$l!" NOR,
      "force": 750,
      "dodge": random(20),
      "damage": damage + random(100),
      "damage_type": "震伤",
    ]);
  }
  if (random(level1) > 120 && random(20) > 13 && level > 200 && me->query("neili") > 600) {
    return ([
      "action": RED "$N右掌轻轻一带$n下盘,正是上乘的御力之法！只见$n足下轻浮,似要摔倒!" NOR,
      "force": 1000,
      "dodge": random(20),
      "damage": damage + random(300),
      "damage_type": "摔伤",
    ]);
  }

  if (me->query_temp("start_sangluan")) {
    if (level < 160) {
      return ([
        "action": msg[random(sizeof(msg))],
        "damage": damage * random(5),
        "damage_type": "割伤"

      ]);
    }
    if (level < 250) {
      return ([
        "action": msg[random(sizeof(msg))],
        "damage": damage * random(10),
        "damage_type": "震伤"

      ]);
    }
    if (level > 250) {
      return ([
        "action": msg[random(sizeof(msg))],
        "damage": damage * random(30),
        "damage_type": "内伤"

      ]);
    }
  }
  for (i = sizeof(action); i > 0; i--) {
    if (level > action[i - 1]["lvl"]) {
      j = random(sizeof(action));
      target = offensive_target(me);
      if (level > 50) {
        return ([
          "action": action[j]["action"],
          "force": action[j]["force"],
          "damage": damage,
          "damage_type": action[j]["damage_type"],
          "weapon": "掌缘"
        ]);
      }
      return action[j];
    }
  }
}

string query_skill_name(int level) {
  int i;
  i = sizeof(action);

  while (i--)
    if (level > action[i]["lvl"])
      return action[i]["skill_name"];
}

int valid_learn(object me) {

  if ((int)me->query_skill("literate", 1) < 100)
    return notify_fail("对书法领悟不够焉能体会「倚天屠龙功」的博大精深？\n");
  if ((int)me->query_skill("strike", 1) < 100)
    return notify_fail("基本掌法尚未纯熟,怎可学习上乘武功？\n");
  if ((int)me->query_skill("yinyun-ziqi", 1) < 120)
    return notify_fail("你的氤氲紫气功夫太浅.\n");
  if ((int)me->query_skill("taiji-quan", 1) < 130)
    return notify_fail("先将太极拳练成方可体会「倚天屠龙功」的博大奇妙.\n");
  if ((int)me->query_skill("taiji-jian", 1) < 130)
    return notify_fail("先将太极剑练成方可体会「倚天屠龙功」的博大奇妙.\n");
  return 1;
}


int practice_skill(object me) {
  if ((int)me->query("jingli") < 40)
    return notify_fail("你的体力不足以练习「倚天屠龙功」。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不足以练习「倚天屠龙功」。\n");
  me->add("jingli", -10);
  me->add("neili", -10);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "yitian-tulong/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  object wp1;
  string msg;
  int level, neili, neili1;
  wp1 = victim->query_temp("weapon");
  level = me->query_skill("yitian-tulong", 1);
  neili = me->query("neili");
  neili1 = victim->query("neili");
  if (!wp1) return 1;
  if (me->query_temp("yttl-break")) {
    me->delete_temp("yttl-break");
    return 1;
  }
  if (level > victim->query_skill("parry", 1) / 2
    && me->query("combat_exp") > victim->query("combat_exp") / 3
    && me->query_skill_mapped("parry") == "yitian-tulong"
    && me->query_skill("yinyun-ziqi", 1) > 50
    && neili > 300 && level > 100 && living(me)
    && !victim->query("env/invisibility")) {
    if (random(30) > 15) me->add_temp("yttl-break", 1);
    if (objectp(wp1)) msg = CYN "$N长啸三声,身形流转,双手无可捉摸的在$n的" + wp1->name() + "上一搭" NOR;
    if (neili > neili1 / 2 && random(10) > 4) {
      msg += CYN "只听啪啪啪三声,$n手中的" + wp1->name() + "已经被震为数节！\n" NOR,
        message_vision(msg, me, victim);
      wp1->unequip();
      wp1->move(environment(victim));
      wp1->set("long", wp1->query("long") + CYN "但是已经被倚天屠龙功震为数节!\n" NOR);
      wp1->set("name", "震 为 数 节 的" + wp1->query("name"));
      wp1->set("value", 49);
      wp1->set("weapon_prop", 0);
    } else {
      msg += CYN "$n见状急忙收招,狼狈不堪!\n" NOR,
        message_vision(msg, me, victim);
    }

  }
}
