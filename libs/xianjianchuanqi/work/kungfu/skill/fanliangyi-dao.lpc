// fanliangyi-dao.c 反两仪刀

#include <ansi.h>
#include <power_control.h>
inherit SKILL;

string *msg = ({"$N揉身而上至“随”位，刀交左手反劈「日月晦明」，幻起无数刀光狂削，令$n看不清来势！",
"$N反踏两仪方位满场游走，一招「万劫不复」连划数弧，$w激起刺骨寒风，将$n裹入刀气的旋涡中！",
"$N使出「无色无相」旋身到“归妹”，左掌劲气弥漫直拍而出，右手$w却无声无息挥至$n的$l！",
"$N身形闪动抢达“明夷”，$w一式「太乙生萌」，凌历无俦地对准$n的$l劈砍下去！",
"$N向前跨上一步，稳据“无妄”使出「两仪合德」，挥动$w向$n左右闪电般连斩两刀！",
"$N拧身急转施展「混沌一破」，猛然挥刀从背后反划了个弧形，弯弯曲曲地斩向$n$l！",
});


int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

int valid_learn(object me)
{
        if ((int)me->query("max_neili") < 50)
                return notify_fail("你的内力不够。\n");
        if ((int)me->query_skill("zixia-gong", 1) < 10)
                return notify_fail("你的紫霞神功火候太浅。\n");
        return 1;
}

mapping query_action(object me, object weapon)
{  
      int level;
          string a_msg;
        level = (int)me->query_skill("fanliangyi-dao",1);
         a_msg=msg[random(sizeof(msg))] ;
        if( random(level) > level - level/6 )
                a_msg=select_color() + a_msg + NOR;
        return (["damage_type":random(2)?"劈伤":"割伤","action":a_msg ])
                + query_my_power(me,level,at_type_hand,attack_lvl_middle,defense_lvl_middle);

}

int practice_skill(object me)
{
        object weapon;

        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "blade")
                return notify_fail("你使用的武器不对。\n");
        if ((int)me->query("jingli") < 50)
                return notify_fail("你的精力不够练反两仪刀。\n");
        me->receive_damage("jingli", 25);
        return 1;
}
string perform_action_file(string action)
{
               return __DIR__"fanliangyi-dao/" + action;
}
