// taizu-quan 太祖长拳
#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *msg = ({
"$N一式「千里横行」，双臂直上直下，猛攻而前，打向$n的$l",
"$N上身前倾，右拳直出呼的一声打向$n，正是一招「冲阵斩将」",
"$N使招「河朔立威」，右手向上一扬，左手握拳打向$n",
"$N双拳呼呼打出，连接三遍，正和「击鼓三通」之意",
"$N跳起往左旋身一转，左脚落地后双拳齐出，捣向$n的$l，「扬马立威」",
});
int valid_enable(string usage) { return usage=="cuff" || usage=="parry"; }
int valid_learn(object me)
{
       if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
               return notify_fail("练太祖长拳必须空手。\n");
      
       if ((int)me->query("max_neili") < 100)
               return notify_fail("你的内力太弱，无法练功。\n");
       return 1;
}

mapping query_action(object me, object weapon) {
        return (["damage_type":random(2)?"内伤":"瘀伤","action":msg[random(sizeof(msg))] ])
                + query_my_power(me,(int)me->query_skill("taizu-quan",1),at_type_hand,attack_lvl_normal,defense_lvl_normal);
}

int practice_skill(object me)
{
       if ((int)me->query("jingli") < 30)
               return notify_fail("你的体力太低了。\n");
       if ((int)me->query("neili") < 20)
               return notify_fail("你的内力不够练太祖长拳。\n");
       me->receive_damage("jingli", 30);
       me->add("neili", -10);
       return 1;
}

