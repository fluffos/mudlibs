// diyu.c
#include <ansi.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target)
{
            int lvl;
        string msg;
    lvl = ( (int)me->query_skill("yizhi-chan", 1) + (int)me->query_skill("yizhi-chan", 1) ) /4;
        if( !target ) target = offensive_target(me);
        if( !target || !me->is_fighting(target) )
               return notify_fail("「我入地狱」只能在战斗中对对手使用。\n");
        if( objectp(me->query_temp("weapon")) )
               return notify_fail("你不能用兵器使出「我入地狱」！\n");
       if( (int)me->query_skill("yizhi-chan", 1) < 150 )
            return notify_fail("你的一指禅还不够娴熟，不会使用「我入地狱」。\n");
         if( (int)me->query_skill("yijin-jing", 1) < 150 )
              return notify_fail("你的易筋经等级不够，不能使用「我入地狱」。\n");
       if( (int)me->query_skill("finger", 1) < 150 )
              return notify_fail("你的基本指法等级不够，不能使用「我入地狱」。\n");
        if (me->query_skill_prepared("finger") != "yizhi-chan"      
        || me->query_skill_mapped("finger") != "yizhi-chan")
               return notify_fail("你现在无法使用「我入地狱」进行攻击。\n");
        if( (int)me->query("neili") < 1000 )
               return notify_fail("你现在内力也太弱了吧。\n");
msg = HIM "$N忽然高宣法号，朗声说到“佛曰：我不入地狱谁入地狱”，声音震耳欲聋。\n"+HIR"话音未落，$N身随心动，指尖竟然哧哧作响，刹那间，四周都是$N的身影。\n"NOR;
        message_vision(msg, me, target);
     me->add_temp("apply/strength", lvl);
    me->add_temp("apply/attack", lvl); 
            COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
          COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
          COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
          COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
          COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
    me->add_temp("apply/attack", -lvl); 
      me->add_temp("apply/strength", -lvl);
           me->add("neili", -650); 
            me->start_busy(4+random(4));
         return 1;
}
