// sixiang-zhang.c -四象掌
//yun_control
#include <ansi.h>
#include <power_control.h>
#include <combat.h>
inherit SKILL;
string *msg = ({
  "$N向$n遥遥一鞠，一式「三阳开泰」，双掌大开大阖，挡开$n的进击！",
  "紧跟着$N面含微笑，一式「五气呈祥」，双掌云缠雾绕，同时攻向$n全身各处！",
  "$N划身错步，一式「逆流捧沙」，双掌内拢外托，攻向$n的左肩！",
  "$N一式「雷洞霹雳」，双掌以迅雷不及掩耳之势，劈向$n的两额太阳穴！",
  "$N使一式「摘星换斗」，劲气弥漫，双掌如轮，一环环向$n的后背斫去",
  "$N一式「梵心降魔」，双掌似让非让，似顶非顶，气浪如急流般使$n陷身其中！",
});

int valid_enable(string usage) { return usage == "strike" || usage == "parry"; }
int valid_combine(string combo) { return combo == "jieshou-jiushi"; }
int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练四象掌必须空手。\n");
  if ((int)me->query_skill("linji-zhuang", 1) < 20)
    return notify_fail("你的临济十二庄火候不够，无法学习四象掌。\n");
  if ((int)me->query("max_neili") < 150)
    return notify_fail("你的内力太弱，无法练四象掌。\n");
  return 1;
}

mapping query_action(object me) {
  int level, at_type;
  string a_msg;
  a_msg = msg[random(sizeof(msg))];
  at_type = attack_lvl_normal;
  level = (int)me->query_skill("sixiang-zhang", 1);
  if (random(level) > level - level / 6 && level > 120) {
    a_msg = select_color() + a_msg + NOR;
    at_type = attack_lvl_high;
  }
  if (random(level) > level - level / 8 && level > 120)
    call_out("start_foguang", 1, me);
  return ([
    "damage_type": random(2) ? "内伤" : "瘀伤",
    "action": a_msg
  ]) + query_my_power(me, level, at_type_hand, at_type, defense_lvl_normal);
}

int practice_skill(object me) {
  if ((int)me->query("jingli") < 30)
    return notify_fail("你的精力太低了。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练四象掌。\n");
  me->receive_damage("jingli", 15 + random(10));
  me->add("neili", -5 - random(5));
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "sixiang-zhang/" + action;
}

void start_foguang(object me) {
  object target;
  string msg;
  int i;
  if (!me || !living(me))
    return;
  target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target) || !living(target))
    return;
  msg = HIY "霎时间,日丽风静，云海平铺，美丽以极。阳光从$N背面斜射下来，形成彩色光环\n$N见到自己的身影清晰地出现在银色世界上。" HIC "『光环随人动，人影在环中』" HIY "\n使出了" HIW "四象掌绝学" HIY "『金顶佛光』" NOR;
  i = target->query_con() * 2;
  me->add_temp("apply/attack", i);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_RIPOSTE, msg);
  me->add_temp("apply/attack", -i);
  return;
}
