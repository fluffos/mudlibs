// yuenv-jian.c 越女剑法
#include <ansi.h>
#include <power_control.h>
inherit SKILL;

string *dodge_msg = ({
"$n施展“蜻蜒三掠水”的功夫，刷刷刷，三伏三起，离箭脱弦般飞冲出去。\n",
"$n急使个“白鹤冲天”之势，拔身一耸，跳起三丈多高，躲过$N。\n",
"$n身躯霍地一翻，便轻如燕子地翻到$N背后,待$N猛地旋转过来,$n以避开\n",
"$n身形一旋，“倒踩七星”，身似飘风，“巧步旋身”，连人带剑，倏地转到$N背后。\n",
"$n大吃一惊，急用“大弯腰，斜插柳”之势，往下一杀腰，贴地拧身，闪开了$N的招数。\n",
"$n救招不及，急极力斜身绕步，直抢出好几尺外，才躲过$N这一招，。\n",
"$n把身一躬，身移步换，迅如旋风，电光石火般地躲了过去。\n",
"$n更不迟疑，随手把剑一转，“夜战八方”，荡开了$N的攻势，反手一剑，逼迫$N回身自救。\n",
"$n疾如飘风，身形展开，严如神鹰盘旋，龙蛇疾走，从$N头顶飞跃而过，。\n",
});

string  *msg1 = ({
"$N剑身随进时，越至半空,$n竟在身子悬空之际，使出了一手“回风扫柳”的剑招，$w舞起一圈清光，罩向$n",
"$N使出越女剑精奇招数，腾、挪、闪、展、撩、挡、扎、刺、劈、抹、沉、掳，剑光如虹，沙飞石舞。
猛觑准$n，突地“推刀上步”，剑招如电，轻轻一点，直点$n的穴道",
"$N一剑刺去，柔如柳絮，翩若惊鸿，飒飒连声，浑身上下，闪起几道精光冷电，逼得$n亮眼花缭乱",
"$N身形一晃，略走边锋，“龙女穿针”，剑光绕处,刷的便奔$n$l刺来，$N这招虚中套实，\n实中套虚，端的利害",
"$N一声轻笑，$w闪闪吐寒光，扁剑身，扬剑尖，剑光霍霍中,已将$n退路封死",
"$N不顾生死，竟蓦地“翻身献剑”，疾如飘风似的，$w一闪，“乌龙入洞”，嗖地直撩$n的$l进去",
"$N随手递出一剑，只见$w倏上，倏下，忽左忽右，便见浑身上下，卷起了一片剑光，缤纷飞舞,卷向$n",
"$N疾如飘风，身形转换，方位立变，$N竟如惊鸿掠燕似的，绕到$n背后，刷的一剑，就朝$n后心擞来",
"$N身随剑走，剑随身转，剑招倏变，“龙形飞步”，直如鹰隼穿林，直取$n的$l",
});
string  *msg2 = ({
"突然$N身形一变，$N手中$w如影随形，跟踪直上，运剑如风，一连几手辣招，如暴风骤雨地向$n袭来“",
"$N拿捏时候，听风辨器，容$n距离将到未到之际，$N猛地“怪蟒翻身”，\n$w电掣般地直转过来，骤地用足力量，往$n的$l上突刺",
"$N左拳已砰的一声击出，跟着用“白蛇出洞”之式，剑身随进，但见青光一闪，$N手中$w已到了$n$l",
"$N这一剑平胸刺出，将到未到之际，剑尖陡地一翻，划了半个弧形，变成横卷之势，\n名为“暴卷天河”，变化奇幻，当真是凌厉之极！",
"只见那$N凌空飞下，挽了一个剑花，剑光四射，就如同千万点寒星，当头洒下。",
"$N身子忽然向后一化，$w一撤，突然，$N身形疾起，剑光如虹，又是凌空往下刺$n！",
"$n眼前白光一闪，$N又是刷的一剑刺来，剑尖刚刚画了半道圆弧,突然，嗖嗖嗖连劈三剑，\n果然使出一招三式的化剑为刀！",
"$N用“风台落花”之式，一飘一闪，将$n的攻势化为乌有，反手一剑，如电光石火，\n但见剑光过处，$w直指$n$l，$n脸色大变。",
});

string  *msg0 = ({
"$N一招「白露横江」，$w向$n刺去，接着手腕一翻，反手向$n的$l横削过去。",
"$N一招「电照长空」，凌空越起，身剑合一，如闪电一般向下疾刺而去。",
"$N一招「枝击白猿」,$N跃身半空连挽两个剑平花，然后回剑下击$n。",
"$N右足曲为前弓，左手捏着剑诀，右手平膀顺肘，横剑向$n急推，正是「十万横磨」之势。",
"$N左膝一低，曲肘竖肱，一招「起凤腾蛟」，刷的一声，剑尖猛撩上来。",
"$N见$n攻到面前到，右足反而绕前避过，「探海斩蛟」，回锋下插，径攻$n下盘。",
"$N下盘不动，上盘不避，就是将腰向左一挪，斗然移开半尺，右手送出，一式「越女投梭」一剑刺向$n胸口。",
"$N左足一点，剑走轻灵，一招「凤点头」，疾往$n左胁虚刺，跟着身子微侧，\n剑尖光芒闪动，直取敌目，又狠又准，的是“越女剑法”中的精微招数。",
});


int valid_enable(string usage) 
{ 
    return usage == "sword" || usage == "dodge" || usage == "parry"; 
}

mapping query_action(object me, object weapon)
{
    int level;
        level   = (int) me->query_skill("yuenv-jian",1);
        weapon = me->query_temp("weapon");
         if( level > 299 && weapon->query("id") == "zhu jian")
        {
                return([      
                 "action": HIG+(msg1+msg2)[random(sizeof(msg1+msg2))]+NOR,             
                 "damage_type":random(2)?"刺伤":"割伤",
                   ])+
    query_my_power(me,level,at_type_weapon,attack_lvl_superhigh,defense_lvl_super);
    }        
     if (random(level) > 150 && level>250 && me->query("max_neili") > 2000)
         {
            return([      
                   "action": HIG+msg2[random(sizeof(msg2))]+NOR,             
                 "damage_type":random(2)?"刺伤":"割伤",
                   ])+
    query_my_power(me,level,at_type_weapon,attack_lvl_high,defense_lvl_middle);
            }
        if (random(level)> 100 &&  level>199 && me->query("max_neili") > 2800)
        {
            return([      
                  "action": HIG+msg1[random(sizeof(msg1))]+NOR,             
                   "damage_type":random(2)?"刺伤":"割伤",
                   ])+
query_my_power(me,level,at_type_hand,attack_lvl_high,defense_lvl_normal);
            }
           return([      
                  "action": msg0[random(sizeof(msg0))]+NOR,             
                   "damage_type":random(2)?"刺伤":"割伤",
                   ])+
           query_my_power(me,level,at_type_hand,attack_lvl_middle,defense_lvl_normal);
}

string query_dodge_msg()
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

string query_parry_msg()
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

int valid_learn(object me)
{
if (me->query("gender") == "无性")
        return notify_fail("越女剑法不适合你学习。\n");
        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"yuenv-jian/" + action;
}


int practice_skill(object me)
{
        object weapon;
                if (me->query("gender") == "无性")
        return notify_fail("越女剑法你无法进行修炼。\n");
    weapon = me->query_temp("weapon");
      if (!objectp(weapon) 
        || (string)weapon->query("skill_type") != "sword")
                return notify_fail("你使用的武器不对。\n");
        if ((int)me->query("jingli") < 70)
                return notify_fail("你的精力不够。\n");
        if (me->query_skill("yuenv-jian",1) > 200) 
                        return notify_fail("你练着练着，好象没有多大长进，看来只好另想它法了。\n");
        me->receive_damage("jingli", 60);
        return 1;
}
int double_attack(object me)
{       
    int level;
    level=me->query_skill("cuogu-shou",1);
   if ( me->query_skill("yuenv-jian", 1) >= 220
     && me->query_skill_mapped("sword") == "yuenv-jian"
     && (random(level) > level - level/6) )
             return 1;
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        object weapon;
        weapon = me->query_temp("weapon");
    if( me->query_skill("yuenv-jian",1) < 300 && weapon->query("id") != "zhu jian")
        return 0;
    if(random(me->query_skill("yuenv-jian", 1)) > 150
       && (random(me->query("neili")) > victim->query("neili")))
           {
 message_vision(HIG"只见$N手中青竹剑碧影一闪，$n眼前一花，$n只觉一股凌厉的剑气扑面而至！\n"NOR, me, victim);
       victim->start_busy(2);
victim->receive_wound("qi", me->query_skill("sword",1)/10+damage_bonus/4 , me);
        }   
}

