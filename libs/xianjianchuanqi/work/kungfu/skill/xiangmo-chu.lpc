// /kungfu/skill/xiangmo-chu 金刚降魔杵
#include <ansi.h>
#include <power_control.h>
inherit SKILL;

string *msg = ({
"$N高举$w，一招「魔幻虚影」，狠狠的向$n的$l砸去。",
"$N全身拔地而起，半空中一个筋斗，一式「降魔」, 手中$w扫向$n的$l。",
"$N手中$w舞动，一招［力撼九天］挟着震天的撞击之声，猛砸$n的$l。",
"$N一招「御风而行」，手中$w呼呼有声的砸向$n。",
"$N横过手中$w，使出「杖掠横空」，手中$w劈空而下，击向$n$l。",
});
int valid_enable(string usage) { return (usage == "staff") || (usage == "parry"); }
int valid_learn(object me)
{
       object weapon;
       if((int)me->query_skill("mingwang-jian",1) <100)
           return notify_fail("你的不动明王剑法火候不够。\n");
       if( (int)me->query("max_neili") < 1500 )
               return notify_fail("你的内力不足，没有办法练金刚降魔杵。\n");
       if ((int)me->query_skill("longxiang-gong", 1) < 100)
               return notify_fail("金刚降魔杵需要有五层以上的龙象般若功方可练习。\n");
       if ( !objectp(weapon = me->query_temp("weapon"))
                   || ( string)weapon->query("skill_type") != "staff" )
               return notify_fail("你的武器不对。\n");
       return 1;
}

mapping query_action(object me, object weapon)
{
        int level;
         string a_msg;
       level = (int)me->query_skill("xiangmo-chu",1);
       a_msg = msg[random(sizeof(msg))];
        if( random(level) > level - level/10  )
                a_msg=HIY + a_msg + NOR;
        return (["damage_type":random(2)?"瘀伤":"砸伤","action":a_msg ])
                + query_my_power(me,level,at_type_weapon,attack_lvl_high,defense_lvl_normal);
}

int practice_skill(object me)
{
        object weapon;
        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "staff")
                return notify_fail("你手上的武器不能用来金刚降魔杵。\n");
        if ((int)me->query("jingli") < 50)
         return notify_fail("你先歇口气再练吧。\n");
        if ((int)me->query("neili") < 30)
                return notify_fail("你先歇口气再练吧。\n");
        me->receive_damage("jingli", 40);
         me->add("neili", -20); 
        return 1;
}
string perform_action_file(string action)
{
  return __DIR__"xiangmo-chu/" + action;
}

