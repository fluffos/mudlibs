// xiangfu-lun.c 降伏轮法
// by iceland

inherit SKILL;

mapping *action = ({
([      "action" : "$N力贯双臂，使一招「破竹势」，抡得手中的$w哗楞楞乱响，向$n的$l砸去。\n",
