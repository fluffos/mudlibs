        "force" : 160,
        "dodge" : 0,
        "parry" : 10,
        "lvl" : 0,
        "damage" : 50,
        "damage_type" : "挫伤",
]),
([      "action" : "$N抢前几步，使一招「隐山谷势」，双肩一沉，舞动手中$w向$n的$l横扫。\n",
        "skill_name" : "隐山谷势",
        "force" : 200,
        "dodge" : 0,
        "parry" : 20,
        "lvl" : 8,
        "damage" : 55,
        "damage_type" : "挫伤",
]),
([      "action" : "$N使一招「隐微势」，就地一滚，手中自下而上撩向$n的$l，同时双腿接连踢向$n下盘。\n",
        "skill_name" : "隐微势",
        "force" : 250,
        "dodge" : 0,
        "parry" : 10,
        "lvl" : 16,
        "damage" : 60,
        "damage_type" : "挫伤",
]),
([      "action" : "$N大跨步抢到$n身后，使一招「擒纵势」，更不回头，身形起伏之际反手$w扫向$n的$l。\n",
        "skill_name" : "擒纵势",
        "force" : 280,
        "dodge" : 5,
        "parry" : 15,
        "lvl" : 24,
        "damage" : 65,
        "damage_type" : "挫伤",
]),
([      "action" : "$N使一招「圆满势」，$w脱手急旋而出，在空中划了个弧线，如离弦之箭般直捣$n的$l。\n",
        "skill_name" : "圆满势",
        "force" : 320,
        "dodge" : 10,
        "parry" : 10,
        "lvl" : 32,
        "damage" : 70,
        "damage_type" : "挫伤",
]),
([      "action" : "$N跃入半空，$w一摆，使一招「月重辉势」，连人带$w直扑入$n怀中，$w敲向$n的$l。\n",
        "skill_name" : "月重辉势",
        "force" : 360,
        "dodge" : 15,
        "parry" : 10,
        "lvl" : 40,
        "damage" : 85,
        "damage_type" : "挫伤",
]),
([      "action" : "$N面色凝重，提一口真气，使出「显吉祥」，或拳或掌，或推或击，拨动得$w循环往复，追向$n。\n",
        "skill_name" : "显吉祥",
        "force" : 400,
        "dodge" : 20,
        "parry" : 15,
        "lvl" : 56,
        "damage" : 100,
        "damage_type" : "挫伤",
]),
});


int valid_enable(string usage) { return usage == "hammer" || usage == "parry"; }

int valid_learn(object me)
{
	if ((int)me->query("max_neili") < 1000)
		return notify_fail("你的内力修为不够，不能练日月轮。\n");
	if ((int)me->query_skill("longxiang-banruo", 1) < 101)
		return notify_fail("你的龙象般若功火候太浅，不能练龙象般若功。\n");
	return 1;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
       int i, level;
	level   = (int) me->query_skill("xiangfu-lun",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "hammer")
		return notify_fail("你使用的武器不对。\n");
	if ((int)me->query("jingli") < 50)
		return notify_fail("你的体力不够,练不了降伏轮法。\n");
	me->receive_damage("jingli", 30);
	return 1;
}
