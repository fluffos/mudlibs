//  nanshan-zhang.c 南山掌法 
#include <ansi.h>
#include <power_control.h>
#include <combat.h>
inherit SKILL;
string *msg1 = ({
"$N一招「起手式」，左掌抚右拳，身形一长，向$n身前推去，乃时见面的礼数。",
"$N立稳了脚步，一转身，一式「掌持风雷」,掌力有如排山倒海般地向$n的$l直攻过去。",
"$N一式「南山疾风」手掌划了一道圆弧，纵身越起，居高临下，一掌便向$n头顶拍来",
"$N一招「弯弓射雕」，左拳右掌，一前一后，朝着$n的$l之处打去，",
 "$N攻势凌厉，毫不容情，突然间双掌「深入虎穴」猛向$n的$l打到,出招狠辣，沉猛之极",
 "$N一招「铁牛耕地」，掌锋向$n截将下来。$n正要收式变招，$N突然左手倏出，拍向$n胸前。",
 "$N随即运气，双手合围，双手突然缩回，抵在胸前，一招「双掌移山」，向$n的$l猛推出去。",
"$N当即运劲出拳，往$n猛击过去,突然扬声吐气，嘿的一声，「排云见日」化拳为掌击去。",
});
string * msg0=({
"$N大喝一声，”格啦“一声骨骼爆响，右腿略挫，左掌虚晃，呼的一声，右拳猛击而出，劲雄势急！",
"$N吸一口气，将$N的内劲全运在双掌之上，夹着一股冷冷而凌厉的疾风，直扑$n的胸口。",
"$N全身骨骼轻轻作响。运劲于拳，深深吸了口气，轻飘飘地一拳，无声无息地向$n$l打去。",
"$N突然拳掌并用，变化无方，连下杀手，酣斗中蓦地飞出一掌，猛向$n劈去，去势奇特，迅捷异常，",
});
int valid_enable(string usage) { return usage=="strike" ||  usage=="parry"; }
int valid_learn(object me)
{
        if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
                return notify_fail("练南山掌法必须空手。\n");
        if (me->query_skill_mapped("force") != "mingyun-qingqi")
                return notify_fail("你的冥云清气火候不够，无法学习南山掌法。\n");
        if ((int)me->query_skill("mingyun-qingqi", 1) < 20)
                return notify_fail("你的冥云清气火候不够，无法练南山掌法。\n");
        if ((int)me->query("max_neili") < 100)
                return notify_fail("你的内力太弱，无法练南山掌法。\n");
        return 1;
}

mapping query_action(object me, object weapon)
{
        int level,level1;
        string msg;
    level   = (int) me->query_skill("nanshan-zhang",1);
        level1 =(int) me->query_skill("cuff",1);
        if (level>210 && random(level1)>160 && me->query("neili")>1501)
                {
                msg=msg0[random(sizeof(msg0))] ;
                        return (["damage_type":random(2)?"内伤":"瘀伤","action": WHT+msg+NOR ])
                + query_my_power(me,level,at_type_hand,attack_lvl_super,defense_lvl_normal);
                }
                msg=msg1[random(sizeof(msg1))] ;
                return (["damage_type":random(2)?"震伤":"瘀伤","action": msg ])
                + query_my_power(me,level,at_type_hand,attack_lvl_middle,defense_lvl_middle);             
}
int practice_skill(object me)
{
        if ((int)me->query("jingli") < 80)
                return notify_fail("你的体力太低了。\n");
        if ((int)me->query("neili") < 80)
                return notify_fail("你的内力不够练南山掌法。\n");
        if(me->query_skill("nanshan-zhang",1)<200){
                me->receive_damage("jingli", 20);
        me->add("neili", -20);
                }
                else{
                        if((me->query_skill("nanshan-zhang",1) - me->query_skill("nanshan-daofa",1))>10)
                                return notify_fail("你的南山刀法火候未到，练下去可能毫无长进。\n");
                        me->receive_damage("jingli", 40);
                        me->add("neili", -40);
                }
        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"nanshan-zhang/" + action;
}
int ob_hit(object ob, object me, int damage)
{
        object wp1;
         string msg;
        wp1 = ob->query_temp("weapon");
      if(me->query("neili")>1200 && me->query_skill("parry",1)>200
         && me->query_skill_mapped("force") == "mingyun-qingqi"
         && (random(me->query("combat_exp") )>random(ob->query("combat_exp")))
     && (me->query("con")<20)&&(!wp1)&& !ob->query("env/invisibility"))
                 {
                 msg=HIM"$N既已闪架不及，当下运气于全身，猛喝一声：“好！”硬接了$n这一招\n"NOR;
                  msg += "结果$n的力道被卸在大半！\n";
                   message_vision(msg, me, ob);
       return -damage/2;
       }
}
mixed hit_ob(object me, object victim, int damage_bonus)
{                
   object weapon,ob;  
    int level;
    level=me->query_skill("nanshan-zhang",1);
    if( damage_bonus < 1 ) return 0;
          if(objectp(ob = present("blade", me))
   &&(me->query_skill("nanshan-zhang",1)>210) && !me->query_temp("pfm_bizhen")
          && me->query_skill_mapped("force") == "mingyun-qingqi"
          && me->query_skill_mapped("dodge") == "yunlong-shenfa"
 //     && (random(level) > level - level/)
          ){
        message_vision("紧跟着，$N“刷”地抽出一把"+ob->query("name")+"来！", me, victim);
        ob->wield();
        weapon= me->query_temp("weapon");
        COMBAT_D->do_attack(me, victim, me->query_temp("weapon"), 1);  
        weapon->unequip();
        }
}

