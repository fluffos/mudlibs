int valid_enable(string usage) { return usage=="unarmed" || usage=="parry"; }

int valid_learn(object me)
{
	if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return notify_fail("练空明拳须空手。\n");
	if ((int)me->query_skill("tiangang-zhengqi", 1) < 20)
		return notify_fail("你的天罡正气火候不够，无法学空明拳。\n");
	if ((int)me->query("max_force") < 50)
		return notify_fail("你的内力太弱，无法练空明拳。\n");
	return 1;
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
        int i, level;
	level   = (int) me->query_skill("kongmingquan",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];
}

int practice_skill(object me)
{
	if ((int)me->query("kee") < 30)
		return notify_fail("你的体力太低了。\n");
	if ((int)me->query("force") < 20)
		return notify_fail("你的内力不够练空明拳。\n");
	me->receive_damage("kee", 25);
	me->add("force", -5);
	return 1;
}
string perform_action_file(string action)
{
	if ( this_player()->query_skill("kongmingquan", 1) >= 10 )
		return __DIR__"kongmingquan/chan" + action;
	if ( this_player()->query_skill("kongmingquan", 1) >= 80 )
		return __DIR__"kongmingquan/kongqianjuehou" + action;

}

