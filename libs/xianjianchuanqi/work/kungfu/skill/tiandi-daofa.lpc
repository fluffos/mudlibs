#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *msg = ({
  "$N突然一近身,向$n斜肩带背便劈了一刀，招数虽然简单,但狠辣异常",
  "$N将刀向前一递,身体带动刀身,以奇快的速度向前冲去,瞬间，刀已带着冷风逼向$n",
  "$N的身体一侧,以刀代剑,手臂前伸,平平的向$n刺去",
  "$N趁$n不注意,将刀交到左手,右掌一晃,左手刀早已挥出",
  "$N把刀用手臂挡住,使$n看不到自己如何出招,紧接着倒握刀把,向$n一推",
  "$N手一伸,以腕带刀,刀横着向$n削了过去",
  "$N向下一蹲,刀并不是向上挑出,而是由下向上劈出了一刀,$n听见金刃劈风之声,暗叫了一声'不好'",
  "$N大吼一声手中的刀越舞越快,眨眼间就变成一片耀眼的刀网,风雨不透",
  "$N运足了内力将刀向$n抛去,紧跟着身体也带着一阵风跟了上去,刀到人到",
  "$N向下一矮,身体向前一抢,刀随人走,自上而下,侧身向上一挑,轻巧至极",
  "$n只觉得眼前一花,$N已绕到了$n的背后,头也不回,反手就是一刀,当真电光火石",
  RED "$N突然腾空而起,身在后,刀在前,全身化作一道流星,迅捷无比的自上而下劈向$n，$n只觉得周身都笼罩在$N的刀光之下无处可藏" NOR,
});

int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

int valid_learn(object me) {
  if ((int)me->query("max_neili") < 50)
    return notify_fail("你的内力不够练习天地刀法。\n");
  return 1;
}
mapping query_action(object me, object weapon) {
  int level, at_lvl;
  string a_msg;
  level = (int)me->query_skill("tiandi-daofa", 1);
  a_msg = msg[random(sizeof(msg))];
  if (random(level) > level / 4) {
    a_msg = select_color() + a_msg + NOR;
  }
  return ([
    "damage_type": random(2) ? "刺伤" : "割伤",
    "action": a_msg
  ]) + query_my_power(me, level, at_type_weapon, attack_lvl_super, defense_lvl_high);
}
int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("jingli") < 20)
    return notify_fail("你的体力不够练天地刀法。\n");
  me->receive_damage("jingli", 20);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "tiandi-daofa/" + action;
}
