// yuanyang-tui.c 鸳鸯连环腿 全真武功
#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *msg = ({
"$N纵身向前，忽然伸出左腿，一式「退马势」，直踢$n的头部",
"$N右足独立，左足随身形反转横扫，又左足立定，右足横扫向前，一招「似左忽右」，踢向$n的$l",
"$N左腿踢出，不待左腿落下，右脚紧跟着凌空踢出，一式「风扫落叶」，双脚先后踢向$n的$l",
"$N使一式「登云步月」，拔地而起，双腿连续踢出，击向$n的胸口",
"$N使一式「雷霆天下」，身体凌空而起，双腿连环，只见漫天腿影笼罩着$n",
"$N突然一个后翻，已从$n身边掠过，右足反踢，正是一招「倒挂金钩」，向$n的$l踢去",
"$N前腿踢出，后腿脚尖点地，一式「横空出世」，二掌直出，攻向$n的上中下三路",
"$N左腿微曲，右腿抬起，然后以$n为中心，飞速旋转，一式「狂风暴雨」如千万条彩虹飞扫而出",
"$N身子疾转，右脚贴地伸出，一式「天山飞渡」，横扫$n的下盘，刚中有柔，阳劲蕴蓄阴劲，著实厉害",
"$N身形一闪，单足一点地，一式「七星聚会」，在空中连踢七脚，直奔$n的头、胸、臂的七处穴道",
});

int valid_enable(string usage) { return usage=="leg" ||  usage=="parry"; }

int valid_combine(string combo) { return combo=="sanhua-juding"; }

int valid_learn(object me)
{
        if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
                return notify_fail("练鸳鸯连环腿必须空手。\n");
        if ((int)me->query_skill("quanzhen-xinfa", 1) < 20)
                return notify_fail("你的先天气功火候不够，无法学鸳鸯连环腿。\n");
        if ((int)me->query("max_neili") < 50)
                return notify_fail("你的内力太弱，无法练鸳鸯连环腿。\n");
        return 1;
}
mapping query_action(object me)
{
        int level,at_lvl;
         string a_msg;
         at_lvl=attack_lvl_normal;
        level = (int)me->query_skill("yuanyang-tui",1);
         a_msg=msg[random(sizeof(msg))] ;
        if( random(level) > level - level/10 )
        {
                a_msg= select_color() + a_msg + NOR ;
                at_lvl=attack_lvl_middle;
        }
        return (["damage_type":random(2)?"内伤":"瘀伤","action":a_msg ])
                + query_my_power(me,level,at_type_hand,at_lvl,defense_lvl_normal);
}


int practice_skill(object me)
{
        if ((int)me->query("jingli") < 60)
                return notify_fail("你的体力太低了。\n");
        if ((int)me->query("neili") < 10)
                return notify_fail("你的内力不够练鸳鸯连环腿。\n");
        me->receive_damage("jingli", 50);
        me->add("neili", -5);
        return 1;
}
