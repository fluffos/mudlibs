// zuimeng-quan.c
#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *msg = ({
"$N突然打了个哈气，一招「仙人渴盹」，伸了伸懒腰，突然间，双手直上直下，向$n猛挥过去",
"$N一招「罗汉斜卧」，身体猛地竖起，右手扶腮，宛如喝醉了一般，直挺挺地向$n倒了过去",
"$N突然“嘭”地一声，栽倒在地上，一动不动，待$n进前，突然一脚「鲤鱼翻身搅丝腿」，猛地向$n的$l踹去",
"$N脚步虚浮，身体摇摇晃晃，将欲跌倒，$N脚下一滑。一式「鲁智深醉跌」，向$n趴去。双掌按向$n$l",
"$N身体摇晃，欲倒未倒之即，一个不稳，跌跌撞撞迎向$n,一式「上步进肘掴身拳」已然出手",
"$N身影一晃，仰面朝天倒下，双手趴地，脚尖一点地，猛地越起，却是「踢腿撩阴十字拳」打向$n",
"$N身体一斜，手肘一沉，就施擒拿手抓$n手腕。$n急忙变招，手臂缩回，$N微微转身，钩起右腿，向后反踢。",
"$N脸上醉眼迷蒙，右手欲做喝酒状，身体一歪，左手确反身一拳打出，疾如流星，快如闪电",
"$N身体摇摇欲倒，身体向后倒去，忽地一脚钩腿反踢，来势变幻无方，直取$n的$l",
"$N突然如疯如癫，似醉似狂，双手摇晃，捉摸不定，“哈哈”一声大笑，$n只觉一股凌厉的劲风扑面而来",
"$N右手成掌，在$n脸前一扬，跟着左拳平出，直击其胸，$n横臂一封，$N这一拳忽地转弯，向$n$l打去",
"却见$N身形飘忽，错步转身，左回右旋，右手一晃，左手指节成虎爪之形，意传真气，按向$n的$l",
});

int valid_enable(string usage) { return usage=="cuff" ||  usage=="parry"; }

int valid_learn(object me)
{
        if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
                return notify_fail("空手方能练习醉梦罗汉拳 。\n");
        if ((int)me->query_skill("force", 1) < 120)
                return notify_fail("内功修为不够，无法修习醉梦罗汉拳 。。\n");
        if ((int)me->query("max_neili") < 1500)
                return notify_fail("你的内力太弱，无法学醉梦罗汉拳 。\n");
        if ((int)me->query_str() < 30 )
                return notify_fail("你没有雄壮的臂力无法学醉梦罗汉拳 。\n");
        if ((int)me->query_con() < 30 )
                return notify_fail("你没有雄厚的体质无法学醉梦罗汉拳 。\n");
        return 1;
      }

mapping query_action(object me, object weapon)
{
        int level;
        string a_msg;
        level = (int)me->query_skill("zuimeng-quan",1);
        a_msg=msg[random(sizeof(msg))] ;
        if( random(level) > level - level/6 )
                a_msg=select_color() + a_msg + NOR;
        return (["damage_type":random(2)?"内伤":"瘀伤","action":a_msg ])
                + query_my_power(me,level,at_type_hand,attack_lvl_high,defense_lvl_normal);
} 

int practice_skill(object me)
{
        if ((int)me->query("jingli") < 60)
                return notify_fail("你的体力太低了。\n");
        if ((int)me->query("neili") < 50)
                return notify_fail("你的内力不够练醉梦罗汉拳 。\n");
        me->receive_damage("jingli", 60);
if (me->query("drunk_apply"))
        {       me->add("neili", -10);
        }else{
        me->add("neili", -20);
        }
        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"zuimeng-quan/" + action;
}

