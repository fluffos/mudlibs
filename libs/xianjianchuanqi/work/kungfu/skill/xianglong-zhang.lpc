#include <ansi.h>
#include <power_control.h>
#include <combat.h>
inherit SKILL;
string *parry_msg = ({
        "$p不待回身，半招「神龙摆尾」，做势反劈。$P见这招势凶狠，不敢硬接，纵身避开。\n",
        "只见$p左掌圆劲，右掌直推，挡在身前。一招纯是防御，却是在双方之间布了一道坚壁。\n",
        "$p当下不敢怠慢，双掌当胸平推，将自己全身笼罩在掌力之下。守得稳若渊停岳峙，直无半点破绽。\n",
});
string query_parry_msg(object weapon, object victim) {
        if ( victim->query_temp("weapon") || victim->query_skill("xianglong-zhang", 1) < 100 || victim->query_skill_prepared("strike") != "xianglong-zhang" )
                return SKILL_D("parry")->query_parry_msg(weapon);
        else
                return parry_msg[random(sizeof(parry_msg))];
}

string *msg = ({
        "$N双腿微曲，双掌平平提到胸前，右臂划个圆圈，呼的一声，一招「亢龙有悔」拍向$n",
        "$N突然飞起半空，身形旋转，双掌居高临下一招「飞龙在天」直向身下的$n压去",
        "$N一招未完，一招又起，左掌回收，右掌向右一招「见龙在田」，迅捷无比地劈向$n的$l",
        "$N凝神闭气，双掌齐胸平推，施出这招「鸿渐于陆」，掌力夹带着隐隐风声推向$n",
        "$N右掌聚成拳状，格开$n手臂，接着左掌向前推一招「潜龙勿用」，掌力缓缓压向$n",
        "爆喝声中$N飞身上前，单掌劈出一招「利涉大川」，降龙掌掌风如刀，划向$n的$l",
        "$N双掌相并，身体突然前跃，使出「突如其来」这招，掌力排山倒海般向$n正面推出",
        "$N大吼一声，空门大开，双掌一上一下使出「震惊百里」，不顾一切地斩击$n",
        "$N跨前一步，一招「或跃在渊」，左右双掌向$n连连拍出，掌风更带起地上无数沙石",
        "$N身形向前移动，双掌分使两式「双龙取水」，凌厉的掌风一左一右同时压向$n$l",
        "$N左脚微曲，身形飞起，于半空中拍出「鱼跃于渊」，双掌立砍，齐向$n的$l劈下",
        "$N扎个马部，使出招「时乘六龙」，双掌一正一反向$n周身连连续续猛烈砍了十数下",
        "$N使出一招「密云不雨」，左掌掌力拍出，封住$n的退路，右掌斜斜地劈向他的$l",
        "$N弓步向前，一招「损则有孚」，双掌看似软绵绵地拍向$n，但地上的沙石却连连飞起",
        "$N脚下一转，突然欺身到$n身前，右掌护身，左掌一招「龙战于野」，猛然砍向$n的$l",
        "$N一声爆喝，胸前门户大开，双掌相并，齐向$n猛地推去，正是一招「履霜冰至」",
        "$N左掌低垂，右掌抬高，使出一招「羝羊触蕃」，两股雄浑的掌力同时向中间的$n挤压下去",
        "但见$N左掌护胸，身体后转，右掌紧跟着一摆，一招「神龙摆尾」拍向身后的$n",
//      YEL"$N一招「亢龙有悔」，平推出去。初推出去看似轻描淡写，但一遇阻力，刹时之间连加"+ chinese_number(random(19))+ YEL"道後劲，一道强似一道，重重叠叠，直至无坚不摧，无强不破"NOR,
});
int valid_enable(string usage) { return usage=="strike" ||  usage=="parry"; }
int valid_learn(object me) {
        if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
                return notify_fail("练降龙十八掌必须空手。\n");
        if ((int)me->query_skill("huntian-qigong", 1) < 100)
                return notify_fail("你的混天气功火候不够，无法练降龙十八掌。\n");
        if( me->query("gender") == "无性")
                return notify_fail("你一个不男不女之人怎能学习降龙掌？\n");
        if ((int)me->query("max_neili") < 1000)
                return notify_fail("你的内力太弱，无法学降龙十八掌。\n");
        if ((int)me->query_str() < 30 )
                return notify_fail("你没有雄壮的臂力无法学降龙十八掌。\n");
        if ((int)me->query_con() < 30)
                return notify_fail("你没有雄厚的体质无法学降龙十八掌。\n");
        return 1;
        }

mapping query_action(object me, object weapon) {
                int level;
                level = (int)me->query_skill("xianglong-zhang",1);
  if ( random(level) > level - level /8  &&  level > 170 &&me->query("family/family_name")=="丐帮") 
                call_out("start_xianglong",1,me);
 return (["damage_type":random(2)?"内伤":"瘀伤","action":msg[random(sizeof(msg))] ,"weapon":YEL"降龙掌掌力"NOR ])
 + query_my_power(me,(int)me->query_skill("xianglong-zhang",1),at_type_hand,me->query("gender")=="男性"?attack_lvl_super:attack_lvl_high,me->query("gender")=="男性"?defense_lvl_middle:defense_lvl_middle);

}

int practice_skill(object me) {
        int lvl = (int)me->query_skill("xianglong-zhang", 1);
        if ((int)me->query("jingli") < 100)
                return notify_fail("你的体力太低了。\n");
        if ((int)me->query("neili") < 40)
                return notify_fail("你的内力不够练降龙十八掌。\n");
        me->receive_damage("jingli", 60);
        me->receive_damage("neili", 20);
        if(lvl > 150)
                me->receive_damage("jingli", 10);
        if(lvl > 200) 
                me->receive_damage("neili", 10);
        return 1;}
string perform_action_file(string action) {
        return __DIR__"xianglong-zhang/" + action;}

int ob_hit(object ob, object me, int damage) {
        string msg;
    if(living(me) && random(me->query("combat_exp")) > ob->query("combat_exp")/3 &&  me->query_skill("xianglong-zhang", 1) >= 180 && random(10) > 7 ) {
                msg=HBBLU+HIC"只见$N右掌紧接着向后一摆，一招「神龙摆尾」出其不意地按在了$n的$l上！\n"NOR;
                me->add_temp("apply/attack", me->query_skill("xianglong-zhang", 1)/3);
                me->add_temp("apply/dexerity",me->query_skill("xianglong-zhang", 1));
        me->add_temp("apply/damage", me->query_skill("force",1));
                COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 1,msg);
        me->add_temp("apply/damage", -me->query_skill("force",1));
        me->add_temp("apply/dexerity", -me->query_skill("xianglong-zhang", 1));
                me->add_temp("apply/attack", -me->query_skill("xianglong-zhang", 1)/3);
       return -damage/2;
        }
        return 1;
}

void start_xianglong(object me)
{
        object target;
        string msg;
        int i;
        if (!me || !living(me))
                return ;
        target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) || !living(target))
        return ;
    msg=YEL"$N一招「亢龙有悔」，缓缓平推出去。初推出去看似轻描淡写，但一遇阻力，刹时之间连加"+ chinese_number(random(19))+ YEL"道後劲，一道强似一道，重重叠叠，直至无坚不摧，无强不破"NOR;
        i=target->query_con()*2;
        if( ((int)me->query("PKS",1)*25000/(int)me->query("combat_exp")) >1)
        i=i-10;
        if (me->query("shen")>1)
        i=i+10;
        if (me->query("gb_job")>400)
        i=i+random(18);
        me->add_temp("apply/attack", i);
    me->add_temp("apply/dexerity", i*2);
        me->add_temp("apply/damage", i);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_RIPOSTE,msg);
        me->add_temp("apply/damage", -i);
    me->add_temp("apply/dexerity", -i*2);
        me->add_temp("apply/attack", -i);
        return ;
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
   if( random((int)me->query_skill("parry",1)) > (int)victim->query_skill("dodge",1)/2 && random(6)>3 && (int)me->query_skill("strike",1) > 120 && (int)me->query("neili") > 100 ) 
        { victim->start_busy(random(4));
         message_vision(WHT"只见$N一声怒喝，$n的心中一震！被$N结结实实打个正着。\n"NOR, me, victim);        
        }
}

