// roar.c 佛门狮子吼

#include <ansi.h>

inherit F_CLEAN_UP;
void remove_effect(object me, int amount);

int exert(object me, object target) {
  object *ob;
  int i, skill, damage;

  if ((int)me->query("neili") < 2000)
    return notify_fail("你的内力不够。\n");

  if (environment(me)->query("no_fight"))
    return notify_fail("在这里不能攻击他人。\n");

  if ((int)me->query_skill("beiming-shengong", 1) < 200)
    return notify_fail("以你北冥神功的修为，还使不出「北冥捆仙索」。\n");
  if ((int)me->query_temp("beiming"))
    return notify_fail("你刚使过「北冥捆仙索」现在还无法再用。\n");
  skill = me->query_skill("beiming-shengong"); me->add("neili", -150);
  me->receive_damage("qi", 10);
  me->set_temp("beiming", 1);
  message_vision(
    HIY "$N轻笑一声，双手一绘，竟然聚气成丝，空气中部满了银白色的无形真力！！\n" NOR, me);

  ob = all_inventory(environment(me));
  for (i = 0; i < sizeof(ob); i++) {
    if (!living(ob[i]) || ob[i] == me) continue;
    if (skill / 2 + random(skill / 2) < (int)ob[i]->query("con") * 2) continue;

    damage = skill / 10;
    if (random(20) > 12) {
      ob[i]->start_busy(random(damage) + random(damage / 2));
      tell_object(ob[i], HIR "你见得那无数的细丝朝你围了过来，竟然将你捆了个结实！\n" NOR);
    } else {
      tell_object(ob[i], HIC "你大惊之下！向后一跳,躲开了这无数的真气!\n" NOR);
    }
    if (!me->is_killing(ob[i]->query("id"))) me->fight_ob(ob[i]);
    if (userp(ob[i])) ob[i]->fight_ob(me);
    else if (!ob[i]->is_killing(me->query("id"))) ob[i]->kill_ob(me);

  }
  me->start_call_out((: call_other, __FILE__, "remove_effect", me, 10 :), 10);
  return 1;
}

void remove_effect(object me, int amount) {
  me->delete_temp("beiming");
  tell_object(me, "你将内力调息完毕，又可以再用北冥捆仙索了。\n");
}
