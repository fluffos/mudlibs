//zhuihun.c  追魂四击
#include <ansi.h>
inherit F_DBASE;
inherit F_SSERVER;
#include "/kungfu/skill/eff_msg.h";

int perform(object me, object target)

{       
        object weapon;
        string msg;
        int damage, p, staff, dodge, parry, attack, busy_time;
        weapon = me->query_temp("weapon");
        if(!target) target = offensive_target(me);
        if(!target || !target->is_character()
           || !me->is_fighting(target) || !living(target) )
                return notify_fail("「追魂」只能在战斗中使用。\n");
        if( (int)me->query_str() < 50 ||
            (int)me->query_dex() < 40 ||
            (int)me->query_con() < 40 ||
            (int)me->query_int() < 40)
                return notify_fail("软弱无力的小鸡子也想用这么精深奥妙的绝技？\n");
 if(weapon->query("name")!="铁令")
return notify_fail("「追魂」只能装备铁令才能使出。\n");        
        if(me->query_skill("shenghuo-shengong", 1) <180)
                return notify_fail("你的圣火神功火候不足，还使不出「追魂」。\n");        

        if (me->query_skill_mapped("force") != "shenghuo-shengong")
                return notify_fail("你所使用的内功不对。\n");

        if (me->query_skill_mapped("parry") != "shenghuo-lingfa")
                return notify_fail("你所使用的招架不对。\n");

        if( (int)me->query("max_neili") < 1800 )
                return notify_fail("这么强的武技岂能是你这点儿内力修为就能用的！\n");

        if( (int)me->query("neili") < 1000 )
                return notify_fail("你的内力不够！\n");

         msg = HIB "\n$N突然收起手中武器，侧身一脚，狠狠踢向$n腰间。\n" NOR;
          if (random(me->query_skill("parry")) > target->query_skill("parry") / 4)
             {
                msg += HIR "这一脚正中$n的后腰，只听一声惨叫，$n被踢到半空！\n\n"NOR;  
                me->start_busy(2);
                target->start_busy(1); 
                damage = (int)me->query_skill("shenghuo-lingfa", 1);
                damage = (int)me->query_skill("shenghuo-shengong", 1) +damage;
                damage = damage + random(damage/2);
                target->receive_damage("qi", damage);
                target->receive_wound("qi", damage/2);      
                  p = (int)target->query("qi")*100/(int)target->query("max_qi");
    
                 msg += "( $n"+eff_status_msg(p)+" )\n";      
   
                me->add("neili", -200);
               call_out("perform2", -8, me, target);    
               }
         else {       
                me->start_busy(1);
                me->add("neili", -100);                
                msg += "$n大惊之下连忙向旁边一跳，在危急之中闪了开去。\n"NOR;
 call_out("perform2", -8, me, target);    
              }
         message_vision(msg, me, target);
        return 1;
}

int perform2(object me, object target)
{
        string msg;
        int damage, p;
object weapon;
  weapon = me->query_temp("weapon");


        if (!me || !target) return 0;
        if(!living(target)) 
          return notify_fail("对手已经不能再战斗了。\n");  
        if( (int)me->query("neili", 1) < 800 )
                return notify_fail("你待要再乘胜追击，突然发现自己已经无力出招了。\n");  
      if( !target || !me->is_fighting(target) )
              return notify_fail("追魂只能在战斗中对对手使用。\n");
       if (!weapon || weapon->query("skill_type") != "blade"
       || me->query_skill_mapped("blade") != "shenghuo-lingfa")
              return notify_fail("你手里没有武器，无法使出追魂！\n");

        msg = HIB "\n接着$N拔出手中的令牌，将令牌掷向$n的后腰。\n"NOR;
        if (random(me->query_skill("force")) > target->query_skill("force") / 3)
              {                
                msg += HIR "结果贯穿$n的身体，一缕鲜血光喷向天空！\n\n"NOR;   
                me->start_busy(2);
                target->start_busy(1);
                damage = (int)me->query_skill("shenghuo-shengong", 1);
                damage = damage + random(damage/2);
                target->receive_damage("qi", damage);
                target->receive_wound("qi", damage/2);
                 p = (int)target->query("qi")*100/(int)target->query("max_qi");
    
                 msg += "( $n"+eff_status_msg(p)+" )\n";      

                me->add("neili", -200);
                call_out("perform3", -8, me, target);     
              } 
        else {
           me->start_busy(1);
           me->add("neili", -150);
           target->add("neili", -150);
           msg += "\n$n眼看避无可避，忙伸手拨向铁令，将令挡开。\n" NOR;
 call_out("perform3", -8, me, target);    
           }
        message_vision(msg, me, target);
        return 1;
}
int perform3(object me, object target)
{
        int skill, damage, p;
object weapon;

        string msg;
        skill = (int)me->query_skill("shenghuo-lingfa", 1);                
        skill = skill/10;
  weapon = me->query_temp("weapon");
       
        if(!living(target)) 
          return notify_fail("对手已经不能再战斗了。\n");
 if( !target || !me->is_fighting(target) )
              return notify_fail("追魂只能在战斗中对对手使用。\n");
       if (!weapon || weapon->query("skill_type") != "blade"
       || me->query_skill_mapped("blade") != "shenghuo-lingfa")
              return notify_fail("你手里没有武器，无法使出追魂！\n");

        if( (int)me->query("neili", 1) < 500 )
                return notify_fail("你待要再乘胜追击，突然发现自己已经无力出招了!\n");     

        msg = HIB "\n$N突然以极其诡异的身法跃到空中，伸手接住铁令对着$n当胸击出！\n"NOR;        
        if (random(me->query_skill("dodge")) > target->query_skill("dodge") / 2)
            {                
                msg += HIR "$n听见几声骨头被打碎的声音，眼前一黑，被又打得飞向地上！\n\n" NOR;
                me->start_busy(2);
                target->start_busy(1);
                damage = (int)me->query_skill("parry", 1);
                damage = damage + random(damage/2);
                target->receive_damage("qi", damage);
                target->receive_wound("qi", damage/4);
                p = (int)target->query("qi")*100/(int)target->query("max_qi");
    
                 msg += "( $n"+eff_status_msg(p)+" )\n";      

                call_out("perform4", -8, me, target);                  
             } 
        else {
                me->add("neili", -200);
                msg += "\n$n连忙潜运内力将身体下沉,虽然躲开攻击,却也重重摔在地上！\n" NOR;
 call_out("perform4", -8, me, target);                  
                }
        message_vision(msg, me, target);
        return 1;
}
int perform4(object me, object target)
{
        int skill, damage, p;
object weapon;
        string msg;
        skill = (int)me->query_skill("shenghuo-lingfa", 1);                
        skill = skill/10;
       weapon = me->query_temp("weapon");
  
        if(!living(target)) 
          return notify_fail("对手已经不能再战斗了。\n");
 if( !target || !me->is_fighting(target) )
              return notify_fail("追魂只能在战斗中对对手使用。\n");
       if (!weapon || weapon->query("skill_type") != "blade"
       || me->query_skill_mapped("blade") != "shenghuo-lingfa")
              return notify_fail("你手里没有武器，无法使出追魂！\n");

        if( (int)me->query("neili", 1) < 200 )
                return notify_fail("你待要再乘胜追击，突然发现自己已经无力出招了!\n");     

        msg = HIB "\n$N见势急运千斤坠绝学，以比$n下落更快的速度疾踩向$n的胸口！\n\n"NOR;        
        if (random(me->query_skill("dodge")) > target->query_skill("dodge") / 10)
                {                
                me->add("neili", -200);
                msg += HIR "随着一声惊天的惨叫，$n的身体被$N重重的踩在地上！\n" NOR;
                damage = (int)me->query("neili") / 2;
                damage = (int)me->query_skill("shenghuo-shengong", 1) +damage;
                damage = (int)me->query_skill("shenghuo-lingfa", 1) +damage;
                damage = damage*2 + random(damage);
                target->receive_damage("qi", damage);
                target->receive_wound("qi", damage/2); 
                p = (int)target->query("qi")*100/(int)target->query("max_qi");
    
                 msg += "( $n"+eff_status_msg(p)+" )\n";      
                target->start_busy(1);    
                target->start_busy(3);    
             }
        else 
                me->start_busy(4);
                me->add("neili", -100);
 target->start_busy(1);
                msg += "\n$n危急中丝毫不顾高手的风范，连忙就地一滚才堪堪躲开这一击！\n" NOR;
                
        message_vision(msg, me, target);
        return 1;
}
