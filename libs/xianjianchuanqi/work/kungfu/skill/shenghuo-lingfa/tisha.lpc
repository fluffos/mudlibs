// tisha.c 脚踢
#include <ansi.h>
#include <pfm_control.h>
inherit F_SSERVER;
int perform(object me, object target) {
  string msg;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail(CYN "闲没事的你老踢沙子干什么？要不要砍来做花肥？\n" NOR);
  if (target->is_busy())
    return notify_fail(target->name() + WHT "目前正自顾不暇，放胆攻击吧!\n" NOR);
  if ((int)me->query_skill("shenghuo-lingfa", 1) < 120)
    return notify_fail(CYN "你的圣火令法不够娴熟，不会使用「脚踢飞沙」的绝技。\n" NOR);
  if ((int)me->query_skill("blade", 1) < 120)
    return notify_fail("你的基本刀法修为不够。\n" NOR);
  if (me->query_skill_mapped("blade") != "shenghuo-lingfa")
    return notify_fail(CYN "你不用圣火令法，不能使用「脚踢飞沙」绝技。\n" NOR);
  if ((int)me->query("max_neili") < 1500)
    return notify_fail("你的内力修为不够。\n");
  if (check_pfm_cost(me, pfm_lvl_c, pfm_type_attack) == 0)
    return notify_fail("你内力不够了! \n");
  if (me->query_temp("pfm_going"))
    return notify_fail("你气息不匀，暂时不能施用外功。\n");
  set_pfm_type(me, pfm_type_busy);

  msg = RED "\n$N突然转身向后便跑，$n见$N胆怯，不及细想，伸手便抓$N的背心要穴。只见$N
上身一移，脚尖挑起地上的细沙，向$n的头脸打去!\n\n" NOR;
  message_vision(msg, me, target);
  if (check_exp_combat(me, target) == 1) {
    msg = HIR "$n措手不及，细沙入眼后顿时乱了方向，$N乘机发动猛攻!\n\n" NOR;
    pfm_busy_other(
      target,
      (int)me->query_skill("shenghuo-lingfa", 1),
      (int)me->query_skill("shenghuo-shengong", 1),
      pfm_lvl_b
    );
  } else {
    msg = HIB "$n见$N脚尖一动，地上细沙扬起，急挥袍袖，挡住头脸，脚下用力，向后一纵，$n脸上露出鄙视的表情。$n指着$N的鼻子大骂：“你这个不要脸的臭贼离我远点!”\n" NOR;
    pfm_busy_me(
      me,
      (int)target->query_skill("parry", 2),
      (int)target->query_skill("dodge", 2),
      pfm_lvl_a
    );
  }
  message_vision(msg, me, target);
  return 1;
}
