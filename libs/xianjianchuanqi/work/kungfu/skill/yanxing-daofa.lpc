// yanxing-daofa.c 雁行刀法
#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *msg = ({
"$N默念「让字诀」，迅速闪开$n的攻势，$w同时随身法向$n的前胸挥出！",
"$N坐闪右让，一招「打字诀」，手中$w直出，出其不意地打向$n的后背！",
"$N故示其弱，一招「引字诀」，乘$n信以为真时，猛地挥动$w向$n的右脚斩去！",
"$N手捏「套字诀」，撤步套让，传身而走，诱$n追击，乘其不备向后猛击！",
"$N刀锋暗收，一招「藏字诀」，刀光乍展，指上打下，指东打西，杀机无限！",
"$N影意守「错字诀」，步步玄机，招招错乱，$n顿时迷离失措，束手待毙！",
});

int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

int valid_learn(object me)
{
        if ((int)me->query("max_neili") < 100)
                return notify_fail("你的内力不够。\n");
        if ((int)me->query_skill("linji-zhuang", 1) < 30)
                return notify_fail("你的临济十二庄火候太浅，无法学习雁行刀法。\n");
        return 1;
}

mapping query_action(object me, object weapon)
{
           int level;
           string a_msg;
           a_msg=msg[random(sizeof(msg))] ;
          if( (int)me->query_temp("huanying_hit")==1)
                a_msg=select_color() + a_msg + NOR;
        level = (int)me->query_skill("yanxing-daofa",1);
        return (["damage_type":random(2)?"刺伤":"割伤","action":a_msg ])
                + query_my_power(me,level,at_type_weapon,attack_lvl_normal,defense_lvl_normal);
  }

int practice_skill(object me)
{
        object weapon;
        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "blade")
                return notify_fail("你使用的武器不对。\n");
        if ((int)me->query("jingli") < 60)
                return notify_fail("你的体力不够练雁行刀法。\n");
        me->receive_damage("jingli", 50);
                return 1;
}

string perform_action_file(string action)
{
        return __DIR__"yanxing-daofa/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{                
    if( !me->query_temp("幻影") )    return 0; 
   if (random((int)me->query_skill("yanxing-daofa",1)) > (int)victim->query_skill("dodge",1)/2  && random(6) > 3 && (int)me->query("neili") > 0)
    {
       me->set_temp("huanying_hit", 1);
        me->set_temp("apply/name", ({ me->query("name")+"的"HIY"幻影"NOR }));
        COMBAT_D->do_attack(me, victim, me->query_temp("weapon"), 1);       
        me->delete_temp("apply/name");
        me->delete_temp("huanying_hit");
       }
}

