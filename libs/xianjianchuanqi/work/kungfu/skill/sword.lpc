// sword.c

#include <ansi.h>

inherit SKILL;

int valid_enable(string usage) { return usage=="array"; }

int form_array(object leader)
{
        object *member;

        member = leader->query_team();
        if( sizeof(member) != 7)
                return notify_fail("灵蛛剑阵共需七人，少一个多一个都不行。\n");
        message_vision( HIG "$N率领众人按照北斗七星位置站定，组成了「北斗七星剑阵」！\n" NOR, leader);
        return 1;
}
int effective_level() { return 20;}

int learn_bonus()
{
        return 40;
}
int practice_bonus()
{
        return 20;
}
int black_white_ness()
{
        return 50;
}
