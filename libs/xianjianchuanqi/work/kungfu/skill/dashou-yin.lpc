// dashou-yin.c 密宗大手印
#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *msg = ({
  "$N使出一招「莲花合掌印」，双掌合十，直直撞向$n的前胸",
  "$N使出一招「合掌观音印」，飞身跃起，双手如勾，抓向$n的$l",
  "$N使出一招「准提佛母印」，运力于指，直取$n的$l",
  "$N使出一招「红阎婆罗印」，怒吼一声，一掌当头拍向$n的$l",
  "$N使出一招「药师佛根本印」，猛冲向前，掌如游龙般攻向$n",
  "$N使出一招「威德金刚印」，伏身疾进，双掌自下扫向$n的$l",
  "$N使出一招「上乐金刚印」，飞身横跃，双掌前后击出，抓向$n的咽喉",
  "$N使出一招「六臂智慧印」，顿时劲气弥漫，天空中出现无数掌影打向$n的$l",
});

int valid_enable(string usage) { return usage == "hand" || usage == "parry"; }

int valid_learn(object me) {
  if ((int)me->query_skill("fuhu-quan", 1) < 100)
    return notify_fail("你的罗汉伏虎拳火候不够，无法练习密宗大手印。\n");
  if ((int)me->query_str() <= 30)
    return notify_fail("你的臂力不够，无法练习密宗大手印。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练密宗大手印必须空手。\n");
  if ((int)me->query("max_neili") < 500)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("longxiang-gong", 1) <= 80)
    return notify_fail("需要有第四层以上龙象般若功火候，才能练习密宗大手印。\n");
  return 1;

}
int valid_combine(string combo) {
  object me;
  me = this_player();
  if ((int)me->query_str() > 32)
    return combo == "fuhu-quan";
}
mapping query_action(object me) {
  int level;
  string a_msg;
  level = (int)me->query_skill("dashou-yin", 1);
  a_msg = msg[random(sizeof(msg))];
  if (random(level) > level - level / 6)
    a_msg = select_color() + a_msg + NOR;
  return ([
    "damage_type": random(2) ? "内伤" : "瘀伤",
    "action": a_msg
  ]) + query_my_power(me, level, at_type_hand, attack_lvl_middle, defense_lvl_normal);
}

int practice_skill(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练密宗大手印必须空手。\n");
  if ((int)me->query("jingli") < 40)
    return notify_fail("你的体力不够，练不了密宗大手印。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够，练不了密宗大手印。\n");
  me->receive_damage("jingli", 30);
  me->add("neili", -10);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "dashou-yin/" + action;
}
