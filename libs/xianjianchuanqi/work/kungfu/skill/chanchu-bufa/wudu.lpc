// lingbo.c  洛神凌波

#include <ansi.h>

inherit F_SSERVER;

int perform(object me, object target)
{
        string msg;

        if( !target ) target = offensive_target(me);

        if( !target || !target->is_character() || !me->is_fighting(target) )
                return notify_fail("你一个人跳甚么？\n");

        if( me->query("gender") == "无性")
                return notify_fail(HIY "一个公公，满场乱跳，羞也不羞？\n" NOR);

        if((int)me->query_skill("hamashengong",1) < 100)
                return notify_fail(HIY "你的蛤蟆神功修为不够。\n" NOR);

        if((int)me->query_skill("chanchu-bufa",1) < 100)
                return notify_fail(HIY "你的蟾蜍步法不够熟练。\n" NOR);
        if((int)me->query_skill("poison",1) < 100)
                return notify_fail(HIY "你的基本毒功不够熟练。\n" NOR);


        if((int)me->query("neili") < 400)
                return notify_fail(HIY "你现在真气不足。\n" HIY);

        if( target->is_busy() )
                return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧！\n");

        if( me->query("gender") == "男性")
               {msg = YEL 
"$N匍匐而行，直如一只巨大的蛤蟆一般，手脚并用，围着$n四处乱跳，
$n大惊之下，手足无措，只见$N蓦的弹身而起，“咕”的一声怪叫，一
股劲气直刺$n!,真个狠毒无比!\n" NOR;}
        else   {msg = YEL 
"$N跃向空中，连翻跟头，口中不断咕咕乱叫，趁得$n心神一乱之时，飞身
扑下！五丝黑线直射$n的强间,风府,大雅,灵台,悬枢五穴，直如神蟾蚀月,
诡异非常! 
\n" NOR;}
         message_vision(msg, me, target);
        if( me->query("combat_exp") > (int)target->query("combat_exp")/2 ) {
                 msg = RED"$n只觉得一股如山的劲力顺指尖猛攻过来，只觉得全身毒气狂窜。\n忽然胸口一痛，不由“哇”的一声吐出一口黑血！\n" NOR;    target->apply_condition("snake_poison",
                        (int)target->query_condition("snake_poison") + (int)me->query_skill("poison",1) / 20  );
               target->apply_condition("wugong_poison",
                        (int)target->query_condition("wugong_poison") + (int)me->query_skill("poison",1) / 20 );
               target->apply_condition("zhizhu_poison",
                        (int)target->query_condition("zhizhu_poison") + (int)me->query_skill("poison",1) / 20 );
               target->apply_condition("xiezi_poison",
                        (int)target->query_condition("xiezi_poison") + (int)me->query_skill("poison",1) / 20 );
               target->apply_condition("chanchu_poison",
                        (int)target->query_condition("chanchu_poison") + (int)me->query_skill("poison",1) / 20 );                           target->start_busy( (int)me->query_skill("chanchu-bufa",1) / 20);
                me->add("neili", -100);
                me->start_busy(1);
        }     
        else   
{ 
           
    msg += HIY "$n情急之间，向后连翻空心跟斗，总算躲过了这一招，吓得浑身冷汗直冒！
\n" NOR;
          me->start_busy(2);
           me->add("neili", -100);

}
         message_vision(msg, me, target);
        return 1;
}

