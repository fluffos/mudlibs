//    空明拳
#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *msg = ({
  "$N使出「空」字诀，单拳击出，拳式若有若无，似乎毫无着力处，却又径直袭向$n",
  "$N使出「朦」字诀，拳招胡里胡涂，看似不成章法，但拳势却直指$n的$l",
  "$N使出「洞」字诀，单拳似乎由洞中穿出，劲道内敛，招式却咄咄逼人，狠狠地击向$n",
  "$N使出「松」字诀，出拳浑似无力，软绵绵地划出，轻飘飘地挥向$n的$l",
  "$N使出「风」字诀，单拳击出，带起一股柔风，$n刚觉轻风拂体，拳招竟已袭到了面前",
  "$N使出「通」字诀，拳力聚而不散，似有穿通之形，直击$n的$l",
  "$N使出「容」字诀，拳走空明，外包内容，似轻实重，正对着$n当胸而去",
  "$N使出「梦」字诀，拳势如梦，又在半梦半醒，$n一时神弛，拳风已然及体",
  "$N使出「冲」字诀，单拳直击，拳式举重若轻，向$n的$l打去",
  "$N使出「穷」字诀，正显潦倒之形，拳势虽然显出穷途末路，却暗含杀机，窥$n不备而猛施重拳",
  "$N使出「中」字诀，单拳缓缓击出，不偏不倚，虽是指向正中，拳力却将$n的周身笼住",
  "$N使出「弄」字诀，拳招陡然花俏，似在作弄$n，却又暗伏后招",
  "$N使出「童」字诀，出拳如稚童般毫无章法，胡乱击向$n的$l",
  "$N使出「庸」字诀，单拳击出时是最简单的招式，平平无奇，可是却阻住了$n的退路",
  "$N使出「弓」字诀，身体弯曲如弓，拳出似箭，迅捷地袭向$n",
  "$N使出「虫」字诀，身子柔软如虫，拳招也随着蠕动，$n竟无法判断这一拳的来势",
});
int valid_enable(string usage) { return usage == "cuff" || usage == "parry"; }
int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("学空明拳必须空手。\n");
  if ((int)me->query_skill("force", 1) < 120)
    return notify_fail("你的内功火候不够，无法学空明拳。\n");
  if ((int)me->query("max_neili") < 1250)
    return notify_fail("你的内力太弱，无法练空明拳。\n");
  return 1;
}
mapping query_action(object me) {
  int level;
  string a_msg;
  level = (int)me->query_skill("kongming-quan", 1);
  a_msg = msg[random(sizeof(msg))];
  if (random(level) > level - level / 6)
    a_msg = select_color() + a_msg + NOR;
  return ([
    "damage_type": random(2) ? "内伤" : "瘀伤",
    "action": a_msg
  ]) + query_my_power(me, level, at_type_hand, attack_lvl_middle, defense_lvl_middle);
}

int practice_skill(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练空明拳必须空手。\n");
  if ((int)me->query("jingli") < 60)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 30)
    return notify_fail("你的内力不够练空明拳。\n");
  me->receive_damage("jingli", 50);
  me->add("neili", -25);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "kongming-quan/" + action;
}

mixed hit_ob(object me, object victim, int damage) {
  if (me->query_temp("kongming_berserk"))
    return damage;
  else return 0;
}

int ob_hit(object ob, object me, int damage) {
  if (me->query_temp("kongming_berserk"))
    return damage;
  else return 0;
}
