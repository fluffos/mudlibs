//  jinlong-whip.c 金龙鞭法
#include <power_control.h>
#include <ansi.h>
inherit SKILL;
string *msg = ({
  "刷的一声，$N腰间一条$w已握在手中，一招「风卷云残」，疾往$n的$l上卷去。",
  "$N凌空越起，一招「乌龙取水」，居高临下，往$n的$l上击去",
  "$N手一抖，一式「游龙入海」，$w突然从横里甩起，呼的一声，向$n的$l击去，劲道着实凌厉",
  "$N一招「金龙翻身」，$w荡起阵阵疾风，划出道道圆弧，一轮轮地向$n卷去",
});

int valid_enable(string usage) { return (usage == "whip"); }

int valid_learn(object me) {
  if ((int)me->query("max_neili") < 50)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("mingyun-qingqi", 1) < 20)
    return notify_fail("你的冥云清气不够，无法学金龙鞭法。\n");
  return 1;
}

mapping query_action(object me, object weapon) {
  int level;
  string a_msg;
  level = (int)me->query_skill("jinlong-bianfa", 1);
  a_msg = msg[random(sizeof(msg))];
  return ([
    "damage_type": random(2) ? "拉伤" : "割伤",
    "action": a_msg
  ]) + query_my_power(me, level, at_type_weapon, attack_lvl_high, defense_lvl_normal);
}



int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "whip")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("jingli") < 40)
    return notify_fail("你的体力不够练金龙鞭法。\n");
  if ((int)me->query("neili") < 15)
    return notify_fail("你的内力不够练金龙鞭法。\n");
  me->receive_damage("jingli", 25);
  me->add("neili", -8);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "jinlong-whip/" + action;
}
