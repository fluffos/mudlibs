// mian.c 武当绵掌绵意
// By lius 99/8

#include <ansi.h>

int check_fight(object me);
int remove_effect(object me);
int exert(object me)
{
	 int i,p;
        i = me->query_skill("cuff", 1) + me->query_skill("wudang-quan", 1);
        p = 120 - (me->query_skill("force", 1) + me->query_skill("yiyun-ziqi", 1))/10;
	 if ( p < 20 ) p = 20 ;
        if( !me->is_fighting() || !living(me))
                return notify_fail("临阵对敌方能显绵掌绵意之无尽奥妙。\n");
        if(objectp(me->query_temp("weapon")) )
                return notify_fail("你必须空手才能运用绵掌之绵意！\n");
        if(me->query_temp("mz_mian"))        
                return notify_fail("你双掌飞舞，轻飘飘不着力道，显然已深悟绵掌之诀窍。\n");
        if((int)me->query_skill("cuff", 1) < 101 )
                return notify_fail("你的基本拳法太低，无法使用武当拳之绵意。\n"); 
        if((int)me->query_skill("wudang-quan", 1) < 101 )
                return notify_fail("你的武当拳还不够娴熟，不能领会武当拳之精髓。\n");
        if (me->query_skill_prepared("cuff") != "wudang-quan"
           || me->query_skill_mapped("cuff") != "wudang-quan")
                return notify_fail("你不使用武当拳，又岂能体会武当拳之绵意？\n");
        if( (int)me->query("max_neili", 1) < 1200 )
                return notify_fail("绵意全凭一口真气维系，你的内力修为太弱，只怕会弄巧成拙！\n");                
        if( (int)me->query("neili", 1) < 500 )
                return notify_fail("你现在真气不够，已不能发挥出绵掌之绵意。\n");
        if( (int)me->query("shen", 1) < 50000 )
                return notify_fail("你现在邪气迷心，岂能领会道家浩然之拳意？？\n");
        if(userp(me) && (int)me->query_skill("yinyun-ziqi", 1) < 120 )
                return notify_fail("你的氤氲紫气等级不够，不能领会绵掌之绵意。\n");
        if(userp(me) && (int)me->query_skill("taoism", 1) < 100 )
                return notify_fail("练拳先修心，你对道学心法的领悟不够，是不能领悟武当拳之绵意的。\n");
        if(userp(me) && me->query_skill_mapped("force") != "yinyun-ziqi")
                return notify_fail("你的内功心法不对，发挥不出绵掌之绵意。\n");                                                                                     
        if (userp(me) && me->query_skill_mapped("parry") != "wudang-quan")
                return notify_fail("你必须在激发武当拳为招架的情况下才能使用武当拳之绵意。\n");
        message_vision(YEL"$N脚踏七星，双掌飞舞，顶劲虚临，运起绵掌之绵意，轻飘飘、软绵绵，不着力道。\n"NOR,me);
        tell_object(me, HIM"\n你神功聚体，但觉一股浩然正气自胸中升腾而起，气随意转，收发由心。\n"NOR);
        me->start_busy(1);
        me->set_temp("mz_mian", 1);
         me->add_temp("apply/attack", i/6);
        me->add_temp("apply/parry", i/5);
	 me->add("neili", -p);    
	 me->start_call_out( (: call_other, __FILE__, "remove_effect", me, i/10 :), i/4 );
	 me->start_exert(i/6, "绵掌绵意");
        check_fight(me);
        return 1;
}

int check_fight(object me)
{
        int i = me->query_skill("cuff", 1) + me->query_skill("wudang-quan", 1);
        if (!me || !me->query_temp("mz_mian")) return 0;
        if (userp(me) && (me->query_skill_mapped("cuff") != "wudang-quan" 
                || me->query_skill_mapped("parry") != "wudang-quan"
                || me->query_temp("weapon"))){
                  message_vision(CYN"$N招式突变，竟打出截然不同的武功路数！！\n"NOR,me);
		    me->start_busy(2);
		    me->delete_temp("mz_mian");                  
                  me->add_temp("apply/attack", -i/6);
                  me->add_temp("apply/parry", -i/5);
                                    }   
       else if( me->query("neili") <= 10 ) remove_effect(me);
       else call_out("check_fight", 1, me);
       return 1;
}       

int remove_effect(object me)
{
   int i = me->query_skill("cuff", 1) + me->query_skill("wudang-quan", 1);
   if (!me || !me->query_temp("mz_mian")) return 0;
   else 
   message_vision(CYN"\n$N深深呼出一口长气，将内力收回丹田，神光内蕴，不落大家风范。\n"NOR, me);
   me->delete_temp("mz_mian");
   me->add_temp("apply/attack", -i/6);
   me->add_temp("apply/parry", -i/5);
   remove_call_out("check_fight"); 
   return 1;
}
