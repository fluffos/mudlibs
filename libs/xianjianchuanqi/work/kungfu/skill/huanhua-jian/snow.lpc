// tie@fengyun
#include <ansi.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target) 
{
        string msg;
        int i, lmt, damage, lev ;
        object weapon;
        if( (int)me->query_skill("sword") < 120 ||
            me->query_skill_mapped("sword") != "huanhua-jian")
                return notify_fail(HIW "你的「浣花剑法」还不到家，无法使用「天下有雪」！\n"NOR);
         if( (int)me->query_skill("huanhua-jian",1) < 120) 
                return notify_fail(HIW "你的「浣花剑法」还不到家，无法使用「天下有雪」！\n"NOR);
       if ((int)me->query("neili",1) < 600)
                return notify_fail("你的内力不够，无法使用「天下有雪」！\n"); 
        if ((int)me->query("max_neili",1) < 1000)
                return notify_fail("你的内力不够，无法使用「天下有雪」！\n");                     
        if( !target ) target = offensive_target(me);
    if( !target||!target->is_character()||!me->is_fighting(target) )
                return notify_fail(HIW "「天下有雪」只能对战斗中的对手使用。\n"NOR);
        weapon = me->query_temp("weapon");
          if (!weapon || weapon->query("skill_type") != "sword"
   || me->query_skill_mapped("sword") != "huanhua-jian")
      return notify_fail("你手里没有剑，无法使用「天下有雪」！\n");             


        msg = HIW"$N长啸一声，剑招顿挟风云之式，剑气猛的暴涨三尺，手中的"NOR+weapon->name()+HIW"如狂风暴雨般地向$n卷来！\n"NOR;
        message_vision(msg,me,target);
         damage =(me->query_skill("huanhua-jian",1)/ 2 + (int)me->query_skill("guiyuan-dafa", 1))/ 4;
    lev = random(15)+20;
  lmt = random(3)+3;
        for(i=1;i<=lmt;i++)
        {
      me->add_temp("apply/dexerity", lev);
        me->add_temp("apply/strength", lev);
        msg =  HIW "$N大喝一声：接第"+chinese_number(i)+"剑！\n" NOR;
        message_vision(msg,me,target);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
      me->add_temp("apply/dexerity", -lev);
        me->add_temp("apply/strength", -lev);
        }
//      target->receive_wound("jing", random( damage/20 ));
        me->start_busy(5);
       me->add("neili", -500);
        me->start_perform(4,"天下有雪");  
        return 1;
}

