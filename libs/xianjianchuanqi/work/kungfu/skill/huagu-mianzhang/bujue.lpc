// bujue.c  [绵绵不绝] bye benlong 2001.3.7
#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
      int lvl;
      object weapon;
      weapon = me->query_temp("weapon");
      lvl = ( (int)me->query_skill("huagu-mianzhang", 1))*2;
     if( !target ) target = offensive_target(me);

      if( !target || !me->is_fighting(target) )
      return notify_fail("只能在战斗中对对手使用。\n");

        if( objectp(me->query_temp("weapon")) )
               return notify_fail("你必须空手使用[绵绵不绝]！\n");

        if (me->query_skill_prepared("strike") != "huagu-mianzhang"
            || me->query_skill_mapped("strike") != "huagu-mianzhang")
                return notify_fail("你现在无法使用「[绵绵不绝]」进行攻击！\n");

        if( (int)me->query_skill("huagu-mianzhang", 1) < 100 )
                return notify_fail("你的化骨绵掌不够娴熟，无法施展出[绵绵不绝]。\n");
        if ((int)me->query_skill("shenlong-xinfa", 1) < 100)
               return notify_fail("你的神龙心法火候不够，无法施展出[绵绵不绝]。\n");
        if ( (int)me->query("neili") < 350)
                return notify_fail("你的真气不够，无法施展出[绵绵不绝]。\n");
        if( (int)me->query_temp("sld_bujue") ) 
                return notify_fail("你刚刚使用了绝招，需要调整内息。\n");        
      message_vision(HIR"\n$N口中喃喃念道：“教主永享仙福,寿与天齐!教主宝训,时刻在心,建功克敌,无事不成”！
接着越战越勇，招式一招快过一招！\n"NOR, me,target);
        me->set_temp("sld_bujue", 1);
      me->add("neili", -200); 
      me->add("jingli", -100);    
      me->add_temp("apply/strength", lvl);
      me->add_temp("apply/dexerity", lvl);
      target->start_busy(2);
     COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1); 
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1); 
         me->add_temp("apply/strength", -lvl);
         me->add_temp("apply/dexerity", -lvl);
      call_out("remove_effect", me->query_con()/6, me);
      return 1;
}
void remove_effect(object me)
{
        if (!me) return;
        me->delete_temp("sld_bujue");
        tell_object(me, HIB"\n你调整完毕，又可以使用绵绵不绝了。\n"NOR); 
}
