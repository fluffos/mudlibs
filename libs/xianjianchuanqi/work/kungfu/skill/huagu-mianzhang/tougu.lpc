#include <ansi.h>
#include <combat.h>
inherit F_SSERVER;

int perform(object me, string arg) {
  object target;
  string msg;
  int i, z;
  i = (int)me->query_str() * 6;
  z = (int)me->query_skill(
    "shenlong-xinfa",
    1
  ) / 4 + (int)me->query_skill("huagu-mianzhang", 1) / 4;
  if (!target) target = offensive_target(me);
  // tougu.c 化骨绵掌 perform 透骨

  if (!target || !me->is_fighting(target))

    return notify_fail("「透骨」只能在战斗中对对手使用。\n");

  if (objectp(me->query_temp("weapon")))
    return notify_fail("你必须空手使用「透骨」！\n");

  if ((int)me->query_skill("huagu-mianzhang", 1) < 80)



    return notify_fail("你的神龙心法等级不够，不能使用「透骨」！\n");

  if (me->query_skill_mapped("force") != "shenlong-xinfa")
    return notify_fail("你没用神龙内功，无法用「透骨」进行攻击。\n");

  if ((int)me->query_str() < 28)
    return notify_fail("你的臂力不够强，不能使用「透骨」！\n");

  if ((int)me->query("max_neili") < 1000)
    return notify_fail("你的内力太弱，不能使用「透骨」！\n");

  if ((int)me->query("neili") < 100)
    return notify_fail("你的内力太少了，无法使用出「透骨」！\n");

  if (me->query_skill_prepared("strike") != "huagu-mianzhang"
    || me->query_skill_mapped("strike") != "huagu-mianzhang")
    return notify_fail("你现在无法使用「透骨」攻击。\n");

  if (me->query_temp("tougu"))
    return notify_fail("你正在使用化骨绵掌的特殊攻击「透骨」！\n");

  msg = HIR "$N突然全身骨骼作响，口中默念「透骨」,运起神龙" +
    "心法，脸上一阵红色，全身好象有使不完的力量一样！\n" NOR;

  message_vision(msg, me, target);
  me->add_temp("apply/strength", i);
  me->set_temp("tougu", 1);
  me->add("neili", -50);
  me->add("jingli", -10);

  call_out("check_fight", 1, me, i, z);
  me->start_busy(0);
  return 1;
}
void remove_effect(object me, int i) {
  if (me->query_temp("tougu")) {
    me->add_temp("apply/strength", -i);
    me->delete_temp("tougu");
    tell_object(me, HIR "你的「透骨」运功完毕，骨头顿时松散。\n" NOR);
  }
  //    else tell_object(me, "。\n" NOR);
}
void check_fight(object me, int i, int z) {

  if (!me) return;
  if (me->query_temp("weapon")
    || me->query_temp("secondary_weapon")
    || me->query_skill_mapped("strike" != "huagu-mianzhang")) {
    remove_effect(me, i);
    return;
  }
  if (z < 1 || !me->is_fighting()) {
    remove_effect(me, i);
    return;
  }
  call_out("check_fight", 1, me, i, z - 1);
}
