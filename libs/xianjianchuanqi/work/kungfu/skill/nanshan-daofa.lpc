// nanshan-daofa.c
#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *msg = ({
"$N一个「进步提篮」，左掌平推。右足进步顺手一刀劈向$n的$l，",
"$N见$n绕至身后，也不回身，后腿向后反踢，踢开向$n，乘势一刀撩向$n$l，",
"$N眼神坚毅，手中$w如雷霆万军之势，一招「大漠穷秋」斜斜的砍向$n的$l",
"$N左手执着$w，右手扶着刀背用力推出，一招「力尽关山」扫向$n的$l",
"$N一个「带醉脱靴」，挺刀挂开$n来势，飞起右脚，踢向$n的$l",
"$N狂喝一声，使出一招「绝域苍茫」，双手紧握$w带着逼人的杀气，刺向$n的$l",
});

int valid_learn(object me)
{
        object ob;
        if( (int)me->query("max_neili") < 100 )
                return  notify_fail("你的内力不够，没有办法学南山刀法。\n");
                if( (int)me->query_skill("dodge",1) < 10 )
                return
                notify_fail("你的轻功不够，没有办法学南山刀法。\n");
        if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "blade" )
                return notify_fail("你必须先找一把刀才能学南山刀法。\n");
        return 1;
}

int valid_enable(string usage)
{
        return (usage=="blade");
}

mapping query_action(object me, object weapon)
{       
        int level;
        string a_msg;
        level = (int)me->query_skill("nanshan-daofa",1);
        a_msg=msg[random(sizeof(msg))] ;
        if( random(level) > level - level/6 )
                a_msg=select_color() + a_msg + NOR;
        return (["damage_type":"割伤","action":a_msg ])
    + query_my_power(me,level,at_type_weapon,attack_lvl_middle,defense_lvl_normal);
}

int practice_skill(object me)
{
        object weapon;

        if( !objectp(weapon = me->query_temp("weapon"))
        ||      (string)weapon->query("skill_type") != "blade" )
                return notify_fail("你必须先找一把刀，才能练刀法。\n");

        if( (int)me->query("neili") < 100 )
                return  notify_fail("你的体力不够练这门刀法，还是先休息休息吧。\n");
    if(me->query_skill("nanshan-daofa",1)<120){
        me->receive_damage("neili", 30);
    }else{
       me->receive_damage("neili", 70);}
        return 1;
}

string perform_action_file(string action)
{
     return __DIR__"nanshan-daofa/" + action;
}

