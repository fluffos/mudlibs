//燕青拳
//yanqing-quan.c
inherit SKILL;
#include <ansi.h>
#include <power_control.h>
#include <combat.h>
#include <pfm_control.h>
#include "/kungfu/skill/eff_msg.h";
string *msg_1 = ({
"$N双拳飞舞，呼呼呼连击三拳，向$n迎面打去，好一招「迎面抢快打三拳」。",
"$N双拳一摆一晃，拳势下沉，一式「二郎担山」，挟风声劈向$n的$l。",
"$N身形一转，一式「反身裁锤」，一拳护身，反手一拳向$n的$l捣去。",
"$N双拳挥舞，一式「怀中抱月」，两手环扣，拢成圈状，猛地挥向$n的下颌。",
"$N一式「退步收势」，身体往后一退，左圈自下而上划了一道弧线，右圈一拳打出，顺势收拳。",
"$N一式「让步跨虎」，猛地跨前一步，身体一侧，就是一拳向$n$l打去。",
"$N原势不动，一招『脱靴转身』快速窜前，提起右腿向前快踢，同时左掌向前平推而出",
"$N右脚向前落步，成马步坐定，『拉弓式』在左手往回一拉，右拳向右直击而出",
"$N一式『扭步断肘』，右步跟前，成玉环步蹲定，顺势收回左手，右手向前以平肘直扣而出",
"$N身形一跃而起，『燕子抄水』右拳原地翻掌，左手以反掌由右掌上方直穿而出，化掌为拳击向$n",
"$N使一招『海燕掠波』，身子跃起，拧过身躯，左掌往外穿出，『毒蛇寻穴手』往$n$l击去。"
});
string *msg_2 = ({
"$N使一招「空屋住人」，双手轻飘飘地箍向$n$l",
"$N左掌一平,右掌一伸,一招「空碗盛饭」直拍$n的$l",
"$N身形绕$n一转，双手上撩,一招「空钵装水」击向$n$l",
 "$N左掌一按,右掌一挥,一招「空空如也」拍向$n的$l",
"$N使一招「空山鸟语」，$n的$l已围在$N的重重拳影之下",
 "$N神色一敛，使出「我心空明」，围绕$n的$l接连出掌",
"$N反身劈面一拳，一招「空手持物」，右手划了一道弧线，向$n的$l打去",
});
int valid_learn(object me)
{

       if( (string)me->query("gender") == "无性")
                return notify_fail("练燕青拳不是你这种阴人能修炼的。\n");
       if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
                return notify_fail("练燕青拳拳必须空手。\n");
        if(me->query("con")<20 )
             return notify_fail("练燕青拳拳必须跟骨良好。\n");
        if(me->query_skill("force",1)<20 )
                return notify_fail("你内力修为不足以练这种拳法。\n");
        return 1;
 }
 mapping query_action(object me, object weapon)
{
        int level;
        string a_msg;
        level = (int)me->query_skill("yanqing-quan",1);
              if( (random(level) > level - level/8 )&&me->query("bai_guo"))
                        {
             a_msg=(msg_2+msg_1)[random(sizeof(msg_2+msg_1))];
                           a_msg=select_color() + a_msg + NOR;
                        }
                        else{
                        a_msg=msg_1[random(sizeof(msg_1))] ;
                        }
        if ( random(level) > level - level /3  &&  level > 120 
        && me->query("bai_guo") && me->query("neili")>100 ) 
                call_out("start_pfm",1,me);
        if(!me->query("bai_guo")){
        return (["damage_type":"瘀伤","action":a_msg ])
                + query_my_power(me,level,at_type_hand,attack_lvl_middle,defense_lvl_normal);
        }else{
        return (["damage_type":"瘀伤","action":a_msg,])
                + query_my_power(me,level,at_type_hand,attack_lvl_middle,defense_lvl_middle);
        }
} 
int practice_skill(object me)
{
        if( (int)me->query("jingli") < 60 )
                return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
        if( (int)me->query("neili") < 50 )
                return notify_fail("你的内力不够了。\n");
        if(me->query("bai_guo")){
        me->receive_damage("jingli", 40);
        me->add("neili", -50);
        }else{
        me->receive_damage("jingli", 20);
        me->add("neili", -30);
        }
        return 1;
}
int ob_hit(object ob, object me, int damage)
{
        object wp;
        string msg;
       int skill;
        wp = me->query_temp("weapon");
      if( me->query_skill("cuff",1)>120 && me->query_skill("dodge",1)>120
         && me->query_skill("mingyun-qingqi",1)>120 &&(!wp)&& me->query_skill("parry",1)>120
     && (random(me->query("combat_exp") )<random(ob->query("combat_exp")*2/3))
         && me->query("neili")>300 && me->query("bai_guo"))
       {        
    skill=get_pfm_power(me,(int)me->query_skill("dodge",1),(int)me->query_skill("cuff", 1),pfm_lvl_d,"con");  
 skill=skill+random(skill);
                msg=HIB"$N当此危急之际，双脚鸳鸯连环，左起右落，左落右起，倏忽之间接连踢出了九腿。\n"NOR;
                me->add("neili", -30);
                me->add_temp("apply/attack", skill);
                me->add_temp("apply/damage", skill/2);
                COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 1,msg);  
                msg="这是马王神韩宝驹的生平绝学，脚下曾踢倒无数南北好汉。\n";
                message_vision(msg, me, ob);
                me->add_temp("apply/attack", - skill);
                me->add_temp("apply/damage", - skill/2);
       }          
}
int valid_enable(string usage) 
{
        return  usage=="cuff" || usage=="parry";
}
void start_pfm(object me)
{
    int damage,p;
        object target;
        string msg;
        if (!me || !living(me))
                return ;
        target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) || !living(target))
        return ;
        if(check_exp_combat(me,target) ==1)
                {
msg="$N身形一晃，双足并立，沉肩塌胯，五指并拢，手心向上，在小腹前虚虚托住，左肩低，右肩高，左手斜，右手正，\n";
msg+="$N突然右肘一摆，翻手抓住了他的右腕，向他背上扭转，左手同时上前，四指前、拇指后，已拿住了$n的“肩贞穴”，顺势向前一送。\n";
message_vision(msg, me, target);
                        damage = get_pfm_damage(me ,me->query_skill("force",1),me->query_skill("cuff",1),pfm_lvl_c,"con");
                        target->receive_damage("qi", damage ,me);
                        target->receive_wound("qi", damage/2 ,me);
                        p = (int)target->query("qi")*100/(int)target->query("max_qi");
                        msg = damage_msg(damage, "摔伤");
                        message_vision(msg, me, target);
                        msg = "( $n"+eff_status_msg(p)+" )\n";
                        message_vision(msg, me, target);
                }
        return ;
}

