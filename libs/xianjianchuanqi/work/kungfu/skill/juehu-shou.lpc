#include <ansi.h>
#include <power_control.h>
inherit SKILL;

mapping *msg = ({
  "$N一式「老牛拉车」，以掌化爪，五指如钩，两眼瞪得通红，直逼$n的裆部",
  "$N四肢贴地，头部底垂，看似已无力进攻，突然四肢用力一扒已窜到$n跨下，两手猛的上戳，好一式「精疲力尽」",
  "$N两手高高举起，运掌如风，一式「壮士断腕」，闭眼就朝$n的下体砍去",
  "$N一跃而起，直往$n的双肩落下，双腿盘住$n的颈部，一扭腰，双手成关门之势，往$n的裆部狠狠拍去，正是一式「落叶归根」",
  "$N使一式「空前绝后」，身形一分为二，四只手掌有如熊掌般朝$n的后腰和裆部拍去",
  HIR "$N全身关节啪啪作响，面如白纸，一式「断子绝孙」，无数鹰爪抓向$n全身要害，瞬间无数鹰爪又合为一爪直往$n的裆部抓落" NOR,
});

int valid_enable(string usage) { return usage == "hand" || usage == "parry"; }

int valid_combine(string combo) { return combo == "wudang-quan"; }

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练三阴绝户手必须空手。\n");
  if ((int)me->query_skill("yinyun-ziqi", 1) < 40)
    return notify_fail("你的氤氲紫气火候不够，无法学三阴绝户手。\n");
  if ((int)me->query("max_neili") < 100)
    return notify_fail("你的内力太弱，无法练三阴绝户手。\n");
  return 1;
}
mapping query_action(object me, object weapon) {
  return ([
    "damage_type": random(2) ? "内伤" : "瘀伤",
    "action": msg[random(sizeof(msg))]
  ]) + query_my_power(
    me,
    (int)me->query_skill("juehu-shou", 1),
    at_type_hand,
    attack_lvl_high,
    defense_lvl_normal
  );
}

int practice_skill(object me) {
  if ((int)me->query("jingli") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练三阴绝户手。\n");
  me->receive_damage("jingli", 25);
  me->add("shen", -10);
  me->add("neili", -10);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "juehu-shou/" + action;
}
