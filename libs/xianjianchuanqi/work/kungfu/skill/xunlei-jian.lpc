//xunlei-jian by cool
// update by sunyc
#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *msg = ({ "$N剑尖向右，绕身一周，一式「仙人指路」，$w突然向$n的$l刺去，",
  "$N使出一式「鹞子翻身」，身体凌空侧翻，一剑从身下刺出",
  "$N左手剑指血指，右手$w使出一招「海底寻针」，由上至下猛向$n的$l劈刺",
  "$N撤步缩身，$w按藏于臂下，一招「灵猿探洞」，快如闪电般刺向$n的$l",
  "$N踏步向前，一式「拨草寻蛇」，手中长剑摆动，剑尖刺向$n的$l",
  "$N一招「斜插神枝」，身体背转，手中$w由右肩上方反手向下刺出",
  "$N一式「电闪雷动」，剑走中锋，气势威严，将$n笼罩于重重剑气之中",
  "$N向前弯身，一招「夫子揖手」，$w忽然从身下刺出，快如流星闪电",
  "$N横握$w，左右晃动，一招「玉带缠腰」，剑气直逼$n的腰部要害",
  "$N双手持剑，将$w当做刀使，一招「举火烧天」，由身后向$n的前上方劈去",
  "$N侧身向$n，使出一招「败马斩蹄」，挥动手中$w，直劈$n的下三路",
  "$N手中$w由右自左，一招「玉女穿针」，$w突然反手刺向$n的$l",
  "$N跳步向前，剑尖上指，一招「灵猿登枝」，$w挑向$n的头部要害",
  "$N一招「苏武挥鞭」，$w随身走，犹如一条白龙，将$n全身上下笼罩",
  "$N剑尖向下，一招「挑灯看剑」，$w忽然急转直上，剑气将$n的上身要害团团围住",
});

int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }

int valid_learn(object me) {
  if ((int)me->query("max_neili") < 100)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("xuantian-wuji", 1) < 30)
    return notify_fail("你的玄天无极功火候太浅。\n");
  if ((int)me->query_skill("sword", 1) < 20)
    return notify_fail("你的基本剑法火候太浅。\n");
  return 1;
}

mapping query_action(object me, object weapon) {
  int i, level, huan;
  string str, a_msg;
  level = (int)me->query_skill("xunlei-jian", 1);
  weapon = me->query_temp("weapon");
  if (me->query_temp("xunlei")) {
    huan = me->query_temp("xunlei");
    if (huan == 1) str = HIC + "$N手中$w青光闪跃，一剑" + RED + "迅不及当" + HIC + "的刺向$n$l，四野风雷之声哄然而起" + NOR;
    else if (huan == 2) str = HIC + "$N一剑未落，变招于无形，复又跃出，一剑点向$n$l，风雷之声愈演愈烈" + NOR;
    else if (huan == 3) str = HIC + "$N旋身再度跃出，第三剑抖出" + RED + "七朵剑花" + NOR + HIC + "急速刺向$n$l，四野之中风雷之声震人肺腑" + NOR;
    else if (huan == 4) str = HIC + "$N运毕生功力于第四剑，决无旁顾地刺向$n$l，剑光吞吐，竟暴出" + RED + "三尺剑芒" + NOR;
    str = replace_string(str, "$w", weapon->name() + HIC);
    return ([
      "action": str,
      "damage": level * 5 / 3,
      "damage_type": "刺伤",
      "dodge": -70,
      "force": -70,
    ]);
  } else {
    a_msg = msg[random(sizeof(msg))];
    if (random(level) > level - level / 6)
      a_msg = select_color() + a_msg + NOR;
    return ([
      "damage_type": random(2) ? "刺伤" : "割伤",
      "action": a_msg
    ]) + query_my_power(me, level, at_type_weapon, attack_lvl_middle, defense_lvl_middle);
  }
}

int practice_skill(object me) {
  object weapon;
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("jingli") < 30)
    return notify_fail("你的体力不够练迅雷剑法。\n");
  me->receive_damage("jingli", 25);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "xunlei-jian/" + action;
}
