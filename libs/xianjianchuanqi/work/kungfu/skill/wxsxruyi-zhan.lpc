#include <ansi.h>;

inherit SKILL;

string  *msg = ({
HIY "$N手中$w"HIY"斜指,默念如意刀法[金]字决,反身一顿,幻出万道金光,划向$n"HIY"的$l。" NOR,
WHT "$N暗运「木」字决,身不动,意不移,静若悠林,$w"WHT"一提一收,平刃缓缓挥向$n"WHT"的$l。" NOR,
HIW "$N手捏如意「水」决,手中$w"HIW"如涓涓流水一般,自上而下划出一个大弧,连绵不绝劈向$n。" NOR,
HIR "$N一式「火」字决,$w"HIR"大开大阖,如烈火燎原一般,笔直劈向$n"HIR"的$l。" NOR,
YEL "$N盘身驻地,使出「土」字决,$w"YEL"猛劈地面,刀气带着茫茫尘雾,向$n"YEL"的全身涌去。" NOR,
MAG "$N默念「风」字决,展身虚步,提腰跃落,$w"MAG"顺势反撩,卷起一阵狂风,拦腰斩向$n"MAG"的$l。" NOR,
HIB "$N轻喝一声,腾身跃起,一式「雨」字决,自上而下连劈数刀,直若暴雨倾盆,挥出一片流光般的刀影,斩向$n的$l。" NOR,
HIC "$N一声长啸,一式「雷」字决,手中$w"HIC"势若奔雷,直劈而下,带着冲天刀气,罩向$n。" NOR,
HIM "$N一式「电」字决,刀交左手,揉身而上,右掌虚晃,左手$w"HIM"蓦然幻出电光一丝,直射$n"HIM"的$l" NOR,
});

int valid_enable(string usage)
{
        return usage == "blade" || usage == "parry";
}mapping query_action(object me, object weapon)
{
        return ([
                "action":msg[random(sizeof(msg))],
                "damage":(random(5)+10)*35,
                "damage_type":random(2)?"砍伤":"割伤",
                "force":(random(5)+10)*30
        
           ]);
}



int valid_learn(object me)
{
        if ((int)me->query("max_neili") < 900)
                return notify_fail("你的内力不够。\n");
        if ((int)me->query_skill("beiming-shengong", 1) < 140)
                return notify_fail("你的北冥神功火候太浅，强练五行如意刀只怕会走火入魔。\n");
        if ((int)me->query_skill("ruyi-dao", 1) < 140)
                return notify_fail("你的如意刀法火候太浅，体会不了更高深的五行如意斩。\n");
        if (me->query_int() < 35)
                return notify_fail("你悟性太底，无法领会五行如意斩的精要所在。\n");  
        if (me->query_dex() < 35)
                return notify_fail("你身法太底，无法领会五行如意斩的逍遥如意之处。\n");   
  if ((int)me->query("jingli") < 600)
                return notify_fail("你的体力不够练如意刀法。\n");
 if ((int)me->query("neili") < 600)
                return notify_fail("你的内力不够练如意刀法。\n");

        me->receive_damage("jingli", 75);
       
        return 1;
}
int practice_skill(object me)
{
        object weapon;
        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "blade")
                return notify_fail("你使用的武器不对。\n");
        if ((int)me->query("jingli") < 600)
                return notify_fail("你的体力不够练如意刀法。\n");
 if ((int)me->query("neili") < 600)
                return notify_fail("你的内力不够练如意刀法。\n");

        me->receive_damage("jingli", 75);
        return 1;}

string perform_action_file(string action)
{
        return __DIR__"wxsxruyi-zhan/" + action;
}

int ob_hit(object ob, object me, int damage)
{
        object wp,wp1;
        string msg;
        int p,j,skill, neili, neili1;
        wp = me->query_temp("weapon");
        wp1 = ob->query_temp("weapon");
        skill = me->query_skill("wxsxruyi-zhan", 1);
        neili = me->query("neili");
        neili1 = ob->query("neili");

      
      if(me->query("jiali") && random(skill) > random(ob->query_skill("parry", 1)) 
         && me->query("combat_exp") > ob->query("combat_exp")/5
         && me->query_skill_mapped("parry") == "wxsxruyi-zhan"
         && me->query_skill("wxsxruyi-zhan", 1) > 150
         && neili > 300 
         && objectp(wp) && wp->query("skill_type")== "blade"
         && !ob->query("env/invisibility"))
         {        
           if(random(15)>= 10){
          message_vision(HIY"结果$n的力道被$N手中"+wp->name()+HIY"一挡一挑，卸在了一旁!\n"NOR,me,ob); 
              j = -(damage*2+skill);
              }
           else if(random(20)>= 10){
              message_vision(HIY"结果$n的力道被$N手中"+wp->name()+HIY"一圈，卸掉了一半!\n"NOR,me,ob); 
              j = -damage*3/2;               
              }
           else{
              message_vision(HIY"$N手中"+wp->name()+HIY"回挡，卸掉了$n一小半的力道!\n"NOR,me,ob); 
              j = -damage; 
              }           
                 return j;
       }          
}

