#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target) {
  string msg, msg1;
  int i;
  object weapon;
  if (!target) target = offensive_target(me);
  if (!target || !me->is_fighting(target))
    return notify_fail("「灭如意」只能在战斗中对对手使用。\n");
  weapon = me->query_temp("weapon");
  if (!weapon || weapon->query("skill_type") != "blade"
    || me->query_skill_mapped("blade") != "wxsxruyi-zhan")
    return notify_fail("你必须使用在刀时才能使出「灭如意」！\n");

  if ((int)me->query_skill("wxsxruyi-zhan", 1) < 200)
    return notify_fail("你的如意斩不够娴熟，不会使用「灭如意」。\n");
  if ((int)me->query_str() < 40)
    return notify_fail("你的臂力太低，不能使用「灭如意」。\n");
  if ((int)me->query_dex() < 38)
    return notify_fail("你的身法太低，不能使用「灭如意」。\n");
  if ((int)me->query("neili", 1) < 1200)
    return notify_fail("你现在内力太弱，不能使用「灭如意」。\n");

  if ((int)me->query("qi") > (int)me->query("max_qi") * 2 / 6)
    return notify_fail(HIM "你大喝一声 毁天灭地 介如我意！你默运北冥神功只觉对方全身真气外泻，源源不绝的溃散 ！！！！。\n");
  i = (me->query_skill("wxsxruyi-zhan", 1) / 10);
  msg = HIW "\n$N腾身而起，半空中连翻跟斗!\n" NOR;
  message_vision(msg, me, target);
  if (me->quesy("combat_exp", 1) > random(target->quesy("combat_exp", 1))) {
    msg = HIR "\n蓦然间，$N长啸一声：“毁天灭地！皆如我意！”。急运北冥真气，将如意刀法
的所有招式一气呵成。刀气漫天之下，北盟神功将$n的内力悉数导出!\n" NOR;
    msg1 = HIY "$N一声长啸，刀势渐渐缓慢下来。\n" NOR;
    me->add_temp("apply/attack", i);
    me->add_temp("apply/dodge", i);

    message_vision(msg, me, target);
    msg = HIY "金决" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
    msg = WHT "木决" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
    msg = HIW "水决" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
    msg = HIR "火决" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
    msg = YEL "土决" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
    msg = MAG "风决" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
    msg = HIB "雨决" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
    msg = HIC "雷决" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);
    msg = HIM "电决" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);

    me->add("neili", -100);
    me->start_busy(1);
    me->add_temp("apply/attack", -i);
    me->add_temp("apply/dodge", -i);
    me->add("max_neili", -1);
    me->add("neili", -1000);
    target->set("neili", 0);
    message_vision(msg1, me, target);
    return 1;
  } else {
    msg = HIW "\n$n凝神以对，全力防御，$N眼见无机可趁，只好落了下来!\n" NOR;
    message_vision(msg, me, target);
  }
}
