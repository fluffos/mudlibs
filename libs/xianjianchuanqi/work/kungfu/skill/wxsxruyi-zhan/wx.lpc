#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target) {
  int damage;
  string msg;

  int i;
  object weapon;
  if (!target) target = offensive_target(me);
  if (!target || !me->is_fighting(target))
    return notify_fail("「五行斩」只能在战斗中对对手使用。\n");
  weapon = me->query_temp("weapon");
  if (!weapon || weapon->query("skill_type") != "blade"
    || me->query_skill_mapped("blade") != "wxsxruyi-zhan")
    return notify_fail("你必须使用在刀时才能使出「五行斩」！\n");

  if ((int)me->query_skill("wxsxruyi-zhan", 1) < 70)
    return notify_fail("你的五行四象如意斩不够娴熟，不会使用「五行斩」。\n");

  if ((int)me->query_str() < 28)
    return notify_fail("你的臂力太低，不能使用「五行斩」。\n");
  i = 10;
  if ((int)me->query("neili", 1) < 400)
    return notify_fail("你现在内力太弱，不能使用「五行斩」。\n");
  msg = MAG "\n$N暗运[五行斩决]，脚踏无惘，竟然画出了一个巨大的光圈！
                                          
                    " HIY "如意金刀" NOR "

                
 " WHT "如意木刀" NOR "                            " BLU "如意水刀" NOR "
                


                               
              " HIM "如意火刀" NOR "   " YEL "如意土刀" NOR "
                             
            \n" NOR;
  if (random(me->query("combat_exp")) > target->query("combat_exp") * 2 / 5) {
    damage = (int)me->query_skill("wxsxruyi-zhan", 1) / 10;
    damage = 4 + random(damage);
    if (damage > 8) damage = 8;
    target->add("qi", -(damage * 40));
    target->start_busy(damage);
    target->apply_condition("no_perform", damage * 2);
    me->add("neili", -(damage * 20));
    msg += HIW "$n被$N的刀光套住,又被四周飞舞的刀气连连打中,眉头一躇,似乎受了不轻的暗伤。\n" NOR;
  } else {
    me->start_busy(3);
    me->add("neili", -100);
    msg += HIY "$n只觉眼前一花,打惊之下猛的一跃,跳出了刀圈之外。\n" NOR;
  }
  message_vision(msg, me, target);


  return 1;
}
