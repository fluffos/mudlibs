// hamagong.c
inherit FORCE;
#include <ansi.h>    
mapping *action = ({
        ([      "action":
HIR "$N经脉逆运，头上脚下，反转内力，毫无章法的攻向$n的$l"NOR,
               "force" : 40,
          "dodge" : -5,
           "parry" : 20,
          "damage": 30,
           "lvl" : 0,
                 "damage_type" : "瘀伤",
        ]),
        ([      "action":
HIR"$N伏地而行，匆忙间爬到$n面前，一式反踢迅捷无比的攻向$n的$l"NOR,
                "force":  50,
                "dodge" : -10,
                "damage": 150,
                 "lvl" : 50,
                 "parry" : 40,        
                              "damage_type":  "瘀伤"
        ]),
        ([      "action":
HIR"$N双手矗地，变脚为掌，东踢西打，毫无章法，蓦然间双拳猛的击向$n的$l"NOR,
                "force":   100,
                "dodge" : -20,
                  "parry" : 60,
                "damage": 100,
                "lvl" : 100,
                "damage_type":  "瘀伤"
        ]),
([      "action":
HIR"$N仰躺地面，如僵尸一般，反身弹起，竟然背对$n，见得$n惊呆之时,手脚齐出如疯狂般攻向$n"NOR,
                "force":    320,
                "dodge" : -30,
                 "parry" : 100,
                "damage": 120,
                "lvl" : 140,
                "damage_type":  "瘀伤"
        ]),     
});


mapping query_action(object me, object weapon)
{
        int i, level;
        level   = (int) me->query_skill("hamashengong",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];

}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
        mixed foo;
        int force;

        foo = ::hit_ob(me, victim, damage_bonus, factor);
        if( intp(foo) && (damage_bonus + foo > 0) ) {
        if((int)me->query_temp("nizhuan") )         
                 {                        
                        force = me->query_skill("force");
                        victim->receive_wound("qi", (damage_bonus + foo));
                        victim->receive_wound("qi", random(force));
                        return
HIC"$N逆运经脉,内力陡然加强,$n被$N蛤蟆功的暗劲所伤，痛苦不堪！！！！\n"NOR;
                }
        }
        return foo;
}

int valid_enable(string usage) 
{ 
      return usage=="strike" ||
        usage=="parry"||
        usage=="force";
} 
int valid_combine(string combo) { return combo=="lingshe-quan"; }
//#include "force.h"

int valid_learn(object me)
{
        int i = (int)me->query_skill("hamagong", 1);
        int t = 1, j;

        if( i <= 100)
                for (j = 1; j < i / 10; j++)
                        t*= 2;

        if ( me->query("gender") == "无性" && i > 49)
                return notify_fail("你无根无性，阴阳不调，难以领会高深的蛤蟆功。\n");

        if ((int)me->query_skill("force", 1) < 10)
                return notify_fail("你的基本内功火候不足，不能学蛤蟆功。\n");

        if(i<=100)
        {
                if (i > 10 && -(int)me->query("shen") < t * 100) 
                        return notify_fail("学蛤蟆功，要心狠手辣，奸恶歹毒，你可做得不够呀！\n");
        }
        else
        {
                if (-(int)me->query("shen") < (51200 + (i - 100) * 1000)) 
                        return notify_fail("学蛤蟆功，要心狠手辣，奸恶歹毒，你可做得不够呀！\n");
        }

        if (
        me->query_skill("bahuang-gong",1)
        || me->query_skill("beiming-shengong",1)
        || me->query_skill("bibo-shengong",1)
        || me->query_skill("huagong-dafa",1)
        || me->query_skill("huntian-qigong",1)
        || me->query_skill("hunyuan-yiqi",1)
        || me->query_skill("jiuyang-shengong",1)
        || me->query_skill("kuihua-xinfa",1)
        || me->query_skill("kurong-changong",1)
        || me->query_skill("linji-zhuang",1)
        || me->query_skill("longxiang",1)
//      || me->query_skill("mizong-xinfa",1)
        || me->query_skill("shenlong-xinfa",1)
        || me->query_skill("taiji-shengong",1)
        || me->query_skill("xiantian-qigong",1)
        || me->query_skill("xiaowuxiang",1)
        || me->query_skill("yijinjing",1)
        || me->query_skill("yunlong-shengong",1)
        || me->query_skill("yunv-xinfa",1)
        || me->query_skill("zixia-shengong",1) )
                return notify_fail("你不先散了别派内功，怎能学蛤蟆功？！\n");
        return 1;
}

int practice_skill(object me)
{
   return notify_fail("蛤蟆功只能用学的，或是从运用(exert)中增加熟练度。\n\n");
}
int effective_level() { return 21; }
string *absorb_msg = ({
       YEL "$n一动不动，蓦的“咕！”一声，内力反弹而去。\n",
       YEL "$n浑身肌肤坚如寒铁，丝毫不理会对方的攻击。\n",
       YEL "$n内力澎湃，方圆之类，草木皆惊。\n",
});

string query_absorb_msg()
{
        return absorb_msg[random(sizeof(absorb_msg))];
}
string *strike_parry_msg = ({
        YEL"$n衣衫澎湃，内力汩汩，将$N的攻击尽数弹回。\n",
        YEL"$n长袖一甩，一股大力将$N送出丈外。\n",
        YEL"$n伏地而起，轻描淡写的化解了$N的攻势。\n",
});
string *parry_msg = ({
       YEL"$n衣衫澎湃，内力汩汩，$N根本不可近身。\n",
        YEL"$n长袖一甩，一股大力将$N送出丈外。\n",
        YEL"$n伏地而起，轻描淡写的化解了$N的攻势。\n"
});
string query_parry_msg(object weapon)
{
        if( weapon )
                return parry_msg[random(sizeof(parry_msg))];
        else
                return strike_parry_msg[random(sizeof(strike_parry_msg))];
}

string exert_function_file(string func)
{
       return __DIR__"hamashengong/" + func;
} 
string perform_action_file(string action)
{
       return __DIR__"hamashengong/" + action;
}int bounce_ratio()
{
        return 40;
}

