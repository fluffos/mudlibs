// sanyin benlong 2001-02-16
#include <ansi.h>
#include <combat.h>
inherit F_SSERVER;

#include "/kungfu/skill/eff_msg.h";
int perform(object me, object target)
{
        string msg;
        int damage, p;
        if( !target ) target = offensive_target(me);

         if( !target || !target->is_character()
           || !me->is_fighting(target) || !living(target) )
                return notify_fail("「三阴连环爪」只能在战斗中使用。\n");

        if( objectp( me->query_temp("weapon")) )
                return notify_fail("只有空手才能施展「三阴连环爪」。\n");

        if( (int)me->query_skill("sanyin-zhua", 1) < 130 ||
            (int)me->query_skill("claw", 1) < 130 ||
            (int)me->query_str() < 25)
                return notify_fail("你有的功夫还不够娴熟，不会使用「三阴连环爪」。\n");

        if(!me->query_skill("huagong-dafa", 1))
           if(me->query_skill("huagong-dafa", 1) <130)
                return notify_fail("以你现在的内功修为还使不出「三阴爪连环爪」。\n");

           if (me->query_skill_mapped("force") != "huagong-dafa" )
                return notify_fail("没用化功大法想使出三阴连环爪，你在做梦吧！\n");

        if (me->query_skill_prepared("claw") != "sanyin-zhua" || 
          me->query_skill_mapped("claw") != "sanyin-zhua" )
                return notify_fail("你现在无法使用「三阴连环爪」进行攻击。");

if (me->query_skill_mapped("parry") != "sanyin-zhua" )
            if (me->query_skill_mapped("parry") != "chousui-zhang")
                return notify_fail("你所使用的招架不对。\n");
        if( (int)me->query("max_neili") < 1400 )
                return notify_fail("你以为「三阴连环爪」这么简单出吗？\n");

        if( (int)me->query("neili") < 800 )
                return notify_fail("你的真气好象不够了！\n");
 msg = BLU "\n$N计上心来，突然转身下拜，趁$n一个不注意，猛的使出星宿绝学[三阴连环爪]，爪爪不离$p的头部！\n" NOR;
          if (random(me->query_skill("parry")) >= target->query_skill("parry") / 6)
{

                me->start_busy(1);
                target->start_busy(2);
                damage = (int)me->query_skill("sanyin-zhua", 1);
                damage = (int)me->query_skill("chousui-zhang", 1) +damage;
       damage = (int)me->query_skill("huagong-dafa", 1) +damage;
       damage = damage + random(damage/2);
                target->receive_damage("qi", damage);
                target->receive_wound("qi", damage/3);
             me->add("neili", -200);
                p = (int)target->query("qi")*100/(int)target->query("max_qi");
                msg += damage_msg(damage, "内伤");
                msg += "( $n"+eff_status_msg(p)+" )\n";
                if(me->query_skill("sanyin-zhua", 1) > 100)
                call_out("perform2", 0, me, target);
}
         else {    
                me->start_busy(2);
                me->add("neili", -100);
                msg += HIY"可是$p看破了你的企图，快速的躲开了。\n"NOR;
}
        message_vision(msg, me, target);
        return 1;
}
int perform2(object me, object target)
{
        string msg;

        if (!me || !target) return 0;
        if(!living(target)) 
          return notify_fail("对手已经瘫了，不需要了。\n");

        if( (int)me->query("neili", 1) < 600 )
                return notify_fail("你待要再出爪时，却发现自己的内力不够了！\n");

        msg = BLU "\n接着$N踏前一步，大喝一声：“再看招”！隔空向$n又连出了几爪！\n"NOR;
        if (random(me->query_skill("dodge")) > target->query_skill("dodge") / 3){
                msg += HIR "结果这几爪全中，$n只觉得全身气脉通道阻塞，真气立受干挠！\n"NOR;
                me->start_busy(1);
                target->start_busy(me->query_skill("force",1)/30);
                me->add("neili", -(me->query_skill("force",1)/2));

                if((int)me->query_skill("sanyin-zhua", 1) > 110)
                call_out("perform3", 0, me, target);
}
       else {
           me->start_busy(2);
           me->add("neili", -200);
           target->add("neili", -50);
           msg += HIY"\n$p眼看逼无可逼，身形急向上拔，顺势跳了开去。\n" NOR;
}
        message_vision(msg, me, target);
        return 1;
}
int perform3(object me, object target)
{
        int skill;
        string msg;
        skill = (int)me->query_skill("sanyin-zhua", 1);  
        skill = skill/10;

        if(!living(target)) 
          return notify_fail("对手已经瘫了，不需要了。\n");
        if( (int)me->query("neili", 1) < 400 )
                return notify_fail("你待要再出爪时，却发现自己的内力不够了！\n");

        msg = BLU "\n紧跟着$N第三次爪出，以阴毒之气，同时透入$n百汇穴、
太阳穴、章门穴和$p的天灵盖！\n"NOR; 
        if (random(me->query_skill("force")) > target->query_skill("force") / 2){
                me->add("neili", -200);
                msg += HIR "$n只觉体内奇经八脉中内息为之一怠，全身气力竟然提不起来了！\n" NOR;
                target->add_temp("apply/attack", -100);
                target->add_temp("apply/dodge", -100);
                target->add_temp("apply/parry", -100); 
                target->add("neili", -500);
                call_out("back", 3 + skill, target);
}
else {
                me->start_busy(target->query_skill("force",1)/50);
                me->add("neili", -300);
                target->start_busy(2);
                msg += HIY"\n$p喘息未定，见$P双爪又如狂风般爪来，连忙又跃开数尺，狼狈地避开。\n" NOR;
}
        message_vision(msg, me, target);
        return 1;
}
void back(object target)
{
    if (!target) return;
        target->add_temp("apply/attack", 100);
        target->add_temp("apply/dodge", 100);
        target->add_temp("apply/parry", 100);
}
