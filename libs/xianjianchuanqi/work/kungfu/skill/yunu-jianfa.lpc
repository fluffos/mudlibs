// yunu-jianfa 玉女剑法
#include <ansi.h>
#include <power_control.h>
inherit SKILL;
string *msg = ({
"$N击高而下，一式「雁行斜击」，腾身下击，剑尖直点$n头部",
"$N踏前数步，左手遥指，右手$w使一式「浪迹天涯」直劈$n的右肋",
"$N一招「花前月下」，$w颤动如鲜花招展风中，来回挥削",
"$N剑尖上翻，竟然指向自己的樱唇，一招「清饮小酌」，宛若举杯自饮一般，横扫$n的$l",
"$N使出「抚琴按箫」，$w自横脐前，做抚琴状，随即剑出中宫，平削$n的$l",
"$N横剑斜削，微微二颤，一招「彩笔画眉」，构成帘下梳妆之状，一脸娇羞，$w却丝毫未有停留，逼向$n的$l",
"$N一招「举案齐眉」，双手齐握剑柄，举剑上挑，直划$n的档部",
"$N向前急进两步，一招「木兰回射」，蓦地里挺剑反手向背后刺出，直刺$n的胸口",
"$N一招「分花拂柳」，$w似左实右，似右实左，虚实莫辩，点向$n的喉头",
"$N眼角尽是笑意，眉目含情，一招「如影相随」，人似清风影随$n周身，身形飘飘中剑光熠熠生辉，",
});

int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }
int valid_learn(object me)
{
        if ((int)me->query("max_neili") < 100)
                return notify_fail("你的内力不够。\n");
        if ((int)me->query_skill("yunu-xinjing", 1) < 20)
                return notify_fail("你的玉女心经功力不够。\n");
        return 1;
}

mapping query_action(object me, object weapon)
{
        int level;
        string a_msg;
        level = (int)me->query_skill("yunu-jianfa",1);
        a_msg=msg[random(sizeof(msg))] ;
        if( random(level) > level - level/6  &&  (int)me->query_temp("gumu_hebi")==1 )
                a_msg=select_color() + a_msg + NOR;
        return (["damage_type":random(2)?"刺伤":"割伤","action":a_msg ])
                + query_my_power(me,level,at_type_weapon,attack_lvl_normal,defense_lvl_normal);
}

int practice_skill(object me)
{
        object weapon;

        if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
                return notify_fail("你使用的武器不对。\n");
        if ((int)me->query("jingli") < 50)
                return notify_fail("你的体力不够练玉女剑法。\n");
        me->receive_damage("jingli", 50);
        return 1;
}
string perform_action_file(string action)
{
        return __DIR__"yunu-jianfa/" + action;
}
