// yufeng.c 银索金铃--「乐音绝技」
// By River

#include <ansi.h>

inherit F_SSERVER;
void check_fight(object me,object target,int count);
int perform(object me, object target)
{
        string msg ;
        object weapon,weapon1; 
        int i,j = 1; 
      
        weapon = me->query_temp("weapon");

        if( !target )
             target = offensive_target(me);

        if( !target
         || !target->is_character()
         || !me->is_fighting(target))
             return notify_fail("「神门十三剑」只能对战斗中的对手使用。\n");

        if( !weapon 
         || me->query_skill_mapped("sword") != "taiji-jian"
         || me->query_skill_mapped("parry") != "taiji-jian"
         || weapon->query("skill_type") != "sword") 
             return notify_fail("你现在无法使用「神门十三剑」攻击对方。\n");

        if((int)me->query_skill("yinyun-ziqi", 1)  < 160 )
             return notify_fail("你的氤氲紫气等级还不够，使不出「神门十三剑」。\n");

        if((int)me->query_skill("taiji-jian",1) < 160 ) 
             return notify_fail("你的太级剑法还不够娴熟，不能使用「神门十三剑」。\n");
        if((int)me->query-skill("tiyunzong",1)<160)
             return notify_fail("你的梯云纵不够娴熟，不能使用[神门十三剑]。 \n");

        if((string)me->query_skill_mapped("sword") !="taiji-jian")
             return notify_fail("你必须将太级剑法作为你的剑法使用。\n");

        if((int)me->query("neili") < 1000)
             return notify_fail("你的内力不够用来使用「神门十三剑」。\n");

//        if( target->is_busy())
//             return notify_fail(target->name()+"正自故不暇，你可以放胆攻击。\n");
      
        if( userp(me) && (string)me->query("family/family_name") != "武当派")
             return notify_fail("你不是武当派的传人，怎么会使用「神门十三剑」！\n"); 

           msg=HIW"\n$N使出[神门十三剑]"，手中+weapon->name()+HIW"+“每一剑剌出，无不精妙绝论。\n"NOR;
        
        me->add("neili", -200);
        me->add("jingli", -50);

        i = (int)me->query_skill("taiji-jian", 1);
        
        i /= 9;
       
        weapon1 = target->query_temp("weapon");

        if( weapon1 && weapon1->query("skill_type") =="sword"){
         if( random((int)me->query("combat_exp")) > (int)target->query("combat_exp")/2
          || !living(target)){
           msg += HIR"\n$N使出[神门十三剑],手中"+weapon->name()+HIR"每一剑剌出，无不精妙绝论，$n手腕上中了一击，被迫放弃了手中的"+weapon1->name()+HIR"。\n"NOR;
           msg += HIR" $n手腕中剑，手腕使不上力气，不由得丢下手中的"+weapon1->name()+HIR"。\n"NOR;
           message_vision(msg, me, target);
//           weapon->unequip(); 
           weapon1->unequip();
//           weapon1->wield();
           me->add("neili", -200);
           target->start_busy(2);
           me->set_temp("taiji/shenmen", 1);
           me->add_temp("apply/damage", i);
           me->add_temp("apply/attack", i);
           me->add_temp("apply/dexerity", i);
           COMBAT_D->do_attack(me, target, me->query_temp("weapon"), j);
           if (present(target,environment(me)) && me->is_fighting(target))
           COMBAT_D->do_attack(me, target, me->query_temp("weapon"), j);
           if (present(target,environment(me)) && me->is_fighting(target))
           COMBAT_D->do_attack(me, target, me->query_temp("weapon"), j);

           }
           me->add_temp("apply/damage", -i);
           me->add_temp("apply/attack", -i);
           me->add_temp("apply/dexerity", -i);
           me->delete_temp("juan");
         }
         else {
           msg +=CYN"\n$n何等老练，不等$N招数使老，身行纵出数丈，躲开了这招。\n"NOR;
           message_vision(msg, me, target);
           me->start_busy(1+random(2));
           target->add("jingli", -70);
         }
         me->start_perform(2,"「神门十三剑」");
         return 1;
        }
        
}

int check_fight(object me, object target) 
{
      string msg;
      object wep;
      me = this_player();
      if( !me) return 1;
      if( !target ) target = offensive_target(me);
      wep = me->query_temp("weapon");
      if(!target 
       || environment(me) != environment(target)
       || !present((string)target->query("id"), environment(me))
       || !me->is_fighting(target)
       || !living(target)
       || !living(me)
       || me->is_ghost()
       || !me->is_fighting()
       || !wep
       || !objectp(wep)
       || me->query_skill_mapped("sword") != "taiji-jian"
       || (string)wep->query("skill_type") != "sword"){
          msg = HIY"\n$N「神门十三剑」使完，你觉得身上压力顿减。\n\n"NOR;
          me->delete_temp("tjj/shenmen");
      }
      else {
          call_out("check_fight", 1, me, target);
          return 1;
      }
      message_vision(msg, me, target);
      return 1;
}