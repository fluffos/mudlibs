// yiyang-zhi 一阳
#include <ansi.h>

inherit F_SSERVER;

int perform(object me, object target) {
  int lvl;
  object weapon;
  weapon = me->query_temp("weapon");
  lvl = ((int)me->query_skill("yiyang-zhi", 1)) * 2;
  if (!target) target = offensive_target(me);
  // add by benlong for need  meet 一灯     
  if (!target || !me->is_fighting(target))
    return notify_fail("只能在战斗中对对手使用。\n");
  if (objectp(me->query_temp("weapon")))
    return notify_fail("你必须空手才能使用！\n");
  if ((int)me->query_skill("yiyang-zhi", 1) < 180)
    return notify_fail("你的一阳指不够娴熟，不能使用！\n");
  if ((int)me->query_skill("finger", 1) < 180)
    return notify_fail("你的基本指法等级不够，不能使用！\n");
  if ((int)me->query_skill("qiantian-yiyang", 1) < 180)
    return notify_fail("你的乾天一阳功等级不够，不能使用！\n");
  if ((int)me->query_skill("force", 1) < 180)
    return notify_fail("你的基本内功等级不够，不能使用！\n");
  if ((int)me->query("max_neili") < 2000)
    return notify_fail("你的内力太弱，不能使用！\n");
  if ((int)me->query("neili") < 1000)
    return notify_fail("你的内力太少了，无法使用出！\n");
  if ((int)me->query_temp("tls_yyz"))
    return notify_fail("你刚刚用了绝技，需要调整内息。\n");

  if (me->query_skill_prepared("finger") != "yiyang-zhi"
    || me->query_skill_mapped("finger") != "yiyang-zhi")
    return notify_fail("你现在无法使用「一阳」进行攻击。\n");

  message_vision(HIY "\n$N食指缓缓点出，发出“嗤嗤”声响，指风带动衣袖飞舞。劲风到处，热气扑面，
接着又纵身飞起，以纯阳内功，发出一阳指绝技。$n看的头晕目眩，待到
醒悟过来，$N的一阳劲气已到跟前！\n" NOR, me, target);
  me->set_temp("tls_yyz", 1);
  me->add("neili", -200);
  me->add("jingli", -100);
  me->add_temp("apply/strength", lvl);
  me->add_temp("apply/dexerity", lvl);
  target->start_busy(2);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1);
  //      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1)
  //      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 1)
  me->add_temp("apply/strength", -lvl);
  me->add_temp("apply/dexerity", -lvl);
  call_out("remove_effect", me->query_con() / 6, me);
  return 1;
}
void remove_effect(object me) {
  if (!me) return;
  me->delete_temp("tls_yyz");
  tell_object(me, HIB "\n你调整完毕，又可以使用「一阳」绝技了。\n" NOR);
}
