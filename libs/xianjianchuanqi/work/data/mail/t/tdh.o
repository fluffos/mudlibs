#/clone/misc/mailbox.c
dbase (["id":"mailbox","name":"信箱","owner_id":"tdh","no_drop":1,"no_insert":1,"unit":"个","long":"┌───────────────────────────────┐│这是一个用来寄信、收信的信箱，你可以用以下指令来处理你的邮件  ││mail <某人 id>               寄信给别人。                     ││forward <信件编号> <某人 id> 将某封信转寄给别人。             ││from                        查看信箱中的信件。                ││read <信件编号>              阅读一封信件。                   ││discard <信件编号>           丢弃一封信件。                   │└───────────────────────────────┘                  希望您能够遵守规定，不要发垃圾邮件。	",])
mails ({(["text":"我看这个是怎么用的,呵呵!","title":"哈哈","from":"饿沙罗鬼(jyong)","time":994157504,"to":"tdh",]),})
