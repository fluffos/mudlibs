        msg+=HIB\"▂▂▂▂▂▂▂▂▂▂▂▂▂▂▂▂▂▂▂▂▂▂▂▂▂▂▂▂▂▂▂▂▂▂▂\\n\"NOR;
        
        obj=objects();
         obj=filter_array(obj,(: clonep($1) && $1->query(\"treasure\")==0:));
