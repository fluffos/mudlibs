","time":985613816,]),(["title":"about commandd.c","author":"另糊葱(yixian)","msg":"mapping search = ([]);
一个空映射
void rehash(string dir)
{
        int i;
        string *cmds;

        if( dir[<1]!='/' ) dir += \"/\";
有关像什么阵列中的
string *a
a[<2..<2]这类的东西我不太懂，kismet有空给我讲讲
上面的if可能是在判断，如果所打的dir中最后不是以/结束，那么在最后加上\"/\"
        cmds = get_dir(dir);
把dir这个目录中的所有文件以阵列的方式给cmds
不过我不知道给完的是string 还是什么别类型，不过我想应该是string 类型的
        i = sizeof(cmds);
        while(i--)
                if( !sscanf(cmds[i], \"%s.c\", cmds[i]) )
                        cmds = cmds[0..i-1] + cmds[i+1..<1];
这个cmds[0..i-1]我不懂是什么意思，所以无法解释
        if( sizeof(cmds) )
                search[dir] = cmds;
把cmds的内容给search[dir]这个映射
}

string find_command(string verb, string *path)
{

        int i;

        if( !pointerp(path) ) return 0;
看path是否为一个array
        i = sizeof(path);
        while(i--) {
                if( undefinedp(search[path[i]]) ) rehash(path[i]);
看search[path[i]]是否定义了，如果没定义，那么则调用rehash 重新给search里加内容
                if( undefinedp(search[path[i]]) ) continue;
如果serrch[path[i]]还是没有被定义，那么则继续下一项
                if( member_array(verb, search[path[i]])!=-1 )
如果verb在search[path[i]]中为第-1项出现，那么return ....

                        return path[i] + verb;
        }
        return 0;
}

大概就么多吧

