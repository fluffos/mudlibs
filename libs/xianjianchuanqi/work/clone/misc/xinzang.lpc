// head.c -脑袋
#include <ansi.h>
inherit ITEM;
int decayed;

void create() {
  set_name(RED "心脏" NOR, ({ "xinzang" }));
  set_weight(300);
  set("unit", "颗");
  set("value", 0);
  set("long", RED "一颗鲜血淋淋的人的心脏,余血正缓缓渗出,真是好残忍啊！\n" NOR);
  decayed = 0;
  if (clonep(this_object())) call_out("decay", 120, 1);
}

int is_corpse() { return decayed < 2; }
int is_character() { return decayed < 1; }
int is_container() { return 1; }

string short() { return name() + "(" + capitalize(query("id")) + ")"; }

void decay(int phase) {
  decayed = phase;
  switch (phase) {
    case 1:
      say(query("name") + "心脏开始腐烂了，发出一股难闻的恶臭。\n");
      set_name("腐烂的心脏", ({ "xinzang" }));
      set("long", "这颗心脏显然已经腐烂了一段时间了，一股恶臭夹杂血腥的味道。\n");
      call_out("decay", 120, phase + 1);
      break;
    case 2:
      say(query("name") + "被风吹乾了，变成一个干心。\n");
      set_name("一颗干心", ({ "ganxin" }));
      set("long", "这颗干心已经放躺在这里有些时候了。\n");
      call_out("decay", 60, phase + 1);
      break;
    case 3:
      say("一阵风吹过，把" + query("name") + "化成粉末吹散了。\n");
      if (environment()) {
        object *inv;
        int i;

        inv = all_inventory(this_object());
        for (i = 0; i < sizeof(inv); i++) inv[i]->move(environment());
      }
      destruct(this_object());
      break;
  }
}
