// tianyu.c 天羽剑
#include <ansi.h>
#include <weapon.h>
inherit SWORD;
inherit F_UNIQUE;
void create()
{
        set_name(HIR"天羽剑"NOR, ({"tianyu jian", "sword", "tianyu"}));
        set_weight(15000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "把");
             set("long",HIY"这把天羽剑长一尺，乃用嘉兴南湖底千年神石铸成，剑上铸有飘渺地图，大剑里头套小剑，一般多为姑娘佩剑,随手一抽,铮！铮！铮！响声良久不绝。\n" NOR);
                set("value", 1);
                set("unique", 1);
                set("rigidity", 5);
                set("sharpness", 3);
                set("material", "blacksteel");
                set("weapon_prop/dodge", 5);
                set("weapon_prop/parry", 5);
                set("treasure",1);       
                set("wield_neili", 300);
                set("wield_maxneili", 700);
                set("wield_str", 20);        
                set("skill", ([
                        "name": "sword",
                        "exp_required": 50000,
                        "difficulty": 25,
                        "min_skill":  50,
                        "max_skill": 100,                       
                ]) );
             set("wield_msg", 
    HIY"\n当□□一阵响亮，$N从腰里扒出天羽剑。这天羽剑径长一尺，乃用嘉兴南湖底千年神石铸成，剑上铸有飘渺地图,
,随手一抽,铮！铮！铮！响声良久不绝。\n\n" NOR);
             set("unwield_msg",HIY"$N将$n"HIY"一摆，当哐哐一阵响，放回腰间。\n"NOR);
               }
        init_sword(130);
        setup();
}
