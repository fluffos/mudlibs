// tianlongjian 天龙剑 benlong 2001-02-21
#include <weapon.h>
#include <ansi.h>

inherit SWORD;
inherit F_UNIQUE;

void create()
{
      set_name(HIC"天龙剑"NOR,({ "tianlong sword", "tianlong", "sword", "jian" }) );
        set_weight(20000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("rigidity", 5);
                set("sharpness", 5);
                set("value", 1);
                set("unique", 1);
//                set("no_drop", 1);
                set("material", "steel");
                set("weapon_prop/dodge", -5);
                set("weapon_prop/parry", 5);
                set("weapon_prop/sword", 2);
                set("treasure",1);
                set("wield_neili", 400);
                set("wield_maxneili", 600);
set("wield_msg", HIC"$N“唰”的一声抽出大理王府镇宫之宝天龙宝剑，只见剑身隐隐发出一层清气。\n$N不由得赞叹道：“好剑，好剑”！\n"NOR);
set("long", "这是一支大理世代相传的镇宫之宝，上面镶嵌这“天龙”二字。\n一看就知道并非凡物。;\n");
set("unwield_msg", HIC "$N缓缓将天龙剑插入剑鞘，周围的人都舒了一口气。\n" NOR);
}
         init_sword(100);
        setup();
}
