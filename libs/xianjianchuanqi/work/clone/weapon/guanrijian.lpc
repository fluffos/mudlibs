// guanrijian 观日剑 benlong 2001-02-15
#include <weapon.h>
#include <ansi.h>
inherit SWORD;
inherit F_UNIQUE;
void create()
{
        set_name(HIR"观日剑"NOR,({ "guanri jian", "sword", "jian" }) );
        set_weight(20000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("rigidity", 5);
                set("sharpness", 5);
                set("unique", 1);
//               set("no_get", 1);
//                set("no_steal", 1);
//                set("no_drop", 1);
                set("material", "steel");
                set("weapon_prop/dodge", 5);
                set("weapon_prop/parry", 5);
                set("treasure",1);
                set("wield_neili", 850);
                set("wield_maxneili", 850);
set("wield_msg", HIR"$N“唰”的一声抽出$n"HIR"挽了个剑花，但见寒芒吞吐，电闪星飞。
$N不由得从心底升起一股邪气，欲得天下而后快。\n"NOR);
set("long", "这是一柄四尺来长的古剑，剑上虽然锈记斑斑但
整个剑身隐隐发出一层青气，剑未出鞘，已可见其不凡。\n");
 set("unwield_msg", HIY "$n"HIR"已幻作一道红光，「唰」地飞入剑鞘。\n" NOR);                
}
         init_sword(110);
        setup();
}

