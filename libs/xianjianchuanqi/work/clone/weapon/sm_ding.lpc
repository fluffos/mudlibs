inherit ITEM;
#include "/inherit/item/embed.h"
void create()
{
        set_name("丧门钉", ({ "sangmen ding","sangmen","ding" }) );
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
               set("damage", 5);
               set("value", 100);
               set("unit", "枚");
               set("embed", 1);
        }
        setup();
}

