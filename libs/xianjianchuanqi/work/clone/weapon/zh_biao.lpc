inherit ITEM;
#include "/inherit/item/embed.h"
void create()
{
        set_name("追魂镖", ({ "zhuihun biao","zhuihun","biao" }) );
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
               set("damage", 7);
               set("value", 150);
               set("unit", "只");
               set("embed", 1);
        }
        setup();
}

