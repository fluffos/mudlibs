// guanrijian 观日剑 benlong 2001-02-15
#include <weapon.h>
#include <ansi.h>
inherit SWORD;
inherit F_UNIQUE;
void create()
{
              set_name(HIY"长歌剑"NOR,({ "changge sword", "changge", "sword" }) );

        set_weight(20000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("rigidity", 5);
                set("sharpness", 5);
                set("unique", 1);
                set("no_get", 1);
                set("no_give", 1);
                set("no_steal", 1);
                set("no_drop", 1);
                set("material", "steel");
                set("weapon_prop/dodge", -5);
                set("weapon_prop/parry", 5);
                set("treasure",1);
                set("wield_neili", 850);
                set("wield_maxneili", 850);
set("wield_msg", HIR"$N“唰”的一声抽出长歌剑挽了个剑花，轻弹剑身，剑发龙吟。\n$N不由得赞叹道：“好剑，好剑”！\n"NOR);
set("long", "这是一支用鲜血制作而成的绝世宝剑，上面镶嵌这“长歌”二字。\n看起来威力无穷，令人爱不释手。;\n");
set("unwield_msg", HIR "$N长叹道：“长歌既出，谁避其锋”？缓缓将$n"HIR"插入剑鞘。\n" NOR);
}
         init_sword(100);
        setup();
}

