// /clone/weapon/longyin-dao.c
// by rockman
#include <weapon.h>
#include <ansi.h>
inherit BLADE;
inherit F_UNIQUE;

void create() {

  set_name(HIY "龙吟刀" NOR, ({ "longyin dao", "longyin", "blade", "dao" }));
  set_weight(15000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("rigidity", 8);
    set("sharpness", 5);
    set("long", "一把充满了王室气息的宝刀，曾经是当年大燕王国的御用宝器。\n");
    set("value", 1);
    set("unique", 1);
    set("weapon_prop/dodge", 10);
    set("weapon_prop/parry", 20);
    set("material", "steel");
    set("wield_neili", 100);
    set("wield_maxneili", 1000);
    set("wield_str", 25);
    set("wield_msg", HIY "只听「唰」的一声，龙吟刀脱鞘飞出，犹如一条飞舞的长龙，泛着金光，弥漫着一片霸气！\n" NOR);
    set("unwield_msg", HIY "只见$N随手一挥,龙吟刀象一条金龙飞舞入鞘。\n" NOR);
    set("treasure", 1);
  }
  init_blade(120);
  setup();
}
