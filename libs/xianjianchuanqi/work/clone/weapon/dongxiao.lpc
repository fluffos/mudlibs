///u/jpei/thd/obj/biyuxiao.c 碧玉箫
#include <weapon.h>
#include <ansi.h>

inherit SWORD;
void create()
{
        set_name(HIW"洞箫"NOR,({"dong xiao","xiao"}));
        set_weight(1000);
        if (clonep())
                set_default_object(__FILE__);
        else{
                set("unit","支");
                set("value",0);
                set("material", "steel");
                set("no_get", 1);
                set("treasure", 1);       
                set("rigidity", 5);
                set("unique", 1);
                set("rigidity", 5);
                set("weapon_prop/dodge", 5);
                set("weapon_prop/parry", 2);
                set("wield_neili", 500);
                set("wield_maxneili", 1600);
          set("long","这是一支东邪黄药师心爱的"HIW"洞箫"NOR"。\n");
                set("wield_msg","$N伸手轻轻一招，一支$n已出现在$N手中。\n");
                set("unwield_msg","$N一声清啸，将$n插回腰间。\n");
                set("drop_msg","你将$n扔在地上，$n一闪便不见了。\n");
        }
        init_sword(140);
        setup();
}
