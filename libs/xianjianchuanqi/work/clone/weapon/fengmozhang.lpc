#include <ansi.h>
#include <weapon.h>
inherit STAFF;
inherit F_UNIQUE;
void create()
{
        set_name(BLU "疯魔杖" NOR, ({ "fengmo zhang", "zhang", "fengmo","staff" }));
        set_weight(21000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "根");
       set("long", BLU"这是一根用玄铁所铸成的杖，很有点分量。\n"NOR);
                set("no_give",1 );
                set("no_drop",1 );
                set("unique", 1);
                set("rigidity", 5);
                set("material", "steel");
                set("weapon_prop/parry", 5);
                set("weapon_prop/dodge", -3);
                set("treasure",3);
                set("wield_neili", 600);
                set("wield_maxneili", 1200);
                set("wield_str", 23);
      set("wield_msg", BLU"$N横握起疯魔杖,果然威风凛凛，不同凡响！\n"NOR);
                set("unwield_msg", BLU"$N将疯魔杖舞成一道黑气，顺势插在身后。\n"NOR);
}
        init_staff(130);
        setup();
}
