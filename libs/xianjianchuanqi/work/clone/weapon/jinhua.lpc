inherit ITEM;
#include "/inherit/item/embed.h"
void create()
{
               set_name(HIY "金花" NOR, ({"jin hua", "jin", "hua" }));
               set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
               set("damage", 20);
               set("value", 3500);
               set("unit", "颗");
               set("embed", 1);
        }
        setup();
}



