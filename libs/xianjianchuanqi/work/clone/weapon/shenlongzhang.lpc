#include <ansi.h>
#include <weapon.h>
inherit STAFF;
inherit F_UNIQUE;
void create() {
  set_name(HIB "神龙杖" NOR, ({ "shenlong zhang", "zhang", "shenlong", "staff" }));
  set_weight(21000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("long", "这是神龙教镇教至宝，" HIB "“神龙杖”。\n" NOR);
    set("no_drop", 1);
    set("unique", 1);
    set("rigidity", 5);
    set("material", "steel");
    set("weapon_prop/parry", 5);
    set("weapon_prop/dodge", -6);
    set("treasure", 1);
    set("wield_neili", 600);
    set("wield_maxneili", 1200);
    set("wield_str", 23);
    set("wield_msg", HIB "$N大声说道：" HIR "“教主宝训,时刻在心,建功克敌,无事不成!”" HIB "，随即横握起神龙杖，满脸杀气。\n" NOR);
    set("unwield_msg", HIB "$N大声说道：" HIR "“众志齐心可成城,威震天下无比伦!”" HIB "，将神龙杖插到了背后。\n" NOR);
  }
  init_staff(100);
  setup();
}
