inherit ITEM;

void create()
{
        set_name( "逍遥刀法总决",({ "xiaoyaodao book","book"}));
        set_weight(200);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
                set("long","这是一本逍遥子亲写的刀法要决。\n");
                set("value", 0);
            set("monitored",1);
            set("no_drop", 1);
            set("no_give", 1);
            set("no_put", 1);
                set("material", "paper");
                set("skill", ([
                        "name":         "blade",      //name of the skill
                        "exp_required": 10000,        //minimum combat experience required
                        "jing_cost":    25+random(10),// jing cost every time study this
                        "difficulty":   20,           // the base int to learn this skill
                        "min_skill":    30,           // the minimum level you can learn
                        "max_skill":    120            // the maximum level you can learn
                ]) );
        }
}

