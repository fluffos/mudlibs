/* -*- LPC -*- */
/**
 * Room-level document handler. Archive never shipped
 * /std/room/document_handler; furniture inherit has the logic and
 * documents init_room() for room use. Pattern matches newspaper_office.
 */
inherit "/std/room/basic_room";
inherit "/std/room/furniture/inherit/document_handler";
inherit "/std/basic/auto_load";

#include <room/document_handler.h>

private nosave string _save_dir;

void create() {
   do_setup++;
   document_handler::create();
   basic_room::create();
   do_setup--;
   add_help_file("document_handler");
   if ( !do_setup ) {
      this_object()->setup();
      this_object()->reset();
   }
} /* create() */

void init() {
   basic_room::init();
   init_room();
} /* init() */

string query_save_dir() {
   return _save_dir;
} /* query_save_dir() */

void set_save_dir(string dir) {
   _save_dir = dir;
} /* set_save_dir() */

void save_me() {
   /* Room leaves persist documents via set_save_dir + restore path. */
} /* save_me() */

int is_open_for(string type, string name) {
   return 1;
} /* is_open_for() */
