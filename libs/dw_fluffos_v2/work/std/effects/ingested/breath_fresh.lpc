// adopted from skylib 2026-10-22: end() acts on its player argument instead of this_player()
#include <effect.h>

string query_classification() { return "misc.breath-clean"; }

int beginning( object player, int time ) {
  player->submit_ee( 0, 2, EE_REMOVE );
} 
 
void end( object player, int time ) {
  int *effnum;
  effnum = (int *)player->effects_matching("mouth.smell.garlic");
  if(effnum == ({ }))
    return;
  player->delete_effect(effnum[0]);
}

