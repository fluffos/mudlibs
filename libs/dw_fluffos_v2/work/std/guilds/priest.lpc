/**
 * Priests' Guild guild object. Restored for race.lpc guild map (§6.15).
 */
#include <config.h>

inherit "/std/guilds/standard";

void setup() {
  set_name("priests");
  set_short("Priests' Guild");
  set_long("The Priests Guild is about worshipping a god (or goddess).\n");
  set_gp_skill("faith.points");
  set_start_pos(CONFIG_START_LOCATION);
  set_skills(({ "faith.rituals.offensive.area",
                "faith.rituals.offensive.target",
                "faith.rituals.defensive.area",
                "faith.rituals.defensive.self",
                "faith.rituals.defensive.target",
                "faith.rituals.curing.self",
                "faith.rituals.curing.target",
                "faith.rituals.misc.area",
                "faith.rituals.misc.self",
                "faith.rituals.misc.target",
                "faith.rituals.special",
                "faith.items.rod",
                "faith.items.scroll",
                "faith.points"
                
  }));
} /* setup() */

varargs int query_skill_cost(string skill) {
  string *bits;
  if(member_array(skill, skills) != -1)
    return 3;
  bits = explode(skill, ".");
  switch(bits[0]) {
    case "faith" :
      return 5;
    case "fighting" :
      return 15;
    case "covert" :
      return 20;
    case "magic" :
      return 50;
    case "faith" :
      return 20;
    default :
      return 10;
  }
} /* query_skill_cost() */

varargs int query_skill_max_level( string skill ) {
  string *bits;
  if ( member_array( skill, skills ) != -1 )
    return 400;
  bits = explode( skill, "." );
  switch( bits[ 0 ] ) {
    case "faith" :
      return 50;
    default:
      return 40;
  }
} /* query_skill_max_level() */
