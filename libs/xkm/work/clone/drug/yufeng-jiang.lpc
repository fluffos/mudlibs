#include <ansi.h>

inherit PILL;

void create() {
  set_name(GRN "玉蜂浆" NOR, ({ "yufeng jiang", "jiang" }));
  set_weight(90);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "瓶");
    set("long", "这是一瓶玉蜂浆，发出一阵阵沁人心脾的香气。\n");
    set("no_drop", "玉蜂浆来的不易，哪能乱扔！ \n");
    set("value", 10000);
    set("medicine", 1);
  }
  setup();
}

int cure_ob(object me) {
  if (me->query_condition("cool_drug") > 0) {
    me->add("max_neili", -1);
    message_vision(HIR "$N服了一瓶甜美的玉蜂浆，只觉得头重脚轻，摇摇欲倒，原来服食太急太多，药效适得其反！\n" NOR, me);
    destruct(this_object());
    return 1;
  }
  me->set("eff_jing", (int)me->query("max_jing"));
  me->add("jing", 200);
  me->add("jingli", 200);
  me->set("eff_qi", (int)me->query("max_qi"));
  me->add("qi", 200);
  message_vision(HIG "$N服下一瓶玉蜂浆，一股清香之气直透丹田，只觉得精神健旺，气血充盈，体内真力源源滋生，将疲乏一扫而空! \n" NOR, me);
  me->apply_condition("cool_drug", 30);
  destruct(this_object());
  return 1;
}
void init() {
  add_action("do_pour", "drop");
}
int effect_in_liquid(object ob) {
  tell_object(this_player(),
    HIG "你只觉得体内真力源源滋生，不绝如缕。\n" NOR);
  this_player()->add("neili", (random(1000) + 1000) / ob->query("max_liquid"));
  if (this_player()->query("neili") > this_player()->query("max_neili") * 3 / 2)
    this_player()->set("neili", this_player()->query("max_neili") * 3 / 2);
  return 0;
}
