//Cracked by program

#include <weapon.h>
#include <ansi.h>
inherit BLADE;

void create() {
  set_name(HIY "龙凤铮" NOR, ({ "longfeng zheng", "zheng" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("value", 5000);
    set("shape", "flute");
    set("material", "steel");
    set("long", "一张雕龙刻凤的铁铮，好像只有武林中人才用这样的铮。\n");
    set("wield_msg", HIY "$N用右手托起一张龙凤铮，左手轻拂琴弦。\n" NOR);
    set("unwield_msg", HIM "$N嫣然一笑，轻轻放下龙凤铮。\n" NOR);
  }
  init_blade(50);
  setup();

}
#include "/d/taohua/obj/flute.h"
#include "/d/lingjiu/obj/music.h"
