//program's board

#include <ansi.h>
inherit BULLETIN_BOARD;

void create() {
  set_name(HIY "放告牌" NOR, ({ "board" }));
  set("location", "/u/wuqing/workroom");
  set("board_id", "program_b");
  set("long", HIG "留下你的心情。\n" NOR);
  setup();
  set("capacity", 100);
  replace_program(BULLETIN_BOARD);
}
