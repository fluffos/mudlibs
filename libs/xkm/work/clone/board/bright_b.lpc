// /clone/board/bright_b.c

#include <ansi.h>
inherit BULLETIN_BOARD;

void create()
{
        set_name(HIW"明亮笔记本"NOR, ({ "board" }) );
        set("location", "/u/bright/workroom");
        set("board_id", "bright_b");
        set("long", "这是明亮和各位巫师工作交流的留言板。\n" );
        setup();
        set("capacity", 100);
        replace_program(BULLETIN_BOARD);
}
