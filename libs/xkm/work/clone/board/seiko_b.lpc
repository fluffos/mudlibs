// /clone/board/seiko_b.c

#include <ansi.h>
inherit BULLETIN_BOARD;

void create() {
  set_name(HIW "无常的留言板" NOR, ({ "board" }));
  set("location", "/u/seiko/workroom");
  set("board_id", "seiko_b");
  set("long", "这是无常和各位巫师工作交流的留言板。\n");
  setup();
  set("capacity", 100);
  replace_program(BULLETIN_BOARD);
}
