// /clone/board/tianya_b.c

#include <ansi.h>
inherit BULLETIN_BOARD;

void create() {
  set_name(HIR "笑天涯的留言板" NOR, ({ "board" }));
  set("location", "/u/tianya/workroom");
  set("board_id", "tianya_b");
  set("long", "这是笑天涯和各位巫师工作交流的留言板。\n");
  setup();
  set("capacity", 100);
  replace_program(BULLETIN_BOARD);
}
