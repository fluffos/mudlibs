#include <ansi.h>
inherit BULLETIN_BOARD;

void create() {
  set_name(HIW "孤独的留言板" NOR, ({ "board" }));
  set("location", "/u/zzx/workroom");
  set("board_id", "zzx_b");
  set("long", "这是海洋和各位巫师工作交流的留言板。\n");
  setup();
  set("capacity", 100);
  replace_program(BULLETIN_BOARD);
}
