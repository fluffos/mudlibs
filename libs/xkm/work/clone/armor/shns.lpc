// jingang-zhao.c

#include <armor.h>
#include <ansi.h>
inherit CLOTH;
inherit F_UNIQUE;
void create() {
  set_name(HIR "圣火霓裳" NOR, ({ "shenghuo nishang", "shenghuo", "nishang" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一件历代波斯圣女相传的圣装,全由白色的" HIW "天蚕丝" NOR "织成,极轻薄,胸前赫然有一朵红色的" HIR "火焰" NOR ",
" HIR "火焰" NOR "美丽中透着诡异,似乎能灼伤人。\n");
    set("material", "silk");
    set("unit", "件");
    set("unique", 1);
    set("value", 1000000);
    set("wear_msg", HIR "只见红霞流动,白云飘逸,一道丽彩笼罩了全身,冰清玉洁,仿似天上仙女下凡,$N披上了一件圣火霓裳。\n" NOR);
    set("remove_msg", HIR "红霞轻拂,白云隐散,灵光顿失,$N卸除了圣火霓裳。\n" NOR);
    set("armor_prop/armor", 200);
  }
  setup();
}
