#/clone/board/xkxmud_b.c
dbase (["notes":({(["author":"☆侠客☆(xkxmud)","title":"to jhy(2002.09.04)","time":1031222387,"threadID":"xkxmud","msg":"※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※大哥，这几天没上了网，因为学校机器出问题了，换了教室之后刚开始还可以，后来就上不去了！xkx的lib我已经拷回家了，借了一个32兆的优盘，这几天想了一些东西：　　⒈修改 sleep 指令——〉添加随机做梦（根据好梦、噩梦或者普通的梦以及不做梦来决定睡觉时恢复的 hp ，然后对一些有特点的梦可以加上一些解梦的内容（纯属娱乐，可以不加）。　　⒉增加一个占卜屋（可以先测试一段时间，之后再决定开放与否），在占卜屋可以有两种占卜方式：①对于 sleep 中相应的梦的解释（只是解释，不需要之后有什么其他结果，这也可以通过用 msgd 或者我那天加的 xkxmud_msgd 来完成，因为只是娱乐）；②这点是开设占卜屋的最初起点设想，也是重点，就是开设占卜屋与否决定于这个想法可不可行：在占卜屋中交纳一定数量的 gold 可以进行占卜，每天只能占卜一次，占卜的结果只有好与坏两种（但可以在语言描述上通过random() 分为数种），当连续十天（这个时间可以再研究，因为时间长短决定了这个 quest 的难度）抽到好签或者坏签（实际想象不是用抽签方式，这样说起来教容易懂），就会对 kar 进行修改(random(3))最大值不超过30 ，之后给 player 作个标记，每人一生只能加一次福缘占卜的前提条件是15<=kar<=30 ，然后在 player 进入占卜屋时判断是否曾经占卜过［undefinedp(obzhanbu)］，如果为　true ——〉 set(zhanbu,0) ，如果为 false ，不进行操作（这一步可以省略，但也许有时会出问题），占卜前判断是否加过了福缘，加过了提示后 return ，否则进行随机占卜，出结果时判断，以结果为好为例：        object ob = this_player();        if(ob->query(\"zhanbu\")<=0)//当玩家的 zhanbu 为 0 或为 负值时，将其设为 1 //这是本 quest 的难度重点，只有连续同一结果十次才有用                ob->set(\"zhanbu\",1\");         else                ob->add(\"zhanbu\",1\");         if(ob->query(\"zhanbu\")==10)        {                ob->add(\"kar\",random(3));                if(ob->query(\"kar\")>=30)                        ob->set(\"kar\",30);                write(HIW\"恭喜你！因为你的好运气，你得到了一些福缘的奖励！\\n\"NOR);                ob->set(\"zhanbu_kar\",1);        }        ...//以下是 zhanbu==-10 的判断，对于kar的修改为负值目前只有想法而没有开始完成，上面这断代码是临时写的可能会有错误，如果可以再考虑然后完善。目前另一个难点是我没想到怎么控制每天只能占卜一次！　　⒊关于鸦片，这个想法比较早，大约是五月末想到的，但也是一直没有去完成。　　添加“烟馆”之类的场所，设定吸食鸦片，会有副作用，吸食后暂时会有好处但次数累计到一定程度就会上瘾，上瘾后（可以象判断食物、水一样判断）如果一定时间不再吸食一次会有副作用，可以用隐性的量 yapian 来判定，最大值为 300 ，这里也是跟食物、水类似，阁一段时间减 1 ，当小于一定数量开始提示烟瘾犯了，同时对 hp 中某些值进行减少，关于上瘾：第一次吸食鸦片时设定yanyin为 1 ，之后每吸食一定次数yanyin加 1 ，当yanyin达到一定值后就算是上瘾了，不论上瘾前还是上瘾后，只要坚持一定时间不吸食鸦片，yanyin\"值减 1 ，到零为完全戒掉，上瘾后的副作用在判定时可以以\"yanyin为基数计算减少的各项值，这个还需要具体考虑，而yanyin达到一定数值时，比如说 10 ，犯烟瘾时随机的减少一些属性的最大值（这里是重点，可以再斟酌，因为牵涉到对玩家的损害！），yanyin的增加可以设为吸食 10 倍yanyin次鸦片时增加 1 。　　另外对应的可以开设“戒烟馆”来戒掉烟瘾，就是花上一定数量的 gold　，这个量设得大一些（增加玩家对鸦片危害的认识），同时花掉一定时间，类似于日月神教使者抓人那个时间，但出来的地方是固定的，可以减掉一定的yanyin。　　如果吸食鸦片没有好处我想也不会有人会吸食了，吸食鸦片在烟瘾没犯之前，要有一些临时属性的增加，比如在yanyin小于 5 时每次吸食鸦片会有jingli或是jing等属性的大幅增加（可以再斟酌增量），类似的好处可以有几种，在\"yapian\"达到 300 之前每次吸食加 30 左右，以免加的属性太多，当\"yanyin\"大于 5 后就不在有这个好处了，这就是利弊。　　有一种可能性，一些有钱的玩家在吸食鸦片后上瘾前戒掉来牟利，所以戒烟的busy time 可以设得长一些！如果要增加的话在描述时只要说服用过多会有副作用就可以了，不需要将副作用是什么介绍出来！！！　　⒋这个是前几天想的，也许用处不大，但是对 player 有利的就提一下吧：添加一个 think 指令，可以［think skills（必须是自己会的）］，然后对这条指令可以有随机的结果，比如：“你思考着基本剑法的一些问题，突然豁然贯通，你的剑法有些进步。”“你思考着基本剑法的一些问题，突然一只苍蝇飞了过来，你忙着赶苍蝇，忘了自己在想些什么了！”类似的描述可以有很多种，其中对于 skills 增加的是少数，并且每次的增量只是熟练度增加［random(5)（大家再斟酌研究）］，以免玩家从此获益太大，这条指令唯一的好处是没有 busy time ，就是说只要玩家是清醒状态就可以使用，因为思想是不会停止的嘛！　　以上几点想法都是从接近实际来考虑的，思考时间不是太多，有不周之处大家可以再研究，用不用都没关系，提出来开阔一下大家的思路好了！　　先提这些，快到上课时间了，改天有什么想法了再告诉你！                                        【 天  帝 】≈海洋≈的兄弟-隐居中 ☆侠客☆(Xkxmud)                                        星期四 2002年9月4日PM 16:39:04※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※",]),(["author":"☆侠客☆(xkxmud)","title":"to jhy(2002.09.05)","time":1031650173,"threadID":"xkxmud","msg":"※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※隐患：比如说我> cd/u/xkxmud/> cp /data/securityd.o 1.cOk.> edit 1.c2wiz_status ([\"tod\":\"(apprentice)\",\"nettrain\":\"(apprentice)\",\"shuai\":\"(apprentice)\",\"jhy\":\"(admin)\",\"scow\":\"(apprentice)\",\"xkxmud\":\"(admin)\",])cwiz_status ([\"tod\":\"(player)\",\"nettrain\":\"(player)\",\"shuai\":\"(player)\",\"jhy\":\"(admin)\",\"scow\":\"(player)\",\"xkxmud\":\"(admin)\",]).:x\"u/xkxmud/1.c\" 10 lines 3811 bytesExit from ed.【系统】监控精灵(monitord)：☆侠客☆(xkxmud)编辑了/u/xkxmud/1.c。> cp 1.c /data/securityd.oOk.> rm 1.cOk.至此，修改完毕，对于我所做的权限修改，不会有人查出来吧！至少轻易不会，因为没有相关的 LOG 文件，只要系统重新启动，我做的修改就会生效了！因此，建议对 cp 指令添加 LOG 文件！因为也许不止这一处隐患，这只是我刚刚无意发现的！                                        星期四 2002年9月5日AM 02:03:55与之相关的命令类似 mv、tail、cat、more…其实不必所有使用指令时都写 LOG 文件，只需要限制对 * .o 文件使用时（如果还有类似的再添加条件）调用写 LOG 的函数就行了！大哥，还有一件事，就是 story 系统为什么还没开呀，是不是现在没有必要呢，或者是别的什么原因，如果需要的话，告诉我，要做什么调整也告诉我，我会尽快解决！对于 msgd 的使用：因为我用了 msgd 的代码，所以也发现了几个小 BUG（关于 addmsg、listmsg、delmsg 当 msg 数为 0 时返回值等问题）已经作了修改，我会对 /adm/daemons/msgd.c 作一些修改，在家里已经调试通过了，不过目前似乎没有在使用 msgd 了！还有我对我房间的留言板也作了修改，由原来的普通留言板改成了类似保密留言板的但条件设为大部分的操作只有我们可以实现，其他任何人都只能对自己作的留言进行操作，因为比如今天的留言有涉及到系统的安全问题，我不想让太多人看到！今天在家里读各个留言板的留言时，看到　巫师会客室 - /d/wizard/guest_room　中的留言大部分都提出了一些问题，不知都解决了与否，其中一部分我在其他留言板看到了解决的办法，其它的我会在家里看一看，试着去解决，如果可以解决的我会尽快处理的！在　秘密交流室 - /d/wizard/proom　中我读到　24 to admin       (xfan)(Fri Aug 09)　申请成为友站的留言，我原来在“傲剑神侠”做 (wizard) 时认识的，他和我并不熟，但我有他的 QQ 曾和他聊过一阵子，他也是和你一样在家里自己架站，并且２４小时不断线的，好像是起名　春风侠客行　，那时在那里给玩家的条件太好了，几乎是想要什么就有什么（我指武功和属性），所以没怎么去玩，现在不知怎么样了，你可以亲自去考察一下，我想多交流对我们都有好处，而且如果可以从他那里学到连接友站的知识一定会有很大用处的！那时的 ID 是 (rainrose)，最开始是因为完成门派“青城派”成为(creator)，后来升级到(wizard)，在此期间认识的你，并来到了梦，之后不久就因为辞去工作暂时离开了，到现在也没稳定，有时候想起来很怀念刚来到梦的那些日子！我想等过一阵子，差不多是学习完毕，那时天也该冷了，现在住的地方就不合适了，也许会出去租房，如果可以搬进楼房，我回想办法包月上网的，那时时间就充足了，其实这也是我一直希望的！sigh刚刚看代码，发现cp指令留有官方站的漏洞        if(!SECURITY_D-> valid_read(src, this_object(), \"read_file\") && me->query(\"id\") != \"sdong\" )return notify_fail(\"对不起，你没有COPY这个档案的权力。\\n\");这条如果 sdong 这个 id 不是巫师用处不大，但似乎在底层一些文件也有类似的隐患，比如 /adm/daemons/securityd.c 中        //if( find_player(\"sdong\") )        //      tell_object( find_player(\"sdong\"), geteuid(user)+\" try to \"+func+\" file: \"+file+\".\\n\" );虽然这部分被注销了，但很难说有些文件里有这样的隐患没被发现！这个问题我们大家一起来找吧！                                        星期四 2002年9月5日PM 03:24:52                                        【 天  帝 】≈海洋≈的兄弟-隐居中 ☆侠客☆(Xkxmud)※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※",]),(["author":"君子(xkx)","title":" 潜能： -2186 /  208","time":1031650363,"threadID":"xkx","msg":"me  潜能： -2186 /  208  请wiz补偿！！西门暴血证人",]),(["author":"☆侠客☆(xkxmud)","title":"to jhy(2002.09.06)","time":1031651332,"threadID":"xkxmud","msg":"※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※※⒈关于 board 用法的新发现，        时间（AM 11:26:05）        位置（文件）：大山洞 - /d/xiakedao/dadong        用处：不明！/*       //call_other(\"/clone/board/xkd_b\", \"???\");       setup();       \"/clone/board/xkd_b\"->foo();       \"/clone/board/xkd_b\"->save();*/⒉关于 present 的用法及对于随机给予物品的用法！        时间（AM 11:35:59）        文件：/d/xiakedao/npc/dahan.cint ask_armor();string* armors = ({       \"/clone/armor/beixin\",       \"/clone/armor/tie-beixin\",});int ask_armor(){       int i;       object you = this_player();       object armor;       if (query(\"armor_count\") < 1)        {               say(\"黄衣大汉低头在身上翻了半天，抱歉地笑了笑说道，对不起，没了。\\n\");               return 1;        }       for( i = 1; i < sizeof(armors); i++ )        {               if (  present(armors[i]->query(\"id\"), you) )                {                       say(\"黄衣大汉皱了皱眉头说道：有了还要，你太贪心了吧。\\n\");                       return 1;                }               else if (present(armors[i]->query(\"id\"), environment(you)))                {                       say(\"黄衣大汉往地上一指：地上不是有吗，你要的话就捡走吧。\\n\");                       return 1;                }        }       armor = new( armors[random(sizeof(armors))] );       armor->move(this_object());       armor->set(\"value\", 0);}⒊在动作中使一个房间开新门        时间（PM 12:00:45）        文件：/d/xiakedao//d/xiakedao/gate.cint ask_daozhu(){       object me = this_player(), here;       string desc;       here = environment(me);       desc = here->query(\"long\");       if ( (int)here->query_temp(\"opened\") == 0)        {               say(\"厮仆微一躬身说道：两位岛主正在石室中苦思。\\n\");               say(\"厮仆招了招手，其他几位厮仆走了过来，四人抓住两块大屏风的边缘\\n\");               say(\"向旁缓缓拉开，露出一条长长的甬道。\\n\");               here->set(\"exits/enter\", \"/d/xiakedao/yongdao10\");               here->set_temp(\"opened\", 1);               desc = sprintf(desc + \"    屏风已被拉开，露出一条长长的甬道。\\n\");               here->set(\"long\", desc);        }        else        {               say(\"厮仆微一躬身说道：两位岛主正在石室中苦思，你进去找他们吧。\\n\");        }⒋给命令添加记录文件        时间（PM 02:11:42）        文件：参考 海洋 lib 中的 cmds文件！/*        //给东西记录到/log/cmds/give   星星(lywin)       log_file(\"cmds/give\",       sprintf(\"%s(%s) 在%s把一个(%s) 给了%s（%s）on %s\\n\",       me->name(),  //记录使用命令的人名       geteuid(me), //记录使用命令的ID       (string)environment(me)->query(\"short\"), //记录复制物品所在的房间       obj->name(1), //记录给的物品的名称       who->name(),  //记录使用对象的人名       geteuid(who), //记录使用对象的ID       ctime(time()) ) ); //记录使用命令的时间*/⒌制作了物品 ★侠客令★        作用：  xkxmud 及 jhy 可利用这个物品招收手下，可以不是巫师，具        体招收手下的作用没有想好，但可利用这一点在一些方便的地方做一个        房间，再做一个类似保密留言板的 board 用来给这些人 post 一些心        得及程序等，类似于考察巫师，合格后升为正式巫师，收为手下同时会        给该玩家一个★侠客令★，给该玩家一个指令 home2 回到那个房间，这        个令是(no_get,no_drop,auto load)的，如果没了只需要再输入一次        (givewiz id yes)即可给该 id 另一块令，如果对其输入        (givewiz id no)，则该 id 不再成为手下，令也会失去，之后一切正常，        因为本令没有给其他特权，所以不会有副作用，而且，这些 id 不是巫师        只是多了一个 home2 指令的玩家，这个 home2 指令带他们去的地方，也        是只有一个保密留言板的房间，不会有副作用，唯一弱点是有人可以利用        令逃离战场（这个可以加参数避免），另外可以在 home2 指令时加一个        限制，记录使用这一指令的位置，另一个指令 home1 才可以离开这个特殊        房间，也就是所记录的位置，home1 指令只可以在这个房间使用，这个房        间是 no_quit 的，想退出必须使用 home1 回到原来的地点，同时会删除        这个临时记录的地点！        时间：（PM 03:13:04）关于上诉几个问题，前三个是可以作为给新巫师学习编程的资料，因为有些我也是刚接触所以也说不出太多，第四个是关于 log_file 的用法，其实只是很简单的几行代码，但是我想不是每条命令都需要加log_file的，那样对系统也不大好挑其中几条重点的加上就可以了，但其他的需要仔细看一遍，以便取缔漏洞，至于第五条，目前不知用不用得着，因为目前似乎任用巫师没有那么麻烦，如果用得着，告诉我，令的大部分功能都已测试通过就差最后提到的 home2 指令的副作用及那个房间的制作，应该不会太困难，因为那个保密留言板只要 cp 我的留言板就可以了，或者可以放松限制，直接用侠客行里面那个保密留言板，让别的巫师也可以进行操作，这些都只是几段代码就可以完成的，我会在家里尽快完成，用的话我就拷过来，用不上我就当练习了， hehehe，关于 log_file 的添加在海洋 lib 里有几条很重要的已经有现成的了，我会对其再进行整理和修改之后拷过来的，你的邮箱好用吗，我想之后用邮箱发给你比较快，因为用 edit 可能是我们机器设置不同，在家我可以直接用编辑器发送 20k 左右的代码，而在网上只能发 7-8k 的，而且超过 3-4k 就会出现标点错误及其中部分代码丢失，调试起来都很困难，不过这些指令文件都不是太大，只是我想让你先看一下，因为我会加另一个限制，就是不让别的巫师对我文件夹随便操作，类似于读写权限的，如果你认为没必要可以删去再用，还有 1 小时时间，我尽量先修改几条命令吧！                                        星期五 2002年9月6日PM 03:36:06                                        【 天  帝 】≈海洋≈的兄弟-隐居中 ☆