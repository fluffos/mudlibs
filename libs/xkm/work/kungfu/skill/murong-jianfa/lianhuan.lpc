// lianhuan.c 七剑连环指
// xuanyuan 2002.2

/*
慕容复接过邓百川掷来的长剑，精神一振，使出慕容复家传剑法，招招连绵不绝，犹似行云流水一般，瞬息之间，全身便如罩在一道光幕之中;
。武林人士向来只闻姑苏慕容氏武功渊博，各家各派的功夫无所不知，殊不料剑法精妙如斯。

*/
#include <ansi.h>
inherit F_SSERVER;

void remove_effect(object me);

int perform(object me, object target) {

  int i = me->query_skill("murong-jianfa", 1) / 5;
  int j = me->query_skill("canhe-zhi", 1) / 5;
  int d = me->query_skill("douzhuan-xingyi", 1) / 5;
  int skill, max_skill;

  object weapon = me->query_temp("weapon");
  if (!target) target = offensive_target(me);

  if (!target || !me->is_fighting(target))
    return notify_fail("七剑连环指只能对战斗中的对手使用。\n");

  if (me->query_skill_mapped("force") != "douzhuan-xingyi")
    return notify_fail("你的内功不是斗转星移，无法使用刀影掌！\n");

  if ((int)me->query_skill("douzhuan-xingyi", 1) < 100)
    return notify_fail("你的内功还未练成，不能使用七剑连环指！\n");

  if ((int)me->query_skill("murong-jianfa", 1) < 120)
    return notify_fail("你的剑法还未练成，不能使用七剑连环指！\n");

  if (!weapon || weapon->query("skill_type") != "sword"
    || me->query_skill_mapped("sword") != "murong-jianfa")
    return notify_fail("你手里没有剑，无法使用七剑连环指！\n");

  if ((int)me->query_skill("canhe-zhi", 1) < 100)
    return notify_fail("你的指法还未练成，不能使用七剑连环指！\n");

  if (me->query_skill_mapped("finger") != "canhe-zhi" ||
    me->query_skill_prepared("finger") != "canhe-zhi")
    return notify_fail("你没有用指，无法使用七剑连环指！\n");

  if ((int)me->query("neili") < 600)
    return notify_fail("你现在内力不足，不能使用七剑连环指！\n");

  if ((int)me->query_temp("murong/lianhuan"))
    return notify_fail("你正在使用七剑连环指！\n");

  if ((int)me->query_skill("sword", 1) < 120)
    return notify_fail("你的基本剑法不够娴熟，不能在剑招中使用七剑连环指。\n");

  if ((int)me->query_skill("finger", 1) < 120)
    return notify_fail("你的基本指法不够娴熟，不能在剑招中使用七剑连环指。\n");

  skill = me->query_skill("murong-jianfa", 1);
  max_skill = pow(me->query("combat_exp") * 10, 0.33333) + 1;

  me->add_temp("apply/attack", (i + j) / 3 * 2);
  me->add_temp("apply/damage", d);

  if (skill < max_skill / 2) {
    message_vision(CYN "\n$N精神一振，使出慕容复家传剑法，剑招轻盈，甚有儒雅之风！\n" NOR, me, target);

    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  } else if (skill < max_skill * 2 / 3) {
    message_vision(CYN "\n$N精神一振，使出慕容复家传剑法，剑招连绵递出，剑法精妙如斯！\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  } else {
    message_vision(CYN "\n$N精神一振，使出慕容复家传剑法，招招连绵不绝，犹似行云流水一般，瞬息之间，全身便如罩在一道光幕之中。\n" NOR, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  }

  message_vision(MAG "\n$N使出七剑连环指，剑锋一转，右手食指跟着弹出，只见剑花指风相辉相映，直袭$n！\n" NOR, me, target);

  me->add("neili", -150);
  me->add("jing", -50);
  me->set_temp("murong/lianhuan", 2 + me->query_skill("murong-jianfa", 1) / 5);

  if (me->query_skill_prepared("strike") == "xingyi-zhang") {
    me->prepare_skill("strike");
    me->set_temp("restore_strike", 1);
  }
  call_out("check_fight", 1, me, weapon);
  return 1;
}

void check_fight(object me, object weapon) {
  if (!living(me) || me->is_ghost()) {
    remove_effect(me);
    return;
  }
  if (!me->is_fighting()) {
    message_vision("\n$N的「七剑连环指」绝技运行完毕，气回丹田，缓缓收功。\n", me);
    remove_effect(me);
    return;
  }

  else if (environment(weapon) != me || weapon != me->query_temp("weapon")) {
    message_vision("\n$N手中兵器已失，不能再使用「七剑连环指」绝技。\n", me);
    remove_effect(me);
    return;
  } else if (me->query_skill_mapped("sword") != "murong-jianfa"
    || me->query_skill_mapped("finger") != "canhe-zhi"
    || me->query_skill_prepared("finger") != "canhe-zhi") {
    remove_effect(me);
    message_vision("\n$N临时改换武功,决定不再使用「七剑连环指」绝技。\n", me);
    return;
  } else if ((int)me->query("neili") < 500 || (int)me->query("jingli") < 500) {
    tell_object(me, HIR "\n你渐感内力不济，暗暗收回「七剑连环指」绝技的攻势。\n" NOR);
    remove_effect(me);
    return;
  } else if (!me->query_temp("murong/lianhuan")) {
    remove_effect(me);
    message_vision(HIG "\n$N的「七剑连环指」绝技运行完毕，气回丹田，缓缓收功！\n" NOR, me);
    return;
  } else
    me->add_temp("murong/lianhuan", -1);
  call_out("check_fight", 1, me, weapon);
  return;
}

void remove_effect(object me) {
  int i = me->query_skill("murong-jianfa", 1) / 5;
  int j = me->query_skill("canhe-zhi", 1) / 5;
  int d = me->query_skill("douzhuan-xingyi", 1) / 5;

  if (me->query_temp("restore_strike")) {
    me->prepare_skill("strike", "xingyi-zhang");
  }

  me->add_temp("apply/attack", -(i + j) / 3 * 2);
  me->add_temp("apply/damage", -d);
  me->delete_temp("murong/lianhuan");
}
