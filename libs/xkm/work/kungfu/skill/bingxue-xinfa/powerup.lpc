//Cracked by Roath
// powerup.c 提升战斗力
// fear 12/99 reduced neili cost, added parry effect
// modified by xuanyuan to add restrict eunuch use force 10/31/2001
#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int exert(object me, object target) {
  int skill;

  if (target != me)
    return notify_fail("你只能提升自己的战斗力。\n");

  if ((int)me->query("neili") < 1000)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_temp("powerup"))
    return notify_fail("你已经在运功\中了。\n");
  skill = me->query_skill("force");
  me->add("neili", -skill * 6 / 5);
  me->add("jingli", -skill / 5);
  me->receive_damage("qi", 0);

  message_vision(
    HIW "$N凝神存想，将冰雪心法发挥至极至，阵阵寒意开始蔓延开来！\n" NOR, me);

  me->add_temp("apply/attack", skill / 3);
  me->add_temp("apply/dodge", skill / 3);
  me->add_temp("apply/parry", skill / 3);
  me->set_temp("powerup", 1);

  me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill / 3 :), skill / 8);

  if (me->is_fighting()) me->start_busy(2 + random(1));

  return 1;
}

void remove_effect(object me, int amount) {
  me->add_temp("apply/attack", -amount);
  me->add_temp("apply/dodge", -amount);
  me->add_temp("apply/parry", -amount);
  me->delete_temp("powerup");
  tell_object(me, HIW "你微觉疲惫，将内力收回丹田。\n" NOR);
}
