//tougu.c 透骨针
//lbc 2002/3
//突然之间，张无忌胸口一痛，似乎被一枚极细的尖针刺了一下。
//这一下刺痛突如其来，直钻入心肺，
//但这两下刺痛似有形，实无质，一股寒气突破他护体的九阳神功，直侵内脏。
//波斯三使一股极阴寒的内力，积贮于一点，从圣火令上传来，攻坚而入。
//阴劲入体，立即消失，但这一刺可当真疼痛入骨。

#include <ansi.h>

inherit F_DBASE;
inherit F_SSERVER;

int perform(object me, object target) {
  string weapon, force_skill, dodge_skill, dodge_msg, w_name;
  int lvl1, lvl2, amount, ap, dp;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("“透骨针”只能对战斗中的对手使用。\n");

  if (me->query_skill_mapped("force") != "shenghuo-xuanming")
    return notify_fail("你所用的内功和古波斯武功并非一路，无法施展透骨针。\n");

  if ((lvl1 = me->query_skill("shenghuo-ling", 1)) < 200)
    return notify_fail("你的古波斯武功修为不够，不能将阴寒之气汇聚一点！\n");

  if ((lvl2 = me->query_skill("shenghuo-xuanming", 1)) < 200)
    return notify_fail("你的内功修为不够，阴劲无法穿透对方护体内功。\n");

  if (!target->query_skill_mapped("force"))
    return notify_fail("对手没有使用内功，无需使用阴毒内劲伤人了。\n");

  if (me->query("neili") < (lvl1 + lvl2) / 3)
    return notify_fail("你的内力不够。\n");

  if (me->query("jingli") < (lvl1 + lvl2) / 4)
    return notify_fail("你的精力不够。\n");

  ap = (lvl1 + lvl2) * ((int)(me->query("neili") / 100) + 1);

  dp = (target->query_skill("dodge", 1));

  ap = ap / 100;

  dp = dp + (target->query_skill("force", 1));
  dp = dp * ((int)(target->query("neili") / 100) + 1);
  dp = dp / 100;
  if (wizardp(me))
    printf("ap = %d , dp = %d .\n", ap, dp);

  weapon = me->query_temp("weapon");
  w_name = weapon->query("name");
  force_skill = target->query_skill_mapped("force");
  dodge_skill = target->query_skill_mapped("dodge");

  message_vision(BLU "$N使一股极阴寒的内力，积贮于一点，从" + w_name + BLU "上向$n射去。\n\n" NOR, me, target);

  me->add("neili", -(lvl1 + lvl2) / 3);
  me->add("jingli", -(lvl1 + lvl2) / 4);
  if (random(ap) > dp * 3 / 5) {
    tell_object(
      target,
      HIB "突然一下刺痛似有形，实无质，一股寒气突破你护体的" + to_chinese(force_skill) + "，直侵内脏，你的" + to_chinese(force_skill) + "登时瓦解。\n\n" NOR
    );
    message_vision(HIC "$n眉头一皱，脸现痛苦之色，似乎在无形之中已经受了内伤。\n\n" NOR, me, target);
    target->map_skill("force");
    target->set("jiali", 0);
    target->start_busy(1 + random(2));
    target->set_temp("bosi/tougu", 1);
  }

  else if (random(ap) > dp / 4) {
    tell_object(target, HIB "突然之间，你胸口一痛，似乎被一枚极细的尖针刺了一下。这一下刺痛突如其来，直钻入心肺。\n\n" NOR);
    message_vision(HIC "$n急运" + to_chinese(force_skill) + "与阴寒之气相抗。\n\n" NOR, me, target);
    tell_object(target, HIB "阴劲入体，立即消失，但这一刺可当真疼痛入骨。\n\n" NOR);
    if (target->query("neili") > ap * 4)
      target->add("neili", -ap * 4);
    else target->set("neili", 1);
    target->start_busy(1 + random(2));
    me->start_busy(2 + random(2));
  }

  else {
    dodge_msg = "$n感觉一股阴寒之气从" + w_name + "上传来，急忙使出";
    if (dodge_skill)
      dodge_msg += to_chinese(dodge_skill);
    else dodge_msg += "轻功";
    dodge_msg += "，从旁纵开，躲开了这下寒气针刺。 \n\n";

    message_vision(HIG + dodge_msg + NOR, me, target);
    me->start_busy(2 + random(2));
  }
  return 1;
}
