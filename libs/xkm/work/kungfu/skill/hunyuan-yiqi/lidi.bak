//lidi.c 立地成佛

#include <ansi.h>

inherit F_SSERVER;

int exert(object me, object target)
{
        int damage;
        object weapon;

/*
        if (! wizardp(me)) 
                return notify_fail("目前这功能还不开放！\n");
*/
        if( target == me)target=offensive_target(me);

        if( !target )target = offensive_target(me);
        if( !target )target = me->select_opponent();

        if( !target || !me->is_fighting(target) || !living(target) )
                return notify_fail("立地成佛只能在战斗中使用。\n");

	if (!objectp(weapon = me->query_temp("weapon")))
                return notify_fail("只有装备武器才能使用「立地成佛」\n");

        if( (int)me->query_skill("buddhism",1) < 200 )
                return notify_fail("你的佛法修为不够，无法使用「立地成佛」。\n");

        if( (int)me->query("max_neili") < 3000 )
                return notify_fail("你内力修为不足，使不出少林「立地成佛」！\n");     

        if( (int)me->query("neili") < 1000 )
                return notify_fail("你现在内力不足，使不出少林「立地成佛」！\n");

        if( me->query_skill("hand") < 300 )
                return notify_fail("你的手法修为不够，无法施展「立地成佛」。\n");

        if( me->query_skill("finger") < 300 )
                return notify_fail("你的指法修为不够，无法施展「立地成佛」。\n");

        if( me->query_skill("strike") < 300 )
                return notify_fail("你的掌法修为不够，无法施展「立地成佛」。\n");

        if( me->query_skill("cuff") < 300 )
                return notify_fail("你的拳法修为不够，无法施展「立地成佛」。\n");

        if( me->query_skill("claw") < 300 )
                return notify_fail("你的爪法修为不够，无法施展「立地成佛」。\n");
/*
        if( me->query_skill("sword") < 300 )
                return notify_fail("你的剑法修为不够，无法施展「立地成佛」。\n");

        if( me->query_skill("staff") < 300 )
                return notify_fail("你的杖法修为不够，无法施展「立地成佛」。\n");

        if( me->query_skill("club") < 300 )
                return notify_fail("你的棍法修为不够，无法施展「立地成佛」。\n");

        if( me->query_skill("blade") < 300 )
                return notify_fail("你的刀法修为不够，无法施展「立地成佛」。\n");
*/
        if( me->query_skill("force") < 300 )
                return notify_fail("你的内功修为不够，无法施展「立地成佛」。\n");

        if (me->query_str() < 40 )
                return notify_fail("你的力量太小，使不出用「立地成佛」。\n");

        if( me->query_temp("sl_fo") )
                return notify_fail("你刚使完「立地成佛」绝招，目前气血翻涌，无法再次运用！\n");
        
        message_vision(HIY "\n\n$N扔掉手上的武器，喃喃说道：放下屠刀，立地成佛，一股强大之极劲风直逼$n而去！\n"NOR,me,target);
        weapon->move(environment(me));

        me->set_temp("sl_fo", 1);
        
        if (random(me->query_skill("force")) > target->query_skill("force") /4 )
        {
                me->start_busy(1);
                target->start_busy(2); 
                me->add("neili", -200);
                me->add("jing", -20);
                damage = (int)me->query_skill("hunyuan-yiqi", 1);                
                damage = damage*2 + random(damage);
                if(me->query("neili") > target->query("neili")*2 ) damage += random(damage);
                target->receive_damage("qi", damage);
                target->receive_wound("qi", damage/2);

                message_vision(MAG"\n结果只见$N轻哼一声，后退一步，吐出一口鲜血。\n\n"NOR,target);
                COMBAT_D->report_status(target);

                call_out("exert2", 3, me, target, (int)target->query("qi")*100/(int)target->query("max_qi"));    
	        } else
        {
                me->start_busy(2);
                target->start_busy(1);
                me->add("neili", -100);
                message_vision(HIG"\n$N但觉一股微风扑面而来，风势虽然不劲，然已逼得自己呼吸不畅，知道不妙，连忙跃开数尺。\n" NOR,target);

                call_out("remove_effect", me->query_con()/6, me);
        }
        return 1;
}

int exert2(object me, object target)
{
        int damage;

        if( !target || !me->is_fighting(target) )
        {
                call_out("remove_effect", me->query_con()/6, me);
                return 1;
        }

        if( !living(me) || me->is_ghost() )
	{
                call_out("remove_effect", me->query_con()/6, me);
                return 1;
        }

        if( !target || environment(me) != environment(target) || !me->is_fighting() )
        {
                call_out("remove_effect", me->query_con()/6, me);
                return 1;
        }

        message_vision(HIY "\n$N顺式平招，左拳劲力未消，右掌也跟着推出，功力相叠，「立地成佛」劲风排山倒海般涌向$n！\n"NOR,me,target);

        if (random(me->query_skill("force")) > target->query_skill("force") / 3 )
        {                
                me->start_busy(1);
                target->start_busy(2);
                me->add("neili", -300);
                me->add("jing", -30);                
                damage = (int)me->query_skill("hunyuan-yiqi", 1);                
                damage = damage*3 + random(damage)*2;
                if(me->query("neili") > target->query("neili")*2 ) damage += random(damage);
                target->receive_damage("qi", damage);
                target->receive_wound("qi", damage/2);

                message_vision(MAG"\n结果只见$N「啊」的一声，连退两步，喷出一口鲜血。\n\n"NOR,target);
                COMBAT_D->report_status(target);

                call_out("exert3", 3, me, target, (int)target->query("qi")*100/(int)target->query("max_qi"));  
        } 
        else 
        {
                me->start_busy(2);
                me->add("neili", -200);
                message_vision(HIG"\n$N喘息未定，又觉一股劲风扑面而来，连忙跃开数尺，狼狈地避开。\n" NOR,target);

                call_out("remove_effect", me->query_con()/4, me);
        }
        return 1;
}

int exert3(object me, object target)
{
        int damage;

        if( !target || !me->is_fighting(target) )
	{
                call_out("remove_effect", me->query_con()/6, me);
                return 1;
        }

        if( !living(me) || me->is_ghost() )
        {
                call_out("remove_effect", me->query_con()/6, me);
                return 1;
        }

        if( !target || environment(me) != environment(target) || !me->is_fighting() )
        {
                call_out("remove_effect", me->query_con()/6, me);
                return 1;
        }

        message_vision( HIY "\n$N微微一笑，融会生平所学，手法随心变化，忽而指风纵横，忽而爪力披靡，连同$n身前方圆三丈全在「立地成佛」劲力笼罩之下！\n"NOR,me,target);

        if (random( me->query_skill("force")) > target->query_skill("force") / 2 )
        {
                me->start_busy(2);
                target->start_busy(random(3));
                me->add("neili", -400);
                me->add("jing", -40);                
                damage = (int)me->query_skill("hunyuan-yiqi", 1);                
                damage = damage*5 + random(damage)*2;
                if((int)me->query("neili") > (int)target->query("neili")*2 ) damage += random(damage);
                target->receive_damage("qi", damage);
                target->receive_wound("qi", damage/2);

                message_vision(MAG"\n结果只听「轰」的一声，$N飞出数丈，鲜血满地。\n\n"NOR,target);
                COMBAT_D->report_status(target);

        } else 
        {
                me->start_busy(2);
                target->start_busy(1);
                me->add("neili", -300);
                target->add("jing", -100);
                message_vision(HIG"\n$N用尽全身力量向右一纵一滚，摇摇欲倒地站了起来，但总算躲开了这致命的一击！\n" NOR,target);
        }

        call_out("remove_effect", me->query_con()/2, me);
        return 1;
}
void remove_effect(object me)
{
        me->delete_temp("sl_fo");
        tell_object(me, HIY"\n你经过一段时间调气养息，又可以使用「立地成佛」绝招了。\n"NOR);
}
