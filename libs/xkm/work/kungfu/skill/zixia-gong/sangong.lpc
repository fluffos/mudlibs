//Cracked by Roath
// 散功 for exert zixia.
// Edea@US 1/02

#include <ansi.h>

int exert(object me, object target) {
  if (!me->query_temp("zixia"))
    return notify_fail("你并未运用紫霞神功。\n");

  call_other(__DIR__ "zixia", "remove_effect", me, me->query_temp("weapon"), 0);
  write(MAG "你吐息呐气，将遍布全身的紫霞真气缓缓散去。\n" NOR);
  tell_room(environment(me), MAG "突然之间，" + me->name()
    + "脸上满布紫气，只是那紫气一现即隐，顷刻间又回复了原来脸色。\n" NOR, ({ me }));
  return 1;
}
