    "damage_type": "刺伤"
  ]),
});

int valid_enable(string usage) { return usage == "finger" || usage == "parry"; }

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练六脉神剑必须空手。\n");
  if ((int)me->query_skill("beiming-shengong", 1) < 80)
    return notify_fail("你的北冥神功火候不够，无法学六脉神剑。\n");
  if ((int)me->query("max_neili") < 1000)
    return notify_fail("你的内力太弱，无法练六脉神剑。\n");
  if ((int)me->query("kar") < 28)
    return notify_fail("你这辈子注定与六脉神剑无缘。\n");
  if ((int)me->query("shen") < 10000)
    return notify_fail("六脉神剑不传与邪门歪道!\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("six-finger", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me) {
  if ((int)me->query("jingli") < 30)
    return notify_fail("你的精力不够练六脉神剑!\n");
  me->receive_damage("jingli", 30);
  me->add("neili", -10);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "six-finger/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int i, level;
  string weapon, str, msg;
  object weap;
  level = (int)me->query_skill("six-finger", 1);
  weap = victim->query_temp("weapon");
  if (damage_bonus < 100) return 0;

  if (random(damage_bonus / 2) > victim->query_str()) {
    victim->receive_wound("qi", (damage_bonus - 100) / 2);
    return HIW "$N听到「吱啦」一声轻响，竟似是钢剑划过的声音！\n " NOR;
  }
  if ((level > 200) && (me->query("neili") > 1000)
    && (victim->query_temp("weapon"))
    && (random(me->query_str()) > victim->query_str() / 3)) {
    if (random((int)weap->query("rigidity")) < 5) {
      message_vision(
        HIW "突然间拍的一声响，$N手中" + weap->name() + HIW "为无形气剑所断，化为寸许的二三十截，飞上半空！\n" NOR,
        victim
      );
    }
    victim->add("neili", -200);
    victim->add("jingli", -100);
  }

  weap->move(environment(me));
  weap->set("name", "断掉的" + weap->query("name"));
  weap->set("value", 0);
  weap->set("weapon_prop", 0);
}
