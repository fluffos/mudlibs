#include <ansi.h>
inherit SKILL;
mapping *action = ({
     "force" : 300,
     "dodge" : 50,
     "damage" : 20,
     "damage_type" : "刺伤"
  ]),
   ([      "action":HIB"$N使出三道轮回剑之「一道定今生」"NOR,
     "force" : 500,
     "dodge" : 100,
     "damage" : 400,
    "lvl" : 101,
     "damage_type" : "刺伤"
  ]),
   ([      "action":HIB"$N使出三道轮回剑之「一道定来生」"NOR,
     "force" : 800,
     "dodge" : 150,
     "damage" : 600,
    "lvl" : 201,
     "damage_type" : "刺伤"
  ]),
});    
int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }
int valid_learn(object me)
{
  if ((int)me->query("max_neili") < 500)
          return notify_fail("你的内力不够。\n");
}
int practice_skill(object me)
{
  object weapon;
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
          return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("jingli") < 50)
          return notify_fail("你的精力不够练三道轮回剑法。\n");
  me->receive_damage("jingli", 30);
  return 1;
}
mapping query_action(object me, object weapon)
{
 int i;
 i =  (int) me->query_skill("sdlh-jian",1);
if (me->query_skill("sdlh-jian,1") >500 ) {
return ([
     "action":HIC"$w"NOR+HIC"上的剑芒，犹似长蛇般伸缩不定......\n\n"NOR+HIG"$N丹田中猛提一口真气，身子滴溜溜的打了半个圈子，手中$w"NOR+HIG"一挺，蓦地剑芒突盛，青芒疾刺$n$l！"NOR,
    "force" : 480,
    "dodge" : 0,
    "parry" : 0,
    "damage_type":  "刺伤"
  ]);
   }
}
