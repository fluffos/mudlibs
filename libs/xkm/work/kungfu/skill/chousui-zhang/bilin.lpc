//write by bright
// bilin.c 

#include <ansi.h>

inherit F_DBASE;
inherit F_SSERVER;

int perform(object me, object target) {
  object weapon;
  int i, num, amount;

  if (!target && me->is_fighting()) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("抽髓碧磷只能对战斗中的对手使用。\n");

  if (!objectp(weapon = present("bilin zhen", me)))
    return notify_fail("你身上没有碧磷针，如何施展「抽髓碧磷」！\n");

  if (me->query_skill("chousui-zhang", 1) < 120)
    return notify_fail("你的抽髓掌修为还不够，不能施展「抽髓碧磷」！\n");

  if (me->query_skill("feixing-shu", 1) < 100)
    return notify_fail("你的飞星术修为还不够，不会施展「抽髓碧磷」！\n");

  if (me->query_skill("force") < 120)
    return notify_fail("你的内功修为火候未到，劲力不足以施展「抽髓碧磷」！\n");

  if (me->query("max_neili") <= 1000)
    return notify_fail("你的内力修为不足，劲力不足以施展「抽髓碧磷」！\n");

  if (me->query("neili") <= 800)
    return notify_fail("你的内力不够，劲力不足以施展「抽髓碧磷」！\n");

  if (weapon->query_amount() < 4)
    return notify_fail("你所剩余的暗器数目不够施展「抽髓碧磷」！\n");

  num = 2 + random(2);
  me->add("neili", -500);
  me->add("jingli", -200);

  message_vision(HIR "\n\n$N身形突变，形若鬼魅，突然施展「抽髓碧磷」，「刷刷刷」三掌攻向$n！
\n" NOR, me, target);

  amount = me->query_skill("strike");
  me->add_temp("apply/attack", amount / 2);
  me->add_temp("apply/damage", amount);

  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));

  message_vision(HIR "\n\n$N嘿嘿一声,突然手腕一抖,数枚" + weapon->name() + "闪电般地射向$n!
\n" NOR, me, target);

  for (i = 1; i < num + 1; i++) {
    weapon->throw_ob(me, target);
    me->reset_action();
  }

  me->add_temp("apply/attack", -amount / 2);
  me->add_temp("apply/damage", -amount);

  me->start_busy(1 + random(3));

  return 1;
}
