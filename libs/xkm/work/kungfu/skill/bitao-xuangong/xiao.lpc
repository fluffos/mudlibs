// xiao.c  啸声呼唤双雕
// Xuanyuan 2002.4.7
/*
$N当下盘膝坐定，凝聚中气，在丹田盘旋片刻，然后从喉间一吐而出，啸声远远传了出去。
$N当下呼雕，喉音一发，山谷鸣响，中气极是充沛。
忽听得$N两声低啸，声音娇柔清脆。

此处地处空旷，但啸声发出，过不多时便白影临空，双雕御风而至，停在$N面前。
忽听空中雕鸣啾急，一那对白雕远远从东而至，双雕敛翼落下，神态甚是神俊。
忽然空中雕鸣声急，两头白雕自北急飞而至。$N大喜，纵声呼啸，双雕扑了下来，停在$N的肩头。
$N抬头望去，只见两只极大的白色大鹰正在天空盘旋翱翔，双翅横展，竟达丈许。
忽听得空中雕唳声急，双雕自远处敛翅飞落，站在$N的身畔。
忽听得空中几声唳鸣，声音清亮，飞来两头大雕，四翅鼓风，只带得满地灰沙飞扬，声势惊人。

$N伏上雄雕之背，搂住雕颈，口中一声呼啸，双雕振翅而起。
$N斗然凭虚临空，但双雕一飞离地，立感平稳异常。
$N初时还怕自己身子重，那雕儿未必负荷得起，岂知那白雕双翅展开，竟然并无急堕之像。

雌雕背上$N，纵吭欢唳，振翅直上，转眼之间，双雕已飞出老远。
双雕负着$N，比翼东去，转眼之间，双雕已飞出老远。
双雕升空打了几个盘旋，负着$N投东而去。
双雕齐声长鸣，振翼而起，在天空盘旋一周，向东而去，片刻之间已隐没云中。
只见那雌雕双翅一振，高飞入云，盘旋数圈，负着$N投东而去。

蓦地里那雌雕纵身长鸣，抛$N，振翅向北飞去。那雄雕飞高一望，鸣声啾急，随后急赶。
雌雄双雕形体虽巨，背上负了人毕竟难以远飞，不多时便即不支，越飞越低，终于着地。
*/
#include <ansi.h>

inherit F_DBASE;
inherit F_SSERVER;

int exert(object me) {
  string *msgxiao, msg;

  if (me->is_busy()
    || me->query_temp("pending/exercising")
    || me->query_temp("exit_blocked"))
    return notify_fail("你现在正忙着呢。\n");

  if (!environment(me)->query("outdoors"))
    return notify_fail("你只能在室外召唤双雕。\n");

  if (environment(me)->query("th_buzhen"))
    return notify_fail("这里已布有奇门阵法，你难以再召唤双雕。\n");

  if (environment(me)->query("outdoors") == "taohua")
    return notify_fail("你没事在桃花岛上召唤双雕做什么？！\n");

  if (me->query_temp("taohua/xiao"))
    return notify_fail("你已经在召唤双雕。\n");

  if (!present("tie bagua", me))
    return notify_fail("召唤双雕时需要随身携带铁八卦。\n");

  if (me->query("family/family_name") != "桃花岛" && me->query("family/master_name") != "黄药师")
    return notify_fail("你不是黄药师的弟子，不能召唤双雕！\n");

  if (me->query_skill_mapped("force") != "bitao-xuangong")
    return notify_fail("你所用的内功与「奇门阵法」心法相悖！\n");

  if (me->query_skill("bitao-xuangong", 1) < 120)
    return notify_fail("你的内功修为火候未到，难以召唤双雕！\n");

  if (me->query("max_neili") < 1000)
    return notify_fail("你的内力修为不够，难以召唤双雕！\n");

  if (me->query("neili") < 200)
    return notify_fail("你的真气不够，难以召唤双雕！\n");

  if (me->query("jingli") < me->query("max_jingli"))
    return notify_fail("你的精力不够，难以召唤双雕！\n");

  if (me->query("jing") < me->query("max_jing"))
    return notify_fail("你的精不够，难以召唤双雕！\n");

  if (me->query_skill("qimen-dunjia", 1) < 120)
    return notify_fail("你的奇门遁甲修为不够，难以召唤双雕！\n");

  msgxiao = ({
    "$N当下盘膝坐定，凝聚中气，在丹田盘旋片刻，然后从喉间一吐而出，啸声远远传了出去。",
    "$N当下呼雕，喉音一发，山谷鸣响，中气极是充沛。",
    "忽听得$N两声低啸，声音娇柔清脆。",
  });

  msg = HIG "\n" + msgxiao[random(sizeof(msgxiao))] + "\n" NOR;
  message_vision(msg, me);

  me->add("neili", -100);
  me->add("jingli", -50);
  me->add("jing", -50);
  me->start_busy(4);
  me->set_temp("taohua/xiao", 1);

  call_out("diao", 4, me);
  return 1;
}

int diao(object me) {
  object cidiao, xiongdiao;
  string *msgxiao, msg;

  cidiao = clone_object("/d/taohua/npc/cidiao");
  xiongdiao = clone_object("/d/taohua/npc/xiongdiao");

  if (objectp(cidiao) || objectp(xiongdiao)) {
    msgxiao = ({
      "此处地处空旷，但啸声发出，过不多时便白影临空，双雕御风而至，停在$N面前。",
      "忽听空中雕鸣啾急，一对白雕远远从东而至，双雕敛翼落下，神态甚是神俊。",
      "忽然空中雕鸣声急，两头白雕自北急飞而至。$N大喜，纵声呼啸，双雕扑了下来，停在$N的肩头。",
      "$N抬头望去，只见两只极大的白色大鹰正在天空盘旋翱翔，双翅横展，竟达丈许。",
      "忽听得空中雕唳声急，双雕自远处敛翅飞落，站在$N的身畔。",
      "忽听得空中几声唳鸣，声音清亮，飞来两头大雕，四翅鼓风，只带得满地灰沙飞扬，声势惊人。",
    });

    msg = HIW "\n" + msgxiao[random(sizeof(msgxiao))] + "\n" NOR;
    message_vision(msg, me);

    me->delete_temp("taohua/xiao");
    //                       random("cidiao" || "xiongdiao")->move(environment(me));
    cidiao->move(environment(me));
    //                        xiongdiao->move(environment(me));
  } else {
    message_vision(HIC "\n$N久唤不见双雕，看来已被他人呼唤走。\n" NOR, me);
    me->delete_temp("taohua/xiao");
  }

  return 1;
}
