//Cracked by Kafei
//huayu.c
//by liu 23/07/2001

#include <ansi.h>

inherit F_DBASE;
inherit F_SSERVER;

int perform(object me, object target) {
  mapping prepare_status;
  string weapon, op_weapon, op_skill, *pname, result, str, msg;
  int my_power, op_power;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("金蛇狂舞只能对战斗中的对手使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("id") != "jinshe jian")
    return notify_fail("你没用金蛇剑，不能使用金蛇狂舞！\n");

  if (me->query_skill("sword") < 200)
    return notify_fail("你金蛇剑法修为不足，还不会使用金蛇狂舞！\n");

  if (me->query("neili") <= 1000)
    return notify_fail("你的内力不够使用金蛇狂舞！\n");
  if (me->query("jingli") <= 600)
    return notify_fail("你的精力不够使用金蛇狂舞！\n");

  weapon = me->query_temp("weapon");

  if (!objectp(op_weapon = target->query_temp("weapon"))) {
    if (mapp(prepare_status = target->query_skill_prepare())) {
      pname = keys(prepare_status);
      op_skill = pname[0];
    } else op_skill = "unarmed";
  } else {
    op_skill = op_weapon->query("skill_type");
  }

  message_vision(HIY "\n$N一声长啸，劲臂一挥随即" + weapon->name() + HIY "脱手飞出！\n" NOR, me, target);
  message_vision(CYN "\n$N说道：让你见识一下金蛇剑真正的秘密！\n" NOR, me, target);
  message_vision(
    HIY "\n只见" + weapon->name() + HIY "急速旋转，骤然分解，原来这金蛇剑是由无数金蛇锥完聚而成！\n" NOR,
    me,
    target
  );
  message_vision(HIY "$N这招金蛇狂舞确实不传之迷，金蛇锥散乱天际，好似长眼一般伸缩自如，变幻莫测化，片刻便作万道金光冲向$n！\n" NOR, me, target);

  my_power = me->query_skill("sword") + me->query_skill("strike") + me->query_skill("force") + me->query_skill("dodge") + me->query("combat_exp") / 1000;

  op_power = target->query_skill(op_skill) + target->query_skill("dodge") + target->query_skill("force") + target->query_skill("parry") + target->query("combat_exp") / 1000;

  if (random(my_power) > op_power / 3) {
    if (objectp(op_weapon)) {
      message_vision(HIB "\n$N躲闪不及，只好运劲" + op_weapon->name() + "企图挡开飞来的暗器。\n" NOR, target);
      message_vision(WHT "$N猛然觉得虎口大震，手中的" + op_weapon->name() + WHT "被震掉在地上。\n" NOR, target);
      op_weapon->add_amount(-1);
      op_weapon->move(environment(me));

      message_vision(HIR "\n$N一声惨嚎，被无数金蛇锥穿身而过！\n" NOR, target);
      target->receive_wound(
        "qi",
        target->query("max_qi") / 8 + random(target->query("max_qi") / 2),
        me
      );
      str = COMBAT_D->status_msg((int)target->query("qi") * 100 / (int)target->query("max_qi"));
      message_vision("($N" + str + ")\n", target);
    } else if (random(me->query_str()) > (target->query_str()) * 3 / 5) {
      message_vision(HIR "\n$N奋力闪躲，结果被金蛇锥戳了几个血洞。\n" NOR, target);
      target->receive_damage(
        "qi",
        target->query("max_qi") / 8 + random(target->query("max_qi") / 4),
        me
      );
      str = COMBAT_D->status_msg((int)target->query("qi") * 100 / (int)target->query("max_qi"));
      message_vision("($N" + str + ")\n", target);
    } else {
      message_vision(HIR "\n$N奋力闪躲，结果被金蛇锥划了几道血痕。\n" NOR, target);
      target->receive_damage(
        "qi",
        target->query("max_qi") / 10 + random(target->query("max_qi") / 8),
        me
      );
      str = COMBAT_D->status_msg((int)target->query("qi") * 100 / (int)target->query("max_qi"));
      message_vision("($N" + str + ")\n", target);
    }
  } else {
    message_vision(HIG "\n$N身形连闪，好不容易将此招避过，已吓得冷汗直溜！\n" NOR, target);
  }

  message_vision(HIY "\n金蛇锥反转狂舞，去势尽时一把" + weapon->name() + HIY "汇聚而生。\n" NOR, me, target);

  if (random(me->query_dex()) > random(target->query_dex() / 2)) {
    message_vision(HIG "\n$N双足一点，接住了" + weapon->name() + "！\n" NOR, me, target);
  } else {
    weapon->move(environment(me));
    message_vision("\n“当”的一声，" + weapon->name() + "掉在了地上！\n" NOR, me, target);
  }
  me->add("neili", -500);
  me->add("jingli", -300);
  me->start_busy(random(6));
  return 1;
}
