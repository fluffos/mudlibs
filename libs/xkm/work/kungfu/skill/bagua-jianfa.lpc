inherit SKILL;
// more actions
mapping *action = ({
  ([ "action": "$N倒挂手上$w，一股内息由心而生，脚踏着八卦方位，含梅花桩之数，使出八卦剑法，「云山苍苍」，招法虽简，攻守兼备，攻向$n上盘",
    "damage": 40,
    "force": 200,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N一股无名火由心而起，$N高举$w，左手护着胸前大穴，右手一招 「江水茫茫」，平直攻向$n，招法中刚中带柔，具有一代宗师之风",
    "damage": 50,
    "force": 250,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N大喊一声，趁$n还没有回神，使出「还我河山」，握紧手上$w，猛烈地向$n劈去，一招一式无不依照相生相克之道",
    "damage": 60,
    "force": 300,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N眼看敌人毒招将致，暗运内力于$w上，好一招「流云似水」，以静制动，以不变应万变，向$n身上三处大穴剁去",
    "damage": 70,
    "force": 350,

    "damage_type": "割伤"
  ]),
  ([ "action": "$N加快身法，箭步攻向$n下盘三个方位，又一招「八面玲珑」，$n只好节节败退，眼看大险已去，$w忽然转向，向$n的$l，右腕挑去",
    "damage": 80,
    "force": 350,

    "damage_type": "刺伤"
  ]),
  ([ "action": "只见$N手上$w越使越快，四面八方都像是刀光剑影，挺身而起，一招「异兵突起」，把$n团团围起，翻身向$n的「气海」，「百会」，「志堂」，「命门」，四处大穴刺去",
    "damage": 90,
    "force": 400,

    "damage_type": "割伤"
  ]),
  ([ "action": "忽见$N双手握紧$w，剑锋茫茫，奋不顾身冲向$n，顿时沙石横飞，$n被剑势所迫，登时不知所措，这正是八卦剑法绝招之一的「天地人和」",
    "damage": 100,
    "force": 450,

    "damage_type": "刺伤"
  ]),
  ([ "action": "$N大叫了一声，「看剑！」，剑已与$N融为一体，全身内力已灌注在剑锋的一点，迅间触发，一招「剑在人在」已到$n眼前，毫无防守之意，只求同归于尽",
    "damage": 110,
    "force": 350,

    "damage_type": "刺伤"
  ])
});


int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me) {
  if ((int)me->query("max_neili") < 100)
    return notify_fail("你的内力不够。\n");

  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("bagua-jianfa", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("jingli") < 50)
    return notify_fail("你的精力不够修练八卦剑法。\n");
  me->receive_damage("jingli", 30, "精力透支过度死了");
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "bagua-jianfa/" + action;
}
