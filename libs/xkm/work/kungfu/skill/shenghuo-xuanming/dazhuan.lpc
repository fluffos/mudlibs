//Cracked by Roath
// dazhuan.c 圣火大转
//wzfeng 2002 1
#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int exert(object me, object target) {
  int skill;

  if (target != me)
    return notify_fail("你只能用圣火大转来提升自己的战斗力。\n");

  if ((int)me->query("neili") < 1000)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_temp("dazhuan"))
    return notify_fail("你已经施展圣火大转了。\n");

  skill = me->query_skill("force");
  me->add("neili", -skill * 6 / 5);
  me->add("jingli", -skill / 5);
  me->receive_damage("qi", 0);

  message_vision(
    HIR "$N大喝一声，双手扬起，形成两个火焰手印，顿时脸上红光大盛。\n"
    "$N接着$N双手转动，划成两个大圆圈，功力随着转动不断提升。\n" NOR, me);

  me->add_temp("apply/attack", skill / 3);
  me->add_temp("apply/dodge", skill / 3);
  me->add_temp("apply/parry", skill / 3);
  me->add_temp("apply/damage", skill / 3 / 3);
  me->set_temp("dazhuan", 1);

  me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill / 3 :), skill / 8);

  if (me->is_fighting()) me->start_busy(2);

  return 1;
}

void remove_effect(object me, int amount) {
  me->add_temp("apply/attack", -amount);
  me->add_temp("apply/dodge", -amount);
  me->add_temp("apply/parry", -amount);
  me->add_temp("apply/damage", -amount / 3);
  me->delete_temp("dazhuan");
  message_vision(HIR "$N脸上光一隐，将圣火大转的内劲收回丹田。\n" NOR, me);
}
