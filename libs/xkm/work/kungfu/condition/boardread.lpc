// boardread.c
//
// Cooldown condition applied by inherit/misc/bboard.lpc's do_read() to
// throttle "chatpts" gains from reading board messages: as long as this
// condition is active, further reads don't grant more chatpts.

int update_condition(object me, int duration) {
  if (duration < 1)
    return 0;
  me->apply_condition("boardread", duration - 1);
  return 1;
}
