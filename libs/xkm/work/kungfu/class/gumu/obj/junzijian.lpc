// junzijian.c
// By Lgg,1998.9

#include <ansi.h>
#include <weapon.h>
inherit SWORD;
inherit F_UNIQUE;

void create() {
  set_name(HIC "君子剑" NOR, ({ "junzijian", "jian", "sword" }));
  set_weight(7000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是一口遍体通黑的剑，剑身上用金丝锩着几个字：\n"
      "谦谦君子，温润如玉\n");
    set("value", 12000);
    set("material", "steel");
    set("weapon_prop/personality", 24);
    set("wield_msg", "$N低叹一声，将$n缓缓抽出剑鞘。\n");
    set("unwield_msg", "$N右手一晃，$n已然回鞘。\n");
  }
  init_sword(110);
  setup();
}
int wield() {
  object me = environment();
  object ob = this_object();
  int ret;

  if (!wizardp(me) && me->query("gender") != "男性") {
    message_vision(MAG "$N轻轻拿出$n，只觉的有点重，不太合手,还是丢了吧！” 于是$N随手把$n丢到了地上。\n" NOR, me, ob);
    ob->move(environment(me));
    return 0;
  } else if (ret = ::wield()) {
    message_vision(HIC "只见$N哈哈大笑，从被后拔出一把君子剑握在手中。\n" NOR, me);
    return 0;
  }
}
