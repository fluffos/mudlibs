dbase (["board_id":"news_b","name":"[1;33m《梦》新闻版[37;0m","no_get":1,"long":"这是一个供广播新闻的留言板。","capacity":99,"location":"/d/wizard/news_room","id":"newsboard","notes":({(["time":1027350915,"author":"海洋(jhy)","title":"欢迎大家光临梦站","msg":"现在梦站正式从开，欢迎新老player，为了感谢新老玩家，我们将在这两个月内，送点大礼给大家，过期可没有呀。","id":"jhy","num":277,]),(["time":1027652605,"author":"浪子(program)","title":"喜讯","msg":"三字经，百家姓，千字文，不再招贼了可以放心的带着了。","id":"program","num":236,]),(["time":1027802920,"author":"浪子(program)","title":"千字文，百家姓，可以读了","msg":"bug基本修好了，可以在任何地方读了有qzw的玩家请丢掉，然后来要以后quit之后再上线也不会存在在身上了，需要重新要","id":"program","num":218,]),(["time":1027810625,"author":"浪子(program)","title":"特喜","msg":"前20个过100k的玩家可以去开发站作immortal因为将来开发站将限制登陆级别addoil all                           puma","id":"program","num":221,]),(["time":1027918964,"author":"浪子(program)","title":"关于开站前两个月禁止PK的公告","msg":"前段时间由于服务器问题，本站被迫关闭一段时间这次从新开站，本着玩家第一的口号，为玩家提供一个和平、公正、公平、可玩性高的xkx并对前两个月进入本站注册的player给予一定特殊奖励这两个月内，player除了遵守前边的rules外，特令禁止PK,违反者给予严重惩罚。","id":"program","num":207,]),(["time":1027957407,"author":"海洋(jhy)","title":"news add maphere","msg":"为不熟悉地图的朋友,新加了一条maphere命令,用来查所在位置的地图.","id":"jhy","num":206,]),(["time":1028165156,"author":"海洋(jhy)","title":"告新老玩家好消息","msg":"谢谢大家一直以来对梦的关心，由于以前的数据丢失，老玩家要从头练，梦决定在现有的基础上在送20级基本功夫给大家，是在现有的基础上加20级，所以大家加紧练基本功，越后领skill越好，^O^希望大家玩的开心。。","id":"jhy","num":215,]),(["time":1028329100,"author":"海洋(jhy)","title":"更新了sos指令","msg":"梦为了大家在这里玩的开心，便于wiz及时处理玩家在游戏过程中出bug,大神puma修改了sos指令增加了用wiz频道同步提示功能，以便wiz发现您的sos报告，好在第一时间为您解决，请您在出现bug时用该指令，和提出您对本站的建意和意见，也请您监督我们的工作。谢谢大家！！","id":"jhy","num":193,]),(["time":1028829456,"author":"浪子(program)","title":"lingjiu 弟子福音","msg":"取消music 的门派限制，任何门派在达到一定music基础之后都可以lianxi lingjiu 新增 龙凤筝 ,放置在 戏凤阁 里边 并增加 筝谱 ，可以读到 61级从 xu zhu 那里出发，n,e,e,e 就能得到龙凤筝可做 刀 用，攻击力 50","id":"program","num":194,]),(["time":1029253590,"author":"飘雪㊣(snow)","title":"dugu-jiujian新pf","msg":"dugu-jiujian新增加了一个pfperform jiu(独孤九剑)嘿嘿，等级越高，出招越多，大家试试吧","id":"snow","num":183,]),(["time":1029319944,"author":"飘雪㊣(snow)","title":"重新更新了dugu-jiujian","msg":"dugu-jiujian的pfperform jiu更新了只能出9招","id":"snow","num":172,]),(["time":1029423544,"author":"沙漠之子(smzz)","title":"梦站论坛开始竞选各斑竹","msg":"为了梦也为了玩家,我们增设了多个分斑快.因为增设速度之快,发贴量也在日渐增多.考虑人手不够现打破一般MUD BBS由巫师担任斑竹的惯例,所以面向玩家招收新的斑竹.地址: xkmbbs.my163.com","id":"smzz","num":177,]),(["time":1029613250,"author":"海洋(jhy)","title":"欢迎大家测试离线功能","msg":"今天把离线功能加上了，欢迎大家测试和post测试报告。谢谢大家支持合作!!!","id":"jhy","num":204,]),(["time":1030934673,"author":"王洪亮(whl)","title":"新加离线练功地点","msg":"在cs走{e;e;e;s;up}这里禁止打斗以及steal在这里昏迷任何人也不能带你离开","id":"whl","num":162,]),(["time":1031207372,"author":"海洋(jhy)","title":"告关心梦站的朋友","msg":"由于前几天的巫师id被盗用的原因，给大家造成很坏的影响，以做出了开除和pg有问题的id,为了感谢谢大家把梦站当着自己的家一样来爱护，我从心底感谢谢大家，并为所有的id加了1k贡献度，以表谢意，没有收到gxd的朋友请是在线的巫师申请补给，另外现禁止巫师给丢物器给玩家，并给入了公开give drop物品在的chat的监视频道，大家有bug请用sos来报告wiz,请贴上bug内容，以方便解决，禁止在公共chat里辱骂发现就关chat,梦站的新老玩家补偿的add all的npc将在本月中旬撤消请大家务必珍惜这次机会，过期不补。","id":"jhy","num":158,]),(["time":1031322484,"author":"海洋(jhy)","title":"to all player","msg":"明天中午12点移档到正式站，界时请大家save。用218.64.160.248   5555登陆希望那边能给大家带来好运。谢谢大家的好护，请大家合作!!!!","id":"jhy","num":171,]),(["time":1031324371,"author":"海洋(jhy)","title":"取消qq的不丢设置","msg":"现取消qq糖的不丢设置请大家，尽快用完自己的qq,丢失不补。谢谢大家合作!!!","id":"jhy","num":171,]),(["time":1031458655,"author":"飘雪㊣(snow)","title":"feizei","msg":"大家打fei zei的时候注意力度不然打死是没有lingzhi的这一点过时候再改","id":"snow","num":178,]),(["time":1032566416,"author":"海洋(jhy)","title":"祝大家中秋快乐","msg":"今天是传统的中秋，在这里祝大家节日愉快，学习进步，工作顺利,合家团圆。今天我们特别赶制了中秋月饼，口味不一定大家能满意，但是我们的一点心意。有关领取事宜，请您向知百事打听，我代表全体巫师，再次祝大家节日愉快！！！^_^","id":"jhy","num":163,]),(["time":1033610071,"author":"飘雪㊣(snow)","title":"慕容skill","msg":"对于murong 的所有skill我认为应该降下的都降下去了，总不能太狠吧，应该注意下平衡啥有意见大家提特别是canhe-zhi做了大的调整","id":"snow","num":158,]),(["time":1034317535,"author":"海洋(jhy)","title":"关于天赋调整","msg":"—————————————————————————————由于开站的时候，我们欠考虑，开站时天赋为105点，加上end可选成负数，现在为100后一项不低于10前4项总和一般在90右左，给新人造成了很大的负面影响，调整是在必行请大家各自尽早的在bbs上跟贴，在动议上投票，本月20号前后正式调整。请大家合作把我们的梦搞的越来越好，越来越旺。","id":"jhy","num":129,]),(["time":1034949314,"author":"海洋(jhy)","title":"更新注册系统","msg":"现在梦站注册以修改为可手动和自动分配天赋，手动经自动少1点天赋，前4项总和为103 和104，希望大家能满意，祝大家玩的开心。愿我们的梦越来越好!!!","id":"jhy","num":129,]),(["time":1035344380,"author":"海洋(jhy)","title":"招网页制作维护wiz一名","msg":"由于本人没有时间维护和更新侠客梦的家页。为了侠客梦的发展，现招收一名，认真负责的家页管理维护wiz一名，望有意者有能力者踊跃报名。","id":"jhy","num":131,]),(["time":1037455708,"author":"飘雪㊣(snow)","title":"jj pf and mr skill pf","msg":"dugu-jiujian的pf jiu的等级要求加高。慕容派murong-jianfa新pf:perform qixing要求很高。可连出七剑。各慕容玩家可以试下。有意见post出来。","id":"snow","num":100,]),(["time":1038053380,"author":"明亮(bright)","title":"斧头帮更新","msg":"斧头帮更新内容如下:1. 如果完成任务,而且受伤.可以 ask cheng about heal (之前必须交完这次任务).2.杀完刺客,记得look 一下,看看刺客会留下什么东西哦:)本次更新比较匆忙,如果有bug请post. 以后ftb将还会增加一些内容.","id":"bright","num":92,]),(["time":1038053474,"author":"明亮(bright)","title":"斧头帮调整","msg":"由于大家反应出灵芝的几率太高,现修改如下:灵芝几率: 1/10一两黄金: 1/5 气死你:)一定元宝: 1/6 嘿嘿菩提子 : 1/100 sing2会出现什么也没的情况.","id":"bright","num":96,]),(["time":1038398138,"author":"海洋(jhy)","title":"11月28日上午重起请大家随时存盘","msg":"","id":"jhy","num":97,]),(["time":1038658614,"author":"明亮(bright)","title":"星宿new pfm","msg":"星宿new perform 开放!\"抽髓碧磷\":		效果 连出三掌,同时会发出数枚碧磷针(带毒).要求: 1. chousui-zhang 120 lv      2. feixing-shu   100 lv      3. force         120 lv      4. max_neili     1000      5. 身上碧磷针数目>= 4另外 碧磷针的获得 有所调整:可以找些毒蛛丝来制作,指令 make bilin zhen","id":"bright","num":89,]),(["time":1038658722,"author":"明亮(bright)","title":"hoho","msg":"pfm 指令 : perform bilin xixi","id":"bright","num":81,]),(["time":1038676233,"author":"海洋(jhy)","title":"喜讯","msg":"为了活跃mud的气氛，和鼓励大家多为本游戏出谋划策，现开放贡献度，大家可以用各种方式来获得贡献度。用贡献度来换取您想要的一些东西,愿这能来动本游戏的发展，愿大家玩的更开心！","id":"jhy","num":83,]),(["time":1038704412,"author":"海洋(jhy)","title":"更新","msg":"更新冰洞和风洞的练功速度，同时上调冰洞练功上线到500lv force。希望能让大家练的轻松点，^_^!!!","id":"jhy","num":83,]),(["time":1038711623,"author":"日月(bright)","title":"全真whip book update !","msg":" 全真whip book update !now can add whip 101 lv !","id":"bright","num":92,]),(["time":1038796034,"author":"海洋(jhy)","title":"更新","msg":"更新年龄计算方式，由原来的二个级段的成长，改为5个级段的成长，1.14－16为24小时1岁2.16－24为48小时。3。24－48为72小时，4.48－76为96小时，5.76－为72小时。希望大家有好运！！","id":"jhy","num":89,]),(["time":1038798919,"author":"海洋(jhy)","title":"qq糖更新","msg":"从新更新，现在大代qq,exp 100k以下可以拿吃到200k,小袋为200k下可以拿吃到300k。","id":"jhy","num":93,]),(["time":1039150276,"author":"日月(bright)","title":"新增 \"易经文学\"","msg":"新增加的 “易经文学” 可以读 literate 到 300 级。不过消耗很大 同时费 内力,精,潜能! 易经文学加在 灵鹫宫 ！在虚竹处 ask xu about 易经 或 ask xu about jing 只有lingjiu 弟子才能要到！但易经文学可以give 有需要的找lingjiu dizi 帮忙吧。------------bright-------- ","id":"bright","num":87,]),(["time":1039268575,"author":"日月(bright)","title":"化功 yun hua update !","msg":"1.化功大法 yun hua 更新！提高 yun hua 持续时间，  并且提高一定的防御能力。2.新加 yun reverse ，yun hua后 可通过yun reverse   消除yun hua状态！--------------bright------------","id":"bright","num":79,]),(["time":1039322799,"author":"风花雪月(bright)","title":"修复一处bug！","msg":"星宿 pfm pifeng 在 yun hua 之前结束。 yun hua 状态结束后造成jifa parry and dodge 减少一半。现在已经修复。----------------bright-------------","id":"bright","num":76,]),(["time":1039499677,"author":"海洋(jhy)","title":"ftb收益上调","msg":"现在ftb的收益上调。希望能让ftb繁荣.","id":"jhy","num":71,]),(["time":1039878402,"author":"海洋(jhy)","title":"update ftb","msg":"ftp只能做到10m以后就不能在做了，不然exp少了我们不负责。请大家注意!!!","id":"jhy","num":62,]),(["time":1040132915,"author":"海洋(jhy)","title":"updata clb","msg":"长乐帮做了一点调整，洗澡可以full hp,同时有10/1机会得一点精力，调整了洗澡时间和减一点功劳点大家有什么想法请post，我们看情况进行调整，望大家玩的开心","id":"jhy","num":61,]),(["time":1040462650,"author":"海洋(jhy)","title":"update 悬崖","msg":"对悬崖做了一个小的调整，现在climb比原来快1.5倍。希望能给各位带来好运！！^_^。","id":"jhy","num":61,]),(["time":1040556404,"author":"海洋(jhy)","title":"比武大会","msg":"经多方考虑现定为正月初5举行比武大会，现离大会还有一段时间望大家力油练功，取得好的成绩比武细则和奖励办法近日出台。祝大家名列前茅！！O_O","id":"jhy","num":76,]),(["time":1040907021,"author":"海洋(jhy)","title":"关于飞贼","msg":"feizei 文件从新修改过现在谁k的直接把灵之和1gold放到id身上。修改了原来pxj会出现死多次的问题。谢谢大家一直对这个问题的直言。希望喜欢这个job.","id":"jhy","num":60,]),(["time":1040958684,