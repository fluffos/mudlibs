#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg)
{
	int news_num;

	string *option;
	object news_ob;
	seteuid(geteuid(me));
	if(!wizardp(me))
		return notify_fail ("你不是巫师，不能使用这个命令。\n");
	if( !arg ) 
		return notify_fail("指令格式：newspub <您要发布的新闻名称>\n");

	return NEWS_D->do_post(me, arg);
	

}
int help(object me)
{
        write(@HELP
指令格式 : newspub <新闻题目>
 
发布新闻。
 
HELP
    );
    return 1;
}

