// jiebai.c from hy
//Modified by Seashore 2002/5/13

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	object obj, old_target;
	mapping *swornfriend, toswear;
	int i;

	if(me->query("age") < 15)
		return notify_fail("小孩子一边玩儿去。\n");

	swornfriend = me->query("swornfriend");
	if (sizeof(swornfriend) >=5)
		return notify_fail("你的结拜兄弟姐妹已经太多了。\n");

	if(!arg || !objectp(obj = present(arg, environment(me))))
		return notify_fail("你想和谁结拜？\n");

	if( !obj->is_character() )
		return notify_fail("看清楚一点，那并不是生物。\n");

	if( !userp(obj) )
		return notify_fail("你只能和玩家拜把子。\n");

	if(obj == me)
		return notify_fail("你不能和自己结拜。\n");

	swornfriend = obj->query("swornfriend");
	if (sizeof(swornfriend) >=5)
		return notify_fail("对方的结拜兄弟姐妹已经太多了，不能再和你结拜了：）\n");

	if( !living(obj) )
		return notify_fail("嗯...你还是先把"+obj->name()+"弄醒吧。\n");

	if (sizeof(swornfriend))
	{
		for (i = 0 ; i < sizeof(swornfriend) ; i++)
		if (swornfriend[i]["id"] == me->query("id"))
			return notify_fail("你已经和人家结拜过了。\n");
	}

	if( userp(obj) && (object)obj->query_temp("pending/jiebai")!=me ) {
		message_vision("\n$N对著$n说道：" 
			+ RANK_D->query_self(me) 
			+ me->name() + "，对"
			+ RANK_D->query_respect(obj) + "心仪已久，愿彼此生死与共，肝胆相照！\n\n", me, obj);
		if( objectp(old_target = me->query_temp("pending/jiebai")) )
			tell_object(old_target, RED + me->name() + "取消了和你结拜的念头。\n" NOR);
		me->set_temp("pending/jiebai", obj);
		tell_object(obj, YEL "如果你愿意和对方结为异姓骨肉，请你也对" + me->name() + "("+(string)me->query("id")+")"+ "下一次 jiebai 指令。\n" NOR);
		write(RED "对方必须同意才能结拜。你等着吧。\n" NOR);
		return 1;
	}
	
	message_vision("\n$N对着$n高声说道：不求同年同月同日生，但愿同年同月同日死！\n\n", me, obj);
	tell_object(me,HIR"恭喜你又多了一位结义金兰！\n"NOR);
	tell_object(obj,HIR"恭喜你又多了一位结义金兰！\n"NOR);
	
	me->delete_temp("pending/jiebai");
	obj->delete_temp("pending/jiebai");

	toswear = ([]); 
	toswear["id"] = obj->query("id");
	toswear["name"] = obj->query("name");
	swornfriend = me->query("swornfriend");
	if( !pointerp(swornfriend) || !sizeof(swornfriend) )
		swornfriend = ({ toswear });
	else
		swornfriend += ({ toswear });
	me->set("swornfriend", swornfriend);
	
	toswear = ([]);
	toswear["id"] = me->query("id");
	toswear["name"] = me->query("name");
	swornfriend = obj->query("swornfriend");

	if( !pointerp(swornfriend) || !sizeof(swornfriend) )
		swornfriend = ({ toswear });
	else
		swornfriend += ({ toswear });
	obj->set("swornfriend", swornfriend);
	
        message("channel:chat", HIM+"【通告】"+me->query("name")+"和"+obj->query("name")+"从今日起义结金兰，望各位江湖好友周知！\n"NOR,users());
	
	return 1;
}
 
int help(object me)
{
write(@HELP
指令格式 : jiebai <某人>
 
这个指令用来和别人的结拜，当然对方必须也同意。

HELP
    );
    return 1;
}
