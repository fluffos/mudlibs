// xktask.c 
// by join@XK3 2001-3-5：玩家还需消耗神，gin和sen的消耗随机。战斗和精神小于50不能查看使命。

#include <ansi.h>
int main(object me, string str) {
  string output;
  if (me->is_fighting())
    return notify_fail("慢慢打....\n");
  if (!wizardp(me)) {
    if (me->query("gin") < 50 || me->query("sen") < 50)
      return notify_fail("你现在身心疲惫，无心探讨任务的物件。\n");
    me->add("gin", -20 - random(5));
    me->add("sen", -15 - random(10));
  }
  output = HIB "◎  侠客英雄传神书榜\n" NOR;
  output += "———————————————————————————\n";
  output += TASK_D->dyn_quest_list();
  output += "———————————————————————————\n\n";

  me->start_more(output);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式: xktask
相关文件: help tasks

这个指令是用来得知目前的所有神书.

HELP
  );
  return 1;
}
