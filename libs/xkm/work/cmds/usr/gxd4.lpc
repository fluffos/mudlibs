// gxd cmds jhy add 02.9.1
 
#include <ansi.h>
 
inherit F_CLEAN_UP;
 
//string status_color(int current, int max);
 
int main(object me, string arg)
{
	object ob;
	int gxd;
 
	seteuid(getuid(me));
 
	if(!arg)
		ob = me;
	else if (wizardp(me)) {
		ob = present(arg, environment(me));
		if (!ob) ob = find_player(arg);
		if (!ob) ob = find_living(arg);
        if (!ob) return notify_fail("你要察看谁的状态？\n");
	} else
		return notify_fail("只有巫师能察看别人的状态。\n");
 	gxd=((int)ob->query("chatpts"));
    printf(HIY"       %10s目前的侠客梦贡献度是："HIR"%9d"HIY" 点\n  "NOR,(string)ob->query("name"),gxd);//(int)ob->query("menggxd")/10);
  	return 1;
}
int help(object me)
{
	write(@HELP
指令格式 : gxd
           gxd <对象名称>                   (巫师专用)
 
这个指令可以显示你(你)或指定对象(含怪物)的精, 气, 神数值。
 
see also : score
HELP
    );
    return 1;
}

