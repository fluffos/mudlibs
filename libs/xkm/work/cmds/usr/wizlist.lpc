// wizlist.c

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  string *list, COLOR;
  mapping wizstatus;
  object body;
  int j = 0;
  int i, dspladm, dsplarc, dsplwiz, dsplvir, dsplcar, dspldsn, dsplcrt, dsplapp, dsplimm;
  if (arg) {
    if (arg == "-d") {
      me->start_more(read_file("/cmds/usr/tasklist.o"));
      return 1;
    } else {
      write("请使用help wizlist来查看使用方法。\n");
      return 1;
    }
  }
  write(HBBLU + HIY + MUD_NAME + "目前的巫师有：                                               \n" NOR);


  //	for(int i=0; i<sizeof(list); i++)
  //		printf("%-15s%c", list[i],  (i%5==4) ? '\n' : ' ');

  wizstatus = SECURITY_D->query_wizstatus();
  list = keys(wizstatus);

  for (i = 0; i < sizeof(list); i++) {
    if (strsrch(wizstatus[list[i]], "(admin)") >= 0) dspladm = 1;
    if (strsrch(wizstatus[list[i]], "(arch)") >= 0) dsplarc = 1;
    if (strsrch(wizstatus[list[i]], "(wizard)") >= 0) dsplwiz = 1;
    if (strsrch(wizstatus[list[i]], "(virtuoso)") >= 0) dsplvir = 1;
    if (strsrch(wizstatus[list[i]], "(caretaker)") >= 0) dsplcar = 1;
    if (strsrch(wizstatus[list[i]], "(designer)") >= 0) dspldsn = 1;
    if (strsrch(wizstatus[list[i]], "(creator)") >= 0) dsplcrt = 1;
    if (strsrch(wizstatus[list[i]], "(apprentice)") >= 0) dsplapp = 1;
    if (strsrch(wizstatus[list[i]], "(immortal)") >= 0) dsplimm = 1;
  }

  if (wiz_level(me) >= wiz_level("(arch)") || wiz_level(me) == wiz_level("(virtuoso)") && me->geteuid() != "npc") {
    if (dspladm) {
      j = 0;
      write(HIW "\n『天帝』  " NOR);
      for (i = 0; i < sizeof(list); i++) {
        if (wizstatus[list[i]] == "(admin)") {
          j++;
          //					printf("%-10s%c", list[i],  (j%5==0) ? '\n' : ' ');
          if (j % 5 == 1 && j > 1) printf("\n" + "          ");
          body = LOGIN_D->find_body(list[i]);
          if (objectp(body) && interactive(body) && me->visible(body))
            printf(HIW "%-11s" NOR, list[i]);
          else printf("%-11s", list[i]);
        }
      }
      write("\n");
    }
  }
  //!me->visible(target) interactive(body)

  if (dsplarc) {
    j = 0;
    write(HIY "\n『大神』  " NOR);
    for (i = 0; i < sizeof(list); i++) {
      if (wizstatus[list[i]] == "(arch)") {
        j++;
        if (j % 5 == 1 && j > 1) printf("\n" + "          ");
        body = LOGIN_D->find_body(list[i]);
        if (objectp(body) && interactive(body) && me->visible(body))
          printf(HIY "%-11s" NOR, list[i]);
        else printf("%-11s", list[i]);
      }
    }
    write("\n");
  }

  if (dsplwiz) {
    j = 0;
    write(HIG "\n『神仙』  " NOR);
    for (i = 0; i < sizeof(list); i++) {
      if (wizstatus[list[i]] == "(wizard)") {
        j++;
        if (j % 5 == 1 && j > 1) printf("\n" + "          ");
        body = LOGIN_D->find_body(list[i]);
        if (objectp(body) && interactive(body) && me->visible(body))
          printf(HIG "%-11s" NOR, list[i]);
        else printf("%-11s", list[i]);
      }
    }
    write("\n");
  }

  if (wiz_level(me) >= wiz_level("(arch)") || wiz_level(me) == wiz_level("(virtuoso)") && me->geteuid() != "npc") {
    j = 0;
    write(HIM "\n『散仙』  " NOR);
    for (i = 0; i < sizeof(list); i++) {
      if (wizstatus[list[i]] == "(virtuoso)") {
        j++;
        if (j % 5 == 1 && j > 1) printf("\n" + "          ");
        body = LOGIN_D->find_body(list[i]);
        if (objectp(body) && interactive(body) && me->visible(body))
          printf(HIM "%-11s" NOR, list[i]);
        else printf("%-11s", list[i]);
      }
    }
    write("\n");
  }
  /*if (dspldsn)
	{
		j=0;
		write(GRN"\n『天师』  "NOR);
		for( i=0; i<sizeof(list); i++)
		{
			if( wizstatus[list[i]] == "(designer)" )
			{
				j++;
				if (j%5==1 && j > 1) printf("\n"+"          ");
				body = LOGIN_D->find_body(list[i]);
				if (objectp(body) && interactive(body) && me->visible(body))
					printf(GRN"%-11s"NOR, list[i]);
				else 	printf("%-11s", list[i]);
			}
		}
		write("\n");
	}*/

  if (dsplcrt) {
    j = 0;
    write(HIC "\n『天仙』  " NOR);
    for (i = 0; i < sizeof(list); i++) {
      if (wizstatus[list[i]] == "(creator)") {
        j++;
        if (j % 5 == 1 && j > 1) printf("\n" + "          ");
        body = LOGIN_D->find_body(list[i]);
        if (objectp(body) && interactive(body) && me->visible(body))
          printf(HIC "%-11s" NOR, list[i]);
        else printf("%-11s", list[i]);
      }
    }
    write("\n");
  }

  /*	if (dsplcar)
	{
		j=0;
		write(YEL"\n『天官』  "NOR);
		for( i=0; i<sizeof(list); i++)
		{
			if( wizstatus[list[i]] == "(caretaker)" )
			{
				j++;
				if (j%5==1 && j > 1) printf("\n"+"          ");
				body = LOGIN_D->find_body(list[i]);
				if (objectp(body) && interactive(body) && me->visible(body))
					printf(YEL"%-11s"NOR, list[i]);
				else 	printf("%-11s", list[i]);
			}
		}
		write("\n");
	}*/


  /*	if (dsplapp)
	{
		j=0;
		write(MAG"\n『仙人』  "NOR);
		for( i=0; i<sizeof(list); i++)
		{
			if( wizstatus[list[i]] == "(apprentice)" )
			{
				j++;
				if (j%5==1 && j > 1) printf("\n"+"          ");
				body = LOGIN_D->find_body(list[i]);
				if (objectp(body) && interactive(body) && me->visible(body))
					printf(MAG"%-11s"NOR, list[i]);
				else 	printf("%-11s", list[i]);
			}
		}
		write("\n");
	}*/

  if (dsplimm) {
    j = 0;
    write(CYN "\n『半仙』  " NOR);
    for (i = 0; i < sizeof(list); i++) {
      if (wizstatus[list[i]] == "(immortal)") {
        j++;
        if (j % 5 == 1 && j > 1) printf("\n" + "          ");
        body = LOGIN_D->find_body(list[i]);
        if (objectp(body) && interactive(body) && me->visible(body))
          printf(CYN "%-11s" NOR, list[i]);
        else printf("%-11s", list[i]);
        //				if(j==5)break;
      }
    }
    write("\n\n");
  }
  //	write("\n\n");
  write(HIB "───────────────────────────────────\n" NOR);
  write("(高亮显示的为在线的巫师)请使用 wizlist -d 来查看巫师组更详细的情况。\n"
    "如有兴趣向侠客梦申请做巫师的朋友请看:help wiz_apply。\n");

  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : wizlist

用途 : 列出目前所有的巫师名单。
HELP
  );
  return 1;
}
