// Change by puma
// email.c

inherit F_CLEAN_UP;
private void write_ob(object ob, string msg) {
  if (objectp(ob) && ob->query("language") == "BIG5")
    msg = "/adm/daemons/languaged"->toBig5(msg);

  write(msg);
}

int main(object me) {
  object ob;
  if (me != this_player(1)) return 0;

  ob = me->query_temp("link_ob");
  if (!ob) return 0;
  while (ob && ob->is_character()) ob = ob->query_temp("link_ob");

  write("请输入你的的email：");
  input_to("get_email", 1, ob);
  return 1;
}

private void get_email(string email, object ob) {
  write_ob(ob, "\n");
  if (email == "" || strsrch(email, "@") == -1) {
    write_ob(ob, "电子邮件地址需要是 id@address 的格式。\n");
    write_ob(ob, "您的电子邮件地址：");
    input_to("get_email", ob);
    return;
  }
  seteuid(getuid());
  if (!ob->set("email", email)) {
    write("email变更失败！\n");
    return;
  }

  ob->save();
  write("email变更成功\。\n");

}

int help(object me) {
  write(@HELP
指令格式 : email
 
这个指令可以修改你的人物的email。
 
HELP
  );
  return 1;
}
