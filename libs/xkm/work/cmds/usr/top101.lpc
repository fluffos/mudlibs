inherit F_CLEAN_UP;

#include <ansi.h>

#define SET_LVL	"(wizard)"
#define COM_LVL	"(immortal)"

int help();
int help_open();
int help_close();
int help_set();
int help_adb();
int main(object me, string arg) {
  string top_id, top_name, top_prop;
  string *msg_a, id, name, msg, log;
  object ob;
  mapping tops;
  int i;
  TOPTEN_D->topten_checkplayer(me);
  if (!arg || arg == "") {
    msg = TOPTEN_D->query_top("", TOP_ID_NAMES);
    if (msg == "") return notify_fail("现在还没有排行榜.\n");
    msg_a = explode(msg, ";");
    write(HIW "现在有如下排行榜:\n───────────────────────\n" NOR);
    for (i = 0; i < sizeof(msg_a); i++)
      if (sscanf(msg_a[i], "%s(%s)", id, name) == 2)
        write(HIW "top " + id + NOR "    \t\t" HIG "百大"
          +name + "排行榜" HIW "\n───────────────────────\n" NOR);
    return 1;
  }
  if (wiz_level(me) >= wiz_level(SET_LVL)) {
    //topen 部分，添加了判断功能，以免误操作时覆盖已有排行榜。
    if (arg == "open") return help_open();
    if (sscanf(arg, "open %s", arg) == 1) {
      if (sscanf(arg, "%s %s %s", top_id, top_name, top_prop) == 3) {
        if ((msg = TOPTEN_D->topten_query(top_id)) != "")
          return notify_fail(HIW "这种排行榜已经存在！\n" NOR);
        if (TOPTEN_D->add_top(top_id, top_name, top_prop))
          write(HIW "你成功的建立了top100 " + top_id + "百大" + top_name + "排行榜。\n" NOR);
        log = sprintf(
          "%s(%s) 于 %s 建立了 %s(%s) 排行榜！\n",
          me->name(),
          me->query("id"),
          ctime(time()),
          top_name,
          top_id
        );
        log_file("cmds/top100", log);
        return 1;
      } else return help_open();
    }
    //tclose 部分，添加删除前判断是否存在，删除同时 unset 该排行榜设定。
    if (arg == "close") return help_close();
    if (sscanf(arg, "close %s", arg) == 1) {
      if ((msg = TOPTEN_D->topten_query(arg)) == "")
        return notify_fail(HIW "没有这种排行榜。\n" NOR);
      TOPTEN_D->unset_min_limit(arg);
      TOPTEN_D->delete_top(arg);
      write(HIW "你删除了top100 " + arg + " 排行榜\n" NOR);
      log = sprintf("%s(%s) 于 %s 将 %s 排行榜删除了！\n", me->name(), me->query("id"), ctime(time()), arg);
      log_file("cmds/top100", log);
      return 1;
    }
  }
  if (wiz_level(me) >= wiz_level(COM_LVL)) {
    //tset 部分，另加上 unset 功能
    if (arg == "set" || arg == "unset") {
      write(TOPTEN_D->query_min_limit());
      return 1;
    }
    if (sscanf(arg, "set %s", arg) == 1) {
      if (sscanf(arg, "%s %d", top_id, i) != 2)
        return help_set();
      if ((msg = TOPTEN_D->topten_query(top_id)) == "")
        return notify_fail(HIW "没有这种排行榜。\n" NOR);
      if (TOPTEN_D->set_min_limit(top_id, i)) {
        write(HIW "你将进入 " + top_id + " 排行榜的最小限定值设置为：" + i + " ！\n" NOR);
        log = sprintf(
          "%s(%s) 于 %s 将 %s 排行榜的最小限定值设置为 %d！\n",
          me->name(),
          me->query("id"),
          ctime(time()),
          top_id,
          i
        );
        log_file("cmds/top100", log);
      } else write(HIW "设置 " + top_id + " 排行榜失败。\n" NOR);
      return 1;
    } else if (sscanf(arg, "unset %s", arg) == 1) {
      if ((msg = TOPTEN_D->topten_query(arg)) == "")
        return notify_fail(HIW "没有这种排行榜。\n" NOR);
      if (TOPTEN_D->unset_min_limit(arg))
        write(HIW "你将进入 " + arg + " 排行榜的最小限定值取消了 ！\n" NOR);
      log = sprintf(
        "%s(%s) 于 %s 将 %s 排行榜的最小限定值取消了！\n",
        me->name(),
        me->query("id"),
        ctime(time()),
        arg
      );
      log_file("cmds/top100", log);
      return 1;
    }
    //tadd 部分
    else if (arg == "add" || arg == "del" || arg == "ban") return help_adb();
    else if (sscanf(arg, "add %s", arg) == 1) {
      if (sscanf(arg, "%s %s", top_id, id) != 2)
        return help_adb();
      if (!(ob = find_player(id))) ob = LOGIN_D->find_body(id);
      if (!ob) return notify_fail("这个玩家不在线上.\n");
      TOPTEN_D->topten_add(ob, top_id);
      write(HIW "你将" + ob->query("name") + "(" + id + ") 成功列入 " + top_id + "排行榜！\n" NOR);
      log = sprintf(
        "%s(%s) 于 %s 将 %s 列入 %s 排行榜中！\n",
        me->name(),
        me->query("id"),
        ctime(time()),
        id,
        top_id
      );
      log_file("cmds/top100", log);
      return 1;
    }
    //tdel 部分
    else if (sscanf(arg, "del %s", arg) == 1) {
      if (sscanf(arg, "%s %s", top_id, id) != 2)
        return help_adb();
      TOPTEN_D->topten_del(id, top_id);
      write(HIW "你将 ID 为 " + id + "的玩家从 " + top_id + " 排行榜中剔除！\n" NOR);
      log = sprintf(
        "%s(%s) 于 %s 将 %s 从 %s 排行榜中剔除！\n",
        me->name(),
        me->query("id"),
        ctime(time()),
        id,
        top_id
      );
      log_file("cmds/top100", log);
      return 1;
    }
    //tban 部分
    else if (sscanf(arg, "ban %s", arg) == 1) {
      if (sscanf(arg, "%s -u %s", top_id, id) == 2) i = 0;
      else if (sscanf(arg, "%s %s", top_id, id) == 2) i = 1;
      else return help_adb();
      if ((msg = TOPTEN_D->topten_query(top_id)) == "")
        return notify_fail(HIW "没有这种排行榜。\n" NOR);
      ob = find_player(id);
      if (!ob) ob = LOGIN_D->find_body(id);
      if (i) TOPTEN_D->topten_del(id, top_id);
      else if (ob) TOPTEN_D->topten_add(ob, top_id);
      TOPTEN_D->do_ban(top_id, id, i);
      if (i) {
        write(HIW "你取消了 " + id + " 参与 " + top_id + " 排行榜的资格！\n" NOR);
        log = sprintf(
          "%s(%s) 于 %s 取消了 %s 参与 %s 排行榜的资格！\n",
          me->name(),
          me->query("id"),
          ctime(time()),
          id,
          top_id
        );

      } else {
        write(HIW "你恢复了 " + id + " 参与 " + top_id + " 排行榜的资格！\n" NOR);
        log = sprintf(
          "%s(%s) 于 %s 恢复了 %s 参与 %s 排行榜的资格！\n",
          me->name(),
          me->query("id"),
          ctime(time()),
          id,
          top_id
        );
      }
      log_file("cmds/top100", log);
      return 1;
    }
  }
  if ((msg = TOPTEN_D->topten_query(arg)) == "")
    return notify_fail(HIW "没有这种排行榜。\n" NOR);
  write(msg);
  return 1;
}
int help() {
  object me = this_player();
  if (wiz_level(me) >= wiz_level(SET_LVL))
    write(HIG @HELP
☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆
⒈创建一个排行榜：		top100 open <top_id> <top_name> <top_prop>
⒉关闭一个排行榜：		top100 close <top_id>
⒊设定排行榜下限：		top100 set <top_id> <min_num>
⒋取消排行榜下限：		top100 unset <top_id>
⒌使某 id 进某排行榜：		top100 add <top_id> <id>
⒍使某 id 出某排行榜：		top100 del <top_id> <id>
⒎限制某 id 进某排行榜：	top100 ban [-u] <top_id> <id>
⒏列表显示排行榜内容：		top100 [top_id]
⒐使用方法：			help top100
☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆
HELP NOR);
  else if (wiz_level(me) >= wiz_level(COM_LVL))
    write(HIG @HELP
☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆
⒈设定排行榜下限：		top100 set <top_id> <min_num>
⒉取消排行榜下限：		top100 unset <top_id>
⒊使某 id 进某排行榜：		top100 add <top_id> <id>
⒋使某 id 出某排行榜：		top100 del <top_id> <id>
⒌限制某 id 进某排行榜：	top100 ban [-u] <top_id> <id>
⒍列表显示排行榜内容：		top100 [top_id]
⒎使用方法：			help top100
☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆
HELP NOR);
  else write(HIG @HELP
☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆
⒈列表显示排行榜内容：		top100 [top_id]
⒉使用方法：			help top100
☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆
HELP NOR);
  return 1;
}
int help_open() {
  write(HIG @HELP
top100 open top_id top_name top_prop

	（top_prop的意思是参与排序的那项任务属性）
	三个参数都是必须的，譬如要建立pker的排行榜，
	则应用如下命令：

	topen100 open pker 恶人 PKS

	该命令执行成功后，创建一个排行榜，以后可以用

	top100 pker

	查看十大恶人榜。
HELP NOR);
  return 1;

}
int help_close() {
  write(HIG "\ntop100 close top_id\n\n\t本指令用来删除一个排行榜。\n" NOR);
  return 1;
}
int help_set() {
  write(HIG @HELP
top100 set top_id <数值>

	设置进入排行榜所需要的最小值。例如：

	top100 set exp 10000

	则进入exp排行榜至少要有10000点经验。

top100 unset top_id

	取消进入排行榜所需要的最小值限制。
HELP);
  return 1;
}
int help_adb() {
  write(HIG @HELP
top100 add top_id id

	将玩家列入 top_id 榜中参与排行。

top100 del top_id id

	将玩家从 top_id 榜中剔除。

top100 ban top_id id

	使玩家不能参与 top_id 榜的排行。

top100 ban [-u] top_id id

	使玩家恢复参与 top_id 排行榜的权利。
HELP NOR);
  return 1;
}
