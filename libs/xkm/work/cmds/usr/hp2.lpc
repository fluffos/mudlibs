#include <ansi.h>
inherit F_CLEAN_UP;

string status_color(int current, int max);
int main(object me, string arg) {
  object ob;
  mapping my;
  int dao, x, i;
  string str;
  seteuid(getuid(me));

  if (!arg) ob = me;
  else if (wizardp(me)) {
    ob = present(arg, environment(me));
    if (!ob) ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) return notify_fail("您要察看谁的状态？\n");
  } else return notify_fail("只有巫师才可以察看别人的状态。\n");
  my = ob->query_entire_dbase();

  printf(NOR HIG "┏━━━━━━━━━━━━━━" HIR "Ｘ" HIC "·" HIR "Ｋ" HIC "·" HIR "Ｍ" HIG "━━━━━━━━━━━━━━━━┓\n" NOR,);
  printf(
    NOR HIG "┃" NOR WHT " 个人状态" NOR HIG " 姓 名：" NOR WHT "%-12s " NOR HIG " 性别：" NOR WHT "%-10s " NOR HIG "I D：" NOR WHT "%-14s" NOR HIG "   ┃\n" NOR,
    ob->name(),
    ob->query("gender"),
    "[" + capitalize(ob->query("id")) + "]"
  );
  printf(NOR HIG "┣━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┫\n" NOR);
  printf(
    NOR HIG "┃" NOR WHT "〖 精神 〗%s%7-d/%8-d%s[%3d%%]" NOR,
    status_color(my["jing"], my["eff_jing"]),
    my["jing"],
    my["eff_jing"],
    status_color(my["eff_jing"], my["max_jing"]),
    my["eff_jing"] * 100 / my["max_jing"]
  );
  printf(
    NOR WHT "  〖 精力 〗%s%8-d/%8-d[+%3d]" NOR HIG "   ┃\n" NOR,
    status_color(my["jingli"], my["max_jingli"]),
    my["jingli"],
    my["max_jingli"],
    my["jiajin"]
  );
  printf(
    NOR HIG "┃" NOR WHT "〖 气血 〗%s%7-d/%8-d%s[%3d%%]" NOR,
    status_color(my["qi"], my["eff_qi"]),
    my["qi"],
    my["eff_qi"],
    status_color(my["eff_qi"], my["max_qi"]),
    my["eff_qi"] * 100 / my["max_qi"]
  );
  printf(
    NOR WHT "  〖 内力 〗%s%8-d/%8-d[+%3d]" NOR HIG "   ┃\n" NOR,
    status_color(my["neili"], my["max_neili"]),
    my["neili"],
    my["max_neili"],
    my["jiali"]
  );
  if (my["food"] * 100 / ob->max_food_capacity() > 100) str = HIC + "很饱";
  else if (my["food"] * 100 / ob->max_food_capacity() > 90) str = HIG + "正常";
  else if (my["food"] * 100 / ob->max_food_capacity() > 60) str = HIY + "缺食";
  else if (my["food"] * 100 / ob->max_food_capacity() > 30) str = HIG + "缺食";
  else if (my["food"] * 100 / ob->max_food_capacity() > 10) str = HIR + "缺食";
  else str = RED + "饥饿";
  printf(NOR HIG "┃" NOR WHT "〖 食物 〗%s%7-d/%7-d [%4s%s]" NOR, status_color(
    my["food"],
    ob->max_food_capacity()
  ),
    my["food"], ob->max_food_capacity(), str, status_color(my["food"], ob->max_food_capacity()));
  printf(
    NOR WHT "  〖 潜能 〗%s%15-d " NOR HIG "          ┃\n" NOR,
    HIG,
    (int)ob->query("potential") - (int)ob->query("learned_points")
  );
  if (my["water"] * 100 / ob->max_water_capacity() > 100) str = HIC + "很饱";
  else if (my["water"] * 100 / ob->max_water_capacity() > 90) str = HIG + "正常";
  else if (my["water"] * 100 / ob->max_water_capacity() > 60) str = HIY + "缺水";
  else if (my["water"] * 100 / ob->max_water_capacity() > 30) str = HIG + "缺水";
  else if (my["water"] * 100 / ob->max_water_capacity() > 10) str = HIR + "缺水";
  else str = RED + "饥渴";
  printf(NOR HIG "┃" NOR WHT "〖 饮水 〗%s%7-d/%7-d [%4s%s]" NOR, status_color(
    my["water"],
    ob->max_water_capacity()
  ),
    my["water"], ob->max_water_capacity(), str, status_color(
      my["water"],
      ob->max_water_capacity()
    ));
  printf(NOR WHT "  〖 武学 〗%s%19-d    " NOR HIG "   ┃\n" HIG, HIY, (int)ob->query("combat_exp"));
  printf(NOR HIG "┗━━━━━━━━━━━━━━" HIR "侠" HIC "·" HIR "客" HIC "·" HIR "梦" HIG "━━━━━━━━━━━━━━━━┛\n" NOR);
  printf("\n");
  return 1;
}
string status_color(int current, int max) {
  int percent;
  if (max > 0) percent = current * 100 / max;
  else percent = 100;
  if (percent > 100) return HIC;
  if (percent >= 90) return HIG;
  if (percent >= 60) return HIY;
  if (percent >= 30) return HIG;
  if (percent >= 10) return HIR;
  return RED;
}
int help(object me) {
  write(@HELP
指令格式：
	hp
	hp <对象名称>                   (巫师专用)

这个指令可以显示你(你)或指定对象(含怪物)的精, 气, 神数值。
 
see also : score
HELP);
  return 1;
}
