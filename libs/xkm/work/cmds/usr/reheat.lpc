inherit F_CLEAN_UP;

int main() {
  object me = this_player();
  if (query_heart_beat(me)) {
    write("现在你的心跳正常!!\n");
  } else {
    me->set_heart_beat(1);
    me->set_temp("netdead", 0);
    write("恢复心跳完闭!!\n");
  }
  return 1;
}

int help(object me) {
  write(@HELP
指令格式: reheat <玩家的 ID>

这个指令是用来恢复玩家心跳。

HELP
  );
  return 1;
}
