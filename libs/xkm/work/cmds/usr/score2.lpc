// score.c
// Modified by feiyan@xjkx 07/08/2001

#include <ansi.h>
#include <combat.h>

inherit F_CLEAN_UP;

string display_attr(int gift, int value);

string remove_ansi(string str) {
  int i;
  string *color = ({ BLK, RED, GRN, YEL, BLU, MAG, CYN, WHT,
    HIR, HIG, HIY, HIB, HIM, HIC, HIW,
    HBRED, HBGRN, HBYEL, HBBLU, HBMAG, HBCYN, HBWHT,
    BBLK, BRED, BYEL, BBLU, BMAG, BCYN,
    NOR, BOLD });

  if (!str || !stringp(str)) return 0;
  i = sizeof(color);
  while (i--) {
    str = replace_string(str, color[i], "");
  }

  return str;
}

void create() { seteuid(ROOT_UID); }

int main(object me, string arg) {
  object ob, obj;
  mapping my, marriage;
  string line, killed, skill_type, temp, jiebai1, jiebai2, *jb_list, money;
  object weapon;
  int attack_points, dodge_points, parry_points, i, amount, amount1;

  seteuid(getuid(me));

  if (!arg)
    ob = me;
  else
    ob = present(arg, environment(me));
  if (wizardp(me)) {
    if (!ob) ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) return notify_fail("你要察看谁的状态？\n");

  } else if (ob != me)
    return notify_fail("只有巫师能察看别人的状态。\n");

  my = ob->query_entire_dbase();

  // line 1
  line = HIC "\n                 ☆" HIY "侠客梦个人资料" HIC "☆\n";
  line += HIG "┌─────────────┬───────────────┐\n";
  line += sprintf(
    "│" NOR "姓名：" WHT "%s%-19s" HIG " │" NOR "力量： " WHT "%8s  " NOR "  悟性： " WHT "%8s" HIG "│\n",
    ob->query("color") ? ob->query("color") : "",
    ob->name(1),
    display_attr(my["str"], ob->query_str()),
    display_attr(my["int"], ob->query_int())
  );
  line += sprintf(
    "│" NOR "英文：" WHT "%-18s  " HIG "│" NOR "根骨： " WHT "%-8s  " NOR "  身法： " WHT "%8-s" HIG "│\n",
    "【 " + capitalize(ob->query("id")) + " 】",
    display_attr(my["con"], ob->query_con()),
    display_attr(my["dex"], ob->query_dex())
  );
  line += sprintf(
    "│" NOR "头衔：" WHT "%-18s  " HIG "└───────────────┤\n",
    remove_ansi(RANK_D->query_rank(ob))
  );
  line += sprintf(
    "│" NOR "门派：" HIG "%-20s  " NOR "性别：" HIG "%-24s" HIG "│\n",
    ob->query("family") ? ob->query("family/family_name") : "无",
    ob->query("gender")
  );
  line += sprintf(
    "│" NOR "师承：" HIG "%-20s  " NOR "正邪：" HIR "%-24d" HIG "│\n",
    ob->query("family/master_name") ? ob->query("family/master_name") : "无",
    ob->query("shen")
  );
  line += sprintf(
    "│" NOR "称号：" WHT "%-20s  " NOR "江湖外号：" WHT "%-:20s" HIG "│\n",
    remove_ansi(ob->query("title") ? ob->query("title") : "无"),
    remove_ansi(ob->query("nickname") ? ob->query("nickname") : "无")
  );

  // line 2
  line += sprintf(
    "│" NOR "武功等级：" WHT "【%8s" WHT "】      " NOR "" NOR "年龄：" WHT "%-24s" HIG "│\n",
    "/cmds/std/look.lpc"->gettof(ob, 1),
    ob->query("month") ? chinese_number(ob->query("age")) + "岁" + "零" + chinese_number(ob->query("month")) + "个月" : chinese_number(ob->query("age")) + "岁"
  );

  if (ob->query("divorce")) temp = "离异";
  else temp = "未婚";
  if (mapp(ob->query("marry"))) {
    marriage = ob->query("marry");

    if (ob->query("marry/name"))
      temp = (ob->query("gender") == "女性" ? "夫    君：" : "娇    妻：") + HIG + marriage["name"] + "(" + capitalize(marriage["id"]) + ")" NOR;
    line += sprintf(
      "│" NOR "目前经验：" HIM "%-16d  " NOR "%4s：" HIG "%-24s" HIG "│\n",
      ob->query("combat_exp"),
      ob->query("gender") == "女性" ? "夫君" : "娇妻",
      marriage["name"] + "(" + capitalize(marriage["id"]) + ")"
    );
  } else
    line += sprintf(
      "│" NOR "目前经验：" HIM "%-16d  " NOR "婚姻状况：" WHT "%-20s" HIG "│\n",
      ob->query("combat_exp"),
      temp
    );
  line += sprintf(
    "│" NOR "杀人：" HIB "%-20s  " NOR "杀害玩家：" HIB "%-20s" HIG "│\n",
    ob->query("MKS") ? chinese_number(ob->query("MKS")) + "位" : "无",
    ob->query("PKS") ? chinese_number(ob->query("PKS")) + "位" : "无"
  );
  line += sprintf(
    "│" NOR "死亡：" HIR "%-20s  " NOR "有效死亡：" HIM "%-20s" HIG "│\n",
    ob->query("death_count") ? chinese_number(ob->query("death_count")) + "次" : "无",
    ob->query("death_times") ? chinese_number(ob->query("death_times")) + "次" : "无"
  );

  if (ob->query("balance") > 10) {
    amount = ob->query("balance");
    if (amount / 10000)
      amount1 = amount % 10000;
    else
      amount1 = amount;
    line += "│" NOR "个人存款：\t\t\t\t\t\t   " HIG " │\n";
    line += sprintf(
      "│" HIY "黄金：" WHT "  %-18s   白银：" WHT "  %-20s " HIG "│\n",
      (amount / 10000) ? money = ((amount / 10000) + " 两") : " ",
      (amount1 / 100) ? money = ((amount1 / 100) + " 两") : " "
    );
  } else line += sprintf("│" NOR "个人存款：%-48s" HIG "       │\n", WHT + "很少,很少..");

  if (my["diemsg"]) line += sprintf("│" NOR "上次死亡：" WHT "%-44s" HIC "│\n", (my["diemsg"]));
  if (my["kill_by"]) line += sprintf("│" NOR "仇    家：" WHT "%-44s" HIC "│\n", (my["kill_by"]));
  if (ob->query("jiebai")) {
    line += "├┄ 异姓骨肉 ┄──────────────────────┤\n";
    jiebai1 = ob->query("jiebai");
    jiebai2 = replace_string(jiebai1, "、", ">");
    jb_list = explode(jiebai2, ">");
    for (i = 0; i < sizeof(jb_list); i++) {
      if (i % 5 == 0) {
        if (i != 0) line += HIG + "│\n│   " + NOR;
        else line += HIG + "│   " + NOR;
      }
      obj = LOGIN_D->find_body(jb_list[i]);
      if (!obj || !ob->visible(obj))
        line += sprintf("%-10s ", jb_list[i]);
      else
        line += sprintf(HIY "%-10s " NOR, jb_list[i]);
    }
    switch ((sizeof(jb_list)) % 5) {
      case 0: line += "\t\t\t        "; break;
      case 1: line += "\t\t\t\t\t    "; break;
      case 2: line += "\t\t\t            "; break;
      case 3: line += "\t\t\t    "; break;
      case 4: line += "\t    "; break;
      default: break;
    }
    line += HIG + "│\n" + NOR;
    //      line = line + HIG+"├─────────────────────────────┤\n"+NOR;
  }

  if (!wizardp(me)) {
    line += HIG + "└─────────────────────────────┘\n" NOR;
    write(line);

    return 1;
  }

  attack_points = COMBAT_D->skill_power(ob, skill_type, SKILL_USAGE_ATTACK);
  parry_points = COMBAT_D->skill_power(ob, "parry", SKILL_USAGE_DEFENSE);
  dodge_points = COMBAT_D->skill_power(ob, "dodge", SKILL_USAGE_DEFENSE);

  line += HIG + "├┄ 隐藏属性 ┄──────────────────────┤\n";
  line += sprintf(
    "│" NOR "福缘：" WHT "%-8s      " NOR "  容貌：" WHT "%-8s      " NOR "  纯朴：" WHT "%-8s" HIG "      │\n",
    display_attr(my["kar"], ob->query_kar()),
    display_attr(my["per"], ob->query_per()),
    display_attr(my["pur"], my["pur"])
  );
  line += sprintf(
    "│" NOR "攻击：" WHT "%-12s" NOR "  躲闪：" WHT "%-12d" NOR "  防御：" WHT "%-12s" HIG "│\n",
    attack_points / 100 + "(+" + ob->query_temp("apply/damage") + ")",
    dodge_points / 100,
    parry_points / 100 + "(+" + ob->query_temp("apply/armor") + ")"
  );

  line += "└─────────────────────────────┘\n" NOR;
  // end
  write(line);
  return 1;
}

string display_attr(int gift, int value) {
  if (value >= gift) return sprintf(HIY "%3d" NOR "/%-3d", value, gift);
  else if (value < gift) return sprintf(CYN "%3d" NOR "/%-3d ", value, gift);
  //      else return sprintf("%-3d／%-3d",value,gift);
}



int help(object me) {
  write(@HELP
指令格式 : score
           score <对象名称>                   (巫师专用)

这个指令可以显示你(你)或指定对象(含怪物)的基本资料。
基本资料的设定请参阅 'help setup'。

see also : hp
HELP
  );
  return 1;
}
