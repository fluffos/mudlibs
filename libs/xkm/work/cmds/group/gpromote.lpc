// by tiantian(www.wangcf.com) 2001.4
// 调整对方的级别

#include <ansi.h>
#include <group.h>

string * grouplevel = ({
	"disciple", "fugle", "envoys", "minister", "vicemaster",
});
string * intlevel = ({
	"0", "1", "2", "3", "4",
});
int * explevel = ({
	EXP_GROUP_DISCIPLE, EXP_GROUP_FUGLE, EXP_GROUP_ENVOYS,
	EXP_GROUP_MINISTER, EXP_GROUP_VICE_MASTER,
});

int main(object me, string arg)
{
	object ob;
	string group_file,str;
	int newlevel;
	string id, level;

	if( !me->query("group") )
		return notify_fail("你并没有加入任何帮派。\n");

	if( me->query("group/level") < GROUP_MINISTER )
		return notify_fail("只有长老才能调整别人的级别。\n");

	if( me->is_busy() )
		return notify_fail("你现在正忙着呢。\n");

	if( !arg )
		return notify_fail("语法错误！使用help gpromote查看帮助。\n");

	if( sscanf( arg, "%s %s", id, level ) != 2 )
		return notify_fail("语法错误！使用help gpromote查看帮助。\n");

	if( !( ob = present( id, environment(me) ) ) )
		return notify_fail("你想调整谁的级别 ？\n");
	
	if( ob==me )
		return notify_fail("你不能调整自己的级别。\n");

	if( !userp(ob) )
		return notify_fail(ob->name() + "他不是玩家。\n");

	if( ob->query("group/group")!=me->query("group/group") )
		return notify_fail("他不是本帮帮众。\n");

	if( ob->query("group/level") >= me->query("group/level") )
		return notify_fail("你只能调整级别比自己低的人。\n");

	if( level == grouplevel[GROUP_VICE_MASTER] || level == intlevel[GROUP_VICE_MASTER] )
		newlevel = GROUP_VICE_MASTER;
	else if( level == grouplevel[GROUP_MINISTER] || level == intlevel[GROUP_MINISTER] )
		newlevel = GROUP_MINISTER;
	else if( level == grouplevel[GROUP_ENVOYS] || level == intlevel[GROUP_ENVOYS] )
		newlevel = GROUP_ENVOYS;
	else if( level == grouplevel[GROUP_FUGLE] || level == intlevel[GROUP_FUGLE] )
		newlevel = GROUP_FUGLE;
	else if( level == grouplevel[GROUP_DISCIPLE] || level == intlevel[GROUP_DISCIPLE] )
		newlevel = GROUP_DISCIPLE;
	else if( level == "+1" ) {
		if( ob->query("group/level") == GROUP_VICE_MASTER )
			return notify_fail( "对方的级别已经无法继续提高了。\n" );
		newlevel = ob->query("group/level") + 1;
	}
	else if( level == "-1" ) {
		if( ob->query("group/level") == GROUP_DISCIPLE )
			return notify_fail( "对方的级别已经无法继续降低了。\n" );
		newlevel = ob->query("group/level") - 1;
	}
	else
		return notify_fail( "级别无效，请使用help gpromote查询。\n" );

	if( newlevel >= me->query("group/level") )
		return notify_fail("你无权将对方的级别提到这样的高度。\n");

	if( ob->query("combat_exp") < explevel[newlevel] )
		return notify_fail("对方的江湖声望不够，无法担当如此重任。\n");

	ob->set("group/level", newlevel);
	ob->set( "group/title",HIW "" 
		+ to_chinese( ob->query( "group/group" ) ) 
		+ HIW "" HIR
		+ GROUP_D->query_rank( ob )
		+ HIR "" NOR);
	ob->set( "title", ob->query( "group/title" ) );
    ob->save();
	str = "我决定，从即日起" + ob->query("name") + "担任"
		+ to_chinese( me->query("group/group") )
		+ GROUP_D->query_rank( ob ) + "职务。";
	CHANNEL_D->do_channel(me, "chat", sprintf("%s",str));

	me->start_busy(1);

	return 1;
}

int help(object me)
{
        write(@HELP
----------------------------------------
指令格式 : gpromote <帮众> <新级别>
 
调整对方在帮派中的级别。
可以使用下列方法输入新级别：
1 输入级别名称，分别是 vicemaster(副帮主)、minister(长老)、
  envoys(使者)、fugle(香主)、disciple(弟子)。
2 输入与级别对应的数字，分别是 4(副帮主)、3(长老)、
  2(使者)、1(香主)、0(弟子)。
3 使用 +1 将对方的级别提高一级，-1 将对方的级别降低一级。

相关指令：gjoin gaccept gbanish
 
----------------------------------------
HELP
        );
        return 1;
}