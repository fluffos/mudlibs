// by tiantian(www.wangcf.com) 2001.4
// 开除某人出帮

#include <group.h>

int main(object me, string arg)
{
	object ob;
	string group_file,str;

	if( !me->query("group") )
		return notify_fail("你并没有加入任何帮派。\n");

	if( me->query("group/level") < GROUP_MINISTER )
		return notify_fail("只有长老才能开除别人。\n");

	if( !arg )
		return notify_fail("指令格式：gbanish <帮众>\n");

	if( !( ob = present( arg, environment(me) ) ) )
		return notify_fail("你想决定开除谁 ？\n");
	
	if( ob==me )
		return notify_fail("开除自己？好主意....不过没有用。\n");

	if( !userp(ob) )
		return notify_fail(ob->name() + "他不是玩家。\n");

	if( ob->query("group/group")!=me->query("group/group") )
		return notify_fail("他不是本帮帮众。\n");

	if( ob->query("group/level") >= me->query("group/level") )
		return notify_fail("你只能开除级别比自己低的人。\n");

	message_vision( "$N决定开除$n。\n\n", me, ob);
	write("你开除了一位帮众！\n");
	tell_object( ob, "恭喜您成为无帮派之人。\n" );
	ob->set( "title",ob->query("group/old_title") );
	ob->delete("group");
	ob->save();
	str="我宣布即日开除"+ob->query("name")+"。";
	CHANNEL_D->do_channel(me, "chat", sprintf("%s",str));

	group_file = GROUP_D->query_home( me );
	load_object(group_file)->add("people",-1);
	GROUP_D->save_group( me );
	return 1;
}

int help(object me)
{
        write(@HELP
----------------------------------------
指令格式 : gbanish <帮众>
 
这个指令能让你开除某人出帮。

相关指令：gjoin gaccept
 
----------------------------------------
HELP
        );
        return 1;
}