#include <login.h>
#include <ansi.h>
#include <mudlib.h>
inherit F_CLEAN_UP;

int main(object me,string arg)
{
        string wiz_status;
        object npc;
        string time;
        int argnum,mins,num;

        if( !arg) mins=5;
        
        else {  argnum = sscanf(arg, "%s %d",time, num);

                if (argnum == 2 && (int)num>0 && (int)num<10 )
                mins=num;
                else mins=5;
             }
        
        if( me != this_player(1) ) return 0;
                
        wiz_status = SECURITY_D->get_status(me);
        if( wiz_status != "(admin)" && wiz_status != "(arch)" )
                return notify_fail("只有 (arch) 以上的巫师才能重新启动" + MUD_NAME + "\n");
        log_file("nosave/CRASHES", geteuid(me) + " reboot "+CHINESE_MUD_NAME+" on: "
                + ctime(time()) + "\n");
        write_file("/log/nosave/LASTCRASH", geteuid(me) + " reboot "+CHINESE_MUD_NAME+" on: "
                + ctime(time()) + "\n", 1);
        message("system",
                HIY     "\t\t"+CHINESE_MUD_NAME+"将在" + chinese_number(mins) + "分钟后重新启动！请尽快存档(save)！\n\n" 
NOR,
                users() );
        call_out("countdown", 60, mins);

        return 1;
}

private void countdown(int min)
{
        min--;
        if( min ) {
                message("system",
                        HIY     "\t\t"+CHINESE_MUD_NAME+"将在" + chinese_number(min) + 
"分钟后重新启动！请尽快存档(save)！\n\n"NOR,
                        users() );
                call_out("countdown", 60, min);
        } else {
                message("system",
                        HIW "\t\t"+CHINESE_MUD_NAME+"重新启动。。。请稍候再登陆！\n"NOR,
                        users() );
                call_out("do_shutdown", 3);
        }
}

private void do_shutdown()
{
        shutdown(0);
}

int help (object me)
{
        write(@HELP
指令格式: reboot - num
 
重新起动游戏, 系统会开始倒数计时, num分钟後重新起动。
"-"不能省,num为大于"1"的整型数字。
 
HELP
);
        return 1;
}

