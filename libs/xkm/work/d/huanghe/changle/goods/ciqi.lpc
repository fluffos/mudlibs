// /d/changbai/ciqi.c 瓷器

inherit ITEM;
#include <ansi.h>

void create() {
  set_name(HIW "瓷器" NOR, ({ "ciqi", "qi" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "这是一件盛唐时期官窑出产的精美瓷器。\n");
    set("value", 10000000);
    set("medicine", 1);
  }
  setup();
}
