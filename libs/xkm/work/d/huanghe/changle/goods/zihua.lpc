// /d/changbai/zihua.c 字画

inherit ITEM;
#include <ansi.h>

void create() {
  set_name(HIG "字画" NOR, ({ "zihua", "hua" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "幅");
    set("long", "这是一幅李白侠客行字画。\n");
    set("value", 10000000);
    set("medicine", 1);
  }
  setup();
}
