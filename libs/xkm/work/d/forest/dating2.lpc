#include <room.h>
inherit ROOM;
#include <ansi.h>;
void do_hui();
void create() {
  set("short", HIR "大厅" NOR);
  set("long", HIG "长乐帮现在如日中天，司徒帮主为了豉励手下弟兄，拆重资新建了这个
  香主休闲练功场所。为各位香各香主可以（hui)自己的房间练练功！
" NOR);
  set("exits", ([
    "south": "/d/forest/clhuayuan",

  ]));
  set("objects", ([
    __DIR__ "npc/shiji": 1,
  ]));
  set("no_clean_up", 0);
  //        set("no_fight", 1);
  setup();
  //        replace_program(ROOM);
}

void init() {
  add_action("do_hui", "hui");
}

int do_hui() {
  object me;
  me = this_player();



  if (me->query_temp("bangs/pos") == "凤翼堂") {
    me->move(__DIR__ "fang6");
    write(HIY "你来到大厅，直接进入了自己的房间。\n" NOR);
  }

  if (me->query_temp("bangs/pos") == "龙灵堂") {
    me->move(__DIR__ "fang2");
    write(HIY "你来到大厅，直接进入了自己的房间。\n" NOR);
  }

  if (me->query_temp("bangs/pos") == "狮敏堂") {
    me->move(__DIR__ "fang3");
    write(HIY "你来到大厅，直接进入了自己的房间。\n" NOR);
  }

  if (me->query_temp("bangs/pos") == "熊威堂") {
    me->move(__DIR__ "fang4");
    write(HIY "你来到大厅，直接进入了自己的房间。\n" NOR);

  }

  if (me->query_temp("bangs/pos") == "豹捷堂") {
    me->move(__DIR__ "fang5");
    write(HIY "你来到大厅，直接进入了自己的房间。\n" NOR);

  }

  if (me->query_temp("bangs/pos") == "虎啸堂") {
    me->move(__DIR__ "fang");
    write(HIY "你来到大厅，直接进入了自己的房间。\n" NOR);

  }
  return 1;
}
