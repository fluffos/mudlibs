inherit NPC;
#include <ansi.h>
void create() {
  set_name(HIW "绵羊" NOR, ({ "sheep", "yang", "mian yang" }));
  set("race", "家畜");
  set("age", 11);
  set("long", "一只绵羊，正神情呆滞地站着发呆。\n");

  set("str", 26);
  set("cor", 30);

  set("combat_exp", 800);

  set("chat_chance", 6);
  set("chat_msg", ({
    "绵羊咩~~咩~~的叫了几声。\n"
  }));

  set_temp("apply/attack", 15);
  set_temp("apply/damage", 6);
  set_temp("apply/armor", 2);

  setup();
}

void die() {
  object ob;
  message_vision("$N倒在地上，咩~~的一声就死了！\n", this_object());
  ob = new("/d/lingshedao/obj/yangrou");
  ob->move(environment(this_object()));
  ob = new("/d/lingshedao/obj/yangpi");
  ob->move(environment(this_object()));
  destruct(this_object());
}
