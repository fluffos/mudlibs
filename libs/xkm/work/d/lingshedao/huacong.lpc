#include <ansi.h>
inherit ROOM;
void create() {
  set("short", HIG "花丛" NOR);
  set("long",
    "花丛间另有天地，蝶乱蜂喧，莺声燕语，落霞残照於。微风拂拂，令人
想躺下感受一下自然的美。花丛间有一处闪闪发亮，走进一看是一朵" + HIY "金色的
花" NOR + "及一片" + HIW "银色的叶子" NOR + "，紧紧相依。\n"
  );
  set("exits", ([
    "out": __DIR__ "garden",
  ]));
  set("outdoors", "lingshedao");
  set("cost", 1);
  setup();
  replace_program(ROOM);
}
