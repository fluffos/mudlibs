#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
        set("short", CYN"水池"NOR);
        set("long", @LONG
这里是灵蛇岛的一处小池(pool)，池中鱼儿悠闲地游着，池底有几枚
铜钱。往西边望去有一座朴素地小屋。东边却是一座小山岗。
LONG
        );
        set("exits", ([
               "west" : __DIR__"room",
               "east" : __DIR__"shangang",
        ]));
         set("item_desc",([
        "pool" : "这是一个清澈见底的小水池，可以掷(throw)铜钱来许愿。\n",
 ]));


		set("outdoors", "lingshedao");

		set("cost", 1);
		setup();
		//replace_program(ROOM);
}

void init()
{
	add_action("do_throw", "throw");
}


int do_throw(string arg)
{
	object ob;
	if(!arg)return notify_fail("你想扔什么？");
	ob = present(arg,this_player());
	if(!ob)return notify_fail("你想扔什么？");
	message_vision( MAG"\n你将一枚铜钱掷入池中，默默地在池边求愿。\n"NOR,ob);
	if(userp(ob))
	{
		ob->add(-1);
		//message_vision( HIY"\n$N被扔了出来！\n"NOR, ob);
	 }
	else destruct(1,ob);
	return 1;
}

