#include <ansi.h>
inherit ROOM;
void create() {
  set("short", HIB "山洞" NOR);
  set("long", @LONG
这是山间的一个小山洞，洞壁是光滑的天然花岗岩。山洞里异常幽暗，
几条形状特别的钟乳石从上往下垂立着。
LONG
  );
  set("exits", ([
    "out": __DIR__ "cave1",
  ]));
