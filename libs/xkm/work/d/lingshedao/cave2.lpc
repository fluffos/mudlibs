  switch (random(3)) {
    case 0:
      set("objects", ([ "/d/xingxiu/npc/scorpion": 1 ]));
      break;
    case 1:
      set("objects", ([ "/d/xingxiu/npc/spider": 1 ]));
      break;
    case 2:
      set("objects", ([ "/d/xingxiu/npc/centipede": 1 ]));
      break;
  }
  setup();
  replace_program(ROOM);
}
