#include <ansi.h>
inherit ITEM;
inherit F_FOOD;

void create() {
  set_name(CYN "清汤鱼丸" NOR, ({ "qingtang yuwan", "yuwan" }));
  set_weight(1500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一碗清汤鱼丸。汤清、味鲜、滑嫩、洁白。\n");
    set("unit", "碗");
    set("value", 200);
    set("food_remaining", 4);
    set("food_supply", 56);
  }
}
