//Cracked by Roath
inherit ITEM;

void create()
{
        set_name("稻草绳", ({"daocao sheng", "sheng", "rope" }));
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "条");
                set("long", "一条稻草绳，不长也不短。\n");
                set("material", "cloth");
                set("value", 200);
        }
}
