//Cracked by Roath
#include <ansi.h>
#include <armor.h>
inherit NECK;

string* titles = ({
        "贝壳项链",
        "贝壳项链",
        "贝壳项链",
        "贝壳项链",
        "贝壳项链",
        "贝壳项链",
        "贝壳项链",
        "贝壳项链",
        "贝壳项链",
        "贝壳项链",
});

void create()
{
        int i;
        i = random(sizeof(titles));
        if (i<2)
        set_name(HIW+titles[i]+NOR, ({ "shell necklace", "necklace"}));
        else if (i<4)
        set_name(HIM+titles[i]+NOR, ({ "shell necklace", "necklace" }));
        else if (i<6)
        set_name(HIR+titles[i]+NOR, ({ "shell necklace", "necklace" }));
        else if (i<8)
        set_name(HIB+titles[i]+NOR, ({ "shell necklace", "necklace" }));
        else
        set_name(HIY+titles[i]+NOR, ({ "shell necklace", "necklace" }));

        set("weight", 500);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一串灵蛇岛上的贝壳制成的项链，光泽非常鲜艳。\n");
                set("unit", "串");
                set("value", 4000);
                set("material", "silver");
                set("armor_prop/armor", 2);
        }
        setup();
}       
