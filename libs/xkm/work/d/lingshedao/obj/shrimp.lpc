#include <ansi.h>
inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name(HIY"金盏凤尾虾"NOR, ({"shrimp"}));
        set_weight(1000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一盘造型别致美观，质地软嫩，味咸鲜微辣的金盏凤尾虾。\n");
                set("unit", "盘");
                set("value", 300);
                set("food_remaining", 4);
                set("food_supply", 56);
        }
}
