#include <ansi.h>
inherit ITEM;
inherit F_FOOD;

void create() {
  set_name(RED "麒麟鲈鱼" NOR, ({ "qilin luyu", "luyu" }));
  set_weight(1500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "著名广州菜，此菜装盘十分讲究，几种配料切片拼配，犹如批甲麒麟。\n");
    set("unit", "盘");
    set("value", 350);
    set("food_remaining", 5);
    set("food_supply", 86);
  }
}
