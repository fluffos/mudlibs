#include <ansi.h>
inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name(RED"清蒸大闸蟹"NOR, ({"crab"}));
        set_weight(1300);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一盘清蒸大闸蟹，原形原味，色泽橙黄，蟹肉鲜美，营养丰富。\n");
                set("unit", "盘");
                set("value", 400);
                set("food_remaining", 6);
                set("food_supply", 66);
        }
}
