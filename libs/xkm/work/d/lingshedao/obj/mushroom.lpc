//Cracked by Roath
// mushroom.c 野蘑菇
#include <ansi.h>
inherit ITEM;
inherit F_FOOD;

void create() {
  set_name(BBLK + YEL "野蘑菇" NOR, ({ "mushroom", "ye mogu", "mogu" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一朵形状怪异的野蘑菇。\n");
    set("unit", "朵");
    set("value", 35);
    set("food_remaining", 3);
    set("food_supply", 35);
  }
}
