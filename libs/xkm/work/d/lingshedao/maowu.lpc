#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", YEL"茅屋"NOR);
        set("long", @LONG
这是一所简陋的茅屋，角落处只有一张床。里面黑沉沉的，并无灯火。
茅屋的墙上挂着一些工具(tools)，窗外可以看见山底下的海岸。北风刮起
时，窗外传来一阵阵海浪撞击拍打岸石之声。
LONG
        );
        set("exits", ([
                 "out" : __DIR__"shanding",
        ]));
        set("sleep_room", 1);

//	set("outdoors", "lingshedao");
        set("item_desc", ([ /* sizeof() == 1 */
"tools" : "用这些工具可以打造(make)各种首饰和用品：\n
        珊瑚耳饰(coral earring)
        珊瑚戒指(coral ring)
        贝壳项链(shell necklace) \n"
]));

	set("cost", 1);
        setup();
//	replace_program(ROOM);
}

int valid_leave(object me, string dir)
{
      object *inv;
        int i;
        inv = all_inventory(me);
           if ( dir == "out" || dir = "northwest") {
                // can not got to any where if they take players
                for (i=0; i<sizeof(inv); i++) {
                        if (userp(inv[i]))
                        return notify_fail("你不能带着其他玩家离开这里。\n");
                         }
        }
           me->set_temp("mark/茅屋", 0);
        return ::valid_leave(me, dir);
}            

void init()
{
                add_action("do_make", "make");
}

int     do_make(string arg)
{
                object me =     this_player();
                object ob1 =     new("d/lingshedao/obj/earring-coral");
                object ob2 =     new("d/lingshedao/obj/ring-coral");
                object ob3 =     new("d/lingshedao/obj/necklace-shell");
                object ob_coral, ob_shell, ob_rope;

                if ( !arg || arg ==     "")     return 0;

                if ( arg ==     "coral earring" ){
                                if(!ob_coral=present("coral",me))
                                                return  notify_fail("你没有做珊瑚耳饰的材料！\n");
                                if (this_player()->is_busy())
                                                return notify_fail("你正忙着呢！\n");
                                else {
                                                message_vision("$N拿起工具，把珊瑚做成一对漂亮的耳饰。\n", me);
                                                ob1->move(me);
                                                destruct(ob_coral);
                                                me->start_busy(2);
                                                return 1;
                                }
                }
                else if ( arg ==     "coral ring" ){
                                if(!ob_coral=present("coral",me))
                                                return  notify_fail("你没有做珊瑚戒指的材料！\n");
                                if (this_player()->is_busy())
                                                return notify_fail("你正忙着呢！\n");
                                else {
                                                message_vision("$N拿起工具，把珊瑚做成一只珊瑚戒指。\n", me);
                                                ob2->move(me);
                                                destruct(ob_coral);
                                                me->start_busy(2);
                                                return 1;
                                }
                }
                else if ( arg ==     "shell necklace" ){
                                if(!ob_shell=present("shell",me))
                                                return  notify_fail("你没有做贝壳项链的材料！\n");
                                if(!ob_rope=present("rope",me))
                                                return  notify_fail("你没有绳子怎么做项链？\n");
                                if (this_player()->is_busy())
                                                return notify_fail("你正忙着呢！\n");
                                else {
                                                message_vision("$N拿起工具，把贝壳做成一串贝壳项链。\n", me);
                                                ob3->move(me);
                                                destruct(ob_shell);
                                                destruct(ob_rope);
                                                me->start_busy(2);
                                                return 1;
                                }
                }
                return 0;
}

