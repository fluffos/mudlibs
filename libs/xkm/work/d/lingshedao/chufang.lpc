inherit ROOM;
void create() {
  set("short", "厨房");
  set("long", @LONG
这件厨房甚小，除了摆放些厨具外别无它物，墙角边有一箩筐，里面
装满了新鲜的水果和蔬菜，厨架上正烧着锅子，一阵异香由锅内传来，不
知道在烧着什么好东西。
LONG
  );
  set("exits", ([
    "west": __DIR__ "room1",

  ]));
  //	set("outdoors", "lingshedao");
  set("cost", 1);
  set("objects", ([ /* sizeof() == 2 */
    "/d/lingshedao/obj/crab": 1,
    "/d/lingshedao/obj/shrimp": 1,
  ]));
  setup();
  //		replace_program(ROOM);
}

void init() {
  add_action("do_cook", "cook");
}

int do_cook(string arg) {
  object me = this_player();
  object ob1 = new("d/lingshedao/obj/cooked-fish");
  object ob2 = new("d/lingshedao/obj/cooked-fish2");
  object ob3 = new("d/lingshedao/obj/cooked-fish3");
  object ob4 = new("d/lingshedao/obj/cooked-fish4");
  object ob_fish;

  if (ob_fish = present("si yu", me))
    return notify_fail("鱼不新鲜了！\n");
  if (!ob_fish = present("fish", me))
    return notify_fail("你好像没有烧菜的材料！\n");
  if (this_player()->is_busy())
    return notify_fail("你正忙着呢！等你有功夫时再烧菜吧。\n");

  if (!arg || arg == "") return 0;

  if (arg == "fish") {
    switch (random(4)) {
      case 0:
        message_vision("$N烧出了一碟麒麟石斑。\n", me);
        destruct(ob_fish);
        me->start_busy(2);
        ob1->move(me);
        break;
      case 1:
        message_vision("$N烧出了一盘麒麟鲈鱼。\n", me);
        destruct(ob_fish);
        me->start_busy(2);
        ob2->move(me);
        break;
      case 2:
        message_vision("$N烧出了一盘红辣椒爆炒鳝片。\n", me);
        destruct(ob_fish);
        me->start_busy(2);
        ob3->move(me);
        break;
      case 3:
        message_vision("$N烧出了一碗清汤鱼丸。\n", me);
        destruct(ob_fish);
        me->start_busy(2);
        ob4->move(me);
        break;
    }
    return 1;
  }
  return 0;
}
