// m_stick.c

#include <ansi.h>
#include <weapon.h>

//inherit M_WEAPON;
inherit S_WEAPON;

int duanlian(string arg);
int do_hui(object weapon);


string query_autoload() { return 1 + ""; }	//autoload weapon

void init()
{
        add_action("do_duanlian","duanlian");
	add_action("do_hui","hui");
}


void create()
{	
	object me;
	string w_name,w_id,w_or;
	int w_lv;
	me = this_player();
//读入数据
	w_name=me->query("myweapon/name");
	w_id = me->query("myweapon/id");
	w_or = me->query("myweapon/or");
	w_lv = me->query("myweapon/lv");
        if (!me->query("myweapon/name"))
        {
	w_name="自制的钢棒";
        }	
        if (!me->query("myweapon/id"))
        {
	w_id="stick";
        }	
        if (!me->query("myweapon/or"))
        {
	w_or="千年神木";
        }	
        if (!me->query("myweapon/lv"))
        {
	w_lv=35;
        }	
	set_name(w_name, ({w_id,"stick","bang"}));
	set("unit", "根");   
	set("value",0);
	//set("no_put",1);
	set("no_get",1);
	set("no_drop",1);
	set("no_beg",1);
	set("no_steal",1);
	set("ownmake",1);
	set_desc(w_lv,w_or,w_name);
	switch(w_or)
		{
		case "千年神木" :
			set_weight(4000);
			set("material", "iron");
			set("rigidity", 2500);
			break;
		case "海底金母" :
			set_weight(5000);
			set("material", "steel");
			set("rigidity", 3000);
			break;
		case "寒丝羽竹" :
			set_weight(1000);
			set("material", "bamboo");
			set("rigidity", 2000);
			break;
		default :
		} 
	if( me->query("myweapon/wield_msg"))
		set("wield_msg", me->query("myweapon/wield_msg")+"\n");
	else
		set("wield_msg", "$N往腰中一摸，拿出了一把"+w_name+"，端在手中。\n");
	if( me->query("myweapon/unwield_msg"))
		set("unwield_msg", me->query("myweapon/unwield_msg")+"\n");
	else
		set("unwield_msg", "$N手中"+w_name+"抖出一个棒花，眨眼间已然不见影踪。\n");
	init_stick(w_lv * 10);
	setup();
}	



int do_duanlian(string arg)
{
	object me,weapon;
	int w_zhi, w_level;
	string w_or;

	me=this_player();
	
	if( !arg||arg!="weapon"){
		return notify_fail("你要锻炼什么?\n");}
	else
	{
		weapon=this_object();
	}
	if( (int)me->query("max_neili") < 10 )
		return notify_fail("你的内力不够，无法锻炼兵器！\n");

	if( (int)me->query("qi") < 150 )
		return notify_fail("你的气不够，无法锻炼兵器！\n");

	if( (int)me->query("eff_qi") < 30 )
		return notify_fail("你现在的体力太弱，无法锻炼兵器！\n");

	if( (int)me->query("eff_jing") < 10 )
		return notify_fail("你现在的精力无法集中，不能锻炼兵器！\n");

	if( (int)me->query("potential") < 2 )
		return notify_fail("你的潜能不够，无法锻炼兵器！\n");

	if((int)me->query("myweapon/lv")>39)
		 return notify_fail("你的兵器已经到极限了，不能再升级了！\n");
	
	message_vision(HIR "$N手指棒脊，一股内力丝丝的传了进去。\n" NOR, me);

	me->add("max_neili",-2);
	me->set("neili", (int)me->query("max_neili"));
	me->add("qi",-150);
	me->add("eff_qi",-30);
	me->add("jing",-30);
	me->add("eff_jing",-30);
	me->add("potential", -2);

	w_zhi = (int)me->query("myweapon/value");
	w_zhi++;
	me->set("myweapon/value", w_zhi);
	w_or = (string)me->query("myweapon/or");
	w_level = (int)me->query("myweapon/lv");
	if( w_zhi >= ((w_level + 1) * (w_level + 1)))
	{
		w_level++;
		me->set("myweapon/lv", w_level);
		message_vision(HIY "棒身忽的一亮，似乎一种新生的力量在棒中涌动起来！\n" NOR,me);
		message_vision(HIG "$N的棒的等级提高了！\n" NOR, me);
		weapon=this_object();
		if(weapon->query("equipped") ) 
			weapon->unequip();
		reload_object( weapon );
		me->set("myweapon/value",0);
		return 1;
	}
	message_vision(RED "$N的棒的质地改善了!\n" NOR, me);
	return 1;
}


int do_hui(string arg)
{	
	string w_name;
	object me,ob;
	me=this_player();
	w_name=me->query("myweapon/name");
	if( !arg||arg!="weapon"){
		return notify_fail("你要摧毁什么?\n");}
	message_vision(HIR "$N大喝一声，一掌擎棒，一掌猛力击下。结果轰隆一声巨响"
			+w_name+HIR"断为两截!\n" NOR,me);
	
	me->delete("myweapon");
	destruct( this_object() );
	me->save();

	return 1;
}
