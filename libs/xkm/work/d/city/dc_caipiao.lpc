//                标准描述长度示例                                   |
// 出售彩票的机器放置的房间  ★dc_caipiao.c
// by naihe  2002-10-06  于茂名

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIR "彩票售卖间" NOR);
  set("long", "这里是一间不大的房间，平时冷冷清清的不闻人声，但一到了开奖时分，里
面简直挤得动弹不得。房间里放置着一部机器，看来又是西洋来的新奇玩意，你
摸摸钱袋，一副跃跃欲试的模样。
  ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
  ┃    特别公告：免费发放装彩票的盒子，请用 <ling hezi>指令领取  ┃
  ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
 " NOR);
  set("no_fight", "1");
  set("no_steal", "1");
  set("no_sleep_room", "1");
  set("invalid_startroom", 1);

  set("objects", ([
    __DIR__ "obj/yizi": 1,
    __DIR__ "obj/bingo": 1,
  ]));

  set("exits", ([
    "out": __DIR__ "cangshuge",
  ]));

  setup();
}

void init() {
  add_action("do_skills", "exercise");
  add_action("do_skills", "dazuo");
  add_action("do_skills", "respirate");
  add_action("do_skills", "tuna");
  add_action("do_skills", "practice");
  add_action("do_skills", "lian");
  add_action("do_study", "study");
  add_action("do_study", "du");
  add_action("do_food", "eat");
  add_action("do_food", "chi");
  add_action("do_food", "drink");
  add_action("do_food", "he");
  add_action("do_lingqu", "ling");
}

void reset() {
  ::reset();
  set("no_clean_up", 1);
}

int do_food(string arg) {
  tell_object(this_player(), "吃喝请到二楼茶座。\n");
  return 1;
}

int do_skills(string arg) {
  tell_object(this_player(), "小心中奖了激动得走火入魔！\n");
  return 1;
}

int do_study(string arg) {
  tell_object(this_player(), "在这里读书？！你读得进去吗……\n");
  return 1;
}

int do_lingqu(string arg) {
  object box, me = this_player();

  if (!arg || arg != "hezi" && arg != "he") return notify_fail("你要领取什么？\n");

  //if(time() - query_temp("last_times")<30)
  //	return notify_fail("每五分钟可发放一个盒子，下一轮时间内请早。\n");

  if (present("caipiao he", this_player()))
    return notify_fail("身上不是有盒子吗？怎么还会要领，每人一个彩票盒子\n");

  box = new(__DIR__ "obj/caipiao_hezi");
  box->move(me);
  message_vision(HIY "$N领了一个彩票盒。\n" NOR, me);
  //set_temp("last_times",time());

  return 1;
}
