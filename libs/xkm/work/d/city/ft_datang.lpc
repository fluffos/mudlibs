#include "room.h"

inherit ROOM;

void create() {
  set("short", "大堂");
  set("long", @LONG
这里是斧头帮的议事厅，几只灯笼高高的挂着，厅上排了五张檀木椅子，似
乎是给帮中职位较高的人物准备的。大堂侧面有一块红松木所制的方板，上面写
了不少东西。
LONG
  );
  set("exits", ([
    "out": __DIR__ "ft_room1",
    "east": __DIR__ "ftb_nv",
    "west": __DIR__ "ftb_nan",
  ]));
  set("objects", ([
    __DIR__ "npc/ftb_zhu": 1,
  ]));
  set("cost", 1);
  set("invalid_startroom", 1);
  setup();
  "/clone/board/futou_b"->foo();
  "/clone/board/jhy_b"->foo();
}

int valid_leave(object me, string dir) {
  if (me->query("gender") == "男性" && dir == "east" && !wizardp(me))
    return notify_fail("看清楚点，那是女休息室！\n");
  if (me->query("gender") == "女性" && dir == "west" && !wizardp(me))
    return notify_fail("看清楚点，那是男休息室！\n");

  return ::valid_leave(me, dir);
}
