// yuan.c
#include <ansi.h>
inherit NPC;

void greeting(object);
string ask_me();

void create() {
  set_name("业务员", ({ "yewu yuan", "yuan" }));
  set("gender", "男性");
  set("age", 22);
  set("long",
    "他好象刚才来不久，一脸经干的样子，是黄老板高薪请来为开展信用卡业务的，你可以向
他了解信用卡方面的业务问题。\n");

  set("str", 17);
  set("dex", 16);
  set("con", 15);
  set("int", 17);
  set("per", 25);
  set("shen_type", 1);
  set_temp("apply/defense", 10);
  set("combat_exp", 100);
  set("attitude", "peaceful");
  set("inquiry", ([
    "信用卡": (: ask_me :),
  ]));
  setup();

  carry_object("/d/city/npc/obj/xizhuang")->wear();
}
void init() {
  object me = this_player();
  ::init();
  if (interactive(me)) {
    remove_call_out("greeting");
    call_out("greeting", 1, me);
  }

}



void greeting(object me) {
  command("bow " + me->query("id"));
  command("say 您好！为了大家行走江湖方便，本钱庄新开了一项信用卡业务，你如果
需要，我可以帮您办理" + HBRED + HIW "(信用卡)" NOR + "。");
}

string ask_me() {
  object ob;

  int rich;
  rich = this_player()->query("balance");
  if (!rich)
    return "目前, 你在银行里没有任何存款!";

  if (rich < 100000)
    return "你的钱不够开户，等挣够了在给你办。";

  if (ob = present("credit card", this_player()))
    return "你身上不是有信用卡吗？怎么又要办理呀？";


  ob = new("/d/city/npc/obj/xinyongka");
  ob->move(this_player());
  message_vision("业服员递过一张信用卡。\n", ob);
  return "谢谢您使用信用卡，这是您的卡，请收好！";
}
