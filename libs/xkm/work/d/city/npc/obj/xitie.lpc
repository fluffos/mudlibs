//Obj: /d/ruzhou/npc/obj/xitie.c  喜贴，参加婚宴的请柬
// llm 99/07

inherit ITEM;
#include <ansi.h>
int go_lou(object me);
int go_lou2(object me);

void create()
{
        set_name(HIR"喜帖"NOR, ({ "xi tie","tie"}));
	set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else
   {
		set("unit", "张");
                set("long","一张大红的帖子，上面写着：\n"
                        "诚邀阁下参加我们的在汝州红娘庄的婚礼和汝州迎宾楼的婚宴。\n"
                         "你可以用 qu 醉仙楼 或者 qu zxl，参加宴会。\n");
      set("material", "paper");
            set("value", 0);
	}
	setup();
}

void init()
{
         add_action("do_qu", "qu");
}

int do_qu(string what)
{
     object me = this_player();
          if(what == "醉仙楼" || "参加婚礼"|| "joinmarry"){
            message_vision(HIY "\n    $N想了一下说：就去凑凑热闹，你大声叫来了轿子，送我去参加"+(string)this_object()->query("marid")+"的婚礼！\n"
            "$N 坐上了轿子，叫道走吧！\n"NOR ,me);    
            me->move("/d/ruzhou/jiao1");
	    call_out("go_lou",5,me);
	    return 1;
                    }
}
int go_lou(object me)
{
	
	message_vision(HIY"\n 轿夫抬着你。\n"NOR,me);
     	call_out("go_lou2",5,me);
         return 1;
}

int go_lou2(object me)
{
	
	message_vision(HIY"\n    只听轿夫们一声“到啦！”轿子整个儿一震，想是落到了地上，你\n"
	"从轿子中下来一看，来到了醉仙楼大堂，两位新人正在等着亲朋好友。\n"
	"你对一对新人说：“恭喜两位新人！恭喜恭喜！\n"NOR,me);
     	me->move("/d/city/datang");
     	destruct(this_object());
        return 1;
}
