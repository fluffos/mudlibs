//write by bright
// ftb girl sleep_room

inherit ROOM;

void create() {
  set("short", "女休息室");

  set("long", @LONG
这ㄦ是斧头帮专门为女子建的休息室,地方虽小,但却十分整洁,里面
有一张桌子和几张床，床上的被子折的整整齐齐,并不时散发着阵阵
女人的香气。
LONG);

  set("exits", ([
    "west": __DIR__ "ft_datang",
    "south": __DIR__ "nv_lg",
  ]));
  set("cost", 0);
  set("sleep_room", 1);
  set("no_fight", 1);
  setup();
}

int valid_leave(object me, string dir) {
  object *inv;
  int i;


  inv = all_inventory(me);

  if (dir == "west" || dir == "south") {
    for (i = 0; i < sizeof(inv); i++) {
      if (inv[i]->is_character())
        return notify_fail("你不能带着其他玩家离开休息室。\n");
    }
  }

  return ::valid_leave(me, dir);
}
