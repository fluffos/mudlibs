// daihu.c

inherit NPC;
inherit F_DEALER;
string ask_job();
string ask_abandon();
void thank_dest(object obj,object ob);
void reward_dest(object obj,object ob);
void create()
{
        set_name("戴大夫", ({ "dai daifu", "dai" }));
        set("str", 60);
        set("gender", "男性");
        set("age", 18);
        set("long", "他是凌霄城的名医,在城中救人无数,深得尊敬。\n");
        set("combat_exp", 1000);
        set("attitude", "friendly");
        set("vendor_goods", ({
                "/clone/drug/jinchuang",
                "/clone/drug/yangjing",
               // "/clone/drug/wuchangdan",
               // "/clone/drug/zhujingchan",
               // "/clone/drug/hedinghong",
               // "/clone/drug/bicanfeng",
               // "/clone/drug/kongquedan",
        }));
         set("inquiry", ([
                 "job" : (: ask_job :),
                 "放弃" : (: ask_abandon :),
                ]));
        setup();
        carry_object("/clone/misc/cloth")->wear();
}

void init()
{
        add_action("do_list", "list");
        add_action("do_buy", "buy");
}


string ask_job()
{
          mapping job_stat;
          object ob2;
          object ob = this_player();
          object me = this_object();
          object yaochu;
          int good_skill;

          job_stat = ob->query_temp("lx/caiyao");

          if ( ob->query("family/family_name") != "凌霄城" )
                return "这位"+RANK_D->query_respect(ob)+"非我凌霄城弟子，岂敢劳烦。\n";

          if( ob->is_busy() ){
                command("hmm "+ob->query("id"));
                return "你还在忙着干别的事呢！\n";
          }


        if(job_stat || ob->query_temp("lx/bdgranted") ){
                command("hmm "+ob->query("id"));
                return "你还没完成任务，就又想要新的？\n";
          }
          

       if ( me->query_temp("job_pos") == 0 ) {
                                if(random(3)==1)
                                  me->set_temp("job_pos",1);
                          return "现在没什么要紧的事去作，你去休息吧。\n";
          }
 
          me->add_temp("job_pos", -1);

          command("nod");
          command("say 好，最近做药用的草药都用完了，你去山下山路挖一些回来。");
          yaochu = present("yao chu",ob );
          if(yaochu)destruct(yaochu);
          ob2 = new("/d/lingxiao/obj/yaochu");
          ob2->move(ob);
          ob->set_temp("lx/caiyao",1);
          command("give yao chu to "+this_player()->query("id"));
          return "早去早回，路上要小心一些！\n";
}

int accept_object(object me, object obj)
{
          object ob = this_player();

          command( "say "+obj->name()+"?");

          if (
                obj->query("id") == "chuanbei" ||
                obj->query("id") == "fuling" ||
                obj->query("id") == "gouzhi zi" ||
                obj->query("id") == "heshouwu" ||
                obj->query("id") == "huanglian" ||
                obj->query("id") == "jugeng" ||
                obj->query("id") == "jinyin hua" ||
                obj->query("id") == "shengdi"
           ) {

                if ( (ob->query("family/family_name") == "凌霄城") && (ob->query("id")==obj->query("player"))) {
                        call_out("reward_dest", 1, obj, ob);
                }
                else {
                        call_out("thank_dest", 1, obj, ob);
                }

                return 1;
           }

           if ( obj->query("id") == "ouyang feng" )
           {
                if ( ob->query("family/family_name") == "凌霄城" ) {
                        call_out("reward_feng", 1, obj, ob);
                }
                else {
                        call_out("thank_feng", 1, obj, ob);
                }
                return 1;
           }

           command( "hmm" );
           command( "say 你给我这东西做什麽？" );
           return 0;
}
void thank_dest(object obj,object ob)
{
        command( "jump");
        command( "say 我们很需要这些药材，多谢啦！\n");
        destruct(obj);
}

string ask_abandon()
{
        object ob = this_player(), me = this_object();
        int penalty;

        if( !ob->query_temp("lx/caiyao") ) return "你又没有任务，放弃什么？\n";
        
        command( "kick "+ob->query("id"));
        ob->delete_temp("lx");
        command("say 没用的家伙，这点小事也干不好，凌霄城指望你们是没法兴旺了。");
        return "好吧!下次用心点。\n";

}

void reward_dest(object obj,object ob)
{
        object yaochu = present("yao chu",this_player() );
        if(yaochu)destruct(yaochu);
        command( "pat "+ob->query("id"));
        command( "say "+ob->query("name")+"干的不错，下去休息一下吧！\n");
        if(ob->query_temp("lx/caiyao",1) )
        {
                ob->delete_temp("lx");
                add_temp("job_pos", 1);
        }
        destruct(obj);

}
