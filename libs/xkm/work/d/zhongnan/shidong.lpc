// road: /zhongnan/shidong.c
inherit ROOM;

void create()
{
        set("short","石洞");

        set("long",@LONG
一个不大的一个石洞，摆着一张石桌两把椅子，西边放着张
床石洞不大，但收拾的非常的干净，墙上挂着把宝剑，石桌上的
蜡烛似乎是新换的，那微弱的黄光照亮四周，石洞南边的出口被
外面的一个石棺挡着，似乎很少有人知道这里。
LONG);

         set("exits",([ "out" : __DIR__"shishi",
        ]));
          set("cost",2);
          set("outdoors", "zhongnan");
         
         set("objects", ([
                "/kungfu/class/gumu/lin" : 1,
        ]));
                  setup();
}
