inherit ROOM;

void create()
{
        set("short", "花廊");
        set("long", @LONG
一道曲折的花廊直通向前方的敞厅，头上一串串的藤花低垂下来，
藤花间点缀着几串晶莹的葡萄。廊子两侧种植着墨竹，随风的竹影在
脚下闪动。庭院中静静的，传来里面悠扬的古琴声。
LONG
        );
        set("exits", ([ 
                "enter" : __DIR__"jushi",
                "south" : __DIR__"zhumen",
                      ]));

        set("no_clean_up", 0);
        set("outdoors", "beijing");
        set("no_clean_up", 0);

        setup();
        replace_program(ROOM);
}
