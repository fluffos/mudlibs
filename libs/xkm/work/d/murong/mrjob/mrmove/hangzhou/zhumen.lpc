inherit ROOM;

void create() {
  set("short", "紫竹门");
  set("long", @LONG
一道半掩的紫竹门上爬满了葱郁的绿藤，门外一丛丛的紫竹随风
摇曳。几缕阳光透过竹间缝隙洒落在潺缠流动的小溪上，映射出道道
金色的光芒。竹门外青石板路通向幽静的小院中。
LONG
  );
  set("exits", ([
    "north": __DIR__ "xiaoyuan.lpc",
    "out": "/d/hangzhou/tianzhu2",
  ]));

  set("outdoors", "hangzhou");
  set("no_clean_up", 0);

  setup();
  replace_program(ROOM);
}
