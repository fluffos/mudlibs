#include <ansi.h>;
#include <net/daemons.h>
#include <command.h>;
inherit ITEM;
#define MAP_G ({__DIR__"maps/"})

void create()
{
	seteuid(getuid());
        set_name(HIC"地图册"NOR, ({"mr dituce", "map", "dituce"}));
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "张");
                set("no_sell", 1);
                set("no_steal", 1);
                set("mrjob", 1);
                set("no_drop", 1);
                set("long", "一张羊皮绘制而成的残缺地图，可供查看(chakan)。\n");
                set("value", 0);
                set_weight(100);
        }
        setup();
}
void init()
{
        add_action("do_maps", ({"chaxun", "chakan"}));
}

int do_maps(string arg)
{
	object me;
	me = this_player();
	cat(__DIR__"maps/maplist");
	input_to("search_map",me);

	return 1;
}

int search_map(string arg,object me)
{
	string *maps;
	int i;
        if(!arg||arg=="")
        {
        	write("选择地图英文代码:");
        	input_to("search_map",me);
        	return 1;
        }
        maps= MAP_G;
	sscanf(arg, "%s", arg);
	if( pointerp(maps) ) {
		i = sizeof(maps);
		while(i--) if( file_size(maps[i] + arg)>0 ) {
                cat(maps[i] + arg);
		return 1;
		}
	}

	write("地图册上没有这页的信息。\n");
	return 1;
}

string query_autoload(){ return 1 + ""; }
