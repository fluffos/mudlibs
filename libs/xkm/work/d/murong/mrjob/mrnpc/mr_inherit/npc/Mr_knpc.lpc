File:   Mr_knpc.c
Create: Play 刺杀专用
Time:   4/25/2002
************************/
inherit NPC;
#include <ansi.h>;

void create() {
  seteuid(getuid());
  set_name("追杀对象", ({ "zhuisha duixiang", "duixiang" }));
  set("gender", "男性");
  set("age", 30);
  //        set("long", "一位身穿布衣，足踏草履的世外高人。\n");
  set("per", 20 + random(10));
  set("str", 20 + random(20));
  set("dex", 20 + random(20));
  set("con", 20 + random(20));
  set("int", 20 + random(20));
  set("max_neili", 500);
  set("max_qi", 300);
  set("max_jingli", 300);
  set("neili", 500);
  set("eff_qi", 300);
  set("qi", 300);
  set("jingli", 300);
  set("jiali", 30);
  set_skill("unarmed", 50);
  set_skill("force", 50);
  set_skill("dodge", 50);
  set_skill("parry", 50);
  set("env/wimpy", 30 + random(40));
  set("chat_chance", 10 + random(10));
  set("chat_msg", ({
    "", "",
    (: random_move :),
  }));
  set("attitude", "friendly");

  setup();
  carry_object("/clone/armor/tiejia")->wear();
  carry_object("/clone/armor/yaodai")->wear();
  carry_object(__FILE__->get_weapon());
}
void init() {
  ::init();
  add_action("do_killing", "kill");
  remove_call_out("del_ob");
  call_out("del_ob", 300, this_object());
}
int del_ob(object ob) {
  object me;
  me = ob->query("Mr_revive");
  remove_call_out("del_ob");
  if (!me) destruct(ob);
  if (environment(me) != environment(ob))
    set("chat_chance", 10 + random(10));
  if (me->query_temp("Mrjob_time") < time())
    destruct(ob);
  else
    call_out("del_ob", 30, ob);
  return 1;
}
int do_killing(string arg) {
  object *inv, victim;
  int i;
  if (!arg || arg == "") return 0;
  if (objectp(victim = present(arg, environment(this_object()))) && living(victim)) {
    if (victim == this_object()) {
      inv = all_inventory(this_object());
      for (i = 0; i < sizeof(inv); i++) {
        if (!living(this_object())) continue;
        if (!inv[i]->query("skill_type")) continue;
        if (!inv[i]->query("weapon_prop/damage")) continue;
        command("wield " + inv[i]->query("id"));
      }
    }
  }
  return 0;
}
int die() {
  object me;
  me = this_object()->query_temp("last_damage_from");

  if (query("Mr_revive") && query("Mr_revive") == me) {
    me->set_temp("Mrjob_over", 1);
    me->add_temp("Mrjob_hortation", query("hortation"));

    message_vision(CYN "$N冷笑着对$n说道：这就是和慕容作对的下场。\n" NOR,
      me, this_object());
  }
  ::die();
  return 1;
}

string get_weapon() {
  string *weapons, weapon;
  weapons = ({
    "gangjian", "qinggang-jian", "gangdao", "duanjian", "cahngjian",
    "changbian", "fuchen", "gangzhang", "gangbang", "tiezhang",
    "tiexiao", "mudao", "bian", "banfu", "qiang",
    "wuandao", "wushidao", "hammer", "jiedao", "gangzhua",
  });

  weapon = "/clone/weapon/" + weapons[random(sizeof(weapons))];
  return weapon;
}
