inherit NPC;
#include <ansi.h>;

string *answer_msg = ({
"你打听的这位%s有所耳闻，不过好象是在%s地区生活吧。",
"你问的这位%s不是生活在本地吧？我记得是隐居在%s府喔。",
"你是问%s吗？他好象是在%s隐居吧。",
"这位%s我记忆中是在%s嘛，你怎么跑到%s这里来打听啊。",
"你跑错地方啦，%s在%s府，这里是%s啊。",
});
string *No_msg = ({
"我没时间陪你玩，找别人吧。",
"别烦我，我没时间。",
"呵呵，你还是到处转转吧。",
"这个，，，那个，，，今天天气不错，哈哈哈。。。",
"什么？我的耳朵不大好，听不清啊！"
});
string *snoop_msg = ({
"你是问%s吗？我刚才在%s遇到他。",
"你是问隐士%s啊，我昨晚还在%s与他闲聊了几句。",
"我想想。。。你问的%s在哪里见过！。。。对了，他是在%s附近出现过。",
"你可是问对人了，我和%s可是好朋友，他正在%s呢。",
"你问的%s经常会在%s附近散步，你可以去看看。",
"%s就在%s附近呢，快去找吧。",
"你和%s是朋友啊？他可是个有名的隐士喔，我记得他生活在%s附近。",
});
void setup()
{
        ::setup();
	add("inquiry", ([
		"name"     : "我是一介草民，名子有何重要的，不提也罢。",
		"here"     : "风土人情各地不同，要您细心去揣摩喽。",
		"liaojie"  : "了解本地的名人可以直接输入liaojie 或 diaocha就可以啦。",
		"调查"     : "了解本地的名人可以直接输入liaojie 或 diaocha就可以啦。",
		"diaocha"  : "了解本地的名人可以直接输入liaojie 或 diaocha就可以啦。",
		"了解"     : "了解本地的名人可以直接输入liaojie 或 diaocha就可以啦。",
		"tanfang"  : "你输入tanfang 或 tanting就可以知道你要找的人位置啦。",
		"探听"     : "你输入tanfang 或 tanting就可以知道你要找的人位置啦。",
		"tanting"  : "你输入tanfang 或 tanting就可以知道你要找的人位置啦。",
		"探访"     : "你输入tanfang 或 tanting就可以知道你要找的人位置啦。",		"探听"     : "你输入tanfang 或 tanting就可以知道你要找的人位置啦。",
	]));
        set("chat_chance", 2+random(5));
	set("chat_msg", ({
                "","","",
		(: command, "say 方圆几百里的名人隐士没有我不知道的。" :),
                "","","",
		(: command, "say 此地的名人趣事我了如指掌，不明白就问(tanfang)我好了。" :),
                "","","",
		(: command, "say 江湖中卧虎藏龙，名山大川经常有隐士出没。" :),
		"","","",
		(: command, "say 大隐隐于市，这道理不知有谁能够理解。" :),
		"","","",
		(: command, "say 对本地名人的了解(liaojie)就算我最知情啦。" :),
	}) );

}

void init()
{
       ::init();
       add_action("do_Mrsnoop", ({"tanting","tanfang"}));
       add_action("do_liaojie", ({"diaocha","liaojie"}));
}
int do_liaojie(string arg)
{
	object me,ob;
	mapping level;
	string msg,str,*type,com;
	mapping job;
	int i,j=1;
	me=this_player();
	
	if(!arg||arg =="") return notify_fail("格式: tanting [name]\n");
	level = me->query_temp("Mr_canvass");
	if(!level||!mapp(job=me->query_temp("Mrjob"))) {
		msg = No_msg[random(sizeof(No_msg))];
		command("say "+msg);
		return 1;
	}
	if(arg!=me->query_temp("Mrjob_name/name")&&
	   arg!=me->query_temp("Mrjob_name/id"))
	{
		command("say 你问我"+arg+"？这个我可不太熟悉。");
		return 1;
	}
        if(!query("Mr_money/"+me->query("id")))
        {
		command("say 怎么？要白打听啊！");
		return 1;        	
        }
                delete("Mr_money/"+me->query("id"));

        msg = "─────────────────────────────────\n";
        type = keys(level);
        for(i=0;i<sizeof(type);i++)
        {
        	if(type[i]=="js") continue;
        	if(type[i]=="fj") str = "反 间 计";
        	if(type[i]=="bw") str = "宝物诱惑";
        	if(type[i]=="jq") str = "金钱诱惑";
        	if(type[i]=="dw") str = "地位诱惑";
        	if(type[i]=="wl") str = "夸赞武力";
        	if(type[i]=="ml") str = "夸赞魅力";
        	if(type[i]=="cx") str = "夸赞才学";
        	if(type[i]=="kh") str = "恶言恐吓";
        	if(type[i]=="zf") str = "武力征服";
        	if(type[i]=="bf") str = "抱 负 说";
        	if(type[i]=="mr") str = "美 人 计";
                if(random(5)>1) com="不详";
        	else
        	switch(level[type[i]]){
        		case 1: com = "反感";break;
        		case 2: com = "平常";break;
        		case 3: com = "喜好";break;
                        default: com = "不详";break;
        	}
        msg += sprintf("计策名："+str+"  ("+com+")\n",);
        }
        msg +="─────────────────────────────────\n";

        write(msg);        

        return 1;
}
int accept_object(object who, object ob)
{
        int value;

        if (!ob->query("money_id")) return 0;
        if ( ob->value() < 19999) return 0;
        set("Mr_money/"+who->query("id"),1);
        return 1;
}
int do_Mrsnoop(string arg)
{
	object me, ob, room, *obj;
	string msg, k, r;
	mapping job,level;
	int j,i;
	me = this_player();

	if(!arg||arg =="") return notify_fail("格式: tanting [name]\n");

	job = me->query_temp("Mrjob");
	
        message_vision(CYN"$N向$n问道：这位"+RANK_D->query_respect(this_object())+
                       "可知"+arg+"现在哪里？\n"NOR, me,this_object());
        //判断玩家是否具有征召任务或是否已经启动征召程序
	if(!job || job["content"]!="canvass"||me->query_temp("Mr_over"))
	{
		msg = No_msg[random(sizeof(No_msg))];
		command("say "+msg);
		return 1;
	}
	//判断是否符合本身的征召条件
	if(arg==me->query_temp("Mrjob_name/name")||
	   arg==me->query_temp("Mrjob_name/id"))
	{
		//如果所在地区不附合征召地区
		if(me->query_temp("Mrjob_city/name")!=query("area"))
		{
			msg = answer_msg[random(sizeof(answer_msg))];
         		msg = sprintf(msg,me->query_temp("Mrjob_name/name"),me->query_temp("Mrjob_city/name"),query("area"));
			command("say "+msg);
			return 1;
		}
		//查是否已有相应的人物在系统中
		if(me->query_temp("Mr_snoop"))
		{
			j++;
		obj = children(me->query_temp("Mr_snoop"));
	        for(i=0;i<sizeof(obj);i++)
	        {
	        	if(obj[i]->name()!=me->query_temp("Mrjob_name/name")) continue;
	        	if(obj[i]->query("id")!=me->query_temp("Mrjob_name/id")) continue;
	        	k=environment(obj[i])->query("short");
	        	r=base_name(environment(obj[i]));
	        }
	        if(k)
	        {
	        	msg = snoop_msg[random(sizeof(snoop_msg))];
	        	write(sprintf(msg+"\n",me->query_temp("Mrjob_name/name"),k));
	        	if(wizardp(me)){
	        	write(HIW"Wizard Snoop Npc: "HIR);
	        	write(r);
        		write("\n"NOR);
        		}
	        	return 1;
	        }
	        if(j>1)
	        {
	        	command("say "+me->query_temp("Mrjob_name/name")+"已经远离本地，你再也找不到他了。");
	        	return 1;	        
	        }	                
	        }
		//调取征召人物所在路径
                room=__FILE__->get_room(me->query_temp("Mrjob_city/file"));
		ob=new(__DIR__"npc/Mr_snpc.lpc");
		ob->set_name(me->query_temp("Mrjob_name/name"),({ me->query_temp("Mrjob_name/id"), me->query_temp("Mrjob_name/xing") }) );
                ob->set("Mr_canvass", me); //设为可征召人物
                ob->set("title", HIG+query("area")+"逍遥隐士"+NOR); //设title
                //设定被征召人物的具备属性
                level=__FILE__->call_level();
                ob->set("level",level);
                me->set_temp("Mr_canvass",level);
                if(!ob->move(room))
                {
                	if(query("move_room"))
                	objectp(room=query("move_room"));
                	else
                	room = environment(me);
                	ob->move(room);
                }
                //设定已经开始征召程序
                me->set_temp("Mr_snoop",base_name(ob));
		msg = snoop_msg[random(sizeof(snoop_msg))];
       		msg = sprintf(msg,ob->name(),room->query("short"));
       		//巫师可探听征召人物初始路径
                if(wizardp(me)){
                write(HIG"Wizard Snoop Npc: "HIC);
       		write(room);
       		write("\n"NOR);}
		command("say "+msg);
		return 1;
	}
	command("say "+arg+"？我可从来没听说过，你去问问其他人吧。");
	return 1;
}
//发布征召人物的路径
string get_room(string path)
{
	string dir;
	mixed *file;
	int i, j;
	string room;
	dir = resolve_path("/d/"+path+"/");
	file = get_dir(dir, -1);
	j = sizeof(file);
       	room = "/d/"+path+"/"+file[random(j)][0];
        for(i=0;i<4;i++)
        {
        	if(strsrch(room,".lpc")>-1) continue;
        	room ="/d/"+path+"/"+file[random(j)][0];
        }
	return room;
}
/*
"1.反间计(fj)    2.宝物诱惑(bw)    3.金钱诱惑(jq)    4.地位诱惑(dw)\n"
"5.抱负说(bf)    6.夸赞武力(wl)    7.夸赞魅力(ml)    8.夸赞才学(cx)\n"
"9.美人计(mr)   10.恶言恐吓(kh)   11.武力征服(zf)   12.放弃征召(fq)\n"
*/
mapping call_level()
{
	mapping level;
	level = ([
	       "fj":1+random(3),
	       "bw":1+random(3),
	       "jq":1+random(3),
	       "dw":1+random(3),
	       "bf":1+random(3),
	       "wl":1+random(3),
	       "ml":1+random(3),
	       "cx":1+random(3),
	       "mr":1+random(3),
	       "kh":1+random(3),
	       "zf":1+random(3),
               "js":-1,
	]);
	return level;
}