inherit NPC;
#include <ansi.h>;
int ask_Mrsnoop();
string *can_msg = ({
"你是问%s在哪里？告诉你吧：我不知道。",
"我听说%s经常在%s府出现喔。",
"你问的%s好象是在%s吧。",
"这位%s我记忆中是在%s嘛，你怎么跑到%s这里来打听啊。",
"据说%s是在%s府，可这里是%s啊。",
});
string *No_msg = ({
"我不知道你在说些什么。",
"你再来烦我小心我扁你喔。",
"去去去，哪凉快哪爬着去。",
"嗯，钱可是好东西啊，哈哈哈。。。",
"你在讲什么啊！没看到我正闲着，嘿嘿。。。",
"你怎么和唐僧似的，你不知道你很令人烦吗？"
});
string *ask_msg = ({
"啊，您是问%s呀！我方才还在%s遇到他。",
"您问的%s我记得是在%s附近出现过。",
"这个%s我在%s附近见过他，不知是否还在那里。",
"你可是问对人了%s正在%s附近。",
"%s一般不会知道他在哪里的，不过我听说他生活在%s附近。",
"您问的%s可是很厉害的，听说在%s附近有人看到过他。",
"你问%s干什么？他可是轻易不能惹的，不过据说他在%s附近出现过。",
});
void setup()
{
        ::setup();
	add("inquiry", ([
		"name"     : "我是一介草民，名子有何重要的，不提也罢。",
		"here"     : "风土人情各地不同，要您细心去揣摩喽。",
		"探询"     : (: ask_Mrsnoop :),
		"探听"     : (: ask_Mrsnoop :),
		"探访"     : (: ask_Mrsnoop :),
		"寻访"     : (: ask_Mrsnoop :),
		"寻找"     : (: ask_Mrsnoop :),
		"打探"     : (: ask_Mrsnoop :),
		"qingbao"    : (: ask_Mrsnoop :),
		"情报"  : (: ask_Mrsnoop :),
	]));
        set("chat_chance", 2+random(5));
	set("chat_msg", ({
                "","","",
		(: command, "say 这年头日子可真不好过啊。" :),
                "","","",
		(: command, "say 有谁知道我是这里的万事通呢？也不见人问(ask)我要情报(qingbao)。" :),
                "","","",
		(: command, "say 现在的人啊，真是唯利是图，没一个好东西。" :),
		"","","",
		(: command, "say 听说卖情报(qingbao)也能挣大笔的钱喔！" :),
	}) );

}
int ask_Mrsnoop()
{
	object me;
	mapping job;
	string msg;
	me = this_player();

	job = me->query_temp("Mrjob");
	
        //判断玩家是否具有刺杀任务或是否已经启动此程序
	if(!job || job["content"]!="revive"|| me->query_temp("Mrjob_over"))
	{
		msg = No_msg[random(sizeof(No_msg))];
		command("say "+msg);
		return 1;
	}
        if(!query("Mr_money/"+me->query("id")))
        {
		command("say 这么直接，不懂规矩吗！?");
		return 1;        	
        }
                delete("Mr_money/"+me->query("id"));
	command("say 告诉我你要知道谁的行踪啊？");
	write("输入待查人物名:");
	input_to("ask_start",me,job);
	return 1;
}
int ask_start(string arg,object me,mapping job)
{
	object ob, room;
	string msg, k, r;
	int level,i,j,p=1;
	object *obj;


	if(arg==me->query_temp("Mrjob_name/name")||arg==me->query_temp("Mrjob_name/id"))
	{
		//如果所在地区不附合刺杀人物地区
		if(me->query_temp("Mrjob_city/name")!=query("area"))
		{
			msg = can_msg[random(sizeof(can_msg))];
         		msg = sprintf(msg,me->query_temp("Mrjob_name/name"),me->query_temp("Mrjob_city/name"),query("area"));
			command("say "+msg);
			return 1;
		}
		//查是否已有相应的人物在系统中
		if(me->query_temp("Mr_ask"))
		{
			p++;
		obj = children(me->query_temp("Mr_ask"));
	        for(j=0;j<sizeof(obj);j++)
	        {
	        	if(obj[j]->name()!=me->query_temp("Mrjob_name/name")) continue;
	        	if(obj[j]->query("id")!=me->query_temp("Mrjob_name/id")) continue;
	        	k=environment(obj[j])->query("short");
	        	r=base_name(environment(obj[j]));
	        }
	        if(k)
	        {
	        	msg = ask_msg[random(sizeof(ask_msg))];
	        	write(sprintf(msg+"\n",me->query_temp("Mrjob_name/name"),k));
	        	if(wizardp(me)){
	        	write(HIW"Wizard Snoop Npc: "HIR);
	        	write(r);
        		write("\n"NOR);
        		}
	        	return 1;
	        }
	        if(p>1)
	        {
	        	command("say 你问"+me->query_temp("Mrjob_name/name")+"？我已经许久没听到关于他的消息了。");
	        	return 1;	        
	        }	                
	        }

                room=__FILE__->get_room(me->query_temp("Mrjob_city/file"));
                level = me->query_skill("parry");
                level<50?level=50:level;
                i=random(30-me->query_kar());
                i<3?i=3:i>8?i=8:i;
		ob=new(__DIR__"npc/Mr_knpc.lpc");
                //设定人物属性及攻、防
		ob->set_name(me->query_temp("Mrjob_name/name"),({ me->query_temp("Mrjob_name/id"), me->query_temp("Mrjob_name/xing") }) );
                ob->set("combat_exp", me->query("combat_exp")*i/3);
                ob->add_temp("apply/attack", level);
                ob->add_temp("apply/defense", level);
                ob->add_temp("apply/armor", level/3);
                ob->add("max_qi", level*i);
                ob->set("eff_qi", ob->query("max_qi"));
                ob->set("qi", ob->query("max_qi"));
                ob->add("max_jingli", level*i);
                ob->add("jingli", level*i);
                ob->add("max_neili", level*i*2);
                ob->add("neili", level*i*2);
                ob->add("jiali", i*30);
                ob->set("hortation",i);
                ob->set("title", HIC+query("area")+"隐居高人"+NOR); //设title
                //设为任务刺杀人物
                ob->set("Mr_revive", me);
                //初始刺杀人物的房间
                if(!ob->move(room))
                {
                	if(query("move_room"))
                	objectp(room=query("move_room"));
                	else
                	room = environment(me);
                	ob->move(room);
                }
                //设定已经调用刺杀对象的路径
                me->set_temp("Mr_ask",base_name(ob));
		msg = ask_msg[random(sizeof(ask_msg))];
       		msg = sprintf(msg,ob->name(),room->query("short"));
       		//巫师可探听征召人物初始路径
                if(wizardp(me)){
                write(HIW"Wizard Snoop Npc: "HIR);
       		write(room);
       		write("\n"NOR);
       		}
		command("say "+msg);
		return 1;
	}
	command("say 你问"+arg+"吗？从来没听说过啊。");
	return 1;
}
//发布被刺杀人物的路径
string get_room(string path)
{
	string dir;
	mixed *file;
	int i, j;
	string room;
	dir = resolve_path("/d/"+path+"/");
	file = get_dir(dir, -1);
	j = sizeof(file);
       	room = "/d/"+path+"/"+file[random(j)][0];
        for(i=0;i<4;i++)
        {
        	if(strsrch(room,".lpc")>-1) continue;
        	room ="/d/"+path+"/"+file[random(j)][0];
        }
	return room;
}
int accept_object(object who, object ob)
{
        int value;

        if (!ob->query("money_id")) return 0;
        if ( ob->value() < 4999) return 0;
        set("Mr_money/"+who->query("id"),1);
        return 1;
}