int do_back(object me);
string ask_dayan();
string ask_xingfu();

void create() {
  string name, weapon;
  int i;
  i = random(sizeof(nm1));
  name = nm1[i] + nm2[random(sizeof(nm2))] + nm3[random(sizeof(nm3))]; set_name(
    name,
    ({ "gaoren" })
  );
  set("gender", "男性");

  set("age", random(20) + 25);
  set("str", 23);
  set("con", 26);
  set("int", 20);
  set("dex", 23);
  set("long", "一个穿着黑色夜行衣的人。\n");
  set("combat_exp", 80000 + random(40000));
  set("attitude", "friendly");
  set_skill("force", 50);
  set_skill("sword", 50);
  set_skill("dodge", 50);
  set_skill("parry", 50);
  set_skill("finger", 50);
  set_skill("blade", 50);
  set_skill("canhe-zhi", 50);
  set("max_qi", 2450);
  set("eff_jingli", 400);
  set("neili", 1700);
  set("max_neili", 1700);
  set("inquiry", ([
    "大燕": (: ask_dayan :),
    "兴复": (: ask_xingfu :),
  ]));
  set("chat_msg", ({
    (: random_move :)
  }));

  setup();

}

int do_back(object me) {
  tell_room(environment(me), me->query("name") + "匆匆忙忙的离开了。\n", ({ me }));
  destruct(me);
  return 1;
}
void die() {
  object corpse;
  mixed killer;
  if (!living(this_object())) revive(1);
  else delete_temp("faint_by");
  COMBAT_D->announce(this_object(), "dead");
  if (!(killer = query_temp("last_damage_from")))
    killer = "莫名其妙地";
  if (objectp(corpse = CHAR_D->make_corpse(this_object(), killer)))
    corpse->move(environment());
  set_temp("last_damage_from", "莫名其妙地");
  corpse->set_temp("must_killby", this_object()->query_temp("must_killby"));
  this_object()->remove_all_killer();
  all_inventory(environment())->remove_killer(this_object());
  destruct(this_object());
}

string ask_dayan() {
  object me;
  me = this_player();
  if ((int)me->query_temp("xingfu") < 5) {
    me->set_temp("xfjob", 1);
    return "大燕国曾雄霸一时，可后来却!唉!\n";
  }
  if ((int)me->query_temp("xingfu") < 8) {
    me->set_temp("xfjob", 2);
    return "大燕国曾雄霸一时，可后来却!唉!\n";
  }
  if ((int)me->query_temp("xingfu") < 10) {
    me->set_temp("xfjob", 3);
    return "大燕国曾雄霸一时，可后来却!唉!\n";
  }
}
string ask_xingfu() {
  object me = this_player();
  mapping fam;


  if (!(fam = this_player()->query("family")) || fam["family_name"] != "姑苏慕容")
    return RANK_D->query_respect(this_player()) + "与我素无来往，不知此话从何谈起？";
  if (me->query_temp("xfover")) return "阁下先走，在下随后就到!\n";
  if (me->is_busy()) {
    message_vision("你正在苦苦劝说，企图使他助你兴复大燕!\n", me);
    return "这位小兄弟何必如此着急！\n";
  }

  if ((int)me->query_temp("xfjob") == 1) {
    object room;
    me->delete_temp("xfjob");
    me->set_temp("xfover", 1);
    me->start_busy(30);
    command("say 好吧！既然盛情难却，在下就走一趟吧!\n");

    destruct(this_object());
  }
  if ((int)me->query_temp("xfjob") == 2) {
    me->delete_temp("xfjob");
    me->set_temp("xfjob", 1);
    me->start_busy(30);
    return "事隔多年，要兴复大燕恐非易事!\n";
  }
  if ((int)me->query_temp("xfjob") == 3) {
    me->delete_temp("xfjob");
    me->set_temp("xfjob", 2);
    me->start_busy(30);
    return "大燕国要想复兴？这等儿戏休再提起!";
  }
}
