// kxxj 26/08/2002 
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "云中小路");
  set("long", @LONG
这是华山的崖上的小路。四周云雾飞绕，下面渊深无底。如不小心，
一失足掉下去，只怕连骨头都找不到。你还是小心点好！
奇怪？小猴子哪里去了？你是不是应该多叫几声找找它（say 小猴子）？
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "down": __DIR__ "hscave",
  ]));

  set("cost", 3);
  setup();
}

void init() {
  add_action("do_say", "say");
  add_action("do_boteng", "boteng");
}

void do_say(string arg) {
  string name;
  object me = this_player();

  if (!arg || arg == "") return 0;

  if (arg == "小猴子" && !me->query_temp("mark/猴子") && random(30) == 5) {
    message_vision("突然$N背后传来一阵“吱吱”的叫声。\n", me);
    message_vision("$N急忙回过头来，只见树枝上倒吊着一个小猴子。\n", me);
    me->set_temp("mark/猴子", 1);
    if (this_player()->query("shen") >= 10000) {
      /*
                  message("vision","小猴子对"+me->name()+"指了指崖壁上的藤荆。然后抓着树枝荡着秋千离开了。\n看样子它想让你拨开藤荆（boteng）。\n", 
                        environment(me), ({me}));       
*/
      message_vision("小猴子对" + me->name() + "指了指崖壁上的藤荆。然后抓着树枝荡着秋千离开了。\n看样子它想让你拨开藤荆（boteng）。\n", me);
      write(" " HIG "你抬眼望去，只见崖壁上密布着一层厚厚的长藤。中间一条细缝，显然有人进去过。" NOR "\n");
    }
    if (arg == "小猴子" && me->query_temp("mark/猴子")) {
      write(HIG "小猴子荡了过来指了指崖壁！\n" NOR);
    } else {
      //          if (me->query("shen") < 10000)
      message_vision("小猴子对$N不停做鬼脸，气的$N向小猴子追去。\n", me);
    }

    /*
        if( arg == "小猴子" && me->query_temp("mark/猴子") ) {
       write( HIG"小猴子荡了过来指了指崖壁！\n"NOR);
        }  
*/
  }
}


void do_boteng(string arg) {
  object me = this_player();
  if (me->query_temp("mark/猴子")) {
    message_vision("$N运力双臂，将岩洞上覆盖的长藤向两边拨开。\n", me);
    set("exits/enter", __DIR__ "yunzhongcave");
    remove_call_out("close");
    call_out("close", 5, this_object());
    //        return 1;
  }
  return 0;
}

void close(object room) {
  message("vision", "长藤垂了下来，又把洞口遮住了。\n", room);
  room->delete("exits/enter");
}

int valid_leave(object me, string dir) {

  if (dir == "down" && !me->query_temp("mark/猴子") && !present("jinshe beixin", me))
    return notify_fail("宝物尚未到手，你怎么舍得离开?\n");
  return ::valid_leave(me, dir);
}
