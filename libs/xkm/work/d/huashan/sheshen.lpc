//Cracked by Roath
// sheshen.c

inherit ROOM;
#include <ansi.h>

void create()
{
	set("short", "舍身崖");
	set("long", @LONG
这是一段极窄极险的山崖，四周云雾飞绕，下面渊深无底。如不小心
，一失足掉下去，只怕连骨头都找不到。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
	  "eastdown" : __DIR__"canglong",
	]));
	
	set("objects",([
              "/d/huashan/npc/monkey" : 1,
	]));

	set("no_clean_up", 0);
	set("outdoors", "xx" );

	set("cost", 4);
	setup();
//	replace_program(ROOM);
}

void init()
{
	object me = this_player();
        add_action("do_pa", "pa");

   	if ( interactive(me) && me->query("huashan/job_pending") ) {
		me->set_temp("hz_job/sheshen", 1);
   	}
}
int do_pa(string arg)
{
        object me;

        me=this_player();
        if (me->is_busy() || me->is_fighting())
                return notify_fail("你正忙着哪！\n");
        if ( !arg || arg != "down" )
                return notify_fail("你要往哪爬？\n");
        if (!me->query_temp("zhiliao"))
                return notify_fail("仔细擦擦眼吧，那来的路啊！?\n");
        message_vision(HIG"$N顺着藤条小心的爬了下去。\n"NOR, me);
        me->move("/d/huashan/yunzhonglu");
        tell_room(environment(me), me->name() + "从上面爬了下来。\n", ({ me }));
        me->delete_temp("zhiliao");
        return 1;
}
