//Cracked by Roath
// shihou.c 出尘子
#include <ansi.h>
inherit NPC;
#include <ansi.h>
inherit F_MASTER;

string ask_me();

void create()
{
        set_name(HIW"白发老人"NOR, ({ "baifa laoren", "laoren" }));
        set("long", 
                "一位精神矍铄的老者，双目有神，似乎武功不凡。\n"
                "当你和他目光接触，不由得心里一凛。\n");
        set("gender", "男性");
        set("age", 82);
        set("attitude", "peaceful");
         set("shen_type", 1);
        set("str", 30);
         set("int", 30);
        set("con", 28);
        set("dex", 28);
        
        set("max_qi", 5000);
        set("max_jing", 4000);
        set("neili", 5000);
        set("max_neili", 5000);
        set("jiali", 50);
        set("combat_exp", 1000000);
        set("jingli", 5000);

        set_skill("force", 250);
        set_skill("zixia-gong", 250);
        set_skill("dodge", 250);
        set_skill("lingshe-shenfa", 250);
        set_skill("strike", 250);
        set_skill("youshen-zhang", 250);
        set_skill("parry", 250);
        set_skill("sword", 250);
        set_skill("jinshe-jianfa", 250);
        set_skill("jinshe-zhuifa", 250);
        set_skill("literate", 200);

        map_skill("force", "zixia-gong");
        map_skill("dodge", "lingshe-shenfa");
        map_skill("parry", "jinshe-jianfa");
        map_skill("sword", "jinshe-jianfa");
        map_skill("strike", "youshen-zhang");

        prepare_skill("strike", "youshen-zhang");

        setup();

        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/clone/armor/cloth")->wear();
}

void init()
{
        object ob;
        
        ::init();
        if (interactive(ob=this_player()))
        {
                if (!ob->query_temp("mark/猴子") && ob->query("shen") < 300000)
                {
           message_vision(
            HIY "$N对$n，正色道：我祖孙三代世代保护恩人的遗物，阁下作事不够光明磊落，请你不要带走！\n"NOR, this_object(), ob);
       command("say "+"去吧！");
          message_vision(HIR"老人猛出一掌，打在$N的的丹田要穴上，$N一口气提不上来。\n"NOR, ob); 
              this_player()->unconcious();
              this_player()->move("d/huashan/sheshen");
      
                 }
        }
}

void do_killing(object ob)
{
        if (!ob || environment(ob) != environment())
                return;
        this_object()->kill_ob(ob);
}

void attempt_apprentice(object ob)
{
        command("say 山乡野人，能教你什么？！");
}

