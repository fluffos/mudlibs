//Obj: /d/ruzhou/npc/obj/xitie.c  喜贴，参加婚宴的请柬
// llm 99/07

inherit ITEM;
#include <ansi.h>

void create()
{
        set_name(HIR"喜帖"NOR, ({ "xi tie","tie"}));
	set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else
   {
		set("unit", "张");
                set("long","一张大红的帖子，上面写着：\n"
                        "诚邀阁下参加我们的在汝州红娘庄的婚礼和汝州迎宾楼的婚宴。\n"
                        "你可以用 qu 红娘庄或者 qu hnz，参加宴会。\n");
      set("material", "paper");
            set("value", 0);
	}
	setup();
}
void init()
{
         add_action("do_qu", "qu");
}
int do_qu(string what)
{
//     int me = this_player();
          if(what == "红娘庄" || "hnz"){
             this_player()->move("/d/ruzhou/hongniang-zhuang");
//           this_object()->move(environment(this_player()));
//          this_object()->move("u/program/wc");
   destruct(this_object());

           return 1;
                    }
}

