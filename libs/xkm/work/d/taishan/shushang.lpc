inherit ROOM;

void create()
{
        set("short", "树上");
        set("long", @LONG
古树上,你可以清楚的看到那些果子(guo),伸手便可摘到。你可以 
爬回去(climb down) 。    
LONG );
        set("outdoors", "city");
        set("no_clean_up", 0);
        set("item_desc",([
            "guo" : "一些奇异的果子,你可以摘(zhai)。\n",
        ]));

        setup();
}       
void init()
{
        add_action("do_climb", "climb");
        add_action("do_zhai", "zhai");
}
int do_zhai(string arg)
{       object guo, me = this_player();

        if ( (!arg ) || (arg != "guo") )
                return notify_fail("你要摘什么？\n");
        if ( arg == "wuming guo" || arg == "guo" ) {
                if ( me->query_temp("zhai/wmg") ) 
                return notify_fail("你刚摘过,又想摘？这麽贪心!\n");
         else
                message_vision("$N摘下一颗果子。\n", me);
                guo = new("/u/bright/obj/wuming-guo.lpc");
                guo->move(me);
                CHANNEL_D->do_channel(me, "rumor", sprintf("%s弄到了一枚无名果。", me->query("name")));

                me->set_temp("zhai/wmg",1);
        }
        return 1;
}
int do_climb(string arg)
{       object me = this_player();

        if ( (!arg ) || (arg != "down") )
                return notify_fail("那方向没法爬!\n");

        else
            me->move("/d/taishan/xiaolu");

        return 1;
}
