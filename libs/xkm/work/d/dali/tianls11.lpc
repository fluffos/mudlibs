//Cracked by Kafei
inherit ROOM;

void create()
{
        set("short", "牟尼堂");
        set("long", @LONG
这是一间狭室，禅房内古璞归真，日常用具不多，不过有见识的人可以看出，
东西虽不见奢侈，却也都不是易得之物。禅房里面四散着坐了六个老僧。
LONG );

        set("cost", 1);
       set("objects", ([
"/kungfu/class/dali/benchen" : 1,
"/kungfu/class/dali/benguan" : 1,
"/kungfu/class/dali/benxiang" : 1,
"/kungfu/class/dali/bencan" : 1,
"/kungfu/class/dali/kurong" : 1,
              ]));
        set("exits", ([
		"out" : __DIR__"tianls10.lpc",
		]));
    setup();
}
void init()
{
        add_action("do_exercise", "lian");
        add_action("do_exercise", "practice");
}

int do_exercise(string arg)
{
	object me = this_player();

	tell_object(me, "这里不能修炼武功！\n");
	return 1;
}

int valid_leave(object me, string dir)
{
		object jiumozhi;
		if ( jiumozhi=present("jiumozhi", environment(me)) ) 
			return notify_fail("你现在不能离开！\n");

        if ( me->query_temp("6msj"))        
			return notify_fail("你现在不能离开！\n");

        return ::valid_leave(me, dir);
}










