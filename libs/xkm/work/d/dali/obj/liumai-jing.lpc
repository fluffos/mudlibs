// 六脉神剑
// by poke 08/98
// xuanyuan 11/6/2001

inherit ITEM;
inherit F_UNIQUE;
#include <ansi.h>

void create()
{
		  set_name(HIB"六脉神剑剑经"NOR, ({ "liumai jianpu", "book","jianpu" }));
		  set_weight(600);
		  if( clonep() )
					 set_default_object(__FILE__);
		  else {
					 set("unit", "本");
					 set("long", "这是一本残破的卷轴，帛面年深日久，已成焦黄之色。\n");
					 set("value", 1000000);
					 set("no_get",1);
					 set("no_drop",1);
					 set("material", "paper");
		  }
		  ::create();
}

void init()
{
	add_action("do_lingwu", "lingwu");
}

int do_lingwu(string arg)
{
	mapping fam, skills;
	object me = this_player();
	object ob = this_object();
	string skillname;
	int skill_special, skill_basic;

	skills = me->query_skills();

	if( !arg ) 
		return notify_fail("大敌人将至，你还是赶快抓紧研习六脉神剑经吧！\n");

	if( !me->query_skill("literate", 1) ){
                write("你是个文盲，先学点文化(literate)吧。\n");
		return 1;
	}
	if (me->is_busy())
		return notify_fail("你现在正忙着呢。\n");

	if ( me->is_fighting() )
		return notify_fail("你无法在战斗中专心下来研读新知！\n");

	if (!me->query_temp("can_read_6msj_book"))
		return notify_fail("你没有得到允许，不能擅自研习六脉神剑经。\n");

	skill_basic = me->query_skill("finger", 1);
	skill_special = me->query_skill("yiyang-zhi", 1);

	if ( me->query("jing") < 500 ) 
		return notify_fail("你现在精神不佳，无法定下心来思考！\n");

	me->receive_damage("jing", random(skill_basic), "研习六脉神剑经真气失控而死。");

	skill_special = skill_special * me->query("max_jing") * 2 / (1000 + me->query("max_jing"));

	if(random(20) == 0) {
		me->improve_skill("liumai-shenjian", skill_basic + random(skill_special*2));
		write( "你突觉察一股真气自行从丹田中涌出，冲至肩臂，顺着红线直至无名指的关冲穴。\n" );
	}
	else if(random(10) == 0) {
		me->improve_skill("liumai-shenjian", skill_basic/2 + random(skill_special/1));
		write( "你体内的真气顺着心意，也迂回曲折的沿臂而上，升至肘弯，更升至上臂！\n" );
	}
	else if(random(5) == 0) {
		me->improve_skill("liumai-shenjian", skill_basic/4 + random(skill_special/2));
		write( "你右手小臂不住抖动，似有什么东西要突破皮肤而迸发出来。\n" );
	}
	else if(random(2) == 0) {
		me->improve_skill("liumai-shenjian", skill_basic/8 + random(skill_special/4));
		write( "你对照图谱缓缓存想，一股真气果然便循着经脉路线运行！\n" );
	}
	else if(random(5) == 0) {
		write( "你身上有无数气流奔突窜跃，难过之彬。\n" );
	}
	else if(random(10) == 0) {
		me->improve_skill("liumai-shenjian", - (skill_basic/10 + random(skill_special/5)));
		write( "你只觉得体内真气乱窜，双目神光散乱，六脉神剑中的招式象走马灯一般在面前显现！\n" );
	}
	else if(random(20) == 0) {
		me->improve_skill("liumai-shenjian", - (skill_basic/6 + random(skill_special/3)));
		write( "你只觉体内真气鼓荡，已显颠狂之态，对六脉神剑是越想越糊涂。\n" );
	}
	else {
		write( "你专注剑气图，伸出手指在空中虚点虚划。\n" );
	}
	return 1;
}


