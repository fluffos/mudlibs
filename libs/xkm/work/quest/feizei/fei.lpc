#include <ansi.h>
inherit NPC;
void copy_weapon(object me, object ob);

void create()
{
	set_name("飞贼",({ "fei zei","fei","zei" }) );
	set("title",HIY"飞天遁地"NOR);
        set("gender", "男性" );
        set("age", 33);
        set("long", 
"这是无恶不做的飞贼，背上有一个小小包裹，看样子是才偷了什么东西在手。\n");

        set("int", 30);
        set("str", 20);
        set("con", 25);
        set("dex", 20);
      set("attitude", "friendly");
        set("shen_type", -1);


        set("chat_chance", 60);
        set("chat_msg", ({
//                (: random_move :),
        }) );

        setup();
        carry_object( __DIR__ "changjian")->wield();
        carry_object( __DIR__ "lingzhi");
        add_money("gold",1);

}
void init()
{
        add_action("do_fight", "fight");
        add_action("do_throw", "throw");
}

int accept_kill(object ob)
{
        object me = this_object();
	mapping hp_status, skill_status, map_status, prepare_status;
	string *sname, *mname, *pname;
	int i, temp;
    remove_call_out("renewing");    
    call_out("renewing", 300 + random(300), me);    
        set_leader(ob);
/* delete and copy skills */

	if ( mapp(skill_status = me->query_skills()) ) {
		skill_status = me->query_skills();
		sname  = keys(skill_status);

		temp = sizeof(skill_status);
		for(i=0; i<temp; i++) {
			me->delete_skill(sname[i]);
		}
	}

	if ( mapp(skill_status = ob->query_skills()) ) {
		skill_status = ob->query_skills();
		sname  = keys(skill_status);

		for(i=0; i<sizeof(skill_status); i++) {
			me->set_skill(sname[i], skill_status[sname[i]]);
		}
        }
/* delete and copy skill maps */
	if ( mapp(map_status = me->query_skill_map()) ) {
		mname  = keys(map_status);

		temp = sizeof(map_status);
		for(i=0; i<temp; i++) {
			me->map_skill(mname[i]);
                }
        }
	if ( mapp(map_status = ob->query_skill_map()) ) {
		mname  = keys(map_status);

		for(i=0; i<sizeof(map_status); i++) {
			me->map_skill(mname[i], map_status[mname[i]]);
                }
        }

/* delete and copy skill prepares */
	if ( mapp(prepare_status = me->query_skill_prepare()) ) {
		pname  = keys(prepare_status);

		temp = sizeof(prepare_status);
		for(i=0; i<temp; i++) {
			me->prepare_skill(pname[i]);
                }
        }
	if ( mapp(prepare_status = ob->query_skill_prepare()) ) {
		pname  = keys(prepare_status);

		for(i=0; i<sizeof(prepare_status); i++) {
			me->prepare_skill(pname[i], prepare_status[pname[i]]);
		}
        }
	hp_status = ob->query_entire_dbase();

		me->set("str", hp_status["str"]);
                me->set("max_qi",    hp_status["max_qi"]);
                me->set("eff_qi",    hp_status["max_qi"]);
                me->set("qi",        hp_status["max_qi"]*2/3);
		me->set("max_jing",  hp_status["max_jing"]);
		me->set("eff_jing",  hp_status["max_jing"]);
		me->set("jing",      hp_status["max_jing"]);
		me->set("max_neili", hp_status["max_neili"]);
                me->set("neili",     hp_status["max_neili"]);
                me->set("jiali",     hp_status["jiali"]);
		me->set("combat_exp",hp_status["combat_exp"]);

   copy_weapon(me,ob);//复制装备
   me->setup();
   me->save();
   return 1;

}

void copy_weapon(object me, object ob)
{
   object *inv;
   int i,j, weapon_cnt, armor_cnt;
   inv = all_inventory(me);
   for(i=0; i<sizeof(inv); i++) 
   {
     destruct(inv[i]);
   }
   // save once here, an external bug might stop the following
   me->setup();
   me->save();
   weapon_cnt = 0;
   armor_cnt = 0;
   inv = all_inventory(ob);
   for(i=0; i<sizeof(inv); i++)
   {
     if ( !inv[i]->query_unique() && 
     inv[i]->query("skill_type") &&
     inv[i]->query("equipped") && !weapon_cnt ) 
     {
        object obj = new(base_name(inv[i]));
        if (obj)
        {
          if(obj->move(me)) 
          obj->wield();
        }
        me->set("weapon", base_name(inv[i]));
        weapon_cnt = 1;
     }
     else if ( !inv[i]->query_unique() && 
     !inv[i]->query("skill_type") && 
     inv[i]->query("equipped") && !armor_cnt ) 
     {
        object obj = new(base_name(inv[i]));
        if (obj)
        {
          if(obj->move(me))
          obj->wear();
        }
        me->set("armor", base_name(inv[i]));
        armor_cnt = 1;
     }
     else if( weapon_cnt && armor_cnt )
        break;
    }
}
int do_fight (string arg)
{
  object who = this_player();
      tell_object(who,"对这种人不用客气！\n");
   return 1;
}
int do_throw (string arg)
{
  object who = this_player();
      tell_object(who,"想不到你是这种人！\n");
   return 1;
}

void unconcious()
{
object me,lingzhi,corpse;
me=this_player();
corpse = new("/clone/misc/corpse");
corpse->set("name",HIY"飞贼的死尸"NOR);
   corpse->set("long","这是无恶不做的飞贼，背上有一个小小包裹，看样子是才偷了什么东西在手。\n然而，他已经死了，只剩下一具尸体静静地躺在这里。\n");
   corpse->move(environment(this_object()));
    "/quest/feizei/lingzhi"->move(environment(this_object()));
   "/clone/money/gold"->move(environment(this_object()));
       message_vision(HIR"\n$N匆忙丢下一个包袱，嘴里吐出几句话。\n"BLU"紧接着使出土遁，猛地钻进土里，让你大吃一惊。\n$N消失在你的眼前。。。\n"NOR, this_object());
/*
       CHANNEL_D->do_channel(this_object(), "chat",
               "想不到我偷盗多年，弄到个"HIY"飞天遁地"HIC"的称号，却没想到今天遭到这小子的暗算。\n        哎......\n        哼，咱走着瞧。。。\n");
       CHANNEL_D->do_channel(this_object(), "rumor",
               "某人得到"HIR"千年灵芝"NOR+HIM"啦！\n");
*/
  destruct(me);
}

void die(object me)
{
"/quest/feizei/lingzhi"->move(environment(this_object()));
"/clone/money/gold"->move(environment(this_object()));
::die();
}
void renewing(object me)
{
   me->delete("last_leader");
}
