//xkxmud_msgd.c    ☆侠客☆(Xkxmud)的信息管理器，以便不在线时想念他的人也可以听到他的声音！
//☆侠客☆(Xkxmud)
//      /adm/daemons/xkxmud_msgd.c
//Time:001_2002.08.25
//Time:002_2002.09.05

#include <ansi.h>
inherit ITEM;
inherit F_SAVE;
#define XKXMUD_MSGFILE "/data/msg/xkxmud_msgd.o"
#define XKXMUD_MSGD "/adm/daemons/xkxmud_msgd"

int do_addmsg(string arg);
int do_listmsg(string arg);
int do_delmsg(string arg);

void create()
{
       string *msg;
       seteuid(getuid());
       set_name(HIG"☆侠客☆信息管理器"NOR,({"msgd","msg"}));
       set("channel_id","☆侠客☆(Xkxmud)");
       if (file_size(XKXMUD_MSGFILE)<=0){
               setup();
               msg=({});
               add("msg",msg);
               save();
       }
       setup();
       restore();
       if (clonep())   return;
       CHANNEL_D->do_channel( this_object(), "sys", "☆侠客☆信息系统已经启动。\n");        
       call_out("on_time",10);
}
void init()
{
       object me=this_player(1);
       if((getuid(this_player())=="xkxmud")||(getuid(this_player())=="jhy"))
       {
               add_action("do_addmsg","addmsg");
               add_action("do_listmsg","listmsg");
               add_action("do_delmsg","delmsg");
       }
}
int valid_string(string arg)
{
       return 1;
}
int valid_use()
{
       object me=this_player(1);
       if((getuid(this_player())!="xkxmud")&&(getuid(this_player())!="jhy"))   return 0;
       return 1;
}
string query_save_file()
{
       return XKXMUD_MSGFILE;
}
void on_time()
{
       int i,j;
       string *msg=query("msg");
       i=sizeof(msg);
       if(i<=0){
               call_out("on_time",1800);
               return;
       }
       j=random(i);
       CHANNEL_D->do_channel(this_object(),"chat",msg[j]);
       call_out("on_time",900);
}
int do_addmsg(string arg)
{
       object me=this_player(1),ob;
       string *msg;
       if(!arg||!valid_string(arg))    return notify_fail(HIW"非法的信息\n"NOR);
       msg=query("msg");
       msg=msg+({arg});
       set("msg",msg);
       save();
       ob=find_object(XKXMUD_MSGD);
       if(ob)  ob->restore();
       tell_object(me,HIG"信息增加完毕\n"NOR);
       return 1;
}
int do_listmsg(string arg)
{
       object me=this_player(1);
       string *msg;
       int i;
       msg=query("msg");
       for(i=0;i<sizeof(msg);i++)              printf("%4d    :    %s\n",i+1,msg[i]);
       if(sizeof(msg)<=0)      return notify_fail(HIR"目前还没有信息！\n"NOR);
       return 1;
}
int do_delmsg(string arg)
{
       object me=this_player(1),ob;
       string *msg;
       int i,j,k;
       string *msg2=query("msg");
       if (!arg||sscanf(arg, "%d", i)!=1)      return notify_fail(HIR"你要删除哪一条信息？\n"NOR);
       k=sizeof(msg2);
       if(k<=0){
               return notify_fail(HIR"已经没有信息可删除了！\n"NOR);
       }
       else if(k<i){
               return notify_fail(HIR"没有这条信息！\n"NOR);
       }
       msg=query("msg");
       msg=msg-({msg[i-1]});
       set("msg",msg);
       save();
       ob=find_object(XKXMUD_MSGD);
       if (ob){
               ob->restore();
       }
       tell_object(me,HIC"新闻删除完毕\n"NOR);
       return 1;
}
