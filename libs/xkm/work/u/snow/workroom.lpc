void init()
{
   object me;
   me = this_player();
   if ((string)me->query("id")=="snow" )
      return ;
//   if(!wizardp(this_player()))
//      return ;
         if ((int) me->query("notwelcome")){
//if ((string)me->query("id")!="snow" ){
message_vision(HIW"$N失踪了。\n"NOR, this_player());
   me->move("/u/snow/jy");}
"/u/snow/flower"->move(me);
message_vision(BLINK+HIY"$N进入飘雪㊣(snow)的个人空间，受到了热烈的欢迎！！！\n"NOR,me);
   if(me->is_ghost()){         
   this_player()->reincarnate();//如果你是鬼魂，那么用这个就可以换阳了
      message_vision(HIW"$N又再次回到了人间，再度为人。\n"NOR, this_player());
          }
   else
   {
   me->delete("env/invisibility");
      message_vision(BBLU+HIR"$N到了"HIW"第九空间"HIR"自动取消隐身功能！\n"NOR,me);
   }
   tell_room( environment(me), MAG"精灵(Spirit)"HIY"前来报告："BBLU+MAG"Snow，" + me->query("title") + " "
     + me->query("name") + "(" + me->query("id") + ")" + MAG"已经进入了"HIG"风"HIW"雪"HIY"小"HIR"楼。\n"NOR);
   if( getuid(me)!="snow")
      message("vision", me->name()+"走了过来。\n", environment(me), ({me}));
  add_action("discmds",({"hit","kill","fight","steal","ansuan","touxi","set","snoop","cat","more","edit"}));
//   remove_call_out("blow");
//    call_out("blow",4 + random(3) );
}
int blow()
{
   object *inv = all_inventory(find_object("u/snow/workroom"));
   object ob, me= this_player();
   int i;

     if( !this_player() || !environment(this_player()) )  return 1;
     if( base_name(environment(this_player())) != "/u/snow/workroom") return 1;

     message_vision( HIW"\n你觉得一阵冷气逼来，大风将近！\n"NOR, this_player() );
     remove_call_out("blow");
     call_out( "blow",4 + random(3) );
      return 1;
}

private int blow_result(object victim)
{
   object ob2;
    if( random(60)==1 )
 {
            message_vision(HIR"突然天空中飘出几朵红花飘向$N！\n"NOR, ob2,victim);
 }
 else
 {
        message_vision( RED"\n$N被狂风吹着，摇摇欲坠！\n"NOR, victim );
        victim->receive_wound("qi", random(30), "被摔死了！");
        victim->receive_damage("qi", random(50), "被冻死了！");
 }
  return 1;
}
