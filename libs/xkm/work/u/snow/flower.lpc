#include "ansi.h"
inherit ITEM;

void create()
{
        set_name(HIR"鲜花"NOR, ({ "flower", "hua" }));
        set_weight(0);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "朵");
                set("long",
HIG"这是一朵美丽的小野花，香气清新。
它是"HIW"飘雪㊣"NOR+HIG"特意为大家制作的，你可以尝试闻(smell)它。
"HIW"飘雪㊣"NOR+HIG"一心想把自己的"BLINK+HIR"心愿"NOR+HIG"送给：
"HIY"   ※※※※※※※※※※※※※"NOR"
"HIY"   ※"NOR"自己"BLINK+HIR"心爱"NOR"的人，        "HIY"※
"HIY"   ※"NOR"自己"BLINK+HIY"尊敬"NOR"的人，        "HIY"※
"HIY"   ※"NOR"自己"BLINK+HIM"想恋"NOR"的人，        "HIY"※
"HIY"   ※"NOR"以及所有喜欢Mud的朋友 "HIY"※
"HIY"   ※"NOR+BLINK+HIC"随时欢迎您的到来。"NOR"    "HIY"※
"HIY"   ※※※※※※※※※※※※※
"NOR);
                set("value", 0);
                set("no_sell", 1);
        }
}
void init()
{
        add_action("do_smell","smell");
}

int do_smell(string arg)
{
        object me = this_player();
        object flower = present("flower", me);

        if ( !arg|| arg != "flower" ) 
           return notify_fail("你要闻什么？\n");
        message_vision("$N拿起"HIR"鲜花"NOR"，放在鼻端深深地一闻。\n"HIG"$N顿觉一阵春风吹过，好似"HIR"「"HIG"春"HIY"风"HIM"快"HIC"意"HIR"」"NOR"。\n"NOR, me);
        return 1;
}
