//write by bright
#include <ansi.h>
int ask_heal()
{
     object me = this_player();
          
     if (!(me->query_temp("ftbjob_done"))){
     command("say 你不出力,还想要好处,别做梦了!");
     return 1;
     } 
     if ((int)me->query("eff_qi") >= (int)me->query("max_qi")){
     command("say 别开玩笑了,你并没有受伤啊!");
     return 1;
     }
     if ((int)me->query("eff_qi") < (int)me->query("max_qi")) {
     command("ok");   
     me->set("eff_qi", (int)me->query("max_qi"));
     me->set("qi", (int)me->query("max_qi"));
     me->delete_temp("ftbjob_done");
        tell_object(me,HIY "你的伤已经痊愈了。\n" NOR, me);
      return 1;

      }
}
