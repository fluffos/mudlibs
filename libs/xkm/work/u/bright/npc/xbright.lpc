inherit NPC;
int ask_heal();
void create()
{
        set_name("小明亮", ({ "xbright", "xiao" }));
        set("gender", "男性");
        set("age", 19);
        set("long", "他是一个好人啊。\n");
        
        set("combat_exp", 1000);
        set("shen_type", -1);

        set("attitude", "heroism");
        
        set_skill("unarmed", 20);
        set_skill("dodge", 20);
        set_temp("apply/attack", 10);
        set_temp("apply/defense", 10);
        set("inquiry", ([
                         "heal" : (: ask_heal :),
        ]));

        setup();
        carry_object("/clone/misc/cloth")->wear();
}
void die()
{
    mixed killer;
    int kill_num;
    object ob;
    object me=this_player(); 
    me->set_temp("ftbjob_done",1);
    killer = query_temp("last_damage_from");
    if( objectp(killer = query_temp("last_damage_from")) ) 
           {
                     ob = new("/u/bright/obj/xuanyuan_zhang");
                     ob->move(environment());
                     message_vision("只听见啪的一声，从"+query("name")+"身上掉下来一件物事。\n", this_player());
         }
    if (stringp(killer)) killer = (object)find_player((string)killer);
    if (objectp(killer)) {
        if (killer->query("id") == query("player_name")) {
            kill_num = killer->query("ftb_search/kill_num");
            killer->set("ftb_search/kill_num", kill_num+1);
                    }
    }
    ::die();
}
#include "/u/bright/npc/checkheal.lpc"
