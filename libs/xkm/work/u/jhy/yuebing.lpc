// yuebing 月饼
#include <ansi.h>

inherit ITEM;

void create() {
  set_name("中秋节的月饼", ({ "yue bing", "bing" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是中秋节给大家的礼物.。\n");
    set("unit", "只");
    set("no_get", 1);
    set("no_give", 1);

  }
}
void init() {
  add_action("do_eat", "eat");
}
int do_eat() {
  object me;
  me = this_player();
  if (!me->query("marks/yuebing")) {
    message_vision(HIG "$N有滋有味品尝着。\n", me);
    me->add("combat_exp", 35000 + random(5000));
    me->add("potential", 3000 + random(500));
    me->add("max_neili", 10 + random(20));
    me->add("max_jingli", 10 + random(20));
    message_vision(HIG "$N一会一块月饼就吃完了，$N抺了抺嘴，说了句味道好级了。\n", me);
    tell_object(me, "祝您中秋节愉快。\n" NOR);
    me->set("marks/yuebing", 1);
  } else tell_object(me, HIM "太甜了，您多吃不好！\n" NOR);
  destruct(this_object());
  return 1;
}
