#include <ansi.h>;
inherit NPC;


string ask_gold();
string ask_shena();
string ask_shenb();


void init() {
  add_action("do_add", "add");
}


void create() {
  set_name(HIR "特使" NOR, ({ "teshi" }));
  set("title", HIC "侠客梦" NOR);
  set("gender", "男性");
  set("age", 57);
  set("attitude", "friendly");
  set("long", "他是梦巫师为了补偿新老玩家请来，为大家发点小礼物，不成敬意请您笑纳，您可以用add来提升自己 的功夫，也可向他要点钱噢!    \n");




  set("shen_type", 1);

  set("combat_exp", 3000000);

  set("attitude", "friendly");
  set("inquiry", ([
    "money": (: ask_gold :),
    //"负神" : (: ask_shena :),
    //"正神" : (: ask_shenb :),

  ]));

  set("max_qi", 9500);
  set("max_jing", 5000);

  set("max_neili", 7500);
  set("neili", 7500);
  set("jiali", 100);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set_skill("unarmed", 300);
  set_skill("dodge", 300);
  set_skill("force", 300);
  set_skill("cuff", 300);
  set_skill("xiantian-gong", 300);
  set_skill("qiankun-danuoyi", 300);
  set_skill("parry", 300);
  set_skill("taoism", 400);
  set_skill("sword", 300);
  set_skill("dugu-jiujian", 300);
  map_skill("sword", "yuxiao-jian");
  map_skill("dodge", "qiankun-danuoyi");
  map_skill("parry", "qiankun-danuoyi");
  map_skill("force", "xiantian-gong");


  prepare_skill("cuff", "dugu-jiujian");




  setup();
  carry_object("/clone/armor/cloth")->wear();
}


string ask_gold() {
  object me;
  me = this_player();
  if (me->query("gift") > 0) {
    return ("已经领过了!\n");
  } else {
    me->add("balance", 100000);
    me->set("gift", 1);
    return "好吧，给你加点存款吧!。";
  }
}
string ask_shena() {
  object me;
  me = this_player();
  if (me->query("shena") > 0) {
    return ("已经加过了!\n");
  } else {
    me->set("shen", -500);
    me->set("shena", 1);
    return "好吧，给你加点负神吧!。";
  }
}



string ask_shenb() {
  object me;
  me = this_player();
  if (me->query("shenb") > 0) {
    return ("已经领过了!\n");
  } else {
    me->set("shen", 500);
    me->set("shenb", 1);
    return "好吧，给你加点正神吧!。";
  }
}




int accept_kill(object obj) {
  command("say 啊！" + obj->name() + "你为什么要杀我呀，小心我告诉你妈妈！");
  if (wizardp(obj)) {
    obj->set("immortal", 0);
    obj->die();
    obj->set("immortal", 1);
  } else {
    obj->die();
  }
}


int do_add(string name) {
  object me = this_player();
  object obj, link_ob;


  if (me->query("pp") > 0) {
    tell_object(me, HIG "你已经领了,一人只能有一次机会!\n" NOR);
    return 1;
  }
  me->add("combat_exp", 50000);
  me->add("potential", 200);
  me->add("max_neili", 300);
  me->add("max_jingli", 200);
  me->set_skill("literate", me->query_skill("literate", 1) + 20);
  me->set_skill("cuff", me->query_skill("cuff", 1) + 20);
  me->set_skill("dodge", me->query_skill("dodge", 1) + 20);
  me->set_skill("force", me->query_skill("force", 1) + 20);
  me->set_skill("parry", me->query_skill("parry", 1) + 20);
  me->set_skill("strike", me->query_skill("strike", 1) + 20);
  me->set_skill("sword", me->query_skill("sword", 1) + 20);
  me->set_skill("hand", me->query_skill("hand", 1) + 20);
  me->set_skill("blade", me->query_skill("blade", 1) + 20);
  me->set_skill("stick", me->query_skill("stick", 1) + 20);
  me->set_skill("staff", me->query_skill("staff", 1) + 20);
  //               me->set_skill("poison",me->query_skill("poison", 1)+20);
  me->set_skill("training", me->query_skill("training", 1) + 20);
  me->set_skill("club", me->query_skill("club", 1) + 20);
  me->set_skill("claw", me->query_skill("claw", 1) + 20);
  me->set_skill("finger", me->query_skill("finger", 1) + 20);
  me->set_skill("hammer", me->query_skill("hammer", 1) + 20);
  me->set_skill("hook", me->query_skill("hook", 1) + 20);
  me->set_skill("kick", me->query_skill("kick", 1) + 20);
  me->set_skill("pike", me->query_skill("pike", 1) + 20);
  me->set_skill("whip", me->query_skill("whip", 1) + 20);


  me->set("pp", 1);
  message_vision(HIG "特使拍拍$N的头,$N立刻变的厉害不少!\n" NOR, me);
  return 1;





}
