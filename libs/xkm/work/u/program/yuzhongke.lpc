#include <ansi.h>;
inherit NPC;


void init()
{
        add_action("do_add", "add");
}

void create()
{
        set_name(HIG"雨中客"NOR, ({ "yuzhongke","ke", "daxia" }) );
set("gender", "男性" );
set("title",WHT"江湖传功者"NOR);
        set("age", 19);
        set("long", 
            " 一看就是条硬汉子，黑黝黝的脸庞，铁塔般的个子，左手提着宽刃刀。\n"
                       " "HIY"他可以给你增加200 最大内力(add neili).\n"
                      " "HIR"不要惹他，他会一刀把你劈成两半!\n"NOR" "
);
        set("shen_type", 1);

        set("combat_exp", 8000000);

        set("attitude", "friendly");

        set("max_qi", 9500);
        set("max_jing", 5000);
        set("max_neili",7500);
        set("neili",7500);
        set("jiali",100);
        set("str", 30);
        set("int", 30);
        set("con", 30);
        set("dex", 30);

       set_skill("dodge", 300);
       set_skill("force",300);
       set_skill("cuff",300);
       set_skill("parry",300);
       set_skill("strike",300);
       set_skill("sword",300);
       set_skill("blade",300);
     set_skill("xiantian-gong",300);
     set_skill("quanzhen-jian",300);
     set_skill("jinyangong",300);
     set_skill("chunyang-quan",300);
     set_skill("sanhua-juding",300);
     set_skill("kongming-quan",300);
     set_skill("taoism",300);
     set_skill("literate",300);

      map_skill("sword","quanzhen-jian");
      map_skill("force","xiantian-gong");
      map_skill("dodge","jinyangong");
      map_skill("parry","kongming-quan");
      map_skill("strike","sanhua-juding");
      map_skill("cuff","kongming-quan");

       prepare_skill("cuff", "kongming-quan");
       prepare_skill("strike", "sanhua-juding");

setup();
       carry_object("/clone/armor/cloth")->wear();
}

int accept_kill(object obj)
{

        command("say 哼！" + obj->name() + ",你这不知好歹的家伙！");
message_vision(HIB"\n雨中客不容$N多想，一刀向$N天灵盖劈来！一丝凉意从$N身体中穿过。\n"NOR, this_player());
         if (wizardp(obj))
         { obj->set("immortal",0);
           obj->die();
           obj->set("immortal",1);
         }
        else
        {obj->die();}
}

int do_add(string name)
{
        object me = this_player();
        object obj,link_ob;
    if( me->query("pp1")>0)
{
