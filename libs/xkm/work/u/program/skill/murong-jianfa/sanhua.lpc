// ding.c 

#include <ansi.h>

inherit F_SSERVER;
#include "/kungfu/skill/eff_msg.h";


int perform(object me, object target) {
  object weapon;
  int damage, time;
  string msg;

  if (!target) target = offensive_target(me);

  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("天女散花只能对战斗中的对手使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if (target->is_busy())
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧！！！\n");
  if ((int)me->query_skill("murong-jianfa", 1) < 120)
    return notify_fail("你的慕容剑法不够娴熟，不能使用天女散花。\n");

  if ((int)me->query_skill("shenyuan-gong", 1) < 120)
    return notify_fail("你的本门内功不够娴熟，不能使用天女散花。\n");
  if ((int)me->query_temp("lianhuan"))
    return notify_fail("你正在使用七剑连环指！\n");
  if ((int)me->query("neili", 1) < 950)
    return notify_fail("你现在内力太弱，不能使用天女散花。\n");


  msg = HIG "$N使出「天女散花」，点点剑光直飞$n全身各大要穴。\n" NOR;

  if (random(me->query_skill("force")) > target->query_skill("force") / 3) {
    damage = (int)me->query_skill("murong-jianfa", 1) + (int)me->query_skill("force", 1);
    damage = damage + random(damage / 2);
    target->receive_damage("qi", damage * 2);
    target->start_busy(3);
    me->add("neili", -100);
    time = 8 - ((int)me->query_skill("murong-jianfa", 1) / 40);
    if (me->query_skill("murong-jianfa", 1) > 140)
      call_out("perform2", 0, me, target);

    msg += MAG "$n被攻了个措手不及！\n" NOR;

  } else {
    me->start_busy(1 + random(2));
    msg += MAG "可是$p看破了$P的企图，并没有上当。\n" NOR;
  }
  message_vision(msg, me, target);
  me->start_perform(4, "「" HIR "天女散花" NOR "」");
  return 1;
}
int perform2(object me, object target) {
  int damage, p;
  object weapon;
  string msg, dodge_skill;

  if (!target) target = offensive_target(me);

  weapon = me->query_temp("weapon");
  if (!target)
    target = offensive_target(me);

  if (!target || !me->is_fighting(target))
    return notify_fail("只能在战斗中对对手使用。\n");

  if (!weapon
    || weapon->query("skill_type") != "sword"
    || me->query_skill_mapped("sword") != "murong-jianfa")
    return notify_fail("你手里没有剑，无法使用「" HIR "天女散花" NOR "」！\n");
  if (me->query_skill_mapped("force") != "shenyuan-gong")
    return notify_fail("你所使用的内功不对。\n");

  if ((int)me->query("max_neili") < 1500)
    return notify_fail("你的内力太弱，不能使用「" HIR "天女散花" NOR "」！\n");

  if ((int)me->query("neili") < 700)
    return notify_fail("你的内力太少了，无法使用出！\n");
  msg = HIR "\n紧跟着$N剑锋一转，欺身近前，从不可思议的角度刺向$n的" HIY "「命门穴」" HIR "！\n" NOR;
  message_vision(msg, me, target);
  if (random(me->query_skill("sword")) > target->query_skill("parry") / 3) {
    me->start_busy(1);
    me->add("neili", -140);
    me->add("jingli", -40);
    damage = (int)me->query_skill("murong-jianfa", 1);

    damage = damage * 2 + random(damage);
    if (target->is_busy()) damage = damage * 2;
    if (target->query("shen") < 0) damage = damage * 3 / 2;
    if (me->query("neili") > target->query("neili") * 2) damage += random(damage);
    target->receive_damage("qi", damage / 7);
    target->receive_wound("qi", damage / 8);
    p = (int)target->query("qi") * 100 / (int)target->query("max_qi");
    msg = CYN "$n只觉全身真气由「" HIY "命门穴" CYN "」狂泻而出。
" NOR "结果「噗嗤」地一声，" + weapon->name() + "刺进了$n的「" HIY "命门穴" NOR "」，殷红的鲜血随即喷了出来！\n" NOR; target->start_busy(4 + random(3));
    msg += "( $n" + eff_status_msg(p) + " )\n";
  } else msg = CYN "$n一个懒驴打滚，危急之中躲过致命一击！\n" NOR;
  message_vision(msg, me, target);


  msg = HIC "就在$n疲于防守之际，$N又风驰电掣地刺出第三剑。\n" NOR;
  message_vision(msg, me, target);
  if (random(me->query_skill("sword")) > target->query_skill("dodge") / 2) {
    me->start_busy(1);
    me->add("neili", -150);
    me->add("jingli", -50);
    damage = (int)me->query_skill("murong-jianfa", 1);
    damage = damage * 3 + random(damage);
    if (target->is_busy()) damage = damage * 2;
    if (target->query("shen") < 0) damage = damage * 3 / 2;
    if (me->query("neili") > target->query("neili") * 2) damage += random(damage);
    target->receive_damage("qi", damage / 3);
    target->receive_wound("qi", damage / 4);
    p = (int)target->query("qi") * 100 / (int)target->query("max_qi");
    msg = HIW "结果一剑正刺中$n的" HIR "「檀中穴」" NOR "。
结果「噗嗤」地一声，" + weapon->name() + "刺进了$n的「" HIR "檀中穴" NOR "」，殷红的鲜血随即喷了出来！
" NOR;
    msg += "( $n" + eff_status_msg(p) + " )\n";


  } else msg = HIW "$n一个旱地拔葱，跃起数丈，堪堪避过！\n" NOR;
  message_vision(msg, me, target);

  me->start_perform(3, "「" HIR "天女散花" NOR "」");
  return 1;
}
