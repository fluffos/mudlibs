//Edit by cloth 2000-09-19
#include <ansi.h>
#include "skill.h"
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target)
{
        string msg;
        int extra;
        object weapon;
        extra = me->query_skill("murong-jianfa",1);
        if ( extra < 180) return notify_fail("你的慕容剑法还不够纯熟！\n");
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("［流星快剑］只能对战斗中的对手使用。\n");
        if ((int)me->query("neili")<850)
                return notify_fail("你的内力不够。\n"); if( me->query_temp("canshang") )
                return notify_fail("你已经在使用参商指法了！\n");

        if(me->query_skill_mapped("force") != "shenyuan-gong")
                return notify_fail("你的内功不是神元功，无法使用［流星快剑］！\n"); 
        if( (int)me->query_skill("shenyuan-gong", 1) < 100 )
                return notify_fail("你的内功还未练成，不能使用［流星快剑］！\n");   
if( (int)me->query_skill("murong-jianfa", 1) < 100 )
                return notify_fail("你的慕容剑法还未练成，不能使用［流星快剑］！\n");       
         if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
                   return notify_fail("你使用的武器不对。\n"); 
        if((int)me->query_temp("lianhuan"))
                return notify_fail("你正在使用七剑连环指！\n");   
      
        weapon = me->query_temp("weapon");
        message_vision(HIG"$N使出慕容复家传剑法，招招连绵不绝，犹似行云流水一般，瞬息之间，全身便如罩在一道光幕之中！\n" NOR,me,target);        
     if (random((int)me->query_skill("dodge",1))>random((int)target->query_skill("dodge")/2 )  || target->is_busy())
        {
        me->add_temp("apply/strength", extra/8);
        me->add_temp("apply/dexerity", extra/8);
        me->add_temp("apply/attack", extra/8);
       
       message_vision(HIG"突然间，从光幕中爆出六道"HIW"剑芒"HIG"，快似流星般地飞向$n！\n" NOR,me,target);  me->add("neili",-650);
        COMBAT_D->do_attack(me,target, weapon); 
        
        COMBAT_D->do_attack(me,target, weapon);
        
        COMBAT_D->do_attack(me,target, weapon);
        
        COMBAT_D->do_attack(me,target, weapon);
       
        COMBAT_D->do_attack(me,target, weapon);
       
        COMBAT_D->do_attack(me,target, weapon);
        
        me->add_temp("apply/strength", -extra/8);
        me->add_temp("apply/dexerity", -extra/8);
        me->add_temp("apply/attack", -extra/8);
       
        
        me->start_perform(5,"［流星快剑］"); me->start_busy(2+random(2)); 
        } else { 
                message_vision(HIR"\n$n看破了$N的剑路,信手使出一招，$N身形一滞，前后剑招无法连贯，光幕立即瓦解！\n" NOR,me,target);
                me->start_busy(3);  me->add("neili",-250);
        }        
        return 1;
}