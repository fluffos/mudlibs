//creat by pro
//华山弟子用剑

#include <weapon.h>
inherit F_AUTOLOAD;
inherit SWORD;
void create() {
  set_name("侠义正气剑", ({ "xiayi jian", "jian" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是一柄华山岳掌门发给弟子的剑，上刻“侠义正气”四个字，\n时刻提醒华山弟子要以侠义正气四个字作为做人的准则。\n");
    set("material", "steel");
    set("value", 1000);
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_get", 1);
    set("no_steal", 1);
    set("wield_msg", "$N「唰」的一声，将一柄$n擎在手中。\n");
    set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
  }
  init_sword(30);
  setup();
}
int query_autoload() { return 1; }
