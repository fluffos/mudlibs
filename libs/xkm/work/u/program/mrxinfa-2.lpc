//Cracked by Roath
// bingxuejue-i.c

inherit ITEM;

void create() {
  set_name("慕容心法下册", ({ "murong xinfa", "book", "xinfa" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "这是一册慕容心法提高阶段的秘籍。\n");
    set("value", 200);
    set("material", "paper");
    set("skill", ([
      "name": "murong-xinfa",       // name of the skill
      "exp_required": 30000,      // minimum combat experience required
      "jing_cost": 30 + random(20),        // jing cost every time study this
      "difficulty": 25,     // the base int to learn this skill
      "max_skill": 100,     // the maximum level you can learn
    ]));
  }
}
