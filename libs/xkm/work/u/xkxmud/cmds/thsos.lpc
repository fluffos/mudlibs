#include <dbase.h>
inherit F_CLEAN_UP;
inherit F_DBASE;

int main(object me, string arg)
{
        int a,b,c,i;
        if(!arg) return notify_fail("thhelp x x x\n");
        if(sscanf(arg, "%d %d %d",a,b,c )==3)
        {
                for(i=0;i<=105;i++)
                {
                        if(i%3==a && i%5==b && i%7==c)
                                return notify_fail("这个数是"+(string)i+"!\n");
                }
                return notify_fail("对不起,我没算出来!!\n");
        }
        else    return notify_fail("thhelp x x x\n");
}

