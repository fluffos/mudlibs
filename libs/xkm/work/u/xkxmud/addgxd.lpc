// addgxd by jhy 02.9.1

#include "/doc/help.h"
#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, int arg) {
  object ob;
  string id, ly;
  int gxd;

  seteuid(getuid(me));
  if (!arg || sscanf(arg, "%s %d %s", id, gxd, ly) != 3)
    return notify_fail("指令格式: addgxd <id> <点数> <理由>\n");

  ob = present(id, environment(me));
  if (!ob) ob = find_player(id);
  if (!ob) ob = find_living(id);
  if (!ob) return notify_fail("你要加？\n");

  message_vision(HIG "$N" HIG "为$n" HIG "加了" HIR + gxd + HIG "点贡献度，希望您为梦站续继努力。\n" NOR, me, ob);
  write_file("/u/jhy/old/addgxd", sprintf("%s给%s(%s)加了%d点贡献理由是%s %s\n",
    me->query("name"), ob->query("name"), ob->query("id"),
    gxd, ly, ctime(time())));
  ob->add("menggxd", (int)gxd * 10);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式: addgxd <id> <点数>
 
为有贡献的玩家加贡献度。

HELP
  );
  return 1;
}
