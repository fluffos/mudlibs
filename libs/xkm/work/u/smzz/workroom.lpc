void init()
{
object me;
me = this_player();
if ((string)me->query("id")=="smzz" )
return 0;
else
{
       me->delete("env/invisibility");
      tell_object(this_player(), BBLU+HIY"阎王殿里,五殿阎君大小鬼神具在。\n" NOR );
message_vision(BBLU+HIR"$N到了这里岂能任由小小$N隐身！隐身状态马上消失!\n"NOR,me);
}

return ;
}
