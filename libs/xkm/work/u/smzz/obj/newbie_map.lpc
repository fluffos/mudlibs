//smzz (2002.9.16)
//新手地图
#include <ansi.h>
inherit ITEM;
void create() {
  set_name(HIG "新手地图" NOR, ({ "newbie map", "map" }));
  set("long",
    "据说这是当年大侠郭靖送杨过去全真拜师时留给" HIW "神雕大侠" NOR "的一张羊皮。\n"
    "地图，是黄蓉专门为行走江湖的少年制作的。你可以唤来神雕飞(trans)去任何地方。\n"
    "   " BRED + GRN "**************************************************\n" NOR
    "     " HIM "扬州:yz   泉洲:qz   武当:wd   佛山:fs       \n" NOR
    "    " BGRN + HIY "------------------------------------------\n" NOR
    "     " HIM "雪山:xs   归云:gy   桃花:th   重阳宫:cyg          \n" NOR
    "   " BRED + GRN "**************************************************\n" NOR
  );
  set("no_drop", MAG "你还小这样东西离不开你。\n" NOR);
  set("no_get", "这样东西不能离开那儿。\n");
  set("unit", "张");
  set("value", 0);
}
int query_autoload() { return 1; }
void init() {
  add_action("do_trans", "trans");
}
int do_trans(string arg) {
  object me;
  me = this_player();
  if ((int)me->query("combat_exp") > 100000) return notify_fail(HIC "你现在不需要任何外界帮助。应该自立了！\n" NOR);
  if (!arg || arg == "") return notify_fail("你要去哪里？抱歉地图以外的地方我去不了!\n");
  else if (arg == "yz") {
    me->move("d/city/guangchang");
    me->start_busy(5);
    message_vision(HIY "大雕背着$N眨眼就到了到了扬州。\n" NOR + CYN "$N从大雕的颈上跳了下来，那只神雕扑腾、扑腾又飞走了。\n" NOR, me);
  } else if (arg == "qz") {
    me->move("d/quanzhou/zhongxin");
    me->start_busy(5);
    message_vision(HIY "大雕背着$N眨眼就到了到了泉州。\n" NOR + CYN "$N从大雕的颈上跳了下来，那只神雕扑腾、扑腾又飞走了。\n" NOR, me);
  } else if (arg == "wd") {
    me->move("/d/wudang/guangchang");
    me->start_busy(5);
    message_vision(HIY "大雕背着$N眨眼就到了到了武当。\n" NOR + CYN "$N从大雕的颈上跳了下来，那只神雕扑腾、扑腾又飞走了。\n" NOR, me);
  } else if (arg == "fs") {
    me->move("/d/foshan/street2");
    me->start_busy(5);
    message_vision(HIY "大雕背着$N眨眼就到了到了佛山。\n" NOR + CYN "$N从大雕的颈上跳了下来，那只神雕扑腾、扑腾又飞走了。\n" NOR, me);
  } else if (arg == "xs") {
    me->move("/d/xueshan/guangchang");
    me->start_busy(5);
    message_vision(HIY "大雕背着$N眨眼就到了到了雪山。\n" NOR + CYN "$N从大雕的颈上跳了下来，那只神雕扑腾、扑腾又飞走了。\n" NOR, me);
  } else if (arg == "gy") {
    me->move("/d/taihu/shufang");
    me->start_busy(5);
    message_vision(HIY "大雕背着$N眨眼就到了到了归云庄。\n" NOR + CYN "$N从大雕的颈上跳了下来，那只神雕扑腾、扑腾又飞走了。\n" NOR, me);
  } else if (arg == "cyg") {
    me->move("/d/zhongnan/dadian");
    me->start_busy(5);
    message_vision(HIY "大雕背着$N眨眼就到了到了重阳宫。\n" NOR + CYN "$N从大雕的颈上跳了下来，那只神雕扑腾、扑腾又飞走了。\n" NOR, me);
  } else if (arg == "th") {
    me->move("/d/taohua/xiaojing");
    me->start_busy(5);
    message_vision(HIY "大雕背着$N眨眼就到了到了桃花岛。\n" NOR + CYN "$N从大雕的颈上跳了下来，那只神雕扑腾、扑腾又飞走了。\n" NOR, me);
  } else return notify_fail("你要去哪里？抱歉地图以外的地方我去不了!\n");
  return 1;
}
