#include <ansi.h>
inherit ITEM;
int do_chou(string);
void init();

void init()
{
   add_action("do_eat", "eat");  
   add_action("do_paimai", "paimai");
}

void create()
{
        set_name(HIG "仙桃" NOR, ({"xian tao", "tao",}));
      set_weight(20);
     if (clonep())
      set_default_object(__FILE__);
    else {
       set("unit", "颗");
        set("long", WHT"这是一小颗飘香仙桃，好象是"NOR+HIM"飘香公主"NOR+WHT"为大家精心制作的。\n"NOR);
       set("value", 50);
        set("no_get",1);
        set("no_drop",1);
     }
     setup();
}

int do_eat(string arg)
{
       object me = this_player();
/*       if(me->query("combat_exp",1)>100000) {
         message_vision(WHT "这是为新人准备的！！\n\n" NOR,me);
         destruct (this_object());
         return 1;
               }*/
       if (!id(arg))
        return notify_fail("你要吃什么？\n");
        me->set("eff_jing", (int)me->query("max_jing"));
        me->set("jing", (int)me->query("max_jing"));
        me->set("eff_qi", (int)me->query("max_qi"));
        me->set("qi", (int)me->query("max_qi"));
        me->set("neili", (int)me->query("max_neili")*(random(5)+1));
        me->set("jingli", (int)me->query("max_jingli")*(random(5)+1));
        me->set("food", (int)me->max_food_capacity()*(random(10)+1));
        me->set("water", (int)me->max_water_capacity()*(random(10)+1));
        message_vision(HIM "$N掏出一粒“"NOR+HIG"仙桃"NOR+HIM"”放在嘴里，顿时有一股清心的气息流遍全身各穴道，感觉到无比的清爽！\n"NOR, me);
        if (!(int)this_object()->query_temp("eat_full")) 
          this_object()->set_temp("eat_full",0);
        if ((int)this_object()->query_temp("eat_full")<=3)
         this_object()->set_temp("eat_full",(int)this_object()->query_temp("eat_full")+1);
           else
            {
           (int)this_object()->delete_temp("eat_full");
        message_vision(HIM "$N望着"HIG"仙桃"HIM"最后一部分，意由未尽，有点舍不得吃下！\n"NOR
          HIC "只见$N有点念念不舍的丢下了一颗仙桃的桃核！\n "NOR, me);
              destruct(this_object());
         }
              return 1;
}
int do_paimai(string arg)
{
        object me = this_player();
        tell_object(this_player(),HIR "这样物品无法拍卖！！\n" NOR,me);
        return 1;
}
