#include <ansi.h>
inherit ROOM;

void create ()
{
        set ("short",HIM"广"HIG"寒"HIC"宮"NOR);
      set("long",HIC@LONG
                               !
                                  /^\
                                /     \
                 |           | (       ) |           |
                /^\ |       /^\ \     / /^\       | /^\
                |O|/^\     (   )|-----|(   )     /^\|O|
                |_||-| |^-^|---||-----||---|^-^| |-||_|
                |O||O| |/^\|/^\||  |  ||/^\|/^\| |O||O|
                |-||-| ||_|||_||| /^\ |||_|||_|| |-||-|
                |O||O| |/^\|/^\||(   )||/^\|/^\| |O||O|
                |-||-| ||_|||_||||   ||||_|||_|| |-||-|
                                                                        
LONG NOR);
           set("exits", 
        ([ //sizeof() == 2
                 "hy" : "/u/jhy/workroom",
                "up" : "/d/wizard/wizard_room",
                "down" : "/d/city/kedian",
                 "east":"/u/pod/keting",
                    "lz" : "/u/program/workroom",
                  "snow" : "/u/snow/workroom",
                    "gc" : "/d/city/guangchang",
                    "lj" : "/d/lingjiu/damen",
                    "gm" : "/d/zhongnan/dating",
                        ]));
       set("objects", ([ 
      "/u/pod/npc/yue.c" : 1,
       ]) );

        set("no_clean_up", 0);
     set("no_fight",1);
        set("sleep_room",1);
        set("valid_startroom", 1);
     set("no_age",1);
        set("no_steal", 1);
        set("cost", 1);
   setup();;  "/clone/board/pod_b"->foo();
}
void init()
{
   object me;
   me = this_player();
   if ((string)me->query("id")=="pod")
    return 0;
   if(!wizardp(this_player()))
      return 0;
   if(me->is_ghost()){         
   this_player()->reincarnate();//如果你是鬼魂，那么用这个就可以换阳了
      message_vision(HIW"$N又再次回到了人间，再度为人。\n"NOR, this_player());
          }
   else
   {
   me->delete("env/invisibility");
      tell_object(this_player(), BBLU HIY"你到了天宫隐身功能自动消除。\n" NOR );
      message_vision(BBLU HIR"$N到了这里自动取消了隐身功能！\n"NOR,me);
}
  add_action("discmds",({
"hit","kill","fight","steal","ansuan","touxi","set","home","goto","more","edit"
}));
}
int discmds()
{
        tell_object(this_player(),HIY"请不要打扰"HIW"飘香公主"HIY"的清修！\n"NOR);
        return 1;
}
