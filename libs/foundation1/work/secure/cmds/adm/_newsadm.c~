#include <std.h>

inherit DAEMON;

#define SYNTAX "newsadm <command> <arg>"

int
cmd_newsadm(string str) {
    string cmd, arg;

    if (sscanf(str, "%s %s", cmd, arg) != 2)
	return notify_fail(SYNTAX);
    
    if (cmd != "add") {
	write("Invalid command.");
	return 1;
    }
    NEWSSERVER->add_group(arg);
}
