#daemon/politics.c
policies (["appointing the deputies":(["Aye":({"yildor","toxic","sluggo","topknot","bess",}),"Abs":({}),"Nay":({}),"Title":"appointing the deputies","Text":"The Police Commissioner and Judge have the power to appoint deputies to perform their duties while they are not online. The deputies will only havethis power when the Police Commissioner or Judge are not online. There will bea maximum of 4 deputies allowed, and they can be removed by the person thatappointed them at any time. The council, however, has the right to vote onthe choice of deputy if they feel that the deputy cannot handle the positionin any way.","Time":780111393,"Proposer":"toxic","Voted":(["sluggo":"Aye","topknot":"Aye","yildor":"Aye","bess":"Aye","toxic":"Aye",]),]),"if a player is killed by a deputy":(["Aye":({"yildor","belfalas","toxic","ashy","annie",}),"Title":"if a player is killed by a deputy","Nay":({}),"Abs":({}),"Time":777777719,"Text":"In the event that a player is killed while resisting arrest by aDeputy of Law, such death will not be compensated in any way or fashion.","Proposer":"yildor","Voted":(["belfalas":"Aye","yildor":"Aye","annie":"Aye","toxic":"Aye","ashy":"Aye",]),]),"killing of a player":(["Aye":({"annie","yildor","tokenlore","creb","dana",}),"Abs":({}),"Nay":({}),"Title":"killing of a player","Text":"It is illegal to maliciously cause the death of a player, or attemptto do so, except in specific cases to be listed in this Book of Law.","Time":777348627,"Proposer":"yildor","Voted":(["yildor":"Aye","annie":"Aye","dana":"Aye","creb":"Aye","tokenlore":"Aye",]),]),"bringing a case to court":(["Aye":({"yildor","belfalas","annie","pianoman","li",}),"Title":"bringing a case to court","Nay":({}),"Abs":({}),"Time":777778645,"Text":"After an arrest has been made, the Police Commissioner shall inquirewhether the victim, if any, wishes to press charges. The Commissioner can also press charges on behalf of the MUD. If chargesare to be pressed, the Commissioner shall gather what evidence he canand decide whether there is enough evidence to bring before a court.If the Commissioner decides in the affirmative, the case is to bebrought before a court as soon as possible.If the Commissioner decides in the negative, the case shall bebarred from coming before a court. Such a barring can be overturnedby agreement of 3 Councillors, and such an overturning will bedone publicly, to the Commissioner's embarrassment.","Proposer":"yildor","Voted":(["belfalas":"Aye","yildor":"Aye","annie":"Aye","pianoman":"Aye","li":"Aye",]),]),])
income ([])
spending (["police":100,])
personnel (["police":2,])
