// Room: fatang.c

inherit ROOM;

void create() {
  set("short", "欧阳峰居");
  set("long", @LONG
这座法堂重檐盔顶，纯木结构，四面环以明廊，腰檐设有平座，建筑精湛，
精巧别致。廊下环栽着长青松柏，庭中更有一株几抱粗的百年梅花树，树干黝
黑似铁，苍劲挺拔。
LONG
  );
  set("objects", ([
    "/clone/npc/1/ouyang": 1,

  ]));
  set("exits", ([ "up": __DIR__ "fatang2",
    "south": __DIR__ "fanyinge",
  ]));

  setup();
}

int valid_leave(object me, string dir) {
  object *obj;

  if (present("ouyang", environment(me))
    && dir == "up") {

    return notify_fail("没打赢我之前不能上去\n");

  }

  return 1;
}
