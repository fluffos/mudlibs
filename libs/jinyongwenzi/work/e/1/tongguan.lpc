void init() {
  mapping mine;
  object ob = this_player();



  if (!userp(ob)) return;

  if (ob->query("enter") < 10) {
    message_vision(HIR "第10关标志已经设！\n" NOR, ob);
    ob->set("enter", 10);
  }

}
