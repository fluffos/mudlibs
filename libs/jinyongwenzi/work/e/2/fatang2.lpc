// Room: fatang2.c

inherit ROOM;

void create() {
  set("short", "金刚伏魔圈");
  set("long", @LONG
这里是大轮寺掌门居所，四面清幽，修禅证道最妙不过。真是：
    戏招西塞山前月，来听东林寺里钟。
    悠然万虑忘，有此一楼足。
    西窗外，群山万壑，望尽天地。
    东窗外，楼台错落，几尽悠闲。
LONG
  );
  set("objects", ([
    "/kungfu/class/shaolin/e": 1,
    "/kungfu/class/shaolin/jie": 1,
    "/kungfu/class/shaolin/nan": 1,

  ]));
  set("exits", ([ "down": __DIR__ "fatang",
    "up": "/e/1/shanmen",
  ]));

  setup();
}
int valid_leave(object me, string dir) {
  if ((string)me->query("family/family_name") != "大轮寺"
    && dir == "up"
    && present("nan", environment(me)))
    return notify_fail(
      "没打赢我之前不能上去\n");

  return ::valid_leave(me, dir);
}
