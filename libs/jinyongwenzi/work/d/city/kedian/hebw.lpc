#include <ansi.h>
inherit NPC;
void create() {
  set_name("鹤笔翁", ({ "he biweng", "he", "biweng" }));
  set("nickname", HBBLU "玄冥二老" NOR);
  set("long", "他就是玄冥二老中的鹤笔翁。\n");
  set("gender", "男性");
  set("age", 53);
  set("attitude", "peaceful");
  set("str", 25);
  set("int", 25);
  set("con", 25);
  set("dex", 25);
  //      set("unique", 1);
  set("per", 20);
  set("no_get", 1);

  set("max_qi", 5000);
  set("max_jing", 3500);
  set("neili", 8000);
  set("jiali", 100);
  set("combat_exp", 1600000);
  set("eff_jingli", 6000);

  set_skill("force", 170);
  set_skill("hunyuan-yiqi", 160);
  set_skill("dodge", 170);
  set_skill("tiyunzong", 170);
  set_skill("strike", 180);
  set_skill("xuanming-shenzhang", 180);
  set_skill("parry", 170);
  set_skill("literate", 170);

  map_skill("force", "hunyuan-yiqi");
  map_skill("dodge", "tiyunzong");
  map_skill("strike", "xuanming-shenzhang");
  map_skill("parry", "xuanming-shenzhang");
  prepare_skill("strike", "xuanming-shenzhang");

  setup();
  carry_object("/d/wudang/obj/white-robe")->wear();
}

void init() {
  object ob = this_player();
  if (ob->query("zhao_job", 1) < 2000) {
    // 49               ob->set_skill("xuanming-shenzhang",0);
    return;
  }
  ::init();
}
