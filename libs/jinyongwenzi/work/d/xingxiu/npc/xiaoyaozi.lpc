#include <ansi.h>

inherit NPC;
inherit F_MASTER;



void create() {
  set_name("逍遥子", ({ "ding chunqiu", "ding" }));
  set("nickname", "天山派祖师");

  set("gender", "男性");
  set("age", 100);
  set("per", 24);
  set("attitude", "friendly");
  set("no_bark", 1);
  set("shen_type", -1);
  set("str", 30);
  set("int", 27);
  set("con", 28);
  set("dex", 32);
  set("max_qi", 6000);
  set("max_jing", 5000);
  set("eff_jingli", 3500);
  set("max_neili", 11000);
  set("jiali", 120);
  set("combat_exp", 2000000);
  set("unique", 1);
  set("shen", -200000);

  set_skill("force", 200);
  set_skill("beiming-shengong", 200);
  set_skill("dodge", 200);
  set_skill("zhaixingshu", 200);
  set_skill("strike", 200);
  set_skill("chousui-zhang", 200);
  set_skill("parry", 200);
  set_skill("hand", 200);
  set_skill("zhemei-shou", 200);
  set_skill("staff", 176);
  set_skill("tianshan-zhang", 200);
  set_skill("literate", 230);
  set_skill("poison", 200);
  map_skill("force", "beiming-shengong");
  map_skill("dodge", "zhaixingshu");
  map_skill("strike", "chousui-zhang");
  map_skill("parry", "chousui-zhang");
  map_skill("hand", "zhemei-shou");
  map_skill("staff", "tianshan-zhang");
  //prepare_skill("strike", "chousui-zhang");
  prepare_skill("hand", "zhemei-shou");
  create_family("天山派", 1, "开山祖师");


  set("chat_chance_combat", 20);
  set("chat_msg_combat", ({
    (: exert_function, "huagong" :),
    (: perform_action, "strike.huoqiu" :),
    (: perform_action, "strike.yinhuo" :),
    (: perform_action, "strike.biyan" :),
  }));

  set("drug_count", 15);
  set("class", "taoist");


  setup();

  if (clonep()) {
    UPDATE_D->get_cloth(this_object());
    add_money("gold", 5);
  }
}
