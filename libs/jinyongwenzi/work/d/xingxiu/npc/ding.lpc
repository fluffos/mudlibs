void create() {
  set_name("丁春秋", ({ "ding chunqiu", "ding" }));
  set("nickname", "星宿老怪");
  set("long",
    "星宿派开山祖师、令中原武林人士深恶痛绝的星宿老怪丁春秋。\n"
    "他脸色红润，满头白了，颏下三银髯，童颜鹤发。\n"
    "当真便如图画中的神仙人物一般。\n");
  set("gender", "男性");
  set("age", 60);
  set("per", 24);
  set("attitude", "friendly");
  set("no_bark", 1);
  set("shen_type", -1);
  set("str", 30);
  set("int", 27);
  set("con", 28);
  set("dex", 32);
  set("max_qi", 6000);
  set("max_jing", 5000);
  set("eff_jingli", 3500);
  set("max_neili", 11000);
  set("jiali", 120);
  set("combat_exp", 1700000);
  set("unique", 1);
  set("shen", -200000);
  set("vendetta_mark", "lcc");
  set_skill("force", 170);
  set_skill("huagong-dafa", 180);
  set_skill("dodge", 170);
  set_skill("zhaixingshu", 180);
  set_skill("strike", 180);
  set_skill("chousui-zhang", 180);
  set_skill("parry", 170);
  set_skill("claw", 170);
  set_skill("sanyin-zhua", 170);
  set_skill("staff", 176);
  set_skill("tianshan-zhang", 170);
  set_skill("literate", 130);
  set_skill("poison", 180);
  map_skill("force", "huagong-dafa");
  map_skill("dodge", "zhaixingshu");
  map_skill("strike", "chousui-zhang");
  map_skill("parry", "chousui-zhang");
  map_skill("claw", "sanyin-zhua");
  map_skill("staff", "tianshan-zhang");
  prepare_skill("strike", "chousui-zhang");
  prepare_skill("claw", "sanyin-zhua");
  create_family("天山派", 1, "开山祖师");


  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: exert_function, "huagong" :),
    (: perform_action, "strike.huoqiu" :),
    (: perform_action, "strike.yinhuo" :),
    (: perform_action, "strike.biyan" :),
  }));

  set("drug_count", 15);
  set("class", "taoist");


  setup();

  if (clonep()) {
    UPDATE_D->get_cloth(this_object());
    add_money("gold", 5);
  }
}
