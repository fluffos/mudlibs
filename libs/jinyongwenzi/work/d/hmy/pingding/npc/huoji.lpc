// huoji. 药铺伙计

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("药铺伙计", ({ "yaopu huoji", "huoji" }));
  set("str", 20);
  set("gender", "男性");
  set("age", 18);
  set("long", "他是平神医从乡下招来帮忙的。\n");
  set("combat_exp", 250);
  set("attitude", "friendly");
  set("vendor_goods", ({
    ([ "name": "/clone/medicine/jinchuang", "number": 20 ]),
    ([ "name": "/clone/medicine/m-book1", "number": 5 ]),
    ([ "name": "/clone/medicine/yangjing", "number": 20 ]),
    ([ "name": "/clone/medicine/drug/baiwei", "number": 8 ]),
    ([ "name": "/clone/medicine/drug/baizhi", "number": 9 ]),
  }));

  setup();
  carry_object("/clone/misc/cloth")->wear();
}

void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");
}
