// human.c
// From ES2
// Modified by Yu Jue@JY

inherit F_DBASE;
inherit F_SKILL;

mapping *combat_action = ({
  ([ "action": "$N挥拳攻击$n的$l",
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N往$n的$l一抓",
    "damage_type": "抓伤",
  ]),
  ([ "action": "$N往$n的$l狠狠地踢了一脚",
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N提起拳头往$n的$l捶去",
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N对准$n的$l用力挥出一拳",
    "damage_type": "瘀伤",
  ]),
});

void create() {
  seteuid(getuid());
  set("unit", "位");
  set("gender", "男性");
  set("can_speak", 1);
  set("attitude", "peaceful");
  set("limbs", ({
    "头部", "颈部", "胸口", "后心", "左肩", "右肩", "左臂",
    "右臂", "左手", "右手", "腰间", "小腹", "左腿", "右腿",
    "左脚", "右脚", "左耳", "右耳", "左脸", "右脸", "小腹"
  }));
}

void setup_human(object ob) {
  mapping my;
  int qi_age;

  my = ob->query_entire_dbase();

  ob->set_temp("default_actions", __FILE__);

  if (undefinedp(my["age"])) my["age"] = 14;
  if (undefinedp(my["str"])) my["str"] = 10 + random(21);
  if (undefinedp(my["con"])) my["con"] = 10 + random(21);
  if (undefinedp(my["dex"])) my["dex"] = 10 + random(21);
  if (undefinedp(my["int"])) my["int"] = 10 + random(21);
  if (undefinedp(my["per"])) my["per"] = 10 + random(21);
  if (undefinedp(my["kar"])) my["kar"] = 10 + random(21);
  if (undefinedp(my["pur"])) my["pur"] = 10 + random(21);

  if (2 > 1) {
    my["max_jing"] = (my["con"] + my["int"]) * 12 - 100;
    if (my["age"] <= 70) my["max_jing"] = 100 + (my["con"] + my["int"]) * 12 - (my["age"] - 50) * 10;
    if (my["age"] <= 50) my["max_jing"] = 100 + (my["con"] + my["int"]) * 12;
    //if( my["age"] <= 30 ) my["max_jing"] = 100 + (my["con"] + my["int"]) * (my["age"] - 14) / 2;
    //if( my["age"] <= 14 ) my["max_jing"] = 100;
  }
  if (2 > 1) {
    my["eff_jingli"] = (my["con"] + my["dex"]) * 12 - 100;
    if (my["age"] <= 70) my["eff_jingli"] = 100 + (my["con"] + my["dex"]) * 22 - (my["age"] - 50) * 10;
    if (my["age"] <= 50) my["eff_jingli"] = 100 + (my["con"] + my["dex"]) * 22;
    //	if( my["age"] <= 30 ) my["eff_jingli"] = 100 + (my["con"] + my["dex"]) * (my["age"] - 14) / 2;
    //if( my["age"] <= 14 ) my["eff_jingli"] = 100;
  }

  if (2 > 1) my["max_jingli"] = my["eff_jingli"];
  //if(userp(ob)||undefinedp(my["max_qi"])) {
  //----------------------------------玩加和npc 统一使用一套规则------------------------------------林川程
  if (userp(ob) || !userp(ob)) {
    //my["max_qi"] = (my["con"] + my["str"]) * 8 - 100;
    my["max_qi"] = 100 + (my["con"] + my["str"]) * 8 + (my["age"] - 14) * 10;
    //if( my["age"] <= 50 ) my["max_qi"] = 100 + (my["con"] + my["str"]) * 8;
    //if( my["age"] <= 30 ) my["max_qi"] = 100 + (my["con"] + my["str"]) * (my["age"] - 14) / 2;
    //if( my["age"] <= 14 ) my["max_qi"] = 100;
    if ((qi_age = (int)ob->query_skill("force")) > 30)
      my["max_qi"] += (qi_age - 30) * ((int)ob->query_skill("force", 1) / 10) / 2;
    my["max_neili"] = ob->query_skill("force") * 8 + ob->query("combat_exp") / 2000;
    //----------------------------强化内功的作用----------------------------------------林川程
    if (ob->query_skill_mapped("force") == "jiuyang-shengong")  //----------九阳神功
    {
      my["max_neili"] += ob->query_skill("jiuyang-shengong") * 20;
      my["max_qi"] += ob->query_skill("jiuyang-shengong") * 15;
    }
    if (ob->query_skill_mapped("force") == "yijin-jing")  //----------易筋经
    {
      my["max_neili"] += ob->query_skill("yijin-jing") * 14;
      my["max_qi"] += ob->query_skill("yijin-jing") * 14;
    }
    if (ob->query_skill_mapped("force") == "yijin-jing" && ob->query_skill("force", 1) > 169)  //----------易筋经
    {
      my["max_neili"] += ob->query_skill("yijin-jing") * 18;
      my["max_qi"] += ob->query_skill("yijin-jing") * 19;
    }
    if (ob->query_skill_mapped("force") == "tiezhang-xinfa")  //----------铁掌心法
    {
      my["max_neili"] += ob->query_skill("tiezhang-xinfa") * 11;
      my["max_qi"] += ob->query_skill("tiezhang-xinfa") * 11;
    }
    if (ob->query_skill_mapped("force") == "guiyuan-tunafa")  //----------归元吐呐法
    {
      my["max_neili"] += ob->query_skill("guiyuan-tunafa") * 15;
      my["max_qi"] += ob->query_skill("guiyuan-tunafa") * 14;
    }
    if (ob->query_skill_mapped("force") == "hanbing-zhenqi")  //----------寒冰真气
    {
      my["max_neili"] += ob->query_skill("hanbing-zhenqi") * 14;
      my["max_qi"] += ob->query_skill("hanbing-zhenqi") * 13;
    }
    if (ob->query_skill_mapped("force") == "linji-zhuang")  //----------临济十二庄
    {
      my["max_neili"] += ob->query_skill("linji-zhuang") * 11;
      my["max_qi"] += ob->query_skill("linji-zhuang") * 12;
    }
    if (ob->query_skill_mapped("force") == "emei-jiuyang")  //----------峨眉九阳功
    {
      my["max_neili"] += ob->query_skill("emei-jiuyang") * 14;
      my["max_qi"] += ob->query_skill("emei-jiuyang") * 14;
    }

    if (ob->query_skill_mapped("force") == "hamagong")  //----------蛤蟆功
    {
      my["max_neili"] += ob->query_skill("hamagong") * 18;
      my["max_qi"] += ob->query_skill("hamagong") * 15;
    }
    if (ob->query_skill_mapped("force") == "huntian-qigong")  //----------混天气功
    {
      my["max_neili"] += ob->query_skill("huntian-qigong") * 15;
      my["max_qi"] += ob->query_skill("huntian-qigong") * 12;
    }
    if (ob->query_skill_mapped("force") == "yunu-xinjing")  //----------玉女心经
    {
      my["max_neili"] += ob->query_skill("yunu-xinjing") * 13;
      my["max_qi"] += ob->query_skill("yunu-xinjing") * 15;
    }
    if (ob->query_skill_mapped("force") == "xuantian-wuji")  //----------玄天无极
    {
      my["max_neili"] += ob->query_skill("xuantian-wuji") * 13;
      my["max_qi"] += ob->query_skill("xuantian-wuji") * 14;
    }
    if (ob->query_skill_mapped("force") == "shenghuo-shengong")  //----------圣火神功
    {
      my["max_neili"] += ob->query_skill("shenghuo-shengong") * 15;
      my["max_qi"] += ob->query_skill("shenghuo-shengong") * 12;
    }
    if (ob->query_skill_mapped("force") == "dulong-dafa")  //----------毒龙大法
    {
      my["max_neili"] += ob->query_skill("dulong-dafa") * 13;
      my["max_qi"] += ob->query_skill("dulong-dafa") * 15;
    }
    if (ob->query_skill_mapped("force") == "yinyun-ziqi")  //----------氤氲紫气
    {
      my["max_neili"] += ob->query_skill("yinyun-ziqi") * 16;
      my["max_qi"] += ob->query_skill("yinyun-ziqi") * 16;
    }
    if (ob->query_skill_mapped("force") == "longxiang-boruo")  //----------龙象功
    {
      my["max_neili"] += ob->query_skill("longxiang-boruo") * 19;
      my["max_qi"] += ob->query_skill("longxiang-boruo") * 18;
    }
    if (ob->query_skill_mapped("force") == "qiantian-yiyang")  //----------前天一阳
    {
      my["max_neili"] += ob->query_skill("qiantian-yiyang") * 14;
      my["max_qi"] += ob->query_skill("qiantian-yiyang") * 14;
    }
    if (ob->query_skill_mapped("force") == "kurong-changong")  //----------枯荣禅功
    {
      my["max_neili"] += ob->query_skill("kurong-changong") * 14;
      my["max_qi"] += ob->query_skill("kurong-changong") * 16;
    }
    if (ob->query_skill_mapped("force") == "xiantian-gong")  //----------先天功
    {
      my["max_neili"] += ob->query_skill("xiantian-gong") * 16;
      my["max_qi"] += ob->query_skill("xiantian-gong") * 20;
    }
    if (ob->query_skill_mapped("force") == "bihai-chaosheng")  //----------碧海超声
    {
      my["max_neili"] += ob->query_skill("bihai-chaosheng") * 16;
      my["max_qi"] += ob->query_skill("bihai-chaosheng") * 16;
    }
    if (ob->query_skill_mapped("force") == "huagong-dafa")  //----------化功大法
    {
      my["max_neili"] += ob->query_skill("huagong-dafa") * 14;
      my["max_qi"] += ob->query_skill("huagong-dafa") * 14;
    }
    if (ob->query_skill_mapped("force") == "shenzhao-jing")  //----------神照经
    {
      my["max_neili"] += ob->query_skill("shenzhao-jing") * 19;
      my["max_qi"] += ob->query_skill("shenzhao-jing") * 15;
    }
    if (ob->query_skill_mapped("force") == "hunyuan-yiqi")  //----------混元一气
    {
      my["max_neili"] += ob->query_skill("hunyuan-yiqi") * 14;
      my["max_qi"] += ob->query_skill("hunyuan-yiqi") * 14;
    }
    if (ob->query_skill_mapped("force") == "tianmogong")  //----------天魔攻
    {
      my["max_neili"] += ob->query_skill("tianmogong") * 13;
      my["max_qi"] += ob->query_skill("tianmogong") * 12;
    }
    if (ob->query_skill_mapped("force") == "huashan-neigong")  //----------华山内功
    {
      my["max_neili"] += ob->query_skill("huashan-neigong") * 12;
      my["max_qi"] += ob->query_skill("huashan-neigong") * 12;
    }
    if (ob->query_skill_mapped("force") == "zixia-gong")  //----------紫霞功
    {
      my["max_neili"] += ob->query_skill("zixia-gong") * 14;
      my["max_qi"] += ob->query_skill("zixia-gong") * 13;
    }
    if (ob->query_skill_mapped("force") == "ding-force")  //----------小丁气功
    {
      my["max_neili"] += ob->query_skill("ding-force") * 9;
      my["max_qi"] += ob->query_skill("ding-force") * 9;
    }
    if (ob->query_skill_mapped("force") == "shenyuan-gong")  //----------神元功
    {
      my["max_neili"] += ob->query_skill("shenyuan-gong") * 14;
      my["max_qi"] += ob->query_skill("shenyuan-gong") * 14;
    }
    if (ob->query_skill_mapped("force") == "beiming-shengong")  //----------北冥神功
    {
      my["max_neili"] += ob->query_skill("beiming-shengong") * 16;
      my["max_qi"] += ob->query_skill("beiming-shengong") * 15;
    }
    if (ob->query_skill_mapped("force") == "xiaowuxiang")  //----------小无相功
    {
      my["max_neili"] += ob->query_skill("xiaowuxiang") * 17;
      my["max_qi"] += ob->query_skill("xiaowuxiang") * 17;
    }

  }

  //catch("/feature/sadjust2"->skill_adjust(ob));

  //if (userp(ob)) catch("/feature/sadjust2"->skill_adjust(ob));
  my["neili"] = my["max_neili"];
  my["qi"] = my["max_qi"];
  ob->set_default_object(__FILE__);
}

mapping query_action() {
  return combat_action[random(sizeof(combat_action))];
}
