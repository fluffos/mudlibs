// due.c

inherit NPC;
inherit F_MASTER;

string ask_me();

void create()
{
        object ob;
        set_name("渡厄", ({ "du e", "e" }) );
        set("title", "少林长老");
        set("gender", "男性");
        set("class", "bonze");
        set("age", 90);
        set("long", "这是一个面颊深陷，瘦骨零丁的老僧，他脸色枯黄，如同一段枯木。\n");
        set("attitude", "peaceful");
        set("combat_exp",1600000);
        set("shen", 50000);
        set("str", 30);
        set("int", 25);
        set("dex", 28);
        set("con", 28);
        set("qi", 6000);
        set("max_qi",6000);
        set("max_jing", 3000);
        set("eff_jingli", 2500);
        set("neili",6000);
        set("max_neili",6000);
        set("jiali", 70);
        set("no_get", 1);
        set("unique", 1);
set("vendetta_mark", "lcc");
        create_family("少林派", 35, "弟子");
        assign_apprentice("弟子", 0);
        set_skill("force", 170);
        set_skill("whip", 170);
        set_skill("parry", 170);
        set_skill("dodge", 170);
        set_skill("buddhism", 170);
        set_skill("literate", 150);
        set_skill("yijin-jing", 170);
        set_skill("riyue-bian", 170);
        set_skill("shaolin-shenfa", 170);
        set_skill("hand",170);
        set_skill("fumoquan-zhen",170);
        set_skill("leg",170);
        set_skill("blade", 170);
        set_skill("xiuluo-dao", 170);
        set_skill("qianye-shou",170);
        set_skill("ruying-suixingtui",170);
        map_skill("force", "yijin-jing");
        map_skill("blade", "xiuluo-dao");
        map_skill("whip",  "riyue-bian");
        map_skill("parry", "xiuluo-dao");
        map_skill("dodge", "shaolin-shenfa");
        map_skill("hand","qianye-shou");
        map_skill("leg","ruying-suixingtui");
        prepare_skill("hand","qianye-shou");
        prepare_skill("leg","ruying-suixingtui");
        set("inquiry", ([
                "伏魔金铙"     : (: ask_me :),
        ]));
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action, "whip.chanrao" :),
                (: perform_action, "whip.fumoquan" :),
                (: perform_action, "hand.qianshou" :),
                (: perform_action, "leg.ruying" :),
        })); 
        setup();
        if (clonep()) {
                ob=unew(BINGQI_D("whip/heisuo"));
                if (!ob) ob = unew(BINGQI_D("changbian"));
                ob->move(this_object());
                ob->wield();
                carry_object("/d/shaolin/obj/du-cloth")->wear();
        }       
}

