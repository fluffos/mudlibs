// dujie.c
// Modify by Looklove for ask mmjs busy

inherit NPC;
inherit F_MASTER;

string ask_me();

void create()
{
        object ob;
        set_name("渡劫", ({ "du jie", "jie" }) );
        set("title", "少林长老");
        set("gender", "男性");
        set("age", 90);
        set("class", "bonze");
        set("long","这是一个面颊深陷，瘦骨零丁的老僧，他脸色惨白，象一张纸一样。\n");
        set("attitude", "peaceful");
        set("combat_exp",1700000);
        set("shen", 50000);
        set("str", 30);
        set("int", 25);
        set("dex", 28);
        set("con", 28);
        set("qi", 8500);
        set("max_qi",8500);
        set("max_jing", 3000);
        set("eff_jingli", 2500);
        set("neili",8500);
        set("max_neili",5500);
        set("jiali", 70);
        set("no_get", 1);
        set("unique", 1);
set("vendetta_mark", "lcc");
        create_family("少林派", 35, "弟子");
        assign_apprentice("弟子", 0);
        set_skill("force", 174);
        set_skill("whip", 174);
        set_skill("parry", 174);
        set_skill("dodge", 174);
        set_skill("claw",174);
        set_skill("finger", 174);
        set_skill("yijin-jing", 174);
        set_skill("riyue-bian", 174);
        set_skill("shaolin-shenfa", 174);
        set_skill("longzhua-gong",174);
        set_skill("fumoquan-zhen",174);
        set_skill("yizhi-chan",174);
        set_skill("buddhism", 174);
        set_skill("literate", 150);
        map_skill("force", "yijin-jing");
        map_skill("whip",  "riyue-bian");
        map_skill("parry", "riyue-bian");
        map_skill("dodge", "shaolin-shenfa");
        map_skill("finger","yizhi-chan");
        map_skill("claw","longzhua-gong");
        prepare_skill("claw", "longzhua-gong");
        prepare_skill("finger", "yizhi-chan");
        set("chat_chance_combat", 60);
        set("chat_msg_combat", ({
                (: perform_action, "whip.chanrao" :),
                (: perform_action, "whip.fumoquan" :),
                (: perform_action, "claw.canyun" :),
                (: perform_action, "finger.qiankun" :),
                (: perform_action, "finger.wofo" :),
        }));
        set("inquiry", ([
                "木棉袈裟"     : (: ask_me :),
        ]));
        setup();
        if (clonep()) {
                ob = unew(BINGQI_D("whip/heisuo"));
                if (!ob) ob = unew(BINGQI_D("changbian"));
                ob->move(this_object());
                ob->wield();
                carry_object("/d/shaolin/obj/du-cloth")->wear();
        }
}

