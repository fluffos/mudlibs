mixed hit_ob(object me, object ob, int damage_bonus)
{
	string msg;


	if(random(5)>1 && me->query("neili")<me->query("max_neili"))
         // if(random(5)>1)
	{
                    me->add("neili", 70);
                     msg = HIY "一股暖流发自丹田流向$N全身，$N只觉得全身真气流动，体内阳气已然充旺之极!\n"NOR;
                  // tell_object(me, HIY "\n一股暖流发自丹田流向全身，你只觉得全身真气流动，体内阳气已然充旺之极!\n\n" NOR);
            message_vision(msg, me, ob);
		
	}
}