// wuji1.c
inherit ITEM;

string* skills = ({
	"qianye-shou",//-----已修改
	"jingang-quan", //-----已修改
	"banruo-zhang", //-----已修改
	"wuxiang-zhi",//-----已修改
      "longzhua-gong",//-----已修改
	"nianhua-zhi", //-----已修改
	"yizhi-chan", //-----已修改
	"xiaohun-zhang",    //-----已修改
	"jiuyin-baiguzhua",//-----已修改
       "qishang-quan", //-----已修改
	"murong-daofa",//-----已修改
	"huashan-jianfa",  //-----已修改
	"canhe-zhi", //-----已修改
	"ranmu-daofa",//-----已修改
	"murong-jianfa",//-----已修改
	"dugu-jiujian",   //-----已修改
	"xuantie-jianfa",//-----已修改
	"dashou-yin", //-----已修改
	"xianglong-zhang", //-----已修改
	"tiezhang-zhangfa", //-----已修改
	"xuantie-jianfa",   //-----已修改
	"taiji-quan",   //-----已修改
	"taiji-jian",   //-----已修改       





});

void create()
{
	int i = random(sizeof(skills));
	string titles = to_chinese(skills[i]) + "谱";

	set_name(titles, ({  "wuji1" }));
	set_weight(200);
	set("unit", "册");
	set("long", "这是一册" + titles + "。\n");
	set("value", 500);
	set("material", "paper");
	set("shaolin", 1);
	set("skill", ([
		"name":	skills[i],	// name of the skill
		"exp_required":	10000,	// minimum combat experience required
		"jing_cost": 15+random(30),// jing cost every time study this
		"difficulty":	25,	// the base int to learn this skill
		"max_skill":	30	// the maximum level you can learn
	]) );
}
