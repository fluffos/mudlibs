#include <ansi.h>
inherit NPC;
inherit F_UNIQUE;
inherit F_SAVE;
mapping *names = ({
  ({ "大内高手",
  }),
});
string *skill = ({
  "longzhua-gong", "yizhi-chan", "jingang-quan",
  "qianye-shou", "sanhua-zhang", "xianglong-zhang",
  "yiyang-zhi", "tanzhi-shentong", "poyu-quan",
  "anran-zhang", "luoying-zhang", "hanbing-mianzhang",
  "nianhua-zhi", "qishang-quan", "kurong-changong",
});

string *force = ({
  "yijin-jing", "yijin-jing", "yijin-jing",
  "yijin-jing", "yijin-jing", "huntian-qigong",
  "qiantian-yiyang", "bihai-chaosheng", "zixia-gong",
  "yunu-xinjing", "bihai-chaosheng", "shenghuo-shengong",
  "yijin-jing", "shenghuo-shengong", "qiantian-yiyang",
});

string *perform = ({
  "jueji1", "jueji1", "jueji1",
  "jueji1", "sanhua", "jueji1",
  "jueji1", "shentong", "jueji1",
  "jueji1", "pikong", "not_xixue",
  "jueji1", "jueji1", "no_pfm",
});

string *base = ({
  "claw", "finger", "cuff",
  "hand", "strike", "strike",
  "finger", "finger", "cuff",
  "strike", "strike", "strike",
  "finger", "cuff", "finger",
});
void create() {
  string weapon, t_name;
  string s_skill, s_force, s_perform, s_base;
  int a;
  int index;
  a = 5 + random(5);
  index = random(sizeof(skill));
  s_skill = skill[index];
  s_force = force[index];
  s_perform = perform[index];
  s_base = base[index];
  t_name = names[0][random(sizeof(names[0]))];
  set_name(HIM "大内高手" NOR, ({ "gao", "nei" }));
  set("gender", "男性");
  set("age", random(10) + 45);
  set("str", 23 + random(10));
  set("int", 23 + random(10));
  set("con", 23 + random(10));
  set("dex", 23 + random(10));
  set("long", "邪教的护法。\n");
  set("combat_exp", 300000 + random(505000));
  set("attitude", "friendly");
  set("vendetta_mark", "lcc");
  set_skill("force", 40 + (10 * a));
  set_skill("sword", 40 + (10 * a));
  set_skill("dodge", 40 + (10 * a));
  set_skill("parry", 40 + (10 * a));
  set_skill("cuff", 40 + (10 * a));
  set_skill("blade", 40 + (10 * a));
  set_skill(s_base, 40 + (10 * a));
  set_skill(s_skill, 40 + (10 * a));
  set_skill(s_force, 40 + (10 * a));
  set_skill("tiyunzong", 40 + (10 * a));

  map_skill("force", s_force);
  map_skill("dodge", "tiyunzong");
  map_skill("parry", s_skill);
  map_skill(s_base, s_skill);
  prepare_skill(s_base, s_skill);

  set("max_qi", 500 + (250 * a));
  set("eff_jingli", 900);
  set("neili", 400 + (250 * a));
  set("max_neili", 400 + (250 * a));
  set("jiali", 70);

  set("chat_chance_combat", 20);
  set("chat_msg_combat", ({
    (: perform_action, s_base + "." + s_perform :)
  }));

  setup();



}



void die() {
  object ob, me, corpse;

  ob = this_object();
  me = query_temp("last_damage_from");

  if (me) {

    message_vision(WHT "$N「啪」的一声倒在地上，挣扎着抽动了几下就死了。\n" NOR, ob, me);
    message("vision", me->name() + "增加了3000经验和350潜能。\n\n", me);
    me->add("combat_exp", 3000);
    me->add("potential", 350);
    destruct(ob);

  }
  destruct(ob);
}
