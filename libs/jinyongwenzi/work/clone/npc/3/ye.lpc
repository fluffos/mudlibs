#include <ansi.h>
inherit NPC;
mapping *names = ({
  ({ "叶二娘",
  }),
});

void create() {
  string weapon, t_name;
  int a;
  a = 9;
  t_name = names[0][random(sizeof(names[0]))];
  set_name(t_name, ({ "ye" }));
  set("gender", "女性");
  set("age", random(10) + 45);
  set("str", 23 + random(10));
  set("int", 23 + random(10));
  set("con", 23 + random(10));
  set("dex", 23 + random(10));
  set("long", "邪教的杀手。\n");
  set("combat_exp", 60000 + random(25000));
  set("attitude", "friendly");
  set("vendetta_mark", "lcc");
  set_skill("force", 40 + (10 * a));
  set_skill("sword", 40 + (10 * a));
  set_skill("dodge", 40 + (10 * a));
  set_skill("parry", 40 + (10 * a));
  set_skill("cuff", 40 + (10 * a));
  set_skill("blade", 40 + (10 * a));
  set_skill("taizu-quan", 40 + (10 * a));
  set_skill("xunlei-jian", 40 + (10 * a));
  set_skill("shandian-daofa", 40 + (10 * a));
  set_skill("tiyunzong", 40 + (10 * a));
  set_skill("qiantian-yiyang", 40 + (10 * a));
  map_skill("dodge", "tiyunzong");
  map_skill("sword", "xunlei-jian");
  map_skill("blade", "shandian-daofa");
  map_skill("parry", "xunlei-jian");
  map_skill("cuff", "taizu-quan");
  map_skill("force", "qiantian-yiyang");
  prepare_skill("cuff", "taizu-quan");

  set("max_qi", 500 + (150 * a));
  set("eff_jingli", 300);
  set("neili", 500 + (150 * a));
  set("max_neili", 500 + (150 * a));
  set("jiali", 80);

  weapon = random(2) ? "/clone/weapon/changjian" : "/clone/weapon/blade";
  setup();
  carry_object(weapon)->wield();
  carry_object("/d/city/obj/junfu")->wear();
}

void die() {
  object ob, me, corpse;

  ob = this_object();
  me = query_temp("last_damage_from");

  if (me) {
    message_vision(WHT "$N「啪」的一声倒在地上，挣扎着抽动了几下就死了。\n" NOR, ob, me);
    message("vision", me->name() + "增加了2000经验和150潜能。\n\n", me);
    me->add("combat_exp", 2000);
    me->add("potential", 150);
    destruct(ob);

  }
  destruct(ob);
}
