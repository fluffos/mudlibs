// guairen.c 欧阳锋
// by snowman 12/02/98

#include <ansi.h>
inherit NPC;
void create() {
  set_name("欧阳峰", ({ "feng", "ou", "ouyang" }));
  set("title", BLU "西毒" NOR);
  set("gender", "男性");
  set("shen_type", -1);
  set("age", 60);
  set("str", 40);
  set("con", 40);
  set("int", 40);
  set("dex", 40);
  set("long", "一位用头支在地上，双脚并拢，撑向天空的怪人。
看上去疯疯癫癫的。但见他高鼻深目，满脸雪白短
须，根根似铁，又听他喃喃自语，说著叽哩咕噜的
怪话，极是难听。\n");
  set("combat_exp", 2400000);
  set("attitude", "heroism");
  set("max_qi", 8000);
  set("max_jing", 6000);
  set("eff_jingli", 4000);
  set("jiali", 100);
  set("oyf/hamagong", 2);
  set("vendetta_mark", "lcc");
  set_skill("force", 200);
  set_skill("hamagong", 200);
  set_skill("literate", 150);
  set_skill("poison", 200);
  set_skill("dodge", 200);
  set_skill("parry", 200);
  set_skill("strike", 200);
  set_skill("hamabu", 200);
  set_skill("staff", 200);
  set_skill("baituo-shezhang", 200);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "strike.hama" :),
    (: perform_action, "staff.chuo" :),
    (: exert_function, "nizhuan" :),
  }));
  map_skill("dodge", "hamabu");
  map_skill("force", "hamagong");
  map_skill("parry", "hamagong");
  map_skill("strike", "hamagong");
  map_skill("staff", "baituo-shezhang");
  prepare_skill("strike", "hamagong");
  set("inquiry", ([
    "欧阳锋": "欧阳锋、欧阳锋，听起来这名字挺熟的。。。\n",
    "洪七公": "洪七公，这名字也熟。\n",
    "蛤蟆功": "蛤蟆、蛤蟆、蛤蟆。。。\n",
    "name": "我…我是谁？我知道我是谁就好啦。\n",
  ]));
  setup();

  carry_object(BINGQI_D("gangzhang"))->wield();
  carry_object(ARMOR_D("cloth"))->wear();
  add_money("silver", 10);
}

void kill_ob(object me) {
  command("stare");
  //  command("yun nizhuan") ;
  ::kill_ob(me);
}
