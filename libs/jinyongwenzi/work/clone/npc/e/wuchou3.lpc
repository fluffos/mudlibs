// wuchou-3.c 三丑
// by iceland

#include <ansi.h>
inherit NPC;

void create()
{
	set_name(HIY"三丑"NOR, ({"san chou","sanchou","chou","san"}));
	set("long",
"他是藏边五丑中的老三，功夫不高，坏事做了不少。\n"
"他是大轮寺达尔巴的弟子。\n"
	);

        set("title",  "大轮寺第十四代弟子" );
	set("gender", "男性");
	set("attitude", "heroism");
	set("class", "huanxi");
set("vendetta_mark", "lcc");
	set("age", 26);
	set("shen_type", -1);
	set("str", 20);
	set("int", 15);
	set("con", 20);
	set("dex", 20);
	set("max_qi", 800);
	set("eff_jing", 800);
	set("max_jing",200);
	set("neili", 700);
	set("max_neili", 700);
	set("jiali", 50);
	set("combat_exp", 411000);
	set("score", 5000);
	set("unique", 1);

	set_skill("force", 55);
	set_skill("longxiang-boruo", 55);
	set_skill("dodge", 55);
	set_skill("yuxue-dunxing", 55);
	set_skill("staff", 55);
	set_skill("wushang-dali", 55);
	set_skill("parry", 55);
	set_skill("huanxi-chan", 55);
	set_skill("literate", 50);

	map_skill("force", "longxiang-boruo");
	map_skill("dodge", "yuxue-dunxing");
	map_skill("staff", "wushang-dali");
	map_skill("parry", "wushang-dali");

	create_family("大轮寺", 14, "弟子");
        set("chat_chance", 2);
        set("chat_msg", ({
"三丑伸手在头上、身上不停的乱搔，鼻中哼着小调。\n",
        }) );
	setup();

        carry_object(ARMOR_D("pijia"))->wear();
        carry_object(BINGQI_D("jingangzuan"))->wield();

        add_money("silver",20); 
}
void die()
{
        object ob, me, corpse;
        
        ob = this_object();
        me = query_temp("last_damage_from");
        
if (me)
{
        message_vision(WHT"$N「啪」的一声倒在地上，挣扎着抽动了几下就死了。\n"NOR,ob,me);
        message("vision", me->name() + "增加了3000经验和350潜能。\n\n", me);
        me->add("combat_exp",3000);
        me->add("potential",350);
        destruct(ob);
        
}
destruct(ob);
}

