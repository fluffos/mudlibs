// wuchou-4.c 四丑
// by iceland

#include <ansi.h>
inherit NPC;

void create() {
  set_name(HIY "四丑" NOR, ({ "si chou", "sichou", "chou", "si" }));
  set("long",
    "他是藏边五丑中的老四，功夫不高，坏事做了不少。\n"
    "他是大轮寺达尔巴的弟子。\n"
  );

  set("title", "大轮寺第十四代弟子");
  set("gender", "男性");
  set("attitude", "heroism");
  set("class", "huanxi");
  set("vendetta_mark", "lcc");
  set("age", 26);
  set("shen_type", -1);
  set("str", 20);
  set("int", 15);
  set("con", 20);
  set("dex", 20);
  set("max_qi", 600);
  set("eff_jing", 600);
  set("max_jing", 600);
  set("neili", 600);
  set("max_neili", 600);
  set("jiali", 30);
  set("combat_exp", 310500);
  set("score", 5000);
  set("unique", 1);

  set_skill("force", 45);
  set_skill("longxiang-boruo", 45);
  set_skill("dodge", 45);
  set_skill("yuxue-dunxing", 45);
  set_skill("staff", 45);
  set_skill("wushang-dali", 45);
  set_skill("parry", 45);
  set_skill("huanxi-chan", 45);
  set_skill("literate", 40);

  map_skill("force", "longxiang-boruo");
  map_skill("dodge", "yuxue-dunxing");
  map_skill("staff", "wushang-dali");
  map_skill("parry", "wushang-dali");

  create_family("大轮寺", 14, "弟子");
  set("chat_msg", ({
    "四丑高声叫道：“手头没什么银子了，去山下路口做几票吧。”\n",
  }));

  setup();

  carry_object(ARMOR_D("pijia"))->wear();
  carry_object(BINGQI_D("jingangzuan"))->wield();

  add_money("silver", 10);
}
void die() {
  object ob, me, corpse;

  ob = this_object();
  me = query_temp("last_damage_from");

  if (me) {
    message_vision(WHT "$N「啪」的一声倒在地上，挣扎着抽动了几下就死了。\n" NOR, ob, me);
    message("vision", me->name() + "增加了3000经验和350潜能。\n\n", me);
    me->add("combat_exp", 3000);
    me->add("potential", 350);
    destruct(ob);

  }
  destruct(ob);
}
