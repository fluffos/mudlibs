// wuchou-2.c 二丑
// by iceland

#include <ansi.h>
inherit NPC;

void create() {
  set_name(HIY "二丑" NOR, ({ "er chou", "erchou", "chou", "er" }));
  set("long",
    "他是藏边五丑中的老二，功夫不高，坏事做了不少。\n"
    "他是大轮寺达尔巴的弟子。\n"
  );

  set("title", "大轮寺第十四代弟子");
  set("gender", "男性");
  set("attitude", "heroism");
  set("class", "huanxi");
  set("vendetta_mark", "lcc");
  set("age", 26);
  set("shen_type", -1);
  set("str", 20);
  set("int", 15);
  set("con", 20);
  set("dex", 20);
  set("max_qi", 900);
  set("eff_jing", 800);
  set("max_jing", 800);
  set("neili", 800);
  set("max_neili", 800);
  set("jiali", 60);
  set("combat_exp", 611500);
  set("score", 5000);
  set("unique", 2);

  set_skill("force", 65);
  set_skill("longxiang-boruo", 65);
  set_skill("dodge", 65);
  set_skill("yuxue-dunxing", 65);
  set_skill("blade", 65);
  set_skill("xuedao-jing", 65);
  set_skill("parry", 65);
  set_skill("huanxi-chan", 65);
  set_skill("literate", 20);

  map_skill("force", "longxiang-boruo");
  map_skill("dodge", "yuxue-dunxing");
  map_skill("blade", "xuedao-jing");
  map_skill("parry", "xuedao-jing");

  create_family("大轮寺", 14, "弟子");
  set("chat_chance", 1);
  set("chat_msg", ({
    "二丑无聊的道：“唉，你们说的都干过好多次了，想点新鲜的出来吧。”\n",
  }));

  setup();

  carry_object(ARMOR_D("pijia"))->wear();
  carry_object(BINGQI_D("xinyuedao"))->wield();

  add_money("silver", 20);
}
void die() {
  object ob, me, corpse;

  ob = this_object();
  me = query_temp("last_damage_from");

  if (me) {
    message_vision(WHT "$N「啪」的一声倒在地上，挣扎着抽动了几下就死了。\n" NOR, ob, me);
    message("vision", me->name() + "增加了3000经验和350潜能。\n\n", me);
    me->add("combat_exp", 3000);
    me->add("potential", 350);
    destruct(ob);

  }
  destruct(ob);
}
