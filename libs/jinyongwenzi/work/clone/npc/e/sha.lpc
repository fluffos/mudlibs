// shatongtian.c 沙通天
#include <ansi.h>
inherit NPC;
 
void create()
{
	set_name(MAG"沙通天"NOR, ({ "shatong tian", "sha" }));
	set("nickname", "鬼门龙王");
	set("long", 
        "他就是黄河四鬼的杀通天。\n"
        "满脸横肉，眼睛里冒这凶光。\n");
	set("gender", "男性");
	set("age", 36);
	set("attitude", "peaceful");
	set("shen_type", -1);
	set("str", 35);
	set("int", 30);
	set("con", 25);
	set("dex", 27);
set("vendetta_mark", "lcc");	
	set("max_qi", 2000);
	set("max_jing", 800);
	set("neili", 2500);
	set("max_neili", 2500);
	set("jiali", 50);
	set("combat_exp", 550000);
	set("score", 100000);

    set_skill("force", 100);
    set_skill("hunyuan-yiqi", 100);
    set_skill("dodge", 100);

    set_skill("shaolin-shenfa", 100);
    set_skill("cuff", 100);
    set_skill("damo-jian", 100);
    set_skill("parry", 100);
    set_skill("sword", 100);
    set_skill("poyu-quan", 80);
    set_skill("literate", 10);

	map_skill("force", "hunyuan-yiqi");
    map_skill("dodge", "shaolin-shnfa");
    map_skill("cuff", "poyu-quan");
  	map_skill("parry", "damo-jian");
  	map_skill("sword", "damo-jian");
       prepare_skill("cuff", "poyu-quan");
 
        setup(); 
        carry_object("/clone/misc/cloth")->wear();
  	carry_object("/clone/weapon/changjian")->wield();
        add_money("gold", 7);
}
void die()
{
        object ob, me, corpse;
        
        ob = this_object();
        me = query_temp("last_damage_from");
        
if (me)
{
        message_vision(WHT"$N「啪」的一声倒在地上，挣扎着抽动了几下就死了。\n"NOR,ob,me);
        message("vision", me->name() + "增加了3000经验和350潜能。\n\n", me);
        me->add("combat_exp",3000);
        me->add("potential",350);
        destruct(ob);
        
}
destruct(ob);
}
