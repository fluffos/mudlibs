#include <ansi.h>
inherit NPC;
mapping *names = ({
  ({ "海砂帮弟子", "巨鲸帮弟子", "三江帮弟子", "神拳门弟子", "斧头帮弟子", "青龙帮弟子", "斧头帮弟子", "黑道杀手", "斧头帮弟子",
    "长乐帮弟子", "独行大盗",
  }),
});

void create() {
  string weapon, t_name;
  int a;
  a = random(2);
  t_name = names[0][random(sizeof(names[0]))];
  set_name(t_name, ({ "dizi" }));
  set("gender", "男性");
  set("age", random(10) + 45);
  set("str", 28);
  set("con", 23);
  set("int", 15);
  set("dex", 20);
  set("long", "邪教的弟子。\n");
  set("combat_exp", 60000 + random(25000));
  set("attitude", "friendly");
  set("vendetta_mark", "lcc");
  set_skill("force", 40 + (10 * a));
  set_skill("sword", 40 + (10 * a));
  set_skill("dodge", 40 + (10 * a));
  set_skill("parry", 40 + (10 * a));
  set_skill("cuff", 40 + (10 * a));
  set_skill("blade", 40 + (10 * a));
  set_skill("taizu-quan", 50);
  set_skill("qingmang-jian", 50);
  map_skill("dodge", "qingmang-jian");
  map_skill("sword", "qingmang-jian");
  map_skill("parry", "qingmang-jian");
  map_skill("cuff", "taizu-quan");
  prepare_skill("cuff", "taizu-quan");

  set("max_qi", 300);
  set("eff_jingli", 300);
  set("neili", 300 + (50 * a));
  set("max_neili", 300 + (50 * a));
  set("jiali", 20);

  weapon = random(2) ? "/clone/weapon/changjian" : "/clone/weapon/blade";
  setup();
  //   carry_object(weapon)->wield();
  carry_object("/d/city/obj/junfu")->wear();
}



void die() {
  object ob, me, corpse;

  ob = this_object();
  me = query_temp("last_damage_from");

  if (me) {
    message_vision(WHT "$N「啪」的一声倒在地上，挣扎着抽动了几下就死了。\n" NOR, ob, me);
    message("vision", me->name() + "增加了1500经验和150潜能。\n\n", me);
    me->add("combat_exp", 1500);
    me->add("potential", 150);
    destruct(ob);

  }
  destruct(ob);
}
