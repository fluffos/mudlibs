#include <ansi.h>
inherit NPC;

string *nm1_jp =({
"山本","龟田","姿三","大岛","松下","横田","东芝","候本","川野","山口",
"铃木","岗仓","小岛","井上","安奈","浅田","佐藤","广末","大竹","大村",
"伯佐","富冈","东乡",
});

string *id_jp =({
"shanben","guitian","zisan","dadao","songxia","hengtian","dongzhi","houben","chuangye","shankou",
"lingmu","gangcang","xiaodao","jinshang","annai","qiantian","zuoteng","guangmu","dazhu","dachun",
"bozuo","fugang","dongxiang",
});    
    
string *nm2_jp =({
"太郎","次郎","三郎","四郎","五郎","十一郎","十四郎","二十六","俊树",
"宁次","英机","冶字","俊雄","牧夫","光夫","敬一","英世","漱石","渝吉",
"一叶","子规","稻造","伊冲","松园","深水","大观","丰国","孝和","茂",
"川","卫","岛寿","光云","安治","山乐","梦二",
});
          
void create()
{
      string weapon,t_name;
   int i = random(sizeof(nm1_jp));
    set_name(nm1_jp[i]+nm2_jp[random(sizeof(nm2_jp))], ({id_jp[i]}));
        set("gender", "男性");
        set("age", random(10) + 45);
        set("str", 28);
        set("con", 23);
        set("int", 15);
        set("dex", 20);
        set("long", "邪教的杀手。\n");
        set("combat_exp", 600000 + random(25000)); 
        set("attitude", "friendly");
set("vendetta_mark", "lcc");
        set_skill("force", 140);
        set_skill("sword", 140);
        set_skill("dodge", 140);
        set_skill("parry", 140);
        set_skill("cuff", 140);
        set_skill("blade", 140);
        set_skill("taizu-quan", 150);
        set_skill("qingmang-jian", 150);
        set_skill("wind-blade", 145);
        map_skill("dodge", "qingmang-jian");
        map_skill("sword", "qingmang-jian");
        map_skill("blade", "wind-blade");
        map_skill("parry", "wind-blade");
        map_skill("cuff", "taizu-quan");
        prepare_skill("cuff", "taizu-quan");
         set("qi", 2300);
        set("max_qi", 2300); 
        set("eff_jingli", 1300); 
        set("neili", 1300); 
        set("max_neili", 1300);
        set("jiali", 70);

        
        setup();
        carry_object(__DIR__"obj/japanblade")->wield();
        carry_object("/d/city/obj/junfu")->wear();
}

void die()
{
        object ob, me, corpse;
        
        ob = this_object();
        me = query_temp("last_damage_from");
        
if (me)
{
        message_vision(WHT"$N「啪」的一声倒在地上，挣扎着抽动了几下就死了。\n"NOR,ob,me);
        message("vision", me->name() + "增加了2000经验和150潜能。\n\n", me);
        me->add("combat_exp",2000);
        me->add("potential",150);
        destruct(ob);
        
}
destruct(ob);
}
