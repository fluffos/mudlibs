// File:       /std/user/refs.c
// Mudlib:     Nightmare
// Purpose:    To store refs in (See _refs)
// Author:     Douglas Reay (Pallando @ TMI, Nightmare, etc)
// Date V1.0:  93-06-05

nosave mapping refs;

void set_refs(mapping a) { refs = (mapp(a) ? a : ([])); }

mapping get_refs() { return (refs ? copy(refs) : ([])); }

/* "ref" renamed to "refname" -- reserved word on this driver, see
   AGENTS.md / std/user/refs.lpc's own note. */
void set_ref(string refname, mixed value) {
  if (!refs) refs = ([]);
  if (!refname) refname = "default";
  if (undefinedp(value))
    map_delete(refs, refname);
  else
    refs[refname] = value;
}

mixed get_ref(string refname) {
  if (!refs) refs = ([]);
  if (!refname) refname = "default";
  return refs[refname];
}
