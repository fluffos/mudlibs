#include "/d/shadow/mon/melnmarn.h"
#include "../tormdefs.h"
#include <std.h>
inherit ROOM;

void create() {
  ::create();
    set_properties((["light":2, "indoors":1]));
    set_short("Gilles' clothing rack storage area");
    set("long", "Only supplies and such here.\n");
    set_property("no teleport",1);
    set_exits( (["up" : TCITY+"c60"]) );
}

void reset() {

::reset();
  if(!present("sailors trousers")) new(OBJ+"pantsc.lpc")->move(TO);
  if(!present("leather pants")) new(OBJ+"pantsl.lpc")->move(TO);
  if(!present("pantaloons")) new(OBJ+"pantsp.lpc")->move(TO);
  if(!present("black silk shirt")) new(OBJ+"silkshirtb.lpc")->move(TO);
  if(!present("white silk shirt")) new(OBJ+"silkshirtw.lpc")->move(TO);
  if(!present("green silk shirt")) new(OBJ+"silkshirtg.lpc")->move(TO);
  if(!present("red silk shirt")) new(OBJ+"silkshirtr.lpc")->move(TO);
   if(!present("blue silk shirt")) new(OBJ+"silkshirtbb.lpc")->move(TO);
   if(!present("silk dress")) new(OBJ+"silkdress.lpc")->move(TO);
   if(!present("red silk sash")) new(OBJ+"silksash.lpc")->move(TO);
   if(!present("blue silk sash")) new(OBJ+"bluesash.lpc")->move(TO);
  if(!present("boots")) new(OBJ+"rboots.lpc")->move(TO);
  if(!present("sandal")) new(OBJ+"sandal.lpc")->move(TO);
  if(!present("hose")) new(OBJ+"hose.lpc")->move(TO);
  if(!present("gloves")) new(OBJ+"gloves.lpc")->move(TO);
   if(!present("perfume")) new(OBJ+"perfume")->move(TO);
}

