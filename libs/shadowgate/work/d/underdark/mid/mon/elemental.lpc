#include <std.h>
#include "../../defs.h"
inherit "/d/magic/mon/priest_eelemental.lpc";

int my_following;

void create(){
   ::create();
}

void init(){
   object ob;
   ::init();
   if(!my_following) {
     if(ob = present("svirfneblin priest",ETO)) {
       ob->add_follower(TO);
       ob->add_protector(TO);
       my_following = 1;
     }
   }
}
