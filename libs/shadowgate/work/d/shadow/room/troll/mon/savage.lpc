#include <std.h>
inherit "/d/shadow/room/troll/mon/troll.lpc";

// the values troll.lpc's set_em_up() reads: as redeclared globals they were a second set of
// variables that troll.lpc never saw (every troll came out as a blank "Troll ")
void create() {


    LONG = "Similar to the Troll grunt, but lacking the finer common "
	"tongue that other trolls manage to obtain, the Troll savages are "
	"ruthless, bloodletting killers. Their skin is permanently stained from "
	"their victims blood, and their thick, unruly hair is matted and bug "
	"infested. The only positive side to the Troll savages is the fact you "
	"can smell them a mile away and therefore surprise is never on their side. "
	"They speak in a gutteral ancient language and seem totally oblivious to the "
	"fact that no one can understanbd them.";
	
    TYPE = "savage";

    POWER = 2;

    MYDIEA = "Sagroo, mak dek runduk crab pammplemouse!";
    MYDIEB = "Derty lak me biktch dun sefren scint!";
    MYDIEC = "Ren ren se fa magog bumrin!";

    TROLLGREET = "Notokka begen wan sirfif?!?";
    HUMANGREETA = "Wudwin suk refeg agro demis!";
    HUMANGREETB = "T'zzarg! Wegin win sufkio lak teryio!";
    HUMANGREETC = "Ruk ruk ruk!";

    EMOTEA = "Noitcerid ecaf ot ffats nrut!";
    EMOTEB = "Sdrawkcab dear uoy nac!";
    EMOTEC = "Wodahs s'oirt eht ni seil ffats dnoces!!!";
    ::create();
}
