#include <std.h>
inherit "/d/shadow/room/troll/mon/troll.lpc";

// the values troll.lpc's set_em_up() reads: as redeclared globals they were a second set of
// variables that troll.lpc never saw (every troll came out as a blank "Troll ")
void create() {


    LONG = "The slimy, smelly Troll grunt looks disgruntled at your "
	   "presence in its domain. The Troll grunt is the lowest "
	   "form of the military types and is usually recruited "
	   "from the heartier of the Troll miners. However, they "
	   "are quick to learn combat form, despite their blatant "
	   "lack of intelligence. They are also famous for their "
	   "ability to butcher the common Shadowgate language into "
	   "a state worse than child-like gibbering nonsense.";

    TYPE = "grunt";

    POWER = 2;

    MYDIEA = "I be not big war troll now I see!";
    MYDIEB = "Bah, stupid armor make me not hit puny mortal!";
    MYDIEC = "BAROOO!!! That hurt poor Troll bad!";

    TROLLGREET = "Welcome fellow warrior of the slime! Have you come seeking shiny stones?";
    HUMANGREETA = "Me hopes you not move rund here, make land be cheap!";
    HUMANGREETB = "Greets pale face...Troll think you gross and smelly.";
    HUMANGREETC = "Hrm, Troll not trust you type...maybe you be gone now!";

    EMOTEA = "Sumday I make big war on sun races!";
    EMOTEB = "We git poretty wepons from shiners!";
    EMOTEC = "Sumtime I be alone...need special Troll friend...like you!";
    ::create();
}
