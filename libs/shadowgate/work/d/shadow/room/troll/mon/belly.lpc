#include <std.h>
inherit "/d/shadow/room/troll/mon/troll.lpc";

// the values troll.lpc's set_em_up() reads: as redeclared globals they were a second set of
// variables that troll.lpc never saw (every troll came out as a blank "Troll ")
void create() {


    LONG = "Oh how they love to eat, the poor mistreated Troll pot"
	"belly. More blubber than brains, more rolls than brawn, "
	"they make terrible warriors and excellent cooks. They were once "
 	"used primarily as chefs for the troll kingdom, but the trolls were "
	"all slowly turning into Troll potbelly...so of course this had to end. "
	"Now regular trolls shun and avoid contact with their lazy, glutton-crazed "
	"cousins, fearful of falling into the ways of decadence and debauchery.";
	
    TYPE = "potbelly";

    POWER = 1;

    MYDIEA = "No more cake for me!";
    MYDIEB = "Please cook my corpse...it would be soooo tasty!";
    MYDIEC = "And all I wanted was a good meal!";

    TROLLGREET = "Are you hungry friend?";
    HUMANGREETA = "FEED ME! I am SOOOOO hungry!";
    HUMANGREETB = "Got any extra dinner rolls?!?";
    HUMANGREETC = "Smack! You look tasty like a lamb steak!";

    EMOTEA = "Was that you growling or my stomach?";
    EMOTEB = "Is it dinner time yet cause I need a pie! MEAT PIE!";
    EMOTEC = "They never feed me well enough...I am losing my looch!";
    ::create();
}
