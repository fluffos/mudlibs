#include <std.h>
inherit "/d/shadow/room/troll/mon/troll.lpc";

// the values troll.lpc's set_em_up() reads: as redeclared globals they were a second set of
// variables that troll.lpc never saw (every troll came out as a blank "Troll ")
void create() {


    LONG = "Perhaps one of the most dangerous and most brain dead "
	"of all the troll types is the seventeen foot tall Giant trolls. "
	"Their obvious lack of cunning in battle is made up from their sheer "
	"massive size and they are reknown for their love of barbaric "
	"combat style and elf abuse. The greatest of the Troll giants known "
	"as 'Grun' is responsible for the kidnapping and untimely death "
	"of Lady Mirion of Knotbur. Worse still, he sent her decapitated "
	"head to her family by courier, and as luck would have it...it arrived "
	"during her younger sister's birthday feast.";
	
    TYPE = "giant";

    POWER = 4;

    MYDIEA = "Dun da...dun da...dun da...I be DUN DA!";
    MYDIEB = "ARGH, me no want play wit you no more!";
    MYDIEC = "Giant fall down go boom!";

    TROLLGREET = "Ug small one! You like Grun bog yes?!?";
    HUMANGREETA = "Not bug Grun...me squash puny one like fly!";
    HUMANGREETB = "I think kill you and mail your ear to mother!";
    HUMANGREETC = "Oh goodie! Dinner has come for me!";

    EMOTEA = "I am so big and stoopid it not funny!";
    EMOTEB = "More body, less brain...make big and good killin troll!";
    EMOTEC = "Have you any pretty gems for me?";
    ::create();
}
