#include <std.h>
inherit "/d/shadow/room/troll/mon/troll.lpc";

// the values troll.lpc's set_em_up() reads: as redeclared globals they were a second set of
// variables that troll.lpc never saw (every troll came out as a blank "Troll ")
void create() {


    LONG = "The Troll soldier is trained well in the ways of war and "
	"battle. A bloody aggressive creature, they know little mercy towards "
	"their foes. Bred as cannon fodder in the greater Troll movement, they "
	"also are used as guards within the various Troll camps and outposts "
	"throughout the lands...for they are completly expendable.";

    TYPE = "soldier";

    POWER = 3;

    MYDIEA = "I hope you don't think your a hero now.";
    MYDIEB = "You have me dead now, but Trollkin smash you soon!";
    MYDIEC = "We die before we work for you scum!";

    TROLLGREET = "Well met, like kind one we be allies no?";
    HUMANGREETA = "Me thinks I best to claw yer eyes out!";
    HUMANGREETB = "GAR! I not like the looks of you!";
    HUMANGREETC = "You might make me good dinner yes!";

    EMOTEA = "I will fight you all at same time with hands tied!";
    EMOTEB = "If you hurt troll, troll heal fast!";
    EMOTEC = "I like to kill things! ;)";
    ::create();
}
