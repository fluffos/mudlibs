// File:       /std/user/refs.c
// Mudlib:     Nightmare
// Purpose:    To store refs in (See _refs)
// Author:     Douglas Reay (Pallando @ TMI, Nightmare, etc)
// Date V1.0:  93-06-05

nosave mapping refs;

void set_refs(mapping a) {
  refs = (mapp(a) ? a : ([]));
}

mapping get_refs() {
  return (refs ? copy(refs) : ([]));
}

/* Parameter renamed ref -> refname: this project's shared driver build
   hardcodes REF_RESERVED_WORD (src/base/internal/options_internal.h),
   making the bare identifier "ref" a reserved keyword regardless of this
   archive's own local_options.example (#undef REF_RESERVED_WORD -- never
   consulted, since this project boots every lib against one prebuilt
   driver rather than rebuilding per-lib). Using "ref" as a plain
   variable/parameter name is a hard syntax error here. This file is
   inherited into /std/user via /adm/include/user.h, so this alone broke
   compilation of the entire player body class -- see AGENTS.md. */
void set_ref(string refname, mixed value) {
  if (!refs) {
    refs = ([]);
  }
  if (!refname) {
    refname = "default";
  }
  if (undefinedp(value)) {
    map_delete(refs, refname);
  } else {
    refs[refname] = value;
  }
}

mixed get_ref(string refname) {
  if (!refs) {
    refs = ([]);
  }
  if (!refname) {
    refname = "default";
  }
  return refs[refname];
}
