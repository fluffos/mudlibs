inherit "std/armour";

// This ring also inherited "std/artifact", a second OBJECT next to armour's, so every Object variable
// existed twice.  The artifact members it used are carried here (std/artifact.lpc has no other user).
int house_value;

void create()   {
  armour::create();
  set_name("ring of gandalf");
  set_short("Gandalf's Ring");
  set_id(({"ring","ring of gandalf"}));
  set_long("This is Gandalf's lost ring.");
  set_weight(10);
  set_value(2000);
  set_point_value(3);
}

void init()   {  armour::init();   }

int is_artifact()   {   return 1;    }

void set_point_value(int x)    {   house_value = x;   }

int query_point_value()   {
  if(!house_value) return 1;
    else return house_value;
}
