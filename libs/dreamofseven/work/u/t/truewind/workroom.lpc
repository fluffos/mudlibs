// Room: /u/t/truewind/workroom.c

#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
	set("short", "[1;37m思過崖[0m");
	set("long", @LONG
此處是華山上一處終年飄雪的斷崖，取名思過崖乃因人跡罕至，
寒冷僻靜，專用來供人反省思過之用。而觸目所及盡是白皚皚的景象
，周圍被山壁環抱，只有一條小路可通。偶而會有野生動物經過。在
附近有一處小山洞(cave)。
LONG
	);
	set("objects", ([ 
	__DIR__"npc/fox":1 ,
	__DIR__"npc/Tsiping":1 ,
]));
	set("item_desc", ([
        "cave" : "一個山洞，可以試著進入(enter)看看。\n",   
        ]));
	set("exits", ([ /* sizeof() == 2 */
  "enter" : __DIR__"cave",
  "south" : __DIR__"workroom1",
  "west" : "/u/t/truewind/newarea/1/ra",
  
]));
	call_other("/obj/board/truewind_b.lpc", "???");
	set("valid_startroom", 1);
	set("no_clean_up", 0);
	set("outdoors", "land");
	set("current_light", 1);	    
	setup();
}
int room_effect(object me)
{
        switch(random(6))
        {
                
         case 3:        message_vision("～呼～呼～!!　$N被一陣陣的寒風刮的直打顫。\n",me);
                        me->receive_damage("hp",random(10)+1);
                        return 1;
         case 2:
         case 1:        tell_object(me,"幾片"HIW" ＊ ＊雪花 ＊ ＊"NOR"飄落下來～。\n");
                        return 1;
         case 0:
         default:       return 1;
        }
}
