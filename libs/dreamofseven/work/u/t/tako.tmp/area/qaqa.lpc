#include <ansi.h>
inherit NPC; 
void create()
{
       set_name(MAG"忍者"NOR, ({ "ling jia","jia" }) );
        set("long","東洋忍術的高手。\n");
        set("level",40);
        set("age",45);

        set("combat_exp", 20000); 
        set("chat_chance",10);  
        set("combat_msg", ({
"$N用出東洋忍術中的 "HIC"土遁"NOR" ,$N忽然鑽到地下,$n停頓了幾秒\n"
"$N悄悄的從地底爬出來,        set("chat_msg",({
            "布丁說:老公出去送貨怎麼還沒回來呢..^^....\n",
        }) );                               
        set_skill("combat", 100);
        set_skill("parry", 100);
        set_skill("unarmed", 100);
        set_skill("dodge", 100);
         
        setup();
        }



