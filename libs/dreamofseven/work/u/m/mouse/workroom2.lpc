#include <ansi.h>
inherit ROOM;

void create()
{
    set("short", "草地");
    set("long", "\n\n\n\n");
    set("light",1);
    set("exits", ([ /* sizeof() == 1 */
        "east"   : __DIR__"workroom",
    ]));
    set("outdoors","land");
    setup();
}

int valid_leave(object me, string dir)
{
    if( dir=="east" && !userp(me) ) return notify_fail("禁止通過。\n");
    return ::valid_leave(me, dir);
}
