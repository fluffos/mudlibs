#include <ansi2.h>
inherit NPC;
void create()
{
 set_name(HIW+BLK"黑毛豬"NOR,({"black pig","pig"}));
 set("long","正宗黑毛豬。\n");
 set("age",2+random(10));
 set("race", "野獸");
 set("level",3+random(10));
 set("limbs", ({ "頭部", "身體", "前腳", "後腳", "尾巴" }) );
 set("verbs", ({ "bite", "claw" ,"crash"}) );
 set("max_hp",350+random(350));
 set("addition/damage",random(30)); 
 setup();
}
void die()
{
        object ob;
        ob=new(__DIR__"obj/item20"); 
        ob->move(this_object());
        ::die();
        return;
}

