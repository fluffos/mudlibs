
inherit ITEM;
inherit F_PILL;
#include <ansi.h>

void create()
{
        set_name(HIG"百果粽子"NOR, ({ "dex zong zi", "zong", "zi" }) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "顆");
                set("value", 10);  
        }
}
