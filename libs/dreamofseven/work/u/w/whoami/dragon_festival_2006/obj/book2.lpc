
#include <ansi.h>
inherit ITEM;
void create()
{
        set_name(HIC"簡易版端午食譜"NOR,({"cookery book","book"}) );
        set("long",@LONG

台式白粽：竹葉、粽繩、糯米、調味料、豬肉、香菇、雞蛋

綠豆鴨蛋粽：竹葉、粽繩、糯米、調味料、綠豆、花生米、鴨蛋


陳皮牛肉粽：竹葉、粽繩、糯米、調味料、綠豆、牛肉、陳皮、豬肉

四川椒鹽豆粽：竹葉、粽繩、糯米、調味料、紅豆、豬肉、花椒

百果粽子：竹葉、粽繩、糯米、調味料、冬瓜條、核桃仁、青梅

魚香荷葉粽：竹葉、粽繩、糯米、調味料、蝦米、蘿蔔乾、香菇、魚肉、三寶米

健康素粽：竹葉、粽繩、糯米、調味料、花生、香菇、栗子、蘿蔔乾、三寶米、粉葉

廣東蘆兜粽：竹葉、粽繩、糯米、調味料、紅豆、栗蓉、棗泥、蓮蓉、三寶米

LONG
);
        set_weight(200);
        if(clonep() )
                set_default_object(__FILE__);
        else
        {
                set("value",100);
                set("unit","本"); 
        }
        setup();
}
