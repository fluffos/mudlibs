
inherit ITEM;
inherit F_FOOD;
#include <ansi.h>

void create()
{
        set_name(WHT"台式白粽"NOR, ({ "hp zong zi", "zong", "zi" }) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "顆");
                set("value", 10);  
                set("heal_hp",250);
                set("food_remaining",2);
        }
}
