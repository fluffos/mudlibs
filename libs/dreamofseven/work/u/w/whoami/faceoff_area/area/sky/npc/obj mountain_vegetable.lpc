inherit ITEM;
inherit F_WATER;

void create()
{
        set_name("白干", ({ "wine",}) );
        set_weight(80);
        if( clonep() )
        set_default_object(__FILE__);
        else {
                set("long", "一瓶烈酒。");
                set("unit", "瓶");
        }
                set("value", 40);       
                set("heal_mp",10);      
                set("heal_ap",20);
                set("heal_hp",15);
                set("water_remaining", 9);
       setup();
}
