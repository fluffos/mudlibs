#include <weapon.h>
#include <ansi.h>
inherit ITEM;
void create()
{
        set_name("鷹羽", ({ "feather", }) );
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("long", "一根神鷹的羽毛.");
                }
        setup();
}
