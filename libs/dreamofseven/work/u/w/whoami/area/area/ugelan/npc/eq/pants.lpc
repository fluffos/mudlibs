#include <armor.h>
#include <ansi.h>
inherit PANTS;
void create()
{
        set_name("棉布短褲"NOR, ({ "short pants","pants" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long","一件穿過的短褲‧\n");
                set("unit", "雙");
                set("value",100);
                set("material", "fur");
                set("armor_prop/armor", 5);
        }
       setup();
}
