#include <weapon.h>
inherit NEEDLE;
void create()
{
        set_name("銀針", ({"silver needle" ,"needle"}));
        set_weight(300);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("base_unit", "根");
                set("unit", "堆");
                set("base_volume",1);
                set("base_weight",300);
                set("material", "iron");
        set("long",@LONG
一根銀針‧
LONG);
        }
        init_needle(15);
        setup();
        set("value",300);
        set("volume", 5);
        set_amount(15);
}

