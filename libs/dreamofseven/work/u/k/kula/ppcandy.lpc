#include <ansi.h>
inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name(HIY"棒棒糖"NOR, ({ "candy" }) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一根棒棒糖，可拉常吃的零食。\n");
                set("unit", "根");
                set("value", 10);  
                set("food_remaining",50);
                set("heal_hp",0);
        }
}

