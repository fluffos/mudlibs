#include <armor.h>
#include <ansi.h>
inherit CLOTH;
void create()
{
  set_name(HIG"木葉衣"NOR ,({ "mu-ie cloth","cloth" }) );
  set("long",HIC"木葉村忍者所穿的衣服。\n"NOR);

  set_weight(2100);
  if ( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "leather");
    set("volume",2);
    set("unit", "件");
    set("value",1200);
  }
  set("armor_prop/armor",23);
  setup();
}
