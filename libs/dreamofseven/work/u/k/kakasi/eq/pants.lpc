#include <armor.h>
#include <ansi.h>
inherit PANTS;
void create()
{
  set_name(HIG"木葉褲"NOR ,({ "mu-ie pants","pants" }) );
  set("long",HIC"木葉村忍者所穿的褲子。\n"NOR);

  set_weight(2100);
  if ( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("material", "leather");
    set("volume",2);
    set("unit", "條");
    set("value",1200);
  }
  set("armor_prop/armor",14);
  setup();
}
