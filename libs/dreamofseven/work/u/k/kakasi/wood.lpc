#include <ansi.h>
inherit ITEM;
void create()
{
        set_name("檜木", ({ "wood", "wood" }));
        set("long","木材中的極品。\n");
        set_weight(450);

        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根" );
                set("value", 100 );
        }
        setup();
}
