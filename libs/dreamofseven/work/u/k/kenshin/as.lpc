#include <ansi.h>

inherit ITEM;
void create()
{
    set_name("[0;1;33m[1m[1m[1m[1;36m[1mo[1m[1mn[1;37m[1m[0m",({"angel's say","say","angel"}));
    setup();
}
void init()
{
    add_action("do_cc","cc");
} 
int do_cc(string arg)
{ 
        object me = this_player();
        if( !arg || arg=="" ) return notify_fail("你要寫什麼﹖\n"); 
        {
        tell_object(users(),
        HIC"【"HIY"處於"HIR"療傷期中"HIC"】藍的喵(Kenshin):"NOR" "+arg+"\n"NOR); 
        }
    return 1;
}
 int query_autoload() { return 1; }

