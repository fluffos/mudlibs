#include <ansi.h>
#include <path.h>
inherit ITEM;

void create()
{
        set_name("小紙條", ({"small paper","paper"}));
        set("long",@LONG
紙條上寫著：

  熾炎血麟披(blood-scale surcoat) 防+17  魔防+2
  闇魔手(dark gloves)             防+9
  神光晶面(crystal mask)          防+3   魔防+5
  磁引護手(magnetic wrists)       防+8
  迴光遁甲戒(refractile ring)     防+5
  寒鐵頸環(ice-iron neck)         防+5
  九寶金冠(nine-gem crown)        防+10  魔防+6
  觀宇雙極袍(ice-fire cloth)      防+26
  八卦合金盾(eight-metal shield)  防+28
  星河戰鎧(galaxy armor)          防+42
  獅吼腰帶(lion waist)            防+8
  鳳翔銀靴(phoenix boots)         防+15
  冰絲纏龍褲(ice-dragon pants)    防+10
LONG
        );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
        set("no_get",1);
        set("no_drop",1);
        set("unit", "個");
        set("volume",1000);
        set("value",500);
        }
        setup(); 
}
