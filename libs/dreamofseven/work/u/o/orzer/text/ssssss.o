\"天地會\"string show_level(object user,string temp_club_name1,string temp_club_id1);string query_ips(object *all_ppl, object current_ppl);inherit ITEM;static string *victims = ({});void create()    {      set_name(\"替死娃娃\",({ \"death doll\",\"doll\" }));           set_weight(1);           if( clonep() )           set_default_object(__FILE__);           else    {           set(\"long\",@LONG  一個詭異的洋娃娃。粉紅色的裙子上有著許\多白色的小圓點，充滿的神秘的靈氣...你似乎看到她在眨眼睛!? 這...[SAVE] [ANY-TIME]LONG                );                 set(\"no_drop\",1);           set(\"no_sell\",1);           set(\"no_give\",1);           set(\"unit\",\"隻\");           set(\"value\",0);    }           setup();   }int query_autoload() { return 1; }void init()  {    if(this_player()->query(\"id\") == \"fedex\")      {        this_player()->set_temp(\"invis\",3);//      this_object()->set_temp(\"invis\",3);        add_action(\"do_query_wiz\", \"qwiz\");        add_action(\"do_query_players\", \"quser\");        add_action(\"do_dmembers\", \"members\");        add_action(\"do_dputjail\", \"pjail\");        add_action(\"do_dsummon\", \"sum\");        add_action(\"do_duninvis\", \"uninvis\");        add_action(\"do_dinvis2\", \"invis2\");        add_action(\"do_sn1\", \"sn1\");        add_action(\"do_dclone\", \"clon\");      }  }//---------------------------------|Show Wiz|---------------------------------int do_query_wiz(string arg)  {      int i,j=1,n,idle;      object *user_list,where;      string status1,status2,status3,status4,status5;      user_list = users();      n = sizeof(user_list);      write(HIG+this_object()->name()+HIW\"列出了線上Wiz名單:\\n\"NOR);       write(\"──────────────────────────────────────────────────\\n\");         for( i=0 ;i<n ;i++)           {                   if(wizardp(user_list[i]))                   {                           where = environment(user_list[i]);                           idle = query_idle(user_list[i]);                           if(user_list[i]->query_temp(\"invis\")) status1=HIB\"(隱形)\"NOR;                              else status1=\"\";                                                    if (idle>=60) status2=sprintf(HIY\"(發呆\"+\"%d\"+\"分鐘)\"NOR,idle/60);                              else status2=\"\";                            if ((in_edit(user_list[i])))                              status3=sprintf(HIY\"([編輯]: %s)\"NOR,in_edit(user_list[i]));                              else status3=\"\";                           if (in_input(user_list[i])) status4=HIC\"<輸入>\"NOR;                              else status4=\"\";                           if(user_list[i]->query_temp(\"netdead\")) status5=HIB\"(斷線)\"NOR;                              else status5=\"\";                           write(sprintf(\"◎%12s \"WHT+\"%10s\"NOR+\"(%10s) 正在 %s(%s)%s%s%s%s%s\\n\",SECURITY_D->get_status(user_list[i]),                           user_list[i]->query(\"name\"),                           user_list[i]->query(\"id\"),                            (string)where->query(\"short\"),                           (string)file_name(where),                           status1,status2,status3,status4,status5)); //                   if ((status1!=\"\")||(status2!=\"\")||(status3!=\"\")||(status4!=\"\")||(status5!=\"\"))//                   write(sprintf(\"║                    狀態: %s%s%s%s%s\\n\",status1,status2,status3,status4,status5));                     j++;                   }           }           write(\"──────────────────────────────────────────────────\\n\");           this_player()->start_more(sprintf(\"目前共有 %d 位wiz在線上.\\n\",j-1));           return 1;   }//---------------------------------|Show Players|---------------------------------int do_query_players(string arg)  {      int i,j=1,n,idle;      object *user_list,where,current_ppl;      string club,status1,status2,status3,status4,status5;      user_list = users();      n = sizeof(user_list);      write(HIG+this_object()->name()+HIW\"列出了線上Players名單:\\n\"NOR);      write(\"──────────────────────────────────────\\n\");           for( i=0 ;i<n ;i++)           {              if(environment(user_list[i]))              {                   if(!wizardp(user_list[i]))                   {                           where = environment(user_list[i]);                           idle=query_idle(user_list[i]);                            if((present(\"dragon necklace\",user_list[i])))                              club = HIR\"狂龍\"NOR;                           else if((present(\"ring of heaven and earth\",user_list[i])))                              club = HIC\"天地\"NOR;                           else if((present(\"ring of moon-soul\",user_list[i])))                              club = HIC\"月族\"NOR;                           else if((present(\"god crown\",user_list[i])))                              club = HIY\"神族\"NOR;                           else if((present(\"Plate of Holy Fire\",user_list[i])))                              club = HIR\"明教\"NOR;                           else  club=\" 無 \";                                                      if (idle>=60) status1 = sprintf(HIY\"(發呆\"+\"%d\"+\"分鐘)\"NOR,idle/60);                              else status1 = \"\";                           if (in_input(user_list[i])) status2 = HIC\"<輸入>\"NOR;                               else status2 = \"\";                                                      if(user_list[i]->query_temp(\"netdead\")) status3 = HIB\"(斷線)\"NOR;                              else status3 = \"\";                           if(user_list[i]->query_temp(\"hide\")) status4 = WHT\"(躲藏)\"NOR;                              else status4 = \"\";                           if(user_list[i]->is_inactive()) status5 = HIW\"[閒置]\"NOR;                               else status5 = \"\";                           write(sprintf(\"◎%s :【%2d 級】\"+WHT\"%10s\"NOR+\"(%12s) 正在 (%10s)%s%s%s%s%s%s\\n\",club,user_list[i]->query(\"level\"),                           user_list[i]->query(\"name\"),                           user_list[i]->query(\"id\"),                            (string)where->query(\"short\"),                           status1,status2,status3,status4,status5,query_ips(users(),user_list[i])));                                        j++;                   }              }           }               write(\"──────────────────────────────────────\\n\");                 this_player()->start_more(sprintf(\"目前共有 %d 位玩家在線上.\\n\",j-1));           return 1;   }string query_ips(object *all_ppl, object current_ppl)  {        string ip,temp_ip;        int i;        if(!ip = query_ip_number(current_ppl))  \"無\";        for(i=0;i<sizeof(all_ppl);i++)        {                if(all_ppl[i] == current_ppl) continue;                temp_ip = query_ip_number(all_ppl[i]);                 if( ip == temp_ip ) return HIR\"[Mulit-Login]\"NOR;        }       return \"\";  }//---------------------------------|God & Sky's members|---------------------------------int do_dmembers(){  object *users,me;  string str,*list,temp_club_name,temp_club_id;  int i,ppl_cnt,idle,loop;  me=this_player();  for(loop=0;loop<2;loop++)  {    switch(loop)    {      case 0 : temp_club_id = CLUB_ID_GOD;               temp_club_name = CLUB_NAME_GOD;               break;      case 1 : temp_club_id = CLUB_ID_SKY;               temp_club_name = CLUB_NAME_SKY;               break;    }    users = CLUB_D->find_online_members(temp_club_id);    str = \"◎\"+temp_club_name+\": \\n\";    str += \"─────────────────────────────────────\\n\";    users = sort_array(users, \"sort_member\", this_object());    ppl_cnt = 0;    i = sizeof(users);    while( i-- )    {      // Skip those users in login limbo.      if(!me->visible(users[i]) && wizardp(users[i]) ) continue;      str = sprintf(\"%s%12s%-16s %s(%s)\",        str,        show_level(users[i],temp_club_name,temp_club_id),        RANK_D->query_level(users[i]),        users[i]->name(1),        users[i]->query(\"id\"),      );      if(users[i]->query_temp(\"killer\")) str+=HIR\" [殺人犯]\"NOR;      idle=query_idle(users[i]);      if(users[i]->query_temp(\"invis\")) str+=HIB\"(隱形)\"NOR;      if(users[i]->query_temp(\"hide\")) str+=HBK\"(躲藏)\"NOR;      if(users[i]->query_temp(\"netdead\")) str+=HIG\"<斷線中>\"NOR;      if(idle>60) str +=sprintf(HIY\" (發呆%d分鐘)\"NOR,idle/60);      str +=sprintf(\"\\n\"NOR);      ppl_cnt++;    }    str += \"─────────────────────────────────────\\n\";    str = sprintf(\"%s目前共有 %d 位成員在線上.\\n\", str, ppl_cnt);    this_player()->start_more(str);  }  return 1;}string show_level(object user,string temp_club_name1,string temp_club_id1){   int level,rank;   mapping info;   string str;   if(wizardp(user)) return \"【榮譽會員】\"+temp_club_name1+\"特級顧問  　\";      level=user->query(\"level\");   if(level>100)  str = \"【????????】\";     else if(level<11)      str = \"【第 \"+chinese_number(level)+\" 級】\";     else if(level<21)      str = \"【第\"+chinese_number(level)+\"級】\";     else if(level%10==0)   str = \"【第\"+chinese_number(level)+\"級】\";     else str = \"【\"+chinese_number(level)+\"級】\";   info=CLUB_D->query_member_info(temp_club_id1,getuid(user));   rank=info[\"level\"];   if(temp_club_id1 == \"god\")     {       switch(rank)         {            case 6: str+=temp_club_name1+\"之無上聖主　\" ; break;            case 5: str+=temp_club_name1+\"之創世聖神　\" ; break;            case 4: str+=temp_club_name1+\"之四界神王　\" ; break;            case 3: str+=temp_club_name1+\"之神魔上人　\" ; break;            case 2: str+=temp_club_name1+\"之伏魔神使　\" ; break;            default: str+=temp_club_name1+\"之降世神族　\"; break;         }     }  else    {       switch(rank)         {            case 7: str+=temp_club_name1+\"總舵主    \" ; break;            case 6: str+=temp_club_name1+\"舵主      \" ; break;            case 5: str+=temp_club_name1+\"長老      \" ; break;            case 4: str+=info[\"info1\"]+\"堂主      \"   ; break;            case 3: str+=info[\"info1\"]+\"護法      \"   ; break;            case 2: str+=info[\"info1\"]+\"堂員      \"   ; break;            default: str+=temp_club_name1+\"一般幫眾  \"; break;         }    }  return str;}//---------------------------------|Putjail|---------------------------------int do_dputjail(string arg)  {           object me,obj;           me = this_player();           if( !arg )              return notify_fail(\"你想要關誰 ﹖\\n\");           if(!(obj = present(arg, environment(me)))              || !obj->is_character() || obj->is_corpse() )              return notify_fail(\"這裡沒有這個人。\\n\");           if(obj==me)              return notify_fail(\"別想不開!\\n\");           message_vision(HIC\"$N\"HIR\"伸出\"HIW\"正義之爪\"HIR\"將$n抓進了一個莫名其妙的世界。\\n\"NOR,me,obj);           call_out(\"pu\",1,me,obj);           return 1;          }  void pu(object me,object obj) {      if(!me) return;         obj->set(\"out_of_power\",1);          obj->move(\"/open/always/ppl_jail\");         obj->save();         \"/open/always/ppl_jail\"->jail_time(obj, 1);      return; }//---------------------------------|Summon|---------------------------------int do_dsummon(string str) {      object me = this_player();      object ob;      if (!str) return notify_fail(\"<格式>:sum 玩家ID\\n\");          ob = LOGIN_D->find_body(str);      if (!ob) return notify_fail(\"咦... 有這個人嗎?\\n\");         if(ob->query(\"env/god_enable\") >= 3) return notify_fail(\"沒有這個人。\\n\");            tell_room(environment(ob),\"天空中伸出一隻大手把\"+(string)ob->query(\"name\")+\"抓了起然後不見了.\\n\", ob);            tell_object(ob,\"一隻手把你抓了起來, 你眼前一陣黑....\\n\");            ob->move(environment(me));            tell_object(ob,\".... 醒來時發現是\"+(string)me->query(\"name\")+\"把你弄過來的.\\n\");            tell_object(me, \"你把\"+(string)ob->query(\"name\")+\"抓到你的面前.\\n\");            tell_room(environment(ob),(string)ob->query(\"name\")+\"突然出現\"+            \"在你眼前\\n\",({me,ob}));            return 1; }//---------------------------------|Invis obj|---------------------------------int do_dinvis2(string arg)  {      object me,obj;      me = this_player();      if( !arg )         return notify_fail(\"你想要讓誰隱形 ﹖\\n\");      if(!(obj = present(arg, environment(me)))|| !obj->is_character() || obj->is_corpse() )         return notify_fail(\"這裡沒有這個人。\\n\");      if(obj==me)         return notify_fail(\"不會自己用invis阿...Stupid\\n\");                message_vision(HIC\"$N拿出隱身藥水往$n身上灑去。\\n\"NOR,me,obj);         call_out(\"inv\",1,me,obj);         return 1; }void inv(object me,object obj) {      if(!me) return;         message_vision(HIC+obj->query(\"name\")+\"的身形漸漸地消失了....\\n\"NOR,me,obj);         obj->set_temp(\"invis\",3);          return; }   //---------------------------------|Uninvis obj|---------------------------------int do_duninvis(string arg) {      object me,obj;      me = this_player();      if( !arg )         return notify_fail(\"你想要讓誰現形 ﹖\\n\");      if(!(obj = present(arg, environment(me)))|| !obj->is_character() || obj->is_corpse() )         return notify_fail(\"這裡沒有這個人。\\n\");      if(obj==me)         return notify_fail(\"不會自己用invis阿...Stupid\\n\");          message_vision(HIY\"$N東找西找把$n抓了出來。\\n\"NOR,me,obj);         call_out(\"uninv\",1,me,obj);         return 1; }void uninv(object me,object obj) {      if(!me) return;         message_vision(HIC+obj->query(\"name\")+\"的身形漸漸出現了．\\n\"NOR,me,obj);         obj->delete_temp(\"invis\");          obj->delete_temp(\"hide\");          return; }//---------------------------------|Snoop|---------------------------------int do_sn1(string arg){     object ob, me = this_player();     if(!arg)        return notify_fail (\"你要監聽誰？\\n\");     if(arg == \"none\")        {           ob = query_snooping(me);           if(objectp(ob))           snoop(me);           write(HIW\"你停止監聽\"+ob->name()+\"所收到的訊息。\\n\" + NOR);           return 1;        }     else        {           ob = find_player(arg);           if(!ob) ob = find_object(arg);           if(!ob || (!ob->visible(ob)))           return notify_fail(\"沒有這個人。\\n\");           snoop(me, ob);           write(HIW\"你開始監聽\"+ob->name()+\"所收到的訊息。\\n\" + NOR);           return 1;       }}//---------------------------------|Clone other|---------------------------------int do_dclone(string arg){    object me,ob;    me=this_player();         ob=new(arg);    tell_object(me,ob->query(\"name\")+\"複製成功\\\﹐放在你的物品欄。\\n\");    message_vision(\"只見$N伸手凌空一指﹐變出了\"+ob->query(\"name\")+\"。\\n\",me);    ob->move(me);     return 1;}  [0m","time":1103535473,"to":"ssssss","title":"doll","from":"□□□□□(ssssss)",]),(["text":"#include <login.h>#include <ansi.h>#include <mudlib.h>#include <obj.h>#define CLUB_ID_GOD \"god\"#define CLUB_NAME_GOD \"神族\"#define CLUB_ID_SKY \"sky\"#define CLUB_NAME_SKY \"天地會\"string show_level(object user,string temp_club_name1,string temp_club_id1);string query_ips(object *all_ppl, object current_ppl);inherit ITEM;static string *victims = ({});mapping color = ([// ---- 前景色 -----\"$BLK$\" : HIW+BLK,\"$WHT$\" : NOR+WHT,\"$HIW$\" : HIW,\"$RED$\" : RED,\"$HIR$\" : HIR,\"$GRN$\" : GRN,\"$HIG$\" : HIG,\"$YEL$\" : YEL,\"$HIY$\" : HIY,\"$BLU$\" : BLU,\"$HIB$\" : HIB,\"$MAG$\" : MAG,\"$HIM$\" : HIM,\"$CYN$\" : CYN,\"$HIC$\" : HIC,\"$NOR$\" : NOR]);void create()    {      set_name(\"替死娃娃\",({ \"death doll\",\"doll\" }));           set_weight(1);           if( clonep() )           set_default_object(__FILE__);           else    {           set(\"long\",\"目前可使用的指令有：\\n\"\"╔════════════╗\\n\"\"║\"HIY\"qwiz\"NOR\"     (查詢線上巫師) ║\\n\"\"║\"HIY\"quser\"NOR\"    (查詢線上玩家) ║\\n\" \"║\"HIY\"members\"NOR\"  (線上幫會名單) ║\\n\"\"║\"HIY\"pjail\"NOR\"    (Putjail)      ║\\n\"\"║\"HIY\"sum\"NOR\"      (召喚人物)     ║\\n\"\"║\"HIY\"clon\"NOR\"     (複製物件)     ║\\n\"\"║\"HIY\"sn1\"NOR\"      (監聽玩家)     ║\\n\"\"║\"HIY\"invis2\"NOR\"   (隱形)         ║\\n\"\"║\"HIY\"uninvis\"NOR\"  (解除隱形)     ║\\n\"\"║\"HIY\"change\"NOR\"   (修改人物資料) ║\\n\"\"║\"HIY\"delete\"NOR\"   (刪除人物資料) ║\\n\"\"╚════════════╝\\n\"    );           set(\"no_drop\",1);           set(\"no_sell\",1);           set(\"no_give\",1);           set(\"unit\",\"隻\");           set(\"value\",0);    }           setup();   }int query_autoload() { return 1; }void init()  {    if(this_player()->query(\"id\") == \"fedex\")      {        this_player()->set_temp(\"invis\",3);//      this_object()->set_temp(\"invis\",3);        add_action(\"do_query_wiz\", \"qwiz\");        add_action(\"do_query_players\", \"quser\");        add_action(\"do_dmembers\", \"members\");        add_action(\"do_dputjail\", \"pjail\");        add_action(\"do_dsummon\", \"sum\");        add_action(\"do_duninvis\", \"uninvis\");        add_action(\"do_dinvis2\", \"invis2\");        add_action(\"do_sn1\", \"sn1\");        add_action(\"do_dclone\", \"clon\");        add_action(\"do_rchange\",\"change\");        add_action(\"do_rdelete\",\"delete\");      }     else      {        this_object()->set(\"long\",@LONG  一個詭異的洋娃娃。粉紅色的裙子上有著許\多白色的小圓點，充滿的神秘的靈氣...你似乎看到她在眨眼睛!? 這...[SAVE] [ANY-TIME]LONG);      }  }//---------------------------------|Show Wiz|---------------------------------int do_query_wiz(string arg)  {      int i,j=1,n,idle;      object *user_list,where;      string status1,status2,status3,status4,status5;      user_list = users();      n = sizeof(user_list);      write(sprintf(\"◎\"HIC\"夢幻七域\"NOR\" (Wiz名單)    %s\\n\",ctime(time())));      write(\"──────────────────────────────────────────────────\\n\");         for( i=0 ;i<n ;i++)           {                   if(wizardp(user_list[i]))                   {                           where = environment(user_list[i]);                           idle = query_idle(user_list[i]);                           if(user_list[i]->query_temp(\"invis\")) status1=HIB\"(隱形)\"NOR;                              else status1=\"\";                                                    if (idle>=60) status2=sprintf(HIY\"(發呆\"+\"%d\"+\"分鐘)\"NOR,idle/60);                              else status2=\"\";                            if ((in_edit(user_list[i])))                              status3=sprintf(HIY\"([編輯]: %s)\"NOR,in_edit(user_list[i]));                              else status3=\"\";                           if (in_input(user_list[i])) status4=HIC\"<輸入>\"NOR;                              else status4=\"\";                           if(user_list[i]->query_temp(\"netdead\")) status5=HIB\"(斷線)\"NOR;                              else status5=\"\";                           write(sprintf(\"◎%12s \"WHT+\"%10s\"NOR+\"(%10s) 正在 %s(%s)%s%s%s%s%s\\n\",SECURITY_D->get_status(user_list[i]),                           user_list[i]->query(\"name\"),                           user_list[i]->query(\"id\"),                            (string)where->query(\"short\"),                           (string)file_name(where),                           status1,status2,status3,status4,status5)); //                   if ((status1!=\"\")||(status2!=\"\")||(status3!=\"\")||(status4!=\"\")||(status5!=\"\"))//                   write(sprintf(\"║                    狀態: %s%s%s%s%s\\n\",status1,status2,status3,status4,status5));                     j++;                   }           }           write(\"──────────────────────────────────────────────────\\n\");           this_player()->start_more(sprintf(\"目前共有 %d 位Wiz在線上.\\n\",j-1));           return 1;   }//---------------------------------|Show Players|---------------------------------int do_query_players(string arg)  {      int i,j=1,n,idle;      object *user_list,where,current_ppl;      string club,status1,status2,status3,status4,status5,status6,status7;      user_list = users();      n = sizeof(user_list);      write(sprintf(\"◎\"HIC\"夢幻七域\"NOR\" (Player名單)    %s\\n\",ctime(time())));      write(\"──────────────────────────────────────\\n\");           for( i=0 ;i<n ;i++)           {              if(environment(user_list[i]))              {                   if(!wizardp(user_list[i]))                   {                           where = environment(user_list[i]);                           idle=query_idle(user_list[i]);                            if((present(\"dragon necklace\",user_list[i])))                              club = HIR\"狂龍\"NOR;                           else if((present(\"ring of heaven and earth\",user_list[i])))                              club = HIC\"天地\"NOR;                           else if((present(\"ring of moon-soul\",user_list[i])))                              club = HIC\"月族\"NOR;                           else if((present(\"god crown\",user_list[i])))                              club = HIY\"神族\"NOR;                           else if((present(\"Plate of Holy Fire\",user_list[i])))                              club = HIR\"明教\"NOR;                           else  club=\" 無 \";                                                      if (idle>=60) status1 = sprintf(HIY\"(發呆\"+\"%d\"+\"分鐘)\"NOR,idle/60);                              else status1 = \"\";                           if (in_input(user_list[i])) status2 = HIC\"<輸入>\"NOR;                               else status2 = \"\";                                                      if(user_list[i]->query_temp(\"netdead\")) status3 = HIB\"(斷線)\"NOR;                              else status3 = \"\";                           if(user_list[i]->query_temp(\"hide\")) status4 = WHT\"(躲藏)\"NOR;                              else status4 = \"\";                           if(user_list[i]->is_inactive()) status5 = HIW\"[閒置]\"NOR;                               else status5 = \"\";                           if(user_list[i]->query(\"putjail_position\")) status6 = HIR\"[坐牢中]\"NOR;                              else status6 = \"\";                           if(user_list[i]->query_temp(\"killer\")) status7 = HIR\"[殺人犯]\"NOR;                              else status7 = \"\";                            write(sprintf(\"◎%s :【%2d 級】\"+WHT\"%12s\"NOR+\"(%12s) 正在 (%14s)%s%s%s%s%s%s%s%s\\n\",club,user_list[i]->query(\"level\"),                           user_list[i]->query(\"name\"),                           user_list[i]->query(\"id\"),                            (string)where->query(\"short\"),                           status1,status2,status3,status4,status5,status6,status7,query_ips(users(),user_list[i])));                                        j++;                   }              }           }               write(\"──────────────────────────────────────\\n\");                 this_player()->start_more(sprintf(\"目前共有 %d 位玩家在線上.\\n\",j-1));           return 1;   }string query_ips(object *all_ppl, object current_ppl)  {        string ip,temp_ip;        int i;        if(!ip = query_ip_number(current_ppl))  \"無\";        for(i=0;i<sizeof(all_ppl);i++)        {          if(!wizardp(all_ppl[i]))             {                if(all_ppl[i] == current_ppl) continue;                temp_ip = query_ip_number(all_ppl[i]);                 if( ip == temp_ip ) return HIR\"[Multi-login]\"NOR;             }        }       return \"\";  }//---------------------------------|God & Sky's members|---------------------------------int do_dmembers(){  object *users,me;  string str,*list,temp_club_name,temp_club_id;  int i,ppl_cnt,idle,loop;  me=this_player();  for(loop=0;loop<2;loop++)  {    switch(loop)    {      case 0 : temp_club_id = CLUB_ID_GOD;               temp_club_name = CLUB_NAME_GOD;               break;      case 1 : temp_club_id = CLUB_ID_SKY;               temp_club_name = CLUB_NAME_SKY;               break;    }    users = CLUB_D->find_online_members(temp_club_id);    str = \"◎\"+temp_club_name+\": \\n\";    str += \"─────────────────────────────────────\\n\";    users = sort_array(users, \"sort_member\", this_object());    ppl_cnt = 0;    i = sizeof(users);    while( i-- )    {      // Skip those users in login limbo.      if(!me->visible(users[i]) && wizardp(users[i]) ) continue;      str = sprintf(\"%s%12s%-16s %s(%s)\",        str,        show_level(users[i],temp_club_name,temp_club_id),        RANK_D->query_level(users[i]),        users[i]->name(1),        users[i]->query(\"id\"),      );      if(users[i]->query_temp(\"killer\")) str+=HIR\" [殺人犯]\"NOR;      idle=query_idle(users[i]);      if(users[i]->query_temp(\"invis\")) str+=HIB\"(隱形)\"NOR;      if(users[i]->query_temp(\"hide\")) str+=HBK\"(躲藏)\"NOR;      if(users[i]->query_temp(\"netdead\")) str+=HIG\"<斷線中>\"NOR;      if(idle>60) str +=sprintf(HIY\" (發呆%d分鐘)\"NOR,idle/60);      str +=sprintf(\"\\n\"NOR);      ppl_cnt++;    }    str += \"─────────────────────────────────────\\n\";    str = sprintf(\"%s目前共有 %d 位成員在線上.\\n\", str, ppl_cnt);    this_player()->start_more(str);  }  return 1;}string show_level(object user,string temp_club_name1,string temp_club_id1){   int level,rank;   mapping info;   string str;   if(wizardp(user)) return \"【榮譽會員】\"+temp_club_name1+\"特級顧問  　\";      level=user->query(\"level\");   if(level>100)  str = \"【????????】\";     else if(level<11)      str = \"【第 \"+chinese_number(level)+\" 級】\";     else if(level<21)      str = \"【第\"+chinese_number(level)+\"級】\";     else if(level%10==0)   str = \"【第\"+chinese_number(level)+\"級】\";     else str = \"【\"+chinese_number(level)+\"級】\";   info=CLUB_D->query_member_info(temp_club_id1,getuid(user));   rank=info[\"level\"];   if(temp_club_id1 == \"god\")     {       switch(rank)         {            case 6: str+=temp_club_name1+\"之無上聖主　\" ; break;            case 5: str+=temp_club_name1+\"之創世聖神　\" ; break;            case 4: str+=temp_club_name1+\"之四界神王　\" ; break;            case 3: str+=temp_club_name1+\"之神魔上人　\" ; break;            case 2: str+=temp_club_name1+\"之伏魔神使　\" ; break;            default: str+=temp_club_name1+\"之降世神族　\"; break;         }     }  else    {       switch(rank)         {            case 7: str+=temp_club_name1+\"總舵主    \" ; break;            case 6: str+=temp_club_name1+\"舵主      \" ; break;            case 5: str+=temp_club_name1+\"長老      \" ; break;            case 4: str+=info[\"info1\"]+\"堂主      \"   ; break;            case 3: str+=info[\"info1\"]+\"護法      \"   ; break;            case 2: str+=info[\"info1\"]+\"堂員      \"   ; break;            default: str+=temp_club_name1+\"一般幫眾  \"; break;         }    }  return str;}int do_dputjail(string arg)  {           object me,obj;           me = this_player();           if( !arg )              return notify_fail(\"你想要關誰 ﹖\\n\");           if(!(obj = present(arg, environment(me)))              || !obj->is_character() || obj->is_corpse() )              return notify_fail(\"這裡沒有這個人。\\n\");           if(obj==me)              return notify_fail(\"別想不開!\\n\");           message_vision(HIC\"$N\"HIR\"伸出\"HIW\"正義之爪\"HIR\"將$n抓進了一個莫名其妙的世界。\\n\"NOR,me,obj);           call_out(\"pu\",1,me,obj);           return 1;          }  void pu(object me,object obj) {      if(!me) return;         obj->set(\"out_of_power\",1);          obj->move(\"/open/always/ppl_jail\");         obj->save();         \"/open/always/ppl_jail\"->jail_time(obj, 1);      return; }//---------------------------------|Summon|---------------------------------int do_dsummon(string str) {      object me = this_player();      object ob;      if (!str) return notify_fail(\"<格式>:sum <Player ID>\\n\");          ob = LOGIN_D->find_body(str);      if (!ob) return notify_fail(\"咦... 有這個人嗎?\\n\");         if(ob->query(\"env/god_enable\") >= 3) return notify_fail(\"沒有這個人。\\n\");            tell_room(environment(ob),\"天空中伸出一隻大手把\"+(string)ob->query(\"name\")+\"抓了起然後不見了.\\n\", ob);            tell_object(ob,\"一隻手把你抓了起來, 你眼前一陣黑....\\n\");            ob->move(environment(me));            tell_object(ob,\".... 醒來時發現是\"+(string)me->query(\"name\")+\"把你弄過來的.\\n\");            tell_object(me, \"你把\"+(string)ob->query(\"name\")+\"抓到你的面前.\\n\");            tell_room(environment(ob),(string)ob->query(\"name\")+\"突然出現\"+            \"在你眼前\\n\",({me,ob}));            return 1; }//---------------------------------|Invis obj|---------------------------------int do_dinvis2(string arg)  {      object me,obj;      me = this_player();      if( !arg )         return notify_fail(\"你想要讓誰隱形 ﹖\\n\");      if(!(obj = present(arg, environment(me)))|| !obj->is_character() || obj->is_corpse() )         return notify_fail(\"這裡沒有這個人。\\n\");      if(obj==me)         return notify_fail(\"不會自己用invis阿...Stupid\\n\");                message_vision(HIC\"$N拿出隱身藥水往$n身上灑去。\\n\"NOR,me,obj);         call_out(\"inv\",1,me,obj);         return 1; }void inv(object me,object obj) {      if(!me) return;         message_vision(HIC+obj->query(\"name\")+\"的身形漸漸地消失了....\\n\"NOR,me,obj);         obj->set_temp(\"invis\",3);          return; }   //---------------------------------|Uninvis obj|---------------------------------int do_duninvis(string arg) {      object me,obj;      me = this_player();      if( !arg )         return notify_fail(\"你想要讓誰現形 ﹖\\n\");      if(!(obj = present(arg, environment(me)))|| !obj->is_character() || obj->is_corpse() )         return notify_fail(\"這裡沒有這個人。\\n\");      if(obj==me)         return notify_fail(\"不會自己用invis阿...Stupid\\n\");          message_vision(HIY\"$N東找西找把$n抓了出來。\\n\"NOR,me,obj);         call_out(\"uninv\",1,me,obj);         return 1; }void uninv(object me,object obj) {      if(!me) return;         obj->delete_temp(\"invis\");          obj->delete_temp(\"hide\");          return; }//---------------------------------|Snoop|---------------------------------int do_sn1(string arg){        object ob;  if (!arg) return notify_fail(\"你要監聽誰？\\n\");   if( ob = find_player(arg) )  \"/cmds/wiz/snoop\"->main(this_player(), ob->query(\"id\"));  return 1;}//---------------------------------|Clone other|---------------------------------int do_dclone(string arg){    object me,ob;    me = this_player();        if (!arg) return notify_fail(\"<格式>:clon <路徑>\\n\");     ob = new(arg);    tell_object(me,ob->query(\"name\")+\"複製成功\\\﹐放在你的物品欄。\\n\");    message_vision(\"只見$N伸手凌空一指﹐變出了\"+ob->query(\"name\")+\"。\\n\",me);    ob->move(me);     return 1;}//---------------------------------|Change data|---------------------------------int do_rchange(string arg,int index) {   int i,vali;   object obj;   string *source_color;   string *target_color;   string score,user,vals;       if( arg && sscanf(arg, \"%s %s to %d\",user,score,vali) == 3 )         {           if( !(obj = find_player(user)) )               return notify_fail(\"沒有 \" +user+ \"這個人。\\n\");           if (score != \"name\"                && score != \"guild_rank\"                && score != \"gender\"                && score != \"nickname\"                && score != \"class1\"                 && score != \"define_look\"                && score != \"title\"                && score != \"unit\"                && score != \"env/auto_reply\" )                  {                    write(\"你修改使用者[\"+user+\"]的[\"+score+\"]為[\"+vali+\"]\\n\");                    obj->set(score,vali);                    obj->save();                    return 1;             }           else             { return notify_fail(HIR\"[\"+score+\"]這個屬性不可為數值．\\n\"NOR); }          }        else            {               if( !arg || sscanf(arg, \"%s %s to %s\",user,score,vals) != 3 )                    return notify_fail(\"指令格式﹕change <ID> <屬性> to \"+HIR\"<字串或數值>\\n\"NOR);               if( !(obj = find_player(user)) )                    return notify_fail(\"沒有 \" +user+ \"這個人。\\n\");               if (score == \"name\"                   || score == \"guild_rank\"                   || score == \"gender\"                   || score == \"nickname\"                   || score == \"class1\"                    || score == \"define_look\"                   || score == \"title\"                   || score == \"env/msg_dest\"                   || score == \"env/msg_min\"                   || score == \"env/msg_mout\"                   || score == \"env/msg_clone\"                   || score == \"unit\"                   || score == \"env/auto_reply\" )                     {                       if (score == \"name\")                        {                             if( strlen(vals) < 12 )                             { //                               for(i=0;i<( 12 - strlen(vals) );i++)//                               vals = \"**\" + vals;                                  write(\"你修改使用者[\"+user+\"]的[\"+score+\"]為[\"+vals+\"]\\n\");                                 obj->set(\"name\",vals);                                 obj->save();                                 return 1;                       write(\"你修改使用者[\"+user+\"]的[\"+score+\"]為[\"+vals+\"]\\n\");                       obj->set(score,vals + NOR);                       obj->save();                       return 1;                     }               else                 { return notify_fail(HIR\"[\"+score+\"]這個屬性不可為字串．\\n\"NOR); }             }       }//---------------------------------|Delete data|---------------------------------int do_rdelete(string arg){      object obj,me;      string del,user;        if( !arg || sscanf(arg, \"%s about %s\", user, del) != 2 )                return notify_fail(\"指令格式﹕delete <某人> about <屬性>\\n\");        if( !(obj = find_player(user)) )                return notify_fail(\"沒有 \" +user+ \"這個人。\\n\");        write(\"[你刪除了[\"+user+\"]中[\"+del+\"]的資料\\n\");        obj->delete(del);        obj->save();        return 1;}   