void init()
{
 call_out("leave_message",3,this_player());
 call_out("entercheck",2,this_player());
}

void entercheck(object ob)

{
 if(userp(ob))
 {
   if(wiz_level(ob) < wiz_level("(immortal)"))
   {
       message_vision("[0;1;5;31m[1;5mF[1;5m[1;5mJ[1;5m[1;5m[1;5m[1;5m[1;5m[1;5m@[1;5m[1;5mF[0m："+ob->name()+" 你怎會跑來這。(-_-)！\n"NOR, ob);
     ob->move("/d/slake/start");
   } else 
   {
message_vision(HIY"\n[0;1;5;31m[1;5mF[1;5m[1;5mJ[1;5m[1;5m[1;5m[1;5m[1;5m[1;5m@[1;5m[1;5mF[0m嘆了一口氣曰道: 我說！！ "+ob->name()+"閣下！！你這...........\n"NOR, ob);
   }
 }
 return;
}

void leave_message(object me)  //*****訪客動作*****
{
 object zorg,ob1,ob2;
 if(zorg=find_player("zorg")) //本人在遊戲中
 {
  if(me->query("id")!="zorg") //別人進入
  {
   ob1=find_object(__DIR__"workroom");
   if(ob2) return; //本人在房間內即取消動作
   add("guest",me->query("id")+" - "); //紀錄訪客
   tell_object(zorg,"有訪客來囉!("+me->query("name")+")\n");
   tell_object(me,"墮落天使(zorg)告訴你:說！你說！給我說！你給我說！深田恭子漂不漂亮？？？\n");
  } else //of if(me->query("id")!="zorg") 本人進入
  {
   if(query("guest")) //有訪客紀錄
   {
    tell_object(me,"今天的訪客有:"+query("guest")+"\n");
    delete("guest");
   } else //of if(query("guest")) 沒有訪客紀錄
   {
          //tell_object(me,"今天還沒有訪客來過\n");
   }
  }
} else //of if(zorg=find_player("zorg")) 本人不在遊戲中
 {
  add("guest",me->query("id")+" - ");  //紀錄訪客
tell_object(me,"[0;1;5;31m[1;5mF[1;5m[1;5mJ[1;5m[1;5m[1;5m[1;5m[1;5m[1;5m@[1;5m[1;5mF[0m告訴你: 墮落天使-魯西法 尚未駕到,尊下有何貴幹！");
 }
 }

