inherit ROOM;
void create()
{
	set("short", "草原");
        set("long", @LONG

LONG
);
	set("exits",([
	"east" : __DIR__"map_5_9",
	"south" : __DIR__"map_6_8",
	"north" : __DIR__"map_4_8",
	"west" : __DIR__"map_5_7",
	]));
        setup();
}

string query_long(int raw)
{
	string out;
	out=ROOM_D->showmap(this_object());
	out+=query("long");
	return out;
}

