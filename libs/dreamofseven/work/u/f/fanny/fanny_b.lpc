#include <ansi.h>
inherit BULLETIN_BOARD;
void create()
{
        set_name("紅塵瑣碎事",({"board"}));
set("location","/u/f/fanny/workroom.lpc");
        set("board_id", "fanny_b");
        set("long",
"一塊密密麻麻寫滿了字的薄木板。\n");
        setup();
        set("capacity",100);
        replace_program(BULLETIN_BOARD);
}
