#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create()
{
        set_name(HIW"冬季戀曲"NOR, ({ "winter song", "winter", "song" }) );
        set_weight(1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long","Aring專用....:P \n");
                set("unit", "件");
                set("material", "unknown");
                set("no_give",1);
                set("no_drop",1);
                set("no_sell",1);
                set("no_sac",1);
                set("value",1);
        }
                set("armor_prop/armor", 120);
        setup();
}
int query_autoload() { return 1; }

