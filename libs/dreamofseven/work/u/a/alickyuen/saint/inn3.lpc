#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "[1;36mST．SOFT＠地下二樓[2;37;0m");
	set("long", @LONG
這裏是這間旅館的地下二樓，二旁都是一排排的房間，是用來租給客
人住的。如你有問題的話，可以詢問這裡的識員。
LONG
	);
	set("world", "future");
	set("light", 1);
	set("exits", ([ /* sizeof() == 4 */
  "north" : __DIR__"inn4",
  "up" : __DIR__"inn2",
]));
set("objects", ([
__DIR__"npc/keeper2" : 1,
]));
set("no_kill",1);
set("no_cast",1);
set("no_exert",1);
set("no_fight",1);
	set("no_clean_up", 0);
	setup();
}
void init()
{
        add_action("typepush","push");
}
int valid_leave(object me, string dir)
{
        if( dir!="north" )return ::valid_leave(me, dir);

        if( dir=="north" && me->query_temp("pushpass") <=0 || !me->query_temp("pushpass") )
                return notify_fail(HIW"_____________\n"NOR
                           HIW"｜請輸入密碼｜\n"NOR
                           HIW"_____________\n"NOR
                                  HIW"｜９｜８｜７｜\n"NOR
                                  HIW"｜６｜５｜４｜\n"NOR
                                  HIW"｜３｜２｜１｜\n"NOR
                                  HIW"｜ＥＮＴＥＲ｜\n"NOR
                                  HIW"｜__________｜\n"NOR
);

        return ::valid_leave(me, dir);
}
int typepush(string arg)
{
object me;
me=this_player();
if(!me->query_temp("bookroom") ) return notify_fail("你沒有訂房間。\n");

if (arg!="5" ) return notify_fail("密碼錯誤！！\n");
{
tell_object(me,"密碼正確。\n");
me->delete_temp("bookroom");
me->set_temp("pushpass",1);
}
return 1;
}