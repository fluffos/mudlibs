#include <ansi.h>
inherit NPC;
void create()
{
        set_name("老鼠" , ({ "mouse" }) );
        set("level",10);
 set("race", "野獸");
        set("limbs", ({ "頭部", "腹部","胸部","小爪","背部" }) ); 
        set("verbs", ({ "bite","claw" }) );
    set("chat_chance",10);
        set("age", 50);
        set("long","一隻非常污髒的老鼠。\n");
        setup();
}

