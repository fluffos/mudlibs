"/open/world1/ksj/thief/npc/thief-master","/open/world1/moonhide/area/goo.lpc",
"/open/world1/moonhide/area/dragongirl","/open/world1/moonhide/area/god-prey.lpc","/open/world1/moonhide/area/under/npc/evil"
"/open/world1/tmr/advthief/thief_adv_master.lpc","/open/world1/cominging/area/npc/master","/open/world1/cominging/area/npc/yuanlieh",
