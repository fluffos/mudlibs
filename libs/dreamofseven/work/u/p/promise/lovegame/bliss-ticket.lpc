#include <ansi.h>
inherit ITEM;
void create()
{
        set_name(HIM"幸福摸彩卷"NOR,({"bliss ticket","ticket"}));
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "張");
                set("long",
               HIW"摸彩卷，可向"HIM"織女妹妹"HIY"換禮物。\n"NOR);
             }
        set_weight(100);     
        //set("no_drop",1);
        set("no_auc",1);
        set("no_sell",1);
        
        setup();
} 

