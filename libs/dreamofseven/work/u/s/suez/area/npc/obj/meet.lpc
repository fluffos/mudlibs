inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("肉乾", ({ "meet" }) );
        set_weight(70);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一片肉乾，不知道用什麼香料調味，香的出奇。\n");
                set("unit", "片");
                set("value", 20);       //參考價格為回復點數總和除以5
                set("heal_hp",20);      //可以是"heal_hp"或是"heal_mp",也可以都有.
                set("food_remaining", 5);
        }
        setup();
}
