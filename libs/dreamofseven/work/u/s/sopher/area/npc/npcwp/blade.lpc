#include <weapon.h>
#include <ansi.h>
inherit BLADE;

void create()
{
      set_name(HIW"逆"HIR"刃"HIW"刀"NOR, ({ "blade" }) );
      set_weight(1000);
      if( clonep() )
      set_default_object(__FILE__);
      else {
             set("unit","把");
             set("value",10000);
             set("material","steel");
        }
       init_blade(400);
       
       setup();
}    
