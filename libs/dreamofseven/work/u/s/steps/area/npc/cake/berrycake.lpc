#include <ansi.h>
inherit ITEM;
inherit F_FOOD;
void create()
{
        set_name(HIR"草莓蛋糕"NOR, ({ "berry cake" }) );
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", HIG"一個有濃郁草莓香味的草莓蛋糕\n"NOR);
                set("unit", "個");
                set("value", 10);
                set("food_remaining",6);
                set("heal_hp",30);
        }
}
