#include <ansi.h>
inherit ROOM;
string look_string();
void create()
{
  set ("short", HIG"能者之山-山腳處"NOR);
  set ("long", @LONG
這裡是扶桑浪人營的能者之山，只有通過封印之窟之歷鍊
的人才有資格上山，山頂上有什麼除了真正的強者外沒有人知道，
話說扶桑浪人營內有非常多的勇士們一一勇闖封印之窟，卻總是
無法活著回來，依規定闖過封印之窟的人都得守口如瓶，不得洩
漏半句..從此繼十年前天齊二郎丸後封印之窟就此成了一個傳說
.....................
LONG
);
  set("item_desc",([
  "石碑" : ( : look_string : ),
 ]));
        set("light",1);
        set("no_clean_up", 0);
        set("outdoors","land");
        setup();
}
