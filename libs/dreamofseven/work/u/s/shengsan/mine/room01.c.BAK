// room01.c
#include <path.h>
inherit ROOM;

void create()
{
	set("short", "[1;36m休憩庭院走廊[0m");
	set("long", @LONG
這裡是藍藍的天休憩庭院,沒有太多的擾攘,也沒有太多煩
人的公事.一切無憂與無慮都可以在這美麗的庭院中找到,潺潺
的流水聲,娟娟的鳥啼聲,聽得讓你心礦神怡,宛如自己已經到
了人間的淨土桃花園之中了.
LONG
	);

	set("exits", ([ /* sizeof() == 7 */
		"west" : SHENGSAN+"workroom",
		"north": __DIR__"sendroom",
            ]));

	set("light", 1);
	set("no_clean_up", 0);
	setup();
	replace_program(ROOM);
}
