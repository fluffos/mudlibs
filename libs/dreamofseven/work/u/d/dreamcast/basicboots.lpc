#include <armor.h>
#include <ansi.h>
inherit BOOTS;
void create()
{
        set_name(RED"邪"BLU"獄"HIR"烈"HIW"靴" NOR, ({ "Dreamcast boots", "boots" }) );
        set("long","這雙靴是邪獄王利用惡魔烈焰作的‧\n");
        set_weight(1800);
        if ( clonep() )
                set_default_object(__FILE__);
        else {
                set("material", "leather" );
                set("unit", "雙" );
                set("value" , 130);
                set("volume",3);
                set("armor_prop/armor", 4);
                set("armor_prop/shield", 5);
        }
        setup();
}

