inherit ITEM;
inherit F_WATER;

void create()
{
        set_name("鮮魚湯", ({ "fresh soup","soup"}) );
        set_weight(190);
        if( clonep() )
        set_default_object(__FILE__);
        else {
                set("long", "一碗風味絕佳的新鮮魚湯。");
                set("unit", "碗");
        }
                set("value", 300);       
                set("heal_mp",60);      
                set("heal_ap",5);
                set("heal_hp",15);
                set("water_remaining", 6);
       setup();
}



