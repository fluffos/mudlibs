void init()
{
 add_action("do_ip","ip");
}

int do_ip(string arg)
{
 object *player;
 int x,i,ip1,j;
 string list,temp;
 
 list="\n";
 player=users();
 x=0;
 for(j=127;204>j;j++)
 {
 for(i=0;sizeof(player)>i;i++)
 {
  sscanf( query_ip_number(player[i]),"%d.%s",ip1,temp);
  if(ip1==j) list+=sprintf( "%12s (%12s) %s \n",player[i]->query("name"),player[i]->query("id"),query_ip_number(player[i]));
 }
}

 write(list);
 return 1;
}
