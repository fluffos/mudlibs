#include <armor.h>

inherit BOOTS;

void create()
{
set_name( "綠晶靴",({"green boots","boots"}) );
set("long","一雙閃閃發亮的綠色鐵靴。\n");
set_weight(3600);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("material", "iron");
                set("unit", "雙");
set("value",3600);
set("limit_lv",56);
//set("armor_prop/armor",49);
}
setup();
}
