#include <ansi.h>

#include <weapon.h>

inherit BLADE;

void create()
{
set_name("[1;36m獵刀[0m",({"hunt blade","blade"}));
set_weight(36400);
        if( clonep() )
                set_default_object(__FILE__);
        else {
set("unit", "把");
set("long","這是一把鋒利無比的長刀,常用來打獵用的\n");
set("value",4368);
set("blade",52);
set("material","iron");
        }

init_blade(728);
setup();
}
