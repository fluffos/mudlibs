#include <ansi.h>
#include <weapon.h>
inherit BLADE;

void create()
{
set_name("[1;30m開山刀[0m",({"kaisan blade","blade"}));
set_weight(16600);
        if( clonep() )
                set_default_object(__FILE__);
        else {
set("unit", "把");
set("long","這是一把方頭的鐵製黑色長刀,拿這種刀的人通常不是什麼好人.\n");
set("value",2390);
set("blade",41);
set("material","iron");
        }
set("wield_msg","$N從一捆報紙中抽出一把鋒利的$n\n");
set("unequip_msg", "$N放下手中的$n, 用報紙包好收藏起來。\n");
init_blade(665);
setup();
}
