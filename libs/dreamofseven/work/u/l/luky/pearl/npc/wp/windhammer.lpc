#include <ansi.h>
#include <weapon.h>
inherit HAMMER;
void create()
{
set_name("[1;36m風神鎚[0m",({"wind hammer","hammer"}));
set_weight(40000);
     if( clonep() )
               set_default_object(__FILE__);
     else {
            set("long","\n
這把斧頭曾經被風神施法在上面,雖然很重,但使用起來卻相當便利\n");  
            set("unit", "把");
            set("rigidity",85); //硬度
            set("material","steel"); //材質
set("hammer",50);
set("weapon_prop/dex",3);
set("value",4750);
           }
init_hammer(800);
        setup();
}



