inherit F_AUTOLOAD;
inherit F_CLEAN_UP;
inherit F_SAVE;
inherit COMBINED_ITEM;     
void create()
{
set_name("[1;32m綠藻藥水[0m",({"green potion","potion"}));
set_weight(1250);
 set("value",1400);
set_amount(1);
set("amount",1);
if(!restore())
{
set("unit","瓶");
set("long","由綠藻提煉而成的藥水, 可以迅速恢復生命力與體力.\n");
set("kind","hp");
set("usage","恢復玩家1000點的生命力與500點的體力");
set("cure",1000);
}
}


void init()
{
add_action("drink_potion","drink");
}

int drink_potion(string arg)
{
int num
;
object ob,me;
me=this_player();
num = query_amount();            
if(!this_player()) return 0;
if(!arg)
return 0;
if(this_player()->query("hp")<0)
return 0;
if(this_player()->query_temp("supply"))
return notify_fail("你正在忙,沒空喝藥水\n");
if(arg=="potion")
{
if(this_player()->query("birthday"))
this_player()->add_temp("cmds",1);
if(!ob=present(arg,this_player()))        
return notify_fail("你要喝什麼??\n");
if(ob->query_amount()<1)
return notify_fail("你已經喝完了\n");
if(me->query("hp")>=me->query("max_hp") && me->query("ap")>=me->query("max_ap"))
{
write("你生命力和體力都滿了!\n");
return 1;
}
me->add("hp",1000);
me->add("ap",500);
if(me->query("hp")+1000>me->query("max_hp"))
me->set("hp",me->query("max_hp"));
if(me->query("ap")+500>me->query("max_ap"))
me->set("ap",me->query("max_ap"));
message_vision("\n$N喝了一瓶[1;32m綠藻藥水[m.\n",me);
me->start_busy(1);
num--;
if(num>0)
{ 
set_weight(this_object()->query_weight()-1000);
//me->set_encumbrance(me->query_encumbrance()-1000);
set_amount(num);
} else destruct(this_object());
return 1;
}
}

