#include <ansi.h>
#include <weapon.h>
inherit SPEAR;
void create()
{
set_name("[1;34m麥[1;32m克[1;35m筆[0m",({"mike pen","mike","pen"}));
// 設"mike pen","pen","mike"這樣wield時wield pen or wield mike or wield mike pen就可裝備
set_weight(5000);
if( clonep() )
    set_default_object(__FILE__);
  else {
set("long","\n
你看到一支小畫家作畫時用到的彩色麥克筆喔!\n");
set("unit", "把");
set("unequip_msg", "$N將手中的$n放入書包內。\n");
set("wield_msg","$N拿起了$n,[1;36m一股畫家追求[1;5;31m完美[0m[1;36m的意念湧上你心頭[0m\n");
set("spear",25); //社了這個..代表skill 50才能wield且也設定了武器的攻擊力..攻擊力內定是pudon社的...你自己try
set("value",800);
       }
      setup();
}
