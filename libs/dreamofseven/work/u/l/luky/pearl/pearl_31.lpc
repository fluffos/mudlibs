#include <ansi.h>
inherit ROOM;
void create()
{
set("short", "[1;32m寧靜花園[m");
set("long", @LONG

  這裡有一大片美麗的花圃。許多工人正在努力的種花, 還有一些
種花的工具放在地上免費供人使用。這裡的每一棵花木都是終年盛
開的﹐旁邊有個告示牌[1;32m([1;36msign[1;32m)[0m。

LONG);
 set("exits", ([
"east" : __DIR__"pearl_14",
]));
set("item_desc",([
"sign":@NOTE

這裡可以種(plow)的藥草有

綠    藻(green algae)
可 可 豆(coco bean)

NOTE
,
"工具":"這幾把鏟子很常見也很普通, 似乎並不耐用。\n",
"tools":"這幾把鏟子很常見也很普通, 似乎並不耐用。\n",
]));
set("light",1);
setup();
}
void init()
{
 add_action("do_plow","plow");
}
int do_plow(string arg)
{
 object me,ob;
 int a,b;
 me=this_player();
if(!me) return 0;
 a=me->query("ap");
 b=20-(int)me->query_skill("product")/5;
 if(this_player()->query("class")!="worker")        
  return notify_fail("只有工人才有資格在這種花\n");
 if(this_player()->query_temp("wood"))
  return notify_fail("你還在種東西喔..\n");
 if(!arg) 
  return notify_fail("你要種什麼呢??'n");
 if(arg=="green algae")
 {
 if(a<400)
  return notify_fail("你的體力不夠了\n");
 me->set_temp("wood",1);
 a=me->query_skill("product");
 me->set_temp("time",4);
 call_out("green",b,me);
 } 
else if(arg=="coco bean")
{
if(a<530)
 return notify_fail("你的體力不夠了\n");
me->set_temp("wood",1);
a=me->query_skill("product");
me->set_temp("time",4);
call_out("coco",b,me);
}else return notify_fail("你想要種什麼啊\n");
me->start_busy(b);
return 1;
}

int coco(object me)
{
object ob;
int time,a,b;
if(!me) return 0;
time=me->add_temp("time",-1);
if(!me->query_temp("wood"))
return 1;
if(me->query_temp("time")<1)
{
me->delete_temp("no_quit");
me->delete_temp("wood");
message_vision("[1;32m$N[1;32m把一箱箱的可可豆打包起來...[0m\n",me);
return 1;
}
if(me->query_temp("netdead"))
{
me->delete_temp("no_quit");
me->delete_temp("wood");
return 1;
}
if(me->query("ap")<530)
{
me->delete_temp("wood");
return notify_fail("你的體力不夠了\n");
}
me->add("ap",-530);
ob=new(__DIR__"obj/coco");
a=me->query_skill("product")/5;
a=(int)a;
b=20-a;
tell_object(me,"[1;32m你正在努力種可可豆[0m\n");
if(me->query_max_encumbrance()<ob->query_weight()+me->query_encumbrance())
ob->move(environment(me));
else ob->move(me);
call_out("coco",b,me,time);
return 1;
}

int green(object me)
{
object ob;
int time,a,b;
if(!me) return 0;
time=me->add_temp("time",-1);
if(!me->query_temp("wood"))
return 1;         
if(me->query_temp("time")<1)
{
me->delete_temp("wood");
me->delete_temp("no_quit");
message_vision("[1;32m$N[1;32m拍拍衣服, 把辛苦種好的綠藻蒐集起來...[0m\n",me);
return 1;
}
if(me->query_temp("netdead"))
{
me->delete_temp("no_quit");
me->delete_temp("wood");
return 1;
}
if(me->query("ap")<400)
{
me->delete_temp("wood");
return notify_fail("你的體力不夠了\n");
}
me->add("ap",-400);
ob=new(__DIR__"obj/green");
a=me->query_skill("product")/5;
a=(int)a;
b=20-a;
tell_object(me,"[1;32m你正在努力種綠藻[0m\n");
if(me->query_max_encumbrance()<ob->query_weight()+me->query_encumbrance())
ob->move(environment(me));
else ob->move(me);
call_out("green",b,me,time);
return 1;
}
