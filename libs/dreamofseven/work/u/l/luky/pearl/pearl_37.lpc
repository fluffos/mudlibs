// Room: /u/l/luky/room/pearl_37.c
inherit ROOM;
void init();
void create()
{
set("short", "[1;32m修道院大廳[m");
set("long", @LONG

靴子踏在大廳的大理石地板上發出清脆的「喀啦，喀啦」回響，
著名的神魔戰爭像(Figure)就刻在此處上方，無法望盡的四壁竟也佈
滿著滲入神聖光芒的七彩玻璃(Window)，可說是世間奇景盡聚其室，
不過這裡最能引人眼光的莫過於牆邊一排的古鐘了...

LONG
);
set("objects",([
__DIR__"npc/academician":1,
]));
set("exits", ([ /* sizeof() == 1 */
"up" : __DIR__"pearl_40",
//  "down" : __DIR__"pearl_41",
"east" : __DIR__"pearl_25",
"west" : __DIR__"priest",
]));

set("item_desc",([
"figure":@NOTE
傳說中獅子戰爭的模擬圖，在修道院建成之前請一位工人賽拉(Sala)
雕製而成，謠傳劍魔的故事跟他挺有關連..
NOTE
,
"window":"彩色玻璃一向是教堂中不可欠缺之物，不過此處有點特別，上面
描繪了許\多傳說中的故事。\n",
"clock":"這一整排的鐘似乎沒有限制的不停往北方延伸，正一一觀賞之時
，竟有一座深藍色的鐘(blue_clock)不停的發出奇怪的聲音？\n",
"古鐘":"這一整排的鐘似乎沒有限制的不停往北方延伸，正一一觀賞之時
，竟有一座深藍色的鐘(blue_clock)不停的發出奇怪的聲音？\n",
"blue_clock":"這座藍色的鐘看來也無特別，剛剛聽見的怪聲(sound)可能是錯覺吧。\n",
]));
set("no_clean_up", 0);
set("light",1);
setup();
set("hour",11);
set("min",46);
set("time",0);
}

void init()
{
 add_action("do_listen","listen");
 add_action("do_checkt","checktime");
 add_action("do_time","settime");
}

int do_listen(string arg)
{
 object me;
 me=this_player();
 if(!arg) return notify_fail("你要聽什麼?\n");
 if(arg=="sound")
 {
  message_vision("$N走到藍色古鐘旁邊用心聽了一會兒。\n",me);
  write("你發現這個鐘的聲音走的比其他的鐘慢..而且比較大聲.. 再仔細一看.. \n");
  write("原這個鐘沒有鏡面.. 時針和分針都可以隨意亂設(settime)..你可以看看\n");
  write("目前這個鐘設定的時間(checktime)。\n");
 }
 return notify_fail("你聽了"+arg+"半天也聽不出什麼心得。\n");
}

int do_checkt()
{
 int hour,min;
 hour=query("hour");
 min=query("min");
 write("現在時鐘的時間是 "+hour+"點"+min+"分。\n");
 return 1;
}

int do_time(string arg)
{
 object me,paper;
 string arg2;
 int num,min,hour,time;
 me=this_player();
 if(!arg) return notify_fail("格式: \nsettime hour [數字]\nsettime min [數字]\n");
 if(sscanf(arg, "%s %d", arg2, num)==2)
 {
  if(arg2=="hour") 
  {
   if(num>12 ||num<1) return notify_fail("你家的鐘才有這種時間吧?!\n");
   set("hour",num);
   message_vision("$N走到藍色古鐘前面撥了指針一下。\n",me);
   write("[喀玆!] 時間設定完畢。\n");
  //call_out("checkt",1);
  } 
  if(arg2=="min")
  {
   if(num>60 ||num<0) return notify_fail("你家的鐘才有這種時間吧?!\n");
   set("min",num);
   message_vision("$N走到藍色古鐘前面撥了指針一下。\n",me);
   write("[喀玆!] 時間設定完畢。\n");
  // call_out("checkt",1);
  }
  hour=query("hour");
  min=query("min");
  time=query("time");
  if(time==0 && hour==7 && min==7) set("time",1);
  if(time==1 && hour==6 && min==3) set("time",2);
  if(time==2 && hour==12 && min==0)
  {
   if(paper=present("paper",me))
   {
    message_vision("$N拿出紙片照著上面唸著: 四方無極, 乾坤借法, 天地鬼神, 供我差使!!\n",me);
    message_vision("$N手中的紙片猛然化為一道藍光.. 射入了古鐘之內!!\n",me);
    destruct(paper);
    message_vision("[1;33m\n\n噹～噹～噹～噹～噹～～～\n[37m突然全部的鐘都響了起來!!\n[m",me);
    message_vision("\n  藍色的古鐘緩緩的向後移動。出現了一個地洞!! \n",me);
    set("exits/down", __DIR__"pearl_41");
   } else 
   {
    message_vision("$N藍色古鐘晃了一下。\n",me);
    write(" 你感覺似乎是少了什麼步驟喔..\n");
    set("time",0);    
   } 
  }
  return 1;
 }
 return 0;
}

