void init()
{
 add_action("do_read","read");
}

int do_read(string arg)
{
 object me;
 me = this_player();
 if( !arg || (arg != "words"))return notify_fail("你要讀什麼?\n");
 if(random((int)me->query("int"))<20)
   message_vision("$N看了半天也看不出是什麼意思。\n",me);
 else
 {
  message_vision("$N看了一下，發現上面寫著[開發中]。\n",me);
  me->set_temp("statusword",1);
 }
 return 1;
}
