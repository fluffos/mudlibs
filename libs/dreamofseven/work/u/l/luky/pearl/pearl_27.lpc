int valid_leave(object me, string dir)
{
 if( dir=="west")
 {
  if(!wizardp(me))
  {
   if(!this_player()->query_temp("ticket")) return notify_fail("你沒有買票不能進去。\n");
   write(HIW"你把票拿給站長後便往月台走去。\n"NOR);
   me->delete_temp("ticket");
   return ::valid_leave(me, dir);
  } else 
   {
    message_vision("[1;35m$N[1;37m悄悄對站長說: 我是巫師... 不用買票了吧..[m\n",this_player());
    message_vision("[0;36m站長點了點頭.. 放$N[0;36m過去了..[m\n",this_player());
    return ::valid_leave(me, dir);
   }
 }
 return ::valid_leave(me, dir);
}

void init()
{
add_action("do_buy", "buy");
}

int do_buy(string arg)
{
 object me;
 me=this_player();
 if(!arg) return notify_fail("你要買什麼??\n");
 if(arg=="ticket")
 { 
  if(me->query_temp("ticket")) return notify_fail("你已經買過票了。\n");
  if(this_player()->query("coin")<300)
   return notify_fail("一張票要三佰元喔.. 你的錢不夠。\n");
  write(HIY"你付了300元, 售票元給了你一張票。\n"NOR);
  me->set_temp("ticket",1);
  this_player()->add("coin",-300);
  return 1;
 }
 return notify_fail("這裡只賣票(Ticket)喔。\n");
}