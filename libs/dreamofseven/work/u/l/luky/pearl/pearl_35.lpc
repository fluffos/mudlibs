void init()
{
 check_killer();
}
int check_killer()
{
 object me;
 me=this_player();
 if(me->query_temp("killer"))
 {
  message_vision(HIR"\n旅館老闆大罵: $N不准進來!!\n\n 我們這裡不歡迎殺人狂!!!\n\n"NOR,me);
  me->move(__DIR__"pearl_8");
  message_vision(HIY"\n$N被旅館老闆踢了出來..\n\n"NOR,me);
  return 0;
 }
 return 1;
}