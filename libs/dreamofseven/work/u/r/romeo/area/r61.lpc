// Room: /u/k/king/area/r61.c

inherit ROOM;

void create()
{
	set("short", "[1;31m戰國[1;33m皇陵[2;37;0m鬼王殿");
	set("long", @LONG
這裡就是秦皇陵的最後一端了，四周反而一反常態的寧靜，在廣大的
空間裡只放了一具棺材，棺材的四周也都用紅色綿線纏住，不知道有什麼
功用。天花板上佈滿了蜘蛛網使天神無法聽到你的回應，你還是自求多福
吧。
LONG
	);
	set("no_recall", 1);
	set("item_desc", ([ /* sizeof() == 1 */
  "金棺" : "這是一具黃金製成的棺木，你似乎可以掀開(uncover)它。
",
]));
	set("world", "undefine");
	set("light", 0);
	set("no_clean_up", 0);

	setup();
}
void init()
{
        add_action("do_uncover","uncover");
}
int do_uncover(string arg)
{
        object me;
        object zombie;
            object zombie2;
        me=this_player();
        if(query_temp("kkzombie")) return notify_fail("什麼？\n");
        if(arg != "金棺" )
        {
          notify_fail("你要掀開什麼？\n");
          return 0;
        }
        else {
          message_vision(
          "$N將金棺小心的掀開，一陣黑氣從棺木四周不斷的湧出來，只見一具
身穿龍袍的人緩緩爬起。\n\n"
         "秦始皇對天狂嘯道：「我的世界來臨了」。\n"
         "一陣金光後，一頁書出現在你面前且道：「$N這個世界就交給你了」，話畢，一頁書就消失了。\n"
         ,me);
        zombie=new(__DIR__"npc/chin3.lpc");
        zombie->move(__DIR__"r61");
        set("exits", ([
          "up" : __DIR__"god",
        ]));
        set_temp("kkzombie",1);
        set("item_desc", ([
        "金棺" : "這棺木似乎已經被人打開了。\n",
        ]) );
set("long", @LONG
你看看這副金棺原來是鍍金的，你氣忿的往金棺一踢，不小心扭到自己的腳，
還痛了半天，最後還是自己摸摸鼻子轉頭走了。
LONG
);
        return 1;
   }
}
