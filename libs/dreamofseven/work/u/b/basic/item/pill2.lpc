inherit ITEM;
#include <ansi2.h>
void create()
{ set_name(HIM"晴晴"HIB"藥藥"NOR, ({"ch_Pill","pill"}) );
  set_weight(1);
  set("unit", "顆");
  setup(); }
void init()
{ add_action("do_eat", "eat"); }
int do_eat(string str)
{ object me = this_player();
  string name;
  name =HBBLU""HIW"永不放棄"NOR;
  if("str == pill") {
  message_vision(HIB"我愛晴晴吃下藥丸\n"NOR, me);
  me->set("name",name);
  destruct(this_object());
  return 1; }}
