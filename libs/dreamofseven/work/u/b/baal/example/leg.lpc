inherit ITEM;
inherit F_FOOD;
void create()
{
        set_name("雞腿",({"chicken leg","leg"}));
        set_weight(90);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一隻香噴噴、熱騰騰的雞腿。\n");
                set("unit", "隻");
                  set("value",90);
                set("heal_hp",15);
               set("food_remaining",2);
        }
     setup();
}
