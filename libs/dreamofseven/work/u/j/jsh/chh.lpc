#include <ansi2.h>
inherit ITEM;
void create()
{
  set_name("123123", ({ "ch","ccchhh" }));
  set_weight(100);
  if( clonep() )
    set_default_object(__FILE__);
  else
    set("long","\n");
  setup();
}
void init()
{
  add_action("do_ch1","ch1");
}

int do_ch1(string arg)
{
        object me=this_player();
        me->set("env/msg_mout",HIW"\n"
"[0;1m[1mz[0m───────────────┐ \n"
"│   雷克斯                     │\n" 
"│       飛去別的地方           │\n" 
"│            豪  洨  了        │\n" 
"│      ◢██◣                │\n"
"│      █    ◥▌              │\n"
"│      ◤□︵□▌              │\n"
"└──﹨╲  口／───▅────┘\n"
" ￣￣￣◥￣︺￣◣￣￣￣￣￣￣￣￣\n"
"         ▏  ▕\n"
"         ◤￣◥\n"); 
        me->set("env/msg_min",HIW"\n"
"[0;1m[1mz[0m───────────────┐ \n"
"│   雷克斯                     │\n" 
"│       飛來這裡               │\n" 
"│            豪  洨  了        │\n" 
"│      ◢██◣                │\n"
"│      █    ◥▌              │\n"
"│      ◤□︵□▌              │\n"
"└──﹨╲  口／───▅────┘\n"
" ￣￣￣◥￣︺￣◣￣￣￣￣￣￣￣￣\n"
"         ▏  ▕\n"
"         ◤￣◥\n");
 
me->save();
return 1;
}
