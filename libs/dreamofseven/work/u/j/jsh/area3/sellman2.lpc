#include <ansi.h>
#include <path.h>
inherit NPC;
inherit SELLMAN;
void create()
{
        set_name("牛肉攤老闆", ({ "beef noodle-boss", "boss" }) );
        set("long",
                "牛肉麵攤的老闆，煮出來的牛肉麵，連軒轅烈都讚不絕口。\n"
                        ); 
        set("chat_chance",10);
        set("chat_msg",({ 
"牛肉麵攤老闆小心翼翼的把牛肉切成片狀 ~ ~\n",
(: command,"sweat" :),
(: command,"say 來ㄛ ~ 來ㄛ ~ 好吃的牛肉麵" :),
}));
        set("sell_list",([
__DIR__"noodle": 5,
]));
        set("level", 20);
        set("no_fight",1);
        set("age", 42);
        set("storeroom", __DIR__"/store2.lpc");
        setup();
}

void init()
{
        add_action("do_buy","buy");
        add_action("do_list","list");
}

