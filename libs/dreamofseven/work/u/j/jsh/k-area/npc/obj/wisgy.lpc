#include <ansi.h> 
inherit ITEM;
inherit F_WATER;

void create()
{
        set_name(HIB"威士忌"NOR, ({ "wisgy" }));
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long","皇宮貴族所飲的飲品，價值不凡。\n");
                set("unit","杯");
        }
        set("value",200);
        set("heal_ap",30);
        set("water_remaining",3);
        setup();
}

