#include <ansi.h>
inherit BULLETIN_BOARD;
void create()
{
        set_name("雅或留言板(Zorg's Board)",({"board"}));
        set("location","/u/z/zorg/workroom.lpc");
        set("board_id", "zorg_b");
        set("long",
        "Please live your message in here,If you have any question look help board。\n");
        setup();
        set("capacity",100);
        replace_program(BULLETIN_BOARD);
}


