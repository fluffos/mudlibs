GRN\"／    ＼     ＼   \"HIW\"* \"GRN\"/||o||||||＼   \"HIW\"*   \"YEL\"|  \"HIR\"田  \"YEL\"| \"HIR\"E \"YEL\"|+++|+++++|+++|+++|+++        | |\"NOR); set(\"light\",1); set(\"hide_exits\", ([ /* sizeof() == 2 */    \"js\"   : \"/u/j/jangshow/workroom\",     \"judge\"   : \"/d/wiz/courthouse\",    \"jail\"   : \"/open/always/ppl_jail\",     \"ali\"   : \"/u/a/alickyuen/workroom\",     \"acme\"   : \"/u/a/acme/workroom\",     \"down\"   : \"/d/wiz/entrance\",     \"pro\"   : \"/u/p/promise/workroom\", ])); set(\"no_clean_up\", 1); setup();call_other(\"/obj/board/idleboard.c\", \"???\");}void init(){ add_action(\"do_idle\",\"idle\"); add_action(\"do_arc\",\"arc\");}int do_arc(string arg){          object me;          me=this_player();          if(arg==\"idle\")           {            message_vision(YEL\"突然天上掉下一沱黃金砸到$N的頭上。\\n\"NOR,me);            me->receive_money(10000);            return 1;          } else {            message_vision(YEL\"$N挑了挑眉毛，突然臉部肌肉不住抽動，看來是抽筋了。\\n\"NOR,me);            return 1;          }}int do_idle(string arg){          object me;          me=this_player();          if(arg==\"board\")           {            message_vision(HIW\"$N對著\"HIC\"記錄器\"HIW\"發呆，記時收費加倍。\\n\"NOR,me);            me->set_temp(\"do_idle1\",1);            return 1;          } else {            message_vision(HIW\"$N開始發呆，開始記時收費。\\n\"NOR,me);            me->set_temp(\"do_idle2\",1);            return 1;          }}int room_effect(object me){me=this_player(); if(me->query_temp(\"do_idle1\")) { message_vision(HIW\"此次發呆收費是\"HIC+chinese_number(250)+NOR+YEL\"枚古幣。\\n\"); me->add(\"bank/past\",-250); }if(me->query_temp(\"do_idle2\")) { message_vision(HIW\"此次發呆收費是\"HIC+chinese_number(500)+NOR+YEL\"枚古幣。\\n\"); me->add(\"bank/past\",-500); }}","time":1077724534,]),(["author":"發呆者(idle)","title":"●testroom2.c 改","msg":"#include <ansi.h> inherit ROOM;void create(){ set(\"short\",HIW\"收費發呆室\"NOR); set(\"long\",HIW\"*   *  *       *   *    *    *      *       *     *\"HIW\"*   \"HIY\"★  \"HIW\"*     *    *       * *  *   *      *    *    *\"HIW\"   *   *\"NOR\"   \"WHT\"ｏ    \"HIW\"*  *             *         \"HIG\"/|＼      \"HIW\"*\"HIW\"   *    \"NOR\"\"WHT\"__o   \"HIW\"*   *      \"NOR\"\"GRN\"／＼        \"HIW\"*     \"HIG\"/||o＼   \"HIW\"*   *  \"HIW\"*   ＿||_    *      \"NOR\"\"GRN\"／＼  ／＼    \"HIW\"*     \"HIG\"/|o|||＼    \"HIW\"*\"HIW\" *   ／＼　＼     *  \"NOR\"\"GRN\"／  ＼     ＼       \"HIG\"/|||||o|＼      \"HIW\"*   \"HIW\"／    ＼__＼     \"NOR\"\"GRN\"／    ＼     ＼   \"HIW\"* \"GRN\"/||o||||||＼   \"HIW\"*   \"YEL\"|  \"HIR\"田  \"YEL\"| \"HIR\"E \"YEL\"|+++|+++++|+++|+++|+++        | |\"NOR); set(\"light\",1); set(\"hide_exits\", ([ /* sizeof() == 2 */    \"js\"   : \"/u/j/jangshow/workroom\",     \"judge\"   : \"/d/wiz/courthouse\",    \"jail\"   : \"/open/always/ppl_jail\",     \"ali\"   : \"/u/a/alickyuen/workroom\",     \"acme\"   : \"/u/a/acme/workroom\",     \"down\"   : \"/d/wiz/entrance\",     \"pro\"   : \"/u/p/promise/workroom\", ])); set(\"no_clean_up\", 1); setup();call_other(\"/obj/board/idleboard.c\", \"???\");}void init(){ add_action(\"do_idle\",\"idle\"); add_action(\"do_arc\",\"arc\");}int do_arc(string arg){          object me;          me=this_player();          if(arg==\"idle\")           {            message_vision(YEL\"突然天上掉下一沱黃金砸到$N的頭上。\\n\"NOR,me);            me->receive_money(10000);            return 1;          } else {            message_vision(YEL\"$N挑了挑眉毛，突然臉部肌肉不住抽動，看來是抽筋了。\\n\"NOR,me);            return 1;          }}int do_idle(string arg){          object me;          me=this_player();          if(arg==\"board\")           {            message_vision(HIW\"$N對著\"HIC\"記錄器\"HIW\"發呆，記時收費加倍。\\n\"NOR,me);            me->set_temp(\"do_idle1\",1);            me->delete_temp(\"do_idle2\");            return 1;          } else {            message_vision(HIW\"$N開始發呆，開始記時收費。\\n\"NOR,me);            me->set_temp(\"do_idle2\",1);            me->delete_temp(\"do_idle1\");            return 1;          }}int room_effect(object me){me=this_player();if(me->query_temp(\"do_idle2\")) { message_vision(HIW\"此次發呆收費是\"HIC+chinese_number(250)+NOR+YEL\"枚古幣。\\n\"); me->add(\"bank/past\",-250); }if(me->query_temp(\"do_idle1\")) { message_vision(HIW\"此次發呆收費是\"HIC+chinese_number(500)+NOR+YEL\"枚古幣。\\n\"); me->add(\"bank/past\",-500); }}","time":1077724962,]),(["author":"袁世凱＠ˍ＠(alickyuen)","title":"回覆:紀錄","msg":"[36m: ●紀錄        [Feb 25]發呆者(idle)的高見:: =============================================================:     威風凜凜的袁世凱＠ˍ＠身上帶著下列這些東西﹕        (負重:24% / 空間:24%):   ==================================[48204/192850]==[48/196]=========:     區域產生器(v2.0)(Area maker)        /obj/mapmaker2:     一千零五十八枚古幣(Coin)            /obj/money/coin:     四十五枚金幣(Golden dollar)         /obj/money/dollar:     袁世凱＠ˍ＠的冒險手札(Adventure notebook)  /obj/notebook:     十五隻替死娃娃(Death doll)          /open/always/doll:     鑽石腰帶(Diamond waist) (腰上綁著)   /open/always/lightwaist:     結婚戒指(Marry ring) (手指戴著)   /open/always/marry_ring:     紅色披肩(Red cloak) (肩上披著)   /open/always/redcloak:     琉璃星霜(Lazurite star frost) (下身穿著)   /open/always/starfrost:     蜈蚣護手[已損毀](Scolopendra gloves)  /open/world1/alickyuen/scolopendra/gloves:     『◎』醫生證照(Passport of doctor)  /u/a/alickyuen/droctor/npc/obj/doctor_pass:     變身器(Dunno) (臉上戴著)   /u/a/alickyuen/wp/sailormoon:     五頭龍護身符(Dark amulet) (脖子掛著)   /u/b/baal/weapon/darkamulet:     五頭龍護身符(Dark amulet)  /u/b/baal/weapon/darkamulet:     大便二型(Detector_v2)               /u/l/linjack/detect_v2[0m我身上的東西沒有特別吧=,=--☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★★　　　☆發呆☆　與　☆神聖☆　並重的小巫師　　　　　　　☆★　　　　　　　　　　　　　　　　ＡＬＩＣＫＹＵＥＮ　字　☆☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★[0m","time":1077853735,]),(["author":"發呆者(idle)","title":"●笑話","msg":"意麵(ariel)[坐牢中] 向你發出求助訊號！你有空的話就過去看看是怎麼回事吧！ 　　︵△︵　　　（　　　）　 （ ╲　╱ ）（　 ╭╮　 ）...........超級生氣的大便登場！！！美少女戰士 (Sailormoon)(Sailormoon)的臉上露出疑惑的表情。美少女戰