         \"/std/armor/shield\"#define FINGER          \"/std/armor/finger\"#define HANDS           \"/std/armor/hands\"//NEW: 綁腿 護膝#define LEGGING         \"/std/armor/legging\"//NEW: 褲子#define PANTS           \"/std/armor/pants\"#define BOOTS           \"/std/armor/boots\"-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-【HEAD】(帽,盔) 物理防  心理防  名稱           檔案                      附註======  ======  =============  ========================  ==========                頭巾                遮陽帽                斗笠                安全帽                鋼盔【MASK】(臉部)物理防  心理防  名稱           檔案                      附註======  ======  =============  ========================  ==========                口罩                頭套                太陽眼鏡                蛙鏡                面具               【NECK】(項鍊)物理防  心理防  名稱           檔案                      附註======  ======  =============  ========================  ==========                香包                領帶                圍巾                項鍊                【CLOTH】(內衣,衣服)物理防  心理防  名稱           檔案                      附註======  ======  =============  ========================  ==========                汗衫                Ｔ恤                襯衫                毛衣【ARMOR】(外套,護甲)物理防  心理防  名稱           檔案                      附註======  ======  =============  ========================  ==========                風衣                夾克                救生衣                雨衣【SURCOAT】(大衣,披風)物理防  心理防  名稱           檔案                      附註======  ======  =============  ========================  ==========                大衣                浴巾                背包                披肩                披風【WAIST】(腰帶) 物理防  心理防  名稱           檔案                      附註======  ======  =============  ========================  ==========                小皮帶                白色腰帶                束腹                護腰                【WRISTS】(護腕)物理防  心理防  名稱           檔案                      附註======  ======  =============  ========================  ==========                橡皮圈                幸運環                手鍊                手錶                綿布護腕【SHIELD】(盾)物理防  心理防  名稱           檔案                      附註======  ======  =============  ========================  ==========                洋傘                破木板                炒菜鍋                盾牌【FINGER】(戒指)物理防  心理防  名稱           檔案                      附註======  ======  =============  ========================  ==========                玩具戒指                白鐵戒指                指套【HANDS】(手套)物理防  心理防  名稱           檔案                      附註======  ======  =============  ========================  ==========                白手套                工作手套                絕緣手套【LEGGING】(綁腿,護膝,長襪)物理防  心理防  名稱           檔案                      附註======  ======  =============  ========================  ==========                長毛襪                褲襪                護膝                綁腿                【PANTS】(褲,裙)物理防  心理防  名稱           檔案                      附註======  ======  =============  ========================  ==========                短褲                運動褲                西裝褲                牛仔褲【BOOTS】(鞋,靴)物理防  心理防  名稱           檔案                      附註======  ======  =============  ========================  ==========                舊拖鞋                涼鞋                木屐                溜冰鞋                直排輪鞋                球鞋                雨鞋                皮鞋                馬靴                安全鞋--         [0;1;44m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[0m        [0;1;44m[1m[1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m[1m[0m        