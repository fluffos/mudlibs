":"羅羅亞  索隆(fanny)","title":"●Hi",]),}),"no_sac":1,"id":"board","capacity":100,"board_id":"bennyng_b","no_clean_up":1,"location":"/u/b/bennyng/workroom.c","name":"黑瞳流言板","unit":"面","no_get":1,"long":"這是黑瞳流言板 你忍不住想要在上面留下你的寶貴建議。",])
