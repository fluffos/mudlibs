    arrow_pose[i][\"attack\"] += random(ar->roll+(ar->multipler*ar->range));                  arrow_pose[i][\"force\"] += ar->bonus;                  arrow_pose[i][\"strength\"] += arrow->query(\"arrow\");                  if( !sks && random(250) > (int)skl) {                     SKILL_D(skill)->attack_using(me, target, weapon);                     return;                    } else {                           damage = COMBAT_D->fight(me, target, skill , arrow_pose[i], weapon, arrow);                           message_vision(\"$N身上的$n用完了。\\n\",me,arrow);                           destruct(arrow);                           me->delete_temp(\"arrow\");                    }                    if( damage > 0 ) {                        me->improve_skill(\"nine-first-arrow\", 2 + random(me->query_attr(\"int\")) + random(me->query_attr(\"cps\")));                        me->improve_skill(skill,2 + random(me->query_attr(\"int\")));                        me->gain_score(\"weapon mastery\",1);                     } else me->gain_score(\"weapon mastery\",1);//       下面這段為身上箭矢超過一的情況                } else {                    i = random(sizeof(arrow_pose));                    ar = arrow->query(\"damage/arrow\");                    arrow_pose[i][\"attack\"] += random(ar->roll+(ar->multipler*ar->range));                    arrow_pose[i][\"force\"] += ar->bonus;                    arrow_pose[i][\"strength\"] += arrow->query(\"arrow\");                    if( !sks && random(250) > (int)skl) {                      SKILL_D(skill)->attack_using(me, target, weapon);                      return;                    } else {                           damage = COMBAT_D->fight(me, target, skill , arrow_pose[i], weapon, arrow);                           arrow->add_amount(-1);                    }                    if( damage > 0 ) {                        me->improve_skill(\"nine-first-arrow\", 2 + random(me->query_attr(\"int\")) + random(me->query_attr(\"cps\")));                        me->improve_skill(skill,2 + random(me->query_attr(\"int\")));                        me->gain_score(\"weapon mastery\",1);                     } else me->gain_score(\"weapon mastery\",1);                    }    }//       沒有裝備箭矢      } else {        if( !sks && random(250) > (int)skl) {           SKILL_D(skill)->attack_using(me, target, weapon);           return;        } else damage = COMBAT_D->fight(me, target, skill , pose[random(sizeof(pose))], weapon);        if( damage > 0 ) {          me->improve_skill(skill,2 + random(me->query_attr(\"int\")));          me->gain_score(\"weapon mastery\",1 + random(damage));        } else me->gain_score(\"weapon mastery\",1);      }}","title":"●arrow","time":1177610764,]),(["author":"奇(tmr)","msg":"12409OJ--                   - ♀By Tmr ♂-","title":"●eric 的acm id","time":1185803995,]),(["author":"蛋夾饅頭(manto)","msg":"關於現在的 multi先前因為玩家發現某人 multi (lv > 25 開好幾隻)隨後檢舉，因為我那時候不了解 multi 的規則是怎樣，玩家也沒講清楚是哪幾隻該抓 (因為有> 25 < 25的char)然後檢舉者用幫會頻道討論並且跟我說，結果該 multi 者擁有檢舉者幫會某玩家的 Pw，(檢舉者稱呼為內間)因此看到後立即離線...(我還在看help robot rules)請問此時我應該要如何處理要抓哪幾隻？或是不管？要如何跟檢舉者解釋？","title":"●關於 multi","time":1191045732,]),(["author":"奇(tmr)","msg":"http://cid-a1def4aa216d3ecd.spaces.live.com/--                   - ♀By Tmr ♂-","title":"●DS 2007/09/30 網聚","time":1191244642,]),(["author":"奇(tmr)","msg":"=======================霹靂套裝武學==========================□傲刀訣：『一刀傾城、一刀天下、傲刀無雙、刀捲蒼穹、刀嘯滄海、刀舞天華』□移花術：『移花接木、移花散影』□中行錄：『中行運心、中行十轉、中行破十方』□謬象心經：『八意荒流、萍渡凌波、捼花碎骨、驚鴻翻舞‧勾、謬象歸冥、春城飛雨．濛、迴流雙影』□正一天道：『五鬼運通‧現、天幡無極‧邪魅辟易、召魂術、靈符指路、靈符顯像、乾坤借法、靈符追影、文殊印‧天雷殛、定天光‧乾坤借法、天羅網‧法印生、靈符鎖形、天地無極‧乾坤借法‧般若波羅密、天地無極‧靈符借法‧天珠關、喚魂術、天靈借法‧封、離魂保體、辟靈術、靈符化氣‧兵仞化形‧般若波羅密、天殊大法掌、兩儀生‧乾坤動‧文殊法印、八仙奇法陣、倚天之能‧借天之威‧金靈聖劍辟萬邪、天劍追靈、星靈術、五神術『靈劍起‧五神天威』、火靈焰、五星滅靈術、水星訣『破妖水泓、水星定身訣』、靈劍天闕、破魔劍、天地無極‧陰陽借法‧七星借法、明王請陣‧七將封靈‧靈劍天威、借體移靈、開天眼‧辨靈體‧現、天地無極‧乾坤借法‧開天路‧步雲階‧行、轉天命‧開生機‧風火輪、天地無極‧乾坤借法‧撥陰陽‧動日月‧開天門、天地無極‧乾坤借法‧法天地‧ 分無常‧開、法動乾坤‧無常、驚虹之威破九環、御劍飛行、天雷法指、九九迴圈、九九分途、烙骨大法、熾羽火翎、行道彌止、兩儀乾坤歸原陣、朱翎化形．朱雀火、龍騰雲霧．天旗現臨、五雷天咒、萬法天網、大周天四方鎮惡陣、六甲壇法、逆轉陰陽天地奇法、澤風破、震天雷、烙骨大法』□天劍無雙：『名劍無雙‧絕代雙驕、天劍無雙‧一氣震九霄、天劍無雙‧天理不容』□隨風刀法：『如影隨形、吹影糾形』□縱橫刀法：『縱霸天下、橫掃四海』□解脫劍訣：『一劍解脫、六根解脫』□武皇劍招：『點落八方、凌虛御風、斷鶴續鳧、篷飄萍轉、四式連貫、恨遺明珠』□佾雲劍式：『舞秋月‧佾江風‧也是疏狂也任真、舞佾江月任八方、江風舞秋月、八佾舞劍』□闇日神功\：『鬼泣山河、魔嘯動九天、血浪貫日』□判死劍招：『天字訣、地字訣、人字訣』□陰冥三訣：『陰道枉生、陰道召魂』□三萌劍法：『三萌品、五訣萌生』□玄雷三式：『指點迷津、回頭是岸、玄雷擊頂』□四時江雨：『固身、誘敵、圖機、速殺』□五絕神功\：『盲目神劍、幻形神拳、太陽一指神功\、寒冰掌、如意祕笈、昊陽貫宇』□陰風六絕：『蠱風』□血刃六邪：『滿天飛首、萬里血河、無向邪刃』□天絕六式：『雷厲風行、回黃轉綠、星羅棋布、流金鑠石、匣劍惟燈、伏尸遍野』□六識劍法：『一劍傲天嶽、揮劍天下識、不識劍中身、一劍斬春風』□六絃天式：『金剛極式、森羅萬象、滄海月明、氣傲天蒼』□六合武冊：『佛手水劍寒氣凍液、天雷吼、左流星‧轟天擊地、右流星‧拳傾天下、煉金手、走劍行刀、劍走刀行旋空殺』□七色忍法：『綠甲龍捲斬、黑翼龍霸式、白魘龍幻殺』□魔指七絕：『一指穿雲、雙道無邊、三迴曲直、四海起浪、六方破極、七世歸宗、七絕招魂』□才子七劍：『拭水秋風、飛雨擎雲』□八法眼藏：『八眼照天』□八風劍式：『毀劍式、苦劍式、樂劍式、衰敗之劍、悲風無倫、毀劍破十方、八風無煙』□獨步九訣：『收、轉、逆、抽、破、挑、扣、掄、掃』□九思劍法：『一念無涯、九思無垠、九思變、九思萌識、拔劍不思理、用劍不思招、棄劍不思危、悟劍不思明、有劍無劍九成敗、無劍有劍十分成』□天地無極：『天浪貫右、地雲行左』□劍舞九天：『神靈同悲、神靈照氣』□狂魔槍法：『狂魔滅世、狂魔暴起、怒極魔威、毀天滅地』□無瑕劍法：『夜空無暇、劍舞瑕光、冷玉無瑕』□破世陰字：『破、凶、殘、極、滅、哭、喪七字訣』□無上魔法：『引歸殺象、飛傳渡空、千里追音法、遊魂離體、隔空移物、鬼形之氣、借體移位、殺象形氣、星源探路、虛轉輪迴滅、魔法查實、探源追溯、放磁束跡、一體同觀術、鬼引空心、靈光反撲、飛魔穿雲、行屍走魂術、梟音鬼聲、極法定無形、火龍金魔體、滿貫妖騰、行殺之手、千里追音法、鬼行亟電、守元大法‧ 化方為圓、離魂迷圖、借體移位、拜形催氣、柔剛並合催形化氣、焚化氣、分筋去脈、行屍走魂術、魔象鬼鎖、陰陽鬼聲、魔形魅影』□焚如要術：『推蜃手、閃靈蟒鱗指、摧形指、赤煉鎖金手』□千飛劍法：『千影飛梭、如影千梭、雪影千鋒、千影流矢、千飛極影』□陰陽雙冊：『陰陽無邊、血翼邪凰‧弒、邪能絕式‧化體之靈‧陰陽極、血指邪陽、陰風雙斬、陰風泣月掌、陰陽雙掌、邪能三分、破冥指、邪元爆、天邪極』□紅塵劍招：『烽火紅塵路、紅塵一步終、御劍術、忘棄紅塵、紅塵冉冉、穿越紅塵不擾關‧迴旋天地去復還、紅塵輪迴』□神農夜煉：『百花齊放、斷草廢根、九世閻羅淚\』□得意劍法：『寄心暢意、快意秋風、白馬長馳疾萬里』□武痴絕學：天字訣『御武玄風、天外有天、武行八方、天絕俱滅、御武行八方』、虛字訣『行雨流雲、虛無飄渺』、地字訣『地一歸元』、玄字訣『烙骨大法』、人字訣『劍武、天外刀、恒武掌』□邪帝絕學：『邪魅摘雷手、鬼泣悲鳴、邪魅月引、邪指破天、邪之魘、邪翊天華、幽幻九玄掌、九重天』□獸禽三步絕：『星離雨散、風馳電掣、刀始劍終』□急川流刀法：『怒斬宇宙、天河怒流』□還神三分法：『神打大羅、氣掌如來、精振菩提』□血歃裁判訣：『天裁式、地判式、人決式』□狂龍八斬法：『迴龍逆斬、夜龍一炬、離刀斬、一字刀法、江山易手、呼龍嘯天、廬山不動一劍痕、亢龍有悔』□菩薩印十式：『聖光初現、莊嚴慈航、巍巍三藏、菩薩引渡、初離迷界、天佛降世、佛渡眾生、佛法無邊、菩薩歸元、蓮法靈光照大千』□弧月十一式：『月狂殺、月無常』□如意十二式：『吸、放、鎖、纏、掠、搓、劈、挑、鉤、擊、化、轉』□天官十二式：『焱世烈煬流、火煉轟天式、暴雷震地式、燎原十方無名火』□川涼十二式：『川浪不息、銀川劍流、怒嘯千里、銀川破浪嘯千鋒、雙劍走天荒、萬劍天網、心定劍行、一劍霜寒四川流、一劍怒焰震九州、一劍霜雪漫八方、一劍驚雷破五嶽』□天龍十八式：『火龍燄、玄龍震、天龍泣、怒龍殺、狂龍暴、五星御龍行、破雲貫日萬龍騰、威震山河狂龍爆、雷捲烽火破龍鳴』□妖刀訣十三式：『刀舞妖光、妖刀闢血、妖刀泣鬼神、妖刀銑﹝烍﹞、妖刀行﹝運﹞轉、妖舞風雷震九霄、鎖脈冰封‧斜斬刀式、祅政﹝妖刀﹞破神荒、奔雷－衍生招：雷嘯千里、烈火－衍生招：祅政﹝妖刀﹞之火、烽火無盡、暴風－衍生招：祅政﹝妖刀﹞妖刀之風、怒潮－衍生招：冰封千里、妖焰十字斬－衍生招：妖炎十字、妖刀連焰十方原月 』□驚雁二十四式：雁鳴三法『秋鳴落葉殘飛雁、雁嘯林間、怒鳴飛雁』、急雁六招『雁渡寒潭凌空影、秋水隔斷萬里泓』、怒雁七式『怒雁穿雲、雁‧斷魂、雁‧飛殘』、雁守八關□天罡\三十六式：『日月星光，萬源歸宗，五雷殛頂』□驚天六十四式：『百川匯宗、氣定形轉、光影流行、萬流歸一、天殘地缺、乘風破浪、分釵斷帶、風捲殘雲、光燄萬丈』□地煞七十二招：『七星星光、八門金鎖、倒轉乾坤、七十二地煞綜合一氣』□狂龍傲天武訣：『狂龍八斬法、橫掃天下、排山倒海、存心轉念、蟠龍鎖關、凌渡天關、無影雙梭、排闥直入、土崩瓦解、天地合一、風行草偃、珠鳳訣‧火鳳展翅』□王者之路十一式：『秋末悲歌、廬山不動一劍痕、慾望之海、日月同天、心劍、隨心所欲、無怨無尤、忘棄紅塵、瀝血肝膽、搏命、天堂之翼』□無弦神弩十八式：『一洩千里、雙龍搶珠、雙龍出海、兩盡其妙、三分鼎足、三國鼎立、四象歸一、四面楚歌、五馬分屍、六道輪迴、九九歸元、十萬火急』□天地人三才奇門陣：『地門‧五行困神陣、人門‧幻影魅形陣』--                   - ♀By Tmr ♂-","title":"●霹靂武學","time":1192114008,]),(["author":"奇(tmr)","msg":"□ 守護者 (guardian)  Major Designer: Tmr守護者是一個精通斧術及使用盾牌的專家，擁有多樣化的盾技相關技能，更擅長突破及摧毀敵人的防禦。◎ 技能相關文件                斧術 - 旋風斧        盾技 - 撞擊               盾劈                粉碎                碎甲                戰鬥覺醒        鋼鐵意志 - 有效發揮出每件裝備的防禦程度        重整旗鼓 - 在一瞬間恢復身體至最佳狀況，可快速進入下一次戰鬥。        巨象形態 - 守護者的無敵技能，能將所受的傷害，大幅度地反射給敵人。Create Tmr 2007/01/10===============================================================================□ 守護者 (guardian)守護者是一個精通斧術及使用盾牌的專家，擁有多樣化的盾技相關技能，更擅長突破及摧毀敵人的防禦。初階導師：『大地戰士』蓋\亞(Gaia Master)          進階導師：『風暴破碎者』史東博瑞克(Stermbreaker Master)          ◎ 技能相關文件              ※初階技能          斧術 - 旋風斧(whirlwind_axe)        盾技 - 盾牌猛擊(shield_bash)        戰鬥意志(combat_mind)              ※進階技能        斧術 - 奧丁之怒(odin_axe)        盾技 - 鋼鐵之牆(steel_shield)                   ◎ 人物                ※ 『風暴破碎者』史東博瑞克(Stermbreaker Master)    史東博瑞克為人正直、沉穩，年輕時在遙遠的西方大國擔任皇家的護衛隊隊長，一手成立了『鐵之盾』侍衛隊，專門保護著國王與皇族們的安全，在他的盾牌之前，擋住了無數次來自陰影的攻擊，以及外來的侵略。    有一次國王出巡民間時，忽然周圍捲起一陣龍捲風，快速的逼近國王一行人，史東見到無法躲開，立刻站在王的前面，舉起盾牌大喊一聲向龍捲風撞去，只見龍捲風在史東的衝擊之下消失了，因此王賜給『風暴破碎者』的稱號。                在國王去世之後，史東就離開了侍衛隊四處遊歷，成為鄉野傳奇，據說他的身影最後被人看見時，是在往東方的荒漠之中。                                ※ 『大地戰士』蓋\亞(Gaia Master)                                 蓋\亞並不是他的本名，他在小的時候只是個樸實的農村小孩，不喜歡說話，因此常常被同年齡的孩子欺負，但他都不以為意。有一次村裡的孩子在村外玩耍時，被狼群襲擊，蓋\亞反而冷靜的指揮大家逃跑，逃跑期間有一個小孩子不小心跌倒在地上，蓋\亞奮不顧身的衝上前保護他，因此被狼爪抓傷，正當兩個小孩認為自己即將面臨死亡之際，一個鋼鐵般的身影用手中的盾牌將飛撲上來的野狼擊飛，而另一手中的巨斧則在瞬間把包圍兩人的狼群全部斬殺。隨後趕到的村人眼見這一幕，感激的將此人迎至村中招待，宴會之中，蓋\亞請求這位名叫史東的男子傳授他戰鬥技巧，因為蓋\亞所居住的村莊收成很好，常常引起附近的野獸、哥布林等的攻擊，而蓋\亞的父親就是在一次戰鬥中喪生的，所以蓋\亞希望他也能像他父親一樣，為保護村子而努力。史東受到蓋\亞的感動，因此答應他的要求，從此住在村莊裡教導蓋\亞，並且給了他一個別名『蓋\亞』，希望他能夠像大地一樣的堅韌，蓋\亞長大之後，果然數度的成功\的捍衛的村莊的安全，他戰士般的身影，更是村莊安心的來源，而且他也教導村莊裡的其他人防衛的技巧，讓村莊更為安全。◎ 技能說明                ※初階技能          斧術 - 旋風斧(whirlwind_axe)                旋風斧是守護者的基本戰鬥技巧，起初只是利用斧頭重且大        的特性用來訓練臂力，但史東在一次揮舞中發現，若是在揮        舞的過程中利用斧頭本身的重量，在加上人所施予的力氣，        能夠達到一些不錯的戰鬥效果，因此創出了『旋風斧』。                發動        %N揮舞著手中的%W，使出了『旋風斧』，在地面上造成了一陣風壓。                特攻                                盾技 - 盾牌猛擊(shield_bash)        戰鬥意志(combat_mind)              ※進階技能        斧術 - 奧丁之怒(odin_axe)        盾技 - 鋼鐵之牆(steel_shield)--                   - ♀By Tmr ♂-","title":"●guardian","time":1192268937,]),(["author":"奇(tmr)","msg":"【神族】ＣＣ(Deaon): love 要改 4 6 4 6 or 4 6 5 5【神族】ＣＣ(Deaon): wind 我看 6 7 0 7 or 5 8 0 7 or 5 7 0 8--                   - ♀By Tmr ♂-","title":"●class update","time":1192448980,]),(["author":"奇(tmr)","msg":"泰坦魔芋花(Titan Arum)，又稱為“屍花”，它還有更形象的一個名字“屍臭魔芋”。此花生長與蘇門答臘群島，花齡為150 年左右，成花預計可以高達1。8 米左右，是世界上體型最大的花。它有著類似馬鈴薯一樣的根莖。等到花冠展開後，呈紅紫色的花朵將持續開放幾天的時間，散發出的屍臭味也會急劇增加。當花朵凋落後，這株植物就又一次進入了休眠期。而它散發出的像臭襪子或是腐爛屍體的味道，是想吸引蒼蠅和以吃腐肉為生的甲蟲前來授粉。它非常豔麗，比你能想像到的任何東西都要美，然而這種美得出奇的花朵確實是生長在我們這個星球上的，現在依然還有存在於世界之中。而它遙遠的祖先“屍香魔芋”，早已滅絕千年之久，這種魔鬼之花，用它妖豔的顏色，詭異的清香，製造出一個又一個由幻相所組成的陷阱，引誘著人們走向死亡，傳說中“屍香魔芋花”就是守護索羅門王寶藏的惡鬼。a--                   - ♀By Tmr ♂-","title":"●屍香魔芋","time":1192600409,]),(["author":"蛋夾饅頭(manto)","msg":"string break_chinese_string(string str, int len, mixed indent){    string indent_str;    int cntr;    if( !stringp(str) ) return 0;    if( intp(indent) ) indent_str = sprintf(\"%*s\", indent, \" \");    else if( stringp(indent) ) indent_str = indent;    else indent_str = \"\";    cntr = 0;    // strip all newlines.    str = replace_string(str, \"\\n\", \"\");    while( strlen(str) > cntr + len ) {        int br, i;        for(i=0; i<len;) {            if( is_chinese(str[cntr+i..<1]) ) {                br = cntr+i;                i++;            }            if( str[cntr+i]==' ' )                br = cntr+i;            i++;        }        cntr+=i;        str = str[0..br-1] + \"\\n\" + indent_str + str[br..<1];    }    return str;}","title":"●斷行","time":1193416901,]),(["author":"蛋夾饅頭(manto)","msg":"修改 source code 中的 lex.c修改內容如下約 1717 行                    case '\\n':                        current_line++;                        total_lines++;                        if (outp == last_nl + 1) refill_buffer();                        *to++ = '\\n';                        break;                                           case '\\\\':                        if((((unsigned char)*(outp-2) >=0xa1)                           && ((unsigned char)*(outp-2) <= 0xfe))                           && ((unsigned char)*(outp) != 'n')                           && ((unsigned char)*(outp) != 't'))                        {                            *to++ = c;                            break;                        }                        /* Don't copy the \\ in yet */                        switch((unsigned char)*outp++) {                        case '\\n':----------約 1820 行      case '\\\\':                           if((((unsigned char)*(outp-2) >=0xa1)                              && ((unsigned char)*(outp-2) <= 0xfe))                              && ((unsigned char)*(outp) != 'n')                              && ((unsigned char)*(outp) != 't'))                           {                               *yyp++ = c;                               break;                           }                           /* Don't copy the \\ in yet */                           switch((unsigned char)*outp++) {                           case '\\n':x","title":"●lex.c","time":1193488102,]),(["author":"奇(tmr)