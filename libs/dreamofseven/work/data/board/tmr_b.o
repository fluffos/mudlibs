dbase (["master":({"tmr",}),"location":"/u/t/tmr/room/square.c","notes":({(["author":"月隱(moonhide)","msg":"#include <ansi.h>inherit NPC;void create(){        set_name(\"秘密客\", ({ \"mimi guard\",\"guard\" }) );        set(\"long\",\"長年守在古墓密室下的神秘人，目的在防止出沒的怪獸。\\n\");        set(\"level\",20+random(15));        set(\"age\",38+random(4));         set(\"title\",HIG\"秘\"NOR);        set(\"combat_exp\", 30000);        set(\"chat_chance\",12 );        set(\"chat_msg\", ({  \"秘密客說：快走快走，這裡很危險，隨時會有怪獸出沒!!\\n\", }));         set_skill(\"parry\", 80);        set_skill(\"unarmed\", 90);        set_skill(\"dodge\", 130);        setup();        carry_object(__DIR__\"obj/mi-helmet\")->wear(); }void die() {object ob;         if( !ob = query_temp(\"last_damage_from\") )        ob = this_player(1);        if( !ob )         {         ob->add(\"popularity\",1);                 ::die();                return;        }}update成功\但是打不死哪寫錯了?找不到?--[36m                        ╮      ╮      ╭      [0m[0;5;36m[5m[5m[5m[5m[5m[5m[5m~[5m[5m[5m[5m[5m[5m~[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m~[5m[5m[5m[5m[5m[5m~[5m[5m[5m[5m[0m[36m║║║║  ║║  ║║  ║║  ║  ║  ║  ║╠═╝[0m[0;5;36;41m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m [5m [5m[5m[5m[5m[5m [5m [5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[0m ","title":"●help","time":1019559593,]),(["author":"可愛的小凱(alickyuen)","msg":"Dev-c++出了5 beta版了喔~..--☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★★　　　☆發呆☆　與　☆神聖☆　並重的小巫師　　　　　　　☆★　　　　　　　　　　　　　　　　ＡＬＩＣＫＹＵＥＮ　字　☆☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★","title":"●to tmr,bow","time":1020126212,]),(["author":"奇(tmr)","msg":"http://tw.msnusers.com/v7fm8cu75f89ogeeljjli84o95訓練程式邏輯用。--                   - ♀By Tmr ♂-","title":"●我的社群","time":1020243751,]),(["author":"王八蛋袁世凱(alickyuen)","msg":"/u/a/alickyuen> 【閒聊】麻辣迷你兔(Funny)﹕XD是啥意思啊!?