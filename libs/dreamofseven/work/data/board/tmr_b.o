ect me, object ob, object wp, int dam);mapping* pose = ({([ \"action\":\"$n凝結手印,身上發出了淡淡的佛光,正是如來神掌的起手式!\\n\\n\\t\\t\\t【\"HIY\"如來神掌\"HIB\"《\"HIM\"第一式\"HIB\"》\"HIW\"】\\n\\t\\t\\t\"HIW\"§§※\"HIB\"佛\"HIW\"※\"HIB\"光\"HIW\"※\"HIB\"初\"HIW\"※\"HIB\"現\"HIW\"※§§\\n\\n\"NOR,          \"damage_type\":   \"瘀傷\",          \"attack\":         50,          \"defense\":        10,          \"strength\":       9000,     ]),([ \"action\":\"$n凝結手印,身上發出了淡淡的佛光,正是如來神掌的起手式!\\n\\n\\t\\t\\t【\"HIY\"如來神掌\"HIB\"《\"HIM\"第二式\"HIB\"》\"HIW\"】\\n\"NOR\\t\\t\\t\"HIW\"§§※\"HIB\"金\"HIW\"※\"HIB\"頂\"HIW\"※\"HIB\"佛\"HIW\"※\"HIB\"燈\"HIW\"※§§\\n\\n\"NOR,          \"damage_type\":   \"瘀傷\",          \"attack\":         100,          \"strength\":       15000,     ]),([ \"action\":\"$n凝結手印,身上發出了淡淡的佛光,正是如來神掌的起手式!\\n\\n\\t\\t\\t【\"HIY\"如來神掌\"HIB\"《\"HIM\"第三式\"HIB\"》\"HIW\"】\\n\"NOR\\t\\t\\t\"HIW\"§§※\"HIB\"佛\"HIW\"※\"HIB\"動\"HIW\"※\"HIB\"山\"HIW\"※\"HIB\"河\"HIW\"※§§\\n\\n\"NOR,          \"damage_type\":   \"抓傷\",          \"attack\":         70,          \"strangth\":       10000,]),([ \"action\":\"$n凝結手印,身上發出了淡淡的佛光,正是如來神掌的起手式!\\n\\n\\t\\t\\t【\"HIY\"如來神掌\"HIB\"《\"HIM\"第四式\"HIB\"》\"HIW\"】\\n\"NOR\\t\\t\\t\"HIW\"§§※\"HIB\"佛\"HIW\"※\"HIB\"問\"HIW\"※\"HIB\"迦\"HIW\"※\"HIB\"藍\"HIW\"※§§\\n\\n\"NOR,          \"damage_type\":   \"內傷\",          \"defense\":        50,          \"strength\":       14000,        ]),([ \"action\":\"$n凝結手印,身上發出了淡淡的佛光,正是如來神掌的起手式!\\n\\n\\t\\t\\t【\"HIY\"如來神掌\"HIB\"《\"HIM\"第五式\"HIB\"》\"HIW\"】\\n\"NOR\\t\\t\\t\"HIW\"§§※\"HIB\"迎\"HIW\"※\"HIB\"佛\"HIW\"※\"HIB\"西\"HIW\"※\"HIB\"天\"HIW\"※§§\\n\\n\"NOR,          \"damage_type\":   \"撞傷\",          \"attack\":         50,          \"defense\":       -10,          \"strength\":       13000,        ]),([ \"action\":\"$n凝結手印,身上發出了淡淡的佛光,正是如來神掌的起手式!\\n\\n\\t\\t\\t【\"HIY\"如來神掌\"HIB\"《\"HIM\"第六式\"HIB\"》\"HIW\"】\\n\"NOR\\t\\t\\t\"HIW\"§§※\"HIB\"佛\"HIW\"※\"HIB\"光\"HIW\"※\"HIB\"普\"HIW\"※\"HIB\"照\"HIW\"※§§\\n\\n\"NOR,          \"damage_type\":   \"內傷\",          \"attack\":         25,          \"defense\":        40,          \"strength\":       14000,        ]),([ \"action\":\"$n凝結手印,身上發出了淡淡的佛光,正是如來神掌的起手式!\\n\\n\\t\\t\\t【\"HIY\"如來神掌\"HIB\"《\"HIM\"第七式\"HIB\"》\"HIW\"】\\n\"NOR\\t\\t\\t\"HIW\"§§※\"HIB\"天\"HIW\"※\"HIB\"佛\"HIW\"※\"HIB\"降\"HIW\"※\"HIB\"世\"HIW\"※§§\\n\\n\"NOR,          \"damage_type\":   \"瘀傷\",          \"attack\":         90,          \"defense\":       -40,          \"strength\":       15000,        ]),([ \"action\":\"$n凝結手印,身上發出了淡淡的佛光,正是如來神掌的起手式!\\n\\n\\t\\t\\t【\"HIY\"如來神掌\"HIB\"《\"HIM\"第八式\"HIB\"》\"HIW\"】\\n\"NOR\\t\\t\\t\"HIW\"§§※\"HIB\"佛\"HIW\"※\"HIB\"法\"HIW\"※\"HIB\"無\"HIW\"※\"HIB\"邊\"HIW\"※§§\\n\\n\"NOR,          \"damage_type\":   \"瘀傷\"        ]),([ \"action\":\"$n凝結手印,身上發出了淡淡的佛光,正是如來神掌的起手式!\\n\\n\\t\\t\\t【\"HIY\"如來神掌\"HIB\"《\"HIM\"第九式\"HIB\"》\"HIW\"】\\n\"NOR\\t\\t\\t\"HIW\"§§※\"HIB\"萬\"HIW\"※\"HIB\"佛\"HIW\"※\"HIB\"朝\"HIW\"※\"HIB\"宗\"HIW\"※§§\\n\\n\"NOR,          \"damage_type\":   \"瘀傷\"    \"post_action\" : (: do_buddha :),    ]),});void do_buddha(object me, object ob, object weapon, int dam){     int i;message_vision(HIW\"\\t\\t\\t卍\"BBLU\"\"HIR\"佛光初現\"HIW\"卍        \"HIW\"卍\\n\"NOR          BRED\"\\t\\t\\t\"HIY\"金        \"BGRN\"\"HIB\"佛\\n\"NOR          BRED\"\\t\\t\\t\"HIY\"頂        \"BGRN\"\"HIB\"法\\n\"NOR          BRED\"\\t\\t\\t\"HIY\"佛        \"BGRN\"\"HIB\"無\\n\"NOR          BRED\"\\t\\t\\t\"HIY\"燈        \"BGRN\"\"HIB\"邊\\n\"NORHIW\"\\t\\t\\t卍\"BYEL\"佛動山河\"HIW\"卍\"BYEL\"天佛降世\"HIW\"卍\\n\"NORBGRN\"\\t\\t\\t\"HIB\"佛        \"BRED\"\"HIY\"迎\\n\"NORBGRN\"\\t\\t\\t\"HIB\"問        \"BRED\"\"HIY\"佛\\n\"NORBGRN\"\\t\\t\\t\"HIB\"迦        \"BRED\"\"HIY\"西\\n\"NORBGRN\"\\t\\t\\t\"HIB\"藍        \"BRED\"\"HIY\"天\\n\"NORHIW\"\\t\\t\\t卍        \"HIW\"卍\"BBLU\"\"HIR\"佛光普照\"HIW\"卍\\n\"NOR,me,target);        for(i=0;i<9;i++) {        target->damage_stat(\"kee\", 200);target->start_busy(random(5));COMBAT_D->report_status(target);}}void create(){    seteuid(getuid());    DAEMON_D->register_skill_daemon(\"buddha-unarmed\");    setup();}int valid_enable(string base_skill){    return base_skill==\"unarmed\";}void attack_using (object me, object target, object weapon){        string sk;        int damage;         sk = \"buddha-unarmed\";        if (!target) {                if (me->query_temp(\"last_attacked_target\"))                message_vision( CYN \"$N口中喃喃唸著: 阿彌陀佛 ...。\\n\" NOR, me);                return;        }        skill = skill[7..];                if (!me->query_skill(sk) && random(200) > (int)me->query_learn(sk)) {                SKILL_D(\"unarmed\")->attack_using(me, target, weapon);                return;        } else                damage = COMBAT_D->fight(me, target, \"unarmed\",pose[random(sizeof(pose))], weapon);         if(damage > 0) {                me->improve_skill (sk, 1 + random(me->query_attr(\"int\")));                me->improve_skill (\"unarmed\", 1 + random(me->query_attr(\"int\")/3));                me->gain_score(\"martial art\", 1);        }}void skill_improved(object me){        int skill, learn;    skill = me->query_skill(\"buddha-unarmed\",1);    learn = me->query_learn(\"buddha-unarmed\",1);        if( !skill ) {        if( learn >= 1600 ) {            me->advance_skill(\"buddha-unarmed\", 25);            tell_object(me, HIW \"你對「如來神掌」似乎有更深的悟道了。\\n\" NOR);            me->gain_score(\"martial art\", 900);                }        }  if( ( skill < 130 ) && (skill-24) * (skill-15) * 400 < learn - 1600 ) {        me->advance_skill(\"buddha-unarmed\", 1);        me->gain_score(\"martial art\", (skill+1) * 20 );            if( skill > 30 )                me->gain_score(\"martial mastery\", (skill-30) * 25);        }}","title":"●如來神掌","time":1169605084,]),(["author":"千嬅(miriam)","msg":"([        \"action\":\"$N大喝: \"HIR\"*** 雷奔斬劈 ***\\n\\n\"NOR\"$N\"HIR\"手中之斧有若狂雷一瀉而下之勢往\"NOR\"$n\"HIR\"直劈，\"NOR,\"damage_type\":  \"劈傷\",]),([        \"action\":\"$N大喝: \"HIY\"< < < 龍磐崑崙 > > >\\n\\n\"NOR\"$N\"HIY\"手中之斧幻化為黃金絞龍直朝著\"NOR\"$n\"HIY\"攻去，\"NOR,\"damage_type\":  \"噬傷\",]),([        \"action\":\"$N大喝: \"HIW\"*** 瘋斧怒濤 ***\\n\\n\"NOR\"$N\"HIR\"眼中紅光劇盛，手中之斧不停的發出鳴響 一股排身倒海的氣勢韻量著\\n\\n\"NOR\"$N\"HIW\"手中之斧化做無數的光點直奔\"NOR\"$n，\",\"damage_type\":  \"殛傷\",]),","title":"●some axe sk","time":1169605198,]),(["author":"千嬅(miriam)","msg":"招式 \"\\n$N一聲怒吼，\"HIB\"水龍道\"HIW\"‧\"HIM\"逆水之爪\"NOR\"抓向$n的$l\", \"\\n$N巨爪一揮，\"HIB\"水龍道\"HIW\"‧\"HIY\"水箭之爪\"NOR\"四支水箭從爪尖射擊$n的$l\", \"\\n$N龍聲一吼\"HIB\"水龍道\"HIW\"‧\"HIR\"冰山之爪\"NOR\"，無數的水點化為冰塊向$n的$l擁去\",\"\\n$N憤怒吼叫，\"HIB\"水龍道\"HIW\"‧\"HIR\"殺戮之爪\"NOR\"向$n的$l連環狂抓\",特功\                        message_vision(HIW\"\\n\\t\\t\\t\\t《\"HIB\"水  龍  八  重  天\"HIW\"》\\n\"NOR,me,ob);\"\\n\\t\\t\\t  \"HIR\"【\"HIB\"第  一  重  天\"HIR\"】\\n\"HIY\"天昏地暗\"NOR\"攻向$n，\",\"\\n\\t\\t\\t  \"HIR\"【\"HIB\"第  二  重  天\"HIR\"】\\n\"HIG\"天衣無縫\"NOR\"攻向$n，\",\"\\n\\t\\t\\t  \"HIR\"【\"HIB\"第  三  重  天\"HIR\"】\\n\"HIM\"天打雷劈\"NOR\"攻向$n，\",\"\\n\\t\\t\\t  \"HIR\"【\"HIB\"第  四  重  天\"HIR\"】\\n\"HIW\"天旋地轉\"NOR\"攻向$n，\",\"\\n\\t\\t\\t  \"HIR\"【\"HIB\"第  五  重  天\"HIR\"】\\n\"HIY\"天翻地覆\"NOR\"攻向$n，\",\"\\n\\t\\t\\t  \"HIR\"【\"HIB\"第  六  重  天\"HIR\"】\\n\"HIG\"天下大亂\"NOR\"攻向$n，\",\"\\n\\t\\t\\t  \"HIR\"【\"HIB\"第  七  重  天\"HIR\"】\\n\"HIM\"天下無雙\"NOR\"攻向$n，\",\"\\n\\t\\t\\t  \"HIR\"【\"HIB\"第  八  重  天\"HIR\"】\\n\"HIW\"天地同壽\"NOR\"攻向$n，\",","title":"●水龍道(waterdragon-claw)","time":1169605332,]),(["author":"千嬅(miriam)","msg":"#include <ansi.h>#include <combat.h>inherit F_SSERVER;int perform(object me, object target){        int extra,i,hit,damage;        string msg;        object weapon;        extra = (int)me->query_skill(\"hantian-jianfa\",1);        if (!target ) target = offensive_target(me);        if (!objectp(weapon = me->query_temp(\"weapon\"))        || (string)weapon->query(\"skill_type\") != \"sword\")        return notify_fail(HIY\"裝備劍才能使用「梅花飛散」？\\n\"NOR);        if (!target || !target->is_character() || !me->is_fighting(target) )        return notify_fail(\"「梅花飛散」只能對戰斗中的對手使用。\\n\");        if ((int)me->query_skill(\"hantian-jianfa\", 1) < 50 )        return notify_fail(HIY\"你寒天劍法不夠嫻熟，使不出「梅花飛散」。\\n\"NOR);        if ((int)me->query_skill(\"hantian-shengong\", 1) < 60 )        return notify_fail(HIY\"你吹血神功\火候不夠，使不出「梅花飛散」。\\n\"NOR);        if ((int)me->query(\"max_neili\") < 600)        return notify_fail(HIY\"你內力修為不足，無法運足內力。\\n\"NOR);        if ((int)me->query(\"neili\") < 600)        me->add_temp(\"apply/attack\", extra * 2);                me->add_temp(\"apply/damage\", extra * 2);        msg = HIW\"$N手中\"+weapon->name()+\"\"HIW\"化作漫天幻影，使出了一式\"HIY\"【\"HIM\"梅花飛散\"HIY\"】\\n\\n\"NOR;        message_vision(msg, me, target);        if(extra < 100){             switch(random(2)) {               case 0:               msg  = HIW\"$N輕吟：【\"HIM\"梅花起舞，傲翔天際\"HIW\"】隨即運起吹血神功\使出了\"HIY\"《\"HIW\"以氣御劍\"HIY\"》\\n\\n\"NOR;               msg += HIW\"劍氣由\"+weapon->name()+\"\"HIW\"而出，逼得$n後退一步\\n\"NOR;               COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);               break;               case 1:               msg  = HIW\"\\n$N輕吟：【\"HIM\"梅影飄飄，隨風飛舞\"HIW\"】劍氣隨即而發，攻向$n的穴道\\n\\n\"NOR;               message_vision(msg, me, target);               if(me->query_skill(\"dodge\") > random(target->query_skill(\"dodge\"))){               msg = HIW\"劍氣直入$n的穴道，使$n動彈不得\\n\"NOR;               message_vision(msg, me, target);               target->start_busy(2);               } else {               msg = HIB\"$n身形一晃，閃過了$N所發出的劍氣\\n\"NOR;               message_vision(msg, me, target);               }               break;             }        } else if(extra < 150) {             switch(random(2)) {               case 0:               msg  = HIW\"\\n$N輕吟：【\"HIM\"梅花落葉，流水無情\"HIW\"】身形與\"HIY\"《\"HIW\"寒天劍法\"HIY\"》\"HIW\"混為一體\\n\\n\"NOR;               message_vision(msg, me, target);               for(i=0;i<4;i++)               {               msg = HIM\"$N手中的\"+weapon->name()+\"如行雲流水，劍光四散的攻向$n\\n\"NOR;               COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);               }               break;               case 1:               damage  = extra;               damage += (int)me->query_skill(\"hantian-shengong\", 1);               msg  = HIW\"\\n$N輕吟：【\"HIM\"望梅輕嘆，黯然出神\"HIW\"】一道強大的氣勁襲向$n\\n\\n\"NOR;               message_vision(msg, me, target);               if(me->query_skill(\"sword\") > random(target->query_skill(\"sword\"))){               msg = HIW\"$n被氣勁所傷，吐出了一口鮮血\\n\"NOR;               target->receive_damage(\"qi\", damage);               target->receive_wound(\"qi\", damage/2);               message_combatd(msg, me, target);               COMBAT_D->report_status(target);               } else {               msg = HIB\"$n身形一晃，閃過了$N所發出的氣勁\\n\"NOR;               message_vision(msg, me, target);               }               break;             }        } else {        hit  = (int)me->query_skill(\"hantian-jianfa\",1) / 20;        hit += (int)me->query_skill(\"hantian-shengong\", 1) / 20;            if(target->is_busy()) {               switch(random(2)) {               case 0:               msg  = HIW\"\\n$N輕吟：【\"HIM\"梅花落葉，流水無情\"HIW\"】身形與\"HIY\"《\"HIW\"寒天劍法\"HIY\"》\"HIW\"混為一體\\n\\n\"NOR;               message_vision(msg, me, target);               for(i=0;i<hit/4;i++)               {               msg = HIM\"$N手中的\"+weapon->name()+\"如行雲流水，劍光四散的攻向$n\\n\"NOR;               COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);               }               break;               case 1:               damage  = extra;               damage += (int)me->query_skill(\"hantian-shengong\", 1);               msg  = HIW\"\\n$N輕吟：【\"HIM\"望梅輕嘆，黯然出神\"HIW\"】一道強大的氣勁襲向$n\\n\\n\"NOR;               message_vision(msg, me, target);               if(me->query(\"combat_exp\") > random(target->query(\"combat_exp\"))){               msg = HIW\"$n被氣勁所傷，吐出了一口鮮血\\n\"NOR;               target->receive_damage(\"qi\", damage*4);               target->receive_wound(\"qi\", damage*2);               message_combatd(msg, me, target);               COMBAT_D->report_status(target);               } else {               msg = HIB\"$n身形一晃，閃過了$N所發出的氣勁\\n\"NOR;               message_vision(msg, me, target);               }               break;               }            } else {               switch(random(4)) {               case 0:               msg  = HIW\"\\n$N輕吟：【\"HIM\"梅花落葉，流水無情\"HIW\"】身形與\"HIY\"《\"HIW\"寒天劍法\"HIY\"》\"HIW\"混為一體\\n\\n\"NOR;               message_vision(msg, me, target);               for(i=0;i<hit/4;i++)               {               msg = HIM\"$N手中的\"+weapon->name()+\"如行雲流水，劍光四散的攻向$n\\n\"NOR;               COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);               }               break;               case 1:               damage  = extra;               damage += (int)me->query_skill(\"hantian-shengong\", 1);               msg  = HIW\"\\n$N輕吟：【\"HIM\"望梅輕嘆，黯然出神\"HIW\"】一道強大的氣勁襲向$n\\n\\n\"NOR;               message_vision(msg, me, target);               if(me->query(\"combat_exp\") > random(target->query(\"combat_exp\"))){               msg = HIW\"被氣勁所傷，吐出了一口鮮血\\n\"NOR;               target->receive_damage(\"qi\", damage*4);               target->receive_wound(\"qi\", damage*2);               message_combatd(msg, me, target);               COMBAT_D->report_status(target);               } else {               msg = HIB\"$n身形一晃，閃過了$N所發出的氣勁\\n\"NOR;               message_vision(msg, me, target);               }               break;               case 2:               msg  = HIW\"\\n$N輕吟：【\"HIM\"梅影飄飄，隨風飛舞\"HIW\"】劍氣隨即而發，攻向$n的穴道\\n\\n\"NOR;               message_vision(msg, me, target);               if(me->query(\"combat_exp\") > random(target->query(\"combat_exp\"))){               msg = HIW\"劍氣直入$n的穴道，使$n動彈不得\\n\"NOR;               message_vision(msg, me, target);               target->start_busy( (extra / 30) + 4 );               } else {               msg = HIB\"$n身形一晃，閃過了$N所發出的劍氣\\n\"NOR;               message_vision(msg, me, target);               }               break;               case 3:               msg  = HIW\"$N輕吟：【\"HIM\"梅花起舞，傲翔天際\"HIW\"】隨即運起吹血神功\使出了\"HIY\"《\"HIW\"以氣御劍\"HIY\"》\\n\\n\"NOR;               msg += HIW\"劍氣由\"+weapon->name()+\"\"HIW\"而出，逼得$n後退一步\\n\"NOR;               COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);               break;               }            }        }        me->add_temp(\"apply/attack\", -extra * 2);           me->add_temp(\"apply/damage\", -extra * 2);        me->add(\"neili\", -200);        me->start_busy(2);        return 1;}","title":"●sword sk","time":1169605787,]),(["author":"千嬅(miriam)","msg":"string *actmsg = ({\"$F$N手一動，一式\"HIW\"【$G燦爛霞霧\"HIW\"】$F刀影如$C霞霧繚繞$F，向$n$F劈出了$D輝煌燦爛$F的一刀\"NOR\"\",\"$F$N手上的$w$F發出一道$C光芒，一式\"HIW\"【$G七彩霓虹\"HIW\"】$F如$D長虹$F般的刀氣從四方八面襲向$n\"NOR\"\",\"$F$N緊握著手上的$w$F，一式\"HIW\"【$G凝傲寒風\"HIW\"】$F，$C向天長嘯$D刀化怒蛟$F，長嘯聲中$E無數刀影$F不停的劈向$n\"NOR\"\",\"$F$N把手中的$w$F向$n$F直劈，一式\"HIW\"【$G裂地狂傲\"HIW\"】$F登時$C風雷並發$D威猛無倫$F的劈入了$n$F的$l\"NOR\"\",\"$F$N$C刀人合一$F，一式\"HIW\"【$G雷鳴斬擊\"HIW\"】$F對$n$F劈出了$D極可怕$F的致命的一刀\"NOR\"\",\"$F$N身隨刀走，一刀$C似繁若簡$D無跡可尋$F的刀勢，一式\"HIW\"【$G轟龍斷斬\"HIW\"】$F劈向$n$F$l\"NOR\"\",\"$F$N一式\"HIW\"【$G傲氣殺擊\"HIW\"】$C刀光如閃電$D氣勢如雷響$F，刀光$E綿綿不絕$F的把$n$F封殺著\"NOR\"\",\"$F忽然一式\"HIW\"【$G水靈飄日\"HIW\"】$C刀風呼嘯聲$D在四面八方響起$F，$N手上的$w$F化作黃芒疾取$n$F的$l\"NOR\"\",\"$F忽然間一式\"HIW\"【$G千擊裂斬\"HIW\"】$C千百道刀芒從$F$w$F爆發出來飛向$n$l，如$D驚芒掣電$E長虹驚天\"NOR\"\",\"$F$N向前跨上一步，一式\"HIW\"【$G星華舞動\"HIW\"】$F手中的$w$F如$C光華流竄$D星芒閃動$F，立刻就籠罩了$n\"NOR\"\",\"$F$N手腕一反，手中的$w$D刀氣衝霄$E光華耀眼$F，一式\"HIW\"【$C星火燎原\"HIW\"】$F，由上而下直劈$n$F的$l\"NOR\"\",\"$F$N將手中$w$F一揮，一式\"HIW\"【$C天旋地轉\"HIW\"】$F，幾道$D刀氣暴射而出$F，散落在$n$F的$l上\"NOR\"\",\"$F$N突然飛鷹般掠起，一式\"HIW\"【$C百烈神刀\"HIW\"】$F，刀氣如$D驚虹掣電$F，劈出了$E令人窒息$F的氣勁\"NOR\"\",\"$F$N凝聚真氣，$w$F劈出了含強大內勁的刀氣，一式\"HIW\"【$C刀劈裂破\"HIW\"】$F，內勁如萬箭穿心般打在$n$F$l\"NOR\"\",\"$F$N$D一刀接一刀越劈越快$F，一式\"HIW\"【$C連環獨劈\"HIW\"】$F，$n$F瞬間至身在$E刀影$F之中\"NOR\"\",\"$F$N身上$D光芒乍現$F，一式\"HIW\"【$C風雲變色\"HIW\"】$F，一道道刀氣從$w$F不停的攻向$n$F$l\"NOR\"\",\"$F$N人隨刀走，一式\"HIW\"【$C刀道乾坤\"HIW\"】$F，以極快的速度向$n$F劈出了如$D風捲殘雲$F般的一刀\"NOR\"\",\"$F$N飛躍空中，一式\"HIW\"【$C大鵬展翅\"HIW\"】$F，對$n$F的$D天靈蓋\\\$F劈出了至命的一刀\"NOR\"\",\"$F剎那間刀氣呼呼，一式\"HIW\"【$C排山倒海\"HIW\"】$F，$w$F如$D狂風暴雨$F般從$E四方八面$F攻擊著$n\"NOR\"\",\"$F$N身體一沉，$w$F對著$n$F$l$E劈出了五刀$F，一式\"HIW\"【$C氣蓋\\\山河\"HIW\"】$F，欲$D令人窒息$F的刀氣\"NOR\"\",\"$F$N大聲一喝，一式\"HIW\"【$C妖魔重生\"HIW\"】$F對著$n$F$l發出了$D千撕萬裂$F的一刀\"NOR\"\",\"$F$N運氣$E邪惡霸道$F的內力展開刀法，\"HIW\"【$C魔蓋\\\大地\"HIW\"】$F，向$n$F$l擊出$D痛心欲裂$F的一刀\"NOR\"\",\"$F$N向前跨上一步，剎那間$D風雲變色$F，一式\"HIW\"【$C魔氣沖天\"HIW\"】$F包含著雄厚內勁的一刀劈在$n$F的身上\"NOR\"\",\"$F$N身形一閃，手中的$w$F以極快的速度，對$n劈出了一刀如$D石破天驚$F的\"HIW\"【$C滅絕魔刀\"HIW\"】\"NOR\"\",\"$F$N的手臂發出了一聲爆響，斬出一式\"HIW\"【$C魔神震怒\"HIW\"】$F，手上的$w$F如$D閃電$F的擊向$n$F$l\"NOR\"\",\"$F$N一個側身，狂喝了一聲\"HIW\"【$C爆破魔殺\"HIW\"】$F，剎那間向$n$F劈出了$D驚天地$E泣鬼神$F的刀氣\"NOR\"\",\"$F$N一刀劈落，\"HIW\"【$C魔刀殺訣\"HIW\"】$F，向$n$F劈出了$D無与倫比$E威力巨大$F的刀氣\"NOR\"\",\"$F$N飄逸空靈，一式\"HIW\"【$C魔神刀斬\"HIW\"】$F，向$n$F劈出了$D無堅不摧$E七七四十九刀$F的刀氣\"NOR\"\",","title":"●blade sk","time":1169605845,]),(["author":"千嬅(miriam)","msg":"#include <ansi.h>#include <combat.h>#include <npc.h>inherit SSERVER;inherit F_FUNCTION;string *MSG = ({\"$B$W卍$D$C頂身印$B$W卍\"NOR\"\",\"$B$W卍$D$C數珠印$B$W卍\"NOR\"\",\"$B$W卍$D$C菩薩印$B$W卍\"NOR\"\",\"$B$W卍$D$C迦羅印$B$W卍\"NOR\"\",\"$B$W卍$D$C舍尼印$B$W卍\"NOR\"\",\"$B$W卍$D$C佛心印$B$W卍\"NOR\"\",\"$B$W卍$D$C大心印$B$W卍\"NOR\"\",\"$B$W卍$D$C般若印$B$W卍\"NOR\"\",\"$B$W卍$D$C護身印$B$W卍\"NOR\"\",\"$B$W卍$D$C隨心印$B$W卍\"NOR\"\",\"$B$W卍$D$C天法印$B$W卍\"NOR\"\",\"$B$W卍$D$C結界印$B$W卍\"NOR\"\",\"$B$W卍$D$C金輪印$B$W卍\"NOR\"\",\"$B$W卍$D$C法輪印$B$W卍\"NOR\"\",\"$B$W卍$D$C縛鬼印$B$W卍\"NOR\"\",\"$B$W卍$D$C無畏印$B$W卍\"NOR\"\",\"$B$W卍$D$C佛棒印$B$W卍\"NOR\"\",\"$B$W卍$D$C坐禪印$B$W卍\"NOR\"\",\"$B$W卍$D$C四禪印$B$W卍\"NOR\"\",\"$B$W卍$D$C地天印$B$W卍\"NOR\"\",});//這裏加多些佛教的術語string *WORD = ({        \"空無邊處定、識無邊處定、無所有處定\",});string *color = ({        HIR,HIY,HIB,HIM,HIW,HIG,HIC, });string *color2 = ({        BYEL, });string *color3 = ({        HIW, });string *color4 = ({        BWHT,BCYN,BMAG,BBLU,BGRN,BRED,});int perform(object me, object target){        int lv,time,bu,da;        string msg,msg2;        mapping cnd;        object *enemyenemy = all_inventory(environment(me));        lv = (int)me->query(\"/functions/bodyseal-sword/level\");        time = 1+ (lv/10);        if (time > 20) time = 20;        if ( (string)me->query(\"class\") != \"bonze\" )        return notify_fail(\"你不是少林僧人怎樣使用少林絕學？！\\n\");         if (!me->is_fighting() )        return notify_fail(\"「佛法身印訣」只能對戰斗中的對手使用\\n\");        if (da = (int)me->query_skill(\"damosword\", 1) < 150 )        return notify_fail(HIY\"你達摩劍法不夠，使不出「佛法身印訣」\\n\"NOR);        if (bu = (int)me->query_skill(\"buddhism\", 1) < 100 )        return notify_fail(HIY\"你大乘佛法不夠，使不出「佛法身印訣」\\n\"NOR);        if ((int)me->query(\"force\") < 400)        return notify_fail(HIY\"你不夠內力運用「佛法身印訣」\\n\"NOR);//這裡可能需要修改寫法,test看看吧        message_vision(HIW\"\\t\\t\\t『\"+WORD[random(sizeof(WORD))]+\"』\\n\"NOR,me,target);        message_vision(HIR\"\\t\\t\\t$N使出了佛門中最強的絕技--身印中的\\n\"NOR,me,target);        msg2 = MSG[random(sizeof(MSG))];        msg2 = replace_string(msg2,  \"$B\", color[random(sizeof(color2))]);        msg2 = replace_string(msg2,  \"$W\", color[random(sizeof(color3))]);        msg2 = replace_string(msg2,  \"$C\", color[random(sizeof(color))]);        msg2 = replace_string(msg2,  \"$D\", color[random(sizeof(color4))]);        message_vision(\\t\\t\\tmsg2\\n, me, target);        message_vision(HIB\"\\t\\t\\t佛光在$N身上顯現,如佛祖降臨照耀大地\\n\"NOR,me,target);for(i=0; i<sizeof(enemy); i++) {if( !living(enemy[i]) || enemy[i]==me ||                     enemy[i] !=me->query_enemy() ) continue;tell_object(enemy[i], \"你覺得有股強烈的內力進入了你的體內.\\n\");//全體的per,要怎樣設就看你了,}","title":"●buddha sk","time":1169605889,]),(["author":"千嬅(miriam)","msg":"mapping* pose = ({    ([ \"action\":\"$N手中的$w向著$n不斷的加速，使出\"HIB\"【\"HIY\"夜魂星寒\"HIW\"《\