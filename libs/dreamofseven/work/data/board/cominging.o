D+\"【台灣閒聊】\"+NOR+BOLD+\"%s\"NOR,                        \"intermud\": GCHANNEL,[0;1;30m[1mw[1m[1mw[1m[1mw[1m [1m[1m[1m[1m[1m[1m~[1m[1m[1m [1;37m([1m2[1m0[1m/[1m3[1m0[1m)[1m6[1m6[1m%[1;30m [1m[1mw[1m[1mw[1m[1mw[1m[1mw[1m[[1;37mE[1mN[1mT[1mE[1mR[1m [1;30m[1m~[1m[1m[1m[1mU[1m[1m@[1m[1m[1m[1mM[1;37mq[1;30m [1m[1m[1m[1m}[1m[1mM[1;37mb[1;30m [0m[0;1;30m[1me[1m[1m@[1m[1m[1m][1m[1mw[1m[1mw[1m[1mw[0m                        \"channel\": \"tw\",                        \"filter\": (: $1[\"LOCATION\"]==\"Taiwan\" :),                ]),頻道名稱可自行修改. 顏色亦可自訂.已有數個MUD加入, 歡迎來和同樣是身在台灣的這個大家庭連線.──────────────[0;1;30m[[1;37mE[1mn[1md[1;30m][0m───────────────--",]),(["time":953358265,"title":"●know","author":"Omaga(cominging)","msg":"http://www.nppi.edu.tw/sunshine/anti.htm-- know anti--",]),(["time":953437812,"title":"●Diary","author":"Omaga(cominging)","msg":"                    [0;1;37m[1mi[1m[1m[1m[1m[1m[1m[1m [1m[1m[1m[1m[1m [1;32m[1mw[1m[1mw[1m[1mw[1m[1mw[1m[1mw[1m[1mw[1m[1mw[1m[1mw[1m[1mw[1m[1mw[1m[1mw[1m[1mq[1m [1m [0m                    [0;1;37m[1mi[1m [1m [1m [1m [1m[1mi[1m [1m[1m[1m[1m[1m [1;32m[1mw[1;37m[1m[1m[1m[1m [1;32m[1mw[1m[1mw[1;37m[1m[1m[1m[1m [1;32m[1mw[1m[1mw[1m[1mw[1m[1mq[1m[1mq[0m                    [0;1;37m[1mi[1m [1m [1m [1m [1m[1mi[1m [1m [1m[1mi[1m [1m [1m[1mi[1m[1m[1m[1m[1m[1mi[1m [1m[1mi[1m[1m[1m[1m[1m[1mi[1m [1m[1mi[1m [1m [1m [1m [1m[1mi[0m                    [37m█    █  █  ◢◤◥█ █       █    █[0m[37m                    [0;1;30m[1mi[1m[1m[1m[1m[1m[1m[1m [1m [1m[1mi[1m [1m [1m[1mi[1m[1m[1m[1m[1m[1mi[1m [1m[1mi[1m [1m [1m [1m [1m [1m [1m [1m[1mi[1m[1m[1m[1m[1m[1mi[0m                    [0;1m[1mx[1;30m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m[1m[1m[1m[1m [