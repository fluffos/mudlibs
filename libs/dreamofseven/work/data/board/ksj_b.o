: : : ●看一下我的bug        [Mar  6]藍的喵(kenshin)的高見:: : : =============================================================: : :         }: : :   : : :         destruct(z): : :         message_vision(: : :         HIR\\n$N將邪惡代表物「犬惡石」給放進凹巢！！。\\nNOR: : :         HIG\\n頃刻間，數道金光迎面而出！！\\nNOR : : :         HIW\\n大地突然風雲變色！！\\nNOR,me): : :         message(world:world1:vision,: : :         HIR\\n\\t千古巨獸 千NOR年守HIM鶴HIW經過了千年的沉睡，再度降臨於中原！！\\n\\nNOR: : :         ,users()): : :         b->move(environment(this_object())): : :         destruct(this_object()): : :         return 1: : : }: : int do_putting 定義了 4 個 object: : 但 ob 跟 me 你並沒有說是什麼東西,通常 me=this_player(): : 而在 b->move(environment(this_object())); 之前必須先產生該物件: : 例如 b=new(__DIR__\"千年守鶴.c\" );: : 凹巢 -> 凹槽: 我可不可以說一下我的想法阿?: 我是想說..: 這這種招喚怪怪物的方式已經有很多人寫過了...: 可不可以用別種特殊的方式來寫呢?: 這樣會比較有新鮮感XD: 純屬建議..部要不要鳥我@@\"[0m這是個很好的建議...我是有想過..採用alick那個自動開war的方式把beast身上放珍貴的東西..一天自動執行兩次不知道這個建議可行ㄇ?[0m",]),(["title":"●看一下","time":1048640337,"author":"悠閒過日子(jangshow)","msg":"#include <ansi.h>  //#define RS_EN \"/open/world1/tmr/area/square.c\"inherit ITEM;void create(){     set_name(\"祭壇石\",({\"altar slab\",\"slab\"}));      set(\"long\",\"一塊大石頭，上面刻有一隻狐狸的畫像，上面沾滿了灰塵，似乎很久沒放過東西了。\\n\"                \"旁邊則撰有 [ 如要祭拜(altarage)，請放祭品，但勿放狐狸的屍體，切記！]\\n\");     set(\"no_sac\",1);      set(\"no_get\",1);     set_weight(99999999);        setup();}  void init(){        add_action(\"do_altarage\",\"altarage\");} int do_altarage(string arg){      object me=this_player(),z;        if(!me) return 0;           if(this_object()->query_temp(\"altaraged\")==1) return notify_fail(\"不久前才有人祭拜過。\\n\");        if(!arg || arg!=\"小狐狸的屍體 on slab\") return notify_fail(\"你要用什麼祭拜?\\n\");        if(!objectp(z=present(\"corpse\",me) ) )                return notify_fail(\"你沒有東西可以祭拜啊 ? \\n\");        message_vision(\"\\n$N將小狐狸的屍體放在祭壇石上。\\n\",me);           this_object()->set_temp(\"altaraged\",1);   {    destruct(z);     message_vision(\"\\n小狐狸的屍體突然往祭壇石內沉了下去‧‧‧不見了！\\n\",me);    call_out(\"GO_FOX_ONE\",10);  }     return 1;}   void GO_FOX_ONE(){     message(\"world:world1:vision\",HIR\"\\n\\n\\t.........嘿.........嘿嘿嘿嘿................\\n\\n\"NOR,users());      call_out(\"GO_FOX_TWO\",5);     return;} void GO_FOX_TWO(){     object me=this_player(),foxp,npc,room;     room=load_object(environment(this_object())->query(\"exits/southdown\"));   if( room && objectp(npc = present(\"miao-jian bonze\",room)))    {     message(\"world:world1:vision\",HIW\"\\n\\t一隻巨大的野獸，狂囂似的站在凌雲頂峰，妙見和尚見此狀‧‧‧\\n\\n\"                    +HIC\"\\t飛奔似的‧‧‧\"+HIR\"速前應戰！\\n\\n\"                    +MAG\"\\t大量妖氣不斷竄升‧‧\"+HIM\"九尾\"+HIW\"妖狐\"+NOR\"睥睨一切！\\n\\n\"+NOR,users());   foxp=new(__DIR__\"fox\");   foxp->move(environment(this_object()));    npc->move(environment(this_object()));     npc->receive_damage(\"hp\",12000);    npc->command(\"say 九尾妖狐！還不速速回塔！老僧就替天行道‧‧大開殺戒！\\n\",me);   npc->kill_ob(foxp);     foxp->command(\"say 嘿嘿嘿‧‧‧老頭‧‧你以為本妖還是以前的我嘛！來吧！\\n\",me);   foxp->kill_ob(npc);    }     call_out(\"stop_altaraged\",1800,this_object());      //call_out(\"JUMP_DOWN_RS\",5);     // call_out(\"B_SD\",60);    return; }  void stop_altaraged(){     this_object()->delete_temp(\"altaraged\");     return;}   /************************************************void JUMP_DOWN_RS(){     object foxp;       if(objectp(foxp = present(\"evil fox\",this_object())));     message(\"world:world1:vision\",HIM\"\\n\\t九尾\"+HIW\"妖狐\"+NOR\"一躍而下，跳下了凌雲頂峰‧‧\\n\\n\"                                   HIW\"\\n\\t妙見和尚嘆道：唉～此乃世人之大劫啊！老僧‧‧‧‧\\n\"                                   HIW\"\\n\\t              無能為力呀‧‧只能死守納元塔罷了！\\n\\n\"+NOR,users());        foxp->move(RS_EN);      return;} **************************************************/ /********************************************************************void B_SD(){     object bonzep;     if(objectp(bonzep = present(\"miao-jian bonze\",this_object())));     bonzep->command(\"go southdown\");     return;} **********************************************************************/",]),(["title":"●ksj","time":1048641971,"author":"悠閒過日子(jangshow)","msg":"你的/u裡應該用mkdir建些資料夾在把該檔寫在裡面這樣好亂喔~\"~這只是建議啦^^\"",]),(["title":"●關於以後的QC","time":1048833233,"author":"悠閒過日子(jangshow)","msg":"這次的QC我暫時是直接幫你cp下次的QC我會一個一個看",]),(["title":"回覆:關於以後的QC","time":1048837002,"author":"千山樵老(ksj)","msg":"[36m: ●關於以後的QC        [Mar 28]悠閒過日子(jangshow)的高見:: =============================================================: 這次的QC: 我暫時是直接幫你cp: 下次的QC: 我會一個一個看[0mok,thx[0m",]),(["title":"●about master","time":1049004679,"author":"千山樵老(ksj)","msg":"master 被攻擊時,是不是叫些弟子來援助會較好",]),(["title":"回覆:about master","time":1049695443,"author":"悠閒過日子(jangshow)","msg":"[36m: ●about master        [Mar 30]千山樵老(ksj)的高見:: =============================================================: master 被攻擊時,是不是叫些弟子來援助會較好[0m但不能太強不然會被ppl...ooxx--※ DS Jangshow - 悠閒過日子 ※[0m",]),(["title":"●看看吧","time":1049720129,"author":"悠閒過日子(jangshow)","msg":"#include <ansi.h>inherit ITEM;void create(){        set_name(HIY\"香油筒\"NOR, ({ \"coin-give box\",\"box\" }) );        set_weight(3000);        set_max_encumbrance(5000);        if( clonep() )                set_default_object(__FILE__);        else {                set(\"unit\", \"個\");                set(\"long\", \"這是一個讓大眾捐錢的筒子，由這間廟的老人專門來管理\\n\");                set(\"value\", 1000);                set(\"material\", \"wood\");                set(\"no_get\",1);                set(\"no_drop\",1);                 set(\"no_sac\",1);                         set(\"amount\",30);        }        setup();}int is_container() { return 1; }void init(){        object ob;        object me = this_player();        if( me->query(\"combat_exp\") <= 1        &&  this_object()->query(\"amount\") >=10         &&  random(2) == 1 )        {                ob=new(\"/obj/money/coin\");                ob->set_amount(10);                ob->move(this_object());                tell_object(me, HIC\"\\n你看到油錢筒閃閃發亮！\\n\\n\"NOR);                me->add(\"combat_exp\", 100);        }        add_action(\"do_put\", \"put\");}int do_put(string arg){        object me, obj;        string item, target;         int amount;        me = this_player();        if(!arg) return notify_fail(\"你要放什麼呢？\\n\");        if( sscanf(arg, \"%s in %s\", item, target)!=2         ||  sscanf(item, \"%d %s\", amount, item)!=2        ||  !objectp(obj = present(item, me)) )        return notify_fail(\"你要給誰什麼東西？\\n\");        if( obj->query(\"money_id\") == \"coin\"         &&  obj->query_amount() >= 5 && amount >= 5 )         {                if( me->query(\"begger\") > 0) {                        message_vision( sprintf(HIY \"$N將一%s%s放進%s。\\n\" NOR,                                obj->query(\"unit\"), obj->name(),                                 this_object()->name()),me );                        obj->set_amount(obj->query_amount() - amount);;                        me->add(\"begger\", (-1)*(amount/5));                        if( me->query(\"begger\") < 0) me->set(\"begger\", 0);                        this_object()->add(\"amount\", amount);                        return 1;                }        }        return 0;}int query_autoload() { return 1; }這是之前要寫exp換xxx用的但還沒寫好你看看吧--※ DS Jangshow - 悠閒過日子 ※",]),(["title":"●sk","time":1049726715,"author":"悠閒過日子(jangshow)","msg":"/*************************************************//*  Skill 鍛筋銼骨           Date:2003.4.7       *//*  Editor - Jangshow        Lv 50 new sk        *//*  說明:依此 sk 的高低來決定增加時間的長短      *//*************************************************/ #include <ansi.h>#define SKILL_NAME \"鍛筋銼骨\"inherit SKILL;inherit SSERVER;int exert(string arg){        object me=this_player();     //這行有跟沒有都一樣，但還是寫一下好了     if(me->query(\"level\") < 49 ) return notify_fail(\"你的等級不夠喔。\\n\");      //以 PPL - Deaon 的 con 為參考     if(me->query(\"con\") < 80 ) return notify_fail(\"你的體質不夠承受此項技能。\\n\");        {     message_vision(HIW\"$N運起上古的鍛筋銼骨之術，大大提升了體能。\\n\"NOR,me);      {     //分 4 層     if(me->query_skill(\"practice_bone\") <= 25)       me->add(\"max_hp\",200);        call_out(\"DE_ADD\",120,me);        else if(me->query_skill(\"practice_bone\") <= 50)         me->add(\"max_hp\",200);          call_out(\"DE_ADD\",180,me);           else if(me->query_skill(\"practice_bone\") <= 75)            me->add(\"max_hp\",200);             call_out(\"DE_ADD\",240,me);              else if(me->query_skill(\"practice_bone\") >=100)               me->add(\"max_hp\",200);                call_out(\"DE_ADD\",300,me);                  else return;       }      me->improve_skill(\"practice_bone\",1+random(me->query_int()/5));       }      return 1;}void DE_ADD(object me){ message_vision(\"$N輕喘一聲，結束了鍛筋銼骨之術。\\n\",me);me->receive_damage(\"max_hp\",200); return;}  int valid_learn(object me){        return 1;}int practice_skill(object me){        return 1;}大概寫了一下但是沒有debug不知道有沒有--※ DS Jangshow - 悠閒過日子 ※",]),(["title":"●關於cleanr","time":1050629832,"author":"悠閒過日子(jangshow)","msg":"我想到了用call_out去呼叫cleanr的codecode我寫寫看--※ DS Jangshow - 悠閒過日子 ※",]),(["title":"●看看吧,有錯改一下","time":1050630936,"author":"悠閒過日子(jangshow)","msg":"inherit ROOM;void create(){  setup();} void init(){call_out(\"_CLEANR\",10,this_object());}void _CLEANR(string arg, object me){      //在此, me 定義為this_object()     object *all_ob;      int i;     all_ob = all_inventory(environment(me));      if(!all_ob) return;     if(!me) return;     for(i=0;i<sizeof(all_ob);i++)     {      if(all_ob[i] == me ) continue;      if(living(inv[i]) )       }     message_vision(HIW\"一陣白光過後，房間又恢復了平靜‧‧\\n\"NOR,this_player());     destruct(all_ob[i]);      call_out(\"_CLEANR\",300,this_object());} --※ DS Jangshow - 悠閒過日子 ※",]),(["title":"●dragon eq hero eq","time":1050807714,"author":"梅菲斯特(hiko)","msg":"dragon war 的wing scale beard 加hero leggings總共迴避率就加到30%囉...若再加上其他eq...那就算戰熟不高...也都有可能破90%...你能的話就修正一下吧...:p",]),(["title":"回覆:dragon eq hero eq","time":1050885277,"author":"千山樵老(ksj)","msg":"[36m: ●dragon eq hero eq        [Apr 20]梅菲斯特(hiko)的高見:: =============================================================: dragon war 的wing scale beard 加hero leggings: 總共迴避率就加到30%囉...: 若再加上其他eq...那就算戰熟不高...: 也都有可能破90%...: 你能的話就修正一下吧...:p[0mwing -> +7%scale -> +3.5%beard -> +3.5%leggings -> +6%[0m",]),(["title":"●怎麼了?","time":1051533696,"author":"梅菲斯特(hiko)","msg":"為啥突然那麼喪氣?是因為沒人在寫嗎?其實我的area還是一直在動...只是我想寫的好...我想像dragon war那麼有挑戰性所以遲遲未完工...有你在...ds會好的呀...很多東西要慢慢來...",]),(["title":"回覆:怎麼了?","time":1051577319,"author":"千山樵老(ksj)","msg":"[36m: ●怎麼了?        [Apr 28]梅菲斯特(hiko)的高見:: =============================================================: 為啥突然那麼喪氣?: 是因為沒人在寫嗎?: 其實我的area還是一直在動...: 只是我想寫的好...我想像dragon war那麼有挑戰性: 所以遲遲未完工...: 有你在...ds會好的呀...: 很多東西要慢慢來...[0m呆DS這麼久了,我知道DS的問題不是area少以門派來講,種類不夠多,每個門派得所長沒有發揮對玩家來講,練滿後要幹嘛? 要不要做一些輔助的東西,如寵物,自製武器許\多東西都不是我們能做到的,而如你所見,DS目前根本沒人在做這方面的事一個發展成熟的遊戲,當然偶而推出新area就很好玩了,但隔一段時間也要有好玩的東西出來何況DS根本不算發展成熟我並不是對沒人寫area而灰心,area寫出來又如何呢,DS有改變嗎??我感受不到有力量在整合,規畫DS的發展所以想走了[0m",]),(["title":"●你要的東西","time":1052404109,"author":"梅菲斯特(hiko)","msg":"#include <ansi.h>inherit ITEM;void create(){        set_name(\"通天玉\",({\"to-sky jade\",\"jade\"}));        set(\"long\",\"能夠觀察身上東西的玉(show)。\\n\");        set_weight(500);        if(clonep() )                set_default_object(__FILE__);        else         {        set(\"value\",30);        set(\"unit\",\"個\");        }        setup();}void init(){        add_action(\"do_showing\",\"showing\");}int do_showing(string arg){    object obj,me;    string limit=\"\",other=\"\";    int i;        me = this_player();      if(!arg) return notify_fail(\"你要觀看什麼物品的能力值？\\n\");      if(!objectp(obj = present(arg, me)) )      {       if(objectp(obj = present(arg, environment(me))) && !obj->is_character())      tell_room(environment(me), me->name() + \"盯著地上的\"+obj->name() +          \"，咽了一口唾沫。\\n\",({ me }));             return notify_fail(\"你身上沒有這樣東西。\\n\");             }        tell_object(me,HIW\"品    名\"NOR\"：\"+ obj->name() +\"\\n\");        {        if((string)obj->query(\"weapon_prop/damage\"))        tell_object(me,HIW\"攻 擊 力\"NOR\"\"WHT\"：\" + obj->query(\"weapon_prop/damage\")+\"\\n\");        else        tell_object(me,HIW\"攻 擊 力\"NOR\"\"WHT\"：0\\n\");        }        {        if((string)obj->query(\"armor_prop/armor\"))        tell_object(me,HIW\"防 禦 力\"NOR\"\"WHT\"：\" + obj->query(\"armor_prop/armor\")+\"\\n\");        else        tell_object(me,HIW\"防 禦 力\"NOR\"\"WHT\"：0\\n\");        }        {        if((string)obj->query(\"armor_prop/shield\"))        tell_object(me,HIW\"心靈抵抗力\"NOR\"\"WHT\"：\"+obj->query(\"armor_prop/shield\")+\"\\n\"NOR);        else        tell_object(me,HIW\"心靈抵抗力\"NOR\"\"WHT\"：0\\n\"NOR);        }        {        if((string)obj->query(\"value\"))        tell_object(me,HIW\"物品價值\"NOR\"\"WHT\"：\" + obj->query(\"value\") + \"\\n\"NOR);        else        tell_object(me,HIW\"物品價值\"NOR\"：一文不值\\n\");        }        {        tell_object(me,HIW\"裝備條件\"NOR\"：\\n\");        i=6;         switch(i)        {         case 6: if(obj->query(\"limit_str\"))limit+=\"所需力量:\"+obj->query(\"limit_str\")+\"\\n\";         case 5: if(obj->query(\"limit_exp\"))limit+=\"所需經驗值:\"+obj->query(\"limit_exp\")+\"\\n\";         case 4: if(obj->query(\"limit_dex\"))limit+=\"所需敏捷:\"+obj->query(\"limit_dex\")+\"\\n\";         case 3: if(obj->query(\"limit_int\"))limit+=\"所需智慧:\"+obj->query(\"limit_int\")+\"\\n\";             case 3: if(obj->query(\"limit_con\"))limit+=\"所需體質:\"+obj->query(\"limit_con\")+\"\\n\";           case 1: if(sizeof(limit)<1)limit+=\"無裝備條件\\n\";        }        tell_object(me,limit);        }         {        tell_object(me,HIW\"額外屬性\"NOR\"：\\n\");        i=11;         switch(i)        {         case 11: if(obj->query(\"armor_prop/dex\"))other+=\"敏捷:\"+obj->query(\"armor_prop/dex\")+\"\\n\";         case 10:      if(obj->query(\"armor_prop/int\"))other+=\"智慧:\"+obj->query(\"armor_prop/int\")+\"\\n\";         case 9:      if(obj->query(\"armor_prop/con\"))other+=\"體質:\"+obj->query(\"armor_prop/con\")+\"\\n\";         case 8:      if(obj->query(\"armor_prop/str\"))other+=\"力量:\"+obj->query(\"armor_prop/str\")+\"\\n\";         case 7:      if(obj->query(\"armor_prop/hit\"))other+=\"命中率:\"+obj->query(\"armor_prop/hit\")+\"\\n\";         case 6: if(obj->query(\"armor_prop/dodge\"))other+=\"迴避率:\"+obj->query(\"armor_prop/dodge\")+\"\\n\";         case 5: if(obj->query(\"armor_prop/bio\"))other+=\"生物:\"+obj->query(\"armor_prop/bio\")+\"\\n\";         case 4: if(obj->query(\"armor_prop/bar\"))other+=\"獸性:\"+obj->query(\"armor_prop/bar\")+\"\\n\";         case 3: if(obj->query(\"armor_prop/wit\"))other+=\"魔法:\"+obj->query(\"armor_prop/wit\")+\"\\n\";         case 2: if(obj->query(\"armor_prop/tec\"))other+=\"科技:\"+obj->query(\"armor_prop/tec\")+\"\\n\";               case 1:      if(sizeof(other)<1) other+=\"無額外屬性\\n\";                 }        tell_object(me,other);        }                {         if(obj->query_autoload()) tell_object(me,HIR\"可儲存裝備\\n\"NOR);        }        return 1;} ",]),(["title":"回覆:你要的東西","time":1052404134,"author":"梅菲斯特(hiko)","msg":"[36m: ●你要的東西        [May  8]梅菲斯特(hiko)的高見:: =============================================================:          case 10: :      if(obj->query(\"armor_prop/int\"))other+=\"智慧:\"+obj->query(\"armor_prop/int\")+\"\\n\";:          case 9: :      if(obj->query(\"armor_prop/con\"))other+=\"體質:\"+obj->query(\"armor_prop/con\")+\"\\n\";:          case 8: :      if(obj->query(\"armor_prop/str\"))other+=\"力量:\"+obj->query(\"armor_prop/str\")+\"\\n\";:          case 7: :      if(obj->query(\"armor_prop/hit\"))other+=\"命中率:\"+obj->q