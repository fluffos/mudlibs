   //攻擊續增        /* 顯示target狀態 */        COMBAT_D->report_status(target);        /* 顯示受傷多寡 */        if(me->query_temp(\"apply/show_damage\") || me->query_temp(\"show_damage\") )            tell_object(me,HIY\"(\"+damage+\")\"NOR);        if(target->query_temp(\"apply/show_damage\") || target->query_temp(\"show_damage\") )            tell_object(target,HIR\"(\"+damage+\")\"NOR+\" (\"+target->query(\"hp\")+\"/\"+target->query(\"max_hp\")+\")\");        } else message_vision(\"\\t但是似乎沒有造成$n任何傷害。\\n\", me, target);他在扣完血後 把damage 加了20%後 才顯示受傷多寡 使得扣血量灌水了20%這應該是沒注意到顯示的先後應該改成如下 (因為他排版原本有點怪 我順便改了一下顯示狀態和扣血的順序會比較漂亮) if( damage > 0 ) {        target->receive_damage(\"hp\", damage, me );         me->improve_spell(\"god-kill\", 1+random(me->query_int()/7) );                        /* 顯示受傷多寡 */        if(me->query_temp(\"apply/show_damage\") || me->query_temp(\"show_damage\") )            tell_object(me,HIY\"(\"+damage+\")\"NOR);        if(target->query_temp(\"apply/show_damage\") || target->query_temp(\"show_damage\") )            tell_object(target,HIR\"(\"+damage+\")\"NOR+\" (\"+target->query(\"hp\")+\"/\"+target->query(\"max_hp\")+\")\");        /* 顯示target狀態 */        COMBAT_D->report_status(target);         hit += random(10);              //命中續增        damage += damage*20/100;        //攻擊續增        } else message_vision(\"\\t但是似乎沒有造成$n任何傷害。\\n\", me, target);-----------------------------------------------------------------------------------god-fire bug以下這行me->add_temp(\"probit/god-fire\");        //如遲遲未能打中，則累加命中由於add_temp()需要傳入一個值才會累加上去 不然會預設成加0而不是加1可能別的mud add_temp不傳值會加1...但是這裡不會所以寫法搞錯應該改成me->add_temp(\"probit/god-fire\",1);        //如遲遲未能打中，則累加命中","title":"●about /daemon/spell/god-kill.c /daemon/spell/god-fire.c","author":"令伊(orzer)","time":1142073925,]),(["msg":"as title--☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★★　　　☆發呆☆　與　☆神聖☆　並重的小巫師　　　　　　　☆★　　　　　　　　　　　　　　　　ＡＬＩＣＫＹＵＥＮ　字　☆☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★☆★","title":"●newbie->lv25","a