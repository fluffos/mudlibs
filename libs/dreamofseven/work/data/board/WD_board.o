it(){        add_action(\"open_box\",\"open\");}int open_box(string str){        object me=this_player();        object b,room,ob;        ob = this_object();        room=load_object(\"/u/m/muedr/workroom\");                if(!me) return 0;        if(this_object()->query_temp(\"opened\") != 0) return 0;                if(str==\"box\" || str==\"謎之盒子\")        {        message_vision(\"world:world1:vision\",        HIW\"\\n\\t\\t\"+ob->name(1)+\"通過了\"HIR\"鬼斧神工\"WHT\"張大千的考驗！\\n\\n\"NOR        WHT\"\\n\\t\\t張大千說:這小毛頭還真厲害，老夫佩服佩服！！\\n\\n\\n\"NOR,users());        write(        HIR\"\\n頃刻間，張大千的謝禮突然頻空而降落下來。\\n\"NOR,me);                  b=new(__DIR__\"npc/eq/r_cloth\");        b->move(environment(this_object()) );        destruct(this_object());        room=set_temp(\"opened\",1);        return 1;        }}幫偶debug~~@@--[0;1;34m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[0m[0;1;34m[1m[1m [1m [1m [1m [1m [1m [1m[1m[1m[1m[1m[1m[1m[1m[1m [1m [1m[1m[1m[1m[1m[1m~[1m[1m[1m [1m [1m[1m[1m[1m[1m [1m [1m[1m[1m[1m[1m[1m[1m[1m[1m [1m[1m[1m [1m [1m [1m[1m[0m[0;1;34m[1m[1m[1m[1m[1m[1m [1m [1m[1m[1m[1m[1m [1m [1m [1m [1m [1m [1m[1m[1m[1m[1m[1m[1m[1m[1m [1m [1m[1m[1m[1m[1m [1m [1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m [1m [1m[1m[0m[0;1;34m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[0m","title":"●師父..help","time":1028194835,"author":"無力感加重(muder)",]),(["msg":"","time":1029076006,"title":"●有問題","author":"颱風蛋糕(wilfred)",]),}),"no_get":1,])
