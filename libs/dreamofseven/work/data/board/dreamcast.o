:1014393869,"author":"[1;37m香草冰淇淋蛋糕[0m(dreamcast)","title":"●more bestsword.c",]),(["msg":"#include <weapon.h>inherit SWORD;#include <ansi.h>void create(){        set_name(HIC\"天劍\"NOR, ({ \"sky sword\",\"sword\"} ) );        set_weight(6000);        if( clonep() )                set_default_object(__FILE__);        else {                set(\"volume\",2);                set(\"unit\", \"把\");        set(\"material\",\"diamond\");                set(\"long\", \"這是一把大神用的劍。\\n\");                set(\"value\", 1000);        }        init_sword(100);        setup();}--","time":1014394104,"author":"阿不思●鄧不利多(piliykt)","title":"●sword",]),(["msg":"inherit SWORDvoid create(){        set_name(HIC天劍NOR, ({ sky sword,sword} ) )        set_weight(6000)                set_default_object(__FILE__)        else {                set(volume,2)        set(material,diamond)                set(long, 這是一把大神用的劍。\\n)                set(value, 1000)        }        init_sword(100)        setup()}--[37mby[0m [35m《[0;1;5;32m[1;5me[1;5m[1;5m[0;1;37m[1m[1;33m[1mC[1;31m[1m[1m[1m[1;36m[1m@[1m[1m[0;35m》[0m","time":1014394407,"author":"[1;37m香草冰淇淋蛋糕[0m(dreamcast)","title":"●6",]),(["msg":"#include <weapon.h>inherit SWORD;#include <ansi.h>void create(){        set_name(HIC\"天劍\"NOR, ({ \"sky sword\",\"sword\"} ) );        set_weight(6000);                set_default_object(__FILE__);        else {                set(\"volume\",2);        set(\"material\",\"diamond\");                set(\"long\", \"這是一把大神用的劍。\\n\");                set(\"value\", 1000);        }        init_sword(100);        setup();}--[37mby[0m [35m《[0;1;5;32m[1;5me[1;5m[1;5m[0;1;37m[1m[1;33m[1mC[1;31m[1m[1m[1m[1;36m[1m@[1m[1m[0;35m》[0m","time":1014395032,"author":"[1;37m香草冰淇淋蛋糕[0m(dreamcast)","title":"●test",]),(["msg":"灌ㄚ灌ㄚ灌ㄚ灌ㄚ灌ㄚ灌ㄚ灌ㄚ灌ㄚ灌ㄚ灌ㄚ灌ㄚ灌ㄚ灌ㄚ灌ㄚ灌ㄚ灌ㄚ灌ㄚ--[31m吃[33m喝[32m嫖[37m賭[36m [31m樣樣都要來 [0m                  