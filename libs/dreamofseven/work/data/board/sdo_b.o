做不到、也不需要做的事情。    初次見到妖精的人們，一定會震攝於他們美麗的外表和出眾的氣質，曾經有一個趣談，曾經有一個妖精女子走進一間酒吧，整間酒吧的人連同老闆都呆立在一旁，忘記了手邊的工作，更甚至老闆正在烤的東西都起火了，還要那個妖精禮貌的提醒了老闆，老闆才發現，造成一場小小的虛驚。    由於天性的關係，妖精喜歡自然，也能夠和自然中的精靈們交談，甚至能得到他們的幫助。如果說要成為世上最好的精靈使，那就一定要跟妖精們學習，但是由於陣營的關係，邪惡的人是使用不出來的。挼果你想更了解他們，去吧，冒險者，去找到那傳說中的國度。","author":"瀧。改[⊙ o ⊙'''](sdo)","time":1025970083,"title":"●妖精國度",]),(["msg":"    相傳，在日昇大陸上的迷霧森林，是遠古時代，神賜給妖精們的屏障，保護最受到神的寵愛的種族--妖精，不受其他好戰或是有侵略性的種族破壞其生活。至於傳說的真實性，卻沒有因為沒有人能夠到達森林的另一端而受到懷疑。因為在這個大陸上的各處的確有妖精的活動足跡，而且，在迷霧森林的入口有著人類與妖精所共同訂定的地界界碑，也許\有一天你也可以遇見那傳說中的一族。    來自這個大陸各地的冒險家，都想盡辦法要穿過迷霧森林，尋找那傳說的國度，也許\是因為神的慈愛吧，雖然沒有人到達過，但是也沒有人被困在森林裡，至少都能全身而退。但是有人曾在朦朧中見過一棵前所未見的巨大神木，他極力宣稱他在那見到了迷霧森林之王，只是對方面帶微笑的將他送回了森林的入口。    在森林的旁邊有一個人類的小村莊，目前好像有些大麻煩，需要別人的幫忙。有空的話可以過去看看...","author":"瀧。改[⊙ o ⊙'''](sdo)","time":1025970171,"title":"●迷霧森林",]),(["msg":"你的god setup ne?","author":"其母之(baal)","time":1031843283,"title":"●Hello?",]),(["msg":"hi...可以給我你的xmas game的codeㄇ我想看一下說fool....我想trytry寫個game可以的話mail to me或post on my board都可bow bow bow","author":"梅菲斯特(hiko)","time":1040734465,"title":"●hi....",]),(["msg":"/*2001聖誕節活動--堆雪人之分數看板                          *//*改自alickyuen@DS的中秋節特別活動『燈謎競逐』分數排行榜    *//*                                                sdo@DS    */#include <ansi2.h>inherit ITEM;inherit F_SAVE;mapping game_record;mapping game_gift;int reset_record();string do_list();int measure(object me);int receive_gift(object me);void create(){        set_name(HIW\"堆雪人活動排名版\"NOR,({\"record board\",\"board\"}) );        set(\"long\",\"  \");        set_weight(200000);        if(clonep() )                set_default_object(__FILE__);        else        {                set(\"unit\",\"個\");                set(\"no_get\",1);                set(\"no_sac\",1);                set(\"value\", 20000);        }        setup();        if( !restore() )         {                game_record=([]);                game_gift=([]);        }}string query_save_file() {        return DATA_DIR+\"game/sdo_snowman\";}void init(){        object me = this_player();        if( !me ) return;        if( !userp(me) ) return;                add_action(\"do_look\", \"look\");}int do_look(string arg){        if ( arg == \"board\" )        {                return write(do_list());        }}string do_list(){        float *score, swap;        int i, j, x;        string *ppl, msg, user;        if( !restore() )  game_record=([]);        if( !game_record ) return \"目前還沒有任何紀錄！\\n\";        if( !mapp(game_record) ) return \"目前還沒有任何紀錄！\\n\";        ppl=keys(game_record);        score=values(game_record);        i=sizeof(score);        for(j=i-1;j>0;j--)        {                for(x=1;x<=j;x++)                {                        if( score[x-1] > score[x] )                        {                                swap=score[x-1];                                score[x-1]=score[x];                                score[x]=swap;                                user=ppl[x-1];                                ppl[x-1]=ppl[x];                                ppl[x]=user;                        }                }        }        i=sizeof(ppl);        j=0;        msg= HIW\"--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--\\n\"NOR;        msg += HIG\"\\t\\t\\t堆雪人大賽高手排行榜\\n\";        msg+=HIW\"--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--\\n\"NOR;        while( i-- )        {                j++;                if( ppl[i]==getuid(this_player()) ) msg+= HIC;                        else msg += CYN;                if( game_record[ppl[i]] > 0 ) {                        msg+=sprintf(\"第%4s名 ---- %13s 目前高度 %3f 公分\",                                chinese_number(j),ppl[i],game_record[ppl[i]]);                        switch( j )                        {                                case 1: msg+= HIM\"\"BLINK\" (超級大獎：上名人堂＆自訂 Save Eq 一件)\\n\"; break;                                case 2..5: msg+= HIY\" (大獎：隨機 Save Eq 一件)\\n\"; break;                                default: msg+= HIR\" (參加獎：錢、Exp)\\n\"; break;                                }                }                msg+=NOR;        }               msg+=HIW\"--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--==--\\n\"NOR;        return msg;}int measure(object me){        int roll1,roll2,comp1,comp2;        float temp,high,temp1,temp2;        string id;        id=getuid(me);                if( !restore() ) game_record=([]);                if( !mapp(game_record) ) game_record=([]);                temp=game_record[id];                roll1=me->query_temp(\"sdogame/roll1\");        roll2=me->query_temp(\"sdogame/roll2\");        comp1=me->query_temp(\"sdogame/comp1\");        comp2=me->query_temp(\"sdogame/comp2\");                        me->delete_temp(\"sdogame/roll1\");        me->delete_temp(\"sdogame/roll2\");        me->delete_temp(\"sdogame/comp1\");        me->delete_temp(\"sdogame/comp2\");        me->delete_temp(\"sdogame/build\");                temp1=sqrt(((roll1+1)/2))*2.5 - log(comp1+1);        temp2=sqrt(((roll2+1)/2))*2.5 - log(comp2+1);        high=(temp1+temp2)*2;/*              if(high < 0)        {                high=0;        }*/              me->set_temp(\"sdogame/high\",high);                if (!me) return 0;        tell_object(me,        HIW\"\\n\\n一個工作人員無聲無息拿著成績登記本出現在你身邊！\\n\"NOR        HIW\"他從身上拿出了一條皮尺，仔細的量了量你的雪人，說：『這個雪人的高度是\"+high+\"公分！』\\n\"        HIW\"後，接著就消失了！\\n\\n\"NOR,high);        if ( me->query_temp(\"sdogame/high\") >= temp )        {                game_record[id]=me->query_temp(\"sdogame/high\");        }        this_object()->save();        this_object()->create();        return 1;}int reset_record(){        game_record=([]);        this_object()->save();        write(\"積分已經清除！\\n\");        return 1;}int receive_gift(object me){        object gift;        string id;        id=getuid(me);                if( !restore() )         {                game_gift=([]);                game_record=([]);        }        if( !mapp(game_gift) )         {                game_gift=([]);                game_record=([]);        }                if (!me) return 0;        if (game_gift[id]==1) return notify_fail(\"你已經領過禮物了喔！\\n\");                me->add(\"exp\",to_int(game_record[id]*50000));        tell_object(me,\"你得到\"+to_int(game_record[id]*50000)+\"點經驗值！\\n\");                game_gift[id]=1;        this_object()->save();        this_object()->create();        return 1;}","time":1051967925,"author":"瀧(sdo)","title":"●看看吧",]),}),"no_get":1,"unit":"面","long":"這是一塊大石頭，隱隱的發著白光，似乎可以在上頭寫字！？","board_id":"sdo_b","location":"/u/s/sdo/workroom.c","no_sac":1,"capacity":100,"no_clean_up":1,])
