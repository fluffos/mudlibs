uy\");}                 __DIR__\"wp/goldwhip\"    : 30,                          __DIR__\"wp/tofist\"      : 30,                      __DIR__\"wp/lefork\"      : 30,                    __DIR__\"wp/bigcape\"     : 30,          ]) );            setup();}void init(){        add_action(\"do_list\",\"list\");        add_action(\"do_buy\",\"buy\");}","title":"●...","time":1041571003,"author":"太陽神(kenshin)",]),(["msg":"#include <ansi.h>inherit ITEM;void create(){  set_name(HIW\"乾坤符\"NOR,({\"chan-kuan seal\",\"seal\"}));  set_weight(100);  if( clonep() )    set_default_object(__FILE__);  else  {    set(\"long\",\"流傳已久的符咒，使用方法請打(help seal)。\");    set(\"value\",50);  }  setup();}void init(){    add_action(\"do_move\",\"pray\");}int do_move(string arg){     object me = this_player();   if(arg ==\"1\" )       { message_vision(HIB\"me->query(\"name\")大聲喊著\"NOR\":\"HIC\"藍藍的天，賜我瞬移的神力!!\\n\"NOR,me);              me->move(\"/open/world1/tmr/area/hotel\");           message_vision(HIW\"一陣狂風，$N迎風而出。\\n\"NOR,me);           return 1;         }/* if (arg == \"2\"){          me->move(\"/open/world1/acme/area/hotel\");          message_vision(HIW\"一陣狂風，$N迎風而出。\\n\"NOR,me);           return 1;          } if (arg == \"3\"){          me->move(\"/open/world1/kkeenn/love/enter\");           message_vision(HIW\"一陣狂風，$N迎風而出。\\n\"NOR,me);          return 1;          }*/ if (arg == \"4\"){          me->move(\"open/world1/cominging/area/flurry49\");          message_vision(HIW\"一陣狂風，$N迎風而出。\\n\"NOR,me);           return 1;         }   if (arg == \"5\"){          me->move(\"/open/world1/acme/area/portal\");          message_vision(HIW\"一陣狂風，$N迎風而出。\\n\"NOR,me);           return 1;         }   if (arg == \"6\"){          me->move(\"/open/world1/tmr/area/s_house\");          message_vision(HIW\"一陣狂風，$N迎風而出。\\n\"NOR,me);          return 1;          }   if (arg == \"7\"){          me->move(\"/open/world1/cominging/area/boo-lin\");          message_vision(HIW\"一陣狂風，$N迎風而出。\\n\"NOR,me);          return 1;          }   if (arg == \"8\"){          me->move(\"/open/world1/wu_sha_town/seacoun4\");          message_vision(HIW\"一陣狂風，$N迎風而出。\\n\"NOR,me);          return 1;         }else{          write(\"請重新輸入!!.....^^\\n\");      return 1;      }                   return 1;}int do_help(string str){  if(!str || str != \"seal\") return 0;  write(\"\\n要去指定的地方，請打pray number，支援地方有:(1)朝天樓(2)天城中央(3)情城池門口(4)疾風門(5)神武教(6)八極門(7)步靈城中央(8)無砂鎮\"NOR);  return 1;}","title":"●seal","time":1041755167,"author":"太陽神(kenshin)",]),(["msg":"/open/world1/cominging/area/river7","title":"●連接處","time":1041756887,"author":"太陽神(kenshin)",]),(["msg":"[0;1;33m[1mi[1m[1m[1m[1mv[1m[1mj[1m[1mK[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m([1mA[1ml[1mi[1mc[1mk[1my[1mu[1me[1mn[1m)[1m[1mR[1;37mp[1mo[1ms[1mt[1m [1m[1m[1m[1m[1m[1m[1m[1m[1m,[1m [1m[1m[1m[1m[1m[1m_[1m[1mI[1m,[1m [1m[1ms[1m[1m[1m[1mI[0m","title":"●alickyuen say","time":1041848313,"author":"藍的喵(kenshin)",]),(["msg":"你的電腦有很多東西都要換過我沒有足夠的錢所以還是請你到我這來一趟吧","title":"●.","time":1048590481,"author":"悠閒過日子(jangshow)",]),(["msg":"一式 觀測雲天二式 飛雲走步三式 滄海無涯四式 雪顫刺骨五式 海龍咆嘯踏雲摘月七式 寒冰冷梅一步千宵特攻 明日幾時轉圓 自嘆何時甜","title":"●觀星踏雲箭訣","time":1048675855,"author":"藍的喵(kenshin)",]),(["msg":"as title--※ DS Jangshow - 悠閒過日子 ※","title":"●你的area好了嘛?","time":1050742306,"author":"悠閒過日子(jangshow)",]),(["msg":"名稱(NAME&ID)        等級(LV)      武防(WP&EQ)                掉落物品(SomeThing)1.天使波利           23            波利護符(bo-li necklace)   1/250 天使髮夾(angel hairclip) 2.幽靈波利           23            波利護腕(bo-li wrists)    3.哥布林             27            哥布林項鍊(bo-lin neck)    1/50  哥布林戰甲(bo-lin armor)4.聖誕波利           27                                       1/25  聖誕帽(x'mas hat)5.傑洛米             28            傑利火盾(jay-li shield)    1/5   傑洛米娃娃6.突變蛙             29                                       1/50  突變戒指(to-ban ring)7.劍魚      