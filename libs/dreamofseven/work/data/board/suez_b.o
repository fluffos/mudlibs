ord\",\"sorgi_sword\");        set(\"chat_chance\", 3);        set(\"chat_msg\", ({  (: command,\"sigh\" :),}));        set(\"chat_chance_combat\", 15);        set(\"chat_msg_combat\", ({  (: command,\"exert moon_force recover\" :),  (: command,\"angry\" :),  (: command,\"say 真他奶奶的, 連老人都趕欺負..\":),}));        set(\"inquiry\", ([  \"小夥子\" : \"小夥子嗎？他就是前幾年來到山上的那個小毛頭呀！\\n\",  \"小毛頭\" : (: lieh :),]));        setup();        carry_object(__DIR__\"wp/old_long_sword.c\");        carry_object(__DIR__\"eq/slipshod_cloth.c\");        carry_object(__DIR__\"eq/slipshod_boots.c\");}int talk_action(object me)      //talk 時會執行此函式.{        command(\"? \"+ me->query(\"id\") );        return 1;}void init(){        command(\"say \" + RANK_D->query_respect(this_player()) + \", 你可有瞧見我那小夥子？\");}string lieh(object me){        object hon;        hon = present(\"yuann-hwan horng\", environment(this_object()) );        call_out(\"call_hon\", 3, hon, me);        return \"小毛頭嗎？他就是那個叫什麼～什麼～咺元列吧 , 洪老頭？\\n\";}void call_hon(object hon, object me){        hon->lieh(me,0);        return;}",]),(["author":"Omaga(cominging)","title":"●oldman call 的對像","time":949246114,"msg":"// 老人 2 : 扯上軒轅烈#include <ansi.h>inherit NPC;string *lieh = ({        GRN\"洪怨桓說﹕什麼？你說什麼呀, 廣老頭.......？\\n\"NOR,        \"\",        GRN\"洪怨桓似乎想到了什麼, 有點宛息說﹕那個咺元列？好像是軒轅劣吧？\\n\"NOR,        GRN\"洪怨桓說﹕前幾年他迷路在山下的森林中...\\n\"NOR,        \"\",\"\",        GRN\"洪怨桓說﹕我們幾個老頭, 看他是可造之才, 就救了上來...\\n\"NOR,        GRN\"洪怨桓說﹕後來又傳授他獨門之招, 不料, 後來衙門的人找上來了, 於是只好放他走了...\\n\"NOR,        \"\",        GRN\"洪怨桓說﹕臨走前, 咱們決定好了, 把最後的幾招, 寫在一本冊子上, 塞了給他, ...\\n\"NOR,        \"\",\"\",        GRN\"洪怨桓說﹕至今, 仍未有他的消息, 可就苦了周老頭了...\\n\"NOR,        GRN\"洪怨桓帶有點生氣說﹕他為了找那小夥子, 而下山去衙門尋他, 反遭惡快捕痛打了一頓,...\\n\"NOR,        \"\",        YEL\"洪怨桓說到這裡, 臉上露出一股生氣的表情\\n\"NOR,        \"\",\"\",        GRN\"洪怨桓說﹕你看看老周的樣子, 就知道那個快捕多狠......\\n\"NOR,        GRN\"洪怨桓似乎不再多言, 嘆了嘆幾口氣, 又安靜了下來...\\n\"NOR,});void create(){        set_name( \"洪怨桓\", ({\"yuann-hwan horng\", \"horng\", \"yuann\", \"hwan\", \"yuann-hwan\" }) );        set(\"long\", \"一位身形憔悴的老人，但是臉上的神色卻很紅潤。\\n\");        set(\"title\", HIY\"紫陽四隱\"NOR);        set(\"gender\", \"男姓\");        set(\"race\", \"人類\");        set(\"age\", 80+random(30));        set(\"level\",40);        set(\"evil\",20+random(20));        set(\"attitude\", \"heroism\" );        set_skill(\"dodge\", 70+random(10));        set_skill(\"parry\", 50+random(20));        set_skill(\"unarmed\", 65+random(30));        set_skill(\"sword\", 78);        set_skill(\"force\", 100);        set_skill(\"sorgi_sword\", 75);        set_skill(\"moon_force\", 70);        map_skill(\"force\",\"moon_force\");        map_skill(\"sword\",\"sorgi_sword\");        set(\"chat_chance\", 3);        set(\"chat_msg\", ({  (: command,\"sigh\" :),}));        set(\"chat_chance_combat\", 15);        set(\"chat_msg_combat\", ({  (: command,\"exert moon_force recover\" :),  (: command,\"angry\" :),  (: command,\"say 真他奶奶的, 連老人都趕欺負..\":),}));        setup();        carry_object(__DIR__\"wp/old_long_sword.c\");        carry_object(__DIR__\"eq/slipshod_cloth.c\");        carry_object(__DIR__\"eq/slipshod_boots.c\");}int talk_action(object me)      //talk 時會執行此函式.{        command(\"? \"+ me->query(\"id\") );        return 1;}void lieh(object who,int flag){        message_vision(lieh[flag], this_object());//      if( ++flag < sizeof(lieh) )        if( flag++ < sizeof(lieh) )        {                call_out(\"lieh\", 1, who, flag );                return;        }         tell_object(who, GRN\"或許\你可以問問看周老頭一些問題. \\n\"NOR);        return;}",]),(["author":"蘇子奇(suez)","title":"●notebook 新計算式handing dagger","time":949527062,"msg":" dex=100 damage max=75 dex=90 damage max=56 dex=80 damage max=41 dex=80 damage max=29 dex=70 damage max=29 dex=60 damage max=20 dex=50 damage max=14 dex=40 damage max=9 dex=30 damage max=7 dex=20 damage max=6 dex=10 damage max=5for handiing dagger skills level 100-1 for damage/evey -10 level for handing dagger",]),(["author":"Omaga(cominging)","title":"●Bug-- 一小部分","time":950119750,"msg":"1.山中小徑 - /u/s/suez/area/path_t    細細的山溝在小徑旁緩緩流動著，遠方的山壁有一條白練懸垂著，那是一個小瀑布，山泉由瀑布源頭流到這裡，在這裡聚集成一小水窪，隨即就流入地下。水窪邊的柳樹形狀奇特，附近地形也平坦多了，不少人在此駐足，一享山林之美。    夜幕低垂﹐滿天繁星。    這裡明顯的出口是 southdown 和 west。    (巫師) 隱藏的出口是 east。  三君子柳(Three-gentlemen tree)  旅人(Traveler) 正站在這裡> sac tree你將三君子柳(Three-gentlemen tree)奉獻給大地。/u/s/suez/area> get tree你撿起一株三君子柳。2.小水漥 - /u/s/suez/area/path_lake    山泉沿著山溝流到這裡，逡巡徘徊，久而久之便在這裡挖出了一個小水漥，仔細一看，水漥中還有小魚在游著呢！你不禁又重拾遺忘以久的童心，拋開武林中的恩恩怨怨，盡情享受這世外桃源的風光。    夜幕低垂﹐滿天繁星。    這裡唯一的出口是 east。  奇門第二代八奇之風「妙手空空兒」風無影(Fong-wu-yen) 正站在這裡/u/s/suez/area> ? fong你很疑惑地看著風無影(Fong-wu-yen)。風無影說﹕你覺得我很奇怪嗎？風無影(Fong-wu-yen)「嘿嘿嘿....」地奸笑了幾聲。風無影說﹕你在這裡待久了很快就變得很我一樣 :P風無影(Fong-wu-yen)很得意地 口圭 口合 口合 口合 ～～～地笑了起來 :O風無影突然消失了，只剩下他的狂笑還在你耳邊徘徊。/n/u/s/suez/area>                                                 ^^",]),(["author":"袁世凱(alickyuen)","title":"●thanks^^","time":950864426,"msg":"thanks for you homepagebow--解喝志專         可口可樂                      By 袁世凱                                Alickyuen@DS",]),(["author":"蘇子奇(suez)","title":"●new id","time":952404308,"msg":"140.127.181.141 7000",]),(["author":"蘇子奇(suez)","title":"●fire-bird_craw","time":953311381,"msg":"#include <ansi.h>#include <weapon.h>inherit F_UNIQUE;inherit FIST;void create(){        set_name(HIR\"炎羽鳳爪\"NOR,({\"fire bird craw\",\"craw\"}) );        set(\"long\",@long    這對手套傳說是以浴火重生之鳳凰掉落的火羽，混以烏蠶之絲，鬼蜥之鱗，以天雷燒融鍛化七七四十九次後而成材料。毀壞十三把寶劍以成其型，以人﹑鬼﹑神三界之血冶鍊麒麟之角以為針，化日﹑月﹑星三光以為線，縫製三百寒暑而成器。以靈御之則風起，以氣御之則火生。本來謠傳於江湖之中，人皆以為神話而不存於世，直到三年前方由李書文弟子柴子雲所獲，而現之江湖，但亦有人認為其威力不符傳說之奇，乃後人依傳說而製。使用說明:1.指令 irrigate ap — 將自己的內勁灌入炎羽鳳爪之中以產生火勁。1.指令 irrigate mp — 將自己的靈力灌入炎羽鳳爪之中以產生風勁。long        );       set_weight(1000);        if(clonep() )                set_default_object(__FILE__);        else        {                set(\"unit\",\"對\");            set(\"value\",23000);            set(\"limit_con\",20);            set(\"limit_str\",20);            set(\"limit_int\",20);            set(\"limit_dex\",20);        set(\"wield_msg\",HIC \"$N拿起一雙$n，只見$N戴上之後，一陣灼熱的熾風由$n向四面八方湧出！！\\n\"NOR);        }    set(\"weapon_prop/armor\", 17);    init_fist(27);        setup();}void init(){                add_action(\"do_fire\",\"irrigate\");        add_action(\"do_wind\",\"irrigate\");}int do_fire(object me,object target,string arg){        object wp;        int p,m,d,a;        wp=target->query_temp(\"weapon\");        p=target->query_skill(\"dodge\")+target->query_dex();        m=me->query_skill(\"dodge\")+me->query_dex();        if(arg != \"ap\" ) return 0;	if( me->query_skill_mapped(\"unarmed\")!=\"unarmed\")			return notify_fail(\"使用有招式的拳法時無法使用炎羽鳳爪的特攻。\\n\");        if( !wp )        {                       a=10+random(100);                me->receive_damage(\"ap\", a );                message_vision(HIY\"$N雙掌一出，真氣一運，一股熾熱的火焰撲向$n！！\\n\"NOR,me,target);                if(random(p) > random(a)+30 )                {                  message_vision(CYN \"$N縱身一閃，恰恰躲開了火舌的襲擊。\\n\" NOR,target);                  me->add_busy(2);                }                else                {                   d= a*2/3+random(me->query(\"ap\"))*3/5;                   if(d > 200) d=200;                   target->receive_damage(\"hp\", d );                   message_vision(HIR \"$N瞬時被烈焰纏身，火光濃煙之中傳出陣陣皮肉燒焦的臭味！\\n\" NOR,target);                   me->add_busy(3);                   target->add_busy(3);                }                return 1;        }        if( 30+random(p) < random(m))        {                wp->unequip();                if(p->query_str()<20 || random(p->query_str())<random(p->quert_str()/3)) wp->move(environment(target));                message_vision(HIC \"只見一道火光燒向\"+wp->query(\"name\")+\"！！$N手中登時一陣滾燙，急忙鬆開了\"+wp->query(\"name\")+\"！！\\n\" NOR ,target);                me->receive_damage(\"ap\", 20 );                me->add_busy(1);        }        else        {                message_vision(CYN \"$N手中兵器一縮，躲開了火舌的攻擊！！\\n\" NOR,target);                me->add_busy(1);                target->add_busy(2);        }        return 1;}int do_wind(object me,object target,string arg){        if(arg != \"mp\" ) return 0;                return 1;}",]),(["author":"龍蝦(luky)","title":"●suez","time":953488890,"msg":"我改過的鳳爪放在 /u/s/suez/NPC/wp/luky_claw.c--         [0;1;44m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[0m        [0;1;44m[1m[1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m[1m[0m        [0;1;44m[1m[1m [1m [1m [1m [1m[1m[1m[1mi[1m:[1m [1m [1m [1m[1m[1m[1m[1m[1m[1m[1mP[1m[1mn[1m[1mi[1m[1mH[1m[1m[1m[1m[1m[1mT[1m[1mw[1m[1mD[1m[1m[1m [1m [1m [1m [1m [1m [1m [1m [1m[1m[0m        [0;1;44m[1m[1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m[1mH[1m[1m[[1m[1m[1m[1m[1m[1mc[1m[1m[1m[1ms[1m[1mu[1m[1mt[1m[1m[1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m[1m[0m        [0;1;44m[1m[1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m[1m[0m        [0;1;44m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[0m                             