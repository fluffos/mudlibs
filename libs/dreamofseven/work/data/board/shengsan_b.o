 (\"小喇叭\")];函數:main()             <- cmds/imm/goto.c:第30行 [物件:cmds/imm/goto];函數:go()               <- cmds/imm/goto.c:第83行 [物件:cmds/imm/goto];函數:message_vision()   <- adm/obj/simul_efun.c:第28行 [物件:adm/obj/simul_efun]追蹤以上的錯誤, 知道你是 由 command.c 44行 呼叫 goto.c而 goto.c 的30行 呼叫了 goto.c 的 go() 函數而 goto.c 的 83 行 (也就是go()函數內容) 呼叫了 message_vision()函數 (定義於simul_efun.c所以要解決可以從 goto.c 的83 行看起檢查呼叫 message_vision() 傳入的引數中有那一個是傳入 0 (空物件) ..不過訊息已經告訴你是第3個引數錯誤所以回頭看看 message_vision 所需要的引數 message_vision(\"字串\",第一物件,第二物件);就知道 原來 go() 第83行的 message_vision(\"...\",me,ob); 的ob是空物件.接著繼續追蹤 ob 的來源 就可以解決這個bug了--         [0;1;44m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[0m        [0;1;44m[1m[1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m[1m[0m        [0;1;44m[1m[1m [1m [1m [1m [1m[1m[1m[1mi[1m:[1m [1m [1m [1m[1m[1m[1m[1m[1m[1m[1mP[1m[1mn[1m[1mi[1m[1mH[1m[1m[1m[1m[1m[1mT[1m[1mw[1m[1mD[1m[1m[1m [1m [1m [1m [1m [1m [1m [1m [1m[1m[0m        [0;1;44m[1m[1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m[1mH[1m[1m[[1m[1m[1m[1m[1m[1mc[1m[1m[1m[1ms[1m[1mu[1m[1mt[1m[1m[1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m[1m[0m        [0;1;44m[1m[1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m[1m[0m        [0;1;44m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m