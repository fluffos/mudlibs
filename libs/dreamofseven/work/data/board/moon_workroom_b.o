);        set_weight(1000);        if( clonep() )                set_default_object(__FILE__);        else {        set(\"no_get\",1);        set(\"no_drop\",1);        set(\"unit\", \"個\");        set(\"volume\",1000);        set(\"value\",500);        }        setup(); }void init(){        add_action(\"open_box\",\"open\");}int open_box(string str){        object me=this_player();        object b,room;        room=load_object(\"/u/m/muedr/workroom\");                if(!me) return 0;        if(this_object()->query_temp(\"opened\") != 0) return 0;                if(str==\"box\" || str==\"謎之盒子\")        {        message_vision(\"world:world1:vision\",        HIW\"\\n\"+ob->name(1)+\"通過了\"HIR\"鬼斧神工\"WHT\"張大千的考驗！\\n\"NOR        WHT\"張大千說:真小毛頭還真厲害，老夫佩服佩服！！\\n\\n\"NOR,users());        message_vision(        HIR\"\\n頃刻間，張大千的謝禮突然頻空而降落下來。\\n\"NOR,me);                     b=new(__DIR__\"npc/eq/r_cloth\" );        b->move(environment(this_object()) );        destruct(this_object());                room=set_temp(\"opened\",1);        return 1;        }}--[0;1;34m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[0m[0;1;34m[1m[1m [1m [1m [1m [1m [1m [1m[1m[1m[1m[1m[1m[1m[1m[1m [1m [1m[1m[1m[1m[1m[1m~[1m[1m[1m [1m [1m[1m[1m[1m[1m [1m [1m[1m[1m[1m[1m[1m[1m[1m[1m [1m[1m[1m [1m [1m [1m[1m[0m[0;1;34m[1m[1m[1m[1m[1m[1m [1m [1m[1m[1m[1m[1m [1m [1m [1m [1m [1m [1m[1m[1m[1m[1m[1m[1m[1m[1m [1m [1m[1m[1m[1m[1m [1m [1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m [1m [1m[1m[0m[0;1;34m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[0m","time":1028188089,"title":"●hehe.c",]),(["author":"暗黑破壞神(moon)","msg":"#include <ansi2.h>#include <path.h>inherit ITEM;void create(){        set_name(\"謎之盒子\", ({\"mimi box\",\"box\"}) );        set(\"long\", \"一個神秘的盒子，上面記載的惻隱的歷史。\\n\"HIR\"\\t橫看成隱測成峰\\n\"    \"\\t遠近高低都不同\\n\"    \"\\t不識廬山真面目\\n\"    \"\\t只願身在此山中\\n\"NOR);        set_weight(500);        if( clonep() )                set_default_object(__FILE__);        else {        set(\"no_get\",1);        set(\"no_drop\",1);        set(\"unit\", \"個\");        set(\"volume\",5);        set(\"value\",500);        }        setup(); }void init(){        add_action(\"do_open\",\"open\");}int do_open(string str){        object me=this_player();        object b,room,ob;        ob = this_object();        room=load_object(\"/u/m/muedr/workroom\");                if(!me) return 0;        if(this_object()->query_temp(\"opened\") != 0) return 0;                if(str==\"box\" || str==\"謎之盒子\")        {        message_vision(\"world:world1:vision\",        HIW\"\\n\"+me->name(1)+\"通過了\"HIR\"鬼斧神工\"WHT\"張大千的考驗！\\n\"NOR        WHT\"張大千說:真小毛頭還真厲害，老夫佩服佩服！！\\n\\n\"NOR,users());        message_vision(        HIR\"\\n頃刻間，張大千的謝禮突然頻空而降落下來。\\n\"NOR,me);                  b=new(__DIR__\"npc/eq/r_cloth\" );        b->move(environment(this_player()) );        destruct(this_object());        room=set_temp(\"opened\",1);        return 1;        }}--[34m●●●●●●[0m [36mMoon[0;5m [0;37m字[0m [32m●●●●●●[0m","time":1028189614,"title":"●正確的",]),(["author":"瘤釧瘋(muder)","msg":"#include <ansi.h>#include <path.h>inherit ITEM;void create(){        set_name(\"謎之盒子\", ({\"mimi box\",\"box\"}) );        set(\"long\", \"一個神秘的盒子，上面記載的惻隱的歷史。\\n\"HIR\"\\t橫看成隱測成峰\\n\"    \"\\t遠近高低都不同\\n\"    \"\\t不識廬山真面目\\n\"    \"\\t只願身在此山中\\n\"NOR);        set_weight(500);        if( clonep() )                set_default_object(__FILE__);        else {        set(\"no_get\",1);        set(\"no_drop\",1);        set(\"unit\", \"個\");        set(\"volume\",5);        set(\"value\",500);        }        setup(); }void init(){        add_action(\"open_box\",\"open\");}int open_box(string str){        object me=this_player();        object b,room,ob;        ob = this_object();        room=load_object(\"/u/c/cating/workroom\");                if(!me) return 0;        if(this_object()->query_temp(\"opened\") != 0) return 0;                if(str==\"box\" || str==\"謎之盒子\")        {        message_vision(        HIW\"\\n\\t\\t\"+this_player()->query(\"name\")+\"通過了\"HIR\"鬼斧神工\"WHT\"張大千的考驗！\\n\\n\"NOR        WHT\"\\n\\t\\t張大千說:這小毛頭還真厲害，老夫佩服佩服！！\\n\\n\\n\"NOR,this_player());        write(        HIR\"\\n頃刻間，張大千的謝禮突然頻空而降落下來。\\n\"NOR,me);        b=new(__DIR__\"npc/eq/r_cloth\");        b->move(environment(this_object()) );        destruct(this_object());        return 1;        }}--[0;1;34m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[0m[0;1;34m[1m[1m [1m [1m [1m [1m [1m [1m[1m[1m[1m[1m[1m[1m[1m[1m [1m [1m[1m[1m[1m[1m[1m~[1m[1m[1m [1m [1m[1m[1m[1m[1m [1m [1m[1m[1m[1m[1m[1m[1m[1m[1m [1m[1m[1m [1m [1m [1m[1m[0m[0;1;34m[1m[1m[1m[1m[1m[1m [1m [1m[1m[1m[1m[1m [1m [1m [1m [1m [1m [1m[1m[1m[1m[1m[1m[1m[1m[1m [1m [1m[1m[1m[1m[1m [1m [1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m [1m [1m[1m[0m[0;1;34m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[0m","time":1028196509,"title":"●hehe",]),(["author":"剛蛋。改(truewind)","msg":"","time":1028199098,"title":"●經驗票的單位應該是一\"張\"吧 不是一台",]),(["author":"剛蛋。改(truewind)","msg":"l 木牌一塊木製的牌子，上面寫著 請\"物\"丟擲火紅果！throw xxx in poo