include <ansi.h>inherit NPC;mapping *combat_action = ({        ([      \"action\":                                                \"$N血氣一橫使出萬魔槍法之\"+HIR+\"\"/萬鬼齊奔\"\"+NOR+\"此招流利的刺傷$n的$l！\",                \"attact_type\":  \"bar\",  // 設定技能的攻擊種類                                        // 種類有 生物(bio) 獸性(bar)                                        // 魔法(wit)心靈(sou)科技(tec)                \"damage\" : 200,                \"damage_type\":  \"刺傷\",        ]),        ([      \"action\":               \"$N血氣一橫使出萬魔槍法之 \"+HIB+\"\"魔光普照\"\"+NOR+\"此招流利的刺傷$n的$l！\",                \"attact_type\":  \"bar\",                \"damage\" : 200,                \"damage_type\":  \"刺傷\",        ]),        ([      \"action\":               \"$N血氣一橫使出萬魔槍法之  \"+HIC+\"\"形鬼推舟\"\"+NOR+\"此招流利的刺傷$n的$l！\",                \"attact_type\":  \"bar\",                \"damage\" : 200,                \"damage_type\":  \"刺傷\",        ]),    ([  \"action\":                       \"$N血氣一橫使出萬魔槍法之  \"+HIW+\"\"百鬼殘影\"\"+NOR+\"此招流利的刺傷$n的$l！\",                \"attact_type\":  \"sou\",                \"damage\" : 200,                \"damage_type\":  \"刺傷\",        ]),    ([  \"action\":                       \"$N血氣一橫使出萬魔槍法之  \"+HIG+\"\"千鬼齊舞\"\"+NOR+\"此招流利的刺傷$n的$l！\",                \"attact_type\":  \"bar\",                \"damage\" : 200,                \"damage_type\":  \"刺傷\",        ]),    ([  \"action\":                       \"$N血氣一橫使出萬魔槍法之 \"+HIY+\"\"煌鬼百出\"\"+NOR+\"此招流利的刺傷$n的$l！\",                \"attact_type\":  \"bar\",            \"damage\" : 200,                \"damage_type\":  \"刺傷\",        ]),});void do_clean();void create(){        set_name(WHT\"李雲紹\"NOR,({\"lee yun shu\",\"lee\" }) );        set(\"long\",@LONG 年紀輕輕就有一身傲人的武功\，但自古以來英雄難過美人關就連他也不例外，自從認識一個叫秦霜霜的女子，便馬上跟她墬入愛河不可自拔，但在某日這位女子跟人跑了，令李雲紹傷痛不已，不過聽鄰居講這中好像有點隱情。LONG);        set(\"title\",HIB\"【惡鬼王】\"NOR);        set(\"age\",23);        set(\"level\",49);        set(\"gender\",\"男性\");        set(\"attitude\", \"peaceful\");        set(\"chat_chance\", 13);        set(\"chat_msg\",({         \"李雲紹看起來似乎有些鬱悶！\\n\",        }));        set_skill(\"fork\", 100);        set_skill(\"parry\",100);        set_skill(\"dodge\",100);        set_skill(\"unarmed\",100);        set_skill(\"block\",100);        set(\"con\",110);        set(\"str\",150);        set(\"int\",50);        set(\"dex\",100);        set(\"Merits/bar\",7);        set(\"addition_damage\",50);        set(\"no_busy\",1);        setup();        carry_object(__DIR__\"eq/p_necklace\")->wear();         carry_object(__DIR__\"wp/l_pike\")->wield();        set(\"actions\", (: call_other, __FILE__, \"query_action\" :));}void die(){        object ob;                if( !ob = query_temp(\"last_damage_from\") ) ob = this_player(1);        if( !ob )        {                ::die();                return;        }     message(\"world:world1:vision\",          HIR\"\\n【風雲變色錄】惡名昭彰的\"+HIB+\"【惡鬼王】\"WHT\"李雲紹\"HIR\"竟然沒沒無聞的\"+ob->name(1)+\"給殺害了                                                                                       《疾風門》光明右使\"+WHT+\"楊雙亟\"+NOR+\":\"HIW\"武林又少一位奇才了 +NOR+\"疾風門創人\"+HIY+\"軒轅烈:\"HIW\"可惜啊～可惜～                              \"+NOR+\"八極門第六代掌門人─\"+WHT+\"李書文:\"HIW\"如果他沒誤入歧途，今天也不會落到這種下場啊！      \"+NOR+\"八極門創人─吳鍾:\"HIW\"自作自受。 \"WHT\"李雲紹:\"HIW\"我並不後悔，但來世再見了，各位前輩們。\\n\\n\"+NOR,users());　　　                          ob->add(\"popularity\",5); //聲望        ::die();        return;}[0;1;30m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m-[1m[[1m [1m[1m[1m[1m[1m [1mE[1mn[1mt[1me[1mr[1m [1m[1m[1m[1m[1m[1m[1m [1m][1m-[1m-[1m-[1m-[1m-[1m-[0m--[0;1;34m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m