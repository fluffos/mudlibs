ry(\"id\") == \"skins\")           {                if(obj->is_busy() || obj->is_fighting())           {             command(\"whisper \"+who->query(\"id\")+ \"要等一下喔!!\\n\");             return 0;           }             message_vision(\"$N給了步六弧一襲 \"+ob->query(\"name\")+\"。\\n\",who);             command(\"tsk\");             obj->start_busy(10);             obj->set_temp(\"givecloth\",1);             destruct(ob);             call_out(\"givecloth\",1,obj);        return 1;           }                 }void givecloth(){      int i;      object me,obj,cloth;      me=this_player();      obj=this_object();      i=obj->query_temp(\"givecloth\");      if( !me || environment(me) != environment(obj) )        {                command(\"say 咦？\" + RANK_D->query_respect(me) + \"人走了啊?\");                return;        }      switch( i ) {          case 1:            say(CYN\"黃大仙哈哈大笑，便說真有你的!!\\n\"NOR);            obj->set_temp(\"givecloth\",i+1);            call_out(\"givecloth\",2,me);            break;          case 2:            command(CYN\"say 嗯!為了答謝你!\" + RANK_D->query_respect(me) + \" 你稍微等一下!!\"NOR);            obj->set_temp(\"givecloth\",i+1);            call_out(\"givecloth\",2,me);            break;          case 3:            say(CYN\"黃大仙順手一晃，緋紅色的衣服便在他手上！\\n\"NOR);            obj->set_temp(\"givecloth\",i+1);            call_out(\"givecloth\",3,me);            break;          case 4:            command(\"say 這件緋紅色的衣服，就當作老夫給你的謝禮好了！\");            obj->set_temp(\"givecloth\",i+1);            call_out(\"givecloth\",2,me);            break;          case 6:            cloth=new_ob(\"__DIR__\"eq/r_cloth\");            cloth->move(obj);            command(\"give cloth to \"+ me->query(\"id\") );            obj->delete_temp(\"givecloth\");            break;          }}--[0;1;34m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1