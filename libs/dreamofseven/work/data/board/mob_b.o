g ) {[36m:                         evaluate(schedule[time_tag]);[36m:                         last_scheduled_time_tag = time_tag;[36m:                 }[36m:                 if( !this_object() ) return;[36m:         }[36m: [36m:         ::heart_beat();[36m: }[36m: [36m: 	WOW .........[36m: 	mob 也可以排 schedule 喔..[36m: 	luky 看看吧..:p[36m: [2;37;0m我以經在新板本中加上啦 ..現在在測試中.. 並觀查系統負擔增加量.--         [0;1;44m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[0m        [0;1;44m[1m[1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m[1m[0m        [0;1;44m[1m[1m [1m [1m [1m [1m[1m[1m[1mi[1m:[1m [1m [1m [1m[1m[1m[1m[1m[1m[1m[1mP[1m[1mn[1m[1mi[1m[1mH[1m[1m[1m[1m[1m[1mT[1m[1mw[1m[1mD[1m[1m[1m [1m [1m [1m [1m [1m [1m [1m [1m[1m[0m        [0;1;44m[1m[1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m[1mH[1m[1m[[1m[1m[1m[1m[1m[1mc[1m[1m[1m[1ms[1m[1mu[1m[1mt[1m[1m[1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m[1m[0m        [0;1;44m[1m[1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m[1m[0m        [0;1;44m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[0m                                      [0;1;33m-[1m [1m[1ms[1m[1m[1m([1mL[1mu[1mk[1my[1m)[1m [1mi[1mn[1m [1mD