~~",]),(["time":962360555,"title":"●..","author":"我不是女生(basic)","msg":"#include <ansi.h>#include <room.h>inherit ROOM;void create (){ set(\"short\", HIB\"想愛\"HIB\"等待\"HIG\"的\"HIR\"窩\"NOR); set(\"long\",            HIC\"\\n\\t如果，想愛的人愛妳了 \\n\"            HIC  \"\\t        你更應珍惜每個夜晚。\\n\"            HIC  \"\\t如果，想愛的人不在愛你了  \\n\"            HIC  \"\\t        你應該去在找一個愛你的人。\\n\\n\"NOR);      set(\"exits\", ([ /* sizeof() == 6*/            \"down\" :\"/u/a/acme/workroom\",            \"luky\" :\"/u/l/luky/workroom\",            \"tmr\"  :\"/u/t/tmr/workroom\" ,            \"cominging\":\"/u/c/cominging/workroom\",            \"wizard\" :\"/d/wiz/hall1\",            \"kelly\" :\"/u/c/cutekelly/workroom\",]));      set(\"objects\",([                      __DIR__\"basic_b\": 1,                                          ]) );      set(\"light\",1);      set(\"valid_startroom\", 1);         setup();   }void init(){ this_player()->set(\"startroom\",\"/u/b/basic/workroom\");}  ",]),(["time":962460351,"title":"●我瘋了....","author":"空虛和寂寞(sexking)","msg":"瘋了吧.................,",]),(["time":962551655,"title":"●誰能教我呢?","author":"寂寞(sexking)","msg":"#include <ansi.h>inherit ROOM;void create(){        set(\"short\", \" \"HIC\"男用間\"NOR\" \");        set(\"long\", @LONG這裡是男生們專用的澡堂， 四處散怖著清香，還沒泡澡，你的精神已恢復了一大半看樣子這家澡堂果然名不虛傳...應該可以泡的很舒服吧...你已忍不住想跳到大浴池裡了。LONG        );        set(\"exits\", ([  \"north\" : __DIR__\"bath_2\",]));set(\"objects\",([__DIR__\"tub\" :1,]));         set(\"light\", 1);        set(\"no_fight\", 1);        set(\"no_magic\", 1);        set(\"no_clean_up\", 0);      setup();}void init(){        add_action(\"do_suds\",\"suds\");}int do_suds(){         object me;        me=this_player();        if( me->query_temp(\"suds\") <= 0 )        {                write(\"你還沒付錢不能泡澡喔！\\n\");                return 1;        }          if(me->query_temp(\"is_busy/sudsing\"))        {                write(\"你泡澡實在太舒服了，已不想做其它事了。\\n\");                return 1;        }        int i, j=0;        object *inv = all_inventory(me);        for(i=0; i<sizeof(inv); i++)        {        if(!inv[i]) continue;        if( inv[i]->query(\"equipped\") ) j++;         }        if(j) write(\"請到更衣間將衣物全脫下在進去泡澡好嗎?\\n\");        message_vision(HIW \"你快快樂樂的跑向大浴池旁將腳伸了進去。\\n\" NOR, me);        tell_object(me, HIR \"你初妳感到很燙但妳慢慢的適應了.....\\n\" NOR );        tell_object(me, HIB \"你將身子全放到浴池裡，感到無比的舒適感...\\n\" NOR );  me->disable_player_cmds(\"你泡澡實在太舒服了，已不想做其它事了。\\n\");        me->set_temp(\"is_busy/sudsing\",\"妳泡澡實在太舒服了，已不想做其它事了。\");        me->start_busy(10); return 1;}void suds1(object me){        if(!me) return;    tell_object(me,HIY\"由於實在是太舒服了..，你忍不住兩手放在兩旁扶手，上閉上了眼....\\n\"NOR);        me->receive_heal(\"hp\",me->query_con()*6);        me->receive_heal(\"ap\",me->query_con()*6);        me->receive_heal(\"mp\",me->query_int()*3);        return;}void sleep2(object me){        if(!me) return;        tell_object(me,YEL\"不知不覺中你已進入了快樂無比的世界...你漸漸睡著了...\\n\"NOR);me->receive_heal(\"hp\",me->query_con()*6);        return;}void wakeup(object me){        if(!me) return;        message_vision(HIW\"$N突然睜開眼睛似乎很滿足的樣子，從浴池中站了起來。\\n\" NOR,me);        me->enable_player_cmds();        me->delete_temp(\"is_busy/sudsing\");        me->receive_heal(\"hp\",me->query_con()*6);        me->receive_heal(\"mp\",me->query_int()*3);        me->receive_heal(\"ap\",me->query_con()*3);        me->add_temp(\"suds\",-1);        return;}",]),(["time":963152445,"title":"●嗚~~~~~~~~~","author":"小麥草(sexking)","msg":"嗚~~~~~~~~~ACME討厭我..我好沒用讓人討厭原諒我ㄉ錯",]),(["time":963229878,"title":"●HOHO...^^","author":"癡情笑多情(hack)","msg":"sexking......練功\房放些mob比較好玩喔.......!!^^--[31m                               [0m[31m邪惡的化身[0m->[35m惡靈駭客[0m<-[37m地獄的使者[31m     [0m[31m                               [0m[31m邪惡的化身[0m->[35m惡靈駭客[0m<-[37m地獄的使者[31m     [0m",]),(["time":96365752