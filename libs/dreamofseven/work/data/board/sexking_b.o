);[36m:         me->start_busy(10);[36m:  return 1;[36m: }[36m: void suds1(object me)[36m: {[36m:         if(!me) return;[36m:     tell_object(me,HIY\"由於實在是太舒服了..，你忍不住兩手放在兩旁扶手，上閉上了眼....\\n\"NOR);[36m:         me->receive_heal(\"hp\",me->query_con()*6);[36m:         me->receive_heal(\"ap\",me->query_con()*6);[36m:         me->receive_heal(\"mp\",me->query_int()*3);[36m:         return;[36m: }[36m: void sleep2(object me)[36m: {[36m:         if(!me) return;[36m:         tell_object(me,YEL\"不知不覺中你已進入了快樂無比的世界...你漸漸睡著了...\\n\"NOR);[36m: me->receive_heal(\"hp\",me->query_con()*6);[36m:         return;[36m: }[36m: void wakeup(object me)[36m: {[36m:         if(!me) return;[36m:         message_vision(HIW\"$N突然睜開眼睛似乎很滿足的樣子，從浴池中站了起來。\\n\" NOR,me);[36m:         me->enable_player_cmds();[36m:         me->delete_temp(\"is_busy/sudsing\");[36m:         me->receive_heal(\"hp\",me->query_con()*6);[36m:         me->receive_heal(\"mp\",me->query_int()*3);[36m:         me->receive_heal(\"ap\",me->query_con()*3);[36m:         me->add_temp(\"suds\",-1);[36m:         return;[36m: }[36m[0m[0m變數請在開頭宣告.中間宣告會有一點問題.--【閒聊】α\測試版(cominging)﹕快來玩吧！[0;1;36m[1mi[1m[1m[1m[1m[1m[1mj[1m[1m\\[1m[1m[1m[1m[1m[1m[1m([1mc[1mo[1mm[1mi[1mn[1mg[1mi[1mn[1mg[1m)[1m[1mR[1m[1m[1m[1m[1m[1m[1m[1ma[1m[1mI[0m[0m",]),(["time":964020374,"title":"●好高興","author":"小麥草(sexking)","msg":"我的workroom寫好了ㄝ雖然對各位高手來說不算什麼..但對我來說我寫時沒求過任何人幫我我覺得我長大了每天辛苦的研究也沒有白廢..^^@^____^@好高興ㄛ...jump對了..如有啥新招一定要post 給我看ㄛ謝謝啦!",]),(["time":964619295,"title":"回覆:好高興","author":"高速硬碟(wilfred)","msg":"[36m: ●好高興        [Jul 19]小麥草(sexking)的高見:[36m: =============================================================[36m: 我的workroom寫好了ㄝ[36m: 雖然對各位高手來說不算什麼..[36m: 但對我來說我寫時沒求過任何人幫我[36m: 我覺得我長大了[36m: 每天辛苦的研究也沒有白廢..[36m: ^^[36m: @^____^@[36m: 好高興ㄛ...jump[36m: 對了..如有啥新招一定要post 給我看ㄛ[36m: 謝謝啦![36m[0m[0mhoho最近也很少到別