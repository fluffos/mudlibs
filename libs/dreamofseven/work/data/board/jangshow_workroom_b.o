        init_attr(\"damage\",1); 
        setup(); 
} 
int query_autoload(){ return 1; } 

====================分隔線====================== 
//file: /u/l/luk/pet/pet.c 
inherit EQUIP; 
#define MAX_FOOD 100       //食量上限, 越多表示越慢餓 
#define MAX_WATER 100      //水量上限, 越多表示越慢渴 
#define MAX_FEED 250       //升級所需的量 
#define FEED 10            //每次進食增?#91;量: FEED/2 + random(FEED/2) 
#define MAX_LEVEL 10       //多少等級後進化 
#define BASIC 3            //隨機增?#91;的能力點數 
#include <ansi.h> 
#include \"/u/t/taily/pet/pet_prop.h\" 
static int tick; 
static string *colors = ({CYN,HIG,HIB,HIY}); 
void update_level(object ob, int flag, string color, string name); 
void setup_pet(object ob); 
mapping named_apply = ([ 
        \"double_dam\": \"% 傷害?#91;強\", 
        \"treble_dam\": \"% 致命攻擊\", 
        \"feedback\": \"% 攻擊者受到傷害 \", 
        \"quits\": \"  點傷害抵銷\", 
        \"absorb_gin\": \"% 吸取對手精\", 
        \"absorb_kee\": \"% 吸取對手氣\", 
        \"absorb_sen\": \"% 吸取對手神\", 
        \"absorb_force\": \"% 吸取對手內力\", 
        \"recuperate\": \"  快速回復生命值\", 
        \"strength\" : \"  爆發力\", 
        \"composure\" : \"  意志力\", 
        \"intelligence\" : \"  領悟力\", 
        \"personality\" : \"  媚惑力\", 
        \"spirituality\" : \"  集中力\", 
        \"constitution\" : \"  血氣度\", 
        \"dodge\" : \"  縱躍?#123;躲之技\", 
        \"parry\" : \"  拆招卸力之技\", 
        \"force\" : \"  內功\\\心法\", 
        \"whip\" : \"  基本鞭法\", 
        \"unarmed\" : \"  撲擊格鬥之技\", 
        \"sword\" : \"  基本劍法\", 
        \"magic\" : \"  基本法術\", 
        \"blade\" : \"  基本刀法\", 
        \"staff\" : \"  基本棒法\", 
        \"move\" : \"  行動能力\", 
        \"attack\" : \"  所有攻擊技能\", 
        \"defense\" : \"  所有防禦技能\", 
        \"gem\": \"% 獲得物品機率\", 
        \"invisibility\": \"  隱形能力\", 
        \"holy\" : \"% 聖屬性\", 
        \"undead\" : \"% 不死屬性\", 
        \"fire\" : \"% 火屬性\", 
        \"water\" : \"% 水屬性\", 
        \"land\" : \"% 地屬性\", 
        \"air\" : \"% 風屬性\", 
]); 

void create(){  seteuid(getuid());      } 
void setup() 
{ 
        if( clonep(this_object()) ) return; 
        set(\"armor_type\",\"pet\"); //定義新的防具 
} 
varargs void init_attr(string type,mixed add_prop) 
{ 
        set(\"armor_prop/\"+type, add_prop); //?#93;定防具基本能力 
} 
void init() 
{ 
        if( !userp(environment(this_object())) ) return; 
        add_action(\"do_feed\",\"feed\"); 
} 
int do_feed(string arg) 
{ 
        int value,      //物品價錢 
            level,      //寵物等級 
            ab,         //能力數值 
            flag;       //進化等級 
        string type,    //能力種類 
               color,   //寵物顏色 
               name, new_name; 
        object ob, 
               pl = environment(this_object()); 
        if(!arg) return notify_fail(\"你要餵食身上什麼物品給寵物?\\n\"); 
        if( !query_temp(\"food\") && !query_temp(\"water\") ) 
                return notify_fail(\"寵物不想被餵食。\\n\"); 
        ob = present(arg, pl); 
        if( !ob ) return notify_fail(\"你身上沒有這東西。\\n\"); 
        if( ob == this_object() ) return notify_fail(\"這似乎不太可能。\\n\"); 
        if( userp(ob) ) return notify_fail(\"寵物不吃玩家的。\\n\"); 
        if( ob->query(\"no_give\") || ob->query(\"no_sac\") || ob->query(\"no_drop\") ) 
                return notify_fail(\"寵物不吃這東西。\\n\"); 
        if( ob->query_amount() ) return notify_fail(\"寵物不吃這東西。\\n\"); 
        if( !value = ob->query(\"value\") ) return notify_fail(\"寵物不吃沒價值的東西。\\n\"); 
        name = this_object()->query(\"name\"); 

        //說明: 寵物等級分4種, 分別為:藍綠色, 亮綠色, 亮藍色, 與亮黃色 
        if( (sscanf( name,colors[0]+\"[+%d]%s\", level,new_name)==2) ){ 
                flag = 0;       //等級0: 藍綠色 
                color = colors[flag]; 
        } 
        else if( (sscanf( name,colors[1]+\"[+%d]%s\", level,new_name)==2) ){ 
                flag = 1;       //等級1: 亮綠色 
                color = colors[flag]; 
        } 
        else if( (sscanf( name,colors[2]+\"[+%d]%s\", level,new_name)==2) ){ 
                flag = 2;       //等級2: 亮藍色 
                color = colors[flag]; 
        } 
        else if( (sscanf( name,colors[3]+\"[+%d]%s\", level,new_name)==2) ){ 
                flag = 3;       //等級3: 亮黃色 
                color = colors[flag]; 
        } 
        else {  //寵物第一次升級, 給予等級0的基本?#93;定 
                flag = 0; 
                color = colors[flag]; 
                level = 0; 
                new_name = name; 
        } 

        message_vision(\"$N將身上的$n餵給寵物。\\n\",pl,ob); 
        if( wizardp(pl) ) tell_object( pl, \"數值: \"+log(value)+\"\\n\" ); 

        if( random(log(value)) > random(15) && flag < 3){ 
                type = keys(named_apply)[random(sizeof(named_apply))]; 
                if( value < 1000 ) ab = 1; 
                else if( value < 3000 ) ab = 2; 
                else if( value < 5000 ) ab = 3; 
                else if( value < 10000 ) ab = 4; 
                else if( value < 20000 ) ab = 5; 
                else if( value < 40000 ) ab = 6; 
                else if( value < 80000 ) ab = 7; 
                else ab = 8; 
                set(\"tmp/\"+type,1+random(ab)); 
        } 
        if( !query(\"tmp/feed\") ) set(\"tmp/feed\", ( FEED/2+random(FEED/2) ) ); 
        else set(\"tmp/feed\", query(\"tmp/feed\") + ( FEED/2+random(FEED/2) ) ); 

        if( query(\"max_feed\") < query(\"tmp/feed\") ){ 
            if( level < MAX_LEVEL ){ 
                level++;   //升級 
                tell_object(pl, HIM\"寵物升級囉。\\n\"NOR); 
                new_name = color+\"[+\"+level+\"]\"NOR + new_name; 
                this_object()->set(\"name\", new_name); 
            } 
            else if( flag < 3 ){ 
                flag++;    //進化 
                color = colors[flag]; 
                tell_object(pl, HIM\"寵物進化囉。\\n\"NOR); 
                update_level(this_object(), flag, color, new_name); 
            } 
        } 
        destruct(ob); 
        setup_pet(this_object());// 餵食完畢, update 
        return 1; 
} 
void update_level(object ob, int flag, string color, string name) 
//flag, 表示寵物進化等級 
{ 
        int value; 
        mapping apply,          //apply:進化前的原始資料 
                prop,           //prop: 餵食所增?#91;的資料 
                basic;          //basic:進化後的基本資料 
        string kind,up_name,*names; 

        setup_pet(ob); //更新 
        // 根據進化等級改顏色!! 
        if( flag == 1 ){ 
                names = keys(pet1); // pet_prop.h 
                up_name = names[random(sizeof(names))]; 
                basic = pet1[up_name]; 
                name = up_name; 
                set(\"name\", color+\"[+0]\"NOR+ name ); 
        } 
        else if( flag == 2 ){ 
                names = keys(pet2); // pet_prop.h 
                up_name = names[random(sizeof(names))]; 
                basic = pet2[up_name]; 
                name = up_name + name; 
                set(\"name\", color+\"[+0]\"NOR+ name ); 
        } 
        else if( flag == 3 ){ 
                names = keys(pet3); // pet_prop.h 
                up_name = names[random(sizeof(names))]; 
                basic = pet3[up_name]; 
                name = up_name + name; 
                set(\"name\", color+\"[+0]\"NOR+ name ); 
        } 
        else if( flag > 3 ){ 
                error(\"The Pet is error to update!\\n\"); 

                return;

        }

        apply = ob->query(\"armor_prop\");

        prop = ob->query(\"tmp\");

        if( mapp(apply) )                 //將進化前資料載入

                foreach( kind, value in apply )

                        set(\"armor_prop/\" + kind, value );

        if( mapp(prop) ){                 //將餵食資料載入

                foreach( kind, value in prop ){

                    if( !undefinedp(apply[kind]) ) //定義, 累?#91;

                        set(\"armor_prop/\" + kind, value+apply[kind] );

                    else //未定義, 載入原始資料

                        set(\"armor_prop/\" + kind, value);

                }

        }

        if( mapp(basic) ){                //將進化後資料載入

                apply = ob->query(\"armor_prop\");

                foreach( kind, value in basic ){

                    if( !undefinedp(apply[kind]) )

                        set(\"armor_prop/\" + kind, value+apply[kind]+random(BASIC) );

                        // 隨機增?#91;該寵物的主要能力

                    else

                        set(\"armor_prop/\" + kind, value);

                }

        }

        ob->delete(\"tmp\"); //消除增?#91;的能力

        return;

}

void setup_pet(object ob)

{

        mapping my;

        my = ob->query_entire_dbase();

        //if( clonep(this_object()) ) return;

        //***********************基本?#93;定******************************

        if( undefinedp(my[\"max_food\"]) ) my[\"max_food\"] = MAX_FOOD;

        if( undefinedp(my[\"max_water\"]) ) my[\"max_water\"] = MAX_WATER;

        if( undefinedp(my[\"max_feed\"]) ) my[\"max_feed\"] = MAX_FEED;

        if( undefinedp(my[\"food\"]) ) my[\"food\"] = MAX_FOOD;

        if( undefinedp(my[\"water\"]) ) my[\"water\"] = MAX_WATER;

        //*************************************************************

        if( my[\"water\"] <=0 ){

                ob->delete_temp(\"water\");

                my[\"water\"] = my[\"max_water\"];

        }

        else if( my[\"food\"] <=0 ){

                ob->delete_temp(\"food\");

                my[\"food\"] = my[\"max_food\"];

        }

        if( ob->query(\"tmp/feed\") > my[\"max_feed\"] ) ob->delete(\"tmp/feed\");

        //以上?#93;定表示quit再login, 需重新餵食

}

int wear()

{

        object pl = environment(this_object());

        if( !userp(pl) ) return 0;

        tick = 5 + random(10);

        setup_pet( this_object() ); //?#93;定基本?#93;定

        pl->set_temp(\"eq_pet\", query(\"name\"));

        set_heart_beat(1);

        return ::wear();

}

int unequip(){

        object pl = environment(this_object());

        if( !userp(pl) ) return 0;

        pl->delete_temp(\"eq_pet\");

        set_heart_beat(0);

        return ::unequip();

}

void heart_beat()

{

        mapping my;

        object ob,pl;

        ob = this_object();

        pl = environment(ob);

        if( !userp(pl) ) return;

        if( !query_heart_beat(pl) ) return; //以防斷線後餓死

        my = ob->query_entire_dbase();

        if( tick--  ) return;

        else tick = 5 + random(10);

        //重新定義, 寵物水與食物的扣損量

            if( my[\"water\"] > 0 ) my[\"water\"] -= 1+random(5);

            else if( my[\"water\"] <= 0 && !ob->query_temp(\"water\") ){

                 tell_object(pl,YEL\"寵物一臉想喝水的樣子。\\n\"NOR);

                 ob->set_temp(\"water\",15);

            }

            else{   

                if((int)ob->query_temp(\"water\") > 0)

                    ob->add_temp(\"water\",-1);

                    //可以有很多訊息, 15次訊息後死亡

                    tell_object(pl,YEL\"寵物快渴暈了。\\n\"NOR);

                if( ob->query_temp(\"water\") <= 0 ){

                    tell_object(pl,HIR\"寵物渴死了。。。。\\n\"NOR);

                    destruct(ob);

                }

            }

            if( my[\"food\"] > 0 ) my[\"food\"] -= 1+random(3);

            else if( my[\"food\"] <= 0 && !ob->query_temp(\"food\") ){

                 tell_object(pl,YEL\"寵物一臉想吃東西的樣子。\\n\"NOR);

                 ob->set_temp(\"food\",15);

            }

            else{   

                if((int)ob->query_temp(\"food\") > 0)

                    ob->add_temp(\"food\",-1);

                    //可以有很多訊息, 15次訊息後死亡

                    tell_object(pl,YEL\"寵物快餓暈了。\\n\"NOR);

                if( ob->query_temp(\"food\") <= 0 ){

                    tell_object(pl,HIR\"寵物餓死了。。。。\\n\"NOR);

                    destruct(ob);

                }

            }

}

int query_autoload(){ return 1; }




