<body>
<?
if ( $Send ) {
   if ( $From )
      mail( $To, $Subject, $Body, \"From: $From\" );
   else
      mail( $To, $Subject, $Body);
   $Msg = \"信件已經送出去了。\";
}
?>
<H2>Email 自傳功\能 <HR></H2>
<FORM Action = sendmail.php Method = post>  //sendmail.php 為此函式的檔名,可變更
