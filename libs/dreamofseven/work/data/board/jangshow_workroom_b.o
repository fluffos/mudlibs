[0m","author":"悠閒過日子(jangshow)","title":"回覆:心情小記","time":1032624824,]),(["msg":"#include <ansi.h>
inherit NPC;
void create()
{
  set(\"title\",HIG\"泊浪村村長\"NOR);
  set_name(\"澗壬\",({\"gan zen\",\"gan\",\"zen\"}));
  set(\"long\",@LONG
他是泊浪村的新任村長，為人相當陰沉，通常不輕易露出想法
，由於前任村長莫名的死亡，才使得他能擔任村長，在村中的
威望並沒比漁會頭目高，對此他似乎耿耿於懷，因此最近兩人
發生一些衝突。
LONG
    );
  set(\"attitude\", \"peaceful\");
  set(\"age\",32);
  set(\"gender\",\"男性\");
  set(\"level\",40);
  set(\"exp\",20000+random(6000));
    setup();
carry_object(__DIR__\"wp/fish-fork\")->wield();
carry_object(__DIR__\"eq/work-suit\")->wear();
}
 
void init(){
        object ob;
        ::init();
        call_out(\"greeting\", 3, ob);
        add_action(\"do_say\",\"say\");
        if(this_player()->query_temp(\"solo_hieea\")==1) call_out(\"robberquest\",1);
}
void greeting(object ob)
{
  object me;
  me=this_player();
  if(me->query(\"level\") > 40 && !me->is_fighting() )
  {
     message_vision(\"澗壬笑道：這位\"+ RANK_D->query_respect(me) +\"，你遠道而來小村是為了?，請恕我們無禮。\\n\",me);
  }
  else {
     message_vision(\"澗壬隨意打量一眼$N道：這位\"+ RANK_D->query_respect(me) +\"有何貴事呀?我們挺忙的\\n\",me);
  }
}
int do_say(string arg)
{
          object me;          
          me=this_player();
           if(arg == \"漁會頭目\" || arg ==\"易海\" && me->query_temp(\"knowhate\") >0 )
          {
            message_vision(YEL\"$N說：\"+ arg +\"\\n\"NOR,me );
            message_vision(\"澗壬對著$N說道：易海這小子，因為會了一些功\夫，就不把我看在眼裡\\n\",me);
     message_vision(\"澗壬小心看看四周後，偷偷對著$N說道：這位\"+ RANK_D->query_respect(me) +\"可否幫我一個忙？\\n\",me);
     write(HIW\"[你想幫他嗎? say 可 / 不可] \"NOR);
       
            me->set_temp(\"killhieea\",1);
            return 1;
           }
   if(arg == \"可\" && me->query_temp(\"killhieea\") >0 )
     {
      message_vision(YEL\"$N說：\"+ arg +\"\\n\"NOR,me );
      message_vision(\"澗壬對著$N說道：哈哈哈，你只要幫我把易海這傢伙給殺了，就成了。\\n\",me);
      message_vision(\"澗壬對著$N說:事成以後我必重重酬謝你。\\n\",me);
      message_vision(\"澗壬說道:此人一死我就安心了。\\n\",me);
           me->delete_temp(\"knowhate\"); 
           me->set_temp(\"killhieea,2);
            return 1;
      }
     else {
       message_vision(YEL\"$N說：在下無法幫你\\n\"NOR,me );                  message_vision(\"澗壬氣憤的說:好你走吧...沒想到你這麼無用\\n\"NOR,me);
       message_vision(\"澗壬露出一副不願理人的樣子。\\n\",me); 
       me->delete_temp(\"knowhate\");
       me->delete_temp(\"killhieea\");
}

void robberquest()
{
    object new;  
    
    this_player()->set_temp(\"solo_hieea\",2);
message_vision(\"澗壬十分的高興的說:做的太好了...哈哈...現在時機已到拉。\\n\",this_player());
      command(\"say 看來機會來了..我該去準備一下了\");
      command(\"say 這個東西就給你吧..當作是幫我的報酬\");
      
}






