","author":"[閒置][罪犯](iamtheking)","title":"●fist","time":1061166041,]),(["msg":"#include <ansi.h>
#include <weapon.h> 
#define WPNAME \"鑲嵌之槍\"
inherit FORK;

void create()
{
  set_name(HIY\"鑲嵌之槍\"NOR , ({ \"inlay pike\",\"pike\" }) ); 
  set_weight(8000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set(\"unit\", \"把\");
    set(\"long\", \"上面有一個小洞，不知道是幹麻的[inlay xxx]。\\n\");
    set(\"material\", \"gold\");
    set(\"value\",30000);
  }
  set(\"weapon_prop/bar\",2);
  set(\"weapon_prop/bio\",1);
  set(\"weapon_prop/fork\",10);
//  set(\"weapon_prop/parry\",10);    
  init_fork(50); 
  setup();
}
void init()
{
     add_action(\"do_inlay\",\"inlay\");
}
int do_inlay(string arg)
{ 
    object me=this_player(),obj;  
    if(this_object()->query_temp(\"inlaied\")==1) 
       return notify_fail(\"裡面已經鑲了一顆寶石，你沒看到嗎？\\n\");    

    /***************************************鑲嵌開始****************************************/ 

    if(arg ==\"red stone\") 
              { 
               if(!objectp(obj=present(\"red stone\",me)) ) return notify_fail(\"What?\\n\");
                   {
      
              message_vision(\"\\n$N小心翼翼的將\"HIR\"紅寶\"NOR\"，鑲進了\"HIC\"\"+WPNAME+\"\\n\"NOR,me); 
                    this_object()->set(\"long\",\"這是一把鑲了一顆\"HIR\"紅寶\"NOR\"的長槍，上面的小洞已經被填滿了。\\n\"
                                           HIW\"特殊能力：\"HIR\"火系\"HIW\"攻擊\\n\"NOR);   
                    destruct(obj);
                    this_object()->add_temp(\"inlaied\",1); 
                    this_object()->add_temp(\"inlay/red\",1);
                    }  
              return 1;
              }      
    if( arg ==\"blue stone\") 
              { 
               if(!objectp(obj=present(\"blue stone\",me)) ) return notify_fail(\"What?\\n\");
                   {
                    message_vision(\"\\n$N小心翼翼的將\"BLU\"藍寶\"NOR\"，鑲進了\"HIC\"\"+WPNAME+\"\\n\"NOR,me); 
                    this_object()->set(\"long\",\"這是一把鑲了一顆\"BLU\"藍寶\"NOR\"的長槍，上面的小洞已經被填滿了。\\n\"
                                           HIW\"特殊能力：\"BLU\"水系\"HIW\"攻擊\\n\"NOR);   
                    destruct(obj);
                    this_object()->add_temp(\"inlaied\",1); 
                    this_object()->add_temp(\"inlay/blue\",1);
              return 1;
              }  
    if( arg ==\"white stone\") 
              { 
               if(!objectp(obj=present(\"white stone\",me)) ) return notify_fail(\"What?\\n\");
                   {
                    message_vision(\"\\n$N小心翼翼的將\"HIW\"白寶\"NOR\"，鑲進了\"HIC\"\"+WPNAME+\"\\n\"NOR,me); 
                    this_object()->set(\"long\",\"這是一把鑲了一顆\"HIW\"白寶\"NOR\"的長槍，上面的小洞已經被填滿了。\\n\"
                                           HIW\"特殊能力：\"HIW\"光系\"HIW\"攻擊\\n\"NOR);   
                    destruct(obj);
                    this_object()->add_temp(\"inlaied\",1); 
                    this_object()->add_temp(\"inlay/white\",1);
                    }  
              return 1;
              }     
    if(arg ==\"green stone\") 
              { 
               if(!objectp(obj=present(\"green stone\",me)) ) return notify_fail(\"What?\\n\");
                   {
                    message_vision(\"\\n$N小心翼翼的將\"HIG\"綠寶\"NOR\"，鑲進了\"HIC\"\"+WPNAME+\"\\n\"NOR,me); 
                    this_object()->set(\"long\",\"這是一把鑲了一顆\"HIG\"綠寶\"NOR\"的長槍，上面的小洞已經被填滿了。\\n\"
                                           HIW\"特殊能力：\"HIG\"毒系\"HIW\"攻擊\\n\"NOR);   
                    destruct(obj);
                    this_object()->add_temp(\"inlaied\",1); 
                    this_object()->add_temp(\"inlay/green\",1);
                    }  
              return 1;
              }      
} 
