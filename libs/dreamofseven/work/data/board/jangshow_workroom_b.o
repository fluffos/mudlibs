","author":"悠閒過日子(jangshow)","title":"●hiko look","time":1033478061,]),(["msg":"#include <ansi.h> 
inherit NPC;
void do_heal();  // add -Jangshow
void create()
{
      set_name(HIB\"易海\" NOR,({\"hie-ie\",\"hie\"}) );
      set(\"title\",HIG \"漁會頭目\" NOR);   
      set(\"long\",@LONG
 「易海」是現任漁會頭目，生性平淡，少年時曾經因緣際會得到異
 人相助，使得習到一身高強功\夫，曾獨自擊倒許\海賊，亦曾參加過
 古劍亭，在村中是聲望最高的人物，目前由於閉關練功\，因此較少
 參與村中之事，而據說由他可得知神秘隱世嶼的一些事，使得許\多
 江湖之人不斷前來與他詢問，和「鹽俠」余滄是同鄉。 
LONG    
        );
        set(\"race\", \"human\");    
        set(\"unit\",\"位\");
        set(\"age\",38);
        set(\"level\",50); 
        set(\"max_ap\",6000); 
        set(\"max_mp\",6000);
        set(\"max_hp\",12000);
        set(\"exp\",60000+random(10000));
        set(\"limbs\", ({ \"頭部\", \"腹部\",\"胸部\",\"手部\",\"腳部\" }) );      
        add(\"addition_armor\",150);
        add(\"addition_damage\",200);  
        set(\"chat_chance\", 30);
        set(\"chat_msg\", ({
  (: command(\"exert jurlong-awi\") :), 
  (: command(\"do_heal\") :),
  (: command(\"do_heal\") :),
  (: command(\"say 這該如何是好，那些傢伙如此凔狂\") :),
  (: command(\"say 偏生現在我又無法離開，練功\\\正在緊要關頭\") :),
}));
        set(\"chat_chance_combat\", 30);
        set(\"chat_msg_combat\", ({
  (: command(\"exert jurlong-awi\") :),  
  (: command(\"do_heal\") :),  
  (: command(\"exert jurlong-awi\") :),  
  (: command(\"do_heal\" ):),   
  (: command(\"do_heal\") :),
})); 
      set_skill(\"jurlong-awi\",100);     
      set_skill(\"hammer\",100);   
      set_skill(\"dodge\",100);  
      set_skill(\"peep\",100);   
      setup(); 
} 

int special_attack(string arg)
{ 
    object me=this_player(),ob=this_object();
    int z,t,wp; 
    wp=me->query_temp(\"weapon\");
    if(!me || !ob) return 0;
    if(!wp) return 0;
    if(random(10)) return 0;
    z=me->query_dex();
    t=me->query_con();
    if(random(170) > t+z)
    {
      message_vision(HIY\"\\n$N\"+HIR\"怒吼一聲，運起\"+HIY\"絕浪心訣--破浪訣\\n\"
         +HIW\"向$n擊出\"+HIY\"—\"+HIC\"浪\"+HIY\"—\"+HIC\"濤\"+HIY\"—\"+HIC\"天\"+HIY\"—\"+HIW\"！\\n\"
         +HIW\"$n被強大的氣勁給\"+HIR\"完全擊中！\\n\"
         +HIW\"不由得的猛然退了許\\\多步\\n\\n\"+NOR,me,ob);   
     me->receive_damage(\"hp\",200+random(100),me);
      return 1; 
    }
    else
    {
      message_vision(HIY\"\\n$N\"+HIW\"雙拳緊握，\"+HIY\"絕浪心訣--破浪訣\"+NOR\"擊出\\n\"
                    +HIG\"頓時氣勁狂增\"+HIC\"全力一擊\"+HIW\"攻向$n..\\n\"  
                    +HIW\"$n瞬時感到危險！全力脫離氣勁範圍\\n\"
                    +HIC\"使得受到的傷害減低\\n\\n\"+NOR,me,ob);
      me->receive_damage(\"hp\",50+random(me->query_str()), me);
      return 1;

  }
}
void do_heal() //回血
{
        object ob;
        ob=this_object();
        //target = offensive_target(me);  // 敵人
        if(!ob) return 0;
        if(random(5)) return 0;
        if(ob->query(\"mp\")<20) return 0;
        message_vision(HIG\"\\n\\n$N使用了\"+HIY\"絕浪心訣--迴浪訣\"+HIC\"使得體力大增\\n\\n\"+NOR,ob,this_player());
        //ob->receive_heal(\"hp\",200+random(150) ); 
        ob->add(\"hp\",200+random(150));
        ob->receive_damage(\"mp\",20);
        ob->start_busy(1);  //start_busy -Jangshow
        return; // Jangshow
}

void die()
{
        object ob;
        if( !ob = query_temp(\"last_damage_from\") )
        ob = this_player(1);
        if( !ob ) 
        {
                ::die();
                return;
        }
        message(\"world:world1:vision\",
       \"\\n\"HIY\"【\"HIC\"沿海震訊\"HIY\"】\"HIG\"漁會頭目\"HIW\"「\"HIC\"易 海\" HIW\"」被\"+ob->name(1)+\"用驚人實力擊倒了。\\n\\n\"NOR,users());
        ob->add(\"popularity\",5); 
     message_vision(\"$N\"+HIC\"露出驚異眼神說︰\"+HIW\"果然江山代代有人出 . . 我死而無憾呀\"+NOR ,ob );  // ob -by Jangshow        ::die();
        return;
}

","author":"悠閒過日子(jangshow)","title":"●hiko look","time":1033835960,]),(["msg":"【閒聊】悠閒過日子(Jangshow)﹕寫個附身合體的遊戲吧！
【閒聊】悠閒過日子(Jangshow)﹕買持有靈！可以附在相容的WP上
【閒聊】悠閒過日子(Jangshow)﹕不一樣的持有靈，可以發揮不同的效果
","author":"悠閒過日子(jangshow)","title":"●game","time":1033837361,]),(["msg":"區域名稱: 暇日谷

區域大小: 40~50格左右不等

背景: 當年武林少俠寧采和在一次的戰役中，被敵方暗器所傷，在逃亡的當時，
　　　在途中結識了一個姑娘，名為虞妙如，在他不記代價的大力相助下，此為
　　　武林少俠才能在短短的半年恢復從前的武力，在他要返回中原時，想帶此
　　　姑娘一起同行，但是被拒絕了，但為了報仇，只能含著淚\自行返回，回到
　　　中原後，寧采和便直闖逍遙山莊找當年暗殺他的人，也許\是實力的差距，
　　　不出五招，便敗了他，報了仇後，寧采和回去原本的住處找那位姑娘，但
　　　是怎樣找，就是找不到，後來得知這位姑娘在半年前就因生了場大病，往
　　　生去了，頓時寧采和失去了目標，在痛失愛人的心情下，寧采和便宣佈退
　　　不管凡間紅塵之事。
　　　經過了數年，有當地旅客經過，看到太陽無暇的照耀著此地，便幫這兒提
　　　名為【暇日谷】。
","author":"劍心(kenshin)","title":"●計劃書","time":1034251525,]),(["msg":"#include <ansi.h> 
inherit NPC;

mapping *combat_action = ({
               ([      \"action\":         HIW\"$N\"NOR\"以氣化劍，心念一橫使出\"HIY\"觀闕劍法\"NOR\"─\"+HIW\"飄\"NOR\"覓尋\"HIW\"空\"+NOR\"此招流利的刺傷$n的$l！\",

                \"attact_type\":  \"bar\",
                \"damage\" : 200,
                \"damage_type\":  \"刺傷\",
        ]),
        ([      \"action\":               HIW\"$N\"NOR\"以氣化劍，心念一橫使出\"HIY\"觀闕劍法\"NOR\"─\"+HIC\"星\"NOR\"\"CYN\"瞻海\"HIC\"望\"+NOR\"戌鼎菗y利的刺傷$n的$l！\",
                \"attact_type\":  \"bar\",
                \"damage\" : 200,
                \"damage_type\":  \"刺傷\",
        ]),
    ([  \"action\":                       HIW\"$N\"NOR\"以氣化劍，心念一橫使出\"HIY\"觀闕劍法\"NOR\"─\"+HIG\"綠\"NOR\"\"GRN\"樹招\"HIC\"風\"+NOR\"戌鼎菗y利的刺傷$n的$l！\",
                \"attact_type\":  \"sou\",
                \"damage\" : 200,
                \"damage_type\":  \"刺傷\",
        ]),
    ([  \"action\":                       HIW\"$N\"NOR\"以氣化劍，心念一橫使出\"HIY\"觀闕劍法\"NOR\"─\"+HIY\"冰\"NOR\"\"YEL\"凝水\"HIY\"沁\"+NOR\"戌鼎菗y利的刺傷$n的$l！\",

                \"attact_type\":  \"bar\",
                \"damage\" : 200,
                \"damage_type\":  \"刺傷\",
        ]),
    ([  \"action\":                       HIW\"$N\"NOR\"以氣化劍，心念一橫使出\"HIY\"觀闕劍法\"NOR\"─\"+HIM\"花\"NOR\"\"MAG\"飛吹\"HIM\"雪\"+NOR\"戌鼎菗y利的刺傷$n的$l！\",

                \"attact_type\":  \"bar\",
            \"damage\" : 200,
                \"damage_type\":  \"刺傷\",
        ]),
});
void do_clean();

void create()
{
        set_name(\"寧采和\",({\"nin tsai ho\",\"nin\",\"tsai\",\"ho\" }) );
        set(\"long\",@LONG 
當年的武林奇俠，如今的暇日谷主，在江湖上的人氣依然沒變，
唯一改變的是，從原本的意氣風發，到現在的失魂落魄，令江湖
老一輩的前輩們非常憐惜這位難得的武林神童。
LONG
);
        set(\"title\",HIY\"暇日谷主\"NOR);
        set(\"age\",30);
        set(\"level\",49);
        set(\"gender\",\"男性\");
        set(\"attitude\", \"peaceful\");
        set(\"chat_chance\", 13);
        set(\"chat_msg\",({ 
        \"寧采和看起來似乎有些鬱悶！\\n\",
        }));
        set_skill(\"fork\", 100);
        set_skill(\"parry\",100);
        set_skill(\"dodge\",100);
        set_skill(\"unarmed\",100);
        set_skill(\"block\",100);   
        set(\"talk_reply\",\"你可給我打聽有關虞妙如、玄劍的事。\\n\");
         set(\"inquiry\", ([
            \"虞妙如\":CYN\"不用問了，他永遠不會回來了。\\n\"NOR,
            \"玄劍\":CYN\"它是我當年的愛劍，但是在我退隱江湖時，有天突然的消失，你能幫我找回嗎？\\n\"NOR,
                    ]) );

        set(\"con\",110);
        set(\"str\",150);
        set(\"int\",50);
        set(\"dex\",100);
        set(\"Merits/bar\",7);
        set(\"addition_damage\",50);
        set(\"no_busy\",1);
        setup();
        
        set(\"actions\", (: call_other, __FILE__, \"query_action\" :));
}
mapping query_action()
{
        return combat_action[random(sizeof(combat_action))];
}
int do_say(string arg)
{
        object me=this_player();
        object book;
        if(arg!=\"好\" || this_object()->is_fighting()      ||me->is_fighting() )
                return 0;
        message_vision(\"$N說道：好！\\n\",me);
        book=new(__DIR__\"item/paper\");
        message_vision(\"先謝過此位，這裡有我玄劍消失當天，一張小小的牛皮紙，上面編撰了一些文字希秧皝鴽A有幫助！！\\n\",this_object(),me);
        book->set_name(me->query(\"id\"));
      //command(\"give \" + me->query(\"id\"));   
        book->move(me); 
        return 1;
} 
 int special_attack(object me,object target,int hitchance)
{
    int tdex,tcon; 
    if(!me || !target) return 0;
    if(random(10)) return 0;
    tdex=target->query_dex();
    tcon=target->query_con();
    if(random(hitchance*10) > tdex+tcon)
    {  message_vision(HIC\"\\n$N心念一橫使出觀闕之秘─\"HIW\"玄\"HIC\"劍\"HIM\"斬\"HIR\"情\"BLK\"舞\\n\"NOR                           +HIR\"意\"NOR\"\"RED\"劍\"HIY\"快速飛向$n，便刺向膻中之穴門。\\n\"
                             +HIW\"念\"NOR\"劍\"HIY\"快速飛向$n，便刺向靈墟之穴門。\\n\"
                             +HIC\"舞\"NOR\"\"CYN\"劍\"HIY\"快速飛向$n，便刺向神封之穴門。\\n\"
                             +HIM\"傷\"NOR\"\"MAG\"劍\"HIY\"快速飛向$n，便刺向幽門之穴門。\\n\"
                             +HIG\"情\"NOR\"\"GRN\"劍\"HIY\"快速飛向$n，便刺向通谷之穴門。\\n\"
+NOR,me,target);

      target->receive_damage(\"kee\",500+random(150), this_object());
      return 1; 
    }
}
void die() 
}
   object ob;

   if( !ob = query_temp(\"last_damage_from\") )
   ob = this_player(1);
   if( !ob )
   {
     ::die();
     return;
   }

   message(\"world:world1:vision\",
HIW\"\\n\\n【觀星者云】\"HIM\"上空八方雲星殞落，昔日的武林奇俠寧采和消逝去了！！\\n\\n\"+NOR,users());

   ob->add(\"popularity\",3+random(2));
   ::die();
   return;
}

","author":"劍心(kenshin)","title":"●看一下","time":1034343260,]),(["msg":"bug fixd
但是我有寫一個小quest
update沒錯
但是我說出解quest的關鍵字
他沒給我我設定好的東西
so..等你醒醒幫我看一下吧
void relay_say(object me, string str)
{
  object ob = this_object();
  if( !userp(me) ) return;
  if( me == this_object() ) return;
    if(strsrch(str,\"好\") !=-1 && strsrch(str,\"可以\") !=-1)
  {
    if(ob->query_temp(\"item_give\"))
      command(\"say 對不起喔！\"+ob->query_temp(\"item_give_who\")+\"已經答應我要幫我找玄劍了！！\");
    else
    {
      command(\"tchat 真是感謝\"+ob->name(1)+\"答應我要幫我找回玄劍！！\"); 
      new(__DIR__\"item/item\")->move(ob);
      command(\"give \"+me->query(\"id\")+\" niou-pe paper\");
      ob->set_temp(\"item_give\",1);
      ob->set_temp(\"item_give_who\",me->query(\"name\"));
    }
  }
  return;
}

