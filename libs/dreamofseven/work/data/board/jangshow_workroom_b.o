[0m","author":"打打殺殺，你找別人吧(iamtheking)","title":"回覆:bug?","time":1082025429,]),(["msg":"// snoop.c

#include <ansi.h>

inherit F_CLEAN_UP;
void create()
{
        seteuid(getuid());
}
int main(object me, string arg)
{
        object ob;

        if( !arg ) {
                if( objectp(ob = query_snooping(me)) )
                        write(\"你現在正在監聽\" + ob->query(\"name\") + \"所收到的訊息。\\n\");
                return 1;
        } else if( arg==\"none\" ) {
                if( objectp(ob = query_snooping(me))
                &&      wiz_level(ob) >= wiz_level(me) )
                        tell_object(ob, HIW + me->name(1) + \"停止監聽你所收到的訊息。\\n\" NOR);
                snoop(me);
                write(\"Ok.\\n\");
                return 1;
        }

        ob = find_player(arg);
        if(!ob) ob = find_living(arg);
        if(!ob || !me->visible(ob)) return notify_fail(\"沒有這個人。\\n\");

        if( wizhood(me) != \"(admin)\"
        &&      wiz_level(me) <= wiz_level(ob) )
                return notify_fail(\"你沒有監聽\" + ob->name(1) + \"所收聽訊息的權利。\\n\");

        if( me==ob ) return notify_fail(\"請用 snoop none 解除監聽。\\n\");
                
        snoop(me, ob);
        if(ob->query_temp(\"gb_player\")) me->set_temp(\"snoop_type\",\"gb\");
        else me->set_temp(\"snoop_type\",\"big5\");
        write(\"你現在開始竊聽\" + ob->name(1) + \"所收到的訊息。\\n\");
        
        if( wizhood(me) != \"(admin)\" )
        {
                if( userp(ob)) log_file(\"SNOOP_PLAYER\",
                sprintf(\"%s(%s) snoops %s on %s.\\n\", me->name(1), geteuid(me), ob->name(1),
                        ctime(time()) ) );
                if( wizardp(ob) )
                tell_object(ob, HIW + me->name(1) + \"開始監聽你所收到的訊息。\\n\" + NOR);
        }
        return 1;
}

int help()
{
        write(@TEXT
指令格式﹕snoop <某人>|none

監聽其他使用者所收聽的訊息﹐snoop none 則取消監聽。
TEXT
        );
        return 1;
}

","author":"悠閒過日子(jangshow)","title":"●snoop.c","time":1082216023,]),(["msg":"AGSI - 自動整合軟體平台
簡介
簡單的說：就是從軟體的操作螢幕畫面上，利用軟體的方法，取得螢幕上所顯示的資料，並將取得的資料傳輸到遠端電腦(或本機上)的另一套軟體操作螢幕畫面上，達到各種不同的應用軟體都可以直接在本機端或網路上進行資料傳輸與交換的工作：

1. 針對各種作業平台(DOS、UNIX、WINDOWS、LINUX)上的軟體操作螢幕畫面所顯示的資料，都可 ---以立即取得。
2. 可以控制各類軟體的操作螢幕畫面 ─ 如軟體的功\能選項、按按鈕、鍵盤輸入、定位、切換視窗… ---等，自動將資料寫到軟體的操作螢幕畫面(包括寫入DOS、UNIX、LINUX)上，資料來源與資料目地 ---的格式對應可以由使用者自行定義。
3. 提供資料傳輸與交換進行的程序中引入巨集的功\能，讓資料內容可以進行運算、比對、邏輯判斷後 ---再傳輸或交換。
4. 適用於各類的應用軟體，不會受限於原開發程式所使用的語言 (如VB、C++、DELPHI、VFP…)，亦 ---不會受限軟體所使用的資料庫種類(ORACLE、MS SQL、SYBASE、INFORMIX…)，直覺式的交換也 ---不會直接操作資料庫，經由原來所使用的軟體存取資料庫內的資料，因此使用者不需要瞭解資料庫 ---的內容。
5. 原來所使用的軟體不需要修改，使用者操作軟體的習慣不會改變，亦不需要訓練使用者，節省企業 ---人力成本的費用。
6. 一勞永逸的資料傳輸與交換方案，任何應用軟體無論是過去、現在或未來開發設計的都必定有操作 ---的界面顯示在螢幕上，因此永遠可用直覺式交換的方法來傳輸及交換資料。針對越來越多的應用軟 ---體(e-Business、EIP、SCM、B2B…)運用在網路上，都可以直接設定使用。

