object() ) return 1;        ob_status = ob->query_status();        // check if can see the object 'ob' (hide)        if( !((ob_status&0x2)>>1) || (((status&0x8)>>3)&&((ob_status&0x2)>>1)) )                return 1;        if( !((ob_status&0x1)>>1) || (((status&0x4)>>3)&&((ob_status&0x1)>>1)) )                 return 1;        if( member_array(ob, this_object()->query_temp(\"visible_ob\")) != -1 )                return 1;        return 0;}int query_status() { return status; }--不論什麼時候秉持一個觀念: 做別人的事, 學自己的功\夫              聽別人的課, 學自己的心得忙茫盲？現代人的文明病，也許\就像我一樣，‧‧        加油吧～！","time":1001244270,"author":"踢ㄟ伏嘻(cominging)","title":"●to Luky: Is it right ?",]),(["msg":"[36m: ●to luky        [Sep 23]〥完全品(alickyuen)的高見:: =============================================================: 【現代】流氓龍蝦(Luky)﹕release 能幫忙寫採集和生產?: 可以[0m嗯..我只想過了一點點...我個人覺得好單調luky請再給些高見吧:Q..採集: 我打算寫一個skills和指令,不同是時代(past,now,future)      會抓到不同的東西,用outdoor去判斷得到的東西之類型.生產: 寫不難,,,但我想不太到那個生產方式,暫只想到像Thief給個信物      寫一些add_action.只想過一點點時間,有點爛@_@..luky給點見意吧:~[0m","time":1001692959,"author":"〥完全品(alickyuen)","title":"回覆:to luky",]),(["msg":"[36m: 回覆:to luky        [Sep 29]〥完全品(alickyuen)的高見:: =============================================================: : ●to luky        [Sep 23]〥完全品(alickyuen)的高見:: : =============================================================: : 【現代】流氓龍蝦(Luky)﹕release 能幫忙寫採集和生產?: : 可以: 嗯..我只想過了一點點...我個人覺得好單調: luky請再給些高見吧:Q..: 採集: 我打算寫一個skills和指令,不同是時代(past,now,future):       會抓到不同的東西,用outdoor去判斷得到的東西之類型.: 生產: 寫不難,,,但我想不太到那個生產方式,暫只想到像Thief給個信物:       寫一些add_action.: 只想過一點點時間,有點爛@_@..luky給點見意吧:~[0m我把魔力寶貝的設定描述一下吧:)採集系 共有三種職業- 礦工(採石與金屬礦,有時可挖到寶箱), 樵夫(砍木材與收集藥用花草), 獵人(收集獸皮毛肉與可食植物)生產系 製劍師,製刀師,製弓師..(各式武器都有專職),製衣師,製鞋師,製盾師..(各式防具)  廚師(生產mp回復道具-食物為持續效果-隨時間慢慢增加且無法一次吃太多), 藥師(生產hp回復道具-藥品效果立即)生產系必須有原料才能生產製造, 當然大多原料必須由採集系取得, 轉賣給生產系. (有些基本原料可由NPC購得)我是建議寫成信物或指令. 採集方面可以利用一個中央處理的檔案來管理, 傳入[使用者][地點檔名]與[採集種類]然後傳回[訊息字串]或是[採到的物品]生產方面用類似的做法即可.初期可以先簡單做個樵夫砍樹的技能(依技能等級和地點能砍到的東西不同), 然後再寫武器工匠用木頭做出強度不一的木劍來..另外必需事先做好的是\"玩家間的交易\",以及武器裝備使用時逐漸損壞的機制.--[0;1;36m-[1m [1m[1m[1m[1m][1m[1mD[1m[1mh[0;33m  [0;1;33m[1ms[1m[1m[1m([1mL[1mu[1mk[1my[1m)[0;33m [0;1;32ml[1mu[1mk[1my[1m@[1mm[1mu[1md[1ms[1m.[1mn[1me[1mt[0;33m [0;1;36m-[0m[0m","time":1001761846,"author":"流氓龍蝦(luky)","title":"回覆:to luky",]),(["msg":"前幾天聽etlin 說 luky 有寫一個圖形化的mud ，有client 可以下載，那兒可以下載？？ 我想要看看..!_!--                   - ♀By Tmr ♂-","time":1001763627,"author":"奇(tmr)","title":"●!_!",]),(["msg":"[36m: ●!_!        [Sep 29]奇(tmr)的高見:: =============================================================: 前幾天聽etlin 說 luky 有寫一個圖形化的mud ，有client 可以下載，: 那兒可以下載？？ 我想要看看..!_![0mhttp://bbs.ece.fcu.edu.tw/~dream/download/main.html是這個嗎..? @@--不論什麼時候秉持一個觀念: 做別人的事, 學自己的功\夫              聽別人的課, 學自己的心得忙茫盲？現代人的文明病，也許\就像我一樣，‧‧        加油吧～！[0m","time":1001774555,"author":"α\測試版(cominging)","title":"回覆:!_!",]),(["msg":"[36m: 回覆:!_!        [Sep 29]α\測試版(cominging)的高見:: =============================================================: : ●!_!        [Sep 29]奇(tmr)的高見:: : =============================================================: : 前幾天聽etlin 說 luky 有寫一個圖形化的mud ，有client 可以下載，: : 那兒可以下載？？ 我想要看看..!_!: http://bbs.ece.fcu.edu.tw/~dream/download/main.html: 是這個嗎..? @@[0mya....thanks--                   - ♀By Tmr ♂-[0m","time":1001816648,"author":"奇(tmr)","title":"回覆:!_!",]),(["msg":"[36m: 回覆:to luky        [Sep 29]流氓龍蝦(luky)的高見:: =============================================================: : 回覆:to luky        [Sep 29]〥完全品(alickyuen)的高見:: : =============================================================: : : ●to luky        [Sep 23]〥完全品(alickyuen)的高見:: : : =============================================================: : : 【現代】流氓龍蝦(Luky)﹕release 能幫忙寫採集和生產?: : : 可以: : 嗯..我只想過了一點點...我個人覺得好單調: : luky請再給些高見吧:Q..: : 採集: 我打算寫一個skills和指令,不同是時代(past,now,future): :       會抓到不同的東西,用outdoor去判斷得到的東西之類型.: : 生產: 寫不難,,,但我想不太到那個生產方式,暫只想