        if(arg==\"off\")                return notify_fail(\"你並沒有修練「念」。\\n\");           if(!arg || arg==\"exercise\")        {        if(me->query_temp(\"is_busy/psychical\") )                return notify_fail(\"你已經在做「點」的修行。\\n\");        if(me->query(\"hp\") < 5 || me->query(\"ap\") < 5 )                return notify_fail(\"你目前的身體狀況不好，無法修行「念」。\\n\");        if(me->is_fighting() )                 return notify_fail(\"你正忙著打架，沒空做「點」的修行。\\n\");         message_vision(HIW \"$N盤膝坐了下來，開始「點」的修行。\\n\" NOR,me);        me->receive_damage(\"hp\",3);        me->receive_damage(\"ap\",3);        me->set_temp(\"is_busy/psychical\",\"你正在做「點」的修行，暫時不能移動。\");        me->start_busy(2);        me->skill_active( \"psychical\",(: call_other, __FILE__, \"delay\", me:), 2);        return 1;        }        if(arg==\"engird\")        {        int psy,limit;        psy=me->query_temp(\"psychical_power\");        if( lv < 30)                return notify_fail(\"你「念」的能力不夠，無法使用「纏」。\\n\");        if(me->query(\"ap\") < 100 || me->query(\"hp\") < 100)                return notify_fail(\"你現在的身體狀態不好，無法使用「纏」。\\n\");        message_vision(GRN\"$N使用「纏」試著儲存念力。\\n\" NOR,me);        switch(lv/10)        {        case 3:        case 4:        case 5: limit=lv*5;     break;        case 6:        case 7:        case 8: limit=lv*8;     break;        default: limit=lv*10;        }        me->start_busy(2);        me->improve_skill(\"psychical\",1+random(2) );        me->receive_damage(\"hp\",lv);        me->receive_damage(\"ap\",lv);        if( lv+psy < limit ) {                me->add_temp(\"psychical_power\",lv);                return notify_fail(\"你覺得體內的念力似乎增加了。\\n\");        }        else return notify_fail(\"你並沒有覺得不同。\\n\");        }        return notify_fail(\"「念」目前有點(exercise)和纏(engird)等功\\\能。\\n\");}void delay(object me){        int inn,conn,exp;        inn=me->query_int();        conn=me->query_con();        exp=(inn*3+conn*2)/6+random(3);        if ( !me         ||   !me->query_temp(\"is_busy/psychical\")        ||    me->is_fighting() )       return;        if(me->query(\"hp\") < 5 || me->query(\"ap\") < 5 )        {                message_vision(\"$N結束了「點」的修行。\\n\",me);                me->delete_temp(\"is_busy/bagi_force\");                me->map_skill(\"bagi_force\");                return;        }               me->improve_skill(\"psychical\",exp );        me->receive_damage(\"hp\",3);        me->receive_damage(\"ap\",3);        me->skill_active( \"psychical\",(: call_other, __FILE__, \"delay\", me:), 3);        return;}int valid_learn(object me){        return 1;}int practice_skill(object me){        return 1;}void skill_improved(object me){        int a;        a = me->query_skill(\"psychical\", 1);        if( a % 5==0 && random(a*2) > random(a*3) )        {                if(random(2)==1) {                tell_object(me,HIY \"你的力量提高了！\\n\" NOR );                me->add(\"addition/str\", 1);                }                       else {                tell_object(me,HIY \"你的體質提高了！\\n\" NOR );                me->add(\"addition/con\", 1);                }        }        return;}--【閒聊】α\測試版(cominging)﹕快來玩吧！[0;1;36m[1mi[1m[1m[1m[1m[1m[1mj[1m[1m\\[1m[1m[1m[1m[1m[1m[1m([1mc[1mo[1mm[1mi[1mn[1mg[1mi[1mn[1mg[1m)[1m[1mR[1m[1m[1m[1m[1m[1m[1m[1ma[1m[1mI[0m","time":999307760,"title":"●記得註明是誰的",]),(["author":"遊龍俠(kkeenn)","msg":"念的修行法            纏 把氣留在身邊的修練,在放鬆的狀態下最容易施展,是以防禦為主的力量           絕 把氣完全阻絕的方法,對念的防禦力是\"0\",有高級的變化技\"隱\"           練 發出比平常時候更多氣的技巧;　            發 將氣送進物體,可以強物體本來的動作或特性[33m           高等應用技 凝 把氣聚集在眼睛上,做仔細的觀察[0m           圓 纏與練的高等應用技,把包圍在身旁的氣擴張,作為探測之用            隱  可以將發出的氣隱常起來,就散發強烈的氣,也不會被發現,除非適用高等應用技\"凝\"才可看見[36;45m發的種類[0m[36;45m放出系 以射出的方式釋放氣[0m[36;45m強化系 加強物品原有的功\能;　 [0m[36;45m變化系 改變氣的性質[0m[36;45m操作系 操作物質或生物[0m[36;45m具現化系 將氣物質化[0m[36;45m特質系 其他沒有歸類的特殊氣[0m--[37m   