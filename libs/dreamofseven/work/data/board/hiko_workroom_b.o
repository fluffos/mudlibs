部\",\"胸部\",\"手部\",\"腳部\" }) );              add(\"addition_armor\",150);        add(\"addition_damage\",200);          set(\"chat_chance\", 60);        set(\"chat_msg\", ({  (: command(\"exert jurlong-awi\") :),   (: do_heal :),  (: do_heal :),  (: command(\"say 這該如何是好，那些傢伙如此凔狂\") :),  (: command(\"say 偏生現在我又無法離開，練功\\\正在緊要關頭\") :),}));        set(\"chat_chance_combat\", 40);        set(\"chat_msg_combat\", ({  (: command(\"exert jurlong-awi\") :),    (: do_heal :),    (: command(\"exert jurlong-awi\") :),    (: do_heal :),     (: do_heal :),}));       set_skill(\"jurlong-awi\",100);           set_skill(\"hammer\",100);         set_skill(\"dodge\",100);        set_skill(\"peep\",100);         setup(); } int special_attack(object me,object target,int hitchance){     int z,t;     object me,wp,target;    target = offensive_target(me);  // 敵人    me = this_object();    wp=target->query_temp(\"weapon\");    if(!me || !target) return 0;    if(!wp) return 0;    if(random(4)) return 0;    z=target->query_dex();    t=target->query_con();    if(random(170) > t+z)    {      message_vision(HIY\"\\n$N\"+HIR\"怒吼一聲，運起\"+HIY\"絕浪心訣--破浪訣\\n\"         +HIW\"向$n擊出\"+HIY\"—\"+HIC\"浪\"+HIY\"—\"+HIC\"濤\"+HIY\"—\"+HIC\"天\"+HIY\"—\"+HIW\"！\\n\"         +HIW\"$n被強大的氣勁給\"+HIR\"完全擊中！\\n\"         +HIW\"不由得的猛然退了許\\\多步\\n\\n\"+NOR,me,target);         target->receive_damage(\"hp\",200+random(100),target);      return 1;  }    else    {      message_vision(HIY\"\\n$N\"+HIW\"雙拳緊握，\"+HIY\"絕浪心訣--破浪訣\"+NOR\"擊出\\n\"                    +HIG\"頓時氣勁狂增\"+HIC\"全力一擊\"+HIW\"攻向$n..\\n\"                      +HIW\"$n瞬時感到危險！全力脫離氣勁範圍\\n\"                    +HIC\"使得受到的傷害減低\\n\\n\"+NOR,me,target);      target->receive_damage(\"hp\",50+random(me->query_str()),target);      return 1;  }}void do_heal() //回血{        object ob;        ob=this_object();        if(!ob) return 0;        if( (ob->query(\"hp\") + 3000 < ob->query(\"max_hp\") ) && ob->query(\"mp\") > 20 )         {         message_vision(HIG\"\\n\\n$N使用了\"+HIY\"絕浪心訣--迴浪訣\"+HIC\"使得體力大增\\n\\n\"+NOR,ob);          ob->add(\"hp\",200+random(150));         ob->receive_damage(\"mp\",20);         ob->start_busy(1);  //start_busy -Jangshow         return; // Jangshow        }          return 0;}void die(){        object ob;        if( !ob = query_temp(\"last_damage_from\") )        ob = this_player(1);        if( !ob )         {                ::die();                return;        }        message(\"world:world1:vision\",       \"\\n\"HIY\"【\"HIC\"沿海震訊\"HIY\"】\"HIG\"漁會頭目\"HIW\"「\"HIC\"易 海\" HIW\"」被\"+ob->name(1)+\"用驚人實力擊倒了。\\n\\n\"NOR,users());        ob->add(\"popularity\",5);      message_vision(\"$N\"HIC\"露出驚異眼神說︰\"+HIW\"果然江山代代有人出 . . 我死而無憾呀\"+NOR ,this_object());  // ob -by Jangshow        ::die();        return;}","time":1033888285,]),(["author":"梅菲斯特(hiko)","title":"●...skill...","msg":"之前的skill有點怪怪的...不過我不太知原因現在改過一次...在/u/h/hiko/skill/jurlong-awi.c若有人有空幫我看一下...會出現這個->MudOS driver tells you: You have no heart beat!","time":1035470170,]),(["author":"梅菲斯特(hiko)","title":"●嗯...看看","msg":"╭──────────────────────────────────────●│  【 女鞭手 】   情城池之出師弟子「【神】群神亂舞」妮妮(Nene)╰──────────────────────────────────────╮╭──────────╮  等級  34 級   年齡 18 歲   種族 人類    性別 女性   ││夢幻七域 之 古代時空├───────────────────────────○├──────────╯生物(BIO)： 3( 3)   生命點數(HP)： 1060 / 1060        ││力量(STR)： 51( 50)   獸性(BAR)： 3( 3)   魔法點數(MP)：  405 / 405         ││體質(CON)： 51( 50)   魔法(WIT)： 2( 2)   內勁點數(AP)：  795 / 795         ││智慧(INT)： 25( 25)   心靈(SOU)： 2( 2)   戰鬥熟練度  ： 381595             ││敏捷(DEX)： 51( 49)   科技(TEC)： 2( 2)   經 驗 值    ： 265339             │○──────────────────────────────────────○│物理攻擊力： 75       攻擊命中率： + 41%  個 性 態 度 ： 有如天使般神聖     ││物理防禦力： 10       閃躲迴避率： + 40%  擊 殺 生 物 ： 17221          ┌─┤│心靈抵抗力： 35       聲      望： 526    擊 殺 玩 家 ： 0              │？│○────────────────────────────────────○─○妮妮           nene           4天20小時      61.231.19