dbase (["master":"hack","location":"/u/h/hack/workroom.c","name":"駭客留言板","long":"這是一塊用龍蝦做的留言板。","no_get":1,"unit":"面","notes":({(["title":"●現代的背景與方向","time":958896166,"author":"龍蝦(luky)","msg":"背景簡單來說就是我們現在的世界但是主大陸是虛構的. 當成玩家的出發點.主大陸的人事物以目前mud界的人物 故事 為主.但是注意不要用直接別的mud的mob原名. 稍微改幾個字以免抄襲主大陸基本上就是 電玩世界 , 往後會做一些其他的大陸 比如 福爾摩沙島(台灣)公會發展方向是以 團結力量大 一言以蔽之就是各種公會優缺點互補.--         [0;1;44m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[0m        [0;1;44m[1m[1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m[1m[0m        [0;1;44m[1m[1m [1m [1m [1m [1m[1m[1m[1mi[1m:[1m [1m [1m [1m[1m[1m[1m[1m[1m[1m[1mP[1m[1mn[1m[1mi[1m[1mH[1m[1m[1m[1m[1m[1mT[1m[1mw[1m[1mD[1m[1m[1m [1m [1m [1m [1m [1m [1m [1m [1m[1m[0m        [0;1;44m[1m[1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m[1mH[1m[1m[[1m[1m[1m[1m[1m[1mc[1m[1m[1m[1ms[1m[1mu[1m[1mt[1m[1m[1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m[1m[0m        [0;1;44m[1m[1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m [1m[1m[0m        [0;1;44m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[1m[0m                                      [0;1;33m-[1m [1m[1ms[1m[1m[1m([1mL[1mu[1mk[1my[1m)[1m [1mi[1mn[1m [1mD[1mS[1m [1m-[0m",]),(["title":"回覆:現代的背景與方