ost ccc",]),(["title":"●修正版sword","time":960909975,"author":"癡情笑多情(hack)","msg":"#include weapon.hinherit SWORD;void create(){            set_name(小麥芽劍, ({sexking sword,sword,}) );             set_weight(5);             if( clonep() )                set_default_object(__FILE__);        else {        set(unit, 枝);          set(long,@LONG   這只不過是一枝小麥草的嫩芽罷了。LONG        );     set(volume,30);          set(value, 400);           set(material,iron);                  set(limit_skill,40);      }          set(wield_msg, $N「哇咧」地一聲抽出一枝$n握在手中。\\n);           set(unwield_msg, $N將手中的$n摺一摺放入口袋裡。\\n);            init_sword(300);      setup();}沒有對齊,so很亂,自己再修吧.....^^--[31m                               [0m[31m邪惡的化身[0m->[35m惡靈駭客[0m<-[37m地獄的使者[31m     [0m[31m                               [0m[31m邪惡的化身[0m->[35m惡靈駭客[0m<-[37m地獄的使者[31m     [0m",]),(["title":"●Hmm...........","time":965042203,"author":"癡情笑多情(hack)","msg":"最近同學們都不玩DS了...........sigh他們說和尚都沒進度說.........sigh不知何時才會進階和尚...........sigh努力學好C語言中.........YA^^--[31m                               [0m[31m邪惡的化身[0m->[35m惡靈駭客[0m<-[37m地獄的使者[31m     [0m[31m                               [0m[31m邪惡的化身[0m->[35m惡靈駭客[0m<-[37m地獄的使者[31m     [0m",]),(["title":"●NOKIA 3210手機聲.......^^","time":965052907,"author":"加油加油加油^^(hack)","msg":"以下post兩篇NOKIA3210的手機音樂,許\茹芸的喔.....^^[37m1.時間的祕密[0m[37m8c2 8d2 8f2 4c2[0m[37m2a2 8a2 8a2 8a2[0m[37m8a2 8g2 8a2 8f2[0m[37m8d2 2f2 8a2 8a2[0m[37m8a2 8a2 8f2 8f2[0m[37m4d2 8a2 8a2 8a2[0m[37m8a2 8f2 8f2 4g2[0m[37m8c2 8c2 8g2 4g2[0m[37m8f2 4d2 2f2[0m[37m我沒有埋怨，蹉跎的只是一些時間，[0m[37m你些的字字依戀，我看到心都淪陷，[0m[37m愛沒有辜負那天[0m[37m2.愛不愛你都一樣[0m[37m8c3 8b2 8c3 8g2[0m[37m8e2 8f2 2g2 8c3[0m[37m8b2 8c3 8g2 8e2[0m[37m8a2 4g2 8a2 8e2[0m[37m8d2 2c2 8f2 8e2[0m[37m8c2 8c2 8a1 8e2[0m[37m2c2 8c2 8g2 8c2[0m[37m4c2 8a1 16e2[0m[37m16e2 2c2 4d2[0m[37m2c2 4a2 4g2 8c2[0m[37m4c2 8a1 16e2[0m[37m16d2 