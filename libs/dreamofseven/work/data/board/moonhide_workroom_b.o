       str = sprintf(\"%s%12s%s\",                                str,                                RANK_D->query_rank(list[j]),                                list[j]->short(1)                        );                         str += \"\\n\";        }                str +=HIG\"=========================================\\n\"NOR;        return str;}--[36m                        ╮      ╮      ╭      [0m[0;5;36m[5m[5m[5m[5m[5m[5m[5m~[5m[5m[5m[5m[5m[5m~[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m~[5m[5m[5m[5m[5m[5m~[5m[5m[5m[5m[0m[36m║║║║  ║║  ║║  ║║  ║  ║  ║  ║╠═╝[0m[0;5;36;41m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m [5m [5m[5m[5m[5m[5m [5m [5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[0m ","author":"月隱(moonhide)","title":"●.","time":1019664773,]),(["msg":"string sleep(string a);void create(){ string hmm=\"baga\", end; end = sleep(hmm); printf(\"%s\", end);}string sleep(string a){ a = a + \"moonhide\"; return a;}--[36m                        ╮      ╮      ╭      [0m[0;5;36m[5m[5m[5m[5m[5m[5m[5m~[5m[5m[5m[5m[5m[5m~[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m~[5m[5m[5m[5m[5m[5m~[5m[5m[5m[5m[0m[36m║║║║  ║║  ║║  ║║  ║  ║  ║  ║╠═╝[0m[0;5;36;41m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m [5m [5m[5m[5m[5m[5m [5m [5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[0m ","author":"月隱(moonhide)","title":"●.","time":1019735957,]),(["msg":"string sleep(string a);       //有一個字串變數叫sleep (=a)void create()                 //開始寫入code{                             //程式寫入點 string hmm=\"baga\", end;      //字串變數 hmm = 字串 baga 和 end end = sleep(hmm);            //變數 end = sleep(baga); printf(\"%s\", end);           //印出 抓到的string型態的變數字串,再往後抓,抓到end這個變數,也印出來}                             //程式結束點string sleep(string a)        //有一個字串變數叫sleep (sleep = a ){                             //程式寫入點 a = a + \"moonhide\";          // sleep = sleep + 字串 moonhide return a;                    //就會傳回a這個值,a = sleep + \"moonhide\"}--[36m                        ╮      ╮      ╭      [0m[0;5;36m[5m[5m[5m[5m[5m[5m[5m~[5m[5m[5m[5m[5m[5m~[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m~[5m[5m[5m[5m[5m[5m~[5m[5m[5m[5m[0m[36m║║║║  ║║  ║║  ║║  ║  ║  ║  ║╠═╝[0m[0;5;36;41m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m [5m [5m[5m[5m[5m[5m [5m [5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[0m ","author":"月隱(moonhide)","title":"●nod","time":1019736462,]),(["msg":"string sleep(string a);    //宣告函式sleep,定義a這個變數void create()                //程式寫入點{  string hmm=\"baga\", end;     //有一字串變數 = 字串 baga,hmm來裝baga,end用來裝 return傳回的值 end = sleep(hmm);           // end裡裝的是sleep這個func,由下面傳回 printf(\"%s\", end);          //把裝在字串變數 end裡的回值印出 = bagamoonhide}string sleep(string a)       //跑sleep這個func,等return傳回值,得到結果後,sleep再往上傳{ a = a + \"moonhide\";         // a =  baga + moonhide =>bagamoonhide return a;                   // 值為bagamoonhide,傳回string變數a ,sleep = a}--[36m                        ╮      ╮      ╭      [0m[0;5;36m[5m[5m[5m[5m[5m[5m[5m~[5m[5m[5m[5m[5m[5m~[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m~[5m[5m[5m[5m[5m[5m~[5m[5m[5m[5m[0m[36m║║║║  ║║  ║║  ║║  ║  ║  ║  ║╠═╝[0m[0;5;36;41m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m [5m [5m[5m[5m[5m[5m [5m [5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[5m[0m ","author":"月隱(moonhide)","title":"●.","time":1019744170,]),(["msg":"#include <ansi.h>