// promote.c
#include <ansi.h>
inherit F_CLEAN_UP;
private string *wiz_levels = ({
	"(player)",
	"(superplayer)",
	"(immortal)",
	"(apprentice)",
	"(wizard)",
	"(arch)",
	"(admin)"
});
int main(object me, string arg)
{
	object ob;
	string old_status, new_status,name;
	int my_level, ob_level, level;

	if( me!=this_player(1) ) return 0;

	if( !arg || sscanf(arg, "%s %s", arg, new_status)!=2 )
		return notify_fail("指令格式﹕promote <使用者> <等級>\n");

	if( wiz_level(new_status) < 0 ) return notify_fail("沒有這種等級。\n");
	tell_object(me,"member_array(new_status, wiz_levels):"+member_array(new_status, wiz_levels)+"\n");
	if( (int) member_array(new_status, wiz_levels)<0 ) return notify_fail("沒有這種等級。\n");
	if( !objectp(ob = present(arg, environment(me))) 
	||	!userp(ob) )
		return notify_fail("你只能改變使用者的權限。\n");

	if( wiz_level(me)<6 && wiz_level(me) < wiz_level(new_status)+1 )
		return notify_fail("你沒有這種權力。\n");

	if( wiz_level(me)<6 && wiz_level(me) <= wiz_level(ob) )
		return notify_fail("你沒有這種權力。\n");

	if( wiz_level(me)<6 && new_status == "(admin)" )
		return notify_fail("你沒有這種權力。\n");

	name=ob->query("id");
	old_status = wizhood(ob);

	seteuid(getuid());
	if( !(SECURITY_D->set_status(ob, me, new_status)) )
		return notify_fail("修改失敗。\n");
	if(new_status=="(superplayer)")
	{
		mkdir("/superplayer/"+name[0..0]+"/"+name);
		ob->set("cwd","/superplayer/"+name[0..0]+"/"+name+"/");
	}
	else if((old_status=="(player)" || old_status=="(superplayer)") && new_status!="(player)")
	     {
	     	mkdir("/u/"+name[0..0]+"/"+name);
		ob->set("cwd","/u/"+name[0..0]+"/"+name+"/");
		message("system",HIC+"\n\n\t突然間空中放出萬道光芒  「 轟 ～～ 隆 ～ 隆 ～」！\n\n\t"
					+ob->name_id(1)+HIC+"受到了"+me->name()+HIC+"的感召得道升天了，夢幻七域從此又多了一位巫師。\n\n"
					+NOR,users());
	     }
	if(new_status=="(superplayer)" || new_status=="(player)") ob->disable_wizard();
	message_vision("$N將$n的權限從 " + old_status + " 改為 " + new_status + " 。\n", me, ob);
	seteuid(getuid());
	ob->setup();
	ob->save();
	return 1;
}

int help(object me)
{
write(@HELP
指令格式 : promote <某人> (權限等級)

用來提升權限等級,

等級6  (admin)
等級5  (arch)
等級4  (wizard)
等級3  (apprentice)
等級2  (immortal)
等級1  (superplayer)
等級0  (player)

一個 admin 能提升權限至任何等級, 而 arch 只能提升至 wiz。
HELP
    );
    return 1;
}
