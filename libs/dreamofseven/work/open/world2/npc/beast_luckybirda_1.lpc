inherit NPC;
void do_flee();
void create()
{
	set_name("[1;31m紅冠幸運鳥[0m", ({"red lucky bird","bird"}) );
	set("long",@LONG
傳說中的紅冠幸運鳥，紅色的頭上放射狀的長了一些特別的紅色長羽
，形狀似冠，這種鳥十分少見，傳說可以帶給人幸運。
LONG);
	set("unit","隻");
	set("race", "beast");
	set("limbs", ({ "頭部", "身體", "雙足", "翅膀" })); //受攻部位
	set("verbs", ({ "bite","poke" })); //攻擊型態蹬hoof撞crash咬bite抓claw啄poke
	set("age", 1);
	set("int",50);
	set("str",5);
	set("con",5);
	set("max_hp",10);
	set("level",1);
	set("dex",50);
	set_temp("fly",1);
	set("chat_chance_combat", 80);
	set("chat_msg_combat", ({
		(: do_flee :),
	}) );
	setup();
    	set("exp",200+random(4000));
	add_money("dollar",1000);
}
void do_flee()
{
	if(this_object()->query("hp")<1) return;
	message_vision("[1;31m$N[37m突然一個轉身，振翅逃走了。[0m\n",this_object());
	environment(this_object())->bird_fly();
	destruct(this_object());
}
