inherit ITEM;
inherit F_FOOD;

void create()
{
  set_name("御飯團",({"rice ball","ball"}));
  set_weight(90);
  if( clonep() )
   set_default_object(__FILE__);
  else
  {
    set("unit", "個");
    set("value",300);
    set("heal_hp",50);
    set("food_remaining",6);
  }
  setup();
  call_out("it_name",1);
}

void it_name()
{
  string *str = ({
"黑胡椒牛柳",
"味增燒賣",
"蘆筍手捲",
"腐乳香雞",
"蒲燒鰻",
"鳳梨蝦",
"咖哩雞",
"古早味",
"富士山",
"鮪魚",
"肉鬆",
"魷魚",
"鮭魚",
"傳統"
});
  if(!this_object()) return;
  set("long", "御飯團，" +str[random(14)]+ "口味。\n\n\t\t-有 7-11 真好-");
  return;
}
