inherit NPC;

void create()
{
  set_name("蜻蜓", ({"dragonfly"}) );
  set("long",@LONG
在水邊都可看見的蜻蜓。
LONG
);
  set("race", "beast");
  set("unit","隻");
  set("age",1);
  set("level",2);
  set("con",1);
  set("limbs", ({ "頭部", "腹部","胸部" }) );
  set("verbs", ({ "bite" }) );
  setup();
  add_money("coin",10);
}
