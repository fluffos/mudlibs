#include <ansi.h>
#include <path.h>

inherit NPC;

void create()
{
  set_name("黃沙賊嘍囉", ({ "desert robber","robber" }) );
  set("gender", "男性" );
  set("long",@LONG
這是江湖上惡名昭彰的賊幫－－『黃沙幫』嘍囉。
LONG
);
  set("age",15);
  set("level",5);
  set("race","human");
  set_skill("dodge",30);
  set_skill("parry",20);

  setup();
  add_money("coin",500);
  carry_object(__DIR__"eq/eq10")->wear();
  carry_object(__DIR__"wp/wp5")->wield();
}

