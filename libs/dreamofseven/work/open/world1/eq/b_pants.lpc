#include <ansi.h>
#include <armor.h>
inherit PANTS;

void create()
{
        set_name("破布長褲",({"broken pants","pants"}) );
        set("long",@LONG
破破爛爛的棉布長褲。
LONG
);
        set_weight(200); 
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");       
                set("value",100);          
                set("volume", 2);                       
                set("material", "cotton");   
        }
        set("armor_prop/armor",2); 
        setup();
}

int query_autoload() { return 1; }   