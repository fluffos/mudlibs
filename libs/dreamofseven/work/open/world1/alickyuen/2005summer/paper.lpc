#include <ansi2.h>
#include <armor.h>

inherit EQUIP;

void setup();

void create()
{
	set_name( HIW"白紙"NOR, ({ "white paper", "paper" }) );
	set("long", @LONG
[37m▁▁▁▂▂▂▂▃▃▃▃▄▄▄▄▄▅▅▅▅▆▆▆▆▇▇▇▇████
