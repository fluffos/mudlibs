#include <weapon.h>
#include <ansi.h>
inherit ITEM;
void create()
{
        set_name(CYN"玲瓏魚皮"NOR, ({ "light cloth", "cloth" }) );
	set_weight(600);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "張");
                set("long", "這是玲瓏魚的魚皮.");
                }
        setup();
}
