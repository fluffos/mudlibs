inherit ITEM;
inherit F_PILL;

void create()
{
        set_name("灰燼", ({"ash"}));
        set("unit","堆");
        set("value", 0);
        set("no_sac", 1);
        set("long", "一堆黑黑的灰。\n");
	set("heal", ([
		"hp" : 1,
		"ap" : 1,
		"mp" : 1,
	]));
	set("eat_msg", "$N吃下一堆灰燼。\n");

        setup();
}
