#include <ansi.h>
#include <weapon.h>
inherit DAGGER;

void create()
{
  set_name(CYN"骨藏"HIR"之"HIW"短刃"NOR, ({ "hide-bone dagger","dagger" }) );
  set_weight(2100);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "柄");
    set("long", "以人骨為刀鞘的短刀，刀刃泛著青藍的邪氣。\n");
    set("value",3700);
    set("volume",3);
    set("material","blacksteel");
  }
  set("weapon_prop/dex",2);
  set("weapon_prop/hit",5);
  set("backstab_bonus",50);
  init_dagger(40);
  setup();
}
