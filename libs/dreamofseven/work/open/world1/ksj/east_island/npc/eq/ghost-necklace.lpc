#include <ansi.h>
#include <armor.h>
inherit NECK;

void create()
{
  set_name(MAG"邪鬼玉"NOR,({"ghost necklace","necklace"}) );
  set("long",@LONG
蘊含邪鬼邪力的寶玉，散發暗沉的紫色光芒。
LONG);
  set_weight(700); 
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "串");
    set("value",4000);          
    set("volume", 2);                       
    set("material", "stone");
  }
  set("armor_prop/armor",1);       
  set("armor_prop/dex",1);
  setup();
}
