inherit ROOM;

void create()
{
	set("short", HIC"酒吧"NOR);
	set("long", @LONG
全城最有名的酒都是在這釀造的，有許多客人都是遠從城外慕名而來
的。牆上有個告示牌(note)。
LONG
	);

	set("exits", ([ /* sizeof() == 2 */
            "east" : __DIR__"room068",
	    "down" : __DIR__"room106",
            ]));

	set("no_clean_up", 0);

	set("light", 1);

	setup();
	replace_program(ROOM);
}

