#include <armor.h>
inherit CLOTH;

void create()
{
  set_name("黑色緊身衣", ({ "black body suit", "suit" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 1500);
    set("long", @long
這是一件女人在穿的黑色緊身衣，你似乎還可以聞到上頭殘留下來的女人香味。
long
    );
    set("armor_prop/armor", 3);
  }
  setup();
}
