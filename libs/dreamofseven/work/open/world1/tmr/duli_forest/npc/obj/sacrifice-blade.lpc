#include <weapon.h>
#include <ansi.h>
inherit BLADE;
inherit F_UNIQUE;

void create()
{
  set_name(HIR "活祭" NOR, ({ "sacrifice blade","blade" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 50000);
    set("rigidity", 120);
    set("replica_ob", __DIR__"long-blade");
    set("long",@long
這是一把佈滿血跡的長刀，黯黝無光的刀鋒上不時流下一股鮮豔的血
流，而厚重的刀柄，更是被寫滿符文咒術的絲布緊緊包裹著。邪異而駭人
的氣氛正從整柄長刀往四周擴散開來。
long
);
  }
  init_blade(11);
  set("weapon_prop/cps", 2);
  set("weapon_prop/cor", 2);
  setup();
}
