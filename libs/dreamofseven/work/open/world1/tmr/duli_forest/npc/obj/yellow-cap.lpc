#include <armor.h>
inherit HEAD;

void create()
{
  set_name("黃色頭巾", ({ "yellow cap", "cap" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "條");
    set("value", 100);
    set("long", "一條沾滿風沙的頭巾。\n");
    set("armor_prop/armor", 2);
  }
  setup();
}
