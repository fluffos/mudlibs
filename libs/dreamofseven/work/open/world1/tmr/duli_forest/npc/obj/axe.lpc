#include <weapon.h>
inherit AXE;

void create()
{
  set_name("斧頭", ({ "axe" }));
  set_weight(5500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 800);
    set("rigidity", 80);
    set("long", "這是一把斧面頗大的斧頭，堅實的握柄更增添幾份穩重。\n");
  }
  init_axe(8);
  setup();
}
