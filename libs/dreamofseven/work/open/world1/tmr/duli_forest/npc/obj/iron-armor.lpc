#include <armor.h>
inherit ARMOR;

void create()
{
  set_name("鐵戰甲", ({ "iron armor", "armor" }));
  set_weight(15000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "套");
    set("value", 800);
    set("long", "這是一套沾滿黃沙塵土的鐵製盔甲，看得出來非常堅固耐用。\n");
    set("armor_prop/armor", 12);
  }
  setup();
}
