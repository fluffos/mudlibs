#include <armor.h>
inherit WAIST;

void create()
{
  set_name("狼子帶", ({ "wolf belt", "belt","_OBJ_ID_WOLF_BELT_" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "條");
    set("value", 150);
    set("long", "這是一條織有野狼圖案的腰帶。\n");
    set("armor_prop/cor", 1);
  }
  setup();
}
