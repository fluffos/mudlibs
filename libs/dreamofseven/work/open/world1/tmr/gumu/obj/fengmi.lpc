inherit ITEM;
inherit F_WATER;

void create()
{
        set_name("玉蜂蜜", ({"honey"}));
        set_weight(80);
        if( clonep() )
        set_default_object(__FILE__);
        else {
                set("long", "一罐玉蜂釀成的蜜。");
                set("unit", "罐");
        }
                set("value", 80);       
                set("heal_hp",10);
                set("water_remaining", 5); 
       setup();
}

