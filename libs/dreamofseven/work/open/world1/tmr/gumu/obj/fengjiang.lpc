// dumpling.c

inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("玉蜂漿", ({"honey juice", "jucie"}));
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一瓶用玉蜂巢搗成的漿。\n");
                set("unit", "瓶");
                set("value",10);
                set("food_remaining",3);
                set("heal_hp",5);  
        }
}


