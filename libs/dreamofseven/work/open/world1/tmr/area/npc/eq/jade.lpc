#include <armor.h>

inherit WAIST;

void create()
{
	set_name("玉佩",({"jade"}) );
	set("long","一枚用玉雕琢而成的玉佩。\n");
      set_weight(200);
        set("unit","枚");
	if (clonep() )
		set_default_object(__FILE__);
	else {
		set("unit","枚");
        set("value",80);           
		set("material","jade");
		set("armor_prop/armor",1);
	}
	setup();
}
