inherit ITEM;
inherit F_PILL;
void create()
{
        set_name("玉靈丹", ({ "u-len pill", "pill" }));
        set("long",@LONG
一粒藍色的小藥丸，應是民間通常的玉靈丹，由於其於內勁略有
益處，最是受行走江湖的武師等所愛用。
LONG
);
        set_weight(455);
        if( clonep() ) 
                set_default_object(__FILE__);
        else {
        	set("unit", "粒");
        }
        set("value", 150);
	set("heal",([ "ap": 40,]));
        setup();
}


