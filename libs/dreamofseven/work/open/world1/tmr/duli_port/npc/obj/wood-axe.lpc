#include <weapon.h>
inherit AXE;

void create()
{
  set_name("木斧", ({ "wood axe","axe" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 350);
    set("rigidity", 30);
    set("long", "這是一把小而巧的木製斧頭，拿來砍砍柴倒還堪使用。\n");
  }
  init_axe(8);
  setup();
}
