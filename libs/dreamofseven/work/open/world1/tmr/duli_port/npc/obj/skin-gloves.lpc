#include <armor.h>
inherit HANDS;

void create()
{
  set_name("豬牛羊皮製手套", ({ "skin gloves" , "gloves" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "雙");
    set("value", 2500);
    set("long", @long
這是一雙用豬、牛、羊三種動物的皮混紡而成的皮手套，雖然顏色混
雜，不怎麼美觀，但質地堅固，的確是頗高級耐用的手套。
long
    );
    set("armor_prop/armor", 1);
  }
  setup();
}
