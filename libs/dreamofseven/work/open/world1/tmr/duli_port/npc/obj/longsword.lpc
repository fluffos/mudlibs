
#include <weapon.h>
inherit SWORD;

void create()
{
  set_name("長劍", ({ "long sword", "sword" }));
  set_weight(7000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 500);
    set("rigidity", 20);
    set("long", "這是一把鐵打造的長劍，比起短劍來，更具有殺傷力。\n");
  }
  init_sword(10);
  setup();
}
