#include <armor.h>
inherit CLOTH;

void create()
{
  set_name("武道服", ({ "fighter cloth", "cloth" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 250);
    set("long", "一件胸口繡有「銀刀」字樣的武鬥服，質地摸起來非常的舒服。\n");
    set("armor_prop/armor", 4);
  }
  setup();
}
