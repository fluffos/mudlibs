#include <weapon.h>
inherit BLADE;

void create()
{
  set_name("屠刀", ({ "butcher knife", "knife" }));
  set_weight(2500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 1200);
    set("rigidity", 50);
    set("long",@LONG
這是一把廚師常用的屠刀，大都只是製刀工廠機器打磨出來的。
LONG
);
  }
  init_blade(10);
  setup();
}
