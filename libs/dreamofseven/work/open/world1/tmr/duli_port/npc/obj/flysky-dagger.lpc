#include <weapon.h>
inherit DAGGER;

void create()
{
  set_name("飛天匕", ({ "fly-sky dagger", "dagger" }));
  set_weight(3500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 1000);
    set("rigidity", 25);
    set("long", @long
這是一把雕刻十分精美的短匕，匕鋒上的刻畫隱隱然可以看出一種萬里晴空的感覺。
long);
  }
  init_dagger(5);
  set("weapon_prop/attack", 2);
  set("weapon_prop/dex", 2);
  setup();
}
