#include <weapon.h>
inherit BLADE;

void create()
{
  set_name("大刀", ({ "big blade", "blade" }));
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 500);
    set("rigidity", 30);
    set("long", 
    "這是一把光刀鋒就長近半公尺的大刀，力量稍嫌不足的人，連拿都拿不動。\n"
                    );
  }
  init_blade(10);
  setup();
}
