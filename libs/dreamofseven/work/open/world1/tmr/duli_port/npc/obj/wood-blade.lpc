#include <weapon.h>
inherit BLADE;

void create()
{
  set_name("木刀", ({ "wood blade","blade" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 350);
    set("rigidity", 30);
    set("long", 
    "這是一把小木刀，想拿來防身還稍嫌不足。\n"
                    );
  }
  init_blade(8);
  setup();
}
