#include <weapon.h>
inherit BLADE;

void create()
{
  set_name("白銀短刀", ({ "silver blade", "blade" }));
  set_weight(3500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 1000);
    set("rigidity", 25);
    set("long", 
            "這是一把純銀打造的短刀，摸起來非常堅固，刀鋒也是非常銳利。\n"
                    );
  }
  init_blade(10);
  set("weapon_prop/attack", 5);
  setup();
}
