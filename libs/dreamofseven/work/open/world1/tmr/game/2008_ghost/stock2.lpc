#include <ansi.h>
inherit ITEM;


string getLong()
{
        return sprintf("三牲祭品(animal-sacrifice stock) [誠意 %d 份]",query("time") );
}

void create()
{
        set_name("三牲祭品",({"animal-sacrifice stock", "stock", "_GHOST_STOCK_"}) );
        set("long",@LONG
這是一份雞鴨魚肉的三牲祭品，用來在中元節祭拜四方好兄弟。
LONG
);
        set_weight(1);
        if(clonep() )
                set_default_object(__FILE__);
        else
        {
                set("unit","份");
        }
        set("value", 100);
        set("time", 100 + random(500) );
    
        setup();
        set("long", query("long") + getLong() );
}


