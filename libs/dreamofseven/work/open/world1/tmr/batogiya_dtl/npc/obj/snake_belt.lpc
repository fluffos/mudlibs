#include <armor.h>
inherit WAIST;

void create()
{
  set_name("蛇皮腰帶", ({ "snake's skin belt", "belt"}));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "條");
    set("value", 5000);
    set("long", "一條蛇皮製作而成的腰帶，上頭刻著一排看不懂的文字。\n");
    set("armor_prop/armor", 1);
  }
  setup();
}
