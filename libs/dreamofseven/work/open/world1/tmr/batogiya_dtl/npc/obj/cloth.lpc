#include <armor.h>
inherit CLOTH;

void create()
{
  set_name("厚皮衣", ({ "fur cloth", "cloth" }));
  set_weight(2200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 250);
    set("long", "一件用野獸超厚皮所縫製而成的衣服。\n");
    set("armor_prop/armor", 2);
  }
  setup();
}
