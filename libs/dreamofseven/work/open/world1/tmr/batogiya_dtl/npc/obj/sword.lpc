#include <weapon.h>
inherit SWORD;

void create()
{
  set_name("哈粒剝落劍", ({ "ha lipoluo sword", "sword" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 1000);
    set("rigidity", 10);
    set("long", "一把哈哈村特製的短劍，上頭還刻畫著一個笑臉，十分有趣。\n");
  }
  init_sword(10);
  setup();
}
