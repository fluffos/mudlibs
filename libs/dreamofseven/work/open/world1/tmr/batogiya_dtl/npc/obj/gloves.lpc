#include <armor.h>
inherit HANDS;

void create()
{
  set_name("厚皮手套", ({ "fur gloves" , "gloves" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "雙");
    set("value", 500);
    set("long", "一雙用野獸超厚皮製成的手套。");
    set("armor_prop/armor", 2);
  }
  setup();
}
