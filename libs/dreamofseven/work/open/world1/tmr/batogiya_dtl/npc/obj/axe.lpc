#include <weapon.h>
inherit AXE;

void create()
{
  set_name("哈粒剝落斧", ({ "ha lipoluo axe", "axe" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 1000);
    set("rigidity", 10);
    set("long", "一把哈哈村特製的短斧，上頭還刻畫著一個笑臉，十分有趣。\n");
  }
  init_axe(10);
  setup();
}
