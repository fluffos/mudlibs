#include <armor.h>
inherit BOOTS;

void create()
{
  set_name("厚皮鞋", ({ "fur boots", "boots" }));
  set_weight(2300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "雙");
    set("value", 250);
    set("long", "這是一雙用野獸的超厚皮製成的鞋子。");
    set("armor_prop/armor", 2);
  }
  setup();
}
