#include <armor.h>
inherit ARMOR;

void create()
{
  set_name("青銅護甲", ({ "bronze armor", "armor" }));
  set_weight(11000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 600);
    set("long", "一件青銅製成的護甲，看起來相當沉重，但是可以保護你的生命安全。");
    set("armor_prop/armor", 10);
  }
  setup();
}
