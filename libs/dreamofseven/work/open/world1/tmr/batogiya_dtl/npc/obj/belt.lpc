#include <armor.h>
inherit WAIST;

void create()
{
  set_name("厚皮腰帶", ({ "fur belt", "belt"}));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "條");
    set("value", 1600);
    set("long", "這是一條利用野獸超厚皮製成的腰帶，看起來很實用。\n");
    set("armor_prop/armor", 2);
  }
  setup();
}
