#include <armor.h>
inherit ARMOR;

void create()
{
  set_name("魔獸戰甲", ({ "evil-monster armor", "armor" }));
  set_weight(15000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "套");
    set("value", 1500);
    set("long", "這似乎是傳說中的魔獸常穿的戰甲，你可以明顯感覺到戰甲上傳出的邪氣。\n");
    set("armor_prop/armor", 8);
  }
  setup();
}
