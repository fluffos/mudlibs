#include <weapon.h>
inherit AXE;

void create()
{
  set_name("巨魔斧", ({ "huge-evil axe","axe"}));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 3500);
    set("rigidity", 80);
    set("long", @long
　　這是一把造型奇特的巨大斧頭，薄而大的斧鋒上有著一個個的小洞，
在揮舞時想必會帶起陣陣刺耳的風聲。
long);
  }
  init_axe(6);
  set("weapon_prop/str", 2);
  set("weapon_prop/cps", -2);
  setup();
}
