#include <armor.h>
inherit WAIST;

void create()
{
  set_name("蟒蛇腰帶", ({ "python belt", "belt"}));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "條");
    set("value", 600);
    set("long", "這是一條用蟒蛇皮製成的腰帶，光滑的蛇鱗增加了不少防禦能力。\n");
    set("armor_prop/armor", 4);
  }
  setup();
}
