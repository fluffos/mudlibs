#include <weapon.h>
inherit BLADE;

void create()
{
  set_name("單刀", ({ "blade" }));
  set_weight(3500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 500);
    set("rigidity", 25);
    set("long", 
    "這是一把鐵製的單刀，由於價格便宜，一般人都能買的到。\n"
                    );
  }
  init_blade(14);
  setup();
  set("name", ENHANCE_D->enhance_weapon(this_object(),0,"刀") );
}
