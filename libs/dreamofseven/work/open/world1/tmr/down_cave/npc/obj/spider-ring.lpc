#include <armor.h>
inherit FINGER;

void create()
{
  set_name("蜘蛛戒指", ({ "spider ring", "ring","_QUEST_ITEM_WIRE_NINA_" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "枚");
    set("value", 8000);
    set("long", "這是一枚蜘蛛造型的戒指，你仔細端詳，卻赫然發覺是十隻腳的蜘蛛樣子。\n");
    set("armor_prop/armor", 2);
  }
  setup();
}
