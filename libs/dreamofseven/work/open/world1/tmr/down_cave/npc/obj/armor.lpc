#include <armor.h>
inherit ARMOR;

void create()
{
  set_name("盔甲", ({  "armor" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 2000);
    set("long", "這是一件流傳在血腥荒野上的盔甲，常被流浪在那邊的妖魔穿載著。\n");
    set("armor_prop/armor", 10);
  }
  setup();
}
