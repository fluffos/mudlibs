#include <armor.h>
inherit HEAD;

void create()
{
  set_name("青色髮帶" ,({ "cyan hairpin", "hairpin" }));
  set_weight(400);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "條");
    set("value", 1800);
    set("long", @long
這是一條青色的髮帶，上頭沾滿了不少塵沙，但是編織精美秀氣。
long
    );
    set("armor_prop/armor", 2);
  }
  setup();
}
