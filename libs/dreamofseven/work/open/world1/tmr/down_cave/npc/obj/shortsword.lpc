#include <weapon.h>
inherit SWORD;

void create()
{
  set_name("短劍", ({ "short sword", "sword" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 300);
    set("rigidity", 10);
    set("long", "一把鐵製的短劍，是一般旅人的基本防身武器。\n");
  }
  init_sword(14);
  setup();
  set("name", ENHANCE_D->enhance_weapon(this_object(),0,"短劍"));
}
