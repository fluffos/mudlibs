#include <armor.h>
inherit BOOTS;

void create()
{
  set_name("長靴", ({"boots" }));
  set_weight(2500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "雙");
    set("value", 1500);
    set("long", @long
這是一雙流傳在血腥荒野上的長靴，常被流浪在那邊的妖魔穿載著，通
常具有奇特的能力，能使用者能獲得額外的幫助。
long
    );
    set("armor_prop/armor", 5);
  }
  setup();
}
