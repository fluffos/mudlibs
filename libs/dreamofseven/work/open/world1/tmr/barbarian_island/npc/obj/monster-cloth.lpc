#include <armor.h>
inherit CLOTH;

void create()
{
  set_name("野獸皮衣", ({ "monster cloth", "cloth" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 300);
    set("long", "這是一件不知用什麼野獸皮做成的皮衣。\n");
    set("armor_prop/armor", 2);
  }
  setup();
}
