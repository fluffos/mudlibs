#include <armor.h>
inherit FINGER;

void create()
{
  set_name("玉戒", ({ "jade ring", "ring" ,"_OBJ_ID_JADE_RING_"}));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "枚");
    set("value", 0);
    set("long", "這是一枚帶著乳白色的玉戒指。\n");
    set("armor_prop/int", -1);
    set("armor_prop/str", 1);
  }
  setup();
}
