#include <armor.h>
inherit PANTS;

void create()
{
  set_name("野獸毛褲", ({ "monster pants", "pants" }));
  set_weight(2500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 300);
    set("long", "這是一件不知用什麼野獸皮做成的毛褲，雖然粗糙但是耐磨。");
    set("armor_prop/armor", 2);
  }
  setup();
}
