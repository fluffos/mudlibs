#include <weapon.h>
inherit HAMMER;

void create()
{
  set_name("大木棒", ({ "big wood blunt", "blunt" }));
  set_weight(7000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 100);
    set("rigidity", 80);
    set("long",@long
這是個用硬質橡木做成的大木棒，力量稍嫌不足的人實在拿不起這麼重的武器。
long
);
  }
  init_hammer(5);
  setup();
}
