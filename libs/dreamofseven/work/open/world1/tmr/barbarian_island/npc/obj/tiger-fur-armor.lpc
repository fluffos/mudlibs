#include <armor.h>
inherit ARMOR;

void create()
{
  set_name("虎皮護甲", ({ "tiger-fur armor", "armor" }));
  set_weight(15000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "套");
    set("value", 2000);
    set("long", @long
這竟是一套用老虎皮做成的護甲，摸上去非常的堅固，但似乎是剛硝
製而成的樣子，上頭還殘留著藥味和血腥味。
long
    );
    set("armor_prop/armor", 15);
  }
  setup();
}
