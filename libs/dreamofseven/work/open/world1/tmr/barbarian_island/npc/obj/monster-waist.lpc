#include <armor.h>
inherit WAIST;

void create()
{
  set_name("獸鞭腰帶", ({ "monster waist", "waist" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "條");
    set("value", 1500);
    set("long", "這是一條獸鞭腰帶，是用來纏在腰際上以繫住褲子用。\n");
    set("armor_prop/int", -1);
    set("armor_prop/cor", 1);
    set("armor_prop/parry", 2);
  }
  setup();
}
