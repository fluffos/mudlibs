#include <armor.h>
inherit HANDS;

void create()
{
  set_name("鋼製腕甲", ({ "steel bracer", "bracer" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "雙");
    set("value", 1200);
    set("long", @long
這是一雙由鋼鐵製成的腕甲，擁有頗佳的防禦能力。
long
    );
    set("armor_prop/armor", 3);
  }
  setup();
}
