// 鯨魚森林 裡的 樹枝 weapon
#include <weapon.h>
inherit SWORD;

void create()
{
  set_name("枯樹枝", ({ "branche", "branche" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 50);
    set("rigidity", 10);
    set("long", "這是一根已枯的樹枝，拿來當成木劍，倒也可行。\n");
  }
  init_sword(8);
  setup();
}
