#include <armor.h>
inherit HEAD;

void create()
{
  set_name("鴨舌帽" , ({ "peaked cap" , "cap" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 1500);
    set("long", "這是一件帽頂的前部和月牙形帽簷扣在一起的帽子。\n");
    set("armor_prop/cor", 1);
  }
  setup();
}
