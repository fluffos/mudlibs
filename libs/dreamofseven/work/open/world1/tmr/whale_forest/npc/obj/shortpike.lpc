#include <weapon.h>
inherit FORK;

void create()
{
  set_name("短槍", ({ "short pike", "pike" }));
  set_weight(3500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 250);
    set("rigidity", 30);
    set("long", "這是一枝生鐵做的短槍，大概打鐵的功力不夠，槍頭有點鈍鈍的。\n");
  }
  init_fork(9);
  setup();
}
