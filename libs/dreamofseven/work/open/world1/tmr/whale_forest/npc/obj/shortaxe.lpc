#include <weapon.h>
inherit AXE;

void create()
{
  set_name("小木斧", ({ "small wood axe", "axe" }));
  set_weight(4000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 250);
    set("rigidity", 30);
    set("long", "一把斧鋒有缺口的小木斧，握柄也有點腐壞了。\n");
  }
  init_axe(9);
  setup();
}
