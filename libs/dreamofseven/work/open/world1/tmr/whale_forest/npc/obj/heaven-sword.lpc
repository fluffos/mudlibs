#include <weapon.h>
inherit SWORD;

void create()
{
  set_name("重劍", ({ "heavy sword", "sword" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 800);
    set("rigidity", 60);
    set("long", "這是把長約一尺的重劍，光劍柄就需要兩隻手才能握得穩。\n");
  }
  init_sword(7);
  setup();
}
