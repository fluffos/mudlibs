#include <armor.h>
inherit HANDS;

void create()
{
  set_name("綿布手套", ({ "floss gloves", "gloves" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "雙");
    set("value", 50);
    set("long", @long
這是一雙用綿布織成的白色手套，整副手套東破一個洞，西漏一條線
，已經殘破不堪，但還勉強可以穿載。
long
    );
    set("armor_prop/armor", 1);
  }
  setup();
}
