#include <weapon.h>
inherit BLADE;

void create()
{
  set_name("長武士刀", ({ "wu-shi blade" , "blade" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 4000);
    set("rigidity", 120);
    set("long", "這是一把長逾尺的武士刀，刀鋒異常銳利，看的出來殺傷力不低。\n");
  }
  init_blade(8);
  set("weapon_prop/str", 1);
  setup();
}
