#include <armor.h>
inherit PANTS;

void create()
{
  set_name("深藍色牛仔褲", ({ "blue jeans", "jeans" }));
  set_weight(900);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 900);
    set("long", @long
這是一件常見的深藍色牛仔褲，雖然價錢不高，但是耐穿實用，滿受
旅行者的喜愛。
long
    );
    set("armor_prop/armor", 2);
  }
  setup();
}
