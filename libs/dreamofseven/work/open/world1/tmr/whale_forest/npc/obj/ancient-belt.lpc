#include <armor.h>
inherit WAIST;

void create()
{
  set_name("古文銅腰帶", ({ "ancient belt", "belt"}));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "條");
    set("value", 3000);
    set("long", "這是一條粗銅鑄造而成的腰帶，上面刻有數排古文，顯得頗有歷史價值。\n");
    set("armor_prop/armor", 3);
  }
  setup();
}
