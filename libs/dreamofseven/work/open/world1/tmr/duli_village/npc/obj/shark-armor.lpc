#include <armor.h>
inherit ARMOR;

void create()
{
  set_name("鯊皮盔甲", ({ "shark armor", "armor" }));
  set_weight(15000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "套");
    set("value", 1000);
    set("long", "這是一套用鯊魚皮做成的盔甲，你還聞得到上頭殘留的血腥味。\n");
    set("armor_prop/armor", 15);
  }
  setup();
}
