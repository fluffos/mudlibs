#include <armor.h>
inherit FINGER;

void create()
{
  set_name("白玉戒指", ({ "white jade ring", "ring" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "枚");
    set("value", 600);
    set("long", "這是一枚白玉戒指，光潔而亮麗，一看就知道是頗珍貴的飾物。\n");
    set("armor_prop/armor", 2);
  }
  setup();
}
