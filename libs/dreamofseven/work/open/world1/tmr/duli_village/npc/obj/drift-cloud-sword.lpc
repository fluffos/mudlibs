#include <weapon.h>
inherit SWORD;

void create()
{
  set_name("浮雲劍", ({ "drift-cloud sword", "sword" }));
  set_weight(2500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 1200);
    set("rigidity", 50);
    set("long", @long
這是一把在武器界頗有名的短劍，雖然長不過尺，但其罕見的銳利劍
鋒，卻極受使劍高手的愛用。浮雲劍的劍柄上刻畫著一個「江」字。
long);
  }
  init_sword(10);
  set("weapon_prop/damage", 3);
  set("weapon_prop/attack", 5);
  setup();
}
