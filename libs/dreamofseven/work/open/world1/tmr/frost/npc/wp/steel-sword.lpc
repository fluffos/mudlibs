#include <ansi.h>
#include <weapon.h>
inherit SWORD;

void create() {
        set_name("白鋼長劍",({"steel sword","sword"}));
        set("long",@LONG
LONG
);
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
        set("unit", "把");        
        set("value", 1000);
        set("volume",2);        
        set("material","steel");       
        }        
        init_sword(30);
        setup();
}    

