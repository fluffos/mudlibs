#include <weapon.h>
inherit WHIP;

void create()
{
  set_name("蔓生長鞭" , ({ "creeper whip" , "whip" }));
  set_weight(6000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "條");
    set("value", 5000);
    set("long", "這是一條由蔓生植物所編成的長鞭，長達數丈，質地堅硬。");
  }
  init_whip(10);
  setup();
}
