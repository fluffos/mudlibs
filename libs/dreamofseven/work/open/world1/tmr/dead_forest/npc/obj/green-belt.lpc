#include <armor.h>
inherit WAIST;

void create()
{
  set_name("翠綠腰帶", ({ "green belt" , "belt" , "_OBJ_ID_GREEN_BELT_" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "條");
    set("value", 12000);
    set("long", @LONG
　　這是一條鑲有翠綠花紋的腰帶，看起來價值不菲，滿有高貴的感覺。
LONG
    );
    set("armor_prop/armor", 1);
  }
  setup();
}
