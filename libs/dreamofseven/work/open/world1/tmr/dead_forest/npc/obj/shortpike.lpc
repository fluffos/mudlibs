#include <weapon.h>
inherit FORK;

void create()
{
  set_name("生銹短槍", ({ "short pike", "pike" }));
  set_weight(3500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 400);
    set("rigidity", 30);
    set("long",@LONG
　　這是一枝生鐵做的短槍，大概打鐵的功力不夠，槍頭有點鈍鈍的，如今
更因為生銹而更顯得沒什麼殺傷力。
LONG
);
  }
  init_fork(8);
  setup();
  set("name", ENHANCE_D->enhance_weapon(this_object(),0,"短槍") );
}
