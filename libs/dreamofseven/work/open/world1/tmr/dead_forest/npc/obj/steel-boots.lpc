#include <armor.h>
inherit BOOTS;

void create()
{
  set_name("精鋼長靴", ({ "steel boots", "boots" }));
  set_weight(2500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "雙");
    set("value", 2500);
    set("long", @long
這是一雙精鋼打造的長靴，造型樸素大方，非常地堅固耐穿。
long
    );
    set("armor_prop/armor", 10);
  }
  setup();
}
