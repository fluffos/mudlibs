#include <armor.h>
inherit FINGER;

void create()
{
  set_name("獸骨耳環", ({ "bone earring", "earring" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "枚");
    set("value", 80);
    set("long", @LONG
這是一枚用獸骨做成的耳環。
LONG
    );
    set("armor_prop/armor", 1);
  }
  setup();
}
