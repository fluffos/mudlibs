#include <weapon.h>
inherit AXE;

void create()
{
  set_name("生銹短斧", ({ "short axe", "axe" }));
  set_weight(3500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 300);
    set("rigidity", 30);
    set("long", @LONG
這是一把生銹已久的短斧，斧面上盡是鐵鏽，感覺已經不夠銳利了。
LONG);
  }
  init_axe(4);
  setup();
  set("name", ENHANCE_D->enhance_weapon(this_object(),0,"短斧"));
}
