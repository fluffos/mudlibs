#include <armor.h>
inherit CLOTH;

void create()
{
  set_name("灰色上衣", ({ "grey cloth", "cloth" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 1500);
    set("long", @long
這是一件材質頗為高級的灰色上衣，頗有保暖之效。
long
    );
    set("armor_prop/armor", 3);
  }
  setup();
}
