#include <armor.h>
inherit FINGER;

void create()
{
  set_name("地獄之耳", ({ "hell earring", "earring" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "枚");
    set("value", 5000);
    set("long", @LONG
這是一枚用徹體黝黑的獅骨所做成的耳環。
LONG
    );
    set("armor_prop/armor", 1);
  }
  setup();
}
