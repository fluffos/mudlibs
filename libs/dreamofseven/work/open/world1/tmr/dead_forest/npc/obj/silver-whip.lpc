#include <weapon.h>
inherit WHIP;

void create()
{
  set_name("四丈銀鞭" , ({ "silver whip" , "whip" }));
  set_weight(6000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "條");
    set("value", 10000);
    set("long", "這是一條長四丈有餘的銀鞭，上面佈滿奇形怪狀的銀製銳器。");
  }
  init_whip(8);
  setup();
}
