#include <weapon.h>
inherit SWORD;

void create()
{
  set_name("生銹短劍", ({ "short sword", "sword" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 150);
    set("rigidity", 5);
    set("long", "一把鐵製的短劍，是一般常見的基本防身武器，但已經生銹到隨時都會斷掉的感覺。\n");
  }
  init_sword(12);
  setup();
  set("name", ENHANCE_D->enhance_weapon(this_object(),0,"短劍"));
}
