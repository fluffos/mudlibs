#include <armor.h>
inherit CLOTH;

void create()
{
  set_name("烏蠶寶衣" , ({ "wu-silkworm cloth", "cloth" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 8500);
    set("long", "這是一件用烏蠶絲做成的衣服，整件刀槍不入、水火不侵，是非常高貴的寶衣。\n");
    set("armor_prop/armor", 5);
  }
  setup();
}
