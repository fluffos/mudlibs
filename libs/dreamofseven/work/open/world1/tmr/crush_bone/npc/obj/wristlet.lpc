#include <armor.h>
inherit HANDS;

void create()
{
        set_name("軍團護腕", ({ "army wristlet" , "wristlet" }) );
        set_weight(2000);       // 頗重的護腕
        if( !clonep() ) {
                set("unit", "個");
                set("value", 300);
                set("long",@long
這是一個粗銅打造的護腕，頗具重量，但卻有相當的防禦能力。
long
                );
                set("armor_prop/armor", 5);
        } else
		   set_default_object(__FILE__);
        setup();
}

