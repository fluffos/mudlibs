inherit ITEM;

void create()
{
    set_name("半獸人腳掌", ({"orc's foot", "foot", "_CRUSH_BONE_FOOT_"}));
    if( !clonep() ) {
        set("long", "一支血淋淋的腳掌，怪嚇人的.. ~.~!");
        set("unit", "隻");
        set("value", 10);
        set("weight", 20);
        } else
		   set_default_object(__FILE__);
    setup();
}
