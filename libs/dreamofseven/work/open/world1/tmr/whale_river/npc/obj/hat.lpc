#include <armor.h>
inherit HEAD;

void create()
{
  set_name("斗笠", ({ "leaf hat", "hat"}));
  set_weight(1500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "頂");
    set("value", 50);
    set("long", "這是一頂竹葉編成的斗笠，在大太陽下戴著這個，還頗增添不少涼意。\n");
    set("armor_prop/armor", 2);
  }
  setup();
}
