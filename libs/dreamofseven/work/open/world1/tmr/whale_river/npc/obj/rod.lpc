#include <weapon.h>
inherit STAFF;

void create()
{
  set_name("釣竿", ({ "fishing rod","rod","_OBJECT_ROD_" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("value", 250);
    set("rigidity", 12);
    set("long",
                            "一根用竹子做成的細長釣竿。\n");
  }
  init_staff(14);
  setup();
}
