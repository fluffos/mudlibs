inherit ITEM;

void create()
{
    set_name("巨魔血液", ({"troll blood", "blood"}));
    if( !clonep() ) {
        set("long", "一瓶巨魔的暗紅色血液，已呈半凝固狀態。");
        set("unit", "堆");
        set("value", 100);
        set("unit", "瓶");
        set("weight", 20);
        } else
	set_default_object(__FILE__);
    setup();
}

