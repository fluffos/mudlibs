// weapon: /z/xingxiu/npc/obj/wandao.c
// Jay 3/17/96

#include <weapon.h>
inherit BLADE;

void create()
{
        set_name("阿拉伯彎刀", ({ "arabia blade", "blade" }));
        set_weight(6000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "這是一柄亮晃晃的阿拉伯彎刀，刀身呈新月狀。");
                set("value", 1500);
                set("material", "steel");
        }
        init_blade(25);
        setup();
}

