#include <ansi.h>
inherit NPC;
void create()
{
        set_name(HIG"泡泡龍"NOR, ({ "popo dragon","popo","po","dragon" }));
        set("long","幼龍之中最強勢的龍種。\n");

        set("race","野獸");
        set("level", 10);
        set("age", 333);

        set("limbs", ({ "龍頭","尾巴","鱗甲","觸角","前腳","後腳","背鰭" }) );
        set("verbs", ({ "bite", "claw","poke" }));


       setup();
        add_money("coin",1000);
}

