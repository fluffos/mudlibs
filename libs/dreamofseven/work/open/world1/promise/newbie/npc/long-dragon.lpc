#include <ansi.h>
inherit NPC;
void create()
{
        set_name(YEL"長鬚龍"NOR, ({ "long dragon","dragon","long" }));
        set("long","幼龍之中新守衛，但功\力稍微薄弱。\n");

        set("race","野獸");
        set("level", 5);
        set("age", 200);

        set("limbs", ({ "龍頭","尾巴","鱗甲","觸角","前腳","後腳","背鰭" }) );
        set("verbs", ({ "bite", "claw","poke" }));


       setup();
        add_money("coin",1000);
}

