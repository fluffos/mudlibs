#include <ansi.h>
inherit NPC;
void create()
{
        set_name(HIY"金線魚"NOR,({ "gold line fish","fish" }) );
         set("level",10);
        set("race", "野獸");
        set("age", 1);
        set("long", "這是附近海域最常見到的魚類, 同時它的肉價也是最為廉價的。\n");
        set("limbs", ({ "胸鰭", "尾鰭", "腹鰭", "尾部", }) );
        set("verbs", ({ "bite", "claw" }) );
        set("chat_chance", 5);
        setup();
	carry_object(__DIR__"../obj/fish_meat");
}