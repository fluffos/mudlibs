#include <ansi.h>
inherit NPC;
void create()
{
        set_name("鮪魚",({ "tunny" }) );
         set("level",15);
        set("race", "野獸");
        set("age", 2);
        set("long", "一隻鮪魚, 雖然肉質沒有鮭魚佳, 但銷路也不差。\n");
        set("limbs", ({ "胸鰭", "尾鰭", "腹鰭", "尾部", }) );
        set("verbs", ({ "bite", "claw" }) );
        set("chat_chance", 5);
        setup();
	carry_object(__DIR__"../obj/tunny_meat");
}