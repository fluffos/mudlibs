#include <ansi.h>
#include <weapon.h> 
inherit FIST;

void create()
{
  set_name(HIB"追魂"NOR , ({ "following-soul[claw]","claw","soul" }) );
  set_weight(4000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("unit", "把");
    set("long", "乃是名匠『子黃丹』所打造的，聚集數千遊魂，配合\n"
                "一年裡的所有滿月時間，打造出日月金華的『追魂』。\n");
    set("material", "gold");
    set("value",6000);
  }
  set("weapon_prop/str",1);
  set("weapon_prop/int",-1);   
  init_fist(44);
  setup();
} 
