// 奧凡迪斯

// LV 1~50
#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", HIC"雅莉的酒店"NOR);
	set("long", @LONG
全城最有名的酒都是在這釀造的，有許多客人都是遠從城外慕名而來
的。吧台上有位調酒師正在調製香醇的美酒，牆上有個告示牌(sign)。
LONG
	);

	set("exits", ([ /* sizeof() == 2 */
            "east" : __DIR__"room068",
	    "down" : __DIR__"room106",
            ]));

	set("objects", ([ /* sizeof() == 1 */
		__DIR__"npc/boss3" : 1,
	]));
        set("item_desc", (["sign":@NOTE

佈告牌上寫著:  酒醉不開車，開車不喝酒。

	==========================
	飲品清單	list
	購買飲品	buy <飲品>
	==========================

NOTE
        ]) );

	set("no_clean_up", 0);
	set("light", 1);
	set("valid_startroom",1);

	setup();
	replace_program(ROOM);
}

