#include <armor.h>
#include <ansi.h>
inherit WAIST;

void create()
{
	set_name( "[1;36m水[1;33m仙[1;31m花[1;37m瓣綴[35m細帶[0m", ({ "aass's flower waist" }) );
	set_weight(1874);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long","用一朵朵水仙花編織而成的腰帶");
		set("unit", "條");
		set("value",1209);
	}
	set("armor_prop/armor", 4);
	set("armor_prop/shield", 3);
	set("armor_prop/con", 1);
	setup();
}
int query_autoload() { return 1; }
