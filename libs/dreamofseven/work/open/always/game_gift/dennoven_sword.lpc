#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create()
{
	set_name( "[33m黃金[35m之龍[31m˙[36m幻[1;37m影[1;31m血[30m劍[0m", ({ "dragon's sword","sword" }) );
	set_weight(7457);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long","這是一把正氣、妖氣合一ㄉ劍，使用者必須亦正亦邪，否則將會受到這把劍的控制而神經錯亂、經脈盡碎身亡。");
		set("unit", "把");
		set("value",4886);
	}
	set("weaopn_prop/hit", 10 );
	set("weaopn_prop/dex", 1 );
	init_sword(60);
	setup();
}
int query_autoload() { return 1; }
