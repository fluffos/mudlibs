#include <armor.h>
#include <ansi.h>
inherit ARMOR;

void create()
{
	set_name( "[1;35m奔月[0m[0m", ({ "fly moon","fly" }) );
	set_weight(6801);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long","奔月相傳是嫦娥在飛向月宮時掉了一隻髮簪所做成的,奔月具有一些無法說明的法力,質地很輕防禦力卻很高。");
		set("unit", "件");
		set("value",6870);
	}
	set("armor_prop/shield", 28);
	set("armor_prop/str", 1);
	set("armor_prop/con", 1);
	set("armor_prop/armor", 49);
	setup();
}
int query_autoload() { return 1; }
