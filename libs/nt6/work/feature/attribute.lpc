// This program is a part of NT MudLIB
// attribute.c
// Rewritten by Lonely@nitan.org

// feature/attribute.lpc is inherited (as F_ATTRIBUTE) as a SIBLING of
// F_DBASE by char.lpc, not the other way around -- it never inherits
// F_DBASE itself. Every bare query()/query_temp() call in this file
// (no trailing `ob` redirect) therefore hits the same F_DBASE bare-call
// bootstrapping trap already fixed in feature/name.lpc, feature/
// command.lpc, feature/apprentice.lpc, adm/daemons/databased.lpc, and
// adm/kernel/simul_efun/message.lpc: unqualified calls resolve against
// the SIMUL_EFUN OBJECT's own shared `dbase`, not this_object()'s own.
// Since every one of this file's query_str()/query_int()/query_con()/
// query_dex()/query_kar()/query_per() is always invoked via a real `->`
// cross-object call (e.g. `me->query_int()`), this silently returned
// near-zero combat/attribute stats for every character and crashed
// cmds/skill/learn.lpc:141 (`jing_cost = 150 / (int)me->query_int() + 1`)
// with a real *Division by zero* whenever query_int() legitimately
// evaluated to exactly 0. Fixed with the same `this_object()` redirect
// pattern as the other five files. query_skills()/query_skill() calls
// below are untouched -- those are F_SKILL (feature/skill.lpc) member-
// variable-backed, not F_DBASE-backed, so they aren't subject to this
// trap.

#include <skill.h>

int query_str() {
  mapping sk;
  int str;
  int ability = 0;
  int lx = 0;

  str = query("str", this_object());
  str += query("ability1/str", this_object());
  if (query("jingmai/finish", this_object()))
    str += ZHOUTIAN_D->query_jingmai_effect("str");
  str += query("jingmai/str", this_object());
  str += query_temp("apply/str", this_object());
  if (!mapp(sk = query_skills()))
    return str;
  ability = (int)sk["unarmed"];
  if (ability < (int)sk["cuff"]) ability = sk["cuff"];
  if (ability < (int)sk["finger"]) ability = sk["finger"];
  if (ability < (int)sk["strike"]) ability = sk["strike"];
  if (ability < (int)sk["hand"]) ability = sk["hand"];
  if (ability < (int)sk["claw"]) ability = sk["claw"];
  lx = (int)sk["longxiang-gong"] / 30;
  if (lx >= 13) lx = 15;
  return str + (ability / 10) + lx;
}

int query_int() {
  mapping sk;
  int str;
  int ability = 0;

  str = query("int", this_object());
  str += query("ability1/int", this_object());
  if (query("jingmai/finish", this_object()))
    str += ZHOUTIAN_D->query_jingmai_effect("int");
  str += query("jingmai/int", this_object());
  str += query_temp("apply/int", this_object());
  if (!mapp(sk = query_skills()))
    return str;
  ability = (int)sk["literate"];
  return str + (ability / 10);
}

int query_con() {
  mapping sk;
  int str;
  int ability = 0;

  str = query("con", this_object());
  str += query("ability1/con", this_object());
  if (query("jingmai/finish", this_object()))
    str += ZHOUTIAN_D->query_jingmai_effect("con");
  str += query("jingmai/con", this_object());
  str += query_temp("apply/con", this_object());
  if (!mapp(sk = query_skills()))
    return str;
  ability = (int)sk["force"];
  return str + (ability / 10);
}

int query_dex() {
  mapping sk;
  int str, scale;
  int ability = 0;

  //scale = (this_object()->query_encumbrance()*100)/this_object()->query_max_encumbrance();
  str = query("dex", this_object());
  str += query("ability1/dex", this_object());
  if (query("jingmai/finish", this_object()))
    str += ZHOUTIAN_D->query_jingmai_effect("dex");
  str += query("jingmai/dex", this_object());
  str += query_temp("apply/dex", this_object()) /* - (scale > 50 ? (scale-30)/10 : 0)*/;
  if (!mapp(sk = query_skills()))
    return str;
  ability = (int)sk["dodge"];
  return str + (ability / 10);
}

int query_kar() {
  int buff;

  if (query("jingmai/finish", this_object())) buff = ZHOUTIAN_D->query_jingmai_effect("kar");
  else buff = query("jingmai/kar", this_object());
  return (int)query("kar", this_object()) + query("ability1/kar", this_object()) + buff + query_temp("apply/kar", this_object());
}

int query_per() {
  int per;
  int age;
  int ac;

  per = (int)query("per", this_object()) + query_temp("apply/per", this_object());
  if (query("special_skill/youth", this_object()))
    return per;

  age = query("age", this_object());

  ac = query_skill("art-cognize", 1);
  if (ac < 100) {
    if (age > 70) per -= 6; else if (age > 60) per -= 5; else if (age > 50) per -= 4; else if (age > 40) per -= 3; else if (age > 30) per -= 2;
  }

  per += ac / 20;
  return per;
}
