#include <ansi.h>

#define MANMADE_NPC "/clone/npc/rzr"

inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

mixed main(object me, string arg) {
  if (!arg) {
    return notify_fail("指令格式：rzrcmd smashall\n");
  }

  if (arg == "smashall") {
    RZR_NPCD->destroy_all_npcs();
  }

  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : rzrcmd smashall

人造人系统指令。

-smashall 摧毁所有的人造人。
HELP
  );
  return 1;
}
